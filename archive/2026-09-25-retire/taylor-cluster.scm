;;; taylor-cluster.scm -- THE TAYLOR CLUSTER OF THE CALCULUS NOTES (calculus.pdf,
;;; ch. 2, sections 1, 6 and 7): 2.3, 2.16, 2.20, 2.21, 2.22.  Batch 25-B, 2026-09-24.
;;;
;;; WHAT IS PROVEN HERE (all `modulo 0'; no definition, support, stamp or axiom):
;;;
;;;   2.3   nth-deriv-monomial         k <= n:  (x^n)^(k) = x |-> n!/(n-k)! x^(n-k)
;;;         nth-deriv-monomial-vanish  n < k:   (x^n)^(k) = x |-> 0
;;;         THE NOTES' (8) IS MISPRINTED: it reads k! x^(n-k); for n = 2, k = 1 that
;;;         is x, while (x^2)' = 2x.  The coefficient is n!/(n-k)!, and n - k is
;;;         NN-MINUS(n, k), the truncated difference of the tree.
;;;   2.16  taylor-interpolant-at-zero  if f^(0)(0), ..., f^(n)(0) are real, there is a
;;;         coefficient sequence cf with cf(k) = f^(k)(0)/k! (k <= n) whose polynomial
;;;         of degree <= n has the derivatives of f at 0 up to order n, and any
;;;         polynomial of degree <= n with that property has the same coefficients
;;;         below n + 1.  (The notes' "degree n - 1" is this n.)  Uniqueness is stated
;;;         on the COEFFICIENT sequences, as the brief asks: a polynomial is the
;;;         explicit term below, not an object with its own equality.
;;;   2.22  taylor-exact-polynomial    P(a + h) = sum_{i <= m} P^(i)(a) h^i / i!  for P of
;;;         degree <= m, every a, h in RR.
;;;   2.20  taylor-remainder-sup-bound |R_n(a, b)| <= (b - a)^n / n! sup{|f^(n)(xi)| :
;;;         xi in (a, b)}, the set BOUNDED ABOVE as a hypothesis (the notes leave it
;;;         implicit; SUP is governed by rr-sup-upper only for a nonempty set bounded
;;;         above).  The family of 2.18 (IS-TAYLOR-FAMILY, interval-taylor.scm).
;;;   2.21  taylor-remainder-factor    f, f', ..., f^(n) ON [a, b], f^(k) continuous with
;;;         derivative f^(k+1) on (a, b) for k < n, f^(n) continuous on [a, b]: there is
;;;         a continuous S on [a, b] with R_n(t) = S(t) (t - a)^n / n! on [a, b],
;;;         S(a) = f^(n)(a) (the notes print "R_n(a) = f^(n)(a)", a misprint for
;;;         S_n(a)) and |S(t)| <= sup{|f^(n)(xi)| : xi in [a, b]}; the boundedness of
;;;         that set is PROVEN (continuous-abs-bounded-on-ccint), not assumed.  The
;;;         route is the notes': for t > a, S(t) = R_n(t) n!/(t - a)^n = f^(n)(xi_t)
;;;         with xi_t in (a, t) (taylor-lagrange-subinterval: 2.19 for the family
;;;         RESTRICTED to [a, t]), so S(t) -> f^(n)(a) as t -> a.  S is the restriction
;;;         to [a, b] of a function on the whole line (f through EXTEND-CONST, the
;;;         reciprocal through RECIP-STAR, the value f^(n)(a) for s <= a), continuous at
;;;         every real (taylor-factor-glue-continuous), whence cont-on-of-total.
;;;
;;; THE POLYNOMIAL.  A polynomial function of degree <= n is the explicit term
;;;     vnb-lambda(x, rr, series-partial-sum(vnb-lambda(k, nn, cf(k) * x ^ k), succ(n)))
;;; with cf in fun(nn, rr) (the brief's decision; the term of deriv-polynomial).
;;; Section (4) proves its calculus: the derivative FUNCTION is the polynomial of
;;; the coefficients (k+1) cf(k+1) (poly-deriv-fn), every derivative is a function
;;; RR -> RR (poly-nth-deriv-in-fun), and the k-th derivative at 0 is k! cf(k)
;;; (poly-nth-deriv-at-zero).  With nth-deriv-succ-inner (f^(k+1) = (f')^(k)) that
;;; is all 2.16 and 2.22 need.
;;;
;;; 2.22 BY INDUCTION ON THE DEGREE, not by the notes' route through (24): the
;;; tree's Lagrange form is stated for a < b only, so the notes' argument covers
;;; h > 0; the induction covers every h at once and needs no binomial theorem:
;;; for P of degree m + 1, P' has degree m, the hypothesis gives P'(a + t) as the
;;; derivative of the polynomial A(t) = sum_k P^(k+1)(a) t^(k+1)/(k+1)! (poly-
;;; antiderivative), so H(t) = P(a + t) - A(t) has derivative 0 everywhere
;;; (deriv-chain, deriv-difference), is constant (pw-zero-deriv-total), and
;;; H(0) = P(a).
;;;
;;; Helper prefix: tcl-.  Binders of the statements: tck_ (an order of
;;; derivation), tcm_ / tcj_ / tcp_ (degrees), tcd_ / tcg_ / tcu_ (sequences),
;;; tcf_ (a Taylor family), tci_ / tcv_ (summation index, point); none folds onto
;;; a registered constant, and none is `x' or `k', which the polynomial term
;;; binds.  Driver-built lambdas bind tcw_, tcza_ ... tczg_, tcra_ ... (fresh).
;;;
;;; WINDOW: see the report (scratchpad/window.py); no citer.  No top-level macro:
;;; compilable.

;;; =====================================================================
;;; (0) FILE-LOCAL DRIVER HELPERS
;;; =====================================================================

(define (tcl-first pred lst)
  (cond ((null? lst) #f) ((pred (car lst)) (car lst)) (#t (tcl-first pred (cdr lst)))))

;;; land (IN t NN)
(define (tcl-nat! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in))
          ((and (pair? t) (eq? (car t) 'succ))
           (tcl-nat! (cadr t)) (fact 'nn-succ-closed (cadr t)))
          ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
           (tcl-nat! (cadr t)) (tcl-nat! (caddr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN)))
           (fact 'nn-add-closed (cadr t) (caddr t)))
          ((number? t) (dk-have! typ (lambda () (arith))))
          (#t (error "tcl-nat!: cannot type" (expression->string t))))
    (if (not (dk-asm? typ)) (error "tcl-nat!: typing did not land" (expression->string t)))
    typ))

;;; land (IN t RR), recursively, by citation
(define (tcl-real! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in))
          ((eqv? t 1) (fact 'rr-one-in))
          ((symbol? t)
           (if (dk-asm? (list 'IN t 'NN))
               (fact 'nn-in-rr t)
               (error "tcl-real!: untyped symbol" t)))
          ((and (pair? t) (memq (car t) '(+ * -)) (= (length t) 3))
           (tcl-real! (cadr t)) (tcl-real! (caddr t))
           (fact (cdr (assq (car t) '((+ . rr-add-in-rr) (* . rr-mul-in-rr) (- . rr-sub-in-rr))))
                 (cadr t) (caddr t)))
          ((and (pair? t) (eq? (car t) 'power))
           (tcl-real! (cadr t)) (tcl-nat! (caddr t))
           (fact 'power-real-closed (cadr t) (caddr t)))
          ((and (pair? t) (eq? (car t) 'factorial))
           (tcl-nat! (cadr t))
           (dk-split! (dk-fact! 'factorial-real-pos (cadr t))))
          ((and (pair? t) (eq? (car t) 'recip) (pair? (cadr t)) (eq? (car (cadr t)) 'factorial))
           (tcl-nat! (cadr (cadr t)))
           (fact 'recip-factorial-in-rr (cadr (cadr t))))
          ((and (pair? t) (eq? (car t) 'recip) (pair? (cadr t)) (eq? (car (cadr t)) 'succ))
           (tcl-real! (cadr t))
           (fact 'nn-succ-nonzero (cadr (cadr t)))
           (dk-have! (list 'AND (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0))))
           (fact 'rr-recip-closed (cadr t)))
          ((and (pair? t) (memq (car t) '(succ +)))
           (tcl-nat! t) (fact 'nn-in-rr t))
          ((number? t) (dk-have! typ (lambda () (in-rr))))
          (#t (dk-real! t)))
    (if (not (dk-asm? typ)) (error "tcl-real!: typing did not land" (expression->string t)))
    typ))

;;; the subterms of e that `crs' must see as opaque atoms: every (recip ...) and
;;; every maximal non-arithmetic subterm holding a binder, outermost, without
;;; repetition.  The walk descends only through + - * and power.
(define (tcl-recips e)
  (let walk ((e e) (acc '()))
    (cond ((not (pair? e)) acc)
          ((and (memq (car e) '(+ - * power)) (= (length e) 3))
           (walk (caddr e) (walk (cadr e) acc)))
          ((or (eq? (car e) 'recip) (dk-contains? e 'vnb-lambda))
           (if (member e acc) acc (append acc (list e))))
          (#t acc))))

(define (tcl-replace e from to)
  (cond ((equal? e from) to)
        ((pair? e) (map (lambda (s) (tcl-replace s from to)) e))
        (#t e)))

;;; Close the focus EQUATION as a commutative-ring identity in which every
;;; (recip ...) subterm is an opaque atom: `crs' declines recip, so the goal is
;;; generalised (each recip term a fresh universally quantified real), proved
;;; by `crs' on a lane, and instantiated back.  Every atom of the goal must be
;;; typed in RR in the context (the instantiation detaches the guards).
(define tcl-fresh-names '(tcra_ tcrb_ tcrc_ tcrd_ tcre_ tcrf_))
(define (tcl-crs! . opt)
  (let* ((g (dk-goal))
         (rs (if (memq (car g) '(= ==))
                 (let ((r1 (tcl-recips (cadr g))))
                   (append r1 (filter (lambda (r) (not (member r r1))) (tcl-recips (caddr g)))))
                 (tcl-recips g)))
         (vs (list-head tcl-fresh-names (length rs)))
         (g2 (let loop ((g g) (rs rs) (vs vs))
               (if (null? rs) g (loop (tcl-replace g (car rs) (car vs)) (cdr rs) (cdr vs))))))
    (if (memq (car g) '(= ==)) (begin (tcl-real! (cadr g)) (tcl-real! (caddr g))))
    (if (null? rs)
        (crs)
        (let ((univ (let loop ((vs (reverse vs)) (body g2))
                      (if (null? vs) body
                          (loop (cdr vs) (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'RR) body)))))))
          (for-each tcl-real! rs)
          (dk-have! univ (lambda () (dk-peel!) (crs)))
          (apply dk-apply! (dk-ctx-form univ) rs)
          (ass)))))

;;; dk-have! CLAIM by THUNK -- or, when CLAIM is the focus goal itself, run THUNK on it
(define (tcl-have! claim thunk)
  (if (alpha-equiv? (dk-goal) claim)
      (thunk)
      (dk-have! claim thunk)))

;;; the typing (IN (VNB-LAMBDA v A body) (FUN A B)): lam-t, then CLOSER on the
;;; pointwise goal with the eigenvariable.
(define (tcl-lam-type! closer)
  (dk-lam-t!)
  (let ((v (dk-di-var!)))
    (closer v)))

;;; (IN F (FUN DOM)) from (IN F (FUN DOM COD)), on a lane (the hypothesis survives)
(define (tcl-fun-dom! f dom cod)
  (dk-have! (list 'IN f (list 'FUN dom))
    (lambda ()
      (mac-h 'fun-codomain-iff (list 'IN f (list 'FUN dom cod)))
      (dk-split-all!)
      (ass))))

;;; (tcl-ext! LHS RHS DOM COD TYPE-L TYPE-R PTWISE) -- land (= LHS RHS), both
;;; members of FUN(DOM, COD), by fun-domain-extensionality: TYPE-L / TYPE-R
;;; are thunks proving the two FUN typings (skipped when in context), PTWISE a
;;; procedure of the eigenvariable proving (= (LHS v) (RHS v)).
(define (tcl-ext! lhs rhs dom cod type-l type-r ptwise)
  (let ((eqn (list '= lhs rhs)))
    (dk-have! eqn
      (lambda ()
        (dk-have! (list 'IN lhs (list 'FUN dom cod)) type-l)
        (dk-have! (list 'IN rhs (list 'FUN dom cod)) type-r)
        (tcl-fun-dom! lhs dom cod)
        (tcl-fun-dom! rhs dom cod)
        (let* ((ch (dk-fact! 'fun-domain-extensionality dom lhs rhs))
               (zv (tcl-first (lambda (z) (not (or (dk-contains? lhs z) (dk-contains? rhs z))))
                              '(tcza_ tczb_ tczc_ tczd_ tcze_ tczf_ tczg_)))
               (fa (list 'FORALL zv (list 'IMPLIES (list 'IN zv dom)
                                         (list '= (list lhs zv) (list rhs zv))))))
          ;; the pointwise universal under a binder no lambda of the library binds
          ;; (the theorem's own binder is x, which the polynomial terms bind)
          (dk-have! fa (lambda () (let ((v (dk-di-var!))) (ptwise v))))
          (detach! ch)
          (ass))))
    (dk-ctx-form eqn)))

(define (tcl-guard-le n body)        ; forall tck_ in NN. tck_ <= n implies BODY(tck_)
  (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '<= 'tck_ n) (body 'tck_)))))

;;; the pointwise typing closer for a lambda over RR whose body is arithmetic
(define (tcl-body-real! v) (tcl-real! (cadr (dk-goal))) (ass))

;;; =====================================================================
;;; (1) nth-deriv-succ-inner -- f^(k+1) = (f')^(k), f' = x |-> f'(x)
;;; =====================================================================
(define tcl-dlam (lambda (f) (list 'VNB-LAMBDA 'x 'RR (list 'DERIV f 'x))))
(sp (make-wff '(FORALL tck_ (IMPLIES (IN tck_ NN)
   (FORALL f (== (NTH-DERIV f (succ tck_)) (NTH-DERIV (VNB-LAMBDA x RR (DERIV f x)) tck_)))))))
(define tcl-si-br (use-induction))
(define tcl-si-k  (cdr (assq 'var tcl-si-br)))
(define tcl-si-ih (cdr (assq 'ih tcl-si-br)))
;; base
(dk-focus! (cdr (assq 'base tcl-si-br)))
(let ((f (dk-di-var! (lambda (g) (cadr (cadr g))))))
  (subst (dk-fact! 'nth-deriv-zero (tcl-dlam f)))
  (tcl-nat! 0)
  (subst (dk-fact! 'nth-deriv-succ f 0))
  (subst (dk-fact! 'nth-deriv-zero f))
  (qrfl))
;; step
(dk-focus! (cdr (assq 'step tcl-si-br)))
(let ((f (dk-di-var! (lambda (g) (cadr (cadr g)))))
      (k tcl-si-k))
  (tcl-nat! (list 'succ k))
  (subst (dk-fact! 'nth-deriv-succ f (list 'succ k)))
  (subst (dk-fact! 'nth-deriv-succ (tcl-dlam f) k))
  (subst (inst*! tcl-si-ih f))
  (qrfl))
(qed 'nth-deriv-succ-inner)

;;; =====================================================================
;;; (2) nth-deriv-monomial-core -- the k-th derivative of x^(m+k)
;;; =====================================================================
(sp (make-wff '(FORALL tck_ (IMPLIES (IN tck_ NN)
   (FORALL tcm_ (IMPLIES (IN tcm_ NN)
     (== (NTH-DERIV (VNB-LAMBDA x RR (power x (+ tcm_ tck_))) tck_)
         (VNB-LAMBDA x RR (* (* (FACTORIAL (+ tcm_ tck_)) (recip (FACTORIAL tcm_))) (power x tcm_))))))))))
(define tcl-mc-br (use-induction))
(define tcl-mc-k  (cdr (assq 'var tcl-mc-br)))
(define tcl-mc-ih (cdr (assq 'ih tcl-mc-br)))
;; base: nth-deriv(g, 0) = g, m + 0 = m, m! recip(m!) = 1, 1 * x^m = x^m
(dk-focus! (cdr (assq 'base tcl-mc-br)))
(let ((m (dk-di-var!)))
  (subst (dk-fact! 'nth-deriv-zero (list 'VNB-LAMBDA 'x 'RR (list 'power 'x (list '+ m 0)))))
  (subst (dk-fact! 'nn-add-zero m))
  (subst (dk-fact! 'rr-recip-factorial m))
  (let ((lhs (list 'VNB-LAMBDA 'x 'RR (list 'power 'x m)))
        (rhs (list 'VNB-LAMBDA 'x 'RR (list '* 1 (list 'power 'x m)))))
    (tcl-ext! lhs rhs 'RR 'RR
              (lambda () (tcl-lam-type! tcl-body-real!))
              (lambda () (tcl-lam-type! tcl-body-real!))
              (lambda (v)
                (dk-lam-b!)
                (tcl-real! (list 'power v m))
                (subst (dk-fact! 'rr-one-mul (list 'power v m)))
                (rfl)))
    (subst (list '= lhs rhs))
    (qrfl)))
;; step: f^(k+1) = (f^(k))' with the hypothesis at m + 1
(dk-focus! (cdr (assq 'step tcl-mc-br)))
(let* ((k tcl-mc-k)
       (m (dk-di-var!))
       (sm (list 'succ m)))
  (tcl-nat! (list 'succ k)) (tcl-nat! sm) (tcl-nat! (list '+ m k))
  (subst (dk-fact! 'nn-add-succ m k))
  (fact 'tab-succ-add m k)
  (subst (list '= (list 'succ (list '+ m k)) (list '+ sm k)))
  (tcl-nat! (list '+ sm k))
  (subst (dk-fact! 'nth-deriv-succ (list 'VNB-LAMBDA 'x 'RR (list 'power 'x (list '+ sm k))) k))
  (subst (dk-apply! tcl-mc-ih sm))
  (let* ((a (list 'FACTORIAL (list '+ sm k)))
         (c (list '* a (list 'recip (list 'FACTORIAL sm))))
         (g (list 'VNB-LAMBDA 'x 'RR (list '* c (list 'power 'x sm))))
         (lhs (list 'VNB-LAMBDA 'x 'RR (list 'DERIV g 'x)))
         (rhs (list 'VNB-LAMBDA 'x 'RR (list '* (list '* a (list 'recip (list 'FACTORIAL m))) (list 'power 'x m))))
         (val (lambda (v) (list '* (list '* sm c) (list 'power v m))))
         (dval! (lambda (v)       ; lands (= (DERIV g v) val(v))
                  (tcl-real! c)
                  (fact 'deriv-coef-monomial c m v)
                  (dk-fact! 'deriv-of-is-diff-at g v (val v)))))
    (tcl-ext! lhs rhs 'RR 'RR
      (lambda () (tcl-lam-type! (lambda (v) (subst (dval! v)) (tcl-real! (val v)) (ass))))
      (lambda () (tcl-lam-type! tcl-body-real!))
      (lambda (v)
        (dk-lam-b!)
        (subst (dval! v))
        (tcl-nat! m)
        (subst (dk-fact! 'tgd-recip-factorial-succ m))
        (tcl-crs!)))
    (subst (list '= lhs rhs))
    (qrfl)))
(qed 'nth-deriv-monomial-core)

;;; the same with the exponent p given by an equation p = m + k
(sp (make-wff '(FORALL tck_ (IMPLIES (IN tck_ NN) (FORALL tcm_ (IMPLIES (IN tcm_ NN)
   (FORALL tcp_ (IMPLIES (= tcp_ (+ tcm_ tck_))
     (== (NTH-DERIV (VNB-LAMBDA x RR (power x tcp_)) tck_)
         (VNB-LAMBDA x RR (* (* (FACTORIAL tcp_) (recip (FACTORIAL tcm_))) (power x tcm_))))))))))))
(let* ((lnd (dk-peel!))
       (eqn (tcl-first (dk-head? '=) lnd))
       (k (caddr (caddr eqn))) (m (cadr (caddr eqn))))
  (subst eqn)
  (dk-fact! 'nth-deriv-monomial-core k m)
  (ass))
(qed 'nth-deriv-monomial-gap)

;;; =====================================================================
;;; (3) THE HEADLINES OF 2.3.
;;;
;;; The notes' (8) reads  f^(k)(x) = k! x^(n-k) for k <= n,  0 for k > n.
;;; The first half is FALSE as printed (n = 2, k = 1: f'(x) = 2x, not 1! x);
;;; the coefficient is n! / (n-k)!.  It is proven here with that coefficient;
;;; n - k is NN-MINUS(n, k), the truncated difference of the tree, which is
;;; n - k exactly when k <= n.
;;; =====================================================================

;;; lands (= (+ 0 n) n)
(define (tcl-zero-add! n)
  (tcl-nat! 0) (tcl-nat! n)
  (dk-have! (list 'AND (list 'IN 0 'NN) (list 'IN n 'NN)))
  (fact 'nn-add-comm 0 n)
  (fact 'nn-add-zero n)
  (dk-have! (list '= (list '+ 0 n) n)
    (lambda () (subst (list '= (list '+ 0 n) (list '+ n 0))) (ass))))

;;; lands (= (DERIV (VNB-LAMBDA x RR c) v) 0), c and v real
(define (tcl-deriv-const-val! c v)
  (tcl-real! c) (tcl-real! v)
  (dk-have! (list 'AND (list 'IN c 'RR) (list 'IN v 'RR)))
  (fact 'deriv-const c v)
  (dk-fact! 'deriv-of-is-diff-at (list 'VNB-LAMBDA 'x 'RR c) v 0))

;;; the goal (== (VNB-LAMBDA x RR (DERIV (VNB-LAMBDA x RR c) x)) (VNB-LAMBDA x RR 0))
(define (tcl-deriv-const-fn-close! c)
  (let ((lhs (list 'VNB-LAMBDA 'x 'RR (list 'DERIV (list 'VNB-LAMBDA 'x 'RR c) 'x)))
        (rhs '(VNB-LAMBDA x RR 0)))
    (tcl-ext! lhs rhs 'RR 'RR
      (lambda () (tcl-lam-type! (lambda (v) (subst (tcl-deriv-const-val! c v)) (tcl-real! 0) (ass))))
      (lambda () (tcl-lam-type! tcl-body-real!))
      (lambda (v) (dk-lam-b!) (subst (tcl-deriv-const-val! c v)) (rfl)))
    (subst (list '= lhs rhs))
    (qrfl)))

;;; (3a) x^n differentiated n + 1 + j times is zero
(sp (make-wff '(FORALL tcj_ (IMPLIES (IN tcj_ NN)
   (FORALL n (IMPLIES (IN n NN)
     (== (NTH-DERIV (VNB-LAMBDA x RR (power x n)) (succ (+ n tcj_)))
         (VNB-LAMBDA x RR 0))))))))
(define tcl-vz-br (use-induction))
(define tcl-vz-j  (cdr (assq 'var tcl-vz-br)))
(define tcl-vz-ih (cdr (assq 'ih tcl-vz-br)))
;; base: f^(n) is the constant n!/0!, whose derivative vanishes
(dk-focus! (cdr (assq 'base tcl-vz-br)))
(let* ((n (dk-di-var!))
       (f (list 'VNB-LAMBDA 'x 'RR (list 'power 'x n)))
       (cc (list '* (list 'FACTORIAL n) (list 'recip (list 'FACTORIAL 0))))
       (g (list 'VNB-LAMBDA 'x 'RR (list '* cc (list 'power 'x 0)))))
  (subst (dk-fact! 'nn-add-zero n))
  (subst (dk-fact! 'nth-deriv-succ f n))
  (tcl-nat! 0)
  (tcl-zero-add! n)
  (dk-have! (list '= n (list '+ 0 n)) (lambda () (subst (list '= (list '+ 0 n) n)) (rfl)))
  (dk-fact! 'nth-deriv-monomial-gap n 0 n)
  (subst (list '= (list 'NTH-DERIV f n) g))
  ;; g is the constant function cc
  (tcl-ext! g (list 'VNB-LAMBDA 'x 'RR cc) 'RR 'RR
    (lambda () (tcl-lam-type! tcl-body-real!))
    (lambda () (tcl-lam-type! tcl-body-real!))
    (lambda (v)
      (dk-lam-b!)
      (fact 'rr-subset-cc v)
      (subst (dk-fact! 'power-zero v))
      (tcl-crs!)))
  (subst (list '= g (list 'VNB-LAMBDA 'x 'RR cc)))
  (tcl-deriv-const-fn-close! cc))
;; step
(dk-focus! (cdr (assq 'step tcl-vz-br)))
(let* ((j tcl-vz-j)
       (n (dk-di-var!))
       (f (list 'VNB-LAMBDA 'x 'RR (list 'power 'x n))))
  (tcl-nat! (list 'succ (list '+ n j)))
  (subst (dk-fact! 'nn-add-succ n j))
  (subst (dk-fact! 'nth-deriv-succ f (list 'succ (list '+ n j))))
  (subst (dk-apply! tcl-vz-ih n))
  (tcl-deriv-const-fn-close! 0))
(qed 'nth-deriv-monomial-beyond)

;;; (3b) 2.3, second half: k > n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL tck_ (IMPLIES (IN tck_ NN)
   (IMPLIES (< n tck_)
     (== (NTH-DERIV (VNB-LAMBDA x RR (power x n)) tck_) (VNB-LAMBDA x RR 0)))))))))
(let* ((lnd (dk-peel!))
       (lt (tcl-first (dk-head? '<) lnd))
       (n (cadr lt)) (k (caddr lt)))
  (fact 'nn-lt-succ-le n k)
  (tcl-nat! (list 'succ n))
  (let ((d (dk-skolem! (dk-fact! 'nn-le-gap k (list 'succ n)))))
    (subst (list '= k (list '+ (list 'succ n) d)))
    (subst (dk-fact! 'tab-succ-add n d))
    (dk-fact! 'nth-deriv-monomial-beyond d n)
    (ass)))
(qed 'nth-deriv-monomial-vanish)

;;; (3c) 2.3, first half: k <= n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL tck_ (IMPLIES (IN tck_ NN)
   (IMPLIES (<= tck_ n)
     (== (NTH-DERIV (VNB-LAMBDA x RR (power x n)) tck_)
         (VNB-LAMBDA x RR (* (* (FACTORIAL n) (recip (FACTORIAL (NN-MINUS n tck_))))
                             (power x (NN-MINUS n tck_))))))))))))
(let* ((lnd (dk-peel!))
       (le (tcl-first (dk-head? '<=) lnd))
       (k (cadr le)) (n (caddr le)))
  (let* ((d (dk-skolem! (dk-fact! 'nn-le-gap n k)))
         (ifterm (list 'IF (list '<= k n) (list '- n k) 0)))
    (dk-have! (list '= (list 'NN-MINUS n k) d)
      (lambda ()
        (subst (dk-fact! 'nn-minus-def n k))
        (dk-each-leaf! (lambda () (if-true ifterm))
          (lambda ()
            (if (dk-head-is? (dk-goal) '<=)
                (ass)
                (begin
                  (subst (list '= ifterm (list '- n k)))
                  (subst (list '= n (list '+ k d)))
                  (tcl-crs!)))))))
    (subst (list '= (list 'NN-MINUS n k) d))
    (tcl-nat! k) (tcl-nat! d)
    (dk-have! (list 'AND (list 'IN k 'NN) (list 'IN d 'NN)))
    (fact 'nn-add-comm k d)
    (dk-have! (list '= n (list '+ d k))
      (lambda () (subst (list '= n (list '+ k d))) (ass)))
    (dk-fact! 'nth-deriv-monomial-gap k d n)
    (ass)))
(qed 'nth-deriv-monomial)

;;; =====================================================================
;;; (4) THE POLYNOMIAL LAYER.
;;;
;;; Q(cf, n) below is  vnb-lambda(x, rr, series-partial-sum(vnb-lambda(k, nn,
;;; cf(k) * x ^ k), n)),  the polynomial with the n coefficients cf(0), ...,
;;; cf(n-1); the brief's "polynomial of degree <= n" is Q(cf, succ(n)).
;;; =====================================================================

(define (tcl-q cf n)
  (list 'VNB-LAMBDA 'x 'RR
        (list 'SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'k 'NN (list '* (list cf 'k) (list 'power 'x 'k))) n)))
(define (tcl-q-body cf n v)       ; Q(cf, n) at v, beta-reduced
  (list 'SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'k 'NN (list '* (list cf 'k) (list 'power v 'k))) n))

;;; (tcl-sps-cong! U W N PTWISE) -- land (= (SERIES-PARTIAL-SUM U N) (SERIES-PARTIAL-SUM W N)),
;;; U and W lambdas over NN (or members of FUN(NN, RR)) agreeing pointwise; PTWISE
;;; proves (= (U i) (W i)) for the eigenvariable i.  TYPE-U / TYPE-W prove the FUN typings.
(define (tcl-sps-cong! u w n type-u type-w ptwise)
  (dk-have! (list 'IN u '(FUN NN RR)) type-u)
  (dk-have! (list 'IN w '(FUN NN RR)) type-w)
  (let ((e (tcl-ext! u w 'NN 'RR type-u type-w ptwise))
        (goal (list '= (list 'SERIES-PARTIAL-SUM u n) (list 'SERIES-PARTIAL-SUM w n))))
    (tcl-nat! n)
    (fact 'series-partial-sum-in-rr n w)
    (if (alpha-equiv? (dk-goal) goal)
        (begin (subst e) (rfl) goal)
        (begin (dk-have! goal (lambda () (subst e) (rfl)))
               (dk-ctx-form goal)))))

;;; the typing of a lambda over NN with an arithmetic body
(define (tcl-nn-lam-type! . pre)
  (tcl-lam-type! (lambda (v) (for-each (lambda (p) (p v)) pre) (tcl-real! (cadr (dk-goal))) (ass))))

;;; land (IN (SERIES-PARTIAL-SUM U N) RR), U a lambda over NN; PRE are procedures of
;;; the index run before its body is typed
(define (tcl-sps-real! u n . pre)
  (dk-have! (list 'IN u '(FUN NN RR)) (lambda () (apply tcl-nn-lam-type! pre)))
  (tcl-nat! n)
  (fact 'series-partial-sum-in-rr n u)
  (list 'IN (list 'SERIES-PARTIAL-SUM u n) 'RR))

;;; (tcl-skolem-fn! BODY-OF TYPE!) -- land a fresh e in FUN(NN, RR) with
;;; forall i in NN. e(i) = BODY-OF(i), and return e.  TYPE! (a procedure of the
;;; index) lands (IN (BODY-OF i) RR) for an eigenvariable i.
(define (tcl-skolem-fn! body-of type!)
  (let* ((w (list 'VNB-LAMBDA 'tcw_ 'NN (body-of 'tcw_)))
         (ex (list 'FORSOME 'tce_
                   (list 'AND (list 'IN 'tce_ '(FUN NN RR))
                         (list 'FORALL 'tci_ (list 'IMPLIES '(IN tci_ NN)
                                                  (list '= '(tce_ tci_) (body-of 'tci_))))))))
    (dk-have! ex
      (lambda ()
        (ew w)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (tcl-lam-type! (lambda (v) (let ((leaf (proof-state-focus *ps*)))
                                             (type! v)
                                             (if (not (sequent-node-grounded? leaf)) (ass)))))
                (let ((i (dk-di-var!)))
                  (dk-lam-b!)
                  (type! i)
                  (rfl)))))))
    (dk-skolem! (dk-ctx-form ex))))

;;; (4a) the derivative function of a polynomial
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL cf (IMPLIES (IN cf (FUN NN RR))
   (FORALL tcd_ (IMPLIES (IN tcd_ (FUN NN RR))
     (IMPLIES (FORALL tcj_ (IMPLIES (IN tcj_ NN) (= (tcd_ tcj_) (* (succ tcj_) (cf (succ tcj_))))))
       (== (VNB-LAMBDA tcx_ RR (DERIV (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) (succ n))) tcx_))
           (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (tcd_ k) (power x k))) n))))))))))))
(let* ((lnd (dk-peel!))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (n  (cadr (tcl-first (lambda (f) (equal? (dk-head f) 'IN)) lnd)))
       (cf 'cf) (d 'tcd_)
       (p (tcl-q cf (list 'succ n)))
       (lhs (list 'VNB-LAMBDA 'tcx_ 'RR (list 'DERIV p 'tcx_)))   ; outer binder not x: x is bound in p
       (rhs (tcl-q d n))
       (dsum (lambda (v) (list 'SERIES-PARTIAL-SUM
                               (list 'VNB-LAMBDA 'j 'NN (list '* (list '* '(succ j) (list cf '(succ j))) (list 'power v 'j)))
                               n)))
       (dval! (lambda (v)
                (tcl-sps-real! (cadr (dsum v)) n
                  (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c cf 'NN 'RR (list 'succ i))))
                (fact 'deriv-polynomial n cf v)
                (dk-fact! 'deriv-of-is-diff-at p v (dsum v)))))
  (tcl-nat! n)
  (tcl-ext! lhs rhs 'RR 'RR
    (lambda () (tcl-lam-type! (lambda (v) (subst (dval! v))
                                (tcl-sps-real! (cadr (dsum v)) n
                                  (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c cf 'NN 'RR (list 'succ i))))
                                (ass))))
    (lambda () (fact 'poly-lam-in-fun d n) (ass))
    (lambda (v)
      (dk-lam-b!)
      (subst (dval! v))
      (let ((u (cadr (dsum v)))
            (w (list 'VNB-LAMBDA 'k 'NN (list '* (list d 'k) (list 'power v 'k)))))
        (tcl-sps-cong! u w n
          (lambda () (tcl-nn-lam-type! (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c cf 'NN 'RR (list 'succ i)))))
          (lambda () (tcl-nn-lam-type! (lambda (i) (fact 'fun-apply-type-c d 'NN 'RR i))))
          (lambda (i)
            (dk-lam-b!)
            (subst (dk-apply! hyp i))
            (tcl-nat! (list 'succ i))
            (fact 'fun-apply-type-c cf 'NN 'RR (list 'succ i))
            (tcl-real! (list '* (list '* (list 'succ i) (list cf (list 'succ i))) (list 'power v i)))
            (rfl)))
        )))
  (subst (list '= lhs rhs))
  (qrfl))
(qed 'poly-deriv-fn)

;;; the coefficient sequence of the derivative exists
(sp (make-wff '(FORALL cf (IMPLIES (IN cf (FUN NN RR))
   (FORSOME tcd_ (AND (IN tcd_ (FUN NN RR))
     (FORALL tcj_ (IMPLIES (IN tcj_ NN) (= (tcd_ tcj_) (* (succ tcj_) (cf (succ tcj_))))))))))))
(dk-peel!)
(let ((body-of (lambda (i) (list '* (list 'succ i) (list 'cf (list 'succ i)))))
      (type! (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c 'cf 'NN 'RR (list 'succ i))
                         (tcl-real! (list '* (list 'succ i) (list 'cf (list 'succ i)))))))
  (ew (list 'VNB-LAMBDA 'tcw_ 'NN (body-of 'tcw_)))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (tcl-lam-type! (lambda (v) (type! v) (ass)))
          (let ((i (dk-di-var!)))
            (dk-lam-b!)
            (type! i)
            (rfl))))))
(qed 'poly-deriv-coef-exists)

;;; (4b) the polynomial with no coefficient is the zero function, and so is its derivative
(sp (make-wff '(FORALL cf (IMPLIES (IN cf (FUN NN RR))
   (== (VNB-LAMBDA tcx_ RR (DERIV (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) 0)) tcx_))
       (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) 0)))))))
(dk-peel!)
(let* ((q0 (tcl-q 'cf 0))
       (z '(VNB-LAMBDA x RR 0)))
  (tcl-ext! q0 z 'RR 'RR
    (lambda () (fact 'poly-lam-in-fun 'cf 0) (ass))
    (lambda () (tcl-lam-type! tcl-body-real!))
    (lambda (v)
      (dk-lam-b!)
      (subst (dk-fact! 'series-partial-sum-zero (cadr (tcl-q-body 'cf 0 v))))
      (tcl-real! 0)
      (rfl)))
  (subst (list '= q0 z))
  (tcl-deriv-const-fn-close! 0))
(qed 'poly-deriv-fn-zero)

;;; (4c) every derivative of a polynomial is a function RR -> RR
(sp (make-wff '(FORALL tck_ (IMPLIES (IN tck_ NN)
   (FORALL n (IMPLIES (IN n NN) (FORALL cf (IMPLIES (IN cf (FUN NN RR))
     (IN (NTH-DERIV (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) n)) tck_)
         (FUN RR RR))))))))))
(define tcl-r-br (use-induction))
(define tcl-r-k  (cdr (assq 'var tcl-r-br)))
(define tcl-r-ih (cdr (assq 'ih tcl-r-br)))
(dk-focus! (cdr (assq 'base tcl-r-br)))
(let* ((lnd (dk-peel!))
       (n (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lnd)))
       (cf (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN RR)))) lnd))))
  (subst (dk-fact! 'nth-deriv-zero (tcl-q cf n)))
  (fact 'poly-lam-in-fun cf n)
  (ass))
(dk-focus! (cdr (assq 'step tcl-r-br)))
(let* ((k tcl-r-k)
       (lnd (dk-peel!))
       (n (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lnd)))
       (cf (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN RR)))) lnd))))
  (subst (dk-fact! 'nth-deriv-succ-inner k (tcl-q cf n)))
  (let ((dis (dk-fact! 'nn-zero-or-succ n)))
    (use-cases dis
      (lambda ()
        (subst (list '= n 0))
        (subst (dk-fact! 'poly-deriv-fn-zero cf))
        (tcl-nat! 0)
        (dk-apply! tcl-r-ih 0 cf)
        (ass))
      (lambda ()
        (let* ((q (dk-skolem! (tcl-first (dk-head? 'FORSOME) (dk-asms))))
               (d (dk-skolem! (dk-fact! 'poly-deriv-coef-exists cf))))
          (subst (list '= n (list 'succ q)))
          (subst (dk-apply! (dk-fact! 'poly-deriv-fn q cf d)))
          (dk-apply! tcl-r-ih q d)
          (ass))))))
(qed 'poly-nth-deriv-in-fun)

;;; land (IN U (FUN NN RR)) for the monomial summand of Q(cf, _) at v
(define (tcl-summand-type! cf v)
  (let ((u (list 'VNB-LAMBDA 'k 'NN (list '* (list cf 'k) (list 'power v 'k)))))
    (dk-have! (list 'IN u '(FUN NN RR))
      (lambda () (tcl-nn-lam-type! (lambda (i) (fact 'fun-apply-type-c cf 'NN 'RR i)))))
    u))

;;; rewrite (SERIES-PARTIAL-SUM U (succ IDX)) in the goal by the recurrence; U in FUN(NN, RR) in context
(define (tcl-sps-step! u idx)
  (tcl-nat! idx)
  (fact 'series-partial-sum-in-rr idx u)
  (fact 'fun-apply-type-c u 'NN 'RR idx)
  (subst (dk-fact! 'series-partial-sum-succ u idx)))

;;; (4d) a polynomial at 0 is its constant coefficient
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL cf (IMPLIES (IN cf (FUN NN RR))
   (= (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power 0 k))) (succ n)) (cf 0))))))))
(define tcl-z-br (use-induction))
(define tcl-z-n  (cdr (assq 'var tcl-z-br)))
(define tcl-z-ih (cdr (assq 'ih tcl-z-br)))
(dk-focus! (cdr (assq 'base tcl-z-br)))
(let* ((cf (dk-di-var!))
       (u (tcl-summand-type! cf 0)))
  (tcl-sps-step! u 0)
  (subst (dk-fact! 'series-partial-sum-zero u))
  (dk-lam-b!)
  (tcl-real! 0) (fact 'rr-subset-cc 0)
  (subst (dk-fact! 'power-zero 0))
  (fact 'fun-apply-type-c cf 'NN 'RR 0)
  (tcl-crs!))
(dk-focus! (cdr (assq 'step tcl-z-br)))
(let* ((n tcl-z-n)
       (cf (dk-di-var!))
       (u (tcl-summand-type! cf 0))
       (sn (list 'succ n)))
  (tcl-nat! sn)
  (tcl-sps-step! u sn)
  (subst (dk-apply! tcl-z-ih cf))
  (dk-lam-b!)
  (subst (dk-fact! 'power-zero-base n))
  (fact 'fun-apply-type-c cf 'NN 'RR 0)
  (fact 'fun-apply-type-c cf 'NN 'RR sn)
  (tcl-crs!))
(qed 'poly-value-at-zero)

;;; (4e) the k-th derivative of a polynomial at 0 is k! times its k-th coefficient
(sp (make-wff '(FORALL tck_ (IMPLIES (IN tck_ NN)
   (FORALL n (IMPLIES (IN n NN) (FORALL cf (IMPLIES (IN cf (FUN NN RR))
     (IMPLIES (<= tck_ n)
       (= ((NTH-DERIV (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) (succ n))) tck_) 0)
          (* (FACTORIAL tck_) (cf tck_))))))))))))
(define tcl-v-br (use-induction))
(define tcl-v-k  (cdr (assq 'var tcl-v-br)))
(define tcl-v-ih (cdr (assq 'ih tcl-v-br)))
(dk-focus! (cdr (assq 'base tcl-v-br)))
(let* ((lnd (dk-peel!))
       (n (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lnd)))
       (cf (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN RR)))) lnd))))
  (tcl-nat! (list 'succ n))
  (subst (dk-fact! 'nth-deriv-zero (tcl-q cf (list 'succ n))))
  (tcl-real! 0)
  (dk-lam-b!)
  (subst (dk-fact! 'poly-value-at-zero n cf))
  (fact 'factorial-zero)
  (subst '(= (factorial 0) (succ 0)))
  (fact 'nn-one-is-succ-zero)
  (subst '(= (succ 0) 1))
  (fact 'fun-apply-type-c cf 'NN 'RR 0)
  (tcl-crs!))
(dk-focus! (cdr (assq 'step tcl-v-br)))
(let* ((k tcl-v-k)
       (sk (list 'succ k))
       (lnd (dk-peel!))
       (n (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lnd)))
       (cf (cadr (tcl-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN RR)))) lnd))))
  (tcl-nat! sk)
  (let* ((e (dk-skolem! (dk-fact! 'nn-le-gap n sk)))
         (q (list '+ k e)))
    (fact 'tab-succ-add k e)
    (tcl-nat! q)
    (dk-have! (list '= n (list 'succ q))
      (lambda () (subst (list '= n (list '+ sk e))) (subst (list '= (list '+ sk e) (list 'succ q))) (rfl)))
    (subst (list '= n (list 'succ q)))
    (tcl-nat! (list 'succ q)) (tcl-nat! (list 'succ (list 'succ q)))
    (subst (dk-fact! 'nth-deriv-succ-inner k (tcl-q cf (list 'succ (list 'succ q)))))
    (let ((d (dk-skolem! (dk-fact! 'poly-deriv-coef-exists cf))))
      (subst (dk-apply! (dk-fact! 'poly-deriv-fn (list 'succ q) cf d)))
      (fact 'nn-le-add-right e k)
      (subst (dk-apply! tcl-v-ih q d))
      (subst (dk-apply! (tcl-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) (dk-asms)) k))
      (subst (dk-fact! 'factorial-succ k))
      (fact 'fun-apply-type-c cf 'NN 'RR sk)
      (tcl-crs!))))
(qed 'poly-nth-deriv-at-zero)

;;; =====================================================================
;;; (5) 2.16: THE INTERPOLATING POLYNOMIAL AT 0.
;;; =====================================================================

(define (tcl-p cf n) (tcl-q cf (list 'succ n)))
(define (tcl-dk f k) (list (list 'NTH-DERIV f k) 0))     ; f^(k)(0)

;;; rewrite (* (* A B) (recip A)) / (* A (* B (recip A))) shapes to B, with A = FACTORIAL(k):
;;; the goal (= LHS RHS) where RHS or LHS carries the factorial and its reciprocal.
(define (tcl-fact-cancel! k lhs-form rhs-form)
  ;; lhs-form is rewritten to rhs-form * (k! * recip(k!)) by crs, then the unit
  (let ((unit (list '* (list 'FACTORIAL k) (list 'recip (list 'FACTORIAL k)))))
    (dk-have! (list '= lhs-form (list '* rhs-form unit)) (lambda () (tcl-crs!)))
    (subst (list '= lhs-form (list '* rhs-form unit)))
    (tcl-nat! k)
    (subst (dk-fact! 'rr-recip-factorial k))
    (tcl-crs!)))

;;; (5a) derivatives at 0 determine the coefficients
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL f (FORALL cf (IMPLIES (IN cf (FUN NN RR))
   (IMPLIES (FORALL tck_ (IMPLIES (IN tck_ NN) (IMPLIES (<= tck_ n)
              (= ((NTH-DERIV (VNB-LAMBDA x RR (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power x k))) (succ n))) tck_) 0)
                 ((NTH-DERIV f tck_) 0)))))
     (FORALL tck_ (IMPLIES (IN tck_ NN) (IMPLIES (<= tck_ n)
       (= (cf tck_) (* ((NTH-DERIV f tck_) 0) (recip (FACTORIAL tck_)))))))))))))))
(let* ((lnd (dk-peel!))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (le (tcl-first (dk-head? '<=) lnd))
       (k (cadr le))
       (n (caddr le))
       (p (tcl-p 'cf n)))
  ;; let*, not let: both initialisers RECORD steps, and a `let' evaluates its
  ;; initialisers in an order that differs between compiled and interpreted code
  ;; (found 2026-09-24 by vnb-band-compare: the extension, loading this file from
  ;; source, recorded the two steps in the other order than the cold load did).
  (let* ((e1 (dk-apply! hyp k))
         (e2 (dk-apply! (dk-fact! 'poly-nth-deriv-at-zero k n 'cf))))
    (subst (list '= (tcl-dk 'f k) (tcl-dk p k)))
    (subst e2)
    (fact 'fun-apply-type-c 'cf 'NN 'RR k)
    (tcl-real! (list 'FACTORIAL k))
    (dk-have! (list '= (list '* (list 'FACTORIAL k) (list 'cf k)) (list '* (list 'cf k) (list 'FACTORIAL k)))
      (lambda () (tcl-crs!)))
    (tcl-fact-cancel! k (list '* (list '* (list 'FACTORIAL k) (list 'cf k)) (list 'recip (list 'FACTORIAL k))) (list 'cf k))))
(qed 'taylor-coef-from-derivs)

(define (tcl-G n f) (tcl-guard-le n (lambda (k) (list 'IN (tcl-dk f k) 'RR))))
(define (tcl-C n f c) (tcl-guard-le n (lambda (k) (list '= (list c k) (list '* (tcl-dk f k) (list 'recip (list 'FACTORIAL k)))))))
(define (tcl-D n f c) (tcl-guard-le n (lambda (k) (list '= (tcl-dk (tcl-p c n) k) (tcl-dk f k)))))

;;; (5b) the coefficients f^(k)(0)/k! give the derivatives at 0
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'f (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN RR))
   (list 'IMPLIES (tcl-G 'n 'f) (list 'IMPLIES (tcl-C 'n 'f 'cf) (tcl-D 'n 'f 'cf))))))))))
(let* ((lnd (dk-peel!))
       (le (tcl-first (dk-head? '<=) lnd))
       (k (cadr le)) (n (caddr le))
       (hyps (filter (dk-head? 'FORALL) lnd))
       (g (tcl-first (lambda (h) (dk-contains? h (list 'IN (tcl-dk 'f 'tck_) 'RR))) hyps))
       (c (tcl-first (lambda (h) (not (eq? h g))) hyps)))
  (dk-apply! g k)
  (subst (dk-apply! (dk-fact! 'poly-nth-deriv-at-zero k n 'cf)))
  (subst (dk-apply! c k))
  (tcl-fact-cancel! k (list '* (list 'FACTORIAL k) (list '* (tcl-dk 'f k) (list 'recip (list 'FACTORIAL k))))
                    (tcl-dk 'f k)))
(qed 'taylor-derivs-from-coef)

;;; (5c) 2.16: existence and uniqueness of the interpolating polynomial at 0
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'f (list 'IMPLIES (tcl-G 'n 'f)
   (list 'FORSOME 'cf (list 'AND '(IN cf (FUN NN RR))
     (list 'AND (tcl-C 'n 'f 'cf)
       (list 'AND (tcl-D 'n 'f 'cf)
         (list 'FORALL 'tcg_ (list 'IMPLIES '(IN tcg_ (FUN NN RR))
           (list 'IMPLIES (tcl-D 'n 'f 'tcg_)
             (tcl-guard-le 'n (lambda (k) (list '= (list 'tcg_ k) (list 'cf k)))))))))))))))))
(let* ((lnd (dk-peel!))
       (n (cadr (tcl-first (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lnd)))
       (g (tcl-first (dk-head? 'FORALL) lnd))
       (val (lambda (i) (list '* (tcl-dk 'f i) (list 'recip (list 'FACTORIAL i)))))
       (ifterm (lambda (i) (list 'IF (list '<= i n) (val i) 0)))
       (type! (lambda (i)
                (tcl-have! (list 'IN (ifterm i) 'RR)
                  (lambda ()
                    (use-em (list '<= i n)
                      (lambda ()
                        (dk-each-leaf! (lambda () (if-true (ifterm i)))
                          (lambda ()
                            (if (dk-head-is? (dk-goal) '<=)
                                (ass)
                                (begin (subst (list '= (ifterm i) (val i)))
                                       (dk-apply! g i)
                                       (tcl-real! (val i)) (ass))))))
                      (lambda ()
                        (dk-each-leaf! (lambda () (if-false (ifterm i)))
                          (lambda ()
                            (if (dk-head-is? (dk-goal) 'NOT)
                                (ass)
                                (begin (subst (list '= (ifterm i) 0))
                                       (tcl-real! 0) (ass)))))))))))
       (c (tcl-skolem-fn! ifterm type!))
       (cval (tcl-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h c))) (dk-asms))))
  ;; the coefficients are f^(k)(0)/k! below n
  (dk-have! (tcl-C n 'f c)
    (lambda ()
      (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<=) l2))))
        (subst (dk-apply! cval k))
        (dk-each-leaf! (lambda () (if-true (ifterm k)))
          (lambda ()
            (if (dk-head-is? (dk-goal) '<=)
                (ass)
                (begin (subst (list '= (ifterm k) (val k)))
                       (dk-apply! g k)
                       (tcl-real! (val k))
                       (rfl))))))))
  ;; hence its derivatives at 0 are f's
  (dk-apply! (dk-fact! 'taylor-derivs-from-coef n 'f c))
  ;; and any polynomial with those derivatives has those coefficients
  (dk-have! (list 'FORALL 'tcg_ (list 'IMPLIES '(IN tcg_ (FUN NN RR))
              (list 'IMPLIES (tcl-D n 'f 'tcg_)
                (tcl-guard-le n (lambda (k) (list '= (list 'tcg_ k) (list c k)))))))
    (lambda ()
      (let* ((l2 (dk-peel!))
             (le (tcl-first (dk-head? '<=) l2)) (k (cadr le))
             (cg (cadr (tcl-first (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(FUN NN RR)))) l2))))
        (let ((u (dk-apply! (dk-fact! 'taylor-coef-from-derivs n 'f cg))))
          (subst (dk-apply! u k)))
        (subst (dk-apply! (dk-ctx-form (tcl-C n 'f c)) k))
        (dk-apply! g k)
        (tcl-real! (val k))
        (rfl))))
  (ew c)
  (dk-conj-close! (lambda () (ass))))
(qed 'taylor-interpolant-at-zero)

;;; =====================================================================
;;; (6) 2.22: TAYLOR'S FORMULA IS EXACT FOR A POLYNOMIAL.
;;;
;;; By induction on the degree: for f of degree m + 1, f' is of degree m
;;; (poly-deriv-fn) and (f')^(k) = f^(k+1) (nth-deriv-succ-inner), so the
;;; hypothesis gives f'(a + t) as the derivative at t of the polynomial A(t)
;;; whose coefficients are f^(k+1)(a) / (k+1)! (poly-antiderivative);
;;; H(t) = f(a + t) - A(t) has derivative 0 everywhere (deriv-chain,
;;; deriv-difference) and is therefore constant (pw-zero-deriv-total), and
;;; H(0) = f(a).  No binomial theorem, no rearrangement of a double sum.
;;; =====================================================================

;;; sum_{i < n+1} u(i) = u(0) + sum_{i < n} u(i+1)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL tcu_ (IMPLIES (IN tcu_ (FUN NN RR))
   (= (SERIES-PARTIAL-SUM tcu_ (succ n))
      (+ (tcu_ 0) (SERIES-PARTIAL-SUM (VNB-LAMBDA tci_ NN (tcu_ (succ tci_))) n)))))))))
(define tcl-sh-br (use-induction))
(define tcl-sh-n  (cdr (assq 'var tcl-sh-br)))
(define tcl-sh-ih (cdr (assq 'ih tcl-sh-br)))
(define (tcl-shift-lam u) (list 'VNB-LAMBDA 'tci_ 'NN (list u '(succ tci_))))
(define (tcl-shift-type! u)
  (dk-have! (list 'IN (tcl-shift-lam u) '(FUN NN RR))
    (lambda () (tcl-lam-type! (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c u 'NN 'RR (list 'succ i)) (ass))))))
(dk-focus! (cdr (assq 'base tcl-sh-br)))
(let ((u (dk-di-var!)))
  (tcl-sps-step! u 0)
  (subst (dk-fact! 'series-partial-sum-zero u))
  (subst (dk-fact! 'series-partial-sum-zero (tcl-shift-lam u)))
  (tcl-crs!))
(dk-focus! (cdr (assq 'step tcl-sh-br)))
(let* ((n tcl-sh-n) (sn (list 'succ n))
       (u (dk-di-var!)))
  (tcl-nat! sn)
  (tcl-sps-step! u sn)
  (subst (dk-apply! tcl-sh-ih u))
  (tcl-shift-type! u)
  (tcl-sps-step! (tcl-shift-lam u) n)
  (dk-lam-b!)
  (fact 'fun-apply-type-c u 'NN 'RR 0)
  (fact 'series-partial-sum-in-rr n (tcl-shift-lam u))
  (tcl-crs!))
(qed 'series-partial-sum-shift)

;;; a polynomial of degree 0 is its constant coefficient
(sp (make-wff '(FORALL cf (IMPLIES (IN cf (FUN NN RR)) (FORALL tcv_ (IMPLIES (IN tcv_ RR)
   (= (SERIES-PARTIAL-SUM (VNB-LAMBDA k NN (* (cf k) (power tcv_ k))) (succ 0)) (cf 0))))))))
(dk-peel!)
(let ((u (tcl-summand-type! 'cf 'tcv_)))
  (tcl-sps-step! u 0)
  (subst (dk-fact! 'series-partial-sum-zero u))
  (dk-lam-b!)
  (fact 'rr-subset-cc 'tcv_)
  (subst (dk-fact! 'power-zero 'tcv_))
  (fact 'fun-apply-type-c 'cf 'NN 'RR 0)
  (tcl-crs!))
(qed 'poly-degree-zero-value)

;;; the Taylor summand  i |-> f^(i)(a) h^i / i!
(define (tcl-tsum f a h)
  (list 'VNB-LAMBDA 'tci_ 'NN
        (list '* (list '* (list (list 'NTH-DERIV f 'tci_) a) (list 'power h 'tci_))
                 (list 'recip (list 'FACTORIAL 'tci_)))))
;;; its typing, f = Q(cf, n)
(define (tcl-tsum-type! cf n a h)
  (let ((f (tcl-q cf n)))
    (dk-have! (list 'IN (tcl-tsum f a h) '(FUN NN RR))
      (lambda ()
        (tcl-nn-lam-type!
          (lambda (i)
            (dk-apply! (dk-fact! 'poly-nth-deriv-in-fun i n cf))
            (fact 'fun-apply-type-c (list 'NTH-DERIV f i) 'RR 'RR a)))))))

(define (tcl-T cf m a h)
  (let ((f (tcl-p cf m)))
    (list '= (list f (list '+ a h)) (list 'SERIES-PARTIAL-SUM (tcl-tsum f a h) (list 'succ m)))))

(sp (make-wff (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
   (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN RR))
     (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'h (list 'IMPLIES '(IN h RR)
       (tcl-T 'cf 'tcm_ 'a 'h)))))))))))
(define tcl-t-br (use-induction))
(define tcl-t-m  (cdr (assq 'var tcl-t-br)))
(define tcl-t-ih (cdr (assq 'ih tcl-t-br)))
;; ---- base: degree 0
(dk-focus! (cdr (assq 'base tcl-t-br)))
(let* ((lnd (dk-peel!))
       (cf (cadr (tcl-first (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(FUN NN RR)))) lnd)))
       (g (dk-goal))
       (a (cadr (cadr (cadr g)))) (h (caddr (cadr (cadr g))))
       (s1 '(succ 0))
       (p0 (tcl-p cf 0))
       (u (tcl-tsum p0 a h)))
  (tcl-nat! s1)
  (tcl-real! (list '+ a h))
  (dk-lam-b!)
  (subst (dk-fact! 'poly-degree-zero-value cf (list '+ a h)))
  (tcl-tsum-type! cf s1 a h)
  (tcl-sps-step! u 0)
  (subst (dk-fact! 'series-partial-sum-zero u))
  (dk-lam-b!)
  (subst (dk-fact! 'nth-deriv-zero p0))
  (dk-lam-b!)
  (subst (dk-fact! 'poly-degree-zero-value cf a))
  (fact 'rr-subset-cc h)
  (subst (dk-fact! 'power-zero h))
  (fact 'factorial-zero)
  (subst '(= (factorial 0) (succ 0)))
  (fact 'nn-one-is-succ-zero)
  (subst '(= (succ 0) 1))
  (subst (dk-fact! 'rr-recip-one))
  (fact 'fun-apply-type-c cf 'NN 'RR 0)
  (tcl-crs!))
;; ---- step: degree m + 1
(dk-focus! (cdr (assq 'step tcl-t-br)))
(let* ((m tcl-t-m) (n1 (list 'succ m)) (n2 (list 'succ n1))
       (lnd (dk-peel!))
       (cf (cadr (tcl-first (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(FUN NN RR)))) lnd)))
       (g0 (dk-goal))
       (a (cadr (cadr (cadr g0)))) (h (caddr (cadr (cadr g0))))
       (f (tcl-p cf n1)))
  (tcl-nat! n1) (tcl-nat! n2)
  (let* ((d (dk-skolem! (dk-fact! 'poly-deriv-coef-exists cf)))
         (dhyp (tcl-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm d))) (dk-asms)))
         (g (tcl-p d m))
         (dlam (list 'VNB-LAMBDA 'x 'RR (list 'DERIV f 'x)))
         (pdf (dk-apply! (dk-fact! 'poly-deriv-fn n1 cf d)))
         (dfa (lambda (i) (list (list 'NTH-DERIV f i) a)))          ; f^(i)(a)
         (dfa-type! (lambda (i)
                      (dk-apply! (dk-fact! 'poly-nth-deriv-in-fun i n2 cf))
                      (fact 'fun-apply-type-c (list 'NTH-DERIV f i) 'RR 'RR a)))
         (ebody (lambda (i) (list '* (list 'succ i) (list '* (dfa (list 'succ i)) (list 'recip (list 'FACTORIAL (list 'succ i)))))))
         (e (tcl-skolem-fn! ebody
              (lambda (i)
                (tcl-have! (list 'IN (ebody i) 'RR)
                  (lambda () (tcl-nat! (list 'succ i)) (dfa-type! (list 'succ i)) (tcl-real! (ebody i)) (ass))))))
         (ehyp (tcl-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm e))) (dk-asms)))
         (wa (lambda (v) (list 'VNB-LAMBDA 'k 'NN (list '* (list '* '(recip (succ k)) (list e 'k)) (list 'power v '(succ k))))))
         (aa (list 'VNB-LAMBDA 'x 'RR (list 'SERIES-PARTIAL-SUM (wa 'x) n1)))
         (ss (list 'VNB-LAMBDA 'x 'RR (list '+ a (list '* 1 'x))))
         (cfs (list 'COMPOSE f ss))
         (hh (list 'VNB-LAMBDA 'x 'RR (list '- (list cfs 'x) (list aa 'x))))
         (wa-type! (lambda (v) (tcl-real! v) (fact 'anti-term-lam-in-fun e v))))
    ;; typings
    (fact 'poly-lam-in-fun cf n2)
    (dk-have! (list 'IN ss '(FUN RR RR)) (lambda () (tcl-lam-type! tcl-body-real!)))
    (fact 'anti-lam-in-fun e n1)
    (fact 'rr-is-set)
    (dk-have! (list 'AND (list 'IN ss '(FUN RR RR)) (list 'IN f '(FUN RR RR))))
    (fact 'compose-type 'RR 'RR 'RR f ss)
    (let ((capply (dk-fact! 'compose-apply 'RR 'RR 'RR f ss)))
      (dk-have! (list 'IN hh '(FUN RR RR))
        (lambda () (tcl-lam-type! (lambda (v)
                                    (fact 'fun-apply-type-c cfs 'RR 'RR v)
                                    (fact 'fun-apply-type-c aa 'RR 'RR v)
                                    (tcl-body-real! v)))))
      ;; ---- H' = 0 everywhere
      (let ((zz (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ RR) (list 'IS-DIFF-AT hh 'tct_ 0)))))
        (dk-have! zz
          (lambda ()
            (let* ((t (dk-di-var!))
                   (st (list ss t))
                   (u1 (list 'VNB-LAMBDA 'j 'NN (list '* (list '* '(succ j) (list cf '(succ j))) (list 'power st 'j))))
                   (ds (list 'SERIES-PARTIAL-SUM u1 n1))
                   (ue (list 'VNB-LAMBDA 'k 'NN (list '* (list e 'k) (list 'power t 'k))))
                   (ad (list 'SERIES-PARTIAL-SUM ue n1))
                   (cf-succ-type! (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c cf 'NN 'RR (list 'succ i)))))
              (fact 'fun-apply-type-c ss 'RR 'RR t)
              (tcl-sps-real! u1 n1 cf-succ-type!)
              (fact 'deriv-polynomial n1 cf st)
              (tcl-real! a) (tcl-real! 1)
              (dk-have! (list 'AND (list 'IN a 'RR) (list 'AND '(IN 1 RR) (list 'IN t 'RR))))
              (fact 'deriv-affine a 1 t)
              (fact 'deriv-chain ss f t 1 ds)
              (tcl-sps-real! ue n1 (lambda (i) (fact 'fun-apply-type-c e 'NN 'RR i)))
              (fact 'poly-antiderivative m e t)
              (tcl-real! (list '* ds 1))
              (fact 'deriv-difference cfs aa t (list '* ds 1) ad)
              ;; the value: DS = AD
              (tcl-real! (list '+ a t))
              (let* ((e2 (begin (dk-have! (list '= st (list '+ a t)) (lambda () (dk-lam-b!) (tcl-crs!)))
                                (list '= st (list '+ a t))))
                     (w2 (list 'VNB-LAMBDA 'k 'NN (list '* (list d 'k) (list 'power (list '+ a t) 'k))))
                     (u1r (list 'VNB-LAMBDA 'j 'NN (list '* (list '* '(succ j) (list cf '(succ j))) (list 'power (list '+ a t) 'j))))
                     (e1 (tcl-sps-cong! u1r w2 n1
                           (lambda () (tcl-nn-lam-type! cf-succ-type!))
                           (lambda () (tcl-nn-lam-type! (lambda (i) (fact 'fun-apply-type-c d 'NN 'RR i))))
                           (lambda (i)
                             (dk-lam-b!)
                             (subst (dk-apply! dhyp i))
                             (cf-succ-type! i)
                             (tcl-real! (list '* (list '* (list 'succ i) (list cf (list 'succ i))) (list 'power (list '+ a t) i)))
                             (rfl))))
                     (e4 (begin (tcl-sps-real! w2 n1 (lambda (i) (fact 'fun-apply-type-c d 'NN 'RR i)))
                                (dk-have! (list '= (list g (list '+ a t)) (list 'SERIES-PARTIAL-SUM w2 n1))
                                          (lambda () (dk-lam-b!) (rfl)))
                                (list '= (list g (list '+ a t)) (list 'SERIES-PARTIAL-SUM w2 n1))))
                     (ih (dk-apply! tcl-t-ih d a t)))
                (dk-have! (list '= ds ad)
                  (lambda ()
                    (subst e2)
                    (subst e1)
                    (subst (list '= (caddr e4) (cadr e4)))
                    (subst ih)
                    (tcl-tsum-type! d n1 a t)
                    (tcl-sps-cong! (tcl-tsum g a t) ue n1
                      (lambda () #t)
                      (lambda () (tcl-nn-lam-type! (lambda (i) (fact 'fun-apply-type-c e 'NN 'RR i))))
                      (lambda (i)
                        (dk-lam-b!)
                        (subst (list '= g dlam))
                        (fact 'nth-deriv-succ-inner i f)
                        (subst (list '= (list 'NTH-DERIV dlam i) (list 'NTH-DERIV f (list 'succ i))))
                        (tcl-nat! (list 'succ i))
                        (subst (dk-apply! ehyp i))
                        (subst (dk-fact! 'tgd-recip-factorial-succ i))
                        (dfa-type! (list 'succ i))
                        (tcl-crs!)))))
                (dk-have! (list '= (list '- (list '* ds 1) ad) 0)
                  (lambda () (subst (list '= ds ad)) (tcl-crs!)))
                (subst (list '= 0 (list '- (list '* ds 1) ad)))
                (ass)))))
        ;; ---- H is continuous, hence constant
        (let ((cont (list 'FORALL 'pax_ (list 'IMPLIES '(IN pax_ RR) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS hh 'pax_)))))
          (dk-have! cont (lambda () (let ((xv (dk-di-var!)))
                                      (dk-apply! (dk-ctx-form zz) xv)
                                      (fact 'diff-implies-continuous hh xv 0)
                                      (ass))))
          (let* ((hv (lambda (v) (list hh v)))
                 (eqh (list '= (hv h) (hv 0)))
                 (const! (lambda (u v)
                           (let* ((u0 (dk-fact! 'pw-zero-deriv-total hh))
                                  (u1 (if (dk-head-is? u0 'IMPLIES) (dk-landed-1 (lambda () (detach! u0))) u0))
                                  (ch (inst*! u1 u v)))
                             (detach-with! ch
                               (lambda () (let ((y (dk-di-var!)))
                                            (fact 'ooint-elt-in-rr u v y)
                                            (dk-apply! (dk-ctx-form zz) y)
                                            (ass)))))))
                 (xa (list 'SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'k 'NN (list '* (list cf 'k) (list 'power a 'k))) n2))
                 (xah (list 'SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'k 'NN (list '* (list cf 'k) (list 'power (list '+ a h) 'k))) n2))
                 (cf-type! (lambda (i) (fact 'fun-apply-type-c cf 'NN 'RR i))))
            (tcl-real! 0) (tcl-real! (list '+ a h))
            (fact 'fun-apply-type-c hh 'RR 'RR h)
            (fact 'fun-apply-type-c hh 'RR 'RR 0)
            (fact 'fun-apply-type-c f 'RR 'RR (list '+ a h))
            (fact 'fun-apply-type-c f 'RR 'RR a)
            (fact 'fun-apply-type-c aa 'RR 'RR h)
            (tcl-sps-real! (cadr xa) n2 cf-type!)
            (tcl-sps-real! (cadr xah) n2 cf-type!)
            (wa-type! h) (tcl-nat! n1)
            (fact 'series-partial-sum-in-rr n1 (wa h))
            (wa-type! 0)
            (fact 'series-partial-sum-in-rr n1 (wa 0))
            (dk-have! eqh
              (lambda ()
                (let ((tri (dk-fact! 'rr-lt-trichotomy h 0)))
                  (use-cases tri
                    (lambda () (const! h 0) (ass))
                    (lambda () (subst (list '= h 0)) (rfl))
                    (lambda () (const! 0 h) (subst (list '= (hv h) (hv 0))) (rfl))))))
            ;; ---- the values of H at h and at 0
            (dk-have! (list '= (hv h) (list '- (list f (list '+ a h)) (list aa h)))
              (lambda ()
                (dk-lam-b!)
                (subst (dk-apply! capply h))
                (dk-have! (list '= (list ss h) (list '+ a h)) (lambda () (dk-lam-b!) (tcl-crs!)))
                (subst (list '= (list ss h) (list '+ a h)))
                (dk-lam-b!)
                (rfl)))
            (dk-have! (list '= (hv 0) (list f a))
              (lambda ()
                (dk-lam-b!)
                (subst (dk-apply! capply 0))
                (dk-have! (list '= (list ss 0) a) (lambda () (dk-lam-b!) (tcl-crs!)))
                (subst (list '= (list ss 0) a))
                (dk-lam-b!)
                (tcl-sps-cong! (wa 0) '(VNB-LAMBDA n_ NN 0) n1
                  (lambda () #t)
                  (lambda () (tcl-nn-lam-type!))
                  (lambda (i)
                    (dk-lam-b!)
                    (subst (dk-fact! 'power-zero-base i))
                    (fact 'fun-apply-type-c e 'NN 'RR i)
                    (tcl-crs!)))
                (subst (list '= (list 'SERIES-PARTIAL-SUM (wa 0) n1) (list 'SERIES-PARTIAL-SUM '(VNB-LAMBDA n_ NN 0) n1)))
                (subst (dk-fact! 'series-partial-sum-zero-seq n1))
                (tcl-crs!)))
            ;; ---- the Taylor sum: its first term is f(a), the rest is A(h)
            (let ((ts (tcl-tsum f a h)))
              (tcl-tsum-type! cf n2 a h)
              (tcl-nat! 0)
              (subst (dk-fact! 'series-partial-sum-shift n1 ts))
              (dk-have! (list '= (list ts 0) (list f a))
                (lambda ()
                  (dk-lam-b!)
                  (subst (dk-fact! 'nth-deriv-zero f))
                  (dk-lam-b!)
                  (fact 'rr-subset-cc h)
                  (subst (dk-fact! 'power-zero h))
                  (fact 'factorial-zero)
                  (subst '(= (factorial 0) (succ 0)))
                  (fact 'nn-one-is-succ-zero)
                  (subst '(= (succ 0) 1))
                  (subst (dk-fact! 'rr-recip-one))
                  (tcl-crs!)))
              (tcl-shift-type! ts)
              (let ((e3 (tcl-sps-cong! (tcl-shift-lam ts) (wa h) n1
                          (lambda () #t)
                          (lambda () #t)
                          (lambda (i)
                            (let* ((si (list 'succ i))
                                   (dd (dfa si))
                                   (rr0 (list 'recip (list 'FACTORIAL si)))
                                   (hp (list 'power h si))
                                   (c (list '* dd rr0)))
                              (tcl-nat! si)
                              (dk-lam-b!)
                              (subst (dk-apply! ehyp i))
                              (dfa-type! si)
                              (tcl-real! c) (tcl-real! hp)
                              (dk-have! (list '= (list '* (list '* dd hp) rr0) (list '* c hp)) (lambda () (tcl-crs!)))
                              (subst (list '= (list '* (list '* dd hp) rr0) (list '* c hp)))
                              (subst (dk-fact! 'recip-succ-cancel i c hp))
                              (tcl-crs!)))))
                    (va (list '= (list aa h) (list 'SERIES-PARTIAL-SUM (wa h) n1))))
                (dk-have! va (lambda () (dk-lam-b!) (rfl)))
                (subst (list '= (list ts 0) (list f a)))
                (subst e3)
                (subst (list '= (caddr va) (cadr va)))
                (dk-have! (list '= (list '- (list f (list '+ a h)) (list aa h)) (list f a))
                  (lambda ()
                    (subst (list '= (list '- (list f (list '+ a h)) (list aa h)) (hv h)))
                    (subst eqh)
                    (subst (list '= (hv 0) (list f a)))
                    (rfl)))
                (subst (list '= (list f a) (list '- (list f (list '+ a h)) (list aa h))))
                (tcl-crs!)))))))))
(qed 'taylor-exact-polynomial)

;;; =====================================================================
;;; (7) 2.20: THE SUP BOUND FOR THE REMAINDER.
;;;
;;; Under the hypotheses of 2.18 (the Taylor family of interval-taylor.scm),
;;;     |R_n(a, b)| <= (b - a)^n / n!  sup { |f^(n)(xi)| : xi in (a, b) }.
;;; The notes leave implicit that the set is bounded above (without it the
;;; sup is +infinity and (24) says nothing); SUP is the tree's total functoid,
;;; governed by rr-sup-upper only for a nonempty set bounded above, so the
;;; boundedness is a HYPOTHESIS here.  From 2.19 (taylor-lagrange-on-interval)
;;; and rr-sup-upper at the Lagrange point.
;;; =====================================================================
(define (tcl-supset d n a b)
  (list 'IMAGE (list 'VNB-LAMBDA 'tcv_ (list 'OOINT a b) (list 'ABS (list (list d n) 'tcv_))) (list 'OOINT a b)))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
   (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
     (list 'IMPLIES '(IS-TAYLOR-FAMILY tcf_ (succ tcm_) a b)
       (list 'IMPLIES (list 'RR-BOUNDED-ABOVE (tcl-supset 'tcf_ '(succ tcm_) 'a 'b))
         (list '<= '(ABS (TAYLOR-REM tcf_ (succ tcm_) a b))
               (list '* '(* (power (- b a) (succ tcm_)) (recip (FACTORIAL (succ tcm_))))
                        (list 'SUP (tcl-supset 'tcf_ '(succ tcm_) 'a 'b)))))))))))))))
(let* ((lnd (dk-peel!))
       (fam (tcl-first (dk-head? 'IS-TAYLOR-FAMILY) lnd))
       (d (cadr fam)) (n (caddr fam)) (m (cadr n)) (a (cadddr fam)) (b (car (cddddr fam)))
       (sset (cadr (tcl-first (dk-head? 'RR-BOUNDED-ABOVE) lnd)))
       (phi (cadr sset))
       (dom (list 'OOINT a b))
       (xi (dk-skolem! (dk-fact! 'taylor-lagrange-on-interval a b d m)))
       (req (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'taylor-rem))) (dk-asms)))
       (dd (list (list d n) xi))
       (r (list 'recip (list 'FACTORIAL n)))
       (bma (list '- b a))
       (pp (list 'power bma n))
       (rp (list '* r pp))
       (sup (list 'SUP sset)))
  (subst req)
  (fact 'taylor-family-top-in-fun d n a b)
  (fact 'fun-apply-type-c (list d n) dom 'RR xi)
  (fact 'taylor-family-endpoints-lt d n a b)
  (tcl-real! pp) (tcl-real! r) (tcl-real! rp)
  (fact 'rr-abs-closed dd)
  ;; the two nonnegative factors
  (dk-have! (list '<= 0 bma) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '< a b))))
  (fact 'rr-power-nonneg n bma)
  (tcl-nat! n)
  (dk-split! (dk-fact! 'factorial-real-pos n))
  (fact 'rr-recip-pos (list 'FACTORIAL n))
  (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
  (dk-have! (list 'AND (list 'IN r 'RR) (list 'IN pp 'RR)))
  (dk-have! (list 'AND (list '<= 0 r) (list '<= 0 pp)))
  (fact 'rr-leq-mul-nonneg r pp)
  ;; |D r P| = |D| (r P)
  (let ((eabs (list '= (list 'ABS (list '* (list '* dd r) pp)) (list '* (list 'ABS dd) rp))))
    (dk-have! eabs
      (lambda ()
        (tcl-real! (list '* dd r))
        (dk-have! (list 'AND (list 'IN (list '* dd r) 'RR) (list 'IN pp 'RR)))
        (subst (dk-fact! 'rr-abs-mult (list '* dd r) pp))
        (dk-have! (list 'AND (list 'IN dd 'RR) (list 'IN r 'RR)))
        (subst (dk-fact! 'rr-abs-mult dd r))
        (subst (dk-fact! 'rr-abs-of-nonneg r))
        (subst (dk-fact! 'rr-abs-of-nonneg pp))
        (tcl-crs!)))
    ;; |D| <= sup S
    (fact 'fun-domain-in-set dom 'RR (list d n))
    (dk-have! (list 'IN phi (list 'FUN dom 'RR))
      (lambda () (tcl-lam-type! (lambda (v)
                                  (fact 'fun-apply-type-c (list d n) dom 'RR v)
                                  (fact 'rr-abs-closed (list (list d n) v))
                                  (ass)))))
    (dk-have! (list 'SUBSET sset 'RR)
      (lambda () (let ((w (subset-by-element!)))
                   (fact 'image-subset-codomain dom 'RR phi w)
                   (ass))))
    (dk-have! (list 'IN (list 'ABS dd) sset)
      (lambda ()
        (mac 'image-membership-iff)
        (ew xi)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (ass)
                (begin (dk-lam-b!) (rfl)))))))
    (dk-have! (list 'FORSOME 'tcy_ (list 'IN 'tcy_ sset)) (lambda () (ew (list 'ABS dd)) (ass)))
    (let* ((ub (dk-fact! 'rr-sup-upper sset))
           (parts (dk-split! (dk-landed-1 (lambda () (mac-h 'rr-upper-bound ub)))))
           (univ (tcl-first (dk-head? 'FORALL) parts)))
      (dk-apply! univ (list 'ABS dd)))
    (fact 'rr-mul-le-right (list 'ABS dd) sup rp)
    (dk-have! (list '= (list '* (list '* pp r) sup) (list '* sup rp)) (lambda () (tcl-crs!)))
    (subst eabs)
    (subst (list '= (list '* (list '* pp r) sup) (list '* sup rp)))
    (ass)))
(qed 'taylor-remainder-sup-bound)

;;; =====================================================================
;;; (8) TOWARDS 2.21: THE LAGRANGE FORM ON A SUBINTERVAL [a, t].
;;;
;;; The notes' proof of 2.21 rests on one line: "by Corollary 2.19, for every
;;; t > a there is a xi in (a, t) with R_n(t) = f^(n)(xi) (t - a)^n / n!".  For
;;; functions ON [a, b] that line is not an instance of 2.19, which speaks of the
;;; whole interval: the family must be RESTRICTED to [a, t] (f^(n) to (a, t)),
;;; shown to be a Taylor family there, and its remainder identified with the
;;; original one.  That is `taylor-lagrange-subinterval'.  The family here is
;;; the hypothesis of 2.21: f, ..., f^(n) all ON [a, b], f^(k) continuous for
;;; k < n with derivative f^(k+1) on (a, b).
;;; =====================================================================

;;; two partial sums agree when their terms agree below n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL tcu_ (FORALL tcg_
   (IMPLIES (FORALL tck_ (IMPLIES (IN tck_ NN) (IMPLIES (< tck_ n) (IN (tcg_ tck_) RR))))
     (IMPLIES (FORALL tck_ (IMPLIES (IN tck_ NN) (IMPLIES (< tck_ n) (= (tcu_ tck_) (tcg_ tck_)))))
       (= (SERIES-PARTIAL-SUM tcu_ n) (SERIES-PARTIAL-SUM tcg_ n))))))))))
(define tcl-ab-br (use-induction))
(define tcl-ab-n  (cdr (assq 'var tcl-ab-br)))
(define tcl-ab-ih (cdr (assq 'ih tcl-ab-br)))
(dk-focus! (cdr (assq 'base tcl-ab-br)))
(dk-peel!)
(subst (dk-fact! 'series-partial-sum-zero 'tcu_))
(subst (dk-fact! 'series-partial-sum-zero 'tcg_))
(fact 'rr-zero-in)
(rfl)
(dk-focus! (cdr (assq 'step tcl-ab-br)))
(let* ((n tcl-ab-n) (sn (list 'succ n))
       (lnd (dk-peel!))
       (hs (filter (dk-head? 'FORALL) lnd))
       (hty (tcl-first (lambda (h) (dk-contains? h 'RR)) hs))
       (heq (tcl-first (lambda (h) (not (eq? h hty))) hs))
       (u 'tcu_) (g 'tcg_)
       (below! (lambda (h)          ; the hypothesis H at succ n, restricted to k < n
                 (let ((body (caddr (caddr (caddr h)))))
                   (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
                                  (tcl-replace body (cadr h) 'tck_))))
                     (lambda ()
                       (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                         (tcl-nat! sn) (tcl-real! k) (tcl-real! n) (tcl-real! sn)
                         (fact 'bt-lt-succ n)
                         (dk-have! (list '< k sn)
                           (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list 'IN sn 'RR)
                                                (list '< k n) (list '< n sn))))
                         (dk-apply! h k)
                         (ass))))))))
  (tcl-nat! sn)
  (below! hty) (below! heq)
  (let ((e (dk-apply! tcl-ab-ih u g)))
    (fact 'series-partial-sum-in-rr-below n g)
    (tcl-real! n) (tcl-real! sn)
    (fact 'bt-lt-succ n)
    (dk-apply! hty n)
    (let ((tcen (dk-apply! heq n)))
      (dk-have! (list 'IN (list 'SERIES-PARTIAL-SUM u n) 'RR) (lambda () (subst e) (ass)))
      (dk-have! (list 'IN (list u n) 'RR) (lambda () (subst tcen) (ass)))
      (subst (dk-fact! 'series-partial-sum-succ u n))
      (subst (dk-fact! 'series-partial-sum-succ g n))
      (subst e) (subst tcen)
      (tcl-real! (list '+ (list 'SERIES-PARTIAL-SUM g n) (list g n)))
      (rfl))))
(qed 'series-partial-sum-agree-below)

;;; the family hypothesis of 2.21, as a formula (d, order n, interval [a, b])
(define (tcl-h21 d n a b)
  (list (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '<= 'tck_ n)
          (list 'IN (list d 'tck_) (list 'FUN (list 'CCINT a b) 'RR)))))
        (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
          (list 'IS-CONTINUOUS-ON (list d 'tck_) (list 'CCINT a b)))))
        (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
          (list 'FORALL 'tcx_ (list 'IMPLIES (list 'IN 'tcx_ (list 'OOINT a b))
            (list 'HAS-DERIV-AT (list d 'tck_) 'tcx_ (list (list d '(succ tck_)) 'tcx_)))))))))

(sp (make-wff
  (let ((h (tcl-h21 'tcf_ '(succ tcm_) 'a 'b)))
    (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
      (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
        (list 'IMPLIES (car h) (list 'IMPLIES (cadr h) (list 'IMPLIES (caddr h)
          (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ RR) (list 'IMPLIES '(< a tct_) (list 'IMPLIES '(<= tct_ b)
            (list 'FORSOME 'tcxi_ (list 'AND '(IN tcxi_ (OOINT a tct_))
              '(= (TAYLOR-REM tcf_ (succ tcm_) a tct_)
                  (* (* ((tcf_ (succ tcm_)) tcxi_) (recip (FACTORIAL (succ tcm_)))) (power (- tct_ a) (succ tcm_)))))))))))))))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (rem (cadr (caddr (caddr g0))))          ; (TAYLOR-REM d n a t)
       (d (cadr rem)) (n (caddr rem)) (m (cadr n)) (a (cadddr rem)) (t (car (cddddr rem)))
       (b (caddr (tcl-first (lambda (fm) (and (dk-head-is? fm '<=) (eq? (cadr fm) t))) lnd)))
       (hs (filter (dk-head? 'FORALL) lnd))
       (hty (tcl-first (lambda (h) (dk-contains? h 'FUN)) hs))
       (hco (tcl-first (lambda (h) (dk-contains? h 'IS-CONTINUOUS-ON)) hs))
       (hdv (tcl-first (lambda (h) (dk-contains? h 'HAS-DERIV-AT)) hs))
       (cab (list 'CCINT a b)) (cat (list 'CCINT a t)) (oat (list 'OOINT a t)) (oab (list 'OOINT a b))
       (ifk (lambda (k) (list 'IF (list '< k n) (list 'RESTRICT (list d k) cat) (list 'RESTRICT (list d k) oat))))
       (d2 (list 'VNB-LAMBDA 'tcw_ 'NN (ifk 'tcw_)))
       (in-cab! (lambda (z)                     ; z in [a, t] (in context) gives z in [a, b]
                  (fact 'subset-mem-fwd cat cab z)))
       (ty-at! (lambda (k)                      ; d(k) in FUN([a, b], RR) for k <= n in context
                 (dk-apply! hty k))))
  (tcl-nat! n) (tcl-real! n) (tcl-real! a) (tcl-real! t)
  (fact 'nn-one-le-succ m)
  (dk-have! (list '<= a a) (lambda () (dk-ineq! (list 'IN a 'RR))))
  (dk-have! (list '< a b) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list 'IN b 'RR) (list '< a t) (list '<= t b))))
  (fact 'ccint-subset-ccint a b a t)
  (fact 'ooint-subset-ccint a t)
  (dk-have! (list 'SUBSET oat cab)
    (lambda () (let ((w (subset-by-element!)))
                 (fact 'subset-mem-fwd oat cat w)
                 (fact 'subset-mem-fwd cat cab w)
                 (ass))))
  (fact 'rr-is-metric-space)
  (dk-have! (list 'SUBSET cab '(PTS RR-MS))
    (lambda () (slot 'PTS) (fact 'ccint-subset-rr a b) (ass)))
  ;; ---- the restricted family is a Taylor family on [a, t]
  (dk-have! (list 'IS-TAYLOR-FAMILY d2 n a t)
    (lambda ()
      (mac 'IS-TAYLOR-FAMILY)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
               ;; d2(n) in FUN((a, t), RR)
               (dk-lam-b!)
               (tcl-real! n) (fact 'rr-lt-irrefl n)
               (dk-each-leaf! (lambda () (if-false (ifk n)))
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'NOT)
                       (ass)
                       (begin
                         (subst (list '= (ifk n) (list 'RESTRICT (list d n) oat)))
                         (fact 'nn-le-refl n)
                         (ty-at! n)
                         (fact 'restrict-in-fun (list d n) cab 'RR oat)
                         (ass))))))
              ((dk-head-is? g 'FORALL)
               (let* ((l2 (dk-peel!))
                      (k (cadr (tcl-first (dk-head? '<) l2)))
                      (sk (list 'succ k))
                      (rk (list 'RESTRICT (list d k) cat)))
                 (tcl-nat! sk) (tcl-real! k)
                 (dk-have! (list '<= k n) (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list '< k n))))
                 (ty-at! k)
                 (dk-lam-b!)
                 (dk-each-leaf! (lambda () (if-true (ifk k)))
                   (lambda ()
                     (if (dk-head-is? (dk-goal) '<)
                         (ass)
                         (begin
                           (subst (list '= (ifk k) rk))
                           (fact 'restrict-in-fun (list d k) cab 'RR cat)
                           (dk-conj-close!
                             (lambda ()
                               (let ((g2 (dk-goal)))
                                 (cond
                                   ((dk-head-is? g2 'IN) (ass))
                                   ((dk-head-is? g2 'IS-CONTINUOUS-ON)
                                    (let ((cu (dk-apply! hco k)))
                                      (let ((cu2 (begin
                                                   (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-CONTINUOUS-ON cu))))
                                                   (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT)
                                                                              (dk-contains? fm (list d k))))
                                                            "the continuity universal on [a, b]"))))
                                        (mac 'IS-CONTINUOUS-ON)
                                        (dk-conj-close!
                                          (lambda ()
                                            (if (not (dk-head-is? (dk-goal) 'FORALL))
                                                (ass)
                                                (let ((z (dk-di-var!)))
                                                  (in-cab! z)
                                                  (dk-apply! cu2 z)
                                                  (fact 'subspace-restrict-continuous-at 'RR-MS cab cat 'RR-MS (list d k) z)
                                                  (ass))))))))
                                   (#t
                                    ;; the derivative: d2(k) = d(k) near x, value d(k+1)(x)
                                    (let* ((x (dk-di-var!))
                                           (vx (list (list d sk) x)))
                                      (fact 'ooint-membership a t x)
                                      (dk-have! (list 'IN x oab)
                                        (lambda ()
                                          (mac 'ooint-membership)
                                          (dk-split-all! (dk-landed* (lambda () (mac-h 'ooint-membership (list 'IN x oat)))))
                                          (dk-conj-close!
                                            (lambda ()
                                              (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                  (dk-ineq! (list 'IN x 'RR) (list 'IN a 'RR) (list 'IN t 'RR) (list 'IN b 'RR)
                                                            (list '< a x) (list '< x t) (list '<= t b)))))))
                                      (let* ((dv (dk-apply! (dk-apply! hdv k) x))
                                             (rv (dk-skolem! (dk-fact! 'ooint-inner-radius a t x)))
                                             (oo (list 'OOINT (list '- x rv) (list '+ x rv))))
                                        (dk-split-all!)
                                        (fact 'rr-pos-rr-in-rr rv)
                                        (fact 'rr-sub-in-rr x rv)
                                        (fact 'rr-add-in-rr x rv)
                                        (fact 'restrict-in-fun rk cat 'RR oo)
                                        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ oo)
                                                    (list '== (list rk 'hbx_) (list (list d k) 'hbx_))))
                                          (lambda ()
                                            (let ((y (dk-di-var!)))
                                              (fact 'subset-mem-fwd oo cat y)
                                              (fact 'restrict-apply (list d k) cat y)
                                              (ass))))
                                        (fact 'has-deriv-at-local rv rk (list d k) x vx)
                                        (fact 'subset-mem-fwd oat cat x)
                                        (use-em (list '< sk n)
                                          (lambda ()
                                            (dk-each-leaf! (lambda () (if-true (ifk sk)))
                                              (lambda ()
                                                (if (dk-head-is? (dk-goal) '<) (ass)
                                                    (begin
                                                      (subst (list '= (ifk sk) (list 'RESTRICT (list d sk) cat)))
                                                      (subst (dk-fact! 'restrict-apply (list d sk) cat x))
                                                      (ass))))))
                                          (lambda ()
                                            (dk-each-leaf! (lambda () (if-false (ifk sk)))
                                              (lambda ()
                                                (if (dk-head-is? (dk-goal) 'NOT) (ass)
                                                    (begin
                                                      (subst (list '= (ifk sk) (list 'RESTRICT (list d sk) oat)))
                                                      (subst (dk-fact! 'restrict-apply (list d sk) oat x))
                                                      (ass))))))))))))))))))))
              ((dk-head-is? g '<=) (ass))
              (#t (ass))))))))
  ;; ---- 2.19 on [a, t]
  (let* ((xi (dk-skolem! (dk-fact! 'taylor-lagrange-on-interval a t d2 m)))
         (leq (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'taylor-rem) (dk-contains? fm xi))) (dk-asms)))
         (r (list 'recip (list 'FACTORIAL n)))
         (pp (list 'power (list '- t a) n))
         (a-in! (lambda ()
                  (dk-have! (list 'IN a cat)
                    (lambda () (mac 'ccint-membership)
                               (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                              (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list '< a t)))))))))
         (t-in! (lambda ()
                  (dk-have! (list 'IN t cat)
                    (lambda () (mac 'ccint-membership)
                               (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                              (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list '< a t))))))))))
    (a-in!) (t-in!) (in-cab! a) (in-cab! t)
    (fact 'subset-mem-fwd oat cab xi)
    (fact 'nn-le-refl n)
    (ty-at! n)
    (fact 'fun-apply-type-c (list d n) cab 'RR xi)
    ;; d2(n)(xi) = d(n)(xi)
    (dk-have! (list '= (list (list d2 n) xi) (list (list d n) xi))
      (lambda ()
        (dk-lam-b!)
        (tcl-real! n) (fact 'rr-lt-irrefl n)
        (dk-each-leaf! (lambda () (if-false (ifk n)))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'NOT) (ass)
                (begin
                  (subst (list '= (ifk n) (list 'RESTRICT (list d n) oat)))
                  (subst (dk-fact! 'restrict-apply (list d n) oat xi))
                  (rfl)))))))
    ;; the remainders agree
    (dk-have! (list '= (list 'TAYLOR-REM d n a t) (list 'TAYLOR-REM d2 n a t))
      (lambda ()
        (mac 'TAYLOR-REM) (mac 'TAYLOR-SUM) (mac 'TAYLOR-TERM)
        (dk-have! (list '< 0 n) (lambda () (dk-ineq! (list 'IN n 'RR) (list '<= 1 n))))
        (tcl-nat! 0)
        (fact 'nn-zero-le n)
        (ty-at! 0)
        (fact 'fun-apply-type-c (list d 0) cab 'RR t)
        (dk-have! (list '= (list (list d2 0) t) (list (list d 0) t))
          (lambda ()
            (dk-lam-b!)
            (dk-each-leaf! (lambda () (if-true (ifk 0)))
              (lambda ()
                (if (dk-head-is? (dk-goal) '<) (ass)
                    (begin
                      (subst (list '= (ifk 0) (list 'RESTRICT (list d 0) cat)))
                      (subst (dk-fact! 'restrict-apply (list d 0) cat t))
                      (rfl)))))))
        (subst (list '= (list (list d2 0) t) (list (list d 0) t)))
        (let* ((term (lambda (dd) (list 'VNB-LAMBDA 'tk_ 'NN
                                       (list '* (list '* (list (list dd 'tk_) a) (list 'power (list '- t a) 'tk_))
                                                (list 'recip (list 'FACTORIAL 'tk_))))))
               (u (term d)) (u2 (term d2))
               (hty2 (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
                        (list 'IN (list u 'tck_) 'RR)))))
               (heq2 (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
                        (list '= (list u2 'tck_) (list u 'tck_)))))))
          (dk-have! hty2
            (lambda ()
              (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                (tcl-real! k)
                (dk-have! (list '<= k n) (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list '< k n))))
                (ty-at! k)
                (fact 'fun-apply-type-c (list d k) cab 'RR a)
                (dk-lam-b!)
                (tcl-real! (cadr (dk-goal)))
                (ass))))
          (dk-have! heq2
            (lambda ()
              (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                (tcl-real! k)
                (dk-have! (list '<= k n) (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list '< k n))))
                (ty-at! k)
                (fact 'fun-apply-type-c (list d k) cab 'RR a)
                (dk-lam-b!)
                (dk-each-leaf! (lambda () (if-true (ifk k)))
                  (lambda ()
                    (if (dk-head-is? (dk-goal) '<) (ass)
                        (begin
                          (subst (list '= (ifk k) (list 'RESTRICT (list d k) cat)))
                          (subst (dk-fact! 'restrict-apply (list d k) cat a))
                          (tcl-real! (caddr (dk-goal)))
                          (rfl))))))))
          (let ((es (dk-apply! (dk-fact! 'series-partial-sum-agree-below n u2 u))))
            (subst es)
            (fact 'series-partial-sum-in-rr-below n u)
            (tcl-real! (list '- (list (list d 0) t) (list 'SERIES-PARTIAL-SUM u n)))
            (rfl)))))
    (ew xi)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN) (ass)
            (begin
              (subst (list '= (list 'TAYLOR-REM d n a t) (list 'TAYLOR-REM d2 n a t)))
              (subst leq)
              (subst (list '= (list (list d2 n) xi) (list (list d n) xi)))
              (tcl-real! (caddr (dk-goal)))
              (rfl)))))))
(qed 'taylor-lagrange-subinterval)

;;; the Taylor sum at its own base point is f(a):  sum_{k <= j} f^(k)(a) (a - a)^k / k! = f(a)
(define (tcl-tterm d b tv)
  (list 'VNB-LAMBDA 'tk_ 'NN (list '* (list '* (list (list d 'tk_) tv) (list 'power (list '- b tv) 'tk_))
                                      (list 'recip (list 'FACTORIAL 'tk_)))))
(sp (make-wff (list 'FORALL 'tcj_ (list 'IMPLIES '(IN tcj_ NN) (list 'FORALL 'tcf_ (list 'FORALL 'a (list 'IMPLIES '(IN a RR)
   (list 'IMPLIES (tcl-guard-le 'tcj_ (lambda (k) (list 'IN (list (list 'tcf_ k) 'a) 'RR)))
     (list '= (list 'SERIES-PARTIAL-SUM (tcl-tterm 'tcf_ 'a 'a) '(succ tcj_)) '((tcf_ 0) a))))))))))
(define tcl-tb-br (use-induction))
(define tcl-tb-j  (cdr (assq 'var tcl-tb-br)))
(define tcl-tb-ih (cdr (assq 'ih tcl-tb-br)))
(define (tcl-aa-zero! a)          ; lands (= (- a a) 0)
  (tcl-real! a)
  (dk-have! (list '= (list '- a a) 0) (lambda () (tcl-crs!))))
(dk-focus! (cdr (assq 'base tcl-tb-br)))
(let* ((lnd (dk-peel!))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (g0 (dk-goal)) (d0a (caddr g0)) (d (car (car d0a))) (a (cadr d0a))
       (u (tcl-tterm d a a)))
  (tcl-nat! 0)
  (fact 'nn-le-refl 0)
  (dk-apply! hyp 0)
  (let ((z (dk-fact! 'series-partial-sum-zero u)))
    (dk-have! (list 'IN (list 'SERIES-PARTIAL-SUM u 0) 'RR) (lambda () (subst z) (tcl-real! 0) (ass)))
    (tcl-aa-zero! a)
    (dk-have! (list 'IN (list u 0) 'RR) (lambda () (dk-lam-b!) (tcl-real! (cadr (dk-goal))) (ass)))
    (subst (dk-fact! 'series-partial-sum-succ u 0))
    (subst z))
  (dk-lam-b!)
  (subst (list '= (list '- a a) 0))
  (fact 'rr-subset-cc 0)
  (subst (dk-fact! 'power-zero 0))
  (fact 'factorial-zero)
  (subst '(= (factorial 0) (succ 0)))
  (fact 'nn-one-is-succ-zero)
  (subst '(= (succ 0) 1))
  (subst (dk-fact! 'rr-recip-one))
  (tcl-crs!))
(dk-focus! (cdr (assq 'step tcl-tb-br)))
(let* ((j tcl-tb-j) (sj (list 'succ j))
       (lnd (dk-peel!))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (g0 (dk-goal)) (d0a (caddr g0)) (d (car (car d0a))) (a (cadr d0a))
       (u (tcl-tterm d a a)))
  (tcl-nat! sj)
  (fact 'nn-le-succ j)
  (dk-have! (tcl-guard-le j (lambda (k) (list 'IN (list (list d k) a) 'RR)))
    (lambda ()
      (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<=) l2))))
        (fact 'nn-le-trans-guarded k j sj)
        (dk-apply! hyp k)
        (ass))))
  (let ((e (dk-apply! tcl-tb-ih d a)))
    (dk-have! (list 'IN (list 'SERIES-PARTIAL-SUM u sj) 'RR)
      (lambda () (subst e) (fact 'nn-zero-le sj) (tcl-nat! 0) (dk-apply! hyp 0) (ass)))
    (fact 'nn-le-refl sj)
    (dk-apply! hyp sj)
    (tcl-aa-zero! a)
    (dk-have! (list 'IN (list u sj) 'RR) (lambda () (dk-lam-b!) (tcl-real! (cadr (dk-goal))) (ass)))
    (subst (dk-fact! 'series-partial-sum-succ u sj))
    (subst e)
    (dk-lam-b!)
    (subst (list '= (list '- a a) 0))
    (subst (dk-fact! 'power-zero-base j))
    (fact 'nn-zero-le sj) (tcl-nat! 0) (dk-apply! hyp 0)
    (tcl-crs!)))
(qed 'taylor-sum-at-base)

;;; (9b) the remainder factor at t > a is a value of f^(n) in (a, t)
(sp (make-wff
  (let ((h (tcl-h21 'tcf_ '(succ tcm_) 'a 'b)))
    (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
      (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
        (list 'IMPLIES (car h) (list 'IMPLIES (cadr h) (list 'IMPLIES (caddr h)
          (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ RR) (list 'IMPLIES '(< a tct_) (list 'IMPLIES '(<= tct_ b)
            (list 'FORSOME 'tcxi_ (list 'AND '(IN tcxi_ (OOINT a tct_))
              '(= (* (* (TAYLOR-REM tcf_ (succ tcm_) a tct_) (FACTORIAL (succ tcm_))) (recip (power (- tct_ a) (succ tcm_))))
                  ((tcf_ (succ tcm_)) tcxi_)))))))))))))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (rem (cadr (cadr (cadr (caddr (caddr g0))))))
       (d (cadr rem)) (n (caddr rem)) (m (cadr n)) (a (cadddr rem)) (t (car (cddddr rem)))
       (b (caddr (tcl-first (lambda (fm) (and (dk-head-is? fm '<=) (eq? (cadr fm) t))) lnd)))
       (xi (dk-skolem! (dk-apply! (dk-fact! 'taylor-lagrange-subinterval a b d m) t)))
       (leq (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'taylor-rem) (dk-contains? fm xi))) (dk-asms)))
       (dd (list (list d n) xi))
       (ff (list 'FACTORIAL n)) (r (list 'recip ff))
       (pp (list 'power (list '- t a) n)))
  (tcl-nat! n)
  ;; xi in [a, b], so f^(n)(xi) is real
  (fact 'ooint-membership a t xi)
  (dk-have! (list 'IN xi (list 'CCINT a b))
    (lambda ()
      (dk-split-all! (dk-landed* (lambda () (mac-h 'ooint-membership (list 'IN xi (list 'OOINT a t))))))
      (mac 'ccint-membership)
      (dk-conj-close!
        (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                       (dk-ineq! (list 'IN xi 'RR) (list 'IN a 'RR) (list 'IN t 'RR) (list 'IN b 'RR)
                                 (list '< a xi) (list '< xi t) (list '<= t b)))))))
  (fact 'nn-le-refl n)
  (dk-apply! (tcl-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FUN))) lnd) n)
  (fact 'fun-apply-type-c (list d n) (list 'CCINT a b) 'RR xi)
  ;; (t - a)^n is a nonzero real
  (tcl-real! (list '- t a))
  (dk-have! (list '< 0 (list '- t a)) (lambda () (dk-ineq! (list 'IN t 'RR) (list 'IN a 'RR) (list '< a t))))
  (fact 'rr-power-pos (list '- t a) n)
  (tcl-real! pp)
  (fact 'rr-pos-ne-zero pp)
  (dk-have! (list 'AND (list 'IN pp 'RR) (list 'NOT (list '= pp 0))))
  (fact 'rr-recip-closed pp)
  (fact 'rr-recip-inverse pp)
  (fact 'rr-recip-factorial n)
  (tcl-real! ff) (tcl-real! r)
  (ew xi)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN) (ass)
          (let ((lhs (list '* (list '* (list '* (list '* dd r) pp) ff) (list 'recip pp)))
                (unit (list '* dd (list '* (list '* ff r) (list '* pp (list 'recip pp))))))
            (subst leq)
            (dk-have! (list '= lhs unit) (lambda () (tcl-crs!)))
            (subst (list '= lhs unit))
            (subst (list '= (list '* ff r) 1))
            (subst (list '= (list '* pp (list 'recip pp)) 1))
            (tcl-crs!))))))
(qed 'taylor-factor-value)

;;; (9c) the Taylor sum is continuous in its end point (a polynomial in s - a)
(define (tcl-if-type-closer! cond-form val-form pre)   ; goal (IN (IF c v 0) RR); PRE runs on the c branch
  (use-em cond-form
    (lambda ()
      (pre)
      (dk-each-leaf! (lambda () (if-true (list 'IF cond-form val-form 0)))
        (lambda ()
          (if (alpha-equiv? (dk-goal) cond-form) (ass)
              (begin (subst (list '= (list 'IF cond-form val-form 0) val-form))
                     (tcl-real! val-form) (ass))))))
    (lambda ()
      (dk-each-leaf! (lambda () (if-false (list 'IF cond-form val-form 0)))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'NOT) (ass)
              (begin (subst (list '= (list 'IF cond-form val-form 0) 0))
                     (tcl-real! 0) (ass))))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
   (list 'IMPLIES (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES '(< tck_ (succ tcm_)) '(IN ((tcf_ tck_) a) RR))))
     (list 'FORALL 'tcp_ (list 'IMPLIES '(IN tcp_ RR)
       '(IS-CONTINUOUS-AT RR-MS RR-MS (VNB-LAMBDA tcs_ RR (TAYLOR-SUM tcf_ (succ tcm_) tcs_ a)) tcp_)))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (tlam (cadddr g0)) (p (car (cddddr g0)))
       (ts (cadddr tlam))
       (d (cadr ts)) (n (caddr ts)) (m (cadr n)) (a (car (cddddr ts)))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (val (lambda (i) (list '* (list (list d i) a) (list 'recip (list 'FACTORIAL i)))))
       (ifc (lambda (i) (list 'IF (list '< i n) (val i) 0)))
       (c (tcl-skolem-fn! ifc
            (lambda (i) (tcl-have! (list 'IN (ifc i) 'RR)
                          (lambda () (tcl-if-type-closer! (list '< i n) (val i) (lambda () (dk-apply! hyp i))))))))
       (cval (tcl-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm c))) (dk-asms)))
       (pp (tcl-p c m))
       (c0 (list '- 0 a))
       (aff (list 'VNB-LAMBDA 'x 'RR (list '+ c0 (list '* 1 'x))))
       (cps (list 'COMPOSE pp aff)))
  (tcl-nat! n)
  (tcl-real! c0) (tcl-real! 1) (tcl-real! p)
  (dk-have! (list 'AND (list 'IN c0 'RR) (list 'AND '(IN 1 RR) (list 'IN p 'RR))))
  (fact 'affine-continuous-at c0 1 p)
  (dk-have! (list 'IN aff '(FUN RR RR)) (lambda () (tcl-lam-type! tcl-body-real!)))
  (fact 'fun-apply-type-c aff 'RR 'RR p)
  (fact 'poly-lam-in-fun c n)
  (let* ((ap (list aff p))
         (uv (list 'VNB-LAMBDA 'j 'NN (list '* (list '* '(succ j) (list c '(succ j))) (list 'power ap 'j))))
         (vv (list 'SERIES-PARTIAL-SUM uv m)))
    (tcl-sps-real! uv m (lambda (i) (tcl-nat! (list 'succ i)) (fact 'fun-apply-type-c c 'NN 'RR (list 'succ i))))
    (fact 'deriv-polynomial m c ap)
    (fact 'diff-implies-continuous pp ap vv))
  (fact 'compose-continuous-at pp aff p)
  (fact 'rr-is-set)
  (dk-have! (list 'AND (list 'IN aff '(FUN RR RR)) (list 'IN pp '(FUN RR RR))))
  (fact 'compose-type 'RR 'RR 'RR pp aff)
  (let ((capply (dk-fact! 'compose-apply 'RR 'RR 'RR pp aff))
        (tt (lambda (x) (tcl-tterm d x a)))
        (ww (lambda (x) (list 'VNB-LAMBDA 'k 'NN (list '* (list c 'k) (list 'power (list '- x a) 'k))))))
    (dk-have! (list 'IN tlam '(FUN RR RR))
      (lambda ()
        (tcl-lam-type!
          (lambda (v)
            (mac 'TAYLOR-SUM) (mac 'TAYLOR-TERM)
            (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n) (list 'IN (list (tt v) 'tck_) 'RR))))
              (lambda () (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                           (dk-apply! hyp k)
                           (dk-lam-b!)
                           (tcl-real! (cadr (dk-goal)))
                           (ass))))
            (fact 'series-partial-sum-in-rr-below n (tt v))
            (ass)))))
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-have! (list 'FORALL 'tcx_ (list 'IMPLIES '(IN tcx_ RR) (list 'IMPLIES (list '<= (list 'ABS (list '- 'tcx_ p)) 1)
                (list '= (list tlam 'tcx_) (list cps 'tcx_)))))
      (lambda ()
        (let* ((l2 (dk-peel!)) (x (cadr (tcl-first (dk-head? 'IN) l2))))
          (subst (dk-apply! capply x))
          (fact 'fun-apply-type-c aff 'RR 'RR x)
          (tcl-real! x)
          (tcl-real! (list '+ c0 (list '* 1 x)))
          (dk-lam-b!)
          (dk-have! (list '= (list '+ c0 (list '* 1 x)) (list '- x a)) (lambda () (tcl-crs!)))
          (subst (list '= (list '+ c0 (list '* 1 x)) (list '- x a)))
          (mac 'TAYLOR-SUM) (mac 'TAYLOR-TERM)
          (let ((hty2 (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n) (list 'IN (list (ww x) 'tck_) 'RR)))))
                (heq2 (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n)
                            (list '= (list (tt x) 'tck_) (list (ww x) 'tck_)))))))
            (dk-have! hty2
              (lambda () (let* ((l3 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l3))))
                           (fact 'fun-apply-type-c c 'NN 'RR k)
                           (dk-lam-b!) (tcl-real! (cadr (dk-goal))) (ass))))
            (dk-have! heq2
              (lambda () (let* ((l3 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l3))))
                           (dk-apply! hyp k)
                           (fact 'fun-apply-type-c c 'NN 'RR k)
                           (dk-lam-b!)
                           (subst (dk-apply! cval k))
                           (dk-each-leaf! (lambda () (if-true (ifc k)))
                             (lambda ()
                               (if (dk-head-is? (dk-goal) '<) (ass)
                                   (begin (subst (list '= (ifc k) (val k)))
                                          (tcl-crs!))))))))
            (subst (dk-apply! (dk-fact! 'series-partial-sum-agree-below n (tt x) (ww x))))
            (fact 'series-partial-sum-in-rr-below n (ww x))
            (rfl)))))
    (fact 'continuous-at-local tlam cps p 1)
    (ass)))
(qed 'taylor-sum-continuous)

;;; (9d) the quotient R_n(s) n! / (s - a)^n, built on the whole line (f through
;;; EXTEND-CONST, the reciprocal through RECIP-STAR), is continuous at s > a
(define (tcl-qfn d n a b)
  (list 'VNB-LAMBDA 'tcs_ 'RR
        (list '* (list '* (list '- (list (list 'EXTEND-CONST (list d 0) a b) 'tcs_) (list 'TAYLOR-SUM d n 'tcs_ a))
                          (list 'FACTORIAL n))
                 (list 'RECIP-STAR (list 'power (list '- 'tcs_ a) n)))))
;;; beta-reduce the hypothesis H and close the leaf by `ass' -- unless the reduction
;;; already closed it (the focus then sits on a sibling, and a bare `ass' drifts)
(define (tcl-lam-b-h-close! h)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b-h! h)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; the continuity universal of the Taylor sum, captured once per proof
(define tcl-tsc #f)
;;; land (IN F (FUN RR RR)) off (IS-CONTINUOUS-AT RR-MS RR-MS F P) in context
(define (tcl-cont-type! f p)
  (dk-have! (list 'IN f '(FUN RR RR))
    (lambda ()
      (dk-split-all! (dk-landed* (lambda () (mac-h 'is-continuous-at (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS f p)))))
      (let ((leaf (proof-state-focus *ps*)))
        (slot-h 'PTS (list 'IN f '(FUN (PTS RR-MS) (PTS RR-MS))))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
   (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
     (list 'IMPLIES '(<= a b) (list 'IMPLIES '(IS-CONTINUOUS-ON (tcf_ 0) (CCINT a b))
       (list 'IMPLIES (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES '(< tck_ (succ tcm_)) '(IN ((tcf_ tck_) a) RR))))
         (list 'FORALL 'tcp_ (list 'IMPLIES '(IN tcp_ RR) (list 'IMPLIES '(< a tcp_)
           (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (tcl-qfn 'tcf_ '(succ tcm_) 'a 'b) 'tcp_))))))))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (qf (cadddr g0)) (p (car (cddddr g0)))
       (e0 (car (cadr (cadr (cadr (cadddr qf))))))      ; (EXTEND-CONST (d 0) a b)
       (d (car (cadr e0))) (a (caddr e0)) (b (cadddr e0))
       (ts (caddr (cadr (cadr (cadddr qf)))))            ; (TAYLOR-SUM d n tcs_ a)
       (n (caddr ts)) (m (cadr n))
       (hyp (tcl-first (dk-head? 'FORALL) lnd))
       (tlam (list 'VNB-LAMBDA 'tcs_ 'RR (list 'TAYLOR-SUM d n 'tcs_ a)))
       (l1 (list 'VNB-LAMBDA 'x 'RR (list '- (list e0 'x) (list tlam 'x))))
       (ff (list 'FACTORIAL n))
       (l2 (list 'VNB-LAMBDA 'x 'RR (list '* ff (list l1 'x))))
       (powfn (list 'VNB-LAMBDA 'x 'RR (list 'power 'x n)))
       (c0 (list '- 0 a))
       (aff (list 'VNB-LAMBDA 'x 'RR (list '+ c0 (list '* 1 'x))))
       (pw (list 'COMPOSE powfn aff))
       (rs '(VNB-LAMBDA z_ RR (RECIP-STAR z_)))
       (l3 (list 'COMPOSE rs pw))
       (l4 (list 'VNB-LAMBDA 'x 'RR (list '* (list l2 'x) (list l3 'x)))))
  (tcl-nat! n) (tcl-real! p) (tcl-real! c0) (tcl-real! 1)
  ;; E0 and the Taylor sum are continuous at p
  (fact 'extend-const-continuous-at a b (list d 0) p)
  (set! tcl-tsc (dk-fact! 'taylor-sum-continuous a d m))
  (dk-apply! tcl-tsc p)
  (fact 'sub-continuous-at e0 tlam p)
  (tcl-real! ff)
  (fact 'scale-continuous-at ff l1 p)
  ;; (s - a)^n, as x^n after s |-> 0 - a + 1 s
  (dk-have! (list 'AND (list 'IN c0 'RR) (list 'AND '(IN 1 RR) (list 'IN p 'RR))))
  (fact 'affine-continuous-at c0 1 p)
  (tcl-cont-type! aff p)
  (fact 'fun-apply-type-c aff 'RR 'RR p)
  (fact 'deriv-power m (list aff p))
  (tcl-real! (list '* (list 'succ m) (list 'power (list aff p) m)))
  (fact 'diff-implies-continuous powfn (list aff p) (list '* (list 'succ m) (list 'power (list aff p) m)))
  (fact 'compose-continuous-at powfn aff p)
  ;; its value at p is (p - a)^n > 0
  (tcl-cont-type! powfn (list aff p))
  (fact 'rr-is-set)
  (dk-have! (list 'AND (list 'IN aff '(FUN RR RR)) (list 'IN powfn '(FUN RR RR))))
  (fact 'compose-type 'RR 'RR 'RR powfn aff)
  (let* ((capw (dk-fact! 'compose-apply 'RR 'RR 'RR powfn aff))
         (pwp (list pw p))
         (pa (list '- p a)))
    (fact 'fun-apply-type-c pw 'RR 'RR p)
    (tcl-real! pa)
    (dk-have! (list '= pwp (list 'power pa n))
      (lambda ()
        (subst (dk-apply! capw p))
        (tcl-real! (list '+ c0 (list '* 1 p)))
        (dk-lam-b!)
        (dk-have! (list '= (list '+ c0 (list '* 1 p)) pa) (lambda () (tcl-crs!)))
        (subst (list '= (list '+ c0 (list '* 1 p)) pa))
        (tcl-real! (list 'power pa n))
        (rfl)))
    (dk-have! (list '< 0 pa) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN p 'RR) (list '< a p))))
    (fact 'rr-power-pos pa n)
    (dk-have! (list 'NOT (list '= pwp 0))
      (lambda () (subst (list '= pwp (list 'power pa n)))
                 (tcl-real! (list 'power pa n))
                 (fact 'rr-pos-ne-zero (list 'power pa n))
                 (ass)))
    (fact 'recip-star-continuous-at pwp)
    (fact 'compose-continuous-at rs pw p)
    (fact 'product-continuous-at l2 l3 p)
    ;; transfer to the quotient, which agrees with the product everywhere
    (tcl-cont-type! pw p)
    (fact 'recip-star-lam-in-fun)
    (dk-have! (list 'AND (list 'IN pw '(FUN RR RR)) (list 'IN rs '(FUN RR RR))))
    (fact 'compose-type 'RR 'RR 'RR rs pw)
    (let ((cars (dk-fact! 'compose-apply 'RR 'RR 'RR rs pw))
          (dcf (dk-apply! (dk-fact! 'cont-on-in-fun (list d 0) (list 'CCINT a b)))))
      (fact 'extend-const-in-fun a b (list d 0))
      (tcl-cont-type! l4 p)
      (dk-have! (list 'IN qf '(FUN RR RR))
        (lambda ()
          (tcl-lam-type!
            (lambda (v)
              (fact 'fun-apply-type-c e0 'RR 'RR v)
              (dk-apply! tcl-tsc v)
              (tcl-cont-type! tlam v)
              (fact 'fun-apply-type-c tlam 'RR 'RR v)
              (dk-have! (list 'IN (list 'TAYLOR-SUM d n v a) 'RR)
                (lambda () (tcl-lam-b-h-close! (list 'IN (list tlam v) 'RR))))
              (tcl-real! (list 'power (list '- v a) n))
              (fact 'recip-star-in-rr (list 'power (list '- v a) n))
              (tcl-real! (cadr (dk-goal)))
              (ass)))))
      (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
      (dk-have! (list 'FORALL 'tcx_ (list 'IMPLIES '(IN tcx_ RR) (list 'IMPLIES (list '<= (list 'ABS (list '- 'tcx_ p)) 1)
                  (list '= (list qf 'tcx_) (list l4 'tcx_)))))
        (lambda ()
          (let* ((l2v (dk-peel!)) (x (cadr (tcl-first (dk-head? 'IN) l2v))))
            (tcl-real! x)
            (fact 'fun-apply-type-c aff 'RR 'RR x)
            (tcl-real! (list '+ c0 (list '* 1 x)))
            (fact 'fun-apply-type-c pw 'RR 'RR x)
            (dk-lam-b!)
            (subst (dk-apply! cars x))
            (dk-lam-b!)
            (subst (dk-apply! capw x))
            (dk-lam-b!)
            (dk-have! (list '= (list '+ c0 (list '* 1 x)) (list '- x a)) (lambda () (tcl-crs!)))
            (subst (list '= (list '+ c0 (list '* 1 x)) (list '- x a)))
            (fact 'fun-apply-type-c e0 'RR 'RR x)
            (dk-apply! tcl-tsc x)
            (tcl-cont-type! tlam x)
            (fact 'fun-apply-type-c tlam 'RR 'RR x)
            (dk-have! (list 'IN (list 'TAYLOR-SUM d n x a) 'RR)
              (lambda () (tcl-lam-b-h-close! (list 'IN (list tlam x) 'RR))))
            (tcl-real! (list 'power (list '- x a) n))
            (fact 'recip-star-in-rr (list 'power (list '- x a) n))
            (tcl-crs!))))
      (fact 'continuous-at-local qf l4 p 1)
      (ass))))
(qed 'taylor-factor-fn-continuous)

;;; xi in (a, t), t <= b: land xi in [a, b] and d(n)(xi) in RR (HTY the family typing hypothesis)
(define (tcl-xi-type! d n xi a t b hty)
  (tcl-nat! n)
  (fact 'ooint-membership a t xi)
  (dk-have! (list 'IN xi (list 'CCINT a b))
    (lambda ()
      (dk-split-all! (dk-landed* (lambda () (mac-h 'ooint-membership (list 'IN xi (list 'OOINT a t))))))
      (mac 'ccint-membership)
      (dk-conj-close!
        (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                       (dk-ineq! (list 'IN xi 'RR) (list 'IN a 'RR) (list 'IN t 'RR) (list 'IN b 'RR)
                                 (list '< a xi) (list '< xi t) (list '<= t b)))))))
  (fact 'nn-le-refl n)
  (dk-have! (list 'IN (list d n) (list 'FUN (list 'CCINT a b) 'RR)) (lambda () (dk-apply! hty n) (ass)))
  (fact 'fun-apply-type-c (list d n) (list 'CCINT a b) 'RR xi))

;;; (9e) at t in (a, b] the quotient IS the factor: a value of f^(n) in (a, t)
(sp (make-wff
  (let ((h (tcl-h21 'tcf_ '(succ tcm_) 'a 'b)))
    (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
      (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
        (list 'IMPLIES (car h) (list 'IMPLIES (cadr h) (list 'IMPLIES (caddr h)
          (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ RR) (list 'IMPLIES '(< a tct_) (list 'IMPLIES '(<= tct_ b)
            (list 'FORSOME 'tcxi_ (list 'AND '(IN tcxi_ (OOINT a tct_))
              (list '= (list (tcl-qfn 'tcf_ '(succ tcm_) 'a 'b) 'tct_) '((tcf_ (succ tcm_)) tcxi_)))))))))))))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (eqn (caddr (caddr g0)))
       (qf (car (cadr eqn))) (t (cadr (cadr eqn)))
       (e0 (car (cadr (cadr (cadr (cadddr qf))))))
       (d (car (cadr e0))) (a (caddr e0)) (b (cadddr e0))
       (n (caddr (caddr (cadr (cadr (cadddr qf)))))) (m (cadr n))
       (xi (dk-skolem! (dk-apply! (dk-fact! 'taylor-factor-value a b d m) t)))
       (veq (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'taylor-rem) (dk-contains? fm xi))) (dk-asms)))
       (pp (list 'power (list '- t a) n)))
  (tcl-nat! n) (tcl-real! t) (tcl-real! (list '- t a))
  (dk-have! (list '<= a t) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list '< a t))))
  (dk-have! (list '< 0 (list '- t a)) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list '< a t))))
  (fact 'rr-power-pos (list '- t a) n)
  (tcl-real! pp)
  (fact 'rr-pos-ne-zero pp)
  (ew xi)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN) (ass)
          (begin
            (dk-lam-b!)
            (tcl-nat! 0) (fact 'nn-zero-le n)
            (dk-have! (list 'IN (list d 0) (list 'FUN (list 'CCINT a b) 'RR))
              (lambda () (dk-apply! (tcl-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FUN))) lnd) 0) (ass)))
            (subst (dk-fact! 'extend-const-fixes a b t (list d 0)))
            (subst (dk-fact! 'recip-star-value pp))
            (dk-have! (list '== (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a)) (list 'TAYLOR-REM d n a t))
              (lambda () (mac 'TAYLOR-REM) (qrfl)))
            (subst (list '== (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a)) (list 'TAYLOR-REM d n a t)))
            (subst veq)
            (tcl-xi-type! d n xi a t b (tcl-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FUN))) lnd))
            (rfl))))))
(qed 'taylor-factor-fn-value)

;;; (9f) the factor glued at a:  s |-> f^(n)(a) for s <= a, the quotient for s > a;
;;; continuous at every real.  At s = a by the Lagrange points of (9e) and the
;;; continuity of f^(n) at a (through EXTEND-CONST); elsewhere locally.
(define (tcl-stfn d n a b)
  (list 'VNB-LAMBDA 'tcs_ 'RR (list 'IF (list '<= 'tcs_ a) (list (list d n) a) (cadddr (tcl-qfn d n a b)))))
(sp (make-wff
  (let ((h (tcl-h21 'tcf_ '(succ tcm_) 'a 'b)))
    (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
      (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
        (list 'IMPLIES '(< a b) (list 'IMPLIES (car h) (list 'IMPLIES (cadr h) (list 'IMPLIES (caddr h)
          (list 'IMPLIES '(IS-CONTINUOUS-ON (tcf_ (succ tcm_)) (CCINT a b))
            (list 'FORALL 'tcp_ (list 'IMPLIES '(IN tcp_ RR)
              (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (tcl-stfn 'tcf_ '(succ tcm_) 'a 'b) 'tcp_))))))))))))))))))
(let* ((lnd (dk-peel!))
       (g0 (dk-goal))
       (st (cadddr g0)) (p (car (cddddr g0)))
       (cn (tcl-first (dk-head? 'IS-CONTINUOUS-ON) lnd))
       (dn (cadr cn)) (d (car dn)) (n (cadr dn)) (m (cadr n))
       (a (cadr (caddr cn))) (b (caddr (caddr cn)))
       (hs (filter (dk-head? 'FORALL) lnd))
       (hty (tcl-first (lambda (h) (dk-contains? h 'FUN)) hs))
       (hco (tcl-first (lambda (h) (dk-contains? h 'IS-CONTINUOUS-ON)) hs))
       (qf (tcl-qfn d n a b))
       (qb (lambda (v) (tcl-replace (cadddr qf) 'tcs_ v)))
       (dna (list dn a))
       (ifs (lambda (v) (list 'IF (list '<= v a) dna (qb v))))
       (cab (list 'CCINT a b)))
  (tcl-nat! n) (tcl-real! n) (tcl-real! a) (tcl-real! b) (tcl-real! p)
  (dk-have! (list '<= a b) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '< a b))))
  (dk-have! (list '<= a a) (lambda () (dk-ineq! (list 'IN a 'RR))))
  (dk-have! (list 'IN a cab) (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (ass)))))
  (fact 'nn-le-refl n)
  (dk-have! (list 'IN dn (list 'FUN cab 'RR)) (lambda () (dk-apply! hty n) (ass)))
  (fact 'fun-apply-type-c dn cab 'RR a)
  ;; the hypotheses of (9d)
  (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n) (list 'IN (list (list d 'tck_) a) 'RR))))
    (lambda () (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                 (tcl-real! k)
                 (dk-have! (list '<= k n) (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list '< k n))))
                 (dk-apply! hty k)
                 (fact 'fun-apply-type-c (list d k) cab 'RR a)
                 (ass))))
  (tcl-nat! 0)
  (dk-have! (list '< 0 n) (lambda () (fact 'nn-one-le-succ m) (dk-ineq! (list 'IN n 'RR) (list '<= 1 n))))
  (dk-apply! hco 0)
  (let* ((qfc (dk-fact! 'taylor-factor-fn-continuous a b d m))
         (fvx (dk-fact! 'taylor-factor-fn-value a b d m)))
    (dk-apply! qfc b)
    (tcl-cont-type! qf b)
    ;; st is a function RR -> RR
    (dk-have! (list 'IN st '(FUN RR RR))
      (lambda ()
        (tcl-lam-type!
          (lambda (v)
            (use-em (list '<= v a)
              (lambda ()
                (dk-each-leaf! (lambda () (if-true (ifs v)))
                  (lambda () (if (dk-head-is? (dk-goal) '<=) (ass)
                                 (begin (subst (list '= (ifs v) dna)) (ass))))))
              (lambda ()
                (dk-each-leaf! (lambda () (if-false (ifs v)))
                  (lambda () (if (dk-head-is? (dk-goal) 'NOT) (ass)
                                 (begin (subst (list '= (ifs v) (qb v)))
                                        (fact 'fun-apply-type-c qf 'RR 'RR v)
                                        (tcl-lam-b-h-close! (list 'IN (list qf v) 'RR))))))))))))
    (let ((st-at-le! (lambda (v)      ; v <= a in context: land (= (st v) dna)
                       (dk-have! (list '= (list st v) dna)
                         (lambda ()
                           (dk-lam-b!)
                           (dk-each-leaf! (lambda () (if-true (ifs v)))
                             (lambda () (if (dk-head-is? (dk-goal) '<=) (ass)
                                            (begin (subst (list '= (ifs v) dna)) (rfl)))))))))
          (st-at-gt! (lambda (v)      ; a < v in context: land (= (st v) (qf v))
                       (fact 'rr-lt-not-le a v)
                       (fact 'fun-apply-type-c qf 'RR 'RR v)
                       (tcl-have! (list '= (list st v) (list qf v))
                         (lambda ()
                           (dk-lam-b-h! (list 'IN (list qf v) 'RR))
                           (dk-lam-b!)
                           (dk-each-leaf! (lambda () (if-false (ifs v)))
                             (lambda () (if (dk-head-is? (dk-goal) 'NOT) (ass)
                                            (begin (subst (list '= (ifs v) (qb v))) (rfl))))))))))
      (let ((tri (dk-fact! 'rr-lt-trichotomy p a)))
        (use-cases tri
          ;; ---- p < a: st is the constant f^(n)(a) near p
          (lambda ()
            (let ((cst (list 'VNB-LAMBDA 'x 'RR dna)))
              (fact 'const-continuous-at dna p)
              (dk-have! (list 'IN cst '(FUN RR RR)) (lambda () (tcl-lam-type! (lambda (v) (ass)))))
              (tcl-real! (list '- a p))
              (dk-have! (list '< 0 (list '- a p)) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN p 'RR) (list '< p a))))
              (dk-have! (list 'FORALL 'tcx_ (list 'IMPLIES '(IN tcx_ RR) (list 'IMPLIES (list '<= (list 'ABS (list '- 'tcx_ p)) (list '- a p))
                          (list '= (list st 'tcx_) (list cst 'tcx_)))))
                (lambda ()
                  (let* ((l2 (dk-peel!)) (x (cadr (tcl-first (dk-head? 'IN) l2))))
                    (tcl-real! (list '- x p))
                    (dk-split! (dk-fact! 'rr-abs-le-parts (list '- x p) (list '- a p)))
                    (dk-have! (list '<= x a) (lambda () (dk-ineq! (list 'IN x 'RR) (list 'IN a 'RR) (list 'IN p 'RR)
                                                                  (list '<= (list '- x p) (list '- a p)))))
                    (st-at-le! x)
                    (subst (list '= (list st x) dna))
                    (dk-lam-b!)
                    (rfl))))
              (fact 'continuous-at-local st cst p (list '- a p))
              (ass)))
          ;; ---- p = a: epsilon-delta
          (lambda ()
            (subst (list '= p a))
            (let* ((tcen (list 'EXTEND-CONST dn a b))
                   (cen (begin (fact 'extend-const-continuous-at a b dn a)
                               (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS tcen a))))
              (fact 'extend-const-in-fun a b dn)
              (dk-split-all! (dk-landed* (lambda () (mac-h 'is-continuous-at cen))))
              (let ((eu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'POS-RR) (dk-contains? fm tcen)))
                                 "the eps-universal of f^(n) at a")))
                (mac 'is-continuous-at)
                (dk-conj-close!
                  (lambda ()
                    (let ((gl (dk-goal)))
                      (cond
                        ((dk-head-is? gl 'IS-METRIC-SPACE) (fact 'rr-is-metric-space) (ass))
                        ((and (dk-head-is? gl 'IN) (dk-contains? gl 'PTS)) (slot 'PTS) (ass))
                        (#t
                         (let* ((l2 (dk-peel!))
                                (e (cadr (tcl-first (dk-head? 'POS-RR) l2)))
                                (d0 (dk-skolem! (dk-apply! eu e)))
                                (du (tcl-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm d0))) (dk-asms))))
                           (fact 'rr-pos-rr-in-rr d0) (fact 'rr-lt-of-pos-rr d0)
                           (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
                           (tcl-real! (list '- b a))
                           (dk-have! (list '< 0 (list '- b a)) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '< a b))))
                           (let ((w (dk-skolem! (dk-fact! 'rr-min-pos d0 (list '- b a)))))
                             (dk-split-all!)
                             (fact 'rr-pos-rr-of-lt w)
                             (ew w)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-head-is? (dk-goal) 'POS-RR) (ass)
                                     (let* ((l3 (dk-peel!))
                                            (ymem (tcl-first (dk-head? 'IN) l3)) (y (cadr ymem))
                                            (dist (tcl-first (dk-head? '<=) l3)))
                                       (dk-have! (list 'IN y 'RR) (lambda () (slot-h 'PTS ymem) (ass)))
                                       (dk-have! (list '<= (list 'ABS (list '- a y)) w) (lambda () (mac-h 'rr-ms-dist dist) (ass)))
                                       (fact 'fun-apply-type-c st 'RR 'RR a)
                                       (fact 'fun-apply-type-c st 'RR 'RR y)
                                       (mac 'rr-ms-dist)
                                       (st-at-le! a)
                                       (subst (list '= (list st a) dna))
                                       (use-em (list '<= y a)
                                         (lambda ()
                                           (st-at-le! y)
                                           (subst (list '= (list st y) dna))
                                           (dk-have! (list '= (list '- dna dna) 0) (lambda () (tcl-crs!)))
                                           (subst (list '= (list '- dna dna) 0))
                                           (subst (dk-fact! 'rr-abs-zero-value))
                                           (dk-ineq! (list 'IN e 'RR) (list '< 0 e)))
                                         (lambda ()
                                           (let ((nle (tcl-first (lambda (fm) (equal? fm (list 'NOT (list '<= y a)))) (dk-asms))))
                                             (fact 'rr-not-le-lt y a))
                                           (tcl-real! (list '- a y))
                                           (dk-split! (dk-fact! 'rr-abs-le-parts (list '- a y) w))
                                           (dk-have! (list '<= y b)
                                             (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN y 'RR) (list 'IN w 'RR)
                                                                  (list '<= (list '- w) (list '- a y)) (list '<= w (list '- b a)))))
                                           (let* ((xi (dk-skolem! (dk-apply! fvx y)))
                                                  (dxi (list dn xi)))
                                             (st-at-gt! y)
                                             (subst (list '= (list st y) (list qf y)))
                                             (subst (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list qf y)))) (dk-asms)))
                                             (tcl-xi-type! d n xi a y b hty)
                                             (fact 'ooint-elt-in-rr a y xi)
                                             (dk-have! (list 'AND (list '< a xi) (list '< xi y))
                                               (lambda ()
                                                 (dk-split-all! (dk-landed* (lambda () (mac-h 'ooint-membership (list 'IN xi (list 'OOINT a y))))))
                                                 (dk-conj-close! (lambda () (ass)))))
                                             (dk-split! (list 'AND (list '< a xi) (list '< xi y)))
                                             (dk-have! (list '<= (list '(DIST RR-MS) a xi) d0)
                                               (lambda ()
                                                 (mac 'rr-ms-dist)
                                                 (tcl-real! (list '- a xi))
                                                 (dk-have! (list '< (list '- a xi) 0) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN xi 'RR) (list '< a xi))))
                                                 (subst (dk-fact! 'rr-abs-of-neg (list '- a xi)))
                                                 (dk-ineq! (list 'IN a 'RR) (list 'IN xi 'RR) (list 'IN y 'RR) (list 'IN w 'RR) (list 'IN d0 'RR)
                                                           (list '< xi y) (list '<= (list '- w) (list '- a y)) (list '<= w d0))))
                                             (dk-have! (list 'IN xi '(PTS RR-MS)) (lambda () (slot 'PTS) (ass)))
                                             (let ((dd (dk-apply! du xi)))
                                               (fact 'fun-apply-type-c tcen 'RR 'RR a)
                                               (fact 'fun-apply-type-c tcen 'RR 'RR xi)
                                               (dk-have! (list '<= xi b) (lambda () (dk-ineq! (list 'IN xi 'RR) (list 'IN y 'RR) (list 'IN b 'RR) (list '< xi y) (list '<= y b))))
                                               (dk-have! (list '<= a xi) (lambda () (dk-ineq! (list 'IN xi 'RR) (list 'IN a 'RR) (list '< a xi))))
                                               (fact 'extend-const-fixes a b a dn)
                                               (fact 'extend-const-fixes a b xi dn)
                                               (dk-have! (list '<= (list 'ABS (list '- (list tcen a) (list tcen xi))) e)
                                                 (lambda () (mac-h 'rr-ms-dist dd) (ass)))
                                               (subst (list '= dna (list tcen a)))
                                               (subst (list '= dxi (list tcen xi)))
                                               (ass)))))))))))))))))))
          ;; ---- p > a: st is the quotient near p
          (lambda ()
            (dk-apply! qfc p)
            (tcl-real! (list '- p a))
            (dk-have! (list '< 0 (list '- p a)) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN p 'RR) (list '< a p))))
            (fact 'rr-pos-rr-of-lt (list '- p a))
            (let* ((hd (dk-halve! (list '- p a))))
              (dk-have! (list 'FORALL 'tcx_ (list 'IMPLIES '(IN tcx_ RR) (list 'IMPLIES (list '<= (list 'ABS (list '- 'tcx_ p)) hd)
                          (list '= (list st 'tcx_) (list qf 'tcx_)))))
                (lambda ()
                  (let* ((l2 (dk-peel!)) (x (cadr (tcl-first (dk-head? 'IN) l2))))
                    (tcl-real! (list '- x p))
                    (dk-split! (dk-fact! 'rr-abs-le-parts (list '- x p) hd))
                    (dk-have! (list '< a x) (lambda () (dk-ineq! (list 'IN x 'RR) (list 'IN a 'RR) (list 'IN p 'RR) (list 'IN hd 'RR)
                                                                 (list '<= (list '- hd) (list '- x p)) (list '= (list '+ hd hd) (list '- p a))
                                                                 (list '< 0 hd))))
                    (st-at-gt! x))))
              (fact 'continuous-at-local st qf p hd)
              (ass)))))))
  )
(qed 'taylor-factor-glue-continuous)

;;; (9g) 2.21: THE CONTINUOUS REMAINDER FACTOR S_n.
;;; z in [a, b] in context: land (<= a z) and (<= z b)
(define (tcl-ccint-parts! z a b)
  (dk-have! (list 'AND (list '<= a z) (list '<= z b))
    (lambda ()
      (dk-split-all! (dk-landed* (lambda () (mac-h 'ccint-membership (list 'IN z (list 'CCINT a b))))))
      (dk-conj-close! (lambda () (ass)))))
  (dk-split! (list 'AND (list '<= a z) (list '<= z b))))
(define (tcl-supset-c d n a b)
  (list 'IMAGE (list 'VNB-LAMBDA 'tcv_ (list 'CCINT a b) (list 'ABS (list (list d n) 'tcv_))) (list 'CCINT a b)))
(sp (make-wff
  (let ((h (tcl-h21 'tcf_ '(succ tcm_) 'a 'b))
        (n '(succ tcm_)))
    (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
      (list 'FORALL 'tcf_ (list 'FORALL 'tcm_ (list 'IMPLIES '(IN tcm_ NN)
        (list 'IMPLIES '(< a b) (list 'IMPLIES (car h) (list 'IMPLIES (cadr h) (list 'IMPLIES (caddr h)
          (list 'IMPLIES '(IS-CONTINUOUS-ON (tcf_ (succ tcm_)) (CCINT a b))
            (list 'FORSOME 'tcs_ (list 'AND '(IN tcs_ (FUN (CCINT a b) RR))
              (list 'AND '(IS-CONTINUOUS-ON tcs_ (CCINT a b))
                (list 'AND '(= (tcs_ a) ((tcf_ (succ tcm_)) a))
                  (list 'AND (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ (CCINT a b))
                               '(= (TAYLOR-REM tcf_ (succ tcm_) a tct_)
                                   (* (* (tcs_ tct_) (power (- tct_ a) (succ tcm_))) (recip (FACTORIAL (succ tcm_)))))))
                    (list 'FORALL 'tct_ (list 'IMPLIES '(IN tct_ (CCINT a b))
                      (list '<= '(ABS (tcs_ tct_)) (list 'SUP (tcl-supset-c 'tcf_ n 'a 'b)))))))))))))))))))))))))
(let* ((lnd (dk-peel!))
       (cn (tcl-first (dk-head? 'IS-CONTINUOUS-ON) lnd))
       (dn (cadr cn)) (d (car dn)) (n (cadr dn)) (m (cadr n))
       (a (cadr (caddr cn))) (b (caddr (caddr cn)))
       (hs (filter (dk-head? 'FORALL) lnd))
       (hty (tcl-first (lambda (h) (dk-contains? h 'FUN)) hs))
       (cab (list 'CCINT a b))
       (st (tcl-stfn d n a b))
       (qf (tcl-qfn d n a b))
       (qb (lambda (v) (tcl-replace (cadddr qf) 'tcs_ v)))
       (ss (list 'RESTRICT st cab))
       (dna (list dn a))
       (ff (list 'FACTORIAL n)) (r (list 'recip ff))
       (ifs (lambda (v) (list 'IF (list '<= v a) dna (qb v))))
       (sset (tcl-supset-c d n a b))
       (phi (cadr sset)))
  (tcl-nat! n) (tcl-real! n) (tcl-real! a) (tcl-real! b) (tcl-real! ff) (tcl-real! r)
  (dk-have! (list '<= a b) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '< a b))))
  (dk-have! (list '<= a a) (lambda () (dk-ineq! (list 'IN a 'RR))))
  (dk-have! (list 'IN a cab) (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (ass)))))
  (fact 'nn-le-refl n)
  (dk-have! (list 'IN dn (list 'FUN cab 'RR)) (lambda () (dk-apply! hty n) (ass)))
  (fact 'fun-apply-type-c dn cab 'RR a)
  (fact 'rr-recip-factorial n)
  ;; the quotient is a function RR -> RR (off its continuity at b, by (9d))
  (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ n) (list 'IN (list (list d 'tck_) a) 'RR))))
    (lambda () (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<) l2))))
                 (tcl-real! k)
                 (dk-have! (list '<= k n) (lambda () (dk-ineq! (list 'IN k 'RR) (list 'IN n 'RR) (list '< k n))))
                 (dk-apply! hty k)
                 (fact 'fun-apply-type-c (list d k) cab 'RR a)
                 (ass))))
  (tcl-nat! 0)
  (dk-have! (list '< 0 n) (lambda () (fact 'nn-one-le-succ m) (dk-ineq! (list 'IN n 'RR) (list '<= 1 n))))
  (dk-apply! (tcl-first (lambda (h) (dk-contains? h 'IS-CONTINUOUS-ON)) hs) 0)
  (dk-apply! (dk-fact! 'taylor-factor-fn-continuous a b d m) b)
  (tcl-cont-type! qf b)
  (let* ((gc (dk-fact! 'taylor-factor-glue-continuous a b d m))
         (fvx (dk-fact! 'taylor-factor-fn-value a b d m)))
    (dk-apply! gc a)
    (tcl-cont-type! st a)
    (fact 'ccint-subset-rr a b)
    (fact 'restrict-in-fun st 'RR 'RR cab)
    (let* ((s-at! (lambda (z)     ; z in [a, b]: land (= (ss z) (st z)), z real, (st z) real
                    (fact 'ccint-elt-in-rr a b z)
                    (fact 'fun-apply-type-c st 'RR 'RR z)
                    (tcl-have! (list '= (list ss z) (list st z))
                      (lambda () (subst (dk-fact! 'restrict-apply st cab z)) (rfl)))))
           (st-at-a! (lambda ()
                       (dk-have! (list '= (list st a) dna)
                         (lambda ()
                           (dk-lam-b!)
                           (dk-each-leaf! (lambda () (if-true (ifs a)))
                             (lambda () (if (dk-head-is? (dk-goal) '<=) (ass)
                                            (begin (subst (list '= (ifs a) dna)) (rfl)))))))))
           (st-at-gt! (lambda (v)     ; a < v: land (= (st v) (qf v))
                        (fact 'rr-lt-not-le a v)
                        (fact 'fun-apply-type-c qf 'RR 'RR v)
                        (dk-have! (list '= (list st v) (list qf v))
                          (lambda ()
                            (dk-lam-b-h! (list 'IN (list qf v) 'RR))
                            (dk-lam-b!)
                            (dk-each-leaf! (lambda () (if-false (ifs v)))
                              (lambda () (if (dk-head-is? (dk-goal) 'NOT) (ass)
                                             (begin (subst (list '= (ifs v) (qb v))) (rfl))))))))))
      ;; ---- continuity on [a, b]
      (dk-have! (list 'IS-CONTINUOUS-ON ss cab)
        (lambda ()
          (dk-have! (list 'FORALL 'itz_ (list 'IMPLIES (list 'IN 'itz_ cab) (list '= (list ss 'itz_) (list st 'itz_))))
            (lambda () (let ((z (dk-di-var!))) (s-at! z))))
          (fact 'cont-on-of-total cab st ss)
          (ass)))
      ;; ---- S(a) = f^(n)(a)
      (s-at! a) (st-at-a!)
      (dk-have! (list '= (list ss a) dna)
        (lambda () (subst (list '= (list ss a) (list st a))) (subst (list '= (list st a) dna)) (rfl)))
      ;; ---- the values of d(k) at a, k <= m
      (dk-have! (tcl-guard-le m (lambda (k) (list 'IN (list (list d k) a) 'RR)))
        (lambda () (let* ((l2 (dk-peel!)) (k (cadr (tcl-first (dk-head? '<=) l2))))
                     (tcl-real! k) (tcl-real! m)
                     (fact 'nn-le-succ m)
                     (fact 'nn-le-trans-guarded k m n)
                     (dk-apply! hty k)
                     (fact 'fun-apply-type-c (list d k) cab 'RR a)
                     (ass))))
      ;; ---- R_n(t) = S(t) (t - a)^n / n!
      (dk-have! (list 'FORALL 'tct_ (list 'IMPLIES (list 'IN 'tct_ cab)
                  (list '= (list 'TAYLOR-REM d n a 'tct_) (list '* (list '* (list ss 'tct_) (list 'power (list '- 'tct_ a) n)) r))))
        (lambda ()
          (let ((t (dk-di-var!)))
            (s-at! t)
            (subst (list '= (list ss t) (list st t)))
            (tcl-ccint-parts! t a b)
            (use-cases (dk-fact! 'rr-le-cases a t)
              (lambda ()
                (st-at-gt! t)
                (subst (list '= (list st t) (list qf t)))
                (dk-lam-b!)
                (tcl-nat! 0) (fact 'nn-zero-le n)
                (dk-have! (list 'IN (list d 0) (list 'FUN cab 'RR)) (lambda () (dk-apply! hty 0) (ass)))
                (subst (dk-fact! 'extend-const-fixes a b t (list d 0)))
                (let ((pp (list 'power (list '- t a) n)))
                  (tcl-real! (list '- t a))
                  (dk-have! (list '< 0 (list '- t a)) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN t 'RR) (list '< a t))))
                  (fact 'rr-power-pos (list '- t a) n)
                  (tcl-real! pp)
                  (fact 'rr-pos-ne-zero pp)
                  (subst (dk-fact! 'recip-star-value pp))
                  (dk-have! (list '== (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a)) (list 'TAYLOR-REM d n a t))
                    (lambda () (mac 'TAYLOR-REM) (qrfl)))
                  (subst (list '== (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a)) (list 'TAYLOR-REM d n a t)))
                  (dk-have! (list 'AND (list 'IN pp 'RR) (list 'NOT (list '= pp 0))))
                  (fact 'rr-recip-closed pp)
                  (fact 'rr-recip-inverse pp)
                  (let* ((rem (list 'TAYLOR-REM d n a t))
                         (rhs (list '* (list '* (list '* (list '* rem ff) (list 'recip pp)) pp) r))
                         (unit (list '* rem (list '* (list '* ff r) (list '* pp (list 'recip pp))))))
                    (fact 'fun-apply-type-c st 'RR 'RR t)
                    (dk-have! (list 'IN rem 'RR)
                      (lambda ()
                        (fact 'fun-apply-type-c qf 'RR 'RR t)
                        (dk-have! (list 'IN (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a)) 'RR)
                          (lambda ()
                            (fact 'ccint-membership a b t)
                            (fact 'fun-apply-type-c (list d 0) cab 'RR t)
                            (dk-apply! (dk-fact! 'taylor-sum-continuous a d m) t)
                            (tcl-cont-type! (list 'VNB-LAMBDA 'tcs_ 'RR (list 'TAYLOR-SUM d n 'tcs_ a)) t)
                            (fact 'fun-apply-type-c (list 'VNB-LAMBDA 'tcs_ 'RR (list 'TAYLOR-SUM d n 'tcs_ a)) 'RR 'RR t)
                            (dk-lam-b-h! (list 'IN (list (list 'VNB-LAMBDA 'tcs_ 'RR (list 'TAYLOR-SUM d n 'tcs_ a)) t) 'RR))
                            (tcl-real! (cadr (dk-goal)))
                            (ass)))
                        (subst (list '= rem (list '- (list (list d 0) t) (list 'TAYLOR-SUM d n t a))))
                        (ass)))
                    (dk-have! (list '= rhs unit) (lambda () (tcl-crs!)))
                    (subst (list '= rhs unit))
                    (subst (list '= (list '* ff r) 1))
                    (subst (list '= (list '* pp (list 'recip pp)) 1))
                    (tcl-crs!))))
              (lambda ()
                (subst (list '= t a))
                (st-at-a!)
                (subst (list '= (list st a) dna))
                (mac 'TAYLOR-REM) (mac 'TAYLOR-SUM) (mac 'TAYLOR-TERM)
                (subst (dk-apply! (dk-fact! 'taylor-sum-at-base m d a)))
                (tcl-aa-zero! a)
                (subst (list '= (list '- a a) 0))
                (subst (dk-fact! 'power-zero-base m))
                (tcl-nat! 0) (fact 'nn-zero-le n)
                (dk-have! (list 'IN (list d 0) (list 'FUN cab 'RR)) (lambda () (dk-apply! hty 0) (ass)))
                (fact 'fun-apply-type-c (list d 0) cab 'RR a)
                (tcl-crs!))))))
      ;; ---- the sup over [a, b]: the set is real, inhabited and bounded above
      (fact 'fun-domain-in-set cab 'RR dn)
      (dk-have! (list 'IN phi (list 'FUN cab 'RR))
        (lambda () (tcl-lam-type! (lambda (v) (fact 'fun-apply-type-c dn cab 'RR v) (fact 'rr-abs-closed (list dn v)) (ass)))))
      (dk-have! (list 'SUBSET sset 'RR)
        (lambda () (let ((w (subset-by-element!))) (fact 'image-subset-codomain cab 'RR phi w) (ass))))
      (fact 'rr-abs-closed dna)
      (let ((mem! (lambda (z)
                    (fact 'fun-apply-type-c dn cab 'RR z)
                    (fact 'rr-abs-closed (list dn z))
                    (dk-have! (list 'IN (list 'ABS (list dn z)) sset)
                      (lambda () (mac 'image-membership-iff) (ew z)
                                 (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                                (begin (dk-lam-b!) (rfl))))))))))
        (mem! a)
        (dk-have! (list 'FORSOME 'tcy_ (list 'IN 'tcy_ sset)) (lambda () (ew (list 'ABS dna)) (ass)))
        (let ((tcen (list 'EXTEND-CONST dn a b)))
          (fact 'extend-const-in-fun a b dn)
          (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cab) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS tcen 'x)))
            (lambda () (let ((x (dk-di-var!))) (fact 'ccint-elt-in-rr a b x) (fact 'extend-const-continuous-at a b dn x) (ass))))
          (let* ((mm (dk-skolem! (dk-fact! 'continuous-abs-bounded-on-ccint tcen a b)))
                 (bnd (tcl-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm mm) (dk-contains? fm 'ABS))) (dk-asms))))
            (dk-have! (list 'RR-BOUNDED-ABOVE sset)
              (lambda ()
                (mac 'rr-bounded-above)
                (ew mm)
                (mac 'rr-upper-bound)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN) (ass)
                        (let* ((l2 (dk-peel!)) (wm (tcl-first (dk-head? 'IN) l2)) (w (cadr wm))
                               (x (dk-skolem! (dk-landed-1 (lambda () (mac-h 'image-membership-iff wm)))))
                               (eqn (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (equal? (caddr fm) w))) (dk-asms))))
                          (subst (list '= w (cadr eqn)))
                          (fact 'fun-apply-type-c dn cab 'RR x)
                          (dk-lam-b!)
                          (fact 'ccint-elt-in-rr a b x)
                          (tcl-ccint-parts! x a b)
                          (dk-apply! bnd x)
                          (fact 'extend-const-fixes a b x dn)
                          (subst (list '= (list dn x) (list tcen x)))
                          (ass)))))))))
        (let* ((ub (dk-fact! 'rr-sup-upper sset))
               (parts (dk-split! (dk-landed-1 (lambda () (mac-h 'rr-upper-bound ub)))))
               (univ (tcl-first (dk-head? 'FORALL) parts)))
          (dk-have! (list 'FORALL 'tct_ (list 'IMPLIES (list 'IN 'tct_ cab) (list '<= (list 'ABS (list ss 'tct_)) (list 'SUP sset))))
            (lambda ()
              (let ((t (dk-di-var!)))
                (s-at! t)
                (subst (list '= (list ss t) (list st t)))
                (tcl-ccint-parts! t a b)
                (use-cases (dk-fact! 'rr-le-cases a t)
                  (lambda ()
                    (let ((xi (dk-skolem! (dk-apply! fvx t))))
                      (st-at-gt! t)
                      (subst (list '= (list st t) (list qf t)))
                      (subst (tcl-first (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list qf t)))) (dk-asms)))
                      (tcl-xi-type! d n xi a t b hty)
                      (mem! xi)
                      (dk-apply! univ (list 'ABS (list dn xi)))
                      (ass)))
                  (lambda ()
                    (subst (list '= t a))
                    (subst (list '= (list st a) dna))
                    (dk-apply! univ (list 'ABS dna))
                    (ass))))))
          (ew ss)
          (dk-conj-close! (lambda () (ass))))))))
(qed 'taylor-remainder-factor)
