;;; the three elementary row operations at any size n
;; land the (succ n1) copies of FORMS (n := succ n1), n1 the predecessor of n
(define (dtr-at-succ! n1 forms)
  (for-each (lambda (f)
              (dk-have! (dtr-tsubst f (list (cons 'n (list 'succ n1))))
                (lambda () (subst (list '= (list 'succ n1) 'n)) (ass))))
            forms))
(define (dtr-pred-of-n! k)             ; with (IN k (INTERVAL 1 n)): n = succ n1
  (dtr-iv! k 1 'n)
  (dtr-nn-have! '(NOT (= n 0)) (list k 'n) (list (list '<= 1 k) (list '<= k 'n)))
  (dk-skolem! (dk-fact! 'nn-nonzero-is-succ 'n)))

(sp (make-wff
  (forall-guarded '(R n A sc k)
    '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT n n (CARR R))) (IN sc (CARR R))
      (IN k (INTERVAL 1 n)))
    '(= (DET R n (MATMUL R (ELEM-H R n sc k) A)) ((MUL R) sc (DET R n A))))))
(dk-peel!)
(let ((n1 (dtr-pred-of-n! 'k)))
  (dtr-at-succ! n1 '((IN A (MAT n n (CARR R))) (IN k (INTERVAL 1 n))))
  (fact 'dtr-elem-h-s n1 'R 'A 'sc 'k)
  (subst (list '= 'n (list 'succ n1)))
  (ass))
(dtr-done! 'det-elem-h-row)
(topic! 'det-elem-h-row 'algebra)
(gloss! 'det-elem-h-row
  "Scaling row k by sc scales the determinant by sc: det(H[sc,k] A) = sc det A.")

(sp (make-wff
  (forall-guarded '(R n A sc k l)
    '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT n n (CARR R))) (IN sc (CARR R))
      (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l)))
    '(= (DET R n (MATMUL R (ELEM-G R n sc k l) A)) (DET R n A)))))
(dk-peel!)
(let ((n1 (dtr-pred-of-n! 'k)))
  (dtr-at-succ! n1 '((IN A (MAT n n (CARR R))) (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n))))
  (fact 'dtr-elem-g-s n1 'R 'A 'sc 'k 'l)
  (subst (list '= 'n (list 'succ n1)))
  (ass))
(dtr-done! 'det-elem-g-row)
(topic! 'det-elem-g-row 'algebra)
(gloss! 'det-elem-g-row
  "Adding sc times row l to row k (k /= l) leaves the determinant unchanged:
   det(G[sc,k,l] A) = det A.")

(sp (make-wff
  (forall-guarded '(R n A k l)
    '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT n n (CARR R)))
      (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l)))
    '(= (DET R n (MATMUL R (ELEM-F R n k l) A)) ((NEG R) (DET R n A))))))
(dk-peel!)
(let ((n1 (dtr-pred-of-n! 'k)))
  (dtr-at-succ! n1 '((IN A (MAT n n (CARR R))) (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n))))
  (fact 'dtr-elem-f-s n1 'R 'A 'k 'l)
  (subst (list '= 'n (list 'succ n1)))
  (ass))
(dtr-done! 'det-elem-f-row)
(topic! 'det-elem-f-row 'algebra)
(gloss! 'det-elem-f-row
  "Interchanging rows k and l (k /= l) negates the determinant: det(F[k,l] A) = - det A.")

;;; =====================================================================
;;; (13) EXPANSION ALONG ANY ROW i (linear-algebra 3.22, the row half):
;;;   det A = sum_j (-1)^(i+j) a_ij det A[i,j].
;;; Induction on i: with A' = A with rows i and i+1 interchanged,
;;; A'[i,j] = A[i+1,j] and a'_ij = a_{i+1,j}, so the row-(i+1) expansion of A is
;;; minus the row-i expansion of A', which is det A' = - det A.
;;; =====================================================================
(define (dtr-rx-lam X i)
  (list 'VNB-LAMBDA 'dxj_ '(INTERVAL 1 (succ n))
    (list '(MUL R) (list 'MPOW dtr-mm dtr-neg1 (list '+ i 'dxj_))
          (list '(MUL R) (list 'ENTRY X i 'dxj_) (list 'DET 'R 'n (list 'MINOR X i 'dxj_ 'n))))))
(define (dtr-rx-sum X i) (list 'FINSUM dtr-ag (dtr-rx-lam X i) '(INTERVAL 1 (succ n))))

;; i + j in NN, and the sign (-1)^(i+j) typed
(define (dtr-rx-sign-type! i j)
  (dk-have! (list 'AND (list 'IN i 'NN) (list 'IN j 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'nn-add-closed i j)
  (fact 'dtr-sign-type 'R (list '+ i j)))

;; d' = - d, d' = t  =>  d = (-1) t + 0
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drd_ dre_ drt_)
      (append (dtr-carr-guards '(drd_ dre_ drt_))
              (list '(= dre_ ((NEG R) drd_)) '(= dre_ drt_)))
      (list '= 'drd_ (list '(ADD R) (list '(MUL R) dtr-neg1 'drt_) '(ZERO R))))))))
(dk-peel!)
(subst '(= drt_ dre_))
(subst '(= dre_ ((NEG R) drd_)))
(crs)
(dtr-done! 'dtr-ring-rx)
(topic! 'dtr-ring-rx 'plumbing)

;; ((-1) s)(a d) = (-1)(s (a d)) + 0
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drs_ dra_ drd_) (dtr-carr-guards '(drs_ dra_ drd_))
      (list '= (list '(MUL R) (list '(MUL R) dtr-neg1 'drs_) '((MUL R) dra_ drd_))
               (list '(ADD R) (list '(MUL R) dtr-neg1 '((MUL R) drs_ ((MUL R) dra_ drd_)))
                     '(ZERO R))))))))
(dk-peel!)
(crs)
(dtr-done! 'dtr-ring-rx2)
(topic! 'dtr-ring-rx2 'plumbing)

(define dtr-rx-ind-stmt
  (list 'FORALL 'i (list 'IMPLIES '(IN i NN)
    (forall-guarded '(n R A)
      '((IN n NN) (IS-COMMUTATIVE-RING R) (IN A (MAT (succ n) (succ n) (CARR R)))
        (<= 1 i) (<= i (succ n)))
      (list '= '(DET R (succ n) A) (dtr-rx-sum 'A 'i))))))

(define dtr-rx-A2 (dtr-mk2 'i '(succ i) '(ENTRY A (succ i) dtw_) '(ENTRY A i dtw_)))
(define (dtr-rx-summand X i v)
  (list '(MUL R) (list 'MPOW dtr-mm dtr-neg1 (list '+ i v))
        (list '(MUL R) (list 'ENTRY X i v) (list 'DET 'R 'n (list 'MINOR X i v 'n)))))

;; after the MK read-off and IF resolution: close an ENTRY equation, using an
;; index equation in context when the rows differ syntactically
(define (dtr-rx-close! u)
  (let ((g (dk-goal)))
    (if (and u (not (equal? (cadr g) (caddr g))) (dk-asm? (list '= u 'i)))
        (subst (list '= u 'i))))
  (dtr-type-carr! (cadr (dk-goal)))
  (rfl))

;; MINOR(A', i, v, n) = MINOR(A, succ i, v, n)
(define (dtr-rx-minor! v)
  (let ((M2 (list 'MINOR dtr-rx-A2 'i v 'n))
        (M1 (list 'MINOR 'A '(succ i) v 'n)))
    (fact 'minor-type 'R dtr-rx-A2 'i v 'n)
    (fact 'minor-type 'R 'A '(succ i) v 'n)
    (dk-have! (list '= M2 M1)
      (lambda ()
        (detach-with! (dk-fact! 'matrix-entry-extensionality 'n 'n '(CARR R) M2 M1)
          (lambda ()
            (dk-peel!)
            (let* ((g (dk-goal)) (u (caddr (cadr g))) (w (cadddr (cadr g)))
                   (K (dtr-skip w v))
                   (tms (list u 'i 'n (list 'succ u) '(succ i) '(succ n))))
              (dtr-iv! u 1 'n)
              (dtr-iv! w 1 'n)
              (fact 'minor-entry 'R dtr-rx-A2 'i v 'n u w)
              (fact 'minor-entry 'R 'A '(succ i) v 'n u w)
              (subst (list '= (list 'ENTRY M2 u w) (list 'ENTRY dtr-rx-A2 (dtr-skip u 'i) K)))
              (subst (list '= (list 'ENTRY M1 u w) (list 'ENTRY 'A (dtr-skip u '(succ i)) K)))
              (fact 'dtr-skip-in 'n v w)
              (fact 'dtr-succ-in 'n u)
              (dtr-widen! u 1 'n '(succ n) '((succ n)))
              (fact 'nn-succ-closed u)
              (use-em (list '< u 'i)
                (lambda ()
                  (dtr-nn-have! (list '< u '(succ i)) tms (list (list '< u 'i)))
                  (dtr-nn-have! (list 'NOT (list '= u 'i)) tms (list (list '< u 'i)))
                  (dtr-nn-have! (list 'NOT (list '= u '(succ i))) tms (list (list '< u 'i)))
                  (dtr-if-auto!) (dtr-mk-rewrite!) (dtr-if-auto!)
                  (dtr-rx-close! u))
                (lambda ()
                  (fact 'nn-not-lt-le u 'i)
                  (use-em (list '< u '(succ i))
                    (lambda ()
                      (fact 'nn-lt-succ-le u '(succ i))
                      (dtr-nn-have! (list '= u 'i) tms
                                    (list (list '<= (list 'succ u) '(succ i)) (list '<= 'i u)))
                      (dtr-nn-have! (list 'NOT (list '= (list 'succ u) 'i)) tms (list (list '= u 'i)))
                      (dtr-nn-have! (list '= (list 'succ u) '(succ i)) tms (list (list '= u 'i)))
                      (dtr-if-auto!) (dtr-mk-rewrite!) (dtr-if-auto!)
                      (dtr-rx-close! u))
                    (lambda ()
                      (fact 'nn-not-lt-le u '(succ i))
                      (dtr-nn-have! (list 'NOT (list '= (list 'succ u) 'i)) tms
                                    (list (list '<= '(succ i) u)))
                      (dtr-nn-have! (list 'NOT (list '= (list 'succ u) '(succ i))) tms
                                    (list (list '<= '(succ i) u)))
                      (dtr-if-auto!) (dtr-mk-rewrite!) (dtr-if-auto!)
                      (dtr-rx-close! u))))))))
        (ass)))))

;; the pointwise equation of the step, goal beta-reduced
(define (dtr-rx-pointwise! v)
  (dtr-iv! v 1 '(succ n))
  (dtr-mk-rewrite!)
  (dtr-if-auto!)
  (dtr-rx-minor! v)
  (subst (list '= (list 'MINOR dtr-rx-A2 'i v 'n) (list 'MINOR 'A '(succ i) v 'n)))
  (dtr-rx-sign-type! 'i v)
  (dtr-nn-have! (list '= (list '+ '(succ i) v) (list 'succ (list '+ 'i v)))
                (list 'i v '(succ i) (list 'succ (list '+ 'i v))) '())
  (subst (list '= (list '+ '(succ i) v) (list 'succ (list '+ 'i v))))
  (fact 'dtr-sign-succ 'R (list '+ 'i v))
  (subst (list '= (dtr-sign (list 'succ (list '+ 'i v)))
               (list '(MUL R) dtr-neg1 (dtr-sign (list '+ 'i v)))))
  (dtr-type-carr! (list 'ENTRY 'A '(succ i) v))
  (fact 'det-in-carrier 'R 'n (list 'MINOR 'A '(succ i) v 'n))
  (fact 'dtr-ring-rx2 'R (dtr-sign (list '+ 'i v)) (list 'ENTRY 'A '(succ i) v)
        (list 'DET 'R 'n (list 'MINOR 'A '(succ i) v 'n)))
  (ass))

;; the row-1 summand typing with 1 + v for succ v
(define (dtr-rx-row1-type! v)
  (dtr-iv! v 1 '(succ n))
  (dtr-rx-sign-type! 1 v)
  (dtr-nn-have! (list '= (list '+ 1 v) (list 'succ v)) (list v (list 'succ v)) '())
  (subst (list '= (list '+ 1 v) (list 'succ v)))
  (dtr-cof-type! 'A v 'n))

(sp (make-wff dtr-rx-ind-stmt))
(define dtr-rx-ind (use-induction))
(dk-focus! (cdr (assq 'base dtr-rx-ind)))
(dk-peel!)
(dtr-absurd! '() '((<= 1 0)))
(dk-focus! (cdr (assq 'step dtr-rx-ind)))
(define dtr-rx-ih (cdr (assq 'ih dtr-rx-ind)))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-id 'R)
(fact 'ras-carr 'R)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed 'i)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(fact 'ring-neg-in-carr 'R '(ONE R))
(fact 'interval-in-set 1 '(succ n))
(fact 'interval-card-in-nn 1 '(succ n))
(define dtr-rx-tms '(i n (succ i) (succ n)))
(define dtr-rx-prs '((<= 1 (succ i)) (<= (succ i) (succ n))))
(dtr-in-iv! '(succ i) 1 '(succ n) dtr-rx-tms dtr-rx-prs)
(use-em '(= i 0)
  ;; ---- row 1: the defining expansion, with 1 + j for succ j
  (lambda ()
    (subst '(= i 0))
    (have! '(= (succ 0) 1) (lambda () (arith)))
    (subst '(= (succ 0) 1))
    (mac 'det-cofactor)
    (let* ((g (dk-goal)) (L (caddr (cadr g))) (Rl (caddr (caddr g))))
      (have! (list 'FORALL 'dxz_ (list 'IMPLIES '(IN dxz_ (INTERVAL 1 (succ n)))
               (list '= (list L 'dxz_) (list Rl 'dxz_))))
        (lambda ()
          (let ((v (dk-di-var!)))
            (dtr-beta!)
            (dtr-rx-row1-type! v)
            (rfl))))
      (subst (dk-fact! 'finsum-congruence-q dtr-ag '(INTERVAL 1 (succ n)) L Rl))
      (detach-with! (dk-fact! 'finsum-type-ptwise dtr-ag '(INTERVAL 1 (succ n)) Rl)
        (lambda ()
          (let ((v (dk-di-var!)))
            (dtr-beta!)
            (dtr-rx-row1-type! v)
            (dtr-close-carr!))))
      (rfl)))
  ;; ---- row succ i, i >= 1
  (lambda ()
    (dk-one-le! 'i)
    (dtr-in-iv! 'i 1 '(succ n) dtr-rx-tms (cons '(<= 1 i) dtr-rx-prs))
    (dtr-nn-have! '(NOT (= (succ i) i)) dtr-rx-tms '())
    (dtr-nn-have! '(NOT (= i (succ i))) dtr-rx-tms '())
    (have! '(= i i) (lambda () (rfl)))
    (have! '(= (succ i) (succ i)) (lambda () (rfl)))
    (dtr-mk-type! dtr-rx-A2)
    ;; det A' = - det A
    (dtr-chain! (dk-fact! 'dtr-swap-s 'n 'R 'A dtr-rx-A2 'i '(succ i))
      (lambda (ante)
        (lambda ()
          (dk-peel!)
          (dtr-mk-rewrite!)
          (dtr-if-auto!)
          (dtr-rx-close! #f))))
    ;; det A' = its row-i expansion (the induction hypothesis)
    (dtr-nn-have! '(<= i (succ n)) dtr-rx-tms dtr-rx-prs)
    (dtr-chain! (inst*! dtr-rx-ih 'n 'R dtr-rx-A2) (lambda (ante) (lambda () (ass))))
    ;; the row-(succ i) expansion of A is (-1) (row-i expansion of A') + 0
    (let* ((h  (dtr-rx-lam 'A '(succ i)))
           (f  (dtr-rx-lam dtr-rx-A2 'i))
           (z  '(VNB-LAMBDA dxj_ (INTERVAL 1 (succ n)) (ZERO R)))
           (lin (dtr-chain! (dk-fact! 'dtr-finsum-lin 'R '(INTERVAL 1 (succ n)) dtr-neg1 f z h)
                  (lambda (ante)
                    (let ((body (caddr (caddr ante))))
                      (cond
                        ((and (eq? (car body) 'IN) (equal? (car (cadr body)) z))
                         (lambda ()
                           (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                             (dtr-beta!)
                             (if (not (sequent-node-grounded? leaf)) (ass)))))
                        ((eq? (car body) 'IN)
                         (lambda ()
                           (let ((v (dk-di-var!)))
                             (dtr-beta!)
                             (dtr-iv! v 1 '(succ n))
                             (dtr-rx-sign-type! 'i v)
                             (fact 'minor-type 'R dtr-rx-A2 'i v 'n)
                             (fact 'det-in-carrier 'R 'n (list 'MINOR dtr-rx-A2 'i v 'n))
                             (dtr-type-carr! (dtr-rx-summand dtr-rx-A2 'i v))
                             (ass))))
                        (#t
                         (lambda ()
                           (let ((v (dk-di-var!)))
                             (dtr-beta!)
                             (dtr-rx-pointwise! v)))))))))
           (zsum (dtr-chain! (dk-fact! 'finsum-all-id-ptwise dtr-ag '(INTERVAL 1 (succ n)) z)
                   (lambda (ante)
                     (lambda () (let ((v (dk-di-var!))) (dtr-beta!)
                                  (subst (list '= (list 'IDEN dtr-ag) '(ZERO R))) (rfl)))))))
      (subst lin)
      (subst zsum)
      (subst (list '= (list 'IDEN dtr-ag) '(ZERO R)))
      (fact 'det-in-carrier 'R '(succ n) 'A)
      (fact 'det-in-carrier 'R '(succ n) dtr-rx-A2)
      (dtr-have! (list 'IN (dtr-rx-sum dtr-rx-A2 'i) '(CARR R))
        (lambda ()
          (subst (list '= (dtr-rx-sum dtr-rx-A2 'i) (list 'DET 'R '(succ n) dtr-rx-A2)))
          (ass)))
      (fact 'dtr-ring-rx 'R '(DET R (succ n) A) (list 'DET 'R '(succ n) dtr-rx-A2)
            (dtr-rx-sum dtr-rx-A2 'i))
      (ass))))
(dtr-done! 'det-expand-row-ind)
(topic! 'det-expand-row-ind 'algebra)

;;; headline: expansion along any row i (the notes' 3.22, row half; the size is
;;; succ n, the minors are n-by-n)
(sp (make-wff
  (forall-guarded '(R n A i)
    '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT (succ n) (succ n) (CARR R)))
      (IN i (INTERVAL 1 (succ n))))
    (list '= '(DET R (succ n) A) (dtr-rx-sum 'A 'i)))))
(dk-peel!)
(dtr-iv! 'i 1 '(succ n))
(fact 'det-expand-row-ind 'i 'n 'R 'A)
(ass)
(dtr-done! 'det-expand-row)
(topic! 'det-expand-row 'algebra)
(gloss! 'det-expand-row
  "Laplace expansion along ANY row i: det A = sum_j (-1)^(i+j) a_ij det A[i,j],
   A[i,j] = MINOR(A,i,j,n) (commutative ring).  Row 1 is the definition.")
