(for-each (lambda (f)
            (dk-have! (dtr-tsubst f (list (cons 'n (list 'succ dtr-sw-n1))))
              (lambda () (subst (list '= (list 'succ dtr-sw-n1) 'n)) (ass))))
          (list '(IN A (MAT n n (CARR R))) '(IN B (MAT n n (CARR R)))
                '(IN p (INTERVAL 1 n)) '(IN q (INTERVAL 1 n))
                (dtr-sw-hBo 'n) (dtr-sw-hrow 'n 'p 'q) (dtr-sw-hrow 'n 'q 'p)))
(fact 'dtr-swap-s dtr-sw-n1 'R 'A 'B 'p 'q)
(subst (list '= 'n (list 'succ dtr-sw-n1)))
(ass)
(dtr-done! 'det-swap-rows)
