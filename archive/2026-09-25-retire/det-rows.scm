;;; det-rows.scm -- the determinant is LINEAR in each row and ALTERNATING; the
;;; interchange of two rows, the elementary row operations, and the expansion
;;; along any row (batch 25-C, 2026-09-24).  Linear-algebra 3.18 (row clauses),
;;; the row form of 3.19, and 3.22 (row half).  All over a COMMUTATIVE ring.
;;;
;;; HEADLINES
;;;   det-row-linear        C = A = B off row p, row p of C = sc (row p of A) + row p of B
;;;                         =>  det C = sc det A + det B
;;;   det-alternating-rows  two equal rows => det = 0      (the support of
;;;                         structure-library/determinant.scm, stated LITERALLY)
;;;   det-swap-rows         B = A with rows p, q interchanged => det B = - det A
;;;   det-elem-{h,g,f}-row  det(H[sc,k] A) = sc det A, det(G[sc,k,l] A) = det A,
;;;                         det(F[k,l] A) = - det A
;;;   det-expand-row        det A = sum_j (-1)^(i+j) a_ij det A[i,j]   (any row i)
;;;
;;; THE ROUTE, AND WHY IT IS NOT HOFFMAN-KUNZE'S.  HK 5.2 Thm 1 builds det by
;;; expansion along a COLUMN; alternation in the ROWS is then immediate (two equal
;;; adjacent rows: the other minors have two equal rows, the two remaining terms
;;; cancel).  The library's DET expands along the first ROW (det-cofactor), for
;;; which that argument gives alternation in the COLUMNS.  Rows need two levels:
;;;   * linearity: induction on the size (row 1 directly -- the first-row minors
;;;     do not see row 1 -- and row succ q through the minors, dtr-minor1-entry);
;;;   * the CRUX, rows 1 and 2 equal (dtr-det-rows12): expand along row 1 and every
;;;     first-row minor along ITS row 1 = row 2 of A; the double minor is symmetric
;;;     in the two deleted columns (dtr-minor-minor), the signs are opposite
;;;     (dtr-sign-succ), so the double sum is antisymmetric under
;;;     (j,k) <-> (succ k, j) and vanishes (dtr-dsum-anti, an induction on the size
;;;     that adds the last row and the last column together -- characteristic 2 is
;;;     no obstacle: no "2x = 0 => x = 0" is used);
;;;   * two equal rows neither of which is row 1: the minors inherit them
;;;     (dtr-alt-low, from the induction hypothesis);
;;;   * row 1 equal to row q >= 3: linearity in rows q and 2 writes det A as a sum
;;;     of determinants with rows 1,2 or 2,q equal (dtr-alt-row1).
;;; The interchange and the elementary operations follow from linearity plus
;;; alternation with auxiliary matrices built as MATOF terms (dtr-mk, dtr-mk2,
;;; dtr-mk1: A with one or two rows replaced); the expansion along row i+1 is minus
;;; the expansion along row i of A with rows i, i+1 interchanged.
;;;
;;; LOAD WINDOW [1940, -): lo = elem-row-actions-proof (the row actions of F, G, H);
;;; the rest: elem-entry-readoffs (elem-f-type, 1917), rake-finsum-union
;;; (finsum-all-id-ptwise, 1332), rake-mat-typing (minor-type, det-in-carrier,
;;; 1276), rake-det-small (minor-entry).  Nothing in the tree cites the file.
;;; PROPOSED SLOT: immediately after "theorem-library/elem-row-actions-proof",
;;; then theorem-library/det-mul.  RETIRE: the support det-alternating-rows
;;; (structure-library/determinant.scm).  No support, stamp, axiom or definition.
;;;
;;; Helper prefix: dtr-.  Binders the driver builds: dl*_ / dm*_ / dr*_ / ds*_ /
;;; dw*_ / dt*_ / dx*_ .

;;; =====================================================================
;;; The file's kit.
;;; =====================================================================

(define (dtr-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** det-rows: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

;; IF resolution (rake-det-small.scm's r6c-if-branch!, copied: file-local there).
(define (dtr-if-branch! true? ifterm thunk)
  (let* ((c      (cadr ifterm))
         (val    (if true? (caddr ifterm) (cadddr ifterm)))
         (want   (if true? c (list 'NOT c)))
         (opened (dk-opened (lambda () (if true? (if-true ifterm) (if-false ifterm)))))
         (conds  (filter (lambda (l) (alpha-equiv? (dk-goal-of l) want)) opened))
         (mains  (filter (lambda (l) (not (memq l conds))) opened)))
    (if (not (and (<= (length conds) 1) (= 1 (length mains))))
        (error "dtr-if-branch!: expected one condition leaf and one main leaf, got"
               (map (lambda (l) (expression->string (dk-goal-of l))) opened)))
    (if (pair? conds) (begin (dk-focus! (car conds)) (ass)))
    (dk-focus! (car mains))
    (subst (list '= ifterm val))
    (thunk)))

(define (dtr-case-if! ifterm k)
  (let ((c (cadr ifterm)))
    (use-em c
      (lambda () (dtr-if-branch! #t  ifterm (lambda () (k #t (caddr  ifterm)))))
      (lambda () (dtr-if-branch! #f ifterm (lambda () (k #f (cadddr ifterm))))))))

;; NN -> RR lifting for `ineq'.  (dtr-lift! T): T an NN term (symbol, numeral or
;; (succ x)); lands (IN T RR) and, for a successor, succ(x) = x + 1.  Returns the
;; list of EQUATIONS landed (premises for dk-ineq!).
(define (dtr-lift! t)
  (cond ((number? t) '())
        ((and (pair? t) (eq? (car t) 'succ))
         (let ((eqs (dtr-lift! (cadr t))))
           (fact 'nn-succ-closed (cadr t))
           (fact 'nn-in-rr t)
           (fact 'nn-succ-plus-one (cadr t))
           (cons (list '= t (list '+ (cadr t) 1)) eqs)))
        (#t (fact 'nn-in-rr t) (fact 'nn-zero-le t) (list (list '<= 0 t)))))

;; (dtr-nn! TERMS PREMS): close the focus goal -- an atom (<=, <, =) or
;; (NOT (= a b)) or (NOT (< a b)) or (NOT (<= a b)) -- by `ineq' over the NN terms
;; TERMS (lifted to RR) and the premise formulas PREMS.  A negated goal is
;; refuted: assume the atom, derive 1 <= 0.
(define (dtr-nn! terms prems)
  (let* ((eqs (append-map dtr-lift! terms))
         (g   (dk-goal)))
    (if (and (pair? g) (eq? (car g) 'NOT))
        (let ((atom (cadr g)))
          (di)
          (have! '(<= 1 0) (lambda () (apply dk-ineq! (append prems eqs (list atom)))))
          (dk-focus-having! '(<= 1 0))
          (have! '(NOT (<= 1 0)) (lambda () (arith)))
          (dk-focus-having! '(NOT (<= 1 0)))
          (ai '(NOT (<= 1 0))))
        (apply dk-ineq! (append prems eqs)))))

;; (dtr-have! F THUNK) -- dk-have!, or, when F IS the focus goal, just THUNK
;; (a cut of the focus goal is a self-loop).
(define (dtr-have! f thunk)
  (if (alpha-equiv? (dk-goal) f) (thunk) (dk-have! f thunk)))

;; (dtr-nn-have! F TERMS PREMS) -- land F by dtr-nn!, unless already there.
(define (dtr-nn-have! f terms prems)
  (dtr-have! f (lambda () (dtr-nn! terms prems))))

;; interval membership bookkeeping: from (IN i (INTERVAL a b)) land i in NN,
;; a <= i, i <= b.
(define (dtr-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))

;; beta only when the goal holds a redex (lam-t and hash-consing may already
;; have reduced it; dk-lam-b! errors on "no redex").
(define (dtr-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))

(define dtr-ag   '(RING-ADDITIVE-AG R))
(define dtr-mm   '(RING-MULTIPLICATIVE-MONOID R))
(define dtr-neg1 '((NEG R) (ONE R)))

;;; =====================================================================
;;; (1) Two ring identities, by `crs' (R commutative).  Cited, never re-run,
;;; so the cofactor terms stay opaque atoms.
;;; =====================================================================
(define (dtr-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drs_ dra_ drb_ drc_ drd_) (dtr-carr-guards '(drs_ dra_ drb_ drc_ drd_))
      '(= ((MUL R) drs_ ((MUL R) ((ADD R) ((MUL R) drc_ dra_) drb_) drd_))
          ((ADD R) ((MUL R) drc_ ((MUL R) drs_ ((MUL R) dra_ drd_)))
                   ((MUL R) drs_ ((MUL R) drb_ drd_)))))))))
(dk-peel!)
(crs)
(dtr-done! 'dtr-ring-lin1)
(topic! 'dtr-ring-lin1 'plumbing)

(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drs_ dra_ drc_ drx_ dry_) (dtr-carr-guards '(drs_ dra_ drc_ drx_ dry_))
      '(= ((MUL R) drs_ ((MUL R) dra_ ((ADD R) ((MUL R) drc_ drx_) dry_)))
          ((ADD R) ((MUL R) drc_ ((MUL R) drs_ ((MUL R) dra_ drx_)))
                   ((MUL R) drs_ ((MUL R) dra_ dry_)))))))))
(dk-peel!)
(crs)
(dtr-done! 'dtr-ring-lin2)
(topic! 'dtr-ring-lin2 'plumbing)

;;; =====================================================================
;;; (2) dtr-finsum-lin -- a finite sum is linear: if h(z) = c f(z) + g(z)
;;; pointwise on s, then sum h = c (sum f) + sum g.  Over any ring (the scalar
;;; multiplies on the LEFT).  Pointwise hypotheses only: the families may be
;;; bare variables, lambdas over a larger domain, anything.
;;; =====================================================================
(define dtr-finsum-lin-stmt
  (forall-guarded '(R s c f g h)
    '((IS-RING R) (IN s SET) (IN (CARD s) NN) (IN c (CARR R))
      (FORALL dlz_ (IMPLIES (IN dlz_ s) (IN (f dlz_) (CARR R))))
      (FORALL dlz_ (IMPLIES (IN dlz_ s) (IN (g dlz_) (CARR R))))
      (FORALL dlz_ (IMPLIES (IN dlz_ s)
        (= (h dlz_) ((ADD R) ((MUL R) c (f dlz_)) (g dlz_))))))
    '(= (FINSUM (RING-ADDITIVE-AG R) h s)
        ((ADD R) ((MUL R) c (FINSUM (RING-ADDITIVE-AG R) f s))
                 (FINSUM (RING-ADDITIVE-AG R) g s)))))
(sp (make-wff dtr-finsum-lin-stmt))
(define dtr-fl-hyps (dk-peel!))
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-carr 'R)
(fact 'ras-op 'R)
(define (dtr-fl-hyp-of fn)          ; the typing hypothesis of family FN
  (find-first (lambda (h) (and (eq? (car h) 'FORALL)
                               (equal? (caddr (caddr h)) (list 'IN (list fn 'dlz_) '(CARR R)))))
              dtr-fl-hyps))
(define dtr-fl-heq
  (find-first (lambda (h) (and (eq? (car h) 'FORALL) (eq? (car (caddr (caddr h))) '=)))
              dtr-fl-hyps))
(define dtr-fl-F '(VNB-LAMBDA dlv_ s (f dlv_)))
(define dtr-fl-G '(VNB-LAMBDA dlv_ s (g dlv_)))
;; the lambda of a family is a function s -> CARR R
(define (dtr-fl-type! lam fn)
  (dk-have! (list 'IN lam '(FUN s (CARR R)))
    (lambda ()
      (dk-lam-t!)
      (let ((v (dk-di-var!)))
        (dtr-beta!)
        (dk-apply! (dtr-fl-hyp-of fn) v)
        (ass)))))
(dtr-fl-type! dtr-fl-F 'f)
(dtr-fl-type! dtr-fl-G 'g)
(dk-have! (list 'IN dtr-fl-G (list 'FUN 's (list 'CARR dtr-ag)))
  (lambda () (subst (list '= (list 'CARR dtr-ag) '(CARR R))) (ass)))
(fact 'finsum-type-ring-additive-ag 'R 's dtr-fl-F)
(fact 'finsum-type-ring-additive-ag 'R 's dtr-fl-G)
(define dtr-fl-d1 (dk-fact! 'finsum-ring-distrib-left-gen 'R 'c 's dtr-fl-F))
(define dtr-fl-L1 (caddr (caddr dtr-fl-d1)))      ; vnb-lambda(z, s, c * F(z))
(dk-have! (list 'IN dtr-fl-L1 (list 'FUN 's (list 'CARR dtr-ag)))
  (lambda ()
    (subst (list '= (list 'CARR dtr-ag) '(CARR R)))
    (dk-lam-t!)
    (let ((v (dk-di-var!)))
      (dtr-beta!)
      (dk-apply! (dtr-fl-hyp-of 'f) v)
      (fact 'ring-carrier-closed-mul 'R 'c (list 'f v))
      (ass))))
(define dtr-fl-d2 (dk-fact! 'finsum-add-ag dtr-ag 's dtr-fl-L1 dtr-fl-G))
(define dtr-fl-L2 (caddr (cadr dtr-fl-d2)))
;; the three congruences
(define (dtr-fl-cong! fam lam thunk)
  (have! (list 'FORALL 'dlw_ (list 'IMPLIES '(IN dlw_ s)
                                   (list '= (list fam 'dlw_) (list lam 'dlw_))))
    (lambda () (let ((v (dk-di-var!))) (dtr-beta!) (thunk v))))
  (dk-fact! 'finsum-congruence-q dtr-ag 's fam lam))
(define dtr-fl-c1 (dtr-fl-cong! 'f dtr-fl-F
                    (lambda (v) (dk-apply! (dtr-fl-hyp-of 'f) v) (rfl))))
(define dtr-fl-c2 (dtr-fl-cong! 'g dtr-fl-G
                    (lambda (v) (dk-apply! (dtr-fl-hyp-of 'g) v) (rfl))))
(define dtr-fl-c3
  (dtr-fl-cong! 'h dtr-fl-L2
    (lambda (v)
      (subst (list '= (list 'OPR dtr-ag) '(ADD R)))
      (dk-apply! dtr-fl-heq v)
      (ass))))
(subst dtr-fl-c3)
(subst dtr-fl-d2)
(subst (list '= (caddr dtr-fl-d1) (cadr dtr-fl-d1)))
(subst (list '= (list 'OPR dtr-ag) '(ADD R)))
(subst dtr-fl-c1)
(subst dtr-fl-c2)
(fact 'ring-carrier-closed-mul 'R 'c (list 'FINSUM dtr-ag dtr-fl-F 's))
(fact 'ring-add-closed 'R (list '(MUL R) 'c (list 'FINSUM dtr-ag dtr-fl-F 's))
      (list 'FINSUM dtr-ag dtr-fl-G 's))
(rfl)
(dtr-done! 'dtr-finsum-lin)
(topic! 'dtr-finsum-lin 'algebra)

;;; =====================================================================
;;; (3) index bookkeeping for the first-row minor.
;;; =====================================================================
;; (dtr-in-iv! X A B TERMS PREMS) -- land (IN X (INTERVAL A B)) with X an NN
;; term already typed in NN: A <= X and X <= B by dtr-nn!.
(define (dtr-in-iv! x a b terms prems)
  (dtr-have! (list 'IN x (list 'INTERVAL a b))
    (lambda ()
      (dtr-nn-have! (list '<= a x) terms prems)
      (dtr-nn-have! (list '<= x b) terms prems)
      (fact 'interval-mem-intro a b x)
      (ass))))

;; succ u in [1, succ n] for u in [1, n]
(sp (make-wff
  (forall-guarded '(n dmu_) '((IN n NN) (IN dmu_ (INTERVAL 1 n)))
    '(IN (succ dmu_) (INTERVAL 1 (succ n))))))
(dk-peel!)
(dtr-iv! 'dmu_ 1 'n)
(fact 'nn-succ-closed 'dmu_)
(dtr-in-iv! '(succ dmu_) 1 '(succ n) '(dmu_ n (succ dmu_) (succ n)) '((<= 1 dmu_) (<= dmu_ n)))
(dtr-done! 'dtr-succ-in)
(topic! 'dtr-succ-in 'plumbing)

;; the column re-index of a minor stays in range: IF(v < j, v, succ v) in [1, succ n]
(sp (make-wff
  (forall-guarded '(n dmj_ dmv_) '((IN n NN) (IN dmv_ (INTERVAL 1 n)))
    '(IN (IF (< dmv_ dmj_) dmv_ (succ dmv_)) (INTERVAL 1 (succ n))))))
(dk-peel!)
(dtr-iv! 'dmv_ 1 'n)
(fact 'nn-succ-closed 'n)
(dtr-case-if! '(IF (< dmv_ dmj_) dmv_ (succ dmv_))
  (lambda (b v)
    (if b
        (dtr-in-iv! 'dmv_ 1 '(succ n) '(dmv_ n (succ n)) '((<= 1 dmv_) (<= dmv_ n)))
        (begin (fact 'dtr-succ-in 'n 'dmv_) (ass)))))
(dtr-done! 'dtr-skip-in)
(topic! 'dtr-skip-in 'plumbing)

;; the entries of the FIRST-ROW minor: row u of MINOR(S,1,j,n) is row succ(u) of S
(define dtr-minor1-entry-stmt
  (forall-guarded '(R n S dmj_ dmu_ dmv_)
    '((IS-RING R) (IN n NN) (IN S (MAT (succ n) (succ n) (CARR R)))
      (IN dmu_ (INTERVAL 1 n)) (IN dmv_ (INTERVAL 1 n)))
    '(= (ENTRY (MINOR S 1 dmj_ n) dmu_ dmv_)
        (ENTRY S (succ dmu_) (IF (< dmv_ dmj_) dmv_ (succ dmv_))))))
(sp (make-wff dtr-minor1-entry-stmt))
(dk-peel!)
(dtr-iv! 'dmu_ 1 'n)
(fact 'minor-entry 'R 'S 1 'dmj_ 'n 'dmu_ 'dmv_)
(subst (list '= '(ENTRY (MINOR S 1 dmj_ n) dmu_ dmv_)
             '(ENTRY S (IF (< dmu_ 1) dmu_ (succ dmu_)) (IF (< dmv_ dmj_) dmv_ (succ dmv_)))))
(dtr-nn-have! '(NOT (< dmu_ 1)) '(dmu_) '((<= 1 dmu_)))
(dtr-if-branch! #f '(IF (< dmu_ 1) dmu_ (succ dmu_))
  (lambda ()
    (fact 'dtr-succ-in 'n 'dmu_)
    (fact 'dtr-skip-in 'n 'dmj_ 'dmv_)
    (fact 'nn-succ-closed 'n)
    (fact 'entry-in-carrier '(succ n) '(succ n) '(CARR R) 'S '(succ dmu_)
          '(IF (< dmv_ dmj_) dmv_ (succ dmv_)))
    (rfl)))
(dtr-done! 'dtr-minor1-entry)
(topic! 'dtr-minor1-entry 'algebra)

;; close ANY goal from contradictory NN facts: 1 <= 0 by ineq over PREMS.
(define (dtr-absurd! terms prems)
  (dk-have! '(<= 1 0) (lambda () (dtr-nn! terms prems)))
  (dk-focus-having! '(<= 1 0))
  (have! '(NOT (<= 1 0)) (lambda () (arith)))
  (dk-focus-having! '(NOT (<= 1 0)))
  (pbc)
  (ai '(NOT (<= 1 0))))

;; (dtr-pred! P N) -- with (IN P (INTERVAL 1 (succ N))), (IN N NN) and
;; (NOT (= P 1)) in context: land (IN Q (INTERVAL 1 N)) and (= P (succ Q)) for a
;; fresh Q, and return Q.
(define (dtr-pred! p n)
  (dtr-iv! p 1 (list 'succ n))
  (dtr-nn-have! (list 'NOT (list '= p 0)) (list p) (list (list '<= 1 p)))
  (let ((q (dk-skolem! (dk-fact! 'nn-nonzero-is-succ p))))
    (let ((peq (list '= p (list 'succ q))))
      (dtr-have! (list 'NOT (list '= q 0))
        (lambda ()
          (di)
          (have! (list '= p 1)
            (lambda () (dtr-nn! (list q p (list 'succ q)) (list peq (list '= q 0)))))
          (ai (list 'NOT (list '= p 1)))))
      (dk-one-le! q)
      (dtr-in-iv! q 1 n (list q p n (list 'succ q) (list 'succ n))
                  (list peq (list '<= p (list 'succ n))
                        (list '<= 1 q)))
      q)))

;;; =====================================================================
;;; (4) typing bricks for the cofactor summand.
;;; =====================================================================
(define (dtr-sign j) (list 'MPOW dtr-mm dtr-neg1 j))

(sp (make-wff
  (forall-guarded '(R dmj_) '((IS-RING R) (IN dmj_ NN))
    (list 'IN (dtr-sign 'dmj_) '(CARR R)))))
(dk-peel!)
(fact 'ring-multiplicative-monoid-is-monoid 'R)
(fact 'rmm-carr 'R)
(fact 'ring-one-in 'R)
(fact 'ring-neg-in-carr 'R '(ONE R))
(dk-have! (list 'IN dtr-neg1 (list 'CARR dtr-mm))
  (lambda () (subst (list '= (list 'CARR dtr-mm) '(CARR R))) (ass)))
(fact 'mpow-type dtr-mm dtr-neg1 'dmj_)
(subst (list '= '(CARR R) (list 'CARR dtr-mm)))
(ass)
(dtr-done! 'dtr-sign-type)
(topic! 'dtr-sign-type 'plumbing)

;; the cofactor summand along row 1
(define (dtr-cof X j n)
  (list '(MUL R) (dtr-sign (list 'succ j))
        (list '(MUL R) (list 'ENTRY X 1 j) (list 'DET 'R n (list 'MINOR X 1 j n)))))

;; land the typings of the pieces of (dtr-cof X J N) and of the summand itself.
;; Needs (IS-RING R), (IN N NN), (IN X (MAT (succ N) (succ N) (CARR R))),
;; (IN J (INTERVAL 1 (succ N))) in context.
(define (dtr-cof-type! X j n)
  (dtr-iv! j 1 (list 'succ n))
  (fact 'nn-one-in)
  (fact 'nn-succ-closed n)
  (fact 'nn-succ-closed j)
  (fact 'dtr-sign-type 'R (list 'succ j))
  (fact 'nn-le-refl 1)
  (fact 'nn-one-le-succ n)
  (fact 'interval-mem-intro 1 (list 'succ n) 1)
  (fact 'entry-in-carrier (list 'succ n) (list 'succ n) '(CARR R) X 1 j)
  (fact 'minor-type 'R X 1 j n)
  (fact 'det-in-carrier 'R n (list 'MINOR X 1 j n))
  (fact 'ring-carrier-closed-mul 'R (list 'ENTRY X 1 j) (list 'DET 'R n (list 'MINOR X 1 j n)))
  (fact 'ring-carrier-closed-mul 'R (dtr-sign (list 'succ j))
        (caddr (dtr-cof X j n))))

;;; =====================================================================
;;; (5) det is LINEAR IN EACH ROW (linear-algebra 3.18, the row half of the
;;; first clause).  By induction on the size: row 1 directly from the defining
;;; expansion (the first-row minors do not see row 1); row p = succ q >= 2 by the
;;; induction hypothesis at row q of the first-row minors.
;;; =====================================================================
(define (dtr-rowhyp X Y p n)        ; rows of X and Y agree off row p
  (list 'FORALL 'dri_ (list 'IMPLIES (list 'IN 'dri_ (list 'INTERVAL 1 n))
    (list 'IMPLIES (list 'NOT (list '= 'dri_ p))
      (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (list 'INTERVAL 1 n))
        (list '= (list 'ENTRY X 'dri_ 'drk_) (list 'ENTRY Y 'dri_ 'drk_))))))))
(define (dtr-combhyp C A B p sc n)  ; row p of C is sc * (row p of A) + row p of B
  (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (list 'INTERVAL 1 n))
    (list '= (list 'ENTRY C p 'drk_)
             (list '(ADD R) (list '(MUL R) sc (list 'ENTRY A p 'drk_)) (list 'ENTRY B p 'drk_))))))

;; first-row minors of matrices agreeing off row 1 coincide
(define dtr-minor1-congr-stmt
  (forall-guarded '(R n X Y p dmj_)
    (list '(IS-RING R) '(IN n NN) '(IN X (MAT (succ n) (succ n) (CARR R)))
          '(IN Y (MAT (succ n) (succ n) (CARR R))) '(IN dmj_ NN) '(= p 1)
          (dtr-rowhyp 'X 'Y 'p '(succ n)))
    '(= (MINOR X 1 dmj_ n) (MINOR Y 1 dmj_ n))))
(sp (make-wff dtr-minor1-congr-stmt))
(define dtr-mc-hyps (dk-peel!))
(define dtr-mc-rh (find-first (dk-head? 'FORALL) dtr-mc-hyps))
(fact 'nn-one-in)
(fact 'minor-type 'R 'X 1 'dmj_ 'n)
(fact 'minor-type 'R 'Y 1 'dmj_ 'n)
(detach-with! (dk-fact! 'matrix-entry-extensionality 'n 'n '(CARR R)
                        '(MINOR X 1 dmj_ n) '(MINOR Y 1 dmj_ n))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (u (caddr (cadr g))) (w (cadddr (cadr g))))
      (fact 'dtr-minor1-entry 'R 'n 'X 'dmj_ u w)
      (fact 'dtr-minor1-entry 'R 'n 'Y 'dmj_ u w)
      (subst (list '= (list 'ENTRY '(MINOR X 1 dmj_ n) u w)
                   (list 'ENTRY 'X (list 'succ u) (list 'IF (list '< w 'dmj_) w (list 'succ w)))))
      (subst (list '= (list 'ENTRY '(MINOR Y 1 dmj_ n) u w)
                   (list 'ENTRY 'Y (list 'succ u) (list 'IF (list '< w 'dmj_) w (list 'succ w)))))
      (dtr-iv! u 1 'n)
      (fact 'dtr-succ-in 'n u)
      (fact 'dtr-skip-in 'n 'dmj_ w)
      (dtr-have! (list 'NOT (list '= (list 'succ u) 'p))
        (lambda ()
          (subst '(= p 1))
          (dtr-nn! (list u (list 'succ u)) (list (list '<= 1 u)))))
      (let ((r (dk-apply! dtr-mc-rh (list 'succ u))))
        (dk-apply! r (list 'IF (list '< w 'dmj_) w (list 'succ w))))
      (ass))))
(ass)
(dtr-done! 'dtr-minor1-congr)
(topic! 'dtr-minor1-congr 'algebra)

;; the induction statement: n outermost for `ni'
(define (dtr-rl-body n)
  (forall-guarded '(R A B C p dsc_)
    (list '(IS-COMMUTATIVE-RING R) (list 'IN 'A (list 'MAT n n '(CARR R)))
          (list 'IN 'B (list 'MAT n n '(CARR R))) (list 'IN 'C (list 'MAT n n '(CARR R)))
          (list 'IN 'p (list 'INTERVAL 1 n)) '(IN dsc_ (CARR R))
          (dtr-rowhyp 'B 'A 'p n) (dtr-rowhyp 'C 'A 'p n) (dtr-combhyp 'C 'A 'B 'p 'dsc_ n))
    (list '= (list 'DET 'R n 'C)
             (list '(ADD R) (list '(MUL R) 'dsc_ (list 'DET 'R n 'A)) (list 'DET 'R n 'B)))))

;; (dtr-lin-chain! R0 THUNK-OF) -- detach the remaining antecedents of the
;; implication chain R0, each proved on a lane by (THUNK-OF ANTECEDENT).
(define (dtr-chain! r0 thunk-of)
  (let loop ((r r0))
    (cond ((not (and (pair? r) (eq? (car r) 'IMPLIES))) r)
          ((dk-asm? (cadr r))                ; already established: plain detach
           (let ((new (dk-landed* (lambda () (detach! r)))))
             (loop (if (pair? new) (dk--deepest-of new) (caddr r)))))
          (#t (loop (detach-with! r (thunk-of (cadr r))))))))

(define dtr-I '(INTERVAL 1 (succ n)))

;; the pointwise equation lane of the step: THUNK gets the eigenvariable v with
;; the goal already beta-reduced.
(define (dtr-rl-apply-lin! lamA lamB lamC eq-thunk)
  (fact 'interval-in-set 1 '(succ n))
  (fact 'interval-card-in-nn 1 '(succ n))
  (let ((res (dtr-chain! (dk-fact! 'dtr-finsum-lin 'R dtr-I 'dsc_ lamA lamB lamC)
               (lambda (ante)
                 (let* ((body (caddr (caddr ante))))
                   (if (eq? (car body) 'IN)
                       (let ((X (if (equal? (car (cadr body)) lamA) 'A 'B)))
                         (lambda ()
                           (let ((v (dk-di-var!)))
                             (dtr-beta!)
                             (dtr-cof-type! X v 'n)
                             (ass))))
                       (lambda ()
                         (let ((v (dk-di-var!)))
                           (dtr-beta!)
                           (eq-thunk v)))))))))
    (ass)))


;;; helpers of the step at row succ q (defined before the proof that uses them)
(define (dtr-skip w v) (list 'IF (list '< w v) w (list 'succ w)))
(define (dtr-m1! X v u w)          ; rewrite ENTRY(MINOR(X,1,v,n),u,w) in the goal
  (fact 'dtr-minor1-entry 'R 'n X v u w)
  (subst (list '= (list 'ENTRY (list 'MINOR X 1 v 'n) u w)
               (list 'ENTRY X (list 'succ u) (dtr-skip w v)))))

;; the row-agreement hypothesis of the IH at the minors: rows of MINOR(X,1,v,n)
;; and MINOR(A,1,v,n) agree off row q
(define (dtr-rl-rowagree! v q)
  (let* ((i (dk-di-var!)))
    (di)
    (let* ((k (dk-di-var!))
           (X (cadr (cadr (cadr (dk-goal)))))       ; the MINOR's matrix, B or C
           (peq (list '= 'p (list 'succ q))))
      (dtr-iv! i 1 'n)
      (dtr-iv! k 1 'n)
      (dtr-m1! X v i k)
      (dtr-m1! 'A v i k)
      (fact 'dtr-succ-in 'n i)
      (fact 'dtr-skip-in 'n v k)
      (dtr-have! (list 'NOT (list '= (list 'succ i) 'p))
        (lambda ()
          (di)
          (have! (list '= i q)
            (lambda ()
              (dtr-nn! (list i q 'p (list 'succ i) (list 'succ q))
                       (list (list '= (list 'succ i) 'p) peq))))
          (ai (list 'NOT (list '= i q)))))
      (let ((hX (if (eq? X 'B) dtr-rl-hB dtr-rl-hC)))
        (dk-apply! (dk-apply! hX (list 'succ i)) (dtr-skip k v)))
      (ass))))

;; the combination hypothesis of the IH at the minors, row q
(define (dtr-rl-comb! v q)
  (let ((k (dk-di-var!)))
    (dtr-iv! k 1 'n)
    (dtr-m1! 'C v q k) (dtr-m1! 'A v q k) (dtr-m1! 'B v q k)
    (fact 'dtr-skip-in 'n v k)
    (subst (list '= (list 'succ q) 'p))
    (dk-apply! dtr-rl-hP (dtr-skip k v))
    (ass)))

(define (dtr-rl-step2-eq! v q)
  (dtr-cof-type! 'A v 'n)
  (dtr-cof-type! 'B v 'n)
  (dtr-cof-type! 'C v 'n)
  ;; row 1 is common to A, B, C
  (dk-apply! (dk-apply! dtr-rl-hB 1) v)
  (dk-apply! (dk-apply! dtr-rl-hC 1) v)
  (subst (list '= (list 'ENTRY 'C 1 v) (list 'ENTRY 'A 1 v)))
  (subst (list '= (list 'ENTRY 'B 1 v) (list 'ENTRY 'A 1 v)))
  (let* ((MA (list 'MINOR 'A 1 v 'n)) (MB (list 'MINOR 'B 1 v 'n))
         (MC (list 'MINOR 'C 1 v 'n))
         (res (dtr-chain! (inst*! dtr-rl-ih 'R MA MB MC q 'dsc_)
                (lambda (ante)
                  (if (eq? (car (caddr (caddr ante))) 'IMPLIES)
                      (lambda () (dtr-rl-rowagree! v q))
                      (lambda () (dtr-rl-comb! v q)))))))
    (subst res)
    (fact 'dtr-ring-lin2 'R (dtr-sign (list 'succ v)) (list 'ENTRY 'A 1 v) 'dsc_
          (list 'DET 'R 'n MA) (list 'DET 'R 'n MB))
    (ass)))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dtr-rl-body 'n)))))
(define dtr-rl-ind (use-induction))
;; ---- base: [1, 0] is empty
(dk-focus! (cdr (assq 'base dtr-rl-ind)))
(dk-peel!)
(dtr-iv! 'p 1 0)
(dtr-absurd! '(p) '((<= 1 p) (<= p 0)))
;; ---- step
(dk-focus! (cdr (assq 'step dtr-rl-ind)))
(define dtr-rl-ih (cdr (assq 'ih dtr-rl-ind)))
(define dtr-rl-hyps (dk-peel!))
(define dtr-rl-hB (dtr-rowhyp 'B 'A 'p '(succ n)))
(define dtr-rl-hC (dtr-rowhyp 'C 'A 'p '(succ n)))
(define dtr-rl-hP (dtr-combhyp 'C 'A 'B 'p 'dsc_ '(succ n)))
(if (not (and (dk-asm? dtr-rl-hB) (dk-asm? dtr-rl-hC) (dk-asm? dtr-rl-hP)))
    (error "det-row-linear step: hypotheses not landed as expected" dtr-rl-hyps))
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-succ-closed 'n)
(fact 'nn-one-in)
(mac 'det-cofactor)
(define dtr-rl-goal (dk-goal))
(define dtr-rl-lamC (caddr (cadr dtr-rl-goal)))
(define dtr-rl-lamA (caddr (caddr (cadr (caddr dtr-rl-goal)))))
(define dtr-rl-lamB (caddr (caddr (caddr dtr-rl-goal))))
(dtr-iv! 'p 1 '(succ n))
(fact 'nn-le-refl 1)
(fact 'nn-one-le-succ 'n)
(fact 'interval-mem-intro 1 '(succ n) 1)
(use-em '(= p 1)
  ;; ---- row 1: the minors do not see it
  (lambda ()
    (dtr-rl-apply-lin! dtr-rl-lamA dtr-rl-lamB dtr-rl-lamC
      (lambda (v)
        (dtr-cof-type! 'A v 'n)
        (dtr-cof-type! 'B v 'n)
        (dtr-cof-type! 'C v 'n)
        (fact 'dtr-minor1-congr 'R 'n 'C 'A 'p v)
        (fact 'dtr-minor1-congr 'R 'n 'B 'A 'p v)
        (subst (list '= (list 'MINOR 'C 1 v 'n) (list 'MINOR 'A 1 v 'n)))
        (subst (list '= (list 'MINOR 'B 1 v 'n) (list 'MINOR 'A 1 v 'n)))
        (dk-apply! dtr-rl-hP v)
        (let ((e1 (list '= (list 'ENTRY 'C 1 v)
                        (list '(ADD R) (list '(MUL R) 'dsc_ (list 'ENTRY 'A 1 v))
                              (list 'ENTRY 'B 1 v)))))
          (dk-have! e1 (lambda () (subst '(= 1 p)) (ass)))
          (subst e1))
        (fact 'dtr-ring-lin1 'R (dtr-sign (list 'succ v)) (list 'ENTRY 'A 1 v)
              (list 'ENTRY 'B 1 v) 'dsc_ (list 'DET 'R 'n (list 'MINOR 'A 1 v 'n)))
        (ass))))
  ;; ---- row succ q >= 2: the induction hypothesis on the first-row minors
  (lambda ()
    (let* ((q (dtr-pred! 'p 'n)))
      (fact 'neq-sym 'p 1)
      (dtr-rl-apply-lin! dtr-rl-lamA dtr-rl-lamB dtr-rl-lamC
        (lambda (v) (dtr-rl-step2-eq! v q))))))
(dtr-done! 'det-row-linear-ind)
(topic! 'det-row-linear-ind 'algebra)

;;; headline: linearity in each row, quantifiers in the natural order.
(sp (make-wff
  (forall-guarded '(R n A B C p sc)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) '(IN A (MAT n n (CARR R)))
          '(IN B (MAT n n (CARR R))) '(IN C (MAT n n (CARR R)))
          '(IN p (INTERVAL 1 n)) '(IN sc (CARR R))
          (dtr-rowhyp 'B 'A 'p 'n) (dtr-rowhyp 'C 'A 'p 'n) (dtr-combhyp 'C 'A 'B 'p 'sc 'n))
    '(= (DET R n C) ((ADD R) ((MUL R) sc (DET R n A)) (DET R n B))))))
(dk-peel!)
(fact 'det-row-linear-ind 'n 'R 'A 'B 'C 'p 'sc)
(ass)
(dtr-done! 'det-row-linear)
(topic! 'det-row-linear 'algebra)
(gloss! 'det-row-linear
  "The determinant is linear in each row: if C agrees with A and with B off row p,
   and row p of C is sc times row p of A plus row p of B, then
   det C = sc det A + det B (commutative ring).")

;;; =====================================================================
;;; (6) toward ALTERNATING: the sign recursion, the double minor, the
;;; antisymmetric double sum.
;;; =====================================================================
;; IF resolution from the context: resolve every IF whose condition (or its
;; negation) is an assumption, innermost conditions first by iteration.
(define (dtr-find-decided-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)
              (or (dk-asm? (cadr e)) (dk-asm? (list 'NOT (cadr e)))))
         (cons (dk-asm? (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((dtr-find-decided-if (car l)))
                    (#t (loop (cdr l))))))))
(define (dtr-if-auto!)
  (let loop ()
    (let ((hit (dtr-find-decided-if (dk-goal))))
      (if hit (begin (dtr-if-branch! (car hit) (cdr hit) (lambda () #t)) (loop))))))

;; sigma(succ x) = (-1) sigma(x)
(sp (make-wff
  (forall-guarded '(R dmx_) '((IS-RING R) (IN dmx_ NN))
    (list '= (dtr-sign '(succ dmx_)) (list '(MUL R) dtr-neg1 (dtr-sign 'dmx_))))))
(dk-peel!)
(mac 'mpow-succ)
(fact 'rmm-op 'R)
(subst (list '= (list 'OPR dtr-mm) '(MUL R)))
(fact 'dtr-sign-type 'R 'dmx_)
(fact 'ring-one-in 'R)
(fact 'ring-neg-in-carr 'R '(ONE R))
(fact 'ring-carrier-closed-mul 'R dtr-neg1 (dtr-sign 'dmx_))
(rfl)
(dtr-done! 'dtr-sign-succ)
(topic! 'dtr-sign-succ 'plumbing)

;; the DOUBLE first-row minor is symmetric in the two deleted columns:
;; deleting column j then (the new) column k, j <= k, is deleting column
;; succ k then column j.
(define dtr-mm-stmt
  (forall-guarded '(R n A dmj_ dmk_)
    '((IS-RING R) (IN n NN) (IN A (MAT (succ (succ n)) (succ (succ n)) (CARR R)))
      (IN dmj_ NN) (IN dmk_ NN) (<= 1 dmj_) (<= dmj_ dmk_) (<= dmk_ (succ n)))
    '(= (MINOR (MINOR A 1 dmj_ (succ n)) 1 dmk_ n)
        (MINOR (MINOR A 1 (succ dmk_) (succ n)) 1 dmj_ n))))
(sp (make-wff dtr-mm-stmt))
(dk-peel!)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed 'dmk_)
(define dtr-mm-L1 '(MINOR A 1 dmj_ (succ n)))
(define dtr-mm-R1 '(MINOR A 1 (succ dmk_) (succ n)))
(fact 'minor-type 'R 'A 1 'dmj_ '(succ n))
(fact 'minor-type 'R 'A 1 '(succ dmk_) '(succ n))
(fact 'minor-type 'R dtr-mm-L1 1 'dmk_ 'n)
(fact 'minor-type 'R dtr-mm-R1 1 'dmj_ 'n)
(detach-with! (dk-fact! 'matrix-entry-extensionality 'n 'n '(CARR R)
                        (list 'MINOR dtr-mm-L1 1 'dmk_ 'n) (list 'MINOR dtr-mm-R1 1 'dmj_ 'n))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (u (caddr (cadr g))) (w (cadddr (cadr g))))
      (dtr-iv! u 1 'n)
      (dtr-iv! w 1 'n)
      ;; outer minors
      (fact 'dtr-minor1-entry 'R 'n dtr-mm-L1 'dmk_ u w)
      (fact 'dtr-minor1-entry 'R 'n dtr-mm-R1 'dmj_ u w)
      (subst (list '= (list 'ENTRY (list 'MINOR dtr-mm-L1 1 'dmk_ 'n) u w)
                   (list 'ENTRY dtr-mm-L1 (list 'succ u) (dtr-skip w 'dmk_))))
      (subst (list '= (list 'ENTRY (list 'MINOR dtr-mm-R1 1 'dmj_ 'n) u w)
                   (list 'ENTRY dtr-mm-R1 (list 'succ u) (dtr-skip w 'dmj_))))
      ;; inner minors
      (fact 'dtr-succ-in 'n u)
      (fact 'dtr-skip-in 'n 'dmk_ w)
      (fact 'dtr-skip-in 'n 'dmj_ w)
      (fact 'dtr-minor1-entry 'R '(succ n) 'A 'dmj_ (list 'succ u) (dtr-skip w 'dmk_))
      (fact 'dtr-minor1-entry 'R '(succ n) 'A '(succ dmk_) (list 'succ u) (dtr-skip w 'dmj_))
      (subst (list '= (list 'ENTRY dtr-mm-L1 (list 'succ u) (dtr-skip w 'dmk_))
                   (list 'ENTRY 'A (list 'succ (list 'succ u)) (dtr-skip (dtr-skip w 'dmk_) 'dmj_))))
      (subst (list '= (list 'ENTRY dtr-mm-R1 (list 'succ u) (dtr-skip w 'dmj_))
                   (list 'ENTRY 'A (list 'succ (list 'succ u)) (dtr-skip (dtr-skip w 'dmj_) '(succ dmk_)))))
      (fact 'dtr-succ-in '(succ n) (list 'succ u))
      (let* ((terms (list w 'dmj_ 'dmk_ 'n (list 'succ w) (list 'succ 'dmk_) '(succ n)))
             (base  (list (list '<= 1 w) (list '<= w 'n) '(<= 1 dmj_) '(<= dmj_ dmk_)
                          '(<= dmk_ (succ n))))
             (close! (lambda (col)
                       (dtr-in-iv! col 1 '(succ (succ n))
                                   (append terms (list (list 'succ (list 'succ w))
                                                       '(succ (succ n))))
                                   base)
                       (fact 'entry-in-carrier '(succ (succ n)) '(succ (succ n)) '(CARR R) 'A
                             (list 'succ (list 'succ u)) col)
                       (rfl))))
        (fact 'nn-succ-closed w)
        (fact 'nn-succ-closed (list 'succ w))
        (use-em (list '< w 'dmj_)
          (lambda ()
            (dtr-nn-have! (list '< w 'dmk_) terms (cons (list '< w 'dmj_) base))
            (dtr-nn-have! (list '< w '(succ dmk_)) terms (cons (list '< w 'dmj_) base))
            (dtr-if-auto!)
            (close! w))
          (lambda ()
            (fact 'nn-not-lt-le w 'dmj_)
            (use-em (list '< w 'dmk_)
              (lambda ()
                (dtr-nn-have! (list '< (list 'succ w) '(succ dmk_)) terms
                              (cons (list '< w 'dmk_) base))
                (dtr-if-auto!)
                (close! (list 'succ w)))
              (lambda ()
                (fact 'nn-not-lt-le w 'dmk_)
                (dtr-nn-have! (list 'NOT (list '< (list 'succ w) 'dmj_)) terms
                              (cons (list '<= 'dmk_ w) base))
                (dtr-nn-have! (list 'NOT (list '< (list 'succ w) '(succ dmk_))) terms
                              (cons (list '<= 'dmk_ w) base))
                (dtr-if-auto!)
                (close! (list 'succ (list 'succ w)))))))))))
(ass)
(dtr-done! 'dtr-minor-minor)
(topic! 'dtr-minor-minor 'algebra)

;; (dtr-fun! LAM DOM COD THUNK) -- land (IN LAM (FUN DOM COD)): lam-t, peel the
;; point v, beta, then (THUNK v) closes the pointwise typing.
(define (dtr-fun! lam dom cod thunk)
  (dtr-have! (list 'IN lam (list 'FUN dom cod))
    (lambda ()
      (dk-lam-t!)
      (let ((v (dk-di-var!)))
        (dtr-beta!)
        (thunk v)))))

;; (dtr-widen! V LO HI HI2 TERMS) -- from (IN V (INTERVAL LO HI)) land
;; (IN V (INTERVAL LO HI2)), HI <= HI2 decided by ineq over TERMS.
(define (dtr-widen! v lo hi hi2 terms)
  (dtr-iv! v lo hi)
  (dtr-in-iv! v lo hi2 (cons v terms) (list (list '<= lo v) (list '<= v hi))))

;;; the antisymmetric double sum vanishes:
;;;   sum_{a=1}^{N+1} sum_{b=1}^{N} ff(a,b) = 0  when  ff(succ k, j) = - ff(j, k)
;;; for 1 <= j <= k <= N.  (The pairing (j,k) <-> (succ k, j) is a bijection
;;; between the index pairs with j <= k and those with j > k; the proof is the
;;; induction on N that adds the last column and the last row together.)
(define (dtr-ds-typ N)
  (list 'FORALL 'dsj_ (list 'IMPLIES (list 'IN 'dsj_ (list 'INTERVAL 1 (list 'succ N)))
    (list 'FORALL 'dsk_ (list 'IMPLIES (list 'IN 'dsk_ (list 'INTERVAL 1 N))
      '(IN (ff dsj_ dsk_) (CARR R)))))))
(define (dtr-ds-anti N)
  (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ NN)
    (list 'FORALL 'dsk_ (list 'IMPLIES '(IN dsk_ NN)
      (list 'IMPLIES '(<= 1 dsj_) (list 'IMPLIES '(<= dsj_ dsk_)
        (list 'IMPLIES (list '<= 'dsk_ N)
          '(= (ff (succ dsk_) dsj_) ((NEG R) (ff dsj_ dsk_)))))))))))
(define (dtr-ds-sum N)
  (list 'FINSUM dtr-ag
    (list 'VNB-LAMBDA 'dsa_ (list 'INTERVAL 1 (list 'succ N))
      (list 'FINSUM dtr-ag (list 'VNB-LAMBDA 'dsb_ (list 'INTERVAL 1 N) '(ff dsa_ dsb_))
            (list 'INTERVAL 1 N)))
    (list 'INTERVAL 1 (list 'succ N))))
(define (dtr-ds-body N)
  (forall-guarded '(R ff)
    (list '(IS-COMMUTATIVE-RING R) (dtr-ds-typ N) (dtr-ds-anti N))
    (list '= (dtr-ds-sum N) '(ZERO R))))

;; (x + y) + z with x = 0 is y + z
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(dry_ drz_) (dtr-carr-guards '(dry_ drz_))
      '(= ((ADD R) ((ADD R) (ZERO R) dry_) drz_) ((ADD R) dry_ drz_)))))))
(dk-peel!)
(crs)
(dtr-done! 'dtr-ring-zero-add)
(topic! 'dtr-ring-zero-add 'plumbing)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dtr-ds-body 'n)))))
(define dtr-ds-ind (use-induction))
;; ---- base: the inner sums are over [1,0], empty
(dk-focus! (cdr (assq 'base dtr-ds-ind)))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-id 'R)
(fact 'nn-zero-in)
(fact 'nn-one-in)
(fact 'nn-succ-closed 0)
(fact 'interval-in-set 1 '(succ 0))
(fact 'interval-card-in-nn 1 '(succ 0))
(fact 'interval-1-0-empty)
(subst '(= (INTERVAL 1 0) EMPTY-SET))
(let ((res (dtr-chain! (dk-fact! 'finsum-all-id-ptwise dtr-ag '(INTERVAL 1 (succ 0))
                                 (caddr (cadr (dk-goal))))
             (lambda (ante)
               (lambda ()
                 (let ((v (dk-di-var!)))
                   (dtr-beta!)
                   (mac 'finsum-empty)
                   (dtr-have! (dk-goal) (lambda () (rfl)))))))))
  (subst res)
  (subst (list '= (list 'IDEN dtr-ag) '(ZERO R)))
  (fact 'ring-zero-in 'R)
  (rfl))
;; ---- step
(dk-focus! (cdr (assq 'step dtr-ds-ind)))
(define dtr-ds-ih (cdr (assq 'ih dtr-ds-ind)))
(dk-peel!)
(define dtr-ds-T (dtr-ds-typ '(succ n)))
(define dtr-ds-S (dtr-ds-anti '(succ n)))
(if (not (and (dk-asm? dtr-ds-T) (dk-asm? dtr-ds-S)))
    (error "dtr-dsum step: hypotheses not landed"))
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-id 'R)
(fact 'ras-op 'R)
(fact 'ras-carr 'R)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed '(succ n))
(define dtr-I1 '(INTERVAL 1 (succ n)))
(define dtr-I2 '(INTERVAL 1 (succ (succ n))))
(define dtr-I0 '(INTERVAL 1 n))
(for-each (lambda (b) (fact 'interval-in-set 1 b) (fact 'interval-card-in-nn 1 b))
          '(n (succ n) (succ (succ n))))
(define dtr-ds-terms '(n (succ n) (succ (succ n))))
;; ff(j,k) typed for j in [1, succ succ n], k in [1, succ n]
(define (dtr-ds-ff-type! j k)
  (dk-apply! (dk-apply! dtr-ds-T j) k))
;; transfer a typing between CARR ag and CARR R
(define (dtr-carr-R! t)
  (dk-have! (list 'IN t '(CARR R))
    (lambda () (subst (list '= '(CARR R) (list 'CARR dtr-ag))) (ass))))
(define (dtr-carr-ag! t)
  (dk-have! (list 'IN t (list 'CARR dtr-ag))
    (lambda () (subst (list '= (list 'CARR dtr-ag) '(CARR R))) (ass))))
;; close a goal (IN t (CARR ag)) or (IN t (CARR R)) from the context
(define (dtr-close-carr!)
  (let ((g (dk-goal)))
    (if (equal? (caddr g) (list 'CARR dtr-ag))
        (subst (list '= (list 'CARR dtr-ag) '(CARR R))))
    (ass)))
(define dtr-ds-outer (caddr (cadr (dk-goal))))
;; (1) the outer summand is a function I2 -> CARR ag
(define (dtr-ds-inner-fun! v dom)       ; (VNB-LAMBDA dsb_ DOM (ff v dsb_)) : DOM -> CARR ag
  (dtr-fun! (list 'VNB-LAMBDA 'dsb_ dom (list 'ff v 'dsb_)) dom (list 'CARR dtr-ag)
    (lambda (k)
      (if (equal? dom dtr-I0) (dtr-widen! k 1 'n '(succ n) dtr-ds-terms))
      (dtr-ds-ff-type! v k)
      (dtr-close-carr!))))
(dtr-fun! dtr-ds-outer dtr-I2 (list 'CARR dtr-ag)
  (lambda (v)
    (dtr-ds-inner-fun! v dtr-I1)
    (fact 'finsum-type dtr-ag dtr-I1 (list 'VNB-LAMBDA 'dsb_ dtr-I1 (list 'ff v 'dsb_)))
    (ass)))
;; (2) peel the last row a = succ succ n
(define dtr-ds-p1 (dk-fact! 'finsum-interval-peel dtr-ag '(succ n) dtr-ds-outer))
(subst dtr-ds-p1)
;; (3) the remaining rows, each peeled at its last column
(define dtr-ds-G
  (list 'VNB-LAMBDA 'dsa_ dtr-I1
    (list 'FINSUM dtr-ag (list 'VNB-LAMBDA 'dsb_ dtr-I0 '(ff dsa_ dsb_)) dtr-I0)))
(define dtr-ds-H (list 'VNB-LAMBDA 'dsa_ dtr-I1 '(ff dsa_ (succ n))))
(dtr-fun! dtr-ds-G dtr-I1 (list 'CARR dtr-ag)
  (lambda (v)
    (dtr-widen! v 1 '(succ n) '(succ (succ n)) dtr-ds-terms)
    (dtr-ds-inner-fun! v dtr-I0)
    (fact 'finsum-type dtr-ag dtr-I0 (list 'VNB-LAMBDA 'dsb_ dtr-I0 (list 'ff v 'dsb_)))
    (ass)))
(dtr-fun! dtr-ds-H dtr-I1 (list 'CARR dtr-ag)
  (lambda (v)
    (dtr-widen! v 1 '(succ n) '(succ (succ n)) dtr-ds-terms)
    (dtr-in-iv! '(succ n) 1 '(succ n) dtr-ds-terms '())
    (dtr-ds-ff-type! v '(succ n))
    (dtr-close-carr!)))
(define dtr-ds-add (dk-fact! 'finsum-add-ag dtr-ag dtr-I1 dtr-ds-G dtr-ds-H))
(define dtr-ds-Ladd (caddr (cadr dtr-ds-add)))
(have! (list 'FORALL 'dsz_ (list 'IMPLIES (list 'IN 'dsz_ dtr-I1)
         (list '= (list dtr-ds-outer 'dsz_) (list dtr-ds-Ladd 'dsz_))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (dtr-widen! v 1 '(succ n) '(succ (succ n)) dtr-ds-terms)
      (dtr-beta!)
      (let ((L1 (list 'VNB-LAMBDA 'dsb_ dtr-I1 (list 'ff v 'dsb_)))
            (L0 (list 'VNB-LAMBDA 'dsb_ dtr-I0 (list 'ff v 'dsb_))))
        (dtr-ds-inner-fun! v dtr-I1)
        (dtr-ds-inner-fun! v dtr-I0)
        (subst (dk-fact! 'finsum-interval-peel dtr-ag 'n L1))
        (dtr-in-iv! '(succ n) 1 '(succ n) dtr-ds-terms '())
        (dtr-beta!)
        (have! (list 'FORALL 'dsw_ (list 'IMPLIES (list 'IN 'dsw_ dtr-I0)
                 (list '= (list L1 'dsw_) (list L0 'dsw_))))
          (lambda ()
            (let ((k (dk-di-var!)))
              (dtr-widen! k 1 'n '(succ n) dtr-ds-terms)
              (dtr-beta!)
              (dtr-ds-ff-type! v k)
              (rfl))))
        (subst (dk-fact! 'finsum-congruence-q dtr-ag dtr-I0 L1 L0))
        (fact 'finsum-type dtr-ag dtr-I0 L0)
        (dtr-carr-R! (list 'FINSUM dtr-ag L0 dtr-I0))
        (dtr-ds-ff-type! v '(succ n))
        (dtr-carr-ag! (list 'ff v '(succ n)))
        (fact 'ring-add-closed 'R (list 'FINSUM dtr-ag L0 dtr-I0) (list 'ff v '(succ n)))
        (rfl)))))
(subst (dk-fact! 'finsum-congruence-q dtr-ag dtr-I1 dtr-ds-outer dtr-ds-Ladd))
(subst dtr-ds-add)
;; (4) the induction hypothesis kills the sum of the G's
(define dtr-ds-ihres
  (dtr-chain! (inst*! dtr-ds-ih 'R 'ff)
    (lambda (ante)
      (if (not (eq? (caddr (cadr (caddr ante))) 'NN))
          ;; typing at n
          (lambda ()
            (let* ((hs (dk-peel!)) (fk (cadr (dk-goal))) (j (cadr fk)) (k (caddr fk)))
              (dtr-widen! j 1 '(succ n) '(succ (succ n)) dtr-ds-terms)
              (dtr-widen! k 1 'n '(succ n) dtr-ds-terms)
              (dk-apply! (dk-apply! dtr-ds-T j) k)
              (ass)))
          ;; antisymmetry at n
          (lambda ()
            (let* ((hs (dk-peel!))
                   (j (caddr (find-first (lambda (f) (and (eq? (car f) '<=) (eqv? (cadr f) 1))) hs)))
                   (k (cadr (find-first (lambda (f) (and (eq? (car f) '<=) (eq? (caddr f) 'n))) hs))))
              (dtr-nn-have! (list '<= k '(succ n)) (list k 'n '(succ n)) (list (list '<= k 'n)))
              (dk-apply! dtr-ds-S j k)
              (ass)))))))
(subst dtr-ds-ihres)
;; (5) the last column and the last row cancel termwise
(dtr-in-iv! '(succ (succ n)) 1 '(succ (succ n)) dtr-ds-terms '())
(dtr-beta!)
(define dtr-ds-K (list 'VNB-LAMBDA 'dsb_ dtr-I1 '(ff (succ (succ n)) dsb_)))
(dtr-fun! dtr-ds-K dtr-I1 (list 'CARR dtr-ag)
  (lambda (v) (dtr-ds-ff-type! '(succ (succ n)) v) (dtr-close-carr!)))
(define dtr-ds-add2 (dk-fact! 'finsum-add-ag dtr-ag dtr-I1 dtr-ds-H dtr-ds-K))
(define dtr-ds-zero
  (dtr-chain! (dk-fact! 'finsum-all-id-ptwise dtr-ag dtr-I1 (caddr (cadr dtr-ds-add2)))
    (lambda (ante)
      (lambda ()
        (let ((v (dk-di-var!)))
          (dtr-widen! v 1 '(succ n) '(succ (succ n)) dtr-ds-terms)
          (dtr-beta!)
          (dtr-iv! v 1 '(succ n))
          (fact 'nn-le-refl '(succ n))
          (dk-apply! dtr-ds-S v '(succ n))
          (subst (list '= (list 'ff '(succ (succ n)) v) (list '(NEG R) (list 'ff v '(succ n)))))
          (dtr-in-iv! '(succ n) 1 '(succ n) dtr-ds-terms '())
          (dtr-ds-ff-type! v '(succ n))
          (subst (list '= (list 'OPR dtr-ag) '(ADD R)))
          (subst (list '= (list 'IDEN dtr-ag) '(ZERO R)))
          (fact 'ring-add-right-inv 'R (list 'ff v '(succ n)))
          (ass))))))
(define dtr-ds-FH (list 'FINSUM dtr-ag dtr-ds-H dtr-I1))
(define dtr-ds-FK (list 'FINSUM dtr-ag dtr-ds-K dtr-I1))
(fact 'finsum-type dtr-ag dtr-I1 dtr-ds-H)
(fact 'finsum-type dtr-ag dtr-I1 dtr-ds-K)
(dk-have! (list '= (list '(ADD R) dtr-ds-FH dtr-ds-FK) '(ZERO R))
  (lambda ()
    (subst (list '= '(ADD R) (list 'OPR dtr-ag)))
    (subst (list '= '(ZERO R) (list 'IDEN dtr-ag)))
    (subst (list '= (caddr dtr-ds-add2) (cadr dtr-ds-add2)))
    (ass)))
(subst (list '= (list 'OPR dtr-ag) '(ADD R)))
(dk-have! (list 'IN dtr-ds-FH '(CARR R)) (lambda () (subst (list '= '(CARR R) (list 'CARR dtr-ag))) (ass)))
(dk-have! (list 'IN dtr-ds-FK '(CARR R)) (lambda () (subst (list '= '(CARR R) (list 'CARR dtr-ag))) (ass)))
(fact 'dtr-ring-zero-add 'R dtr-ds-FH dtr-ds-FK)
(subst (list '= (list '(ADD R) (list '(ADD R) '(ZERO R) dtr-ds-FH) dtr-ds-FK)
             (list '(ADD R) dtr-ds-FH dtr-ds-FK)))
(ass)
(dtr-done! 'dtr-dsum-anti)
(topic! 'dtr-dsum-anti 'algebra)

;;; =====================================================================
;;; (7) THE CRUX: rows 1 and 2 equal give det = 0.  Expanding along row 1 and
;;; then each first-row minor along ITS row 1 (= row 2 of A) writes det A as the
;;; double sum of W(j,k) = s_j a_{1j} s_k a_{2,skip(k,j)} det(A deleting rows
;;; 1,2 and columns j, skip(k,j)); with a_{2.} = a_{1.} the double minor is
;;; symmetric (dtr-minor-minor) and the signs are opposite (dtr-sign-succ), so
;;; W(succ k, j) = - W(j, k) for j <= k, and dtr-dsum-anti gives 0.
;;; =====================================================================
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drs_ drt_ dra_ drb_ drd_) (dtr-carr-guards '(drs_ drt_ dra_ drb_ drd_))
      (list '= (list '(MUL R) (list '(MUL R) dtr-neg1 'drt_)
                     '((MUL R) drb_ ((MUL R) drs_ ((MUL R) dra_ drd_))))
               '((NEG R) ((MUL R) drs_ ((MUL R) dra_ ((MUL R) drt_ ((MUL R) drb_ drd_)))))))))))
(dk-peel!)
(crs)
(dtr-done! 'dtr-ring-anti)
(topic! 'dtr-ring-anti 'plumbing)

(define dtr-c-I1 '(INTERVAL 1 (succ n)))
(define dtr-c-I2 '(INTERVAL 1 (succ (succ n))))
(define (dtr-c-MJ j) (list 'MINOR 'A 1 j '(succ n)))
(define (dtr-c-W j k)
  (list '(MUL R) (dtr-sign (list 'succ j))
    (list '(MUL R) (list 'ENTRY 'A 1 j)
      (list '(MUL R) (dtr-sign (list 'succ k))
        (list '(MUL R) (list 'ENTRY (dtr-c-MJ j) 1 k)
          (list 'DET 'R 'n (list 'MINOR (dtr-c-MJ j) 1 k 'n)))))))
(define dtr-c-ff
  (list 'VNB-LAMBDA '(LIST dwj_ dwk_) (list 'CARTESIAN dtr-c-I2 dtr-c-I1) (dtr-c-W 'dwj_ 'dwk_)))
(define dtr-c-terms '(n (succ n) (succ (succ n))))

;; type W(j,k) and its pieces, j in I2, k in I1 (both already typed)
(define (dtr-c-W-type! j k)
  (dtr-iv! j 1 '(succ (succ n)))
  (dtr-iv! k 1 '(succ n))
  (fact 'nn-succ-closed j)
  (fact 'nn-succ-closed k)
  (fact 'dtr-sign-type 'R (list 'succ j))
  (fact 'dtr-sign-type 'R (list 'succ k))
  (fact 'entry-in-carrier '(succ (succ n)) '(succ (succ n)) '(CARR R) 'A 1 j)
  (fact 'minor-type 'R 'A 1 j '(succ n))
  (fact 'entry-in-carrier '(succ n) '(succ n) '(CARR R) (dtr-c-MJ j) 1 k)
  (fact 'minor-type 'R (dtr-c-MJ j) 1 k 'n)
  (fact 'det-in-carrier 'R 'n (list 'MINOR (dtr-c-MJ j) 1 k 'n))
  (let* ((w  (dtr-c-W j k))
         (w1 (caddr w)) (w2 (caddr w1)) (w3 (caddr w2)))
    (fact 'ring-carrier-closed-mul 'R (cadr w3) (caddr w3))
    (fact 'ring-carrier-closed-mul 'R (cadr w2) w3)
    (fact 'ring-carrier-closed-mul 'R (cadr w1) w2)
    (fact 'ring-carrier-closed-mul 'R (cadr w) w1)))

(define dtr-rows12-stmt
  (forall-guarded '(n R A)
    '((IN n NN) (IS-COMMUTATIVE-RING R)
      (IN A (MAT (succ (succ n)) (succ (succ n)) (CARR R)))
      (FORALL drk_ (IMPLIES (IN drk_ (INTERVAL 1 (succ (succ n))))
        (= (ENTRY A 1 drk_) (ENTRY A 2 drk_)))))
    '(= (DET R (succ (succ n)) A) (ZERO R))))
(sp (make-wff dtr-rows12-stmt))
(define dtr-c-hyps (dk-peel!))
(define dtr-c-hrow (find-first (dk-head? 'FORALL) dtr-c-hyps))
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-id 'R)
(fact 'ras-op 'R)
(fact 'ras-carr 'R)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed '(succ n))
(for-each (lambda (b) (fact 'interval-in-set 1 b) (fact 'interval-card-in-nn 1 b))
          '((succ n) (succ (succ n))))
(have! '(= (succ 1) 2) (lambda () (arith)))
(dtr-in-iv! 1 1 '(succ n) dtr-c-terms '())
(dtr-in-iv! 1 1 '(succ (succ n)) dtr-c-terms '())
(mac 'det-cofactor)
(define dtr-c-L (caddr (cadr (dk-goal))))
;; the double sum vanishes
(define dtr-c-S0
  (dtr-chain! (dk-fact! 'dtr-dsum-anti '(succ n) 'R dtr-c-ff)
    (lambda (ante)
      (if (not (eq? (caddr (cadr (caddr ante))) 'NN))
          ;; typing
          (lambda ()
            (dk-peel!)
            (let* ((fk (cadr (dk-goal))) (j (cadr fk)) (k (caddr fk)))
              (dtr-beta!)
              (dtr-c-W-type! j k)
              (ass)))
          ;; antisymmetry
          (lambda ()
            (let* ((hs (dk-peel!))
                   (j (caddr (find-first (lambda (f) (and (eq? (car f) '<=) (eqv? (cadr f) 1))) hs)))
                   (k (cadr (find-first (lambda (f) (and (eq? (car f) '<=) (equal? (caddr f) '(succ n)))) hs)))
                   (tms (append (list j k (list 'succ k)) dtr-c-terms))
                   (prs (list (list '<= 1 j) (list '<= j k) (list '<= k '(succ n)))))
              (fact 'nn-succ-closed k)
              (dtr-in-iv! j 1 '(succ n) tms prs)
              (dtr-in-iv! j 1 '(succ (succ n)) tms prs)
              (dtr-in-iv! k 1 '(succ n) tms prs)
              (dtr-in-iv! (list 'succ k) 1 '(succ (succ n)) tms prs)
              (dtr-beta!)
              (dtr-c-W-type! j k)
              (dtr-c-W-type! (list 'succ k) j)
              ;; the two row-2 entries
              (fact 'dtr-minor1-entry 'R '(succ n) 'A (list 'succ k) 1 j)
              (fact 'dtr-minor1-entry 'R '(succ n) 'A j 1 k)
              (subst (list '= (list 'ENTRY (dtr-c-MJ (list 'succ k)) 1 j)
                           (list 'ENTRY 'A '(succ 1) (dtr-skip j (list 'succ k)))))
              (subst (list '= (list 'ENTRY (dtr-c-MJ j) 1 k)
                           (list 'ENTRY 'A '(succ 1) (dtr-skip k j))))
              (dtr-nn-have! (list '< j (list 'succ k)) tms prs)
              (dtr-nn-have! (list 'NOT (list '< k j)) tms prs)
              (dtr-if-auto!)
              (subst '(= (succ 1) 2))
              (dk-apply! dtr-c-hrow j)
              (dk-apply! dtr-c-hrow (list 'succ k))
              (subst (list '= (list 'ENTRY 'A 2 j) (list 'ENTRY 'A 1 j)))
              (subst (list '= (list 'ENTRY 'A 2 (list 'succ k)) (list 'ENTRY 'A 1 (list 'succ k))))
              ;; the double minors, the sign
              (fact 'dtr-minor-minor 'R 'n 'A j k)
              (subst (list '= (list 'MINOR (dtr-c-MJ j) 1 k 'n)
                           (list 'MINOR (dtr-c-MJ (list 'succ k)) 1 j 'n)))
              (fact 'dtr-sign-succ 'R (list 'succ k))
              (subst (list '= (dtr-sign (list 'succ (list 'succ k)))
                           (list '(MUL R) dtr-neg1 (dtr-sign (list 'succ k)))))
              (fact 'entry-in-carrier '(succ (succ n)) '(succ (succ n)) '(CARR R) 'A 1 (list 'succ k))
              (fact 'dtr-ring-anti 'R (dtr-sign (list 'succ j)) (dtr-sign (list 'succ k))
                    (list 'ENTRY 'A 1 j) (list 'ENTRY 'A 1 (list 'succ k))
                    (list 'DET 'R 'n (list 'MINOR (dtr-c-MJ (list 'succ k)) 1 j 'n)))
              (ass)))))))
(define dtr-c-outerS (caddr (cadr dtr-c-S0)))
;; the defining expansion IS that double sum
(have! (list 'FORALL 'dsz_ (list 'IMPLIES (list 'IN 'dsz_ dtr-c-I2)
         (list '= (list dtr-c-L 'dsz_) (list dtr-c-outerS 'dsz_))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (dtr-beta!)
      (dtr-iv! j 1 '(succ (succ n)))
      (fact 'minor-type 'R 'A 1 j '(succ n))
      (mac 'det-cofactor)
      (let* ((g (dk-goal))
             (lhs (cadr g))                          ; s_j * (a_1j * FINSUM(ag, Lj, I1))
             (fin (caddr (caddr lhs)))
             (Lj (caddr fin))
             (aj (list 'ENTRY 'A 1 j))
             (sj (dtr-sign (list 'succ j))))
        (fact 'nn-succ-closed j)
        (fact 'dtr-sign-type 'R (list 'succ j))
        (fact 'entry-in-carrier '(succ (succ n)) '(succ (succ n)) '(CARR R) 'A 1 j)
        (dtr-fun! Lj dtr-c-I1 '(CARR R)
          (lambda (k)
            (dtr-cof-type! (dtr-c-MJ j) k 'n)
            (ass)))
        (define d1 (dk-fact! 'finsum-ring-distrib-left-gen 'R aj dtr-c-I1 Lj))
        (subst d1)
        (let ((L1 (caddr (caddr d1))))
          (dtr-fun! L1 dtr-c-I1 '(CARR R)
            (lambda (k)
              (dtr-cof-type! (dtr-c-MJ j) k 'n)
              (fact 'ring-carrier-closed-mul 'R aj (dtr-cof (dtr-c-MJ j) k 'n))
              (ass)))
          (define d2 (dk-fact! 'finsum-ring-distrib-left-gen 'R sj dtr-c-I1 L1))
          (subst d2)
          (let* ((L2 (caddr (caddr d2)))
                 (Rlam (caddr (caddr (dk-goal)))))
            (dtr-fun! L2 dtr-c-I1 (list 'CARR dtr-ag)
              (lambda (k)
                (dtr-c-W-type! j k)
                (dtr-close-carr!)))
            (fact 'finsum-type dtr-ag dtr-c-I1 L2)
            (have! (list 'FORALL 'dsw_ (list 'IMPLIES (list 'IN 'dsw_ dtr-c-I1)
                     (list '= (list L2 'dsw_) (list Rlam 'dsw_))))
              (lambda ()
                (let ((k (dk-di-var!)))
                  (dtr-beta!)
                  (dtr-c-W-type! j k)
                  (rfl))))
            (define d3 (dk-fact! 'finsum-congruence-q dtr-ag dtr-c-I1 L2 Rlam))
            (subst (list '= (caddr d3) (cadr d3)))
            (rfl)))))))
(subst (dk-fact! 'finsum-congruence-q dtr-ag dtr-c-I2 dtr-c-L dtr-c-outerS))
(ass)
(dtr-done! 'dtr-det-rows12)
(topic! 'dtr-det-rows12 'algebra)

;; the crux with the size given by an equation (so that a matrix TERM whose
;; entries mention the size need not be rewritten)
(sp (make-wff
  (forall-guarded '(m n R A)
    '((IN n NN) (= m (succ (succ n))) (IS-COMMUTATIVE-RING R)
      (IN A (MAT m m (CARR R)))
      (FORALL drk_ (IMPLIES (IN drk_ (INTERVAL 1 m))
        (= (ENTRY A 1 drk_) (ENTRY A 2 drk_)))))
    '(= (DET R m A) (ZERO R)))))
(dk-peel!)
(subst '(= m (succ (succ n))))
(dk-have! '(IN A (MAT (succ (succ n)) (succ (succ n)) (CARR R)))
  (lambda () (subst '(= (succ (succ n)) m)) (ass)))
(dk-have! '(FORALL drk_ (IMPLIES (IN drk_ (INTERVAL 1 (succ (succ n))))
             (= (ENTRY A 1 drk_) (ENTRY A 2 drk_))))
  (lambda () (subst '(= (succ (succ n)) m)) (ass)))
(fact 'dtr-det-rows12 'n 'R 'A)
(ass)
(dtr-done! 'dtr-det-rows12b)
(topic! 'dtr-det-rows12b 'algebra)

;;; =====================================================================
;;; (8) the alternating property at size n, as an ANTECEDENT (the induction
;;; hypothesis), and its first consequence: two equal rows, neither of them
;;; row 1, at size succ n.
;;; =====================================================================
(define (dtr-eqrows A p q n)       ; the support's own clause, binder k
  (list 'FORALL 'k (list 'IMPLIES (list 'IN 'k (list 'INTERVAL 1 n))
    (list '= (list 'ENTRY A p 'k) (list 'ENTRY A q 'k)))))
(define (dtr-alt-body n)
  (forall-guarded '(R A p q)
    (list '(IS-COMMUTATIVE-RING R) (list 'IN 'A (list 'MAT n n '(CARR R)))
          (list 'IN 'p (list 'INTERVAL 1 n)) (list 'IN 'q (list 'INTERVAL 1 n))
          '(NOT (= p q)) (dtr-eqrows 'A 'p 'q n))
    (list '= (list 'DET 'R n 'A) '(ZERO R))))

(define dtr-alt-low-stmt
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (dtr-alt-body 'n)
    (forall-guarded '(R A p q)
      (list '(IS-COMMUTATIVE-RING R) '(IN A (MAT (succ n) (succ n) (CARR R)))
            '(IN p (INTERVAL 1 (succ n))) '(IN q (INTERVAL 1 (succ n)))
            '(NOT (= p q)) '(NOT (= p 1)) '(NOT (= q 1)) (dtr-eqrows 'A 'p 'q '(succ n)))
      '(= (DET R (succ n) A) (ZERO R)))))))
(sp (make-wff dtr-alt-low-stmt))
(define dtr-al-hyps (dk-peel!))
(define dtr-al-ih (dtr-alt-body 'n))
(define dtr-al-eq (dtr-eqrows 'A 'p 'q '(succ n)))
(if (not (and (dk-asm? dtr-al-ih) (dk-asm? dtr-al-eq)))
    (error "dtr-alt-low: hypotheses not landed" dtr-al-hyps))
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-additive-ag-is-abelian-group 'R)
(fact 'ras-id 'R)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'interval-in-set 1 '(succ n))
(fact 'interval-card-in-nn 1 '(succ n))
(define dtr-al-p1 (dtr-pred! 'p 'n))
(define dtr-al-q1 (dtr-pred! 'q 'n))
(dtr-have! (list 'NOT (list '= dtr-al-p1 dtr-al-q1))
  (lambda ()
    (di)
    (have! '(= p q)
      (lambda ()
        (dtr-nn! (list 'p 'q dtr-al-p1 dtr-al-q1 (list 'succ dtr-al-p1) (list 'succ dtr-al-q1))
                 (list (list '= 'p (list 'succ dtr-al-p1)) (list '= 'q (list 'succ dtr-al-q1))
                       (list '= dtr-al-p1 dtr-al-q1)))))
    (ai '(NOT (= p q)))))
(mac 'det-cofactor)
(let ((res (dtr-chain! (dk-fact! 'finsum-all-id-ptwise dtr-ag '(INTERVAL 1 (succ n))
                                 (caddr (cadr (dk-goal))))
             (lambda (ante)
               (lambda ()
                 (let* ((v (dk-di-var!))
                        (MV (list 'MINOR 'A 1 v 'n)))
                   (dtr-beta!)
                   (dtr-cof-type! 'A v 'n)
                   (let ((d0 (dtr-chain! (inst*! dtr-al-ih 'R MV dtr-al-p1 dtr-al-q1)
                               (lambda (ante2)
                                 (lambda ()
                                   (let ((k (dk-di-var!)))
                                     (dtr-iv! k 1 'n)
                                     (dtr-m1! 'A v dtr-al-p1 k)
                                     (dtr-m1! 'A v dtr-al-q1 k)
                                     (subst (list '= (list 'succ dtr-al-p1) 'p))
                                     (subst (list '= (list 'succ dtr-al-q1) 'q))
                                     (fact 'dtr-skip-in 'n v k)
                                     (dk-apply! dtr-al-eq (dtr-skip k v))
                                     (ass)))))))
                     (subst d0)
                     (fact 'ring-mul-zero-right 'R (list 'ENTRY 'A 1 v))
                     (subst (list '= (list '(MUL R) (list 'ENTRY 'A 1 v) '(ZERO R)) '(ZERO R)))
                     (fact 'ring-mul-zero-right 'R (dtr-sign (list 'succ v)))
                     (subst (list '= (list '(MUL R) (dtr-sign (list 'succ v)) '(ZERO R)) '(ZERO R)))
                     (subst (list '= (list 'IDEN dtr-ag) '(ZERO R)))
                     (fact 'ring-zero-in 'R)
                     (rfl))))))))
  (subst res)
  (subst (list '= (list 'IDEN dtr-ag) '(ZERO R)))
  (fact 'ring-zero-in 'R)
  (rfl))
(dtr-done! 'dtr-alt-low)
(topic! 'dtr-alt-low 'algebra)

;;; =====================================================================
;;; (9) row 1 equal to a row q >= 2.  q = 2 is the crux.  For q >= 3, with
;;; x = row 1 = row q and y = row 2 of A, s = x + y, write [u, v] for the matrix
;;; A with row 2 := u and row q := v (so A = [y, x]).  Linearity (row q, then
;;; row 2) gives  det[s,s] = det[x,x] + det[y,x] + det[x,y] + det[y,y]; the
;;; left side and the last term vanish by dtr-alt-low (rows 2 and q equal), the
;;; first and third by the crux (rows 1 and 2 equal); hence det A = det[y,x] = 0.
;;; =====================================================================
;; the matrix [E2, Eq]: A with row 2 := E2 and row q := Eq (E in dtw_)
(define dtr-mI '(INTERVAL 1 (succ n)))
(define (dtr-mk-body E2 Eq) (list 'IF '(= dtv_ 2) E2 (list 'IF '(= dtv_ q) Eq '(ENTRY A dtv_ dtw_))))
(define (dtr-mk-G E2 Eq)
  (list 'VNB-LAMBDA '(LIST dtv_ dtw_) (list 'CARTESIAN dtr-mI dtr-mI) (dtr-mk-body E2 Eq)))
(define (dtr-mk E2 Eq) (list 'MATOF '(succ n) '(succ n) (dtr-mk-G E2 Eq)))
(define dtr-ex '(ENTRY A 1 dtw_))
(define dtr-ey '(ENTRY A 2 dtw_))
(define dtr-es '((ADD R) (ENTRY A 1 dtw_) (ENTRY A 2 dtw_)))
(define (dtr-tsubst e alist)             ; plain tree substitution (no binders inside)
  (cond ((assq e alist) => cdr)
        ((pair? e) (map (lambda (x) (dtr-tsubst x alist)) e))
        (#t e)))

;; (dtr-type-carr! T) -- land (IN T (CARR R)) for T built of ENTRY A _ _, ADD,
;; MUL, ONE, the indices already typed in [1, succ n].
(define (dtr-type-carr! t)
  (cond ((dk-asm? (list 'IN t '(CARR R))) #t)
        ((and (pair? t) (eq? (car t) 'ENTRY))
         (fact 'entry-in-carrier '(succ n) '(succ n) '(CARR R) (cadr t) (caddr t) (cadddr t)))
        ((equal? t '(ONE R)) (fact 'ring-one-in 'R))
        ((equal? t '(ZERO R)) (fact 'ring-zero-in 'R))
        ((and (pair? t) (equal? (car t) '(NEG R)))
         (dtr-type-carr! (cadr t)) (fact 'ring-neg-in-carr 'R (cadr t)))
        ((symbol? t) (if (not (dk-asm? (list 'IN t '(CARR R)))) (error "dtr-type-carr!: untyped" t)))
        ((and (pair? t) (equal? (car t) '(ADD R)))
         (dtr-type-carr! (cadr t)) (dtr-type-carr! (caddr t))
         (fact 'ring-add-closed 'R (cadr t) (caddr t)))
        ((and (pair? t) (equal? (car t) '(MUL R)))
         (dtr-type-carr! (cadr t)) (dtr-type-carr! (caddr t))
         (fact 'ring-carrier-closed-mul 'R (cadr t) (caddr t)))
        (#t (error "dtr-type-carr!: cannot type" t))))

;; goal (IN T C) with T an IF tower over typable leaves: split and type.
(define (dtr-if-type!)
  (let* ((g (dk-goal)) (t (cadr g)))
    (if (and (pair? t) (eq? (car t) 'IF))
        (dtr-case-if! t (lambda (b v) (dtr-if-type!)))
        (begin
          (dtr-type-carr! t)
          (if (eq? (caddr g) 'SET) (fact 'membership-implies-sethood t '(CARR R)))
          (ass)))))

;; (IN M (MAT (succ n) (succ n) (CARR R))) for M = (dtr-mk E2 Eq)
(define (dtr-mk-type! M)
  (dtr-have! (list 'IN M (list 'MAT '(succ n) '(succ n) '(CARR R)))
    (lambda ()
      (detach-with! (dk-fact! 'matof-in-mat '(succ n) '(succ n) '(CARR R) (cadddr M))
        (lambda () (dk-peel!) (dtr-beta!) (dtr-if-type!)))
      (ass))))

;; land (= (ENTRY M i k) body[i,k]) for M = (dtr-mk E2 Eq); return it
(define (dtr-mk-entry! M i k)
  (let* ((G (cadddr M))
         (body (dtr-tsubst (caddr (cdr G)) (list (cons 'dtv_ i) (cons 'dtw_ k))))
         (tgt (list '= (list 'ENTRY M i k) body)))
    (if (not (dk-asm? tgt))
        (let ((r (dk-fact! 'entry-of-matof '(succ n) '(succ n) G i k)))
          (if (and (pair? r) (eq? (car r) 'IMPLIES) (not (dk-asm? (cadr r))))
              (set! r (detach-with! r (lambda () (dk-peel!) (dtr-beta!) (dtr-if-type!)))))
          (let loop ()
            (if (and (pair? r) (eq? (car r) 'IMPLIES) (dk-asm? (cadr r)))
                (begin (set! r (dk-landed-1 (lambda () (detach! r)))) (loop))))
          (if (and (not (dk-asm? tgt)) (dk--redex? r)) (lam-b-h r))
          (if (not (dk-asm? tgt))
              (error "dtr-mk-entry!: read-off did not land" tgt (expression->string r)))))
    tgt))

;; rewrite every ENTRY of a constructed matrix in the goal
(define (dtr-find-mk-entry e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'ENTRY) (pair? (cadr e)) (eq? (car (cadr e)) 'MATOF)) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((dtr-find-mk-entry (car l)))
                    (#t (loop (cdr l))))))))
(define (dtr-mk-rewrite!)
  (let loop ()
    (let ((e (dtr-find-mk-entry (dk-goal))))
      (if e (begin (subst (dtr-mk-entry! (cadr e) (caddr e) (cadddr e))) (loop))))))

;; close (= L R) after the rewrite: 1 x + y is x + y; the index equations
;; in context are substituted; a row-q entry of A goes to row 1 by H1Q; rfl.
(define (dtr-mk-close! h1q i k)
  (let ((g (dk-goal)))
    (if (and (pair? (caddr g)) (equal? (car (caddr g)) '(ADD R)) (pair? (cadr (caddr g)))
             (equal? (car (cadr (caddr g))) '(MUL R)))
        (let ((xk (caddr (cadr (caddr g)))))
          (dtr-type-carr! xk)
          (fact 'ring-mul-left-id 'R xk)
          (subst (list '= (list '(MUL R) '(ONE R) xk) xk)))))
  (if (and i (dk-asm? (list '= i 'q)) (dk-contains? (dk-goal) i)) (subst (list '= i 'q)))
  (if (and i (dk-asm? (list '= i 2)) (dk-contains? (dk-goal) i)) (subst (list '= i 2)))
  (let ((g (dk-goal)))
    (if (not (equal? (cadr g) (caddr g)))
        (begin
          (dk-apply! h1q k)
          (subst (list '= (list 'ENTRY 'A 'q k) (list 'ENTRY 'A 1 k))))))
  (dtr-type-carr! (cadr (dk-goal)))
  (rfl))

;; the three kinds of antecedent the linearity and alternation lemmas ask for
(define (dtr-mk-rowhyp! h1q)          ; (dtr-rowhyp X Y p (succ n))
  (let* ((i (dk-di-var!)))
    (let* ((ne (dk-landed-1 (lambda () (di))))
           (p  (caddr (cadr ne)))
           (k  (dk-di-var!)))
      (dtr-mk-rewrite!)
      (use-em (list '= i (if (equal? p 'q) 2 'q))
        (lambda () (dtr-if-auto!) (dtr-mk-close! h1q i k))
        (lambda () (dtr-if-auto!) (dtr-mk-close! h1q i k))))))
(define (dtr-mk-rowval! h1q)          ; forall k. ENTRY(..)=ENTRY(..) at fixed rows
  (let ((k (dk-di-var!)))
    (dtr-mk-rewrite!)
    (dtr-if-auto!)
    (dtr-mk-close! h1q #f k)))

;; u3 = 1 u4 + u5, u4 = 1 u6 + t, u5 = 1 u7 + u8, u3 = u6 = u7 = u8 = 0  =>  t = 0
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(drt_ dru3_ dru4_ dru5_ dru6_ dru7_ dru8_)
      (append (dtr-carr-guards '(drt_ dru3_ dru4_ dru5_ dru6_ dru7_ dru8_))
              (list '(= dru3_ ((ADD R) ((MUL R) (ONE R) dru4_) dru5_))
                    '(= dru4_ ((ADD R) ((MUL R) (ONE R) dru6_) drt_))
                    '(= dru5_ ((ADD R) ((MUL R) (ONE R) dru7_) dru8_))
                    '(= dru3_ (ZERO R)) '(= dru6_ (ZERO R)) '(= dru7_ (ZERO R)) '(= dru8_ (ZERO R))))
      '(= drt_ (ZERO R)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(have! '(= dru3_ drt_)
  (lambda ()
    (subst '(= dru3_ ((ADD R) ((MUL R) (ONE R) dru4_) dru5_)))
    (subst '(= dru4_ ((ADD R) ((MUL R) (ONE R) dru6_) drt_)))
    (subst '(= dru5_ ((ADD R) ((MUL R) (ONE R) dru7_) dru8_)))
    (subst '(= dru6_ (ZERO R)))
    (subst '(= dru7_ (ZERO R)))
    (subst '(= dru8_ (ZERO R)))
    (crs)))
(subst '(= drt_ dru3_))
(ass)
(dtr-done! 'dtr-ring-final)
(topic! 'dtr-ring-final 'plumbing)

(define dtr-alt-row1-stmt
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (dtr-alt-body 'n)
    (forall-guarded '(R A q)
      (list '(IS-COMMUTATIVE-RING R) '(IN A (MAT (succ n) (succ n) (CARR R)))
            '(IN q (INTERVAL 1 (succ n))) '(NOT (= q 1)) (dtr-eqrows 'A 1 'q '(succ n)))
      '(= (DET R (succ n) A) (ZERO R)))))))

;; state carried through the proof below
(define dtr-r1-n1 #f)
(define dtr-r1-h1q (dtr-eqrows 'A 1 'q '(succ n)))

;; det M = 0 by the crux, for M typed at size succ n = succ succ n1, given a
;; closer ROWS! for the rows-1-2 hypothesis (with k typed in [1, succ n]).
(define (dtr-r1-crux! M rows!)
  (let ((n1 dtr-r1-n1))
    (dk-have! (list '= '(succ n) (list 'succ (list 'succ n1)))
      (lambda () (subst (list '= 'n (list 'succ n1))) (rfl)))
    (detach-with! (dk-fact! 'dtr-det-rows12b '(succ n) n1 'R M)
      (lambda () (let ((k (dk-di-var!))) (rows! k))))))

(define (dtr-r1-lin! A B C p)          ; det C = 1 det A + det B, rows off p
  (dtr-chain! (dk-fact! 'det-row-linear 'R '(succ n) A B C p '(ONE R))
    (lambda (ante)
      (if (eq? (cadr ante) 'dri_)
          (lambda () (dtr-mk-rowhyp! dtr-r1-h1q))
          (lambda () (dtr-mk-rowval! dtr-r1-h1q))))))
(define (dtr-r1-low! M)                ; rows 2 and q of M equal
  (dtr-chain! (dk-fact! 'dtr-alt-low 'n 'R M 2 'q)
    (lambda (ante) (lambda () (dtr-mk-rowval! dtr-r1-h1q)))))

(sp (make-wff dtr-alt-row1-stmt))
(dk-peel!)
(if (not (and (dk-asm? (dtr-alt-body 'n)) (dk-asm? dtr-r1-h1q)))
    (error "dtr-alt-row1: hypotheses not landed"))
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(define dtr-r1-q1 (dtr-pred! 'q 'n))
(dtr-iv! dtr-r1-q1 1 'n)
(dtr-nn-have! '(NOT (= n 0)) (list dtr-r1-q1 'n)
              (list (list '<= 1 dtr-r1-q1) (list '<= dtr-r1-q1 'n)))
(set! dtr-r1-n1 (dk-skolem! (dk-fact! 'nn-nonzero-is-succ 'n)))
(dtr-in-iv! 1 1 '(succ n) '(n (succ n)) '())
(have! '(= 2 2) (lambda () (rfl)))
(have! '(= q q) (lambda () (rfl)))
(have! '(NOT (= 1 2)) (lambda () (arith)))
(have! '(NOT (= 2 1)) (lambda () (arith)))
(fact 'neq-sym 'q 1)
(use-em '(= q 2)
  ;; ---- q = 2: the crux
  (lambda ()
    (dtr-r1-crux! 'A
      (lambda (k)
        (dk-apply! dtr-r1-h1q k)
        (subst '(= 2 q))
        (ass)))
    (ass))
  ;; ---- q >= 3
  (lambda ()
    (fact 'neq-sym 'q 2)
    (dtr-in-iv! 2 1 '(succ n) (list dtr-r1-q1 'n '(succ n))
                (list (list '<= 1 dtr-r1-q1) (list '<= dtr-r1-q1 'n)))
    (let* ((A3 (dtr-mk dtr-es dtr-es)) (A4 (dtr-mk dtr-es dtr-ex)) (A5 (dtr-mk dtr-es dtr-ey))
           (A6 (dtr-mk dtr-ex dtr-ex)) (A7 (dtr-mk dtr-ex dtr-ey)) (A8 (dtr-mk dtr-ey dtr-ey))
           (dets (map (lambda (M) (list 'DET 'R '(succ n) M)) (list 'A A3 A4 A5 A6 A7 A8)))
           (rows12! (lambda (k) (dtr-mk-rewrite!) (dtr-if-auto!) (dtr-mk-close! dtr-r1-h1q #f k))))
      (for-each dtr-mk-type! (list A3 A4 A5 A6 A7 A8))
      (dtr-r1-lin! A4 A5 A3 'q)
      (dtr-r1-lin! A6 'A A4 2)
      (dtr-r1-lin! A7 A8 A5 2)
      (dtr-r1-low! A3)
      (dtr-r1-low! A8)
      (dtr-r1-crux! A6 rows12!)
      (dtr-r1-crux! A7 rows12!)
      (for-each (lambda (M) (fact 'det-in-carrier 'R '(succ n) M)) (list 'A A3 A4 A5 A6 A7 A8))
      (let ((f1 (dk-fact! 'dtr-ring-final 'R (list-ref dets 0) (list-ref dets 1) (list-ref dets 2))))
        (dk-apply! f1 (list-ref dets 3) (list-ref dets 4) (list-ref dets 5) (list-ref dets 6)))
      (ass))))
(dtr-done! 'dtr-alt-row1)
(topic! 'dtr-alt-row1 'algebra)

;;; =====================================================================
;;; (10) det is ALTERNATING: two equal rows give det = 0 (linear-algebra
;;; 3.18).  Induction on the size; the step splits on whether row 1 is one of
;;; the two rows (dtr-alt-row1, either order) or not (dtr-alt-low).
;;; =====================================================================
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dtr-alt-body 'n)))))
(define dtr-ai-ind (use-induction))
(dk-focus! (cdr (assq 'base dtr-ai-ind)))
(dk-peel!)
(dtr-iv! 'p 1 0)
(dtr-absurd! '(p) '((<= 1 p) (<= p 0)))
(dk-focus! (cdr (assq 'step dtr-ai-ind)))
(dk-peel!)
(define dtr-ai-eq (dtr-eqrows 'A 'p 'q '(succ n)))
(if (not (and (dk-asm? (dtr-alt-body 'n)) (dk-asm? dtr-ai-eq)))
    (error "det-alternating-ind: hypotheses not landed"))
(fact 'nn-one-in)
(fact 'nn-succ-closed 'n)
(use-em '(= p 1)
  (lambda ()
    (dtr-have! '(NOT (= q 1))
      (lambda ()
        (di)
        (have! '(= p q) (lambda () (subst '(= p 1)) (subst '(= q 1)) (rfl)))
        (ai '(NOT (= p q)))))
    (dtr-have! (dtr-eqrows 'A 1 'q '(succ n))
      (lambda ()
        (let ((k (dk-di-var!)))
          (subst '(= 1 p))
          (dk-apply! dtr-ai-eq k)
          (ass))))
    (fact 'dtr-alt-row1 'n 'R 'A 'q)
    (ass))
  (lambda ()
    (use-em '(= q 1)
      (lambda ()
        (dtr-have! (dtr-eqrows 'A 1 'p '(succ n))
          (lambda ()
            (let ((k (dk-di-var!)))
              (subst '(= 1 q))
              (dk-apply! dtr-ai-eq k)
              (subst (list '= (list 'ENTRY 'A 'q k) (list 'ENTRY 'A 'p k)))
              (fact 'commutative-ring-is-ring 'R)
              (fact 'entry-in-carrier '(succ n) '(succ n) '(CARR R) 'A 'p k)
              (rfl))))
        (fact 'dtr-alt-row1 'n 'R 'A 'p)
        (ass))
      (lambda ()
        (fact 'dtr-alt-low 'n 'R 'A 'p 'q)
        (ass)))))
(dtr-done! 'det-alternating-ind)
(topic! 'det-alternating-ind 'algebra)

;;; det-alternating-rows -- structure-library/determinant.scm, the support,
;;; stated LITERALLY.
(sp (make-wff
  (forall-guarded '(R n A p q)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) '(IN A (MAT n n (CARR R)))
          '(IN p (INTERVAL 1 n)) '(IN q (INTERVAL 1 n)) '(NOT (= p q))
          '(FORALL k (IMPLIES (IN k (INTERVAL 1 n))
              (= (ENTRY A p k) (ENTRY A q k)))))
    '(= (DET R n A) (ZERO R)))))
(dk-peel!)
(fact 'det-alternating-ind 'n 'R 'A 'p 'q)
(ass)
(dtr-done! 'det-alternating-rows)
(topic! 'det-alternating-rows 'algebra)

;;; =====================================================================
;;; (11) interchanging two rows changes the sign (linear-algebra 3.18, the
;;; second clause).  With [u, v] the matrix A with row p := u and row q := v,
;;; s = a_p + a_q, linearity gives det[s,s] = det[a_p,a_p] + det A + det B +
;;; det[a_q,a_q], and the three [w,w] terms vanish by the alternating property.
;;; B is ANY matrix whose rows are those of A with p and q interchanged.
;;; =====================================================================
(define (dtr-mk2 r1 r2 E1 E2)
  (list 'MATOF '(succ n) '(succ n)
    (list 'VNB-LAMBDA '(LIST dtv_ dtw_) (list 'CARTESIAN dtr-mI dtr-mI)
      (list 'IF (list '= 'dtv_ r1) E1 (list 'IF (list '= 'dtv_ r2) E2 '(ENTRY A dtv_ dtw_))))))
(define (dtr-mk1 r1 E1)
  (list 'MATOF '(succ n) '(succ n)
    (list 'VNB-LAMBDA '(LIST dtv_ dtw_) (list 'CARTESIAN dtr-mI dtr-mI)
      (list 'IF (list '= 'dtv_ r1) E1 '(ENTRY A dtv_ dtw_)))))

(define (dtr-sw-hBo n)
  (list 'FORALL 'dri_ (list 'IMPLIES (list 'IN 'dri_ (list 'INTERVAL 1 n))
    (list 'IMPLIES '(NOT (= dri_ p)) (list 'IMPLIES '(NOT (= dri_ q))
      (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (list 'INTERVAL 1 n))
        '(= (ENTRY B dri_ drk_) (ENTRY A dri_ drk_)))))))))
(define (dtr-sw-hrow n r s)          ; row r of B is row s of A
  (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (list 'INTERVAL 1 n))
    (list '= (list 'ENTRY 'B r 'drk_) (list 'ENTRY 'A s 'drk_)))))

;; the swap closer: ONE-mult away, index equations substituted, entries of B
;; rewritten by the hypotheses, rfl
(define (dtr-sw-close! i k)
  (let ((g (dk-goal)))
    (if (and (pair? (caddr g)) (equal? (car (caddr g)) '(ADD R)) (pair? (cadr (caddr g)))
             (equal? (car (cadr (caddr g))) '(MUL R)))
        (let ((xk (caddr (cadr (caddr g)))))
          (if (not (and (pair? xk) (eq? (cadr xk) 'B))) (dtr-type-carr! xk))
          (if (and (pair? xk) (eq? (cadr xk) 'B))
              (begin (dk-apply! (dtr-sw-hrow '(succ n) 'q 'p) k)
                     (subst (list '= (list 'ENTRY 'B 'q k) (list 'ENTRY 'A 'p k)))
                     (set! xk (list 'ENTRY 'A 'p k))
                     (dtr-type-carr! xk)))
          (fact 'ring-mul-left-id 'R xk)
          (subst (list '= (list '(MUL R) '(ONE R) xk) xk)))))
  (if (and i (dk-asm? (list '= i 'p)) (dk-contains? (dk-goal) i)) (subst (list '= i 'p)))
  (if (and i (dk-asm? (list '= i 'q)) (dk-contains? (dk-goal) i)) (subst (list '= i 'q)))
  (let loop ()
    (let ((e (find-first (lambda (x) (and (pair? x) (eq? (car x) 'ENTRY) (eq? (cadr x) 'B)))
                         (dk-subterms (dk-goal)))))
      (if e
          (let ((r (caddr e)))
            (cond ((eq? r 'p) (dk-apply! (dtr-sw-hrow '(succ n) 'p 'q) k)
                              (subst (list '= e (list 'ENTRY 'A 'q k))))
                  ((eq? r 'q) (dk-apply! (dtr-sw-hrow '(succ n) 'q 'p) k)
                              (subst (list '= e (list 'ENTRY 'A 'p k))))
                  (#t (dk-apply! (dk-apply! (dtr-sw-hBo '(succ n)) r) k)
                      (subst (list '= e (list 'ENTRY 'A r k)))))
            (loop)))))
  (dtr-type-carr! (cadr (dk-goal)))
  (rfl))

(define (dtr-sw-rowhyp!)
  (let* ((i (dk-di-var!)))
    (let* ((ne (dk-landed-1 (lambda () (di))))
           (lin (caddr (cadr ne)))
           (k (dk-di-var!)))
      (dtr-mk-rewrite!)
      (use-em (list '= i (if (eq? lin 'p) 'q 'p))
        (lambda () (dtr-if-auto!) (dtr-sw-close! i k))
        (lambda () (dtr-if-auto!) (dtr-sw-close! i k))))))
(define (dtr-sw-rowval!)
  (let ((k (dk-di-var!)))
    (dtr-mk-rewrite!)
    (dtr-if-auto!)
    (dtr-sw-close! #f k)))
(define (dtr-sw-thunk ante)
  (if (eq? (cadr ante) 'dri_) (lambda () (dtr-sw-rowhyp!)) (lambda () (dtr-sw-rowval!))))

;; u1 = 1 u2 + u3, u2 = 1 u4 + a, u3 = 1 b + u5, u1 = u4 = u5 = 0  =>  b = - a
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(dra_ drb_ dru1_ dru2_ dru3_ dru4_ dru5_)
      (append (dtr-carr-guards '(dra_ drb_ dru1_ dru2_ dru3_ dru4_ dru5_))
              (list '(= dru1_ ((ADD R) ((MUL R) (ONE R) dru2_) dru3_))
                    '(= dru2_ ((ADD R) ((MUL R) (ONE R) dru4_) dra_))
                    '(= dru3_ ((ADD R) ((MUL R) (ONE R) drb_) dru5_))
                    '(= dru1_ (ZERO R)) '(= dru4_ (ZERO R)) '(= dru5_ (ZERO R))))
      '(= drb_ ((NEG R) dra_)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(have! '(= ((ADD R) dra_ drb_) (ZERO R))
  (lambda ()
    (subst '(= (ZERO R) dru1_))
    (subst '(= dru1_ ((ADD R) ((MUL R) (ONE R) dru2_) dru3_)))
    (subst '(= dru2_ ((ADD R) ((MUL R) (ONE R) dru4_) dra_)))
    (subst '(= dru3_ ((ADD R) ((MUL R) (ONE R) drb_) dru5_)))
    (subst '(= dru4_ (ZERO R)))
    (subst '(= dru5_ (ZERO R)))
    (crs)))
(fact 'ring-add-inverse-unique 'R 'dra_ 'drb_)
(ass)
(dtr-done! 'dtr-ring-swap)
(topic! 'dtr-ring-swap 'plumbing)

(sp (make-wff
  (forall-guarded '(n R A B p q)
    (list '(IN n NN) '(IS-COMMUTATIVE-RING R)
          '(IN A (MAT (succ n) (succ n) (CARR R))) '(IN B (MAT (succ n) (succ n) (CARR R)))
          '(IN p (INTERVAL 1 (succ n))) '(IN q (INTERVAL 1 (succ n))) '(NOT (= p q))
          (dtr-sw-hBo '(succ n)) (dtr-sw-hrow '(succ n) 'p 'q) (dtr-sw-hrow '(succ n) 'q 'p))
    '(= (DET R (succ n) B) ((NEG R) (DET R (succ n) A))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-succ-closed 'n)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(fact 'neq-sym 'p 'q)
(have! '(= p p) (lambda () (rfl)))
(have! '(= q q) (lambda () (rfl)))
(let* ((ap '(ENTRY A p dtw_)) (aq '(ENTRY A q dtw_)) (s (list '(ADD R) ap aq))
       (SS (dtr-mk2 'p 'q s s)) (PS (dtr-mk2 'p 'q ap s)) (QS (dtr-mk2 'p 'q aq s))
       (PP (dtr-mk2 'p 'q ap ap)) (QQ (dtr-mk2 'p 'q aq aq))
       (det (lambda (M) (list 'DET 'R '(succ n) M))))
  (for-each dtr-mk-type! (list SS PS QS PP QQ))
  (dtr-chain! (dk-fact! 'det-row-linear 'R '(succ n) PS QS SS 'p '(ONE R)) dtr-sw-thunk)
  (dtr-chain! (dk-fact! 'det-row-linear 'R '(succ n) PP 'A PS 'q '(ONE R)) dtr-sw-thunk)
  (dtr-chain! (dk-fact! 'det-row-linear 'R '(succ n) 'B QQ QS 'q '(ONE R)) dtr-sw-thunk)
  (for-each (lambda (M)
              (dtr-chain! (dk-fact! 'det-alternating-rows 'R '(succ n) M 'p 'q) dtr-sw-thunk))
            (list SS PP QQ))
  (for-each (lambda (M) (fact 'det-in-carrier 'R '(succ n) M)) (list 'A 'B SS PS QS PP QQ))
  (let ((f1 (dk-fact! 'dtr-ring-swap 'R (det 'A) (det 'B) (det SS))))
    (dk-apply! f1 (det PS) (det QS) (det PP) (det QQ)))
  (ass))
(dtr-done! 'dtr-swap-s)
(topic! 'dtr-swap-s 'algebra)

;;; headline: interchanging two distinct rows negates the determinant
(sp (make-wff
  (forall-guarded '(R n A B p q)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN)
          '(IN A (MAT n n (CARR R))) '(IN B (MAT n n (CARR R)))
          '(IN p (INTERVAL 1 n)) '(IN q (INTERVAL 1 n)) '(NOT (= p q))
          (dtr-sw-hBo 'n) (dtr-sw-hrow 'n 'p 'q) (dtr-sw-hrow 'n 'q 'p))
    '(= (DET R n B) ((NEG R) (DET R n A))))))
