;;; primitive-glue.scm -- PRIMITIVES ON ADJACENT INTERVALS GLUE (batch 22-C).
;;;
;;; THE SOURCE: Dieudonne, Foundations of Modern Analysis, (8.7.2), the step-function case:
;;; "Suppose f is a step-function ... Then if we define g such that in each interval
;;; [lambda_i, lambda_{i+1}] we have g(xi) = c_i (xi - lambda_i) + sum_{k<i} c_k (lambda_{k+1} -
;;; lambda_k), it is readily verified that g is a primitive of f."  The explicit g is the closed
;;; form of a recursion that adds one piece at a time; this file proves the recursion's step
;;; once, as a lemma about ARBITRARY primitives (the juxtaposition of roads, Dieudonne IX.6,
;;; needs the same lemma).
;;;
;;;   primitive-glue       g1 a primitive of f1 on [a, c], g2 of f2 on [c, b], g1(c) = g2(c);
;;;                        g, f GIVEN on [a, b], g agreeing with g1 on [a, c] and with g2 on
;;;                        [c, b], f with f1 on (a, c) and with f2 on (c, b)  ==>  g is a
;;;                        primitive of f on [a, b].
;;;
;;; STATEMENT NOTES.  g and f are GIVEN functions with agreement clauses, never a constructed
;;; IF-term, so the lemma applies to any function that agrees with the pieces.  The agreements
;;; are quasi-equations (==), the library's convention for pointwise agreement
;;; (pw-antiderivative-sum); all terms are typed, so == and = coincide there.  The agreement of
;;; f is asked on the OPEN pieces only: the values of f at a, c and b are free (a primitive
;;; constrains its integrand only at interior points off a countable set; c goes into the
;;; exceptional set D = D1 u D2 u {c}).
;;;
;;; THE PROOF.  Continuity of g on [a, b] WITHOUT a case analysis at c: the two constant
;;; extensions EXTEND-CONST(g1, a, c) and EXTEND-CONST(g2, c, b) are continuous on the line
;;; (extend-const-continuous-at), so is H(x) = E1(x) + E2(x) - g1(c), and H = g on [a, b]
;;; (for t <= c, E2(t) = g2(CLAMP(c, b, t)) = g2(c) = g1(c); for t >= c symmetrically);
;;; pw-restrict-continuous-on transfers the continuity.  The derivative at t in (a, b) off D:
;;; t /= c, and on the side of c where t lies g agrees with g1 (or g2) on a neighbourhood of t
;;; (ooint-inner-radius), so has-deriv-at-local moves the derivative across.
;;;
;;; Helper prefix: pgl-.

;;; ---- file-local driver helpers ---------------------------------------

(define (pgl-head g) (and (pair? g) (car g)))

(define (pgl-conj-ineq! prems)
  (dk-conj-close!
   (lambda ()
     (if (dk-ctx-form (dk-goal))
         (ass)
         (apply dk-ineq! prems)))))

;;; x in CCINT(lo,hi) / OOINT(lo,hi) from the bounds (all in context).
(define (pgl-in-ccint! z lo hi prems)
  (dk-have! (list 'IN z (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership) (pgl-conj-ineq! prems))))
(define (pgl-in-ooint! z lo hi prems)
  (dk-have! (list 'IN z (list 'OOINT lo hi))
    (lambda () (mac 'ooint-membership) (pgl-conj-ineq! prems))))

;;; the three conjuncts of an OOINT membership, landed, the membership kept.
(define (pgl-ooint-parts! y lo hi)
  (fact 'ooint-elt-in-rr lo hi y)
  (dk-have! (list '< lo y)
    (lambda () (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'ooint-membership (list 'IN y (list 'OOINT lo hi))))))
               (ass)))
  (dk-have! (list '< y hi)
    (lambda () (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'ooint-membership (list 'IN y (list 'OOINT lo hi))))))
               (ass))))

;;; =====================================================================
;;; (1) CLAMP OUTSIDE THE INTERVAL.  clamp.scm proves the value INSIDE (clamp-fixes); the glue
;;; needs the two constant arms.
;;; =====================================================================
(sp (make-wff "forall([a in rr, b in rr, x in rr], x <= a implies a <= b implies clamp(a, b, x) = a)"))
(dk-peel!)
(mac 'clamp)
(fact 'rr-max-right-le 'x 'a)
(subst '(= (max x a) a))
(fact 'rr-min-left-le 'a 'b)
(subst '(= (min a b) a))
(rfl)
(qed 'clamp-left-const)
(topic! 'clamp-left-const 'analysis)

(sp (make-wff "forall([a in rr, b in rr, x in rr], a <= b implies b <= x implies clamp(a, b, x) = b)"))
(dk-peel!)
(dk-have! '(<= a x) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(IN x RR) '(<= a b) '(<= b x))))
(mac 'clamp)
(fact 'rr-max-left-le 'x 'a)
(subst '(= (max x a) x))
(fact 'rr-min-right-le 'x 'b)
(subst '(= (min x b) b))
(rfl)
(qed 'clamp-right-const)
(topic! 'clamp-right-const 'analysis)

;;; =====================================================================
;;; (2) THE INTEGRAND OF A PRIMITIVE MATTERS ONLY INSIDE.  pw-antiderivative-integrand-
;;; congruence asks for agreement on the CLOSED interval; the definition reads the integrand
;;; on the open one only.
;;; =====================================================================
(sp (make-wff "forall([pwf_, pphi_, ppsi_, a, b],
   is-primitive(pwf_, pphi_, a, b) implies
   ppsi_ in fun(ccint(a, b), rr) implies
   forall([pay_ in ooint(a, b)], pphi_(pay_) == ppsi_(pay_)) implies
   is-primitive(pwf_, ppsi_, a, b))"))
(dk-peel!)
(define pgl-ic-agree
  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm 'ppsi_)))
           "the interior agreement of the integrands"))
(dk-split! (dk-fact! 'primitive-endpoints 'pwf_ 'pphi_ 'a 'b))
(fact 'primitive-in-fun 'pwf_ 'pphi_ 'a 'b)
(fact 'primitive-continuous 'pwf_ 'pphi_ 'a 'b)
(let* ((s (dk-skolem! (dk-fact! 'primitive-exceptional-set 'pwf_ 'pphi_ 'a 'b)))
       (d (begin (dk-split-all!)
                 (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                            (dk-contains? fm 'HAS-DERIV-AT)
                                            (dk-contains? fm s)))
                          "the derivative universal"))))
  (dk-have! (list 'FORALL 'pat_ (list 'IMPLIES '(IN pat_ (OOINT a b))
              (list 'IMPLIES (list 'NOT (list 'IN 'pat_ s))
                    '(HAS-DERIV-AT pwf_ pat_ (ppsi_ pat_)))))
    (lambda ()
      (dk-peel!)
      (let ((v (caddr (dk-goal))))
        (dk-apply! d v)
        (dk-apply! pgl-ic-agree v)
        (subst (list '== (list 'ppsi_ v) (list 'pphi_ v)))
        (ass))))
  (mac 'IS-PRIMITIVE)
  (dk-conj-close!
   (lambda ()
     (if (not (eq? (pgl-head (dk-goal)) 'FORSOME))
         (ass)
         (begin
           (ew s)
           (dk-conj-close! (lambda () (ass))))))))
(qed 'primitive-integrand-interior-congruence)
(topic! 'primitive-integrand-interior-congruence 'analysis)
(alias! 'primitive-integrand-interior-congruence
        "a primitive of f is a primitive of every function agreeing with f on the open interval")

;;; =====================================================================
;;; (3) THE GLUE LEMMA.
;;; =====================================================================
(define pgl-ab '(CCINT a b))
(define pgl-ac '(CCINT a c))
(define pgl-cb '(CCINT c b))
(define pgl-e1 '(EXTEND-CONST g1 a c))
(define pgl-e2 '(EXTEND-CONST g2 c b))
(define pgl-lsum (list 'VNB-LAMBDA 'x 'RR (list '+ (list pgl-e1 'x) (list pgl-e2 'x))))
(define pgl-lcst '(VNB-LAMBDA x RR (g1 c)))
(define pgl-hh (list 'VNB-LAMBDA 'x 'RR (list '- (list pgl-lsum 'x) (list pgl-lcst 'x))))

;;; type a lambda over RR whose pointwise typing THUNK proves for the eigenvariable it is given.
(define (pgl-lam-t! lam pointwise)
  (dk-have! (list 'IN lam '(FUN RR RR))
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (eq? (pgl-head (dk-goal)) 'FORALL))
             (ass)
             (let ((z (dk-di-var!)))
               (pointwise z)
               (ass))))
       (dk-opened (lambda () (lam-t)))))))

(sp (make-wff "forall([a in rr, c in rr, b in rr], a < c implies c < b implies
   forall([g1, f1, g2, f2],
     is-primitive(g1, f1, a, c) implies is-primitive(g2, f2, c, b) implies g1(c) = g2(c) implies
     forall([g in fun(ccint(a, b), rr), f in fun(ccint(a, b), rr)],
       forall([t in ccint(a, c)], g(t) == g1(t)) implies
       forall([t in ccint(c, b)], g(t) == g2(t)) implies
       forall([t in ooint(a, c)], f(t) == f1(t)) implies
       forall([t in ooint(c, b)], f(t) == f2(t)) implies
       is-primitive(g, f, a, b))))"))
(dk-peel!)
(define (pgl-agreement sym what)
  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm sym))) what))
(define pgl-ag1 (pgl-agreement 'g1 "g agrees with g1"))
(define pgl-ag2 (pgl-agreement 'g2 "g agrees with g2"))
(define pgl-af1 (pgl-agreement 'f1 "f agrees with f1"))
(define pgl-af2 (pgl-agreement 'f2 "f agrees with f2"))
(dk-have! '(<= a c) (lambda () (dk-ineq! '(IN a RR) '(IN c RR) '(< a c))))
(dk-have! '(<= c b) (lambda () (dk-ineq! '(IN c RR) '(IN b RR) '(< c b))))
(dk-have! '(< a b) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(IN c RR) '(< a c) '(< c b))))
(fact 'rr-leq-reflexive 'a)
(fact 'rr-leq-reflexive 'b)
(fact 'rr-leq-reflexive 'c)
(fact 'rr-is-set)
(fact 'ccint-subset-ccint 'a 'b 'a 'c)
(fact 'ccint-subset-ccint 'a 'b 'c 'b)
(fact 'ooint-subset-ccint 'a 'c)
(fact 'ooint-subset-ccint 'c 'b)
(fact 'primitive-in-fun 'g1 'f1 'a 'c)
(fact 'primitive-in-fun 'g2 'f2 'c 'b)
(fact 'primitive-integrand-in-fun 'g1 'f1 'a 'c)
(fact 'primitive-integrand-in-fun 'g2 'f2 'c 'b)
(fact 'primitive-continuous 'g1 'f1 'a 'c)
(fact 'primitive-continuous 'g2 'f2 'c 'b)
(pgl-in-ccint! 'c 'a 'c (list '(IN c RR) '(<= a c) '(<= c c)))
(pgl-in-ccint! 'c 'c 'b (list '(IN c RR) '(<= c c) '(<= c b)))
(pgl-in-ccint! 'c 'a 'b (list '(IN c RR) '(<= a c) '(<= c b)))
(fact 'fun-apply-type-c 'g1 pgl-ac 'RR 'c)
(fact 'fun-apply-type-c 'g2 pgl-cb 'RR 'c)
(fact 'extend-const-in-fun 'a 'c 'g1)
(fact 'extend-const-in-fun 'c 'b 'g2)

;; ---- (3a) continuity of g on [a, b], through H on the line
(pgl-lam-t! pgl-lsum
  (lambda (z)
    (fact 'fun-apply-type-c pgl-e1 'RR 'RR z)
    (fact 'fun-apply-type-c pgl-e2 'RR 'RR z)
    (fact 'rr-add-in-rr (list pgl-e1 z) (list pgl-e2 z))))
(pgl-lam-t! pgl-lcst (lambda (z) 'nothing))
(pgl-lam-t! pgl-hh
  (lambda (z)
    (fact 'fun-apply-type-c pgl-lsum 'RR 'RR z)
    (fact 'fun-apply-type-c pgl-lcst 'RR 'RR z)
    (fact 'rr-sub-in-rr (list pgl-lsum z) (list pgl-lcst z))))
(dk-have! (list 'FORALL 'pax_ (list 'IMPLIES '(IN pax_ RR)
            (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS pgl-hh 'pax_)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'extend-const-continuous-at 'a 'c 'g1 z)
      (fact 'extend-const-continuous-at 'c 'b 'g2 z)
      (fact 'sum-continuous-at pgl-e1 pgl-e2 z)
      (fact 'const-continuous-at '(g1 c) z)
      (fact 'sub-continuous-at pgl-lsum pgl-lcst z)
      (ass))))
(dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ pgl-ab)
            (list '== (list 'g 'pay_) (list pgl-hh 'pay_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-split! (dk-fact! 'ccint-parts 'a 'b z))
      (dk-lam-b!)
      (have! (list 'AND (list 'IN z 'RR) '(IN c RR)))
      (fact 'rr-leq-total z 'c)
      (use-cases (list 'OR (list '<= z 'c) (list '<= 'c z))
        (lambda ()
          (pgl-in-ccint! z 'a 'c (list (list 'IN z 'RR) (list '<= 'a z) (list '<= z 'c)))
          (fact 'fun-apply-type-c 'g1 pgl-ac 'RR z)
          (fact 'extend-const-fixes 'a 'c z 'g1)
          (fact 'extend-const-value 'g2 'c 'b z)
          (fact 'clamp-left-const 'c 'b z)
          (dk-apply! pgl-ag1 z)
          (subst (list '== (list 'g z) (list 'g1 z)))
          (subst (list '== (list pgl-e1 z) (list 'g1 z)))
          (subst (list '== (list pgl-e2 z) (list 'g2 (list 'CLAMP 'c 'b z))))
          (subst (list '= (list 'CLAMP 'c 'b z) 'c))
          (subst '(= (g2 c) (g1 c)))
          (let ((eqn (list '= (list '- (list '+ (list 'g1 z) '(g1 c)) '(g1 c)) (list 'g1 z))))
            (dk-have! eqn (lambda () (crs)))
            (subst eqn))
          (qrfl))
        (lambda ()
          (pgl-in-ccint! z 'c 'b (list (list 'IN z 'RR) (list '<= 'c z) (list '<= z 'b)))
          (fact 'fun-apply-type-c 'g2 pgl-cb 'RR z)
          (fact 'extend-const-fixes 'c 'b z 'g2)
          (fact 'extend-const-value 'g1 'a 'c z)
          (fact 'clamp-right-const 'a 'c z)
          (dk-apply! pgl-ag2 z)
          (subst (list '== (list 'g z) (list 'g2 z)))
          (subst (list '== (list pgl-e2 z) (list 'g2 z)))
          (subst (list '== (list pgl-e1 z) (list 'g1 (list 'CLAMP 'a 'c z))))
          (subst (list '= (list 'CLAMP 'a 'c z) 'c))
          (let ((eqn (list '= (list '- (list '+ '(g1 c) (list 'g2 z)) '(g1 c)) (list 'g2 z))))
            (dk-have! eqn (lambda () (crs)))
            (subst eqn))
          (qrfl))))))
(fact 'pw-restrict-continuous-on 'a 'b pgl-hh 'g)

;; ---- (3b) the exceptional set D = D1 u D2 u {c}
(fact 'membership-implies-sethood 'c 'RR)
(have! '(AND (IN c SET) (IN c SET)))
(define pgl-pm (dk-fact! 'pairing-membership 'c 'c))
(let* ((s1 (dk-skolem! (dk-fact! 'primitive-exceptional-set 'g1 'f1 'a 'c)))
       (d1 (begin (dk-split-all!)
                  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                             (dk-contains? fm 'HAS-DERIV-AT)
                                             (dk-contains? fm s1)))
                           "the derivative universal of g1")))
       (s2 (dk-skolem! (dk-fact! 'primitive-exceptional-set 'g2 'f2 'c 'b)))
       (d2 (begin (dk-split-all!)
                  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                             (dk-contains? fm 'HAS-DERIV-AT)
                                             (dk-contains? fm s2)))
                           "the derivative universal of g2")))
       (u12 (list 'UNION s1 s2))
       (pc '(PAIR c c))
       (dd (list 'UNION u12 pc)))
  (fact 'countable-union-2 s1 s2)
  (fact 'countable-singleton 'c)
  (fact 'countable-union-2 u12 pc)
  (dk-have! (list 'SUBSET dd pgl-ab)
    (lambda ()
      (let* ((w   (subset-by-element!))
             (um1 (dk-fact! 'union-membership u12 pc w))
             (um2 (dk-fact! 'union-membership s1 s2 w))
             (pmi (inst*! pgl-pm w))
             (i1  (dk-fact! 'subset-mem-fwd s1 pgl-ac w))
             (i2  (dk-fact! 'subset-mem-fwd s2 pgl-cb w))
             (i3  (dk-fact! 'subset-mem-fwd pgl-ac pgl-ab w))
             (i4  (dk-fact! 'subset-mem-fwd pgl-cb pgl-ab w))
             (i5  (list 'IMPLIES (list '= w 'c) (list 'IN w pgl-ab))))
        (dk-have! i5 (lambda () (di) (subst (list '= w 'c)) (ass)))
        (dk-only! um1 um2 pmi i1 i2 i3 i4 i5 (list 'IN w dd))
        (prop))))
  ;; ---- (3c) the derivative off D
  (dk-have! (list 'FORALL 'pat_ (list 'IMPLIES (list 'IN 'pat_ '(OOINT a b))
              (list 'IMPLIES (list 'NOT (list 'IN 'pat_ dd))
                    '(HAS-DERIV-AT g pat_ (f pat_)))))
    (lambda ()
      (dk-peel!)
      (let* ((v   (caddr (dk-goal)))
             (nd  (list 'NOT (list 'IN v dd)))
             (um1 (dk-fact! 'union-membership u12 pc v))
             (um2 (dk-fact! 'union-membership s1 s2 v))
             (pmi (inst*! pgl-pm v)))
        (dk-have! (list 'NOT (list 'IN v s1)) (lambda () (dk-only! um1 um2 nd) (prop)))
        (dk-have! (list 'NOT (list 'IN v s2)) (lambda () (dk-only! um1 um2 nd) (prop)))
        (dk-have! (list 'NOT (list '= v 'c)) (lambda () (dk-only! um1 pmi nd) (prop)))
        (pgl-ooint-parts! v 'a 'b)
        (fact 'rr-lt-trichotomy v 'c)
        (let ((side
               (lambda (lo hi dv ag af gi fi cc)
                 (lambda ()
                   (pgl-in-ooint! v lo hi (list (list 'IN v 'RR) (list '< lo v) (list '< v hi)))
                   (fact 'subset-mem-fwd (list 'OOINT lo hi) cc v)
                   (fact 'fun-apply-type-c fi cc 'RR v)
                   (dk-apply! dv v)
                   (let ((rv (dk-skolem! (dk-fact! 'ooint-inner-radius lo hi v))))
                     (dk-split-all!)
                     (fact 'rr-pos-rr-in-rr rv)
                     (fact 'rr-sub-in-rr v rv)
                     (fact 'rr-add-in-rr v rv)
                     (let ((oo (list 'OOINT (list '- v rv) (list '+ v rv))))
                       (fact 'subset-trans oo cc pgl-ab)
                       (fact 'restrict-in-fun 'g pgl-ab 'RR oo)
                       (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ oo)
                                   (list '== '(g hbx_) (list gi 'hbx_))))
                         (lambda ()
                           (let ((y (dk-di-var!)))
                             (fact 'subset-mem-fwd oo cc y)
                             (dk-apply! ag y)
                             (ass))))
                       (fact 'has-deriv-at-local rv 'g gi v (list fi v))
                       (dk-apply! af v)
                       (subst (list '== (list 'f v) (list fi v)))
                       (ass)))))))
          (use-cases (list 'OR (list '< v 'c) (list 'OR (list '= v 'c) (list '< 'c v)))
            (side 'a 'c d1 pgl-ag1 pgl-af1 'g1 'f1 pgl-ac)
            (lambda () (ai (list 'NOT (list '= v 'c))))
            (side 'c 'b d2 pgl-ag2 pgl-af2 'g2 'f2 pgl-cb))))))
  ;; ---- (3d) assemble
  (mac 'IS-PRIMITIVE)
  (dk-conj-close!
   (lambda ()
     (if (not (eq? (pgl-head (dk-goal)) 'FORSOME))
         (ass)
         (begin
           (ew dd)
           (dk-conj-close! (lambda () (ass))))))))
(qed 'primitive-glue)
(topic! 'primitive-glue 'analysis)
(alias! 'primitive-glue
        "Dieudonne (8.7.2), the step of the step-function case"
        "primitives on two adjacent intervals that agree at the common point glue to a primitive on the union")

;;; =====================================================================
;;; (4) ONE PIECE.  A function constant (= cv) on the OPEN interval (u, v) has, on [u, v], the
;;; affine primitive k + cv (s - u), for every k.  The hypothesis is written in the shape the
;;; unfolded IS-STEP-FN hands over (a conjunctive antecedent over t_), so that a piece of a
;;; step function is cited without rebuilding it.
;;; =====================================================================
(define (pgl-lam-t-on! lam dom pointwise)
  (dk-have! (list 'IN lam (list 'FUN dom 'RR))
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (eq? (pgl-head (dk-goal)) 'FORALL))
             (ass)
             (let ((z (dk-di-var!)))
               (pointwise z)
               (ass))))
       (dk-opened (lambda () (lam-t)))))))

;;; close (== L R) by an arithmetic identity L = R that `crs' proves.
(define (pgl-crs-close! l r)
  (let ((eqn (list '= l r)))
    (dk-have! eqn (lambda () (crs)))
    (subst eqn)
    (qrfl)))

(define pgl-cp-g '(VNB-LAMBDA pgs_ (CCINT u v) (+ k (* cv (- pgs_ u)))))
(define pgl-cp-phi '(VNB-LAMBDA pgs_ (CCINT u v) cv))
(define pgl-cp-ff '(RESTRICT f (CCINT u v)))
(define pgl-cp-pac '(- k (* cv u)))

(sp (make-wff '(FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR)
   (IMPLIES (< u v)
     (FORALL f (IMPLIES (IN f (FUN RR RR))
       (FORALL cv (IMPLIES (IN cv RR) (FORALL k (IMPLIES (IN k RR)
         (IMPLIES (FORALL t_ (IMPLIES (AND (IN t_ RR) (AND (< u t_) (< t_ v))) (= (f t_) cv)))
           (IS-PRIMITIVE (VNB-LAMBDA pgs_ (CCINT u v) (+ k (* cv (- pgs_ u))))
                         (RESTRICT f (CCINT u v)) u v)))))))))))))))
(dk-peel!)
(define pgl-cp-const
  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm 'cv)))
           "the constancy of f on the open piece"))
(fact 'rr-is-set)
(fact 'ccint-subset-rr 'u 'v)
(fact 'subclass-of-set-is-set '(CCINT u v) 'RR)
(fact 'ooint-subset-ccint 'u 'v)
(pgl-lam-t-on! pgl-cp-g '(CCINT u v)
  (lambda (z)
    (fact 'ccint-elt-in-rr 'u 'v z)
    (fact 'rr-sub-in-rr z 'u)
    (fact 'rr-mul-in-rr 'cv (list '- z 'u))
    (fact 'rr-add-in-rr 'k (list '* 'cv (list '- z 'u)))))
(pgl-lam-t-on! pgl-cp-phi '(CCINT u v) (lambda (z) 'nothing))
(fact 'rr-mul-in-rr 'cv 'u)
(fact 'rr-sub-in-rr 'k '(* cv u))
(dk-have! (list 'FORALL 'pay_ (list 'IMPLIES '(IN pay_ (CCINT u v))
            (list '== (list pgl-cp-g 'pay_) (list '+ pgl-cp-pac '(* cv pay_)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'ccint-elt-in-rr 'u 'v z)
      (dk-lam-b!)
      (pgl-crs-close! (list '+ 'k (list '* 'cv (list '- z 'u)))
                      (list '+ pgl-cp-pac (list '* 'cv z))))))
(dk-have! (list 'FORALL 'pay_ (list 'IMPLIES '(IN pay_ (CCINT u v))
            (list '== (list pgl-cp-phi 'pay_) 'cv)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'ccint-elt-in-rr 'u 'v z)
      (dk-lam-b!)
      (qrfl))))
(let ((u1 (dk-fact! 'pw-affine-antiderivative 'u 'v)))
  (dk-apply! u1 pgl-cp-pac 'cv pgl-cp-g pgl-cp-phi))
(fact 'restrict-in-fun 'f 'RR 'RR '(CCINT u v))
(dk-have! (list 'FORALL 'pay_ (list 'IMPLIES '(IN pay_ (OOINT u v))
            (list '== (list pgl-cp-phi 'pay_) (list pgl-cp-ff 'pay_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (pgl-ooint-parts! z 'u 'v)
      (have! (list 'AND (list 'IN z 'RR) (list 'AND (list '< 'u z) (list '< z 'v))))
      (dk-apply! pgl-cp-const z)
      (fact 'subset-mem-fwd '(OOINT u v) '(CCINT u v) z)
      (fact 'restrict-apply 'f '(CCINT u v) z)
      (dk-lam-b!)
      (subst (list '== (list pgl-cp-ff z) (list 'f z)))
      (subst (list '= (list 'f z) 'cv))
      (qrfl))))
(fact 'primitive-integrand-interior-congruence pgl-cp-g pgl-cp-phi pgl-cp-ff 'u 'v)
(ass)
(qed 'primitive-of-constant-piece)
(topic! 'primitive-of-constant-piece 'analysis)
(alias! 'primitive-of-constant-piece
        "a function constant on (u, v) has an affine primitive on [u, v]")

;;; =====================================================================
;;; (5) A STEP FUNCTION HAS A PRIMITIVE, by induction on the number of pieces.
;;;
;;; IS-PARTITION is TOTAL on NN (regulated.scm), so the partition with one piece fewer is the
;;; SAME p with n in place of succ(n), on [a, p(n)].  The step glues the primitive the
;;; induction hypothesis gives on [a, p(n)] to the affine primitive of the last piece on
;;; [p(n), p(succ n)], shifted to agree at p(n), with `primitive-glue'.  The glued function is
;;; written without an IF: s |-> g'(CLAMP(a, p(n), s)) + c_n (CLAMP(p(n), b, s) - p(n)).
;;; The induction variable is outermost (`ni'); the step-function clause is written in the
;;; shape of the unfolded IS-STEP-FN, so the headline theorem instantiates the companion
;;; without rebuilding anything.
;;; =====================================================================
(define (pgl-steps-of pp nn ff)
  (list 'FORALL 'i_
    (list 'IMPLIES (list 'AND (list 'IN 'i_ (list 'INTERVAL 0 nn)) (list '< 'i_ nn))
      (list 'FORSOME 'c_
        (list 'AND '(IN c_ RR)
          (list 'FORALL 't_
            (list 'IMPLIES
              (list 'AND '(IN t_ RR) (list 'AND (list '< (list pp 'i_) 't_)
                                                (list '< 't_ (list pp '(SUCC i_)))))
              (list '= (list ff 't_) 'c_))))))))
(define (pgl-body-of nn)
  (list 'FORALL 'p (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f
    (list 'IMPLIES '(IN f (FUN RR RR))
      (list 'IMPLIES (list 'IS-PARTITION 'p nn 'a 'b)
        (list 'IMPLIES (pgl-steps-of 'p nn 'f)
          '(FORSOME g (IS-PRIMITIVE g (RESTRICT f (CCINT a b)) a b))))))))))

(define (pgl-find pred lst what)
  (let ((r (filter pred lst)))
    (if (null? r) (error "pgl-find: nothing matching" what) (car r))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (pgl-body-of 'n)))))
(let* ((leaves (dk-opened (lambda () (ni))))
       (step? (lambda (s)
                (let ((g (dk-goal-of s)))
                  (and (pair? g) (eq? (car g) 'FORALL)
                       (let ((b (caddr g)))
                         (and (pair? b) (eq? (car b) 'IMPLIES)
                              (pair? (cadr b)) (eq? (car (cadr b)) 'IN)
                              (eq? (caddr (cadr b)) 'NN)))))))
       (base (pgl-find (lambda (s) (not (step? s))) leaves "the base leaf"))
       (stp  (pgl-find step? leaves "the step leaf")))
  ;; ---- BASE: no partition has 0 pieces (1 <= 0 is false).
  (dk-focus! base)
  (let* ((landed (dk-peel!))
         (part (pgl-find (dk-head? 'IS-PARTITION) landed "the partition")))
    (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part))))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (fact 'rr-lt-not-le 0 1)
    (ai '(NOT (<= 1 0))))
  ;; ---- STEP
  (dk-focus! stp)
  (let* ((landed (dk-peel!))
         (part (pgl-find (dk-head? 'IS-PARTITION) landed "the partition"))
         (pp (list-ref part 1))
         (sn (list-ref part 2))
         (nv (cadr sn))
         (aa (list-ref part 3))
         (bb (list-ref part 4))
         (ff (cadr (pgl-find (lambda (fm) (and ((dk-head? 'IN) fm)
                                               (equal? (caddr fm) '(FUN RR RR))))
                             landed "the typing of f")))
         (ih (pgl-find (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                         (dk-contains? fm 'IS-PARTITION)))
                       landed "the induction hypothesis"))
         (steps (pgl-find (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                            (dk-contains? fm 'INTERVAL)))
                          landed "the step-function clause"))
         (pn  (list pp nv))
         (psn (list pp sn))
         (isn (list 'INTERVAL 0 sn)))
    (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part))))
    (let ((incr (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                           (pair? (caddr fm)) (eq? (car (caddr fm)) 'FORALL)))
                         "the monotonicity of the partition")))
      (fact 'nn-in-rr nv)
      (fact 'nn-in-rr sn)
      (fact 'nn-zero-in)
      (fact 'nn-zero-le nv)
      (fact 'nn-zero-le sn)
      (fact 'nn-le-succ nv)
      (fact 'rr-leq-reflexive sn)
      (fact 'bt-lt-succ nv)
      (fact 'interval-mem-intro 0 sn nv)
      (fact 'interval-mem-intro 0 sn sn)
      (fact 'fun-apply-type-c pp 'NN 'RR nv)
      (fact 'fun-apply-type-c pp 'NN 'RR sn)
      (fact 'rr-is-set)
      ;; the last piece, (p(n), p(succ n)), and its constant
      (have! (list 'AND (list 'IN nv isn) (list '< nv sn)))
      (let* ((cn (dk-skolem! (dk-apply! steps nv)))
             (kn (begin (dk-split-all!)
                        (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm cn)))
                                 "the constancy on the last piece"))))
        (have! (list 'AND (list 'IN nv isn) (list 'AND (list 'IN sn isn) (list '< nv sn))))
        (dk-apply! incr nv sn)
        ;; b is p(succ n) from here on
        (subst (list '= bb psn))
        (fact 'nn-zero-or-succ nv)
        (use-cases (list 'OR (list '= nv 0)
                         (list 'FORSOME 'q (list 'AND '(IN q NN) (list '= nv '(SUCC q)))))
          ;; ---- ONE PIECE: n = 0, a = p(0) = p(n)
          (lambda ()
            (dk-have! (list '= pn aa) (lambda () (subst (list '= nv 0)) (ass)))
            (subst (list '= aa pn))
            (dk-have! '(IN 0 RR) (lambda () (arith)))
            (let* ((u1 (dk-fact! 'primitive-of-constant-piece pn psn))
                   (pr (dk-apply! u1 ff cn 0)))
              (ew (list-ref pr 1))
              (ass)))
          ;; ---- n >= 1: glue
          (lambda ()
            (let ((q (dk-skolem! (pgl-find (dk-head? 'FORSOME) (dk-asms) "n = succ(q)"))))
              (dk-have! (list '<= 1 nv)
                (lambda () (subst (list '= nv (list 'SUCC q))) (fact 'nn-one-le-succ q) (ass))))
            (dk-have! (list '< 0 nv) (lambda () (dk-ineq! (list 'IN nv 'RR) (list '<= 1 nv))))
            (fact 'nn-zero-le 0)
            (fact 'interval-mem-intro 0 sn 0)
            ;; `have!' without a thunk sends a claim with a numeral to `arith' first (driver-kit
            ;; known defect, from-context!): close the conjuncts by `ass'.
            (have! (list 'AND (list 'IN 0 isn) (list 'AND (list 'IN nv isn) (list '< 0 nv)))
                   (lambda () (dk-conj-close! (lambda () (ass)))))
            (dk-apply! incr 0 nv)
            (dk-have! (list '< aa pn) (lambda () (subst (list '= aa (list pp 0))) (ass)))
            (dk-have! (list '<= aa pn) (lambda () (dk-ineq! (list 'IN aa 'RR) (list 'IN pn 'RR) (list '< aa pn))))
            (dk-have! (list '<= pn psn) (lambda () (dk-ineq! (list 'IN pn 'RR) (list 'IN psn 'RR) (list '< pn psn))))
            (dk-have! (list '< aa psn) (lambda () (dk-ineq! (list 'IN aa 'RR) (list 'IN pn 'RR) (list 'IN psn 'RR) (list '< aa pn) (list '< pn psn))))
            ;; the partition with one piece fewer: the same p, on [a, p(n)]
            (dk-have! (list 'IS-PARTITION pp nv aa pn)
              (lambda ()
                (mac 'IS-PARTITION)
                (dk-conj-close!
                 (lambda ()
                   (let ((g (dk-goal)))
                     (cond ((eq? (pgl-head g) 'FORALL)
                            (dk-peel!)
                            (dk-split-all!)
                            (let* ((gl (dk-goal)) (iv (cadr (cadr gl))) (jv (cadr (caddr gl))))
                              (fact 'interval-widen nv sn 0 iv)
                              (fact 'interval-widen nv sn 0 jv)
                              (have! (list 'AND (list 'IN iv isn) (list 'AND (list 'IN jv isn) (list '< iv jv))))
                              (dk-apply! incr iv jv)
                              (ass)))
                           ((and (eq? (pgl-head g) '=) (equal? (cadr g) (caddr g))) (rfl))
                           (#t (ass))))))))
            (dk-have! (pgl-steps-of pp nv ff)
              (lambda ()
                (dk-peel!)
                (dk-split-all!)
                (let ()
                  (let ((iv (pgl-find (lambda (fm) (and ((dk-head? 'IN) fm)
                                                         (equal? (caddr fm) (list 'INTERVAL 0 nv))))
                                      (dk-asms) "the index")))
                    (let ((iv (cadr iv)))
                      (fact 'interval-widen nv sn 0 iv)
                      (fact 'interval-elt-in-nn 0 nv iv)
                      (fact 'nn-in-rr iv)
                      (dk-have! (list '< iv sn)
                        (lambda () (dk-ineq! (list 'IN iv 'RR) (list 'IN nv 'RR) (list 'IN sn 'RR)
                                             (list '< iv nv) (list '< nv sn))))
                      (have! (list 'AND (list 'IN iv isn) (list '< iv sn)))
                      (dk-apply! steps iv)
                      (ass))))))
            ;; the induction hypothesis on [a, p(n)]
            (let* ((gp  (dk-skolem! (dk-apply! ih pp aa pn ff)))
                   (f1  (list 'RESTRICT ff (list 'CCINT aa pn)))
                   (f2  (list 'RESTRICT ff (list 'CCINT pn psn)))
                   (fab (list 'RESTRICT ff (list 'CCINT aa psn)))
                   (gpc (list gp pn))
                   (g2  (list 'VNB-LAMBDA 'pgs_ (list 'CCINT pn psn)
                              (list '+ gpc (list '* cn (list '- 'pgs_ pn)))))
                   (gg  (list 'VNB-LAMBDA 'pgs_ (list 'CCINT aa psn)
                              (list '+ (list gp (list 'CLAMP aa pn 'pgs_))
                                       (list '* cn (list '- (list 'CLAMP pn psn 'pgs_) pn))))))
              (fact 'primitive-in-fun gp f1 aa pn)
              (fact 'rr-leq-reflexive pn)
              (pgl-in-ccint! pn aa pn (list (list 'IN pn 'RR) (list '<= aa pn) (list '<= pn pn)))
              (pgl-in-ccint! pn pn psn (list (list 'IN pn 'RR) (list '<= pn pn) (list '<= pn psn)))
              (fact 'fun-apply-type-c gp (list 'CCINT aa pn) 'RR pn)
              ;; the last piece, shifted to take the value g'(p(n)) at p(n)
              (let ((u1 (dk-fact! 'primitive-of-constant-piece pn psn)))
                (dk-apply! u1 ff cn gpc))
              (dk-have! (list '= gpc (list g2 pn))
                (lambda ()
                  (dk-lam-b!)
                  (dk-have! (list '= (list '+ gpc (list '* cn (list '- pn pn))) gpc) (lambda () (crs)))
                  (subst (list '= (list '+ gpc (list '* cn (list '- pn pn))) gpc))
                  (rfl)))
              ;; the glued function and its typing
              (fact 'ccint-subset-rr aa psn)
              (fact 'subclass-of-set-is-set (list 'CCINT aa psn) 'RR)
              (pgl-lam-t-on! gg (list 'CCINT aa psn)
                (lambda (z)
                  (fact 'ccint-elt-in-rr aa psn z)
                  (fact 'clamp-in-ccint aa pn z)
                  (fact 'fun-apply-type-c gp (list 'CCINT aa pn) 'RR (list 'CLAMP aa pn z))
                  (fact 'clamp-in-rr pn psn z)
                  (fact 'rr-sub-in-rr (list 'CLAMP pn psn z) pn)
                  (fact 'rr-mul-in-rr cn (list '- (list 'CLAMP pn psn z) pn))
                  (fact 'rr-add-in-rr (list gp (list 'CLAMP aa pn z))
                        (list '* cn (list '- (list 'CLAMP pn psn z) pn)))))
              (fact 'restrict-in-fun ff 'RR 'RR (list 'CCINT aa psn))
              ;; the four agreements
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'CCINT aa pn))
                          (list '== (list gg 't) (list gp 't))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (dk-split! (dk-fact! 'ccint-parts aa pn z))
                    (pgl-in-ccint! z aa psn (list (list 'IN z 'RR) (list '<= aa z) (list '<= z pn)
                                                  (list '<= pn psn)))
                    (fact 'fun-apply-type-c gp (list 'CCINT aa pn) 'RR z)
                    (dk-lam-b!)
                    (fact 'clamp-fixes aa pn z)
                    (fact 'clamp-left-const pn psn z)
                    (subst (list '= (list 'CLAMP aa pn z) z))
                    (subst (list '= (list 'CLAMP pn psn z) pn))
                    (pgl-crs-close! (list '+ (list gp z) (list '* cn (list '- pn pn))) (list gp z)))))
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'CCINT pn psn))
                          (list '== (list gg 't) (list g2 't))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (dk-split! (dk-fact! 'ccint-parts pn psn z))
                    (pgl-in-ccint! z aa psn (list (list 'IN z 'RR) (list '<= aa pn) (list '<= pn z)
                                                  (list '<= z psn)))
                    (dk-lam-b!)
                    (fact 'clamp-right-const aa pn z)
                    (fact 'clamp-fixes pn psn z)
                    (subst (list '= (list 'CLAMP aa pn z) pn))
                    (subst (list '= (list 'CLAMP pn psn z) z))
                    (qrfl))))
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'OOINT aa pn))
                          (list '== (list fab 't) (list f1 't))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (pgl-ooint-parts! z aa pn)
                    (pgl-in-ccint! z aa pn (list (list 'IN z 'RR) (list '< aa z) (list '< z pn)))
                    (pgl-in-ccint! z aa psn (list (list 'IN z 'RR) (list '< aa z) (list '< z pn)
                                                  (list '< pn psn)))
                    (fact 'restrict-apply ff (list 'CCINT aa psn) z)
                    (fact 'restrict-apply ff (list 'CCINT aa pn) z)
                    (subst (list '== (list fab z) (list ff z)))
                    (subst (list '== (list f1 z) (list ff z)))
                    (qrfl))))
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'OOINT pn psn))
                          (list '== (list fab 't) (list f2 't))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (pgl-ooint-parts! z pn psn)
                    (pgl-in-ccint! z pn psn (list (list 'IN z 'RR) (list '< pn z) (list '< z psn)))
                    (pgl-in-ccint! z aa psn (list (list 'IN z 'RR) (list '< aa pn) (list '< pn z)
                                                  (list '< z psn)))
                    (fact 'restrict-apply ff (list 'CCINT aa psn) z)
                    (fact 'restrict-apply ff (list 'CCINT pn psn) z)
                    (subst (list '== (list fab z) (list ff z)))
                    (subst (list '== (list f2 z) (list ff z)))
                    (qrfl))))
              ;; glue, citing in three stages
              (let* ((u1 (dk-fact! 'primitive-glue aa pn psn))
                     (u2 (dk-apply! u1 gp f1 g2 f2)))
                (dk-apply! u2 gg fab))
              (ew gg)
              (ass))))))))
(qed 'step-fn-has-primitive-ind)
(topic! 'step-fn-has-primitive-ind 'analysis)

;;; THE HEADLINE.  The integrand is RESTRICT(f, [a, b]): IS-STEP-FN is stated for a total f
;;; and IS-PRIMITIVE for a function on [a, b]; RESTRICT is what restrict-in-fun / restrict-apply
;;; type and evaluate in one citation each (a VNB-LAMBDA would need lam-t / lam-b instead).
(sp (make-wff "forall([a in rr, b in rr, f], is-step-fn(f, a, b) implies
   forsome([g], is-primitive(g, restrict(f, ccint(a, b)), a, b)))"))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-STEP-FN (pgl-find (dk-head? 'IS-STEP-FN) (dk-asms) "the step function")))))
(let* ((n0 (dk-skolem! (pgl-find (dk-head? 'FORSOME) (dk-asms) "the number of pieces")))
       (p0 (dk-skolem! (pgl-find (dk-head? 'FORSOME) (dk-asms) "the partition"))))
  (dk-split-all!)
  (let ((part (pgl-find (dk-head? 'IS-PARTITION) (dk-asms) "the partition")))
    (dk-have! (list 'IN n0 'NN)
      (lambda () (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part)))) (ass)))
    (let ((body (dk-fact! 'step-fn-has-primitive-ind n0)))
      (dk-apply! body p0 'a 'b 'f)
      (ass))))
(qed 'step-fn-has-primitive)
(topic! 'step-fn-has-primitive 'analysis)
(alias! 'step-fn-has-primitive
        "Dieudonne (8.7.2), the step-function case"
        "a step function on [a, b] has a primitive on [a, b]")
