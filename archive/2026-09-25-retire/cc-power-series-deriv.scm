;;; cc-power-series-deriv.scm -- PROPOSITION 2.10: THE SUM OF A COMPLEX POWER
;;; SERIES IS HOLOMORPHIC INSIDE THE RADIUS, AND ITS DERIVATIVE IS THE TERMWISE
;;; DERIVED SERIES, WHICH HAS THE SAME RADIUS.
;;; Batch 26-A, 2026-09-24.
;;;
;;; THE SOURCE.  ~/docs/complex-analysis.pdf, Proposition 2.10 (p. 27): "If
;;; sum_k a_k z^k has radius of convergence R, then the function
;;; f(z) = sum_k a_k z^k is defined and holomorphic in the open ball B(0, R).
;;; In fact, the series g(z) = sum_{n>=1} n a_n z^(n-1) also has radius of
;;; convergence R and f'(z) = g(z)."  Dieudonne (9.1.2) is the same statement for
;;; a power series in one variable over a valued field.
;;;
;;; THE CONVENTION FOR B(0, R).  R = CPS-RADIUS(cf) lies in [0, +inf] and BALL
;;; takes a real radius, so no object "B(0, R)" is defined (the batch-26 brief:
;;; no new definition).  Proposition 2.10 is stated, for every real r with
;;; 0 < r < R, on the open ball BALL(CC-MS, 0, r).  These balls exhaust B(0, R)
;;; when R is finite and CC when R = +inf; for r <= 0 the ball is empty.
;;; The derived series is reindexed from 0: g(z) = sum_k (k+1) a_(k+1) z^k.
;;;
;;; THE HEADLINES.
;;;   cps-radius-derived   dcf(k) = (k+1) cf(k+1) for all k  ==>
;;;                        CPS-RADIUS(dcf) = CPS-RADIUS(cf)
;;;   cps-diff-on-ball     0 < r < R, u in B(0, r)  ==>  IS-DIFF-ON(CC-NORMED-FIELD,
;;;                        B(0, r), f, u, sum_k dcf(k) u^k), f = z |-> sum_k cf(k) z^k
;;;   cps-holomorphic-ball the notes' 2.10 with the derived coefficients written out:
;;;                        HOLOMORPHIC-ON(B(0, r), f), the radius equality, and
;;;                        f'(u) = sum_k (k+1) cf(k+1) u^k at every u of B(0, r).
;;;
;;; THE ROUTE.
;;;   (a) The radius.  cps-radius-mono: if sum |a_k| t^k < inf implies
;;;       sum |b_k| t^k < inf for every t > 0, then R(a) <= R(b) (the radius is the
;;;       ESUP of the set of such t; 0 is handled by 0 <= ESUP).  cps-shift-conv:
;;;       for t > 0, sum |a_k| t^k and sum |a_(k+1)| t^k converge together
;;;       (series-shift-converges-iff of theorem-library/series-domination.scm and
;;;       a scaling by t).  Then R(a) <= R(k a_k) is Lemma 2.9 (cps-radius-factor,
;;;       b_k = k), R(k a_k) <= R(dcf) is the shift, and R(dcf) <= R(a) is the
;;;       comparison |a_(k+1)| <= (k+1) |a_(k+1)| and the shift back.  The notes'
;;;       route (lim n^(1/n) = 1 inside a lim sup) is not needed.
;;;   (b) The estimate.  With Q_k = z^(k+1) - u^(k+1) - (k+1) u^k (z - u), the
;;;       one-step recurrence Q_(k+1) = z Q_k + (k+1) u^k (z - u)^2 gives, by
;;;       induction, r |Q_k| <= (k+1)^2 r^k |z - u|^2 for |z|, |u| <= r
;;;       (cpd-power-second-order).  NO FINITE SUM AND NO TELESCOPING IDENTITY are
;;;       used: the notes' double sum A(z, u) and its count q_n = (n^2 - n)/2 are
;;;       replaced by this recurrence.  The first-order estimate the batch-25
;;;       report asked for, |z^(k+1) - u^(k+1)| <= (k+1) r^k |z - u|, is proven the
;;;       same way (cc-power-diff-bound); 2.10 does not use it.
;;;   (c) The error.  E_k = S(t_z, k+1) - S(t_u, k+1) - (z - u) S(t'_u, k), the
;;;       partial sums of f(z), f(u) and g(u), satisfies E_(k+1) = E_k + a_(k+1) Q_k,
;;;       hence r^2 |E_k| <= |z - u|^2 sum_{j<k} v_j with v_j = |a_(j+1) (j+1)^2| r^(j+1)
;;;       (cps-partial-error-bound), and sum v_j converges (Lemma 2.9 with b_k = k^2
;;;       at a radius between r and R, then the shift).  E_k tends to
;;;       f(z) - f(u) - (z - u) g(u) (cc-partial-error-limit, by the linearity of
;;;       limits), so |f(z) - f(u) - (z - u) g(u)| <= M |z - u|^2 on B(0, r).
;;;   (d) The derivative.  cc-diff-on-quadratic: on an open U of CC, such a
;;;       quadratic bound gives IS-DIFF-ON at u with derivative g(u); the
;;;       Caratheodory factor is phi(z) = IF(z = u, g(u), (f(z) - f(u))/(z - u)),
;;;       continuous at u because |phi(z) - g(u)| <= M |z - u|.  This is the notes'
;;;       "A(z, u) -> 0 as z -> u" in the library's definition of the derivative.
;;;   On the way, the linearity of limits and sums over CC: cpd-cc-squeeze,
;;;   cc-limit-lincomb (h = c s + d t => h -> c l + d m), cc-limit-shift,
;;;   cc-series-partial-sum-lincomb and cc-series-limit-linear (the sum of a
;;;   convergent complex series is linear: sum and complex scalar, in one law).
;;;
;;; NOTHING asserted: no support, stamp, axiom or definition.  Every statement
;;; with a derived or shifted sequence takes it GIVEN BY ITS VALUES (as
;;; cps-radius-factor does), except the headline, which writes the notes' g.
;;;
;;; Helper prefix: cpd-.  Theorem binders cpd..._ (and cf, dcf, f, g, h, s_, t_,
;;; lv, mv, m as in the surrounding library); the inner series binder is cpsk_,
;;; the one cc-power-series-laws.scm uses, so that its conclusions match literally.
;;; LOAD WINDOW: lo = theorem-library/cc-power-series-laws (cps-converges-closed-ball,
;;; cps-factor-conv, cps-radius-approx, cps-radius-factor, series-scale-converges,
;;; cc-closed-ball-origin, cc-series-limit-*), and theorem-library/series-domination
;;; (series-shift-converges-iff), which must load first.  hi: none.


(define (cpd-head g) (and (pair? g) (car g)))

;;; (== (PTS CC-MS) CC) in context
(define (cpd-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))

;;; the first context formula satisfying P
(define (cpd-find what p) (dk-pick p what))

;;; (IN LAM (FUN NN RR)) for LAM = (VNB-LAMBDA v NN body): TYPER is called on the
;;; eigenvariable and must land the body's typing.
(define (cpd-lam-typ! lam cod typer)
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-t!)
            (let ((j (dk-di-var!))) (typer j) (ass)))))
    typ))

;;; forall j in NN, (LAM j) = BODY(j), proven by beta; BODY-OF maps j to the body
(define (cpd-lam-val! lam body-of typer)
  (let ((f (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
             (list '= (list lam 'cpdj_) (body-of 'cpdj_))))))
    (dk-have! f
      (lambda ()
        (let ((j (dk-di-var!)))
          (typer j)
          (dk-lam-b!)
          (rfl))))
    f))

;;; ======================================================================
;;; (1) COMPLEX SEQUENCES: a sequence within a null real sequence of l tends to
;;; l; linear combinations of convergent sequences; the shifted sequence.
;;; ======================================================================

(define cpd-sq-bd '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (<= (magnitude (- (s_ cpdj_) lv)) (m cpdj_)))))
(sp (make-wff
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ (FUN NN CC))
    (list 'FORALL 'lv (list 'IMPLIES '(IN lv CC)
      (list 'FORALL 'm (list 'IMPLIES '(IN m (FUN NN RR))
        (list 'IMPLIES '(CONVERGES-TO RR-MS m 0)
          (list 'IMPLIES cpd-sq-bd '(CONVERGES-TO CC-MS s_ lv)))))))))))
(dk-peel!)
(define cpd-sq-eps
  (let ((l (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to '(CONVERGES-TO RR-MS m 0)))))))
    (car (filter (dk-head? 'FORALL) l))))
(fact 'cc-is-metric-space)
(cpd-pts-cc!)
(mac 'converges-to)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((eq? (cpd-head g) 'FORALL)
       (let* ((ep (dk-peel!))
              (eps (cadr (car (filter (dk-head? 'POS-RR) ep))))
              (nb (dk-skolem! (dk-deepest (lambda () (inst+ cpd-sq-eps eps)))))
              (cl (cpd-find "the m clause" (lambda (f) (and (eq? (cpd-head f) 'FORALL) (dk-contains? f nb) (dk-contains? f eps))))))
         (fact 'rr-pos-rr-in-rr eps)
         (ew nb)
         (dk-conj-close!
          (lambda ()
            (if (eq? (cpd-head (dk-goal)) 'FORALL)
                (let* ((lk (dk-peel!))
                       (j (cadr (car (filter (lambda (f) (and (eq? (cpd-head f) 'IN) (eq? (caddr f) 'NN))) lk))))
                       (mj (list 'm j)) (sj (list 's_ j)))
                  (fact 'fun-apply-type-c 's_ 'NN 'CC j)
                  (fact 'fun-apply-type-c 'm 'NN 'RR j)
                  (fact 'rr-zero-in)
                  (dk-deepest (lambda () (inst+ cl j)))
                  (fact 'rr-ms-dist mj 0)
                  (dk-have! (list '<= (list 'abs (list '- mj 0)) eps)
                    (lambda () (subst (list '= (list 'abs (list '- mj 0)) (list (list 'DIST 'RR-MS) mj 0))) (ass)))
                  (inst+ cpd-sq-bd j)
                  (subst (dk-fact! 'cc-ms-dist sj 'lv))
                  (fact 'rr-sub-in-rr mj 0)
                  (fact 'rr-le-abs (list '- mj 0))
                  (fact 'rr-abs-closed (list '- mj 0))
                  (fact 'cc-sub-in-cc sj 'lv)
                  (fact 'cc-magnitude-closed (list '- sj 'lv))
                  (dk-ineq! (list '<= (list 'magnitude (list '- sj 'lv)) mj)
                            (list '<= (list '- mj 0) (list 'abs (list '- mj 0)))
                            (list '<= (list 'abs (list '- mj 0)) eps)))
                (ass))))))
      ((eq? (cpd-head g) 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
      (#t (ass))))))
(qed 'cpd-cc-squeeze)

;;; h(j) = c s(j) + d t(j), s -> l, t -> m  =>  h -> c l + d m
(define cpd-lc-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (h cpdj_) (+ (* cpdc_ (s_ cpdj_)) (* cpdd_ (t_ cpdj_)))))))
(sp (make-wff
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ (FUN NN CC))
    (list 'FORALL 't_ (list 'IMPLIES '(IN t_ (FUN NN CC))
      (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN CC))
        (list 'FORALL 'lv (list 'IMPLIES '(IN lv CC)
          (list 'FORALL 'mv (list 'IMPLIES '(IN mv CC)
            (list 'FORALL 'cpdc_ (list 'IMPLIES '(IN cpdc_ CC)
              (list 'FORALL 'cpdd_ (list 'IMPLIES '(IN cpdd_ CC)
                (list 'IMPLIES cpd-lc-h
                  (list 'IMPLIES '(CONVERGES-TO CC-MS s_ lv)
                    (list 'IMPLIES '(CONVERGES-TO CC-MS t_ mv)
                      '(CONVERGES-TO CC-MS h (+ (* cpdc_ lv) (* cpdd_ mv))))))))))))))))))))))
(dk-peel!)
(define (cpd-lc-ds j) (list 'magnitude (list '- (list 's_ j) 'lv)))
(define (cpd-lc-dt j) (list 'magnitude (list '- (list 't_ j) 'mv)))
(define (cpd-lc-ns j) (list '* '(magnitude cpdc_) (cpd-lc-ds j)))
(define (cpd-lc-nt j) (list '* '(magnitude cpdd_) (cpd-lc-dt j)))
(define (cpd-lc-typ! j)
  (fact 'fun-apply-type-c 's_ 'NN 'CC j)
  (fact 'fun-apply-type-c 't_ 'NN 'CC j)
  (fact 'cc-sub-in-cc (list 's_ j) 'lv)
  (fact 'cc-sub-in-cc (list 't_ j) 'mv)
  (fact 'cc-magnitude-closed (list '- (list 's_ j) 'lv))
  (fact 'cc-magnitude-closed (list '- (list 't_ j) 'mv))
  (fact 'cc-magnitude-closed 'cpdc_)
  (fact 'cc-magnitude-closed 'cpdd_)
  (fact 'rr-mul-in-rr '(magnitude cpdc_) (cpd-lc-ds j))
  (fact 'rr-mul-in-rr '(magnitude cpdd_) (cpd-lc-dt j))
  (fact 'rr-add-in-rr (cpd-lc-ns j) (cpd-lc-nt j)))
(define cpd-lc-m1 (list 'VNB-LAMBDA 'cpdj_ 'NN (cpd-lc-ds 'cpdj_)))
(define cpd-lc-m2 (list 'VNB-LAMBDA 'cpdj_ 'NN (cpd-lc-dt 'cpdj_)))
(define cpd-lc-n1 (list 'VNB-LAMBDA 'cpdj_ 'NN (cpd-lc-ns 'cpdj_)))
(define cpd-lc-n2 (list 'VNB-LAMBDA 'cpdj_ 'NN (cpd-lc-nt 'cpdj_)))
(define cpd-lc-mm (list 'VNB-LAMBDA 'cpdj_ 'NN (list '+ (cpd-lc-ns 'cpdj_) (cpd-lc-nt 'cpdj_))))
(for-each (lambda (lam) (cpd-lam-typ! lam 'RR cpd-lc-typ!))
          (list cpd-lc-m1 cpd-lc-m2 cpd-lc-n1 cpd-lc-n2 cpd-lc-mm))
(cpd-lam-val! cpd-lc-m1 cpd-lc-ds cpd-lc-typ!)
(cpd-lam-val! cpd-lc-m2 cpd-lc-dt cpd-lc-typ!)
(fact 'cc-converges-magnitude-null 's_ 'lv cpd-lc-m1)
(fact 'cc-converges-magnitude-null 't_ 'mv cpd-lc-m2)
(fact 'cc-magnitude-closed 'cpdc_)
(fact 'cc-magnitude-closed 'cpdd_)
(fact 'cc-magnitude-nonneg 'cpdc_)
(fact 'cc-magnitude-nonneg 'cpdd_)
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list cpd-lc-n1 'cpdj_) (list '* '(magnitude cpdc_) (list cpd-lc-m1 'cpdj_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-lc-typ! j) (dk-lam-b!) (rfl))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list cpd-lc-n2 'cpdj_) (list '* '(magnitude cpdd_) (list cpd-lc-m2 'cpdj_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-lc-typ! j) (dk-lam-b!) (rfl))))
(fact 'rr-null-scale '(magnitude cpdc_) cpd-lc-m1 cpd-lc-n1)
(fact 'rr-null-scale '(magnitude cpdd_) cpd-lc-m2 cpd-lc-n2)
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list cpd-lc-mm 'cpdj_) (list '+ (list cpd-lc-n1 'cpdj_) (list cpd-lc-n2 'cpdj_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-lc-typ! j) (dk-lam-b!) (rfl))))
(fact 'rr-null-sum cpd-lc-n1 cpd-lc-n2 cpd-lc-mm)
(define cpd-lc-l '(+ (* cpdc_ lv) (* cpdd_ mv)))
(dk-have! '(AND (IN cpdc_ CC) (IN lv CC)))
(fact 'cc-mul-closed 'cpdc_ 'lv)
(dk-have! '(AND (IN cpdd_ CC) (IN mv CC)))
(fact 'cc-mul-closed 'cpdd_ 'mv)
(dk-have! '(AND (IN (* cpdc_ lv) CC) (IN (* cpdd_ mv) CC)))
(fact 'cc-add-closed '(* cpdc_ lv) '(* cpdd_ mv))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '<= (list 'magnitude (list '- '(h cpdj_) cpd-lc-l)) (list cpd-lc-mm 'cpdj_))))
  (lambda ()
    (let* ((j (dk-di-var!))
           (a (list '- (list 's_ j) 'lv)) (b (list '- (list 't_ j) 'mv))
           (ca (list '* 'cpdc_ a)) (db (list '* 'cpdd_ b)))
      (cpd-lc-typ! j)
      (dk-lam-b!)
      (inst+ cpd-lc-h j)
      (subst (list '= (list 'h j) (list '+ (list '* 'cpdc_ (list 's_ j)) (list '* 'cpdd_ (list 't_ j)))))
      (dk-have! (list '= (list '- (list '+ (list '* 'cpdc_ (list 's_ j)) (list '* 'cpdd_ (list 't_ j))) cpd-lc-l)
                         (list '+ ca db))
                (lambda () (crs)))
      (subst (list '= (list '- (list '+ (list '* 'cpdc_ (list 's_ j)) (list '* 'cpdd_ (list 't_ j))) cpd-lc-l)
                      (list '+ ca db)))
      (dk-have! (list 'AND '(IN cpdc_ CC) (list 'IN a 'CC)))
      (fact 'cc-mul-closed 'cpdc_ a)
      (fact 'cc-magnitude-mul 'cpdc_ a)
      (dk-have! (list 'AND '(IN cpdd_ CC) (list 'IN b 'CC)))
      (fact 'cc-mul-closed 'cpdd_ b)
      (fact 'cc-magnitude-mul 'cpdd_ b)
      (dk-have! (list 'AND (list 'IN ca 'CC) (list 'IN db 'CC)))
      (fact 'cc-magnitude-triangle ca db)
      (fact 'cc-add-closed ca db)
      (fact 'cc-magnitude-closed (list '+ ca db))
      (fact 'cc-magnitude-closed ca)
      (fact 'cc-magnitude-closed db)
      (dk-ineq! (list '<= (list 'magnitude (list '+ ca db)) (list '+ (list 'magnitude ca) (list 'magnitude db)))
                (list '= (list 'magnitude ca) (cpd-lc-ns j))
                (list '= (list 'magnitude db) (cpd-lc-nt j))))))
(fact 'cpd-cc-squeeze 'h cpd-lc-l cpd-lc-mm)
(ass)
(qed 'cc-limit-lincomb)

;;; h(j) = s(j+1), s -> l  =>  h -> l
(define cpd-sh-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (h cpdj_) (s_ (succ cpdj_))))))
(sp (make-wff
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ (FUN NN CC))
    (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN CC))
      (list 'FORALL 'lv (list 'IMPLIES '(IN lv CC)
        (list 'IMPLIES cpd-sh-h
          (list 'IMPLIES '(CONVERGES-TO CC-MS s_ lv) '(CONVERGES-TO CC-MS h lv)))))))))))
(dk-peel!)
(define cpd-sh-eps
  (let ((l (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to '(CONVERGES-TO CC-MS s_ lv)))))))
    (car (filter (dk-head? 'FORALL) l))))
(cpd-pts-cc!)
(mac 'converges-to)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((eq? (cpd-head g) 'FORALL)
       (let* ((ep (dk-peel!))
              (eps (cadr (car (filter (dk-head? 'POS-RR) ep))))
              (nb (dk-skolem! (dk-deepest (lambda () (inst+ cpd-sh-eps eps)))))
              (cl (cpd-find "the s clause" (lambda (f) (and (eq? (cpd-head f) 'FORALL) (dk-contains? f nb) (dk-contains? f eps))))))
         (ew nb)
         (dk-conj-close!
          (lambda ()
            (if (eq? (cpd-head (dk-goal)) 'FORALL)
                (let* ((lk (dk-peel!))
                       (j (cadr (car (filter (lambda (f) (and (eq? (cpd-head f) 'IN) (eq? (caddr f) 'NN))) lk))))
                       (sj (list 'succ j)))
                  (fact 'nn-succ-closed j)
                  (fact 'nn-le-succ j)
                  (fact 'nn-in-rr j) (fact 'nn-in-rr sj) (fact 'nn-in-rr nb)
                  (dk-have! (list '<= nb sj) (lambda () (dk-ineq! (list '<= nb j) (list '<= j sj))))
                  (inst+ cpd-sh-h j)
                  (subst (list '= (list 'h j) (list 's_ sj)))
                  (dk-deepest (lambda () (inst+ cl sj)))
                  (ass))
                (ass))))))
      ((eq? (cpd-head g) 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
      (#t (ass))))))
(qed 'cc-limit-shift)

;;; ======================================================================
;;; (2) THE SUM OF A CONVERGENT COMPLEX SERIES IS LINEAR.
;;; ======================================================================

(define cpd-sl-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (h cpdj_) (+ (* cpdc_ (f cpdj_)) (* cpdd_ (g cpdj_)))))))

;;; S(h, k) = c S(f, k) + d S(g, k)
(sp (make-wff
  (list 'FORALL 'cpdk_ (list 'IMPLIES '(IN cpdk_ NN)
    (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN CC))
      (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN CC))
        (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN CC))
          (list 'FORALL 'cpdc_ (list 'IMPLIES '(IN cpdc_ CC)
            (list 'FORALL 'cpdd_ (list 'IMPLIES '(IN cpdd_ CC)
              (list 'IMPLIES cpd-sl-h
                '(= (CC-SERIES-PARTIAL-SUM h cpdk_)
                    (+ (* cpdc_ (CC-SERIES-PARTIAL-SUM f cpdk_)) (* cpdd_ (CC-SERIES-PARTIAL-SUM g cpdk_)))))))))))))))))))
(define cpd-sl-br (use-induction))
(dk-focus! (cdr (assq 'base cpd-sl-br)))
(dk-peel!)
(mac 'cc-series-partial-sum-zero)
(crs)
(dk-focus! (cdr (assq 'step cpd-sl-br)))
(define cpd-sl-v (cdr (assq 'var cpd-sl-br)))
(define cpd-sl-ih (cdr (assq 'ih cpd-sl-br)))
(dk-peel!)
(let ((v cpd-sl-v))
  (dk-apply! cpd-sl-ih 'f 'g 'h 'cpdc_ 'cpdd_)
  (for-each (lambda (fn)
              (fact 'cc-series-partial-sum-in-cc v fn)
              (fact 'fun-apply-type-c fn 'NN 'CC v))
            '(f g h))
  (for-each (lambda (fn) (subst (dk-fact! 'cc-series-partial-sum-succ fn v))) '(f g h))
  (inst+ cpd-sl-h v)
  (subst (list '= (list 'CC-SERIES-PARTIAL-SUM 'h v)
                  (list '+ (list '* 'cpdc_ (list 'CC-SERIES-PARTIAL-SUM 'f v)) (list '* 'cpdd_ (list 'CC-SERIES-PARTIAL-SUM 'g v)))))
  (subst (list '= (list 'h v) (list '+ (list '* 'cpdc_ (list 'f v)) (list '* 'cpdd_ (list 'g v)))))
  (crs))
(qed 'cc-series-partial-sum-lincomb)

;;; the sum of c f + d g is c (sum f) + d (sum g)
(define (cpd-psq fn) (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM fn 'k)))
(define cpd-sl-l '(+ (* cpdc_ (CC-SERIES-LIMIT f)) (* cpdd_ (CC-SERIES-LIMIT g))))
(sp (make-wff
  (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN CC))
    (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN CC))
      (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN CC))
        (list 'FORALL 'cpdc_ (list 'IMPLIES '(IN cpdc_ CC)
          (list 'FORALL 'cpdd_ (list 'IMPLIES '(IN cpdd_ CC)
            (list 'IMPLIES cpd-sl-h
              (list 'IMPLIES '(CC-SERIES-CONVERGES f)
                (list 'IMPLIES '(CC-SERIES-CONVERGES g)
                  (list 'AND '(CC-SERIES-CONVERGES h) (list '= '(CC-SERIES-LIMIT h) cpd-sl-l)))))))))))))))))
(dk-peel!)
(define (cpd-sl-lim! fn)
  (let ((lim (list 'CC-SERIES-LIMIT fn)))
    (fact 'cc-series-limit-in-cc fn)
    (fact 'cc-series-limit-converges-to fn)
    (dk-have! (list 'CONVERGES-TO 'CC-MS (cpd-psq fn) lim)
      (lambda () (mac-h 'cc-series-converges-to (list 'CC-SERIES-CONVERGES-TO fn lim)) (ass)))))
(cpd-sl-lim! 'f)
(cpd-sl-lim! 'g)
(for-each (lambda (fn) (cpd-lam-typ! (cpd-psq fn) 'CC (lambda (j) (fact 'cc-series-partial-sum-in-cc j fn)))) '(f g h))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list (cpd-psq 'h) 'cpdj_)
                     (list '+ (list '* 'cpdc_ (list (cpd-psq 'f) 'cpdj_)) (list '* 'cpdd_ (list (cpd-psq 'g) 'cpdj_))))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (dk-lam-b!)
      (fact 'cc-series-partial-sum-lincomb j 'f 'g 'h 'cpdc_ 'cpdd_)
      (ass))))
(fact 'cc-limit-lincomb (cpd-psq 'f) (cpd-psq 'g) (cpd-psq 'h) '(CC-SERIES-LIMIT f) '(CC-SERIES-LIMIT g) 'cpdc_ 'cpdd_)
(dk-have! (list 'CC-SERIES-CONVERGES-TO 'h cpd-sl-l) (lambda () (mac 'cc-series-converges-to) (ass)))
(dk-have! '(CC-SERIES-CONVERGES h)
  (lambda () (mac 'cc-series-converges) (mac 'converges) (ew cpd-sl-l) (ass)))
(dk-have! '(AND (IN cpdc_ CC) (IN (CC-SERIES-LIMIT f) CC)))
(fact 'cc-mul-closed 'cpdc_ '(CC-SERIES-LIMIT f))
(dk-have! '(AND (IN cpdd_ CC) (IN (CC-SERIES-LIMIT g) CC)))
(fact 'cc-mul-closed 'cpdd_ '(CC-SERIES-LIMIT g))
(dk-have! '(AND (IN (* cpdc_ (CC-SERIES-LIMIT f)) CC) (IN (* cpdd_ (CC-SERIES-LIMIT g)) CC)))
(fact 'cc-add-closed '(* cpdc_ (CC-SERIES-LIMIT f)) '(* cpdd_ (CC-SERIES-LIMIT g)))
(cpd-sl-lim! 'h)
(fact 'cc-limit-unique (cpd-psq 'h) '(CC-SERIES-LIMIT h) cpd-sl-l)
(dk-conj-close! (lambda () (ass)))
(qed 'cc-series-limit-linear)

;;; ======================================================================
;;; (3) THE POWER ESTIMATE.  For |z|, |u| <= r and Q_k = z^(k+1) - u^(k+1)
;;; - (k+1) u^k (z - u):
;;;       r |Q_k|  <=  (k+1)^2 r^k |z - u|^2,
;;; by induction on k from the one-step recurrence
;;;       Q_(k+1)  =  z Q_k + (k+1) u^k (z - u)^2
;;; (no finite sum, no telescoping identity: see the header).
;;; ======================================================================

;;; typing helpers: land (IN T NN) / (IN T RR) / (IN T CC) for an arithmetic term
;;; whose atoms are already typed.
(define (cpd-and! a b)
  (let ((f (list 'AND a b)))
    ;; a conjunct equal to an open goal is hash-consed onto that node, and the
    ;; conjunction closer does not revisit it: close such leaves by assumption
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
                      (dk-conj-close! (lambda () (ass)))
                      (for-each (lambda (l)
                                  (if (and (member (dk-goal-of l) (list a b)) (dk-asm? (dk-goal-of l)))
                                      (begin (dk-focus! l) (ass))))
                                (dk-open-leaves)))))
    f))
(define (cpd-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cpd-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((cpd-op? t 'succ 2) (cpd-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (error "cpd-nn-typ!: cannot type" (expression->string t))))))
(define (cpd-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((or (dk-asm? (list 'IN t 'NN)) (cpd-op? t 'succ 2)) (cpd-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((cpd-op? t '* 3) (cpd-rr-typ! (cadr t)) (cpd-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cpd-op? t '+ 3) (cpd-rr-typ! (cadr t)) (cpd-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((cpd-op? t '- 3) (cpd-rr-typ! (cadr t)) (cpd-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((cpd-op? t 'magnitude 2) (cpd-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cpd-op? t 'power 3) (cpd-rr-typ! (cadr t)) (cpd-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((cpd-op? t 'SERIES-PARTIAL-SUM 3) (cpd-nn-typ! (caddr t)) (fact 'series-partial-sum-in-rr (caddr t) (cadr t)) typ)
          (#t (error "cpd-rr-typ!: cannot type" (expression->string t))))))
(define (cpd-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((or (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN)) (cpd-op? t 'succ 2)
               (cpd-op? t 'magnitude 2) (eqv? t 1))
           (cpd-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((cpd-op? t '- 3) (cpd-cc-typ! (cadr t)) (cpd-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cpd-op? t '- 2) (cpd-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((cpd-op? t '+ 3) (cpd-cc-typ! (cadr t)) (cpd-cc-typ! (caddr t))
           (cpd-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cpd-op? t '* 3) (cpd-cc-typ! (cadr t)) (cpd-cc-typ! (caddr t))
           (cpd-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cpd-op? t 'power 3) (cpd-cc-typ! (cadr t)) (cpd-nn-typ! (caddr t))
           (cpd-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cpd-op? t 'CC-SERIES-PARTIAL-SUM 3) (cpd-nn-typ! (caddr t)) (fact 'cc-series-partial-sum-in-cc (caddr t) (cadr t)) typ)
          ((cpd-op? t 'recip 2) (cpd-cc-typ! (cadr t))
           (cpd-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0))) (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "cpd-cc-typ!: cannot type" (expression->string t))))))

;;; 0 <= a, 0 <= b (both in context, typed)  ==>  (<= 0 (* a b)), typed
(define (cpd-nonneg-prod! a b)
  (let ((f (list '<= 0 (list '* a b))))
    (cpd-rr-typ! (list '* a b))
    (if (not (dk-asm? f))
        (begin
          (cpd-and! (list 'IN a 'RR) (list 'IN b 'RR))
          (cpd-and! (list '<= 0 a) (list '<= 0 b))
          (fact 'rr-leq-mul-nonneg a b)))
    f))

;;; x^(succ n) = x . x^n, landed (x typed in CC, n in NN); returns the equation
(define (cpd-pow-succ! x n)
  (cpd-cc-typ! x) (cpd-nn-typ! n)
  (cpd-and! (list 'IN x 'CC) (list 'IN n 'NN))
  (dk-fact! 'power-succ x n))

(define (cpd-Q k)
  (list '- (list '- (list 'power 'cpdz_ (list 'succ k)) (list 'power 'cpdu_ (list 'succ k)))
           (list '* (list '* (list 'succ k) (list 'power 'cpdu_ k)) '(- cpdz_ cpdu_))))
(define cpd-W '(* (magnitude (- cpdz_ cpdu_)) (magnitude (- cpdz_ cpdu_))))
(define (cpd-est-rhs k)
  (list '* (list '* (list '* (list 'succ k) (list 'succ k)) (list 'power 'cpdr_ k)) cpd-W))

(sp (make-wff
  (list 'FORALL 'cpdk_ (list 'IMPLIES '(IN cpdk_ NN)
    (list 'FORALL 'cpdz_ (list 'IMPLIES '(IN cpdz_ CC)
      (list 'FORALL 'cpdu_ (list 'IMPLIES '(IN cpdu_ CC)
        (list 'FORALL 'cpdr_ (list 'IMPLIES '(IN cpdr_ RR)
          (list 'IMPLIES '(<= (magnitude cpdz_) cpdr_)
            (list 'IMPLIES '(<= (magnitude cpdu_) cpdr_)
              (list '<= (list '* 'cpdr_ (list 'magnitude (cpd-Q 'cpdk_))) (cpd-est-rhs 'cpdk_))))))))))))))

;;; after the peel: moduli typed and non-negative, 0 <= r, W typed and >= 0
(define (cpd-est-setup!)
  (for-each (lambda (x) (cpd-rr-typ! (list 'magnitude x)) (fact 'cc-magnitude-nonneg x))
            '(cpdz_ cpdu_ (- cpdz_ cpdu_)))
  (dk-have! '(<= 0 cpdr_) (lambda () (dk-ineq! '(<= 0 (magnitude cpdz_)) '(<= (magnitude cpdz_) cpdr_))))
  (cpd-cc-typ! 'cpdr_)
  (cpd-nonneg-prod! '(magnitude (- cpdz_ cpdu_)) '(magnitude (- cpdz_ cpdu_))))

(define cpd-es-br (use-induction))
(dk-focus! (cdr (assq 'base cpd-es-br)))
(dk-peel!)
(cpd-est-setup!)
(let* ((q0 (cpd-Q 0)) (s0 '(succ 0)))
  (for-each cpd-cc-typ! (list '(power cpdz_ 0) '(power cpdu_ 0) q0))
  (let ((ez (cpd-pow-succ! 'cpdz_ 0)) (eu (cpd-pow-succ! 'cpdu_ 0)))
    (fact 'power-zero 'cpdz_)
    (fact 'power-zero 'cpdu_)
    (fact 'nn-one-is-succ-zero)
    (dk-have! (list '= q0 0)
      (lambda ()
        (subst ez) (subst eu)
        (subst '(= (power cpdz_ 0) 1)) (subst '(= (power cpdu_ 0) 1))
        (subst '(= (succ 0) 1))
        (crs))))
  (subst (list '= q0 0))
  (fact 'cc-magnitude-zero)
  (subst '(= (magnitude 0) 0))
  (fact 'nn-zero-le s0)
  (cpd-rr-typ! s0)
  (cpd-nonneg-prod! s0 s0)
  (cpd-rr-typ! '(power cpdr_ 0))
  (fact 'rr-power-nonneg 0 'cpdr_)
  (cpd-nonneg-prod! (list '* s0 s0) '(power cpdr_ 0))
  (cpd-nonneg-prod! (list '* (list '* s0 s0) '(power cpdr_ 0)) cpd-W)
  (dk-ineq! (list '<= 0 (cpd-est-rhs 0))))
(dk-focus! (cdr (assq 'step cpd-es-br)))
(define cpd-es-v (cdr (assq 'var cpd-es-br)))
(define cpd-es-ih (cdr (assq 'ih cpd-es-br)))
(dk-peel!)
(cpd-est-setup!)
(let* ((v cpd-es-v) (s (list 'succ v)) (ss (list 'succ s))
       (z 'cpdz_) (u 'cpdu_) (r 'cpdr_) (w cpd-W)
       (qv (cpd-Q v)) (qs (cpd-Q s))
       (mqv (list 'magnitude qv)) (mqs (list 'magnitude qs))
       (uv (list 'power u v)) (p (list 'power r v))
       (mu (list 'power '(magnitude cpdu_) v))
       (zq (list '* z qv))
       (xx (list '* (list '* s uv) '(* (- cpdz_ cpdu_) (- cpdz_ cpdu_))))
       (id (list '+ zq xx))
       (smw (list '* (list '* s mu) w))
       (spw (list '* (list '* s p) w))
       (rq (list '* r mqv))
       (yy (list '+ rq spw))
       (t1 (list '* r rq))
       (t2 (list '* r spw))
       (t3 (list '* r (cpd-est-rhs v)))
       (kk (list '* (list '+ s 1) (list '* (list '* r p) w))))
  (dk-apply! cpd-es-ih z u r)
  (for-each cpd-cc-typ! (list qv qs id))
  (fact 'nn-zero-le s)
  (for-each cpd-rr-typ! (list mqv mqs p mu smw spw rq yy t1 t2 t3 (list 'magnitude id) (list 'magnitude zq)
                              (list 'magnitude xx) (list '* '(magnitude cpdz_) mqv)))
  (fact 'cc-magnitude-nonneg qv)
  (fact 'rr-power-nonneg v r)
  (fact 'rr-power-nonneg v '(magnitude cpdu_))
  ;; the recurrence
  (let ((e1 (cpd-pow-succ! z s)) (e2 (cpd-pow-succ! u s)) (e3 (cpd-pow-succ! u v))
        (e4 (dk-fact! 'nn-succ-plus-one s)))
    (dk-have! (list '= qs id)
      (lambda () (subst e1) (subst e2) (subst e3) (subst e4) (crs))))
  (dk-have! (list '= mqs (list 'magnitude id)) (lambda () (subst (list '= qs id)) (rfl)))
  ;; |Q_(k+1)| <= |z| |Q_k| + (k+1) |u|^k W
  (cpd-and! (list 'IN zq 'CC) (list 'IN xx 'CC))
  (fact 'cc-magnitude-triangle zq xx)
  (cpd-and! (list 'IN z 'CC) (list 'IN qv 'CC))
  (fact 'cc-magnitude-mul z qv)
  (let ((su (list '* s uv)) (dd '(* (- cpdz_ cpdu_) (- cpdz_ cpdu_))))
    (cpd-cc-typ! su) (cpd-cc-typ! dd)
    (cpd-and! (list 'IN su 'CC) (list 'IN dd 'CC))
    (fact 'cc-magnitude-mul su dd)
    (cpd-and! (list 'IN s 'CC) (list 'IN uv 'CC))
    (fact 'cc-magnitude-mul s uv)
    (cpd-and! '(IN (- cpdz_ cpdu_) CC) '(IN (- cpdz_ cpdu_) CC))
    (fact 'cc-magnitude-mul '(- cpdz_ cpdu_) '(- cpdz_ cpdu_))
    (fact 'rr-magnitude-is-abs s)
    (fact 'rr-abs-of-nonneg s)
    (fact 'cc-magnitude-power v u)
    (dk-have! (list '= (list 'magnitude xx) smw)
      (lambda ()
        (subst (list '= (list 'magnitude xx) (list '* (list 'magnitude su) (list 'magnitude dd))))
        (subst (list '= (list 'magnitude su) (list '* (list 'magnitude s) (list 'magnitude uv))))
        (subst (list '= (list 'magnitude dd) w))
        (subst (list '= (list 'magnitude s) (list 'abs s)))
        (subst (list '= (list 'abs s) s))
        (subst (list '= (list 'magnitude uv) mu))
        (rfl))))
  (fact 'rr-mul-le-right '(magnitude cpdz_) r mqv)
  (fact 'rr-power-mono-base v '(magnitude cpdu_) r)
  (cpd-rr-typ! (list '* s mu)) (cpd-rr-typ! (list '* s p))
  (cpd-and! (list '<= 0 s) (list '<= mu p))
  (fact 'rr-le-scale-nonneg s mu p)
  (fact 'rr-mul-le-right (list '* s mu) (list '* s p) w)
  (dk-have! (list '<= mqs yy)
    (lambda ()
      (dk-ineq! (list '= mqs (list 'magnitude id))
                (list '<= (list 'magnitude id) (list '+ (list 'magnitude zq) (list 'magnitude xx)))
                (list '= (list 'magnitude zq) (list '* '(magnitude cpdz_) mqv))
                (list '= (list 'magnitude xx) smw)
                (list '<= (list '* '(magnitude cpdz_) mqv) rq)
                (list '<= smw spw))))
  ;; multiply by r and use the induction hypothesis
  (cpd-and! (list '<= 0 r) (list '<= mqs yy))
  (fact 'rr-le-scale-nonneg r mqs yy)
  (dk-have! (list '= (list '* r yy) (list '+ t1 t2)) (lambda () (crs)))
  (cpd-and! (list '<= 0 r) (list '<= rq (cpd-est-rhs v)))
  (fact 'rr-le-scale-nonneg r rq (cpd-est-rhs v))
  ;; the right-hand side at k+1
  (let ((e5 (cpd-pow-succ! r v)) (e6 (list '= ss (list '+ s 1))))
    (dk-have! (list '= (cpd-est-rhs s) (list '+ (list '+ t3 t2) kk))
      (lambda () (subst e5) (subst e6) (crs))))
  (fact 'nn-zero-le v)
  (cpd-rr-typ! (list '+ s 1))
  (dk-have! (list '<= 0 (list '+ s 1)) (lambda () (dk-ineq! (list '<= 0 s))))
  (cpd-nonneg-prod! r p)
  (cpd-nonneg-prod! (list '* r p) w)
  (cpd-nonneg-prod! (list '+ s 1) (list '* (list '* r p) w))
  (cpd-rr-typ! (list '* r mqs))
  (cpd-rr-typ! (list '* r yy))
  (cpd-rr-typ! (cpd-est-rhs s))
  (dk-ineq! (list '<= (list '* r mqs) (list '* r yy))
            (list '= (list '* r yy) (list '+ t1 t2))
            (list '<= t1 t3)
            (list '= (cpd-est-rhs s) (list '+ (list '+ t3 t2) kk))
            (list '<= 0 kk)))
(qed 'cpd-power-second-order)

;;; the first-order estimate, the one the batch-25 report asked for:
;;;       |z^(k+1) - u^(k+1)|  <=  (k+1) r^k |z - u|      (|z|, |u| <= r),
;;; from  z^(k+2) - u^(k+2) = z (z^(k+1) - u^(k+1)) + u^(k+1) (z - u).
(define (cpd-D k) (list '- (list 'power 'cpdz_ (list 'succ k)) (list 'power 'cpdu_ (list 'succ k))))
(define (cpd-d-rhs k) (list '* (list '* (list 'succ k) (list 'power 'cpdr_ k)) '(magnitude (- cpdz_ cpdu_))))
(sp (make-wff
  (list 'FORALL 'cpdk_ (list 'IMPLIES '(IN cpdk_ NN)
    (list 'FORALL 'cpdz_ (list 'IMPLIES '(IN cpdz_ CC)
      (list 'FORALL 'cpdu_ (list 'IMPLIES '(IN cpdu_ CC)
        (list 'FORALL 'cpdr_ (list 'IMPLIES '(IN cpdr_ RR)
          (list 'IMPLIES '(<= (magnitude cpdz_) cpdr_)
            (list 'IMPLIES '(<= (magnitude cpdu_) cpdr_)
              (list '<= (list 'magnitude (cpd-D 'cpdk_)) (cpd-d-rhs 'cpdk_))))))))))))))
(define cpd-d-br (use-induction))
(dk-focus! (cdr (assq 'base cpd-d-br)))
(dk-peel!)
(cpd-est-setup!)
(let* ((d0 (cpd-D 0)) (m '(magnitude (- cpdz_ cpdu_))))
  (for-each cpd-cc-typ! (list '(power cpdz_ 0) '(power cpdu_ 0) d0))
  (let ((ez (cpd-pow-succ! 'cpdz_ 0)) (eu (cpd-pow-succ! 'cpdu_ 0)))
    (fact 'power-zero 'cpdz_) (fact 'power-zero 'cpdu_) (fact 'power-zero 'cpdr_)
    (fact 'nn-one-is-succ-zero)
    (dk-have! (list '= d0 '(- cpdz_ cpdu_))
      (lambda ()
        (subst ez) (subst eu)
        (subst '(= (power cpdz_ 0) 1)) (subst '(= (power cpdu_ 0) 1))
        (crs))))
  (subst (list '= d0 '(- cpdz_ cpdu_)))
  (subst '(= (power cpdr_ 0) 1))
  (subst '(= (succ 0) 1))
  (cpd-rr-typ! (list '* '(* 1 1) m))
  (dk-have! (list '= (list '* '(* 1 1) m) m) (lambda () (crs)))
  (dk-ineq! (list '= (list '* '(* 1 1) m) m)))
(dk-focus! (cdr (assq 'step cpd-d-br)))
(define cpd-d-v (cdr (assq 'var cpd-d-br)))
(define cpd-d-ih (cdr (assq 'ih cpd-d-br)))
(dk-peel!)
(cpd-est-setup!)
(let* ((v cpd-d-v) (s (list 'succ v)) (z 'cpdz_) (u 'cpdu_) (r 'cpdr_)
       (m '(magnitude (- cpdz_ cpdu_)))
       (dv (cpd-D v)) (ds (cpd-D s)) (ma (list 'magnitude dv)) (mds (list 'magnitude ds))
       (us (list 'power u s)) (mus (list 'power '(magnitude cpdu_) s))
       (p (list 'power r v)) (ps (list 'power r s))
       (zd (list '* z dv)) (xx (list '* us '(- cpdz_ cpdu_))) (id (list '+ zd xx))
       (rhsv (cpd-d-rhs v)) (rhss (cpd-d-rhs s)))
  (dk-apply! cpd-d-ih z u r)
  (for-each cpd-cc-typ! (list dv ds id))
  (fact 'nn-zero-le s)
  (for-each cpd-rr-typ! (list ma mds mus p ps rhsv rhss (list 'magnitude id) (list 'magnitude zd) (list 'magnitude xx)
                              (list '* '(magnitude cpdz_) ma) (list '* r ma) (list '* mus m) (list '* ps m) (list '* r rhsv)))
  (fact 'cc-magnitude-nonneg dv)
  (let ((e1 (cpd-pow-succ! z s)) (e2 (cpd-pow-succ! u s)))
    (dk-have! (list '= ds id) (lambda () (subst e1) (subst e2) (crs))))
  (dk-have! (list '= mds (list 'magnitude id)) (lambda () (subst (list '= ds id)) (rfl)))
  (cpd-and! (list 'IN zd 'CC) (list 'IN xx 'CC))
  (fact 'cc-magnitude-triangle zd xx)
  (cpd-and! (list 'IN z 'CC) (list 'IN dv 'CC))
  (fact 'cc-magnitude-mul z dv)
  (cpd-and! (list 'IN us 'CC) '(IN (- cpdz_ cpdu_) CC))
  (fact 'cc-magnitude-mul us '(- cpdz_ cpdu_))
  (fact 'cc-magnitude-power s u)
  (dk-have! (list '= (list 'magnitude xx) (list '* mus m))
    (lambda ()
      (subst (list '= (list 'magnitude xx) (list '* (list 'magnitude us) m)))
      (subst (list '= (list 'magnitude us) mus))
      (rfl)))
  (fact 'rr-mul-le-right '(magnitude cpdz_) r ma)
  (fact 'rr-power-mono-base s '(magnitude cpdu_) r)
  (fact 'rr-mul-le-right mus ps m)
  (cpd-and! (list '<= 0 r) (list '<= ma rhsv))
  (fact 'rr-le-scale-nonneg r ma rhsv)
  (let ((e3 (cpd-pow-succ! r v)) (e4 (dk-fact! 'nn-succ-plus-one s)))
    (dk-have! (list '= rhss (list '+ (list '* r rhsv) (list '* ps m)))
      (lambda () (subst e3) (subst e4) (crs))))
  (dk-ineq! (list '= mds (list 'magnitude id))
            (list '<= (list 'magnitude id) (list '+ (list 'magnitude zd) (list 'magnitude xx)))
            (list '= (list 'magnitude zd) (list '* '(magnitude cpdz_) ma))
            (list '= (list 'magnitude xx) (list '* mus m))
            (list '<= (list '* '(magnitude cpdz_) ma) (list '* r ma))
            (list '<= (list '* r ma) (list '* r rhsv))
            (list '<= (list '* mus m) (list '* ps m))
            (list '= rhss (list '+ (list '* r rhsv) (list '* ps m)))))
(qed 'cc-power-diff-bound)

;;; ======================================================================
;;; (4) THE DERIVED SERIES HAS THE SAME RADIUS.
;;; ======================================================================

;;; the term sequence k |-> |c(k)| t^k
(define (cpd-tm c t) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list 'magnitude (list c 'cpsk_)) (list 'power t 'cpsk_))))

;;; |c(j)| t^j typed and >= 0, for c in FUN(NN, CC), t >= 0 typed, j in NN
(define (cpd-tm-pt! c t j)
  (let ((m (list 'magnitude (list c j))) (p (list 'power t j)))
    (fact 'fun-apply-type-c c 'NN 'CC j)
    (cpd-rr-typ! m) (fact 'cc-magnitude-nonneg (list c j))
    (cpd-rr-typ! p) (fact 'rr-power-nonneg j t)
    (cpd-nonneg-prod! m p)))
(define (cpd-tm-typ! c t)
  (cpd-lam-typ! (cpd-tm c t) 'RR (lambda (j) (cpd-tm-pt! c t j))))
(define (cpd-tm-nonneg! c t)
  (let ((f (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '<= 0 (list (cpd-tm c t) 'cpdj_))))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (let ((j (dk-di-var!))) (cpd-tm-pt! c t j) (dk-lam-b!) (ass)))))
    f))

;;; |cg(j)| = |cf(j+1)| for all j, t > 0:
;;;   sum_k |cf(k)| t^k converges  iff  sum_k |cg(k)| t^k converges
(define cpd-shc-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (magnitude (cg cpdj_)) (magnitude (cf (succ cpdj_)))))))
(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'FORALL 'cg (list 'IMPLIES '(IN cg (FUN NN CC))
      (list 'IMPLIES cpd-shc-h
        (list 'FORALL 'cpdt_ (list 'IMPLIES '(IN cpdt_ RR) (list 'IMPLIES '(< 0 cpdt_)
          (list 'IFF (list 'SERIES-CONVERGES (cpd-tm 'cf 'cpdt_)) (list 'SERIES-CONVERGES (cpd-tm 'cg 'cpdt_)))))))))))))
(dk-peel!)
(fact 'rr-lt-implies-le 0 'cpdt_)
(cpd-cc-typ! 'cpdt_)
(define cpd-shc-b   ; k |-> |cg(k)| t^(k+1), the shift of the first series
  (list 'VNB-LAMBDA 'cpdk_ 'NN (list '* '(magnitude (cg cpdk_)) '(power cpdt_ (succ cpdk_)))))
(define (cpd-shc-pt! j)
  (cpd-tm-pt! 'cf 'cpdt_ j) (cpd-tm-pt! 'cg 'cpdt_ j)
  (cpd-nn-typ! (list 'succ j))
  (cpd-tm-pt! 'cf 'cpdt_ (list 'succ j))
  (cpd-rr-typ! (list 'power 'cpdt_ (list 'succ j)))
  (fact 'rr-power-nonneg (list 'succ j) 'cpdt_)
  (cpd-nonneg-prod! (list 'magnitude (list 'cg j)) (list 'power 'cpdt_ (list 'succ j))))
(cpd-tm-typ! 'cf 'cpdt_)
(cpd-tm-typ! 'cg 'cpdt_)
(cpd-lam-typ! cpd-shc-b 'RR cpd-shc-pt!)
(cpd-tm-nonneg! 'cf 'cpdt_)
(cpd-tm-nonneg! 'cg 'cpdt_)
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '<= 0 (list cpd-shc-b 'cpdj_))))
  (lambda () (let ((j (dk-di-var!))) (cpd-shc-pt! j) (dk-lam-b!) (ass))))
;; b(j) = a(j+1)
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list cpd-shc-b 'cpdj_) (list (cpd-tm 'cf 'cpdt_) '(succ cpdj_)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (cpd-shc-pt! j)
      (dk-lam-b!)
      (inst+ cpd-shc-h j)
      (subst (list '= (list 'magnitude (list 'cg j)) (list 'magnitude (list 'cf (list 'succ j)))))
      (rfl))))
(fact 'series-shift-converges-iff (cpd-tm 'cf 'cpdt_) cpd-shc-b)
;; b(j) = t . (|cg(j)| t^j)  and  |cg(j)| t^j = recip(t) . b(j)
(fact 'rr-pos-ne-zero 'cpdt_)
(cpd-and! '(IN cpdt_ RR) '(NOT (= cpdt_ 0)))
(fact 'rr-recip-closed 'cpdt_)
(fact 'rr-recip-pos 'cpdt_)
(fact 'rr-lt-implies-le 0 '(recip cpdt_))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list cpd-shc-b 'cpdj_) (list '* 'cpdt_ (list (cpd-tm 'cg 'cpdt_) 'cpdj_)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (cpd-shc-pt! j)
      (dk-lam-b!)
      (subst (cpd-pow-succ! 'cpdt_ j))
      (crs))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list (cpd-tm 'cg 'cpdt_) 'cpdj_) (list '* '(recip cpdt_) (list cpd-shc-b 'cpdj_)))))
  (lambda ()
    (let* ((j (dk-di-var!))
           (bj (list cpd-shc-b j)) (aj (list (cpd-tm 'cg 'cpdt_) j)))
      (cpd-shc-pt! j)
      (fact 'fun-apply-type-c cpd-shc-b 'NN 'RR j)
      (fact 'fun-apply-type-c (cpd-tm 'cg 'cpdt_) 'NN 'RR j)
      (dk-deepest (lambda () (inst+ (dk-pick (lambda (f) (and (eq? (cpd-head f) 'FORALL)
                                                              (dk-contains? f (list '* 'cpdt_ (list (cpd-tm 'cg 'cpdt_) 'cpdj_)))))
                                             "b = t a") j)))
      (fact 'rr-recip-solve 'cpdt_ bj aj)
      (ass))))
(define cpd-shc-iff (list 'IFF (list 'SERIES-CONVERGES (cpd-tm 'cf 'cpdt_)) (list 'SERIES-CONVERGES cpd-shc-b)))
(dk-iff! (lambda (g) (equal? g (list 'SERIES-CONVERGES (cpd-tm 'cg 'cpdt_))))
  (lambda ()
    (dk-have! (list 'SERIES-CONVERGES cpd-shc-b)
      (lambda () (dk-only! cpd-shc-iff (list 'SERIES-CONVERGES (cpd-tm 'cf 'cpdt_))) (prop)))
    (fact 'series-scale-converges cpd-shc-b '(recip cpdt_) (cpd-tm 'cg 'cpdt_))
    (ass))
  (lambda ()
    (fact 'series-scale-converges (cpd-tm 'cg 'cpdt_) 'cpdt_ cpd-shc-b)
    (dk-only! cpd-shc-iff (list 'SERIES-CONVERGES cpd-shc-b))
    (prop)))
(qed 'cps-shift-conv)

;;; the set S(c) = {r in RR : 0 <= r, sum |c_k| r^k converges} whose ESUP is the
;;; radius, read off the unfolded goal; its subset fact and ESUP facts
(define (cpd-S-setup! s)
  (if (not (dk-asm? (list 'SUBSET s 'RR-POS-STAR)))
      (dk-have! (list 'SUBSET s 'RR-POS-STAR)
        (lambda ()
          (mac 'subset-def)
          (let ((x (dk-di-var!)))
            (sep-me (list 'IN x s))
            (dk-split-all!)
            (mac 'rr-pos-star-membership)
            (oi-l)
            (dk-conj-close! (lambda () (ass)))))))
  (fact 'esup-in s)
  (fact 'rr-pos-star-nonneg (list 'ESUP s))
  (dk-fact! 'esup-upper s))

;;; the radius is in [0, +inf]
(sp (make-wff '(FORALL cf (IN (CPS-RADIUS cf) RR-POS-STAR))))
(di)
(mac 'CPS-RADIUS)
(cpd-S-setup! (cadr (cadr (dk-goal))))
(ass)
(qed 'cps-radius-in)

;;; if sum |cf_k| t^k < inf implies sum |cg_k| t^k < inf for every t > 0, then
;;; the radius of cf is at most that of cg
(define cpd-rm-h
  (list 'FORALL 'cpdt_ (list 'IMPLIES '(IN cpdt_ RR) (list 'IMPLIES '(< 0 cpdt_)
    (list 'IMPLIES (list 'SERIES-CONVERGES (cpd-tm 'cf 'cpdt_)) (list 'SERIES-CONVERGES (cpd-tm 'cg 'cpdt_)))))))
(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'FORALL 'cg (list 'IMPLIES '(IN cg (FUN NN CC))
      (list 'IMPLIES cpd-rm-h '(<= (CPS-RADIUS cf) (CPS-RADIUS cg)))))))))
(dk-peel!)
(mac 'CPS-RADIUS)
(let* ((g (dk-goal))
       (sa (cadr (cadr g))) (sb (cadr (caddr g))) (eb (list 'ESUP sb)))
  (cpd-S-setup! sa)
  (let ((upb (cpd-S-setup! sb)))
    (dk-have! (list 'AND (list 'IN eb 'RR-POS-STAR)
                    (list 'FORALL 'cpdx_ (list 'IMPLIES (list 'IN 'cpdx_ sa) (list '<= 'cpdx_ eb))))
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (eq? (cpd-head (dk-goal)) 'FORALL))
                (ass)
                (let* ((x (dk-di-var!))
                       (ca (subst-free (cadr sa) x (cadddr sa)))
                       (cb (subst-free (cadr sb) x (cadddr sb))))
                  (dk-have! (list 'AND (list 'IN x 'RR) ca)
                    (lambda () (sep-me (list 'IN x sa)) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
                  (dk-split-all! (list (list 'AND (list 'IN x 'RR) ca)))
                  (if (dk-asm? ca) (dk-split-all! (list ca)))
                  (use-em (list '= 0 x)
                    (lambda ()
                      (subst (list '= x 0))
                      (ass))
                    (lambda ()
                      (cpd-and! (list '<= 0 x) (list 'NOT (list '= 0 x)))
                      (fact 'rr-zero-in)
                      (fact 'rr-le-ne-lt 0 x)
                      (dk-deepest (lambda () (inst+ cpd-rm-h x)))
                      (dk-have! cb (lambda () (dk-conj-close! (lambda () (ass)))))
                      (dk-have! (list 'IN x sb) (lambda () (dk-close-all! (lambda () (sep-mi)))))
                      (inst+ upb x)
                      (ass)))))))))
    (fact 'esup-least sa eb)
    (ass)))
(qed 'cps-radius-mono)

;;; ---- the radius of the derived series -------------------------------------
;;; dcf(k) = (k+1) cf(k+1): the coefficients of g(z) = sum_{n>=1} n a_n z^(n-1),
;;; reindexed from 0.
(define cpd-dcf-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (dcf cpdj_) (* (succ cpdj_) (cf (succ cpdj_)))))))
(define cpd-rd-cg '(VNB-LAMBDA cpdk_ NN cpdk_))
(define cpd-rd-cfg '(VNB-LAMBDA cpdk_ NN (* (cf cpdk_) cpdk_)))
(define cpd-rd-cf1 '(VNB-LAMBDA cpdk_ NN (cf (succ cpdk_))))
(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'FORALL 'dcf (list 'IMPLIES '(IN dcf (FUN NN CC))
      (list 'IMPLIES cpd-dcf-h '(= (CPS-RADIUS dcf) (CPS-RADIUS cf)))))))))
(dk-peel!)
(define (cpd-rd-typ! j)
  (cpd-nn-typ! (list 'succ j))
  (fact 'fun-apply-type-c 'cf 'NN 'CC j)
  (fact 'fun-apply-type-c 'cf 'NN 'CC (list 'succ j))
  (fact 'fun-apply-type-c 'dcf 'NN 'CC j)
  (cpd-cc-typ! j))
(cpd-lam-typ! cpd-rd-cg 'CC cpd-rd-typ!)
(cpd-lam-typ! cpd-rd-cfg 'CC (lambda (j) (cpd-rd-typ! j) (cpd-cc-typ! (list '* (list 'cf j) j))))
(cpd-lam-typ! cpd-rd-cf1 'CC cpd-rd-typ!)
(for-each (lambda (c) (fact 'cps-radius-in c)) (list 'cf 'dcf cpd-rd-cfg))
;; (a) R(cf) <= R(cfg), Lemma 2.9 with b_k = k (C = 1, m = 1)
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN)
            (list '= (list cpd-rd-cfg 'cpsk_) (list '* '(cf cpsk_) (list cpd-rd-cg 'cpsk_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-rd-typ! j) (dk-lam-b!) (rfl))))
(fact 'rr-one-in)
(fact 'nn-one-in)
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN)
            (list '<= (list 'magnitude (list cpd-rd-cg 'cpsk_)) '(* 1 (power cpsk_ 1)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (cpd-rd-typ! j)
      (dk-lam-b!)
      (cpd-rr-typ! j)
      (fact 'nn-zero-le j)
      (subst (dk-fact! 'rr-magnitude-is-abs j))
      (subst (dk-fact! 'rr-abs-of-nonneg j))
      (fact 'nn-one-is-succ-zero)
      (subst '(= 1 (succ 0)))
      (subst (cpd-pow-succ! j 0))
      (fact 'power-zero j)
      (subst (list '= (list 'power j 0) 1))
      (subst '(= (succ 0) 1))
      (dk-ineq!))))
(fact 'cps-radius-factor 'cf cpd-rd-cg cpd-rd-cfg 1 1)
;; (b) R(cfg) <= R(dcf): |dcf(j)| = |cfg(j+1)|, then the shift
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= '(magnitude (dcf cpdj_)) (list 'magnitude (list cpd-rd-cfg '(succ cpdj_))))))
  (lambda ()
    (let* ((j (dk-di-var!)) (s (list 'succ j)))
      (cpd-rd-typ! j)
      (cpd-rd-typ! s)
      (dk-lam-b!)
      (inst+ cpd-dcf-h j)
      (subst (list '= (list 'dcf j) (list '* s (list 'cf s))))
      (cpd-cc-typ! (list '* s (list 'cf s)))
      (dk-have! (list '= (list '* s (list 'cf s)) (list '* (list 'cf s) s)) (lambda () (crs)))
      (subst (list '= (list '* s (list 'cf s)) (list '* (list 'cf s) s)))
      (cpd-rr-typ! (list 'magnitude (list '* (list 'cf s) s)))
      (rfl))))
(dk-have! (list 'FORALL 'cpdt_ (list 'IMPLIES '(IN cpdt_ RR) (list 'IMPLIES '(< 0 cpdt_)
            (list 'IMPLIES (list 'SERIES-CONVERGES (cpd-tm cpd-rd-cfg 'cpdt_)) (list 'SERIES-CONVERGES (cpd-tm 'dcf 'cpdt_))))))
  (lambda ()
    (dk-peel!)
    (let ((iff (dk-fact! 'cps-shift-conv cpd-rd-cfg 'dcf 'cpdt_)))
      (dk-only! iff (list 'SERIES-CONVERGES (cpd-tm cpd-rd-cfg 'cpdt_)))
      (prop))))
;; (c) R(dcf) <= R(cf): |cf(j+1)| t^j <= |dcf(j)| t^j, then the shift back
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list 'magnitude (list cpd-rd-cf1 'cpdj_)) '(magnitude (cf (succ cpdj_))))))
  (lambda () (let ((j (dk-di-var!))) (cpd-rd-typ! j) (dk-lam-b!) (cpd-rr-typ! (list 'magnitude (list 'cf (list 'succ j)))) (rfl))))
(dk-have! (list 'FORALL 'cpdt_ (list 'IMPLIES '(IN cpdt_ RR) (list 'IMPLIES '(< 0 cpdt_)
            (list 'IMPLIES (list 'SERIES-CONVERGES (cpd-tm 'dcf 'cpdt_)) (list 'SERIES-CONVERGES (cpd-tm 'cf 'cpdt_))))))
  (lambda ()
    (dk-peel!)
    (fact 'rr-lt-implies-le 0 'cpdt_)
    (let ((iff (dk-fact! 'cps-shift-conv 'cf cpd-rd-cf1 'cpdt_))
          (fa (cpd-tm cpd-rd-cf1 'cpdt_)) (ga (cpd-tm 'dcf 'cpdt_)))
      (cpd-tm-typ! cpd-rd-cf1 'cpdt_)
      (cpd-tm-typ! 'dcf 'cpdt_)
      (dk-have! (list 'AND
                  (list 'FORALL 'cpdn_ (list 'IMPLIES '(IN cpdn_ NN)
                    (list 'AND (list '<= 0 (list fa 'cpdn_)) (list '<= (list fa 'cpdn_) (list ga 'cpdn_)))))
                  (list 'SERIES-CONVERGES ga))
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (not (eq? (cpd-head (dk-goal)) 'FORALL))
                  (ass)
                  (let* ((j (dk-di-var!)) (s (list 'succ j))
                         (m1 (list 'magnitude (list 'cf s))) (p (list 'power 'cpdt_ j)))
                    (cpd-rd-typ! j)
                    (cpd-tm-pt! 'dcf 'cpdt_ j)
                    (dk-lam-b!)
                    (inst+ cpd-dcf-h j)
                    (subst (list '= (list 'dcf j) (list '* s (list 'cf s))))
                    (cpd-rr-typ! m1) (fact 'cc-magnitude-nonneg (list 'cf s))
                    (cpd-rr-typ! p) (fact 'rr-power-nonneg j 'cpdt_)
                    (cpd-cc-typ! s)
                    (cpd-and! (list 'IN s 'CC) (list 'IN (list 'cf s) 'CC))
                    (subst (dk-fact! 'cc-magnitude-mul s (list 'cf s)))
                    (cpd-rr-typ! s)
                    (fact 'nn-zero-le s)
                    (subst (dk-fact! 'rr-magnitude-is-abs s))
                    (subst (dk-fact! 'rr-abs-of-nonneg s))
                    (fact 'nn-one-le-succ j)
                    (cpd-rr-typ! (list '* s m1))
                    (dk-have! (list '<= m1 (list '* s m1))
                      (lambda ()
                        (cpd-and! (list '<= 0 m1) (list '<= 1 s))
                        (fact 'rr-le-scale-nonneg m1 1 s)
                        (cpd-rr-typ! (list '* m1 s))
                        (cpd-rr-typ! (list '* m1 1))
                        (dk-have! (list '= (list '* m1 s) (list '* s m1)) (lambda () (crs)))
                        (dk-ineq! (list '<= (list '* m1 1) (list '* m1 s)) (list '= (list '* m1 s) (list '* s m1)))))
                    (fact 'rr-mul-le-right m1 (list '* s m1) p)
                    (cpd-nonneg-prod! m1 p)
                    (dk-conj-close! (lambda () (ass)))))))))
      (fact 'comparison-test fa ga)
      (dk-only! iff (list 'SERIES-CONVERGES fa))
      (prop))))
;; (d) together
(fact 'cps-radius-mono cpd-rd-cfg 'dcf)
(fact 'cps-radius-mono 'dcf 'cf)
(define cpd-rd-a (list '<= '(CPS-RADIUS cf) (list 'CPS-RADIUS cpd-rd-cfg)))
(define cpd-rd-b (list '<= (list 'CPS-RADIUS cpd-rd-cfg) '(CPS-RADIUS dcf)))
(define (cpd-detach-all! ch)
  (let loop ((c ch))
    (if (eq? (cpd-head c) 'IMPLIES)
        (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))
        c)))
(cpd-detach-all! (dk-fact! 'rr-pos-star-le-trans '(CPS-RADIUS cf) (list 'CPS-RADIUS cpd-rd-cfg) '(CPS-RADIUS dcf)))
(cpd-detach-all! (dk-fact! 'rr-pos-star-le-antisymm '(CPS-RADIUS dcf) '(CPS-RADIUS cf)))
(ass)
(qed 'cps-radius-derived)

;;; ======================================================================
;;; (5) A QUADRATIC ERROR BOUND GIVES THE DERIVATIVE.  On an open set U of CC,
;;; if |f(x) - f(a) - (x - a) L| <= M |x - a|^2 for every x in U, then f is
;;; differentiable at a with derivative L (IS-DIFF-ON over CC-NORMED-FIELD).
;;; The Caratheodory factor is the difference quotient, completed by L at a:
;;;     phi(x) = IF(x = a, L, (f(x) - f(a)) / (x - a)),
;;; and |phi(x) - L| <= M |x - a| is its continuity at a.
;;; ======================================================================

(define cpd-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define cpd-sub '(SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) cpds_))
(define (cpd-dq v) (list '* (list '- (list 'cpdf_ v) '(cpdf_ cpda_)) (list 'recip (list '- v 'cpda_))))
(define (cpd-ift v) (list 'IF (list '= v 'cpda_) 'cpdl_ (cpd-dq v)))
(define cpd-phi (list 'VNB-LAMBDA 'cpdv_ 'cpds_ (cpd-ift 'cpdv_)))
(define (cpd-err x) (list '- (list '- (list 'cpdf_ x) '(cpdf_ cpda_)) (list '* (list '- x 'cpda_) 'cpdl_)))
(define cpd-qb
  (list 'FORALL 'cpdx_ (list 'IMPLIES '(IN cpdx_ cpds_)
    (list '<= (list 'magnitude (cpd-err 'cpdx_))
              '(* cpdm_ (* (magnitude (- cpdx_ cpda_)) (magnitude (- cpdx_ cpda_))))))))

;;; reduce the IF term IFT on the side the context decides, rewrite it in the
;;; goal and run K there; the condition leaf is closed by assumption
(define (cpd-if! ift true? k)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (dk-contains? (dk-goal) ift)
         (begin (subst (list '= ift (if true? (caddr ift) (cadddr ift)))) (k))
         (ass)))
   (dk-opened (lambda () (if true? (if-true ift) (if-false ift))))))

;;; t in RR, 0 < t  ==>  POS-RR(t)
(define (cpd-pos! t)
  (fact 'rr-lt-implies-le 0 t)
  (fact 'rr-pos-ne-zero t)
  (fact 'neq-sym t 0)
  (dk-have! (list 'POS-RR t) (lambda () (mac 'pos-rr) (from-context!))))

;;; v in U  ==>  v in CC, f(v) in CC
(define (cpd-qd-pt! v)
  (fact 'subset-mem-fwd 'cpds_ 'CC v)
  (fact 'fun-apply-type-c 'cpdf_ 'cpds_ 'CC v))

;;; NOT(v = a)  ==>  NOT(v - a = 0), recip(v - a) in CC, (v - a) recip(v - a) = 1
(define (cpd-qd-nz! v)
  (let ((d (list '- v 'cpda_)))
    (cpd-cc-typ! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= v 'cpda_)
          (lambda ()
            (dk-have! (list '= v (list '+ d 'cpda_)) (lambda () (crs)))
            (subst (list '= v (list '+ d 'cpda_)))
            (subst (list '= d 0))
            (crs)))
        (ai (list 'NOT (list '= v 'cpda_)))))
    (cpd-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
    (fact 'cc-recip-closed d)
    (fact 'cc-recip-inverse d)
    (cpd-cc-typ! (cpd-dq v))))

(sp (make-wff
  (list 'FORALL 'cpds_ (list 'IMPLIES (list 'IS-OPEN cpd-nfm 'cpds_)
    (list 'FORALL 'cpdf_ (list 'IMPLIES '(IN cpdf_ (FUN cpds_ CC))
      (list 'FORALL 'cpda_ (list 'IMPLIES '(IN cpda_ cpds_)
        (list 'FORALL 'cpdl_ (list 'IMPLIES '(IN cpdl_ CC)
          (list 'FORALL 'cpdm_ (list 'IMPLIES '(IN cpdm_ RR) (list 'IMPLIES '(<= 0 cpdm_)
            (list 'IMPLIES cpd-qb '(IS-DIFF-ON CC-NORMED-FIELD cpds_ cpdf_ cpda_ cpdl_)))))))))))))))
(dk-peel!)
