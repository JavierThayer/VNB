;; the factor is a function U -> CC
(define cpd-qd-pt
  (list 'FORALL 'cpdv_ (list 'IMPLIES '(IN cpdv_ cpds_) (list 'IN (cpd-ift 'cpdv_) 'CC))))
(dk-have! cpd-qd-pt
  (lambda ()
    (let ((v (dk-di-var!)))
      (cpd-qd-pt! v)
      (use-em (list '= v 'cpda_)
        (lambda () (cpd-if! (cpd-ift v) #t (lambda () (ass))))
        (lambda () (cpd-qd-nz! v) (cpd-if! (cpd-ift v) #f (lambda () (ass))))))))
(dk-have! (list 'IN cpd-phi '(FUN cpds_ CC))
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (let ((g (dk-goal)))
         (cond ((equal? g '(IN cpds_ SET)) (ass))
               ((eq? (cpd-head g) 'FORALL)
                (let ((v (dk-di-var!))) (inst+ cpd-qd-pt v) (ass)))
               (#t (error "cpd: unexpected lam-t leaf" (expression->string g))))))
     (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN cpd-phi '(FUN cpds_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! '(IN cpdf_ (FUN cpds_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! '(IN cpdl_ (CARR CC-NORMED-FIELD))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
;; phi(a) = L
(define cpd-qd-pa (list '= (list cpd-phi 'cpda_) 'cpdl_))
(dk-have! cpd-qd-pa
  (lambda ()
    (dk-lam-b!)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-contains? (dk-goal) (cpd-ift 'cpda_))
           (begin (subst (list '= (cpd-ift 'cpda_) 'cpdl_)) (rfl))
           (rfl)))
     (dk-opened (lambda () (if-true (cpd-ift 'cpda_)))))))
;; continuity of phi at a
(fact 'cc-magnitude-closed 'cpdl_)
(define cpd-qd-dl (list '* 'cpdm_ '(+ cpdm_ 1)))
(dk-have! (list 'IS-CONTINUOUS-AT cpd-sub cpd-nfm cpd-phi 'cpda_)
  (lambda ()
    (mac 'is-continuous-at)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
          ((eq? (cpd-head g) 'FORALL)
           (let* ((ep (dk-peel!))
                  (eps (cadr (car (filter (dk-head? 'POS-RR) ep))))
                  (m1 '(+ cpdm_ 1))
                  (del (list '* eps (list 'recip m1))))
             (fact 'rr-pos-rr-in-rr eps)
             (fact 'rr-lt-of-pos-rr eps)
             (cpd-rr-typ! m1)
             (dk-have! (list '< 0 m1) (lambda () (dk-ineq! '(<= 0 cpdm_))))
             (fact 'rr-pos-ne-zero m1)
             (cpd-and! (list 'IN m1 'RR) (list 'NOT (list '= m1 0)))
             (fact 'rr-recip-closed m1)
             (fact 'rr-recip-inverse m1)
             (fact 'rr-recip-pos m1)
             (fact 'rr-mul-in-rr eps (list 'recip m1))
             (fact 'rr-mul-pos eps (list 'recip m1))
             (cpd-pos! del)
             (fact 'rr-lt-implies-le 0 del)
             (dk-have! (list '= (list '* m1 del) eps)
               (lambda ()
                 (dk-have! (list '= (list '* m1 del) (list '* eps (list '* m1 (list 'recip m1)))) (lambda () (crs)))
                 (subst (list '= (list '* m1 del) (list '* eps (list '* m1 (list 'recip m1)))))
                 (subst (list '= (list '* m1 (list 'recip m1)) 1))
                 (crs)))
             (ew del)
             (dk-conj-close!
              (lambda ()
                (if (not (eq? (cpd-head (dk-goal)) 'FORALL))
                    (ass)
                    (let* ((lk (dk-peel!))
                           (b (cadr (car (filter (dk-head? 'IN) lk))))
                           (dab (list 'magnitude (list '- 'cpda_ b)))
                           (dba (list 'magnitude (list '- b 'cpda_))))
                      (dk-have! (list 'IN b 'cpds_) (lambda () (subst (list '== 'cpds_ (list 'PTS cpd-sub))) (ass)))
                      (cpd-qd-pt! b)
                      (inst+ cpd-qd-pt b)
                      ;; the hypothesis dist(a, b) <= delta, read as |b - a| <= delta
                      (fact 'subspace-dist cpd-nfm 'cpds_ 'cpda_ b)
                      (dk-have! (list 'IN 'cpda_ '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                      (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                      (fact 'nf-cc-agree-dist 'cpda_ b)
                      (fact 'cc-ms-dist 'cpda_ b)
                      (cpd-rr-typ! dab) (cpd-rr-typ! dba)
                      (fact 'cc-magnitude-sub-sym 'cpda_ b)
                      (dk-have! (list '<= dba del)
                        (lambda ()
                          (subst (list '= dba dab))
                          (subst (list '== dab (list '(DIST CC-MS) 'cpda_ b)))
                          (subst (list '== (list '(DIST CC-MS) 'cpda_ b) (list (list 'DIST cpd-nfm) 'cpda_ b)))
                          (subst (list '== (list (list 'DIST cpd-nfm) 'cpda_ b) (list (list 'DIST cpd-sub) 'cpda_ b)))
                          (ass)))
                      ;; the goal, read as |L - phi(b)| <= eps
                      (subst cpd-qd-pa)
                      (dk-lam-b!)
                      (let ((pb (cpd-ift b)))
                        (dk-have! (list 'IN 'cpdl_ '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (dk-have! (list 'IN pb '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (fact 'nf-cc-agree-dist 'cpdl_ pb)
                        (fact 'cc-ms-dist 'cpdl_ pb)
                        (subst (list '== (list (list 'DIST cpd-nfm) 'cpdl_ pb) (list '(DIST CC-MS) 'cpdl_ pb)))
                        (subst (list '== (list '(DIST CC-MS) 'cpdl_ pb) (list 'magnitude (list '- 'cpdl_ pb))))
                        (use-em (list '= b 'cpda_)
                          (lambda ()
                            (cpd-if! pb #t
                              (lambda ()
                                (dk-have! '(= (- cpdl_ cpdl_) 0) (lambda () (crs)))
                                (subst '(= (- cpdl_ cpdl_) 0))
                                (fact 'cc-magnitude-zero)
                                (subst '(= (magnitude 0) 0))
                                (dk-ineq! (list '< 0 eps)))))
                          (lambda ()
                            (cpd-qd-nz! b)
                            (cpd-if! pb #f
                              (lambda ()
                                (let* ((q (cpd-dq b)) (lq (list '- 'cpdl_ q)) (d (list '- b 'cpda_))
                                       (e (cpd-err b)) (mlq (list 'magnitude lq)))
                                  (for-each cpd-cc-typ! (list q lq e))
                                  (cpd-rr-typ! mlq)
                                  (cpd-rr-typ! (list 'magnitude e))
                                  ;; (L - Q)(b - a) = -(f(b) - f(a) - (b - a) L)
                                  (dk-have! (list '= (list '* lq d) (list '- e))
                                    (lambda ()
                                      (let ((ex (list '- (list '* 'cpdl_ d)
                                                         (list '* (list '- (list 'cpdf_ b) '(cpdf_ cpda_))
                                                                  (list '* d (list 'recip d))))))
                                        (dk-have! (list '= (list '* lq d) ex) (lambda () (crs)))
                                        (subst (list '= (list '* lq d) ex))
                                        (subst (list '= (list '* d (list 'recip d)) 1))
                                        (crs))))
                                  (cpd-and! (list 'IN lq 'CC) (list 'IN d 'CC))
                                  (fact 'cc-magnitude-mul lq d)
                                  (fact 'cc-magnitude-neg e)
                                  (inst+ cpd-qb b)
                                  (cpd-rr-typ! (list '* mlq dba))
                                  (cpd-rr-typ! (list '* 'cpdm_ dba))
                                  (cpd-rr-typ! (list '* (list '* 'cpdm_ dba) dba))
                                  (cpd-rr-typ! (list '* 'cpdm_ (list '* dba dba)))
                                  (dk-have! (list '= (list '* 'cpdm_ (list '* dba dba)) (list '* (list '* 'cpdm_ dba) dba))
                                            (lambda () (crs)))
                                  (dk-have! (list '<= (list '* mlq dba) (list '* (list '* 'cpdm_ dba) dba))
                                    (lambda ()
                                      (dk-have! (list '= (list '* mlq dba) (list 'magnitude e))
                                        (lambda ()
                                          (subst (list '= (list '* mlq dba) (list 'magnitude (list '* lq d))))
                                          (subst (list '= (list '* lq d) (list '- e)))
                                          (subst (list '= (list 'magnitude (list '- e)) (list 'magnitude e)))
                                          (rfl)))
                                      (dk-ineq! (list '= (list '* mlq dba) (list 'magnitude e))
                                                (list '<= (list 'magnitude e) (list '* 'cpdm_ (list '* dba dba)))
                                                (list '= (list '* 'cpdm_ (list '* dba dba)) (list '* (list '* 'cpdm_ dba) dba)))))
                                  ;; |b - a| > 0: cancel it
                                  (fact 'cc-magnitude-nonneg d)
                                  (fact 'cc-magnitude-zero-iff d)
                                  (dk-have! (list 'NOT (list '= dba 0))
                                    (lambda ()
                                      (dk-only! (list 'IFF (list '= dba 0) (list '= d 0)) (list 'NOT (list '= d 0)))
                                      (prop)))
                                  (fact 'neq-sym dba 0)
                                  (cpd-and! (list '<= 0 dba) (list 'NOT (list '= 0 dba)))
                                  (fact 'rr-le-ne-lt 0 dba)
                                  (fact 'rr-mul-le-cancel-pos mlq dba (list '* 'cpdm_ dba))
                                  ;; M |b - a| <= M delta <= (M + 1) delta = eps
                                  (cpd-and! '(<= 0 cpdm_) (list '<= dba del))
                                  (fact 'rr-le-scale-nonneg 'cpdm_ dba del)
                                  (cpd-rr-typ! (list '* 'cpdm_ del))
                                  (cpd-rr-typ! (list '* m1 del))
                                  (dk-have! (list '= (list '* m1 del) (list '+ (list '* 'cpdm_ del) del)) (lambda () (crs)))
                                  (dk-ineq! (list '<= mlq (list '* 'cpdm_ dba))
                                            (list '<= (list '* 'cpdm_ dba) (list '* 'cpdm_ del))
                                            (list '= (list '* m1 del) (list '+ (list '* 'cpdm_ del) del))
                                            (list '= (list '* m1 del) eps)
                                            (list '<= 0 del))))))))))))))
          ((eq? (cpd-head g) 'IN)
           (cond ((dk-asm? g) (ass))
                 ((equal? g (list 'IN 'cpda_ (list 'PTS cpd-sub)))
                  (subst (list '== (list 'PTS cpd-sub) 'cpds_)) (ass))
                 (#t (subst (list '== (list 'PTS cpd-sub) 'cpds_))
                     (subst (list '== (list 'PTS cpd-nfm) 'CC))
                     (ass))))
          (#t (ass))))))))
;; the definition
(mac 'IS-DIFF-ON)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((eq? (cpd-head g) 'FORSOME)
       (ew cpd-phi)
       (dk-conj-close!
        (lambda ()
          (if (not (eq? (cpd-head (dk-goal)) 'FORALL))
              (ass)
              (let* ((x (dk-di-var!)) (d (list '- x 'cpda_)) (px (cpd-ift x))
                     (fd (list '- (list 'cpdf_ x) '(cpdf_ cpda_))))
                (cpd-qd-pt! x)
                (inst+ cpd-qd-pt x)
                (dk-lam-b!)
                (cpd-cc-typ! d) (cpd-cc-typ! fd)
                (fact 'cc-nf-sub (list 'cpdf_ x) '(cpdf_ cpda_))
                (fact 'cc-nf-sub x 'cpda_)
                (subst (list '== (list '(ADD CC-NORMED-FIELD) (list 'cpdf_ x) '((NEG CC-NORMED-FIELD) (cpdf_ cpda_))) fd))
                (subst (list '== (list '(ADD CC-NORMED-FIELD) x '((NEG CC-NORMED-FIELD) cpda_)) d))
                (cpd-and! (list 'IN px 'CC) (list 'IN d 'CC))
                (fact 'cc-nf-mul-apply px d)
                (subst (list '== (list '(MUL CC-NORMED-FIELD) px d) (list '* px d)))
                (use-em (list '= x 'cpda_)
                  (lambda ()
                    (cpd-if! px #t
                      (lambda ()
                        (subst (list '= x 'cpda_))
                        (crs))))
                  (lambda ()
                    (cpd-qd-nz! x)
                    (cpd-if! px #f
                      (lambda ()
                        (let ((ex (list '* fd (list '* d (list 'recip d)))))
                          (dk-have! (list '= (list '* (cpd-dq x) d) ex) (lambda () (crs)))
                          (subst (list '= (list '* (cpd-dq x) d) ex))
                          (subst (list '= (list '* d (list 'recip d)) 1))
                          (crs)))))))))))
      (#t (ass))))))
(qed 'cc-diff-on-quadratic)

;;; ======================================================================
;;; (6) THE ERROR OF THE PARTIAL SUMS.  With t_z(j) = a_j z^j, t_u(j) = a_j u^j,
;;; t'_u(j) = a'_j u^j (a'_j = (j+1) a_(j+1)), and
;;;     E_k = S(t_z, k+1) - S(t_u, k+1) - (z - u) S(t'_u, k)
;;;         = sum_{j<k} a_(j+1) Q_j,
;;; for |z|, |u| <= r:
;;;     r^2 |E_k| <= |z - u|^2 sum_{j<k} |a_(j+1) (j+1)^2| r^(j+1),
;;; by induction on k and the power estimate.  Then E_k tends to
;;; f(z) - f(u) - (z - u) g(u) by the linearity of limits.
;;; ======================================================================

(define (cpd-E k)
  (list '- (list '- (list 'CC-SERIES-PARTIAL-SUM 'cpdtz_ (list 'succ k)) (list 'CC-SERIES-PARTIAL-SUM 'cpdtu_ (list 'succ k)))
           (list '* '(- cpdz_ cpdu_) (list 'CC-SERIES-PARTIAL-SUM 'cpdtd_ k))))
(define cpd-eb-tz '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (cpdtz_ cpdj_) (* (cf cpdj_) (power cpdz_ cpdj_))))))
(define cpd-eb-tu '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (cpdtu_ cpdj_) (* (cf cpdj_) (power cpdu_ cpdj_))))))
(define cpd-eb-td '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (cpdtd_ cpdj_) (* (dcf cpdj_) (power cpdu_ cpdj_))))))
(define cpd-eb-vv '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN)
   (= (cpdvv_ cpdj_) (* (magnitude (* (cf (succ cpdj_)) (* (succ cpdj_) (succ cpdj_)))) (power cpdr_ (succ cpdj_)))))))
(sp (make-wff
  (list 'FORALL 'cpdk_ (list 'IMPLIES '(IN cpdk_ NN)
    (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
      (list 'FORALL 'dcf (list 'IMPLIES '(IN dcf (FUN NN CC)) (list 'IMPLIES cpd-dcf-h
        (list 'FORALL 'cpdz_ (list 'IMPLIES '(IN cpdz_ CC)
          (list 'FORALL 'cpdu_ (list 'IMPLIES '(IN cpdu_ CC)
            (list 'FORALL 'cpdr_ (list 'IMPLIES '(IN cpdr_ RR)
              (list 'IMPLIES '(<= (magnitude cpdz_) cpdr_) (list 'IMPLIES '(<= (magnitude cpdu_) cpdr_)
                (list 'FORALL 'cpdtz_ (list 'IMPLIES '(IN cpdtz_ (FUN NN CC)) (list 'IMPLIES cpd-eb-tz
                  (list 'FORALL 'cpdtu_ (list 'IMPLIES '(IN cpdtu_ (FUN NN CC)) (list 'IMPLIES cpd-eb-tu
                    (list 'FORALL 'cpdtd_ (list 'IMPLIES '(IN cpdtd_ (FUN NN CC)) (list 'IMPLIES cpd-eb-td
                      (list 'FORALL 'cpdvv_ (list 'IMPLIES '(IN cpdvv_ (FUN NN RR)) (list 'IMPLIES cpd-eb-vv
                        (list '<= (list '* '(* cpdr_ cpdr_) (list 'magnitude (cpd-E 'cpdk_)))
                                  (list '* cpd-W '(SERIES-PARTIAL-SUM cpdvv_ cpdk_))))))))))))))))))))))))))))))))
(define (cpd-eb-setup!)
  (cpd-est-setup!)
  (cpd-nonneg-prod! 'cpdr_ 'cpdr_))
(define cpd-eb-br (use-induction))
(dk-focus! (cdr (assq 'base cpd-eb-br)))
(dk-peel!)
(cpd-eb-setup!)
(let ((e0 (cpd-E 0)))
  (fact 'nn-zero-in)
  (for-each (lambda (t) (fact 'cc-series-partial-sum-in-cc 0 t) (fact 'fun-apply-type-c t 'NN 'CC 0)) '(cpdtz_ cpdtu_ cpdtd_))
  (inst+ cpd-eb-tz 0) (inst+ cpd-eb-tu 0)
  (fact 'fun-apply-type-c 'cf 'NN 'CC 0)
  (fact 'power-zero 'cpdz_) (fact 'power-zero 'cpdu_)
  (cpd-cc-typ! e0)
  (dk-have! (list '= e0 0)
    (lambda ()
      (subst (dk-fact! 'cc-series-partial-sum-succ 'cpdtz_ 0))
      (subst (dk-fact! 'cc-series-partial-sum-succ 'cpdtu_ 0))
      (mac 'cc-series-partial-sum-zero)
      (subst '(= (cpdtz_ 0) (* (cf 0) (power cpdz_ 0))))
      (subst '(= (cpdtu_ 0) (* (cf 0) (power cpdu_ 0))))
      (subst '(= (power cpdz_ 0) 1))
      (subst '(= (power cpdu_ 0) 1))
      (crs)))
  (subst (list '= e0 0))
  (fact 'cc-magnitude-zero)
  (subst '(= (magnitude 0) 0))
  (mac 'series-partial-sum-zero)
  (dk-ineq!))
(dk-focus! (cdr (assq 'step cpd-eb-br)))
(define cpd-eb-v (cdr (assq 'var cpd-eb-br)))
(define cpd-eb-ih (cdr (assq 'ih cpd-eb-br)))
(dk-peel!)
(cpd-eb-setup!)
(let* ((k cpd-eb-v) (s (list 'succ k)) (r 'cpdr_) (w cpd-W) (rr2 '(* cpdr_ cpdr_))
       (ek (cpd-E k)) (es (cpd-E s))
       (mek (list 'magnitude ek)) (mes (list 'magnitude es))
       (cfs (list 'cf s)) (mcf (list 'magnitude cfs))
       (qk (cpd-Q k)) (mq (list 'magnitude qk))
       (cq (list '* cfs qk))
       (svk (list 'SERIES-PARTIAL-SUM 'cpdvv_ k)) (svs (list 'SERIES-PARTIAL-SUM 'cpdvv_ s))
       (vk (list 'cpdvv_ k))
       (rk (cpd-est-rhs k))
       (cr (list '* mcf r)))
  (dk-apply! cpd-eb-ih 'cf 'dcf 'cpdz_ 'cpdu_ 'cpdr_ 'cpdtz_ 'cpdtu_ 'cpdtd_ 'cpdvv_)
  (cpd-nn-typ! s)
  (for-each (lambda (t)
              (fact 'cc-series-partial-sum-in-cc k t) (fact 'cc-series-partial-sum-in-cc s t)
              (fact 'fun-apply-type-c t 'NN 'CC k) (fact 'fun-apply-type-c t 'NN 'CC s))
            '(cpdtz_ cpdtu_ cpdtd_))
  (fact 'fun-apply-type-c 'cf 'NN 'CC s)
  (fact 'fun-apply-type-c 'dcf 'NN 'CC k)
  (fact 'fun-apply-type-c 'cpdvv_ 'NN 'RR k)
  (fact 'series-partial-sum-in-rr k 'cpdvv_)
  (for-each cpd-cc-typ! (list ek es qk cq))
  (for-each cpd-rr-typ! (list mek mes mcf mq svk svs rk cr (list '* mcf mq) (list '* r mq)))
  (fact 'cc-magnitude-nonneg cfs)
  (fact 'cc-magnitude-nonneg qk)
  (inst+ cpd-eb-tz s) (inst+ cpd-eb-tu s) (inst+ cpd-eb-td k) (inst+ cpd-dcf-h k) (inst+ cpd-eb-vv k)
  ;; E_(k+1) = E_k + a_(k+1) Q_k
  (dk-have! (list '= es (list '+ ek cq))
    (lambda ()
      (subst (dk-fact! 'cc-series-partial-sum-succ 'cpdtz_ s))
      (subst (dk-fact! 'cc-series-partial-sum-succ 'cpdtu_ s))
      (subst (dk-fact! 'cc-series-partial-sum-succ 'cpdtd_ k))
      (subst (list '= (list 'cpdtz_ s) (list '* cfs (list 'power 'cpdz_ s))))
      (subst (list '= (list 'cpdtu_ s) (list '* cfs (list 'power 'cpdu_ s))))
      (subst (list '= (list 'cpdtd_ k) (list '* (list 'dcf k) (list 'power 'cpdu_ k))))
      (subst (list '= (list 'dcf k) (list '* s cfs)))
      (crs)))
  (cpd-and! (list 'IN ek 'CC) (list 'IN cq 'CC))
  (fact 'cc-magnitude-triangle ek cq)
  (cpd-and! (list 'IN cfs 'CC) (list 'IN qk 'CC))
  (fact 'cc-magnitude-mul cfs qk)
  (cpd-rr-typ! (list 'magnitude (list '+ ek cq)))
  (cpd-rr-typ! (list 'magnitude cq))
  (cpd-rr-typ! (list '+ mek (list '* mcf mq)))
  (dk-have! (list '= mes (list 'magnitude (list '+ ek cq))) (lambda () (subst (list '= es (list '+ ek cq))) (rfl)))
  (dk-have! (list '<= mes (list '+ mek (list '* mcf mq)))
    (lambda ()
      (dk-ineq! (list '= mes (list 'magnitude (list '+ ek cq)))
                (list '<= (list 'magnitude (list '+ ek cq)) (list '+ mek (list 'magnitude cq)))
                (list '= (list 'magnitude cq) (list '* mcf mq)))))
  ;; times r^2
  (cpd-and! (list '<= 0 rr2) (list '<= mes (list '+ mek (list '* mcf mq))))
  (fact 'rr-le-scale-nonneg rr2 mes (list '+ mek (list '* mcf mq)))
  (cpd-rr-typ! (list '* rr2 mek))
  (cpd-rr-typ! (list '* rr2 (list '* mcf mq)))
  (dk-have! (list '= (list '* rr2 (list '+ mek (list '* mcf mq))) (list '+ (list '* rr2 mek) (list '* rr2 (list '* mcf mq))))
            (lambda () (crs)))
  ;; the power estimate, times |a_(k+1)| r
  (fact 'cpd-power-second-order k 'cpdz_ 'cpdu_ 'cpdr_)
  (cpd-nonneg-prod! mcf r)
  (cpd-and! (list '<= 0 cr) (list '<= (list '* r mq) rk))
  (fact 'rr-le-scale-nonneg cr (list '* r mq) rk)
  (cpd-rr-typ! (list '* cr (list '* r mq)))
  (cpd-rr-typ! (list '* cr rk))
  (dk-have! (list '= (list '* rr2 (list '* mcf mq)) (list '* cr (list '* r mq))) (lambda () (crs)))
  ;; |a_(k+1)| r (k+1)^2 r^k W = W v(k)
  (let ((ss (list '* s s)) (acs (list '* cfs (list '* s s))))
    (cpd-cc-typ! ss) (cpd-cc-typ! acs)
    (cpd-and! (list 'IN cfs 'CC) (list 'IN ss 'CC))
    (fact 'cc-magnitude-mul cfs ss)
    (cpd-rr-typ! ss)
    (fact 'nn-zero-le s)
    (cpd-nonneg-prod! s s)
    (fact 'rr-magnitude-is-abs ss)
    (fact 'rr-abs-of-nonneg ss)
    (cpd-rr-typ! (list '* w vk))
    (let ((e5 (cpd-pow-succ! r k)))
      (dk-have! (list '= (list '* cr rk) (list '* w vk))
        (lambda ()
          (subst (list '= vk (list '* (list 'magnitude acs) (list 'power r s))))
          (subst (list '= (list 'magnitude acs) (list '* mcf (list 'magnitude ss))))
          (subst (list '= (list 'magnitude ss) (list 'abs ss)))
          (subst (list '= (list 'abs ss) ss))
          (subst e5)
          (crs)))))
  ;; the partial sum of v
  (cpd-rr-typ! (list '* w svk))
  (cpd-rr-typ! (list '* w svs))
  (dk-have! (list '= (list '* w svs) (list '+ (list '* w svk) (list '* w vk)))
    (lambda () (subst (dk-fact! 'series-partial-sum-succ 'cpdvv_ k)) (crs)))
  (cpd-rr-typ! (list '* rr2 mes))
  (cpd-rr-typ! (list '* rr2 (list '+ mek (list '* mcf mq))))
  (dk-ineq! (list '<= (list '* rr2 mes) (list '* rr2 (list '+ mek (list '* mcf mq))))
            (list '= (list '* rr2 (list '+ mek (list '* mcf mq))) (list '+ (list '* rr2 mek) (list '* rr2 (list '* mcf mq))))
            (list '<= (list '* rr2 mek) (list '* w svk))
            (list '= (list '* rr2 (list '* mcf mq)) (list '* cr (list '* r mq)))
            (list '<= (list '* cr (list '* r mq)) (list '* cr rk))
            (list '= (list '* cr rk) (list '* w vk))
            (list '= (list '* w svs) (list '+ (list '* w svk) (list '* w vk)))))
(qed 'cps-partial-error-bound)

;;; E_k -> (sum F - sum G) - w (sum H), for convergent complex series F, G, H
(define (cpd-el-seq) (list 'VNB-LAMBDA 'cpdj_ 'NN
  (list '- (list '- '(CC-SERIES-PARTIAL-SUM cpdff_ (succ cpdj_)) '(CC-SERIES-PARTIAL-SUM cpdgg_ (succ cpdj_)))
           '(* cpdw_ (CC-SERIES-PARTIAL-SUM cpdhh_ cpdj_)))))
(define cpd-el-lim '(- (- (CC-SERIES-LIMIT cpdff_) (CC-SERIES-LIMIT cpdgg_)) (* cpdw_ (CC-SERIES-LIMIT cpdhh_))))
(sp (make-wff
  (list 'FORALL 'cpdff_ (list 'IMPLIES '(IN cpdff_ (FUN NN CC))
    (list 'FORALL 'cpdgg_ (list 'IMPLIES '(IN cpdgg_ (FUN NN CC))
      (list 'FORALL 'cpdhh_ (list 'IMPLIES '(IN cpdhh_ (FUN NN CC))
        (list 'FORALL 'cpdw_ (list 'IMPLIES '(IN cpdw_ CC)
          (list 'IMPLIES '(CC-SERIES-CONVERGES cpdff_)
            (list 'IMPLIES '(CC-SERIES-CONVERGES cpdgg_)
              (list 'IMPLIES '(CC-SERIES-CONVERGES cpdhh_)
                (list 'CONVERGES-TO 'CC-MS (cpd-el-seq) cpd-el-lim))))))))))))))
(dk-peel!)
(cpd-sl-lim! 'cpdff_)
(cpd-sl-lim! 'cpdgg_)
(cpd-sl-lim! 'cpdhh_)
(for-each (lambda (fn) (cpd-lam-typ! (cpd-psq fn) 'CC (lambda (j) (fact 'cc-series-partial-sum-in-cc j fn))))
          '(cpdff_ cpdgg_ cpdhh_))
(define (cpd-el-sh fn) (list 'VNB-LAMBDA 'cpdj_ 'NN (list 'CC-SERIES-PARTIAL-SUM fn '(succ cpdj_))))
(define (cpd-el-typ! j)
  (cpd-nn-typ! (list 'succ j))
  (for-each (lambda (fn) (fact 'cc-series-partial-sum-in-cc j fn) (fact 'cc-series-partial-sum-in-cc (list 'succ j) fn))
            '(cpdff_ cpdgg_ cpdhh_)))
(define cpd-el-d (list 'VNB-LAMBDA 'cpdj_ 'NN
  (list '- '(CC-SERIES-PARTIAL-SUM cpdff_ (succ cpdj_)) '(CC-SERIES-PARTIAL-SUM cpdgg_ (succ cpdj_)))))
(fact 'rr-one-in)
(fact 'rr-subset-cc 1)
(fact 'cc-neg-closed 1)
(fact 'cc-neg-closed 'cpdw_)
(for-each
 (lambda (fn)
   (cpd-lam-typ! (cpd-el-sh fn) 'CC cpd-el-typ!)
   (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list (cpd-el-sh fn) 'cpdj_) (list (cpd-psq fn) '(succ cpdj_)))))
     (lambda () (let ((j (dk-di-var!))) (cpd-el-typ! j) (dk-lam-b!) (rfl))))
   (fact 'cc-limit-shift (cpd-psq fn) (cpd-el-sh fn) (list 'CC-SERIES-LIMIT fn)))
 '(cpdff_ cpdgg_))
(cpd-lam-typ! cpd-el-d 'CC (lambda (j) (cpd-el-typ! j) (cpd-cc-typ! (subst-free 'cpdj_ j (cadddr cpd-el-d)))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list cpd-el-d 'cpdj_)
                     (list '+ (list '* 1 (list (cpd-el-sh 'cpdff_) 'cpdj_)) (list '* '(- 1) (list (cpd-el-sh 'cpdgg_) 'cpdj_))))))
  (lambda () (let ((j (dk-di-var!))) (cpd-el-typ! j) (dk-lam-b!) (crs))))
(fact 'cc-limit-lincomb (cpd-el-sh 'cpdff_) (cpd-el-sh 'cpdgg_) cpd-el-d '(CC-SERIES-LIMIT cpdff_) '(CC-SERIES-LIMIT cpdgg_) 1 '(- 1))
(define cpd-el-l1 '(+ (* 1 (CC-SERIES-LIMIT cpdff_)) (* (- 1) (CC-SERIES-LIMIT cpdgg_))))
(cpd-cc-typ! cpd-el-l1)
(cpd-lam-typ! (cpd-el-seq) 'CC (lambda (j) (cpd-el-typ! j) (cpd-cc-typ! (subst-free 'cpdj_ j (cadddr (cpd-el-seq))))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '= (list (cpd-el-seq) 'cpdj_)
                     (list '+ (list '* 1 (list cpd-el-d 'cpdj_)) (list '* '(- cpdw_) (list (cpd-psq 'cpdhh_) 'cpdj_))))))
  (lambda () (let ((j (dk-di-var!))) (cpd-el-typ! j) (dk-lam-b!) (crs))))
(fact 'cc-limit-lincomb cpd-el-d (cpd-psq 'cpdhh_) (cpd-el-seq) cpd-el-l1 '(CC-SERIES-LIMIT cpdhh_) 1 '(- cpdw_))
(define cpd-el-l2 (list '+ (list '* 1 cpd-el-l1) '(* (- cpdw_) (CC-SERIES-LIMIT cpdhh_))))
(dk-have! (list '= cpd-el-lim cpd-el-l2) (lambda () (crs)))
(subst (list '= cpd-el-lim cpd-el-l2))
(ass)
(qed 'cc-partial-error-limit)

;;; ======================================================================
;;; (7) PROPOSITION 2.10.  For 0 < r < R the sum f(z) = sum_k a_k z^k is
;;; differentiable at every point u of the open ball B(0, r), with derivative
;;; g(u) = sum_k (k+1) a_(k+1) u^k.  (The notes' B(0, R): see the header.)
;;; ======================================================================

(define cpd-B '(BALL CC-MS 0 cpdr_))
(define (cpd-tzl x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(cf cpsk_) (list 'power x 'cpsk_))))
(define (cpd-tdl x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(dcf cpsk_) (list 'power x 'cpsk_))))
(define cpd-FS (list 'VNB-LAMBDA 'cpdz_ cpd-B (list 'CC-SERIES-LIMIT (cpd-tzl 'cpdz_))))
(define cpd-vv '(VNB-LAMBDA cpdj_ NN (* (magnitude (* (cf (succ cpdj_)) (* (succ cpdj_) (succ cpdj_)))) (power cpdr_ (succ cpdj_)))))
(define cpd-cg2 '(VNB-LAMBDA cpdk_ NN (* cpdk_ cpdk_)))
(define cpd-cfg2 '(VNB-LAMBDA cpdk_ NN (* (cf cpdk_) (* cpdk_ cpdk_))))

(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'FORALL 'dcf (list 'IMPLIES '(IN dcf (FUN NN CC)) (list 'IMPLIES cpd-dcf-h
      (list 'FORALL 'cpdr_ (list 'IMPLIES '(IN cpdr_ RR) (list 'IMPLIES '(< 0 cpdr_)
        (list 'IMPLIES '(< cpdr_ (CPS-RADIUS cf))
          (list 'FORALL 'cpda_ (list 'IMPLIES (list 'IN 'cpda_ cpd-B)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD cpd-B cpd-FS 'cpda_ (list 'CC-SERIES-LIMIT (cpd-tdl 'cpda_))))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(cpd-pts-cc!)
(fact 'cc-zero-in)
(dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'rr-lt-implies-le 0 'cpdr_)
(fact 'rr-pos-ne-zero 'cpdr_)
(fact 'neq-sym 'cpdr_ 0)
(cpd-detach-all! (dk-fact! 'ball-is-open 'CC-MS 0 'cpdr_))
(define cpd-mn-oiff (dk-fact! 'cc-ms-open-iff cpd-B))
(dk-have! (list 'IS-OPEN cpd-nfm cpd-B) (lambda () (dk-only! cpd-mn-oiff (list 'IS-OPEN 'CC-MS cpd-B)) (prop)))
(fact 'ball-is-set 'CC-MS 0 'cpdr_)
(fact 'ball-in-closed-ball 'CC-MS 0 'cpdr_)
(fact 'cps-radius-derived 'cf 'dcf)
(dk-have! '(< cpdr_ (CPS-RADIUS dcf)) (lambda () (subst '(= (CPS-RADIUS dcf) (CPS-RADIUS cf))) (ass)))
;; a point of the ball: in CC, modulus <= r, the two series at it typed and convergent
(define (cpd-mn-typ-tz! x c)
  (cpd-lam-typ! (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list c 'cpsk_) (list 'power x 'cpsk_))) 'CC
    (lambda (j) (fact 'fun-apply-type-c c 'NN 'CC j) (cpd-cc-typ! (list '* (list c j) (list 'power x j))))))
(define (cpd-bp! x)
  (let ((cb '(CLOSED-BALL CC-MS 0 cpdr_)))
    (fact 'subset-mem-fwd cpd-B cb x)
    (dk-split-all! (list (dk-fact! 'cc-closed-ball-origin 'cpdr_ x)))
    (cpd-mn-typ-tz! x 'cf)
    (fact 'cps-converges-closed-ball 'cf 'cpdr_ x)
    (fact 'cc-series-limit-in-cc (cpd-tzl x))))
(cpd-bp! 'cpda_)
(cpd-mn-typ-tz! 'cpda_ 'dcf)
(fact 'subset-mem-fwd cpd-B '(CLOSED-BALL CC-MS 0 cpdr_) 'cpda_)
(fact 'cps-converges-closed-ball 'dcf 'cpdr_ 'cpda_)
(fact 'cc-series-limit-in-cc (cpd-tdl 'cpda_))
(define cpd-mn-l (list 'CC-SERIES-LIMIT (cpd-tdl 'cpda_)))
;; sum_j |a_(j+1) (j+1)^2| r^(j+1) converges (Lemma 2.9 with b_k = k^2, then the shift)
(define cpd-mn-t (dk-skolem! (dk-fact! 'cps-radius-approx 'cf 'cpdr_)))
(dk-split-all!)
(define (cpd-mn-k2! j) (cpd-cc-typ! (list '* j j)) (fact 'fun-apply-type-c 'cf 'NN 'CC j) (cpd-cc-typ! (list '* (list 'cf j) (list '* j j))))
(cpd-lam-typ! cpd-cg2 'CC (lambda (j) (cpd-cc-typ! (list '* j j))))
(cpd-lam-typ! cpd-cfg2 'CC cpd-mn-k2!)
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN)
            (list '= (list cpd-cfg2 'cpsk_) (list '* '(cf cpsk_) (list cpd-cg2 'cpsk_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-mn-k2! j) (dk-lam-b!) (rfl))))
(fact 'rr-one-in)
(fact 'nn-two-is-succ-succ-zero)
(cpd-nn-typ! '(succ (succ 0)))
(dk-have! '(IN 2 NN) (lambda () (subst '(= 2 (succ (succ 0)))) (ass)))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN)
            (list '<= (list 'magnitude (list cpd-cg2 'cpsk_)) '(* 1 (power cpsk_ 2)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (cpd-mn-k2! j)
      (dk-lam-b!)
      (cpd-rr-typ! (list '* j j))
      (fact 'nn-zero-le j)
      (cpd-nonneg-prod! j j)
      (subst (dk-fact! 'rr-magnitude-is-abs (list '* j j)))
      (subst (dk-fact! 'rr-abs-of-nonneg (list '* j j)))
      (subst '(= 2 (succ (succ 0))))
      (subst (cpd-pow-succ! j '(succ 0)))
      (subst (cpd-pow-succ! j 0))
      (fact 'power-zero j)
      (subst (list '= (list 'power j 0) 1))
      (cpd-rr-typ! (list '* 1 (list '* j (list '* j 1))))
      (dk-have! (list '= (list '* 1 (list '* j (list '* j 1))) (list '* j j)) (lambda () (crs)))
      (dk-ineq! (list '= (list '* 1 (list '* j (list '* j 1))) (list '* j j))))))
(fact 'cps-factor-conv 'cf cpd-cg2 cpd-cfg2 1 2 cpd-mn-t 'cpdr_)
(define cpd-mn-a2 (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list 'magnitude (list cpd-cfg2 'cpsk_)) '(power cpdr_ cpsk_))))
(define (cpd-mn-a2-pt! j)
  (cpd-nn-typ! (list 'succ j))
  (for-each (lambda (i)
              (fact 'fun-apply-type-c 'cf 'NN 'CC i)
              (let ((m (list 'magnitude (list '* (list 'cf i) (list '* i i)))) (p (list 'power 'cpdr_ i)))
                (cpd-rr-typ! m) (fact 'cc-magnitude-nonneg (list '* (list 'cf i) (list '* i i)))
                (cpd-rr-typ! p) (fact 'rr-power-nonneg i 'cpdr_)
                (cpd-nonneg-prod! m p)))
            (list j (list 'succ j))))
(dk-have! (list 'IN cpd-mn-a2 '(FUN NN RR))
  (lambda () (dk-lam-t!) (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (ass))))))
(dk-have! (list 'IN cpd-vv '(FUN NN RR))
  (lambda () (dk-lam-t!) (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (ass))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '<= 0 (list cpd-mn-a2 'cpdj_))))
  (lambda () (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (dk-lam-b!) (ass))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '<= 0 (list cpd-vv 'cpdj_))))
  (lambda () (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (dk-lam-b!) (ass))))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list cpd-vv 'cpdj_) (list cpd-mn-a2 '(succ cpdj_)))))
  (lambda () (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (dk-lam-b!) (rfl))))
(define cpd-mn-siff (dk-fact! 'series-shift-converges-iff cpd-mn-a2 cpd-vv))
(dk-have! (list 'SERIES-CONVERGES cpd-vv)
  (lambda () (dk-only! cpd-mn-siff (list 'SERIES-CONVERGES cpd-mn-a2)) (prop)))
(define cpd-mn-b (dk-skolem! (dk-fact! 'series-partial-sum-bounded cpd-vv)))
(define cpd-mn-bd (dk-pick (lambda (f) (and (eq? (cpd-head f) 'FORALL) (dk-contains? f cpd-mn-b))) "the bound"))
(fact 'nn-zero-in)
(inst+ cpd-mn-bd 0)
(fact 'series-partial-sum-nonneg 0 cpd-vv)
(cpd-rr-typ! (list 'SERIES-PARTIAL-SUM cpd-vv 0))
(dk-have! (list '<= 0 cpd-mn-b)
  (lambda () (dk-ineq! (list '<= 0 (list 'SERIES-PARTIAL-SUM cpd-vv 0)) (list '<= (list 'SERIES-PARTIAL-SUM cpd-vv 0) cpd-mn-b))))
;; the constant M = B / r^2
(define cpd-mn-rr '(* cpdr_ cpdr_))
(fact 'rr-mul-in-rr 'cpdr_ 'cpdr_)
(fact 'rr-mul-pos 'cpdr_ 'cpdr_)
(fact 'rr-pos-ne-zero cpd-mn-rr)
(cpd-and! (list 'IN cpd-mn-rr 'RR) (list 'NOT (list '= cpd-mn-rr 0)))
(fact 'rr-recip-closed cpd-mn-rr)
(fact 'rr-recip-inverse cpd-mn-rr)
(fact 'rr-recip-pos cpd-mn-rr)
(fact 'rr-lt-implies-le 0 (list 'recip cpd-mn-rr))
(define cpd-mn-m (list '* cpd-mn-b (list 'recip cpd-mn-rr)))
(cpd-nonneg-prod! cpd-mn-b (list 'recip cpd-mn-rr))
;; f is a function on the ball
(dk-have! (list 'IN cpd-FS (list 'FUN cpd-B 'CC))
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (let ((g (dk-goal)))
         (cond ((dk-asm? g) (ass))
               ((eq? (cpd-head g) 'FORALL)
                (let ((x (dk-di-var!))) (cpd-bp! x) (ass)))
               (#t (error "cpd: unexpected lam-t leaf" (expression->string g))))))
     (dk-opened (lambda () (lam-t))))))
;; the quadratic bound at every x of the ball
(define cpd-mn-qb
  (subst-free 'cpdm_ cpd-mn-m (subst-free 'cpdl_ cpd-mn-l (subst-free 'cpda_ 'cpda_
    (subst-free 'cpdf_ cpd-FS (subst-free 'cpds_ cpd-B cpd-qb))))))
(dk-have! cpd-mn-qb
  (lambda ()
    (let* ((x (dk-di-var!))
           (d (list '- x 'cpda_)) (md (list 'magnitude d)) (w (list '* md md))
           (eseq (subst-free 'cpdw_ d (subst-free 'cpdhh_ (cpd-tdl 'cpda_)
                   (subst-free 'cpdgg_ (cpd-tzl 'cpda_) (subst-free 'cpdff_ (cpd-tzl x) (cpd-el-seq))))))
           (lim (list '- (list '- (list 'CC-SERIES-LIMIT (cpd-tzl x)) (list 'CC-SERIES-LIMIT (cpd-tzl 'cpda_)))
                         (list '* d cpd-mn-l)))
           (bdv (list '* cpd-mn-m w)))
      (cpd-bp! x)
      (dk-lam-b!)
      (cpd-cc-typ! d)
      (cpd-rr-typ! md) (fact 'cc-magnitude-nonneg d)
      (cpd-nonneg-prod! md md)
      (cpd-rr-typ! bdv)
      (cpd-cc-typ! lim)
      (fact 'cc-partial-error-limit (cpd-tzl x) (cpd-tzl 'cpda_) (cpd-tdl 'cpda_) d)
      (cpd-lam-typ! eseq 'CC (lambda (j) (cpd-cc-typ! (subst-free 'cpdj_ j (cadddr eseq)))))
      (dk-have! (list 'FORALL 'cpdn_ (list 'IMPLIES '(IN cpdn_ NN) (list '<= (list 'magnitude (list eseq 'cpdn_)) bdv)))
        (lambda ()
          (let* ((n (dk-di-var!))
                 (enn (subst-free 'cpdj_ n (cadddr eseq)))
                 (men (list 'magnitude enn))
                 (svn (list 'SERIES-PARTIAL-SUM cpd-vv n)))
            (cpd-cc-typ! enn)
            (cpd-rr-typ! men)
            (dk-lam-b!)
            ;; the value hypotheses of the error bound, for these lambdas
            (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list (cpd-tzl x) 'cpdj_) (list '* '(cf cpdj_) (list 'power x 'cpdj_)))))
              (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c 'cf 'NN 'CC j) (cpd-cc-typ! (list '* (list 'cf j) (list 'power x j))) (dk-lam-b!) (rfl))))
            (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list (cpd-tzl 'cpda_) 'cpdj_) (list '* '(cf cpdj_) (list 'power 'cpda_ 'cpdj_)))))
              (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c 'cf 'NN 'CC j) (cpd-cc-typ! (list '* (list 'cf j) (list 'power 'cpda_ j))) (dk-lam-b!) (rfl))))
            (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list (cpd-tdl 'cpda_) 'cpdj_) (list '* '(dcf cpdj_) (list 'power 'cpda_ 'cpdj_)))))
              (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c 'dcf 'NN 'CC j) (cpd-cc-typ! (list '* (list 'dcf j) (list 'power 'cpda_ j))) (dk-lam-b!) (rfl))))
            (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
                        (list '= (list cpd-vv 'cpdj_) (cadddr cpd-vv))))
              (lambda () (let ((j (dk-di-var!))) (cpd-mn-a2-pt! j) (dk-lam-b!) (rfl))))
            (let ((eb (dk-fact! 'cps-partial-error-bound n 'cf 'dcf x 'cpda_ 'cpdr_
                                (cpd-tzl x) (cpd-tzl 'cpda_) (cpd-tdl 'cpda_) cpd-vv)))
              (inst+ cpd-mn-bd n)
              (fact 'series-partial-sum-in-rr n cpd-vv)
              (cpd-and! (list '<= 0 w) (list '<= svn cpd-mn-b))
              (fact 'rr-le-scale-nonneg w svn cpd-mn-b)
              (cpd-rr-typ! (list '* w svn)) (cpd-rr-typ! (list '* w cpd-mn-b))
              (cpd-rr-typ! (list '* cpd-mn-rr men))
              (cpd-rr-typ! (list '* men cpd-mn-rr))
              (cpd-rr-typ! (list '* bdv cpd-mn-rr))
              (dk-have! (list '= (list '* men cpd-mn-rr) (list '* cpd-mn-rr men)) (lambda () (crs)))
              (let ((ex (list '* (list '* w cpd-mn-b) (list '* cpd-mn-rr (list 'recip cpd-mn-rr)))))
                (dk-have! (list '= (list '* bdv cpd-mn-rr) (list '* w cpd-mn-b))
                  (lambda ()
                    (dk-have! (list '= (list '* bdv cpd-mn-rr) ex) (lambda () (crs)))
                    (subst (list '= (list '* bdv cpd-mn-rr) ex))
                    (subst (list '= (list '* cpd-mn-rr (list 'recip cpd-mn-rr)) 1))
                    (crs))))
              (dk-have! (list '<= (list '* men cpd-mn-rr) (list '* bdv cpd-mn-rr))
                (lambda ()
                  (dk-ineq! (list '= (list '* men cpd-mn-rr) (list '* cpd-mn-rr men))
                            eb
                            (list '<= (list '* w svn) (list '* w cpd-mn-b))
                            (list '= (list '* bdv cpd-mn-rr) (list '* w cpd-mn-b)))))
              (fact 'rr-mul-le-cancel-pos men cpd-mn-rr bdv)
              (ass)))))
      (fact 'cc-limit-magnitude-le eseq lim bdv)
      (ass))))
(fact 'cc-diff-on-quadratic cpd-B cpd-FS 'cpda_ cpd-mn-l cpd-mn-m)
(ass)
(qed 'cps-diff-on-ball)

;;; ---- PROPOSITION 2.10, as the notes state it ------------------------------
;;; "If sum_k a_k z^k has radius of convergence R, then the function
;;; f(z) = sum_k a_k z^k is defined and holomorphic in the open ball B(0, R).
;;; In fact, the series g(z) = sum_{n>=1} n a_n z^(n-1) also has radius of
;;; convergence R and f'(z) = g(z)."  With the convention of the header: for
;;; every real r with 0 < r < R, on B(0, r); g reindexed from 0.
(define cpd-DL '(VNB-LAMBDA cpdn_ NN (* (succ cpdn_) (cf (succ cpdn_)))))
(define (cpd-gl x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(* (succ cpsk_) (cf (succ cpsk_))) (list 'power x 'cpsk_))))
(define cpd-hb-d
  (list 'FORALL 'cpda_ (list 'IMPLIES (list 'IN 'cpda_ cpd-B)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD cpd-B cpd-FS 'cpda_ (list 'CC-SERIES-LIMIT (cpd-gl 'cpda_))))))
(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'FORALL 'cpdr_ (list 'IMPLIES '(IN cpdr_ RR) (list 'IMPLIES '(< 0 cpdr_)
      (list 'IMPLIES '(< cpdr_ (CPS-RADIUS cf))
        (list 'AND (list 'HOLOMORPHIC-ON cpd-B cpd-FS)
          (list 'AND (list '= (list 'CPS-RADIUS cpd-DL) '(CPS-RADIUS cf)) cpd-hb-d))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(cpd-pts-cc!)
(fact 'cc-zero-in)
(dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'rr-lt-implies-le 0 'cpdr_)
(fact 'rr-pos-ne-zero 'cpdr_)
(fact 'neq-sym 'cpdr_ 0)
(cpd-detach-all! (dk-fact! 'ball-is-open 'CC-MS 0 'cpdr_))
(define cpd-hb-oiff (dk-fact! 'cc-ms-open-iff cpd-B))
(dk-have! (list 'IS-OPEN cpd-nfm cpd-B) (lambda () (dk-only! cpd-hb-oiff (list 'IS-OPEN 'CC-MS cpd-B)) (prop)))
(fact 'ball-is-set 'CC-MS 0 'cpdr_)
(fact 'ball-in-closed-ball 'CC-MS 0 'cpdr_)
;; the derived coefficients
(define (cpd-hb-typ! j)
  (cpd-nn-typ! (list 'succ j))
  (fact 'fun-apply-type-c 'cf 'NN 'CC (list 'succ j))
  (cpd-cc-typ! (list '* (list 'succ j) (list 'cf (list 'succ j)))))
(cpd-lam-typ! cpd-DL 'CC cpd-hb-typ!)
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list cpd-DL 'cpdj_) '(* (succ cpdj_) (cf (succ cpdj_))))))
  (lambda () (let ((j (dk-di-var!))) (cpd-hb-typ! j) (dk-lam-b!) (rfl))))
(fact 'cps-radius-derived 'cf cpd-DL)
(dk-have! (list '< 'cpdr_ (list 'CPS-RADIUS cpd-DL))
  (lambda () (subst (list '= (list 'CPS-RADIUS cpd-DL) '(CPS-RADIUS cf))) (ass)))
(define cpd-hb-dd (dk-fact! 'cps-diff-on-ball 'cf cpd-DL 'cpdr_))
;; f' = g on the ball
(dk-have! cpd-hb-d
  (lambda ()
    (let* ((a (dk-di-var!))
           (td (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list cpd-DL 'cpsk_) (list 'power a 'cpsk_))))
           (g (cpd-gl a))
           (lt (list 'CC-SERIES-LIMIT td))
           (lg (list 'CC-SERIES-LIMIT g)))
      (inst+ cpd-hb-dd a)
      (fact 'subset-mem-fwd cpd-B '(CLOSED-BALL CC-MS 0 cpdr_) a)
      (dk-split-all! (list (dk-fact! 'cc-closed-ball-origin 'cpdr_ a)))
      (cpd-mn-typ-tz! a cpd-DL)
      (fact 'cps-converges-closed-ball cpd-DL 'cpdr_ a)
      (fact 'cc-series-limit-in-cc td)
      (cpd-lam-typ! g 'CC (lambda (j) (cpd-hb-typ! j) (cpd-cc-typ! (list '* (list '* (list 'succ j) (list 'cf (list 'succ j))) (list 'power a j)))))
      (fact 'rr-one-in) (fact 'rr-subset-cc 1) (fact 'rr-zero-in) (fact 'rr-subset-cc 0)
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
                  (list '= (list g 'cpdj_) (list '+ (list '* 1 (list td 'cpdj_)) (list '* 0 (list td 'cpdj_))))))
        (lambda ()
          (let ((j (dk-di-var!)))
            (cpd-hb-typ! j)
            (cpd-cc-typ! (list 'power a j))
            (dk-lam-b!)
            (crs))))
      (let ((lin (dk-fact! 'cc-series-limit-linear td td g 1 0)))
        (dk-split-all! (list lin))
        (dk-have! (list '= lg lt)
          (lambda ()
            (subst (list '= lg (list '+ (list '* 1 lt) (list '* 0 lt))))
            (crs)))
        (subst (list '= lg lt))
        (ass)))))
;; holomorphy
(dk-have! (list 'IN cpd-FS (list 'FUN cpd-B 'CC))
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (let ((g (dk-goal)))
         (cond ((dk-asm? g) (ass))
               ((eq? (cpd-head g) 'FORALL)
                (let ((x (dk-di-var!))) (cpd-bp! x) (ass)))
               (#t (error "cpd: unexpected lam-t leaf" (expression->string g))))))
     (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'HOLOMORPHIC-ON cpd-B cpd-FS)
  (lambda ()
    (mac 'HOLOMORPHIC-ON)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (cpd-head (dk-goal)) 'FORALL))
           (ass)
           (let ((a (dk-di-var!)))
             (inst+ cpd-hb-d a)
             (ew (list 'CC-SERIES-LIMIT (cpd-gl a)))
             (ass)))))))
(dk-conj-close! (lambda () (ass)))
(qed 'cps-holomorphic-ball)
