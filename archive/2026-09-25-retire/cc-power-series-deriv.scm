  (lambda () (subst (list '== (list 'PTS cpd-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-have! (list 'SUBSET 'cpds_ (list 'PTS cpd-nfm))
  (lambda () (mac-h 'is-open (list 'IS-OPEN cpd-nfm 'cpds_)) (dk-split-all!) (ass)))
(dk-have! '(SUBSET cpds_ CC) (lambda () (subst (list '== 'CC (list 'PTS cpd-nfm))) (ass)))
