    (rcs-chk--refuses? 'big-union-sethood
      '((() (IN NN SET))
        (() (FORALL v_ (IMPLIES (IN v_ ZZ) (IN (POWER v_) SET)))))
      '(() (IN (BIG-UNION z_ NN (POWER z_)) SET)))))

(check-true "big-union-mem-intro: the witness in A and x in the body at it are accepted"
