;;; BIG-UNION --------------------------------------------------------------

(check-true "big-union-sethood: A in SET and the family pointwise in SET are accepted"
  (lambda ()
    (rcs-chk--accepts? 'big-union-sethood
      '((() (IN NN SET))
        (() (FORALL v_ (IMPLIES (IN v_ NN) (IN (POWER v_) SET)))))
