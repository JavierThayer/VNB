(for-each
 (lambda (nm)
   (check-true (string-append (symbol->string nm) " is PROVEN from the definition")
     (lambda () (and (lookup-theorem nm) (eq? (provenance-of nm) 'proven)))))
 '(eplus-in-fun etimes-in-fun eplus-real-defined etimes-real-defined))

