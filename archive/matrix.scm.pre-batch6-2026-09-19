;;; MATOF(n, n, ...), a description over MAT(n, n, ...), and MAT(3/2, 3/2, X) is
;;; empty (mat-rows-in-nn), so IDENTMAT(A, 3/2) has no value and `=' -- the
;;; definedness predicate -- fails; and for A not a ring (A := 0) ONE(A) and
