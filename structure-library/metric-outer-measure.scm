;;; metric-outer-measure.scm -- the distance between sets, METRIC OUTER MEASURES and
;;; the BOREL SETS of a metric space.  Vocabulary only: no proof, no support.
;;; Agent MEASURE-3-A, 2026-10-09 (scratchpad/triage/MEASURE-3-A.md).  The proofs are
;;; theorem-library/metric-outer-measure.scm.
;;;
;;; SOURCES.  Thayer, Construction of Measures: Ch. 4 Sec. 3, Def. 4.25 (metric
;;; outer measure, p. 38), Prop. 4.26 (Borel sets are measurable) and Lemmas 4.27,
;;; 4.28 (pp. 38-40); the distance between sets is Eq. (406) of the Appendix.
;;;
;;; WHAT AND WHY.
;;;
;;;   * PT-SET-DIST(m, x, es) -- the distance d(x, F) of a point to a set: the
;;;     infimum in [0, +inf] of the distances from x to the points of es.  It is EINF
;;;     of a SEP over RR-POS-STAR, so it is defined for every es; for es empty it is
;;;     +inf, EINF's own convention for the empty set.
;;;
;;;   * SET-DIST(m, aa, bb) -- Eq. (406): the infimum in [0, +inf] of the distances
;;;     d(x, y), x in aa, y in bb (+inf when either set is empty).
;;;
;;;   * IS-METRIC-OUTER-MEASURE(m, mu) -- Def. 4.25: m a metric space, mu an outer
;;;     measure on its points, and mu(aa u bb) = mu(aa) + mu(bb) whenever aa, bb are
;;;     subsets of the points with d(aa, bb) > 0.  "d(aa, bb) > 0" is written
;;;     NOT(SET-DIST(m, aa, bb) = 0): SET-DIST is an element of [0, +inf], where
;;;     "not 0" and "> 0" agree, and the negated equation needs no order fact to
;;;     be used (set-dist-pos-elim turns it into a positive real separating the
;;;     two sets, set-dist-pos-intro back).
;;;
;;;   * BOREL-SETS(m) -- the sigma-algebra of subsets of PTS(m) generated by the
;;;     open sets (the notes' "Borel subsets of X", Def. 4.31 and Prop. 4.26).
;;;
;;; Binder names carry the `mo' prefix (a set built by a driver must use binders that
;;; nothing else binds, CLAUDE.md); the parameter names `es', `aa', `bb' avoid the
;;; case-fold of E / A / B.
;;; ====================================================================

(def-functoid 'PT-SET-DIST '(m x es)
  '(EINF (SEP mov_ RR-POS-STAR
           (FORSOME moz_ (AND (IN moz_ es) (= mov_ ((DIST m) x moz_)))))))

(notation! 'PT-SET-DIST 'kind 'functoid 'arity 3
           'english "the distance in $1 from the point $2 to the set $3")

(def-functoid 'SET-DIST '(m aa bb)
  '(EINF (SEP mow_ RR-POS-STAR
           (FORSOME mox_ (AND (IN mox_ aa)
             (FORSOME moy_ (AND (IN moy_ bb) (= mow_ ((DIST m) mox_ moy_)))))))))

(notation! 'SET-DIST 'kind 'functoid 'arity 3
           'english "the distance in $1 between the sets $2 and $3")

(def-predicate 'IS-METRIC-OUTER-MEASURE '(m mu)
  (conjuncts->and
    (list
      '(IS-METRIC-SPACE m)
      '(IS-OUTER-MEASURE (PTS m) mu)
      '(FORALL moa_ (IMPLIES (IN moa_ (POWER (PTS m)))
         (FORALL mob_ (IMPLIES (IN mob_ (POWER (PTS m)))
           (IMPLIES (NOT (= (SET-DIST m moa_ mob_) 0))
             (= (mu (UNION moa_ mob_)) (eplus (mu moa_) (mu mob_)))))))))))

(notation! 'IS-METRIC-OUTER-MEASURE 'kind 'predicate 'arity 2
           'english "$2 is a metric outer measure on the metric space $1")

(def-functoid 'BOREL-SETS '(m)
  '(SIGMA-GENERATED (PTS m) (SEP mou_ (POWER (PTS m)) (IS-OPEN m mou_))))

(notation! 'BOREL-SETS 'kind 'functoid 'arity 1
           'english "the Borel subsets of the metric space $1")
