;;; gal-char-vocab.scm -- prime natural numbers and the characteristic of a field (galois-theory notes,
;;; section 3) (GALOIS B8, 2026-10-26).  DEFINITIONS ONLY.  Destination: structure-library/gal-char-vocab.scm,
;;; library algebra.  Load window: after catools-gal-vocab (IS-PRIME-ELEMENT), zz-action.scm (ZZ-ACT).
;;;
;;; IS-PRIME-NAT(p): p is a natural number which is a prime element of the ring Z, i.e. p is a prime
;;; in the usual sense (p >= 2 with no factorization into two non-units).
(def-predicate 'IS-PRIME-NAT '(gpn_)
  '(AND (IN gpn_ NN) (IS-PRIME-ELEMENT ZZ-RING gpn_)))
(notation! 'IS-PRIME-NAT 'kind 'predicate 'arity 1 'english "$1 is a prime number")

;;; HAS-CHARACTERISTIC(F, p): p is a prime and p . 1 = 0 in F (the multiple taken in the additive group),
;;; i.e. the kernel of Z -> F is generated by p (notes, case (2)).
(def-predicate 'HAS-CHARACTERISTIC '(ghc_ gcp_)
  '(AND (IS-PRIME-NAT gcp_) (= (ZZ-ACT (RING-ADDITIVE-AG ghc_) gcp_ (ONE ghc_)) (ZERO ghc_))))
(notation! 'HAS-CHARACTERISTIC 'kind 'predicate 'arity 2 'english "$1 has characteristic $2")
