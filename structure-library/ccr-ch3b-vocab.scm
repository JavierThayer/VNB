;;; ccr-ch3b-vocab.scm -- CCR.pdf chapter 3, the definitions the second pass needs: Definition 3.1
;;; (irreducible operator), Definition 3.7 (a norm on a vector space over a normed field), the
;;; Z(K)-algebra generated by an operator and polynomial evaluation in the matrix ring (Proposition 3.3,
;;; polynomial clause), the column of a matrix.  DEFINITIONS ONLY; the laws are in
;;; theorem-library/ccr-ch3b-*.scm.  Agent CCR-1109-B2, wave 2026-11-09.
;;; Destination: structure-library/ccr-ch3b-vocab.scm.  Library: analysis (beside ccr-ch3-vocab: the
;;; definitions mention FNRM, NV-INTEGERS and IS-MAT-BOUND's conventions).
;;;
;;; THE MODEL (that of ccr-ch3-vocab).  K is a normed field, V = NORMED-FIELD-AS-COMMUTATIVE-RING(K) its
;;; ring view, an operator on K^n is its n-by-n matrix in MAT(n, n, CARR K), a vector of K^n is a column
;;; MAT(n, 1, CARR K), the operations are MATMUL / MATADD / MATSCALE / IDENTMAT / ZEROMAT over V, and T^k
;;; is MAT-POWER(K, n, T, k).
;;;
;;;   COL-OF(Q, n, j)            the j-th column of the matrix Q, an n-by-1 matrix.
;;;   KRYLOV-MAT(K, n, T, phi)   the n-by-n matrix whose j-th column is T^(j-1) phi (j = 1..n).
;;;   IS-IRREDUCIBLE-MAT(K, n, T)  Definition 3.1: T is n-by-n and for every non-zero phi in K^n the
;;;                              vectors phi, T phi, ..., T^(n-1) phi span K^n: every xi in K^n is
;;;                              KRYLOV-MAT(K, n, T, phi) c for a column c of coefficients.
;;;   ZPOLY-ALG(K, n, T)         Z(K)[T]: the least set of n-by-n matrices containing I and 0 and closed
;;;                              under X |-> X T, under + and under multiplication by the scalars of
;;;                              NV-INTEGERS(K) = Z(K) = {c : |c| <= 1}.
;;;   MAT-POLY-EVAL(K, n, p, T)  p(T) = sum_{k <= deg p} p(k) T^k, for p a polynomial over V (the sum is
;;;                              SUM-AG in the additive group of MAT-RING(V, n), as POLY-EVAL of
;;;                              structure-library/gal-poly-vocab.scm is in a ring).  POLY-OP
;;;                              (gal-op) evaluates a polynomial at a module endomorphism and returns
;;;                              the value at a VECTOR; power boundedness is a statement about the
;;;                              MATRIX p(T), so the matrix-ring form is defined here.
;;;   IS-NORM-ON(K, E, nu)       Definition 3.7: E a module over the ring view of K (a vector space
;;;                              over K), nu : VEC(E) -> RR with nu >= 0, nu(x) = 0 iff x = 0, the
;;;                              triangle inequality, and nu(r x) = |r|_K nu(x).  A NORM, in the notes,
;;;                              is a functional on E, not a structure, so it is a predicate on the
;;;                              triple; the module conventions are the tree's (VEC VADD ACT VZERO of
;;;                              IS-MODULE), the scalars are tied to K by SCAL(E) = V, as for every
;;;                              vector space over a field in the tree (IS-VECTOR-SPACE is IS-MODULE
;;;                              with SCAL a field ring).  NORMED-VECTOR-SPACE (structure-library/
;;;                              normed-vector-space.scm) is the special case K = RR of a structure;
;;;                              it is not reused because its scalars are RR by its shape.
;;;
;;; Load window: after structure-library/ccr-ch3-vocab (MAT-POWER, IS-MAT-BOUND), ccr2-vocab
;;; (NV-INTEGERS), module, matrix, sequences (SUM-AG), poly-degree (DEG).
;;; Binders zkv*_: names no other definition uses.  No axiom, support or stamp.

(def-functoid 'COL-OF '(Q n j)
  '(MATOF n 1 (VNB-LAMBDA (LIST zkvi_ zkvu_) (CARTESIAN (INTERVAL 1 n) (INTERVAL 1 1)) (ENTRY Q zkvi_ j))))
(notation! 'COL-OF 'kind 'functoid 'arity 3 'english "the column $3 of $1")

(def-functoid 'KRYLOV-MAT '(K n tm phi)
  '(MATOF n n (VNB-LAMBDA (LIST zkvi_ zkvj_) (CARTESIAN (INTERVAL 1 n) (INTERVAL 1 n))
     (ENTRY (MATMUL (NORMED-FIELD-AS-COMMUTATIVE-RING K) (MAT-POWER K n tm (- zkvj_ 1)) phi) zkvi_ 1))))
(notation! 'KRYLOV-MAT 'kind 'functoid 'arity 4
           'english "the matrix with columns $4, $3 $4, ..., $3^($2 - 1) $4")

(def-predicate 'IS-IRREDUCIBLE-MAT '(K n tm)
  '(AND (IN tm (MAT n n (CARR K)))
        (FORALL zkvp_ (IMPLIES (IN zkvp_ (MAT n 1 (CARR K)))
          (IMPLIES (NOT (= zkvp_ (ZEROMAT (NORMED-FIELD-AS-COMMUTATIVE-RING K) n 1)))
            (FORALL zkvx_ (IMPLIES (IN zkvx_ (MAT n 1 (CARR K)))
              (FORSOME zkvc_ (AND (IN zkvc_ (MAT n 1 (CARR K)))
                (= zkvx_ (MATMUL (NORMED-FIELD-AS-COMMUTATIVE-RING K) (KRYLOV-MAT K n tm zkvp_) zkvc_)))))))))))
(notation! 'IS-IRREDUCIBLE-MAT 'kind 'predicate 'arity 3
           'english "the $2-by-$2 matrix $3 over $1 is irreducible")

(def-functoid 'ZPOLY-ALG '(K n tm)
  '(INTERSECTION-OF
     (SEP zkvs_ (POWER (MAT n n (CARR K)))
       (AND (IN (IDENTMAT (NORMED-FIELD-AS-COMMUTATIVE-RING K) n) zkvs_)
       (AND (IN (ZEROMAT (NORMED-FIELD-AS-COMMUTATIVE-RING K) n n) zkvs_)
       (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ zkvs_)
              (IN (MATMUL (NORMED-FIELD-AS-COMMUTATIVE-RING K) zkvx_ tm) zkvs_)))
       (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ zkvs_) (FORALL zkvy_ (IMPLIES (IN zkvy_ zkvs_)
              (IN (MATADD (NORMED-FIELD-AS-COMMUTATIVE-RING K) zkvx_ zkvy_) zkvs_)))))
            (FORALL zkvx_ (IMPLIES (IN zkvx_ zkvs_) (FORALL zkvc_ (IMPLIES (IN zkvc_ (NV-INTEGERS K))
              (IN (MATSCALE (NORMED-FIELD-AS-COMMUTATIVE-RING K) zkvc_ zkvx_) zkvs_))))))))))))
(notation! 'ZPOLY-ALG 'kind 'functoid 'arity 3 'english "Z($1)[$3]")

(def-functoid 'MAT-POLY-EVAL '(K n p tm)
  '(SUM-AG (RING-ADDITIVE-AG (MAT-RING (NORMED-FIELD-AS-COMMUTATIVE-RING K) n))
           (VNB-LAMBDA zkvk_ NN (MATSCALE (NORMED-FIELD-AS-COMMUTATIVE-RING K) (p zkvk_) (MAT-POWER K n tm zkvk_)))
           (succ (DEG (NORMED-FIELD-AS-COMMUTATIVE-RING K) p))))
(notation! 'MAT-POLY-EVAL 'kind 'functoid 'arity 4 'english "$3($4)")

(def-predicate 'IS-NORM-ON '(K md nu)
  '(AND (IS-MODULE md)
   (AND (= (SCAL md) (NORMED-FIELD-AS-COMMUTATIVE-RING K))
   (AND (IN nu (FUN (VEC md) RR))
   (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (<= 0 (nu zkvx_))))
   (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (IFF (= (nu zkvx_) 0) (= zkvx_ (VZERO md)))))
   (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (FORALL zkvy_ (IMPLIES (IN zkvy_ (VEC md))
          (<= (nu ((VADD md) zkvx_ zkvy_)) (+ (nu zkvx_) (nu zkvy_)))))))
        (FORALL zkvr_ (IMPLIES (IN zkvr_ (CARR K)) (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md))
          (= (nu ((ACT md) zkvr_ zkvx_)) (* ((FNRM K) zkvr_) (nu zkvx_))))))))))))))
(notation! 'IS-NORM-ON 'kind 'predicate 'arity 3 'english "$3 is a norm on the vector space $2 over $1")
