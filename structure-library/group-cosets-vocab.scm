;;; structure-library/group-cosets-vocab.scm -- cosets and the subgroup generated by an element (ALGNUM, B5,
;;; 2026-10-26).  DEFINITIONS ONLY.  Library: algebra.  Load window: after the subgroup vocabulary (IS-SUBGROUP,
;;; scratchpad/cg1/cg1-vocab.scm, unwired).  Purely algebraic: no topology.
;;;
;;;   LEFT-COSET(G, a, H)   aH = {a h : h in H}
;;;   LEFT-COSETS(G, H)     G/H, the set of left cosets aH, a in G
;;;   GENERATED-SUBGROUP(G, x)   the intersection of the subgroups of G that contain x (the notes' "group
;;;                         generated by x"); subgroups range over the subsets of CARR(G)
(def-functoid 'LEFT-COSET '(gcg_ gca_ gch_)
  '(SEP gcx_ (CARR gcg_) (FORSOME gcy_ (AND (IN gcy_ gch_) (= gcx_ ((OPR gcg_) gca_ gcy_))))))
(notation! 'LEFT-COSET 'kind 'functoid 'arity 3 'english "the left coset of $3 by $2 in $1")
(def-functoid 'LEFT-COSETS '(gcg_ gch_)
  '(SEP gcc_ (POWER (CARR gcg_)) (FORSOME gca_ (AND (IN gca_ (CARR gcg_)) (= gcc_ (LEFT-COSET gcg_ gca_ gch_))))))
(notation! 'LEFT-COSETS 'kind 'functoid 'arity 2 'english "the set of left cosets of $2 in $1")
(def-functoid 'GENERATED-SUBGROUP '(gcg_ gcx_)
  '(SEP gcy_ (CARR gcg_) (FORALL gcs_ (IMPLIES (IN gcs_ (POWER (CARR gcg_)))
     (IMPLIES (IS-SUBGROUP gcg_ gcs_) (IMPLIES (IN gcx_ gcs_) (IN gcy_ gcs_)))))))
(notation! 'GENERATED-SUBGROUP 'kind 'functoid 'arity 2 'english "the subgroup of $1 generated by $2")
