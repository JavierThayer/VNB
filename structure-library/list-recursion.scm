;;; list-recursion.scm -- CONS, and the recursive characterization of LENGTH.
;;;
;;; WHY THIS FILE EXISTS.  library.scm gave TUPLES three axioms -- `length-of-empty',
;;; `length-in-nn', `nth-in-range' -- and then said, in a comment beside them
;;; (library.scm:637):
;;;
;;;   (Recursive characterization of length requires a CONS/PREPEND constructor
;;;    and a TUPLES induction principle, both pending.)
;;;
;;; Both were still pending, and the cost was paid one literal at a time.
;;; `theorem-library/makeset-basics.scm' writes the two-element case out by hand
;;; -- ms-index-2, ms-nth-2, makeset2-membership, makeset2-split, card-pair --
;;; and its header says why: a general law "wants a LIST recursion the theory
;;; does not have".  So `card({a,b})' is a theorem and `card({a,b,c})' is not,
;;; and the ladder would have to be climbed again for every arity.
;;;
;;; This file supplies the missing constructor and the missing generation
;;; principle.  The induction principle is NOT asserted here: it is PROVEN, in
;;; theorem-library/tuples-induction.scm, from these axioms and `nn-induction'
;;; by induction on the length.  That is the point of stating generation rather
;;; than induction -- the two say the same thing about TUPLES, but generation is
;;; a concrete decomposition that an existing induction principle can consume,
;;; and it leaves the tree with one fewer asserted induction schema.
;;;
;;; WHAT IS DEFINITIONAL AND WHAT IS ASSERTED, and the line between them:
;;;
;;;   definitional -- the four equations that say what CONS DOES.  CONS is a new
;;;     head; equations constraining a new symbol add no consequence about the
;;;     old vocabulary, exactly as `binary-minus-def' (number-systems.scm) adds
;;;     none about `-'.  They pin CONS down to the extent tuples are pinned down
;;;     by their length and their entries, which is what the kernel's
;;;     `tuple-equality-decompose' rule takes a tuple to be.
;;;
;;;   asserted + warrant! -- the two GENERATION axioms, which are claims about
;;;     TUPLES, not about CONS: that the only tuple of length 0 is the empty one,
;;;     and that every longer tuple is a CONS.  Together they say TUPLES(A) is
;;;     generated by [] and CONS, which is the content of "a tuple is a FINITE
;;;     sequence".  A case can be made that this is what TUPLES *is* and belongs
;;;     on the primitive shelf beside the ordinal axioms; that is a foundational
;;;     decision and is left to the user rather than taken here.  Until it is
;;;     taken, every proof by list induction will carry these two in its bill,
;;;     which is the honest report.
;;;
;;; The typing axioms (`empty-in-tuples', `cons-in-tuples') are the closure
;;; facts any constructor owes and are stamped `definitional' with the
;;; equations: they say CONS lands where its arguments came from.

;;; -----------------------------------------------------------------------
;;; The defining equations of CONS.
;;;
;;; CONS x L is the tuple whose first entry is x and whose remaining entries are
;;; those of L.  NTH is 1-based here, as everywhere in the tree (`nth-in-range'
;;; guards 1 <= i <= LENGTH L), so the entry equations split at index 1.
;;; -----------------------------------------------------------------------

(fluid-let ((*current-provenance* 'definitional))

  ;; [] is a tuple over anything; CONS lands back in TUPLES(A).
  (add-axiom! *library* 'empty-in-tuples
    '(FORALL A (IN (LIST) (TUPLES A))))

  (add-axiom! *library* 'cons-in-tuples
    '(FORALL A (FORALL x (FORALL L
        (IMPLIES (AND (IN x A) (IN L (TUPLES A)))
                 (IN (CONS x L) (TUPLES A)))))))

  ;; THE HEAD GUARD `x in SET' on the four equations below (the user's decision,
  ;; 2026-10-13).  Each is a STRICT equation, and NTH and LENGTH are strict
  ;; (the list doctrine of 2026-10-01): unguarded, `nth-cons-1' at x := ORD made
  ;; NTH(1, CONS(ORD, L)) = ORD, hence CONS(ORD, L) DEFINED, for every L -- a
  ;; tuple with a proper class in a component, which the doctrine says does not
  ;; denote ([ORD] is undefined).  It was not yet a road to FALSITY (nothing put
  ;; such a CONS into a class, and `tuple-members-are-sets' would then give
  ;; ORD in SET against Burali-Forti), but it was the shape of the door that
  ;; manufactured [0, SET] in C before 2026-10-01.  With the guard, CONS denotes
  ;; for a set head exactly as LIST does, and every citer holds the head's
  ;; sethood (it comes from a TUPLES membership).  `nth-cons-succ' is the same
  ;; species and carries the same guard.

  ;; length(cons(x,L)) = succ(length(L))  -- the recursion the file is named for.
  (add-axiom! *library* 'length-cons
    '(FORALL x (FORALL L (IMPLIES (IN x SET) (= (LENGTH (CONS x L)) (succ (LENGTH L)))))))

  ;; The head, and the shift on the tail.
  (add-axiom! *library* 'nth-cons-1
    '(FORALL x (FORALL L (IMPLIES (IN x SET) (= (NTH 1 (CONS x L)) x)))))

  (add-axiom! *library* 'nth-cons-succ
    '(FORALL i (FORALL x (FORALL L
        (IMPLIES (IN x SET)
          (IMPLIES (AND (IN i NN) (AND (<= 1 i) (<= i (LENGTH L))))
                   (= (NTH (succ i) (CONS x L)) (NTH i L))))))))

  ;; The bridge to brace notation: {x} u {the rest}.  PAIR x x is the singleton,
  ;; written that way to match `card-insert' (cardinality.scm), which is what
  ;; every cardinality argument over a literal set will meet next.
  (add-axiom! *library* 'makeset-cons
    '(FORALL x (FORALL L
        (IMPLIES (IN x SET)
          (= (MAKE-SET (CONS x L))
             (UNION (PAIR x x) (MAKE-SET L)))))))

  )   ; end definitional

;;; -----------------------------------------------------------------------
;;; Generation: TUPLES(A) is generated by [] and CONS.
;;;
;;; These two are the claims about TUPLES.  Stated as a decomposition rather
;;; than as an induction schema, so that `nn-induction' can do the induction:
;;; see theorem-library/tuples-induction.scm, where the schema is derived.
;;;
;;; THEY ARE FOUNDATIONAL, and are installed as such (user's decision,
;;; 2026-09-15).  Both were asserted PSS supports whose own warrants nominated
;;; them for this shelf; they are now `primitive' provenance (proof-debt.scm:12,
;;; the trusted-base tier that contributes {} to every bill), beside the ordinal
;;; axioms (ordinals.scm) and replacement (injection.scm).
;;;
;;; THE CLAIM THE STAMP MAKES, written down because a `primitive' fact is
;;; invisible to the debt ledger: that TUPLES(A) contains NOTHING BUT the
;;; finite sequences over A -- every tuple of length 0 is [], and every tuple
;;; of length succ n is a CONS onto a tuple of length n.  That is the content
;;; of "a tuple is a finite sequence", and nothing else in this tree says it:
;;; TUPLES has no other defining characterisation, so these are not facts the
;;; library could owe an argument for -- they are what the constructor means.
;;; The test CLAUDE.md sets for the shelf is whether a mathematician would
;;; answer "because that is what a finite sequence is"; here they would.
;;;
;;; They are NOT `warrant!'s.  A warrant moves a fact from `none' to
;;; `well-known' -- a better tier of DEBT; `primitive' says it is not debt.
;;; Note the one thing the stamp does NOT license: it says tuples are generated
;;; by [] and CONS, and says nothing about whether a given class IS a TUPLES.
;;; -----------------------------------------------------------------------

(fluid-let ((*current-provenance* 'primitive))

(add-axiom! *library* 'tuple-length-zero
  '(FORALL A (FORALL L
      (IMPLIES (AND (IN L (TUPLES A)) (= (LENGTH L) 0))
               (= L (LIST))))))


(add-axiom! *library* 'tuple-cons-decompose
  '(FORALL A (FORALL n (FORALL L
      (IMPLIES (AND (IN n NN) (AND (IN L (TUPLES A)) (= (LENGTH L) (succ n))))
               (FORSOME x (AND (IN x A)
                               (FORSOME M (AND (IN M (TUPLES A))
                                               (AND (= (LENGTH M) n)
                                                    (= L (CONS x M))))))))))))


)   ; end (fluid-let ((*current-provenance* 'primitive)) ...) -- 2 axioms

(topic! 'tuple-length-zero 'combinatorial)
(topic! 'tuple-cons-decompose 'combinatorial)

;;; -----------------------------------------------------------------------
;;; NO NATURAL NUMBER IS A LIST.  One primitive fact (agent SB-5, 2026-10-26; wired 2026-10-27).
;;;
;;; THE USER'S DECISION, 2026-10-26 (the token law, option (A) of scratchpad/triage/SB-5-REPORT.md).
;;;
;;; WHY THIS AXIOM IS INCLUDED.
;;;
;;; (1) No set is provably a non-list without it.  The base theory pins lists down only through their
;;;     length and their entries: TUPLES has typing, length and entry axioms and the two generation
;;;     axioms above (a tuple of length 0 is [], a tuple of length succ(n) is a CONS), and CONS has its
;;;     defining equations.  None of these says WHICH sets [] and CONS(x, m) are, and none says that a
;;;     given set is NOT a list.  All of them remain true in a model in which every set is a list (under
;;;     global choice the classes V and V^{<omega} are equinumerous; encode the lists through such a
;;;     bijection).  Hence, for every particular x, "x is not a list" is independent of the base theory.
;;;
;;; (2) Without it the token law is satisfied only by the empty token set.  IS-TOKEN-SET(T)
;;;     (structure-library/strand-messages.scm) requires that no member of T be in TUPLES(SET).  In the
;;;     model of (1), TUPLES(SET) contains every set, so the only token set is EMPTY-SET and every strand
;;;     space has no tokens.  Every strand-space theorem is then a statement about structures the theory
;;;     cannot exhibit, and may hold vacuously; and no concrete bundle, in particular the counterexample of
;;;     strand-spaces section 7.3.3, can be constructed, since its names, nonces and keys must be distinct
;;;     tokens.  With the axiom, every subset of NN is a token set (nn-subset-token-set).
;;;
;;; (3) Relative consistency: the Kuratowski-pair model of lists.  Interpret the naturals as the von
;;;     Neumann naturals, [] as a set that is neither a natural nor a Kuratowski pair (for example
;;;     {2} = {{0, 1}}), and CONS(x, m) as the Kuratowski pair (x, m) = {{x}, {x, m}}, with LENGTH and NTH
;;;     defined by recursion on this encoding.  Every TUPLES, CONS, LENGTH and NTH axiom of the tree holds
;;;     in this interpretation.  No von Neumann natural is a Kuratowski pair: 0 is empty; 1 = {0} would
;;;     need {x} = 0; 2 = {0, 1} would need {x} = 1, so x = 0, and then {x, m} = 0, which is impossible;
;;;     every n >= 3 has at least three members, while a pair has at most two.  No natural is [] either.
;;;     So no natural is a list, and the axiom is consistent relative to NBG with the rest of the base
;;;     theory.  (The numbers of the tree are otherwise axiomatic, number-systems.scm and ordinals.scm,
;;;     so this interpretation of NN is compatible with them.)
;;;
;;; WHAT THE STAMP CLAIMS.  `primitive' contributes {} to every bill.  The claim is that a natural number
;;; is a number and not a finite sequence; this is part of what the two notions mean in this tree, in the
;;; way pos-inf-above-reals is part of what POS-INF means.  The decision is the user's, 2026-10-26 (option
;;; (A) of scratchpad/triage/SB-5-REPORT.md).
;;;
;;; SAFETY SCAN (2026-10-26, on the band 401ea2bd; SB-5-REPORT.md): no primitive, definitional or
;;; asserted fact, no kernel rule (tuples-intro and tuples-elim act on literal LIST terms only) and no
;;; oracle (arith decides membership in NN, ZZ, QQ, RR and CC only) places a natural in TUPLES of
;;; anything or equates [] or a CONS with a number.
(fluid-let ((*current-provenance* 'primitive))
  (add-axiom! *library* 'nn-not-a-list
    '(FORALL n (IMPLIES (IN n NN) (NOT (IN n (TUPLES SET)))))))
(topic! 'nn-not-a-list 'combinatorial)
