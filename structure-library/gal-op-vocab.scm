;;; gal-op-vocab.scm -- a linear operator T on a module E over F as an F[x]-module: the iterates T^k, the
;;; operator p(T), the T-cyclic subspace, cyclic vectors, monic, annihilating and minimum polynomials, the
;;; Krylov family v, Tv, ..., T^(n-1) v, and the matrix of an operator in a basis (galois-theory notes,
;;; section 7, Definition 1.35, Proposition 1.36) (GALOIS B6, 2026-10-26).  DEFINITIONS ONLY.
;;; Destination: structure-library/gal-op-vocab.scm, library linear-algebra.  Load window: after
;;; polynomial.scm / poly-degree.scm (POLY, DEG), sequences.scm (SUM-AG), the module and LINCOMB files.
;;;
;;; Conventions.  md is a module, F = SCAL(md) its scalar ring, T a map VEC(md) -> VEC(md) (the theorems
;;; assume IS-HOM-MODULE(md, md, T)).  A polynomial over F is its coefficient sequence p : NN -> CARR(F)
;;; (POLY = MONALG(F, NN-ADD-MONOID)), as in POLY-EVAL.

;;; T^k w, by recursion on k: T^0 w = w, T^(k+1) w = T(T^k w).
(def-by-nn-recursion 'OP-ITER '(goi-md_ goi-t_ goi-w_)
  'goi-w_
  '(m val)
  '(goi-t_ val))
(notation! 'OP-ITER 'arity 4 'english "$2^$4 applied to $3")

;;; p(T) w = sum_{k <= deg p} p_k T^k w.  The map p |-> p(T) makes VEC(md) an F[x]-module (p . w = p(T) w).
(def-functoid 'POLY-OP '(gpo-md_ gpo-t_ gpo-p_ gpo-w_)
  '(SUM-AG (MODULE-VECTOR-AG gpo-md_)
           (VNB-LAMBDA gpok_ NN ((ACT gpo-md_) (gpo-p_ gpok_) (OP-ITER gpo-md_ gpo-t_ gpo-w_ gpok_)))
           (succ (DEG (SCAL gpo-md_) gpo-p_))))
(notation! 'POLY-OP 'arity 4 'english "$3($2) applied to $4")

;;; Definition 1.35: the T-cyclic subspace Z_{T,v} = { p(T) v : p in F[x] }.
(def-functoid 'CYCLIC-SUBSPACE '(gcs-md_ gcs-t_ gcs-v_)
  '(SEP gcsz_ (VEC gcs-md_)
     (FORSOME gcsq_ (AND (IN gcsq_ (CARR (POLY (SCAL gcs-md_)))) (= gcsz_ (POLY-OP gcs-md_ gcs-t_ gcsq_ gcs-v_))))))
(notation! 'CYCLIC-SUBSPACE 'arity 3 'english "the $2-cyclic subspace generated by $3")

;;; v is cyclic for T: every vector is p(T) v for some polynomial p.
(def-predicate 'IS-CYCLIC-VECTOR '(gcv-md_ gcv-t_ gcv-v_)
  '(AND (IN gcv-v_ (VEC gcv-md_))
        (FORALL gcvw_ (IMPLIES (IN gcvw_ (VEC gcv-md_))
          (FORSOME gcvq_ (AND (IN gcvq_ (CARR (POLY (SCAL gcv-md_)))) (= gcvw_ (POLY-OP gcv-md_ gcv-t_ gcvq_ gcv-v_))))))))
(notation! 'IS-CYCLIC-VECTOR 'kind 'predicate 'arity 3 'english "$3 is a cyclic vector for $2")

;;; p is monic: its leading coefficient is 1.
(def-predicate 'IS-MONIC '(gmo-f_ gmo-p_)
  '(AND (IN gmo-p_ (CARR (POLY gmo-f_))) (= (gmo-p_ (DEG gmo-f_ gmo-p_)) (ONE gmo-f_))))
(notation! 'IS-MONIC 'kind 'predicate 'arity 2 'english "$2 is a monic polynomial over $1")

;;; kappa_{T,v}: the monic polynomial of smallest degree with p(T) v = 0.
(def-predicate 'IS-ANNIHILATING-POLY '(gan-md_ gan-t_ gan-v_ gan-k_)
  '(AND (IS-MONIC (SCAL gan-md_) gan-k_)
        (AND (= (POLY-OP gan-md_ gan-t_ gan-k_ gan-v_) (VZERO gan-md_))
             (FORALL ganq_ (IMPLIES (IN ganq_ (CARR (POLY (SCAL gan-md_))))
               (IMPLIES (NOT (= ganq_ (ZERO (POLY (SCAL gan-md_)))))
                 (IMPLIES (= (POLY-OP gan-md_ gan-t_ ganq_ gan-v_) (VZERO gan-md_))
                   (<= (DEG (SCAL gan-md_) gan-k_) (DEG (SCAL gan-md_) ganq_)))))))))
(notation! 'IS-ANNIHILATING-POLY 'kind 'predicate 'arity 4 'english "$4 is the annihilating polynomial of $2 at $3")

;;; The minimum polynomial of T: the monic polynomial of smallest degree with p(T) = 0.
(def-predicate 'IS-MINIMAL-POLY '(gmp-md_ gmp-t_ gmp-k_)
  '(AND (IS-MONIC (SCAL gmp-md_) gmp-k_)
        (AND (FORALL gmpw_ (IMPLIES (IN gmpw_ (VEC gmp-md_)) (= (POLY-OP gmp-md_ gmp-t_ gmp-k_ gmpw_) (VZERO gmp-md_))))
             (FORALL gmpq_ (IMPLIES (IN gmpq_ (CARR (POLY (SCAL gmp-md_))))
               (IMPLIES (NOT (= gmpq_ (ZERO (POLY (SCAL gmp-md_)))))
                 (IMPLIES (FORALL gmpw_ (IMPLIES (IN gmpw_ (VEC gmp-md_)) (= (POLY-OP gmp-md_ gmp-t_ gmpq_ gmpw_) (VZERO gmp-md_))))
                   (<= (DEG (SCAL gmp-md_) gmp-k_) (DEG (SCAL gmp-md_) gmpq_)))))))))
(notation! 'IS-MINIMAL-POLY 'kind 'predicate 'arity 3 'english "$3 is the minimum polynomial of $2")

;;; The family v, T v, ..., T^(n-1) v as an n x 1 column (the shape GENERATES / REL-FREE / LINCOMB use).
(def-functoid 'KRYLOV '(gkr-md_ gkr-t_ gkr-v_ gkr-n_)
  '(MATOF gkr-n_ 1 (VNB-LAMBDA (LIST gkri_ gkrj_) (CARTESIAN (INTERVAL 1 gkr-n_) (INTERVAL 1 1))
                     (OP-ITER gkr-md_ gkr-t_ gkr-v_ (- gkri_ 1)))))
(notation! 'KRYLOV 'arity 4 'english "the vectors $3, $2 $3, ..., $2^($4 - 1) $3")

;;; Column j of an n x n matrix, laid out as a 1 x n row (a coefficient row for LINCOMB).
(def-functoid 'COL-AS-ROW '(gcr-a_ gcr-n_ gcr-j_)
  '(MATOF 1 gcr-n_ (VNB-LAMBDA (LIST gcri_ gcrk_) (CARTESIAN (INTERVAL 1 1) (INTERVAL 1 gcr-n_))
                     (ENTRY gcr-a_ gcrk_ gcr-j_))))
(notation! 'COL-AS-ROW 'arity 3 'english "column $3 of $1 as a row")

;;; A is the matrix of T in the family u = (u_1, ..., u_n): T u_j = sum_i A_ij u_i for every j.
(def-predicate 'IS-MATRIX-OF '(gmx-md_ gmx-n_ gmx-u_ gmx-t_ gmx-a_)
  '(AND (IN gmx-a_ (MAT gmx-n_ gmx-n_ (CARR (SCAL gmx-md_))))
        (FORALL gmxj_ (IMPLIES (IN gmxj_ (INTERVAL 1 gmx-n_))
          (= (gmx-t_ (ENTRY gmx-u_ gmxj_ 1)) (LINCOMB gmx-md_ gmx-n_ (COL-AS-ROW gmx-a_ gmx-n_ gmxj_) gmx-u_))))))
(notation! 'IS-MATRIX-OF 'kind 'predicate 'arity 5 'english "$5 is the matrix of $4 in the basis $3")

;;; The linear span of the family u = (u_1, ..., u_n): all linear combinations sum_i c_i u_i.
(def-functoid 'LIN-SPAN '(gls-md_ gls-n_ gls-u_)
  '(SEP glsx_ (VEC gls-md_)
     (FORSOME glsc_ (AND (IN glsc_ (MAT 1 gls-n_ (CARR (SCAL gls-md_)))) (= glsx_ (LINCOMB gls-md_ gls-n_ glsc_ gls-u_))))))
(notation! 'LIN-SPAN 'arity 3 'english "the span of $3")

;;; T is nilpotent (Example 1.39): T^k = 0 for some k.
(def-predicate 'IS-NILPOTENT-OP '(gnp-md_ gnp-t_)
  '(FORSOME gnpk_ (AND (IN gnpk_ NN)
     (FORALL gnpw_ (IMPLIES (IN gnpw_ (VEC gnp-md_)) (= (OP-ITER gnp-md_ gnp-t_ gnpw_ gnpk_) (VZERO gnp-md_)))))))
(notation! 'IS-NILPOTENT-OP 'kind 'predicate 'arity 2 'english "$2 is nilpotent")
