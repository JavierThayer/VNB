;;; strand-ideals.scm -- IDEALS OF THE MESSAGE ALGEBRA (Thayer, Herzog, Guttman, "Strand spaces:
;;; proving security protocols correct", section 6.1, Definitions 6.1, 6.2, 6.5 and the stages of
;;; Lemma 6.4), ON THE USER'S MODEL (notes-60 with encryption: tokens, tagged n-ary lists LST(l),
;;; encryptions ENCR(m, y); structure-library/strand-messages.scm).
;;; DEFINITIONS ONLY; every law is PROVEN in theorem-library/strand-ideals.scm.
;;; Agent SB-1 of wave MAP-1026, 2026-10-26.  Destination: structure-library/strand-ideals.scm.
;;; Library: strand.  Load window: after structure-library/strand-messages (MSG-SET, LST, ENCR)
;;; and structure-library/ordinals (def-by-nn-recursion); anywhere before
;;; theorem-library/strand-ideals.
;;;
;;; T is the token set, K the key set, A = MSG-SET(T, K); KS (the paper's k) is a set of keys.
;;;
;;; A KS-IDEAL (Definition 6.1).  The paper's join "h g, g h in I for h in I, g in A" is, on the
;;; n-ary model, "LST(l) is in I whenever l is a list of messages and some component of l is in
;;; I"; the encryption clause is "ENCR(h, y) in I for h in I and y in KS".  The ideal is a subset
;;; of A, as the paper's "a subset I of A".
;;;     IS-KEY-IDEAL(T, K, KS, I)
;;; THE GENERATED IDEAL (Definition 6.2), the paper's I_k[S]: the intersection of the KS-ideals
;;; in POWER(A) containing S, as a separation of A (the device of SUBTERM-REL).
;;;     KEY-IDEAL-GEN(T, K, KS, S)
;;; SIMPLE (Definition 6.5): "not of the form g h for g, h in A", i.e. not LST(l) for a list l of
;;; messages.
;;;     IS-SIMPLE-MSG(T, K, m)
;;; THE STAGES of Lemma 6.4: S_0 = S, S_(i+1) = { ENCR(g, y) : g in I_empty[S_i], y in KS }, a
;;; def-by-nn-recursion (the MSG-STAGE device); the set is a separation of A.
;;;     IDEAL-STAGE(T, K, KS, S, i)
;;;
;;; STATEMENT CHECKS.  Every equation is a definition; nothing is asserted.  Binders: sbi*_
;;; names, used by no other body in the tree; none folds onto a class name, an accessor or a
;;; registered constant.  The paper's k and K are one folded symbol: the key subset is KS.

(def-predicate 'IS-KEY-IDEAL '(sbit_ sbik_ sbiks_ sbii_)
  '(AND (FORALL sbix_ (IMPLIES (IN sbix_ sbii_) (IN sbix_ (MSG-SET sbit_ sbik_))))
   (AND (FORALL sbil_ (FORALL sbij_
          (IMPLIES (IN sbil_ (TUPLES (MSG-SET sbit_ sbik_)))
           (IMPLIES (IN sbij_ NN)
            (IMPLIES (<= 1 sbij_)
             (IMPLIES (<= sbij_ (LENGTH sbil_))
              (IMPLIES (IN (NTH sbij_ sbil_) sbii_)
                       (IN (LST sbil_) sbii_))))))))
        (FORALL sbih_ (FORALL sbiy_
          (IMPLIES (IN sbih_ sbii_)
           (IMPLIES (IN sbiy_ sbiks_)
                    (IN (ENCR sbih_ sbiy_) sbii_))))))))
(notation! 'IS-KEY-IDEAL 'kind 'predicate 'arity 4
           'english "$4 is a $3-ideal of the messages over the tokens $1 and the keys $2")

(def-functoid 'KEY-IDEAL-GEN '(sbgt_ sbgk_ sbgks_ sbgs_)
  '(SEP sbgm_ (MSG-SET sbgt_ sbgk_)
        (FORALL sbgq_ (IMPLIES (IN sbgq_ (POWER (MSG-SET sbgt_ sbgk_)))
                       (IMPLIES (IS-KEY-IDEAL sbgt_ sbgk_ sbgks_ sbgq_)
                        (IMPLIES (FORALL sbgz_ (IMPLIES (IN sbgz_ sbgs_) (IN sbgz_ sbgq_)))
                                 (IN sbgm_ sbgq_)))))))
(notation! 'KEY-IDEAL-GEN 'kind 'functoid 'arity 4
           'english "the $3-ideal generated by $4 in the messages over the tokens $1 and the keys $2")

(def-predicate 'IS-SIMPLE-MSG '(sbst_ sbsk_ sbsm_)
  '(NOT (FORSOME sbsl_ (AND (IN sbsl_ (TUPLES (MSG-SET sbst_ sbsk_))) (= sbsm_ (LST sbsl_))))))
(notation! 'IS-SIMPLE-MSG 'kind 'predicate 'arity 3
           'english "$3 is a simple message over the tokens $1 and the keys $2")

(def-by-nn-recursion 'IDEAL-STAGE '(sbrt_ sbrk_ sbrks_ sbrs_)
  'sbrs_
  '(sbrn_ sbrv_)
  '(SEP sbrm_ (MSG-SET sbrt_ sbrk_)
        (FORSOME sbrg_ (AND (IN sbrg_ (KEY-IDEAL-GEN sbrt_ sbrk_ EMPTY-SET sbrv_))
                            (FORSOME sbry_ (AND (IN sbry_ sbrks_) (= sbrm_ (ENCR sbrg_ sbry_))))))))
(notation! 'IDEAL-STAGE 'kind 'functoid 'arity 5
           'english "the stage $5 of the $3-encryptions of $4 over the tokens $1 and the keys $2")
