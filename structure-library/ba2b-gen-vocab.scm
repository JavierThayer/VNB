;;; ba2b-gen-vocab.scm -- BANACH ALGEBRAS: the closed unital
;;; *-subalgebra generated by an element (the "C*-algebra generated by a" of Proposition 1.31).
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 3.
;;; DEFINITIONS ONLY.  Agent BA-2B, wave 2026-11-10.  Destination: structure-library/ba2b-gen-vocab.scm.
;;; Library: operator-algebras.  Load window: after structure-library/ba-vocab and intersection-of.
;;; Binders b2va_ b2vs_ b2vx_ b2vy_ b2vz_ b2ve_, used by no other file.
;;; (Definition 1.30, IS-NORMAL-EL, is BA-1's, in ba-vocab.)
;;;
;;; IS-CLOSED-STAR-SUBALGEBRA-SET(a, S): S is a subset of VEC(a) containing the unit, closed under sum,
;;; scalar multiple, product and involution, and norm-closed (a point of VEC(a) approximated by points of
;;; S lies in S).  CSTAR-GEN(a, x) is the intersection of all such S containing x: the smallest one
;;; (cstar-gen-least).  With the operations of a restricted to it, it is the C*-algebra generated by x.

(def-predicate 'IS-CLOSED-STAR-SUBALGEBRA-SET '(b2va_ b2vs_)
  '(AND (SUBSET b2vs_ (VEC b2va_))
   (AND (IN (VONE b2va_) b2vs_)
   (AND (FORALL b2vx_ (IMPLIES (IN b2vx_ b2vs_) (FORALL b2vy_ (IMPLIES (IN b2vy_ b2vs_)
          (IN ((VADD b2va_) b2vx_ b2vy_) b2vs_)))))
   (AND (FORALL b2vz_ (IMPLIES (IN b2vz_ CC) (FORALL b2vx_ (IMPLIES (IN b2vx_ b2vs_)
          (IN ((ACT b2va_) b2vz_ b2vx_) b2vs_)))))
   (AND (FORALL b2vx_ (IMPLIES (IN b2vx_ b2vs_) (FORALL b2vy_ (IMPLIES (IN b2vy_ b2vs_)
          (IN ((VMUL b2va_) b2vx_ b2vy_) b2vs_)))))
   (AND (FORALL b2vx_ (IMPLIES (IN b2vx_ b2vs_) (IN ((VSTAR b2va_) b2vx_) b2vs_)))
        (FORALL b2vy_ (IMPLIES (IN b2vy_ (VEC b2va_))
          (IMPLIES (FORALL b2ve_ (IMPLIES (POS-RR b2ve_) (FORSOME b2vx_ (AND (IN b2vx_ b2vs_)
                     (< ((VNRM b2va_) ((VADD b2va_) b2vy_ ((VNEG b2va_) b2vx_))) b2ve_)))))
                   (IN b2vy_ b2vs_)))))))))))

(def-functoid 'CSTAR-GEN '(b2va_ b2vx_)
  '(INTERSECTION-OF (SEP b2vs_ (POWER (VEC b2va_))
     (AND (IS-CLOSED-STAR-SUBALGEBRA-SET b2va_ b2vs_) (IN b2vx_ b2vs_)))))

(notation! 'IS-CLOSED-STAR-SUBALGEBRA-SET 'kind 'predicate 'arity 2
           'english "$2 is a norm-closed unital *-subalgebra of $1")
(notation! 'CSTAR-GEN 'kind 'functoid 'arity 2
           'english "the C*-subalgebra of $1 generated by $2")
