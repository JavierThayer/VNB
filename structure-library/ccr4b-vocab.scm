;;; ccr4b-vocab.scm -- CCR.pdf section 4.5 under THE USER'S DEFINITION OF B(K) (2026-11-09): B(K) is the
;;; closure in K of the prime field, adjoined with the uniformizing parameter w in characteristic p.
;;; DEFINITIONS ONLY; the laws are in theorem-library/ccr4b-base.scm.  Agent CCR-1109-C3, 2026-11-09.
;;; Destination: structure-library/ccr4b-vocab.scm.  Library: analysis (CLOSURE in NF-METRIC-SPACE, FNRM,
;;; NV-INTEGERS / NV-RES-RINGOID of ccr2-vocab / nvlocal-vocab; HAS-CHARACTERISTIC is algebra).
;;; Load window: after structure-library/nvlocal-vocab (NV-RES-RINGOID), gal-char-vocab (HAS-CHARACTERISTIC),
;;; baire-category (CLOSURE).
;;;
;;;   IS-NF-SUBFIELD(K, S)     S is a subfield of the normed field K: S lies in K, contains 0 and 1, is closed
;;;                            under +, *, - and contains the inverse of each of its nonzero elements
;;;   NF-SUBFIELD-GEN(K, X)    the subfield of K generated by X: the intersection of the subfields of K
;;;                            containing X (the bound S in POWER(CARR K) keeps the separation predicative)
;;;   NV-BASE-GEN(K, w)        the generators of B(K): {w} when K has a (prime) characteristic, the empty
;;;                            set when K has characteristic 0
;;;   NV-BASE(K, w)            B(K) = the closure in K of NF-SUBFIELD-GEN(K, NV-BASE-GEN(K, w)): the closure
;;;                            of F_p(w) in characteristic p, of Q in characteristic 0
;;;   NV-ZF(K, F)              Z_F(K) = pi_M^{-1}(F), for F a set of residue classes (Definition before 4.20)
;;; Binders bz*_.

(def-predicate 'IS-NF-SUBFIELD '(bzk_ bzs_)
  '(AND (FORALL bzx_ (IMPLIES (IN bzx_ bzs_) (IN bzx_ (CARR bzk_))))
   (AND (IN (ZERO bzk_) bzs_)
   (AND (IN (ONE bzk_) bzs_)
   (AND (FORALL bzx_ (IMPLIES (IN bzx_ bzs_) (FORALL bzy_ (IMPLIES (IN bzy_ bzs_) (IN ((ADD bzk_) bzx_ bzy_) bzs_)))))
   (AND (FORALL bzx_ (IMPLIES (IN bzx_ bzs_) (FORALL bzy_ (IMPLIES (IN bzy_ bzs_) (IN ((MUL bzk_) bzx_ bzy_) bzs_)))))
   (AND (FORALL bzx_ (IMPLIES (IN bzx_ bzs_) (IN ((NEG bzk_) bzx_) bzs_)))
        (FORALL bzx_ (IMPLIES (IN bzx_ bzs_) (IMPLIES (NOT (= bzx_ (ZERO bzk_)))
          (FORSOME bzy_ (AND (IN bzy_ bzs_) (= ((MUL bzk_) bzx_ bzy_) (ONE bzk_))))))))))))))
(notation! 'IS-NF-SUBFIELD 'kind 'predicate 'arity 2 'english "$2 is a subfield of $1")

(def-functoid 'NF-SUBFIELD-GEN '(bzk_ bzg_)
  '(SEP bzz_ (CARR bzk_)
     (FORALL bzs_ (IMPLIES (IN bzs_ (POWER (CARR bzk_)))
       (IMPLIES (IS-NF-SUBFIELD bzk_ bzs_) (IMPLIES (SUBSET bzg_ bzs_) (IN bzz_ bzs_)))))))
(notation! 'NF-SUBFIELD-GEN 'kind 'functoid 'arity 2 'english "the subfield of $1 generated by $2")

(def-functoid 'NV-BASE-GEN '(bzk_ bzw_)
  '(SEP bzz_ (CARR bzk_)
     (AND (= bzz_ bzw_) (FORSOME bzp_ (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING bzk_) bzp_)))))
(notation! 'NV-BASE-GEN 'kind 'functoid 'arity 2
           'english "the generators of B($1): {$2} in prime characteristic, none in characteristic 0")

(def-functoid 'NV-BASE '(bzk_ bzw_)
  '(CLOSURE (NF-METRIC-SPACE bzk_) (NF-SUBFIELD-GEN bzk_ (NV-BASE-GEN bzk_ bzw_))))
(notation! 'NV-BASE 'kind 'functoid 'arity 2
           'english "the closure in $1 of its prime field, adjoined with $2 in prime characteristic")

(def-functoid 'NV-ZF '(bzk_ bzf_)
  '(SEP bzz_ (NV-INTEGERS bzk_)
     (IN (CLASS (RINGOID-SETOID (NV-RES-RINGOID bzk_ (NV-INTEGERS bzk_))) bzz_) bzf_)))
(notation! 'NV-ZF 'kind 'functoid 'arity 2 'english "the integers of $1 whose residue class lies in $2")
