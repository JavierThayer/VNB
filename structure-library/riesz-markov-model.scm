;;; structure-library/riesz-markov-model.scm -- the Cantor model of a compact
;;; metric space (Riesz-Markov, stage 1, RM-1, 2026-10-10).  DEFINITIONS ONLY;
;;; every law is PROVEN in theorem-library/riesz-markov-model.scm (prefix rmm-).
;;;
;;; Source: the user's notes-63 (2026-10-10), concrete form (b).  For a compact
;;; metric space s with a dense sequence dseq (IS-DENSE-SEQ, ascoli-analytic-cores):
;;;
;;;   RM-BALL(s, dseq, n)   the closed ball CLOSED-BALL(s, dseq(i), recip(j+1)) where
;;;                         i = NNFST(n), j = NNSND(n): the countable family B,
;;;                         indexed by NN through the pairing of nn-pairing.scm.
;;;                         Radii recip(j+1) instead of the positive rationals: they
;;;                         separate equally well and need no enumeration of QQ.
;;;   RM-SHELL(s, dseq, n)  { y in PTS s : r_n <= d(c_n, y) } -- a CLOSED set
;;;                         containing PTS s \ RM-BALL(n).  It stands where the
;;;                         brief writes CLOSURE(X \ B_n): the closure of the
;;;                         complement lies inside it, and a point at distance
;;;                         < r_n from the centre lies outside it, which is all the
;;;                         uniqueness argument uses.
;;;   RM-TWO                the two-point set {0, 1} (an unordered PAIR).
;;;   RM-TWO-MS             {0, 1} as a metric subspace of RR-MS (the discrete
;;;                         metric: the distance of two different points is 1).
;;;   CANTOR-MS             {0,1}^NN with PRODUCT-METRIC of the constant sequence
;;;                         RM-TWO-MS (structure-library/product-metric.scm).
;;;   RM-REALIZES(s, dseq, es, nb, y)
;;;                         y is a point of s that lies in B_i exactly when
;;;                         es(i) = 1, for every i < nb: y witnesses that the
;;;                         first nb cells B_i^(es i) meet.
;;;   RM-K(s, dseq)         { es in PTS(CANTOR-MS) : for every nb in NN some y
;;;                         realizes es below nb } -- the characters of the Boolean
;;;                         ring generated by B, restricted to B.
;;;   RM-KMS(s, dseq)       RM-K as a metric subspace of CANTOR-MS.
;;;   RM-ADDRESS(s, dseq, es, y)
;;;                         y lies in RM-BALL(n) when es(n) = 1 and in RM-SHELL(n)
;;;                         otherwise, for every n.
;;;   RM-ADDRESS-BELOW(s, dseq, es, nb, y)
;;;                         the same, for every n < nb only.
;;;   RM-PI(s, dseq)        es |-> THE y with RM-ADDRESS(s, dseq, es, y), on RM-K.
;;;   RM-CODE(s, dseq, x)  the address of the point x: n |-> 1 if x in B_n, else 0;
;;;                         a point of K that pi sends to x (pi is ONTO).
;;;   RM-CYL(s, dseq, a, nb)
;;;                         the cylinder { es in RM-K : es(i) = a(i) for i < nb }.
;;;
;;; BINDERS.  Every binder below ends in an underscore and starts with the
;;; definition's own two letters (rk, rr, ra, rp, rc, ct); no predicate body and
;;; no kernel-minted eigenvariable uses them.  The space parameter is `s', never
;;; X (case folding: X/x, K/k, B/b, E/e are one symbol each).
;;;
;;; Dependencies: metric-topology (CLOSED-BALL), metric-subspace (SUBSPACE-MS),
;;; product-metric (PRODUCT-METRIC), numeric-instances (RR-MS), nn-pairing
;;; (NNFST / NNSND).  Load anywhere after those (load.scm: immediately before
;;; theorem-library/riesz-markov-model, whose window is the binding one).
;;; IS-DENSE-SEQ (ascoli-analytic-cores) appears in the laws, not here.

;;; ---- the ball family ----------------------------------------------------

(def-functoid 'RM-BALL '(s dseq n)
  '(CLOSED-BALL s (dseq (NNFST n)) (recip (+ (NNSND n) 1))))

(def-functoid 'RM-SHELL '(s dseq n)
  '(SEP rsy_ (PTS s) (<= (recip (+ (NNSND n) 1)) ((DIST s) (dseq (NNFST n)) rsy_))))

;;; ---- the Cantor space ---------------------------------------------------

(def-constant 'RM-TWO
  (list 'rm-two-def '(== RM-TWO (PAIR 0 1))))

(def-constant 'RM-TWO-MS
  (list 'rm-two-ms-def '(== RM-TWO-MS (SUBSPACE-MS RR-MS RM-TWO))))

(def-constant 'CANTOR-MS
  (list 'cantor-ms-def '(== CANTOR-MS (PRODUCT-METRIC (VNB-LAMBDA ctk_ NN RM-TWO-MS)))))

;;; ---- the model K -----------------------------------------------------------

(def-predicate 'RM-REALIZES '(s dseq es nb y)
  '(AND (IN y (PTS s))
        (FORALL rri_ (IMPLIES (IN rri_ NN)
          (IMPLIES (< rri_ nb)
            (IFF (IN y (RM-BALL s dseq rri_)) (= (es rri_) 1)))))))

(def-functoid 'RM-K '(s dseq)
  '(SEP rke_ (PTS CANTOR-MS)
        (FORALL rkn_ (IMPLIES (IN rkn_ NN)
          (FORSOME rky_ (RM-REALIZES s dseq rke_ rkn_ rky_))))))

(def-functoid 'RM-KMS '(s dseq)
  '(SUBSPACE-MS CANTOR-MS (RM-K s dseq)))

;;; ---- the map pi -------------------------------------------------------------

(def-predicate 'RM-ADDRESS '(s dseq es y)
  '(AND (IN y (PTS s))
        (FORALL ran_ (IMPLIES (IN ran_ NN)
          (AND (IMPLIES (= (es ran_) 1) (IN y (RM-BALL s dseq ran_)))
               (IMPLIES (NOT (= (es ran_) 1)) (IN y (RM-SHELL s dseq ran_))))))))

(def-predicate 'RM-ADDRESS-BELOW '(s dseq es nb y)
  '(AND (IN y (PTS s))
        (FORALL rbn_ (IMPLIES (IN rbn_ NN) (IMPLIES (< rbn_ nb)
          (AND (IMPLIES (= (es rbn_) 1) (IN y (RM-BALL s dseq rbn_)))
               (IMPLIES (NOT (= (es rbn_) 1)) (IN y (RM-SHELL s dseq rbn_)))))))))

(def-functoid 'RM-PI '(s dseq)
  '(VNB-LAMBDA rpe_ (RM-K s dseq) (IOTA rpy_ (RM-ADDRESS s dseq rpe_ rpy_))))

;;; ---- the address of a point ----------------------------------------------

(def-functoid 'RM-CODE '(s dseq x)
  '(VNB-LAMBDA rox_ NN (IF (IN x (RM-BALL s dseq rox_)) 1 0)))

;;; ---- cylinders ------------------------------------------------------------

(def-functoid 'RM-CYL '(s dseq a nb)
  '(SEP rce_ (RM-K s dseq)
        (FORALL rci_ (IMPLIES (IN rci_ NN)
          (IMPLIES (< rci_ nb) (= (rce_ rci_) (a rci_)))))))

;;; ---- notation -------------------------------------------------------------

(notation! 'RM-BALL 'kind 'functoid 'arity 3
           'english "the $3-th ball of the family of $1 built on $2")
(notation! 'RM-SHELL 'kind 'functoid 'arity 3
           'english "the outer shell of the $3-th ball of the family of $1 built on $2")
(notation! 'RM-REALIZES 'kind 'predicate 'arity 5
           'english "$5 realizes the address $3 of $1 below $4")
(notation! 'RM-K 'kind 'functoid 'arity 2
           'english "the Cantor model of $1 built on $2")
(notation! 'RM-KMS 'kind 'functoid 'arity 2
           'english "the Cantor model of $1 built on $2, as a metric space")
(notation! 'RM-ADDRESS 'kind 'predicate 'arity 4
           'english "$4 has the address $3 in $1")
(notation! 'RM-ADDRESS-BELOW 'kind 'predicate 'arity 5
           'english "$5 has the address $3 in $1 below $4")
(notation! 'RM-PI 'kind 'functoid 'arity 2
           'english "the projection of the Cantor model of $1 built on $2 onto $1")
(notation! 'RM-CODE 'kind 'functoid 'arity 3
           'english "the address of $3 in the Cantor model of $1 built on $2")
(notation! 'RM-CYL 'kind 'functoid 'arity 4
           'english "the cylinder of the Cantor model of $1 on which the first $4 coordinates are those of $3")
(notation! 'RM-TWO 'kind 'constant 'arity 0 'english "the two-point set {0, 1}")
(notation! 'RM-TWO-MS 'kind 'constant 'arity 0 'english "the two-point metric space {0, 1}")
(notation! 'CANTOR-MS 'kind 'constant 'arity 0 'english "the Cantor space {0, 1}^NN")
