;;; monotone-class.scm -- MONOTONE CLASSES.  Vocabulary only: no proof, no support.
;;; Agent MEASURE-2, 2026-10-08.  The proofs (Prop. 1.11, Thm. 1.13) are
;;; theorem-library/monotone-class.scm.
;;;
;;; SOURCE.  Thayer, Construction of Measures, Def. 1.12 (p. 3): a set M of
;;; subsets of X is a monotone class iff it is closed under countable monotone
;;; unions and countable monotone intersections.
;;;
;;; WHAT AND WHY.
;;;   * A monotone sequence is a function f in FUN(NN, mc), the monotonicity
;;;     stated pointwise, f(n) subset f(succ n) (nondecreasing) or f(succ n)
;;;     subset f(n) (nonincreasing), as measure-laws.scm states continuity from
;;;     below and above.
;;;   * The kernel has BIG-UNION and no dual binder, so the countable
;;;     intersection is written omega \ U_n (omega \ f(n)), the form of the
;;;     remark after Def. 1.7 and of measure-continuity-from-above.
;;;   * (IN omega SET) is a conjunct, as in IS-ALGEBRA-OF-SETS and
;;;     IS-SIGMA-ALGEBRA.
;;;   * MONOTONE-CLASS-GENERATED(omega, cE) is the intersection of the monotone
;;;     classes over omega containing cE, a SEP over POWER(omega), built as
;;;     SIGMA-GENERATED is (measure.scm).  POWER(omega) is such a class, so the
;;;     family is never empty.  Its membership iff is proven in the theorem file
;;;     (no stamp).
;;; ====================================================================

(def-predicate 'IS-MONOTONE-CLASS '(omega mc)
  (conjuncts->and
    (list
      '(IN omega SET)
      '(SUBSET mc (POWER omega))
      '(FORALL mcf_ (IMPLIES (IN mcf_ (FUN NN mc))
         (IMPLIES (FORALL mcn_ (IMPLIES (IN mcn_ NN) (SUBSET (mcf_ mcn_) (mcf_ (succ mcn_)))))
                  (IN (BIG-UNION mck_ NN (mcf_ mck_)) mc))))
      '(FORALL mcg_ (IMPLIES (IN mcg_ (FUN NN mc))
         (IMPLIES (FORALL mcm_ (IMPLIES (IN mcm_ NN) (SUBSET (mcg_ (succ mcm_)) (mcg_ mcm_))))
                  (IN (COMPLEMENT-IN omega (BIG-UNION mcj_ NN (COMPLEMENT-IN omega (mcg_ mcj_)))) mc)))))))

(notation! 'IS-MONOTONE-CLASS 'kind 'predicate 'arity 2
           'english "$2 is a monotone class of subsets of $1")

(def-functoid 'MONOTONE-CLASS-GENERATED '(omega cE)
  '(SEP mca_ (POWER omega)
     (FORALL mcb_
       (IMPLIES (AND (IS-MONOTONE-CLASS omega mcb_) (SUBSET cE mcb_))
                (IN mca_ mcb_)))))

(notation! 'MONOTONE-CLASS-GENERATED 'kind 'functoid 'arity 2
           'english "the monotone class of subsets of $1 generated by $2")
