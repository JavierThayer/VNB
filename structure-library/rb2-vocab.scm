;;; rb2-vocab.scm -- vocabulary for calculus.pdf 2.27 and for path-connectedness.
;;; DEFINITIONS ONLY (destination: structure-library/).  Agent RA-BASICS, 2026-10-26
;;; (NEW DEFINITIONS, the user's to confirm; "missing vocabulary is not a stopping point").
;;;
;;;   LDIR-DERIV(m, f, a, eta)
;;;       the directional derivative d_eta f(a) of the notes, for f defined near a (the LOCAL
;;;       notion HAS-DIR-DERIV): the unique l with HAS-DIR-DERIV(m, f, a, eta, l).  The tree's
;;;       DIR-DERIV is the value for the GLOBAL notion IS-DIR-DIFF-AT (f total on vec(m)).
;;;
;;;   SPAN2(m, eta, xi)
;;;       the vector space generated by eta and xi: { r.eta + s.xi : r, s in RR }.  The tree's
;;;       SPAN(md, n, u) takes the vectors as a column matrix and the coefficients as a 1-by-n
;;;       matrix; two named vectors read better and are what Prop 2.27 says.
;;;
;;;   IS-PATH-CONNECTED(s, A)
;;;       s is a metric space, A a subset of its points, and any two points x, y of A are
;;;       joined by a path in A: a map gamma from [0, 1] into A, continuous from [0, 1] (the
;;;       subspace of RR-MS) to s, with gamma(0) = x and gamma(1) = y.  Same signature as
;;;       IS-CONNECTED(s, A).
;;;
;;;   IS-CONVEX-RR(A)
;;;       A subset RR and x + t (y - x) in A for x, y in A, t in [0, 1]; the mirror of the
;;;       tree's IS-CONVEX-CC.
;;;
;;; STATEMENT CHECKS.  The IOTA of LDIR-DERIV is applied only where a HAS-DIR-DERIV witness
;;; is in hand (ldir-deriv-value).  BINDERS: ldl_, s2v_ s2r_ s2s_, pcs_ pca_ pcx_ pcy_ pcg_,
;;; cvra_ cvrx_ cvry_ cvrt_; none folds onto a class name, an accessor or a registered
;;; constant.  Library: analysis (HAS-DIR-DERIV, SUBSPACE-MS, IS-CONTINUOUS).

(def-functoid 'LDIR-DERIV '(ldm_ ldf_ lda_ lde_)
  '(IOTA ldl_ (HAS-DIR-DERIV ldm_ ldf_ lda_ lde_ ldl_)))
(notation! 'LDIR-DERIV 'kind 'functoid 'arity 4
           'english "the directional derivative of $2 at $3 in the direction $4 (in $1)")

(def-functoid 'SPAN2 '(s2m_ s2e_ s2x_)
  '(SEP s2v_ (VEC s2m_)
     (FORSOME s2r_ (AND (IN s2r_ RR) (FORSOME s2s_ (AND (IN s2s_ RR)
       (= s2v_ ((VADD s2m_) ((ACT s2m_) s2r_ s2e_) ((ACT s2m_) s2s_ s2x_)))))))))
(notation! 'SPAN2 'kind 'functoid 'arity 3
           'english "the subspace of $1 generated by $2 and $3")

(def-predicate 'IS-PATH-CONNECTED '(pcs_ pca_)
  '(AND (IS-METRIC-SPACE pcs_)
   (AND (SUBSET pca_ (PTS pcs_))
        (FORALL pcx_ (IMPLIES (IN pcx_ pca_) (FORALL pcy_ (IMPLIES (IN pcy_ pca_)
          (FORSOME pcg_ (AND (IN pcg_ (FUN (CCINT 0 1) pca_))
                        (AND (IS-CONTINUOUS (SUBSPACE-MS RR-MS (CCINT 0 1)) pcs_ pcg_)
                        (AND (= (pcg_ 0) pcx_) (= (pcg_ 1) pcy_))))))))))))
(notation! 'IS-PATH-CONNECTED 'kind 'predicate 'arity 2
           'english "$2 is path-connected in the metric space $1")

(def-predicate 'IS-CONVEX-RR '(cvra_)
  '(AND (SUBSET cvra_ RR)
        (FORALL cvrx_ (IMPLIES (IN cvrx_ cvra_) (FORALL cvry_ (IMPLIES (IN cvry_ cvra_)
          (FORALL cvrt_ (IMPLIES (IN cvrt_ (CCINT 0 1)) (IN (+ cvrx_ (* cvrt_ (- cvry_ cvrx_))) cvra_)))))))))
(notation! 'IS-CONVEX-RR 'kind 'predicate 'arity 1
           'english "$1 is a convex subset of RR")
