;;; ccr4f-vocab.scm -- THE DIGIT MAP AND THE COORDINATE MAP AS FUNCTIONS (CCR-1111 finding F1).
;;; DEFINITIONS ONLY; the laws are in theorem-library/ccr4f-digits.scm.  Agent CCR-1111B, 2026-11-11.
;;; Destination: structure-library/ccr4f-vocab.scm.  Library: analysis (IS-NV-EXPANSION of ccr4x-vocab;
;;; LINCOMB / MAT of mod-seq).  Load window: after structure-library/ccr4x-vocab and mod-seq.
;;;
;;;   NV-DIGITS(K, w, R, x)    the digit function a : ZZ -> R of the expansion x = sum_{k >= n} a_k w^k
;;;                            (CCR.pdf (36)) of x, by unique choice: an expansion exists and its digits are
;;;                            unique (ccr-4-17-full), so the description denotes (nv-digits-spec).
;;;   LIN-COORDS(md, d, u, P, r)  the coefficient row c in MAT(1, d, P) with r = LINCOMB(md, d, c, u), by unique
;;;                            choice: it denotes whenever r has such a row and the rows over P are unique
;;;                            (lin-coords-spec).  With u a column of lifts of a basis of the residue field and P
;;;                            the prime-field digits, it reads the coordinates of a digit in the lifts.
;;; Binders nds*_: names no other definition uses.  No axiom, support or stamp.

(def-functoid 'NV-DIGITS '(ndsk_ ndsw_ ndsr_ ndsx_)
  '(IOTA ndsa_ (AND (IN ndsa_ (FUN ZZ ndsr_))
                    (FORSOME ndsn_ (AND (IN ndsn_ ZZ) (IS-NV-EXPANSION ndsk_ ndsw_ ndsr_ ndsa_ ndsn_ ndsx_))))))
(notation! 'NV-DIGITS 'kind 'functoid 'arity 4 'english "the digits in $3 of the expansion of $4 in powers of $2")

(def-functoid 'LIN-COORDS '(ndsm_ ndsd_ ndsu_ ndsp_ ndsv_)
  '(IOTA ndsc_ (AND (IN ndsc_ (MAT 1 ndsd_ ndsp_)) (= ndsv_ (LINCOMB ndsm_ ndsd_ ndsc_ ndsu_)))))
(notation! 'LIN-COORDS 'kind 'functoid 'arity 5 'english "the coordinates over $4 of $5 in the sequence $3")

;;;   NF-POLY-OVER(K, F)       the polynomials over the ring view of K whose coefficients lie in F
;;;   NF-RAT-AT(K, F, w)       the quotients P(w) / Q(w) of values at w of polynomials over F, Q(w) /= 0, as the
;;;                            x in K with x Q(w) = P(w): for F a subfield, the subfield F(w) of K generated by F
;;;                            and w (nf-rat-at-subfield, nf-rat-at-least)
(def-functoid 'NF-POLY-OVER '(ndsk_ ndsf_)
  '(SEP ndsp_ (CARR (POLY (NORMED-FIELD-AS-COMMUTATIVE-RING ndsk_)))
     (FORALL ndsi_ (IMPLIES (IN ndsi_ NN) (IN (ndsp_ ndsi_) ndsf_)))))
(notation! 'NF-POLY-OVER 'kind 'functoid 'arity 2 'english "the polynomials over $1 with coefficients in $2")
(def-functoid 'NF-RAT-AT '(ndsk_ ndsf_ ndsw_)
  '(SEP ndsx_ (CARR ndsk_)
     (FORSOME ndsp_ (AND (IN ndsp_ (NF-POLY-OVER ndsk_ ndsf_))
       (FORSOME ndsq_ (AND (IN ndsq_ (NF-POLY-OVER ndsk_ ndsf_))
         (AND (NOT (= (POLY-EVAL (NORMED-FIELD-AS-COMMUTATIVE-RING ndsk_) ndsq_ ndsw_) (ZERO ndsk_)))
              (= ((MUL ndsk_) ndsx_ (POLY-EVAL (NORMED-FIELD-AS-COMMUTATIVE-RING ndsk_) ndsq_ ndsw_))
                 (POLY-EVAL (NORMED-FIELD-AS-COMMUTATIVE-RING ndsk_) ndsp_ ndsw_)))))))))
(notation! 'NF-RAT-AT 'kind 'functoid 'arity 3 'english "the quotients of values at $3 of polynomials over $2 in $1")
