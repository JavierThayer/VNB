;;; gn-vocab.scm -- BANACH ALGEBRAS: the natural order of an involutive algebra (Def. 1.34, (15)) and the
;;; continuous functional calculus in a commutative C*-algebra (Prop. 1.31).
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 ss. 3-5.
;;; DEFINITIONS ONLY: no proof, no support, no axiom.  Agent BA-1117-GN, wave 2026-11-17.
;;; Destination: structure-library/gn-vocab.scm.  Library: operator-algebras.
;;; Load window: after structure-library/basw2-vocab (POS-CONE), ba-cx-vocab (CCONT) and compose.
;;; Binders gnv*_ (gnva_ gnvb_ gnvx_ gnvy_ gnvf_ gnvw_), used by no other file.
;;;
;;;   ALE(a, x, y)    x <=_A y: y - x lies in the positive cone A+ (the notes' (15)).
;;;   CFC(a, x, f)    f(x) for f continuous on the spectrum of x: the element whose Gelfand transform is
;;;                   f o G(x) (a CHOICE; for a commutative C*-algebra that element exists and is unique,
;;;                   cfc-spec, by gelfand-onto and gelfand-star-iso).
;;;   SPEC-TOP(a, x)  sigma(x) with the topology of CC, so that C(sigma(x)) is CCONT(SPEC-TOP(a, x)).
;;;   DUAL-MAP(b, f)  phi-hat of Prop. 1.26: the map omega |-> omega o f on the characters of b.
;;;   DUAL-PULL(a, b, g)  the phi of Prop. 1.28 for g : B-hat -> A-hat: x |-> the element of b whose Gelfand
;;;                   transform is G_a(x) o g (a CHOICE; it exists and is unique for commutative a, b).

(def-predicate 'ALE '(gnva_ gnvx_ gnvy_)
  '(IN ((VADD gnva_) gnvy_ ((VNEG gnva_) gnvx_)) (POS-CONE gnva_)))

(def-functoid 'SPEC-TOP '(gnva_ gnvx_)
  '(SUBSPACE-TOP (METRIC-TOP CC-MS) (SPECTRUM gnva_ gnvx_)))

(def-functoid 'CFC '(gnva_ gnvx_ gnvf_)
  '(CHOICE (SEP gnvy_ (VEC gnva_)
     (= ((GELFAND-TRANSFORM gnva_) gnvy_) (COMPOSE gnvf_ ((GELFAND-TRANSFORM gnva_) gnvx_))))))

(notation! 'ALE 'kind 'predicate 'arity 3 'english "$2 <= $3 in the natural order of $1" 'tex "{$2} \\le_{$1} {$3}")
(notation! 'SPEC-TOP 'kind 'functoid 'arity 2 'english "the spectrum of $2 in $1, as a subspace of C")
(notation! 'CFC 'kind 'functoid 'arity 3 'english "$3 of $2 (the continuous functional calculus of $1)" 'tex "{$3}({$2})")

(def-functoid 'DUAL-MAP '(gnvb_ gnvf_)
  '(VNB-LAMBDA gnvw_ (CHARACTERS gnvb_) (COMPOSE gnvw_ gnvf_)))
(notation! 'DUAL-MAP 'kind 'functoid 'arity 2 'english "the dual map of $2 on the characters of $1" 'tex "\\widehat{{$2}}")

(def-functoid 'DUAL-PULL '(gnva_ gnvb_ gnvg_)
  '(VNB-LAMBDA gnvx_ (VEC gnva_) (CHOICE (SEP gnvy_ (VEC gnvb_)
     (= ((GELFAND-TRANSFORM gnvb_) gnvy_) (COMPOSE ((GELFAND-TRANSFORM gnva_) gnvx_) gnvg_))))))
(notation! 'DUAL-PULL 'kind 'functoid 'arity 3 'english "the homomorphism from $1 to $2 whose dual map is $3")

;;; ---- round 2: the C*-subalgebra generated by a normal element, as a structure ----
;;;   SUB-UCSA(b, S)  the subset S of b with the operations of b restricted to it, as a 10-tuple of the
;;;                   UNITAL-C-STAR-ALGEBRA layout (the scalar slot is the CC ring view, as in SUB-CIPS);
;;;                   a unital C*-algebra when S is a norm-closed unital *-subalgebra (gnc-sub-ucsa).
;;;   COMMUTANT-EL(b, Z)  the elements of b commuting with every element of Z.
(def-functoid 'SUB-UCSA '(gnvb_ gnvs_)
  '(LIST (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD) gnvs_
         (VNB-LAMBDA (LIST gnvu_ gnvv_) (CARTESIAN gnvs_ gnvs_) ((VADD gnvb_) gnvu_ gnvv_))
         (VZERO gnvb_)
         (VNB-LAMBDA gnvu_ gnvs_ ((VNEG gnvb_) gnvu_))
         (VNB-LAMBDA (LIST gnvc_ gnvu_) (CARTESIAN CC gnvs_) ((ACT gnvb_) gnvc_ gnvu_))
         (VNB-LAMBDA gnvu_ gnvs_ ((VNRM gnvb_) gnvu_))
         (VNB-LAMBDA (LIST gnvu_ gnvv_) (CARTESIAN gnvs_ gnvs_) ((VMUL gnvb_) gnvu_ gnvv_))
         (VONE gnvb_)
         (VNB-LAMBDA gnvu_ gnvs_ ((VSTAR gnvb_) gnvu_))))
(notation! 'SUB-UCSA 'kind 'functoid 'arity 2 'english "the subalgebra $2 of $1 with the restricted operations")
(def-functoid 'COMMUTANT-EL '(gnvb_ gnvt_)
  '(SEP gnvy_ (VEC gnvb_) (FORALL gnvz_ (IMPLIES (IN gnvz_ gnvt_)
     (= ((VMUL gnvb_) gnvy_ gnvz_) ((VMUL gnvb_) gnvz_ gnvy_))))))
(notation! 'COMMUTANT-EL 'kind 'functoid 'arity 2 'english "the commutant of $2 in $1")
;;;   CFC-N(b, x, f)  the continuous functional calculus f(x) of 1.31 for a normal x of any unital C*-algebra b:
;;;                   CFC computed in C*(x, 1) = SUB-UCSA(b, CSTAR-GEN(b, x)), commutative (cstar-gen-commutative-c-star).
(def-functoid 'CFC-N '(gnvb_ gnvx_ gnvf_)
  '(CFC (SUB-UCSA gnvb_ (CSTAR-GEN gnvb_ gnvx_)) gnvx_ gnvf_))
(notation! 'CFC-N 'kind 'functoid 'arity 3 'english "$3 of the normal element $2 of $1")
