;;; algnum-vocab.scm -- ALGEBRAIC ELEMENTS OF C (ALGNUM, algebraic-numbers bundle B7, 2026-10-26).  DEFINITIONS ONLY;
;;; destination structure-library/.  Source: Thayer, algebraic-numbers notes, ch. 4 s. 3-4, Def. 4.15 and Def. 4.20.
;;; Polynomials are written as POLY-2 writes them (poly-fn-vocab.scm): a coefficient sequence c in FUN(NN, K) and
;;; the value CC-SERIES-PARTIAL-SUM(j |-> c(j) z^j, n + 1).
;;;
;;;   IS-ALGEBRAIC-OVER(aa, r)        Def. 4.15: r in CC is a root of a MONIC polynomial with coefficients in aa
;;;                                   (c(n) = 1, c vanishing from n + 1); "algebraic integer" for aa = ZZ
;;;   IS-ALGEBRAIC-OVER-FIELD(kk, th)  Def. 4.20: th in CC is a root of a polynomial with coefficients in kk and
;;;                                   non-zero leading coefficient c(n)
;;;   ALGEBRAIC-NUMBERS-OVER(kk)       the algebraic numbers over kk (the notes' K-bar of Cor. 4.23)
;;;
;;; Library: complex-analysis (with POLY-2's vocabulary).  Load window: after poly-fn-vocab (CC-SERIES-PARTIAL-SUM
;;; and power of a complex number are older).
(def-predicate 'IS-ALGEBRAIC-OVER '(aa r)
  '(AND (IN r CC)
        (FORSOME anan_ (AND (IN anan_ NN)
          (FORSOME anac_ (AND (IN anac_ (FUN NN aa))
            (AND (FORALL anak_ (IMPLIES (IN anak_ NN) (IMPLIES (<= (succ anan_) anak_) (= (anac_ anak_) 0))))
                 (AND (= (anac_ anan_) 1)
                      (= (CC-SERIES-PARTIAL-SUM (VNB-LAMBDA pfj_ NN (* (anac_ pfj_) (power r pfj_))) (succ anan_)) 0)))))))))
(notation! 'IS-ALGEBRAIC-OVER 'kind 'predicate 'arity 2 'english "$2 is algebraic over the ring $1")

(def-predicate 'IS-ALGEBRAIC-OVER-FIELD '(kk th)
  '(AND (IN th CC)
        (FORSOME anan_ (AND (IN anan_ NN)
          (FORSOME anac_ (AND (IN anac_ (FUN NN kk))
            (AND (FORALL anak_ (IMPLIES (IN anak_ NN) (IMPLIES (<= (succ anan_) anak_) (= (anac_ anak_) 0))))
                 (AND (NOT (= (anac_ anan_) 0))
                      (= (CC-SERIES-PARTIAL-SUM (VNB-LAMBDA pfj_ NN (* (anac_ pfj_) (power th pfj_))) (succ anan_)) 0)))))))))
(notation! 'IS-ALGEBRAIC-OVER-FIELD 'kind 'predicate 'arity 2 'english "$2 is algebraic over the field $1")

(def-functoid 'ALGEBRAIC-NUMBERS-OVER '(kk)
  '(SEP anth_ CC (IS-ALGEBRAIC-OVER-FIELD kk anth_)))
(notation! 'ALGEBRAIC-NUMBERS-OVER 'kind 'functoid 'arity 1 'english "the algebraic numbers over $1")

;;; IS-SUBRING-OF-CC(aa): aa is a subring of C -- IS-CC-SUBRING (POLY-2: 0, 1, + and * closure) and closed
;;; under negation (the notes' "subring A of C"; IS-CC-SUBRING alone admits NN)
(def-predicate 'IS-SUBRING-OF-CC '(aa)
  '(AND (IS-CC-SUBRING aa)
        (FORALL ansn_ (IMPLIES (IN ansn_ aa) (IN (- ansn_) aa)))))
(notation! 'IS-SUBRING-OF-CC 'kind 'predicate 'arity 1 'english "$1 is a subring of the complex numbers")

;;; A-MODULES INSIDE C (Prop. 4.18).  The notes: "an A module is an additive subgroup of C such that A . V is in V;
;;; V is finitely generated iff there are v1, ..., vn such that every v in V is sum_i b_i v_i".  The sum is a FINSUM
;;; over INTERVAL(1, n) in the additive group of C, as the entries of a matrix product are.
(def-functoid 'CC-LINCOMB '(n b g)
  '(FINSUM (RING-ADDITIVE-AG (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
           (VNB-LAMBDA almj_ (INTERVAL 1 n) (* (b almj_) (g almj_)))
           (INTERVAL 1 n)))
(notation! 'CC-LINCOMB 'kind 'functoid 'arity 3 'english "the sum of $2(j) $3(j) for j = 1, ..., $1")

(def-predicate 'IS-CC-MODULE-OVER '(aa vv)
  '(AND (SUBSET vv CC)
        (AND (IN 0 vv)
             (AND (FORALL amx_ (IMPLIES (IN amx_ vv) (FORALL amy_ (IMPLIES (IN amy_ vv) (IN (+ amx_ amy_) vv)))))
                  (AND (FORALL amx_ (IMPLIES (IN amx_ vv) (IN (- amx_) vv)))
                       (FORALL ama_ (IMPLIES (IN ama_ aa) (FORALL amx_ (IMPLIES (IN amx_ vv) (IN (* ama_ amx_) vv))))))))))
(notation! 'IS-CC-MODULE-OVER 'kind 'predicate 'arity 2 'english "$2 is an $1-module inside the complex numbers")

(def-predicate 'IS-FG-CC-MODULE-OVER '(aa vv)
  '(AND (IS-CC-MODULE-OVER aa vv)
        (FORSOME amn_ (AND (IN amn_ NN)
          (FORSOME amg_ (AND (IN amg_ (FUN (INTERVAL 1 amn_) vv))
            (FORALL amv_ (IMPLIES (IN amv_ vv)
              (FORSOME amb_ (AND (IN amb_ (FUN (INTERVAL 1 amn_) aa)) (= amv_ (CC-LINCOMB amn_ amb_ amg_))))))))))))
(notation! 'IS-FG-CC-MODULE-OVER 'kind 'predicate 'arity 2 'english "$2 is a finitely generated $1-module inside the complex numbers")

;;; The field of fractions of a subring A of C, inside C (notes, before Prop. 4.25: "for any subdomain A of C,
;;; its field of fractions is isomorphic to the ring generated by A and its inverses"): the q in C with
;;; q b = a for some a, b in A, b /= 0.
(def-functoid 'CC-FRACTION-FIELD '(aa)
  '(SEP anfq_ CC (FORSOME anfa_ (AND (IN anfa_ aa)
     (FORSOME anfb_ (AND (IN anfb_ aa) (AND (NOT (= anfb_ 0)) (= (* anfq_ anfb_) anfa_))))))))
(notation! 'CC-FRACTION-FIELD 'kind 'functoid 'arity 1 'english "the field of fractions of $1 inside the complex numbers")

;;; A subfield of C: a subring closed under the inverses of its non-zero elements.
(def-predicate 'IS-SUBFIELD-OF-CC '(kk)
  '(AND (IS-SUBRING-OF-CC kk)
        (FORALL ansf_ (IMPLIES (IN ansf_ kk) (IMPLIES (NOT (= ansf_ 0)) (IN (recip ansf_) kk))))))
(notation! 'IS-SUBFIELD-OF-CC 'kind 'predicate 'arity 1 'english "$1 is a subfield of the complex numbers")

;;; Prop. 4.22's vocabulary. A K-vector space V inside C of dimension at most n: a K-module in C spanned by
;;; at most n of its elements (for a subfield K this is "dimension <= n").  theta algebraic of degree at most n
;;; over K: a root of a polynomial with coefficients in K, of degree at most n, with a non-zero leading coefficient.
(def-predicate 'IS-CC-SPACE-DIM-LE '(kk vv n)
  '(AND (IS-CC-MODULE-OVER kk vv)
        (FORSOME amn_ (AND (IN amn_ NN) (AND (<= amn_ n)
          (FORSOME amg_ (AND (IN amg_ (FUN (INTERVAL 1 amn_) vv))
            (FORALL amv_ (IMPLIES (IN amv_ vv)
              (FORSOME amb_ (AND (IN amb_ (FUN (INTERVAL 1 amn_) kk)) (= amv_ (CC-LINCOMB amn_ amb_ amg_)))))))))))))
(notation! 'IS-CC-SPACE-DIM-LE 'kind 'predicate 'arity 3 'english "$2 is a $1-vector space inside the complex numbers of dimension at most $3")

(def-predicate 'IS-ALGEBRAIC-OF-DEGREE-LE '(kk th n)
  '(AND (IN th CC)
        (FORSOME anan_ (AND (IN anan_ NN) (AND (<= anan_ n)
          (FORSOME anac_ (AND (IN anac_ (FUN NN kk))
            (AND (FORALL anak_ (IMPLIES (IN anak_ NN) (IMPLIES (<= (succ anan_) anak_) (= (anac_ anak_) 0))))
                 (AND (NOT (= (anac_ anan_) 0))
                      (= (CC-SERIES-PARTIAL-SUM (VNB-LAMBDA pfj_ NN (* (anac_ pfj_) (power th pfj_))) (succ anan_)) 0))))))))))
(notation! 'IS-ALGEBRAIC-OF-DEGREE-LE 'kind 'predicate 'arity 3 'english "$2 is algebraic of degree at most $3 over $1")
