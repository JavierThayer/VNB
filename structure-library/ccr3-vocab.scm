;;; ccr3-vocab.scm -- MODULES IN A LOCAL NV FIELD (CCR.pdf Definition 4.11).  DEFINITIONS ONLY; the laws are in
;;; theorem-library/ccr3-local.scm.  Agent CCR-B3, wave MAP-1026, 2026-10-26.  Destination:
;;; structure-library/ccr3-vocab.scm.  Library: analysis.  Load window: after structure-library/ccr2-vocab.
;;;
;;; As in ccr2-vocab, the ring of integers is a subring A of the NV field K (A = Z(K) for a local field).
;;;   IS-NV-MODULE(K, A, E)   E an additive subgroup of K with A E inside E      (the paper's "module in K")
;;;   NV-MULTIPLES(K, A, g)   A g = {m g : m in A}, the principal module generated by g in K
;;; Binders cw3*_.

(def-predicate 'IS-NV-MODULE '(cw3k_ cw3a_ cw3e_)
  '(AND (FORALL cw3x_ (IMPLIES (IN cw3x_ cw3e_) (IN cw3x_ (CARR cw3k_))))
   (AND (IN (ZERO cw3k_) cw3e_)
   (AND (FORALL cw3x_ (IMPLIES (IN cw3x_ cw3e_) (FORALL cw3y_ (IMPLIES (IN cw3y_ cw3e_) (IN ((ADD cw3k_) cw3x_ cw3y_) cw3e_)))))
   (AND (FORALL cw3x_ (IMPLIES (IN cw3x_ cw3e_) (IN ((NEG cw3k_) cw3x_) cw3e_)))
        (FORALL cw3r_ (IMPLIES (IN cw3r_ cw3a_) (FORALL cw3x_ (IMPLIES (IN cw3x_ cw3e_) (IN ((MUL cw3k_) cw3r_ cw3x_) cw3e_))))))))))
(notation! 'IS-NV-MODULE 'kind 'predicate 'arity 3 'english "$3 is a module over $2 in the field $1")

(def-functoid 'NV-MULTIPLES '(cw3k_ cw3a_ cw3g_)
  '(SEP cw3x_ (CARR cw3k_) (FORSOME cw3m_ (AND (IN cw3m_ cw3a_) (= cw3x_ ((MUL cw3k_) cw3m_ cw3g_))))))
(notation! 'NV-MULTIPLES 'kind 'functoid 'arity 3 'english "the multiples in $1 of $3 by elements of $2")

;;; Polynomials over K are the finitely supported coefficient sequences FINSUPP(V, NN-ADD-MONOID), V the ring view
;;; NORMED-FIELD-AS-COMMUTATIVE-RING(K); the product is MONALG-MUL (the Cauchy product).
;;;   IS-NV-CONTENT-ONE(K, p)   every coefficient has |p_i| <= 1 and some |p_i| = 1   (content 1, section 1.6)
(def-predicate 'IS-NV-CONTENT-ONE '(cw3k_ cw3p_)
  '(AND (FORALL cw3i_ (IMPLIES (IN cw3i_ NN) (<= ((FNRM cw3k_) (cw3p_ cw3i_)) 1)))
        (FORSOME cw3i_ (AND (IN cw3i_ NN) (= ((FNRM cw3k_) (cw3p_ cw3i_)) 1)))))
(notation! 'IS-NV-CONTENT-ONE 'kind 'predicate 'arity 2 'english "the polynomial $2 over $1 has content 1")
;;;   IS-NV-CONTENT(K, p, c)    c is the content of p: every |p_i| <= c and some |p_i| = c   (section 1.6)
(def-predicate 'IS-NV-CONTENT '(cw3k_ cw3p_ cw3c_)
  '(AND (FORALL cw3i_ (IMPLIES (IN cw3i_ NN) (<= ((FNRM cw3k_) (cw3p_ cw3i_)) cw3c_)))
        (FORSOME cw3i_ (AND (IN cw3i_ NN) (= ((FNRM cw3k_) (cw3p_ cw3i_)) cw3c_)))))
(notation! 'IS-NV-CONTENT 'kind 'predicate 'arity 3 'english "$3 is the content of the polynomial $2 over $1")
