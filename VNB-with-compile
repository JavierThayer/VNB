#!/bin/bash
# VNB-with-compile -- recompile all VNB .scm sources, then launch VNB.
#
# Use this after editing any prover source files.  It runs MIT Scheme
# in batch, loads load.scm (force-loading from .scm via recompile-vnb!),
# recompiles every file except the macro-using ones listed in
# *vnb-no-compile-files*, then execs the regular VNB launcher so the
# next Emacs session picks up fresh .com binaries.
#
# Usage:
#   VNB-with-compile             incremental compile (changed files), then launch
#   VNB-with-compile --full      clean rebuild (every file) -- after a macro edit
#   VNB-with-compile -nw         terminal Emacs after compile
#   VNB-with-compile --no-workspace plain vnb.el after compile
#
# Incremental is the default: unchanged files load from their fresh .com (proofs
# run compiled, ~seconds) and only edited files are source-loaded + recompiled.
# Use --full after editing a cross-file macro (define-syntax), which the mtime
# check cannot detect as invalidating dependents' baked-in expansions.

# Resolve $0 through any symlinks FIRST.  `dirname "$0"' alone gives the
# directory of the SYMLINK, not of the real tree, so a launcher symlinked into
# a ~/bin or a curated run/ directory looked for emacs/vnb-launch.el beside the
# symlink and died with "cannot find .../emacs/vnb-launch.el" (reported
# 2026-08-13).  readlink -f is GNU/Linux; the loop is the portable fallback.
VNB_SELF="$0"
if command -v readlink >/dev/null 2>&1 && readlink -f "$VNB_SELF" >/dev/null 2>&1; then
    VNB_SELF="$(readlink -f "$VNB_SELF")"
else
    while [ -L "$VNB_SELF" ]; do
        VNB_LINK="$(ls -ld "$VNB_SELF" | sed "s/.*-> //")"
        case "$VNB_LINK" in
            /*) VNB_SELF="$VNB_LINK" ;;
            *)  VNB_SELF="$(dirname "$VNB_SELF")/$VNB_LINK" ;;
        esac
    done
fi
PROVER_DIR="$(cd "$(dirname "$VNB_SELF")" && pwd)"
LOAD="$PROVER_DIR/load.scm"
# Match prover's HEAP; library proofs OOM at the old default.
HEAP=120000

if [ ! -f "$LOAD" ]; then
    echo "VNB-with-compile: cannot find $LOAD" >&2
    exit 1
fi

# --full forces a clean rebuild (every file source-loaded + recompiled).  Use it
# after editing a cross-file MACRO; drop it (the default) for ordinary edits,
# where only changed files recompile and everything else loads from fresh .com.
FULLENV=""
if [ "$1" = "--full" ]; then FULLENV="VNB_FULL_RECOMPILE=1"; shift
    echo "VNB-with-compile: FULL rebuild (recompiling every file)..."
else
    echo "VNB-with-compile: recompiling changed sources (incremental)..."
fi
# VNB_RECOMPILE=1 makes load.scm load each file from fresh .com when up-to-date
# and from .scm SOURCE only when stale; then compile-vnb! writes .com for the
# stale ones.  Loads the tree ONCE, not twice.  Incremental => ~seconds for a
# small edit instead of re-running every library proof interpreted.
env -u INSIDE_EMACS VNB_RECOMPILE=1 $FULLENV mit-scheme --heap "$HEAP" --quiet \
    --load "$LOAD" \
    --eval '(begin (compile-vnb!) (exit))' \
  || { echo "VNB-with-compile: compile step failed; aborting launch." >&2; exit 1; }

# The --load above ran a full load, which REWRITES reference/structure-graph.dot
# but never the rendered html/svg (rendering wants graphviz + python3, which the
# headless load deliberately skips -- see interactive.scm structure-graph-dot-file).
# So the render lags the source after every library change.  Refresh it here, off
# the fresh .dot.  Non-fatal: a box without graphviz/python3 still launches.
if command -v dot >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    echo "VNB-with-compile: rendering structure graph..."
    ( cd "$PROVER_DIR/reference" \
        && python3 build-graph-html.py >/dev/null \
        && dot -Tsvg structure-graph.dot > structure-graph.svg ) \
      || echo "VNB-with-compile: graph render failed (continuing)." >&2
else
    echo "VNB-with-compile: graphviz/python3 absent -- skipping graph render." >&2
fi

echo "VNB-with-compile: launching Emacs workspace..."
exec "$PROVER_DIR/VNB" "$@"
