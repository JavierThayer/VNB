#!/bin/bash
# vnb-test -- the VNB driving exam.
#
# Re-proves every THEOREM (a result with a runnable proof script) in sequence
# and certifies it.  This is the periodic regression that keeps "proven" honest:
# the everyday load installs cached results, but only this test actually re-runs
# the proofs.  PSS members are NOT here (excused by design); definitions are not
# here (true by construction).
#
# Two kinds of proof:
#   - AT-LOAD : proofs that run during a normal load (structure-library/*).
#               A clean load re-runs them; we harvest their qed lines.
#   - SCRIPT  : standalone proof scripts not in load.scm (calculus/*).  Each is
#               run as its own ./prover <file>.
#
# On success it writes:
#   reference/certification.scm  -- (certify! 'name "date") per certified theorem
#                                   (load.scm loads it; (status) reports it)
#   reference/VNB-TEST.md        -- a human-readable pass/fail + timing report
#
# Usage:  ./vnb-test            run the exam, write the stamp + report
#         ./vnb-test --quiet    same, but only print the final summary
#
# Exit status: 0 if every proof certified, 1 if any failed.

set -u
PROVER_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROVER_DIR" || exit 2
REF="$PROVER_DIR/reference"
PROVER="$PROVER_DIR/prover"
DATE="$(date +%Y-%m-%d)"
QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1

# Standalone proof scripts to run (extend this manifest as proofs are added).
SCRIPTS=(
  calculus/prop-3-14-proof.scm
  calculus/prop-3-15-proof.scm
  calculus/uniqueness-of-limits.scm
)

say() { [ "$QUIET" = 0 ] && echo "$@"; }
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

# Pull the names of theorems whose qed fired, from a prover run's output.
qed_names() { grep -oE '^;; qed [^:]+:' "$1" | sed -E 's/^;; qed (.+):/\1/'; }
# Heuristic error scan (the prover keeps running past a failed proof).
had_error() { grep -qiE 'aborting|;Unbound variable|;The object|;Premature|not the correct|not closed|VNB-ERROR' "$1"; }
# Count REAL qed calls in a script: `(qed 'name ...)` on a non-comment line.
# (A commented `(qed)` -- e.g. prose about a blocked proof -- must not count.)
qed_expect() { grep -E "\(qed '" "$1" | grep -vcE '^[[:space:]]*;'; }

declare -A CERT      # name -> 1  (theorems certified this run)
declare -A SEEN      # baseline at-load names
FAILS=0
ROWS="$TMP/rows"; : > "$ROWS"

# ---- Phase 1: clean load harvests the at-load proofs --------------------
say "vnb-test: phase 1 -- clean load (at-load proofs)"
t0=$(date +%s)
"$PROVER" /dev/null >"$TMP/load.out" 2>&1 || true   # load + exit; harvest qed lines
t1=$(date +%s)
if had_error "$TMP/load.out"; then
  say "  LOAD FAILED -- see report"; FAILS=$((FAILS+1))
  printf 'LOAD\tFAIL\t%ss\t(load errored)\n' "$((t1-t0))" >> "$ROWS"
else
  n=0
  while IFS= read -r nm; do
    [ -z "$nm" ] && continue
    CERT["$nm"]=1; SEEN["$nm"]=1; n=$((n+1))
  done < <(qed_names "$TMP/load.out")
  say "  load OK: $n at-load proof(s) certified, $((t1-t0))s"
  printf 'LOAD (at-load proofs)\tPASS\t%ss\t%s theorem(s)\n' "$((t1-t0))" "$n" >> "$ROWS"
fi

# ---- Phase 2: each standalone proof script ------------------------------
say "vnb-test: phase 2 -- standalone proof scripts"
for s in "${SCRIPTS[@]}"; do
  if [ ! -f "$s" ]; then
    say "  MISSING  $s"; FAILS=$((FAILS+1))
    printf '%s\tFAIL\t-\t(file missing)\n' "$s" >> "$ROWS"; continue
  fi
  expect=$(qed_expect "$s")
  t0=$(date +%s)
  "$PROVER" "$s" >"$TMP/run.out" 2>&1 || true
  t1=$(date +%s)
  newnames=()
  while IFS= read -r nm; do
    [ -z "$nm" ] && continue
    [ -n "${SEEN[$nm]:-}" ] && continue          # skip the at-load baseline
    newnames+=("$nm"); CERT["$nm"]=1
  done < <(qed_names "$TMP/run.out")
  got=${#newnames[@]}
  if had_error "$TMP/run.out" || [ "$got" -lt "$expect" ]; then
    say "  FAIL  $s  ($got/$expect qed, $((t1-t0))s)"; FAILS=$((FAILS+1))
    printf '%s\tFAIL\t%ss\t%s/%s qed: %s\n' "$s" "$((t1-t0))" "$got" "$expect" "${newnames[*]:-none}" >> "$ROWS"
  else
    say "  PASS  $s  ($got/$expect qed, $((t1-t0))s)"
    printf '%s\tPASS\t%ss\t%s/%s qed: %s\n' "$s" "$((t1-t0))" "$got" "$expect" "${newnames[*]}" >> "$ROWS"
  fi
done

# ---- Write the certification stamp --------------------------------------
CERTFILE="$REF/certification.scm"
{
  echo ";;; certification.scm -- VNB test stamp.  AUTO-GENERATED by vnb-test."
  echo ";;; $DATE.  Do not edit by hand; re-run ./vnb-test to refresh."
  echo ";;; Each (certify! 'name \"date\") records a theorem re-proved to QED."
  echo
  for nm in $(printf '%s\n' "${!CERT[@]}" | sort); do
    echo "(certify! '$nm \"$DATE\")"
  done
} > "$CERTFILE"

# ---- Write the human report ---------------------------------------------
ncert=${#CERT[@]}
{
  echo "# VNB Test Report"
  echo
  echo "Run $DATE by \`vnb-test\`.  The driving exam: every theorem with a"
  echo "runnable proof re-proved in sequence.  PSS members and definitions are"
  echo "not examined (excused by design)."
  echo
  if [ "$FAILS" = 0 ]; then echo "**Result: PASS** -- $ncert theorem(s) certified, 0 failures."
  else echo "**Result: $FAILS FAILURE(S)** -- $ncert theorem(s) certified."; fi
  echo
  echo "| stage | result | time | detail |"
  echo "|---|---|---|---|"
  while IFS=$'\t' read -r a b c d; do echo "| \`$a\` | $b | $c | $d |"; done < "$ROWS"
  echo
  echo "## Certified theorems"
  echo
  for nm in $(printf '%s\n' "${!CERT[@]}" | sort); do echo "- \`$nm\` -- certified $DATE"; done
} > "$REF/VNB-TEST.md"

echo
if [ "$FAILS" = 0 ]; then
  echo "vnb-test: PASS -- $ncert theorem(s) certified $DATE."
  echo "  stamp:  $CERTFILE"
  echo "  report: $REF/VNB-TEST.md"
  exit 0
else
  echo "vnb-test: $FAILS FAILURE(S) -- see $REF/VNB-TEST.md"
  exit 1
fi
