;;; ===== strand-spaces =====
;;; Document: /home/ubuntu/docs/jcs_strand_spaces.pdf, "Strand Spaces: Proving Security Protocols
;;; Correct", F. Javier Thayer, J. C. Herzog, J. D. Guttman (JCS 1999), sections 2-7, FORMALISED ON
;;; THE USER'S MODEL of ~/notes/notes-60.txt (2026-10-06): tokens, n-ary lists and encryptions under a
;;; key token; a strand space as a mapping from strand identifiers to strands; ==> strict; the key is
;;; not a subterm of the encryption; the adversary (the paper's penetrator) without the K trace.
;;; Added 2026-10-06 after batches S-2 and S-2b (docs/strand-spaces-2026-10-06.md).

;;; The OUTLINE of strand-spaces: chapters that hold an entry, with every section the notes have.
;;; Titles marked `prefilled' were read off the notes by pdftotext (BOOK-GEN, 2026-11-12); review
;;; and delete the mark.  Read by library-book.scm; ignored by the major-theorems list.
(outline "strand-spaces"
  (chapter "2" "Strand Spaces" prefilled
    (section "2.1" "Basic Notions" prefilled)
    (section "2.2" "Bundles and Causal Precedence" prefilled)
    (section "2.3" "Terms and Encryption" prefilled)
    (section "2.4" "Freeness Assumptions" prefilled))
  (chapter "3" "The Penetrator" prefilled
    (section "3.1" "Penetrator Strands" prefilled)
    (section "3.2" "A Bound on the Penetrator" prefilled))
  (chapter "5" "The Needham-Schroeder-Lowe Protocol" prefilled
    (section "5.1" "NSL Strand Spaces" prefilled)
    (section "5.2" "Agreement: The Responder's Guarantee" prefilled)
    (section "5.3" "The Original Needham-Schroeder Protocol" prefilled)
    (section "5.4" "Secrecy: The Responder's Nonce" prefilled)
    (section "5.5" "The Initiator's Guarantees: Secrecy and Agreement" prefilled))
  (chapter "6" "Ideals and Honesty" prefilled
    (section "6.1" "Ideals" prefilled)
    (section "6.2" "Entry Points and Honesty" prefilled)
    (section "6.3" "More Bounds on the Penetrator" prefilled))
  (chapter "7" "The Otway-Rees Protocol" prefilled
    (section "7.1" "The Otway-Rees Protocol Itself" prefilled)
    (section "7.2" "Otway-Rees: Secrecy" prefilled)
    (section "7.3" "Otway-Rees: Authentication" prefilled)))

(entry (doc "strand-spaces")
       (ref "2.7")
       (section "2.2" prefilled)
       (kind lemma)
       (title "Causal precedence in a bundle is a partial order with minimal elements")
       (names precedes-partial-order finite-strict-minimal bundle-minimal)
       (status proven)
       (deviation "Stated on the user's model: PRECEDES(c) is the reflexive closure of PRECEDES-STRICT(c), the least transitive relation on BNODES(c) containing the send edges BSEND and the strict same-strand order ==>. precedes-partial-order states it as IS-PARTIAL-ORDER(BNODES, PRECEDES); bundle-minimal gives, for every nonempty subset S of BNODES, a member m with no s in S strictly preceding it, the witness explicit. The paper states 2.7 without proof; the proof uses only CARD(BNODES) in NN (finite-strict-minimal: a transitive irreflexive relation on a finite nonempty set has a minimal element), never the finiteness of the edge sets. Proven 2026-10-06 (S-2), unchanged by S-2b.")
       (notes-statement "Let C be a bundle. Then <=_C is a partial order, and every nonempty subset of the nodes of C has <=_C-minimal members."))

(entry (doc "strand-spaces")
       (ref "2.8")
       (section "2.2" prefilled)
       (kind lemma)
       (title "A minimal node of a content-closed node set is a sent node")
       (names bundle-minimal-sent)
       (status proven)
       (deviation "The paper's hypothesis is an iff over all node pairs ('term(m) = term(m') implies m in S iff m' in S'); the proof needs ONE direction only -- toward the sender: equal content and the receiver in S put the sender in S -- and the theorem is stated in that weaker form. 'Positive' reads IS-SENT. Uses the EXISTENCE of a sender for every received node of the bundle (bundle-received-sender), never its uniqueness. Proven 2026-10-06 (S-2).")
       (notes-statement "Suppose C is a bundle and S is a set of nodes such that, whenever term(m) = term(m'), m in S iff m' in S. Then every <=_C-minimal member of S is positive."))

(entry (doc "strand-spaces")
       (ref "2.9")
       (section "2.2" prefilled)
       (kind lemma)
       (title "A minimal node among those whose content contains t originates t")
       (names bundle-minimal-originates)
       (status proven)
       (deviation "The paper's proof iterates bundle clause 3 'as many times as necessary' along =>+, which it never defines; on the user's model ==> IS the whole strict same-strand order and the bundle's closure under it is one law (bundle-ssb-closed), so the iteration dissolves and no proof steps along NEXT. The set is {m in BNODES : IS-SUBTERM(t, NODE-CONTENT(m))}, content being undirected by definition (the paper's 'abuse of language' on signed terms disappears). Proven 2026-10-06 (S-2).")
       (notes-statement "Suppose C is a bundle, t is a term, and S = {m in C : t @ term(m)}. Then every <=_C-minimal member of S is an originating occurrence of t."))

(entry (doc "strand-spaces")
       (ref "2.12")
       (section "2.4" prefilled)
       (kind proposition)
       (title "A subterm of an encryption under one key that is an encryption under another lies inside the plaintext")
       (names subterm-encr-other-key)
       (status proven)
       (deviation "Encryption is ENCR(m, k) = [2, m, k] with k in KEYS; the subterm relation is the intersection closure with the convention THE KEY IS NOT A SUBTERM OF THE ENCRYPTION (the paper's Definition 2.1). Dropped by S-2 (no encryption in notes-60), back with S-2b on the user's decision of 2026-10-06 16:40Z ('{m}_k = encr{m,k} is also a message'). Proven 2026-10-06 (S-2b).")
       (notes-statement "If {g}_K' @ {h}_K and K' /= K then {g}_K' @ h."))

(entry (doc "strand-spaces")
       (ref "3.3")
       (section "3.2" prefilled)
       (kind proposition)
       (title "The adversary bound: a secret that never originates on a regular node occurs nowhere")
       (names adversary-bound adversary-bound-adversary-nodes adversary-node-origin)
       (status proven)
       (deviation "Stated for ANY token u of the space with u notin ADV-TOKENS (the paper: a key K in K minus K_P; the key case is the instance, since KEYS is a subset of TOKENS); for a bundle c with BSPACE(c) = ISPACE(isp) of an infiltrated space isp. The adversary has the traces M F T C S E D over the space (C and S n-ary over lists; D decrypts under KINV; the paper's K trace is subsumed by M since keys are tokens). The proof is the paper's method -- a minimal member of {n in C : u @ content(n)} by Lemma 2.7, originating by 2.9, sent by 2.8, hence an adversary node, then seven cases -- with two findings: the M and C cases rest on the TOKEN LAW (no token is a list), not on the freeness of a free algebra; and the E case holds under either subterm convention, the convention deciding only whether the hypothesis 'never originates regularly' can be met for a key a participant encrypts with. Proven 2026-10-06 (S-2, seven cases S-2b).")
       (notes-statement "Let C be a bundle, and let K in K \\ K_P. If K never originates on a regular node, then K is not a subterm of term(n) for any node n in C; in particular, for any penetrator node p in C, K is not a subterm of term(p)."))

;;; ----- Section 5, Needham-Schroeder-Lowe (S-3, 2026-10-07; scratchpad/triage/S-3-REPORT.md) -----
;;; On the user's model plus S-3's vocabulary (PK-SPACE: an infiltrated space with NAMES and an
;;; injective PUBKEY from names to keys; IS-INIT-STRAND / IS-RESP-STRAND; IS-NSL-SPACE).  Names
;;; and nonces are not keys (without it 5.2 is false in the model).

(entry (doc "strand-spaces")
       (ref "5.2")
       (section "5.1" prefilled)
       (kind proposition)
       (title "The responder's agreement guarantee")
       (names nsl-responder-agreement nsl-lemma-5-4 nsl-lemma-5-6 nsl-lemma-5-7 nsl-resp-nonce-originates)
       (status proven)
       (deviation "On the user's model; the hypotheses 'C-height 3', 'K_A^-1 not in K_P', 'Na /= Nb', 'Nb uniquely originating' as the paper's. The paper's inner argument of Lemma 5.4 case S (the set T) is the theorem nsl-list-source; its 'no regular node contains an encrypted term as a proper subterm' is nsl-regular-encr-subterm; Lemma 2.8 does not apply to T as the paper says, the weaker bundle-minimal-sent-back does.")
       (notes-statement "Suppose Sigma is an NSL space, C a bundle in Sigma, s a responder strand in Resp[A, B, Na, Nb] with C-height 3, K_A^-1 not in K_P, Na /= Nb and Nb uniquely originating in Sigma. Then C contains an initiator's strand t in Init[A, B, Na, Nb] with C-height 3."))

(entry (doc "strand-spaces")
       (ref "5.3")
       (section "5.2" prefilled)
       (kind lemma)
       (title "The responder's nonce originates at the responder's second node")
       (names nsl-resp-nonce-originates)
       (home-elsewhere nsl-resp-nonce-originates)
       (status proven)
       (deviation "Stated for any responder strand of a PK-SPACE with Na /= Nb; 'Nb is not a name' is part of IS-RESP-STRAND (names and nonces are neither names of each other nor keys). Node <s,2> is the pair [2, s].")
       (notes-statement "Under the hypotheses of Proposition 5.2, Nb originates at the responder's node n0 = <s,2>."))

(entry (doc "strand-spaces")
       (ref "5.4")
       (section "5.2" prefilled)
       (kind lemma)
       (title "The minimal node containing Nb but not v0 is a positive regular node")
       (names nsl-lemma-5-4 adversary-encr-loss adversary-sent-source nsl-list-source bundle-minimal-sent-back)
       (home-elsewhere nsl-lemma-5-4)
       (status proven)
       (deviation "GAP found: Lemma 2.8 does not apply to the auxiliary set T of the adversary case S (T is not closed under equal content); the weaker bundle-minimal-sent-back (closure toward the sender along send edges) is what the argument needs. Needs the rule that names and nonces are not keys (else a nonce equal to K_A^-1 leaks it). The adversary case analysis is factored once into adversary-encr-loss / adversary-sent-source.")
       (notes-statement "The set S of nodes of C whose term contains Nb but not v0 = {Na Nb B}_KA has a minimal node n2, and n2 is regular and positive."))

(entry (doc "strand-spaces")
       (ref "5.6")
       (section "5.2" prefilled)
       (kind lemma)
       (title "An earlier node on the same strand carries v0")
       (names nsl-lemma-5-6 nsl-regular-encr-subterm)
       (home-elsewhere nsl-lemma-5-6)
       (status proven)
       (deviation "The paper's hand-wave 'no regular node contains an encrypted term as a proper subterm' is the theorem nsl-regular-encr-subterm.")
       (notes-statement "A node n1 precedes n2 on the same strand t, and term(n1) = {Na Nb B}_KA."))

(entry (doc "strand-spaces")
       (ref "5.7")
       (section "5.2" prefilled)
       (kind lemma)
       (title "The strand through n1 and n2 is an initiator strand in C")
       (names nsl-lemma-5-7)
       (home-elsewhere nsl-lemma-5-7)
       (status proven)
       (deviation "Needs PUBKEY injective (a field of PK-SPACE) to read B and A back off the keys.")
       (notes-statement "The regular strand t containing n1 and n2 is an initiator strand and is contained in C (C-height 3)."))

(entry (doc "strand-spaces")
       (ref "5.8")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Injectivity: at most one initiator strand for a uniquely originating Na")
       (names nsl-init-unique nsl-init-nonce-originates)
       (status proven)
       (deviation "Stronger than the paper's: two initiator strands with the value Na, whatever their other parameters, have the same identifier.")
       (notes-statement "If Sigma is an NSL space and Na is uniquely originating in Sigma, then there is at most one strand t in Init[A, B, Na, Nb] for any A, B and Nb."))

(entry (doc "strand-spaces") (ref "5.9") (section "5.3" prefilled) (kind lemma)
       (title "Original Needham-Schroeder: an earlier node carries {Na Nb}_KA")
       (names nso-lemma-5-9 nso-lemma-5-4 nso-resp-nonce-originates)
       (status proven)
       (deviation "The original protocol is the vocabulary structure-library/nso.scm: IS-NSO-INIT-STRAND, IS-NSO-RESP-STRAND, IS-NSO-SPACE, the NSL definitions with the second message {Na Nb}_KA. Hypotheses those of Proposition 5.2 (K_A^-1 uncompromised, Na /= Nb, Nb uniquely originating). The proof is the NSL proof of Lemmas 5.3, 5.4, 5.6 run unchanged on the new vocabulary (theorem-library/nso-laws.scm, a token-aware copy of nsl.scm sections 1-11): nothing up to Lemma 5.6 reads B off v0, which is the paper's 'exactly parallel'. The NS analogue of Lemma 5.7 fails (Lowe's attack); no attack bundle is constructed. Proven 2026-10-26 (SB-1).")
       (notes-statement "In the original Needham-Schroeder protocol, a node n1 precedes n2 on the same regular strand t, and term(n1) = {Na Nb}_KA."))

(entry (doc "strand-spaces")
       (ref "5.10")
       (section "5.4" prefilled)
       (kind proposition)
       (title "Secrecy of the responder's nonce")
       (names nsl-responder-secrecy nsl-responder-nonce-not-sent nsl-lemma-5-11 nsl-lemma-5-12)
       (status proven)
       (deviation "The paper's Lemma 5.11 misses the case where Nb is a name; proved with the case.")
       (notes-statement "Suppose Sigma is an NSL space, C a bundle in Sigma, s a responder's strand in Resp[A, B, Na, Nb], K_A^-1 and K_B^-1 not in K_P, Na /= Nb and Nb uniquely originating in Sigma. Then for all nodes m in C with Nb a subterm of term(m), either {Na Nb B}_KA or {Nb}_KB is a subterm of term(m). In particular Nb /= term(m)."))

(entry (doc "strand-spaces")
       (ref "5.11")
       (section "5.4" prefilled)
       (kind lemma)
       (title "No minimal node of the secrecy set is regular")
       (names nsl-lemma-5-11)
       (home-elsewhere nsl-lemma-5-11)
       (status proven)
       (deviation "GAP found: the paper misses the case where Nb is a name; excluded by the rule that nonces are not names (IS-RESP-STRAND).")
       (notes-statement "No minimal member of S = {m in C : Nb subterm of term(m), v0 and v3 not subterms} is a regular node."))

(entry (doc "strand-spaces")
       (ref "5.12")
       (section "5.4" prefilled)
       (kind lemma)
       (title "No minimal node of the secrecy set is an adversary node")
       (names nsl-lemma-5-12)
       (home-elsewhere nsl-lemma-5-12)
       (status proven)
       (deviation "Both private keys K_A^-1 and K_B^-1 uncompromised, as the paper says (the D case meets both v0 and v3).")
       (notes-statement "No minimal member of S is a penetrator (adversary) node."))

(entry (doc "strand-spaces")
       (ref "5.13")
       (section "5.5" prefilled)
       (kind proposition)
       (title "Secrecy of the initiator's nonce (corrected)")
       (names nsl-initiator-secrecy nsl-initiator-nonce-not-sent nsl-initiator-secrecy-adversary nsl-initiator-secrecy-regular)
       (status proven)
       (deviation "FALSE AS THE PAPER STATES IT, in two ways: two responders may answer the same first message, and then the second one's node holds Na but neither of the paper's two terms, with no adversary involved; and with Na = Nb the initiator's own third node is a counterexample. Proved with Na /= Nb added and the second disjunct widened to {Na x B}_KA for some token x. C-height 3 is not needed.")
       (notes-statement "Suppose Sigma is an NSL space, C a bundle in Sigma, s an initiator's strand in Init[A, B, Na, Nb] with C-height 3, K_A^-1 and K_B^-1 not in K_P, and Na uniquely originating in Sigma. Then for all nodes m in C with Na a subterm of term(m), either {Na A}_KB or {Na Nb B}_KA is a subterm of term(m). In particular Na /= term(m)."))

(entry (doc "strand-spaces")
       (ref "5.14")
       (section "5.5" prefilled)
       (kind proposition)
       (title "The initiator's agreement guarantee")
       (names nsl-initiator-agreement)
       (status proven)
