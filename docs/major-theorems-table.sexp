       (kind theorem)
       (title "Liouville")
       (names liouville bounded-entire-deriv-zero)
       (status proven)
       (deviation "Stated as f(z) = f(0) for every z.")
       (notes-statement "A bounded entire function is constant."))

(entry (doc "complex-analysis")
       (ref "3.50")
       (section "3.7" prefilled)
       (kind corollary)
       (title "Every nonconstant polynomial has a zero")
       (names fundamental-theorem-of-algebra cc-algebraically-closed)
       (home-elsewhere fundamental-theorem-of-algebra cc-algebraically-closed)
       (status proven)
       (deviation "fundamental-theorem-of-algebra (cauchy-estimates.scm) is the Liouville route; polynomials are coefficient functions with cc-series-partial-sum, leading coefficient nonzero.")
       (notes-statement "Any nonconstant polynomial P(z) has a zero."))

(entry (doc "complex-analysis")
       (ref "3.51")
       (section "3.7" prefilled)
       (kind proposition)
       (title "Complete factorization of a complex polynomial")
       (names cc-poly-factorization cc-partial-prod-congr cc-partial-prod-in-cc cc-ps-divide)
       (status proven)
       (deviation "PROVEN 2026-10-26: sum_{j<=n} c(j) z^j = c(n) prod_{i<n} (z - a(i)) when c(n) /= 0 (the notes' monic case is c(n) = 1). The product is CC-PARTIAL-PROD. The induction uses the FTA and POLY-2's division by z - a.")
       (notes-statement "A polynomial P of degree n factors as P(z) = (z - a_1) ... (z - a_n) (leading coefficient 1)."))

(entry (doc "complex-analysis")
       (ref "3.53")
       (section "3.7" prefilled)
       (kind proposition)
       (title "Entire functions of polynomial growth are polynomials")
       (names entire-polynomial-growth)
       (status proven)
       (deviation "PROVEN 2026-10-26: |f(z)| <= A|z|^m + B for all z ==> f(z) = sum_{j<=m} c(j) z^j. The proof is by induction on m with Liouville and the entire quotient (f - f(0))/z, instead of the coefficient estimate of 3.47.")
       (notes-statement "An entire f with |f(z)| <= A |z|^m + B is a polynomial of degree at most m."))

(entry (doc "complex-analysis")
       (ref "3.55")
       (section "3.8" prefilled)
       (kind proposition)
       (title "Maximum modulus principle")
       (names mvp-maximum-modulus mvp-disc-max-constant mvp-circle-max-constant connected-clopen holomorphic-maximum-modulus holomorphic-has-mean-value-property maximum-modulus-connected maximum-modulus-disc ball-zeros-accumulate)
       (status proven)
       (deviation "Proven 2026-10-28 (CAL-INT-2) as the notes state it: mvp-maximum-modulus for a function with the mean value property (Def 3.54, HAS-MEAN-VALUE-PROPERTY), holomorphic-maximum-modulus for holomorphic f (CAL-INT-2-REPORT.md:158). Connectedness is IS-CONNECTED(CC-MS, u).")
       (notes-statement "If a continuous f on a connected open U has the mean value property, |f| attains no maximum in U unless f is constant."))

(entry (doc "complex-analysis")
       (ref "3.56")
       (section "3.8" prefilled)
       (kind corollary)
       (title "Maximum on the boundary of a bounded domain")
       (names mvp-maximum-modulus-closure bounded-open-boundary-nonempty cc-closed-bounded-max continuous-constant-on-closure)
       (status proven)
       (deviation "m is any bound of |f| on the boundary (the notes' maximum is one); u bounded is 'magnitude <= bd on u'; f is continuous on the closure and has the mean value property on u through its restriction; conclusion (2) holds on the whole closure.")
       (notes-statement "If U is connected, open and bounded and f is continuous on closure(U) with the mean value property on U, then |f(u)| <= max of |f| on the boundary, with equality at a point of U only if f is constant."))

(entry (doc "complex-analysis")
       (ref "3.57")
       (section "3.8" prefilled)
       (kind proposition)
       (title "Schwarz's lemma")
       (names schwarz-lemma schwarz-quotient cc-compact-modulus-max holomorphic-removable-point)
       (status proven)
       (deviation "PROVEN 2026-10-26 as stated: (1) and (2).")
       (notes-statement "If f is holomorphic on the unit disc D with f(0) = 0 and |f| < 1, then |f(z)| <= |z|, and if |f(u)| = |u| for some u /= 0 then f(z) = r z with |r| = 1."))

(entry (doc "complex-analysis")
       (ref "3.59")
       (section "3.9" prefilled)
       (kind proposition)
       (title "Gamma is holomorphic in the right half plane")
       (names gamma-holomorphic gamma-converges)
       (status proven)
       (deviation "Gamma is GAMMA-FUNCTION, the improper integral IMPROPER-INT of GAMMA-INTEGRAND; gamma-recursion, gamma-at-one, gamma-factorial give (100)-(102).")
       (notes-statement "Gamma is holomorphic in the right half plane {z : Re z > 0}."))

(entry (doc "complex-analysis")
       (ref "3.60")
       (section "3.9" prefilled)
       (kind proposition)
       (title "Analytic continuation of Gamma")
       (names gamma-analytic-continuation)
       (status proven)
       (deviation "Proven 2026-10-29 (CH3-G); see scratchpad/triage/CH3-G-REPORT.md.")
       (notes-statement "Gamma has a unique analytic extension to C \\ {0, -1, -2, ...}, and it satisfies Gamma(z + 1) = z Gamma(z) there."))

(entry (doc "complex-analysis")
       (ref "3.61")
       (section "3.9" prefilled)
       (kind corollary)
       (title "Gamma has no zeros")
       (names corollary-3-61)
