       (notes-statement "The elements of C algebraic over a ring A form a subring of C."))

(entry (doc "algebraic-numbers")
       (ref "4.22")
       (section "4.4" prefilled)
       (kind proposition)
       (title "theta algebraic of degree <= n over K iff K-subspace V of dim <= n with theta V <= V")
       (names algebraic-degree-iff-invariant-space algebraic-degree-of-invariant-space)
       (status proven)
       (deviation "For a subfield K and theta in C: IS-ALGEBRAIC-OF-DEGREE-LE(K, theta, n) iff there is a V with IS-CC-SPACE-DIM-LE(K, V, n), a non-zero element in V, and theta V contained in V.")
       (notes-statement "theta in C is algebraic of degree <= n over K iff there is a non-trivial K-subspace V of dim <= n with theta V <= V."))

(entry (doc "algebraic-numbers")
       (ref "4.23")
       (section "4.4" prefilled)
       (kind corollary)
       (title "Algebraic numbers over K form a field, countable if K is")
       (names algebraic-numbers-countable algebraic-numbers-over-qq-countable algebraic-numbers-over-subfield-field)
       (status proven)
       (deviation "Countability half: generalised, K a countable SUBRING of C. Field half: IS-SUBFIELD-OF-CC(K) implies IS-SUBFIELD-OF-CC(ALGEBRAIC-NUMBERS-OVER(K)).")
       (notes-statement "The algebraic numbers over K form a field; countable if K is countable."))

(entry (doc "algebraic-numbers")
       (ref "4.24")
       (section "4.4" prefilled)
       (kind proposition)
       (title "The field of algebraic numbers is algebraically closed")
       (names algebraic-numbers-algebraically-closed algebraic-numbers-factorization)
       (status proven)
       (deviation "For a subfield K, c in FUN(NN, ALGEBRAIC-NUMBERS-OVER(K)), m in NN and c(m+1) /= 0: some z in ALGEBRAIC-NUMBERS-OVER(K) has sum_{j <= m+1} c_j z^j = 0, and the complete factorisation into linear factors with algebraic roots (algebraic-numbers-factorization).")
       (notes-statement "For K a subfield of C, the field of algebraic numbers over K is algebraically closed."))

(entry (doc "algebraic-numbers")
       (ref "4.25")
       (section "4.4" prefilled)
       (kind proposition)
       (title "k theta is algebraic over A for some non-zero k in A")
       (names algebraic-over-fractions-scaled)
       (status proven)
       (deviation "For a subring A and IS-ALGEBRAIC-OVER-FIELD(CC-FRACTION-FIELD(A), theta): some k in A with k /= 0 has IS-ALGEBRAIC-OVER(A, k theta).")
       (notes-statement "If A <= C is a ring with field of fractions K and theta is algebraic over K then k theta is algebraic over A for some k /= 0 in A."))

(entry (doc "algebraic-numbers")
       (ref "4.26")
       (section "4.4" prefilled)
       (kind corollary)
       (title "theta algebraic over Q iff theta in the fractions of the algebraic integers")
       (names algebraic-over-qq-iff-fraction-of-algebraic-integers)
       (status proven)
       (deviation "For theta in C: IS-ALGEBRAIC-OVER-FIELD(QQ, theta) iff theta is in CC-FRACTION-FIELD(SEP x in CC, IS-ALGEBRAIC-OVER(ZZ, x)).")
       (notes-statement "theta in C is algebraic over Q iff it lies in the field of fractions of the algebraic integers."))

(entry (doc "algebraic-numbers")
       (ref "5.44")
       (section "5.7" prefilled)
       (kind lemma)
       (title "Finite abelian group with at most d elements of order dividing d is cyclic")
       (names finite-group-cyclic-criterion)
       (status proven)
       (deviation "A finite group in which x^d = e has at most d solutions, for every d >= 1, is cyclic. The notes assume G Abelian; the proof does not use it, so the statement is for any finite group.")
       (notes-statement "If G is finite abelian and G_d = {x : d x = 0} has <= d elements for each d, then G is cyclic."))

