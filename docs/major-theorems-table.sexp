       (notes-statement "If f is holomorphic on U and gamma is a positively oriented circle enclosing the ball B, and w is not on (f o gamma)*, the number of solutions of f(z) = w in B with multiplicity is ind(f o gamma, w)."))

(entry (doc "complex-analysis")
       (ref "4.25")
       (section "4.5" prefilled)
       (kind theorem)
       (title "Local n-to-one structure of a holomorphic map")
       (names local-n-to-one multiplicity-local-simple holomorphic-local-power-form)
