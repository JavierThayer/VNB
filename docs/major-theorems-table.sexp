       (title "Qp is the fraction field of Zp")
       (names ccr-1-29 nv-field-fractions-of-integers)
       (status proven)
       (deviation "IS-FRACTIONS-OF(QP-FIELD p, ZP p). Proof differs from the notes (no compactness): an NV field is the field of fractions of its integers, x = x/1 if |x| <= 1, else x = 1/x^(-1). Proven 2026-10-28 (CCR-QP).")
       (notes-statement "Qp is the field of fractions of Zp."))

(entry (doc "ccr")
       (ref "1.30")
       (section "1.0" prefilled)
       (kind proposition)
       (title "Open subgroups of Zp are principal ideals")
       (names ccr-1-30 ccr-4-13)
       (status proven)
       (deviation "Open in Z_p = IS-OPEN in SUBSPACE-MS(NF-METRIC-SPACE(QP-FIELD p), ZP p); additive subgroup = IS-ADD-SUBGROUP; principal ideal = an IS-NV-MODULE over Z_p equal to NV-MULTIPLES(QP-FIELD p, ZP p, g) with g in Z_p. Proof through 4.13 (the notes' route goes through density in Z). Proven 2026-10-29 (CCR-QP).")
       (notes-statement "Any open subgroup of the additive group of Zp is a principal ideal."))

(entry (doc "ccr")
       (ref "1.32")
       (section "1.0" prefilled)
       (kind proposition)
       (title "Order and p^k x in Zp")
       (names ccr-1-32 ccr-1-31 qo-ppow-abs qo-ord-value)
       (status proven)
       (deviation "ord_p = QP-ORD(p) = log_(1/2)|x| (eq. (11), r = 1/2); p^k for k in ZZ is QP-PPOW(p, k), the y with y p^max(-k,0) = p^max(k,0). Stated as: p^(-ord x) x in Z_p, and every k in ZZ with p^k x in Z_p has -ord x <= k. Remark 1.31 is ccr-1-31. Proven 2026-10-29 (CCR-QP).")
       (notes-statement "For x in Qp nonzero, -ord_p(x) is the least integer k with p^k x in Zp."))

