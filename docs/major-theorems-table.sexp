(entry (doc "complex-analysis")
       (ref "4.1")
       (section "4.1" prefilled)
       (kind proposition)
       (title "A Laurent series is holomorphic on its annulus")
       (names laurent-holomorphic)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-A); see scratchpad/triage/CH4-A-REPORT.md.")
       (notes-statement "If the Laurent series sum_(k in Z) c_k z^k has convergence radii R- < R+, then f(z) = sum c_k (z - a)^k is holomorphic in the annulus A(a, R-, R+)."))

(entry (doc "complex-analysis")
       (ref "4.2")
       (section "4.1" prefilled-inferred)
       (kind proposition)
       (title "Laurent coefficients by a circle integral")
       (names laurent-coefficients cc-power-series-termwise cc-series-single-term)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-A); see scratchpad/triage/CH4-A-REPORT.md.")
       (notes-statement "If f has a Laurent expansion sum c_k (z - a)^k valid on |z - a| = r with R- < r < R+, then c_n r^n = (1/(2 pi)) int_0^(2 pi) f(a + r e^(i theta)) e^(-i n theta) d theta."))

(entry (doc "complex-analysis")
       (ref "4.3")
       (section "4.1" prefilled)
       (kind proposition)
       (title "Riemann's removable singularity criterion")
       (names riemann-removable-singularity cc-continuous-at-of-modulus riemann-removable)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-B) as riemann-removable-singularity; CH3-E's riemann-removable (both directions) is the earlier form: the neighbourhood V is a ball B(c, r), proved through 3.39 and the difference quotient, not Laurent series.")
       (notes-statement "If f is holomorphic on U \\ {u}, f has a removable singularity at u iff f is bounded on V \\ {u} for some neighbourhood V of u."))

(entry (doc "complex-analysis")
       (ref "4.4")
       (section "4.1" prefilled)
       (kind lemma)
       (title "Cauchy-type integral: power series inside, series in 1/(u - xi) outside")
       (names cauchy-kernel-integral-series outer-kernel-integral-series analytic-from-integral-formula cauchy-kernel-series-absolute)
       (home-elsewhere cauchy-kernel-integral-series analytic-from-integral-formula)
       (status proven)
       (deviation "First half: the tree's cauchy-kernel-integral-series; second half (trace inside B(xi, R), expansion in powers of 1/(u - xi)): outer-kernel-integral-series.")
       (notes-statement "If phi is continuous on gamma* and B(xi, R) misses gamma*, int_gamma phi(z)/(z - u) dz is a power series in u - xi normally convergent on each smaller closed ball; if gamma* is inside B(xi, R) it is a series in (u - xi)^-1 outside."))

(entry (doc "complex-analysis")
       (ref "4.5")
       (section "4.1" prefilled)
       (kind proposition)
       (title "Laurent expansion of a function holomorphic on an annulus")
       (names laurent-expansion laurent-expansion-annulus laurent-coef-radius-free annulus-cauchy)
       (status proven)
       (deviation "laurent-expansion is the notes' form; laurent-expansion-annulus is the two-series form with convergence.")
       (notes-statement "If f is holomorphic on A(a, R-, R+), f is represented by a Laurent series sum c_k (z - a)^k normally convergent on each closed subannulus."))

(entry (doc "complex-analysis")
       (ref "4.6")
       (section "4.1" prefilled)
       (kind corollary)
       (title "Holomorphic on a punctured disc iff Laurent expansion")
       (names laurent-punctured-iff laurent-punctured-expansion laurent-punctured-holomorphic laurent-coefs-radii)
       (status proven)
       (deviation "Proven as ONE iff (laurent-punctured-iff), with its two directions laurent-punctured-expansion (only if) and laurent-punctured-holomorphic (if).")
       (notes-statement "f is holomorphic in a punctured disc A(a, r) iff it has a Laurent expansion normally convergent on every subannulus A(a, r-, r+), 0 < r- < r+ < r."))

(entry (doc "complex-analysis")
       (ref "4.11")
       (section "4.2" prefilled)
       (kind proposition)
       (title "Poles of a meromorphic function are locally finite")
       (names meromorphic-poles-finite-in-compact)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-B); see scratchpad/triage/CH4-B-REPORT.md.")
       (notes-statement "If f is meromorphic on U, f has finitely many poles in each compact K in U; hence countably many poles."))

(entry (doc "complex-analysis")
       (ref "4.12")
       (section "4.2" prefilled)
       (kind proposition)
       (title "Meromorphic functions form a field")
       (names meromorphic-on-sum meromorphic-on-product meromorphic-at-sum meromorphic-at-product meromorphic-at-recip holomorphic-is-meromorphic-at)
       (status partial)
       (deviation "Closure of M(U) under the pointwise sum and product. The functions are given with their singular sets A and B, and the sum is read on U \\ (A u B). At a point, the sum, the product, and the reciprocal of a function not identically zero near the point (Example 4.8) are meromorphic. M(U) as a quotient and the global reciprocal are not formed.")
       (notes-statement "The space M(U) of meromorphic functions on U is a field under the pointwise operations."))

(entry (doc "complex-analysis")
       (ref "4.13")
       (section "4.2" prefilled)
       (kind theorem)
       (title "Casorati-Weierstrass")
       (names casorati-weierstrass meromorphic-point-cases)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-B); see scratchpad/triage/CH4-B-REPORT.md.")
       (notes-statement "If f is holomorphic on U \\ {u} with an essential singularity at u, the image of every punctured neighbourhood of u is dense in C."))

(entry (doc "complex-analysis")
       (ref "4.15")
       (section "4.3" prefilled)
       (kind proposition)
       (title "Residue theorem")
       (names residue-theorem residue-theorem-step meromorphic-residue-decomposition residue-theorem-induction)
       (status proven)
       (deviation "Proven 2026-10-29 (CH4-B); see scratchpad/triage/CH4-B-REPORT.md.")
       (notes-statement "If f is meromorphic on U with a finite set E of poles and gamma is a closed path in U \\ E null homotopic in U, then (1/(2 pi i)) int_gamma f = sum_(a in E) res(f, a) ind(gamma, a)."))

(entry (doc "complex-analysis")
       (ref "4.17")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Residue of the logarithmic derivative")
       (names log-derivative-residue-at-zero log-derivative-residue-at-pole log-derivative-at-zero log-derivative-at-pole simple-pole-of-decomposition)
       (status proven)
       (deviation "f'/f is the function z |-> f'(z)/f(z) on the open set where f is holomorphic. The point is a zero of order m >= 1 (HAS-ZERO-OF-ORDER) or a pole of order N (IS-POLE).")
       (notes-statement "If f is meromorphic at a and a is an exceptional point of degree m, then f'/f has a simple pole at a with residue m."))

(entry (doc "complex-analysis")
       (ref "4.19")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Argument principle")
       (names argument-principle argument-principle-holomorphic)
       (status proven)
       (deviation "E = Z u P. The degree sum is written sum_Z ZERO-ORDER(u \\ P, f, a) ind(a) + sum_P (-POLE-ORDER(f, a)) ind(a). (argument-principle-holomorphic is the zeros-only case of CH4-C.)")
       (notes-statement "If f is meromorphic on U with finite set E of zeros and poles and gamma is a closed path in U \\ E null homotopic in U, then (1/(2 pi i)) int_gamma f'/f = sum_(a in E) deg(f, a) ind(gamma, a)."))

(entry (doc "complex-analysis")
       (ref "4.20")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Rouche's theorem")
       (names rouche-theorem)
       (status proven)
       (deviation "f and g are meromorphic as in 4.19. The road lies in u \\ (E_f u E_g) and is null-homotopic in u. The degree sums are as in 4.19.")
       (notes-statement "If f, g are meromorphic on U with finite sets of zeros and poles, gamma is null homotopic in U avoiding them, and |f - g| < |g| on gamma*, then sum deg(f, a) ind(gamma, a) = sum deg(g, a) ind(gamma, a)."))

(entry (doc "complex-analysis")
       (ref "4.21")
       (section "4.4" prefilled)
       (kind corollary)
       (title "Counting zeros by the logarithmic integral")
       (names argument-principle-holomorphic)
       (home-elsewhere argument-principle-holomorphic)
       (status proven)
       (deviation "Winding-number form, for f holomorphic (CH4-C-REPORT.md:29).")
       (notes-statement "If f is holomorphic on a connected open U with finitely many zeros and gamma is a positively oriented simple closed path in U off the zeros, null homotopic in U, the number of zeros enclosed (with multiplicity) is (1/(2 pi i)) int_gamma f'/f."))

(entry (doc "complex-analysis")
       (ref "4.24")
       (section "4.5" prefilled)
       (kind proposition)
       (title "Number of solutions of f(z) = w as a winding number")
       (names zeros-count-winding)
       (status proven)
