(entry (doc "ccr")
       (ref "4.19")
       (section "4.0" prefilled)
       (kind proposition)
       (title "p-adic expansion")
       (names ccr-4-19 qe-abs-convergent ccr-4-18-qp qe-expansion-exists qe-unique-le)
       (status proven)
       (deviation "x = sum_{k >= n} a_k p^k is IS-QP-EXPANSION(p, a, n, x): digits a : ZZ -> ZZ in [0, p), zero below n, partial sums QP-PSUM (SUM-AG of a_(n+j) p^(n+j)) converging to x in QP(p). Uniqueness for any two starts (a(k) = b(k) for all k in ZZ). Absolute convergence: qe-abs-convergent. Remark 4.18 for Q_p: ccr-4-18-qp. Proven 2026-10-29 (CCR-QP).")
       (notes-statement "Every x in Qp is uniquely an infinite series sum a_k p^k with digits in {0,...,p-1}."))

(entry (doc "ccr")
       (ref "4.4")
       (section "4.0" prefilled-inferred)
       (kind remark)
       (title "Uniformizers differ by a unit")
       (names ccr-remark-4-4 ccr-remark-4-4-unit ccr-remark-4-4-norm)
