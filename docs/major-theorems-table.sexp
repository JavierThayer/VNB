       (deviation "p = q s + r with r = 0 or deg r < deg q.")
       (notes-statement "For polynomials p, q over a field F (q non-zero) there are s, r with p = q s + r and deg r < deg q."))

(entry (doc "galois-theory")
       (ref "1.10")
       (section "1.2" prefilled)
       (kind corollary)
