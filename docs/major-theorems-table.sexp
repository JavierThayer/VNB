       (status proven)
       (deviation "Mapped under linear-algebra 3.3.")
       (notes-statement "For any m x n matrix A, A E_n[k,l] is A with column k moved to column l and zeros elsewhere."))

(entry (doc "galois-theory")
       (ref "1.20")
       (section "1.4" prefilled)
       (kind proposition)
