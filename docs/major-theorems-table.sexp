       (deviation "For the notes' IS-EUCLIDEAN-DOMAIN (Definition 1.2 with property (1)); every one is an IS-EUCLIDEAN-RING.")
       (notes-statement "If a prime p of a Euclidean domain divides ab then p divides a or b."))

(entry (doc "galois-theory")
       (ref "1.6")
       (section "1.1" prefilled)
       (kind corollary)
       (title "Prime dividing a product of primes is associate to one")
       (names prime-divides-prime-product)
       (status proven)
       (deviation "Corollary 1.6.")
       (notes-statement "If p divides q1...qn (primes) then p is equivalent modulo units to some qi."))

(entry (doc "galois-theory")
       (ref "1.7")
       (section "1.1" prefilled)
       (kind lemma)
       (title "Proper divisor has smaller gauge")
       (names degree-proper-divisor)
       (status proven)
       (deviation "For the notes' IS-EUCLIDEAN-DOMAIN (Definition 1.2 with property (1)); every one is an IS-EUCLIDEAN-RING. The notes' proof swaps a and b in one place; corrected silently.")
       (notes-statement "If b is a proper divisor of a /= 0 in a Euclidean domain then nu(a) > nu(b)."))

(entry (doc "galois-theory")
       (ref "1.8")
       (section "1.1" prefilled)
       (kind proposition)
       (title "A Euclidean domain is a UFD")
       (names euclidean-domain-is-ufd factorization-exists-bounded factorization-unique)
