       (notes-statement "Suppose {f_k} is a bounded sequence in H(U) which converges pointwise to some function g. Then g in H(U) and the convergence f_k -> g is uniform on compact subsets of U."))

(entry (doc "complex-analysis")
       (ref "5.20")
       (section "5.3" prefilled)
       (kind proposition)
       (title "Differentiation is continuous on H(U)")
