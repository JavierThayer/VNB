       (notes-statement "For sigma-finite mu, the map f |-> (psi |-> integral f psi d mu) is an isometric isomorphism of L^infinity(X, mu) onto the dual of L^1(X, mu)."))

(entry (doc "construction-of-measures")
       (ref "2.32")
