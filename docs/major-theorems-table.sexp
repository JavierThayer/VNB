(entry (doc "banach-algebras")
       (ref "5.24")
       (section "5.6" prefilled)
       (kind corollary)
       (title "Ultraweak functionals are A |-> tr(A S)")
       (names)
       (status absent)
       (deviation "Needs 5.22, 5.23, 2.15, 2.19.")
       (notes-statement "phi is ultraweakly continuous iff phi(A) = tr(A S) for a trace class S, unique; phi is weakly continuous iff S has finite rank."))

(entry (doc "banach-algebras")
       (ref "5.27")
       (section "5.6" prefilled)
       (kind proposition)
       (title "||tau_S|| = tr|S|")
       (names)
       (status absent)
       (deviation "Needs 5.24, |S| for a bounded operator (the square root, 1.31 in BH-ALGEBRA) and the polar decomposition of a bounded operator (3.28 in its bounded form).")
       (notes-statement "For S in T(H), the norm of tau_S in L(H)* is tr(|S|)."))

(entry (doc "banach-algebras")
       (ref "5.28")
       (section "5.6" prefilled)
       (kind corollary)
       (title "The trace norm")
       (names)
       (status absent)
       (deviation "Needs 5.27.")
       (notes-statement "T(H) is a vector space and ||S||_T = tr(|S|) is a norm on it."))

(entry (doc "banach-algebras")
       (ref "5.29")
       (section "5.6" prefilled)
       (kind proposition)
       (title "The dual of K(H) is T(H)")
       (names)
       (status absent)
       (deviation "Needs K(H) (compact operators: absent, not defined in these notes' chapters 1-6; decision D6), 5.27, 5.30.")
       (notes-statement "Every norm continuous linear functional phi on K(H) is phi(A) = tr(A S) for a unique S in T(H), and ||phi|| = ||S||_T."))

(entry (doc "banach-algebras")
       (ref "5.30")
       (section "5.6" prefilled)
       (kind lemma)
       (title "A trace bound over finite rank projections")
       (names)
       (status absent)
       (deviation "Needs TRACE-CLASS, IS-FINITE-RANK, the order on projections and ONB.")
       (notes-statement "S self-adjoint positive with tr(E S) <= C for all finite rank projections E <= E_(ran S). Then S is trace class and tr(S) <= C."))

;;; ===== ch. 5 section 7: Duals =====
(entry (doc "banach-algebras")
       (ref "5.31")
       (section "5.7" prefilled)
       (kind proposition)
       (title "L(H) is the dual of L*(H)")
       (names)
       (status absent)
       (deviation "Needs 5.24, 5.27, 5.10 and the bounded-form-to-operator step.")
       (notes-statement "The map h : L(H) -> L*(H)* is an isometric isomorphism."))

;;; ===== ch. 5 section 8: Transpose and Module Structure =====
(entry (doc "banach-algebras")
       (ref "5.32")
       (section "5.8" prefilled)
       (kind proposition)
       (title "The adjoint of a weakly continuous functional")
       (names)
       (status absent)
       (deviation "Needs 5.24, 2.23 and the adjoint functional phi*(A) = conj(phi(A*)).")
       (notes-statement "If phi is weakly (ultraweakly) continuous so is phi*, and tau_S* = tau_(S*)."))

(entry (doc "banach-algebras")
       (ref "5.33")
       (section "5.8" prefilled)
       (kind proposition)
       (title "tau_S is self-adjoint / positive iff S is")
       (names)
       (status absent)
       (deviation "Needs 5.32 and positive operators in BH-ALGEBRA.")
       (notes-statement "For S in T(H), tau_S is self-adjoint (positive) iff S is self-adjoint (positive)."))

;;; ===== ch. 5 section 9: Ultraweak and Ultrastrong Topologies =====
(entry (doc "banach-algebras")
       (ref "5.34")
       (section "5.9" prefilled)
       (kind proposition)
       (title "Ultraweak seminorms through HS operators")
       (names)
       (status absent)
       (deviation "Needs 5.22, 5.23 and equality of two SEMINORM-TOPs.")
       (notes-statement "The ultraweak topology is given by the seminorms p_(T,S)(A) = |<A T | S>_HS|, T, S in HS(H); the weak topology by those with T, S of finite rank."))

(entry (doc "banach-algebras")
       (ref "5.35")
       (section "5.9" prefilled)
       (kind proposition)
       (title "Ultrastrong seminorms through HS operators")
       (names)
       (status absent)
       (deviation "Needs 5.34's route and ||A T||_HS.")
       (notes-statement "The ultrastrong topology is given by the seminorms p_T(A) = ||A T||_HS, T in HS(H); the strong topology by those with T of finite rank."))

;;; ===== ch. 6 section 1: Von Neumann Density Theorem =====
(entry (doc "banach-algebras")
       (ref "6.1")
       (section "6.1" prefilled)
       (kind theorem)
       (title "Von Neumann's bicommutant theorem")
       (names)
       (status absent)
       (deviation "Needs COMMUTANT / BICOMMUTANT (ba-rep-vocab), the SOT closure (a TOP-SPACE closure: the tree's CLOSURE is metric; IS-TOP-CLOSED exists), the amplification to H^n with n x n operator matrices, and 1.55.")
       (notes-statement "A an involutive algebra of operators on H containing I_H. Then A'' is the strong operator closure of A."))

(entry (doc "banach-algebras")
       (ref "6.3")
       (section "6.1" prefilled)
       (kind theorem)
       (title "A'' is the ultrastrong closure")
       (names)
       (status absent)
       (deviation "Needs 6.1 and UST with the countable amplification H (x) l2(N).")
       (notes-statement "A an involutive algebra of operators on H containing I_H. Then A'' is the ultrastrong closure of A."))

;;; ===== ch. 6 section 2: Kaplansky Density Theorem =====
(entry (doc "banach-algebras")
       (ref "6.6")
       (section "6.2" prefilled)
       (kind theorem)
       (title "Kaplansky density")
       (names)
       (status absent)
       (deviation "Needs 6.1, 5.8, 5.20, 1.31 and the SOT continuity of a continuous function of self-adjoint operators on bounded sets.")
       (notes-statement "A, B involutive algebras of operators containing I_H, A strongly dense in B. (1) The unit ball of A is strongly dense in the unit ball of B; (2) the unit ball of A_sa is strongly dense in that of B_sa."))

(entry (doc "banach-algebras")
       (ref "6.7")
       (section "6.2" prefilled)
       (kind corollary)
       (title "Von Neumann algebras via the unit ball")
       (names)
       (status absent)
       (deviation "Needs 6.6, 5.8 and IS-VON-NEUMANN-ALGEBRA (Def 6.4).")
       (notes-statement "An involutive subalgebra A of L(H) containing I_H is a von Neumann algebra iff its unit ball is weakly closed."))

;;; ===== ch. 6 section 3: Cyclic and Separating Vectors =====
(entry (doc "banach-algebras")
       (ref "6.8")
       (section "6.3" prefilled)
       (kind proposition)
       (title "Cyclic for A' implies separating for A")
       (names)
       (status absent)
       (deviation "Needs COMMUTANT, IS-CYCLIC-FOR(S, xi) (dense orbit) and IS-SEPARATING-FOR.")
       (notes-statement "A an involutive algebra in L(H) containing I_H. xi is separating for A if it is cyclic for A'; xi is cyclic for A if it is separating for A'."))

(entry (doc "banach-algebras")
       (ref "6.9")
       (section "6.3" prefilled)
       (kind corollary)
       (title "Cyclic and separating vectors of a von Neumann algebra")
       (names)
       (status absent)
       (deviation "Needs 6.1 and 6.8 (the converse uses A'' = A).")
       (notes-statement "If A is a von Neumann algebra, xi is separating (cyclic) for A iff it is cyclic (separating) for A'."))
