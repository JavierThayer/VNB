(entry (doc "complex-analysis")
       (ref "3.22")
       (section "3.3" prefilled)
       (kind proposition)
       (title "Logarithm of a nonvanishing holomorphic function")
       (names holomorphic-log-sc-exists holomorphic-log-sc holomorphic-log-convex holomorphic-log-convex-exists)
       (status proven)
       (deviation "On a SIMPLY-CONNECTED u: existence (f nonvanishing holomorphic gives f = exp g with g holomorphic), plus any other such h has g = h + 2 pi i n with n in ZZ (holomorphic-log-sc). The convex-U forms of CH3-B remain.")
       (notes-statement "If f is holomorphic and nonzero on a simply connected open U there is a holomorphic g on U with exp g = f, and any other such h satisfies g - h = 2 pi i n for an integer n."))

(entry (doc "complex-analysis")
       (ref "3.24")
       (section "3.3" prefilled)
       (kind corollary)
       (title "Existence and uniqueness of the principal branch of log")
       (names principal-log-exists-unique cc-log-unique-branch cc-log-holomorphic cc-log-spec cc-log-one cc-log-unique)
       (home-elsewhere cc-log-holomorphic cc-log-spec cc-log-one cc-log-unique)
       (status proven)
       (deviation "Existence and uniqueness of the principal branch (CH3-B-REPORT.md:17).")
       (notes-statement "There is a unique holomorphic g on C \\ (-inf, 0] with g(1) = 0 and exp g(z) = z."))

(entry (doc "complex-analysis")
       (ref "3.25")
       (section "3.3" prefilled)
       (kind corollary)
       (title "n-th roots of a nonvanishing holomorphic function")
       (names holomorphic-root-sc-exists holomorphic-root-sc-unique holomorphic-root-convex-exists holomorphic-root-convex-unique)
       (status proven)
       (deviation "On a SIMPLY-CONNECTED u, n >= 1: some holomorphic g has g^n = f (holomorphic-root-sc-exists); any h with h^n = f is a g, with a^n = 1 (holomorphic-root-sc-unique). The convex-U forms of CH3-B remain.")
       (notes-statement "If U is simply connected and f is holomorphic and nonvanishing on U, then for each n >= 1 there is a holomorphic g with g^n = f, and any h with h^n = f is alpha g for an n-th root of unity alpha."))

(entry (doc "complex-analysis")
       (ref "3.27")
       (section "3.4" prefilled)
       (kind proposition)
       (title "The winding number is an integer, constant on components")
       (names winding-number-integer winding-constant-on-connected winding-locally-constant)
       (status proven)
       (deviation "Constancy is stated on every connected set off the trace (a component is such a set); closedness is the hypothesis pgam(b) = pgam(a); paths are roads.")
       (notes-statement "If u is not on gamma*, ind(gamma, u) is an integer, and as a function of u it is constant on the connected components of C \\ gamma*."))

(entry (doc "complex-analysis")
       (ref "3.28")
       (section "3.4" prefilled)
       (kind proposition)
       (title "Integral of a finite principal part")
       (names principal-part-integral principal-part-integral-step)
       (status proven)
       (deviation "The finite sum is CC-SERIES-PARTIAL-SUM of k |-> a_{k+1} (z - u)^-(k+1); N >= 1.")
       (notes-statement "For a closed path gamma with u not on gamma*, (1/(2 pi i)) int_gamma sum_(k=1..N) a_k / (z - u)^k dz = a_1 ind(gamma, u)."))

(entry (doc "complex-analysis")
       (ref "3.30")
       (section "3.4" prefilled)
       (kind corollary)
       (title "Winding number vanishes on the unbounded component")
       (names winding-zero-unbounded winding-zero-outside-disc)
       (status proven)
       (deviation "The unbounded component is spelled as a connected set off the trace that meets the outside of a ball containing the trace.")
       (notes-statement "If u is in the unbounded component of C \\ gamma*, then ind(gamma, u) = 0."))

(entry (doc "complex-analysis")
       (ref "3.31")
       (section "3.4" prefilled)
       (kind corollary)
       (title "Homotopy invariance of the winding number")
       (names homotopy-winding)
       (status proven)
       (deviation "Roads homotopic in CC \\ {z} have the same winding number about z.")
       (notes-statement "If the closed paths gamma, rho are homotopic in C \\ {u}, then ind(gamma, u) = ind(rho, u)."))

(entry (doc "complex-analysis")
       (ref "3.32")
       (section "3.4" prefilled)
       (kind proposition)
       (title "Winding number of a positively oriented triangle")
       (names triangle-winding-interior triangle-tri-int-interior triangle-winding-exterior)
       (status proven)
       (deviation "Interior case (triangle-winding-interior, triangle-tri-int-interior): the vertices are distinct. Second half (triangle-winding-exterior): u not in the hull; the vertices are distinct and the interior is nonempty.")
       (notes-statement "If a, b, c are positively oriented and u is not on the triangle, ind(triangle[a,b,c], u) = 1 when u is in the interior of conv{a, b, c} and 0 otherwise."))

(entry (doc "complex-analysis")
       (ref "3.33")
       (section "3.5" prefilled)
       (kind lemma)
       (title "A Cauchy-type integral is analytic off the trace")
       (names analytic-from-integral-formula analytic-at-from-integral-formula cauchy-kernel-integral-series)
       (status proven)
       (deviation "Stated on a disc B(c, r) at distance >= r from a set u containing the trace, with phi continuous on u (the notes: phi continuous on the trace); the coefficients of Remark 3.34 are part of the statement.")
       (notes-statement "If gamma is a path and phi is continuous on gamma*, then f(u) = int_gamma phi(z)/(z - u) dz is analytic on C \\ gamma*."))

(entry (doc "complex-analysis")
       (ref "3.35")
       (section "3.5" prefilled)
       (kind theorem)
       (title "Holomorphic implies analytic")
       (names holomorphic-analytic-at holomorphic-power-series-disc)
       (status proven)
       (deviation "Proven through the Cauchy integral formula on a circle (cauchy-integral-formula-disc), not through triangles as in the notes.")
       (notes-statement "Any holomorphic function f on an open set U is analytic."))

(entry (doc "complex-analysis")
       (ref "3.37")
       (section "3.5" prefilled)
       (kind corollary)
       (title "The derivative of a holomorphic function is holomorphic")
       (names holomorphic-deriv-holomorphic)
       (status proven)
       (deviation "The derivative is spelled VNB-LAMBDA(w, u, DERIV-ON(CC-NORMED-FIELD, u, f, w)).")
       (notes-statement "If f is holomorphic on an open set U, then f' is holomorphic."))

(entry (doc "complex-analysis")
       (ref "3.39")
       (section "3.5" prefilled)
       (kind corollary)
       (title "Removable singularities")
       (names removable-singularity removable-extension-unique)
       (status proven)
       (deviation "Def 3.38 is the hypothesis: g in FUN(u, CC) continuous on u, equal to f on u \\ {c}.")
       (notes-statement "If f is holomorphic on U \\ {u} and extends continuously to U, the extension is holomorphic on U."))

(entry (doc "complex-analysis")
       (ref "3.40")
       (section "3.5" prefilled)
       (kind proposition)
       (title "Derivative of a Cauchy-type integral")
       (names cauchy-type-integral-deriv)
       (status proven)
       (deviation "At an off-trace point c with r <= |z - c| on the domain; the constant 1/(2 pi i) is the parameter kap.")
       (notes-statement "If phi is continuous on gamma* and f(u) = int_gamma phi(z)/(z - u) dz for u off gamma*, then f'(u) = int_gamma phi(z)/(z - u)^2 dz."))

(entry (doc "complex-analysis")
       (ref "3.41")
       (section "3.5" prefilled)
       (kind proposition)
       (title "Cauchy integral formula over a triangle")
       (names triangle-cauchy-formula)
       (status proven)
       (deviation "The integrand f(z)/(z - u) is a function on U minus {u}.")
       (notes-statement "If f is holomorphic on U, [a, b, c] is a positively oriented triangle with conv{a, b, c} in U and u is interior to it, then f(u) = (1/(2 pi i)) int_[a,b,c] f(z)/(z - u) dz."))

(entry (doc "complex-analysis")
       (ref "3.42")
       (section "3.5" prefilled)
       (kind corollary)
       (title "Cauchy formula for the derivative over a triangle")
       (names triangle-cauchy-deriv)
       (status proven)
       (deviation "f'(u) is DERIV-ON(CC-NORMED-FIELD, U, f, u); the integrand is f(z) ((z - u)^-1)^2 on U minus {u}. The proof uses 3.41 for f', not 3.40.")
       (notes-statement "Under the hypotheses of 3.41, f'(u) = (1/(2 pi i)) int_[a,b,c] f(z)/(z - u)^2 dz."))

(entry (doc "complex-analysis")
       (ref "3.43")
       (section "3.6" prefilled)
       (kind proposition)
       (title "Morera's theorem")
       (names morera morera-conditional)
       (status proven)
       (deviation "Stated with continuity on the subspace U and triangle integrals TRI-INT over every conv3(a, b, c) inside U.")
       (notes-statement "If f is continuous on an open U and int_[a,b,c] f = 0 whenever conv{a, b, c} is in U, then f is holomorphic."))

(entry (doc "complex-analysis")
       (ref "3.44")
       (section "3.6" prefilled)
       (kind proposition)
       (title "Weierstrass: uniform limits on compacta of holomorphic functions are holomorphic")
       (names holomorphic-limit-on-compacta holomorphic-limit-derivatives unif-on-compacta-locally locally-uniform-on-compacta cc-closed-ball-compact)
       (status proven)
       (deviation "PROVEN 2026-10-14: a sequence of functions holomorphic on the open set u with UNIF-ON-COMPACTA(u, fam, g) (uniform convergence on every K inside u with IS-COMPACT(SUBSPACE-MS(CC-MS, K))) has g holomorphic on u, through the locally uniform form of morera.scm and the compactness of closed discs (cc-closed-ball-compact). holomorphic-limit-derivatives adds what the notes do not state: the derivatives converge to g' uniformly on compacta.")
       (notes-statement "Suppose {f_n} is a sequence of holomorphic functions on an open set U which converges uniformly on compact subsets of U to g. Then g is holomorphic on U."))

(entry (doc "complex-analysis")
       (ref "3.45")
       (section "3.6" prefilled)
       (kind proposition)
       (title "Holomorphy across a straight line")
       (names holomorphic-across-line)
       (status proven)
       (deviation "Proven 2026-10-28 (CH3-E); see scratchpad/triage/CH3-E-REPORT.md.")
       (notes-statement "If f is continuous on the open set U and holomorphic on U \\ L, L an infinite straight line, then f is holomorphic on U."))

(entry (doc "complex-analysis")
       (ref "3.46")
       (section "3.6" prefilled)
       (kind proposition)
       (title "Schwarz reflection principle")
       (names schwarz-reflection)
       (status proven)
       (deviation "Proven 2026-10-28 (CH3-E); see scratchpad/triage/CH3-E-REPORT.md.")
       (notes-statement "If U is open in the upper half plane, f is continuous on Omega = U u (closure(U) n R), holomorphic on U and real on closure(U) n R, then f extends to a holomorphic g on the interior of Omega u conj(Omega) with g(conj z) = conj g(z)."))

(entry (doc "complex-analysis")
       (ref "3.47")
       (section "3.7" prefilled)
       (kind proposition)
       (title "Coefficient bound by the maximum on a circle")
       (names power-series-coefficient-bound)
       (status proven)
       (deviation "M(r) is any bound of |sum c_k (z - a)^k| on |z - a| = r (the sup is the least one); the hypothesis is r < CPS-RADIUS(c).")
       (notes-statement "If f(z) = sum c_k (z - a)^k converges on B(a, R), then for 0 < r < R, |c_n| <= M(r) r^-n with M(r) = sup{|f(z)| : |z - a| = r}."))

(entry (doc "complex-analysis")
       (ref "3.48")
       (section "3.7" prefilled)
       (kind corollary)
       (title "Cauchy's estimates")
       (names cauchy-estimates cauchy-estimate-derivative rr-le-of-power-bounds holomorphic-nth-deriv)
       (status proven)
       (deviation "PROVEN 2026-10-26 with the full radius: |f^(k)(a)| <= k! M R^-k when |f| <= M on B(a, R). f^(k)(a) is read, as everywhere in the tree, as the k-th derivative on a ball B(a, rho), rho < R, of the restriction of f. The limit r -> R is rr-le-of-power-bounds (Bernoulli).")
       (notes-statement "If f is holomorphic on B(a, R) and |f| <= M there, then |f^(k)(a)| <= M k! / R^k for all k >= 0."))

(entry (doc "complex-analysis")
       (ref "3.49")
