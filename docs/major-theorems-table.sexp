(entry (doc "complex-analysis")
       (ref "5.19")
       (section "5.2" prefilled)
       (kind corollary)
       (title "A bounded pointwise convergent sequence in H(U) converges uniformly on compacta")
       (names cc-montel-pointwise-limit)
