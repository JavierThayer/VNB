(entry (doc "topological-vector-spaces")
       (ref "1.4")
       (section "1.1" prefilled)
       (kind proposition)
       (title "A separating family of seminorms defines a vector space topology")
       (names seminorm-top-is-tvs sntop-is-top-space sntop-hausdorff sntop-add-continuous sntop-scal-continuous sntop-open-basic)
       (status proven)
       (deviation "Arbitrary index set ix and arbitrary normed field fld. 'Vector space topology'
   is IS-TVS: Hausdorff topology on VEC m with addition and scalar multiplication continuous
   in neighbourhood form. The topology is SEMINORM-TOP, opens defined by the closed basic
   sets SN-BALL over finite index sets. The earlier countable/metric results
   (frm-*) stand beside it.")
       (notes-statement "The topology defined by a separating family of seminorms on a vector space is a vector space topology."))

(entry (doc "topological-vector-spaces")
       (ref "1.5")
       (section "1.1" prefilled)
       (kind corollary)
       (title "R^n is a topological vector space")
       (names rn-is-tvs nvs-norm-top-is-tvs nvs-norm-is-seminorm nvs-norm-family)
       (status proven)
       (deviation "R^n carries the topology of the single seminorm VNRM(RN n) (the sup norm),
   SEMINORM-TOP over a one-point index; this is the product topology, but the identification
   with a product topology is not stated (no product TOP-SPACE construction).")
       (notes-statement "For any n in N, R^n with the product topology is a topological vector space."))

(entry (doc "topological-vector-spaces")
       (ref "1.8")
       (section "1.1" prefilled)
       (kind proposition)
       (title "The C^k(U) seminorms and convergence uniformly on compacta")
       (names cc-exhaust-seminorms-family cc-fr-conv-iff-unif-on-compacta)
       (home-elsewhere cc-exhaust-seminorms-family cc-fr-conv-iff-unif-on-compacta)
       (status partial)
       (deviation "Only k = 0, U open in CC, complex-valued functions, sequences, and seminorms over a compact EXHAUSTION rather than all (K, alpha): cc-exhaust-seminorms-family and cc-fr-conv-iff-unif-on-compacta. Missing: C^k(U) for U open in R^n, multi-index partial derivatives d^alpha, the seminorms p_{K,alpha}, and directed families (nets).")
       (notes-statement "p_{K,alpha} is a seminorm on C^k(U); a directed family phi_lambda converges to phi iff d^alpha phi_lambda -> d^alpha phi uniformly on compact subsets for every |alpha| <= k."))

(entry (doc "topological-vector-spaces")
       (ref "1.12")
       (section "1.2" prefilled)
       (kind proposition)
       (title "Continuity of a linear map between seminormed spaces by seminorm bounds")
       (names sn-cont-iff-bound sn-cont-of-bound sn-bound-of-cont sn-bound-combine)
       (status proven)
       (deviation "Over RR (RR-NORMED-FIELD) for the iff; bound => continuous is proven over any
   normed field (sn-cont-of-bound). Arbitrary index sets. Continuity is
   IS-HOM-TOP-SPACE between the SEMINORM-TOPs. The max is avoided: 'finite ff subset of ix1,
   cb > 0, for all x and t >= 0, (p_i(x) <= t for all i in ff) implies q_j(T x) <= cb t',
   which is equivalent to q_j(T x) <= cb max_{i in ff} p_i(x).")
       (notes-statement "A linear map T : E -> F between spaces with separating seminorm families is continuous iff for every q_j there are finitely many p_i1..p_ik and C > 0 with q_j(Tx) <= C max(p_i1(x), ..., p_ik(x))."))

(entry (doc "topological-vector-spaces")
       (ref "1.13")
       (section "1.2" prefilled)
       (kind corollary)
       (title "Continuity of a linear functional by a seminorm bound")
       (names functional-cont-iff-bound)
       (status proven)
       (deviation "Over RR; R carries the topology of RR-NVS's norm (|.|); bound stated
   without max as in 1.12.")
       (notes-statement "A linear functional f on a space whose topology is defined by seminorms p_i is continuous iff |f(x)| <= C max(p_i1(x), ..., p_in(x)) for some C and finitely many indices."))

(entry (doc "topological-vector-spaces")
       (ref "1.18")
       (section "1.3" prefilled)
       (kind proposition)
       (title "Cauchy-Schwarz inequality")
       (names sip-schwarz)
       (home-elsewhere sip-schwarz)
       (status proven)
       (deviation "Stated for a positive SEMIdefinite form (SEMI-INNER-PRODUCT-SPACE), squared: <x,y>^2 <= <x,x><y,y>. The proof avoids the notes' division by <eta,eta>, which may vanish for a nonzero eta in the semidefinite case.")
       (notes-statement "For xi, eta in a pre-Hilbert space H, |<xi|eta>| <= <xi|xi>^{1/2} <eta|eta>^{1/2}."))

(entry (doc "topological-vector-spaces")
       (ref "1.19")
       (section "1.3" prefilled)
       (kind proposition)
       (title "The norm of a pre-Hilbert space")
       (names sip-normed-ag-is-normed-ag sip-minkowski sip-metric-space-is-metric-space)
       (home-elsewhere sip-minkowski)
       (status proven)
       (deviation "Stated as IS-NORMED-AG(SIP-NORMED-AG(v)) for a pre-Hilbert space v, the norm being x |-> SQRT(<x,x>). The triangle inequality (sip-minkowski) is proven for a semidefinite form.")
       (notes-statement "For a pre-Hilbert space H, the functional xi |-> <xi|xi>^{1/2} is a norm."))

(entry (doc "topological-vector-spaces")
       (ref "1.20")
       (section "1.3" prefilled)
       (kind proposition)
       (title "Closest point of a closed convex set")
       (names real-convex-closest-point-unique real-convex-closest-point real-convex-closest-unique real-convex-closest-iff-variational)
       (status proven)
       (deviation "C is required NONEMPTY (for C empty the notes' statement is false). Closest is minimality of the squared distance, |a - x|^2 <= |b - x|^2 for every b in C, not an infimum. Existence goes through the complexification of H and the complex closest-point theorem for a midpoint-closed set (hilbert-closest-point-midpoint), not through the notes' minimizing sequence. The variational characterisation real-convex-closest-iff-variational is not in the notes.")
       (notes-statement "Let C be a norm-closed convex subset of a real Hilbert space H. For any x in H there is a unique a in C such that ||a - x|| = inf{||b - x|| : b in C}."))

(entry (doc "topological-vector-spaces")
       (ref "1.23")
       (section "1.3" prefilled)
       (kind proposition)
       (title "Complex polarization identity")
       (names ses-polarization)
       (home-elsewhere ses-polarization)
       (status proven)
       (deviation "Stated for a sesquilinear form on the vectors of a COMPLEX-SEMI-INNER-PRODUCT-SPACE, i psi being the complex multiple (37).")
       (notes-statement "If B is a sesquilinear form, 4B(phi, psi) = B(phi + psi, phi + psi) - B(phi - psi, phi - psi) + iB(phi + i psi, phi + i psi) - iB(phi - i psi, phi - i psi)."))

(entry (doc "topological-vector-spaces")
       (ref "1.24")
       (section "1.3" prefilled)
       (kind proposition)
       (title "Antisymmetric, isometric, square minus the identity: any two give the third")
       (names sip-isometric-of-antisym-sq sip-antisym-of-isometric-sq phs-square-of-antisym-isometric)
       (status proven)
       (deviation "(1) and (3) give (2), and (2) and (3) give (1), for a positive semidefinite form; (1) and (2) give (3) only on a pre-Hilbert space, as the notes state it (it is false for a semidefinite form: RR with the zero form, J the identity). None of the three needs J linear.")
       (notes-statement "If J is a real linear mapping on a real pre-Hilbert space, each of (1) J antisymmetric, (2) J isometric, (3) J^2 = -I is implied by the remaining two."))

(entry (doc "topological-vector-spaces")
       (ref "1.25")
       (kind proposition)
       (title "A real pre-Hilbert space with J is a complex pre-Hilbert space")
       (names cphs-is-complex-inner-product-space csip-crip-unique cips-real-is-cphs)
       (status proven)
       (deviation "A real space with such a J is the structure COMPLEX-PRE-HILBERT-SPACE (J^2 = -I and antisymmetry are its laws, isometry a theorem), and the conclusion is IS-COMPLEX-INNER-PRODUCT-SPACE(CSIP-CIPS(v)) with (37) and (38). Uniqueness is csip-crip-unique: a sesquilinear form with diagonal <x,x> is (38). The converse direction (29)-(30) is cips-real-is-cphs.")
       (notes-statement "If H is a real pre-Hilbert space and J an R-linear map with properties (1)-(3) of 1.24, then H is a complex pre-Hilbert space with (a + ib) xi = a xi + b J xi and <xi|eta>_C = <xi|eta> - i<J xi|eta>, the unique complex inner product whose norm is that of H."))

(entry (doc "topological-vector-spaces")
       (ref "2.10")
       (section "2.3" prefilled)
       (kind proposition)
       (title "Two functionals with the same hyperplane are proportional")
       (names hyperplane-functionals-proportional)
       (status proven)
       (deviation "Over RR; f, g nontrivial linear functionals (IS-LINEAR-FUNCTIONAL-ON). The
   hyperplane is not a defined object: 'H is a coset of f^-1(0) and of g^-1(0)' is stated
   as: for all z, f(z) = f(x0) iff g(z) = g(y0). Conclusion: exists c in RR, c /= 0,
   for all z, f(z) = c g(z).")
       (notes-statement "If a hyperplane H is a coset of both f^-1(0) and g^-1(0) for linear functionals f, g, then f is a nonzero multiple of g."))

(entry (doc "topological-vector-spaces")
       (ref "2.11")
       (section "2.3" prefilled)
       (kind proposition)
       (title "A nontrivial functional is continuous iff its kernel is closed")
       (names functional-continuous-iff-kernel-closed tvs-closed-kernel-continuous tvs-continuous-kernel-closed)
       (status proven)
       (deviation "Real TVS (IS-TVS over RR-NORMED-FIELD); R carries the topology of |.|. 'Closed' is IS-TOP-CLOSED
   (complement open; new). Necessity holds without nontriviality.")
       (notes-statement "A nontrivial linear functional f on a topological vector space is continuous iff the hyperplane f^-1(0) is closed."))

(entry (doc "topological-vector-spaces")
       (ref "2.12")
       (section "2.3" prefilled)
       (kind proposition)
       (title "An open convex cone misses a nontrivial subspace")
       (names open-cone-misses-subspace)
       (status proven)
       (deviation "Real TVS; 'dimension >= 2' is two linearly independent vectors; 'cone' is r.C inside C for r > 0.
   Proven from 2.15 (the kernel of the positive functional), not by connectedness of E \\ {0}.")
       (notes-statement "In a real TVS of dimension >= 2, an open convex cone C /= E is disjoint from some nontrivial linear subspace."))

(entry (doc "topological-vector-spaces")
       (ref "2.13")
       (section "2.3" prefilled)
       (kind proposition)
       (title "Geometric Hahn-Banach: a closed hyperplane through F missing an open convex set")
       (names closed-hyperplane-through-subspace)
       (status proven)
       (deviation "Real TVS; the hyperplane is FKER(m, g) for a continuous nontrivial linear g. A NONEMPTY is assumed
   (A = empty, F = E is a counterexample to the statement as written). Proven from 2.15 applied to A + F, not by Zorn
   and closure.")
       (notes-statement "If A /= E is open convex and disjoint from the subspace F, there is a closed hyperplane H containing F and disjoint from A."))

(entry (doc "topological-vector-spaces")
       (ref "2.14")
       (section "2.3" prefilled)
       (kind corollary)
       (title "Extension of a functional positive on an open convex set")
       (names extend-positive-functional positive-functional-vanishing-on-subspace)
       (status proven)
       (deviation "Real TVS. FALSE as written: E = R^2, F = x-axis, f(x,0) = x, A = {y > 0} has A meet F empty and no
   positive extension. Proven with A meet F nonempty (extend-positive-functional; continuity of f not needed) and,
   for f = 0, with A and F disjoint (positive-functional-vanishing-on-subspace). Route through 2.13 and the kernel
   of a rescaled functional; the notes' rescaling step fails when H contains F.")
       (notes-statement "If A is nonempty open convex, F a subspace and f continuous linear on F strictly positive on A meet F, then f extends to a continuous linear g on E strictly positive on A."))

(entry (doc "topological-vector-spaces")
       (ref "2.15")
       (section "2.3" prefilled)
       (kind corollary)
       (title "A functional strictly positive on an open convex set missing 0")
       (names open-convex-positive-functional)
       (status proven)
       (deviation "Real TVS; A nonempty is stated. Proven by the gauge of A - x0 and the sublinear Hahn-Banach,
   not as the case F = {0} of 2.14.")
       (notes-statement "If A is nonempty open convex and 0 is not in A, some continuous linear functional is strictly positive on A."))

(entry (doc "topological-vector-spaces")
       (ref "2.29")
       (section "2.3" prefilled)
       (kind proposition)
       (title "The Minkowski functional of a symmetric absorbing convex set is a seminorm")
       (names minkowski-functional-is-seminorm mink-inf-subadditive mink-inf-homogeneous)
       (status proven)
       (deviation "A real vector space is a module m with SCAL m the ring view of RR-NORMED-FIELD. New
   vocabulary: IS-ABSORBING-SUBSET, IS-SYMMETRIC-SUBSET (V = -V read as (-1).V in V), MINK-SET,
   MINKOWSKI-FUNCTIONAL (INF of MINK-SET, INF from RA-BASICS); convexity is IS-CONVEX-SUBSET. Proof by
   greatest-lower-bound steps instead of epsilons.")
       (notes-statement "If V is symmetric, absorbing and convex in a real vector space, its Minkowski functional p_V is a seminorm."))

(entry (doc "topological-vector-spaces")
       (ref "2.33")
       (section "2.4" prefilled)
       (kind proposition)
       (title "Hahn-Banach: extension dominated by a seminorm")
       (names hahn-banach-seminorm hahn-banach-seminorm-rr)
       (home-elsewhere hahn-banach-seminorm hahn-banach-seminorm-rr)
       (status proven)
       (deviation "Stated over RR or CC (the notes: real vector space), with f K-linear on a submodule s and |f| <= p on s; the extension is K-linear on the whole module with |ff| <= p.")
       (notes-statement "If p is a seminorm on a real vector space E and f a linear functional on a subspace V with |f(x)| <= p(x), then f extends to E with |f~(x)| <= p(x) for all x."))

(entry (doc "topological-vector-spaces")
       (ref "2.35")
       (section "2.4" prefilled)
       (kind proposition)
       (title "The strict epigraph of a continuous convex functional is open convex")
       (names strict-epigraph-open-convex prod-is-tvs)
       (status proven)
       (deviation "E x R is PROD-RMOD(m) with the box topology PROD-TOP(t) (new definitions; prod-is-tvs proves it a TVS).
   p is IS-CONVEX-FUNCTIONAL (Def 2.34) and continuous into R with |.|. Openness by boxes over a preimage of a
   half-line, not through the map (x, r) |-> (p x, r) into R x R.")
       (notes-statement "If p is a continuous convex functional on a TVS E, {(x, r) in E x R : p(x) < r} is open and convex."))

(entry (doc "topological-vector-spaces")
       (ref "2.36")
       (section "2.4" prefilled)
       (kind corollary)
       (title "Hahn-Banach for a convex dominating functional")
       (names hahn-banach-convex homog-minorant-sublinear)
       (status proven)
       (deviation "Real vector space as a module over the ring view. Convex functional: IS-CONVEX-FUNCTIONAL (Def 2.34,
   new). Proven from the sublinear Hahn-Banach applied to the positively homogeneous minorant
   inf_{t>0} p(tx)/t (HOMOG-MINORANT, new), not through 2.35 and 2.14.")
       (notes-statement "If p is a convex functional on E and f is linear on a subspace F with f <= p there, then f extends to a linear functional on E bounded by p."))

(entry (doc "topological-vector-spaces")
       (ref "2.40")
       (section "2.5" prefilled)
       (kind proposition)
       (title "Extremal subsets: transitivity, intersections, inverse images")
       (names extremal-subset-trans extremal-subset-inter extremal-subset-preimage)
       (status proven)
       (deviation "Vector spaces whose scalar structure is the RR view. Intersections: of a
   family cf in FUN(ix, POWER(VEC v)) of extremal subsets, as a SEP over VEC v, with the
   intersection assumed nonempty. Inverse image under IS-LINEAR-MAP m1 m2 f, preimage
   assumed nonempty and the domain set convex.")
       (notes-statement "Extremal subsets are transitive (C extremal in B, B in A gives C in A), closed under nonempty intersections, and pulled back by linear maps."))

(entry (doc "topological-vector-spaces")
       (ref "3.27")
       (section "3.3" prefilled)
       (kind corollary)
       (title "Banach-Alaoglu (locally convex form)")
       (names banach-alaoglu)
       (status proven)
       (deviation "IS-TVS(RR-NORMED-FIELD, m, t), V subset VEC m, V contains an open neighbourhood of 0 implies IS-COMPACT-T(SUBSPACE-TOP(WEAK-STAR-TOP(m, t), POLAR(m, t, V))). The notes state it for a locally convex E; local convexity is not used, so this is the general real TVS form.")
       (notes-statement "If V is a neighbourhood of 0 in a locally convex space, V^o is w<E*, E> compact."))

(entry (doc "topological-vector-spaces")
       (ref "3.29")
       (section "3.4" prefilled)
       (kind proposition)
       (title "Banach-Alaoglu for normed spaces")
       (names dual-unit-ball-weak-star-compact)
       (status proven)
       (deviation "IS-NORMED-VECTOR-SPACE(m) implies IS-COMPACT-T(SUBSPACE-TOP(DUAL-WEAK-STAR-TOP(m), DUAL-UNIT-BALL(m))). Proven directly from the engine pointwise-bounded-closed-compact, not through 3.27.")
       (notes-statement "The unit ball of the dual of a normed space is w<E*, E> compact."))

(entry (doc "topological-vector-spaces")
       (ref "3.31")
       (section "3.4" prefilled)
       (kind proposition)
       (title "The canonical map into the bidual is an isometry")
       (names bidual-eval-isometry bidual-eval-in-bidual bidual-eval-additive bidual-eval-homogeneous norming-functional-exists)
       (status proven)
       (deviation "Real normed spaces. iota_E(x) is BIDUAL-EVAL(m, x) = (f |-> f(x)) on DUAL-VEC(m), a vector
   of DUAL(DUAL(m)); isometry is ||iota_E(x)|| = ||x|| in DUAL(DUAL(m)), and linearity is two equations.
   The norming functional (the notes' 'Theorem 2.36') is norming-functional-exists, from the sublinear
   Hahn-Banach, with no finite-dimension hypothesis.")
       (notes-statement "For a normed space E the canonical map E -> E** is an isometry."))

(entry (doc "topological-vector-spaces")
       (ref "4.7")
       (section "4.2" prefilled)
       (kind theorem)
       (title "Open mapping theorem")
       (names open-mapping-theorem open-mapping-bounded-inverse fom-baire-approx fom-open-of-approx)
       (home-elsewhere open-mapping-theorem open-mapping-bounded-inverse)
       (status partial)
       (deviation "REWRITE-HEADS: CLOSURE, INTERIOR (the non-meager hypothesis). Proven for E and F both FRECHET structures (countable seminorm families, hence locally convex) over a nontrivially valued field, with T SURJECTIVE instead of 'range non-meager'; the conclusion 'F is metrizable' and the case F an arbitrary TVS / E a non-locally-convex complete metrizable TVS are missing.")
       (notes-statement "If E is a complete metrizable TVS, F any TVS and phi : E -> F continuous linear with non-meager range, then phi is open and surjective and F is metrizable."))

(entry (doc "topological-vector-spaces")
       (ref "4.9")
       (section "4.3" prefilled)
       (kind theorem)
       (title "Closed graph theorem")
       (names closed-graph-theorem fbs-graph-frechet)
       (home-elsewhere closed-graph-theorem)
       (status partial)
       (deviation "Proven for E and F FRECHET structures (countable seminorm families: locally convex) over a nontrivially valued field; HAS-CLOSED-GRAPH is sequential (equivalent in the metric case). The notes' complete metrizable TVS need not be locally convex: that generality is missing with the TVS structure.")
       (notes-statement "If E, F are complete metrizable TVS, a linear map phi : E -> F is continuous iff its graph is closed in E x F."))

(entry (doc "topological-vector-spaces")
       (ref "4.15")
       (section "4.4" prefilled)
       (kind theorem)
       (title "Uniform boundedness theorem")
       (names frechet-banach-steinhaus fbs-baire-ball fbs-uniform-ball)
       (home-elsewhere frechet-banach-steinhaus)
       (status partial)
       (deviation "REWRITE-HEADS: CLOSURE, INTERIOR (non-meager A). Proven with E a FRECHET structure, F a countable seminorm family, and pointwise boundedness at EVERY x of E; the notes assume it only on a non-meager subset A and allow arbitrary TVS E, F.")
       (notes-statement "If E, F are TVS, S a set of continuous linear maps E -> F, and A non-meager in E with {Sx : S in S} bounded for each x in A, then S is equicontinuous."))

(entry (doc "topological-vector-spaces")
       (ref "4.20")
       (section "4.5" prefilled)
       (kind lemma)
       (title "Extension of a dominated seminorm from a subspace")
       (names seminorm-extension sxt-inf-extends sxt-inf-le-q)
       (status proven)
       (deviation "F is a real module m, E a submodule s. p is a seminorm on E as IS-SEMINORM-ON (new), q is
   IS-SEMINORM on m. The extension is SEMINORM-EXT (Eq. 113, INF from RA-BASICS); the remark on
   continuous seminorms of a locally convex F is not stated.")
       (notes-statement "If E is a subspace of F and p, q seminorms on E, F with p <= q on E, then p extends to a seminorm p~ on F with p~ <= q, given by the infimum formula."))

(entry (doc "topological-vector-spaces")
       (ref "5.2")
       (section "5.0" prefilled)
       (kind proposition)
       (title "C^k(U) is complete")
       (names cc-cont-fns-frechet cc-hol-fns-closed)
       (home-elsewhere cc-cont-fns-frechet cc-hol-fns-closed)
       (status partial)
       (deviation "Only k = 0 for U open in CC (complex-valued continuous functions, compact exhaustion seminorms; also holomorphic functions closed). C^k(U) for U open in R^n with multi-index derivatives is missing (see 1.8).")
       (notes-statement "C^k(U) with the seminorms p_{K,alpha} is complete."))

(entry (doc "topological-vector-spaces")
       (ref "5.3")
       (section "5.0" prefilled)
       (kind theorem)
       (title "Mean value theorem along a segment")
       (names dir-deriv-mvt)
       (home-elsewhere dir-deriv-mvt)
       (status proven)
       (deviation "dir-deriv-mvt is stated for f in FUN(vec(m), RR) on a normed vector space (not a function ON the open set U); its hypotheses involve only the segment (continuity of t -> f(a + t eta) on [0, 1], differentiability inside), so the notes' form follows by extending f off U. The conclusion has 0 < theta < 1 (stronger than 0 <= theta <= 1) and the derivative is a directional derivative IS-DIR-DIFF-AT; no C^1 hypothesis is needed.")
       (notes-statement "If phi is C^1 on an open U and the segment [a, a + eta] lies in U, then phi(a + eta) - phi(a) = [d_eta phi](a + theta eta) for some 0 <= theta <= 1."))

(entry (doc "topological-vector-spaces")
       (ref "A.2")
       (kind theorem)
       (title "Baire category theorem")
       (names baire-category)
       (home-elsewhere baire-category)
       (status proven)
       (deviation "baire-category adds that the space is NONEMPTY: the notes' statement is false for the empty space (the empty set is meager in itself).")
       (notes-statement "Any complete metric space is non-meager in itself."))

(entry (doc "topological-vector-spaces")
       (ref "A.4")
       (kind theorem)
       (title "The topology of a topological group is given by left-invariant pseudometrics")
       (names top-group-pseudometrics-define-topology bk-metric-pseudometric bk-metric-left-invariant bk-ball-open)
       (status proven)
       (deviation "The family is { BK-METRIC(g, vs) : IS-BK-SEQUENCE(s, g, vs) }.  Each member is a pseudometric (bk-metric-pseudometric), left invariant (bk-metric-left-invariant) and continuous: its balls are open (bk-ball-open).  The family defines the topology: for U a subset of PTS s, U is open iff every a in U lies in a ball of some member that is inside U (top-group-pseudometrics-define-topology).  No Hausdorff or countability hypothesis.")
       (notes-statement "The topology of a topological group is defined by a family of left-invariant pseudometrics."))

(entry (doc "topological-vector-spaces")
       (ref "A.5")
       (kind proposition)
       (title "Subadditive regularisation on a monoid")
       (names subadd-reg-subadditive subadd-reg-bounds gauge-product-bound-ind)
       (status proven)
       (deviation "Stated over a MONOID m (the notes say semigroup but use e).  g in FUN(CARR m, RR), g >= 0, g(e) = 0, and g((x y) z) <= 2 MAX(g x, MAX(g y, g z)).  f = SUBADD-REG(m, g, .) is the EINF of FACT-SUMS(m, g, x), the sums g(u_0) + ... + g(u_{n-1}) over the factorisations x = MPROD(m, u, n).  Proven: f(x) is real, g(x)/2 <= f(x) <= g(x), and f(x y) <= f(x) + f(y).  (139) is gauge-product-bound-ind: g(u_0 ... u_{n-1}) <= 2 (g(u_0) + ... + g(u_{n-1})).")
       (notes-statement "If g : S -> [0, inf) has g(e) = 0 and g(xyz) <= 2 max(g(x), g(y), g(z)), then f(x) = inf {sum g(x_i) : x = x1...xn} satisfies f(xy) <= f(x) + f(y) and g/2 <= f <= g."))

(entry (doc "topological-vector-spaces")
       (ref "A.6")
       (kind proposition)
       (title "Birkhoff-Kakutani metrization")
       (names birkhoff-kakutani)
       (status proven)
       (deviation "IS-TOP-GROUP(s, g) (new): a TOP-SPACE and a GROUP on the same points, with (x, y) |-> x y^-1 continuous, stated with neighbourhoods.  Hypotheses IS-HAUSDORFF(s) and HAS-COUNTABLE-NBHD-BASE(s, e) (new).  Conclusion: some metric space md with PTS md = PTS s, IS-LEFT-INVARIANT(md, g) (new, Definition A.3) and OPENS(METRIC-TOP md) = OPENS(s).  The metric is BK-METRIC: d(x, y) = f(y^-1 x) + f(x^-1 y), f the A.5 regularisation of the gauge (147).  The notes use f(y^-1 x) alone and prove f symmetric; the symmetrised sum makes the reversal-of-factorisations law unnecessary, at the cost of a factor 2 in the ball comparisons (150).")
       (notes-statement "A Hausdorff topological group with a countable neighbourhood base at the identity has a left-invariant metric defining its topology."))

(entry (doc "topological-vector-spaces")
       (ref "A.13")
       (kind theorem)
       (title "Ascoli-Arzela")
       (names ascoli-arzela-sequential ascoli-dense-bridge equicont-dense-conv-implies-unif-cauchy)
       (home-elsewhere ascoli-arzela-sequential ascoli-dense-bridge equicont-dense-conv-implies-unif-cauchy)
       (status partial)
       (deviation "REWRITE-HEADS: CLOSURE (relatively compact). Proven: for a COMPACT METRIC X, a SEQUENCE of continuous real functions that is equicontinuous and pointwise bounded has a uniformly convergent subsequence. Missing: Hausdorff X, the compact-open topology, relative compactness of a SET E of functions, and the necessity direction.")
       (notes-statement "For X Hausdorff, E in C(X) is relatively compact in the topology of uniform convergence on compacta iff E is equicontinuous at every point and pointwise bounded."))

(entry (doc "topological-vector-spaces")
       (ref "A.14")
       (kind lemma)
       (title "Pointwise limits of an equicontinuous set are equicontinuous")
       (names ptwise-limits-equicontinuous)
       (status proven)
       (deviation "Functions X -> R on a topological space; equicontinuity with < eps; pointwise limits of nets
   (PTWISE-NET-LIMITS, convergence in METRIC-TOP(RR-MS)).")
       (notes-statement "If E is an equicontinuous set of functions X -> R, the set of pointwise limits of directed families from E is equicontinuous."))

(entry (doc "topological-vector-spaces")
       (ref "A.15")
       (kind proposition)
       (title "On an equicontinuous set, pointwise and compact convergence coincide")
       (names equicontinuous-ptwise-implies-compact-unif unif-conv-on-pointwise singleton-subspace-compact)
       (status proven)
       (deviation "Stated for nets: on an equicontinuous set, a net converging pointwise to a member converges uniformly
   on every compact k (IS-COMPACT-T(SUBSPACE-TOP t k)); conversely uniform convergence on k gives convergence at each
   point of k, and points are compact. The topologies on E are not formed; Hausdorff is not needed.")
       (notes-statement "For X Hausdorff and E in C(X) equicontinuous, the topology of pointwise convergence and that of uniform convergence on compacta coincide on E."))

(entry (doc "topological-vector-spaces")
       (ref "A.16")
       (kind proposition)
       (title "C(X) is metrizable for X locally compact and sigma-compact")
       (names cc-cont-fns-frechet frm-metric-space-is-metric-space)
       (home-elsewhere cc-cont-fns-frechet)
       (status partial)
       (deviation "Proven only for X = U open in CC with complex-valued functions (compact exhaustion seminorms give a Frechet structure, whose FR-METRIC-SPACE is a metric). General locally compact sigma-compact metric X and real-valued C(X) missing.")
       (notes-statement "If X is a locally compact metric space that is a countable union of compact sets, then C(X) with uniform convergence on compacta is metrizable."))

;;; ===== galois-theory =====
;;; Added 2026-11-09 (TABLE-1): results of the Galois theory notes mapped by MAP-1026 (2026-10-26) and proven by later waves.
;;; The OUTLINE of galois-theory: chapters that hold an entry, with every section the notes have.
;;; Titles marked `prefilled' were read off the notes by pdftotext (BOOK-GEN, 2026-11-12); review
;;; and delete the mark.  Read by library-book.scm; ignored by the major-theorems list.
(outline "galois-theory"
  (title "Galois theory (Thayer, notes)" prefilled)
  (chapter "1" "Preliminaries" prefilled
    (section "1.1" "Integral Domains and Fields" prefilled)
    (section "1.2" "Polynomial Rings" prefilled)
    (section "1.3" "Base Field and Characteristic" prefilled)
    (section "1.4" "Matrices with Entries in a Euclidean Domain" prefilled)
    (section "1.5" "Normal Forms" prefilled)
    (section "1.6" "Structure of Finitely Generated Modules" prefilled)
    (section "1.7" "Endomorphisms of Vector Spaces" prefilled)
    (section "1.8" "Polynomial Equations" prefilled)
    (section "1.9" "Lagrange Interpolation" prefilled)
    (section "1.10" "Unique Factorization in Polynomial Rings" prefilled)
    (section "1.11" "Eisenstein Factorization Criterion" prefilled)
    (section "1.12" "Roots of Unity" prefilled)))

(entry (doc "galois-theory")
       (ref "1.3")
       (section "1.1" prefilled)
       (kind proposition)
       (title "Ideals of a Euclidean domain are principal")
       (names euclidean-ideal-has-generator)
       (definitions principal-ideal-membership)
       (status proven)
       (deviation "Library form: every IS-IDEAL of a euclidean ring has a generator in the ideal with all elements multiples (no 'non-trivial' hypothesis needed).")
       (notes-statement "In a Euclidean domain every non-trivial ideal is principal."))

(entry (doc "galois-theory")
       (ref "1.5")
       (section "1.1" prefilled)
       (kind corollary)
       (title "Euclid's lemma in a Euclidean domain")
       (names euclid-lemma two-element-ideal euclidean-domain-is-euclidean-ring)
