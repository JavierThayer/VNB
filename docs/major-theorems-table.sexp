       (notes-statement "A non-trivial non-archimedean valuation on Q is "))

(entry (doc "ccr")
       (ref "1.28")
       (section "1.0" prefilled)
       (kind proposition)
       (title "Z dense in Zp")
       (names ccr-1-28 qp-embed-value qp-abs-le qp-eventually-le-one)
       (status proven)
       (deviation "Q_p = QP(p), the completion of NF-METRIC-SPACE(QQ-PADIC p); Z_p = ZP(p) = NV-INTEGERS(QP-FIELD p). Stated as: every embedded integer lies in Z_p, and for a in Z_p and eps > 0 there is an integer n with d(a, embed n) < eps (the eps form of ccr-1-20). Proven 2026-10-28 (CCR-QP).")
       (notes-statement "Z is a dense subset of Zp."))

(entry (doc "ccr")
       (ref "1.29")
       (section "1.0" prefilled)
