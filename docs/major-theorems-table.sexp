       (notes-statement "Suppose mu* is a metric outer measure on (X, d) and F a closed set. E_n = {x : d(x, F) >= 1/n} is a nondecreasing sequence of closed sets such that for all A, mu*(A n (X \\ F)) = lim mu*(A n E_k)."))

(entry (doc "construction-of-measures")
