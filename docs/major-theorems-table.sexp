       (notes-statement "The characteristic polynomial of the companion matrix of p is p."))

(entry (doc "galois-theory")
       (ref "1.43")
       (section "1.8" prefilled)
       (kind proposition)
       (title "alpha is a root iff x-alpha divides p")
       (names poly-root-iff-x-minus-divides)
       (status proven)
       (deviation "Proven 2026-10-27 (CA-TOOLS); see scratchpad/triage/CA-TOOLS-REPORT.md.")
       (notes-statement "alpha in F is a root of p iff x - alpha divides p(x)."))

(entry (doc "galois-theory")
       (ref "1.45")
       (section "1.8" prefilled)
       (kind corollary)
       (title "A degree n polynomial has at most n roots")
       (names poly-roots-at-most-degree)
       (status proven)
       (deviation "Distinct roots al(1..m) of p /= 0 give m <= deg p.")
       (notes-statement "In any field a polynomial of degree n has at most n roots."))

(entry (doc "galois-theory")
       (ref "1.46")
       (section "1.8" prefilled)
       (kind corollary)
       (title "Polynomial of degree < card F vanishing on F is zero")
       (names poly-vanishing-iff-zero)
       (status proven)
       (deviation "'deg p < card F' is stated as an injection [1, deg p + 1] -> F.")
       (notes-statement "If deg p < card F then the polynomial function of p is identically 0 iff all coefficients are 0."))

(entry (doc "galois-theory")
       (ref "1.47")
       (section "1.9" prefilled)
       (kind proposition)
       (title "Evaluation at n points is bijective on degree < n polynomials iff the points are distinct")
       (names eval-at-points-bijective-iff-distinct poly-interpolation-exists poly-interpolation-unique)
       (status proven)
       (deviation "E : F[x]_m -> F^(m+1) is a bijection iff the th(i) are pairwise distinct. The notes' n is m + 1.")
       (notes-statement "E: p -> (p(theta_1),...,p(theta_n)) is a bijection F[x]_{n-1} -> F^n iff the theta_i are pairwise distinct."))

(entry (doc "galois-theory")
       (ref "1.48")
       (section "1.9" prefilled)
       (kind corollary)
       (title "Polynomials over an infinite field are determined by their functions")
       (names poly-determined-by-values)
       (status proven)
       (deviation "'Infinite' is stated as CARD(CARR F) not in NN.")
       (notes-statement "For F infinite, p = q iff p(theta) = q(theta) for all theta in F."))

(entry (doc "galois-theory")
       (ref "1.49")
       (section "1.9" prefilled)
       (kind corollary)
       (title "Functions on a finite field are polynomials")
       (names finite-field-maps-are-polynomials)
       (status proven)
       (deviation "If card F = m + 1, then p |-> (t |-> p(t)) is a bijection F[x]_m -> FUN(F, F). Its linearity is poly-eval-add plus poly-eval-monomial-mul. The notes' map is its inverse.")
       (notes-statement "For F of finite cardinality n there is a bijective linear map from F^F onto F[x]_{n-1}."))

(entry (doc "galois-theory")
       (ref "1.64")
       (section "1.12" prefilled)
       (kind proposition)
       (title "x^d = 1 has at most d roots; finite multiplicative group of a field is cyclic")
       (names unity-roots-at-most-d)
       (status partial)
       (deviation "First sentence only: distinct al(1..m) with al(i)^d = 1 and d >= 1 give m <= d. Cyclicity of the finite multiplicative group is not proven.")
       (notes-statement "In a field x^d = 1 has at most d roots; if F is finite then F^x is cyclic."))

