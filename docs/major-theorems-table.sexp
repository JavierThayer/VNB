;;; ===== ch. 2 section 1: Partial Isometries =====
(entry (doc "banach-algebras")
       (ref "2.1")
       (section "2.1" prefilled)
       (kind proposition)
       (title "Four characterizations of a partial isometry")
       (names partial-isometry-iff-adjoint-square-projection adjoint-square-projection-iff adjoint-partial-isometry-iff)
       (status proven)
       (deviation "Stated as three IFFs, (1)<=>(2), (1)<=>(3), (3)<=>(4); (2)<=>(4) is their chain. (2) and (4) read IS-PARTIAL-ISOMETRY of U and of U*, U in BOUNDED-OPS(v, v), v a Hilbert space; (1) and (3) read IS-PROJECTION-OP of U*U and of UU*.")
       (notes-statement "For U in L(H) equivalent: (1) U*U is a projection; (2) U is isometric on some closed K and 0 on K-perp; (3) U U* is a projection; (4) U* is isometric on some closed J and 0 on J-perp."))

(entry (doc "banach-algebras")
