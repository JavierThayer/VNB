(entry (doc "complex-analysis")
       (ref "5.1")
       (section "5.1" prefilled)
       (kind lemma)
       (title "An exhaustive sequence of compact sets")
       (names locally-compact-separable-exhaustion cc-open-has-compact-exhaustion cc-has-compact-exhaustion cc-exhaust-is-compact-exhaustion cc-exhaust-exhaustive cc-exhaust-compact cc-exhaust-covers)
       (status proven)
       (deviation "PROVEN 2026-10-26 as the notes state it: a separable (IS-SEPARABLE, a dense sequence) locally compact (IS-LOCALLY-COMPACT: every point has a compact closed ball of positive radius) metric space has a sequence K_n with IS-COMPACT-EXHAUSTION. For CC and its open subsets (a point of u is required, because an empty space has no dense sequence) the general theorem specialises (cc-open-has-compact-exhaustion), and the explicit K_n = CC-EXHAUST(u, n) is itself such an exhaustion (cc-exhaust-is-compact-exhaustion).")
       (notes-statement "For any separable locally compact metric space X, there is a sequence {K_n} such that every compact subset A of X is a subset of some K_n."))

(entry (doc "complex-analysis")
       (ref "5.2")
       (section "5.1" prefilled)
       (kind proposition)
       (title "C(U) is a Frechet space for uniform convergence on compacta")
       (names cc-cont-fns-frechet cc-fn-module-is-module cc-exhaust-seminorms-family cc-exhaust-uniform-iff-compacta cc-fr-conv-iff-unif-on-compacta)
       (status proven)
       (deviation "PROVEN 2026-10-14 for an open u in CC: IS-FRECHET-STRUCTURE(CC-NORMED-FIELD, CC-FN-MODULE(u, CC-CONT-FNS(u)), CC-EXHAUST-SEMINORMS(u, CC-CONT-FNS(u))), the seminorms p_n(f) = sup of |f| on K_n. The metric of the notes is the library's FR-METRIC-SPACE of a countable seminorm family (TVS-1), and convergence in it is exactly UNIF-ON-COMPACTA (cc-fr-conv-iff-unif-on-compacta), which is the topology statement in the form of convergent sequences.")
       (notes-statement "Suppose {K_n} is an exhaustive sequence of compact subsets of X. Then d(f, g) = sum_n 2^(-n) min(p_{K_n}(f - g), 1) is a metric on C(X) whose corresponding topology is the topology of uniform convergence on compact subsets of X."))

(entry (doc "complex-analysis")
       (ref "5.3")
       (section "5.1" prefilled)
       (kind proposition)
       (title "H(U) is closed in C(U)")
       (names cc-hol-fns-closed cc-hol-fns-subset-cont)
       (status proven)
       (deviation "PROVEN 2026-10-14 in SEQUENCE form (the user's decision of 2026-10-14): a sequence in H(u) converging in the Frechet structure of C(u) to f in C(u) has f in H(u). C(u) is metrizable, so this is closedness; no topology layer states it as a closed set.")
       (notes-statement "H(U) is closed in C(U)."))

(entry (doc "complex-analysis")
       (ref "5.7")
       (section "5.2" prefilled)
       (kind theorem)
       (title "Montel: bounded closed subsets of H(U) are compact")
       (names cc-montel cc-montel-subsequence cc-montel-tail cc-pointwise-diagonal)
       (status partial)
       (deviation "PROVEN 2026-10-14 in SEQUENCE form (the user's decision of 2026-10-14): u open, s in FUN(NN, H(u)) with CC-HOL-BOUNDED(u, IMAGE(s, NN)) has a strictly monotone phi and g in H(u) with UNIF-ON-COMPACTA(u, SUBSEQ(s, phi), g). The set form needs compactness relative to a seminorm family, which the library does not have. The route avoids Tychonoff (5.15): the diagonal step is ascoli-pointwise-diagonal, the uniform step equicont-dense-conv-implies-unif-cauchy. Corollary 5.19 is not stated.")
       (notes-statement "Any bounded closed subset of H(U) is compact."))

(entry (doc "complex-analysis")
       (ref "5.8")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Bounded subsets of H(U) are equicontinuous")
       (names cc-hol-bounded-equicontinuous cc-holomorphic-deriv-estimate cc-holomorphic-lipschitz-at-centre)
       (status proven)
       (deviation "PROVEN 2026-10-14: CC-HOL-BOUNDED(u, a) (a subset of H(u), with a bound M_n on every K_n) gives equicontinuity of a at every point of u. The proof uses Cauchy's estimate on a disc, not the integral over a triangle (3.41) of the notes.")
       (notes-statement "If A is a bounded subset of H(U) then A is equicontinuous at every point of U."))

(entry (doc "complex-analysis")
       (ref "5.10")
       (section "5.2" prefilled)
       (kind theorem)
       (title "Ascoli-Arzela")
       (names ascoli-arzela-sequential cc-montel)
       (home-elsewhere ascoli-arzela-sequential cc-montel)
       (status partial)
       (deviation "ascoli-arzela-sequential: X compact, real-valued sequences, equicontinuous and pointwise bounded => uniformly convergent subsequence (sufficiency only). Missing: separable locally compact X, complex values, uniform convergence on compacta, and necessity. cc-montel is the holomorphic instance on an open U in C.")
       (notes-statement "If X is a separable locally compact metric space, a set E in C(X) is relatively compact for uniform convergence on compacta iff it is equicontinuous at every point and pointwise bounded."))

(entry (doc "complex-analysis")
       (ref "5.13")
       (section "5.2" prefilled)
       (kind lemma)
       (title "Equicontinuous sequence converging on a dense set converges everywhere")
       (names equicont-dense-conv-ptwise-cauchy cc-unif-cauchy-on-compact ascoli-dense-bridge)
       (home-elsewhere equicont-dense-conv-ptwise-cauchy ascoli-dense-bridge)
       (status partial)
       (deviation "equicont-dense-conv-ptwise-cauchy is the real-valued pointwise-Cauchy half on any metric space; cc-unif-cauchy-on-compact is the complex version on a compact subset of C; continuity of the limit is only for compact X (ascoli-dense-bridge). The general complex-valued statement is missing.")
       (notes-statement "If f_k : X -> C is an equicontinuous sequence converging on a dense set D, it converges at every x in X and the limit is continuous."))

(entry (doc "complex-analysis")
       (ref "5.14")
