(entry (doc "construction-of-measures")
       (ref "2.31")
       (section "2.6" prefilled)
       (kind proposition)
       (title "L^infinity is the dual of L^1")
       (names linf-is-l1-dual l1-pairing-bounded l1-pairing-norm-bound l1-dual-onto)
