(entry (doc "construction-of-measures")
       (ref "4.23")
       (section "4.2" prefilled)
       (kind proposition)
       (title "The method-II outer measure is a metric outer measure")
       (names method-ii-metric-outer-measure method-ii-outer-measure method-ii-delta-outer method-ii-delta-separated)
       (status proven)
       (deviation "METHOD-II(m, C, p) is defined as the ESUP over delta > 0 of the method-I outer measures on C_delta = {A in C : DIAM(A) <= delta}, which equals the notes' limit since the family is antitone in delta (method-ii-delta-antitone); p is any premeasure (IS-PREMEASURE) on a class C of subsets of PTS(m). DIAM(m, A) is new: the ESUP of the distances in A, so DIAM(EMPTY-SET) = 0.")
       (notes-statement "The method-II outer measure mu*_0 = lim_{delta -> 0} mu*_delta is a metric outer measure: d(E, F) > 0 implies mu*_0(E u F) = mu*_0(E) + mu*_0(F)."))

(entry (doc "construction-of-measures")
