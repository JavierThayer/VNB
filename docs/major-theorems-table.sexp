(entry (doc "construction-of-measures")
       (ref "1.2")
       (section "1.1" prefilled)
       (kind proposition)
       (title "The atoms of a finite algebra of sets")
       (names finite-algebra-atoms algebra-point-atom atoms-pairwise-disjoint algebra-atom-decomposition)
       (status proven)
       (deviation "IS-ATOM / ATOMS defined (measure-ch1-vocab.scm). Finite read as CARD(cA) in NN. The atom of a point (the meet of the members containing it) replaces the notes' choice of a minimal element.")
       (notes-statement "For an algebra A of subsets of X with finitely many elements, the minimal non-empty elements of A are finitely many, pairwise disjoint, and every A in A is the union of the atoms it contains."))

(entry (doc "construction-of-measures")
       (ref "1.4")
       (section "1.1" prefilled)
       (kind proposition)
       (title "Finite unions of a semi-algebra form an algebra")
       (names finite-unions-algebra)
       (status proven)
       (deviation "FINITE-UNIONS(omega, cI) defined (unions of finite subfamilies). The family is assumed non-empty, which the notes leave implicit (an empty family gives {EMPTY-SET}).")
       (notes-statement "If I is a family of subsets of X closed under finite intersections such that the complement of any member is a finite union of members, then the finite unions of members of I form an algebra."))

(entry (doc "construction-of-measures")
       (ref "1.6")
       (section "1.1" prefilled)
       (kind corollary)
       (title "Finite unions of rectangles in R^n form an algebra")
       (names rn-rectangles-finite-unions-algebra rn-rectangles-inter-closed rn-rectangle-complement-finite-union)
       (status proven)
       (deviation "R^n is FUN(INTERVAL(1, n), RR) (rn-vocab). IS-INTERVAL (order-convex subset of R), RN-BOX and RN-RECTANGLES defined. Remark 1.5 proven as the two lemmas named.")
       (notes-statement "Finite unions of rectangles (cartesian products of intervals) in R^n form an algebra."))

(entry (doc "construction-of-measures")
       (ref "1.11")
       (section "1.1" prefilled)
       (kind proposition)
       (title "An algebra closed under monotone unions is a sigma-algebra")
       (names algebra-monotone-union-sigma-algebra)
       (status proven)
       (deviation "As the notes state it; a monotone sequence is f in FUN(NN, cA) with f(n) a subset of f(n+1).")
       (notes-statement "An algebra of subsets which is closed under countable monotone unions is a sigma-algebra."))

(entry (doc "construction-of-measures")
       (ref "1.13")
       (section "1.1" prefilled)
       (kind theorem)
       (title "The monotone class theorem")
       (names monotone-class-theorem algebra-monotone-union-sigma-algebra)
       (home-elsewhere algebra-monotone-union-sigma-algebra)
       (status proven)
       (deviation "IS-MONOTONE-CLASS carries omega in SET, as IS-SIGMA-ALGEBRA does; the binary intersection the algebra needs comes by De Morgan, which the notes skip.")
       (notes-statement "If M is a monotone class which contains the algebra A, then M contains the smallest sigma-algebra containing A."))

(entry (doc "construction-of-measures")
       (ref "1.14")
       (section "1.1" prefilled)
       (kind proposition)
       (title "The pullback sigma-algebra")
       (names pullback-sigma-algebra pullback-sigma-is-sigma-algebra pullback-sigma-measurable pullback-sigma-smallest)
       (status proven)
       (deviation "PULLBACK-SIGMA(omega, cB, f) = {f^-1(b) : b in cB} defined.")
       (notes-statement "If (Y, B) is a measurable space and f : X -> Y any map, then {f^-1(B) : B in B} is a sigma-algebra on X, the smallest for which f is measurable."))

(entry (doc "construction-of-measures")
       (ref "1.17")
       (section "1.1" prefilled)
       (kind proposition)
       (title "Continuity of a measure from below")
       (names measure-continuity-from-below)
       (status proven)
       (deviation "The supremum over k is the ESUP of the values; a nondecreasing sequence is f in FUN(NN, cA) with f(k) a subset of f(k+1).")
       (notes-statement "Suppose mu is a countably additive measure on the sigma-algebra A. If A_k is a nondecreasing sequence of elements of A, then mu(union of the A_k) = sup_k mu(A_k)."))

(entry (doc "construction-of-measures")
       (ref "1.18")
       (section "1.1" prefilled)
       (kind proposition)
       (title "Continuity of a measure from above")
       (names measure-continuity-from-above)
       (status proven)
       (deviation "As the notes state it, with mu(A_1) finite written mu(A_1) in RR.")
       (notes-statement "Suppose mu is a countably additive measure on A. If A_k is a nonincreasing sequence of elements of A and mu(A_1) < infinity, then mu(intersection of the A_k) = inf_k mu(A_k)."))

(entry (doc "construction-of-measures")
       (ref "1.19")
       (section "1.1" prefilled)
       (kind proposition)
       (title "The push-forward of a measure is a measure")
       (names measure-pushforward pfw-push-forward-measure)
       (status proven)
       (deviation "As the notes state it; pfw-push-forward-measure names the measure PUSH-FORWARD(omega, cB, mu, f).")
       (notes-statement "If f : (X, A) -> (Y, B) is measurable and mu is a countably additive measure on (X, A), then B |-> mu(f^-1(B)) is a countably additive measure on (Y, B)."))

(entry (doc "construction-of-measures")
       (ref "1.22")
       (section "1.1" prefilled)
       (kind proposition)
       (title "Pulling a measure back along a surjection")
       (names pullback-measure-exists-unique pullback-measure-is-measure pullback-measure-value pullback-measure-unique)
       (status proven)
       (deviation "PULLBACK-MEASURE(omega, cB, f, nu) = a |-> nu(f(a)) defined (for f onto, f(f^-1(b)) = b). Uniqueness among measures on the pullback.")
       (notes-statement "If f : X -> Y is surjective and nu is a countably additive measure on the sigma-algebra B of Y, there is a unique measure mu on the pullback {f^-1(B)} with mu(f^-1(B)) = nu(B)."))

(entry (doc "construction-of-measures")
       (ref "1.23")
       (section "1.1" prefilled)
       (kind proposition)
       (title "No translation-invariant measure on all subsets of R (Vitali)")
       (names vitali-no-invariant-measure vitali-null-case vitali-positive-case)
       (status proven)
       (deviation "The proof runs the equivalence on D = {d : (c+1)d = a-b, a,b,c in NN} (= Q), defined from NN; Q itself would serve equally. The statement does not mention Q.")
       (notes-statement "There is no translation-invariant countably additive measure mu defined on all subsets of R with 0 < mu([0,1]) < infinity."))

(entry (doc "construction-of-measures")
       (ref "2.3")
       (section "2.1" prefilled)
       (kind proposition)
       (title "Pointwise limits of measurable functions into a separable metric space")
       (names measurable-map-ptwise-limit)
       (status proven)
       (deviation "stated for any metric space (separability not needed)")
       (notes-statement "If (Y, d) is a separable metric space and a sequence of measurable functions X -> Y converges pointwise, the limit is measurable."))

(entry (doc "construction-of-measures")
       (ref "2.5")
       (section "2.1" prefilled)
       (kind proposition)
       (title "Measurable functions into a separable metric space are uniform limits of step functions")
       (names step-map-approximation step-map-uniform-limit)
       (status proven)
       (deviation "uniform limit stated as d(f, g_n) < 1/(n+1) everywhere")
       (notes-statement "If (Y, d) is a separable metric space, every measurable f : X -> Y is the uniform limit of a sequence of step functions."))

(entry (doc "construction-of-measures")
       (ref "2.6")
       (section "2.1" prefilled)
       (kind proposition)
       (title "phi(f, g) is measurable for continuous phi")
       (names measurable-continuous-combination)
       (status proven)
       (deviation "IS-SEPARABLE(Y) added: the notes' proof needs Borel(Y x Y) = product sigma-algebra")
       (notes-statement "If f, g : X -> Y are measurable and phi : Y x Y -> Y is continuous, then x |-> phi(f(x), g(x)) is measurable."))

(entry (doc "construction-of-measures")
       (ref "2.7")
       (section "2.2" prefilled)
       (kind theorem)
       (title "Existence and uniqueness of the integral of non-negative functions")
       (names integral-unique integral-unique-simple)
       (status proven)
       (deviation "Proven 2026-10-29 (M-D); see scratchpad/triage/M-D-REPORT.md.")
       (notes-statement "There is a unique map f |-> integral of f d mu on measurable f : X -> [0, infinity] with values in [0, infinity], integral of 1_A = mu(A), integral of infinity * 1_A = 0 on null A, additive, positively homogeneous, monotone, and with monotone convergence."))

(entry (doc "construction-of-measures")
       (ref "2.9")
       (section "2.2" prefilled)
       (kind proposition)
       (title "Conull sets are closed under countable intersections and supersets")
       (names conull-countable-inter conull-superset null-countable-union)
       (status proven)
       (deviation "Conull is IS-CONULL (A in cA, mu(X \\ A) = 0). The countable intersection is written COMPLEMENT-IN(omega, U_n COMPLEMENT-IN(omega, f(n))) for f in FUN(NN, cA). The superset is taken in cA. Also: a countable union of null sets is null.")
       (notes-statement "Conull sets are closed under countable intersections, and a superset of a conull set is conull."))

(entry (doc "construction-of-measures")
       (ref "2.10")
       (section "2.2" prefilled)
       (kind proposition)
       (title "Functions equal almost everywhere have the same integral")
       (names integral-ae-eq integral-le-off-null)
       (status proven)
       (deviation "The conull set is written as the complement of a measurable null set NB; f and g measurable into [0, infinity].")
       (notes-statement "If f, g : X -> [0, infinity] are measurable and {f = g} is conull, then integral of f = integral of g."))

(entry (doc "construction-of-measures")
       (ref "2.13")
       (section "2.2" prefilled)
       (kind proposition)
       (title "Monotone approximation by step functions")
       (names integral-simple-approx)
       (status proven)
       (deviation "Step functions are IS-SIMPLE-FN; convergence is stated as PTWISE-SUP of the nondecreasing sequence equal to f.")
       (notes-statement "Every measurable f : X -> [0, infinity] is the pointwise limit of a nondecreasing sequence of step functions."))

(entry (doc "construction-of-measures")
       (ref "2.15")
       (section "2.2" prefilled)
       (kind proposition)
       (title "The integral does not depend on the approximating sequence")
       (names monotone-convergence integral-simple integral-sup-of-simple)
       (status proven)
       (deviation "The library defines INTEGRAL as a sup over simple functions below f, so no well-definedness lemma is stated; both limits equal integral(f) by monotone-convergence and integral-simple, one citation per side.")
       (notes-statement "If f_n and f'_n are nondecreasing sequences of bounded step functions converging pointwise to f, then lim integral f_n = lim integral f'_n."))

(entry (doc "construction-of-measures")
       (ref "2.16")
       (section "2.2" prefilled)
       (kind proposition)
       (title "The monotone convergence theorem")
       (names monotone-convergence)
       (home-elsewhere monotone-convergence)
       (status proven)
       (deviation "For [0, +inf]-valued measurable functions, the integral defined as the supremum over simple functions below; the limit of the integrals is their ESUP (the sequence of integrals is nondecreasing).")
       (notes-statement "Suppose f_k is a nondecreasing sequence of nonnegative measurable functions with f_k increasing to f. Then f is measurable and the integral of f is the limit of the integrals of the f_k."))

(entry (doc "construction-of-measures")
       (ref "2.17")
       (section "2.3" prefilled)
       (kind proposition)
       (title "Hoelder's inequality")
       (names hoelder young-extended)
       (status proven)
       (deviation "For [0, +inf]-valued f, g with 0 * inf = 0. The infinite case, unmentioned in the notes, needs the zero case first; I_p(f) = 0 implies f = 0 a.e. (asserted in the notes) is proven by Markov's inequality (ep-norm-zero-null).")
       (notes-statement "If f, g are measurable functions X -> [0, inf] and p, q are conjugate, the integral of f g is at most (integral of f^p)^(1/p) (integral of g^q)^(1/q)."))

(entry (doc "construction-of-measures")
       (ref "2.18")
       (section "2.3" prefilled)
       (kind lemma)
       (title "Young's inequality")
       (names young-extended young-scaled)
       (home-elsewhere young-extended)
       (status proven)
       (deviation "Stated on [0, infinity] with ETIMES / EPOW (young-extended); for a, b real it is the special case.")
       (notes-statement "If a, b >= 0 and p, q are conjugate exponents, then ab <= a^p/p + b^q/q."))

(entry (doc "construction-of-measures")
       (ref "2.19")
       (section "2.3" prefilled)
       (kind proposition)
       (title "Minkowski's inequality")
       (names minkowski)
       (status proven)
       (deviation "The notes divide by I_p(f + g)^(p/q), which says nothing when I_p(f + g) = inf; finiteness is proven from (u + v)^p <= 2^p (u^p + v^p) (epow-eplus-le).")
       (notes-statement "If 1 <= p < inf and f, g : X -> [0, inf] are measurable, (integral of (f + g)^p)^(1/p) <= (integral of f^p)^(1/p) + (integral of g^p)^(1/p)."))

(entry (doc "construction-of-measures")
       (ref "2.21")
       (section "2.4" prefilled)
       (kind proposition)
       (title "Functions equal almost everywhere have the same integral")
       (names integral-ae-eq rintegral-ae-eq)
       (home-elsewhere integral-ae-eq)
       (status proven)
       (deviation "Functions are total on X; 'almost everywhere' is a clause 'except on a null set' (the user's decision, 2026-10-09). For a real f the hypothesis f >= 0 a.e. is not needed.")
       (notes-statement "If f = g almost everywhere and f >= 0 almost everywhere, then the integral of f equals the integral of g."))

(entry (doc "construction-of-measures")
       (ref "2.22")
       (section "2.4" prefilled-inferred)
       (kind theorem)
       (title "The L^p seminorm")
       (names lp-norm-triangle lp-norm-homogeneous lp-norm-zero-iff)
       (status proven)
       (deviation "No quotient by null functions (the user's decision): L^p is seminormed, with ||f - g||_p = 0 iff f = g except on a null set. L^infinity and the vector-space claim are not yet stated.")
       (notes-statement "For 1 <= p < inf, the classes of measurable f with |f|^p integrable form a vector space with the norm ||f||_p = (integral of |f|^p)^(1/p)."))

(entry (doc "construction-of-measures")
       (ref "2.23")
       (section "2.4" prefilled)
       (kind proposition)
       (title "A function with finite integral is finite almost everywhere")
       (names integral-finite-ae-finite)
       (status proven)
       (notes-statement "If f : X -> [0, inf] is measurable with finite integral, then f(x) < inf almost everywhere."))

(entry (doc "construction-of-measures")
       (ref "2.24")
       (section "2.4" prefilled)
       (kind proposition)
       (title "A function with nonnegative integral over every measurable set is nonnegative almost everywhere")
       (names rintegral-nonneg-on-sets-null rintegral-decomposition)
       (status proven)
       (deviation "The integral of a real function is RINTEGRAL, the integral of f+ minus that of f- (2026-10-10). The proof uses monotonicity of the real integral and the integral over a set, neither stated in the notes before it.")
       (notes-statement "If f is integrable and the integral of f over A is >= 0 for every measurable A, then f >= 0 almost everywhere."))

(entry (doc "construction-of-measures")
       (ref "2.26")
       (section "2.5" prefilled)
       (kind theorem)
       (title "Fatou's lemma")
       (names fatou measurable-fn-liminf)
       (status proven)
       (deviation "The library states liminf f_n = g everywhere and g measurable for A; the notes allow equality almost everywhere and measurability for the completion. The a.e. form is one citation of integral-ae-eq once g is A-measurable.")
       (notes-statement "If f_n : X -> [0, infinity] are measurable and liminf f_n = g almost everywhere, then g is measurable and integral g <= liminf integral f_n."))

(entry (doc "construction-of-measures")
       (ref "2.28")
       (section "2.5" prefilled)
       (kind proposition)
       (title "The dominated convergence theorem")
       (names dominated-convergence fatou)
       (home-elsewhere fatou)
       (status proven)
       (deviation "Proven in the [0, +inf]-valued form the tree's integral has (no real- or complex-valued integrable functions yet) and everywhere rather than almost everywhere; Fatou's lemma beside it.")
       (notes-statement "Suppose f_k is a sequence of measurable functions with |f_k(x)| <= g(x) for almost all x, g integrable. If f_k(x) tends to f(x) for almost all x, then f is integrable and the integrals of the f_k tend to the integral of f."))

(entry (doc "construction-of-measures")
       (ref "2.29")
       (section "2.5" prefilled)
       (kind corollary)
       (title "Dominated convergence in L^p")
       (names lp-dominated-convergence)
