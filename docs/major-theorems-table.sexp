(entry (doc "construction-of-measures")
       (ref "4.38")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Comparison of Hausdorff measures for a doubling function")
       (names hausdorff-phi-compare doubling-scale doubling-power)
       (status proven)
       (deviation "Proven for every subset E, not only Borel E. A doubling function is IS-DOUBLING(phi): phi in FUN(NNREAL, NNREAL), nondecreasing, phi(0) = 0, phi(2r) <= alpha phi(r) for r > 0; H^phi is HAUSDORFF-PHI, method II on PHI-PM(A) = phi(DIAM(A)) (POS-INF when DIAM(A) = POS-INF). Remark 4.37 is doubling-scale.")
       (notes-statement "If phi is doubling and d <= C d1, there is C' with H^phi[d](E) <= C' H^phi[d1](E) for every Borel E."))

(entry (doc "construction-of-measures")
       (ref "4.44")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Doubling is invariant under bounded equivalence")
       (names doubling-iff-boundedly-equivalent)
       (status proven)
       (deviation "phi(0) = psi(0) = 0 added: the notes' proof uses the bound at r = 0, which Def 4.43 (0 < r) does not give (psi = phi off 0, psi(0) = 1 is a counterexample)")
       (notes-statement "If psi, phi are nondecreasing on [0, infinity) and boundedly equivalent, then psi is doubling iff phi is."))

(entry (doc "construction-of-measures")
       (ref "4.53")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Uniqueness of the Hausdorff dimension")
       (names hausdorff-positive-infinite hausdorff-dim-unique hausdorff-delta-below)
       (status proven)
       (deviation "Stated for 0 < rho < lambda (H^rho needs rho > 0). IS-HAUSDORFF-DIM(m, E, lambda) is new: lambda real >= 0, H^rho(E) = 0 for rho > lambda and H^rho(E) = POS-INF for 0 < rho < lambda.")
       (notes-statement "If H^lambda(E) > 0 then H^rho(E) = infinity for rho < lambda; hence E has at most one Hausdorff dimension."))

(entry (doc "construction-of-measures")
       (ref "4.54")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Local Hausdorff dimension in a separable space")
       (names hausdorff-dim-local)
       (status proven)
       (deviation "Adds the hypothesis that X is nonempty (for X empty and lambda > 0 the conclusion is false). Separability is IS-SEPARABLE (a dense sequence); B(x, r) is the open BALL.")
       (notes-statement "If (X, d) is separable and for some r > 0 every ball B(x, r) is lambda-dimensional, then X is lambda-dimensional."))

(entry (doc "construction-of-measures")
       (ref "4.55")
       (section "4.4" prefilled)
       (kind proposition)
       (title "Hausdorff measure restricts to Borel subsets")
       (names hausdorff-phi-subspace method-ii-delta-subspace-le method-ii-delta-subspace-ge subspace-diam)
       (status proven)
       (deviation "Proven for every subset Y of X (not only Borel) and as an equality of outer measures: H^phi[SUBSPACE-MS(X, Y)](E) = H^phi[X](E) for every E subset Y. The restriction is then the restriction of this outer measure, so no measure-theoretic restriction (BOREL-SETS of a subspace) is needed. The doubling hypothesis is kept as in the notes.")
       (notes-statement "For phi doubling and Y a Borel subset of (X, d), the restriction of H^phi_X to Y is the Hausdorff measure H^phi_Y of the subspace Y."))

(entry (doc "construction-of-measures")
       (ref "5.2")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Borel sets of a subspace are traces")
       (names borel-sets-subspace mbs-trace-borel mbs-borel-is-trace)
       (status proven)
       (deviation "None.")
       (notes-statement "For a subset Y of a metric space X, the Borel sets of Y are exactly the sets E cap Y with E Borel in X."))

(entry (doc "construction-of-measures")
       (ref "5.3")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Borel sets of a product of separable spaces")
       (names borel-sets-product mbp-open-in-product mbp-product-in-borel)
       (status proven)
       (deviation "X x Y carries the max metric (PRODUCT2-MS); the product of sigma-algebras is PRODUCT-SIGMA.")
       (notes-statement "For separable metric spaces X, Y the Borel sigma-algebra of X x Y equals the product of the Borel sigma-algebras."))

(entry (doc "construction-of-measures")
       (ref "5.6")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Sieve intersections are singletons")
       (names nested-closed-intersection diam-dist-le)
       (status proven)
       (deviation "Stated path by path: for a decreasing sequence of nonempty closed sets with DIAM -> 0 in a complete space the intersection is one point; along an infinite path z the sets S_{z|n} of a sieve are such a sequence. The sieve indexing by finite sequences N* (Definition 5.4) is B5's vocabulary; with it 5.6 is one instantiation. DIAM is new (mb4-vocab).")
       (notes-statement "In a complete metric space, a sieve of closed nonempty sets with the monotonicity and diameter properties has a singleton intersection along every infinite path."))

(entry (doc "construction-of-measures")
       (ref "5.10")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Souslin sets are continuous images of Baire space")
       (names souslin-iff-baire-image baire-image-souslin souslin-baire-image)
       (status proven)
       (deviation "Continuity on N^N is IS-BAIRE-CONTINUOUS (cylinder form); N^N is FUN(NN, NN), not a metric space.")
       (notes-statement "A subset E of a metric space is Souslin iff there is a continuous surjection from N^N onto E."))

(entry (doc "construction-of-measures")
       (ref "5.12")
       (section "5.1" prefilled)
       (kind lemma)
       (title "Complete separable spaces are Souslin")
       (names complete-separable-souslin polish-baire-surjection)
       (status proven)
       (deviation "None.")
       (notes-statement "Every complete separable metric space is Souslin."))

(entry (doc "construction-of-measures")
       (ref "5.14")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Souslin sets are continuous images of Polish spaces")
       (names souslin-iff-polish-image souslin-polish-image continuous-image-polish-souslin baire-ms-polish)
       (status proven)
       (deviation "Polish = IS-COMPLETE and IS-SEPARABLE; the map goes into SUBSPACE-MS(X, E). N^N is BAIRE-MS, the prefix ultrametric 2^-m(x,y) (ULTRA-SEQ-MS with weight 2), proven complete and separable.")
       (notes-statement "E is Souslin iff it is the continuous image of some Polish space."))

(entry (doc "construction-of-measures")
       (ref "5.15")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Continuous images of Souslin sets")
       (names souslin-continuous-image)
       (status proven)
       (deviation "For any metric spaces X, Y; completeness is not needed.")
       (notes-statement "A continuous map between complete metric spaces carries Souslin sets to Souslin sets."))

(entry (doc "construction-of-measures")
       (ref "5.16")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Souslin sets closed under countable unions and intersections")
       (names souslin-countable-union souslin-countable-intersection)
       (status proven)
       (deviation "The family is E in FUN(NN, POWER(PTS X)). The intersection needs a nonempty hypothesis: Souslin sets are nonempty by the intersection property of Definition 5.4.")
       (notes-statement "The Souslin subsets of a metric space are closed under countable unions and countable intersections."))

(entry (doc "construction-of-measures")
       (ref "5.17")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Borel sets are Souslin")
       (names borel-polish-souslin closed-polish-souslin)
       (status proven)
       (deviation "Nonempty Borel sets (the empty set is not Souslin under Definitions 5.4/5.7); the sigma-algebra is the class of sets E with E and X \\ E each Souslin or empty.")
       (notes-statement "In a complete separable metric space every Borel set is Souslin."))

(entry (doc "construction-of-measures")
       (ref "5.18")
       (section "5.1" prefilled)
       (kind lemma)
       (title "Open subsets of Polish spaces are Polish")
       (names polish-open-souslin)
       (status proven)
       (deviation "Nonempty open set; a Souslin set is nonempty by Definition 5.4.")
       (notes-statement "Every open set in a Polish space is Souslin (indeed Polish)."))

(entry (doc "construction-of-measures")
       (ref "5.20")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Lusin sets closed under countable disjoint unions and intersections")
       (names lusin-disjoint-union lusin-countable-intersection sum-ms-polish product-polish)
       (status proven)
       (deviation "Union: members Lusin or empty, union nonempty, parametrised by a closed part of SUM-MS (new: the disjoint sum with the bounded metric per summand). Intersection: nonempty, parametrised by a closed subset of PRODUCT-METRIC-W of the witnesses.")
       (notes-statement "The Lusin subsets of a metric space are closed under countable disjoint unions and countable intersections."))

(entry (doc "construction-of-measures")
       (ref "5.21")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Borel sets are Lusin")
       (names borel-polish-lusin borel-from-inter-disjoint-union)
       (status proven)
       (deviation "Nonempty Borel sets (a Lusin set is nonempty, its parameter space being separable).")
       (notes-statement "Every Borel subset of a Polish space is a Lusin set."))

(entry (doc "construction-of-measures")
       (ref "5.23")
       (section "5.1" prefilled)
       (kind lemma)
       (title "Classes containing the open sets contain the Borel sets")
       (names borel-from-inter-disjoint-union)
       (home-elsewhere borel-from-inter-disjoint-union)
       (status proven)
       (deviation "For any metric space (the notes: Polish). Countable intersection is {x in X : x in g(n) for all n}; disjointness is stated pointwise.")
       (notes-statement "In a Polish space, a class of sets closed under countable intersections and countable disjoint unions that contains the open sets contains all Borel sets."))

(entry (doc "construction-of-measures")
       (ref "5.25")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Lusin separation theorem")
       (names souslin-separation baire-separation separation-step borel-separated-union)
       (status proven)
       (deviation "Any metric space; Baire-space proof (Souslin set = f(N^N)), no closure, no completeness.")
       (notes-statement "Disjoint Souslin subsets of a complete metric space are separated by Borel sets."))

(entry (doc "construction-of-measures")
       (ref "5.26")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Souslin's theorem")
       (names souslin-theorem souslin-complement-borel)
       (status proven)
       (deviation "Souslin or empty.")
       (notes-statement "A subset of a complete metric space is Borel iff it and its complement are Souslin."))

(entry (doc "construction-of-measures")
       (ref "5.27")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Separation of a disjoint sequence of Souslin sets")
       (names souslin-disjoint-envelopes)
       (status proven)
       (deviation "Souslin or empty; any metric space.")
       (notes-statement "A sequence of pairwise disjoint Souslin sets in a complete metric space is enclosed in a sequence of pairwise disjoint Borel sets."))

(entry (doc "construction-of-measures")
       (ref "5.28")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Borel sieve partitions of a Borel set")
       (names dense-piece-borel dense-piece-cover dense-piece-disjoint dense-piece-small dense-cell-borel dense-cell-cover dense-cell-disjoint dense-cell-small dense-cell-nested)
       (status proven)
       (deviation "As the partition step and the indexed tree of cells used by 5.30.")
       (notes-statement "Every Borel set in a separable metric space admits a sieve of Borel subsets with the monotonicity and diameter properties whose levels partition the set."))

(entry (doc "construction-of-measures")
       (ref "5.30")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Injective continuous images of Borel sets are Borel")
       (names lusin-souslin-borel-domain lusin-souslin)
       (status proven)
       (deviation "Target any metric space; closure replaced by open neighbourhoods.")
       (notes-statement "A continuous injective image in a complete metric space of a Borel subset of a complete separable metric space is Borel."))

(entry (doc "construction-of-measures")
       (ref "5.31")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Borel = Lusin in Polish spaces")
       (names polish-borel-iff-lusin lusin-borel borel-polish-lusin)
       (home-elsewhere borel-polish-lusin)
       (status proven)
       (deviation "Lusin or empty.")
       (notes-statement "The Borel sets of a Polish space are precisely its Lusin sets."))

(entry (doc "construction-of-measures")
       (ref "5.32")
       (section "5.1" prefilled)
       (kind theorem)
       (title "Injective Borel maps preserve Borel sets")
       (names injective-borel-image borel-injection-image separable-countably-separated)
       (status proven)
       (deviation "Via the injective Borel embedding of Y into N^N (5.36), not the completion of Y.")
       (notes-statement "An injective Borel map from a Polish space to a separable metric space maps Borel sets to Borel sets."))

(entry (doc "construction-of-measures")
       (ref "5.33")
       (section "5.1" prefilled)
       (kind lemma)
       (title "Graphs of measurable maps are measurable")
       (names graph-measurable)
       (status proven)
       (deviation "IS-COUNTABLY-SEPARATED and GRAPH-OF are new; the graph is {w in X x Y : phi(w_1) = w_2}, measurable for PRODUCT-SIGMA.")
       (notes-statement "If (Y,B) is countably separated and phi: X -> Y is measurable, the graph of phi is measurable in the product sigma-algebra."))

(entry (doc "construction-of-measures")
       (ref "5.34")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Measurable subsets of standard Borel spaces are standard")
       (names standard-measurable-subset restrict-sigma-algebra)
       (status proven)
       (deviation "E nonempty; relativized structure RESTRICT-SIGMA (new).")
       (notes-statement "Every measurable subset of a standard Borel space, with the relative structure, is standard Borel."))

(entry (doc "construction-of-measures")
       (ref "5.35")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Countable disjoint unions of standard Borel spaces")
       (names standard-disjoint-union sum-sigma-algebra)
       (status proven)
       (deviation "New SUM-SET, SUM-SIGMA; xss, cas typed in FUN(NN, SET).")
       (notes-statement "A countable disjoint union of standard Borel spaces is standard."))

(entry (doc "construction-of-measures")
       (ref "5.36")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Countably separated spaces embed in separable metric spaces")
       (names countably-separated-iff countably-separated-embeds countably-separated-of-injection measurable-map-of-generators)
       (status proven)
       (deviation "The separable metric space of the necessity is N^N (BAIRE-MS), not {0,1}^N.")
       (notes-statement "A measurable space is countably separated iff it admits an injective measurable map into a separable metric space with its Borel sets."))

(entry (doc "construction-of-measures")
       (ref "5.37")
       (section "5.1" prefilled)
       (kind corollary)
       (title "Injective measurable maps from standard spaces")
       (names standard-injection-images standard-injection-image-standard)
       (status proven)
       (deviation "Stated as: images measurable, and the image standard.")
       (notes-statement "An injective measurable map from a standard Borel space to a countably separated space is a measurable isomorphism onto a standard Borel image."))

(entry (doc "construction-of-measures")
       (ref "5.38")
       (section "5.1" prefilled)
       (kind proposition)
       (title "Souslin sets in Polish spaces via closed families")
       (names souslin-iff-closed-family closed-family-souslin souslin-closed-family souslin-closed-graph-closed dist0-closed)
       (status proven)
       (deviation "Nonemptiness explicit (a sieve's Souslin set is nonempty).")
       (notes-statement "A subset of a Polish space is Souslin iff it is the Souslin operation applied to some family of closed sets indexed by N*."))

(entry (doc "construction-of-measures")
       (ref "5.44")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Closed/open approximation of Borel sets")
       (names borel-closed-open-approx borel-closed-open-approx-finite)
       (status proven)
       (deviation "Also proven for any finite measure (Remark 5.45): borel-closed-open-approx-finite.")
       (notes-statement "For a Borel probability measure on a metric space, every Borel set E and eps > 0 admit F closed and U open with F subset E subset U and mu(U \\ F) <= eps."))

(entry (doc "construction-of-measures")
       (ref "5.46")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Outer regularity for locally finite measures")
       (names borel-outer-regular borel-outer-approx)
       (status proven)
       (deviation "(137) as mu(E) = EINF{mu(U) : U open, E subset U}. The finite approximations are taken on E n V_n for every n (no disjointification).")
       (notes-statement "If X is a countable union of open sets of finite mu-measure, the closed/open approximation (137) holds for every Borel set."))

(entry (doc "construction-of-measures")
       (ref "5.47")
       (section "5.2" prefilled)
       (kind corollary)
       (title "Comparison on open sets extends to Borel sets")
       (names borel-measure-compare-open)
       (status proven)
       (deviation "None.")
       (notes-statement "If mu(U) >= nu(U) for all open U and X is a countable union of open sets of finite mu-measure, then mu(E) >= nu(E) for every Borel E."))

(entry (doc "construction-of-measures")
       (ref "5.49")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Regularity is tightness of the whole space")
       (names regular-iff-tight)
       (status proven)
       (deviation "Definition 5.48 is IS-REGULAR-MEASURE(X, mu) (new); compact K is IS-COMPACT(SUBSPACE-MS(X, K)); sup is ESUP.")
       (notes-statement "A finite measure on a metric space is regular iff mu(X) is the supremum of mu(K) over compact K."))

(entry (doc "construction-of-measures")
       (ref "5.51")
       (section "5.2" prefilled)
       (kind proposition)
       (title "Ulam's theorem")
       (names polish-probability-regular tight-of-full-balls)
       (status proven)
       (deviation "K is built from CLOSED balls, so it is closed without taking a closure; compact as complete and totally bounded.")
       (notes-statement "Every Borel probability measure on a Polish space is regular."))

(entry (doc "construction-of-measures")
       (ref "5.52")
       (section "5.2" prefilled)
       (kind corollary)
       (title "Regularity on complete spaces via separable support")
       (names regular-iff-separable-support)
       (status proven)
       (deviation "Separable Borel E: IS-SEPARABLE(SUBSPACE-MS(X, E)). Sufficiency runs Ulam's argument on a dense sequence of E instead of passing to the closure of E.")
       (notes-statement "A probability measure on a complete metric space is regular iff some separable Borel set has measure 1."))

(entry (doc "construction-of-measures")
       (ref "6.8")
       (section "6.1" prefilled)
       (kind theorem)
       (title "Borel sets are rho*-measurable")
       (names borel-sets-caratheodory-measurable)
       (home-elsewhere borel-sets-caratheodory-measurable)
       (status partial)
       (deviation "The general step (a metric outer measure makes Borel sets Caratheodory-measurable, notes 4.26) is borel-sets-caratheodory-measurable; rho* itself (from a content) is not defined.")
       (notes-statement "Every Borel subset is measurable for the outer measure rho* of a content."))

(entry (doc "construction-of-measures")
       (ref "6.12")
       (section "6.1" prefilled)
       (kind lemma)
       (title "Splitting a compact set across two open sets")
       (names compact-split-open-cover)
       (status proven)
       (deviation "Proven for a METRIC space (compact = IS-COMPACT(SUBSPACE-MS(s, A))), not for a Hausdorff topological space; the conclusion is K = A u B, which is stronger than the notes' K in A u B.")
       (notes-statement "In a Hausdorff space, a compact K inside U union V (U, V open) is A union B with A, B compact, A in U, B in V."))

(entry (doc "construction-of-measures")
       (ref "6.21")
       (section "6.3" prefilled)
       (kind theorem)
       (title "Riesz-Markov on locally compact metric spaces")
       (names rmz-riesz-markov rmz-riesz-markov-dense rmk-riesz-markov-from-k)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL, CLOSURE. Only the COMPACT metric case is proven (rmz-riesz-markov: a positive functional on CONT-FNS(s), s compact with a point, is the RINTEGRAL against some measure on BOREL-SETS(s)); by a different route (Cantor model), not via contents. Locally compact X, Cc(X) and the specific measure mu_Lambda are absent.")
       (notes-statement "For a Radon measure Lambda on a locally compact metric space, Lambda(f) = integral of f d mu_Lambda for every f in Cc(X)."))

(entry (doc "construction-of-measures")
       (ref "6.22")
       (section "6.3" prefilled)
       (kind theorem)
       (title "Uniqueness in Riesz-Markov (separable case)")
       (names rmz-riesz-markov)
       (home-elsewhere rmz-riesz-markov)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL, CLOSURE. Existence is proven for compact metric spaces only (rmz-riesz-markov); uniqueness of the Borel measure is not stated anywhere; locally compact separable case absent.")
       (notes-statement "On a separable locally compact metric space a Radon measure is integration against a unique Borel measure."))

(entry (doc "construction-of-measures")
       (ref "7.6")
       (section "7.1" prefilled)
       (kind corollary)
       (title "Separability when r0 is infinite")
       (names measure-ball-separable ball-greedy-net ball-packing-bounded)
       (status proven)
       (deviation "(193) is stated as: for each r > 0 some c > 0 has c mu(B(y,r)) <= mu(B(x,r)) for all x, y (the infimum of the ratios is positive; the ratios are defined by (192)). X nonempty is assumed (IS-SEPARABLE). Proved by the packing half of the proof of 7.1 (a greedy delta-net and countable additivity), not through 7.3: relative compactness is CLOSURE. Completeness is assumed as in 7.1 but not used.")
       (notes-statement "Under the hypotheses of 7.1 with r0 = infinity, X is separable."))

(entry (doc "construction-of-measures")
       (ref "7.7")
       (section "7.1" prefilled)
       (kind proposition)
       (title "Sigma-finiteness")
       (names ball-finite-sigma-finite)
       (status proven)
       (deviation "r0 ranges over (0, +inf] as an element of RR-POS-STAR; (192) is assumed whole (the positivity half is not needed).")
       (notes-statement "A Borel measure on a separable metric space with finite positive measure of small balls is sigma-finite."))

(entry (doc "construction-of-measures")
       (ref "7.38")
       (section "7.2" prefilled)
       (kind proposition)
       (title "Self-similar dimension equation")
       (names self-similar-dimension)
       (status partial)
       (deviation "The existence and uniqueness half, proven: X in SET with CARD(X) in NN and 2 <= CARD(X), a in FUN(X, RR) with every a(w) > 1  ==>  there is l in RR, 0 < l, with FINSUM over X of RPOW-STAR(a(w), -l) = 1, and every positive real l2 with the same sum equals l.  The Ahlfors regularity of (X^N, d_a) of dimension lambda is not stated (no Ahlfors vocabulary, no product measure on X^N).")
       (notes-statement "For reals a_w > 1 over a finite X of size >= 2 there is a unique lambda > 0 with sum a_w^(-lambda) = 1, and (X^N, d_a) is Ahlfors regular of dimension lambda."))

(entry (doc "construction-of-measures")
       (ref "8.24")
       (section "8.3" prefilled)
       (kind theorem)
       (title "Riesz-Markov for compact spaces")
       (names rmz-riesz-markov rmz-riesz-markov-dense)
       (home-elsewhere rmz-riesz-markov rmz-riesz-markov-dense)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL. Proven only for compact METRIC spaces with a point (Borel = Baire there), existence only; uniqueness and finiteness of mu are not stated, and general compact Hausdorff spaces / Baire sets are absent.")
       (notes-statement "A positive linear functional on C(X), X compact, is integration against a unique finite measure on the Baire sets."))

(entry (doc "construction-of-measures")
       (ref "8.32")
       (section "8.4" prefilled)
       (kind theorem)
       (title "Riesz-Markov for bounded functionals on C_0")
       (names rmz-riesz-markov)
       (home-elsewhere rmz-riesz-markov)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL. Only the compact metric existence case is proven (rmz-riesz-markov); locally compact spaces, C_omega(X), Baire sets, sigma-bounded carriers and uniqueness are absent.")
       (notes-statement "A bounded positive functional on C_omega(X) is integration against a unique finite Baire measure vanishing off a sigma-bounded set."))

(entry (doc "construction-of-measures")
       (ref "10.14")
       (section "10.3" prefilled)
       (kind lemma)
       (title "Extension from a dense set via Cauchy nets")
       (names uniformly-continuous-extension-from-dense)
       (home-elsewhere uniformly-continuous-extension-from-dense)
       (status partial)
       (deviation "The metric uniformly-continuous version exists (uniformly-continuous-extension-from-dense: unique uniformly continuous extension from a dense set into a complete space); nets, pseudometric families and the Cauchy-net criterion are absent.")
       (notes-statement "A map from a dense subset into a complete pseudometric space extends continuously iff it maps Cauchy nets to Cauchy nets, uniquely."))

(entry (doc "construction-of-measures")
       (ref "A.6")
       (kind proposition)
       (title "Compact and disjoint closed sets are at positive distance")
       (names compact-closed-positive-distance)
       (status proven)
       (deviation "Compactness is IS-COMPACT(SUBSPACE-MS(s, K)); d(K, F) > 0 is stated as SET-DIST(s, K, F) /= 0 (SET-DIST lives in [0, +inf]), the form of set-dist-pos-intro.")
       (notes-statement "If K is compact and F closed and disjoint from K, then d(K, F) > 0."))

(entry (doc "construction-of-measures")
       (ref "A.8")
       (kind proposition)
       (title "Lipschitz comparison via balls")
       (names lipschitz-bound-iff-balls lipschitz-lower-iff-balls lipschitz-equivalent-iff-balls)
       (status proven)
       (deviation "Two metric spaces s, t on the same point set (PTS t = PTS s), constants POS-RR.  One-sided: d_s <= K d_t everywhere iff BALL(t, x, r) is in BALL(s, x, K r) for all x and r > 0; lower: k d_t <= d_s iff BALL(s, x, k r) is in BALL(t, x, r); two-sided is their conjunction.")
       (notes-statement "d <= K d' holds everywhere iff B_{d'}(x,r) is in B_d(x,Kr) for all x, r; similarly for two-sided bounds."))

(entry (doc "construction-of-measures")
       (ref "A.9")
       (kind proposition)
       (title "Snowflake metrics")
       (names snowflake-is-metric-space)
       (status proven)
       (deviation "SNOWFLAKE(s, e) is new vocabulary: the points of s with distance RPOW-STAR(d(x, y), e); 0 < e <= 1.")
       (notes-statement "For 0 < s <= 1, d^s is a metric."))

(entry (doc "construction-of-measures")
       (ref "A.10")
       (kind lemma)
       (title "Subadditivity of t^s")
       (names rpow-subadditive)
       (status proven)
       (deviation "Powers are RPOW-STAR.")
       (notes-statement "For 0 < s <= 1 and a, b >= 0, (a+b)^s <= a^s + b^s."))

(entry (doc "construction-of-measures")
       (ref "A.11")
       (kind proposition)
       (title "Convergence in X^N")
       (names seq-space-converges-iff)
       (status proven)
       (deviation "SEQ-SPACE-MS(X) (new) is the metric (414) built as PRODUCT-METRIC-W of the constant sequence DISCRETE-MS(X) with weights 2^-n, n in NN: the bounded discrete distance is 1/2, so the n-th summand is 2^-(n+1) exactly where the coordinates differ, which is the notes' 2^-k with k = n + 1.  Stated for X a set (countability is not needed).  Both directions.")
       (notes-statement "A sequence in X^N converges to u iff each coordinate is eventually equal to that of u."))

(entry (doc "construction-of-measures")
       (ref "A.14")
       (kind proposition)
       (title "Transitivity of the permutation group on X^N")
       (names coord-permute-transitive)
       (status proven)
       (deviation "COORD-PERMUTE(X, sg) (new) is the notes' S_sigma of (417); a permutation is a member of BIJECTION(X, X).  Statement: for x, y in FUN(NN, X) there is sg in FUN(NN, BIJECTION(X, X)) with COORD-PERMUTE(X, sg)(x) = y; the witness is the coordinatewise transposition of x_k and y_k (swap-bijection).  The group structure of S and the isometry remark are not stated.")
       (notes-statement "The group S of coordinatewise permutations acts transitively on X^N."))

(entry (doc "construction-of-measures")
       (ref "A.15")
       (kind proposition)
       (title "d_a is an ultrametric")
       (names ultra-seq-is-ultrametric ultra-seq-is-metric-space prefix-dist-ultra)
       (status proven)
       (deviation "New vocabulary IS-ULTRAMETRIC, PREFIX-PROD, AGREE-LENGTH (the notes' m(x, y), counted from index 0), PREFIX-DIST (419), ULTRA-SEQ-MS(X, a).  Hypotheses: X a set, a in FUN(X, RR), every a_w > 1.  The divergence condition (418) is NOT needed for A.15 and is not assumed.")
       (notes-statement "The weighted prefix metric d_a on X^N is an ultrametric."))

(entry (doc "construction-of-measures")
       (ref "A.16")
       (kind proposition)
       (title "Convergence for d_a")
       (names ultra-seq-converges-iff)
       (status proven)
       (deviation "Hypothesis (418) is stated as: for every z in FUN(NN, X) and real M some prefix product PREFIX-PROD(a, z, n) exceeds M.  Both directions.")
       (notes-statement "A sequence converges in (X^N, d_a) iff each coordinate is eventually constant equal to the limit's."))

(entry (doc "construction-of-measures")
       (ref "Lebesgue")
       (kind theorem)
       (title "Lebesgue outer measure is a metric outer measure; the intervals are measurable")
       (names lebesgue-metric-outer-measure lebesgue-borel-measurable lebesgue-intervals-measurable)
       (status proven)
       (deviation "Not proven in the notes. The half-lines are shown measurable directly (a cover cut at one point keeps its total length); two separated sets are then split by the measurable union of the grid cells narrower than their distance that meet the first (metric-outer-of-separating-sets).")
       (notes-statement "Lebesgue outer measure on the line is a metric outer measure, so every Borel set, and in particular every interval, is Lebesgue measurable."))

(entry (doc "construction-of-measures")
       (ref "Lebesgue")
       (kind theorem)
       (title "The Lebesgue measure of an interval is its length")
       (names lebesgue-measure-ccint lebesgue-measure-ooint lebesgue-measure-coint lebesgue-measure-ocint lebesgue-measure-point lebesgue-outer-ccint)
       (status proven)
       (deviation "The lower bound is proven for ANY countable cover of [a, b] by sets of reals (ccint-cover-sum-ge), by one creeping argument along [a, b]; no Heine-Borel and no finite subcover. The measure is written RES(lam*, CARATHEODORY-SETS(RR, lam*)), not named.")
       (notes-statement "For real a <= b, [a, b], (a, b), [a, b) and (a, b] are Lebesgue measurable with measure b - a; a point has measure 0."))

(entry (doc "construction-of-measures")
       (ref "Lebesgue")
       (kind theorem)
       (title "Lebesgue outer measure is translation invariant")
       (names lebesgue-outer-translate)
       (status proven)
       (deviation "The translate of es by c is written {z in RR : z - c in es}; since MEASURE-4 (2026-10-10) it is TRANSLATE(es, c).")
       (notes-statement "For every set of reals E and real c, lambda*(E + c) = lambda*(E)."))

(entry (doc "construction-of-measures")
       (ref "Lebesgue")
       (kind theorem)
       (title "Translates of Lebesgue measurable sets are measurable, with the same measure")
       (names lebesgue-measurable-translate lebesgue-outer-translate-invariant)
       (status proven)
       (notes-statement "If E is Lebesgue measurable and c is real, E + c is Lebesgue measurable and lambda(E + c) = lambda(E)."))

(entry (doc "construction-of-measures")
       (ref "Lebesgue")
       (kind theorem)
       (title "Uniqueness of Lebesgue measure on the Borel sets")
       (names lebesgue-measure-unique)
       (status proven)
       (deviation "Not in the notes. Proven without the monotone class theorem or Dynkin's theorem: mu <= lambda* on Borel sets by subadditivity against covers; equality inside [p, q] by applying that to a set and its complement in [p, q]; then continuity from below.")
       (notes-statement "A measure on the Borel sets of the line that gives every interval [a, b] the measure b - a coincides with Lebesgue measure on the Borel sets."))

;;; ===== functional-analysis =====
;;; The OUTLINE of functional-analysis: chapters that hold an entry, with every section the notes have.
;;; Titles marked `prefilled' were read off the notes by pdftotext (BOOK-GEN, 2026-11-12); review
;;; and delete the mark.  Read by library-book.scm; ignored by the major-theorems list.
(outline "functional-analysis"
  (chapter "1" "")
  (chapter "2" "")
  (chapter "8" "")
  (chapter "Hahn-Banach" "")
  (chapter "Riesz-Markov" ""))

(entry (doc "functional-analysis")
       (ref "1.8")
       (kind theorem)
       (title "Cauchy-Schwarz and Minkowski inequalities for an inner product")
       (names cips-schwarz sip-schwarz cips-minkowski sip-minkowski)
       (status proven)
       (deviation "Stated for the complex inner product space structure (cips-schwarz as <x,y> times its conjugate <= <x,x><y,y>; cips-minkowski for ip-norm) and for the real semi-inner-product structure (sip-schwarz, sip-minkowski); not for an abstract space over K = R or C in one statement.")
       (notes-statement "For an inner product on a vector space, |<x|y>| <= ||x|| ||y|| and ||x+y|| <= ||x|| + ||y||."))

(entry (doc "functional-analysis")
       (ref "1.10")
       (kind proposition)
       (title "Polarization identity for a sesquilinear form")
       (names ses-polarization)
       (status proven)
       (deviation "Stated for a form on the carrier of a complex semi-inner-product space (IS-SESQUILINEAR-FORM(v, sqf)), not on a bare complex vector space.")
       (notes-statement "For a sesquilinear form B on a complex vector space, 4B(x,y) = B(x+y,x+y) - B(x-y,x-y) + iB(x+iy,x+iy) - iB(x-iy,x-iy)."))

(entry (doc "functional-analysis")
       (ref "1.12")
       (kind corollary)
       (title "Sesquilinear forms agreeing on the diagonal are equal")
       (names ses-polarization ses-add-left ses-add-right ses-homog-left ses-homog-right)
       (home-elsewhere ses-polarization)
       (status partial)
       (deviation "Immediate from ses-polarization applied to B - B', but no theorem states it and the difference form is not shown to be sesquilinear (ses-add-*/ses-homog-* give the pieces).")
       (notes-statement "If sesquilinear forms B and B' satisfy B(x,x) = B'(x,x) for all x, then B = B'."))

(entry (doc "functional-analysis")
       (ref "1.25")
       (kind proposition)
       (title "Vector space operations are continuous in a normed space")
       (names frm-add-continuous frm-scal-continuous)
       (status partial)
       (deviation "Proved for IS-SEMINORM-FAMILY structures (sequences, countable family: the 8.25 form); not stated for IS-NORMED-VECTOR-SPACE (real scalars only) nor for a norm viewed as a constant seminorm family. No complex normed vector space and no Banach-space predicate: IS-NORMED-VECTOR-SPACE has real scalars only (scal = RR-NORMED-FIELD) and 'complete' is IS-COMPLETE of a metric space.")
       (notes-statement "In a normed space, scalar multiplication and addition are continuous."))

(entry (doc "functional-analysis")
       (ref "1.26")
       (kind proposition)
       (title "The inner product norm is a norm; the inner product is continuous")
       (names ip-normed-ag-is-normed-ag ip-metric-space-is-metric-space cips-minkowski)
       (home-elsewhere cips-minkowski)
       (status partial)
       (deviation "(1) proven: ip-normed-ag-is-normed-ag, ip-metric-space-is-metric-space. (2) joint continuity of <.|.> : H x H -> K is not stated anywhere in the catalog.")
       (notes-statement "xi -> sqrt(<xi|xi>) is a norm on a pre-Hilbert space, and the inner product is continuous."))

(entry (doc "functional-analysis")
       (ref "1.40")
       (kind proposition)
       (title "Absolutely summable families in a Banach space are summable")
       (names absolute-summable-implies-summable)
       (status proven)
       (deviation "Stated for a complete IS-NORMED-AG (the additive group of a Banach space), with IS-ABSOLUTELY-SUMMABLE via ESUM and IS-SUMMABLE; no vector-space structure involved.")
       (notes-statement "In a Banach space, a family with sum of ||eta_i|| < infinity is summable."))

(entry (doc "functional-analysis")
       (ref "1.44")
       (kind proposition)
       (title "L2 of a measure space is a (separable) Hilbert space; C_0(X) dense")
       (names l2-quotient-is-pre-hilbert cl2-quotient-is-cips cl2-quotient-is-cphs)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL, CLOSURE. Only the pre-Hilbert (inner product space) part is proven, for real L2 (l2-quotient-is-pre-hilbert) and complex L2 (cl2-quotient-is-cips). Completeness (Riesz-Fischer), separability and the density of C_0(X) are missing; IS-HILBERT-SPACE of the L2 quotient is not stated.")
       (notes-statement "L2_mu(X) is a Hilbert space, separable iff (X,mu) is, and C_0(X) is dense in it for locally compact separable X with mu(K) < infinity on compacts."))

(entry (doc "functional-analysis")
       (ref "1.45")
       (kind lemma)
       (title "Simple functions are dense in L2")
       (names integral-simple-approx dominated-convergence)
       (home-elsewhere integral-simple-approx dominated-convergence)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL, CLOSURE. integral-simple-approx (monotone simple approximation of a measurable function) and dominated-convergence are the ingredients; the density statement in the L2 seminorm is not stated.")
       (notes-statement "Simple functions are dense in L2_mu(X)."))

(entry (doc "functional-analysis")
       (ref "1.49")
       (kind proposition)
       (title "L^p_mu(X) is a Banach space")
       (names lp-norm-triangle lp-norm-homogeneous lp-norm-zero-iff minkowski)
       (home-elsewhere lp-norm-triangle lp-norm-homogeneous lp-norm-zero-iff minkowski)
       (status partial)
       (deviation "REWRITE-HEADS: INTEGRAL. The seminorm axioms for real measurable functions are proven (lp-norm-*, minkowski); the quotient normed space, completeness (Riesz-Fischer) and complex-valued L^p are missing.")
       (notes-statement "L^p_mu(X) with pointwise operations and the p-norm is a Banach space."))

(entry (doc "functional-analysis")
       (ref "1.52")
       (kind proposition)
       (title "Bounded iff continuous for a linear map of normed spaces")
       (names frm-cont-lin-iff-bound frm-bound-of-cont-lin frm-cont-lin-of-bound)
       (definitions is-bounded-linear-arrow-def)
       (status partial)
       (deviation "Proven for seminorm-family structures over a non-trivially valued field (the 8.26 form). IS-BOUNDED-LINEAR-ARROW is defined by the bound; the equivalence with continuity of the normed space (nvs-metric-space) and with the sup over the unit ball is not stated. No complex normed vector space and no Banach-space predicate: IS-NORMED-VECTOR-SPACE has real scalars only (scal = RR-NORMED-FIELD) and 'complete' is IS-COMPLETE of a metric space.")
       (notes-statement "For a linear T: E -> F of normed spaces, sup{||T eta||: ||eta|| <= 1} < infinity iff ||T eta|| <= C||eta|| iff T is continuous (at 0, everywhere)."))

(entry (doc "functional-analysis")
       (ref "1.54")
       (kind proposition)
       (title "The operator norm is a norm on L(E,F)")
       (names dual-norm-spec dual-norm-nonneg-nvs dual-norm-le-bound-nvs dual-norm-is-bound-nvs)
       (status partial)
       (deviation "Only functionals (F = RR): DUAL-NORM(m, f) with its spec, but no operator norm for normed F and no normed vector space L(E,F). rb3-dual-is-normed-vector-space-false records that DUAL(m) is not shown a normed vector space for every m.")
       (notes-statement "||T|| = sup{||T eta||: ||eta|| <= 1} is a norm on the space of bounded operators E -> F."))

(entry (doc "functional-analysis")
       (ref "1.61")
       (kind proposition)
       (title "Extension of a bounded operator from a dense subspace")
       (names uniformly-continuous-extension-from-dense)
       (home-elsewhere uniformly-continuous-extension-from-dense)
       (status partial)
       (deviation "REWRITE-HEADS: CLOSURE. Only the metric-space extension of uniformly continuous maps from a dense set (uniformly-continuous-extension-from-dense) is there; linearity of the extension, equality of norms, uniqueness are not stated.")
       (notes-statement "A continuous linear map on a dense subspace D of a normed space E into a Banach space F has a unique continuous linear extension to E, of the same norm."))

(entry (doc "functional-analysis")
       (ref "1.64")
       (kind theorem)
       (title "Baire-Hausdorff theorem")
       (names baire-category)
       (status proven)
       (deviation "Stated for a nonempty complete metric space (IS-NONMEAGER(s, PTS(s))); the nonemptiness hypothesis is implicit in the notes.")
       (notes-statement "A complete metric space is not meager in itself."))

(entry (doc "functional-analysis")
       (ref "1.69")
       (kind theorem)
       (title "Closed graph theorem for Banach spaces")
       (names closed-graph-theorem)
       (status partial)
       (deviation "Proven in the Frechet form (the 8.29 entry) for a countable separating seminorm family over a non-trivially valued field. The Banach instance (a norm as a constant seminorm family, completeness bridging nvs-metric-space and fr-metric-space) is not stated, and normed spaces are real only. No complex normed vector space and no Banach-space predicate: IS-NORMED-VECTOR-SPACE has real scalars only (scal = RR-NORMED-FIELD) and 'complete' is IS-COMPLETE of a metric space.")
       (notes-statement "A linear map between Banach spaces with closed graph is continuous."))

(entry (doc "functional-analysis")
       (ref "1.70")
       (kind theorem)
       (title "Open mapping theorem for Banach spaces")
       (names open-mapping-theorem)
       (status partial)
       (deviation "Proven in the Frechet form (the 8.30 entry); the Banach instance is not stated. No complex normed vector space and no Banach-space predicate: IS-NORMED-VECTOR-SPACE has real scalars only (scal = RR-NORMED-FIELD) and 'complete' is IS-COMPLETE of a metric space.")
       (notes-statement "A continuous linear surjection between Banach spaces is an open map."))

(entry (doc "functional-analysis")
       (ref "1.71")
       (kind corollary)
       (title "Bounded inverse theorem for Banach spaces")
       (names open-mapping-bounded-inverse)
       (status partial)
       (deviation "Proven in the Frechet form (open-mapping-bounded-inverse, for a given linear two-sided inverse g); the Banach instance is not stated.")
       (notes-statement "A continuous linear bijection between Banach spaces has a continuous inverse."))

(entry (doc "functional-analysis")
       (ref "1.72")
       (kind theorem)
       (title "Banach-Steinhaus: uniform boundedness")
       (names frechet-banach-steinhaus)
       (status partial)
       (deviation "frechet-banach-steinhaus gives equicontinuity (IS-FR-EQUICONT) for a pointwise bounded family on a Frechet space; the step from equicontinuity to sup||T_i|| < infinity for normed spaces is not stated. No complex normed vector space and no Banach-space predicate: IS-NORMED-VECTOR-SPACE has real scalars only (scal = RR-NORMED-FIELD) and 'complete' is IS-COMPLETE of a metric space.")
       (notes-statement "If E is Banach and {T_i} in L(E,F) is pointwise bounded, then sup_i ||T_i|| < infinity."))

(entry (doc "functional-analysis")
       (ref "1.76")
       (kind corollary)
       (title "Existence of a norming functional")
       (names hahn-banach-seminorm hahn-banach-extend-one hahn-banach)
       (status partial)
       (deviation "The extension theorem is proven (hahn-banach-seminorm over RR or CC; hahn-banach in finite dimension for IS-NORMED-VECTOR-SPACE); the corollary (extension from span{x} with the bound given by the norm, dual-norm = 1) is not stated. Complex scalars only through the seminorm form.")
       (notes-statement "For a nonzero x in a normed space E there is a functional f of norm 1 with f(x) = ||x||."))

(entry (doc "functional-analysis")
       (ref "2.19")
       (kind proposition)
       (title "Orthogonal projection onto a closed subspace of a Hilbert space")
       (names hilbert-projection-exists hilbert-decomposition-unique)
       (status proven)
       (deviation "P_K is the property IS-ORTHOGONAL-PROJECTION of a map, shown to exist uniquely, not an operator defined by IOTA.")
       (notes-statement "Every xi decomposes uniquely as xi1 + xi2 with xi1 in K and xi2 in K-perp; P_K is linear, of norm <= 1 and idempotent."))

(entry (doc "functional-analysis")
       (ref "2.21")
       (kind corollary)
       (title "A subspace is dense iff its orthogonal complement is zero")
       (names hilbert-dense-iff-perp-zero)
       (status proven)
       (deviation "Stated as closure(ip-metric-space(v), kk) = vec(v) iff every element of perp(v, kk) is zero.")
       (notes-statement "A subspace K of a Hilbert space is dense iff K-perp = {0}."))

(entry (doc "functional-analysis")
       (ref "2.22")
       (kind theorem)
       (title "Riesz representation")
       (names riesz-representation riesz-representation-unique)
       (status proven)
       (deviation "||f|| = ||eta|| is stated as: ||eta|| is the least bound for f; the tree has no operator norm on a complex inner product space.")
       (notes-statement "eta -> <. | eta> is a conjugate-linear isometric bijection of H onto its dual."))

(entry (doc "functional-analysis")
       (ref "8.24-8.26")
       (kind proposition)
       (title "Seminormed spaces with a countable family: the metric")
       (names frm-cont-lin-iff-bound frm-scal-continuous)
       (home-elsewhere frm-cont-lin-iff-bound frm-scal-continuous)
       (status proven)
       (deviation "Sequences, not nets. The field is a parameter of the seminorm vocabulary (the user's decision 2026-10-10); 8.26 continuity => bound needs IS-NONTRIVIALLY-VALUED, which every non-discrete locally compact field satisfies.")
       (notes-statement "A countable separating family of seminorms defines a translation-invariant metric with the same convergence; the vector operations are continuous; a linear map is continuous iff each target seminorm is bounded by a constant times a max of finitely many source seminorms."))

(entry (doc "functional-analysis")
       (ref "8.29")
       (kind theorem)
       (title "Closed graph theorem for Frechet spaces")
       (names closed-graph-theorem)
       (home-elsewhere closed-graph-theorem)
       (status proven)
       (deviation "Frechet = complete metric space of a countable separating family of seminorms (frm- metric), sequences, not nets; needs IS-NONTRIVIALLY-VALUED on the scalar field. Proved by citing the bounded-inverse corollary of 8.30.")
       (notes-statement "A linear map between Frechet spaces with closed graph is continuous."))

(entry (doc "functional-analysis")
       (ref "8.30")
       (kind theorem)
       (title "Open mapping theorem for Frechet spaces")
       (names open-mapping-theorem open-mapping-bounded-inverse)
       (home-elsewhere open-mapping-theorem open-mapping-bounded-inverse)
       (status proven)
       (deviation "By the roadmap of exercise 8.9 (a)-(i), modelled on Thm 1.72. Needs IS-NONTRIVIALLY-VALUED (the rescaling uses an invertible scalar of small norm). The bounded-inverse corollary is stated for a given linear two-sided inverse g.")
       (notes-statement "A continuous linear surjection between Frechet spaces is open; a continuous linear bijection has a continuous inverse."))

(entry (doc "functional-analysis")
       (ref "8.31-8.32")
       (kind theorem)
       (title "Banach-Steinhaus for Frechet spaces")
       (names frechet-banach-steinhaus)
       (home-elsewhere frechet-banach-steinhaus)
       (status proven)
       (deviation "Def 8.31 is IS-FR-BOUNDED / IS-FR-EQUICONT (structure-library/frechet-banach-steinhaus.scm); the family is a function h on an index set g; the target needs only a countable seminorm family, not completeness. Needs IS-NONTRIVIALLY-VALUED.")
       (notes-statement "A pointwise bounded family of continuous linear maps on a Frechet space is equicontinuous."))

(entry (doc "functional-analysis")
       (ref "8.34")
       (kind proposition)
       (title "C(X) is a Frechet space for X locally compact separable")
       (names cc-cont-fns-frechet cc-exhaust-seminorms-family cc-exhaust-seminorms-separate)
       (home-elsewhere cc-cont-fns-frechet cc-exhaust-seminorms-family)
       (status partial)
       (deviation "Proven for X = an open subset U of C and complex-valued functions (cc-cont-fns-frechet, exhaustion CC-EXHAUST); the general locally compact separable metric X and the real-valued case are not stated.")
       (notes-statement "For X a separable locally compact metric space, C(X) with the seminorms sup over an exhaustion by compacts is a Frechet space."))

(entry (doc "functional-analysis")
       (ref "8.36")
       (kind proposition)
       (title "Bounded sets of holomorphic functions are relatively compact (Montel)")
       (names cc-montel cc-hol-bounded-equicontinuous cc-montel-pointwise-limit)
       (home-elsewhere cc-montel cc-hol-bounded-equicontinuous cc-montel-pointwise-limit)
       (status partial)
       (deviation "Proven in the sequential form: a bounded sequence of holomorphic functions has a subsequence converging uniformly on compacta to a holomorphic function (cc-montel), with equicontinuity (cc-hol-bounded-equicontinuous). Relative compactness of a bounded SET as a statement about the Frechet topology is not stated (sequential and set versions agree in a metrizable space but the bridge is not a theorem).")
       (notes-statement "Every bounded subset of the space A(Omega) of holomorphic functions is relatively compact."))

(entry (doc "functional-analysis")
       (ref "8.37")
       (kind corollary)
       (title "A(Omega) is a Frechet space")
       (names cc-hol-fns-closed cc-cont-fns-frechet cc-hol-fn-module-is-module)
       (home-elsewhere cc-hol-fns-closed cc-cont-fns-frechet cc-hol-fn-module-is-module)
       (status partial)
       (deviation "The pieces are proven: CC-CONT-FNS(u) is a Frechet structure (cc-cont-fns-frechet), the holomorphic functions form a submodule (cc-hol-fn-module-is-module) closed under Frechet limits (cc-hol-fns-closed). The statement IS-FRECHET-STRUCTURE for CC-FN-MODULE(u, CC-HOL-FNS(u)) with the exhaustion seminorms is not itself a theorem.")
       (notes-statement "The space of holomorphic functions on Omega with the topology of compact convergence is a Frechet space."))

(entry (doc "functional-analysis")
       (ref "Hahn-Banach")
       (kind theorem)
       (title "Hahn-Banach for a sublinear functional")
       (names hbs-hahn-banach-sublinear hahn-banach-seminorm-rr hahn-banach-seminorm)
       (home-elsewhere hahn-banach-seminorm)
       (status proven)
       (deviation "Sublinear form over real vector spaces; the seminorm form hahn-banach-seminorm over RR or CC (rake-asm-b3, 2026-10-12). Proved by Zorn over the sublinear functionals below p ordered pointwise (a minimal one is linear), not over partial extensions.")
       (notes-statement "A linear functional on a subspace dominated by a sublinear p extends to the whole space, still dominated by p."))

(entry (doc "functional-analysis")
       (ref "Riesz-Markov (notes-63)")
       (kind theorem)
       (title "Riesz-Markov on a compact metric space")
       (names rmz-riesz-markov rmc-riesz-markov-k pex-positive-extension)
       (home-elsewhere rmz-riesz-markov)
       (status proven)
       (deviation "The user's route of notes-63, form (b): the Cantor model K of X (consistent 0-1 sequences over a countable family of closed balls), pi : K -> X continuous onto, Riesz-Markov on K, the positive (M. Riesz) extension, push-forward. Uniqueness and regularity of the measure are not stated.")
       (notes-statement "A positive linear functional on C(X), X compact metric, is integration against a Borel measure."))

;;; ===== topological-vector-spaces =====
;;; Document: /home/ubuntu/docs/topological-vector-space.pdf, "Topological Vector Spaces", F. Javier Thayer.
