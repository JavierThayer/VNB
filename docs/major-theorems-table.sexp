;;; ===== ch. 1 section 5: Ordering for C*-algebras =====
(entry (doc "banach-algebras")
       (ref "1.37")
       (section "1.5" prefilled)
       (kind proposition)
       (title "Positivity in C(X) is pointwise")
       (names ccont-positive-iff-nonneg ccont-pos-cone-nonneg ccont-nonneg-pos-cone)
       (status proven)
       (deviation "POS-CONE (Def 1.34) is defined in basw2-vocab: the members of VEC(a) lying in every subset that contains all x* x and is closed under +, i.e. the finite sums of x* x. 'f(x) >= 0' is written 'f(x) in RR and 0 <= f(x)'. Backward direction: f = g* g with g = sqrt(|Re f|). Stated for any compact TOP-SPACE, with no Hausdorff or nonemptiness hypothesis.")
       (notes-statement "X compact. f in C(X) is positive in the natural ordering of C(X) iff f(x) >= 0 for all x in X."))

(entry (doc "banach-algebras")
       (ref "1.38")
       (section "1.5" prefilled)
       (kind proposition)
       (title "The squares of self-adjoints form the positive cone")
