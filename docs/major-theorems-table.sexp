       (deviation "Non-negative case and integrable real case; 'if either side is defined both are' is pfw-integrable-iff.")
       (notes-statement "If psi : X -> Y is measurable, then for measurable f : Y -> R, integral over Y of f d(psi_* mu) = integral over X of f o psi d mu, either side defined iff the other is."))

(entry (doc "construction-of-measures")
