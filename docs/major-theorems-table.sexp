       (notes-statement "If E_i are pairwise disjoint mu*-measurable sets, then for arbitrary A, mu*(A n U E_i) = sum_i mu*(A n E_i)."))

(entry (doc "construction-of-measures")
       (ref "4.7")
       (section "4.2" prefilled)
       (kind proposition)
       (title "The method I outer measure of a pre-measure is an outer measure")
       (names method-i-outer-is-outer-measure)
       (status proven)
       (deviation "The infimum over covering sequences is EINF of COVER-SUMS, +inf when no sequence covers; the re-indexing of the double sum (esum-nn-flatten-le), the countable choice of covers and the eps / 2^(i+1) budget, all silent in the notes, are theorems.")
       (notes-statement "Suppose p is a pre-measure on C. Define mu*(E) as the infimum of the sums of p(A_i) over all sequences A_i of elements of C covering E, +infinity when there are none. Then mu* is an outer measure on X."))

(entry (doc "construction-of-measures")
       (ref "4.10")
       (section "4.2" prefilled)
       (kind proposition)
       (title "The outer measure extending a measure")
       (names method-i-outer-extends method-i-outer-measurable method-i-outer-null-iff method-i-outer-finite-approx method-i-outer-of-measure)
       (status proven)
