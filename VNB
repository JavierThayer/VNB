#!/bin/bash
# VNB -- launch the VNB proof checker in a styled Emacs workspace.
#
# Usage:
#   VNB                start GUI Emacs with the VNB workspace
#   VNB -nw            terminal-only mode (uses -nw)
#   VNB --no-workspace fall back to the plain M-x vnb interface
#
# The launcher uses `emacs -Q` so it ignores the user's init file,
# guaranteeing a predictable environment.  All VNB-specific setup
# happens in vnb-launch.el.
#
# Cold boot re-proves the whole library.  That costs 24 s on a COMPILED tree
# and ~11 minutes on an interpreted one, so compile once with
# ./VNB-with-compile (or (compile-vnb!) from a REPL).
#
# There used to be a VNB_SKIP_PROOFS=1 default here, claiming a ~32x speedup by
# installing proven theorems as axioms instead of re-proving them.  It had
# silently stopped working (nothing read the variable), and it should not come
# back: it would hand you a library whose qed bills say `trust: none' about
# theorems that were never checked.

PROVER_DIR="$(cd "$(dirname "$0")" && pwd)"
# The elisp bundle lives under emacs/ (root declutter 2026-06-06).
LAUNCH_EL="$PROVER_DIR/emacs/vnb-launch.el"

if [ ! -f "$LAUNCH_EL" ]; then
    echo "VNB: cannot find $LAUNCH_EL" >&2
    exit 1
fi

EMACS_ARGS=(-Q -l "$LAUNCH_EL")

case "$1" in
  -nw)
    EMACS_ARGS=(-Q -nw -l "$LAUNCH_EL")
    ;;
  --no-workspace)
    # Skip the workspace; load plain vnb.el and run M-x vnb.
    EMACS_ARGS=(-Q -l "$PROVER_DIR/emacs/vnb.el" --eval "(vnb)")
    ;;
esac

exec emacs "${EMACS_ARGS[@]}"
