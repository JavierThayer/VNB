;;; ba-optop.scm -- Thayer, Banach Algebras and Applications, chapter 5 (operator topologies),
;;; first part.  The module L(H) of bounded operators, CC as a seminormed space over itself, the
;;; strong, weak and norm topologies as separating seminorm families (hence topological vector
;;; spaces); the comparisons norm > strong > weak; Prop 5.11 (S |-> S T and S |-> T S continuous for
;;; the weak and the strong topology); the vector functionals T |-> <T xi | eta> in the weak and the
;;; strong dual (5.1 sufficiency for one term, the first half of the proof of 5.6), and the weak dual
;;; inside the strong dual (one inclusion of 5.7).
;;; Agent BA-OT1, 2026-11-10.  DESTINATION: theorem-library/, after ba-bh2.scm and tvs-single-bound.scm.
;;; Vocabulary: structure-library/ba-optop-vocab.scm.  Library: operator-algebras.  Helper prefix: ot-.

(define (ot-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (ot-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ba-optop: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))

(define ot-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ot-BO '(BOUNDED-OPS v v))
(define ot-M '(BH-MODULE v))
(define ot-CV '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define (ot-has? h e) (or (equal? h e) (and (pair? e) (or (ot-has? h (car e)) (ot-has? h (cdr e))))))
(define (ot-nth-loop!)
  (let loop ((k 0)) (if (and (< k 40) (not (ot-done?)) (ot-has? 'NTH (dk-goal))) (begin (nth-r) (loop (+ k 1))))))

;;; the typings of B(H)'s module operations and of the scalar ring
(define (ot-typings!)
  (dk-cite! 'bounded-ops-is-set 'v 'v)
  (for-each (lambda (n) (dk-cite! n 'v)) '(bh-vadd-type bh-vneg-type bh-act-type))
  (dk-cite! 'bop-zero-bounded 'v 'v)
  (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring ot-ccr))

