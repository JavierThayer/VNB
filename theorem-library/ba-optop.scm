(define ot-VV '(CARTESIAN (VEC v) (VEC v)))
(sp (make-wff (forall-guarded '(v) ot-CV (list 'IN '(WOT-PF v) (list 'FUN ot-VV '(FUN (BOUNDED-OPS v v) RR))))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(mac 'WOT-PF)
(dk-lam-type!
  (lambda ()
