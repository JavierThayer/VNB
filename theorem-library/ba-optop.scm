;;; THE DUALS
(define (ot-unfold! name stmt fn)
  (sp (make-wff stmt)) (dk-peel!) (for-each mac (if (pair? fn) fn (list fn))) (qrfl) (ot-qed! name))
(ot-unfold! 'op-dual-unfold
  '(FORALL v (FORALL u (== (OP-DUAL v u)
     (SEP otf_ (FUN (BOUNDED-OPS v v) CC)
       (AND (IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE otf_) (IS-HOM-TOP-SPACE u CC-SN-TOP otf_))))))
  'OP-DUAL)
(ot-unfold! 'weak-dual-unfold
  '(FORALL v (== (WEAK-DUAL v)
     (SEP otf_ (FUN (BOUNDED-OPS v v) CC)
       (AND (IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE otf_) (IS-HOM-TOP-SPACE (WOT v) CC-SN-TOP otf_)))))
  '(WEAK-DUAL OP-DUAL))
(ot-unfold! 'strong-dual-unfold '(FORALL v (== (STRONG-DUAL v) (OP-DUAL v (SOT v)))) 'STRONG-DUAL)

(define (ot-in-dual! name dual cont)
  (sp (make-wff (forall-guarded '(v xi_ eta_) (append ot-CV ot-xy) (list 'IN ot-phi (list dual 'v)))))
  (dk-peel!)
  (dk-cite! 'vec-functional-type 'v 'xi_ 'eta_)
  (dk-cite! 'vec-functional-linear 'v 'xi_ 'eta_)
  (dk-cite! cont 'v 'xi_ 'eta_)
  (mac dual)
  (mac 'OP-DUAL)
  (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (ot-qed! name))
(ot-in-dual! 'vec-functional-in-weak-dual 'WEAK-DUAL 'vec-functional-wot-continuous)
(ot-in-dual! 'vec-functional-in-strong-dual 'STRONG-DUAL 'vec-functional-sot-continuous)

;;; a weakly continuous linear functional is strongly continuous
(sp (make-wff (forall-guarded '(v f_) (append ot-CV '((IN f_ (WEAK-DUAL v)))) '(IN f_ (STRONG-DUAL v)))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'cc-is-set)
(let* ((h0 '(IN f_ (WEAK-DUAL v))))
  (dk-cite! 'weak-dual-unfold 'v)
  (let* ((h2 (dk-rewrite-h! h0 '(WEAK-DUAL v)
               '(SEP otf_ (FUN (BOUNDED-OPS v v) CC)
                  (AND (IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE otf_) (IS-HOM-TOP-SPACE (WOT v) CC-SN-TOP otf_))))))
    (sep-me h2)
    (dk-split-all!)))
(define ot-idb (list 'ID-FUN ot-BOt))
(dk-cite! 'id-fun-type ot-BOt)
(dk-cite! 'sot-to-wot-continuous 'v)
(dk-cite! 'hom-top-space-compose '(SOT v) '(WOT v) 'CC-SN-TOP ot-idb 'f_)
(dk-have! (list 'AND (list 'IN ot-idb '(FUN (BOUNDED-OPS v v) (BOUNDED-OPS v v))) '(IN f_ (FUN (BOUNDED-OPS v v) CC))))
(dk-cite! 'compose-type ot-BOt ot-BOt 'CC 'f_ ot-idb)
(let ((eqn (dk-fun-ext! (list 'COMPOSE 'f_ ot-idb) 'f_ ot-BOt 'CC #f #f
             (lambda (z)
               (dk-apply! (dk-cite! 'compose-apply ot-BOt ot-BOt 'CC 'f_ ot-idb) z)
               (subst (list '= (list (list 'COMPOSE 'f_ ot-idb) z) (list 'f_ (list ot-idb z))))
               (subst (dk-cite! 'id-fun-apply ot-BOt z))
               (dk-cite! 'fun-apply-type-c 'f_ ot-BOt 'CC z)
               (if (not (ot-done?)) (rfl))))))
  (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE '(SOT v) 'CC-SN-TOP (list 'COMPOSE 'f_ ot-idb)) (list 'COMPOSE 'f_ ot-idb) 'f_))
(mac 'STRONG-DUAL)
(mac 'OP-DUAL)
(in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass)))))
(ot-qed! 'weak-dual-subset-strong-dual)
