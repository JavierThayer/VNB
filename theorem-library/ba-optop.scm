;;; THE SCALARS: CC as a module over itself, seminormed by |.|
(define ot-ccm '(RING-AS-MODULE (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
(define ot-ccm-pairs
  (list (list 'SCAL 'ram-ro-scal ot-ccr) (list 'VEC 'ram-ro-vec (list 'CARR ot-ccr))
        (list 'VADD 'ram-ro-vadd (list 'ADD ot-ccr)) (list 'VZERO 'ram-ro-vzero (list 'ZERO ot-ccr))
        (list 'VNEG 'ram-ro-vneg (list 'NEG ot-ccr)) (list 'ACT 'ram-ro-act (list 'MUL ot-ccr))))
(define (ot-ccm-readoff! name acc thm)
  (sp (make-wff (list '== (list acc 'CC-SN-MODULE)
                      (cadr (assq acc (map (lambda (p) (list (car p) (caddr p))) ot-ccm-pairs))))))
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring ot-ccr)
  (subst (dk-cite! 'cc-sn-module-def))
  (subst (dk-cite! thm ot-ccr))
  (if (not (ot-done?)) (qrfl))
  (ot-qed! name))
(for-each (lambda (p) (ot-ccm-readoff! (symbol-append 'cc-sn-module- (car p)) (car p) (cadr p))) ot-ccm-pairs)

(sp (make-wff '(IS-MODULE CC-SN-MODULE)))
(dk-cite! 'cc-is-normed-field)
(dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(dk-cite! 'commutative-ring-is-ring ot-ccr)
(dk-cite! 'ring-as-module-is-module ot-ccr)
(subst (dk-cite! 'cc-sn-module-def))
(ass)
(ot-qed! 'cc-sn-module-is-module)

;;; the scalar-ring equations as values on CC
(define (ot-ccring-subst!)
  (for-each (lambda (pr) (if (ot-has? (car pr) (dk-goal)) (subst (dk-cite! (cadr pr)))))
            (list (list (list 'VEC 'CC-SN-MODULE) 'cc-sn-module-vec) (list (list 'VADD 'CC-SN-MODULE) 'cc-sn-module-vadd)
                  (list (list 'VZERO 'CC-SN-MODULE) 'cc-sn-module-vzero) (list (list 'ACT 'CC-SN-MODULE) 'cc-sn-module-act)
                  (list (list 'VNEG 'CC-SN-MODULE) 'cc-sn-module-vneg) (list (list 'SCAL 'CC-SN-MODULE) 'cc-sn-module-scal)))
  (for-each (lambda (pr) (if (ot-has? (car pr) (dk-goal)) (subst (dk-cite! (cadr pr)))))
            (list (list (list 'CARR ot-ccr) 'cc-scalar-ring-carr) (list (list 'ADD ot-ccr) 'cc-scalar-ring-add)
                  (list (list 'MUL ot-ccr) 'cc-scalar-ring-mul) (list (list 'ZERO ot-ccr) 'cc-scalar-ring-zero)
                  (list (list 'NEG ot-ccr) 'cc-scalar-ring-neg)))
  #t)

;;; the family {|.|} indexed by {0}, the constant unfolded while it is still an ARGUMENT (an applied
;;; registered constant is not rewritten in operator position)
(define ot-ccpf '(VNB-LAMBDA otk_ (PAIR 0 0) (VNB-LAMBDA otz_ CC (magnitude otz_))))
(define (ot-mag-typer!) (let ((x (dk-di-var!))) (dk-cite! 'cc-magnitude-closed x) (if (not (ot-done?)) (ass))))
(define (ot-beta-h-to! target)        ; beta-reduce context hypotheses until TARGET is in context
  (let loop ((n 0))
    (if (and (< n 6) (not (dk-asm? target)))
        (let ((h (dk-pick (lambda (f) (and (dk--redex? f) (dk-head-is? f '=) (equal? (caddr f) (caddr target))
                                           (ot-has? (cadr (cadr target)) f)))
                          "a hypothesis with a redex")))
          (dk-lam-b-h! h) (loop (+ n 1)))))
  (if (not (dk-asm? target)) (error "ot-beta-h-to!: did not land" (expression->string target))))

(sp (make-wff '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD CC-SN-MODULE (PAIR 0 0) CC-SN-PF)))
(dk-cite! 'cc-is-normed-field)
(dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(dk-cite! 'commutative-ring-is-ring ot-ccr)
(dk-cite! 'cc-sn-module-is-module)
(dk-cite! 'cc-is-set) (dk-cite! 'cc-zero-in)
(dk-cite! 'nn-zero-in)
(dk-cite! 'membership-implies-sethood 0 'NN)
(dk-have! '(AND (IN 0 SET) (IN 0 SET)))
(dk-cite! 'pairing 0 0)
(dk-cite! 'pair-self-member 0)
(subst (dk-cite! 'cc-sn-pf-def))
(mac 'IS-SEMINORM-FAMILY-ON)
(ot-ccring-subst!)
(define (ot-cc-seminorm-closer!)
  (let ((g (dk-goal)))
    (cond
      ((ot-done?) #t)
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
      ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'FUN))
       (dk-lam-type! (lambda () (dk-di-var!) (dk-lam-type! ot-mag-typer!))))
      ((dk-contains? g 'IS-SEMINORM)
       (let* ((k (dk-di-var!)))
         (dk-lam-b!)
         (mac 'IS-SEMINORM)
         (ot-ccring-subst!)
         (dk-conj-close!
           (lambda ()
             (let ((g2 (dk-goal)))
               (cond
                 ((ot-done?) #t)
                 ((dk-asm? g2) (ass))
                 ((and (dk-head-is? g2 '=) (equal? (cadr g2) (caddr g2))) (rfl))
                 ((dk-head-is? g2 'IN) (dk-lam-type! ot-mag-typer!))
                 ((dk-contains? g2 'FNRM)
                  (dk-peel!) (ot-cc-homog!))
                 ((dk-contains? g2 '+) (dk-peel!) (ot-cc-tri!))
                 (#t
                  (let ((x (dk-di-var!)))
                    (dk-lam-b!)
                    (dk-cite! 'cc-magnitude-nonneg x)
                    (if (not (ot-done?)) (ass))))))))))
      (#t                                    ; separation
       (let ((x (dk-di-var!)))
         (di)
         (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f x))) "the vanishing hypothesis")))
           (dk-apply! h 0)
           (ot-beta-h-to! (list '= (list 'magnitude x) 0))
           (let ((iff (dk-cite! 'cc-magnitude-zero-iff x)))
             (dk-have! (list '= x 0)
               (lambda () (dk-only! iff (list '= (list 'magnitude x) 0)) (prop)))
             (if (not (ot-done?)) (ass)))))))))
;;; the typed variables of the goal, read off the context: the two CC-typed eigenvariables the peel landed
(define (ot-cc-vars)
  (let loop ((as (dk-asms)) (acc '()))
    (cond ((null? as) (reverse acc))
          ((and (dk-head-is? (car as) 'IN) (eq? (caddr (car as)) 'CC) (symbol? (cadr (car as)))
                (ot-has? (cadr (car as)) (dk-goal)) (not (memq (cadr (car as)) acc)))
           (loop (cdr as) (cons (cadr (car as)) acc)))
          (#t (loop (cdr as) acc)))))
(define (ot-fnrm-arg e)
  (cond ((not (pair? e)) #f)
        ((and (pair? (car e)) (equal? (car e) '(FNRM CC-NORMED-FIELD))) (cadr e))
        (#t (or (ot-fnrm-arg (car e)) (ot-fnrm-arg (cdr e))))))
(define (ot-cc-beta! closed)          ; type both binary combinations of the two CC variables, then beta
  (let* ((vs (ot-cc-vars)) (x (car vs)) (y (cadr vs)))
    (dk-have! (list 'AND (list 'IN x 'CC) (list 'IN y 'CC)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list 'IN x 'CC)))
    (dk-cite! closed x y) (dk-cite! closed y x)
    (let loop ((n 0)) (if (and (< n 4) (dk--redex? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1)))))
    vs))
(define (ot-cc-homog!)                ; |lam * x| = FNRM(lam) * |x|
  (ot-cc-beta! 'cc-mul-closed)
  (let* ((lam (ot-fnrm-arg (dk-goal)))
         (x (car (filter (lambda (v) (not (eq? v lam))) (ot-cc-vars)))))
    (subst (dk-cite! 'cc-nf-fnrm-apply lam))
    (dk-cite! 'cc-magnitude-mul lam x)
    (if (not (ot-done?)) (ass))))
(define (ot-cc-tri!)
  (ot-cc-beta! 'cc-add-closed)
  (let* ((g (dk-goal)) (sum (cadr (cadr g))) (x (cadr sum)) (y (caddr sum)))
    (dk-cite! 'cc-magnitude-triangle x y)
    (if (not (ot-done?)) (ass))))
(dk-conj-close! ot-cc-seminorm-closer!)
(ot-qed! 'cc-sn-family)

(sp (make-wff '(IS-TVS CC-NORMED-FIELD CC-SN-MODULE CC-SN-TOP)))
(dk-cite! 'cc-sn-family)
(dk-cite! 'seminorm-top-is-tvs 'CC-NORMED-FIELD 'CC-SN-MODULE '(PAIR 0 0) 'CC-SN-PF)
(subst (dk-cite! 'cc-sn-top-def))
(ass)
(ot-qed! 'cc-sn-top-is-tvs)

