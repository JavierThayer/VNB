;;; THE MODULE L(H): read-offs and IS-MODULE
(define ot-accs '(SCAL VEC VADD VZERO VNEG ACT))
(define ot-vals (list ot-ccr ot-BO '(BH-VADD v) '(BOP-ZERO v v) '(BH-VNEG v) '(BH-ACT v)))
(define (ot-mod-readoff! name acc val)
  (sp (make-wff (forall-guarded '(v) ot-CV (list '== (list acc ot-M) val))))
  (dk-peel!)
  (ot-typings!)
  (mac 'BH-MODULE)
  (slot acc)
  (ot-nth-loop!)
  (if (not (ot-done?)) (qrfl))
  (ot-qed! name))
(for-each (lambda (acc val) (ot-mod-readoff! (symbol-append 'bh-module- acc) acc val)) ot-accs ot-vals)

(define (ot-closer!)
  (let ((g (dk-goal)))
    (cond ((ot-done?) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET) (dk-head-is? (cadr g) 'LIST)) (dk-list-in-set!))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (len-r) (if (not (ot-done?)) (arith)))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((ot-has? (list 'CARR ot-ccr) g) (subst (dk-cite! 'cc-scalar-ring-carr)) (ot-closer!))
          (#t (ass)))))

(sp (make-wff (forall-guarded '(v) ot-CV (list 'IS-MODULE ot-M))))
(dk-peel!)
(ot-typings!)
(for-each (lambda (n) (dk-cite! n 'v))
          '(bh-vadd-assoc bh-vadd-comm bh-vadd-ident bh-vadd-inv bh-act-vadd bh-act-add bh-act-mul bh-act-one))
(mac 'BH-MODULE)
(mac 'is-module)
(for-each (lambda (a) (if (ot-has? a (dk-goal)) (slot a))) ot-accs)
(ot-nth-loop!)
(dk-conj-close! ot-closer!)
(ot-qed! 'bh-module-is-module)

;;; the module facts every family proof needs, landed in context
(define (ot-mod-setup!)
  (ot-typings!)
  (dk-cite! 'bh-module-is-module 'v)
  (for-each (lambda (acc) (dk-cite! (symbol-append 'bh-module- acc) 'v)) ot-accs))
;;; rewrite the module's accessors in the focus goal to B(H)'s operations
(define (ot-mod-subst!)
  (for-each (lambda (acc val) (if (ot-has? (list acc ot-M) (dk-goal)) (subst (list '== (list acc ot-M) val))))
            ot-accs ot-vals)
  (if (ot-has? (list 'CARR ot-ccr) (dk-goal)) (subst (dk-cite! 'cc-scalar-ring-carr))))

