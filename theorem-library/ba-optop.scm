;;; THE STRONG OPERATOR TOPOLOGY
(sp (make-wff (forall-guarded '(v) ot-CV '(IN (SOT-PF v) (FUN (VEC v) (FUN (BOUNDED-OPS v v) RR))))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(mac 'SOT-PF)
(dk-lam-type!
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-lam-type!
        (lambda ()
          (let ((t (dk-di-var!)))
            (dk-cite! 'bop-fun 'v 'v t)
            (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC v) x)
            (dk-cite! 'ip-norm-in-rr 'v (list t x))
            (if (not (ot-done?)) (ass))))))))
(ot-qed! 'sot-pf-type)

(sp (make-wff (forall-guarded '(v x_ t_) (append ot-CV '((IN x_ (VEC v)) (IN t_ (BOUNDED-OPS v v))))
   '(= (((SOT-PF v) x_) t_) (IP-NORM v (t_ x_))))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) 'x_)
(dk-cite! 'ip-norm-in-rr 'v '(t_ x_))
(mac 'SOT-PF)
(dk-lam-b!)
(if (not (ot-done?)) (rfl))
(ot-qed! 'sot-pf-apply)

;;; p_xi is a seminorm on L(H)
(sp (make-wff (forall-guarded '(v x_) (append ot-CV '((IN x_ (VEC v))))
   '(IS-SEMINORM CC-NORMED-FIELD (BH-MODULE v) ((SOT-PF v) x_)))))
(dk-peel!)
(ot-mod-setup!)
(dk-cite! 'sot-pf-type 'v)
(dk-cite! 'fun-apply-type-c '(SOT-PF v) '(VEC v) '(FUN (BOUNDED-OPS v v) RR) 'x_)
(mac 'IS-SEMINORM)
(ot-mod-subst!)
(define (ot-sot-pt! t) (dk-cite! 'bop-fun 'v 'v t) (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC v) 'x_))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((ot-done?) #t)
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
        ((dk-contains? g 'FNRM)                     ; homogeneity
         (let* ((pl (dk-peel!)) (lam (cadr (car pl))) (t (cadr (cadr pl)))
                (ct (list 'BOP-SCALE 'v 'v lam t)))
           (subst (dk-cite! 'bh-act-value 'v lam t))
           (dk-cite! 'bop-scale-bounded 'v 'v lam t)
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ ct))
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ t))
           (subst (dk-cite! 'cc-nf-fnrm-apply lam))
           (ot-sot-pt! t)
           (subst (dk-cite! 'bop-scale-apply 'v 'v lam t 'x_))
           (dk-cite! 'ip-norm-act 'v lam (list t 'x_))
           (if (not (ot-done?)) (ass))))
        ((dk-contains? g '+)                        ; subadditivity
         (let* ((pl (dk-peel!)) (s (cadr (car pl))) (t (cadr (cadr pl)))
                (st (list 'BOP-SUM 'v 'v s t)))
           (subst (dk-cite! 'bh-vadd-value 'v s t))
           (dk-cite! 'bop-sum-bounded 'v 'v s t)
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ st))
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ s))
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ t))
           (ot-sot-pt! s) (ot-sot-pt! t)
           (subst (dk-cite! 'bop-sum-apply 'v 'v s t 'x_))
           (dk-cite! 'cips-minkowski 'v (list s 'x_) (list t 'x_))
           (if (not (ot-done?)) (ass))))
        (#t                                         ; nonnegativity
         (let ((t (dk-di-var!)))
           (subst (dk-cite! 'sot-pf-apply 'v 'x_ t))
           (ot-sot-pt! t)
           (dk-cite! 'ip-norm-nonneg 'v (list t 'x_))
           (if (not (ot-done?)) (ass))))))))
(ot-qed! 'sot-seminorm)

;;; an operator killed by every p_xi is 0 (the family separates)
(define (ot-zero-ext! t ptwise)       ; land (= t (BOP-ZERO v v)) from a pointwise prover of (= (t z) (VZERO v))
  (dk-cite! 'bop-fun 'v 'v t)
  (dk-cite! 'bop-fun 'v 'v '(BOP-ZERO v v))
  (dk-fun-ext! t '(BOP-ZERO v v) '(VEC v) '(VEC v) #f #f
    (lambda (z)
      (dk-cite! 'cips-vzero-in 'v)
      (subst (dk-cite! 'bop-zero-apply 'v 'v z))
      (ptwise z))))
(sp (make-wff (forall-guarded '(v t_) (append ot-CV '((IN t_ (BOUNDED-OPS v v))))
   '(IMPLIES (FORALL otx_ (IMPLIES (IN otx_ (VEC v)) (= (((SOT-PF v) otx_) t_) 0)))
             (= t_ (BOP-ZERO v v))))))
(dk-peel!)
(ot-typings!)
(let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SOT-PF))) "the vanishing hypothesis")))
  (ot-zero-ext! 't_
    (lambda (z)
      (let* ((h0 (dk-apply! h z)))
        (dk-cite! 'bop-fun 'v 'v 't_)
        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) z)
        (dk-cite! 'sot-pf-apply 'v z 't_)
        (dk-rewrite-h! h0 (list (list '(SOT-PF v) z) 't_) (list 'IP-NORM 'v (list 't_ z)))
        (dk-cite! 'ip-norm-zero-vector 'v (list 't_ z))
        (if (not (ot-done?)) (ass))))))
(ot-qed! 'sot-separating)

(define (ot-family! name pfty idx pf seminorm separating)
  (sp (make-wff (forall-guarded '(v) ot-CV (list 'IS-SEMINORM-FAMILY-ON 'CC-NORMED-FIELD ot-M idx pf))))
  (dk-peel!)
  (ot-mod-setup!)
  (dk-cite! pfty 'v)
  (mac 'IS-SEMINORM-FAMILY-ON)
  (ot-mod-subst!)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((ot-done?) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET))
           (cond ((dk-head-is? (cadr g) 'CARTESIAN)
                  (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                 ((dk-head-is? (cadr g) 'PAIR)
                  (dk-cite! 'nn-zero-in) (dk-cite! 'membership-implies-sethood 0 'NN)
                  (dk-have! '(AND (IN 0 SET) (IN 0 SET))) (dk-cite! 'pairing 0 0) (if (not (ot-done?)) (ass)))
                 (#t (ass))))
          ((dk-contains? g 'IS-SEMINORM)
           (let ((i (dk-di-var!)))
             (dk-cite! seminorm 'v i)
             (if (not (ot-done?)) (ass))))
          (#t
           (let ((t (dk-di-var!)))
             (di)
             (dk-cite! separating 'v t)
             (if (not (ot-done?)) (ass))))))))
  (ot-qed! name))
(ot-family! 'sot-seminorm-family 'sot-pf-type '(VEC v) '(SOT-PF v) 'sot-seminorm 'sot-separating)

(define (ot-tvs! name fam idx pf top)
  (sp (make-wff (forall-guarded '(v) ot-CV (list 'IS-TVS 'CC-NORMED-FIELD ot-M (list top 'v)))))
  (dk-peel!)
  (dk-cite! fam 'v)
  (dk-cite! 'seminorm-top-is-tvs 'CC-NORMED-FIELD ot-M idx pf)
  (mac top)
  (ass)
  (ot-qed! name))
(ot-tvs! 'sot-is-tvs 'sot-seminorm-family '(VEC v) '(SOT-PF v) 'SOT)

