;;; =============================================================================================
;;; PARTS C, D: the norm topology is finer than the strong, the strong finer than the
;;; weak (the identity maps are continuous), and Prop 5.11: S |-> S T and S |-> T S are continuous
;;; for the weak (and for the strong) operator topology.

(define ot-BOt '(BOUNDED-OPS v v))
(define (ot-op-at! t x)               ; t in BO, x in VEC v: land t in FUN, (t x) in VEC v
  (dk-cite! 'bop-fun 'v 'v t)
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC v) x))

;;; ---------------------------------------------------------------------------------------------
;;; LINEARITY OF THE THREE MAPS
;;; F the map (ID-FUN or a lambda over BO), BODY its value at s, TYPER lands (BODY s) in BO,
;;; ADD-LAW / SCALE-LAW land the distributive equations.
(define (ot-lin-thm! name vars hyps F body typer add-law scale-law)
  (sp (make-wff (forall-guarded vars (append ot-CV hyps) (list 'IS-LINEAR-MAP ot-M ot-M F))))
  (dk-peel!)
  (ot-mod-setup!)
  (mac 'IS-LINEAR-MAP)
  (if (dk-contains? (dk-goal) 'ID-FUN) (mac 'ID-FUN))
  (ot-mod-subst!)
  (let ((finish! (lambda () (if (not (ot-done?)) (let ((g (dk-goal))) (if (equal? (cadr g) (caddr g)) (rfl) (ass)))))))
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((ot-done?) #t)
            ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
            ((dk-head-is? g 'IN)
             (dk-lam-type! (lambda () (let ((s (dk-di-var!))) (typer s) (if (not (ot-done?)) (ass))))))
            ((dk-contains? g 'BH-ACT)
             (let* ((pl (dk-peel!)) (c (cadr (car pl))) (s (cadr (cadr pl))))
               (subst (dk-cite! 'bh-act-value 'v c s))
               (dk-cite! 'bop-scale-bounded 'v 'v c s)
               (dk-lam-b!)
               (typer s)
               (subst (dk-cite! 'bh-act-value 'v c (body s)))
               (scale-law c s)
               (finish!)))
            (#t
             (let* ((pl (dk-peel!)) (s (cadr (car pl))) (t (cadr (cadr pl))))
               (subst (dk-cite! 'bh-vadd-value 'v s t))
               (dk-cite! 'bop-sum-bounded 'v 'v s t)
               (dk-lam-b!)
               (typer s) (typer t)
               (subst (dk-cite! 'bh-vadd-value 'v (body s) (body t)))
               (add-law s t)
               (finish!))))))))
  (ot-qed! name))

(ot-lin-thm! 'bh-id-linear '(v) '() (list 'ID-FUN ot-BOt)
  (lambda (s) s) (lambda (s) #t) (lambda (s t) #t) (lambda (c s) #t))
(define ot-rmul (list 'VNB-LAMBDA 'ots_ ot-BOt '(BOP-COMP v ots_ t_)))
(define ot-lmul (list 'VNB-LAMBDA 'ots_ ot-BOt '(BOP-COMP v t_ ots_)))
(ot-lin-thm! 'bop-right-mult-linear '(v t_) (list '(IN t_ (BOUNDED-OPS v v))) ot-rmul
  (lambda (s) (list 'BOP-COMP 'v s 't_))
  (lambda (s) (dk-cite! 'bop-comp-bounded 'v s 't_))
  (lambda (s t) (dk-cite! 'bop-comp-sum-left 'v s t 't_))
  (lambda (c s) (dk-cite! 'bop-comp-scale-left 'v c s 't_)))
(ot-lin-thm! 'bop-left-mult-linear '(v t_) (list '(IN t_ (BOUNDED-OPS v v))) ot-lmul
  (lambda (s) (list 'BOP-COMP 'v 't_ s))
  (lambda (s) (dk-cite! 'bop-comp-bounded 'v 't_ s))
  (lambda (s t) (dk-cite! 'bop-comp-sum-right 'v 't_ s t))
  (lambda (c s) (dk-cite! 'bop-comp-scale-right 'v c 't_ s)))

;;; ---------------------------------------------------------------------------------------------
;;; CONTINUITY FROM SINGLE BOUNDS
;;; TOP1/TOP2 the topology functoids, IX/PF their index sets and families, FAM1/FAM2 the family
;;; theorems, LIN the linearity theorem with its extra arguments; WIT returns (i . c) for the target
;;; index j, after landing i in ix1 and the typing / sign of c; FIN! proves the bound at S.
(define (ot-cont-thm! name vars hyps top1 ix1 pf1 fam1 top2 ix2 pf2 fam2 F lin linargs wit fin!)
  (sp (make-wff (forall-guarded vars (append ot-CV hyps)
                  (list 'IS-HOM-TOP-SPACE (list top1 'v) (list top2 'v) F))))
  (dk-peel!)
  (ot-mod-setup!)
  (ot-k0-facts!)
  (dk-cite! fam1 'v) (dk-cite! fam2 'v)
  (apply dk-cite! lin 'v linargs)
  (dk-cite! 'sn-cont-of-single-bound 'CC-NORMED-FIELD ot-M ix1 pf1 ot-M ix2 pf2 F)
  (mac top1)
  (if (not (eq? top1 top2)) (mac top2))
  (let ((imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'IS-HOM-TOP-SPACE)
                                       (dk-head-is? (cadr f) 'FORALL)))
                      "the bound implication")))
    (dk-have! (cadr imp)
      (lambda ()
        (let* ((j (dk-di-var!)) (ic (wit j)))
          (ew (car ic))
          (dk-conj-close!
            (lambda ()
              (cond
                ((ot-done?) #t)
                ((dk-asm? (dk-goal)) (ass))
                (#t
                 (ew (cdr ic))
                 (dk-conj-close!
                   (lambda ()
                     (cond
                       ((ot-done?) #t)
                       ((dk-asm? (dk-goal)) (ass))
                       (#t
                        (ot-mod-subst!)
                        (let ((s (dk-di-var!)))
                          (if (dk-contains? (dk-goal) 'ID-FUN)
                              (subst (dk-cite! 'id-fun-apply ot-BOt s))
                              (dk-lam-b!))
                          (fin! j s)))))))))))))
    (detach! imp)
    (if (not (ot-done?)) (ass)))
  (ot-qed! name))

;;; (<= L (* A B)) from (<= L (* B A)) in context
(define (ot-le-comm! a b)
  (dk-have! (list 'AND (list 'IN b 'RR) (list 'IN a 'RR)))
  (dk-cite! 'rr-mul-comm b a)
  (subst (list '= (list '* a b) (list '* b a)))
  (if (not (ot-done?)) (ass)))
;;; (<= N (* 1 N))
(define (ot-le-one! n)
  (dk-cite! 'rr-one-in)
  (dk-ineq! (list 'IN n 'RR)))
(define (ot-p12! p)                   ; p in VEC x VEC: land its components
  (let ((cn (dk-cite! 'cartesian-nth p '(VEC v) '(VEC v))))
    (if (not (dk-asm? (list 'IN (list 'NTH 1 p) '(VEC v)))) (dk-split! cn)))
  (list (list 'NTH 1 p) (list 'NTH 2 p)))
(define (ot-norm-typed! y)
  (dk-cite! 'ip-norm-in-rr 'v y) (dk-cite! 'ip-norm-nonneg 'v y))

;;; the norm topology is finer than the strong operator topology: ||S x|| <= ||x|| ||S||
(ot-cont-thm! 'norm-to-sot-continuous '(v) '()
  'NORM-OPTOP ot-k0 '(NORM-OPTOP-PF v) 'norm-optop-seminorm-family
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  (list 'ID-FUN ot-BOt) 'bh-id-linear '()
  (lambda (x) (ot-norm-typed! x) (cons 0 (list 'IP-NORM 'v x)))
  (lambda (x s)
    (subst (dk-cite! 'sot-pf-apply 'v x s))
    (subst (dk-cite! 'norm-optop-pf-apply 'v 0 s))
    (ot-op-at! s x)
    (dk-cite! 'opnorm-in-rr 'v 'v s)
    (dk-apply! (dk-cite! 'opnorm-bound 'v 'v s) x)
    (ot-le-comm! (list 'IP-NORM 'v x) (list 'OPNORM 'v 'v s))))

;;; the strong operator topology is finer than the weak: |<S xi | eta>| <= ||eta|| ||S xi||
(ot-cont-thm! 'sot-to-wot-continuous '(v) '()
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  (list 'ID-FUN ot-BOt) 'bh-id-linear '()
  (lambda (p) (let ((pc (ot-p12! p))) (ot-norm-typed! (cadr pc)) (cons (car pc) (list 'IP-NORM 'v (cadr pc)))))
  (lambda (p s)
    (let* ((pc (ot-p12! p)) (p1 (car pc)) (p2 (cadr pc)))
      (subst (dk-cite! 'wot-pf-apply 'v p s))
      (subst (dk-cite! 'sot-pf-apply 'v p1 s))
      (ot-op-at! s p1)
      (dk-cite! 'ip-norm-in-rr 'v (list s p1))
      (dk-cite! 'ip-norm-in-rr 'v p2)
      (dk-cite! 'cips-ip-magnitude-le 'v (list s p1) p2)
      (ot-le-comm! (list 'IP-NORM 'v p2) (list 'IP-NORM 'v (list s p1))))))

;;; Prop 5.11, S |-> S T
(define (ot-comp-typed! s)
  (dk-cite! 'bop-fun 'v 'v s) (dk-cite! 'bop-fun 'v 'v 't_)
  (dk-cite! 'bop-comp-bounded 'v s 't_) (dk-cite! 'bop-comp-bounded 'v 't_ s))
(ot-cont-thm! 'bop-right-mult-sot-continuous '(v t_) (list '(IN t_ (BOUNDED-OPS v v)))
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  ot-rmul 'bop-right-mult-linear '(t_)
  (lambda (x) (ot-op-at! 't_ x) (dk-cite! 'rr-one-in) (dk-have! '(<= 0 1) (lambda () (dk-ineq!))) (cons (list 't_ x) 1))
  (lambda (x s)
    (ot-comp-typed! s)
    (let ((cs (list 'BOP-COMP 'v s 't_)) (tx (list 't_ x)))
      (subst (dk-cite! 'sot-pf-apply 'v x cs))
      (subst (dk-cite! 'sot-pf-apply 'v tx s))
      (ot-op-at! 't_ x)
      (subst (dk-cite! 'bop-comp-apply 'v s 't_ x))
      (ot-op-at! s tx)
      (dk-cite! 'ip-norm-in-rr 'v (list s tx))
      (ot-le-one! (list 'IP-NORM 'v (list s tx))))))

(ot-cont-thm! 'bop-right-mult-wot-continuous '(v t_) (list '(IN t_ (BOUNDED-OPS v v)))
  'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  ot-rmul 'bop-right-mult-linear '(t_)
  (lambda (p)
    (let* ((pc (ot-p12! p)) (tp (list 't_ (car pc))))
      (ot-op-at! 't_ (car pc))
      (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) tp (cadr pc))
      (dk-cite! 'rr-one-in) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
      (cons (list 'LIST tp (cadr pc)) 1)))
  (lambda (p s)
    (ot-comp-typed! s)
    (let* ((pc (ot-p12! p)) (p1 (car pc)) (p2 (cadr pc)) (tp (list 't_ p1)) (cs (list 'BOP-COMP 'v s 't_)))
      (ot-op-at! 't_ p1)
      (subst (dk-cite! 'wot-pf-apply 'v p cs))
      (subst (dk-cite! 'wot-pf-apply-pair 'v tp p2 s))
      (subst (dk-cite! 'bop-comp-apply 'v s 't_ p1))
      (ot-op-at! s tp)
      (dk-cite! 'cips-ip-type 'v (list s tp) p2)
      (dk-cite! 'cc-magnitude-closed (list '(IP v) (list s tp) p2))
      (ot-le-one! (list 'magnitude (list '(IP v) (list s tp) p2))))))

;;; Prop 5.11, S |-> T S
(ot-cont-thm! 'bop-left-mult-sot-continuous '(v t_) (list '(IN t_ (BOUNDED-OPS v v)))
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  ot-lmul 'bop-left-mult-linear '(t_)
  (lambda (x) (dk-cite! 'opnorm-in-rr 'v 'v 't_) (dk-cite! 'opnorm-nonneg 'v 'v 't_) (cons x '(OPNORM v v t_)))
  (lambda (x s)
    (ot-comp-typed! s)
    (let ((cs (list 'BOP-COMP 'v 't_ s)) (sx (list s x)))
      (subst (dk-cite! 'sot-pf-apply 'v x cs))
      (subst (dk-cite! 'sot-pf-apply 'v x s))
      (ot-op-at! s x)
      (subst (dk-cite! 'bop-comp-apply 'v 't_ s x))
      (dk-apply! (dk-cite! 'opnorm-bound 'v 'v 't_) sx)
      (if (not (ot-done?)) (ass)))))

(ot-cont-thm! 'bop-left-mult-wot-continuous '(v t_) (list '(IS-HILBERT-SPACE v) '(IN t_ (BOUNDED-OPS v v)))
  'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  ot-lmul 'bop-left-mult-linear '(t_)
  (lambda (p)
    (let* ((pc (ot-p12! p)) (ta (list '(OP-ADJOINT v v t_) (cadr pc))))
      (dk-cite! 'op-adjoint-bounded 'v 'v 't_)
      (dk-cite! 'bop-fun 'v 'v '(OP-ADJOINT v v t_))
      (dk-cite! 'fun-apply-type-c '(OP-ADJOINT v v t_) '(VEC v) '(VEC v) (cadr pc))
      (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (car pc) ta)
      (dk-cite! 'rr-one-in) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
      (cons (list 'LIST (car pc) ta) 1)))
  (lambda (p s)
    (ot-comp-typed! s)
    (let* ((pc (ot-p12! p)) (p1 (car pc)) (p2 (cadr pc)) (sp1 (list s p1)) (cs (list 'BOP-COMP 'v 't_ s))
           (ta (list '(OP-ADJOINT v v t_) p2)))
      (dk-cite! 'op-adjoint-bounded 'v 'v 't_)
      (dk-cite! 'bop-fun 'v 'v '(OP-ADJOINT v v t_))
      (dk-cite! 'fun-apply-type-c '(OP-ADJOINT v v t_) '(VEC v) '(VEC v) p2)
      (subst (dk-cite! 'wot-pf-apply 'v p cs))
      (subst (dk-cite! 'wot-pf-apply-pair 'v p1 ta s))
      (subst (dk-cite! 'bop-comp-apply 'v 't_ s p1))
      (ot-op-at! s p1)
      (subst (dk-cite! 'op-adjoint-ip 'v 'v 't_ sp1 p2))
      (dk-cite! 'cips-ip-type 'v sp1 ta)
      (dk-cite! 'cc-magnitude-closed (list '(IP v) sp1 ta))
      (ot-le-one! (list 'magnitude (list '(IP v) sp1 ta))))))


;;; =============================================================================================
;;; PART E: the vector functionals T |-> <T xi | eta> are linear and weakly (hence
;;; strongly) continuous -- Prop 5.1 sufficiency for one term, the seminorms of the weak operator
;;; topology are |phi| for phi in the strong dual (the first half of the proof of Prop 5.6) -- and
;;; every weakly continuous functional is strongly continuous (one inclusion of Cor 5.7).

(define ot-phi '(VEC-FUNCTIONAL v xi_ eta_))
(define ot-xy '((IN xi_ (VEC v)) (IN eta_ (VEC v))))
(define (ot-cc-facts!)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'cc-is-set)
  (dk-cite! 'cc-sn-module-is-module)
  (for-each (lambda (n) (dk-cite! n))
            '(cc-sn-module-scal cc-sn-module-vec cc-sn-module-vadd cc-sn-module-vzero cc-sn-module-vneg cc-sn-module-act)))
(define (ot-ip-typed! s)              ; s in BO: land (s xi_) in VEC v and <s xi_ | eta_> in CC
  (ot-op-at! s 'xi_)
  (dk-cite! 'cips-ip-type 'v (list s 'xi_) 'eta_))

(sp (make-wff (forall-guarded '(v xi_ eta_) (append ot-CV ot-xy) (list 'IN ot-phi '(FUN (BOUNDED-OPS v v) CC)))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(mac 'VEC-FUNCTIONAL)
(dk-lam-type! (lambda () (let ((s (dk-di-var!))) (ot-ip-typed! s) (if (not (ot-done?)) (ass)))))
(ot-qed! 'vec-functional-type)

(sp (make-wff (forall-guarded '(v xi_ eta_ t_) (append ot-CV ot-xy '((IN t_ (BOUNDED-OPS v v))))
   (list '= (list ot-phi 't_) '((IP v) (t_ xi_) eta_)))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(ot-ip-typed! 't_)
(mac 'VEC-FUNCTIONAL)
(dk-lam-b!)
(if (not (ot-done?)) (rfl))
(ot-qed! 'vec-functional-apply)

(sp (make-wff (forall-guarded '(v xi_ eta_) (append ot-CV ot-xy) (list 'IS-LINEAR-MAP ot-M 'CC-SN-MODULE ot-phi))))
(dk-peel!)
(ot-mod-setup!)
(ot-cc-facts!)
(dk-cite! 'vec-functional-type 'v 'xi_ 'eta_)
(mac 'IS-LINEAR-MAP)
(ot-mod-subst!)
(ot-ccring-subst!)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((ot-done?) #t)
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
        ((dk-contains? g 'BH-ACT)
         (let* ((pl (dk-peel!)) (c (cadr (car pl))) (s (cadr (cadr pl))) (cs (list 'BOP-SCALE 'v 'v c s)))
           (subst (dk-cite! 'bh-act-value 'v c s))
           (dk-cite! 'bop-scale-bounded 'v 'v c s)
           (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ cs))
           (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ s))
           (ot-ip-typed! s) (ot-ip-typed! cs)
           (dk-lam-b!)
           (subst (dk-cite! 'bop-scale-apply 'v 'v c s 'xi_))
           (dk-cite! 'cips-ip-homog-left 'v c (list s 'xi_) 'eta_)
           (if (not (ot-done?)) (ass))))
        (#t
         (let* ((pl (dk-peel!)) (s (cadr (car pl))) (t (cadr (cadr pl))) (st (list 'BOP-SUM 'v 'v s t)))
           (subst (dk-cite! 'bh-vadd-value 'v s t))
           (dk-cite! 'bop-sum-bounded 'v 'v s t)
           (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ st))
           (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ s))
           (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ t))
           (ot-ip-typed! s) (ot-ip-typed! t) (ot-ip-typed! st)
           (dk-lam-b!)
           (subst (dk-cite! 'bop-sum-apply 'v 'v s t 'xi_))
           (dk-cite! 'cips-ip-add-left 'v (list s 'xi_) (list t 'xi_) 'eta_)
           (if (not (ot-done?)) (ass))))))))
(ot-qed! 'vec-functional-linear)

;;; continuity into CC from single bounds
(define (ot-cont-cc! name top1 ix1 pf1 fam1 wit fin!)
  (sp (make-wff (forall-guarded '(v xi_ eta_) (append ot-CV ot-xy)
                  (list 'IS-HOM-TOP-SPACE (list top1 'v) 'CC-SN-TOP ot-phi))))
  (dk-peel!)
  (ot-mod-setup!)
  (ot-k0-facts!)
  (ot-cc-facts!)
  (dk-cite! fam1 'v)
  (dk-cite! 'cc-sn-pf-def)
  (dk-rewrite-h! (dk-cite! 'cc-sn-family) 'CC-SN-PF ot-ccpf)
  (dk-cite! 'vec-functional-linear 'v 'xi_ 'eta_)
  (dk-cite! 'vec-functional-type 'v 'xi_ 'eta_)
  (dk-cite! 'sn-cont-of-single-bound 'CC-NORMED-FIELD ot-M ix1 pf1 'CC-SN-MODULE ot-k0 ot-ccpf ot-phi)
  (subst (dk-cite! 'cc-sn-top-def))
  (subst (list '= 'CC-SN-PF ot-ccpf))
  (mac top1)
  (let ((imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'IS-HOM-TOP-SPACE)
                                       (dk-head-is? (cadr f) 'FORALL)))
                      "the bound implication")))
    (dk-have! (cadr imp)
      (lambda ()
        (let* ((j (dk-di-var!)) (ic (wit)))
          (ew (car ic))
          (dk-conj-close!
            (lambda ()
              (cond
                ((ot-done?) #t)
                ((dk-asm? (dk-goal)) (ass))
                (#t
                 (ew (cdr ic))
                 (dk-conj-close!
                   (lambda ()
                     (cond
                       ((ot-done?) #t)
                       ((dk-asm? (dk-goal)) (ass))
                       (#t
                        (ot-mod-subst!)
                        (let ((s (dk-di-var!)))
                          (subst (dk-cite! 'vec-functional-apply 'v 'xi_ 'eta_ s))
                          (ot-ip-typed! s)
                          (dk-lam-b!)
                          (fin! s)))))))))))))
    (detach! imp)
    (if (not (ot-done?)) (ass)))
  (ot-qed! name))

(ot-cont-cc! 'vec-functional-wot-continuous 'WOT ot-VV '(WOT-PF v) 'wot-seminorm-family
  (lambda ()
    (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) 'xi_ 'eta_)
    (dk-cite! 'rr-one-in) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (cons '(LIST xi_ eta_) 1))
  (lambda (s)
    (subst (dk-cite! 'wot-pf-apply-pair 'v 'xi_ 'eta_ s))
    (dk-cite! 'cc-magnitude-closed (list '(IP v) (list s 'xi_) 'eta_))
    (ot-le-one! (list 'magnitude (list '(IP v) (list s 'xi_) 'eta_)))))

(ot-cont-cc! 'vec-functional-sot-continuous 'SOT '(VEC v) '(SOT-PF v) 'sot-seminorm-family
  (lambda () (ot-norm-typed! 'eta_) (cons 'xi_ '(IP-NORM v eta_)))
  (lambda (s)
    (subst (dk-cite! 'sot-pf-apply 'v 'xi_ s))
    (dk-cite! 'ip-norm-in-rr 'v (list s 'xi_))
    (dk-cite! 'ip-norm-in-rr 'v 'eta_)
    (dk-cite! 'cips-ip-magnitude-le 'v (list s 'xi_) 'eta_)
    (ot-le-comm! '(IP-NORM v eta_) (list 'IP-NORM 'v (list s 'xi_)))))

