;;; ch3c-ga.scm -- Proposition 3.12 of complex-analysis.pdf: the integrals of a holomorphic f agree
;;; along a good approximation.  Prefix cg-.  Library: complex-analysis.
;;; Destination: theorem-library/good-approx.scm, after ch3c-vocab (structure-library/ca-homotopy-vocab).
;;;
;;; The notes sum a telescoping series; here the sum is an INDUCTION on the partition index with the
;;; invariant
;;;     int_[a, t_k] f over pgam  -  int_[a, t_k] f over prho  =  SEG-INT(f, prho(t_k), pgam(t_k)),
;;; each step one piece [t_k, t_{k+1}] inside a convex B_k, where f has a primitive.

(define (cg-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "cg-pick: nothing matching" what) (car l))))
(define (mh2-split-goal-cg!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (cg-and . fs) (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l))))))
(define (cg-have-and! . fs) (dk-have! (apply cg-and fs)))
;;; (IN x (CCINT lo hi)) from x, lo, hi typed and the two inequalities given as premises
(define (cg-in-ccint! x lo hi . prems)
  (let ((g (list 'IN x (list 'CCINT lo hi))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (mac 'ccint-membership)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems)))))))))

;;; ---------------------------------------------------------------------------
;;; The trace of a restriction lies in a set that holds the curve on the interval
(sp (make-wff '(FORALL cgp_ (FORALL cgs_ (FORALL cgc_ (FORALL cge_
  (IMPLIES (FORALL cgw_ (IMPLIES (IN cgw_ (CCINT cgc_ cge_)) (IN (cgp_ cgw_) cgs_)))
    (SUBSET (TRACE (RESTRICT cgp_ (CCINT cgc_ cge_)) cgc_ cge_) cgs_))))))))
(dk-peel!)
(let ((hw (cg-pick 'hw (lambda (z) (dk-head-is? z 'FORALL))))
      (rp '(RESTRICT cgp_ (CCINT cgc_ cge_))))
  (mac 'subset-def)
  (let* ((pl (dk-peel!)) (z (cadr (car pl)))
         (mz (list 'IN z (list 'TRACE rp 'cgc_ 'cge_))))
    (fact 'trace-unfold rp 'cgc_ 'cge_)
    (dk-rewrite-h! mz (list 'TRACE rp 'cgc_ 'cge_) (list 'IMAGE rp '(CCINT cgc_ cge_)))
    (let* ((iff (dk-cite! 'image-membership-iff rp '(CCINT cgc_ cge_) z)))
      (dk-have! (caddr iff) (lambda () (prop)))
      (dk-split! (caddr iff))
      (let* ((x (dk-skolem! (cg-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
        (fact 'restrict-apply 'cgp_ '(CCINT cgc_ cge_) x)
        (dk-rewrite-h! (list '= (list rp x) z) (list rp x) (list 'cgp_ x))
        (inst+ hw x)
        (subst (list '= z (list 'cgp_ x)))
        (ass)))))
(qed 'trace-restrict-in)

;;; ---------------------------------------------------------------------------
;;; On an open convex cgs_ inside u, f has ONE primitive cgg_ serving every road in cgs_
;;; (Proposition 3.8 with Eqn. (50)); f is holomorphic on the larger u.
(sp (make-wff '(FORALL u (FORALL f (FORALL cgs_ (FORALL cgz_
  (IMPLIES (HOLOMORPHIC-ON u f) (IMPLIES (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) cgs_)
  (IMPLIES (IS-CONVEX-CC cgs_) (IMPLIES (SUBSET cgs_ u) (IMPLIES (IN cgz_ cgs_)
    (FORSOME cgg_ (AND (IN cgg_ (FUN cgs_ CC))
      (FORALL cgp_ (FORALL cgd_ (FORALL cgc_ (FORALL cge_
        (IMPLIES (IS-ROAD cgp_ cgd_ cgc_ cge_) (IMPLIES (SUBSET (TRACE cgp_ cgc_ cge_) cgs_)
          (= (LINE-INT f cgp_ cgd_ cgc_ cge_) (- (cgg_ (cgp_ cge_)) (cgg_ (cgp_ cgc_)))))))))))))))))))))))
(dk-peel!)
(let* ((rf '(RESTRICT f cgs_)))
  (dk-cite! 'holomorphic-on-restrict 'u 'f 'cgs_)
  (dk-cite! 'holomorphic-on-in-fun 'cgs_ rf)
  (dk-cite! 'holomorphic-on-in-fun 'u 'f)
  (dk-cite! 'holomorphic-on-open 'u 'f)
  (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'holomorphic-on-continuous 'u 'f)
  (let* ((cp (dk-cite! 'cauchy-convex-primitive 'cgs_ rf))
         (ex (dk-apply! cp 'cgz_))
         (g (dk-skolem! ex #t))
         (dhyp (cg-pick 'dh (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-DIFF-ON) (dk-contains? z g))))))
    (witness! g
      (lambda ()
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (dk-asm? (dk-goal)) (ass)
               (let* ((pl (dk-peel!)) (g0 (dk-goal))
                      (lhs (cadr g0)) (p (caddr lhs)) (d (cadddr lhs)) (c (car (cddddr lhs))) (e (cadr (cddddr lhs)))
                      (tr (list 'TRACE p c e)))
                 (dk-cite! 'subset-trans tr 'cgs_ 'u)
                 (dk-cite! 'line-int-of-derivative 'cgs_ g rf p d c e)
                 (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ tr) (list '== (list rf 'wnx_) '(f wnx_))))
                   (lambda ()
                     (let ((z (dk-di-var!)))
                       (fact 'subset-mem-fwd tr 'cgs_ z)
                       (dk-cite! 'restrict-apply 'f 'cgs_ z)
                       (ass))))
                 (dk-cite! 'line-int-domain-congruence 'u 'f p d c e 'cgs_ rf)
                 (subst (list '= (list 'LINE-INT 'f p d c e) (list 'LINE-INT rf p d c e)))
                 (ass))))
         (mh2-split-goal-cg!))))))
(qed 'convex-primitive-line-int)

;;; ---------------------------------------------------------------------------
;;; ONE PIECE: pgam and prho stay in an open convex cgs_ inside u on [cgc_, cge_].  Then the two
;;; piece integrals differ by the change of the connecting segment integral.
(define cg-piece-hyps
  '((HOLOMORPHIC-ON u f) (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) cgs_) (IS-CONVEX-CC cgs_) (SUBSET cgs_ u)
    (IS-ROAD pgam dgam a b) (IS-ROAD prho drho a b) (IN cgc_ RR) (IN cge_ RR) (<= a cgc_) (< cgc_ cge_) (<= cge_ b)
    (FORALL cgw_ (IMPLIES (IN cgw_ (CCINT cgc_ cge_)) (AND (IN (pgam cgw_) cgs_) (IN (prho cgw_) cgs_))))))
(define (cg-li f p d c e) (list 'LINE-INT f (list 'RESTRICT p (list 'CCINT c e)) (list 'RESTRICT d (list 'CCINT c e)) c e))
(define (cg-si x) (list 'SEG-INT 'f (list 'prho x) (list 'pgam x)))
(sp (make-wff (forall-guarded '(u f cgs_ pgam dgam prho drho a b cgc_ cge_) cg-piece-hyps
  (list '= (list '- (cg-li 'f 'pgam 'dgam 'cgc_ 'cge_) (cg-li 'f 'prho 'drho 'cgc_ 'cge_))
           (list '- (cg-si 'cge_) (cg-si 'cgc_))))))
(dk-peel!)
(let* ((hw (cg-pick 'hw (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cgw_))))))
  (fact 'is-road-is-path 'pgam 'dgam 'a 'b) (fact 'is-path-endpoints 'pgam 'a 'b)
  (dk-cite! 'holomorphic-on-open 'u 'f) (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'subset-trans 'cgs_ 'u 'CC)
  (cg-in-ccint! 'cgc_ 'cgc_ 'cge_ '(< cgc_ cge_))
  (cg-in-ccint! 'cge_ 'cgc_ 'cge_ '(< cgc_ cge_))
  (for-each (lambda (x) (dk-split! (dk-apply! hw x))) '(cgc_ cge_))
  (for-each (lambda (cur)
              (dk-have! (list 'FORALL 'cgw_ (list 'IMPLIES '(IN cgw_ (CCINT cgc_ cge_)) (list 'IN (list cur 'cgw_) 'cgs_)))
                (lambda () (let ((w (dk-di-var!))) (dk-split! (dk-apply! hw w)) (ass)))))
            '(pgam prho))
  (for-each (lambda (cur) (for-each (lambda (x) (fact 'subset-mem-fwd 'cgs_ 'CC (list cur x))) '(cgc_ cge_))) '(pgam prho))
  (let* ((g (dk-skolem! (dk-cite! 'convex-primitive-line-int 'u 'f 'cgs_ '(pgam cgc_)) #t))
         (ug (cg-pick 'ug (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z g) (dk-contains? z 'LINE-INT))))))
    ;; the two piece integrals
    (for-each
     (lambda (pr)
       (let* ((p (car pr)) (d (cadr pr)) (rp (list 'RESTRICT p '(CCINT cgc_ cge_))) (rd (list 'RESTRICT d '(CCINT cgc_ cge_))))
         (fact 'road-restrict p d 'a 'b 'cgc_ 'cge_)
         (fact 'trace-restrict-in p 'cgs_ 'cgc_ 'cge_)
         (let ((eqn (dk-apply! ug rp rd 'cgc_ 'cge_)))
           (fact 'restrict-apply p '(CCINT cgc_ cge_) 'cgc_)
           (fact 'restrict-apply p '(CCINT cgc_ cge_) 'cge_)
           (let ((e2 (dk-rewrite-h! eqn (list rp 'cge_) (list p 'cge_))))
             (dk-rewrite-h! e2 (list rp 'cgc_) (list p 'cgc_))))))
     '((pgam dgam) (prho drho)))
    ;; the two connecting segments
    (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
    (cg-in-ccint! 0 0 1) (cg-in-ccint! 1 0 1)
    (for-each
     (lambda (x)
       (let* ((q (list 'prho x)) (pp (list 'pgam x)) (sp_ (list 'SEG-PATH q pp)) (sd (list 'SEG-DERIV q pp)))
         (fact 'seg-int-unfold 'f q pp)
         (fact 'seg-path-is-road q pp)
         (fact 'seg-trace-in-convex 'cgs_ q pp)
         (let ((eqn (dk-apply! ug sp_ sd 0 1)))
           (fact 'seg-path-apply q pp 1) (fact 'seg-path-apply q pp 0)
           (dk-have! (list '= (list sp_ 1) pp) (lambda () (subst (list '= (list sp_ 1) (list '+ q (list '* 1 (list '- pp q))))) (crs)))
           (dk-have! (list '= (list sp_ 0) q) (lambda () (subst (list '= (list sp_ 0) (list '+ q (list '* 0 (list '- pp q))))) (crs)))
           (let ((e2 (dk-rewrite-h! eqn (list sp_ 1) pp)))
             (dk-rewrite-h! e2 (list sp_ 0) q)))
         (subst (list '= (cg-si x) (list 'LINE-INT 'f sp_ sd 0 1)))))
     '(cge_ cgc_))
    ;; now everything is a value of g
    (for-each (lambda (lhs)
                (subst (cg-pick 'v (lambda (z) (and (dk-head-is? z '=) (equal? (cadr z) lhs) (dk-contains? z g))))))
              (list (cg-li 'f 'pgam 'dgam 'cgc_ 'cge_) (cg-li 'f 'prho 'drho 'cgc_ 'cge_)
                    (list 'LINE-INT 'f '(SEG-PATH (prho cge_) (pgam cge_)) '(SEG-DERIV (prho cge_) (pgam cge_)) 0 1)
                    (list 'LINE-INT 'f '(SEG-PATH (prho cgc_) (pgam cgc_)) '(SEG-DERIV (prho cgc_) (pgam cgc_)) 0 1)))
    (for-each (lambda (v) (fact 'fun-apply-type-c g 'cgs_ 'CC v)) '((pgam cgc_) (pgam cge_) (prho cgc_) (prho cge_)))
    (crs)))
(qed 'good-approx-piece)

;;; ---------------------------------------------------------------------------
;;; Splitting a restricted integral: [a, e] = [a, c] + [c, e]
(define (cg-cont-basics!)
  (dk-cite! 'holomorphic-on-open 'u 'f) (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'holomorphic-on-in-fun 'u 'f) (dk-cite! 'holomorphic-on-continuous 'u 'f))
(sp (make-wff (forall-guarded '(u f pgam dgam a b cgc_ cge_)
  '((HOLOMORPHIC-ON u f) (IS-ROAD pgam dgam a b) (SUBSET (TRACE pgam a b) u)
    (IN cgc_ RR) (IN cge_ RR) (< a cgc_) (< cgc_ cge_) (<= cge_ b))
  (list '= (cg-li 'f 'pgam 'dgam 'a 'cge_)
           (list '+ (cg-li 'f 'pgam 'dgam 'a 'cgc_) (cg-li 'f 'pgam 'dgam 'cgc_ 'cge_))))))
(dk-peel!)
(cg-cont-basics!)
(fact 'is-road-is-path 'pgam 'dgam 'a 'b) (dk-split-all! (list (dk-fact! 'is-path-endpoints 'pgam 'a 'b)))
(fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-road-dgam-in-fun 'pgam 'dgam 'a 'b)
(dk-have! '(<= a a) (lambda () (dk-ineq!)))
(dk-have! '(< a cge_) (lambda () (dk-ineq! '(< a cgc_) '(< cgc_ cge_))))
(dk-have! '(<= a cgc_) (lambda () (dk-ineq! '(< a cgc_))))
(dk-have! '(<= cgc_ cge_) (lambda () (dk-ineq! '(< cgc_ cge_))))
(dk-have! '(<= cge_ cge_) (lambda () (dk-ineq!)))
(dk-have! '(<= cgc_ b) (lambda () (dk-ineq! '(< cgc_ cge_) '(<= cge_ b))))
(let* ((ae '(CCINT a cge_)) (q (list 'RESTRICT 'pgam ae)) (dq (list 'RESTRICT 'dgam ae)))
  (fact 'road-restrict 'pgam 'dgam 'a 'b 'a 'cge_)
  (fact 'ccint-subset-ccint 'a 'b 'a 'cge_)
  (fact 'restrict-in-fun 'pgam '(CCINT a b) 'CC ae)
  (fact 'restrict-in-fun 'dgam '(CCINT a b) 'CC ae)
  (fact 'trace-restrict-subset 'pgam 'a 'b 'a 'cge_)
  (fact 'subset-trans (list 'TRACE q 'a 'cge_) '(TRACE pgam a b) 'u)
  (dk-have! '(IN cgc_ (OOINT a cge_))
    (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< a cgc_) '(< cgc_ cge_)))))))
  (let ((adj (dk-apply! (dk-cite! 'line-int-adjacent 'u 'f q dq 'a 'cge_) 'cgc_)))
    ;; each half of the restricted road is the restriction of the original road
    (define (half! lo hi)
      (let* ((P (list 'RESTRICT 'pgam (list 'CCINT lo hi))) (D (list 'RESTRICT 'dgam (list 'CCINT lo hi)))
             (qg (list 'RESTRICT q (list 'CCINT lo hi))) (qd (list 'RESTRICT dq (list 'CCINT lo hi))))
        (fact 'road-restrict 'pgam 'dgam 'a 'b lo hi)
        (fact 'trace-restrict-subset 'pgam 'a 'b lo hi)
        (fact 'subset-trans (list 'TRACE P lo hi) '(TRACE pgam a b) 'u)
        (fact 'ccint-subset-ccint 'a 'cge_ lo hi)
        (fact 'restrict-in-fun q ae 'CC (list 'CCINT lo hi))
        (fact 'restrict-in-fun dq ae 'CC (list 'CCINT lo hi))
        (for-each
         (lambda (pr)
           (let ((orig (car pr)) (qq (cadr pr)) (rr (caddr pr)) (dom (cadddr pr)))
             (dk-have! (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ (list dom lo hi)) (list '== (list qq 'cgt_) (list rr 'cgt_))))
               (lambda ()
                 (let ((tv (dk-di-var!)))
                   (if (eq? dom 'OOINT)
                       (dk-have! (list 'IN tv (list 'CCINT lo hi))
                         (lambda ()
                           (dk-split-all! (dk-landed (lambda () (mac-h 'ooint-membership (list 'IN tv (list 'OOINT lo hi))))))
                           (mac 'ccint-membership)
                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< lo tv) (list '< tv hi))))))))
                   (fact 'subset-mem-fwd (list 'CCINT lo hi) ae tv)
                   (subst (dk-cite! 'restrict-apply (if (eq? orig 'pgam) q dq) (list 'CCINT lo hi) tv))
                   (subst (dk-cite! 'restrict-apply orig ae tv))
                   (subst (dk-cite! 'restrict-apply orig (list 'CCINT lo hi) tv))
                   (qrfl))))))
         (list (list 'pgam qg P 'CCINT) (list 'dgam qd D 'OOINT)))
        (dk-cite! 'line-int-interior-congruence 'u 'f P D lo hi qg qd)
        (dk-cite! 'line-int-in-cc 'u 'f P D lo hi)
        (list qg qd P D)))
    (let* ((h1 (half! 'a 'cgc_)) (h2 (half! 'cgc_ 'cge_)))
      (subst adj)
      (subst (list '= (list 'LINE-INT 'f (car h1) (cadr h1) 'a 'cgc_) (list 'LINE-INT 'f (caddr h1) (cadddr h1) 'a 'cgc_)))
      (subst (list '= (list 'LINE-INT 'f (car h2) (cadr h2) 'cgc_ 'cge_) (list 'LINE-INT 'f (caddr h2) (cadddr h2) 'cgc_ 'cge_)))
      (rfl))))
(qed 'restricted-line-int-split)

;;; ---------------------------------------------------------------------------
;;; An increasing finite sequence: t(0) <= t(j) (strictly from j = 1 on) and t(j) <= t(m)
(define cg-inc '(FORALL cgk_ (IMPLIES (IN cgk_ NN) (IMPLIES (< cgk_ n) (< (tq cgk_) (tq (succ cgk_)))))))
(sp (make-wff (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'FORALL 'n (list 'FORALL 'tq
  (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(IN tq (FUN NN RR)) (list 'IMPLIES cg-inc
    (list 'IMPLIES '(<= j n) '(AND (<= (tq 0) (tq j)) (IMPLIES (<= 1 j) (< (tq 0) (tq j))))))))))))))
(define cg1-br (use-induction))
(dk-focus! (cdr (assq 'base cg1-br)))
(let* ((pl (dk-peel!)) (g (dk-goal)) (tq (car (cadr (cadr g)))))
  (dk-have! '(IN 0 NN)) (fact 'fun-apply-type-c tq 'NN 'RR 0)
  (for-each (lambda (leaf) (dk-focus! leaf)
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) '<=) (dk-ineq!))
                    (#t (di) (dk-have! '(IN 1 RR)) (dk-have! '(IN 0 RR)) (dk-absurd! '(<= 1 0)))))
            (mh2-split-goal-cg!)))
(dk-focus! (cdr (assq 'step cg1-br)))
(let* ((j (cdr (assq 'var cg1-br))) (ih (cdr (assq 'ih cg1-br)))
       (pl (dk-peel!)) (g (dk-goal)) (tq (car (cadr (cadr g))))
       (n (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN) (not (eq? (cadr z) j)))) pl))))
       (inc (cg-pick 'inc (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cgk_))))))
  (fact 'nn-succ-closed j)
  (dk-have! (list '< j n) (lambda () (dk-nn!)))
  (dk-have! (list '<= j n) (lambda () (dk-nn!)))
  (dk-have! '(IN 0 NN))
  (for-each (lambda (x) (fact 'fun-apply-type-c tq 'NN 'RR x)) (list 0 j (list 'succ j)))
  (dk-split! (dk-apply! ih n tq))
  (dk-apply! inc j)
  (dk-have! (list '< (list tq 0) (list tq (list 'succ j)))
            (lambda () (dk-ineq! (list '<= (list tq 0) (list tq j)) (list '< (list tq j) (list tq (list 'succ j))))))
  (for-each (lambda (leaf) (dk-focus! leaf)
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '< (list tq 0) (list tq (list 'succ j)))))
                    (#t (di) (ass))))
            (mh2-split-goal-cg!)))
(qed 'increasing-seq-from-start)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'j (list 'FORALL 'n (list 'FORALL 'tq
  (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(IN tq (FUN NN RR)) (list 'IMPLIES cg-inc
    (list 'IMPLIES '(<= j m) (list 'IMPLIES '(<= m n) '(<= (tq j) (tq m)))))))))))))))
(define cg2-br (use-induction))
(dk-focus! (cdr (assq 'base cg2-br)))
(let* ((pl (dk-peel!)) (g (dk-goal)) (tq (car (cadr g))) (j (cadr (cadr g))))
  (dk-have! (list '= j 0) (lambda () (dk-nn!)))
  (subst (list '= j 0))
  (dk-have! '(IN 0 NN)) (fact 'fun-apply-type-c tq 'NN 'RR 0)
  (dk-ineq!))
(dk-focus! (cdr (assq 'step cg2-br)))
(let* ((m (cdr (assq 'var cg2-br))) (ih (cdr (assq 'ih cg2-br)))
       (pl (dk-peel!)) (g (dk-goal)) (tq (car (cadr g))) (j (cadr (cadr g)))
       (n (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN) (not (eq? (cadr z) j)) (not (eq? (cadr z) m)))) pl))))
       (inc (cg-pick 'inc (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cgk_))))))
  (fact 'nn-succ-closed m)
  (for-each (lambda (x) (fact 'fun-apply-type-c tq 'NN 'RR x)) (list j m (list 'succ m)))
  (use-em (list '= j (list 'succ m))
    (lambda () (subst (list '= j (list 'succ m))) (dk-ineq!))
    (lambda ()
      (dk-have! (list '<= j m)
        (lambda () (let ((d (dk-fact! 'nn-le-succ-cases m j)))
                     (if (dk-only! d (list 'NOT (list '= j (list 'succ m)))) (prop)))))
      (dk-have! (list '< m n) (lambda () (dk-nn!)))
      (dk-have! (list '<= m n) (lambda () (dk-nn!)))
      (dk-apply! ih j n tq)
      (dk-apply! inc m)
      (dk-ineq! (list '<= (list tq j) (list tq m)) (list '< (list tq m) (list tq (list 'succ m)))))))
(qed 'increasing-seq-le)

;;; ---------------------------------------------------------------------------
;;; THE INVARIANT of 3.12, by induction on the partition index k (outermost, for the induction)
(define cg-pk
  '(FORALL hmk_ (IMPLIES (IN hmk_ NN) (IMPLIES (< hmk_ n)
     (AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) (bs hmk_))
     (AND (IS-CONVEX-CC (bs hmk_))
     (AND (SUBSET (bs hmk_) u)
          (FORALL hmw_ (IMPLIES (IN hmw_ (CCINT (tq hmk_) (tq (succ hmk_))))
            (AND (IN (pgam hmw_) (bs hmk_)) (IN (prho hmw_) (bs hmk_)))))))))))))
(define cg-inv-hyps
  (list '(HOLOMORPHIC-ON u f) '(IS-ROAD pgam dgam a b) '(IS-ROAD prho drho a b)
        '(SUBSET (TRACE pgam a b) u) '(SUBSET (TRACE prho a b) u) '(= (prho a) (pgam a))
        '(IN n NN) '(IN tq (FUN NN RR)) '(= (tq 0) a) '(= (tq n) b) '(IN bs (FUN NN (POWER CC))) cg-pk
        '(<= 1 k) '(<= k n)))
(define (cg-g x) (cg-li 'f 'pgam 'dgam 'a x))
(define (cg-r x) (cg-li 'f 'prho 'drho 'a x))
(define (cg-inv-concl x) (list '= (list '- (cg-g x) (cg-r x)) (cg-si x)))
(define (cg-absurd!)                            ; (<= 1 0) in context closes any goal
  (dk-have! '(IN 1 RR)) (dk-have! '(IN 0 RR))
  (dk-have! '(< 0 0) (lambda () (dk-ineq! '(<= 1 0))))
  (fact 'rr-lt-irrefl 0)
  (if (dk-only! '(< 0 0) '(NOT (< 0 0))) (prop)))
;;; (IN (LINE-INT f (RESTRICT p ..) (RESTRICT d ..) lo hi) CC); a <= lo < hi <= b in context
(define (cg-li-cc! p d lo hi)
  (let ((rp (list 'RESTRICT p (list 'CCINT lo hi))))
    (fact 'road-restrict p d 'a 'b lo hi)
    (fact 'trace-restrict-subset p 'a 'b lo hi)
    (fact 'subset-trans (list 'TRACE rp lo hi) (list 'TRACE p 'a 'b) 'u)
    (dk-cite! 'line-int-in-cc 'u 'f rp (list 'RESTRICT d (list 'CCINT lo hi)) lo hi)))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (forall-guarded '(u f pgam dgam prho drho a b n tq bs) cg-inv-hyps (cg-inv-concl '(tq k)))))))
(define cg3-br (dk-use-induction-fixed! '(u f pgam dgam prho drho a b n tq bs)))   ; W1G-A: the eleven parameters fixed
(dk-focus! (cdr (assq 'base cg3-br)))
(dk-peel!)
(cg-absurd!)
(dk-focus! (cdr (assq 'step cg3-br)))
(let* ((k (cdr (assq 'var cg3-br))) (ih (cdr (assq 'ih cg3-br)))
       (sk (list 'succ k)) (tk (list 'tq k)) (t1 (list 'tq sk)) (bk (list 'bs k)))
  (dk-peel!)
  (cg-cont-basics!)
  (fact 'is-road-is-path 'pgam 'dgam 'a 'b) (dk-split-all! (list (dk-fact! 'is-path-endpoints 'pgam 'a 'b)))
  (fact 'is-road-is-path 'prho 'drho 'a 'b)
  (fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b)
  (fact 'nn-succ-closed k)
  (dk-have! (list '< k 'n) (lambda () (dk-nn!)))
  (dk-have! (list '<= k 'n) (lambda () (dk-nn!)))
  (dk-have! '(<= n n) (lambda () (dk-nn!)))
  (dk-have! '(<= a a) (lambda () (dk-ineq!)))
  (let* ((pk (cg-pick 'pk (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'hmw_))))))
    (dk-split-all! (list (dk-apply! pk k)))
    (dk-have! cg-inc (lambda () (let ((j (dk-di-var!))) (di) (dk-split-all! (list (dk-apply! pk j))) (ass))))
    (for-each (lambda (x) (fact 'fun-apply-type-c 'tq 'NN 'RR x)) (list 0 k sk 'n))
    ;; a <= t_k, t_{k+1} <= b, t_k <= b
    (dk-split-all! (list (dk-fact! 'increasing-seq-from-start k 'n 'tq)))
    (dk-rewrite-h! (list '<= '(tq 0) tk) '(tq 0) 'a)
    (fact 'increasing-seq-le 'n sk 'n 'tq)
    (dk-rewrite-h! (list '<= t1 '(tq n)) '(tq n) 'b)
    (dk-have! (list '<= tk 'b) (lambda () (dk-ineq! (list '< tk t1) (list '<= t1 'b))))
    (dk-have! (list '<= 'a tk) (lambda () (dk-ineq! (list '<= 'a tk))))
    ;; the piece
    (let* ((pe (dk-fact! 'good-approx-piece 'u 'f bk 'pgam 'dgam 'prho 'drho 'a 'b tk t1)))
      ;; the segments at t_{k+1}: in bs k, hence in u; typed
      (dk-cite! 'subset-trans bk 'u 'CC)
      (let ((pw (cg-pick 'pw (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'hmw_) (dk-contains? z bk))))))
        (cg-in-ccint! tk tk t1 (list '< tk t1))
        (cg-in-ccint! t1 tk t1 (list '< tk t1))
        (for-each (lambda (x) (dk-split-all! (list (dk-apply! pw x)))) (list tk t1)))
      (for-each (lambda (x)
                  (for-each (lambda (c) (fact 'subset-mem-fwd bk 'CC (list c x))) '(pgam prho))
                  (fact 'seg-trace-in-convex bk (list 'prho x) (list 'pgam x))
                  (fact 'subset-trans (list 'TRACE (list 'SEG-PATH (list 'prho x) (list 'pgam x)) 0 1) bk 'u)
                  (dk-cite! 'seg-int-in-cc 'u 'f (list 'prho x) (list 'pgam x)))
                (list tk t1))
      (cg-li-cc! 'pgam 'dgam tk t1) (cg-li-cc! 'prho 'drho tk t1)
      (use-em (list '= k 0)
        ;; k = 0: t_0 = a, and the starting segment is degenerate
        (lambda ()
          (dk-have! (list '= tk 'a) (lambda () (subst (list '= k 0)) (ass)))
          (let* ((pe2 (dk-rewrite-h! pe tk 'a))
                 (pe3 (dk-rewrite-h! pe2 '(prho a) '(pgam a))))
            (cg-in-ccint! 'a 'a 'b '(< a b))
            (fact 'trace-value-in 'pgam 'a 'b 'a)
            (fact 'subset-mem-fwd '(TRACE pgam a b) 'u '(pgam a))
            (let ((z0 (dk-cite! 'seg-int-degenerate 'u 'f '(pgam a))))
              (dk-rewrite-h! pe3 '(SEG-INT f (pgam a) (pgam a)) 0))
            (cg-li-cc! 'pgam 'dgam 'a t1) (cg-li-cc! 'prho 'drho 'a t1)
            (dk-rewrite-h! (list '<= tk 'b) tk 'a)
            (subst (list '= (list '- (cg-g t1) (cg-r t1)) (list '- (cg-si t1) 0)))
            (crs)))
        ;; k >= 1: the invariant at k, then one more piece
        (lambda ()
          (dk-have! '(IN 0 NN))
          (fact 'nn-le-ne-succ 0 k)
          (dk-have! '(<= 0 k) (lambda () (dk-nn!)))
          (fact 'nn-le-ne-succ 0 k)
          (dk-have! (list '<= 1 k) (lambda () (dk-nn!)))
          (let ((inv (let w1g-dl ((w1g-f (dk-ctx-form ih))) (if (dk-head-is? w1g-f 'IMPLIES) (w1g-dl (dk-landed-1 (lambda () (detach! w1g-f)))) w1g-f))))   ; W1G-A: parameters fixed; the IH is (<= 1 k) => (<= k n) => ...
            (detach! (list 'IMPLIES (list '<= 1 k) (list '< '(tq 0) tk)))
            (dk-rewrite-h! (list '< '(tq 0) tk) '(tq 0) 'a)
            (cg-li-cc! 'pgam 'dgam 'a tk) (cg-li-cc! 'prho 'drho 'a tk)
            (fact 'restricted-line-int-split 'u 'f 'pgam 'dgam 'a 'b tk t1)
            (fact 'restricted-line-int-split 'u 'f 'prho 'drho 'a 'b tk t1)
            (subst (list '= (cg-g t1) (list '+ (cg-g tk) (cg-li 'f 'pgam 'dgam tk t1))))
            (subst (list '= (cg-r t1) (list '+ (cg-r tk) (cg-li 'f 'prho 'drho tk t1))))
            (let ((lhs (list '- (list '+ (cg-g tk) (cg-li 'f 'pgam 'dgam tk t1)) (list '+ (cg-r tk) (cg-li 'f 'prho 'drho tk t1))))
                  (mid (list '+ (list '- (cg-g tk) (cg-r tk)) (list '- (cg-li 'f 'pgam 'dgam tk t1) (cg-li 'f 'prho 'drho tk t1)))))
              (dk-have! (list '= lhs mid) (lambda () (crs)))
              (subst (list '= lhs mid))
              (subst inv)
              (subst pe)
              (crs))))))))
(qed 'good-approx-invariant)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.12
(sp (make-wff (forall-guarded '(u f pgam dgam prho drho a b)
  '((HOLOMORPHIC-ON u f) (IS-ROAD pgam dgam a b) (IS-ROAD prho drho a b) (GOOD-APPROX u pgam prho a b))
  '(= (LINE-INT f pgam dgam a b) (LINE-INT f prho drho a b)))))
(dk-peel!)
(cg-cont-basics!)
(fact 'is-road-is-path 'pgam 'dgam 'a 'b) (fact 'is-road-is-path 'prho 'drho 'a 'b)
(dk-split-all! (list (dk-fact! 'is-path-endpoints 'pgam 'a 'b)))
(fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b)
(fact 'is-road-dgam-in-fun 'pgam 'dgam 'a 'b) (fact 'is-road-dgam-in-fun 'prho 'drho 'a 'b)
(let* ((rhs (caddr (dk-cite! 'good-approx 'u 'pgam 'prho 'a 'b))))
  (dk-project! rhs 'good-approx '(GOOD-APPROX u pgam prho a b))
  (dk-split-all! (list rhs))
  (let* ((n (dk-skolem! (cg-pick 'en (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmn_)))) #t))
         (_s1 (dk-split-all!))
         (tq (dk-skolem! (cg-pick 'et (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmt_)))) #t))
         (_s2 (dk-split-all!))
         (bs (dk-skolem! (cg-pick 'eb (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmd_)))) #t))
         (_s3 (dk-split-all!)))
    (dk-have! (list '<= n n) (lambda () (dk-nn!)))
    (let ((inv (dk-fact! 'good-approx-invariant n 'u 'f 'pgam 'dgam 'prho 'drho 'a 'b n tq bs)))
      (let* ((i2 (dk-rewrite-h! inv (list tq n) 'b))
             (i3 (dk-rewrite-h! i2 '(prho b) '(pgam b))))
        (cg-in-ccint! 'b 'a 'b '(< a b))
        (fact 'trace-value-in 'pgam 'a 'b 'b)
        (fact 'subset-mem-fwd '(TRACE pgam a b) 'u '(pgam b))
        (dk-cite! 'seg-int-degenerate 'u 'f '(pgam b))
        (let ((i4 (dk-rewrite-h! i3 '(SEG-INT f (pgam b) (pgam b)) 0)))
          ;; the restriction to the whole interval is the road itself
          (fact 'subset-refl '(CCINT a b))
          (for-each
           (lambda (pr)
             (let* ((p (car pr)) (d (cadr pr)) (qg (list 'RESTRICT p '(CCINT a b))) (qd (list 'RESTRICT d '(CCINT a b))))
               (fact 'restrict-in-fun p '(CCINT a b) 'CC '(CCINT a b))
               (fact 'restrict-in-fun d '(CCINT a b) 'CC '(CCINT a b))
               (for-each
                (lambda (pr2)
                  (let ((orig (car pr2)) (dom (cadr pr2)))
                    (dk-have! (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ (list dom 'a 'b))
                                (list '== (list (list 'RESTRICT orig '(CCINT a b)) 'cgt_) (list orig 'cgt_))))
                      (lambda ()
                        (let ((tv (dk-di-var!)))
                          (if (eq? dom 'OOINT)
                              (dk-have! (list 'IN tv '(CCINT a b))
                                (lambda ()
                                  (dk-split-all! (dk-landed (lambda () (mac-h 'ooint-membership (list 'IN tv '(OOINT a b))))))
                                  (mac 'ccint-membership)
                                  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 'a tv) (list '< tv 'b))))))))
                          (subst (dk-cite! 'restrict-apply orig '(CCINT a b) tv))
                          (qrfl))))))
                (list (list p 'CCINT) (list d 'OOINT)))
               (dk-cite! 'line-int-interior-congruence 'u 'f p d 'a 'b qg qd)
               (dk-cite! 'line-int-in-cc 'u 'f p d 'a 'b)))
           '((pgam dgam) (prho drho)))
          (let* ((lg '(LINE-INT f pgam dgam a b)) (lr '(LINE-INT f prho drho a b))
                 (i5 (dk-rewrite-h! i4 (cg-g 'b) lg))
                 (i6 (dk-rewrite-h! i5 (cg-r 'b) lr)))
            (dk-have! (list '= lg (list '+ (list '- lg lr) lr)) (lambda () (crs)))
            (subst (list '= lg (list '+ (list '- lg lr) lr)))
            (subst i6)
            (crs)))))))
(qed 'good-approx-integral)

;;; ---------------------------------------------------------------------------
;;; THE CONSTANT ROAD on [a, b] (the trivial curve of Definition 3.19): an affine
;;; reparametrisation (road-affine-reparam) of the degenerate segment seg-path(c, c) on [0, 1]
(define cg-kap '(VNB-LAMBDA cgq_ (CCINT a b) c))
(define cg-kap1 '(VNB-LAMBDA cgq_ (CCINT a b) 0))
(define (cg-ccint-set! lo hi)
  (fact 'rr-is-set) (fact 'ccint-subset-rr lo hi) (fact 'subclass-of-set-is-set (list 'CCINT lo hi) 'RR))
(sp (make-wff (forall-guarded '(c a b) '((IN c CC) (IN a RR) (IN b RR) (< a b))
  (list 'IS-ROAD cg-kap cg-kap1 'a 'b))))
(dk-peel!)
(let* ((ba '(- b a)) (L (list 'recip ba)) (M (list '- 0 (list '* 'a L))))
  (fact 'rr-sub-in-rr 'b 'a)
  (dk-have! (list '< 0 ba) (lambda () (dk-ineq! '(< a b))))
  (fact 'rr-pos-ne-zero ba)
  (dk-have! (list 'AND (list 'IN ba 'RR) (list 'NOT (list '= ba 0))))
  (fact 'rr-recip-closed ba) (fact 'rr-recip-pos ba) (fact 'rr-recip-inverse ba)
  (dk-have! (list '<= 0 L) (lambda () (dk-ineq! (list '< 0 L))))
  (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
  (dk-have! (list 'AND '(IN a RR) (list 'IN L 'RR))) (fact 'rr-mul-closed 'a L)
  (fact 'rr-sub-in-rr 0 (list '* 'a L))
  (dk-have! (list '= (list '+ M (list '* L 'a)) 0) (lambda () (crs)))
  (dk-have! (list '= (list '* L ba) 1)
    (lambda () (dk-have! (list '= (list '* L ba) (list '* ba L)) (lambda () (crs)))
               (subst (list '= (list '* L ba) (list '* ba L))) (ass)))
  (dk-have! (list '= (list '+ M (list '* L 'b)) 1)
    (lambda () (dk-have! (list '= (list '+ M (list '* L 'b)) (list '* L ba)) (lambda () (crs)))
               (subst (list '= (list '+ M (list '* L 'b)) (list '* L ba))) (ass)))
  (fact 'seg-path-is-road 'c 'c)
  (dk-have! '(IN 0 CC) (lambda () (fact 'rr-subset-cc 0) (ass)))
  (cg-ccint-set! 'a 'b)
  (for-each (lambda (kk)
              (dk-have! (list 'IN kk '(FUN (CCINT a b) CC))
                (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass))))))
            (list cg-kap cg-kap1))
  ;; z in [a, b]  ==>  M + L z = L (z - a) in [0, 1]
  (define (in01! z)
    (let ((x (list '+ M (list '* L z))) (za (list '- z 'a)))
      (for-each (lambda (c) (dk-project! c (lambda () (mac-h 'ccint-membership (list 'IN z '(CCINT a b))) (dk-split-all!))))
                (list (list 'IN z 'RR) (list '<= 'a z) (list '<= z 'b)))
      (fact 'rr-sub-in-rr z 'a)
      (dk-have! (list '<= 0 za) (lambda () (dk-ineq! (list '<= 'a z))))
      (dk-have! (list '<= za ba) (lambda () (dk-ineq! (list '<= z 'b))))
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN za 'RR))) (fact 'rr-mul-closed L za)
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN z 'RR))) (fact 'rr-mul-closed L z)
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN ba 'RR))) (fact 'rr-mul-closed L ba)
      (dk-have! (list 'AND (list '<= 0 L) (list '<= 0 za))) (fact 'rr-leq-mul-nonneg L za)
      (dk-have! (list 'AND (list '<= 0 L) (list '<= za ba))) (fact 'rr-le-scale-nonneg L za ba)
      (dk-have! (list '= x (list '* L za)) (lambda () (crs)))
      (dk-have! (list 'IN x '(CCINT 0 1))
        (lambda () (mac 'ccint-membership)
          (dk-conj-close! (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'IN) (dk-have! (list 'AND (list 'IN M 'RR) (list 'IN (list '* L z) 'RR))) (fact 'rr-add-closed M (list '* L z)) (ass))
                  (#t (dk-ineq! (list '= x (list '* L za)) (list '<= 0 (list '* L za)) (list '<= (list '* L za) (list '* L ba))
                                (list '= (list '* L ba) 1))))))))
      x))
  (let* ((eqs (dk-fact! 'road-affine-reparam 0 1 'a 'b L M)))
    (fact 'road-affine-reparam 0 1 'a 'b L M '(SEG-PATH c c) '(SEG-DERIV c c) cg-kap cg-kap1)
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES '(IN lrpz_ (CCINT a b))
                (list '== (list cg-kap 'lrpz_) (list '(SEG-PATH c c) (list '+ M (list '* L 'lrpz_))))))
      (lambda ()
        (let* ((z (dk-di-var!)) (x (in01! z)))
          (dk-lam-b!)
          (subst (dk-cite! 'seg-path-apply 'c 'c x))
          (fact 'rr-subset-cc x)
          (dk-have! (list '= (list '+ 'c (list '* x '(- c c))) 'c) (lambda () (crs)))
          (subst (list '= (list '+ 'c (list '* x '(- c c))) 'c))
          (qrfl))))
    (dk-have! '(= (- c c) 0) (lambda () (crs)))
    (fact 'seg-deriv-bridge 'c 'c 0)
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES '(IN lrpz_ (CCINT a b))
                (list '== (list cg-kap1 'lrpz_) (list '* L (list '(SEG-DERIV c c) (list '+ M (list '* L 'lrpz_)))))))
      (lambda ()
        (let* ((z (dk-di-var!)) (x (in01! z)))
          (subst '(= (SEG-DERIV c c) (VNB-LAMBDA psx_ (CCINT 0 1) 0)))
          (dk-lam-b!)
          (dk-have! (list '= (list '* L 0) 0) (lambda () (crs)))
          (subst (list '= (list '* L 0) 0))
          (qrfl))))
    (fact 'road-affine-reparam 0 1 'a 'b L M '(SEG-PATH c c) '(SEG-DERIV c c) cg-kap cg-kap1)
    (ass)))
(qed 'const-road)

;;; The line integral along a constant road in u is 0 (f holomorphic on u)
(sp (make-wff (forall-guarded '(u f c a b) '((HOLOMORPHIC-ON u f) (IN c u) (IN a RR) (IN b RR) (< a b))
  (list '= (list 'LINE-INT 'f cg-kap cg-kap1 'a 'b) 0))))
(dk-peel!)
(cg-cont-basics!)
(fact 'subset-mem-fwd 'u 'CC 'c)
(fact 'cc-is-metric-space)
(let* ((oiff (dk-cite! 'cc-ms-open-iff 'u)))
  (dk-have! '(IS-OPEN CC-MS u) (lambda () (if (dk-only! oiff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)) (prop))))
  (let* ((rhs (caddr (dk-cite! 'is-open 'CC-MS 'u))))
    (dk-project! rhs 'is-open '(IS-OPEN CC-MS u))
    (dk-split-all! (list rhs))
    (let* ((ex (dk-apply! (cg-pick 'op (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'BALL) (dk-contains? z 'u)))) 'c))
           (r (dk-skolem! ex #t))
           (B (list 'BALL 'CC-MS 'c r)))
      (dk-pos-parts! r)
      (fact 'cc-ms-ball-centre 'c r)
      (fact 'cc-ms@pts)
      (dk-have! (list 'IN 'c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
      (fact 'ball-is-open 'CC-MS 'c r)
      (let ((biff (dk-cite! 'cc-ms-open-iff B)))
        (dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) B)
          (lambda () (if (dk-only! biff (list 'IS-OPEN 'CC-MS B)) (prop)))))
      (fact 'cc-ball-is-convex 'c r)
      (let* ((g (dk-skolem! (dk-cite! 'convex-primitive-line-int 'u 'f B 'c) #t))
             (ug (cg-pick 'ug (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z g) (dk-contains? z 'LINE-INT))))))
        (fact 'const-road 'c 'a 'b)
        (dk-have! (list 'SUBSET (list 'TRACE cg-kap 'a 'b) B)
          (lambda ()
            (mac 'subset-def)
            (let* ((pl (dk-peel!)) (z (cadr (car pl))) (tr (list 'TRACE cg-kap 'a 'b)))
              (fact 'trace-unfold cg-kap 'a 'b)
              (dk-rewrite-h! (list 'IN z tr) tr (list 'IMAGE cg-kap '(CCINT a b)))
              (let ((iff (dk-cite! 'image-membership-iff cg-kap '(CCINT a b) z)))
                (dk-have! (caddr iff) (lambda () (prop)))
                (dk-split! (caddr iff))
                (let* ((x (dk-skolem! (cg-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
                  (dk-lam-b-h! (list '= (list cg-kap x) z))
                  (subst (list '= z 'c))
                  (ass))))))
        (let ((eqn (dk-apply! ug cg-kap cg-kap1 'a 'b)))
          (cg-in-ccint! 'a 'a 'b '(< a b)) (cg-in-ccint! 'b 'a 'b '(< a b))
          (subst eqn)
          (dk-lam-b!)
          (fact 'fun-apply-type-c g B 'CC 'c)
          (crs))))))
(qed 'const-road-line-int)

