(clh-chain! (dk-fact! 'holomorphic-sum clh-lB clh-lc2 clh-lcomp clh-lL))
(ew clh-lrho)
(dk-conj-close! (lambda () (ass)))
(qed 'cc-log-holomorphic-at)
;;; ======================================================================
;;; (3d) log IS HOLOMORPHIC ON THE SLIT PLANE C \ (-inf, 0] (the notes, after
;;; Prop 2.21): the slit plane is open (every point has a ball inside it,
;;; cc-log-holomorphic-at) and at every point log agrees near the point with a
;;; function holomorphic on a ball (cc-diff-on-local).
;;; ======================================================================
(define clh-gL (list 'VNB-LAMBDA 'clhw_ clh-slit-set '(CC-LOG clhw_)))
(sp (make-wff (list 'HOLOMORPHIC-ON clh-slit-set clh-gL)))
(clh-ms-setup!)
(fact 'rr-zero-in)
(define clh-gloc (dk-fact! 'cc-log-holomorphic-at))
;; x in the slit plane: x in CC and the slit condition (on a lane; the membership survives)
(define (clh-gin! x)
  (if (not (dk-asm? (clh-slit x)))
      (begin
        (dk-have! (list 'IN x 'CC) (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x clh-slit-set))))) (ass)))
        (dk-have! (clh-slit x) (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x clh-slit-set))))) (ass))))))
(define (clh-gball! x)                  ; returns rho, with its facts landed
  (clh-gin! x)
  (dk-skolem! (clh-chain! (dk-apply! clh-gloc x))))
(define (clh-slit-set!)
  (if (not (dk-asm? (list 'IN clh-slit-set 'SET)))
      (dk-have! (list 'IN clh-slit-set 'SET)
        (lambda () (let ((leaf (proof-state-focus *ps*))) (sep-set) (if (not (sequent-node-grounded? leaf)) (begin (fact 'cc-is-set) (ass))))))))
(clh-slit-set!)
(clh-lam-typ! clh-gL clh-slit-set 'CC
  (lambda (x) (clh-gin! x) (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-in-slit x))))))
;; the slit plane is open
(dk-have! (list 'IS-OPEN 'CC-MS clh-slit-set)
  (lambda ()
    (mac 'is-open)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g 'IS-METRIC-SPACE) (ass))
                ((dk-head-is? g 'SUBSET)
                 (let ((x (subset-by-element!)))
                   (clh-gin! x)
                   (subst '(== (PTS CC-MS) CC))
                   (ass)))
                (#t
                 (let* ((y (dk-di-var!)) (rho (clh-gball! y)))
                   (clh-pos-rr! rho)
                   (ew rho)
                   (dk-conj-close! (lambda () (ass)))))))))))
(dk-have! (list 'IS-OPEN clh-nfm clh-slit-set) (lambda () (mac 'cc-ms-open-iff) (ass)))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (cond ((dk-head-is? (dk-goal) 'FORALL)
           (let* ((a (dk-di-var!)) (rho (clh-gball! a))
                  (B (clh-B a rho)) (LB (list 'VNB-LAMBDA 'clhx_ B '(CC-LOG clhx_))))
             (clh-center-in! a rho)
             (let ((l (dk-skolem! (dk-apply! (dk-fact! 'holomorphic-on-diff B LB) a))))
               (ew l)
               (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ B) (list '= (list clh-gL 'cexx_) (list LB 'cexx_))))
                 (lambda ()
                   (let ((x (dk-di-var!)))
                     (clh-chain! (dk-fact! 'subset-mem-fwd B clh-slit-set x))
                     (clh-gin! x)
                     (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-in-slit x))))
                     (clh-beta! (lambda () (rfl))))))
               (clh-guard!
                 (lambda () (clh-chain! (dk-fact! 'cc-diff-on-local clh-slit-set clh-gL B LB a l)))
                 ass))))
          (#t (ass)))))
(qed 'cc-log-holomorphic)
;;; ======================================================================
;;; (3e) THE DERIVATIVE: log'(w) = 1/w on the slit plane.  log is
;;; differentiable (cc-log-holomorphic) with some derivative l at w; exp o log
;;; is the identity there, so by the chain rule and the uniqueness of the
;;; derivative, exp(log w) l = 1, i.e. w l = 1.
;;; ======================================================================
(define clh-dE '(VNB-LAMBDA cexy_ CC (CC-EXP cexy_)))
(define clh-dcomp (list 'VNB-LAMBDA 'd2x_ clh-slit-set (list clh-dE (list clh-gL 'd2x_))))
(define clh-did (list 'VNB-LAMBDA 'clhid_ clh-slit-set 'clhid_))
(sp (make-wff (list 'FORALL 'clhb_ (list 'IMPLIES '(IN clhb_ CC) (list 'IMPLIES (clh-slit 'clhb_)
  (list 'IS-DIFF-ON 'CC-NORMED-FIELD clh-slit-set clh-gL 'clhb_ '(recip clhb_)))))))
(dk-peel!)
(clh-ms-setup!)
(fact 'rr-zero-in) (fact 'cc-one-in)
(clh-slit-set!)
(dk-have! (list 'IN 'clhb_ clh-slit-set) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
(fact 'cc-log-holomorphic)
(fact 'holomorphic-on-open clh-slit-set clh-gL)
(fact 'holomorphic-on-in-fun clh-slit-set clh-gL)
(define clh-dl (dk-skolem! (dk-apply! (dk-fact! 'holomorphic-on-diff clh-slit-set clh-gL) 'clhb_)))
(let* ((w 'clhb_) (l clh-dl) (Lw '(CC-LOG clhb_)) (gLw (list clh-gL w)) (m (list 'CC-EXP gLw))
       (ml (list '(MUL CC-NORMED-FIELD) m l)))
  (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec w))))
  (fact 'cc-nf-carr)
  (dk-have! (list 'IN l '(CARR CC-NORMED-FIELD))
    (lambda () (mac-h 'IS-DIFF-ON (dk-ctx-form (list 'IS-DIFF-ON 'CC-NORMED-FIELD clh-slit-set clh-gL w l))) (dk-split-all!) (ass)))
  (dk-have! (list 'IN l 'CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
  (fact 'fun-apply-type-c clh-gL clh-slit-set 'CC w)
  (dk-have! (list '= gLw Lw) (lambda () (clh-beta! (lambda () (rfl)))))
  (clh-exp-typ! gLw)
  ;; the chain rule for exp o log at w
  (dk-fact! 'cc-exp-deriv gLw)
  (dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES (list 'IN 'd2y_ clh-slit-set) (list 'IN (list clh-gL 'd2y_) 'CC)))
    (lambda () (let ((y (dk-di-var!))) (clh-guard! (lambda () (fact 'fun-apply-type-c clh-gL clh-slit-set 'CC y)) ass))))
  (clh-chain! (dk-fact! 'diff-on-chain 'CC-NORMED-FIELD clh-slit-set 'CC clh-gL clh-dE w l m))
  ;; the identity, and exp o log = identity on the slit plane
  (clh-chain! (dk-fact! 'diff-on-identity 'CC-NORMED-FIELD clh-slit-set w))
  (clh-lam-typ! clh-did clh-slit-set 'CC
    (lambda (x) (clh-guard! (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x clh-slit-set)))))) ass)))
  (fact 'subset-refl clh-slit-set)
  (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ clh-slit-set) (list '= (list clh-did 'cexx_) (list clh-dcomp 'cexx_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (clh-gin! x)
        (fact 'fun-apply-type-c clh-gL clh-slit-set 'CC x)
        (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec x))))
        (clh-beta!
          (lambda ()
            (subst (list '= (list 'CC-EXP (list 'CC-LOG x)) x))
            (rfl))))))
  (clh-chain! (dk-fact! 'cc-diff-on-local clh-slit-set clh-did clh-slit-set clh-dcomp w ml))
  ;; uniqueness: one = exp(log w) l
  (fact 'cc-nf-small-elements)
  (dk-have! '(== (ONE CC-NORMED-FIELD) 1) (lambda () (slot 'ONE) (qrfl)))
  (fact 'cc-nf-mul-apply m l)
  (dk-have! (list '= m w) (lambda () (subst (list '= gLw Lw)) (ass)))
  (dk-have! (list '= 1 (list '* w l))
    (lambda ()
      (let* ((uq0 (dk-fact! 'diff-on-unique 'CC-NORMED-FIELD))
             (uq (if (dk-head-is? uq0 'IMPLIES) (dk-landed-1 (lambda () (detach! uq0))) uq0)))
        (clh-chain! (dk-apply! uq clh-slit-set clh-did w '(ONE CC-NORMED-FIELD) ml))
        (subst (list '= 1 '(ONE CC-NORMED-FIELD)))
        (subst (list '= w m))
        (subst (list '= (list '* m l) ml))
        (ass))))
  (dk-have! (list '= l '(recip clhb_))
    (lambda ()
      (dk-have! '(NOT (= clhb_ 0))
        (lambda ()
          (di)
          (dk-have! '(AND (= (imag-part clhb_) 0) (<= (real-part clhb_) 0))
            (lambda () (subst '(= clhb_ 0)) (dk-conj-close! (lambda () (arith)))))
          (ai (clh-slit 'clhb_))))
      (clh-and! '(IN clhb_ CC) '(NOT (= clhb_ 0)))
      (clh-cc-typ! '(recip clhb_))
      (let ((inv (clh-chain! (dk-fact! 'cc-recip-inverse 'clhb_))))
        (subst (clh-ring-id! '(clhu_ clhv_ clhq_) '(= clhu_ (+ (* clhu_ (- 1 (* clhv_ clhq_))) (* (* clhv_ clhu_) clhq_))) (list l 'clhb_ '(recip clhb_))))
        (subst inv)
        (subst (list '= (list '* 'clhb_ l) 1))
        (subst (clh-ring-id! '(clhu_ clhq_) '(= (+ (* clhu_ (- 1 1)) (* 1 clhq_)) clhq_) (list l '(recip clhb_))))
        (rfl))))
  (subst (list '= '(recip clhb_) l))
  (ass))
(qed 'cc-log-deriv)
;;; ======================================================================
;;; (5) REMARK 2.22, THE FIRST IDENTITY: log(1 - z) = - sum_{k>=1} z^k / k, on
;;; |z| < r for r (1 + pi) <= pi (the ball of cc-log-one-plus, batch 38): the
;;; second identity at -z, with (-z)^k = (-1)^k z^k (cc-power-mul-base) and
;;; (-1)^k (-1)^k = 1, and the linearity of the series limit.
;;; ======================================================================
(define (clh-rho-lt-one!)                ; (< clhr_ 1) from r (1 + pi) <= pi
  (clh-pi-typ!)
  (clh-rr-typ! '(+ 1 PI))
  (clh-rr-typ! '(* clhr_ PI))
  (dk-have! '(<= (+ clhr_ (* clhr_ PI)) PI)
    (lambda ()
      (subst (clh-ring-id! '(clhu_ clhv_) '(= (+ clhu_ (* clhu_ clhv_)) (* clhu_ (+ 1 clhv_))) (list 'clhr_ 'PI)))
      (ass)))
  (dk-have! '(< clhr_ 1)
    (lambda ()
      (use-cases (dk-fact! 'rr-lt-trichotomy 'clhr_ 1)
        (lambda () (ass))
        (lambda ()
