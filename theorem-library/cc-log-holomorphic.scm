(dk-have! (list '< 0 clh-lrho) (lambda () (dk-ineq! (list '< (list '* clh-lmag 0) clh-lrho) (list '= (list '* clh-lmag 0) 0))))
(clh-rad-facts! clh-lrho)
(clh-cc-typ! clh-lia)
(clh-and! '(IN clha_ CC) '(NOT (= clha_ 0)))
(define clh-lcinv (clh-chain! (dk-fact! 'cc-recip-inverse 'clha_)))
