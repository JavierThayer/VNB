              (begin
                (subst (list '== (list '(DIST CC-MS) 0 mz) (list 'magnitude (list '- 0 mz))))
                (dk-have! (list '= (list '- 0 mz) (list '- mz)) (lambda () (crs)))
                (subst (list '= (list '- 0 mz) (list '- mz)))
                (subst (dk-fact! 'cc-magnitude-neg mz))
