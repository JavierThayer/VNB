  (clh-guard! (lambda () (clh-chain! (dk-fact! 'cc-log-char iw z))) ass))
(qed 'cc-log-rotate)

(sp (make-wff (list 'FORALL 'clhw_ (list 'IMPLIES '(IN clhw_ CC) (list 'IMPLIES '(< 0 (real-part clhw_))
  (list '= '(CC-LOG (* (- +i) clhw_)) (list '- '(CC-LOG clhw_) (list '* +i clh-h))))))))
(dk-peel!)
(clh-pi-typ!)
(clh-rr-typ! clh-h) (fact 'rr-subset-cc clh-h)
(clh-slit-re! 'clhw_)
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec 'clhw_))))
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-right-half 'clhw_))))
(let* ((L '(CC-LOG clhw_)) (mh (list '- clh-h)) (ih (list '* +i mh)) (z (list '+ L ih)) (iw '(* (- +i) clhw_))
       (goalz (list '- L (list '* +i clh-h))))
  (clh-rr-typ! mh) (fact 'rr-subset-cc mh)
  (clh-cc-typ! ih) (clh-cc-typ! z) (clh-cc-typ! iw) (clh-cc-typ! goalz)
  (clh-exp-typ! ih) (clh-exp-typ! z)
  (clh-cos-typ! clh-h) (clh-sin-typ! clh-h) (clh-cos-typ! mh) (clh-sin-typ! mh)
  (clh-and! (list 'IN L 'CC) (list 'IN ih 'CC))
  (fact 'cc-exp-add L ih)
  (fact 'cc-exp-i mh)
  (fact 'cc-cos-even clh-h) (fact 'cc-sin-odd clh-h)
