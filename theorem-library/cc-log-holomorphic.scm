(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ clh-lB) (list '== (list clh-lmap 'hbx_) (list '* (list clh-lcst 'hbx_) (list clh-lid 'hbx_)))))
  (lambda () (let ((x (dk-di-var!))) (clh-lpt! x) (clh-beta! (lambda () (qrfl))))))
(clh-chain! (dk-fact! 'holomorphic-product clh-lB clh-lcst clh-lid clh-lmap))
(dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES (list 'IN 'd2y_ clh-lB) (list 'IN (list clh-lmap 'd2y_) clh-lB1)))
  (lambda () (let ((y (dk-di-var!))) (clh-lpt! y) (clh-beta! (lambda () (ass))))))
(clh-chain! (dk-fact! 'cc-log-holomorphic-near-one clh-lr))
(define clh-lLH (list 'VNB-LAMBDA 'algz_ clh-lB1 '(CC-LOG algz_)))
(define clh-lcomp (list 'VNB-LAMBDA 'd2x_ clh-lB (list clh-lLH (list clh-lmap 'd2x_))))
(clh-chain! (dk-fact! 'holomorphic-compose clh-lB clh-lB1 clh-lmap clh-lLH))
;; log x = log a + log(x/a)
(define clh-lc2 (list 'VNB-LAMBDA 'hbx_ clh-lB clh-la))
(dk-apply! clh-lhc clh-la)
(clh-lam-typ! clh-lL clh-lB 'CC
  (lambda (x) (clh-lpt! x) (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-in-slit x))))))
(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ clh-lB) (list '== (list clh-lL 'hbx_) (list '+ (list clh-lc2 'hbx_) (list clh-lcomp 'hbx_)))))
