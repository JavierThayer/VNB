        (lambda ()
          (subst (clh-ring-id! '(clhu_ clhv_ clhw_) '(= (- (* clhu_ clhv_) 1) (+ (* clhu_ (- clhv_ clhw_)) (- (* clhu_ clhw_) 1))) (list clh-lia x 'clha_)))
          (subst (clh-ring-id! '(clhu_ clhv_) '(= (* clhu_ clhv_) (* clhv_ clhu_)) (list clh-lia 'clha_)))
          (subst clh-lcinv)
          (subst (clh-ring-id! '(clhu_) '(= (+ clhu_ (- 1 1)) clhu_) (list (list '* clh-lia xa))))
          (rfl)))
      (clh-rr-typ! (list 'magnitude u1)) (clh-rr-typ! mxa)
      (clh-rr-typ! (list '* clh-limag mxa))
      (clh-and! (list 'IN clh-lia 'CC) (list 'IN xa 'CC))
      (fact 'cc-magnitude-mul clh-lia xa)
      (dk-have! (list '= (list 'magnitude u1) (list '* clh-limag mxa))
        (lambda () (subst (list '= u1 (list '* clh-lia xa))) (ass)))
      (clh-and! (list '< 0 clh-limag) (list '< mxa clh-lrho))
      (clh-chain! (dk-fact! 'rr-lt-scale-pos clh-limag mxa clh-lrho))
      (dk-have! (list '< (list 'magnitude u1) clh-lr)
        (lambda () (dk-ineq! (list '= (list 'magnitude u1) (list '* clh-limag mxa)) (list '< (list '* clh-limag mxa) (list '* clh-limag clh-lrho))
                             (list '= (list '* clh-limag clh-lrho) clh-lr))))
      (clh-ball-in! u 1 clh-lr)
      (dk-split-all! (list (dk-apply! clh-lnear u)))
      (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec u))))
      (clh-cc-typ! z) (clh-exp-typ! z)
      (clh-rr-typ! (list 'imag-part lu)) (clh-rr-typ! (list 'imag-part z))
      (clh-and! (list 'IN clh-la 'CC) (list 'IN lu 'CC))
      (fact 'cc-im-add clh-la lu)
      (fact 'cc-exp-add clh-la lu)
      (let ((prem (list (list '= (list 'imag-part z) (list '+ clh-lY (list 'imag-part lu)))
                        (list '<= (list '- clh-lAY) clh-lY) (list '<= clh-lY clh-lAY)
                        (list '< (list '- clh-ldv) (list 'imag-part lu)) (list '< (list 'imag-part lu) clh-ldv)
                        (list '= clh-ldv clh-lD))))
        (dk-have! (clh-lo z) (lambda () (apply dk-ineq! prem)))
        (dk-have! (clh-hi z) (lambda () (apply dk-ineq! prem))))
      (dk-have! (list '= (list 'CC-EXP z) x)
        (lambda ()
          (subst (list '= (list 'CC-EXP z) (list '* (list 'CC-EXP clh-la) (list 'CC-EXP lu))))
          (subst (list '= (list 'CC-EXP clh-la) 'clha_))
          (subst (list '= (list 'CC-EXP lu) u))
          (subst (clh-ring-id! '(clhu_ clhv_ clhw_) '(= (* clhu_ (* clhv_ clhw_)) (* (* clhu_ clhv_) clhw_)) (list 'clha_ clh-lia x)))
          (subst clh-lcinv)
          (subst (clh-ring-id! '(clhu_) '(= (* 1 clhu_) clhu_) (list x)))
          (rfl)))
      (clh-chain! (dk-fact! 'cc-log-char x z))
      (clh-chain! (dk-fact! 'cc-exp-open-strip-avoids-negatives z))
      (dk-have! (clh-slit x) (lambda () (subst (list '= x (list 'CC-EXP z))) (ass)))
      (dk-conj-close! (lambda () (ass))))))
(define (clh-lpt! x)
  (if (not (dk-asm? (list 'IN (list '* clh-lia x) clh-lB1)))
      (dk-split-all! (list (dk-apply! (dk-ctx-form clh-lptf) x))))
