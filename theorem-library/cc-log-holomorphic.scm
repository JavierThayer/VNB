      (subst (list '= (list 'CC-EXP L) 'clhw_))
      (subst (list '= (list 'CC-EXP ih) (list '+ (list 'CC-COS mh) (list '* +i (list 'CC-SIN mh)))))
      (subst (list '= (list 'CC-COS mh) (list 'CC-COS clh-h)))
      (subst (list '= (list 'CC-SIN mh) (list '- (list 'CC-SIN clh-h))))
