(let* ((L '(CC-LOG clhw_)) (ih (list '* +i clh-h)) (z (list '+ L ih)) (iw '(* +i clhw_)))
  (clh-cc-typ! ih) (clh-cc-typ! z) (clh-cc-typ! iw)
