  (dk-apply! (clh-chain! (dk-fact! 'cps-converges-closed-ball c mt)) mz)
  (clh-lam-typ! h0 'NN 'CC (lambda (k) (clh-cc-typ! (list '* (list c k) (list 'power mz k)))))
  (clh-lam-typ! f 'NN 'CC
    (lambda (k)
      (clh-rr-typ! (list 'RECIP-STAR k)) (fact 'rr-subset-cc (list 'RECIP-STAR k))
      (clh-cc-typ! (list '* (list 'RECIP-STAR k) (list 'power z k)))))
  (fact 'cc-series-limit-in-cc h0)
  ;; the terms: z^k/k = -1 . c(k) (-z)^k + 0 . c(k) (-z)^k
  (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
              (list '= (list f 'cpdj_) (list '+ (list '* -1 (list h0 'cpdj_)) (list '* 0 (list h0 'cpdj_))))))
    (lambda ()
      (let* ((j (dk-di-var!)) (P (list 'power -1 j)) (Zj (list 'power z j)) (RS (list 'RECIP-STAR j))
             (mzj (list 'power mz j)) (m1z (list '* -1 z)))
        (clh-rr-typ! RS) (fact 'rr-subset-cc RS)
        (clh-cc-typ! P) (clh-cc-typ! Zj) (clh-cc-typ! mzj) (clh-cc-typ! m1z)
        (clh-cc-typ! (list 'power m1z j)) (clh-cc-typ! (list '* -1 -1)) (clh-cc-typ! (list 'power (list '* -1 -1) j))
        (clh-cc-typ! (list 'power 1 j)) (clh-cc-typ! (list '* P P))
        (dk-have! (list '= mz m1z) (lambda () (crs)))
        (dk-congr! (list '= mz m1z) (lambda (u) (list 'power u j)))
        (fact 'cc-power-mul-base j -1 z)
        (fact 'cc-power-mul-base j -1 -1)
        (dk-have! '(= (* -1 -1) 1) (lambda () (arith)))
        (dk-congr! '(= (* -1 -1) 1) (lambda (u) (list 'power u j)))
