  (fact 'cc-cos-half-pi) (fact 'cc-sin-half-pi)
  (dk-have! (list '= cu st)
    (lambda ()
      (subst (list '= cu (list '- (list '* '(CC-COS clht_) (list 'CC-COS mh)) (list '* st (list 'CC-SIN mh)))))
      (subst (list '= (list 'CC-COS mh) (list 'CC-COS clh-h)))
      (subst (list '= (list 'CC-SIN mh) (list '- (list 'CC-SIN clh-h))))
      (subst (list '= (list 'CC-COS clh-h) 0))
      (subst (list '= (list 'CC-SIN clh-h) 1))
