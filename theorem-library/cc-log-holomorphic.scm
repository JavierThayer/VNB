          (clh-absurd! '(<= (+ clhr_ (* clhr_ PI)) PI) '(= (* clhr_ PI) PI) '(= clhr_ 1)))
        (lambda ()
          (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
          (dk-have! '(<= 1 clhr_) (lambda () (dk-ineq! '(< 1 clhr_))))
          (clh-chain! (dk-fact! 'rr-mul-le-right 1 'clhr_ 'PI))
          (clh-rr-typ! '(* 1 PI))
          (dk-have! '(= (* 1 PI) PI) (lambda () (subst (clh-ring-id! '(clhu_) '(= (* 1 clhu_) clhu_) (list 'PI))) (rfl)))
          (clh-absurd! '(<= (+ clhr_ (* clhr_ PI)) PI) '(<= (* 1 PI) (* clhr_ PI)) '(= (* 1 PI) PI) '(< 1 clhr_)))))))
(define clh-om-f '(VNB-LAMBDA clhk_ NN (* (RECIP-STAR clhk_) (power clhz_ clhk_))))
(sp (make-wff (list 'FORALL 'clhr_ (list 'IMPLIES '(IN clhr_ RR) (list 'IMPLIES '(< 0 clhr_) (list 'IMPLIES '(<= (* clhr_ (+ 1 PI)) PI)
  (list 'FORALL 'clhz_ (list 'IMPLIES '(IN clhz_ CC) (list 'IMPLIES '(< (magnitude clhz_) clhr_)
    (list '= '(CC-LOG (- 1 clhz_)) (list '- (list 'CC-SERIES-LIMIT clh-om-f))))))))))))
(dk-peel!)
(clh-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
(clh-pi-typ!)
(clh-rad-facts! 'clhr_)
(clh-rho-lt-one!)
(define clh-om-c (clh-log-coefs!))
(define clh-om-ve clh-coef-ve)
(let* ((z 'clhz_) (mz '(- clhz_)) (c clh-om-c) (ve clh-om-ve)
       (h0 (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list c 'cpsk_) (list 'power mz 'cpsk_))))
       (f clh-om-f) (L0 (list 'CC-SERIES-LIMIT h0)) (Lf (list 'CC-SERIES-LIMIT f))
       (t '(magnitude clhz_)) (mt (list 'magnitude mz)))
  (clh-cc-typ! mz) (clh-cc-typ! -1)
  (clh-rr-typ! t) (clh-rr-typ! mt)
  (fact 'cc-magnitude-neg z)
  (fact 'cc-magnitude-nonneg mz)
  (dk-have! (list '< mt 'clhr_) (lambda () (dk-ineq! (list '= mt t) (list '< t 'clhr_))))
