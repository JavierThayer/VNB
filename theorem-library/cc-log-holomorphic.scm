(clh-cc-typ! clh-lr) (clh-pts! 1)
;; the point facts, once, as a universal
(dk-have! clh-lptf
  (lambda ()
    (let* ((x (dk-di-var!)) (u (list '* clh-lia x)) (xa (list '- x 'clha_)) (u1 (list '- u 1))
           (lu (list 'CC-LOG u)) (z (clh-lz x)) (mxa (list 'magnitude xa)))
