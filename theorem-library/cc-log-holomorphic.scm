    (let ((x (subset-by-element!)))
      (clh-lpt! x)
      (in-sep! (lambda () (ass)) (lambda () (ass))))))
;; the pieces: M(x) = x/a maps B(a, rho) into B(1, r), holomorphically
(clh-ball-open! 'clha_ clh-lrho)
(define clh-lmap (list 'VNB-LAMBDA 'clhy_ clh-lB (list '* clh-lia 'clhy_)))
(clh-lam-typ! clh-lmap clh-lB 'CC (lambda (x) (clh-lpt! x)))
(define clh-lcst (list 'VNB-LAMBDA 'hbx_ clh-lB clh-lia))
(define clh-lid (list 'VNB-LAMBDA 'hbx_ clh-lB 'hbx_))
(define clh-lhc (clh-chain! (dk-fact! 'holomorphic-const clh-lB)))
