(qed 'cc-log-rotate-neg)
;;; ======================================================================
;;; (3b) NEAR 1 THE ARGUMENT IS SMALL: for 0 < D and r with r (1 + pi) <= pi
;;; and r (1 + D) <= D, |Im log z| < D on B(1, r).  On that ball log = log0
;;; (log0-is-log-on-ball) and |log0 z| <= t/(1 - t), t = |z - 1| < r
;;; (log0-bound); t/(1 - t) < D is t (1 + D) < D.  No numerical fact about pi.
;;; ======================================================================
(define clh-B1 '(BALL CC-MS 1 clhr_))
(sp (make-wff '(FORALL clhd_ (IMPLIES (IN clhd_ RR) (IMPLIES (< 0 clhd_)
  (FORALL clhr_ (IMPLIES (IN clhr_ RR) (IMPLIES (< 0 clhr_) (IMPLIES (<= (* clhr_ (+ 1 PI)) PI) (IMPLIES (<= (* clhr_ (+ 1 clhd_)) clhd_)
    (FORALL clhz_ (IMPLIES (IN clhz_ (BALL CC-MS 1 clhr_))
      (AND (NOT (AND (= (imag-part clhz_) 0) (<= (real-part clhz_) 0)))
        (AND (< (- clhd_) (imag-part (CC-LOG clhz_))) (< (imag-part (CC-LOG clhz_)) clhd_)))))))))))))))
(dk-peel!)
(clh-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
(clh-pi-typ!)
(clh-rad-facts! 'clhr_)
;; r < 1
(clh-rr-typ! '(+ 1 clhd_)) (clh-rr-typ! '(* clhr_ clhd_)) (clh-rr-typ! '(* clhr_ (+ 1 clhd_)))
(dk-have! '(= (* clhr_ (+ 1 clhd_)) (+ clhr_ (* clhr_ clhd_)))
  (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* clhu_ (+ 1 clhv_)) (+ clhu_ (* clhu_ clhv_))) (list 'clhr_ 'clhd_))) (rfl)))
(dk-have! '(< clhr_ 1)
  (lambda ()
    (use-cases (dk-fact! 'rr-lt-trichotomy 'clhr_ 1)
      (lambda () (ass))
      (lambda ()
        (dk-have! '(= (* clhr_ clhd_) clhd_) (lambda () (subst '(= clhr_ 1)) (subst (clh-ring-id! '(clhu_) '(= (* 1 clhu_) clhu_) (list 'clhd_))) (rfl)))
        (clh-absurd! '(<= (* clhr_ (+ 1 clhd_)) clhd_) '(= (* clhr_ (+ 1 clhd_)) (+ clhr_ (* clhr_ clhd_))) '(= (* clhr_ clhd_) clhd_) '(= clhr_ 1)))
      (lambda ()
        (dk-have! '(<= 0 clhd_) (lambda () (dk-ineq! '(< 0 clhd_))))
        (dk-have! '(<= 1 clhr_) (lambda () (dk-ineq! '(< 1 clhr_))))
        (clh-chain! (dk-fact! 'rr-mul-le-right 1 'clhr_ 'clhd_))
        (clh-rr-typ! '(* 1 clhd_))
        (dk-have! '(= (* 1 clhd_) clhd_) (lambda () (subst (clh-ring-id! '(clhu_) '(= (* 1 clhu_) clhu_) (list 'clhd_))) (rfl)))
        (clh-absurd! '(<= (* clhr_ (+ 1 clhd_)) clhd_) '(= (* clhr_ (+ 1 clhd_)) (+ clhr_ (* clhr_ clhd_)))
                     '(<= (* 1 clhd_) (* clhr_ clhd_)) '(= (* 1 clhd_) clhd_) '(< 1 clhr_))))))
(define clh-ib-c (clh-log-coefs!))
(clh-ball-cc! 'clhz_ 1 'clhr_)
(clh-ball-lt! 'clhz_ 1 'clhr_)
(define clh-ib-S (clh-S1c clh-ib-c 'clhz_))
(dk-apply! (clh-chain! (dk-fact! 'log0-is-log-on-ball clh-ib-c 'clhr_)) 'clhz_)
(dk-apply! (clh-chain! (dk-fact! 'log0-bound clh-ib-c 'clhr_)) 'clhz_)
(let* ((z 'clhz_) (LZ '(CC-LOG clhz_)) (Sv clh-ib-S) (X (list 'imag-part LZ)) (M (list 'magnitude LZ)) (MS (list 'magnitude Sv))
       (w '(- clhz_ 1)) (t (list 'magnitude w)) (s1 (list '- 1 t)) (R (list 'recip s1)) (bd (list '- R 1))
       (q '(+ 1 clhd_)) (qt (list '* q t)) (qs (list '* q s1)) (qr (list '* q 'clhr_)) (td (list '* t 'clhd_)))
  (clh-cc-typ! w) (clh-rr-typ! t) (fact 'cc-magnitude-nonneg w)
  (dk-have! '(<= clhr_ 1) (lambda () (dk-ineq! '(< clhr_ 1))))
  (clh-re-pos! z 1 'clhr_)
  (clh-slit-re! z)
  (dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-in-slit z))))
  (dk-have! (list 'IN Sv 'CC) (lambda () (subst (list '= Sv LZ)) (ass)))
  (clh-rr-typ! X) (clh-rr-typ! M) (clh-rr-typ! MS)
  (fact 'cc-abs-im-le-magnitude LZ)
  (dk-congr! (list '= LZ Sv) (lambda (u) (list 'magnitude u)))
  (clh-rr-typ! s1)
  (dk-have! (list '< t 1) (lambda () (dk-ineq! (list '< t 'clhr_) '(< clhr_ 1))))
  (dk-have! (list '< 0 s1) (lambda () (dk-ineq! (list '< t 1))))
  (dk-have! (list 'NOT (list '= s1 0)) (lambda () (di) (clh-absurd! (list '= s1 0) (list '< 0 s1))))
  (clh-rr-typ! R)
  (fact 'rr-recip-pos s1)
  (let ((inv (clh-chain! (dk-fact! 'rr-recip-inverse s1))))
    (clh-rr-typ! bd)
    (clh-rr-typ! (list 'abs X))
    (dk-have! (list '<= (list 'abs X) bd) (lambda () (dk-ineq! (list '<= (list 'abs X) M) (list '= M MS) (list '<= MS bd))))
    (dk-split-all! (list (clh-chain! (dk-fact! 'rr-abs-le-parts X bd))))
    (dk-have! (list '< 0 q) (lambda () (dk-ineq! '(< 0 clhd_))))
    (clh-chain! (dk-fact! 'rr-lt-scale-pos q t 'clhr_))
    (clh-rr-typ! qt) (clh-rr-typ! qs) (clh-rr-typ! qr) (clh-rr-typ! td)
    (dk-have! (list '= qr '(+ clhr_ (* clhr_ clhd_)))
      (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (+ 1 clhv_) clhu_) (+ clhu_ (* clhu_ clhv_))) (list 'clhr_ 'clhd_))) (rfl)))
    (dk-have! (list '= qs (list '- q (list '+ t td)))
      (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (+ 1 clhv_) (- 1 clhu_)) (- (+ 1 clhv_) (+ clhu_ (* clhu_ clhv_)))) (list t 'clhd_))) (rfl)))
    (dk-have! (list '= qt (list '+ t td))
      (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (+ 1 clhv_) clhu_) (+ clhu_ (* clhu_ clhv_))) (list t 'clhd_))) (rfl)))
    (dk-have! (list '< 1 qs)
      (lambda ()
        (dk-ineq! (list '< qt qr) (list '= qr '(+ clhr_ (* clhr_ clhd_))) '(<= (* clhr_ (+ 1 clhd_)) clhd_)
                  '(= (* clhr_ (+ 1 clhd_)) (+ clhr_ (* clhr_ clhd_)))
                  (list '= qs (list '- q (list '+ t td))) (list '= qt (list '+ t td)))))
    (dk-have! (list 'AND (list '< 0 R) (list '< 1 qs)) (lambda () (dk-conj-close! (lambda () (ass)))))
    (clh-chain! (dk-fact! 'rr-lt-scale-pos R 1 qs))
    (clh-rr-typ! (list '* R 1)) (clh-rr-typ! (list '* R qs))
    (dk-have! (list '= (list '* R 1) R) (lambda () (subst (clh-ring-id! '(clhu_) '(= (* clhu_ 1) clhu_) (list R))) (rfl)))
    (dk-have! (list '= (list '* R qs) q)
      (lambda ()
        (subst (clh-ring-id! '(clhu_ clhv_ clhw_) '(= (* clhu_ (* clhv_ clhw_)) (* clhv_ (* clhw_ clhu_))) (list R q s1)))
        (subst inv)
        (subst (clh-ring-id! '(clhu_) '(= (* clhu_ 1) clhu_) (list q)))
        (rfl)))
    (let ((prem (list (list '<= (list '- bd) X) (list '<= X bd) (list '< (list '* R 1) (list '* R qs))
                      (list '= (list '* R 1) R) (list '= (list '* R qs) q))))
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'NOT) (ass) (apply dk-ineq! prem)))))))
(qed 'cc-log-im-near-one)
;;; ======================================================================
;;; (3c) log IS HOLOMORPHIC NEAR EVERY POINT a OF THE SLIT PLANE.  With
;;; D = pi - |Im log a| > 0 and r = D / (2 (1 + pi)) (so r (1 + pi) = D/2 <= pi
;;; and r (1 + D) <= D), every x of B(a, |a| r) is a u with u = x/a in B(1, r),
;;; |Im log u| < D, so Im(log a + log u) stays in (-pi, pi) and
;;; log x = log a + log(x/a) (cc-log-char); the right side is holomorphic
;;; (cc-log-holomorphic-near-one, holomorphic-compose with x |-> x/a).
;;; ======================================================================
(define clh-slit-set '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(define clh-la '(CC-LOG clha_))
(define clh-lY (list 'imag-part clh-la))
(define clh-lAY (list 'abs clh-lY))
(define clh-lD (list '- 'PI clh-lAY))
(define clh-lm '(* 2 (+ 1 PI)))
(define clh-lK (list 'recip clh-lm))
(define clh-lmag '(magnitude clha_))
(define clh-lia '(recip clha_))
(define clh-limag (list 'magnitude clh-lia))
(define (clh-lz x) (list '+ clh-la (list 'CC-LOG (list '* clh-lia x))))
;;; a real term as a SYMBOL (so that ineq sees an atom, not a cubic): lands
;;; (IN v RR) and (= v T); returns v
(define (clh-name! b t)
  (let ((ex (list 'FORSOME b (list 'AND (list 'IN b 'RR) (list '= b t)))))
    (dk-have! ex (lambda () (ew t) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))))
    (dk-skolem! (dk-ctx-form ex))))
(define clh-ldv #f) (define clh-lr #f) (define clh-lrho #f) (define clh-lB #f) (define clh-lB1 #f)
(define clh-lL #f) (define clh-lptf #f)
(sp (make-wff (list 'FORALL 'clha_ (list 'IMPLIES '(IN clha_ CC) (list 'IMPLIES (clh-slit 'clha_)
  (list 'FORSOME 'clhp_ (list 'AND '(IN clhp_ RR) (list 'AND '(< 0 clhp_)
    (list 'AND (list 'SUBSET (clh-B 'clha_ 'clhp_) clh-slit-set)
      (list 'HOLOMORPHIC-ON (clh-B 'clha_ 'clhp_) (list 'VNB-LAMBDA 'clhx_ (clh-B 'clha_ 'clhp_) '(CC-LOG clhx_))))))))))))
(dk-peel!)
(clh-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
(clh-pi-typ!)
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec 'clha_))))
;; D = pi - |Im log a| in (0, pi]
(clh-rr-typ! clh-lY) (clh-rr-typ! clh-lAY) (clh-rr-typ! clh-lD)
(fact 'rr-abs-nonneg clh-lY)
(dk-have! (list '<= clh-lAY clh-lAY) (lambda () (dk-ineq!)))
(dk-split-all! (list (clh-chain! (dk-fact! 'rr-abs-le-parts clh-lY clh-lAY))))
(clh-chain! (dk-fact! 'rr-abs-lt-of-parts clh-lY 'PI))
(set! clh-ldv (clh-name! 'clhdv_ clh-lD))
(dk-have! (list '< 0 clh-ldv) (lambda () (dk-ineq! (list '< clh-lAY 'PI) (list '= clh-ldv clh-lD))))
(dk-have! (list '<= clh-ldv 'PI) (lambda () (dk-ineq! (list '<= 0 clh-lAY) (list '= clh-ldv clh-lD))))
;; r = D / (2 (1 + pi))
(clh-rr-typ! clh-lm)
(dk-have! (list '< 0 clh-lm) (lambda () (dk-ineq! '(< 0 PI))))
(dk-have! (list 'NOT (list '= clh-lm 0)) (lambda () (di) (clh-absurd! (list '= clh-lm 0) (list '< 0 clh-lm))))
(clh-rr-typ! clh-lK)
(fact 'rr-recip-pos clh-lm)
(define clh-lK-inv (clh-chain! (dk-fact! 'rr-recip-inverse clh-lm)))
(clh-rr-typ! (list '* clh-ldv clh-lK))
(set! clh-lr (clh-name! 'clhrv_ (list '* clh-ldv clh-lK)))
(clh-chain! (dk-fact! 'rr-lt-scale-pos clh-ldv 0 clh-lK))
(clh-rr-typ! (list '* clh-ldv 0))
(dk-have! (list '= (list '* clh-ldv 0) 0) (lambda () (subst (clh-ring-id! '(clhu_) '(= (* clhu_ 0) 0) (list clh-ldv))) (rfl)))
(dk-have! (list '< 0 clh-lr) (lambda () (dk-ineq! (list '< (list '* clh-ldv 0) (list '* clh-ldv clh-lK)) (list '= (list '* clh-ldv 0) 0)
                                                 (list '= clh-lr (list '* clh-ldv clh-lK)))))
(clh-rad-facts! clh-lr)
(define clh-lr1p (list '* clh-lr '(+ 1 PI)))
(define clh-lr1d (list '* clh-lr (list '+ 1 clh-ldv)))
(clh-rr-typ! clh-lr1p) (clh-rr-typ! clh-lr1d) (clh-rr-typ! (list '* clh-ldv 1))
(dk-have! (list '= clh-lr1p (list '* 1/2 (list '* clh-ldv 1)))
  (lambda ()
    (subst (list '= clh-lr (list '* clh-ldv clh-lK)))
    (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (* clhu_ clhv_) (+ 1 PI)) (* 1/2 (* clhu_ (* (* 2 (+ 1 PI)) clhv_))))
                         (list clh-ldv clh-lK)))
    (subst clh-lK-inv)
    (rfl)))
(dk-have! (list '<= clh-lr1p 'PI) (lambda () (dk-ineq! (list '= clh-lr1p (list '* 1/2 (list '* clh-ldv 1))) (list '<= clh-ldv 'PI) '(< 0 PI))))
(clh-and! (list '<= 0 clh-lr) (list '<= clh-ldv 'PI))
(clh-chain! (dk-fact! 'rr-le-scale-nonneg clh-lr clh-ldv 'PI))
(clh-rr-typ! (list '* clh-lr clh-ldv)) (clh-rr-typ! (list '* clh-lr 'PI))
(dk-have! (list '= clh-lr1d (list '+ clh-lr (list '* clh-lr clh-ldv)))
  (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* clhu_ (+ 1 clhv_)) (+ clhu_ (* clhu_ clhv_))) (list clh-lr clh-ldv))) (rfl)))
(dk-have! (list '= clh-lr1p (list '+ clh-lr (list '* clh-lr 'PI)))
  (lambda () (subst (clh-ring-id! '(clhu_ clhv_) '(= (* clhu_ (+ 1 clhv_)) (+ clhu_ (* clhu_ clhv_))) (list clh-lr 'PI))) (rfl)))
(dk-have! (list '<= clh-lr1d clh-ldv)
  (lambda ()
    (dk-ineq! (list '= clh-lr1d (list '+ clh-lr (list '* clh-lr clh-ldv))) (list '= clh-lr1p (list '+ clh-lr (list '* clh-lr 'PI)))
              (list '<= (list '* clh-lr clh-ldv) (list '* clh-lr 'PI)) (list '= clh-lr1p (list '* 1/2 (list '* clh-ldv 1)))
              (list '< 0 clh-ldv))))
(define clh-lnear (clh-chain! (dk-fact! 'cc-log-im-near-one clh-ldv clh-lr)))
;; a /= 0, |a| > 0, 1/a, |1/a| |a| = 1
(dk-have! '(NOT (= clha_ 0))
  (lambda ()
    (di)
    (dk-have! '(AND (= (imag-part clha_) 0) (<= (real-part clha_) 0))
      (lambda ()
        (subst '(= clha_ 0))
        (dk-conj-close! (lambda () (arith)))))
    (ai (clh-slit 'clha_))))
(clh-rr-typ! clh-lmag)
(fact 'cc-magnitude-nonneg 'clha_)
(dk-have! (list 'NOT (list '= 0 clh-lmag))
  (lambda ()
    (di)
    (let* ((iff (dk-fact! 'cc-magnitude-zero-iff 'clha_))
           (ims (dk-landed (lambda () (ai iff))))
           (fw (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list '= clh-lmag 0)))) ims)))
      (dk-have! (list '= clh-lmag 0) (lambda () (subst (list '= 0 clh-lmag)) (rfl)))
