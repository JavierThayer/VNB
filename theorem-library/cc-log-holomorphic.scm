  (dk-have! (list '< mh u) (lambda () (dk-ineq! '(< 0 clht_))))
  (dk-have! (list '< u clh-h) (lambda () (dk-ineq! '(< clht_ PI))))
  (clh-chain! (dk-fact! 'cc-cos-pos-half u))
  (dk-ineq! (list '< 0 cu) (list '= cu st)))
(qed 'cc-sin-pos-half)

;;; ======================================================================
;;; LEMMA 2.20 AS ONE EQUATION: the radius of the logarithmic series is 1.
;;; CPS-RADIUS lies in [0, inf]; a real radius below 1 would put its midpoint
;;; with 1 below it (cps-log-radius), one above 1 would put its midpoint with 1
;;; below it (cps-log-radius-le-one), and inf would put 2 below it.
;;; ======================================================================
(define clh-rd-lv1 '(FORALL clhj_ (IMPLIES (IN clhj_ NN) (= (clhc_ (succ clhj_)) (* (power -1 clhj_) (recip (succ clhj_)))))))
(sp (make-wff (list 'FORALL 'clhc_ (list 'IMPLIES '(IN clhc_ (FUN NN CC)) (list 'IMPLIES '(= (clhc_ 0) 0)
  (list 'IMPLIES clh-rd-lv1 '(= (CPS-RADIUS clhc_) 1)))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((R '(CPS-RADIUS clhc_)) (m (list '* 1/2 (list '+ R 1))))
  (fact 'cps-radius-in 'clhc_)
  (let* ((iff (dk-fact! 'rr-pos-star-membership R))
         (ims (dk-landed (lambda () (ai iff))))
         (fw (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list 'IN R 'RR-POS-STAR)))) ims)))
    (use-cases (dk-landed-1 (lambda () (detach! fw)))
      (lambda ()
        (dk-split-all!)
        (clh-rr-typ! m)
        (use-cases (dk-fact! 'rr-lt-trichotomy R 1)
          (lambda ()
            (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '<= 0 R))))
            (dk-have! (list '< m 1) (lambda () (dk-ineq! (list '< R 1))))
            (clh-chain! (dk-fact! 'cps-log-radius 'clhc_ m))
            (clh-absurd! (list '< m R) (list '< R 1)))
          (lambda () (ass))
          (lambda ()
            (dk-have! (list '< 1 m) (lambda () (dk-ineq! (list '< 1 R))))
            (clh-chain! (dk-fact! 'cps-log-radius-le-one 'clhc_ m))
            (dk-have! (list '< m R) (lambda () (dk-ineq! (list '< 1 R))))
            (ai (list 'NOT (list '< m R))))))
      (lambda ()
        (dk-have! '(IN 2 RR) (lambda () (arith)))
        (dk-have! '(< 1 2) (lambda () (arith)))
        (clh-chain! (dk-fact! 'cps-log-radius-le-one 'clhc_ 2))
        (dk-have! (list '< 2 R)
          (lambda ()
            (subst (list '= R 'POS-INF))
            (fact 'rr-subset-rr-star)
            (fact 'subset-mem-fwd 'RR 'RR-STAR 2)
            (fact 'pos-inf-upper-bound 2)
            (fact 'pos-inf-not-in-rr)
            (mac '<)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'NOT)
                    (begin
                      (di)
                      (dk-have! '(IN POS-INF RR) (lambda () (subst '(= POS-INF 2)) (ass)))
                      (ai '(NOT (IN POS-INF RR))))
                    (ass))))))
        (ai (list 'NOT (list '< 2 R)))))))
(qed 'cps-log-radius-one)
