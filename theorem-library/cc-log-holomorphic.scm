        (dk-have! (list '= (list '* P P) 1)
          (lambda ()
            (subst (list '= (list '* P P) (list 'power (list '* -1 -1) j)))
            (subst (list '= (list 'power (list '* -1 -1) j) (list 'power 1 j)))
            (subst (list '= (list 'power 1 j) 1))
            (rfl)))
        (clh-beta!
          (lambda ()
            (subst (dk-apply! ve j))
            (subst (list '= mzj (list 'power m1z j)))
            (subst (list '= (list 'power m1z j) (list '* P Zj)))
            (subst (clh-ring-id! '(clhu_ clhv_ clhq_)
                     '(= (+ (* -1 (* (* (- clhu_) clhv_) (* clhu_ clhq_))) (* 0 (* (* (- clhu_) clhv_) (* clhu_ clhq_))))
                         (* (* clhu_ clhu_) (* clhv_ clhq_)))
                     (list P RS Zj)))
            (subst (list '= (list '* P P) 1))
            (crs))))))
  (dk-split-all! (list (clh-chain! (dk-fact! 'cc-series-limit-linear h0 h0 f -1 0))))
  (clh-cc-typ! '(+ 1 (- clhz_)))
  (dk-have! (list '= '(- 1 clhz_) '(+ 1 (- clhz_))) (lambda () (crs)))
  (dk-congr! (list '= '(- 1 clhz_) '(+ 1 (- clhz_))) (lambda (u) (list 'CC-LOG u)))
  (subst (list '= '(CC-LOG (- 1 clhz_)) '(CC-LOG (+ 1 (- clhz_)))))
  (subst (list '= '(CC-LOG (+ 1 (- clhz_))) L0))
  (subst (list '= Lf (list '+ (list '* -1 L0) (list '* 0 L0))))
  (crs))
(qed 'cc-log-one-minus)
;;; ======================================================================
;;; (4) LEMMA 2.20, THE OTHER HALF: the radius of sum (-1)^(k-1) z^k / k is at
;;; most 1.  First, the terms of a convergent complex series are eventually
;;; small (f(n) = (S(n+1) - L) - (S(n) - L)); then at a real r > 1 the terms
;;; have |c(n) r^n| = r^n / n >= (1 + n (r - 1)) / n > r - 1 (Bernoulli).
;;; ======================================================================
(sp (make-wff '(FORALL clhf_ (IMPLIES (IN clhf_ (FUN NN CC)) (IMPLIES (CC-SERIES-CONVERGES clhf_)
  (FORALL clhe_ (IMPLIES (POS-RR clhe_)
    (FORSOME clhn_ (AND (IN clhn_ NN) (FORALL clhm_ (IMPLIES (IN clhm_ NN) (IMPLIES (<= clhn_ clhm_)
      (<= (magnitude (clhf_ clhm_)) clhe_)))))))))))))
(dk-peel!)
(let loop ((i 0)) (if (and (< i 4) (not (dk-head-is? (dk-goal) 'FORSOME))) (begin (dk-peel!) (loop (+ i 1)))))
(clh-ms-setup!)
(fact 'rr-zero-in)
(define clh-ts-eps (cadr (dk-pick (dk-head? 'POS-RR) "the epsilon")))
(define clh-ts-f (cadr (dk-pick (dk-head? 'CC-SERIES-CONVERGES) "the convergence")))
(let* ((f clh-ts-f) (eps clh-ts-eps) (L (list 'CC-SERIES-LIMIT f)) (S (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM f 'k)))
       (e2 (list '* 1/2 eps)))
  (clh-chain! (dk-fact! 'rr-pos-rr-in-rr eps))
  (clh-chain! (dk-fact! 'rr-lt-of-pos-rr eps))
  (clh-rr-typ! e2)
  (dk-have! (list '< 0 e2) (lambda () (dk-ineq! (list '< 0 eps))))
  (clh-pos-rr! e2)
  (fact 'cc-series-limit-in-cc f)
  (let ((c (clh-chain! (dk-fact! 'cc-series-limit-converges-to f))))
    (mac-h 'cc-series-converges-to c))
  (mac-h 'converges-to (dk-ctx-form (list 'CONVERGES-TO 'CC-MS S L)))
  (dk-split-all!)
  (let* ((tail (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR) (dk-contains? x 'DIST))) "the convergence tail"))
         (N (dk-skolem! (dk-apply! tail e2)))
         (inner (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x N) (dk-contains? x 'DIST))) "the tail at N")))
    (dk-have! (list 'IN S '(FUN NN CC)) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
    (ew N)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (let* ((ld (dk-peel!)) (m (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) 'NN))) ld))) (sm (list 'succ m))
                   (S0 (list S m)) (S1 (list S sm)) (fm (list f m))
                   (A (list '- S1 L)) (B (list '- S0 L)) (p (list '- A B)))
              (clh-nn-typ! sm)
              (fact 'nn-le-succ m)
              (clh-and! (list '<= N m) (list '<= m sm))
              (fact 'nn-le-trans-guarded N m sm)
              (dk-apply! inner m) (dk-apply! inner sm)
              (clh-cc-typ! S0) (clh-cc-typ! S1) (clh-cc-typ! fm)
              (clh-cc-typ! A) (clh-cc-typ! B) (clh-cc-typ! p)
              (fact 'cc-series-partial-sum-in-cc m f)
              (dk-have! (list '= S1 (list '+ S0 fm))
                (lambda ()
                  (clh-beta!
                    (lambda ()
                      (subst (clh-chain! (dk-fact! 'cc-series-partial-sum-succ f m)))
                      (rfl)))))
              (clh-pts! S0) (clh-pts! S1)
              (fact 'cc-ms-dist S0 L) (fact 'cc-ms-dist S1 L)
              (clh-rr-typ! (list 'magnitude A)) (clh-rr-typ! (list 'magnitude B)) (clh-rr-typ! (list 'magnitude p))
              (clh-rr-typ! (list 'magnitude fm))
              (dk-have! (list '<= (list 'magnitude A) e2)
                (lambda () (subst (list '= (list 'magnitude A) (list '(DIST CC-MS) S1 L))) (ass)))
              (dk-have! (list '<= (list 'magnitude B) e2)
                (lambda () (subst (list '= (list 'magnitude B) (list '(DIST CC-MS) S0 L))) (ass)))
              (fact 'cc-magnitude-le-add p A)
              (clh-cc-typ! (list '- p A)) (clh-cc-typ! (list '- B))
              (clh-rr-typ! (list 'magnitude (list '- p A))) (clh-rr-typ! (list 'magnitude (list '- B)))
              (dk-have! (list '= (list '- p A) (list '- B)) (lambda () (crs)))
              (dk-congr! (list '= (list '- p A) (list '- B)) (lambda (u) (list 'magnitude u)))
              (fact 'cc-magnitude-neg B)
              (dk-have! (list '= fm p) (lambda () (subst (list '= S1 (list '+ S0 fm))) (crs)))
              (dk-congr! (list '= fm p) (lambda (u) (list 'magnitude u)))
              (dk-ineq! (list '= (list 'magnitude fm) (list 'magnitude p))
                        (list '<= (list 'magnitude p) (list '+ (list 'magnitude (list '- p A)) (list 'magnitude A)))
                        (list '= (list 'magnitude (list '- p A)) (list 'magnitude (list '- B)))
                        (list '= (list 'magnitude (list '- B)) (list 'magnitude B))
                        (list '<= (list 'magnitude A) e2) (list '<= (list 'magnitude B) e2))))))))
(qed 'cc-series-terms-small)

;;; the radius of the logarithmic series is at most 1: no real r > 1 lies below it
(define clh-le-inv #f)
(sp (make-wff '(FORALL clhc_ (IMPLIES (IN clhc_ (FUN NN CC)) (IMPLIES (= (clhc_ 0) 0)
  (IMPLIES (FORALL clhj_ (IMPLIES (IN clhj_ NN) (= (clhc_ (succ clhj_)) (* (power -1 clhj_) (recip (succ clhj_))))))
    (FORALL clhr_ (IMPLIES (IN clhr_ RR) (IMPLIES (< 1 clhr_) (NOT (< clhr_ (CPS-RADIUS clhc_))))))))))))
(dk-peel!)
(clh-ms-setup!)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-zero-in)
(di)
(let* ((c 'clhc_) (r 'clhr_) (h (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list c 'cpsk_) (list 'power r 'cpsk_))))
       (e (list '* 1/2 (list '- r 1))))
  (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 1 r))))
  (fact 'rr-subset-cc r)
  (fact 'cc-ms-dist 0 r)
  (clh-cc-typ! (list '- 0 r))
  (dk-have! (list 'IN r (list 'CLOSED-BALL 'CC-MS 0 r))
    (lambda ()
      (mac 'closed-ball-membership)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (subst '(== (PTS CC-MS) CC)) (ass))
              (begin
                (subst (list '== (list '(DIST CC-MS) 0 r) (list 'magnitude (list '- 0 r))))
                (dk-have! (list '= (list '- 0 r) (list '- r)) (lambda () (crs)))
                (subst (list '= (list '- 0 r) (list '- r)))
                (subst (dk-fact! 'cc-magnitude-neg r))
                (subst (dk-fact! 'rr-magnitude-is-abs r))
                (subst (clh-chain! (dk-fact! 'rr-abs-of-nonneg r)))
                (dk-ineq!)))))))
  (dk-apply! (clh-chain! (dk-fact! 'cps-converges-closed-ball c r)) r)
  (clh-lam-typ! h 'NN 'CC (lambda (k) (clh-cc-typ! (list '* (list c k) (list 'power r k)))))
  (clh-rr-typ! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< 1 r))))
  (clh-pos-rr! e)
  (let* ((N (dk-skolem! (dk-apply! (clh-chain! (dk-fact! 'cc-series-terms-small h)) e)))
         (sN (list 'succ N)) (P (list 'power -1 N)) (RC (list 'recip sN)) (RP (list 'power r sN))
         (cN (list c sN)) (hN (list h sN)) (x1 (list '- r 1)) (clh-le-b (list '+ 1 (list '* sN x1))))
    (clh-nn-typ! sN)
    (fact 'nn-le-succ N)
    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'magnitude) (dk-contains? f N))) "the small terms") sN)
    (clh-succ-nz! N)
    (clh-rr-typ! sN) (clh-rr-typ! RC) (clh-rr-typ! RP) (clh-rr-typ! x1)
    (fact 'rr-subset-cc RC) (fact 'rr-subset-cc RP)
    (clh-cc-typ! P) (clh-cc-typ! cN) (clh-cc-typ! hN)
    (fact 'nn-one-le-succ N)
    (dk-have! (list '< 0 sN) (lambda () (dk-ineq! (list '<= 1 sN))))
    (fact 'rr-recip-pos sN)
    (set! clh-le-inv (clh-chain! (dk-fact! 'rr-recip-inverse sN)))
    ;; |h(N+1)| = RC RP
    (clh-cc-typ! (list '* P RC)) (clh-cc-typ! (list '* (list '* P RC) RP))
    (dk-have! (list '= hN (list '* (list '* P RC) RP))
      (lambda ()
        (clh-beta!
          (lambda ()
            (subst (dk-apply! (dk-ctx-form '(FORALL clhj_ (IMPLIES (IN clhj_ NN) (= (clhc_ (succ clhj_)) (* (power -1 clhj_) (recip (succ clhj_))))))) N))
            (rfl)))))
    (clh-cc-typ! (list '* P RC)) (clh-cc-typ! (list '* (list '* P RC) RP))
    (clh-and! (list 'IN (list '* P RC) 'CC) (list 'IN RP 'CC))
    (fact 'cc-magnitude-mul (list '* P RC) RP)
    (clh-and! (list 'IN P 'CC) (list 'IN RC 'CC))
    (fact 'cc-magnitude-mul P RC)
    (fact 'cc-magnitude-power N -1)
    (fact 'rr-power-one N)
    (dk-have! '(= (magnitude -1) 1) (lambda () (arith)))
    (dk-have! (list '<= 0 RC) (lambda () (dk-ineq! (list '< 0 RC))))
    (fact 'rr-magnitude-is-abs RC) (clh-chain! (dk-fact! 'rr-abs-of-nonneg RC))
    (fact 'cc-magnitude-power sN r)
    (fact 'rr-magnitude-is-abs r) (clh-chain! (dk-fact! 'rr-abs-of-nonneg r))
    (clh-rr-typ! (list '* RC RP))
    (dk-have! (list '= (list 'magnitude hN) (list '* RC RP))
      (lambda ()
        (subst (list '= hN (list '* (list '* P RC) RP)))
        (subst (list '= (list 'magnitude (list '* (list '* P RC) RP)) (list '* (list 'magnitude (list '* P RC)) (list 'magnitude RP))))
        (subst (list '= (list 'magnitude (list '* P RC)) (list '* (list 'magnitude P) (list 'magnitude RC))))
        (subst (list '= (list 'magnitude P) (list 'power (list 'magnitude -1) N)))
        (subst '(= (magnitude -1) 1))
        (subst (list '= (list 'power 1 N) 1))
        (subst (list '= (list 'magnitude RC) (list 'abs RC)))
        (subst (list '= (list 'abs RC) RC))
        (subst (list '= (list 'magnitude RP) (list 'power (list 'magnitude r) sN)))
        (subst (list '= (list 'magnitude r) (list 'abs r)))
        (subst (list '= (list 'abs r) r))
        (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (* 1 clhu_) clhv_) (* clhu_ clhv_)) (list RC RP)))
        (rfl)))
    ;; Bernoulli: 1 + (N+1)(r - 1) <= r^(N+1), times 1/(N+1)
    (dk-have! (list '<= -1 x1) (lambda () (dk-ineq! (list '< 1 r))))
    (clh-chain! (dk-fact! 'rr-bernoulli x1 sN))
    (clh-cc-typ! (list '+ 1 x1))
    (clh-rr-typ! (list 'power (list '+ 1 x1) sN))
    (dk-have! (list '= (list '+ 1 x1) r) (lambda () (crs)))
    (dk-congr! (list '= (list '+ 1 x1) r) (lambda (u) (list 'power u sN)))
    (clh-rr-typ! clh-le-b)
    (dk-have! (list '<= clh-le-b RP)
      (lambda () (dk-ineq! (list '<= clh-le-b (list 'power (list '+ 1 x1) sN)) (list '= (list 'power (list '+ 1 x1) sN) RP))))
    (clh-and! (list '<= 0 RC) (list '<= clh-le-b RP))
    (clh-chain! (dk-fact! 'rr-le-scale-nonneg RC clh-le-b RP))
    (clh-rr-typ! (list '* RC clh-le-b))
    (dk-have! (list '= (list '* RC clh-le-b) (list '+ RC x1))
      (lambda ()
        (subst (clh-ring-id! '(clhu_ clhv_ clhq_) '(= (* clhu_ (+ 1 (* clhv_ clhq_))) (+ clhu_ (* (* clhv_ clhu_) clhq_))) (list RC sN x1)))
        (subst clh-le-inv)
        (subst (clh-ring-id! '(clhu_ clhq_) '(= (+ clhu_ (* 1 clhq_)) (+ clhu_ clhq_)) (list RC x1)))
        (rfl)))
    (clh-rr-typ! (list '+ RC x1)) (clh-rr-typ! (list 'magnitude hN))
    (dk-have! (list '<= (list '+ RC x1) (list '* RC RP))
      (lambda () (subst (list '= (list '+ RC x1) (list '* RC clh-le-b))) (ass)))
    (clh-absurd! (list '<= (list '+ RC x1) (list '* RC RP))
                 (list '= (list 'magnitude hN) (list '* RC RP)) (list '<= (list 'magnitude hN) e) (list '< 0 RC) (list '< 1 r))))
(qed 'cps-log-radius-le-one)
;;; sin > 0 on (0, pi): sin t = cos(t - pi/2) (cc-cos-add, cos even, sin odd)
(sp (make-wff (list 'FORALL 'clht_ (list 'IMPLIES '(IN clht_ RR) (list 'IMPLIES '(< 0 clht_)
  (list 'IMPLIES '(< clht_ PI) '(< 0 (CC-SIN clht_))))))))
(dk-peel!)
(clh-pi-typ!)
(fact 'rr-zero-in)
(let* ((t 'clht_) (mh (list '- clh-h)) (u (list '+ t mh)) (cu (list 'CC-COS u)) (st '(CC-SIN clht_)))
  (clh-rr-typ! clh-h) (clh-rr-typ! mh) (clh-rr-typ! u)
  (fact 'rr-subset-cc t) (fact 'rr-subset-cc clh-h) (fact 'rr-subset-cc mh) (fact 'rr-subset-cc u)
  (clh-rr-typ! cu) (clh-rr-typ! st) (clh-rr-typ! '(CC-COS clht_))
