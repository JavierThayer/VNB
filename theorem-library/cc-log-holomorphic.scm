;;; cc-log-holomorphic.scm -- THE SIGN OF cos ON [-pi/2, pi], pi > 3, AND THE
;;; HOLOMORPHY OF THE PRINCIPAL LOGARITHM ON THE SLIT PLANE C \ (-inf, 0];
;;; the two loose ends of Lemma 2.20 (the radius is exactly 1) and Remark 2.22
;;; (log(1 - z) = - sum z^k/k).
;;; Batch 38-B, 2026-09-27.  The source: scratchpad/triage/ca.txt 1480-1580 (the
;;; principal log, Lemma 2.20, Prop 2.21, the paragraph "log is holomorphic on
;;; C \ (-inf, 0]", Remark 2.22).  Definitions used: CC-LOG
;;; (structure-library/analytic-log.scm), PI (cc-pi.scm); no new definition.
;;;
;;; THE HEADLINES, in proof order.
;;;  (1) cos and sin on the real line
;;;   cc-cos-least-zero     0 < t < pi/2  ==>  cos t /= 0
;;;   cc-cos-pos-right      0 < t < pi/2  ==>  0 < cos t
;;;   cc-cos-pos-half       -pi/2 < t < pi/2  ==>  0 < cos t
;;;   cc-cos-nonpos-far     pi/2 <= t <= pi  ==>  cos t <= 0
;;;   cc-sin-pos-half       0 < t < pi  ==>  0 < sin t
;;;  (2) bounds on pi
;;;   cc-cos-pos-small      0 < t < 1  ==>  0 < cos t
;;;   cc-pi-gt-two          2 < pi
;;;   cc-cos-three-halves-pos   0 < cos(3/2)
;;;   cc-pi-gt-three        3 < pi
;;;  (3) the logarithm on the slit plane
;;;   cc-log-right-half     0 < Re w  ==>  -pi/2 < Im log w < pi/2
;;;   cc-log-mul            log(u v) = log u + log v when Im log u + Im log v
;;;                         lies in (-pi, pi)
;;;   cc-log-rotate         0 < Re w  ==>  log(i w) = log w + i pi/2
;;;   cc-log-rotate-neg     0 < Re w  ==>  log(-i w) = log w - i pi/2
;;;   cc-log-im-near-one    D > 0, r (1 + pi) <= pi, r (1 + D) <= D: on B(1, r)
;;;                         the slit condition holds and |Im log z| < D
;;;   cc-log-holomorphic-at every a of the slit plane has a ball B(a, rho)
;;;                         inside the slit plane on which log is holomorphic
;;;   cc-log-holomorphic    HOLOMORPHIC-ON(slit plane, w |-> log w)
;;;   cc-log-deriv          log'(w) = 1/w on the slit plane
;;;  (4) Lemma 2.20, the radius
;;;   cc-series-terms-small the terms of a convergent complex series are
;;;                         eventually smaller than any eps > 0
;;;   cps-log-radius-le-one no real r > 1 lies below the radius
;;;   cps-log-radius-one    CPS-RADIUS(c) = 1 for the logarithmic coefficients
;;;  (5) Remark 2.22
;;;   cc-log-one-minus      |z| < r, r (1 + pi) <= pi: log(1 - z) = - sum z^k/k
;;;
;;; THE ROUTES.
;;;  * A zero t0 of cos in (0, pi/2) gives sin t0 = +-1, exp(i t0) = +-i and
;;;    exp(4 i t0) = 1 with 0 < 4 t0 < 2 pi, against Lemma 2.18 (the mechanism
;;;    of cc-pi-lt-four).  Positivity by the intermediate value theorem for
;;;    -cos on [0, t]; cos t = -cos(pi - t) gives the sign on [pi/2, pi].
;;;  * pi > 3 needs no bound on cos over an interval: cos(3/2) > 0 at the one
;;;    point (the exponential series at 3i/2 to six terms, tail 81/2560), and
;;;    cos <= 0 on [pi/2, pi] with pi > 2 (cos t >= 1 - t^2 on (0, 1),
;;;    cc-exp-near-one) forces pi/2 > 3/2.
;;;  * THE HOLOMORPHY OF log DOES NOT USE THE SECTOR COVER THE BRIEF SKETCHED.
;;;    At a point a of the slit plane put D = pi - |Im log a| > 0 and
;;;    r = D / (2 (1 + pi)); then r (1 + pi) = D/2 <= pi and r (1 + D) <= D.
;;;    For x in B(a, |a| r), u = x/a lies in B(1, r), where |Im log u| < D
;;;    (cc-log-im-near-one: |Im log u| <= |log0(u - 1)| <= t/(1 - t) < D), so
;;;    Im(log a + log u) stays in (-pi, pi) and log x = log a + log(x/a)
;;;    (cc-log-char).  The right side is holomorphic on B(a, |a| r)
;;;    (cc-log-holomorphic-near-one of batch 38, holomorphic-compose with
;;;    x |-> x/a, holomorphic-sum with a constant).  Every point is reached in
;;;    one step, so neither pi > 2.42 nor the rotations are needed for it; they
;;;    are proven as the brief asks (cc-log-rotate, -neg).  The slit plane is
;;;    open (the same balls) and cc-diff-on-local turns the local holomorphy
;;;    into holomorphy on the whole slit plane.
;;;  * log'(w) = 1/w: exp o log is the identity on the slit plane; the chain
;;;    rule (diff-on-chain, cc-exp-deriv), diff-on-identity, cc-diff-on-local
;;;    and diff-on-unique give exp(log w) l = 1.
;;;  * The radius: at a real r > 1 inside the radius the series would converge,
;;;    so its terms would eventually be below (r - 1)/2; but |c(n) r^n| =
;;;    r^n / n >= 1/n + (r - 1) by Bernoulli (rr-bernoulli).  With batch 38's
;;;    cps-log-radius and CPS-RADIUS in [0, inf] this is CPS-RADIUS(c) = 1.
;;;  * Remark 2.22: cc-log-one-plus at -z, (-z)^k = (-1)^k z^k
;;;    (cc-power-mul-base), (-1)^k (-1)^k = 1, cc-series-limit-linear.
;;;
;;; NOTHING asserted: no support, stamp or axiom.  Helper prefix clh-; theorem
;;; binders clh..._ (and the binders of cited theorems where an instance must
;;; match: cek_, cekv_, cpsk_, cpdj_, algj_, algz_, cxsu_, d2x_, d2y_, hbx_, cexx_,
;;; cexy_).  The driver helpers copied from analytic-log-laws.scm and
;;; cc-exp-kernel.scm (a helper is local to its file) carry the prefix clh-.
;;; LOAD WINDOW: lo = theorem-library/analytic-log-laws (cc-log-spec,
;;; cc-log-char, cc-log-in-slit, cc-exp-log, log0-is-log-on-ball, log0-bound,
;;; cc-log-holomorphic-near-one, cc-log-one-plus, holomorphic-compose,
;;; cps-log-radius); also cc-exp-surjective (cc-exp-open-strip-avoids-negatives),
;;; cc-exp-kernel, cc-exp, the holomorphic-on and diff-on laws.  hi: none.
;;; Oracles: crs, ineq, arith (sos through citations).  Tactics: none of the
;;; late ones (no contra, prep, ineq-supply).
(define (clh-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (clh-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (clh-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((eqv? t 1) (fact 'nn-one-in) typ)
          ((and (exact-nonnegative-integer? t)) (dk-have! typ (lambda () (arith))) typ)
          ((clh-op? t 'succ 2) (clh-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          ((or (clh-op? t '+ 3) (clh-op? t '* 3))
           (clh-nn-typ! (cadr t)) (clh-nn-typ! (caddr t))
           (clh-and! (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN))
           (fact (if (eq? (car t) '+) 'nn-add-closed 'nn-mul-closed) (cadr t) (caddr t)) typ)
          (#t (error "clh-nn-typ!: cannot type" (expression->string t))))))
(define (clh-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((and (number? t) (exact-rational? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (pair? t) (clh-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((clh-op? t 'FACTORIAL 2)
           (clh-nn-typ! (cadr t))
           (dk-split-all! (list (dk-fact! 'factorial-real-pos (cadr t)))) typ)
          ((or (clh-op? t 'succ 2) (and (clh-op? t '+ 3) (dk-asm? (list 'IN (cadr t) 'NN))
                                         (dk-asm? (list 'IN (caddr t) 'NN))))
           (clh-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((and (clh-op? t 'recip 2) (clh-op? (cadr t) 'FACTORIAL 2))
           (clh-nn-typ! (cadr (cadr t))) (fact 'recip-factorial-in-rr (cadr (cadr t))) typ)
          ((clh-op? t 'recip 2)
           (clh-rr-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "clh-rr-typ!: recip of a term not known nonzero" (expression->string t)))
           (clh-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t)) typ)
          ((clh-op? t '* 3) (clh-rr-typ! (cadr t)) (clh-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((clh-op? t '+ 3) (clh-rr-typ! (cadr t)) (clh-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((clh-op? t '- 3) (clh-rr-typ! (cadr t)) (clh-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((clh-op? t '- 2) (clh-rr-typ! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((clh-op? t 'real-part 2) (clh-cc-typ! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((clh-op? t 'imag-part 2) (clh-cc-typ! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((clh-op? t 'power 3) (clh-rr-typ! (cadr t)) (clh-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((clh-op? t 'magnitude 2) (clh-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((clh-op? t 'abs 2) (clh-rr-typ! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((clh-op? t 'LOG 2) (clh-rr-typ! (cadr t)) (fact 'log-in-rr (cadr t)) typ)
          ((clh-op? t 'R-EXP 2) (clh-rr-typ! (cadr t)) (fact 'r-exp-in-rr (cadr t)) typ)
          ((clh-op? t 'RECIP-STAR 2) (clh-rr-typ! (cadr t)) (fact 'recip-star-in-rr (cadr t)) typ)
          ((clh-op? t 'CC-EXP 2) (clh-exp-rr! (cadr t)) typ)
          ((or (clh-op? t 'CC-COS 2) (clh-op? t 'CC-SIN 2))
           (clh-rr-typ! (cadr t)) (dk-split-all! (list (dk-cite! 'cc-cos-sin-real (cadr t)))) typ)
          ((eq? t 'PI) (clh-pi-typ!) typ)
          (#t (error "clh-rr-typ!: cannot type" (expression->string t))))))
(define (clh-real? t)
  (or (and (number? t) (exact-rational? t))
      (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
      (clh-op? t 'succ 2) (clh-op? t 'FACTORIAL 2) (clh-op? t 'magnitude 2) (clh-op? t 'abs 2) (clh-op? t 'real-part 2) (clh-op? t 'imag-part 2)
      (and (clh-op? t 'recip 2) (clh-op? (cadr t) 'FACTORIAL 2))
      (and (memq (dk-head t) '(* + -)) (= (length t) 3) (clh-real? (cadr t)) (clh-real? (caddr t)))
      (and (clh-op? t 'power 3) (clh-real? (cadr t)))))
;;; a ground numeric term (numbers under + - * recip): typed by arith
(define (clh-ground? t)
  (or (number? t)
      (and (pair? t) (memq (car t) '(+ - * recip)) (every clh-ground? (cdr t)))))
;;; D when (IN F (FUN D CC)) is in context
(define (clh-fun-dom f)
  (let ((hit (find-first (lambda (a) (and (clh-op? a 'IN 3) (equal? (cadr a) f)
                                          (clh-op? (caddr a) 'FUN 3) (eq? (caddr (caddr a)) 'CC)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
(define (clh-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((and (pair? t) (clh-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (number? t) (exact-rational? t)) (clh-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((clh-real? t) (clh-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
           (clh-nn-typ! (cadr t)) (fact 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) typ)
          ((and (pair? t) (= (length t) 2) (clh-fun-dom (car t)))
           (let ((dom (clh-fun-dom (car t))))
             (if (eq? dom 'NN) (clh-nn-typ! (cadr t)))
             (if (eq? dom 'CC) (clh-cc-typ! (cadr t)))
             (fact 'fun-apply-type-c (car t) dom 'CC (cadr t)) typ))
          ((clh-op? t 'CC-EXP 2) (clh-exp-typ! (cadr t)) typ)
          ((clh-op? t 'CC-COS 2) (clh-cos-typ! (cadr t)) typ)
          ((clh-op? t 'CC-SIN 2) (clh-sin-typ! (cadr t)) typ)
          ((and (clh-op? t 'CC-SERIES-PARTIAL-SUM 3) (dk-asm? (list 'IN (cadr t) '(FUN NN CC))))
           (clh-nn-typ! (caddr t)) (fact 'cc-series-partial-sum-in-cc (caddr t) (cadr t)) typ)
          ((and (clh-op? t 'CC-SERIES-LIMIT 2) (dk-asm? (list 'CC-SERIES-CONVERGES (cadr t))))
           (fact 'cc-series-limit-in-cc (cadr t)) typ)
          ((clh-op? t '* 3) (clh-cc-typ! (cadr t)) (clh-cc-typ! (caddr t))
           (clh-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((clh-op? t '+ 3) (clh-cc-typ! (cadr t)) (clh-cc-typ! (caddr t))
           (clh-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((clh-op? t '- 3) (clh-cc-typ! (cadr t)) (clh-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((clh-op? t '- 2) (clh-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((clh-op? t 'conjugate 2) (clh-cc-typ! (cadr t)) (fact 'cc-conjugate-closed (cadr t)) typ)
          ((clh-op? t 'power 3) (clh-cc-typ! (cadr t)) (clh-nn-typ! (caddr t))
           (clh-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((clh-op? t 'recip 2)
           (clh-cc-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "clh-cc-typ!: recip of a term not known nonzero" (expression->string t)))
           (clh-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "clh-cc-typ!: cannot type" (expression->string t))))))

;;; (IN LAM (FUN NN COD)) for LAM = (VNB-LAMBDA v NN body): TYPER gets the
;;; eigenvariable and must land the body's typing.
;;; (IN LAM (FUN DOM COD)) for LAM = (VNB-LAMBDA v DOM body): TYPER gets the
;;; eigenvariable and must land the body's typing (dk-lam-type!, not dk-lam-t!).
(define (clh-lam-typ! lam dom cod typer)
  (let ((typ (list 'IN lam (list 'FUN dom cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (typer j)
                  (if (not (sequent-node-grounded? leaf)) (ass))))))))
    typ))

;;; beta-reduce the focus goal; the reduct is a NEW node that becomes the focus
;;; while the worked leaf stays open, unless beta grounded it: run CLOSER then.
(define (clh-beta! closer)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (closer))))

;;; A commutative-ring identity with opaque atoms: prove BODY over fresh complex
;;; variables VARS by crs on a lane, then instantiate it at TERMS (typed in CC
;;; first); returns the landed instance.
(define (clh-ring-id! vars body terms)
  (let ((gen (let build ((vs vars))
               (if (null? vs) body
                   (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) (build (cdr vs))))))))
    (if (not (dk-asm? gen)) (dk-have! gen (lambda () (dk-peel!) (crs))))
    (for-each clh-cc-typ! terms)
    (apply dk-apply! (dk-ctx-form gen) terms)))

;;; detach an implication chain: an antecedent in context by detach!, one not in
;;; context (a conjunction of context facts) by detach-with!
(define (clh-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

;;; POS-RR c from (IN c RR) and (< 0 c) in context
(define (clh-pos-rr! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (dk-have! (list 'POS-RR c)
        (lambda ()
          (mac-h '< (dk-ctx-form (list '< 0 c)))
          (dk-split-all!)
          (mac 'pos-rr)
          (dk-conj-close! (lambda () (ass)))))))

;;; close the focus goal from a contradiction (< 0 0) proved by dk-ineq! from PREMS
(define (clh-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

(define (clh-ind! base-k step-k)
  (let* ((br (use-induction))
         (v (cdr (assq 'var br)))
         (ih (cdr (assq 'ih br)))
         (step (cdr (assq 'step br))))
    (dk-focus! (cdr (assq 'base br)))
    (base-k)
    (dk-focus! step)
    (step-k v ih)))
(define (clh-pw! z k)                    ; z^(succ k) = z z^k, rewritten in the goal
  (clh-cc-typ! z) (clh-nn-typ! k)
  (clh-and! (list 'IN z 'CC) (list 'IN k 'NN))
  (subst (dk-fact! 'power-succ z k)))

(define (clh-exp-typ! z)
  (clh-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC)))
      (dk-split-all! (list (dk-fact! 'cc-exp-converges z)))))

(define (clh-cos-typ! z)
  (clh-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-COS z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-cos-converges z)))))
(define (clh-sin-typ! z)
  (clh-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-SIN z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-sin-converges z)))))
(define (clh-conj-typ! z) (clh-cc-typ! (list 'conjugate z)))
(define (clh-pow2! x)                    ; (= (power x 2) (* x x)) in context
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (clh-cc-typ! x)
            (fact 'nn-two-is-succ-succ-zero)
            (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in)
            (clh-nn-typ! '(succ 0))
            (clh-pw! x '(succ 0))
            (clh-pw! x 0)
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (clh-land-var landed dom)
  (let ((hit (find-first (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) dom))) landed)))
    (if hit (cadr hit) (error "clh-land-var: no typing landed in" dom))))
(define (clh-exp-rr! t)                 ; (IN (CC-EXP t) RR) and (IN (CC-EXP t) CC), t typed in RR
  (clh-rr-typ! t) (fact 'rr-subset-cc t)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP t) 'RR))) (fact 'cc-exp-real-valued t))
  (clh-exp-typ! t))
(define (clh-leq-total! a b)
  (clh-rr-typ! a) (clh-rr-typ! b)
  (clh-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (dk-fact! 'rr-leq-total a b))
(define (clh-pi-typ!)
  (if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
  (fact 'rr-subset-cc 'PI))
(define (clh-im-eq! x y)
  (let ((e (list '= (list 'imag-part x) y)) (yi (list '* y +i)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (clh-rr-typ! y) (fact 'rr-subset-cc y) (clh-cc-typ! x) (clh-cc-typ! yi)
            (if (not (equal? x yi))
                (begin
                  (dk-have! (list '= x yi) (lambda () (crs)))
                  (subst (list '= x yi))))
            (subst (dk-fact! 'cc-im-real-mul y +i))
            (dk-have! (list '= (list 'imag-part +i) 1) (lambda () (arith)))
            (subst (list '= (list 'imag-part +i) 1))
            (crs))))
    e))

;;; (= (imag-part X) 0) for a real X (cc-re-im-of: X = X + 0 i)
(define (clh-im-real! x)
  (let ((e (list '= (list 'imag-part x) 0)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (clh-rr-typ! x) (fact 'rr-subset-cc x) (fact 'rr-zero-in)
            (clh-cc-typ! (list '+ x (list '* 0 +i)))
            (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
            (dk-split-all! (list (clh-chain! (dk-fact! 'cc-re-im-of x x 0))))
            (ass))))
    e))
;;; the slit-plane condition and the open strip, as cc-exp-open-strip-onto spells them
(define (clh-slit w) (list 'NOT (list 'AND (list '= (list 'imag-part w) 0) (list '<= (list 'real-part w) 0))))
(define (clh-lo z) (list '< '(- PI) (list 'imag-part z)))
(define (clh-hi z) (list '< (list 'imag-part z) 'PI))

;;; run THUNK on the focus leaf; run CLOSER only if that leaf is still open
;;; (a dk-have! of a claim equal to the focus goal proves it in place)
(define (clh-guard! thunk closer)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (closer))))
(define (clh-kop-find e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 3) (member (car e) '((ADD CC-NORMED-FIELD) (MUL CC-NORMED-FIELD)))
              (not (clh-kop-find (cadr e))) (not (clh-kop-find (caddr e))))
         e)
        ((and (= (length e) 2) (equal? (car e) '(NEG CC-NORMED-FIELD)) (not (clh-kop-find (cadr e))))
         e)
        (#t (let loop ((xs e)) (cond ((null? xs) #f) ((clh-kop-find (car xs))) (#t (loop (cdr xs))))))))
(define (clh-kops!)
  (let loop ()
    (let ((k (clh-kop-find (dk-goal))))
      (if k
          (begin
            (cond ((equal? (car k) '(NEG CC-NORMED-FIELD))
                   (clh-cc-typ! (cadr k))
                   (fact 'cc-nf-neg-apply (cadr k))
                   (subst (list '== k (list '- (cadr k)))))
                  (#t
                   (clh-cc-typ! (cadr k)) (clh-cc-typ! (caddr k))
                   (let ((add? (equal? (car k) '(ADD CC-NORMED-FIELD))))
                     (fact (if add? 'cc-nf-add-apply 'cc-nf-mul-apply) (cadr k) (caddr k))
                     (subst (list '== k (list (if add? '+ '*) (cadr k) (caddr k)))))))
            (loop))))))

;;; ======================================================================
;;; (1) THE TRANSLATION TO A CENTRE.  The tree's power-series machinery (2.10,
;;; 2.14: cps-holomorphic-ball, cps-diff-on-ball, cps-taylor-coefficients,
;;; taylor-coefficients) is CENTRED AT 0: F_g on B(0, r).  Here the series
;;; centred at a, G_g(z) = sum g(k) (z - a)^k on B(a, r), is F_g composed with
;;; the shift z |-> z - a (diff-on-chain, the shift's derivative being 1), and
;;; the k-th derivatives follow by induction as in cps-nth-deriv.
;;; ======================================================================
(define clh-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
;;; ---- partial sums of the exponential series (copied from cc-exp-kernel.scm, prefix cek- -> clh-) ----
;;; the binder cek_ is the one cc-exp-tail's instance carries, so the terms match
(define (clh-el z) (list 'VNB-LAMBDA 'cek_ 'NN (list '* '(recip (FACTORIAL cek_)) (list 'power z 'cek_))))
(define (clh-el-term z k) (list '* (list 'recip (list 'FACTORIAL k)) (list 'power z k)))
(define (clh-fact-val! k)
  (let ((e (list '= (list 'recip (list 'FACTORIAL k)) (/ 1 (let f ((n k)) (if (= n 0) 1 (* n (f (- n 1)))))))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (let loop ((n k)) (if (> n 0) (begin (mac 'factorial-succ) (loop (- n 1)))))
            (mac 'factorial-zero)
            (arith))))
    e))
(define (clh-psum-val! z n val finish)
  (let* ((el (clh-el z)) (e (list '= (list 'CC-SERIES-PARTIAL-SUM el n) val)))
    (if (not (dk-asm? e))
        (begin
          (clh-cc-typ! z)
          (clh-lam-typ! el 'NN 'CC (lambda (k) (clh-cc-typ! (clh-el-term z k))))
          (let loop ((k 0))
            (if (< k n)
                (begin
                  (clh-nn-typ! k)
                  (fact 'cc-series-partial-sum-in-cc k el)
                  (fact 'fun-apply-type-c el 'NN 'CC k)
                  (clh-fact-val! k)
                  (loop (+ k 1)))))
          (dk-have! e
            (lambda ()
              (let loop ((k n)) (if (> k 0) (begin (mac 'cc-series-partial-sum-succ) (loop (- k 1)))))
              (mac 'cc-series-partial-sum-zero)
              (dk-lam-b!)
              (let loop ((k 0)) (if (< k n) (begin (subst (clh-fact-val! k)) (loop (+ k 1)))))
              (finish)))))
    e))
;;; the iff of Lemma 2.18 at z, as two landed implications; returns (FWD . BWD)
(define (clh-one-iff! z)
  (clh-cc-typ! z)
  (let* ((i (dk-apply! (dk-fact! 'cc-exp-one-iff) z))
         (ims (dk-landed (lambda () (ai i)))))
    (cons (find-first (lambda (f) (dk-head-is? (cadr f) '=)) ims)
          (find-first (lambda (f) (dk-head-is? (cadr f) 'FORSOME)) ims))))
(define clh-2pii '(* (* 2 PI) +i))
(define clh-h '(* 1/2 PI))
(define clh-ncos '(VNB-LAMBDA cekv_ RR (* -1 (CC-COS cekv_))))
;;; (NOT (= B A)) from (NOT (= A B)) in context
(define (clh-ne-sym! a b)
  (let ((f (list 'NOT (list '= b a))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (di)
            (dk-have! (list '= a b) (lambda () (subst (list '= b a)) (rfl)))
            (ai (list 'NOT (list '= a b))))))
    f))
;;; (= X Y) from (<= X Y) and (<= Y X), both typed in RR
(define (clh-antisym! x y)
  (clh-and! (list 'IN x 'RR) (list 'IN y 'RR))
  (clh-and! (list '<= x y) (list '<= y x))
  (fact 'rr-leq-antisymmetric x y))
;;; (= (real-part X) X) for a real X
(define (clh-re-real! x)
  (let ((e (list '= (list 'real-part x) x)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (clh-rr-typ! x) (fact 'rr-subset-cc x) (fact 'rr-zero-in)
            (clh-cc-typ! (list '+ x (list '* 0 +i)))
            (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
            (dk-split-all! (list (clh-chain! (dk-fact! 'cc-re-im-of x x 0))))
            (ass))))
    e))
;;; (< 0 (real-part V)) from (< (magnitude (- V C)) D), C real, (<= D C)
(define (clh-re-pos! v c d)
  (let ((goal (list '< 0 (list 'real-part v))) (vc (list '- v c)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (clh-rr-typ! c) (fact 'rr-subset-cc c)
            (clh-cc-typ! vc)
            (clh-rr-typ! (list 'real-part vc)) (clh-rr-typ! (list 'real-part v)) (clh-rr-typ! (list 'magnitude vc))
            (fact 'cc-abs-re-le-magnitude vc)
            (dk-split-all! (list (clh-chain! (dk-fact! 'rr-abs-le-parts (list 'real-part vc) (list 'magnitude vc)))))
            (clh-and! (list 'IN v 'CC) (list 'IN c 'CC))
            (fact 'cc-re-sub v c)
            (clh-re-real! c)
            (clh-rr-typ! (list 'real-part c))
            (dk-ineq! (list '<= (list '- (list 'magnitude vc)) (list 'real-part vc))
                      (list '= (list 'real-part vc) (list '- (list 'real-part v) (list 'real-part c)))
                      (list '= (list 'real-part c) c)
                      (list '< (list 'magnitude vc) d)
                      (list '<= d c)))))
    goal))
;;; the slit-plane condition from a positive real part
(define (clh-slit-re! v)
  (let ((f (clh-slit v)))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (clh-rr-typ! (list 'real-part v))
            (di)
            (dk-split-all!)
            (dk-absurd! (list '<= (list 'real-part v) 0) (list '< 0 (list 'real-part v))))))
    f))


;;; ---- metric-space and ball helpers (after analytic-log-laws.scm's alg-, with the radius a parameter) ----
(define (clh-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (clh-ms-setup!)
  (fact 'cc-is-metric-space)
  (fact 'cc-is-normed-field)
  (fact 'cc-zero-in)
  (clh-pts-cc!))
(define (clh-B c rad) (list 'BALL 'CC-MS c rad))
(define (clh-pts! c)
  (let ((f (list 'IN c '(PTS CC-MS))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
    f))
;;; (<= 0 rad), (NOT (= 0 rad)) from (IN rad RR), (< 0 rad)
(define (clh-rad-facts! rad)
  (if (not (dk-asm? (list '<= 0 rad))) (dk-have! (list '<= 0 rad) (lambda () (dk-ineq! (list '< 0 rad)))))
  (if (not (dk-asm? (list 'NOT (list '= 0 rad))))
      (dk-have! (list 'NOT (list '= 0 rad)) (lambda () (di) (clh-absurd! (list '= 0 rad) (list '< 0 rad))))))
;;; B(c, rad) open in CC-MS and in the metric of the normed field
(define (clh-ball-open! c rad)
  (let ((b (clh-B c rad)))
    (clh-pts! c)
    (clh-rad-facts! rad)
    (if (not (dk-asm? (list 'IN b 'SET))) (fact 'ball-is-set 'CC-MS c rad))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS b)))
        (clh-chain! (dk-fact! 'ball-is-open 'CC-MS c rad)))
    (if (not (dk-asm? (list 'IS-OPEN clh-nfm b)))
        (dk-have! (list 'IS-OPEN clh-nfm b) (lambda () (mac 'cc-ms-open-iff) (ass))))))
(define (clh-center-in! c rad)
  (if (not (dk-asm? (list 'IN c (clh-B c rad))))
      (begin (clh-pts! c) (clh-rad-facts! rad) (clh-chain! (dk-fact! 'ball-center-in 'CC-MS c rad)))))
(define (clh-ball-cc! x c rad)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (begin
        (fact 'ball-membership 'CC-MS c rad x)
        (let ((iff (iff-for (list 'IN x (clh-B c rad)))))
          (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (if (dk-only! iff (list 'IN x (clh-B c rad))) (prop))))
          (dk-have! (list 'IN x 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))))))
;;; |x - c| < rad, for x in B(c, rad), c in CC
(define (clh-ball-lt! x c rad)
  (let ((goal (list '< (list 'magnitude (list '- x c)) rad))
        (d (list (list 'DIST 'CC-MS) c x)))
    (if (not (dk-asm? goal))
        (begin
          (clh-ball-cc! x c rad)
          (fact 'ball-membership 'CC-MS c rad x)
          (let ((iff (iff-for (list 'IN x (clh-B c rad)))))
            (dk-have! (list '< d rad)
              (lambda ()
                (mac '<)
                (dk-conj-close! (lambda () (if (dk-only! iff (list 'IN x (clh-B c rad))) (prop)))))))
          (clh-cc-typ! (list '- x c)) (clh-cc-typ! (list '- c x))
          (clh-rr-typ! (list 'magnitude (list '- x c)))
          (fact 'cc-ms-dist c x)
          (dk-have! goal
            (lambda ()
              (dk-have! (list '= (list 'magnitude (list '- x c)) (list 'magnitude (list '- c x)))
                (lambda ()
                  (dk-have! (list '= (list '- x c) (list '- (list '- c x))) (lambda () (crs)))
                  (subst (list '= (list '- x c) (list '- (list '- c x))))
                  (subst (dk-fact! 'cc-magnitude-neg (list '- c x)))
                  (clh-rr-typ! (list 'magnitude (list '- c x)))
                  (rfl)))
              (subst (list '= (list 'magnitude (list '- x c)) (list 'magnitude (list '- c x))))
              (subst (list '= (list 'magnitude (list '- c x)) d))
              (ass)))))
    goal))
;;; x in B(c, rad) from |x - c| < rad (x, c in CC)
(define (clh-ball-in! x c rad)
  (let ((goal (list 'IN x (clh-B c rad))))
    (if (not (dk-asm? goal))
        (begin
          (clh-pts! c) (clh-pts! x)
          (clh-cc-typ! (list '- c x)) (clh-cc-typ! (list '- x c))
          (clh-rr-typ! (list 'magnitude (list '- x c)))
          (fact 'cc-ms-dist c x)
          (dk-have! (list '<= (list '(DIST CC-MS) c x) (list 'magnitude (list '- x c)))
            (lambda ()
              (subst (list '== (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
              (dk-have! (list '= (list '- c x) (list '- (list '- x c))) (lambda () (crs)))
              (subst (list '= (list '- c x) (list '- (list '- x c))))
              (subst (dk-fact! 'cc-magnitude-neg (list '- x c)))
              (dk-ineq!)))
          (clh-chain! (dk-fact! 'ball-mem-from-le 'CC-MS c x (list 'magnitude (list '- x c)) rad))))
    goal))
(define (clh-succ-nz! j)                 ; (NOT (= (succ j) 0)), j in NN
  (let ((f (list 'NOT (list '= (list 'succ j) 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (clh-rr-typ! (list 'succ j))
            (fact 'nn-one-le-succ j)
            (fact 'rr-zero-in)
            (di)
            (clh-absurd! (list '= (list 'succ j) 0) (list '<= 1 (list 'succ j))))))
    f))
;;; the logarithmic coefficients c(0) = 0, c(j+1) = (-1)^j/(j+1) as a function
;;; symbol (dk-abstract!), with the two value facts analytic-log-laws.scm's
;;; theorems take as hypotheses (binder algj_ as there)
(define clh-lv1 '(FORALL algj_ (IMPLIES (IN algj_ NN) (= (algc_ (succ algj_)) (* (power -1 algj_) (recip (succ algj_)))))))
(define clh-coef-ve #f)                 ; the value equation of the last clh-log-coefs!
(define (clh-log-coefs!)
  (let* ((body (lambda (v) (list '* (list '- (list 'power -1 v)) (list 'RECIP-STAR v))))
         (ab (dk-abstract! 'NN 'CC body
               (lambda (v)
                 (clh-rr-typ! (list 'RECIP-STAR v))
                 (fact 'rr-subset-cc (list 'RECIP-STAR v))
                 (clh-cc-typ! (body v))
                 (ass))))
         (c (car ab)) (ve (cdr ab)))
    (set! clh-coef-ve ve)
    (clh-cc-typ! -1)
    (dk-have! (list '= (list c 0) 0)
      (lambda ()
        (fact 'nn-zero-in)
        (clh-cc-typ! '(- (power -1 0)))
        (subst (dk-apply! ve 0))
        (subst (dk-fact! 'recip-star-zero))
        (subst (clh-ring-id! '(clhu_) '(= (* clhu_ 0) 0) (list '(- (power -1 0)))))
        (rfl)))
    (dk-have! (subst-free 'algc_ c clh-lv1)
      (lambda ()
        (let* ((j (dk-di-var!)) (sj (list 'succ j)) (a (list 'power -1 j)) (rj (list 'recip sj)))
          (clh-nn-typ! sj)
          (clh-succ-nz! j)
          (clh-rr-typ! sj) (clh-rr-typ! rj) (fact 'rr-subset-cc rj)
          (clh-cc-typ! a)
          (clh-and! (list 'IN -1 'CC) (list 'IN j 'NN))
          (subst (dk-apply! ve sj))
          (subst (dk-fact! 'power-succ -1 j))
          (subst (clh-chain! (dk-fact! 'recip-star-value sj)))
          (subst (clh-ring-id! '(clhu_ clhv_) '(= (* (- (* -1 clhu_)) clhv_) (* clhu_ clhv_)) (list a rj)))
          (rfl))))
    c))
(define (clh-S1c c x) (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list c 'cpsk_) (list 'power (list '- x 1) 'cpsk_)))))
;;; ======================================================================
;;; (1) cos HAS NO ZERO ON (0, pi/2), AND ITS SIGN ON [-pi/2, pi].
;;; A zero t0 gives sin t0 = +-1, exp(i t0) = +-i, exp(4 i t0) = 1: 4 t0 is a
;;; period in (0, 2 pi), impossible by Lemma 2.18 (the model: cc-pi-lt-four).
;;; ======================================================================
(sp (make-wff (list 'FORALL 'clht_ (list 'IMPLIES '(IN clht_ RR) (list 'IMPLIES '(< 0 clht_)
  (list 'IMPLIES (list '< 'clht_ clh-h) '(NOT (= (CC-COS clht_) 0))))))))
(dk-peel!)
(clh-pi-typ!)
(di)
(let* ((t0 'clht_) (c (list 'CC-COS t0)) (s (list 'CC-SIN t0)) (w (list '* +i t0)) (ww (list '+ w w)) (w4 (list '+ ww ww))
       (T (list '* 4 t0)) (iT (list '* +i T)))
  (fact 'rr-subset-cc t0)
  (dk-split-all! (list (dk-fact! 'cc-cos-sin-real t0)))
  (clh-cos-typ! t0) (clh-sin-typ! t0)
  (clh-rr-typ! T) (fact 'rr-subset-cc T)
  (clh-cc-typ! w) (clh-cc-typ! ww) (clh-cc-typ! w4) (clh-cc-typ! iT)
  (clh-exp-typ! w) (clh-exp-typ! ww) (clh-exp-typ! w4) (clh-exp-typ! iT)
  (fact 'cc-cos-sin-one t0)
  (clh-pow2! c) (clh-pow2! s)
  (dk-have! (list '= (list '* s s) 1)
    (lambda ()
      (subst (list '= 1 (list '+ (list 'power c 2) (list 'power s 2))))
      (subst (list '= (list 'power c 2) (list '* c c)))
      (subst (list '= (list 'power s 2) (list '* s s)))
      (subst (list '= c 0))
      (crs)))
  (dk-have! (list '= iT w4) (lambda () (crs)))
  (dk-congr! (list '= iT w4) (lambda (x) (list 'CC-EXP x)))
  (fact 'cc-exp-add ww ww)
  (clh-and! (list 'IN w 'CC) (list 'IN w 'CC))
  (fact 'cc-exp-add w w)
  (fact 'cc-exp-i t0)
  (dk-have! (list '= (list 'CC-EXP iT) 1)
    (lambda ()
      (subst (list '= (list 'CC-EXP iT) (list 'CC-EXP w4)))
      (subst (list '= (list 'CC-EXP w4) (list '* (list 'CC-EXP ww) (list 'CC-EXP ww))))
      (subst (list '= (list 'CC-EXP ww) (list '* (list 'CC-EXP w) (list 'CC-EXP w))))
      (subst (list '= (list 'CC-EXP w) (list '+ c (list '* +i s))))
      (subst (list '= c 0))
      (subst (clh-ring-id! '(clhu_) '(= (* (* (+ 0 (* +i clhu_)) (+ 0 (* +i clhu_))) (* (+ 0 (* +i clhu_)) (+ 0 (* +i clhu_))))
                                      (* (* clhu_ clhu_) (* clhu_ clhu_))) (list s)))
      (subst (list '= (list '* s s) 1))
      (arith)))
  (detach! (car (clh-one-iff! iT)))
  (let* ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the multiple")))
         (kp (list '* k 'PI)) (rhs (list '* k clh-2pii)))
    (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
    (clh-rr-typ! kp) (clh-cc-typ! rhs)
    (clh-rr-typ! (list 'imag-part iT)) (clh-rr-typ! (list 'imag-part rhs))
    (dk-congr! (list '= iT rhs) (lambda (x) (list 'imag-part x)))
    (clh-im-eq! iT T)
    (clh-im-eq! rhs (list '* 2 kp))
    (let ((prem (list (list '= (list 'imag-part iT) (list 'imag-part rhs)) (list '= (list 'imag-part iT) T)
                      (list '= (list 'imag-part rhs) (list '* 2 kp)) (list '< 0 t0) (list '< t0 clh-h) '(< 0 PI))))
      (fact 'rr-zero-in) (fact 'rr-one-in)
      (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
      (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
        (lambda ()
          (dk-have! (list '<= k 0) (lambda () (dk-ineq! (list '< k 0))))
          (fact 'rr-mul-le-right k 0 'PI)
          (apply clh-absurd! (list '<= kp '(* 0 PI)) prem))
        (lambda ()
          (dk-have! (list '= kp 0) (lambda () (subst (list '= k 0)) (crs)))
          (apply clh-absurd! (list '= kp 0) prem))
        (lambda ()
          (fact 'zz-discrete k)
          (fact 'rr-mul-le-right 1 k 'PI)
          (apply clh-absurd! (list '<= '(* 1 PI) kp) prem))))))
(qed 'cc-cos-least-zero)

;;; cos > 0 on (0, pi/2): a non-positive value would give a zero in (0, s] by
;;; the intermediate value theorem for -cos on [0, s] (as cc-cos-has-zero)
(sp (make-wff (list 'FORALL 'clhs_ (list 'IMPLIES '(IN clhs_ RR) (list 'IMPLIES '(< 0 clhs_)
  (list 'IMPLIES (list '< 'clhs_ clh-h) '(< 0 (CC-COS clhs_))))))))
(dk-peel!)
(clh-pi-typ!)
(fact 'rr-zero-in)
(fact 'rr-subset-cc 'clhs_)
(dk-split-all! (list (dk-fact! 'cc-cos-sin-real 'clhs_)))
(let ((cs '(CC-COS clhs_)) (s 'clhs_) (nc clh-ncos))
  (use-cases (clh-leq-total! cs 0)
    (lambda ()
      (dk-split-all! (list (dk-fact! 'cc-neg-cos-continuous-rr)))
      (dk-have! '(<= 0 clhs_) (lambda () (dk-ineq! '(< 0 clhs_))))
      (fact 'cc-cos-zero)
      (fact 'rr-subset-cc 0)
      (dk-split-all! (list (dk-fact! 'cc-cos-sin-real 0)))
      (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'CCINT 0 s)) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS nc 'x)))
        (lambda ()
          (let* ((ld (dk-peel!)) (x (cadr (car ld))))
            (mac-h 'ccint-membership (car ld))
            (dk-split-all!)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "continuity") x)
            (ass))))
      (let ((n0 (list nc 0)) (ns (list nc s)))
        (fact 'fun-apply-type-c nc 'RR 'RR 0)
        (fact 'fun-apply-type-c nc 'RR 'RR s)
        (clh-rr-typ! '(* -1 (CC-COS 0))) (clh-rr-typ! (list '* -1 cs))
        (dk-have! (list '= n0 '(* -1 (CC-COS 0))) (lambda () (clh-beta! (lambda () (rfl)))))
        (dk-have! (list '= ns (list '* -1 cs)) (lambda () (clh-beta! (lambda () (rfl)))))
        (dk-have! (list 'AND (list '<= n0 0) (list '<= 0 ns))
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (dk-ineq! (list '= n0 '(* -1 (CC-COS 0))) (list '= ns (list '* -1 cs)) '(= (CC-COS 0) 1) (list '<= cs 0)))))))
      (let* ((p (dk-skolem! (dk-fact! 'ivt nc 0 s 0)))
             (cp (list 'CC-COS p)) (np (list nc p)))
        (mac-h 'ccint-membership (list 'IN p (list 'CCINT 0 s)))
        (dk-split-all!)
        (fact 'fun-apply-type-c nc 'RR 'RR p)
        (fact 'rr-subset-cc p)
        (dk-split-all! (list (dk-fact! 'cc-cos-sin-real p)))
        (clh-rr-typ! (list '* -1 cp))
        (dk-have! (list '= np (list '* -1 cp)) (lambda () (clh-beta! (lambda () (rfl)))))
        (dk-have! (list '= cp 0)
          (lambda ()
            (dk-have! (list '<= cp 0) (lambda () (dk-ineq! (list '= np 0) (list '= np (list '* -1 cp)))))
            (dk-have! (list '<= 0 cp) (lambda () (dk-ineq! (list '= np 0) (list '= np (list '* -1 cp)))))
            (clh-antisym! cp 0)
            (ass)))
        (dk-have! (list 'NOT (list '= 0 p))
          (lambda ()
            (di)
            (dk-have! (list '= cp 1) (lambda () (subst (list '= p 0)) (ass)))
            (clh-absurd! (list '= cp 1) (list '= cp 0))))
        (clh-and! (list '<= 0 p) (list 'NOT (list '= 0 p)))
        (fact 'rr-le-ne-lt 0 p)
        (clh-rr-typ! clh-h)
        (dk-have! (list '< p clh-h) (lambda () (dk-ineq! (list '<= p s) (list '< s clh-h))))
        (clh-chain! (dk-fact! 'cc-cos-least-zero p))
        (ai (list 'NOT (list '= cp 0)))))
    (lambda ()
      (clh-chain! (dk-fact! 'cc-cos-least-zero 'clhs_))
      (clh-ne-sym! cs 0)
      (clh-and! (list '<= 0 cs) (list 'NOT (list '= 0 cs)))
      (clh-guard! (lambda () (fact 'rr-le-ne-lt 0 cs)) ass))))
(qed 'cc-cos-pos-right)

;;; cos > 0 on (-pi/2, pi/2): cos is even
(sp (make-wff (list 'FORALL 'clht_ (list 'IMPLIES '(IN clht_ RR) (list 'IMPLIES (list '< (list '- clh-h) 'clht_)
  (list 'IMPLIES (list '< 'clht_ clh-h) '(< 0 (CC-COS clht_))))))))
(dk-peel!)
(clh-pi-typ!)
(fact 'rr-zero-in)
(clh-rr-typ! clh-h)
(fact 'rr-subset-cc 'clht_)
(clh-rr-typ! '(CC-COS clht_))
(use-cases (dk-fact! 'rr-lt-trichotomy 'clht_ 0)
  (lambda ()
    (let ((mt '(- clht_)))
      (clh-rr-typ! mt)
      (dk-have! (list '< 0 mt) (lambda () (dk-ineq! '(< clht_ 0))))
      (dk-have! (list '< mt clh-h) (lambda () (dk-ineq! (list '< (list '- clh-h) 'clht_))))
      (clh-chain! (dk-fact! 'cc-cos-pos-right mt))
      (fact 'cc-cos-even 'clht_)
      (clh-rr-typ! (list 'CC-COS mt))
      (dk-ineq! (list '< 0 (list 'CC-COS mt)) (list '= (list 'CC-COS mt) '(CC-COS clht_)))))
  (lambda ()
    (fact 'cc-cos-zero)
    (subst '(= clht_ 0))
    (subst '(= (CC-COS 0) 1))
    (dk-ineq!))
  (lambda ()
    (clh-guard! (lambda () (clh-chain! (dk-fact! 'cc-cos-pos-right 'clht_))) ass)))
(qed 'cc-cos-pos-half)

;;; cos <= 0 on [pi/2, pi]: cos t = -cos(pi - t) (cc-cos-add at pi and -(pi - t))
(sp (make-wff (list 'FORALL 'clht_ (list 'IMPLIES '(IN clht_ RR) (list 'IMPLIES (list '<= clh-h 'clht_)
  (list 'IMPLIES '(<= clht_ PI) '(<= (CC-COS clht_) 0)))))))
(dk-peel!)
(clh-pi-typ!)
(fact 'rr-zero-in)
(clh-rr-typ! clh-h)
(let* ((u '(- PI clht_)) (mu (list '- u)) (cu (list 'CC-COS u)) (ct '(CC-COS clht_)))
  (clh-rr-typ! u) (fact 'rr-subset-cc u) (clh-cc-typ! mu)
  (fact 'rr-subset-cc 'clht_)
  (clh-rr-typ! ct) (clh-rr-typ! cu)
  (clh-sin-typ! mu) (clh-cos-typ! mu) (clh-cos-typ! 'PI) (clh-sin-typ! 'PI)
  (clh-and! '(IN PI CC) (list 'IN mu 'CC))
  (fact 'cc-cos-add 'PI mu)
  (fact 'cc-cos-even u)
  (dk-split-all! (list (dk-fact! 'cc-cos-sin-pi)))
  (clh-cc-typ! (list '+ 'PI mu))
  (dk-have! (list '= 'clht_ (list '+ 'PI mu)) (lambda () (crs)))
  (dk-congr! (list '= 'clht_ (list '+ 'PI mu)) (lambda (x) (list 'CC-COS x)))
  (dk-have! (list '= ct (list '- cu))
    (lambda ()
      (subst (list '= ct (list 'CC-COS (list '+ 'PI mu))))
      (subst (list '= (list 'CC-COS (list '+ 'PI mu))
                   (list '- (list '* '(CC-COS PI) (list 'CC-COS mu)) (list '* '(CC-SIN PI) (list 'CC-SIN mu)))))
      (subst (list '= (list 'CC-COS mu) cu))
      (subst '(= (CC-COS PI) -1))
      (subst '(= (CC-SIN PI) 0))
      (crs)))
  (dk-have! (list '<= 0 cu)
    (lambda ()
      (use-cases (dk-fact! 'rr-lt-trichotomy u clh-h)
        (lambda ()
          (dk-have! (list '< (list '- clh-h) u) (lambda () (dk-ineq! '(<= clht_ PI) '(< 0 PI))))
          (clh-chain! (dk-fact! 'cc-cos-pos-half u))
          (dk-ineq! (list '< 0 cu)))
        (lambda ()
          (clh-rr-typ! (list 'CC-COS clh-h))
          (dk-congr! (list '= u clh-h) (lambda (x) (list 'CC-COS x)))
          (fact 'cc-cos-half-pi)
          (dk-ineq! (list '= cu (list 'CC-COS clh-h)) (list '= (list 'CC-COS clh-h) 0)))
        (lambda ()
          (clh-absurd! (list '< clh-h u) (list '<= clh-h 'clht_))))))
  (dk-ineq! (list '= ct (list '- cu)) (list '<= 0 cu)))
(qed 'cc-cos-nonpos-far)

;;; ======================================================================
;;; (2) pi > 3.  cos t >= 1 - t^2 > 0 for 0 < t < 1 (cc-exp-near-one at i t)
;;; gives pi > 2; the exponential tail at m = 6 gives cos(3/2) >= 11/128 -
;;; 81/2560 > 0; with cos <= 0 on [pi/2, pi] and pi > 2, pi/2 > 3/2.
;;; ======================================================================
(sp (make-wff '(FORALL clht_ (IMPLIES (IN clht_ RR) (IMPLIES (< 0 clht_) (IMPLIES (< clht_ 1) (< 0 (CC-COS clht_))))))))
(dk-peel!)
(let* ((t 'clht_) (z (list '* +i t)) (e (list 'CC-EXP z)) (az (list 'magnitude z)) (w (list '+ 1 z))
       (tt (list '* t t)) (d (list '- (list 'real-part e) (list 'real-part w))))
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (fact 'rr-subset-cc t)
  (clh-cc-typ! z) (clh-exp-typ! z) (clh-cc-typ! w)
  (clh-rr-typ! az)
  (dk-have! (list '= az t)
    (lambda ()
      (clh-and! (list 'IN +i 'CC) (list 'IN t 'CC))
      (subst (dk-fact! 'cc-magnitude-mul +i t))
      (dk-have! '(= (magnitude +i) 1) (lambda () (arith)))
      (subst '(= (magnitude +i) 1))
      (subst (dk-fact! 'rr-magnitude-is-abs t))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
      (subst (clh-chain! (dk-fact! 'rr-abs-of-nonneg t)))
      (crs)))
  (dk-have! (list '<= az 1) (lambda () (dk-ineq! (list '= az t) (list '< t 1))))
  (clh-chain! (dk-fact! 'cc-exp-near-one z))
  (clh-pow2! t)
  (clh-rr-typ! tt)
  (clh-rr-typ! (list 'power az 2)) (clh-rr-typ! (list 'power t 2))
  (dk-congr! (list '= az t) (lambda (x) (list 'power x 2)))
  (clh-cc-typ! (list '- (list '- e 1) z)) (clh-cc-typ! (list '- e w))
  (clh-ring-id! '(clhu_ clhv_) '(= (- clhu_ (+ 1 clhv_)) (- (- clhu_ 1) clhv_)) (list e z))
  (dk-congr! (list '= (list '- e w) (list '- (list '- e 1) z)) (lambda (x) (list 'magnitude x)))
  (clh-rr-typ! (list 'magnitude (list '- e w))) (clh-rr-typ! (list 'magnitude (list '- (list '- e 1) z)))
  (dk-have! (list '= (list 'power az 2) tt)
    (lambda () (subst (list '= (list 'power az 2) (list 'power t 2))) (subst (list '= (list 'power t 2) tt)) (rfl)))
  (fact 'cc-re-dist-le e w)
  (clh-rr-typ! d) (clh-rr-typ! (list 'abs d))
  (dk-have! (list '<= (list 'abs d) tt)
    (lambda ()
      (dk-ineq! (list '<= (list 'abs d) (list 'magnitude (list '- e w)))
                (list '= (list 'magnitude (list '- e w)) (list 'magnitude (list '- (list '- e 1) z)))
                (list '<= (list 'magnitude (list '- (list '- e 1) z)) (list 'power az 2))
                (list '= (list 'power az 2) tt))))
  (dk-split-all! (list (clh-chain! (dk-fact! 'rr-abs-le-parts d tt))))
  (fact 'cc-cos-real-part t)
  (dk-split-all! (list (dk-fact! 'cc-cos-sin-real t)))
  (clh-cc-typ! (list '* t +i))
  (dk-have! (list '= w (list '+ 1 (list '* t +i))) (lambda () (crs)))
  (dk-split-all! (list (clh-chain! (dk-fact! 'cc-re-im-of w 1 t))))
  (clh-and! (list '< 0 t) (list '< t 1))
  (clh-chain! (dk-fact! 'rr-lt-scale-pos t t 1))
  (clh-rr-typ! (list '* t 1))
  (dk-ineq! (list '<= (list '- tt) d) (list '= '(CC-COS clht_) (list 'real-part e)) (list '= (list 'real-part w) 1)
            (list '< tt (list '* t 1)) (list '< t 1)))
(qed 'cc-cos-pos-small)

(sp (make-wff '(< 2 PI)))
(clh-pi-typ!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(clh-rr-typ! clh-h)
(fact 'cc-cos-half-pi)
(clh-rr-typ! (list 'CC-COS clh-h))
(dk-have! (list '< 0 clh-h) (lambda () (dk-ineq! '(< 0 PI))))
(use-cases (dk-fact! 'rr-lt-trichotomy clh-h 1)
  (lambda ()
    (clh-chain! (dk-fact! 'cc-cos-pos-small clh-h))
    (clh-absurd! (list '< 0 (list 'CC-COS clh-h)) (list '= (list 'CC-COS clh-h) 0)))
  (lambda ()
    (dk-split-all! (list (dk-fact! 'cc-cos-one-bounds)))
    (clh-rr-typ! '(CC-COS 1))
    (dk-congr! (list '= clh-h 1) (lambda (x) (list 'CC-COS x)))
    (clh-absurd! (list '= (list 'CC-COS clh-h) '(CC-COS 1)) (list '= (list 'CC-COS clh-h) 0) '(<= 5/12 (CC-COS 1))))
  (lambda () (dk-ineq! (list '< 1 clh-h))))
(qed 'cc-pi-gt-two)

;;; cos(3/2) > 0: the exponential series at 3i/2 to six terms, tail 2|z|^6/6!
(sp (make-wff '(< 0 (CC-COS 3/2))))
(let* ((z (list '* +i 3/2)) (w (list 'CC-EXP z)) (v (make-rectangular 11/128 1281/1280))
       (s6 (list 'CC-SERIES-PARTIAL-SUM (clh-el z) 6))
       (b (list '* 2 (list '* '(recip (FACTORIAL 6)) (list 'power (list 'magnitude z) 6))))
       (c '(CC-COS 3/2)))
  (clh-cc-typ! z)
  (clh-nn-typ! 6)
  (dk-have! (list '<= (list '* 2 (list 'magnitude z)) '(succ 6)) (lambda () (arith)))
  (dk-fact! 'cc-exp-tail z 6)
  (clh-psum-val! z 6 v (lambda () (arith)))
  (clh-exp-typ! z)
  (clh-cc-typ! s6)
  (dk-have! (list 'IN v 'CC) (lambda () (arith)))
  (clh-cc-typ! (list '- w v))
  (clh-rr-typ! (list 'magnitude (list '- w v)))
  (dk-have! (list '<= (list 'magnitude (list '- w v)) 81/2560)
    (lambda ()
      (subst (list '= v s6))
      (clh-rr-typ! '(recip (FACTORIAL 6)))
      (clh-rr-typ! (list 'magnitude z))
      (clh-rr-typ! (list 'power (list 'magnitude z) 6))
      (clh-rr-typ! b)
      (clh-rr-typ! (list 'magnitude (list '- w s6)))
      (dk-have! (list '= b 81/2560) (lambda () (subst (clh-fact-val! 6)) (arith)))
      (dk-have! (list '<= b 81/2560) (lambda () (subst (list '= b 81/2560)) (dk-ineq!)))
      (clh-rr-typ! 81/2560)
      (dk-le-trans! (list 'magnitude (list '- w s6)) b 81/2560)
      (ass)))
  (fact 'cc-re-dist-le w v)
  (dk-have! (list '= (list 'real-part v) 11/128) (lambda () (arith)))
  (clh-rr-typ! 3/2)
  (fact 'cc-cos-real-part 3/2)
  (dk-split-all! (list (dk-fact! 'cc-cos-sin-real 3/2)))
  (let ((d (list '- (list 'real-part w) (list 'real-part v))))
    (clh-rr-typ! d)
    (clh-rr-typ! (list 'abs d))
    (clh-rr-typ! 81/2560)
    (dk-le-trans! (list 'abs d) (list 'magnitude (list '- w v)) 81/2560)
    (dk-split-all! (list (dk-fact! 'rr-abs-le-parts d 81/2560)))
    (dk-ineq! (list '<= (list '- 81/2560) d) (list '= (list 'real-part v) 11/128) (list '= c (list 'real-part w)))))
(qed 'cc-cos-three-halves-pos)

(sp (make-wff '(< 3 PI)))
(clh-pi-typ!)
(fact 'rr-zero-in)
(fact 'cc-pi-gt-two)
(fact 'cc-cos-three-halves-pos)
(clh-rr-typ! 3/2)
(clh-rr-typ! '(CC-COS 3/2))
(clh-rr-typ! clh-h)
(define (clh-p3-far!)
  (dk-have! '(<= 3/2 PI) (lambda () (dk-ineq! '(< 2 PI))))
  (clh-chain! (dk-fact! 'cc-cos-nonpos-far 3/2))
  (clh-absurd! '(<= (CC-COS 3/2) 0) '(< 0 (CC-COS 3/2))))
(use-cases (dk-fact! 'rr-lt-trichotomy 3/2 clh-h)
  (lambda () (dk-ineq! (list '< 3/2 clh-h)))
  (lambda ()
    (dk-have! (list '<= clh-h 3/2) (lambda () (dk-ineq! (list '= 3/2 clh-h))))
    (clh-p3-far!))
  (lambda ()
    (dk-have! (list '<= clh-h 3/2) (lambda () (dk-ineq! (list '< clh-h 3/2))))
    (clh-p3-far!)))
(qed 'cc-pi-gt-three)
;;; ======================================================================
;;; (3a) THE RIGHT HALF PLANE: Re w > 0 forces |Im log w| < pi/2 (Re w =
;;; exp(Re log w) cos(Im log w), and cos <= 0 on [pi/2, pi) and, by evenness,
;;; on (-pi, -pi/2]); hence the rotations by +-i.  And the product law of the
;;; principal logarithm under the strip condition.
;;; ======================================================================
(sp (make-wff (list 'FORALL 'clhw_ (list 'IMPLIES '(IN clhw_ CC) (list 'IMPLIES '(< 0 (real-part clhw_))
  (list 'AND (list '< (list '- clh-h) '(imag-part (CC-LOG clhw_))) (list '< '(imag-part (CC-LOG clhw_)) clh-h)))))))
(dk-peel!)
(clh-pi-typ!)
(fact 'rr-zero-in)
(clh-rr-typ! clh-h)
(clh-slit-re! 'clhw_)
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec 'clhw_))))
(let* ((L '(CC-LOG clhw_)) (x (list 'real-part L)) (th (list 'imag-part L)) (ith (list '* +i th)) (xi (list '+ x ith))
       (E (list 'CC-EXP x)) (Ei (list 'CC-EXP ith)) (ct (list 'CC-COS th)) (rw '(real-part clhw_))
       (Rei (list 'real-part Ei)) (EL (list 'CC-EXP L)))
  (clh-rr-typ! x) (clh-rr-typ! th)
  (fact 'rr-subset-cc x) (fact 'rr-subset-cc th)
  (clh-cc-typ! ith) (clh-cc-typ! xi)
  (clh-exp-rr! x)
  (clh-exp-typ! ith) (clh-exp-typ! xi)
  (fact 'cc-re-im-decompose L)
  (dk-congr! (list '= L xi) (lambda (u) (list 'CC-EXP u)))
  (clh-and! (list 'IN x 'CC) (list 'IN ith 'CC))
  (fact 'cc-exp-add x ith)
  (fact 'cc-cos-real-part th)
  (dk-split-all! (list (dk-fact! 'cc-cos-sin-real th)))
  (fact 'cc-re-real-mul E Ei)
  (clh-cc-typ! (list '* E Ei))
  (clh-rr-typ! rw) (clh-rr-typ! Rei) (clh-rr-typ! (list 'real-part EL)) (clh-rr-typ! (list 'real-part (list 'CC-EXP xi)))
  (clh-rr-typ! (list 'real-part (list '* E Ei)))
  (clh-rr-typ! (list '* E ct)) (clh-rr-typ! (list '* E Rei))
  (dk-congr! (list '= EL 'clhw_) (lambda (u) (list 'real-part u)))
  (dk-congr! (list '= EL (list 'CC-EXP xi)) (lambda (u) (list 'real-part u)))
  (dk-congr! (list '= (list 'CC-EXP xi) (list '* E Ei)) (lambda (u) (list 'real-part u)))
  (dk-have! (list '= (list '* E ct) (list '* E Rei)) (lambda () (subst (list '= ct Rei)) (rfl)))
  (fact 'cc-exp-real-is-r-exp x)
  (fact 'r-exp-pos x)
  (clh-rr-typ! (list 'R-EXP x))
  (dk-have! (list '<= 0 E) (lambda () (dk-ineq! (list '= E (list 'R-EXP x)) (list '< 0 (list 'R-EXP x)))))
  (let* ((clh-rh-prem
    (list (list '= (list 'real-part EL) rw) (list '= (list 'real-part EL) (list 'real-part (list 'CC-EXP xi)))
          (list '= (list 'real-part (list 'CC-EXP xi)) (list 'real-part (list '* E Ei)))
          (list '= (list 'real-part (list '* E Ei)) (list '* E Rei))
          (list '= (list '* E ct) (list '* E Rei)) (list '< 0 rw)))
         (clh-rh-absurd! (lambda ()
    (clh-and! (list '<= 0 E) (list '<= ct 0))
    (clh-chain! (dk-fact! 'rr-le-scale-nonneg E ct 0))
    (clh-rr-typ! (list '* E 0))
    (dk-have! (list '= (list '* E 0) 0) (lambda () (subst (clh-ring-id! '(clhu_) '(= (* clhu_ 0) 0) (list E))) (rfl)))
    (apply clh-absurd! (list '<= (list '* E ct) (list '* E 0)) (list '= (list '* E 0) 0) clh-rh-prem))))
  (dk-conj-close!
    (lambda ()
      (if (equal? (caddr (dk-goal)) clh-h)
          ;; th < pi/2: else pi/2 <= th < pi and cos th <= 0
          (use-cases (dk-fact! 'rr-lt-trichotomy th clh-h)
            (lambda () (ass))
            (lambda ()
              (dk-have! (list '<= clh-h th) (lambda () (dk-ineq! (list '= th clh-h))))
              (dk-have! (list '<= th 'PI) (lambda () (dk-ineq! (list '< th 'PI))))
              (clh-chain! (dk-fact! 'cc-cos-nonpos-far th))
              (clh-rh-absurd!))
            (lambda ()
              (dk-have! (list '<= clh-h th) (lambda () (dk-ineq! (list '< clh-h th))))
              (dk-have! (list '<= th 'PI) (lambda () (dk-ineq! (list '< th 'PI))))
              (clh-chain! (dk-fact! 'cc-cos-nonpos-far th))
              (clh-rh-absurd!)))
          ;; -pi/2 < th: else pi/2 <= -th < pi and cos th = cos(-th) <= 0
          (let* ((mth (list '- th)) (cm (list 'CC-COS mth)))
            (clh-rr-typ! mth) (clh-rr-typ! cm) (clh-rr-typ! (list '- clh-h))
            (fact 'cc-cos-even th)
            (let ((clh-rh-neg! (lambda ()
              (dk-have! (list '<= mth 'PI) (lambda () (dk-ineq! (list '< '(- PI) th))))
              (clh-chain! (dk-fact! 'cc-cos-nonpos-far mth))
              (dk-have! (list '<= ct 0) (lambda () (dk-ineq! (list '<= cm 0) (list '= cm ct))))
              (clh-rh-absurd!))))
            (use-cases (dk-fact! 'rr-lt-trichotomy (list '- clh-h) th)
              (lambda () (ass))
              (lambda ()
                (dk-have! (list '<= clh-h mth) (lambda () (dk-ineq! (list '= (list '- clh-h) th))))
                (clh-rh-neg!))
              (lambda ()
                (dk-have! (list '<= clh-h mth) (lambda () (dk-ineq! (list '< th (list '- clh-h)))))
                (clh-rh-neg!))))))))))
(qed 'cc-log-right-half)

;;; the product law: log(u v) = log u + log v when Im log u + Im log v stays in (-pi, pi)
(sp (make-wff (list 'FORALL 'clhu_ (list 'IMPLIES '(IN clhu_ CC) (list 'IMPLIES (clh-slit 'clhu_)
  (list 'FORALL 'clhv_ (list 'IMPLIES '(IN clhv_ CC) (list 'IMPLIES (clh-slit 'clhv_)
    (list 'IMPLIES '(< (- PI) (+ (imag-part (CC-LOG clhu_)) (imag-part (CC-LOG clhv_))))
      (list 'IMPLIES '(< (+ (imag-part (CC-LOG clhu_)) (imag-part (CC-LOG clhv_))) PI)
        '(= (CC-LOG (* clhu_ clhv_)) (+ (CC-LOG clhu_) (CC-LOG clhv_)))))))))))))
(dk-peel!)
(clh-pi-typ!)
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec 'clhu_))))
(dk-split-all! (list (clh-chain! (dk-fact! 'cc-log-spec 'clhv_))))
(let* ((lu '(CC-LOG clhu_)) (lv '(CC-LOG clhv_)) (z (list '+ lu lv)) (uv '(* clhu_ clhv_)))
  (clh-cc-typ! z) (clh-cc-typ! uv) (clh-exp-typ! z)
  (clh-rr-typ! (list 'imag-part lu)) (clh-rr-typ! (list 'imag-part lv)) (clh-rr-typ! (list 'imag-part z))
  (clh-and! (list 'IN lu 'CC) (list 'IN lv 'CC))
  (fact 'cc-im-add lu lv)
  (fact 'cc-exp-add lu lv)
  (dk-have! (clh-lo z) (lambda () (subst (list '= (list 'imag-part z) (list '+ (list 'imag-part lu) (list 'imag-part lv)))) (ass)))
  (dk-have! (clh-hi z) (lambda () (subst (list '= (list 'imag-part z) (list '+ (list 'imag-part lu) (list 'imag-part lv)))) (ass)))
  (dk-have! (list '= (list 'CC-EXP z) uv)
    (lambda ()
      (subst (list '= (list 'CC-EXP z) (list '* (list 'CC-EXP lu) (list 'CC-EXP lv))))
      (subst (list '= (list 'CC-EXP lu) 'clhu_))
      (subst (list '= (list 'CC-EXP lv) 'clhv_))
