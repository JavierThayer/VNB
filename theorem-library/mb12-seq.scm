(define (msq-swap-parts! u)
  (let ((c (dk-cite! 'swap-values 'sx_ 'tpa_ 'tpb_ u)))
    (dk-split-all! (list c))
    (list (cadr c) (cadr (caddr c)) (caddr (caddr c)))))
(define (msq-use! imp)            ; detach an implication whose antecedents are in context, rewrite the goal by it
  (let ((eq (dk-chain! imp '())))
    (subst eq)))
(sp (make-wff (msq-swap-stmt (list 'FORALL 'tpu_ (list 'IMPLIES '(IN tpu_ sx_)
   (list '= (list msq-Tab (list msq-Tab 'tpu_)) 'tpu_))))))
(dk-peel!)
(dk-have! '(= tpa_ tpa_) (lambda () (rfl)))
(dk-have! '(= tpb_ tpb_) (lambda () (rfl)))
(let ((pu (msq-swap-parts! 'tpu_)))
  (use-em '(= tpu_ tpa_)
    (lambda ()
      (msq-use! (car pu))
      (let ((pb (msq-swap-parts! 'tpb_)))
        (use-em '(= tpb_ tpa_)
          (lambda () (msq-use! (car pb)) (subst '(= tpu_ tpa_)) (msq-close!))
          (lambda () (msq-use! (cadr pb)) (subst '(= tpu_ tpa_)) (msq-close!)))))
    (lambda ()
      (use-em '(= tpu_ tpb_)
        (lambda ()
          (msq-use! (cadr pu))
          (let ((pa (msq-swap-parts! 'tpa_)))
            (msq-use! (car pa)) (subst '(= tpu_ tpb_)) (msq-close!)))
        (lambda ()
          (msq-use! (caddr pu))
          (if (not (null? (dk-open-leaves))) (msq-close!)))))))
(qed 'swap-involution)
(topic! 'swap-involution 'plumbing)

