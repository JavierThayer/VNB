(define msq-SG (list 'VNB-LAMBDA 'cpj_ 'NN (msq-T '(xs cpj_) '(ys cpj_))))
(define (msq-xy-typed! v)
  (dk-cite! 'fun-apply-type-c 'xs 'NN 'sx_ v)
  (dk-cite! 'fun-apply-type-c 'ys 'NN 'sx_ v))
(define (msq-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(sp (make-wff '(FORALL sx_ (IMPLIES (IN sx_ SET)
   (FORALL xs (IMPLIES (IN xs (FUN NN sx_)) (FORALL ys (IMPLIES (IN ys (FUN NN sx_))
     (FORSOME sg (AND (IN sg (FUN NN (BIJECTION sx_ sx_))) (= ((COORD-PERMUTE sx_ sg) xs) ys)))))))))))
(dk-peel!)
(ew msq-SG)
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'IN)
       (dk-lam-type!
        (lambda ()
          (let ((v (msq-nn-var (dk-peel!))))
            (msq-xy-typed! v)
            (dk-cite! 'swap-bijection 'sx_ (list 'xs v) (list 'ys v))
            (ass))))
       (begin
         (mac 'COORD-PERMUTE)
         (dk--close-owed-typings! (lambda () (lam-b)))    ; one pass: what remains sits under the cpk_ binder
         (let ((lhs (cadr (dk-goal))))
           (dk-fun-ext! lhs 'ys 'NN 'sx_
             (lambda ()
               (dk-lam-type!
                (lambda ()
                  (let ((v (msq-nn-var (dk-peel!))))
                    (msq-xy-typed! v)
                    (msq-beta!)
                    (msq-case-in!)))))
             #f
             (lambda (v)
               (msq-xy-typed! v)
               (msq-beta!)
               (dk-if-branch! #t (cadr (dk-goal)) (lambda () (rfl)) (lambda () (rfl))))))))))
