;;; ---- Proposition A.11: convergence in X^N is eventual coordinatewise equality ----
(define msq-ev11 '(FORALL ck_ (IMPLIES (IN ck_ NN) (FORSOME cn_ (AND (IN cn_ NN)
                    (FORALL ci_ (IMPLIES (IN ci_ NN) (IMPLIES (<= cn_ ci_) (= ((zs ci_) ck_) (u ck_))))))))))
(define (msq-reduce-h! h) (dk-landed-1 (lambda () (dk-lam-b-h! h))))
;; the coordinate sequence lam = (VNB-LAMBDA k NN ((zs k) c)) is in FUN(NN, sx_), and u(c) in sx_
(define (msq-coord-typing! lam c)
  (dk-cite! 'fun-apply-type-c 'u 'NN 'sx_ c)
  (dk-have! (list 'IN lam '(FUN NN sx_))
    (lambda ()
      (dk-lam-type!
       (lambda ()
         (let ((v (msq-nn-var (dk-peel!))))
           (dk-cite! 'fun-apply-type-c 'zs 'NN '(FUN NN sx_) v)
           (dk-cite! 'fun-apply-type-c (list 'zs v) 'NN 'sx_ c)
           (ass)))))))
;; with the discrete IFF at (lam, u(c)) landed, return it
(define (msq-disc-iff! lam c)
  (msq-coord-typing! lam c)
