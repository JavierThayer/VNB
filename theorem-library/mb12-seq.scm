;;; ---- Proposition A.14: the coordinatewise permutations act transitively on X^N ----
;;; the transposition of a and b in sx_
(define (msq-T a b) (list 'VNB-LAMBDA 'tpw_ 'sx_ (list 'IF (list '= 'tpw_ a) b (list 'IF (list '= 'tpw_ b) a 'tpw_))))
(define msq-Tab (msq-T 'tpa_ 'tpb_))
(define (msq-close!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (msq-if-resolve!)
  (let ((l (cadr (dk-goal))))
    (if (dk-head-is? l 'IF)
        (dk-if-branch! (dk-asm? (cadr l)) l #f msq-if-resolve!)
        (msq-close!))))
(define (msq-case-in!)
  (let ((t (cadr (dk-goal))))
    (if (dk-head-is? t 'IF)
        (dk-case-if! t (lambda (tv v) (msq-case-in!)))
        (ass))))
(define (msq-swap-stmt body)
  (list 'FORALL 'sx_ (list 'IMPLIES '(IN sx_ SET)
    (list 'FORALL 'tpa_ (list 'IMPLIES '(IN tpa_ sx_) (list 'FORALL 'tpb_ (list 'IMPLIES '(IN tpb_ sx_) body)))))))

(sp (make-wff (msq-swap-stmt (list 'FORALL 'tpu_ (list 'IMPLIES '(IN tpu_ sx_)
   (list 'AND (list 'IMPLIES '(= tpu_ tpa_) (list '= (list msq-Tab 'tpu_) 'tpb_))
     (list 'AND (list 'IMPLIES '(NOT (= tpu_ tpa_)) (list 'IMPLIES '(= tpu_ tpb_) (list '= (list msq-Tab 'tpu_) 'tpa_)))
                (list 'IMPLIES '(NOT (= tpu_ tpa_)) (list 'IMPLIES '(NOT (= tpu_ tpb_)) (list '= (list msq-Tab 'tpu_) 'tpu_))))))))))
(dk-peel!)
(dk-conj-close!
 (lambda ()
   (let loop () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (loop))))
   (dk-lam-b!)
   (msq-if-resolve!)))
(qed 'swap-values)
(topic! 'swap-values 'plumbing)

(sp (make-wff (msq-swap-stmt (list 'IN msq-Tab '(FUN sx_ sx_)))))
(dk-peel!)
