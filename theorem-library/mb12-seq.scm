;;; the two values of the distance
(sp (make-wff '(FORALL X (IMPLIES (IN X SET) (FORALL u (IMPLIES (IN u X) (FORALL v (IMPLIES (IN v X)
     (AND (IMPLIES (= u v) (= ((DIST (DISCRETE-MS X)) u v) 0))
          (IMPLIES (NOT (= u v)) (= ((DIST (DISCRETE-MS X)) u v) 1)))))))))))
(dk-peel!)
(fact 'discrete-ms-dist-fun 'X)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-conj-close!
 (lambda ()
   (di)
   (subst (list '== '(DIST (DISCRETE-MS X)) msq-lam))
   (dk-lam-b!)
   (let ((ift (cadr (dk-goal))))
     (if (dk-asm? '(= u v))
         (dk-if-branch! #t ift #f (lambda () (rfl)))
         (dk-if-branch! #f ift #f (lambda () (rfl)))))))
(qed 'discrete-ms-dist-values)
(topic! 'discrete-ms-dist-values 'analysis)

(define (msq-D-of u v) (list (list 'DIST msq-D) u v))
(define (msq-vals! u v)               ; land the two value implications at u, v
  (if (not (dk-asm? (list 'IMPLIES (list '= u v) (list '= (msq-D-of u v) 0))))
      (dk-split-all! (list (dk-cite! 'discrete-ms-dist-values 'X u v)))))
(define (msq-eq-val! u v)             ; (= u v) in context: land D(u,v) = 0
  (msq-vals! u v)
  (if (not (dk-asm? (list '= (msq-D-of u v) 0)))
      (detach! (dk-ctx-form (list 'IMPLIES (list '= u v) (list '= (msq-D-of u v) 0))))))
(define (msq-ne-val! u v)             ; (NOT (= u v)) in context: land D(u,v) = 1
  (msq-vals! u v)
  (if (not (dk-asm? (list '= (msq-D-of u v) 1)))
      (detach! (dk-ctx-form (list 'IMPLIES (list 'NOT (list '= u v)) (list '= (msq-D-of u v) 1))))))

;;; 0 <= D(u, v) <= 1, D(u, v) real
(sp (make-wff '(FORALL X (IMPLIES (IN X SET) (FORALL u (IMPLIES (IN u X) (FORALL v (IMPLIES (IN v X)
     (AND (IN ((DIST (DISCRETE-MS X)) u v) RR)
          (AND (<= 0 ((DIST (DISCRETE-MS X)) u v)) (<= ((DIST (DISCRETE-MS X)) u v) 1)))))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(use-em '(= u v)
  (lambda () (msq-eq-val! 'u 'v) (subst (list '= (msq-D-of 'u 'v) 0)) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))
  (lambda () (msq-ne-val! 'u 'v) (subst (list '= (msq-D-of 'u 'v) 1)) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith))))))
(qed 'discrete-ms-dist-bounds)
(topic! 'discrete-ms-dist-bounds 'analysis)

(define (msq-bnd! u v)                ; land D(u,v) in RR, 0 <= D, D <= 1
  (if (not (dk-asm? (list 'IN (msq-D-of u v) 'RR)))
      (dk-split-all! (list (dk-cite! 'discrete-ms-dist-bounds 'X u v)))))
(define (msq-law!)
  (let ((g (dk-goal)))
    (cond
     ;; D(u,u) = 0
     ((and (eq? (car g) '=) (equal? (caddr g) 0))
      (let ((u (cadr (cadr g))))
        (dk-have! (list '= u u) (lambda () (rfl)))
        (msq-eq-val! u u)
        (ass)))
     ;; 0 <= D(u, v)
     ((and (eq? (car g) '<=) (equal? (cadr g) 0))
      (let* ((r (caddr g))) (msq-bnd! (cadr r) (caddr r)) (ass)))
     ;; D(u, v) = 0 => u = v
     ((and (eq? (car g) '=) (symbol? (cadr g)) (symbol? (caddr g)))
      (let* ((u (cadr g)) (v (caddr g)))
        (msq-bnd! u v)
        (use-em (list '= u v)
          (lambda () (ass))
          (lambda () (msq-ne-val! u v)
                     (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= (msq-D-of u v) 1) (list '= (msq-D-of u v) 0) (list 'IN (msq-D-of u v) 'RR))))
                     (ai (dk-cite! 'rr-lt-irrefl 0))))))
     ;; D(u, v) = D(v, u)
     ((eq? (car g) '=)
      (let* ((u (cadr (cadr g))) (v (caddr (cadr g))))
        (msq-bnd! u v) (msq-bnd! v u)
        (use-em (list '= u v)
          (lambda ()
            (dk-have! (list '= v u) (lambda () (subst (list '= u v)) (rfl)))
            (msq-eq-val! u v) (msq-eq-val! v u)
            (subst (list '= (msq-D-of u v) 0)) (subst (list '= (msq-D-of v u) 0)) (fact 'rr-zero-in) (rfl))
          (lambda ()
            (dk-have! (list 'NOT (list '= v u))
              (lambda () (di) (dk-have! (list '= u v) (lambda () (subst (list '= v u)) (rfl)))
                         (if (dk-only! (list '= u v) (list 'NOT (list '= u v))) (prop))))
            (msq-ne-val! u v) (msq-ne-val! v u)
            (subst (list '= (msq-D-of u v) 1)) (subst (list '= (msq-D-of v u) 1)) (fact 'rr-one-in) (rfl)))))
     ;; D(u, w) <= D(u, v) + D(v, w)
     ((eq? (car g) '<=)
      (let* ((lhs (cadr g)) (rhs (caddr g))
             (u (cadr lhs)) (w (caddr lhs)) (v (caddr (cadr rhs))))
        (msq-bnd! u w) (msq-bnd! u v) (msq-bnd! v w)
        (use-em (list '= u v)
          (lambda ()
            (msq-eq-val! u v)
            (dk-have! (list '= (msq-D-of u w) (msq-D-of v w)) (lambda () (subst (list '= u v)) (rfl)))
            (dk-ineq! (list '= (msq-D-of u w) (msq-D-of v w)) (list '= (msq-D-of u v) 0)
                      (list 'IN (msq-D-of u w) 'RR) (list 'IN (msq-D-of v w) 'RR) (list 'IN (msq-D-of u v) 'RR)))
          (lambda ()
            (msq-ne-val! u v)
            (dk-ineq! (list '<= (msq-D-of u w) 1) (list '= (msq-D-of u v) 1) (list '<= 0 (msq-D-of v w))
                      (list 'IN (msq-D-of u w) 'RR) (list 'IN (msq-D-of v w) 'RR) (list 'IN (msq-D-of u v) 'RR))))))
     (#t (error "msq-law!: unexpected leaf" g)))))

(sp (make-wff '(FORALL X (IMPLIES (IN X SET) (IS-METRIC-SPACE (DISCRETE-MS X))))))
(dk-peel!)
(fact 'discrete-ms-lam-type 'X)
(fact 'discrete-ms-pts 'X)
(fact 'discrete-ms-dist-fun 'X)
(dk-have! (list 'IN (list 'DIST msq-D) '(FUN (CARTESIAN X X) RR))
  (lambda () (subst (list '== (list 'DIST msq-D) msq-lam)) (ass)))
(mac 'IS-METRIC-SPACE)
(subst (list '== (list 'PTS msq-D) 'X))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((and (eq? (msq-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'DISCRETE-MS) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
      ((eq? (msq-head g) 'IS-METRIC)
       (mac 'is-metric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n) (let ((gg (dk-goal-of n))) (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (msq-law!)))) (dk-open-leaves)))
      (#t (ass))))))
(qed 'discrete-ms-is-metric-space)
(topic! 'discrete-ms-is-metric-space 'analysis)

;;; convergence in the discrete metric is eventual equality
(define msq-ev '(FORSOME n (AND (IN n NN) (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= n i) (= (f i) l)))))))
(sp (make-wff (list 'FORALL 'X (list 'FORALL 'f (list 'FORALL 'l
     (list 'IMPLIES '(IN X SET) (list 'IMPLIES '(IN f (FUN NN X)) (list 'IMPLIES '(IN l X)
       (list 'IFF '(CONVERGES-TO (DISCRETE-MS X) f l) msq-ev)))))))))
(dk-peel!)
(fact 'discrete-ms-is-metric-space 'X)
(fact 'discrete-ms-pts 'X)
(dk-iff! (dk-head? 'FORSOME)
  (lambda ()
    (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to '(CONVERGES-TO (DISCRETE-MS X) f l)))))
    (let* ((cl (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h 'POS-RR))) "the clause"))
           (_h (dk-have! '(POS-RR 1/2) (lambda () (dk-have! '(IN 1/2 RR) (lambda () (arith))) (dk-have! '(< 0 1/2) (lambda () (arith)))
                                                  (dk-close-if! (lambda () (fact 'rr-pos-rr-of-lt 1/2)) ass))))
           (n (dk-skolem! (dk-apply! cl 1/2)))
           (ncl (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
      (ew n)
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (msq-head (dk-goal)) 'FORALL))
             (ass)
             (let* ((pl (dk-peel!))
                    (i (cadr (car (filter (lambda (q) (and (eq? (msq-head q) 'IN) (eq? (caddr q) 'NN))) pl))))
                    (fi (list 'f i)))
               (fact 'fun-apply-type-c 'f 'NN 'X i)
               (dk-apply! ncl i)
               (msq-bnd! fi 'l)
               (use-em (list '= fi 'l)
                 (lambda () (ass))
                 (lambda ()
                   (msq-ne-val! fi 'l)
                   (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= (msq-D-of fi 'l) 1) (list '<= (msq-D-of fi 'l) 1/2)
                                                           (list 'IN (msq-D-of fi 'l) 'RR))))
                   (ai (dk-cite! 'rr-lt-irrefl 0))))))))))
  (lambda ()
    (let* ((n (dk-skolem! (dk-pick (lambda (h) (eq? (msq-head h) 'FORSOME)) "the threshold")))
           (ncl (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h n))) "eventually equal")))
      (mac 'converges-to)
      (subst (list '== (list 'PTS msq-D) 'X))
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (msq-head (dk-goal)) 'FORALL))
             (ass)
             (let* ((pe (dk-peel!))
                    (e (cadr (car (filter (lambda (q) (eq? (msq-head q) 'POS-RR)) pe)))))
               (fact 'rr-pos-rr-in-rr e)
               (fact 'rr-lt-of-pos-rr e)
               (ew n)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (msq-head (dk-goal)) 'FORALL))
                      (ass)
                      (let* ((pk (dk-peel!))
                             (i (cadr (car (filter (lambda (q) (and (eq? (msq-head q) 'IN) (eq? (caddr q) 'NN))) pk))))
                             (fi (list 'f i)))
                        (fact 'fun-apply-type-c 'f 'NN 'X i)
                        (dk-apply! ncl i)
                        (msq-eq-val! fi 'l)
                        (msq-bnd! fi 'l)
                        (dk-ineq! (list '= (msq-D-of fi 'l) 0) (list '< 0 e) (list 'IN (msq-D-of fi 'l) 'RR) (list 'IN e 'RR)))))))))))))
(qed 'discrete-converges-iff)
(topic! 'discrete-converges-iff 'analysis)

;;; ---- the weights 2^-n of SEQ-SPACE-MS are summable ----------------
(define msq-SW '(VNB-LAMBDA sqk_ NN (/ 1 (power 2 sqk_))))
(define msq-DW '(VNB-LAMBDA n NN (/ 1 (power 2 (+ n 1)))))
;; the value: 2^-k is real, positive, and twice the dyadic weight 2^-(k+1)
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (list 'AND (list '= (list msq-SW 'k) '(recip (power 2 k)))
         (list 'AND '(IN (recip (power 2 k)) RR)
               (list 'AND '(< 0 (recip (power 2 k)))
                     (list '= '(recip (power 2 k)) (list '* 2 (list msq-DW 'k))))))))))
(di)
(have! '(IN 2 RR) (lambda () (arith)))
(fact 'power-real-closed 2 'k)
(fact 'power-two-pos 'k)
(fact 'rr-mul-closed 2 '(power 2 k))
(fact 'rr-recip-pos '(power 2 k))
(dk-have! '(NOT (= (power 2 k) 0))
  (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= (power 2 k) 0) '(< 0 (power 2 k)) '(IN (power 2 k) RR))))
             (ai (dk-cite! 'rr-lt-irrefl 0))))
(dk-have! '(AND (IN (power 2 k) RR) (NOT (= (power 2 k) 0))))
(fact 'rr-recip-closed '(power 2 k))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((and (eq? (msq-head g) '=) (pair? (cadr g)) (pair? (car (cadr g))))
       (dk-lam-b!) (mac 'binary-divide-def)
       (fact 'rr-one-mul '(recip (power 2 k))) (ass))
      ((eq? (msq-head g) '=)
       (fact 'dyadic-weight-apply 'k)
       (subst (list '= (list msq-DW 'k) '(recip (power 2 (succ k)))))
       (dk-have! '(IN 2 CC) (lambda () (arith)))
       (dk-have! '(AND (IN 2 CC) (IN k NN)))
       (fact 'power-succ 2 'k)
       (subst '(= (power 2 (succ k)) (* 2 (power 2 k))))
       (fact 'recip-power-two-halves 'k)
       (ass))
      (#t (ass))))))
(qed 'seq-weight-value)
(topic! 'seq-weight-value 'analysis)

;; the value facts at an index v in NN already in context
(define (msq-sw-at! v)
  (dk-split-all! (list (dk-cite! 'seq-weight-value v))))
(define (msq-nn-var pl)
  (cadr (car (filter (lambda (q) (and (eq? (msq-head q) 'IN) (eq? (caddr q) 'NN))) pl))))

(sp (make-wff (list 'SUMMABLE-WEIGHT msq-SW)))
(fact 'product-metric-default-summable)
(mac-h 'summable-weight (list 'SUMMABLE-WEIGHT msq-DW))
(dk-split-all!)
(define msq-dwpos (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h '<))) "dyadic positivity"))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list msq-DW 'cpsk_))))
  (lambda ()
    (let* ((v (msq-nn-var (dk-peel!))))
      (dk-apply! msq-dwpos v)
      (fact 'fun-apply-type-c msq-DW 'NN 'RR v)
      (dk-ineq! (list '< 0 (list msq-DW v)) (list 'IN (list msq-DW v) 'RR)))))
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ NN) (list '= (list msq-SW 'i_) (list '+ (list msq-DW 'i_) (list msq-DW 'i_)))))
  (lambda ()
    (let* ((v (msq-nn-var (dk-peel!)))
           (sv (list msq-SW v)) (dv (list msq-DW v)) (rv (list 'recip (list 'power 2 v))))
      (msq-sw-at! v)
      (fact 'fun-apply-type-c msq-DW 'NN 'RR v)
      (dk-have! (list 'IN sv 'RR) (lambda () (subst (list '= sv rv)) (ass)))
      (dk-ineq! (list '= sv rv) (list '= rv (list '* 2 dv)) (list 'IN sv 'RR) (list 'IN rv 'RR) (list 'IN dv 'RR)))))
(dk-have! (list 'IN msq-SW '(FUN NN RR))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let* ((v (msq-nn-var (dk-peel!))))
         (msq-sw-at! v)
         (mac 'binary-divide-def)
         (fact 'rr-one-mul (list 'recip (list 'power 2 v)))
         (subst (list '= (list '* 1 (list 'recip (list 'power 2 v))) (list 'recip (list 'power 2 v))))
         (ass))))))
(fact 'series-converges-sum msq-DW msq-DW msq-SW)
(mac 'summable-weight)
(dk-conj-close!
 (lambda ()
   (if (eq? (msq-head (dk-goal)) 'FORALL)
       (let* ((v (msq-nn-var (dk-peel!))))
         (msq-sw-at! v)
         (subst (list '= (list msq-SW v) (list 'recip (list 'power 2 v))))
         (ass))
       (ass))))
(qed 'seq-weight-summable)
(topic! 'seq-weight-summable 'analysis)

