(define (msq-head g) (and (pair? g) (car g)))
(define (msq-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define msq-D '(DISCRETE-MS X))
(define msq-lam '(VNB-LAMBDA (LIST dsu_ dsv_) (CARTESIAN X X) (IF (= dsu_ dsv_) 0 1)))
(define (msq-if u v) (list 'IF (list '= u v) 0 1))

;;; the distance lambda is a function into RR (X a set)
(sp (make-wff (list 'FORALL 'X (list 'IMPLIES '(IN X SET) (list 'IN msq-lam '(FUN (CARTESIAN X X) RR))))))
(dk-peel!)
