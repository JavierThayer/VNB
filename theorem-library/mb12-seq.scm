(for-each
 (lambda (kn)
   (if (not (sequent-node-grounded? kn))
       (begin
         (dk-focus! kn)
         (if (and (eq? (msq-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
             (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
             (begin
               (dk-peel!)
               (dk-case-if! (cadr (dk-goal)) (lambda (tv val) (ass))))))))
 (dk-opened (lambda () (lam-t))))
