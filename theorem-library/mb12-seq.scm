(define msq-pc-iff (dk-cite! 'product-convergence-coordinatewise msq-ms msq-SW 'zs 'u))
(define msq-coord (caddr msq-pc-iff))
;; coordinate convergence => eventual equality
(dk-have! (list 'IMPLIES msq-coord msq-ev11)
  (lambda ()
    (di)
    (let* ((c (msq-nn-var (dk-peel!)))
           (cv (msq-reduce-h! (dk-apply! msq-coord c)))
           (lam (caddr cv))
           (iff (msq-disc-iff! lam c))
           (rhs (caddr iff)))
      (dk-have! rhs (lambda () (dk-only! iff cv) (prop)))
      (let* ((n0 (dk-skolem! rhs))
             (ncl (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h n0))) "eventual equality")))
        (ew n0)
        (dk-conj-close!
         (lambda ()
           (if (eq? (msq-head (dk-goal)) 'FORALL)
               (let* ((i (msq-nn-var (dk-peel!)))
                      (e (dk-apply! ncl i)))
                 (msq-reduce-h! e)
                 (ass))
               (ass))))))))
;; eventual equality => coordinate convergence
(dk-have! (list 'IMPLIES msq-ev11 msq-coord)
  (lambda ()
    (di)
    (let* ((c (msq-nn-var (dk-peel!)))
           (ex (dk-apply! msq-ev11 c)))
      (dk-lam-b!)
      (let* ((g (dk-goal))
             (lam (caddr g))
             (iff (msq-disc-iff! lam c))
             (rhs (caddr iff)))
        (dk-have! rhs
          (lambda ()
            (let* ((n0 (dk-skolem! ex))
                   (ncl (dk-pick (lambda (h) (and (eq? (msq-head h) 'FORALL) (dk-contains? h n0))) "eventual equality")))
              (ew n0)
              (dk-conj-close!
               (lambda ()
                 (if (eq? (msq-head (dk-goal)) 'FORALL)
                     (let ((i (msq-nn-var (dk-peel!))))
                       (dk-apply! ncl i)
                       (dk-lam-b!)
                       (ass))
                     (ass)))))))
        (dk-only! iff rhs)
        (prop)))))
(dk-only! msq-pc-iff (list 'IMPLIES msq-coord msq-ev11) (list 'IMPLIES msq-ev11 msq-coord))
(prop)
