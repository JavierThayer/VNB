;;; ch4a-outer.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch4a/ch4a-outer.scm.
;;; Library: complex-analysis.

;;; ch4a-outer.scm -- the second half of Lemma 4.4 (CH4-A, 2026-10-28): a Cauchy-type integral OUTSIDE the
;;; disc holding the trace is a series in 1/(z - c).  phi continuous on u, |w - c| <= r on u, a road with
;;; its trace in u; for r < |z - c|:
;;;   int_gamma phi(w) / (z - w) dw = sum_{k >= 0} [int_gamma phi(w) (w - c)^k dw] (1/(z - c))^(k+1).
;;; The pointwise remainder is aif-geometric-remainder with the roles of the two points exchanged; the
;;; uniform bound follows geometric-expansion-uniform; termwise integration is ch4a-termwise.
;;; Library: complex-analysis.  Load window: after ch4a-termwise.  Prefix out-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define out-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (out-sub u) (list 'SUBSPACE-MS out-nfm u))
(define (out-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u) (list 'IS-CONTINUOUS-AT (out-sub u) out-nfm f 'rgy_))))
(define (out-imps hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (out-imps (cdr hs) concl))))
(define (out-alls vs body) (if (null? vs) body (list 'FORALL (car vs) (out-alls (cdr vs) body))))
(define (out-ptw u h rhs-of)
  (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ u) (list '== (list h 'aix_) (rhs-of 'aix_)))))
(define (out-close!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (out-cc! t)          ; land (IN t CC) -- never closes the focus goal (that would move the focus)
  (if (not (or (dk-asm? (list 'IN t 'CC)) (and (pair? (dk-open-leaves)) (equal? (dk-goal) (list 'IN t 'CC)))))
      (dk-type! t 'CC)))
(define (out-real! t) (dk-type! t 'RR))
(define (out-repl e from to)
  (cond ((eq? e from) to) ((pair? e) (cons (out-repl (car e) from to) (out-repl (cdr e) from to))) (#t e)))
(define (out-ms! u)
  (fact 'nf-cc-is-metric-space)
  (fact 'cc-is-normed-field) (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS out-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS out-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-have! (list 'SUBSET u (list 'PTS out-nfm)) (lambda () (subst (list '== (list 'PTS out-nfm) 'CC)) (ass)))
  (dk-have! (list 'IN u 'SET) (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC) (ass)))
  (fact 'subspace-is-metric-space out-nfm u)
  (fact 'subspace-pts out-nfm u))

;;; (1) x |-> 1/(z - x) is continuous on a set avoiding z
(define out-nz '(DIFFERENCE CC (SINGLETON 0)))
(define out-rlam (list 'VNB-LAMBDA 'crz_ out-nz '(recip crz_)))
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (list 'FORALL 'z (out-imps (list '(IN z CC) '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ z)))))
      (list 'FORALL 'h (out-imps (list '(IN h (FUN u CC)) (out-ptw 'u 'h (lambda (x) (list 'recip (list '- 'z x)))))
                         (out-cont 'u 'h)))))))))
(dk-peel!)
(out-ms! 'u)
(define out-a-y (list-ref (dk-goal) 4))
(define out-a-lam '(VNB-LAMBDA ouz_ u (- z ouz_)))
(fact 'cc-zero-in) (fact 'cc-one-in)
(out-cc! '(- 0 1))
(dk-have! (list 'IN out-a-lam '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (fact 'subset-mem-fwd 'u 'CC v) (dk-type! (list '- 'z v) 'CC))))))
(dk-have! (out-ptw 'u out-a-lam (lambda (x) (list '+ 0 (list '* '(- 0 1) (list '- x 'z)))))
  (lambda () (let ((v (dk-di-var!)))
               (fact 'subset-mem-fwd 'u 'CC v)
               (dk-lam-b!)
               (dk-have! (list '= (list '- 'z v) (list '+ 0 (list '* '(- 0 1) (list '- v 'z)))) (lambda () (crs)))
               (subst (list '= (list '- 'z v) (list '+ 0 (list '* '(- 0 1) (list '- v 'z)))))
               (if (pair? (dk-open-leaves)) (qrfl)))))
(fact 'aif-cont-affine 'u 0 '(- 0 1) 'z out-a-lam)
(define (out-nz! v)
  (fact 'subset-mem-fwd 'u 'CC v)
  (out-cc! (list '- 'z v))
  (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ z))))) v)
  (dk-have! (list 'NOT (list '= (list '- 'z v) 0))
    (lambda ()
      (di)
      (fact 'cc-sub-zero-eq 'z v)
      (dk-have! (list '= v 'z) (lambda () (subst (list '= 'z v)) (rfl)))
      (ai (dk-ctx-form (list 'NOT (list '= v 'z))))))
  (dk-have! (list 'IN (list '- 'z v) out-nz)
    (lambda () (mac 'cc-nonzero-membership) (dk-conj-close! dk-ass!))))
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ u) (list 'IN (list out-a-lam 'aix_) out-nz)))
  (lambda () (let ((v (dk-di-var!))) (out-nz! v) (dk-lam-b!) (if (pair? (dk-open-leaves)) (ass)))))
(fact 'cc-nonzero-subset)
(fact 'cc-recip-continuous-at)
(dk-have! (out-ptw 'u 'h (lambda (x) (list out-rlam (list out-a-lam x))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (out-nz! v)
      (dk-apply! (dk-ctx-form (out-ptw 'u 'h (lambda (x) (list 'recip (list '- 'z x))))) v)
      (dk-lam-b!)
      (if (pair? (dk-open-leaves)) (ass)))))
(dk-apply! (dk-fact! 'aif-cont-compose 'u out-a-lam out-nz out-rlam 'h) out-a-y)
(out-close!)
(qed 'out-cont-recip-rev)

;;; (2) THE SECOND HALF OF LEMMA 4.4
(define out-s '(recip (- z c)))
(define (out-term w j) (list '* (list '* (list 'phi w) (list 'power out-s (list 'succ j))) (list 'power (list '- w 'c) j)))
(define out-HF (list 'VNB-LAMBDA 'ouj_ 'NN (list 'VNB-LAMBDA 'ouw_ 'u (out-term 'ouw_ 'ouj_))))
(define out-GZ '(VNB-LAMBDA ouw_ u (* (phi ouw_) (recip (- z ouw_)))))
(define (out-OP k) (list 'VNB-LAMBDA 'ouw_ 'u (list '* '(phi ouw_) (list 'power '(- ouw_ c) k))))
(define (out-LI f) (list 'LINE-INT f 'pgam 'dgam 'a 'b))
(define out-SER (list 'VNB-LAMBDA 'outk_ 'NN (list '* (out-LI (out-OP 'outk_)) (list 'power out-s '(succ outk_)))))
(define out-rho '(magnitude (- z c)))
(define out-set-h
  (list '(SUBSET u CC) '(IN c CC) '(IN r RR) '(<= 0 r)
        '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (- aix_ c)) r)))
        '(IN phi (FUN u CC)) (out-cont 'u 'phi) '(IS-ROAD pgam dgam a b) '(SUBSET (TRACE pgam a b) u)))
(sp (make-wff
  (out-alls '(u c r phi pgam dgam a b)
    (out-imps out-set-h
      (list 'FORALL 'z (out-imps (list '(IN z CC) (list '< 'r out-rho))
        (list 'CC-SERIES-CONVERGES-TO out-SER (out-LI out-GZ))))))))
(dk-peel!)
(out-ms! 'u)
(fact 'nn-is-set) (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'rr-zero-in) (fact 'rr-one-in)
(out-cc! '(- z c))
(fact 'cc-magnitude-closed '(- z c))
(fact 'cc-magnitude-nonneg '(- z c))
(fact 'cc-magnitude-zero)
(dk-have! (list '< 0 out-rho) (lambda () (dk-ineq! '(IN r RR) (list 'IN out-rho 'RR) '(<= 0 r) (list '< 'r out-rho))))
(dk-have! '(NOT (= (- z c) 0))
  (lambda ()
    (di)
    (dk-have! (list '= out-rho 0) (lambda () (subst '(= (- z c) 0)) (out-close!)))
    (dk-absurd! (list 'IN out-rho 'RR) (list '< 0 out-rho) (list '= out-rho 0))))
(dk-have! '(AND (IN (- z c) CC) (NOT (= (- z c) 0))))
(fact 'cc-recip-closed '(- z c))
(dk-have! (list '<= out-rho out-rho) (lambda () (dk-ineq! (list 'IN out-rho 'RR))))
(dk-have! '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ z))))
  (lambda () (let ((x (dk-di-var!)))
               (fact 'subset-mem-fwd 'u 'CC x)
               (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (- aix_ c)) r)))) x)
               (out-cc! (list '- x 'c))
               (fact 'cc-magnitude-closed (list '- x 'c))
               (di)
               (dk-have! (list '= (list 'magnitude (list '- x 'c)) out-rho) (lambda () (subst (list '= x 'z)) (rfl)))
               (dk-absurd! (list 'IN (list 'magnitude (list '- x 'c)) 'RR) (list 'IN out-rho 'RR) (list 'IN 'r 'RR)
                           (list '<= (list 'magnitude (list '- x 'c)) 'r) (list '< 'r out-rho)
                           (list '= (list 'magnitude (list '- x 'c)) out-rho)))))
;; a point of u: typed, phi(x) complex, |x - c| <= r, x /= z, 1/(z - x) complex
(define (out-pt! x)
  (fact 'subset-mem-fwd 'u 'CC x)
  (fact 'fun-apply-type-c 'phi 'u 'CC x)
  (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (- aix_ c)) r)))) x)
  (out-cc! (list '- x 'c)) (out-cc! (list '- 'z x))
  (fact 'cc-magnitude-closed (list '- x 'c))
  (fact 'cc-magnitude-nonneg (list '- x 'c))
  (dk-have! (list '< (list 'magnitude (list '- x 'c)) out-rho)
    (lambda () (dk-ineq! (list 'IN (list 'magnitude (list '- x 'c)) 'RR) '(IN r RR) (list 'IN out-rho 'RR) (list '<= (list 'magnitude (list '- x 'c)) 'r) (list '< 'r out-rho))))
  (if (not (dk-asm? (list 'NOT (list '= x 'z))))
      (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ z))))) x))
  (dk-have! (list 'NOT (list '= (list '- 'z x) 0))
    (lambda ()
      (di)
      (fact 'cc-sub-zero-eq 'z x)
      (dk-have! (list '= x 'z) (lambda () (subst (list '= 'z x)) (rfl)))
      (ai (dk-ctx-form (list 'NOT (list '= x 'z))))))
  (dk-have! (list 'AND (list 'IN (list '- 'z x) 'CC) (list 'NOT (list '= (list '- 'z x) 0))))
  (fact 'cc-recip-closed (list '- 'z x)))
;; one typing step of a lambda over u (the leaf may be grounded by hash-consing as soon as v is introduced)
(define (out-lam-typ-step! lam)
  (let* ((v (dk-di-var!)) (body (out-repl (list-ref lam 3) 'ouw_ v)))
    (if (and (pair? (dk-open-leaves)) (equal? (dk-goal) (list 'IN body 'CC)))
        (let ((goal (dk-goal)))
          (fact 'subset-mem-fwd 'u 'CC v)
          (fact 'fun-apply-type-c 'phi 'u 'CC v)
          (if (dk-contains? body 'recip) (out-pt! v))
          (if (and (pair? (dk-open-leaves)) (equal? (dk-goal) goal))
              (if (dk-asm? goal) (ass) (dk-type! body 'CC)))))))
;; the family and the kernel: typed and continuous
(define (out-HFj! j)
  ;; j in NN: (HF j) in fun(u, cc), continuous on u
  (fact 'nn-succ-closed j)
  (let* ((S (list 'power out-s (list 'succ j)))
         (K (list 'VNB-LAMBDA 'ouw_ 'u S))
         (P1 (list 'VNB-LAMBDA 'ouw_ 'u (list '* '(phi ouw_) S)))
         (L (list 'VNB-LAMBDA 'ouw_ 'u '(- ouw_ c)))
         (P2 (list 'VNB-LAMBDA 'ouw_ 'u (list 'power '(- ouw_ c) j)))
         (H (list 'VNB-LAMBDA 'ouw_ 'u (out-term 'ouw_ j))))
    (out-cc! S)
    (for-each (lambda (lam)
                (if (not (dk-asm? (list 'IN lam '(FUN u CC))))
                    (dk-have! (list 'IN lam '(FUN u CC))
                      (lambda () (dk-lam-type! (lambda () (out-lam-typ-step! lam)))))))
              (list K P1 L P2 H))
    (dk-have! (out-ptw 'u K (lambda (x) S)) (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
    (fact 'aif-cont-const 'u S K)
    (dk-have! (out-ptw 'u P1 (lambda (x) (list '* (list 'phi x) (list K x))))
      (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-product 'u 'phi K P1)
    (dk-have! (out-ptw 'u L (lambda (x) (list '- x 'c))) (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
    (fact 'aif-cont-shift 'u 'c L)
    (dk-have! (out-ptw 'u P2 (lambda (x) (list 'power (list L x) j)))
      (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-power-of 'u L j P2)
    (dk-have! (out-ptw 'u H (lambda (x) (list '* (list P1 x) (list P2 x))))
      (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-product 'u P1 P2 H)
    H))
(dk-have! (list 'FORALL 'twj_ (list 'IMPLIES '(IN twj_ NN) (list 'IN (list out-HF 'twj_) '(FUN u CC))))
  (lambda () (let* ((j (dk-di-var!)) (H (out-HFj! j))) (dk-lam-b!) (out-close!))))
(dk-have! (list 'FORALL 'twj_ (list 'IMPLIES '(IN twj_ NN) (out-cont 'u (list out-HF 'twj_))))
  (lambda () (let* ((j (dk-di-var!)) (H (out-HFj! j)))
               (dk-lam-b!)
               (let ((y (list-ref (dk-goal) 4)))
                 (dk-apply! (dk-ctx-form (out-cont 'u H)) y)
                 (out-close!)))))
(define out-Rz '(VNB-LAMBDA ouw_ u (recip (- z ouw_))))
(for-each (lambda (lam)
            (dk-have! (list 'IN lam '(FUN u CC))
              (lambda () (dk-lam-type! (lambda () (out-lam-typ-step! lam))))))
          (list out-Rz out-GZ))
(dk-have! (out-ptw 'u out-Rz (lambda (x) (list 'recip (list '- 'z x))))
  (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
(fact 'out-cont-recip-rev 'u 'z out-Rz)
(dk-have! (out-ptw 'u out-GZ (lambda (x) (list '* (list 'phi x) (list out-Rz x))))
  (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
(fact 'aif-cont-product 'u 'phi out-Rz out-GZ)
;; ---- the uniform estimate on the trace
(define (out-inner y) (list 'VNB-LAMBDA 'twj_ 'NN (list (list out-HF 'twj_) y)))
(define (out-LS y) (list 'VNB-LAMBDA 'aij_ 'NN (out-term y 'aij_)))
(define out-unif
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'twcap_ (list 'AND '(IN twcap_ NN)
      (list 'FORALL 'twk_ (list 'IMPLIES '(IN twk_ NN) (list 'IMPLIES '(<= twcap_ twk_)
        (list 'FORALL 'twy_ (list 'IMPLIES '(IN twy_ (TRACE pgam a b))
          (list '<= (list 'magnitude (list '- (list 'CC-SERIES-PARTIAL-SUM (out-inner 'twy_) 'twk_) (list out-GZ 'twy_))) 'eps)))))))))))
(fact 'is-road-is-path 'pgam 'dgam 'a 'b)
(define out-M (dk-skolem! (dk-fact! 'aif-trace-bounded 'u 'phi 'pgam 'a 'b)))
(dk-split-all!)
(define out-bnd (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ (TRACE pgam a b)) (list '<= '(magnitude (phi aiy_)) out-M))))
(dk-have! (list 'NOT (list '= out-rho 0)) (lambda () (di) (dk-absurd! (list 'IN out-rho 'RR) (list '< 0 out-rho) (list '= out-rho 0))))
(dk-have! (list 'AND (list 'IN out-rho 'RR) (list 'NOT (list '= out-rho 0))))
(fact 'rr-recip-closed out-rho)
(fact 'rr-recip-pos out-rho)
(fact 'rr-recip-inverse out-rho)
(define out-rR (list 'recip out-rho))
(define out-x (list '* 'r out-rR))
(out-real! out-x)
(dk-have! (list '<= 0 out-rR) (lambda () (dk-ineq! (list 'IN out-rR 'RR) (list '< 0 out-rR))))
(dk-have! (list 'AND '(IN r RR) (list 'IN out-rR 'RR)))
(dk-have! (list 'AND '(<= 0 r) (list '<= 0 out-rR)))
(fact 'rr-leq-mul-nonneg 'r out-rR)
(dk-have! (list '< out-x 1)
  (lambda ()
    (dk-have! (list 'NOT (list '<= 1 out-x))
      (lambda ()
        (di)
        (dk-have! (list '<= 0 out-rho) (lambda () (dk-ineq! (list 'IN out-rho 'RR) (list '< 0 out-rho))))
        (fact 'rr-mul-le-right 1 out-x out-rho)
        (out-real! (list '* out-x out-rho))
        (dk-have! (list '= (list '* out-x out-rho) 'r)
          (lambda ()
            (dk-have! (list '= (list '* out-x out-rho) (list '* 'r (list '* out-rho out-rR))) (lambda () (dk-crs-opaque!)))
            (subst (list '= (list '* out-x out-rho) (list '* 'r (list '* out-rho out-rR))))
            (subst (list '= (list '* out-rho out-rR) 1))
            (crs)))
        (dk-absurd! '(IN r RR) (list 'IN out-rho 'RR) (list 'IN (list '* out-x out-rho) 'RR)
                    (list '<= (list '* 1 out-rho) (list '* out-x out-rho)) (list '= (list '* out-x out-rho) 'r)
                    (list '< 'r out-rho))))
    (fact 'rr-not-le-lt 1 out-x)
    (out-close!)))
(define out-d2 (list '- out-rho 'r))
(out-real! out-d2)
(dk-have! (list '< 0 out-d2) (lambda () (dk-ineq! '(IN r RR) (list 'IN out-rho 'RR) (list '< 'r out-rho))))
(dk-have! (list 'NOT (list '= out-d2 0)) (lambda () (di) (dk-absurd! '(IN r RR) (list 'IN out-rho 'RR) (list '< 'r out-rho) (list '= out-d2 0))))
(dk-have! (list 'AND (list 'IN out-d2 'RR) (list 'NOT (list '= out-d2 0))))
(fact 'rr-recip-closed out-d2)
(fact 'rr-recip-pos out-d2)
(define out-q2 (list 'recip out-d2))
(dk-have! (list '<= 0 out-q2) (lambda () (dk-ineq! (list 'IN out-q2 'RR) (list '< 0 out-q2))))
(define out-B (list '* out-M out-q2))
(out-real! out-B)
(dk-have! (list 'AND (list 'IN out-M 'RR) (list 'IN out-q2 'RR)))
(dk-have! (list 'AND (list '<= 0 out-M) (list '<= 0 out-q2)))
(fact 'rr-leq-mul-nonneg out-M out-q2)
(dk-have! (list 'AND (list '<= 0 out-x) (list '< out-x 1)))

;; the estimate at k >= cap and y on the trace (the focus goal)
(define (out-step! k y eps epsp cap)
  (let* ((yc (list 'magnitude (list '- y 'c)))
         (LS (out-LS y)) (IN_ (out-inner y))
         (lhs (list 'magnitude (list '- (list 'CC-SERIES-PARTIAL-SUM LS k) (list '* (list 'phi y) (list 'recip (list '- 'z y))))))
         (xy (list '* yc out-rR))
         (p1 (list 'power xy k)) (p2 (list 'power out-x k))
         (d1 (list '- out-rho yc)) (q1 (list 'recip d1))
         (t1 (list '* (list '* out-M p1) q1))
         (tA (list '* (list '* out-M p2) q1))
         (t2 (list '* (list '* out-M p2) out-q2))
         (t3 (list '* out-B p2))
         (t4 (list '* out-B epsp)))
    ;; the inner family is the remainder lemma's
    (dk-fun-ext! IN_ LS 'NN 'CC
      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                            (fact 'nn-succ-closed j)
                                            (dk-lam-b!)
                                            (if (pair? (dk-open-leaves)) (dk-type! (out-term y j) 'CC))))))
      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                            (fact 'nn-succ-closed j)
                                            (dk-type! (out-term y j) 'CC)))))
      (lambda (j) (fact 'nn-succ-closed j) (dk-type! (out-term y j) 'CC) (dk-lam-b!) (if (pair? (dk-open-leaves)) (rfl))))
    (subst (list '= IN_ LS))
    (dk-lam-b!)
    ;; the pointwise remainder, roles exchanged
    (let ((rem (let ((cj (dk-fact! 'aif-geometric-remainder 'c out-rho 'z y (list 'phi y) out-M k)))
                 (dk-split! cj) (caddr cj))))
      ;; p1 <= p2, q1 <= q2
      (dk-have! (list 'AND (list 'IN yc 'RR) (list 'IN out-rR 'RR)))
      (dk-have! (list 'AND (list '<= 0 yc) (list '<= 0 out-rR)))
      (fact 'rr-leq-mul-nonneg yc out-rR)
      (out-real! xy)
      (fact 'rr-mul-le-right yc 'r out-rR)
      (fact 'rr-power-mono-base k xy out-x)
      (fact 'rr-power-nonneg k xy) (fact 'rr-power-nonneg k out-x)
      (fact 'power-real-closed xy k) (fact 'power-real-closed out-x k)
      (out-real! d1)
      (dk-have! (list '<= out-d2 d1) (lambda () (dk-ineq! '(IN r RR) (list 'IN yc 'RR) (list 'IN out-rho 'RR) (list '<= yc 'r))))
      (fact 'rr-recip-antitone out-d2 d1)
      (dk-have! (list '< 0 d1) (lambda () (dk-ineq! (list 'IN out-d2 'RR) (list 'IN d1 'RR) (list '< 0 out-d2) (list '<= out-d2 d1))))
      (dk-have! (list 'NOT (list '= d1 0)) (lambda () (di) (dk-absurd! (list 'IN d1 'RR) (list '< 0 d1) (list '= d1 0))))
      (dk-have! (list 'AND (list 'IN d1 'RR) (list 'NOT (list '= d1 0))))
      (fact 'rr-recip-closed d1) (fact 'rr-recip-pos d1)
      (dk-have! (list '<= 0 q1) (lambda () (dk-ineq! (list 'IN q1 'RR) (list '< 0 q1))))
      (for-each out-real! (list (list '* out-M p1) (list '* out-M p2) t1 tA t2 t3 t4))
      ;; t1 <= tA <= t2 = t3 <= t4 <= eps
      (dk-have! (list 'AND (list '<= 0 out-M) (list '<= p1 p2)))
      (fact 'rr-le-scale-nonneg out-M p1 p2)
      (fact 'rr-mul-le-right (list '* out-M p1) (list '* out-M p2) q1)
      (dk-have! (list 'AND (list 'IN out-M 'RR) (list 'IN p2 'RR)))
      (dk-have! (list 'AND (list '<= 0 out-M) (list '<= 0 p2)))
      (fact 'rr-leq-mul-nonneg out-M p2)
      (dk-have! (list 'AND (list '<= 0 (list '* out-M p2)) (list '<= q1 out-q2)))
      (fact 'rr-le-scale-nonneg (list '* out-M p2) q1 out-q2)
      (dk-have! (list '= t2 t3) (lambda () (crs)))
      (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= cap 'k) (list '<= (list 'power out-x 'k) epsp))))) k)
      (dk-have! (list 'AND (list '<= 0 out-B) (list '<= p2 epsp)))
      (fact 'rr-le-scale-nonneg out-B p2 epsp)
      (dk-ineq! (list 'IN (cadr rem) 'RR) (list 'IN t1 'RR) (list 'IN tA 'RR) (list 'IN t2 'RR) (list 'IN t3 'RR) (list 'IN t4 'RR)
                (list 'IN eps 'RR) rem (list '<= t1 tA) (list '<= tA t2) (list '= t2 t3) (list '<= t3 t4) (list '<= t4 eps)))))
(dk-have! out-unif
  (lambda ()
    (dk-peel!)
    (let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
           (sc (dk-fact! 'aif-scale-small out-B eps))
           (epsp (list '* eps (list 'recip (list '+ out-B 1)))))
      (fact 'rr-pos-rr-in-rr eps)
      (dk-split! sc)
      (fact 'rr-pos-rr-in-rr epsp)
      (let* ((th (dk-apply! (dk-fact! 'power-small-threshold out-x) epsp))
             (cap (dk-skolem! th)))
        (dk-split-all!)
        (ew cap)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN) (ass)
                (begin
                  (dk-peel!)
                  (let* ((k (caddr (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) cap))) "k")))
                         (y (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(TRACE pgam a b)))) "y"))))
                    (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
                    (out-pt! y)
                    (dk-apply! (dk-ctx-form out-bnd) y)
                    (out-step! k y eps epsp cap))))))))))
;; ---- termwise integration, and the terms brought to the notes' form
(define out-conv (dk-fact! 'line-int-termwise 'u 'pgam 'dgam 'a 'b out-HF out-GZ))
(define out-F1 (list 'VNB-LAMBDA 'twj_ 'NN (list 'LINE-INT (list out-HF 'twj_) 'pgam 'dgam 'a 'b)))
(define (out-OPj! j)
  ;; j in NN: OP(j) typed and continuous, its integral complex; returns OP(j)
  (let* ((H (out-HFj! j))
         (P2 (list 'VNB-LAMBDA 'ouw_ 'u (list 'power '(- ouw_ c) j)))
         (OP (out-OP j)))
    (if (not (dk-asm? (list 'IN OP '(FUN u CC))))
        (dk-have! (list 'IN OP '(FUN u CC)) (lambda () (dk-lam-type! (lambda () (out-lam-typ-step! OP))))))
    (dk-have! (out-ptw 'u OP (lambda (x) (list '* (list 'phi x) (list P2 x))))
      (lambda () (let ((v (dk-di-var!))) (out-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-product 'u 'phi P2 OP)
    (fact 'line-int-in-cc 'u OP 'pgam 'dgam 'a 'b)
    (fact 'line-int-in-cc 'u H 'pgam 'dgam 'a 'b)
    OP))
(dk-fun-ext! out-F1 out-SER 'NN 'CC
  (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (OP (out-OPj! j)))
                                        (if (pair? (dk-open-leaves)) (begin (dk-lam-b!) (out-close!)))))))
  (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (OP (out-OPj! j)))
                                        (fact 'nn-succ-closed j)
                                        (out-cc! (list 'power out-s (list 'succ j)))
                                        (if (pair? (dk-open-leaves)) (dk-type! (list '* (out-LI OP) (list 'power out-s (list 'succ j))) 'CC))))))
  (lambda (j)
    (let* ((OP (out-OPj! j)) (H (list 'VNB-LAMBDA 'ouw_ 'u (out-term 'ouw_ j))) (S (list 'power out-s (list 'succ j))))
      (fact 'nn-succ-closed j)
      (out-cc! S)
      (dk-have! (out-ptw 'u H (lambda (x) (list '* S (list OP x))))
        (lambda () (let ((v (dk-di-var!)))
                     (out-pt! v)
                     (dk-lam-b!)
                     (let ((lhs (out-term v j)) (rhs (list '* S (list '* (list 'phi v) (list 'power (list '- v 'c) j)))))
                       (out-cc! (list 'power (list '- v 'c) j))
                       (dk-have! (list '= lhs rhs) (lambda () (crs)))
                       (subst (list '= lhs rhs))
                       (if (pair? (dk-open-leaves)) (qrfl))))))
      (let ((e (dk-apply! (dk-cite! 'line-int-scalar 'u OP 'pgam 'dgam 'a 'b) S H)))
        (dk-lam-b!)
        (subst (list '= (out-LI H) (list '* S (out-LI OP))))
        (if (pair? (dk-open-leaves)) (crs))))))
(dk-rewrite-h! out-conv out-F1 out-SER)
(out-close!)
(qed 'outer-kernel-integral-series)
