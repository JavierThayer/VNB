;;; theorem-library/measure-ch1-vitali.scm -- NO TRANSLATION-INVARIANT MEASURE ON ALL SUBSETS OF R (VITALI)
;;; (M-A, wave MAP-1026, 2026-10-26).  Source: Thayer, Construction of Measures, ch. 1, Prop. 1.23.
;;; Vocabulary: TRANSLATE (structure-library/lebesgue-translate.scm).  Helper prefix: ma- (kit), mv- (Vitali).
;;;
;;; THE HEADLINE.
;;;   vitali-no-invariant-measure   there is no mu with IS-MEASURE(RR, POWER(RR), mu), mu(TRANSLATE(es, t)) =
;;;                                 mu(es) for every es subset of R and t real, and 0 < mu([0, 1]) < infinity.
;;;
;;; THE ROUTE (the notes' proof, two deviations).  (1) The equivalence x == y iff x - y in Q is run on the group
;;; D = { d : (c + 1) d = a - b, a, b, c in NN }, which is Q, but written so that its group laws and its
;;; enumeration by NN (m |-> (nnfst m - nnfst(nnsnd m)) / (nnsnd(nnsnd m) + 1)) are proved from NN and RR
;;; arithmetic: QQ's generation axiom `qq-is-fraction' is asserted (reference warrant), and the countability of
;;; Q through it would bill it.  (2) The choice set H takes, for each x in [0, 1], CHOICE of the class of x cut
;;; to [0, 1] (no floor needed).  If mu(H) = 0, the translates of H by the enumeration of D cover [0, 1], so
;;; mu([0, 1]) <= 0 (vitali-null-case).  If 0 < mu(H), the translates of H by 1/(n + 1) are pairwise disjoint and
;;; lie in [0, 1] u ([0, 1] + 1), of finite measure, while their measures sum to a series of equal positive terms,
;;; which is not finite (esum-constant-positive-not-finite, from esum-nn-tail-small) (vitali-positive-case).
;;;
;;; The enumeration of D, nn-fractions-enumerated, is in theorem-library/qq-countable.scm (library analysis).
;;;
;;; LOAD WINDOW.  lo: theorem-library/qq-countable, theorem-library/product-measure (measure-union-finite;
;;; load.scm 3671), after
;;; theorem-library/lebesgue-measure-unique (translate-membership, translate-subset-rr; 3661) and
;;; theorem-library/metric-outer-measure (esum-nn-tail-small; 3645).  hi: none.  Library: measure.
;;;
;;; No top-level macro: the file may be compiled.

;;; =====================================================================
;;; (0) the ma- kit
;;; =====================================================================
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; (18) VITALI (Prop. 1.23).  The equivalence of the notes, x == y iff x - y is rational, is run on the
;;; additive group D = { d in RR : (c + 1) d = a - b for some a, b, c in NN } (the rationals, written so that
;;; no fact about QQ is needed: QQ's generation axiom `qq-is-fraction' is asserted, and a proof through it
;;; would bill it).  D is a subgroup of R, it is enumerated by NN, and it holds the distinct points
;;; 1/(n + 1) of (0, 1]: that is all the argument uses.

(define (mv-dbody d)
  (list 'FORSOME 'mva_ (list 'AND '(IN mva_ NN)
    (list 'FORSOME 'mvb_ (list 'AND '(IN mvb_ NN)
      (list 'FORSOME 'mvc_ (list 'AND '(IN mvc_ NN)
        (list '= '(- mva_ mvb_) (list '* '(+ mvc_ 1) d)))))))))
(define mv-d (list 'SEP 'mvd_ 'RR (mv-dbody 'mvd_)))
(define (mv-in-d t) (list 'IN t mv-d))

;;; with (IN t D) in context: land a, b, c in NN and a - b = (c + 1) t; return (a b c)
(define (mv-d-open! t)
  (let* ((ex (ma-sep-parts! (mv-in-d t)))
         (a (dk-skolem! ex))
         (b (dk-skolem! (dk-ctx-form (subst-free 'mva_ a (caddr (caddr ex))))))
         (c (dk-skolem! (dk-ctx-form (subst-free 'mvb_ b (subst-free 'mva_ a (caddr (caddr (caddr (caddr ex))))))))))
    (list a b c)))
;;; prove the focus goal (IN t D) with witnesses a, b, c; EQ! proves (= (- a b) (* (+ c 1) t)) on its leaf
(define (mv-d-close! t a b c eq!)
  (in-sep! (lambda () (dk-type! t) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
    (lambda ()
      (ew a)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew b)
                 (dk-conj-close!
                   (lambda ()
                     (cond ((dk-ass!) #t)
                           ((dk-head-is? (dk-goal) 'FORSOME)
                            (ew c)
                            (dk-conj-close! (lambda () (if (not (dk-ass!)) (eq!)))))
                           (#t (error "mv-d-close!: unexpected goal" (dk-goal)))))))
                (#t (error "mv-d-close!: unexpected goal" (dk-goal)))))))))
(define (mv-nn-rr! . vs) (ma-for-each (lambda (v) (fact 'nn-in-rr v)) vs))

(sp (make-wff (forall-guarded '(x) '((IN x RR)) (mv-in-d '(- x x)))))
(dk-peel!)
(fact 'nn-zero-in)
(fact 'nn-in-rr 0)
(mv-d-close! '(- x x) 0 0 0 (lambda () (crs)))
(qed 'vitali-d-refl)

(sp (make-wff (forall-guarded '(x y) (list '(IN x RR) '(IN y RR) (mv-in-d '(- y x))) (mv-in-d '(- x y)))))
(dk-peel!)
(let* ((abc (mv-d-open! '(- y x))) (a (car abc)) (b (cadr abc)) (c (caddr abc)))
  (mv-nn-rr! a b c)
  (mv-d-close! '(- x y) b a c
    (lambda ()
      (let ((e1 (list '= (list '* (list '+ c 1) '(- x y)) (list '- 0 (list '* (list '+ c 1) '(- y x))))))
        (dk-have! e1 (lambda () (crs)))
        (subst e1)
        (subst (list '= (list '* (list '+ c 1) '(- y x)) (list '- a b)))
        (crs)))))
(qed 'vitali-d-symm)

(sp (make-wff (forall-guarded '(x y z) (list '(IN x RR) '(IN y RR) '(IN z RR) (mv-in-d '(- x y)) (mv-in-d '(- y z)))
  (mv-in-d '(- x z)))))
(dk-peel!)
(let* ((abc (mv-d-open! '(- x y))) (a (car abc)) (b (cadr abc)) (c (caddr abc))
       (abc2 (mv-d-open! '(- y z))) (a2 (car abc2)) (b2 (cadr abc2)) (c2 (caddr abc2))
       (cc3 (list '+ (list '* c c2) (list '+ c c2)))
       (aa3 (list '+ (list '* a (list '+ c2 1)) (list '* a2 (list '+ c 1))))
       (bb3 (list '+ (list '* b (list '+ c2 1)) (list '* b2 (list '+ c 1)))))
  (mv-nn-rr! a b c a2 b2 c2)
  (fact 'nn-one-in)
  (dk-type! cc3 'NN) (dk-type! aa3 'NN) (dk-type! bb3 'NN)
  (mv-d-close! '(- x z) aa3 bb3 cc3
    (lambda ()
      (let ((e1 (list '= (list '* (list '+ cc3 1) '(- x z))
                         (list '+ (list '* (list '+ c2 1) (list '* (list '+ c 1) '(- x y)))
                                  (list '* (list '+ c 1) (list '* (list '+ c2 1) '(- y z)))))))
        (dk-have! e1 (lambda () (crs)))
        (subst e1)
        (subst (list '= (list '* (list '+ c 1) '(- x y)) (list '- a b)))
        (subst (list '= (list '* (list '+ c2 1) '(- y z)) (list '- a2 b2)))
        (crs)))))
(qed 'vitali-d-trans)

;;; the points 1/(n + 1)
(define (mv-r n) (list 'recip (list '+ n 1)))
(define (mv-succ-facts! n)
  ;; (+ n 1) in RR, 0 < n + 1, not(n + 1 = 0), 1 <= n + 1
  (fact 'nn-in-rr n)
  (fact 'nn-zero-le n)
  (fact 'rr-one-in)
  (dk-type! (list '+ n 1))
  (dk-have! (list '< 0 (list '+ n 1)) (lambda () (dk-ineq! (list '<= 0 n))))
  (dk-have! (list '<= 1 (list '+ n 1)) (lambda () (dk-ineq! (list '<= 0 n))))
  (dk-have! (list 'NOT (list '= (list '+ n 1) 0))
    (lambda () (di) (dk-absurd! (list '= (list '+ n 1) 0) (list '<= 0 n)))))

(sp (make-wff (forall-guarded '(n) '((IN n NN))
  (list 'AND (list 'IN (mv-r 'n) 'RR) (list 'AND (list '< 0 (mv-r 'n)) (list '<= (mv-r 'n) 1))))))
(dk-peel!)
(mv-succ-facts! 'n)
(dk-have! '(AND (IN (+ n 1) RR) (NOT (= (+ n 1) 0))))
(fact 'rr-recip-closed '(+ n 1))
(fact 'rr-recip-pos '(+ n 1))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(fact 'rr-recip-one)
(dk-rewrite-h! (dk-apply! (dk-cite! 'rr-recip-antitone 1 '(+ n 1))) '(recip 1) 1)
(dk-conj-close! dk-ass!)
(qed 'vitali-recip-facts)

(sp (make-wff (forall-guarded '(i j) '((IN i NN) (IN j NN)) (mv-in-d (list '- (mv-r 'j) (mv-r 'i))))))
(dk-peel!)
(mv-succ-facts! 'i)
(mv-succ-facts! 'j)
(dk-split! (dk-apply! (dk-cite! 'vitali-recip-facts) 'i))
(dk-split! (dk-apply! (dk-cite! 'vitali-recip-facts) 'j))
(let* ((cc3 '(+ (* i j) (+ i j)))
       (ri (mv-r 'i)) (rj (mv-r 'j)))
  (dk-type! cc3 'NN)
  (dk-type! (list '- rj ri))
  (dk-have! '(AND (IN (+ i 1) RR) (NOT (= (+ i 1) 0))))
  (dk-have! '(AND (IN (+ j 1) RR) (NOT (= (+ j 1) 0))))
  (fact 'rr-recip-inverse '(+ i 1))
  (fact 'rr-recip-inverse '(+ j 1))
  (mv-d-close! (list '- rj ri) 'i 'j cc3
    (lambda ()
      (let ((e1 (list '= (list '* (list '+ cc3 1) (list '- rj ri))
                         (list '- (list '* '(+ i 1) (list '* '(+ j 1) rj)) (list '* '(+ j 1) (list '* '(+ i 1) ri))))))
        (dk-have! e1 (lambda () (dk-crs-opaque!)))
        (subst e1)
        (subst (list '= (list '* '(+ j 1) rj) 1))
        (subst (list '= (list '* '(+ i 1) ri) 1))
        (crs)))))
(qed 'vitali-recip-difference-in-d)

(sp (make-wff (forall-guarded '(i j) (list '(IN i NN) '(IN j NN) (list '= (mv-r 'i) (mv-r 'j))) '(= i j))))
(dk-peel!)
(mv-succ-facts! 'i)
(mv-succ-facts! 'j)
(let* ((e1 (dk-apply! (dk-cite! 'rr-recip-recip-pos '(+ i 1))))
       (e2 (dk-apply! (dk-cite! 'rr-recip-recip-pos '(+ j 1))))
       (e3 (dk-rewrite-h! e1 (mv-r 'i) (mv-r 'j)))
       (e4 (dk-rewrite-h! e3 (list 'recip (mv-r 'j)) '(+ j 1))))
  (dk-ineq! e4))
(qed 'vitali-recip-injective)

;;; the classes of the equivalence, cut to [0, 1], and the choice set H
(define mv-i '(CCINT 0 1))
(define (mv-cls x) (list 'SEP 'mvy_ mv-i (list 'IN (list '- 'mvy_ x) mv-d)))
(define mv-h (list 'SEP 'mvh_ mv-i (list 'FORSOME 'mvx_ (list 'AND (list 'IN 'mvx_ mv-i) (list '= 'mvh_ (list 'CHOICE (mv-cls 'mvx_)))))))
(define (mv-ch x) (list 'CHOICE (mv-cls x)))

(sp (make-wff (forall-guarded '(x1 x2) (list '(IN x1 RR) '(IN x2 RR) (mv-in-d '(- x1 x2))) (list '= (mv-cls 'x1) (mv-cls 'x2)))))
(dk-peel!)
(dk-apply! (dk-cite! 'vitali-d-symm 'x2 'x1))
(ma-ext2! (mv-cls 'x1) (mv-cls 'x2)
  (lambda (y)
    (ma-sep-parts! (list 'IN y (mv-cls 'x1)))
    (fact 'ccint-elt-in-rr 0 1 y)
    (dk-apply! (dk-cite! 'vitali-d-trans y 'x1 'x2))
    (in-sep! dk-ass! dk-ass!))
  (lambda (y)
    (ma-sep-parts! (list 'IN y (mv-cls 'x2)))
    (fact 'ccint-elt-in-rr 0 1 y)
    (dk-apply! (dk-cite! 'vitali-d-trans y 'x2 'x1))
    (in-sep! dk-ass! dk-ass!)))
(ass)
(qed 'vitali-class-eq)

(sp (make-wff (forall-guarded '(x) (list (list 'IN 'x mv-i))
  (list 'AND (list 'IN (mv-ch 'x) mv-i) (list 'AND (mv-in-d (list '- (mv-ch 'x) 'x)) (list 'IN (mv-ch 'x) mv-h))))))
(dk-peel!)
(fact 'ccint-elt-in-rr 0 1 'x)
(dk-apply! (dk-cite! 'vitali-d-refl 'x))
(dk-have! (list 'IN 'x (mv-cls 'x)) (lambda () (in-sep! dk-ass! dk-ass!)))
(dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ (mv-cls 'x))) (lambda () (ew 'x) (ass)))
(fact 'choice-axiom (mv-cls 'x))
(ma-sep-parts! (list 'IN (mv-ch 'x) (mv-cls 'x)))
(dk-have! (list 'IN (mv-ch 'x) mv-h)
  (lambda ()
    (in-sep! dk-ass!
      (lambda () (ew 'x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
(dk-conj-close! dk-ass!)
(qed 'vitali-choice)

(define (mv-e m) (list '* (list 'recip (list '+ (list 'nnsnd (list 'nnsnd m)) 1)) (list '- (list 'nnfst m) (list 'nnfst (list 'nnsnd m)))))
;;; D is enumerated by NN through mv-e: nn-fractions-enumerated (theorem-library/qq-countable.scm)

;;; a series of nonnegative terms all equal to one positive real is not finite
(sp (make-wff (forall-guarded '(f) '((IN f (FUN NN RR-POS-STAR)))
  (forall-guarded '(c) (list '(IN c RR) '(< 0 c) '(FORALL mvk_ (IMPLIES (IN mvk_ NN) (= (f mvk_) c))))
    '(NOT (IN (ESUM f) RR))))))
(dk-peel!)
(di)
(fact 'rr-pos-rr-of-lt 'c)
(let* ((d (dk-halve! 'c))
       (ex (dk-apply! (dk-cite! 'esum-nn-tail-small 'f) d))
       (n (dk-skolem! ex))
       (cf '(FORALL mvk_ (IMPLIES (IN mvk_ NN) (= (f mvk_) c)))))
  (dk-have! (list 'FORALL 'mvj_ (list 'IMPLIES '(IN mvj_ NN) (list '<= '(f mvj_) (list 'f (list '+ n 'mvj_)))))
    (lambda ()
      (let ((j (dk-di-var!)))
        (dk-have! (list 'AND (list 'IN n 'NN) (list 'IN j 'NN)))
        (fact 'nn-add-closed n j)
        (dk-apply! (dk-ctx-form cf) j)
        (dk-apply! (dk-ctx-form cf) (list '+ n j))
        (subst (list '= (list 'f j) 'c))
        (subst (list '= (list 'f (list '+ n j)) 'c))
        (dk-ineq!))))
  (let* ((all-g (find-first (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'ESUM))) (dk-asms)))
         (le1 (dk-apply! all-g 'f)))
    (fact 'nn-zero-in)
    (dk-apply! (dk-ctx-form cf) 0)
    (let ((le2 (dk-rewrite-h! (dk-cite! 'esum-nn-term-le 'f 0) '(f 0) 'c)))
      (dk-absurd! le1 le2 (list '= (list '+ d d) 'c) (list '< 0 d)))))
(qed 'esum-constant-positive-not-finite)

(sp (make-wff '(FORALL es (FORALL c (IN (TRANSLATE es c) (POWER RR))))))
(dk-peel!)
(fact 'rr-is-set)
(fact 'translate-subset-rr 'es 'c)
(fact 'subclass-of-set-is-set '(TRANSLATE es c) 'RR)
(dk-have! '(FORALL z_ (IMPLIES (IN z_ (TRANSLATE es c)) (IN z_ RR)))
  (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd '(TRANSLATE es c) 'RR z) (ass))))
(dk-apply! (dk-cite! 'power-mem-intro 'RR '(TRANSLATE es c)))
(ass)
(qed 'translate-in-power-rr)

;;; the two cases of the proof: mu(H) = 0 and 0 < mu(H)
(define mv-inv '(FORALL mves_ (IMPLIES (IN mves_ (POWER RR)) (FORALL mvt_ (IMPLIES (IN mvt_ RR) (= (mu (TRANSLATE mves_ mvt_)) (mu mves_)))))))
(define mv-meas '(IS-MEASURE RR (POWER RR) mu))
(define mv-add (forall-guarded '(f_)
                 (list '(IN f_ (FUN NN (POWER RR)))
                       (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
                         '(= (INTERSECTION (f_ i_) (f_ j_)) EMPTY-SET)))
                 '(= (mu (BIG-UNION n_ NN (f_ n_))) (ESUM (VNB-LAMBDA n_ NN (mu (f_ n_)))))))
;;; (IN t (POWER RR)) from (SUBSET t RR) in context
(define (mv-pow! t)
  (dk-have! (list 'IN t '(POWER RR))
    (lambda ()
      (fact 'subclass-of-set-is-set t 'RR)
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ t) '(IN z_ RR)))
        (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd t 'RR z) (ass))))
      (dk-apply! (dk-cite! 'power-mem-intro 'RR t))
      (ass))))
(define (mv-setup!)
  (dk-project! '(IS-SIGMA-ALGEBRA RR (POWER RR)) 'is-measure mv-meas)
  (dk-project! '(IN mu (FUN (POWER RR) RR-POS-STAR)) 'is-measure mv-meas)
  (fact 'rr-is-set)
  (fact 'power-set 'RR)
  (fact 'zero-in-rr-pos-star)
  (fact 'rr-zero-in)
  (fact 'rr-one-in)
  (dk-have! (list 'SUBSET mv-i 'RR)
    (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (fact 'ccint-elt-in-rr 0 1 z) (ass))))
  (ma-sep-subset! mv-h)
  (fact 'subset-trans mv-h mv-i 'RR)
  (mv-pow! mv-i)
  (mv-pow! mv-h)
  (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR mv-i)
  (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR mv-h))
;;; z in TRANSLATE(es, c): land z in RR and z - c in es
(define (mv-tr-open! z es c) (ma-iff-parts! (dk-cite! 'translate-membership es c z)))

;;; mu(H) = 0 is impossible: the translates of H by D cover [0, 1]
(sp (make-wff (forall-guarded '(mu) (list mv-meas mv-inv (list '< 0 (list 'mu mv-i)))
  (list 'NOT (list '= (list 'mu mv-h) 0)))))
(dk-peel!)
(di)
(mv-setup!)
(let* ((e-type! (lambda (m)
                  (let* ((p (list 'nnsnd m)) (c (list 'nnsnd p)) (a (list 'nnfst m)) (b (list 'nnfst p)))
                    (fact 'nnsnd-type m) (fact 'nnsnd-type p) (fact 'nnfst-type m) (fact 'nnfst-type p)
                    (fact 'nn-in-rr a) (fact 'nn-in-rr b)
                    (dk-split! (dk-apply! (dk-cite! 'vitali-recip-facts) c))
                    (dk-type! (list '- a b))
                    (dk-have! (list 'AND (list 'IN (mv-r c) 'RR) (list 'IN (list '- a b) 'RR)))
                    (fact 'rr-mul-closed (mv-r c) (list '- a b)))))
       (gr (ma-abstract! 'NN '(POWER RR) (lambda (m) (list 'TRANSLATE mv-h (mv-e m)))
             (lambda (m) (e-type! m) (fact 'translate-in-power-rr mv-h (mv-e m)) (ass))
             (lambda (m) (e-type! m))))
       (tt (car gr)) (ve (cdr gr))
       (tk! (lambda (k) (fact 'fun-apply-type-c tt 'NN '(POWER RR) k) (dk-apply! ve k)))
       (uu (list 'BIG-UNION 'n_ 'NN (list tt 'n_)))
       (ll (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list tt 'n_)))))
  (fact 'sigma-algebra-union-closed 'RR '(POWER RR) tt)
  (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR uu)
  ;; [0, 1] is covered
  (dk-have! (list 'SUBSET mv-i uu)
    (lambda ()
      (mac 'subset-def)
      (let* ((x (dk-di-var!)) (ch (mv-ch x)))
        (dk-split-all! (list (dk-apply! (dk-cite! 'vitali-choice) x)))
        (fact 'ccint-elt-in-rr 0 1 x)
        (fact 'ccint-elt-in-rr 0 1 ch)
        (dk-apply! (dk-cite! 'vitali-d-symm x ch))
        (let ((m (dk-skolem! (dk-apply! (dk-cite! 'nn-fractions-enumerated) (list '- x ch)))))
          (tk! m)
          (dk-have! (list 'IN x (list tt m))
            (lambda ()
              (subst (list '== (list tt m) (list 'TRANSLATE mv-h (mv-e m))))
              (subst (list '= (mv-e m) (list '- x ch)))
              (mac 'translate-membership)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (dk-have! (list '= (list '- x (list '- x ch)) ch) (lambda () (dk-ineq!)))
                             (subst (list '= (list '- x (list '- x ch)) ch)) (ass)))))))
          (ma-bu-close! m)))))
  (dk-apply! (dk-cite! 'measure-monotone 'RR '(POWER RR) 'mu mv-i uu))
  (dk-apply! (dk-cite! 'measure-countably-subadditive 'RR '(POWER RR) 'mu tt))
  ;; the bound is 0
  (dk-have! (list 'IN ll '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (tk! k) (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR (list tt k)) (ass)))
                    (lambda () (fact 'nn-is-set) (ass)))))
  (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list ll 'ozn) 0)))
    (lambda ()
      (let ((k (dk-di-var!)))
        (tk! k)
        (e-type! k)
        (dk-lam-b!)
        (subst (list '== (list tt k) (list 'TRANSLATE mv-h (mv-e k))))
        (dk-apply! (dk-ctx-form mv-inv) mv-h (mv-e k))
        (subst (list '= (list 'mu (list 'TRANSLATE mv-h (mv-e k))) (list 'mu mv-h)))
        (ass))))
  (dk-apply! (dk-cite! 'esum-nn-zero ll))
  (let* ((le (dk-rewrite-h! (list '<= (list 'mu uu) (list 'ESUM ll)) (list 'ESUM ll) 0))
         (lt1 (dk-apply! (dk-cite! 'rps-lt-le-trans 0 (list 'mu mv-i) (list 'mu uu))))
         (lt2 (dk-apply! (dk-cite! 'rps-lt-le-trans 0 (list 'mu uu) 0))))
    (dk-cite! 'rr-lt-irrefl 0)
    (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0))))))
(qed 'vitali-null-case)

;;; 0 < mu(H) is impossible: the translates of H by 1/(n + 1) are disjoint and lie in [0, 1] u ([0, 1] + 1)
(sp (make-wff (forall-guarded '(mu) (list mv-meas mv-inv (list 'IN (list 'mu mv-i) 'RR))
  (list 'NOT (list '< 0 (list 'mu mv-h))))))
(dk-peel!)
(di)
(mv-setup!)
(let* ((r-facts! (lambda (n) (dk-split-all! (list (dk-apply! (dk-cite! 'vitali-recip-facts) n)))))
       (gr (ma-abstract! 'NN '(POWER RR) (lambda (n) (list 'TRANSLATE mv-h (mv-r n)))
             (lambda (n) (r-facts! n) (fact 'translate-in-power-rr mv-h (mv-r n)) (ass))
             (lambda (n) (r-facts! n))))
       (ss (car gr)) (ve (cdr gr))
       (sk! (lambda (k) (r-facts! k) (fact 'fun-apply-type-c ss 'NN '(POWER RR) k) (dk-apply! ve k)))
       ;; z in S(k): land z in RR and z - r(k) in H
       (s-open! (lambda (z k)
                  (sk! k)
                  (let ((h (dk-rewrite-h! (list 'IN z (list ss k)) (list ss k) (list 'TRANSLATE mv-h (mv-r k)))))
                    (mv-tr-open! z mv-h (mv-r k)))))
       (uu (list 'BIG-UNION 'n_ 'NN (list ss 'n_)))
       (i1 (list 'TRANSLATE mv-i 1))
       (ww (list 'UNION mv-i i1))
       (ll (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list ss 'n_))))
       (sdisj (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
                (list '= (list 'INTERSECTION (list ss 'i_) (list ss 'j_)) 'EMPTY-SET))))
  ;; the translates are pairwise disjoint
  (dk-have! sdisj
    (lambda ()
      (let* ((ls (dk-peel!)) (ne (cadr (find-first (lambda (f) (dk-head-is? f 'NOT)) ls)))
             (i (cadr ne)) (j (caddr ne)))
        (ma-ext2! (list 'INTERSECTION (list ss i) (list ss j)) 'EMPTY-SET
          (lambda (z)
            (ma-iff-parts! (dk-cite! 'intersection-membership (list ss i) (list ss j) z))
            (s-open! z i)
            (s-open! z j)
            (let* ((side (lambda (k)
                           ;; z - r(k) = CHOICE(cls x) with x in [0, 1]; land (z - r(k)) - x in D; return x
                           (let* ((hz (list '- z (mv-r k)))
                                  (ex (ma-sep-parts! (list 'IN hz mv-h)))
                                  (x (dk-skolem! ex)))
                             (dk-type! hz)
                             (fact 'ccint-elt-in-rr 0 1 x)
                             (dk-split-all! (list (dk-apply! (dk-cite! 'vitali-choice) x)))
                             (dk-rewrite-h! (mv-in-d (list '- (mv-ch x) x)) (mv-ch x) hz)
                             x)))
                   (x1 (side i)) (x2 (side j))
                   (hi (list '- z (mv-r i))) (hj (list '- z (mv-r j))))
              (dk-apply! (dk-cite! 'vitali-d-symm x1 hi))
              (dk-apply! (dk-cite! 'vitali-recip-difference-in-d) i j)
              (dk-have! (list '= (list '- (mv-r j) (mv-r i)) (list '- hi hj)) (lambda () (dk-ineq!)))
              (dk-rewrite-h! (mv-in-d (list '- (mv-r j) (mv-r i))) (list '- (mv-r j) (mv-r i)) (list '- hi hj))
              (dk-apply! (dk-cite! 'vitali-d-trans x1 hi hj))
              (dk-apply! (dk-cite! 'vitali-d-trans x1 hj x2))
              (dk-apply! (dk-cite! 'vitali-class-eq x1 x2))
              (let* ((e1 (dk-rewrite-h! (list '= hi (mv-ch x1)) (mv-cls x1) (mv-cls x2)))
                     (e2 (dk-rewrite-h! e1 (mv-ch x2) hj)))
                (dk-have! (list '= (mv-r i) (mv-r j)) (lambda () (dk-ineq! e2)))
                (dk-apply! (dk-cite! 'vitali-recip-injective i j))
                (ma-prop-with! (list (list '= i j) (list 'NOT (list '= i j)))))))
          (lambda (z)
            (dk-cite! 'empty-set-has-no-members z)
            (ma-prop-with! (list (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET))))))
        (ass))))
  ;; the union lies in [0, 1] u ([0, 1] + 1), of finite measure
  (fact 'sigma-algebra-union-closed 'RR '(POWER RR) ss)
  (fact 'translate-in-power-rr mv-i 1)
  (dk-apply! (dk-ctx-form mv-inv) mv-i 1)
  (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR i1)
  (dk-have! (list 'IN (list 'mu i1) 'RR) (lambda () (subst (list '= (list 'mu i1) (list 'mu mv-i))) (ass)))
  (dk-apply! (dk-cite! 'measure-union-finite 'RR '(POWER RR) 'mu mv-i i1))
  (dk-have! (list 'SUBSET ww 'RR)
    (lambda ()
      (mac 'subset-def)
      (let* ((z (dk-di-var!))
             (or1 (car (ma-iff-parts! (dk-cite! 'union-membership mv-i i1 z)))))
        (ma-or-split! or1
          (list (lambda () (fact 'ccint-elt-in-rr 0 1 z) (ass))
                (lambda () (ma-then-ass! (lambda () (mv-tr-open! z mv-i 1)))))))))
  (mv-pow! ww)
  (dk-have! (list 'SUBSET uu ww)
    (lambda ()
      (mac 'subset-def)
      (let* ((z (dk-di-var!)) (r (ma-bu-open! z uu)) (k (car r)) (rk (mv-r k)))
        (s-open! z k)
        (ma-sep-parts! (list 'IN (list '- z rk) mv-h))
        (ma-iff-parts! (dk-cite! 'ccint-membership 0 1 (list '- z rk)))
        (dk-have! (list 'AND (list 'IN z 'RR) '(IN 1 RR)))
        (ma-or-split! (dk-cite! 'rr-leq-total z 1)
          (list
            (lambda ()
              (dk-have! (list 'IN z mv-i)
                (lambda ()
                  (mac 'ccint-membership)
                  (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! (list '<= 0 (list '- z rk)) (list '< 0 rk)))))))
              (ma-in-union-left! z mv-i i1))
            (lambda ()
              (dk-type! (list '- z 1))
              (dk-have! (list 'IN (list '- z 1) mv-i)
                (lambda ()
                  (mac 'ccint-membership)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (dk-ineq! (list '<= 1 z) (list '<= (list '- z rk) 1) (list '<= rk 1)))))))
              (dk-have! (list 'IN z i1) (lambda () (mac 'translate-membership) (dk-conj-close! dk-ass!)))
              (ma-in-union-right! z mv-i i1)))))))
  (dk-apply! (dk-cite! 'measure-finite-subset 'RR '(POWER RR) 'mu uu ww))
  ;; countable additivity along the translates
  (let ((e1 (dk-apply! (dk-project! mv-add 'is-measure mv-meas) ss)))
    (dk-have! (list 'IN (list 'ESUM ll) 'RR) (lambda () (subst (list '= (caddr e1) (cadr e1))) (ass))))
  (dk-have! (list 'IN ll '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (sk! k) (fact 'fun-apply-type-c 'mu '(POWER RR) 'RR-POS-STAR (list ss k)) (ass)))
                    (lambda () (fact 'nn-is-set) (ass)))))
  (fact 'rr-pos-star-nonneg (list 'mu mv-h))
  (dk-apply! (dk-cite! 'measure-monotone 'RR '(POWER RR) 'mu mv-h mv-i))
  (dk-apply! (dk-cite! 'measure-finite-subset 'RR '(POWER RR) 'mu mv-h mv-i))
  (dk-have! (list 'FORALL 'mvk_ (list 'IMPLIES '(IN mvk_ NN) (list '= (list ll 'mvk_) (list 'mu mv-h))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (sk! k)
        (dk-lam-b!)
        (subst (list '== (list ss k) (list 'TRANSLATE mv-h (mv-r k))))
        (dk-apply! (dk-ctx-form mv-inv) mv-h (mv-r k))
        (ass))))
  (let ((nf (dk-apply! (dk-cite! 'esum-constant-positive-not-finite ll) (list 'mu mv-h))))
    (ma-prop-with! (list nf (list 'IN (list 'ESUM ll) 'RR)))))
(qed 'vitali-positive-case)

(sp (make-wff (forall-guarded '(mu) (list mv-meas (list 'IN (list 'mu mv-i) 'RR))
  (list 'AND (list 'IN (list 'mu mv-h) 'RR) (list '<= 0 (list 'mu mv-h))))))
(dk-peel!)
(mv-setup!)
(fact 'rr-pos-star-nonneg (list 'mu mv-h))
(dk-apply! (dk-cite! 'measure-monotone 'RR '(POWER RR) 'mu mv-h mv-i))
(dk-apply! (dk-cite! 'measure-finite-subset 'RR '(POWER RR) 'mu mv-h mv-i))
(dk-conj-close! dk-ass!)
(qed 'vitali-choice-set-finite)

;;; PROP. 1.23: no translation-invariant countably additive measure on all subsets of R gives [0, 1] a
;;; finite positive measure
(sp (make-wff (list 'NOT (list 'FORSOME 'mu
  (list 'AND mv-meas (list 'AND mv-inv (list 'AND (list '< 0 (list 'mu mv-i)) (list 'IN (list 'mu mv-i) 'RR))))))))
(di)
(let* ((ex (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) (dk-asms))))
       (v (dk-skolem! ex))
       (vh (list v mv-h)))
  (dk-split-all! (list (dk-apply! (dk-cite! 'vitali-choice-set-finite) v)))
  (dk-have! (list 'AND '(IN 0 RR) (list 'IN vh 'RR)) (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (fact 'rr-zero-in) (ass)))))))
  (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 vh))
    (list
      (lambda ()
        (let ((n1 (dk-apply! (dk-cite! 'vitali-positive-case) v)))
          (ma-prop-with! (list n1 (list '< 0 vh)))))
      (lambda ()
        (let ((n2 (dk-apply! (dk-cite! 'vitali-null-case) v)))
          (dk-have! (list '= vh 0) (lambda () (subst (list '= vh 0)) (fact 'rr-zero-in) (rfl)))
          (ma-prop-with! (list n2 (list '= vh 0))))))))
