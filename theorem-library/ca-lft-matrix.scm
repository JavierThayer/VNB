;;; ca-lft-matrix.scm -- Prop. 1.18 of complex-analysis.pdf in matrix form: S |-> L_S from the
;;; invertible 2-by-2 complex matrices onto the linear fractional transformations is a surjective
;;; homomorphism whose kernel is the scalar multiples of the identity.
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;; Cites theorem-library/ca1-matrix-rep.scm (mat22-literal-in-mat, mat22-ext).
;;;
;;; The matrices are over the ring the tree already has for CC,
;;; NORMED-FIELD-AS-COMMUTATIVE-RING(CC-NORMED-FIELD), written R below.
;;;
;;;   cc-matmul-2x2-entry      (S T)_ik = S_i1 T_1k + S_i2 T_2k over R
;;;   cc-det-2x2               det S = S_11 S_22 - S_12 S_21
;;;   cc-mat22-entries         the four entries of the literal [[a, b], [c, d]]
;;;   cc-invertible-mat-is-mat, cc-invertible-det-nonzero, cc-det-nonzero-invertible
;;;   mat-lft-literal          L_[[a,b],[c,d]] = LFT(a, b, c, d)
;;;   mat-lft-in-lfts          L_S is a linear fractional transformation         (Prop. 1.18)
;;;   mat-lft-hom              L_(ST) = L_S o L_T                                 (Prop. 1.18)
;;;   mat-lft-onto             every LFT is some L_S                              (Prop. 1.18)
;;;   mat-lft-kernel           L_S = id iff S = [[r, 0], [0, r]] for some r      (Prop. 1.18)
;;;
;;; Helper prefix clm-.

(define clm-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))

(define (clm-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))

(define (clm-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))

(define (clm-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))

(define (clm-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring clm-r))

;;; (IN t (MAT 2 2 CC)) in context  |-  (IN t (MAT 2 2 (CARR R))).
(define (clm-mat-carr! t)
  (let ((f (list 'IN t (list 'MAT 2 2 (list 'CARR clm-r)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (mac 'cc-scalar-ring-carr) (from-context!))))
    f))

;;; (IN t (MAT 2 2 (CARR R))) in context  |-  (IN t (MAT 2 2 CC)).
(define (clm-mat-cc! t)
  (let ((f (list 'IN t '(MAT 2 2 CC))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (fact 'cc-scalar-ring-carr)
                               (subst (list '= 'CC (list 'CARR clm-r))) (from-context!))))
    f))

(define (clm-interval-parts! v)
  (fact 'interval-elt-in-nn 1 2 v)
  (fact 'interval-lo 1 2 v)
  (fact 'interval-hi 1 2 v))

(define (clm-in-12! k)
  (let ((f (list 'IN k '(INTERVAL 1 2))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
                      (dk-have! (list 'IN k 'NN) (lambda () (arith)))
                      (dk-have! (list '<= 1 k) (lambda () (arith)))
                      (dk-have! (list '<= k 2) (lambda () (arith)))
                      (dk-cite! 'interval-mem-intro 1 2 k)
                      (from-context!))))
    f))

(define (clm-has-lit-nth? t)
  (and (pair? t)
       (or (and (eq? (car t) 'NTH) (pair? (cdr t)) (pair? (cddr t)) (pair? (caddr t)) (eq? (car (caddr t)) 'LIST))
           (any-pred clm-has-lit-nth? t))))

;;; ---------------------------------------------------------------------------
;;; The product entry over R (the proof of rr-matmul-2x2-entry, ca1-matrix-rep.scm, over CC).

(sp (make-wff `(FORALL p (IMPLIES (IN p (MAT 2 2 CC)) (FORALL q (IMPLIES (IN q (MAT 2 2 CC))
      (FORALL i (IMPLIES (IN i (INTERVAL 1 2)) (FORALL k (IMPLIES (IN k (INTERVAL 1 2))
        (= (ENTRY (MATMUL ,clm-r p q) i k)
           (+ (* (ENTRY p i 1) (ENTRY q 1 k)) (* (ENTRY p i 2) (ENTRY q 2 k))))))))))))))
(dk-peel!)
(clm-ring!)
(clm-mat-carr! 'p)
(clm-mat-carr! 'q)
(dk-have! '(<= 1 2) (lambda () (arith)))
(dk-have! '(IN 1 NN) (lambda () (arith)))
(dk-have! '(IN 2 NN) (lambda () (arith)))
(clm-in-12! 1)
(clm-in-12! 2)
(define clm-me (dk-cite! 'matmul-entry clm-r 2 2 2 'p 'q 'i 'k))
(subst clm-me)
(define clm-ag (list 'RING-ADDITIVE-AG clm-r))
(define clm-f (caddr (caddr clm-me)))
(dk-cite! 'matprod-summand-type clm-r 2 2 2 'p 'q 'i 'k)
(dk-cite! 'ring-additive-ag-is-abelian-group clm-r)
(fact 'interval-in-set 1 2)
(dk-cite! 'interval-card-in-nn 1 2)
(dk-have! '(NOT (= 1 2)) (lambda () (arith)))
(dk-cite! 'finsum-two-support clm-ag '(INTERVAL 1 2) clm-f 1 2)
(let* ((imp (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IMPLIES) (pair? (caddr f)) (eq? (car (caddr f)) '=)
                                         (pair? (cadr (caddr f))) (eq? (car (cadr (caddr f))) 'FINSUM)
                                         (pair? (cadr f)) (eq? (car (cadr f)) 'FORALL)))
                        (dk-asms)))
       (clause (if imp (cadr imp) (error "cc-matmul-2x2-entry: finsum-two-support did not land"))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (v (cadr (find-first (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) '(INTERVAL 1 2)))) lk))))
        (clm-interval-parts! v)
        (fact 'ms-index-2 v)
        (keep (list 'OR (list '= v 1) (list '= v 2)) (list 'NOT (list '= v 1)) (list 'NOT (list '= v 2)))
        (prop))))
  (detach! imp)
  (subst (caddr imp)))
(subst (dk-cite! 'ras-op clm-r))
(dk-lam-b!)
(for-each (lambda (e) (dk-cite! 'entry-in-carrier 2 2 'CC (car e) (cadr e) (caddr e)))
          '((p i 1) (q 1 k) (p i 2) (q 2 k)))
(clm-type! '(* (ENTRY p i 1) (ENTRY q 1 k)))
(clm-type! '(* (ENTRY p i 2) (ENTRY q 2 k)))
(mac 'cc-scalar-ring-add)
(mac 'cc-scalar-ring-mul)
(dk-lam-b!)
(clm-finish!)
(qed 'cc-matmul-2x2-entry)

;;; det S = S_11 S_22 - S_12 S_21.
(sp (make-wff `(FORALL s (IMPLIES (IN s (MAT 2 2 CC))
      (= (DET ,clm-r 2 s) (- (* (ENTRY s 1 1) (ENTRY s 2 2)) (* (ENTRY s 1 2) (ENTRY s 2 1))))))))
(let ((s (car (map cadr (dk-peel!)))))
  (clm-ring!)
  (clm-mat-carr! s)
  (clm-in-12! 1) (clm-in-12! 2)
  (subst (dk-cite! 'det-2x2 clm-r s))
  (for-each (lambda (e) (dk-cite! 'entry-in-carrier 2 2 'CC s (car e) (cadr e)))
            '((1 1) (2 2) (1 2) (2 1)))
  (let ((m1 (list '* (list 'ENTRY s 1 1) (list 'ENTRY s 2 2)))
        (m2 (list '* (list 'ENTRY s 1 2) (list 'ENTRY s 2 1))))
    (clm-type! m1) (clm-type! m2) (clm-type! (list '- m2))
    (mac 'cc-scalar-ring-add)
    (mac 'cc-scalar-ring-mul)
    (mac 'cc-scalar-ring-neg)
    (dk-lam-b!)
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs))))
(qed 'cc-det-2x2)

;;; The entries of a literal 2-by-2 matrix.
(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], entry([[a, b], [c, d]], 1, 1) = a and entry([[a, b], [c, d]], 1, 2) = b and entry([[a, b], [c, d]], 2, 1) = c and entry([[a, b], [c, d]], 2, 2) = d)"))
(dk-peel!)
(dk-conj-close!
  (lambda ()
    (let ((leaf (proof-state-focus *ps*)))
      (mac 'ENTRY)
      (let loop ((n 4))
        (if (and (> n 0) (not (sequent-node-grounded? leaf)) (clm-has-lit-nth? (dk-goal)))
            (begin (nth-r) (loop (- n 1)))))
      (if (not (sequent-node-grounded? leaf)) (rfl)))))
(qed 'cc-mat22-entries)

;;; ---------------------------------------------------------------------------
;;; Invertibility and the determinant.

(define (clm-ents s) (list (list 'ENTRY s 1 1) (list 'ENTRY s 1 2) (list 'ENTRY s 2 1) (list 'ENTRY s 2 2)))
(define (clm-det-of s)
  (list '- (list '* (list 'ENTRY s 1 1) (list 'ENTRY s 2 2)) (list '* (list 'ENTRY s 1 2) (list 'ENTRY s 2 1))))
(define (clm-type-entries! s)           ; s in MAT(2,2,CC) in context
  (clm-in-12! 1) (clm-in-12! 2)
  (for-each (lambda (e) (dk-cite! 'entry-in-carrier 2 2 'CC s (caddr e) (cadddr e))) (clm-ents s))
  (clm-type! (clm-det-of s)))

(define clm-inv-of (lambda (s) (list 'IS-INVERTIBLE-MAT clm-r 2 s)))

(sp (make-wff `(FORALL s (IMPLIES ,(clm-inv-of 's) (IN s (MAT 2 2 CC))))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (dk-cite! 'invertible-mat-is-mat clm-r 2 s)
  (clm-mat-cc! s)
  (clm-finish-ass!))
(qed 'cc-invertible-mat-is-mat)

(sp (make-wff `(FORALL s (IMPLIES ,(clm-inv-of 's) (NOT (= ,(clm-det-of 's) 0))))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (dk-cite! 'cc-invertible-mat-is-mat s)
  (clm-ring!)
  (clm-mat-carr! s)
  (clm-type-entries! s)
  (let* ((iff (dk-cite! 'is-invertible-mat clm-r 2 s))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-only! iff (clm-inv-of s)) (prop)))
    (let* ((v (dk-skolem! rhs))
           (ds (list 'DET clm-r 2 s))
           (dv (list 'DET clm-r 2 v)))
      (clm-mat-cc! v)
      (dk-have! '(IN 2 NN) (lambda () (arith)))
      (dk-cite! 'det-in-carrier clm-r 2 s)
      (dk-cite! 'det-in-carrier clm-r 2 v)
      (dk-have! (list 'IN ds 'CC) (lambda () (fact 'cc-scalar-ring-carr) (subst (list '= 'CC (list 'CARR clm-r))) (clm-finish-ass!)))
      (dk-have! (list 'IN dv 'CC) (lambda () (fact 'cc-scalar-ring-carr) (subst (list '= 'CC (list 'CARR clm-r))) (clm-finish-ass!)))
      (dk-cite! 'det-identity-ind clm-r 2)
      (let* ((e1 (dk-cite! 'det-multiplicative clm-r 2 s v))
             (e2 (dk-rewrite-h! e1 (list 'MATMUL clm-r s v) (list 'IDENTMAT clm-r 2)))
             (e3 (dk-rewrite-h! e2 (list 'DET clm-r 2 (list 'IDENTMAT clm-r 2)) (list 'ONE clm-r))))
        (clm-type! (list '* ds dv))
        (dk-have! (list '= (list 'ONE clm-r) 1) (lambda () (mac 'cc-scalar-ring-one) (rfl)))
        (dk-have! (list '= 1 (list '* ds dv))
          (lambda ()
            (dk-have! (list '= (list (list 'MUL clm-r) ds dv) (list '* ds dv))
              (lambda () (mac 'cc-scalar-ring-mul) (dk-lam-b!) (clm-finish!)))
            (subst (list '= (list '* ds dv) (list (list 'MUL clm-r) ds dv)))
            (subst (list '= 1 (list 'ONE clm-r)))
            (clm-finish-ass!)))
        (dk-cite! 'cc-det-2x2 s)
        (subst (list '= (clm-det-of s) ds))
        (di)
        (let* ((f1 (dk-rewrite-h! (list '= 1 (list '* ds dv)) ds 0)))
          (dk-have! (list '= (list '* 0 dv) 0) (lambda () (crs)))
          (dk-rewrite-h! f1 (list '* 0 dv) 0)
          (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
          (dk-only! '(= 1 0) '(NOT (= 1 0)))
          (prop))))))
(qed 'cc-invertible-det-nonzero)

;;; det S /= 0 makes S invertible: the inverse is (1/det) [[S_22, -S_12], [-S_21, S_11]].
(define (clm-lit-entries! m)            ; m a literal 2x2 with CC-typed entries: land and split its entries
  (let* ((a (cadr (cadr m))) (b (caddr (cadr m))) (c (cadr (caddr m))) (d (caddr (caddr m))))
    (dk-split-all! (list (dk-cite! 'cc-mat22-entries a b c d)))))

(define (clm-subst-entry-eqs!)          ; rewrite every ENTRY of the goal that the context equates
  (let loop ((fuel 40))
    (let ((eq (find-first (lambda (h) (and (dk-head-is? h '=) (dk-head-is? (cadr h) 'ENTRY)
                                           (not (dk-head-is? (caddr h) 'ENTRY))
                                           (dk-contains? (dk-goal) (cadr h))))
                          (dk-asms))))
      (if (and eq (> fuel 0))
          (begin (subst eq) (loop (- fuel 1)))))))

;;; (= (ENTRY (MATMUL R p q) i j) (ENTRY (IDENTMAT R 2) i j)) for literal i, j; DT * K = 1 in context.
(define (clm-prod-entry! p q i j dt k)
  (let ((goal (list '= (list 'ENTRY (list 'MATMUL clm-r p q) i j) (list 'ENTRY (list 'IDENTMAT clm-r 2) i j))))
    (dk-have! goal
      (lambda ()
        (subst (dk-cite! 'cc-matmul-2x2-entry p q i j))
        (if (= i j)
            (subst (dk-cite! 'identmat-entry-diag clm-r 2 i))
            (begin (dk-have! (list 'NOT (list '= i j)) (lambda () (arith)))
                   (subst (dk-cite! 'identmat-entry-off clm-r 2 i j))))
        (if (= i j) (mac 'cc-scalar-ring-one) (mac 'cc-scalar-ring-zero))
        (clm-subst-entry-eqs!)
        (if (= i j)
            (let ((lhs (cadr (dk-goal))))
              (dk-have! (list '= lhs (list '* dt k)) (lambda () (crs)))
              (subst (list '= lhs (list '* dt k)))
              (subst (list '= (list '* dt k) 1))
              (clm-finish!))
            (crs))))))

(define (clm-prod-ident! p q dt k)      ; (= (MATMUL R p q) (IDENTMAT R 2)), p, q in MAT(2,2,CC) typed
  (let ((pq (list 'MATMUL clm-r p q)) (id (list 'IDENTMAT clm-r 2)))
    (clm-mat-carr! p) (clm-mat-carr! q)
    (dk-have! '(IMPLIES (= 2 0) (OR (= 2 0) (= 2 0))) (lambda () (di) (prop)))
    (dk-cite! 'matmul-type clm-r 2 2 2 p q)
    (dk-cite! 'identmat-type clm-r 2)
    (clm-mat-cc! pq) (clm-mat-cc! id)
    (for-each (lambda (ij) (clm-prod-entry! p q (car ij) (cadr ij) dt k)) '((1 1) (1 2) (2 1) (2 2)))
    (dk-have! (list '= pq id) (lambda () (dk-cite! 'mat22-ext 'CC pq id) (clm-finish-ass!)))))

(define (clm-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (clm-conj (cdr fs)))))

(define (clm-cite-and! thm fs . terms)
  (let ((c (clm-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))

(sp (make-wff `(FORALL s (IMPLIES (IN s (MAT 2 2 CC)) (IMPLIES (NOT (= ,(clm-det-of 's) 0)) ,(clm-inv-of 's))))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (clm-ring!)
  (dk-have! '(IN 2 NN) (lambda () (arith)))
  (clm-type-entries! s)
  (let* ((dt (clm-det-of s))
         (e11 (list 'ENTRY s 1 1)) (e12 (list 'ENTRY s 1 2)) (e21 (list 'ENTRY s 2 1)) (e22 (list 'ENTRY s 2 2))
         (nz (list 'NOT (list '= dt 0))))
    (clm-cite-and! 'cc-recip-closed (list (list 'IN dt 'CC) nz) dt)
    (clm-cite-and! 'cc-recip-inverse (list (list 'IN dt 'CC) nz) dt)
    (let ((k (dk-name! (list 'recip dt) 'CC)))
      (dk-rewrite-h! (list '= (list '* dt (list 'recip dt)) 1) (list 'recip dt) k)
      (let* ((v11 (list '* e22 k)) (v12 (list '- (list '* e12 k)))
             (v21 (list '- (list '* e21 k))) (v22 (list '* e11 k))
             (vm  (list 'LIST (list 'LIST v11 v12) (list 'LIST v21 v22))))
        (for-each clm-type! (list v11 v12 v21 v22))
        (dk-cite! 'mat22-literal-in-mat 'CC v11 v12 v21 v22)
        (clm-lit-entries! vm)
        (clm-prod-ident! s vm dt k)
        (clm-prod-ident! vm s dt k)
        (clm-mat-carr! s) (clm-mat-carr! vm)
        (mac 'is-invertible-mat)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (begin (ew vm) (dk-conj-close! (lambda () (clm-finish-ass!))))
                (clm-finish-ass!))))))))
(qed 'cc-det-nonzero-invertible)

;;; ---------------------------------------------------------------------------
;;; Prop. 1.18.

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], mat-lft([[a, b], [c, d]]) = lft(a, b, c, d))"))
(let ((vs (map cadr (dk-peel!))))
  (apply dk-cite! 'lft-in-fun vs)
  (mac 'MAT-LFT)
  (clm-lit-entries! (list 'LIST (list 'LIST (car vs) (cadr vs)) (list 'LIST (caddr vs) (cadddr vs))))
  (clm-subst-entry-eqs!)
  (clm-finish!))
(qed 'mat-lft-literal)

;;; witnesses for a FORSOME / AND tower, in order; closers for the leaves
(define (clm-witnesses! ws)
  (ew (car ws))
  (dk-conj-close!
    (lambda ()
      (cond ((dk-head-is? (dk-goal) 'FORSOME) (clm-witnesses! (cdr ws)))
            (#t (clm-finish!))))))

;;; L_S is a linear fractional transformation.
(sp (make-wff `(FORALL s (IMPLIES ,(clm-inv-of 's) (IN (MAT-LFT s) LFTS)))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (dk-cite! 'cc-invertible-mat-is-mat s)
  (dk-cite! 'cc-invertible-det-nonzero s)
  (clm-type-entries! s)
  (apply dk-cite! 'lft-in-fun (clm-ents s))
  (mac 'MAT-LFT)
  (mac 'lfts-def)
  (in-sep! (lambda () (clm-finish-ass!)) (lambda () (clm-witnesses! (clm-ents s)))))
(qed 'mat-lft-in-lfts)

;;; L_(ST) = L_S o L_T.
(sp (make-wff `(FORALL s (IMPLIES ,(clm-inv-of 's) (FORALL t (IMPLIES ,(clm-inv-of 't)
      (= (MAT-LFT (MATMUL ,clm-r s t)) (COMPOSE (MAT-LFT s) (MAT-LFT t)))))))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (let ((t (cadddr (find-first (lambda (f) (and (dk-head-is? f 'IS-INVERTIBLE-MAT) (not (equal? (cadddr f) s)))) (dk-asms)))))
    (for-each (lambda (m) (dk-cite! 'cc-invertible-mat-is-mat m) (dk-cite! 'cc-invertible-det-nonzero m) (clm-type-entries! m))
              (list s t))
    (for-each (lambda (ij) (dk-cite! 'cc-matmul-2x2-entry s t (car ij) (cadr ij))) '((1 1) (1 2) (2 1) (2 2)))
    (mac 'MAT-LFT)
    (clm-subst-entry-eqs!)
    (subst (apply dk-cite! 'lft-compose (append (clm-ents s) (clm-ents t))))
    (clm-finish!)))
(qed 'mat-lft-hom)

(define (clm-rewrite! s t prove)
  (if (not (equal? s t))
      (begin (dk-have! (list '= s t) prove) (subst (list '= s t)))))
(define (clm-crs-rewrite! s t) (clm-rewrite! s t (lambda () (crs))))

(define (clm-skolem-tower! n)           ; skolemise the FORSOME tower of an LFTS membership, N binders
  (let loop ((k n) (acc '()))
    (if (= k 0)
        (reverse acc)
        (let ((ex (or (find-first (lambda (f) (dk-head-is? f 'FORSOME)) (dk-asms))
                      (error "clm-skolem-tower!: no existential in context"))))
          (loop (- k 1) (cons (dk-skolem! ex) acc))))))

;;; Every linear fractional transformation is L_S for an invertible S.
(sp (make-wff `(FORALL f (IMPLIES (IN f LFTS) (FORSOME s (AND ,(clm-inv-of 's) (= f (MAT-LFT s))))))))
(let ((f (car (map cadr (dk-peel!)))))
  (mac-h 'lfts-def (list 'IN f 'LFTS))
  (sep-me (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) f) (dk-head-is? (caddr h) 'SEP))) (dk-asms)))
  (let* ((vs (clm-skolem-tower! 4))
         (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
         (lit (list 'LIST (list 'LIST a b) (list 'LIST c d))))
    (dk-cite! 'mat22-literal-in-mat 'CC a b c d)
    (clm-lit-entries! lit)
    (dk-have! (list 'NOT (list '= (clm-det-of lit) 0)) (lambda () (clm-subst-entry-eqs!) (clm-finish-ass!)))
    (dk-cite! 'cc-det-nonzero-invertible lit)
    (let ((ml (dk-cite! 'mat-lft-literal a b c d)))
      (ew lit)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) '=) (subst ml))
          (clm-finish-ass!))))))
(qed 'mat-lft-onto)



;;; The kernel: L_S is the identity iff S is a scalar multiple of the identity matrix.  (The notes
;;; compare (az + b)/(cz + d) = z as polynomials; here: oo is fixed only if c = 0, then 0 is fixed
;;; only if b = 0, then 1 is fixed only if a = d.)
(define clm-id '(ID-FUN CC-HAT))

;;; (= (L pt) pt) from (= L id), pt typed in CC-HAT
(define (clm-fixed! l pt)
  (dk-cite! 'id-fun-apply 'CC-HAT pt)
  (let ((f (list '= (list l pt) pt)))
    (dk-have! f (lambda () (subst (list '= l clm-id)) (clm-finish-ass!)))
    f))

(sp (make-wff `(FORALL s (IMPLIES ,(clm-inv-of 's)
      (IFF (= (MAT-LFT s) (ID-FUN CC-HAT))
           (FORSOME r (AND (IN r CC) (= s (LIST (LIST r 0) (LIST 0 r))))))))))
(let ((s (cadr (dk-goal))))
  (dk-peel!)
  (dk-cite! 'cc-invertible-mat-is-mat s)
  (dk-cite! 'cc-invertible-det-nonzero s)
  (clm-type-entries! s)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'cc-hat-in-set)
  (dk-cite! 'id-fun-type 'CC-HAT)
  (let* ((es (clm-ents s))
         (a (car es)) (b (cadr es)) (c (caddr es)) (d (cadddr es))
         (l (cons 'LFT es)))
    (apply dk-cite! 'lft-in-fun es)
    (dk-have! (list '= (list 'MAT-LFT s) l) (lambda () (mac 'MAT-LFT) (clm-finish!)))
    (dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
      (lambda ()
        (dk-rewrite-h! (list '= (list 'MAT-LFT s) clm-id) (list 'MAT-LFT s) l)
        (fact 'cc-inf-in-cc-hat)
        (dk-cite! 'cc-in-cc-hat 0) (dk-cite! 'cc-in-cc-hat 1)
        (clm-fixed! l 'CC-INF) (clm-fixed! l 0) (clm-fixed! l 1)
        (let ((lit (list 'LIST (list 'LIST a 0) (list 'LIST 0 a))))
          (use-em (list '= c 0)
            (lambda ()
              ;; d /= 0
              (dk-have! (list 'NOT (list '= d 0))
                (lambda ()
                  (di)
                  (dk-have! (list '= (clm-det-of s) 0)
                    (lambda () (subst (list '= d 0)) (subst (list '= c 0)) (crs)))
                  (dk-only! (list '= (clm-det-of s) 0) (list 'NOT (list '= (clm-det-of s) 0)))
                  (prop)))
              ;; b = 0: the value at 0
              (let* ((den0 (list '+ (list '* c 0) d))
                     (num0 (list '+ (list '* a 0) b))
                     (y0   (list '* num0 (list 'recip den0))))
                (dk-have! (list 'NOT (list '= den0 0)) (lambda () (clm-crs-rewrite! den0 d) (clm-finish-ass!)))
                (dk-cite! 'lft-at-finite a b c d 0)
                (clm-type! num0) (clm-type! den0)
                (dk-cite! 'cc-div-closed num0 den0)
                (dk-have! (list '= y0 0) (lambda () (subst (list '= y0 (list l 0))) (clm-finish-ass!)))
                (dk-cite! 'cc-div-mul-back num0 den0)
                (dk-have! (list '= b 0)
                  (lambda ()
                    (dk-have! (list '= b num0) (lambda () (crs)))
                    (subst (list '= b num0))
                    (subst (list '= num0 (list '* y0 den0)))
                    (subst (list '= y0 0))
                    (crs))))
              ;; a = d: the value at 1
              (let* ((den1 (list '+ (list '* c 1) d))
                     (num1 (list '+ (list '* a 1) b))
                     (y1   (list '* num1 (list 'recip den1))))
                (dk-have! (list 'NOT (list '= den1 0))
                  (lambda () (clm-rewrite! den1 d (lambda () (subst (list '= c 0)) (crs))) (clm-finish-ass!)))
                (dk-cite! 'lft-at-finite a b c d 1)
                (clm-type! num1) (clm-type! den1)
                (dk-cite! 'cc-div-closed num1 den1)
                (dk-have! (list '= y1 1) (lambda () (subst (list '= y1 (list l 1))) (clm-finish-ass!)))
                (dk-cite! 'cc-div-mul-back num1 den1)
                (dk-have! (list '= a d)
                  (lambda ()
                    (dk-have! (list '= a num1) (lambda () (subst (list '= b 0)) (crs)))
                    (subst (list '= a num1))
                    (subst (list '= num1 (list '* y1 den1)))
                    (subst (list '= y1 1))
                    (subst (list '= c 0))
                    (crs))))
              ;; S = [[a, 0], [0, a]]
              (dk-cite! 'mat22-literal-in-mat 'CC a 0 0 a)
              (clm-lit-entries! lit)
              (for-each
                (lambda (ij)
                  (let* ((i (car ij)) (j (cadr ij))
                         (eq (list '= (list 'ENTRY s i j) (list 'ENTRY lit i j))))
                    (dk-have! eq
                      (lambda ()
                        (subst (find-first (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) (list 'ENTRY lit i j)))) (dk-asms)))
                        (if (and (= i 2) (= j 2)) (subst (list '= d a)))
                        (clm-finish!)))))
                '((1 1) (1 2) (2 1) (2 2)))
              (dk-cite! 'mat22-ext 'CC s lit)
              (ew a)
              (dk-conj-close! (lambda () (clm-finish-ass!))))
            (lambda ()
              ;; c /= 0: L(oo) = a/c is finite, but L(oo) = oo
              (dk-cite! 'lft-at-inf a b c d)
              (dk-cite! 'cc-div-closed a c)
              (let ((q (list '* a (list 'recip c))))
                (dk-have! (list '= q 'CC-INF) (lambda () (subst (list '= q (list l 'CC-INF))) (clm-finish-ass!)))
                (dk-cite! 'cc-ne-inf q)
                (dk-only! (list '= q 'CC-INF) (list 'NOT (list '= q 'CC-INF)))
                (prop))))))
      (lambda ()
        (let* ((ex (find-first (lambda (h) (dk-head-is? h 'FORSOME)) (dk-asms)))
               (r  (dk-skolem! ex))
               (lit (list 'LIST (list 'LIST r 0) (list 'LIST 0 r))))
          (clm-lit-entries! lit)
          (let* ((n2 (dk-rewrite-h! (list 'NOT (list '= (clm-det-of s) 0)) s lit)))
            (dk-have! (list 'NOT (list '= r 0))
              (lambda ()
                (di)
                (dk-have! (list '= (clm-det-of lit) 0)
                  (lambda () (clm-subst-entry-eqs!) (subst (list '= r 0)) (crs)))
                (dk-only! (list '= (clm-det-of lit) 0) n2)
                (prop))))
          (subst (list '= s lit))
          (subst (dk-cite! 'mat-lft-literal r 0 0 r))
          (subst (dk-cite! 'lft-scalar-identity r))
          (clm-finish!))))))
(qed 'mat-lft-kernel)
