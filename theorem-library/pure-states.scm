;;; ---- Sigma(A) in the locally convex space RFN-MODULE(A) ----------------------------------------------------
(define g4k-Ma '(RFN-MODULE (VEC a)))
(define g4k-Va '(FUN (VEC a) CC))
(define g4k-ESNa '(EVAL-SEMINORMS (VEC a)))
(define g4k-Ta '(RFN-TOP (VEC a)))
(define (g4k-asetup!)                  ; after the peel of a uiba a
  (g4w-setup!)
  (dk-cite! 'cc-is-set)
  (let ((iff (dk-cite! 'fun-set-iff '(VEC a) 'CC)))
    (dk-have! '(AND (IN (VEC a) SET) (IN CC SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-have! (list 'IN g4k-Va 'SET) (lambda () (if (dk-only! iff '(AND (IN (VEC a) SET) (IN CC SET))) (prop)))))
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (dk-cite! 'rfn-module-is-module '(VEC a))
  (dk-cite! 'rfn-module-vec '(VEC a))
  (dk-cite! 'rr-scalar-ring-carr)
  (dk-have! (list 'IN (list 'VEC g4k-Ma) 'SET) (lambda () (subst (list '== (list 'VEC g4k-Ma) g4k-Va)) (dk-ass!)))
  (dk-have! (list 'SUBSET g4w-SIG g4k-Va)
    (lambda () (mac 'subset-def) (let ((c (g4k-var (dk-peel!) g4w-SIG))) (g4w-state0! c) (dk-ass!))))
  (dk-cite! 'subclass-of-set-is-set g4w-SIG g4k-Va)
  (dk-have! (list 'SUBSET g4w-SIG (list 'VEC g4k-Ma)) (lambda () (subst (list '== (list 'VEC g4k-Ma) g4k-Va)) (dk-ass!))))

(sp (g4w-st (list 'IS-COMPACT-T (list 'SUBSPACE-TOP g4k-Ta g4w-SIG))))
(dk-peel!)
(g4k-asetup!)
(dk-cite! 'states-product-compact 'a)
(dk-cite! 'rfn-open-product-open '(VEC a))
(dk-cite! 'eval-seminorms-family '(VEC a))
