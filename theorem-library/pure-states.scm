(define g4w-SIGSEP '(SEP g4f_ (FUN (VEC a) CC) (AND (IS-POSITIVE-LF a g4f_) (= (g4f_ (VONE a)) 1))))
(define (g4w-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE g4w-MT)))
      (begin (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS)
