;;; ---- Sigma(A) is a convex subset of RFN-MODULE(A) ------------------------------------------------------------
(define (g4k-pt-vadd! x z y)           ; x, z in Va, y in VEC a: ((VADD Ma) x z) y = x y + z y landed
  (dk-cite! 'rfn-vadd-value '(VEC a) x z y))
(define (g4k-pt-act! r x y) (dk-cite! 'rfn-act-value '(VEC a) r x y))
(define (g4k-inva! x)                  ; (IN x (VEC Ma)) in context: (IN x Va)
  (if (not (dk-asm? (list 'IN x g4k-Va))) (dk-rewrite-h! (list 'IN x (list 'VEC g4k-Ma)) (list 'VEC g4k-Ma) g4k-Va)))
(define (g4k-outa! x)                  ; (IN x Va) in context: (IN x (VEC Ma))
  (if (not (dk-asm? (list 'IN x (list 'VEC g4k-Ma))))
      (dk-have! (list 'IN x (list 'VEC g4k-Ma)) (lambda () (subst (list '== (list 'VEC g4k-Ma) g4k-Va)) (dk-ass!)))))
(define (g4k-combo! r g h)             ; r in RR, g h in Va: the term (VADD (ACT (1-r) g) (ACT r h)) typed, returned
  (let* ((s (list '- 1 r)) (ag (list (list 'ACT g4k-Ma) s g)) (ah (list (list 'ACT g4k-Ma) r h))
         (t (list (list 'VADD g4k-Ma) ag ah)))
    (dk-real! s)
    (dk-have! (list 'IN s (list 'CARR (list 'SCAL g4k-Ma)))
      (lambda () (dk-cite! 'rfn-module-scal '(VEC a)) (subst (list '== (list 'SCAL g4k-Ma) g4k-rr)) (subst (list '== (list 'CARR g4k-rr) 'RR)) (dk-ass!)))
    (dk-have! (list 'IN r (list 'CARR (list 'SCAL g4k-Ma)))
      (lambda () (dk-cite! 'rfn-module-scal '(VEC a)) (subst (list '== (list 'SCAL g4k-Ma) g4k-rr)) (subst (list '== (list 'CARR g4k-rr) 'RR)) (dk-ass!)))
    (g4k-outa! g) (g4k-outa! h)
    (dk-apply! (dk-cite! 'module-act-type g4k-Ma) s g)
    (dk-apply! (dk-cite! 'module-act-type g4k-Ma) r h)
    (dk-apply! (dk-cite! 'module-vadd-type g4k-Ma) ag ah)
    (g4k-inva! ag) (g4k-inva! ah) (g4k-inva! t)
    t))
(define (g4k-combo-at! r g h y)        ; after g4k-combo!: (t y) = (1-r) g y + r h y landed, returned
  (let* ((s (list '- 1 r)) (ag (list (list 'ACT g4k-Ma) s g)) (ah (list (list 'ACT g4k-Ma) r h))
         (t (list (list 'VADD g4k-Ma) ag ah))
         (rhs (list '+ (list '* s (list g y)) (list '* r (list h y))))
         (e (list '= (list t y) rhs)))
    (g4k-pt-vadd! ag ah y) (g4k-pt-act! s g y) (g4k-pt-act! r h y)
    (dk-have! e (lambda ()
      (subst (list '= (list t y) (list '+ (list ag y) (list ah y))))
      (subst (list '= (list ag y) (list '* s (list g y))))
      (subst (list '= (list ah y) (list '* r (list h y))))
      (rfl)))
    e))

(sp (g4w-st (list 'IS-CONVEX-SUBSET g4k-Ma g4w-SIG)))
(dk-peel!)
(g4k-asetup!)
(let ((iff (dk-cite! 'is-convex-subset g4k-Ma g4w-SIG)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((l (dk-peel!))
                     (ts (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) g4w-SIG))) l)))
                     (g (car ts)) (h (cadr ts))
                     (r (g4k-var l 'RR))
                     (s (list '- 1 r)))
                (g4w-state0! g) (g4w-state0! h)
                (dk-real! s)
                (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '<= r 1) (list 'IN r 'RR))))
                (dk-have! (list '<= s 1) (lambda () (dk-ineq! (list '<= 0 r) (list 'IN r 'RR))))
                (let* ((t (g4k-combo! r g h))
                       (cv (dk-apply! (dk-cite! 'states-convex 'a) g h s)))
                  (let ((cv2 (dk-pick (lambda (h2) (and (dk-head-is? h2 'IN) (equal? (caddr h2) g4w-SIG) (dk-contains? h2 'VNB-LAMBDA))) "the combination")))
                    (dk-have! (list '= t (cadr cv2))
                      (lambda ()
                        (dk-fun-ext! t (cadr cv2) '(VEC a) 'CC #f
                          (lambda ()
                            (dk-lam-type!
                              (lambda ()
                                (let ((w (dk-di-var!)))
                                  (dk-cite! 'fun-apply-type-c g '(VEC a) 'CC w)
                                  (dk-cite! 'fun-apply-type-c h '(VEC a) 'CC w)
                                  (dk-real! (list '- 1 s))
                                  (g4k-cc! (list '+ (list '* s (list g w)) (list '* (list '- 1 s) (list h w))))
                                  (dk-ass!)))))
                          (lambda (w)
                            (g4k-beta!)
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                (begin
                                  (dk-cite! 'fun-apply-type-c g '(VEC a) 'CC w)
                                  (dk-cite! 'fun-apply-type-c h '(VEC a) 'CC w)
                                  (subst (g4k-combo-at! r g h w))
                                  (crs)))))))
                    (subst (list '= t (cadr cv2)))
                    (dk-ass!)))))))))
  (g4k-iff-get! iff (caddr iff) (list 'IS-CONVEX-SUBSET g4k-Ma g4w-SIG)))
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'states-rfn-convex)

;;; ---- an extreme point of Sigma(A) in RFN-MODULE(A) is an extreme state -------------------------------------
(sp (g4w-st (list 'FORALL 'g4kx_ (list 'IMPLIES (list 'IN 'g4kx_ (list 'EXTREME-POINTS g4k-Ma g4w-SIG))
                                       '(IS-EXTREME-STATE a g4kx_)))))
(dk-peel!)
(g4k-asetup!)
(let* ((x 'g4kx_)
       (m1 (dk-cite! 'extreme-points-mem g4k-Ma g4w-SIG x))
       (r1 (g4k-iff-get! m1 (cadr m1) (caddr m1))))
  (dk-split! r1)
  (let* ((m2 (dk-cite! 'is-extreme-point g4k-Ma g4w-SIG x))
         (r2 (g4k-iff-get! m2 (cadr m2) (caddr m2))))
    (dk-split! r2)
    (let ((ext (caddr r2)))
      (g4w-state0! x)
      (mac 'IS-EXTREME-STATE)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((l (dk-peel!))
                     (ts (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) g4w-SIG))) l)))
                     (g (car ts)) (h (cadr ts)) (r (g4k-var l 'RR))
                     (hp (car (filter (lambda (f) (dk-head-is? f 'FORALL)) l)))
                     (z (g4k-var l '(VEC a))))
                (g4w-state0! g) (g4w-state0! h)
                (let ((t (g4k-combo! r h g)))
                  (dk-have! (list '= x t)
                    (lambda ()
                      (dk-fun-ext! x t '(VEC a) 'CC #f #f
                        (lambda (w)
                          (dk-cite! 'fun-apply-type-c g '(VEC a) 'CC w)
                          (dk-cite! 'fun-apply-type-c h '(VEC a) 'CC w)
                          (dk-apply! hp w)
                          (subst (g4k-combo-at! r h g w))
                          (subst (list '= (list x w) (list '+ (list '* r (list g w)) (list '* (list '- 1 r) (list h w)))))
                          (dk-real! (list '- 1 r))
                          (crs)))))
                  (dk-split! (dk-apply! ext h g r))
                  (dk-cite! 'fun-apply-type-c x '(VEC a) 'CC z)
                  (subst (list '= g x))
                  (subst (list '= h x))
                  (dk-conj-close! (lambda () (rfl)))))))))))
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'extreme-point-is-extreme-state)

;;; ---- Proposition 4.24: pure states exist; Sigma(A) is the closed convex hull of its extreme points ----------
(define (g4k-km-hyps!)
  (g4k-asetup!)
  (dk-cite! 'rfn-top-locally-convex '(VEC a))
  (dk-cite! 'states-rfn-convex 'a)
  (dk-cite! 'states-rfn-compact 'a))
(sp (g4w-st (list 'IMPLIES (list 'FORSOME 'g4kz_ (list 'IN 'g4kz_ g4w-SIG))
                           '(FORSOME g4kp_ (IS-PURE-STATE a g4kp_)))))
(dk-peel!)
(g4k-km-hyps!)
(let* ((ex (dk-cite! 'extreme-points-nonempty g4k-Ma g4k-Ta g4w-SIG))
       (ex1 (if (dk-head-is? ex 'FORSOME) ex
                (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'EXTREME-POINTS))) "the extreme point")))
       (p (dk-skolem! ex1 #t)))
  (dk-apply! (dk-cite! 'extreme-point-is-extreme-state 'a) p)
  (let ((iff (dk-cite! 'pure-state-iff-extreme 'a p)))
    (g4k-iff-get! iff (caddr iff) (cadr iff)))
  (ew p)
  (dk-ass!))
(g4k-qed! 'pure-state-exists)

(sp (g4w-st (list '= g4w-SIG (list 'CLOSED-CONV-HULL g4k-Ma g4k-Ta (list 'EXTREME-POINTS g4k-Ma g4w-SIG)))))
(dk-peel!)
(g4k-km-hyps!)
(dk-cite! 'krein-milman g4k-Ma g4k-Ta g4w-SIG)
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'states-krein-milman)

;;; ---- conversely an extreme state is an extreme point; the extreme points are the pure states ---------------
(sp (g4w-st '(FORALL g4kx_ (IMPLIES (IS-EXTREME-STATE a g4kx_) (IN g4kx_ (EXTREME-POINTS (RFN-MODULE (VEC a)) (STATES a)))))))
(dk-peel!)
(g4k-asetup!)
(let* ((x 'g4kx_)
       (es (dk-split-all! (dk-landed (lambda () (mac-h 'IS-EXTREME-STATE '(IS-EXTREME-STATE a g4kx_))))))
       (all (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'STATES) (dk-contains? f x))) "the extremality"))
       (m1 (dk-cite! 'extreme-points-mem g4k-Ma g4w-SIG x))
       (m2 (dk-cite! 'is-extreme-point g4k-Ma g4w-SIG x)))
  (g4w-state0! x) (g4k-outa! x)
  (dk-have! (caddr m2)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((l (dk-peel!))
                     (ts (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) g4w-SIG))) l)))
                     (u (car ts)) (v (cadr ts)) (r (g4k-var l 'RR)))
                (g4w-state0! u) (g4w-state0! v)
                (let* ((t (g4k-combo! r u v))
                       (pw (list 'FORALL 'g4hy_ (list 'IMPLIES '(IN g4hy_ (VEC a))
                              (list '= (list x 'g4hy_) (list '+ (list '* r (list v 'g4hy_)) (list '* (list '- 1 r) (list u 'g4hy_))))))))
                  (dk-have! pw
                    (lambda ()
                      (let ((y (g4k-var (dk-peel!) '(VEC a))))
                        (dk-cite! 'fun-apply-type-c u '(VEC a) 'CC y)
                        (dk-cite! 'fun-apply-type-c v '(VEC a) 'CC y)
                        (subst (list '= x t))
                        (subst (g4k-combo-at! r u v y))
                        (dk-real! (list '- 1 r))
                        (crs))))
                  (let ((pt (dk-apply! all v u r)))
                    (dk-conj-close!
                      (lambda ()
                        (let* ((g (dk-goal)) (w (cadr g)))
                          (dk-fun-ext! w x '(VEC a) 'CC #f #f
                            (lambda (z)
                              (dk-split! (dk-apply! pt z))
                              (dk-ass!))))))))))))))
  (dk-have! (caddr m1) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (g4k-iff-get! m2 (caddr m2) (dk-goal)))))))
  (g4k-iff-get! m1 (caddr m1) (cadr m1)))
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'extreme-state-is-extreme-point)

(define g4k-EP (list 'EXTREME-POINTS g4k-Ma g4w-SIG))
(define g4k-PS (list 'SEP 'g4kp_ g4k-Va '(IS-PURE-STATE a g4kp_)))
(define (g4k-pure-iff! x)               ; lands (IFF (IS-PURE-STATE a x) (IS-EXTREME-STATE a x))
  (dk-cite! 'pure-state-iff-extreme 'a x))
(sp (g4w-st (list 'FORALL 'g4kx_ (list 'IFF (list 'IN 'g4kx_ g4k-EP) '(IS-PURE-STATE a g4kx_)))))
(dk-peel!)
(let ((iff (g4k-pure-iff! 'g4kx_)))
  (dk-have! (list 'IMPLIES (list 'IN 'g4kx_ g4k-EP) '(IS-PURE-STATE a g4kx_))
    (lambda () (dk-peel!) (dk-apply! (dk-cite! 'extreme-point-is-extreme-state 'a) 'g4kx_) (prop)))
  (dk-have! (list 'IMPLIES '(IS-PURE-STATE a g4kx_) (list 'IN 'g4kx_ g4k-EP))
    (lambda () (dk-peel!)
      (dk-have! '(IS-EXTREME-STATE a g4kx_) (lambda () (prop)))
      (dk-apply! (dk-cite! 'extreme-state-is-extreme-point 'a) 'g4kx_)
      (dk-ass!)))
  (prop))
(g4k-qed! 'extreme-points-are-pure-states)

(sp (g4w-st (list '= g4k-EP g4k-PS)))
(dk-peel!)
(g4k-asetup!)
(dk-have! (list 'SUBSET g4k-EP g4w-SIG)
  (lambda () (mac 'subset-def)
    (let* ((x (g4k-var (dk-peel!) g4k-EP))
           (m1 (dk-cite! 'extreme-points-mem g4k-Ma g4w-SIG x))
           (r1 (g4k-iff-get! m1 (cadr m1) (caddr m1))))
      (dk-split! r1)
      (let* ((m2 (dk-cite! 'is-extreme-point g4k-Ma g4w-SIG x))
             (r2 (g4k-iff-get! m2 (cadr m2) (caddr m2))))
        (dk-split! r2) (dk-ass!)))))
(dk-cite! 'subclass-of-set-is-set g4k-EP g4w-SIG)
(dk-have! (list 'SUBSET g4k-PS g4k-Va)
  (lambda () (mac 'subset-def)
    (let ((x (g4k-var (dk-peel!) g4k-PS)))
      (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x g4k-PS)))))
      (dk-ass!))))
(dk-cite! 'subclass-of-set-is-set g4k-PS g4k-Va)
(let ((ce (dk-cite! 'class-extensionality g4k-EP g4k-PS)))
  (dk-have! (cadr ce)
    (lambda ()
      (let* ((x (dk-di-var! (lambda (g) (cadr (cadr g)))))
             (iff (dk-apply! (dk-cite! 'extreme-points-are-pure-states 'a) x)))
        (dk-have! (list 'IMPLIES (list 'IN x g4k-EP) (list 'IN x g4k-PS))
          (lambda () (dk-peel!)
            (dk-have! (list 'IS-PURE-STATE 'a x) (lambda () (prop)))
            (dk-apply! (dk-cite! 'extreme-point-is-extreme-state 'a) x)
            (dk-split-all! (dk-landed (lambda () (mac-h 'IS-EXTREME-STATE (list 'IS-EXTREME-STATE 'a x)))))
            (g4w-state0! x)
            (for-each (lambda (lf) (dk-focus! lf) (dk-ass!)) (dk-opened (lambda () (sep-mi))))))
        (dk-have! (list 'IMPLIES (list 'IN x g4k-PS) (list 'IN x g4k-EP))
          (lambda () (dk-peel!)
            (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x g4k-PS)))))
            (prop)))
        (prop))))
  (if (not (proof-done? *ps*)) (prop)))
(g4k-qed! 'extreme-points-pure-set)

(sp (g4w-st (list '= g4w-SIG (list 'CLOSED-CONV-HULL g4k-Ma g4k-Ta g4k-PS))))
(dk-peel!)
(dk-cite! 'states-krein-milman 'a)
(dk-cite! 'extreme-points-pure-set 'a)
