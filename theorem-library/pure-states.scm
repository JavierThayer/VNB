;;; pure-states.scm -- PURE STATES EXIST, AND Sigma(A) IS THE CLOSED CONVEX HULL OF THEM: F. J. Thayer,
;;; "Banach Algebras and Applications" (docs/BanachAlgebras.pdf), Proposition 4.24 (Krein-Milman applied to
;;; the state space).  Agent BA-1117-GNS2, wave 2026-11-17 (round 2).
;;; Destination: theorem-library/pure-states.scm.  Library: operator-algebras.
;;; All proofs modulo 0.  Helper prefix: g4k-.
;;;
;;; krein-milman (BA-KM) is stated for a REAL locally convex space.  Sigma(A) lives in the real vector space
;;; RFN-MODULE(A) of all functions A -> CC with pointwise operations; the evaluation seminorms
;;; f |-> |f(y)| make it locally convex (seminorm-top-locally-convex).  Their topology RFN-TOP(A) is coarser
;;; than the product topology of CC^A (every seminorm ball contains a product box), so the compactness of
;;; Sigma(A) for the product (states-weak-star-compact) passes to it.  An extreme point of Sigma(A) in
;;; RFN-MODULE is an extreme state (IS-EXTREME-STATE: the same convex combination, read pointwise), and an
;;; extreme state is pure (pure-state-iff-extreme).
;;; LOAD WINDOW: after theorem-library/krein-milman, theorem-library/states-compact, theorem-library/
;;; state-extreme, theorem-library/ba4-states, and structure-library/ba-gns2-vocab.

(define (g4k-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (for-each (lambda (l) (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 60 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "pure-states: unfinished" name))))
(define (g4k-var landed cls)
  (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if h (cadr h) (error "g4k-var: no landed typing in" cls))))
(define (g4k-fin! leaf) (if (not (sequent-node-grounded? leaf)) (dk-ass!)))

;;; ---- the slots of RFN-MODULE(u) -------------------------------------------------------------------------
(define g4k-rr '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define g4k-V '(FUN u CC))
(define g4k-M '(RFN-MODULE u))
(define g4k-vadd '(VNB-LAMBDA (LIST g4hf_ g4hg_) (CARTESIAN (FUN u CC) (FUN u CC)) (VNB-LAMBDA g4hy_ u (+ (g4hf_ g4hy_) (g4hg_ g4hy_)))))
(define g4k-vzero '(VNB-LAMBDA g4hy_ u 0))
(define g4k-vneg '(VNB-LAMBDA g4hf_ (FUN u CC) (VNB-LAMBDA g4hy_ u (- (g4hf_ g4hy_)))))
(define g4k-act '(VNB-LAMBDA (LIST g4hr_ g4hf_) (CARTESIAN RR (FUN u CC)) (VNB-LAMBDA g4hy_ u (* g4hr_ (g4hf_ g4hy_)))))
(define (g4k-mslot! name acc val)
  (sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IN u SET) (list '== (list acc g4k-M) val)))))
  (dk-peel!)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (slot acc)
  (mac 'RFN-MODULE)
  (nth-r)
  (if (not (proof-done? *ps*)) (qrfl))
  (g4k-qed! name))
(g4k-mslot! 'rfn-module-scal 'SCAL g4k-rr)
(g4k-mslot! 'rfn-module-vec 'VEC g4k-V)
(g4k-mslot! 'rfn-module-vadd 'VADD g4k-vadd)
(g4k-mslot! 'rfn-module-vzero 'VZERO g4k-vzero)
(g4k-mslot! 'rfn-module-vneg 'VNEG g4k-vneg)
(g4k-mslot! 'rfn-module-act 'ACT g4k-act)

;;; ---- RFN-MODULE(u) is a real module ----------------------------------------------------------------------
(define (g4k-fsum a b) (list 'VNB-LAMBDA 'g4hy_ 'u (list '+ (list a 'g4hy_) (list b 'g4hy_))))
(define (g4k-fneg a) (list 'VNB-LAMBDA 'g4hy_ 'u (list '- (list a 'g4hy_))))
(define (g4k-fscale c a) (list 'VNB-LAMBDA 'g4hy_ 'u (list '* c (list a 'g4hy_))))
(define (g4k-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA))
           (let loop ((xs t)) (and (pair? xs) (or (g4k-redex? (car xs)) (loop (cdr xs))))))))
(define (g4k-beta!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (g4k-redex? (dk-goal)) (dk-lam-b!))
    (sequent-node-grounded? leaf)))
(define (g4k-base-at! vecs z) (for-each (lambda (a) (dk-cite! 'fun-apply-type-c a 'u 'CC z)) vecs))
(define (g4k-cc! t)                    ; type a CC term built from + * - over CC atoms in context, RR scalars
  (let ((g (list 'IN t 'CC)))
    (cond ((dk-asm? g) t)
          ((dk-asm? (list 'IN t 'RR)) (dk-cite! 'rr-subset-cc t) t)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (g4k-cc! (cadr t)) (g4k-cc! (caddr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
           (dk-cite! (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)) t)
          ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
           (g4k-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
          ((equal? t 0) (dk-real! 0) (dk-cite! 'rr-subset-cc 0) t)
          (#t (error "g4k-cc!: cannot type" (expression->string t))))))
(define (g4k-lam-typer vecs)
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (g4k-base-at! vecs z)
          (g4k-beta!)
          (if (not (sequent-node-grounded? leaf))
              (begin (g4k-cc! (cadr (dk-goal))) (g4k-fin! leaf))))))))
(define (g4k-fn-in! f vecs)            ; (IN f (FUN u CC)) for a lambda f over the vectors VECS
  (let ((g (list 'IN f g4k-V)))
    (if (not (dk-asm? g)) (dk-have! g (g4k-lam-typer vecs)))))
(define (g4k-law! vs ss)               ; a pointwise module law on the focus goal
  (let ((leaf (proof-state-focus *ps*)))
    (for-each (lambda (s0) (dk-cite! 'rr-subset-cc s0)) ss)
    (dk-real! 1) (dk-cite! 'rr-subset-cc 1)
    (g4k-fn-in! g4k-vzero '())
    (for-each (lambda (a) (g4k-fn-in! (g4k-fneg a) vs)) vs)
    (for-each (lambda (a) (for-each (lambda (b) (g4k-fn-in! (g4k-fsum a b) vs)) vs)) vs)
    (for-each (lambda (c) (for-each (lambda (a) (g4k-fn-in! (g4k-fscale c a) vs)) vs)) ss)
    (for-each (lambda (r) (for-each (lambda (s0) (dk-real! (list '+ r s0)) (dk-real! (list '* r s0))) ss)) ss)
    (if (not (sequent-node-grounded? leaf)) (g4k-beta!))
    (if (not (sequent-node-grounded? leaf))
        (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
          (dk-fun-ext! l r 'u 'CC
            (if (symbol? l) #f (g4k-lam-typer vs))
            (if (symbol? r) #f (g4k-lam-typer vs))
            (lambda (w)
              (g4k-base-at! vs w)
              (if (not (g4k-beta!))
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))))
    (if (not (sequent-node-grounded? leaf)) (error "g4k-law!: did not close" (expression->string (dk-goal))))))
(define (g4k-peel-vars!)
  (let* ((lk (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) g4k-V))) lk)))
         (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
    (cons vs ss)))
(define (g4k-subst-slots!)
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc g4k-M)) (subst (list '== (list acc g4k-M) val))))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list g4k-rr g4k-V g4k-vadd g4k-vzero g4k-vneg g4k-act)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IN u SET) (list 'IS-MODULE g4k-M)))))
(dk-peel!)
(dk-cite! 'cc-is-set)
(let ((iff (dk-cite! 'fun-set-iff 'u 'CC)))
  (dk-have! '(AND (IN u SET) (IN CC SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-have! '(IN (FUN u CC) SET) (lambda () (if (dk-only! iff '(AND (IN u SET) (IN CC SET))) (prop)))))
(fact 'rr-is-normed-field)
(fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
(fact 'commutative-ring-is-ring g4k-rr)
(for-each (lambda (nm) (dk-cite! nm 'u))
          '(rfn-module-scal rfn-module-vec rfn-module-vadd rfn-module-vzero rfn-module-vneg rfn-module-act))
(mac 'IS-MODULE)
(dk-isx-set!)
(g4k-subst-slots!)
(for-each (lambda (m) (vnb-guard (lambda () (mac m))))
          '(rr-scalar-ring-carr rr-scalar-ring-add rr-scalar-ring-mul rr-scalar-ring-one))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (dk-ass!))
        ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
         (mac 'RFN-MODULE) (len-r) (if (not (proof-done? *ps*)) (vnb-guard (lambda () (arith)))))
        ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
         (dk-lam-type!
           (lambda ()
             (let* ((vss (g4k-peel-vars!)) (vs (car vss)) (ss (cdr vss))
                    (leaf (proof-state-focus *ps*)))
               (cond ((dk-asm? (dk-goal)) #t)
                     ((eq? (caddr (dk-goal)) 'CC) (g4k-cc! (cadr (dk-goal))))
                     (#t (dk-have! (dk-goal) (g4k-lam-typer vs))))
               (g4k-fin! leaf)))))
        ((and (dk-head-is? g 'IN) (equal? (caddr g) g4k-V))
         (dk-have! g (g4k-lam-typer '())))
        ((memq (car g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES is-associative is-commutative is-identity has-inverses))
         (mac (car g))
         (let ((vss (g4k-peel-vars!)))
           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (g4k-law! (car vss) (cdr vss)))))))
        ((dk-head-is? g 'FORALL)
         (let ((vss (g4k-peel-vars!)))
           (g4k-law! (car vss) (cdr vss))))
        (#t (error "g4k: unexpected conjunct" (expression->string g)))))))
(g4k-qed! 'rfn-module-is-module)

;;; ---- values of the operations, and the evaluation seminorms ----------------------------------------------
(define (g4k-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))
(define (g4k-su body) (make-wff (g4k-fa 'u 'SET body)))
(define (g4k-val! name stmt slot-thm)
  (sp (g4k-su stmt))
  (dk-peel!)
  (if slot-thm (subst (list '== (list (car slot-thm) g4k-M) (cadr slot-thm))))
  (dk-lam-b!)
  (if (not (proof-done? *ps*)) (dk-lam-b!))
  (if (not (proof-done? *ps*)) (rfl))
  (g4k-qed! name))
(define g4k-ESN '(EVAL-SEMINORMS u))
(define (g4k-type-rfl! vecs y)
  (g4k-base-at! vecs y)
  (if (not (proof-done? *ps*))
      (let ((t (caddr (dk-goal))))
        (if (and (pair? t) (eq? (car t) 'magnitude)) (dk-cite! 'cc-magnitude-closed (cadr t)) (g4k-cc! t))
        (rfl))))
(sp (g4k-su (g4k-fa 'g4kf_ g4k-V (g4k-fa 'g4kg_ g4k-V (g4k-fa 'g4ky_ 'u
  (list '= '(((VADD (RFN-MODULE u)) g4kf_ g4kg_) g4ky_) '(+ (g4kf_ g4ky_) (g4kg_ g4ky_))))))))
(dk-peel!)
(dk-cite! 'rfn-module-vadd 'u)
(subst (list '== (list 'VADD g4k-M) g4k-vadd))
(g4k-beta!) (if (not (proof-done? *ps*)) (g4k-beta!)) (g4k-type-rfl! '(g4kf_ g4kg_) 'g4ky_)
(g4k-qed! 'rfn-vadd-value)
(sp (g4k-su (g4k-fa 'g4kr_ 'RR (g4k-fa 'g4kf_ g4k-V (g4k-fa 'g4ky_ 'u
  (list '= '(((ACT (RFN-MODULE u)) g4kr_ g4kf_) g4ky_) '(* g4kr_ (g4kf_ g4ky_))))))))
(dk-peel!)
(dk-cite! 'rfn-module-act 'u)
(subst (list '== (list 'ACT g4k-M) g4k-act))
(g4k-beta!) (if (not (proof-done? *ps*)) (g4k-beta!)) (g4k-type-rfl! '(g4kf_) 'g4ky_)
(g4k-qed! 'rfn-act-value)
(sp (g4k-su (g4k-fa 'g4ky_ 'u (list '= '((VZERO (RFN-MODULE u)) g4ky_) 0))))
(dk-peel!)
(dk-cite! 'rfn-module-vzero 'u)
(subst (list '== (list 'VZERO g4k-M) g4k-vzero))
(g4k-beta!) (if (not (proof-done? *ps*)) (rfl))
(g4k-qed! 'rfn-vzero-value)
(sp (g4k-su (g4k-fa 'g4ky_ 'u (g4k-fa 'g4kf_ g4k-V
  (list '= '(((EVAL-SEMINORMS u) g4ky_) g4kf_) '(magnitude (g4kf_ g4ky_)))))))
(dk-peel!)
(mac 'EVAL-SEMINORMS)
(g4k-beta!) (if (not (proof-done? *ps*)) (g4k-beta!)) (g4k-type-rfl! '(g4kf_) 'g4ky_)
(g4k-qed! 'eval-seminorms-value)

;;; ---- the evaluation seminorms are a separating family of seminorms -------------------------------------
(define (g4k-funset!)
  (dk-cite! 'cc-is-set)
  (let ((iff (dk-cite! 'fun-set-iff 'u 'CC)))
    (dk-have! '(AND (IN u SET) (IN CC SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-have! '(IN (FUN u CC) SET) (lambda () (if (dk-only! iff '(AND (IN u SET) (IN CC SET))) (prop))))))
(define (g4k-msetup!)                  ; u in SET in context
  (g4k-funset!)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (dk-cite! 'rfn-module-is-module 'u)
  (for-each (lambda (nm) (dk-cite! nm 'u))
            '(rfn-module-scal rfn-module-vec rfn-module-vadd rfn-module-vzero rfn-module-vneg rfn-module-act))
  (dk-cite! 'rr-scalar-ring-carr))
(define (g4k-inv! x)                   ; (IN x (VEC M)) in context: (IN x V)
  (if (not (dk-asm? (list 'IN x g4k-V))) (dk-rewrite-h! (list 'IN x (list 'VEC g4k-M)) (list 'VEC g4k-M) g4k-V)))
(define (g4k-evat x y) (list (list g4k-ESN y) x))
(define (g4k-evval! y x)               ; y in u, x in V: lands (= ((EV y) x) (magnitude (x y))), (x y) in CC
  (dk-cite! 'fun-apply-type-c x 'u 'CC y)
  (dk-cite! 'eval-seminorms-value 'u y x))
(define g4k-EVTYP (list 'IN g4k-ESN (list 'FUN 'u (list 'FUN g4k-V 'RR))))
(define (g4k-scal-eq!)
  (subst (list '== (list 'SCAL g4k-M) g4k-rr))
  (if (not (proof-done? *ps*)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))

(sp (g4k-su (list 'IS-SEMINORM-FAMILY-ON 'RR-NORMED-FIELD g4k-M 'u g4k-ESN)))
(dk-peel!)
(g4k-msetup!)
(dk-have! g4k-EVTYP
  (lambda ()
    (mac 'EVAL-SEMINORMS)
    (dk-lam-type!
      (lambda ()
        (let ((y (dk-di-var!)))
          (dk-lam-type!
            (lambda ()
              (let ((f (dk-di-var!)))
                (dk-cite! 'fun-apply-type-c f 'u 'CC y)
                (dk-cite! 'cc-magnitude-closed (list f y))
                (dk-ass!)))))))))
(mac 'IS-SEMINORM-FAMILY-ON)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (dk-ass!))
        ((and (dk-head-is? g '=) (equal? (cadr g) (list 'SCAL g4k-M))) (g4k-scal-eq!))
        ((dk-head-is? g 'IN) (subst (list '== (list 'VEC g4k-M) g4k-V)) (dk-ass!))
        ;; each p_y is a seminorm
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-SEMINORM))
         (let ((y (g4k-var (dk-peel!) 'u)))
           (dk-cite! 'fun-apply-type-c g4k-ESN 'u (list 'FUN g4k-V 'RR) y)
           (mac 'is-seminorm)
           (dk-conj-close!
             (lambda ()
               (let ((g (dk-goal)))
                 (cond
                   ((dk-asm? g) (dk-ass!))
                   ((and (dk-head-is? g '=) (equal? (cadr g) (list 'SCAL g4k-M))) (g4k-scal-eq!))
                   ((dk-head-is? g 'IN) (subst (list '== (list 'VEC g4k-M) g4k-V)) (dk-ass!))
                   ;; homogeneity
                   ((dk-contains? g 'FNRM)
                    (let* ((l (dk-peel!)) (lam (g4k-var l (list 'CARR (list 'SCAL g4k-M)))) (x (g4k-var l (list 'VEC g4k-M))))
                      (g4k-inv! x)
                      (let* ((h1 (dk-rewrite-h! (list 'IN lam (list 'CARR (list 'SCAL g4k-M))) (list 'SCAL g4k-M) g4k-rr)))
                        (dk-rewrite-h! h1 (list 'CARR g4k-rr) 'RR))
                      (dk-apply! (dk-cite! 'module-act-type g4k-M) lam x)
                      (let ((t (list (list 'ACT g4k-M) lam x)))
                        (g4k-inv! t)
                        (g4k-evval! y t) (g4k-evval! y x)
                        (dk-cite! 'rfn-act-value 'u lam x y)
                        (dk-cite! 'hbs-rr-fnrm lam)
                        (dk-cite! 'rr-subset-cc lam)
                        (dk-have! (list 'AND (list 'IN lam 'CC) (list 'IN (list x y) 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                        (dk-cite! 'cc-magnitude-mul lam (list x y))
                        (dk-cite! 'rr-magnitude-is-abs lam)
                        (subst (list '= (g4k-evat t y) (list 'magnitude (list t y))))
                        (subst (list '= (g4k-evat x y) (list 'magnitude (list x y))))
                        (subst (list '= (list t y) (list '* lam (list x y))))
                        (subst (list '= (list '(FNRM RR-NORMED-FIELD) lam) (list 'abs lam)))
                        (subst (list '= (list 'magnitude (list '* lam (list x y))) (list '* (list 'magnitude lam) (list 'magnitude (list x y)))))
                        (subst (list '= (list 'magnitude lam) (list 'abs lam)))
                        (dk-cite! 'rr-abs-closed lam)
                        (dk-cite! 'cc-magnitude-closed (list x y))
                        (rfl))))
                   ;; nonnegativity
                   ((and (dk-head-is? g 'FORALL) (not (dk-contains? g 'VADD)))
                    (let ((x (g4k-var (dk-peel!) (list 'VEC g4k-M))))
                      (g4k-inv! x) (g4k-evval! y x)
                      (subst (list '= (g4k-evat x y) (list 'magnitude (list x y))))
                      (dk-cite! 'cc-magnitude-nonneg (list x y))
                      (dk-ass!)))
                   ;; the triangle inequality
                   (#t
                    (let* ((l (dk-peel!)) (xs (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC g4k-M)))) l))
                           (x (cadr (car xs))) (z (cadr (cadr xs))) (t (list (list 'VADD g4k-M) x z)))
                      (g4k-inv! x) (g4k-inv! z)
                      (dk-apply! (dk-cite! 'module-vadd-type g4k-M) x z)
                      (g4k-inv! t)
                      (g4k-evval! y t) (g4k-evval! y x) (g4k-evval! y z)
                      (dk-cite! 'rfn-vadd-value 'u x z y)
                      (subst (list '= (g4k-evat t y) (list 'magnitude (list t y))))
                      (subst (list '= (g4k-evat x y) (list 'magnitude (list x y))))
                      (subst (list '= (g4k-evat z y) (list 'magnitude (list z y))))
                      (subst (list '= (list t y) (list '+ (list x y) (list z y))))
                      (dk-have! (list 'AND (list 'IN (list x y) 'CC) (list 'IN (list z y) 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                      (dk-cite! 'cc-magnitude-triangle (list x y) (list z y))
                      (dk-ass!)))))))))
        ;; the family separates points
        (#t
         (let* ((l (dk-peel!)) (x (g4k-var l (list 'VEC g4k-M))))
           (g4k-inv! x)
           (let ((hz (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h x) (dk-contains? h 'EVAL-SEMINORMS))) "the vanishing")))
             (subst (list '== (list 'VZERO g4k-M) g4k-vzero))
             (dk-fun-ext! x g4k-vzero 'u 'CC #f (g4k-lam-typer '())
               (lambda (w)
                 (g4k-beta!)
                 (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                     (begin
                       (dk-apply! hz w)
                       (g4k-evval! w x)
                       (let ((iff (dk-cite! 'cc-magnitude-zero-iff (list x w))))
                         (dk-have! (list '= (list 'magnitude (list x w)) 0)
                           (lambda () (subst (list '= (list 'magnitude (list x w)) (g4k-evat x w))) (dk-ass!)))
                         (if (dk-only! iff (list '= (list 'magnitude (list x w)) 0)) (prop))))))))))))))
(g4k-qed! 'eval-seminorms-family)

;;; ---- the locally convex space (RFN-MODULE(u), RFN-TOP(u)) --------------------------------------------------
(define g4k-SNT (list 'SEMINORM-TOP g4k-M 'u g4k-ESN))
(sp (make-wff (list 'FORALL 'u (list '== '(RFN-TOP u) g4k-SNT))))
(di) (mac 'RFN-TOP) (if (not (proof-done? *ps*)) (qrfl))
(g4k-qed! 'rfn-top-unfold)
(sp (g4k-su (list 'IS-LOCALLY-CONVEX-TVS g4k-M '(RFN-TOP u))))
(dk-peel!)
(dk-cite! 'eval-seminorms-family 'u)
(dk-cite! 'seminorm-top-locally-convex g4k-M 'u g4k-ESN)
(dk-cite! 'rfn-top-unfold 'u)
(subst (list '== '(RFN-TOP u) g4k-SNT))
(dk-ass!)
(g4k-qed! 'rfn-top-locally-convex)
(sp (g4k-su (g4k-fa 'g4kf_ g4k-V (g4k-fa 'g4ky_ 'u
  (list '= '(((VNEG (RFN-MODULE u)) g4kf_) g4ky_) '(- (g4kf_ g4ky_)))))))
(dk-peel!)
(dk-cite! 'rfn-module-vneg 'u)
(subst (list '== (list 'VNEG g4k-M) g4k-vneg))
(g4k-beta!) (if (not (proof-done? *ps*)) (g4k-beta!))
(if (not (proof-done? *ps*))
    (begin (dk-cite! 'fun-apply-type-c 'g4kf_ 'u 'CC 'g4ky_) (dk-cite! 'cc-neg-closed '(g4kf_ g4ky_)) (rfl)))
(g4k-qed! 'rfn-vneg-value)

;;; ---- one constraint [y, BALL(c, r)] of the product CC^u -----------------------------------------------------
(define g4k-MT '(METRIC-TOP CC-MS))
(define g4k-CF (list 'VNB-LAMBDA 'bgx_ 'u g4k-MT))
(define g4k-PRP (list 'TPROD-PTS 'u g4k-CF))
(define g4k-PR (list 'TPRODUCT-TOP 'u g4k-CF))
(define g4k-K (list 'TPROD-CONSTR 'u g4k-CF))
(define (g4k-cfy! y)
  (let ((e (list '= (list g4k-CF y) g4k-MT)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))
(define (g4k-ball-open! c r)           ; c in CC, POS-RR r: BALL(CC-MS, c, r) in OPENS(METRIC-TOP CC-MS)
  (let ((bl (list 'BALL 'CC-MS c r)) (pr (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))))
    (dk-cite! 'cc-is-metric-space) (dk-cite! 'cc-ms@pts)
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
    (let ((iff (dk-cite! 'pos-rr r)))
      (if (not (dk-asm? pr)) (dk-have! pr (lambda () (if (dk-only! iff (list 'POS-RR r)) (prop))))))
    (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) c r)
    (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'CC-MS) bl)))
      (dk-have! (list 'IN bl (list 'OPENS g4k-MT)) (lambda () (if (dk-only! oi (list 'IS-OPEN 'CC-MS bl)) (prop)))))
    bl))
(sp (g4k-su (g4k-fa 'g4ky_ 'u (g4k-fa 'g4kc_ 'CC (list 'FORALL 'g4kr_ (list 'IMPLIES '(POS-RR g4kr_)
   (list 'IN '(LIST g4ky_ (BALL CC-MS g4kc_ g4kr_)) g4k-K)))))))
(dk-peel!)
(let* ((bl (g4k-ball-open! 'g4kc_ 'g4kr_)) (w (list 'LIST 'g4ky_ bl))
       (bu (list 'BIG-UNION 'tpj_ 'u (list 'OPENS (list g4k-CF 'tpj_))))
       (im (dk-cite! 'tprod-constr-mem 'u g4k-CF w)))
  (g4k-cfy! 'g4ky_)
  (dk-have! (list 'IN bl (list 'OPENS (list g4k-CF 'g4ky_))) (lambda () (subst (g4k-cfy! 'g4ky_)) (dk-ass!)))
  (dk-have! (list 'IN bl bu) (lambda () (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi 'g4ky_))))))
  (dk-cite! 'pair-in-cartesian 'u bu 'g4ky_ bl)
  (dk-have! (list 'IN (list 'NTH 2 w) (list 'OPENS (list g4k-CF (list 'NTH 1 w))))
    (lambda () (nth-r) (if (dk-contains? (dk-goal) 'NTH) (nth-r)) (dk-ass!)))
  (dk-have! (list 'AND (list 'IN w (list 'CARTESIAN 'u bu)) (list 'IN (list 'NTH 2 w) (list 'OPENS (list g4k-CF (list 'NTH 1 w)))))
    (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (if (dk-only! im (caddr im)) (prop)))
(g4k-qed! 'cc-product-ball-constraint)

;;; ---- every open set of RFN-TOP(u) is open in the product CC^u ----------------------------------------------
(define (g4k-posand! r)                ; POS-RR r in context: (AND (IN r RR) (AND (<= 0 r) (NOT (= 0 r))))
  (let ((pr (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))))
    (if (not (dk-asm? pr))
        (let ((iff (dk-cite! 'pos-rr r)))
          (dk-have! pr (lambda () (if (dk-only! iff (list 'POS-RR r)) (prop))))))
    pr))
(define (g4k-iff-get! iff have want)   ; IFF in context, HAVE in context: land WANT by prop
  (if (not (dk-asm? want)) (dk-have! want (lambda () (if (dk-only! iff have) (prop))))) want)
(define (g4k-psetup!)
  (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS) (dk-cite! 'cc-metric-top-pts)
  (dk-cite! 'cc-product-family 'u)
  (dk-split! (dk-cite! 'tprod-sets 'u g4k-CF))
  (dk-cite! 'tprod-top-pts 'u g4k-CF)
  (dk-cite! 'tprod-top-is-top-space 'u g4k-CF))

(sp (g4k-su (list 'FORALL 'g4kO_ (list 'IMPLIES '(IN g4kO_ (OPENS (RFN-TOP u))) (list 'IN 'g4kO_ (list 'OPENS g4k-PR))))))
(dk-peel!)
(g4k-msetup!)
(g4k-psetup!)
(dk-cite! 'eval-seminorms-family 'u)
(dk-cite! 'rfn-top-unfold 'u)
(let* ((hw (dk-rewrite-h! '(IN g4kO_ (OPENS (RFN-TOP u))) '(RFN-TOP u) g4k-SNT))
       (vm (list 'VEC g4k-M))
       (snb (lambda (f fset e) (list 'SN-BALL g4k-M g4k-ESN fset f e))))
  (dk-have! (list 'IN vm 'SET) (lambda () (subst (list '== vm g4k-V)) (dk-ass!)))
  (let* ((iff (dk-cite! 'is-sn-open g4k-M 'u g4k-ESN 'g4kO_))
         (op (cadr iff)))
    (dk-cite! 'sntop-opens g4k-M 'u g4k-ESN)
    (let ((m (dk-rewrite-h! hw (list 'OPENS g4k-SNT) (list 'SEP 'snu_ (list 'POWER vm) (list 'IS-SN-OPEN g4k-M 'u g4k-ESN 'snu_)))))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))
    (g4k-iff-get! iff op (list 'SUBSET 'g4kO_ vm)))
  (dk-have! (list 'SUBSET 'g4kO_ (list 'PTS g4k-PR))
    (lambda () (mac 'subset-def)
      (let ((z (g4k-var (dk-peel!) 'g4kO_)))
        (dk-cite! 'subset-mem-fwd 'g4kO_ vm z) (g4k-inv! z)
        (dk-cite! 'fun-in-cc-product 'u z)
        (subst (list '== (list 'PTS g4k-PR) g4k-PRP)) (dk-ass!))))
  (let ((ch (dk-cite! 'top-open-of-local g4k-PR 'g4kO_)))
    (detach-with! ch
      (lambda ()
        (let* ((f (g4k-var (dk-peel!) 'g4kO_))
               (ex (dk-cite! 'sntop-open-basic 'RR-NORMED-FIELD g4k-M 'u g4k-ESN 'g4kO_ f))
               (fset (dk-skolem! ex #t))
               (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h fset) (dk-contains? h 'SN-BALL))) "the radius"))
               (e (dk-skolem! ex2 #t))
               (phi (list 'VNB-LAMBDA 'g4kby_ fset (list 'LIST 'g4kby_ (list 'BALL 'CC-MS (list f 'g4kby_) e))))
               (bb (list 'IMAGE phi fset))
               (box (list 'TPROD-BOX 'u g4k-CF bb))
               (ball-at (lambda (y) (list 'BALL 'CC-MS (list f y) e)))
               (pv (lambda (y)        ; y in fset: (= (phi y) (LIST y ball)) and the ball's facts
                     (let ((eq1 (list '= (list phi y) (list 'LIST y (ball-at y)))))
                       (dk-cite! 'subset-mem-fwd fset 'u y)
                       (dk-cite! 'fun-apply-type-c f 'u 'CC y)
                       (g4k-ball-open! (list f y) e)
                       (if (not (dk-asm? eq1)) (dk-have! eq1 (lambda () (if (not (dk-lam-b!)) (rfl)))))
                       eq1)))
               (decomp (lambda (c)     ; c in bb: returns the index x with (= c (LIST x ball)) landed
                         (let* ((iff (dk-cite! 'image-membership-iff phi fset c))
                                (r (g4k-iff-get! iff (list 'IN c bb) (caddr iff))))
                           (dk-split! r)
                           (let* ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h c) (dk-contains? h fset))) "the index") #t))
                                  (eq1 (pv x)))
                             (dk-have! (list '= c (list 'LIST x (ball-at x)))
                               (lambda () (subst (list '= c (list phi x))) (dk-ass!)))
                             x)))))
          (dk-cite! 'subset-mem-fwd 'g4kO_ vm f) (g4k-inv! f)
          (g4k-posand! e)
          ;; the constraints, the box is open
          (dk-have! (list 'SUBSET bb g4k-K)
            (lambda () (mac 'subset-def)
              (let* ((c (g4k-var (dk-peel!) bb)) (x (decomp c)))
                (dk-cite! 'cc-product-ball-constraint 'u x (list f x) e)
                (subst (list '= c (list 'LIST x (ball-at x))))
                (dk-ass!))))
          (dk-cite! 'card-image-finite phi fset)
          (dk-cite! 'tprod-box-open 'u g4k-CF bb)
          (ew box)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (dk-ass!))
                  ;; f is in the box
                  ((equal? g (list 'IN f box))
                   (let ((iff (dk-cite! 'tprod-box-mem 'u g4k-CF bb f)))
                     (dk-cite! 'fun-in-cc-product 'u f)
                     (dk-have! (caddr (caddr iff))
                       (lambda ()
                         (let* ((c (g4k-var (dk-peel!) bb)) (x (decomp c)))
                           (subst (list '= c (list 'LIST x (ball-at x))))
                           (nth-r) (if (dk-contains? (dk-goal) 'NTH) (nth-r))
                           (dk-cite! 'cc-ms@pts)
                           (dk-have! (list 'IN (list f x) '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
                           (dk-apply! (dk-cite! 'ball-center-in 'CC-MS) (list f x) e)
                           (dk-ass!))))
                     (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                     (g4k-iff-get! iff (caddr iff) g)))
                  ;; the box lies in the seminorm ball, hence in w
                  (#t
                   (dk-have! (list 'SUBSET box (snb f fset e))
                     (lambda () (mac 'subset-def)
                       (let* ((q (g4k-var (dk-peel!) box))
                              (iff (dk-cite! 'tprod-box-mem 'u g4k-CF bb q))
                              (r (g4k-iff-get! iff (list 'IN q box) (caddr iff))))
                         (dk-split! r)
                         (dk-cite! 'cc-product-fun 'u q)
                         (dk-have! (list 'IN q vm) (lambda () (subst (list '== vm g4k-V)) (dk-ass!)))
                         (let* ((bf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h q) (dk-contains? h bb))) "box clause"))
                                (biff (dk-cite! 'sn-ball-membership g4k-M g4k-ESN fset f e q)))
                           (dk-have! (caddr (caddr biff))
                             (lambda ()
                               (let* ((i (g4k-var (dk-peel!) fset)) (eq1 (pv i)) (pi_ (list phi i)) (lst (list 'LIST i (ball-at i))))
                                 (dk-cite! 'pair-tuple-is-set 'u (list 'OPENS g4k-MT) i (ball-at i))
                                 (dk-rewrite-h! (list 'IN lst 'SET) lst pi_)
                                 (let* ((iiff (dk-cite! 'image-membership-iff phi fset pi_)))
                                   (dk-have! (caddr iiff)
                                     (lambda () (dk-conj-close! (lambda ()
                                       (if (dk-asm? (dk-goal)) (dk-ass!)
                                           (begin (ew i) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (rfl))))))))))
                                   (g4k-iff-get! iiff (caddr iiff) (list 'IN pi_ bb)))
                                 (let* ((h0 (dk-apply! bf pi_))
                                        (h1 (dk-rewrite-h! h0 pi_ lst))
                                        (h2 (dk-nth-h! h1))
                                        (qi (list q i)) (fi (list f i))
                                        (bm (dk-cite! 'ball-membership 'CC-MS fi e qi))
                                        (dle (list '<= (list '(DIST CC-MS) fi qi) e)))
                                   (dk-cite! 'fun-apply-type-c q 'u 'CC i)
                                   (dk-have! dle (lambda () (if (dk-only! bm (list 'IN qi (ball-at i))) (prop))))
                                   (dk-cite! 'cc-ms-dist fi qi)
                                   (dk-rewrite-h! dle (list '(DIST CC-MS) fi qi) (list 'magnitude (list '- fi qi)))
                                   (let* ((nf (list (list 'VNEG g4k-M) f)) (d (list (list 'VADD g4k-M) q nf)))
                                     (dk-apply! (dk-cite! 'module-vneg-type g4k-M) f)
                                     (dk-apply! (dk-cite! 'module-vadd-type g4k-M) q nf)
                                     (g4k-inv! nf) (g4k-inv! d)
                                     (g4k-evval! i d)
                                     (dk-cite! 'rfn-vadd-value 'u q nf i)
                                     (dk-cite! 'rfn-vneg-value 'u f i)
                                     (subst (list '= (g4k-evat d i) (list 'magnitude (list d i))))
                                     (subst (list '= (list d i) (list '+ qi (list nf i))))
                                     (subst (list '= (list nf i) (list '- fi)))
                                     (dk-have! (list '= (list '+ qi (list '- fi)) (list '- qi fi)) (lambda () (mac 'binary-minus-def) (crs)))
                                     (subst (list '= (list '+ qi (list '- fi)) (list '- qi fi)))
                                     (dk-cite! 'cc-magnitude-sub-sym qi fi)
                                     (subst (list '= (list 'magnitude (list '- qi fi)) (list 'magnitude (list '- fi qi))))
                                     (dk-ass!))))))
                           (dk-have! (caddr biff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                           (g4k-iff-get! biff (caddr biff) (list 'IN q (snb f fset e)))))))
                   (dk-cite! 'subset-trans box (snb f fset e) 'g4kO_)
                   (dk-ass!)))))))))))
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'rfn-open-product-open)

;;; ---- compactness passes to a coarser topology (on a subspace) ----------------------------------------------
(define (g4k-sub t s) (list 'SUBSPACE-TOP t s))
(define (g4k-subopens t s) (list 'SEP 'stw_ (list 'POWER s) (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS t)) (list '= 'stw_ (list 'INTERSECTION 'stu_ s))))))
(sp (make-wff (list 'FORALL 'g4kta_ (list 'FORALL 'g4ktb_ (list 'FORALL 'g4ks_
  (list 'IMPLIES (list 'IS-COMPACT-T (g4k-sub 'g4kta_ 'g4ks_))
   (list 'IMPLIES '(IS-TOP-SPACE g4ktb_)
    (list 'IMPLIES '(SUBSET g4ks_ (PTS g4ktb_))
     (list 'IMPLIES '(IN g4ks_ SET)
      (list 'IMPLIES '(FORALL g4kw_ (IMPLIES (IN g4kw_ (OPENS g4ktb_)) (IN g4kw_ (OPENS g4kta_))))
       (list 'IS-COMPACT-T (g4k-sub 'g4ktb_ 'g4ks_))))))))))))
(dk-peel!)
(let* ((s1 (g4k-sub 'g4kta_ 'g4ks_)) (s2 (g4k-sub 'g4ktb_ 'g4ks_))
       (k1 (dk-cite! 'is-compact-t s1))
       (r1 (g4k-iff-get! k1 (list 'IS-COMPACT-T s1) (caddr k1)))
       (k2 (dk-cite! 'is-compact-t s2)))
  (dk-split! r1)
  (dk-cite! 'subspace-top-pts 'g4kta_ 'g4ks_)
  (dk-cite! 'subspace-top-pts 'g4ktb_ 'g4ks_)
  (dk-cite! 'subspace-top-opens 'g4kta_ 'g4ks_)
  (dk-cite! 'subspace-top-opens 'g4ktb_ 'g4ks_)
  (dk-cite! 'subspace-top-is-top-space 'g4ktb_ 'g4ks_)
  (dk-have! (caddr k2)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((l (dk-peel!))
                     (hc (car (filter (lambda (h) (dk-head-is? h 'FORALL)) l)))
                     (c (caddr (cadr (caddr hc))))
                     (hu (car (filter (lambda (h) (dk-head-is? h '==)) l)))
                     (all1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BIG-UNION) (dk-contains? h s1))) "compactness of s1")))
                (dk-rewrite-h! hu (list 'PTS s2) 'g4ks_)
                (dk-have! (list 'FORALL 'g4kv_ (list 'IMPLIES (list 'IN 'g4kv_ c) (list 'IN 'g4kv_ (list 'OPENS s1))))
                  (lambda ()
                    (let* ((v (g4k-var (dk-peel!) c))
                           (h0 (dk-apply! hc v))
                           (h1 (dk-rewrite-h! h0 (list 'OPENS s2) (g4k-subopens 'g4ktb_ 'g4ks_))))
                      (dk-split-all! (dk-landed (lambda () (sep-me h1))))
                      (let* ((st (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'INTERSECTION) (dk-contains? h v))) "the trace") #t)))
                        (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'g4ktb_) (dk-contains? h 'g4kta_) (not (dk-contains? h 'SUBSPACE-TOP)))) "coarser") st)
                        (subst (list '== (list 'OPENS s1) (g4k-subopens 'g4kta_ 'g4ks_)))
                        (for-each (lambda (lf) (dk-focus! lf)
                                    (if (dk-asm? (dk-goal)) (dk-ass!)
                                        (begin (ew st) (dk-conj-close! (lambda () (dk-ass!))))))
                                  (dk-opened (lambda () (sep-mi))))))))
                (dk-have! (list '== (cadr hu) (list 'PTS s1)) (lambda () (subst (list '== (list 'PTS s1) 'g4ks_)) (dk-ass!)))
                (let* ((h2 (dk-apply! all1 c)))
                  (let* ((fx h2)
                         (fs (dk-skolem! fx #t)))
                    (ew fs)
                    (subst (list '== (list 'PTS s2) 'g4ks_))
                    (dk-conj-close! (lambda ()
                      (if (dk-asm? (dk-goal)) (dk-ass!)
                          (begin (dk-rewrite-h! (list '== (cadr (dk-goal)) (list 'PTS s1)) (list 'PTS s1) 'g4ks_) (dk-ass!)))))))))))))
  (g4k-iff-get! k2 (caddr k2) (list 'IS-COMPACT-T s2)))
(if (not (proof-done? *ps*)) (dk-ass!))
(g4k-qed! 'compact-t-coarser-subspace)

