(dk-cite! 'sntop-is-top-space 'RR-NORMED-FIELD g4k-Ma '(VEC a) g4k-ESNa)
(dk-cite! 'sntop-pts g4k-Ma '(VEC a) g4k-ESNa)
(dk-have! (list 'IS-TOP-SPACE g4k-Ta) (lambda () (subst (list '== g4k-Ta (list 'SEMINORM-TOP g4k-Ma '(VEC a) g4k-ESNa))) (dk-ass!)))
(dk-have! (list 'SUBSET g4w-SIG (list 'PTS g4k-Ta))
  (lambda () (subst (list '== g4k-Ta (list 'SEMINORM-TOP g4k-Ma '(VEC a) g4k-ESNa)))
             (subst (list '== (list 'PTS (list 'SEMINORM-TOP g4k-Ma '(VEC a) g4k-ESNa)) (list 'VEC g4k-Ma)))
             (dk-ass!)))
(dk-cite! 'compact-t-coarser-subspace g4w-PR g4k-Ta g4w-SIG)
(if (not (proof-done? *ps*)) (dk-ass!))
