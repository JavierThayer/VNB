       (ii `(ENC-IN ,x (ENC-INTER ,l))) (aa `(ENC-ANDL ,x ,l (LENGTH ,l))) (e `(ENC-IN ,x (NTH ,k ,l)))
       (ff `(ENC-IFF ,ii ,aa)) (g1 `(CTX-ADD ,g ,ff))
       (g3 `(CTX-ADD (CTX-ADD ,g1 (ENC-IMP ,ii ,aa)) (ENC-IMP ,aa ,ii))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-cite! 'ctx-mem g ii)
  (mc-nary-prep! x `(ENC-INTER ,l) l 'clt-inter-elim)
  (dk-have! `(<= 1 (LENGTH ,l)) (lambda () (dk-nn! `(<= 1 ,k) `(<= ,k (LENGTH ,l)))))
  (dk-apply! (dk-cite! 'enc-andl-clf `(LENGTH ,l)) x l)
  (dk-derive! 'tt
    `(cut (,g ==> ,aa)
       (intersection-mem (,g ==> ,ff))
       (iff-elim (,g1 ==> ,aa)
         (backchain (,g3 ==> ,aa)
           (assumption (,g3 ==> ,ii))))))
  (dk-apply! (dk-cite! 'enc-andl-elim-der `(LENGTH ,l)) 'tt g x l k)
  (dk-derive! 'tt
    `(cut (,g ==> ,f)
       (given (,g ==> ,e))
       (given ((CTX-ADD ,g ,e) ==> ,f))))
  (ass))
(qed 'adm-intersection-elim)

