;;; meta-core-laws.scm -- THE CORE OF K2: the laws of well-formedness, sequents, DERIVABLE, and the
;;; admissibility of eight kernel rules (structure-library/meta-core.scm): detach, contraposition,
;;; union-intro (section H, phase 2; their proofs rewritten as dk-derive! trees by META-KIT), and
;;; union-elim, intersection-intro, intersection-elim, tuples-intro, tuples-elim (section J, META-KIT).
;;; (docs/meta-k2-admissibility-2026-10-08.md, section 6, phase 2.)
;;; Agent META-2, 2026-10-08.  Builds on theorem-library/meta-syntax-laws.scm (phase 1).
;;; The helpers this file shares with meta-syntax-laws.scm, and the derivation driver dk-derive!,
;;; are in driver-kit.scm, section META (prefix dk-meta-; agent META-KIT, 2026-10-08); the
;;; helpers defined below are local to this file.
;;; Every theorem below bills `modulo 0'.


;;; -----------------------------------------------------------------------
;;; 0. The encoded constructors as citable equations (mac-h cannot unfold a functoid in an
;;; assumption by its own name; these theorems are what it names).

(define (mc-unfold-law! name params body)
  (sp (make-wff (fold-right (lambda (p g) `(FORALL ,p ,g)) `(== (,name ,@params) ,body) params)))
  (di) (mac name) (qrfl)
  (qed (symbol-append name '-unfold)))

(for-each (lambda (e) (mc-unfold-law! (car e) (cadr e) (caddr e)))
  '((ENC-NOT (p) (EAPP 2 (LIST p)))         (ENC-AND (p q) (EAPP 3 (LIST p q)))
    (ENC-OR (p q) (EAPP 4 (LIST p q)))      (ENC-IMP (p q) (EAPP 5 (LIST p q)))
    (ENC-IFF (p q) (EAPP 6 (LIST p q)))     (ENC-IN (p q) (EAPP 7 (LIST p q)))
    (ENC-EQ (p q) (EAPP 8 (LIST p q)))      (ENC-QEQ (p q) (EAPP 9 (LIST p q)))
    (ENC-UNION (l) (EAPP 11 l))             (CTX-ADD (g a) (UNION g (PAIR a a)))
    (CTX-FV (g) (BIG-UNION mczw_ g (EXPR-FV mczw_)))
    (DERIVABLE (tt) (SEP mczq_ SEQ-SET (FORALL mczs_ (IMPLIES (IN mczs_ (POWER SEQ-SET))
                                           (IMPLIES (CORE-CLOSED tt mczs_) (IN mczq_ mczs_))))))))

;;; -----------------------------------------------------------------------
;;; B. WELL-FORMEDNESS: the structural-recursion laws of the kind map, and its value equations.

(dk-meta-struct-laws! (lambda (n) `(WKS-STAGE ,n)) (lambda (e) `(EXPR-WKS ,e)) '()
                 'wks-stage-zero 'wks-stage-succ 'wks-stage-step 'wks-stage-coh 'expr-wks-at)

;; a stage-0 node: the AT law at 0, the zero equation, one beta
(define (mc-wks0! x stage-law)
  (dk-peel!)
  (fact stage-law (cadr x))
  (fact 'nn-zero-in)
  (subst (dk-cite! 'expr-wks-at 0 x))
  (subst (dk-cite! 'wks-stage-zero))
  (dk-lam-b!)
  (qrfl))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (== (EXPR-WKS (EFVAR n)) (PAIR 1 1))))))
(mc-wks0! '(EFVAR n) 'expr-stage-fvar)
(qed 'wks-efvar)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (== (EXPR-WKS (EBVAR n)) (PAIR 1 1))))))
(mc-wks0! '(EBVAR n) 'expr-stage-bvar)
(qed 'wks-ebvar)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (== (EXPR-WKS (ECONST n)) (PAIR 1 1))))))
(mc-wks0! '(ECONST n) 'expr-stage-const)
(qed 'wks-econst)

(define (mc-wks-elem! k)       ; t in S_k (or in MAKE-SET of a list in TUPLES(S_k)) -> the AT equation
  (lambda (t)                  ; (copied from mx-lcd-elem!, meta-syntax-laws.scm line 2480)
    (if (not (dk-asm? `(IN ,t (EXPR-STAGE ,k))))
        (let ((ml (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) t) (dk-head-is? (caddr f) 'MAKE-SET)))
                              (dk-asms))))
          (dk-meta-type-stages! `(EXPR-STAGE ,k))
          (fact 'makeset-member-in `(EXPR-STAGE ,k) (cadr (caddr ml)) t)))
    (dk-cite! 'expr-wks-at k t)))

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (== (EXPR-WKS (EAPP h l))
       (SEP mczk_ NN (AND (= mczk_ (HD-RES h))
                     (AND (APP-AR-OK h (LENGTH l))
                          (FORALL mczw_ (IMPLIES (IN mczw_ (MAKE-SET l)) (IN (HD-ARGK h) (EXPR-WKS mczw_))))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'l)
(let ((k (dk-meta-new-at! '(EAPP h l))))
  (dk-meta-val-succ! '(EAPP h l) k 'expr-wks-at 'wks-stage-succ '() '(#t)
    (lambda ()
      (dk-meta-nth-r!)
      (let ((g (dk-goal)))
        (subst (dk-meta-sep-eq! (cadr g) (caddr g)
                 (lambda (t) `((WKS-STAGE ,k) ,t)) (lambda (t) `(EXPR-WKS ,t)) (mc-wks-elem! k)))
        (qrfl)))))
(qed 'wks-eapp)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (== (EXPR-WKS (EBIND h nb a b))
         (SEP mczk_ NN (AND (= mczk_ (HD-BRES h))
                       (AND (BIND-SIG h nb (LENGTH a))
                       (AND (FORALL mczw_ (IMPLIES (IN mczw_ (MAKE-SET a)) (IN 1 (EXPR-WKS mczw_))))
                            (IN (HD-BODY h) (EXPR-WKS b)))))))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'a)
(let ((k (dk-meta-new-at! '(EBIND h nb a b))))
  (dk-meta-val-succ! '(EBIND h nb a b) k 'expr-wks-at 'wks-stage-succ '() '(#f)
    (lambda ()
      (dk-meta-nth-r!)
      (let ((g (dk-goal)))
        (subst (dk-meta-sep-eq! (cadr g) (caddr g)
                 (lambda (t) `((WKS-STAGE ,k) ,t)) (lambda (t) `(EXPR-WKS ,t)) (mc-wks-elem! k)))
        (qrfl)))))
(qed 'wks-ebind)

;;; -----------------------------------------------------------------------
;;; C. Inversion: an APP node that is an expression has a numeral head and a list of expressions.

(define (mc-find-in x cls-head landed)  ; the landed (IN x C) whose class is headed CLS-HEAD
  (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) cls-head))) landed)
      (error "mc-find-in: nothing landed in a class headed" cls-head)))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL h (FORALL l
   (IMPLIES (IN (EAPP h l) (EXPR-STAGE n)) (AND (IN h NN) (IN l (TUPLES EXPR-SET))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (let* ((landed (dk-peel!)) (x (cadr (mc-find-in #f 'EXPR-STAGE landed))))
    (dk-meta-or-each! (dk-cite! 'expr-stage-zero-cases x)
      (lambda (d) (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x)))))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "no IH")))
         (mem (mc-find-in #f 'EXPR-STAGE landed))
         (x (cadr mem)) (h (cadr x)) (l (caddr x)) (n (cadr (cadr (caddr mem)))))
    (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases n x)
      (lambda (d)
        (cond
          ((dk-head-is? d 'IN) (dk-apply! ih h l) (ass))
          ((eq? (dk-meta-disjunct-kind d) 'EAPP)
           (let* ((vs (dk-meta-unpack! d)) (h2 (car vs)) (l2 (cadr vs)))
             (dk-split! (dk-cite! 'eapp-injective h l h2 l2))
             (dk-meta-lift-to-expr! l2 n)
             (subst `(= ,h ,h2))
             (subst `(= ,l ,l2))
             (dk-conj-close! (lambda () (ass)))))
          (#t (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x))))))))
(qed 'eapp-stage-inv)

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN (EAPP h l) EXPR-SET) (AND (IN h NN) (IN l (TUPLES EXPR-SET))))))))
(dk-peel!)
(let ((n (dk-meta-set-open! '(EAPP h l))))
  (dk-apply! (dk-cite! 'eapp-stage-inv n) 'h 'l)
  (ass))
(qed 'eapp-expr-inv)

;;; -----------------------------------------------------------------------
;;; D. MAKE-SET of a literal list of one or two entries.

;; close (IN a (MAKE-SET L)) for an entry a of the literal list L (a in SET in context)
(define (mc-ms-entry! a l)
  (mac 'make-set-membership)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'FORSOME)
             (let ((i (let loop ((k 1) (es (cdr l)))
                        (if (equal? (car es) a) k (loop (+ k 1) (cdr es))))))
               (ew i)
               (dk-conj-close!
                 (lambda ()
                   (let ((leaf (proof-state-focus *ps*)))   ; a reduction may close the leaf: no drift
                     (if (dk-contains? (dk-goal) 'NTH) (nth-r))
                     (if (and (not (sequent-node-grounded? leaf)) (dk-contains? (dk-goal) 'LENGTH)) (len-r))
                     (if (not (sequent-node-grounded? leaf))
                         (cond ((dk-asm? (dk-goal)) (ass))
                               ((and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal)))) (rfl))
                               (#t (arith)))))))))
            (#t (error "mc-ms-entry!: no route" (expression->string (dk-goal))))))))

(sp (make-wff '(FORALL a (FORALL b (IMPLIES (IN a SET) (IMPLIES (IN b SET)
   (AND (IN a (MAKE-SET (LIST a b))) (IN b (MAKE-SET (LIST a b))))))))))
(dk-peel!)
(dk-conj-close! (lambda () (mc-ms-entry! (cadr (dk-goal)) '(LIST a b))))
(qed 'ms2-intro)

(sp (make-wff '(FORALL a (IMPLIES (IN a SET) (IN a (MAKE-SET (LIST a)))))))
(dk-peel!)
(mc-ms-entry! 'a '(LIST a))
(qed 'ms1-intro)

;; (IN w (MAKE-SET L)) in context, L a literal list of N entries: land the index i, rewritten so
;; that (= (NTH i L) w) and i <= N are in context; return i.
(define (mc-ms-open! w l)
  (let* ((mem `(IN ,w (MAKE-SET ,l)))
         (iff (begin (fact 'make-set-membership w l) (iff-for mem)))
         (rhs (dk-meta-iff-r! iff))
         (parts (dk-split! rhs))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
         (i (dk-skolem! ex #t))
         (len `(LENGTH ,l)) (n (- (length l) 1)))
    (dk-have! `(= ,len ,n) (lambda () (len-r) (rfl)))
    (dk-rewrite-h! `(<= ,i ,len) len n)
    i))

;; with (= (NTH i L) w) in context and (= i j): land (= (NTH j L) w) reduced, i.e. (= e_j w)
(define (mc-ms-at! i j l w)
  (let ((f (dk-rewrite-h! `(= (NTH ,i ,l) ,w) i j)))
    (dk-nth-h! f)))

(sp (make-wff '(FORALL a (FORALL b (FORALL w (IMPLIES (IN w (MAKE-SET (LIST a b))) (OR (= w a) (= w b))))))))
(dk-peel!)
(let ((i (mc-ms-open! 'w '(LIST a b))))
  (use-em `(= ,i 1)
    (lambda () (mc-ms-at! i 1 '(LIST a b) 'w) (oi-l) (subst '(= w a)) (rfl))
    (lambda ()
      (dk-have! '(IN 1 NN) (lambda () (arith)))
      (dk-cite! 'nn-le-ne-succ 1 i)
      (dk-have! `(= ,i 2) (lambda () (dk-nn! `(<= (succ 1) ,i) `(<= ,i 2))))
      (mc-ms-at! i 2 '(LIST a b) 'w) (oi-r) (subst '(= w b)) (rfl))))
(qed 'ms2-cases)

(sp (make-wff '(FORALL a (FORALL w (IMPLIES (IN w (MAKE-SET (LIST a))) (= w a))))))
(dk-peel!)
(let ((i (mc-ms-open! 'w '(LIST a))))
  (dk-have! `(= ,i 1) (lambda () (dk-nn! `(<= 1 ,i) `(<= ,i 1))))
  (mc-ms-at! i 1 '(LIST a) 'w)
  (subst '(= w a)) (rfl))
(qed 'ms1-cases)

;; The universal U = (FORALL w (IMPLIES (IN w (MAKE-SET L)) P[w])) over a literal list L of one or
;; two entries, each in SET in context: land every P[e].
(define (mc-ms-inst! u l)
  (let ((es (cdr l)))
    (if (not (dk-asm? `(IN ,(car es) (MAKE-SET ,l))))
        (if (= (length es) 2)
            (dk-split! (dk-cite! 'ms2-intro (car es) (cadr es)))
            (dk-cite! 'ms1-intro (car es))))
    (map (lambda (e) (dk-apply! u e)) es)))

;; The goal U: prove it from the P[e] in context.
(define (mc-ms-prove! . opt)
  (let* ((close (if (pair? opt) (car opt) (lambda () (ass))))
         (landed (dk-peel!))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'MAKE-SET))) landed))
         (w (cadr mem)) (l (cadr (caddr mem))) (es (cdr l)))
    (if (= (length es) 2)
        (dk-meta-or-each! (dk-cite! 'ms2-cases (car es) (cadr es) w)
          (lambda (eqn) (subst eqn) (close)))
        (begin (subst (dk-cite! 'ms1-cases (car es) w)) (close)))))

;;; -----------------------------------------------------------------------
;;; E. The sentences and the closed terms; the kinds and the closure of an APP node.


(define (mc-sep-iff-law! def-name)      ; the goal (FORALL e (IFF (IN e C) RHS)), C = SEP by DEF-NAME
  (di)
  (subst (dk-cite! def-name))
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda ()
      (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))
      (dk-split-all!)
      (dk-conj-close! (lambda () (ass))))
    (lambda ()
      (dk-split-all!)
      (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass))))))))

(sp (make-wff '(FORALL e (IFF (IN e CLF) (AND (IN e EXPR-SET) (AND (WF-FML e) (EXPR-LC e)))))))
(mc-sep-iff-law! 'clf-def)
(qed 'clf-iff)
(sp (make-wff '(FORALL e (IFF (IN e CLT) (AND (IN e EXPR-SET) (AND (WF-TERM e) (EXPR-LC e)))))))
(mc-sep-iff-law! 'clt-def)
(qed 'clt-iff)

(sp (make-wff '(FORALL h (FORALL l (FORALL kk (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (IN kk NN)
   (IFF (IN kk (EXPR-WKS (EAPP h l)))
        (AND (= kk (HD-RES h))
             (AND (APP-AR-OK h (LENGTH l))
                  (FORALL mczw_ (IMPLIES (IN mczw_ (MAKE-SET l)) (IN (HD-ARGK h) (EXPR-WKS mczw_)))))))))))))))
(dk-peel!)
(subst (dk-cite! 'wks-eapp 'h 'l))
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda () (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms))) (ass))
  (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
(qed 'wks-eapp-iff)

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (IFF (EXPR-LC (EAPP h l)) (FORALL mczw_ (IMPLIES (IN mczw_ (MAKE-SET l)) (EXPR-LC mczw_))))))))))
(dk-peel!)
(mac 'EXPR-LC)
(subst (dk-cite! 'lcd-eapp 'h 'l))
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  (lambda () (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms))) (ass))
  (lambda () (in-sep! (lambda () (fact 'nn-zero-in) (ass)) (lambda () (ass)))))
(qed 'lc-eapp-iff)

;;; Drivers for the per-head laws.
(define (mc-kind-of cls) (if (eq? cls 'CLF) 2 1))
(define (mc-wf-of cls) (if (eq? cls 'CLF) 'WF-FML 'WF-TERM))

;; e in CLS (CLF or CLT) in context: land e in EXPR-SET, (IN k (EXPR-WKS e)), (EXPR-LC e).
(define (mc-cl-open! e cls)
  (let* ((iff (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e)))
    (dk-split-all! (list (dk-meta-iff-r! iff)))
    (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'wf-fml 'wf-term) e))))

;; the goal (IN e CLS), with e in EXPR-SET, (IN k (EXPR-WKS e)) and (EXPR-LC e) in context.
(define (mc-cl-close! e cls)
  (let ((wf `(,(mc-wf-of cls) ,e)) (goal `(IN ,e ,cls)))
    (if (not (dk-asm? wf)) (dk-meta-iff-l! (dk-meta-iff! (if (eq? cls 'CLF) 'wf-fml 'wf-term) e)))
    (let* ((iff (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e)))
      (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-meta-iff-l! iff)
      (ass))))

;; (= (FN h) VAL) for a head-table functoid FN, its IF resolved on the side TRUE?, the condition
;; closed from PREMS (NN facts in context) by dk-nn!, or by arith when it is ground.
(define (mc-hd! fn h val true? . prems)
  (let ((claim `(= (,fn ,h) ,val)))
    (dk-have! claim
      (lambda ()
        (mac fn)
        (dk-if-branch! true? (cadr (dk-goal))
          (lambda () (if (number? h) (arith) (apply dk-nn! prems)))
          (lambda () (rfl)))))
    claim))

;; THE PER-HEAD LAW.  Goal (after the peel): (IFF (IN E CLS) RHS) with E = (EAPP h L).
;;   HEADS!  lands (= (HD-RES h) k) and (= (HD-ARGK h) argk);  AR!  proves (APP-AR-OK h n) for
;;   the goal with n = (LENGTH L) rewritten;  ACLS the class of the arguments.
;;   L a LITERAL list of 0, 1 or 2 entries: RHS the conjunction of (IN a ACLS) over the entries
;;   (TRUTH-free: a 0-entry list has no IFF, use mc-app-intro0!).
;;   L a symbol: RHS (FORALL w (IMPLIES (IN w (MAKE-SET L)) (IN w ACLS))).
(define (mc-app-law! cls acls heads! ar!)
  (let* ((g (dk-goal)) (e (cadr (cadr g))) (h (cadr e)) (l (caddr e))
         (k (mc-kind-of cls)) (argk (mc-kind-of acls)) (lit? (and (pair? l) (eq? (car l) 'LIST)))
         (es (if lit? (cdr l) '())))
    (if (number? h) (dk-have! `(IN ,h NN) (lambda () (arith))))
    (heads!)
    (fact 'nn-zero-in)
    (dk-have! `(IN ,k NN) (lambda () (arith)))
    (dk-have! `(IN ,argk NN) (lambda () (arith)))
    (if lit?
        (begin
          (for-each (lambda (a) (dk-meta-set-of! a 'EXPR-SET)) es)
          (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-each-leaf! (lambda () (ti)) (lambda () (ass)))))))
    (fact 'eapp-in-expr h l)
    (dk-iff! (lambda (g) (not (and (dk-head-is? g 'IN) (equal? (cadr g) e))))
      ;; forward: E in CLS  =>  the arguments in ACLS
      (lambda ()
        (mc-cl-open! e cls)
        (let* ((kiff (dk-meta-iff! 'wks-eapp-iff h l k))
               (kparts (dk-split-all! (list (dk-meta-iff-r! kiff))))
               (u1 (find-first (lambda (f) (dk-head-is? f 'FORALL)) kparts))
               (u2 (dk-meta-iff-r! (dk-meta-iff! 'lc-eapp-iff h l))))
          (if lit?
              (begin
                (mc-ms-inst! u1 l) (mc-ms-inst! u2 l) 
                (for-each (lambda (a) (dk-rewrite-h! `(IN (HD-ARGK ,h) (EXPR-WKS ,a)) `(HD-ARGK ,h) argk)) es)
                (dk-conj-close! (lambda () (mc-cl-close! (cadr (dk-goal)) acls))))
              (begin
                (dk-peel!)
                (let ((w (cadr (dk-goal))))
                  (dk-apply! u1 w) (dk-apply! u2 w)
                  (dk-rewrite-h! `(IN (HD-ARGK ,h) (EXPR-WKS ,w)) `(HD-ARGK ,h) argk)
                  (fact 'makeset-member-in 'EXPR-SET l w)
                  (mc-cl-close! w acls))))))
      ;; backward: the arguments in ACLS  =>  E in CLS
      (lambda ()
        (dk-split-all!)
        (let* ((u1 `(FORALL mczv_ (IMPLIES (IN mczv_ (MAKE-SET ,l)) (IN (HD-ARGK ,h) (EXPR-WKS mczv_)))))
               (u2 `(FORALL mczv_ (IMPLIES (IN mczv_ (MAKE-SET ,l)) (EXPR-LC mczv_)))))
          (if lit?
              (begin
                (for-each (lambda (a) (mc-cl-open! a acls)) es)
                
                (dk-have! u1 (lambda () (mc-ms-prove! (lambda () (subst `(= (HD-ARGK ,h) ,argk)) (ass)))))
                
                (dk-have! u2 (lambda () (mc-ms-prove! (lambda () (ass)))))
                )
              (let ((all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-head-is? (caddr f) 'IMPLIES)
                                                       (equal? (caddr (cadr (caddr f))) `(MAKE-SET ,l))
                                                       (equal? (caddr (caddr (caddr f))) acls)))
                                     (dk-asms))))
                (dk-have! u1 (lambda () (dk-peel!) (let ((w (cadr (caddr (dk-goal)))))
                                                     (dk-apply! all w) (mc-cl-open! w acls)
                                                     (subst `(= (HD-ARGK ,h) ,argk)) (ass))))
                (dk-have! u2 (lambda () (dk-peel!) (let ((w (cadr (dk-goal))))
                                                     (dk-apply! all w) (mc-cl-open! w acls) (ass))))))
          (let ((kiff (dk-meta-iff! 'wks-eapp-iff h l k)))
            (dk-have! (caddr kiff)
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (let ((g (dk-goal)))
                      (cond ((dk-asm? g) (ass))
                            ((dk-head-is? g '=) (subst `(= (HD-RES ,h) ,k)) (rfl))
                            ((dk-head-is? g 'APP-AR-OK) (ar!))
                            (#t (error "mc-app-law!: no closer for" (expression->string g)))))))))
            (dk-meta-iff-l! kiff))
          (dk-meta-iff-l! (dk-meta-iff! 'lc-eapp-iff h l))
          (mc-cl-close! e cls))))))


;;; The per-head laws.  The binary connectives (3 <= h <= 6), the atomic relations (7 <= h <= 9),
;;; NOT, the n-ary UNION; FALSITY and TRUTH (no argument).
(define (mc-ar-close! . prems)           ; a conjunct of an APP-AR-OK disjunct
  (cond ((dk-asm? (dk-goal)) (ass))
        ((and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal)))) (rfl))
        ((null? prems) (arith))
        (#t (apply dk-nn! prems))))
(define (mc-ar-pick! k . prems)          ; choose the K-th disjunct (0-based) of APP-AR-OK, close it
  (if (and (dk-contains? (dk-goal) 'LENGTH) (dk-contains? (dk-goal) 'LIST)) (len-r))
  (mac 'APP-AR-OK)
  (let loop ((i 0)) (if (< i k) (begin (oi-r) (loop (+ i 1)))))
  (if (and (< k 3) (dk-head-is? (dk-goal) 'OR)) (oi-l))
  (dk-conj-close! (lambda () (apply mc-ar-close! prems))))

(sp (make-wff '(FORALL h (FORALL a (FORALL b (IMPLIES (IN h NN) (IMPLIES (<= 3 h) (IMPLIES (<= h 6)
   (IMPLIES (IN a EXPR-SET) (IMPLIES (IN b EXPR-SET)
     (IFF (IN (EAPP h (LIST a b)) CLF) (AND (IN a CLF) (IN b CLF)))))))))))))
(dk-peel!)
(mc-app-law! 'CLF 'CLF
  (lambda () (mc-hd! 'HD-RES 'h 2 #t '(<= h 6)) (mc-hd! 'HD-ARGK 'h 2 #t '(<= h 6)))
  (lambda () (mc-ar-pick! 3 '(<= 3 h))))
(qed 'clf-conn2)

(sp (make-wff '(FORALL h (FORALL a (FORALL b (IMPLIES (IN h NN) (IMPLIES (<= 7 h) (IMPLIES (<= h 9)
   (IMPLIES (IN a EXPR-SET) (IMPLIES (IN b EXPR-SET)
     (IFF (IN (EAPP h (LIST a b)) CLF) (AND (IN a CLT) (IN b CLT)))))))))))))
(dk-peel!)
(mc-app-law! 'CLF 'CLT
  (lambda () (mc-hd! 'HD-RES 'h 2 #t '(<= h 9)) (mc-hd! 'HD-ARGK 'h 1 #f '(<= 7 h)))
  (lambda () (mc-ar-pick! 3 '(<= 7 h))))
(qed 'clf-rel2)

(sp (make-wff '(FORALL a (IMPLIES (IN a EXPR-SET) (IFF (IN (EAPP 2 (LIST a)) CLF) (IN a CLF))))))
(dk-peel!)
(mc-app-law! 'CLF 'CLF
  (lambda () (mc-hd! 'HD-RES 2 2 #t) (mc-hd! 'HD-ARGK 2 2 #t))
  (lambda () (mc-ar-pick! 2)))
(qed 'clf-not1)

(sp (make-wff '(FORALL l (IMPLIES (IN l (TUPLES EXPR-SET))
   (IFF (IN (EAPP 11 l) CLT) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(dk-peel!)
(mc-app-law! 'CLT 'CLT
  (lambda () (mc-hd! 'HD-RES 11 1 #f) (mc-hd! 'HD-ARGK 11 1 #f))
  (lambda () (mc-ar-pick! 0)))
(qed 'clt-union)

;; A head with no argument: (IN (EAPP h (LIST)) CLF).
(define (mc-app0! h)
  (let ((e `(EAPP ,h (LIST))) (l '(LIST)))
    (dk-have! `(IN ,h NN) (lambda () (arith)))
    (dk-have! '(IN 2 NN) (lambda () (arith)))
    (fact 'empty-in-tuples 'EXPR-SET)
    (fact 'eapp-in-expr h l)
    (mc-hd! 'HD-RES h 2 #t)
    (let ((vac (lambda (close)              ; a universal over MAKE-SET([]) is vacuous
                 (let* ((landed (dk-peel!))
                        (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'MAKE-SET))) landed))
                        (w (cadr mem)))
                   (fact 'make-set-empty)
                   (let ((m2 (dk-rewrite-h! mem '(MAKE-SET (LIST)) 'EMPTY-SET)))
                     (fact 'empty-set-has-no-members w)
                     (ai `(NOT ,m2)))))))
      (let ((kiff (dk-meta-iff! 'wks-eapp-iff h l 2)))
        (dk-have! (caddr kiff)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-head-is? g '=) (subst `(= (HD-RES ,h) 2)) (rfl))
                        ((dk-head-is? g 'APP-AR-OK) (fact 'length-of-empty) (subst '(= (LENGTH (LIST)) 0))
                         (mac 'APP-AR-OK) (oi-r) (oi-l) (dk-conj-close! (lambda () (mc-ar-close!))))
                        (#t (vac #f))))))))
        (dk-meta-iff-l! kiff))
      (let ((liff (dk-meta-iff! 'lc-eapp-iff h l)))
        (dk-have! (caddr liff) (lambda () (vac #f)))
        (dk-meta-iff-l! liff))
      (mc-cl-close! e 'CLF))))

(sp (make-wff '(IN (EAPP 1 (LIST)) CLF)))
(mc-app0! 1)
(qed 'clf-falsity0)
(sp (make-wff '(IN (EAPP 0 (LIST)) CLF)))
(mc-app0! 0)
(qed 'clf-truth0)

;;; The same laws at the encoded constructors, with the expression typings READ OFF the node
;;; (eapp-expr-inv) where the node is given, so that a citation needs nothing but membership.

;; (IN E C) in context, E an EAPP or an ENC- constructor term, C a class inside EXPR-SET (CLF,
;; CLT, EXPR-SET): land the typing of its head, of its list and of each literal entry in EXPR-SET.
(define (mc-enc->eapp t)
  (case (car t)
    ((ENC-NOT) `(EAPP 2 (LIST ,@(cdr t)))) ((ENC-AND) `(EAPP 3 (LIST ,@(cdr t))))
    ((ENC-OR) `(EAPP 4 (LIST ,@(cdr t)))) ((ENC-IMP) `(EAPP 5 (LIST ,@(cdr t))))
    ((ENC-IFF) `(EAPP 6 (LIST ,@(cdr t)))) ((ENC-IN) `(EAPP 7 (LIST ,@(cdr t))))
    ((ENC-EQ) `(EAPP 8 (LIST ,@(cdr t)))) ((ENC-QEQ) `(EAPP 9 (LIST ,@(cdr t))))
    ((ENC-UNION) `(EAPP 11 ,(cadr t)))
    ((ENC-INTER) `(EAPP 12 ,(cadr t))) ((ENC-TUPLES) `(EAPP 14 (LIST ,@(cdr t))))   ; META-KIT
    ((ENC-LIST) `(EAPP 17 ,(cadr t)))
    (else t)))
(define (mc-enc-unfold-name t) (symbol-append (car t) '-unfold))

;; (IN T C) in context with T an ENC- term: land and return (IN (EAPP ..) C).
(define (mc-enc-open-mem! mem)
  (let* ((t (cadr mem)) (e (mc-enc->eapp t)))
    (if (equal? e t) mem
        (begin (apply dk-cite! (mc-enc-unfold-name t) (cdr t))
               (dk-rewrite-h! mem t e)))))

;; (IN e C) in context, e = (EAPP h l), C one of CLF CLT EXPR-SET: land e in EXPR-SET, h in NN,
;; l in TUPLES(EXPR-SET), and every literal entry of l in EXPR-SET.
(define (mc-eapp-type! mem)
  (let* ((e (cadr mem)) (c (caddr mem)) (h (cadr e)) (l (caddr e)))
    (if (not (eq? c 'EXPR-SET))
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! (if (eq? c 'CLF) 'clf-iff 'clt-iff) e)))))
    (dk-split! (dk-cite! 'eapp-expr-inv h l))
    (if (and (pair? l) (eq? (car l) 'LIST))
        (let loop ((i 1) (es (cdr l)))
          (if (pair? es)
              (begin (if (not (dk-asm? `(IN ,(car es) EXPR-SET))) (te `(IN ,l (TUPLES EXPR-SET)) i))
                     (loop (+ i 1) (cdr es))))))))


;;; The laws at the encoded constructors.  ELIM: the node in its class gives its arguments in
;;; theirs, with no expression typing needed (read off the node); INTRO: the converse.
(define (mc-enc-elim! law . pre)         ; goal (AND ..) or (IN ..), the node's membership in context
  (let* ((mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (cadr f))
                                           (memq (car (cadr f)) '(ENC-NOT ENC-AND ENC-OR ENC-IMP ENC-IFF ENC-IN ENC-UNION ENC-INTER ENC-TUPLES ENC-LIST))))
                          (dk-asms)))
         (m2 (mc-enc-open-mem! mem)) (e (cadr m2)) (h (cadr e)) (l (caddr e)))
    (dk-have! `(IN ,h NN) (lambda () (arith)))
    (mc-eapp-type! m2)
    (let ((iff (apply dk-meta-iff! law (append pre (if (and (pair? l) (eq? (car l) 'LIST)) (cdr l) (list l))))))
      (dk-meta-iff-r! iff)
      (ass))))
(define (mc-enc-intro! law cls . pre)    ; goal (IN T CLS), the arguments' memberships in context
  (let* ((t (cadr (dk-goal))) (e (mc-enc->eapp t)) (h (cadr e)) (l (caddr e)))
    (mac (car t))
    (dk-have! `(IN ,h NN) (lambda () (arith)))
    (if (and (pair? l) (eq? (car l) 'LIST))
        (for-each (lambda (a)
                    (let ((c (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) a) (memq (caddr f) '(CLF CLT)))) (dk-asms))))
                      (if (not (dk-asm? `(IN ,a EXPR-SET)))
                          (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! (if (eq? (caddr c) 'CLF) 'clf-iff 'clt-iff) a)))))))
                  (cdr l)))
    (let* ((iff (apply dk-meta-iff! law (append pre (if (and (pair? l) (eq? (car l) 'LIST)) (cdr l) (list l)))))
           (r (caddr iff)))
      (if (not (dk-asm? r)) (dk-have! r (lambda () (dk-conj-close! (lambda () (ass))))))
      (dk-meta-iff-l! iff)
      (ass))))

(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN (ENC-IMP p q) CLF) (AND (IN p CLF) (IN q CLF)))))))
(dk-peel!) (mc-enc-elim! 'clf-conn2 5)
(qed 'clf-imp-elim)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN p CLF) (IMPLIES (IN q CLF) (IN (ENC-IMP p q) CLF)))))))
(dk-peel!) (mc-enc-intro! 'clf-conn2 'CLF 5)
(qed 'clf-imp-intro)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN p CLF) (IMPLIES (IN q CLF) (IN (ENC-OR p q) CLF)))))))
(dk-peel!) (mc-enc-intro! 'clf-conn2 'CLF 4)
(qed 'clf-or-intro)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN p CLF) (IMPLIES (IN q CLF) (IN (ENC-IFF p q) CLF)))))))
(dk-peel!) (mc-enc-intro! 'clf-conn2 'CLF 6)
(qed 'clf-iff-intro)
(sp (make-wff '(FORALL p (IMPLIES (IN p CLF) (IN (ENC-NOT p) CLF)))))
(dk-peel!) (mc-enc-intro! 'clf-not1 'CLF)
(qed 'clf-not-intro)
(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN (ENC-IN x y) CLF) (AND (IN x CLT) (IN y CLT)))))))
(dk-peel!) (mc-enc-elim! 'clf-rel2 7)
(qed 'clf-in-elim)
(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN x CLT) (IMPLIES (IN y CLT) (IN (ENC-IN x y) CLF)))))))
(dk-peel!) (mc-enc-intro! 'clf-rel2 'CLF 7)
(qed 'clf-in-intro)
(sp (make-wff '(FORALL l (IMPLIES (IN (ENC-UNION l) CLT)
   (AND (IN l (TUPLES EXPR-SET)) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(dk-peel!)
(let* ((m2 (mc-enc-open-mem! '(IN (ENC-UNION l) CLT))))
  (dk-have! '(IN 11 NN) (lambda () (arith)))
  (mc-eapp-type! m2)
  (dk-meta-iff-r! (dk-meta-iff! 'clt-union 'l))
  (dk-conj-close! (lambda () (ass))))
(qed 'clt-union-elim)
(sp (make-wff '(IN ENC-FALSITY CLF)))
(subst (dk-cite! 'enc-falsity-def))
(fact 'clf-falsity0) (ass)
(qed 'clf-falsity)

;;; META-KIT: the remaining per-connective laws the well-formedness planner of dk-derive! names
;;; (driver-kit.scm, section META: dk-meta-wf-intros / -elims / -atoms).
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN p CLF) (IMPLIES (IN q CLF) (IN (ENC-AND p q) CLF)))))))
(dk-peel!) (mc-enc-intro! 'clf-conn2 'CLF 3)
(qed 'clf-and-intro)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN (ENC-AND p q) CLF) (AND (IN p CLF) (IN q CLF)))))))
(dk-peel!) (mc-enc-elim! 'clf-conn2 3)
(qed 'clf-and-elim)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN (ENC-OR p q) CLF) (AND (IN p CLF) (IN q CLF)))))))
(dk-peel!) (mc-enc-elim! 'clf-conn2 4)
(qed 'clf-or-elim)
(sp (make-wff '(FORALL p (FORALL q (IMPLIES (IN (ENC-IFF p q) CLF) (AND (IN p CLF) (IN q CLF)))))))
(dk-peel!) (mc-enc-elim! 'clf-conn2 6)
(qed 'clf-iff-elim)
(sp (make-wff '(FORALL p (IMPLIES (IN (ENC-NOT p) CLF) (IN p CLF)))))
(dk-peel!) (mc-enc-elim! 'clf-not1)
(qed 'clf-not-elim)
(sp (make-wff '(IN ENC-TRUTH CLF)))
(subst (dk-cite! 'enc-truth-def))
(fact 'clf-truth0) (ass)
(qed 'clf-truth)

;;; -----------------------------------------------------------------------
;;; F. Contexts and sequents.

(sp (make-wff '(FORALL g (FORALL f (IFF (IN (LIST g f) SEQ-SET) (AND (IN g CTX-SET) (IN f CLF)))))))
(di)
(subst (dk-cite! 'seq-def))
(dk-iff! (lambda (gl) (dk-head-is? gl 'AND))
  (lambda ()
    (let* ((mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'CARTESIAN))) (dk-asms)))
           (gf (cadr mem)) (gg (cadr gf)) (ff (caddr gf))
           (vs (dk-meta-unpack! (dk-meta-cart-open! mem))) (v1 (car vs)) (v2 (cadr vs)))
      (dk-have! `(AND (= ,gg ,v1) (= ,ff ,v2)) (lambda () (dk-meta-components! gf `(LIST ,v1 ,v2))))
      (dk-split-all!)
      (dk-conj-close!
        (lambda () (let ((x (cadr (dk-goal)))) (subst `(= ,x ,(if (equal? x gg) v1 v2))) (ass))))))
  (lambda ()
    (let* ((gf (cadr (dk-goal))))
      (dk-split-all!)
      (fact 'pair-in-cartesian 'CTX-SET 'CLF (cadr gf) (caddr gf))
      (ass))))
(qed 'seq-iff)

(sp (make-wff '(FORALL g (IFF (IN g CTX-SET) (AND (IN g (POWER CLF)) (IN (CARD g) NN))))))
(mc-sep-iff-law! 'ctx-def)
(qed 'ctx-iff)

;; g in CTX-SET in context: land (IN g SET), (IN (CARD g) NN) and the subset universal; return it.
(define (mc-ctx-open! g)
  (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'ctx-iff g))))
  (let ((r (dk-meta-iff-r! (dk-meta-iff! 'power-set-membership 'CLF g))))
    (dk-split-all! (list r))
    (caddr r)))

(sp (make-wff '(FORALL g (FORALL a (IMPLIES (IN g CTX-SET) (IMPLIES (IN a g) (IN a CLF)))))))
(dk-peel!)
(dk-apply! (mc-ctx-open! 'g) 'a)
(ass)
(qed 'ctx-mem)

(sp (make-wff '(FORALL g (FORALL a (IMPLIES (IN a SET) (IN a (CTX-ADD g a)))))))
(dk-peel!)
(mac 'CTX-ADD)
(let ((iff (dk-meta-iff! 'union-membership 'g '(PAIR a a) 'a)))
  (dk-have! (caddr iff) (lambda () (oi-r) (fact 'pair-self-member 'a) (ass)))
  (dk-meta-iff-l! iff) (ass))
(qed 'ctx-add-has)

(sp (make-wff '(FORALL g (FORALL a (FORALL b (IMPLIES (IN a SET) (IMPLIES (IN b g) (IN b (CTX-ADD g a)))))))))
(dk-peel!)
(mac 'CTX-ADD)
(let ((iff (dk-meta-iff! 'union-membership 'g '(PAIR a a) 'b)))
  (dk-have! (caddr iff) (lambda () (oi-l) (ass)))
  (dk-meta-iff-l! iff) (ass))
(qed 'ctx-add-keeps)

(sp (make-wff '(FORALL g (FORALL a (IMPLIES (IN g CTX-SET) (IMPLIES (IN a CLF) (IN (CTX-ADD g a) CTX-SET)))))))
(dk-peel!)
(let ((sub (mc-ctx-open! 'g)) (u '(UNION g (PAIR a a))))
  (dk-meta-set-of! 'a 'CLF)
  (dk-meta-and! '(IN a SET) '(IN a SET))
  (fact 'pairing 'a 'a)
  (dk-meta-and! '(IN g SET) '(IN (PAIR a a) SET))
  (fact 'union-set-closure 'g '(PAIR a a))
  (fact 'card-singleton 'a)
  (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
  (dk-rewrite-h! '(IN (succ 0) NN) '(succ 0) '(CARD (PAIR a a)))
  (fact 'card-union-nn 'g '(PAIR a a))
  (mac 'CTX-ADD)
  (let ((piff (dk-meta-iff! 'power-set-membership 'CLF u)))
    (dk-have! (caddr piff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let* ((landed (dk-peel!)) (z (cadr (dk-goal))))
                  (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership 'g '(PAIR a a) z))
                    (lambda (d)
                      (if (equal? (caddr d) 'g)
                          (begin (dk-apply! sub z) (ass))
                          (begin (subst (dk-cite! 'pair-self-eq 'a z)) (ass)))))))))))
    (dk-meta-iff-l! piff))
  (let ((ciff (dk-meta-iff! 'ctx-iff u)))
    (dk-have! (caddr ciff) (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-meta-iff-l! ciff) (ass)))
(qed 'ctx-add-ctx)

(sp (make-wff '(FORALL g (FORALL a (IMPLIES (IN a SET) (SUBSET g (CTX-ADD g a)))))))
(dk-peel!)
(mac 'subset-def)
(dk-peel!)
(fact 'ctx-add-keeps 'g 'a (cadr (dk-goal)))
(ass)
(qed 'ctx-add-sub)

;;; META-KIT: the two inclusion steps the subset planner of dk-derive! names.
(sp (make-wff '(FORALL d (FORALL g (FORALL a (IMPLIES (IN a SET) (IMPLIES (SUBSET d g) (IMPLIES (IN a g)
   (SUBSET (CTX-ADD d a) g)))))))))
(dk-peel!)
(dk-cite! 'ctx-add-unfold 'd 'a)
(mac 'subset-def)
(dk-peel!)
(let* ((z (cadr (dk-goal)))
       (m (dk-rewrite-h! `(IN ,z (CTX-ADD d a)) '(CTX-ADD d a) '(UNION d (PAIR a a)))))
  (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership 'd '(PAIR a a) z))
    (lambda (dj)
      (if (equal? (caddr dj) 'd)
          (begin (fact 'subset-mem-fwd 'd 'g z) (ass))
          (begin (subst (dk-cite! 'pair-self-eq 'a z)) (ass))))))
(qed 'ctx-sub-cons)

(sp (make-wff '(FORALL d (FORALL g (FORALL b (IMPLIES (IN b SET) (IMPLIES (SUBSET d g)
   (SUBSET d (CTX-ADD g b)))))))))
(dk-peel!)
(fact 'ctx-add-sub 'g 'b)
(fact 'subset-trans 'd 'g '(CTX-ADD g b))
(ass)
(qed 'ctx-sub-snoc)

;;; -----------------------------------------------------------------------
;;; G. DERIVABLE: in SEQ-SET, below every closed subset (the induction principle), closed.

;; (IN s (DERIVABLE tt)) in context: land and return its unfolded SEP membership.
(define (mc-der-open! mem)
  (let ((tt (cadr (caddr mem))))
    (dk-rewrite-h! mem `(DERIVABLE ,tt) (caddr (dk-cite! 'derivable-unfold tt)))))

(sp (make-wff '(FORALL tt (FORALL s (IMPLIES (IN s (DERIVABLE tt)) (IN s SEQ-SET))))))
(dk-peel!)
(sep-me (mc-der-open! '(IN s (DERIVABLE tt))))
(ass)
(qed 'der-in-seq)

(sp (make-wff '(FORALL tt (FORALL mczS_ (FORALL s (IMPLIES (IN mczS_ (POWER SEQ-SET)) (IMPLIES (CORE-CLOSED tt mczS_)
   (IMPLIES (IN s (DERIVABLE tt)) (IN s mczS_)))))))))
(dk-peel!)
(let* ((landed (dk-landed (lambda () (sep-me (mc-der-open! '(IN s (DERIVABLE tt)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mczS_)
  (ass))
(qed 'derivable-induction)

(sp (make-wff '(FORALL tt (FORALL mczS_ (FORALL hs (FORALL c (IMPLIES (CORE-CLOSED tt mczS_) (IMPLIES (CORE-RULE tt hs c)
   (IMPLIES (HYPS-IN hs mczS_) (IMPLIES (IN c SEQ-SET) (IN c mczS_)))))))))))
(dk-peel!)
(dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'core-closed 'tt 'mczS_)) 'hs 'c)
(ass)
(qed 'core-closed-apply)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (CORE-RULE tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt))
   (IMPLIES (IN c SEQ-SET) (IN c (DERIVABLE tt))))))))))
(dk-peel!)
(subst (dk-cite! 'derivable-unfold 'tt))
(in-sep! (lambda () (ass))
  (lambda ()
    (let* ((landed (dk-peel!))
           (ss (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'POWER))) landed))))
      (dk-have! `(HYPS-IN hs ,ss)
        (lambda ()
          (mac 'HYPS-IN)
          (dk-peel!)
          (let* ((i (cadr (cadr (dk-goal))))
                 (u (dk-meta-iff-r! (dk-meta-iff! 'hyps-in 'hs '(DERIVABLE tt)))))
            (dk-apply! u i)
            (dk-cite! 'derivable-induction 'tt ss `(NTH ,i hs))
            (ass))))
      (dk-cite! 'core-closed-apply 'tt ss 'hs 'c)
      (ass))))
(qed 'derivable-closed)

;;; HYPS-IN of a literal list of 0, 1, 2 sequents, and its elimination at an entry.
(sp (make-wff '(FORALL mczS_ (HYPS-IN (LIST) mczS_))))
(di) (mac 'HYPS-IN) (dk-peel!)
(let ((i (cadr (cadr (dk-goal)))))
  (fact 'length-of-empty)
  (dk-rewrite-h! `(<= ,i (LENGTH (LIST))) '(LENGTH (LIST)) 0)
  (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,i) `(<= ,i 0))))
  (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
  (ai '(NOT (<= 1 0))))
(qed 'hyps-in-0)

(define (mc-hyps-in-lit! l)              ; goal (HYPS-IN L S), L literal, every entry in S in context
  (mac 'HYPS-IN) (dk-peel!)
  (let* ((i (cadr (cadr (dk-goal)))) (n (- (length l) 1)) (len `(LENGTH ,l)))
    (dk-have! `(= ,len ,n) (lambda () (len-r) (rfl)))
    (dk-rewrite-h! `(<= ,i ,len) len n)
    (let ((at (lambda (j) (subst `(= ,i ,j)) (nth-r) (ass))))
      (let loop ((j 1))
        (if (= j n)
            (begin (dk-have! `(= ,i ,n) (lambda () (dk-nn! `(<= ,n ,i) `(<= ,i ,n)))) (at n))
            (use-em `(= ,i ,j)
              (lambda () (at j))
              (lambda ()
                (dk-have! `(IN ,j NN) (lambda () (arith)))
                (dk-cite! 'nn-le-ne-succ j i)
                (dk-have! `(<= ,(+ j 1) ,i) (lambda () (dk-nn! `(<= (succ ,j) ,i))))
                (loop (+ j 1)))))))))

(sp (make-wff '(FORALL s1 (FORALL mczS_ (IMPLIES (IN s1 mczS_) (HYPS-IN (LIST s1) mczS_))))))
(dk-peel!) (mc-hyps-in-lit! '(LIST s1))
(qed 'hyps-in-1)
(sp (make-wff '(FORALL s1 (FORALL s2 (FORALL mczS_ (IMPLIES (IN s1 mczS_) (IMPLIES (IN s2 mczS_) (HYPS-IN (LIST s1 s2) mczS_))))))))
(dk-peel!) (mc-hyps-in-lit! '(LIST s1 s2))
(qed 'hyps-in-2)

;; META-4 repair (round 3): the macete instantiation at (LIST s1) now owes (LIST s1) = (LIST s1);
;; under the list doctrine that holds only when s1 is a set, so the definedness of the list is an
;; antecedent.  Every citer holds hs = (LIST s1), which certifies it.
(sp (make-wff '(FORALL s1 (FORALL mczS_ (IMPLIES (= (LIST s1) (LIST s1)) (IMPLIES (HYPS-IN (LIST s1) mczS_) (IN s1 mczS_)))))))
(dk-peel!)
(let ((u (dk-landed-1 (lambda () (mac-h 'hyps-in '(HYPS-IN (LIST s1) mczS_))))))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (dk-have! '(<= 1 1) (lambda () (arith)))
  (dk-have! '(<= 1 (LENGTH (LIST s1))) (lambda () (len-r) (arith)))
  (dk-nth-h! (dk-apply! u 1))
  (ass))
(qed 'hyps-in-1-elim)

;;; One closure law per core relation, in the form a proof cites:
;;;   CR(T, hs, c), the hypotheses derivable, c a sequent  =>  c derivable.
(define mc-core-names
  '(CR-AND-INTRO CR-AND-ELIM CR-OR-INTRO-LEFT CR-OR-INTRO-RIGHT CR-OR-ELIM CR-IMPLIES-INTRO CR-BACKCHAIN
    CR-NOT-INTRO CR-NOT-ELIM CR-IFF-INTRO CR-IFF-ELIM CR-FORALL-INTRO CR-FORALL-ELIM CR-FORSOME-INTRO
    CR-FORSOME-ELIM CR-ASSUMPTION CR-THEOREM-ASSUMPTION CR-CUT CR-WEAKENING CR-CONTRADICTION CR-TRUTH-INTRO
    CR-EQ-SUBST CR-REFLEXIVITY CR-QUASI-REFLEXIVITY
    CR-UNION-MEM CR-INTERSECTION-MEM CR-CARTESIAN-MEM CR-TUPLES-MEM CR-NTH-EQ CR-LENGTH-EQ CR-TUPLE-EQ
    CR-IF-TRUE CR-IF-FALSE
    CR-SEP-SETHOOD CR-SEP-MEM CR-COMP-MEM CR-BIG-UNION-SETHOOD CR-BIG-UNION-MEM CR-IOTA-DEF CR-IOTA-IN-ELIM
    CR-LAMBDA-TYPE CR-LAMBDA-BETA-EQ
    ;; META-6, 2026-10-13 (the user's decision): the other orientation of eq-subst, and the five
    ;; definedness schemas admitted into the core (structure-library/meta-core.scm, 4.2 and 4.7).
    CR-EQ-SUBST-SYM
    CR-DEF-STRICT-IN-L CR-DEF-STRICT-IN-R CR-DEF-TOTAL CR-DEF-BINDER CR-DEF-COMP CR-DEF-LIST
    ;; META-7, 2026-10-14 (the user's decision): the strictness of the constructors in their arguments
    ;; and of the binder terms in their domain (structure-library/meta-core.scm 4.7, (6) and (7)).
    CR-DEF-STRICT-ARG CR-DEF-STRICT-DOM
    ;; META-10, 2026-10-17 (the user's decision): the strictness of a predicate application
    ;; (structure-library/meta-core.scm 4.7, (8)).
    CR-DEF-STRICT-PRED
    ;; IOTA-CR, 2026-10-20 (the user's decision of 2026-10-15 / 10-16): the congruence rule for
    ;; descriptions (structure-library/meta-core.scm 4.8), the last disjunct of CORE-RULE.
    CR-IOTA-CR))
(define (mc-or-pick! target)
  (let loop ()
    (let ((g (dk-goal)))
      (cond ((eq? #t (vnb-guard (lambda () (alpha-equiv? g target)))) (ass))
            ((and (dk-head-is? g 'OR) (eq? #t (vnb-guard (lambda () (alpha-equiv? (cadr g) target))))) (oi-l) (ass))
            ((dk-head-is? g 'OR) (oi-r) (loop))
            (#t (error "mc-or-pick!: the relation is not a disjunct of CORE-RULE" target))))))
(define (mc-closure-law! cr)
  (sp (make-wff `(FORALL tt (FORALL hs (FORALL c (IMPLIES (,cr tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt))
                   (IMPLIES (IN c SEQ-SET) (IN c (DERIVABLE tt))))))))))
  (dk-peel!)
  (dk-have! '(CORE-RULE tt hs c) (lambda () (mac 'CORE-RULE) (mc-or-pick! `(,cr tt hs c))))
  (dk-cite! 'derivable-closed 'tt 'hs 'c)
  (ass)
  (qed (dk-meta-law-name cr)))
(for-each mc-closure-law! mc-core-names)

;;; THE CONTROL OF IOTA-CR (structure-library/meta-core.scm 4.8): the relation has no instance whose
;;; conclusion is the STRICT equation IOTA p = IOTA q (head 8): every instance concludes the quasi-equation
;;; (head 9).  The strict form would assert that both descriptions denote, which is false for two empty
;;; conditions.  (The typings make the conclusion sequent a term the certificate accepts, so that the
;;; relation's defining equivalence can be instantiated at it.)
(sp (make-wff '(FORALL tt (FORALL hs (FORALL g (FORALL a (FORALL b (IMPLIES (IN g CTX-SET)
   (IMPLIES (IN (ENC-IOTA a) CLT) (IMPLIES (IN (ENC-IOTA b) CLT)
     (NOT (CR-IOTA-CR tt hs (LIST g (ENC-EQ (ENC-IOTA a) (ENC-IOTA b)))))))))))))))
(dk-peel!)
(if (dk-head-is? (dk-goal) 'NOT) (di))
(let* ((c '(LIST g (ENC-EQ (ENC-IOTA a) (ENC-IOTA b))))
       (ex (dk-meta-iff-r! (dk-meta-iff! 'cr-iota-cr 'tt 'hs c)))
       (vs (dk-meta-unpack! ex))
       (ceq (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) c))) (dk-asms)))
       (c2 (caddr ceq)) (lhs (caddr c)) (rhs (caddr c2)))
  (dk-have! `(= ,lhs ,rhs) (lambda () (dk-meta-component! c c2 2)))
  (let* ((u1 (dk-cite! 'enc-eq-unfold (cadr lhs) (caddr lhs))) (e1 (caddr u1))
         (f1 (dk-rewrite-h! `(= ,lhs ,rhs) lhs e1))
         (u2 (dk-cite! 'enc-qeq-unfold (cadr rhs) (caddr rhs))) (e2 (caddr u2))
         (f2 (dk-rewrite-h! f1 rhs e2)))
    (dk-split! (dk-cite! 'eapp-injective 8 (caddr e1) 9 (caddr e2))))
  (dk-have! '(NOT (= 8 9)) (lambda () (arith)))
  (ai '(NOT (= 8 9))))
(qed 'iota-cr-refuses-eq)

;;; The closure laws the admissibility proofs cite, in CONCRETE form: the sequents written out,
;;; the side conditions as hypotheses, the conclusion a sequent.
(define (mc-concrete! cr ws hs-elems)    ; goal (IN C (DERIVABLE tt)) after the peel
  (let* ((c (cadr (dk-goal))) (hs `(LIST ,@hs-elems)))
    (dk-have! `(,cr tt ,hs ,c) (lambda () (mac cr) (dk-meta-ex-fill! ws)))
    (dk-have! `(HYPS-IN ,hs (DERIVABLE tt))
      (lambda ()
        (case (length hs-elems)
          ((0) (fact 'hyps-in-0 '(DERIVABLE tt)))
          ((1) (fact 'hyps-in-1 (car hs-elems) '(DERIVABLE tt)))
          ((2) (fact 'hyps-in-2 (car hs-elems) (cadr hs-elems) '(DERIVABLE tt))))
        (ass)))
    (dk-cite! (dk-meta-law-name cr) 'tt hs c)
    (ass)))

(sp (make-wff '(FORALL tt (FORALL g (FORALL a (IMPLIES (IN (LIST g a) SEQ-SET) (IMPLIES (IN a g)
   (IN (LIST g a) (DERIVABLE tt)))))))))
(dk-peel!) (mc-concrete! 'CR-ASSUMPTION '(g a) '())
(qed 'derivable-assumption-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL a (IMPLIES (IN (LIST g f) SEQ-SET) (IMPLIES (IN (ENC-IMP a f) g)
   (IMPLIES (IN (LIST g a) (DERIVABLE tt)) (IN (LIST g f) (DERIVABLE tt)))))))))))
(dk-peel!) (mc-concrete! 'CR-BACKCHAIN '(g f a) '((LIST g a)))
(qed 'derivable-backchain-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL a (IMPLIES (IN (LIST g f) SEQ-SET) (IMPLIES (IN (LIST g a) (DERIVABLE tt))
   (IMPLIES (IN (LIST (CTX-ADD g a) f) (DERIVABLE tt)) (IN (LIST g f) (DERIVABLE tt)))))))))))
(dk-peel!) (mc-concrete! 'CR-CUT '(g f a) '((LIST g a) (LIST (CTX-ADD g a) f)))
(qed 'derivable-cut-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL d (IMPLIES (IN (LIST g f) SEQ-SET) (IMPLIES (SUBSET d g)
   (IMPLIES (IN (LIST d f) (DERIVABLE tt)) (IN (LIST g f) (DERIVABLE tt)))))))))))
(dk-peel!) (mc-concrete! 'CR-WEAKENING '(g f d) '((LIST d f)))
(qed 'derivable-weakening-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL a (IMPLIES (IN (LIST g (ENC-NOT a)) SEQ-SET)
   (IMPLIES (IN (LIST (CTX-ADD g a) ENC-FALSITY) (DERIVABLE tt)) (IN (LIST g (ENC-NOT a)) (DERIVABLE tt)))))))))
(dk-peel!) (mc-concrete! 'CR-NOT-INTRO '(g a) '((LIST (CTX-ADD g a) ENC-FALSITY)))
(qed 'derivable-not-intro-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL a (IMPLIES (IN (LIST g f) SEQ-SET) (IMPLIES (IN (ENC-NOT a) g)
   (IMPLIES (IN a g) (IN (LIST g f) (DERIVABLE tt)))))))))))
(dk-peel!) (mc-concrete! 'CR-NOT-ELIM '(g f a) '())
(qed 'derivable-not-elim-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST g (ENC-OR a b)) SEQ-SET)
   (IMPLIES (IN (LIST g a) (DERIVABLE tt)) (IN (LIST g (ENC-OR a b)) (DERIVABLE tt))))))))))
(dk-peel!) (mc-concrete! 'CR-OR-INTRO-LEFT '(g a b) '((LIST g a)))
(qed 'derivable-or-intro-left-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST g (ENC-OR a b)) SEQ-SET)
   (IMPLIES (IN (LIST g b) (DERIVABLE tt)) (IN (LIST g (ENC-OR a b)) (DERIVABLE tt))))))))))
(dk-peel!) (mc-concrete! 'CR-OR-INTRO-RIGHT '(g a b) '((LIST g b)))
(qed 'derivable-or-intro-right-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL a (FORALL b (IMPLIES (IN (LIST g f) SEQ-SET) (IMPLIES (IN (ENC-IFF a b) g)
   (IMPLIES (IN (LIST (CTX-ADD (CTX-ADD g (ENC-IMP a b)) (ENC-IMP b a)) f) (DERIVABLE tt))
            (IN (LIST g f) (DERIVABLE tt))))))))))))
(dk-peel!) (mc-concrete! 'CR-IFF-ELIM '(g f a b) '((LIST (CTX-ADD (CTX-ADD g (ENC-IMP a b)) (ENC-IMP b a)) f)))
(qed 'derivable-iff-elim-c)

(sp (make-wff '(FORALL tt (FORALL g (FORALL x (FORALL l
   (IMPLIES (IN (LIST g (ENC-IFF (ENC-IN x (ENC-UNION l)) (ENC-ORL x l (LENGTH l)))) SEQ-SET)
            (IN (LIST g (ENC-IFF (ENC-IN x (ENC-UNION l)) (ENC-ORL x l (LENGTH l)))) (DERIVABLE tt)))))))))
(dk-peel!) (mc-concrete! 'CR-UNION-MEM '(g x l) '())
(qed 'derivable-union-mem-c)

;;; -----------------------------------------------------------------------
;;; H. THE FIRST THREE ADMISSIBILITY THEOREMS (design note, section 3).

;; Unpack REL-<name>(tt, hs, c): return the witnesses; c and hs are rewritten away: the goal
;; becomes the conclusion sequent's derivability, the one hypothesis sequent's derivability
;; lands, and the conclusion's SEQ-SET membership is in context.
(define (mc-rel-open! rel)
  (let* ((r (dk-meta-iff-r! (dk-meta-iff! rel 'tt 'hs 'c)))
         (parts (dk-split! r))
         (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
         (ceq (dk-meta-eq-of 'c)) (heq (dk-meta-eq-of 'hs)))
    (subst ceq)
    (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
    (let* ((h2 (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs (caddr heq)))
           (s1 (cadr (cadr h2))))
      (dk-have! `(= (LIST ,s1) (LIST ,s1)) (lambda () (rfl)))
      (dk-cite! 'hyps-in-1-elim s1 '(DERIVABLE tt))
      (dk-cite! 'der-in-seq 'tt s1))
    vs))

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-DETACH tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mc-rel-open! 'rel-detach))
       (g (car vs)) (f (cadr vs)) (p (caddr vs)) (q (cadddr vs)))
  (dk-derive! 'tt
    `(cut (,g ==> ,f)
       (backchain (,g ==> ,q)
         (assumption (,g ==> ,p)))
       (given ((CTX-ADD ,g ,q) ==> ,f))))
  (ass))
(qed 'adm-detach)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-CONTRAPOSITION tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mc-rel-open! 'rel-contraposition))
       (g (car vs)) (p (cadr vs)) (q (caddr vs))
       (g1 `(CTX-ADD ,g ,p)) (g2 `(CTX-ADD ,g1 ,q)) (g3 `(CTX-ADD ,g2 (ENC-NOT ,q))))
  (dk-derive! 'tt
    `(not-intro (,g ==> (ENC-NOT ,p))
       (cut (,g1 ==> ENC-FALSITY)
         (backchain (,g1 ==> ,q)
           (assumption (,g1 ==> ,p)))
         (cut (,g2 ==> ENC-FALSITY)
           (weakening (,g2 ==> (ENC-NOT ,q))
             (given (,g ==> (ENC-NOT ,q))))
           (not-elim (,g3 ==> ENC-FALSITY) (a := ,q))))))
  (ass))
(qed 'adm-contraposition)

;;; union-intro: the n-ary UNION meets the binary OR through union-mem, whose right side is
;;; ENC-ORL(x, l, n), the left-nested disjunction over the first n entries; it is reached from the
;;; k-th disjunct by an induction on n (k <= n <= |l|): or-intro-right at n = k, or-intro-left above.

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL x (FORALL l
   (IMPLIES (IN x CLT) (IMPLIES (IN l (TUPLES EXPR-SET))
   (IMPLIES (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT)))
   (IMPLIES (<= n (LENGTH l)) (IN (ENC-ORL x l n) CLF)))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((g (dk-goal)) (o (cadr g)) (x (cadr o)) (l (caddr o)))
    (subst (dk-cite! 'enc-orl-zero x l))
    (fact 'clf-falsity) (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-ORL))) landed))
         (o (cadr (dk-goal))) (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAKE-SET))) landed))
         (e `(NTH ,sn ,l)))
    (subst (dk-cite! 'enc-orl-succ x l n))
    (fact 'length-in-nn 'EXPR-SET l)
    (fact 'nn-succ-closed n)
    (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-apply! ih x l)
    (dk-have! `(IN ,e (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! sn l 'EXPR-SET)))   ; a goal closer
    (dk-apply! u e)
    (dk-cite! 'clf-in-intro x e)
    (dk-cite! 'clf-or-intro `(ENC-ORL ,x ,l ,n) `(ENC-IN ,x ,e))
    (ass)))
(qed 'orl-clf)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL x (FORALL l (FORALL k
   (IMPLIES (IN (LIST g (ENC-IN x (NTH k l))) (DERIVABLE tt)) (IMPLIES (IN g CTX-SET) (IMPLIES (IN x CLT)
   (IMPLIES (IN l (TUPLES EXPR-SET))
   (IMPLIES (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT)))
   (IMPLIES (IN k NN) (IMPLIES (<= 1 k) (IMPLIES (<= k n) (IMPLIES (<= n (LENGTH l))
     (IN (LIST g (ENC-ORL x l n)) (DERIVABLE tt))))))))))))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (let* ((landed (dk-peel!))
         (kf (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))
         (k (caddr kf)))
    (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,k) `(<= ,k 0))))
    (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
    (ai '(NOT (<= 1 0))))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-ORL))) landed))
         (gl (dk-goal)) (seqt (cadr gl)) (tt (cadr (caddr gl)))
         (g (cadr seqt)) (o (caddr seqt)) (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (dh (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'DERIVABLE))) landed))
         (k (cadr (caddr (caddr (cadr dh)))))
         (on `(ENC-ORL ,x ,l ,n)) (e `(ENC-IN ,x (NTH ,sn ,l))))
    (fact 'nn-succ-closed n)
    (fact 'length-in-nn 'EXPR-SET l)
    (dk-apply! (dk-cite! 'orl-clf sn) x l)
    (fact 'enc-orl-succ x l n)
    (dk-rewrite-h! `(IN (ENC-ORL ,x ,l ,sn) CLF) `(ENC-ORL ,x ,l ,sn) `(ENC-OR ,on ,e))
    (subst `(= (ENC-ORL ,x ,l ,sn) (ENC-OR ,on ,e)))
    (dk-meta-seq! g `(ENC-OR ,on ,e))
    (use-em `(= ,sn ,k)
      (lambda ()
        (dk-rewrite-h! dh k sn)
        (dk-cite! 'derivable-or-intro-right-c tt g on e)
        (ass))
      (lambda ()
        (dk-cite! 'nn-le-ne-succ k sn)
        (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,sn))))
        (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
        (dk-apply! ih tt g x l k)
        (dk-cite! 'derivable-or-intro-left-c tt g on e)
        (ass)))))
(qed 'orl-der)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-UNION-INTRO tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mc-rel-open! 'rel-union-intro))
       (g (car vs)) (x (cadr vs)) (l (caddr vs)) (k (cadddr vs))
       (uu `(ENC-IN ,x (ENC-UNION ,l))) (oo `(ENC-ORL ,x ,l (LENGTH ,l)))
       (ff `(ENC-IFF ,uu ,oo)) (g1 `(CTX-ADD ,g ,ff))
       (g3 `(CTX-ADD (CTX-ADD ,g1 (ENC-IMP ,uu ,oo)) (ENC-IMP ,oo ,uu))))
  ;; the n-ary disjunction: well formed (orl-clf) and derivable from the k-th disjunct (orl-der)
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g uu)))
  (dk-split! (dk-cite! 'clf-in-elim x `(ENC-UNION ,l)))
  (dk-split! (dk-cite! 'clt-union-elim l))
  (fact 'length-in-nn 'EXPR-SET l)
  (dk-have! `(<= (LENGTH ,l) (LENGTH ,l)) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'orl-der `(LENGTH ,l)) 'tt g x l k)
  (dk-apply! (dk-cite! 'orl-clf `(LENGTH ,l)) x l)
  (dk-derive! 'tt
    `(cut (,g ==> ,uu)
       (union-mem (,g ==> ,ff))
       (iff-elim (,g1 ==> ,uu)
         (backchain (,g3 ==> ,uu)
           (weakening (,g3 ==> ,oo)
             (given (,g ==> ,oo)))))))
  (ass))
(qed 'adm-union-intro)

;;; -----------------------------------------------------------------------
;;; I. SEQ-SET is a set; the free names of a context are finite; THE EIGENVARIABLE LEMMA.

(sp (make-wff '(IN CLF SET)))
(subst (dk-cite! 'clf-def)) (fact 'expr-set-is-set) (sep-set) (ass)
(qed 'clf-is-set)

(sp (make-wff '(IN SEQ-SET SET)))
(subst (dk-cite! 'seq-def))
(fact 'clf-is-set)
(fact 'power-set 'CLF)
(dk-have! '(IN CTX-SET SET) (lambda () (subst (dk-cite! 'ctx-def)) (sep-set) (ass)))
(let ((iff (dk-meta-iff! 'cartesian-set-iff 'CTX-SET 'CLF)))
  (dk-meta-and! '(IN CTX-SET SET) '(IN CLF SET))
  (dk-meta-iff-l! iff) (ass))
(qed 'seq-set-is-set)

(define mc-fvf '(VNB-LAMBDA mczv3_ EXPR-SET (EXPR-FV mczv3_)))

(sp (make-wff `(FORALL g (IMPLIES (IN g CTX-SET) ,(dk-meta-finsub '(CTX-FV g))))))
(dk-peel!)
(let* ((sub (mc-ctx-open! 'g))
       (bu-fv '(BIG-UNION mczw_ g (EXPR-FV mczw_)))
       (bu-fvf `(BIG-UNION mczw_ g (,mc-fvf mczw_)))
       (typ! (lambda (w) (dk-apply! sub w) (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clf-iff w)))))))
  (dk-have! `(FORALL mczv5_ (IMPLIES (IN mczv5_ g) ,(dk-meta-finsub `(,mc-fvf mczv5_))))
    (lambda ()
      (dk-peel!)
      (let ((w (cadr (cadr (cadr (dk-goal))))))
        (typ! w)
        (dk-lam-b!)
        (dk-split-all! (list (dk-cite! 'fv-finite w)))
        (dk-conj-close! (lambda () (ass))))))
  (fact 'bu-finite-nn 'g mc-fvf)
  (dk-split-all!)
  (subst (dk-cite! 'ctx-fv-unfold 'g))
  (let ((eqn (dk-meta-bu-eq! bu-fvf bu-fv
               (lambda (w)
                 (typ! w)
                 (dk-have! `(== (,mc-fvf ,w) (EXPR-FV ,w)) (lambda () (if (not (dk-lam-b!)) (qrfl))))))))
    (subst `(= ,bu-fv ,bu-fvf))
    (dk-conj-close! (lambda () (ass)))))
(qed 'ctx-fv-finite)

;; THE EIGENVARIABLE LEMMA: a name fresh for a context and a formula exists.
(sp (make-wff '(FORALL g (FORALL f (IMPLIES (IN g CTX-SET) (IMPLIES (IN f EXPR-SET)
   (FORSOME mczn_ (AND (IN mczn_ NN) (NOT (IN mczn_ (UNION (CTX-FV g) (EXPR-FV f))))))))))))
(dk-peel!)
(let* ((a '(CTX-FV g)) (b '(EXPR-FV f)) (u `(UNION ,a ,b)))
  (dk-split-all! (list (dk-cite! 'ctx-fv-finite 'g)))
  (dk-split-all! (list (dk-cite! 'fv-finite 'f)))
  (dk-meta-and! `(IN ,a SET) `(IN ,b SET))
  (fact 'union-set-closure a b)
  (fact 'card-union-nn a b)
  (dk-have! `(SUBSET ,u NN)
    (lambda ()
      (mac 'subset-def) (dk-peel!)
      (let ((z (cadr (dk-goal))))
        (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership a b z))
          (lambda (d)
            (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'subset-def (caddr d) 'NN)) z)
            (ass))))))
  (let ((nv (dk-skolem! (dk-cite! 'nn-finite-subset-bounded u))))
    (dk-have! `(<= ,nv ,nv) (lambda () (dk-nn!)))
    (let ((bound (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u))) (dk-asms))))
      (dk-apply! bound nv))
    (ew nv)
    (dk-conj-close! (lambda () (ass)))))
(qed 'fresh-name-exists)

;;; -----------------------------------------------------------------------
;;; J. FV of the constructor nodes of the core: an APP over a literal list of 0, 1, 2 entries, a
;;; binder with no outside argument (FORALL, FORSOME, COMP, IOTA).

;; goal (= (BIG-UNION w (MAKE-SET L) (EXPR-FV w)) RHS), L literal, RHS the union of the FVs of the
;; entries (EMPTY-SET for none): by class-extensionality.
(define (mc-fv-lit! l)
  (let* ((g (dk-goal)) (bu (cadr g)) (rhs (caddr g)) (es (cdr l)))
    (for-each (lambda (e) (if (not (dk-asm? `(IN (EXPR-FV ,e) SET))) (dk-split-all! (list (dk-cite! 'fv-finite e))))) es)
    (dk-have! `(FORALL mczx_ (IFF (IN mczx_ ,bu) (IN mczx_ ,rhs)))
      (lambda ()
        (dk-peel!)
        (dk-iff! (lambda (gl) (equal? (caddr gl) rhs))
          (lambda ()                      ; x in BU => x in RHS
            (let* ((x (cadr (dk-goal)))
                   (landed (dk-landed (lambda () (bu-me `(IN ,x ,bu)))))
                   (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'MAKE-SET))) landed))
                   (w (cadr wm))
                   (xin (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x) (dk-head-is? (caddr f) 'EXPR-FV))) landed))
                   (land! (lambda (e)        ; (= w e) in context: x in FV(e), then into RHS
                            (let ((xe (dk-rewrite-h! xin w e)))
                              (cond ((null? (cdr es)) (ass))
                                    (#t (let ((iff (dk-meta-iff! 'union-membership (cadr rhs) (caddr rhs) x)))
                                          (dk-have! (caddr iff) (lambda () (if (equal? e (car es)) (oi-l) (oi-r)) (ass)))
                                          (dk-meta-iff-l! iff) (ass))))))))
              (cond ((null? es)
                     (fact 'make-set-empty)
                     (let ((m2 (dk-rewrite-h! wm '(MAKE-SET (LIST)) 'EMPTY-SET)))
                       (fact 'empty-set-has-no-members w) (ai `(NOT ,m2))))
                    ((null? (cdr es)) (land! (begin (dk-cite! 'ms1-cases (car es) w) (car es))))
                    (#t (dk-meta-or-each! (dk-cite! 'ms2-cases (car es) (cadr es) w)
                          (lambda (eqn) (land! (caddr eqn))))))))
          (lambda ()                      ; x in RHS => x in BU
            (let* ((x (cadr (dk-goal)))
                   (via! (lambda (e)       ; x in FV(e) in context
                           (dk-each-leaf! (lambda () (bu-mi e))
                             (lambda () (if (dk-asm? (dk-goal)) (ass) (mc-ms-entry! e l)))))))
              (cond ((null? es) (fact 'empty-set-has-no-members x) (ai `(NOT (IN ,x EMPTY-SET))))
                    ((null? (cdr es)) (via! (car es)))
                    (#t (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership (cadr rhs) (caddr rhs) x))
                          (lambda (d) (via! (cadr (caddr d)))))))))))))
  (fact 'class-extensionality (cadr (dk-goal)) (caddr (dk-goal)))
  (ass))

;; the typing an APP / BIND node's value equation needs, for a literal list L
(define (mc-lit-typed! l)
  (for-each (lambda (a) (dk-meta-set-of! a 'EXPR-SET)) (cdr l))
  (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-each-leaf! (lambda () (ti)) (lambda () (ass))))))

(sp (make-wff '(FORALL h (FORALL a (FORALL b (IMPLIES (IN h NN) (IMPLIES (IN a EXPR-SET) (IMPLIES (IN b EXPR-SET)
   (= (EXPR-FV (EAPP h (LIST a b))) (UNION (EXPR-FV a) (EXPR-FV b)))))))))))
(dk-peel!)
(mc-lit-typed! '(LIST a b))
(subst (dk-cite! 'fv-eapp 'h '(LIST a b)))
(mc-fv-lit! '(LIST a b))
(qed 'fv-app2)

(sp (make-wff '(FORALL h (FORALL a (IMPLIES (IN h NN) (IMPLIES (IN a EXPR-SET)
   (= (EXPR-FV (EAPP h (LIST a))) (EXPR-FV a))))))))
(dk-peel!)
(mc-lit-typed! '(LIST a))
(subst (dk-cite! 'fv-eapp 'h '(LIST a)))
(mc-fv-lit! '(LIST a))
(qed 'fv-app1)

(sp (make-wff '(FORALL h (IMPLIES (IN h NN) (= (EXPR-FV (EAPP h (LIST))) EMPTY-SET)))))
(dk-peel!)
(fact 'empty-in-tuples 'EXPR-SET)
(subst (dk-cite! 'fv-eapp 'h '(LIST)))
(mc-fv-lit! '(LIST))
(qed 'fv-app0)

(sp (make-wff '(FORALL h (FORALL nb (FORALL b (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN b EXPR-SET)
   (= (EXPR-FV (EBIND h nb (LIST) b)) (EXPR-FV b))))))))))
(dk-peel!)
(fact 'empty-in-tuples 'EXPR-SET)
(subst (dk-cite! 'fv-ebind 'h 'nb '(LIST) 'b))
(dk-split-all! (list (dk-cite! 'fv-finite 'b)))
(let* ((g (dk-goal)) (un (cadr g)) (bu (cadr un)))
  (dk-have! `(= ,bu EMPTY-SET) (lambda () (mc-fv-lit! '(LIST))))
  (subst `(= ,bu EMPTY-SET))
  (dk-have! '(FORALL mczx_ (IFF (IN mczx_ (UNION EMPTY-SET (EXPR-FV b))) (IN mczx_ (EXPR-FV b))))
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (dk-goal)))))
        (fact 'empty-set-has-no-members x)
        (let ((iff (dk-meta-iff! 'union-membership 'EMPTY-SET '(EXPR-FV b) x)))
          (dk-iff! (lambda (gl) (equal? (caddr gl) '(EXPR-FV b)))
            (lambda () (dk-meta-or-each! (dk-meta-iff-r! iff) (lambda (d) (if (equal? (caddr d) 'EMPTY-SET) (ai `(NOT ,d)) (ass)))))
            (lambda () (dk-have! (caddr iff) (lambda () (oi-r) (ass))) (dk-meta-iff-l! iff) (ass)))))))
  (fact 'class-extensionality '(UNION EMPTY-SET (EXPR-FV b)) '(EXPR-FV b))
  (ass))
(qed 'fv-bind0)

;;; -----------------------------------------------------------------------
;;; K. WELL-FORMEDNESS IS PRESERVED by SUBST and by OPEN with a term (a replacement whose kinds
;;; are {1}, those of the variable it replaces).  The node step is a TRANSFER: two APP (BIND)
;;; nodes of one head whose children have, entry by entry, the same kinds, have the same kinds.

(define (mc-index-hyp l2 l)              ; the entrywise kind equation, l the reference list
  `(FORALL mczi_ (IMPLIES (IN mczi_ NN) (IMPLIES (<= 1 mczi_) (IMPLIES (<= mczi_ (LENGTH ,l))
     (= (EXPR-WKS (NTH mczi_ ,l2)) (EXPR-WKS (NTH mczi_ ,l))))))))

;; (IN w (MAKE-SET L)) in context: land i with i in NN, 1 <= i, i <= LENGTH(L), NTH(i, L) = w.
(define (mc-ms-index! w l)
  (let* ((iff (dk-meta-iff! 'make-set-membership w l))
         (parts (dk-split! (dk-meta-iff-r! iff)))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
    (dk-skolem! ex #t)))

;; THE TRANSFER STEP.  Goal (= (EXPR-WKS N2) (EXPR-WKS N1)), the nodes of one head, LAW their
;; value equation (wks-eapp / wks-ebind); L2, L1 their child lists; the index hypothesis and the
;; length equation (and, for a BIND, the body equation) in context.
(define (mc-transfer! law l2 l1)
  (let* ((g (dk-goal)) (n2 (cadr (cadr g))) (n1 (cadr (caddr g)))
         (idx (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'EXPR-WKS) (dk-contains? f l2))) (dk-asms))
                  (error "mc-transfer!: no index hypothesis"))))
    (subst (apply dk-cite! law (cdr n2)))
    (subst (apply dk-cite! law (cdr n1)))
    (let* ((g (dk-goal)) (sep2 (cadr g)) (sep1 (caddr g))
           (dir! (lambda (sa sb la lb)    ; (IN x SA) in context, goal (IN x SB)
                   (let* ((x (cadr (dk-goal)))
                          (landed (dk-landed (lambda () (sep-me `(IN ,x ,sa)))))
                          (conds (dk-split-all! landed))
                          (ua (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,la)))) (dk-asms))))
                     (in-sep! (lambda () (ass))
                       (lambda ()
                         (dk-conj-close!
                           (lambda ()
                             (let ((c (dk-goal)))
                               (cond
                                 ((dk-asm? c) (ass))
                                 ((memq (car c) '(APP-AR-OK BIND-SIG))
                                  (let ((src (find-first (lambda (f) (and (dk-head-is? f (car c)) (equal? (cadr f) (cadr c)))) (dk-asms))))
                                    (dk-rewrite-h! src `(LENGTH ,la) `(LENGTH ,lb))
                                    (ass)))
                                 ((dk-head-is? c 'FORALL)
                                  (dk-peel!)
                                  (let* ((w (cadr (caddr (dk-goal)))) (kk (cadr (dk-goal)))
                                         (i (mc-ms-index! w lb)))
                                    (if (not (dk-asm? `(<= ,i (LENGTH ,la))))
                                        (dk-rewrite-h! `(<= ,i (LENGTH ,lb)) `(LENGTH ,lb) `(LENGTH ,la)))
                                    (dk-have! `(IN (NTH ,i ,la) (MAKE-SET ,la)) (lambda () (dk-meta-in-makeset! i la 'EXPR-SET)))
                                    (let ((ka (dk-apply! ua `(NTH ,i ,la))))
                                      (dk-apply! idx i)
                                      (dk-rewrite-h! ka `(EXPR-WKS (NTH ,i ,la)) `(EXPR-WKS (NTH ,i ,lb)))
                                      (subst `(= ,w (NTH ,i ,lb)))
                                      (ass))))
                                 ((dk-head-is? c 'IN)          ; the body of a BIND
                                  (let* ((bb (cadr (caddr c)))
                                         (src (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (cadr c))
                                                                           (dk-head-is? (caddr f) 'EXPR-WKS)
                                                                           (not (equal? (caddr f) (caddr c)))
                                                                           (member f conds)))
                                                          (dk-asms))))
                                    (dk-rewrite-h! src (caddr src) (caddr c))
                                    (ass)))
                                 (#t (error "mc-transfer!: no closer for" (expression->string c)))))))))))))
      (dk-have! `(FORALL mczx_ (IFF (IN mczx_ ,sep2) (IN mczx_ ,sep1)))
        (lambda ()
          (dk-peel!)
          (dk-iff! (lambda (gl) (equal? (caddr gl) sep1))
            (lambda () (dir! sep2 sep1 l2 l1))
            (lambda () (dir! sep1 sep2 l1 l2)))))
      (fact 'class-extensionality sep2 sep1)
      (ass))))

(sp (make-wff `(FORALL h (FORALL l (FORALL l2 (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (IN l2 (TUPLES EXPR-SET))
   (IMPLIES (= (LENGTH l2) (LENGTH l)) (IMPLIES ,(mc-index-hyp 'l2 'l)
     (= (EXPR-WKS (EAPP h l2)) (EXPR-WKS (EAPP h l)))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'l) (dk-meta-makeset-set! 'l2)
(mc-transfer! 'wks-eapp 'l2 'l)
(qed 'wks-eapp-transfer)

(sp (make-wff `(FORALL h (FORALL nb (FORALL a (FORALL a2 (FORALL b (FORALL b2
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN a2 (TUPLES EXPR-SET))
   (IMPLIES (IN b EXPR-SET) (IMPLIES (IN b2 EXPR-SET)
   (IMPLIES (= (LENGTH a2) (LENGTH a)) (IMPLIES ,(mc-index-hyp 'a2 'a) (IMPLIES (= (EXPR-WKS b2) (EXPR-WKS b))
     (= (EXPR-WKS (EBIND h nb a2 b2)) (EXPR-WKS (EBIND h nb a b))))))))))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'a) (dk-meta-makeset-set! 'a2)
(mc-transfer! 'wks-ebind 'a2 'a)
(qed 'wks-ebind-transfer)

;;; SUBST.
(define mc-sfl '(VNB-LAMBDA mxw_ EXPR-SET (EXPR-SUBST mxw_ m u)))   ; SUBST-FUN(m, u) unfolded
(define mc-wks-subst-cls '(SEP mczz_ EXPR-SET (= (EXPR-WKS (EXPR-SUBST mczz_ m u)) (EXPR-WKS mczz_))))

;; the mapped list L2 = MAPL(mc-sfl, L) typed, its length, and the index hypothesis from COMPS
;; (the children of L in the induction class); return L2.
(define (mc-sfl-kinds! l comps)
  (let* ((l2 (dk-meta-mapl! mc-sfl l 'EXPR-SET 'EXPR-SET
               (lambda (i) (dk-lam-b!) (fact 'subst-in-expr 'm 'u `(NTH ,i ,l)) (ass))))
         (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l2)))) (dk-asms))))
    (dk-have! (mc-index-hyp l2 l)
      (lambda ()
        (dk-peel!)
        (let ((i (cadr (cadr (cadr (dk-goal))))))
          (subst (dk-apply! ents i))
          (dk-meta-nth-in! 'EXPR-SET i l)
          (dk-lam-b!)
          (dk-apply! comps i)
          (sep-me `(IN (NTH ,i ,l) ,mc-wks-subst-cls))
          (ass))))
    l2))

(sp (make-wff '(FORALL m (FORALL u (IMPLIES (IN u EXPR-SET) (IMPLIES (= (EXPR-WKS u) (PAIR 1 1))
   (FORALL e (IMPLIES (IN e EXPR-SET) (= (EXPR-WKS (EXPR-SUBST e m u)) (EXPR-WKS e))))))))))
(dk-peel!)
(let* ((cls mc-wks-subst-cls) (hs (dk-meta-ind-hyps cls))
       (intro! (lambda (x in-law args cond!) (apply fact in-law args) (in-sep! (lambda () (ass)) cond!))))
  ;; FVAR
  (dk-have! (list-ref hs 0)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (n (cadr x)))
        (intro! x 'efvar-in-expr (list n)
          (lambda ()
            (use-em `(= ,n m)
              (lambda ()
                (dk-rewrite-h! `(IN ,n NN) n 'm)
                (subst `(= ,n m))
                (subst (dk-cite! 'subst-efvar-hit 'm 'u))
                (subst (dk-cite! 'wks-efvar 'm))
                (subst '(= (EXPR-WKS u) (PAIR 1 1)))
                (rfl))
              (lambda ()
                (subst (dk-cite! 'subst-efvar-miss 'm 'u n))
                (subst (dk-cite! 'wks-efvar n))
                (rfl))))))))
  ;; BVAR, CONST
  (for-each
    (lambda (hk law wlaw in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (dk-goal))) (n (cadr x)))
            (intro! x in-law (list n)
              (lambda () (subst (dk-cite! law 'm 'u n)) (subst (dk-cite! wlaw n)) (rfl)))))))
    '(1 2) '(subst-ebvar subst-econst) '(wks-ebvar wks-econst) '(ebvar-in-expr econst-in-expr))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda ()
            (subst (dk-cite! 'subst-eapp 'm 'u h l))
            (mac 'SUBST-FUN)
            (let ((l2 (mc-sfl-kinds! l comps)))
              (dk-cite! 'wks-eapp-transfer h l l2)
              (ass)))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda ()
            (subst (dk-cite! 'subst-ebind 'm 'u h nb a b))
            (mac 'SUBST-FUN)
            (let ((a2 (mc-sfl-kinds! a comps)))
              (sep-me `(IN ,b ,cls))
              (fact 'subst-in-expr 'm 'u b)
              (dk-cite! 'wks-ebind-transfer h nb a a2 b `(EXPR-SUBST ,b m u))
              (ass)))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (ass))
(qed 'wks-subst)

;;; OPEN.  The induction class quantifies the index (it grows by nb under a binder).
(define mc-ofl '(VNB-LAMBDA (LIST mxw_ mxj_) (CARTESIAN EXPR-SET NN) (EXPR-OPEN mxw_ mxj_ u)))  ; OPEN-FUN(u)
(define mc-wks-open-cls
  '(SEP mczz_ EXPR-SET (FORALL mczj_ (IMPLIES (IN mczj_ NN) (= (EXPR-WKS (EXPR-OPEN mczz_ mczj_ u)) (EXPR-WKS mczz_))))))

(define (mc-ofl-kinds! l j comps)
  (let* ((l2 (dk-meta-maplk! mc-ofl l j 'EXPR-SET 'EXPR-SET
               (lambda (i) (dk-lam-b!) (fact 'open-in-expr 'u j `(NTH ,i ,l)) (ass))))
         (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l2)))) (dk-asms))))
    (dk-have! (mc-index-hyp l2 l)
      (lambda ()
        (dk-peel!)
        (let ((i (cadr (cadr (cadr (dk-goal))))))
          (subst (dk-apply! ents i))
          (dk-meta-nth-in! 'EXPR-SET i l)
          (dk-lam-b!)
          (dk-apply! comps i)
          (dk-apply! (mc-sep-me-of `(IN (NTH ,i ,l) ,mc-wks-open-cls)) j)
          (ass))))
    l2))
(define (mc-sep-me-of mem)                  ; sep-me MEM, return the condition that landed
  (find-first (lambda (f) (not (and (dk-head-is? f 'IN) (equal? (cadr f) (cadr mem)))))
              (dk-landed (lambda () (sep-me mem)))))

(sp (make-wff '(FORALL u (IMPLIES (IN u EXPR-SET) (IMPLIES (= (EXPR-WKS u) (PAIR 1 1))
   (FORALL e (IMPLIES (IN e EXPR-SET) (FORALL ix (IMPLIES (IN ix NN)
     (= (EXPR-WKS (EXPR-OPEN e ix u)) (EXPR-WKS e)))))))))))
(dk-peel!)
(let* ((cls mc-wks-open-cls) (hs (dk-meta-ind-hyps cls))
       (intro! (lambda (x in-law args cond!)
                 (apply fact in-law args)
                 (in-sep! (lambda () (ass))
                   (lambda ()
                     (dk-peel!)
                     (cond! (caddr (cadr (cadr (dk-goal))))))))))   ; the index j, read off the goal
  ;; FVAR, CONST
  (for-each
    (lambda (hk law wlaw in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (dk-goal))) (n (cadr x)))
            (intro! x in-law (list n)
              (lambda (j) (subst (dk-cite! law 'u j n)) (subst (dk-cite! wlaw n)) (rfl)))))))
    '(0 2) '(open-efvar open-econst) '(wks-efvar wks-econst) '(efvar-in-expr econst-in-expr))
  ;; BVAR
  (dk-have! (list-ref hs 1)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (k (cadr x)))
        (intro! x 'ebvar-in-expr (list k)
          (lambda (j)
            (use-em `(= ,k ,j)
              (lambda ()
                (subst `(= ,k ,j))
                (subst (dk-cite! 'open-ebvar-hit 'u j))
                (subst (dk-cite! 'wks-ebvar j))
                (subst '(= (EXPR-WKS u) (PAIR 1 1)))
                (rfl))
              (lambda ()
                (subst (dk-cite! 'open-ebvar-miss 'u j k))
                (subst (dk-cite! 'wks-ebvar k))
                (rfl))))))))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda (j)
            (subst (dk-cite! 'open-eapp 'u j h l))
            (mac 'OPEN-FUN)
            (let ((l2 (mc-ofl-kinds! l j comps)))
              (dk-cite! 'wks-eapp-transfer h l l2)
              (ass)))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda (j)
            (subst (dk-cite! 'open-ebind 'u j h nb a b))
            (mac 'OPEN-FUN)
            (let* ((a2 (mc-ofl-kinds! a j comps)) (jb `(+ ,j ,nb)))
              (dk-meta-and! `(IN ,j NN) `(IN ,nb NN))
              (fact 'nn-add-closed j nb)
              (dk-apply! (mc-sep-me-of `(IN ,b ,cls)) jb)
              (fact 'open-in-expr 'u jb b)
              (dk-cite! 'wks-ebind-transfer h nb a a2 b `(EXPR-OPEN ,b ,jb u))
              (ass)))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (dk-apply! (mc-sep-me-of `(IN e ,cls)) 'ix)
  (ass))
(qed 'wks-open)

;;; -----------------------------------------------------------------------
;;; J. FIVE MORE ADMISSIBILITY THEOREMS (agent META-KIT, 2026-10-08): union-elim, intersection-intro,
;;; intersection-elim, tuples-intro, tuples-elim, each against its REL- transcription (meta-core.scm,
;;; section 6), each derivation written as a dk-derive! tree.  The n-ary formulas ENC-ORL / ENC-ANDL /
;;; ENC-ANDE are reached by inductions on the count, one generic driver per law shape.

;;; J.1 The term constructors the five rules name: unfold equations, per-head laws, eliminations.
(for-each (lambda (e) (mc-unfold-law! (car e) (cadr e) (caddr e)))
  '((ENC-INTER (l) (EAPP 12 l)) (ENC-TUPLES (p) (EAPP 14 (LIST p))) (ENC-LIST (l) (EAPP 17 l))))

(define (mc-clt-list-law! h)             ; the goal: the per-head law of a term head H >= 11
  (dk-peel!)
  (mc-app-law! 'CLT 'CLT
    (lambda () (mc-hd! 'HD-RES h 1 #f) (mc-hd! 'HD-ARGK h 1 #f))
    (lambda () (mc-ar-pick! 0))))

(sp (make-wff '(FORALL l (IMPLIES (IN l (TUPLES EXPR-SET))
   (IFF (IN (EAPP 12 l) CLT) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(mc-clt-list-law! 12)
(qed 'clt-inter)
(sp (make-wff '(FORALL l (IMPLIES (IN l (TUPLES EXPR-SET))
   (IFF (IN (EAPP 17 l) CLT) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(mc-clt-list-law! 17)
(qed 'clt-list)
(sp (make-wff '(FORALL a (IMPLIES (IN a EXPR-SET) (IFF (IN (EAPP 14 (LIST a)) CLT) (IN a CLT))))))
(mc-clt-list-law! 14)
(qed 'clt-tuples1)

(define (mc-clt-list-elim! enc h law)    ; (IN (ENC l) CLT) => l in TUPLES(EXPR-SET), its entries in CLT
  (dk-peel!)
  (let* ((m2 (mc-enc-open-mem! `(IN (,enc l) CLT))))
    (dk-have! `(IN ,h NN) (lambda () (arith)))
    (mc-eapp-type! m2)
    (dk-meta-iff-r! (dk-meta-iff! law 'l))
    (dk-conj-close! (lambda () (ass)))))
(sp (make-wff '(FORALL l (IMPLIES (IN (ENC-INTER l) CLT)
   (AND (IN l (TUPLES EXPR-SET)) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(mc-clt-list-elim! 'ENC-INTER 12 'clt-inter)
(qed 'clt-inter-elim)
(sp (make-wff '(FORALL l (IMPLIES (IN (ENC-LIST l) CLT)
   (AND (IN l (TUPLES EXPR-SET)) (FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))))))
(mc-clt-list-elim! 'ENC-LIST 17 'clt-list)
(qed 'clt-list-elim)
(sp (make-wff '(FORALL p (IMPLIES (IN (ENC-TUPLES p) CLT) (IN p CLT)))))
(dk-peel!) (mc-enc-elim! 'clt-tuples1)
(qed 'clt-tuples-elim)

;; the context minus a set is below the context
(sp (make-wff '(FORALL g (FORALL b (SUBSET (DIFFERENCE g b) g)))))
(dk-peel!)
(mac 'subset-def)
(dk-peel!)
(let ((z (cadr (dk-goal))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'difference-membership 'g 'b z)))
  (ass))
(qed 'ctx-diff-sub)

;;; J.2 The n-ary formulas.  SPEC: the recursion, its two parameters, the parameter typed in CLT,
;;; the entry at an index, the base and its CLF law, the binary connective's intro law.
(define (mc-nary-spec rec)
  (case rec
    ((ENC-ANDL) (list '(x l) 'x (lambda (i al) (dk-meta--subst-syms `(ENC-IN x (NTH ,i l)) al)) 'clf-truth 'clf-and-intro))
    ((ENC-ANDE) (list '(l a) 'a (lambda (i al) (dk-meta--subst-syms `(ENC-IN (NTH ,i l) a) al)) 'clf-truth 'clf-and-intro))
    ((ENC-ORL)  (list '(x l) 'x (lambda (i al) (dk-meta--subst-syms `(ENC-IN x (NTH ,i l)) al)) 'clf-falsity 'clf-or-intro))
    (else (error "mc-nary-spec: no such recursion" rec))))
(define (mc-nary-law rec suffix) (symbol-append (string->symbol (string-downcase (symbol->string rec))) suffix))
(define mc-msu '(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))
(define (mc-nary-typing ty k)            ; the parameters' typings, then K
  `(IMPLIES (IN ,ty CLT) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES ,mc-msu ,k))))
;; the parameter alist read off an application (REC p1 p2 n) in the goal or a hypothesis
(define (mc-nary-al rec app) (map cons (car (mc-nary-spec rec)) (list (cadr app) (caddr app))))
(define (mc-nary-ih landed rec)
  (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f rec))) landed)
      (error "mc-nary: no induction hypothesis")))
;; with n, sn = (succ n), l typed: n in NN, sn in NN, n <= |l|, 1 <= sn
(define (mc-nary-nn! n sn l)
  (fact 'length-in-nn 'EXPR-SET l)
  (fact 'nn-succ-closed n)
  (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
  (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!))))
;; the entry at SN typed: (NTH sn l) in CLT, the entry in CLF
(define (mc-nary-entry! e sn l u)
  (dk-have! `(IN (NTH ,sn ,l) (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! sn l 'EXPR-SET)))
  (dk-apply! u `(NTH ,sn ,l))
  (dk-cite! 'clf-in-intro (cadr e) (caddr e)))
(define (mc-nary-msu landed)
  (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAKE-SET)
                                   (not (dk-contains? f 'DERIVABLE)) (not (dk-contains? f 'ENC-ANDL))
                                   (not (dk-contains? f 'ENC-ANDE)) (not (dk-contains? f 'ENC-ORL))))
                  landed)
      (error "mc-nary: no MAKE-SET universal landed")))

;; REC(p1, p2, n) is a sentence for n <= |l|  (the shape of orl-clf)
(define (mc-nary-clf! rec)
  (let* ((sp0 (mc-nary-spec rec)) (ps (car sp0)) (ty (cadr sp0)) (entry (caddr sp0)))
    (sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL ,(car ps) (FORALL ,(cadr ps)
          ,(mc-nary-typing ty `(IMPLIES (<= n (LENGTH l)) (IN (,rec ,@ps n) CLF)))))))))
    (let ((cs (dk-meta-ni-cases!)))
      (dk-focus! (car cs))
      (dk-peel!)
      (let ((o (cadr (dk-goal))))
        (subst (dk-cite! (mc-nary-law rec '-zero) (cadr o) (caddr o)))
        (fact (cadddr sp0)) (ass))
      (dk-focus! (cadr cs))
      (let* ((landed (dk-peel!)) (ih (mc-nary-ih landed rec)) (u (mc-nary-msu landed))
             (o (cadr (dk-goal))) (al (mc-nary-al rec o)) (l (cdr (assq 'l al)))
             (sn (cadddr o)) (n (cadr sn)) (e (entry sn al)))
        (subst (dk-cite! (mc-nary-law rec '-succ) (cadr o) (caddr o) n))
        (mc-nary-nn! n sn l)
        (dk-apply! ih (cadr o) (caddr o))
        (mc-nary-entry! e sn l u)
        (dk-cite! (car (cddddr sp0)) `(,rec ,(cadr o) ,(caddr o) ,n) e)
        (ass)))
    (qed (mc-nary-law rec '-clf))))
(mc-nary-clf! 'ENC-ANDL)
(mc-nary-clf! 'ENC-ANDE)

;; the hypothesis "every entry up to N is derivable" (for the intro direction) and its restriction
(define (mc-nary-all rec bound ctx-of)    ; CTX-OF: index -> the sequent derivable at that index
  `(FORALL mczk_ (IMPLIES (IN mczk_ NN) (IMPLIES (<= 1 mczk_) (IMPLIES (<= mczk_ ,bound)
      (IN ,(ctx-of 'mczk_) (DERIVABLE tt)))))))
;; HK in context bounds at SN; land the same universal bounded at N (alpha-equal to the IH's).
(define (mc-nary-restrict! hk n sn)
  (let* ((claim (dk-meta--subst-syms hk '()))
         (claim (let walk ((f hk))       ; replace the bound (<= k sn) by (<= k n)
                  (cond ((and (pair? f) (eq? (car f) '<=) (equal? (caddr f) sn) (symbol? (cadr f))) `(<= ,(cadr f) ,n))
                        ((pair? f) (map walk f))
                        (#t f)))))
    (dk-have! claim
      (lambda ()
        (let* ((landed (dk-peel!))
               (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
          (dk-have! `(<= ,k ,sn) (lambda () (dk-nn! `(<= ,k ,n))))
          (dk-apply! hk k)
          (ass))))
    claim))

;; INTRO: every entry derivable  =>  [g, REC(n)] derivable  (ANDL, ANDE: and-intro over truth-intro)
(define (mc-nary-der! rec)
  (let* ((sp0 (mc-nary-spec rec)) (ps (car sp0)) (ty (cadr sp0)) (entry (caddr sp0))
         (al0 (map cons ps ps)))
    (sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL ,(car ps) (FORALL ,(cadr ps)
          (IMPLIES (IN g CTX-SET)
          ,(mc-nary-typing ty
             `(IMPLIES ,(mc-nary-all rec 'n (lambda (i) `(LIST g ,(entry i al0))))
               (IMPLIES (<= n (LENGTH l)) (IN (LIST g (,rec ,@ps n)) (DERIVABLE tt))))))))))))))
    (let ((cs (dk-meta-ni-cases!)))
      (dk-focus! (car cs))
      (dk-peel!)
      (let* ((gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr sq)) (o (caddr sq)))
        (subst (dk-cite! (mc-nary-law rec '-zero) (cadr o) (caddr o)))
        (dk-derive! tt `(truth-intro (,g ==> ENC-TRUTH)))
        (ass))
      (dk-focus! (cadr cs))
      (let* ((landed (dk-peel!)) (ih (mc-nary-ih landed rec)) (u (mc-nary-msu landed))
             (hk (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DERIVABLE)
                                              (not (dk-contains? f rec)))) landed))
             (gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr sq)) (o (caddr sq))
             (al (mc-nary-al rec o)) (l (cdr (assq 'l al))) (sn (cadddr o)) (n (cadr sn))
             (aa `(,rec ,(cadr o) ,(caddr o) ,n)) (e (entry sn al)))
        (subst (dk-cite! (mc-nary-law rec '-succ) (cadr o) (caddr o) n))
        (mc-nary-nn! n sn l)
        (dk-have! `(<= ,sn ,sn) (lambda () (dk-nn!)))
        (dk-apply! (dk-cite! (mc-nary-law rec '-clf) n) (cadr o) (caddr o))
        (mc-nary-entry! e sn l u)
        (mc-nary-restrict! hk n sn)
        (dk-apply! ih tt g (cadr o) (caddr o))
        (dk-apply! hk sn)
        (dk-derive! tt
          `(and-intro (,g ==> (ENC-AND ,aa ,e))
             (given (,g ==> ,aa))
             (given (,g ==> ,e))))
        (ass)))
    (qed (mc-nary-law rec '-der))))
(mc-nary-der! 'ENC-ANDL)
(mc-nary-der! 'ENC-ANDE)

;; ELIM: [g, REC(n)] derivable  =>  [g, entry k] derivable for 1 <= k <= n  (and-elim, then cut)
(define (mc-nary-elim-der! rec)
  (let* ((sp0 (mc-nary-spec rec)) (ps (car sp0)) (ty (cadr sp0)) (entry (caddr sp0))
         (al0 (map cons ps ps)))
    (sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL ,(car ps) (FORALL ,(cadr ps) (FORALL k
          (IMPLIES (IN (LIST g (,rec ,@ps n)) (DERIVABLE tt)) (IMPLIES (IN g CTX-SET)
          ,(mc-nary-typing ty
             `(IMPLIES (IN k NN) (IMPLIES (<= 1 k) (IMPLIES (<= k n) (IMPLIES (<= n (LENGTH l))
                (IN (LIST g ,(entry 'k al0)) (DERIVABLE tt))))))))))))))))))
    (let ((cs (dk-meta-ni-cases!)))
      (dk-focus! (car cs))
      (let* ((landed (dk-peel!))
             (kf (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))
             (k (caddr kf)))
        (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,k) `(<= ,k 0))))
        (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
        (ai '(NOT (<= 1 0))))
      (dk-focus! (cadr cs))
      (let* ((landed (dk-peel!)) (ih (mc-nary-ih landed rec)) (u (mc-nary-msu landed))
             (dh (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'DERIVABLE))) landed))
             (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed)))
             (tt (cadr (caddr dh))) (g (cadr (cadr dh))) (o (caddr (cadr dh)))
             (al (mc-nary-al rec o)) (l (cdr (assq 'l al))) (sn (cadddr o)) (n (cadr sn))
             (aa `(,rec ,(cadr o) ,(caddr o) ,n)) (e (entry sn al)) (ae `(ENC-AND ,aa ,e))
             (g1 `(CTX-ADD ,g ,ae)) (g3 `(CTX-ADD (CTX-ADD ,g1 ,aa) ,e)))
        (dk-cite! (mc-nary-law rec '-succ) (cadr o) (caddr o) n)
        (dk-rewrite-h! dh o ae)
        (mc-nary-nn! n sn l)
        (dk-apply! (dk-cite! (mc-nary-law rec '-clf) n) (cadr o) (caddr o))
        (mc-nary-entry! e sn l u)
        (dk-derive! tt
          `(cut (,g ==> ,aa)
             (given (,g ==> ,ae))
             (and-elim (,g1 ==> ,aa)
               (assumption (,g3 ==> ,aa)))))
        (dk-derive! tt
          `(cut (,g ==> ,e)
             (given (,g ==> ,ae))
             (and-elim (,g1 ==> ,e)
               (assumption (,g3 ==> ,e)))))
        (use-em `(= ,sn ,k)
          (lambda () (subst `(= ,k ,sn)) (ass))
          (lambda ()
            (dk-cite! 'nn-le-ne-succ k sn)
            (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,sn))))
            (dk-apply! ih tt g (cadr o) (caddr o) k)
            (ass)))))
    (qed (mc-nary-law rec '-elim-der))))
(mc-nary-elim-der! 'ENC-ANDL)
(mc-nary-elim-der! 'ENC-ANDE)

;; ORL ELIM: every case derivable  =>  [g + ORL(n), f] derivable  (contradiction at 0, or-elim above)
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL f (FORALL x (FORALL l
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN f CLF)
   ,(mc-nary-typing 'x
      `(IMPLIES ,(mc-nary-all 'ENC-ORL 'n (lambda (i) `(LIST (CTX-ADD g (ENC-IN x (NTH ,i l))) f)))
        (IMPLIES (<= n (LENGTH l)) (IN (LIST (CTX-ADD g (ENC-ORL x l n)) f) (DERIVABLE tt))))))))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr (cadr sq))) (f (caddr sq))
         (o (caddr (cadr sq))) (g0 `(CTX-ADD ,g ENC-FALSITY)))
    (subst (dk-cite! 'enc-orl-zero (cadr o) (caddr o)))
    (dk-derive! tt
      `(contradiction (,g0 ==> ,f)
         (assumption ((CTX-ADD ,g0 (ENC-NOT ,f)) ==> ENC-FALSITY))))
    (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!)) (ih (mc-nary-ih landed 'ENC-ORL)) (u (mc-nary-msu landed))
         (hk (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DERIVABLE)
                                          (not (dk-contains? f 'ENC-ORL)))) landed))
         (gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr (cadr sq))) (f (caddr sq))
         (o (caddr (cadr sq))) (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (oo `(ENC-ORL ,x ,l ,n)) (e `(ENC-IN ,x (NTH ,sn ,l))) (oe `(ENC-OR ,oo ,e)) (g1 `(CTX-ADD ,g ,oe)))
    (subst (dk-cite! 'enc-orl-succ x l n))
    (mc-nary-nn! n sn l)
    (dk-have! `(<= ,sn ,sn) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! 'orl-clf n) x l)
    (mc-nary-entry! e sn l u)
    (mc-nary-restrict! hk n sn)
    (dk-apply! ih tt g f x l)
    (dk-apply! hk sn)
    (dk-derive! tt
      `(or-elim (,g1 ==> ,f)
         (weakening ((CTX-ADD ,g1 ,oo) ==> ,f)
           (given ((CTX-ADD ,g ,oo) ==> ,f)))
         (weakening ((CTX-ADD ,g1 ,e) ==> ,f)
           (given ((CTX-ADD ,g ,e) ==> ,f)))))
    (ass)))
(qed 'orl-elim-der)

;;; J.3 Unpacking a REL with one hypothesis per list entry: c and the witnesses as for mc-rel-open!;
;;; the per-entry universal of the relation turned into "every entry's sequent is derivable"
;;; (from HYPS-IN), landed and returned with the witnesses: (vs . that universal).
(define (mc-rel-open-n! rel)
  (let* ((r (dk-meta-iff-r! (dk-meta-iff! rel 'tt 'hs 'c)))
         (parts (dk-split! r))
         (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
         (ceq (dk-meta-eq-of 'c)))
    (subst ceq)
    (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
    (let* ((urel (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'NTH) (dk-contains? f 'hs)))
                                 (dk-asms))
                     (error "mc-rel-open-n!: no per-entry universal")))
           (lenl (caddr (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '(LENGTH hs)))) (dk-asms))))
           (claim (let walk ((f urel))
                    (cond ((and (pair? f) (eq? (car f) '=) (dk-head-is? (cadr f) 'NTH) (equal? (caddr (cadr f)) 'hs))
                           `(IN ,(caddr f) (DERIVABLE tt)))
                          ((pair? f) (map walk f))
                          (#t f))))
           (hu (dk-meta-iff-r! (dk-meta-iff! 'hyps-in 'hs '(DERIVABLE tt)))))
      (dk-have! claim
        (lambda ()
          (let* ((landed (dk-peel!))
                 (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
            (dk-have! `(<= ,k (LENGTH hs)) (lambda () (subst `(= (LENGTH hs) ,lenl)) (ass)))
            (let* ((m (dk-apply! hu k)) (eq (dk-apply! urel k)))
              (dk-rewrite-h! m (cadr eq) (caddr eq))
              (ass)))))
      (cons vs claim))))

;;; J.4 The five theorems.

;; union-elim: from [(g - {u}) + (x in l_i), f] for every i, [g, f]; u = (x in UNION l) in g.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-UNION-ELIM tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((o (mc-rel-open-n! 'rel-union-elim)) (vs (car o)) (hu (cdr o))
       (g (car vs)) (f (cadr vs)) (x (caddr vs)) (l (cadddr vs))
       (uu `(ENC-IN ,x (ENC-UNION ,l))) (oo `(ENC-ORL ,x ,l (LENGTH ,l)))
       (ff `(ENC-IFF ,uu ,oo)) (g1 `(CTX-ADD ,g ,ff))
       (g3 `(CTX-ADD (CTX-ADD ,g1 (ENC-IMP ,uu ,oo)) (ENC-IMP ,oo ,uu)))
       (dg `(DIFFERENCE ,g (PAIR ,uu ,uu))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-cite! 'ctx-mem g uu)
  (dk-split! (dk-cite! 'clf-in-elim x `(ENC-UNION ,l)))
  (dk-split! (dk-cite! 'clt-union-elim l))
  (fact 'length-in-nn 'EXPR-SET l)
  (dk-have! `(<= (LENGTH ,l) (LENGTH ,l)) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'orl-clf `(LENGTH ,l)) x l)
  (dk-cite! 'ctx-diff-sub g `(PAIR ,uu ,uu))
  ;; each case, weakened from the context without u to the context with it
  (let ((v (mc-nary-all 'ENC-ORL `(LENGTH ,l) (lambda (i) `(LIST (CTX-ADD ,g (ENC-IN ,x (NTH ,i ,l))) ,f)))))
    (dk-have! v
      (lambda ()
        (let* ((landed (dk-peel!))
               (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed)))
               (e `(ENC-IN ,x (NTH ,k ,l))))
          (dk-apply! hu k)
          (mc-nary-entry! e k l (mc-nary-msu (dk-asms)))
          (dk-derive! 'tt
            `(weakening ((CTX-ADD ,g ,e) ==> ,f)
               (given ((CTX-ADD ,dg ,e) ==> ,f))))
          (ass)))))
  (dk-apply! (dk-cite! 'orl-elim-der `(LENGTH ,l)) 'tt g f x l)
  (dk-derive! 'tt
    `(cut (,g ==> ,f)
       (cut (,g ==> ,oo)
         (union-mem (,g ==> ,ff))
         (iff-elim (,g1 ==> ,oo)
           (backchain (,g3 ==> ,oo)
             (assumption (,g3 ==> ,uu)))))
       (given ((CTX-ADD ,g ,oo) ==> ,f))))
  (ass))
(qed 'adm-union-elim)

;; the shared preparation of the INTERSECTION / TUPLES proofs: with the membership (ENC-IN s t) in
;; CLF, land s and t in CLT, the list L in TUPLES(EXPR-SET) with its entries in CLT (LIST-ELIM, at
;; the term holding L), |L| in NN and |L| <= |L|
(define (mc-nary-prep! s t l list-elim)
  (dk-split! (dk-cite! 'clf-in-elim s t))
  (dk-split! (dk-cite! list-elim l))
  (fact 'length-in-nn 'EXPR-SET l)
  (dk-have! `(<= (LENGTH ,l) (LENGTH ,l)) (lambda () (dk-nn!))))

;; intersection-intro: from [g, x in l_i] for every i, [g, x in INTERSECTION l].
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-INTERSECTION-INTRO tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((o (mc-rel-open-n! 'rel-intersection-intro)) (vs (car o))
       (g (car vs)) (x (cadr vs)) (l (caddr vs))
       (ii `(ENC-IN ,x (ENC-INTER ,l))) (aa `(ENC-ANDL ,x ,l (LENGTH ,l)))
       (ff `(ENC-IFF ,ii ,aa)) (g1 `(CTX-ADD ,g ,aa)) (g2 `(CTX-ADD ,g1 ,ff))
       (g3 `(CTX-ADD (CTX-ADD ,g2 (ENC-IMP ,ii ,aa)) (ENC-IMP ,aa ,ii))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g ii)))
  (mc-nary-prep! x `(ENC-INTER ,l) l 'clt-inter-elim)
  (dk-apply! (dk-cite! 'enc-andl-clf `(LENGTH ,l)) x l)
  (dk-apply! (dk-cite! 'enc-andl-der `(LENGTH ,l)) 'tt g x l)
  (dk-derive! 'tt
    `(cut (,g ==> ,ii)
       (given (,g ==> ,aa))
       (cut (,g1 ==> ,ii)
         (intersection-mem (,g1 ==> ,ff))
         (iff-elim (,g2 ==> ,ii)
           (backchain (,g3 ==> ,ii)
             (assumption (,g3 ==> ,aa)))))))
  (ass))
(qed 'adm-intersection-intro)

;; intersection-elim: from [g + (x in l_k), f], [g, f]; (x in INTERSECTION l) in g.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-INTERSECTION-ELIM tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
