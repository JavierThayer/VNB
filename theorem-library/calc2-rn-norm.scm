;;; calc2-rn-norm.scm -- the sup norm of RN(n): RN-MAXABS laws.  CALC-2, 2026-10-19.  Prefix c2n-.

(define c2n-V '(FUN (INTERVAL 1 n) RR))
(define (c2n-open) (dk-open-leaves))


;;; (1) RN-MAXABS(xv, k) is a nonnegative real for k <= n.  Induction variable first.
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (forall-guarded '(n xv) (list '(IN n NN) (list 'IN 'xv c2n-V) '(<= k n))
     '(AND (IN (RN-MAXABS xv k) RR) (<= 0 (RN-MAXABS xv k))))))))
(ni)
(define (c2n-step? l) (dk-contains? (dk-goal-of l) 'succ))
(define (c2n-base-leaf) (find-first (lambda (l) (not (c2n-step? l))) (c2n-open)))
(define (c2n-step-leaf) (find-first c2n-step? (c2n-open)))

;;; the IH: the context's FORALL n ... about k
(define c2n-ihf #f)
(define (c2n-grab-ih!)          ; right after the step's peel: the only universal about RN-MAXABS
  (set! c2n-ihf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RN-MAXABS))) "the IH")))
(define (c2n-ih) c2n-ihf)

;;; land (IN (succ k) (INTERVAL 1 n)) from (<= (succ k) n), k in NN
(define (c2n-succ-in! k n)
  (let ((sk (list 'succ k)))
    (dk-cite! 'nn-succ-closed k)
    (dk-have! (list '<= 1 sk) (lambda () (dk-nn!)))
    (dk-cite! 'interval-mem-intro 1 n sk)))

;;; base: RN-MAXABS(xv, 0) = 0
(dk-focus! (c2n-base-leaf))
(dk-peel!)
(fact 'rn-maxabs-zero 'xv)
(subst '(= (RN-MAXABS xv 0) 0))
(dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (in-rr) (arith))))
;;; step
(dk-focus! (c2n-step-leaf))
(dk-di-var!)
(dk-peel!)
(c2n-grab-ih!)
;;; IH at (n, xv), detached: needs k <= n
(define (c2n-ih-at! . extra)
  (dk-have! '(<= k n) (lambda () (dk-nn! '(<= (succ k) n))))
  (let ((r (apply dk-apply! (c2n-ih) 'n 'xv extra)))
    r))
;;; the succ value, typed: lands M_k in RR, abs(xv(succ k)) in RR and rewrites the goal
(define (c2n-unfold-succ!)
  (c2n-succ-in! 'k 'n)
  (dk-type! '(xv (succ k)))
  (dk-cite! 'rr-abs-closed '(xv (succ k)))
  (fact 'rn-maxabs-succ 'xv 'k)
  (subst '(= (RN-MAXABS xv (succ k)) (max (RN-MAXABS xv k) (abs (xv (succ k)))))))

(define (c2n-max-typed!)
  (dk-cite! 'rr-max-closed '(RN-MAXABS xv k) '(abs (xv (succ k)))))
(dk-split! (c2n-ih-at!))
(c2n-unfold-succ!)
(dk-cite! 'rr-max-closed '(RN-MAXABS xv k) '(abs (xv (succ k))))
(dk-cite! 'rr-le-max-left '(RN-MAXABS xv k) '(abs (xv (succ k))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN) (ass)
        (dk-ineq! '(<= 0 (RN-MAXABS xv k))
                  '(<= (RN-MAXABS xv k) (max (RN-MAXABS xv k) (abs (xv (succ k)))))))))
(qed 'rn-maxabs-typing)

;;; (2) every coordinate is below RN-MAXABS(xv, k), for i <= k <= n.
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (forall-guarded '(n xv i) (list '(IN n NN) (list 'IN 'xv c2n-V) '(<= k n) '(IN i (INTERVAL 1 n)) '(<= i k))
     '(<= (abs (xv i)) (RN-MAXABS xv k)))))))
(ni)
(dk-focus! (c2n-base-leaf))
(dk-peel!)
(fact 'interval-lo 1 'n 'i)
(fact 'interval-elt-in-nn 1 'n 'i)
(dk-type! '(xv i))
(dk-cite! 'rr-abs-closed '(xv i))
(fact 'nn-in-rr 'i)
(fact 'rn-maxabs-zero 'xv)
(subst '(= (RN-MAXABS xv 0) 0))
(dk-ineq! '(<= 1 i) '(<= i 0))
(dk-focus! (c2n-step-leaf))
(dk-di-var!)
(dk-peel!)
(c2n-grab-ih!)
(define (c2n-typing-k!)
  (dk-have! '(<= k n) (lambda () (dk-nn! '(<= (succ k) n))))
  (dk-split! (dk-cite! 'rn-maxabs-typing 'k 'n 'xv)))
(c2n-typing-k!)
(c2n-unfold-succ!)
(c2n-max-typed!)
(fact 'interval-elt-in-nn 1 'n 'i)
(define c2n-cases (dk-cite! 'nn-le-succ-cases 'k 'i))
(define c2n-ge-leaves (dk-opened (lambda () (ai c2n-cases))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-asm? '(<= i k))
        (begin
          (dk-apply! (c2n-ih) 'n 'xv 'i)
          (dk-cite! 'rr-le-max-left '(RN-MAXABS xv k) '(abs (xv (succ k))))
          (dk-type! '(xv i))
          (dk-cite! 'rr-abs-closed '(xv i))
          (dk-ineq! '(<= (abs (xv i)) (RN-MAXABS xv k))
                    '(<= (RN-MAXABS xv k) (max (RN-MAXABS xv k) (abs (xv (succ k)))))))
        (begin
          (dk-cite! 'rr-le-max-right '(RN-MAXABS xv k) '(abs (xv (succ k))))
          (subst '(= i (succ k)))
          (ass))))
  c2n-ge-leaves)
(qed 'rn-maxabs-ge)

;;; (3) RN-MAXABS(xv, k) is below any common bound of the coordinates.
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (forall-guarded '(n xv c) (list '(IN n NN) (list 'IN 'xv c2n-V) '(<= k n) '(IN c RR) '(<= 0 c)
                                  '(FORALL j (IMPLIES (IN j (INTERVAL 1 n)) (<= (abs (xv j)) c))))
     '(<= (RN-MAXABS xv k) c))))))
(ni)
(dk-focus! (c2n-base-leaf))
(dk-peel!)
(fact 'rn-maxabs-zero 'xv)
(subst '(= (RN-MAXABS xv 0) 0))
(ass)
(dk-focus! (c2n-step-leaf))
(dk-di-var!)
(dk-peel!)
(c2n-grab-ih!)
(c2n-typing-k!)
(c2n-unfold-succ!)
(dk-apply! (c2n-ih) 'n 'xv 'c)
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'j))) "the bound") '(succ k))
(dk-cite! 'rr-max-le '(RN-MAXABS xv k) '(abs (xv (succ k))) 'c)
(ass)
(qed 'rn-maxabs-le)

;;; (4) the norm of RN(n), stated through VNRM
(sp (make-wff (forall-guarded '(n xv) (list '(IN n NN) (list 'IN 'xv c2n-V))
   '(AND (IN ((VNRM (RN n)) xv) RR) (<= 0 ((VNRM (RN n)) xv))))))
(dk-peel!)
(fact 'rn-vnrm-apply 'n 'xv)
(subst '(= ((VNRM (RN n)) xv) (RN-MAXABS xv n)))
(fact 'nn-le-refl 'n)
(dk-cite! 'rn-maxabs-typing 'n 'n 'xv)
(ass)
(qed 'rn-norm-typing)

(sp (make-wff (forall-guarded '(n xv i) (list '(IN n NN) (list 'IN 'xv c2n-V) '(IN i (INTERVAL 1 n)))
   '(<= (abs (xv i)) ((VNRM (RN n)) xv)))))
(dk-peel!)
(fact 'rn-vnrm-apply 'n 'xv)
(subst '(= ((VNRM (RN n)) xv) (RN-MAXABS xv n)))
(fact 'nn-le-refl 'n)
(fact 'interval-hi 1 'n 'i)
(dk-cite! 'rn-maxabs-ge 'n 'n 'xv 'i)
(ass)
(qed 'rn-norm-ge-coord)

(sp (make-wff (forall-guarded '(n xv c) (list '(IN n NN) (list 'IN 'xv c2n-V) '(IN c RR) '(<= 0 c)
                                  '(FORALL j (IMPLIES (IN j (INTERVAL 1 n)) (<= (abs (xv j)) c))))
   '(<= ((VNRM (RN n)) xv) c))))
(dk-peel!)
(fact 'rn-vnrm-apply 'n 'xv)
(subst '(= ((VNRM (RN n)) xv) (RN-MAXABS xv n)))
(fact 'nn-le-refl 'n)
(dk-cite! 'rn-maxabs-le 'n 'n 'xv 'c)
(ass)
(qed 'rn-norm-le)
