    (dk-have! (list 'FORSOME 'zq_ (list 'IN 'zq_ S))
      (lambda () (witness! l (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (dk-cite! 'choice-axiom S)
    (ass)))
(bb2-qed! 'bop-ptwise-limit)

;;; THE THEOREM
(sp (make-wff (forall-guarded '(v w) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-HILBERT-SPACE w))
   (list 'IS-COMPLETE bb2-M))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'w)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bop-normed-ag-is-normed-ag 'v 'w)
(dk-cite! 'nag-metric-space-is-metric-space bb2-G)
(dk-cite! 'ip-metric-space-is-metric-space 'w)
(define bb2-pw (dk-cite! 'ip-metric-space-pts 'w))
(define bb2-pm (dk-cite! 'nag-metric-carrier bb2-G))
(define bb2-cm (dk-cite! 'bop-nag-carr 'v 'w))
(define (bb2-in-pw! t)                  ; t in VEC w in context
  (dk-have! (list 'IN t (list 'PTS bb2-wms)) (lambda () (subst (list '= (list 'PTS bb2-wms) '(VEC w))) (ass))))
(define (bb2-in-pm! t)                  ; t in BO in context
  (dk-have! (list 'IN t (list 'PTS bb2-M))
    (lambda () (subst (list '= (list 'PTS bb2-M) (list 'CARR bb2-G)))
               (subst (list '= (list 'CARR bb2-G) bb2-BOw)) (ass))))
;;; the tail estimate: with N <= n and N <= k (k may be N), and `inner' the Cauchy clause at e,
;;; the goal d_w(g(n), f(k)(x)) <= e ||x|| for g = k |-> f(k)(x)
(define (bb2-tail! f x n k nN e inner)
  (dk-lam-b!)
  (bb2-seqt! f n) (bb2-seqt! f k)
  (bb2-ptype! (list f n) x) (bb2-ptype! (list f k) x)
  (bb2-in-pw! (list (list f n) x)) (bb2-in-pw! (list (list f k) x))
  (bb2-in-pm! (list f n)) (bb2-in-pm! (list f k))
  (let* ((nx (list 'IP-NORM 'v x)) (dd (bb2-dm (list f n) (list f k)))
         (dwv (bb2-dw (list (list f n) x) (list (list f k) x)))
         (p (dk-cite! 'bop-pt-dist 'v 'w (list f n) (list f k) x)))
    (bb2-have-and! (list '<= nN n) (list '<= nN k))
    (let ((q (dk-apply! inner n k)))
      (dk-cite! 'metric-dist-real bb2-M (list f n) (list f k))
      (dk-cite! 'metric-dist-real bb2-wms (list (list f n) x) (list (list f k) x))
      (bb2-nt! 'v x)
      (if (not (dk-asm? (list 'IN e 'RR))) (dk-have! (list 'IN e 'RR) (lambda () (arith))))
      (let ((r (dk-cite! 'rr-mul-le-right dd e nx)))
        (dk-have! (list '= (list '* nx dd) (list '* dd nx)) (lambda () (crs)))
        (bb2-lin! (list (list 'IN dwv 'RR) (list 'IN dd 'RR) (list 'IN e 'RR) (list 'IN nx 'RR))
                  (list p r (list '= (list '* nx dd) (list '* dd nx))))))))
(let* ((iff (dk-cite! 'is-complete bb2-M))
       (clause (caddr (caddr iff))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (cy (find-first (lambda (h) (dk-head-is? h 'IS-CAUCHY-SEQ)) lk))
             (f (caddr cy))
             (gx (lambda (x) (bb2-gx f x)))
             (fs (dk-cite! 'bop-cauchy-seq-fun 'v 'w f))
             (rhs (bb2-iff-fwd! 'is-cauchy-seq bb2-M f))
             (cu (caddr (caddr rhs)))
             (ab (dk-abstract! '(VEC v) '(VEC w) (lambda (x) (list 'CHOICE (bb2-lims f x)))
                   (lambda (k)
                     (let ((m (dk-cite! 'bop-ptwise-limit 'v 'w f k)))
                       (sep-me m)
                       (ass)))))
             (lfn (car ab)) (veq (cdr ab))
             (lim (list 'FORALL 'xq_ (list 'IMPLIES '(IN xq_ (VEC v))
                        (list 'CONVERGES-TO bb2-wms (gx 'xq_) (list lfn 'xq_)))))
             (lim-at! (lambda (x) (dk-apply! lim x)))
             (gfun! (lambda (x) (dk-cite! 'bop-ptwise-seq-fun 'v 'w f x)))
             (fx (lambda (x) (list lfn x)))
             (ftype! (lambda (x) (dk-cite! 'fun-apply-type-c lfn '(VEC v) '(VEC w) x))))
        ;; lfn(x) is the limit of f(k)(x)
        (dk-have! lim
          (lambda ()
            (let* ((lkx (dk-peel!))
                   (x (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lkx)))
                   (m (dk-cite! 'bop-ptwise-limit 'v 'w f x)))
              (sep-me m)
              (subst (dk-apply! veq x))
              (ass))))
        ;; linearity
        (dk-have! (list 'IS-LINEAR-OP 'v 'w lfn)
          (lambda ()
            (mac 'is-linear-op)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((dk-asm? g) (ass))
                    ((dk-contains? g '(VADD v))
                     (let* ((lk2 (dk-peel!))
                            (xs (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) lk2)))
                            (x (car xs)) (y (cadr xs))
                            (xy (list '(VADD v) x y))
                            (sm (list '(VADD w) (fx x) (fx y))))
                       (fluid-let ((bb2-v 'v)) (bb2-vt! xy))
                       (ftype! x) (ftype! y) (ftype! xy) (bb2-wt! sm) (bb2-in-pw! sm)
                       (gfun! xy) (gfun! x) (gfun! y)
                       (lim-at! xy) (lim-at! x) (lim-at! y)
                       (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN)
                                   (list '<= (bb2-dw (list (gx xy) 'nq_) sm)
                                         (list '+ (bb2-dw (list (gx x) 'nq_) (fx x)) (bb2-dw (list (gx y) 'nq_) (fx y))))))
                         (lambda ()
                           (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                             (dk-lam-b!)
                             (bb2-seqt! f n)
                             (bb2-ptype! (list f n) x) (bb2-ptype! (list f n) y)
                             (subst (dk-cite! 'bop-add 'v 'w (list f n) x y))
                             (dk-cite! 'ipms-dist-sum-le 'w (list (list f n) x) (list (list f n) y) (fx x) (fx y))
                             (ass))))
                       (dk-cite! 'ms-converges-of-dominated-sum bb2-wms bb2-wms bb2-wms (gx xy) (gx x) (gx y) sm (fx x) (fx y))
                       (dk-cite! 'metric-limit-unique bb2-wms (gx xy) (fx xy) sm)
                       (ass)))
                    ((dk-contains? g '(ACT v))
                     (let* ((lk2 (dk-peel!))
                            (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'CC))) lk2)))
                            (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))) lk2)))
                            (cx (list '(ACT v) c x))
                            (cf (list '(ACT w) c (fx x)))
                            (mc (list 'magnitude c)))
                       (fluid-let ((bb2-v 'v)) (bb2-vt! cx))
                       (ftype! x) (ftype! cx) (bb2-wt! cf) (bb2-in-pw! cf)
                       (gfun! cx) (gfun! x) (lim-at! cx) (lim-at! x)
                       (dk-cite! 'cc-magnitude-closed c) (dk-cite! 'cc-magnitude-nonneg c)
                       (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN)
                                   (list '<= (bb2-dw (list (gx cx) 'nq_) cf) (list '* mc (bb2-dw (list (gx x) 'nq_) (fx x))))))
                         (lambda ()
                           (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                             (dk-lam-b!)
                             (bb2-seqt! f n)
                             (bb2-ptype! (list f n) x)
                             (subst (dk-cite! 'bop-act 'v 'w (list f n) c x))
                             (dk-cite! 'ipms-dist-act-le 'w c (list (list f n) x) (fx x))
                             (ass))))
                       (dk-cite! 'ms-converges-of-scaled bb2-wms bb2-wms (gx cx) (gx x) cf (fx x) mc)
                       (dk-cite! 'metric-limit-unique bb2-wms (gx cx) (fx cx) cf)
                       (ass)))
                    (#t (error "bb2: linearity conjunct" (expression->string g)))))))))
        ;; boundedness, from the Cauchy clause at 1
        (dk-have! '(POS-RR 1) (lambda () (mac 'POS-RR) (dk-conj-close! (lambda () (arith)))))
        (let* ((n1 (dk-skolem! (dk-apply! cu 1)))
               (in1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq n1 (free-vars h)))) "the Cauchy clause at 1"))
               (fN (list f n1)) (oN (bb2-opn fN)) (m0 (list '+ 1 oN)))
          (bb2-seqt! f n1)
          (bb2-opn-facts! fN)
          (dk-have! (list '<= n1 n1) (lambda () (dk-nn!)))
          (dk-cite! 'rr-add-in-rr 1 oN)
          (dk-have! (list '<= 0 m0) (lambda () (dk-ineq! (list 'IN oN 'RR) (list '<= 0 oN))))
          (dk-have! (bb2-ub 'v 'w lfn m0)
            (lambda ()
              (dk-peel!)
              (let* ((x (caddr (caddr (caddr (dk-goal)))))
                     (a (list fN x)) (nx (list 'IP-NORM 'v x)) (bx (list '* 1 nx))
                     (dfa (bb2-dw (fx x) a)) (d1 (bb2-vsub 'w (fx x) a)) (s1 (list '(VADD w) d1 a)))
                (ftype! x) (bb2-ptype! fN x) (bb2-in-pw! a) (bb2-in-pw! (fx x))
                (bb2-nt! 'v x)
                (dk-have! (list 'IN 1 'RR) (lambda () (arith)))
                (bb2-mul-in! 1 nx)
                (gfun! x) (lim-at! x)
                (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list 'IMPLIES (list '<= n1 'nq_)
                            (list '<= (bb2-dw (list (gx x) 'nq_) a) bx))))
                  (lambda ()
                    (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                      (bb2-tail! f x n n1 n1 1 in1))))
                (let ((t1 (dk-cite! 'ms-limit-dist-le bb2-wms (gx x) (fx x) a bx n1)))
                  (bb2-wt! d1) (bb2-wt! s1)
                  (bb2-weq! s1 (fx x))
                  (let* ((mk (dk-cite! 'cips-minkowski 'w d1 a))
                         (mk2 (dk-rewrite-h! mk s1 (fx x)))
                         (de (dk-cite! 'ipms-dist-norm 'w (fx x) a))
                         (bN (dk-apply! (bb2-bound-of fN) x)))
                    (bb2-nt! 'w (fx x)) (bb2-nt! 'w a) (bb2-nt! 'w d1)
                    (dk-cite! 'metric-dist-real bb2-wms (fx x) a)
                    (dk-have! (list '= (list '* m0 nx) (list '+ nx (list '* oN nx))) (lambda () (crs)))
                    (dk-have! (list '= bx nx) (lambda () (crs)))
                    (bb2-lin! (list (list 'IN (list 'IP-NORM 'w (fx x)) 'RR) (list 'IN (list 'IP-NORM 'w a) 'RR)
                                    (list 'IN (list 'IP-NORM 'w d1) 'RR) (list 'IN dfa 'RR) (list 'IN nx 'RR)
                                    (list 'IN oN 'RR) (list 'IN m0 'RR))
                              (list mk2 de t1 bN (list '= bx nx)
                                    (list '= (list '* m0 nx) (list '+ nx (list '* oN nx))))))))))
          (dk-cite! 'bop-intro 'v 'w lfn m0))
        ;; convergence in the operator metric
        (bb2-in-pm! lfn)
        (let* ((ci (dk-cite! 'converges-to bb2-M f lfn))
               (cl (caddr (caddr (caddr (caddr ci))))))
          (dk-have! cl
            (lambda ()
              (let* ((lk3 (dk-peel!))
                     (e (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) lk3)))
                     (nv (dk-skolem! (dk-apply! cu e)))
                     (inner (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq nv (free-vars h)))) "the Cauchy clause")))
                (dk-cite! 'rr-pos-rr-in-rr e)
                (dk-cite! 'rr-lt-of-pos-rr e)
                (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
                (witness! nv
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN) (ass)
                            (let* ((lk4 (dk-peel!))
                                   (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) lk4)))
                                   (fk (list f k)) (nF (list 'BOP-NEG 'v 'w lfn)) (U (list 'BOP-SUM 'v 'w fk nF)))
                              (bb2-seqt! f k)
                              (subst (dk-cite! 'bop-nag-dist 'v 'w fk lfn))
                              (bb2-optype! U)
                              (dk-have! (bb2-ub 'v 'w U e)
                                (lambda ()
                                  (dk-peel!)
                                  (let* ((x (caddr (caddr (caddr (dk-goal)))))
                                         (nx (list 'IP-NORM 'v x)) (b (list '* e nx))
                                         (fkx (list fk x)))
                                    (bb2-ptype! fk x) (ftype! x) (bb2-ptype! nF x)
                                    (dk-cite! 'bop-fun 'v 'w U)
                                    (subst (dk-cite! 'bop-sum-apply 'v 'w fk nF x))
                                    (subst (dk-cite! 'bop-neg-apply 'v 'w lfn x))
                                    (bb2-wt! (bb2-vsub 'w fkx (fx x)))
                                    (let ((de (dk-cite! 'ipms-dist-norm 'w fkx (fx x))))
                                      (subst (list '= (caddr de) (cadr de))))
                                    (bb2-in-pw! fkx) (bb2-in-pw! (fx x))
                                    (subst (dk-cite! 'metric-sym bb2-wms fkx (fx x)))
                                    (bb2-nt! 'v x)
                                    (bb2-mul-in! e nx)
                                    (gfun! x) (lim-at! x)
                                    (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list 'IMPLIES (list '<= nv 'nq_)
                                                (list '<= (bb2-dw (list (gx x) 'nq_) fkx) b))))
                                      (lambda ()
                                        (let* ((lk5 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk5))))
                                          (bb2-tail! f x n k nv e inner))))
                                    (dk-cite! 'ms-limit-dist-le bb2-wms (gx x) (fx x) fkx b nv)
                                    (ass))))
                              (bb2-spec! U)
                              (dk-apply! (bb2-least U) e)
                              (ass)))))))))))
          (bb2-iff-bwd! 'converges-to bb2-M f lfn)
          (dk-have! (list 'FORSOME 'lq_ (list 'CONVERGES-TO bb2-M f 'lq_))
            (lambda () (witness! lfn (lambda () (ass)))))
          (bb2-iff-bwd! 'converges bb2-M f)
          (ass))))
  (bb2-iff-bwd! 'is-complete bb2-M)
  (ass))
(bb2-qed! 'bop-complete)

;;; the tuple BH-ALGEBRA(v) unfolds to, and the conjuncts of the structure IFFs at it
(define bh2-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define bh2-vals (list bh2-ring '(BOUNDED-OPS v v) '(BH-VADD v) '(BOP-ZERO v v) '(BH-VNEG v) '(BH-ACT v)
                       '(BH-VNRM v) '(BH-VMUL v) '(BOP-ID v) '(BH-VSTAR v)))
(define bh2-accs '(SCAL VEC VADD VZERO VNEG ACT VNRM VMUL VONE VSTAR))
(define (bh2-first n l) (if (= n 0) '() (cons (car l) (bh2-first (- n 1) (cdr l)))))
(define (bh2-replace old new e)
  (cond ((eq? e old) new) ((pair? e) (map (lambda (x) (bh2-replace old new x)) e)) (#t e)))
(define (bh2-index x l) (let loop ((l l) (i 1)) (cond ((null? l) #f) ((eq? (car l) x) i) (#t (loop (cdr l) (+ i 1))))))
(define (bh2-acc-red e)
  (cond ((not (pair? e)) e)
        ((and (symbol? (car e)) (bh2-index (car e) bh2-accs) (= (length e) 2) (pair? (cadr e)) (eq? (car (cadr e)) 'LIST)
              (<= (bh2-index (car e) bh2-accs) (length (cdr (cadr e)))))
         (bh2-acc-red (list-ref (cdr (cadr e)) (- (bh2-index (car e) bh2-accs) 1))))
        (#t (map bh2-acc-red e))))
(define (bh2-conjs f) (if (dk-head-is? f 'AND) (append (bh2-conjs (cadr f)) (bh2-conjs (caddr f))) (list f)))
(define (bh2-iff-conjs thm tuple)
  (let* ((f (lookup-theorem thm)) (v (cadr f)) (iff (caddr f)))
    (bh2-conjs (bh2-acc-red (bh2-replace v tuple (caddr iff))))))
(define (bh2-tuple n) (cons 'LIST (bh2-first n bh2-vals)))
(define bh2-cna-conjs (bh2-iff-conjs 'is-complex-normed-algebra (bh2-tuple 8)))
(define bh2-cba-conjs (bh2-iff-conjs 'is-complex-banach-algebra-def (bh2-tuple 8)))
(define bh2-uba-conjs (bh2-iff-conjs 'is-unital-banach-algebra (bh2-tuple 9)))
(define bh2-uiba-conjs (bh2-iff-conjs 'is-unital-involutive-banach-algebra (bh2-tuple 10)))
(define bh2-ucsa-conjs (bh2-iff-conjs 'is-unital-c-star-algebra-def (bh2-tuple 10)))

;;; ==========================================================================================
;;; (H) B(H) IS A UNITAL C*-ALGEBRA.  Each law is the conjunct of the structure's IFF at the
;;; literal tuple, proved by rewriting the BH-* operations to the BOP-* constructions (their
;;; value laws) and backchaining on the operator law of parts A-C or of BA-BH.
;;; ==========================================================================================
(set! bb2-dv 'v) (set! bb2-cw 'v)
(define bh2-BO '(BOUNDED-OPS v v))
(define bh2-HV '((IS-HILBERT-SPACE v)))
(define bh2-CV '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define (bh2-done?) (sequent-node-grounded? (proof-state-focus *ps*)))

;;; type every operator term of E, innermost first (OP-ADJOINT needs v Hilbert in context)
(define (bh2-type-all! e)
  (if (pair? e)
      (begin
        (for-each bh2-type-all! (cdr e))
        (cond ((eq? (car e) 'OP-ADJOINT)
               (if (not (dk-asm? (list 'IN e bh2-BO))) (dk-cite! 'op-adjoint-bounded 'v 'v (cadddr e)))
               (if (not (dk-asm? (list 'IN e (list 'FUN '(VEC v) '(VEC v))))) (dk-cite! 'bop-fun 'v 'v e)))
              ((memq (car e) '(BOP-SUM BOP-NEG BOP-SCALE BOP-ZERO BOP-COMP BOP-ID))
               (if (not (dk-asm? (list 'IN e bh2-BO))) (bb2-optype! e)))
              ((and (memq (car e) '(+ *)) (= (length e) 3) (not (dk-asm? (list 'IN e 'CC)))
                    (dk-asm? (list 'IN (cadr e) 'CC)) (dk-asm? (list 'IN (caddr e) 'CC)))
               (bb2-have-and! (list 'IN (cadr e) 'CC) (list 'IN (caddr e) 'CC))
               (dk-cite! (if (eq? (car e) '+) 'cc-add-closed 'cc-mul-closed) (cadr e) (caddr e)))
              ((and (eq? (car e) 'conjugate) (not (dk-asm? (list 'IN e 'CC))))
               (dk-cite! 'cc-conjugate-closed (cadr e)))
              (#t #t)))))

;;; the BH-* operations and their values
(define bh2-optab
  '((BH-VADD bh-vadd-value (BOP-SUM v v) 2) (BH-VNEG bh-vneg-value (BOP-NEG v v) 1)
    (BH-ACT bh-act-value (BOP-SCALE v v) 2) (BH-VNRM bh-vnrm-value (OPNORM v v) 1)
    (BH-VMUL bh-vmul-value (BOP-COMP v) 2) (BH-VSTAR bh-vstar-value (OP-ADJOINT v v) 1)))
(define (bh2-app? e) (and (pair? e) (pair? (car e)) (assq (car (car e)) bh2-optab) (equal? (cdr (car e)) '(v))))
(define (bh2-redex e)                   ; an innermost applied BH-* operation
  (cond ((not (pair? e)) #f)
        ((let loop ((l e)) (cond ((not (pair? l)) #f) ((bh2-redex (car l)) => (lambda (x) x)) (#t (loop (cdr l)))))
         => (lambda (x) x))
        ((bh2-app? e) e)
        (#t #f)))
(define (bh2-vals!)
  (let loop ((fuel 40))
    (let ((r (bh2-redex (dk-goal))))
      (if (and r (> fuel 0))
          (let ((row (assq (car (car r)) bh2-optab)))
            (for-each bh2-type-all! (cdr r))
            (subst (apply dk-cite! (cadr row) 'v (cdr r)))
            (loop (- fuel 1)))))))

;;; the scalar ring of CC, read off
(define bh2-ring-eqs
  (list (list (list 'CARR bh2-ring) 'cc-scalar-ring-carr) (list (list 'ADD bh2-ring) 'cc-scalar-ring-add)
        (list (list 'MUL bh2-ring) 'cc-scalar-ring-mul) (list (list 'ONE bh2-ring) 'cc-scalar-ring-one)))
(define (bh2-ring-subst!)
  (for-each (lambda (p) (if (dk-contains? (dk-goal) (car p)) (subst (dk-cite! (cadr p))))) bh2-ring-eqs))
(define (bh2-scal-typ!)
  (let ((cr (list 'CARR bh2-ring)))
    (for-each (lambda (a) (if (and (dk-head-is? a 'IN) (equal? (caddr a) cr) (not (dk-asm? (list 'IN (cadr a) 'CC))))
                              (begin (dk-cite! 'cc-scalar-ring-carr) (dk-rewrite-h! a cr 'CC))))
              (dk-asms))))

;;; close an operator law by backchaining on the first library law whose conclusion matches
(define bh2-laws
  '(bop-sum-assoc bop-sum-comm bop-sum-zero-left bop-sum-zero-right bop-sum-neg-left bop-sum-neg-right
    bop-comp-assoc bop-scale-sum bop-scale-add bop-scale-mul bop-scale-one
    opnorm-nonneg opnorm-definite opnorm-scale opnorm-triangle
    bop-comp-sum-left bop-comp-sum-right bop-comp-scale-left bop-comp-scale-right opnorm-comp-le
    bop-comp-id-left bop-comp-id-right opnorm-id
    op-adjoint-sum op-adjoint-scale op-adjoint-involutive op-adjoint-comp op-adjoint-opnorm-eq bh-c-star-identity))
(define (bh2-sub-close!)
  (let ((g (dk-goal)))
    (cond ((bh2-done?) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IN) (pair? (cadr g))) (bh2-type-all! (cadr g)) (if (dk-asm? g) (ass)
                                                        (error "bh2: subgoal" (expression->string g))))
          (#t (error "bh2: subgoal" (expression->string g))))))
(define (bh2-bc! g)                     ; #t when some law backchained onto G (the focus goal)
  (let try ((ls bh2-laws))
    (if (null? ls) #f
        (let ((gs (bc*-run! (car ls) '())))
          (if (list? gs)
              (begin (for-each (lambda (s) (if (not (sequent-node-grounded? s)) (begin (dk-focus! s) (bh2-sub-close!)))) gs)
                     #t)
              (try (cdr ls)))))))
(define (bh2-close!)
  (let ((g (dk-goal)))
    (bh2-type-all! g)
    (cond ((bh2-done?) #t)
          ((dk-asm? g) (ass))
          ((bh2-bc! g) #t)
          ((dk-head-is? g '=)
           ;; the law may be stated the other way round
           (let ((sw (list '= (caddr g) (cadr g))))
             (dk-have! sw (lambda () (if (not (bh2-bc! sw)) (error "bh2: no law for" (expression->string g)))))
             (subst (list '= (cadr g) (caddr g)))
             (if (not (bh2-done?)) (rfl))))
          (#t (error "bh2: no law for" (expression->string g))))))
(define (bh2-law-body!)
  (let ((g (dk-goal)))
    (cond ((bh2-done?) #t)
          ((memq (dk-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES)) (mac (dk-head g)) (bh2-law-body!))
          ((dk-head-is? g 'FORALL) (dk-peel!) (bh2-scal-typ!) (bh2-law-body!))
          ((dk-head-is? g 'IMPLIES) (dk-peel!) (bh2-law-body!))
          ((dk-head-is? g 'AND) (dk-conj-close! bh2-law-body!))
          (#t (bh2-ring-subst!)
              (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
              (bh2-vals!)
              (bh2-close!)))))
(define (bh2-law-thm! name conj hyps)
  (sp (make-wff (forall-guarded '(v) hyps conj)))
  (dk-peel!)
  (if (dk-asm? '(IS-HILBERT-SPACE v)) (dk-cite! 'hilbert-space-is-cips 'v))
  (bh2-ring-subst!)
  (bh2-scal-typ!)
  (bh2-law-body!)
  (bb2-qed! name))

;;; ---- the operations: typings and values ----
(define (bh2-type-thm! name op cod hyps)
  (sp (make-wff (forall-guarded '(v) hyps (list 'IN (list op 'v) cod))))
  (dk-peel!)
  (if (dk-asm? '(IS-HILBERT-SPACE v)) (dk-cite! 'hilbert-space-is-cips 'v))
  (dk-cite! 'bounded-ops-is-set 'v 'v)
  (dk-cite! 'cc-is-set)
  (mac op)
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (let ((body (cadr (dk-goal))))
        (bh2-type-all! body)
        (if (dk-head-is? body 'OPNORM) (dk-cite! 'opnorm-in-rr 'v 'v (cadddr body)))
        (ass)))
    (lambda () (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                   (ass))))
  (bb2-qed! name))
(define bh2-CC2 (list 'CARTESIAN bh2-BO bh2-BO))
(bh2-type-thm! 'bh-vadd-type 'BH-VADD (list 'FUN bh2-CC2 bh2-BO) bh2-CV)
(bh2-type-thm! 'bh-vneg-type 'BH-VNEG (list 'FUN bh2-BO bh2-BO) bh2-CV)
(bh2-type-thm! 'bh-act-type 'BH-ACT (list 'FUN (list 'CARTESIAN 'CC bh2-BO) bh2-BO) bh2-CV)
(bh2-type-thm! 'bh-vnrm-type 'BH-VNRM (list 'FUN bh2-BO 'RR) bh2-CV)
(bh2-type-thm! 'bh-vmul-type 'BH-VMUL (list 'FUN bh2-CC2 bh2-BO) bh2-CV)
(bh2-type-thm! 'bh-vstar-type 'BH-VSTAR (list 'FUN bh2-BO bh2-BO) bh2-HV)

(define (bh2-value-thm! name op args guards val hyps)
  (sp (make-wff (forall-guarded (cons 'v args) (append hyps guards)
                  (list '= (cons (list op 'v) args) val))))
  (dk-peel!)
  (if (dk-asm? '(IS-HILBERT-SPACE v)) (dk-cite! 'hilbert-space-is-cips 'v))
  (bh2-type-all! val)
  (if (dk-head-is? val 'OPNORM) (dk-cite! 'opnorm-in-rr 'v 'v (cadddr val)))
  (mac op)
  (dk-lam-b!)
  (if (not (bh2-done?)) (rfl))
  (bb2-qed! name))
(define (bh2-in-bo . ts) (map (lambda (t) (list 'IN t bh2-BO)) ts))
(bh2-value-thm! 'bh-vadd-value 'BH-VADD '(s_ t_) (bh2-in-bo 's_ 't_) '(BOP-SUM v v s_ t_) bh2-CV)
(bh2-value-thm! 'bh-vneg-value 'BH-VNEG '(t_) (bh2-in-bo 't_) '(BOP-NEG v v t_) bh2-CV)
(bh2-value-thm! 'bh-act-value 'BH-ACT '(c_ t_) (cons '(IN c_ CC) (bh2-in-bo 't_)) '(BOP-SCALE v v c_ t_) bh2-CV)
(bh2-value-thm! 'bh-vnrm-value 'BH-VNRM '(t_) (bh2-in-bo 't_) '(OPNORM v v t_) bh2-CV)
(bh2-value-thm! 'bh-vmul-value 'BH-VMUL '(s_ t_) (bh2-in-bo 's_ 't_) '(BOP-COMP v s_ t_) bh2-CV)
(bh2-value-thm! 'bh-vstar-value 'BH-VSTAR '(t_) (bh2-in-bo 't_) '(OP-ADJOINT v v t_) bh2-HV)

;;; ---- the laws ----
(define (bh2-laws! conjs names hyps)
  (for-each (lambda (p) (bh2-law-thm! (cadr p) (list-ref conjs (car p)) hyps)) names))
(bh2-laws! bh2-cna-conjs
  '((9 bh-vadd-assoc) (10 bh-vadd-comm) (11 bh-vadd-ident) (12 bh-vadd-inv) (13 bh-vmul-assoc)
    (16 bh-act-vadd) (17 bh-act-add) (18 bh-act-mul) (19 bh-act-one)
    (20 bh-vnrm-nonneg) (21 bh-vnrm-zero-iff) (22 bh-vnrm-act) (23 bh-vnrm-triangle)
    (24 bh-vmul-vadd-right) (25 bh-vmul-vadd-left) (26 bh-vmul-act-left) (27 bh-vmul-act-right)
    (28 bh-vnrm-submult))
  bh2-CV)
(bh2-laws! bh2-uba-conjs '((12 bh-vmul-unit-left) (13 bh-vmul-unit-right)) bh2-CV)
(bh2-law-thm! 'bh-vnrm-vone (list-ref bh2-uba-conjs 14) (append bh2-CV (list bb2-nontriv)))
(bh2-laws! bh2-uiba-conjs
  '((13 bh-vstar-vadd) (14 bh-vstar-act) (15 bh-vstar-vstar) (16 bh-vstar-vmul) (17 bh-vnrm-vstar)) bh2-HV)
(bh2-law-thm! 'bh-vnrm-cstar (list-ref bh2-ucsa-conjs 1) bh2-HV)

;;; ---- the tower ----
(define (bh2-alg-typings!)
  (if (dk-asm? '(IS-HILBERT-SPACE v)) (dk-cite! 'hilbert-space-is-cips 'v))
  (dk-cite! 'bounded-ops-is-set 'v 'v)
  (for-each (lambda (n) (dk-cite! n 'v)) '(bh-vadd-type bh-vneg-type bh-act-type bh-vnrm-type bh-vmul-type bop-id-bounded))
  (if (dk-asm? '(IS-HILBERT-SPACE v)) (dk-cite! 'bh-vstar-type 'v))
  (dk-cite! 'bop-zero-bounded 'v 'v)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring bh2-ring))
(define (bh2-conj-closer!)
  (let ((g (dk-goal)))
    (cond ((bh2-done?) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (len-r) (if (not (bh2-done?)) (arith)))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET) (dk-head-is? (cadr g) 'LIST)) (dk-list-in-set!))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((equal? g (list '= (list 'CARR bh2-ring) 'CC)) (dk-cite! 'sip-cc-ring-carr) (ass))
          ((dk-contains? g (list 'CARR bh2-ring)) (bh2-ring-subst!) (bh2-conj-closer!))
          (#t (ass)))))
(define (bh2-unfold-tuple! iff n)
  (mac iff)
  (for-each (lambda (a) (if (dk-contains? (dk-goal) a) (slot a))) (bh2-first n bh2-accs))
  (let loop ((k 0)) (if (and (< k 40) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ k 1))))))
(define (bh2-tower! name hyps pred n iff lemmas)
  (sp (make-wff (forall-guarded '(v) hyps (list pred (bh2-tuple n)))))
  (dk-peel!)
  (bh2-alg-typings!)
  (for-each (lambda (l) (dk-cite! l 'v)) lemmas)
  (bh2-unfold-tuple! iff n)
  (dk-conj-close! bh2-conj-closer!)
  (bb2-qed! name))
(bh2-tower! 'bh-algebra-is-cna bh2-CV 'IS-COMPLEX-NORMED-ALGEBRA 8 'is-complex-normed-algebra
  '(bh-vadd-assoc bh-vadd-comm bh-vadd-ident bh-vadd-inv bh-vmul-assoc bh-act-vadd bh-act-add bh-act-mul bh-act-one
    bh-vnrm-nonneg bh-vnrm-zero-iff bh-vnrm-act bh-vnrm-triangle bh-vmul-vadd-right bh-vmul-vadd-left
    bh-vmul-act-left bh-vmul-act-right bh-vnrm-submult))

;;; the normed group of the 8-tuple is BOP-NORMED-AG(v, v), so it is complete
(define bh2-L8 (bh2-tuple 8))
(sp (make-wff (forall-guarded '(v) bh2-CV (list '== (list 'CNA-AS-NORMED-AG bh2-L8) '(BOP-NORMED-AG v v)))))
(dk-peel!)
(bh2-alg-typings!)
(mac 'CNA-AS-NORMED-AG)
(for-each (lambda (a) (if (dk-contains? (dk-goal) (list a bh2-L8)) (slot a))) '(VEC VADD VZERO VNEG VNRM))
(let loop ((k 0)) (if (and (< k 40) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ k 1)))))
(mac 'BOP-NORMED-AG)
(for-each (lambda (m) (if (dk-contains? (dk-goal) m) (mac m))) '(BOP-VADD BOP-VINV BOP-VNRM BH-VADD BH-VNEG BH-VNRM))
(if (not (bh2-done?)) (qrfl))
(bb2-qed! 'bh-nag-view)

(sp (make-wff (forall-guarded '(v) bh2-HV
   (list 'IS-COMPLETE (list 'NAG-METRIC-SPACE (list 'CNA-AS-NORMED-AG bh2-L8))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'bop-complete 'v 'v)
(dk-cite! 'bh-nag-view 'v)
(subst (list '= (list 'CNA-AS-NORMED-AG bh2-L8) '(BOP-NORMED-AG v v)))
(ass)
(bb2-qed! 'bh-algebra-complete)

(define bh2-HN (append bh2-HV (list bb2-nontriv)))
(bh2-tower! 'bh-algebra-is-cba bh2-HV 'IS-COMPLEX-BANACH-ALGEBRA 8 'is-complex-banach-algebra-def
  '(bh-algebra-is-cna bh-algebra-complete))
(bh2-tower! 'bh-algebra-is-uba bh2-HN 'IS-UNITAL-BANACH-ALGEBRA 9 'is-unital-banach-algebra
  '(bh-algebra-is-cba bh-vmul-unit-left bh-vmul-unit-right bh-vnrm-vone))
(bh2-tower! 'bh-algebra-is-uiba bh2-HN 'IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA 10 'is-unital-involutive-banach-algebra
  '(bh-algebra-is-uba bh-vstar-vadd bh-vstar-act bh-vstar-vstar bh-vstar-vmul bh-vnrm-vstar))
(bh2-tower! 'bh-algebra-is-ucsa-tuple bh2-HN 'IS-UNITAL-C-STAR-ALGEBRA 10 'is-unital-c-star-algebra-def
  '(bh-algebra-is-uiba bh-vnrm-cstar))

;;; THE THEOREM: B(H) is a unital C*-algebra, H a nontrivial Hilbert space
(sp (make-wff (forall-guarded '(v) bh2-HN '(IS-UNITAL-C-STAR-ALGEBRA (BH-ALGEBRA v)))))
(dk-peel!)
(dk-cite! 'bh-algebra-is-ucsa-tuple 'v)
(mac 'BH-ALGEBRA)
(ass)
(bb2-qed! 'bh-algebra-unital-c-star)
