;;; ba-bh2.scm -- wave of 2026-11-09/10 (agent BA-BH2), wired 2026-11-10 from scratchpad/babh2-1109/ba-bh2.scm.
;;; Library: operator-algebras.

;;; ba-bh2.scm -- BA-BH2 (2026-11-09): the bounded operators B(V, W) as a normed abelian group, their module,
;;; norm and composition laws, completeness in the operator norm, and B(H) a unital C*-algebra for a
;;; nontrivial Hilbert space H.  Vocabulary: structure-library/ba-bh2-vocab.scm.  Library operator-algebras
;;; (part E, three metric lemmas, is general analysis).

;;; bb2 helpers: copies of ba-bh.scm's bbh- helpers (themselves copies of hilbert-projection.scm's hpr- kit), prefix bb2-.
(define bb2-v 'v)
(define (bb2-ip a b) (list (list 'IP bb2-v) a b))
(define (bb2-sub a b) (list (list 'VADD bb2-v) a (list (list 'VNEG bb2-v) b)))
(define (bb2-add a b) (list (list 'VADD bb2-v) a b))
(define (bb2-act c a) (list (list 'ACT bb2-v) c a))
(define (bb2-q a) (bb2-ip a a))

(define (bb2-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) bb2-v)))
(define (bb2-zero? e) (equal? e (list 'VZERO bb2-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (bb2-vt! e)
  (let ((goal (list 'IN e (list 'VEC bb2-v))))
    (cond ((and (dk-asm? goal) (not (or (bb2-op? e 'VADD) (bb2-op? e 'VNEG) (bb2-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((bb2-op? e 'VADD) (bb2-vt! (cadr e)) (bb2-vt! (caddr e)))
                 ((bb2-op? e 'VNEG) (bb2-vt! (cadr e)))
                 ((bb2-op? e 'ACT)  (bb2-ct! (cadr e)) (bb2-vt! (caddr e))))
           goal)
          ((bb2-op? e 'VADD) (bb2-vt! (cadr e)) (bb2-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type bb2-v (cadr e) (caddr e)) goal)
          ((bb2-op? e 'VNEG) (bb2-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type bb2-v (cadr e)) goal)
          ((bb2-op? e 'ACT)  (bb2-ct! (cadr e)) (bb2-vt! (caddr e))
                             (dk-cite! 'cips-act-type bb2-v (cadr e) (caddr e)) goal)
          ((bb2-zero? e) (dk-cite! 'cips-vzero-in bb2-v) goal)
          ((bb2-app-fun e) => (lambda (ft) (bb2-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "bb2-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (bb2-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC bb2-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (bb2-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC bb2-v)) (bb2-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((bb2-v (cadr d))) (bb2-vt! a)))
        (#t (error "bb2-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (bb2-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((bb2-op? c 'IP) (bb2-vt! (cadr c)) (bb2-vt! (caddr c))
                           (dk-cite! 'cips-ip-type bb2-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (bb2-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (bb2-ct! (cadr c)) (bb2-ct! (caddr c))
           (bb2-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (bb2-ct! (cadr c)) (bb2-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (bb2-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (bb2-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (bb2-op? e 'IP) (= (length e) 3)
              (or (bb2-compound? (cadr e)) (bb2-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bb2-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (bb2-compound? e)
  (or (bb2-op? e 'VADD) (bb2-op? e 'VNEG) (bb2-op? e 'ACT) (bb2-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (bb2-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (bb2-vt! a) (bb2-vt! b)
    (cond ((bb2-op? a 'VADD) (dk-cite! 'cips-ip-add-left bb2-v (cadr a) (caddr a) b))
          ((bb2-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left bb2-v (cadr a) b))
          ((bb2-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left bb2-v (cadr a) (caddr a) b))
          ((bb2-zero? a)     (dk-cite! 'cips-ip-zero-left bb2-v b))
          ((bb2-op? b 'VADD) (dk-cite! 'cips-ip-add-right bb2-v a (cadr b) (caddr b)))
          ((bb2-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right bb2-v a (cadr b)))
          ((bb2-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right bb2-v (cadr b) a (caddr b)))
          ((bb2-zero? b)     (dk-cite! 'cips-ip-zero-right bb2-v a))
          (#t (error "bb2-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (bb2-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (bb2-op? x 'IP) (= (length x) 3))))))
(define (bb2-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((bb2-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bb2-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (bb2-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "bb2-expand!: out of fuel"))
    (let ((r (bb2-find-redex (dk-goal))))
      (if r
          (let ((eq (bb2-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (bb2-find-real-conj (dk-goal))))
            (if c
                (begin
                  (bb2-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (bb2-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((bb2-op? x 'IP)
           (bb2-vt! (cadr x)) (bb2-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym bb2-v (cadr x) (caddr x))
           (subst (list '= c (bb2-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (bb2-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (bb2-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (bb2-ct! (cadr x)) (bb2-ct! (caddr x))
           (bb2-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (bb2-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (bb2-q-facts! u)
  (bb2-vt! u)
  (dk-cite! 'cips-ip-self-real bb2-v u)
  (dk-cite! 'cips-ip-self-nonneg bb2-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (bb2-norm-sq! u)
  (bb2-vt! u)
  (subst (dk-cite! 'ip-norm-unfold bb2-v u))
  (bb2-q-facts! u)
  (bb2-sqrt! (bb2-q u))
  (subst (dk-cite! 'sqrt-sq (bb2-q u))))
(define (bb2-nsq u) (list '* (list 'IP-NORM bb2-v u) (list 'IP-NORM bb2-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (bb2-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (bb2-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (bb2-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (bb2-and (cdr fs)))))
(define (bb2-have-and! . fs)
  (let ((c (bb2-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (bb2-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((bb2-op? e 'IP) (bb2-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (bb2-ct! e))
        (#t (for-each bb2-type-ips! e))))

(define (bb2-qd p xi) (bb2-q (bb2-sub p xi)))
(define (bb2-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (bb2-vt! a) (bb2-vt! b)
          (dk-have! (list '= (bb2-qd a b) 0)
            (lambda () (bb2-expand!) (bb2-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero bb2-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (bb2-q-eq! a b)
  (let ((goal (list '= (bb2-q a) (bb2-q b))))
    (if (not (dk-asm? goal))
        (begin (bb2-vt! a) (bb2-vt! b)
               (dk-have! goal (lambda () (bb2-expand!) (bb2-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (bb2-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** BB2: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "BB2: unfinished" name))))
;;; dump the focus leaf (debugging)
(define (bb2-show! tag)
  (display "\n--- BBH ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (bb2-sub! ks x)
  (dk-cite! 'submodule-subset bb2-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC bb2-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (bb2-scal! c)
  (dk-cite! 'cips-scal-carrier bb2-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL bb2-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL bb2-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix bb2-) -----------------------------------------------
(define bb2-w 'w)
(define (bb2-n u) (list 'IP-NORM bb2-v u))
(define (bb2-ipv a b) (list '(IP v) a b))
(define (bb2-ipw a b) (list '(IP w) a b))
(define (bb2-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (bb2-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (bb2-prods e)
  (cond ((bb2-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map bb2-prods (cdr e)))
        (#t '())))
(define (bb2-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (bb2-prod? (cadr p)) (bb2-mul-type! (cadr p)))
        (if (bb2-prod? (caddr p)) (bb2-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (bb2-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (bb2-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map bb2-prods prems) (bb2-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (bb2-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (bb2-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (bb2-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (bb2-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))

;;; ---- PART A: the operator constructions, pointwise; closure of L(v, w) -----------------------
(define bb2-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w)))

;;; the values of the constructions at a point
(sp (make-wff (forall-guarded '(v w s_ t_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN s_ (FUN (VEC v) (VEC w))) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((BOP-SUM v w s_ t_) x_) ((VADD w) (s_ x_) (t_ x_))))))
(dk-peel!)
(fluid-let ((bb2-v 'w)) (bb2-vt! '((VADD w) (s_ x_) (t_ x_))))
(mac 'BOP-SUM) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-sum-apply)

(sp (make-wff (forall-guarded '(v w t_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((BOP-NEG v w t_) x_) ((VNEG w) (t_ x_))))))
(dk-peel!)
(fluid-let ((bb2-v 'w)) (bb2-vt! '((VNEG w) (t_ x_))))
(mac 'BOP-NEG) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-neg-apply)

(sp (make-wff (forall-guarded '(v w c_ t_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN c_ CC) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((BOP-SCALE v w c_ t_) x_) ((ACT w) c_ (t_ x_))))))
(dk-peel!)
(fluid-let ((bb2-v 'w)) (bb2-vt! '((ACT w) c_ (t_ x_))))
(mac 'BOP-SCALE) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-scale-apply)

(sp (make-wff (forall-guarded '(v w x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN x_ (VEC v)))
   '(= ((BOP-ZERO v w) x_) (VZERO w)))))
(dk-peel!)
(dk-cite! 'cips-vzero-in 'w)
(mac 'BOP-ZERO) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-zero-apply)

;;; ||-x|| = ||x||
(sp (make-wff (forall-guarded '(v x_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)))
   '(= (IP-NORM v ((VNEG v) x_)) (IP-NORM v x_)))))
(dk-peel!)
(set! bb2-v 'v)
(bb2-vt! '((VNEG v) x_))
(subst (dk-cite! 'ip-norm-unfold 'v '((VNEG v) x_)))
(subst (dk-cite! 'ip-norm-unfold 'v 'x_))
(subst (dk-cite! 'cips-ip-neg-self 'v 'x_))
(bb2-q-facts! 'x_)
(bb2-sqrt! (bb2-q 'x_))
(rfl)
(bb2-qed! 'ip-norm-vneg)

;;; ---- closure ---------------------------------------------------------------------------------
;;; the vector typing of an operator value in w
(define (bb2-wt! e) (fluid-let ((bb2-v 'w)) (bb2-vt! e)))
(define (bb2-vvt! e) (fluid-let ((bb2-v 'v)) (bb2-vt! e)))
(define (bb2-weq! a b) (fluid-let ((bb2-v 'w)) (bb2-vec-eq! a b)))
;;; IS-LINEAR-OP v w OP for a construction OP, given its value law APP! (a procedure of the point
;;; that rewrites (OP x) in the goal) and the vector identity closer
(define (bb2-linear! op app! fun!)
  (dk-have! (list 'IS-LINEAR-OP 'v 'w op)
    (lambda ()
      (mac 'is-linear-op)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
             ((dk-head-is? g 'IN) (fun!))
             ((dk-contains? g '(VADD v))
              (dk-peel!)
              (let* ((s (cadr (cadr (dk-goal)))) (x (cadr s)) (y (caddr s)))
                (bb2-vvt! s)
                (app! s) (app! x) (app! y)
                (bb2-lin-close! 'add x y)))
             (#t
              (dk-peel!)
              (let* ((s (cadr (cadr (dk-goal)))) (c (cadr s)) (x (caddr s)))
                (bb2-vvt! s)
                (app! s) (app! x)
                (bb2-lin-close! 'act c x))))))))))
;;; after the value laws: rewrite the component operators by bop-add / bop-act, then the vector
;;; identity in w
(define bb2-comps '())
(define (bb2-lin-close! kind a b)
  (for-each (lambda (t)
              (if (eq? kind 'add)
                  (if (dk-contains? (dk-goal) (list t (list '(VADD v) a b)))
                      (subst (dk-cite! 'bop-add 'v 'w t a b)))
                  (if (dk-contains? (dk-goal) (list t (list '(ACT v) a b)))
                      (subst (dk-cite! 'bop-act 'v 'w t a b)))))
            bb2-comps)
  (let ((g (dk-goal)))
    (bb2-weq! (cadr g) (caddr g))
    (if (not (proof-done? *ps*)) (ass))))
;;; the FUN typing of a construction (mac its head, dk-lam-type!)
(define (bb2-fun! head)
  (lambda ()
    (mac head)
    (dk-lam-type! (lambda () (dk-peel!) (bb2-wt! (cadr (dk-goal))) (if (not (proof-done? *ps*)) (ass)))
                  (lambda () (dk-cite! 'cips-vec-set 'v) (ass)))))
;;; the bound clause for OP with bound MM, its pointwise proof PT! a procedure of the point
(define (bb2-bound! op mm pt!)
  (dk-have! (bb2-ub 'v 'w op mm)
    (lambda ()
      (dk-peel!)
      (pt! (caddr (caddr (caddr (dk-goal))))))))
(define (bb2-bop-pre!)
  (dk-peel!)
  (set! bb2-v 'w)
  (for-each (lambda (t) (dk-cite! 'bop-fun 'v 'w t)) bb2-comps))

(set! bb2-comps '(s_ t_))
(sp (make-wff (forall-guarded '(v w s_ t_) (append bb2-C2 '((IN s_ (BOUNDED-OPS v w)) (IN t_ (BOUNDED-OPS v w))))
   '(IN (BOP-SUM v w s_ t_) (BOUNDED-OPS v w)))))
(bb2-bop-pre!)
(let* ((op '(BOP-SUM v w s_ t_))
       (app! (lambda (x) (subst (dk-cite! 'bop-sum-apply 'v 'w 's_ 't_ x)))))
  (bb2-linear! op app! (bb2-fun! 'BOP-SUM))
  (let* ((m1 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 's_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of s"))
         (m2 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_)))
         (l2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m2))) "bound of t"))
         (mm (list '+ m1 m2)))
    (dk-split-all!)
    (dk-cite! 'rr-add-in-rr m1 m2)
    (dk-have! (list '<= 0 mm) (lambda () (dk-ineq! (list 'IN m1 'RR) (list 'IN m2 'RR) (list '<= 0 m1) (list '<= 0 m2))))
    (bb2-bound! op mm
      (lambda (x)
        (let* ((sx (list 's_ x)) (tx (list 't_ x)) (st (list '(VADD w) sx tx)))
          (bb2-wt! st)
          (app! x)
          (dk-cite! 'cips-minkowski 'w sx tx)
          (bb2-nt! 'v x) (bb2-nt! 'w sx) (bb2-nt! 'w tx) (bb2-nt! 'w st)
          (dk-apply! l1 x) (dk-apply! l2 x)
          (let ((nx (list 'IP-NORM 'v x)))
            (dk-have! (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))) (lambda () (crs)))
            (bb2-lin! (list (list 'IN (list 'IP-NORM 'w st) 'RR) (list 'IN (list 'IP-NORM 'w sx) 'RR)
                            (list 'IN (list 'IP-NORM 'w tx) 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR)
                            (list 'IN mm 'RR))
                      (list (list '<= (list 'IP-NORM 'w st) (list '+ (list 'IP-NORM 'w sx) (list 'IP-NORM 'w tx)))
                            (list '<= (list 'IP-NORM 'w sx) (list '* m1 nx))
                            (list '<= (list 'IP-NORM 'w tx) (list '* m2 nx))
                            (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx)))))))))
    (dk-cite! 'bop-intro 'v 'w op mm)
    (ass)))
(bb2-qed! 'bop-sum-bounded)

(set! bb2-comps '(t_))
(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 '((IN t_ (BOUNDED-OPS v w))))
   '(IN (BOP-NEG v w t_) (BOUNDED-OPS v w)))))
(bb2-bop-pre!)
(let* ((op '(BOP-NEG v w t_))
       (app! (lambda (x) (subst (dk-cite! 'bop-neg-apply 'v 'w 't_ x)))))
  (bb2-linear! op app! (bb2-fun! 'BOP-NEG))
  (let* ((m1 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of t")))
    (dk-split-all!)
    (bb2-bound! op m1
      (lambda (x)
        (let* ((tx (list 't_ x)))
          (bb2-wt! tx)
          (app! x)
          (subst (dk-cite! 'ip-norm-vneg 'w tx))
          (dk-apply! l1 x)
          (ass))))
    (dk-cite! 'bop-intro 'v 'w op m1)
    (ass)))
(bb2-qed! 'bop-neg-bounded)

(set! bb2-comps '(t_))
(sp (make-wff (forall-guarded '(v w c_ t_) (append bb2-C2 '((IN c_ CC) (IN t_ (BOUNDED-OPS v w))))
   '(IN (BOP-SCALE v w c_ t_) (BOUNDED-OPS v w)))))
(bb2-bop-pre!)
(let* ((op '(BOP-SCALE v w c_ t_))
       (app! (lambda (x) (subst (dk-cite! 'bop-scale-apply 'v 'w 'c_ 't_ x)))))
  (bb2-linear! op app! (bb2-fun! 'BOP-SCALE))
  (let* ((m1 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of t"))
         (mc '(magnitude c_))
         (mm (list '* mc m1)))
    (dk-split-all!)
    (dk-cite! 'cc-magnitude-closed 'c_) (dk-cite! 'cc-magnitude-nonneg 'c_)
    (dk-cite! 'rr-mul-in-rr mc m1)
    (bb2-have-and! (list 'IN mc 'RR) (list 'IN m1 'RR))
    (bb2-have-and! (list '<= 0 mc) (list '<= 0 m1))
    (dk-cite! 'rr-leq-mul-nonneg mc m1)
    (bb2-bound! op mm
      (lambda (x)
        (let* ((tx (list 't_ x)) (nx (list 'IP-NORM 'v x)) (ntx (list 'IP-NORM 'w tx)))
          (bb2-wt! tx)
          (app! x)
          (subst (dk-cite! 'ip-norm-act 'w 'c_ tx))
          (bb2-nt! 'v x) (bb2-nt! 'w tx)
          (dk-apply! l1 x)
          (dk-cite! 'rr-mul-in-rr m1 nx)
          (dk-cite! 'rr-mul-le-right ntx (list '* m1 nx) mc)
          (dk-have! (list '= (list '* mc ntx) (list '* ntx mc)) (lambda () (crs)))
          (dk-have! (list '= (list '* (list '* m1 nx) mc) (list '* mm nx)) (lambda () (crs)))
          (bb2-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN m1 'RR))
                    (list (list '<= (list '* ntx mc) (list '* (list '* m1 nx) mc))
                          (list '= (list '* mc ntx) (list '* ntx mc))
                          (list '= (list '* (list '* m1 nx) mc) (list '* mm nx)))))))
    (dk-cite! 'bop-intro 'v 'w op mm)
    (ass)))
(bb2-qed! 'bop-scale-bounded)

(set! bb2-comps '())
(sp (make-wff (forall-guarded '(v w) bb2-C2 '(IN (BOP-ZERO v w) (BOUNDED-OPS v w)))))
(bb2-bop-pre!)
(let* ((op '(BOP-ZERO v w))
       (app! (lambda (x) (subst (dk-cite! 'bop-zero-apply 'v 'w x)))))
  (bb2-linear! op app! (bb2-fun! 'BOP-ZERO))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! '(<= 0 0) (lambda () (arith)))
  (bb2-bound! op 0
    (lambda (x)
      (app! x)
      (subst (dk-cite! 'ip-norm-zero 'w))
      (bb2-nt! 'v x)
      (dk-ineq! (list 'IN (list 'IP-NORM 'v x) 'RR))))
  (dk-cite! 'bop-intro 'v 'w op 0)
  (ass))
(bb2-qed! 'bop-zero-bounded)

;;; ---- PART B: the module laws of L(v, w), the norm laws of OPNORM, composition, the adjoint ----
;;; The device: an operator identity is FUNCTION EXTENSIONALITY (dk-fun-ext!) with a pointwise
;;; proof that rewrites every application of a construction at the point by its value law and
;;; closes the resulting vector identity by expansion (bb2-vec-eq!).

(define bb2-dv 'v)                      ; the domain space of the operators of the current proof
(define bb2-cw 'w)                      ; the codomain space
(define (bb2-dvt! e) (fluid-let ((bb2-v bb2-dv)) (bb2-vt! e)))
(define (bb2-cvt! e) (fluid-let ((bb2-v bb2-cw)) (bb2-vt! e)))
(define bb2-cons '(BOP-SUM BOP-NEG BOP-SCALE BOP-ZERO BOP-COMP BOP-ID OP-ADJOINT))
(define (bb2-cons? e) (and (pair? e) (memq (car e) bb2-cons)))
;;; land (IN e (BOUNDED-OPS d c)) and (IN e (FUN (VEC d) (VEC c))) for an operator term
(define (bb2-optype! e)
  (let ((d bb2-dv) (c bb2-cw))
    (cond ((not (pair? e)) #t)
          ((eq? (car e) 'BOP-SUM) (bb2-optype! (cadddr e)) (bb2-optype! (car (cddddr e)))
           (dk-cite! 'bop-sum-bounded d c (cadddr e) (car (cddddr e))))
          ((eq? (car e) 'BOP-NEG) (bb2-optype! (cadddr e)) (dk-cite! 'bop-neg-bounded d c (cadddr e)))
          ((eq? (car e) 'BOP-SCALE) (bb2-ct! (cadddr e)) (bb2-optype! (car (cddddr e)))
           (dk-cite! 'bop-scale-bounded d c (cadddr e) (car (cddddr e))))
          ((eq? (car e) 'BOP-ZERO) (dk-cite! 'bop-zero-bounded d c))
          ((eq? (car e) 'BOP-COMP) (bb2-optype! (caddr e)) (bb2-optype! (cadddr e))
           (dk-cite! 'bop-comp-bounded d (caddr e) (cadddr e)))
          ((eq? (car e) 'BOP-ID) (dk-cite! 'bop-id-bounded d))
          (#t #t))
    (if (not (dk-asm? (list 'IN e (list 'FUN (list 'VEC d) (list 'VEC c)))))
        (dk-cite! 'bop-fun d c e))))
;;; the first application in E that a value law opens
(define bb2-atoms '())                  ; the atomic operators of the proof
(define (bb2-app-redex e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 2) (bb2-cons? (car e)) (not (eq? (car (car e)) 'OP-ADJOINT))) e)
        ((and (= (length e) 2) (memq (car e) bb2-atoms) (pair? (cadr e)) (pair? (car (cadr e)))
              (memq (car (car (cadr e))) '(VADD ACT VNEG)) (equal? (cadr (car (cadr e))) bb2-dv))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bb2-app-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (bb2-open-app! r)
  (let* ((f (car r)) (x (cadr r)) (d bb2-dv) (c bb2-cw))
    (cond ((memq f bb2-atoms)
           (let ((op (car (car x))))
             (cond ((eq? op 'VADD) (bb2-dvt! (cadr x)) (bb2-dvt! (caddr x))
                    (dk-cite! 'bop-add d c f (cadr x) (caddr x)))
                   ((eq? op 'ACT) (bb2-ct! (cadr x)) (bb2-dvt! (caddr x))
                    (dk-cite! 'bop-act d c f (cadr x) (caddr x)))
                   (#t (bb2-dvt! (cadr x)) (dk-cite! 'bop-vneg d c f (cadr x))))))
          (#t
           (bb2-dvt! x)
           (case (car f)
             ((BOP-SUM) (dk-cite! 'bop-sum-apply d c (cadddr f) (car (cddddr f)) x))
             ((BOP-NEG) (dk-cite! 'bop-neg-apply d c (cadddr f) x))
             ((BOP-SCALE) (dk-cite! 'bop-scale-apply d c (cadddr f) (car (cddddr f)) x))
             ((BOP-ZERO) (dk-cite! 'bop-zero-apply d c x))
             ((BOP-COMP) (dk-cite! 'bop-comp-apply d (caddr f) (cadddr f) x))
             ((BOP-ID) (dk-cite! 'bop-id-apply d x)))))))
(define (bb2-unapp!)
  (let loop ((fuel 60))
    (if (<= fuel 0) (error "bb2-unapp!: out of fuel"))
    (let ((r (bb2-app-redex (dk-goal))))
      (if r (begin (subst (bb2-open-app! r)) (loop (- fuel 1)))))))
;;; the operator identity LHS = RHS by extensionality
(define (bb2-ext! lhs rhs)
  (bb2-optype! lhs) (bb2-optype! rhs)
  (for-each (lambda (t) (dk-cite! 'bop-fun bb2-dv bb2-cw t)) bb2-atoms)
  (dk-fun-ext! lhs rhs (list 'VEC bb2-dv) (list 'VEC bb2-cw) #f #f
    (lambda (x)
      (bb2-unapp!)
      (let ((g (dk-goal)))
        (if (equal? (cadr g) (caddr g)) (rfl)
            (begin (fluid-let ((bb2-v bb2-cw)) (bb2-vec-eq! (cadr g) (caddr g)))
                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))
;;; a law: (bb2-law! NAME VARS HYPS LHS RHS)
(define (bb2-op-law! name vars hyps lhs rhs atoms)
  (sp (make-wff (forall-guarded vars hyps (list '= lhs rhs))))
  (dk-peel!)
  (set! bb2-atoms atoms)
  (bb2-ext! lhs rhs)
  (bb2-qed! name))

(define bb2-BO '(BOUNDED-OPS v w))
(define (bb2-in-bo . ts) (map (lambda (t) (list 'IN t bb2-BO)) ts))
(set! bb2-dv 'v) (set! bb2-cw 'w)
(define (bb2-s a b) (list 'BOP-SUM 'v 'w a b))
(define (bb2-sc c a) (list 'BOP-SCALE 'v 'w c a))
(define bb2-z '(BOP-ZERO v w))

;;; the abelian group
(bb2-op-law! 'bop-sum-assoc '(v w r_ s_ t_) (append bb2-C2 (bb2-in-bo 'r_ 's_ 't_))
  (bb2-s (bb2-s 'r_ 's_) 't_) (bb2-s 'r_ (bb2-s 's_ 't_)) '(r_ s_ t_))
(bb2-op-law! 'bop-sum-comm '(v w s_ t_) (append bb2-C2 (bb2-in-bo 's_ 't_))
  (bb2-s 's_ 't_) (bb2-s 't_ 's_) '(s_ t_))
(bb2-op-law! 'bop-sum-zero-left '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
  (bb2-s bb2-z 't_) 't_ '(t_))
(bb2-op-law! 'bop-sum-zero-right '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
  (bb2-s 't_ bb2-z) 't_ '(t_))
(bb2-op-law! 'bop-sum-neg-left '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
  (bb2-s '(BOP-NEG v w t_) 't_) bb2-z '(t_))
(bb2-op-law! 'bop-sum-neg-right '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
  (bb2-s 't_ '(BOP-NEG v w t_)) bb2-z '(t_))
;;; the action
(bb2-op-law! 'bop-scale-sum '(v w c_ s_ t_) (append bb2-C2 '((IN c_ CC)) (bb2-in-bo 's_ 't_))
  (bb2-sc 'c_ (bb2-s 's_ 't_)) (bb2-s (bb2-sc 'c_ 's_) (bb2-sc 'c_ 't_)) '(s_ t_))
(bb2-op-law! 'bop-scale-add '(v w c_ d_ t_) (append bb2-C2 '((IN c_ CC) (IN d_ CC)) (bb2-in-bo 't_))
  (bb2-sc '(+ c_ d_) 't_) (bb2-s (bb2-sc 'c_ 't_) (bb2-sc 'd_ 't_)) '(t_))
(bb2-op-law! 'bop-scale-mul '(v w c_ d_ t_) (append bb2-C2 '((IN c_ CC) (IN d_ CC)) (bb2-in-bo 't_))
  (bb2-sc '(* c_ d_) 't_) (bb2-sc 'c_ (bb2-sc 'd_ 't_)) '(t_))
(bb2-op-law! 'bop-scale-one '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
  (bb2-sc 1 't_) 't_ '(t_))

;;; composition (operators on v)
(set! bb2-dv 'v) (set! bb2-cw 'v)
(define bb2-C1 '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define (bb2-in-bv . ts) (map (lambda (t) (list 'IN t '(BOUNDED-OPS v v))) ts))
(define (bb2-c a b) (list 'BOP-COMP 'v a b))
(define (bb2-sv a b) (list 'BOP-SUM 'v 'v a b))
(define (bb2-scv c a) (list 'BOP-SCALE 'v 'v c a))
(bb2-op-law! 'bop-comp-assoc '(v r_ s_ t_) (append bb2-C1 (bb2-in-bv 'r_ 's_ 't_))
  (bb2-c (bb2-c 'r_ 's_) 't_) (bb2-c 'r_ (bb2-c 's_ 't_)) '(r_ s_ t_))
(bb2-op-law! 'bop-comp-sum-left '(v r_ s_ t_) (append bb2-C1 (bb2-in-bv 'r_ 's_ 't_))
  (bb2-c (bb2-sv 'r_ 's_) 't_) (bb2-sv (bb2-c 'r_ 't_) (bb2-c 's_ 't_)) '(r_ s_ t_))
(bb2-op-law! 'bop-comp-sum-right '(v r_ s_ t_) (append bb2-C1 (bb2-in-bv 'r_ 's_ 't_))
  (bb2-c 'r_ (bb2-sv 's_ 't_)) (bb2-sv (bb2-c 'r_ 's_) (bb2-c 'r_ 't_)) '(r_ s_ t_))
(bb2-op-law! 'bop-comp-scale-left '(v c_ s_ t_) (append bb2-C1 '((IN c_ CC)) (bb2-in-bv 's_ 't_))
  (bb2-c (bb2-scv 'c_ 's_) 't_) (bb2-scv 'c_ (bb2-c 's_ 't_)) '(s_ t_))
(bb2-op-law! 'bop-comp-scale-right '(v c_ s_ t_) (append bb2-C1 '((IN c_ CC)) (bb2-in-bv 's_ 't_))
  (bb2-c 's_ (bb2-scv 'c_ 't_)) (bb2-scv 'c_ (bb2-c 's_ 't_)) '(s_ t_))
(bb2-op-law! 'bop-comp-id-left '(v t_) (append bb2-C1 (bb2-in-bv 't_))
  (bb2-c '(BOP-ID v) 't_) 't_ '(t_))
(bb2-op-law! 'bop-comp-id-right '(v t_) (append bb2-C1 (bb2-in-bv 't_))
  (bb2-c 't_ '(BOP-ID v)) 't_ '(t_))

;;; ---- PART C: the norm laws of OPNORM; ||I|| = 1 on a nontrivial space; the adjoint is additive
;;; and conjugate linear ----------------------------------------------------------------------------
(set! bb2-dv 'v) (set! bb2-cw 'w)
(define (bb2-opn t) (list 'OPNORM 'v 'w t))
(define (bb2-opn-facts! t)
  (dk-cite! 'opnorm-in-rr 'v 'w t) (dk-cite! 'opnorm-nonneg 'v 'w t) (dk-cite! 'opnorm-bound 'v 'w t))
(define (bb2-bound-of t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (bb2-opn t))
                            (not (eq? (cadr h) 'd_))))
           "the bound clause"))
(define (bb2-spec! t) (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'w t))))
(define (bb2-antisym! a b)              ; a = b from a <= b, b <= a and the typings in context
  (for-each (lambda (z) (if (and (number? z) (not (dk-asm? (list 'IN z 'RR))))
                            (dk-have! (list 'IN z 'RR) (lambda () (arith)))))
            (list a b))
  (bb2-have-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (bb2-have-and! (list '<= a b) (list '<= b a))
  (dk-cite! 'rr-leq-antisymmetric a b))
(define (bb2-recip-pos! nx)             ; nx in RR, 0 <= nx, nx /= 0 in context
  (dk-cite! 'neq-sym nx 0)
  (dk-have! (list '< 0 nx) (lambda () (mac '<) (from-context!)))
  (bb2-have-and! (list 'IN nx 'RR) (list 'NOT (list '= nx 0)))
  (dk-cite! 'rr-recip-closed nx)
  (dk-cite! 'rr-recip-pos nx)
  (dk-cite! 'rr-recip-inverse nx)
  (dk-have! (list '<= 0 (list 'recip nx))
            (lambda () (mac-h '< (list '< 0 (list 'recip nx))) (dk-split-all!) (ass))))

;;; ||0|| = 0
(sp (make-wff (forall-guarded '(v w) bb2-C2 '(= (OPNORM v w (BOP-ZERO v w)) 0))))
(dk-peel!)
(set! bb2-v 'w)
(let ((z '(BOP-ZERO v w)))
  (dk-cite! 'bop-zero-bounded 'v 'w)
  (bb2-spec! z)
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! '(<= 0 0) (lambda () (arith)))
  (dk-have! (bb2-ub 'v 'w z 0)
    (lambda ()
      (dk-peel!)
      (let ((x (caddr (caddr (caddr (dk-goal))))))
        (subst (dk-cite! 'bop-zero-apply 'v 'w x))
        (subst (dk-cite! 'ip-norm-zero 'w))
        (bb2-nt! 'v x)
        (dk-ineq! (list 'IN (list 'IP-NORM 'v x) 'RR)))))
  (dk-apply! (bb2-least z) 0)
  (bb2-antisym! (bb2-opn z) 0)
  (ass))
(bb2-qed! 'opnorm-zero)

;;; ||T|| = 0 => T = 0
(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 '((IN t_ (BOUNDED-OPS v w)) (= (OPNORM v w t_) 0)))
   '(= t_ (BOP-ZERO v w)))))
(dk-peel!)
(set! bb2-v 'w)
(set! bb2-atoms '(t_))
(bb2-optype! 't_) (bb2-optype! '(BOP-ZERO v w))
(bb2-opn-facts! 't_)
(let ((lb (bb2-bound-of 't_)))
  (dk-fun-ext! 't_ '(BOP-ZERO v w) '(VEC v) '(VEC w) #f #f
    (lambda (x)
      (bb2-unapp!)
      (let* ((tx (list 't_ x)) (ntx (list 'IP-NORM 'w tx)) (nx (list 'IP-NORM 'v x))
             (h (dk-apply! lb x))
             (h2 (dk-rewrite-h! h (bb2-opn 't_) 0)))
        (bb2-wt! tx)
        (bb2-nt! 'v x) (bb2-nt! 'w tx)
        (dk-have! (list '= ntx 0)
          (lambda () (dk-have! (list '<= ntx 0) (lambda () (dk-ineq! h2 (list 'IN nx 'RR) (list 'IN ntx 'RR))))
                     (bb2-antisym! ntx 0) (ass)))
        (dk-cite! 'ip-norm-zero-vector 'w tx)
        (ass)))))
(bb2-qed! 'opnorm-zero-imp)

(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 '((IN t_ (BOUNDED-OPS v w))))
   '(IFF (= (OPNORM v w t_) 0) (= t_ (BOP-ZERO v w))))))
(dk-peel!)
(dk-iff! (lambda (g) (equal? g '(= t_ (BOP-ZERO v w))))
  (lambda () (dk-cite! 'opnorm-zero-imp 'v 'w 't_) (ass))
  (lambda () (subst '(= t_ (BOP-ZERO v w))) (dk-cite! 'opnorm-zero 'v 'w) (ass)))
(bb2-qed! 'opnorm-definite)

;;; ||S + T|| <= ||S|| + ||T||
(sp (make-wff (forall-guarded '(v w s_ t_) (append bb2-C2 '((IN s_ (BOUNDED-OPS v w)) (IN t_ (BOUNDED-OPS v w))))
   '(<= (OPNORM v w (BOP-SUM v w s_ t_)) (+ (OPNORM v w s_) (OPNORM v w t_))))))
(dk-peel!)
(set! bb2-v 'w)
(let* ((op '(BOP-SUM v w s_ t_)) (m1 (bb2-opn 's_)) (m2 (bb2-opn 't_)) (mm (list '+ m1 m2)))
  (bb2-optype! op)
  (bb2-opn-facts! 's_) (bb2-opn-facts! 't_)
  (let ((l1 (bb2-bound-of 's_)) (l2 (bb2-bound-of 't_)))
    (dk-cite! 'rr-add-in-rr m1 m2)
    (dk-have! (list '<= 0 mm) (lambda () (dk-ineq! (list 'IN m1 'RR) (list 'IN m2 'RR) (list '<= 0 m1) (list '<= 0 m2))))
    (dk-have! (bb2-ub 'v 'w op mm)
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal)))))
               (sx (list 's_ x)) (tx (list 't_ x)) (st (list '(VADD w) sx tx)) (nx (list 'IP-NORM 'v x)))
          (bb2-wt! st)
          (subst (dk-cite! 'bop-sum-apply 'v 'w 's_ 't_ x))
          (dk-cite! 'cips-minkowski 'w sx tx)
          (bb2-nt! 'v x) (bb2-nt! 'w sx) (bb2-nt! 'w tx) (bb2-nt! 'w st)
          (dk-apply! l1 x) (dk-apply! l2 x)
          (dk-have! (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))) (lambda () (crs)))
          (bb2-lin! (list (list 'IN (list 'IP-NORM 'w st) 'RR) (list 'IN (list 'IP-NORM 'w sx) 'RR)
                          (list 'IN (list 'IP-NORM 'w tx) 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR)
                          (list 'IN mm 'RR))
                    (list (list '<= (list 'IP-NORM 'w st) (list '+ (list 'IP-NORM 'w sx) (list 'IP-NORM 'w tx)))
                          (list '<= (list 'IP-NORM 'w sx) (list '* m1 nx))
                          (list '<= (list 'IP-NORM 'w tx) (list '* m2 nx))
                          (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))))))))
    (bb2-spec! op)
    (dk-apply! (bb2-least op) mm)
    (ass)))
(bb2-qed! 'opnorm-triangle)

;;; ||-T|| = ||T||
(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 '((IN t_ (BOUNDED-OPS v w))))
   '(= (OPNORM v w (BOP-NEG v w t_)) (OPNORM v w t_)))))
(dk-peel!)
(set! bb2-v 'w)
(let* ((op '(BOP-NEG v w t_)) (n (bb2-opn 't_)) (n2 (bb2-opn op)))
  (bb2-optype! op)
  (bb2-opn-facts! 't_) (bb2-opn-facts! op)
  (let ((l1 (bb2-bound-of 't_)) (l2 (bb2-bound-of op)))
    (dk-have! (bb2-ub 'v 'w op n)
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal))))) (tx (list 't_ x)))
          (bb2-wt! tx)
          (subst (dk-cite! 'bop-neg-apply 'v 'w 't_ x))
          (subst (dk-cite! 'ip-norm-vneg 'w tx))
          (dk-apply! l1 x)
          (ass))))
    (dk-have! (bb2-ub 'v 'w 't_ n2)
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal))))) (tx (list 't_ x)) (ntx (list '(VNEG w) tx)))
          (bb2-wt! tx)
          (dk-cite! 'bop-neg-apply 'v 'w 't_ x)
          (bb2-wt! ntx)
          (dk-cite! 'ip-norm-vneg 'w tx)
          (let* ((h (dk-apply! l2 x))
                 (h2 (dk-rewrite-h! h (list op x) ntx))
                 (h3 (dk-rewrite-h! h2 (list 'IP-NORM 'w ntx) (list 'IP-NORM 'w tx))))
            (ass)))))
    (bb2-spec! op)
    (dk-apply! (bb2-least op) n)
    (bb2-spec! 't_)
    (dk-apply! (bb2-least 't_) n2)
    (bb2-antisym! n2 n)
    (ass)))
(bb2-qed! 'opnorm-neg)

;;; ||c T|| = |c| ||T||
(sp (make-wff (forall-guarded '(v w c_ t_) (append bb2-C2 '((IN c_ CC) (IN t_ (BOUNDED-OPS v w))))
   '(= (OPNORM v w (BOP-SCALE v w c_ t_)) (* (magnitude c_) (OPNORM v w t_))))))
(dk-peel!)
(set! bb2-v 'w)
(let* ((op '(BOP-SCALE v w c_ t_)) (n (bb2-opn 't_)) (p (bb2-opn op)) (mc '(magnitude c_)) (mn (list '* mc n)))
  (bb2-optype! op)
  (bb2-opn-facts! 't_) (bb2-opn-facts! op)
  (dk-cite! 'cc-magnitude-closed 'c_) (dk-cite! 'cc-magnitude-nonneg 'c_)
  (dk-cite! 'rr-mul-in-rr mc n)
  (bb2-have-and! (list 'IN mc 'RR) (list 'IN n 'RR))
  (bb2-have-and! (list '<= 0 mc) (list '<= 0 n))
  (dk-cite! 'rr-leq-mul-nonneg mc n)
  (let ((l1 (bb2-bound-of 't_)) (l2 (bb2-bound-of op)))
    ;; (<=) |c| ||T|| bounds c T
    (dk-have! (bb2-ub 'v 'w op mn)
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal))))) (tx (list 't_ x))
               (nx (list 'IP-NORM 'v x)) (ntx (list 'IP-NORM 'w tx)))
          (bb2-wt! tx)
          (subst (dk-cite! 'bop-scale-apply 'v 'w 'c_ 't_ x))
          (subst (dk-cite! 'ip-norm-act 'w 'c_ tx))
          (bb2-nt! 'v x) (bb2-nt! 'w tx)
          (dk-apply! l1 x)
          (dk-cite! 'rr-mul-in-rr n nx)
          (dk-cite! 'rr-mul-le-right ntx (list '* n nx) mc)
          (dk-have! (list '= (list '* mc ntx) (list '* ntx mc)) (lambda () (crs)))
          (dk-have! (list '= (list '* (list '* n nx) mc) (list '* mn nx)) (lambda () (crs)))
          (bb2-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN n 'RR))
                    (list (list '<= (list '* ntx mc) (list '* (list '* n nx) mc))
                          (list '= (list '* mc ntx) (list '* ntx mc))
                          (list '= (list '* (list '* n nx) mc) (list '* mn nx)))))))
    (bb2-spec! op)
    (dk-apply! (bb2-least op) mn)
    ;; (>=)
    (use-em '(= c_ 0)
      (lambda ()
        (dk-have! (list '= mc 0) (lambda () (subst '(= c_ 0)) (dk-cite! 'cc-magnitude-zero) (ass)))
        (dk-have! (list '= mn 0) (lambda () (subst (list '= mc 0)) (crs)))
        (dk-have! (list '<= mn p) (lambda () (dk-ineq! (list '= mn 0) (list '<= 0 p) (list 'IN p 'RR) (list 'IN mn 'RR))))
        (bb2-antisym! p mn) (ass))
      (lambda ()
        (dk-cite! 'cc-magnitude-zero-iff 'c_)
        (dk-have! (list 'NOT (list '= mc 0))
          (lambda () (dk-only! (iff-for (list '= mc 0)) '(NOT (= c_ 0))) (prop)))
        (bb2-recip-pos! mc)
        (let ((q (list 'recip mc)) (pq (list '* p (list 'recip mc))))
          (dk-cite! 'rr-mul-in-rr p q)
          (bb2-have-and! (list 'IN p 'RR) (list 'IN q 'RR))
          (bb2-have-and! (list '<= 0 p) (list '<= 0 q))
          (dk-cite! 'rr-leq-mul-nonneg p q)
          (dk-have! (bb2-ub 'v 'w 't_ pq)
            (lambda ()
              (dk-peel!)
              (let* ((x (caddr (caddr (caddr (dk-goal))))) (tx (list 't_ x))
                     (nx (list 'IP-NORM 'v x)) (ntx (list 'IP-NORM 'w tx)) (mt (list '* mc ntx)))
                (bb2-wt! tx)
                (bb2-nt! 'v x) (bb2-nt! 'w tx)
                (dk-cite! 'bop-scale-apply 'v 'w 'c_ 't_ x)
                (bb2-wt! (list '(ACT w) 'c_ tx))
                (dk-cite! 'ip-norm-act 'w 'c_ tx)
                (let* ((h (dk-apply! l2 x))
                       (h2 (dk-rewrite-h! h (list op x) (list '(ACT w) 'c_ tx)))
                       (h3 (dk-rewrite-h! h2 (list 'IP-NORM 'w (list '(ACT w) 'c_ tx)) mt)))
                  (dk-cite! 'rr-mul-in-rr mc ntx)
                  (dk-cite! 'rr-mul-in-rr p nx)
                  (dk-cite! 'rr-mul-le-right mt (list '* p nx) q)
                  (let ((e1 (list '= (list '* mt q) (list '* (list '* mc q) ntx)))
                        (e2 (list '= (list '* mt q) ntx))
                        (e3 (list '= (list '* (list '* p nx) q) (list '* pq nx))))
                    (dk-have! e1 (lambda () (crs)))
                    (dk-have! e2 (lambda () (subst e1) (subst (list '= (list '* mc q) 1)) (crs)))
                    (dk-have! e3 (lambda () (crs)))
                    (bb2-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN p 'RR)
                                    (list 'IN q 'RR))
                              (list (list '<= (list '* mt q) (list '* (list '* p nx) q)) e2 e3)))))))
          (bb2-spec! 't_)
          (dk-apply! (bb2-least 't_) pq)
          (dk-cite! 'rr-mul-le-right n pq mc)
          (let ((e4 (list '= (list '* pq mc) p)) (e5 (list '= mn (list '* n mc))))
            (dk-have! e4 (lambda () (dk-have! (list '= (list '* pq mc) (list '* p (list '* mc q))) (lambda () (crs)))
                                    (subst (list '= (list '* pq mc) (list '* p (list '* mc q))))
                                    (subst (list '= (list '* mc q) 1)) (crs)))
            (dk-have! e5 (lambda () (crs)))
            (dk-have! (list '<= mn p)
              (lambda () (bb2-lin! (list (list 'IN n 'RR) (list 'IN mc 'RR) (list 'IN p 'RR) (list 'IN pq 'RR))
                                   (list (list '<= (list '* n mc) (list '* pq mc)) e4 e5))))
            (bb2-antisym! p mn) (ass)))))))
(bb2-qed! 'opnorm-scale)

;;; ||I|| = 1 on a nontrivial space
(define bb2-nontriv '(FORSOME bnx_ (AND (IN bnx_ (VEC v)) (NOT (= bnx_ (VZERO v))))))
(sp (make-wff (forall-guarded '(v) (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) bb2-nontriv)
   '(= (OPNORM v v (BOP-ID v)) 1))))
(dk-peel!)
(set! bb2-v 'v)
(let* ((id '(BOP-ID v)) (n (list 'OPNORM 'v 'v id)))
  (dk-cite! 'bop-id-bounded 'v)
  (dk-cite! 'opnorm-in-rr 'v 'v id) (dk-cite! 'opnorm-nonneg 'v 'v id)
  (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'v id)))
  (dk-have! '(IN 1 RR) (lambda () (arith)))
  (dk-have! '(<= 0 1) (lambda () (arith)))
  (dk-have! (bb2-ub 'v 'v id 1)
    (lambda ()
      (dk-peel!)
      (let ((x (caddr (caddr (caddr (dk-goal))))))
        (subst (dk-cite! 'bop-id-apply 'v x))
        (bb2-nt! 'v x)
        (dk-ineq! (list 'IN (list 'IP-NORM 'v x) 'RR)))))
  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_))) "least") 1)
  (let* ((x0 (dk-skolem! (dk-ctx-form bb2-nontriv)))
         (_s (dk-split-all!))
         (nx (list 'IP-NORM 'v x0)))
    (bb2-nt! 'v x0)
    (dk-have! (list 'NOT (list '= nx 0))
      (lambda () (di) (dk-cite! 'ip-norm-zero-vector 'v x0) (ai (list 'NOT (list '= x0 '(VZERO v))))))
    (bb2-recip-pos! nx)
    (dk-cite! 'bop-id-apply 'v x0)
    (let* ((q (list 'recip nx))
           (h (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (not (eq? (cadr h) 'd_))
                                                   (dk-contains? h n)))
                                  "bound") x0))
           (h2 (dk-rewrite-h! h (list id x0) x0)))
      (dk-cite! 'rr-mul-in-rr n nx)
      (dk-cite! 'rr-mul-le-right nx (list '* n nx) q)
      (let ((e1 (list '= (list '* (list '* n nx) q) n)))
        (dk-have! e1 (lambda () (dk-have! (list '= (list '* (list '* n nx) q) (list '* n (list '* nx q))) (lambda () (crs)))
                                (subst (list '= (list '* (list '* n nx) q) (list '* n (list '* nx q))))
                                (subst (list '= (list '* nx q) 1)) (crs)))
        (dk-have! (list '<= 1 n)
          (lambda () (bb2-lin! (list (list 'IN n 'RR) (list 'IN nx 'RR) (list 'IN q 'RR))
                               (list (list '<= (list '* nx q) (list '* (list '* n nx) q)) e1
                                     (list '= (list '* nx q) 1)))))
        (bb2-antisym! n 1)
        (ass)))))
(bb2-qed! 'opnorm-id)

;;; ---- the adjoint is additive and conjugate linear ----------------------------------------------
(define bb2-HJ '((IS-HILBERT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w)))
(define (bb2-adj t) (list 'OP-ADJOINT 'v 'w t))
(define (bb2-adj-rel t g)
  (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC v)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC w))
     (list '= (list '(IP w) (list t 'bax_) 'bay_) (list '(IP v) 'bax_ (list g 'bay_))))))))
;;; ADJ = G by op-adjoint-unique; PT! rewrites the two applications at the point (x, y)
(define (bb2-adj-by! t g pt!)
  (dk-cite! 'bop-fun 'w 'v g)
  (dk-have! (bb2-adj-rel t g)
    (lambda ()
      (dk-peel!)
      (let* ((gl (dk-goal)) (x (cadr (cadr (cadr gl)))) (y (caddr (cadr gl))))
        (pt! x y)
        (fluid-let ((bb2-v 'w)) (bb2-expand!))
        (fluid-let ((bb2-v 'v)) (bb2-expand!))
        (for-each (lambda (s)
                    (let ((sx (list s x)))
                      (if (dk-contains? (dk-goal) (list '(IP w) sx y))
                          (subst (dk-cite! 'op-adjoint-ip 'v 'w s x y)))))
                  bb2-atoms)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin (fluid-let ((bb2-v 'v)) (bb2-type-ips! (dk-goal)))
                   (fluid-let ((bb2-v 'w)) (bb2-type-ips! (dk-goal)))
                   (crs))))))
  (dk-cite! 'op-adjoint-unique 'v 'w t g)
  (ass))
(define (bb2-adj-pre!)
  (dk-peel!)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (for-each (lambda (s) (dk-cite! 'bop-fun 'v 'w s) (dk-cite! 'op-adjoint-bounded 'v 'w s)
                        (dk-cite! 'bop-fun 'w 'v (bb2-adj s)))
            bb2-atoms))

(set! bb2-atoms '(s_ t_))
(sp (make-wff (forall-guarded '(v w s_ t_) (append bb2-HJ '((IN s_ (BOUNDED-OPS v w)) (IN t_ (BOUNDED-OPS v w))))
   (list '= (bb2-adj '(BOP-SUM v w s_ t_)) (list 'BOP-SUM 'w 'v (bb2-adj 's_) (bb2-adj 't_))))))
(bb2-adj-pre!)
(let ((op '(BOP-SUM v w s_ t_)) (g (list 'BOP-SUM 'w 'v (bb2-adj 's_) (bb2-adj 't_))))
  (dk-cite! 'bop-sum-bounded 'v 'w 's_ 't_)
  (dk-cite! 'bop-sum-bounded 'w 'v (bb2-adj 's_) (bb2-adj 't_))
  (bb2-adj-by! op g
    (lambda (x y)
      (bb2-dvt! x) (bb2-cvt! y)
      (subst (dk-cite! 'bop-sum-apply 'v 'w 's_ 't_ x))
      (fluid-let ((bb2-v 'v)) (bb2-vt! (list (bb2-adj 's_) y)) (bb2-vt! (list (bb2-adj 't_) y)))
      (subst (dk-cite! 'bop-sum-apply 'w 'v (bb2-adj 's_) (bb2-adj 't_) y)))))
(bb2-qed! 'op-adjoint-sum)

(set! bb2-atoms '(t_))
(sp (make-wff (forall-guarded '(v w c_ t_) (append bb2-HJ '((IN c_ CC) (IN t_ (BOUNDED-OPS v w))))
   (list '= (bb2-adj '(BOP-SCALE v w c_ t_)) (list 'BOP-SCALE 'w 'v '(conjugate c_) (bb2-adj 't_))))))
(bb2-adj-pre!)
(let ((op '(BOP-SCALE v w c_ t_)) (g (list 'BOP-SCALE 'w 'v '(conjugate c_) (bb2-adj 't_))))
  (bb2-ct! '(conjugate c_))
  (dk-cite! 'bop-scale-bounded 'v 'w 'c_ 't_)
  (dk-cite! 'bop-scale-bounded 'w 'v '(conjugate c_) (bb2-adj 't_))
  (bb2-adj-by! op g
    (lambda (x y)
      (bb2-dvt! x) (bb2-cvt! y)
      (subst (dk-cite! 'bop-scale-apply 'v 'w 'c_ 't_ x))
      (fluid-let ((bb2-v 'v)) (bb2-vt! (list (bb2-adj 't_) y)))
      (subst (dk-cite! 'bop-scale-apply 'w 'v '(conjugate c_) (bb2-adj 't_) y)))))
(bb2-qed! 'op-adjoint-scale)

;;; ---- PART D: L(v, w) is a normed abelian group (BOP-NORMED-AG) ------------------------------
(set! bb2-dv 'v) (set! bb2-cw 'w)
(define bb2-G '(BOP-NORMED-AG v w))

;;; L(v, w) is a set
(sp (make-wff (forall-guarded '(v w) bb2-C2 '(IN (BOUNDED-OPS v w) SET))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v) (dk-cite! 'cips-vec-set 'w)
(let ((fs '(FUN (VEC v) (VEC w))))
  (dk-have! (list 'IN fs 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'SUBSET '(BOUNDED-OPS v w) fs)
    (lambda () (mac 'subset-def) (dk-peel!)
      (let ((u (cadr (dk-goal))))
        (dk-cite! 'bop-fun 'v 'w u) (ass))))
  (dk-cite! 'subclass-of-set-is-set '(BOUNDED-OPS v w) fs)
  (ass))
(bb2-qed! 'bounded-ops-is-set)

;;; the read-offs of BOP-NORMED-AG
(define (bb2-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v w) bb2-C2 (list '== (list acc bb2-G) val))))
  (dk-peel!)
  ;; the literal list is certified defined once its components are typed (a list is defined iff
  ;; its components are sets)
  (dk-cite! 'bounded-ops-is-set 'v 'w) (dk-cite! 'bop-zero-bounded 'v 'w)
  (slot acc)
  (mac 'BOP-NORMED-AG)
  (nth-r)
  (if (not (proof-done? *ps*)) (qrfl))
  (bb2-qed! name))
(define bb2-nag-vals
  '((CARR (BOUNDED-OPS v w) bop-nag-carr) (OPR (BOP-VADD v w) bop-nag-opr) (IDEN (BOP-ZERO v w) bop-nag-iden)
    (INV (BOP-VINV v w) bop-nag-inv) (NRM (BOP-VNRM v w) bop-nag-nrm)))
(for-each (lambda (p) (bb2-read-off! (caddr p) (car p) (cadr p))) bb2-nag-vals)
(define (bb2-nag-readoffs!)
  (for-each (lambda (p)
              (if (dk-contains? (dk-goal) (list (car p) bb2-G))
                  (subst (dk-cite! (caddr p) 'v 'w))))
            bb2-nag-vals))

;;; the values of its operations
(sp (make-wff (forall-guarded '(v w s_ t_) (append bb2-C2 (bb2-in-bo 's_ 't_))
   '(= ((BOP-VADD v w) s_ t_) (BOP-SUM v w s_ t_)))))
(dk-peel!)
(dk-cite! 'bop-sum-bounded 'v 'w 's_ 't_)
(mac 'BOP-VADD) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-vadd-value)
(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
   '(= ((BOP-VINV v w) t_) (BOP-NEG v w t_)))))
(dk-peel!)
(dk-cite! 'bop-neg-bounded 'v 'w 't_)
(mac 'BOP-VINV) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-vinv-value)
(sp (make-wff (forall-guarded '(v w t_) (append bb2-C2 (bb2-in-bo 't_))
   '(= ((BOP-VNRM v w) t_) (OPNORM v w t_)))))
(dk-peel!)
(dk-cite! 'opnorm-in-rr 'v 'w 't_)
(mac 'BOP-VNRM) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-vnrm-value)

;;; rewrite every applied BOP-VADD / BOP-VINV / BOP-VNRM in the goal by its value (innermost
;;; first: an argument is typed before the application around it is rewritten)
(define (bb2-val-redex e)
  (cond ((not (pair? e)) #f)
        ((let loop ((l e)) (cond ((not (pair? l)) #f)
                                 ((bb2-val-redex (car l)) => (lambda (x) x))
                                 (#t (loop (cdr l)))))
         => (lambda (x) x))
        ((and (pair? (car e)) (memq (car (car e)) '(BOP-VADD BOP-VINV BOP-VNRM))) e)
        (#t #f)))
(define (bb2-vals!)
  (let loop ((fuel 40))
    (let ((r (bb2-val-redex (dk-goal))))
      (if (and r (> fuel 0))
          (let ((h (car (car r))) (d (cadr (car r))) (c (caddr (car r))))
            (for-each (lambda (a) (fluid-let ((bb2-dv d) (bb2-cw c)) (bb2-optype! a))) (cdr r))
            (subst (case h
                     ((BOP-VADD) (dk-cite! 'bop-vadd-value d c (cadr r) (caddr r)))
                     ((BOP-VINV) (dk-cite! 'bop-vinv-value d c (cadr r)))
                     ((BOP-VNRM) (dk-cite! 'bop-vnrm-value d c (cadr r)))))
            (loop (- fuel 1)))))))

;;; THE NORMED GROUP
(sp (make-wff (forall-guarded '(v w) bb2-C2 (list '= (list 'LENGTH bb2-G) 5))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'w) (dk-cite! 'bop-zero-bounded 'v 'w)
(mac 'BOP-NORMED-AG) (len-r)
(if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-nag-length)

(sp (make-wff (forall-guarded '(v w) bb2-C2 (list 'IS-NORMED-AG bb2-G))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'w)
(dk-cite! 'bop-zero-bounded 'v 'w)
(dk-cite! 'bop-nag-length 'v 'w)
(mac 'IS-NORMED-AG)
(dk-isx-set!)
(bb2-nag-readoffs!)
;;; one conjunct of IS-GROUP-NORM on the bounded operators
(define (bb2-gn-close!)
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (bb2-vals!)
  (let* ((g3 (dk-goal)) (u4 (lambda (t) (cadddr t))))
    (cond
      ((dk-asm? g3) (ass))
      ((dk-head-is? g3 'IFF) (dk-cite! 'opnorm-definite 'v 'w (u4 (cadr (cadr g3)))) (ass))
      ((and (dk-head-is? g3 '<=) (dk-head-is? (caddr g3) '+))
       (let ((sm (u4 (cadr g3))))
         (dk-cite! 'opnorm-triangle 'v 'w (cadddr sm) (car (cddddr sm))) (ass)))
      ((dk-head-is? g3 '<=) (dk-cite! 'opnorm-nonneg 'v 'w (u4 (caddr g3))) (ass))
      ((dk-head-is? g3 '=) (dk-cite! 'opnorm-neg 'v 'w (u4 (caddr g3))) (ass))
      (#t (error "bb2: group-norm conjunct" (expression->string g3))))))
(define (bb2-nag-step!)
   (let ((g (dk-goal)))
     (if (dk-asm? g) (ass)
     (cond
       ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
        (let ((h (car (cadr g))))
          (mac h)
          (dk-lam-type!
            (lambda ()
              (dk-peel!)
              (let ((body (cadr (dk-goal))))
                (case (car body)
                  ((BOP-SUM) (dk-cite! 'bop-sum-bounded 'v 'w (cadddr body) (car (cddddr body))))
                  ((BOP-NEG) (dk-cite! 'bop-neg-bounded 'v 'w (cadddr body)))
                  ((OPNORM) (dk-cite! 'opnorm-in-rr 'v 'w (cadddr body))))
                (ass)))
            (lambda () (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                           (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                           (ass))))))
       ((dk-head-is? g 'IS-GROUP-NORM)
        (mac 'is-group-norm)
        (dk-conj-close!
         (lambda ()
           (let ((g2 (dk-goal)))
             (cond
               ((dk-asm? g2) (ass))
               ((dk-head-is? g2 'IN)
                (mac 'BOP-VNRM)
                (dk-lam-type! (lambda () (dk-peel!) (dk-cite! 'opnorm-in-rr 'v 'w (cadddr (cadr (dk-goal)))) (ass))
                              (lambda () (ass))))
               (#t (dk-peel!) (dk-conj-close! bb2-gn-close!)))))))
       ((memq (car g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES))
        (mac (car g))
        (dk-peel!)
        (bb2-vals!)
        (let ((ts (filter (lambda (t) (dk-asm? (list 'IN t '(BOUNDED-OPS v w))))
                          (map cadr (filter (dk-head? 'IN) (dk-asms))))))
          (dk-conj-close!
           (lambda ()
             (let ((g3 (dk-goal)))
               (if (dk-asm? g3) (ass)
                   (let* ((l (cadr g3)) (r (caddr g3))
                          (a1 (lambda (t) (cadddr t))) (a2 (lambda (t) (car (cddddr t))))
                          (sum? (lambda (t) (dk-head-is? t 'BOP-SUM))))
                     (cond
                       ((and (sum? l) (sum? (a1 l)))
                        (dk-cite! 'bop-sum-assoc 'v 'w (a1 (a1 l)) (a2 (a1 l)) (a2 l)))
                       ((and (sum? l) (sum? r)) (dk-cite! 'bop-sum-comm 'v 'w (a1 l) (a2 l)))
                       ((and (sum? l) (equal? (a2 l) '(BOP-ZERO v w))) (dk-cite! 'bop-sum-zero-right 'v 'w (a1 l)))
                       ((and (sum? l) (equal? (a1 l) '(BOP-ZERO v w))) (dk-cite! 'bop-sum-zero-left 'v 'w (a2 l)))
                       ((and (sum? l) (dk-head-is? (a2 l) 'BOP-NEG)) (dk-cite! 'bop-sum-neg-right 'v 'w (a1 l)))
                       ((and (sum? l) (dk-head-is? (a1 l) 'BOP-NEG)) (dk-cite! 'bop-sum-neg-left 'v 'w (a2 l)))
                       (#t (error "bb2: group law" (expression->string g3))))
                     (if (dk-asm? g3) (ass)
                         (error "bb2: group law cite did not match" (expression->string g3))))))))))
       (#t (error "bb2: NAG-ELSE" (expression->string g)))))))
(let loop ((n 0))
  (let ((ls (dk-open-leaves)))
    (if (and (pair? ls) (< n 200))
        (begin
          (dk-focus! (car ls))
          (if (dk-head-is? (dk-goal) 'AND) (di)
              (let* ((g0 (expression->string (dk-goal)))
                     (r (call-with-current-continuation
                         (lambda (k)
                           (with-exception-handler
                            (lambda (e) (k (list 'fail (condition/report-string e))))
                            (lambda () (bb2-nag-step!) 'ok))))))
                (if (pair? r) (error "bb2: step failed at" g0 (cadr r)))))
          (loop (+ n 1))))))
(bb2-qed! 'bop-normed-ag-is-normed-ag)

;;; ==========================================================================================
;;; (E) THREE METRIC LEMMAS (library analysis): convergence and Cauchyness transported by a
;;; SCALED domination, and a limit keeps a non-strict bound on the tail.
;;; ==========================================================================================

;;; e in RR from POS-RR e, then  forsome d. pos-rr d and forall t in rr. 0 <= t => t <= d => c t <= e
;;; skolemised; returns (d . the clause)
(define (bb2-scale-eps! c e)
  (dk-cite! 'rr-pos-rr-in-rr e)
  (let* ((ex (dk-cite! 'rr-scale-eps c e))
         (d (dk-skolem! ex))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq d (free-vars f)))) "the scale clause")))
    (cons d cl)))

;;; ms-converges-of-scaled
(sp (make-wff (forall-guarded '(s tm_ f g l lm_ c_)
  '((IS-METRIC-SPACE s) (IN f (FUN NN (PTS s))) (IN l (PTS s)) (CONVERGES-TO tm_ g lm_) (IN c_ RR) (<= 0 c_)
    (FORALL n_ (IMPLIES (IN n_ NN) (<= ((DIST s) (f n_) l) (* c_ ((DIST tm_) (g n_) lm_))))))
  '(CONVERGES-TO s f l))))
(dk-peel!)
(let* ((dom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(DIST s)))) "the domination"))
       (r1 (bb2-iff-fwd! 'converges-to 'tm_ 'g 'lm_))
       (u1 (caddr (caddr (caddr r1))))
       (iff (dk-cite! 'converges-to 's 'f 'l))
       (clause (caddr (caddr (caddr (caddr iff))))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (dc (bb2-scale-eps! 'c_ e))
             (d (car dc))
             (n1 (dk-skolem! (dk-apply! u1 d)))
             (i1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n1 (free-vars f)))) "the tail")))
        (witness! n1
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2)))
                           (dg (list (list 'DIST 'tm_) (list 'g k) 'lm_)))
                      (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) k)
                      (dk-cite! 'fun-apply-type-c 'g 'NN '(PTS tm_) k)
                      (dk-cite! 'metric-dist-real 's (list 'f k) 'l)
                      (dk-cite! 'metric-dist-real 'tm_ (list 'g k) 'lm_)
                      (dk-cite! 'metric-pos 'tm_ (list 'g k) 'lm_)
                      (let* ((a1 (dk-apply! i1 k))
                             (a0 (dk-apply! dom k))
                             (a2 (dk-apply! (cdr dc) dg)))
                        (dk-cite! 'rr-pos-rr-in-rr e)
                        (bb2-mul-in! 'c_ dg)
                        (dk-ineq! a0 a2)))))))))))
  (bb2-iff-bwd! 'converges-to 's 'f 'l)
  (ass))
(bb2-qed! 'ms-converges-of-scaled)

;;; ms-cauchy-of-scaled
(sp (make-wff (forall-guarded '(s tm_ f g c_)
  '((IS-CAUCHY-SEQ s f) (IS-METRIC-SPACE tm_) (IN g (FUN NN (PTS tm_))) (IN c_ RR) (<= 0 c_)
    (FORALL m (IMPLIES (IN m NN) (FORALL n_ (IMPLIES (IN n_ NN)
       (<= ((DIST tm_) (g m) (g n_)) (* c_ ((DIST s) (f m) (f n_)))))))))
  '(IS-CAUCHY-SEQ tm_ g))))
(dk-peel!)
(let* ((dom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(DIST tm_)))) "the domination"))
       (rhs (bb2-iff-fwd! 'is-cauchy-seq 's 'f))
       (cu (caddr (caddr rhs)))
       (iff (dk-cite! 'is-cauchy-seq 'tm_ 'g))
       (clause (caddr (caddr (caddr iff)))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (dc (bb2-scale-eps! 'c_ e))
             (d (car dc))
             (nv (dk-skolem! (dk-apply! cu d)))
             (inner (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq nv (free-vars f)))) "the Cauchy universal")))
        (witness! nv
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2))
                           (m (cadr (car ins))) (n2 (cadr (cadr ins)))
                           (hh (bb2-have-and! (list '<= nv m) (list '<= nv n2)))
                           (le1 (dk-apply! inner m n2))
                           (le2 (dk-apply! dom m n2))
                           (df (list (list 'DIST 's) (list 'f m) (list 'f n2))))
                      (for-each (lambda (k)
                                  (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) k)
                                  (dk-cite! 'fun-apply-type-c 'g 'NN '(PTS tm_) k))
                                (list m n2))
                      (dk-cite! 'metric-dist-real 's (list 'f m) (list 'f n2))
                      (dk-cite! 'metric-dist-real 'tm_ (list 'g m) (list 'g n2))
                      (dk-cite! 'metric-pos 's (list 'f m) (list 'f n2))
                      (let ((a2 (dk-apply! (cdr dc) df)))
                        (dk-cite! 'rr-pos-rr-in-rr e)
                        (bb2-mul-in! 'c_ df)
                        (dk-ineq! le2 a2)))))))))))
  (bb2-iff-bwd! 'is-cauchy-seq 'tm_ 'g)
  (ass))
(bb2-qed! 'ms-cauchy-of-scaled)

;;; ms-limit-dist-le: a limit keeps a bound that holds on a tail
(sp (make-wff (forall-guarded '(s g l a b_ n0_)
  '((CONVERGES-TO s g l) (IN a (PTS s)) (IN b_ RR) (IN n0_ NN)
    (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= n0_ n_) (<= ((DIST s) (g n_) a) b_)))))
  '(<= ((DIST s) l a) b_))))
(dk-peel!)
(let* ((tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'b_))) "the tail bound"))
       (r1 (bb2-iff-fwd! 'converges-to 's 'g 'l))
       (u1 (caddr (caddr (caddr r1))))
       (dla (list (list 'DIST 's) 'l 'a)))
  (dk-cite! 'metric-dist-real 's 'l 'a)
  (dk-have! (list 'FORALL 'bld_ (list 'IMPLIES '(POS-RR bld_) (list '<= dla '(+ b_ bld_))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (n1 (dk-skolem! (dk-apply! u1 e)))
             (i1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n1 (free-vars f)))) "the tail"))
             (k (list '+ 'n0_ n1)))
        (bb2-have-and! (list 'IN 'n0_ 'NN) (list 'IN n1 'NN))
        (dk-cite! 'nn-add-closed 'n0_ n1)
        (dk-have! (list '<= 'n0_ k) (lambda () (dk-nn!)))
        (dk-have! (list '<= n1 k) (lambda () (dk-nn!)))
        (dk-cite! 'fun-apply-type-c 'g 'NN '(PTS s) k)
        (let* ((a1 (dk-apply! i1 k))
               (a2 (dk-apply! tl k))
               (tri (dk-cite! 'metric-triangle 's 'l (list 'g k) 'a))
               (sy (dk-cite! 'metric-sym 's 'l (list 'g k))))
          (dk-cite! 'metric-dist-real 's (list 'g k) 'l)
          (dk-cite! 'metric-dist-real 's 'l (list 'g k))
          (dk-cite! 'metric-dist-real 's (list 'g k) 'a)
          (dk-cite! 'rr-pos-rr-in-rr e)
          (dk-ineq! a1 a2 tri sy)))))
  (dk-cite! 'rr-le-of-le-add-all-pos dla 'b_)
  (ass))
(bb2-qed! 'ms-limit-dist-le)

;;; ==========================================================================================
;;; (F) THE OPERATOR METRIC AND THE METRIC OF w
;;; ==========================================================================================
(define bb2-M (list 'NAG-METRIC-SPACE bb2-G))
(define bb2-wms '(IP-METRIC-SPACE w))
(define (bb2-dm a b) (list (list 'DIST bb2-M) a b))
(define (bb2-dw a b) (list (list 'DIST bb2-wms) a b))
(define (bb2-vsub vs a b) (list (list 'VADD vs) a (list (list 'VNEG vs) b)))

;;; d(a, b) = ||a - b|| in the metric of an inner product space
(sp (make-wff (forall-guarded '(v a_ b_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN a_ (VEC v)) (IN b_ (VEC v)))
   (list '= '((DIST (IP-METRIC-SPACE v)) a_ b_) (list 'IP-NORM 'v (bb2-vsub 'v 'a_ 'b_))))))
(dk-peel!)
(fluid-let ((bb2-v 'v)) (bb2-vt! (bb2-vsub 'v 'a_ 'b_)))
(subst (dk-cite! 'ip-metric-space-dist 'v 'a_ 'b_))
(subst (dk-cite! 'ip-norm-unfold 'v (bb2-vsub 'v 'a_ 'b_)))
(if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'ipms-dist-norm)

;;; the distance of the operator metric is the operator norm of the difference
(sp (make-wff (forall-guarded '(v w s_ t_) (append bb2-C2 '((IN s_ (BOUNDED-OPS v w)) (IN t_ (BOUNDED-OPS v w))))
   (list '= (bb2-dm 's_ 't_) '(OPNORM v w (BOP-SUM v w s_ (BOP-NEG v w t_)))))))
(dk-peel!)
(dk-cite! 'bop-normed-ag-is-normed-ag 'v 'w)
(let ((ce (dk-cite! 'bop-nag-carr 'v 'w)))
  (for-each (lambda (t) (dk-have! (list 'IN t (list 'CARR bb2-G)) (lambda () (subst ce) (ass)))) '(s_ t_)))
(subst (dk-cite! 'nag-metric-distance bb2-G 's_ 't_))
(bb2-nag-readoffs!)
(dk-cite! 'bop-neg-bounded 'v 'w 't_)
(bb2-vals!)
(if (not (proof-done? *ps*)) (rfl))
(bb2-qed! 'bop-nag-dist)

;;; d_w(S x, T x) <= ||x|| d(S, T)
(sp (make-wff (forall-guarded '(v w s_ t_ x_)
   (append bb2-C2 '((IN s_ (BOUNDED-OPS v w)) (IN t_ (BOUNDED-OPS v w)) (IN x_ (VEC v))))
   (list '<= (bb2-dw '(s_ x_) '(t_ x_)) (list '* '(IP-NORM v x_) (bb2-dm 's_ 't_))))))
(dk-peel!)
(let* ((nt '(BOP-NEG v w t_)) (op (list 'BOP-SUM 'v 'w 's_ nt))
       (sx '(s_ x_)) (tx '(t_ x_)) (ntx (list nt 'x_)) (u (bb2-vsub 'w sx tx))
       (on (bb2-opn op)) (nx '(IP-NORM v x_)))
  (dk-cite! 'bop-neg-bounded 'v 'w 't_)
  (dk-cite! 'bop-sum-bounded 'v 'w 's_ nt)
  (for-each (lambda (t) (dk-cite! 'bop-fun 'v 'w t)) (list 's_ 't_ nt op))
  (dk-cite! 'fun-apply-type-c 's_ '(VEC v) '(VEC w) 'x_)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) 'x_)
  (dk-cite! 'fun-apply-type-c nt '(VEC v) '(VEC w) 'x_)
  (dk-cite! 'fun-apply-type-c op '(VEC v) '(VEC w) 'x_)
  (bb2-wt! u)
  (subst (dk-cite! 'ipms-dist-norm 'w sx tx))
  (subst (dk-cite! 'bop-nag-dist 'v 'w 's_ 't_))
  (bb2-opn-facts! op)
  (let* ((b0 (dk-apply! (bb2-bound-of op) 'x_))
         (e1 (dk-cite! 'bop-sum-apply 'v 'w 's_ nt 'x_))
         (b1 (dk-rewrite-h! b0 (list op 'x_) (caddr e1)))
         (e2 (dk-cite! 'bop-neg-apply 'v 'w 't_ 'x_))
         (b2 (dk-rewrite-h! b1 ntx (caddr e2))))
    (bb2-nt! 'v 'x_) (bb2-nt! 'w u)
    (dk-have! (list '= (list '* nx on) (list '* on nx)) (lambda () (crs)))
    (bb2-lin! (list (list 'IN (list 'IP-NORM 'w u) 'RR) (list 'IN nx 'RR) (list 'IN on 'RR))
              (list b2 (list '= (list '* nx on) (list '* on nx))))))
(bb2-qed! 'bop-pt-dist)

;;; d(a + b, c + d) <= d(a, c) + d(b, d) in w
(sp (make-wff (forall-guarded '(w a_ b_ c_ e_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN a_ (VEC w)) (IN b_ (VEC w)) (IN c_ (VEC w)) (IN e_ (VEC w)))
   (list '<= (bb2-dw '((VADD w) a_ b_) '((VADD w) c_ e_)) (list '+ (bb2-dw 'a_ 'c_) (bb2-dw 'b_ 'e_))))))
(dk-peel!)
(let* ((ab '((VADD w) a_ b_)) (ce '((VADD w) c_ e_))
       (ac (bb2-vsub 'w 'a_ 'c_)) (be (bb2-vsub 'w 'b_ 'e_)) (big (bb2-vsub 'w ab ce))
       (sm (list '(VADD w) ac be)))
  (bb2-wt! ab) (bb2-wt! ce) (bb2-wt! ac) (bb2-wt! be) (bb2-wt! big) (bb2-wt! sm)
  (subst (dk-cite! 'ipms-dist-norm 'w ab ce))
  (subst (dk-cite! 'ipms-dist-norm 'w 'a_ 'c_))
  (subst (dk-cite! 'ipms-dist-norm 'w 'b_ 'e_))
  (bb2-weq! big sm)
  (subst (list '= big sm))
  (dk-cite! 'cips-minkowski 'w ac be)
  (ass))
(bb2-qed! 'ipms-dist-sum-le)

;;; d(c a, c b) <= |c| d(a, b) in w
(sp (make-wff (forall-guarded '(w c_ a_ b_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN c_ CC) (IN a_ (VEC w)) (IN b_ (VEC w)))
   (list '<= (bb2-dw '((ACT w) c_ a_) '((ACT w) c_ b_)) (list '* '(magnitude c_) (bb2-dw 'a_ 'b_))))))
(dk-peel!)
(let* ((ca '((ACT w) c_ a_)) (cb '((ACT w) c_ b_)) (ab (bb2-vsub 'w 'a_ 'b_))
       (big (bb2-vsub 'w ca cb)) (cab (list '(ACT w) 'c_ ab)))
  (bb2-wt! ca) (bb2-wt! cb) (bb2-wt! ab) (bb2-wt! big) (bb2-wt! cab)
  (subst (dk-cite! 'ipms-dist-norm 'w ca cb))
  (subst (dk-cite! 'ipms-dist-norm 'w 'a_ 'b_))
  (bb2-weq! big cab)
  (subst (list '= big cab))
  (subst (dk-cite! 'ip-norm-act 'w 'c_ ab))
  (dk-cite! 'cc-magnitude-closed 'c_)
  (bb2-nt! 'w ab)
  (bb2-mul-in! '(magnitude c_) (list 'IP-NORM 'w ab))
  (dk-ineq! (list 'IN (list '* '(magnitude c_) (list 'IP-NORM 'w ab)) 'RR)))
(bb2-qed! 'ipms-dist-act-le)

;;; ==========================================================================================
;;; (G) COMPLETENESS: if w is a Hilbert space, the bounded operators v -> w are complete in the
;;; operator norm.
;;; ==========================================================================================
(define (bb2-gx f x) (list 'VNB-LAMBDA 'kq_ 'NN (list (list f 'kq_) x)))
(define (bb2-lims f x) (list 'SEP 'lq_ '(VEC w) (list 'CONVERGES-TO bb2-wms (bb2-gx f x) 'lq_)))
(define bb2-BOw '(BOUNDED-OPS v w))
(define (bb2-ptype! t x)                ; t in BO in context: t in FUN, t x in VEC w
  (dk-cite! 'bop-fun 'v 'w t)
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) x))
(define (bb2-seqt! f k)                 ; f in FUN(NN, BO) in context, k in NN: f k in BO
  (dk-cite! 'fun-apply-type-c f 'NN bb2-BOw k))

;;; a Cauchy sequence of the operator metric is a sequence of bounded operators
(sp (make-wff (forall-guarded '(v w f) (append bb2-C2 (list (list 'IS-CAUCHY-SEQ bb2-M 'f)))
   (list 'IN 'f (list 'FUN 'NN bb2-BOw)))))
(dk-peel!)
(dk-cite! 'bop-normed-ag-is-normed-ag 'v 'w)
(dk-cite! 'cauchy-seq-is-fun bb2-M 'f)
(let* ((pe (dk-cite! 'nag-metric-carrier bb2-G))
       (ce (dk-cite! 'bop-nag-carr 'v 'w)))
  (subst (list '= bb2-BOw (list 'CARR bb2-G)))
  (subst (list '= (list 'CARR bb2-G) (list 'PTS bb2-M)))
  (ass))
(bb2-qed! 'bop-cauchy-seq-fun)

;;; the sequence k |-> f(k)(x) is a sequence of points of w
(sp (make-wff (forall-guarded '(v w f x_) (append bb2-C2 (list (list 'IN 'f (list 'FUN 'NN bb2-BOw)) '(IN x_ (VEC v))))
   (list 'IN (bb2-gx 'f 'x_) (list 'FUN 'NN (list 'PTS bb2-wms))))))
(dk-peel!)
(let ((pw (dk-cite! 'ip-metric-space-pts 'w)))
  (subst (list '= (list 'PTS bb2-wms) '(VEC w)))
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (bb2-seqt! 'f (cadr (car (cadr (dk-goal)))))
      (bb2-ptype! (car (cadr (dk-goal))) 'x_)
      (ass))
    (lambda () (dk-cite! 'nn-is-set) (ass))))
(bb2-qed! 'bop-ptwise-seq-fun)

;;; ... and it is Cauchy
(sp (make-wff (forall-guarded '(v w f x_) (append bb2-C2 (list (list 'IS-CAUCHY-SEQ bb2-M 'f) '(IN x_ (VEC v))))
   (list 'IS-CAUCHY-SEQ bb2-wms (bb2-gx 'f 'x_)))))
(dk-peel!)
(dk-cite! 'bop-cauchy-seq-fun 'v 'w 'f)
(dk-cite! 'bop-ptwise-seq-fun 'v 'w 'f 'x_)
(dk-cite! 'ip-metric-space-is-metric-space 'w)
(bb2-nt! 'v 'x_)
(let* ((g (bb2-gx 'f 'x_)) (nx '(IP-NORM v x_))
       (dom (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
               (list '<= (list (list 'DIST bb2-wms) (list g 'm) (list g 'n_))
                         (list '* nx (list (list 'DIST bb2-M) '(f m) '(f n_))))))))))
  (dk-have! dom
    (lambda ()
      (let* ((lk (dk-peel!))
             (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) lk))))
        (dk-lam-b!)
        (for-each (lambda (k) (bb2-seqt! 'f k)) ks)
        (dk-cite! 'bop-pt-dist 'v 'w (list 'f (car ks)) (list 'f (cadr ks)) 'x_)
        (ass))))
  (dk-cite! 'ms-cauchy-of-scaled bb2-M bb2-wms 'f g nx)
  (ass))
(bb2-qed! 'bop-ptwise-cauchy)

;;; the limits at x form a nonempty set, so its CHOICE is one of them
(sp (make-wff (forall-guarded '(v w f x_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-HILBERT-SPACE w) (list 'IS-CAUCHY-SEQ bb2-M 'f) '(IN x_ (VEC v)))
   (list 'IN (list 'CHOICE (bb2-lims 'f 'x_)) (bb2-lims 'f 'x_)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'w)
(let* ((g (bb2-gx 'f 'x_)) (S (bb2-lims 'f 'x_)))
  (dk-cite! 'bop-ptwise-cauchy 'v 'w 'f 'x_)
  (dk-cite! 'hilbert-space-complete 'w)
