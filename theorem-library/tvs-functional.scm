;;; tb-func.scm -- topological-vector-space.pdf Cor 1.13: a linear functional f on a space whose topology is
;;; defined by a family of seminorms is continuous iff |f(x)| <= C max(p_i1(x), ..., p_in(x)).
;;; Agent TB-01, 2026-10-26.  DESTINATION: theorem-library/tvs-functional.scm (after tvs-continuity, tvs-rn).
;;; Library: analysis.  Helper prefix: tbf-.
;;; The scalars R carry the topology of |.|: the one-seminorm family {|.|} of the normed space RR-NVS.

(define (tbf-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define tbf-rv '(NORMED-VECTOR-SPACE-AS-MODULE RR-NVS))
(define tbf-ix '(PAIR 0 0))
(define tbf-pf '(VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS)))
(define tbf-topr (list 'SEMINORM-TOP tbf-rv tbf-ix tbf-pf))
(define tbf-top1 '(SEMINORM-TOP m ix pf))
(define tbf-fam '(IS-SEMINORM-FAMILY-ON RR-NORMED-FIELD m ix pf))
(define tbf-lin (list 'IS-LINEAR-MAP 'm tbf-rv 'f))
(define (tbf-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))

;;; |.| on R read off RR-NVS
(sp (make-wff '(FORALL v (IMPLIES (IN v RR) (= ((VNRM RR-NVS) v) (abs v))))))
(dk-peel!)
(slot 'VNRM)
(dk-lam-b!)
(dk-cite! 'rr-abs-closed 'v)
(if (not (proof-done? *ps*)) (rfl))
(tbf-qed! 'rr-nvs-norm-apply)

(define (tbf-abs-body ff cb)
  (list 'FORALL 'sbx_ (list 'IMPLIES '(IN sbx_ (VEC m))
    (list 'FORALL 'sbt_ (list 'IMPLIES '(IN sbt_ RR) (list 'IMPLIES '(<= 0 sbt_)
      (list 'IMPLIES (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff) '(<= ((pf sbi_) sbx_) sbt_)))
        (list '<= '(abs (f sbx_)) (list '* cb 'sbt_)))))))))
(define (tbf-q-body j ff cb)
  (list 'FORALL 'sbx_ (list 'IMPLIES '(IN sbx_ (VEC m))
    (list 'FORALL 'sbt_ (list 'IMPLIES '(IN sbt_ RR) (list 'IMPLIES '(<= 0 sbt_)
      (list 'IMPLIES (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff) '(<= ((pf sbi_) sbx_) sbt_)))
        (list '<= (list (list tbf-pf j) '(f sbx_)) (list '* cb 'sbt_)))))))))
(define (tbf-exists inner)
  (list 'FORSOME 'sbf_ (list 'AND '(IN sbf_ SET) (list 'AND '(IN (CARD sbf_) NN) (list 'AND '(SUBSET sbf_ ix)
    (list 'FORSOME 'sbc_ (list 'AND '(IN sbc_ RR) (list 'AND '(POS-RR sbc_) (inner 'sbf_ 'sbc_)))))))))

(sp (make-wff '(== (VEC RR-NVS) RR)))
(slot 'VEC)
(if (not (proof-done? *ps*)) (qrfl))
(tbf-qed! 'rr-nvs-vec)

(define tbf-allb (list 'FORALL 'sbj_ (list 'IMPLIES (list 'IN 'sbj_ tbf-ix)
                    (tbf-exists (lambda (ff cb) (tbf-q-body 'sbj_ ff cb))))))
(define tbf-absb (tbf-exists tbf-abs-body))
(define tbf-hom (list 'IS-HOM-TOP-SPACE tbf-top1 tbf-topr 'f))
(define tbf-stmt
  (list 'FORALL 'm (list 'FORALL 'ix (list 'FORALL 'pf (list 'FORALL 'f
    (list 'IMPLIES tbf-fam (list 'IMPLIES tbf-lin (list 'IFF tbf-hom tbf-absb))))))))
(sp (make-wff tbf-stmt))
(dk-peel!)
(dk-cite! 'rr-nvs-is-normed-vector-space)
(dk-cite! 'nvs-norm-family 'RR-NVS)
(dk-cite! 'nvs-module-view-vec 'RR-NVS)
(dk-cite! 'rr-nvs-vec)
(dk-have! (list 'IN 'f (list 'FUN '(VEC m) (list 'VEC tbf-rv)))
  (lambda () (mac-h 'IS-LINEAR-MAP (dk-ctx-form tbf-lin)) (dk-split-all!) (ass)))
(dk-rewrite-h! (list 'IN 'f (list 'FUN '(VEC m) (list 'VEC tbf-rv))) (list 'VEC tbf-rv) '(VEC RR-NVS))
(dk-rewrite-h! (list 'IN 'f '(FUN (VEC m) (VEC RR-NVS))) '(VEC RR-NVS) 'RR)
(fact 'nn-zero-in)
(dk-cite! 'membership-implies-sethood 0 'NN)
(dk-cite! 'pair-self-member 0)
(let ((iff1 (dk-cite! 'sn-cont-iff-bound 'm 'ix 'pf tbf-rv tbf-ix tbf-pf 'f))
      (ab (list 'IMPLIES tbf-allb tbf-absb))
      (ba (list 'IMPLIES tbf-absb tbf-allb)))
  ;; allb => absb: read the j = 0 bound, beta, and |.| on R
  (dk-have! ab
    (lambda ()
      (di)
      (let* ((ex (inst*! (dk-ctx-form tbf-allb) 0))
             (ex2 (if (dk-head-is? ex 'IMPLIES) (begin (detach! ex) (caddr ex)) ex))
             (ff (dk-skolem! ex2 #t))
             (cb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "c") #t))
             (body (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cb))) "body")))
        (ew ff)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (ew cb)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (let* ((ld (dk-peel!))
                                 (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m)))) ld))))
                                 (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                                 (le (dk-apply! body x t)))
                            (dk-cite! 'fun-apply-type-c 'f '(VEC m) 'RR x)
                            (dk-lam-b-h! le)
                            (dk-cite! 'rr-nvs-norm-apply (list 'f x))
                            (let ((le2 (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f '(VNRM RR-NVS)) (dk-contains? f x))) "beta'd")))
                              (dk-rewrite-h! le2 (list '(VNRM RR-NVS) (list 'f x)) (list 'abs (list 'f x))))
                            (dk-ass!))))))))))))
  ;; absb => allb: j in {0} is 0
  (dk-have! ba
    (lambda ()
      (di)
      (let* ((ff (dk-skolem! (dk-ctx-form tbf-absb) #t))
             (cb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "c") #t))
             (body (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cb))) "body")))
        (let ((j (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
          (dk-cite! 'pair-self-eq 0 j)
          (ew ff)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (ew cb)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let* ((ld (dk-peel!))
                                   (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m)))) ld))))
                                   (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))))
                              (dk-apply! body x t)
                              (dk-cite! 'fun-apply-type-c 'f '(VEC m) 'RR x)
                              (dk-cite! 'rr-nvs-norm-apply (list 'f x))
                              (subst (list '= j 0))
                              (dk-lam-b!)
                              (subst (list '= (list '(VNRM RR-NVS) (list 'f x)) (list 'abs (list 'f x))))
                              (dk-ass!)))))))))))))
  (if (dk-only! iff1 ab ba) (prop)))
(tbf-qed! 'functional-cont-iff-bound)
