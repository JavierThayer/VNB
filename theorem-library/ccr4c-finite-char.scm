(sp (make-wff `(FORALL c4n (IMPLIES (IN c4n NN) (FORALL c4r (IMPLIES (IS-RING c4r)
   (= (ZZ-ACT ,c4f-g (succ c4n) (ONE c4r)) ((ADD c4r) (ZZ-ACT ,c4f-g c4n (ONE c4r)) (ONE c4r)))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'ring-one-in 'c4r))
(dk-chain-ass! (dk-cite! 'ring-additive-ag-is-abelian-group 'c4r))
(dk-chain-ass! (dk-cite! 'ras-carr 'c4r))
(dk-rewrite-h! '(IN (ONE c4r) (CARR c4r)) '(CARR c4r) `(CARR ,c4f-g))
(dk-cite! 'nn-subset-zz 'c4n) (fact 'zz-one-in)
(let ((t (dk-chain-ass! (dk-cite! 'zz-act-type c4f-g 'c4n '(ONE c4r)))))
