;;; the ring facts of a commutative ring c4r, and ONE c4r typed in the additive group
(define (c4f-ring!)
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'c4r))
  (dk-chain-ass! (dk-cite! 'ring-one-in 'c4r))
  (dk-chain-ass! (dk-cite! 'ring-zero-in 'c4r))
  (dk-chain-ass! (dk-cite! 'ring-additive-ag-is-abelian-group 'c4r))
  (let ((e (dk-chain-ass! (dk-cite! 'ras-carr 'c4r))))
    (dk-rewrite-h! '(IN (ONE c4r) (CARR c4r)) '(CARR c4r) `(CARR ,c4f-g))
    e))
;; land (ZZ-ACT G k 1) in CARR c4r (and in CARR G); K typed in ZZ
(define (c4f-act-type! k)
  (let ((t `(ZZ-ACT ,c4f-g ,k (ONE c4r))))
    (if (not (dk-asm? `(IN ,t (CARR c4r))))
        (let ((f (dk-chain-ass! (dk-cite! 'zz-act-type c4f-g k '(ONE c4r)))))
          (dk-rewrite-h! f `(CARR ,c4f-g) '(CARR c4r))))
    t))

;;; (j k).1 = (k.1)(j.1)
(sp (make-wff `(FORALL c4j (IMPLIES (IN c4j NN) (FORALL c4r (IMPLIES (IS-COMMUTATIVE-RING c4r) (FORALL c4k (IMPLIES (IN c4k ZZ)
   (= (ZZ-ACT ,c4f-g (* c4j c4k) (ONE c4r))
      ((MUL c4r) (ZZ-ACT ,c4f-g c4k (ONE c4r)) (ZZ-ACT ,c4f-g c4j (ONE c4r))))))))))))
(dk-peel!)
(c4f-ring!)
(dk-cite! 'nn-subset-zz 'c4j)
(let* ((b (c4f-act-type! 'c4k)))
  (c4f-act-type! 'c4j)
  (subst (dk-cite! 'zz-act-assoc-ring-additive-ag 'c4r 'c4j 'c4k '(ONE c4r)))
  (subst (dk-cite! 'ring-scalar-zz-nn 'c4j 'c4r b '(ONE c4r)))
  (subst (dk-cite! 'ring-mul-right-id 'c4r b))
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(qed 'zz-act-one-mul)

