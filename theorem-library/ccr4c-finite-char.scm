;;; ---------------------------------------------------------------------------
;;; THE THEOREM: a finite integral domain has a prime characteristic
(define c4f-guard '(AND (IN c4m NN) (AND (<= 1 c4m) (= (ZZ-ACT (RING-ADDITIVE-AG c4r) c4m (ONE c4r)) (IDEN (RING-ADDITIVE-AG c4r))))))
(define (c4f-real! . ts) (for-each (lambda (t) (if (not (dk-asm? `(IN ,t RR))) (dk-cite! 'zz-in-rr t))) ts))

(sp (make-wff '(FORALL c4r (IMPLIES (IS-INTEGRAL-DOMAIN c4r) (IMPLIES (IN (CARD (CARR c4r)) NN)
   (FORSOME c4p (HAS-CHARACTERISTIC c4r c4p)))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring 'c4r))
(dk-chain-ass! (dk-cite! 'integral-domain-nontrivial 'c4r))
(c4f-ring!)
(dk-rewrite-h! '(IN (CARD (CARR c4r)) NN) '(CARR c4r) `(CARR ,c4f-g))
(dk-chain-ass! (dk-apply! (dk-chain-ass! (dk-cite! 'ag-zz-act-period c4f-g)) '(ONE c4r)))
(let* ((iden (dk-chain-ass! (dk-cite! 'ras-id 'c4r)))
       (r (minimize! '(c4m) c4f-guard 'c4m))
       (n (car (car r))) (tnode (cadr r)) (nenode (caddr r)))
  ;; the type side goal
  (dk-focus! tnode)
  (dk-peel!)
  (dk-close-if! (lambda () (dk-split-all!)) (lambda () (ass)))
  (if nenode (begin (dk-focus! nenode) (ass)))
  ;; main branch
  (dk-focus! (car (filter (lambda (l) (dk-contains? (dk-goal-of l) 'HAS-CHARACTERISTIC)) (dk-open-leaves))))
  (let* ((g0 (dk-pick (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f n))) "the minimizer's guard"))
         (minf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n) (dk-contains? f '<=))) "minimality")))
    (dk-split-all! (list g0))
    (dk-cite! 'nn-subset-zz n)
    (c4f-real! n)
    (let* ((e0 (dk-rewrite-h! `(= (ZZ-ACT ,c4f-g ,n (ONE c4r)) (IDEN ,c4f-g)) `(IDEN ,c4f-g) '(ZERO c4r))))
      ;; n /= 0, n /= 1, n /= -1
            (dk-have! `(NOT (= ,n 0)) (lambda () (di) (dk-absurd! `(= ,n 0) `(<= 1 ,n))))
            (dk-have! `(NOT (= ,n (- 1))) (lambda () (di) (dk-absurd! `(= ,n (- 1)) `(<= 1 ,n))))
      (dk-have! `(NOT (= ,n 1))
        (lambda ()
          (di)
          (let* ((e1 (dk-rewrite-h! e0 n 1))
                 (o (dk-chain-ass! (dk-cite! 'zz-act-one c4f-g '(ONE c4r))))
                 (e2 (dk-rewrite-h! e1 `(ZZ-ACT ,c4f-g 1 (ONE c4r)) '(ONE c4r))))
            (ai '(NOT (= (ONE c4r) (ZERO c4r)))))))
      (let* ((q (dk-skolem! (dk-chain-ass! (dk-cite! 'zz-prime-factor-exists n)) #t)))
        (dk-chain-ass! (dk-cite! 'prime-nat-gt-one q))
        (dk-split-all!)
        (dk-cite! 'nn-subset-zz q)
        (c4f-real! q)
        (let* ((dv (dk-pick (lambda (f) (dk-head-is? f 'ZZ-DIVIDES)) "q | n"))
               (_ (begin (mac-h 'zz-divides dv) (dk-split-all!)))
               (c (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the cofactor") #t))
               (nqc `(= ,n (* ,q ,c))))
          (c4f-real! c)
          (ew q)
          (mac 'has-characteristic)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (dk-ass!)
                  ;; q.1 = 0
                  (use-em `(= (ZZ-ACT ,c4f-g ,q (ONE c4r)) (ZERO c4r))
                    (lambda () (dk-ass!))
                    (lambda ()
                      (let* ((cq (c4f-act-type! c)) (qq (c4f-act-type! q))
                             (pm (dk-chain-ass! (dk-cite! 'zz-act-one-mul q 'c4r c)))
                             (e1 (dk-rewrite-h! e0 n `(* ,q ,c)))
                             (e2 (dk-rewrite-h! e1 `(ZZ-ACT ,c4f-g (* ,q ,c) (ONE c4r)) `((MUL c4r) ,cq ,qq)))
                             (c0 (dk-chain-ass! (dk-cite! 'integral-domain-cancel-zero 'c4r cq qq))))
                        ;; 0 < c
                        (dk-have! `(< 0 ,c)
                          (lambda ()
                            (use-em `(< 0 ,c) (lambda () (dk-ass!))
                              (lambda ()
                                (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 0 c))
                                (dk-have-and! `(IN ,c RR) `(IN ,q RR))
                                (dk-chain-ass! (dk-cite! 'rr-mul-comm c q))
                                (use-em `(= ,c 0)
                                  (lambda () (dk-absurd! (dk-rewrite-h! nqc c 0) `(<= 1 ,n)))
                                  (lambda ()
                                    (dk-have-and! `(<= ,c 0) `(NOT (= ,c 0)))
                                    (dk-chain-ass! (dk-cite! 'rr-le-ne-lt c 0))
                                    (dk-have! `(NOT (= ,q 0)) (lambda () (di) (dk-absurd! `(= ,q 0) `(< 1 ,q))))
                                    (let* ((lt (dk-chain-ass! (dk-cite! 'zz-lt-mul-right c 0 q)))
                                           (_z (dk-have! `(= (* 0 ,q) 0) (lambda () (crs))))
                                           (lt1 (dk-rewrite-h! lt `(* 0 ,q) 0))
                                           (lt2 (dk-rewrite-h! lt1 `(* ,c ,q) `(* ,q ,c)))
                                           (_t (dk-chain-ass! (dk-cite! 'rr-mul-in-rr q c)))
                                           (v (dk-name! `(* ,q ,c)))
                                           (lt3 (dk-rewrite-h! lt2 `(* ,q ,c) v))
                                           (nv (dk-rewrite-h! nqc `(* ,q ,c) v)))
                                      (dk-absurd! nv lt3 `(<= 1 ,n)))))))))
                        (dk-have! `(<= 0 ,c) (lambda () (dk-ineq! `(< 0 ,c))))
                        (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn c))
                        (dk-chain-ass! (dk-cite! 'zz-discrete c))
                        (dk-have! `(NOT (= ,c 0)) (lambda () (di) (dk-absurd! `(= ,c 0) `(< 0 ,c))))
                        (dk-chain-ass! (dk-cite! 'zz-lt-mul-right 1 q c))
                        (let* ((cz (dk-rewrite-h! `(= ,cq (ZERO c4r)) '(ZERO c4r) `(IDEN ,c4f-g))))
                          (dk-have-and! `(<= 1 ,c) cz)
                          (dk-have-and! `(IN ,c NN) `(AND (<= 1 ,c) ,cz))
                          (dk-chain-ass! (dk-apply! minf c))
                          (let* ((lt (dk-pick (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) `(* 1 ,c)))) "1 c < q c"))
                                 (_o (dk-have! `(= (* 1 ,c) ,c) (lambda () (crs))))
                                 (lt1 (dk-rewrite-h! lt `(* 1 ,c) c))
                                 (_t (dk-chain-ass! (dk-cite! 'rr-mul-in-rr q c)))
                                 (v (dk-name! `(* ,q ,c)))
                                 (lt2 (dk-rewrite-h! lt1 `(* ,q ,c) v))
                                 (nv (dk-rewrite-h! nqc `(* ,q ,c) v)))
                            (dk-absurd! nv lt2 `(<= ,n ,c)))))))))))))))
(qed 'finite-domain-characteristic)

(sp (make-wff '(FORALL c4r (IMPLIES (IS-FIELD-RING c4r) (IMPLIES (IN (CARD (CARR c4r)) NN)
   (FORSOME c4p (HAS-CHARACTERISTIC c4r c4p)))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain 'c4r))
(dk-chain-ass! (dk-cite! 'finite-domain-characteristic 'c4r))
