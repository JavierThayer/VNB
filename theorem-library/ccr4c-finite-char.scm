;;; Destination: theorem-library/ccr4c-finite-char.scm.  Library: algebra (rings, ZZ-ACT, primes of Z).
;;; Helper prefix c4f-.
;;;
;;;   ag-zz-act-gpow            n.b = GPOW(G, b, n) for n in NN (G abelian)               HOISTED from
;;;   ag-zz-act-period          G finite abelian: every b has n >= 1 with n.b = 0         ccr1109a6-chars (cut there)
;;;   zz-act-one-mul            (j k).1 = (k.1)(j.1) in a commutative ring, j in NN, k in ZZ
;;;   zz-act-one-zero, zz-act-one-succ   0.1 = 0 and (n+1).1 = n.1 + 1 in a ring
;;;   finite-domain-characteristic   R a finite integral domain => R has a (prime) characteristic p
;;;   finite-field-characteristic    the same for a field ring (the form the residue field of ccr-2-7 has)
;;;
;;; Proof of the main theorem: the period n >= 1 of 1 in the additive group exists by finiteness; take the
;;; least such n (minimize!).  n /= 1 since 1 /= 0, so n has a prime factor q, n = q c with c in ZZ.  If
;;; q.1 /= 0 then (c.1)(q.1) = n.1 = 0 forces c.1 = 0, and 0 < c < n contradicts minimality.
;;;
;;; Load window: after gal-char-vocab (HAS-CHARACTERISTIC, IS-PRIME-NAT), gal-char (prime-nat-gt-one), the
;;; zz-action / rake-zz-act files (zz-act-*, zz-act-assoc-ring-additive-ag), views (ras-carr, ras-id),
;;; group-zpow (gpow-period-exists), the zz-prime-factor-exists file, ring-scalar-zz-nn, zz-lt-mul-right,
;;; zz-discrete; before ccr1109a6-chars (which must then lose its copies of the two hoisted lemmas).

(define c4f-g '(RING-ADDITIVE-AG c4r))

