(dk-chain-ass! (dk-cite! 'ring-additive-ag-is-abelian-group 'c4r))
(dk-chain-ass! (dk-cite! 'ras-carr 'c4r))
(dk-rewrite-h! '(IN (ONE c4r) (CARR c4r)) '(CARR c4r) `(CARR ,c4f-g))
