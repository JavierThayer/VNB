   (FORALL a6b (IMPLIES (IN a6b (CARR a6g)) (FORSOME a6n (AND (IN a6n NN) (AND (<= 1 a6n) (= (ZZ-ACT a6g a6n a6b) (IDEN a6g))))))))))))
