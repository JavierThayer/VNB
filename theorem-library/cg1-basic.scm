;;; cg1-basic.scm -- compact-groups notes, chapter 1 (CG-1): balls are sets in any structure
;;; with a set of points; a metric group is a topological group; Isom(X) is a topological group
;;; (Proposition 1.6).  Agent ISOM, 2026-10-26.  Helper prefix: cgb-.  Library: analysis.

(define (cgb-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cgb-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (cgb-head g) (and (pair? g) (car g)))

;;; ---- a ball is a set whenever the points form a set (no metric axiom needed) ----
(sp (make-wff '(FORALL s (IMPLIES (IN (PTS s) SET) (FORALL x (FORALL r (IN (BALL s x r) SET)))))))
(dk-peel!)
(mac 'BALL)
(sep-set)
(cgb-ass!)
(qed 'ball-is-set-pts)
(topic! 'ball-is-set-pts 'analysis)

;;; ---- the points of the metric topology ----
;;; CUT 2026-10-27 (integration): `metric-top-pts' was proven here AND in theorem-library/nets.scm (the
;;; same statement up to the binder name).  nets.scm loads earlier and keeps it; the citation below is
;;; to that theorem.

;;; ---- a metric group is a topological group (for its metric topology) ----
(define cgb-T '(METRIC-TOP ms))
(define (cgb-d a b) (list '(DIST ms) a b))
(define (cgb-op a b) (list '(OPR grp) a b))
(define (cgb-inv a) (list '(INV grp) a))
(define (cgb-pos-parts! r)              ; POS-RR r: r in RR, 0 < r, and the AND ball-center-in wants
  (fact 'rr-pos-rr-in-rr r)
  (fact 'rr-lt-of-pos-rr r)
  (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (lambda () (dk-conj-close!
                (lambda () (let ((g0 (dk-goal)))
                             (cond ((dk-head-is? g0 'IN) (cgb-ass!))
                                   ((dk-head-is? g0 'NOT) (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= 0 r) (list '< 0 r) (list 'IN r 'RR)))) (ai (dk-cite! 'rr-lt-irrefl 0)))
                                   (#t (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))))))))
(define (cgb-ball-parts! z c r)
  (let ((iff (dk-cite! 'ball-membership 'ms c r z)))
    (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IN z (list 'BALL 'ms c r))) (prop))))
    (dk-split-all! (list (caddr iff)))))
(define (cgb-open-T! B)                 ; IS-OPEN(ms, B) in context: land B in OPENS(METRIC-TOP ms)
  (let ((iff (dk-cite! 'metric-top-opens-iff 'ms B)))
    (dk-have! (list 'IN B (list 'OPENS cgb-T)) (lambda () (if (dk-only! iff (list 'IS-OPEN 'ms B)) (prop))))))
(sp (make-wff '(FORALL ms (FORALL grp (IMPLIES (IS-GROUP-METRIC ms grp) (IS-GROUP-TOPOLOGY (METRIC-TOP ms) grp))))))
(dk-peel!)
(let ((iff (dk-cite! 'IS-GROUP-METRIC 'ms 'grp)))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-GROUP-METRIC ms grp)) (prop))))
  (dk-split-all! (list (caddr iff))))
(define cgb-pc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) "product continuity"))
(dk-cite! 'metric-top-is-top-space 'ms)
(dk-cite! 'metric-top-pts 'ms)
(fact 'group-identity-in 'grp)
(mac 'IS-GROUP-TOPOLOGY)
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'PTS))
       (subst (list '== (list 'PTS cgb-T) '(PTS ms))) (cgb-ass!))
      ((dk-head-is? g0 'FORALL)
       (let* ((pl (dk-peel!))
              (ins (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(CARR grp)))) pl))
              (x (cadr (car ins))) (y (cadr (cadr ins)))
              (wl (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) (list 'OPENS cgb-T)))) pl)))
              (W (cadr wl)) (xy (cgb-op x (cgb-inv y))))
         ;; W is open in the metric; a ball around x y^-1 lies in W
         (let ((iff (dk-cite! 'metric-top-opens-iff 'ms W)))
           (dk-have! (list 'IS-OPEN 'ms W) (lambda () (if (dk-only! iff wl) (prop)))))
         (let ((iff (dk-cite! 'is-open 'ms W)))
           (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IS-OPEN 'ms W)) (prop))))
           (dk-split-all! (list (caddr iff))))
         (dk-cite! 'group-inv-in 'grp y)
         (dk-cite! 'group-carrier-closed-opr 'grp x (cgb-inv y))
         (for-each (lambda (t) (dk-rewrite-h! (list 'IN t '(CARR grp)) '(CARR grp) '(PTS ms))) (list x y (cgb-inv y) xy))
         (let* ((bc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL) (dk-contains? h W))) "the ball clause"))
                (r (dk-skolem! (dk-apply! bc xy))))
           (dk-split-all!)
           (cgb-pos-parts! r)
           (let* ((eps (list '* 1/2 r)))
             (dk-have! '(IN 1/2 RR) (lambda () (arith)))
             (dk-cite! 'rr-mul-in-rr 1/2 r)
             (dk-have! (list '< 0 eps) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
             (fact 'rr-pos-rr-of-lt eps)
             (let* ((d1 (dk-skolem! (dk-apply! (dk-apply! cgb-pc x (cgb-inv y)) eps)))
                    (c1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h d1) (dk-contains? h eps))) "the product clause")))
               (dk-split-all!)
               (cgb-pos-parts! d1)
               ;; continuity of the inverse at y, at d1
               (let ((iff (dk-cite! 'is-continuous 'ms 'ms '(INV grp))))
                 (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-CONTINUOUS ms ms (INV grp))) (prop))))
                 (dk-split-all! (list (caddr iff))))
               (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-CONTINUOUS-AT))) "pointwise continuity") y)
               (let ((iff (dk-cite! 'is-continuous-at 'ms 'ms '(INV grp) y)))
                 (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IS-CONTINUOUS-AT 'ms 'ms '(INV grp) y)) (prop))))
                 (dk-split-all! (list (caddr iff))))
               (let* ((ec (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h y) (not (dk-contains? h 'mgu_)))) "the inverse clause"))
                      (d2 (dk-skolem! (dk-apply! ec d1)))
                      (c2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h d2))) "the inverse delta clause"))
                      (U (list 'BALL 'ms x d1)) (V (list 'BALL 'ms y d2)))
                 (dk-split-all!)
                 (cgb-pos-parts! d1)
                 (cgb-pos-parts! d2)
                 (dk-cite! 'ball-is-open 'ms x d1) (cgb-open-T! U)
                 (dk-cite! 'ball-is-open 'ms y d2) (cgb-open-T! V)
                 (dk-cite! 'ball-center-in 'ms x d1)
                 (dk-cite! 'ball-center-in 'ms y d2)
                 (ew U)
                 (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORSOME)
                        (begin
                          (ew V)
                          (dk-conj-close!
                           (lambda ()
                             (if (dk-head-is? (dk-goal) 'FORALL)
                                 (let* ((pl2 (dk-peel!))
                                        (p (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) U))) pl2))))
                                        (q (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) V))) pl2)))))
                                   (cgb-ball-parts! p x d1)
                                   (cgb-ball-parts! q y d2)
                                   (dk-rewrite-h! (list 'IN p '(PTS ms)) '(PTS ms) '(CARR grp))
                                   (dk-rewrite-h! (list 'IN q '(PTS ms)) '(PTS ms) '(CARR grp))
                                   (dk-cite! 'group-inv-in 'grp q)
                                   (dk-cite! 'group-carrier-closed-opr 'grp p (cgb-inv q))
                                   (dk-rewrite-h! (list 'IN (cgb-inv q) '(CARR grp)) '(CARR grp) '(PTS ms))
                                   (dk-rewrite-h! (list 'IN (cgb-op p (cgb-inv q)) '(CARR grp)) '(CARR grp) '(PTS ms))
                                   (dk-rewrite-h! (list 'IN q '(CARR grp)) '(CARR grp) '(PTS ms))
                                   (dk-apply! c2 q)
                                   (dk-apply! (dk-apply! c1 p) (cgb-inv q))
                                   (let ((dd (cgb-d xy (cgb-op p (cgb-inv q)))))
                                     (dk-cite! 'metric-dist-real 'ms xy (cgb-op p (cgb-inv q)))
                                     (dk-have! (list '<= dd r) (lambda () (dk-ineq! (list '<= dd eps) (list '< 0 r) (list 'IN dd 'RR) (list 'IN r 'RR))))
                                     (dk-have! (list 'NOT (list '= dd r))
                                       (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= dd r) (list '<= dd eps) (list '< 0 r) (list 'IN dd 'RR) (list 'IN r 'RR))))
                                                  (ai (dk-cite! 'rr-lt-irrefl 0))))
                                     (let ((iff (dk-cite! 'ball-membership 'ms xy r (cgb-op p (cgb-inv q)))))
                                       (dk-have! (list 'IN (cgb-op p (cgb-inv q)) (list 'BALL 'ms xy r))
                                         (lambda () (if (dk-only! iff (list 'IN (cgb-op p (cgb-inv q)) '(PTS ms)) (list '<= dd r) (list 'NOT (list '= dd r))) (prop)))))
                                     (dk-cite! 'subset-mem-fwd (list 'BALL 'ms xy r) W (cgb-op p (cgb-inv q)))
                                     (cgb-ass!)))
                                 (cgb-ass!)))))
                        (cgb-ass!))))))))))
      (#t (cgb-ass!))))))
(qed 'metric-group-is-top-group-gt)
(topic! 'metric-group-is-top-group-gt 'analysis)

;;; ---- Proposition 1.6: Isom(X), X compact, is a topological group ----
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-GROUP-TOPOLOGY (METRIC-TOP (ISOMETRY-GROUP-MS s)) (ISOMETRY-GROUP-GRP s))))))
(dk-peel!)
(dk-cite! 'isometry-group-is-metric-group-gm 's)
(dk-cite! 'metric-group-is-top-group-gt '(ISOMETRY-GROUP-MS s) '(ISOMETRY-GROUP-GRP s))
(cgb-ass!)
(qed 'isometry-group-is-top-group-gt)
(topic! 'isometry-group-is-top-group-gt 'analysis)

;;; ---- the same two facts for the STRUCTURES (2026-10-26): a METRIC-GROUP with its metric
;;; topology is a TOP-GROUP; the isometry group likewise ----
(sp (make-wff '(FORALL G (IMPLIES (IS-METRIC-GROUP G)
   (IS-TOP-GROUP (MAKE-TOP-GROUP (METRIC-TOP (METRIC-GROUP-MS G)) (METRIC-GROUP-GROUP G)))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(dk-cite! 'metric-group-group-is-group 'G)
(dk-cite! 'metric-group-group-metric 'G)
(dk-cite! 'metric-top-is-top-space '(METRIC-GROUP-MS G))
(dk-cite! 'metric-group-is-top-group-gt '(METRIC-GROUP-MS G) '(METRIC-GROUP-GROUP G))
(dk-cite! 'make-top-group-is-top-group '(METRIC-TOP (METRIC-GROUP-MS G)) '(METRIC-GROUP-GROUP G))
(cgb-ass!)
(qed 'metric-group-is-top-group)
(topic! 'metric-group-is-top-group 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
   (IS-TOP-GROUP (MAKE-TOP-GROUP (METRIC-TOP (ISOMETRY-GROUP-MS s)) (ISOMETRY-GROUP-GRP s)))))))
(dk-peel!)
(dk-cite! 'isometry-group-is-top-group-gt 's)
(dk-cite! 'make-top-group-is-top-group '(METRIC-TOP (ISOMETRY-GROUP-MS s)) '(ISOMETRY-GROUP-GRP s))
(cgb-ass!)
(qed 'isometry-group-is-top-group)
(topic! 'isometry-group-is-top-group 'analysis)
