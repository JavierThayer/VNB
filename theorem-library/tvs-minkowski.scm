;;; minkowski.scm -- topological-vector-space.pdf Prop 2.29: the Minkowski functional of a symmetric,
;;; absorbing, convex subset of a real vector space is a seminorm.  Agent DUAL-FIX, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-minkowski.scm.  Library: analysis.  Helper prefix: mkw-.
;;; Needs: structure-library/minkowski-functional (mink-vocab.scm here), the INF vocabulary and
;;; rr-inf-is-glb (RA-BASICS: rabasics-vocab, rabasics-monotone).
;;;
;;; The route is the notes', with the epsilon argument replaced by two greatest-lower-bound steps:
;;;   r in S(x), s in S(y)  =>  r + s in S(x + y)          (convexity; S(x) = MINK-SET(m, V, x))
;;; so p(x + y) - s is a lower bound of S(x) for each s in S(y), hence p(x + y) - p(x) is a lower bound
;;; of S(y), hence p(x + y) <= p(x) + p(y).  Homogeneity: S(c x) = c S(x) for c > 0, S(-x) = S(x) by
;;; symmetry, S(0) = all positive reals.

(define (mkw-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MKW OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mkw-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (mkw-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (mkw-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((dk-head-is? t 'abs) (mkw-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (mkw-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (mkw-real! (cadr t)) (mkw-real! (caddr t))
           (mkw-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (mkw-real! (cadr t)) (mkw-real! (caddr t))
           (mkw-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))

(define mkw-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define mkw-rmod (list '(IS-MODULE m) (list '= '(SCAL m) mkw-ring)))
(define mkw-V '(VEC m))
(define (mkw-act r x) (list '(ACT m) r x))
(define (mkw-add x y) (list '(VADD m) x y))
(define mkw-z '(VZERO m))

;;; =====================================================================
;;; (1) A MODULE OVER THE REALS: THE MODULE LAWS WITH RR'S OWN + * 0 1
;;; =====================================================================
(define (mkw-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) mkw-ring)) (mac 'rr-scalar-ring-carr) (ass))))
    ty))
;; (= RR-TERM (OP (SCAL m)) ...) for the view's OP read through its lambda
(define (mkw-scalar-op! op r s)
  (let* ((lhs (list (if (eq? op 'ADD) '+ '*) r s))
         (rhs (list (list op '(SCAL m)) r s))
         (e (list '= lhs rhs)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda ()
                      (subst (list '= '(SCAL m) mkw-ring))
                      (mac (if (eq? op 'ADD) 'rr-scalar-ring-add 'rr-scalar-ring-mul))
                      (dk-lam-b!)
                      (mkw-real! lhs)
                      (rfl))))
    e))

(sp (make-wff (forall-guarded '(m r x) (append mkw-rmod (list '(IN r RR) (list 'IN 'x mkw-V)))
                              (list 'IN (mkw-act 'r 'x) mkw-V))))
(dk-peel!)
(mkw-carr! 'r)
(dk-cite! 'module-act-type 'm 'r 'x)
(ass)
(mkw-qed! 'rmod-act-type)

(sp (make-wff (forall-guarded '(m r s x) (append mkw-rmod (list '(IN r RR) '(IN s RR) (list 'IN 'x mkw-V)))
                              (list '= (mkw-act '(* r s) 'x) (mkw-act 'r (mkw-act 's 'x))))))
(dk-peel!)
(mkw-carr! 'r) (mkw-carr! 's)
(subst (mkw-scalar-op! 'MUL 'r 's))
(dk-cite! 'module-act-mul-compat 'm 'r 's 'x)
(ass)
(mkw-qed! 'rmod-act-mul)

(sp (make-wff (forall-guarded '(m r s x) (append mkw-rmod (list '(IN r RR) '(IN s RR) (list 'IN 'x mkw-V)))
                              (list '= (mkw-act '(+ r s) 'x) (mkw-add (mkw-act 'r 'x) (mkw-act 's 'x))))))
(dk-peel!)
(mkw-carr! 'r) (mkw-carr! 's)
(subst (mkw-scalar-op! 'ADD 'r 's))
(dk-cite! 'module-act-distrib-scalar 'm 'r 's 'x)
(ass)
(mkw-qed! 'rmod-act-add)

(sp (make-wff (forall-guarded '(m x) (append mkw-rmod (list (list 'IN 'x mkw-V)))
                              (list '= (mkw-act 1 'x) 'x))))
(dk-peel!)
(dk-have! '(= 1 (ONE (SCAL m)))
  (lambda () (subst (list '= '(SCAL m) mkw-ring)) (mac 'rr-scalar-ring-one) (arith)))
(subst '(= 1 (ONE (SCAL m))))
(dk-cite! 'module-act-unital 'm 'x)
(ass)
(mkw-qed! 'rmod-act-one)

(sp (make-wff (forall-guarded '(m x) (append mkw-rmod (list (list 'IN 'x mkw-V)))
                              (list '= (mkw-act 0 'x) mkw-z))))
(dk-peel!)
(dk-have! '(= 0 (ZERO (SCAL m)))
  (lambda () (subst (list '= '(SCAL m) mkw-ring)) (mac 'rr-scalar-ring-zero) (arith)))
(subst '(= 0 (ZERO (SCAL m))))
(dk-cite! 'module-zero-act 'm 'x)
(ass)
(mkw-qed! 'rmod-act-zero)

(sp (make-wff (forall-guarded '(m r) (append mkw-rmod (list '(IN r RR)))
                              (list '= (mkw-act 'r mkw-z) mkw-z))))
(dk-peel!)
(mkw-carr! 'r)
(dk-cite! 'module-act-zero-vec 'm 'r)
(ass)
(mkw-qed! 'rmod-act-vzero)

(sp (make-wff (forall-guarded '(m r x y) (append mkw-rmod (list '(IN r RR) (list 'IN 'x mkw-V) (list 'IN 'y mkw-V)))
                              (list '= (mkw-act 'r (mkw-add 'x 'y)) (mkw-add (mkw-act 'r 'x) (mkw-act 'r 'y))))))
(dk-peel!)
(mkw-carr! 'r)
(dk-cite! 'module-act-distrib-vec 'm 'r 'x 'y)
(ass)
(mkw-qed! 'rmod-act-distrib)

(sp (make-wff (forall-guarded '(m x) (list '(IS-MODULE m) (list 'IN 'x mkw-V))
                              (list '= (mkw-add mkw-z 'x) 'x))))
(dk-peel!)
(let ((idf (dk-project! (list 'is-identity '(VADD m) mkw-z mkw-V) 'is-module '(IS-MODULE m))))
  (mac-h 'is-identity idf)
  (dk-split-all!)
  (let ((u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'VZERO))) (dk-asms))))
    (dk-split! (dk-apply! u 'x))
    (ass)))
(mkw-qed! 'rmod-vzero-left)

;;; =====================================================================
;;; (2) THE SET V: 0 IS IN IT, IT IS STAR-SHAPED, AND THE SETS S(x)
;;; =====================================================================
(define mkw-H (append mkw-rmod '((IS-CONVEX-SUBSET m cs) (IS-SYMMETRIC-SUBSET m cs) (IS-ABSORBING-SUBSET m cs))))
(define mkw-cvx '(FORALL sxa_ (IMPLIES (IN sxa_ cs) (FORALL sxb_ (IMPLIES (IN sxb_ cs)
  (FORALL sxt_ (IMPLIES (IN sxt_ RR) (IMPLIES (<= 0 sxt_) (IMPLIES (<= sxt_ 1)
    (IN ((VADD m) ((ACT m) (- 1 sxt_) sxa_) ((ACT m) sxt_ sxb_)) cs))))))))))
(define mkw-sym '(FORALL syx_ (IMPLIES (IN syx_ cs) (IN ((ACT m) (- 1) syx_) cs))))
(define mkw-abs '(FORALL abx_ (IMPLIES (IN abx_ (VEC m))
  (FORSOME abr_ (AND (IN abr_ RR) (AND (< 0 abr_) (FORSOME aby_ (AND (IN aby_ cs) (= abx_ ((ACT m) abr_ aby_))))))))))
(define (mkw-parts!)
  (dk-project! '(SUBSET cs (VEC m)) 'is-absorbing-subset '(IS-ABSORBING-SUBSET m cs))
  (dk-project! mkw-abs 'is-absorbing-subset '(IS-ABSORBING-SUBSET m cs))
  (if (dk-asm? '(IS-SYMMETRIC-SUBSET m cs))
      (begin
        (dk-project! mkw-sym 'is-symmetric-subset '(IS-SYMMETRIC-SUBSET m cs))
        (if (and (not (dk-asm? (list 'IN mkw-z 'cs)))
                 (hash-table-ref/default *theorem-table* 'mink-vzero-in #f))
            (dk-cite! 'mink-vzero-in 'm 'cs))))
  (dk-project! mkw-cvx 'is-convex-subset '(IS-CONVEX-SUBSET m cs)))
(define (mkw-inV! y)   ; y in cs  =>  y in VEC m
  (let ((ty (list 'IN y mkw-V)))
    (if (not (dk-asm? ty)) (dk-cite! 'subset-mem-fwd 'cs mkw-V y))
    ty))
(define (mkw-vtype! t)
  (let ((ty (list 'IN t mkw-V)))
    (cond ((dk-asm? ty) ty)
          ((equal? t mkw-z) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (mkw-real! (cadr t)) (mkw-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (mkw-vtype! (cadr t)) (mkw-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          ((and (symbol? t) (dk-asm? (list 'IN t 'cs))) (mkw-inV! t))
          (#t (error "mkw-vtype!: no typing for" t)))))
;; (IN (VADD (ACT a y) (ACT b z)) cs) with z = (ACT c y)  ... rewritten by the module laws
(define (mkw-pos! z w)   ; w in S(z): land w in RR and 0 < w
  (if (not (and (dk-asm? (list 'IN w 'RR)) (dk-asm? (list '< 0 w))))
      (dk-split! (dk-cite! 'mink-set-elim 'm 'cs z w))))
(define (mkw-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define (mkw-st vars guards body) (forall-guarded (cons 'm (cons 'cs vars)) (append mkw-H guards) body))
;; THE GENERAL HYPOTHESES (2026-10-26, for the gauge of a non-symmetric set, TB-2a): convex, absorbing and
;; containing 0.  Every lemma that does not use symmetry is stated with these; the symmetric case lands
;; 0 in cs from mink-vzero-in (mkw-parts!).
(define mkw-G (append mkw-rmod (list '(IS-CONVEX-SUBSET m cs) '(IS-ABSORBING-SUBSET m cs) (list 'IN mkw-z 'cs))))
(define (mkw-st-g vars guards body) (forall-guarded (cons 'm (cons 'cs vars)) (append mkw-G guards) body))

(sp (make-wff (mkw-st '() '() (list 'IN mkw-z 'cs))))
(dk-peel!)
(mkw-parts!)
(dk-cite! 'module-vzero-in 'm)
(let* ((ex (dk-apply! mkw-abs mkw-z))
       (r (dk-skolem! ex))
       (ex2 (dk-ctx-form (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'aby_))) (dk-asms))))
       (y (dk-skolem! ex2))
       (half 1/2) (m1 '(- 1))
       (ny (mkw-act m1 y)))
  (mkw-inV! y)
  (dk-apply! mkw-sym y)
  (mkw-real! half) (mkw-real! m1)
  (dk-have! (list '<= 0 half) (lambda () (dk-ineq!)))
  (dk-have! (list '<= half 1) (lambda () (dk-ineq!)))
  (let* ((mem (dk-apply! mkw-cvx y ny half))
         (sum (cadr mem)) (aa (cadr (cadr sum))) (bt (caddr sum)))
    (mkw-real! aa)
    (let* ((bb (list '* half m1))
           (e1 (dk-cite! 'rmod-act-mul 'm half m1 y))
           (m2 (dk-rewrite-h! mem bt (mkw-act bb y)))
           (e2 (begin (mkw-real! bb) (dk-cite! 'rmod-act-add 'm aa bb y)))
           (m3 (dk-rewrite-h! m2 (mkw-add (mkw-act aa y) (mkw-act bb y)) (mkw-act (list '+ aa bb) y)))
           (e3 (dk-have! (list '= (list '+ aa bb) 0) (lambda () (crs))))
           (m4 (dk-rewrite-h! m3 (list '+ aa bb) 0))
           (e4 (dk-cite! 'rmod-act-zero 'm y))
           (m5 (dk-rewrite-h! m4 (mkw-act 0 y) mkw-z)))
      (ass))))
(mkw-qed! 'mink-vzero-in)

(sp (make-wff (mkw-st-g '(y t) '((IN y cs) (IN t RR) (<= 0 t) (<= t 1)) (list 'IN (mkw-act 't 'y) 'cs))))
(dk-peel!)
(mkw-parts!)
(mkw-inV! 'y)
(let* ((mem (dk-apply! mkw-cvx mkw-z 'y 't))
       (sum (cadr mem)) (a0 (cadr sum)) (aa (cadr a0)))
  (mkw-real! aa)
  (let* ((e1 (dk-cite! 'rmod-act-vzero 'm aa))
         (m2 (dk-rewrite-h! mem a0 mkw-z))
         (e2 (begin (mkw-vtype! (mkw-act 't 'y)) (dk-cite! 'rmod-vzero-left 'm (mkw-act 't 'y))))
         (m3 (dk-rewrite-h! m2 (mkw-add mkw-z (mkw-act 't 'y)) (mkw-act 't 'y))))
    (ass)))
(mkw-qed! 'mink-scale-in)

;;; ---- the sets S(x) ----------------------------------------------------------
(define (mkw-S x) (list 'MINK-SET 'm 'cs x))
(define (mkw-Sbody x) (list 'SEP 'mkr_ 'RR (list 'AND '(< 0 mkr_)
                         (list 'FORSOME 'mky_ (list 'AND '(IN mky_ cs) (list '= x '((ACT m) mkr_ mky_)))))))

(sp (make-wff (forall-guarded '(m cs x) '() (list '== (mkw-S 'x) (mkw-Sbody 'x)))))
(dk-peel!)
(mac 'MINK-SET)
(qrfl)
(mkw-qed! 'mink-set-unfold)

(sp (make-wff (forall-guarded '(m cs x r y) '((IN r RR) (< 0 r) (IN y cs) (= x ((ACT m) r y)))
                              (list 'IN 'r (mkw-S 'x)))))
(dk-peel!)
(mac 'MINK-SET)
(in-sep! (lambda () (ass))
         (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                                    (begin (ew 'y) (dk-conj-close! (lambda () (ass))))
                                                    (ass))))))
(mkw-qed! 'mink-set-intro)

(sp (make-wff (forall-guarded '(m cs x r) (list (list 'IN 'r (mkw-S 'x)))
   '(AND (IN r RR) (AND (< 0 r) (FORSOME mky_ (AND (IN mky_ cs) (= x ((ACT m) r mky_)))))))))
(dk-peel!)
(let* ((h (dk-ctx-form (list 'IN 'r (mkw-S 'x))))
       (e (dk-cite! 'mink-set-unfold 'm 'cs 'x))
       (h2 (dk-rewrite-h! h (mkw-S 'x) (mkw-Sbody 'x))))
  (sep-me h2)
  (dk-split-all!)
  (dk-conj-close! (lambda () (ass))))
(mkw-qed! 'mink-set-elim)

;;; S(x) is a non-empty set of positive reals; INF S(x) is its greatest lower bound
(define (mkw-glb-body s)
  (list 'AND (list 'IN (list 'INF s) 'RR)
   (list 'AND (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) (list '<= (list 'INF s) 'lbw_)))
              (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR) (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) '(<= lbb_ lbw_)))
                                                                (list '<= 'lbb_ (list 'INF s))))))))
(sp (make-wff (mkw-st-g '(z) (list (list 'IN 'z mkw-V)) (mkw-glb-body (mkw-S 'z)))))
(dk-peel!)
(mkw-parts!)
(let ((s (mkw-S 'z)))
  (dk-have! (list 'SUBSET s 'RR)
    (lambda ()
      (mac 'subset-def)
      (let ((w (dk-di-var!)))
        (mkw-pos! 'z w)
        (ass))))
  (dk-have! (list 'FORSOME 'x0 (list 'IN 'x0 s))
    (lambda ()
      (let* ((r (dk-skolem! (dk-apply! mkw-abs 'z)))
             (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'aby_))) (dk-asms)))
             (y (dk-skolem! ex2)))
        (dk-cite! 'mink-set-intro 'm 'cs 'z r y)
        (ew r)
        (ass))))
  (dk-cite! 'rr-zero-in)
  (dk-have! (list 'FORSOME 'bnd (list 'AND '(IN bnd RR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x s) '(<= bnd x)))))
    (lambda ()
      (ew 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((w (dk-di-var!)))
                (mkw-pos! 'z w)
                (dk-ineq! (list '< 0 w) (list 'IN w 'RR)))
              (ass))))))
  (dk-cite! 'rr-inf-is-glb s)
  (ass))
(mkw-qed! 'mink-set-glb)

(sp (make-wff (forall-guarded '(m cs z) (list (list 'IN 'z mkw-V))
   (list '== (list '(MINKOWSKI-FUNCTIONAL m cs) 'z) (list 'INF (mkw-S 'z))))))
(dk-peel!)
(mac 'MINKOWSKI-FUNCTIONAL)
(dk-lam-b!)
(qrfl)
(mkw-qed! 'mink-value)

;;; =====================================================================
;;; (3) THREE FACTS ABOUT REALS, STATED OVER VARIABLES (products defeat ineq)
;;; =====================================================================
;; 0 <= c, a <= b  =>  c a <= c b
(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (<= 0 c) (<= a b)) '(<= (* c a) (* c b)))))
(dk-peel!)
(let* ((h (dk-cite! 'rr-mul-le-right 'a 'b 'c))
       (e1 (mkw-eq! '(* a c) '(* c a)))
       (h2 (dk-rewrite-h! h '(* a c) '(* c a)))
       (e2 (mkw-eq! '(* b c) '(* c b)))
       (h3 (dk-rewrite-h! h2 '(* b c) '(* c b))))
  (ass))
(mkw-qed! 'mink-rr-scale-le)

;; 0 < a, 0 < b  =>  0 < a b
(sp (make-wff (forall-guarded '(a b) '((IN a RR) (IN b RR) (< 0 a) (< 0 b)) '(< 0 (* a b)))))
(dk-peel!)
(dk-cite! 'rr-zero-in)
(mkw-and! '(< 0 a) '(< 0 b))
(let* ((h (dk-cite! 'rr-lt-scale-pos 'a 0 'b))
       (e (mkw-eq! '(* a 0) 0))
       (h2 (dk-rewrite-h! h '(* a 0) 0)))
  (ass))
(mkw-qed! 'mink-rr-mul-pos)

;; 0 < c:  c a <= b  =>  a <= recip(c) b,   and   a <= recip(c) b  =>  c a <= b
;; NOT (c = 0) from 0 < c
(define (mkw-nz! c)
  (dk-have! (list 'NOT (list '= c 0))
    (lambda ()
      (di)
      (dk-rewrite-h! (dk-ctx-form (list '< 0 c)) c 0)
      (dk-cite! 'rr-zero-in)
      (dk-cite! 'rr-lt-irrefl 0)
      (ai '(NOT (< 0 0))))))
(define (mkw-recip-setup!)
  (mkw-nz! 'c)
  (mkw-and! '(IN c RR) '(NOT (= c 0)))
  (dk-cite! 'rr-recip-closed 'c)
  (dk-cite! 'rr-recip-inverse 'c)
  (dk-cite! 'rr-recip-pos 'c)
  (let ((q (dk-name! '(recip c))))
    (dk-have! (list '= (list '* 'c q) 1) (lambda () (subst (list '= q '(recip c))) (ass)))
    (dk-have! (list '<= 0 q) (lambda () (subst (list '= q '(recip c))) (dk-ineq! '(< 0 (recip c)) '(IN (recip c) RR))))
    q))
(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (< 0 c) (<= (* c a) b))
                              '(<= a (* (recip c) b)))))
(dk-peel!)
(let* ((q (mkw-recip-setup!))
       (ca '(* c a)))
  (mkw-real! ca)
  (subst (list '= '(recip c) q))
  (let* ((h (dk-cite! 'mink-rr-scale-le ca 'b q))
         (e1 (mkw-eq! (list '* q ca) (list '* (list '* 'c q) 'a)))
         (h2 (dk-rewrite-h! h (list '* q ca) (list '* (list '* 'c q) 'a)))
         (h3 (dk-rewrite-h! h2 (list '* 'c q) 1))
         (e2 (mkw-eq! '(* 1 a) 'a))
         (h4 (dk-rewrite-h! h3 '(* 1 a) 'a)))
    (ass)))
(mkw-qed! 'mink-rr-div-le)

(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (< 0 c) (<= a (* (recip c) b)))
                              '(<= (* c a) b))))
(dk-peel!)
(let* ((q (mkw-recip-setup!)))
  (dk-have! '(<= 0 c) (lambda () (dk-ineq! '(< 0 c) '(IN c RR))))
  (let* ((h0 (dk-ctx-form '(<= a (* (recip c) b))))
         (h1 (dk-rewrite-h! h0 '(recip c) q))
         (qb (list '* q 'b)))
    (mkw-real! qb)
    (let* ((h (dk-cite! 'mink-rr-scale-le 'a qb 'c))
           (e1 (mkw-eq! (list '* 'c qb) (list '* (list '* 'c q) 'b)))
           (h2 (dk-rewrite-h! h (list '* 'c qb) (list '* (list '* 'c q) 'b)))
           (h3 (dk-rewrite-h! h2 (list '* 'c q) 1))
           (e2 (mkw-eq! '(* 1 b) 'b))
           (h4 (dk-rewrite-h! h3 '(* 1 b) 'b)))
      (ass))))
(mkw-qed! 'mink-rr-le-div)

;; 0 < c:  b <= c a  =>  recip(c) b <= a,   and   recip(c) b <= a  =>  b <= c a
(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (< 0 c) (<= b (* c a)))
                              '(<= (* (recip c) b) a))))
(dk-peel!)
(let* ((q (mkw-recip-setup!))
       (ca '(* c a)))
  (mkw-real! ca)
  (subst (list '= '(recip c) q))
  (let* ((h (dk-cite! 'mink-rr-scale-le 'b ca q))
         (e1 (mkw-eq! (list '* q ca) (list '* (list '* 'c q) 'a)))
         (h2 (dk-rewrite-h! h (list '* q ca) (list '* (list '* 'c q) 'a)))
         (h3 (dk-rewrite-h! h2 (list '* 'c q) 1))
         (e2 (mkw-eq! '(* 1 a) 'a))
         (h4 (dk-rewrite-h! h3 '(* 1 a) 'a)))
    (ass)))
(mkw-qed! 'mink-rr-div-ge)

(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (< 0 c) (<= (* (recip c) b) a))
                              '(<= b (* c a)))))
(dk-peel!)
(let* ((q (mkw-recip-setup!)))
  (dk-have! '(<= 0 c) (lambda () (dk-ineq! '(< 0 c) '(IN c RR))))
  (let* ((h0 (dk-ctx-form '(<= (* (recip c) b) a)))
         (h1 (dk-rewrite-h! h0 '(recip c) q))
         (qb (list '* q 'b)))
    (mkw-real! qb)
    (let* ((h (dk-cite! 'mink-rr-scale-le qb 'a 'c))
           (e1 (mkw-eq! (list '* 'c qb) (list '* (list '* 'c q) 'b)))
           (h2 (dk-rewrite-h! h (list '* 'c qb) (list '* (list '* 'c q) 'b)))
           (h3 (dk-rewrite-h! h2 (list '* 'c q) 1))
           (e2 (mkw-eq! '(* 1 b) 'b))
           (h4 (dk-rewrite-h! h3 '(* 1 b) 'b)))
      (ass))))
(mkw-qed! 'mink-rr-ge-div)

;; recip(c).(c.x) = x
(sp (make-wff (forall-guarded '(m c x) (append mkw-rmod (list '(IN c RR) '(< 0 c) (list 'IN 'x mkw-V)))
                              (list '= (mkw-act '(recip c) (mkw-act 'c 'x)) 'x))))
(dk-peel!)
(let* ((q (mkw-recip-setup!)))
  (subst (list '= '(recip c) q))
  (mkw-subst-rev! (dk-cite! 'rmod-act-mul 'm q 'c 'x))
  (subst (mkw-eq! (list '* q 'c) (list '* 'c q)))
  (subst (list '= (list '* 'c q) 1))
  (subst (dk-cite! 'rmod-act-one 'm 'x))
  (rfl))
(mkw-qed! 'rmod-act-recip-cancel)

;;; =====================================================================
;;; (4) HOW S(x) MOVES
;;; =====================================================================
(define (mkw-elim! r x)   ; r in S(x): land r in RR, 0 < r, and y in cs with x = r.y; return y
  (let* ((c (dk-cite! 'mink-set-elim 'm 'cs x r)))
    (dk-split! c)
    (let ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'mky_) (dk-contains? f r)
                                           (dk-contains? f x)))
                          (dk-asms))))
      (dk-skolem! ex))))

;; S(x) scaled by c > 0 lies in S(c x)
(sp (make-wff (mkw-st-g '(x c r) (list (list 'IN 'r (mkw-S 'x)) '(IN c RR) '(< 0 c))
                      (list 'IN '(* c r) (mkw-S (mkw-act 'c 'x))))))
(dk-peel!)
(mkw-parts!)
(let* ((y (mkw-elim! 'r 'x)))
  (mkw-inV! y)
  (mkw-real! '(* c r))
  (mkw-real! 0)
  (mkw-and! '(< 0 c) '(< 0 r))
  (let* ((h (dk-cite! 'rr-lt-scale-pos 'c 0 'r))
         (e (mkw-eq! '(* c 0) 0))
         (h2 (dk-rewrite-h! h '(* c 0) 0)))
    (dk-have! (list '= (mkw-act 'c 'x) (mkw-act '(* c r) y))
      (lambda ()
        (subst (list '= 'x (mkw-act 'r y)))
        (subst (dk-cite! 'rmod-act-mul 'm 'c 'r y))
        (mkw-vtype! (mkw-act 'c (mkw-act 'r y)))
        (rfl)))
    (dk-cite! 'mink-set-intro 'm 'cs (mkw-act 'c 'x) '(* c r) y)
    (ass)))
(mkw-qed! 'mink-set-scale)

;; S(x) lies in S((-1).x)
(sp (make-wff (mkw-st '(x r) (list (list 'IN 'r (mkw-S 'x)))
                      (list 'IN 'r (mkw-S (mkw-act '(- 1) 'x))))))
(dk-peel!)
(mkw-parts!)
(let* ((y (mkw-elim! 'r 'x)) (m1 '(- 1)) (ny (mkw-act m1 y)))
  (mkw-inV! y)
  (mkw-real! m1)
  (dk-apply! mkw-sym y)
  (dk-have! (list '= (mkw-act m1 'x) (mkw-act 'r ny))
    (lambda ()
      (subst (list '= 'x (mkw-act 'r y)))
      (mkw-subst-rev! (dk-cite! 'rmod-act-mul 'm m1 'r y))
      (mkw-subst-rev! (dk-cite! 'rmod-act-mul 'm 'r m1 y))
      (subst (mkw-eq! (list '* m1 'r) (list '* 'r m1)))
      (mkw-real! (list '* 'r m1))
      (mkw-vtype! (mkw-act (list '* 'r m1) y))
      (rfl)))
  (dk-cite! 'mink-set-intro 'm 'cs (mkw-act m1 'x) 'r ny)
  (ass))
(mkw-qed! 'mink-set-neg)

;; every positive real is in S(0)
(sp (make-wff (mkw-st-g '(r) '((IN r RR) (< 0 r)) (list 'IN 'r (mkw-S mkw-z)))))
(dk-peel!)
(mkw-parts!)
(dk-have! (list '= mkw-z (mkw-act 'r mkw-z))
  (lambda () (subst (dk-cite! 'rmod-act-vzero 'm 'r)) (dk-cite! 'module-vzero-in 'm) (rfl)))
(dk-cite! 'mink-set-intro 'm 'cs mkw-z 'r mkw-z)
(ass)
(mkw-qed! 'mink-set-zero)

;; S(x) + S(y) lies in S(x + y): the convexity step
(sp (make-wff (mkw-st-g '(x y r s) (list (list 'IN 'r (mkw-S 'x)) (list 'IN 's (mkw-S 'y)))
                      (list 'IN '(+ r s) (mkw-S (mkw-add 'x 'y))))))
(dk-peel!)
(mkw-parts!)
(let* ((a (mkw-elim! 'r 'x)) (b (mkw-elim! 's 'y)) (c '(+ r s)))
  (mkw-inV! a) (mkw-inV! b)
  (mkw-real! c)
  (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(< 0 r) '(< 0 s) '(IN r RR) '(IN s RR))))
  (mkw-nz! c)
  (mkw-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (dk-cite! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-inverse c)
  (dk-cite! 'rr-recip-pos c)
  (let* ((q (dk-name! (list 'recip c)))
         (cq (list '* c q)) (t (list '* 's q)) (u (list '- 1 t)))
    (dk-have! (list '= cq 1) (lambda () (subst (list '= q (list 'recip c))) (ass)))
    (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip c))) (ass)))
    (mkw-real! t) (mkw-real! u)
    (dk-have! (list '= u (list '* 'r q))
      (lambda () (subst (list '= 1 cq)) (crs)))
    ;; 0 <= t <= 1
    (let ((h2 (dk-cite! 'mink-rr-mul-pos 's q)))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! h2 (list 'IN t 'RR)))))
    (dk-have! (list '<= 's c) (lambda () (dk-ineq! '(< 0 r) '(IN r RR) '(IN s RR))))
    (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q) (list 'IN q 'RR))))
    (let* ((h (dk-cite! 'mink-rr-scale-le 's c q))
           (e2 (mkw-eq! (list '* q 's) t))
           (h2 (dk-rewrite-h! h (list '* q 's) t))
           (e3 (mkw-eq! (list '* q c) cq))
           (h3 (dk-rewrite-h! h2 (list '* q c) cq))
           (h4 (dk-rewrite-h! h3 cq 1)))
      #t)
    ;; the convex combination
    (let* ((zt (mkw-add (mkw-act u a) (mkw-act t b)))
           (mem (dk-apply! mkw-cvx a b t)))
      (mkw-vtype! zt)
      (dk-have! (list '= (mkw-add 'x 'y) (mkw-act c zt))
        (lambda ()
          (subst (list '= 'x (mkw-act 'r a)))
          (subst (list '= 'y (mkw-act 's b)))
          (mkw-vtype! (mkw-act u a)) (mkw-vtype! (mkw-act t b))
          (subst (dk-cite! 'rmod-act-distrib 'm c (mkw-act u a) (mkw-act t b)))
          (mkw-subst-rev! (dk-cite! 'rmod-act-mul 'm c u a))
          (mkw-subst-rev! (dk-cite! 'rmod-act-mul 'm c t b))
          (dk-have! (list '= (list '* c u) 'r)
            (lambda () (subst (list '= u (list '* 'r q)))
                       (subst (mkw-eq! (list '* c (list '* 'r q)) (list '* 'r cq)))
                       (subst (list '= cq 1)) (crs)))
          (dk-have! (list '= (list '* c t) 's)
            (lambda () (subst (mkw-eq! (list '* c t) (list '* 's cq)))
                       (subst (list '= cq 1)) (crs)))
          (subst (list '= (list '* c u) 'r))
          (subst (list '= (list '* c t) 's))
          (mkw-vtype! (mkw-add (mkw-act 'r a) (mkw-act 's b)))
          (rfl)))
      (dk-cite! 'mink-set-intro 'm 'cs (mkw-add 'x 'y) c zt)
      (ass))))
(mkw-qed! 'mink-set-sum)

;;; =====================================================================
;;; (5) THE INFIMA
;;; =====================================================================
(define (mkw-P x) (list 'INF (mkw-S x)))
(define (mkw-glb! z)   ; land the three glb facts of S(z); return (lb-clause . greatest-clause)
  (mkw-vtype! z)
  (if (not (dk-asm? (list 'IN (mkw-P z) 'RR)))
      (dk-split! (dk-cite! 'mink-set-glb 'm 'cs z)))
  (cons (dk-ctx-form (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (mkw-S z)) (list '<= (mkw-P z) 'lbw_))))
        (dk-ctx-form (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR)
                       (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (mkw-S z)) '(<= lbb_ lbw_)))
                             (list '<= 'lbb_ (mkw-P z))))))))
;; b is a lower bound of S(z), proved by LB! on each element (focus on (<= b w), w in S(z) landed)
(define (mkw-lower-bound! z b lb!)
  (let ((lbf (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (mkw-S z)) (list '<= b 'lbw_)))))
    (dk-have! lbf (lambda () (let ((w (dk-di-var!))) (lb! w))))
    lbf))
(define (mkw-glb-le! z b lb!)   ; land b <= INF S(z)
  (let ((g (cdr (mkw-glb! z))))
    (mkw-real! b)
    (mkw-lower-bound! z b lb!)
    (dk-apply! g b)))
(define (mkw-inf-le! z w)       ; w in S(z) in context: land INF S(z) <= w
  (dk-apply! (car (mkw-glb! z)) w))

(sp (make-wff (mkw-st-g '(z) (list (list 'IN 'z mkw-V)) (list '<= 0 (mkw-P 'z)))))
(dk-peel!)
(mkw-real! 0)
(mkw-glb-le! 'z 0 (lambda (w) (mkw-pos! 'z w) (dk-ineq! (list '< 0 w) (list 'IN w 'RR))))
(ass)
(mkw-qed! 'mink-inf-nonneg)

(sp (make-wff (mkw-st-g '(x y) (list (list 'IN 'x mkw-V) (list 'IN 'y mkw-V))
                      (list '<= (mkw-P (mkw-add 'x 'y)) (list '+ (mkw-P 'x) (mkw-P 'y))))))
(dk-peel!)
(mkw-parts!)
(let* ((xy (mkw-add 'x 'y)) (pp (mkw-P xy)) (pa (mkw-P 'x)) (pb (mkw-P 'y)))
  (mkw-glb! xy) (mkw-glb! 'x) (mkw-glb! 'y)
  ;; for s in S(y): P - s <= A
  (dk-have! (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (mkw-S 'y)) (list '<= (list '- pp 'sv_) pa)))
    (lambda ()
      (let ((sv (dk-di-var!)))
        (mkw-pos! 'y sv)
        (mkw-glb-le! 'x (list '- pp sv)
          (lambda (r)
            (mkw-pos! 'x r)
            (dk-cite! 'mink-set-sum 'm 'cs 'x 'y r sv)
            (let ((h (mkw-inf-le! xy (list '+ r sv))))
              (dk-ineq! h (list 'IN pp 'RR) (list 'IN r 'RR) (list 'IN sv 'RR)))))
        (ass))))
  (let ((c1 (dk-ctx-form (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (mkw-S 'y)) (list '<= (list '- pp 'sv_) pa))))))
    (mkw-glb-le! 'y (list '- pp pa)
      (lambda (sv)
        (let ((h (dk-apply! c1 sv)))
          (mkw-pos! 'y sv)
          (dk-ineq! h (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN sv 'RR)))))
    (dk-ineq! (list '<= (list '- pp pa) pb) (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN pb 'RR))))
(mkw-qed! 'mink-inf-subadditive)

(sp (make-wff (mkw-st-g '(x c) (list (list 'IN 'x mkw-V) '(IN c RR) '(< 0 c))
                      (list '= (mkw-P (mkw-act 'c 'x)) (list '* 'c (mkw-P 'x))))))
(dk-peel!)
(mkw-parts!)
(let* ((cx (mkw-act 'c 'x)) (pq (mkw-P cx)) (pa (mkw-P 'x)) (rc '(recip c)))
  (mkw-glb! cx) (mkw-glb! 'x)
  (mkw-nz! 'c)
  (mkw-and! '(IN c RR) '(NOT (= c 0)))
  (dk-cite! 'rr-recip-closed 'c)
  (dk-cite! 'rr-recip-pos 'c)
  ;; Q <= c A
  (let ((h (mkw-glb-le! 'x (list '* rc pq)
             (lambda (r)
               (mkw-pos! 'x r)
               (dk-cite! 'mink-set-scale 'm 'cs 'x 'c r)
               (let ((h1 (mkw-inf-le! cx (list '* 'c r))))
                 (dk-cite! 'mink-rr-div-ge r pq 'c)
                 (ass))))))
    (dk-cite! 'mink-rr-ge-div pa pq 'c))
  ;; c A <= Q
  (let ((ca (list '* 'c pa)))
    (mkw-glb-le! cx ca
      (lambda (sv)
        (mkw-pos! cx sv)
        (let* ((m1 (dk-cite! 'mink-set-scale 'm 'cs cx rc sv))
               (e (dk-cite! 'rmod-act-recip-cancel 'm 'c 'x))
               (m2 (dk-rewrite-h! m1 (mkw-act rc cx) 'x))
               (h1 (mkw-inf-le! 'x (list '* rc sv))))
          (dk-cite! 'mink-rr-le-div pa sv 'c)
          (ass))))
    (mkw-and! (list 'IN pq 'RR) (list 'IN ca 'RR))
    (mkw-and! (list '<= pq ca) (list '<= ca pq))
    (dk-cite! 'rr-leq-antisymmetric pq ca)
    (ass)))
(mkw-qed! 'mink-inf-scale)

(sp (make-wff (mkw-st-g '() '() (list '= (mkw-P mkw-z) 0))))
(dk-peel!)
(mkw-parts!)
(dk-cite! 'module-vzero-in 'm)
(let ((p0 (mkw-P mkw-z)))
  (mkw-glb! mkw-z)
  (dk-cite! 'mink-inf-nonneg 'm 'cs mkw-z)
  (dk-have! (list 'FORALL 'd_ (list 'IMPLIES '(POS-RR d_) (list '<= p0 '(+ 0 d_))))
    (lambda ()
      (dk-peel!)
      (dk-cite! 'rr-pos-rr-in-rr 'd_)
      (dk-cite! 'rr-lt-of-pos-rr 'd_)
      (dk-cite! 'mink-set-zero 'm 'cs 'd_)
      (let ((h (mkw-inf-le! mkw-z 'd_)))
        (dk-ineq! h (list 'IN p0 'RR) '(IN d_ RR)))))
  (dk-cite! 'rr-zero-in)
  (dk-cite! 'rr-le-of-le-add-all-pos p0 0)
  (mkw-and! (list 'IN p0 'RR) '(IN 0 RR))
  (mkw-and! (list '<= p0 0) (list '<= 0 p0))
  (dk-cite! 'rr-leq-antisymmetric p0 0)
  (ass))
(mkw-qed! 'mink-inf-zero)

(sp (make-wff (mkw-st '(x) (list (list 'IN 'x mkw-V)) (list '<= (mkw-P (mkw-act '(- 1) 'x)) (mkw-P 'x)))))
(dk-peel!)
(mkw-parts!)
(let* ((nx (mkw-act '(- 1) 'x)) (pn (mkw-P nx)))
  (mkw-glb! nx)
  (mkw-glb-le! 'x pn
    (lambda (r)
      (dk-cite! 'mink-set-neg 'm 'cs 'x r)
      (mkw-inf-le! nx r)
      (ass)))
  (ass))
(mkw-qed! 'mink-inf-neg-le)

(sp (make-wff (mkw-st '(x) (list (list 'IN 'x mkw-V)) (list '= (mkw-P (mkw-act '(- 1) 'x)) (mkw-P 'x)))))
(dk-peel!)
(mkw-parts!)
(let* ((m1 '(- 1)) (nx (mkw-act m1 'x)) (pn (mkw-P nx)) (pa (mkw-P 'x)))
  (mkw-real! m1)
  (mkw-vtype! nx)
  (dk-cite! 'mink-inf-neg-le 'm 'cs 'x)
  (let* ((h (dk-cite! 'mink-inf-neg-le 'm 'cs nx))
         (e1 (dk-cite! 'rmod-act-mul 'm m1 m1 'x))
         (h2 (dk-rewrite-h! h (mkw-act m1 nx) (mkw-act (list '* m1 m1) 'x)))
         (e2 (dk-have! (list '= (list '* m1 m1) 1) (lambda () (arith))))
         (h3 (dk-rewrite-h! h2 (list '* m1 m1) 1))
         (e3 (dk-cite! 'rmod-act-one 'm 'x))
         (h4 (dk-rewrite-h! h3 (mkw-act 1 'x) 'x)))
    (mkw-glb! nx) (mkw-glb! 'x)
    (mkw-and! (list 'IN pn 'RR) (list 'IN pa 'RR))
    (mkw-and! (list '<= pn pa) (list '<= pa pn))
    (dk-cite! 'rr-leq-antisymmetric pn pa)
    (ass)))
(mkw-qed! 'mink-inf-neg)

(sp (make-wff (mkw-st '(x lm) (list (list 'IN 'x mkw-V) '(IN lm RR))
                      (list '= (mkw-P (mkw-act 'lm 'x)) (list '* '(abs lm) (mkw-P 'x))))))
(dk-peel!)
(mkw-parts!)
(let ((pa (mkw-P 'x)))
  (mkw-glb! 'x)
  (dk-cite! 'rr-zero-in)
  (dk-cite! 'rr-lt-trichotomy 'lm 0)
  (use-em '(< 0 lm)
    (lambda ()
      (dk-have! '(<= 0 lm) (lambda () (dk-ineq! '(< 0 lm) '(IN lm RR))))
      (subst (dk-cite! 'rr-abs-of-nonneg 'lm))
      (dk-cite! 'mink-inf-scale 'm 'cs 'x 'lm)
      (ass))
    (lambda ()
      (use-em '(= lm 0)
        (lambda ()
          (subst '(= lm 0))
          (subst (dk-cite! 'rmod-act-zero 'm 'x))
          (subst (dk-cite! 'mink-inf-zero 'm 'cs))
          (fact 'rr-abs-zero-value)
          (subst '(= (abs 0) 0))
          (crs))
        (lambda ()
          (dk-have! '(< lm 0) (lambda () (dk-only! (dk-ctx-form '(OR (< lm 0) (OR (= lm 0) (< 0 lm))))
                                                   '(NOT (< 0 lm)) '(NOT (= lm 0)))
                                         (prop)))
          (let* ((ml '(- lm)) (m1 '(- 1)) (nx (mkw-act m1 'x)))
            (mkw-real! ml) (mkw-real! m1) (mkw-vtype! nx)
            (dk-have! (list '< 0 ml) (lambda () (dk-ineq! '(< lm 0) '(IN lm RR))))
            (dk-have! (list '= 'lm (list '* ml m1)) (lambda () (crs)))
            (mkw-real! (list '* ml m1))
            (mkw-vtype! (mkw-act 'lm 'x))
            (dk-congr! (list '= 'lm (list '* ml m1)) (lambda (t) (mkw-act t 'x)))
            (subst (list '= (mkw-act 'lm 'x) (mkw-act (list '* ml m1) 'x)))
            (subst (dk-cite! 'rmod-act-mul 'm ml m1 'x))
            (subst (dk-cite! 'mink-inf-scale 'm 'cs nx ml))
            (subst (dk-cite! 'mink-inf-neg 'm 'cs 'x))
            (subst (dk-cite! 'rr-abs-of-neg 'lm))
            (rfl)))))))
(mkw-qed! 'mink-inf-homogeneous)

;;; =====================================================================
;;; (6) Prop 2.29: p_V IS A SEMINORM
;;; =====================================================================
(define mkw-pfn '(MINKOWSKI-FUNCTIONAL m cs))
(define (mkw-pval! z)   ; rewrite (p z) to INF S(z) in the goal
  (mkw-vtype! z)
  (subst (list '= (list mkw-pfn z) (mkw-P z)))
  #t)
(define (mkw-pval-cite! z)
  (mkw-vtype! z)
  (dk-cite! 'mink-value 'm 'cs z))

(sp (make-wff (forall-guarded '(m cs) mkw-H (list 'IS-SEMINORM 'RR-NORMED-FIELD 'm mkw-pfn))))
(dk-peel!)
(mkw-parts!)
(dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
(mac 'is-seminorm)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 20)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IS-NORMED-FIELD) (dk-cite! 'rr-is-normed-field) (ass))
        ((dk-head-is? g 'IN)
         (mac 'MINKOWSKI-FUNCTIONAL)
         (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (mkw-glb! v) (ass)))
                       (lambda () (ass))))
        ((or (dk-head-is? g 'IS-MODULE) (dk-head-is? g '=)) (ass))
        (#t
         (let* ((landed (dk-peel!)) (g2 (dk-goal)))
           (cond
             ((and (dk-head-is? g2 '<=) (eqv? (cadr g2) 0))
              (let ((z (cadr (caddr g2))))
                (mkw-pval-cite! z) (mkw-pval! z)
                (dk-cite! 'mink-inf-nonneg 'm 'cs z) (ass)))
             ((dk-head-is? g2 '<=)
              (let* ((xy (cadr (cadr g2))) (a (cadr xy)) (b (caddr xy)))
                (for-each (lambda (z) (mkw-pval-cite! z) (mkw-pval! z)) (list xy a b))
                (dk-cite! 'mink-inf-subadditive 'm 'cs a b) (ass)))
             (#t
              (let* ((lhs (cadr g2)) (ax (cadr lhs)) (lm (cadr ax)) (z (caddr ax)))
                (dk-cite! 'rr-scalar-ring-carr)
                (dk-have! (list 'IN lm 'RR)
                  (lambda () (dk-rewrite-h! (dk-ctx-form (list 'IN lm '(CARR (SCAL m)))) '(SCAL m) mkw-ring)
                             (dk-rewrite-h! (dk-ctx-form (list 'IN lm (list 'CARR mkw-ring))) (list 'CARR mkw-ring) 'RR)
                             (ass)))
                (subst (dk-cite! 'rr-nf-fnrm-apply lm))
                (mkw-pval-cite! ax) (mkw-pval! ax)
                (mkw-pval-cite! z) (mkw-pval! z)
                (dk-cite! 'mink-inf-homogeneous 'm 'cs z lm) (ass)))))))))
  (dk-open-leaves))
(mkw-qed! 'minkowski-functional-is-seminorm)
