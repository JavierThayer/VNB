;;; la-z-elem.scm -- over a euclidean ring an invertible matrix is a product of
;;; elementary matrices; over Z this is linear algebra 3.38 (LA-Z, 2026-10-19).
;;;
;;; Vocabulary: structure-library/la-elem-vocab.scm (IS-ELEMENTARY, ELEM-GEN).  Prefix lze-.
;;;
;;; PLAN.  The notes derive 3.38 from the normal form (3.36 / 3.37).  The proof here is
;;; the reduction those rest on, run on the whole n-by-n matrix with an induction on the
;;; number t of rows and columns already reduced.  INVARIANT IDP(B, t): every entry of B
;;; in a row <= t or a column <= t is the identity's.  STEP (row r = t + 1): Euclid's
;;; algorithm on row r by column operations F, G among the columns >= r leaves a single
;;; nonzero entry b = B_rr in row r (lze-pair: one column cleared, by descent on the
;;; euclidean gauge of B_rr; lze-row: all of them); the determinant, a unit, is then
;;; b det(minor) (expansion along row r), so b is a unit; H scales it to 1; row
;;; operations G clear the rest of column r (lze-col).  None of these moves an entry of
;;; IDP(B, t).  At t = n the matrix is I, so P U Q = I with P, Q products of elementary
;;; matrices and U = Q^-1 P^-1 is one too.  The determinant of a product of elementary
;;; matrices is a unit (elem-gen-det-unit), which carries the invariant "det is a
;;; unit" through the steps; an invertible matrix has a unit determinant.
;;;
;;; LOAD WINDOW: after "theorem-library/la-elem-gen" (unwired: laeg-op-f/g/h-agree,
;;; elem-gen-*, elementary-*) and "theorem-library/la-det-adjoint" (unwired:
;;; ladet-sign-even); latest wired citation det-elem-h-col (det-transpose, load.scm:2103).
;;; Nothing cites the file.  Library: linear-algebra.

(define (lze-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z-elem: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))
(define (lze-iv n) (list 'INTERVAL 1 n))
(define (lze-mm a b) (list 'MATMUL 'R a b))
(define (lze-contra! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
(define (lze-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;; skolemise a (possibly nested) existential in context; return its witnesses in order
(define (lze-skolem-all! ex)
  (let loop ((ex ex) (acc '()))
    (let* ((v #f)
           (landed (dk-landed (lambda () (set! v (dk-skolem! ex)))))
           (nxt (find-first (dk-head? 'FORSOME) landed)))
      (if nxt (loop nxt (append acc (list v))) (append acc (list v))))))
;; detach every antecedent of the chain INST, proving those not in context with
;; (PROVER ANTE) on a lane; returns the consequent as it landed
(define (lze-detach-all! inst prover)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (lambda () (prover a))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f)) (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lze-assoc! d1 d2 d3 d4 p q x)
  (lze-detach-all! (dk-cite! 'matmul-assoc 'R d1 d2 d3 d4 p q x) (lambda (a) (prop))))
(define (lze-peel-guards!)
  (di)
  (let loop () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (loop)))))

;; the sizes of a matrix X typed (IN X (MAT m k (CARR R))) in context
(define (lze-mat-of X)
  (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) X)
                                        (pair? (caddr f)) (eq? (car (caddr f)) 'MAT)
                                        (equal? (cadddr (caddr f)) '(CARR R))))
                       (dk-asms))))
    (if (not f) (error "lze-mat-of: matrix not typed" (expression->string X)))
    (caddr f)))
;; land (IN E NN) for E built of succ, +, numerals, variables typed in NN or an interval
(define (lze-nn! e)
  (cond ((dk-asm? (list 'IN e 'NN)) #t)
        ((and (pair? e) (eq? (car e) 'succ)) (lze-nn! (cadr e)) (fact 'nn-succ-closed (cadr e)))
        ((and (pair? e) (eq? (car e) '+))
         (lze-nn! (cadr e)) (lze-nn! (caddr e))
         (dk-have! (list 'AND (list 'IN (cadr e) 'NN) (list 'IN (caddr e) 'NN))
           (lambda () (dk-conj-close! (lambda () (ass)))))
         (fact 'nn-add-closed (cadr e) (caddr e)))
        ((number? e) (dk-have! (list 'IN e 'NN) (lambda () (arith))))
        ((symbol? e)
         (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (cadr f) e)
                                               (pair? (caddr f)) (eq? (car (caddr f)) 'INTERVAL)))
                              (dk-asms))))
           (if (not f) (error "lze-nn!: untyped" e))
           (fact 'interval-elt-in-nn (cadr (caddr f)) (caddr (caddr f)) e)))
        (#t (error "lze-nn!: cannot type" (expression->string e))))
  (if (not (dk-asm? (list 'IN e 'NN))) (error "lze-nn!: did not land" (expression->string e))))
(define lze-mmon '(RING-MULTIPLICATIVE-MONOID R))
(define lze-neg1 '((NEG R) (ONE R)))
(define (lze-sign e) (list 'MPOW lze-mmon lze-neg1 e))
;; land (IN T (CARR R)) for T built of ENTRY, DET, the sign, ADD, MUL, NEG, ONE, ZERO
(define (lze-carr! t)
  (cond ((dk-asm? (list 'IN t '(CARR R))) #t)
        ((and (pair? t) (eq? (car t) 'ENTRY))
         (let ((M (lze-mat-of (cadr t))))
           (fact 'entry-in-carrier (cadr M) (caddr M) '(CARR R) (cadr t) (caddr t) (cadddr t))))
        ((equal? t '(ONE R)) (fact 'ring-one-in 'R))
        ((equal? t '(ZERO R)) (fact 'ring-zero-in 'R))
        ((and (pair? t) (equal? (car t) '(NEG R)))
         (lze-carr! (cadr t)) (fact 'ring-neg-in-carr 'R (cadr t)))
        ((and (pair? t) (eq? (car t) 'MPOW) (equal? (cadr t) lze-mmon) (equal? (caddr t) lze-neg1))
         (lze-nn! (cadddr t)) (fact 'dtr-sign-type 'R (cadddr t)))
        ((and (pair? t) (eq? (car t) 'DET))
         (let ((sz (caddr t)) (mx (cadddr t)))
           (if (and (pair? mx) (eq? (car mx) 'MINOR))
               (begin (lze-nn! (caddr mx)) (lze-nn! (cadddr mx)) (lze-nn! sz)
                      (fact 'minor-type 'R (cadr mx) (caddr mx) (cadddr mx) sz)))
           (if (not (dk-asm? (list 'IN mx (list 'MAT sz sz '(CARR R)))))
               (dk-have! (list 'IN mx (list 'MAT sz sz '(CARR R))) dk-typ-close!))
           (fact 'det-in-carrier 'R sz mx)))
        ((and (pair? t) (equal? (car t) '(ADD R)))
         (lze-carr! (cadr t)) (lze-carr! (caddr t))
         (fact 'ring-add-closed 'R (cadr t) (caddr t)))
        ((and (pair? t) (equal? (car t) '(MUL R)))
         (lze-carr! (cadr t)) (lze-carr! (caddr t))
         (fact 'ring-carrier-closed-mul 'R (cadr t) (caddr t)))
        (#t (error "lze-carr!: cannot type" (expression->string t))))
  (if (not (dk-asm? (list 'IN t '(CARR R)))) (error "lze-carr!: did not land" (expression->string t))))
(define (lze-close-carr!)
  (let ((g (dk-goal)))
    (cond ((and (eq? (car g) 'IN) (equal? (caddr g) '(CARR R))) (lze-carr! (cadr g)) (ass))
          ((and (eq? (car g) 'IN) (eq? (caddr g) 'SET))
           (lze-carr! (cadr g)) (fact 'membership-implies-sethood (cadr g) '(CARR R)) (ass))
          ((eq? (car g) '=) (lze-carr! (cadr g)) (rfl))
          (#t (error "lze-close-carr!: unexpected goal" (expression->string g))))))
(define (lze-fun-type! lam)
  (let ((dom (caddr lam)))
    (dk-have! (list 'IN lam (list 'FUN dom '(CARR R)))
      (lambda ()
        (dk-lam-type! (lambda () (dk-peel!) (lze-beta!) (lze-close-carr!))
                      (lambda () (fact 'interval-in-set (cadr dom) (caddr dom)) (ass)))))))
;; (IN X (INTERVAL A B)) for an NN term X with A <= X <= B decided by dk-nn!
(define (lze-in-iv! x a b . prems)
  (if (not (dk-asm? (list 'IN x (list 'INTERVAL a b))))
      (dk-have! (list 'IN x (list 'INTERVAL a b))
        (lambda ()
          (lze-nn! x)
          (dk-have! (list '<= a x) (lambda () (apply dk-nn! prems)))
          (dk-have! (list '<= x b) (lambda () (apply dk-nn! prems)))
          (fact 'interval-mem-intro a b x)
          (ass)))))
(define (lze-iv-facts! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))

;; "det X is a unit"
(define (lze-unit d) (list 'FORSOME 'dus_ (list 'AND '(IN dus_ (CARR R)) (list '= (list '(MUL R) d 'dus_) '(ONE R)))))

;; the case analysis on IS-ELEMENTARY(R, SZ, E): the thunks get the witnesses (k l),
;; (r k l), (r k s)
(define (lze-elem-cases! sz e f-thunk g-thunk h-thunk)
  (let* ((hyp (list 'IS-ELEMENTARY 'R sz e))
         (ignore (fact 'IS-ELEMENTARY 'R sz e))
         (iff (iff-for hyp))
         (disj (caddr iff))
         (d1 (cadr disj)) (d2 (cadr (caddr disj))) (d3 (caddr (caddr disj))))
    (dk-have! disj (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (use-cases disj
      (lambda () (f-thunk (lze-skolem-all! (dk-ctx-form d1))))
      (lambda () (g-thunk (lze-skolem-all! (dk-ctx-form d2))))
      (lambda () (h-thunk (lze-skolem-all! (dk-ctx-form d3)))))))
;; the minimal-set induction over ELEM-GEN (la-elem-gen's laeg-induct!, size a parameter)
(define (lze-induct! sz body p ident-thunk step-thunk)
  (let* ((mt (list 'MAT sz sz '(CARR R)))
         (id (list 'IDENTMAT 'R sz))
         (S (list 'SEP 'egq_ mt body))
         (cl (list 'FORALL 'egy_ (list 'IMPLIES (list 'IN 'egy_ S)
               (list 'FORALL 'egf_ (list 'IMPLIES (list 'IS-ELEMENTARY 'R sz 'egf_)
                 (list 'IN '(MATMUL R egy_ egf_) S)))))))
    (if (not (dk-asm? (list 'IN id mt))) (dk-have! (list 'IN id mt) dk-typ-close!))
    (dk-have! (list 'IN id S) (lambda () (in-sep! (lambda () (ass)) ident-thunk)))
    (dk-have! cl
      (lambda ()
        (let* ((l3 (dk-peel!))
               (xm (find-first (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) S))) l3))
               (ef (find-first (dk-head? 'IS-ELEMENTARY) l3))
               (x (cadr xm)) (e (cadddr ef)))
          (sep-me xm)
          (fact 'elementary-type 'R sz e)
          (if (not (dk-asm? (list 'IN (lze-mm x e) mt))) (dk-have! (list 'IN (lze-mm x e) mt) dk-typ-close!))
          (in-sep! (lambda () (ass)) (lambda () (step-thunk x e))))))
    (let ((all (dk-fact! 'elem-gen-induction 'R sz S)))
      (dk-apply! all p)
      (sep-me (list 'IN p S)))))

;;; =====================================================================
;;; (1) Ring rearrangements (crs) and the determinant of a product of elementary
;;; matrices.
;;; =====================================================================
(define (lze-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
(define (lze-ring-lemma! name vs eq)
  (sp (make-wff (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
                  (forall-guarded vs (lze-carr-guards vs) eq)))))
  (dk-peel!)
  (crs)
  (lze-done! name)
  (topic! name 'plumbing))
(lze-ring-lemma! 'lze-ring-neg '(lea_ les_)
  '(= ((MUL R) ((MUL R) lea_ ((NEG R) (ONE R))) ((NEG R) les_)) ((MUL R) lea_ les_)))
(lze-ring-lemma! 'lze-ring-one '(lea_ les_)
  '(= ((MUL R) ((MUL R) lea_ (ONE R)) les_) ((MUL R) lea_ les_)))
(lze-ring-lemma! 'lze-ring-four '(lea_ ler_ les_ let_)
  '(= ((MUL R) ((MUL R) lea_ ler_) ((MUL R) les_ let_)) ((MUL R) ((MUL R) lea_ les_) ((MUL R) ler_ let_))))
(lze-ring-lemma! 'lze-ring-assoc '(lea_ ler_ les_)
  '(= ((MUL R) lea_ ((MUL R) ler_ les_)) ((MUL R) ((MUL R) lea_ ler_) les_)))

;; the product of two units is a unit: (a s)(b t) = 1 from a s = 1, b t = 1
(sp (make-wff (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
  (forall-guarded '(lea_ ler_ les_ let_) (append (lze-carr-guards '(lea_ ler_ les_ let_))
                                           '((= ((MUL R) lea_ les_) (ONE R)) (= ((MUL R) ler_ let_) (ONE R))))
    '(= ((MUL R) ((MUL R) lea_ ler_) ((MUL R) les_ let_)) (ONE R)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'lze-ring-four 'R 'lea_ 'ler_ 'les_ 'let_)
(subst '(= ((MUL R) ((MUL R) lea_ ler_) ((MUL R) les_ let_)) ((MUL R) ((MUL R) lea_ les_) ((MUL R) ler_ let_))))
(subst '(= ((MUL R) lea_ les_) (ONE R)))
(subst '(= ((MUL R) ler_ let_) (ONE R)))
(fact 'ring-one-in 'R)
(fact 'ring-mul-left-id 'R '(ONE R))
(ass)
(lze-done! 'lze-unit-mul)
(topic! 'lze-unit-mul 'plumbing)

;; det of a member of ELEM-GEN is a unit
(sp (make-wff (forall-guarded '(R n P) '((IS-COMMUTATIVE-RING R) (IN n NN) (IN P (ELEM-GEN R n)))
                (lze-unit '(DET R n P)))))
(lze-peel-guards!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-one-in 'R)
(lze-induct! 'n (lze-unit '(DET R n egq_)) 'P
  (lambda ()
    (fact 'det-identity-ind 'R 'n)
    (ew '(ONE R))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN) (ass)
            (begin (subst '(= (DET R n (IDENTMAT R n)) (ONE R)))
                   (fact 'ring-mul-left-id 'R '(ONE R)) (ass))))))
  (lambda (x e)
    (let* ((s (dk-skolem! (dk-ctx-form (lze-unit (list 'DET 'R 'n x))) #t))
           (dx (list 'DET 'R 'n x)) (xe (lze-mm x e)))
      (fact 'elementary-type 'R 'n e)
      (lze-carr! dx)
      (fact 'det-multiplicative 'R 'n x e)
      (subst (list '= (list 'DET 'R 'n xe) (list '(MUL R) dx (list 'DET 'R 'n e))))
      (lze-elem-cases! 'n e
        (lambda (ws)
          (let* ((k (car ws)) (l (cadr ws)))
            (subst (list '= e (list 'ELEM-F 'R 'n k l)))
            (subst (dk-fact! 'det-elem-f 'R 'n k l))
            (lze-carr! (list '(NEG R) s))
            (ew (list '(NEG R) s))
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (begin (subst (dk-fact! 'lze-ring-neg 'R dx s)) (ass)))))))
        (lambda (ws)
          (let* ((r (car ws)) (k (cadr ws)) (l (caddr ws)))
            (subst (list '= e (list 'ELEM-G 'R 'n r k l)))
            (subst (dk-fact! 'det-elem-g 'R 'n r k l))
            (ew s)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (begin (subst (dk-fact! 'lze-ring-one 'R dx s)) (ass)))))))
        (lambda (ws)
          (let* ((r (car ws)) (k (cadr ws)) (u (caddr ws)))
            (subst (list '= e (list 'ELEM-H 'R 'n r k)))
            (subst (dk-fact! 'det-elem-h 'R 'n r k))
            (lze-carr! (list '(MUL R) s u))
            (ew (list '(MUL R) s u))
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (begin (fact 'lze-unit-mul 'R dx r s u) (ass)))))))))))
(ass)
(lze-done! 'elem-gen-det-unit)
(topic! 'elem-gen-det-unit 'algebra)
(gloss! 'elem-gen-det-unit "The determinant of a product of elementary matrices over a commutative ring is a unit.")

;;; =====================================================================
;;; (2) Expansion along a row with a single nonzero entry.
;;; =====================================================================
(sp (make-wff (forall-guarded '(R n B rw)
                '((IS-COMMUTATIVE-RING R) (IN n NN) (IN B (MAT (succ n) (succ n) (CARR R)))
                  (IN rw (INTERVAL 1 (succ n)))
                  (FORALL frj_ (IMPLIES (IN frj_ (INTERVAL 1 (succ n)))
                    (IMPLIES (NOT (= frj_ rw)) (= (ENTRY B rw frj_) (ZERO R))))))
                '(= (DET R (succ n) B) ((MUL R) (ENTRY B rw rw) (DET R n (MINOR B rw rw n)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-succ-closed 'n)
(lze-iv-facts! 'rw 1 '(succ n))
(let* ((s1 '(succ n)) (I1 (lze-iv s1))
       (E (dk-fact! 'det-expand-row 'R 'n 'B 'rw))
       (L (caddr (caddr E)))
       (hyp '(FORALL frj_ (IMPLIES (IN frj_ (INTERVAL 1 (succ n)))
               (IMPLIES (NOT (= frj_ rw)) (= (ENTRY B rw frj_) (ZERO R)))))))
  (subst E)
  (lze-fun-type! L)
  (let ((Z (list 'FORALL 'dgj_ (list 'IMPLIES (list 'IN 'dgj_ I1)
             (list 'IMPLIES '(NOT (= dgj_ rw)) (list '= (list L 'dgj_) '(ZERO R)))))))
    (dk-have! Z
      (lambda ()
        (dk-peel!)
        (let ((v (cadr (cadr (dk-goal)))))
          (lze-iv-facts! v 1 s1)
          (lze-beta!)
          (subst (dk-apply! hyp v))
          (let* ((g (dk-goal)) (sg (cadr (cadr g))) (dt (caddr (caddr (cadr g)))))
            (lze-carr! dt)
            (lze-carr! sg)
            (subst (dk-fact! 'ring-mul-zero-left 'R dt))
            (subst (dk-fact! 'ring-mul-zero-right 'R sg))
            (lze-close-carr!))))))
  (fact 'interval-in-set 1 s1)
  (fact 'interval-card-in-nn 1 s1)
  (subst (dk-fact! 'finsum-single-support-ring-additive-ag 'R I1 L 'rw))
  (lze-beta!)
  (subst (dk-fact! 'ladet-sign-even 'rw 'R))
  (let ((x (list '(MUL R) '(ENTRY B rw rw) '(DET R n (MINOR B rw rw n)))))
    (lze-carr! x)
    (subst (dk-fact! 'ring-mul-left-id 'R x))
    (if (not (proof-done? *ps*)) (rfl))))
(lze-done! 'det-row-single)
(topic! 'det-row-single 'algebra)
(gloss! 'det-row-single "If row r of an (n+1)-square matrix vanishes off the diagonal, its determinant is b_rr times the minor at (r, r).")

;;; =====================================================================
;;; (3) The invariant and the column operations on the columns > t.
;;; ROWS(B): rows 1..t of B are rows of I (la-elem-gen's laeg-agree with bx := I, so
;;; that its laeg-op-*-agree lemmas apply); COLS(B): columns 1..t of B are columns of I.
;;; =====================================================================
(define lze-I '(IDENTMAT R n))
(define lze-r '(succ t))
(define (lze-rows* b tt)
  (list 'FORALL 'agi_ (list 'IMPLIES (list 'IN 'agi_ (list 'INTERVAL 1 tt))
    (list 'FORALL 'agj_ (list 'IMPLIES '(IN agj_ (INTERVAL 1 n))
      (list '= (list 'ENTRY b 'agi_ 'agj_) (list 'ENTRY lze-I 'agi_ 'agj_)))))))
(define (lze-cols* b tt)
  (list 'FORALL 'cgi_ (list 'IMPLIES '(IN cgi_ (INTERVAL 1 n))
    (list 'FORALL 'cgj_ (list 'IMPLIES (list 'IN 'cgj_ (list 'INTERVAL 1 tt))
      (list '= (list 'ENTRY b 'cgi_ 'cgj_) (list 'ENTRY lze-I 'cgi_ 'cgj_)))))))
(define (lze-rows b) (lze-rows* b 't))
(define (lze-cols b) (lze-cols* b 't))
(define lze-zr-I
  (list 'FORALL 'agi_ (list 'IMPLIES '(IN agi_ (INTERVAL 1 t))
    (list 'FORALL 'agj_ (list 'IMPLIES '(IN agj_ (INTERVAL 1 n))
      (list 'IMPLIES '(<= (succ t) agj_) (list '= (list 'ENTRY lze-I 'agi_ 'agj_) '(ZERO R))))))))
(define (lze-absurd! prems)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (dk-have! '(<= 1 0) (lambda () (apply dk-nn! prems)))
  (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
  (ai '(NOT (<= 1 0))))
(define (lze-ne! a b . prems)
  (let ((f (list 'NOT (list '= a b))))
    (if (not (dk-asm? f))
        (begin (lze-nn! a) (lze-nn! b)
               (dk-have! f (lambda () (apply dk-nn! prems)))))))
(define (lze-typ! t cls)
  (if (not (dk-asm? (list 'IN t cls)))
      (if (equal? cls '(CARR R)) (lze-carr! t) (dk-have! (list 'IN t cls) dk-typ-close!))))

;; from (NOT (<= A B)) in context, A, B in NN: land (<= (succ B) A)
(define (lze-not-le! a b)
  (lze-nn! a) (lze-nn! b)
  (if (not (dk-asm? (list '<= (list 'succ b) a))) (fact 'nn-not-le-succ-le a b)))
;; from (<= C (succ V)) and (NOT (= C (succ V))) in context: land (<= C V)
(define (lze-le-pred! c v)
  (lze-nn! c) (lze-nn! v)
  (if (not (dk-asm? (list '<= c v)))
      (dk-have! (list '<= c v)
        (lambda ()
          (let ((d (dk-cite! 'nn-le-succ-cases v c)))
            (use-cases d (lambda () (ass)) (lambda () (lze-contra! (list 'NOT (list '= c (list 'succ v)))))))))))
;; the IF resolver (la-z-sdet's lzs-if-all!): conditions decided by the context, or by
;; a syntactic identity; an undecided one is an ERROR here (the drivers decide first)
(define (lze-find-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)) (or (lze-find-if (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((lze-find-if (car l)))
                    (#t (loop (cdr l))))))))
(define (lze-nsym! a b)
  (di)
  (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl)))
  (ai (list 'NOT (list '= b a))))
(define (lze-if-branch! true? ift close-cond k)
  (let* ((c (cadr ift))
         (val (if true? (caddr ift) (cadddr ift)))
         (want (if true? c (list 'NOT c)))
         (opened (dk-opened (lambda () (if true? (if-true ift) (if-false ift)))))
         (conds (filter (lambda (l) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal-of l) want))))) opened))
         (mains (filter (lambda (l) (not (memq l conds))) opened)))
    (if (pair? conds)
        (begin (dk-focus! (car conds)) (if close-cond (close-cond) (ass))
               (if (not (sequent-node-grounded? (car conds)))
                   (error "lze-if-branch!: condition not established" (expression->string want)))))
    (if (pair? mains)
        (begin (dk-focus! (car mains)) (subst (list '= ift val)) (k)))))
(define (lze-if-all! closer)
  (let ((ift (lze-find-if (dk-goal))))
    (if (not ift)
        (closer)
        (let* ((c (cadr ift)) (k (lambda () (lze-if-all! closer))))
          (cond ((dk-asm? c) (lze-if-branch! #t ift #f k))
                ((dk-asm? (list 'NOT c)) (lze-if-branch! #f ift #f k))
                ((and (eq? (car c) '=) (equal? (cadr c) (caddr c))) (lze-if-branch! #t ift (lambda () (rfl)) k))
                ((and (eq? (car c) '=) (dk-asm? (list 'NOT (list '= (caddr c) (cadr c)))))
                 (lze-if-branch! #f ift (lambda () (lze-nsym! (cadr c) (caddr c))) k))
                ((and (eq? (car c) '=) (dk-asm? (list '= (caddr c) (cadr c))))
                 (lze-if-branch! #t ift (lambda () (subst (list '= (cadr c) (caddr c))) (rfl)) k))
                (#t (error "lze-if-all!: undecided condition" (expression->string c))))))))
(define (lze-close!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (lze-carr! (cadr g)) (rfl))
          (#t (error "lze-close!: cannot close" (expression->string g))))))

;; rows 1..t of I vanish in the columns > t
(sp (make-wff (forall-guarded '(R n t) '((IS-RING R) (IN n NN) (IN t NN) (<= t n)) lze-zr-I)))
(lze-peel-guards!)
(let* ((landed (dk-peel!))
       (im (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 t)))) landed))
       (jm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) landed))
       (i (cadr im)) (j (cadr jm)))
  (lze-iv-facts! i 1 't)
  (lze-iv-facts! j 1 'n)
  (fact 'interval-widen 't 'n 1 i)
  (lze-ne! i j (list '<= i 't) (list '<= '(succ t) j))
  (fact 'identmat-entry-off 'R 'n i j)
  (ass))
(lze-done! 'lze-zr-identity)
(topic! 'lze-zr-identity 'plumbing)

;; COLS survives a column operation on the columns > t
(define lze-cols-guards
  '((IS-RING R) (IN n NN) (IN t NN) (<= t n) (IN B (MAT n n (CARR R)))))
(define (lze-cols-op! act-name act-args)
  (let* ((landed (dk-peel!))
         (e (cadr (dk-goal)))
         (i (caddr e)) (j (cadddr e)))
    (lze-iv-facts! j 1 't)
    (fact 'interval-widen 't 'n 1 j)
    (subst (dk-apply! (apply dk-fact! act-name act-args) i j))
    (for-each (lambda (kk) (lze-ne! j kk (list '<= j 't) (list '<= '(succ t) kk)))
              (filter (lambda (v) (dk-asm? (list '<= '(succ t) v))) (filter (lambda (v) (memq v '(k l))) act-args)))
    (dk-apply! (lze-cols 'B) i j)
    (lze-if-all! lze-close!)))
(sp (make-wff (forall-guarded '(R n t B k l)
                (append lze-cols-guards (list (lze-cols 'B)
                  '(IN k (INTERVAL 1 n)) '(IN l (INTERVAL 1 n)) '(NOT (= k l)) '(<= (succ t) k) '(<= (succ t) l)))
                (lze-cols '(MATMUL R B (ELEM-F R n k l))))))
(lze-peel-guards!)
(lze-cols-op! 'elem-f-action '(R n n B k l))
(lze-done! 'lze-cols-f)
(topic! 'lze-cols-f 'plumbing)
(sp (make-wff (forall-guarded '(R n t B sc k l)
                (append lze-cols-guards (list (lze-cols 'B)
                  '(IN sc (CARR R)) '(IN k (INTERVAL 1 n)) '(IN l (INTERVAL 1 n)) '(NOT (= k l)) '(<= (succ t) l)))
                (lze-cols '(MATMUL R B (ELEM-G R n sc k l))))))
(lze-peel-guards!)
(lze-cols-op! 'elem-g-action '(R n n B sc k l))
(lze-done! 'lze-cols-g)
(topic! 'lze-cols-g 'plumbing)
(sp (make-wff (forall-guarded '(R n t B sc k)
                (append lze-cols-guards (list (lze-cols 'B)
                  '(IN sc (CARR R)) '(IN k (INTERVAL 1 n)) '(<= (succ t) k)))
                (lze-cols '(MATMUL R B (ELEM-H R n sc k))))))
(lze-peel-guards!)
(lze-cols-op! 'elem-h-action '(R n n B sc k))
(lze-done! 'lze-cols-h)
(topic! 'lze-cols-h 'plumbing)

;;; =====================================================================
;;; (4) Euclid on row r = t + 1: one column j > r cleared by F and G among columns r, j,
;;; by descent on the gauge of B_rr.
;;; =====================================================================
(lze-ring-lemma! 'lze-ring-euc '(leq_ leb_ ler_)
  '(= ((ADD R) ((ADD R) ((MUL R) leq_ leb_) ler_) ((MUL R) leb_ ((NEG R) leq_))) ler_))

(define (lze-gauge x) (list '(GAUGE R) x))
(define (lze-pair-guards nv)
  (list '(IS-EUCLIDEAN-RING R) '(IN n NN) '(IN t NN) '(<= (succ t) n) '(IN B (MAT n n (CARR R)))
        (lze-rows 'B) (lze-cols 'B) '(IN j (INTERVAL 1 n)) '(< (succ t) j)
        (list 'IMPLIES '(NOT (= (ENTRY B (succ t) (succ t)) (ZERO R)))
              (list '<= (lze-gauge '(ENTRY B (succ t) (succ t))) nv))))
(define (lze-same-row x b jj)              ; row r of X agrees with B off the columns r, JJ
  (list 'FORALL 'lpc_ (list 'IMPLIES '(IN lpc_ (INTERVAL 1 n))
    (list 'IMPLIES (list 'NOT (list '= 'lpc_ lze-r)) (list 'IMPLIES (list 'NOT (list '= 'lpc_ jj))
      (list '= (list 'ENTRY x lze-r 'lpc_) (list 'ENTRY b lze-r 'lpc_)))))))
(define (lze-pair-concl b)
  (let ((bq (lze-mm b 'lpq_)))
    (list 'FORSOME 'lpq_ (list 'AND '(IN lpq_ (ELEM-GEN R n))
      (list 'AND (lze-rows bq)
        (list 'AND (lze-cols bq)
          (list 'AND (list '= (list 'ENTRY bq lze-r 'j) '(ZERO R))
            (lze-same-row bq b 'j))))))))
(define (lze-pair-body nv) (forall-guarded '(R n t B j) (lze-pair-guards nv) (lze-pair-concl 'B)))

;; the ring facts every euclidean driver wants
(define (lze-euc-setup!)
  (fact 'euclidean-ring-is-integral-domain 'R)
  (fact 'integral-domain-is-commutative-ring 'R)
  (fact 'commutative-ring-is-ring 'R)
  (fact 'ring-zero-in 'R)
  (fact 'ring-one-in 'R))
(define (lze-gauge-typ!)
  (if (not (dk-asm? '(IN (GAUGE R) (FUN (CARR R) NN))))
      (let ((c (dk-fact! 'gauge-is-degree 'R)))
        (dk-split! c))))
(define (lze-gauge-nn! x)
  (lze-gauge-typ!)
  (lze-carr! x)
  (if (not (dk-asm? (list 'IN (lze-gauge x) 'NN)))
      (fact 'fun-apply-type-c '(GAUGE R) '(CARR R) 'NN x)))
;; the facts about the row index r = t + 1 and the column j
(define (lze-rj-setup!)
  (fact 'nn-succ-closed 't)
  (dk-have! '(<= t n) (lambda () (dk-nn! '(<= (succ t) n))))
  (lze-in-iv! lze-r 1 'n '(<= (succ t) n))
  (lze-iv-facts! 'j 1 'n)
  (dk-have! '(<= (succ t) j) (lambda () (dk-nn! '(< (succ t) j))))
  (dk-have! (list '<= lze-r lze-r) (lambda () (dk-nn!)))
  (lze-ne! lze-r 'j '(< (succ t) j))
  (lze-ne! 'j lze-r '(< (succ t) j))
  (fact 'lze-zr-identity 'R 'n 't)
  (if (not (dk-asm? (list 'IN lze-I '(MAT n n (CARR R))))) (dk-have! (list 'IN lze-I '(MAT n n (CARR R))) dk-typ-close!)))

;; close the conjunction of a pair conclusion with witness W: the conjuncts are in
;; context once EQ (when not #f; it rewrites B W to the matrix the facts are about) has
;; been applied, except SAME-ROW, which SAME-THUNK proves (called with the column)
(define (lze-pair-close! w eq same-thunk)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (and eq (dk-contains? (dk-goal) (cadr eq))) (subst eq))
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'lpc_))
               (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (c (cadddr e)))
                 (same-thunk c)))
              (#t (error "lze-pair-close!: conjunct not in context" (expression->string g))))))))

(define (lze-pair-drive! nv ih)
  (dk-peel!)
  (lze-euc-setup!)
  (lze-rj-setup!)
  (let* ((b '(ENTRY B (succ t) (succ t))) (c '(ENTRY B (succ t) j))
         (fm (list 'ELEM-F 'R 'n lze-r 'j)))
    (lze-carr! b) (lze-carr! c)
    (fact 'elem-f-is-elementary 'R 'n lze-r 'j)
    (fact 'elementary-in-elem-gen 'R 'n fm)
    (fact 'elementary-type 'R 'n fm)
    (use-em (list '= c '(ZERO R))
      (lambda () (lze-pair-trivial!))
      (lambda ()
        (use-em (list '= b '(ZERO R))
          (lambda () (lze-pair-swap! b fm))
          (lambda () (lze-pair-divide! nv ih b c fm)))))))

;; c = 0: Q = I
(define (lze-pair-trivial!)
  (let ((eqI (dk-cite! 'identmat-right-identity 'R 'n 'n 'B)))
    (fact 'elem-gen-identity 'R 'n)
    (lze-pair-close! lze-I eqI (lambda (cc) (lze-close!)))))

;; B_rr = 0: Q = F[r, j]
(define (lze-pair-swap! b fm)
  (let* ((bf (lze-mm 'B fm))
         (act (dk-fact! 'elem-f-action 'R 'n 'n 'B lze-r 'j)))
    (lze-typ! bf '(MAT n n (CARR R)))
    (fact 'laeg-op-f-agree 'R 'n 'n 't lze-I 'B lze-r 'j)
    (fact 'lze-cols-f 'R 'n 't 'B lze-r 'j)
    (dk-have! (list '= (list 'ENTRY bf lze-r 'j) '(ZERO R))
      (lambda ()
        (subst (dk-apply! act lze-r 'j))
        (lze-if-all! (lambda () (subst (list '= b '(ZERO R))) (lze-close!)))))
    (lze-pair-close! fm #f
      (lambda (cc)
        (lze-iv-facts! cc 1 'n)
        (subst (dk-apply! act lze-r cc))
        (lze-if-all! lze-close!)))))

;; B_rr /= 0: B_rj = q B_rr + rem; Q = G[-q, r, j], then F[r, j] and descend
(define (lze-pair-divide! nv ih b c fm)
  (let* ((qr (lze-skolem-all! (dk-fact! 'euclidean-division 'R c b)))
         (q (car qr)) (rm (cadr qr))
         (nq (list '(NEG R) q))
         (gmat (list 'ELEM-G 'R 'n nq lze-r 'j))
         (bg (lze-mm 'B gmat))
         (actg (begin
                 (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f rm))) (dk-asms))))
                                (if cj (begin (dk-split! cj) (loop)))))
                 (lze-carr! nq)
                 (dk-fact! 'elem-g-action 'R 'n 'n 'B nq lze-r 'j)))
         (bg-row! (lambda (cc)                     ; (B G)_rc = B_rc for c /= j
                    (lze-iv-facts! cc 1 'n)
                    (let ((e (list '= (list 'ENTRY bg lze-r cc) (list 'ENTRY 'B lze-r cc))))
                      (if (not (dk-asm? e))
                          (dk-have! e (lambda () (subst (dk-apply! actg lze-r cc)) (lze-if-all! lze-close!))))))))
    (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f rm))) (dk-asms))))
                   (if cj (begin (dk-split! cj) (loop)))))
    (lze-carr! nq)
    (fact 'elem-g-is-elementary 'R 'n nq lze-r 'j)
    (fact 'elementary-in-elem-gen 'R 'n gmat)
    (fact 'elementary-type 'R 'n gmat)
    (lze-typ! bg '(MAT n n (CARR R)))
    (fact 'laeg-op-g-agree 'R 'n 'n 't lze-I 'B nq lze-r 'j)
    (fact 'lze-cols-g 'R 'n 't 'B nq lze-r 'j)
    (dk-have! (list '= (list 'ENTRY bg lze-r 'j) rm)
      (lambda ()
        (subst (dk-apply! actg lze-r 'j))
        (lze-if-all!
          (lambda ()
            (subst (list '= c (list '(ADD R) (list '(MUL R) q b) rm)))
            (fact 'lze-ring-euc 'R q b rm)
            (ass)))))
    (use-em (list '= rm '(ZERO R))
      (lambda ()                                   ; the remainder vanishes: Q = gmat
        (dk-have! (list '= (list 'ENTRY bg lze-r 'j) '(ZERO R))
          (lambda () (subst (list '= (list 'ENTRY bg lze-r 'j) rm)) (subst (list '= rm '(ZERO R))) (lze-close!)))
        (lze-pair-close! gmat #f (lambda (cc) (bg-row! cc) (ass))))
      (lambda ()                                   ; swap and descend
        (let* ((disj (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f rm))) (dk-asms)))
               (lt (list '<= (list 'succ (lze-gauge rm)) (lze-gauge b)))
               (gle (list '<= (lze-gauge b) nv)))
          (lze-gauge-nn! rm) (lze-gauge-nn! b)
          (dk-have! lt (lambda () (use-cases disj (lambda () (lze-contra! (list 'NOT (list '= rm '(ZERO R))))) (lambda () (ass)))))
          (if (not (dk-asm? gle))
              (detach! (list 'IMPLIES (list 'NOT (list '= b '(ZERO R))) gle)))
          (if (not ih)
              (lze-absurd! (list lt gle))          ; base: no gauge is below 0
              (lze-pair-descend! nv ih b fm gmat bg actg bg-row! rm lt gle)))))))

(define (lze-pair-descend! nv ih b fm gmat bg actg bg-row! rm lt gle)
  (let* ((v (cadr nv))
         (bgf (lze-mm bg fm))
         (actf (dk-fact! 'elem-f-action 'R 'n 'n bg lze-r 'j))
         (rr2 (list 'ENTRY bgf lze-r lze-r)))
    (lze-typ! bgf '(MAT n n (CARR R)))
    (fact 'laeg-op-f-agree 'R 'n 'n 't lze-I bg lze-r 'j)
    (fact 'lze-cols-f 'R 'n 't bg lze-r 'j)
    (dk-have! (list '= rr2 rm)
      (lambda () (subst (dk-apply! actf lze-r lze-r)) (lze-if-all! (lambda () (ass)))))
    (dk-have! (list 'IMPLIES (list 'NOT (list '= rr2 '(ZERO R))) (list '<= (lze-gauge rr2) v))
      (lambda ()
        (di)
        (subst (list '= rr2 rm))
        (dk-nn! lt gle)))
    (let* ((qv (dk-skolem! (dk-apply! ih 'R 'n 't bgf 'j) #t))
           (gf (lze-mm gmat fm))
           (w (lze-mm gf qv)))
      (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f qv))) (dk-asms))))
                     (if cj (begin (dk-split! cj) (loop)))))
      (fact 'elem-gen-mat 'R 'n qv)
      (fact 'elem-gen-mul 'R 'n gmat fm)
      (fact 'elem-gen-mul 'R 'n gf qv)
      (lze-typ! gf '(MAT n n (CARR R)))
      (lze-typ! w '(MAT n n (CARR R)))
      (let* ((e1 (lze-assoc! 'n 'n 'n 'n 'B gf qv))
             (e2 (lze-assoc! 'n 'n 'n 'n 'B gmat fm))
             (eqw (list '= (lze-mm 'B w) (lze-mm bgf qv))))
        (dk-have! eqw
          (lambda ()
            (subst (list '= (lze-mm 'B w) (lze-mm (lze-mm 'B gf) qv)))
            (subst (list '= (lze-mm 'B gf) bgf))
            (lze-typ! (lze-mm bgf qv) '(MAT n n (CARR R)))
            (rfl)))
        (lze-pair-close! w eqw
          (lambda (cc)
            (let ((same (dk-ctx-form (lze-same-row (lze-mm bgf qv) bgf 'j))))
              (lze-iv-facts! cc 1 'n)
              (subst (dk-apply! same cc))
              (subst (dk-apply! actf lze-r cc))
              (lze-if-all! (lambda () (bg-row! cc) (ass))))))))))

(sp (make-wff (list 'FORALL 'lpn_ (list 'IMPLIES '(IN lpn_ NN) (lze-pair-body 'lpn_)))))
(define lze-pair-ind (use-induction))
(dk-focus! (cdr (assq 'base lze-pair-ind)))
(lze-pair-drive! 0 #f)
(dk-focus! (cdr (assq 'step lze-pair-ind)))
(lze-pair-drive! (list 'succ (cdr (assq 'var lze-pair-ind))) (cdr (assq 'ih lze-pair-ind)))
(lze-done! 'lze-pair-ind)
(topic! 'lze-pair-ind 'plumbing)

;;; =====================================================================
;;; (5) Row r: every entry right of the diagonal cleared (induction on the columns).
;;; =====================================================================
(define lze-row-guards
  (list '(IS-EUCLIDEAN-RING R) '(IN n NN) '(IN t NN) '(<= (succ t) n) '(IN B (MAT n n (CARR R)))
        (lze-rows 'B) (lze-cols 'B)))
(define (lze-cleared x k)
  (list 'FORALL 'lrc_ (list 'IMPLIES '(IN lrc_ (INTERVAL 1 n))
    (list 'IMPLIES '(< (succ t) lrc_) (list 'IMPLIES (list '<= 'lrc_ k)
      (list '= (list 'ENTRY x lze-r 'lrc_) '(ZERO R)))))))
(define (lze-row-concl k)
  (let ((bq (lze-mm 'B 'lrq_)))
    (list 'FORSOME 'lrq_ (list 'AND '(IN lrq_ (ELEM-GEN R n))
      (list 'AND (lze-rows bq) (list 'AND (lze-cols bq) (lze-cleared bq k)))))))
(define (lze-row-body k) (forall-guarded '(R n t B) lze-row-guards (lze-row-concl k)))

;; close a row conclusion with witness W; EQ rewrites B W (or #f); CLR-THUNK proves the
;; CLEARED conjunct's equation, called with the column c (its guards in context)
(define (lze-row-close! w eq clr-thunk)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (and eq (dk-contains? (dk-goal) (cadr eq))) (subst eq))
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'lrc_))
               (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (c (cadddr e)))
                 (clr-thunk c)))
              (#t (error "lze-row-close!: conjunct not in context" (expression->string g))))))))

(sp (make-wff (list 'FORALL 'lrk_ (list 'IMPLIES '(IN lrk_ NN) (lze-row-body 'lrk_)))))
(define lze-row-ind* (use-induction))
(dk-focus! (cdr (assq 'base lze-row-ind*)))
(dk-peel!)
(lze-euc-setup!)
(fact 'elem-gen-identity 'R 'n)
(let ((eqI (dk-cite! 'identmat-right-identity 'R 'n 'n 'B)))
  (lze-row-close! lze-I eqI
    (lambda (c)
      (lze-iv-facts! c 1 'n)
      (lze-absurd! (list (list '<= 1 c) (list '<= c 0))))))
(dk-focus! (cdr (assq 'step lze-row-ind*)))
(let* ((ih (cdr (assq 'ih lze-row-ind*)))
       (v (cdr (assq 'var lze-row-ind*)))
       (sv (list 'succ v)))
  (dk-peel!)
  (lze-euc-setup!)
  (fact 'nn-succ-closed 't)
  (fact 'nn-succ-closed v)
  (dk-have! '(<= t n) (lambda () (dk-nn! '(<= (succ t) n))))
  (let* ((qv (dk-skolem! (dk-apply! ih 'R 'n 't 'B) #t))
         (x (lze-mm 'B qv)))
    (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f qv))) (dk-asms))))
                   (if cj (begin (dk-split! cj) (loop)))))
    (fact 'elem-gen-mat 'R 'n qv)
    (lze-typ! x '(MAT n n (CARR R)))
    (let ((clr-k (dk-ctx-form (lze-cleared x v))))
      (use-em (list '<= sv lze-r)
        (lambda ()                         ; the new column is not right of r
          (lze-row-close! qv #f
            (lambda (c) (lze-iv-facts! c 1 'n) (lze-absurd! (list (list '< lze-r c) (list '<= c sv) (list '<= sv lze-r))))))
        (lambda ()
          (use-em (list '<= sv 'n)
            (lambda ()                     ; clear (r, v + 1) by the pair lemma
              (let* ((xr (list 'ENTRY x lze-r lze-r)))
                (lze-in-iv! lze-r 1 'n '(<= (succ t) n))
                (lze-in-iv! sv 1 'n (list '<= sv 'n))
                (lze-not-le! sv lze-r)
                (dk-have! (list '< lze-r sv) (lambda () (dk-nn! (list '<= (list 'succ lze-r) sv))))
                (lze-gauge-nn! xr)
                (fact 'nn-le-refl (lze-gauge xr))
                (dk-have! (list 'IMPLIES (list 'NOT (list '= xr '(ZERO R))) (list '<= (lze-gauge xr) (lze-gauge xr)))
                  (lambda () (di) (ass)))
                (let* ((q2 (dk-skolem! (dk-cite! 'lze-pair-ind (lze-gauge xr) 'R 'n 't x sv) #t))
                       (w (lze-mm qv q2)))
                  (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f q2))) (dk-asms))))
                                 (if cj (begin (dk-split! cj) (loop)))))
                  (fact 'elem-gen-mat 'R 'n q2)
                  (fact 'elem-gen-mul 'R 'n qv q2)
                  (lze-typ! w '(MAT n n (CARR R)))
                  (lze-typ! (lze-mm x q2) '(MAT n n (CARR R)))
                  (let* ((e1 (lze-assoc! 'n 'n 'n 'n 'B qv q2))
                         (eqw (list '= (lze-mm 'B w) (lze-mm x q2))))
                    (dk-have! eqw (lambda () (subst (list '= (lze-mm 'B w) (lze-mm x q2))) (rfl)))
                    (lze-row-close! w eqw
                      (lambda (c)
                        (lze-iv-facts! c 1 'n)
                        (use-em (list '= c sv)
                          (lambda () (subst (list '= c sv)) (ass))
                          (lambda ()
                            (let ((same (dk-ctx-form (lze-same-row (lze-mm x q2) x sv))))
                              (lze-ne! c lze-r (list '< lze-r c))
                              (lze-le-pred! c v)
                              (subst (dk-apply! same c))
                              (dk-apply! clr-k c)
                              (ass))))))))))
            (lambda ()                     ; v + 1 > n: nothing new
              (lze-row-close! qv #f
                (lambda (c)
                  (lze-iv-facts! c 1 'n)
                  (lze-not-le! sv 'n)
                  (dk-have! (list '<= c v) (lambda () (dk-nn! (list '<= c 'n) (list '<= '(succ n) sv))))
                  (dk-apply! clr-k c)
                  (ass))))))))))
(lze-done! 'lze-row-ind)
(topic! 'lze-row-ind 'plumbing)

;;; =====================================================================
;;; (6) Column r cleared below the pivot 1 by row operations (induction on the rows).
;;; =====================================================================
(lze-ring-lemma! 'lze-ring-z1 '(lzu_ lzv_) '(= ((ADD R) lzu_ ((MUL R) lzv_ (ZERO R))) lzu_))
(lze-ring-lemma! 'lze-ring-z2 '(lzu_) '(= ((ADD R) lzu_ ((MUL R) ((NEG R) lzu_) (ONE R))) (ZERO R)))

;; right-associate every n-by-n product in the goal
(define (lze-find-lassoc e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'MATMUL) (= (length e) 4) (pair? (caddr e)) (eq? (car (caddr e)) 'MATMUL)) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((lze-find-lassoc (car l)))
                    (#t (loop (cdr l))))))))
(define (lze-mtyp! x)
  (let ((mt '(MAT n n (CARR R))))
    (cond ((dk-asm? (list 'IN x mt)) #t)
          ((and (pair? x) (eq? (car x) 'MATMUL) (= (length x) 4))
           (lze-mtyp! (caddr x)) (lze-mtyp! (cadddr x))
           (lze-detach-all! (dk-cite! 'matmul-type 'R 'n 'n 'n (caddr x) (cadddr x)) (lambda (a) (prop))))
          ((and (pair? x) (memq (car x) '(ELEM-F ELEM-G ELEM-H)))
           (dk-have! (list 'IN x mt) dk-typ-close!))
          (#t (lze-typ! x mt)))
    (if (not (dk-asm? (list 'IN x mt))) (error "lze-mtyp!: did not land" (expression->string x)))))
(define (lze-rassoc!)
  (let loop ()
    (let ((e (lze-find-lassoc (dk-goal))))
      (if e
          (let* ((ab (caddr e)) (a (caddr ab)) (b (cadddr ab)) (c (cadddr e)))
            (lze-mtyp! a) (lze-mtyp! b) (lze-mtyp! c) (lze-mtyp! ab)
            (subst (lze-assoc! 'n 'n 'n 'n a b c))
            (loop))))))
;; prove (= X Y) for two products of typed n-by-n matrices with the same factors
(define (lze-prod-eq! x y)
  (let ((eq (list '= x y)))
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (lze-rassoc!) (lze-mtyp! (cadr (dk-goal))) (rfl))))
    eq))

(define (lze-rowoff x)
  (list 'FORALL 'rrc_ (list 'IMPLIES '(IN rrc_ (INTERVAL 1 n))
    (list 'IMPLIES (list 'NOT (list '= 'rrc_ lze-r)) (list '= (list 'ENTRY x lze-r 'rrc_) '(ZERO R))))))
(define (lze-clrc x k)
  (list 'FORALL 'lci_ (list 'IMPLIES '(IN lci_ (INTERVAL 1 n))
    (list 'IMPLIES (list '< lze-r 'lci_) (list 'IMPLIES (list '<= 'lci_ k)
      (list '= (list 'ENTRY x 'lci_ lze-r) '(ZERO R)))))))
(define lze-col-guards
  (list '(IS-COMMUTATIVE-RING R) '(IN n NN) '(IN t NN) '(<= (succ t) n) '(IN C (MAT n n (CARR R)))
        (lze-rows 'C) (lze-cols 'C) '(= (ENTRY C (succ t) (succ t)) (ONE R)) (lze-rowoff 'C)))
(define (lze-col-concl k)
  (let ((pc (lze-mm 'lcp_ 'C)))
    (list 'FORSOME 'lcp_ (list 'AND '(IN lcp_ (ELEM-GEN R n))
      (list 'AND (lze-rows pc) (list 'AND (lze-cols pc)
        (list 'AND (list '= (list 'ENTRY pc lze-r lze-r) '(ONE R))
          (list 'AND (lze-rowoff pc) (lze-clrc pc k)))))))))
(define (lze-col-body k) (forall-guarded '(R n t C) lze-col-guards (lze-col-concl k)))

;; close a column conclusion with witness W; EQ rewrites W C (or #f); the CLRC conjunct
;; by CLR-THUNK (called with the row)
(define (lze-col-close! w eq clr-thunk)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (and eq (dk-contains? (dk-goal) (cadr eq))) (subst eq))
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'lci_))
               (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (i (caddr e)))
                 (clr-thunk i)))
              (#t (error "lze-col-close!: conjunct not in context" (expression->string g))))))))

(sp (make-wff (list 'FORALL 'lck_ (list 'IMPLIES '(IN lck_ NN) (lze-col-body 'lck_)))))
(define lze-col-ind* (use-induction))
(dk-focus! (cdr (assq 'base lze-col-ind*)))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'elem-gen-identity 'R 'n)
(let ((eqI (dk-cite! 'identmat-left-identity 'R 'n 'n 'C)))
  (lze-col-close! lze-I eqI
    (lambda (i)
      (lze-iv-facts! i 1 'n)
      (lze-absurd! (list (list '<= 1 i) (list '<= i 0))))))
(dk-focus! (cdr (assq 'step lze-col-ind*)))
(let* ((ih (cdr (assq 'ih lze-col-ind*)))
       (v (cdr (assq 'var lze-col-ind*)))
       (sv (list 'succ v)))
  (dk-peel!)
  (fact 'commutative-ring-is-ring 'R)
  (fact 'ring-zero-in 'R) (fact 'ring-one-in 'R)
  (fact 'nn-succ-closed 't)
  (fact 'nn-succ-closed v)
  (dk-have! '(<= t n) (lambda () (dk-nn! '(<= (succ t) n))))
  (lze-in-iv! lze-r 1 'n '(<= (succ t) n))
  (let* ((pv (dk-skolem! (dk-apply! ih 'R 'n 't 'C) #t))
         (y (lze-mm pv 'C)))
    (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f pv))) (dk-asms))))
                   (if cj (begin (dk-split! cj) (loop)))))
    (fact 'elem-gen-mat 'R 'n pv)
    (lze-mtyp! y)
    (let ((clr-k (dk-ctx-form (lze-clrc y v)))
          (off (dk-ctx-form (lze-rowoff y))))
      (use-em (list '<= sv lze-r)
        (lambda ()
          (lze-col-close! pv #f
            (lambda (i) (lze-iv-facts! i 1 'n) (lze-absurd! (list (list '< lze-r i) (list '<= i sv) (list '<= sv lze-r))))))
        (lambda ()
          (use-em (list '<= sv 'n)
            (lambda ()                     ; clear (v + 1, r) by a row operation
              (lze-in-iv! sv 1 'n (list '<= sv 'n))
              (lze-not-le! sv lze-r)
              (dk-have! (list '< lze-r sv) (lambda () (dk-nn! (list '<= (list 'succ lze-r) sv))))
              (lze-ne! sv lze-r (list '< lze-r sv))
              (lze-ne! lze-r sv (list '< lze-r sv))
              (let* ((cy (list 'ENTRY y sv lze-r))
                     (ncy (list '(NEG R) cy))
                     (gmat (list 'ELEM-G 'R 'n ncy sv lze-r))
                     (gy (lze-mm gmat y))
                     (w (lze-mm gmat pv)))
                (lze-carr! cy) (lze-carr! ncy)
                (fact 'elem-g-is-elementary 'R 'n ncy sv lze-r)
                (fact 'elementary-in-elem-gen 'R 'n gmat)
                (fact 'elementary-type 'R 'n gmat)
                (fact 'elem-gen-mul 'R 'n gmat pv)
                (lze-mtyp! gy) (lze-mtyp! w)
                (let* ((act (dk-fact! 'elem-g-row-action 'R 'n 'n y ncy sv lze-r))
                       (eqw (lze-prod-eq! (lze-mm w 'C) gy))
                       ;; (G Y)_{i c}, I and C typed: rows other than v+1 unchanged; row
                       ;; v+1 unchanged off column r; (v+1, r) = 0
                       (gy-entry!
                         (lambda (i c)
                           (lze-iv-facts! i 1 'n) (lze-iv-facts! c 1 'n)
                           (subst (dk-apply! act i c))
                           (lze-if-all!
                             (lambda ()
                               (let ((g (dk-goal)))
                                 (cond ((not (dk-contains? (cadr g) '(ADD R))) (lze-close!))
                                       ((equal? c lze-r)
                                        (subst (list '= (list 'ENTRY y lze-r lze-r) '(ONE R)))
                                        (subst (dk-fact! 'lze-ring-z2 'R cy))
                                        (lze-close!))
                                       (#t
                                        (dk-apply! off c)
                                        (subst (list '= (list 'ENTRY y lze-r c) '(ZERO R)))
                                        (lze-carr! (list 'ENTRY y sv c))
                                        (subst (dk-fact! 'lze-ring-z1 'R (list 'ENTRY y sv c) ncy))
                                        (lze-close!)))))))))
                  ;; the conjuncts about G Y
                  (dk-have! (lze-rows gy)
                    (lambda ()
                      (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (i (caddr e)) (c (cadddr e)))
                        (lze-iv-facts! i 1 't)
                        (fact 'interval-widen 't 'n 1 i)
                        (lze-ne! i sv (list '<= i 't) (list '< lze-r sv))
                        (dk-have! (list '= (list 'ENTRY gy i c) (list 'ENTRY y i c)) (lambda () (gy-entry! i c)))
                        (subst (list '= (list 'ENTRY gy i c) (list 'ENTRY y i c)))
                        (dk-apply! (dk-ctx-form (lze-rows y)) i c)
                        (ass))))
                  (dk-have! (lze-cols gy)
                    (lambda ()
                      (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (i (caddr e)) (c (cadddr e)))
                        (lze-iv-facts! c 1 't)
                        (fact 'interval-widen 't 'n 1 c)
                        (lze-ne! c lze-r (list '<= c 't))
                        (lze-iv-facts! i 1 'n)
                        (use-em (list '= i sv)
                          (lambda () (subst (list '= i sv))
                                     (dk-have! (list '= (list 'ENTRY gy sv c) (list 'ENTRY y sv c)) (lambda () (gy-entry! sv c)))
                                     (subst (list '= (list 'ENTRY gy sv c) (list 'ENTRY y sv c)))
                                     (dk-apply! (dk-ctx-form (lze-cols y)) sv c)
                                     (ass))
                          (lambda () (dk-have! (list '= (list 'ENTRY gy i c) (list 'ENTRY y i c)) (lambda () (gy-entry! i c)))
                                     (subst (list '= (list 'ENTRY gy i c) (list 'ENTRY y i c)))
                                     (dk-apply! (dk-ctx-form (lze-cols y)) i c)
                                     (ass))))))
                  (dk-have! (list '= (list 'ENTRY gy lze-r lze-r) '(ONE R))
                    (lambda () (gy-entry! lze-r lze-r)))
                  (dk-have! (lze-rowoff gy)
                    (lambda ()
                      (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (c (cadddr e)))
                        (dk-have! (list '= (list 'ENTRY gy lze-r c) (list 'ENTRY y lze-r c)) (lambda () (gy-entry! lze-r c)))
                        (subst (list '= (list 'ENTRY gy lze-r c) (list 'ENTRY y lze-r c)))
                        (dk-apply! off c)
                        (ass))))
                  (lze-col-close! w eqw
                    (lambda (i)
                      (lze-iv-facts! i 1 'n)
                      (use-em (list '= i sv)
                        (lambda () (subst (list '= i sv)) (gy-entry! sv lze-r))
                        (lambda ()
                          (lze-le-pred! i v)
                          (dk-have! (list '= (list 'ENTRY gy i lze-r) (list 'ENTRY y i lze-r)) (lambda () (gy-entry! i lze-r)))
                          (subst (list '= (list 'ENTRY gy i lze-r) (list 'ENTRY y i lze-r)))
                          (dk-apply! clr-k i)
                          (ass))))))))
            (lambda ()
              (lze-col-close! pv #f
                (lambda (i)
                  (lze-iv-facts! i 1 'n)
                  (lze-not-le! sv 'n)
                  (dk-have! (list '<= i v) (lambda () (dk-nn! (list '<= i 'n) (list '<= '(succ n) sv))))
                  (dk-apply! clr-k i)
                  (ass))))))))))
(lze-done! 'lze-col-ind)
(topic! 'lze-col-ind 'plumbing)

;;; =====================================================================
;;; (7) One step of the reduction: from IDP(t) to IDP(t + 1), the determinant a unit.
;;; =====================================================================
(define lze-step-guards
  (list '(IS-EUCLIDEAN-RING R) '(IN n NN) '(IN t NN) '(<= (succ t) n) '(IN U (MAT n n (CARR R)))
        (lze-rows 'U) (lze-cols 'U) (lze-unit '(DET R n U))))
(define (lze-step-concl tt)
  (let ((x '(MATMUL R (MATMUL R lsp_ U) lsq_)))
    (list 'FORSOME 'lsp_ (list 'AND '(IN lsp_ (ELEM-GEN R n))
      (list 'FORSOME 'lsq_ (list 'AND '(IN lsq_ (ELEM-GEN R n))
        (list 'AND (lze-rows* x tt) (list 'AND (lze-cols* x tt) (lze-unit (list 'DET 'R 'n x))))))))))
(define (lze-split-with! v)
  (let loop () (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f v))) (dk-asms))))
                 (if cj (begin (dk-split! cj) (loop))))))
;; the identity's entry at (i, j), i, j in [1, n] typed, decided by (= i j) in context
(define (lze-id-entry! i j)
  (if (or (equal? i j) (dk-asm? (list '= i j)))
      (dk-cite! 'identmat-entry-diag 'R 'n i)
      (dk-cite! 'identmat-entry-off 'R 'n i j)))

(sp (make-wff (forall-guarded '(R n t U) lze-step-guards (lze-step-concl '(succ t)))))
(dk-peel!)
(lze-euc-setup!)
(fact 'nn-succ-closed 't)
(dk-have! '(<= t n) (lambda () (dk-nn! '(<= (succ t) n))))
(lze-in-iv! lze-r 1 'n '(<= (succ t) n))
(fact 'lze-zr-identity 'R 'n 't)
(lze-mtyp! lze-I)
(dk-have! (list '<= lze-r lze-r) (lambda () (dk-nn!)))
(let* ((q1 (dk-skolem! (dk-cite! 'lze-row-ind 'n 'R 'n 't 'U) #t))
       (x (lze-mm 'U q1))
       (b (list 'ENTRY x lze-r lze-r))
       (ss (list 'FORALL 'frj_ (list 'IMPLIES '(IN frj_ (INTERVAL 1 n))
             (list 'IMPLIES (list 'NOT (list '= 'frj_ lze-r)) (list '= (list 'ENTRY x lze-r 'frj_) '(ZERO R)))))))
  (lze-split-with! q1)
  (fact 'elem-gen-mat 'R 'n q1)
  (lze-mtyp! x)
  ;; row r of X has the single entry b
  (dk-have! ss
    (lambda ()
      (let* ((landed (dk-peel!)) (c (cadddr (cadr (dk-goal)))))
        (lze-iv-facts! c 1 'n)
        (use-em (list '< lze-r c)
          (lambda () (dk-apply! (dk-ctx-form (lze-cleared x 'n)) c) (ass))
          (lambda ()
            (fact 'nn-not-lt-le lze-r c)
            (lze-le-pred! c 't)
            (lze-in-iv! c 1 't (list '<= c 't))
            (dk-apply! (dk-ctx-form (lze-cols x)) lze-r c)
            (subst (list '= (list 'ENTRY x lze-r c) (list 'ENTRY lze-I lze-r c)))
            (lze-ne! lze-r c (list '<= c 't))
            (fact 'identmat-entry-off 'R 'n lze-r c)
            (ass))))))
  ;; det X is a unit
  (let* ((du '(DET R n U)) (dq (list 'DET 'R 'n q1)) (dx (list 'DET 'R 'n x))
         (s0 (dk-skolem! (dk-ctx-form (lze-unit du)) #t))
         (s1 (dk-skolem! (dk-fact! 'elem-gen-det-unit 'R 'n q1) #t))
         (S (list '(MUL R) s0 s1)))
    (lze-carr! du) (lze-carr! dq) (lze-carr! dx) (lze-carr! S)
    (fact 'det-multiplicative 'R 'n 'U q1)
    (fact 'lze-unit-mul 'R du dq s0 s1)
    (dk-have! (list '= (list '(MUL R) dx S) '(ONE R))
      (lambda () (subst (list '= dx (list '(MUL R) du dq))) (ass)))
    ;; n = n0 + 1 and the expansion along row r: b is a unit
    (lze-ne! 'n 0 '(<= (succ t) n))
    (let* ((n0 (dk-skolem! (dk-fact! 'nn-nonzero-is-succ 'n) #t))
           (sn (list 'succ n0)))
      (fact 'nn-succ-closed n0)
      (dk-have! (list 'IN x (list 'MAT sn sn '(CARR R))) (lambda () (subst (list '= sn 'n)) (ass)))
      (dk-have! (list 'IN lze-r (list 'INTERVAL 1 sn)) (lambda () (subst (list '= sn 'n)) (ass)))
      (dk-have! (subst-free 'n sn ss) (lambda () (subst (list '= sn 'n)) (ass)))
      (let* ((e0 (lze-detach-all! (dk-cite! 'det-row-single 'R n0 x lze-r)
                   (lambda (a) (error "lze-step: det-row-single antecedent missing" (expression->string a)))))
             (e1 (dk-rewrite-h! e0 sn 'n))
             (dm (list 'DET 'R n0 (list 'MINOR x lze-r lze-r n0)))
             (w (list '(MUL R) dm S)))
        (lze-carr! b) (lze-carr! dm) (lze-carr! w)
        (dk-have! (list '= (list '(MUL R) b w) '(ONE R))
          (lambda ()
            (subst (dk-fact! 'lze-ring-assoc 'R b dm S))
            (subst (list '= (list '(MUL R) b dm) dx))
            (ass)))
        (dk-have! (list '= (list '(MUL R) w b) '(ONE R))
          (lambda () (subst (dk-fact! 'commutative-ring-mul-comm 'R w b)) (ass)))
        ;; C = X H[w, r]: pivot 1, row r otherwise 0
        (let* ((H (list 'ELEM-H 'R 'n w lze-r))
               (cm (lze-mm x H))
               (bS (list '(MUL R) b S)))
          (fact 'elem-h-is-elementary 'R 'n w b lze-r)
          (fact 'elementary-in-elem-gen 'R 'n H)
          (lze-mtyp! H)
          (lze-mtyp! cm)
          (fact 'laeg-op-h-agree 'R 'n 'n 't lze-I x w lze-r)
          (fact 'lze-cols-h 'R 'n 't x w lze-r)
          (let ((acth (dk-fact! 'elem-h-action 'R 'n 'n x w lze-r)))
            (dk-have! (list '= (list 'ENTRY cm lze-r lze-r) '(ONE R))
              (lambda () (subst (dk-apply! acth lze-r lze-r)) (lze-if-all! (lambda () (ass)))))
            (dk-have! (lze-rowoff cm)
              (lambda ()
                (let* ((landed (dk-peel!)) (c (cadddr (cadr (dk-goal)))))
                  (subst (dk-apply! acth lze-r c))
                  (dk-apply! ss c)
                  (lze-if-all! (lambda () (ass)))))))
          (fact 'det-elem-h-col 'R 'n x w lze-r)
          (lze-carr! bS)
          (fact 'lze-unit-mul 'R w dx b S)
          (let ((dc (list 'DET 'R 'n cm)))
            (lze-carr! dc)
            (dk-have! (list '= (list '(MUL R) dc bS) '(ONE R))
              (lambda () (subst (list '= dc (list '(MUL R) w dx))) (ass)))
            ;; clear column r by row operations
            (let* ((p (dk-skolem! (dk-cite! 'lze-col-ind 'n 'R 'n 't cm) #t))
                   (y (lze-mm p cm))
                   (qq (lze-mm q1 H))
                   (xf (lze-mm (lze-mm p 'U) qq)))
              (lze-split-with! p)
              (fact 'elem-gen-mat 'R 'n p)
              (fact 'elem-gen-mul 'R 'n q1 H)
              (lze-mtyp! y) (lze-mtyp! qq) (lze-mtyp! (lze-mm p 'U)) (lze-mtyp! xf)
              (let* ((eqf (lze-prod-eq! xf y))
                     (dp (list 'DET 'R 'n p))
                     (s2 (dk-skolem! (dk-fact! 'elem-gen-det-unit 'R 'n p) #t))
                     (rowsy (dk-ctx-form (lze-rows y)))
                     (colsy (dk-ctx-form (lze-cols y)))
                     (offy (dk-ctx-form (lze-rowoff y)))
                     (clry (dk-ctx-form (lze-clrc y 'n))))
                (lze-carr! dp)
                (fact 'det-multiplicative 'R 'n p cm)
                (fact 'lze-unit-mul 'R dp dc s2 bS)
                (dk-have! (lze-unit (list 'DET 'R 'n y))
                  (lambda ()
                    (let ((wv (list '(MUL R) s2 bS)))
                      (lze-carr! wv)
                      (ew wv)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'IN) (ass)
                              (begin (subst (list '= (list 'DET 'R 'n y) (list '(MUL R) dp dc))) (ass))))))))
                ;; rows 1..t+1 of Y
                (dk-have! (lze-rows* y lze-r)
                  (lambda ()
                    (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (i (caddr e)) (j (cadddr e)))
                      (lze-iv-facts! i 1 lze-r) (lze-iv-facts! j 1 'n)
                      (fact 'interval-widen lze-r 'n 1 i)
                      (use-em (list '= i lze-r)
                        (lambda ()
                          (subst (list '= i lze-r))
                          (use-em (list '= j lze-r)
                            (lambda () (subst (list '= j lze-r)) (subst (lze-id-entry! lze-r lze-r)) (ass))
                            (lambda ()
                              (dk-apply! offy j)
                              (dk-have! (list 'NOT (list '= lze-r j)) (lambda () (lze-nsym! lze-r j)))
                              (subst (lze-id-entry! lze-r j)) (ass))))
                        (lambda ()
                          (lze-le-pred! i 't)
                          (lze-in-iv! i 1 't (list '<= i 't))
                          (dk-apply! rowsy i j) (ass))))))
                ;; columns 1..t+1 of Y
                (dk-have! (lze-cols* y lze-r)
                  (lambda ()
                    (let* ((landed (dk-peel!)) (e (cadr (dk-goal))) (i (caddr e)) (j (cadddr e)))
                      (lze-iv-facts! i 1 'n) (lze-iv-facts! j 1 lze-r)
                      (fact 'interval-widen lze-r 'n 1 j)
                      (use-em (list '= j lze-r)
                        (lambda ()
                          (subst (list '= j lze-r))
                          (use-em (list '= i lze-r)
                            (lambda () (subst (list '= i lze-r)) (subst (lze-id-entry! lze-r lze-r)) (ass))
                            (lambda ()
                              (lze-ne! i lze-r)
                              (subst (lze-id-entry! i lze-r))
                              (use-em (list '< lze-r i)
                                (lambda () (dk-apply! clry i) (ass))
                                (lambda ()
                                  (fact 'nn-not-lt-le lze-r i)
                                  (lze-le-pred! i 't)
                                  (lze-in-iv! i 1 't (list '<= i 't))
                                  (dk-apply! rowsy i lze-r)
                                  (subst (list '= (list 'ENTRY y i lze-r) (list 'ENTRY lze-I i lze-r)))
                                  (subst (lze-id-entry! i lze-r))
                                  (rfl))))))
                        (lambda ()
                          (lze-le-pred! j 't)
                          (lze-in-iv! j 1 't (list '<= j 't))
                          (dk-apply! colsy i j) (ass))))))
                (ew p)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORSOME)
                        (begin
                          (ew qq)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-contains? (dk-goal) xf) (subst eqf))
                              (ass))))
                        (ass))))))))))))
(lze-done! 'lze-step)
(topic! 'lze-step 'plumbing)

;;; =====================================================================
;;; (8) The induction on t, and the theorems.
;;; =====================================================================
(define (lze-main-concl tt)
  (let ((x '(MATMUL R (MATMUL R lmp_ U) lmq_)))
    (list 'FORSOME 'lmp_ (list 'AND '(IN lmp_ (ELEM-GEN R n))
      (list 'FORSOME 'lmq_ (list 'AND '(IN lmq_ (ELEM-GEN R n))
        (list 'AND (lze-rows* x tt) (list 'AND (lze-cols* x tt) (lze-unit (list 'DET 'R 'n x))))))))))
(define (lze-main-body tt)
  (forall-guarded '(R n U)
    (list '(IS-EUCLIDEAN-RING R) '(IN n NN) '(IN U (MAT n n (CARR R))) (lze-unit '(DET R n U)) (list '<= tt 'n))
    (lze-main-concl tt)))
;; close a main conclusion with witnesses P, Q; EQ rewrites the product (or #f)
(define (lze-main-close! p q eq thunk)
  (ew p)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          (begin
            (ew q)
            (dk-conj-close!
              (lambda ()
                (if (and eq (dk-contains? (dk-goal) (cadr eq))) (subst eq))
                (if (dk-asm? (dk-goal)) (ass) (thunk)))))
          (ass)))))

(sp (make-wff (list 'FORALL 'lmt_ (list 'IMPLIES '(IN lmt_ NN) (lze-main-body 'lmt_)))))
(define lze-main-ind* (use-induction))
(dk-focus! (cdr (assq 'base lze-main-ind*)))
(dk-peel!)
(lze-euc-setup!)
(fact 'elem-gen-identity 'R 'n)
(lze-mtyp! lze-I)
(lze-mtyp! (lze-mm lze-I 'U))
(fact 'identmat-left-identity 'R 'n 'n 'U)
(fact 'identmat-right-identity 'R 'n 'n 'U)
(let ((eqx (list '= (lze-mm (lze-mm lze-I 'U) lze-I) 'U)))
  (dk-have! eqx (lambda () (subst (list '= (lze-mm lze-I 'U) 'U)) (subst (list '= (lze-mm 'U lze-I) 'U)) (rfl)))
  (lze-main-close! lze-I lze-I eqx
    (lambda ()                             ; the empty prefix
      (let* ((landed (dk-peel!))
             (z (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 0)))) landed)))
        (lze-iv-facts! (cadr z) 1 0)
        (lze-absurd! (list (list '<= 1 (cadr z)) (list '<= (cadr z) 0)))))))
(dk-focus! (cdr (assq 'step lze-main-ind*)))
(let* ((ih (cdr (assq 'ih lze-main-ind*)))
       (v (cdr (assq 'var lze-main-ind*)))
       (sv (list 'succ v)))
  (dk-peel!)
  (lze-euc-setup!)
  (fact 'nn-succ-closed v)
  (dk-have! (list '<= v 'n) (lambda () (dk-nn! (list '<= sv 'n))))
  (let* ((p (dk-skolem! (dk-apply! ih 'R 'n 'U) #t))
         (q (begin (lze-split-with! p)
                   (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f p))) (dk-asms)) #t)))
         (x (lze-mm (lze-mm p 'U) q)))
    (lze-split-with! q)
    (fact 'elem-gen-mat 'R 'n p) (fact 'elem-gen-mat 'R 'n q)
    (lze-mtyp! x)
    (let* ((p2 (dk-skolem! (dk-cite! 'lze-step 'R 'n v x) #t))
           (q2 (begin (lze-split-with! p2)
                      (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f p2))) (dk-asms)) #t)))
           (x2 (lze-mm (lze-mm p2 x) q2))
           (pp (lze-mm p2 p)) (qq (lze-mm q q2))
           (xf (lze-mm (lze-mm pp 'U) qq)))
      (lze-split-with! q2)
      (fact 'elem-gen-mat 'R 'n p2) (fact 'elem-gen-mat 'R 'n q2)
      (fact 'elem-gen-mul 'R 'n p2 p)
      (fact 'elem-gen-mul 'R 'n q q2)
      (lze-mtyp! x2) (lze-mtyp! xf)
      (let ((eqf (lze-prod-eq! xf x2)))
        (lze-main-close! pp qq eqf
          (lambda () (error "lze-main: conjunct not in context" (expression->string (dk-goal)))))))))
(lze-done! 'lze-main-ind)
(topic! 'lze-main-ind 'plumbing)

;; over a euclidean ring, a matrix whose determinant is a unit is a product of
;; elementary matrices
(sp (make-wff (forall-guarded '(R n U)
                (list '(IS-EUCLIDEAN-RING R) '(IN n NN) '(IN U (MAT n n (CARR R))) (lze-unit '(DET R n U)))
                '(IN U (ELEM-GEN R n)))))
(dk-peel!)
(lze-euc-setup!)
(fact 'nn-le-refl 'n)
(let* ((p (dk-skolem! (dk-cite! 'lze-main-ind 'n 'R 'n 'U) #t))
       (q (begin (lze-split-with! p)
                 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f p))) (dk-asms)) #t)))
       (pu (lze-mm p 'U))
       (x (lze-mm pu q)))
  (lze-split-with! q)
  (fact 'elem-gen-mat 'R 'n p) (fact 'elem-gen-mat 'R 'n q)
  (lze-mtyp! lze-I) (lze-mtyp! x)
  ;; X = I
  (let ((ext (dk-cite! 'matrix-entry-extensionality 'n 'n '(CARR R) x lze-I)))
    (lze-detach-all! ext
      (lambda (a)
        (let* ((landed (dk-peel!)) (e (cadr (dk-goal))))
          (dk-apply! (dk-ctx-form (lze-rows* x 'n)) (caddr e) (cadddr e))
          (ass)))))
  ;; U = P' Q' with P' P = I and Q Q' = I
  (let* ((p1 (dk-skolem! (dk-fact! 'elem-gen-inverse 'R 'n p) #t))
         (q1 (begin (lze-split-with! p1) (dk-skolem! (dk-fact! 'elem-gen-inverse 'R 'n q) #t))))
    (lze-split-with! q1)
    (fact 'elem-gen-mat 'R 'n p1) (fact 'elem-gen-mat 'R 'n q1)
    (lze-mtyp! pu) (lze-mtyp! (lze-mm 'U q))
    (let* ((a1 (lze-assoc! 'n 'n 'n 'n p1 pu q))
           (a2 (lze-assoc! 'n 'n 'n 'n p1 p 'U))
           (a3 (lze-assoc! 'n 'n 'n 'n 'U q q1)))
      (fact 'identmat-left-identity 'R 'n 'n 'U)
      (fact 'identmat-right-identity 'R 'n 'n 'U)
      (fact 'identmat-right-identity 'R 'n 'n p1)
      (dk-have! (list '= (lze-mm p1 x) (lze-mm 'U q))
        (lambda ()
          (subst (list '= (lze-mm p1 x) (lze-mm (lze-mm p1 pu) q)))
          (subst (list '= (lze-mm p1 pu) (lze-mm (lze-mm p1 p) 'U)))
          (subst (list '= (lze-mm p1 p) lze-I))
          (subst (list '= (lze-mm lze-I 'U) 'U))
          (lze-mtyp! (lze-mm 'U q))
          (rfl)))
      (let* ((h1 (list '= (lze-mm (lze-mm p1 x) q1) 'U)))
        (dk-have! h1
          (lambda ()
            (subst (list '= (lze-mm p1 x) (lze-mm 'U q)))
            (subst (list '= (lze-mm (lze-mm 'U q) q1) (lze-mm 'U (lze-mm q q1))))
            (subst (list '= (lze-mm q q1) lze-I))
            (subst (list '= (lze-mm 'U lze-I) 'U))
            (rfl)))
        (let* ((h2 (dk-rewrite-h! h1 x lze-I))
               (h3 (dk-rewrite-h! h2 (lze-mm p1 lze-I) p1)))
          (fact 'elem-gen-mul 'R 'n p1 q1)
          (subst (list '= 'U (lze-mm p1 q1)))
          (ass))))))
(lze-done! 'euclidean-unit-det-elem-gen)
(topic! 'euclidean-unit-det-elem-gen 'algebra)
(gloss! 'euclidean-unit-det-elem-gen "Over a euclidean ring a square matrix whose determinant is a unit is a product of elementary matrices.")

;; an invertible matrix over a euclidean ring is a product of elementary matrices, and
;; conversely (elem-gen-invertible)
(sp (make-wff (forall-guarded '(R n U) '((IS-EUCLIDEAN-RING R) (IN n NN))
                '(IFF (IS-INVERTIBLE-MAT R n U) (IN U (ELEM-GEN R n))))))
(dk-peel!)
(lze-euc-setup!)
(dk-iff! (dk-head? 'IN)
  (lambda ()
    (let* ((hyp '(IS-INVERTIBLE-MAT R n U))
           (ignore (fact 'is-invertible-mat 'R 'n 'U))
           (iff (iff-for hyp))
           (rhs (caddr iff)))
      (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
      (let* ((parts (dk-split! (dk-ctx-form rhs)))
             (vv (dk-skolem! (find-first (dk-head? 'FORSOME) parts) #t)))
        (lze-split-with! vv)
        (fact 'det-multiplicative 'R 'n 'U vv)
        (fact 'det-identity-ind 'R 'n)
        (lze-carr! '(DET R n U)) (lze-carr! (list 'DET 'R 'n vv))
        (dk-have! (lze-unit '(DET R n U))
          (lambda ()
            (ew (list 'DET 'R 'n vv))
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (begin
                      (subst (list '= (list '(MUL R) '(DET R n U) (list 'DET 'R 'n vv)) (list 'DET 'R 'n (lze-mm 'U vv))))
                      (subst (list '= (lze-mm 'U vv) lze-I))
                      (ass)))))))
        (fact 'euclidean-unit-det-elem-gen 'R 'n 'U)
        (ass))))
  (lambda ()
    (fact 'elem-gen-invertible 'R 'n 'U)
    (ass)))
(lze-done! 'euclidean-invertible-iff-elem-gen)
(topic! 'euclidean-invertible-iff-elem-gen 'algebra)
(gloss! 'euclidean-invertible-iff-elem-gen "Over a euclidean ring a square matrix is invertible if and only if it is a product of elementary matrices.")

;; Linear algebra 3.38: U in M_n(Z) is invertible iff U = U' V' with U' a product of
;; column elementary matrices and V' a product of row elementary matrices.  The integral
;; elementary matrices are those of IS-ELEMENTARY over ZZ-RING (H with r = +/- 1, the
;; units); a product of row elementary matrices is the same set ELEM-GEN.
(sp (make-wff (forall-guarded '(n U) '((IN n NN))
                '(IFF (IS-INVERTIBLE-MAT ZZ-RING n U)
                      (FORSOME zep_ (AND (IN zep_ (ELEM-GEN ZZ-RING n))
                        (FORSOME zeq_ (AND (IN zeq_ (ELEM-GEN ZZ-RING n))
                          (= U (MATMUL ZZ-RING zep_ zeq_))))))))))
(dk-peel!)
(fact 'zz-is-euclidean-ring)
(fact 'zz-is-ring)
(fact 'euclidean-invertible-iff-elem-gen 'ZZ-RING 'n 'U)
(dk-iff! (dk-head? 'FORSOME)
  (lambda ()
    (let ((iff (iff-for '(IS-INVERTIBLE-MAT ZZ-RING n U))))
      (dk-have! '(IN U (ELEM-GEN ZZ-RING n)) (dk-lane (lambda () (dk-only! iff '(IS-INVERTIBLE-MAT ZZ-RING n U)) (dk-lane-if! prop))))
      (fact 'elem-gen-mat 'ZZ-RING 'n 'U)
      (fact 'elem-gen-identity 'ZZ-RING 'n)
      (fact 'identmat-right-identity 'ZZ-RING 'n 'n 'U)
      (ew 'U)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin (ew '(IDENTMAT ZZ-RING n))
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) '=)
                             (begin (subst '(= (MATMUL ZZ-RING U (IDENTMAT ZZ-RING n)) U)) (rfl))
                             (ass)))))
              (ass))))))
  (lambda ()
    (let* ((p (dk-skolem! (find-first (dk-head? 'FORSOME) (dk-asms)) #t))
           (q (begin (lze-split-with! p)
                     (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f p))) (dk-asms)) #t))))
      (lze-split-with! q)
      (fact 'elem-gen-mul 'ZZ-RING 'n p q)
      (fact 'elem-gen-invertible 'ZZ-RING 'n (list 'MATMUL 'ZZ-RING p q))
      (subst (list '= 'U (list 'MATMUL 'ZZ-RING p q)))
      (ass))))
(lze-done! 'zz-invertible-iff-elementary-product)
(topic! 'zz-invertible-iff-elementary-product 'algebra)
(gloss! 'zz-invertible-iff-elementary-product "Linear algebra 3.38: an integer square matrix is invertible over Z if and only if it is a product of a product of column elementary matrices and a product of row elementary matrices.")
