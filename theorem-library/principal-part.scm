;;; principal-part.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3e/ch3e-pp.scm.
;;; Library: complex-analysis.

;;; ch3e-pp.scm -- CH3-E: Proposition 3.28 of complex-analysis.pdf (the integral of a finite principal
;;; part around a closed road).
;;;
;;;   principal-part-integral-step   by induction on M: the sum S_{M+1}(z) = sum_{j <= M} a_{j+1}/(z - u)^{j+1}
;;;                                  is holomorphic on CC \ {u}, and its integral along a closed road
;;;                                  missing u is a_1 times the integral of 1/(z - u)
;;;   principal-part-integral        (3.28) (1/2 pi i) int_gamma sum_{k=1}^N a_k/(z - u)^k dz = a_1 ind(gamma, u)
;;;
;;; The terms k >= 2 vanish by cif-recip-power-closed-zero; linearity is line-int-sum / line-int-scalar.
;;; The finite sum is CC-SERIES-PARTIAL-SUM (the first N terms) of k |-> a_{k+1} (1/(z - u))^(k+1).
;;; Library: complex-analysis.  Helper prefix: pp-.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define pp-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define pp-pz '(DIFFERENCE CC (SINGLETON u0)))
(define (pp-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "pp-pick: nothing matching" what) (car l))))
(define (pp-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (pp-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (pp-rcp w) (list 'recip (list '- w 'u0)))
(define (pp-P n) (list 'VNB-LAMBDA 'cifv_ pp-pz (list 'power '(recip (- cifv_ u0)) n)))
(define (pp-fw w) (list 'VNB-LAMBDA 'ppj_ 'NN (list '* '(ppa_ (succ ppj_)) (list 'power (pp-rcp w) '(succ ppj_)))))
(define (pp-PP n) (list 'VNB-LAMBDA 'ppw_ pp-pz (list 'CC-SERIES-PARTIAL-SUM (pp-fw 'ppw_) n)))
(define (pp-T j) (list 'VNB-LAMBDA 'ppw_ pp-pz (list '* (list 'ppa_ (list 'succ j)) (list 'power (pp-rcp 'ppw_) (list 'succ j)))))
(define (pp-LI f) (list 'LINE-INT f 'pgam 'dgam 'a 'b))
(define pp-hyps
  (list '(IN ppa_ (FUN NN CC)) '(IN u0 CC) '(IS-ROAD pgam dgam a b) (list 'SUBSET '(TRACE pgam a b) pp-pz) '(= (pgam b) (pgam a))))

;;; the standing facts: pz open in NF and in CC-MS, a set, a subset of CC
(define (pp-setup!)
  (fact 'nf-cc-is-metric-space)
  (dk-cite! 'cc-punctured-open 'u0)
  (let ((iff (dk-cite! 'cc-ms-open-iff pp-pz)))
    (if (not (dk-asm? (list 'IS-OPEN pp-nf pp-pz)))
        (dk-have! (list 'IS-OPEN pp-nf pp-pz) (lambda () (if (dk-only! iff (list 'IS-OPEN 'CC-MS pp-pz)) (prop))))))
  (fact 'cc-is-set)
  (dk-cite! 'difference-set 'CC '(SINGLETON u0))
  (dk-cite! 'cc-open-subset-cc pp-pz)
  (dk-have! '(IN 0 NN)) (fact 'nn-succ-closed 0))
;;; w in pz: w in CC, w - u0 /= 0, 1/(w - u0) in CC
(define (pp-pt! w)
  (let ((iff (dk-cite! 'cc-punctured-membership 'u0 w)) (d (list '- w 'u0)))
    (if (not (dk-asm? (list 'IN w 'CC)))
        (dk-have! (list 'IN w 'CC) (lambda () (if (dk-only! iff (list 'IN w pp-pz)) (prop)))))
    (if (not (dk-asm? (list 'NOT (list '= w 'u0))))
        (dk-have! (list 'NOT (list '= w 'u0)) (lambda () (if (dk-only! iff (list 'IN w pp-pz)) (prop)))))
    (pp-cc! d)
    (if (not (dk-asm? (list 'NOT (list '= d 0))))
        (dk-have! (list 'NOT (list '= d 0))
          (lambda () (di) (dk-cite! 'cc-sub-zero-eq w 'u0) (ai (dk-ctx-form (list 'NOT (list '= w 'u0)))))))
    (pp-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
    (fact 'cc-recip-closed d)))
;;; (power (recip (w - u0)) n) in CC, n in NN
(define (pp-pow! w n)
  (let ((t (list 'power (pp-rcp w) n)))
    (if (not (dk-asm? (list 'IN t 'CC)))
        (begin (pp-and! (list 'IN (pp-rcp w) 'CC) (list 'IN n 'NN)) (fact 'power-typing-nonneg (pp-rcp w) n)))
    t))
;;; HOLOMORPHIC-ON pz (P (succ j)), j in NN
(define (pp-P-holo! j)
  (let ((g (list 'HOLOMORPHIC-ON pp-pz (pp-P (list 'succ j)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (let ((dd (inst*! (dk-cite! 'cif-recip-power-diff j) 'u0)))
              (fact 'nn-succ-closed j)
              (mac 'HOLOMORPHIC-ON)
              (dk-conj-close!
                (lambda ()
                  (let ((gl (dk-goal)))
                    (cond ((dk-asm? gl) (ass))
                          ((dk-head-is? gl 'IN)
                           (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (pp-pow! w (list 'succ j)) (ass)))
                                         (lambda () (ass))))
                          (#t (let ((w (dk-di-var!)))
                                (let ((r (inst*! dd w)))
                                  (ew (list-ref r 5))
                                  (ass))))))))))))
    g))
;;; HOLOMORPHIC-ON pz (T j): a constant times P (succ j)
(define (pp-T-holo! j)
  (let ((g (list 'HOLOMORPHIC-ON pp-pz (pp-T j))) (aj (list 'ppa_ (list 'succ j))) (cst (list 'VNB-LAMBDA 'hbx_ pp-pz (list 'ppa_ (list 'succ j)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'nn-succ-closed j)
            (fact 'fun-apply-type-c 'ppa_ 'NN 'CC (list 'succ j))
            (pp-P-holo! j)
            (dk-have! (list 'IS-OPEN 'CC-MS pp-pz) (lambda () (ass)))
            (fact 'holomorphic-const pp-pz aj)
            (dk-have! (list 'IN (pp-T j) (list 'FUN pp-pz 'CC))
              (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (pp-pow! w (list 'succ j)) (pp-cc! (list '* aj (list 'power (pp-rcp w) (list 'succ j)))) (ass)))
                                       (lambda () (ass)))))
            (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ pp-pz)
                        (list '== (list (pp-T j) 'hbx_) (list '* (list cst 'hbx_) (list (pp-P (list 'succ j)) 'hbx_)))))
              (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (pp-pow! w (list 'succ j)) (pp-cc! (list '* aj (list 'power (pp-rcp w) (list 'succ j))))
                           (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
            (dk-fact! 'holomorphic-product pp-pz cst (pp-P (list 'succ j)) (pp-T j))
            (if (dk-asm? (dk-goal)) (ass)))))
    g))
;;; the line-integral hypotheses for a function h holomorphic on pz: FUN, continuity
(define (pp-lil! h)
  (dk-cite! 'holomorphic-on-in-fun pp-pz h)
  (dk-cite! 'holomorphic-on-continuous pp-pz h))
;;; (fw w) in FUN(NN, CC), w in pz
(define (pp-fw-typ! w)
  (let ((g (list 'IN (pp-fw w) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                         (fact 'nn-succ-closed j) (fact 'fun-apply-type-c 'ppa_ 'NN 'CC (list 'succ j))
                                                         (pp-pow! w (list 'succ j))
                                                         (pp-cc! (list '* (list 'ppa_ (list 'succ j)) (list 'power (pp-rcp w) (list 'succ j))))
                                                         (ass)))
                                             (lambda () (fact 'nn-is-set) (ass))))))
    g))
;;; S_n(w) as a partial sum, typed: (== ((PP n) w) (PARTIAL-SUM (fw w) n))
(define (pp-PPv! n w)
  (pp-pt! w) (pp-fw-typ! w)
  (fact 'cc-series-partial-sum-in-cc n (pp-fw w))
  (let ((g (list '== (list (pp-PP n) w) (list 'CC-SERIES-PARTIAL-SUM (pp-fw w) n))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
    g))
;;; S_n in FUN(pz, CC), n in NN
(define (pp-PP-typ! n)
  (let ((g (list 'IN (pp-PP n) (list 'FUN pp-pz 'CC))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (pp-fw-typ! w)
                                                         (fact 'cc-series-partial-sum-in-cc n (pp-fw w)) (ass)))
                                             (lambda () (ass))))))
    g))
;;; S_{n+1}(w) == S_n(w) + T_n(w)
(define (pp-step-ptw! n)
  (let ((g (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ pp-pz)
             (list '== (list (pp-PP (list 'succ n)) 'hbx_) (list '+ (list (pp-PP n) 'hbx_) (list (pp-T n) 'hbx_)))))))
    (dk-have! g
      (lambda ()
        (let* ((w (dk-di-var!)) (fw (pp-fw w)) (aj (list 'ppa_ (list 'succ n))) (pw (list 'power (pp-rcp w) (list 'succ n))))
          (fact 'nn-succ-closed n)
          (pp-PPv! n w) (pp-PPv! (list 'succ n) w)
          (fact 'fun-apply-type-c 'ppa_ 'NN 'CC (list 'succ n)) (pp-pow! w (list 'succ n)) (pp-cc! (list '* aj pw))
          (fact 'fun-apply-type-c fw 'NN 'CC n)
          (dk-have! (list '== (list fw n) (list '* aj pw)) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl))))
          (dk-have! (list '== (list (pp-T n) w) (list '* aj pw)) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl))))
          (dk-rewrite-h! (list 'IN (list fw n) 'CC) (list fw n) (list '* aj pw))
          (let ((st (dk-cite! 'cc-series-partial-sum-succ fw n)))
            (subst (list '== (list (pp-PP (list 'succ n)) w) (list 'CC-SERIES-PARTIAL-SUM fw (list 'succ n))))
            (subst (list '== (list 'CC-SERIES-PARTIAL-SUM fw (list 'succ n)) (list '+ (list 'CC-SERIES-PARTIAL-SUM fw n) (list fw n))))
            (subst (list '== (list (pp-PP n) w) (list 'CC-SERIES-PARTIAL-SUM fw n)))
            (subst (list '== (list (pp-T n) w) (list '* aj pw)))
            (subst (list '== (list fw n) (list '* aj pw)))
            (if (not (proof-done? *ps*)) (qrfl))))))
    g))

;;; ---------------------------------------------------------------------------
;;; the induction
(define (pp-claim m)
  (list 'AND (list 'HOLOMORPHIC-ON pp-pz (pp-PP (list 'succ m)))
             (list '= (pp-LI (pp-PP (list 'succ m))) (list '* '(ppa_ (succ 0)) (pp-LI (pp-P '(succ 0)))))))
(sp (make-wff (list 'FORALL 'ppm_ (list 'IMPLIES '(IN ppm_ NN)
  (forall-guarded '(ppa_ u0 pgam dgam a b) pp-hyps (pp-claim 'ppm_))))))
(define pp-br (use-induction))
(define (pp-common!)
  (dk-peel!)
  (pp-setup!)
  (fact 'is-road-is-path 'pgam 'dgam 'a 'b))
;; base: S_1 = a_1 P_1
(dk-focus! (cdr (assq 'base pp-br)))
(pp-common!)
(let* ((a1 '(ppa_ (succ 0))) (P1 (pp-P '(succ 0))) (S1 (pp-PP '(succ 0)))
       (cst (list 'VNB-LAMBDA 'hbx_ pp-pz a1)))
  (fact 'fun-apply-type-c 'ppa_ 'NN 'CC '(succ 0))
  (pp-P-holo! 0)
  (pp-PP-typ! '(succ 0))
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ pp-pz) (list '== (list S1 'hbx_) (list '* (list cst 'hbx_) (list P1 'hbx_)))))
    (lambda ()
      (let* ((w (dk-di-var!)) (fw (pp-fw w)) (pw (list 'power (pp-rcp w) '(succ 0))))
        (pp-PPv! '(succ 0) w)
        (pp-PPv! 0 w)
        (pp-pow! w '(succ 0)) (pp-cc! (list '* a1 pw))
        (fact 'fun-apply-type-c fw 'NN 'CC 0)
        (dk-have! (list '== (list fw 0) (list '* a1 pw)) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl))))
        (dk-rewrite-h! (list 'IN (list fw 0) 'CC) (list fw 0) (list '* a1 pw))
        (dk-cite! 'cc-series-partial-sum-in-cc 0 fw)
        (dk-cite! 'cc-series-partial-sum-succ fw 0)
        (fact 'cc-series-partial-sum-zero fw)
        (subst (list '== (list S1 w) (list 'CC-SERIES-PARTIAL-SUM fw '(succ 0))))
        (subst (list '== (list 'CC-SERIES-PARTIAL-SUM fw '(succ 0)) (list '+ (list 'CC-SERIES-PARTIAL-SUM fw 0) (list fw 0))))
        (subst (list '== (list 'CC-SERIES-PARTIAL-SUM fw 0) 0))
        (subst (list '== (list fw 0) (list '* a1 pw)))
        (dk-lam-b!)
        (if (not (proof-done? *ps*))
            (let ((v (dk-name! (list '* a1 pw) 'CC)))
              (subst (list '= (list '* a1 pw) v))
              (dk-have! (list '= (list '+ 0 v) v) (lambda () (crs)))
              (subst (list '= (list '+ 0 v) v))
              (if (not (proof-done? *ps*)) (qrfl)))))))
  (dk-have! (list 'IS-OPEN 'CC-MS pp-pz) (lambda () (ass)))
  (fact 'holomorphic-const pp-pz a1)
  (dk-fact! 'holomorphic-product pp-pz cst P1 S1)
  (pp-lil! P1)
  (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ pp-pz) (list '== (list S1 'liz_) (list '* a1 (list P1 'liz_)))))
    (lambda () (let ((w (dk-di-var!)))
                 (inst*! (pp-pick 'ptw (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cst) (dk-contains? f S1)))) w)
                 (subst (list '== (list S1 w) (list '* (list cst w) (list P1 w))))
                 (dk-lam-b!)
                 (if (not (proof-done? *ps*)) (qrfl)))))
  (dk-chain! (dk-cite! 'line-int-scalar pp-pz P1 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
  (inst*! (pp-pick 'ls (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'lih_)))) a1 S1)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (ass)))))
;; step: S_{m+2} = S_{m+1} + T_{m+1}, and the integral of T_{m+1} is 0
(dk-focus! (cdr (assq 'step pp-br)))
(let* ((m (cdr (assq 'var pp-br))) (ih (cdr (assq 'ih pp-br))))
  (pp-common!)
  (let* ((sm (list 'succ m)) (ssm (list 'succ sm))
         (Sa (pp-PP sm)) (Sb (pp-PP ssm)) (Tm (pp-T sm))
         (a1 '(ppa_ (succ 0))) (P1 (pp-P '(succ 0))))
    (fact 'nn-succ-closed m) (fact 'nn-succ-closed sm)
    (dk-split-all! (list (inst*! ih 'ppa_ 'u0 'pgam 'dgam 'a 'b)))
    (pp-T-holo! sm)
    (pp-PP-typ! ssm)
    (pp-step-ptw! sm)
    (dk-fact! 'holomorphic-sum pp-pz Sa Tm Sb)
    (pp-P-holo! 0)
    (pp-lil! Sa) (pp-lil! Tm) (pp-lil! P1)
    (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ pp-pz) (list '== (list Sb 'liz_) (list '+ (list Sa 'liz_) (list Tm 'liz_)))))
      (lambda () (let ((w (dk-di-var!)))
                   (inst*! (pp-pick 'stp (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f Sb) (dk-contains? f Tm)))) w)
                   (ass))))
    (dk-chain! (inst*! (dk-chain! (dk-cite! 'line-int-sum pp-pz Sa Tm 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass)))) Sb)
               (lambda (ante) (lambda () (ass))))
    ;; the integral of T_{m+1} = a_{m+2} P_{m+2} is a_{m+2} * 0
    (let* ((am (list 'ppa_ ssm)) (Pm (pp-P ssm)))
      (fact 'fun-apply-type-c 'ppa_ 'NN 'CC ssm)
      (pp-P-holo! sm) (pp-lil! Pm)
      (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ pp-pz) (list '== (list Tm 'liz_) (list '* am (list Pm 'liz_)))))
        (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (pp-pow! w ssm) (pp-cc! (list '* am (list 'power (pp-rcp w) ssm)))
                     (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
      (dk-chain! (dk-cite! 'line-int-scalar pp-pz Pm 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
      (inst*! (pp-pick 'ls (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'lih_) (dk-contains? f Pm)))) am Tm)
      (dk-chain! (inst*! (dk-cite! 'cif-recip-power-closed-zero m 'u0) 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
      (let ((LS (pp-LI Sa)) (LT (pp-LI Tm)) (LP (pp-LI P1)) (LPm (pp-LI Pm)) (LB (pp-LI Sb)))
        (dk-chain! (dk-cite! 'line-int-in-cc pp-pz P1 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
        (fact 'fun-apply-type-c 'ppa_ 'NN 'CC '(succ 0))
        (pp-cc! (list '* a1 LP))
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (begin
                  (subst (list '= LB (list '+ LS LT)))
                  (subst (list '= LT (list '* am LPm)))
                  (subst (list '= LPm 0))
                  (subst (list '= LS (list '* a1 LP)))
                  (crs)))))))))
(qed 'principal-part-integral-step)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.28
(sp (make-wff (forall-guarded '(ppa_ u0 pgam dgam a b) pp-hyps
  (list 'FORALL 'ppn_ (list 'IMPLIES '(IN ppn_ NN) (list 'IMPLIES '(<= 1 ppn_)
    (list '= (list '* '(recip (* (* 2 PI) +i)) (pp-LI (pp-PP 'ppn_))) '(* (ppa_ 1) (WINDING pgam dgam a b u0)))))))))
(pp-common!)
(let* ((n (caddr (pp-pick 'n (lambda (f) (and (dk-head-is? f '<=) (eqv? (cadr f) 1))))))
       (m (dk-skolem! (dk-fact! 'nn-pos-is-succ n) #t))
       (_s (dk-split-all!))
       (P1 (pp-P '(succ 0)))
       (kern '(VNB-LAMBDA wnw_ (DIFFERENCE CC (SINGLETON u0)) (recip (- wnw_ u0))))
       (tpi '(* (* 2 PI) +i)))
  (dk-split-all! (list (dk-fact! 'principal-part-integral-step m 'ppa_ 'u0 'pgam 'dgam 'a 'b)))
  ;; P_1 is the winding kernel
  (pp-P-holo! 0)
  (dk-cite! 'holomorphic-on-in-fun pp-pz P1)
  (dk-have! (list 'IN kern (list 'FUN pp-pz 'CC))
    (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (pp-pt! w) (ass))) (lambda () (ass)))))
  (dk-fun-ext! P1 kern pp-pz 'CC #f #f
    (lambda (v) (pp-pt! v) (pp-pow! v '(succ 0)) (dk-lam-b!)
                (if (not (proof-done? *ps*))
                    (begin (pp-and! (list 'IN (pp-rcp v) 'CC) '(IN 0 NN))
                           (subst (dk-cite! 'power-succ (pp-rcp v) 0))
                           (subst (dk-cite! 'power-zero (pp-rcp v)))
                           (crs)))))
  (fact 'nn-one-is-succ-zero)
  (subst (list '= n (list 'succ m)))
  (subst (list '= (pp-LI (pp-PP (list 'succ m))) (list '* '(ppa_ (succ 0)) (pp-LI P1))))
  (subst (list '= P1 kern))
  (mac 'WINDING)
  (subst '(= (succ 0) 1))
  (dk-cite! 'winding-integrand-holomorphic 'u0)
  (pp-lil! kern)
  (dk-chain! (dk-cite! 'line-int-in-cc pp-pz kern 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
  (fact 'fun-apply-type-c 'ppa_ 'NN 'CC 1)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  (fact 'cc-i-in)
  (dk-have! (list 'IN tpi 'CC) (lambda () (type-term)))
  (dk-have! (list 'NOT (list '= tpi 0))
    (lambda () (di)
      (fact 'cc-magnitude-zero)
      (dk-have! (list '= (list 'magnitude tpi) 0) (lambda () (subst (list '= tpi 0)) (ass)))
      (fact 'cc-magnitude-i)
      (dk-have! '(IN 2 CC) (lambda () (type-term))) (dk-have! '(IN (* 2 PI) RR) (lambda () (type-term)))
      (fact 'rr-subset-cc '(* 2 PI))
      (pp-and! '(IN (* 2 PI) CC) '(IN +i CC))
      (fact 'cc-magnitude-mul '(* 2 PI) '+i)
      (fact 'rr-magnitude-is-abs '(* 2 PI))
      (dk-have! '(<= 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
      (fact 'rr-abs-of-nonneg '(* 2 PI))
      (dk-rewrite-h! (list '= (list 'magnitude tpi) 0) (list 'magnitude tpi) '(* (magnitude (* 2 PI)) (magnitude +i)))
      (dk-rewrite-h! '(= (* (magnitude (* 2 PI)) (magnitude +i)) 0) '(magnitude +i) 1)
      (dk-rewrite-h! '(= (* (magnitude (* 2 PI)) 1) 0) '(magnitude (* 2 PI)) '(abs (* 2 PI)))
      (dk-rewrite-h! '(= (* (abs (* 2 PI)) 1) 0) '(abs (* 2 PI)) '(* 2 PI))
      (dk-absurd! '(= (* (* 2 PI) 1) 0) '(< 0 PI))))
  (pp-and! (list 'IN tpi 'CC) (list 'NOT (list '= tpi 0)))
  (fact 'cc-recip-closed tpi)
  (let ((rk (dk-name! (list 'recip tpi) 'CC)))
    (subst (list '= (list 'recip tpi) rk))
    (crs)))
(qed 'principal-part-integral)

  
