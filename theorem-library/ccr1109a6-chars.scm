;;; division of a real by a positive natural number
(sp (make-wff '(FORALL a6m (IMPLIES (IN a6m NN) (IMPLIES (<= 1 a6m) (FORALL a6th (IMPLIES (IN a6th RR)
   (FORSOME a6s (AND (IN a6s RR) (= (* a6m a6s) a6th))))))))))
