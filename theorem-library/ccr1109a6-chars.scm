(define a6c-min '(FORALL a6j (IMPLIES (IN a6j NN) (IMPLIES (<= 1 a6j) (IMPLIES (< a6j a6m) (NOT (IN (ZZ-ACT a6g a6j a6b) a6h)))))))
(define (a6c-ext-pre body)
  (a6c-pre `(FORALL a6b (IMPLIES (IN a6b (CARR a6g)) (FORALL a6m (IMPLIES (IN a6m NN) (IMPLIES (<= 1 a6m)
     (IMPLIES (IN (ZZ-ACT a6g a6m a6b) a6h) (IMPLIES ,a6c-min
       (FORALL a6t (IMPLIES (IN a6t CC) (IMPLIES (= (a6c (ZZ-ACT a6g a6m a6b)) (cc-exp (* a6m a6t))) ,body))))))))))))
(define (a6c-ext-common!)
  (dk-project! '(SUBSET a6h (CARR a6g)) 'is-subgroup '(IS-SUBGROUP a6g a6h))
  (dk-project! `(FORALL sga_ (IMPLIES (IN sga_ a6h) (FORALL sgb_ (IMPLIES (IN sgb_ a6h) (IN ((OPR a6g) sga_ sgb_) a6h))))) 'is-subgroup '(IS-SUBGROUP a6g a6h))
  (dk-project! `(FORALL sga_ (IMPLIES (IN sga_ a6h) (IN ((INV a6g) sga_) a6h))) 'is-subgroup '(IS-SUBGROUP a6g a6h))
  (dk-chain-ass! (dk-cite! 'abelian-group-is-group 'a6g))
  (dk-cite! 'nn-subset-zz 'a6m) (dk-cite! 'nn-in-rr 'a6m) (dk-cite! 'rr-subset-cc 'a6m)
  (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (a6c-hclos) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sgb_) (dk-contains? f 'a6h))) "H closed under +"))
(define (a6c-hinv) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(INV a6g)) (not (dk-contains? f 'sgb_)) (dk-contains? f 'a6h))) "H closed under -"))

;; d.b in H => chi(d.b) = exp(d t)
(sp (make-wff (a6c-ext-pre '(FORALL a6d (IMPLIES (IN a6d ZZ) (IMPLIES (IN (ZZ-ACT a6g a6d a6b) a6h)
   (= (a6c (ZZ-ACT a6g a6d a6b)) (cc-exp (* a6d a6t)))))))))
(dk-peel!)
(a6c-ext-common!)
(let* ((d 'a6d) (m 'a6m) (mb '(ZZ-ACT a6g a6m a6b)) (db '(ZZ-ACT a6g a6d a6b)))
  (dk-have! '(NOT (= a6m 0)) (lambda () (di) (dk-nn-absurd! '(<= 1 a6m) '(= a6m 0))))
  (let* ((q (dk-skolem! (dk-chain-ass! (dk-cite! 'zz-division d m))))
         (r (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f q))) "the remainder")))
         (qm `(* ,q ,m)) (qmb `(ZZ-ACT a6g ,qm a6b)) (rb `(ZZ-ACT a6g ,r a6b)))
    (dk-have-and! `(IN ,q ZZ) `(IN ,m ZZ))
    (dk-chain-ass! (dk-cite! 'zz-mul-closed q m))
    (dk-cite! 'zz-act-assoc 'a6g q m 'a6b)
    (dk-cite! 'ag-subgroup-zz-act 'a6g 'a6h q mb)
    (dk-rewrite-h! `(IN (ZZ-ACT a6g ,q ,mb) a6h) `(ZZ-ACT a6g ,q ,mb) qmb)
    ;; r.b = -(qm.b) + d.b is in H
    (dk-cite! 'zz-act-type 'a6g qm 'a6b) (dk-cite! 'zz-act-type 'a6g r 'a6b)
    (dk-cite! 'zz-act-add 'a6g qm r 'a6b)
    (let* ((h1 (dk-rewrite-h! `(IN ,db a6h) d `(+ ,qm ,r)))
           (h2 (dk-rewrite-h! h1 `(ZZ-ACT a6g (+ ,qm ,r) a6b) `((OPR a6g) ,qmb ,rb))))
      (dk-cite! 'group-inv-in 'a6g qmb)
      (dk-apply! (a6c-hinv) qmb)
      (dk-apply! (a6c-hclos) `((INV a6g) ,qmb) `((OPR a6g) ,qmb ,rb))
      (dk-fact-split! 'group-inv-cancel 'a6g qmb rb)
      (dk-rewrite-h! `(IN ((OPR a6g) ((INV a6g) ,qmb) ((OPR a6g) ,qmb ,rb)) a6h)
                     `((OPR a6g) ((INV a6g) ,qmb) ((OPR a6g) ,qmb ,rb)) rb))
    ;; the remainder is 0, by the minimality of m
    (dk-have! `(= ,r 0)
      (lambda ()
        (pbc)
        (let* ((j `(abs ,r)) (jb `(ZZ-ACT a6g ,j a6b)))
          (dk-cite! 'zz-abs-in-nn r) (dk-cite! 'zz-in-rr r)
          (dk-cite! 'nn-in-rr j) (dk-cite! 'nn-subset-zz j)
          (dk-have! `(NOT (= ,j 0))
            (lambda () (di) (dk-iff-fwd! (dk-cite! 'rr-abs-zero r)) (ai `(NOT (= ,r 0)))))
          (dk-chain-ass! (dk-cite! 'nn-one-le-nonzero j))
          (dk-have! `(<= 0 ,m) (lambda () (dk-ineq! `(<= 1 ,m))))
          (dk-chain-ass! (dk-cite! 'rr-abs-of-nonneg m))
          (dk-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f r))) "the remainder bound")
            (lambda (o)
              (if (dk-head-is? o '=)
                  (ai `(NOT (= ,r 0)))
                  (let* ((lt (dk-have! `(< ,j ,m)
                               (lambda ()
                                 (dk-rewrite-h! o `(abs ,m) m)
                                 (dk-nn! `(<= (succ ,j) ,m))))))
                    (dk-cite! 'zz-act-type 'a6g j 'a6b)
                    (dk-cite! 'zz-neg-closed j)
                    (dk-or-each! (dk-cite! 'zz-abs-cases r)
                      (lambda (c)
                        (dk-cite! 'zz-act-type 'a6g (caddr c) 'a6b)
                        (dk-congr! c (lambda (x) `(ZZ-ACT a6g ,x a6b)))
                        (if (equal? (caddr c) j)
                            (dk-rewrite-h! `(IN ,rb a6h) rb jb)
                            (let* ((n1 (dk-rewrite-h! `(IN ,rb a6h) rb `(ZZ-ACT a6g (- ,j) a6b)))
                                   (e1 (dk-cite! 'zz-act-neg-sign 'a6g j 'a6b))
                                   (n2 (dk-rewrite-h! n1 `(ZZ-ACT a6g (- ,j) a6b) `((INV a6g) ,jb))))
                              (dk-apply! (a6c-hinv) `((INV a6g) ,jb))
                              (dk-cite! 'group-inv-inv 'a6g jb)
                              (dk-rewrite-h! `(IN ((INV a6g) ((INV a6g) ,jb)) a6h) `((INV a6g) ((INV a6g) ,jb)) jb)))
                        (ai (dk-apply! a6c-min j)))))))))))
    (dk-have! `(= ,d ,qm) (lambda () (subst `(= ,d (+ ,qm ,r))) (subst `(= ,r 0)) (crs)))
    (subst `(= ,d ,qm))
    (subst `(= ,qmb (ZZ-ACT a6g ,q ,mb)))
    (dk-cite! 'zz-in-rr q) (dk-cite! 'rr-subset-cc q)
    (a6-cc! '(* a6m a6t))
    (subst (dk-chain-ass! (dk-cite! 'subgroup-character-zz-act q 'a6g 'a6h 'a6c mb '(* a6m a6t))))
    (a6-cc! `(* ,qm a6t))
    (dk-have! `(= (* ,q (* a6m a6t)) (* ,qm a6t)) (lambda () (crs)))
    (subst `(= (* ,q (* a6m a6t)) (* ,qm a6t)))
    (a6-exp! `(* ,qm a6t))
    (dk-close-if! (lambda () #t) (lambda () (rfl)))))
(qed 'subgroup-adjoin-key)

;; two representations of one element give one value: p1 + k1.b = p2 + k2.b => chi(p1) e(k1 t) = chi(p2) e(k2 t)
(sp (make-wff (a6c-ext-pre '(FORALL a6p1 (IMPLIES (IN a6p1 a6h) (FORALL a6k1 (IMPLIES (IN a6k1 ZZ)
   (FORALL a6p2 (IMPLIES (IN a6p2 a6h) (FORALL a6k2 (IMPLIES (IN a6k2 ZZ)
     (IMPLIES (= ((OPR a6g) a6p1 (ZZ-ACT a6g a6k1 a6b)) ((OPR a6g) a6p2 (ZZ-ACT a6g a6k2 a6b)))
       (= (* (a6c a6p1) (cc-exp (* a6k1 a6t))) (* (a6c a6p2) (cc-exp (* a6k2 a6t))))))))))))))))
(dk-peel!)
(a6c-ext-common!)
(let* ((p1 'a6p1) (p2 'a6p2) (k1 'a6k1) (k2 'a6k2) (d `(+ ,k1 (- ,k2)))
       (db `(ZZ-ACT a6g ,d a6b)) (k1b `(ZZ-ACT a6g ,k1 a6b)) (k2b `(ZZ-ACT a6g ,k2 a6b))
       (pd `((OPR a6g) ,p1 ,db))
       (e0 (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-contains? f k1b))) "the two representations")))
  (a6c-carr! p1) (a6c-carr! p2)
  (dk-cite! 'zz-neg-closed k2)
  (dk-have-and! `(IN ,k1 ZZ) `(IN (- ,k2) ZZ))
  (dk-chain-ass! (dk-cite! 'zz-add-closed k1 `(- ,k2)))
  (for-each (lambda (k) (dk-cite! 'zz-act-type 'a6g k 'a6b)) (list d k1 k2))
  (dk-cite! 'group-carrier-closed-opr 'a6g p1 db)
  (let* ((ad (dk-cite! 'zz-act-add 'a6g d k2 'a6b))
         (dk0 (dk-have! `(= (+ ,d ,k2) ,k1) (lambda () (crs))))
         (ad1 (dk-rewrite-h! ad `(+ ,d ,k2) k1))
         (e1 (dk-rewrite-h! e0 k1b `((OPR a6g) ,db ,k2b)))
         (as (dk-cite! 'abelian-group-assoc 'a6g p1 db k2b))
         (e2 (dk-rewrite-h! e1 `((OPR a6g) ,p1 ((OPR a6g) ,db ,k2b)) `((OPR a6g) ,pd ,k2b)))
         (c1 (dk-cite! 'abelian-group-opr-comm 'a6g pd k2b))
         (c2 (dk-cite! 'abelian-group-opr-comm 'a6g p2 k2b))
         (e3 (dk-rewrite-h! e2 `((OPR a6g) ,pd ,k2b) `((OPR a6g) ,k2b ,pd)))
         (e4 (dk-rewrite-h! e3 `((OPR a6g) ,p2 ,k2b) `((OPR a6g) ,k2b ,p2))))
    (dk-chain-ass! (dk-cite! 'group-cancel-left 'a6g pd p2 k2b))
    ;; d.b = -p1 + p2 is in H
    (dk-cite! 'group-inv-in 'a6g p1)
    (dk-apply! (a6c-hinv) p1)
    (dk-apply! (a6c-hclos) `((INV a6g) ,p1) p2)
    (let* ((m1 (dk-rewrite-h! `(IN ((OPR a6g) ((INV a6g) ,p1) ,p2) a6h) p2 pd)))
      (dk-fact-split! 'group-inv-cancel 'a6g p1 db)
      (dk-rewrite-h! m1 `((OPR a6g) ((INV a6g) ,p1) ,pd) db))
    (dk-chain-ass! (dk-cite! 'subgroup-adjoin-key 'a6g 'a6h 'a6c 'a6b 'a6m 'a6t d))
    ;; the values
    (subst `(= ,p2 ,pd))
    (subst (dk-apply! a6c-hyp-hom p1 db))
    (subst `(= (a6c ,db) (cc-exp (* ,d a6t))))
    (a6c-val! 'a6c 'a6h p1)
    (for-each (lambda (k) (dk-cite! 'zz-in-rr k) (dk-cite! 'rr-subset-cc k)) (list k1 k2))
    (dk-cite! 'zz-in-rr d) (dk-cite! 'rr-subset-cc d)
    (for-each (lambda (k) (a6-cc! `(* ,k a6t)) (a6-exp! `(* ,k a6t))) (list d k1 k2))
    (dk-cite! 'cc-exp-add `(* ,d a6t) `(* ,k2 a6t))
    (let* ((c1 `(a6c ,p1)) (xd `(cc-exp (* ,d a6t))) (e2 `(cc-exp (* ,k2 a6t))))
      (dk-have! `(= (* (* ,c1 ,xd) ,e2) (* ,c1 (* ,xd ,e2))) (lambda () (crs)))
      (subst `(= (* (* ,c1 ,xd) ,e2) (* ,c1 (* ,xd ,e2))))
      (subst `(= (* ,xd ,e2) (cc-exp (+ (* ,d a6t) (* ,k2 a6t)))))
      (dk-have! `(= (+ (* ,d a6t) (* ,k2 a6t)) (* ,k1 a6t)) (lambda () (crs)))
      (subst `(= (+ (* ,d a6t) (* ,k2 a6t)) (* ,k1 a6t)))
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'subgroup-adjoin-rep-unique)

;;; ---------------------------------------------------------------------------
;;; THE EXTENDED CHARACTER psi(p + k.b) = chi(p) exp(k t), as a function on H + <b> (an IOTA per point)
(define (a6c-repv y w)
  `(FORSOME a6q (AND (IN a6q a6h) (FORSOME a6l (AND (IN a6l ZZ)
     (AND (= ,y ((OPR a6g) a6q (ZZ-ACT a6g a6l a6b))) (= ,w (* (a6c a6q) (cc-exp (* a6l a6t))))))))))
(define a6c-psi `(VNB-LAMBDA a6z ,a6c-adj0 (ADJOIN-CHAR-VALUE a6g a6h a6c a6b a6t a6z)))
;; close a goal built of FORSOME / AND / atoms: witnesses in order, atoms by context or rfl
(define (a6c-close-ex! ws)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'FORSOME) (ew (car ws)) (a6c-close-ex! (cdr ws)))
          ((dk-head-is? g 'AND)
           (let ((ls (dk-opened (lambda () (di)))))
             (for-each (lambda (l) (dk-focus! l) (a6c-close-ex! ws)) ls)))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          (#t (error "a6c-close-ex!: cannot close" (expression->string g))))))
;; P(y, w) in context: return (q l), with y = q + l.b and w = chi(q) exp(l t) landed
(define (a6c-open-v! ex)
  (let* ((q (dk-skolem! ex))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f q) (dk-contains? f 'a6t))) "the coefficient"))
         (l (dk-skolem! ex2)))
    (list q l)))

(define (a6c-acv y) `(ADJOIN-CHAR-VALUE a6g a6h a6c a6b a6t ,y))
(sp (make-wff (a6c-ext-pre `(FORALL a6pp (IMPLIES (IN a6pp a6h) (FORALL a6kk (IMPLIES (IN a6kk ZZ)
   (= ,(a6c-acv '((OPR a6g) a6pp (ZZ-ACT a6g a6kk a6b))) (* (a6c a6pp) (cc-exp (* a6kk a6t)))))))))))
(dk-peel!)
(a6c-ext-common!)
(let* ((pp 'a6pp) (kk 'a6kk) (kb `(ZZ-ACT a6g ,kk a6b)) (y `((OPR a6g) ,pp ,kb))
       (v `(* (a6c ,pp) (cc-exp (* ,kk a6t)))))
  (a6c-carr! pp) (dk-cite! 'zz-act-type 'a6g kk 'a6b)
  (dk-cite! 'group-carrier-closed-opr 'a6g pp kb)
  (a6c-val! 'a6c 'a6h pp)
  (dk-cite! 'zz-in-rr kk) (dk-cite! 'rr-subset-cc kk)
  (a6-cc! `(* ,kk a6t)) (a6-exp! `(* ,kk a6t)) (a6-cc! v)
  (mac 'ADJOIN-CHAR-VALUE)
  (let* ((io (cadr (dk-goal)))
         (ls (dk-opened (lambda () (iota-d io))))
         (main (find-first (lambda (l) (dk-head-is? (dk-goal-of l) '=)) ls))
         (obl (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'FORSOME)) ls)))
    (dk-focus! obl)
    (ew v)
    (let ((ls2 (dk-opened (lambda () (di)))))
      (for-each
        (lambda (l)
          (dk-focus! l)
          (if (not (dk-head-is? (dk-goal) 'FORALL))
              (a6c-close-ex! (list pp kk))
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (cj (find-first (lambda (f) (dk-head-is? f 'AND)) landed))
                     (sp1 (if cj (dk-split! cj) #f))
                     (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f (caddr (dk-goal))) (dk-contains? f 'a6t))) "the other representation"))
                     (w (caddr (dk-goal)))
                     (ql (a6c-open-v! ex)) (q (car ql)) (l1 (cadr ql))
                     (vq `(* (a6c ,q) (cc-exp (* ,l1 a6t)))))
                (dk-chain-ass! (dk-cite! 'subgroup-adjoin-rep-unique 'a6g 'a6h 'a6c 'a6b 'a6m 'a6t pp kk q l1))
                (subst `(= ,w ,vq))
                (dk-close-if-asm!))))
        ls2))
    (dk-focus! main)
    (let* ((cj (dk-pick (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f io))) "the defining property"))
           (sp1 (dk-split! cj))
           (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f io))) "the defining property"))
           (ql (a6c-open-v! ex)) (q (car ql)) (l1 (cadr ql))
           (vq `(* (a6c ,q) (cc-exp (* ,l1 a6t)))))
      (dk-chain-ass! (dk-cite! 'subgroup-adjoin-rep-unique 'a6g 'a6h 'a6c 'a6b 'a6m 'a6t pp kk q l1))
      (subst `(= ,io ,vq))
      (subst `(= ,v ,vq))
      (a6c-val! 'a6c 'a6h q)
      (dk-cite! 'zz-in-rr l1) (dk-cite! 'rr-subset-cc l1)
      (a6-exp! `(* ,l1 a6t))
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'adjoin-char-value-spec)

;;; ---------------------------------------------------------------------------
;;; THE EXTENSION: psi is a character of H + <b>, equal to chi on H, with psi(b) = exp(t)
(define a6c-mag '(FORALL a6r (IMPLIES (IN a6r ZZ) (= (magnitude (cc-exp (* a6r a6t))) 1))))
(define a6c-psi-hom (a6c-hom a6c-psi a6c-adj0 'a6g))
;; p in H, k in ZZ typed: land psi(p + k.b) = chi(p) exp(k t) and return that value
(define (a6c-psi-val! p k)
  (let* ((kb `(ZZ-ACT a6g ,k a6b)) (y `((OPR a6g) ,p ,kb))
         (v `(* (a6c ,p) (cc-exp (* ,k a6t)))) (acv (a6c-acv y)) (claim `(= (,a6c-psi ,y) ,v)))
    (if (not (dk-asm? claim))
        (begin
          (a6c-carr! p) (dk-cite! 'zz-act-type 'a6g k 'a6b)
          (dk-cite! 'group-carrier-closed-opr 'a6g p kb)
          (if (not (dk-asm? `(IN ,y ,a6c-adj0)))
              (dk-have! `(IN ,y ,a6c-adj0) (lambda () (a6c-in-adj! p k (lambda () (rfl))))))
          (a6c-val! 'a6c 'a6h p)
          (dk-cite! 'zz-in-rr k) (dk-cite! 'rr-subset-cc k)
          (a6-cc! `(* ,k a6t)) (a6-exp! `(* ,k a6t)) (a6-cc! v)
          (dk-cite! 'adjoin-char-value-spec 'a6g 'a6h 'a6c 'a6b 'a6m 'a6t p k)
          (dk-have! `(IN ,acv CC) (lambda () (subst `(= ,acv ,v)) (dk-ass!)))
          (dk-have! claim (lambda () (dk-lam-b!) (dk-close-if-asm!)))))
    v))

(sp (make-wff (a6c-ext-pre `(IMPLIES ,a6c-mag
  (AND (IN ,a6c-psi (FUN ,a6c-adj0 UNIT-CIRCLE))
   (AND ,a6c-psi-hom
   (AND (FORALL a6x (IMPLIES (IN a6x a6h) (= (,a6c-psi a6x) (a6c a6x))))
        (= (,a6c-psi a6b) (cc-exp a6t)))))))))
(dk-peel!)
(a6c-ext-common!)
(dk-cite! 'group-identity-in 'a6g)
(dk-project! '(IN (IDEN a6g) a6h) 'is-subgroup '(IS-SUBGROUP a6g a6h))
(let* ((e '(IDEN a6g)) (psi a6c-psi) (adj a6c-adj0)
       (magl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'magnitude))) "the magnitude law")))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ;; typing
          ((and (dk-head-is? g 'IN) (dk-contains? g 'FUN))
           (for-each
             (lambda (l)
               (dk-focus! l)
               (if (dk-head-is? (dk-goal) 'FORALL)
                   (let* ((landed (dk-landed (lambda () (dk-peel!))))
                          (z (cadr (car landed)))
                          (pk (a6c-open! z 'a6h 'a6b 'a6g)) (p (car pk)) (k (cadr pk))
                          (kb `(ZZ-ACT a6g ,k a6b)) (y `((OPR a6g) ,p ,kb))
                          (v `(* (a6c ,p) (cc-exp (* ,k a6t)))))
                     (subst `(= ,z ,y))
                     (a6c-val! 'a6c 'a6h p)
                     (dk-cite! 'zz-in-rr k) (dk-cite! 'rr-subset-cc k)
                     (a6-cc! `(* ,k a6t)) (a6-exp! `(* ,k a6t)) (a6-cc! v)
                     (subst (dk-cite! 'adjoin-char-value-spec 'a6g 'a6h 'a6c 'a6b 'a6m 'a6t p k))
                     (dk-have! `(= (magnitude ,v) 1)
                       (lambda ()
                         (dk-have-and! `(IN (a6c ,p) CC) `(IN (cc-exp (* ,k a6t)) CC))
                         (subst (dk-chain-ass! (dk-cite! 'cc-magnitude-mul `(a6c ,p) `(cc-exp (* ,k a6t)))))
                         (subst `(= (magnitude (a6c ,p)) 1))
                         (subst (dk-apply! magl k))
                         (dk-close-if! (lambda () (arith)) (lambda () (rfl)))))
                     (dk-have-and! `(IN ,v CC) `(= (magnitude ,v) 1))
                     (dk-iff-bwd! (dk-cite! 'unit-circle-membership v))
                     (dk-close-if-asm!))
                   (begin
                     (dk-cite! 'group-carr-set 'a6g)
                     (dk-close-if! (lambda () (sep-set)) (lambda () (dk-ass!))))))
             (dk-opened (lambda () (lam-t)))))
          ;; psi(x) = chi(x) on H
          ((and (dk-head-is? g 'FORALL) (not (dk-contains? g 'a6v)))
           (let* ((landed (dk-landed (lambda () (dk-peel!)))) (x (cadr (car landed))))
             (fact 'zz-zero-in)
             (let* ((v (a6c-psi-val! x 0))
                    (h0 (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) v))) "psi(x + 0.b)"))
                    (z0 (dk-cite! 'zz-act-zero 'a6g 'a6b))
                    (h1 (dk-rewrite-h! h0 '(ZZ-ACT a6g 0 a6b) e))
                    (r0 (dk-cite! 'abelian-group-right-id 'a6g x))
                    (h2 (dk-rewrite-h! h1 `((OPR a6g) ,x ,e) x))
                    (m0 (dk-have! '(= (* 0 a6t) 0) (lambda () (crs))))
                    (h3 (dk-rewrite-h! h2 '(* 0 a6t) 0))
                    (x0 (dk-cite! 'cc-exp-zero))
                    (h4 (dk-rewrite-h! h3 '(cc-exp 0) 1))
                    (m1 (dk-have! `(= (* (a6c ,x) 1) (a6c ,x)) (lambda () (crs))))
                    (h5 (dk-rewrite-h! h4 `(* (a6c ,x) 1) `(a6c ,x))))
               (dk-close-if-asm!))))
          ;; psi(b) = exp(t)
          ((dk-head-is? g '=)
           (let* ((v (a6c-psi-val! e 1))
                  (h0 (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) v))) "psi(0 + 1.b)"))
                  (z1 (dk-cite! 'zz-act-one 'a6g 'a6b))
                  (h1 (dk-rewrite-h! h0 '(ZZ-ACT a6g 1 a6b) 'a6b))
                  (l0 (dk-cite! 'group-left-id 'a6g 'a6b))
                  (h2 (dk-rewrite-h! h1 `((OPR a6g) ,e a6b) 'a6b))
                  (c0 (dk-cite! 'subgroup-character-iden 'a6g 'a6h 'a6c))
                  (h3 (dk-rewrite-h! h2 `(a6c ,e) 1))
                  (m0 (dk-have! '(= (* 1 a6t) a6t) (lambda () (crs))))
                  (h4 (dk-rewrite-h! h3 '(* 1 a6t) 'a6t))
                  (m1 (begin (a6-exp! 'a6t) (dk-have! '(= (* 1 (cc-exp a6t)) (cc-exp a6t)) (lambda () (crs)))))
                  (h5 (dk-rewrite-h! h4 '(* 1 (cc-exp a6t)) '(cc-exp a6t))))
             (dk-close-if-asm!)))
          ;; the homomorphism law
          (#t
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (ys (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                  (u (car ys)) (w (cadr ys))
                  (pk1 (a6c-open! u 'a6h 'a6b 'a6g)) (pk2 (a6c-open! w 'a6h 'a6b 'a6g))
                  (p1 (car pk1)) (k1 (cadr pk1)) (p2 (car pk2)) (k2 (cadr pk2))
                  (kb1 `(ZZ-ACT a6g ,k1 a6b)) (kb2 `(ZZ-ACT a6g ,k2 a6b))
                  (p12 `((OPR a6g) ,p1 ,p2)) (k12 `(+ ,k1 ,k2)))
             (a6c-carr! p1) (a6c-carr! p2)
             (dk-cite! 'zz-act-type 'a6g k1 'a6b) (dk-cite! 'zz-act-type 'a6g k2 'a6b)
             (dk-apply! (a6c-hclos) p1 p2)
             (dk-have-and! `(IN ,k1 ZZ) `(IN ,k2 ZZ))
             (dk-chain-ass! (dk-cite! 'zz-add-closed k1 k2))
             (subst `(= ,u ((OPR a6g) ,p1 ,kb1)))
             (subst `(= ,w ((OPR a6g) ,p2 ,kb2)))
             (dk-cite! 'zz-act-add 'a6g k1 k2 'a6b)
             (dk-cite! 'abelian-group-opr-interchange 'a6g p1 kb1 p2 kb2)
             (subst `(= ((OPR a6g) ((OPR a6g) ,p1 ,kb1) ((OPR a6g) ,p2 ,kb2)) ((OPR a6g) ,p12 ((OPR a6g) ,kb1 ,kb2))))
             (subst `(= ((OPR a6g) ,kb1 ,kb2) (ZZ-ACT a6g ,k12 a6b)))
             (let* ((v12 (a6c-psi-val! p12 k12)) (v1 (a6c-psi-val! p1 k1)) (v2 (a6c-psi-val! p2 k2)))
               (subst `(= (,psi ((OPR a6g) ,p12 (ZZ-ACT a6g ,k12 a6b))) ,v12))
               (subst `(= (,psi ((OPR a6g) ,p1 ,kb1)) ,v1))
