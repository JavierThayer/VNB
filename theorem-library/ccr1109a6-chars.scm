;;; THE LEAST m >= 1 WITH m.b IN H (G finite)
(define (a6c-guard-m m) `(AND (IN ,m NN) (AND (<= 1 ,m) (IN (ZZ-ACT a6g ,m a6b) a6h))))
(sp (make-wff `(FORALL a6g (IMPLIES (IS-ABELIAN-GROUP a6g) (IMPLIES (IN (CARD (CARR a6g)) NN)
  (FORALL a6h (IMPLIES (IS-SUBGROUP a6g a6h) (FORALL a6b (IMPLIES (IN a6b (CARR a6g))
    (FORSOME a6m (AND (IN a6m NN) (AND (<= 1 a6m) (AND (IN (ZZ-ACT a6g a6m a6b) a6h) ,a6c-min)))))))))))))
(dk-peel!)
(dk-project! '(IN (IDEN a6g) a6h) 'is-subgroup '(IS-SUBGROUP a6g a6h))
(dk-chain-ass! (dk-cite! 'ag-zz-act-period 'a6g 'a6b))
(let* ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h '(IDEN a6g)))) "the period") #t)))
  (dk-split-all!)
  (let* ((r (minimize! '(a6m) (a6c-guard-m 'a6m) 'a6m))
         (w (car (car r))) (ty (cadr r)) (ne (caddr r))
         (main (proof-state-focus *ps*)))
    (if ty (begin (dk-focus! ty)
                  (let ((landed (dk-landed (lambda () (dk-peel!)))))
                    (dk-split-all! landed) (dk-close-if-asm!))))
    (if ne (begin (dk-focus! ne)
                  (ew n)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (dk-ass!)
                          (begin (subst `(= (ZZ-ACT a6g ,n a6b) (IDEN a6g))) (dk-close-if-asm!)))))))
    (dk-focus! main)
    (dk-split-all! (list (dk-pick (lambda (h) (alpha-equiv? h (a6c-guard-m w))) "the guard at the minimum")))
    (let ((minl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w) (dk-contains? h '<=))) "the minimality")))
      (ew w)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (j (cadr (car landed))))
                (if (dk-head-is? (dk-goal) 'NOT) (di))
                (dk-have-and! `(IN ,j NN) `(<= 1 ,j) `(IN (ZZ-ACT a6g ,j a6b) a6h))
                (dk-apply! minl j)
                (dk-nn-absurd! `(<= ,w ,j) `(< ,j ,w)))))))))
