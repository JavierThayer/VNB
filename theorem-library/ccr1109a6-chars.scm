     (FORSOME a6cc (AND (IN a6cc (FUN ,hh UNIT-CIRCLE)) (AND ,(a6c-hom 'a6cc hh 'a6g) (NOT (= (a6cc a6x0) 1)))))))))
;; H subset G in context: land H in POWER(G)
(define (a6c-pow! h)
  (if (not (dk-asm? `(IN ,h (POWER (CARR a6g)))))
      (begin
        (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set h '(CARR a6g)))
