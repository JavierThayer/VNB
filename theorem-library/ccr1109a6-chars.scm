           (dk-chain-ass! (dk-cite! (if (eq? (car t) '*) 'cc-mul-closed 'cc-add-closed) (cadr t) (caddr t))))
          ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
           (a6-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)))
          ((eqv? t +i) (fact 'cc-i-in))
          ((dk-asm? `(IN ,t RR)) (dk-cite! 'rr-subset-cc t))
          ((dk-asm? `(IN ,t ZZ)) (dk-cite! 'zz-in-rr t) (dk-cite! 'rr-subset-cc t))
          ((dk-asm? `(IN ,t NN)) (dk-cite! 'nn-in-rr t) (dk-cite! 'rr-subset-cc t))
          ((number? t) (dk-cite! 'rr-subset-cc t))
          (#t (error "a6-cc!: cannot type" (expression->string t))))))
