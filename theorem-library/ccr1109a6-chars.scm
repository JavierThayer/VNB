;;; ---------------------------------------------------------------------------
;;; THE TRIVIAL SUBGROUP {0} AND ITS TRIVIAL CHARACTER
(define a6c-h0 '(SEP a6y0 (CARR a6g) (= a6y0 (IDEN a6g))))
(define a6c-c0 `(VNB-LAMBDA a6z0 ,a6c-h0 1))
;; 1 is a point of the unit circle
(define (a6-one-t!)
  (if (not (dk-asm? '(IN 1 UNIT-CIRCLE)))
      (begin
        (fact 'rr-one-in) (dk-cite! 'rr-subset-cc 1)
        (dk-cite! 'rr-magnitude-is-abs 1)
