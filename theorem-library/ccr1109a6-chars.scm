          (lambda ()
            (let* ((landed (dk-landed (lambda () (dk-peel!)))) (z (cadr (car landed))))
              (dk-chain-ass! (dk-cite! 'subset-mem-fwd h '(CARR a6g) z))
              (dk-close-if-asm!))))
        (dk-have-and! `(IN ,h SET) `(FORALL a6zz (IMPLIES (IN a6zz ,h) (IN a6zz (CARR a6g)))))
        (dk-iff-bwd! (dk-cite! 'power-set-membership '(CARR a6g) h)))))
(define (a6c-meas hh) `(CARD (DIFFERENCE (CARR a6g) ,hh)))
(sp (make-wff `(FORALL a6g (IMPLIES (IS-ABELIAN-GROUP a6g) (IMPLIES (IN (CARD (CARR a6g)) NN)
  (FORALL a6x0 (IMPLIES (IN a6x0 (CARR a6g)) (IMPLIES (NOT (= a6x0 (IDEN a6g)))
    (FORSOME a6c (AND (IN a6c (FUN (CARR a6g) UNIT-CIRCLE))
      (AND ,(a6c-hom 'a6c '(CARR a6g) 'a6g) (NOT (= (a6c a6x0) 1)))))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'abelian-group-is-group 'a6g))
(dk-cite! 'group-carr-set 'a6g)
(dk-cite! 'group-identity-in 'a6g)
(dk-chain-ass! (dk-cite! 'ag-trivial-subgroup-character 'a6g))
(dk-split-all!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(let* ((h0 a6c-h0) (c0 a6c-c0) (h1 (a6c-adj h0 'a6x0 'a6g)))
  ;; the least m with m.x0 = 0, and m >= 2
  (dk-chain-ass! (dk-cite! 'subgroup-adjoin-least 'a6g h0 'a6x0))
  (let* ((m (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'a6j))) "the least m") #t))
         (mx `(ZZ-ACT a6g ,m a6x0)))
    (dk-split-all!)
    (dk-cite! 'nn-in-rr m)
    (dk-have! `(NOT (= ,m 1))
      (lambda ()
        (di)
        (let* ((h (dk-rewrite-h! `(IN ,mx ,h0) m 1)))
          (dk-cite! 'zz-act-one 'a6g 'a6x0)
          (dk-sep-parts! (dk-rewrite-h! h '(ZZ-ACT a6g 1 a6x0) 'a6x0))
          (ai '(NOT (= a6x0 (IDEN a6g)))))))
    (dk-have! `(<= 2 ,m)
      (lambda ()
        (fact 'rr-one-in)
        (use-em `(< 1 ,m)
          (lambda ()
            (fact 'nn-one-in)
            (dk-chain-ass! (dk-cite! 'nn-lt-succ-le 1 m))
            (dk-cite! 'nn-succ-plus-one 1)
            (dk-ineq! (dk-rewrite-h! `(<= (succ 1) ,m) '(succ 1) '(+ 1 1)) `(IN ,m RR)))
          (lambda ()
            (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 1 m))
            (dk-have! `(= ,m 1) (lambda () (dk-ineq! `(<= ,m 1) `(<= 1 ,m) `(IN ,m RR))))
            (dk-only! `(= ,m 1) `(NOT (= ,m 1)))
            (prop)))))
    ;; a primitive m-th root of unity q = exp(i th)
    (dk-chain-ass! (dk-cite! 'cc-root-of-unity-exists m))
    (let* ((q (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h m) (dk-contains? h 'magnitude))) "the root of unity") #t)))
      (dk-split-all!)
      (dk-have-and! `(IN ,q CC) `(= (magnitude ,q) 1))
      (dk-iff-bwd! (dk-cite! 'unit-circle-membership q))
      (dk-chain-ass! (dk-cite! 'unit-circle-polar q))
      (let* ((th (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h q) (dk-contains? h 'cc-exp))) "the angle") #t))
             (t `(* +i ,th)))
        (dk-split-all!)
        (a6-cc! t) (a6-exp! t)
        (dk-have! `(= (,c0 ,mx) (cc-exp (* ,m ,t)))
          (lambda ()
            (dk-lam-b!)
            (let* ((e (dk-cite! 'exp-power-nn m t)) (pw (car (cadr e))))
              (subst `(= ,(caddr e) ,(cadr e)))
              (subst `(= (cc-exp ,t) ,q))
              (subst `(= (,pw ,q ,m) 1))
              (rfl))))
        (dk-cite! 'cc-exp-zz-imaginary-magnitude th)
        (dk-chain-ass! (dk-cite! 'subgroup-character-extend 'a6g h0 c0 'a6x0 m t))
        (dk-split-all!)
        (dk-chain-ass! (dk-cite! 'ag-subgroup-adjoin 'a6g h0 'a6x0))
        (dk-split-all!)
        (let* ((psi1 `(VNB-LAMBDA a6z ,h1 (ADJOIN-CHAR-VALUE a6g ,h0 ,c0 a6x0 ,t a6z)))
               (r (minimize! '(a6hh) (a6c-good 'a6hh) (a6c-meas 'a6hh)))
               (hs (car (car r))) (ty (cadr r)) (ne (caddr r))
               (main (proof-state-focus *ps*)))
          ;; the measure is a natural number
          (if ty
              (begin
                (dk-focus! ty)
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (hh (cadr (dk-goal-of (proof-state-focus *ps*)))))
                  (let* ((hv (caddr (cadr (cadr (dk-goal))))))
                    (dk-cite! 'difference-set '(CARR a6g) hv)
                    (dk-have-and! '(IN (CARR a6g) SET) '(IN (CARD (CARR a6g)) NN))
                    (dk-chain-ass! (dk-cite! 'card-subset-nn '(CARR a6g)))
                    (dk-have! `(FORALL a6zz (IMPLIES (IN a6zz (DIFFERENCE (CARR a6g) ,hv)) (IN a6zz (CARR a6g))))
                      (lambda () (dk-peel!) (dk-iff-fwd! (dk-cite! 'difference-membership '(CARR a6g) hv 'a6zz)) (dk-close-if-asm!)))
                    (dk-have-and! `(IN (DIFFERENCE (CARR a6g) ,hv) SET)
                                  `(FORALL a6zz (IMPLIES (IN a6zz (DIFFERENCE (CARR a6g) ,hv)) (IN a6zz (CARR a6g)))))
                    (dk-chain-ass! (dk-cite! 'card-subset-nn '(CARR a6g) `(DIFFERENCE (CARR a6g) ,hv)))
                    (dk-close-if-asm!)))))
          ;; H1 = {0} + <x0> with psi1 is good
          (if ne
              (begin
                (dk-focus! ne)
                (dk-project! `(SUBSET ,h1 (CARR a6g)) 'is-subgroup `(IS-SUBGROUP a6g ,h1))
                (a6c-pow! h1)
                (ew h1)
                (dk-conj-close!
                  (lambda ()
                    (cond
                      ((dk-asm? (dk-goal)) (dk-ass!))
                      ((dk-head-is? (dk-goal) 'FORSOME)
                       (ew psi1)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (dk-ass!)
                               (begin
                                 (di)
                                 (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) 1) (equal? (cadr f) `(,psi1 a6x0)))) "psi(x0) = 1"))
                                        (h2 (dk-rewrite-h! h `(,psi1 a6x0) `(cc-exp ,t)))
                                        (h3 (dk-rewrite-h! h2 `(cc-exp ,t) q)))
                                   (ai `(NOT (= ,q 1)))))))))
                      (#t (error "a6c ne: unexpected" (expression->string (dk-goal)))))))))
          (dk-focus! main)
          (let* ((gd (dk-pick (lambda (h) (alpha-equiv? h (a6c-good hs))) "the minimum"))
                 (minl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h hs) (dk-contains? h 'CARD))) "the minimality")))
            (dk-split-all! (list gd))
            (let* ((cs (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h hs) (dk-contains? h 'a6x0))) "the character") #t)))
              (dk-split-all!)
              (dk-project! `(SUBSET ,hs (CARR a6g)) 'is-subgroup `(IS-SUBGROUP a6g ,hs))
              (dk-cite! 'difference-set '(CARR a6g) hs)
              ;; every b of G lies in H*
              (dk-have! `(FORALL a6bb (IMPLIES (IN a6bb (CARR a6g)) (IN a6bb ,hs)))
                (lambda ()
                  (let* ((landed (dk-landed (lambda () (dk-peel!)))) (b (cadr (car landed))))
                    (use-em `(IN ,b ,hs)
                      (lambda () (dk-ass!))
                      (lambda ()
                        (dk-chain-ass! (dk-cite! 'subgroup-character-step 'a6g hs cs b))
                        (let* ((h2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h hs) (dk-contains? h b))) "the bigger subgroup") #t)))
                          (dk-split-all!)
                          (let* ((c2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h h2) (dk-contains? h 'UNIT-CIRCLE))) "its character") #t)))
                            (dk-split-all!)
                            (dk-chain-ass! (dk-cite! 'subset-mem-fwd hs h2 'a6x0))
                            (let* ((agr (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h c2) (dk-contains? h cs))) "agreement"))
                                   (e0 (dk-apply! agr 'a6x0)))
                              (dk-project! `(SUBSET ,h2 (CARR a6g)) 'is-subgroup `(IS-SUBGROUP a6g ,h2))
                              (a6c-pow! h2)
                              (dk-have! (a6c-good h2)
                                (lambda ()
                                  (dk-conj-close!
                                    (lambda ()
                                      (cond
                                        ((dk-asm? (dk-goal)) (dk-ass!))
                                        ((dk-head-is? (dk-goal) 'FORSOME)
                                         (ew c2)
                                         (dk-conj-close!
                                           (lambda ()
                                             (if (dk-asm? (dk-goal)) (dk-ass!)
                                                 (begin (subst `(= (,c2 a6x0) (,cs a6x0))) (dk-close-if-asm!))))))
                                        (#t (error "a6c good: unexpected" (expression->string (dk-goal)))))))))
                              (dk-apply! minl h2)
                              (dk-cite! 'difference-set '(CARR a6g) h2)
                              (let* ((ds `(DIFFERENCE (CARR a6g) ,hs)) (d2 `(DIFFERENCE (CARR a6g) ,h2)))
                                (dk-have! `(SUBSET ,d2 ,ds)
                                  (lambda ()
                                    (mac 'subset-def)
                                    (let* ((landed (dk-landed (lambda () (dk-peel!)))) (z (cadr (car landed))))
                                      (dk-iff-fwd! (dk-cite! 'difference-membership '(CARR a6g) h2 z))
                                      (dk-have! `(NOT (IN ,z ,hs))
                                        (lambda () (di) (dk-chain-ass! (dk-cite! 'subset-mem-fwd hs h2 z)) (ai `(NOT (IN ,z ,h2)))))
                                      (dk-have-and! `(IN ,z (CARR a6g)) `(NOT (IN ,z ,hs)))
                                      (dk-iff-bwd! (dk-cite! 'difference-membership '(CARR a6g) hs z))
                                      (dk-close-if-asm!))))
                                ;; card(D*) in NN
                                (dk-have-and! '(IN (CARR a6g) SET) '(IN (CARD (CARR a6g)) NN))
                                (dk-chain-ass! (dk-cite! 'card-subset-nn '(CARR a6g)))
                                (dk-have! `(FORALL a6zz (IMPLIES (IN a6zz ,ds) (IN a6zz (CARR a6g))))
                                  (lambda () (dk-peel!) (dk-iff-fwd! (dk-cite! 'difference-membership '(CARR a6g) hs 'a6zz)) (dk-close-if-asm!)))
                                (dk-have-and! `(IN ,ds SET) `(FORALL a6zz (IMPLIES (IN a6zz ,ds) (IN a6zz (CARR a6g)))))
                                (dk-chain-ass! (dk-cite! 'card-subset-nn '(CARR a6g) ds))
                                (dk-chain-ass! (dk-cite! 'subset-card-eq d2 ds))
                                (dk-have-and! `(IN ,b (CARR a6g)) `(NOT (IN ,b ,hs)))
                                (dk-iff-bwd! (dk-cite! 'difference-membership '(CARR a6g) hs b))
                                (let* ((hb (dk-rewrite-h! `(IN ,b ,ds) ds d2)))
                                  (dk-iff-fwd! (dk-cite! 'difference-membership '(CARR a6g) h2 b))
                                  (ai `(NOT (IN ,b ,h2)))))))))))))
              ;; so H* = G
              (let ((all (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a6bb))) "H* = G")))
                (dk-have! `(FORALL a6xx (IFF (IN a6xx ,hs) (IN a6xx (CARR a6g))))
                  (lambda ()
                    (di)
                    (for-each
                      (lambda (l)
                        (dk-focus! l)
                        (let* ((g (dk-goal)) (x (cadr g)))
                          (if (equal? (caddr g) '(CARR a6g))
                              (dk-chain-ass! (dk-cite! 'subset-mem-fwd hs '(CARR a6g) x))
                              (dk-apply! all x))
                          (dk-close-if-asm!)))
                      (dk-opened (lambda () (di))))))
                (dk-chain-ass! (dk-cite! 'class-extensionality hs '(CARR a6g)))
                (ew cs)
                (subst `(= (CARR a6g) ,hs))
                (dk-conj-close! (lambda () (dk-ass!)))))))))))
(qed 'finite-ag-character-separates)
