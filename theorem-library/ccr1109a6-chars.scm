;;; ONE STEP: a character of H extends to a subgroup containing H and b (G finite)
(define (a6c-agree c2 c h) `(FORALL a6x (IMPLIES (IN a6x ,h) (= (,c2 a6x) (,c a6x)))))
(sp (make-wff (a6c-pre `(IMPLIES (IN (CARD (CARR a6g)) NN) (FORALL a6b (IMPLIES (IN a6b (CARR a6g))
  (FORSOME a6h2 (AND (IS-SUBGROUP a6g a6h2) (AND (SUBSET a6h a6h2) (AND (IN a6b a6h2)
    (FORSOME a6c2 (AND (IN a6c2 (FUN a6h2 UNIT-CIRCLE)) (AND ,(a6c-hom 'a6c2 'a6h2 'a6g) ,(a6c-agree 'a6c2 'a6c 'a6h))))))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'subgroup-adjoin-least 'a6g 'a6h 'a6b))
(let* ((m (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'a6j))) "the least m") #t)))
  (dk-split-all!)
  (let* ((mb `(ZZ-ACT a6g ,m a6b)))
    (dk-cite! 'fun-apply-type-c 'a6c 'a6h 'UNIT-CIRCLE mb)
    (dk-chain-ass! (dk-cite! 'unit-circle-polar `(a6c ,mb)))
    (let* ((th (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h `(a6c ,mb)))) "the angle") #t)))
      (dk-split-all!)
      (dk-chain-ass! (dk-cite! 'rr-divide-by-positive-nn m th))
      (let* ((s (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h th))) "th / m") #t))
             (t `(* +i ,s)))
        (dk-split-all!)
        (a6-cc! t) (a6-cc! m) (a6-cc! `(* ,m ,s))
        (dk-have! `(= (a6c ,mb) (cc-exp (* ,m ,t)))
          (lambda ()
            (subst `(= (a6c ,mb) (cc-exp (* +i ,th))))
            (dk-have! `(= (* ,m ,t) (* +i (* ,m ,s))) (lambda () (crs)))
            (subst `(= (* ,m ,t) (* +i (* ,m ,s))))
            (subst `(= (* ,m ,s) ,th))
            (a6-exp! `(* +i ,th))
            (rfl)))
        (dk-cite! 'cc-exp-zz-imaginary-magnitude s)
        (dk-chain-ass! (dk-cite! 'subgroup-character-extend 'a6g 'a6h 'a6c 'a6b m t))
        (dk-split-all!)
        (dk-chain-ass! (dk-cite! 'ag-subgroup-adjoin 'a6g 'a6h 'a6b))
        (dk-split-all!)
        (ew a6c-adj0)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (dk-ass!)
                (begin
                  (ew `(VNB-LAMBDA a6z ,a6c-adj0 (ADJOIN-CHAR-VALUE a6g a6h a6c a6b ,t a6z)))
                  (dk-conj-close! (lambda () (dk-ass!)))))))))))
(qed 'subgroup-character-step)

