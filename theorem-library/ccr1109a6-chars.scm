           (m0 (dk-rewrite-h! m 'a6w 0)))
      (fact 'cc-magnitude-zero)
      (dk-absurd! (dk-rewrite-h! m0 '(magnitude 0) 0)))))
(dk-chain-ass! (dk-cite! 'cc-polar-form 'a6w))
(let* ((r (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'cxsr_))) "the polar form") #t))
       (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the angle"))
       (th (dk-skolem! ex2 #t)))
  (dk-split-all!)
  (let* ((e `(cc-exp (* +i ,th))) (re `(* ,r ,e)))
    (a6-exp! `(* +i ,th))
    (dk-cite! 'rr-subset-cc r)
    (dk-cite! 'cc-exp-magnitude-imaginary th)
    (dk-have-and! `(IN ,r CC) `(IN ,e CC))
    (dk-chain-ass! (dk-cite! 'cc-magnitude-mul r e))
    (dk-cite! 'rr-magnitude-is-abs r)
    (dk-have! `(<= 0 ,r) (lambda () (dk-ineq! `(< 0 ,r) `(IN ,r RR))))
    (dk-chain-ass! (dk-cite! 'rr-abs-of-nonneg r))
    (let* ((m (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) '(magnitude a6w)))) "|w| = 1"))
           (h1 (dk-rewrite-h! m 'a6w re))
           (h2 (dk-rewrite-h! h1 `(magnitude ,re) `(* (magnitude ,r) (magnitude ,e))))
           (h3 (dk-rewrite-h! h2 `(magnitude ,e) 1))
           (h4 (dk-rewrite-h! h3 `(magnitude ,r) `(abs ,r)))
           (h5 (dk-rewrite-h! h4 `(abs ,r) r)))
      (dk-have! `(= ,r 1) (lambda () (dk-ineq! h5 `(IN ,r RR))))
      (ew th)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (begin
                (subst `(= a6w ,re))
                (subst `(= ,r 1))
                (crs))))))))
(qed 'unit-circle-polar)

