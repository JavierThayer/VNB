               (for-each (lambda (k) (a6-cc! `(* ,k a6t)) (a6-exp! `(* ,k a6t))) (list k1 k2))
               (dk-have! `(= (* ,k12 a6t) (+ (* ,k1 a6t) (* ,k2 a6t))) (lambda () (crs)))
               (subst `(= (* ,k12 a6t) (+ (* ,k1 a6t) (* ,k2 a6t))))
               (subst (dk-cite! 'cc-exp-add `(* ,k1 a6t) `(* ,k2 a6t)))
