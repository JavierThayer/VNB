;;; THE POLAR FORM OF A POINT OF THE UNIT CIRCLE: w = exp(i th), th real
(sp (make-wff '(FORALL a6w (IMPLIES (IN a6w UNIT-CIRCLE) (FORSOME a6th (AND (IN a6th RR) (= a6w (cc-exp (* +i a6th)))))))))
