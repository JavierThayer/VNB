        (dk-have-and! '(IN 1 CC) '(= (magnitude 1) 1))
        (dk-iff-bwd! (dk-cite! 'unit-circle-membership 1)))))
(sp (make-wff `(FORALL a6g (IMPLIES (IS-ABELIAN-GROUP a6g)
  (AND (IS-SUBGROUP a6g ,a6c-h0) (AND (IN ,a6c-c0 (FUN ,a6c-h0 UNIT-CIRCLE)) ,(a6c-hom a6c-c0 a6c-h0 'a6g)))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'abelian-group-is-group 'a6g))
(dk-cite! 'group-identity-in 'a6g)
(dk-cite! 'group-carr-set 'a6g)
(a6-one-t!)
(define (a6c-h0-open! y) (dk-sep-parts! `(IN ,y ,a6c-h0)))
(dk-have! `(IS-SUBGROUP a6g ,a6c-h0)
  (lambda ()
    (mac 'is-subgroup)
    (dk-conj-close!
      (lambda ()
        (let ((g2 (dk-goal)))
          (cond
            ((dk-asm? g2) (dk-ass!))
            ((dk-head-is? g2 'SUBSET)
             (mac 'subset-def)
             (let* ((landed (dk-landed (lambda () (dk-peel!)))) (y (cadr (car landed))))
               (a6c-h0-open! y) (dk-close-if-asm!)))
            ((dk-head-is? g2 'IN)
             (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (rfl))))
            ((dk-contains? g2 'sgb_)
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (ys (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                    (y1 (car ys)) (y2 (cadr ys)))
               (a6c-h0-open! y1) (a6c-h0-open! y2)
               (dk-cite! 'group-carrier-closed-opr 'a6g y1 y2)
               (dk-cite! 'group-left-id 'a6g '(IDEN a6g))
               (in-sep! (lambda () (dk-close-if-asm!))
                        (lambda ()
                          (subst `(= ,y1 (IDEN a6g))) (subst `(= ,y2 (IDEN a6g)))
                          (dk-close-if-asm!)))))
            (#t
             (let* ((landed (dk-landed (lambda () (dk-peel!)))) (y (cadr (car landed))))
               (a6c-h0-open! y)
               (dk-cite! 'group-inv-in 'a6g y)
               (dk-cite! 'group-inv-iden 'a6g)
               (in-sep! (lambda () (dk-close-if-asm!))
                        (lambda () (subst `(= ,y (IDEN a6g))) (dk-close-if-asm!)))))))))))
(dk-project! `(FORALL sga_ (IMPLIES (IN sga_ ,a6c-h0) (FORALL sgb_ (IMPLIES (IN sgb_ ,a6c-h0) (IN ((OPR a6g) sga_ sgb_) ,a6c-h0)))))
             'is-subgroup `(IS-SUBGROUP a6g ,a6c-h0))
(let ((hclos (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sgb_))) "closure")))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IN)
           (for-each
             (lambda (l)
               (dk-focus! l)
               (if (dk-head-is? (dk-goal) 'FORALL)
                   (begin (dk-peel!) (dk-close-if-asm!))
                   (dk-close-if! (lambda () (sep-set)) (lambda () (dk-ass!)))))
             (dk-opened (lambda () (lam-t)))))
          (#t
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (ys (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
             (dk-apply! hclos (car ys) (cadr ys))
             (dk-lam-b!)
             (dk-close-if! (lambda () #t) (lambda () (crs))))))))))
(qed 'ag-trivial-subgroup-character)

