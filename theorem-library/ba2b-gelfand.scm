;;; ba2b-gelfand.scm -- Proposition 1.16 (||G(x)||_sup = rho(x) for a commutative Banach algebra with unit) and
;;; the isometry half of Theorem 1.23 (the Gelfand transform of a commutative C*-algebra with unit is
;;; isometric) of F. J. Thayer, "Banach Algebras and Applications", ch. 1.
;;; Agent BA-2B, wave 2026-11-10.  Destination: theorem-library/ba2b-gelfand.scm.  Library: operator-algebras.
;;; All proofs modulo 0.  Helper prefix b2g-.
;;; LOAD WINDOW: after ba2b-radius (cstar-sa-spectral-radius, b2r-spectral-radius-view), BA-1G's
;;; ba-characters (spectrum-character-value, character-value-in-spectrum), BA-1D's ba-gelfand-continuous,
;;; BA-1H's ba-gelfand-formula (gelfand-spectral-radius-max), BA-1's ba-cx-vocab (SUP-NORM-T, CCONT) and the
;;; sup-norm-t laws (BA-SW2's basw2-cx), BA-2's ba2-cstar.
;;;
;;; THE ROUTE.  1.16: every |chi(x)| lies in the spectrum, so is <= rho(x); the point of the spectrum of
;;; largest modulus is chi(x) for some character (commutativity).  1.23, isometry: for y = x* x, which is
;;; self-adjoint, ||G y||_sup = rho(y) = ||y|| = ||x||^2; and ||G y||_sup <= ||G x*||_sup ||G x||_sup <=
;;; ||x|| ||G x||_sup, so ||x|| <= ||G x||_sup <= ||x||.  NOT the notes' step ||G(x* x)|| = ||G(x)||^2,
;;; which needs G(x*) = conj G(x) (1.22, KIT-ALG's): the bound ||G x*|| <= ||x*|| = ||x|| suffices.

(define (b2g-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba2b-gelfand: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba2b-gelfand: unfinished" name))))
(define (b2g-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (b2g-T A) (list 'GELFAND-SPACE A))
(define (b2g-g A u) (list (list 'GELFAND-TRANSFORM A) u))
(define (b2g-sup A u) (list 'SUP-NORM-T (b2g-T A) (b2g-g A u)))
(define (b2g-nr A x) (list (list 'VNRM A) x))
(define b2g-B '(UIBA-AS-UBA a))

;;; ---- the points of the Gelfand space are the characters ---------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (== (PTS (GELFAND-SPACE a)) (CHARACTERS a))))))
(dk-peel!)
(dk-cite! 'characters-in-set 'a)
(mac 'GELFAND-SPACE)
(let ((st (cadr (cadr (dk-goal)))))
  (dk-cite! 'subspace-top-pts (cadr st) (caddr st))
  (subst (list '= (list 'PTS st) (caddr st)))
  (qrfl))
(b2g-qed! 'gelfand-space-pts)

;;; ---- the views: Gelfand transform and space of UIBA-AS-UBA(a) are a's -------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (== (GELFAND-TRANSFORM (UIBA-AS-UBA a)) (GELFAND-TRANSFORM a))))))
(dk-peel!)
(dk-cite! 'bcp-ro-vec 'a)
(dk-cite! 'bcs-characters-view 'a)
(mac 'GELFAND-TRANSFORM)
(subst '(= (VEC (UIBA-AS-UBA a)) (VEC a)))
(subst '(= (CHARACTERS (UIBA-AS-UBA a)) (CHARACTERS a)))
(qrfl)
(b2g-qed! 'b2g-gelfand-transform-view)

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (== (GELFAND-SPACE (UIBA-AS-UBA a)) (GELFAND-SPACE a))))))
(dk-peel!)
(dk-cite! 'bcp-ro-vec 'a)
(dk-cite! 'bcs-characters-view 'a)
(mac 'GELFAND-SPACE)
(subst '(= (VEC (UIBA-AS-UBA a)) (VEC a)))
(subst '(= (CHARACTERS (UIBA-AS-UBA a)) (CHARACTERS a)))
(qrfl)
(b2g-qed! 'b2g-gelfand-space-view)

;;; ---- a commutative C*-algebra's Banach-algebra view is commutative ----------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (IS-COMMUTATIVE-BANACH-ALGEBRA (UIBA-AS-UBA a))))))
(dk-peel!)
(dk-cite! 'bcs-ccsa-ucsa 'a)
(dk-cite! 'bcp-ucsa-uiba 'a)
(dk-cite! 'bcs-uiba-is-uba 'a)
(dk-cite! 'bcp-ro-vec 'a)
(dk-cite! 'bcp-ro-vmul 'a)
(dk-cite! 'bcs-ccsa-comm 'a)
(mac 'is-commutative-banach-algebra-def)
(subst '(= (VEC (UIBA-AS-UBA a)) (VEC a)))
(subst '(= (VMUL (UIBA-AS-UBA a)) (VMUL a)))
(dk-conj-close! (lambda () (dk-ass!)))
(b2g-qed! 'b2g-ccsa-commutative-view)

;;; ---- ||G x||_sup <= ||x|| (any unital Banach algebra) --------------------------------------------------
;;; lands the typing of G(x) on the points first; returns nothing
(define (b2g-g-type! A u)
  (dk-cite! 'gelfand-space-pts A)
  (let ((f (dk-cite! 'gelfand-transform-in-fun A u)))
    (dk-rewrite-h! f (list 'CHARACTERS A) (list 'PTS (b2g-T A)))))
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (AND (IN (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) x)) RR)
  (AND (<= 0 (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) x)))
       (<= (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) x)) ((VNRM a) x))))))))))
(dk-peel!)
(b2g-g-type! 'a 'x)
(dk-cite! 'bae-vnrm-type 'a 'x)
(dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
(dk-have! (list 'FORALL 'b2gc_ (list 'IMPLIES (list 'IN 'b2gc_ (list 'PTS (b2g-T 'a)))
                  (list '<= (list 'magnitude (list (b2g-g 'a 'x) 'b2gc_)) (b2g-nr 'a 'x))))
  (lambda ()
    (dk-peel!)
    (let* ((c (cadr (cadr (cadr (dk-goal)))))
           (m (dk-pick (lambda (h) (equal? h (list 'IN c (list 'PTS (b2g-T 'a))))) "c in the points")))
      (dk-rewrite-h! m (list 'PTS (b2g-T 'a)) '(CHARACTERS a))
      (dk-cite! 'gelfand-transform-bounded 'a 'x c)
      (dk-ass!))))
(b2g-cite2! 'sup-norm-t-least (b2g-T 'a) (b2g-g 'a 'x) (b2g-nr 'a 'x))
(dk-ass!)
(b2g-qed! 'gelfand-sup-le-norm)

;;; ---- PROPOSITION 1.16: ||G x||_sup = rho(x) (commutative) ---------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (= (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) x)) (SPECTRAL-RADIUS a x))))))))
(dk-peel!)
(dk-cite! 'bch-comm-uba 'a)
(b2g-g-type! 'a 'x)
(dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
(let* ((sr '(SPECTRAL-RADIUS a x)) (g (b2g-g 'a 'x)) (pt (list 'PTS (b2g-T 'a))) (sup (b2g-sup 'a 'x))
       (gfz (dk-skolem! (dk-cite! 'gelfand-spectral-radius-max 'a 'x) #t))
       (mx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h gfz))) "the maximality clause")))
  (dk-have! (list 'FORALL 'b2gc_ (list 'IMPLIES (list 'IN 'b2gc_ pt) (list '<= (list 'magnitude (list g 'b2gc_)) sr)))
    (lambda ()
      (dk-peel!)
      (let* ((c (cadr (cadr (cadr (dk-goal)))))
             (m (dk-pick (lambda (h) (equal? h (list 'IN c pt))) "c in the points")))
        (dk-rewrite-h! m pt '(CHARACTERS a))
        (dk-cite! 'gelfand-transform-value 'a 'x c)
        (dk-cite! 'character-value-in-spectrum 'a 'x c)
        (let* ((l1 (dk-apply! mx (list c 'x)))
               (l2 (dk-rewrite-h! l1 (list 'magnitude gfz) sr)))
          (subst (list '= (list g c) (list c 'x)))
          (dk-ass!)))))
  (dk-split-all! (list (b2g-cite2! 'sup-norm-t-least (b2g-T 'a) g sr)))
  (let* ((chi (dk-skolem! (b2g-cite2! 'spectrum-character-value 'a 'x gfz) #t))
         (m (dk-pick (lambda (h) (equal? h (list 'IN chi '(CHARACTERS a)))) "chi a character")))
    (dk-rewrite-h! m '(CHARACTERS a) pt)
    (dk-cite! 'gelfand-transform-value 'a 'x chi)
    (let* ((u0 (b2g-cite2! 'sup-norm-t-upper (b2g-T 'a) g chi))
           (u1 (dk-rewrite-h! u0 (list g chi) (list chi 'x)))
           (u2 (dk-rewrite-h! u1 (list chi 'x) gfz))
           (u3 (dk-rewrite-h! u2 (list 'magnitude gfz) sr)))
      (dk-ineq! (list '<= sup sr) u3 (list 'IN sup 'RR) (list 'IN sr 'RR)))))
(b2g-qed! 'gelfand-sup-spectral-radius)

;;; ---- G(x) is continuous on the Gelfand space ------------------------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (IN ((GELFAND-TRANSFORM a) x) (CCONT (GELFAND-SPACE a)))))))))
(dk-peel!)
(b2g-g-type! 'a 'x)
(dk-cite! 'gelfand-transform-continuous 'a 'x)
(let ((e (dk-cite! 'ccont-unfold (b2g-T 'a))))
  (subst (list '= (cadr e) (caddr e))))
(in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))
(b2g-qed! 'gelfand-transform-in-ccont)

;;; ---- THEOREM 1.23, isometry: ||G x||_sup = ||x|| (commutative C*-algebra with unit) ---------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (= (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) x)) ((VNRM a) x))))))))
(dk-peel!)
(dk-cite! 'bcs-ccsa-ucsa 'a)
(dk-cite! 'bcp-ucsa-uiba 'a)
(dk-cite! 'bcs-uiba-is-uba 'a)
(dk-cite! 'b2g-ccsa-commutative-view 'a)
(dk-cite! 'b2g-gelfand-transform-view 'a)
(dk-cite! 'b2g-gelfand-space-view 'a)
(dk-cite! 'bcp-ro-vec 'a)
(dk-cite! 'bcp-ro-vmul 'a)
(dk-cite! 'bcp-ro-vnrm 'a)
(subst (list '= '(GELFAND-TRANSFORM a) (list 'GELFAND-TRANSFORM b2g-B)))
(subst (list '= '(GELFAND-SPACE a) (list 'GELFAND-SPACE b2g-B)))
(let* ((B b2g-B) (xs '((VSTAR a) x)) (y (list '(VMUL a) xs 'x))
       (n '((VNRM a) x)) (T (b2g-T B)) (pt (list 'PTS T))
       (s (b2g-sup B 'x)) (s1 (b2g-sup B xs)) (sy (b2g-sup B y)))
  ;; typings
  (dk-cite! 'bcp-star-fun 'a)
  (dk-cite! 'fun-apply-type-c '(VSTAR a) '(VEC a) '(VEC a) 'x)
  (dk-cite! 'ring-carrier-closed-mul-uba-as-ring-uiba-as-uba 'a xs 'x)
  (dk-cite! 'bcp-u-bae-vnrm-type 'a 'x)
  (dk-cite! 'bcp-u-bal-uba-vnrm-nonneg 'a 'x)
  (for-each (lambda (u) (dk-rewrite-h! (list 'IN u '(VEC a)) '(VEC a) (list 'VEC B))) (list 'x xs y))
  ;; ||G x|| <= ||x||, ||G x*|| <= ||x*|| = ||x||
  (for-each (lambda (u)
              (let ((l (b2g-cite2! 'gelfand-sup-le-norm B u)))
                (dk-split-all! (list l))
                (dk-rewrite-h! (list '<= (b2g-sup B u) (b2g-nr B u)) (list 'VNRM B) '(VNRM a))))
            (list 'x xs))
  (dk-cite! 'bcp-star-norm 'a 'x)
  (dk-rewrite-h! (list '<= s1 (b2g-nr 'a xs)) (b2g-nr 'a xs) n)
  ;; y = x* x is self-adjoint, so ||G y|| = rho(y) = ||y|| = ||x||^2
  (dk-cite! 'bcp-star-mul 'a xs 'x)
  (dk-cite! 'bcp-star-star 'a 'x)
  (dk-have! (list 'IS-SELF-ADJOINT-EL 'a y)
    (lambda ()
      (mac 'is-self-adjoint-el)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) '=)
              (begin (subst (list '= (list '(VSTAR a) y) (list '(VMUL a) (list '(VSTAR a) 'x) (list '(VSTAR a) xs))))
                     (subst (list '= (list '(VSTAR a) xs) 'x))
                     (rfl))
              (dk-ass!))))))
  (let* ((e0 (b2g-cite2! 'gelfand-sup-spectral-radius B y))
         (va (dk-cite! 'b2r-spectral-radius-view 'a y))
         (sa (dk-cite! 'cstar-sa-spectral-radius 'a y))
         (cs (dk-cite! 'bcp-ucsa-cstar 'a 'x))
         (e1 (dk-rewrite-h! e0 (list 'SPECTRAL-RADIUS B y) (list 'SPECTRAL-RADIUS 'a y)))
         (e2 (dk-rewrite-h! e1 (list 'SPECTRAL-RADIUS 'a y) (list '(VNRM a) y)))
         (e3 (dk-rewrite-h! e2 (list '(VNRM a) y) (list '* n n))))
    ;; ||G y|| <= ||G x*|| ||G x||
    (for-each (lambda (u) (b2g-cite2! 'gelfand-transform-in-ccont B u)) (list 'x xs))
    (b2g-g-type! B y)
    (dk-cite! 'gelfand-space-compact B)
    (dk-cite! 'gelfand-space-pts B)
    (dk-have! (list 'FORALL 'b2gr_ (list 'IMPLIES (list 'IN 'b2gr_ pt)
                (list '= (list (b2g-g B y) 'b2gr_)
                         (list '* (list (b2g-g B xs) 'b2gr_) (list (b2g-g B 'x) 'b2gr_)))))
      (lambda ()
        (dk-peel!)
        (let* ((c (cadr (cadr (dk-goal))))
               (m (dk-pick (lambda (h) (equal? h (list 'IN c pt))) "c in the points")))
          (dk-rewrite-h! m pt (list 'CHARACTERS B))
          (let* ((m0 (dk-cite! 'gelfand-transform-mul B xs 'x c))
                 (m1 (dk-rewrite-h! m0 (list 'VMUL B) '(VMUL a))))
            (dk-ass!)))))
    (dk-split-all! (list (b2g-cite2! 'gelfand-sup-le-norm B y)))
    (let* ((ml (b2g-cite2! 'sup-norm-t-mul-le T (b2g-g B xs) (b2g-g B 'x) (b2g-g B y))))
      ;; n*n <= s1 * s;  s1 * s <= n * s;  n * s = s * n
      (dk-cite! 'rr-le-scale-nonneg-right s1 n s)
      (dk-have! (list '= (list '* n s) (list '* s n))
        (lambda () (crs)))
      (dk-have! (list '<= (list '* n n) (list '* s n))
        (lambda ()
          ;; ineq does not take these products as atoms: name them (dk-name!) and argue linearly
          (for-each (lambda (pr) (b2g-cite2! 'rr-mul-closed (car pr) (cadr pr)))
                    (list (list n n) (list s1 s) (list n s) (list s n)))
          (let* ((v1 (dk-name! (list '* n n))) (v2 (dk-name! (list '* s1 s)))
                 (v3 (dk-name! (list '* n s))) (v4 (dk-name! (list '* s n)))
                 (f1 (dk-rewrite-h! e3 (list '* n n) v1))
                 (f2 (dk-rewrite-h! ml (list '* s1 s) v2))
                 (f3a (dk-rewrite-h! (list '<= (list '* s1 s) (list '* n s)) (list '* s1 s) v2))
                 (f3 (dk-rewrite-h! f3a (list '* n s) v3))
                 (f4a (dk-rewrite-h! (list '= (list '* n s) (list '* s n)) (list '* n s) v3))
                 (f4 (dk-rewrite-h! f4a (list '* s n) v4)))
            (subst (list '= (list '* n n) v1))
            (subst (list '= (list '* s n) v4))
            (dk-ineq! f1 f2 f3 f4 (list 'IN sy 'RR) (list 'IN v1 'RR) (list 'IN v2 'RR) (list 'IN v3 'RR)
                      (list 'IN v4 'RR)))))
      (use-em (list '< 0 n)
        (lambda ()
          (b2g-cite2! 'rr-mul-le-cancel-pos n n s)
          (dk-ineq! (list '<= n s) (list '<= s n) (list 'IN s 'RR) (list 'IN n 'RR)))
        (lambda ()
          (dk-have! '(IN 0 RR))
          (b2g-cite2! 'rr-not-lt-ge 0 n)
          (dk-ineq! (list '<= n 0) (list '<= 0 n) (list '<= s n) (list '<= 0 s) (list 'IN s 'RR) (list 'IN n 'RR)))))))
(b2g-qed! 'gelfand-isometric)
