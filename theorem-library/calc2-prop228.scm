;;; calc2-prop228.scm -- calculus.pdf Prop. 2.28 on E = R^n with the sup norm: partial
;;; derivatives defined and continuous on the open set U give the directional derivative in
;;; every direction eta at every x in U, d_eta f(x) = sum_i eta_i d_(e_i) f(x), linear in eta
;;; and continuous in x.  Derived from Prop. 2.29 (continuous-partials-estimate) at the point
;;; x along t.eta.  CALC-2, 2026-10-19.  Prefix c28-.

(define (c28-open) (dk-open-leaves))
(define (c28-dump tag)
  (display ";; C28 ") (display tag) (display " goal: ") (display (dk-goal)) (newline)
  (for-each (lambda (a) (display ";; C28   asm: ") (display a) (newline)) (dk-asms))
  (for-each (lambda (l) (display ";; C28   open: ") (display (dk-goal-of l)) (newline)) (c28-open)))
(define (c28-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))


;;; (1) the sum is linear in its vector: sum_i (t.eta)_i p_i(x) = t sum_i eta_i p_i(x)
(define c28-I '(INTERVAL 1 n))
(define c28-V '(FUN (INTERVAL 1 n) RR))
(define (c28-Fof v) (list 'VNB-LAMBDA 'i c28-I (list '* (list v 'i) '((gp_ i) gx_))))
(define (c28-Sof v) (list 'FINSUM '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) (c28-Fof v) c28-I))
(define c28-teta '((ACT (RN n)) gt_ ge_))
(sp (make-wff (forall-guarded '(n gp_ gx_ ge_ gt_)
  (list '(IN n NN) (list 'IN 'ge_ c28-V) '(IN gt_ RR)
        (list 'FORALL 'i (list 'IMPLIES (list 'IN 'i c28-I) '(IN ((gp_ i) gx_) RR))))
  (list '= (c28-Sof c28-teta) (list '* 'gt_ (c28-Sof 'ge_))))))
(dk-peel!)
(define c28-pt (dk-pick (lambda (f) (dk-head-is? f 'FORALL)) "p typing"))
(fact 'interval-in-set 1 'n)
(fact 'nn-zero-in)
(dk-cite! 'interval-card-in-nn 1 'n)
(dk-cite! 'rn-act-in-vec 'n 'gt_ 'ge_)
(define (c28-ptw! v)          ; (FORALL z_ (IMPLIES (IN z_ I) (IN (F_v z_) RR)))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ c28-I) (list 'IN (list (c28-Fof v) 'z_) 'RR)))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-lam-b!)
        (c28-and! (list 'IN v c28-V) (list 'IN z c28-I))
        (dk-cite! 'fun-apply-type v c28-I 'RR z)
        (dk-apply! c28-pt z)
        (c28-and! (list 'IN (list v z) 'RR) (list 'IN (list (list 'gp_ z) 'gx_) 'RR))
        (dk-cite! 'rr-mul-closed (list v z) (list (list 'gp_ z) 'gx_))
        (ass)))))
(c28-ptw! 'ge_)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ c28-I)
            (list '= (list (c28-Fof c28-teta) 'z_)
                     (list '+ (list '* 'gt_ (list (c28-Fof 'ge_) 'z_)) (list '* 0 (list (c28-Fof 'ge_) 'z_))))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-lam-b!)
      (subst (dk-cite! 'rn-act-apply 'n 'gt_ 'ge_ z))
      (c28-and! (list 'IN 'ge_ c28-V) (list 'IN z c28-I))
      (dk-cite! 'fun-apply-type 'ge_ c28-I 'RR z)
      (dk-apply! c28-pt z)
      (crs))))
(define c28-lin (dk-cite! 'rb1-fs-lin c28-I 'gt_ 0 (c28-Fof 'ge_) (c28-Fof 'ge_) (c28-Fof c28-teta)))
(subst c28-lin)
(dk-cite! 'rb1-fs-real c28-I (c28-Fof 'ge_))
(crs)
(qed 'rn-partials-sum-scale)


;;; (2) PROPOSITION 2.28, the directional derivatives: for every x in U and every eta in E,
;;; d_eta f(x) exists and equals sum_(i=1..n) eta_i d_(e_i) f(x).
(define c28-E '(NVS-METRIC-SPACE (RN n)))
(define c28-SUB '(SUBSPACE-MS (NVS-METRIC-SPACE (RN n)) u))
(define c28-hyps
  (list '(IN n NN)
        (list 'IS-OPEN c28-E 'u)
        '(IN f (FUN u RR))
        '(FORALL i (IMPLIES (IN i (INTERVAL 1 n)) (FORALL x (IMPLIES (IN x u)
            (HAS-DIR-DERIV (RN n) f x (RN-UNIT n i) ((p i) x))))))
        (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'x (list 'IMPLIES '(IN x u)
            (list 'IS-CONTINUOUS-AT c28-SUB 'RR-MS '(p i) 'x)))))))
(define (c28-D v x) (list 'FINSUM '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                          (list 'VNB-LAMBDA 'i '(INTERVAL 1 n) (list '* (list v 'i) (list '(p i) x))) '(INTERVAL 1 n)))
(define c28-hC #f)
;;; (IN ((p i) z) RR) for i in I, z in u
(define (c28-p-type! i z)
  (let* ((ct (dk-apply! c28-hC i z))
         (ft (dk-project! (list 'IN (list 'p i) (list 'FUN (list 'PTS c28-SUB) '(PTS RR-MS)))
                          (lambda () (mac-h 'IS-CONTINUOUS-AT ct))))
         (f1 (dk-rewrite-h! ft (list 'PTS c28-SUB) 'u))
         (f2 (dk-rewrite-h! f1 '(PTS RR-MS) 'RR)))
    (c28-and! f2 (list 'IN z 'u))
    (dk-cite! 'fun-apply-type (list 'p i) 'u 'RR z)))
;;; the setting: E is a metric space on V, u a subset of V and a set
(define (c28-setting!)
  (dk-cite! 'rn-is-normed-vector-space 'n)
  (dk-cite! 'nvs-metric-is-ms '(RN n))
  (dk-cite! 'nvs-ms-pts '(RN n))
  (dk-cite! 'rn-vec 'n)
  (fact 'r7q-rr-pts)
  (fact 'rr-is-set)
  (fact 'interval-in-set 1 'n)
  (dk-project! (list 'SUBSET 'u (list 'PTS c28-E)) (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN c28-E 'u))))
  (dk-have! (list 'IN c28-V 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'SUBSET 'u c28-V)
    (lambda () (subst (list '= c28-V '(VEC (RN n)))) (subst (list '= '(VEC (RN n)) (list 'PTS c28-E))) (ass)))
  (dk-cite! 'subclass-of-set-is-set 'u c28-V)
  (dk-cite! 'subspace-pts c28-E 'u))
(define (c28-vec! x) (dk-have! (list 'IN x '(VEC (RN n))) (lambda () (subst (list '= '(VEC (RN n)) c28-V)) (ass))))
(define (c28-inV-of-vec! x) (dk-have! (list 'IN x c28-V) (lambda () (subst (list '= c28-V '(VEC (RN n)))) (ass))))

(sp (make-wff (forall-guarded '(n u f p) c28-hyps
  (list 'FORALL 'x (list 'IMPLIES '(IN x u) (list 'FORALL 'eta (list 'IMPLIES '(IN eta (VEC (RN n)))
    (list 'HAS-DIR-DERIV '(RN n) 'f 'x 'eta (c28-D 'eta 'x)))))))))
(dk-peel!)
(set! c28-hC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "conts"))
(c28-setting!)
(define c28-g '(SEG-CURVE (RN n) f x eta))
(define c28-Nrm '((VNRM (RN n)) eta))
(define c28-Dv (c28-D 'eta 'x))
(c28-inV-of-vec! 'eta)
(dk-cite! 'subset-mem-fwd 'u c28-V 'x)
(dk-cite! 'subset-mem-fwd 'u (list 'PTS c28-E) 'x)
(c28-vec! 'x)
(dk-split! (dk-cite! 'rn-norm-typing 'n 'eta))
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) '(IN ((p i) x) RR)))
  (lambda () (let ((i (dk-di-var!))) (c28-p-type! i 'x) (ass))))
(define c28-ptall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '((p i) x)) (not (dk-contains? f 'IS-CONTINUOUS-AT))
                                            (not (dk-contains? f 'HAS-DIR-DERIV)))) "p typing at x"))
(fact 'nn-zero-in)
(dk-cite! 'interval-card-in-nn 1 'n)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 n))
            (list 'IN (list (list 'VNB-LAMBDA 'i '(INTERVAL 1 n) '(* (eta i) ((p i) x))) 'z_) 'RR)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-lam-b!)
      (c28-and! (list 'IN 'eta c28-V) (list 'IN z '(INTERVAL 1 n)))
      (dk-cite! 'fun-apply-type 'eta '(INTERVAL 1 n) 'RR z)
      (dk-apply! c28-ptall z)
      (c28-and! (list 'IN (list 'eta z) 'RR) (list 'IN (list (list 'p z) 'x) 'RR))
      (dk-cite! 'rr-mul-closed (list 'eta z) (list (list 'p z) 'x))
      (ass))))
(dk-cite! 'rb1-fs-real '(INTERVAL 1 n) '(VNB-LAMBDA i (INTERVAL 1 n) (* (eta i) ((p i) x))))
;;; the ball around x inside u, and the window radius r with r ||eta|| <= rb / 2
(define c28-ob (dk-project! (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL c28-E 'y 'r) 'u)))))
                            (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN c28-E 'u)))))
(define c28-rb (dk-skolem! (dk-apply! c28-ob 'x) #t))
(dk-cite! 'rr-pos-rr-in-rr c28-rb)
(define c28-hb (dk-halve! c28-rb))
(dk-cite! 'rr-pos-rr-of-lt c28-hb)
(define c28-r (dk-skolem! (dk-cite! 'rr-small-factor-real c28-hb c28-Nrm) #t))
(dk-cite! 'rr-pos-rr-in-rr c28-r) (dk-cite! 'rr-lt-of-pos-rr c28-r)
(define c28-W (list 'OOINT (list '- 0 c28-r) (list '+ 0 c28-r)))
(define (c28-pt t) (list '(VADD (RN n)) 'x (list '(ACT (RN n)) t 'eta)))
(define (c28-teta t) (list '(ACT (RN n)) t 'eta))
;;; t real with |t| <= r: the point x + t.eta is in u, f there is real, g(t) == f(x + t.eta)
(define (c28-in-u! t)
  (let* ((pt (c28-pt t)) (te (c28-teta t)) (at (list 'abs t)))
    (dk-cite! 'rr-abs-closed t) (dk-cite! 'rr-abs-nonneg t)
    (dk-cite! 'rn-act-in-vec 'n t 'eta)
    (c28-vec! te)
    (dk-cite! 'nvs-vadd-in-vec '(RN n) 'x te)
    (dk-have! (list 'IN pt (list 'PTS c28-E)) (lambda () (subst (list '= (list 'PTS c28-E) '(VEC (RN n)))) (ass)))
    (dk-cite! 'metric-dist-real c28-E 'x pt)
    (let* ((de (dk-cite! 'nvs-dist-shift '(RN n) 'x te))
           (hm (dk-cite! 'rn-norm-homogeneous 'n t 'eta))
           (ml (dk-cite! 'rr-mul-le-right at c28-r c28-Nrm))
           (an (list '* at c28-Nrm)) (rn (list '* c28-r c28-Nrm)))
      (dk-type! an) (dk-type! rn)
      (dk-have! (list '< (list (list 'DIST c28-E) 'x pt) c28-rb)
        (lambda ()
          (subst de) (subst hm)
          (let* ((va (dk-name! an)) (vr (dk-name! rn)))
            (subst (list '= an va))
            (dk-ineq! (dk-rewrite-h! (dk-rewrite-h! ml an va) rn vr)
                      (dk-rewrite-h! (list '<= rn c28-hb) rn vr)
                      (list '= (list '+ c28-hb c28-hb) c28-rb) (list '< 0 c28-hb)))))
      (let ((dd (list (list 'DIST c28-E) 'x pt)))
        (dk-have! (list 'AND (list 'IN pt (list 'PTS c28-E)) (list 'AND (list 'IN dd 'RR) (list 'AND (list 'IN c28-rb 'RR)
                    (list 'AND (list '<= dd dd) (list '< dd c28-rb)))))
          (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '<=) (begin (dk-cite! 'rr-leq-reflexive dd) (ass)) (ass))))))
        (dk-cite! 'ball-mem-from-le c28-E 'x pt dd c28-rb))
      (dk-cite! 'subset-mem-fwd (list 'BALL c28-E 'x c28-rb) 'u pt)
      (c28-and! '(IN f (FUN u RR)) (list 'IN pt 'u))
      (dk-cite! 'fun-apply-type 'f 'u 'RR pt)
      (dk-cite! 'seg-curve-apply '(RN n) 'f 'x 'eta t))))
(define (c28-W-parts! t)          ; t in W: t real, |t| <= r
  (dk-cite! 'ooint-elt-in-rr (list '- 0 c28-r) (list '+ 0 c28-r) t)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ooint-membership (list '- 0 c28-r) (list '+ 0 c28-r) t))))
  (dk-have! (list '< (list '- c28-r) t) (lambda () (dk-ineq! (list '< (list '- 0 c28-r) t))))
  (dk-have! (list '< t c28-r) (lambda () (dk-ineq! (list '< t (list '+ 0 c28-r)))))
  (dk-cite! 'rr-abs-lt-of-parts t c28-r)
  (dk-cite! 'rr-abs-closed t)
  (dk-cite! 'rr-lt-implies-le (list 'abs t) c28-r))
;;; the hypotheses of has-deriv-at-of-eps-bound at g, c = 0, r, L = D
(dk-have! (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ c28-W) (list 'IN (list c28-g 'et_) 'RR)))
  (lambda ()
    (let ((t (dk-di-var!)))
      (c28-W-parts! t)
      (dk-cite! 'rr-abs-closed t)
      (let ((gq (c28-in-u! t)))
        (subst gq) (ass)))))
(define c28-target
  (list 'FORALL 'ee_ (list 'IMPLIES '(POS-RR ee_)
    (list 'FORSOME 'ed_ (list 'AND '(POS-RR ed_)
      (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ c28-W)
        (list 'IMPLIES '(< (abs (- et_ 0)) ed_)
          (list '<= (list 'abs (list '- (list '- (list c28-g 'et_) (list c28-g 0)) (list '* '(- et_ 0) c28-Dv)))
                    '(* ee_ (abs (- et_ 0))))))))))))
(dk-cite! 'rr-zero-in)
(dk-have! c28-target
  (lambda ()
    (let* ((le (dk-landed (lambda () (dk-peel!))))
           (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) le))))
      (dk-cite! 'rr-pos-rr-in-rr e)
      (let* ((ep (dk-skolem! (dk-cite! 'rr-small-factor-real e c28-Nrm) #t))
             (c29 (dk-cite! 'continuous-partials-estimate 'n 'u 'f 'p 'x))
             (dl (dk-skolem! (dk-apply! c29 ep) #t))
             (b29 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl))) "the 2.29 bound")))
        (dk-cite! 'rr-pos-rr-in-rr ep)
        (dk-cite! 'rr-pos-rr-in-rr dl)
        (let ((d (dk-skolem! (dk-cite! 'rr-small-factor-real dl c28-Nrm) #t)))
          (dk-cite! 'rr-pos-rr-in-rr d)
          (ew d)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'POS-RR) (ass)
                (let* ((lt (dk-landed (lambda () (dk-peel!))))
                       (t (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) c28-W))) lt)))
                       (dh (find-first (lambda (f) (dk-head-is? f '<)) lt)))
                  (c28-W-parts! t)
                  (let* ((gq (c28-in-u! t))
                         (te (c28-teta t)) (at (list 'abs t)) (pt (c28-pt t))
                         (z0 (dk-have! (list '= (list '- t 0) t) (lambda () (crs))))
                         (dh1 (dk-rewrite-h! dh (list '- t 0) t))
                         (hm (dk-cite! 'rn-norm-homogeneous 'n t 'eta)))
                    (dk-cite! 'rr-lt-implies-le at d)
                    (let* ((ml (dk-cite! 'rr-mul-le-right at d c28-Nrm))
                           (an (list '* at c28-Nrm)) (dn (list '* d c28-Nrm)))
                      (dk-type! an) (dk-type! dn)
                      (dk-have! (list '<= (list '(VNRM (RN n)) te) dl)
                        (lambda ()
                          (subst hm)
                          (let* ((va (dk-name! an)) (vd (dk-name! dn)))
                            (subst (list '= an va))
                            (dk-ineq! (dk-rewrite-h! (dk-rewrite-h! ml an va) dn vd)
                                      (dk-rewrite-h! (list '<= dn dl) dn vd))))))
                    (let* ((bd (dk-apply! b29 te))
                           (sc (dk-cite! 'rn-partials-sum-scale 'n 'p 'x 'eta t))
                           (bd1 (dk-rewrite-h! bd (cadr sc) (caddr sc)))
                           (bd2 (dk-rewrite-h! bd1 (list '(VNRM (RN n)) te) (list '* at c28-Nrm))))
                      (subst (list '= (list '- t 0) t))
                      (subst gq)
                      (subst (dk-cite! 'seg-curve-apply '(RN n) 'f 'x 'eta 0))
                      (subst (dk-cite! 'nvs-act-zero '(RN n) 'eta 'x))
                      (let* ((ef (list '* ep c28-Nrm))
                             (k1 (list '* (list '* at c28-Nrm) ep))
                             (k2 (list '* e at))
                             (k1b (list '* ef at)))
                        (dk-type! ef)
                        (let ((mo (dk-cite! 'rr-mul-le-right ef e at)))
                          (for-each dk-type! (list k1 k2 k1b))
                          (dk-have! (list '= k1 k1b) (lambda () (crs)))
                          (c28-and! '(IN f (FUN u RR)) '(IN x u))
                          (dk-cite! 'fun-apply-type 'f 'u 'RR 'x)
                          (dk-type! (list '* t c28-Dv))
                          (let ((xx (list '- (list '- (list 'f pt) '(f x)) (list '* t c28-Dv))))
                            (dk-type! xx)
                            (dk-cite! 'rr-abs-closed xx)
                            (let* ((v1 (dk-name! k1)) (v2 (dk-name! k1b)) (v3 (dk-name! k2))
                                   (h1 (dk-rewrite-h! bd2 k1 v1))
                                   (h2 (dk-rewrite-h! (dk-rewrite-h! mo k1b v2) k2 v3))
                                   (h3 (dk-rewrite-h! (dk-rewrite-h! (list '= k1 k1b) k1 v1) k1b v2)))
                              (subst (list '= k2 v3))
                              (dk-ineq! h1 h2 h3))))))))))))))))
(dk-cite! 'has-deriv-at-of-eps-bound c28-g 0 c28-r c28-Dv)
(mac 'HAS-DIR-DERIV)
(ass)
(qed 'continuous-partials-dir-deriv)

;;; (3) PROPOSITION 2.28, linearity in eta:
;;;     d_(r.eta + s.xi) f(x) = r d_eta f(x) + s d_xi f(x)
;;; read on the value sum_i eta_i d_(e_i) f(x) that (3) gives.
(define c28-comb '((VADD (RN n)) ((ACT (RN n)) gr_ ge_) ((ACT (RN n)) gs_ gz_)))
(sp (make-wff (forall-guarded '(n gp_ gx_ ge_ gz_ gr_ gs_)
  (list '(IN n NN) (list 'IN 'ge_ c28-V) (list 'IN 'gz_ c28-V) '(IN gr_ RR) '(IN gs_ RR)
        (list 'FORALL 'i (list 'IMPLIES (list 'IN 'i c28-I) '(IN ((gp_ i) gx_) RR))))
  (list '= (c28-Sof c28-comb) (list '+ (list '* 'gr_ (c28-Sof 'ge_)) (list '* 'gs_ (c28-Sof 'gz_)))))))
(dk-peel!)
(set! c28-pt (dk-pick (lambda (f) (dk-head-is? f 'FORALL)) "p typing"))
(fact 'interval-in-set 1 'n)
(fact 'nn-zero-in)
(dk-cite! 'interval-card-in-nn 1 'n)
(dk-cite! 'rn-act-in-vec 'n 'gr_ 'ge_)
(dk-cite! 'rn-act-in-vec 'n 'gs_ 'gz_)
(dk-cite! 'rn-vadd-in-vec 'n '((ACT (RN n)) gr_ ge_) '((ACT (RN n)) gs_ gz_))
(c28-ptw! 'ge_)
(c28-ptw! 'gz_)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ c28-I)
            (list '= (list (c28-Fof c28-comb) 'z_)
                     (list '+ (list '* 'gr_ (list (c28-Fof 'ge_) 'z_)) (list '* 'gs_ (list (c28-Fof 'gz_) 'z_))))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-lam-b!)
      (subst (dk-cite! 'rn-vadd-apply 'n '((ACT (RN n)) gr_ ge_) '((ACT (RN n)) gs_ gz_) z))
      (subst (dk-cite! 'rn-act-apply 'n 'gr_ 'ge_ z))
      (subst (dk-cite! 'rn-act-apply 'n 'gs_ 'gz_ z))
      (c28-and! (list 'IN 'ge_ c28-V) (list 'IN z c28-I))
      (dk-cite! 'fun-apply-type 'ge_ c28-I 'RR z)
      (c28-and! (list 'IN 'gz_ c28-V) (list 'IN z c28-I))
      (dk-cite! 'fun-apply-type 'gz_ c28-I 'RR z)
      (dk-apply! c28-pt z)
      (crs))))
(subst (dk-cite! 'rb1-fs-lin c28-I 'gr_ 'gs_ (c28-Fof 'ge_) (c28-Fof 'gz_) (c28-Fof c28-comb)))
(dk-cite! 'rb1-fs-real c28-I (c28-Fof 'ge_))
(dk-cite! 'rb1-fs-real c28-I (c28-Fof 'gz_))
(rfl)
(qed 'rn-partials-sum-linear)

;;; (4) CONTINUITY AT A POINT OF SUMS AND SCALAR MULTIPLES of real functions on a metric
;;; space (the pointwise forms of rmc-cont-fns-add / rmc-cont-fns-scale, which live in the
;;; measure library and are stated for CONT-FNS).
(define (c28-dst s a b) (list (list 'DIST s) a b))
(define (c28-ptsrr!) (fact 'r7q-rr-pts))
(define (c28-pos! d) (dk-cite! 'rr-pos-rr-in-rr d) (dk-cite! 'rr-lt-of-pos-rr d))
(define (c28-clause! s fn a cont)      ; the eps-delta clause of (IS-CONTINUOUS-AT s RR-MS fn a)
  (dk-project! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'delta (list 'AND '(POS-RR delta)
                 (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b (list 'PTS s))
                   (list 'IMPLIES (list '<= (c28-dst s a 'b) 'delta) (list '<= (c28-dst 'RR-MS (list fn a) (list fn 'b)) 'eps))))))))
               (lambda () (mac-h 'IS-CONTINUOUS-AT cont))))
(define c28-sum2 '(VNB-LAMBDA sx_ (PTS ks_) (+ (kf_ sx_) (kg_ sx_))))
(sp (make-wff (forall-guarded '(ks_ kf_ kg_ ka_)
  (list '(IS-METRIC-SPACE ks_) '(IN kf_ (FUN (PTS ks_) RR)) '(IN kg_ (FUN (PTS ks_) RR)) '(IN ka_ (PTS ks_))
        '(IS-CONTINUOUS-AT ks_ RR-MS kf_ ka_) '(IS-CONTINUOUS-AT ks_ RR-MS kg_ ka_))
  (list 'IS-CONTINUOUS-AT 'ks_ 'RR-MS c28-sum2 'ka_))))
(dk-peel!)
(c28-ptsrr!)
(fact 'rr-is-metric-space)
(dk-cite! 'ms-pts-is-set 'ks_)
(dk-have! (list 'IN c28-sum2 '(FUN (PTS ks_) RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c 'kf_ '(PTS ks_) 'RR x)
          (dk-cite! 'fun-apply-type-c 'kg_ '(PTS ks_) 'RR x)
          (in-rr)))
      (lambda () (ass)))))
(define c28-fc (c28-clause! 'ks_ 'kf_ 'ka_ '(IS-CONTINUOUS-AT ks_ RR-MS kf_ ka_)))
(define c28-gc (c28-clause! 'ks_ 'kg_ 'ka_ '(IS-CONTINUOUS-AT ks_ RR-MS kg_ ka_)))
(mac 'IS-CONTINUOUS-AT)
(subst '(= (PTS RR-MS) RR))
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
      (let* ((le (dk-landed (lambda () (dk-peel!))))
             (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) le)))
             (e2 (dk-halve! eps))
             (d1 (dk-skolem! (dk-apply! c28-fc e2) #t))
             (d1c (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b) (dk-contains? f d1))) "f's delta"))
             (d2 (dk-skolem! (dk-apply! c28-gc e2) #t))
             (d2c (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b) (dk-contains? f d2))) "g's delta")))
        (c28-pos! d1) (c28-pos! d2) (c28-pos! eps)
        (let ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2) #t)))
          (dk-cite! 'rr-pos-rr-of-lt w)
          (ew w)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
                (let* ((lb (dk-landed (lambda () (dk-peel!))))
                       (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS ks_)))) lb))))
                  (for-each (lambda (fn pt) (dk-cite! 'fun-apply-type-c fn '(PTS ks_) 'RR pt))
                            (list 'kf_ 'kg_ 'kf_ 'kg_) (list 'ka_ 'ka_ b b))
                  (dk-cite! 'metric-dist-real 'ks_ 'ka_ b)
                  (dk-have! (list '<= (c28-dst 'ks_ 'ka_ b) d1) (lambda () (dk-ineq! (list '<= (c28-dst 'ks_ 'ka_ b) w) (list '<= w d1))))
                  (dk-have! (list '<= (c28-dst 'ks_ 'ka_ b) d2) (lambda () (dk-ineq! (list '<= (c28-dst 'ks_ 'ka_ b) w) (list '<= w d2))))
                  (let* ((fa '(kf_ ka_)) (ga '(kg_ ka_)) (fb (list 'kf_ b)) (gb (list 'kg_ b))
                         (uf (dk-apply! d1c b)) (ug (dk-apply! d2c b))
                         (rf (dk-cite! 'rr-ms-dist fa fb)) (rg (dk-cite! 'rr-ms-dist ga gb))
                         (uf2 (dk-rewrite-h! uf (cadr rf) (caddr rf)))
                         (ug2 (dk-rewrite-h! ug (cadr rg) (caddr rg))))
                    (dk-lam-b!)
                    (let* ((ha (list '+ fa ga)) (hb (list '+ fb gb))
                           (ua (list '- fa fb)) (ub (list '- ga gb)))
                      (dk-type! ha) (dk-type! hb) (dk-type! ua) (dk-type! ub)
                      (subst (dk-cite! 'rr-ms-dist ha hb))
                      (dk-have! (list '= (list '- ha hb) (list '+ ua ub)) (lambda () (crs)))
                      (subst (list '= (list '- ha hb) (list '+ ua ub)))
                      (dk-cite! 'rr-abs-triangle-c ua ub)
                      (dk-cite! 'rr-abs-closed ua) (dk-cite! 'rr-abs-closed ub)
                      (dk-type! (list '+ ua ub))
                      (dk-cite! 'rr-abs-closed (list '+ ua ub))
                      (dk-ineq! uf2 ug2 (list '= (list '+ e2 e2) eps)
                                (list '<= (list 'abs (list '+ ua ub)) (list '+ (list 'abs ua) (list 'abs ub)))))))))))))))
(qed 'ms-rr-add-continuous-at)

(define c28-scl '(VNB-LAMBDA sx_ (PTS ks_) (* kc_ (kf_ sx_))))
(sp (make-wff (forall-guarded '(ks_ kc_ kf_ ka_)
  (list '(IS-METRIC-SPACE ks_) '(IN kc_ RR) '(IN kf_ (FUN (PTS ks_) RR)) '(IN ka_ (PTS ks_))
        '(IS-CONTINUOUS-AT ks_ RR-MS kf_ ka_))
  (list 'IS-CONTINUOUS-AT 'ks_ 'RR-MS c28-scl 'ka_))))
(dk-peel!)
(c28-ptsrr!)
(fact 'rr-is-metric-space)
(dk-cite! 'ms-pts-is-set 'ks_)
(dk-have! (list 'IN c28-scl '(FUN (PTS ks_) RR))
  (lambda ()
    (dk-lam-type!
      (lambda () (let ((x (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'kf_ '(PTS ks_) 'RR x) (in-rr)))
      (lambda () (ass)))))
(dk-have! (list 'IN c28-scl '(FUN (PTS ks_) (PTS RR-MS))) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(define c28-aff '(VNB-LAMBDA x RR (+ 0 (* kc_ x))))
(dk-cite! 'fun-apply-type-c 'kf_ '(PTS ks_) 'RR 'ka_)
(dk-cite! 'rr-zero-in)
(dk-have! (list 'AND '(IN 0 RR) (list 'AND '(IN kc_ RR) '(IN (kf_ ka_) RR))) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'affine-continuous-at 0 'kc_ '(kf_ ka_))
(dk-cite! 'ms-compose-continuous-at 'ks_ 'RR-MS 'RR-MS 'kf_ c28-aff 'ka_)
(define c28-cmp (list 'VNB-LAMBDA 'msz_ '(PTS ks_) (list c28-aff '(kf_ msz_))))
(dk-have! (list 'FORALL 'msz_ (list 'IMPLIES '(IN msz_ (PTS ks_)) (list '= (list c28-scl 'msz_) (list c28-cmp 'msz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'kf_ '(PTS ks_) 'RR z)
      (dk-lam-b!)
      (crs))))
(dk-cite! 'ms-cont-transfer-ptwise-eq 'ks_ 'RR-MS c28-cmp c28-scl 'ka_)
(ass)
(qed 'ms-rr-scale-continuous-at)

;;; (5) A FINITE SUM OF CONTINUOUS REAL FUNCTIONS: on a metric space s, if every ph(i) is
;;; continuous at a, so is y |-> sum_(i <= k) et_i ph(i)(y), k <= n.  Induction variable first.
(define (c28-Fy y) (list 'VNB-LAMBDA 'i '(INTERVAL 1 hn_) (list '* '(het_ i) (list '(hph_ i) y))))
(define (c28-Gk k) (list 'VNB-LAMBDA 'hy_ '(PTS hs_)
                        (list 'FINSUM '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) (c28-Fy 'hy_) (list 'INTERVAL 1 k))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (forall-guarded '(hs_ hn_ hph_ het_ ha_)
    (list '(IS-METRIC-SPACE hs_) '(IN hn_ NN) '(<= k hn_) '(IN het_ (FUN (INTERVAL 1 hn_) RR)) '(IN ha_ (PTS hs_))
          '(FORALL i (IMPLIES (IN i (INTERVAL 1 hn_)) (IN (hph_ i) (FUN (PTS hs_) RR))))
          '(FORALL i (IMPLIES (IN i (INTERVAL 1 hn_)) (IS-CONTINUOUS-AT hs_ RR-MS (hph_ i) ha_))))
    (list 'IS-CONTINUOUS-AT 'hs_ 'RR-MS (c28-Gk 'k) 'ha_))))))
(ni)
(define (c28-step? l) (dk-contains? (dk-goal-of l) 'succ))
(define c28-hphT #f) (define c28-hphC #f)
(define (c28-grab!)
  (set! c28-hphT (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'i) (dk-contains? f 'FUN))) "ph typing"))
  (set! c28-hphC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'i) (dk-contains? f 'IS-CONTINUOUS-AT))) "ph continuity"))
  (c28-ptsrr!)
  (fact 'rr-is-metric-space)
  (dk-cite! 'ms-pts-is-set 'hs_))
;;; y in pts(s): the summand is real on INTERVAL(1, bound)
(define (c28-sum-typing! y bound)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'INTERVAL 1 bound)) (list 'IN (list (c28-Fy y) 'z_) 'RR)))))
    (dk-have! claim
      (lambda ()
        (let ((z (dk-di-var!)))
          (if (not (equal? bound 'hn_)) (dk-cite! 'interval-widen bound 'hn_ 1 z))
          (dk-lam-b!)
          (dk-cite! 'fun-apply-type-c 'het_ '(INTERVAL 1 hn_) 'RR z)
          (dk-apply! c28-hphT z)
          (dk-cite! 'fun-apply-type-c (list 'hph_ z) '(PTS hs_) 'RR y)
          (c28-and! (list 'IN (list 'het_ z) 'RR) (list 'IN (list (list 'hph_ z) y) 'RR))
          (dk-cite! 'rr-mul-closed (list 'het_ z) (list (list 'hph_ z) y))
          (ass))))
    (or (dk-ctx-form claim) claim)))
(define (c28-pts-set!) (ass))
(define (c28-Gk-type! k)            ; (IN G_k (FUN (PTS hs_) RR))
  (dk-have! (list 'IN (c28-Gk k) '(FUN (PTS hs_) RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((y (dk-di-var!)))
            (fact 'interval-in-set 1 k)
            (dk-cite! 'interval-card-in-nn 1 k)
            (c28-sum-typing! y k)
            (dk-cite! 'rb1-fs-real (list 'INTERVAL 1 k) (c28-Fy y))
            (ass)))
        c28-pts-set!))))
;;; base: the empty sum, the constant 0
(dk-focus! (find-first (lambda (l) (not (c28-step? l))) (c28-open)))
(dk-peel!)
(c28-grab!)
(fact 'interval-1-0-empty)
(fact 'nn-zero-in)
(c28-Gk-type! 0)
(dk-have! (list 'IN (c28-Gk 0) '(FUN (PTS hs_) (PTS RR-MS))) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(define (c28-zero-at! y)
  (dk-have! (list '= (list (c28-Gk 0) y) 0)
    (lambda ()
      (dk-lam-b!)
      (subst '(= (INTERVAL 1 0) EMPTY-SET))
      (subst (dk-cite! 'rb1-fs-empty (c28-Fy y)))
      (rfl))))
(dk-cite! 'rr-zero-in)
(dk-have! '(IN 0 (PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(dk-cite! 'ms-const-continuous-at 'hs_ 'RR-MS 0 'ha_)
(define c28-c0 '(VNB-LAMBDA msz_ (PTS hs_) 0))
(dk-have! (list 'FORALL 'cvz_ (list 'IMPLIES '(IN cvz_ (PTS hs_)) (list '= (list (c28-Gk 0) 'cvz_) (list c28-c0 'cvz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (c28-zero-at! z)
      (subst (list '= (list (c28-Gk 0) z) 0))
      (dk-lam-b!)
      (rfl))))
(dk-cite! 'ms-cont-transfer-ptwise-eq 'hs_ 'RR-MS c28-c0 (c28-Gk 0) 'ha_)
(ass)
;;; step
(dk-focus! (find-first c28-step? (c28-open)))
(dk-di-var!)
(dk-peel!)
(define c28-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hs_))) "the IH"))
(c28-grab!)
(dk-have! '(<= k hn_) (lambda () (dk-nn! '(<= (succ k) hn_))))
(dk-apply! c28-ih 'hs_ 'hn_ 'hph_ 'het_ 'ha_)
(dk-cite! 'nn-succ-closed 'k)
(dk-have! '(<= 1 (succ k)) (lambda () (dk-nn!)))
(dk-cite! 'interval-mem-intro 1 'hn_ '(succ k))
(dk-cite! 'fun-apply-type-c 'het_ '(INTERVAL 1 hn_) 'RR '(succ k))
(dk-apply! c28-hphT '(succ k))
(dk-apply! c28-hphC '(succ k))
(define c28-Hf '(VNB-LAMBDA sx_ (PTS hs_) (* (het_ (succ k)) ((hph_ (succ k)) sx_))))
(define c28-SUMF (list 'VNB-LAMBDA 'sx_ '(PTS hs_) (list '+ (list (c28-Gk 'k) 'sx_) (list c28-Hf 'sx_))))
(c28-Gk-type! 'k)
(dk-have! (list 'IN c28-Hf '(FUN (PTS hs_) RR))
  (lambda ()
    (dk-lam-type!
      (lambda () (let ((y (dk-di-var!))) (dk-cite! 'fun-apply-type-c '(hph_ (succ k)) '(PTS hs_) 'RR y) (in-rr)))
      c28-pts-set!)))
(dk-cite! 'ms-rr-scale-continuous-at 'hs_ '(het_ (succ k)) '(hph_ (succ k)) 'ha_)
(dk-cite! 'ms-rr-add-continuous-at 'hs_ (c28-Gk 'k) c28-Hf 'ha_)
(c28-Gk-type! '(succ k))
(dk-have! (list 'IN c28-SUMF '(FUN (PTS hs_) RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((y (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c (c28-Gk 'k) '(PTS hs_) 'RR y)
          (dk-cite! 'fun-apply-type-c c28-Hf '(PTS hs_) 'RR y)
          (c28-and! (list 'IN (list (c28-Gk 'k) y) 'RR) (list 'IN (list c28-Hf y) 'RR))
          (dk-cite! 'rr-add-closed (list (c28-Gk 'k) y) (list c28-Hf y))
          (ass)))
      c28-pts-set!)))
(define c28-U '(UNION (INTERVAL 1 k) (PAIR (succ k) (succ k))))
(dk-fun-ext! (c28-Gk '(succ k)) c28-SUMF '(PTS hs_) 'RR #f #f
  (lambda (v)
    (dk-lam-b!)
    (subst (dk-cite! 'interval-succ-insert 'k))
    (fact 'interval-in-set 1 'k)
    (dk-cite! 'interval-card-in-nn 1 'k)
    (dk-cite! 'membership-implies-sethood '(succ k) 'NN)
    (dk-have! '(NOT (IN (succ k) (INTERVAL 1 k)))
      (lambda () (di) (dk-cite! 'interval-hi 1 'k '(succ k)) (ai (dk-cite! 'nn-succ-not-le 'k))))
    (let ((ty (c28-sum-typing! v '(succ k))))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ c28-U) (list 'IN (list (c28-Fy v) 'z_) 'RR)))
        (lambda ()
          (let* ((z (dk-di-var!))
                 (m (dk-rewrite-h! (list 'IN z c28-U) c28-U '(INTERVAL 1 (succ k)))))
            (dk-apply! ty z) (ass)))))
    (subst (dk-cite! 'rb1-fs-ins '(INTERVAL 1 k) '(succ k) (c28-Fy v)))
    (dk-lam-b!)
    (c28-sum-typing! v 'k)
    (dk-cite! 'rb1-fs-real '(INTERVAL 1 k) (c28-Fy v))
    (dk-cite! 'fun-apply-type-c '(hph_ (succ k)) '(PTS hs_) 'RR v)
    (let ((g (dk-goal)))
      (if (equal? (cadr g) (caddr g)) (rfl) (crs)))))
(subst (list '= (c28-Gk '(succ k)) c28-SUMF))
(ass)
(qed 'finite-sum-continuous)

;;; (6) PROPOSITION 2.28, continuity in x: x |-> d_eta f(x) = sum_i eta_i d_(e_i) f(x) is
;;; continuous at every point of U.
(sp (make-wff (forall-guarded '(n u f p) c28-hyps
  (list 'FORALL 'eta (list 'IMPLIES '(IN eta (VEC (RN n))) (list 'FORALL 'x (list 'IMPLIES '(IN x u)
    (list 'IS-CONTINUOUS-AT c28-SUB 'RR-MS (list 'VNB-LAMBDA 'y 'u (c28-D 'eta 'y)) 'x))))))))
(dk-peel!)
(set! c28-hC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "conts"))
(c28-setting!)
(c28-inV-of-vec! 'eta)
(dk-cite! 'subspace-is-metric-space c28-E 'u)
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'IN '(p i) (list 'FUN (list 'PTS c28-SUB) 'RR))))
  (lambda ()
    (let* ((i (dk-di-var!))
           (ct (dk-apply! c28-hC i 'x))
           (ft (dk-project! (list 'IN (list 'p i) (list 'FUN (list 'PTS c28-SUB) '(PTS RR-MS)))
                            (lambda () (mac-h 'IS-CONTINUOUS-AT ct)))))
      (dk-rewrite-h! ft '(PTS RR-MS) 'RR)
      (ass))))
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'IS-CONTINUOUS-AT c28-SUB 'RR-MS '(p i) 'x)))
  (lambda () (let ((i (dk-di-var!))) (dk-apply! c28-hC i 'x) (ass))))
(fact 'nn-le-refl 'n)
(dk-have! (list 'IN 'x (list 'PTS c28-SUB)) (lambda () (subst (list '= (list 'PTS c28-SUB) 'u)) (ass)))
(define c28-cx (dk-cite! 'finite-sum-continuous 'n c28-SUB 'n 'p 'eta 'x))
(dk-rewrite-h! c28-cx (list 'PTS c28-SUB) 'u)
(ass)
(qed 'continuous-partials-dir-deriv-continuous)
