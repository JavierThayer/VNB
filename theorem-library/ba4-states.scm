;;; ba4-states.scm -- STATES: BanachAlgebras.pdf Corollary 4.9 (states have norm 1), the convexity of
;;; Sigma(A) and "a pure state is an extreme point" (Proposition 4.24, first half of its proof).
;;; Agent BA-1111-B, 2026-11-11.  Destination: theorem-library/ba4-states.scm.  Library: operator-algebras.
;;; Load window: after ba4-pos (pos-lf-norm) and structure-library/ba-rep-vocab (STATES, IS-PURE-STATE,
;;; FUNCTIONAL-LE).
;;;
;;;   pos-lf-combo          s psi + t rho is a positive functional for s, t >= 0
;;;   states-norm-one       Corollary 4.9: a state is a bounded functional of norm 1
;;;   states-convex         Proposition 4.24: Sigma(A) is convex
;;;   pure-state-extreme    Proposition 4.24: phi pure, phi = theta psi + (1 - theta) rho with psi, rho
;;;                         states and 0 < theta < 1  =>  psi = phi and rho = phi (pointwise)
;;;
;;; Helper prefix g4t-; binders g4t*_ used by no other file.

(define (g4t-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba4-states: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba4-states: unfinished" name))))
(define (g4t-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))
(define (g4t-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
        r)))
(define (g4t-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4t-occurs? x (car t)) (g4t-occurs? x (cdr t))))))
(define (g4t-rw! from to) (subst (list '= from to)))
(define (g4t-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) body))))
(define (g4t-mu x y) (list '(VMUL a) x y))
(define (g4t-sr x) (list '(VSTAR a) x))
(define (g4t-q x y) (g4t-mu (g4t-sr x) y))
(define (g4t-vt! t) (dk-alg-type! 'kal-uiba 'a t) t)
(define g4t-one '(VONE a))
(define (g4t-L r1 g r2 h) (list 'VNB-LAMBDA 'g4tw_ '(VEC a) (list '+ (list '* r1 (list g 'g4tw_)) (list '* r2 (list h 'g4tw_)))))
(define (g4t-cv! fn t) (g4t-vt! t) (dk-cite! 'fun-apply-type-c fn '(VEC a) 'CC t))

;;; open IS-POSITIVE-LF(a, fn): returns (ft la lm pos)
(define (g4t-open! fn)
  (let* ((hyp (list 'IS-POSITIVE-LF 'a fn))
         (iff (dk-cite! 'IS-POSITIVE-LF 'a fn))
         (body (caddr iff))
         (lin (dk-project! (cadr body) 'IS-POSITIVE-LF hyp))
         (pos (dk-project! (caddr body) 'IS-POSITIVE-LF hyp))
         (ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a fn)))
         (ft (dk-project! (cadr ld) 'IS-CC-LINEAR-ON lin))
         (la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON lin))
         (lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON lin)))
    (list ft la lm pos)))
;;; L(u) = r1 g(u) + r2 h(u), u typed
(define (g4t-L-at! r1 g r2 h u)
  (let* ((L (g4t-L r1 g r2 h)) (val (list '+ (list '* r1 (list g u)) (list '* r2 (list h u))))
         (cl (list '= (list L u) val)))
    (g4t-cv! g u) (g4t-cv! h u)
    (dk-cc-type! val)
    (if (not (dk-asm? cl))
        (dk-have! cl (lambda () (let ((l (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? l)) (g4t-close-eq!))))))
    (g4t-rw! (list L u) val)
    val))
;;; a state fn: land IS-POSITIVE-LF(a, fn) and fn(1) = 1
(define (g4t-out-state! fn)
  (let* ((hyp (list 'IN fn '(STATES a)))
         (pl (list 'IS-POSITIVE-LF 'a fn)) (one (list '= (list fn g4t-one) 1))
         (opener (lambda ()
                   (mac-h 'states-unfold hyp)
                   (let ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) fn) (dk-head-is? (caddr f) 'SEP)))
                                        (dk-asms))))
                     (sep-me m)
                     (dk-split-all!)))))
    (dk-project! pl opener)
    (dk-project! one opener)
    (list pl one)))

;;; ---- the unfold of STATES, as a theorem mac-h can name
(sp (make-wff '(FORALL a (== (STATES a) (SEP g4f_ (FUN (VEC a) CC) (AND (IS-POSITIVE-LF a g4f_) (= (g4f_ (VONE a)) 1)))))))
(di)
(mac 'STATES)
(if (not (proof-done? *ps*)) (qrfl))
(g4t-qed! 'states-unfold)

;;; L = r1 g + r2 h for CC-linear g, h (og, oh their g4t-open! lists): land L in FUN(VEC a, CC) and
;;; IS-CC-LINEAR-ON(a, L); return the linearity
(define (g4t-lin-combo! r1 g r2 h og oh)
  (let* ((L (g4t-L r1 g r2 h))
         (ft (list 'IN L '(FUN (VEC a) CC))))
    (dk-have! ft
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((u (dk-di-var!)))
              (g4t-cv! g u) (g4t-cv! h u)
              (if (not (proof-done? *ps*)) (dk-cc-type! (cadr (dk-goal))))
              (dk-close-if-asm!)))
          (lambda () (dk-cite! 'fun-domain-in-set '(VEC a) 'CC g) (dk-ass!)))))
    (let ((liff (dk-cite! 'IS-CC-LINEAR-ON 'a L)))
      (dk-have! (caddr liff)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g0 (dk-goal)))
                (if (dk-asm? g0) (dk-ass!)
                    (begin
                      (dk-peel!)
                      (let* ((g2 (dk-goal)) (arg (cadr (cadr g2))))
                        (if (equal? (car arg) '(VADD a))
                            (let ((u (cadr arg)) (w (caddr arg)))
                              (g4t-vt! arg)
                              (g4t-L-at! r1 g r2 h arg) (g4t-L-at! r1 g r2 h u) (g4t-L-at! r1 g r2 h w)
                              (subst (dk-apply! (cadr og) u w))
                              (if (not (equal? g h)) (subst (dk-apply! (cadr oh) u w)))
                              (crs))
                            (let ((c (cadr arg)) (u (caddr arg)))
                              (g4t-vt! arg)
                              (g4t-L-at! r1 g r2 h arg) (g4t-L-at! r1 g r2 h u)
                              (subst (dk-apply! (caddr og) c u))
                              (if (not (equal? g h)) (subst (dk-apply! (caddr oh) c u)))
                              (crs)))))))))))
      (let ((lin (list 'IS-CC-LINEAR-ON 'a L)))
        (dk-have! lin (lambda () (keep liff (caddr liff)) (prop)))
        lin))))

;;; ---- s g + t h is a positive functional
(define g4t-combo (g4t-L 'r1 'g 'r2 'h))
(sp (g4t-st (list 'FORALL 'g (list 'IMPLIES '(IS-POSITIVE-LF a g) (list 'FORALL 'h (list 'IMPLIES '(IS-POSITIVE-LF a h)
  (list 'FORALL 'r1 (list 'IMPLIES '(IN r1 RR) (list 'FORALL 'r2 (list 'IMPLIES '(IN r2 RR)
    (list 'IMPLIES '(<= 0 r1) (list 'IMPLIES '(<= 0 r2) (list 'IS-POSITIVE-LF 'a g4t-combo)))))))))))))
(dk-peel!)
(let* ((og (g4t-open! 'g)) (oh (g4t-open! 'h)) (L g4t-combo))
  (g4t-lin-combo! 'r1 'g 'r2 'h og oh)
  (let* ((iff (dk-cite! 'IS-POSITIVE-LF 'a L)))
    (let ((lin (list 'IS-CC-LINEAR-ON 'a L))
          (pos (caddr (caddr iff))))
      (dk-have! pos
        (lambda ()
          (let* ((x (dk-di-var!)) (xx (g4t-q x x)))
            (g4t-vt! xx)
            (g4t-L-at! 'r1 'g 'r2 'h xx)
            (dk-split! (dk-apply! (cadddr og) x))
            (dk-split! (dk-apply! (cadddr oh) x))
            (let ((p1 (list '* 'r1 (list 'g xx))) (p2 (list '* 'r2 (list 'h xx))))
              (g4t-cite*! 'rr-leq-mul-nonneg 'r1 (list 'g xx))
              (g4t-cite*! 'rr-leq-mul-nonneg 'r2 (list 'h xx))
              (dk-real! p1) (dk-real! p2)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'IN) (in-rr)
                      (dk-ineq! (list '<= 0 p1) (list '<= 0 p2)))))))))
      (keep iff lin pos)
      (prop))))
(g4t-qed! 'pos-lf-combo)

;;; ---- Corollary 4.9: a state is bounded, of norm 1
(sp (g4t-st (list 'FORALL 'g (list 'IMPLIES '(IN g (STATES a))
  (list 'AND '(IN g (CDUAL-VEC a)) '(= (CDUAL-NORM a g) 1))))))
(dk-peel!)
(g4t-out-state! 'g)
(dk-split! (dk-cite! 'pos-lf-norm 'a 'g))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
        (begin
          (subst (list '= '(CDUAL-NORM a g) (list 'g g4t-one)))
          (subst (list '= (list 'g g4t-one) 1))
          (g4t-close-eq!)))))
(g4t-qed! 'states-norm-one)

;;; ---- Proposition 4.24: Sigma(A) is convex
(define g4t-cvx (g4t-L 'r 'g '(- 1 r) 'h))
(sp (g4t-st (list 'FORALL 'g (list 'IMPLIES '(IN g (STATES a)) (list 'FORALL 'h (list 'IMPLIES '(IN h (STATES a))
  (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(<= 0 r) (list 'IMPLIES '(<= r 1)
    (list 'IN g4t-cvx '(STATES a))))))))))))
(dk-peel!)
(g4t-out-state! 'g) (g4t-out-state! 'h)
(g4t-open! 'g) (g4t-open! 'h)
(dk-real! '(- 1 r))
(dk-have! '(<= 0 (- 1 r)) (lambda () (dk-ineq! '(<= r 1))))
(g4t-cite*! 'pos-lf-combo 'a 'g 'h 'r '(- 1 r))
(g4t-open! g4t-cvx)
(mac 'STATES)
(in-sep!
  (lambda () (dk-ass!))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
            (begin
              (g4t-vt! g4t-one)
              (g4t-L-at! 'r 'g '(- 1 r) 'h g4t-one)
              (subst (list '= (list 'g g4t-one) 1))
              (subst (list '= (list 'h g4t-one) 1))
              (if (not (proof-done? *ps*)) (crs))))))))
(g4t-qed! 'states-convex)

;;; ---- Proposition 4.24: a pure state is an extreme point of Sigma(A)
;;; k a state, c > 0 its coefficient, (= (f y) RHS) for every y with RHS = r g(y) + m h(y), both terms
;;; nonnegative at y* y: from c k <= f and purity, k = f pointwise.  Lands (= (k x) (f x)).
(define (g4t-pure-part! U D k c x m)
  (let* ((psi (g4t-L c k 0 k)))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
    (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c))))
    (g4t-cite*! 'pos-lf-combo 'a k k c 0)
    ;; c k <= f
    (dk-have! (list 'FUNCTIONAL-LE 'a psi 'f)
      (lambda ()
        (mac 'FUNCTIONAL-LE)
        (let* ((y (dk-di-var!)) (yy (g4t-q y y)))
          (g4t-vt! yy)
          (g4t-L-at! c k 0 k yy)
          (let* ((dy (dk-apply! D yy)))
            (g4t-cv! 'g yy) (g4t-cv! 'h yy)
            (subst dy)
            (for-each (lambda (pr) (dk-split! (dk-apply! (car pr) y))) (list (list (cadr (assq 'g g4t-pos))) (list (cadr (assq 'h g4t-pos)))))
            (let ((pg (list '* 'r (list 'g yy))) (ph (list '* m (list 'h yy))) (pk (list '* c (list k yy))) (pz (list '* 0 (list k yy))))
              (g4t-cite*! 'rr-leq-mul-nonneg 'r (list 'g yy))
              (g4t-cite*! 'rr-leq-mul-nonneg m (list 'h yy))
              (dk-real! pg) (dk-real! ph)
              (dk-have! (list '= (list '+ pk pz) pk) (lambda () (crs)))
              (g4t-rw! (list '+ pk pz) pk)
              (dk-ineq! (list '<= 0 pg) (list '<= 0 ph)))))))
    (let* ((ex (dk-apply! U psi))
           (l (dk-skolem! ex)))
      (dk-split-all!)
      (g4t-vt! g4t-one)
      (let* ((W (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (g4t-occurs? l f))) (dk-asms)))
             (w1 (dk-apply! W g4t-one)))
        (g4t-cv! k g4t-one) (g4t-cv! 'f g4t-one)
        (dk-have! (list '= (list psi g4t-one) (list '+ (list '* c (list k g4t-one)) (list '* 0 (list k g4t-one))))
          (lambda () (let ((nd (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? nd)) (g4t-close-eq!)))))
        (let* ((w1a (dk-rewrite-h! w1 (list psi g4t-one) (list '+ (list '* c (list k g4t-one)) (list '* 0 (list k g4t-one)))))
               (w1b (dk-rewrite-h! w1a (list k g4t-one) 1))
               (w1c (dk-rewrite-h! w1b (list 'f g4t-one) 1)))
          (dk-have! (list '= (list '+ (list '* c 1) (list '* 0 1)) c) (lambda () (crs)))
          (dk-have! (list '= (list '* l 1) l) (lambda () (crs)))
          (let* ((w1d (dk-rewrite-h! w1c (list '+ (list '* c 1) (list '* 0 1)) c))
                 (w1e (dk-rewrite-h! w1d (list '* l 1) l))      ; c = l
                 (wx (dk-apply! W x))
                 (kx (list k x)) (fx (list 'f x)))
            (g4t-cv! k x) (g4t-cv! 'f x)
            (dk-have! (list '= (list psi x) (list '+ (list '* c kx) (list '* 0 kx)))
              (lambda () (let ((nd (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? nd)) (g4t-close-eq!)))))
            (dk-have! (list '= (list '+ (list '* c kx) (list '* 0 kx)) (list '* c kx)) (lambda () (crs)))
            (let* ((wx1 (dk-rewrite-h! wx (list psi x) (list '+ (list '* c kx) (list '* 0 kx))))
                   (wx2 (dk-rewrite-h! wx1 (list '+ (list '* c kx) (list '* 0 kx)) (list '* c kx)))
                   (wx3 (dk-rewrite-h! wx2 l c)))
              (dk-cc-type! c)
              (g4t-cite*! 'rr-pos-ne-zero c)
              (g4t-cite*! 'ch-cc-cancel c kx fx))))))))
(define g4t-pos '())
(define g4t-dec '(FORALL g4ty_ (IMPLIES (IN g4ty_ (VEC a)) (= (f g4ty_) (+ (* r (g g4ty_)) (* (- 1 r) (h g4ty_)))))))
(sp (g4t-st (list 'FORALL 'f (list 'IMPLIES '(IS-PURE-STATE a f)
  (list 'FORALL 'g (list 'IMPLIES '(IN g (STATES a)) (list 'FORALL 'h (list 'IMPLIES '(IN h (STATES a))
  (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r) (list 'IMPLIES '(< r 1)
  (list 'IMPLIES g4t-dec
    (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) '(AND (= (g x) (f x)) (= (h x) (f x))))))))))))))))))
(dk-peel!)
(let* ((piff (dk-cite! 'IS-PURE-STATE 'a 'f)) (pbody (caddr piff)) (hyp '(IS-PURE-STATE a f))
       (fs (dk-project! (cadr pbody) 'IS-PURE-STATE hyp))
       (U (dk-project! (caddr pbody) 'IS-PURE-STATE hyp)))
  (g4t-out-state! 'f) (g4t-out-state! 'g) (g4t-out-state! 'h)
  (set! g4t-pos (list (list 'g (cadddr (g4t-open! 'g))) (list 'h (cadddr (g4t-open! 'h)))))
  (g4t-open! 'f)
  (dk-real! '(- 1 r))
  (let* ((m (dk-name! '(- 1 r)))
         (D (dk-rewrite-h! g4t-dec '(- 1 r) m)))
    (dk-have! (list '< 0 m) (lambda () (dk-ineq! '(< r 1) (list '= m '(- 1 r)))))
    (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '< 0 m))))
    (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
    (g4t-pure-part! U D 'g 'r 'x m)
    (g4t-pure-part! U D 'h m 'x m)
    (dk-conj-close! (lambda () (dk-ass!)))))
(g4t-qed! 'pure-state-extreme)

;;; =============================================================================================
;;; Proposition 4.24, the converse: an extreme point of Sigma(A) is a pure state.
(define (g4t-iff! iff from)
  (let ((other (if (alpha-equiv? (cadr iff) from) (caddr iff) (cadr iff))))
    (if (not (dk-asm? other)) (dk-have! other (lambda () (keep iff from) (prop))))
    other))
(define (g4t-recip! t)      ; 0 < t, t in RR: name recip(t) as rn, land t * rn = 1 and 0 < rn
  (dk-have! (list 'NOT (list '= t 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0))))
  (dk-have! (list 'AND (list 'IN t 'RR) (list 'NOT (list '= t 0))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-recip-closed t)
  (dk-cite! 'rr-recip-inverse t)
  (dk-cite! 'rr-recip-pos t)
  (let* ((r (list 'recip t)) (rn (dk-name! r)))
    (dk-rewrite-h! (list '= (list '* t r) 1) r rn)
    (dk-rewrite-h! (list '< 0 r) r rn)
    rn))
(define g4t-m1 '(- 1))

;;; psi <= phi => phi - psi is a positive functional
(define g4t-diff (g4t-L 1 'f g4t-m1 'g))
(sp (g4t-st (list 'FORALL 'f (list 'IMPLIES '(IS-POSITIVE-LF a f) (list 'FORALL 'g (list 'IMPLIES '(IS-POSITIVE-LF a g)
  (list 'IMPLIES '(FUNCTIONAL-LE a g f) (list 'IS-POSITIVE-LF 'a g4t-diff))))))))
(dk-peel!)
(let* ((of (g4t-open! 'f)) (og (g4t-open! 'g)) (L g4t-diff)
       (fiff (dk-cite! 'FUNCTIONAL-LE 'a 'g 'f))
       (fle (g4t-iff! fiff '(FUNCTIONAL-LE a g f))))
  (g4t-lin-combo! 1 'f g4t-m1 'g of og)
  (let* ((iff (dk-cite! 'IS-POSITIVE-LF 'a L))
         (lin (list 'IS-CC-LINEAR-ON 'a L))
         (pos (caddr (caddr iff))))
    (dk-have! pos
      (lambda ()
        (let* ((x (dk-di-var!)) (xx (g4t-q x x)))
          (g4t-vt! xx)
          (g4t-L-at! 1 'f g4t-m1 'g xx)
          (dk-split! (dk-apply! (cadddr of) x))
          (dk-split! (dk-apply! (cadddr og) x))
          (dk-apply! fle x)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN) (in-rr)
                  (dk-ineq! (list '<= (list 'g xx) (list 'f xx)))))))))
    (keep iff lin pos)
    (prop)))
(g4t-qed! 'lf-diff-positive)

;;; a positive functional vanishing at 1 vanishes
(sp (g4t-st (list 'FORALL 'f (list 'IMPLIES '(IS-POSITIVE-LF a f) (list 'IMPLIES (list '= (list 'f g4t-one) 0)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) '(= (f x) 0))))))))
(dk-peel!)
(g4t-open! 'f)
(let* ((nx '((VNRM a) x)) (fx '(f x)) (mg (list 'MAGNITUDE fx))
       (b (dk-cite! 'pos-lf-bounded 'a 'f 'x))
       (b1 (dk-rewrite-h! b (list 'f g4t-one) 0)))
  (dk-split! (dk-cite! 'uiba-vnrm-real 'a 'x))
  (g4t-cv! 'f 'x)
  (dk-have! (list '= (list '* 0 nx) 0) (lambda () (crs)))
  (dk-rewrite-h! b1 (list '* 0 nx) 0)
  (dk-cite! 'cc-magnitude-closed fx)
  (dk-cite! 'cc-magnitude-nonneg fx)
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! (list 'AND (list 'IN mg 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-have! (list 'AND (list '<= mg 0) (list '<= 0 mg)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (g4t-cite*! 'rr-leq-antisymmetric mg 0)
  (g4t-iff! (dk-cite! 'cc-magnitude-zero-iff fx) (list '= mg 0)))
(dk-close-if-asm!)
(g4t-qed! 'pos-lf-vanish)

;;; THE CONVERSE
(define g4t-ext
  '(FORALL g (IMPLIES (IN g (STATES a)) (FORALL h (IMPLIES (IN h (STATES a))
     (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r) (IMPLIES (< r 1)
       (IMPLIES (FORALL g4ty_ (IMPLIES (IN g4ty_ (VEC a)) (= (f g4ty_) (+ (* r (g g4ty_)) (* (- 1 r) (h g4ty_))))))
         (FORALL g4tz_ (IMPLIES (IN g4tz_ (VEC a)) (= (g g4tz_) (f g4tz_))))))))))))))
(define (g4t-in-state! L fn-open c)   ; L positive, L(1) computed by the thunk to 1
  (g4t-open! L)
  (dk-have! (list 'IN L '(STATES a))
    (lambda ()
      (mac 'STATES)
      (in-sep! (lambda () (dk-ass!))
               (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (fn-open)))))))))
(sp (g4t-st (list 'FORALL 'f (list 'IMPLIES '(IN f (STATES a)) (list 'IMPLIES g4t-ext '(IS-PURE-STATE a f))))))
(dk-peel!)
(g4t-out-state! 'f)
(let* ((of (g4t-open! 'f))
       (piff (dk-cite! 'IS-PURE-STATE 'a 'f)) (pb (caddr piff)) (U (caddr pb)))
  (g4t-vt! g4t-one)
  (g4t-cv! 'f g4t-one)
  (dk-have! U
    (lambda ()
      (dk-peel!)
      (let* ((fl (find-first (lambda (q) (and (dk-head-is? q 'FUNCTIONAL-LE) (equal? (cadddr q) 'f))) (dk-asms)))
             (G (caddr fl)) (og (g4t-open! G)) (c (list G g4t-one))
             (fle (g4t-iff! (dk-cite! 'FUNCTIONAL-LE 'a G 'f) fl))
             (rho (g4t-L 1 'f g4t-m1 G)))
        (g4t-cv! G g4t-one)
        (dk-split! (dk-cite! 'pos-lf-unit 'a G))
        ;; c <= 1
        (let* ((oo (g4t-q g4t-one g4t-one)))
          (g4t-vt! oo)
          (dk-alg-have! 'kal-uiba 'a (list '= oo g4t-one))
          (dk-rewrite-h! (dk-rewrite-h! (dk-apply! fle g4t-one) oo g4t-one) (list 'f g4t-one) 1))
        (dk-have! '(IN 0 RR) (lambda () (arith)))
        (dk-have! '(IN 1 RR) (lambda () (arith)))
        (dk-cite! 'lf-diff-positive 'a 'f G)
        (let ((orho (g4t-open! rho)))
          (dk-or-each! (g4t-cite*! 'rr-le-cases 0 c)
            (lambda (d1)
              (if (dk-head-is? d1 '=)
                  ;; psi(1) = 0: psi = 0 phi
                  (begin
                    (dk-have! (list '= c 0) (lambda () (subst (list '= c 0)) (g4t-close-eq!)))
                    (ew 0)
                    (dk-conj-close!
                      (lambda ()
                        (let ((g0 (dk-goal)))
                          (cond ((dk-asm? g0) (dk-ass!))
                                ((dk-head-is? g0 'IN) (arith))
                                ((dk-head-is? g0 '<=) (dk-ineq!))
                                (#t (let* ((x (dk-di-var!)))
                                      (g4t-cv! G x) (g4t-cv! 'f x)
                                      (subst (g4t-cite*! 'pos-lf-vanish 'a G x))
                                      (crs))))))))
                  (dk-or-each! (g4t-cite*! 'rr-le-cases c 1)
                    (lambda (d2)
                      (if (dk-head-is? d2 '=)
                          ;; psi(1) = 1: rho(1) = 0, psi = phi
                          (begin
                            (dk-have! (list '= (list rho g4t-one) 0)
                              (lambda ()
                                (g4t-L-at! 1 'f g4t-m1 G g4t-one)
                                (subst (list '= (list 'f g4t-one) 1))
                                (subst (list '= c 1))
                                (crs)))
                            (ew 1)
                            (dk-conj-close!
                              (lambda ()
                                (let ((g0 (dk-goal)))
                                  (cond ((dk-asm? g0) (dk-ass!))
                                        ((dk-head-is? g0 'IN) (arith))
                                        ((dk-head-is? g0 '<=) (dk-ineq!))
                                        (#t (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list G x)))
                                              (g4t-cv! G x) (g4t-cv! 'f x)
                                              (let* ((z (g4t-cite*! 'pos-lf-vanish 'a rho x))
                                                     (val (list '+ (list '* 1 fx) (list '* g4t-m1 gx))))
                                                (dk-have! (list '= (list rho x) val)
                                                  (lambda () (let ((nd (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? nd)) (g4t-close-eq!)))))
                                                (dk-rewrite-h! z (list rho x) val)
                                                (dk-have! (list '= (list '* 1 fx) (list '+ gx val)) (lambda () (crs)))
                                                (subst (list '= (list '* 1 fx) (list '+ gx val)))
                                                (subst (list '= val 0))
                                                (crs)))))))))
                          ;; 0 < psi(1) < 1: phi = c (psi / c) + (1 - c) (rho / (1 - c))
                          (let* ((i (g4t-recip! c))
                                 (m (begin (dk-real! (list '- 1 c)) (dk-name! (list '- 1 c))))
                                 (j (begin (dk-have! (list '< 0 m) (lambda () (dk-ineq! d2 (list '= m (list '- 1 c)))))
                                           (g4t-recip! m)))
                                 (psi (g4t-L i G 0 G))
                                 (sig (g4t-L j rho 0 rho)))
                            (dk-have! '(IN 0 RR) (lambda () (arith)))
                            (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                            (dk-have! (list '<= 0 i) (lambda () (dk-ineq! (list '< 0 i))))
                            (dk-have! (list '<= 0 j) (lambda () (dk-ineq! (list '< 0 j))))
                            (g4t-cite*! 'pos-lf-combo 'a G G i 0)
                            (g4t-cite*! 'pos-lf-combo 'a rho rho j 0)
                            (g4t-cv! rho g4t-one)
                            (g4t-in-state! psi
                              (lambda ()
                                (g4t-L-at! i G 0 G g4t-one)
                                (dk-have! (list '= (list '+ (list '* i c) (list '* 0 c)) (list '* c i)) (lambda () (crs)))
                                (subst (list '= (list '+ (list '* i c) (list '* 0 c)) (list '* c i)))
                                (subst (list '= (list '* c i) 1))
                                (g4t-close-eq!))
                              c)
                            (g4t-in-state! sig
                              (lambda ()
                                (g4t-L-at! j rho 0 rho g4t-one)
                                (g4t-L-at! 1 'f g4t-m1 G g4t-one)
                                (subst (list '= (list 'f g4t-one) 1))
                                (let ((r1v (list '+ (list '* 1 1) (list '* g4t-m1 c))))
                                  (dk-have! (list '= r1v (list '- 1 c)) (lambda () (crs)))
                                  (subst (list '= r1v (list '- 1 c)))
                                  (subst (list '= (list '- 1 c) m))
                                  (dk-have! (list '= (list '+ (list '* j m) (list '* 0 m)) (list '* m j)) (lambda () (crs)))
                                  (subst (list '= (list '+ (list '* j m) (list '* 0 m)) (list '* m j)))
                                  (subst (list '= (list '* m j) 1))
                                  (g4t-close-eq!)))
                              c)
                            ;; the decomposition
                            (let ((dec (list 'FORALL 'g4ty_ (list 'IMPLIES '(IN g4ty_ (VEC a))
                                         (list '= '(f g4ty_) (list '+ (list '* c (list psi 'g4ty_)) (list '* (list '- 1 c) (list sig 'g4ty_))))))))
                              (dk-have! dec
                                (lambda ()
                                  (let* ((y (dk-di-var!)) (fy (list 'f y)) (gy (list G y)))
                                    (g4t-cv! G y) (g4t-cv! 'f y)
                                    (g4t-L-at! i G 0 G y)
                                    (g4t-L-at! j rho 0 rho y)
                                    (g4t-L-at! 1 'f g4t-m1 G y)
                                    (subst (list '= (list '- 1 c) m))
                                    (let* ((R (caddr (dk-goal)))
                                           (E1 (list '+ (list '* (list '* c i) gy) (list '* (list '* m j) (list '+ fy (list '* g4t-m1 gy))))))
                                      (dk-have! (list '= R E1) (lambda () (crs)))
                                      (subst (list '= R E1))
                                      (subst (list '= (list '* c i) 1))
                                      (subst (list '= (list '* m j) 1))
                                      (crs)))))
                              (let ((E (dk-apply! g4t-ext psi sig c)))
                                (ew c)
                                (dk-conj-close!
                                  (lambda ()
                                    (let ((g0 (dk-goal)))
                                      (cond ((dk-asm? g0) (dk-ass!))
                                            ((dk-head-is? g0 '<=) (dk-ineq! d2))
                                            (#t (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list G x))
                                                       (ex (dk-apply! E x))
                                                       (pv (list '+ (list '* i gx) (list '* 0 gx))))
                                                  (g4t-cv! G x) (g4t-cv! 'f x)
                                                  (dk-cc-type! pv)
                                                  (dk-have! (list '= (list psi x) pv)
                                                    (lambda () (let ((nd (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? nd)) (g4t-close-eq!)))))
                                                  (dk-rewrite-h! ex (list psi x) pv)
                                                  (subst (list '= fx pv))
                                                  (dk-have! (list '= (list '* c pv) (list '* (list '* c i) gx)) (lambda () (crs)))
                                                  (subst (list '= (list '* c pv) (list '* (list '* c i) gx)))
                                                  (subst (list '= (list '* c i) 1))
                                                  (crs))))))))))))))))))))
  (dk-have! '(IS-PURE-STATE a f) (lambda () (keep piff (cadr pb) U) (prop))))
(g4t-qed! 'extreme-state-pure)
