;;; tb-extremal.scm -- topological-vector-space.pdf Prop 2.40: extremal subsets are transitive, closed under
;;; intersections (with nonempty intersection) and under inverse images by linear maps.
;;; Agent TB-01, 2026-10-26.  DESTINATION: theorem-library/tvs-extremal.scm (after sip-hilbert-vocab, the
;;; tvs vocabulary).  Library: analysis.  Helper prefix: tbe-.

(define (tbe-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
;;; the four conjuncts of IS-EXTREMAL-SUBSET(v, b, a), landed (the hypothesis survives); returns them
(define (tbe-parts! v b a)
  (let* ((h (list 'IS-EXTREMAL-SUBSET v b a))
         (iff (dk-cite! 'is-extremal-subset v b a))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND)) (loop (caddr r) (cons (cadr r) acc)) (reverse (cons r acc))))))
    (for-each (lambda (c)
                (if (not (dk-asm? c))
                    (dk-have! c (lambda () (mac-h 'IS-EXTREMAL-SUBSET (dk-ctx-form h)) (dk-split-all!) (ass)))))
              cs)
    cs))
(define (tbe-combo v t x y) (list (list 'VADD v) (list (list 'ACT v) t x) (list (list 'ACT v) (list '- 1 t) y)))

;;; ---------------------------------------------------------------------------
;;; (1) C extremal in B, B extremal in A  =>  C extremal in A
(sp (make-wff '(FORALL v (FORALL c (FORALL b (FORALL a
  (IMPLIES (IS-EXTREMAL-SUBSET v c b) (IMPLIES (IS-EXTREMAL-SUBSET v b a) (IS-EXTREMAL-SUBSET v c a)))))))))
(dk-peel!)
(let* ((p1 (tbe-parts! 'v 'c 'b)) (cl1 (list-ref p1 3))
       (p2 (tbe-parts! 'v 'b 'a)) (cl2 (list-ref p2 3)))
  (dk-cite! 'subset-trans 'c 'b 'a)
  (mac 'is-extremal-subset)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (co (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (cadr f)))) ld))))
                 (t (cadr (cadr co))) (x (caddr (cadr co))) (y (caddr (caddr co))))
            (dk-cite! 'subset-mem-fwd 'c 'b co)
            (dk-split! (dk-apply! cl2 x y t))
            (dk-apply! cl1 x y t)
            (dk-ass!))))))
(tbe-qed! 'extremal-subset-trans)

;;; ---------------------------------------------------------------------------
;;; (2) intersections: C_l extremal in D_l for every l, and the C_l meet  =>  their intersection is
;;; extremal in the intersection of the D_l (intersections over the index set ix, as SEPs over VEC v)
(define tbe-rrv '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define tbe-ic '(SEP exw_ (VEC v) (FORALL exl_ (IMPLIES (IN exl_ ix) (IN exw_ (cf exl_))))))
(define tbe-id '(SEP exw_ (VEC v) (FORALL exl_ (IMPLIES (IN exl_ ix) (IN exw_ (df exl_))))))
(define tbe-allx '(FORALL exl_ (IMPLIES (IN exl_ ix) (IS-EXTREMAL-SUBSET v (cf exl_) (df exl_)))))
;;; from (IN w sep) in context: land (IN w (VEC v)) and the forall of its condition at w; return the forall
(define (tbe-mem! w sep)
  (let* ((cnd (list 'FORALL 'exl_ (list 'IMPLIES '(IN exl_ ix) (list 'IN w (list (if (dk-contains? sep 'cf) 'cf 'df) 'exl_))))))
    (dk-have! cnd (lambda () (sep-me (dk-ctx-form (list 'IN w sep))) (dk-split-all!) (dk-ass!)))
    (dk-have! (list 'IN w '(VEC v)) (lambda () (sep-me (dk-ctx-form (list 'IN w sep))) (dk-split-all!) (dk-ass!)))
    cnd))
;;; (IN (1 - t) (CARR (SCAL v))) and (IN t (CARR (SCAL v))) from t in RR
(define (tbe-scal! t)
  (for-each
    (lambda (r)
      (let ((g (list 'IN r '(CARR (SCAL v)))))
        (if (not (dk-asm? g))
            (begin
              (if (not (dk-asm? (list 'IN r 'RR))) (dk-have! (list 'IN r 'RR) (lambda () (type-term))))
              (dk-have! g (lambda () (subst (list '= '(SCAL v) tbe-rrv))
                                     (subst (list '== (list 'CARR tbe-rrv) '(CARR RR-NORMED-FIELD)))
                                     (subst '(== (CARR RR-NORMED-FIELD) RR))
                                     (dk-ass!)))))))
    (list t (list '- 1 t))))

(define (tbe-at! l)            ; l in ix: the extremal parts of C_l in D_l; returns (convex-clause . extremal-clause)
  (if (not (dk-asm? (list 'IN (list 'cf l) '(POWER (VEC v))))) (dk-cite! 'fun-apply-type-c 'cf 'ix '(POWER (VEC v)) l))
  (if (not (dk-asm? (list 'IN (list 'df l) '(POWER (VEC v))))) (dk-cite! 'fun-apply-type-c 'df 'ix '(POWER (VEC v)) l))
  (inst*! (dk-ctx-form tbe-allx) l)
  (let* ((ps (tbe-parts! 'v (list 'cf l) (list 'df l)))
         (cv (car ps))
         (iffc (dk-cite! 'is-convex-subset 'v (list 'cf l)))
         (cc (caddr (caddr iffc))))
    (dk-have! cc (lambda () (mac-h 'is-convex-subset (dk-ctx-form cv)) (dk-split-all!) (dk-ass!)))
    (cons cc (list-ref ps 3))))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'ix (list 'FORALL 'cf (list 'FORALL 'df
  (list 'IMPLIES '(IS-MODULE v) (list 'IMPLIES (list '= '(SCAL v) tbe-rrv)
    (list 'IMPLIES '(IN cf (FUN ix (POWER (VEC v)))) (list 'IMPLIES '(IN df (FUN ix (POWER (VEC v))))
    (list 'IMPLIES tbe-allx (list 'IMPLIES (list 'FORSOME 'exz_ (list 'IN 'exz_ tbe-ic))
      (list 'IS-EXTREMAL-SUBSET 'v tbe-ic tbe-id)))))))))))))
(dk-peel!)
(fact 'rr-is-normed-field)
(dk-cite! 'normed-field-ring-view-carr 'RR-NORMED-FIELD)
(fact 'rr-nf-carr)
(mac 'is-extremal-subset)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ;; convexity of the intersection
        ((dk-head-is? g 'IS-CONVEX-SUBSET)
         (mac 'is-convex-subset)
         (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'SUBSET)
                 (begin (mac 'subset-def) (let ((w (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN w tbe-ic))) (dk-split-all!) (dk-ass!)))
                 (let* ((ld (dk-peel!))
                        (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) tbe-ic))) ld))
                        (a (cadr (car ins))) (b (cadr (cadr ins)))
                        (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                        (aa (tbe-mem! a tbe-ic)) (ba (tbe-mem! b tbe-ic))
                        (co (list '(VADD v) (list '(ACT v) (list '- 1 t) a) (list '(ACT v) t b))))
                   (tbe-scal! t)
                   (dk-cite! 'module-act-type 'v (list '- 1 t) a)
                   (dk-cite! 'module-act-type 'v t b)
                   (dk-cite! 'module-vadd-type 'v (list '(ACT v) (list '- 1 t) a) (list '(ACT v) t b))
                   (in-sep! (lambda () (dk-ass!))
                     (lambda ()
                       (let ((l (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                         (inst*! aa l) (inst*! ba l)
                         (let ((cl (tbe-at! l)))
                           (dk-apply! (car cl) a b t)
                           (dk-ass!))))))))))
        ;; the intersection of the C's lies in that of the D's
        ((dk-head-is? g 'SUBSET)
         (mac 'subset-def)
         (let* ((w (dk-di-var!)) (wa (tbe-mem! w tbe-ic)))
           (in-sep! (lambda () (dk-ass!))
             (lambda ()
               (let ((l (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                 (inst*! wa l)
                 (tbe-at! l)
                 (dk-cite! 'subset-mem-fwd (list 'cf l) (list 'df l) w)
                 (dk-ass!))))))
        ;; extremality
        (#t
         (let* ((ld (dk-peel!))
                (co (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (cadr f)))) ld))))
                (t (cadr (cadr co))) (x (caddr (cadr co))) (y (caddr (caddr co)))
                (xa (tbe-mem! x tbe-id)) (ya (tbe-mem! y tbe-id)) (ca (tbe-mem! co tbe-ic)))
           (dk-conj-close!
             (lambda ()
               (in-sep! (lambda () (dk-ass!))
                 (lambda ()
                   (let ((l (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                     (inst*! xa l) (inst*! ya l) (inst*! ca l)
                     (let ((cl (tbe-at! l)))
                       (dk-split! (dk-apply! (cdr cl) x y t))
                       (dk-ass!)))))))))))))
(tbe-qed! 'extremal-subset-inter)

;;; ---------------------------------------------------------------------------
;;; (3) inverse images by a linear map
(define tbe-fb '(SEP exw_ (VEC m1) (IN (f exw_) b)))
(define tbe-fa '(SEP exw_ (VEC m1) (IN (f exw_) a)))
(define tbe-lin '(IS-LINEAR-MAP m1 m2 f))
;;; from (IN w sep): land (IN (f w) X) and (IN w (VEC m1)) -- the condition first (a goal-equal claim
;;; proved in place would close the caller's lane)
(define (tbe-pmem! w sep)
  (let ((cnd (list 'IN (list 'f w) (if (dk-contains? sep 'b) 'b 'a))))
    (dk-have! cnd (lambda () (sep-me (dk-ctx-form (list 'IN w sep))) (dk-split-all!) (dk-ass!)))
    (dk-have! (list 'IN w '(VEC m1)) (lambda () (sep-me (dk-ctx-form (list 'IN w sep))) (dk-split-all!) (dk-ass!)))
    cnd))
(define tbe-add '(FORALL x (IMPLIES (IN x (VEC m1)) (FORALL y (IMPLIES (IN y (VEC m1))
                   (= (f ((VADD m1) x y)) ((VADD m2) (f x) (f y))))))))
(define (tbe-scal1! t)
  (for-each
    (lambda (r)
      (let ((g (list 'IN r '(CARR (SCAL m1)))))
        (if (not (dk-asm? g))
            (begin
              (if (not (dk-asm? (list 'IN r 'RR))) (dk-have! (list 'IN r 'RR) (lambda () (type-term))))
              (dk-have! g (lambda () (subst (list '= '(SCAL m1) tbe-rrv))
                                     (subst (list '== (list 'CARR tbe-rrv) '(CARR RR-NORMED-FIELD)))
                                     (subst '(== (CARR RR-NORMED-FIELD) RR))
                                     (dk-ass!)))))))
    (list t (list '- 1 t))))
;;; f(r1 . u1 + r2 . u2) = r1 . f(u1) + r2 . f(u2), landed; returns the equation
(define (tbe-lin2! r1 u1 r2 u2)
  (let* ((a1 (list '(ACT m1) r1 u1)) (a2 (list '(ACT m1) r2 u2)))
    (tbe-scal1! r1) (tbe-scal1! r2)
    (dk-cite! 'module-act-type 'm1 r1 u1)
    (dk-cite! 'module-act-type 'm1 r2 u2)
    (dk-apply! (dk-ctx-form tbe-add) a1 a2)
    (dk-cite! 'frm-linear-homog 'm1 'm2 'f r1 u1)
    (dk-cite! 'frm-linear-homog 'm1 'm2 'f r2 u2)
    (let* ((e0 (list '= (list 'f (list '(VADD m1) a1 a2)) (list '(VADD m2) (list 'f a1) (list 'f a2))))
           (e1 (dk-rewrite-h! e0 (list 'f a1) (list '(ACT m2) r1 (list 'f u1)))))
      (dk-rewrite-h! e1 (list 'f a2) (list '(ACT m2) r2 (list 'f u2))))))

(sp (make-wff (list 'FORALL 'm1 (list 'FORALL 'm2 (list 'FORALL 'f (list 'FORALL 'b (list 'FORALL 'a
  (list 'IMPLIES tbe-lin (list 'IMPLIES (list '= '(SCAL m1) tbe-rrv)
    (list 'IMPLIES '(IS-EXTREMAL-SUBSET m2 b a) (list 'IMPLIES (list 'FORSOME 'exz_ (list 'IN 'exz_ tbe-fb))
      (list 'IS-EXTREMAL-SUBSET 'm1 tbe-fb tbe-fa))))))))))))
(dk-peel!)
(fact 'rr-is-normed-field)
(dk-cite! 'normed-field-ring-view-carr 'RR-NORMED-FIELD)
(fact 'rr-nf-carr)
(for-each (lambda (c) (dk-have! c (lambda () (mac-h 'IS-LINEAR-MAP (dk-ctx-form tbe-lin)) (dk-split-all!) (dk-ass!))))
          (list '(IS-MODULE m1) '(IS-MODULE m2) '(IN f (FUN (VEC m1) (VEC m2))) tbe-add))
(let* ((ps (tbe-parts! 'm2 'b 'a))
       (cv (car ps)) (cl (list-ref ps 3))
       (iffc (dk-cite! 'is-convex-subset 'm2 'b))
       (cc (caddr (caddr iffc))))
  (dk-have! cc (lambda () (mac-h 'is-convex-subset (dk-ctx-form cv)) (dk-split-all!) (dk-ass!)))
  (mac 'is-extremal-subset)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? g 'IS-CONVEX-SUBSET)
           (mac 'is-convex-subset)
           (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'SUBSET)
                   (begin (mac 'subset-def) (let ((w (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN w tbe-fb))) (dk-split-all!) (dk-ass!)))
                   (let* ((ld (dk-peel!))
                          (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) tbe-fb))) ld))
                          (u1 (cadr (car ins))) (u2 (cadr (cadr ins)))
                          (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                          (m1 (tbe-pmem! u1 tbe-fb)) (m2 (tbe-pmem! u2 tbe-fb))
                          (co (list '(VADD m1) (list '(ACT m1) (list '- 1 t) u1) (list '(ACT m1) t u2)))
                          (eq (tbe-lin2! (list '- 1 t) u1 t u2)))
                     (dk-cite! 'module-vadd-type 'm1 (list '(ACT m1) (list '- 1 t) u1) (list '(ACT m1) t u2))
                     (in-sep! (lambda () (dk-ass!))
                       (lambda ()
                         (subst eq)
                         (dk-apply! cc (list 'f u1) (list 'f u2) t)
                         (dk-ass!))))))))
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def)
           (let* ((w (dk-di-var!)) (mw (tbe-pmem! w tbe-fb)))
             (dk-cite! 'subset-mem-fwd 'b 'a (list 'f w))
             (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (#t
           (let* ((ld (dk-peel!))
                  (co (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (cadr f)))) ld))))
                  (t (cadr (cadr co))) (x (caddr (cadr co))) (y (caddr (caddr co)))
                  (mx (tbe-pmem! x tbe-fa)) (my (tbe-pmem! y tbe-fa)) (mc (tbe-pmem! co tbe-fb))
                  (eq (tbe-lin2! t x (list '- 1 t) y)))
             (dk-rewrite-h! (list 'IN (list 'f co) 'b) (list 'f co) (caddr eq))
             (dk-cite! 'fun-apply-type-c 'f '(VEC m1) '(VEC m2) x)
             (dk-cite! 'fun-apply-type-c 'f '(VEC m1) '(VEC m2) y)
             (dk-split! (dk-apply! cl (list 'f x) (list 'f y) t))
             (dk-conj-close! (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))))))
(tbe-qed! 'extremal-subset-preimage)
