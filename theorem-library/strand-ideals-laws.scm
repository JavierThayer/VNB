;;; strand-ideals-laws.scm -- IDEALS OF THE MESSAGE ALGEBRA: Propositions 6.3, 6.6, 6.7, 6.8,
;;; Lemma 6.4 and Proposition 6.9 of Thayer, Herzog, Guttman, "Strand spaces: proving security
;;; protocols correct" (~/docs/jcs_strand_spaces.pdf, section 6), on the user's model (notes-60
;;; with encryption).  Vocabulary: structure-library/strand-ideals.scm (IS-KEY-IDEAL,
;;; KEY-IDEAL-GEN, IS-SIMPLE-MSG, IDEAL-STAGE).  Agent SB-1, wave MAP-1026, 2026-10-26.
;;; Destination: theorem-library/strand-ideals-laws.scm.  Library: strand.  Helper prefix sbi-.
;;;
;;; Every theorem bills `modulo 0'.  Nothing is asserted, stamped or warranted.
;;;
;;; LOAD WINDOW: after structure-library/strand-ideals and theorem-library/strand-space-laws
;;; (bundle-minimal-sent, bundle-ssb-precedes, bundle-ssb-closed, bundle-nodes-in-space,
;;; bundle-space, node-content-in-msgs: the latest citations, for 6.9), hence after
;;; strand-messages-laws (lst-injective, encr-injective, encr-ne-list, lst-ne-encr,
;;; list-in-msgs, encr-in-msgs, msg-set-is-set); the core facts cited (class-extensionality,
;;; singleton-membership, subclass-of-set-is-set, power-mem-intro, membership-implies-sethood,
;;; empty-set-has-no-members, nn-zero-in) load far earlier.  No later file is needed: the slot
;;; just after theorem-library/strand-space-laws (before strand-adversary) is right.
;;;
;;; THE TECHNIQUE.  (a) The generated ideal is a separation of A = MSG-SET(T, K); a membership
;;; is opened on a lane (the SEP form is rewritten back to the functoid, as strand-messages-laws
;;; does for the stages).  (b) Minimality is ONE citation, key-ideal-gen-least.  (c) The paper's
;;; "I' = I_k[S] minus one element" arguments of 6.6, 6.7, 6.8 are factored ONCE as an inversion
;;; lemma, key-ideal-gen-cases: a member of I_k[S] is in S, or a list message with a component
;;; in I_k[S], or an encryption of a member of I_k[S] under a key of KS.  On the tagged model
;;; LST and ENCR are injective and disjoint (the paper's freeness, Axiom 1, is a theorem here),
;;; so 6.6, 6.7 and 6.8 are each one case analysis of that lemma.

;;; -----------------------------------------------------------------------
;;; helpers (prefix sbi-)

(define (sbi-keep-prop! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? node)) (prop))))

(define (sbi-msgs tt kk) `(MSG-SET ,tt ,kk))
(define (sbi-gen tt kk ks s) `(KEY-IDEAL-GEN ,tt ,kk ,ks ,s))

;; The body of IS-KEY-IDEAL(tt, kk, ks, j), with the definition's own binders.
(define (sbi-ideal-body tt kk ks j)
  `(AND (FORALL sbix_ (IMPLIES (IN sbix_ ,j) (IN sbix_ (MSG-SET ,tt ,kk))))
   (AND (FORALL sbil_ (FORALL sbij_
          (IMPLIES (IN sbil_ (TUPLES (MSG-SET ,tt ,kk)))
           (IMPLIES (IN sbij_ NN)
            (IMPLIES (<= 1 sbij_)
             (IMPLIES (<= sbij_ (LENGTH sbil_))
              (IMPLIES (IN (NTH sbij_ sbil_) ,j)
                       (IN (LST sbil_) ,j))))))))
        (FORALL sbih_ (FORALL sbiy_
          (IMPLIES (IN sbih_ ,j)
           (IMPLIES (IN sbiy_ ,ks)
                    (IN (ENCR sbih_ sbiy_) ,j))))))))

;; IS-KEY-IDEAL(tt, kk, ks, j) in context: land its three clauses (subset, list, encryption)
;; WITHOUT consuming it; return them as a list.
(define (sbi-ideal-parts! tt kk ks j)
  (let* ((hyp `(IS-KEY-IDEAL ,tt ,kk ,ks ,j))
         (body (sbi-ideal-body tt kk ks j))
         (parts (list (cadr body) (cadr (caddr body)) (caddr (caddr body)))))
    (if (not (dk-asm? hyp)) (error "sbi-ideal-parts!: not in context" (expression->string hyp)))
    (for-each (lambda (c)
                (dk-have! c (lambda () (fact 'is-key-ideal tt kk ks j) (sbi-keep-prop! (iff-for hyp) hyp))))
              parts)
    parts))

;; The kind of a conjunct goal of the unfolded IS-KEY-IDEAL.
(define (sbi-conj-kind g)
  (let ((body (caddr g)))
    (cond ((dk-head-is? body 'IMPLIES) 'sub)
          ((dk-head-is? (caddr (cadr (caddr body))) 'TUPLES) 'lst)
          (#t 'encr))))

;; The goal IS-KEY-IDEAL(tt, kk, ks, j): unfold, and close the three clauses by
;; (SUB! x)    -- goal (IN x A), (IN x j) in context;
;; (LST! l i)  -- goal (IN (LST l) j), l in TUPLES(A), i in NN, 1 <= i <= LENGTH(l),
;;                (IN (NTH i l) j) in context;
;; (ENCR! h y) -- goal (IN (ENCR h y) j), (IN h j), (IN y ks) in context.
(define (sbi-ideal-intro! sub! lst! encr!)
  (mac 'is-key-ideal)
  (dk-conj-close!
    (lambda ()
      (let* ((kind (sbi-conj-kind (dk-goal)))
             (landed (dk-peel!))
             (g (dk-goal)))
        (case kind
          ((sub) (sub! (cadr g)))
          ((lst) (let* ((l (cadr (cadr g)))
                        (nm (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'NTH)))
                                            landed)
                                (error "sbi-ideal-intro!: no component membership landed"))))
                   (lst! l (cadr (cadr nm)))))
          (else (encr! (cadr (cadr g)) (caddr (cadr g)))))))))

;; (IN m (KEY-IDEAL-GEN tt kk ks s)) in context: land (IN m A) and the universal "m is in every
;; KS-ideal in POWER(A) containing s"; return the universal.
(define (sbi-gen-open! m tt kk ks s)
  (let* ((eqn (dk-cite! 'key-ideal-gen-unfold tt kk ks s))
         (sepm `(IN ,m ,(caddr eqn))))
    (dk-have! sepm (lambda () (subst `(= ,(caddr eqn) ,(cadr eqn))) (ass)))
    (let ((landed (dk-landed (lambda () (sep-me sepm)))))
      (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)
          (error "sbi-gen-open!: no universal landed")))))

;; (IN x (BIG-UNION v D B)) in context: open it; return (INDEX . MEMBERSHIP), both landed.
(define (sbi-bu-open! mem)
  (let* ((d (caddr (caddr mem)))
         (landed (dk-landed (lambda () (bu-me mem))))
         (ix (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) d))) landed)
                 (error "sbi-bu-open!: no index landed" (map expression->string landed))))
         (mm (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (not (eq? f ix)))) landed)
                 (error "sbi-bu-open!: no membership landed"))))
    (cons (cadr ix) mm)))

;; Goal (IN x (BIG-UNION v D B)) with (IN w D) and (IN x B[w]) in context.
(define (sbi-bu-in! w)
  (dk-each-leaf! (lambda () (bu-mi w)) (lambda () (ass))))

;;; -----------------------------------------------------------------------
;;; 1. The generated ideal: unfold, elimination, minimality, introduction, ideal-hood.

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (== (KEY-IDEAL-GEN T K ks S)
   (SEP sbgm_ (MSG-SET T K)
        (FORALL sbgq_ (IMPLIES (IN sbgq_ (POWER (MSG-SET T K)))
                       (IMPLIES (IS-KEY-IDEAL T K ks sbgq_)
                        (IMPLIES (FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ sbgq_)))
                                 (IN sbgm_ sbgq_)))))))))))))
(di) (mac 'KEY-IDEAL-GEN) (qrfl)
(qed 'key-ideal-gen-unfold)

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL m (FORALL ii
   (IMPLIES (IN m (KEY-IDEAL-GEN T K ks S))
    (IMPLIES (IN ii (POWER (MSG-SET T K)))
     (IMPLIES (IS-KEY-IDEAL T K ks ii)
      (IMPLIES (FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ ii)))
               (IN m ii)))))))))))))
(dk-peel!)
(dk-apply! (sbi-gen-open! 'm 'T 'K 'ks 'S) 'ii)
(ass)
(qed 'key-ideal-gen-elim)

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL m
   (IMPLIES (IN m (KEY-IDEAL-GEN T K ks S)) (IN m (MSG-SET T K))))))))))
(dk-peel!)
(sbi-gen-open! 'm 'T 'K 'ks 'S)
(ass)
(qed 'key-ideal-gen-in-msgs)

;;; Minimality: the generated ideal is included in every KS-ideal containing S.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL ii
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (IS-KEY-IDEAL T K ks ii)
     (IMPLIES (FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ ii)))
      (FORALL m (IMPLIES (IN m (KEY-IDEAL-GEN T K ks S)) (IN m ii))))))))))))))
(dk-peel!)
(let* ((parts (sbi-ideal-parts! 'T 'K 'ks 'ii))
       (a (sbi-msgs 'T 'K)))
  (fact 'msg-set-is-set 'T 'K)
  (dk-have! `(SUBSET ii ,a) (lambda () (mac 'subset-def) (ass)))
  (fact 'subclass-of-set-is-set 'ii a)
  (fact 'power-mem-intro a 'ii)
  (fact 'key-ideal-gen-elim 'T 'K 'ks 'S 'm 'ii)
  (ass))
(qed 'key-ideal-gen-least)

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL x
   (IMPLIES (IN x S) (IMPLIES (IN x (MSG-SET T K)) (IN x (KEY-IDEAL-GEN T K ks S)))))))))))
(dk-peel!)
(mac 'KEY-IDEAL-GEN)
(in-sep! (lambda () (ass))
         (lambda ()
           (let ((landed (dk-peel!)))
             (dk-apply! (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)
                            (error "no inclusion landed"))
                        'x)
             (ass))))
(qed 'key-ideal-gen-contains)

;;; The generated ideal is a KS-ideal (KS a set of keys).
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL y (IMPLIES (IN y ks) (IN y K)))
             (IS-KEY-IDEAL T K ks (KEY-IDEAL-GEN T K ks S)))))))))))
(let* ((landed (dk-peel!))
       (kss (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
       (g (sbi-gen 'T 'K 'ks 'S))
       ;; on the lane where q is a KS-ideal containing S: (IN x q) from (IN x G)
       (in-q! (lambda (x q) (fact 'key-ideal-gen-elim 'T 'K 'ks 'S x q))))
  (sbi-ideal-intro!
    (lambda (x) (fact 'key-ideal-gen-in-msgs 'T 'K 'ks 'S x) (ass))
    (lambda (l i)
      (mac 'KEY-IDEAL-GEN)
      (in-sep! (lambda () (fact 'list-in-msgs 'T 'K l) (ass))
               (lambda ()
                 (dk-peel!)
                 (let ((q (caddr (dk-goal))))
                   (in-q! `(NTH ,i ,l) q)
                   (dk-apply! (cadr (sbi-ideal-parts! 'T 'K 'ks q)) l i)
                   (ass)))))
    (lambda (h y)
      (mac 'KEY-IDEAL-GEN)
      (in-sep! (lambda ()
                 (fact 'key-ideal-gen-in-msgs 'T 'K 'ks 'S h)
                 (dk-apply! kss y)
                 (fact 'encr-in-msgs 'T 'K h y)
                 (ass))
               (lambda ()
                 (dk-peel!)
                 (let ((q (caddr (dk-goal))))
                   (in-q! h q)
                   (dk-apply! (caddr (sbi-ideal-parts! 'T 'K 'ks q)) h y)
                   (ass)))))))
(qed 'key-ideal-gen-is-ideal)

;;; The principal ideal I_k[x] contains x; and it is included in every KS-ideal holding x.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL x
   (IMPLIES (IN x (MSG-SET T K)) (IN x (KEY-IDEAL-GEN T K ks (SINGLETON x))))))))))
(dk-peel!)
(fact 'membership-implies-sethood 'x '(MSG-SET T K))
(dk-have! '(= x x) (lambda () (rfl)))
(dk-have! '(IN x (SINGLETON x))
  (lambda () (fact 'singleton-membership 'x 'x) (sbi-keep-prop! (iff-for '(IN x (SINGLETON x))) '(IN x SET) '(= x x))))
(fact 'key-ideal-gen-contains 'T 'K 'ks '(SINGLETON x) 'x)
(ass)
(qed 'key-ideal-gen-self)

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL ii (FORALL x (FORALL m
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (IS-KEY-IDEAL T K ks ii)
     (IMPLIES (IN x ii)
      (IMPLIES (IN m (KEY-IDEAL-GEN T K ks (SINGLETON x))) (IN m ii))))))))))))))
(dk-peel!)
(dk-have! '(FORALL sbgz_ (IMPLIES (IN sbgz_ (SINGLETON x)) (IN sbgz_ ii)))
  (lambda ()
    (dk-peel!)
    (let* ((z (cadr (dk-goal)))
           (mem `(IN ,z (SINGLETON x))))
      (fact 'singleton-membership 'x z)
      (dk-have! `(= ,z x) (lambda () (sbi-keep-prop! (iff-for mem) mem)))
      (subst `(= ,z x))
      (ass))))
(dk-cite! 'key-ideal-gen-least 'T 'K 'ks '(SINGLETON x) 'ii 'm)
(ass)
(qed 'key-ideal-gen-singleton-least)

;;; -----------------------------------------------------------------------
;;; 2. PROPOSITION 6.3: I_k[S] is the union over x in S of I_k[x].

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL y (IMPLIES (IN y ks) (IN y K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (= (KEY-IDEAL-GEN T K ks S)
         (BIG-UNION x S (KEY-IDEAL-GEN T K ks (SINGLETON x))))))))))))))
(let* ((landed (dk-peel!))
       (subs (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MSG-SET))) landed))
       (g (sbi-gen 'T 'K 'ks 'S))
       (u '(BIG-UNION x S (KEY-IDEAL-GEN T K ks (SINGLETON x))))
       (pg (lambda (x) (sbi-gen 'T 'K 'ks `(SINGLETON ,x)))))
  (dk-have! `(IS-KEY-IDEAL T K ks ,g) (lambda () (fact 'key-ideal-gen-is-ideal 'T 'K 'ks 'S) (ass)))
  (dk-have! `(FORALL sbuw_ (IFF (IN sbuw_ ,g) (IN sbuw_ ,u)))
    (lambda ()
      (dk-peel!)
      (dk-iff! (lambda (gl) (equal? (caddr gl) u))
        ;; G in U: U is a KS-ideal containing S
        (lambda ()
          (let ((w (cadr (dk-goal))))
            (dk-have! `(IS-KEY-IDEAL T K ks ,u)
              (lambda ()
                (sbi-ideal-intro!
                  (lambda (x)
                    (let ((o (sbi-bu-open! `(IN ,x ,u))))
                      (fact 'key-ideal-gen-in-msgs 'T 'K 'ks `(SINGLETON ,(car o)) x)
                      (ass)))
                  (lambda (l i)
                    (let* ((o (sbi-bu-open! `(IN (NTH ,i ,l) ,u)))
                           (x0 (car o)))
                      (fact 'key-ideal-gen-is-ideal 'T 'K 'ks `(SINGLETON ,x0))
                      (dk-apply! (cadr (sbi-ideal-parts! 'T 'K 'ks (pg x0))) l i)
                      (sbi-bu-in! x0)))
                  (lambda (h y)
                    (let* ((o (sbi-bu-open! `(IN ,h ,u)))
                           (x0 (car o)))
                      (fact 'key-ideal-gen-is-ideal 'T 'K 'ks `(SINGLETON ,x0))
                      (dk-apply! (caddr (sbi-ideal-parts! 'T 'K 'ks (pg x0))) h y)
                      (sbi-bu-in! x0))))))
            (dk-have! `(FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ ,u)))
              (lambda ()
                (dk-peel!)
                (let ((z (cadr (dk-goal))))
                  (dk-apply! subs z)
                  (fact 'key-ideal-gen-self 'T 'K 'ks z)
                  (sbi-bu-in! z))))
            (dk-cite! 'key-ideal-gen-least 'T 'K 'ks 'S u w)
            (ass)))
        ;; U in G: each I_k[x], x in S, is inside the KS-ideal G, which holds x
        (lambda ()
          (let* ((w (cadr (dk-goal)))
                 (o (sbi-bu-open! `(IN ,w ,u)))
                 (x0 (car o)))
            (dk-apply! subs x0)
            (fact 'key-ideal-gen-contains 'T 'K 'ks 'S x0)
            (dk-cite! 'key-ideal-gen-singleton-least 'T 'K 'ks g x0 w)
            (ass))))))
  (fact 'class-extensionality g u)
  (ass))
(qed 'key-ideal-gen-union)


;;; -----------------------------------------------------------------------
;;; 3. LEMMA 6.4: I_k[S] is the union over i of I_empty[S_i], S_0 = S, S_(i+1) the encryptions
;;; under keys of KS of the members of I_empty[S_i].

;;; A KS-ideal is an empty-set-ideal (the encryption clause is vacuous).
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL ii
   (IMPLIES (IS-KEY-IDEAL T K ks ii) (IS-KEY-IDEAL T K EMPTY-SET ii))))))))
(dk-peel!)
(let ((parts (sbi-ideal-parts! 'T 'K 'ks 'ii)))
  (sbi-ideal-intro!
    (lambda (x) (dk-apply! (car parts) x) (ass))
    (lambda (l i) (dk-apply! (cadr parts) l i) (ass))
    (lambda (h y)
      (fact 'empty-set-has-no-members y)
      (sbi-keep-prop! `(IN ,y EMPTY-SET) `(NOT (IN ,y EMPTY-SET))))))
(qed 'key-ideal-empty-keys)

;; (IN m (IDEAL-STAGE tt kk ks ss n)) in context, n = 0 or (succ j): land and return
;; (IN m BODY), BODY the right-hand side of the stage equation.
(define (sbi-stage-eq tt kk ks ss n)
  (if (equal? n 0)
      (dk-cite! 'ideal-stage-zero tt kk ks ss)
      (dk-cite! 'ideal-stage-succ tt kk ks ss (cadr n))))
(define (sbi-stage-open! m tt kk ks ss n)
  (let* ((eqn (sbi-stage-eq tt kk ks ss n))
         (claim `(IN ,m ,(caddr eqn))))
    (dk-have! claim (lambda () (subst `(= ,(caddr eqn) ,(cadr eqn))) (ass)))
    claim))
;; The goal (IN m (IDEAL-STAGE tt kk ks ss n)): rewrite it to (IN m BODY).
(define (sbi-stage-goal! tt kk ks ss n)
  (let ((eqn (sbi-stage-eq tt kk ks ss n)))
    (subst `(= ,(cadr eqn) ,(caddr eqn)))))

;;; Every stage is a subset of A, as a member of POWER(A): the TYPING that certifies a stage term
;;; defined before anything is instantiated at it.
(sp (make-wff '(FORALL i (IMPLIES (IN i NN) (FORALL T (FORALL K (FORALL ks (FORALL S
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (IN (IDEAL-STAGE T K ks S i) (POWER (MSG-SET T K))))))))))))))
(define sbi-cases0 (dk-opened (lambda () (ni))))
(define (sbi-step-case? g)
  (and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'IMPLIES)
       (dk-head-is? (cadr (caddr g)) 'IN) (eq? (caddr (cadr (caddr g))) 'NN)))
(dk-focus! (find-first (lambda (l) (not (sbi-step-case? (dk-goal-of l)))) sbi-cases0))
(let* ((landed (dk-peel!))
       (stg (cadr (dk-goal)))
       (tt (cadr stg)) (kk (caddr stg)) (ks (cadddr stg)) (ss (car (cddddr stg)))
       (a (sbi-msgs tt kk)))
  (sbi-stage-goal! tt kk ks ss 0)
  (fact 'msg-set-is-set tt kk)
  (dk-have! `(SUBSET ,ss ,a) (lambda () (mac 'subset-def) (ass)))
  (fact 'subclass-of-set-is-set ss a)
  (fact 'power-mem-intro a ss)
  (ass))
(dk-focus! (find-first (lambda (l) (sbi-step-case? (dk-goal-of l))) sbi-cases0))
(let* ((landed (dk-peel!))
       (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IDEAL-STAGE))) landed))
       (stg (cadr (dk-goal)))
       (tt (cadr stg)) (kk (caddr stg)) (ks (cadddr stg)) (ss (car (cddddr stg)))
       (sn (car (cddddr (cdr stg))))
       (a (sbi-msgs tt kk)))
  (dk-apply! ih tt kk ks ss)
  (fact 'msg-set-is-set tt kk)
  (sbi-stage-goal! tt kk ks ss sn)
  (let ((body (cadr (dk-goal))))
    (dk-have! `(IN ,body SET) (lambda () (sep-set) (ass)))
    (dk-have! `(FORALL sbpz_ (IMPLIES (IN sbpz_ ,body) (IN sbpz_ ,a)))
      (lambda ()
        (dk-peel!)
        (sep-me `(IN ,(cadr (dk-goal)) ,body))
        (ass)))
    (fact 'power-mem-intro a body)
    (ass)))
(qed 'ideal-stage-in-power)

;;; Every stage lies in I_k[S] (the paper: "By induction, S_i is a subset of I_k[S]").
(sp (make-wff '(FORALL i (IMPLIES (IN i NN) (FORALL T (FORALL K (FORALL ks (FORALL S
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL y (IMPLIES (IN y ks) (IN y K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (FORALL z (IMPLIES (IN z (IDEAL-STAGE T K ks S i)) (IN z (KEY-IDEAL-GEN T K ks S))))))))))))))))
(define sbi-cases (dk-opened (lambda () (ni))))
(dk-focus! (find-first (lambda (l) (not (sbi-step-case? (dk-goal-of l)))) sbi-cases))
(let* ((landed (dk-peel!))
       (g (dk-goal))
       (z (cadr g)) (gen (caddr g))
       (tt (cadr gen)) (kk (caddr gen)) (ks (cadddr gen)) (ss (car (cddddr gen)))
       (subs (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MSG-SET))) landed)))
  (sbi-stage-open! z tt kk ks ss 0)
  (dk-apply! subs z)
  (fact 'key-ideal-gen-contains tt kk ks ss z)
  (ass))
(dk-focus! (find-first (lambda (l) (sbi-step-case? (dk-goal-of l))) sbi-cases))
(let* ((landed (dk-peel!))
       (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IDEAL-STAGE))) landed))
       (g (dk-goal))
       (z (cadr g)) (gen (caddr g))
       (tt (cadr gen)) (kk (caddr gen)) (ks (cadddr gen)) (ss (car (cddddr gen)))
       (smem (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) z)
                                          (dk-head-is? (caddr f) 'IDEAL-STAGE)))
                         landed))
       (sn (car (cddddr (cdr (caddr smem)))))
       (n (cadr sn)))
  (dk-apply! ih tt kk ks ss)
  (dk-cite! 'ideal-stage-in-power n tt kk ks ss)
  (dk-have! `(IS-KEY-IDEAL ,tt ,kk ,ks ,gen) (lambda () (fact 'key-ideal-gen-is-ideal tt kk ks ss) (ass)))
  (fact 'key-ideal-empty-keys tt kk ks gen)
  (let* ((body (sbi-stage-open! z tt kk ks ss sn))
         (lnd (dk-landed (lambda () (sep-me body))))
         (ex (or (find-first (lambda (f) (dk-head-is? f 'FORSOME)) lnd) (error "no witness landed")))
         (gv (dk-skolem! ex))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f gv))) "the key"))
         (yv (dk-skolem! ex2)))
    (dk-cite! 'key-ideal-gen-least tt kk 'EMPTY-SET `(IDEAL-STAGE ,tt ,kk ,ks ,ss ,n) gen gv)
    (dk-apply! (caddr (sbi-ideal-parts! tt kk ks gen)) gv yv)
    (subst `(= ,z (ENCR ,gv ,yv)))
    (ass)))
(qed 'ideal-stage-in-gen)

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL y (IMPLIES (IN y ks) (IN y K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (= (KEY-IDEAL-GEN T K ks S)
         (BIG-UNION i NN (KEY-IDEAL-GEN T K EMPTY-SET (IDEAL-STAGE T K ks S i))))))))))))))
(let* ((landed (dk-peel!))
       (kss (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ks))) landed))
       (subs (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MSG-SET))) landed))
       (g (sbi-gen 'T 'K 'ks 'S))
       (u '(BIG-UNION i NN (KEY-IDEAL-GEN T K EMPTY-SET (IDEAL-STAGE T K ks S i))))
       (st (lambda (i) `(IDEAL-STAGE T K ks S ,i)))
       (pg (lambda (i) (sbi-gen 'T 'K 'EMPTY-SET (st i))))
       (ty! (lambda (i) (dk-cite! 'ideal-stage-in-power i 'T 'K 'ks 'S))))
  (dk-have! `(IS-KEY-IDEAL T K ks ,g) (lambda () (fact 'key-ideal-gen-is-ideal 'T 'K 'ks 'S) (ass)))
  (fact 'key-ideal-empty-keys 'T 'K 'ks g)
  (dk-have! '(FORALL y (IMPLIES (IN y EMPTY-SET) (IN y K)))
    (lambda ()
      (dk-peel!)
      (let ((y (cadr (dk-goal))))
        (fact 'empty-set-has-no-members y)
        (sbi-keep-prop! `(IN ,y EMPTY-SET) `(NOT (IN ,y EMPTY-SET))))))
  (dk-have! `(FORALL sbuw_ (IFF (IN sbuw_ ,g) (IN sbuw_ ,u)))
    (lambda ()
      (dk-peel!)
      (dk-iff! (lambda (gl) (equal? (caddr gl) u))
        ;; G in U: U is a KS-ideal containing S
        (lambda ()
          (let ((w (cadr (dk-goal))))
            (dk-have! `(IS-KEY-IDEAL T K ks ,u)
              (lambda ()
                (sbi-ideal-intro!
                  (lambda (x)
                    (let ((o (sbi-bu-open! `(IN ,x ,u))))
                      (ty! (car o))
                      (fact 'key-ideal-gen-in-msgs 'T 'K 'EMPTY-SET (st (car o)) x)
                      (ass)))
                  (lambda (l j)
                    (let* ((o (sbi-bu-open! `(IN (NTH ,j ,l) ,u)))
                           (i0 (car o)))
                      (ty! i0)
                      (fact 'key-ideal-gen-is-ideal 'T 'K 'EMPTY-SET (st i0))
                      (dk-apply! (cadr (sbi-ideal-parts! 'T 'K 'EMPTY-SET (pg i0))) l j)
                      (sbi-bu-in! i0)))
                  (lambda (h y)
                    (let* ((o (sbi-bu-open! `(IN ,h ,u)))
                           (i0 (car o))
                           (e `(ENCR ,h ,y)))
                      (ty! i0)
                      (fact 'nn-succ-closed i0)
                      (ty! `(succ ,i0))
                      (fact 'key-ideal-gen-in-msgs 'T 'K 'EMPTY-SET (st i0) h)
                      (dk-apply! kss y)
                      (fact 'encr-in-msgs 'T 'K h y)
                      (dk-have! `(IN ,e ,(st `(succ ,i0)))
                        (lambda ()
                          (sbi-stage-goal! 'T 'K 'ks 'S `(succ ,i0))
                          (in-sep! (lambda () (ass))
                                   (lambda ()
                                     (ew h)
                                     (dk-conj-close!
                                       (lambda ()
                                         (if (dk-head-is? (dk-goal) 'FORSOME)
                                             (begin (ew y)
                                                    (dk-conj-close!
                                                      (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass)))))
                                             (ass))))))))
                      (fact 'key-ideal-gen-contains 'T 'K 'EMPTY-SET (st `(succ ,i0)) e)
                      (fact 'nn-succ-closed i0)
                      (sbi-bu-in! `(succ ,i0)))))))
            (dk-have! `(FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ ,u)))
              (lambda ()
                (dk-peel!)
                (let ((z (cadr (dk-goal))))
                  (dk-apply! subs z)
                  (fact 'nn-zero-in)
                  (ty! 0)
                  (dk-have! `(IN ,z ,(st 0)) (lambda () (sbi-stage-goal! 'T 'K 'ks 'S 0) (ass)))
                  (fact 'key-ideal-gen-contains 'T 'K 'EMPTY-SET (st 0) z)
                  (fact 'nn-zero-in)
                  (sbi-bu-in! 0))))
            (dk-cite! 'key-ideal-gen-least 'T 'K 'ks 'S u w)
            (ass)))
        ;; U in G: by the stage lemma, each I_empty[S_i] is inside the empty-set-ideal G
        (lambda ()
          (let* ((w (cadr (dk-goal)))
                 (o (sbi-bu-open! `(IN ,w ,u)))
                 (i0 (car o)))
            (ty! i0)
            (dk-cite! 'ideal-stage-in-gen i0 'T 'K 'ks 'S)
            (dk-cite! 'key-ideal-gen-least 'T 'K 'EMPTY-SET (st i0) g w)
            (ass))))))
  (fact 'class-extensionality g u)
  (ass))
(qed 'key-ideal-gen-stages)

;;; -----------------------------------------------------------------------
;;; 4. THE INVERSION of the generated ideal (the paper's "I' = I_k[S] minus one element"
;;; argument, done once): a member of I_k[S] is in S, or a list message with a component in
;;; I_k[S], or an encryption of a member of I_k[S] under a key of KS.

;; An OR in context, split to its leaves (right-nested): HANDLER is called on each leaf with
;; the disjunct that landed there.
(define (sbi-or-each! o handler)
  (dk-each-leaf! (lambda () (ai o))
    (lambda ()
      (cond ((dk-asm? (cadr o)) (handler (cadr o)))
            ((dk-head-is? (caddr o) 'OR) (sbi-or-each! (caddr o) handler))
            (#t (handler (caddr o)))))))

;; Close the focus goal, a FORSOME / AND tower, with the witnesses WS in order: an equation by
;; orienting it on its left side and `rfl', anything else from the context.
(define (sbi-ex-fill! ws)
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'FORSOME) (ew (car ws)) (sbi-ex-fill! (cdr ws)))
          ((dk-head-is? g 'AND) (dk-conj-close! (lambda () (sbi-ex-fill! ws))))
          ((dk-asm? g) (ass))
          ((dk-head-is? g '=)
           (if (not (equal? (cadr g) (caddr g))) (subst `(= ,(cadr g) ,(caddr g))))
           (rfl))
          (#t (ass)))))

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL x
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL y (IMPLIES (IN y ks) (IN y K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (IMPLIES (IN x (KEY-IDEAL-GEN T K ks S))
       (OR (IN x S)
        (OR (FORSOME l (AND (IN l (TUPLES (MSG-SET T K)))
                            (AND (= x (LST l))
                                 (FORSOME j (AND (IN j NN) (AND (<= 1 j) (AND (<= j (LENGTH l))
                                                   (IN (NTH j l) (KEY-IDEAL-GEN T K ks S)))))))))
            (FORSOME h (AND (IN h (KEY-IDEAL-GEN T K ks S))
                            (FORSOME y (AND (IN y ks) (= x (ENCR h y))))))))))))))))))))
(let* ((landed (dk-peel!))
       (subs (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MSG-SET))) landed))
       (concl (dk-goal))
       (d1 (cadr concl)) (d2 (cadr (caddr concl))) (d3 (caddr (caddr concl)))
       (g (sbi-gen 'T 'K 'ks 'S))
       (j `(SEP sbcw_ ,g (NOT (= sbcw_ x)))))
  (pbc)
  (let* ((no (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'OR))) "the negated cases"))
         (absurd! (lambda (d) (sbi-keep-prop! no d))))
    (dk-have! `(IS-KEY-IDEAL T K ks ,g) (lambda () (fact 'key-ideal-gen-is-ideal 'T 'K 'ks 'S) (ass)))
    (let ((parts (sbi-ideal-parts! 'T 'K 'ks g)))
      (dk-have! `(IS-KEY-IDEAL T K ks ,j)
        (lambda ()
          (sbi-ideal-intro!
            (lambda (v)
              (sep-me `(IN ,v ,j))
              (fact 'key-ideal-gen-in-msgs 'T 'K 'ks 'S v)
              (ass))
            (lambda (l i)
              (sep-me `(IN (NTH ,i ,l) ,j))
              (dk-apply! (cadr parts) l i)
              (in-sep! (lambda () (ass))
                       (lambda ()
                         (di)
                         (dk-have! d2 (lambda () (sbi-ex-fill! (list l i))))
                         (absurd! d2))))
            (lambda (h y)
              (sep-me `(IN ,h ,j))
              (dk-apply! (caddr parts) h y)
              (in-sep! (lambda () (ass))
                       (lambda ()
                         (di)
                         (dk-have! d3 (lambda () (sbi-ex-fill! (list h y))))
                         (absurd! d3)))))))
      (dk-have! `(FORALL sbgz_ (IMPLIES (IN sbgz_ S) (IN sbgz_ ,j)))
        (lambda ()
          (dk-peel!)
          (let ((z (cadr (dk-goal))))
            (dk-apply! subs z)
            (fact 'key-ideal-gen-contains 'T 'K 'ks 'S z)
            (in-sep! (lambda () (ass))
                     (lambda ()
                       (di)
                       (dk-have! d1 (lambda () (subst `(= x ,z)) (ass)))
                       (absurd! d1))))))
      (dk-cite! 'key-ideal-gen-least 'T 'K 'ks 'S j 'x)
      (sep-me `(IN x ,j))
      (dk-have! '(= x x) (lambda () (rfl)))
      (sbi-keep-prop! '(NOT (= x x)) '(= x x)))))
(qed 'key-ideal-gen-cases)

;;; -----------------------------------------------------------------------
;;; 5. PROPOSITIONS 6.6, 6.7, 6.8.

;; The three cases of key-ideal-gen-cases at x, opened: (CASE-S d), (CASE-LIST d), (CASE-ENCR d)
;; each run on its own leaf with the disjunct d in context.
(define (sbi-cases! x case-s case-list case-encr)
  (let* ((o (dk-cite! 'key-ideal-gen-cases 'T 'K 'ks 'S x))
         (d1 (cadr o)) (d2 (cadr (caddr o))))
    (sbi-or-each! o
      (lambda (d)
        (cond ((equal? d d1) (case-s d))
              ((equal? d d2) (case-list d))
              (#t (case-encr d)))))))

;;; PROPOSITION 6.6: decryption stays in the ideal.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL h (FORALL y
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (IN y K)
      (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
       (IMPLIES (FORALL u (IMPLIES (IN u S) (IS-SIMPLE-MSG T K u)))
        (IMPLIES (FORALL u (IMPLIES (IN u S) (FORALL g (NOT (= u (ENCR g y))))))
         (IMPLIES (IN (ENCR h y) (KEY-IDEAL-GEN T K ks S))
                  (IN h (KEY-IDEAL-GEN T K ks S))))))))))))))))))
(let* ((landed (dk-peel!))
       (noenc (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENCR))) landed))
       (e '(ENCR h y)))
  (sbi-cases! e
    (lambda (d)
      (dk-apply! (dk-apply! noenc e) 'h)
      (dk-have! `(= ,e ,e) (lambda () (rfl)))
      (sbi-keep-prop! `(NOT (= ,e ,e)) `(= ,e ,e)))
    (lambda (d)
      (let ((l (dk-skolem! d)))
        (fact 'encr-ne-list 'h 'y l)
        (sbi-keep-prop! `(= ,e (LST ,l)) `(NOT (= ,e (LST ,l))))))
    (lambda (d)
      (let* ((h1 (dk-skolem! d))
             (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
             (y1 (dk-skolem! ex)))
        (fact 'encr-injective 'h 'y h1 y1)
        (dk-split-all!)
        (subst `(= h ,h1))
        (ass)))))
(qed 'key-ideal-gen-decrypt)

;;; PROPOSITION 6.7: only keys of KS encrypt into the ideal.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL h (FORALL y
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (IN y K)
      (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
       (IMPLIES (FORALL u (IMPLIES (IN u S) (IS-SIMPLE-MSG T K u)))
        (IMPLIES (FORALL u (IMPLIES (IN u S) (FORALL g (NOT (= u (ENCR g y))))))
         (IMPLIES (IN (ENCR h y) (KEY-IDEAL-GEN T K ks S))
                  (IN y ks)))))))))))))))))
(let* ((landed (dk-peel!))
       (noenc (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENCR))) landed))
       (e '(ENCR h y)))
  (sbi-cases! e
    (lambda (d)
      (dk-apply! (dk-apply! noenc e) 'h)
      (dk-have! `(= ,e ,e) (lambda () (rfl)))
      (sbi-keep-prop! `(NOT (= ,e ,e)) `(= ,e ,e)))
    (lambda (d)
      (let ((l (dk-skolem! d)))
        (fact 'encr-ne-list 'h 'y l)
        (sbi-keep-prop! `(= ,e (LST ,l)) `(NOT (= ,e (LST ,l))))))
    (lambda (d)
      (let* ((h1 (dk-skolem! d))
             (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
             (y1 (dk-skolem! ex)))
        (fact 'encr-injective 'h 'y h1 y1)
        (dk-split-all!)
        (subst `(= y ,y1))
        (ass)))))
(qed 'key-ideal-gen-encr-key)

;;; PROPOSITION 6.8: a list message in the ideal of simple terms has a component in it.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL l
   (IMPLIES (IN T SET) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (IMPLIES (FORALL u (IMPLIES (IN u S) (IS-SIMPLE-MSG T K u)))
       (IMPLIES (IN l (TUPLES (MSG-SET T K)))
        (IMPLIES (IN (LST l) (KEY-IDEAL-GEN T K ks S))
         (FORSOME j (AND (IN j NN) (AND (<= 1 j) (AND (<= j (LENGTH l))
                                                    (IN (NTH j l) (KEY-IDEAL-GEN T K ks S))))))))))))))))))))
(let* ((landed (dk-peel!))
       (simple (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-SIMPLE-MSG))) landed))
       (e '(LST l)))
  (sbi-cases! e
    (lambda (d)
      (let* ((sm (dk-apply! simple e))
             (ex `(FORSOME sbsl_ (AND (IN sbsl_ (TUPLES (MSG-SET T K))) (= ,e (LST sbsl_))))))
        (mac-h 'is-simple-msg sm)
        (dk-have! ex (lambda () (sbi-ex-fill! (list 'l))))
        (sbi-keep-prop! `(NOT ,ex) ex)))
    (lambda (d)
      (let ((l1 (dk-skolem! d)))
        (fact 'lst-injective 'l l1)
        (subst `(= l ,l1))
        (ass)))
    (lambda (d)
      (let* ((h1 (dk-skolem! d))
             (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
             (y1 (dk-skolem! ex)))
        (fact 'lst-ne-encr 'l h1 y1)
        (sbi-keep-prop! `(= ,e (ENCR ,h1 ,y1)) `(NOT (= ,e (ENCR ,h1 ,y1))))))))
(qed 'key-ideal-gen-list-component)

;;; -----------------------------------------------------------------------
;;; 6. PROPOSITION 6.9: a minimal node of the bundle among those whose content is in I is an
;;; entry point for I.  The paper's two steps are the proven halves bundle-minimal-sent (the
;;; set is closed under equal content, so its minimal member is SENT -- Definition 2.4 clause
;;; 2) and bundle-ssb-precedes with bundle-ssb-closed (an earlier node on the same strand is in
;;; the bundle and precedes -- clause 3); the model is bundle-minimal-originates (Lemma 2.9),
;;; the instance I = {m : u subterm of m}.
(sp (make-wff '(FORALL c (FORALL ii (FORALL n (IMPLIES (IS-BUNDLE c) (IMPLIES (IN n (BNODES c))
  (IMPLIES (IN (NODE-CONTENT (BSPACE c) n) ii)
  (IMPLIES (FORALL z (IMPLIES (IN z (BNODES c)) (IMPLIES (IN (NODE-CONTENT (BSPACE c) z) ii)
                                                        (NOT (IN (LIST z n) (PRECEDES-STRICT c))))))
    (IS-ENTRY-POINT (BSPACE c) n ii))))))))))
(let* ((landed (dk-peel!))
       (mn (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'PRECEDES-STRICT))) landed))
       (spa '(BSPACE c))
       (ss `(SEP sbew_ (BNODES c) (IN (NODE-CONTENT ,spa sbew_) ii))))
  (fact 'bundle-space 'c)
  (dk-apply! (dk-cite! 'bundle-nodes-in-space 'c) 'n)
  (dk-have! `(FORALL z (IMPLIES (IN z ,ss) (IN z (BNODES c))))
    (lambda () (dk-peel!) (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ss))) (dk-asms))) (ass)))
  (dk-have! `(FORALL x (FORALL y (IMPLIES (IN x (BNODES c)) (IMPLIES (IN y (BNODES c))
               (IMPLIES (= (NODE-CONTENT ,spa x) (NODE-CONTENT ,spa y)) (IMPLIES (IN y ,ss) (IN x ,ss)))))))
    (lambda ()
      (dk-peel!)
      (let* ((eqn (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'NODE-CONTENT))) (dk-asms)))
             (y (caddr (caddr eqn))))
        (sep-me `(IN ,y ,ss))
        (in-sep! (lambda () (ass))
                 (lambda () (subst eqn) (ass))))))
  (dk-have! `(IN n ,ss) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,ss) (NOT (IN (LIST z n) (PRECEDES-STRICT c)))))
    (lambda ()
      (dk-peel!)
      (let ((z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ss))) (dk-asms)))))
        (sep-me `(IN ,z ,ss))
        (dk-apply! mn z)
        (ass))))
  (fact 'bundle-minimal-sent 'c ss 'n)
  (mac 'is-entry-point)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (dk-peel!)
            (let ((m (caddr (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-asms)))))
              (di)
              (dk-apply! (dk-cite! 'bundle-ssb-closed 'c 'n) m)
              (fact 'bundle-ssb-precedes 'c m 'n)
              (ai (dk-apply! mn m))))))))
(qed 'bundle-minimal-entry-point)
