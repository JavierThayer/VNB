;;; Library: complex-analysis.

;;; ch4a-termwise.scm -- TERMWISE INTEGRATION of a series of continuous functions along a road (CH4-A,
;;; 2026-10-28).  For a family hf of continuous functions on u (hf(j) in fun(u, cc)) and a road whose
;;; trace lies in u:
;;;   (1) termwise-partial-integrals: the k-th partial sum w |-> sum_{j<k} hf(j)(w) is continuous on u and
;;;       its integral is the k-th partial sum of the integrals;
;;;   (2) line-int-termwise: if the partial sums converge to g UNIFORMLY on the trace, g continuous on u,
;;;       then sum_j int hf(j) converges to int g.
;;; The general form of the step inside cauchy-kernel-integral-series (Lemma 3.33), reused by the second
;;; half of Lemma 4.4 and by Proposition 4.2.  Library: complex-analysis (analysis vocabulary only).
;;; Load window: after analytic-from-integral (line-int-of-uniform-limit, aif-cont-sum, aif-cont-const).
;;; Prefix tw-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define tw-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (tw-sub u) (list 'SUBSPACE-MS tw-nfm u))
(define (tw-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u) (list 'IS-CONTINUOUS-AT (tw-sub u) tw-nfm f 'rgy_))))
(define (tw-imps hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (tw-imps (cdr hs) concl))))
(define (tw-alls vs body) (if (null? vs) body (list 'FORALL (car vs) (tw-alls (cdr vs) body))))
(define (tw-ptw u h rhs-of)
  (list 'FORALL 'twx_ (list 'IMPLIES (list 'IN 'twx_ u) (list '== (list h 'twx_) (rhs-of 'twx_)))))
(define (tw-close!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))

(define (tw-inner w) (list 'VNB-LAMBDA 'twj_ 'NN (list (list 'hf 'twj_) w)))
(define (tw-TS k) (list 'VNB-LAMBDA 'tww_ 'u (list 'CC-SERIES-PARTIAL-SUM (tw-inner 'tww_) k)))
(define tw-LIF (list 'VNB-LAMBDA 'twj_ 'NN '(LINE-INT (hf twj_) pgam dgam a b)))
(define (tw-LI f) (list 'LINE-INT f 'pgam 'dgam 'a 'b))
(define tw-hf-typ '(FORALL twj_ (IMPLIES (IN twj_ NN) (IN (hf twj_) (FUN u CC)))))
(define tw-hf-cont (list 'FORALL 'twj_ (list 'IMPLIES '(IN twj_ NN) (tw-cont 'u '(hf twj_)))))
(define tw-road-h '((SUBSET u CC) (IS-ROAD pgam dgam a b) (SUBSET (TRACE pgam a b) u)))

;; the metric facts the continuity lemmas need
(define (tw-ms!)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS tw-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS tw-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-have! (list 'SUBSET 'u (list 'PTS tw-nfm)) (lambda () (subst (list '== (list 'PTS tw-nfm) 'CC)) (ass)))
  (dk-have! '(IN u SET) (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC) (ass)))
  (fact 'subspace-is-metric-space tw-nfm 'u)
  (fact 'subspace-pts tw-nfm 'u)
  (fact 'nn-is-set)
  (fact 'cc-zero-in))
;; hf(j) typed and continuous, its integral complex, for j in NN in context
(define (tw-hf! j)
  (dk-apply! (dk-ctx-form tw-hf-typ) j)
  (dk-apply! (dk-ctx-form tw-hf-cont) j)
  (fact 'line-int-in-cc 'u (list 'hf j) 'pgam 'dgam 'a 'b))
;; x in u: x in CC; the inner family at x typed in fun(nn, cc)
(define (tw-inner-typ! x)
  (fact 'subset-mem-fwd 'u 'CC x)
  (if (not (dk-asm? (list 'IN (tw-inner x) '(FUN NN CC))))
      (dk-have! (list 'IN (tw-inner x) '(FUN NN CC))
        (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                              (dk-apply! (dk-ctx-form tw-hf-typ) j)
                                              (fact 'fun-apply-type-c (list 'hf j) 'u 'CC x)
                                              (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                              (tw-close!))))))))
;; the k-th partial sum is a function on u
(define (tw-TS-typ! k)
  (dk-have! (list 'IN (tw-TS k) '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                          (tw-inner-typ! x)
                                          (fact 'cc-series-partial-sum-in-cc k (tw-inner x))
                                          (tw-close!)))))))

;;; (1) the partial sums, by induction on k
(sp (make-wff
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
    (tw-alls '(u pgam dgam a b hf)
      (tw-imps (append tw-road-h (list tw-hf-typ tw-hf-cont))
        (list 'AND (list 'IN (tw-TS 'k) '(FUN u CC))
          (list 'AND (tw-cont 'u (tw-TS 'k))
                     (list '= (tw-LI (tw-TS 'k)) (list 'CC-SERIES-PARTIAL-SUM tw-LIF 'k))))))))))
(define tw-br (use-induction))
(dk-focus! (cdr (assq 'base tw-br)))
(dk-peel!)
(tw-ms!)
(tw-TS-typ! 0)
(dk-have! (tw-ptw 'u (tw-TS 0) (lambda (x) 0))
  (lambda () (let ((v (dk-di-var!)))
               (dk-lam-b!)
               (subst (dk-fact! 'cc-series-partial-sum-zero (tw-inner v)))
               (qrfl))))
(fact 'aif-cont-const 'u 0 (tw-TS 0))
(fact 'line-int-in-cc 'u (tw-TS 0) 'pgam 'dgam 'a 'b)
(dk-have! (tw-ptw 'u (tw-TS 0) (lambda (x) (list '* 0 (list (tw-TS 0) x))))
  (lambda () (let ((v (dk-di-var!)))
               (dk-lam-b!)
               (subst (dk-fact! 'cc-series-partial-sum-zero (tw-inner v)))
               (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
               (subst '(= (* 0 0) 0))
               (qrfl))))
(dk-apply! (dk-cite! 'line-int-scalar 'u (tw-TS 0) 'pgam 'dgam 'a 'b) 0 (tw-TS 0))
(define tw-v0 (dk-name! (tw-LI (tw-TS 0)) 'CC))
(dk-have! (list '= tw-v0 (list '* 0 tw-v0)) (lambda () (subst (list '= tw-v0 (tw-LI (tw-TS 0)))) (tw-close!)))
(dk-have! (list '= (list '* 0 tw-v0) 0) (lambda () (crs)))
(dk-have! (list '= tw-v0 0) (lambda () (subst (list '= tw-v0 (list '* 0 tw-v0))) (tw-close!)))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) '=)
        (begin
          (subst (dk-fact! 'cc-series-partial-sum-zero tw-LIF))
          (subst (list '= (tw-LI (tw-TS 0)) tw-v0))
          (tw-close!))
        (tw-close!))))
(dk-focus! (cdr (assq 'step tw-br)))
(define tw-n (cdr (assq 'var tw-br)))
(define tw-ih (cdr (assq 'ih tw-br)))
(dk-peel!)
(tw-ms!)
(let* ((k tw-n) (k1 (list 'succ k)) (TSk (tw-TS k)) (TSk1 (tw-TS k1)) (Hk (list 'hf k)))
  (fact 'nn-succ-closed k)
  (dk-split-all! (list (dk-apply! tw-ih 'u 'pgam 'dgam 'a 'b 'hf)))
  (tw-hf! k)
  (tw-TS-typ! k1)
  (dk-have! (tw-ptw 'u TSk1 (lambda (x) (list '+ (list TSk x) (list Hk x))))
    (lambda ()
      (let ((v (dk-di-var!)))
        (tw-inner-typ! v)
        (fact 'cc-series-partial-sum-in-cc k (tw-inner v))
        (fact 'fun-apply-type-c Hk 'u 'CC v)
        (dk-have! (list 'IN (list (tw-inner v) k) 'CC) (lambda () (if (not (dk-lam-b!)) (ass))))
        (dk-lam-b!)
        (subst (dk-fact! 'cc-series-partial-sum-succ (tw-inner v) k))
        (if (not (dk-lam-b!)) (qrfl)))))
  (fact 'aif-cont-sum 'u TSk Hk TSk1)
  (let ((e1 (dk-apply! (dk-cite! 'line-int-sum 'u TSk Hk 'pgam 'dgam 'a 'b) TSk1)))
    (dk-have! (list 'IN (list tw-LIF k) 'CC) (lambda () (if (not (dk-lam-b!)) (ass))))
    (dk-have! (list 'IN tw-LIF '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (tw-hf! j) (tw-close!))))))
    (fact 'cc-series-partial-sum-in-cc k tw-LIF)
    (let ((e3 (dk-fact! 'cc-series-partial-sum-succ tw-LIF k)))
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) '=)
              (begin
                (subst e1) (subst e3) (dk-lam-b!)
                (subst (list '= (tw-LI TSk) (list 'CC-SERIES-PARTIAL-SUM tw-LIF k)))
                (if (pair? (dk-open-leaves)) (rfl)))
              (tw-close!)))))))
(qed 'termwise-partial-integrals)

;;; (2) termwise integration under uniform convergence on the trace
(define (tw-PS y k) (list 'CC-SERIES-PARTIAL-SUM (tw-inner y) k))
(define tw-unif
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'twcap_ (list 'AND '(IN twcap_ NN)
      (list 'FORALL 'twk_ (list 'IMPLIES '(IN twk_ NN) (list 'IMPLIES '(<= twcap_ twk_)
        (list 'FORALL 'twy_ (list 'IMPLIES '(IN twy_ (TRACE pgam a b))
          (list '<= (list 'magnitude (list '- (tw-PS 'twy_ 'twk_) '(g twy_))) 'eps)))))))))))
(define tw-FAM (list 'VNB-LAMBDA 'twk_ 'NN (tw-TS 'twk_)))
(sp (make-wff
  (tw-alls '(u pgam dgam a b hf g)
    (tw-imps (append tw-road-h (list tw-hf-typ tw-hf-cont '(IN g (FUN u CC)) (tw-cont 'u 'g) tw-unif))
      (list 'CC-SERIES-CONVERGES-TO tw-LIF (tw-LI 'g))))))
(dk-peel!)
(tw-ms!)
(define (tw-pi! k)
  (dk-split-all! (list (dk-fact! 'termwise-partial-integrals k 'u 'pgam 'dgam 'a 'b 'hf))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list tw-FAM 'k) '(FUN u CC))))
  (lambda () (let ((k (dk-di-var!))) (tw-pi! k) (if (not (dk-lam-b!)) (ass)))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (tw-cont 'u (list tw-FAM 'k))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (tw-pi! k)
      (dk-lam-b!)
      (let ((y (list-ref (dk-goal) 4)))
        (dk-apply! (dk-ctx-form (tw-cont 'u (tw-TS k))) y)
        (tw-close!)))))
(dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
            (list 'FORSOME 'aicap_ (list 'AND '(IN aicap_ NN)
              (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= aicap_ k)
                (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ (TRACE pgam a b))
                  (list '<= (list 'magnitude (list '- (list (list tw-FAM 'k) 'aiy_) '(g aiy_))) 'eps))))))))))
  (lambda ()
    (dk-peel!)
    (let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
           (ex (dk-apply! (dk-ctx-form tw-unif) eps))
           (cap (dk-skolem! ex)))
      (dk-split-all!)
      (ew cap)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN) (ass)
              (begin
                (dk-peel!)
                (let* ((k (caddr (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) cap))) "k")))
                       (y (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(TRACE pgam a b)))) "y"))))
                  (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
                  (dk-lam-b!)
                  (let ((inst (dk-apply! (dk-ctx-form (list 'FORALL 'twk_ (list 'IMPLIES '(IN twk_ NN) (list 'IMPLIES (list '<= cap 'twk_)
                                 (list 'FORALL 'twy_ (list 'IMPLIES '(IN twy_ (TRACE pgam a b))
                                   (list '<= (list 'magnitude (list '- (tw-PS 'twy_ 'twk_) '(g twy_))) eps)))))))
                                 k)))
                    (dk-apply! inst y)
                    (tw-close!))))))))))
(define tw-lim (dk-fact! 'line-int-of-uniform-limit 'u 'pgam 'dgam 'a 'b 'g tw-FAM))
(mac 'cc-series-converges-to)
(define tw-f (caddr tw-lim))
(define tw-h (caddr (dk-goal)))
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(fact 'line-int-in-cc 'u 'g 'pgam 'dgam 'a 'b)
(dk-have! (list 'IN tw-LIF '(FUN NN CC))
  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (tw-hf! j) (tw-close!))))))
(dk-have! (list 'IN tw-f '(FUN NN (PTS CC-MS)))
  (lambda ()
    (subst '(== (PTS CC-MS) CC))
    (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                               (tw-pi! j)
                               (dk-lam-b!)
                               (fact 'line-int-in-cc 'u (tw-TS j) 'pgam 'dgam 'a 'b)
                               (tw-close!))))))
(dk-have! (list 'IN tw-h '(FUN NN (PTS CC-MS)))
  (lambda ()
    (subst '(== (PTS CC-MS) CC))
    (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                               (fact 'cc-series-partial-sum-in-cc j tw-LIF)
                               (tw-close!))))))
(dk-have! (list 'IN (tw-LI 'g) '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (tw-close!)))
(dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list tw-h 'j_) (list tw-f 'j_))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (tw-pi! j)
      (fact 'cc-series-partial-sum-in-cc j tw-LIF)
      (dk-lam-b!)
      (subst (list '= (tw-LI (tw-TS j)) (list 'CC-SERIES-PARTIAL-SUM tw-LIF j)))
      (if (pair? (dk-open-leaves)) (rfl)))))
(fact 'converges-to-transfer 'CC-MS tw-f tw-h (tw-LI 'g))
(tw-close!)
(qed 'line-int-termwise)

;;; (3) a convergent complex series has its sum as CC-SERIES-LIMIT
(define tw-psl '(VNB-LAMBDA k NN (CC-SERIES-PARTIAL-SUM lxs_ k)))
(sp (make-wff '(FORALL lxs_ (IMPLIES (IN lxs_ (FUN NN CC)) (FORALL lxx_ (IMPLIES (CC-SERIES-CONVERGES-TO lxs_ lxx_)
  (AND (CC-SERIES-CONVERGES lxs_) (= (CC-SERIES-LIMIT lxs_) lxx_))))))))
(dk-peel!)
(dk-project! (list 'CONVERGES-TO 'CC-MS tw-psl 'lxx_) 'cc-series-converges-to '(CC-SERIES-CONVERGES-TO lxs_ lxx_))
(dk-have! '(CC-SERIES-CONVERGES lxs_)
  (lambda () (mac 'cc-series-converges) (mac 'converges) (ew 'lxx_) (ass)))
(fact 'cc-series-limit-converges-to 'lxs_)
(dk-project! (list 'CONVERGES-TO 'CC-MS tw-psl '(CC-SERIES-LIMIT lxs_)) 'cc-series-converges-to '(CC-SERIES-CONVERGES-TO lxs_ (CC-SERIES-LIMIT lxs_)))
(dk-cite! 'metric-limit-unique 'CC-MS tw-psl '(CC-SERIES-LIMIT lxs_) 'lxx_)
(dk-conj-close! (lambda () (ass)))
(qed 'cc-series-limit-of-converges-to)
