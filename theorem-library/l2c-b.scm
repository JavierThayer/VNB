(define l2b-jj
  (list 'VNB-LAMBDA 'jf_ (list 'FUN l2b-xy 'RR-POS-STAR) (l2b-ix (l2b-xsi 'jf_))))

;;; the inner integral of a measurable f: measurable on X (fubini, first conjunct), typed
(define (l2b-xsi-meas! f)
  (let ((m (list 'IS-MEASURABLE-FN 'xs 'cA (l2b-xsi f))))
    (if (not (dk-asm? m))
        (let ((fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu f)))
          (dk-project! m (lambda () (dk-split-all! (list fb))))))
    (fact 'x-section-integral-type 'xs 'cA 'ys 'cB 'nu f)
    (fact 'integral-in 'xs 'cA 'mu (l2b-xsi f))
    m))
;;; peel the antecedent, type each function-valued eigenvariable, beta the jj applications
(define (l2b-o-peel!)
  (let ((ld (dk-peel!)))
    (for-each (lambda (h) (if (dk-head-is? h 'IS-MEASURABLE-FN) (l2b-mfun! l2b-xy l2b-ps (cadddr h)))) ld)
    ld))

(define (l2b-prove-o1!)
  (let* ((ld (l2b-o-peel!))
         (f (cadr (cadr (dk-goal)))))
    (l2b-lb!)
    (l2b-xsi-meas! f)
    (if (l2b-open?) (ass))))

(define (l2b-prove-o2!)
  (let* ((ld (dk-peel!))
         (cs (caddr (cadr (cadr (dk-goal)))))
         (ind (list 'INDICATOR l2b-xy cs))
         (xsm (list 'X-SECTION-MEASURE 'xs 'ys 'nu cs)))
    (fact 'measurable-fn-indicator l2b-xy l2b-ps cs)
    (l2b-mfun! l2b-xy l2b-ps ind)
    (l2b-lb!)
    (l2b-xsi-meas! ind)
    (fact 'x-section-measure-type 'xs 'cA 'mu 'ys 'cB 'nu cs)
    (let ((fbs (dk-cite! 'fubini-sets 'xs 'cA 'mu 'ys 'cB 'nu cs)))
      (car (l2b-parts! 'is-fubini-set (list 'xs 'cA 'mu 'ys 'cB 'nu cs))))
    (fact 'integral-in 'xs 'cA 'mu xsm)
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ xs) (list '= (list (l2b-xsi ind) 'icx_) (list xsm 'icx_))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (subst (dk-cite! 'xsi-indicator 'xs 'cA 'mu 'ys 'cB 'nu cs x))
          (subst (dk-cite! 'x-section-measure-apply 'xs 'ys 'nu cs x))
          (fact 'x-section-measurable 'xs 'cA 'ys 'cB cs x)
          (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR (list 'X-SECTION 'ys cs x))
          (if (l2b-open?) (rfl)))))
    (fact 'integral-congruence-ptwise 'xs 'cA 'mu (l2b-xsi ind) xsm)
    (subst (list '= (l2b-ix (l2b-xsi ind)) (l2b-ix xsm)))
    (subst (dk-cite! 'product-measure-apply 'xs 'cA 'mu 'ys 'cB 'nu cs))
    (if (l2b-open?) (rfl))))

(define (l2b-prove-o3!)
  (let* ((ld (l2b-o-peel!))
         (h (cadr (cadr (dk-goal))))
         (f (caddr h)) (g (cadddr h))
         (pe (list 'PTWISE-EPLUS 'xs (l2b-xsi f) (l2b-xsi g))))
    (fact 'measurable-fn-eplus l2b-xy l2b-ps f g)
    (l2b-mfun! l2b-xy l2b-ps h)
    (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
    (l2b-xsi-meas! f) (l2b-xsi-meas! g) (l2b-xsi-meas! h)
    (fact 'measurable-fn-eplus 'xs 'cA (l2b-xsi f) (l2b-xsi g))
    (l2b-mfun! 'xs 'cA pe)
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ xs) (list '= (list (l2b-xsi h) 'icx_) (list pe 'icx_))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (fact 'fun-apply-type-c (l2b-xsi f) 'xs 'RR-POS-STAR x)
          (fact 'fun-apply-type-c (l2b-xsi g) 'xs 'RR-POS-STAR x)
          (subst (dk-cite! 'xsi-eplus 'xs 'cA 'mu 'ys 'cB 'nu f g x))
          (subst (dk-cite! 'ptwise-eplus-value 'xs (l2b-xsi f) (l2b-xsi g) x))
          (l2b-and! (list 'IN (list (l2b-xsi f) x) 'RR-POS-STAR) (list 'IN (list (l2b-xsi g) x) 'RR-POS-STAR))
          (fact 'eplus-closed (list (l2b-xsi f) x) (list (l2b-xsi g) x))
          (if (l2b-open?) (rfl)))))
    (fact 'integral-congruence-ptwise 'xs 'cA 'mu (l2b-xsi h) pe)
    (fact 'integral-additive 'xs 'cA 'mu (l2b-xsi f) (l2b-xsi g))
    (subst (list '= (l2b-ix (l2b-xsi h)) (l2b-ix pe)))
    (subst (list '= (l2b-ix pe) (list 'eplus (l2b-ix (l2b-xsi f)) (l2b-ix (l2b-xsi g)))))
    (l2b-and! (list 'IN (l2b-ix (l2b-xsi f)) 'RR-POS-STAR) (list 'IN (l2b-ix (l2b-xsi g)) 'RR-POS-STAR))
    (fact 'eplus-closed (l2b-ix (l2b-xsi f)) (l2b-ix (l2b-xsi g)))
    (if (l2b-open?) (rfl))))

(define (l2b-prove-o4!)
  (let* ((ld (l2b-o-peel!))
         (h (cadr (cadr (dk-goal))))
         (c (caddr h)) (f (cadddr h))
         (pe (list 'PTWISE-SCALE 'xs c (l2b-xsi f))))
    (dk-cite! 'rmc-rps-of-nonneg c)
    (fact 'ptwise-scale-measurable l2b-xy l2b-ps f c)
    (l2b-mfun! l2b-xy l2b-ps h)
    (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
    (l2b-xsi-meas! f) (l2b-xsi-meas! h)
    (fact 'ptwise-scale-measurable 'xs 'cA (l2b-xsi f) c)
    (l2b-mfun! 'xs 'cA pe)
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ xs) (list '= (list (l2b-xsi h) 'icx_) (list pe 'icx_))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (fact 'fun-apply-type-c (l2b-xsi f) 'xs 'RR-POS-STAR x)
          (subst (dk-cite! 'xsi-scale 'xs 'cA 'mu 'ys 'cB 'nu f c x))
          (subst (dk-cite! 'ptwise-scale-value 'xs c (l2b-xsi f) x))
          (l2b-and! (list 'IN c 'RR-POS-STAR) (list 'IN (list (l2b-xsi f) x) 'RR-POS-STAR))
          (fact 'etimes-closed c (list (l2b-xsi f) x))
          (if (l2b-open?) (rfl)))))
    (fact 'integral-congruence-ptwise 'xs 'cA 'mu (l2b-xsi h) pe)
    (fact 'integral-homogeneous 'xs 'cA 'mu (l2b-xsi f) c)
    (subst (list '= (l2b-ix (l2b-xsi h)) (l2b-ix pe)))
    (subst (list '= (l2b-ix pe) (list 'etimes c (l2b-ix (l2b-xsi f)))))
    (l2b-and! (list 'IN c 'RR-POS-STAR) (list 'IN (l2b-ix (l2b-xsi f)) 'RR-POS-STAR))
    (fact 'etimes-closed c (l2b-ix (l2b-xsi f)))
    (if (l2b-open?) (rfl))))

(define (l2b-o-prover ante)
  (cond ((dk-contains? ante 'INDICATOR) l2b-prove-o2!)
        ((dk-contains? ante 'PTWISE-EPLUS) l2b-prove-o3!)
        ((dk-contains? ante 'PTWISE-SCALE) l2b-prove-o4!)
        ((dk-contains? ante 'RR-POS-STAR) l2b-prove-o1!)
        (#t (error "l2b-o-prover: unexpected antecedent" (expression->string ante)))))

;;; int_{X x Y} s d(mu x nu) = int_X int_Y s, s simple
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu s)
   (append l2b-meas2 l2b-sf2 (list (list 'IS-SIMPLE-FN l2b-xy l2b-ps 's)))
   (list '= (l2b-ir 's) (l2b-ix (l2b-xsi 's))))))
(dk-peel!)
(l2b-base!)
(fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu)
(dk-cite! 'simple-fn-is-measurable l2b-xy l2b-ps 's)
(l2b-mfun! l2b-xy l2b-ps 's)
(l2b-xsi-meas! 's)
(let* ((ch (dk-cite! 'integral-unique-simple l2b-xy l2b-ps l2b-rho l2b-jj 's))
       (eq (dk-chain! ch l2b-o-prover)))
  (dk-lam-b-h! eq)
  (subst (list '= (l2b-ir 's) (l2b-ix (l2b-xsi 's))))
  (if (l2b-open?) (rfl)))
(l2b-qed! 'product-integral-simple)

;;; ==========================================================================================
;;; (3) TONELLI FOR THE PRODUCT MEASURE
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f)
   (append l2b-meas2 l2b-sf2 (list (list 'IS-MEASURABLE-FN l2b-xy l2b-ps 'f)))
   (list '= (l2b-ir 'f) (l2b-ix (l2b-xsi 'f))))))
(dk-peel!)
(l2b-base!)
(fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu)
(l2b-mfun! l2b-xy l2b-ps 'f)
(l2b-xsi-meas! 'f)
(let* ((cf (dk-skolem! (dk-cite! 'integral-simple-approx l2b-xy l2b-ps 'f)))
       (cfn (lambda (k) (list cf k)))
       (simp (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-SIMPLE-FN l2b-xy l2b-ps (cfn 'n_)))))
       (sup (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ l2b-xy) (list '= (list (list 'PTWISE-SUP l2b-xy cf) 'x_) '(f x_)))))
       (psup (list 'PTWISE-SUP l2b-xy cf))
       (simp-at! (lambda (k)
                   (fact 'fun-apply-type-c cf 'NN (list 'FUN l2b-xy 'RR-POS-STAR) k)
                   (l2b-apply1! (or (dk-ctx-form simp) (error "l2b: the simple conjunct did not land")) k)
                   (dk-cite! 'simple-fn-is-measurable l2b-xy l2b-ps (cfn k))
                   (l2b-mfun! l2b-xy l2b-ps (cfn k))))
       (l1 (list 'VNB-LAMBDA 'n_ 'NN (l2b-ir (cfn 'n_))))
       (l2 (list 'VNB-LAMBDA 'pmn_ 'NN (l2b-ix (l2b-xsi (cfn 'pmn_))))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN l2b-xy l2b-ps (cfn 'pmn_))))
    (lambda () (let ((k (dk-di-var!))) (l2b-then-ass! (lambda () (simp-at! k))))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'xs 'cA (l2b-xsi (cfn 'pmn_)))))
    (lambda () (let ((k (dk-di-var!))) (l2b-then-ass! (lambda () (simp-at! k) (l2b-xsi-meas! (cfn k)))))))
  (let* ((xl (dk-split! (dk-cite! 'x-section-integral-limit 'xs 'cA 'mu 'ys 'cB 'nu 'f cf)))
         (mct (dk-split! (dk-cite! 'monotone-convergence l2b-xy l2b-ps l2b-rho cf)))
         (mct-eq (find-first (lambda (q) (dk-head-is? q '=)) mct))
         (xl-eq (find-first (lambda (q) (dk-head-is? q '=)) xl))
         (m1 (cadr (cadr (caddr mct-eq)))))
    (l2b-mfun! l2b-xy l2b-ps psup)
    (dk-fun-ext! m1 l2 'NN 'RR-POS-STAR
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (simp-at! k) (l2b-then-ass! (lambda () (fact 'integral-in l2b-xy l2b-ps l2b-rho (cfn k))))))
                               (lambda () (l2b-then-ass! (lambda () (fact 'nn-is-set))))))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (l2b-then-ass! (lambda () (simp-at! k) (l2b-xsi-meas! (cfn k))))))
                               (lambda () (l2b-then-ass! (lambda () (fact 'nn-is-set))))))
      (lambda (k)
        (simp-at! k)
        (l2b-xsi-meas! (cfn k))
        (fact 'integral-in l2b-xy l2b-ps l2b-rho (cfn k))
        (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
        (l2b-then-ass! (lambda () (dk-cite! 'product-integral-simple 'xs 'cA 'mu 'ys 'cB 'nu (cfn k))))))
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ l2b-xy) (list '= '(f icx_) (list psup 'icx_))))
      (lambda ()
        (let ((w (dk-di-var!)))
          (l2b-apply1! (or (dk-ctx-form sup) (error "l2b: the sup conjunct did not land")) w)
          (fact 'fun-apply-type-c 'f l2b-xy 'RR-POS-STAR w)
          (subst (list '= (list psup w) (list 'f w)))
          (if (l2b-open?) (rfl)))))
    (fact 'integral-congruence-ptwise l2b-xy l2b-ps l2b-rho 'f psup)
    (subst (list '= (l2b-ir 'f) (l2b-ir psup)))
    (subst mct-eq)
    (subst (list '= m1 l2))
    (subst xl-eq)
    (if (l2b-open?) (rfl))))
(l2b-qed! 'tonelli-product)
(alias! 'tonelli-product "the integral against the product measure is the iterated integral (nonnegative measurable f, sigma-finite measures)")

;;; the other order
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f)
   (append l2b-meas2 l2b-sf2 (list (list 'IS-MEASURABLE-FN l2b-xy l2b-ps 'f)))
   (list '= (l2b-ir 'f) (l2b-iy (l2b-ysi 'f))))))
(dk-peel!)
(let ((fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu 'f)))
  (dk-split-all! (list fb)))
(subst (dk-cite! 'tonelli-product 'xs 'cA 'mu 'ys 'cB 'nu 'f))
(if (l2b-open?) (ass))
(l2b-qed! 'tonelli-product-y)
