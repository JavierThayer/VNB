;;; l2c-b.scm -- TONELLI FOR THE PRODUCT MEASURE (TH3-L2, 2026-11-09).  Helper prefix: l2b-.
;;;
;;; theorem-library/product-measure.scm proves Fubini (Thm 3.7) as the equality of the two
;;; ITERATED integrals of a nonnegative measurable f on X x Y, and defines the product measure
;;; rho (Def 3.8), but never integrates f against rho.  Every L^2(X x Y) argument (the kernel
;;; of an integral operator, the product basis) needs that step:
;;;     int_{X x Y} f d(mu x nu) = int_X ( int_Y f(x, y) dnu(y) ) dmu(x).
;;; Route: on simple functions by the uniqueness theorem integral-unique-simple (the
;;; functional f |-> int_X X-SECTION-INTEGRAL(f) agrees with rho on indicators, is additive and
;;; positively homogeneous: three section lemmas), then monotone convergence on rho and
;;; x-section-integral-limit on the iterated side, along a simple approximation.
;;;
;;; LOAD WINDOW: after theorem-library/product-measure (fubini, fubini-simple,
;;; x-section-integral-limit, product-measure-apply, product-measure-is-measure).
;;; Library: measure.  No new vocabulary.

(define (l2b-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2c-b: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2c-b: unfinished" name))))

;;; ---- the file-local kit (copies of product-measure.scm's pms- helpers) -------------------
(define (l2b-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (l2b-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (l2b-and! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
;;; the conjuncts of a predicate's defining iff, landed (hypothesis kept)
(define (l2b-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (l2b-map (lambda (c) (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
(define (l2b-part! pred args i)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (c (list-ref cs i)))
    (if (dk-asm? c) c
        (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))))
(define (l2b-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (l2b-apply1! f t)
  (let ((c (subst-free (quantifier-var f) t (caddr (quantifier-body f)))))
    (if (dk-asm? c) (dk-ctx-form c) (dk-apply! f t))))
(define (l2b-open?) (not (proof-done? *ps*)))

(define l2b-xy '(CARTESIAN xs ys))
(define l2b-ps '(PRODUCT-SIGMA xs cA ys cB))
(define l2b-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define l2b-meas2 '((IS-MEASURE xs cA mu) (IS-MEASURE ys cB nu)))
(define l2b-sf2 '((IS-SIGMA-FINITE xs cA mu) (IS-SIGMA-FINITE ys cB nu)))
(define (l2b-xsi f) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu f))
(define (l2b-ysi f) (list 'Y-SECTION-INTEGRAL 'xs 'cA 'mu 'ys f))
(define (l2b-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define (l2b-ix f) (list 'INTEGRAL 'xs 'cA 'mu f))
(define (l2b-iy f) (list 'INTEGRAL 'ys 'cB 'nu f))
(define (l2b-ir f) (list 'INTEGRAL l2b-xy l2b-ps l2b-rho f))

;;; the two measures' parts, the product sigma-algebra
(define (l2b-base!)
  (l2b-parts! 'is-measure '(xs cA mu))
  (l2b-parts! 'is-measure '(ys cB nu))
  (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB))
;;; f measurable on the product (in context): f in FUN, its section at x measurable and typed
(define (l2b-mfun! om sig f) (dk-cite! 'measurable-fn-in-fun om sig f))
(define (l2b-sec! f x)
  (fact 'fn-x-section-measurable 'xs 'cA 'ys 'cB f x)
  (l2b-mfun! 'ys 'cB (l2b-fxs f x)))

;;; ==========================================================================================
;;; (0) two projections, as citable theorems (a projection lane inside a lane drifted)
;;; ==========================================================================================
(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (IMPLIES (IS-MEASURABLE-FN omega cA f) (IN f (FUN omega RR-POS-STAR))))))))
(dk-peel!)
(l2b-parts! 'is-measurable-fn '(omega cA f))
(if (l2b-open?) (ass))
(l2b-qed! 'measurable-fn-in-fun)

(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (IMPLIES (IS-SIMPLE-FN omega cA f) (IS-MEASURABLE-FN omega cA f)))))))
