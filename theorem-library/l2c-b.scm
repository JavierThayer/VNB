(l2b-qed! 'simple-fn-is-measurable)

;;; ==========================================================================================
;;; (1) THREE SECTION LEMMAS: the inner integral of an indicator, of a sum, of a multiple
;;; ==========================================================================================

;;; x |-> int_Y 1_C(x, y) dnu(y) is x |-> nu(C_x)
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu cs x) (append l2b-meas2 (list (list 'IN 'cs l2b-ps) '(IN x xs)))
   (list '= (list (l2b-xsi (list 'INDICATOR l2b-xy 'cs)) 'x) '(nu (X-SECTION ys cs x))))))
(dk-peel!)
(l2b-base!)
(let* ((ind (list 'INDICATOR l2b-xy 'cs))
       (sec '(X-SECTION ys cs x))
       (isec (list 'INDICATOR 'ys sec))
       (fs (l2b-fxs ind 'x)))
  (fact 'measurable-fn-indicator l2b-xy l2b-ps 'cs)
  (l2b-sec! ind 'x)
  (fact 'x-section-measurable 'xs 'cA 'ys 'cB 'cs 'x)
  (fact 'measurable-fn-indicator 'ys 'cB sec)
  (l2b-mfun! 'ys 'cB isec)
  (dk-have! (list 'FORALL 'icy_ (list 'IMPLIES '(IN icy_ ys) (list '= (list fs 'icy_) (list isec 'icy_))))
    (lambda ()
      (let* ((z (dk-di-var!)) (p (list 'LIST 'x z)))
        (subst (dk-cite! 'fn-x-section-apply 'ys ind 'x z))
        (fact 'pair-in-cartesian 'xs 'ys 'x z)
        (let ((iff (dk-cite! 'x-section-membership 'ys 'cs 'x z)))
          (use-em (list 'IN p 'cs)
            (lambda ()
              (subst (dk-cite! 'indicator-value-in l2b-xy 'cs p))
              (dk-have! (list 'IN z sec) (lambda () (keep iff (list 'IN z 'ys) (list 'IN p 'cs)) (prop)))
              (subst (dk-cite! 'indicator-value-in 'ys sec z))
              (if (l2b-open?) (rfl)))
            (lambda ()
              (subst (dk-cite! 'indicator-value-out l2b-xy 'cs p))
              (dk-have! (list 'NOT (list 'IN z sec)) (lambda () (keep iff (list 'NOT (list 'IN p 'cs))) (prop)))
              (subst (dk-cite! 'indicator-value-out 'ys sec z))
              (if (l2b-open?) (rfl))))))))
  (fact 'integral-congruence-ptwise 'ys 'cB 'nu fs isec)
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu ind 'x))
  (subst (list '= (l2b-iy fs) (l2b-iy isec)))
  (subst (dk-cite! 'integral-indicator 'ys 'cB 'nu sec))
  (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR sec)
  (if (l2b-open?) (rfl)))
(l2b-qed! 'xsi-indicator)

;;; the inner integral of a sum is the sum of the inner integrals
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f g x)
   (append l2b-meas2 (list (list 'IS-MEASURABLE-FN l2b-xy l2b-ps 'f) (list 'IS-MEASURABLE-FN l2b-xy l2b-ps 'g) '(IN x xs)))
   (list '= (list (l2b-xsi (list 'PTWISE-EPLUS l2b-xy 'f 'g)) 'x)
            (list 'eplus (list (l2b-xsi 'f) 'x) (list (l2b-xsi 'g) 'x))))))
(dk-peel!)
(l2b-base!)
(let* ((h (list 'PTWISE-EPLUS l2b-xy 'f 'g))
       (fs (l2b-fxs 'f 'x)) (gs (l2b-fxs 'g 'x)) (hs (l2b-fxs h 'x))
       (pe (list 'PTWISE-EPLUS 'ys fs gs)))
  (fact 'measurable-fn-eplus l2b-xy l2b-ps 'f 'g)
  (l2b-mfun! l2b-xy l2b-ps 'f) (l2b-mfun! l2b-xy l2b-ps 'g) (l2b-mfun! l2b-xy l2b-ps h)
  (l2b-sec! 'f 'x) (l2b-sec! 'g 'x) (l2b-sec! h 'x)
  (fact 'measurable-fn-eplus 'ys 'cB fs gs)
  (l2b-mfun! 'ys 'cB pe)
  (dk-have! (list 'FORALL 'icy_ (list 'IMPLIES '(IN icy_ ys) (list '= (list hs 'icy_) (list pe 'icy_))))
    (lambda ()
      (let* ((z (dk-di-var!)) (p (list 'LIST 'x z)))
        (fact 'pair-in-cartesian 'xs 'ys 'x z)
        (fact 'fun-apply-type-c 'f l2b-xy 'RR-POS-STAR p)
        (fact 'fun-apply-type-c 'g l2b-xy 'RR-POS-STAR p)
        (fact 'fun-apply-type-c fs 'ys 'RR-POS-STAR z)
        (fact 'fun-apply-type-c gs 'ys 'RR-POS-STAR z)
        (subst (dk-cite! 'fn-x-section-apply 'ys h 'x z))
        (subst (dk-cite! 'ptwise-eplus-value l2b-xy 'f 'g p))
        (subst (dk-cite! 'ptwise-eplus-value 'ys fs gs z))
        (subst (dk-cite! 'fn-x-section-apply 'ys 'f 'x z))
        (subst (dk-cite! 'fn-x-section-apply 'ys 'g 'x z))
        (l2b-and! (list 'IN (list 'f p) 'RR-POS-STAR) (list 'IN (list 'g p) 'RR-POS-STAR))
        (fact 'eplus-closed (list 'f p) (list 'g p))
        (if (l2b-open?) (rfl)))))
  (fact 'integral-congruence-ptwise 'ys 'cB 'nu hs pe)
  (fact 'integral-additive 'ys 'cB 'nu fs gs)
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu h 'x))
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu 'f 'x))
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu 'g 'x))
  (subst (list '= (l2b-iy hs) (l2b-iy pe)))
  (subst (list '= (l2b-iy pe) (list 'eplus (l2b-iy fs) (l2b-iy gs))))
  (fact 'integral-in 'ys 'cB 'nu fs) (fact 'integral-in 'ys 'cB 'nu gs)
  (l2b-and! (list 'IN (l2b-iy fs) 'RR-POS-STAR) (list 'IN (l2b-iy gs) 'RR-POS-STAR))
  (fact 'eplus-closed (l2b-iy fs) (l2b-iy gs))
  (if (l2b-open?) (rfl)))
(l2b-qed! 'xsi-eplus)

;;; the inner integral of c f is c times the inner integral of f
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f c x)
   (append l2b-meas2 (list (list 'IS-MEASURABLE-FN l2b-xy l2b-ps 'f) '(IN c RR) '(<= 0 c) '(IN x xs)))
   (list '= (list (l2b-xsi (list 'PTWISE-SCALE l2b-xy 'c 'f)) 'x)
            (list 'etimes 'c (list (l2b-xsi 'f) 'x))))))
(dk-peel!)
(l2b-base!)
(let* ((h (list 'PTWISE-SCALE l2b-xy 'c 'f))
       (fs (l2b-fxs 'f 'x)) (hs (l2b-fxs h 'x))
       (pe (list 'PTWISE-SCALE 'ys 'c fs)))
  (dk-cite! 'rmc-rps-of-nonneg 'c)
  (fact 'ptwise-scale-measurable l2b-xy l2b-ps 'f 'c)
  (l2b-mfun! l2b-xy l2b-ps 'f) (l2b-mfun! l2b-xy l2b-ps h)
  (l2b-sec! 'f 'x) (l2b-sec! h 'x)
  (fact 'ptwise-scale-measurable 'ys 'cB fs 'c)
  (l2b-mfun! 'ys 'cB pe)
  (dk-have! (list 'FORALL 'icy_ (list 'IMPLIES '(IN icy_ ys) (list '= (list hs 'icy_) (list pe 'icy_))))
    (lambda ()
      (let* ((z (dk-di-var!)) (p (list 'LIST 'x z)))
        (fact 'pair-in-cartesian 'xs 'ys 'x z)
        (fact 'fun-apply-type-c 'f l2b-xy 'RR-POS-STAR p)
        (fact 'fun-apply-type-c fs 'ys 'RR-POS-STAR z)
        (subst (dk-cite! 'fn-x-section-apply 'ys h 'x z))
        (subst (dk-cite! 'ptwise-scale-value l2b-xy 'c 'f p))
        (subst (dk-cite! 'ptwise-scale-value 'ys 'c fs z))
        (subst (dk-cite! 'fn-x-section-apply 'ys 'f 'x z))
        (l2b-and! '(IN c RR-POS-STAR) (list 'IN (list 'f p) 'RR-POS-STAR))
        (fact 'etimes-closed 'c (list 'f p))
        (if (l2b-open?) (rfl)))))
  (fact 'integral-congruence-ptwise 'ys 'cB 'nu hs pe)
  (fact 'integral-homogeneous 'ys 'cB 'nu fs 'c)
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu h 'x))
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu 'f 'x))
  (subst (list '= (l2b-iy hs) (l2b-iy pe)))
  (subst (list '= (l2b-iy pe) (list 'etimes 'c (l2b-iy fs))))
  (fact 'integral-in 'ys 'cB 'nu fs)
  (l2b-and! '(IN c RR-POS-STAR) (list 'IN (l2b-iy fs) 'RR-POS-STAR))
  (fact 'etimes-closed 'c (l2b-iy fs))
  (if (l2b-open?) (rfl)))
(l2b-qed! 'xsi-scale)

;;; ==========================================================================================
