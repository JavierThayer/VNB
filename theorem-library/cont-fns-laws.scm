;;; theorem-library/cont-fns-laws.scm -- CONT-FNS(s) and CLOPEN-SETS(s) of a metric space s:
;;; the membership laws, closure of CONT-FNS under pointwise sums and scalar multiples, and a
;;; function constant on an open set around a is continuous at a.  Library: analysis.
;;;
;;; MOVED 2026-10-20 (the wiring of CALC-2 / CALC-3) from theorem-library/riesz-markov-cantor.scm
;;; (library measure), where RM-2 proved them: their proofs cite only core and analysis facts,
;;; and analysis files may not cite a measure file.  Statements, proofs and THEOREM NAMES are
;;; unchanged (they keep RM-2's prefix rmc-, so no citation changed); the helpers are copies of
;;; the rmc- kit under this file's prefix cfl-.
;;;
;;;   rmc-cont-fns-mem, rmc-cont-fns-parts, rmc-cont-fns-intro   h in CONT-FNS(s) iff h in
;;;                              FUN(PTS s, RR) and h continuous from s to RR-MS
;;;   rmc-clopen-mem, rmc-clopen-intro, rmc-clopen-parts        the same for CLOPEN-SETS(s)
;;;   rmc-cont-fns-scale / -add   CONT-FNS(s) is closed under scalar multiples and sums
;;;   rmc-cont-at-locally-const   constant on an open set around a => continuous at a
;;;
;;; Load window: after structure-library/positive-functional (CONT-FNS, CLOPEN-SETS); before
;;; riesz-markov-cantor.  No top-level macro.

;;; =====================================================================
;;; (0) the cfl- kit (copies of the rmc- kit of riesz-markov-cantor.scm)
;;; =====================================================================

;;; `prop' after keeping only the named formulas; use inside a dk-have! lane.
(define (cfl-prop! . keepers)
  (apply dk-only! keepers)
  (prop))

;;; (IN E RR) and (< 0 E) from (POS-RR E), by citation.
(define (cfl-pos! e)
  (dk-cite! 'rr-pos-rr-in-rr e)
  (dk-cite! 'rr-lt-of-pos-rr e))

;;; close (IFF (IN t (SEP v D P)) (AND (IN t D) P[t])) -- both directions.
(define (cfl-sep-iff!)
  (for-each
    (lambda (leaf)
      (dk-focus! leaf)
      (let ((g (dk-goal)))
        (if (and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'SEP))
            (begin (dk-split-all!)
                   (dk-close-all! (lambda () (sep-mi))))
            (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP)))
                              "the SEP membership")))
              (dk-split-all! (dk-landed (lambda () (sep-me h))))
              (dk-conj-close! (lambda () (ass)))))))
    (dk-opened (lambda () (di)))))

;;; split the focus goal's conjunctions; return the leaves.
(define (cfl-split-goal!)
  (if (dk-head-is? (dk-goal) 'AND)
      (let ((lv (dk-opened (lambda () (di)))))
        (append-map (lambda (l) (dk-focus! l) (cfl-split-goal!)) lv))
      (list (proof-state-focus *ps*))))

;;; split the conjunctive goal, close every conjunct whose head is not HEAD by
;;; `ass', focus the one whose head is HEAD.
(define (cfl-and-focus! head)
  (let* ((lv   (cfl-split-goal!))
         (keep (filter (lambda (l) (dk-head-is? (dk-goal-of l) head)) lv))
         (rest (filter (lambda (l) (not (dk-head-is? (dk-goal-of l) head))) lv)))
    (if (not (= (length keep) 1))
        (error "cfl-and-focus!: expected exactly one conjunct headed" head (length keep)))
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin (dk-focus! l) (ass)
                           (if (not (sequent-node-grounded? l))
                               (error "cfl-and-focus!: conjunct not in context" (expression->string (dk-goal-of l)))))))
              rest)
    (dk-focus! (car keep))))

;;; the distance term of the metric space M
(define (cfl-d m a b) (list (list 'DIST m) a b))

;;; (== (PTS RR-MS) RR) in context
(define (cfl-ptsrr!)
  (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl))))

;;; the pointwise sum and scalar multiple, as the vocabulary writes them
(define (cfl-sum m f g) (list 'VNB-LAMBDA 'sx_ (list 'PTS m) (list '+ (list f 'sx_) (list g 'sx_))))
(define (cfl-scl m c f) (list 'VNB-LAMBDA 'sx_ (list 'PTS m) (list '* c (list f 'sx_))))

;;; =====================================================================
;;; (A) THE VOCABULARY: membership laws, closure of CONT-FNS
;;; =====================================================================

(sp (make-wff '(FORALL s (FORALL h (IFF (IN h (CONT-FNS s))
  (AND (IN h (FUN (PTS s) RR)) (IS-CONTINUOUS s RR-MS h)))))))
(dk-peel!)
(mac 'CONT-FNS)
(cfl-sep-iff!)
(qed 'rmc-cont-fns-mem)

(sp (make-wff '(FORALL s (FORALL u (IFF (IN u (CLOPEN-SETS s))
  (AND (IN u (POWER (PTS s))) (AND (IS-OPEN s u) (IS-CLOSED s u))))))))
(dk-peel!)
(mac 'CLOPEN-SETS)
(cfl-sep-iff!)
(qed 'rmc-clopen-mem)

;;; a set both open and closed is a clopen set
(sp (make-wff '(FORALL s (FORALL u (IMPLIES (IS-OPEN s u) (IMPLIES (IS-CLOSED s u) (IN u (CLOPEN-SETS s))))))))
(dk-peel!)
(dk-have! '(IS-METRIC-SPACE s)
  (lambda () (let ((c (dk-cite! 'is-open 's 'u))) (cfl-prop! c '(IS-OPEN s u)))))
(dk-cite! 'open-in-power 's 'u)
(let ((c (dk-cite! 'rmc-clopen-mem 's 'u)))
  (cfl-prop! c '(IS-OPEN s u) '(IS-CLOSED s u) '(IN u (POWER (PTS s)))))
(qed 'rmc-clopen-intro)

;;; the parts of a clopen set
(sp (make-wff '(FORALL s (FORALL u (IMPLIES (IN u (CLOPEN-SETS s))
  (AND (IS-OPEN s u) (AND (IS-CLOSED s u) (SUBSET u (PTS s)))))))))
(dk-peel!)
(let ((c (dk-cite! 'rmc-clopen-mem 's 'u)))
  (dk-have! '(IS-OPEN s u) (lambda () (cfl-prop! c '(IN u (CLOPEN-SETS s)))))
  (dk-have! '(IS-CLOSED s u) (lambda () (cfl-prop! c '(IN u (CLOPEN-SETS s))))))
(let ((c (dk-cite! 'is-open 's 'u)))
  (dk-have! '(SUBSET u (PTS s)) (lambda () (cfl-prop! c '(IS-OPEN s u)))))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-clopen-parts)

;;; the parts of a continuous real function
(sp (make-wff '(FORALL s (FORALL h (IMPLIES (IN h (CONT-FNS s))
  (AND (IN h (FUN (PTS s) RR))
       (AND (IS-METRIC-SPACE s)
            (FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS h a))))))))))
(dk-peel!)
(let ((c (dk-cite! 'rmc-cont-fns-mem 's 'h)))
  (dk-have! '(IN h (FUN (PTS s) RR)) (lambda () (cfl-prop! c '(IN h (CONT-FNS s)))))
  (dk-have! '(IS-CONTINUOUS s RR-MS h) (lambda () (cfl-prop! c '(IN h (CONT-FNS s))))))
(let ((c (dk-cite! 'is-continuous 's 'RR-MS 'h)))
  (dk-have! '(IS-METRIC-SPACE s) (lambda () (cfl-prop! c '(IS-CONTINUOUS s RR-MS h))))
  (dk-have! '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS h a)))
    (lambda () (cfl-prop! c '(IS-CONTINUOUS s RR-MS h)))))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-cont-fns-parts)

;;; a real function continuous at every point is in CONT-FNS
(sp (make-wff '(FORALL s (FORALL h (IMPLIES (IS-METRIC-SPACE s) (IMPLIES (IN h (FUN (PTS s) RR))
  (IMPLIES (FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS h a)))
    (IN h (CONT-FNS s)))))))))
(dk-peel!)
(cfl-ptsrr!)
(fact 'rr-is-metric-space)
(dk-have! '(IN h (FUN (PTS s) (PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(let ((c (dk-cite! 'is-continuous 's 'RR-MS 'h)))
  (dk-have! '(IS-CONTINUOUS s RR-MS h)
    (lambda () (cfl-prop! c '(IS-METRIC-SPACE s) '(IS-METRIC-SPACE RR-MS) '(IN h (FUN (PTS s) (PTS RR-MS)))
                          '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS h a)))))))
(let ((c (dk-cite! 'rmc-cont-fns-mem 's 'h)))
  (cfl-prop! c '(IS-CONTINUOUS s RR-MS h) '(IN h (FUN (PTS s) RR))))
(qed 'rmc-cont-fns-intro)

;;; CLOSURE UNDER SCALAR MULTIPLES: x |-> c * f(x) is f composed with the affine
;;; map t |-> 0 + c t (affine-continuous-at), transferred pointwise.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'c (list 'FORALL 'f
  (list 'IMPLIES '(IN c RR) (list 'IMPLIES '(IN f (CONT-FNS s))
    (list 'IN (cfl-scl 's 'c 'f) '(CONT-FNS s)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(cfl-ptsrr!)
(fact 'rr-is-metric-space)
(dk-cite! 'ms-pts-is-set 's)
(define cfl-h (cfl-scl 's 'c 'f))
(dk-have! (list 'IN cfl-h '(FUN (PTS s) RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR x)
          (in-rr))))))
(dk-have! (list 'IN cfl-h '(FUN (PTS s) (PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(define cfl-aff '(VNB-LAMBDA x RR (+ 0 (* c x))))
(dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS s)) (list 'IS-CONTINUOUS-AT 's 'RR-MS cfl-h 'a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR a)
      (dk-have! '(IN 0 RR) (lambda () (from-context!)))
      (dk-have! (list 'AND '(IN 0 RR) (list 'AND '(IN c RR) (list 'IN (list 'f a) 'RR)))
        (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-cite! 'affine-continuous-at 0 'c (list 'f a))
      (dk-apply! (dk-ctx-form '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS f a)))) a)
      (dk-cite! 'ms-compose-continuous-at 's 'RR-MS 'RR-MS 'f cfl-aff a)
      (let ((g (list 'VNB-LAMBDA 'msz_ '(PTS s) (list cfl-aff (list 'f 'msz_)))))
        (dk-have! (list 'FORALL 'msz_ (list 'IMPLIES '(IN msz_ (PTS s)) (list '= (list cfl-h 'msz_) (list g 'msz_))))
          (lambda ()
            (let ((z (dk-di-var!)))
              (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR z)
              (dk-lam-b!)
              (crs))))
        (dk-cite! 'ms-cont-transfer-ptwise-eq 's 'RR-MS g cfl-h a)
        (ass)))))
(dk-cite! 'rmc-cont-fns-intro 's cfl-h)
(ass)
(qed 'rmc-cont-fns-scale)

;;; CLOSURE UNDER SUMS: the eps/2 argument at each point.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'f (list 'FORALL 'g
  (list 'IMPLIES '(IN f (CONT-FNS s)) (list 'IMPLIES '(IN g (CONT-FNS s))
    (list 'IN (cfl-sum 's 'f 'g) '(CONT-FNS s)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'g)))
(cfl-ptsrr!)
(fact 'rr-is-metric-space)
(dk-cite! 'ms-pts-is-set 's)
(define cfl-h (cfl-sum 's 'f 'g))
(dk-have! (list 'IN cfl-h '(FUN (PTS s) RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR x)
          (dk-cite! 'fun-apply-type-c 'g '(PTS s) 'RR x)
          (in-rr))))))
(dk-have! (list 'IN cfl-h '(FUN (PTS s) (PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(define cfl-fcont (dk-ctx-form '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS f a)))))
(define cfl-gcont (dk-ctx-form '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS g a)))))
;;; the eps-delta clause of a continuity at A, landed from IS-CONTINUOUS-AT
(define (cfl-cont-clause! fn a)
  (let* ((c (dk-cite! 'is-continuous-at 's 'RR-MS fn a))
         (cl (caddr (caddr (caddr (caddr (caddr c)))))))
    (dk-have! cl (lambda () (cfl-prop! c (list 'IS-CONTINUOUS-AT 's 'RR-MS fn a))))
    cl))
(dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS s)) (list 'IS-CONTINUOUS-AT 's 'RR-MS cfl-h 'a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-apply! cfl-fcont a)
      (dk-apply! cfl-gcont a)
      (let* ((fc (cfl-cont-clause! 'f a))
            (gc (cfl-cont-clause! 'g a)))
        (mac 'is-continuous-at)
        (cfl-and-focus! 'FORALL)
        (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g)))))
               (_   (di))
               (e2  (dk-halve! eps))
               (d1  (dk-skolem! (dk-apply! fc e2)))
               (d1c (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b)
                                              (dk--occurs? d1 f))) "f's delta clause"))
               (d2  (dk-skolem! (dk-apply! gc e2)))
               (d2c (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b)
                                              (dk--occurs? d2 f))) "g's delta clause")))
          (cfl-pos! d1)
          (cfl-pos! d2)
          (let ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2))))
            (dk-cite! 'rr-pos-rr-of-lt w)
            (ew w)
            (cfl-and-focus! 'FORALL)
            (let ((b (dk-di-var!)))
              (di)
              (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR a)
              (dk-cite! 'fun-apply-type-c 'g '(PTS s) 'RR a)
              (dk-cite! 'fun-apply-type-c 'f '(PTS s) 'RR b)
              (dk-cite! 'fun-apply-type-c 'g '(PTS s) 'RR b)
              (dk-cite! 'metric-dist-real 's a b)
              (dk-have! (list '<= (cfl-d 's a b) d1)
                (lambda () (dk-ineq! (list '<= (cfl-d 's a b) w) (list '<= w d1) (list 'IN (cfl-d 's a b) 'RR) (list 'IN w 'RR) (list 'IN d1 'RR))))
              (dk-have! (list '<= (cfl-d 's a b) d2)
                (lambda () (dk-ineq! (list '<= (cfl-d 's a b) w) (list '<= w d2) (list 'IN (cfl-d 's a b) 'RR) (list 'IN w 'RR) (list 'IN d2 'RR))))
              (let* ((uf (dk-apply! d1c b))
                    (ug (dk-apply! d2c b)))
                (dk-cite! 'rr-ms-dist (list 'f a) (list 'f b))
                (dk-cite! 'rr-ms-dist (list 'g a) (list 'g b))
                (let* ((uf2 (dk-rewrite-h! uf (cfl-d 'RR-MS (list 'f a) (list 'f b))
                                          (list 'abs (list '- (list 'f a) (list 'f b)))))
                      (ug2 (dk-rewrite-h! ug (cfl-d 'RR-MS (list 'g a) (list 'g b))
                                          (list 'abs (list '- (list 'g a) (list 'g b))))))
                  (dk-lam-b!)
                  (let ((ha (list '+ (list 'f a) (list 'g a)))
                        (hb (list '+ (list 'f b) (list 'g b))))
                    (dk-have! (list 'IN ha 'RR) (lambda () (in-rr)))
                    (dk-have! (list 'IN hb 'RR) (lambda () (in-rr)))
                    (dk-cite! 'rr-ms-dist ha hb)
                    (subst (list '== (cfl-d 'RR-MS ha hb) (list 'abs (list '- ha hb))))
                    (let* ((ua (list '- (list 'f a) (list 'f b)))
                           (ub (list '- (list 'g a) (list 'g b)))
                           (eq1 (list '= (list '- ha hb) (list '+ ua ub))))
                      (dk-have! (list 'IN ua 'RR) (lambda () (in-rr)))
                      (dk-have! (list 'IN ub 'RR) (lambda () (in-rr)))
                      (dk-have! eq1 (lambda () (crs)))
                      (subst eq1)
                      (dk-cite! 'rr-abs-triangle-c ua ub)
                      (dk-cite! 'rr-abs-closed ua)
                      (dk-cite! 'rr-abs-closed ub)
                      (dk-have! (list 'IN (list '+ ua ub) 'RR) (lambda () (in-rr)))
                      (dk-cite! 'rr-abs-closed (list '+ ua ub))
                      (cfl-pos! eps)
                      (dk-ineq! uf2 ug2 (list '= (list '+ e2 e2) eps)
                                (list '<= (list 'abs (list '+ ua ub)) (list '+ (list 'abs ua) (list 'abs ub)))
                                (list 'IN (list 'abs ua) 'RR) (list 'IN (list 'abs ub) 'RR)
                                (list 'IN (list 'abs (list '+ ua ub)) 'RR)
                                (list 'IN (list 'f a) 'RR) (list 'IN (list 'g a) 'RR)
                                (list 'IN (list 'f b) 'RR) (list 'IN (list 'g b) 'RR)
                                (list 'IN e2 'RR) (list 'IN eps 'RR)))))))))))))
(dk-cite! 'rmc-cont-fns-intro 's cfl-h)
(ass)
(qed 'rmc-cont-fns-add)

;;; (cfl-in-ball! S A R B D): with (POS-RR D), (= (+ D D) R), B in PTS S and
;;; d(A, B) <= D in context, land (IN B (BALL S A R)).
(define (cfl-in-ball! s a r b d)
  (let ((dab (cfl-d s a b)))
    (dk-cite! 'metric-dist-real s a b)
    (cfl-pos! d)
    (cfl-pos! r)
    (dk-have! (list '<= dab r)
      (lambda () (dk-ineq! (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                           (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (dk-have! (list 'NOT (list '= dab r))
      (lambda ()
        (di)
        (dk-absurd! (list '= dab r) (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                    (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (let ((c (dk-cite! 'ball-membership s a r b)))
      (dk-have! (list 'IN b (list 'BALL s a r))
        (lambda () (cfl-prop! c (list 'IN b (list 'PTS s)) (list '<= dab r) (list 'NOT (list '= dab r))))))))

;;; (cfl-abs-le! X C PREMISE ...): land (<= (abs X) C) from -C <= X <= C, each
;;; by dk-ineq! on the named premises; (IN C RR) must be in context.
(define (cfl-abs-le! x c . prems)
  (dk-have! (list 'IN x 'RR) (lambda () (in-rr)))
  (dk-have! (list '<= (list '- c) x) (lambda () (apply dk-ineq! prems)))
  (dk-have! (list '<= x c) (lambda () (apply dk-ineq! prems)))
  (dk-cite! 'rr-abs-le-of-parts x c))

;;; A FUNCTION CONSTANT ON AN OPEN SET AROUND a IS CONTINUOUS AT a.
(sp (make-wff '(FORALL s (FORALL h (FORALL a (FORALL w
  (IMPLIES (IS-OPEN s w) (IMPLIES (IN a w) (IMPLIES (IN h (FUN (PTS s) RR))
    (IMPLIES (FORALL y (IMPLIES (IN y w) (= (h y) (h a))))
      (IS-CONTINUOUS-AT s RR-MS h a)))))))))))
(dk-peel!)
(define cfl-oc (dk-cite! 'is-open 's 'w))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (cfl-prop! cfl-oc '(IS-OPEN s w))))
(dk-have! '(SUBSET w (PTS s)) (lambda () (cfl-prop! cfl-oc '(IS-OPEN s w))))
(define cfl-ocl (caddr (caddr (caddr cfl-oc))))
(dk-have! cfl-ocl (lambda () (cfl-prop! cfl-oc '(IS-OPEN s w))))
(dk-cite! 'subset-mem-fwd 'w '(PTS s) 'a)
(define cfl-r (dk-skolem! (dk-apply! cfl-ocl 'a)))
(define cfl-hd (dk-halve! cfl-r))
(cfl-ptsrr!)
(fact 'rr-is-metric-space)
(dk-have! '(IN h (FUN (PTS s) (PTS RR-MS))) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-cite! 'fun-apply-type-c 'h '(PTS s) 'RR 'a)
(mac 'is-continuous-at)
(cfl-and-focus! 'FORALL)
(define cfl-eps (dk-di-var! (lambda (g) (cadr (cadr g)))))
(di)
(cfl-pos! cfl-eps)
(ew cfl-hd)
(cfl-and-focus! 'FORALL)
(define cfl-b (dk-di-var!))
(di)
(cfl-in-ball! 's 'a cfl-r cfl-b cfl-hd)
(dk-cite! 'subset-mem-fwd (list 'BALL 's 'a cfl-r) 'w cfl-b)
(dk-apply! (dk-ctx-form '(FORALL y (IMPLIES (IN y w) (= (h y) (h a))))) cfl-b)
(subst (list '= (list 'h cfl-b) '(h a)))
(dk-cite! 'rr-ms-dist '(h a) '(h a))
(subst '(== ((DIST RR-MS) (h a) (h a)) (abs (- (h a) (h a)))))
(cfl-abs-le! '(- (h a) (h a)) cfl-eps '(IN (h a) RR) (list 'IN cfl-eps 'RR) (list '< 0 cfl-eps))
(ass)
(qed 'rmc-cont-at-locally-const)
