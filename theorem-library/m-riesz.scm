;;; ---- PROPOSITION 4.32
(define g4r-goal '(FORSOME ff (AND (IS-LINEAR-FUNCTIONAL-ON m (VEC m) ff)
                   (AND (EXTENDS-ON v ff f) (FORALL g4rx_ (IMPLIES (IN g4rx_ c) (<= 0 (ff g4rx_))))))))
(sp (make-wff (g4r-hyps g4r-goal)))
(g4r-open!)
(g4r-vm! '(VZERO m))
(let* ((pp (dk-skolem! (dk-cite! 'm-riesz-p-exists 'm 'c 'v 'f) #t)))
  (dk-split-all! (list (dk-cite! 'm-riesz-p-props 'm 'c 'v 'f pp)))
  (let* ((ff (dk-skolem! (dk-cite! 'hbs-hahn-banach-sublinear 'm pp 'v 'f) #t))
         (ff-le (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ff) (dk-contains? h pp))) "ff <= pp"))
         (negc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h pp) (dk-contains? h 'c)
                                         (not (dk-contains? h ff)) (not (dk-contains? h 'IS-SUBLINEAR)))) "p(-x) <= 0")))
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((x (dk-di-var!)) (nx (g4r-vneg x)) (z '(VZERO m)))
              (g4r-vm! x) (g4r-vm! nx)
              (dk-cite! 'hbs-lf-val 'm '(VEC m) ff x)
              (dk-cite! 'hbs-lf-val 'm '(VEC m) ff nx)
              (dk-cite! 'hbs-lf-val 'm '(VEC m) ff z)
              (dk-cite! 'fun-apply-type-c pp '(VEC m) 'RR nx)
              (g4r-apply! ff-le nx)
              (g4r-apply! negc x)
              (let ((e1 (dk-cite! 'hbs-lf-add 'm '(VEC m) ff x nx))
                    (e0 (dk-cite! 'hbs-lf-add 'm '(VEC m) ff z z)))
                (dk-cite! 'frm-v-right-inv 'm x)
                (dk-cite! 'hbs-vzero-r 'm z)
                (dk-rewrite-h! e1 (g4r-vadd x nx) z)
                (dk-rewrite-h! e0 (g4r-vadd z z) z))
              (dk-ineq! (list '<= (list ff nx) (list pp nx)) (list '<= (list pp nx) 0)
                        (list '= (list ff z) (list '+ (list ff x) (list ff nx)))
                        (list '= (list ff z) (list '+ (list ff z) (list ff z)))
                        (list 'IN (list ff x) 'RR) (list 'IN (list ff nx) 'RR) (list 'IN (list ff z) 'RR)
                        (list 'IN (list pp nx) 'RR))))))))
