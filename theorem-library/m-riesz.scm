;;; m-riesz.scm -- PROPOSITION 4.32, THE M. RIESZ EXTENSION: E a real vector space ordered by a pointed
;;; cone C, V a cofinal subspace, f linear on V and non-negative on C n V.  Then f extends to a linear
;;; functional on E non-negative on C.  F. J. Thayer, "Banach Algebras and Applications", Prop. 4.32.
;;; Agent BA-1117-GNS2, 2026-11-17.  Destination: theorem-library/m-riesz.scm.  Library: analysis.
;;; Load window: after hahn-banach-sublinear (hbs-*), the frm- module laws, and
;;; structure-library/m-riesz-vocab.  Prefix g4r-.
;;;
;;; THE ROUTE (the notes use Zorn one dimension at a time; this is the same extension done at once
;;; by Hahn-Banach, as in theorem-library/positive-extension.scm for C(K)):
;;;   p(g) = inf { f(w) : w in V, g <= w }
;;; is finite (V cofinal: some w0 in V with -g <= w0 bounds it below by -f(w0)), sublinear, f <= p on
;;; V (f monotone on V), and p(-x) <= f(0) = 0 for x in C.  hbs-hahn-banach-sublinear gives F <= p
;;; linear extending f, and F(x) = -F(-x) >= -p(-x) >= 0 on C.

(define g4r-R '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (g4r-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (for-each (lambda (l) (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms-of l)))
                  (dk-open-leaves))
        (error "m-riesz: unfinished" name))))
(define (g4r-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))
(define (g4r-vadd x y) (list '(VADD m) x y))
(define (g4r-vneg x) (list '(VNEG m) x))
(define (g4r-act t x) (list '(ACT m) t x))
(define (g4r-sub y x) (g4r-vadd y (g4r-vneg x)))
(define (g4r-le x y) (list 'IN (g4r-sub y x) 'c))         ; x <= y
(define g4r-pos '(FORALL g4rz_ (IMPLIES (IN g4rz_ v) (IMPLIES (IN g4rz_ c) (<= 0 (f g4rz_))))))
(define (g4r-hyps body)
  (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES (list '= '(SCAL m) g4r-R)
   (list 'FORALL 'c (list 'IMPLIES '(IS-POINTED-CONE m c)
    (list 'FORALL 'v (list 'IMPLIES '(IS-SUBMODULE m v) (list 'IMPLIES '(IS-COFINAL m c v)
     (list 'FORALL 'f (list 'IMPLIES '(IS-LINEAR-FUNCTIONAL-ON m v f) (list 'IMPLIES g4r-pos body))))))))))))
(define g4r-v-add '(FORALL x_ (IMPLIES (IN x_ v) (FORALL y_ (IMPLIES (IN y_ v) (IN ((VADD m) x_ y_) v))))))
(define g4r-v-neg '(FORALL x_ (IMPLIES (IN x_ v) (IN ((VNEG m) x_) v))))
(define g4r-c-add '(FORALL g4rx_ (IMPLIES (IN g4rx_ c) (FORALL g4ry_ (IMPLIES (IN g4ry_ c) (IN ((VADD m) g4rx_ g4ry_) c))))))
(define g4r-c-act '(FORALL g4rt_ (IMPLIES (IN g4rt_ RR) (IMPLIES (<= 0 g4rt_) (FORALL g4rx_ (IMPLIES (IN g4rx_ c) (IN ((ACT m) g4rt_ g4rx_) c)))))))
(define (g4r-ap! f . ts) (apply dk-apply! (or (dk-ctx-form f) f) ts))
(define (g4r-open!)
  (dk-peel!)
  (dk-cite! 'frm-module-vec-set 'm)
  (dk-cite! 'rr-zero-in)
  (dk-iff-fwd! (dk-cite! 'is-pointed-cone 'm 'c))
  (dk-iff-fwd! (dk-cite! 'is-submodule 'm 'v))
  (dk-cite! 'hbs-lf-fun 'm 'v 'f))
;;; typing helpers
(define (g4r-vm! x)           ; x in VEC m, from x in v or x in c or by construction
  (cond ((dk-asm? (list 'IN x '(VEC m))) #t)
        ((dk-asm? (list 'IN x 'v)) (dk-cite! 'hbs-sub-vec 'm 'v x))
        ((dk-asm? (list 'IN x 'c)) (dk-cite! 'subset-mem-fwd 'c '(VEC m) x))
        ((and (pair? x) (equal? (car x) '(VADD m))) (g4r-vm! (cadr x)) (g4r-vm! (caddr x)) (dk-cite! 'module-vadd-type 'm (cadr x) (caddr x)))
        ((and (pair? x) (equal? (car x) '(VNEG m))) (g4r-vm! (cadr x)) (dk-cite! 'module-vneg-type 'm (cadr x)))
        ((and (pair? x) (equal? (car x) '(ACT m))) (g4r-vm! (caddr x)) (dk-cite! 'hbs-act-in 'm (cadr x) (caddr x)))
        ((equal? x '(VZERO m)) (g4r-cite-zero!))
        (#t (error "g4r-vm!: cannot type" (expression->string x)))))
(define (g4r-cite-zero!) (dk-cite! 'hbs-sub-vec 'm 'v '(VZERO m)))
(define (g4r-inv! x)          ; x in v for x built from v-members by + and -
  (cond ((dk-asm? (list 'IN x 'v)) #t)
        ((and (pair? x) (equal? (car x) '(VADD m))) (g4r-inv! (cadr x)) (g4r-inv! (caddr x)) (g4r-ap! g4r-v-add (cadr x) (caddr x)))
        ((and (pair? x) (equal? (car x) '(VNEG m))) (g4r-inv! (cadr x)) (g4r-ap! g4r-v-neg (cadr x)))
        (#t (error "g4r-inv!: not in v" (expression->string x)))))
(define (g4r-fv! x) (g4r-inv! x) (dk-cite! 'hbs-lf-val 'm 'v 'f x))
(define (g4r-flin! x y)       ; f(x + y) = f x + f y, all typed
  (g4r-inv! x) (g4r-inv! y) (g4r-fv! x) (g4r-fv! y) (g4r-fv! (g4r-vadd x y))
  (dk-cite! 'hbs-lf-add 'm 'v 'f x y))
(define (g4r-fneg! z)         ; f(-z) = -f(z) as   f z + f(-z) = 0  landed
  (let ((nz (g4r-vneg z)))
    (g4r-vm! z)
    (g4r-flin! z nz)
    (dk-cite! 'hbs-lf-zero 'm 'v 'f)
    (let ((e (dk-cite! 'frm-v-right-inv 'm z)))
      (dk-have! (list '= (list '+ (list 'f z) (list 'f nz)) 0)
        (lambda ()
          (subst (list '= (list '+ (list 'f z) (list 'f nz)) (list 'f (g4r-vadd z nz))))
          (subst e)
          (dk-ass!))))))

;;; f is monotone on V
(sp (make-wff (g4r-hyps (g4r-fa 'g4rz_ 'v (g4r-fa 'g4rw_ 'v (list 'IMPLIES (g4r-le 'g4rz_ 'g4rw_) '(<= (f g4rz_) (f g4rw_))))))))
(g4r-open!)
(let* ((g (dk-goal)) (z (cadr (cadr g))) (w (cadr (caddr g))) (d (g4r-sub w z)))
  (g4r-fneg! z)
  (g4r-flin! w (g4r-vneg z))
  (g4r-ap! g4r-pos d)
  (dk-ineq! (list '<= 0 (list 'f d)) (list '= (list 'f d) (list '+ (list 'f w) (list 'f (g4r-vneg z))))
            (list '= (list '+ (list 'f z) (list 'f (g4r-vneg z))) 0)
            (list 'IN (list 'f z) 'RR) (list 'IN (list 'f w) 'RR) (list 'IN (list 'f (g4r-vneg z)) 'RR) (list 'IN (list 'f d) 'RR)))
(g4r-qed! 'm-riesz-f-mono)

;;; ---- the dominating functional p(g) = inf { f(w) : w in V, g <= w }
(define (g4r-apply! f . terms)     ; pex-apply! of positive-extension.scm
  (let loop ((g (->raw-formula f)) (ts terms))
    (cond ((and (pair? g) (eq? (car g) 'FORALL) (pair? ts))
           (loop (subst-free (cadr g) (car ts) (caddr g)) (cdr ts)))
          ((and (null? ts) (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g)))
           (loop (caddr g) ts))
          ((and (null? ts) (dk-ctx-form g)) => (lambda (h) h))
          (#t (apply dk-apply! f terms)))))
(define (g4r-prop! . keepers) (if (apply dk-only! keepers) (prop)))
(define (g4r-idx g) (list 'SEP 'g4rs_ 'v (g4r-le g 'g4rs_)))
(define g4r-iif (list 'VNB-LAMBDA 'g4rg_ '(VEC m) (g4r-idx 'g4rg_)))
(define g4r-phi (list 'VNB-LAMBDA '(LIST g4rg_ g4rw_) '(CARTESIAN (VEC m) v) '(f g4rw_)))
(define (g4r-plb pp) (g4r-fa 'g4rk_ '(VEC m) (g4r-fa 'g4ru_ 'v (list 'IMPLIES (g4r-le 'g4rk_ 'g4ru_) (list '<= (list pp 'g4rk_) '(f g4ru_))))))
(define (g4r-pglb pp) (g4r-fa 'g4rk_ '(VEC m) (g4r-fa 'g4rb_ 'RR
  (list 'IMPLIES (g4r-fa 'g4ru_ 'v (list 'IMPLIES (g4r-le 'g4rk_ 'g4ru_) '(<= g4rb_ (f g4ru_))))
        (list '<= 'g4rb_ (list pp 'g4rk_))))))
(define (g4r-vset!) (dk-cite! 'subclass-of-set-is-set 'v '(VEC m)))
(define (g4r-idx-set! g)
  (g4r-vset!)
  (dk-have! (list 'IN (g4r-idx g) 'SET) (lambda () (dk-close-all! (lambda () (sep-set))))))

(sp (make-wff (g4r-hyps (g4r-fa 'g4rg_ '(VEC m) (list 'FORALL 'g4rw_ (list 'IFF (list 'IN 'g4rw_ (list g4r-iif 'g4rg_)) (list 'IN 'g4rw_ (g4r-idx 'g4rg_))))))))
(g4r-open!)
(let ((g (cadr (caddr (cadr (dk-goal))))))
  (g4r-idx-set! g)
  (dk-lam-b!)
  (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (dk-ass!))))
            (dk-opened (lambda () (di)))))
(g4r-qed! 'm-riesz-iif-mem)

(define (g4r-idx-parts! w g)
  (let ((iff (dk-cite! 'm-riesz-iif-mem 'm 'c 'v 'f g w)))
    (dk-have! (list 'IN w (g4r-idx g)) (lambda () (g4r-prop! iff (list 'IN w (list g4r-iif g)))))
    (let ((m0 (list 'IN w (g4r-idx g))))
      (dk-have! (list 'IN w 'v) (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form m0))))) (dk-ass!)))
      (dk-have! (g4r-le g w) (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form m0))))) (dk-ass!))))))
(define (g4r-idx-in! w g)
  (let ((iff (dk-cite! 'm-riesz-iif-mem 'm 'c 'v 'f g w)))
    (dk-have! (list 'IN w (g4r-idx g)) (lambda () (dk-close-all! (lambda () (sep-mi)))))
    (dk-have! (list 'IN w (list g4r-iif g)) (lambda () (g4r-prop! iff (list 'IN w (g4r-idx g)))))))
(define (g4r-redex? t)
  (and (pair? t) (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA)) (any-pred g4r-redex? t))))
(define (g4r-reduce-goal!)
  (let loop () (if (and (not (proof-done? *ps*)) (g4r-redex? (dk-goal))) (if (not (dk-lam-b!)) (loop)))))
(define (g4r-cofinal! a)      ; a in VEC m: land w0 in v and a <= w0, return w0
  (let* ((cf (dk-cite! 'is-cofinal 'm 'c 'v)))
    (dk-iff-fwd! cf)
    (let* ((all (dk-ctx-form (caddr cf)))
           (ex (g4r-ap! all a))
           (w0 (dk-skolem! ex #t)))
      (dk-iff-fwd! (dk-cite! 'cone-le 'm 'c a w0))
      w0)))

(sp (make-wff (g4r-hyps (list 'FORSOME 'pp (list 'AND '(IN pp (FUN (VEC m) RR)) (list 'AND (g4r-plb 'pp) (g4r-pglb 'pp)))))))
(g4r-open!)
(g4r-vset!)
(dk-have! (g4r-fa 'hix_ '(VEC m) (list 'FORSOME 'hi0_ (list 'IN 'hi0_ (list g4r-iif 'hix_))))
  (lambda ()
    (let* ((g (dk-di-var!)) (w0 (g4r-cofinal! g)))
      (g4r-idx-in! w0 g)
      (ew w0)
      (dk-ass!))))
(dk-have! (g4r-fa 'hix_ '(VEC m) (g4r-fa 'hij_ (list g4r-iif 'hix_) (list 'IN (list g4r-phi 'hix_ 'hij_) 'RR)))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (gg (cadr (cadr g))) (w (caddr (cadr g))))
      (g4r-idx-parts! w gg)
      (g4r-fv! w)
      (g4r-reduce-goal!)
      (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (dk-ass!))))))
(dk-have! (g4r-fa 'hix_ '(VEC m) (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
            (g4r-fa 'hij_ (list g4r-iif 'hix_) (list '<= 'hib_ (list g4r-phi 'hix_ 'hij_))))))
  (lambda ()
    (let* ((g (dk-di-var!)) (ng (g4r-vneg g)))
      (g4r-vm! ng)
      (let* ((w0 (g4r-cofinal! ng)) (b (list '- (list 'f w0))))
        (g4r-fv! w0)
        (dk-cite! 'rr-neg-closed (list 'f w0))
        (ew b)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((w (dk-di-var!)) (s1 (g4r-sub w g)) (s2 (g4r-sub w0 ng)) (ww (g4r-vadd w w0)))
                (g4r-idx-parts! w g)
                (g4r-vm! w) (g4r-vm! w0) (g4r-vm! ww)
                (dk-have! (list '= (g4r-vadd s1 s2) ww)
                  (lambda ()
                    (subst (dk-cite! 'frm-v-neg-neg 'm g))
                    (subst (dk-cite! 'hbs-interchange 'm w ng w0 g))
                    (subst (dk-cite! 'hbs-vadd-comm 'm ng g))
                    (subst (dk-cite! 'frm-v-right-inv 'm g))
                    (subst (dk-cite! 'hbs-vzero-r 'm ww))
                    (rfl)))
                (let ((cs (g4r-ap! g4r-c-add s1 s2)))
                  (dk-rewrite-h! cs (g4r-vadd s1 s2) ww))
                (g4r-inv! ww)
                (g4r-ap! g4r-pos ww)
                (g4r-flin! w w0)
                (g4r-reduce-goal!)
                (dk-ineq! (list '<= 0 (list 'f ww)) (list '= (list 'f ww) (list '+ (list 'f w) (list 'f w0)))
                          (list 'IN (list 'f w) 'RR) (list 'IN (list 'f w0) 'RR) (list 'IN (list 'f ww) 'RR))))))))))
(let* ((r (dk-skolem! (dk-cite! 'hbs-inf-family '(VEC m) g4r-iif g4r-phi)))
       (r-lb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (not (dk-contains? f 'hib_)))) "LB"))
       (r-glb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'hib_))) "GLB")))
  (ew r)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (dk-ass!))
              ((dk-contains? g 'g4rb_)
               (dk-peel!)
               (let* ((gl (dk-goal)) (b (cadr gl)) (gg (cadr (caddr gl)))
                      (hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'f)
                                                    (not (dk-contains? f r))))
                                   "the lower-bound hypothesis")))
                 (dk-have! (g4r-fa 'hij_ (list g4r-iif gg) (list '<= b (list g4r-phi gg 'hij_)))
                   (lambda ()
                     (let ((j (dk-di-var!)))
                       (g4r-idx-parts! j gg)
                       (g4r-apply! hb j)
                       (g4r-reduce-goal!)
                       (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (dk-ass!))))))
                 (g4r-apply! r-glb gg b)
                 (dk-ass!)))
              (#t
               (dk-peel!)
               (let* ((gl (dk-goal)) (gg (cadr (cadr gl))) (w (cadr (caddr gl))))
                 (g4r-idx-in! w gg)
                 (let ((h (g4r-apply! r-lb gg w)))
                   (if (not (dk-lam-b-h! h)) (dk-ass!))))))))))
(g4r-qed! 'm-riesz-p-exists)


;;; ---- p is sublinear, dominates f on V, and p(-x) <= 0 on C
(define g4r-v-act '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL m))) (FORALL x_ (IMPLIES (IN x_ v) (IN ((ACT m) r_ x_) v))))))
(define (g4r-glb-ant g b . bv)
  (let ((q (if (pair? bv) (car bv) 'g4rq_)))
    (g4r-fa q 'v (list 'IMPLIES (g4r-le g q) (list '<= b (list 'f q))))))
(define (g4r-ppv! g) (g4r-vm! g) (dk-cite! 'fun-apply-type-c 'pp '(VEC m) 'RR g))
(define (g4r-carr! t)
  (dk-have! (list 'IN t '(CARR (SCAL m)))
    (lambda () (subst (list '= '(SCAL m) g4r-R)) (mac 'rr-scalar-ring-carr) (dk-ass!))))
(define g4r-dom (g4r-fa 'g4rz_ 'v '(<= (f g4rz_) (pp g4rz_))))
(define g4r-negc (g4r-fa 'g4rx_ 'c (list '<= (list 'pp (g4r-vneg 'g4rx_)) 0)))
(sp (make-wff (g4r-hyps (list 'FORALL 'pp (list 'IMPLIES '(IN pp (FUN (VEC m) RR))
  (list 'IMPLIES (g4r-plb 'pp) (list 'IMPLIES (g4r-pglb 'pp)
    (list 'AND '(IS-SUBLINEAR m pp) (list 'AND g4r-dom g4r-negc)))))))))
(g4r-open!)
(define (g4r-plb!) (dk-ctx-form (g4r-plb 'pp)))
(define (g4r-pglb!) (dk-ctx-form (g4r-pglb 'pp)))
(define g4r-0 '(VZERO m))
(dk-cite! 'hbs-lf-zero 'm 'v 'f)
(g4r-fv! g4r-0)
;; f <= p on V
(dk-have! g4r-dom
  (lambda ()
    (let ((z (dk-di-var!)))
      (g4r-fv! z) (g4r-vm! z)
      (dk-have! (g4r-glb-ant z (list 'f z))
        (lambda ()
          (dk-peel!)
          (let ((w (cadr (caddr (dk-goal)))))
            (dk-cite! 'm-riesz-f-mono 'm 'c 'v 'f z w)
            (dk-ass!))))
      (g4r-apply! (g4r-pglb!) z (list 'f z))
      (dk-ass!))))
;; p(-x) <= 0 on C
(dk-have! g4r-negc
  (lambda ()
    (let* ((x (dk-di-var!)) (nx (g4r-vneg x)))
      (g4r-vm! x) (g4r-vm! nx)
      (dk-have! (g4r-le nx g4r-0)
        (lambda ()
          (subst (dk-cite! 'frm-v-neg-neg 'm x))
          (subst (dk-cite! 'hbs-vzero-l 'm x))
          (dk-ass!)))
      (g4r-apply! (g4r-plb!) nx g4r-0)
      (g4r-ppv! nx)
      (dk-ineq! (list '<= (list 'pp nx) (list 'f g4r-0)) (list '= (list 'f g4r-0) 0)
                (list 'IN (list 'pp nx) 'RR) (list 'IN (list 'f g4r-0) 'RR)))))
;; subadditive
(dk-have! '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m)) (<= (pp ((VADD m) x_ y_)) (+ (pp x_) (pp y_)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (app (cadr (cadr g))) (x (cadr app)) (y (caddr app)) (xy (g4r-vadd x y)) (r12 (list 'pp xy)))
      (g4r-ppv! xy) (g4r-ppv! x) (g4r-ppv! y)
      (dk-have! (g4r-glb-ant y (list '- r12 (list 'pp x)))
        (lambda ()
          (dk-peel!)
          (let* ((w (cadr (caddr (dk-goal)))) (b1 (list '- r12 (list 'f w))))
            (g4r-fv! w)
            (dk-cite! 'rr-sub-in-rr r12 (list 'f w))
            (dk-have! (g4r-glb-ant x b1 'g4rp_)
              (lambda ()
                (dk-peel!)
                (let* ((u (cadr (caddr (dk-goal)))) (uw (g4r-vadd u w)))
                  (g4r-vm! u) (g4r-vm! w)
                  (g4r-flin! u w)
                  (dk-have! (g4r-le xy uw)
                    (lambda ()
                      (subst (dk-cite! 'frm-v-sub-add 'm u w x y))
                      (g4r-ap! g4r-c-add (g4r-sub u x) (g4r-sub w y))
                      (dk-ass!)))
                  (g4r-apply! (g4r-plb!) xy uw)
                  (dk-ineq! (list '<= r12 (list 'f uw)) (list '= (list 'f uw) (list '+ (list 'f u) (list 'f w)))
                            (list 'IN r12 'RR) (list 'IN (list 'f uw) 'RR) (list 'IN (list 'f u) 'RR) (list 'IN (list 'f w) 'RR)))))
            (g4r-apply! (g4r-pglb!) x b1)
            (dk-ineq! (list '<= b1 (list 'pp x)) (list 'IN r12 'RR) (list 'IN (list 'pp x) 'RR) (list 'IN (list 'f w) 'RR)))))
      (dk-cite! 'rr-sub-in-rr r12 (list 'pp x))
      (g4r-apply! (g4r-pglb!) y (list '- r12 (list 'pp x)))
      (dk-ineq! (list '<= (list '- r12 (list 'pp x)) (list 'pp y))
                (list 'IN r12 'RR) (list 'IN (list 'pp x) 'RR) (list 'IN (list 'pp y) 'RR)))))
;; positively homogeneous (<=)
(dk-have! '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (pp ((ACT m) t_ x_)) (* t_ (pp x_))))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (app (cadr (cadr g))) (t (cadr app)) (x (caddr app)) (tx (g4r-act t x))
           (u (dk-skolem! (dk-cite! 'hbs-pos-inv t))))
      (g4r-ppv! tx) (g4r-ppv! x)
      (dk-cite! 'rr-mul-in-rr u (list 'pp tx))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
      (g4r-carr! t)
      (dk-have! (g4r-glb-ant x (list '* u (list 'pp tx)))
        (lambda ()
          (dk-peel!)
          (let* ((w (cadr (caddr (dk-goal)))) (tw (g4r-act t w)))
            (g4r-fv! w) (g4r-vm! w)
            (g4r-ap! g4r-v-act t w)
            (g4r-fv! tw)
            (dk-cite! 'hbs-lf-hom 'm 'v 'f t w)
            (dk-have! (g4r-le tx tw)
              (lambda ()
                (let ((e (dk-cite! 'frm-act-sub-vec 'm t w x)))
                  (subst (list '= (caddr e) (cadr e))))
                (g4r-ap! g4r-c-act t (g4r-sub w x))
                (dk-ass!)))
            (g4r-apply! (g4r-plb!) tx tw)
            (dk-cite! 'rr-mul-in-rr t (list 'f w))
            (dk-have! (list '<= (list 'pp tx) (list '* t (list 'f w)))
              (lambda () (dk-ineq! (list '<= (list 'pp tx) (list 'f tw)) (list '= (list 'f tw) (list '* t (list 'f w)))
                                   (list 'IN (list 'pp tx) 'RR) (list 'IN (list 'f tw) 'RR) (list 'IN (list '* t (list 'f w)) 'RR))))
            (dk-cite! 'hbs-rr-div-le t u (list 'pp tx) (list 'f w))
            (dk-ass!))))
      (g4r-apply! (g4r-pglb!) x (list '* u (list 'pp tx)))
      (dk-cite! 'hbs-rr-mul-back t u (list 'pp tx) (list 'pp x))
      (dk-ass!))))
