    (g4r-apply! (g4r-pglb!) g4r-0 0)
    (dk-ineq! (list '<= (list 'pp g4r-0) (list 'f g4r-0)) (list '= (list 'f g4r-0) 0) (list '<= 0 (list 'pp g4r-0))
              (list 'IN (list 'pp g4r-0) 'RR) (list 'IN (list 'f g4r-0) 'RR))))
