;;; ---- continuity of the resolvent on the resolvent set ---------------------------------------------
(sp (brv-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL u (IMPLIES (IN u CC) (IMPLIES (IS-INVERTIBLE-EL a (SHIFT-EL a u x))
  (FORALL eps (IMPLIES (POS-RR eps)
    (FORSOME del (AND (POS-RR del) (FORALL z (IMPLIES (IN z CC) (IMPLIES (<= (magnitude (+ z (- u))) del)
      (AND (IS-INVERTIBLE-EL a (SHIFT-EL a z x))
           (<= ((VNRM a) ((VADD a) (INVERSE-EL a (SHIFT-EL a z x)) ((VNEG a) (INVERSE-EL a (SHIFT-EL a u x))))) eps))))))))))))))))
(dk-peel!)
(let* ((bu (brv-vt (brv-sh 'u)))
       (del (dk-skolem! (dk-cite! 'inverse-continuous 'a bu 'eps)))
       (hh (or (dk-ctx-form (list 'FORALL 'v (list 'IMPLIES '(IN v (VEC a))
                 (list 'IMPLIES (list '<= (brv-nr (brv-sb bu 'v)) del)
                   (list 'AND '(IS-INVERTIBLE-EL a v)
                         (list '<= (brv-nr (brv-sb (brv-inv bu) (brv-inv 'v))) 'eps))))))
               (error "resolvent-continuous: the inverse-continuous universal did not land"))))
  (ew del)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'POS-RR)
          (dk-ass!)
          (let* ((landed (dk-peel!))
                 (z (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) landed))))
                 (sz (brv-vt (brv-sh z)))
