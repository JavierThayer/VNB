;;; ba-resolvent.scm -- BANACH ALGEBRAS: Proposition 1.6, the resolvent F(z) = (z 1 - x)^(-1).
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 1.
;;; Agent BA-1B, wave 2026-11-09.  Destination: theorem-library/ba-resolvent.scm.
;;; Library: operator-algebras.  All proofs modulo 0.
;;;
;;; WHAT IS PROVEN.  (a) the norm bound ||F(z)|| <= 2 / |z| once |z| >= 2 ||x||, |z| > 0 (the
;;; bound the proof of 1.9 uses); (b) F is continuous on the resolvent set; (c) F is
;;; differentiable in NORM at every point u of the resolvent set, with derivative -F(u)^2, stated
;;; as the remainder estimate ||F(z) - F(u) - (u - z) F(u)^2|| <= eps |z - u| near u; (d) the
;;; Laurent series (3) for |z| > ||x||, in the form F(z) = lim_n z^-1 sum_(k<n) (z^-1 x)^k.
;;; DEVIATIONS.  "Analytic" for an algebra-valued F has no vocabulary in the tree (IS-DIFF-ON is
;;; for K-valued maps), so (c) is the eps-delta statement of norm differentiability.  In (d) the
;;; term is z^-1 (z^-1 x)^k; the textbook's z^-(k+1) x^k needs EL-POW(c x, k) = c^k x^k (an
;;; induction, not done here).
;;;
;;; LOAD WINDOW: after ba-inverse (inverse-continuous, inverse-near-bound), ba-spectrum
;;; (resolvent-identity, bas-shift-diff, bas-shift-type, bas-shift-unfold, bas-act-one,
;;; shift-invertible-outside-ball), ba-neumann (neumann-series, ban-lmul-conv, ban-nsum-type,
;;; ban-sub-sub, ban-mul-sub-right, ban-dist-sym); aif-magnitude-recip (analytic-from-integral),
;;; cc-magnitude-neg, rr-recip-cancel-right, rr-lt-div-of-lt-mul (integral-convergence).
;;; Helper prefix: brv-.

(define (brv-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-resolvent: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-resolvent: unfinished" name))))

