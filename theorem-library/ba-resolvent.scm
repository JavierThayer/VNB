    (cond ((dk-asm? want) x)
          ((equal? x brv-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x brv-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (brv-vt (cadr x)) (brv-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (brv-vt (cadr x)) (brv-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (brv-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (brv-cc! (cadr x)) (brv-vt (caddr x))
           (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'SHIFT-EL))
           (brv-cc! (caddr x)) (brv-vt (cadddr x))
           (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          ((and (pair? x) (eq? (car x) 'NEUMANN-SUM))
           (brv-vt (caddr x))
           (dk-cite! 'ban-nsum-type (cadddr x) 'a (caddr x)) x)
          (#t (error "brv-vt: cannot type" (expression->string x))))))

(define (brv-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((number? t) (dk-real! t) t)
        ((and (pair? t) (memq (car t) '(* +)) (= (length t) 3))
         (brv-rr! (cadr t)) (brv-rr! (caddr t)) (dk-real! t) t)
        ((and (pair? t) (eq? (car t) '-))
         (for-each brv-rr! (cdr t)) (dk-real! t) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (brv-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'magnitude))
         (brv-cc! (cadr t)) (dk-cite! 'cc-magnitude-closed (cadr t)) t)
        (#t (error "brv-rr!: cannot type" (expression->string t)))))

(define (brv-pos-rr! t)          ; with (< 0 t) and (IN t RR) in context, prove the goal (POS-RR t)
  (mac 'pos-rr)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'NOT)
             (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))
            (#t (dk-ineq! (list '< 0 t)))))))

(define (brv-nonzero! t)          ; (< 0 t) in context: land (NOT (= t 0))
  (let ((f (list 'NOT (list '= t 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))))
    f))

;;; z (zr v) = v  when z zr = 1  (rewrites the goal)
(define (brv-cancel! z zr v)
  (brv-pin!)
  (dk-cite! 'rb3-c-act-mul-uba-as-module 'a z zr v)
  (brv-rw! (brv-ac z (brv-ac zr v)) (brv-ac (list '* z zr) v))
  (brv-rw! (list '* z zr) 1)
  (dk-cite! 'bas-act-one 'a v)
  (brv-rw! (brv-ac 1 v) v))

;;; z /= 0 in CC from 0 < |z|
(define (brv-z-nonzero! z)
  (let ((f (list 'NOT (list '= z 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (di)
            (dk-cite! 'cc-magnitude-zero)
            (let* ((h1 (dk-rewrite-h! (list '< 0 (list 'magnitude z)) z 0))
                   (h2 (dk-rewrite-h! h1 '(magnitude 0) 0)))
              (dk-absurd! h2)))))
    f))

;;; z, u in CC typed: land |u - z| = |z - u| in the form (= (magnitude (+ u (- z))) (magnitude (+ z (- u))))
(define (brv-mag-swap! u z)
  (let* ((d (list '+ z (list '- u))) (c (list '+ u (list '- z)))
         (f (list '= (list 'magnitude c) (list 'magnitude d))))
    (if (not (dk-asm? f))
        (begin
          (brv-cc! d) (brv-cc! c) (brv-cc! (list '- d))
          (dk-cite! 'cc-magnitude-neg d)
          (dk-have! (list '= (list '- d) c) (lambda () (crs)))
          (dk-have! f
            (lambda ()
              (brv-rw! c (list '- d))
              (dk-ass!)))))
    f))

