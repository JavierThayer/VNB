        (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        r)))

(define (brv-cc! t)                       ; type a CC term built from + - * recip of typed atoms
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (brv-cc! (cadr t)) (brv-cc! (caddr t)) (brv-cite2! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (brv-cc! (cadr t)) (brv-cc! (caddr t)) (brv-cite2! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (brv-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'recip))
         (brv-cc! (cadr t)) (brv-cite2! 'cc-recip-closed (cadr t)) t)
        ((member t '(0 1)) (dk-cite! (if (equal? t 0) 'cc-zero-in 'cc-one-in)) t)
        (#t (error "brv-cc!: cannot type" (expression->string t)))))

(define (brv-vt x)
