;;; mb4-borel-subspace.scm -- construction of measures, Proposition 5.2: the Borel sets of a subspace are the
;;; traces of the Borel sets (M-B4, 2026-10-26).  Library: measure.  Helper prefixes mbk- (the kit copied from
;;; theorem-library/push-forward.scm, pfw- renamed) and mbs-.
;;;
;;;   mbs-trace-borel        E Borel in X  ==>  E n Y is Borel in the subspace (Y, d)
;;;   mbs-borel-is-trace     B Borel in (Y, d)  ==>  B = E n Y for some E Borel in X
;;;   borel-sets-subspace    (Prop 5.2) B is Borel in (Y, d)  iff  B = E n Y for some Borel E of X
;;;
;;; Load window: after theorem-library/push-forward (pfw-borel-sigma-algebra, pfw-open-borel,
;;; pfw-preimage-sigma-algebra), theorem-library/metric-subspace-laws (subspace-open-trace,
;;; subspace-open-is-trace, subspace-pts) and riesz-markov-model (rmm-nn-choice).

(define (mbk-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (mbk-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (mbk-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed
(define (mbk-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (mbk-map (lambda (c) (mbk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
;;; Proved as ONE conjunction on a lane (never in place: either part may be the focus goal).
(define (mbk-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mbk-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element
(define (mbk-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
;;; w in BIG-UNION(n_, NN, g(n_)) gives the index and w in g(index): returns (k . formula)
(define (mbk-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (w in the k-th term in context)
(define (mbk-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)
(define (mbk-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (mbk-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)
(define (mbk-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mbak_))
         (lam   (list 'VNB-LAMBDA 'mbak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mbak_ (list 'IMPLIES (list 'IN 'mbak_ dom)
                                                    (list '== (list g 'mbak_) body)))))
         (claim (list 'FORSOME 'mbag_ (list 'AND (list 'IN 'mbag_ (list 'FUN dom cod))
                                            (vals 'mbag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "mbk-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "mbk-abstract!: the value equation did not land"))))
      (cons g ve))))


(define (mbk-gens s) (list 'SEP 'mou_ (list 'POWER (list 'PTS s)) (list 'IS-OPEN s 'mou_)))
(define (mbk-gens-sub! s)
  (dk-have! (list 'SUBSET (mbk-gens s) (list 'POWER (list 'PTS s)))
    (lambda () (mac 'subset-def)
      (let ((uv (dk-di-var!)))
        (mbk-sep-parts! (list 'IN uv (mbk-gens s)))
        (ass)))))

;;; =====================================================================
;;; (1) E Borel in X  ==>  E n Y Borel in (Y, d)
;;; =====================================================================
(define mbs-sub '(SUBSPACE-MS s mby_))
(define mbs-h '(VNB-LAMBDA mbx_ mby_ mbx_))
(define (mbs-sepset v) (list 'SEP 'pwx_ 'mby_ (list 'IN (list mbs-h 'pwx_) v)))
(define (mbs-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
;; (= (h w) w) for w in y
(define (mbs-hw! w)
  (let ((e (list '= (list mbs-h w) w)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-close-if! (lambda () (dk-lam-b!)) rfl))))
    e))
;; (= SEPSET(v) (INTERSECTION v y))
(define (mbs-sep-eq! v)
  (let ((lhs (mbs-sepset v)) (rhs (list 'INTERSECTION v 'mby_)))
    (mbk-ext2! lhs rhs
      (lambda (w)
        (mbk-sep-parts! (list 'IN w lhs))
        (mbs-hw! w)
        (dk-rewrite-h! (list 'IN (list mbs-h w) v) (list mbs-h w) w)
        (let ((iff (dk-cite! 'intersection-membership v 'mby_ w)))
          (dk-only! iff (list 'IN w v) (list 'IN w 'mby_))
          (prop)))
      (lambda (w)
        (mbk-iff-parts! (dk-cite! 'intersection-membership v 'mby_ w))
        (in-sep! (lambda () (mbs-hw! w) (subst (list '= (list mbs-h w) w)) (ass)))))
    (list '= lhs rhs)))
(define (mbs-setup!)
  (fact 'ms-pts-is-set 's)
  (fact 'subclass-of-set-is-set 'mby_ '(PTS s))
  (dk-cite! 'subspace-is-metric-space 's 'mby_)
  (dk-cite! 'subspace-pts 's 'mby_))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL mby_ (IMPLIES (SUBSET mby_ (PTS s))
  (FORALL mbe_ (IMPLIES (IN mbe_ (BOREL-SETS s)) (IN (INTERSECTION mbe_ mby_) (BOREL-SETS (SUBSPACE-MS s mby_)))))))))))
(dk-peel!)
(mbs-setup!)
(let* ((sa (dk-cite! 'pfw-borel-sigma-algebra mbs-sub)))
  (dk-rewrite-h! sa (list 'PTS mbs-sub) 'mby_))
(dk-have! (list 'IN mbs-h '(FUN mby_ (PTS s)))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'subset-mem-fwd 'mby_ '(PTS s) x) (mbs-close-open!))))))
(define mbs-dsa (dk-cite! 'pfw-preimage-sigma-algebra 'mby_ (list 'BOREL-SETS mbs-sub) '(PTS s) mbs-h))
(define mbs-D (caddr mbs-dsa))
(mbk-gens-sub! 's)
(dk-have! (list 'SUBSET (mbk-gens 's) mbs-D)
  (lambda ()
    (mac 'subset-def)
    (let ((v (dk-di-var!)))
      (mbk-sep-parts! (list 'IN v (mbk-gens 's)))
      (let ((eqv (mbs-sep-eq! v)))
        (dk-cite! 'subspace-open-trace 's 'mby_ v)
        (dk-cite! 'pfw-open-borel mbs-sub (list 'INTERSECTION v 'mby_))
        (in-sep! (lambda () (subst eqv) (ass)))))))
(dk-cite! 'borel-sets-unfold 's)
(dk-rewrite-h! '(IN mbe_ (BOREL-SETS s)) '(BOREL-SETS s) (list 'SIGMA-GENERATED '(PTS s) (mbk-gens 's)))
(dk-cite! 'sigma-generated-in-every '(PTS s) (mbk-gens 's) 'mbe_ mbs-D)
(mbk-sep-parts! (list 'IN 'mbe_ mbs-D))
(mbs-sep-eq! 'mbe_)
(subst (list '= '(INTERSECTION mbe_ mby_) (mbs-sepset 'mbe_)))
(ass)
(qed 'mbs-trace-borel)
(topic! 'mbs-trace-borel 'analysis)

;;; =====================================================================
;;; (2) B Borel in (Y, d)  ==>  B = E n Y for some Borel E of X
;;; =====================================================================
(define mbs-C '(SEP mbcb_ (POWER mby_) (FORSOME mbe_ (AND (IN mbe_ (BOREL-SETS s)) (= mbcb_ (INTERSECTION mbe_ mby_))))))
(define (mbs-trace-of b) (list 'FORSOME 'mbe_ (list 'AND '(IN mbe_ (BOREL-SETS s)) (list '= b '(INTERSECTION mbe_ mby_)))))
;; x subset Y: (IN x (POWER Y))
(define (mbs-pow! x)
  (let ((g (list 'IN x '(POWER mby_))))
    (if (not (dk-asm? g))
        (begin
          (fact 'subclass-of-set-is-set x 'mby_)
          (dk-have! (list 'FORALL 'mbz_ (list 'IMPLIES (list 'IN 'mbz_ x) '(IN mbz_ mby_)))
            (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd x 'mby_ z) (mbs-close-open!))))
          (mbk-chain-pow! x)))
    g))
(define (mbk-chain-pow! x)
  (let ((ch (dk-fact! 'power-mem-intro 'mby_ x)))
    (if (not (dk-asm? (list 'IN x '(POWER mby_)))) (detach! ch))))
;; x in C from: x subset Y, E Borel, x = E n Y (all in context)
(define (mbs-in-C! x e)
  (mbs-pow! x)
  (dk-have! (list 'IN x mbs-C)
    (lambda () (in-sep! (lambda () (ew e) (dk-conj-close! (lambda () (ass))))))))
;; Borel(s) is a sigma-algebra on X: its three closure facts, landed once
(define (mbs-borel-parts!)
  (let ((sa (dk-cite! 'pfw-borel-sigma-algebra 's)))
    (mbk-iff-parts! (dk-cite! 'is-sigma-algebra '(PTS s) '(BOREL-SETS s)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL mby_ (IMPLIES (SUBSET mby_ (PTS s))
  (FORALL mbb_ (IMPLIES (IN mbb_ (BOREL-SETS (SUBSPACE-MS s mby_)))
    (FORSOME mbe_ (AND (IN mbe_ (BOREL-SETS s)) (= mbb_ (INTERSECTION mbe_ mby_))))))))))))
(dk-peel!)
(mbs-setup!)
(mbs-borel-parts!)
(dk-have! '(SUBSET mby_ mby_) (lambda () (fact 'subset-refl 'mby_) (mbs-close-open!)))
;; C is a sigma-algebra on Y
(let* ((iff (dk-cite! 'is-sigma-algebra 'mby_ mbs-C)) (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ;; C subset POWER(Y)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (let ((x (dk-di-var!))) (mbk-sep-parts! (list 'IN x mbs-C)) (mbs-close-open!)))
              ;; Y in C:  Y = X n Y
              ((and (dk-head-is? g 'IN) (equal? (cadr g) 'mby_))
               (mbk-ext2! 'mby_ '(INTERSECTION (PTS s) mby_)
                 (lambda (w) (fact 'subset-mem-fwd 'mby_ '(PTS s) w)
                   (let ((iff2 (dk-cite! 'intersection-membership '(PTS s) 'mby_ w))) (dk-only! iff2 (list 'IN w '(PTS s)) (list 'IN w 'mby_)) (prop)))
                 (lambda (w) (mbk-iff-parts! (dk-cite! 'intersection-membership '(PTS s) 'mby_ w)) (mbs-close-open!)))
               (mbs-in-C! 'mby_ '(PTS s))
               (mbs-close-open!))
              ;; complements:  Y \ (E n Y) = (X \ E) n Y
              ((and (dk-head-is? g 'FORALL) (dk-contains? g 'COMPLEMENT-IN))
               (let* ((a (dk-di-var!))
                      (_0 (mbk-sep-parts! (list 'IN a mbs-C)))
                      (e (dk-skolem! (mbs-trace-of a)))
                      (_1 (dk-split-all!))
                      (ce (list 'COMPLEMENT-IN '(PTS s) e))
                      (ca (list 'COMPLEMENT-IN 'mby_ a)))
                 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'COMPLEMENT-IN) (dk-contains? f '(BOREL-SETS s)))) "Borel complements") e)
                 (fact 'complement-in-subset a 'mby_)
                 (mbk-ext2! ca (list 'INTERSECTION ce 'mby_)
                   (lambda (w)
                     (mbk-iff-parts! (dk-cite! 'complement-in-membership 'mby_ a w))
                     (fact 'subset-mem-fwd 'mby_ '(PTS s) w)
                     (dk-rewrite-h! (list 'NOT (list 'IN w a)) a (list 'INTERSECTION e 'mby_))
                     (let* ((i1 (dk-cite! 'intersection-membership e 'mby_ w))
                            (i2 (dk-cite! 'intersection-membership ce 'mby_ w))
                            (i3 (dk-cite! 'complement-in-membership '(PTS s) e w)))
                       (dk-only! i1 i2 i3 (list 'IN w 'mby_) (list 'IN w '(PTS s)) (list 'NOT (list 'IN w (list 'INTERSECTION e 'mby_))))
                       (prop)))
                   (lambda (w)
                     (mbk-iff-parts! (dk-cite! 'intersection-membership ce 'mby_ w))
                     (mbk-iff-parts! (dk-cite! 'complement-in-membership '(PTS s) e w))
                     (let* ((i1 (dk-cite! 'intersection-membership e 'mby_ w))
                            (i3 (dk-cite! 'complement-in-membership 'mby_ a w)))
                       (subst (list '= a (list 'INTERSECTION e 'mby_)))
                       (dk-only! i1 (dk-cite! 'complement-in-membership 'mby_ (list 'INTERSECTION e 'mby_) w)
                                 (list 'IN w 'mby_) (list 'NOT (list 'IN w e)))
                       (prop))))
                 (mbs-in-C! ca ce)
                 (mbs-close-open!)))
              ;; countable unions: choose E_k with f(k) = E_k n Y
              (#t
               (let* ((lk (dk-peel!))
                      (f (cadr (car (filter (lambda (x) (and (dk-head-is? x 'IN) (dk-head-is? (caddr x) 'FUN))) lk))))
                      (fam (list 'VNB-LAMBDA 'mbk_ 'NN (list 'SEP 'mbw_ '(BOREL-SETS s) (list '= (list f 'mbk_) '(INTERSECTION mbw_ mby_)))))
                      (bu (list 'BIG-UNION 'n_ 'NN (list f 'n_))))
                 (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'w (list 'AND '(IN w (BOREL-SETS s)) (list 'IN 'w (list fam 'k))))))
                   (lambda ()
                     (let* ((k (dk-di-var!)))
                       (fact 'fun-apply-type-c f 'NN mbs-C k)
                       (mbk-sep-parts! (list 'IN (list f k) mbs-C))
                       (let* ((e (dk-skolem! (mbs-trace-of (list f k)))))
                         (dk-split-all!)
                         (ew e)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (dk-lam-b!) (in-sep! (lambda () (ass)))))))))))
                 (let* ((gg (dk-skolem! (dk-cite! 'rmm-nn-choice '(BOREL-SETS s) fam)))
                        (_2 (dk-split-all!))
                        (gall (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x gg) (dk-contains? x fam))) "the choice"))
                        (gbu (list 'BIG-UNION 'n_ 'NN (list gg 'n_)))
                        (val (lambda (k)        ; f(k) = g(k) n Y, g(k) Borel
                               (fact 'fun-apply-type-c gg 'NN '(BOREL-SETS s) k)
                               (let ((m (dk-apply! gall k)))
                                 (dk-lam-b-h! m)
                                 (mbk-sep-parts! (list 'IN (list gg k) (list 'SEP 'mbw_ '(BOREL-SETS s) (list '= (list f k) '(INTERSECTION mbw_ mby_))))))
                               (list '= (list f k) (list 'INTERSECTION (list gg k) 'mby_)))))
                   (dk-apply! (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'BIG-UNION) (dk-contains? x '(BOREL-SETS s)))) "Borel unions") gg)
                   (mbk-ext2! bu (list 'INTERSECTION gbu 'mby_)
                     (lambda (w)
                       (let* ((ka (mbk-bu-open! w bu)) (k (car ka)) (eqk (val k)))
                         (dk-rewrite-h! (list 'IN w (list f k)) (list f k) (list 'INTERSECTION (list gg k) 'mby_))
                         (mbk-iff-parts! (dk-cite! 'intersection-membership (list gg k) 'mby_ w))
                         (dk-have! (list 'IN w gbu) (lambda () (mbk-bu-close! k)))
                         (let ((i (dk-cite! 'intersection-membership gbu 'mby_ w)))
                           (dk-only! i (list 'IN w gbu) (list 'IN w 'mby_)) (prop))))
                     (lambda (w)
                       (mbk-iff-parts! (dk-cite! 'intersection-membership gbu 'mby_ w))
                       (let* ((ka (mbk-bu-open! w gbu)) (k (car ka)) (eqk (val k)))
                         (dk-have! (list 'IN w (list f k))
                           (lambda ()
                             (subst eqk)
                             (let ((i (dk-cite! 'intersection-membership (list gg k) 'mby_ w)))
                               (dk-only! i (list 'IN w (list gg k)) (list 'IN w 'mby_)) (prop))))
                         (mbk-bu-close! k))))
                   (dk-have! (list 'SUBSET bu 'mby_)
                     (lambda () (mac 'subset-def)
                       (let* ((w (dk-di-var!))
                              (ka (mbk-bu-open! w bu)) (k (car ka)))
                         (fact 'fun-apply-type-c f 'NN mbs-C k)
                         (mbk-sep-parts! (list 'IN (list f k) mbs-C))
                         (fact 'power-mem-in 'mby_ (list f k) w)
                         (mbs-close-open!))))
                   (mbs-in-C! bu gbu)
                   (mbs-close-open!))))))))))
  (dk-have! (list 'IS-SIGMA-ALGEBRA 'mby_ mbs-C) (lambda () (dk-only! iff rhs) (prop))))
;; the open sets of (Y, d) are in C
(define mbs-gens2 (list 'SEP 'mou_ '(POWER mby_) (list 'IS-OPEN mbs-sub 'mou_)))
(dk-have! (list 'SUBSET mbs-gens2 mbs-C)
  (lambda ()
    (mac 'subset-def)
    (let* ((v (dk-di-var!)))
      (mbk-sep-parts! (list 'IN v mbs-gens2))
      (let* ((u (dk-skolem! (dk-cite! 'subspace-open-is-trace 's 'mby_ v))))
        (dk-split-all!)
        (dk-cite! 'pfw-open-borel 's u)
        (mbs-in-C! v u)
        (mbs-close-open!)))))
(dk-cite! 'borel-sets-unfold mbs-sub)
(dk-rewrite-h! (list 'IN 'mbb_ (list 'BOREL-SETS mbs-sub)) (list 'BOREL-SETS mbs-sub) (list 'SIGMA-GENERATED (list 'PTS mbs-sub) (mbk-gens mbs-sub)))
(dk-rewrite-h! (list 'IN 'mbb_ (list 'SIGMA-GENERATED (list 'PTS mbs-sub) (mbk-gens mbs-sub))) (list 'PTS mbs-sub) 'mby_)
(dk-cite! 'sigma-generated-in-every 'mby_ mbs-gens2 'mbb_ mbs-C)
(mbk-sep-parts! (list 'IN 'mbb_ mbs-C))
(ass)
(qed 'mbs-borel-is-trace)
(topic! 'mbs-borel-is-trace 'analysis)

;;; =====================================================================
;;; (3) PROPOSITION 5.2
;;; =====================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL mby_ (IMPLIES (SUBSET mby_ (PTS s))
  (FORALL mbb_ (IFF (IN mbb_ (BOREL-SETS (SUBSPACE-MS s mby_)))
                    (FORSOME mbe_ (AND (IN mbe_ (BOREL-SETS s)) (= mbb_ (INTERSECTION mbe_ mby_))))))))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda () (dk-cite! 'mbs-borel-is-trace 's 'mby_ 'mbb_) (mbs-close-open!))
  (lambda ()
    (let ((e (dk-skolem! (mbs-trace-of 'mbb_))))
      (dk-split-all!)
      (dk-cite! 'mbs-trace-borel 's 'mby_ e)
      (subst (list '= 'mbb_ (list 'INTERSECTION e 'mby_)))
      (ass))))
(qed 'borel-sets-subspace)
(topic! 'borel-sets-subspace 'analysis)
