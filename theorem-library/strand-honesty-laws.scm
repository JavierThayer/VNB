;;; strand-honesty-laws.scm -- HONESTY (Thayer, Herzog, Guttman, ~/docs/jcs_strand_spaces.pdf, section 6.2-6.3):
;;; Theorem 6.11 (ideals generated by atoms are honest), Corollaries 6.12 and 6.13, and Proposition 3.3
;;; re-derived from 6.12 as the paper says ("a special case of this, in which {K} is chosen as S and K is
;;; chosen as k"), on the user's model.  Vocabulary: structure-library/strand-honesty.scm (IS-HONEST) and
;;; structure-library/strand-ideals.scm (SB-1).  Agent SB-2, wave MAP-1026, 2026-10-26.  Destination:
;;; theorem-library/strand-honesty-laws.scm.  Library: strand.  Helper prefix hon-; the trace-reading
;;; helpers are copies of theorem-library/nsl.scm's (section 5), renamed.
;;;
;;; THE ONE CASE ANALYSIS.  adversary-sent-shapes reads the seven adversary traces ONCE: a SENT adversary
;;; node m is (M) on a text trace with its content a known token, or its content is (T) the content of an
;;; earlier node of its strand, (C) a list message every component of which is an earlier node's content,
;;; (S) a component of a list message that is an earlier node's content, (E) an encryption ENCR(h, k) with
;;; k and h earlier contents, (D) a plaintext h with KINV(k) and ENCR(h, k) earlier contents.  (F has no
;;; sent node.)  6.11 and 6.13 are each one case analysis of it.
;;;
;;; LOAD WINDOW: after theorem-library/strand-ideals-laws (SB-1), structure-library/strand-honesty and
;;; theorem-library/nsl (three-strand-node, cited by the trace reader); strand-adversary-bound
;;; (flush-trace-no-sent), strand-space-laws, strand-messages-laws earlier.

;;; -----------------------------------------------------------------------
;;; helpers (prefix nsl-)

(define hon-sp '(ISPACE isp))
(define hon-T '(TOKENS (ISPACE isp)))
(define hon-K '(KEYS (ISPACE isp)))
(define hon-msgs '(MSG-SET (TOKENS (ISPACE isp)) (KEYS (ISPACE isp))))

(define (hon-and fs) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(hon-and (cdr fs)))))
(define (hon-have-and! . fs)
  (let ((c (hon-and fs)))
    (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    c))

;; land CLAIM, a projection of the predicate hypothesis HYP, on a lane (HYP survives)
(define (hon-project! pred hyp claim)
  (dk-have! claim
    (lambda ()
      (mac-h pred hyp)
      (if (not (dk-ass!))
          (begin
            (dk-split-all!)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (error "nsl-project!: not a projection" claim))))))))
  claim)

;; fact THM at ARGS unless its instance is already in context; split what landed
(define (hon-fact-split! thm . args)
  (let ((f (apply dk-cite! thm args)))
    (if (and (pair? f) (eq? (car f) 'AND)) (dk-split-all!))
    f))

;; the index X with (IN X NN), (<= 1 X), (<= X N) in context (N a numeral): run (BODY j) with
;; (= X j) in context, for each j = 1 .. N
(define (hon-index-cases! x n body)
  (let loop ((j 1))
    (if (= j n)
        (begin
          (dk-have! `(= ,x ,n) (lambda () (dk-nn! `(<= ,n ,x) `(<= ,x ,n))))
          (body n))
        (use-em `(= ,x ,j)
          (lambda () (body j))
          (lambda ()
            (dk-have! `(IN ,j NN) (lambda () (arith)))
            (dk-cite! 'nn-le-ne-succ j x)
            (dk-have! `(<= ,(+ j 1) ,x) (lambda () (dk-nn! `(<= (succ ,j) ,x))))
            (loop (+ j 1)))))))

;; the goal a right-nested OR of N disjuncts: select the J-th
(define (hon-select! j n)
  (cond ((= n 1) #t)
        ((= j 1) (oi-l))
        (#t (oi-r) (hon-select! (- j 1) (- n 1)))))


;; with (= (NTH ... ) ...) / (== ...) facts about node contents and directions in context, all
;; NTH-reduced: close a goal (= (NODE-CONTENT sp n) m), (IS-SENT sp n), (IS-RECEIVED sp n), (IN ..)
(define (hon-eq-for lhs)
  (find-first (lambda (f) (and (pair? f) (memq (car f) '(= ==)) (equal? (cadr f) lhs) (equal? (reduce-nth-in-expr (caddr f)) (caddr f))))
              (dk-asms)))
(define (hon-node-closer!)
  (let ((g (dk-goal)))
    (cond ((dk-ass!) #t)
          ((memq (car g) '(IS-SENT IS-RECEIVED))
           (mac (if (eq? (car g) 'IS-SENT) 'is-sent 'is-received))
           (let ((e (hon-eq-for (cadr (dk-goal)))))
             (if (not e) (error "nsl-node-closer!: no direction equation" (dk-goal)))
             (hon-subst-rfl! e)))
          ((eq? (car g) '=)
           (let ((e (hon-eq-for (cadr g))))
             (if (not e) (error "nsl-node-closer!: no content equation" g))
             (hon-subst-rfl! e)))
          (#t (error "nsl-node-closer!: cannot close" g)))))

;; subst E on the focus goal, then rfl when what is left is (= x x)
(define (hon-subst-rfl! e)
  (let ((leaf (proof-state-focus *ps*)))
    (subst e)
    (if (not (sequent-node-grounded? leaf))
        (let ((g (dk-goal)))
          (if (and (pair? g) (memq (car g) '(= ==)) (equal? (cadr g) (caddr g)))
              (rfl)
              (error "nsl-subst-rfl!: not reflexive after the rewrite" g))))))

;; reduce every NTH of a literal inside the context's == / = facts
(define (hon-nth-all!)
  (for-each (lambda (f) (if (and (pair? f) (memq (car f) '(= ==)) (dk-contains? f 'NTH)) (dk-nth-h! f)))
            (dk-asms)))

;; an OR in context, split to its leaves (right-nested); HANDLER gets the disjunct of each leaf
(define (hon-or-each! o handler)
  (if (not (dk-head-is? o 'OR))
      (handler o)
  (dk-each-leaf! (lambda () (ai o))
    (lambda ()
      (cond ((dk-asm? (cadr o)) (handler (cadr o)))
            ((and (pair? (caddr o)) (eq? (car (caddr o)) 'OR)) (hon-or-each! (caddr o) handler))
            (#t (handler (caddr o))))))))

;; subst E on the focus goal, then `ass' when the leaf is still open
(define (hon-subst-ass! e)
  (let ((leaf (proof-state-focus *ps*)))
    (subst e)
    (if (not (sequent-node-grounded? leaf))
        (if (not (dk-ass!)) (error "nsl-subst-ass!: the rewritten goal is not in context" (dk-goal))))))


;; land (IN TERM SET) from a typing in context, through LST / ENCR
(define (hon-set! t)
  (let ((goal `(IN ,t SET)))
    (cond ((dk-asm? goal) goal)
          ((find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) t) (not (eq? (caddr f) 'SET)))) (dk-asms))
           => (lambda (ty) (fact 'membership-implies-sethood t (caddr ty)) goal))
          ((dk-head-is? t 'LST)
           (hon-set! (cadr t))
           (fact 'lst-in-tuples-set (cadr t))
           (fact 'membership-implies-sethood t '(TUPLES SET))
           goal)
          ((dk-head-is? t 'ENCR)
           (hon-set! (cadr t)) (hon-set! (caddr t))
           (fact 'encr-in-tuples-set (cadr t) (caddr t))
           (fact 'membership-implies-sethood t '(TUPLES SET))
           goal)
          (#t (error "nsl-set!: no typing for" t)))))

;; W in T (in context) and (= W TERM) in context (either orientation), TERM an encryption or a
;; list message: absurd (the token law; TERM may contain W, so no rewriting)
(define (hon-token-eq-absurd! w term)
  (if (not (dk-asm? `(= ,w ,term))) (dk-have! `(= ,w ,term) (lambda () (hon-subst-rfl! `(= ,term ,w)))))
  (cond ((dk-head-is? term 'ENCR)
         (hon-set! (cadr term)) (hon-set! (caddr term))
         (ai (dk-cite! 'encr-ne-token hon-T w (cadr term) (caddr term))))
        (#t
         (hon-set! (cadr term))
         (ai (dk-cite! 'token-ne-list hon-T w (cadr term))))))

(define hon-asp '(ISPACE isp))
(define hon-aT '(TOKENS (ISPACE isp)))
(define hon-aK '(KEYS (ISPACE isp)))
(define hon-aM '(MSG-SET (TOKENS (ISPACE isp)) (KEYS (ISPACE isp))))
(define (hon-sg n) `((STRAND-MAP (ISPACE isp)) (NTH 2 ,n)))

;; IS-SENT asp N in context and (== (NODE-DIR asp N) RECEIVED): close the focus goal
(define (hon-recv-absurd! n)
  (dk-have! `(= (NODE-DIR ,hon-asp ,n) SENT) (lambda () (mac-h 'is-sent `(IS-SENT ,hon-asp ,n)) (dk-ass!)))
  (dk-have! '(= SENT RECEIVED)
    (lambda () (subst `(= SENT (NODE-DIR ,hon-asp ,n))) (hon-subst-rfl! `(= (NODE-DIR ,hon-asp ,n) RECEIVED))))
  (ai (dk-cite! 'sent-ne-received)))

;; contradictory NN premises: close the focus goal
(define (hon-nn-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-nn! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

;; the infiltrated space isp and the adversary node M: land the space's parts, M's parts, and
;; return the disjunction of the seven trace kinds of M's strand
(define (hon-adv-setup! m)
  (let ((h '(IS-INFILTRATED-SPACE isp)))
    (hon-project! 'is-infiltrated-space h `(IS-STRAND-SPACE ,hon-asp))
    (hon-project! 'is-infiltrated-space h `(FORALL sat_ (IMPLIES (IN sat_ (ADV-TOKENS isp)) (IN sat_ ,hon-aT))))
    (hon-fact-split! 'strand-space-parts hon-asp)
    (hon-fact-split! 'node-parts hon-asp m)
    (fact 'strand-at-id hon-asp `(NTH 2 ,m))
    (fact 'length-in-nn `(DIRECTED ,hon-aT ,hon-aK) (hon-sg m))
    (hon-project! 'is-adversary-node `(IS-ADVERSARY-NODE isp ,m) `(IN (NTH 2 ,m) (ADV-IDS isp)))
    (let* ((law (hon-project! 'is-infiltrated-space h
                  `(FORALL sap_ (IMPLIES (IN sap_ (ADV-IDS isp))
                     (IS-ADVERSARY-TRACE ,hon-asp (ADV-TOKENS isp) ((STRAND-MAP ,hon-asp) sap_))))))
           (tr (dk-apply! law `(NTH 2 ,m))))
      (mac-h 'is-adversary-trace tr)
      (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'IS-TEXT-TRACE))) "the seven kinds"))))

;; open the same-strand order X ==> M (kept), with X's parts
(define (hon-ssb-open! x m)
  (hon-project! 'same-strand-before `(SAME-STRAND-BEFORE ,hon-asp ,x ,m)
    `(AND (IN ,x (NODES ,hon-asp)) (AND (IN ,m (NODES ,hon-asp)) (AND (= (NTH 2 ,x) (NTH 2 ,m)) (< (NTH 1 ,x) (NTH 1 ,m))))))
  (dk-split-all!)
  (hon-fact-split! 'node-parts hon-asp x))

;; the node N = [J, NTH(2, M)] (J a term with (IN J NN), (<= 1 J), (<= J (LENGTH sigma)) in
;; context): land N in NODES and N ==> M, given (< J (NTH 1 M)) provable by dk-nn! from PREMS
(define (hon-earlier! j m . prems)
  (let ((n `(LIST ,j (NTH 2 ,m))))
    (fact 'node-intro hon-asp j `(NTH 2 ,m))
    (dk-have! `(SAME-STRAND-BEFORE ,hon-asp ,n ,m)
      (lambda ()
        (mac 'same-strand-before)
        (nth-r)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  ((dk-head-is? (dk-goal) '=) (rfl))
                  (#t (apply dk-nn! prems)))))))
    n))

;; the entry D at index K of the strand of M: with (= (NTH K sigma(NTH 2 M)) D) in context and
;; N = M, or N = [K, NTH(2, M)], or N with (= (NTH 2 N) (NTH 2 M)) and (= (NTH 1 N) K) in context:
;; land N's content and direction, reduced; return the content
(define (hon-entry! n k d m)
  (let ((mver `(= (NTH ,k ,(hon-sg m)) ,d))
        (nver `(= (NTH ,k ,(hon-sg n)) ,d)))
    (if (not (dk-asm? mver)) (error "nsl-entry!: the entry is not in context" mver))
    (cond ((dk-asm? nver) #t)
          ((and (pair? n) (eq? (car n) 'LIST)) (dk-have! nver (lambda () (nth-r) (dk-ass!))))
          (#t (dk-rewrite-h! mver `(NTH 2 ,m) `(NTH 2 ,n))))
    (if (not (dk-asm? `(= (NTH 1 ,n) ,k)))
        (dk-have! `(= (NTH 1 ,n) ,k) (lambda () (if (not (equal? k `(NTH 1 ,n))) (nth-r)) (rfl))))
    (fact 'node-content-eq hon-asp n k d)
    (dk-split-all!)
    (hon-nth-all!)
    (hon-content n)))

;; a literal trace LIT of three entries for M's strand ((= sigma(NTH 2 M) LIT) in context): the
;; node N of that strand (N in NODES, NTH 2 N = NTH 2 M) is at index j = 1, 2, 3: HANDLER gets j
;; with N's reduced content and direction in context
(define (hon-lit3-cases! n m lit handler)
  (if (not (equal? n m))
      (dk-rewrite-h! `(= ,(hon-sg m) ,lit) `(NTH 2 ,m) `(NTH 2 ,n)))
  (hon-or-each! (dk-cite! 'three-strand-node hon-asp n (cadr lit) (caddr lit) (cadddr lit))
    (lambda (d)
      (dk-split-all!)
      (hon-nth-all!)
      (handler (caddr (cadr d))))))

(define (hon-content n) (caddr (hon-eq-for `(NODE-CONTENT ,hon-asp ,n))))
(define (hon-content-sp n) (caddr (hon-eq-for `(NODE-CONTENT (ISPACE (PK-INF nsp)) ,n))))

;; W (an encryption) is a subterm of the TOKEN TK (in the space's T): absurd.  HYP is
;; (IS-SUBTERM aT aK W TK) in context.
(define (hon-encr-in-token-absurd! w tk)
  (if (not (dk-asm? `(IN ,tk ,hon-aT))) (error "nsl-encr-in-token-absurd!: the token is not typed" tk))
  (fact 'subterm-of-token hon-aT hon-aK w tk)                ; (= W TK)
  (dk-rewrite-h! `(IN ,tk ,hon-aT) tk w)
  (hon-set! (cadr w)) (hon-set! (caddr w))
  (ai (dk-cite! 'token-not-encr hon-aT (cadr w) (caddr w))))

;; land (IN ((KINV asp) K0) T) and in K
(define (hon-kinv-typed! k0)
  (fact 'kinv-in-fun hon-asp)
  (fact 'fun-apply-type-c `(KINV ,hon-asp) hon-aK hon-aK k0)
  (dk-apply! (dk-cite! 'keys-in-tokens hon-asp) `((KINV ,hon-asp) ,k0)))

;; the two literal-entry facts (= (LENGTH sigma) n) and (= (NTH j sigma) dj) from (= sigma LIT)
(define (hon-lit-facts! m lit)
  (let ((sg (hon-sg m)) (n (length (cdr lit))))
    (dk-have! `(= (LENGTH ,sg) ,n) (lambda () (subst `(= ,sg ,lit)) (len-r) (rfl)))
    (let loop ((j 1))
      (if (<= j n)
          (begin
            (dk-have! `(= (NTH ,j ,sg) ,(list-ref lit j)) (lambda () (subst `(= ,sg ,lit)) (nth-r) (rfl)))
            (loop (+ j 1)))))))

;; skolemise the trace predicate's existentials in order; return the witnesses
(define (hon-trace-witnesses! d count)
  (let loop ((i 0) (ex d) (acc '()))
    (if (= i count)
        (reverse acc)
        (let* ((v (dk-skolem! ex))
               (nx (if (< (+ i 1) count)
                       (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f v))) "the next witness")
                       #f)))
          (loop (+ i 1) nx (cons v acc))))))

;; the S trace, node x: at 1 (the list) or at succ j (a component): either way W @ LST(l)

;; the S trace: the list L, its received node at 1, the sent node M at succ q; returns q
(define (hon-sep-sent-index! l)
  (let* ((sg (hon-sg 'm))
         (q (dk-skolem! (dk-cite! 'nn-pos-is-succ '(NTH 1 m)))))
    (dk-have! `(NOT (= ,q 0))
      (lambda ()
        (di)
        (dk-have! '(= (NTH 1 m) 1) (lambda () (subst `(= (NTH 1 m) (succ ,q))) (subst `(= ,q 0)) (arith)))
        (ai '(NOT (= (NTH 1 m) 1)))))
    (fact 'nn-zero-in)
    (fact 'nn-zero-le q)
    (fact 'nn-le-ne-succ 0 q)
    (dk-have! `(<= 1 ,q) (lambda () (dk-nn! `(<= (succ 0) ,q))))
    (dk-have! `(<= ,q (LENGTH ,l))
      (lambda () (dk-nn! `(<= (NTH 1 m) (LENGTH ,sg)) `(= (LENGTH ,sg) (succ (LENGTH ,l))) `(= (NTH 1 m) (succ ,q)))))
    q))


(define (hon-num-index! j m)
  (let* ((sg (hon-sg m))
         (leq (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `(LENGTH ,sg)) (number? (caddr f)))) (dk-asms))))
    (dk-have! `(IN ,j NN) (lambda () (arith)))
    (dk-have! `(<= 1 ,j) (lambda () (dk-nn!)))
    (dk-have! `(<= ,j (LENGTH ,sg)) (lambda () (subst leq) (arith)))))


;;; -----------------------------------------------------------------------
;;; Statement builders and closers.

(define hon-cm `(NODE-CONTENT ,hon-asp m))
(define (hon-cx x) `(NODE-CONTENT ,hon-asp ,x))
(define (hon-earlier-with t)
  `(FORSOME x (AND (SAME-STRAND-BEFORE ,hon-asp x m) (= (NODE-CONTENT ,hon-asp x) ,t))))
(define hon-shapes
  `(OR (AND (IS-TEXT-TRACE ,hon-asp (ADV-TOKENS isp) ,(hon-sg 'm)) (IN ,hon-cm (ADV-TOKENS isp)))
   (OR (FORSOME x (AND (SAME-STRAND-BEFORE ,hon-asp x m) (= (NODE-CONTENT ,hon-asp x) ,hon-cm)))
   (OR (FORSOME l (AND (IN l (TUPLES ,hon-aM)) (AND (= ,hon-cm (LST l))
         (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l)) ,(hon-earlier-with '(NTH i l)))))))))
   (OR (FORSOME l (AND (IN l (TUPLES ,hon-aM)) (FORSOME q (AND (IN q NN) (AND (<= 1 q) (AND (<= q (LENGTH l))
         (AND (= ,hon-cm (NTH q l)) ,(hon-earlier-with '(LST l)))))))))
   (OR (FORSOME h (AND (IN h ,hon-aM) (FORSOME k (AND (IN k ,hon-aK) (AND (= ,hon-cm (ENCR h k))
         (AND ,(hon-earlier-with 'k) ,(hon-earlier-with 'h)))))))
       (FORSOME h (AND (IN h ,hon-aM) (FORSOME k (AND (IN k ,hon-aK) (AND (= ,hon-cm h)
         (AND ,(hon-earlier-with `((KINV ,hon-asp) k)) ,(hon-earlier-with '(ENCR h k))))))))))))))

;; the goal (= A B): rewrite each side by its reduced content equation in context, then rfl
(define (hon-eq-close!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (dk-ass!))
        (begin
          (let ((e (hon-eq-for (cadr (dk-goal))))) (if e (subst e)))
          (if (not (sequent-node-grounded? leaf))
              (let ((e (hon-eq-for (caddr (dk-goal))))) (if e (subst e))))
          (if (not (sequent-node-grounded? leaf))
              (let ((g (dk-goal)))
                (cond ((dk-ass!) #t)
                      ((equal? (cadr g) (caddr g)) (rfl))
                      (#t (error "hon-eq-close!: open" g)))))))))

;; close a FORSOME / AND tower with the witnesses WS, in order of appearance
(define (hon-fill! ws)
  (let ((rest ws))
    (let walk ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'FORSOME)
               (if (null? rest) (error "hon-fill!: out of witnesses at" g))
               (ew (car rest)) (set! rest (cdr rest)) (walk))
              ((dk-head-is? g 'AND) (dk-conj-close! walk))
              ((dk-ass!) #t)
              ((dk-head-is? g '=) (hon-eq-close!))
              (#t (error "hon-fill!: cannot close" g)))))))

;;; -----------------------------------------------------------------------
;;; THE SHAPES OF A SENT ADVERSARY NODE.

(sp (make-wff `(FORALL isp (FORALL m (IMPLIES (IS-INFILTRATED-SPACE isp) (IMPLIES (IN m (NODES ,hon-asp))
  (IMPLIES (IS-ADVERSARY-NODE isp m) (IMPLIES (IS-SENT ,hon-asp m) ,hon-shapes))))))))
(dk-peel!)
(let ((kinds (hon-adv-setup! 'm))
      (sg (hon-sg 'm)))
  (hon-or-each! kinds
    (lambda (d)
      (case (car d)
        ((IS-TEXT-TRACE)
         (let* ((body `(FORSOME saa_ (AND (IN saa_ (ADV-TOKENS isp)) (= ,sg (LIST (LIST SENT saa_))))))
                (a (begin (hon-project! 'is-text-trace d body) (car (hon-trace-witnesses! body 1))))
                (lit `(LIST (LIST SENT ,a))))
           (hon-lit-facts! 'm lit)
           (dk-rewrite-h! `(<= (NTH 1 m) (LENGTH ,sg)) `(LENGTH ,sg) 1)
           (dk-have! '(= (NTH 1 m) 1) (lambda () (dk-nn! '(<= 1 (NTH 1 m)) '(<= (NTH 1 m) 1))))
           (hon-entry! 'm 1 (cadr lit) 'm)
           (hon-select! 1 6)
           (dk-conj-close!
             (lambda ()
               (if (not (dk-ass!))
                   (hon-subst-ass! (hon-eq-for hon-cm)))))))
        ((IS-FLUSH-TRACE) (ai (dk-cite! 'flush-trace-no-sent hon-asp 'm)))
        ((IS-TEE-TRACE)
         (mac-h 'is-tee-trace d)
         (let* ((g0 (car (hon-trace-witnesses! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the message") 1)))
                (lit `(LIST (LIST RECEIVED ,g0) (LIST SENT ,g0) (LIST SENT ,g0))))
           (hon-lit-facts! 'm lit)
           (hon-lit3-cases! 'm 'm lit
             (lambda (jm)
               (if (= jm 1)
                   (hon-recv-absurd! 'm)
                   (begin
                     (hon-num-index! 1 'm)
                     (let ((n1 (hon-earlier! 1 'm `(= (NTH 1 m) ,jm))))
                       (hon-entry! n1 1 (cadr lit) 'm)
                       (hon-select! 2 6)
                       (hon-fill! (list n1)))))))))
        ((IS-ENCRYPT-TRACE IS-DECRYPT-TRACE)
         (let ((enc? (eq? (car d) 'IS-ENCRYPT-TRACE)))
           (mac-h (if enc? 'is-encrypt-trace 'is-decrypt-trace) d)
           (let* ((ws (hon-trace-witnesses! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the key") 2))
                  (k0 (car ws)) (h0 (cadr ws))
                  (lit (if enc?
                           `(LIST (LIST RECEIVED ,k0) (LIST RECEIVED ,h0) (LIST SENT (ENCR ,h0 ,k0)))
                           `(LIST (LIST RECEIVED ((KINV ,hon-asp) ,k0)) (LIST RECEIVED (ENCR ,h0 ,k0)) (LIST SENT ,h0)))))
             (fact 'encr-in-msgs hon-aT hon-aK h0 k0)
             (if (not enc?) (hon-kinv-typed! k0))
             (hon-lit-facts! 'm lit)
             (hon-lit3-cases! 'm 'm lit
               (lambda (jm)
                 (if (< jm 3)
                     (hon-recv-absurd! 'm)
                     (begin
                       (hon-num-index! 1 'm)
                       (hon-num-index! 2 'm)
                       (let* ((n1 (hon-earlier! 1 'm '(= (NTH 1 m) 3)))
                              (n2 (hon-earlier! 2 'm '(= (NTH 1 m) 3))))
                         (hon-entry! n1 1 (cadr lit) 'm)
                         (hon-entry! n2 2 (caddr lit) 'm)
                         (hon-select! (if enc? 5 6) 6)
                         (hon-fill! (list h0 k0 n1 n2))))))))))
        ((IS-SEPARATE-TRACE)
         (mac-h 'is-separate-trace d)
         (let* ((l (car (hon-trace-witnesses! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the list") 1)))
                (len `(LENGTH ,l))
                (univ (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SENT) (dk-contains? f l))) "the sent entries"))
                (d1 `(LIST RECEIVED (LST ,l))))
           (fact 'length-in-nn hon-aM l)
           (fact 'list-in-msgs hon-aT hon-aK l)
           (use-em '(= (NTH 1 m) 1)
             (lambda () (hon-entry! 'm 1 d1 'm) (hon-recv-absurd! 'm))
             (lambda ()
               (let ((q (hon-sep-sent-index! l)))
                 (dk-apply! univ q)
                 (hon-entry! 'm `(succ ,q) `(LIST SENT (NTH ,q ,l)) 'm)
                 (dk-have! '(<= 1 1) (lambda () (dk-nn!)))
                 (dk-have! `(<= 1 (LENGTH ,sg)) (lambda () (dk-nn! `(= (LENGTH ,sg) (succ ,len)))))
                 (fact 'nn-one-in)
                 (let ((n1 (hon-earlier! 1 'm `(= (NTH 1 m) (succ ,q)) `(<= 1 ,q))))
                   (hon-entry! n1 1 d1 'm)
                   (hon-have-and! `(IN ,q NN) `(IN ,l (TUPLES ,hon-aM)) `(<= 1 ,q) `(<= ,q ,len))
                   (fact 'nth-in-range hon-aM q l)
                   (hon-select! 4 6)
                   (hon-fill! (list l q n1))))))))
        ((IS-CONCAT-TRACE)
         (mac-h 'is-concat-trace d)
         (let* ((l (car (hon-trace-witnesses! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the list") 1)))
                (len `(LENGTH ,l))
                (univ (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RECEIVED))) "the received entries")))
           (fact 'length-in-nn hon-aM l)
           (dk-have! `(<= (NTH 1 m) (succ ,len))
             (lambda () (dk-nn! `(<= (NTH 1 m) (LENGTH ,sg)) `(= (LENGTH ,sg) (succ ,len)))))
           (hon-or-each! (dk-cite! 'nn-le-succ-cases len '(NTH 1 m))
             (lambda (e)
               (if (dk-head-is? e '<=)
                   (begin
                     (dk-apply! univ '(NTH 1 m))
                     (hon-entry! 'm '(NTH 1 m) `(LIST RECEIVED (NTH (NTH 1 m) ,l)) 'm)
                     (hon-recv-absurd! 'm))
                   (begin
                     (hon-entry! 'm `(succ ,len) `(LIST SENT (LST ,l)) 'm)
                     (fact 'list-in-msgs hon-aT hon-aK l)
                     (hon-select! 3 6)
                     (ew l)
                     (dk-conj-close!
                       (lambda ()
                         (cond ((dk-ass!) #t)
                               ((dk-head-is? (dk-goal) '=) (hon-eq-close!))
                               (#t
                                (let* ((landed (dk-peel!))
                                       (i (cadr (car landed))))
                                  (dk-have! `(<= ,i (LENGTH ,sg)) (lambda () (dk-nn! `(<= ,i ,len) `(= (LENGTH ,sg) (succ ,len)))))
                                  (dk-apply! univ i)
                                  (let ((ni (hon-earlier! i 'm `(<= ,i ,len) `(= (NTH 1 m) (succ ,len)))))
                                    (hon-entry! ni i `(LIST RECEIVED (NTH ,i ,l)) 'm)
                                    (hon-have-and! `(IN ,i NN) `(IN ,l (TUPLES ,hon-aM)) `(<= 1 ,i) `(<= ,i ,len))
                                    (fact 'nth-in-range hon-aM i l)
                                    (hon-fill! (list ni))))))))))))))
        (else (error "adversary-sent-shapes: an unexpected kind" (car d)))))))
(qed 'adversary-sent-shapes)

;;; -----------------------------------------------------------------------
;;; IDEALS GENERATED BY ATOMS (S a set of tokens; keys are tokens on this model).

(define (hon-keep-prop! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? node)) (prop))))

;; the body of IS-KEY-IDEAL(tt, kk, ks, j), with the definition's binders (structure-library/strand-ideals)
(define (hon-ideal-body tt kk ks j)
  `(AND (FORALL sbix_ (IMPLIES (IN sbix_ ,j) (IN sbix_ (MSG-SET ,tt ,kk))))
   (AND (FORALL sbil_ (FORALL sbij_
          (IMPLIES (IN sbil_ (TUPLES (MSG-SET ,tt ,kk)))
           (IMPLIES (IN sbij_ NN)
            (IMPLIES (<= 1 sbij_)
             (IMPLIES (<= sbij_ (LENGTH sbil_))
              (IMPLIES (IN (NTH sbij_ sbil_) ,j)
                       (IN (LST sbil_) ,j))))))))
        (FORALL sbih_ (FORALL sbiy_
          (IMPLIES (IN sbih_ ,j)
           (IMPLIES (IN sbiy_ ,ks)
                    (IN (ENCR sbih_ sbiy_) ,j))))))))
(define (hon-ideal-parts! tt kk ks j)
  (let* ((hyp `(IS-KEY-IDEAL ,tt ,kk ,ks ,j))
         (body (hon-ideal-body tt kk ks j))
         (parts (list (cadr body) (cadr (caddr body)) (caddr (caddr body)))))
    (for-each (lambda (c)
                (dk-have! c (lambda () (fact 'is-key-ideal tt kk ks j) (hon-keep-prop! (iff-for hyp) hyp))))
              parts)
    parts))

;;; A token is a simple message.
(sp (make-wff '(FORALL T (FORALL K (FORALL S (IMPLIES (IS-TOKEN-SET T) (IMPLIES (IN K SET)
  (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z T)))
    (FORALL u (IMPLIES (IN u S) (IS-SIMPLE-MSG T K u)))))))))))
(let* ((landed (dk-peel!))
       (sub (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
       (u (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'S))) "u in S"))))
  (dk-apply! sub u)
  (fact 'token-set-is-set 'T)
  (fact 'msg-set-is-set 'T 'K)
  (mac 'is-simple-msg)
  (di)
  (let ((l (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the list"))))
    (dk-have! `(AND (IN (MSG-SET T K) SET) (IN ,l (TUPLES (MSG-SET T K)))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (fact 'list-sethood '(MSG-SET T K) l)
    (ai (dk-cite! 'token-ne-list 'T u l))))
(qed 'tokens-are-simple)

;;; PROPOSITION 6.6 FOR IDEALS OF ATOMS: decryption stays in I_k[S] when S is a set of tokens.  (6.6 as the
;;; paper states it, key-ideal-gen-decrypt, asks "no s in S is {g}_K" for EVERY g; for a token s that needs
;;; g to be a set, which no lemma of the tree reads off an equation s = ENCR(g, K).  Here the plaintext is a
;;; message, which is all 6.11 uses.)
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL h (FORALL y
   (IMPLIES (IS-TOKEN-SET T) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z T)))
      (IMPLIES (IN h (MSG-SET T K)) (IMPLIES (IN y K)
       (IMPLIES (IN (ENCR h y) (KEY-IDEAL-GEN T K ks S))
                (IN h (KEY-IDEAL-GEN T K ks S)))))))))))))))))
(let* ((landed (dk-peel!))
       (subT (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'S))) landed))
       (e '(ENCR h y)))
  (fact 'token-set-is-set 'T)
  (dk-have! '(FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (dk-apply! subT z)
        (fact 'token-in-msgs 'T 'K z)
        (dk-ass!))))
  (fact 'membership-implies-sethood 'h '(MSG-SET T K))
  (fact 'membership-implies-sethood 'y 'K)
  (let* ((o (dk-cite! 'key-ideal-gen-cases 'T 'K 'ks 'S e))
         (d1 (cadr o)) (d2 (cadr (caddr o))))
    (hon-or-each! o
      (lambda (d)
        (cond ((equal? d d1)
               (dk-apply! subT e)
               (ai (dk-cite! 'token-not-encr 'T 'h 'y)))
              ((equal? d d2)
               (let ((l (dk-skolem! d)))
                 (fact 'encr-ne-list 'h 'y l)
                 (hon-keep-prop! `(= ,e (LST ,l)) `(NOT (= ,e (LST ,l))))))
              (#t
               (let* ((h1 (dk-skolem! d))
                      (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
                      (y1 (dk-skolem! ex)))
                 (fact 'encr-injective 'h 'y h1 y1)
                 (dk-split-all!)
                 (subst `(= h ,h1))
                 (dk-ass!))))))))
(qed 'key-ideal-gen-decrypt-atoms)

;;; -----------------------------------------------------------------------
;;; THEOREM 6.11: ideals generated by atoms are honest.

(define (hon-G ks s) `(KEY-IDEAL-GEN ,hon-aT ,hon-aK ,ks ,s))
(define hon-H-611
  `((IS-INFILTRATED-SPACE isp) (IS-BUNDLE c) (= (BSPACE c) ,hon-asp)
    (FORALL y (IMPLIES (IN y ks) (IN y ,hon-aK)))
    (FORALL y (IMPLIES (IN y ,hon-aK) (OR (IN y S) (IN ((KINV ,hon-asp) y) ks))))))
(define (hon-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))

;; the FORSOME x (SSB x p and content(x) = T) among the context's: skolemise it, return x
(define (hon-earlier-of! t)
  (let ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'SAME-STRAND-BEFORE)
                                      (equal? (caddr (caddr (caddr f))) t)))
                     "the earlier node")))
    (dk-skolem! ex)))

;; the space's parts, S inside A, G a KS-ideal; returns the ideal's three clauses
(define (hon-ideal-setup! ks s)
  (hon-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE isp) `(IS-STRAND-SPACE ,hon-asp))
  (hon-fact-split! 'strand-space-parts hon-asp)
  (let ((subT `(FORALL z (IMPLIES (IN z ,s) (IN z ,hon-aT)))))
    (if (not (dk-asm? subT)) (error "hon-ideal-setup!: S inside T is not in context"))
    (dk-have! `(FORALL z (IMPLIES (IN z ,s) (IN z ,hon-aM)))
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (dk-apply! subT z)
          (fact 'token-in-msgs hon-aT hon-aK z)
          (dk-ass!)))))
  (fact 'key-ideal-gen-is-ideal hon-aT hon-aK ks s)
  (hon-ideal-parts! hon-aT hon-aK ks (hon-G ks s)))

(sp (make-wff `(FORALL isp (FORALL c (FORALL ks (FORALL S
  ,(hon-curry (append hon-H-611 (list `(FORALL z (IMPLIES (IN z S) (IN z ,hon-aT)))))
     `(IS-HONEST isp c ,(hon-G 'ks 'S)))))))))
(dk-peel!)
(let* ((g (hon-G 'ks 'S))
       (parts (hon-ideal-setup! 'ks 'S))
       (cover (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'KINV))) "the key cover")))
  (fact 'tokens-are-simple hon-aT hon-aK 'S)
  (mac 'is-honest)
  (let* ((landed (dk-peel!))
         (p (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) landed)))
         (cp (hon-cx p))
         (ep `(IS-ENTRY-POINT ,hon-asp ,p ,g))
         (univ `(FORALL ssm_ (IMPLIES (SAME-STRAND-BEFORE ,hon-asp ssm_ ,p) (NOT (IN (NODE-CONTENT ,hon-asp ssm_) ,g))))))
    (hon-project! 'is-entry-point ep
      `(AND (IN ,p (NODES ,hon-asp)) (AND (IS-SENT ,hon-asp ,p) (AND (IN ,cp ,g) ,univ))))
    (dk-split-all!)
    (let ((contra! (lambda (x) (ai (dk-apply! univ x)))))
      (hon-or-each! (dk-cite! 'adversary-sent-shapes 'isp p)
        (lambda (d)
          (cond
            ((dk-head-is? d 'AND) (dk-split-all!) (dk-ass!))
            ((and (dk-head-is? d 'FORSOME) (dk-head-is? (caddr d) 'AND) (dk-head-is? (cadr (caddr d)) 'SAME-STRAND-BEFORE))
             ;; T: an earlier node has p's content
             (let ((x (dk-skolem! d)))
               (dk-rewrite-h! `(IN ,cp ,g) cp (hon-cx x))
               (contra! x)))
            ((dk-contains? d 'KINV)
             ;; D: p's content h is in I; KINV(k) in S, or k in KS and ENCR(h, k) in I
             (let* ((h (dk-skolem! d))
                    (k (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h))) "the key")))
                    (kv `((KINV ,hon-asp) ,k))
                    (x1 (hon-earlier-of! kv))
                    (x2 (hon-earlier-of! `(ENCR ,h ,k))))
               (dk-rewrite-h! `(IN ,cp ,g) cp h)
               (hon-kinv-typed! k)
               (hon-or-each! (dk-apply! cover kv)
                 (lambda (e)
                   (if (equal? (caddr e) 'S)
                       (begin
                         (fact 'token-in-msgs hon-aT hon-aK kv)
                         (fact 'key-ideal-gen-contains hon-aT hon-aK 'ks 'S kv)
                         (dk-rewrite-h! `(IN ,kv ,g) kv (hon-cx x1))
                         (contra! x1))
                       (begin
                         (dk-apply! (dk-cite! 'kinv-involution hon-asp) k)
                         (dk-rewrite-h! e `((KINV ,hon-asp) ,kv) k)
                         (dk-apply! (caddr parts) h k)
                         (dk-rewrite-h! `(IN (ENCR ,h ,k) ,g) `(ENCR ,h ,k) (hon-cx x2))
                         (contra! x2)))))))
            ((dk-contains? d 'ENCR)
             ;; E: p's content ENCR(h, k) is in I, so h is, and h is an earlier content
             (let* ((h (dk-skolem! d))
                    (k (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h))) "the key")))
                    (x1 (hon-earlier-of! k))
                    (x2 (hon-earlier-of! h)))
               (dk-rewrite-h! `(IN ,cp ,g) cp `(ENCR ,h ,k))
               (dk-cite! 'key-ideal-gen-decrypt-atoms hon-aT hon-aK 'ks 'S h k)
               (dk-rewrite-h! `(IN ,h ,g) h (hon-cx x2))
               (contra! x2)))
            ((dk-contains? d 'FORALL)
             ;; C: p's content LST(l) is in I, so a component is (6.8), and it is an earlier content
             (let* ((l (dk-skolem! d))
                    (univ3 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f l) (dk-contains? f 'SAME-STRAND-BEFORE))) "the components")))
               (dk-rewrite-h! `(IN ,cp ,g) cp `(LST ,l))
               (let* ((j (dk-skolem! (dk-cite! 'key-ideal-gen-list-component hon-aT hon-aK 'ks 'S l)))
                      (x (dk-skolem! (dk-apply! univ3 j))))
                 (dk-rewrite-h! `(IN (NTH ,j ,l) ,g) `(NTH ,j ,l) (hon-cx x))
                 (contra! x))))
            (#t
             ;; S: p's content is the q-th component of l, so LST(l) is in I, an earlier content
             (let* ((l (dk-skolem! d))
                    (q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f l))) "the index")))
                    (x (hon-earlier-of! `(LST ,l))))
               (dk-rewrite-h! `(IN ,cp ,g) cp `(NTH ,q ,l))
               (dk-apply! (cadr parts) l q)
               (dk-rewrite-h! `(IN (LST ,l) ,g) `(LST ,l) (hon-cx x))
               (contra! x)))))))))
(qed 'key-ideal-gen-honest)

;;; -----------------------------------------------------------------------
;;; COROLLARY 6.12 and its two small lemmas.

;;; A node on a text trace sends a token the adversary knows.
(sp (make-wff `(FORALL isp (FORALL m (IMPLIES (IS-INFILTRATED-SPACE isp) (IMPLIES (IN m (NODES ,hon-asp))
  (IMPLIES (IS-TEXT-TRACE ,hon-asp (ADV-TOKENS isp) ,(hon-sg 'm)) (IN ,hon-cm (ADV-TOKENS isp)))))))))
(dk-peel!)
(let* ((sg (hon-sg 'm))
       (h '(IS-INFILTRATED-SPACE isp))
       (body `(FORSOME saa_ (AND (IN saa_ (ADV-TOKENS isp)) (= ,sg (LIST (LIST SENT saa_)))))))
  (hon-project! 'is-infiltrated-space h `(IS-STRAND-SPACE ,hon-asp))
  (hon-fact-split! 'strand-space-parts hon-asp)
  (hon-fact-split! 'node-parts hon-asp 'm)
  (fact 'strand-at-id hon-asp '(NTH 2 m))
  (fact 'length-in-nn `(DIRECTED ,hon-aT ,hon-aK) sg)
  (hon-project! 'is-text-trace `(IS-TEXT-TRACE ,hon-asp (ADV-TOKENS isp) ,sg) body)
  (let* ((a (car (hon-trace-witnesses! body 1)))
         (lit `(LIST (LIST SENT ,a))))
    (hon-lit-facts! 'm lit)
    (dk-rewrite-h! `(<= (NTH 1 m) (LENGTH ,sg)) `(LENGTH ,sg) 1)
    (dk-have! '(= (NTH 1 m) 1) (lambda () (dk-nn! '(<= 1 (NTH 1 m)) '(<= (NTH 1 m) 1))))
    (hon-entry! 'm 1 (cadr lit) 'm)
    (hon-subst-ass! (hon-eq-for hon-cm))))
(qed 'text-node-content)

;;; A token in I_k[S] is in S.
(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL x
   (IMPLIES (IS-TOKEN-SET T) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
      (IMPLIES (IN x T) (IMPLIES (IN x (KEY-IDEAL-GEN T K ks S)) (IN x S))))))))))))))
(let* ((landed (dk-peel!))
       (kss (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ks))) landed)))
  (fact 'token-set-is-set 'T)
  (fact 'msg-set-is-set 'T 'K)
  (let* ((o (dk-cite! 'key-ideal-gen-cases 'T 'K 'ks 'S 'x))
         (d1 (cadr o)) (d2 (cadr (caddr o))))
    (hon-or-each! o
      (lambda (d)
        (cond ((equal? d d1) (dk-ass!))
              ((equal? d d2)
               (let ((l (dk-skolem! d)))
                 (dk-have! `(AND (IN (MSG-SET T K) SET) (IN ,l (TUPLES (MSG-SET T K)))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                 (fact 'list-sethood '(MSG-SET T K) l)
                 (ai (dk-cite! 'token-ne-list 'T 'x l))))
              (#t
               (let* ((h1 (dk-skolem! d))
                      (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
                      (y1 (dk-skolem! ex)))
                 (dk-apply! kss y1)
                 (fact 'key-ideal-gen-in-msgs 'T 'K 'ks 'S h1)
                 (fact 'membership-implies-sethood h1 '(MSG-SET T K))
                 (fact 'membership-implies-sethood y1 'K)
                 (ai (dk-cite! 'encr-ne-token 'T 'x h1 y1)))))))))
(qed 'key-ideal-gen-token)

;; (= (NODE-CONTENT (BSPACE c) z) (NODE-CONTENT asp z)) for z in BNODES(c)
(define (hon-bc! z)
  (let ((e `(= (NODE-CONTENT (BSPACE c) ,z) ,(hon-cx z))))
    (if (not (dk-asm? e))
        (begin
          (fact 'bundle-space 'c)
          (dk-apply! (dk-cite! 'bundle-nodes-in-space 'c) z)
          (dk-cite! 'node-content-in-msgs '(BSPACE c) z)
          (dk-have! e (lambda () (subst `(= ,hon-asp (BSPACE c))) (rfl)))))
    e))

(define hon-H-612
  (append hon-H-611
          (list `(FORALL z (IMPLIES (IN z S) (IN z ,hon-aK)))
                `(FORALL z (IMPLIES (IN z S) (NOT (IN z (ADV-TOKENS isp))))))))

;; S inside the keys: S inside T
(define (hon-sk!)
  (let ((subK `(FORALL z (IMPLIES (IN z S) (IN z ,hon-aK)))))
    (hon-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE isp) `(IS-STRAND-SPACE ,hon-asp))
    (dk-have! `(FORALL z (IMPLIES (IN z S) (IN z ,hon-aT)))
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (dk-apply! subK z)
          (dk-apply! (dk-cite! 'keys-in-tokens hon-asp) z)
          (dk-ass!))))))

(sp (make-wff `(FORALL isp (FORALL c (FORALL ks (FORALL S
  ,(hon-curry (append hon-H-612
                      (list `(FORSOME m (AND (IN m (BNODES c)) (IN (NODE-CONTENT ,hon-asp m) ,(hon-G 'ks 'S))))))
     `(FORSOME n (AND (IN n (BNODES c)) (AND (IS-REGULAR-NODE isp n) (IS-ENTRY-POINT ,hon-asp n ,(hon-G 'ks 'S))))))))))))
(let* ((landed (dk-peel!))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
       (noadv (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ADV-TOKENS))) landed))
       (g (hon-G 'ks 'S))
       (w `(SEP hnw_ (BNODES c) (IN (NODE-CONTENT (BSPACE c) hnw_) ,g))))
  (hon-sk!)
  (let ((parts (hon-ideal-setup! 'ks 'S)))
    (fact 'key-ideal-gen-honest 'isp 'c 'ks 'S)
    (fact 'bundle-space 'c)
    (let ((m0 (dk-skolem! ex)))
      (hon-bc! m0)
      (dk-rewrite-h! `(IN ,(hon-cx m0) ,g) (hon-cx m0) `(NODE-CONTENT (BSPACE c) ,m0))
      (dk-have! `(FORALL z (IMPLIES (IN z ,w) (IN z (BNODES c))))
        (lambda () (let ((z (cadr (car (dk-peel!))))) (sep-me `(IN ,z ,w)) (dk-ass!))))
      (dk-have! `(FORSOME v (IN v ,w)) (lambda () (ew m0) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
    (let* ((n (dk-skolem! (dk-cite! 'bundle-minimal 'c w)))
           (minw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n) (dk-contains? f 'PRECEDES-STRICT))) "n minimal")))
      (sep-me `(IN ,n ,w))
      (dk-have! `(FORALL z (IMPLIES (IN z (BNODES c)) (IMPLIES (IN (NODE-CONTENT (BSPACE c) z) ,g)
                    (NOT (IN (LIST z ,n) (PRECEDES-STRICT c))))))
        (lambda ()
          (let ((z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) (dk-peel!)))))
            (dk-have! `(IN ,z ,w) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
            (dk-apply! minw z)
            (dk-ass!))))
      (let ((ep (dk-cite! 'bundle-minimal-entry-point 'c g n)))
        (dk-rewrite-h! ep '(BSPACE c) hon-asp)
        (hon-bc! n)
        (dk-rewrite-h! `(IN (NODE-CONTENT (BSPACE c) ,n) ,g) `(NODE-CONTENT (BSPACE c) ,n) (hon-cx n))
        (use-em `(IS-ADVERSARY-NODE isp ,n)
          (lambda ()
            ;; honesty: n lies on a text trace, so its content is a known token, in I hence in S
            (let ((hon `(FORALL shn_ (IMPLIES (IN shn_ (BNODES c)) (IMPLIES (IS-ADVERSARY-NODE isp shn_)
                          (IMPLIES (IS-ENTRY-POINT ,hon-asp shn_ ,g)
                                   (IS-TEXT-TRACE ,hon-asp (ADV-TOKENS isp) ((STRAND-MAP ,hon-asp) (NTH 2 shn_)))))))))
              (hon-project! 'is-honest `(IS-HONEST isp c ,g) hon)
              (dk-apply! hon n)
              (hon-project! 'is-entry-point `(IS-ENTRY-POINT ,hon-asp ,n ,g) `(IN ,n (NODES ,hon-asp)))
              (fact 'text-node-content 'isp n)
              (hon-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE isp)
                `(FORALL sat_ (IMPLIES (IN sat_ (ADV-TOKENS isp)) (IN sat_ ,hon-aT))))
              (dk-apply! `(FORALL sat_ (IMPLIES (IN sat_ (ADV-TOKENS isp)) (IN sat_ ,hon-aT))) (hon-cx n))
              (dk-cite! 'key-ideal-gen-token hon-aT hon-aK 'ks 'S (hon-cx n))
              (ai (dk-apply! noadv (hon-cx n)))))
          (lambda ()
            (dk-have! `(IS-REGULAR-NODE isp ,n)
              (lambda ()
                (mac 'is-regular-node)
                (di)
                (dk-have! `(IS-ADVERSARY-NODE isp ,n) (lambda () (mac 'is-adversary-node) (dk-ass!)))
                (ai `(NOT (IS-ADVERSARY-NODE isp ,n)))))
            (ew n)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (error "6.12: open" (dk-goal)))))))))))
(qed 'key-ideal-gen-regular-entry)

;;; -----------------------------------------------------------------------
;;; COROLLARY 6.13: with no regular entry point into I_k[S], no encryption under a key of S originates on
;;; an adversary node of the bundle.

(sp (make-wff `(FORALL isp (FORALL c (FORALL ks (FORALL S
  ,(hon-curry (append hon-H-612
                      (list `(FORALL n (IMPLIES (IN n (BNODES c)) (IMPLIES (IS-REGULAR-NODE isp n)
                               (NOT (IS-ENTRY-POINT ,hon-asp n ,(hon-G 'ks 'S))))))))
     `(FORALL n (IMPLIES (IN n (BNODES c)) (IMPLIES (IS-ADVERSARY-NODE isp n)
        (FORALL g (FORALL y (IMPLIES (IN g ,hon-aM) (IMPLIES (IN y S)
          (NOT (ORIGINATES ,hon-asp (ENCR g y) n))))))))))))))))
(let* ((landed (dk-peel!))
       (g (hon-G 'ks 'S))
       (noreg (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-REGULAR-NODE))) landed))
       (subK `(FORALL z (IMPLIES (IN z S) (IN z ,hon-aK))))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) landed)))
       (gv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) hon-aM))) landed)))
       (yv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'S))) landed)))
       (w `(ENCR ,gv ,yv))
       (cn (hon-cx n)))
  (di)                                                   ; ORIGINATES w n; goal FALSITY
  (hon-sk!)
  (hon-ideal-setup! 'ks 'S)
  (fact 'bundle-space 'c)
  ;; no node of the bundle has its content in I (6.12, contrapositive)
  (let ((noI `(FORALL z (IMPLIES (IN z (BNODES c)) (NOT (IN (NODE-CONTENT ,hon-asp z) ,g))))))
    (dk-have! noI
      (lambda ()
        (let* ((lnd (dk-peel!))
               (z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) lnd))))
          (if (dk-head-is? (dk-goal) 'NOT) (di))
          (dk-have! `(FORSOME m (AND (IN m (BNODES c)) (IN (NODE-CONTENT ,hon-asp m) ,g)))
            (lambda () (ew z) (dk-conj-close! (lambda () (dk-ass!)))))
          (let* ((ex (dk-cite! 'key-ideal-gen-regular-entry 'isp 'c 'ks 'S))
                 (n2 (dk-skolem! ex)))
            (ai (dk-apply! noreg n2))))))
    (dk-apply! subK yv)
    (fact 'encr-in-msgs hon-aT hon-aK gv yv)
    (hon-set! gv) (hon-set! yv)
    (hon-fact-split! 'originates-elim hon-asp w n)
    (let* ((noearly (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SAME-STRAND-BEFORE) (dk-contains? f w))) "no earlier"))
           (hw `(IS-SUBTERM ,hon-aT ,hon-aK ,w ,cn))
           (contra! (lambda (x f) (ai (dk-apply! noearly x)))))
      (hon-or-each! (dk-cite! 'adversary-sent-shapes 'isp n)
        (lambda (d)
          (cond
            ((dk-head-is? d 'AND)
             ;; M: a known token holds the encryption: it is the token, absurd
             (dk-split-all!)
             (hon-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE isp)
               `(FORALL sat_ (IMPLIES (IN sat_ (ADV-TOKENS isp)) (IN sat_ ,hon-aT))))
             (dk-apply! `(FORALL sat_ (IMPLIES (IN sat_ (ADV-TOKENS isp)) (IN sat_ ,hon-aT))) cn)
             (fact 'subterm-of-token hon-aT hon-aK w cn)
             (dk-rewrite-h! `(IN ,cn ,hon-aT) cn w)
             (ai (dk-cite! 'token-not-encr hon-aT gv yv)))
            ((and (dk-head-is? d 'FORSOME) (dk-head-is? (caddr d) 'AND) (dk-head-is? (cadr (caddr d)) 'SAME-STRAND-BEFORE))
             (let ((x (dk-skolem! d)))
               (dk-rewrite-h! hw cn (hon-cx x))
               (contra! x #f)))
            ((dk-contains? d 'KINV)
             (let* ((h (dk-skolem! d))
                    (k (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h))) "the key")))
                    (x1 (hon-earlier-of! `((KINV ,hon-asp) ,k)))
                    (x2 (hon-earlier-of! `(ENCR ,h ,k))))
               (dk-rewrite-h! hw cn h)
               (fact 'subterm-encr hon-aT hon-aK w h k)
               (dk-rewrite-h! `(IS-SUBTERM ,hon-aT ,hon-aK ,w (ENCR ,h ,k)) `(ENCR ,h ,k) (hon-cx x2))
               (contra! x2 #f)))
            ((dk-contains? d 'ENCR)
             (let* ((h (dk-skolem! d))
                    (k (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h))) "the key")))
                    (x1 (hon-earlier-of! k))
                    (x2 (hon-earlier-of! h)))
               (dk-rewrite-h! hw cn `(ENCR ,h ,k))
               (hon-or-each! (dk-cite! 'subterm-of-encr hon-aT hon-aK w h k)
                 (lambda (e)
                   (if (dk-head-is? e 'IS-SUBTERM)
                       (begin (dk-rewrite-h! e h (hon-cx x2)) (contra! x2 #f))
                       ;; w IS the encryption: its key k is y, in S, so the key node x1 has content in I
                       (begin
                         (hon-fact-split! 'encr-injective gv yv h k)
                         (dk-rewrite-h! `(IN ,yv S) yv k)
                         (dk-apply! (dk-cite! 'keys-in-tokens hon-asp) k)
                         (fact 'token-in-msgs hon-aT hon-aK k)
                         (fact 'key-ideal-gen-contains hon-aT hon-aK 'ks 'S k)
                         (dk-rewrite-h! `(IN ,k ,g) k (hon-cx x1))
                         (dk-have! `(SAME-STRAND-BEFORE (BSPACE c) ,x1 ,n) (lambda () (subst `(= (BSPACE c) ,hon-asp)) (dk-ass!)))
                         (dk-apply! (dk-cite! 'bundle-ssb-closed 'c n) x1)
                         (ai (dk-apply! noI x1))))))))
            ((dk-contains? d 'FORALL)
             (let* ((l (dk-skolem! d))
                    (univ3 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f l) (dk-contains? f 'SAME-STRAND-BEFORE))) "the components")))
               (dk-rewrite-h! hw cn `(LST ,l))
               (hon-or-each! (dk-cite! 'subterm-of-list hon-aT hon-aK w l)
                 (lambda (e)
                   (if (dk-head-is? e '=)
                       (begin
                         (fact 'encr-ne-list gv yv l)
                         (hon-keep-prop! e `(NOT ,e)))
                       (let* ((j (dk-skolem! e))
                              (x (dk-skolem! (dk-apply! univ3 j))))
                         (dk-rewrite-h! `(IS-SUBTERM ,hon-aT ,hon-aK ,w (NTH ,j ,l)) `(NTH ,j ,l) (hon-cx x))
                         (contra! x #f)))))))
            (#t
             (let* ((l (dk-skolem! d))
                    (q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f l))) "the index")))
                    (x (hon-earlier-of! `(LST ,l))))
               (dk-rewrite-h! hw cn `(NTH ,q ,l))
               (fact 'subterm-component hon-aT hon-aK w l q)
               (dk-rewrite-h! `(IS-SUBTERM ,hon-aT ,hon-aK ,w (LST ,l)) `(LST ,l) (hon-cx x))
               (contra! x #f)))))))))
(qed 'key-ideal-gen-no-adversary-origin)

;;; -----------------------------------------------------------------------
;;; PROPOSITION 3.3 RE-DERIVED FROM 6.12 (the paper: "Proposition 3.3 is a special case of this, in which
;;; {K} is chosen as S and K is chosen as k").  The bridge is the paper's remark after Definition 6.1,
;;; "g @ h if and only if h in I_K[g]": key-ideal-gen-subterms.

(define (hon-conj-kind g)
  (let ((body (caddr g)))
    (cond ((dk-head-is? body 'IMPLIES) 'sub)
          ((dk-head-is? (caddr (cadr (caddr body))) 'TUPLES) 'lst)
          (#t 'encr))))
(define (hon-ideal-intro! sub! lst! encr!)
  (mac 'is-key-ideal)
  (dk-conj-close!
    (lambda ()
      (let* ((kind (hon-conj-kind (dk-goal)))
             (landed (dk-peel!))
             (g (dk-goal)))
        (case kind
          ((sub) (sub! (cadr g)))
          ((lst) (let* ((l (cadr (cadr g)))
                        (nm (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'NTH))) landed)
                                (error "hon-ideal-intro!: no component membership landed"))))
                   (lst! l (cadr (cadr nm)))))
          (else (encr! (cadr (cadr g)) (caddr (cadr g)))))))))

(sp (make-wff '(FORALL T (FORALL K (FORALL tt0 (IMPLIES (IS-TOKEN-SET T) (IMPLIES (IN K SET)
  (IMPLIES (IN tt0 (MSG-SET T K))
    (= (KEY-IDEAL-GEN T K K (SINGLETON tt0))
       (SEP ssw_ (MSG-SET T K) (IS-SUBTERM T K tt0 ssw_)))))))))))
(dk-peel!)
(let* ((a '(MSG-SET T K))
       (g '(KEY-IDEAL-GEN T K K (SINGLETON tt0)))
       (sb '(SEP ssw_ (MSG-SET T K) (IS-SUBTERM T K tt0 ssw_)))
       (cc `(SEP hnc_ (MSG-SET T K) (IMPLIES (IS-SUBTERM T K tt0 hnc_) (IN hnc_ ,g)))))
  (fact 'token-set-is-set 'T)
  (dk-have! '(FORALL y (IMPLIES (IN y K) (IN y K))) (lambda () (dk-peel!) (dk-ass!)))
  (fact 'key-ideal-gen-self 'T 'K 'K 'tt0)
  (fact 'key-ideal-gen-is-ideal 'T 'K 'K '(SINGLETON tt0))
  (let ((parts (hon-ideal-parts! 'T 'K 'K g)))
    (dk-have! `(FORALL hnw_ (IFF (IN hnw_ ,g) (IN hnw_ ,sb)))
      (lambda ()
        (dk-peel!)
        (dk-iff! (lambda (gl) (equal? (caddr gl) sb))
          ;; G inside the subterm set: that set is a K-ideal holding t
          (lambda ()
            (let ((w (cadr (dk-goal))))
              (dk-have! `(IS-KEY-IDEAL T K K ,sb)
                (lambda ()
                  (hon-ideal-intro!
                    (lambda (x) (sep-me `(IN ,x ,sb)) (dk-ass!))
                    (lambda (l i)
                      (sep-me `(IN (NTH ,i ,l) ,sb))
                      (fact 'subterm-component 'T 'K 'tt0 l i)
                      (fact 'list-in-msgs 'T 'K l)
                      (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))
                    (lambda (h y)
                      (sep-me `(IN ,h ,sb))
                      (fact 'subterm-encr 'T 'K 'tt0 h y)
                      (fact 'encr-in-msgs 'T 'K h y)
                      (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
              (fact 'subterm-refl 'T 'K 'tt0)
              (dk-have! `(IN tt0 ,sb) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
              (dk-cite! 'key-ideal-gen-singleton-least 'T 'K 'K sb 'tt0 w)
              (dk-ass!)))
          ;; the subterm set inside G: induction on messages
          (lambda ()
            (let* ((w (cadr (dk-goal)))
                   (ind (dk-cite! 'msg-induction 'T 'K cc))
                   (a1 (cadr ind)) (a2 (cadr (caddr ind))) (a3 (cadr (caddr (caddr ind)))))
              ;; tokens
              (dk-have! a1
                (lambda ()
                  (let ((tk (cadr (car (dk-peel!)))))
                    (fact 'token-in-msgs 'T 'K tk)
                    (in-sep! (lambda () (dk-ass!))
                             (lambda ()
                               (di)
                               (fact 'subterm-of-token 'T 'K 'tt0 tk)
                               (subst `(= ,tk tt0))
                               (dk-ass!))))))
              ;; lists
              (dk-have! a2
                (lambda ()
                  (let* ((landed (dk-peel!))
                         (l (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'TUPLES))) landed)))
                         (hl (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
                    (fact 'list-in-msgs 'T 'K l)
                    (in-sep! (lambda () (dk-ass!))
                             (lambda ()
                               (di)
                               (hon-or-each! (dk-cite! 'subterm-of-list 'T 'K 'tt0 l)
                                 (lambda (e)
                                   (if (dk-head-is? e '=)
                                       (begin (subst `(= (LST ,l) tt0)) (dk-ass!))
                                       (let ((i (dk-skolem! e)))
                                         (dk-apply! hl i)
                                         (sep-me `(IN (NTH ,i ,l) ,cc))
                                         (detach! `(IMPLIES (IS-SUBTERM T K tt0 (NTH ,i ,l)) (IN (NTH ,i ,l) ,g)))
                                         (dk-apply! (cadr parts) l i)
                                         (dk-ass!))))))))))
              ;; encryptions
              (dk-have! a3
                (lambda ()
                  (let* ((landed (dk-peel!))
                         (gg (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cc))) landed)))
                         (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'K))) landed))))
                    (fact 'encr-in-msgs 'T 'K gg y)
                    (in-sep! (lambda () (dk-ass!))
                             (lambda ()
                               (di)
                               (hon-or-each! (dk-cite! 'subterm-of-encr 'T 'K 'tt0 gg y)
                                 (lambda (e)
                                   (if (dk-head-is? e '=)
                                       (begin (subst `(= (ENCR ,gg ,y) tt0)) (dk-ass!))
                                       (begin
                                         (sep-me `(IN ,gg ,cc))
                                         (detach! `(IMPLIES (IS-SUBTERM T K tt0 ,gg) (IN ,gg ,g)))
                                         (dk-apply! (caddr parts) gg y)
                                         (dk-ass!))))))))))
              (sep-me `(IN ,w ,sb))
              (dk-apply! (dk-apply! ind) w)
              (sep-me `(IN ,w ,cc))
              (detach! `(IMPLIES (IS-SUBTERM T K tt0 ,w) (IN ,w ,g)))
              (dk-ass!)))))))
  (fact 'class-extensionality g sb)
  (dk-ass!))
(qed 'key-ideal-gen-subterms)

(sp (make-wff `(FORALL isp (FORALL c (FORALL u
  (IMPLIES (IS-INFILTRATED-SPACE isp) (IMPLIES (IS-BUNDLE c) (IMPLIES (= (BSPACE c) ,hon-asp)
  (IMPLIES (IN u ,hon-aK) (IMPLIES (NOT (IN u (ADV-TOKENS isp)))
  (IMPLIES (FORALL n (IMPLIES (IN n (BNODES c)) (IMPLIES (IS-REGULAR-NODE isp n) (NOT (ORIGINATES ,hon-asp u n)))))
    (FORALL n (IMPLIES (IN n (BNODES c)) (NOT (IS-SUBTERM ,hon-aT ,hon-aK u (NODE-CONTENT ,hon-asp n))))))))))))))))
(let* ((landed (dk-peel!))
       (noorig (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ORIGINATES))) landed))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) landed)))
       (s1 '(SINGLETON u))
       (g (hon-G hon-aK s1))
       (sb `(SEP ssw_ ,hon-aM (IS-SUBTERM ,hon-aT ,hon-aK u ssw_))))
  (di)
  (hon-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE isp) `(IS-STRAND-SPACE ,hon-asp))
  (hon-fact-split! 'strand-space-parts hon-asp)
  (fact 'bundle-space 'c)
  (dk-apply! (dk-cite! 'keys-in-tokens hon-asp) 'u)
  (fact 'token-in-msgs hon-aT hon-aK 'u)
  (fact 'membership-implies-sethood 'u hon-aK)
  ;; the hypotheses of 6.12 at S = {u}, k = all keys
  (let ((in-s1! (lambda (z) (let ((mem `(IN ,z ,s1)))
                              (fact 'singleton-membership 'u z)
                              (dk-have! `(= ,z u) (lambda () (hon-keep-prop! (iff-for mem) mem)))))))
    (dk-have! `(FORALL y (IMPLIES (IN y ,hon-aK) (IN y ,hon-aK))) (lambda () (dk-peel!) (dk-ass!)))
    (dk-have! `(FORALL y (IMPLIES (IN y ,hon-aK) (OR (IN y ,s1) (IN ((KINV ,hon-asp) y) ,hon-aK))))
      (lambda ()
        (let ((y (cadr (car (dk-peel!)))))
          (oi-r)
          (hon-kinv-typed! y)
          (dk-ass!))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,s1) (IN z ,hon-aK)))
      (lambda () (let ((z (cadr (car (dk-peel!))))) (in-s1! z) (subst `(= ,z u)) (dk-ass!))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,s1) (NOT (IN z (ADV-TOKENS isp)))))
      (lambda () (let ((z (cadr (car (dk-peel!))))) (in-s1! z) (subst `(= ,z u)) (dk-ass!)))))
  ;; the bridge: I_K[{u}] is the set of messages holding u
  (let ((e (dk-cite! 'key-ideal-gen-subterms hon-aT hon-aK 'u)))
    (dk-apply! (dk-cite! 'bundle-nodes-in-space 'c) n)
    (dk-rewrite-h! `(IN ,n (NODES (BSPACE c))) '(BSPACE c) hon-asp)
    (fact 'node-content-in-msgs hon-asp n)
    (dk-have! `(IN ,(hon-cx n) ,sb) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
    (dk-rewrite-h! `(IN ,(hon-cx n) ,sb) sb g)
    (dk-have! `(FORSOME m (AND (IN m (BNODES c)) (IN (NODE-CONTENT ,hon-asp m) ,g)))
      (lambda () (ew n) (dk-conj-close! (lambda () (dk-ass!)))))
    (let* ((n2 (dk-skolem! (dk-cite! 'key-ideal-gen-regular-entry 'isp 'c hon-aK s1)))
           (ep (dk-pick (lambda (f) (and (dk-head-is? f 'IS-ENTRY-POINT) (dk-contains? f n2))) "the entry point")))
      (dk-rewrite-h! ep g sb)
      (dk-have! `(ORIGINATES ,hon-asp u ,n2) (lambda () (mac 'originates) (dk-ass!)))
      (ai (dk-apply! noorig n2)))))
(qed 'adversary-bound-via-ideals)
