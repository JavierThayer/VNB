(define u4-lhyps '((IS-COMPACT-NV-DOMAIN K A) (IN w A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A w)) (NOT (= w (ZERO K)))
                   (= A (NV-INTEGERS K))))
(define (u4-lall body) `(FORALL K (FORALL A (FORALL w ,(u4-curry u4-lhyps body)))))
;; (NOT (= B A)) from (NOT (= A B)) in context
(define (u4-ne-sym! a b)
  (if (not (dk-asm? `(NOT (= ,b ,a))))
      (dk-have! `(NOT (= ,b ,a))
        (lambda ()
          (di)
          (dk-have! `(= ,a ,b) (lambda () (subst `(= ,b ,a)) (rfl)))
          (ai `(NOT (= ,a ,b)))))))
;; A < B in ZZ (typed in ZZ and RR): land and return |w^B| <= |w| |w^A|
(define (u4-gap-case! a b)
  (let* ((nw (u4-n 'w)) (za (u4-zp! a)) (zb (u4-zp! b)) (na (u4-n za)) (nb (u4-n zb)) (a1 `(+ ,a 1)))
    (dk-chain-ass! (dk-cite! 'zz-lt-succ-le a b))
    (u4-zz-add! a 1) (u4-zr! a1)
    (dk-cite! 'zz-neg-closed a1) (u4-zz-add! b `(- ,a1))
    (let ((j `(+ ,b (- ,a1))))
      (dk-have! `(<= 0 ,j) (lambda () (dk-ineq! `(<= ,a1 ,b) `(IN ,a1 RR) `(IN ,b RR))))
      (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn j))
      (let ((jv (dk-name! j 'NN)))
        (u4-nr! jv)
        (dk-have! `(= (+ ,a1 ,jv) ,b) (lambda () (subst `(= ,jv ,j)) (crs)))
        (let* ((z1 (u4-zp! a1)) (n1 (u4-n z1))
               (mo0 (dk-chain-ass! (dk-cite! 'nv-zpow-norm-mono jv 'K 'w a1)))
               (mo (dk-rewrite-h! mo0 `(+ ,a1 ,jv) b))
               (su (dk-cite! 'nv-zpow-norm-succ 'K 'w a)))
          (u4-typek! za) (u4-typek! zb) (u4-typek! z1) (u4-typek! 'w)
          (u4-rr-mul! na nw) (u4-rr-mul! nw na)
          (dk-have! `(= (* ,na ,nw) (* ,nw ,na)) (lambda () (crs)))
          (dk-have! `(<= ,nb (* ,nw ,na))
            (lambda () (dk-ineq! mo su `(= (* ,na ,nw) (* ,nw ,na)) `(IN ,nb RR) `(IN ,n1 RR)
                                 `(IN (* ,na ,nw) RR) `(IN (* ,nw ,na) RR))))
          `(<= ,nb (* ,nw ,na)))))))

;; two different nonzero values of |.| differ by a factor |w| at least
(sp (make-wff (u4-lall
  `(FORALL x (IMPLIES (IN x (CARR K)) (IMPLIES (NOT (= x (ZERO K))) (FORALL y (IMPLIES (IN y (CARR K)) (IMPLIES (NOT (= y (ZERO K)))
     (IMPLIES (NOT (= ,(u4-n 'x) ,(u4-n 'y)))
       (OR (<= ,(u4-n 'y) (* ,(u4-n 'w) ,(u4-n 'x))) (<= ,(u4-n 'x) (* ,(u4-n 'w) ,(u4-n 'y))))))))))))))
(dk-peel!)
(u4-setup!)
(let* ((k (dk-skolem! (dk-cite! 'ccr-remark-4-9 'K 'A 'w 'x)))
       (l (dk-skolem! (dk-cite! 'ccr-remark-4-9 'K 'A 'w 'y)))
       (zk (u4-zp! k)) (zl (u4-zp! l)) (nk (u4-n zk)) (nl (u4-n zl)) (nx (u4-n 'x)) (ny (u4-n 'y)))
  (u4-typek! 'x) (u4-typek! 'y) (u4-typek! zk) (u4-typek! zl) (u4-typek! 'w)
  (u4-zr! k) (u4-zr! l)
  (u4-and! `(IN ,k RR) `(IN ,l RR))
  (dk-have! `(NOT (= ,k ,l))
    (lambda ()
      (di)
      (dk-have! `(= ,nx ,ny) (lambda () (subst `(= ,nx ,nk)) (subst `(= ,ny ,nl)) (subst `(= ,k ,l)) (rfl)))
      (ai `(NOT (= ,nx ,ny)))))
  (dk-or-each! (dk-cite! 'rr-leq-total k l)
    (lambda (c)
      (if (equal? c `(<= ,k ,l))
          (begin
            (u4-and! `(<= ,k ,l) `(NOT (= ,k ,l)))
            (dk-chain-ass! (dk-cite! 'rr-le-ne-lt k l))
            (u4-gap-case! k l)
            (oi-l)
            (subst `(= ,ny ,nl)) (subst `(= ,nx ,nk))
            (dk-close-if-asm!))
          (begin
            (u4-ne-sym! k l)
            (u4-and! `(<= ,l ,k) `(NOT (= ,l ,k)))
            (dk-chain-ass! (dk-cite! 'rr-le-ne-lt l k))
            (u4-gap-case! l k)
            (oi-r)
            (subst `(= ,ny ,nl)) (subst `(= ,nx ,nk))
            (dk-close-if-asm!))))))
(qed 'nv-zpow-norm-gap)

(define u4-vset '(SEP u4v_ RR (FORSOME u4x_ (AND (IN u4x_ (CARR K)) (= u4v_ ((FNRM K) u4x_))))))
;; LAW the accumulation law at c, R with POS-RR R in context: a value y = |x| with -R < c - y < R and y /= c.
;; Returns (y x).
(define (u4-sample! law r)
  (let* ((y (dk-skolem! (dk-chain-ass! (dk-apply! law r))))
         (mv `(IN ,y ,u4-vset)))
    (dk-sep-parts! mv)
    (let* ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y) (dk-contains? h 'u4x_))) "the value witness")))
           (bm (dk-iff-fwd! (dk-cite! 'ball-membership 'RR-MS 'c r y)))
           (dd `((DIST RR-MS) c ,y))
           (eqd (dk-cite! 'rr-ms-dist 'c y))
           (ab `(abs (- c ,y)))
           (eqm (dk-cite! 'binary-minus-def 'c y))
           (t `(+ c (- ,y))))
      (dk-split-all!)
      (let* ((h1 (dk-rewrite-h! (dk-rewrite-h! `(<= ,dd ,r) dd ab) `(- c ,y) t))
             (h2 (dk-rewrite-h! (dk-rewrite-h! `(NOT (= ,dd ,r)) dd ab) `(- c ,y) t))
             (at `(abs ,t)))
        (dk-cite! 'rr-neg-closed y) (u4-and! '(IN c RR) `(IN (- ,y) RR)) (dk-cite! 'rr-add-closed 'c `(- ,y))
        (dk-cite! 'rr-abs-closed t)
        (u4-and! `(<= ,at ,r) `(NOT (= ,at ,r)))
        (dk-chain-ass! (dk-cite! 'rr-le-ne-lt at r))
        (dk-split-all! (list (dk-chain-ass! (dk-cite! 'rr-abs-lt-parts t r))))
        (u4-typek! x)
        (list y x)))))

(sp (make-wff (u4-lall
  `(FORALL c (IMPLIES (IS-ACCUMULATION-POINT RR-MS ,u4-vset c) (= c 0))))))
(dk-peel!)
(u4-setup!)
(u4-w-small!)
(fact 'rr-is-metric-space)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(dk-split-all! (list (dk-project!
  `(AND (IS-METRIC-SPACE RR-MS) (AND (IN c (PTS RR-MS))
     (FORALL aptr_ (IMPLIES (POS-RR aptr_) (FORSOME apty_ (AND (IN apty_ ,u4-vset) (AND (IN apty_ (BALL RR-MS c aptr_)) (NOT (= apty_ c)))))))))
  'is-accumulation-point `(IS-ACCUMULATION-POINT RR-MS ,u4-vset c))))
(dk-have! '(IN c RR) (lambda () (subst '(== RR (PTS RR-MS))) (dk-close-if-asm!)))
(let ((law (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL))) "the accumulation law"))
      (nw (u4-n 'w)))
  (u4-typek! 'w)
  (use-em '(= c 0)
    (lambda () (dk-ass!))
    (lambda ()
      (dk-have-and! '(IN c RR) '(IN 0 RR))
      (dk-or-each! (dk-cite! 'rr-leq-total 'c 0)
        (lambda (cs)
          (if (equal? cs '(<= c 0))
              ;; c < 0: the ball of radius -c holds no value
              (begin
                (u4-and! '(<= c 0) '(NOT (= c 0)))
                (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 'c 0))
                (dk-cite! 'rr-neg-closed 'c)
                (dk-have! '(< 0 (- c)) (lambda () (dk-ineq! '(< c 0) '(IN c RR))))
                (dk-cite! 'rr-pos-rr-of-lt '(- c))
                (let* ((yx (u4-sample! law '(- c))) (y (car yx)) (x (cadr yx)))
                  (dk-absurd! `(< (- (- c)) (+ c (- ,y))) `(= ,y ,(u4-n x)) `(<= 0 ,(u4-n x)) '(IN c RR) `(IN ,y RR))))
              ;; c > 0
              (begin
                (u4-ne-sym! 'c 0)
                (u4-and! '(<= 0 c) '(NOT (= 0 c)))
                (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 0 'c))
                (let* ((p `(* ,nw c)) (q1 `(+ 1 (- ,nw))) (dv `(+ c (- ,p))))
                  (u4-rr-mul! nw 'c)
                  (dk-cite! 'rr-neg-closed nw) (u4-and! '(IN 1 RR) `(IN (- ,nw) RR)) (dk-cite! 'rr-add-closed 1 `(- ,nw))
                  (dk-have! `(< 0 ,q1) (lambda () (dk-ineq! `(< ,nw 1) `(IN ,nw RR))))
                  (u4-rr-mul! 'c q1)
                  (dk-chain-ass! (dk-cite! 'rr-mul-pos 'c q1))
                  (dk-have! `(= (* c ,q1) ,dv) (lambda () (crs)))
                  (dk-cite! 'rr-neg-closed p) (u4-and! '(IN c RR) `(IN (- ,p) RR)) (dk-cite! 'rr-add-closed 'c `(- ,p))
                  (dk-have! `(< 0 ,dv) (lambda () (dk-ineq! `(< 0 (* c ,q1)) `(= (* c ,q1) ,dv) `(IN (* c ,q1) RR) `(IN ,p RR))))
                  (dk-cite! 'rr-pos-rr-of-lt dv)
                  (let* ((d1 (dk-halve! dv)) (r (begin (dk-cite! 'rr-pos-rr-of-lt d1) (dk-halve! d1))))
                    (dk-cite! 'rr-pos-rr-of-lt r)
                    (dk-have! `(<= 0 ,r) (lambda () (dk-ineq! `(< 0 ,r) `(IN ,r RR))))
                    (if (not (dk-asm? `(<= ,nw 1))) (dk-have! `(<= ,nw 1) (lambda () (dk-ineq! `(< ,nw 1) `(IN ,nw RR)))))
                    (dk-have! '(<= 0 c) (lambda () (dk-ineq! '(< 0 c) '(IN c RR))))
                    (dk-chain-ass! (dk-cite! 'rr-mul-le-right nw 1 'c))
                    (u4-rr-mul! 1 'c)
                    (dk-have! '(= (* 1 c) c) (lambda () (crs)))
                    (u4-and! `(IN ,nw RR) '(IN c RR))
                    (u4-and! `(<= 0 ,nw) '(<= 0 c))
                    (dk-chain-ass! (dk-cite! 'rr-leq-mul-nonneg nw 'c))
                    (let* ((s1 (u4-sample! law r)) (y1 (car s1)) (x1 (cadr s1))
                           (rng `((<= 0 ,p) (= (+ ,d1 ,d1) ,dv) (= (+ ,r ,r) ,d1) (< 0 ,r) (IN ,r RR) (IN ,d1 RR) (IN ,p RR)
                                  (<= (* ,nw c) (* 1 c)) (= (* 1 c) c) (IN (* 1 c) RR) (IN c RR) (IN ,dv RR))))
                      (let ((second!
                             (lambda (r2 r2-facts)
                               ;; a second value, nearer to c than y1
                               (dk-cite! 'rr-pos-rr-of-lt r2)
                               (let* ((s2 (u4-sample! law r2)) (y2 (car s2)) (x2 (cadr s2))
                                      (base (append rng r2-facts
                                                    `((< (- ,r) (+ c (- ,y1))) (< (+ c (- ,y1)) ,r)
                                                      (< (- ,r2) (+ c (- ,y2))) (< (+ c (- ,y2)) ,r2)
                                                      (IN ,y1 RR) (IN ,y2 RR) (IN ,r2 RR)))))
                                 ;; both values are positive, hence x1, x2 /= 0
                                 (for-each
                                   (lambda (yx)
                                     (let ((yv (car yx)) (xv (cadr yx)))
                                       (dk-have! `(< 0 ,yv) (lambda () (apply dk-ineq! base)))
                                       (dk-have! `(NOT (= ,xv (ZERO K)))
                                         (lambda ()
                                           (di)
                                           (dk-have! `(= ,(u4-n xv) 0) (lambda () (subst `(= ,xv (ZERO K))) (dk-close-if-asm!)))
                                           (dk-absurd! `(< 0 ,yv) `(= ,yv ,(u4-n xv)) `(= ,(u4-n xv) 0) `(IN ,yv RR))))))
                                   (list s1 s2))
                                 (dk-have! `(NOT (= ,(u4-n x1) ,(u4-n x2)))
                                   (lambda ()
                                     (di)
                                     (apply dk-absurd! `(= ,(u4-n x1) ,(u4-n x2)) `(= ,y1 ,(u4-n x1)) `(= ,y2 ,(u4-n x2))
                                            `(IN ,(u4-n x1) RR) `(IN ,(u4-n x2) RR) base)))
                                 (let* ((g0 (dk-chain-ass! (dk-cite! 'nv-zpow-norm-gap 'K 'A 'w x1 x2)))
                                        (g1 (dk-rewrite-h! g0 (u4-n x1) y1))
                                        (g2 (dk-rewrite-h! g1 (u4-n x2) y2)))
                                   (dk-or-each! g2
                                     (lambda (o)
                                       ;; o: ys <= |w| yb; yb < c + r, so |w| yb <= |w| c + |w| r <= p + r
                                       (let* ((ys (cadr o)) (yb (caddr (caddr o))))
                                         (dk-have! `(<= ,yb (+ c ,r)) (lambda () (apply dk-ineq! base)))
                                         (u4-and! '(IN c RR) `(IN ,r RR)) (dk-cite! 'rr-add-closed 'c r)
                                         (dk-chain-ass! (dk-cite! 'rr-mul-le-right yb `(+ c ,r) nw))
                                         (dk-chain-ass! (dk-cite! 'rr-mul-le-right nw 1 r))
                                         (u4-rr-mul! yb nw) (u4-rr-mul! nw yb) (u4-rr-mul! `(+ c ,r) nw)
                                         (u4-rr-mul! nw r) (u4-rr-mul! 1 r)
                                         (dk-have! `(= (* ,nw ,yb) (* ,yb ,nw)) (lambda () (crs)))
                                         (dk-have! `(= (* (+ c ,r) ,nw) (+ ,p (* ,nw ,r))) (lambda () (crs)))
                                         (dk-have! `(= (* 1 ,r) ,r) (lambda () (crs)))
                                         (apply dk-absurd! o `(= (* ,nw ,yb) (* ,yb ,nw)) `(<= (* ,yb ,nw) (* (+ c ,r) ,nw))
                                                `(= (* (+ c ,r) ,nw) (+ ,p (* ,nw ,r))) `(<= (* ,nw ,r) (* 1 ,r)) `(= (* 1 ,r) ,r)
                                                `(IN (* ,nw ,yb) RR) `(IN (* ,yb ,nw) RR) `(IN (* (+ c ,r) ,nw) RR)
                                                `(IN (* ,nw ,r) RR) `(IN (* 1 ,r) RR) `(IN ,ys RR) `(IN ,yb RR)
                                                base)))))))))
                        (dk-have-and! `(IN ,y1 RR) '(IN c RR))
                        (dk-or-each! (dk-cite! 'rr-leq-total y1 'c)
                          (lambda (cy)
                            (if (equal? cy `(<= ,y1 c))
                                (begin
                                  (u4-ne-sym! y1 'c) (u4-ne-sym! 'c y1)
                                  (u4-and! `(<= ,y1 c) `(NOT (= ,y1 c)))
                                  (dk-chain-ass! (dk-cite! 'rr-le-ne-lt y1 'c))
                                  (dk-cite! 'rr-neg-closed y1) (u4-and! '(IN c RR) `(IN (- ,y1) RR)) (dk-cite! 'rr-add-closed 'c `(- ,y1))
                                  (dk-have! `(< 0 (+ c (- ,y1))) (lambda () (dk-ineq! `(< ,y1 c) `(IN ,y1 RR) '(IN c RR))))
                                  (second! `(+ c (- ,y1)) `((< 0 (+ c (- ,y1))) (IN (+ c (- ,y1)) RR))))
                                (begin
                                  (u4-ne-sym! y1 'c)
                                  (u4-and! `(<= c ,y1) `(NOT (= c ,y1)))
                                  (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 'c y1))
                                  (dk-cite! 'rr-neg-closed 'c) (u4-and! `(IN ,y1 RR) '(IN (- c) RR)) (dk-cite! 'rr-add-closed y1 '(- c))
                                  (dk-have! `(< 0 (+ ,y1 (- c))) (lambda () (dk-ineq! `(< c ,y1) `(IN ,y1 RR) '(IN c RR))))
                                  (second! `(+ ,y1 (- c)) `((< 0 (+ ,y1 (- c))) (IN (+ ,y1 (- c)) RR))))))))))))))))))
(qed 'ccr-remark-4-9-accumulation)
