              (dk-have! `(<= (* (+ ,dd (- ,nw)) ,np) 0)
                (lambda () (dk-ineq! h1 m0 `(= ,r1 (* ,np ,nw)) `(= (* ,np ,nw) (* ,nw ,np))
                                     `(= (* (+ ,dd (- ,nw)) ,np) (+ (* ,dd ,np) (- (* ,nw ,np))))
                                     `(IN ,r1 RR) `(IN ,(u4-n dif) RR) `(IN (* ,dd ,np) RR) `(IN (* ,np ,nw) RR)
