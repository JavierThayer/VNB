  (u4-dig-fun! a)
  (if (not (dk-asm? `(IN ,(u4-ps a n m) (CARR K)))) (dk-cite! 'nv-psum-type m 'K 'w a n))
  (u4-ps a n m))
;; X in CARR K and a nonzero element: land 0 < |X| and POS-RR |X|
