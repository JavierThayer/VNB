            (lambda () (dk-ineq! `(<= ,(u4-n (u4-d 'x sa1)) ,r1) `(= ,(u4-n (u4-d 'x sa1)) ,(u4-n (u4-d sa1 'x)))
                                 `(IN ,(u4-n (u4-d 'x sa1)) RR) `(IN ,(u4-n (u4-d sa1 'x)) RR) `(IN ,r1 RR))))
          (dk-chain-ass! (dk-cite! 'nv-ultra-le 'K sa1 'x sb1 r1))
