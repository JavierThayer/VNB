          (let* ((ab (u4-d ea eb)) (dif (u4-mul ab pnv)))
            (dk-cite! 'nf-neg-in-carr 'K eb) (dk-cite! 'nf-add-in-carr 'K ea (u4-neg eb))
            (dk-cite! 'nf-mul-in-carr 'K ab pnv)
