    z))

(define (u4-open-sep! name h)
  (let ((s (car (dk-landed (lambda () (mac-h name h))))))
    (dk-landed (lambda () (sep-me s)))))
;; |w| < 1 (w lies in its own principal ideal = M(A))
(define (u4-w-small!)
  (dk-cite! 'nv-domain-one 'K 'A)
  (dk-have! '(IN w (NV-PRINCIPAL K A w))
    (lambda ()
      (subst (dk-cite! 'nv-principal-unfold 'K 'A 'w))
      (in-sep! (lambda () (dk-ass!))
               (lambda () (ew '(ONE K)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (u4-crs! (list 'w)))))))))
  (let ((hm (dk-rewrite-h! '(IN w (NV-PRINCIPAL K A w)) '(NV-PRINCIPAL K A w) '(NV-MAXIMAL K A))))
    (u4-open-sep! 'nv-maximal-unfold hm)))
(define u4-dhyp '(IN dga (FUN ZZ RP)))

;; |S_(m+l) - S_m| <= |w^(n+m)|
(sp (make-wff `(FORALL l (IMPLIES (IN l NN) ,(u4-all
  `(FORALL dga (IMPLIES ,u4-dhyp (FORALL n (IMPLIES (IN n ZZ) (FORALL m (IMPLIES (IN m NN)
     (<= ,(u4-n (u4-d (u4-ps 'dga 'n '(+ m l)) (u4-ps 'dga 'n 'm))) ,(u4-n (u4-zp '(+ n m)))))))))))))))
(let* ((r (dk-use-induction-fixed! '(K A w RP dga n m)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (v (cdr (assq 'var r))))
  (dk-focus! base)
  (u4-setup!)
  (u4-nr! 'm) (u4-nz! 'm) (u4-zz-add! 'n 'm)
  (let* ((bd (u4-n (u4-zp! '(+ n m)))) (sm (u4-ps! 'dga 'n 'm)))
    (u4-typek! (u4-zp '(+ n m)))
    (dk-have! '(= (+ m 0) m) (lambda () (crs)))
    (subst '(= (+ m 0) m))
    (subst (u4-ring-eq! `(= ,(u4-d sm sm) (ZERO K)) (list sm)))
    (subst '(= ((FNRM K) (ZERO K)) 0))
    (dk-close-if-asm!))
  (dk-focus! step)
  (u4-setup!)
  (dk-cite! 'nv-domain-field 'K 'A)
  (u4-nr! 'm) (u4-nz! 'm) (u4-nr! v) (u4-nz! v) (u4-zz-add! 'n 'm) (u4-zr! 'n)
  (let* ((ml `(+ m ,v)) (sm (u4-ps! 'dga 'n 'm)) (bd (u4-n (u4-zp! '(+ n m)))))
    (u4-and! '(IN m NN) `(IN ,v NN)) (dk-cite! 'nn-add-closed 'm v) (u4-nr! ml) (u4-nz! ml)
    (dk-cite! 'nn-add-succ 'm v)
    (subst `(= (+ m (succ ,v)) (succ ,ml)))
    (subst (dk-cite! 'nv-psum-succ 'K 'w 'dga 'n ml))
    (let* ((sml (u4-ps! 'dga 'n ml)) (tt (u4-term! 'dga 'n ml)) (u (u4-d sml sm))
           (pj (u4-zp `(+ n ,ml))) (aj `(dga (+ n ,ml))))
      (dk-cite! 'nf-neg-in-carr 'K sm)
      (dk-cite! 'nf-add-in-carr 'K sml (u4-neg sm))
      (dk-cite! 'nf-add-in-carr 'K u tt)
      (subst (u4-ring-eq! `(= ,(u4-d (u4-add sml tt) sm) ,(u4-add u tt)) (list sml aj pj sm)))
      (u4-typek! u) (u4-typek! tt) (u4-typek! (u4-add u tt)) (u4-typek! pj) (u4-typek! (u4-zp '(+ n m)))
      (let* ((h0 (dk-cite! 'nv-ultra 'K u tt))
             (m0 (dk-cite! 'nf-norm-mult 'K aj pj))
             (na (u4-n aj)) (np (u4-n pj)))
        (dk-chain-ass! (dk-cite! 'rr-mul-le-right na 1 np))
        (u4-rr-mul! na np) (u4-rr-mul! 1 np)
        (dk-have! `(= (* 1 ,np) ,np) (lambda () (crs)))
        ;; |w^((n+m)+v)| <= |w^(n+m)|
        (u4-zz-add! '(+ n m) v)
        (dk-have! `(= (+ (+ n m) ,v) (+ n ,ml)) (lambda () (crs)))
        (let* ((mo0 (dk-chain-ass! (dk-cite! 'nv-zpow-norm-mono v 'K 'w '(+ n m))))
               (mo (dk-rewrite-h! mo0 `(+ (+ n m) ,v) `(+ n ,ml))))
          (dk-cite! 'rr-max-closed (u4-n u) (u4-n tt))
          (dk-have! `(<= ,(u4-n tt) ,bd)
            (lambda () (dk-ineq! m0 `(<= (* ,na ,np) (* 1 ,np)) `(= (* 1 ,np) ,np) mo
                                 `(IN (* ,na ,np) RR) `(IN (* 1 ,np) RR) `(IN ,np RR) `(IN ,(u4-n tt) RR) `(IN ,bd RR))))
          (dk-chain-ass! (dk-cite! 'rr-max-le (u4-n u) (u4-n tt) bd))
          (dk-ineq! h0 `(<= (MAX ,(u4-n u) ,(u4-n tt)) ,bd) `(IN (MAX ,(u4-n u) ,(u4-n tt)) RR)
                    `(IN ,(u4-n (u4-add u tt)) RR) `(IN ,bd RR)))))))
(qed 'nv-tail-ind)

(define (u4-seq a n) `(VNB-LAMBDA nem_ NN (NV-PSUM K w ,a ,n nem_)))

;; a series converging to x has |x - S_m| <= |w^(n+m)|
(sp (make-wff (u4-all
  `(FORALL dga (IMPLIES ,u4-dhyp (FORALL n (IMPLIES (IN n ZZ) (FORALL x
     (IMPLIES (CONVERGES-TO (NF-METRIC-SPACE K) ,(u4-seq 'dga 'n) x)
       (FORALL m (IMPLIES (IN m NN) (<= ,(u4-n (u4-d 'x (u4-ps 'dga 'n 'm))) ,(u4-n (u4-zp '(+ n m)))))))))))))))
(dk-peel!)
(u4-setup!)
(dk-cite! 'nv-domain-field 'K 'A)
(u4-nr! 'm) (u4-nz! 'm) (u4-zz-add! 'n 'm)
(let* ((sm (u4-ps! 'dga 'n 'm)) (z (u4-zp-pos! '(+ n m))) (bd (u4-n z)))
  (u4-typek! z)
  (dk-iff-fwd! (dk-cite! 'converges-to '(NF-METRIC-SPACE K) (u4-seq 'dga 'n) 'x))
  (dk-cite! 'nf-metric-carrier 'K)
  (dk-have! '(IN x (CARR K)) (lambda () (subst '(== (CARR K) (PTS (NF-METRIC-SPACE K)))) (dk-close-if-asm!)))
  (let* ((law (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h 'DIST))) "the limit law"))
         (n1 (dk-skolem! (dk-chain-ass! (dk-apply! law bd))))
         (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n1) (dk-contains? h 'DIST))) "the tail law"))
         (mm `(+ m ,n1)))
    (u4-and! '(IN m NN) `(IN ,n1 NN)) (dk-cite! 'nn-add-closed 'm n1)
    (dk-cite! 'nn-zero-le 'm) (u4-nr! n1) (u4-nr! mm)
    (dk-have! `(<= ,n1 ,mm) (lambda () (dk-ineq! '(<= 0 m) '(IN m RR) `(IN ,n1 RR))))
    (let* ((smm (u4-ps! 'dga 'n mm))
           (h0 (dk-chain-ass! (dk-apply! lw mm)))
           (h1 (dk-landed-1 (lambda () (dk-lam-b-h! h0))))
           (d0 (dk-cite! 'nf-metric-distance 'K smm 'x))
           (h2 (dk-rewrite-h! h1 `((DIST (NF-METRIC-SPACE K)) ,smm x) (caddr d0))))
      (dk-cite! 'nf-norm-sub-sym 'K 'x smm)
      (for-each (lambda (y) (dk-cite! 'nf-neg-in-carr 'K y)) (list 'x smm))
      (dk-cite! 'nf-add-in-carr 'K 'x (u4-neg smm)) (dk-cite! 'nf-add-in-carr 'K smm (u4-neg 'x))
      (u4-typek! (u4-d 'x smm)) (u4-typek! (u4-d smm 'x))
      (dk-have! `(<= ,(u4-n (u4-d 'x smm)) ,bd)
        (lambda () (dk-ineq! h2 `(= ,(u4-n (u4-d 'x smm)) ,(u4-n (u4-d smm 'x))) `(IN ,(u4-n (u4-d 'x smm)) RR)
                             `(IN ,(u4-n (u4-d smm 'x)) RR) `(IN ,bd RR))))
      (dk-cite! 'nv-tail-ind n1 'K 'A 'w 'RP 'dga 'n 'm)
      (u4-typek! z)
      (dk-chain-ass! (dk-cite! 'nv-ultra-le 'K 'x smm sm bd))
      (dk-close-if-asm!))))
(qed 'nv-tail)

;;; -----------------------------------------------------------------------
;;; C. padding by zeros

(define u4-ag '(NORMED-FIELD-ADDITIVE-AG K))
(define (u4-iden!)
  (if (not (dk-asm? `(== (IDEN ,u4-ag) (ZERO K))))
      (dk-have! `(== (IDEN ,u4-ag) (ZERO K)) (lambda () (mac 'normed-field-additive-ag) (slot 'IDEN) (nth-r) (qrfl)))))
;; the IS-NV-EXPANSION laws, landed from a hypothesis (kept)
(define (u4-open-exp! a n x)
  (dk-split-all! (list (dk-project!
    `(AND (IN ,a (FUN ZZ RP))
          (AND (FORALL nei_ (IMPLIES (IN nei_ ZZ) (IMPLIES (< nei_ ,n) (= (,a nei_) (ZERO K)))))
               (CONVERGES-TO (NF-METRIC-SPACE K) ,(u4-seq a n) ,x)))
    'is-nv-expansion `(IS-NV-EXPANSION K w RP ,a ,n ,x)))))
(define (u4-zero-law a n)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(ZERO K)) (dk-contains? h a) (dk-contains? h n)
                            (not (dk-contains? h 'DIST)) (not (dk-contains? h 'NV-PSUM))))
           "the zero law"))

;; with dga = 0 below n = l + d: S^l_(d+m) = S^n_m
(sp (make-wff `(FORALL m (IMPLIES (IN m NN) ,(u4-all
  `(FORALL dga (IMPLIES ,u4-dhyp (FORALL l (IMPLIES (IN l ZZ) (FORALL d (IMPLIES (IN d NN) (FORALL n (IMPLIES (IN n ZZ)
    (IMPLIES (= (+ l d) n) (IMPLIES (FORALL kz (IMPLIES (IN kz ZZ) (IMPLIES (< kz n) (= (dga kz) (ZERO K)))))
      (= (NV-PSUM K w dga l (+ d m)) (NV-PSUM K w dga n m)))))))))))))))))
(let* ((r (dk-use-induction-fixed! '(K A w RP dga l d n)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (v (cdr (assq 'var r))))
  (dk-focus! base)
  (u4-setup!)
  (u4-dig-fun! 'dga)
  (u4-iden!)
  (u4-nr! 'd) (u4-zr! 'l) (u4-zr! 'n)
  (dk-have! '(= (+ d 0) d) (lambda () (crs)))
  (subst '(= (+ d 0) d))
  (subst (dk-cite! 'nv-psum-zero 'K 'w 'dga 'n))
  (mac 'NV-PSUM) (mac 'NV-TERM)
  (dk-cite! 'normed-field-additive-ag-is-abelian-group 'K)
  (let* ((zl (u4-zero-law 'dga 'n))
         (g (dk-goal)) (lam (caddr (cadr g))))
    (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT d)) (= (,lam i_) (IDEN ,u4-ag))))
      (lambda ()
        (let ((i (dk-di-var!)))
          (dk-chain-ass! (dk-cite! 'ord-segment-nn-subset 'd i))
          (dk-iff-fwd! (dk-cite! 'seg-mem-lt 'd i))
          (u4-nr! i) (u4-nz! i)
          (dk-lam-b!)
          (u4-zz-add! 'l i)
          (u4-zp! `(+ l ,i))
          (dk-have! `(< (+ l ,i) n) (lambda () (dk-ineq! `(< ,i d) '(= (+ l d) n) `(IN ,i RR) '(IN d RR) '(IN l RR) '(IN n RR))))
          (dk-chain-ass! (dk-apply! zl `(+ l ,i)))
          (subst `(= (dga (+ l ,i)) (ZERO K)))
          (subst `(== (IDEN ,u4-ag) (ZERO K)))
          (u4-crs! (list (u4-zp `(+ l ,i)))))))
    (dk-chain-ass! (dk-cite! 'sum-ag-all-id-ind 'd u4-ag lam))
    (subst `(= (SUM-AG ,u4-ag ,lam d) (IDEN ,u4-ag)))
    (subst `(== (IDEN ,u4-ag) (ZERO K)))
    (rfl))
  (dk-focus! step)
  (u4-setup!)
  (u4-dig-fun! 'dga)
  (u4-nr! 'd) (u4-nr! v) (u4-nz! v) (u4-zr! 'l) (u4-zr! 'n)
  (let ((dm `(+ d ,v)))
    (u4-and! '(IN d NN) `(IN ,v NN)) (dk-cite! 'nn-add-closed 'd v) (u4-nr! dm)
    (dk-cite! 'nn-add-succ 'd v)
    (subst `(= (+ d (succ ,v)) (succ ,dm)))
    (subst (dk-cite! 'nv-psum-succ 'K 'w 'dga 'l dm))
    (subst (dk-cite! 'nv-psum-succ 'K 'w 'dga 'n v))
    (subst ih)
    (dk-have! `(= (+ l ,dm) (+ n ,v)) (lambda () (subst '(= n (+ l d))) (crs)))
    (subst `(= (+ l ,dm) (+ n ,v)))
    (let* ((sv (u4-ps! (quote dga) (quote n) v)) (tv (u4-term! (quote dga) (quote n) v)))
      (dk-cite! 'nf-add-in-carr 'K sv tv)
      (rfl))))
(qed 'nv-pad-psum)

;; an expansion from n is one from every l <= n
(sp (make-wff (u4-all
  `(FORALL dga (FORALL n (IMPLIES (IN n ZZ) (FORALL x (IMPLIES (IS-NV-EXPANSION K w RP dga n x)
     (FORALL l (IMPLIES (IN l ZZ) (IMPLIES (<= l n) (IS-NV-EXPANSION K w RP dga l x))))))))))))
(dk-peel!)
(u4-setup!)
(dk-cite! 'nv-domain-field 'K 'A)
(fact 'nn-is-set)
(u4-open-exp! 'dga 'n 'x)
(u4-dig-fun! 'dga)
(u4-zr! 'l) (u4-zr! 'n)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(let* ((seqn (u4-seq 'dga 'n))
       (d '(+ n (- l))))
  (dk-iff-fwd! (dk-cite! 'converges-to '(NF-METRIC-SPACE K) seqn 'x))
  (dk-cite! 'zz-neg-closed 'l) (u4-zz-add! 'n '(- l))
  (dk-have! `(<= 0 ,d) (lambda () (dk-ineq! '(<= l n) '(IN l RR) '(IN n RR))))
  (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn d))
  (let* ((dv (dk-name! d 'NN))
         (zl (u4-zero-law 'dga 'n))
         (nlaw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h 'DIST))) "the limit law")))
    (u4-nr! dv)
    (dk-have! `(= (+ l ,dv) n) (lambda () (subst `(= ,dv ,d)) (crs)))
    (mac 'IS-NV-EXPANSION)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (dk-ass!))
            ((dk-head-is? g 'FORALL)
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (k (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'ZZ))) landed))))
               (u4-zr! k)
               (dk-have! `(< ,k n) (lambda () (dk-ineq! `(< ,k l) '(<= l n) `(IN ,k RR) '(IN l RR) '(IN n RR))))
               (dk-chain-ass! (dk-apply! zl k))
               (dk-close-if-asm!)))
            (#t
             (mac 'CONVERGES-TO)
             (dk-conj-close!
               (lambda ()
                 (let ((g2 (dk-goal)))
                   (cond
                     ((dk-asm? g2) (dk-ass!))
                     ((and (dk-head-is? g2 'IN) (equal? (caddr g2) '(PTS (NF-METRIC-SPACE K))) (eq? (cadr g2) 'x))
                      (dk-close-if-asm!))
                     ((dk-head-is? g2 'IN)
                      (subst '(== (PTS (NF-METRIC-SPACE K)) (CARR K)))
                      (dk-each-leaf! (lambda () (lam-t))
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'FORALL)
                              (let ((m (dk-di-var!)))
                                (u4-ps! 'dga 'l m)
                                (dk-close-if-asm!))
                              (dk-close-if-asm!)))))
                     (#t
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) landed)))
                             (n1 (dk-skolem! (dk-chain-ass! (dk-apply! nlaw eps))))
                             (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n1) (dk-contains? h 'DIST))) "the tail law"))
                             (wt `(+ ,dv ,n1)))
                        (u4-and! `(IN ,dv NN) `(IN ,n1 NN)) (dk-cite! 'nn-add-closed dv n1) (u4-nr! n1)
                        (ew wt)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                                       (mp (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) landed2)))
                                       (j `(+ ,mp (- ,dv))))
                                  (dk-lam-b!)
                                  (u4-nr! mp) (u4-nz! mp) (u4-nz! dv)
                                  (dk-cite! 'zz-neg-closed dv)
                                  (u4-zz-add! mp `(- ,dv))
                                  (dk-cite! 'nn-zero-le n1)
                                  (dk-have! `(<= 0 ,j) (lambda () (dk-ineq! `(<= ,wt ,mp) `(<= 0 ,n1) `(IN ,mp RR) `(IN ,dv RR) `(IN ,n1 RR))))
                                  (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn j))
                                  (let ((jv (dk-name! j 'NN)))
                                    (u4-nr! jv)
                                    (dk-have! `(= (+ ,dv ,jv) ,mp) (lambda () (subst `(= ,jv ,j)) (crs)))
                                    (subst `(= ,mp (+ ,dv ,jv)))
                                    (subst (dk-chain-ass! (dk-cite! 'nv-pad-psum jv 'K 'A 'w 'RP 'dga 'l dv 'n)))
                                    (dk-have! `(<= ,n1 ,jv) (lambda () (dk-ineq! `(<= ,wt ,mp) `(= (+ ,dv ,jv) ,mp) `(IN ,mp RR) `(IN ,dv RR) `(IN ,n1 RR) `(IN ,jv RR))))
                                    (let ((h0 (dk-chain-ass! (dk-apply! lw jv))))
                                      (dk-lam-b-h! h0)
                                      (dk-close-if-asm!))))))))))))))))))))
(qed 'nv-pad)

;;; -----------------------------------------------------------------------
;;; D. uniqueness

;; two expansions from the same n have the same digits below n + nb
(sp (make-wff `(FORALL nb (IMPLIES (IN nb NN) ,(u4-all
  `(FORALL dga (FORALL dgb (FORALL n (IMPLIES (IN n ZZ) (FORALL x
     (IMPLIES (IS-NV-EXPANSION K w RP dga n x) (IMPLIES (IS-NV-EXPANSION K w RP dgb n x)
       (FORALL j (IMPLIES (IN j NN) (IMPLIES (< j nb) (= (dga (+ n j)) (dgb (+ n j))))))))))))))))))
(let* ((r (dk-use-induction-fixed! '(K A w RP dga dgb n x)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (nv (cdr (assq 'var r))))
  (dk-focus! base)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (lt (find-first (lambda (q) (dk-head-is? q '<)) landed)))
    (dk-nn-absurd! lt))
  (dk-focus! step)
  (u4-setup!)
  (dk-cite! 'nv-domain-field 'K 'A)
  (u4-w-small!)
  (u4-open-exp! 'dga 'n 'x) (u4-open-exp! 'dgb 'n 'x)
  (u4-dig-fun! 'dga) (u4-dig-fun! 'dgb)
  (u4-zr! 'n) (u4-nr! nv) (u4-nz! nv)
  (dk-cite! 'nn-succ-closed nv) (u4-nz! `(succ ,nv)) (u4-nr! `(succ ,nv))
  (dk-cite! 'nf-metric-carrier 'K)
  (dk-iff-fwd! (dk-cite! 'converges-to '(NF-METRIC-SPACE K) (u4-seq 'dga 'n) 'x))
  (dk-have! '(IN x (CARR K)) (lambda () (subst '(== (CARR K) (PTS (NF-METRIC-SPACE K)))) (dk-close-if-asm!)))
  (let* ((nn1 `(+ n ,nv)) (sa (u4-ps! 'dga 'n nv)) (sb (u4-ps! 'dgb 'n nv))
         (sa1 (u4-ps! 'dga 'n `(succ ,nv))) (sb1 (u4-ps! 'dgb 'n `(succ ,nv)))
         (ta (u4-term! 'dga 'n nv)) (tb (u4-term! 'dgb 'n nv))
         (ea `(dga ,nn1)) (eb `(dgb ,nn1)) (pnv (u4-zp nn1)) (np (u4-n pnv)) (nw (u4-n 'w)))
    (dk-have! `(= ,ea ,eb)
      (lambda ()
        ;; S^a_nv == S^b_nv by the induction hypothesis
        (dk-have! `(== ,sa ,sb)
          (lambda ()
            (mac 'NV-PSUM) (mac 'NV-TERM)
            (let* ((g (dk-goal)) (la (caddr (cadr g))) (lb (caddr (caddr g))))
              (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT ,nv)) (== (,la i_) (,lb i_))))
                (lambda ()
                  (let ((i (dk-di-var!)))
                    (dk-chain-ass! (dk-cite! 'ord-segment-nn-subset nv i))
                    (dk-iff-fwd! (dk-cite! 'seg-mem-lt nv i))
                    (dk-lam-b!)
                    (dk-chain-ass! (dk-apply! ih i))
                    (subst `(= (dga (+ n ,i)) (dgb (+ n ,i))))
                    (qrfl))))
              (dk-chain-ass! (dk-cite! 'sum-ag-segment-congruence nv u4-ag la lb))
              (dk-close-if-asm!))))
        ;; the tails at nv + 1
        (u4-zz-add! 'n `(succ ,nv))
        (let* ((z1 (u4-zp-pos! `(+ n (succ ,nv)))) (r1 (u4-n z1)))
          (u4-typek! z1)
          (dk-chain-ass! (dk-cite! 'nv-tail 'K 'A 'w 'RP 'dga 'n 'x `(succ ,nv)))
          (dk-chain-ass! (dk-cite! 'nv-tail 'K 'A 'w 'RP 'dgb 'n 'x `(succ ,nv)))
          (for-each (lambda (y) (dk-cite! 'nf-neg-in-carr 'K y)) (list 'x sa1 sb1))
          (dk-cite! 'nf-add-in-carr 'K 'x (u4-neg sa1)) (dk-cite! 'nf-add-in-carr 'K sa1 (u4-neg 'x))
