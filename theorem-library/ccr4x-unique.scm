            (let* ((h1 (dk-rewrite-h! `(<= ,(u4-n (u4-d sa1 sb1)) ,r1) (u4-d sa1 sb1) dif))
                   (m0 (dk-cite! 'nf-norm-mult 'K ab pnv))
                   (dd (u4-n ab)))
              (dk-cite! 'nn-succ-plus-one nv)
              (u4-zz-add! nn1 1)
