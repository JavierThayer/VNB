;;; ---- the average lemma: for a finite s in B, a point u of B and delta > 0 with dist(u, y) <= D - delta for
;;;      every y of B within rad of a point of s (D bounds the distances in B, rad < D) ----
(define (hc-Q s)
  (list 'FORSOME 'hvu_ (list 'AND '(IN hvu_ bb) (list 'FORSOME 'hvd_ (list 'AND '(IN hvd_ RR) (list 'AND '(< 0 hvd_)
    (list 'AND '(<= hvd_ (- dia rad))
      (list 'FORALL 'hvc_ (list 'IMPLIES (list 'IN 'hvc_ s) (list 'FORALL 'hvy_ (list 'IMPLIES '(IN hvy_ bb)
        (list 'IMPLIES (list '<= (hc-D 'hvc_ 'hvy_) 'rad) (list '<= (hc-D 'hvu_ 'hvy_) '(- dia hvd_))))))))))))))
(define hc-BC (list 'SEP 'hsz_ 'SET (list 'IMPLIES '(SUBSET hsz_ bb) (hc-Q 'hsz_))))
(define hc-avg-hyps (list '(SUBSET bb (VEC m)) '(IS-CONVEX-SUBSET m bb) '(FORSOME hvz_ (IN hvz_ bb))
                          '(IN dia RR) '(IN rad RR) '(< rad dia) (hc-diam-up 'bb 'dia)))
(define hc-ind
  (let ((ind0 (lookup-theorem 'finite-set-induction)))
    (subst-free (quantifier-var ind0) hc-BC (quantifier-body ind0))))
(define hc-hbase (cadr (cadr hc-ind)))
(define hc-hstep (caddr (cadr hc-ind)))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(bb dia rad)
   (hc-imps hc-avg-hyps (list 'FORALL 'fs (hc-imps '((IN fs SET) (IN (CARD fs) NN) (SUBSET fs bb)) (hc-Q 'fs)))))))))
(dk-peel!)
(hc-msetup!)
(let* ((z0 (dk-skolem! (dk-ctx-form '(FORSOME hvz_ (IN hvz_ bb)))))
       (lawb (cadr (hc-parts! 'is-convex-subset '(m bb) '(IS-CONVEX-SUBSET m bb))))
       (diamf (dk-ctx-form (hc-diam-up 'bb 'dia))))
  (define (base-close!)
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (dk-ass!))
            ((dk-head-is? g 'FORSOME) (ew '(- dia rad)) (dk-conj-close! base-close!))
            ((dk-head-is? g 'FORALL)
             (let* ((ld (dk-peel!))
                    (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'EMPTY-SET))) ld))))
               (ai (dk-cite! 'empty-set-has-no-members c))))
            ((dk-head-is? g 'IN) (dk-real! (cadr g)))
            (#t (dk-ineq! '(< rad dia) '(IN dia RR) '(IN rad RR))))))
  (dk-have! hc-hbase
    (lambda ()
      (in-sep! (lambda () (fact 'empty-set-is-set) (dk-ass!))
               (lambda () (di) (ew z0) (dk-conj-close! base-close!)))))
  (dk-have! hc-hstep
    (lambda ()
      (dk-split-all! (filter (lambda (f) (dk-head-is? f 'AND)) (dk-peel!)))
      (let* ((gl (dk-goal)) (u (cadr gl)) (s0 (cadr u)) (pxx (caddr u)) (x0 (cadr pxx))
             (ih (begin (dk-landed (lambda () (sep-me (list 'IN s0 hc-BC))))
                        (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list 'SUBSET s0 'bb))))
                                 "the class property of the smaller set"))))
        (in-sep!
          (lambda ()
            (dk-meta-and! (list 'IN x0 'SET) (list 'IN x0 'SET))
            (dk-cite! 'pairing x0 x0)
            (dk-meta-and! (list 'IN s0 'SET) (list 'IN pxx 'SET))
            (dk-cite! 'union-set-closure s0 pxx)
            (dk-ass!))
          (lambda ()
            (di)
            (dk-cite! 'pair-self-member x0)
            (hc-union-in! x0 s0 pxx #f)
            (dk-cite! 'subset-mem-fwd u 'bb x0)
            (dk-have! (list 'SUBSET s0 'bb)
              (lambda () (mac 'subset-def)
                         (let ((z (dk-di-var!)))
                           (hc-union-in! z s0 pxx #t)
                           (dk-cite! 'subset-mem-fwd u 'bb z)
                           (dk-ass!))))
            (detach! ih)
            (let* ((u0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h s0))) "Q of the smaller set") #t))
                   (d0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h s0) (dk-contains? h u0))) "its delta") #t))
                   (_ (dk-split-all!))
                   (qf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u0) (dk-contains? h d0))) "its bound"))
                   (w (hc-cvx u0 x0 1/2)) (d1 (list '* 1/2 d0)))
              (dk-cite! 'subset-mem-fwd 'bb '(VEC m) u0)
              (dk-cite! 'subset-mem-fwd 'bb '(VEC m) x0)
              (dk-real! 1/2)
              (dk-have! '(<= 0 1/2) (lambda () (dk-ineq!)))
              (dk-have! '(<= 1/2 1) (lambda () (dk-ineq!)))
              (dk-apply! lawb u0 x0 1/2)
              (dk-real! d1)
              (letrec ((step-close! (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (dk-ass!))
                        ((dk-head-is? g 'FORSOME) (ew d1) (dk-conj-close! step-close!))
                        ((and (dk-head-is? g '<) (equal? (cadr g) 0)) (dk-ineq! (list '< 0 d0) (list 'IN d0 'RR)))
                        ((dk-head-is? g '<=)
                         (dk-ineq! (list '<= d0 '(- dia rad)) (list '< 0 d0) (list 'IN d0 'RR) '(IN dia RR) '(IN rad RR)))
                        ((dk-head-is? g 'FORALL)
                         (let* ((ld (dk-peel!))
                                (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) u))) ld)))
                                (y (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'bb))) ld)))
                                (a (hc-D u0 y)) (b (hc-D x0 y)) (pa (list '* '(- 1 1/2) a)))
                           (dk-cite! 'subset-mem-fwd 'bb '(VEC m) y)
                           (hc-dreal! w y) (hc-dreal! u0 y) (hc-dreal! x0 y)
                           (let ((ee (dk-cite! 'nvs-dist-convex-combination 'm u0 x0 y 1/2)))
                             (dk-real! pa)
                             (let ((eq (list '= pa (list '* 1/2 a))))
                               (dk-have! eq (lambda () (crs)))
                               (dk-apply! diamf u0 y) (dk-apply! diamf x0 y)
                               (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'union-membership s0 pxx c))))
                               (let ((typs (list (list 'IN (hc-D w y) 'RR) (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN pa 'RR)
                                                 (list 'IN d0 'RR) '(IN dia RR) '(IN rad RR))))
                                 (use-em (list 'IN c s0)
                                   (lambda ()
                                     (dk-apply! qf c y)
                                     (apply dk-ineq! (append (list ee eq (list '<= a (list '- 'dia d0)) (list '<= b 'dia)) typs)))
                                   (lambda ()
                                     (dk-have! (list 'IN c pxx)
                                       (lambda () (if (dk-only! (list 'OR (list 'IN c s0) (list 'IN c pxx)) (list 'NOT (list 'IN c s0))) (prop))))
                                     (dk-cite! 'pair-self-eq x0 c)
                                     (dk-rewrite-h! (list '<= (hc-D c y) 'rad) c x0)
                                     (apply dk-ineq! (append (list ee eq (list '<= a 'dia) (list '<= b 'rad) (list '<= d0 '(- dia rad))) typs)))))))))
                        ((dk-head-is? g 'IN) (dk-real! (cadr g)))
                        (#t (error "hc step: unexpected goal" (expression->string g))))))))
              (ew w)
              (dk-conj-close! step-close!))))))))
  (dk-meta-and! hc-hbase hc-hstep)
  (dk-cite! 'finite-set-induction hc-BC)
  (dk-meta-and! '(IN fs SET) '(IN (CARD fs) NN))
  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h hc-BC) (not (dk-contains? h 'EMPTY-SET)))) "the induction conclusion") 'fs)
  (dk-landed (lambda () (sep-me (list 'IN 'fs hc-BC))))
  (detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) '(SUBSET fs bb)))) "the property of fs"))
  (dk-ass!))
(hc-qed! 'nvs-net-average)

;;; ---- a minimal nonempty closed convex invariant set has diameter zero ----
(define hc-mp-hyps (list '(IS-NORMED-VECTOR-SPACE m) '(SUBSET aa (VEC m)) (list 'IS-COMPACT hc-sA-ms)
   '(IS-AFFINE-ISOMETRY-GROUP m aa gs) '(IS-INVARIANT-CCS m aa gs bb)
   '(FORALL hmc_ (IMPLIES (IS-INVARIANT-CCS m aa gs hmc_) (IMPLIES (SUBSET hmc_ bb) (SUBSET bb hmc_))))))
(sp (make-wff (hc-alls '(m aa gs bb) (hc-imps hc-mp-hyps
   (list 'FORALL 'hzx_ (list 'IMPLIES '(IN hzx_ bb) (list 'FORALL 'hzy_ (list 'IMPLIES '(IN hzy_ bb) (list '<= (hc-D 'hzx_ 'hzy_) 0)))))))))
(dk-peel!)
(hc-asetup!)
(let* ((tm (cadr (dk-goal))) (x (cadr tm)) (y (caddr tm))
       (pb (hc-ccs-parts! 'bb))
       (convb (cadr (hc-parts! 'is-convex-subset '(m bb) '(IS-CONVEX-SUBSET m bb)))) (closb (list-ref pb 3)) (invb (list-ref pb 4))
       (pg (hc-parts! 'is-affine-isometry-group '(m aa gs) '(IS-AFFINE-ISOMETRY-GROUP m aa gs)))
       (isof (list-ref pg 2)) (invf (list-ref pg 3))
       (minf (dk-ctx-form (list-ref hc-mp-hyps 5))))
  (hc-up! x 'bb) (hc-up! y 'bb) (hc-dreal! x y)
  (fact 'rr-zero-in)
  (use-em (list '<= (hc-D x y) 0)
    (lambda () (dk-ass!))
    (lambda ()
      (dk-cite! 'rr-not-le-lt (hc-D x y) 0)
      (dk-cite! 'subset-trans 'bb 'aa '(VEC m))
      (let* ((dia (dk-skolem! (dk-cite! 'nvs-diameter-sup 'm 'aa 'bb) #t))
             (_ (dk-split-all!))
             (upf (dk-ctx-form (hc-diam-up 'bb dia)))
             (witf (dk-ctx-form (hc-diam-wit 'bb dia)))
             (rad (list '* 1/2 dia)))
        (dk-apply! upf x y)
        (dk-real! rad)
        (dk-have! (list '< 0 rad) (lambda () (dk-ineq! (list '< 0 (hc-D x y)) (list '<= (hc-D x y) dia) (list 'IN dia 'RR) (list 'IN (hc-D x y) 'RR))))
        (dk-have! (list '< rad dia) (lambda () (dk-ineq! (list '< 0 rad) (list 'IN dia 'RR))))
        (let* ((fnet (dk-skolem! (dk-cite! 'nvs-compact-subset-net 'm 'aa 'bb rad) #t))
               (_2 (dk-split-all!))
               (netf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h fnet) (dk-contains? h 'FORSOME))) "the net"))
               (u (dk-skolem! (dk-cite! 'nvs-net-average 'm 'bb dia rad fnet) #t))
               (d0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u) (dk-contains? h fnet))) "delta") #t))
               (_3 (dk-split-all!))
               (qf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h d0) (dk-contains? h fnet))) "the bound"))
               (rho (list '- dia d0))
               (cap (hc-cap 'bb rho))
               (allc (list 'FORALL 'hcy_ (list 'IMPLIES '(IN hcy_ bb) (list '<= (hc-D u 'hcy_) rho)))))
          (dk-real! rho)
          ;; u is within rho of every point of B
          (dk-have! allc
            (lambda ()
              (let* ((p (dk-di-var!))
                     (c (dk-skolem! (dk-apply! netf p) #t)))
                (dk-split-all!)
                (dk-apply! qf c p)
                (dk-ass!))))
          ;; the cap C is an invariant closed convex subset of B
          (hc-subset! cap 'bb (lambda (z) (hc-sep-out! z cap) (dk-ass!)))
          (hc-subset! cap 'aa (lambda (z) (hc-sep-out! z cap) (dk-cite! 'subset-mem-fwd 'bb 'aa z) (dk-ass!)))
          (hc-subset! cap '(VEC m) (lambda (z) (hc-sep-out! z cap) (hc-up! z 'bb) (dk-ass!)))
          (hc-sep-in! u cap)
          (dk-have! (list 'FORSOME 'icz_ (list 'IN 'icz_ cap)) (lambda () (ew u) (dk-ass!)))
          (dk-have! (list 'IS-CONVEX-SUBSET 'm cap)
            (lambda ()
              (mac 'is-convex-subset)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld (dk-peel!))
                             (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) cap))) ld)))
                             (z1 (car zs)) (z2 (cadr zs))
                             (tt (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
                             (c1 (hc-sep-out! z1 cap)) (c2 (hc-sep-out! z2 cap)))
                        (dk-apply! convb z1 z2 tt)
                        (hc-up! z1 'bb) (hc-up! z2 'bb)
                        (in-sep! (lambda () (dk-ass!))
                          (lambda ()
                            (let ((yy (dk-di-var!)))
                              (hc-up! yy 'bb)
                              (dk-apply! (dk-ctx-form c1) yy) (dk-apply! (dk-ctx-form c2) yy)
                              (dk-cite! 'nvs-dist-convex-ball 'm z1 z2 yy tt rho)
                              (dk-ass!))))))))))
          (dk-cite! 'nvs-dist-cap-closed 'm 'aa 'bb rho)
          (dk-have! (list 'FORALL 'icf_ (list 'IMPLIES '(IN icf_ gs) (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ cap) (list 'IN '(icf_ icx_) cap)))))
            (lambda ()
              (let* ((ld (dk-peel!))
                     (g (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'gs))) ld)))
                     (z (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) cap))) ld)))
                     (cz (hc-sep-out! z cap))
                     (gz (list g z)))
                (dk-apply! invb g z)
                (hc-up! z 'bb) (hc-up! gz 'bb)
                (let ((h (dk-skolem! (dk-apply! invf g) #t)))
                  (dk-split-all!)
                  (in-sep! (lambda () (dk-ass!))
                    (lambda ()
                      (let* ((yy (dk-di-var!)) (hy (list h yy)))
                        (hc-up! yy 'bb)
                        (dk-apply! invb h yy)
                        (hc-up! hy 'bb)
                        (let* ((e1 (dk-apply! isof g z hy))
                               (e2 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f h) (dk-contains? f g) (not (dk-contains? f 'gs)))) "the inverse law") yy))
                               (e3 (dk-rewrite-h! e1 (list g hy) yy)))
                          (dk-apply! (dk-ctx-form cz) hy)
                          (hc-dreal! gz yy) (hc-dreal! z hy)
                          (dk-ineq! e3 (list '<= (hc-D z hy) rho) (list 'IN (hc-D gz yy) 'RR) (list 'IN (hc-D z hy) 'RR)
                                    (list 'IN dia 'RR) (list 'IN d0 'RR))))))))))
          (hc-pow-in! cap)
          (dk-have! (list 'IS-INVARIANT-CCS 'm 'aa 'gs cap)
            (lambda () (mac 'is-invariant-ccs) (dk-conj-close! (lambda () (dk-ass!)))))
          ;; minimality: B lies in C; a pair of B farther apart than rho contradicts it
          (dk-apply! minf cap)
          (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list '<= d0 (list '- dia rad)) (list '< 0 rad) (list 'IN dia 'RR) (list 'IN d0 'RR))))
          (dk-have! (list '< rho dia) (lambda () (dk-ineq! (list '< 0 d0) (list 'IN dia 'RR) (list 'IN d0 'RR))))
          (let* ((x1 (dk-skolem! (dk-apply! witf rho) #t))
                 (y1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x1))) "the second point") #t)))
            (dk-split-all!)
            (dk-cite! 'subset-mem-fwd 'bb cap x1)
            (let ((cx (hc-sep-out! x1 cap)))
              (dk-apply! (dk-ctx-form cx) y1))
            (hc-up! x1 'bb) (hc-up! y1 'bb) (hc-dreal! x1 y1)
            (dk-absurd! (list '< rho (hc-D x1 y1)) (list '<= (hc-D x1 y1) rho) (list 'IN (hc-D x1 y1) 'RR)
                        (list 'IN dia 'RR) (list 'IN d0 'RR))))))))
(hc-qed! 'invariant-ccs-minimal-diameter-zero)

;;; ---- THEOREM 1.11: a group of affine isometries of a nonempty compact convex subset of a normed space has a
;;;      common fixed point ----
(sp (make-wff (hc-alls '(m aa gs) (hc-imps (list '(IS-NORMED-VECTOR-SPACE m) '(SUBSET aa (VEC m)) '(IS-CONVEX-SUBSET m aa)
      (list 'IS-COMPACT hc-sA-ms) '(FORSOME hfz_ (IN hfz_ aa)) '(IS-AFFINE-ISOMETRY-GROUP m aa gs))
   '(FORSOME hfw_ (AND (IN hfw_ aa) (FORALL hfg_ (IMPLIES (IN hfg_ gs) (= (hfg_ hfw_) hfw_)))))))))
(dk-peel!)
(hc-asetup!)
(let* ((pg (hc-parts! 'is-affine-isometry-group '(m aa gs) '(IS-AFFINE-ISOMETRY-GROUP m aa gs)))
       (sub (car pg)))
  (dk-cite! 'subset-refl 'aa)
  (dk-cite! 'carrier-is-closed hc-sA-ms)
  (dk-rewrite-h! (list 'IS-CLOSED hc-sA-ms (list 'PTS hc-sA-ms)) (list 'PTS hc-sA-ms) 'aa)
  (dk-have! '(FORALL icf_ (IMPLIES (IN icf_ gs) (FORALL icx_ (IMPLIES (IN icx_ aa) (IN (icf_ icx_) aa)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (g (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'gs))) ld)))
             (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'aa))) ld))))
        (dk-cite! 'subset-mem-fwd 'gs '(FUN aa aa) g)
        (dk-cite! 'fun-apply-type-c g 'aa 'aa x)
        (dk-ass!))))
  (dk-have! '(IS-INVARIANT-CCS m aa gs aa)
    (lambda () (mac 'is-invariant-ccs) (dk-conj-close! (lambda () (dk-ass!)))))
  (let* ((bb (dk-skolem! (dk-cite! 'invariant-ccs-minimal 'm 'aa 'gs) #t))
         (pb (hc-ccs-parts! bb))
         (invb (list-ref pb 4))
         (zf (dk-cite! 'invariant-ccs-minimal-diameter-zero 'm 'aa 'gs bb))
         (z0 (dk-skolem! (list-ref pb 1))))
    (hc-up! z0 bb)
    (ew z0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((g (dk-di-var!)) (gz (list g z0)) (dd (hc-D z0 gz)))
              (dk-apply! invb g z0)
              (hc-up! gz bb)
              (dk-apply! zf z0 gz)
              (hc-dreal! z0 gz)
              (dk-cite! 'metric-pos hc-ms z0 gz)
              (fact 'rr-zero-in)
              (dk-meta-and! (list 'IN dd 'RR) '(IN 0 RR))
              (dk-meta-and! (list '<= dd 0) (list '<= 0 dd))
              (dk-cite! 'rr-leq-antisymmetric dd 0)
              (dk-cite! 'metric-zero-eq hc-ms z0 gz)
              (subst (list '= gz z0))
              (rfl)))))))
(hc-qed! 'affine-isometry-fixed-point)

