;;; haar-fixed-point.scm -- THEOREM 1.11 OF THE COMPACT-GROUPS NOTES: a group of affine isometries of a nonempty
;;; norm-compact convex subset A of a real normed vector space has a common fixed point in A.
;;; Agent HAAR-C, 2026-11-09.  DESTINATION: theorem-library/haar-fixed-point.scm.  Library: analysis.
;;; Helper prefix: hc-.  Vocabulary: structure-library/hc-vocab.scm (IS-AFFINE-ISOMETRY-GROUP, IS-INVARIANT-CCS).
;;; LOAD WINDOW: after theorem-library/krein-milman (compact-chain-meet) and theorem-library/cvx-tb (the
;;; convex-combination distance laws; load.scm line 3985); nothing cites it yet.
;;;
;;; THE ROUTE (DeMarr's normal-structure argument; the notes' route by Krein-Milman and Lemma 1.13 is not used).
;;; Zorn over the nonempty closed convex invariant subsets ordered by reverse inclusion gives a minimal one, B
;;; (the meet of a chain is nonempty by compactness: compact-chain-meet).  If B had diameter D > 0: take a finite
;;; D/2-net F of B; by induction over F, averaging with midpoints, a point u of B and delta > 0 with
;;; dist(u, y) <= D - delta for every y of B; the cap {z in B : dist(z, y) <= D - delta for all y in B} is a
;;; nonempty closed convex invariant subset of B (invariant because each map is an isometry with an inverse in
;;; the group), so it is B by minimality, against D being the supremum of the distances.  Hence B is a point,
;;; and that point is fixed.
;;; Every qed modulo 0.

;;; ======== from hc-p1.scm ========
;;; hc-p1.scm -- HAAR-C part 1: helpers; the distance from a convex combination.
(define (hc-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; HC OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (hc-alls vs body) (if (null? vs) body (list 'FORALL (car vs) (hc-alls (cdr vs) body))))
(define (hc-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (hc-imps (cdr hs) body))))
(define (hc-act r x) (list '(ACT m) r x))
(define (hc-add x y) (list '(VADD m) x y))
(define (hc-neg x) (list '(VNEG m) x))
(define (hc-cvx x y t) (hc-add (hc-act (list '- 1 t) x) (hc-act t y)))
(define hc-ms '(NVS-METRIC-SPACE m))
(define (hc-D u v) (list (list 'DIST hc-ms) u v))
(define (hc-type! v)
  (let ((goal (list 'IN v '(VEC m))))
    (cond ((dk-asm? goal) #t)
          ((equal? v '(VZERO m)) (dk-cite! 'nvs-vzero-in-vec 'm))
          ((and (pair? v) (equal? (car v) '(VADD m)))
           (hc-type! (cadr v)) (hc-type! (caddr v)) (dk-cite! 'nvs-vadd-in-vec 'm (cadr v) (caddr v)))
          ((and (pair? v) (equal? (car v) '(ACT m)))
           (dk-real! (cadr v)) (hc-type! (caddr v)) (dk-cite! 'nvs-act-in-vec 'm (cadr v) (caddr v)))
          ((and (pair? v) (equal? (car v) '(VNEG m)))
           (hc-type! (cadr v)) (dk-cite! 'nvs-vneg-in-vec 'm (cadr v)))
          (#t (error "hc-type!: an untyped vector atom" v)))))
(define (hc-msetup!)
  (dk-cite! 'nvs-metric-is-ms 'm)
  (dk-cite! 'nvs-ms-pts 'm))
(define (hc-pts! v)
  (if (not (dk-asm? (list 'IN v (list 'PTS hc-ms))))
      (begin (hc-type! v)
             (dk-rewrite-h! (list 'IN v '(VEC m)) '(VEC m) (list 'PTS hc-ms)))))
(define (hc-dreal! u v) (hc-pts! u) (hc-pts! v) (dk-cite! 'metric-dist-real hc-ms u v))
(define (hc-by-prop! goal . facts)
  (if (not (dk-asm? goal))
      (dk-have! goal (lambda () (if (apply dk-only! facts) (prop)))))
  goal)

;;; ---- dist((1-t) z1 + t z2, y) <= (1-t) dist(z1, y) + t dist(z2, y) ----
(define hc-unit-hyps '((IN z1 (VEC m)) (IN z2 (VEC m)) (IN y (VEC m)) (IN t RR) (<= 0 t) (<= t 1)))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(z1 z2 y t)
   (hc-imps hc-unit-hyps
     (list '<= (hc-D (hc-cvx 'z1 'z2 't) 'y) (list '+ (list '* '(- 1 t) (hc-D 'z1 'y)) (list '* 't (hc-D 'z2 'y))))))))))
(dk-peel!)
(hc-msetup!)
(let* ((w (hc-cvx 'z1 'z2 't)) (w1 (hc-cvx 'y 'z2 't)) (yy (hc-cvx 'y 'y 't))
       (p1 (list '* '(- 1 t) (hc-D 'z1 'y))) (p2 (list '* 't (hc-D 'z2 'y))))
  (hc-pts! w) (hc-pts! w1) (hc-pts! 'y) (hc-pts! 'z1) (hc-pts! 'z2)
  (hc-dreal! w 'y) (hc-dreal! w w1) (hc-dreal! w1 'y) (hc-dreal! 'z1 'y) (hc-dreal! 'z2 'y)
  (dk-real! '(- 1 t))
  (dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1) '(IN t RR))))
  (dk-cite! 'metric-triangle hc-ms w w1 'y)
  (let* ((e1 (dk-cite! 'convex-combination-dist-point 'm 'z1 'y 'z2 't))
         (eyy (dk-cite! 'convex-combination-same-point 'm 'y 't))
         (e2 (dk-cite! 'convex-combination-dist-second-point 'm 'y 'z2 'y 't))
         (a1 (dk-cite! 'rr-abs-of-nonneg '(- 1 t)))
         (a2 (dk-cite! 'rr-abs-of-nonneg 't))
         (s1 (dk-cite! 'metric-sym hc-ms 'y 'z1))
         (s2 (dk-cite! 'metric-sym hc-ms 'y 'z2)))
    ;; e1: D(w, w1) = abs(1-t) * D(y, z1);  e2: D(w1, yy) = abs(t) * D(y, z2)
    (let* ((e1a (dk-rewrite-h! e1 '(abs (- 1 t)) '(- 1 t)))
           (e1b (dk-rewrite-h! e1a (hc-D 'y 'z1) (hc-D 'z1 'y)))
           (e2a (dk-rewrite-h! e2 yy 'y))
           (e2b (dk-rewrite-h! e2a '(abs t) 't))
           (e2c (dk-rewrite-h! e2b (hc-D 'y 'z2) (hc-D 'z2 'y))))
      (dk-real! p1) (dk-real! p2)
      (let* ((v1 (dk-name! p1)) (v2 (dk-name! p2)))
        (subst (list '= p1 v1)) (subst (list '= p2 v2))
        (dk-ineq! (list '<= (hc-D w 'y) (list '+ (hc-D w w1) (hc-D w1 'y)))
                  e1b e2c (list '= v1 p1) (list '= v2 p2)
                  (list 'IN (hc-D w 'y) 'RR) (list 'IN (hc-D w w1) 'RR) (list 'IN (hc-D w1 'y) 'RR)
                  (list 'IN v1 'RR) (list 'IN v2 'RR))))))
(hc-qed! 'nvs-dist-convex-combination)

;;; ---- the closed ball around y is convex ----
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(z1 z2 y t rho)
   (hc-imps (append hc-unit-hyps (list '(IN rho RR) (list '<= (hc-D 'z1 'y) 'rho) (list '<= (hc-D 'z2 'y) 'rho)))
     (list '<= (hc-D (hc-cvx 'z1 'z2 't) 'y) 'rho)))))))
(dk-peel!)
(hc-msetup!)
(let* ((w (hc-cvx 'z1 'z2 't)) (d1 (hc-D 'z1 'y)) (d2 (hc-D 'z2 'y))
       (p1 (list '* '(- 1 t) d1)) (p2 (list '* 't d2)))
  (hc-dreal! w 'y) (hc-dreal! 'z1 'y) (hc-dreal! 'z2 'y)
  (dk-real! '(- 1 t))
  (dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1) '(IN t RR))))
  (dk-cite! 'nvs-dist-convex-combination 'm 'z1 'z2 'y 't)
  (dk-cite! 'rr-mul-le-right d1 'rho '(- 1 t))
  (dk-cite! 'rr-mul-le-right d2 'rho 't)
  (dk-real! p1) (dk-real! p2)
  (dk-real! (list '* d1 '(- 1 t))) (dk-real! (list '* 'rho '(- 1 t)))
  (dk-real! (list '* d2 't)) (dk-real! (list '* 'rho 't))
  (dk-have! (list '= p1 (list '* d1 '(- 1 t))) (lambda () (crs)))
  (dk-have! (list '= p2 (list '* d2 't)) (lambda () (crs)))
  (dk-have! (list '= (list '+ (list '* 'rho '(- 1 t)) (list '* 'rho 't)) 'rho) (lambda () (crs)))
  (let* ((v1 (dk-name! p1)) (v2 (dk-name! p2))
        (u1 (dk-name! (list '* d1 '(- 1 t)))) (u2 (dk-name! (list '* d2 't)))
        (r1 (dk-name! (list '* 'rho '(- 1 t)))) (r2 (dk-name! (list '* 'rho 't))))
    (dk-ineq! (list '<= (hc-D w 'y) (list '+ p1 p2))
              (list '= v1 p1) (list '= v2 p2) (list '= u1 (list '* d1 '(- 1 t))) (list '= u2 (list '* d2 't))
              (list '= r1 (list '* 'rho '(- 1 t))) (list '= r2 (list '* 'rho 't))
              (list '= p1 (list '* d1 '(- 1 t))) (list '= p2 (list '* d2 't))
              (list '<= (list '* d1 '(- 1 t)) (list '* 'rho '(- 1 t))) (list '<= (list '* d2 't) (list '* 'rho 't))
              (list '= (list '+ (list '* 'rho '(- 1 t)) (list '* 'rho 't)) 'rho)
              (list 'IN (hc-D w 'y) 'RR) '(IN rho RR)
              (list 'IN v1 'RR) (list 'IN v2 'RR) (list 'IN u1 'RR) (list 'IN u2 'RR) (list 'IN r1 'RR) (list 'IN r2 'RR))))
(hc-qed! 'nvs-dist-convex-ball)

