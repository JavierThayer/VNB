;;; hc-p4.scm -- HAAR-C part 4: the normal-structure argument (DeMarr) and Theorem 1.11.
;;; A cap of a closed set is closed; the diameter as a supremum; a finite net; the average lemma (finite-set
;;; induction, midpoints); a minimal invariant set has diameter zero; the fixed point theorem.
(define hc-sA-ms (list 'SUBSPACE-MS hc-ms 'aa))
(define (hc-asetup!)
  (hc-msetup!)
  (dk-cite! 'vec-is-set 'm)
  (dk-cite! 'subclass-of-set-is-set 'aa '(VEC m))
  (dk-rewrite-h! '(SUBSET aa (VEC m)) '(VEC m) (list 'PTS hc-ms))
  (dk-cite! 'subspace-is-metric-space hc-ms 'aa)
  (dk-cite! 'subspace-pts hc-ms 'aa))
(define (hc-up! v from)                 ; v in FROM (a subset of aa, or aa itself): land v in aa and v in VEC m
  (if (not (eq? from 'aa)) (dk-cite! 'subset-mem-fwd from 'aa v))
  (dk-cite! 'subset-mem-fwd 'aa '(VEC m) v))
(define (hc-ptsA! v)
  (let ((g (list 'IN v (list 'PTS hc-sA-ms))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst (list '= (list 'PTS hc-sA-ms) 'aa)) (dk-ass!))))
    g))
(define (hc-cap bb rho) (list 'SEP 'hcz_ bb (list 'FORALL 'hcy_ (list 'IMPLIES (list 'IN 'hcy_ bb) (list '<= (hc-D 'hcz_ 'hcy_) rho)))))
(define (hc-diam-up bb d) (list 'FORALL 'hdx_ (list 'IMPLIES (list 'IN 'hdx_ bb) (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bb) (list '<= (hc-D 'hdx_ 'hdy_) d))))))
(define (hc-diam-wit bb d)
  (list 'FORALL 'hde_ (list 'IMPLIES '(IN hde_ RR) (list 'IMPLIES '(<= 0 hde_) (list 'IMPLIES (list '< 'hde_ d)
    (list 'FORSOME 'hdx_ (list 'AND (list 'IN 'hdx_ bb) (list 'FORSOME 'hdy_ (list 'AND (list 'IN 'hdy_ bb) (list '< 'hde_ (hc-D 'hdx_ 'hdy_)))))))))))
(define (hc-union-in! z a b left?)
  (let ((iff (dk-cite! 'union-membership a b z)))
    (dk-have! (caddr iff) (lambda () (if left? (oi-l) (oi-r)) (dk-ass!)))
    (dk-meta-iff-l! iff)))

;;; ---- the points of a closed set B at distance <= rho from every point of B form a closed set ----
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(aa bb rho)
   (hc-imps (list '(SUBSET aa (VEC m)) '(SUBSET bb aa) (list 'IS-CLOSED hc-sA-ms 'bb) '(IN rho RR))
     (list 'IS-CLOSED hc-sA-ms (hc-cap 'bb 'rho))))))))
(dk-peel!)
(hc-asetup!)
(let* ((M (hc-cap 'bb 'rho)) (Ds (list 'DIST hc-sA-ms)))
  (hc-subset! M (list 'PTS hc-sA-ms) (lambda (z) (hc-sep-out! z M) (hc-up! z 'bb) (hc-ptsA! z)))
  (let* ((iff (dk-cite! 'closed-iff-sequentially-closed hc-sA-ms M))
         (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (let* ((ld (dk-peel!))
               (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) ld)))
               (cv (find-first (lambda (h) (dk-head-is? h 'CONVERGES-TO)) (dk-asms)))
               (l (cadddr cv)))
          (dk-project! (list 'IN l (list 'PTS hc-sA-ms)) 'converges-to cv)
          (dk-rewrite-h! (list 'IN l (list 'PTS hc-sA-ms)) (list 'PTS hc-sA-ms) 'aa)
          (dk-cite! 'subset-mem-fwd 'aa '(VEC m) l)
          (dk-have! (list 'FORALL 'hcn_ (list 'IMPLIES '(IN hcn_ NN) (list 'IN (list f 'hcn_) 'bb)))
            (lambda () (let ((n (dk-di-var!))) (dk-cite! 'fun-apply-type-c f 'NN M n) (hc-sep-out! (list f n) M) (dk-ass!))))
          (dk-cite! 'closed-set-limit-in hc-sA-ms 'bb f l)
          (in-sep! (lambda () (dk-ass!))
            (lambda ()
              (let* ((y (dk-di-var!)) (ball (list 'CLOSED-BALL hc-sA-ms y 'rho)))
                (hc-up! y 'bb) (hc-ptsA! y)
                (dk-cite! 'closed-ball-is-closed hc-sA-ms y 'rho)
                (dk-have! (list 'FORALL 'hcn_ (list 'IMPLIES '(IN hcn_ NN) (list 'IN (list f 'hcn_) ball)))
                  (lambda ()
                    (let* ((n (dk-di-var!)) (fn (list f n)))
                      (dk-cite! 'fun-apply-type-c f 'NN M n)
                      (let ((c (hc-sep-out! fn M)))
                        (dk-apply! (dk-ctx-form c) y))
                      (hc-up! fn 'bb) (hc-ptsA! fn)
                      (hc-pts! fn) (hc-pts! y)
                      (dk-cite! 'subspace-dist hc-ms 'aa y fn)
                      (dk-cite! 'metric-sym hc-ms fn y)
                      (let ((dl (list '<= (list Ds y fn) 'rho)))
                        (dk-have! dl (lambda () (subst (list '= (list Ds y fn) (hc-D y fn)))
                                                (subst (list '= (hc-D y fn) (hc-D fn y))) (dk-ass!)))
                        (hc-by-prop! (list 'IN fn ball) (dk-cite! 'closed-ball-membership hc-sA-ms y 'rho fn)
                                     (list 'IN fn (list 'PTS hc-sA-ms)) dl)))))
                (dk-cite! 'closed-set-limit-in hc-sA-ms ball f l)
                (let ((dl (list '<= (list Ds y l) 'rho)))
                  (hc-by-prop! dl (dk-cite! 'closed-ball-membership hc-sA-ms y 'rho l) (list 'IN l ball))
                  (hc-pts! l) (hc-pts! y)
                  (dk-cite! 'subspace-dist hc-ms 'aa y l)
                  (dk-cite! 'metric-sym hc-ms l y)
                  (subst (list '= (hc-D l y) (hc-D y l)))
                  (subst (list '= (hc-D y l) (list Ds y l)))
                  (dk-ass!))))))))
    (hc-by-prop! (list 'IS-CLOSED hc-sA-ms M) iff rhs)))
(hc-qed! 'nvs-dist-cap-closed)

;;; ---- the diameter of a subset of a compact set, as a supremum ----
(define hc-S (list 'SEP 'hst_ 'RR (list 'FORSOME 'hsx_ (list 'AND '(IN hsx_ bb)
               (list 'FORSOME 'hsy_ (list 'AND '(IN hsy_ bb) (list '= 'hst_ (hc-D 'hsx_ 'hsy_))))))))
(define (hc-S-out! t)
  (let* ((cnd (hc-sep-out! t hc-S))
         (x (dk-skolem! (dk-ctx-form cnd) #t))
         (q (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x) (dk-contains? h t))) "the second point"))
         (y (dk-skolem! q #t)))
    (list x y)))
(define (hc-xy-close! x y)
  (ew x)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (dk-ass!))
            ((dk-head-is? (dk-goal) 'FORSOME)
             (ew y) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (rfl)))))
            (#t (rfl))))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(aa bb)
   (hc-imps (list '(SUBSET aa (VEC m)) (list 'IS-COMPACT hc-sA-ms) '(SUBSET bb aa))
     (list 'FORSOME 'hdd_ (list 'AND '(IN hdd_ RR) (list 'AND (hc-diam-up 'bb 'hdd_) (hc-diam-wit 'bb 'hdd_))))))))))
(dk-peel!)
(hc-asetup!)
(let* ((S hc-S) (esup-s (list 'ESUP S)))
  (hc-subset! S 'RR-POS-STAR
    (lambda (t)
      (let* ((xy (hc-S-out! t)) (x (car xy)) (y (cadr xy)))
        (hc-up! x 'bb) (hc-up! y 'bb) (hc-dreal! x y)
        (dk-cite! 'metric-pos hc-ms x y)
        (dk-rewrite-h! (list '<= 0 (hc-D x y)) (hc-D x y) t)
        (hc-by-prop! (list 'IN t 'RR-POS-STAR) (dk-cite! 'rr-pos-star-membership t) (list 'IN t 'RR) (list '<= 0 t)))))
  (let* ((bx (dk-cite! 'compact-dist-bound hc-sA-ms))
         (b (dk-skolem! bx #t))
         (bf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b))) "the bound"))
         (ub (list 'FORALL 'hdw_ (list 'IMPLIES (list 'IN 'hdw_ S) (list '<= 'hdw_ b)))))
    (hc-by-prop! (list 'IN b 'RR-POS-STAR) (dk-cite! 'rr-pos-star-membership b) (list 'IN b 'RR) (list '<= 0 b))
    (dk-have! ub
      (lambda ()
        (let* ((t (dk-di-var!)) (xy (hc-S-out! t)) (x (car xy)) (y (cadr xy)))
          (hc-up! x 'bb) (hc-up! y 'bb) (hc-ptsA! x) (hc-ptsA! y)
          (dk-apply! bf x y)
          (dk-cite! 'subspace-dist hc-ms 'aa x y)
          (subst (list '= t (hc-D x y)))
          (subst (list '= (hc-D x y) (list (list 'DIST hc-sA-ms) x y)))
          (dk-ass!))))
    (dk-meta-and! (list 'IN b 'RR-POS-STAR) ub)
    (dk-cite! 'esup-least S b)
    (dk-cite! 'esup-in S)
    (dk-meta-and! (list 'IN esup-s 'RR-POS-STAR) (list 'IN b 'RR))
    (dk-cite! 'rr-pos-star-le-real-in-rr esup-s b))
  (ew esup-s)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'hdx_))
           (dk-peel!)
           (let* ((tm (cadr (dk-goal))) (x (cadr tm)) (y (caddr tm)))
             (hc-up! x 'bb) (hc-up! y 'bb) (hc-dreal! x y)
             (hc-sep-in! (hc-D x y) S (lambda () (hc-xy-close! x y)))
             (dk-cite! 'esup-upper S (hc-D x y))
             (dk-ass!)))
          (#t
           (let* ((ld (dk-peel!))
                  (e (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
             (hc-by-prop! (list 'IN e 'RR-POS-STAR) (dk-cite! 'rr-pos-star-membership e) (list 'IN e 'RR) (list '<= 0 e))
             (let* ((wx (dk-cite! 'esup-lt-witness S e))
                    (t (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h e) (dk-contains? h 'hst_))) "the witness") #t))
                    (xy (hc-S-out! t)) (x (car xy)) (y (cadr xy)))
               (dk-rewrite-h! (list '< e t) t (hc-D x y))
               (hc-xy-close! x y))))))))
  )
(hc-qed! 'nvs-diameter-sup)

;;; ---- a closed subset of a compact set has a finite rad-net of its own points ----
(define hc-sB-ms (list 'SUBSPACE-MS hc-ms 'bb))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (hc-alls '(aa bb rad)
   (hc-imps (list '(SUBSET aa (VEC m)) (list 'IS-COMPACT hc-sA-ms) '(SUBSET bb aa) (list 'IS-CLOSED hc-sA-ms 'bb) '(IN rad RR) '(< 0 rad))
     (list 'FORSOME 'hnf_ (list 'AND '(IN hnf_ SET) (list 'AND '(IN (CARD hnf_) NN) (list 'AND '(SUBSET hnf_ bb)
       (list 'FORALL 'hnp_ (list 'IMPLIES '(IN hnp_ bb) (list 'FORSOME 'hnc_ (list 'AND '(IN hnc_ hnf_) (list '<= (hc-D 'hnc_ 'hnp_) 'rad)))))))))))))))
(dk-peel!)
(hc-asetup!)
(let* ((sB hc-sB-ms) (PB (list 'PTS sB)))
  (dk-cite! 'subclass-of-set-is-set 'bb 'aa)
  (dk-cite! 'closed-subset-of-compact-is-compact hc-sA-ms 'bb)
  (hc-by-prop! (list 'IS-COMPACT sB) (dk-cite! 'compact-subset-of-subspace-iff hc-ms 'aa 'bb)
               (list 'IS-COMPACT (list 'SUBSPACE-MS hc-sA-ms 'bb)))
  (dk-cite! 'compact-implies-totally-bounded sB)
  (let* ((tbf (cadr (hc-parts! 'totally-bounded (list sB) (list 'TOTALLY-BOUNDED sB))))
