          (dk-cite! 'subclass-of-set-is-set a 'aa)
          (dk-have! (list 'FORALL 'hpz_ (list 'IMPLIES (list 'IN 'hpz_ a) '(IN hpz_ aa)))
            (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd a 'aa e) (dk-ass!))))
          (dk-cite! 'power-mem-intro 'aa a)))
