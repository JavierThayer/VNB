  (dk-cite! 'class-extensionality a b))
(define (hc-ccs-parts! a) (hc-parts! 'is-invariant-ccs (list 'm 'aa 'gs a) (list 'IS-INVARIANT-CCS 'm 'aa 'gs a)))

(define hc-min-hyps '((IS-NORMED-VECTOR-SPACE m) (SUBSET aa (VEC m)) (IS-COMPACT (SUBSPACE-MS (NVS-METRIC-SPACE m) aa))
                      (IS-INVARIANT-CCS m aa gs aa)))
(define hc-min-concl '(FORSOME hmb_ (AND (IS-INVARIANT-CCS m aa gs hmb_)
   (FORALL hmc_ (IMPLIES (IS-INVARIANT-CCS m aa gs hmc_) (IMPLIES (SUBSET hmc_ hmb_) (SUBSET hmb_ hmc_)))))))
(sp (make-wff (hc-alls '(m aa gs) (hc-imps hc-min-hyps hc-min-concl))))
(dk-peel!)
(hc-msetup!)
(dk-cite! 'vec-is-set 'm)
(dk-cite! 'subclass-of-set-is-set 'aa '(VEC m))
(dk-cite! 'power-set 'aa)
(dk-rewrite-h! '(SUBSET aa (VEC m)) '(VEC m) (list 'PTS hc-ms))
(dk-cite! 'subspace-is-metric-space hc-ms 'aa)
(dk-cite! 'subspace-pts hc-ms 'aa)
(hc-ccs-parts! 'aa)
(dk-cite! 'subset-refl 'aa)
(hc-grd-in! 'aa)
(dk-have! (list 'IN hc-GRD 'SET) (lambda () (sep-set) (dk-ass!)))
(dk-have! (list 'IN (list 'CARTESIAN hc-GRD hc-GRD) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
(dk-have! (list 'IN hc-POR 'SET) (lambda () (sep-set) (dk-ass!)))
;; the partial order
(dk-have! (list 'IS-PARTIAL-ORDER hc-GRD hc-POR)
  (lambda ()
    (mac 'is-partial-order)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((ld (dk-peel!))
                   (vs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hc-GRD))) ld))))
              (dk-split-all!)
              (for-each hc-grd-out! vs)
              (cond ((= (length vs) 1) (dk-cite! 'subset-refl (car vs)) (hc-por-in! (car vs) (car vs)))
                    ((= (length vs) 2)
                     (let ((a (car vs)) (b (cadr vs)))
                       (hc-por-out! a b) (hc-por-out! b a) (hc-set-eq! a b) (dk-ass!)))
                    (#t
                     (let ((a (car vs)) (b (cadr vs)) (c (caddr vs)))
                       (hc-por-out! a b) (hc-por-out! b c)
                       (dk-cite! 'subset-trans c b a)
                       (hc-por-in! a c))))))))))
;; every chain has an upper bound: its meet (all of aa for the empty chain)
(dk-have! (list 'FORALL 'ch_ (list 'IMPLIES (list 'IS-CHAIN hc-GRD hc-POR 'ch_) (list 'FORSOME 'u_ (list 'IS-UPPER-BOUND hc-GRD hc-POR 'ch_ 'u_))))
  (lambda ()
    (let* ((ch (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-CHAIN)) (dk-peel!))))
           (ich (list 'IS-CHAIN hc-GRD hc-POR ch))
           (csub (dk-project! (list 'SUBSET ch hc-GRD) 'is-chain ich))
           (ccmp (dk-project! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ch) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y ch)
                                  (list 'OR (list 'IN '(LIST x y) hc-POR) (list 'IN '(LIST y x) hc-POR))))))
                              'is-chain ich))
           (UB (hc-meet 'aa ch))
           (invall (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch) '(IS-INVARIANT-CCS m aa gs kca_))))
           (mem! (lambda (a) (dk-apply! invall a) (hc-ccs-parts! a)))
           (proj! (lambda () (let ((a (dk-di-var!))) (dk-apply! invall a)
                               (dk-project! (dk-goal) 'is-invariant-ccs (list 'IS-INVARIANT-CCS 'm 'aa 'gs a))))))
      (dk-have! invall (lambda () (let ((a (dk-di-var!))) (dk-cite! 'subset-mem-fwd ch hc-GRD a) (hc-grd-out! a) (dk-ass!))))
      (dk-have! (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch) '(IS-CONVEX-SUBSET m kca_))) proj!)
      (dk-have! (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch) (list 'IS-CLOSED hc-sA 'kca_))) proj!)
      (hc-subset! UB 'aa (lambda (z) (hc-sep-out! z UB) (dk-ass!)))
      ;; the meet is nonempty
      (dk-have! (list 'FORSOME 'kuz_ (list 'IN 'kuz_ UB))
        (lambda ()
          (use-em (list 'FORSOME 'kca_ (list 'IN 'kca_ ch))
            (lambda ()
              (dk-have! (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch) '(FORSOME icz_ (IN icz_ kca_)))) proj!)
              (dk-have! (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch)
                          (list 'FORALL 'kcb_ (list 'IMPLIES (list 'IN 'kcb_ ch) '(OR (SUBSET kca_ kcb_) (SUBSET kcb_ kca_))))))
                (lambda ()
                  (let* ((ld (dk-peel!))
                         (ab (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ch))) ld)))
                         (a (car ab)) (b (cadr ab)))
                    (dk-cite! 'subset-mem-fwd ch hc-GRD a) (hc-grd-out! a)
                    (dk-cite! 'subset-mem-fwd ch hc-GRD b) (hc-grd-out! b)
                    (let ((or1 (dk-apply! ccmp a b)))
                      (use-em (list 'IN (list 'LIST a b) hc-POR)
                        (lambda () (hc-por-out! a b) (oi-r) (dk-ass!))
                        (lambda ()
                          (hc-by-prop! (list 'IN (list 'LIST b a) hc-POR) or1 (list 'NOT (list 'IN (list 'LIST a b) hc-POR)))
                          (hc-por-out! b a) (oi-l) (dk-ass!)))))))
              (let* ((meet (dk-cite! 'compact-chain-meet-metric hc-sA ch))
                     (p (dk-skolem! meet #t))
                     (pin (dk-rewrite-h! (list 'IN p (list 'PTS hc-sA)) (list 'PTS hc-sA) 'aa)))
                (hc-sep-in! p UB)
                (ew p) (dk-ass!)))
            (lambda ()
              (let ((z0 (dk-skolem! (dk-ctx-form '(FORSOME icz_ (IN icz_ aa))))))
                (hc-sep-in! z0 UB
                  (lambda ()
                    (let ((a (dk-di-var!)))
                      (pbc)
                      (dk-have! (list 'FORSOME 'kca_ (list 'IN 'kca_ ch)) (lambda () (ew a) (dk-ass!)))
                      (ai (list 'NOT (list 'FORSOME 'kca_ (list 'IN 'kca_ ch)))))))
                (ew z0) (dk-ass!))))))
      (dk-cite! 'convex-meet 'm 'aa ch)
      (let ((cm (dk-cite! 'metric-closed-meet hc-sA ch)))
        (dk-rewrite-h! (list 'IS-CLOSED hc-sA (hc-meet (list 'PTS hc-sA) ch)) (list 'PTS hc-sA) 'aa))
      ;; invariance of the meet
      (dk-have! (list 'FORALL 'icf_ (list 'IMPLIES '(IN icf_ gs) (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ UB) (list 'IN '(icf_ icx_) UB)))))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'gs))) ld)))
                 (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) UB))) ld)))
                 (cx (hc-sep-out! x UB)))
            (dk-apply! (dk-ctx-form '(FORALL icf_ (IMPLIES (IN icf_ gs) (FORALL icx_ (IMPLIES (IN icx_ aa) (IN (icf_ icx_) aa)))))) f x)
            (in-sep! (lambda () (dk-ass!))
              (lambda ()
                (let* ((b (dk-di-var!)))
                  (mem! b)
                  (dk-apply! (dk-ctx-form cx) b)
                  (dk-apply! (dk-ctx-form (list 'FORALL 'icf_ (list 'IMPLIES '(IN icf_ gs) (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ b) (list 'IN '(icf_ icx_) b))))))
                             f x)
                  (dk-ass!)))))))
      (hc-pow-in! UB)
      (dk-have! (list 'IS-INVARIANT-CCS 'm 'aa 'gs UB)
        (lambda () (mac 'is-invariant-ccs) (dk-conj-close! (lambda () (dk-ass!)))))
      (hc-grd-in! UB)
      (ew UB)
      (mac 'is-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((x (dk-di-var!)))
                (dk-cite! 'subset-mem-fwd ch hc-GRD x) (hc-grd-out! x)
                (hc-subset! UB x
                  (lambda (z) (let ((cz (hc-sep-out! z UB))) (dk-apply! (dk-ctx-form cz) x) (dk-ass!))))
                (hc-por-in! x UB))))))))
(dk-have! (list 'FORSOME 'w_ (list 'IN 'w_ hc-GRD)) (lambda () (ew 'aa) (dk-ass!)))
(let* ((zl (dk-cite! 'zorn-lemma hc-GRD hc-POR))
       (fmax (dk-skolem! zl #t))
       (im (list 'IS-MAXIMAL hc-GRD hc-POR fmax))
       (mxg (dk-project! (list 'IN fmax hc-GRD) 'is-maximal im))
       (mcl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y hc-GRD) (list 'IMPLIES (list 'IN (list 'LIST fmax 'y) hc-POR) (list 'IN (list 'LIST 'y fmax) hc-POR))))
                         'is-maximal im)))
  (hc-grd-out! fmax)
  (dk-have! (list 'FORALL 'hmc_ (list 'IMPLIES '(IS-INVARIANT-CCS m aa gs hmc_) (list 'IMPLIES (list 'SUBSET 'hmc_ fmax) (list 'SUBSET fmax 'hmc_))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (c (car (cddddr (find-first (lambda (h) (dk-head-is? h 'IS-INVARIANT-CCS)) ld)))))
        (dk-cite! 'subset-trans c fmax 'aa)
        (hc-grd-in! c)
        (hc-por-in! fmax c)
        (dk-apply! mcl c)
        (hc-por-out! c fmax)
        (dk-ass!))))
  (ew fmax)
  (dk-conj-close! (lambda () (dk-ass!))))
(hc-qed! 'invariant-ccs-minimal)

