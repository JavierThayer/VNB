    g))
(define (hc-grd-in! a)
  (hc-pow-in! a)
  (dk-have! (list 'IN a hc-GRD) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
(define (hc-grd-out! a)
  (let ((c (list 'AND (list 'IN a '(POWER aa)) (list 'IS-INVARIANT-CCS 'm 'aa 'gs a))))
    (if (not (dk-asm? (list 'IS-INVARIANT-CCS 'm 'aa 'gs a)))
        (begin (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN a hc-GRD))) (dk-split-all!) (dk-conj-close! dk-ass!)))
               (dk-split-all! (list c))))
