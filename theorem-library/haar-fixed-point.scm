(define (hc-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (cons (cadr f) (hc-conjs (caddr f))) (list f)))
(define (hc-parts! thm args hyp)
  (let ((iff (apply dk-cite! thm args)))
    (map (lambda (c) (dk-project! c thm hyp)) (hc-conjs (caddr iff)))))
(define (hc-sep-out! z sep)            ; land the domain membership and the condition; the one equal to the goal last
  (let* ((dom (list 'IN z (caddr sep))) (v (cadr sep)) (cnd (subst-free v z (cadddr sep)))
         (g (dk-goal))
         (land! (lambda (c) (if (not (dk-asm? c))
                               (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN z sep))) (dk-split-all!) (dk-ass!)))))))
    (if (equal? dom g) (begin (land! cnd) (land! dom)) (begin (land! dom) (land! cnd)))
    cnd))
(define (hc-sep-in! z sep . opt)
  (dk-have! (list 'IN z sep) (lambda () (in-sep! (lambda () (dk-ass!)) (if (pair? opt) (car opt) (lambda () (dk-ass!)))))))
(define (hc-subset! a b body)
  (let ((g (list 'SUBSET a b)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (body z)))))
    g))
(define (hc-meet dom ch) (list 'SEP 'hcu_ dom (list 'FORALL 'hcb_ (list 'IMPLIES (list 'IN 'hcb_ ch) '(IN hcu_ hcb_)))))

;;; ---- a closed set of a metric space is closed in its metric topology ----
(sp (make-wff '(FORALL s (FORALL kc (IMPLIES (IS-METRIC-SPACE s) (IMPLIES (IS-CLOSED s kc) (IS-TOP-CLOSED (METRIC-TOP s) kc)))))))
(dk-peel!)
(dk-cite! 'metric-top-pts 's)
(dk-project! '(SUBSET kc (PTS s)) 'is-closed '(IS-CLOSED s kc))
(dk-project! '(IS-OPEN s (COMPLEMENT-IN (PTS s) kc)) 'is-closed '(IS-CLOSED s kc))
(let ((iff (dk-cite! 'metric-top-opens-iff 's '(COMPLEMENT-IN (PTS s) kc))))
  (mac 'is-top-closed)
  (subst '(= (PTS (METRIC-TOP s)) (PTS s)))
  (dk-conj-close!
    (lambda () (if (not (dk-ass!)) (begin (dk-only! iff '(IS-OPEN s (COMPLEMENT-IN (PTS s) kc))) (prop))))))
(hc-qed! 'metric-closed-is-top-closed)

;;; ---- a compact metric space is compact as a subspace of its metric topology ----
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-COMPACT-T (SUBSPACE-TOP (METRIC-TOP s) (PTS s)))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(let ((iff (dk-cite! 'metric-top-compact 's)))
  (hc-by-prop! '(IS-COMPACT-T (METRIC-TOP s)) iff '(IS-COMPACT s)))
(dk-cite! 'carrier-is-closed 's)
(dk-cite! 'metric-closed-is-top-closed 's '(PTS s))
(dk-cite! 'closed-subset-compact '(METRIC-TOP s) '(PTS s))
(dk-ass!)
(hc-qed! 'metric-compact-subspace-top-compact)

;;; ---- a nonempty chain of nonempty closed subsets of a compact metric space has a common point ----
(define hc-ch-hyps
  '((IS-COMPACT s)
    (FORSOME kca_ (IN kca_ ch))
    (FORALL kca_ (IMPLIES (IN kca_ ch) (IS-CLOSED s kca_)))
    (FORALL kca_ (IMPLIES (IN kca_ ch) (FORSOME kcz_ (IN kcz_ kca_))))
    (FORALL kca_ (IMPLIES (IN kca_ ch) (FORALL kcb_ (IMPLIES (IN kcb_ ch) (OR (SUBSET kca_ kcb_) (SUBSET kcb_ kca_))))))))
(sp (make-wff (hc-alls '(s ch) (hc-imps hc-ch-hyps
   '(FORSOME kcp_ (AND (IN kcp_ (PTS s)) (FORALL kca_ (IMPLIES (IN kca_ ch) (IN kcp_ kca_)))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(dk-cite! 'metric-top-is-top-space 's)
(dk-cite! 'metric-top-pts 's)
(dk-cite! 'metric-compact-subspace-top-compact 's)
(hc-subset! '(PTS s) '(PTS (METRIC-TOP s)) (lambda (z) (subst '(= (PTS (METRIC-TOP s)) (PTS s))) (dk-ass!)))
(let ((clo (dk-ctx-form (list-ref hc-ch-hyps 2))))
  (dk-have! '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-TOP-CLOSED (METRIC-TOP s) kca_)))
    (lambda () (let ((a (dk-di-var!))) (dk-apply! clo a) (dk-cite! 'metric-closed-is-top-closed 's a) (dk-ass!))))
  (dk-have! '(FORALL kca_ (IMPLIES (IN kca_ ch) (SUBSET kca_ (PTS s))))
    (lambda () (let ((a (dk-di-var!))) (dk-apply! clo a) (dk-project! (list 'SUBSET a '(PTS s)) 'is-closed (list 'IS-CLOSED 's a)) (dk-ass!)))))
(dk-cite! 'compact-chain-meet '(METRIC-TOP s) '(PTS s) 'ch)
(dk-ass!)
(hc-qed! 'compact-chain-meet-metric)

;;; ---- the meet of a family of closed sets is closed ----
(sp (make-wff (hc-alls '(s ch) (hc-imps '((IS-METRIC-SPACE s) (FORALL kca_ (IMPLIES (IN kca_ ch) (IS-CLOSED s kca_))))
   (list 'IS-CLOSED 's (hc-meet '(PTS s) 'ch))))))
(dk-peel!)
(let* ((M (hc-meet '(PTS s) 'ch))
       (clo (dk-ctx-form '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-CLOSED s kca_))))))
  (hc-subset! M '(PTS s) (lambda (z) (hc-sep-out! z M) (dk-ass!)))
  (let* ((iff (dk-cite! 'closed-iff-sequentially-closed 's M))
         (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (let* ((ld (dk-peel!))
               (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) ld)))
               (cv (find-first (lambda (h) (dk-head-is? h 'CONVERGES-TO)) (dk-asms)))
               (l (cadddr cv)))
          (dk-project! (list 'IN l '(PTS s)) 'converges-to cv)
          (in-sep! (lambda () (dk-ass!))
            (lambda ()
              (let ((b (dk-di-var!)))
                (dk-apply! clo b)
                (dk-have! (list 'FORALL 'hcn_ (list 'IMPLIES '(IN hcn_ NN) (list 'IN (list f 'hcn_) b)))
                  (lambda ()
                    (let ((n (dk-di-var!)))
                      (dk-cite! 'fun-apply-type-c f 'NN M n)
                      (let ((c (hc-sep-out! (list f n) M)))
                        (dk-apply! (dk-ctx-form c) b)
                        (dk-ass!)))))
                (dk-cite! 'closed-set-limit-in 's b f l)
                (dk-ass!)))))))
    (hc-by-prop! (list 'IS-CLOSED 's M) iff rhs)))
(hc-qed! 'metric-closed-meet)

;;; ---- the meet of convex sets is convex ----
(sp (make-wff (hc-alls '(m aa ch) (hc-imps '((IS-NORMED-VECTOR-SPACE m) (IS-CONVEX-SUBSET m aa) (FORALL kca_ (IMPLIES (IN kca_ ch) (IS-CONVEX-SUBSET m kca_))))
   (list 'IS-CONVEX-SUBSET 'm (hc-meet 'aa 'ch))))))
(dk-peel!)
(let* ((M (hc-meet 'aa 'ch))
       (cvx (dk-ctx-form '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-CONVEX-SUBSET m kca_)))))
       (pa (hc-parts! 'is-convex-subset '(m aa) '(IS-CONVEX-SUBSET m aa)))
       (lawa (cadr pa)))
  (hc-subset! M '(VEC m) (lambda (z) (hc-sep-out! z M) (dk-cite! 'subset-mem-fwd 'aa '(VEC m) z) (dk-ass!)))
  (mac 'is-convex-subset)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (xs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) M))) ld)))
                 (x (car xs)) (y (cadr xs))
                 (tt (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
                 (cx (hc-sep-out! x M)) (cy (hc-sep-out! y M)))
            (dk-apply! lawa x y tt)
            (in-sep! (lambda () (dk-ass!))
              (lambda ()
                (let ((b (dk-di-var!)))
                  (dk-apply! cvx b)
                  (dk-apply! (dk-ctx-form cx) b) (dk-apply! (dk-ctx-form cy) b)
                  (let ((pb (hc-parts! 'is-convex-subset (list 'm b) (list 'IS-CONVEX-SUBSET 'm b))))
                    (dk-apply! (cadr pb) x y tt)
                    (dk-ass!))))))))))
(hc-qed! 'convex-meet)

