    (dk-have! ante
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (dk-ass!))
                  ((dk-head-is? (dk-goal) 'NOT) (di) (dk-absurd! '(< 0 rad) '(= 0 rad) '(IN rad RR)))
                  (#t (dk-ineq! '(< 0 rad) '(IN rad RR))))))))
    (dk-apply! tbf 'rad)
    (let* ((fnet (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'IS-R-NET))) "the net") #t))
           (netf (cadr (hc-parts! 'is-r-net (list sB fnet PB 'rad) (list 'IS-R-NET sB fnet PB 'rad)))))
      (dk-cite! 'subspace-pts hc-ms 'bb)
      (dk-rewrite-h! (list 'SUBSET fnet PB) PB 'bb)
      (dk-cite! 'subclass-of-set-is-set fnet 'bb)
      (ew fnet)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((p (dk-di-var!)))
                (dk-have! (list 'IN p PB) (lambda () (subst (list '= PB 'bb)) (dk-ass!)))
                (let ((c (dk-skolem! (dk-apply! netf p) #t)))
                  (dk-split-all!)
                  (dk-cite! 'subset-mem-fwd fnet 'bb c)
                  (dk-cite! 'subspace-dist hc-ms 'bb c p)
                  (ew c)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
