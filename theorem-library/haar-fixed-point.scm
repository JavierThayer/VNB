;;; hc-p3.scm -- HAAR-C part 3: a minimal nonempty closed convex invariant subset (Zorn, reverse inclusion).
(define hc-sA '(SUBSPACE-MS (NVS-METRIC-SPACE m) aa))
(define hc-GRD '(SEP hgr_ (POWER aa) (IS-INVARIANT-CCS m aa gs hgr_)))
(define hc-POR (list 'SEP 'hpr_ (list 'CARTESIAN hc-GRD hc-GRD) '(SUBSET (NTH 2 hpr_) (NTH 1 hpr_))))
(define (hc-has-nth-list? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred hc-has-nth-list? e))))
(define (hc-nth-all!) (let loop ((k 0)) (if (and (< k 10) (hc-has-nth-list? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
