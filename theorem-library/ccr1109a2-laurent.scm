;; the sum and the negative of Laurent series are Laurent series
(define (c9l-two-bounds! k f g bf bg prove-at!)
  ;; the bound min(bf, bg) works: prove the claim with each candidate, by cases
  (dk-cite! 'zz-in-rr bf) (dk-cite! 'zz-in-rr bg)
  (use-em `(<= ,bf ,bg)
    (lambda () (prove-at! bf (lambda (j) (dk-ineq! `(< ,j ,bf) `(<= ,bf ,bg)))))
    (lambda () (dk-chain-ass! (dk-cite! 'rr-not-le-lt bf bg))
               (prove-at! bg (lambda (j) (dk-ineq! `(< ,j ,bg) `(< ,bg ,bf)))))))

(sp (make-wff '(FORALL lzk (IMPLIES (IS-RING lzk) (FORALL lzf (IMPLIES (IN lzf (LAURENT-SET lzk))
   (FORALL lzg (IMPLIES (IN lzg (LAURENT-SET lzk)) (IN (LAURENT-ADD lzk lzf lzg) (LAURENT-SET lzk))))))))))
(dk-peel!)
(let* ((bf (c9l-open! 'lzk 'lzf)) (bg (c9l-open! 'lzk 'lzg))
       (s '(LAURENT-ADD lzk lzf lzg))
       (lawf (c9l-bound 'lzk 'lzf bf)) (lawg (c9l-bound 'lzk 'lzg bg)))
  (dk-have! `(IN ,s (FUN ZZ (CARR lzk)))
    (lambda ()
      (c9l-lam-type! 'LAURENT-ADD
        (lambda (x) (c9l-app! 'lzk 'lzf x) (c9l-app! 'lzk 'lzg x)
                    (dk-cite! 'ring-add-closed 'lzk `(lzf ,x) `(lzg ,x))))))
  (c9l-two-bounds! 'lzk 'lzf 'lzg bf bg
    (lambda (b lt!)
      (dk-have! (c9l-bound 'lzk s b)
        (lambda ()
          (dk-peel!)
          (let ((j (cadr (cadr (dk-goal)))))
            (dk-cite! 'zz-in-rr j)
            (dk-have! `(< ,j ,bf) (lambda () (lt! j)))
            (dk-have! `(< ,j ,bg) (lambda () (lt! j)))
            (dk-chain-ass! (dk-apply! lawf j)) (dk-chain-ass! (dk-apply! lawg j))
            (c9l-app! 'lzk 'lzf j) (c9l-app! 'lzk 'lzg j)
            (mac 'LAURENT-ADD)
            (dk-lam-b!)
            (subst `(= (lzf ,j) (ZERO lzk))) (subst `(= (lzg ,j) (ZERO lzk)))
            (dk-cite! 'ring-zero-in 'lzk)
            (subst (dk-cite! 'ring-add-left-id 'lzk '(ZERO lzk)))
            (c9l-rfl!))))
      (dk-cite! 'laurent-set-in 'lzk s b)
      (dk-close-if-asm!))))
(qed 'laurent-add-in)

(sp (make-wff '(FORALL lzk (IMPLIES (IS-RING lzk) (FORALL lzf (IMPLIES (IN lzf (LAURENT-SET lzk))
   (IN (LAURENT-NEG lzk lzf) (LAURENT-SET lzk))))))))
