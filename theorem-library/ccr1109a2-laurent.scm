(define (c9l-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))

(sp (make-wff '(FORALL lrk_ (== (LAURENT-SET lrk_) (SEP lrf_ (FUN ZZ (CARR lrk_)) (IS-LAURENT lrk_ lrf_))))))
(di)
(mac 'LAURENT-SET)
(qrfl)
(qed 'laurent-set-unfold)

;; introduction: a function ZZ -> CARR K vanishing below some integer is a Laurent series
(define c9l-bound
  (lambda (k f b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (ZERO ,k)))))))
(sp (make-wff `(FORALL lzk (FORALL lzf (IMPLIES (IN lzf (FUN ZZ (CARR lzk))) (FORALL lzb (IMPLIES (IN lzb ZZ)
   (IMPLIES ,(c9l-bound 'lzk 'lzf 'lzb) (IN lzf (LAURENT-SET lzk))))))))))
(dk-peel!)
(subst (dk-cite! 'laurent-set-unfold 'lzk))
(in-sep! (lambda () (dk-ass!))
  (lambda ()
    (let ((iff (dk-cite! 'is-laurent 'lzk 'lzf)))
      (dk-have! (caddr iff)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin (ew 'lzb) (dk-conj-close! (lambda () (dk-ass!)))))))))
      (dk-iff-bwd! iff)
      (dk-close-if-asm!))))
(qed 'laurent-set-in)

;; elimination: a Laurent series is a function ZZ -> CARR K vanishing below some integer
(sp (make-wff `(FORALL lzk (FORALL lzf (IMPLIES (IN lzf (LAURENT-SET lzk))
   (AND (IN lzf (FUN ZZ (CARR lzk))) (FORSOME lzb (AND (IN lzb ZZ) ,(c9l-bound 'lzk 'lzf 'lzb)))))))))
(dk-peel!)
(let* ((u (dk-cite! 'laurent-set-unfold 'lzk))
       (h (dk-rewrite-h! '(IN lzf (LAURENT-SET lzk)) '(LAURENT-SET lzk) (caddr u))))
  (sep-me h)
  (dk-iff-fwd! (dk-cite! 'is-laurent 'lzk 'lzf))
  (let ((b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'lrj_))) "the bound"))))
    (dk-split-all!)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin (ew b) (dk-conj-close! (lambda () (dk-ass!)))))))))
(qed 'laurent-set-out)

;; F in LAURENT-SET K in context: land its typing and a bound B, return B
(define (c9l-open! k f)
  (dk-chain-ass! (dk-cite! 'laurent-set-out k f))
  (dk-split-all!)
  (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h `(,f lzj)))) "a bound")))
;; F applied at a point X of ZZ: land F(X) in CARR K
(define (c9l-app! k f x)
  (dk-have-and! `(IN ,f (FUN ZZ (CARR ,k))) `(IN ,x ZZ))
  (dk-cite! 'fun-apply-type f 'ZZ `(CARR ,k) x))
;; a lambda over ZZ: prove its typing with POINT! closing the pointwise leaf at the eigenvariable
(define (c9l-lam-type! name point!)
  (dk-each-leaf! (lambda () (mac name) (lam-t))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed))))
            (point! x)
            (dk-close-if-asm!))
          (begin (fact 'zz-is-set) (dk-close-if-asm!))))))

