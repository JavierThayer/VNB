;; the order exists: a non-zero Laurent series has a least index of a non-zero coefficient
(define c9l-ordp
  (lambda (k f o) `(AND (IN ,o ZZ) (AND (NOT (= (,f ,o) (ZERO ,k)))
                     (FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,o) (= (,f lzj) (ZERO ,k)))))))))
(sp (make-wff `(FORALL lzk (IMPLIES (IS-RING lzk) (FORALL lzf (IMPLIES (IN lzf (LAURENT-SET lzk))
   (FORALL lzw (IMPLIES (IN lzw ZZ) (IMPLIES (NOT (= (lzf lzw) (ZERO lzk)))
     (FORSOME lzo ,(c9l-ordp 'lzk 'lzf 'lzo)))))))))))
(dk-peel!)
(let* ((b (c9l-open! 'lzk 'lzf))
       (law (c9l-bound 'lzk 'lzf b))
       (tt `(SEP lzm_ NN (NOT (= (lzf (+ ,b lzm_)) (ZERO lzk)))))
       (w 'lzw))
  (dk-cite! 'zz-in-rr b) (dk-cite! 'zz-in-rr w)
  (dk-cite! 'zz-neg-closed b)
  (dk-have-and! `(IN ,w ZZ) `(IN (- ,b) ZZ))
  (dk-cite! 'zz-add-closed w `(- ,b))
  (dk-cite! 'zz-in-rr `(- ,b))
  (dk-cite! 'zz-in-rr `(+ ,w (- ,b)))
  ;; w >= b, so w - b in NN and lies in T
  (dk-have! `(<= ,b ,w)
    (lambda ()
      (pbc)
      (dk-chain-ass! (dk-cite! 'rr-not-le-lt b w))
      (dk-chain-ass! (dk-apply! law w))
      (ai `(NOT (= (lzf ,w) (ZERO lzk))))))
  (let ((d `(+ ,w (- ,b))))
    (dk-have! `(<= 0 ,d) (lambda () (dk-ineq! `(<= ,b ,w))))
    (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn d))
    (dk-have! `(= (+ ,b ,d) ,w) (lambda () (crs)))
    (dk-have! `(IN ,d ,tt)
      (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (subst `(= (+ ,b ,d) ,w)) (dk-ass!)))))
    (dk-have! `(SUBSET ,tt NN)
      (lambda ()
        (let ((iff (dk-cite! 'subset-def tt 'NN)))
          (dk-have! (caddr iff)
            (lambda () (let ((x (dk-di-var!))) (sep-me `(IN ,x ,tt)) (dk-close-if-asm!))))
          (dk-iff-bwd! iff)
          (dk-close-if-asm!))))
    (dk-have! `(FORSOME lzn_ (IN lzn_ ,tt)) (lambda () (ew d) (dk-ass!)))
    (dk-have-and! `(SUBSET ,tt NN) `(FORSOME lzn_ (IN lzn_ ,tt)))
    (let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'nn-least-element tt))))
           (least (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h tt) (dk-contains? h '<=))) "least"))
           (o `(+ ,b ,m)))
      ;; m in NN and f(b + m) /= 0
      (dk-have! `(AND (IN ,m NN) (NOT (= (lzf ,o) (ZERO lzk))))
        (lambda () (sep-me `(IN ,m ,tt)) (dk-conj-close! (lambda () (dk-ass!)))))
      (dk-split-all!)
      (dk-cite! 'nn-subset-zz m)
      (dk-have-and! `(IN ,b ZZ) `(IN ,m ZZ))
      (dk-cite! 'zz-add-closed b m)
      (dk-cite! 'nn-in-rr m)
      (dk-cite! 'zz-in-rr o)
      (ew o)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((j (dk-di-var!)))
                (di)
                (dk-cite! 'zz-in-rr j)
                (use-em `(< ,j ,b)
                  (lambda () (dk-chain-ass! (dk-apply! law j)) (dk-close-if-asm!))
                  (lambda ()
                    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge j b))
                    (pbc)
                    (let ((e `(+ ,j (- ,b))))
                      (dk-have-and! `(IN ,j ZZ) `(IN (- ,b) ZZ))
                      (dk-cite! 'zz-add-closed j `(- ,b))
                      (dk-cite! 'zz-in-rr e)
                      (dk-have! `(<= 0 ,e) (lambda () (dk-ineq! `(<= ,b ,j))))
                      (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn e))
                      (dk-have! `(= (+ ,b ,e) ,j) (lambda () (crs)))
                      (dk-have! `(IN ,e ,tt)
                        (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (subst `(= (+ ,b ,e) ,j)) (dk-ass!)))))
                      (dk-chain-ass! (dk-apply! least e))
                      (dk-absurd! `(<= ,m ,e) `(< ,j ,o)))))))))
      )))
(qed 'laurent-ord-exists)
