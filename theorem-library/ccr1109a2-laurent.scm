(dk-have! (c9l-bound 'lzk '(LAURENT-ZERO lzk) 0)
  (lambda () (dk-peel!) (mac 'LAURENT-ZERO) (dk-lam-b!) (c9l-rfl!)))
(dk-cite! 'laurent-set-in 'lzk '(LAURENT-ZERO lzk) 0)
(dk-close-if-asm!)
