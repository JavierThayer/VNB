;;; Library: complex-analysis.

;;; mvp-modulus.scm -- complex-analysis Proposition 3.55, the maximum modulus principle for the
;;; mean value property class on a connected open set (CAL-INT-2, 2026-10-28), and the clopen lemma
;;; it rests on.  Library: complex-analysis.  Load window: after mvp-max and metric-connected-laws
;;; (connected-locally-constant).  Prefix mxm-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mxm-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))

;;; =====================================================================
;;; (1) A subset of a connected set that is open in it and whose complement in it is open is all
;;;     of it, once it is not empty (connected-locally-constant, at the IF-indicator of the subset).
;;; =====================================================================
(define mxm-F '(VNB-LAMBDA mxq_ aa (IF (IN mxq_ ss) 0 1)))
(sp (make-wff "forall([s, aa, ss], is-connected(s, aa) implies ss subset aa implies
   forall([x in ss], forsome([r], pos-rr(r) and forall([y in aa], y in ball(s, x, r) implies y in ss))) implies
   forall([x in aa], not(x in ss) implies forsome([r], pos-rr(r) and forall([y in aa], y in ball(s, x, r) implies not(y in ss)))) implies
   forall([p in ss, q in aa], q in ss))"))
(dk-peel!)
(define mxm-c1-in (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'NOT)) (dk-contains? f 'BALL))) "the open clause"))
(define mxm-c1-out (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'NOT) (dk-contains? f 'BALL))) "the complement clause"))
(define (mxm-val! y in?)
  ;; goal contains (F y), y in aa: rewrite F(y) to 0 (in?) or 1
  (let ((ift (list 'IF (list 'IN y 'ss) 0 1)))
    (dk-lam-b!)
    (dk-if-branch! in? ift #f (lambda () 'done))))
(dk-have! (list 'FORALL 'mcx_ (list 'IMPLIES '(IN mcx_ aa)
            (list 'FORSOME 'mcr_ (list 'AND '(POS-RR mcr_)
              (list 'FORALL 'mcy_ (list 'IMPLIES '(IN mcy_ aa)
                (list 'IMPLIES '(IN mcy_ (BALL s mcx_ mcr_)) (list '= (list mxm-F 'mcy_) (list mxm-F 'mcx_)))))))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (use-em (list 'IN x 'ss)
        (lambda ()
          (let* ((r (dk-skolem! (dk-apply! mxm-c1-in x)))
                 (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r))) "clause")))
            (ew r)
            (dk-conj-close!
             (lambda ()
               (if (not (dk-head-is? (dk-goal) 'FORALL))
                   (ass)
                   (let* ((ls (dk-peel!))
                          (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'aa) (not (eq? (cadr f) x)))) ls)))))
                     (dk-apply! cl y)
                     (dk-lam-b!)
                     (dk-if-branch! #t (list 'IF (list 'IN y 'ss) 0 1) #f
                       (lambda () (dk-if-branch! #t (list 'IF (list 'IN x 'ss) 0 1) #f (lambda () (rfl)))))))))))
        (lambda ()
          (let* ((r (dk-skolem! (dk-apply! mxm-c1-out x)))
                 (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r))) "clause")))
            (ew r)
            (dk-conj-close!
             (lambda ()
               (if (not (dk-head-is? (dk-goal) 'FORALL))
                   (ass)
                   (let* ((ls (dk-peel!))
                          (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'aa) (not (eq? (cadr f) x)))) ls)))))
                     (dk-apply! cl y)
                     (dk-lam-b!)
                     (dk-if-branch! #f (list 'IF (list 'IN y 'ss) 0 1) #f
                       (lambda () (dk-if-branch! #f (list 'IF (list 'IN x 'ss) 0 1) #f (lambda () (rfl)))))))))))))))
(define mxm-lc (dk-cite! 'connected-locally-constant 's 'aa mxm-F))
(let* ((p (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ss))) "p")))
       (q (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'aa))) "q"))))
  (fact 'subset-mem-fwd 'ss 'aa p)
  (dk-apply! mxm-lc p q)
  (use-em (list 'IN q 'ss)
    (lambda () (ass))
    (lambda ()
      (dk-have! (list '= (list mxm-F p) 0)
        (lambda () (dk-lam-b!) (dk-if-branch! #t (list 'IF (list 'IN p 'ss) 0 1) #f (lambda () (rfl)))))
      (dk-have! (list '= (list mxm-F q) 1)
        (lambda () (dk-lam-b!) (dk-if-branch! #f (list 'IF (list 'IN q 'ss) 0 1) #f (lambda () (rfl)))))
      (fact 'rr-zero-in) (fact 'rr-one-in)
      (dk-have! (list 'IN (list mxm-F p) 'RR) (lambda () (subst (list '= (list mxm-F p) 0)) (ass)))
      (dk-have! (list 'IN (list mxm-F q) 'RR) (lambda () (subst (list '= (list mxm-F q) 1)) (ass)))
      (dk-have! '(< 0 0)
        (lambda () (dk-ineq! (list 'IN (list mxm-F p) 'RR) (list 'IN (list mxm-F q) 'RR)
                             (list '= (list mxm-F p) (list mxm-F q)) (list '= (list mxm-F p) 0) (list '= (list mxm-F q) 1))))
      (fact 'rr-lt-irrefl 0)
      (ai '(NOT (< 0 0))))))
(qed 'connected-clopen)

;;; =====================================================================
;;; (2) complex-analysis Proposition 3.55.  f with the mean value property on the connected open
;;; set u, |f| maximal at a point a of u: f is constant on u.  S = {y in u : f(y) = f(a)} is open
;;; (mvp-disc-max-constant at each of its points, where |f| is maximal too) and so is its complement
;;; in u (continuity), and a is in S: S = u by connected-clopen.
;;; =====================================================================
(define mxm-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define mxm-sub (list 'SUBSPACE-MS mxm-nfm 'u))
(define mxm-S '(SEP mxs_ u (= (f mxs_) (f a))))
(sp (make-wff "forall([u, f], has-mean-value-property(u, f) implies is-connected(cc-ms, u) implies
   forall([a in u], forall([z in u], magnitude(f(z)) <= magnitude(f(a))) implies forall([z in u], f(z) = f(a))))"))
(dk-peel!)
(define mxm-H '(HAS-MEAN-VALUE-PROPERTY u f))
(define mxm-z (cadr (cadr (dk-goal))))
(define mxm-bound (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude))) "the maximum"))
(dk-project! (list 'IS-OPEN mxm-nfm 'u) 'HAS-MEAN-VALUE-PROPERTY mxm-H)
(dk-project! '(IN f (FUN u CC)) 'HAS-MEAN-VALUE-PROPERTY mxm-H)
(define mxm-cont '(FORALL rgy_ (IMPLIES (IN rgy_ u) (IS-CONTINUOUS-AT (SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) u) (NF-METRIC-SPACE CC-NORMED-FIELD) f rgy_))))
(dk-project! mxm-cont 'HAS-MEAN-VALUE-PROPERTY mxm-H)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set)
(dk-cite! 'subclass-of-set-is-set 'u 'CC)
(fact 'nf-cc-is-metric-space)
(fact 'cc-is-normed-field) (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
(fact 'cc-nf-carr)
(dk-have! (list '== (list 'PTS mxm-nfm) 'CC) (lambda () (subst (list '== (list 'PTS mxm-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-cite! 'subspace-pts mxm-nfm 'u)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(define mxm-balls '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u))))))
(dk-project! mxm-balls 'IS-OPEN '(IS-OPEN CC-MS u))
(define (mxm-in-u! x) (fact 'subset-mem-fwd 'u 'CC x) (fact 'fun-apply-type-c 'f 'u 'CC x))
(define (mxm-sep-parts! x)        ; x in S in context: land x in u and f(x) = f(a), S kept
  (dk-have! (list 'IN x 'u) (lambda () (sep-me (list 'IN x mxm-S)) (dk-split-all!) (ass)))
  (dk-have! (list '= (list 'f x) '(f a)) (lambda () (sep-me (list 'IN x mxm-S)) (dk-split-all!) (ass))))
(mxm-in-u! 'a)
;; S inside u
(dk-have! (list 'SUBSET mxm-S 'u)
  (lambda () (let ((y (subset-by-element!))) (sep-me (list 'IN y mxm-S)) (dk-split-all!) (ass))))
;; S open
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mxm-S)
            (list 'FORSOME 'r (list 'AND '(POS-RR r)
              (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'IMPLIES '(IN y (BALL CC-MS x r)) (list 'IN 'y mxm-S))))))))
  (lambda ()
    (let* ((x (dk-di-var!)))
      (mxm-sep-parts! x)
      (mxm-in-u! x)
      (let* ((R (dk-skolem! (dk-apply! (dk-ctx-form mxm-balls) x)))
             (B (list 'BALL 'CC-MS x R)))
        (fact 'rr-pos-rr-in-rr R) (fact 'rr-lt-of-pos-rr R)
        (dk-have! (list 'FORALL 'cmvz_ (list 'IMPLIES (list 'IN 'cmvz_ B)
                    (list '<= '(magnitude (f cmvz_)) (list 'magnitude (list 'f x)))))
          (lambda ()
            (let ((w (dk-di-var!)))
              (fact 'subset-mem-fwd B 'u w)
              (dk-apply! mxm-bound w)
              (subst (list '= (list 'f x) '(f a)))
              (ass))))
        (let* ((dc (dk-cite! 'mvp-disc-max-constant 'u 'f x R)))
          (ew R)
          (dk-conj-close!
           (lambda ()
             (if (not (dk-head-is? (dk-goal) 'FORALL))
                 (ass)
                 (let* ((ls (dk-peel!))
                        (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'u) (not (eq? (cadr f) x)))) ls)))))
                   (dk-apply! dc y)
                   (in-sep! (lambda ()
                     (subst (list '= (list 'f y) (list 'f x)))
                     (ass))))))))))))
;; its complement in u open
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x u) (list 'IMPLIES (list 'NOT (list 'IN 'x mxm-S))
            (list 'FORSOME 'r (list 'AND '(POS-RR r)
              (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'IMPLIES '(IN y (BALL CC-MS x r)) (list 'NOT (list 'IN 'y mxm-S))))))))))
  (lambda ()
    (let* ((x (dk-di-var!))
           (_0 (dk-peel!))
           (fx (list 'f x)) (d (list '- fx '(f a))) (e (list 'magnitude d)))
      (mxm-in-u! x)
      (dk-have! (list 'NOT (list '= fx '(f a)))
        (lambda () (di) (dk-have! (list 'IN x mxm-S) (lambda () (in-sep! (lambda () (ass)))))
                   (ai (list 'NOT (list 'IN x mxm-S)))))
      (fact 'cc-sub-in-cc fx '(f a))
      (fact 'cc-magnitude-closed d) (fact 'cc-magnitude-nonneg d)
      (dk-have! (list 'NOT (list '= d 0))
        (lambda () (di) (dk-cite! 'cc-sub-zero-eq fx '(f a)) (ai (list 'NOT (list '= fx '(f a))))))
      (let ((ziff (dk-cite! 'cc-magnitude-zero-iff d)))
        (dk-have! (list 'NOT (list '= 0 e))
          (lambda () (di) (fact 'eq-sym 0 e)
                     (if (dk-only! (list '= e 0) (list 'NOT (list '= d 0)) ziff) (prop)))))
      (mxm-and! (list '<= 0 e) (list 'NOT (list '= 0 e)))
      (dk-cite! 'rr-le-ne-lt 0 e)
      (fact 'rr-pos-rr-of-lt e)
      (let* ((e2 (dk-halve! e))
             (ct (dk-apply! (dk-ctx-form mxm-cont) x))
             (_1 (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-CONTINUOUS-AT ct)))))
             (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST) (dk-contains? f 'POS-RR))) "continuity at x"))
             (dd (dk-skolem! (dk-apply! cl e2)))
             (cd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dd))) "the delta clause")))
        (fact 'rr-pos-rr-in-rr dd)
        (ew dd)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((ls (dk-peel!))
                      (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'u) (not (eq? (cadr f) x)))) ls))))
                      (fy (list 'f y)))
                 (mxm-in-u! y)
                 (di)
                 (sep-me (list 'IN y mxm-S))
                 (dk-split-all!)
                 ;; the distance of y to x is at most delta
                 (let* ((iff (dk-cite! 'ball-membership 'CC-MS x dd y)))
                   (dk-have! (list '<= (list '(DIST CC-MS) x y) dd)
                     (lambda () (if (dk-only! iff (list 'IN y (list 'BALL 'CC-MS x dd))) (prop)))))
                 (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (dk-have! (list 'IN y '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (dk-have! (list 'IN y (list 'PTS mxm-sub)) (lambda () (subst (list '== (list 'PTS mxm-sub) 'u)) (ass)))
                 (dk-cite! 'subspace-dist mxm-nfm 'u x y)
                 (dk-cite! 'nf-cc-agree-dist x y)
                 (dk-have! (list '<= (list (list 'DIST mxm-sub) x y) dd)
                   (lambda ()
                     (subst (list '== (list (list 'DIST mxm-sub) x y) (list (list 'DIST mxm-nfm) x y)))
                     (subst (list '== (list (list 'DIST mxm-nfm) x y) (list '(DIST CC-MS) x y)))
                     (ass)))
                 (dk-apply! cd y)
                 ;; |f(x) - f(y)| <= eps/2 while f(y) = f(a): contradiction with |f(x) - f(a)| = eps
                 (dk-have! (list 'IN fx '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (dk-have! (list 'IN fy '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (dk-cite! 'nf-cc-agree-dist fx fy)
                 (dk-cite! 'cc-ms-dist fx fy)
                 (fact 'cc-sub-in-cc fx fy)
                 (fact 'cc-magnitude-closed (list '- fx fy))
                 (dk-have! (list '<= (list 'magnitude (list '- fx fy)) e2)
                   (lambda ()
                     (subst (list '== (list 'magnitude (list '- fx fy)) (list '(DIST CC-MS) fx fy)))
                     (subst (list '== (list '(DIST CC-MS) fx fy) (list (list 'DIST mxm-nfm) fx fy)))
                     (ass)))
                 (dk-have! (list '<= e e2)
                   (lambda ()
                     (subst (list '= '(f a) fy))
                     (ass)))
                 (fact 'rr-pos-rr-in-rr e2) (fact 'rr-lt-of-pos-rr e2)
                 (dk-have! '(< 0 0)
                   (lambda () (dk-ineq! (list 'IN e 'RR) (list 'IN e2 'RR) (list '<= e e2) (list '= (list '+ e2 e2) e) (list '< 0 e2))))
                 (fact 'rr-zero-in)
                 (fact 'rr-lt-irrefl 0)
                 (ai '(NOT (< 0 0)))))))))))
(dk-have! (list 'IN 'a mxm-S) (lambda () (in-sep! (lambda () (rfl)))))
(let ((cl (dk-cite! 'connected-clopen 'CC-MS 'u mxm-S)))
  (dk-apply! cl 'a mxm-z)
  (sep-me (list 'IN mxm-z mxm-S))
  (dk-split-all!)
  (ass))
(qed 'mvp-maximum-modulus)
