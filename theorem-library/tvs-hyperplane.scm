;;; tb-hyper.scm -- topological-vector-space.pdf Prop 2.10: two linear functionals with a common hyperplane
;;; (a common coset of their kernels) are proportional, by a non-zero factor.
;;; Agent TB-01, 2026-10-26.  DESTINATION: theorem-library/tvs-hyperplane.scm (after linear-functional,
;;; hahn-banach-sublinear (hbs-lf-*)).  Library: analysis.  Helper prefix: tbh-.
;;;
;;; The hyperplane H is the coset x0 + f^{-1}(0) = {z : f(z) = f(x0)} of the one kernel and y0 + g^{-1}(0)
;;; of the other; "H is a coset of both" is stated as: for every z, f(z) = f(x0) iff g(z) = g(y0).

(define (tbh-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define tbh-rrv '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (tbh-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))
(define tbh-lff '(IS-LINEAR-FUNCTIONAL-ON m (VEC m) f))
(define tbh-lfg '(IS-LINEAR-FUNCTIONAL-ON m (VEC m) g))
(define tbh-coset '(FORALL hpz_ (IMPLIES (IN hpz_ (VEC m)) (IFF (= (f hpz_) (f x0)) (= (g hpz_) (g y0))))))
(define tbh-stmt
  (list 'FORALL 'm (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'x0 (list 'FORALL 'y0
    (fold-right (lambda (h acc) (list 'IMPLIES h acc))
      '(FORSOME hpc_ (AND (IN hpc_ RR) (AND (NOT (= hpc_ 0))
         (FORALL hpz_ (IMPLIES (IN hpz_ (VEC m)) (= (f hpz_) (* hpc_ (g hpz_))))))))
      (list '(IS-MODULE m) (list '= '(SCAL m) tbh-rrv) tbh-lff tbh-lfg
            '(FORSOME hpa_ (AND (IN hpa_ (VEC m)) (NOT (= (f hpa_) 0))))
            '(FORSOME hpa_ (AND (IN hpa_ (VEC m)) (NOT (= (g hpa_) 0))))
            '(IN x0 (VEC m)) '(IN y0 (VEC m)) tbh-coset))))))))

;;; values typed
(define (tbh-val! h v)
  (let ((c (list 'IN (list h v) 'RR)))
    (if (not (dk-asm? c)) (dk-cite! 'hbs-lf-val 'm '(VEC m) h v))
    c))

(sp (make-wff tbh-stmt))
(dk-peel!)
(let* ((exs (filter (lambda (f) (dk-head-is? f 'FORSOME)) (dk-asms)))
       (exf (car (filter (lambda (f) (dk-contains? f '(f hpa_))) exs)))
       (exg (car (filter (lambda (f) (dk-contains? f '(g hpa_))) exs)))
       (b (dk-skolem! exf #t))
       (a (dk-skolem! exg #t))
       (cos (dk-ctx-form tbh-coset)))
  (for-each (lambda (h) (for-each (lambda (v) (tbh-val! h v)) (list a b 'x0 'y0))) '(f g))
  ;; the kernel of g lies in the kernel of f (y0 is on H)
  (let ((kf '(FORALL hpz_ (IMPLIES (IN hpz_ (VEC m)) (IMPLIES (= (g hpz_) 0) (= (f hpz_) 0))))))
    (dk-have! kf
      (lambda ()
        (let* ((ld (dk-peel!))
               (z (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) ld))))
               (yz (list '(VADD m) 'y0 z)))
          (tbh-val! 'f z) (tbh-val! 'g z)
          (dk-cite! 'module-vadd-type 'm 'y0 z)
          (tbh-val! 'f yz) (tbh-val! 'g yz)
          (dk-cite! 'hbs-lf-add 'm '(VEC m) 'f 'y0 z)
          (dk-cite! 'hbs-lf-add 'm '(VEC m) 'g 'y0 z)
          (let ((i1 (inst*! cos 'y0)))
            (dk-have! '(= (g y0) (g y0)) (lambda () (rfl)))
            (dk-have! '(= (f y0) (f x0)) (lambda () (if (dk-only! i1 '(= (g y0) (g y0))) (prop)))))
          (let ((i2 (inst*! cos yz)))
            (dk-have! (list '= (list 'g yz) '(g y0))
              (lambda () (dk-ineq! (list '= (list 'g yz) (list '+ '(g y0) (list 'g z))) (list '= (list 'g z) 0)
                                   (list 'IN (list 'g yz) 'RR) '(IN (g y0) RR) (list 'IN (list 'g z) 'RR))))
            (dk-have! (list '= (list 'f yz) '(f x0)) (lambda () (if (dk-only! i2 (list '= (list 'g yz) '(g y0))) (prop)))))
          (dk-ineq! (list '= (list 'f yz) (list '+ '(f y0) (list 'f z))) (list '= (list 'f yz) '(f x0))
                    '(= (f y0) (f x0)) (list 'IN (list 'f yz) 'RR) '(IN (f y0) RR) '(IN (f x0) RR) (list 'IN (list 'f z) 'RR)))))
    ;; the factor c = f(a) / g(a)
    (let* ((fa (list 'f a)) (ga (list 'g a))
           (r (begin (tbh-and! (list 'IN ga 'RR) (list 'NOT (list '= ga 0)))
                     (dk-cite! 'rr-recip-closed ga)
                     (dk-name! (list 'recip ga))))
           (cc (list '* fa r)))
      (dk-cite! 'rr-recip-inverse ga)
      (let ((rinv (dk-rewrite-h! (list '= (list '* ga (list 'recip ga)) 1) (list 'recip ga) r)))
        (dk-have! (list 'IN cc 'RR) (lambda () (type-term)))
        (let ((pt (list 'FORALL 'hpz_ (list 'IMPLIES '(IN hpz_ (VEC m)) (list '= '(f hpz_) (list '* cc '(g hpz_)))))))
          (dk-have! pt
            (lambda ()
              (let* ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                     (fz (list 'f z)) (gz (list 'g z))
                     (ngz (list '- gz))
                     (w1 (list '(ACT m) ga z)) (w2 (list '(ACT m) ngz a))
                     (w (list '(VADD m) w1 w2)))
                (tbh-val! 'f z) (tbh-val! 'g z)
                (dk-have! (list 'IN ngz 'RR) (lambda () (type-term)))
                (dk-cite! 'hbs-in-carr 'm ga) (dk-cite! 'hbs-in-carr 'm ngz)
                (dk-cite! 'module-act-type 'm ga z) (dk-cite! 'module-act-type 'm ngz a)
                (dk-cite! 'module-vadd-type 'm w1 w2)
                (for-each (lambda (h) (tbh-val! h w1) (tbh-val! h w2) (tbh-val! h w)) '(f g))
                (for-each (lambda (h)
                            (dk-cite! 'hbs-lf-add 'm '(VEC m) h w1 w2)
                            (dk-cite! 'hbs-lf-hom 'm '(VEC m) h ga z)
                            (dk-cite! 'hbs-lf-hom 'm '(VEC m) h ngz a))
                          '(f g))
                ;; g(w) = 0
                (dk-have! (list '= (list 'g w) 0)
                  (lambda ()
                    (subst (list '= (list 'g w) (list '+ (list 'g w1) (list 'g w2))))
                    (subst (list '= (list 'g w1) (list '* ga gz)))
                    (subst (list '= (list 'g w2) (list '* ngz ga)))
                    (crs)))
                (dk-apply! (dk-ctx-form kf) w)
                ;; so ga * fz = gz * fa, and fz = r * ga * fz = r * (gz * fa)
                (dk-have! (list '= fz (list '* cc gz))
                  (lambda ()
                    (let* ((e0 (list '= (list 'f w) 0))
                           (e1 (dk-rewrite-h! e0 (list 'f w) (list '+ (list 'f w1) (list 'f w2))))
                           (e2 (dk-rewrite-h! e1 (list 'f w1) (list '* ga fz)))
                           (e3 (dk-rewrite-h! e2 (list 'f w2) (list '* ngz fa))))
                      (dk-have! (list '= (list '* ngz fa) (list '- (list '* gz fa))) (lambda () (crs)))
                      (for-each dk-real! (list (list '* ga fz) (list '* ngz fa) (list '* gz fa)))
                      (dk-have! (list '= (list '* gz fa) (list '* ga fz))
                        (lambda () (dk-ineq! e3 (list '= (list '* ngz fa) (list '- (list '* gz fa)))
                                             (list 'IN (list '* ga fz) 'RR) (list 'IN (list '* ngz fa) 'RR)
                                             (list 'IN (list '* gz fa) 'RR))))
                      (let* ((sv (dk-cite! 'rr-recip-solve ga (list '* gz fa) fz))
                             (sv2 (dk-rewrite-h! sv (list 'recip ga) r)))
                        (subst sv2)
                        (crs))))))))
          ;; c /= 0: else f(b) = 0
          (dk-have! (list 'NOT (list '= cc 0))
            (lambda ()
              (di)
              (dk-apply! (dk-ctx-form pt) b)
              (tbh-val! 'g b)
              (dk-have! (list '= (list 'f b) 0)
                (lambda () (subst (list '= (list 'f b) (list '* cc (list 'g b)))) (subst (list '= cc 0)) (crs)))
              (ai (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-contains? f (list 'f b)))) "f(b) /= 0"))))
          (ew cc)
          (dk-conj-close! dk-ass!))))))
(tbh-qed! 'hyperplane-functionals-proportional)
