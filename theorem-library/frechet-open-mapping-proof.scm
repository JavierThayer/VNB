      '(IS-NONTRIVIALLY-VALUED fld)
      '(IS-FRECHET-STRUCTURE fld m1 fam1)
      '(IS-FRECHET-STRUCTURE fld m2 fam2)
      '(IS-CONT-LIN m1 fam1 m2 fam2 tt)
      '(IS-LINEAR-MAP m2 m1 gg)
      '(FORALL x (IMPLIES (IN x (VEC m1)) (= (gg (tt x)) x)))
      '(FORALL y (IMPLIES (IN y (VEC m2)) (= (tt (gg y)) y))))
    '(IS-CONT-LIN m2 fam2 m1 fam1 gg))))
(let* ((ls (dk-peel!))
       (linv (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(gg (tt x))))) ls))
       (rinv (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(tt (gg y))))) ls))
       (surj '(FORALL y (IMPLIES (IN y (VEC m2)) (FORSOME x (AND (IN x (VEC m1)) (= y (tt x))))))))
  (dk-have! '(IS-SEMINORM-FAMILY fld m1 fam1)
    (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1)) (dk-split-all!) (ass)))
  (dk-have! '(IS-SEMINORM-FAMILY fld m2 fam2)
    (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m2 fam2)) (dk-split-all!) (ass)))
  (dk-have! '(IS-LINEAR-MAP m1 m2 tt)
    (lambda () (mac-h 'is-cont-lin '(IS-CONT-LIN m1 fam1 m2 fam2 tt)) (dk-split-all!) (ass)))
  (dk-cite! 'fom-lin-type 'm2 'm1 'gg)
  (dk-cite! 'fom-lin-type 'm1 'm2 'tt)
  (dk-cite! 'frm-metric-space-pts 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1) (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-have! surj
    (lambda ()
      (let ((y (cadr (car (dk-peel!)))))
        (dk-cite! 'fun-apply-type-c 'gg '(VEC m2) '(VEC m1) y)
        (dk-apply! rinv y)
        (ew (list 'gg y))
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (ass)
                (begin (subst (list '= (list 'tt (list 'gg y)) y)) (rfl))))))))
  (dk-cite! 'fom-baire-approx 'fld 'm1 'fam1 'm2 'fam2 'tt)
  (let ((open (dk-cite! 'fom-open-of-approx 'fld 'm1 'fam1 'm2 'fam2 'tt)))
    (mac 'is-cont-lin)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IS-LINEAR-MAP)
            (ass)
            (let* ((ls2 (dk-peel!))
                   (sq (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN (VEC m2))))) ls2)))
                   (lm (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m2)))) ls2)))
                   (conv (find-first (dk-head? 'FR-CONV) ls2)))
              (mac 'fr-conv)
              (let* ((ls3 (dk-peel!))
                     (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls3)))
                     (e (cadr (find-first (dk-head? 'POS-RR) ls3)))
                     (opx (list 'FORSOME 'gn_ (list 'AND '(IN gn_ NN) (list 'FORSOME 'ge_ (list 'AND '(POS-RR ge_)
                            (list 'SUBSET '(FR-BALL m2 fam2 gn_ ge_) (list 'IMAGE 'tt (list 'FR-BALL 'm1 'fam1 k e)))))))))
                (dk-have! opx
                  (lambda ()
                    (mac-h 'is-open-lin-map open)
                    (dk-split-all!)
                    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IMAGE))) "openness") k e)
                    (ass)))
                (let* ((nb (dk-skolem! opx))
                       (et (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb))) "eta")))
                       (sub (dk-pick (dk-head? 'SUBSET) "the inclusion"))
                       (rho (dk-skolem! (dk-cite! 'fom-dist-prefix nb 'fld 'm2 'fam2 et)))
                       (dp (fom-pick-forall-with rho "dist-prefix"))
                       (_ (dk-cite! 'rr-pos-rr-in-rr rho))
                       (rh (dk-halve! rho))
                       (ct (dk-cite! 'frm-converges-of-conv 'fld 'm2 'fam2 sq lm))
                       (cx (list 'FORSOME 'gN_ (list 'AND '(IN gN_ NN)
                              (list 'FORALL 'gm_ (list 'IMPLIES '(IN gm_ NN) (list 'IMPLIES '(<= gN_ gm_)
                                (list '<= (list '(DIST (FR-METRIC-SPACE m2 fam2)) (list sq 'gm_) lm) rh))))))))
                  (dk-have! cx
                    (lambda ()
                      (mac-h 'converges-to ct)
                      (dk-split-all!)
                      (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "the eps universal") rh)
                      (ass)))
                  (let* ((nn0 (dk-skolem! cx))
                         (cu (fom-pick-forall-with nn0 "the tail")))
                    (ew nn0)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN)
                            (ass)
                            (let* ((ls4 (dk-split-all! (dk-peel!)))
                                   (i (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) nn0))) (dk-asms))))
                                   (si (list sq i))
                                   (df (fom-sub 'm2 si lm)))
                              (dk-lam-b!)
                              (dk-cite! 'fun-apply-type-c sq 'NN '(VEC m2) i)
                              (fom-vec! 'm2 df)
                              (dk-apply! cu i)
                              (fom-to-pts! si) (fom-to-pts! lm)
                              (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm2 'fam2)
                              (dk-cite! 'metric-dist-real fom-fms si lm)
                              (dk-have! (list '< (fom-d si lm) rho)
                                (lambda () (dk-ineq! (list '<= (fom-d si lm) rh) (list '= (list '+ rh rh) rho) (list '< 0 rh))))
                              (let ((pf (dk-apply! dp si lm)))
                                (dk-have! (list 'IN df (list 'FR-BALL 'm2 'fam2 nb et))
                                  (lambda ()
                                    (mac 'FR-BALL)
                                    (in-sep! (lambda () (ass))
                                      (lambda ()
                                        (let* ((ls5 (dk-split-all! (dk-peel!)))
                                               (jj (cadr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) nb))) (dk-asms)))))
                                          (dk-apply! pf jj)
                                          (ass))))))
                                (dk-cite! 'subset-mem-fwd (list 'FR-BALL 'm2 'fam2 nb et) (list 'IMAGE 'tt (list 'FR-BALL 'm1 'fam1 k e)) df)
                                (mac-h 'image-membership-iff (list 'IN df (list 'IMAGE 'tt (list 'FR-BALL 'm1 'fam1 k e))))
                                (dk-split-all!)
                                (let* ((xx (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f df))) "the preimage")))
                                       (bm (list 'IN xx (list 'FR-BALL 'm1 'fam1 k e)))
                                       (red (dk-landed (lambda () (mac-h 'fom-fr-ball-unfold bm))))
                                       (_ (sep-me (car red)))
                                       (bx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f xx) (dk-contains? f e))) "x's prefix")))
                                  (dk-cite! 'nn-le-refl k)
                                  (dk-have! (list 'AND (list 'IN k 'NN) (list '<= k k)) (lambda () (dk-conj-close! ass)))
                                  (dk-apply! bx k)
                                  (dk-cite! 'fun-apply-type-c 'gg '(VEC m2) '(VEC m1) si)
                                  (dk-cite! 'fun-apply-type-c 'gg '(VEC m2) '(VEC m1) lm)
                                  (let ((ls (dk-cite! 'frm-linear-sub 'm2 'm1 'gg si lm)))
                                    (subst (list '= (caddr ls) (cadr ls))))
                                  (subst (list '= df (list 'tt xx)))
                                  (subst (dk-apply! linv xx))
                                  (ass))))))))))))))))
(fom-qed! 'open-mapping-bounded-inverse)


