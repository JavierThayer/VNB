          (dk-apply! pz i)
          (dk-ineq! (list '< (list (list 'fam2 i) zz) eta2) (list '<= eta2 eta)))))
    (dk-apply! ap zz)
    (ass)))

(sp (make-wff (fom-6
  (list 'IMPLIES '(IS-FRECHET-STRUCTURE fld m1 fam1)
