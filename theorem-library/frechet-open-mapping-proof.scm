;;; =====================================================================
;;; (9) THE RADII OF THE SUCCESSIVE APPROXIMATION: a(k) = 1/(n0 + k + 1).
;;;     Positive, strictly decreasing, eventually below any d > 0 uniformly in
;;;     n0; the k-th correction has radius a(k) - a(k+1), so the corrections
;;;     telescope (fom-telescope) with no geometric series.
;;; =====================================================================
(define (fom-a n0 k) (list 'recip (list '+ (list '+ n0 k) 1)))
(define (fom-nn-sum! a b)          ; (IN (+ a b) NN), (IN (+ a b) RR)
  (let ((s (list '+ a b)))
    (fom-once! (list 'IN s 'NN)
      (lambda () (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close! ass)))
                 (dk-cite! 'nn-add-closed a b)))
    (fom-once! (list 'IN s 'RR) (lambda () (dk-cite! 'nn-in-rr s)))
    (fom-once! (list 'IN a 'RR) (lambda () (dk-cite! 'nn-in-rr a)))
    (fom-once! (list 'IN b 'RR) (lambda () (dk-cite! 'nn-in-rr b)))
    s))
;;; a(k) in RR and 0 < a(k)
(define (fom-a-type! n0 k)
  (let* ((m (fom-nn-sum! n0 k)) (u (list '+ m 1)) (au (list 'recip u)))
    (fom-once! (list 'IN au 'RR)
      (lambda ()
        (dk-real! u)
        (dk-cite! 'nn-zero-le m)
        (dk-have! (list '< 0 u) (lambda () (dk-ineq! (list '<= 0 m))))
        (dk-have! (list 'AND (list 'IN u 'RR) (list 'NOT (list '= u 0)))
          (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                     (begin (di) (dk-absurd! (list '= u 0) (list '< 0 u))))))))
        (dk-cite! 'rr-recip-closed u)
        (dk-cite! 'rr-recip-pos u)))
    au))

(sp (make-wff '(FORALL n0 (IMPLIES (IN n0 NN) (FORALL k (IMPLIES (IN k NN)
  (AND (IN (recip (+ (+ n0 k) 1)) RR)
    (AND (< 0 (recip (+ (+ n0 k) 1)))
      (< (recip (+ (+ n0 (succ k)) 1)) (recip (+ (+ n0 k) 1)))))))))))
(let* ((ls (dk-peel!))
       (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (n0 (if (memq 'n0 vs) 'n0 (error "n0")))
       (k (if (memq 'k vs) 'k (error "k")))
       (sk (list 'succ k))
       (m (fom-nn-sum! n0 k))
       (u (list '+ m 1)) (v (list '+ u 1)))
  (fom-a-type! n0 k)
  (dk-cite! 'nn-succ-closed k)
  (fom-a-type! n0 sk)
  ;; n0 + succ k = (n0 + k) + 1
  (dk-cite! 'nn-add-succ n0 k)
  (dk-cite! 'nn-succ-plus-one m)
  (dk-real! v)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (if (and (dk-head-is? g '<) (dk-contains? g sk))
            (begin
              (subst (list '= (list '+ n0 sk) (list 'succ m)))
              (subst (list '= (list 'succ m) u))
              (dk-have! (list '<= u v) (lambda () (dk-ineq!)))
              (dk-have! (list '< 0 v) (lambda () (dk-ineq! (list '< 0 u))))
              (dk-cite! 'rr-recip-antitone u v)
              (mac '<)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) '<=)
                      (ass)
                      (begin
                        (di)
                        (let* ((h (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list 'recip v)))) (dk-asms)))
                               (e1 (dk-cite! 'rr-recip-recip-pos v))
                               (e2 (dk-cite! 'rr-recip-recip-pos u))
                               (e3 (dk-rewrite-h! e1 (list 'recip v) (list 'recip u)))
                               (e4 (dk-rewrite-h! e3 (list 'recip (list 'recip u)) u)))
                          (dk-absurd! e4)))))))
            (ass))))))
(fom-qed! 'fom-a-facts)

(sp (make-wff '(FORALL d (IMPLIES (POS-RR d) (FORSOME cap (AND (IN cap NN)
  (FORALL n0 (IMPLIES (IN n0 NN) (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= cap k)
    (<= (recip (+ (+ n0 k) 1)) d))))))))))))
(let* ((ls (dk-peel!))
       (d (cadr (find-first (dk-head? 'POS-RR) ls)))
