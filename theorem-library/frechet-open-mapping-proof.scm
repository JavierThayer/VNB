;;; =====================================================================
;;; (8) EXERCISE 8.9 (c)-(f), THE BAIRE STEP.  For every basic neighbourhood
;;;     V = {p_j < dl, j <= N} of 0 in E, some prefix ball {q_i < eta, i <= nb} of
;;;     F lies in the CLOSURE of tt(V) -- stated without a closure operator, as
;;;     APPROXIMABILITY: every z of the ball is, for every k and th, within th of
;;;     some tt(x), x in V, in the seminorms q_0..q_k.
;;;     Route: F = U_j tt(V_j), V_j = {p_i < j, i <= N} (surjectivity and
;;;     fom-prefix-bound); Baire (fom-baire-ball) in the complete metric space
;;;     FR-METRIC-SPACE(m2, fam2) gives a ball B(c, r) in the closure of one
;;;     tt(V_j0); the difference trick puts every w with d(w + c, c) < r in the
;;;     closure of tt(V_j0 - V_j0) within V_2j0; a small invertible scalar sg
;;;     (|sg| 2 j0 < dl, fom-small-unit) carries V_2j0 into V and its inverse ta
;;;     carries a small prefix ball onto such w.  The book's (c), (d), (g) are
;;;     these two scalings; its (e) is the cover.
;;; =====================================================================
(define (fom-pfx fam iv bound v rel rhs)
  (list 'FORALL iv (list 'IMPLIES (list 'IN iv 'NN)
    (list 'IMPLIES (list '<= iv bound) (list rel (list (list fam iv) v) rhs)))))
(define (fom-apx z nb0 dl)
  (list 'FORALL 'fk_ (list 'IMPLIES '(IN fk_ NN)
    (list 'FORALL 'fth_ (list 'IMPLIES '(POS-RR fth_)
      (list 'FORSOME 'fx_ (list 'AND '(IN fx_ (VEC m1))
        (list 'AND (fom-pfx 'fam1 'fj_ nb0 'fx_ '< dl)
                   (fom-pfx 'fam2 'fi_ 'fk_ (fom-sub 'm2 z '(tt fx_)) '< 'fth_)))))))))
(define (fom-ballapx nb0 dl)
  (list 'FORSOME 'fnb_ (list 'AND '(IN fnb_ NN)
    (list 'FORSOME 'feta_ (list 'AND '(POS-RR feta_)
      (list 'FORALL 'fz_ (list 'IMPLIES '(IN fz_ (VEC m2))
        (list 'IMPLIES (fom-pfx 'fam2 'fi_ 'fnb_ 'fz_ '< 'feta_)
          (fom-apx 'fz_ nb0 dl)))))))))
(define fom-surj
  '(FORALL y (IMPLIES (IN y (VEC m2)) (FORSOME x (AND (IN x (VEC m1)) (= y (tt x)))))))
(define (fom-6 body)
  (list 'FORALL 'fld (list 'FORALL 'm1 (list 'FORALL 'fam1 (list 'FORALL 'm2 (list 'FORALL 'fam2
    (list 'FORALL 'tt body)))))))

;;; small helpers for this section (the names fld, m1, fam1, m2, fam2, tt are the
;;; statement's own, never renamed: they are the outermost binders)
(define fom-fms '(FR-METRIC-SPACE m2 fam2))
(define fom-pts (list 'PTS fom-fms))
(define (fom-d a b) (list (list 'DIST fom-fms) a b))
(define (fom-to-pts! v)            ; (IN v PTS) from (IN v (VEC m2))
  (let ((ty (list 'IN v fom-pts)))
    (fom-once! ty (lambda () (dk-rewrite-h! (list 'IN v '(VEC m2)) '(VEC m2) fom-pts)))
    ty))
(define (fom-to-vec! v)            ; (IN v (VEC m2)) from (IN v PTS)
  (let ((ty (list 'IN v '(VEC m2))))
    (fom-once! ty (lambda () (dk-rewrite-h! (list 'IN v fom-pts) fom-pts '(VEC m2))))
    ty))
(define (fom-sc! md v)             ; (IN v (CARR (SCAL md))) from (IN v (CARR fld))
  (let ((ty (list 'IN v (list 'CARR (list 'SCAL md))))
        (vw (fom-nfv 'fld)))
    (fom-once! ty
      (lambda ()
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN v '(CARR fld)) '(CARR fld) (list 'CARR vw))
                       vw (list 'SCAL md))))
    ty))
(define (fom-sn-at! md fm k)       ; (IS-SEMINORM fld md (fm k))
  (let ((sn (list 'IS-SEMINORM 'fld md (list fm k))))
    (fom-once! sn (lambda () (dk-apply! (dk-cite! 'frm-fam-seminorm 'fld md fm) k)))
    sn))
(define (fom-pval! md fm k v)      ; (IN ((fm k) v) RR), v typed in VEC md, k in NN
  (let ((ty (list 'IN (list (list fm k) v) 'RR)))
    (if (and (pair? v) (not (symbol? (car v))) (memq (car (car v)) '(VADD VNEG ACT)))
        (fom-vec! md v))
    (fom-once! ty
      (lambda ()
        (dk-cite! 'frm-fam-type 'fld md fm)
        (dk-cite! 'fun-apply-type-c fm 'NN (list 'FUN (list 'VEC md) 'RR) k)
        (dk-cite! 'fun-apply-type-c (list fm k) (list 'VEC md) 'RR v)))
    ty))



(define (fom-p1-body! N dl j0 c r rh bu sg ta nbu dlu ub eta te lam)
  (let* ((ls (dk-peel!))
         (z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m2)))) ls)))
         (pz (find-first (dk-head? 'FORALL) ls))
         (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
         (th (cadr (find-first (dk-head? 'POS-RR) ls)))
         (nsg (fom-nfn 'fld sg)) (nta (fom-nfn 'fld ta))
         (w (fom-act 'm2 ta z))
         (wc (fom-add 'm2 w c))
         (big (list '+ j0 j0)))
    (fom-vec! 'm2 w) (fom-vec! 'm2 wc)
    ;; ---- w + c lies in the ball B(c, r), hence in the closure; so does c
    (let ((pw (list 'FORALL 'fj2_ (list 'IMPLIES '(IN fj2_ NN) (list 'IMPLIES (list '<= 'fj2_ nbu)
                (list '< (list '(fam2 fj2_) (fom-sub 'm2 wc c)) dlu))))))
      (dk-have! pw
        (lambda ()
          (let* ((j (cadr (car (dk-peel!)))))
            (subst (dk-cite! 'fom-v-shift-back 'm2 w c))
            (fom-sn-at! 'm2 'fam2 j)
            (let* ((e (dk-cite! 'frm-sn-homog 'fld 'm2 (list 'fam2 j) ta z))
                   (qz (list (list 'fam2 j) z)))
              (subst e)
              (fom-pval! 'm2 'fam2 j z)
              (dk-apply! pz j)
              (dk-real! eta)
              (dk-cite! 'fom-mul-lt-left qz eta nta)
              (dk-real! (list '* nta qz)) (dk-real! (list '* nta eta))
              (dk-ineq! (list '< (list '* nta qz) (list '* nta eta)) te)))))
      (dk-apply! ub wc c))
    (fom-to-pts! wc) (fom-to-pts! c)
    (let* ((dwc (fom-d wc c)) (dcw (fom-d c wc)) (dcc (fom-d c c)))
      (dk-cite! 'rr-lt-of-pos-rr r)
      (dk-cite! 'metric-sym fom-fms wc c)
      (dk-cite! 'metric-dist-real fom-fms wc c)
      (dk-cite! 'metric-self-zero fom-fms c)
      (dk-have! (list '< dcw r) (lambda () (subst (list '= dcw dwc)) (dk-ineq! (list '<= dwc rh) (list '= (list '+ rh rh) r) (list '< 0 rh))))
      (dk-have! (list '< dcc r) (lambda () (subst (list '= dcc 0)) (dk-ineq! (list '< 0 r))))
      (dk-apply! bu wc)
      (dk-apply! bu c))
    ;; ---- approximate w + c and c by points of tt(V_j0)
    (let* ((th1 (list '* th nta))
           (_ (begin (dk-cite! 'rr-pos-rr-in-rr th) (dk-cite! 'rr-lt-of-pos-rr th)
                     (dk-cite! 'rr-mul-pos th nta) (dk-real! th1) (dk-cite! 'rr-pos-rr-of-lt th1)))
           (th2 (dk-halve! th1))
           (rho (dk-skolem! (dk-cite! 'fom-dist-prefix k 'fld 'm2 'fam2 th2)))
           (dp (fom-pick-forall-with rho "the dist-prefix universal"))
           (pt1 (dk-skolem! (dk-cite! 'fom-closure-near fom-fms (list lam j0) wc rho)))
           (pt2 (dk-skolem! (dk-cite! 'fom-closure-near fom-fms (list lam j0) c rho)))
           (open-pt (lambda (pt)
                      (let* ((mem (list 'IN pt (list lam j0)))
                             (red (dk-landed (lambda () (dk-lam-b-h! mem))))
                             (sm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) pt)
                                                              (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
                        (sep-me sm)
                        (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f pt)))
                                             "the preimage")))))
           (x1 (open-pt pt1))
           (x2 (open-pt pt2))
           (xp (fom-sub 'm1 x1 x2))
           (xx (fom-act 'm1 sg xp)))
      (dk-apply! dp wc pt1)
      (dk-apply! dp c pt2)
      (fom-vec! 'm1 xp) (fom-vec! 'm1 xx)
      (ew xx)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond
              ((dk-head-is? gl 'IN) (ass))
              ((dk-contains? gl 'fam1)
               ;; p_j(sg.x') = |sg| p_j(x') < |sg| 2 j0 < dl
               (let* ((j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) (dk-peel!))))
                      (pxp (list (list 'fam1 j) xp))
                      (pre1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f x1) (dk-contains? f 'fam1))) "x1's prefix"))
                      (pre2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f x2) (dk-contains? f 'fam1))) "x2's prefix")))
                 (fom-sn-at! 'm1 'fam1 j)
                 (subst (dk-cite! 'frm-sn-homog 'fld 'm1 (list 'fam1 j) sg xp))
                 (for-each (lambda (v) (fom-pval! 'm1 'fam1 j v)) (list x1 x2 xp))
                 (let* ((sl (dk-cite! 'fom-sn-sub-le 'fld 'm1 (list 'fam1 j) x1 x2))
                        (b1 (dk-apply! pre1 j))
                        (b2 (dk-apply! pre2 j)))
                   (dk-have! (list '< pxp big) (lambda () (dk-ineq! sl b1 b2)))
                   (dk-cite! 'fom-mul-lt-left pxp big nsg)
                   (dk-real! (list '* nsg pxp)) (dk-real! (list '* nsg big))
                   (let* ((nm (dk-name! (list '* nsg big)))
                          (h1 (dk-rewrite-h! (list '< (list '* nsg pxp) (list '* nsg big)) (list '* nsg big) nm))
                          (h2 (dk-rewrite-h! (list '< (list '* nsg big) dl) (list '* nsg big) nm)))
                     (dk-ineq! h1 h2)))))
              ((dk-contains? gl 'fam2)
               ;; q_i(z - tt(sg.x')) = |sg| q_i(w - tt x') = |sg| q_i((w+c - pt1) - (c - pt2)) < |sg| th |ta| = th
               (let* ((i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) (dk-peel!))))
                      (q (list 'fam2 i))
                      (txp (list 'tt xp))
                      (u (fom-sub 'm2 w txp))
                      (a1 (fom-sub 'm2 wc pt1)) (a2 (fom-sub 'm2 c pt2))
                      (dd (fom-sub 'm2 a1 a2))
                      (e1 (dk-cite! 'frm-linear-homog 'm1 'm2 'tt sg xp))
                      (e2 (dk-cite! 'fom-act-cancel 'fld 'm2 sg ta z)))
                 (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) xp)
                 (subst e1)
                 (subst (list '= z (cadr e2)))
                 (let ((e3 (dk-cite! 'frm-act-sub-vec 'm2 sg w txp)))
                   (subst (list '= (caddr e3) (cadr e3))))
                 (fom-vec! 'm2 u) (fom-vec! 'm2 dd)
                 (fom-sn-at! 'm2 'fam2 i)
                 (subst (dk-cite! 'frm-sn-homog 'fld 'm2 q sg u))
                 (for-each (lambda (v) (fom-pval! 'm2 'fam2 i v)) (list u a1 a2 dd))
                 (let ((eqq (list '= (list q u) (list q dd))))
                   (dk-have! eqq
                     (lambda ()
                       (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x1)
                       (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x2)
                       (subst (dk-cite! 'frm-linear-sub 'm1 'm2 'tt x1 x2))
                       (subst (list '= (list 'tt x1) pt1))
                       (subst (list '= (list 'tt x2) pt2))
                       (let ((e8 (dk-cite! 'fom-v-quad 'm2 wc c pt1 pt2)))
                         (subst (list '= (caddr e8) (cadr e8))))
                       (subst (dk-cite! 'fom-v-shift-back 'm2 w c))
                       (let ((v2 (fom-sub 'm2 w (fom-sub 'm2 pt1 pt2))))
                         (fom-vec! 'm2 v2)
                         (fom-pval! 'm2 'fam2 i v2))
                       (rfl)))
                   (let* ((sl (dk-cite! 'fom-sn-sub-le 'fld 'm2 q a1 a2))
                          (b1 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a1) (dk-contains? f th2))) "dp at w+c") i))
                          (b2 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a2) (dk-contains? f th2))) "dp at c") i))
                          (qu (list q u)))
                     (dk-have! (list '< qu th1) (lambda () (dk-ineq! eqq sl b1 b2 (list '= (list '+ th2 th2) th1))))
                     (dk-cite! 'fom-mul-lt-left qu th1 nsg)
                     (dk-have! (list '= (list '* nsg th1) (list '* th (list '* nsg nta))) (lambda () (crs)))
                     (let ((t3 (dk-rewrite-h! (list '= (list '* nsg th1) (list '* th (list '* nsg nta))) (list '* nsg nta) 1)))
                       (dk-real! (list '* nsg qu)) (dk-real! (list '* nsg th1))
                       (dk-ineq! (list '< (list '* nsg qu) (list '* nsg th1)) t3))))))
              (#t (error "fom-p1: unexpected leaf" gl)))))))))
(sp (make-wff (fom-6
  (list 'IMPLIES '(IS-NONTRIVIALLY-VALUED fld)
  (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m1 fam1)
  (list 'IMPLIES '(IS-FRECHET-STRUCTURE fld m2 fam2)
  (list 'IMPLIES '(IS-LINEAR-MAP m1 m2 tt)
  (list 'IMPLIES fom-surj
    (list 'FORALL 'fn_ (list 'IMPLIES '(IN fn_ NN)
      (list 'FORALL 'fdl_ (list 'IMPLIES '(POS-RR fdl_) (fom-ballapx 'fn_ 'fdl_)))))))))))))
(let* ((ls (dk-peel!))
       (N (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (dl (cadr (find-first (dk-head? 'POS-RR) ls)))
       (surj (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tt))) ls))
       (F2 '(IS-FRECHET-STRUCTURE fld m2 fam2))
       (lam (list 'VNB-LAMBDA 'fjv_ 'NN
              (list 'SEP 'fyv_ '(VEC m2)
                (list 'FORSOME 'fxv_ (list 'AND '(IN fxv_ (VEC m1))
                  (list 'AND (fom-pfx 'fam1 'fiv_ N 'fxv_ '< 'fjv_) '(= fyv_ (tt fxv_)))))))))
  (dk-have! '(IS-SEMINORM-FAMILY fld m2 fam2) (lambda () (mac-h 'is-frechet-structure F2) (dk-split-all!) (ass)))
  (dk-have! (list 'IS-COMPLETE fom-fms) (lambda () (mac-h 'frm-frechet-iff-complete F2) (dk-split-all!) (ass)))
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1) (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'rr-pos-rr-in-rr dl)
  (dk-cite! 'frm-fam-field 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-scal 'fld 'm1 'fam1) (dk-cite! 'frm-fam-scal 'fld 'm2 'fam2)
  (dk-cite! 'normed-field-ring-view-carr 'fld)
  (dk-cite! 'fom-lin-type 'm1 'm2 'tt)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm2 'fam2)
  (dk-cite! 'frm-metric-space-pts 'fld 'm2 'fam2)
  (dk-cite! 'frm-module-vec-set 'm2)
  (dk-cite! 'ms-pts-is-set fom-fms)
  ;; ---- the family j |-> tt(V_j), as subsets of the space
  (dk-have! (list 'IN lam (list 'FUN 'NN (list 'POWER fom-pts)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((j (cadr (car (dk-peel!))))
                 (sj (cadr (dk-goal))))
            (dk-have! (list 'IN sj 'SET) (lambda () (sep-set) (if (dk-head-is? (dk-goal) 'IN) (ass))))
            (dk-have! (list 'FORALL 'fzz_ (list 'IMPLIES (list 'IN 'fzz_ sj) (list 'IN 'fzz_ fom-pts)))
              (lambda ()
                (let* ((ls2 (dk-peel!)) (mem (car ls2)) (zz (cadr mem)))
                  (sep-me mem)
                  (fom-to-pts! zz)
                  (ass))))
            (dk-cite! 'power-mem-intro fom-pts sj)
            (ass))))))
  ;; ---- they cover
  (let ((cov (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y fom-pts)
               (list 'FORSOME 'j (list 'AND '(IN j NN) (list 'IN 'y (list lam 'j))))))))
    (dk-have! cov
      (lambda ()
        (let* ((y (cadr (car (dk-peel!)))))
          (fom-to-vec! y)
          (let* ((x (dk-skolem! (dk-apply! surj y))))
            (dk-have! (list 'FORALL 'fi2_ (list 'IMPLIES '(IN fi2_ NN) (list 'IN (list '(fam1 fi2_) x) 'RR)))
              (lambda () (let ((i (cadr (car (dk-peel!))))) (fom-pval! 'm1 'fam1 i x) (ass))))
            (let ((cap (dk-skolem! (dk-cite! 'fom-prefix-bound N 'fam1 x))))
              (ew cap)
              (dk-conj-close!
                (lambda ()
                  (if (equal? (dk-goal) (list 'IN cap 'NN))
                      (ass)
                      (begin
                        (dk-lam-b!)
                        (in-sep! (lambda () (ass))
                                 (lambda () (ew x) (dk-conj-close!))))))))))))
    ;; ---- Baire: a ball B(c, r) in the closure of tt(V_j0)
    (dk-cite! 'module-vzero-in 'm2)
    (fom-to-pts! '(VZERO m2))
    (let* ((j0 (dk-skolem! (dk-cite! 'fom-baire-ball fom-fms '(VZERO m2) lam)))
           (c (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f j0))) "the centre")))
           (r (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f c))) "the radius")))
           (bu (fom-pick-forall-with 'CLOSURE "the ball in the closure"))
           (big (list '+ j0 j0)))
      (fom-to-vec! c)
      (dk-cite! 'nn-in-rr j0)
      (dk-real! big)
      (dk-cite! 'nn-zero-le j0)
      (dk-have! (list '<= 0 big) (lambda () (dk-ineq! (list '<= 0 j0))))
      ;; ---- the small scalar
      (let* ((sg (dk-skolem! (dk-cite! 'fom-small-unit 'fld big dl)))
             (ta (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sg))) "ta")))
             (nsg (fom-nfn 'fld sg)) (nta (fom-nfn 'fld ta))
             (rh (begin (dk-cite! 'rr-pos-rr-in-rr r) (dk-halve! r)))
             (nbu (dk-skolem! (dk-cite! 'frm-seminorm-ball 'fld 'm2 'fam2 rh)))
             (dlu (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nbu))) "dlU")))
             (ub (fom-pick-forall-with dlu "the prefix-ball universal"))
             (eta (list '* dlu nsg)))
        (for-each (lambda (u) (dk-cite! 'nf-norm-in-rr 'fld u)) (list sg ta))
