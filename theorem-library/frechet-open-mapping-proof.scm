;;; frechet-open-mapping-proof.scm -- the OPEN MAPPING THEOREM for Frechet spaces and
;;; its bounded-inverse corollary: Thayer, "Analise Funcional e Teoria Espectral",
;;; Ch. 8 s.4, Thm 8.30, proved by the roadmap of exercise 8.9 (a)-(i).  Batch TVS-2A,
;;; 2026-10-11/12.  Helper prefix: fom-.  Every theorem here is proven modulo 0; nothing is
;;; asserted, warranted or stamped.
;;;
;;; TARGETS (statements copied literally from the supports of
;;; structure-library/frechet-open-mapping.scm, which this file retires):
;;;   open-mapping-theorem           continuous linear surjection between Frechet spaces
;;;                                  over a non-trivially valued field is open
;;;   open-mapping-bounded-inverse   a continuous linear bijection has continuous inverse
;;;
;;; THE ROUTE (the book's letters in brackets).
;;;   * The book's "norm" ||x|| = d(x, 0) and its balls are used ONCE, to invoke Baire in
;;;     the complete metric space FR-METRIC-SPACE(m2, fam2) (frechet-metric.scm).  Every
;;;     other neighbourhood of 0 is a PREFIX BALL {p_j < r, j <= N}, and the closure of
;;;     tt(V) is stated as APPROXIMABILITY (fom-apx): z is approximable from tt(V) when for
;;;     every k and th some x in V has q_i(z - tt x) < th for i <= k.  Two nestings convert:
;;;     frm-seminorm-ball (prefix ball in metric ball) and fom-dist-prefix (metric ball in
;;;     prefix ball, by induction over the prefix).
;;;   * fom-baire-approx [(c)-(g)]: for every prefix ball V = {p_j < dl, j <= N} of E there
;;;     is a prefix ball of F whose points are approximable from tt(V).  F is the union of
;;;     the tt(V_j), V_j = {p_i < j, i <= N} [(e): fom-prefix-bound]; fom-baire-ball (from
;;;     `baire-category') gives a metric ball B(c, r) inside the closure of one tt(V_j0);
;;;     the difference trick [(f), (g)] puts w in the closure of tt(V_j0 - V_j0), inside
;;;     V_2j0; one small INVERTIBLE scalar sg (|sg| 2 j0 < dl) and its inverse ta rescale
;;;     [(c), (d)] -- fom-small-unit, from the powers c^n, b^n of IS-NONTRIVIALLY-VALUED's
;;;     witness (fom-unit-ladder).  Continuity of tt is not used here.
;;;   * fom-open-of-approx [(h), (i)]: removing the bar.  The radii are a(k) - a(k+1),
;;;     a(k) = 1/(n0 + k + 1), so the corrections telescope (fom-telescope) without a
;;;     geometric series; the approximation sequence is built by `dc-on-nn-pred' on VEC(m1)
;;;     with the invariant "y - tt(s_k) lies in a prefix ball approximable at stage k" in
;;;     the step relation; it is Cauchy, converges by completeness of E, tt(s_k) -> tt(lim)
;;;     by continuity and -> y by the invariant, and limits are unique in the metric space.
;;;   * open-mapping-theorem = fom-baire-approx + fom-open-of-approx.
;;;   * open-mapping-bounded-inverse: openness at each basic neighbourhood is continuity of
;;;     gg, read through fom-dist-prefix; it cites the two fom- theorems, not the target.
;;;
;;; LOAD WINDOW: [after theorem-library/frechet-metric (load.scm 3477), end).  The latest
;;; citations are the frm- theorems of theorem-library/frechet-metric; next down
;;; rake-bolzano-weierstrass (rr-archimedean-multiple), r-exp (rr-recip-recip-pos),
;;; one-sided-derivative-laws (rr-lt-min), diff-on-laws(-2), hahn-banach-sublinear
;;; (hbs-vadd-assoc, hbs-vadd-comm, hbs-interchange), rake-baire-2 (baire-category),
;;; metric-closure-laws, rake-dc-on-nn (dc-on-nn-pred), recip-succ-small.  Library:
;;; analysis (every cited file is analysis or core).  Nothing in the tree cites the
;;; fom- theorems; theorem-library/frechet-banach-steinhaus (TVS-2B) cites the targets.
;;;
;;; CASE FOLDING met here: R and r, A and a are one symbol (a binder `A' with a point `a'
;;; captured, and a Scheme `R' rebound the radius `r'); the names below avoid both.

;;; ---- fom- kit ----
(define (fom-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))
(define (fom-add m a b) (list (list 'VADD m) a b))
(define (fom-neg m a) (list (list 'VNEG m) a))
(define (fom-act m r v) (list (list 'ACT m) r v))
(define (fom-asm? f) (if (dk-asm? f) #t #f))
(define (fom-once! f thunk) (if (not (fom-asm? f)) (thunk)))
(define (fom-seq-map f l)
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (fom-pick-forall-with sub what)
  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f sub))) what))
(define (fom-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** fom: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (w) (display "      | ") (display (expression->string w)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name))

;;; =====================================================================
;;; (1) A FINITE PREFIX OF REALS IS BOUNDED BY A NATURAL NUMBER.
;;; =====================================================================
(sp (make-wff '(FORALL nb (IMPLIES (IN nb NN)
  (FORALL fam (FORALL x
    (IMPLIES (FORALL i (IMPLIES (IN i NN) (IN ((fam i) x) RR)))
      (FORSOME cap (AND (IN cap NN)
        (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= i nb) (< ((fam i) x) cap)))))))))))))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (nb (cdr (assq 'var ind))))
  ;; base
  (dk-focus! base)
  (let* ((g0 (dk-goal)) (fv (cadr g0)) (xv (cadr (caddr g0)))
         (landed (dk-peel!))
         (hyp (find-first (dk-head? 'FORALL) landed))
         (t0 (list (list fv 0) xv)))
    (dk-cite! 'nn-zero-in)
    (dk-apply! hyp 0)
    (let* ((c0 (dk-skolem! (dk-cite! 'nn-unbounded-in-rr t0))))
      (ew c0)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (ass)
              (let* ((ls (dk-peel!))
                     (iv (cadr (find-first (dk-head? 'IN) ls))))
                (dk-cite! 'nn-le-zero-is-zero iv)
                (subst (list '= iv 0))
                (ass)))))))
  ;; step
  (dk-focus! step)
  (let* ((g0 (dk-goal)) (fv (cadr g0)) (xv (cadr (caddr g0)))
         (landed (dk-peel!))
         (hyp (find-first (dk-head? 'FORALL) landed))
         (sn (list 'succ nb)))
    (dk-cite! 'nn-succ-closed nb)
    (let* ((c1 (dk-skolem! (dk-apply! ih fv xv)))
           (cu1 (fom-pick-forall-with c1 "the bound up to nb"))
           (t2 (list (list fv sn) xv))
           (_ (dk-apply! hyp sn))
           (c2 (dk-skolem! (dk-cite! 'nn-unbounded-in-rr t2)))
           (mx (list 'max c1 c2)))
      (dk-cite! 'nn-max-closed c1 c2)
      (dk-cite! 'nn-in-rr c1) (dk-cite! 'nn-in-rr c2)
      (dk-cite! 'rr-le-max-left c1 c2) (dk-cite! 'rr-le-max-right c1 c2)
      (dk-cite! 'rr-max-closed c1 c2)
      (ew mx)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (ass)
              (let* ((ls (dk-peel!))
                     (iv (cadr (find-first (dk-head? 'IN) ls)))
                     (ti (list (list fv iv) xv)))
                (dk-apply! hyp iv)
                (dk-cite! 'nn-le-succ-cases nb iv)
                (use-cases (list (list '<= iv nb) (list '= iv sn))
                  (lambda ()
                    (dk-apply! cu1 iv)
                    (dk-ineq! (list '< ti c1) (list '<= c1 mx) (list 'IN ti 'RR)))
                  (lambda ()
                    (subst (list '= iv sn))
                    (dk-ineq! (list '< t2 c2) (list '<= c2 mx)))))))))))
(fom-qed! 'fom-prefix-bound)


;;; =====================================================================
;;; (2) A METRIC BALL OF FR-METRIC-SPACE LIES IN A PREFIX BALL: for every k and
;;;     eps there is dl with d(x, y) < dl => p_i(x - y) < eps for all i <= k.
;;;     Induction on k over frm-ball-seminorm (one seminorm at a time).
;;; =====================================================================
(define (fom-dp-body k)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'dl (list 'AND '(POS-RR dl)
      (list 'FORALL 'x (list 'FORALL 'y (list 'IMPLIES '(IN x (VEC m)) (list 'IMPLIES '(IN y (VEC m))
        (list 'IMPLIES '(< ((DIST (FR-METRIC-SPACE m fam)) x y) dl)
          (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES (list '<= 'i k)
            '(< ((fam i) ((VADD m) x ((VNEG m) y))) eps))))))))))))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (list 'FORALL 'fld (list 'FORALL 'm (list 'FORALL 'fam
    (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m fam) (fom-dp-body 'k)))))))))
;;; (IN v (PTS (FR-METRIC-SPACE m fam))) from (IN v (VEC m)); IS-SEMINORM-FAMILY in context
(define (fom-pts! fld m fam v)
  (let* ((fms (list 'FR-METRIC-SPACE m fam))
         (ty (list 'IN v (list 'PTS fms))))
    (fom-once! ty
      (lambda ()
        (dk-cite! 'frm-metric-space-pts fld m fam)
        (dk-rewrite-h! (list 'IN v (list 'VEC m)) (list 'VEC m) (list 'PTS fms))))
    ty))
;;; (IN d(x,y) RR) in FR-METRIC-SPACE(m, fam)
(define (fom-dist-real! fld m fam x y)
  (let* ((fms (list 'FR-METRIC-SPACE m fam))
         (ty (list 'IN (list (list 'DIST fms) x y) 'RR)))
    (fom-once! ty
      (lambda ()
        (fom-pts! fld m fam x) (fom-pts! fld m fam y)
        (dk-cite! 'frm-metric-space-is-metric-space fld m fam)
        (dk-cite! 'metric-dist-real fms x y)))
    ty))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (kv (cdr (assq 'var ind))))
  ;; base: one seminorm
  (dk-focus! base)
  (let* ((ls (dk-peel!))
         (sf (find-first (dk-head? 'IS-SEMINORM-FAMILY) ls))
         (fld (cadr sf)) (m (caddr sf)) (fam (cadddr sf))
         (ev (cadr (find-first (dk-head? 'POS-RR) ls))))
    (dk-cite! 'nn-zero-in)
    (let* ((d0 (dk-skolem! (dk-cite! 'frm-ball-seminorm fld m fam 0 ev)))
           (u0 (fom-pick-forall-with d0 "the ball universal at 0")))
      (ew d0)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'POS-RR)
              (ass)
              (let* ((ls2 (dk-peel!))
                     (g (dk-goal))
                     (iv (cadr (car (cadr g))))
                     (xy (cadr (cadr g))) (xv (cadr xy)) (yv (cadr (caddr xy))))
                (dk-cite! 'nn-le-zero-is-zero iv)
                (subst (list '= iv 0))
                (dk-apply! u0 xv yv)
                (ass)))))))
  ;; step: min of the IH's radius and frm-ball-seminorm's at succ k
  (dk-focus! step)
  (let* ((ls (dk-peel!))
         (sf (find-first (dk-head? 'IS-SEMINORM-FAMILY) ls))
         (fld (cadr sf)) (m (caddr sf)) (fam (cadddr sf))
         (ev (cadr (find-first (dk-head? 'POS-RR) ls)))
         (sk (list 'succ kv)))
    (dk-cite! 'nn-succ-closed kv)
    (let* ((d1 (dk-skolem! (dk-apply! ih fld m fam ev)))
           (u1 (fom-pick-forall-with d1 "the IH universal"))
           (d2 (dk-skolem! (dk-cite! 'frm-ball-seminorm fld m fam sk ev)))
           (u2 (fom-pick-forall-with d2 "the ball universal at succ k")))
      (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1)
      (dk-cite! 'rr-pos-rr-in-rr d2) (dk-cite! 'rr-lt-of-pos-rr d2)
      (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2))))
        (dk-cite! 'rr-pos-rr-of-lt w)
        (ew w)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'POS-RR)
                (ass)
                (let* ((ls2 (dk-peel!))
                       (g (dk-goal))
                       (iv (cadr (car (cadr g))))
                       (xy (cadr (cadr g))) (xv (cadr xy)) (yv (cadr (caddr xy)))
                       (dxy (list (list 'DIST (list 'FR-METRIC-SPACE m fam)) xv yv))
                       (lt (find-first (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) dxy))) ls2)))
                  (fom-dist-real! fld m fam xv yv)
                  (dk-have! (list '< dxy d1) (lambda () (dk-ineq! lt (list '<= w d1))))
                  (dk-have! (list '< dxy d2) (lambda () (dk-ineq! lt (list '<= w d2))))
                  (dk-cite! 'nn-le-succ-cases kv iv)
                  (use-cases (list (list '<= iv kv) (list '= iv sk))
                    (lambda () (dk-apply! u1 xv yv iv) (ass))
                    (lambda () (subst (list '= iv sk)) (dk-apply! u2 xv yv) (ass)))))))))))
(fom-qed! 'fom-dist-prefix)


;;; =====================================================================
;;; (3) POWERS OF c AND OF ITS INVERSE b: at stage n, sc = c^n, sb = b^n with
;;;     sc sb = 1 and the Bernoulli bound |sc| >= 1 + n(|c| - 1).  (frm-nf-ladder
;;;     carries |sc| |sb| = 1 but not sc sb = 1, which a rescaling of VECTORS needs.)
;;; =====================================================================
(define (fom-nfn fld t) (list (list 'FNRM fld) t))
(define (fom-nfv fld) (list 'NORMED-FIELD-AS-COMMUTATIVE-RING fld))
;;; R4-G 2026-10-13: (== (ACC v) (ACC fld)) for v = NORMED-FIELD-AS-COMMUTATIVE-RING(fld)
;;; WITHOUT IS-NORMED-FIELD(fld), from a strict hypothesis SC = (= X v) in context.
;;; The generic read-off normed-field-ring-view-ACC is guarded by IS-NORMED-FIELD
;;; since R4; here the strict SC certifies that the view denotes, which is all the
;;; read-off needs.  On a lane: the unfold v == [carr(fld), ..., one(fld)] (mac, qrfl),
;;; rewritten into SC so the context holds the LIST outside binders in a true `=';
;;; then the generic five steps, `nth-r' owing nothing.
(define (fom-view-acc! sc fld acc)
  (let* ((v (fom-nfv fld))
         (lst (cons 'LIST (map (lambda (a) (list a fld)) '(CARR ADD MUL NEG ZERO ONE))))
         (eqn (list '== (list acc v) (list acc fld))))
    (if (not (dk-asm? eqn))
        (dk-have! eqn
          (lambda ()
            (dk-have! (list '== v lst)
              (lambda () (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING) (qrfl)))
            (dk-rewrite-h! sc v lst)
            (slot acc)
            (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
            (nth-r)
            (slot acc)
            (qrfl))))
    eqn))
;;; with IS-NORMED-FIELD fld in context and the terms typed in CARR fld: prove the
;;; field identity (= L R) (MUL / ONE of fld) by crs in the ring view
(define (fom-field-crs! fld lhs rhs terms)
  (let ((v (fom-nfv fld)))
    (dk-have! (list '= lhs rhs)
      (lambda ()
        (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring fld)
        (dk-cite! 'commutative-ring-is-ring v)
        (dk-cite! 'normed-field-ring-view-carr fld)
        (dk-cite! 'normed-field-ring-view-mul fld)
        (dk-cite! 'normed-field-ring-view-one fld)
        (dk-cite! 'nf-one-in-carr fld)
        (for-each (lambda (u)
                    (dk-have! (list 'IN u (list 'CARR v))
                      (lambda () (subst (list '== (list 'CARR v) (list 'CARR fld))) (ass))))
                  terms)
        (subst (list '== (list 'MUL fld) (list 'MUL v)))
        (if (dk-contains? (dk-goal) (list 'ONE fld)) (subst (list '== (list 'ONE fld) (list 'ONE v))))
        (crs)))
    (list '= lhs rhs)))

(define (fom-ladder-at n)
  (list 'FORSOME 'fsc_ (list 'AND '(IN fsc_ (CARR fld))
    (list 'FORSOME 'fsb_ (list 'AND '(IN fsb_ (CARR fld))
      (list 'AND '(= ((MUL fld) fsc_ fsb_) (ONE fld))
        (list 'AND '(<= 1 ((FNRM fld) fsc_))
          (list '<= (list '+ 1 (list '- (list '* n '((FNRM fld) c)) n)) '((FNRM fld) fsc_)))))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'fld (list 'IMPLIES '(IS-NORMED-FIELD fld)
    (forall-guarded 'c '(IN c (CARR fld)) (forall-guarded 'b '(IN b (CARR fld))
      (list 'IMPLIES '(< 1 ((FNRM fld) c)) (list 'IMPLIES '(= ((MUL fld) c b) (ONE fld))
        (fom-ladder-at 'n)))))))))))
(define (fom-field-peel!)
  (let* ((ls (dk-peel!))
         (lt (find-first (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) 1))) ls))
         (eq (find-first (lambda (f) (and (dk-head-is? f '=) (pair? (cadr f)) (pair? (car (cadr f)))
                                          (eq? (car (car (cadr f))) 'MUL))) ls)))
    (if (not (and lt eq)) (error "fom-field-peel!: hypotheses not found"))
    (list (cadr (car (cadr eq))) (cadr (caddr lt)) (caddr (cadr eq)))))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (nv (cdr (assq 'var ind))))
  ;; base: sc = sb = 1
  (dk-focus! base)
  (let* ((fcb (fom-field-peel!))
         (fld (car fcb)) (c (cadr fcb)) (b (caddr fcb))
         (one (list 'ONE fld)) (o (fom-nfn fld one)) (g (fom-nfn fld c)))
    (dk-cite! 'nf-one-in-carr fld)
    (dk-cite! 'nf-norm-in-rr fld c)
    (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
    (dk-cite! 'frm-nf-norm-one fld c)
    (fom-field-crs! fld (list (list 'MUL fld) one one) one (list one))
    (ew one)
    (dk-conj-close!
      (lambda ()
        (let ((gl (dk-goal)))
          (cond ((dk-head-is? gl 'IN) (ass))
                ((dk-head-is? gl 'FORSOME)
                 (ew one)
                 (dk-conj-close!
                   (lambda ()
                     (let ((gl2 (dk-goal)))
                       (cond ((dk-head-is? gl2 'IN) (ass))
                             ((dk-head-is? gl2 '=) (ass))
                             (#t (subst (list '= o 1)) (dk-ineq!)))))))
                (#t (error "fom-unit-ladder base: unexpected" gl)))))))
  ;; step: sc' = c sc, sb' = b sb
  (dk-focus! step)
  (let* ((fcb (fom-field-peel!))
         (fld (car fcb)) (c (cadr fcb)) (b (caddr fcb))
         (g (fom-nfn fld c))
         (sc (dk-skolem! (dk-apply! ih fld c b)))
         (sb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sc)))
                                  "the sb existential")))
         (s (fom-nfn fld sc))
         (sc2 (list (list 'MUL fld) c sc)) (sb2 (list (list 'MUL fld) b sb))
         (s2 (fom-nfn fld sc2))
         (gm1 (list '- g 1)))
    (dk-cite! 'nf-mul-in-carr fld c sc)
    (dk-cite! 'nf-mul-in-carr fld b sb)
    (for-each (lambda (u) (dk-cite! 'nf-norm-in-rr fld u) (dk-cite! 'nf-norm-nonneg fld u)) (list c sc))
    (let* ((ms (dk-cite! 'nf-norm-mult fld c sc))          ; |c sc| = g s
           (_ (begin (dk-real! gm1)
                     (dk-have! (list '<= 0 gm1) (lambda () (dk-ineq! (list '< 1 g))))
                     (dk-have! (list 'AND (list '<= 0 gm1) (list '<= 1 s)) (lambda () (dk-conj-close! ass)))))
           (k1 (dk-cite! 'rr-le-scale-nonneg gm1 1 s))        ; (g-1) 1 <= (g-1) s
           (_ (begin (dk-have! (list '= (list '* gm1 s) (list '- (list '* g s) s)) (lambda () (crs)))
                     (dk-have! (list '= (list '* gm1 1) gm1) (lambda () (crs)))))
           (k2 (dk-rewrite-h! (dk-rewrite-h! k1 (list '* gm1 s) (list '- (list '* g s) s))
                              (list '* gm1 1) gm1)))          ; g - 1 <= g s - s
      (fom-field-crs! fld (list (list 'MUL fld) sc2 sb2)
                          (list (list 'MUL fld) (list (list 'MUL fld) c b) (list (list 'MUL fld) sc sb))
                          (list c b sc sb))
      (ew sc2)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond
              ((dk-head-is? gl 'IN) (ass))
              ((dk-head-is? gl 'FORSOME)
               (ew sb2)
               (dk-conj-close!
                 (lambda ()
                   (let ((gl2 (dk-goal)))
                     (cond
                       ((dk-head-is? gl2 'IN) (ass))
                       ((dk-head-is? gl2 '=)
                        (subst (list '= (list (list 'MUL fld) sc2 sb2)
                                        (list (list 'MUL fld) (list (list 'MUL fld) c b) (list (list 'MUL fld) sc sb))))
                        (subst (list '= (list (list 'MUL fld) c b) (list 'ONE fld)))
                        (subst (list '= (list (list 'MUL fld) sc sb) (list 'ONE fld)))
                        (fom-field-crs! fld (list (list 'MUL fld) (list 'ONE fld) (list 'ONE fld)) (list 'ONE fld)
                                        (list (list 'ONE fld)))
                        (ass))
                       ((and (dk-head-is? gl2 '<=) (equal? (cadr gl2) 1))
                        (subst ms)
                        (dk-real! (list '* g s))
                        (dk-ineq! k2 (list '<= 1 s) (list '< 1 g)))
                       (#t
                        (let* ((pn (list '+ nv 1)))
                          (dk-cite! 'nn-succ-plus-one nv)
                          (dk-cite! 'nn-in-rr nv)
                          (subst (list '= (list 'succ nv) pn))
                          (dk-have! (list '= (list '* pn g) (list '+ (list '* nv g) g)) (lambda () (crs)))
                          (subst (list '= (list '* pn g) (list '+ (list '* nv g) g)))
                          (subst ms)
                          (dk-real! (list '* nv g))
                          (dk-real! (list '* g s))
                          (dk-ineq! k2 (list '<= (list '+ 1 (list '- (list '* nv g) nv)) s)))))))))
              (#t (error "fom-unit-ladder step: unexpected" gl)))))))))
(fom-qed! 'fom-unit-ladder)


;;; =====================================================================
;;; (4) A SMALL INVERTIBLE SCALAR: over a non-trivially valued field, for R >= 0 and
;;;     dl > 0 there are sg, ta with sg ta = 1, |sg| |ta| = 1, both norms positive and
;;;     |sg| R < dl.  (sg = b^n, ta = c^n for n with R <= n (|c| - 1) dl.)
;;; =====================================================================
(sp (make-wff '(FORALL fld (IMPLIES (IS-NONTRIVIALLY-VALUED fld)
  (FORALL R (IMPLIES (IN R RR) (IMPLIES (<= 0 R)
    (FORALL dl (IMPLIES (POS-RR dl)
      (FORSOME sg (AND (IN sg (CARR fld))
        (FORSOME ta (AND (IN ta (CARR fld))
          (AND (= ((MUL fld) sg ta) (ONE fld))
            (AND (= (* ((FNRM fld) sg) ((FNRM fld) ta)) 1)
              (AND (< 0 ((FNRM fld) sg))
                (AND (< 0 ((FNRM fld) ta))
                  (< (* ((FNRM fld) sg) R) dl))))))))))))))))))
(let* ((ls (dk-peel!))
       (nt (find-first (dk-head? 'IS-NONTRIVIALLY-VALUED) ls))
       (fld (cadr nt))
       (rv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'RR))) ls)))
       (dl (cadr (find-first (dk-head? 'POS-RR) ls)))
       (parts (dk-landed (lambda () (mac-h 'is-nontrivially-valued nt))))
       (_ (dk-split-all!))
       (c (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME))) "the c existential")))
       (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME))) "the b existential")))
       (g (fom-nfn fld c))
       (gm1 (list '- g 1))
       (ev (list '* gm1 dl)))
  (dk-cite! 'nf-norm-in-rr fld c)
  (dk-cite! 'rr-pos-rr-in-rr dl) (dk-cite! 'rr-lt-of-pos-rr dl)
  (dk-real! gm1)
  (dk-have! (list '< 0 gm1) (lambda () (dk-ineq! (list '< 1 g))))
  (dk-cite! 'rr-mul-pos gm1 dl)
  (dk-real! ev)
  (dk-cite! 'rr-pos-rr-of-lt ev)
  (let* ((nn0 (dk-skolem! (dk-cite! 'rr-archimedean-multiple ev rv)))
         (sc (dk-skolem! (dk-cite! 'fom-unit-ladder nn0 fld c b)))
         (sb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sc)))
                                  "the sb existential")))
         (s (fom-nfn fld sc)) (tb (fom-nfn fld sb))
         (bern (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f nn0) (equal? (caddr f) s)))
                        "the Bernoulli bound"))
         (a (cadr bern)))
    (dk-cite! 'nn-in-rr nn0)
    (for-each (lambda (u) (dk-cite! 'nf-norm-in-rr fld u) (dk-cite! 'nf-norm-nonneg fld u)) (list sc sb))
    ;; sb sc = 1 and |sb| |sc| = 1
    (fom-field-crs! fld (list (list 'MUL fld) sb sc) (list (list 'MUL fld) sc sb) (list sc sb))
    (let* ((e1 (dk-rewrite-h! (list '= (list (list 'MUL fld) sb sc) (list (list 'MUL fld) sc sb))
                              (list (list 'MUL fld) sc sb) (list 'ONE fld)))
           (mn (dk-cite! 'nf-norm-mult fld sb sc))
           (_ (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g)))))
           (_ (dk-cite! 'frm-nf-norm-one fld c))
           (mn1 (dk-rewrite-h! mn (list (list 'MUL fld) sb sc) (list 'ONE fld)))
           (mn2 (dk-rewrite-h! mn1 (fom-nfn fld (list 'ONE fld)) 1)))   ; 1 = tb s
      (dk-real! (list '* tb s))
      (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '<= 1 s))))
      (dk-have! (list '< 0 tb)
        (lambda ()
          (use-em (list '= 0 tb)
            (lambda ()
              (let* ((z (dk-rewrite-h! mn2 tb 0))
                     (_ (dk-cite! 'rr-zero-mul s))
                     (z2 (dk-rewrite-h! z (list '* 0 s) 0)))
                (dk-ineq! z2)))
            (lambda () (mac '<) (dk-conj-close! ass)))))
      ;; |sb| R < dl
      (let* ((sdl (list '* s dl)) (d (list '- sdl rv)))
        (dk-real! a) (dk-real! sdl) (dk-real! d) (dk-real! (list '* nn0 ev))
        (dk-have! (list '<= 0 dl) (lambda () (dk-ineq! (list '< 0 dl))))
        (dk-cite! 'rr-mul-le-right a s dl)
        (dk-real! (list '* a dl))
        (dk-have! (list '= (list '* a dl) (list '+ dl (list '* nn0 ev))) (lambda () (crs)))
        (dk-have! (list '< 0 d)
          (lambda () (dk-ineq! (list '<= (list '* a dl) sdl) (list '= (list '* a dl) (list '+ dl (list '* nn0 ev)))
                               (list '<= rv (list '* nn0 ev)) (list '< 0 dl))))
        (dk-cite! 'rr-mul-pos tb d)
        (dk-have! (list '= (list '* tb d) (list '- (list '* (list '* tb s) dl) (list '* tb rv))) (lambda () (crs)))
        (let ((e2 (dk-rewrite-h! (list '= (list '* tb d) (list '- (list '* (list '* tb s) dl) (list '* tb rv)))
                                 (list '* tb s) 1)))
          (dk-real! (list '* tb d)) (dk-real! (list '* tb rv))
          (dk-have! (list '< (list '* tb rv) dl)
            (lambda () (dk-ineq! e2 (list '< 0 (list '* tb d))))))
        (ew sb)
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-head-is? gl 'FORSOME)
                     (ew sc)
                     (dk-conj-close!
                       (lambda ()
                         (let ((gl2 (dk-goal)))
                           (cond ((and (dk-head-is? gl2 '=) (equal? (caddr gl2) 1))
                                  (dk-ineq! mn2))
                                 (#t (ass)))))))
                    (#t (ass))))))))))
(fom-qed! 'fom-small-unit)


;;; =====================================================================
;;; (5) A POINT OF THE CLOSURE HAS POINTS OF A WITHIN EVERY rho.
;;; =====================================================================
;;; (POS-RR e) in context -> (AND (IN e RR) (AND (<= 0 e) (NOT (= 0 e)))), the guard of
;;; ball-is-open / ball-center-in
(define (fom-pos-conj! e)
  (dk-pos-parts! e)
  (let ((cj (list 'AND (list 'IN e 'RR) (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))))))
    (dk-have! cj (lambda () (dk-conj-close! ass)))
    cj))
;;; (< a b) in context -> land (<= a b) and (NOT (= a b))
(define (fom-lt-parts! a b)
  (let ((cj (list 'AND (list '<= a b) (list 'NOT (list '= a b)))))
    (dk-have! cj (lambda () (mac-h '< (list '< a b)) (ass)))
    (if (not (and (fom-asm? (list '<= a b)) (fom-asm? (list 'NOT (list '= a b)))))
        (dk-split! cj))
    cj))
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL aa (FORALL z (IMPLIES (IN z (CLOSURE s aa))
    (FORALL rho (IMPLIES (POS-RR rho)
      (FORSOME pt (AND (IN pt aa) (< ((DIST s) z pt) rho))))))))))))
(let* ((ls (dk-peel!))
       (s (cadr (find-first (dk-head? 'IS-METRIC-SPACE) ls)))
       (cm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'CLOSURE))) ls))
       (z (cadr cm))
       (rho (cadr (find-first (dk-head? 'POS-RR) ls)))
       (bl (list 'BALL s z rho)))
  (fom-pos-conj! rho)
  (let* ((parts (dk-landed (lambda () (mac-h 'closure-membership cm))))
         (_ (dk-split-all! parts))
         (u (fom-pick-forall-with 'IS-OPEN "the closure universal")))
    (dk-cite! 'ball-is-open s z rho)
    (dk-cite! 'ball-center-in s z rho)
    (dk-have! (list 'AND (list 'IS-OPEN s bl) (list 'IN z bl)) (lambda () (dk-conj-close! ass)))
    (let* ((ex (dk-apply! u bl))
           (y (dk-skolem! ex))
           (dz (list (list 'DIST s) z y)))
      (mac-h 'ball-membership (list 'IN y bl))
      (dk-split-all!)
      (ew y)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (ass)
              (begin (mac '<) (dk-conj-close! ass))))))))
(fom-qed! 'fom-closure-near)

;;; =====================================================================
;;; (6) BAIRE, IN THE FORM THE OPEN MAPPING THEOREM USES: if a nonempty complete
;;;     metric space is covered by countably many sets ee(j), the closure of one of
;;;     them contains a ball.  (From `baire-category': otherwise every ee(j) is
;;;     nowhere dense and PTS(s) is meager.)
;;; =====================================================================
(define fom-bb-goal
  '(FORSOME j (AND (IN j NN) (FORSOME c (AND (IN c (PTS s)) (FORSOME r (AND (POS-RR r)
     (FORALL z (IMPLIES (IN z (PTS s)) (IMPLIES (< ((DIST s) c z) r)
       (IN z (CLOSURE s (ee j)))))))))))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMPLETE s)
  (list 'FORALL 'x0 (list 'IMPLIES '(IN x0 (PTS s))
    (list 'FORALL 'ee (list 'IMPLIES '(IN ee (FUN NN (POWER (PTS s))))
      (list 'IMPLIES '(FORALL y (IMPLIES (IN y (PTS s)) (FORSOME j (AND (IN j NN) (IN y (ee j))))))
        fom-bb-goal)))))))))
(let* ((g0 (dk-goal))
       (ls (dk-peel!))
       (cpl (find-first (dk-head? 'IS-COMPLETE) ls))
       (s (cadr cpl))
       (x0 (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS s)))) ls)))
       (eet (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'FUN))) ls))
       (ee (cadr eet))
       (cov (find-first (dk-head? 'FORALL) ls))
       (goal (dk-goal))
       (pts (list 'PTS s)))
  (dk-have! (list 'IS-METRIC-SPACE s)
    (lambda () (mac-h 'is-complete cpl) (dk-split-all!) (ass)))
  (dk-have! (list 'FORSOME 'x (list 'IN 'x pts)) (lambda () (ew x0) (ass)))
  (dk-cite! 'baire-category s)
  (mac-h 'is-nonmeager (list 'IS-NONMEAGER s pts))
  (dk-split-all!)
  (let ((nm (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'IS-MEAGER))) "not meager")))
    (pbc)
    (let ((ng (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'FORSOME))) "the negated goal")))
      (dk-cite! 'ms-pts-is-set s)
      (dk-have! (list 'IS-MEAGER s pts)
        (lambda ()
          (mac 'is-meager)
          (dk-conj-close!
            (lambda ()
              (let ((gl (dk-goal)))
                (cond
                  ((dk-head-is? gl 'IS-METRIC-SPACE) (ass))
                  ((and (dk-head-is? gl 'SUBSET) (equal? (cadr gl) pts) (equal? (caddr gl) pts))
                   (dk-cite! 'subset-refl pts) (ass))
                  ((dk-head-is? gl 'FORSOME)
                   (ew ee)
                   (dk-conj-close!
                     (lambda ()
                       (let ((gl2 (dk-goal)))
                         (cond
                           ((dk-head-is? gl2 'IN) (ass))
                           ((dk-head-is? gl2 'SUBSET)          ; the cover
                            (let* ((y (subset-by-element!))
                                   (j (dk-skolem! (dk-apply! cov y))))
                              (dk-each-leaf! (lambda () (bu-mi j)) (lambda () (ass)))))
                           (#t                                 ; every ee(n) nowhere dense
                            (let* ((n (cadr (car (dk-peel!))))
                                   (en (list ee n))
                                   (cl (list 'CLOSURE s en))
                                   (it (list 'INTERIOR s cl)))
                              (dk-cite! 'fun-apply-type-c ee 'NN (list 'POWER pts) n)
                              (mac 'is-nowhere-dense)
                              (dk-conj-close!
                                (lambda ()
                                  (let ((gl3 (dk-goal)))
                                    (cond
                                      ((dk-head-is? gl3 'IS-METRIC-SPACE) (ass))
                                      ((dk-head-is? gl3 'SUBSET)
                                       (let ((zz (subset-by-element!)))
                                         (dk-cite! 'power-mem-in pts en zz)
                                         (ass)))
                                      (#t
                                       (dk-cite! 'interior-in-carrier s cl)
                                       (dk-cite! 'subclass-of-set-is-set it pts)
                                       (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ it) '(IN z_ EMPTY-SET)))
                                        (lambda ()
                                       (let* ((w (cadr (car (dk-peel!)))))
                                         (pbc)
                                         (mac-h 'interior-membership (list 'IN w it))
                                         (dk-split-all!)
                                         (let* ((u (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the open set")))
                                                (op (list 'IS-OPEN s u)))
                                           (mac-h 'is-open op)
                                           (dk-split-all!)
                                           (let* ((r (dk-skolem! (dk-apply! (fom-pick-forall-with 'BALL "the open universal") w)))
                                                  (gf (cadr ng)))
                                             (dk-have! gf
                                               (lambda ()
                                                 (ew n)
                                                 (dk-conj-close!
                                                   (lambda ()
                                                     (if (dk-head-is? (dk-goal) 'IN)
                                                         (ass)
                                                         (begin
                                                           (ew w)
                                                           (dk-conj-close!
                                                             (lambda ()
                                                               (if (dk-head-is? (dk-goal) 'IN)
                                                                   (ass)
                                                                   (begin
                                                                     (ew r)
                                                                     (dk-conj-close!
                                                                       (lambda ()
                                                                         (if (dk-head-is? (dk-goal) 'POS-RR)
                                                                             (ass)
                                                                             (let* ((ls4 (dk-peel!))
                                                                                    (zz (cadr (find-first (dk-head? 'IN) ls4)))
                                                                                    (dwz (list (list 'DIST s) w zz))
                                                                                    (bl (list 'BALL s w r)))
                                                                               (fom-lt-parts! dwz r)
                                                                               (dk-have! (list 'IN zz bl)
                                                                                 (lambda () (mac 'ball-membership) (dk-conj-close! ass)))
                                                                               (dk-cite! 'subset-mem-fwd bl u zz)
                                                                               (dk-cite! 'subset-mem-fwd u cl zz)
                                                                               (ass)))))))))))))))
                                             (ai ng))))))
                                       (dk-cite! 'subset-of-empty-is-empty it)
                                       (ass)))))))))))))
                  (#t (error "fom-baire-ball: unexpected meager conjunct" gl))))))))
      (ai nm))))
(fom-qed! 'fom-baire-ball)


;;; =====================================================================
;;; (7) MODULE ALGEBRA: projections of IS-LINEAR-MAP, three vector identities,
;;;     p(u - v) <= p(u) + p(v), and sg.(ta.z) = z when sg ta = 1.
;;; =====================================================================
;;; (IN v (VEC m)) for a vector term built from typed atoms by VADD / VNEG / VZERO / ACT
(define (fom-vec! m v)
  (let ((ty (list 'IN v (list 'VEC m))))
    (if (not (fom-asm? ty))
        (cond ((and (pair? v) (equal? (car v) (list 'VADD m)))
               (fom-vec! m (cadr v)) (fom-vec! m (caddr v))
               (dk-cite! 'module-vadd-type m (cadr v) (caddr v)))
              ((and (pair? v) (equal? (car v) (list 'VNEG m)))
               (fom-vec! m (cadr v))
               (dk-cite! 'module-vneg-type m (cadr v)))
              ((and (pair? v) (equal? (car v) (list 'ACT m)))
               (fom-vec! m (caddr v))
               (dk-cite! 'module-act-type m (cadr v) (caddr v)))
              ((equal? v (list 'VZERO m)) (dk-cite! 'module-vzero-in m))
              (#t (error "fom-vec!: cannot type" (expression->string v)))))
    (if (not (fom-asm? ty)) (error "fom-vec!: typing did not land" (expression->string v)))
    ty))
(define (fom-vstmt vars body)
  (list 'FORALL 'm
    (list 'IMPLIES '(IS-MODULE m)
      (let loop ((vs vars))
        (if (null? vs) body
            (list 'FORALL (car vs)
                  (list 'IMPLIES (list 'IN (car vs) '(VEC m)) (loop (cdr vs)))))))))
(define (fom-cite-vec! thm m . vecs)
  (for-each (lambda (v) (fom-vec! m v)) vecs)
  (apply dk-cite! thm m vecs))

;;; (w + c) - c = w
(sp (make-wff (fom-vstmt '(w c) (list '= (fom-sub 'm (fom-add 'm 'w 'c) 'c) 'w))))
(dk-peel!)
(let* ((nc (fom-neg 'm 'c)))
  (subst (fom-cite-vec! 'hbs-vadd-assoc 'm 'w 'c nc))
  (subst (fom-cite-vec! 'frm-v-right-inv 'm 'c))
  (subst (fom-cite-vec! 'abelian-group-right-id-module-vector-ag 'm 'w))
  (fom-vec! 'm 'w)
  (rfl))
(fom-qed! 'fom-v-shift-back)

;;; (p - q) - (a1 - a2) = (p - a1) - (q - a2)
(sp (make-wff (fom-vstmt '(p q a1 a2)
  (list '= (fom-sub 'm (fom-sub 'm 'p 'q) (fom-sub 'm 'a1 'a2))
           (fom-sub 'm (fom-sub 'm 'p 'a1) (fom-sub 'm 'q 'a2))))))
(dk-peel!)
(let* ((nq (fom-neg 'm 'q)) (na1 (fom-neg 'm 'a1)) (na2 (fom-neg 'm 'a2)))
  (subst (fom-cite-vec! 'frm-v-neg-add 'm 'a1 na2))
  (subst (fom-cite-vec! 'frm-v-neg-add 'm 'q na2))
  (subst (fom-cite-vec! 'frm-v-neg-neg 'm 'a2))
  (subst (fom-cite-vec! 'hbs-interchange 'm 'p nq na1 'a2))
  (fom-vec! 'm (fom-add 'm (fom-add 'm 'p na1) (fom-add 'm nq 'a2)))
  (rfl))
(fom-qed! 'fom-v-quad)

;;; y - (a + b) = (y - b) - a
(sp (make-wff (fom-vstmt '(y a b)
  (list '= (fom-sub 'm 'y (fom-add 'm 'a 'b)) (fom-sub 'm (fom-sub 'm 'y 'b) 'a)))))
(dk-peel!)
(let* ((na (fom-neg 'm 'a)) (nb (fom-neg 'm 'b)))
  (subst (fom-cite-vec! 'frm-v-neg-add 'm 'a 'b))
  (subst (fom-cite-vec! 'hbs-vadd-assoc 'm 'y nb na))
  (subst (fom-cite-vec! 'hbs-vadd-comm 'm nb na))
  (fom-vec! 'm (fom-add 'm 'y (fom-add 'm na nb)))
  (rfl))
(fom-qed! 'fom-v-sub-sum)

;;; projections of IS-LINEAR-MAP
(define (fom-project! name pred mac-name stmt)
  (sp (make-wff stmt))
  (let loop ((n 0))
    (if (not (dk-asm? pred))
        (begin (if (> n 4) (error "fom-project!: guard did not land" name)) (di) (loop (+ n 1)))))
  (mac-h mac-name pred)
  (dk-split-all!)
  (ass)
  (fom-qed! name))
(define (fom-linstmt body)
  (list 'FORALL 'm1 (list 'FORALL 'm2 (list 'FORALL 'tt
    (list 'IMPLIES '(IS-LINEAR-MAP m1 m2 tt) body)))))
(fom-project! 'fom-lin-m1 '(IS-LINEAR-MAP m1 m2 tt) 'is-linear-map (fom-linstmt '(IS-MODULE m1)))
(fom-project! 'fom-lin-m2 '(IS-LINEAR-MAP m1 m2 tt) 'is-linear-map (fom-linstmt '(IS-MODULE m2)))
(fom-project! 'fom-lin-scal '(IS-LINEAR-MAP m1 m2 tt) 'is-linear-map (fom-linstmt '(= (SCAL m1) (SCAL m2))))
(fom-project! 'fom-lin-type '(IS-LINEAR-MAP m1 m2 tt) 'is-linear-map
  (fom-linstmt '(IN tt (FUN (VEC m1) (VEC m2)))))
(fom-project! 'fom-lin-add '(IS-LINEAR-MAP m1 m2 tt) 'is-linear-map
  (fom-linstmt (forall-guarded 'x '(IN x (VEC m1))
                 (forall-guarded 'y '(IN y (VEC m1))
                   '(= (tt ((VADD m1) x y)) ((VADD m2) (tt x) (tt y)))))))

;;; p(u - v) <= p(u) + p(v)
(sp (make-wff '(FORALL fld (FORALL m (FORALL p (IMPLIES (IS-SEMINORM fld m p)
  (FORALL u (IMPLIES (IN u (VEC m)) (FORALL v (IMPLIES (IN v (VEC m))
    (<= (p ((VADD m) u ((VNEG m) v))) (+ (p u) (p v)))))))))))))
(let* ((ls (dk-peel!))
       (sn (find-first (dk-head? 'IS-SEMINORM) ls))
       (fld (cadr sn)) (m (caddr sn)) (p (cadddr sn))
       (us (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC m)))) ls))
       (u (cadr (car us))) (v (cadr (cadr us)))
       (nv (fom-neg m v)))
  (dk-cite! 'frm-sn-module fld m p)
  (fom-vec! m nv)
  (dk-cite! 'frm-sn-subadd fld m p u nv)
  (fom-vec! m (fom-add m u nv))
  (let ((e (dk-cite! 'frm-sn-neg fld m p v)))
    (dk-cite! 'frm-sn-type fld m p)
    (for-each (lambda (t) (dk-cite! 'fun-apply-type-c p (list 'VEC m) 'RR t)) (list u v nv (fom-add m u nv)))
    (dk-ineq! (list '<= (list p (fom-add m u nv)) (list '+ (list p u) (list p nv))) e)))
(fom-qed! 'fom-sn-sub-le)

;;; sg.(ta.z) = z when sg ta = 1 in the module's field (a normed field)
(sp (make-wff '(FORALL fld (FORALL m (IMPLIES (IS-NORMED-FIELD fld) (IMPLIES (IS-MODULE m) (IMPLIES (= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING fld))
  (FORALL sg (IMPLIES (IN sg (CARR fld)) (FORALL ta (IMPLIES (IN ta (CARR fld))
    (IMPLIES (= ((MUL fld) sg ta) (ONE fld))
      (FORALL z (IMPLIES (IN z (VEC m)) (= ((ACT m) sg ((ACT m) ta z)) z)))))))))))))))
(let* ((ls (dk-peel!))
       (md (cadr (find-first (dk-head? 'IS-MODULE) ls)))
