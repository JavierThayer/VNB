(define (fom-p2-tot! y n n0 nxt hapx)
  (let* ((ls (dk-peel!))
         (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
         (u (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ls)))
         (inv (fom-inv y n n0 k u)))
    (use-em inv
      (lambda ()
        (let* ((nb (dk-skolem! inv))
               (eta (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb))) "eta")))
               (ap (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f eta) (dk-contains? f 'fam1))) "AP"))
               (z (fom-sub 'm2 y (list 'tt u)))
               (_ (begin (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) u) (fom-vec! 'm2 z)))
               (apx (dk-apply! ap z))
               (sk (list 'succ k))
               (_ (dk-cite! 'nn-succ-closed k))
               (nsk (fom-nn-sum! n sk))
               (dsk (fom-afacts! n0 sk))
               (nb1 (dk-skolem! (dk-apply! hapx nsk dsk)))
               (eta1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb1))) "eta1")))
               (ap1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb1) (dk-contains? f eta1) (dk-contains? f 'fam1))) "AP1"))
               (nb2 (fom-max! nb1 sk))
               (ask (fom-a n0 sk))
               (_ (begin (dk-cite! 'rr-pos-rr-in-rr eta1) (dk-cite! 'rr-lt-of-pos-rr eta1)))
               (eta2 (fom-min! eta1 ask))
               (xx (dk-skolem! (dk-apply! apx nb2 eta2)))
               (px (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f xx) (dk-contains? f 'fam1))) "px"))
               (pq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f xx) (dk-contains? f 'fam2))) "pq"))
               (v (fom-add 'm1 xx u)))
          (fom-vec! 'm1 v)
          (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) xx)
          (ew v)
          (dk-conj-close!
            (lambda ()
              (if (equal? (dk-goal) (list 'IN v '(VEC m1)))
                  (ass)
                  (begin
                    (dk-lam-b!)
                    (in-sep! (lambda () (ass))
                      (lambda ()
                        (di)
                        (dk-conj-close!
                          (lambda ()
                            (let ((g (dk-goal)))
                              (cond
                                ((and (dk-head-is? g 'FORALL) (dk-contains? g 'fam1))      ; the step
                                 (let ((j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) (dk-peel!)))))
                                   (subst (dk-cite! 'fom-v-shift-back 'm1 xx u))
                                   (dk-apply! px j)
                                   (ass)))
                                ((dk-head-is? g 'FORSOME)
                                 (ew nb2)
                                 (dk-conj-close!
                                   (lambda ()
                                     (let ((g2 (dk-goal)))
                                       (cond
                                         ((dk-head-is? g2 'IN) (ass))
                                         (#t
                                          (ew eta2)
                                          (dk-conj-close!
                                            (lambda ()
                                              (let ((g3 (dk-goal)))
                                                (cond
                                                  ((dk-head-is? g3 'POS-RR) (ass))
                                                  ((dk-head-is? g3 '<=) (ass))
                                                  ((dk-contains? g3 'fam1) (fom-ap-shrink! ap1 nb1 eta1 nb2 eta2))
                                                  (#t
                                                   (let ((i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) (dk-peel!)))))
                                                     (subst (dk-cite! 'fom-lin-add 'm1 'm2 'tt xx u))
                                                     (subst (fom-cite-vec! 'fom-v-sub-sum 'm2 y (list 'tt xx) (list 'tt u)))
                                                     (dk-apply! pq i)
                                                     (ass)))))))))))))
                                (#t (error "fom-p2-tot!: unexpected" g))))))))))))))
      (lambda ()
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (equal? (dk-goal) (list 'IN u '(VEC m1)))
                (ass)
                (begin
                  (dk-lam-b!)
                  (in-sep! (lambda () (ass)) (lambda () (di) (ai (list 'NOT inv))))))))))))
;;; open the DC step at stage k: lands stepc(k) and inv(k+1); needs inv(k, fs k) in context
(define (fom-p2-open-step! fs stp k)
  (let* ((fk (list fs k)) (sk (list 'succ k)))
    (dk-cite! 'fun-apply-type-c fs 'NN '(VEC m1) k)
    (fom-once! (list 'IN sk 'NN) (lambda () (dk-cite! 'nn-succ-closed k)))
    (let* ((mem (dk-apply! stp k))
           (red (dk-landed (lambda () (dk-lam-b-h! mem))))
           (sm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) red))
           (parts (dk-landed (lambda () (sep-me sm))))
           (imp (find-first (dk-head? 'IMPLIES) parts))
           (cj (dk-landed-1 (lambda () (detach! imp)))))
      (dk-split-all! (list cj)))))
(define (fom-p2-point! hapx n eps ep n0 r0 nb0 eta0 eta0p ap0)
  (let* ((y (subset-by-element!))
         (mem (list 'IN y (list 'FR-BALL 'm2 'fam2 nb0 eta0p)))
         (red (dk-landed (lambda () (mac-h 'fom-fr-ball-unfold mem))))
         (_ (sep-me (car red)))
         (by (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f eta0p) (dk-contains? f y))) "y's prefix"))
         (nxt (fom-nxt y n n0))
         (tot (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'IMPLIES '(IN u (VEC m1))
                (list 'FORSOME 'gw_ (list 'AND '(IN gw_ (VEC m1)) (list 'IN 'gw_ (list nxt 'k 'u))))))))))
    (dk-have! tot (lambda () (fom-p2-tot! y n n0 nxt hapx)))
    (let* ((fs (dk-skolem! (dk-cite! 'dc-on-nn-pred '(VEC m1) '(VZERO m1) nxt)))
           (stp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f fs) (dk-contains? f 'succ))) "the DC step"))
           (f0 (list '= (list fs 0) '(VZERO m1)))
           (invu (list 'FORALL 'gk2_ (list 'IMPLIES '(IN gk2_ NN) (fom-inv y n n0 'gk2_ (list fs 'gk2_))))))
      (dk-have! invu
        (lambda ()
          (let* ((ind (use-induction))
                 (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
                 (ih (cdr (assq 'ih ind))) (kv (cdr (assq 'var ind))))
            (dk-focus! base)
            (subst f0)
            (dk-cite! 'nn-in-rr nb0)
            (dk-cite! 'nn-le-refl nb0)
            (dk-cite! 'nn-zero-le nb0)
            (ew nb0)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (begin
                      (ew eta0p)
                      (dk-conj-close!
                        (lambda ()
                          (let ((g3 (dk-goal)))
                            (cond
                              ((dk-head-is? g3 'POS-RR) (ass))
                              ((dk-head-is? g3 '<=) (ass))
                              ((dk-contains? g3 'fam1) (fom-ap-shrink! ap0 nb0 eta0 nb0 eta0p))
                              (#t
                               (let ((i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) (dk-peel!)))))
                                 (subst (dk-cite! 'frm-linear-zero 'm1 'm2 'tt))
                                 (subst (dk-cite! 'frm-v-sub-zero 'm2 y))
                                 (dk-have! (list 'AND (list 'IN i 'NN) (list '<= i nb0)) (lambda () (dk-conj-close! ass)))
                                 (dk-apply! by i)
                                 (ass)))))))))))
            (dk-focus! step)
            (fom-p2-open-step! fs stp kv)
            (ass))))
      (fom-p2-limit! y n eps ep n0 r0 fs stp f0 invu))))
(define fom-tel-cache '())
(define (fom-p2-tel! fs n n0 l k j)       ; p_j(fs l - fs k) <= a(k) - a(l); k <= l, j <= n + k in context
  (let ((u (let ((hit (assoc l fom-tel-cache)))
             (if (and hit (fom-asm? (cdr hit)))
                 (cdr hit)
                 (let ((uu (dk-cite! 'fom-telescope l 'fld 'm1 'fam1 fs n n0)))
                   (set! fom-tel-cache (cons (cons l uu) fom-tel-cache))
                   uu)))))
    (dk-apply! u k j)))
(define (fom-p2-limit! y n eps ep n0 r0 fs stp f0 invu)
  (let ((steps (list 'FORALL 'gk3_ (list 'IMPLIES '(IN gk3_ NN)
                 (fom-stepc n n0 'gk3_ (list fs 'gk3_) (list fs '(succ gk3_)))))))
    (set! fom-tel-cache '())
    (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-zero-le n)
    (dk-have! steps
      (lambda ()
        (let* ((ls (dk-peel!))
               (le (find-first (lambda (f) (and (dk-head-is? f '<=) (dk-head-is? (caddr f) '+))) ls))
               (j (cadr le)) (k (caddr (caddr le))))
          (dk-apply! invu k)
          (fom-p2-open-step! fs stp k)
          (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list fs (list 'succ k))) (dk-contains? f 'fam1))) "stepc") j)
          (ass))))
    ;; ---- the partial sums are Cauchy
    (dk-have! (list 'FR-CAUCHY 'm1 'fam1 fs)
      (lambda ()
        (mac 'fr-cauchy)
        (let* ((ls (dk-peel!))
               (kk (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
               (e (cadr (find-first (dk-head? 'POS-RR) ls)))
               (e2 (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-halve! e)))
               (kc (dk-skolem! (dk-cite! 'fom-a-small e2)))
               (as (fom-pick-forall-with kc "the a-small universal"))
               (cap (fom-max! kc kk)))
          (ew cap)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (ass)
                  (let* ((ls2 (dk-split-all! (dk-peel!)))
                         (ii (map cadr (filter (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) cap))) (dk-asms))))
                         (g (dk-goal))
                         (df (cadr (cadr g)))                         ; (fs i) - (fs i2)
                         (i (cadr (cadr df))) (i2 (cadr (cadr (caddr df)))))
                    (for-each (lambda (t) (dk-cite! 'nn-in-rr t) (dk-cite! 'fun-apply-type-c fs 'NN '(VEC m1) t)) (list i i2))
                    (dk-cite! 'frm-fam-field 'fld 'm1 'fam1)
                    (fom-sn-at! 'm1 'fam1 kk)
                    (dk-have! (list 'AND (list 'IN i 'RR) (list 'IN i2 'RR)) (lambda () (dk-conj-close! ass)))
                    (dk-cite! 'rr-leq-total i i2)
                    (let ((one-side
                           (lambda (lo hi)          ; lo <= hi
                             (dk-have! (list '<= kk (list '+ n lo))
                               (lambda () (fom-nn-sum! n lo)
                                          (dk-ineq! (list '<= kk cap) (list '<= cap lo) (list '<= lo hi) (list '<= 0 n))))
                             (let* ((bd (fom-p2-tel! fs n n0 hi lo kk))
                                    (sw (dk-cite! 'fom-sn-swap 'fld 'm1 (list 'fam1 kk) (list fs i) (list fs i2))))
                               (dk-have! (list '<= kc lo) (lambda () (dk-ineq! (list '<= kc cap) (list '<= cap lo))))
                               (dk-apply! as n0 lo)
                               (fom-a-type! n0 lo) (fom-a-type! n0 hi)
                               (fom-pval! 'm1 'fam1 kk (fom-sub 'm1 (list fs i) (list fs i2)))
                               (fom-pval! 'm1 'fam1 kk (fom-sub 'm1 (list fs i2) (list fs i)))
                               (dk-ineq! bd sw (list '<= (fom-a n0 lo) e2) (list '< 0 (fom-a n0 hi))
                                         (list '= (list '+ e2 e2) e) (list '< 0 e2))))))
                      (use-cases (list (list '<= i i2) (list '<= i2 i))
                        (lambda () (one-side i i2))
                        (lambda () (one-side i2 i)))))))))))
    ;; ---- completeness of E: a limit
    (dk-have! (list 'FORSOME 'glim_ (list 'AND '(IN glim_ (VEC m1)) (list 'FR-CONV 'm1 'fam1 fs 'glim_)))
      (lambda ()
        (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1))
        (dk-split-all!)
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FR-CAUCHY))) "completeness") fs)
        (ass)))
    (let* ((lim (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'glim_))) "the limit")))
           (conv1 (list 'FR-CONV 'm1 'fam1 fs lim))
           (convt (dk-cite! 'frm-cont-lin-seq 'm1 'fam1 'm2 'fam2 'tt fs lim))
           (ts (list-ref convt 3)))
      ;; ---- tt(fs) -> y
      (dk-have! (list 'FR-CONV 'm2 'fam2 ts y)
        (lambda ()
          (mac 'fr-conv)
          (let* ((ls (dk-peel!))
                 (kk (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
                 (e (cadr (find-first (dk-head? 'POS-RR) ls)))
                 (e2 (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-halve! e)))
                 (kc (dk-skolem! (dk-cite! 'fom-a-small e2)))
                 (as (fom-pick-forall-with kc "the a-small universal"))
                 (cap (fom-max! kc kk)))
            (ew cap)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (let* ((ls2 (dk-split-all! (dk-peel!)))
                           (i (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) cap))) (dk-asms))))
                           (tfi (list 'tt (list fs i))))
                      (dk-lam-b!)
                      (dk-cite! 'nn-in-rr i)
                      (dk-cite! 'fun-apply-type-c fs 'NN '(VEC m1) i)
                      (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) (list fs i))
                      (dk-cite! 'frm-fam-field 'fld 'm2 'fam2)
                      (fom-sn-at! 'm2 'fam2 kk)
                      (subst (dk-cite! 'fom-sn-swap 'fld 'm2 (list 'fam2 kk) tfi y))
                      (dk-apply! invu i)
                      (let* ((nbi (dk-skolem! (fom-inv y n n0 i (list fs i))))
                             (etai (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nbi))) "eta_i")))
                             (pre (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f etai) (dk-contains? f nbi)
                                                            (not (dk-contains? f 'fam1)))) "PRE_i")))
                        (dk-cite! 'nn-in-rr nbi)
                        (dk-have! (list '<= kk nbi) (lambda () (dk-ineq! (list '<= kk cap) (list '<= cap i) (list '<= i nbi))))
                        (dk-apply! pre kk)
                        (dk-have! (list '<= kc i) (lambda () (dk-ineq! (list '<= kc cap) (list '<= cap i))))
                        (dk-apply! as n0 i)
                        (fom-a-type! n0 i)
                        (fom-vec! 'm2 (fom-sub 'm2 y tfi))
                        (fom-pval! 'm2 'fam2 kk (fom-sub 'm2 y tfi))
                        (dk-cite! 'rr-pos-rr-in-rr etai)
                        (dk-ineq! (list '< (list (list 'fam2 kk) (fom-sub 'm2 y tfi)) etai)
                                  (list '<= etai (fom-a n0 i)) (list '<= (fom-a n0 i) e2)
                                  (list '= (list '+ e2 e2) e) (list '< 0 e2))))))))))
      ;; ---- uniqueness of limits in F: tt(lim) = y
      (dk-have! (list 'IN ts '(FUN NN (VEC m2)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((i (cadr (car (dk-peel!)))))
                (dk-cite! 'fun-apply-type-c fs 'NN '(VEC m1) i)
                (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) (list fs i))
                (ass))))))
      (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) lim)
      (dk-cite! 'frm-converges-of-conv 'fld 'm2 'fam2 ts (list 'tt lim))
      (dk-cite! 'frm-converges-of-conv 'fld 'm2 'fam2 ts y)
      (dk-cite! 'metric-limit-unique fom-fms ts (list 'tt lim) y)
      ;; ---- lim lies in FR-BALL(m1, fam1, n, eps)
      (dk-have! (list 'IN lim (list 'FR-BALL 'm1 'fam1 n eps))
        (lambda ()
          (mac 'FR-BALL)
          (in-sep! (lambda () (ass))
            (lambda ()
              (let* ((ls (dk-split-all! (dk-peel!)))
                     (jv (cadr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) n))) (dk-asms))))
                     (cpx (list 'FORSOME 'gcp_ (list 'AND '(IN gcp_ NN)
                            (list 'FORALL 'gi4_ (list 'IMPLIES '(AND (IN gi4_ NN) (<= gcp_ gi4_))
                              (list '< (list (list 'fam1 jv) (fom-sub 'm1 (list fs 'gi4_) lim)) ep)))))))
                (dk-have! cpx
                  (lambda ()
                    (mac-h 'fr-conv conv1)
                    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f lim) (dk-contains? f fs))) "conv1 universal")
                               jv ep)
                    (ass)))
                (let* ((cp (dk-skolem! cpx))
                       (cu (fom-pick-forall-with 'gi4_ "the conv universal"))
                       (fcp (list fs cp))
                       (z0 '(VZERO m1)))
                  (dk-cite! 'nn-le-refl cp)
                  (dk-have! (list 'AND (list 'IN cp 'NN) (list '<= cp cp)) (lambda () (dk-conj-close! ass)))
                  (let* ((c1 (dk-apply! cu cp))
                         (_ (begin (dk-cite! 'nn-zero-le cp) (dk-cite! 'nn-in-rr jv) (fom-nn-sum! n 0)
                                   (dk-have! (list '<= jv (list '+ n 0)) (lambda () (dk-ineq! (list '<= jv n))))))
                         (bd (fom-p2-tel! fs n n0 cp 0 jv))
                         (_ (dk-cite! 'fun-apply-type-c fs 'NN '(VEC m1) cp))
                         (bd2 (dk-rewrite-h! bd (list fs 0) z0))
                         (sz2 (fom-cite-vec! 'frm-v-sub-zero 'm1 fcp))
                         (bd3 (dk-rewrite-h! bd2 (fom-sub 'm1 fcp z0) fcp))
                         (_ (begin (dk-cite! 'nn-le-add-right 0 n0) (fom-nn-sum! n0 0)))
                         (a0b (dk-apply! r0 (list '+ n0 0)))
                         (ch (fom-cite-vec! 'frm-v-sub-chain 'm1 lim fcp z0))
                         (_ (begin (fom-sn-at! 'm1 'fam1 jv) (fom-vec! 'm1 (fom-sub 'm1 lim fcp)) (fom-vec! 'm1 (fom-sub 'm1 fcp z0))))
                         (sa (dk-cite! 'frm-sn-subadd 'fld 'm1 (list 'fam1 jv) (fom-sub 'm1 lim fcp) (fom-sub 'm1 fcp z0)))
                         (sa2 (dk-rewrite-h! sa (cadr ch) (caddr ch)))
                         (sz1 (fom-cite-vec! 'frm-v-sub-zero 'm1 lim))
                         (sa3 (dk-rewrite-h! sa2 (fom-sub 'm1 lim z0) lim))
                         (sa4 (dk-rewrite-h! sa3 (fom-sub 'm1 fcp z0) fcp))
                         (sw (dk-cite! 'fom-sn-swap 'fld 'm1 (list 'fam1 jv) lim fcp)))
                    (fom-a-type! n0 0) (fom-a-type! n0 cp)
                    (for-each (lambda (v) (fom-pval! 'm1 'fam1 jv v)) (list lim fcp (fom-sub 'm1 lim fcp) (fom-sub 'm1 fcp lim)))
                    (dk-ineq! sa4 sw c1 bd3 a0b (list '< 0 (fom-a n0 cp)) (list '= (list '+ ep ep) eps)))))))))
      ;; ---- y = tt(lim) with lim in the ball
      (mac 'image-membership-iff)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((and (dk-head-is? g 'IN) (equal? (caddr g) 'SET))
               (dk-cite! 'membership-implies-sethood y '(VEC m2)) (ass))
              (#t (ew lim) (dk-conj-close! ass)))))))))
(let* ((ls (dk-peel!))
       (hapx (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'fdl_))) ls)))
  (fom-p2-facts!)
  (mac 'is-open-lin-map)
  (dk-conj-close!
    (lambda () (if (dk-head-is? (dk-goal) 'IS-LINEAR-MAP) (ass) (fom-p2-main! hapx)))))
(fom-qed! 'fom-open-of-approx)


