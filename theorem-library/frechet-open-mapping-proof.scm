       (a (cadr (car us))) (b (cadr (cadr us))))
  (dk-cite! 'frm-sn-module fld m p)
  (let* ((ab (fom-sub m a b))
         (e1 (fom-cite-vec! 'frm-v-sub-anti m a b))
         (_ (fom-vec! m ab))
         (e2 (dk-cite! 'frm-sn-neg fld m p ab)))
    (subst (list '= (caddr e1) (cadr e1)))
    (subst e2)
    (dk-cite! 'frm-sn-type fld m p)
    (dk-cite! 'fun-apply-type-c p (list 'VEC m) 'RR ab)
    (rfl)))
(fom-qed! 'fom-sn-swap)


(define (fom-rad n0 k) (list '- (fom-a n0 k) (fom-a n0 (list 'succ k))))
(define (fom-ap nb eta bound dl)
  (list 'FORALL 'fz_ (list 'IMPLIES '(IN fz_ (VEC m2))
    (list 'IMPLIES (fom-pfx 'fam2 'fi_ nb 'fz_ '< eta) (fom-apx 'fz_ bound dl)))))
(define (fom-inv yv nv n0 k u)
  (list 'FORSOME 'gnb_ (list 'AND '(IN gnb_ NN)
    (list 'FORSOME 'geta_ (list 'AND '(POS-RR geta_)
      (list 'AND (list '<= k 'gnb_)
        (list 'AND (list '<= 'geta_ (fom-a n0 k))
          (list 'AND (fom-ap 'gnb_ 'geta_ (list '+ nv k) (fom-rad n0 k))
            (fom-pfx 'fam2 'gi_ 'gnb_ (fom-sub 'm2 yv (list 'tt u)) '< 'geta_)))))))))
(define (fom-stepc nv n0 k u v) (fom-pfx 'fam1 'gj_ (list '+ nv k) (fom-sub 'm1 v u) '< (fom-rad n0 k)))
(define (fom-nxt yv nv n0)
  (list 'VNB-LAMBDA '(LIST gkv_ guv_) '(CARTESIAN NN (VEC m1))
    (list 'SEP 'gyv_ '(VEC m1)
      (list 'IMPLIES (fom-inv yv nv n0 'gkv_ 'guv_)
        (list 'AND (fom-stepc nv n0 'gkv_ 'guv_ 'gyv_) (fom-inv yv nv n0 '(succ gkv_) 'gyv_))))))
(define fom-hapx
  (list 'FORALL 'fn_ (list 'IMPLIES '(IN fn_ NN)
    (list 'FORALL 'fdl_ (list 'IMPLIES '(POS-RR fdl_) (fom-ballapx 'fn_ 'fdl_))))))

;;; a(k) facts in context: typing, positivity, a(k+1) < a(k), and the radius D(k) > 0
(define (fom-afacts! n0 k)
