(qrfl)
(fom-qed! 'fom-fr-ball-unfold)

;;; p(a - b) = p(b - a)
(sp (make-wff '(FORALL fld (FORALL m (FORALL p (IMPLIES (IS-SEMINORM fld m p)
  (FORALL a (IMPLIES (IN a (VEC m)) (FORALL b (IMPLIES (IN b (VEC m))
    (= (p ((VADD m) a ((VNEG m) b))) (p ((VADD m) b ((VNEG m) a))))))))))))))
(let* ((ls (dk-peel!))
       (sn (find-first (dk-head? 'IS-SEMINORM) ls))
