;;; from AP(nb, eta, ...) in context and nb <= nb2, eta2 <= eta: prove AP(nb2, eta2, ...)
(define (fom-ap-shrink! ap nb eta nb2 eta2)
  (let* ((ls (append (dk-landed (lambda () (di))) (dk-landed (lambda () (di)))))
         (zz (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m2)))) ls)))
         (pz (find-first (dk-head? 'FORALL) ls))
         (pf (fom-pfx 'fam2 'fi3_ nb zz '< eta)))
    (dk-have! pf
      (lambda ()
        (let* ((ls2 (dk-peel!))
               (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls2))))
          (dk-cite! 'nn-in-rr i)
          (dk-have! (list '<= i nb2) (lambda () (dk-ineq! (list '<= i nb) (list '<= nb nb2))))
