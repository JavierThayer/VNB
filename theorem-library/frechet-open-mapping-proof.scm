(define (fom-real0!) (fom-once! '(IN 0 RR) (lambda () (dk-have! '(IN 0 RR) (lambda () (arith))))))
;;; (min x y), x y typed in RR with 0 < x, 0 < y: typing, positivity, the two bounds
