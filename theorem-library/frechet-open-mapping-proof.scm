(fom-qed! 'fom-a-small)

;;; the telescoping bound
(define (fom-tel-hst)
  (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
    (list 'IMPLIES '(<= j (+ nv i))
      (list '< (list '(fam j) (fom-sub 'm '(f (succ i)) '(f i))) (list '- (fom-a 'n0 'i) (fom-a 'n0 '(succ i))))))))))
(define (fom-tel-concl l)
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= 'k l)
    (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(<= j (+ nv k))
      (list '<= (list '(fam j) (fom-sub 'm (list 'f l) '(f k))) (list '- (fom-a 'n0 'k) (fom-a 'n0 l))))))))))
(define (fom-tel-body l)
  (list 'FORALL 'fld (list 'FORALL 'm (list 'FORALL 'fam (list 'FORALL 'f (list 'FORALL 'nv (list 'FORALL 'n0
    (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m fam) (list 'IMPLIES '(IN f (FUN NN (VEC m)))
      (list 'IMPLIES '(IN nv NN) (list 'IMPLIES '(IN n0 NN)
        (list 'IMPLIES (fom-tel-hst) (fom-tel-concl l)))))))))))))
(sp (make-wff (list 'FORALL 'l (list 'IMPLIES '(IN l NN) (fom-tel-body 'l)))))
;;; p_j(f(k) - f(k)) <= a(k) - a(k): the diagonal
(define (fom-tel-diag! fld m fam f n0 k j)
  (let ((fk (list f k)))
    (dk-cite! 'fun-apply-type-c f 'NN (list 'VEC m) k)
    (dk-cite! 'frm-fam-module fld m fam)
    (subst (dk-cite! 'frm-v-right-inv m fk))
    (fom-sn-at2! fld m fam j)
    (subst (dk-cite! 'frm-sn-zero fld m (list fam j)))
    (fom-a-type! n0 k)
    (dk-ineq!)))
(define (fom-sn-at2! fld md fm k)
  (let ((sn (list 'IS-SEMINORM fld md (list fm k))))
    (fom-once! sn (lambda () (dk-apply! (dk-cite! 'frm-fam-seminorm fld md fm) k)))
    sn))
(define (fom-pval2! fld md fm k v)
  (let ((ty (list 'IN (list (list fm k) v) 'RR)))
    (fom-once! ty
      (lambda ()
        (dk-cite! 'frm-fam-type fld md fm)
        (dk-cite! 'fun-apply-type-c fm 'NN (list 'FUN (list 'VEC md) 'RR) k)
        (dk-cite! 'fun-apply-type-c (list fm k) (list 'VEC md) 'RR v)))
    ty))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (lv (cdr (assq 'var ind))))
  (dk-focus! base)
  (let* ((ls (dk-peel!))
         (sf (find-first (dk-head? 'IS-SEMINORM-FAMILY) ls))
         (fld (cadr sf)) (m (caddr sf)) (fam (cadddr sf))
         (le (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) 0))) ls))
         (k (cadr le))
         (jv (cadr (find-first (lambda (f) (and (dk-head-is? f '<=) (dk-head-is? (caddr f) '+))) ls)))
         (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'FUN))) ls)))
         (n0 'n0))
    (dk-cite! 'nn-le-zero-is-zero k)
    (subst (list '= k 0))
    (dk-cite! 'nn-zero-in)
    (fom-tel-diag! fld m fam fv n0 0 jv))
  (dk-focus! step)
  (let* ((ls (dk-peel!))
         (sf (find-first (dk-head? 'IS-SEMINORM-FAMILY) ls))
         (fld (cadr sf)) (m (caddr sf)) (fam (cadddr sf))
         (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'FUN))) ls)))
         (hst (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'succ))) ls))
         (sl (list 'succ lv))
         (le (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) sl))) ls))
         (k (cadr le))
         (jle (find-first (lambda (f) (and (dk-head-is? f '<=) (dk-head-is? (caddr f) '+))) ls))
         (jv (cadr jle)) (nv (cadr (caddr jle)))
         (n0 'n0))
    (if (not (member (list 'IN 'n0 'NN) ls)) (error "fom-telescope: n0 renamed"))
    (dk-cite! 'nn-succ-closed lv)
    (dk-cite! 'nn-le-succ-cases lv k)
    (use-cases (list (list '<= k lv) (list '= k sl))
      (lambda ()
        (let* ((ihc (dk-apply! ih fld m fam fv nv n0))
               (_ (begin (for-each (lambda (t) (dk-cite! 'nn-in-rr t)) (list jv nv k lv))
                         (fom-nn-sum! nv k) (fom-nn-sum! nv lv)
                         (dk-have! (list '<= jv (list '+ nv lv)) (lambda () (dk-ineq! jle (list '<= k lv))))))
               (b (dk-apply! ihc k jv))
               (hs (dk-apply! hst lv jv))
               (fsl (list fv sl)) (flv (list fv lv)) (fk (list fv k))
               (aa (fom-sub m fsl flv)) (bb (fom-sub m flv fk)))
          (for-each (lambda (t) (dk-cite! 'fun-apply-type-c fv 'NN (list 'VEC m) t)) (list sl lv k))
          (dk-cite! 'frm-fam-module fld m fam)
          (fom-vec! m aa) (fom-vec! m bb) (fom-vec! m (fom-add m aa bb)) (fom-vec! m (fom-sub m fsl fk))
          (fom-sn-at2! fld m fam jv)
          (let* ((e (dk-cite! 'frm-v-sub-chain m fsl flv fk))
                 (sa (dk-cite! 'frm-sn-subadd fld m (list fam jv) aa bb))
                 (sa2 (dk-rewrite-h! sa (fom-add m aa bb) (fom-sub m fsl fk))))
            (for-each (lambda (v) (fom-pval2! fld m fam jv v)) (list aa bb (fom-sub m fsl fk)))
            (for-each (lambda (t) (fom-a-type! n0 t)) (list k lv sl))
            (dk-ineq! sa2 b hs))))
      (lambda ()
        (subst (list '= k sl))
        (fom-tel-diag! fld m fam fv n0 sl jv)))))
(fom-qed! 'fom-telescope)


;;; =====================================================================
;;; (10) EXERCISE 8.9 (h)-(i): REMOVING THE BAR.  If every basic neighbourhood
;;;      of 0 in E has a prefix ball of F inside the closure of its image
;;;      (fom-baire-approx's conclusion), then tt is open: completeness of E
