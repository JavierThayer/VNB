(sp (make-wff '(FORALL m (FORALL fam (FORALL n (FORALL eps
  (== (FR-BALL m fam n eps)
      (SEP x (VEC m) (FORALL k (IMPLIES (AND (IN k NN) (<= k n)) (< ((fam k) x) eps)))))))))))
(dk-peel!)
