        ;; |ta| eta = dlU
        (dk-have! (list '= (list '* nta eta) (list '* dlu (list '* nsg nta))) (lambda () (crs)))
        (let ((te (dk-rewrite-h! (list '= (list '* nta eta) (list '* dlu (list '* nsg nta)))
                                 (list '* nsg nta) 1)))
          (ew nbu)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
