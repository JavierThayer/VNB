(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-one 'K) (fact 'rr-one-in) (fact 'rr-zero-in)
(e4-int! 'g)
(e4-typek! 'x)
(let* ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'g))))
       (t (e4-mul 'x y)))
  (e4-typek! y)
  (dk-cite! 'nf-mul-in-carr 'K 'x y)
  (e4-typek! t)
  (dk-cite! 'nf-norm-mult 'K 'x y)
  (dk-cite! 'nf-norm-mult 'K 'g y)
  (dk-rewrite-h! (dk-rewrite-h! `(= ,(e4-n (e4-mul 'g y)) (* ,(e4-n 'g) ,(e4-n y))) (e4-mul 'g y) '(ONE K)) `((FNRM K) (ONE K)) 1)
  (dk-cite! 'rr-mul-le-right (e4-n 'x) (e4-n 'g) (e4-n y))
  (e4-rr-mul! (e4-n 'x) (e4-n y)) (e4-rr-mul! (e4-n 'g) (e4-n y))
  (dk-have! `(<= ,(e4-n t) 1)
    (lambda () (dk-ineq! `(= ,(e4-n t) (* ,(e4-n 'x) ,(e4-n y))) `(<= (* ,(e4-n 'x) ,(e4-n y)) (* ,(e4-n 'g) ,(e4-n y))) `(= 1 (* ,(e4-n 'g) ,(e4-n y))))))
  (dk-have! `(<= ,(e4-n 'x) 1) (lambda () (dk-ineq! `(<= ,(e4-n 'x) ,(e4-n 'g)) `(<= ,(e4-n 'g) 1))))
  (dk-have! `(IN ,t ,e4-Z) (lambda () (subst (dk-cite! 'nv-integers-unfold 'K)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have! `(IN x ,e4-Z) (lambda () (subst (dk-cite! 'nv-integers-unfold 'K)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have! `(= x ,(e4-mul t 'g))
    (lambda ()
      (dk-have! `(= ,(e4-mul t 'g) ,(e4-mul 'x (e4-mul 'g y))) (lambda () (e4-crs! (list 'x 'g y))))
