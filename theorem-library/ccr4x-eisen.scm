;;; 5. Proposition 4.31 in the notes' terms: coefficients in Z(K), congruences modulo uw and uw^2.

(define (e4-int-hyp p) `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (IN (,p e4i_) ,e4-Z))))
(define (e4-eis-q-items)
