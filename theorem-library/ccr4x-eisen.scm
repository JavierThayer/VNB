;;; ccr4x-eisen.scm -- CCR.pdf section 4.6: the Eisenstein factorization criterion over an NV field
;;; (Proposition 4.31) and the irreducibility of an Eisenstein polynomial in K[x] (Corollary 4.32).
;;; Agent CCR-1109-C, wave 2026-11-09.  Destination: theorem-library/ccr4x-eisen.scm.  Library: analysis
;;; (it cites ccr2-nv, analysis, and the polynomial laws, algebra < analysis).  Helper prefix e4-.
;;;
;;; Polynomials over K are, as in ccr2-nv section 19 (Proposition 1.43), the finitely supported coefficient
;;; sequences FINSUPP(V, NN-ADD-MONOID), V = NORMED-FIELD-AS-COMMUTATIVE-RING(K), with the Cauchy product
;;; MONALG-MUL; "deg q <= n" is DEG-BOUND(V, q, n) and "constant" is DEG-BOUND(V, r, 0).
;;;
;;; THE PLAN.  Three coefficient lemmas carry both results:
;;;   nv-coef-le / nv-coef-lt   |p_i| |q_j| <= c (< c) on every pair i + j = k gives |(pq)_k| <= c (< c);
;;;   nv-coef-dominant          if |p_m| |q_n| = c > 0 and every OTHER pair i + j = m + n has
;;;                             |p_i| |q_j| < c, then |(pq)_(m+n)| = c   (Remark 1.42 on the Cauchy sum).
;;; The Eisenstein argument is proved SCALED (nv-eisenstein-scaled): the coefficients of r are bounded by
;;; |la|, those of s by |mu|, with |la| |mu| = 1.  4.31 is the instance la = mu = 1; 4.32 is the instance
;;; la, mu = coefficients of r, s of maximal absolute value, since then |la| |mu| is the content of q
;;; (Proposition 1.44, nv-content-multiplicative), which is 1.  This replaces the notes' passage through
;;; ct and prim: no polynomial is divided by a scalar.
;;;
;;; LOAD WINDOW: after ccr2-nv (nv-field-normed, nf-inverse, nf-norm-one, nv-strict-dominance, nv-finsum-le,
;;; nv-finsum-lt, nv-content-multiplicative, rr-prod-*), poly-degree-laws (deg-well-defined, deg-bound-apply,
;;; leadcoef-nonzero-ptwise, leadcoef-unfold), monalg laws (monalg-mul-apply, monalg-mul-comm, monalg-carr).
;;; ccr2-nv is the latest of these, so the window is [after ccr2-nv, end).

(define e4-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define e4-nnm 'NN-ADD-MONOID)
(define e4-ag `(RING-ADDITIVE-AG ,e4-view))
(define e4-fsupp `(FINSUPP ,e4-view ,e4-nnm))
(define (e4-n x) `((FNRM K) ,x))
(define (e4-mul x y) `((MUL K) ,x ,y))
(define (e4-add x y) `((ADD K) ,x ,y))
(define (e4-fs f s) `(FINSUM ,e4-ag ,f ,s))
(define (e4-pm p q) `(MONALG-MUL ,e4-view ,e4-nnm ,p ,q))
(define (e4-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))

(define (e4-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    c))
(define (e4-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
(define (e4-rr-mul! p q)
  (if (not (dk-asm? `(IN (* ,p ,q) RR)))
      (begin
        (dk-have! `(AND (IN ,p RR) (IN ,q RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (dk-cite! 'rr-mul-closed p q))))
(define (e4-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring e4-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-mul normed-field-ring-view-one
              normed-field-ring-view-add normed-field-ring-view-zero)))
(define (e4-ag-setup!)
  (e4-view!)
  (dk-cite! 'ring-additive-ag-is-abelian-group e4-view)
  (for-each (lambda (r) (dk-cite! r e4-view)) '(raag-carr raag-iden raag-opr)))
(define (e4-in-ag! t)
  (dk-have! `(IN ,t (CARR ,e4-ag))
    (lambda () (subst `(= (CARR ,e4-ag) (CARR ,e4-view))) (subst `(= (CARR ,e4-view) (CARR K))) (dk-ass!))))
;; nth-r on the focus, closing the reflexive definedness leaves it owes
(define (e4-nth-r!)
  (let ((before (dk-open-leaves)))
    (nth-r)
    (let ((main (proof-state-focus *ps*)))
      (for-each (lambda (l)
                  (let ((g (dk-goal-of l)))
                    (if (and (not (memq l before)) (not (sequent-node-grounded? l)) (not (eq? l main))
                             (eq? (car g) '=) (equal? (cadr g) (caddr g)))
                        (begin (dk-focus! l) (rfl)))))
                (dk-open-leaves))
      (if (not (sequent-node-grounded? main)) (dk-focus! main)))))
(define (e4-iff-fwd! iff) (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
;; P in FINSUPP: land P in FUN(NN, CARR K) and CARD(SUPP P) in NN
(define (e4-poly! p)
  (let ((iff (dk-cite! 'finsupp-membership e4-view e4-nnm p)))
    (dk-have! `(IN ,p (FUN NN (CARR K)))
      (lambda ()
        (e4-iff-fwd! iff)
        (subst `(= NN (CARR ,e4-nnm)))
        (subst `(= (CARR K) (CARR ,e4-view)))
        (dk-ass!)))
    (dk-have! `(IN (CARD (SUPP ,e4-view ,e4-nnm ,p)) NN) (lambda () (e4-iff-fwd! iff) (dk-ass!)))))
(define (e4-coef! p i)
  (if (not (dk-asm? `(IN (,p ,i) (CARR K))))
      (begin
        (dk-cite! 'fun-apply-type-c p 'NN '(CARR K) i)
        (e4-typek! `(,p ,i)))))
;; the coefficient goal (REL |(pq)(KK)| B): rewrite it as a FINSUM over the pairs; land the pair set's
;; sethood and finiteness; return (F S)
(define (e4-coef-sum! p q kk)
  (dk-have! `(IN ,kk (CARR ,e4-nnm)) (lambda () (subst `(= (CARR ,e4-nnm) NN)) (dk-ass!)))
  (subst (dk-cite! 'monalg-mul-apply e4-view e4-nnm p q kk))
  (let* ((fs (cadr (cadr (dk-goal)))) (f (caddr fs)) (s (cadddr fs))
         (sp_ `(SUPP ,e4-view ,e4-nnm ,p)) (sq_ `(SUPP ,e4-view ,e4-nnm ,q))
         (cart `(CARTESIAN ,sp_ ,sq_)))
    (dk-cite! 'supp-in-set e4-view e4-nnm p)
    (dk-cite! 'supp-in-set e4-view e4-nnm q)
    (dk-cite! 'card-cartesian-nn sp_ sq_)
    (dk-have! `(IN ,cart SET) (lambda () (dk-sethood! cart)))
    (dk-have! `(IN ,s SET) (lambda () (dk-sethood! s)))
    (e4-and! `(IN ,cart SET) `(IN (CARD ,cart) NN))
    (let ((u (dk-cite! 'card-subset-nn cart)))
      (dk-have! `(AND (IN ,s SET) (FORALL e4z_ (IMPLIES (IN e4z_ ,s) (IN e4z_ ,cart))))
        (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,s)) (dk-ass!))))))))
      (dk-apply! u s))
    (list f s)))
;; Z in S: land i = (NTH 1 Z), j = (NTH 2 Z) in NN, (+ i j) = KK, Z = [i, j], the coefficients typed, and
;; (= (F Z) (MUL K (p i) (q j))); return (i j)
(define (e4-term! p q kk f s z)
  (let* ((sp_ `(SUPP ,e4-view ,e4-nnm ,p)) (sq_ `(SUPP ,e4-view ,e4-nnm ,q))
         (cart `(CARTESIAN ,sp_ ,sq_))
         (i `(NTH 1 ,z)) (j `(NTH 2 ,z))
         (cond_ `(= ((OPR ,e4-nnm) ,i ,j) ,kk)))
    (dk-have! `(IN ,z ,cart) (lambda () (sep-me `(IN ,z ,s)) (dk-ass!)))
    (dk-have! cond_ (lambda () (sep-me `(IN ,z ,s)) (dk-ass!)))
    (e4-iff-fwd! (dk-cite! 'cartesian-membership-nth sp_ sq_ z))
    (e4-iff-fwd! (dk-cite! 'supp-membership e4-view e4-nnm p i))
    (e4-iff-fwd! (dk-cite! 'supp-membership e4-view e4-nnm q j))
    (dk-have! `(IN ,i NN) (lambda () (subst `(= NN (CARR ,e4-nnm))) (dk-ass!)))
    (dk-have! `(IN ,j NN) (lambda () (subst `(= NN (CARR ,e4-nnm))) (dk-ass!)))
    (let* ((opr-eq (dk-cite! 'nn-add-monoid@opr))
           (c2 (dk-rewrite-h! cond_ `(OPR ,e4-nnm) (caddr opr-eq))))
      (dk-lam-b-h! c2))
    (e4-coef! p i) (e4-coef! q j)
    (dk-cite! 'nf-mul-in-carr 'K `(,p ,i) `(,q ,j))
    (dk-have! `(= (,f ,z) ,(e4-mul `(,p ,i) `(,q ,j)))
      (lambda ()
        (dk-lam-b!)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin (if (dk-contains? (dk-goal) `(MUL ,e4-view)) (subst `(= (MUL ,e4-view) (MUL K)))) (rfl)))))
    (dk-cite! 'nf-norm-mult 'K `(,p ,i) `(,q ,j))
    (e4-typek! (e4-mul `(,p ,i) `(,q ,j)))
    (e4-typek! `(,p ,i)) (e4-typek! `(,q ,j))
    (e4-rr-mul! (e4-n `(,p ,i)) (e4-n `(,q ,j)))
    (list i j)))
;; the setup shared by the coefficient lemmas, after the peel
(define (e4-setup!)
  (dk-cite! 'nv-field-normed 'K)
  (e4-ag-setup!)
  (dk-cite! 'nf-zero-in-carr 'K)
  (dk-cite! 'nf-one-in-carr 'K)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-cite! 'nf-norm-one 'K)
  (dk-cite! 'nf-norm-of-zero 'K)
  (dk-cite! 'nn-add-monoid@carr)
  (dk-have! `(IN (CARR ,e4-nnm) SET) (lambda () (subst `(= (CARR ,e4-nnm) NN)) (fact 'nn-is-set) (dk-ass!))))

;;; -----------------------------------------------------------------------
;;; 1. Coefficient bounds on a Cauchy product.

(define (e4-pair-hyp rel p q kk c)
  `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (FORALL e4j_ (IMPLIES (IN e4j_ NN) (IMPLIES (= (+ e4i_ e4j_) ,kk)
     (,rel (* ((FNRM K) (,p e4i_)) ((FNRM K) (,q e4j_))) ,c)))))))
(define (e4-coef-bound! rel rel0 fsname name)
  (dk-sp-qed!
    (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL p (IMPLIES (IN p ,e4-fsupp) (FORALL q (IMPLIES (IN q ,e4-fsupp)
      (FORALL kk (IMPLIES (IN kk NN) (FORALL c (IMPLIES (IN c RR) (IMPLIES (,rel0 0 c)
        (IMPLIES ,(e4-pair-hyp rel 'p 'q 'kk 'c) (,rel ,(e4-n `(,(e4-pm 'p 'q) kk)) c))))))))))))))
    (lambda ()
      (dk-peel!)
      (e4-setup!)
      (e4-poly! 'p) (e4-poly! 'q)
      (let* ((hyp (e4-pair-hyp rel 'p 'q 'kk 'c))
             (fs (e4-coef-sum! 'p 'q 'kk)) (f (car fs)) (s (cadr fs)))
        (dk-have! `(FORALL e4z_ (IMPLIES (IN e4z_ ,s) (AND (IN (,f e4z_) (CARR K)) (,rel ((FNRM K) (,f e4z_)) c))))
          (lambda ()
            (dk-peel!)
            (let* ((z (cadr (cadr (cadr (dk-goal)))))
                   (ij (e4-term! 'p 'q 'kk f s z)) (i (car ij)) (j (cadr ij)))
              (subst `(= (,f ,z) ,(e4-mul `(p ,i) `(q ,j))))
              (dk-apply! hyp i j)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (dk-ineq! `(= ,(e4-n (e4-mul `(p ,i) `(q ,j))) (* ,(e4-n `(p ,i)) ,(e4-n `(q ,j))))
                                `(,rel (* ,(e4-n `(p ,i)) ,(e4-n `(q ,j))) c))))))))
        (e4-and! `(IN ,s SET) `(IN (CARD ,s) NN))
        (dk-cite! fsname 'K s f 'c)
        (dk-ass!)))
    name))
(e4-coef-bound! '<= '<= 'nv-finsum-le 'nv-coef-le)
(e4-coef-bound! '< '< 'nv-finsum-lt 'nv-coef-lt)

;; Remark 1.42 on a Cauchy product: one dominant pair fixes the absolute value of the coefficient
(define (e4-dom-hyp p q m n c)
  `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (FORALL e4j_ (IMPLIES (IN e4j_ NN) (IMPLIES (= (+ e4i_ e4j_) (+ ,m ,n))
     (IMPLIES (NOT (= e4i_ ,m)) (< (* ((FNRM K) (,p e4i_)) ((FNRM K) (,q e4j_))) ,c))))))))
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL p (IMPLIES (IN p ,e4-fsupp) (FORALL q (IMPLIES (IN q ,e4-fsupp)
  (FORALL m (IMPLIES (IN m NN) (FORALL n (IMPLIES (IN n NN) (FORALL c (IMPLIES (IN c RR) (IMPLIES (< 0 c)
    (IMPLIES (= (* ((FNRM K) (p m)) ((FNRM K) (q n))) c)
      (IMPLIES ,(e4-dom-hyp 'p 'q 'm 'n 'c) (= ,(e4-n `(,(e4-pm 'p 'q) (+ m n))) c))))))))))))))))))
(dk-peel!)
(e4-setup!)
(e4-poly! 'p) (e4-poly! 'q)
(e4-coef! 'p 'm) (e4-coef! 'q 'n)
(e4-and! '(IN m NN) '(IN n NN))
(dk-cite! 'nn-add-closed 'm 'n)
(let* ((hyp (e4-dom-hyp 'p 'q 'm 'n 'c))
       (nn_ '(+ m n))
       (fs (e4-coef-sum! 'p 'q nn_)) (f (car fs)) (s (cadr fs))
       (e '(LIST m n)) (pe `(PAIR ,e ,e)) (r `(DIFFERENCE ,s ,pe))
       (mkin (lambda (pp ii)
               (dk-have! `(IN ,ii (SUPP ,e4-view ,e4-nnm ,pp))
                 (lambda ()
                   (mac 'supp-membership)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'IN)
                           (begin (subst `(= (CARR ,e4-nnm) NN)) (dk-ass!))
                           (begin
                             (di)
                             (dk-have! `(= ((FNRM K) (,pp ,ii)) 0)
                               (lambda () (subst `(= (,pp ,ii) (ZERO ,e4-view))) (subst `(= (ZERO ,e4-view) (ZERO K))) (dk-ass!)))
                             (let ((h (dk-rewrite-h! '(= (* ((FNRM K) (p m)) ((FNRM K) (q n))) c) `((FNRM K) (,pp ,ii)) 0)))
                               (dk-absurd! h '(< 0 c))))))))))))
  (mkin 'p 'm)
  (mkin 'q 'n)
  (dk-cite! 'pair-in-cartesian `(SUPP ,e4-view ,e4-nnm p) `(SUPP ,e4-view ,e4-nnm q) 'm 'n)
  (dk-have! `(IN ,e ,s)
    (lambda ()
      (in-sep! (lambda () (dk-ass!))
        (lambda ()
          (e4-nth-r!)
          (subst (dk-cite! 'nn-add-monoid@opr))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
  (dk-cite! 'pair-tuple-is-set `(SUPP ,e4-view ,e4-nnm p) `(SUPP ,e4-view ,e4-nnm q) 'm 'n)
  (dk-cite! 'remove-restore s e)
  (dk-cite! 'pair-self-member e)
  (e4-and! `(IN ,e SET) `(IN ,e SET))
  (fact 'pairing e e)
  (dk-have! `(IN ,r SET) (lambda () (dk-have! `(SUBSET ,r ,s) (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (e4-iff-fwd! (dk-cite! 'difference-membership s pe z)) (dk-ass!)))) (dk-sethood! r)))
  (dk-have! `(NOT (IN ,e ,r)) (lambda () (di) (e4-iff-fwd! (dk-cite! 'difference-membership s pe e)) (ai `(NOT (IN ,e ,pe)))))
  (e4-and! `(IN ,s SET) `(IN (CARD ,s) NN))
  (let ((u (dk-cite! 'card-subset-nn s)))
    (dk-have! `(AND (IN ,r SET) (FORALL e4z_ (IMPLIES (IN e4z_ ,r) (IN e4z_ ,s))))
      (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (di) (let ((z (cadr (dk-goal)))) (e4-iff-fwd! (dk-cite! 'difference-membership s pe z)) (dk-ass!))))))))
    (dk-apply! u r))
  ;; the sum over S is the sum over R plus the term at e
  (dk-have! `(FORALL e4w_ (IMPLIES (IN e4w_ (UNION ,r ,pe)) (IN (,f e4w_) (CARR ,e4-ag))))
    (lambda ()
      (dk-peel!)
      (let* ((z (cadr (cadr (dk-goal)))))
        (dk-rewrite-h! `(IN ,z (UNION ,r ,pe)) `(UNION ,r ,pe) s)
        (e4-term! 'p 'q nn_ f s z)
        (subst `(= (,f ,z) ,(e4-mul `(p (NTH 1 ,z)) `(q (NTH 2 ,z)))))
        (e4-in-ag! (e4-mul `(p (NTH 1 ,z)) `(q (NTH 2 ,z))))
        (dk-ass!))))
  (dk-cite! 'finsum-insert-ptwise e4-ag r e f)
  (dk-have! `(== ,(e4-fs f s) ,(e4-fs f `(UNION ,r ,pe))) (lambda () (subst `(= (UNION ,r ,pe) ,s)) (qrfl)))
  (subst `(== ,(e4-fs f s) ,(e4-fs f `(UNION ,r ,pe))))
  (subst `(= ,(e4-fs f `(UNION ,r ,pe)) ((OPR ,e4-ag) ,(e4-fs f r) (,f ,e))))
  (subst `(= (OPR ,e4-ag) (ADD ,e4-view)))
  (subst `(= (ADD ,e4-view) (ADD K)))
  ;; the term at e has absolute value c
  (let* ((ij (e4-term! 'p 'q nn_ f s e)) (pm `(p (NTH 1 ,e))) (qn `(q (NTH 2 ,e))))
    (subst `(= (,f ,e) ,(e4-mul pm qn)))
    (dk-have! `(= ,(e4-n (e4-mul pm qn)) c)
      (lambda ()
        (subst `(= ,(e4-n (e4-mul pm qn)) (* ,(e4-n pm) ,(e4-n qn))))
        (e4-nth-r!)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!))))
    ;; the rest: every term has |.| < c
    (dk-have! `(FORALL e4z_ (IMPLIES (IN e4z_ ,r) (AND (IN (,f e4z_) (CARR K)) (< ((FNRM K) (,f e4z_)) c))))
      (lambda ()
        (dk-peel!)
        (let* ((z (cadr (cadr (cadr (dk-goal))))))
          (e4-iff-fwd! (dk-cite! 'difference-membership s pe z))
          (let* ((ij2 (e4-term! 'p 'q nn_ f s z)) (i (car ij2)) (j (cadr ij2)))
            (subst `(= (,f ,z) ,(e4-mul `(p ,i) `(q ,j))))
            (dk-cite! 'nn-in-rr i) (dk-cite! 'nn-in-rr j) (dk-cite! 'nn-in-rr 'm) (dk-cite! 'nn-in-rr 'n)
            (dk-have! `(< ((FNRM K) ,(e4-mul `(p ,i) `(q ,j))) c)
              (lambda ()
                (subst `(= ,(e4-n (e4-mul `(p ,i) `(q ,j))) (* ,(e4-n `(p ,i)) ,(e4-n `(q ,j)))))
                (use-em `(= ,i m)
                  (lambda ()
                    (pbc)
                    (dk-have! `(= ,j n) (lambda () (dk-nn! `(= (+ ,i ,j) (+ m n)) `(= ,i m))))
                    (dk-have! `(IN ,z ,pe)
                      (lambda ()
                        (subst `(= ,z (LIST ,i ,j)))
                        (subst `(= ,i m)) (subst `(= ,j n))
                        (dk-ass!)))
                    (ai `(NOT (IN ,z ,pe))))
                  (lambda ()
                    (dk-apply! hyp i j)
                    (dk-ass!)))))
            (dk-conj-close! (lambda () (dk-ass!)))))))
    (e4-and! `(IN ,r SET) `(IN (CARD ,r) NN))
    (dk-have! `(FORALL e4w_ (IMPLIES (IN e4w_ ,r) (IN (,f e4w_) (CARR ,e4-ag))))
      (lambda ()
        (dk-peel!)
        (let* ((z (cadr (cadr (dk-goal)))))
          (e4-iff-fwd! (dk-cite! 'difference-membership s pe z))
          (e4-term! 'p 'q nn_ f s z)
          (subst `(= (,f ,z) ,(e4-mul `(p (NTH 1 ,z)) `(q (NTH 2 ,z)))))
          (e4-in-ag! (e4-mul `(p (NTH 1 ,z)) `(q (NTH 2 ,z))))
          (dk-ass!))))
    (dk-cite! 'nv-finsum-lt 'K r f 'c)
    (dk-cite! 'finsum-type-ptwise e4-ag r f)
    (dk-have! `(IN ,(e4-fs f r) (CARR K))
      (lambda () (subst `(= (CARR K) (CARR ,e4-view))) (subst `(= (CARR ,e4-view) (CARR ,e4-ag))) (dk-ass!)))
    (e4-typek! (e4-fs f r))
    (dk-have! `(< ,(e4-n (e4-fs f r)) ,(e4-n (e4-mul pm qn)))
      (lambda () (dk-ineq! `(< ,(e4-n (e4-fs f r)) c) `(= ,(e4-n (e4-mul pm qn)) c))))
    (dk-cite! 'nv-strict-dominance 'K (e4-fs f r) (e4-mul pm qn))
    (dk-cite! 'nf-add-in-carr 'K (e4-fs f r) (e4-mul pm qn))
    (e4-typek! (e4-add (e4-fs f r) (e4-mul pm qn)))
    (dk-ineq! `(= ,(e4-n (e4-add (e4-fs f r) (e4-mul pm qn))) ,(e4-n (e4-mul pm qn))) `(= ,(e4-n (e4-mul pm qn)) c))))
(qed 'nv-coef-dominant)

