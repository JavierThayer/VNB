          (e4-lead-nonzero! 's be 0)
          (dk-have! `(NOT (< ,al ,l))
            (lambda () (di) (dk-cite! 'deg-bound-apply e4-view 'r al l) (ai `(NOT (= (r ,l) ,e4-zv)))))
          (dk-cite! 'rr-not-lt-ge al l)
