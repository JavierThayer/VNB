;;; 2. Small helpers for the Eisenstein argument.

(define (e4-nr p i) `((FNRM K) (,p ,i)))
(define e4-zv `(ZERO ,e4-view))
;; a statement from a prefix: (all V CLS) / (all V) / (imp F)
(define (e4-build items concl)
  (fold-right (lambda (it acc)
                (cond ((and (eq? (car it) 'all) (null? (cddr it))) `(FORALL ,(cadr it) ,acc))
                      ((eq? (car it) 'all) `(FORALL ,(cadr it) (IMPLIES (IN ,(cadr it) ,(caddr it)) ,acc)))
                      (#t `(IMPLIES ,(cadr it) ,acc))))
              concl items))
;; read the indices i, j off a pair-bound goal (REL (* |p i| |q j|) c)
(define (e4-goal-ij)
  (let ((pr (cadr (dk-goal))))
    (list (cadr (cadr (cadr pr))) (cadr (cadr (caddr pr))))))
(define (e4-nonneg-prod! a b)
  (if (not (dk-asm? `(<= 0 (* ,a ,b))))
      (begin
        (e4-and! `(IN ,a RR) `(IN ,b RR))
        (e4-and! `(<= 0 ,a) `(<= 0 ,b))
        (dk-cite! 'rr-leq-mul-nonneg a b))))
;; (< 0 T) from (= EQ-LHS 1) where T is a nonnegative factor of EQ-LHS
(define (e4-pos-factor! eq t)
  (dk-have! `(NOT (= 0 ,t)) (lambda () (di) (dk-absurd! (dk-rewrite-h! eq t 0))))
  (e4-and! `(<= 0 ,t) `(NOT (= 0 ,t)))
  (dk-cite! 'rr-le-ne-lt 0 t))
;; X /= ZERO(V) in context, X in CARR K: land 0 < |X|
(define (e4-norm-pos! x)
  (e4-typek! x)
  (dk-have! `(NOT (= 0 ,(e4-n x)))
    (lambda ()
      (di)
      (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
        (dk-have! `(= ,(e4-n x) 0) (lambda () (subst `(= ,(e4-n x) 0)) (rfl)))
        (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(e4-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
        (dk-have! `(= ,x ,e4-zv) (lambda () (subst `(= ,e4-zv (ZERO K))) (dk-ass!)))
        (ai `(NOT (= ,x ,e4-zv))))))
  (e4-and! `(<= 0 ,(e4-n x)) `(NOT (= 0 ,(e4-n x))))
  (dk-cite! 'rr-le-ne-lt 0 (e4-n x)))
;; X /= ZERO(K) in context, X in CARR K: land 0 < |X|
(define (e4-norm-pos-k! x)
  (e4-typek! x)
  (dk-have! `(NOT (= 0 ,(e4-n x)))
    (lambda ()
      (di)
      (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
        (dk-have! `(= ,(e4-n x) 0) (lambda () (subst `(= ,(e4-n x) 0)) (rfl)))
        (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(e4-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
        (ai `(NOT (= ,x (ZERO K)))))))
  (e4-and! `(<= 0 ,(e4-n x)) `(NOT (= 0 ,(e4-n x))))
  (dk-cite! 'rr-le-ne-lt 0 (e4-n x)))
;; X = ZERO(V) in context: land |X| = 0
(define (e4-zero-norm! x)
  (dk-have! `(= ,(e4-n x) 0) (lambda () (subst `(= ,x ,e4-zv)) (subst `(= ,e4-zv (ZERO K))) (dk-ass!))))
;; a = b from a <= b, b <= a (reals)
(define (e4-antisym! a b)
  (e4-and! `(IN ,a RR) `(IN ,b RR))
  (e4-and! `(<= ,a ,b) `(<= ,b ,a))
  (dk-cite! 'rr-leq-antisymmetric a b))
(define (e4-in-poly! p)
  (dk-have! `(IN ,p (CARR (POLY ,e4-view)))
    (lambda () (mac 'POLY) (subst `(= (CARR (MONALG ,e4-view ,e4-nnm)) ,e4-fsupp)) (dk-ass!))))
(define (e4-poly-setup!)
  (fact 'nn-add-monoid-is-comm-monoid)
  (dk-cite! 'comm-monoid-is-monoid e4-nnm)
  (dk-cite! 'monalg-carr e4-view e4-nnm))
;; DEG(V, P): name it, land its bound, return the name
(define (e4-deg! p)
  (e4-in-poly! p)
  (dk-split-all! (list (dk-cite! 'deg-well-defined e4-view p)))
  (let ((d (dk-name! `(DEG ,e4-view ,p) 'NN)))
    (dk-rewrite-h! `(DEG-BOUND ,e4-view ,p (DEG ,e4-view ,p)) `(DEG ,e4-view ,p) d)
    (dk-cite! 'nn-in-rr d)
    d))
;; the coefficient (P D) at its degree D is nonzero, given some nonzero coefficient (P I)
(define (e4-lead-nonzero! p d i)
  (dk-have! `(FORSOME e4k_ (AND (IN e4k_ NN) (NOT (= (,p e4k_) ,e4-zv)))) (lambda () (ew i) (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'leadcoef-nonzero-ptwise e4-view p)
  (dk-cite! 'leadcoef-unfold e4-view p)
  (dk-have! `(NOT (= (,p ,d) ,e4-zv))
    (lambda () (subst `(= ,d (DEG ,e4-view ,p))) (subst `(= (,p (DEG ,e4-view ,p)) (LEADCOEF ,e4-view ,p))) (dk-ass!))))
;; X in CARR K with |X| = T, 0 < T: X /= ZERO(V)
(define (e4-nonzero-of-norm! x t)
  (dk-have! `(NOT (= ,x ,e4-zv))
    (lambda () (di) (e4-zero-norm! x) (dk-absurd! `(= ,(e4-n x) 0) `(= ,(e4-n x) ,t) `(< 0 ,t)))))

;;; -----------------------------------------------------------------------
;;; 3. |x| < |la| gives |x| <= |la| |uw| when M(Z(K)) = (uw).

(define (e4-crs! vs)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
  (for-each (lambda (u)
              (dk-have! `(IN ,u (CARR ,e4-view)) (lambda () (subst `(= (CARR ,e4-view) (CARR K))) (dk-ass!))))
            vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,e4-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,e4-view))))) '(ZERO ONE))
  (crs))
;; open (IN X F) where F unfolds by the theorem NAME to a SEP; return what landed
(define (e4-open-sep! name h)
  (let ((s (car (dk-landed (lambda () (mac-h name h))))))
    (dk-landed (lambda () (sep-me s)))))

(define e4-M '(NV-MAXIMAL K (NV-INTEGERS K)))
(define e4-Z '(NV-INTEGERS K))
(define (e4-pr g) `(NV-PRINCIPAL K (NV-INTEGERS K) ,g))
(define e4-unif `(= ,e4-M ,(e4-pr 'uw)))

(sp (make-wff (e4-build `((all K) (imp (IS-NV-FIELD K)) (all uw (CARR K)) (imp ,e4-unif) (all la (CARR K)) (all x (CARR K))
                         (imp (< ,(e4-n 'x) ,(e4-n 'la))))
                        `(<= ,(e4-n 'x) (* ,(e4-n 'la) ,(e4-n 'uw))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-of-zero 'K) (dk-cite! 'nf-norm-one 'K)
(fact 'rr-one-in) (fact 'rr-zero-in)
(e4-typek! 'x) (e4-typek! 'la) (e4-typek! 'uw)
(dk-have! '(NOT (= la (ZERO K)))
  (lambda () (di) (dk-absurd! (dk-rewrite-h! (dk-rewrite-h! `(< ,(e4-n 'x) ,(e4-n 'la)) 'la '(ZERO K)) `((FNRM K) (ZERO K)) 0) `(<= 0 ,(e4-n 'x)))))
(let* ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'la))))
       (v (e4-mul 'x y)))
  (e4-typek! y)
  (dk-cite! 'nf-mul-in-carr 'K 'x y)
  (e4-typek! v)
  (dk-cite! 'nf-norm-mult 'K 'x y)
  (dk-cite! 'nf-norm-mult 'K 'la y)
  (let* ((ly (dk-rewrite-h! (dk-rewrite-h! `(= ,(e4-n (e4-mul 'la y)) (* ,(e4-n 'la) ,(e4-n y))) (e4-mul 'la y) '(ONE K)) `((FNRM K) (ONE K)) 1)))
    ;; ly : (= 1 (* |la| |y|))
    (dk-have! `(= (* ,(e4-n 'la) ,(e4-n y)) 1) (lambda () (subst `(= (* ,(e4-n 'la) ,(e4-n y)) 1)) (rfl)))
    (e4-pos-factor! `(= (* ,(e4-n 'la) ,(e4-n y)) 1) (e4-n y))
    (dk-have! `(<= ,(e4-n y) ,(e4-n y)) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-prod-lt-gen-left (e4-n 'x) (e4-n y) (e4-n 'la) (e4-n y))
    (e4-rr-mul! (e4-n 'x) (e4-n y)) (e4-rr-mul! (e4-n 'la) (e4-n y))
    (dk-have! `(< ,(e4-n v) 1)
      (lambda () (dk-ineq! `(= ,(e4-n v) (* ,(e4-n 'x) ,(e4-n y))) `(< (* ,(e4-n 'x) ,(e4-n y)) (* ,(e4-n 'la) ,(e4-n y))) `(= (* ,(e4-n 'la) ,(e4-n y)) 1))))
    (dk-have! `(IN ,v ,e4-Z) (lambda () (subst (dk-cite! 'nv-integers-unfold 'K)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ineq! `(< ,(e4-n v) 1))))))
    (dk-have! `(IN ,v ,e4-M) (lambda () (subst (dk-cite! 'nv-maximal-unfold 'K e4-Z)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
    (dk-have! `(<= ,(e4-n v) ,(e4-n 'uw))
      (lambda ()
        (let* ((h (dk-rewrite-h! `(IN ,v ,e4-M) e4-M (e4-pr 'uw)))
               (ls (e4-open-sep! 'nv-principal-unfold h))
               (m (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the multiplier"))))
          (dk-have! `(IN ,m (CARR K)) (lambda () (e4-open-sep! 'nv-integers-unfold `(IN ,m ,e4-Z)) (dk-ass!)))
          (dk-have! `(<= ,(e4-n m) 1) (lambda () (e4-open-sep! 'nv-integers-unfold `(IN ,m ,e4-Z)) (dk-ass!)))
          (e4-typek! m)
          (dk-cite! 'nf-norm-mult 'K m 'uw)
          (dk-cite! 'nf-mul-in-carr 'K m 'uw)
          (e4-typek! (e4-mul m 'uw))
          (dk-cite! 'rr-mul-le-right (e4-n m) 1 (e4-n 'uw))
          (dk-cite! 'rr-one-mul (e4-n 'uw))
          (e4-rr-mul! (e4-n m) (e4-n 'uw)) (e4-rr-mul! 1 (e4-n 'uw))
          (subst `(= ,v ,(e4-mul m 'uw)))
          (dk-ineq! `(= ,(e4-n (e4-mul m 'uw)) (* ,(e4-n m) ,(e4-n 'uw))) `(<= (* ,(e4-n m) ,(e4-n 'uw)) (* 1 ,(e4-n 'uw)))
                    `(= (* 1 ,(e4-n 'uw)) ,(e4-n 'uw))))))
    ;; x = v la
    (dk-have! `(= x ,(e4-mul v 'la))
      (lambda ()
        (dk-have! `(= ,(e4-mul v 'la) ,(e4-mul 'x (e4-mul 'la y))) (lambda () (e4-crs! (list 'x 'la y))))
        (subst `(= ,(e4-mul v 'la) ,(e4-mul 'x (e4-mul 'la y))))
        (subst `(= ,(e4-mul 'la y) (ONE K)))
        (e4-crs! (list 'x))))
    (dk-cite! 'nf-norm-mult 'K v 'la)
    (dk-cite! 'nf-mul-in-carr 'K v 'la)
    (e4-typek! (e4-mul v 'la))
    (dk-cite! 'rr-mul-le-right (e4-n v) (e4-n 'uw) (e4-n 'la))
    (e4-rr-mul! (e4-n v) (e4-n 'la)) (e4-rr-mul! (e4-n 'uw) (e4-n 'la)) (e4-rr-mul! (e4-n 'la) (e4-n 'uw))
    (dk-have! `(= (* ,(e4-n 'uw) ,(e4-n 'la)) (* ,(e4-n 'la) ,(e4-n 'uw))) (lambda () (crs)))
    (subst `(= x ,(e4-mul v 'la)))
    (dk-ineq! `(= ,(e4-n (e4-mul v 'la)) (* ,(e4-n v) ,(e4-n 'la))) `(<= (* ,(e4-n v) ,(e4-n 'la)) (* ,(e4-n 'uw) ,(e4-n 'la)))
              `(= (* ,(e4-n 'uw) ,(e4-n 'la)) (* ,(e4-n 'la) ,(e4-n 'uw))))))
(qed 'nv-below-scaled)

;;; -----------------------------------------------------------------------
;;; 4. The Eisenstein argument, scaled: coefficients of r bounded by |la|, of s by |mu|, |la| |mu| = 1.

(define (e4-hq<n) `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (IMPLIES (< e4i_ n) (< ,(e4-nr 'q 'e4i_) 1)))))
(define (e4-hbound p c) `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (<= ,(e4-nr p 'e4i_) ,c))))
(define (e4-q-items)
  `((all K) (imp (IS-NV-FIELD K)) (all uw (CARR K)) (imp ,e4-unif)
    (all q ,e4-fsupp) (all n NN) (imp (<= 1 n)) (imp (DEG-BOUND ,e4-view q n)) (imp (= ,(e4-nr 'q 'n) 1))
    (imp ,(e4-hq<n)) (imp (NOT (<= ,(e4-nr 'q 0) (* ,(e4-n 'uw) ,(e4-n 'uw)))))))
(define (e4-rs-items)
  `((all r ,e4-fsupp) (all s ,e4-fsupp) (imp (= q ,(e4-pm 'r 's)))
    (all la (CARR K)) (all mu (CARR K)) (imp (= (* ,(e4-n 'la) ,(e4-n 'mu)) 1))
    (imp ,(e4-hbound 'r (e4-n 'la))) (imp ,(e4-hbound 's (e4-n 'mu)))))
;; the setup shared by the Eisenstein proofs, after the peel
(define (e4-eis-setup!)
  (e4-setup!)
  (e4-poly-setup!)
  (fact 'nn-zero-in)
  (e4-poly! 'q) (e4-poly! 'r) (e4-poly! 's)
  (e4-typek! 'uw) (e4-typek! 'la) (e4-typek! 'mu)
  (dk-cite! 'nn-in-rr 'n)
  (e4-coef! 'r 0) (e4-coef! 's 0) (e4-coef! 'q 0) (e4-coef! 'q 'n)
  (e4-rr-mul! (e4-n 'la) (e4-n 'mu)) (e4-rr-mul! (e4-n 'uw) (e4-n 'uw))
  (e4-pos-factor! `(= (* ,(e4-n 'la) ,(e4-n 'mu)) 1) (e4-n 'la))
  (e4-pos-factor! `(= (* ,(e4-n 'la) ,(e4-n 'mu)) 1) (e4-n 'mu)))
;; rewrite (MONALG r s) to q in hypothesis H
(define (e4-to-q! h) (dk-rewrite-h! h (e4-pm 'r 's) 'q))

;; Case A: |r_0| < |la| makes s constant.
(sp (make-wff (e4-build (append (e4-q-items) (e4-rs-items) `((imp (< ,(e4-nr 'r 0) ,(e4-n 'la)))))
                        `(DEG-BOUND ,e4-view s 0))))
(dk-peel!)
(e4-eis-setup!)
(let* ((r0 (e4-nr 'r 0)) (s0 (e4-nr 's 0)) (q0 (e4-nr 'q 0))
       (la (e4-n 'la)) (mu (e4-n 'mu)) (uw (e4-n 'uw))
       (hr (e4-hbound 'r la)) (hs (e4-hbound 's mu)))
  (dk-apply! hr 0) (dk-apply! hs 0)
  ;; (i) |s_0| = |mu|
  (dk-have! `(NOT (< ,s0 ,mu))
    (lambda ()
      (di)
      (dk-cite! 'nv-below-scaled 'K 'uw 'la '(r 0))
      (dk-cite! 'nv-below-scaled 'K 'uw 'mu '(s 0))
      (let* ((c0 `(* ,r0 ,s0)) (lu `(* ,la ,uw)) (mw `(* ,mu ,uw)) (p2 `(* ,lu ,mw)) (u2 `(* ,uw ,uw)))
        (e4-rr-mul! r0 s0) (e4-rr-mul! la uw) (e4-rr-mul! mu uw) (e4-rr-mul! lu mw)
        (e4-nonneg-prod! r0 s0) (e4-nonneg-prod! la uw)
        (dk-have! (e4-pair-hyp '<= 'r 's 0 c0)
          (lambda ()
            (dk-peel!)
            (let* ((ij (e4-goal-ij)) (i (car ij)) (j (cadr ij)))
              (dk-have! `(= ,i 0) (lambda () (dk-nn!)))
              (dk-have! `(= ,j 0) (lambda () (dk-nn!)))
              (subst `(= ,i 0)) (subst `(= ,j 0))
              (dk-ineq!))))
        (let ((h (e4-to-q! (dk-cite! 'nv-coef-le 'K 'r 's 0 c0))))
          (dk-cite! 'rr-prod-le-gen r0 s0 lu mw)
          (dk-have! `(= ,p2 ,u2)
            (lambda ()
              (dk-have! `(= ,p2 (* (* ,la ,mu) ,u2)) (lambda () (crs)))
              (subst `(= ,p2 (* (* ,la ,mu) ,u2)))
              (subst `(= (* ,la ,mu) 1))
              (crs)))
          (dk-have! `(<= ,q0 ,u2) (lambda () (dk-ineq! h `(<= ,c0 ,p2) `(= ,p2 ,u2))))
          (ai `(NOT (<= ,q0 ,u2)))))))
  (dk-cite! 'rr-not-lt-ge s0 mu)
  (e4-antisym! s0 mu)
  ;; (ii) some |r_i| = |la|; the least such index l
  (let ((ex `(FORSOME e4t_ (AND (IN e4t_ NN) (= ,(e4-nr 'r 'e4t_) ,la)))))
    (dk-have! ex
      (lambda ()
        (pbc)
        (dk-have! (e4-pair-hyp '< 'r 's 'n 1)
          (lambda ()
            (dk-peel!)
            (let* ((ij (e4-goal-ij)) (i (car ij)) (j (cadr ij)) (ri (e4-nr 'r i)) (sj (e4-nr 's j)))
              (e4-coef! 'r i) (e4-coef! 's j)
              (dk-have! `(NOT (= ,ri ,la))
                (lambda () (di) (dk-have! ex (lambda () (ew i) (dk-conj-close! (lambda () (dk-ass!))))) (ai `(NOT ,ex))))
              (dk-apply! hr i) (dk-apply! hs j)
              (e4-and! `(<= ,ri ,la) `(NOT (= ,ri ,la)))
              (dk-cite! 'rr-le-ne-lt ri la)
              (dk-cite! 'rr-prod-lt-gen-left ri sj la mu)
              (e4-rr-mul! ri sj)
              (dk-ineq! `(< (* ,ri ,sj) (* ,la ,mu)) `(= (* ,la ,mu) 1)))))
        (fact 'rr-zero-in)
        (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (dk-absurd! (e4-to-q! (dk-cite! 'nv-coef-lt 'K 'r 's 'n 1)) `(= ,(e4-nr 'q 'n) 1))))
    (let* ((tset `(SEP e4u_ NN (= ,(e4-nr 'r 'e4u_) ,la)))
           (i0 (dk-skolem! ex)))
      (dk-have! `(IN ,i0 ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (dk-have! `(SUBSET ,tset NN) (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,tset)) (dk-ass!))))
      (dk-have! `(FORSOME e4v (IN e4v ,tset)) (lambda () (ew i0) (dk-ass!)))
      (e4-and! `(SUBSET ,tset NN) `(FORSOME e4v (IN e4v ,tset)))
      (let* ((l (dk-skolem! (dk-cite! 'nn-least-element tset)))
             (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset) (dk-contains? f '<=))) "the least law"))
             (rl (e4-nr 'r l)))
        (dk-have! `(IN ,l NN) (lambda () (sep-me `(IN ,l ,tset)) (dk-ass!)))
        (dk-have! `(= ,rl ,la) (lambda () (sep-me `(IN ,l ,tset)) (dk-ass!)))
        (dk-cite! 'nn-in-rr l)
        (e4-coef! 'r l)
        ;; (iii) |q_l| = 1, hence n <= l
        (dk-have! `(= (* ,rl ,s0) 1) (lambda () (subst `(= ,rl ,la)) (subst `(= ,s0 ,mu)) (dk-ass!)))
        (dk-have! (e4-dom-hyp 'r 's l 0 1)
          (lambda ()
            (dk-peel!)
            (let* ((ij (e4-goal-ij)) (i (car ij)) (j (cadr ij)) (ri (e4-nr 'r i)) (sj (e4-nr 's j)))
              (e4-coef! 'r i) (e4-coef! 's j)
              (dk-cite! 'nn-in-rr i)
              (dk-have! `(<= ,i ,l) (lambda () (dk-nn!)))
              (e4-and! `(<= ,i ,l) `(NOT (= ,i ,l)))
              (dk-cite! 'rr-le-ne-lt i l)
              (dk-have! `(NOT (= ,ri ,la))
                (lambda ()
                  (di)
                  (dk-have! `(IN ,i ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                  (dk-apply! least i)
                  (dk-absurd! `(<= ,l ,i) `(< ,i ,l))))
              (dk-apply! hr i) (dk-apply! hs j)
              (e4-and! `(<= ,ri ,la) `(NOT (= ,ri ,la)))
              (dk-cite! 'rr-le-ne-lt ri la)
              (dk-cite! 'rr-prod-lt-gen-left ri sj la mu)
              (e4-rr-mul! ri sj)
              (dk-ineq! `(< (* ,ri ,sj) (* ,la ,mu)) `(= (* ,la ,mu) 1)))))
        (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (let* ((h1 (e4-to-q! (dk-cite! 'nv-coef-dominant 'K 'r 's l 0 1))))
          (dk-have! `(= (+ ,l 0) ,l) (lambda () (dk-nn!)))
          (dk-rewrite-h! h1 `(+ ,l 0) l))
        (e4-coef! 'q l)
        (dk-have! `(NOT (< ,l n)) (lambda () (di) (dk-apply! (e4-hq<n) l) (dk-absurd! `(< ,(e4-nr 'q l) 1) `(= ,(e4-nr 'q l) 1))))
        (dk-cite! 'rr-not-lt-ge l 'n)
        ;; (iv) the degrees: l <= deg r, and deg r + deg s <= n
        (e4-nonzero-of-norm! `(r ,l) la)
        (e4-nonzero-of-norm! '(s 0) mu)
        (let* ((al (e4-deg! 'r)) (be (e4-deg! 's)))
