    (imp (NOT (IN (q n) ,(e4-pr 'uw))))))
;; X in Z(K) in context: land X in CARR K and |X| <= 1
(define (e4-int! x)
  (let ((h `(IN ,x ,e4-Z)))
    (dk-have! `(IN ,x (CARR K)) (lambda () (e4-open-sep! 'nv-integers-unfold h) (dk-ass!)))
    (dk-have! `(<= ,(e4-n x) 1) (lambda () (e4-open-sep! 'nv-integers-unfold h) (dk-ass!)))
    (e4-typek! x)))

;; an element of Z(K) dominated by a nonzero g in Z(K) is a multiple of g
(sp (make-wff (e4-build `((all K) (imp (IS-NV-FIELD K)) (all g ,e4-Z) (imp (NOT (= g (ZERO K)))) (all x (CARR K))
                          (imp (<= ,(e4-n 'x) ,(e4-n 'g))))
