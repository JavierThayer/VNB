        (dk-ass!)))))

(sp (make-wff (e4-build (append (e4-eis-q-items)
                                `((all r ,e4-fsupp) (imp ,(e4-int-hyp 'r)) (all s ,e4-fsupp) (imp ,(e4-int-hyp 's))
                                  (imp (= q ,(e4-pm 'r 's)))))
                        `(OR (DEG-BOUND ,e4-view r 0) (DEG-BOUND ,e4-view s 0)))))
(dk-peel!)
(e4-q-conds!)
(e4-int-bound! 'r) (e4-int-bound! 's)
(dk-have! '(= (* ((FNRM K) (ONE K)) ((FNRM K) (ONE K))) 1) (lambda () (subst '(= ((FNRM K) (ONE K)) 1)) (dk-ineq!)))
(dk-cite! 'nv-eisenstein-scaled 'K 'uw 'q 'n 'r 's '(ONE K) '(ONE K))
(dk-ass!)
(qed 'ccr-4-31)

;;; -----------------------------------------------------------------------
;;; 6. Contents: a nonzero polynomial has a coefficient of maximal absolute value; contents are unique.

;; among p_0, ..., p_m one has the largest absolute value (induction on m, K and p fixed)
(sp (make-wff `(FORALL e4m (IMPLIES (IN e4m NN) (FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL p (IMPLIES (IN p (FUN NN (CARR K)))
  (FORSOME e4a_ (AND (IN e4a_ NN) (AND (<= e4a_ e4m)
    (FORALL e4b_ (IMPLIES (IN e4b_ NN) (IMPLIES (<= e4b_ e4m) (<= ((FNRM K) (p e4b_)) ((FNRM K) (p e4a_)))))))))))))))))
(let* ((r (dk-use-induction-fixed! '(K p)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (m (cdr (assq 'var r))))
  (dk-focus! base)
  (fact 'nn-zero-in)
  (ew 0)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (dk-ass!))
            ((dk-head-is? (dk-goal) '<=) (dk-nn!))
            (#t
             (dk-peel!)
             (let ((b (cadr (cadr (cadr (dk-goal))))))
               (dk-have! `(= ,b 0) (lambda () (dk-nn!)))
               (subst `(= ,b 0))
               (dk-cite! 'nv-field-normed 'K)
               (dk-cite! 'fun-apply-type-c 'p 'NN '(CARR K) 0)
               (e4-typek! '(p 0))
               (dk-ineq!))))))
  (dk-focus! step)
  (dk-cite! 'nv-field-normed 'K)
  (let* ((a (dk-skolem! ih))
         (sm `(succ ,m))
         (hmax (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a) (dk-contains? f 'FNRM))) "the max law")))
    (dk-cite! 'nn-succ-closed m)
    (dk-cite! 'fun-apply-type-c 'p 'NN '(CARR K) a)
    (dk-cite! 'fun-apply-type-c 'p 'NN '(CARR K) sm)
    (e4-typek! `(p ,a)) (e4-typek! `(p ,sm))
    (dk-cite! 'nn-in-rr sm)
    (let ((pa (e4-nr 'p a)) (ps (e4-nr 'p sm)))
      (e4-and! `(IN ,ps RR) `(IN ,pa RR))
      (dk-or-each! (dk-cite! 'rr-leq-total ps pa)
        (lambda (o)
          (let ((w (if (equal? o `(<= ,ps ,pa)) a sm)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-asm? (dk-goal)) (dk-ass!))
                      ((dk-head-is? (dk-goal) '<=) (dk-nn!))
                      (#t
                       (dk-peel!)
                       (let* ((b (cadr (cadr (cadr (dk-goal))))))
                         (dk-cite! 'nn-in-rr b)
                         (dk-cite! 'fun-apply-type-c 'p 'NN '(CARR K) b)
                         (e4-typek! `(p ,b))
                         (dk-or-each! (dk-cite! 'nn-le-succ-cases m b)
                           (lambda (c)
                             (if (equal? c `(= ,b ,sm))
                                 (begin (subst `(= ,b ,sm)) (dk-ineq! o))
                                 (begin
                                   (dk-apply! hmax b)
                                   (dk-ineq! `(<= ,(e4-nr 'p b) ,pa) o))))))))))))))))
(qed 'nv-max-coef-ind)

(define (e4-content-ex p) `(FORSOME e4c_ (AND (IN e4c_ NN) (AND (< 0 ,(e4-nr p 'e4c_)) (IS-NV-CONTENT K ,p ,(e4-nr p 'e4c_))))))
(sp (make-wff (e4-build `((all K) (imp (IS-NV-FIELD K)) (all p ,e4-fsupp)
                          (imp (FORSOME e4k_ (AND (IN e4k_ NN) (NOT (= (p e4k_) ,e4-zv))))))
                        (e4-content-ex 'p))))
(dk-peel!)
(e4-setup!)
(e4-poly-setup!)
(e4-poly! 'p)
(let* ((k0 (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the nonzero coefficient")))
       (d (e4-deg! 'p))
       (i0 (dk-skolem! (dk-cite! 'nv-max-coef-ind d 'K 'p)))
       (hmax (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f i0) (dk-contains? f 'FNRM))) "the max law"))
       (pi0 (e4-nr 'p i0)))
  (e4-coef! 'p i0) (e4-coef! 'p k0)
  (dk-cite! 'nn-in-rr k0)
  ;; every coefficient is at most |p i0|
  (let ((bound (e4-hbound 'p pi0)))
    (dk-have! bound
      (lambda ()
        (dk-peel!)
        (let ((b (cadr (cadr (cadr (dk-goal))))))
          (e4-coef! 'p b)
          (dk-cite! 'nn-in-rr b)
          (use-em `(< ,d ,b)
            (lambda () (dk-cite! 'deg-bound-apply e4-view 'p d b) (e4-zero-norm! `(p ,b)) (subst `(= ,(e4-nr 'p b) 0)) (dk-ass!))
            (lambda () (dk-cite! 'rr-not-lt-ge d b) (dk-apply! hmax b) (dk-ass!))))))
    (e4-norm-pos! `(p ,k0))
    (dk-apply! bound k0)
    (ew i0)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (dk-ass!))
              ((dk-head-is? (dk-goal) '<) (dk-ineq! `(< 0 ,(e4-nr 'p k0)) `(<= ,(e4-nr 'p k0) ,pi0)))
              (#t (mac 'is-nv-content)
                  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew i0) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))))))
(qed 'nv-content-exists)

(sp (make-wff (e4-build `((all K) (all p) (all c RR) (all d RR) (imp (IS-NV-CONTENT K p c)) (imp (IS-NV-CONTENT K p d)))
                        '(= c d))))
(dk-peel!)
(let* ((bc (dk-project! (e4-hbound 'p 'c) 'is-nv-content '(IS-NV-CONTENT K p c)))
       (bd (dk-project! (e4-hbound 'p 'd) 'is-nv-content '(IS-NV-CONTENT K p d)))
       (ec (dk-project! `(FORSOME cw3i_ (AND (IN cw3i_ NN) (= ,(e4-nr 'p 'cw3i_) c))) 'is-nv-content '(IS-NV-CONTENT K p c)))
       (ed (dk-project! `(FORSOME cw3i_ (AND (IN cw3i_ NN) (= ,(e4-nr 'p 'cw3i_) d))) 'is-nv-content '(IS-NV-CONTENT K p d)))
       (i (dk-skolem! ec)) (j (dk-skolem! ed)))
  (dk-apply! (e4-hbound 'p 'd) i)
  (dk-apply! (e4-hbound 'p 'c) j)
  (let* ((h1 (dk-rewrite-h! `(<= ,(e4-nr 'p i) d) (e4-nr 'p i) 'c))
         (h2 (dk-rewrite-h! `(<= ,(e4-nr 'p j) c) (e4-nr 'p j) 'd)))
    (dk-ineq! h1 h2 '(IN c RR) '(IN d RR))))
(qed 'nv-content-unique)

;;; -----------------------------------------------------------------------
;;; 7. Corollary 4.32: an Eisenstein polynomial is irreducible in K[x].

(sp (make-wff (e4-build (append (e4-eis-q-items)
                                `((all r ,e4-fsupp) (all s ,e4-fsupp) (imp (= q ,(e4-pm 'r 's)))))
                        `(OR (DEG-BOUND ,e4-view r 0) (DEG-BOUND ,e4-view s 0)))))
(dk-peel!)
(e4-q-conds!)
(e4-poly-setup!)
(e4-poly! 'r) (e4-poly! 's)
;; r and s have nonzero coefficients (else every coefficient of q vanishes)
(for-each
  (lambda (pp)
