;; the hypotheses of 4.31 on q, in absolute values (what nv-eisenstein-scaled takes)
(define (e4-q-conds!)
  (dk-cite! 'nv-field-normed 'K)
  (dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-one 'K) (dk-cite! 'nf-norm-of-zero 'K)
  (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
  (e4-setup!)
  (e4-poly! 'q)
  (e4-int! 'uw)
  (e4-coef! 'q 0) (e4-coef! 'q 'n)
  (dk-apply! (e4-int-hyp 'q) 'n)
  (e4-int! '(q n))
  ;; (q i) in (uw) gives |q i| < 1
  (dk-have! (e4-hq<n)
    (lambda ()
      (dk-peel!)
      (let* ((i (cadr (cadr (cadr (dk-goal)))))
             (h `(IN (q ,i) ,(e4-pr 'uw))))
        (dk-apply! `(FORALL e4i_ (IMPLIES (IN e4i_ NN) (IMPLIES (< e4i_ n) (IN (q e4i_) ,(e4-pr 'uw))))) i)
        (dk-rewrite-h! h (e4-pr 'uw) e4-M)
        (dk-cite! 'nv-maximal-norm 'K e4-Z `(q ,i))
        (dk-ass!))))
  ;; |q n| = 1
  (dk-have! `(NOT (< ,(e4-nr 'q 'n) 1))
    (lambda ()
      (di)
      (dk-have! `(IN (q n) ,e4-M) (lambda () (subst (dk-cite! 'nv-maximal-unfold 'K e4-Z)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (dk-have! `(IN (q n) ,(e4-pr 'uw)) (lambda () (subst `(= ,(e4-pr 'uw) ,e4-M)) (dk-ass!)))
      (ai `(NOT (IN (q n) ,(e4-pr 'uw))))))
  (dk-cite! 'rr-not-lt-ge (e4-nr 'q 'n) 1)
  (e4-antisym! (e4-nr 'q 'n) 1)
  ;; |q 0| > |uw|^2
  (let* ((w2 (e4-mul 'uw 'uw)) (u2 `(* ,(e4-n 'uw) ,(e4-n 'uw))))
    (dk-cite! 'nf-mul-in-carr 'K 'uw 'uw)
    (dk-cite! 'nf-norm-mult 'K 'uw 'uw)
    (e4-typek! w2)
    (e4-rr-mul! (e4-n 'uw) (e4-n 'uw))
    (dk-cite! 'rr-prod-le-one (e4-n 'uw) (e4-n 'uw))
    (dk-have! `(IN ,w2 ,e4-Z) (lambda () (subst (dk-cite! 'nv-integers-unfold 'K)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ineq! `(= ,(e4-n w2) ,u2) `(<= ,u2 1))))))
    (e4-norm-pos-k! 'uw)
    (e4-and! `(IN ,(e4-n 'uw) RR) `(IN ,(e4-n 'uw) RR))
    (dk-cite! 'rr-mul-pos (e4-n 'uw) (e4-n 'uw))
    (dk-have! `(NOT (= ,w2 (ZERO K)))
      (lambda ()
        (di)
        (dk-absurd! (dk-rewrite-h! (dk-rewrite-h! `(= ,(e4-n w2) ,u2) w2 '(ZERO K)) '((FNRM K) (ZERO K)) 0) `(< 0 ,u2))))
    (dk-have! `(NOT (<= ,(e4-nr 'q 0) ,u2))
      (lambda ()
        (di)
        (dk-have! `(<= ,(e4-nr 'q 0) ,(e4-n w2)) (lambda () (dk-ineq! `(<= ,(e4-nr 'q 0) ,u2) `(= ,(e4-n w2) ,u2))))
        (dk-cite! 'nv-principal-of-norm 'K w2 '(q 0))
        (ai `(NOT (IN (q 0) ,(e4-pr w2))))))))
;; coefficients in Z(K): the bound by |ONE K|
(define (e4-int-bound! p)
  (dk-have! (e4-hbound p `((FNRM K) (ONE K)))
    (lambda ()
      (dk-peel!)
