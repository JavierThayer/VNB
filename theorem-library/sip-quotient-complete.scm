;;; sip-quotient-complete.scm -- lemmas MOVED 2026-10-30 (wave-2 integration) out of theorem-library/l2-hilbert.scm
;;; into library analysis, for the library gate: cited by real-riesz (analysis); a semi-inner-product-space fact.
;;; The proofs are the originals, verbatim; the helper defines are a copy of the source's.
;;;   sip-quotient-complete

(dk-skip-links!)   ; as in the source file

;;; ---- helper defines copied from l2-hilbert.scm ----
(define (mlh-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MLH OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mlh-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mlh-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mlh-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mlh-has-lam? (car l)) (loop (cdr l))))))))
(define (mlh-beta!) (if (mlh-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mlh-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (mlh-pos-of fs) (find-first (lambda (h) (dk-head-is? h 'POS-RR)) fs))
(define (mlh-vd a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (mlh-nv a b) (list 'SQRT (list '(RIP v) (mlh-vd a b) (mlh-vd a b))))
(define mlh-sc
  (list 'FORALL 's (list 'IMPLIES '(IN s (FUN NN (VEC v)))
    (list 'IMPLIES
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
        (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'q (list 'IMPLIES '(IN q NN)
          (list 'IMPLIES '(<= nb m) (list 'IMPLIES '(<= nb q) (list '<= (mlh-nv '(s m) '(s q)) 'eps)))))))))))
      (list 'FORSOME 'a (list 'AND '(IN a (VEC v))
        (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
          (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= nb n_) (list '<= (mlh-nv '(s n_) 'a) 'eps))))))))))))))
(define mlh-Q '(SIP-QUOTIENT v))
(define mlh-S '(SIP-SETOID v))
(define mlh-M '(SIP-METRIC-SPACE (SIP-QUOTIENT v)))
(define (mlh-cl a) (list 'CLASS mlh-S a))
(define (mlh-vt! x)                    ; type a vector expression of v by citation
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (mlh-vt! (cadr x)) (mlh-vt! (caddr x))
           (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (mlh-vt! (cadr x))
           (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          (#t (error "mlh-vt!: cannot type" (expression->string x))))))
(define (mlh-nv-typed! a b)            ; nv(a,b) real nonneg
  (let ((d (mlh-vd a b)))
    (mlh-vt! d)
    (dk-cite! 'sip-rip-type 'v d d)
    (dk-cite! 'sip-rip-self-nonneg 'v d)
    (mlh-and! (list 'IN (list '(RIP v) d d) 'RR) (list '<= 0 (list '(RIP v) d d)))
    (mlh-split! (dk-cite! 'sqrt-nonneg (list '(RIP v) d d)))))
(define (mlh-dist! a b)                ; a, b in VEC v: (= (DIST M (CLASS a) (CLASS b)) nv(a,b))
  (let* ((ca (mlh-cl a)) (cb (mlh-cl b)) (nb (list '(VNEG v) b)) (d (mlh-vd a b))
         (e (list '= (list (list 'DIST mlh-M) ca cb) (mlh-nv a b))))
    (if (not (dk-asm? e))
        (begin
          (mlh-vt! d)
          (mlh-nv-typed! a b)
          (for-each (lambda (t) (if (not (dk-asm? (list 'IN (mlh-cl t) (list 'VEC mlh-Q))))
                                    (begin (mlh-vt! t)
                                           (if (not (dk-asm? (list 'IN t (list 'PTS mlh-S))))
                                               (dk-have! (list 'IN t (list 'PTS mlh-S)) (lambda () (subst (list '== (list 'PTS mlh-S) '(VEC v))) (dk-ass!))))
                                           (dk-cite! 'class-in-quotient mlh-S t)
                                           (dk-have! (list 'IN (mlh-cl t) (list 'VEC mlh-Q)) (lambda () (subst (list '== (list 'VEC mlh-Q) (list 'QUOTIENT mlh-S))) (dk-ass!))))))
                    (list a b d))
          (dk-cite! 'sip-metric-space-dist mlh-Q ca cb)
          (dk-cite! 'sipq-vneg-computes 'v b)
          (dk-cite! 'sipq-vadd-computes 'v a nb)
          (dk-cite! 'sipq-rip-computes 'v d d)
          (dk-have! e
            (lambda ()
              (subst (list '= (list (list 'DIST mlh-M) ca cb)
                           (list 'SQRT (list (list 'RIP mlh-Q) (list (list 'VADD mlh-Q) ca (list (list 'VNEG mlh-Q) cb))
                                                               (list (list 'VADD mlh-Q) ca (list (list 'VNEG mlh-Q) cb))))))
              (subst (list '= (list (list 'VNEG mlh-Q) cb) (mlh-cl nb)))
              (subst (list '= (list (list 'VADD mlh-Q) ca (mlh-cl nb)) (mlh-cl d)))
              (subst (list '= (list (list 'RIP mlh-Q) (mlh-cl d) (mlh-cl d)) (list '(RIP v) d d)))
              (if (mlh-open?) (rfl))))))
    e))
(define (mlh-tsub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (u) (mlh-tsub x y u)) t)) (#t t)))
(define (mlh-sc-cauchy sq) (mlh-tsub 's sq (cadr (caddr (caddr mlh-sc)))))
(define (mlh-sc-conv sq a) (mlh-tsub 'a a (mlh-tsub 's sq (caddr (caddr (caddr (caddr (caddr mlh-sc))))))))
(define (mlh-main! fq)
  (let* ((pm (list 'PTS mlh-M)) (vq (list 'VEC mlh-Q)) (qs (list 'QUOTIENT mlh-S))
         (dm (list 'DIST mlh-M))
         (cyf (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'N (list 'AND '(IN N NN)
                (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                  (list 'IMPLIES '(AND (<= N m) (<= N n_)) (list '<= (list dm (list fq 'm) (list fq 'n_)) 'eps)))))))))))
         (fam (list 'VNB-LAMBDA 'rqk_ 'NN (list 'SEP 'rqa_ '(VEC v) (list '= (list fq 'rqk_) (mlh-cl 'rqa_)))))
         (famk (lambda (k) (list 'SEP 'rqa_ '(VEC v) (list '= (list fq k) (mlh-cl 'rqa_)))))
         (fam-at! (lambda (k)
                    (let ((e (list '= (list fam k) (famk k))))
                      (if (not (dk-asm? e))
                          (dk-have! e (lambda ()
                                        (dk-have! (list 'IN (famk k) 'SET) (lambda () (dk-sethood! (famk k))))
                                        (mlh-beta!) (if (mlh-open?) (rfl)))))
                      e))))
    (dk-project! (list 'IN fq (list 'FUN 'NN pm)) 'is-cauchy-seq (list 'IS-CAUCHY-SEQ mlh-M fq))
    (dk-rewrite-h! (list 'IN fq (list 'FUN 'NN pm)) pm vq)
    (dk-rewrite-h! (list 'IN fq (list 'FUN 'NN vq)) vq qs)
    (dk-project! cyf 'is-cauchy-seq (list 'IS-CAUCHY-SEQ mlh-M fq))
    (let ((ch (dk-fact! 'rmm-nn-choice '(VEC v) fam)))
      (dk-have! (cadr ch)
        (lambda ()
          (let* ((k (dk-di-var!)))
            (dk-cite! 'fun-apply-type-c fq 'NN qs k)
            (let* ((qr (dk-cite! 'quotient-rep mlh-S (list fq k)))
                   (a (dk-skolem! qr #t)))
              (dk-rewrite-h! (list 'IN a (list 'PTS mlh-S)) (list 'PTS mlh-S) '(VEC v))
              (ew a)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (subst (fam-at! k))
                             (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))))))
      (detach! ch)
      (let* ((sq (dk-skolem! (caddr ch) #t))
             (prop (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sq))) "the choice property"))
             (rep-at! (lambda (k)
                        (dk-cite! 'fun-apply-type-c sq 'NN '(VEC v) k)
                        (let ((e (list '= (list fq k) (mlh-cl (list sq k)))))
                          (if (not (dk-asm? e))
                              (let ((m (dk-apply! prop k)))
                                (fam-at! k)
                                (dk-rewrite-h! m (list fam k) (famk k))
                                (sep-me (dk-ctx-form (list 'IN (list sq k) (famk k))))
                                (dk-split-all!)))
                          e))))
        ;; sq is Cauchy for the seminorm
        (dk-have! (mlh-sc-cauchy sq)
          (lambda ()
            (let* ((ld (begin (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)) (dk-asms))) (eps (cadr (mlh-pos-of ld))))
              (let* ((nN (dk-skolem! (dk-apply! (dk-ctx-form cyf) eps) #t))
                     (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nN) (dk-contains? f eps))) "the Cauchy tail")))
                (ew nN)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((ld2 (dk-peel!))
                               (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))
                               (m (cadr (car ins))) (q (cadr (cadr ins))))
                          (rep-at! m) (rep-at! q)
                          (mlh-and! (list '<= nN m) (list '<= nN q))
                          (let* ((h (dk-apply! tl m q))
                                 (h1 (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (list fq m) (list fq q)) eps)) (list fq m) (mlh-cl (list sq m))))
                                 (h2 (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (mlh-cl (list sq m)) (list fq q)) eps)) (list fq q) (mlh-cl (list sq q)))))
                            (mlh-dist! (list sq m) (list sq q))
                            (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (mlh-cl (list sq m)) (mlh-cl (list sq q))) eps))
                                           (list dm (mlh-cl (list sq m)) (mlh-cl (list sq q))) (mlh-nv (list sq m) (list sq q)))
                            (dk-ass!))))))))))
        (let* ((cv (dk-apply! (dk-ctx-form mlh-sc) sq))
               (ex (dk-ctx-form (mlh-tsub 's sq (caddr (caddr (caddr mlh-sc))))))
               (a (dk-skolem! ex #t))
               (cva (dk-ctx-form (mlh-sc-conv sq a)))
               (lq (mlh-cl a)))
          (mac 'CONVERGES)
          (ew lq)
          (mac 'CONVERGES-TO)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-head-is? g 'IN)
                       (dk-have! (list 'IN a (list 'PTS mlh-S)) (lambda () (subst (list '== (list 'PTS mlh-S) '(VEC v))) (dk-ass!)))
                       (dk-cite! 'class-in-quotient mlh-S a)
                       (subst (list '== pm vq)) (subst (list '== vq qs)) (dk-ass!))
                      (#t
                       (let* ((ld (dk-peel!)) (eps (cadr (mlh-pos-of (append ld (dk-asms))))))
                         (let* ((nb (dk-skolem! (dk-apply! cva eps) #t))
                                (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f eps))) "the conv tail")))
                           (ew nb)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (let* ((ld2 (dk-peel!)) (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))))
                                     (rep-at! n)
                                     (dk-apply! tl n)
                                     (mlh-dist! (list sq n) a)
                                     (subst (list '= (list fq n) (mlh-cl (list sq n))))
                                     (subst (list '= (list dm (mlh-cl (list sq n)) lq) (mlh-nv (list sq n) a)))
                                     (dk-ass!))))))))))))))))))

;;; ---- the moved proofs ----
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list 'IMPLIES mlh-sc '(IS-REAL-HILBERT-SPACE (SIP-QUOTIENT v)))))))
(dk-peel!)
(fact 'nn-is-set) (fact 'rr-zero-in)
(fact 'sip-scal-pin 'v)
(dk-cite! 'sip-quotient-is-pre-hilbert 'v)
(dk-cite! 'sip-metric-space-is-metric-space mlh-Q)
(dk-cite! 'sip-metric-space-pts mlh-Q)
(dk-cite! 'sipq-vec 'v)
(dk-cite! 'sip-setoid-is-setoid 'v)
(dk-cite! 'sip-setoid-pts 'v)
(dk-cite! 'sip-vec-set 'v)
(mac 'IS-REAL-HILBERT-SPACE)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (mac 'IS-COMPLETE)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let* ((ld (dk-peel!)) (ch (find-first (lambda (h) (dk-head-is? h 'IS-CAUCHY-SEQ)) ld)) (fq (caddr ch)))
                    (mlh-main! fq)))))))))
(mlh-qed! 'sip-quotient-complete)

