;;; sip-d1.scm -- REAL HILBERT SPACES BY THE COMPLEXIFICATION ROUTE: the norm and metric of
;;; a pre-Hilbert space, completeness of the complexification, the orthogonal projection onto
;;; a closed subspace, and the complex corollary.  (SIP-D, 2026-10-19;
;;; scratchpad/triage/SIP-D.md.)  All PROVEN modulo 0.  Vocabulary:
;;; structure-library/sip-hilbert-vocab.scm.
;;;
;;; Source: the user's notes topological-vector-space.pdf, Ch. 1 s.3: Proposition 1.19 (the
;;; norm), (23) (a Hilbert space is a pre-Hilbert space complete in that norm), Proposition
;;; 1.20 (the closest point), the projection E_K used in Proposition 1.27; s.3.1 (a complex
;;; space is a real one with J).
;;;
;;; THE ROUTE (the user's decision, 2026-10-19: REUSE, do not re-run the parallelogram /
;;; minimizing-sequence argument).  For a real Hilbert space v, w = CSIP-CIPS(COMPLEXIFY(v))
;;; is a complex Hilbert space: its vectors are pairs, its form is
;;; <p, q>_w = (<p1,q1> + <p2,q2>) - i (<-p2,q1> + <p1,q2>), its squared distance is the sum
;;; of the squared distances of the components, so a Cauchy sequence of pairs has Cauchy
;;; components and converges to the pair of their limits.  A closed real subspace M gives the
;;; closed COMPLEX subspace M x M of w (J(m1, m2) = (-m2, m1) stays in it); the complex
;;; projection theorem (theorem-library/hilbert-projection.scm, hilbert-projection-point) at
;;; (x, 0) gives (a1, a2) in M x M with (x, 0) - (a1, a2) orthogonal to M x M, and the real
;;; part of that orthogonality against (m, 0) says x - a1 is orthogonal to m.  So the real
;;; decomposition comes out of the complex one; uniqueness, linearity, idempotence and the
;;; closest-point property are then short real algebra (the EXPANSION device of
;;; hilbert-projection.scm, on the real form).
;;;
;;; THE CLOSED CONVEX CASE (the notes' Proposition 1.20 as stated) is the last section, spliced
;;; 2026-10-20 from sip-d2.scm (SIP-D2): the general closest-point theorem of
;;; hilbert-projection.scm (hilbert-closest-point-midpoint, a nonempty closed set closed under
;;; midpoints) at (x, 0) on cs x cs, then the variational inequality, necessary and sufficient.
;;; Section (12) has uniqueness for a convex set and the sufficient condition.
;;;
;;; Helper prefix: sipd-.
;;;
;;; LOAD WINDOW: after theorem-library/sip-b (COMPLEXIFY, CSIP-CIPS and their laws) and
;;; structure-library/sip-hilbert-vocab; latest citation outside the SIP files:
;;; theorem-library/hilbert-projection (hilbert-projection-point, ip-metric-space-*), which is
;;; before the SIP block.  Nothing cites this file.  Library: analysis.

;;; the peel's landings, set by the proofs that read their hypotheses off it.  Defined HERE,
;;; outside every proof: a certified load skips a proof's forms, and a later (set! ...) of a
;;; name defined inside a skipped proof is an unbound-variable error (met 2026-10-20).
(define sipd-lk0 #f)

(define (sipd-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** sip-d1: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "sip-d1: unfinished" name))))

;;; ==========================================================================================
;;; THE EXPANSION KIT on the real form (the `hpr-' device of hilbert-projection.scm, real case:
;;; no conjugation; symmetry instead).
;;; ==========================================================================================
(define (sipd-pin!) (if (not (dk-asm? '(= (SCAL v) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))))
                        (fact 'sip-scal-pin 'v)))
(define (sipd-op? e op) (and (pair? e) (equal? (car e) (list op 'v))))
(define (sipd-sub a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (sipd-add a b) (list '(VADD v) a b))
(define (sipd-act c a) (list '(ACT v) c a))
(define (sipd-ip a b) (list '(RIP v) a b))
(define (sipd-q a) (sipd-ip a a))
(define (sipd-qd a b) (sipd-q (sipd-sub a b)))
;;; type a vector expression (VADD / VNEG / VZERO / ACT at a real scalar) by citation
(define (sipd-vt x)
  (let ((want (list 'IN x '(VEC v))))
    ;; the PARTS are typed even when X itself is in context: the laws want them
    (cond ((sipd-op? x 'VADD) (sipd-vt (cadr x)) (sipd-vt (caddr x)))
          ((sipd-op? x 'VNEG) (sipd-vt (cadr x)))
          ((sipd-op? x 'ACT) (sipd-pin!) (sipd-vt (caddr x)) (dk-real! (cadr x))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module 'v) x)
          ((sipd-op? x 'VADD) (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((sipd-op? x 'VNEG) (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          ((sipd-op? x 'ACT) (dk-cite! 'hbs-act-in-sip-as-module 'v (cadr x) (caddr x)) x)
          (#t (error "sipd-vt: cannot type" (expression->string x))))))
(define (sipd-ft x y) (sipd-vt x) (sipd-vt y) (dk-cite! 'sip-rip-type 'v x y))
(define (sipd-compound? e) (or (sipd-op? e 'VADD) (sipd-op? e 'VNEG) (sipd-op? e 'ACT) (equal? e '(VZERO v))))
(define (sipd-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (sipd-op? e 'RIP) (= (length e) 3) (or (sipd-compound? (cadr e)) (sipd-compound? (caddr e)))) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((sipd-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (sipd-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (sipd-vt a) (sipd-vt b)
    (cond ((sipd-op? a 'VADD) (dk-cite! 'sip-rip-add-left 'v (cadr a) (caddr a) b))
          ((sipd-op? a 'VNEG) (dk-cite! 'sip-rip-neg-left 'v (cadr a) b))
          ((sipd-op? a 'ACT)  (dk-real! (cadr a)) (dk-cite! 'sip-rip-homog-left 'v (cadr a) (caddr a) b))
          ((equal? a '(VZERO v)) (dk-cite! 'sip-rip-zero-left 'v b))
          ((sipd-op? b 'VADD) (dk-cite! 'sip-rip-add-right 'v a (cadr b) (caddr b)))
          ((sipd-op? b 'VNEG) (dk-cite! 'sip-rip-neg-right 'v a (cadr b)))
          ((sipd-op? b 'ACT)  (dk-real! (cadr b)) (dk-cite! 'sip-rip-homog-right 'v (cadr b) a (caddr b)))
          ((equal? b '(VZERO v)) (dk-cite! 'sip-rip-zero-right 'v a))
          (#t (error "sipd-open-law!: not a redex" (expression->string r))))))
;;; the form atoms <a, b> of an expression
(define (sipd-atoms e)
  (cond ((not (pair? e)) '())
        ((and (sipd-op? e 'RIP) (= (length e) 3)) (list e))
        (#t (append-map sipd-atoms (if (list? e) e '())))))
;;; every <b, a> with <a, b> also present (a, b distinct) rewritten to <a, b>; every atom typed
(define (sipd-symmetrize!)
  (let loop ((done '()))
    (let* ((ats (sipd-atoms (dk-goal)))
           (hit (find-first (lambda (t)
                              (let ((rev (sipd-ip (caddr t) (cadr t))))
                                (and (not (equal? (cadr t) (caddr t)))
                                     (member rev ats)
                                     (not (member rev done)))))
                            ats)))
      (if hit
          (let ((rev (sipd-ip (caddr hit) (cadr hit))))
            (sipd-ft (cadr hit) (caddr hit))
            (dk-cite! 'sip-rip-sym 'v (cadr hit) (caddr hit))
            (subst (list '= rev hit))
            (loop (cons hit done))))))
  (for-each (lambda (t) (sipd-ft (cadr t) (caddr t))) (sipd-atoms (dk-goal))))
;;; EXPAND the goal: open every form value at a constructed vector, then symmetrize.
(define (sipd-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "sipd-expand!: out of fuel"))
    (let ((r (sipd-find-redex (dk-goal))))
      (if r
          (begin (subst (sipd-open-law! r)) (loop (- fuel 1)))
          (sipd-symmetrize!)))))
;;; an identity between form values, by expansion and crs
(define (sipd-ip-eq! goal)
  (if (not (dk-asm? goal))
      (dk-have! goal (lambda () (sipd-expand!) (if (not (proof-done? *ps*)) (crs)))))
  goal)
;;; a VECTOR identity A = B in a pre-Hilbert space (PHS and SIP of v in context):
;;; <A - B, A - B> = 0 by expansion, then definiteness, then A - B = 0 gives A = B.
(define (sipd-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (let ((d (sipd-sub a b)))
          (sipd-vt a) (sipd-vt b) (sipd-vt d)
          (sipd-ip-eq! (list '= (sipd-q d) 0))
          (dk-cite! 'phs-definite 'v d)
          (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v a b)))
    goal))
;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (sipd-and fs) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (sipd-and (cdr fs)))))
(define (sipd-have-and! . fs)
  (let ((c (sipd-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))
;;; an IFF instance used forwards / backwards (hilbert-projection.scm's hpr-iff-fwd! / -bwd!)
(define (sipd-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (sipd-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
;;; with (IN q RR), (<= 0 q) in context: (IN (SQRT q) RR), (<= 0 (SQRT q)), SQRT(q)^2 = q
(define (sipd-sqrt! q)
  (if (not (dk-asm? (list 'IN (list 'SQRT q) 'RR)))
      (begin
        (sipd-have-and! (list 'IN q 'RR) (list '<= 0 q))
        (dk-split! (dk-cite! 'sqrt-nonneg q))
        (dk-cite! 'sqrt-sq q)))
  (list 'SQRT q))
;;; <u, u> typed, nonnegative, and its square root's facts
(define (sipd-q-facts! u)
  (sipd-ft u u)
  (dk-cite! 'sip-rip-self-nonneg 'v u)
  (sipd-sqrt! (sipd-q u)))

;;; ==========================================================================================
;;; (1) <-x, -x> = <x, x>, and MINKOWSKI for a semidefinite form (Proposition 1.19).
;;; ==========================================================================================
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((RIP v) ((VNEG v) x_) ((VNEG v) x_)) ((RIP v) x_ x_))))))))
(dk-peel!)
(sipd-expand!)
(crs)
(sipd-qed! 'sip-rip-neg-self)

;;; ||x + y|| <= ||x|| + ||y||, the notes' proof of Proposition 1.19: with s = ||x||, t = ||y||,
;;; <x,y> <= s t by Cauchy-Schwarz (sip-schwarz: <x,y>^2 <= <x,x><y,y>, and the square root of
;;; both sides), so <x+y, x+y> = <x,x> + 2<x,y> + <y,y> <= (s + t)^2.
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (<= (SQRT ((RIP v) ((VADD v) x_ y_) ((VADD v) x_ y_)))
        (+ (SQRT ((RIP v) x_ x_)) (SQRT ((RIP v) y_ y_))))))))))))
(dk-peel!)
(sipd-pin!)
(let* ((xy '((VADD v) x_ y_))
       (a (sipd-q 'x_)) (c (sipd-q 'y_)) (b (sipd-ip 'x_ 'y_)) (q (sipd-q xy)))
  (sipd-q-facts! 'x_) (sipd-q-facts! 'y_) (sipd-q-facts! xy)
  (sipd-ft 'x_ 'y_)
  (let* ((s (dk-name! (list 'SQRT a)))
         (tt (dk-name! (list 'SQRT c)))
         (ss (dk-rewrite-h! (list '= (list '* (list 'SQRT a) (list 'SQRT a)) a) (list 'SQRT a) s))
         (tq (dk-rewrite-h! (list '= (list '* (list 'SQRT c) (list 'SQRT c)) c) (list 'SQRT c) tt))
         (s0 (dk-rewrite-h! (list '<= 0 (list 'SQRT a)) (list 'SQRT a) s))
         (t0 (dk-rewrite-h! (list '<= 0 (list 'SQRT c)) (list 'SQRT c) tt))
         (st (list '* s tt))
         (bb (list '* b b))
         (pp (list '* st st)))
    (dk-real! st) (dk-real! bb) (dk-real! pp)
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    ;; 0 <= s t
    (dk-cite! 'rr-mul-le-right 0 s tt)
    (dk-have! (list '<= 0 st) (lambda () (dk-ineq! (list '<= (list '* 0 tt) st))))
    ;; b b <= (s t)(s t), by Cauchy-Schwarz
    (let ((cs (dk-cite! 'sip-schwarz 'v 'x_ 'y_)))
      (dk-have! (list '= pp (list '* a c))
        (lambda () (subst (list '= a (list '* s s))) (subst (list '= c (list '* tt tt))) (crs)))
      (dk-have! (list '<= bb pp)
        (lambda () (subst (list '= pp (list '* a c))) (ass))))
    ;; hence b <= s t
    (dk-cite! 'rr-sq-nonneg b)
    (sipd-have-and! (list 'IN bb 'RR) (list '<= 0 bb))
    (sipd-have-and! (list 'IN pp 'RR) (list '<= bb pp))
    (dk-cite! 'sqrt-mono bb pp)
    (let ((e1 (dk-cite! 'sqrt-of-sq b))
          (e2 (dk-cite! 'sqrt-of-sq st)))
      (dk-cite! 'rr-abs-of-nonneg st)
      (dk-cite! 'rr-le-abs b)
      (dk-cite! 'rr-abs-nonneg b)
      (dk-cite! 'rr-abs-closed b)
      (dk-cite! 'rr-abs-closed st)
      (dk-have! (list '<= b st)
        (lambda ()
          (let ((m (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'SQRT bb) (list 'SQRT pp)) (list 'SQRT bb) (list 'abs b))
                                  (list 'SQRT pp) (list 'abs st))))
            (dk-ineq! (list '<= b (list 'abs b)) m (list '= (list 'abs st) st))))))
    ;; <x+y,x+y> = a + 2b + c
    (sipd-ip-eq! (list '= q (list '+ (list '+ a (list '* 2 b)) c)))
    ;; u = (s + t)^2 >= q, the products NAMED so that ineq sees a linear problem
    (let* ((spt (list '+ s tt))
           (uu (begin (dk-real! spt) (dk-real! (list '* spt spt)) (dk-name! (list '* spt spt))))
           (stn (dk-name! st))
           (bst (dk-rewrite-h! (list '<= b st) st stn))
           (ue (list '= uu (list '+ (list '+ a (list '* 2 stn)) c))))
      (dk-have! ue
        (lambda () (subst (list '= uu (list '* spt spt))) (subst (list '= stn st))
                   (subst (list '= a (list '* s s))) (subst (list '= c (list '* tt tt))) (crs)))
      (dk-have! (list '<= q uu)
        (lambda () (dk-ineq! (list '= q (list '+ (list '+ a (list '* 2 b)) c)) bst ue)))
      (dk-have! (list '<= 0 uu) (lambda () (dk-ineq! (list '<= 0 q) (list '<= q uu))))
      (dk-have! (list '<= 0 spt) (lambda () (dk-ineq! s0 t0)))
      (sipd-have-and! (list 'IN q 'RR) (list '<= 0 q))
      (sipd-have-and! (list 'IN uu 'RR) (list '<= q uu))
      (dk-cite! 'sqrt-mono q uu)
      (sipd-have-and! (list 'IN uu 'RR) (list '<= 0 uu))
      (sipd-have-and! (list 'IN spt 'RR) (list '<= 0 spt))
      (dk-have! (list '= (list '* spt spt) uu) (lambda () (subst (list '= uu (list '* spt spt))) (if (not (proof-done? *ps*)) (rfl))))
      (dk-cite! 'sqrt-char uu spt)
      (subst (list '= (list 'SQRT a) s))
      (subst (list '= (list 'SQRT c) tt))
      (dk-rewrite-h! (list '<= (list 'SQRT q) (list 'SQRT uu)) (list 'SQRT uu) spt)
      (ass))))
(sipd-qed! 'sip-minkowski)
(alias! 'sip-minkowski "the triangle inequality for the seminorm of a positive semidefinite form (Proposition 1.19)")

