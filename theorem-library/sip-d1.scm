(sp (make-wff '(FORALL v (FORALL ks (FORALL z_ (FORALL k_
   (IMPLIES (IN z_ (SIP-PERP v ks)) (IMPLIES (IN k_ ks) (= ((RIP v) z_ k_) 0)))))))))
