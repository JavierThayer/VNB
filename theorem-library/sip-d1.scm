      (dk-have! ue
        (lambda () (subst (list '= uu (list '* spt spt))) (subst (list '= stn st))
                   (subst (list '= q1 (list '* s s))) (subst (list '= q2 (list '* tt tt))) (crs)))
      (dk-have! (list '<= qs uu) (lambda () (dk-ineq! ue (list '<= 0 stn))))
      (dk-have! (list '<= 0 uu) (lambda () (dk-ineq! (list '<= 0 qs) (list '<= qs uu))))
