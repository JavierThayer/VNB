;;; THE PACKAGING: IS-NORMED-AG of the LIST tuple (the r6e drive of rake-ip-normed-ag.scm).
(define (sipd-open)
  (filter (lambda (s) (and (not (sequent-node-grounded? s)) (null? (sequent-node-in-arrows s))))
          (dg-ungrounded-nodes (proof-state-dg *ps*))))
(define (sipd-type-redex-args! e)
  (if (and (pair? e) (list? e))
      (begin
        (if (and (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA) (= (length e) 2) (sipd-compound? (cadr e)))
            (sipd-vt (cadr e)))
        (for-each sipd-type-redex-args! e))))
(define (sipd-beta!) (if (dk--redex? (dk-goal)) (begin (sipd-type-redex-args! (dk-goal)) (dk-lam-b!))))
(define (sipd-sqrt-arg e) (and (pair? e) (eq? (car e) 'SQRT) (cadr e)))
(define (sipd-nag-close!)
  (let ((g (dk-goal)))
    (cond
     ((dk-asm? g) (ass))
     ((and (eq? (car g) 'IN) (equal? (caddr g) '(VEC v))) (sipd-vt (cadr g)) (ass))
     ((and (eq? (car g) '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH)) (len-r) (if (not (proof-done? *ps*)) (arith)))
     ((and (eq? (car g) 'IN) (pair? (cadr g)) (eq? (car (cadr g)) 'VNB-LAMBDA)) (lam-t))
     ((and (eq? (car g) 'IN) (equal? (caddr g) 'RR) (sipd-sqrt-arg (cadr g)))
      (sipd-q-facts! (cadr (sipd-sqrt-arg (cadr g)))) (ass))
     ((eq? (car g) 'is-group-norm) (mac 'is-group-norm))
     ((and (eq? (car g) '<=) (equal? (cadr g) 0))
      (sipd-q-facts! (cadr (sipd-sqrt-arg (caddr g)))) (ass))
     ((eq? (car g) '<=)
      (let ((s (cadr (sipd-sqrt-arg (cadr g)))))
        (dk-cite! 'sip-minkowski 'v (cadr s) (caddr s)) (ass)))
     ((and (eq? (car g) '=) (equal? (caddr g) '(VZERO v)))
      ;; ||u|| = 0 => u = 0: <u,u> = ||u||^2 = 0, definiteness
      (let* ((u (cadr g))
             (h (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) 0) (dk--redex? (cadr f)))) (dk-asms))))
        (if h (dk-lam-b-h! h))
        (sipd-q-facts! u)
        (dk-have! (list '= (sipd-q u) 0)
          (lambda ()
            (subst (list '= (sipd-q u) (list '* (list 'SQRT (sipd-q u)) (list 'SQRT (sipd-q u)))))
            (subst (list '= (list 'SQRT (sipd-q u)) 0))
            (crs)))
        (dk-cite! 'phs-definite 'v u)
        (ass)))
     ((and (eq? (car g) '=) (equal? (caddr g) 0))
      ;; u = 0 => ||u|| = 0
      (let ((u (cadr (cadr (cadr g)))))
        (subst (list '= u '(VZERO v)))
        (sipd-vt '(VZERO v))
        (dk-cite! 'sip-rip-zero-left 'v '(VZERO v))
        (subst (list '= (sipd-q '(VZERO v)) 0))
        (dk-have! '(AND (IN 0 RR) (<= 0 0)) (lambda () (arith)))
        (dk-have! '(= (* 0 0) 0) (lambda () (arith)))
        (dk-cite! 'sqrt-char 0 0)
        (ass)))
     ((eq? (car g) '=)
      ;; ||-u|| = ||u||
      (let ((u (cadr (sipd-sqrt-arg (caddr g)))))
        (dk-cite! 'sip-rip-neg-self 'v u)
        (sipd-q-facts! u)
        (subst (list '= (sipd-q (list '(VNEG v) u)) (sipd-q u)))
        (if (not (proof-done? *ps*)) (rfl))))
     (#t (error "sipd-nag-close!: unexpected leaf" (expression->string g))))))
(define (sipd-nag-drive!)
  (let loop ((fuel 400) (prev #f))
    (let ((s (find-first (lambda (s) #t) (sipd-open))))
      (cond ((not s) #t)
            ((<= fuel 0) (error "sipd-nag-drive!: out of fuel"))
            (#t
             (dk-focus! s)
             (let ((mark (cons s (dk-goal))))
               (if (equal? mark prev) (error "sipd-nag-drive!: no progress on" (expression->string (dk-goal))))
               (if (memq (car (dk-goal)) '(FORALL IMPLIES AND IFF))
                   (di)
                   (begin (sipd-beta!) (if (not (sequent-node-grounded? s)) (sipd-nag-close!))))
               (loop (- fuel 1) mark)))))))

(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v) (IS-NORMED-AG (SIP-NORMED-AG v))))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(for-each (lambda (n) (fact n 'v))
  '(sip-vec-set sip-vadd-fun sip-vzero-in sip-vneg-fun sip-vadd-assoc-prop sip-vadd-identity-prop
    sip-vadd-inverses-prop sip-vadd-comm-prop))
(mac 'SIP-NORMED-AG)
(mac 'IS-NORMED-AG)
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(slot 'NRM)
(let loop ((n 0))
  (let ((before (dk-goal)))
    (quietly (lambda () (nth-r)))
    (if (and (< n 12) (not (equal? before (dk-goal)))) (loop (+ n 1)))))
(sipd-nag-drive!)
(sipd-qed! 'sip-normed-ag-is-normed-ag)
(alias! 'sip-normed-ag-is-normed-ag "the norm of a pre-Hilbert space is a group norm (Proposition 1.19)")

(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v) (IS-METRIC-SPACE (SIP-METRIC-SPACE v))))))
(dk-peel!)
(fact 'sip-normed-ag-is-normed-ag 'v)
(fact 'nag-metric-space-is-metric-space '(SIP-NORMED-AG v))
(subst (dk-cite! 'sip-metric-space-unfold 'v))
(ass)
(sipd-qed! 'sip-metric-space-is-metric-space)

(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v) (== (PTS (SIP-METRIC-SPACE v)) (VEC v))))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(fact 'sip-normed-ag-is-normed-ag 'v)
(subst (dk-cite! 'sip-metric-space-unfold 'v))
(subst (dk-cite! 'nag-metric-carrier '(SIP-NORMED-AG v)))
(subst (dk-cite! 'sip-normed-ag-carrier 'v))
(qrfl)
(sipd-qed! 'sip-metric-space-pts)

;;; d(x, y) = SQRT(<x - y, x - y>)
(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((DIST (SIP-METRIC-SPACE v)) x_ y_)
       (SQRT ((RIP v) ((VADD v) x_ ((VNEG v) y_)) ((VADD v) x_ ((VNEG v) y_)))))))))))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-vt (sipd-sub 'x_ 'y_))
(fact 'sip-normed-ag-is-normed-ag 'v)
(dk-cite! 'sip-normed-ag-carrier 'v)
(dk-rewrite-h! '(IN x_ (VEC v)) '(VEC v) '(CARR (SIP-NORMED-AG v)))
(dk-rewrite-h! '(IN y_ (VEC v)) '(VEC v) '(CARR (SIP-NORMED-AG v)))
(subst (dk-cite! 'sip-metric-space-unfold 'v))
(subst (dk-cite! 'nag-metric-distance '(SIP-NORMED-AG v) 'x_ 'y_))
(subst (dk-cite! 'sip-normed-ag-opr 'v))
(subst (dk-cite! 'sip-normed-ag-inv 'v))
(subst (dk-cite! 'sip-normed-ag-norm-value 'v (sipd-sub 'x_ 'y_)))
(sipd-q-facts! (sipd-sub 'x_ 'y_))
(if (not (proof-done? *ps*)) (rfl))
(sipd-qed! 'sip-metric-space-dist)

;;; the two halves of a real Hilbert space
(sp (make-wff '(FORALL v (IMPLIES (IS-REAL-HILBERT-SPACE v) (IS-PRE-HILBERT-SPACE v)))))
(dk-peel!)
(mac-h 'is-real-hilbert-space '(IS-REAL-HILBERT-SPACE v))
(dk-split-all!)
(ass)
(sipd-qed! 'real-hilbert-space-is-phs)

(sp (make-wff '(FORALL v (IMPLIES (IS-REAL-HILBERT-SPACE v) (IS-COMPLETE (SIP-METRIC-SPACE v))))))
(dk-peel!)
(mac-h 'is-real-hilbert-space '(IS-REAL-HILBERT-SPACE v))
(dk-split-all!)
(ass)
(sipd-qed! 'real-hilbert-space-complete)

;;; ==========================================================================================
;;; (3) THE COMPLEXIFICATION AS A COMPLEX INNER PRODUCT SPACE: w = CSIP-CIPS(COMPLEXIFY(v)).
;;; Its operations on pairs, read through the read-offs of sip-b.scm.
;;; ==========================================================================================
(define sipd-pairs '(CARTESIAN (VEC v) (VEC v)))
(define sipd-cx '(COMPLEXIFY v))
(define sipd-w '(CSIP-CIPS (COMPLEXIFY v)))
(define (sipd-w-acc acc) (list acc sipd-w))
(define (sipd-n1 x) (list 'NTH 1 x))
(define (sipd-n2 x) (list 'NTH 2 x))
;;; x in C: its components typed, and x = [x1, x2] in context
(define (sipd-open-pair! x)
  (if (not (and (dk-asm? (list 'IN (sipd-n1 x) '(VEC v))) (dk-asm? (list 'IN (sipd-n2 x) '(VEC v)))))
      (begin
        (dk-split-all! (list (dk-cite! 'cartesian-nth x '(VEC v) '(VEC v))))
        (dk-cite! 'cartesian-pair-eq x '(VEC v) '(VEC v)))))
;;; p = (LIST a b), a, b typable vectors: (IN p C)
(define (sipd-pair-in! p)
  (sipd-vt (cadr p)) (sipd-vt (caddr p))
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (cadr p) (caddr p)))
(define (sipd-cx-base!)
  (sipd-pin!)
  (if (not (dk-asm? (list 'IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE sipd-cx))) (dk-cite! 'complexify-is-csip 'v)))
;;; (IN x C) in context: land (IN x (VEC c))
(define (sipd-in-vec-c! x)
  (dk-cite! 'complexify-vec 'v)
  (let ((want (list 'IN x (list 'VEC sipd-cx))))
    (if (not (dk-asm? want)) (dk-rewrite-h! (list 'IN x sipd-pairs) sipd-pairs (list 'VEC sipd-cx)))
    want))
(define (sipd-sp-sip body) (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) body)))))
(define (sipd-sp-phs body) (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-PRE-HILBERT-SPACE v) body)))))
(define (sipd-rw! e) (subst (list '= (cadr e) (caddr e))))
(define (sipd-close-eq!) (if (not (proof-done? *ps*)) (rfl)))

(sipd-sp-sip (list '== (sipd-w-acc 'VEC) sipd-pairs))
(dk-peel!)
(sipd-cx-base!)
(sipd-rw! (dk-cite! 'csip-cips-vec sipd-cx))
(sipd-rw! (dk-cite! 'complexify-vec 'v))
(if (not (proof-done? *ps*)) (qrfl))
(sipd-qed! 'cxw-vec)

(sipd-sp-sip (list '== (sipd-w-acc 'VZERO) '(LIST (VZERO v) (VZERO v))))
(dk-peel!)
(sipd-cx-base!)
(sipd-rw! (dk-cite! 'csip-cips-vzero sipd-cx))
(sipd-rw! (dk-cite! 'complexify-vzero 'v))
(if (not (proof-done? *ps*)) (qrfl))
(sipd-qed! 'cxw-vzero)

(define sipd-vadd-rhs
  (list 'LIST (list '(VADD v) (sipd-n1 'px_) (sipd-n1 'qx_)) (list '(VADD v) (sipd-n2 'px_) (sipd-n2 'qx_))))
(sipd-sp-sip (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
               (list '= (list (sipd-w-acc 'VADD) 'px_ 'qx_) sipd-vadd-rhs)))
(dk-peel!)
(sipd-cx-base!)
(sipd-open-pair! 'px_) (sipd-open-pair! 'qx_)
(sipd-pair-in! sipd-vadd-rhs)
(sipd-rw! (dk-cite! 'csip-cips-vadd sipd-cx))
(sipd-rw! (dk-cite! 'complexify-vadd 'v))
(subst (dk-cite! 'cx-vadd-value 'v 'px_ 'qx_))
(sipd-close-eq!)
(sipd-qed! 'cxw-vadd-value)

(define sipd-vneg-rhs (list 'LIST (list '(VNEG v) (sipd-n1 'px_)) (list '(VNEG v) (sipd-n2 'px_))))
(sipd-sp-sip (forall-guarded '(px_) (list (list 'IN 'px_ sipd-pairs))
               (list '= (list (sipd-w-acc 'VNEG) 'px_) sipd-vneg-rhs)))
(dk-peel!)
(sipd-cx-base!)
(sipd-open-pair! 'px_)
(sipd-pair-in! sipd-vneg-rhs)
(sipd-rw! (dk-cite! 'csip-cips-vneg sipd-cx))
(sipd-rw! (dk-cite! 'complexify-vneg 'v))
(subst (dk-cite! 'cx-vneg-value 'v 'px_))
(sipd-close-eq!)
(sipd-qed! 'cxw-vneg-value)

;;; the complex form on pairs: <p, q>_w = (<p1,q1> + <p2,q2>) - i (<-p2,q1> + <p1,q2>)
(define sipd-ip-rhs
  (list '- (list '+ (sipd-ip (sipd-n1 'px_) (sipd-n1 'qx_)) (sipd-ip (sipd-n2 'px_) (sipd-n2 'qx_)))
           (list '* '+i (list '+ (sipd-ip (list '(VNEG v) (sipd-n2 'px_)) (sipd-n1 'qx_))
                                 (sipd-ip (sipd-n1 'px_) (sipd-n2 'qx_))))))
(sipd-sp-sip (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
               (list '= (list (sipd-w-acc 'IP) 'px_ 'qx_) sipd-ip-rhs)))
(dk-peel!)
(sipd-cx-base!)
(sipd-open-pair! 'px_) (sipd-open-pair! 'qx_)
(sipd-in-vec-c! 'px_) (sipd-in-vec-c! 'qx_)
(let ((jp (list 'LIST (list '(VNEG v) (sipd-n2 'px_)) (sipd-n1 'px_))))
  (sipd-pair-in! jp)
  (for-each (lambda (pr) (sipd-ft (car pr) (cdr pr)))
            (list (cons (sipd-n1 'px_) (sipd-n1 'qx_)) (cons (sipd-n2 'px_) (sipd-n2 'qx_))
                  (cons (list '(VNEG v) (sipd-n2 'px_)) (sipd-n1 'qx_)) (cons (sipd-n1 'px_) (sipd-n2 'qx_))))
  (dk-cite! 'cc-i-in)
  (sipd-rw! (dk-cite! 'csip-cips-ip sipd-cx))
  (subst (dk-cite! 'csip-crip-value sipd-cx 'px_ 'qx_))
  (sipd-rw! (dk-cite! 'complexify-rip 'v))
  (sipd-rw! (dk-cite! 'complexify-jop 'v))
  (subst (dk-cite! 'cx-j-value 'v 'px_))
  (subst (dk-cite! 'cx-rip-value 'v jp 'qx_))
  (subst (dk-cite! 'cx-rip-value 'v 'px_ 'qx_))
  (nth-r)
  (sipd-close-eq!))
(sipd-qed! 'cxw-ip-value)

;;; on the diagonal: <p, p>_w = <p1,p1> + <p2,p2>
(sipd-sp-sip (forall-guarded '(px_) (list (list 'IN 'px_ sipd-pairs))
               (list '= (list (sipd-w-acc 'IP) 'px_ 'px_)
                     (list '+ (sipd-q (sipd-n1 'px_)) (sipd-q (sipd-n2 'px_))))))
(dk-peel!)
(sipd-cx-base!)
(sipd-open-pair! 'px_)
(sipd-in-vec-c! 'px_)
(sipd-ft (sipd-n1 'px_) (sipd-n1 'px_)) (sipd-ft (sipd-n2 'px_) (sipd-n2 'px_))
(sipd-rw! (dk-cite! 'csip-cips-ip sipd-cx))
(subst (dk-cite! 'csip-crip-self sipd-cx 'px_))
(sipd-rw! (dk-cite! 'complexify-rip 'v))
(subst (dk-cite! 'cx-rip-value 'v 'px_ 'px_))
(sipd-close-eq!)
(sipd-qed! 'cxw-ip-self)

;;; the complex scalar action on pairs: (a + ib)(p1, p2) = (a p1 + b (-p2), a p2 + b p1)
(define sipd-act-rhs
  (list 'LIST (list '(VADD v) (list '(ACT v) '(real-part z_) (sipd-n1 'px_)) (list '(ACT v) '(imag-part z_) (list '(VNEG v) (sipd-n2 'px_))))
              (list '(VADD v) (list '(ACT v) '(real-part z_) (sipd-n2 'px_)) (list '(ACT v) '(imag-part z_) (sipd-n1 'px_)))))
(sipd-sp-sip (forall-guarded '(z_ px_) (list '(IN z_ CC) (list 'IN 'px_ sipd-pairs))
               (list '= (list (sipd-w-acc 'ACT) 'z_ 'px_) sipd-act-rhs)))
(dk-peel!)
(sipd-cx-base!)
(sipd-open-pair! 'px_)
(sipd-in-vec-c! 'px_)
(dk-cite! 'real-part-in-rr 'z_) (dk-cite! 'imag-part-in-rr 'z_)
(sipd-pair-in! sipd-act-rhs)
(let* ((jp (list 'LIST (list '(VNEG v) (sipd-n2 'px_)) (sipd-n1 'px_)))
       (l1 (list 'LIST (list '(ACT v) '(real-part z_) (sipd-n1 'px_)) (list '(ACT v) '(real-part z_) (sipd-n2 'px_))))
       (l2 (list 'LIST (list '(ACT v) '(imag-part z_) (list '(VNEG v) (sipd-n2 'px_))) (list '(ACT v) '(imag-part z_) (sipd-n1 'px_)))))
  (sipd-pair-in! jp) (sipd-pair-in! l1) (sipd-pair-in! l2)
  (sipd-rw! (dk-cite! 'csip-cips-act sipd-cx))
  (subst (dk-cite! 'csip-cact-value sipd-cx 'z_ 'px_))
  (sipd-rw! (dk-cite! 'complexify-vadd 'v))
  (sipd-rw! (dk-cite! 'complexify-act 'v))
  (sipd-rw! (dk-cite! 'complexify-jop 'v))
  (subst (dk-cite! 'cx-j-value 'v 'px_))
  (subst (dk-cite! 'cx-act-value 'v '(real-part z_) 'px_))
  (subst (dk-cite! 'cx-act-value 'v '(imag-part z_) jp))
  (nth-r)
  (subst (dk-cite! 'cx-vadd-value 'v l1 l2))
  (nth-r)
  (sipd-close-eq!))
(sipd-qed! 'cxw-act-value)

;;; THE COMPLEXIFICATION OF A PRE-HILBERT SPACE IS A COMPLEX PRE-HILBERT SPACE, hence (37)-(38)
;;; a complex inner product space.
(sipd-sp-phs (list 'IS-COMPLEX-PRE-HILBERT-SPACE sipd-cx))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(mac 'is-complex-pre-hilbert-space-def)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
        (begin
          (sipd-rw! (dk-cite! 'complexify-vec 'v))
          (sipd-rw! (dk-cite! 'complexify-rip 'v))
          (sipd-rw! (dk-cite! 'complexify-vzero 'v))
          (let* ((lk (dk-peel!))
                 (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) lk)))
                 (h (find-first (lambda (f) (dk-head-is? f '=)) lk)))
            (sipd-open-pair! x)
            (let* ((x1 (sipd-n1 x)) (x2 (sipd-n2 x))
                   (e (dk-cite! 'cx-rip-value 'v x x))
                   (h2 (dk-rewrite-h! h (cadr e) (caddr e))))
              (sipd-ft x1 x1) (sipd-ft x2 x2)
              (dk-cite! 'sip-rip-self-nonneg 'v x1) (dk-cite! 'sip-rip-self-nonneg 'v x2)
              (dk-have! (list '= (sipd-q x1) 0) (lambda () (dk-ineq! h2 (list '<= 0 (sipd-q x2)) (list '<= 0 (sipd-q x1)))))
              (dk-have! (list '= (sipd-q x2) 0) (lambda () (dk-ineq! h2 (list '<= 0 (sipd-q x2)) (list '<= 0 (sipd-q x1)))))
              (dk-cite! 'phs-definite 'v x1)
              (dk-cite! 'phs-definite 'v x2)
              (subst (list '= x (list 'LIST x1 x2)))
              (subst (list '= x1 '(VZERO v)))
              (subst (list '= x2 '(VZERO v)))
              (sipd-pair-in! '(LIST (VZERO v) (VZERO v)))
              (sipd-close-eq!)))))))
(sipd-qed! 'complexify-is-cphs)
(alias! 'complexify-is-cphs "the complexification of a pre-Hilbert space is a complex pre-Hilbert space")

(sipd-sp-phs (list 'IS-COMPLEX-INNER-PRODUCT-SPACE sipd-w))
(dk-peel!)
(dk-cite! 'complexify-is-cphs 'v)
(dk-cite! 'cphs-is-complex-inner-product-space sipd-cx)
(ass)
(sipd-qed! 'cxw-is-cips)

;;; THE METRIC OF w: d_w(p, q)^2 = d(p1, q1)^2 + d(p2, q2)^2
(define (sipd-dw p q) (list (list 'DIST (list 'IP-METRIC-SPACE sipd-w)) p q))
(define (sipd-dv a b) (list '(DIST (SIP-METRIC-SPACE v)) a b))
(define (sipd-qsum p q) (list '+ (sipd-qd (sipd-n1 p) (sipd-n1 q)) (sipd-qd (sipd-n2 p) (sipd-n2 q))))
(sipd-sp-phs (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
               (list '= (sipd-dw 'px_ 'qx_) (list 'SQRT (sipd-qsum 'px_ 'qx_)))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(dk-cite! 'cxw-is-cips 'v)
(sipd-open-pair! 'px_) (sipd-open-pair! 'qx_)
(dk-cite! 'cxw-vec 'v)
(dk-rewrite-h! (list 'IN 'px_ sipd-pairs) sipd-pairs (sipd-w-acc 'VEC))
(dk-rewrite-h! (list 'IN 'qx_ sipd-pairs) sipd-pairs (sipd-w-acc 'VEC))
(let* ((nq (list 'LIST (list '(VNEG v) (sipd-n1 'qx_)) (list '(VNEG v) (sipd-n2 'qx_))))
       (d (list 'LIST (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)) (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))))
  (sipd-pair-in! nq) (sipd-pair-in! d)
  (subst (dk-cite! 'ip-metric-space-dist sipd-w 'px_ 'qx_))
  (subst (dk-cite! 'cxw-vneg-value 'v 'qx_))
  (subst (dk-cite! 'cxw-vadd-value 'v 'px_ nq))
  (nth-r)
  (subst (dk-cite! 'cxw-ip-self 'v d))
  (nth-r)
  (sipd-q-facts! (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)))
  (sipd-q-facts! (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))
  (dk-real! (sipd-qsum 'px_ 'qx_))
  (dk-have! (list '<= 0 (sipd-qsum 'px_ 'qx_))
    (lambda () (dk-ineq! (list '<= 0 (sipd-qd (sipd-n1 'px_) (sipd-n1 'qx_))) (list '<= 0 (sipd-qd (sipd-n2 'px_) (sipd-n2 'qx_))))))
  (sipd-sqrt! (sipd-qsum 'px_ 'qx_))
  (sipd-close-eq!))
(sipd-qed! 'cxw-dist)

;;; the components are no farther apart than the pairs, and the pairs no farther apart than
;;; the sum of the components' distances
(define (sipd-comp-le! name i)
  (sipd-sp-phs (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
                 (list '<= (sipd-dv (list 'NTH i 'px_) (list 'NTH i 'qx_)) (sipd-dw 'px_ 'qx_))))
  (dk-peel!)
  (fact 'phs-is-sip 'v)
  (sipd-pin!)
  (sipd-open-pair! 'px_) (sipd-open-pair! 'qx_)
  (subst (dk-cite! 'sip-metric-space-dist 'v (list 'NTH i 'px_) (list 'NTH i 'qx_)))
  (subst (dk-cite! 'cxw-dist 'v 'px_ 'qx_))
  (let* ((q1 (sipd-qd (sipd-n1 'px_) (sipd-n1 'qx_)))
         (q2 (sipd-qd (sipd-n2 'px_) (sipd-n2 'qx_)))
         (qs (list '+ q1 q2))
         (qi (if (= i 1) q1 q2)))
    (sipd-q-facts! (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)))
    (sipd-q-facts! (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))
    (dk-real! qs)
    (dk-have! (list '<= qi qs) (lambda () (dk-ineq! (list '<= 0 q1) (list '<= 0 q2))))
    (sipd-have-and! (list 'IN qi 'RR) (list '<= 0 qi))
    (sipd-have-and! (list 'IN qs 'RR) (list '<= qi qs))
    (dk-cite! 'sqrt-mono qi qs)
    (ass))
  (sipd-qed! name))
