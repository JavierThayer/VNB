;;; ==========================================================================================
;;; (4) TWO METRIC LEMMAS: a sequence dominated by a Cauchy sequence is Cauchy; a sequence
;;; dominated by the sum of two convergent distance sequences converges.
;;; ==========================================================================================
(sp (make-wff '(FORALL s (FORALL tm_ (FORALL f (FORALL g (IMPLIES (IS-CAUCHY-SEQ s f)
  (IMPLIES (IS-METRIC-SPACE tm_) (IMPLIES (IN g (FUN NN (PTS tm_)))
  (IMPLIES (FORALL m (IMPLIES (IN m NN) (FORALL n_ (IMPLIES (IN n_ NN)
             (<= ((DIST tm_) (g m) (g n_)) ((DIST s) (f m) (f n_)))))))
    (IS-CAUCHY-SEQ tm_ g)))))))))))
(dk-peel!)
(let* ((dom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(DIST tm_)))) "the domination"))
       (rhs (sipd-iff-fwd! 'is-cauchy-seq 's 'f))
       (cu (caddr (caddr rhs)))
       (iff (dk-cite! 'is-cauchy-seq 'tm_ 'g))
       (clause (caddr (caddr (caddr iff)))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (nv (dk-skolem! (dk-apply! cu e)))
             (inner (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq nv (free-vars f)))) "the Cauchy universal")))
        (witness! nv
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2))
                           (m (cadr (car ins))) (n2 (cadr (cadr ins)))
                           (hh (sipd-have-and! (list '<= nv m) (list '<= nv n2)))
                           (le1 (dk-apply! inner m n2))
                           (le2 (dk-apply! dom m n2)))
                      (for-each (lambda (k)
                                  (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) k)
                                  (dk-cite! 'fun-apply-type-c 'g 'NN '(PTS tm_) k))
                                (list m n2))
                      (dk-cite! 'metric-dist-real 's (list 'f m) (list 'f n2))
                      (dk-cite! 'metric-dist-real 'tm_ (list 'g m) (list 'g n2))
                      (dk-cite! 'rr-pos-rr-in-rr e)
                      (dk-ineq! le1 le2))))))))))
  (sipd-iff-bwd! 'is-cauchy-seq 'tm_ 'g)
  (ass))
(sipd-qed! 'ms-cauchy-of-dominated)

(sp (make-wff '(FORALL s (FORALL t1_ (FORALL t2_ (FORALL f (FORALL g1_ (FORALL g2_ (FORALL l (FORALL l1_ (FORALL l2_
  (IMPLIES (IS-METRIC-SPACE s) (IMPLIES (IN f (FUN NN (PTS s))) (IMPLIES (IN l (PTS s))
  (IMPLIES (CONVERGES-TO t1_ g1_ l1_) (IMPLIES (CONVERGES-TO t2_ g2_ l2_)
  (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN)
             (<= ((DIST s) (f n_) l) (+ ((DIST t1_) (g1_ n_) l1_) ((DIST t2_) (g2_ n_) l2_)))))
    (CONVERGES-TO s f l))))))))))))))))))
(dk-peel!)
(let* ((dom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(DIST t1_)))) "the domination"))
       (r1 (sipd-iff-fwd! 'converges-to 't1_ 'g1_ 'l1_))
       (u1 (caddr (caddr (caddr r1))))
       (r2 (sipd-iff-fwd! 'converges-to 't2_ 'g2_ 'l2_))
       (u2 (caddr (caddr (caddr r2))))
       (iff (dk-cite! 'converges-to 's 'f 'l))
       (clause (caddr (caddr (caddr (caddr iff))))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (d (dk-halve! e))
             (n1 (dk-skolem! (dk-apply! u1 d)))
             (i1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n1 (free-vars f)))) "the first tail"))
             (n2 (dk-skolem! (dk-apply! u2 d)))
             (i2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n2 (free-vars f)))) "the second tail"))
             (nn (list '+ n1 n2)))
        (sipd-have-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
        (dk-cite! 'nn-add-closed n1 n2)
        (witness! nn
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2)))
                           (ge (find-first (lambda (f) (dk-head-is? f '<=)) lk2)))
                      (dk-have! (list '<= n1 k) (lambda () (dk-nn! ge)))
                      (dk-have! (list '<= n2 k) (lambda () (dk-nn! ge)))
                      (let ((a1 (dk-apply! i1 k))
                            (a2 (dk-apply! i2 k))
                            (a0 (dk-apply! dom k)))
                        (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) k)
                        (dk-cite! 'fun-apply-type-c 'g1_ 'NN '(PTS t1_) k)
                        (dk-cite! 'fun-apply-type-c 'g2_ 'NN '(PTS t2_) k)
                        (dk-cite! 'metric-dist-real 's (list 'f k) 'l)
                        (dk-cite! 'metric-dist-real 't1_ (list 'g1_ k) 'l1_)
                        (dk-cite! 'metric-dist-real 't2_ (list 'g2_ k) 'l2_)
                        (dk-cite! 'rr-pos-rr-in-rr e)
                        (dk-ineq! a0 a1 a2 (list '= (list '+ d d) e))))))))))))
  (sipd-iff-bwd! 'converges-to 's 'f 'l)
  (ass))
(sipd-qed! 'ms-converges-of-dominated-sum)

