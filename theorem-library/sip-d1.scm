(let* ((q1 (sipd-qd (sipd-n1 'px_) (sipd-n1 'qx_)))
       (q2 (sipd-qd (sipd-n2 'px_) (sipd-n2 'qx_)))
       (qs (list '+ q1 q2)))
  (sipd-q-facts! (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)))
  (sipd-q-facts! (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))
  (dk-real! qs)
  (dk-have! (list '<= 0 qs) (lambda () (dk-ineq! (list '<= 0 q1) (list '<= 0 q2))))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (let* ((s (dk-name! (list 'SQRT q1)))
         (tt (dk-name! (list 'SQRT q2)))
         (ss (dk-rewrite-h! (list '= (list '* (list 'SQRT q1) (list 'SQRT q1)) q1) (list 'SQRT q1) s))
         (tq (dk-rewrite-h! (list '= (list '* (list 'SQRT q2) (list 'SQRT q2)) q2) (list 'SQRT q2) tt))
         (s0 (dk-rewrite-h! (list '<= 0 (list 'SQRT q1)) (list 'SQRT q1) s))
         (t0 (dk-rewrite-h! (list '<= 0 (list 'SQRT q2)) (list 'SQRT q2) tt))
