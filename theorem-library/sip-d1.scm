(dk-cite! 'ip-metric-space-pts sipd-w)
(dk-cite! 'cxw-vec 'v)
(dk-cite! 'sip-metric-space-pts 'v)
(let ((ccv (dk-cite! 'complete-cauchy-converges sipd-mv))
      (all (list 'FORALL 'scf_ (list 'IMPLIES (list 'IS-CAUCHY-SEQ sipd-ms 'scf_) (list 'CONVERGES sipd-ms 'scf_)))))
  (dk-have! all
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (caddr (find-first (lambda (x) (dk-head-is? x 'IS-CAUCHY-SEQ)) lk)))
             (ft (dk-cite! 'cauchy-seq-is-fun sipd-ms f))
             (ft2 (dk-rewrite-h! ft (list 'PTS sipd-ms) (sipd-w-acc 'VEC)))
             (fc (dk-rewrite-h! ft2 (sipd-w-acc 'VEC) sipd-pairs))
             (comp! (lambda (i)
                      (dk-abstract! 'NN '(VEC v) (lambda (k) (list 'NTH i (list f k)))
                        (lambda (k)
                          (dk-cite! 'fun-apply-type-c f 'NN sipd-pairs k)
                          (sipd-open-pair! (list f k))
                          (ass)))))
             (limit! (lambda (gi i)
                       (let* ((g (car gi)) (ve (cdr gi))
                              (gt (dk-rewrite-h! (list 'IN g '(FUN NN (VEC v))) '(VEC v) (list 'PTS sipd-mv)))
                              (dom (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                                      (list '<= (list (list 'DIST sipd-mv) (list g 'm) (list g 'n_))
                                                (list (list 'DIST sipd-ms) (list f 'm) (list f 'n_)))))))))
                         (dk-have! dom
                           (lambda ()
                             (let* ((lk3 (dk-peel!))
                                    (ks (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk3))))
                               (for-each (lambda (k) (dk-cite! 'fun-apply-type-c f 'NN sipd-pairs k)
                                                     (subst (dk-apply! ve k)))
                                         ks)
                               (dk-cite! (if (= i 1) 'cxw-dist-comp1 'cxw-dist-comp2) 'v (list f (car ks)) (list f (cadr ks)))
                               (ass))))
                         (dk-cite! 'ms-cauchy-of-dominated sipd-ms sipd-mv f g)
                         (let* ((cv (dk-apply! ccv g))
                                (lim (dk-skolem! (sipd-iff-fwd! 'converges sipd-mv g))))
                           (sipd-iff-fwd! 'converges-to sipd-mv g lim)
                           (dk-rewrite-h! (list 'IN lim (list 'PTS sipd-mv)) (list 'PTS sipd-mv) '(VEC v))
                           lim)))))
        (let* ((g1 (comp! 1))
               (g2 (comp! 2))
               (l1 (limit! g1 1))
               (l2 (limit! g2 2))
               (lim (list 'LIST l1 l2)))
          (sipd-pair-in! lim)
          (dk-rewrite-h! (dk-rewrite-h! (list 'IN lim sipd-pairs) sipd-pairs (sipd-w-acc 'VEC)) (sipd-w-acc 'VEC) (list 'PTS sipd-ms))
          (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                      (list '<= (list (list 'DIST sipd-ms) (list f 'n_) lim)
                                (list '+ (list (list 'DIST sipd-mv) (list (car g1) 'n_) l1)
                                         (list (list 'DIST sipd-mv) (list (car g2) 'n_) l2)))))
            (lambda ()
              (let* ((lk4 (dk-peel!))
                     (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk4))))
                (dk-cite! 'fun-apply-type-c f 'NN sipd-pairs k)
                (subst (dk-apply! (cdr g1) k))
                (subst (dk-apply! (cdr g2) k))
                (let ((le (dk-cite! 'cxw-dist-le-sum 'v (list f k) lim)))
                  (dk-nth-h! le)
                  (ass)))))
          (dk-cite! 'ms-converges-of-dominated-sum sipd-ms sipd-mv sipd-mv f (car g1) (car g2) lim l1 l2)
          (mac 'converges)
          (ew lim)
          (ass)))))
  (sipd-iff-bwd! 'is-complete sipd-ms)
  (ass))
(sipd-qed! 'complexify-complete)
