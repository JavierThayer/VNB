    (dk-cite! 'rr-mul-le-right 0 s tt)
    (let* ((stn (dk-name! st))
           (st0 (dk-have! (list '<= 0 stn) (lambda () (subst (list '= stn st)) (dk-ineq! (list '<= (list '* 0 tt) st)))))
           (uu (dk-name! (list '* spt spt)))
