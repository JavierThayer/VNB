(subst (dk-cite! 'sip-metric-space-dist 'v (sipd-n1 'px_) (sipd-n1 'qx_)))
(subst (dk-cite! 'sip-metric-space-dist 'v (sipd-n2 'px_) (sipd-n2 'qx_)))
