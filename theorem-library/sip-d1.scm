;;; the orthogonal complement of any set of vectors is a subspace
(sp (make-wff '(FORALL v (FORALL ks (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IMPLIES (SUBSET ks (VEC v))
     (IS-SUBMODULE v (SIP-PERP v ks))))))))
(dk-peel!)
(sipd-pin!)
(dk-cite! 'sip-perp-subset 'v 'ks)
(define (sipd-perp-in! z)                 ; z a typable vector with <z, k> = 0 for k in ks: z in perp
  (sipd-vt z)
  (dk-have! (list 'FORALL 'spk_ (list 'IMPLIES '(IN spk_ ks) (list '= (sipd-ip z 'spk_) 0)))
    (lambda ()
      (let* ((lk (dk-peel!)) (k (cadr (car lk))))
        (dk-cite! 'subset-mem-fwd 'ks '(VEC v) k)
        (for-each (lambda (b) (if (dk-asm? (list 'IN b (list 'SIP-PERP 'v 'ks))) (dk-cite! 'sip-perp-orth 'v 'ks b k)))
                  (sipd-perp-parts z))
        (sipd-expand!)
        (for-each (lambda (b) (if (dk-asm? (list 'IN b (list 'SIP-PERP 'v 'ks))) (subst (list '= (sipd-ip b k) 0))))
                  (sipd-perp-parts z))
        (if (not (proof-done? *ps*)) (crs)))))
  (sipd-iff-bwd! 'sip-perp-membership 'v 'ks z))
(define (sipd-perp-parts z)
  (cond ((sipd-op? z 'VADD) (append (sipd-perp-parts (cadr z)) (sipd-perp-parts (caddr z))))
        ((sipd-op? z 'VNEG) (sipd-perp-parts (cadr z)))
        ((sipd-op? z 'ACT) (sipd-perp-parts (caddr z)))
        ((equal? z '(VZERO v)) '())
        (#t (list z))))
(let ((pp '(SIP-PERP v ks)))
  (dk-have! (list 'IN '(VZERO v) pp) (lambda () (sipd-perp-in! '(VZERO v)) (ass)))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ pp)
              (list 'IN '((VADD v) x_ y_) pp)))))
    (lambda () (let* ((lk (dk-peel!)) (xs (map cadr lk)))
                 (for-each (lambda (x) (dk-cite! 'subset-mem-fwd pp '(VEC v) x)) xs)
                 (sipd-perp-in! (list '(VADD v) (car xs) (cadr xs))) (ass))))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp) (list 'IN '((VNEG v) x_) pp)))
    (lambda () (let* ((lk (dk-peel!)) (x (cadr (car lk))))
                 (dk-cite! 'subset-mem-fwd pp '(VEC v) x)
                 (sipd-perp-in! (list '(VNEG v) x)) (ass))))
  (dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ (CARR (SCAL v))) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp)
              (list 'IN '((ACT v) r_ x_) pp)))))
    (lambda () (let* ((lk (dk-peel!)) (r (cadr (car lk))) (x (cadr (cadr lk))))
                 (dk-cite! 'sip-scal-carr 'v)
                 (dk-rewrite-h! (list 'IN r '(CARR (SCAL v))) '(CARR (SCAL v)) 'RR)
                 (dk-cite! 'subset-mem-fwd pp '(VEC v) x)
                 (sipd-perp-in! (list '(ACT v) r x)) (ass))))
  (sipd-iff-bwd! 'is-submodule 'v pp)
  (ass))
(sipd-qed! 'sip-perp-is-submodule)

;;; ==========================================================================================
;;; (7) A CLOSED REAL SUBSPACE M GIVES THE CLOSED COMPLEX SUBSPACE M x M OF w.
;;; ==========================================================================================
(define (sipd-sub-open! kk)               ; IS-SUBMODULE(v, kk) in context: kk in VEC v
  (dk-cite! 'submodule-subset 'v kk))
(define (sipd-in-kk-pair! z kk)           ; z in kk x kk: components in kk and in VEC v, z = [z1, z2]
  (dk-split-all! (list (dk-cite! 'cartesian-nth z kk kk)))
  (dk-cite! 'subset-mem-fwd kk '(VEC v) (sipd-n1 z))
  (dk-cite! 'subset-mem-fwd kk '(VEC v) (sipd-n2 z))
  (dk-cite! 'cartesian-pair-eq z kk kk)
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (sipd-n1 z) (sipd-n2 z))
  (dk-rewrite-h! (list 'IN (list 'LIST (sipd-n1 z) (sipd-n2 z)) sipd-pairs) (list 'LIST (sipd-n1 z) (sipd-n2 z)) z))
;;; (SUBSET kk (VEC v)) in context: land (SUBSET (CARTESIAN kk kk) C), pointwise (the tree's
;;; cartesian-mono lives in theorem-library/product-measure, library measure, which an analysis
;;; file may not cite)
(define (sipd-mm-sub! kk)
  (let ((g (list 'SUBSET (list 'CARTESIAN kk kk) sipd-pairs)))
    (dk-have! g (lambda () (mac 'subset-def)
                           (let* ((lk (dk-peel!)) (z (cadr (car lk)))) (sipd-in-kk-pair! z kk) (ass))))
    g))
(define (sipd-flat-and f) (if (dk-head-is? f 'AND) (append (sipd-flat-and (cadr f)) (sipd-flat-and (caddr f))) (list f)))

(sipd-sp-phs (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBMODULE v kk) (list 'IS-SUBMODULE sipd-w '(CARTESIAN kk kk)))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(dk-cite! 'complexify-is-cphs 'v)
(dk-cite! 'cxw-is-cips 'v)
(sipd-sub-open! 'kk)
(dk-cite! 'cxw-vec 'v)
(let* ((mm '(CARTESIAN kk kk))
       (iff (dk-cite! 'is-submodule sipd-w mm))
       (parts (sipd-flat-and (caddr iff)))
       (pair-in-mm! (lambda (p)       ; p = LIST a b with a, b in kk
                      (dk-cite! 'pair-in-cartesian 'kk 'kk (cadr p) (caddr p)))))
  (for-each
    (lambda (g)
      (dk-have! g
        (lambda ()
          (cond
            ((dk-head-is? g 'SUBSET)
             (subst (list '= (sipd-w-acc 'VEC) sipd-pairs))
             (let ((leaf (proof-state-focus *ps*)))   ; dk-have! of the focus goal closes it in place
               (sipd-mm-sub! 'kk)
               (if (not (sequent-node-grounded? leaf)) (ass))))
            ((dk-head-is? g 'IN)
             (subst (dk-cite! 'cxw-vzero 'v))
             (dk-cite! 'submodule-vzero-in 'v 'kk)
             (pair-in-mm! '(LIST (VZERO v) (VZERO v)))
             (ass))
            (#t
             (let* ((lk (dk-peel!))
                    (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mm))) lk)))
                    (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (not (equal? (caddr f) mm)))) lk))))
               (for-each (lambda (x) (sipd-in-kk-pair! x 'kk)) xs)
               (let ((g2 (cadr (dk-goal))))
                 (cond
                   ((sipd-op? (car g2) 'VADD)      ; placeholder, never: heads are (VADD w)
                    #f)
                   ((equal? (car g2) (sipd-w-acc 'VADD))
                    (let ((x (car xs)) (y (cadr xs)))
                      (subst (dk-cite! 'cxw-vadd-value 'v x y))
                      (dk-cite! 'submodule-vadd-closed 'v 'kk (sipd-n1 x) (sipd-n1 y))
                      (dk-cite! 'submodule-vadd-closed 'v 'kk (sipd-n2 x) (sipd-n2 y))
                      (pair-in-mm! (cadr (dk-goal)))
                      (ass)))
                   ((equal? (car g2) (sipd-w-acc 'VNEG))
                    (let ((x (car xs)))
                      (subst (dk-cite! 'cxw-vneg-value 'v x))
                      (dk-cite! 'submodule-vneg-closed 'v 'kk (sipd-n1 x))
                      (dk-cite! 'submodule-vneg-closed 'v 'kk (sipd-n2 x))
                      (pair-in-mm! (cadr (dk-goal)))
                      (ass)))
                   (#t
                    (let ((x (car xs)) (z (car rs)))
                      (dk-cite! 'csip-cips-scal-carr sipd-cx)
                      (dk-rewrite-h! (list 'IN z (list 'CARR (sipd-w-acc 'SCAL))) (list 'CARR (sipd-w-acc 'SCAL)) 'CC)
                      (dk-cite! 'real-part-in-rr z) (dk-cite! 'imag-part-in-rr z)
                      (subst (dk-cite! 'cxw-act-value 'v z x))
                      (dk-cite! 'sip-scal-carr 'v)
                      (let ((re (list 'real-part z)) (im (list 'imag-part z)))
                        (dk-rewrite-h! (list 'IN re 'RR) 'RR '(CARR (SCAL v)))
                        (dk-rewrite-h! (list 'IN im 'RR) 'RR '(CARR (SCAL v)))
                        (dk-cite! 'submodule-vneg-closed 'v 'kk (sipd-n2 x))
                        (dk-cite! 'submodule-act-closed 'v 'kk re (sipd-n1 x))
                        (dk-cite! 'submodule-act-closed 'v 'kk re (sipd-n2 x))
                        (dk-cite! 'submodule-act-closed 'v 'kk im (sipd-n1 x))
                        (dk-cite! 'submodule-act-closed 'v 'kk im (list '(VNEG v) (sipd-n2 x)))
                        (let ((l (cadr (dk-goal))))
                          (dk-cite! 'submodule-vadd-closed 'v 'kk (cadr (cadr l)) (caddr (cadr l)))
                          (dk-cite! 'submodule-vadd-closed 'v 'kk (cadr (caddr l)) (caddr (caddr l)))
                          (pair-in-mm! l)
                          (ass)))))))))))))
    parts)
  (sipd-iff-bwd! 'is-submodule sipd-w mm)
  (if (not (proof-done? *ps*)) (ass)))
(sipd-qed! 'complexify-submodule)
(alias! 'complexify-submodule "a real subspace M gives the complex subspace M x M of the complexification")

;;; closure points of M x M have their components in the closure of M
(define (sipd-closure-comp! name i)
  (sipd-sp-phs (list 'FORALL 'kk (list 'IMPLIES '(SUBSET kk (VEC v)) (list 'FORALL 'z_ (list 'IMPLIES
                 (list 'IN 'z_ (list 'CLOSURE sipd-ms '(CARTESIAN kk kk)))
                 (list 'IN (list 'NTH i 'z_) (list 'CLOSURE sipd-mv 'kk)))))))
  (dk-peel!)
  (fact 'phs-is-sip 'v)
  (sipd-cx-base!)
  (dk-cite! 'cxw-is-cips 'v)
  (dk-cite! 'ip-metric-space-is-metric-space sipd-w)
  (dk-cite! 'sip-metric-space-is-metric-space 'v)
  (let* ((mm '(CARTESIAN kk kk))
         (cl (list 'CLOSURE sipd-ms mm))
         (zi (list 'NTH i 'z_)))
    (dk-cite! 'closure-in-carrier sipd-ms mm)
    (dk-cite! 'subset-mem-fwd cl (list 'PTS sipd-ms) 'z_)
    (dk-cite! 'ip-metric-space-pts sipd-w)
    (dk-cite! 'cxw-vec 'v)
    (dk-rewrite-h! (dk-rewrite-h! (list 'IN 'z_ (list 'PTS sipd-ms)) (list 'PTS sipd-ms) (sipd-w-acc 'VEC)) (sipd-w-acc 'VEC) sipd-pairs)
    (sipd-open-pair! 'z_)
    (dk-cite! 'sip-metric-space-pts 'v)
    (dk-rewrite-h! (list 'IN zi '(VEC v)) '(VEC v) (list 'PTS sipd-mv))
    (sipd-mm-sub! 'kk)
    (let* ((iff (dk-cite! 'closure-membership sipd-mv 'kk zi))
           (clause (caddr (caddr iff))))
      (dk-have! clause
        (lambda ()
          (let* ((lk (dk-peel!))
                 (op (find-first (lambda (f) (dk-head-is? f 'AND)) lk))
                 (dummy (if op (dk-split! op)))
                 (u (caddr (find-first (lambda (f) (dk-head-is? f 'IS-OPEN)) (dk-asms))))
                 (opn (sipd-iff-fwd! 'is-open sipd-mv u))
                 (all (caddr (caddr opn)))
                 (r (dk-skolem! (dk-apply! all zi)))
                 (pt (begin (dk-cite! 'rr-pos-rr-in-rr r)
                            (dk-skolem! (dk-cite! 'fom-closure-near sipd-ms mm 'z_ r))))
                 (pti (list 'NTH i pt)))
            (dk-cite! 'subset-mem-fwd mm sipd-pairs pt)
            (dk-split-all! (list (dk-cite! 'cartesian-nth pt 'kk 'kk)))
            (sipd-open-pair! pt)
            (dk-rewrite-h! (list 'IN pti '(VEC v)) '(VEC v) (list 'PTS sipd-mv))
            (let* ((le (dk-cite! (if (= i 1) 'cxw-dist-comp1 'cxw-dist-comp2) 'v 'z_ pt))
                   (dd (caddr le)))
              (dk-rewrite-h! (dk-rewrite-h! (list 'IN pt sipd-pairs) sipd-pairs (sipd-w-acc 'VEC)) (sipd-w-acc 'VEC) (list 'PTS sipd-ms))
              (dk-cite! 'metric-dist-real sipd-ms 'z_ pt)
              (sipd-have-and! (list 'IN pti (list 'PTS sipd-mv)) (list 'IN dd 'RR) (list 'IN r 'RR) le
                              (find-first (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) dd))) (dk-asms)))
              (dk-cite! 'ball-mem-from-le sipd-mv zi pti dd r)
              (dk-cite! 'subset-mem-fwd (list 'BALL sipd-mv zi r) u pti)
              (witness! pti (lambda () (dk-conj-close! dk-ass!)))))))
      (sipd-iff-bwd! 'closure-membership sipd-mv 'kk zi)
      (ass)))
  (sipd-qed! name))
(sipd-closure-comp! 'complexify-closure-comp1 1)
(sipd-closure-comp! 'complexify-closure-comp2 2)

(sipd-sp-phs (list 'FORALL 'kk (list 'IMPLIES (list 'IS-CLOSED sipd-mv 'kk) (list 'IS-CLOSED sipd-ms '(CARTESIAN kk kk)))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(dk-cite! 'cxw-is-cips 'v)
(dk-cite! 'ip-metric-space-is-metric-space sipd-w)
(dk-cite! 'sip-metric-space-pts 'v)
(dk-cite! 'ip-metric-space-pts sipd-w)
(dk-cite! 'cxw-vec 'v)
(let* ((mm '(CARTESIAN kk kk))
       (cl (list 'CLOSURE sipd-ms mm)))
  (sipd-iff-fwd! 'is-closed sipd-mv 'kk)
  (dk-rewrite-h! (list 'SUBSET 'kk (list 'PTS sipd-mv)) (list 'PTS sipd-mv) '(VEC v))
  (sipd-mm-sub! 'kk)
  (dk-have! (list 'SUBSET mm (list 'PTS sipd-ms))
    (lambda () (subst (list '= (list 'PTS sipd-ms) (sipd-w-acc 'VEC))) (subst (list '= (sipd-w-acc 'VEC) sipd-pairs)) (ass)))
  (dk-cite! 'subset-refl 'kk)
  (dk-cite! 'closure-in-closed sipd-mv 'kk 'kk)
  (dk-have! (list 'SUBSET cl mm)
    (lambda ()
      (mac 'subset-def)
      (let* ((lk (dk-peel!)) (z (cadr (car lk))))
        (dk-cite! 'complexify-closure-comp1 'v 'kk z)
        (dk-cite! 'complexify-closure-comp2 'v 'kk z)
        (dk-cite! 'subset-mem-fwd (list 'CLOSURE sipd-mv 'kk) 'kk (sipd-n1 z))
        (dk-cite! 'subset-mem-fwd (list 'CLOSURE sipd-mv 'kk) 'kk (sipd-n2 z))
        (dk-cite! 'closure-in-carrier sipd-ms mm)
        (dk-cite! 'subset-mem-fwd cl (list 'PTS sipd-ms) z)
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN z (list 'PTS sipd-ms)) (list 'PTS sipd-ms) (sipd-w-acc 'VEC)) (sipd-w-acc 'VEC) sipd-pairs)
        (dk-cite! 'cartesian-pair-eq z '(VEC v) '(VEC v))
        (dk-cite! 'pair-in-cartesian 'kk 'kk (sipd-n1 z) (sipd-n2 z))
        (subst (list '= z (list 'LIST (sipd-n1 z) (sipd-n2 z))))
        (ass))))
  (dk-cite! 'closure-subset-closed sipd-ms mm)
  (ass))
(sipd-qed! 'complexify-closed)
(alias! 'complexify-closed "a closed real subspace M gives the closed subset M x M of the complexification")

;;; ==========================================================================================
;;; (8) THE ORTHOGONAL DECOMPOSITION, from the complex projection theorem at (x, 0).
;;; ==========================================================================================
(define sipd-hyps '((IS-REAL-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (SIP-METRIC-SPACE v) kk)))
(sp (make-wff (forall-guarded '(v kk x_) (append sipd-hyps '((IN x_ (VEC v))))
   (list 'FORSOME 'spa_ (list 'AND '(IN spa_ kk) (list 'IN (sipd-sub 'x_ 'spa_) '(SIP-PERP v kk)))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(sipd-sub-open! 'kk)
(dk-cite! 'complexify-hilbert 'v)
(dk-cite! 'complexify-submodule 'v 'kk)
(dk-cite! 'complexify-closed 'v 'kk)
(dk-cite! 'cxw-vec 'v)
(dk-cite! 'cxw-is-cips 'v)
(let* ((mm '(CARTESIAN kk kk))
       (xi '(LIST x_ (VZERO v))))
  (sipd-pair-in! xi)
  (dk-rewrite-h! (list 'IN xi sipd-pairs) sipd-pairs (sipd-w-acc 'VEC))
  (let* ((pp (dk-skolem! (dk-cite! 'hilbert-projection-point sipd-w mm xi)))
         (perp (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'PERP))) (dk-asms)))
         (a1 (sipd-n1 pp)) (a2 (sipd-n2 pp)))
    (sipd-in-kk-pair! pp 'kk)
    (let* ((nq (list 'LIST (list '(VNEG v) a1) (list '(VNEG v) a2)))
           (dv (list 'LIST (sipd-sub 'x_ a1) (sipd-sub '(VZERO v) a2)))
           (dummy (begin (sipd-pair-in! nq) (sipd-pair-in! dv)))
           (h1 (dk-rewrite-h! perp (list (sipd-w-acc 'VNEG) pp) (caddr (dk-cite! 'cxw-vneg-value 'v pp))))
           (e2 (dk-cite! 'cxw-vadd-value 'v xi nq))
           (h2 (dk-nth-h! (dk-rewrite-h! h1 (cadr e2) (caddr e2))))
           (d1 (sipd-sub 'x_ a1)))
      (dk-have! (list 'FORALL 'spk_ (list 'IMPLIES '(IN spk_ kk) (list '= (sipd-ip d1 'spk_) 0)))
        (lambda ()
          (let* ((lk (dk-peel!)) (k (cadr (car lk)))
                 (kz (list 'LIST k '(VZERO v))))
            (dk-cite! 'subset-mem-fwd 'kk '(VEC v) k)
            (dk-cite! 'submodule-vzero-in 'v 'kk)
            (dk-cite! 'pair-in-cartesian 'kk 'kk k '(VZERO v))
            (sipd-pair-in! kz)
            (let* ((o (dk-cite! 'perp-orth sipd-w mm (cadr h2) kz))
                   (iv (dk-cite! 'cxw-ip-value 'v (cadr h2) kz))
                   (o2 (dk-nth-h! (dk-rewrite-h! o (cadr iv) (caddr iv))))
                   (aa (sipd-ip d1 k))
                   (bb (sipd-ip (list '(VNEG v) (sipd-sub '(VZERO v) a2)) k)))
              (sipd-ft d1 k) (sipd-ft (sipd-sub '(VZERO v) a2) '(VZERO v))
              (sipd-ft (list '(VNEG v) (sipd-sub '(VZERO v) a2)) k) (sipd-ft d1 '(VZERO v))
              (let* ((z1 (dk-cite! 'sip-rip-zero-right 'v (sipd-sub '(VZERO v) a2)))
                     (z2 (dk-cite! 'sip-rip-zero-right 'v d1))
                     (o3 (dk-rewrite-h! (dk-rewrite-h! o2 (cadr z1) 0) (cadr z2) 0)))
                (dk-real! bb) (dk-cite! 'rr-subset-cc 0)
                (dk-have! (list '= 0 (list '+ aa (list '* (list '- bb) '+i)))
                  (lambda () (subst (list '= 0 (cadr o3))) (crs)))
                (dk-real! (list '- bb))
                (dk-split-all! (list (dk-cite! 'cc-re-im-of 0 aa (list '- bb))))
                (dk-have! '(IN 0 RR) (lambda () (arith)))
                (dk-cite! 'cc-re-of-real 0)
                (dk-cite! 'real-part-in-rr 0)
                (dk-ineq! (list '= '(real-part 0) aa) '(= (real-part 0) 0)))))))
      (sipd-vt d1)
      (sipd-iff-bwd! 'sip-perp-membership 'v 'kk d1)
      (witness! a1 (lambda () (dk-conj-close! dk-ass!))))))
(sipd-qed! 'real-projection-point)
(alias! 'real-projection-point "the orthogonal projection theorem in a real Hilbert space, from the complex one")

;;; V = M + M-perp
(sp (make-wff (forall-guarded '(v kk x_) (append sipd-hyps '((IN x_ (VEC v))))
   '(FORSOME spa_ (AND (IN spa_ kk) (FORSOME spb_ (AND (IN spb_ (SIP-PERP v kk)) (= x_ ((VADD v) spa_ spb_)))))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-sub-open! 'kk)
(let* ((a (dk-skolem! (dk-cite! 'real-projection-point 'v 'kk 'x_)))
       (b (sipd-sub 'x_ a)))
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) a)
  (sipd-vec-eq! 'x_ (sipd-add a b))
  (witness! a (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                                         (witness! b (lambda () (dk-conj-close! dk-ass!)))))))))
(sipd-qed! 'real-decomposition)
(alias! 'real-decomposition "a real Hilbert space is the sum of a closed subspace and its orthogonal complement")

;;; the decomposition is unique (any pre-Hilbert space, any subspace)
(sp (make-wff (forall-guarded '(v kk a1_ a2_ b1_ b2_)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk)
     (IN a1_ kk) (IN a2_ kk) (IN b1_ (SIP-PERP v kk)) (IN b2_ (SIP-PERP v kk))
     (= ((VADD v) a1_ b1_) ((VADD v) a2_ b2_)))
   '(AND (= a1_ a2_) (= b1_ b2_)))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-sub-open! 'kk)
(dk-cite! 'sip-perp-subset 'v 'kk)
(for-each (lambda (x) (dk-cite! 'subset-mem-fwd 'kk '(VEC v) x)) '(a1_ a2_))
(for-each (lambda (x) (dk-cite! 'subset-mem-fwd '(SIP-PERP v kk) '(VEC v) x)) '(b1_ b2_))
(let* ((u (sipd-sub 'a1_ 'a2_))
       (s1 (sipd-add 'a1_ 'b1_)) (s2 (sipd-add 'a2_ 'b2_))
       (e12 '(= ((VADD v) a1_ b1_) ((VADD v) a2_ b2_))))
  (dk-cite! 'submodule-vneg-closed 'v 'kk 'a2_)
  (dk-cite! 'submodule-vadd-closed 'v 'kk 'a1_ '((VNEG v) a2_))
  (sipd-vt u)
  (sipd-ft s1 u) (sipd-ft s2 u) (sipd-ft 'b1_ u) (sipd-ft 'b2_ u) (sipd-ft u u)
  (let ((o1 (dk-cite! 'sip-perp-orth 'v 'kk 'b1_ u))
        (o2 (dk-cite! 'sip-perp-orth 'v 'kk 'b2_ u))
        (cg (dk-congr! e12 (lambda (x) (sipd-ip x u)))))
    (dk-have! (list '= (sipd-q u) 0)
      (lambda ()
        (let ((j (list '= (sipd-q u)
                       (list '- (list '- (sipd-ip s1 u) (sipd-ip 'b1_ u))
                                (list '- (sipd-ip s2 u) (sipd-ip 'b2_ u))))))
          (sipd-ip-eq! j)
          (subst j)
          (subst cg)
          (subst o1)
          (subst o2)
          (crs))))
    (dk-cite! 'phs-definite 'v u)
    (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v 'a1_ 'a2_)
    (let* ((d (sipd-sub 'b1_ 'b2_))
           (d2 (sipd-sub s1 (sipd-add 'a1_ 'b2_)))
           (qe (list '= (sipd-q d) (sipd-q d2))))
      (sipd-vt d) (sipd-vt d2)
      (sipd-ip-eq! qe)
      (dk-have! (list '= (sipd-q d) 0)
        (lambda ()
          (subst qe)
          (subst e12)
          (subst '(= a2_ a1_))
          (sipd-expand!)
          (if (not (proof-done? *ps*)) (crs))))
      (dk-cite! 'phs-definite 'v d)
      (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v 'b1_ 'b2_)
      (dk-conj-close! dk-ass!))))
(sipd-qed! 'real-decomposition-unique)
(alias! 'real-decomposition-unique "the orthogonal decomposition is unique")

;;; ==========================================================================================
;;; (9) STOP POINT D2 (for a closed SUBSPACE): the closest point, existence and uniqueness.
;;; Pythagoras: <x - a, m - a> = 0 gives ||m - x||^2 = ||a - x||^2 + ||m - a||^2.
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v x_ a_ m_)
   '((IS-SEMI-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)) (IN a_ (VEC v)) (IN m_ (VEC v)))
   (list 'IMPLIES (list '= (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub 'm_ 'a_)) 0)
         (list '= (sipd-qd 'm_ 'x_) (list '+ (sipd-qd 'a_ 'x_) (sipd-qd 'm_ 'a_)))))))
(dk-peel!)
(sipd-pin!)
(let* ((o (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub 'm_ 'a_)))
       (j (list '= (sipd-qd 'm_ 'x_) (list '- (list '+ (sipd-qd 'a_ 'x_) (sipd-qd 'm_ 'a_)) (list '* 2 o)))))
  (sipd-ip-eq! j)
  (sipd-ft (sipd-sub 'x_ 'a_) (sipd-sub 'm_ 'a_))
  (sipd-ft (sipd-sub 'm_ 'x_) (sipd-sub 'm_ 'x_))
  (sipd-ft (sipd-sub 'a_ 'x_) (sipd-sub 'a_ 'x_))
  (sipd-ft (sipd-sub 'm_ 'a_) (sipd-sub 'm_ 'a_))
  (dk-ineq! j (list '= o 0)))
(sipd-qed! 'sip-pythagoras)

;;; the projection point is a closest point
(define (sipd-pyth-at! a m)               ; x_ - a in perp, m, a in kk: land Pythagoras at m
  (dk-cite! 'submodule-vneg-closed 'v 'kk a)
  (dk-cite! 'submodule-vadd-closed 'v 'kk m (list '(VNEG v) a))
  (dk-cite! 'sip-perp-orth 'v 'kk (sipd-sub 'x_ a) (sipd-sub m a))
  (dk-cite! 'sip-pythagoras 'v 'x_ a m))
(sp (make-wff (forall-guarded '(v kk x_) (append sipd-hyps '((IN x_ (VEC v))))
   (list 'FORSOME 'sca_ (list 'AND '(IN sca_ kk)
     (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ kk) (list '<= (sipd-qd 'sca_ 'x_) (sipd-qd 'scb_ 'x_)))))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-sub-open! 'kk)
(let ((a (dk-skolem! (dk-cite! 'real-projection-point 'v 'kk 'x_))))
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) a)
  (dk-have! (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ kk) (list '<= (sipd-qd a 'x_) (sipd-qd 'scb_ 'x_))))
    (lambda ()
      (let* ((lk (dk-peel!)) (m (cadr (car lk))))
        (dk-cite! 'subset-mem-fwd 'kk '(VEC v) m)
        (let ((py (sipd-pyth-at! a m)))
          (sipd-q-facts! (sipd-sub m a)) (sipd-q-facts! (sipd-sub a 'x_)) (sipd-q-facts! (sipd-sub m 'x_))
          (dk-ineq! py (list '<= 0 (sipd-qd m a)))))))
  (witness! a (lambda () (dk-conj-close! dk-ass!))))
(sipd-qed! 'real-closest-point)
(alias! 'real-closest-point "the closest point of a closed subspace of a real Hilbert space (Proposition 1.20 for a subspace)")

;;; ... and it is the only one
(sp (make-wff (forall-guarded '(v kk x_ a1_ a2_) (append sipd-hyps '((IN x_ (VEC v)) (IN a1_ kk) (IN a2_ kk)))
   (list 'IMPLIES (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ kk) (list '<= (sipd-qd 'a1_ 'x_) (sipd-qd 'scb_ 'x_))))
   (list 'IMPLIES (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ kk) (list '<= (sipd-qd 'a2_ 'x_) (sipd-qd 'scb_ 'x_))))
         '(= a1_ a2_))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-sub-open! 'kk)
(let* ((mins (filter (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'scb_))) (dk-asms)))
       (p (dk-skolem! (dk-cite! 'real-projection-point 'v 'kk 'x_))))
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) p)
  (for-each
    (lambda (a)
      (dk-cite! 'subset-mem-fwd 'kk '(VEC v) a)
      (let* ((mn (find-first (lambda (f) (dk-contains? f (sipd-qd a 'x_))) mins))
             (le (dk-apply! mn p))
             (py (sipd-pyth-at! p a)))
        (sipd-q-facts! (sipd-sub a p)) (sipd-q-facts! (sipd-sub p 'x_)) (sipd-q-facts! (sipd-sub a 'x_))
        (dk-have! (list '= (sipd-qd a p) 0) (lambda () (dk-ineq! le py (list '<= 0 (sipd-qd a p)))))
        (dk-cite! 'phs-definite 'v (sipd-sub a p))
        (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v a p)))
    '(a1_ a2_))
  (subst (list '= 'a1_ p))
  (subst (list '= 'a2_ p))
  (sipd-close-eq!))
(sipd-qed! 'real-closest-point-unique)
(alias! 'real-closest-point-unique "the closest point of a closed subspace is unique")

;;; ==========================================================================================
;;; (10) STOP POINT D3: THE ORTHOGONAL PROJECTION P_M -- exists, unique, linear, idempotent.
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v kk pk x_)
   '((IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IN x_ (VEC v)))
   (list 'AND '(IN (pk x_) kk) (list 'IN (sipd-sub 'x_ '(pk x_)) '(SIP-PERP v kk))))))
(dk-peel!)
(let ((all (caddr (sipd-iff-fwd! 'is-real-orthogonal-projection 'v 'kk 'pk))))
  (dk-apply! all 'x_)
  (ass))
(sipd-qed! 'real-orthogonal-projection-apply)

(sp (make-wff (forall-guarded '(v kk pk) '((IS-REAL-ORTHOGONAL-PROJECTION v kk pk)) '(IN pk (FUN (VEC v) (VEC v))))))
(dk-peel!)
(sipd-iff-fwd! 'is-real-orthogonal-projection 'v 'kk 'pk)
(ass)
(sipd-qed! 'real-orthogonal-projection-type)

(define (sipd-pk! pk x)                   ; land pk(x) in kk, x - pk(x) in perp, both in VEC
  (let ((px (list pk x)))
    (if (not (dk-asm? (list 'IN px 'kk)))
        (begin
          (dk-split! (dk-cite! 'real-orthogonal-projection-apply 'v 'kk pk x))
          (dk-cite! 'subset-mem-fwd 'kk '(VEC v) px)
          (dk-cite! 'subset-mem-fwd '(SIP-PERP v kk) '(VEC v) (sipd-sub x px))))
    px))
(define (sipd-pk-open!)
  (fact 'phs-is-sip 'v)
  (sipd-pin!)
  (sipd-sub-open! 'kk)
  (dk-cite! 'sip-perp-subset 'v 'kk)
  (dk-cite! 'sip-perp-is-submodule 'v 'kk)
  (dk-cite! 'sip-scal-carr 'v))

(define (sipd-op-set z) (list 'SEP 'sroa_ 'kk (list 'IN (sipd-sub z 'sroa_) '(SIP-PERP v kk))))
(sp (make-wff (forall-guarded '(v kk) sipd-hyps '(FORSOME srpk_ (IS-REAL-ORTHOGONAL-PROJECTION v kk srpk_)))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(sipd-sub-open! 'kk)
(fact 'sip-vec-set 'v)
(define (sipd-op-choice! z)
  (let* ((ss (sipd-op-set z)) (mem (list 'IN (list 'CHOICE ss) ss)))
    (if (not (dk-asm? mem))
        (let ((a (dk-skolem! (dk-cite! 'real-projection-point 'v 'kk z))))
          (choose-mem! ss a (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (sep-me mem)
    (dk-split-all!)
    (list 'CHOICE ss)))
(let* ((gv (dk-abstract! '(VEC v) '(VEC v) (lambda (z) (list 'CHOICE (sipd-op-set z)))
                         (lambda (z) (let ((c (sipd-op-choice! z)))
                                       (dk-cite! 'subset-mem-fwd 'kk '(VEC v) c) (ass)))))
       (g (car gv))
       (ve (cdr gv)))
  (dk-have! (list 'FORALL 'sop_ (list 'IMPLIES '(IN sop_ (VEC v))
              (list 'AND (list 'IN (list g 'sop_) 'kk) (list 'IN (sipd-sub 'sop_ (list g 'sop_)) '(SIP-PERP v kk)))))
    (lambda ()
      (let* ((lk (dk-peel!)) (z (cadr (car lk))))
        (sipd-op-choice! z)
        (subst (dk-apply! ve z))
        (dk-conj-close! dk-ass!))))
  (witness! g (lambda () (sipd-iff-bwd! 'is-real-orthogonal-projection 'v 'kk g) (ass))))
(sipd-qed! 'real-orthogonal-projection-exists)
(alias! 'real-orthogonal-projection-exists "the orthogonal projection onto a closed subspace of a real Hilbert space exists")

(sp (make-wff (forall-guarded '(v kk pk qk)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IS-REAL-ORTHOGONAL-PROJECTION v kk qk))
   '(= pk qk))))
(dk-peel!)
(sipd-pk-open!)
(dk-cite! 'real-orthogonal-projection-type 'v 'kk 'pk)
(dk-cite! 'real-orthogonal-projection-type 'v 'kk 'qk)
(dk-have! '(FORALL sox_ (IMPLIES (IN sox_ (VEC v)) (= (pk sox_) (qk sox_))))
  (lambda ()
    (let* ((lk (dk-peel!)) (x (cadr (car lk)))
           (px (sipd-pk! 'pk x)) (qx (sipd-pk! 'qk x)))
      (sipd-vec-eq! (sipd-add px (sipd-sub x px)) (sipd-add qx (sipd-sub x qx)))
      (dk-split! (dk-cite! 'real-decomposition-unique 'v 'kk px qx (sipd-sub x px) (sipd-sub x qx)))
      (ass))))
(sipd-iff-fwd! 'fun-codomain-iff '(VEC v) '(VEC v) 'pk)
(sipd-iff-fwd! 'fun-codomain-iff '(VEC v) '(VEC v) 'qk)
(dk-cite! 'fun-domain-extensionality '(VEC v) 'pk 'qk)
(ass)
(sipd-qed! 'real-orthogonal-projection-unique)

(sp (make-wff (forall-guarded '(v kk pk x_ y_)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IN x_ (VEC v)) (IN y_ (VEC v)))
   '(= (pk ((VADD v) x_ y_)) ((VADD v) (pk x_) (pk y_))))))
(dk-peel!)
(sipd-pk-open!)
(let* ((s (sipd-add 'x_ 'y_))
       (ps (begin (sipd-vt s) (sipd-pk! 'pk s)))
       (px (sipd-pk! 'pk 'x_)) (py (sipd-pk! 'pk 'y_))
       (a2 (sipd-add px py))
       (b2 (sipd-add (sipd-sub 'x_ px) (sipd-sub 'y_ py))))
  (dk-cite! 'submodule-vadd-closed 'v 'kk px py)
  (dk-cite! 'submodule-vadd-closed 'v '(SIP-PERP v kk) (sipd-sub 'x_ px) (sipd-sub 'y_ py))
  (sipd-vec-eq! (sipd-add ps (sipd-sub s ps)) (sipd-add a2 b2))
  (dk-split! (dk-cite! 'real-decomposition-unique 'v 'kk ps a2 (sipd-sub s ps) b2))
  (ass))
(sipd-qed! 'real-orthogonal-projection-additive)

(sp (make-wff (forall-guarded '(v kk pk c_ x_)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IN c_ RR) (IN x_ (VEC v)))
   '(= (pk ((ACT v) c_ x_)) ((ACT v) c_ (pk x_))))))
(dk-peel!)
(sipd-pk-open!)
(dk-have! '(IN c_ (CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) RR)) (ass)))
(let* ((s (sipd-act 'c_ 'x_))
       (ps (begin (sipd-vt s) (sipd-pk! 'pk s)))
       (px (sipd-pk! 'pk 'x_))
       (a2 (sipd-act 'c_ px))
       (b2 (sipd-act 'c_ (sipd-sub 'x_ px))))
  (dk-cite! 'submodule-act-closed 'v 'kk 'c_ px)
  (dk-cite! 'submodule-act-closed 'v '(SIP-PERP v kk) 'c_ (sipd-sub 'x_ px))
  (sipd-vec-eq! (sipd-add ps (sipd-sub s ps)) (sipd-add a2 b2))
  (dk-split! (dk-cite! 'real-decomposition-unique 'v 'kk ps a2 (sipd-sub s ps) b2))
  (ass))
(sipd-qed! 'real-orthogonal-projection-homogeneous)

(sp (make-wff (forall-guarded '(v kk pk y_)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IN y_ kk))
   '(= (pk y_) y_))))
(dk-peel!)
(sipd-pk-open!)
(dk-cite! 'subset-mem-fwd 'kk '(VEC v) 'y_)
(dk-cite! 'submodule-vzero-in 'v '(SIP-PERP v kk))
(let ((py (sipd-pk! 'pk 'y_)))
  (sipd-vec-eq! (sipd-add py (sipd-sub 'y_ py)) (sipd-add 'y_ '(VZERO v)))
  (dk-split! (dk-cite! 'real-decomposition-unique 'v 'kk py 'y_ (sipd-sub 'y_ py) '(VZERO v)))
  (ass))
(sipd-qed! 'real-orthogonal-projection-fixes)

(sp (make-wff (forall-guarded '(v kk pk x_)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk) (IN x_ (VEC v)))
   '(= (pk (pk x_)) (pk x_)))))
(dk-peel!)
(dk-split! (dk-cite! 'real-orthogonal-projection-apply 'v 'kk 'pk 'x_))
(dk-cite! 'real-orthogonal-projection-fixes 'v 'kk 'pk '(pk x_))
(ass)
(sipd-qed! 'real-orthogonal-projection-idempotent)
(alias! 'real-orthogonal-projection-idempotent "the orthogonal projection is idempotent")

;;; ==========================================================================================
;;; (11) THE COMPLEX COROLLARY: a complex structure J (real-linear, antisymmetric) leaving a
;;; closed subspace M invariant leaves M-perp invariant, and P_M commutes with J.
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v kk jo)
   '((IS-SEMI-INNER-PRODUCT-SPACE v) (SUBSET kk (VEC v)) (IN jo (FUN (VEC v) (VEC v))) (IS-ANTISYMMETRIC-OP v jo)
     (FORALL sjk_ (IMPLIES (IN sjk_ kk) (IN (jo sjk_) kk))))
   '(FORALL sjz_ (IMPLIES (IN sjz_ (SIP-PERP v kk)) (IN (jo sjz_) (SIP-PERP v kk)))))))
(set! sipd-lk0 (dk-peel!))
(sipd-pin!)
(dk-cite! 'sip-perp-subset 'v 'kk)
(let* ((inv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sjk_))) "the invariance"))
       (anti (sipd-iff-fwd! 'is-antisymmetric-op 'v 'jo))
       (z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(SIP-PERP v kk)))) sipd-lk0)))
       (jz (list 'jo z)))
  (dk-cite! 'subset-mem-fwd '(SIP-PERP v kk) '(VEC v) z)
  (dk-cite! 'fun-apply-type-c 'jo '(VEC v) '(VEC v) z)
  (dk-have! (list 'FORALL 'spk_ (list 'IMPLIES '(IN spk_ kk) (list '= (sipd-ip jz 'spk_) 0)))
    (lambda ()
      (let* ((lk2 (dk-peel!)) (k (cadr (car lk2))) (jk (list 'jo k)))
        (dk-cite! 'subset-mem-fwd 'kk '(VEC v) k)
        (dk-apply! inv k)
        (let ((e (dk-apply! anti z k))
              (o (dk-cite! 'sip-perp-orth 'v 'kk z jk)))
          (subst e)
          (subst o)
          (crs)))))
  (sipd-iff-bwd! 'sip-perp-membership 'v 'kk jz)
  (ass))
(sipd-qed! 'sip-perp-invariant)
(alias! 'sip-perp-invariant "an antisymmetric operator leaving a set invariant leaves its orthogonal complement invariant")

(sp (make-wff (forall-guarded '(v kk pk jo)
   '((IS-PRE-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-REAL-ORTHOGONAL-PROJECTION v kk pk)
     (IS-REAL-LINEAR-OP v jo) (IS-ANTISYMMETRIC-OP v jo)
     (FORALL sjk_ (IMPLIES (IN sjk_ kk) (IN (jo sjk_) kk))))
   '(FORALL sjx_ (IMPLIES (IN sjx_ (VEC v)) (= (pk (jo sjx_)) (jo (pk sjx_))))))))
(set! sipd-lk0 (dk-peel!))
(sipd-pk-open!)
(let* ((inv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sjk_))) "the invariance"))
       (lin (sipd-iff-fwd! 'is-real-linear-op 'v 'jo))
       (addu (cadr (caddr lin)))
       (pinv (dk-cite! 'sip-perp-invariant 'v 'kk 'jo))
       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC v)))) sipd-lk0)))
       (jx (list 'jo x)))
  (dk-cite! 'fun-apply-type-c 'jo '(VEC v) '(VEC v) x)
  (let* ((px (sipd-pk! 'pk x))
         (r (sipd-sub x px))
         (pjx (sipd-pk! 'pk jx))
         (a2 (list 'jo px))
         (b2 (list 'jo r)))
    (dk-apply! inv px)
    (dk-apply! pinv r)
    (dk-cite! 'fun-apply-type-c 'jo '(VEC v) '(VEC v) px)
    (dk-cite! 'fun-apply-type-c 'jo '(VEC v) '(VEC v) r)
    (let* ((e2 (dk-apply! addu px r))
           (e3 (sipd-vec-eq! (sipd-add px r) x))
           (e1 (sipd-vec-eq! (sipd-add pjx (sipd-sub jx pjx)) jx)))
      (dk-have! (list '= (sipd-add pjx (sipd-sub jx pjx)) (sipd-add a2 b2))
        (lambda ()
          (subst e1)
          (subst (list '= (sipd-add a2 b2) (list 'jo (sipd-add px r))))
          (subst e3)
          (sipd-close-eq!)))
      (dk-split! (dk-cite! 'real-decomposition-unique 'v 'kk pjx a2 (sipd-sub jx pjx) b2))
      (ass))))
(sipd-qed! 'real-projection-commutes)
(alias! 'real-projection-commutes "the orthogonal projection onto a J-invariant subspace commutes with J (stop point D3)")

;;; ==========================================================================================
;;; (12) TOWARDS PROPOSITION 1.20 FOR A CONVEX SET: what does not need the existence argument.
;;; The closest point of a convex set is unique (the notes' (26) at the midpoint), and the
;;; variational inequality <x - a, c - a> <= 0 on cs makes a a closest point.  EXISTENCE is not
;;; proved here: see the file header and the report.
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v cs x_ a_ b_)
   '((IS-PRE-HILBERT-SPACE v) (IS-CONVEX-SUBSET v cs) (IN x_ (VEC v)) (IN a_ cs) (IN b_ cs))
   (list 'IMPLIES (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-qd 'a_ 'x_) (sipd-qd 'scc_ 'x_))))
   (list 'IMPLIES (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-qd 'b_ 'x_) (sipd-qd 'scc_ 'x_))))
         '(= a_ b_))))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-pin!)
(let* ((mins (filter (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'scc_))) (dk-asms)))
       (ma (find-first (lambda (f) (dk-contains? f (sipd-qd 'a_ 'x_))) mins))
       (mb (find-first (lambda (f) (dk-contains? f (sipd-qd 'b_ 'x_))) mins))
       (cv (sipd-iff-fwd! 'is-convex-subset 'v 'cs))
       (all (caddr cv))
       (m (list '(VADD v) (list '(ACT v) '(- 1 1/2) 'a_) (list '(ACT v) 1/2 'b_))))
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) 'a_)
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) 'b_)
  (dk-have! '(IN 1/2 RR) (lambda () (arith)))
  (dk-have! '(<= 0 1/2) (lambda () (arith)))
  (dk-have! '(<= 1/2 1) (lambda () (arith)))
  (dk-apply! all 'a_ 'b_ 1/2)
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) m)
  (let* ((la (dk-apply! ma m))
         (lb (dk-apply! mb m))
         (d (sipd-sub 'a_ 'b_))
         (j (list '= (sipd-q d) (list '- (list '+ (list '* 2 (sipd-qd 'a_ 'x_)) (list '* 2 (sipd-qd 'b_ 'x_)))
                                         (list '* 4 (sipd-qd m 'x_))))))
    (sipd-ip-eq! j)
    (sipd-q-facts! d) (sipd-q-facts! (sipd-sub 'a_ 'x_)) (sipd-q-facts! (sipd-sub 'b_ 'x_)) (sipd-q-facts! (sipd-sub m 'x_))
    (dk-have! (list '= (sipd-q d) 0) (lambda () (dk-ineq! j la lb (list '<= 0 (sipd-q d)))))
    (dk-cite! 'phs-definite 'v d)
    (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v 'a_ 'b_)
    (ass)))
(sipd-qed! 'real-convex-closest-unique)
(alias! 'real-convex-closest-unique "the closest point of a convex set is unique (Proposition 1.20, uniqueness)")

(sp (make-wff (forall-guarded '(v cs x_ a_)
   '((IS-SEMI-INNER-PRODUCT-SPACE v) (SUBSET cs (VEC v)) (IN x_ (VEC v)) (IN a_ cs))
   (list 'IMPLIES (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub 'scc_ 'a_)) 0)))
         (list 'FORALL 'scd_ (list 'IMPLIES '(IN scd_ cs) (list '<= (sipd-qd 'a_ 'x_) (sipd-qd 'scd_ 'x_))))))))
(set! sipd-lk0 (dk-peel!))
(sipd-pin!)
(let* ((vi (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'scc_))) "the variational inequality"))
       (c (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cs) (not (eq? (cadr f) 'a_)))) sipd-lk0))))
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) 'a_)
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) c)
  (let* ((le (dk-apply! vi c))
         (o (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub c 'a_)))
         (j (list '= (sipd-qd c 'x_) (list '- (list '+ (sipd-qd 'a_ 'x_) (sipd-qd c 'a_)) (list '* 2 o)))))
    (sipd-ip-eq! j)
    (sipd-ft (sipd-sub 'x_ 'a_) (sipd-sub c 'a_))
    (sipd-q-facts! (sipd-sub c 'x_)) (sipd-q-facts! (sipd-sub 'a_ 'x_)) (sipd-q-facts! (sipd-sub c 'a_))
    (dk-ineq! j le (list '<= 0 (sipd-qd c 'a_)))))
(sipd-qed! 'real-convex-variational-closest)
(alias! 'real-convex-variational-closest "the variational inequality makes a point of a set its closest point")

;;; ==========================================================================================
;;; THE CLOSEST POINT OF A CLOSED CONVEX SET (SIP-D2, 2026-10-19).  Spliced 2026-10-20 from
;;; theorem-library/sip-d2.scm (original in archive/2026-10-20-wiring/); its copies of this file's
;;; sipd- helpers were dropped and their uses renamed; the helpers it alone needs keep the prefix sd2-.
;;; The header of sip-d2.scm follows.
;;; ==========================================================================================
;;; (was sip-d2.scm) THE CLOSEST POINT OF A CLOSED CONVEX SET in a real Hilbert space, by the
;;; COMPLEXIFICATION route, and the variational inequality (the notes' Proposition 1.20).
;;; (SIP-D2, 2026-10-19; scratchpad/triage/SIP-D2.md.)  All PROVEN modulo 0.  Vocabulary:
;;; structure-library/sip-hilbert-vocab.scm (IS-REAL-HILBERT-SPACE, IS-CONVEX-SUBSET).
;;;
;;; Source: the user's notes topological-vector-space.pdf, Ch. 1 s.3, Proposition 1.20.
;;;
;;; THE ROUTE (the user's decision, 2026-10-19).  For a real Hilbert space v,
;;; w = CSIP-CIPS(COMPLEXIFY(v)) is a complex Hilbert space (complexify-hilbert, sip-d1.scm).
;;; A convex set cs of v gives the set cs x cs of w; it is closed when cs is
;;; (complexify-closed), nonempty when cs is, and closed under MIDPOINTS -- the midpoint of
;;; two pairs, (1/2)(p + q) with the real scalar 1/2 = 1/2 + 0 i, is the pair of the convex
;;; combinations (1 - 1/2) p_i + (1/2) q_i.  (It is not a complex subspace, nor convex for
;;; complex scalars: only midpoints are asked.)  hilbert-closest-point-midpoint
;;; (hilbert-projection.scm) at the point (x, 0) gives a pair (a, b) of cs x cs with
;;;   |a - x|^2 + |b|^2 = d_w((a, b), (x, 0))^2 <= d_w((c, b), (x, 0))^2 = |c - x|^2 + |b|^2
;;; for every c in cs, so a is the closest point of cs to x.  No parallelogram or
;;; minimizing-sequence argument is run here.
;;;
;;; WHY cs x cs AND NOT cs x {0} (the brief's wording): both are closed under midpoints and
;;; both give the same a; cs x cs is closed by complexify-closed as it stands, while
;;; cs x {0} wants a closedness lemma for a product A x B of two different sets (the
;;; complexify-closure-comp lemmas are stated for kk x kk) and the closedness of {0}.
;;;
;;; THE VARIATIONAL INEQUALITY, NECESSARY: a closest point a of a convex set satisfies
;;; <x - a, c - a> <= 0 for c in cs.  From |a - x|^2 <= |(1-t) a + t c - x|^2 for t in
;;; [0, 1]:  2 t o <= t^2 q with o = <x - a, c - a>, q = |c - a|^2.  If o > 0, rr-scale-eps
;;; gives s > 0 with q t <= o for 0 <= t <= s; at t = s (when s <= 1) 2 s o <= s (s q) <= s o,
;;; and at t = 1 (when 1 < s) 2 o <= q <= o; both contradict o > 0.  No division.
;;; Sufficiency is real-convex-variational-closest (sip-d1.scm), uniqueness
;;; real-convex-closest-unique (sip-d1.scm).
;;;
;;; hilbert-closest-point-midpoint is in theorem-library/hilbert-projection (spliced there
;;; from hp-midpoint.scm, 2026-10-20).

;;; ==========================================================================================
;;; THE EXPANSION KIT on the real form (the `hpr-' device of hilbert-projection.scm, real case:
;;; no conjugation; symmetry instead).
;;; ==========================================================================================


;;; ==========================================================================================
;;; (3) THE COMPLEXIFICATION AS A COMPLEX INNER PRODUCT SPACE: w = CSIP-CIPS(COMPLEXIFY(v)).
;;; Its operations on pairs, read through the read-offs of sip-b.scm.
;;; ==========================================================================================


;;; ==========================================================================================
;;; (1) Two facts about w = CSIP-CIPS(COMPLEXIFY v)
;;; ==========================================================================================
(define (sd2-wsub p q) (list (sipd-w-acc 'VADD) p (list (sipd-w-acc 'VNEG) q)))
(define (sd2-wqd p q) (let ((d (sd2-wsub p q))) (list (sipd-w-acc 'IP) d d)))
(define sd2-mm '(CARTESIAN cs cs))

;;; the squared distance of w: <p - q, p - q>_w = |p1 - q1|^2 + |p2 - q2|^2
(sipd-sp-phs (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
               (list '= (sd2-wqd 'px_ 'qx_) (sipd-qsum 'px_ 'qx_))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(dk-cite! 'cxw-is-cips 'v)
(sipd-open-pair! 'px_) (sipd-open-pair! 'qx_)
(let* ((nq (list 'LIST (list '(VNEG v) (sipd-n1 'qx_)) (list '(VNEG v) (sipd-n2 'qx_))))
       (d (list 'LIST (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)) (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))))
  (sipd-pair-in! nq) (sipd-pair-in! d)
  (subst (dk-cite! 'cxw-vneg-value 'v 'qx_))
  (subst (dk-cite! 'cxw-vadd-value 'v 'px_ nq))
  (nth-r)
  (subst (dk-cite! 'cxw-ip-self 'v d))
  (nth-r)
  (sipd-ft (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)) (sipd-sub (sipd-n1 'px_) (sipd-n1 'qx_)))
  (sipd-ft (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)) (sipd-sub (sipd-n2 'px_) (sipd-n2 'qx_)))
  (dk-real! (sipd-qsum 'px_ 'qx_))
  (sipd-close-eq!))
(sipd-qed! 'cxw-dist-sq)
(alias! 'cxw-dist-sq "the squared distance of the complexification is the sum of the squared distances of the components")

;;; cs x cs is closed under midpoints in w, for cs convex
(define (sd2-midclosed ks)
  (list 'FORALL 'hm1_ (list 'IMPLIES (list 'IN 'hm1_ ks)
    (list 'FORALL 'hm2_ (list 'IMPLIES (list 'IN 'hm2_ ks)
      (list 'IN (list (sipd-w-acc 'ACT) 1/2 (list (sipd-w-acc 'VADD) 'hm1_ 'hm2_)) ks))))))
(sipd-sp-phs (list 'FORALL 'cs (list 'IMPLIES '(IS-CONVEX-SUBSET v cs) (sd2-midclosed sd2-mm))))
(define sd2-lk (dk-peel!))
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(let* ((cv (sipd-iff-fwd! 'is-convex-subset 'v 'cs))
       (all (caddr cv))
       (sm (caddr (cadr (dk-goal))))       ; the goal: (IN ((ACT w) 1/2 ((VADD w) p q)) cs x cs)
       (p (cadr sm)) (q (caddr sm)))
  (sipd-in-kk-pair! p 'cs)
  (sipd-in-kk-pair! q 'cs)
  (let* ((s1 (sipd-add (sipd-n1 p) (sipd-n1 q)))
         (s2 (sipd-add (sipd-n2 p) (sipd-n2 q)))
         (sl (list 'LIST s1 s2)))
    (subst (dk-cite! 'cxw-vadd-value 'v p q))
    (sipd-pair-in! sl)
    (dk-have! '(IN 1/2 CC) (lambda () (arith)))
    (dk-have! '(IN 1/2 RR) (lambda () (arith)))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (subst (dk-cite! 'cxw-act-value 'v 1/2 sl))
    (nth-r)
    (dk-have! '(= 1/2 (+ 1/2 (* 0 +i))) (lambda () (crs)))
    (dk-split-all! (list (dk-cite! 'cc-re-im-of 1/2 1/2 0)))
    (subst '(= (real-part 1/2) 1/2))
    (subst '(= (imag-part 1/2) 0))
    (dk-have! '(<= 0 1/2) (lambda () (arith)))
    (dk-have! '(<= 1/2 1) (lambda () (arith)))
    (let* ((g (cadr (dk-goal)))             ; (LIST comp1 comp2)
           (k1 (cadr g)) (k2 (caddr g))
           (m1 (dk-apply! all (sipd-n1 p) (sipd-n1 q) 1/2))
           (m2 (dk-apply! all (sipd-n2 p) (sipd-n2 q) 1/2))
           (c1 (cadr m1)) (c2 (cadr m2)))
      (sipd-vec-eq! k1 c1)
      (sipd-vec-eq! k2 c2)
      (subst (list '= k1 c1))
      (subst (list '= k2 c2))
      (dk-cite! 'pair-in-cartesian 'cs 'cs c1 c2)
      (if (not (proof-done? *ps*)) (ass)))))
(sipd-qed! 'cxw-convex-midpoint-closed)
(alias! 'cxw-convex-midpoint-closed "for a convex set C, C x C is closed under midpoints in the complexification")

;;; ==========================================================================================
;;; (2) PROPOSITION 1.20: the closest point of a nonempty closed convex set exists
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v cs x_)
   (list '(IS-REAL-HILBERT-SPACE v) '(IS-CONVEX-SUBSET v cs) '(FORSOME sne_ (IN sne_ cs))
         '(IS-CLOSED (SIP-METRIC-SPACE v) cs) '(IN x_ (VEC v)))
   (list 'FORSOME 'sca_ (list 'AND '(IN sca_ cs)
     (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ cs) (list '<= (sipd-qd 'sca_ 'x_) (sipd-qd 'scb_ 'x_)))))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(sipd-cx-base!)
(dk-cite! 'complexify-hilbert 'v)
(dk-cite! 'cxw-vec 'v)
(dk-cite! 'cxw-is-cips 'v)
(dk-cite! 'cxw-convex-midpoint-closed 'v 'cs)
(dk-cite! 'complexify-closed 'v 'cs)
(let* ((cv (sipd-iff-fwd! 'is-convex-subset 'v 'cs))
       (c0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'sne_)))
                                "the nonemptiness of cs")))
       (xi '(LIST x_ (VZERO v))))
  (sipd-mm-sub! 'cs)
  (dk-rewrite-h! (list 'SUBSET sd2-mm sipd-pairs) sipd-pairs (sipd-w-acc 'VEC))
  (dk-cite! 'pair-in-cartesian 'cs 'cs c0 c0)
  (dk-have! (list 'FORSOME 'hke_ (list 'IN 'hke_ sd2-mm))
    (lambda () (witness! (list 'LIST c0 c0) (lambda () (ass)))))
  (sipd-pair-in! xi)
  (dk-rewrite-h! (list 'IN xi sipd-pairs) sipd-pairs (sipd-w-acc 'VEC))
  (let* ((p (dk-skolem! (dk-cite! 'hilbert-closest-point-midpoint sipd-w sd2-mm xi)))
         (mn (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hdp_) (memq p (free-vars f))))
                      "the minimality of the pair"))
         (a (sipd-n1 p)) (b (sipd-n2 p)))
    (sipd-in-kk-pair! p 'cs)
    (dk-have! (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ cs) (list '<= (sipd-qd a 'x_) (sipd-qd 'scb_ 'x_))))
      (lambda ()
        (let* ((lk (dk-peel!)) (c (cadr (car lk))) (q (list 'LIST c b)))
          (dk-cite! 'subset-mem-fwd 'cs '(VEC v) c)
          (dk-cite! 'pair-in-cartesian 'cs 'cs c b)
          (sipd-pair-in! q)
          (let* ((le (dk-apply! mn q))
                 (e1 (dk-nth-h! (dk-cite! 'cxw-dist-sq 'v p xi)))
                 (e2 (dk-nth-h! (dk-cite! 'cxw-dist-sq 'v q xi)))
                 (l1 (dk-rewrite-h! le (cadr e1) (caddr e1)))
                 (l2 (dk-rewrite-h! l1 (cadr e2) (caddr e2))))
            (sipd-q-facts! (sipd-sub a 'x_))
            (sipd-q-facts! (sipd-sub c 'x_))
            (sipd-q-facts! (sipd-sub b '(VZERO v)))
            (dk-ineq! l2)))))
    (witness! a (lambda () (dk-conj-close! dk-ass!)))))
(sipd-qed! 'real-convex-closest-point)
(alias! 'real-convex-closest-point "the closest point of a nonempty closed convex set of a real Hilbert space exists (Proposition 1.20)")

;;; ==========================================================================================
;;; (3) THE VARIATIONAL INEQUALITY IS NECESSARY: a closest point a of a convex set has
;;; <x - a, c - a> <= 0 for every c of the set (semidefinite form suffices).
;;; ==========================================================================================
;; at t in [0, 1] (typed, with its bounds in context): the convex point m_t, the minimality
;; at it, and |m_t - x|^2 = |a - x|^2 + (TT - 2 TO) with TT, TO the names given.  Returns
;; (le . id).
(define (sd2-at-t! all mn c qa tv to-name tt-name to-term tt-term)
  (let* ((m (dk-apply! all 'a_ c tv))
         (mt (cadr m))
         (le (begin (dk-cite! 'subset-mem-fwd 'cs '(VEC v) mt) (dk-apply! mn mt)))
         (qm (sipd-qd mt 'x_))
         (id (list '= qm (list '+ qa (list '- tt-name (list '* 2 to-name))))))
    (sipd-q-facts! (sipd-sub mt 'x_))
    (dk-have! id
      (lambda ()
        (if (not (equal? to-name to-term)) (subst (list '= to-name to-term)))
        (if (not (equal? tt-name tt-term)) (subst (list '= tt-name tt-term)))
        (sipd-expand!)
        (if (not (proof-done? *ps*)) (crs))))
    (cons le id)))

(sp (make-wff (forall-guarded '(v cs x_ a_)
   '((IS-SEMI-INNER-PRODUCT-SPACE v) (IS-CONVEX-SUBSET v cs) (IN x_ (VEC v)) (IN a_ cs))
   (list 'IMPLIES (list 'FORALL 'scd_ (list 'IMPLIES '(IN scd_ cs) (list '<= (sipd-qd 'a_ 'x_) (sipd-qd 'scd_ 'x_))))
         (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub 'scc_ 'a_)) 0)))))))
(set! sipd-lk0 (dk-peel!))
(sipd-pin!)
(let* ((mn (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'scd_))) "the minimality of a"))
       (c (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cs) (not (eq? (cadr f) 'a_)))) sipd-lk0)))
       (cv (sipd-iff-fwd! 'is-convex-subset 'v 'cs))
       (all (caddr cv))
       (o (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub c 'a_)))
       (q (sipd-qd c 'a_))
       (qa (sipd-qd 'a_ 'x_)))
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) 'a_)
  (dk-cite! 'subset-mem-fwd 'cs '(VEC v) c)
  (sipd-ft (sipd-sub 'x_ 'a_) (sipd-sub c 'a_))
  (sipd-q-facts! (sipd-sub c 'a_))
  (sipd-q-facts! (sipd-sub 'a_ 'x_))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! '(IN 1 RR) (lambda () (arith)))
  (use-em (list '<= o 0)
    (lambda () (ass))
    (lambda ()
      (dk-cite! 'rr-not-le-lt o 0)
      (dk-cite! 'rr-pos-rr-of-lt o)
      (let* ((s (dk-skolem! (dk-cite! 'rr-scale-eps q o)))
             (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq s (free-vars f))))
                             "the rr-scale-eps universal")))
        (dk-cite! 'rr-pos-rr-in-rr s)
        (dk-cite! 'rr-lt-of-pos-rr s)
        (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
        (use-em (list '<= s 1)
          (lambda ()                        ; t = s:  2 s o <= s (s q) <= s o, and s o > 0
            (dk-have! (list '<= s s) (lambda () (dk-ineq!)))
            (let* ((sm (dk-apply! small s))  ; q s <= o
                   (so (list '* s o))
                   (sq (list '* s q))
                   (ssq (list '* s sq)))
              (dk-have! (list 'IN so 'RR) (lambda () (type-term)))
              (dk-have! (list 'IN sq 'RR) (lambda () (type-term)))
              (dk-have! (list 'IN ssq 'RR) (lambda () (type-term)))
              (let* ((na (dk-name! so))
                     (nb (dk-name! ssq))
                     (r (sd2-at-t! all mn c qa s na nb so ssq))
                     (pos (dk-rewrite-h! (dk-cite! 'rr-mul-pos s o) so na))
                     (qs (begin (dk-have! (list 'IN (list '* q s) 'RR) (lambda () (type-term))) (list '* q s)))
                     (mul (dk-cite! 'rr-mul-le-right qs o s)))
                (dk-have! (list '= ssq (list '* (list '* q s) s)) (lambda () (crs)))
                (dk-have! (list '= so (list '* o s)) (lambda () (crs)))
                (dk-have! (list '<= nb na)
                  (lambda ()
                    (subst (list '= nb ssq)) (subst (list '= na so))
                    (subst (list '= ssq (list '* (list '* q s) s)))
                    (subst (list '= so (list '* o s)))
                    (ass)))
                (dk-ineq! (car r) (cdr r) (list '<= nb na) pos))))
          (lambda ()                        ; 1 < s, t = 1:  2 o <= q <= o
            (dk-cite! 'rr-not-le-lt s 1)
            (dk-have! '(<= 0 1) (lambda () (arith)))
            (dk-have! '(<= 1 1) (lambda () (arith)))
            (dk-have! (list '<= 1 s) (lambda () (dk-ineq! (list '< 1 s))))
            (let* ((sm (dk-apply! small 1))  ; q * 1 <= o
                   (r (sd2-at-t! all mn c qa 1 o q o q)))
              (dk-ineq! (car r) (cdr r) sm (list '< 0 o)))))))))
(sipd-qed! 'real-convex-variational-necessary)
(alias! 'real-convex-variational-necessary "a closest point of a convex set satisfies the variational inequality (Proposition 1.20)")

;;; ==========================================================================================
;;; (4) PROPOSITION 1.20 AS THE NOTES STATE IT (with the nonemptiness the notes leave tacit):
;;; there is a unique closest point; and the closest point is CHARACTERISED by the
;;; variational inequality.
;;; ==========================================================================================
(define (sd2-closest y) (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-qd y 'x_) (sipd-qd 'scc_ 'x_)))))
;;; cite THM at ARGS and detach what is left of the chain (each antecedent must be in context)
(define (sd2-cite-all! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (dk-head-is? r 'IMPLIES) (loop (dk-landed-1 (lambda () (detach! r)))) r)))

(sp (make-wff (forall-guarded '(v cs x_)
   (list '(IS-REAL-HILBERT-SPACE v) '(IS-CONVEX-SUBSET v cs) '(FORSOME sne_ (IN sne_ cs))
         '(IS-CLOSED (SIP-METRIC-SPACE v) cs) '(IN x_ (VEC v)))
   (list 'FORSOME 'sca_ (list 'AND '(IN sca_ cs)
     (list 'AND (sd2-closest 'sca_)
       (list 'FORALL 'scb_ (list 'IMPLIES '(IN scb_ cs) (list 'IMPLIES (sd2-closest 'scb_) '(= scb_ sca_))))))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(let ((a (dk-skolem! (dk-cite! 'real-convex-closest-point 'v 'cs 'x_))))
  (witness! a
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'scb_))
              (let* ((lk (dk-peel!))
                     (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cs))) lk))))
                (sd2-cite-all! 'real-convex-closest-unique 'v 'cs 'x_ b a)
                (ass))
              (ass)))))))
(sipd-qed! 'real-convex-closest-point-unique)
(alias! 'real-convex-closest-point-unique "a nonempty closed convex set of a real Hilbert space has exactly one closest point to each x (Proposition 1.20)")

(sp (make-wff (forall-guarded '(v cs x_ a_)
   '((IS-SEMI-INNER-PRODUCT-SPACE v) (IS-CONVEX-SUBSET v cs) (IN x_ (VEC v)) (IN a_ cs))
   (list 'IFF (list 'FORALL 'scd_ (list 'IMPLIES '(IN scd_ cs) (list '<= (sipd-qd 'a_ 'x_) (sipd-qd 'scd_ 'x_))))
              (list 'FORALL 'scc_ (list 'IMPLIES '(IN scc_ cs) (list '<= (sipd-ip (sipd-sub 'x_ 'a_) (sipd-sub 'scc_ 'a_)) 0)))))))
(dk-peel!)
(sipd-pin!)
(sipd-iff-fwd! 'is-convex-subset 'v 'cs)
(dk-iff! (lambda (g) (dk-contains? g 'scc_))
  (lambda () (sd2-cite-all! 'real-convex-variational-necessary 'v 'cs 'x_ 'a_) (ass))
  (lambda () (sd2-cite-all! 'real-convex-variational-closest 'v 'cs 'x_ 'a_) (ass)))
(sipd-qed! 'real-convex-closest-iff-variational)
(alias! 'real-convex-closest-iff-variational "a point of a convex set is the closest point to x iff <x - a, c - a> <= 0 on the set")
