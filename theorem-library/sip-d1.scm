(define sipd-ms (list 'IP-METRIC-SPACE sipd-w))
(define sipd-mv '(SIP-METRIC-SPACE v))
(sp (make-wff '(FORALL v (IMPLIES (IS-REAL-HILBERT-SPACE v) (IS-COMPLETE (IP-METRIC-SPACE (CSIP-CIPS (COMPLEXIFY v))))))))
(dk-peel!)
