(sipd-sp-phs (forall-guarded '(px_ qx_) (list (list 'IN 'px_ sipd-pairs) (list 'IN 'qx_ sipd-pairs))
               (list '<= (sipd-dw 'px_ 'qx_)
                     (list '+ (sipd-dv (sipd-n1 'px_) (sipd-n1 'qx_)) (sipd-dv (sipd-n2 'px_) (sipd-n2 'qx_))))))
(dk-peel!)
