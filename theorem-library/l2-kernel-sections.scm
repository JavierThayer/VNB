;;; l2b-c.scm -- L^2 KERNELS: SECTIONS AND THE INTEGRAL OPERATOR ON CLASSES (TH3-L2B,
;;; 2026-11-09).  Helper prefix: tlc-.
;;;
;;; th-main 3.40, first part, for a REAL kernel k in L^2(X x Y) (the complex kernel is a pair
;;; of real ones in the SIP design, so each complex statement is four real ones):
;;;   * l2-sections-ae: almost every section k(x, .) is in L^2(Y), and
;;;     int_X int_Y k(x, y)^2 dnu dmu = int_{X x Y} k^2 d(mu x nu)   (the F4 identity's last step);
;;;   * ae-eq-sections: kernels equal off a product-null set have, for almost every x, sections
;;;     equal off a nu-null set;
;;;   * kernel-integral-well-defined: for k = k' a.e. and xi = eta a.e. in L^2(Y), for almost
;;;     every x the integral int_Y k(x, y) xi(y) dnu(y) exists and equals
;;;     int_Y k'(x, y) eta(y) dnu(y): the integral operator does not depend on the
;;;     representatives of the classes.
;;;
;;; LOAD WINDOW: after l2b-a and l2b-b (and so after l2c-b, sip-c, product-measure).
;;; Library: measure.  No new vocabulary.

(define (tlc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2b-c: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2b-c: unfinished" name))))

(define (tlc-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (tlc-open?) (not (proof-done? *ps*)))
(define (tlc-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (tlc-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (tlc-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (tlc-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))
(define (tlc-ptwise var dom body) (list 'FORALL var (list 'IMPLIES (list 'IN var dom) body)))
(define (tlc-off var dom nset body) (tlc-ptwise var dom (list 'IMPLIES (list 'NOT (list 'IN var nset)) body)))

(define tlc-xy '(CARTESIAN xs ys))
(define tlc-ps '(PRODUCT-SIGMA xs cA ys cB))
(define tlc-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define tlc-meas2 '((IS-MEASURE xs cA mu) (IS-MEASURE ys cB nu)))
(define tlc-sf2 '((IS-SIGMA-FINITE xs cA mu) (IS-SIGMA-FINITE ys cB nu)))
(define (tlc-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define (tlc-sq f om) (list 'VNB-LAMBDA 'lx_ om (list '* (list f 'lx_) (list f 'lx_))))
(define (tlc-base!)
  (tlc-parts! 'is-measure '(xs cA mu))
  (tlc-parts! 'is-measure '(ys cB nu))
  (fact 'sigma-algebra-ambient-set 'xs 'cA)
  (fact 'sigma-algebra-ambient-set 'ys 'cB)
  (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
  (fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu))

;;; ==========================================================================================
;;; (1) ALMOST EVERY SECTION OF AN L^2 KERNEL IS L^2, AND THE NORM IS THE ITERATED INTEGRAL
;;; ==========================================================================================
(define tlc-ksq (tlc-sq 'k tlc-xy))
(define tlc-xsq (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu tlc-ksq))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k)
   (append tlc-meas2 tlc-sf2 (list (list 'IN 'k (list 'L2-SET tlc-xy tlc-ps tlc-rho))))
   (list 'AND (list '= (list 'INTEGRAL 'xs 'cA 'mu tlc-xsq) (list 'INTEGRAL tlc-xy tlc-ps tlc-rho tlc-ksq))
     (list 'FORSOME 'en_
       (list 'AND '(IS-NULL-SET xs cA mu en_)
         (tlc-off 'x 'xs 'en_ (list 'IN (tlc-fxs 'k 'x) '(L2-SET ys cB nu)))))))))
(dk-peel!)
(tlc-base!)
(dk-split! (dk-cite! 'l2-out tlc-xy tlc-ps tlc-rho 'k))
(dk-split! (dk-cite! 'l2-square-integral tlc-xy tlc-ps tlc-rho 'k))
(let* ((tp (dk-cite! 'tonelli-product 'xs 'cA 'mu 'ys 'cB 'nu tlc-ksq))
       (fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu tlc-ksq))
       (m (dk-project! (list 'IS-MEASURABLE-FN 'xs 'cA tlc-xsq) (lambda () (dk-split-all! (list fb)))))
       (ixs (list 'INTEGRAL 'xs 'cA 'mu tlc-xsq))
       (irs (list 'INTEGRAL tlc-xy tlc-ps tlc-rho tlc-ksq)))
  (dk-have! (list 'IN ixs 'RR) (lambda () (subst (list '= ixs irs)) (ass)))
  (let* ((tr (dk-split! (dk-cite! 'integral-finite-truncate 'xs 'cA 'mu tlc-xsq)))
         (null (find-first (lambda (q) (dk-head-is? q 'IS-NULL-SET)) tr))
         (off (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'NOT))) tr))
         (inf (list-ref null 4)))
    (dk-have! (list '= ixs irs) (lambda () (subst (list '= ixs irs)) (if (tlc-open?) (rfl))))
    (dk-have! (list 'FORSOME 'en_ (list 'AND '(IS-NULL-SET xs cA mu en_)
                (tlc-off 'x 'xs 'en_ (list 'IN (tlc-fxs 'k 'x) '(L2-SET ys cB nu)))))
      (lambda ()
        (ew inf)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let ((w (dk-di-var!)))
                  (di)
                  (dk-split! (dk-apply! off w))
                  (let* ((sec (tlc-fxs 'k w))
                         (ssq (tlc-sq sec 'ys))
                         (fsq (tlc-fxs tlc-ksq w)))
                    (dk-split! (dk-cite! 'section-parts 'xs 'cA 'ys 'cB 'nu 'k w))
                    (fact 'fn-x-section-measurable 'xs 'cA 'ys 'cB tlc-ksq w)
                    (dk-cite! 'measurable-fn-in-fun 'ys 'cB fsq)
                    (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu tlc-ksq w)
                    (dk-have! (list 'IN ssq '(FUN ys RR-POS-STAR))
                      (lambda ()
                        (dk-lam-type!
                          (lambda ()
                            (let* ((z (dk-di-var!)) (pr (list 'LIST w z)))
                              (fact 'pair-in-cartesian 'xs 'ys w z)
                              (fact 'fun-apply-type-c 'k tlc-xy 'RR pr)
                              (subst (dk-cite! 'fn-x-section-apply 'ys 'k w z))
                              (fact 'rr-mul-in-rr (list 'k pr) (list 'k pr))
                              (fact 'rr-sq-nonneg (list 'k pr))
                              (tlc-then-ass! (lambda () (dk-cite! 'rmc-rps-of-nonneg (list '* (list 'k pr) (list 'k pr)))))))
                          (lambda () (ass)))))
                    (dk-have! (tlc-ptwise 'icx_ 'ys (list '= (list fsq 'icx_) (list ssq 'icx_)))
                      (lambda ()
                        (let* ((z (dk-di-var!)) (pr (list 'LIST w z)))
                          (fact 'pair-in-cartesian 'xs 'ys w z)
                          (fact 'fun-apply-type-c 'k tlc-xy 'RR pr)
                          (subst (dk-cite! 'fn-x-section-apply 'ys tlc-ksq w z))
                          (tlc-lb!)
                          (subst (dk-cite! 'fn-x-section-apply 'ys 'k w z))
                          (if (tlc-open?) (rfl)))))
                    (fact 'integral-congruence-ptwise 'ys 'cB 'nu fsq ssq)
                    (dk-have! (list 'IN (list 'INTEGRAL 'ys 'cB 'nu ssq) 'RR)
                      (lambda ()
                        (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu ssq) (list 'INTEGRAL 'ys 'cB 'nu fsq)))
                        (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu fsq) (list tlc-xsq w)))
                        (ass)))
                    (fact 'l2-in-of-square-integral 'ys 'cB 'nu sec)
                    (if (tlc-open?) (ass)))))))))
    (dk-conj-close! dk-ass!)))
(tlc-qed! 'l2-sections-ae)

;;; ==========================================================================================
;;; (2) KERNELS EQUAL OFF A PRODUCT-NULL SET HAVE A.E. SECTIONS EQUAL A.E.
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k kk ns)
   (append tlc-meas2 tlc-sf2
     (list (list 'IN 'k (list 'FUN tlc-xy 'RR)) (list 'IN 'kk (list 'FUN tlc-xy 'RR))
           (list 'IS-NULL-SET tlc-xy tlc-ps tlc-rho 'ns)
           (tlc-off 'w tlc-xy 'ns '(= (k w) (kk w)))))
   (list 'FORSOME 'en_
     (list 'AND '(IS-NULL-SET xs cA mu en_)
       (tlc-off 'x 'xs 'en_
         (list 'FORSOME 'nb_ (list 'AND '(IS-NULL-SET ys cB nu nb_)
           (tlc-off 'y 'ys 'nb_ (list '= (list (tlc-fxs 'k 'x) 'y) (list (tlc-fxs 'kk 'x) 'y)))))))))))
(dk-peel!)
(let* ((en (dk-skolem! (dk-cite! 'null-set-sections-ae 'xs 'cA 'mu 'ys 'cB 'nu 'ns)))
       (off (find-first (lambda (q) (dk-head-is? q 'FORALL))
                        (filter (lambda (q) (dk-contains? q en)) (dk-asms))))
       (hyp (tlc-off 'w tlc-xy 'ns '(= (k w) (kk w)))))
  (ew en)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (let ((x (dk-di-var!)))
            (di)
            (let ((sec (list 'X-SECTION 'ys 'ns x)))
              (dk-apply! off x)
              (ew sec)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (let* ((z (dk-di-var!)) (pr (list 'LIST x z)))
                        (di)
                        (fact 'pair-in-cartesian 'xs 'ys x z)
                        (let ((iff (dk-cite! 'x-section-membership 'ys 'ns x z)))
                          (dk-have! (list 'NOT (list 'IN pr 'ns))
                            (lambda () (keep iff (list 'IN z 'ys) (list 'NOT (list 'IN z sec))) (prop))))
                        (dk-apply! hyp pr)
                        (fact 'fun-apply-type-c 'k tlc-xy 'RR pr)
                        (subst (dk-cite! 'fn-x-section-apply 'ys 'k x z))
                        (subst (dk-cite! 'fn-x-section-apply 'ys 'kk x z))
                        (if (tlc-open?) (ass))))))))))))
(tlc-qed! 'ae-eq-sections)

;;; ==========================================================================================
;;; (3) THE INTEGRAL OPERATOR DOES NOT DEPEND ON THE REPRESENTATIVES
;;; ==========================================================================================
(define (tlc-prod k1 f1 x) (list 'VNB-LAMBDA 'lx_ 'ys (list '* (list (tlc-fxs k1 x) 'lx_) (list f1 'lx_))))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k kk ns xi eta nb)
   (append tlc-meas2 tlc-sf2
     (list (list 'IN 'k (list 'L2-SET tlc-xy tlc-ps tlc-rho)) (list 'IN 'kk (list 'L2-SET tlc-xy tlc-ps tlc-rho))
           (list 'IS-NULL-SET tlc-xy tlc-ps tlc-rho 'ns)
           (tlc-off 'w tlc-xy 'ns '(= (k w) (kk w)))
           '(IN xi (L2-SET ys cB nu)) '(IN eta (L2-SET ys cB nu))
           '(IS-NULL-SET ys cB nu nb)
           (tlc-off 'y 'ys 'nb '(= (xi y) (eta y)))))
   (list 'FORSOME 'en_
     (list 'AND '(IS-NULL-SET xs cA mu en_)
       (tlc-off 'x 'xs 'en_
         (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tlc-prod 'k 'xi 'x))
           (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tlc-prod 'kk 'eta 'x))
             (list '= (list 'RINTEGRAL 'ys 'cB 'nu (tlc-prod 'k 'xi 'x))
                      (list 'RINTEGRAL 'ys 'cB 'nu (tlc-prod 'kk 'eta 'x)))))))))))
(dk-peel!)
(tlc-base!)
(dk-split! (dk-cite! 'l2-out tlc-xy tlc-ps tlc-rho 'k))
(dk-split! (dk-cite! 'l2-out tlc-xy tlc-ps tlc-rho 'kk))
(dk-split! (dk-cite! 'l2-out 'ys 'cB 'nu 'xi))
(dk-split! (dk-cite! 'l2-out 'ys 'cB 'nu 'eta))
(let* ((s1 (dk-split! (dk-cite! 'l2-sections-ae 'xs 'cA 'mu 'ys 'cB 'nu 'k)))
       (e1 (dk-skolem! (find-first (lambda (q) (dk-head-is? q 'FORSOME)) s1)))
       (o1 (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q e1))) (dk-asms)))
       (e2 (dk-skolem! (dk-cite! 'ae-eq-sections 'xs 'cA 'mu 'ys 'cB 'nu 'k 'kk 'ns)))
       (o2 (begin (dk-split-all!)
                  (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q e2))) (dk-asms))))
       (en (list 'UNION e1 e2)))
  (dk-split-all!)
  (fact 'ae-null-union 'xs 'cA 'mu e1 e2)
  (ew en)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (let ((x (dk-di-var!)))
            (di)
            (let ((um (dk-cite! 'union-membership e1 e2 x)))
              (dk-have! (list 'NOT (list 'IN x e1)) (lambda () (keep um (list 'NOT (list 'IN x en))) (prop)))
              (dk-have! (list 'NOT (list 'IN x e2)) (lambda () (keep um (list 'NOT (list 'IN x en))) (prop))))
            (dk-apply! o1 x)
            (let* ((nb2 (dk-skolem! (dk-apply! o2 x)))
                   (_s (dk-split-all!))
                   (o3 (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q nb2))) (dk-asms)))
                   (sk (tlc-fxs 'k x)) (skk (tlc-fxs 'kk x))
                   (p1 (tlc-prod 'k 'xi x)) (p2 (tlc-prod 'kk 'eta x))
                   (nbu (list 'UNION nb2 'nb)))
              (fact 'ae-null-union 'ys 'cB 'nu nb2 'nb)
              (dk-split! (dk-cite! 'section-parts 'xs 'cA 'ys 'cB 'nu 'kk x))
              (fact 'l2-prod-integrable 'ys 'cB 'nu sk 'xi)
              (fact 'real-measurable-mul 'ys 'cB skk 'eta)
              (dk-have! (tlc-off 'tz_ 'ys nbu (list '= (list p1 'tz_) (list p2 'tz_)))
                (lambda ()
                  (let* ((z (dk-di-var!)) (pr (list 'LIST x z)))
                    (di)
                    (let ((um (dk-cite! 'union-membership nb2 'nb z)))
                      (dk-have! (list 'NOT (list 'IN z nb2)) (lambda () (keep um (list 'NOT (list 'IN z nbu))) (prop)))
                      (dk-have! (list 'NOT (list 'IN z 'nb)) (lambda () (keep um (list 'NOT (list 'IN z nbu))) (prop))))
                    (dk-apply! o3 z)
                    (dk-apply! (tlc-off 'y 'ys 'nb '(= (xi y) (eta y))) z)
                    (fact 'pair-in-cartesian 'xs 'ys x z)
                    (fact 'fun-apply-type-c 'k tlc-xy 'RR pr)
                    (fact 'fun-apply-type-c 'xi 'ys 'RR z)
                    (tlc-lb!)
                    (subst (list '= (list skk z) (list sk z)))
                    (subst (list '= (list 'eta z) (list 'xi z)))
                    (subst (dk-cite! 'fn-x-section-apply 'ys 'k x z))
                    (if (tlc-open?) (rfl)))))
              (dk-split! (dk-cite! 'rintegral-ae-eq 'ys 'cB 'nu p1 p2 nbu))
              (dk-have! (list '= (list 'RINTEGRAL 'ys 'cB 'nu p1) (list 'RINTEGRAL 'ys 'cB 'nu p2))
                (lambda () (subst (list '= (list 'RINTEGRAL 'ys 'cB 'nu p2) (list 'RINTEGRAL 'ys 'cB 'nu p1)))
                           (if (tlc-open?) (rfl))))
              (dk-conj-close! dk-ass!)))))))
(tlc-qed! 'kernel-integral-well-defined)
