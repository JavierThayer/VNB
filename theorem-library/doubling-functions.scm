;;; bounded equivalence.  Agent M-F (target M-I), 2026-10-29.  DESTINATION: theorem-library/doubling-functions.scm.
;;; Library: measure.  Helper prefix: mfi-.  Load window: after mf-mivocab, hausdorff-vocab (IS-DOUBLING, NNREAL).

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mfi-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFI OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define mfi-nnr '(SEP mhr_ RR (<= 0 mhr_)))
;; r in RR, 0 <= r in context: (IN r NNREAL)
(define (mfi-in-nn! r)
  (if (not (dk-asm? (list 'IN r 'NNREAL)))
      (begin
        (dk-cite! 'nnreal-def)
        (dk-have! (list 'IN r 'NNREAL)
          (lambda () (subst (list '= 'NNREAL mfi-nnr)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))
;; f in FUN(NNREAL, NNREAL), (IN r NNREAL): lands (IN (f r) RR) and (<= 0 (f r))
(define (mfi-val! f r)
  (if (not (dk-asm? (list 'IN (list f r) 'RR)))
      (begin
        (dk-cite! 'nnreal-def)
        (dk-cite! 'fun-apply-type-c f 'NNREAL 'NNREAL r)
        (dk-rewrite-h! (list 'IN (list f r) 'NNREAL) 'NNREAL mfi-nnr)
        (dk-sep-parts! (list 'IN (list f r) mfi-nnr)))))
(define (mfi-pos! c)   ; (POS-RR c) in context
  (dk-cite! 'rr-pos-rr-in-rr c) (dk-cite! 'rr-lt-of-pos-rr c))
;; c in RR, 0 < c in context: recip(c) in RR, 0 < recip(c), c * recip(c) = 1
(define (mfi-recip! c)
  (if (not (dk-asm? (list 'IN (list 'RECIP c) 'RR)))
      (begin
        (dk-have! (list 'NOT (list '= c 0)) (lambda () (di) (dk-absurd! (list '< 0 c) (list '= c 0))))
        (dk-have-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
        (dk-cite! 'rr-recip-closed c)
        (dk-cite! 'rr-recip-inverse c)
        (dk-cite! 'rr-recip-pos c))))
;; open IS-BOUNDEDLY-EQUIVALENT(phi, psi): returns (lo . hi), with the bounds' universal landed
(define (mfi-be-open! phi psi)
  (dk-iff-fwd! (dk-cite! 'is-boundedly-equivalent phi psi))
  (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'bel_))) (dk-asms)))
         (lo (dk-skolem! ex))
         (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'beu_))) (dk-asms)))
         (hi (dk-skolem! ex2)))
    (dk-split-all!)
    (mfi-pos! lo) (mfi-pos! hi)
    (cons lo hi)))
(define (mfi-bounds lo hi phi psi)
  (list 'FORALL 'ber_ (list 'IMPLIES '(IN ber_ RR) (list 'IMPLIES '(< 0 ber_)
    (list 'AND (list '<= (list '* lo (list phi 'ber_)) (list psi 'ber_)) (list '<= (list psi 'ber_) (list '* hi (list phi 'ber_))))))))

;; ---------------------------------------------------------------------------
;; bounded equivalence is symmetric
(sp (make-wff '(FORALL phi (FORALL psi (IMPLIES (IS-BOUNDEDLY-EQUIVALENT phi psi) (IS-BOUNDEDLY-EQUIVALENT psi phi))))))
(dk-peel!)
(let* ((pr (mfi-be-open! 'phi 'psi)) (lo (car pr)) (hi (cdr pr))
       (rl (list 'RECIP lo)) (rh (list 'RECIP hi)))
  (mfi-recip! lo) (mfi-recip! hi)
  (dk-cite! 'rr-pos-rr-of-lt rl) (dk-cite! 'rr-pos-rr-of-lt rh)
  (dk-have! (mfi-bounds rh rl 'psi 'phi)
    (lambda ()
      (dk-peel!)
      (let* ((r (cadr (caddr (cadr (dk-goal))))))
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (mfi-in-nn! r)
        (mfi-val! 'phi r) (mfi-val! 'psi r)
        (dk-split-all! (list (dk-apply! (mfi-bounds lo hi 'phi 'psi) r)))
        (let ((x (list 'phi r)) (y (list 'psi r)))
          (dk-conj-close!
            (lambda ()
              (if (dk-contains? (cadr (dk-goal)) rh)
                  ;; (1/hi) psi <= phi from psi <= hi phi
                  (let ((m (begin (dk-type! (list '* hi x) 'RR)
                                  (dk-have! (list '<= 0 rh) (lambda () (dk-ineq! (list '< 0 rh))))
                                  (dk-cite! 'rr-mul-le-right y (list '* hi x) rh))))
                    (dk-have! (list '= (list '* (list '* hi x) rh) (list '* x (list '* hi rh))) (lambda () (dk-crs-opaque!)))
                    (dk-have! (list '= (list '* y rh) (list '* rh y)) (lambda () (dk-crs-opaque!)))
                    (dk-have! (list '= (list '* x (list '* hi rh)) x)
                      (lambda () (subst (list '= (list '* hi rh) 1)) (crs)))
                    (let* ((m1 (dk-rewrite-h! m (list '* (list '* hi x) rh) (list '* x (list '* hi rh))))
                           (m2 (dk-rewrite-h! m1 (list '* x (list '* hi rh)) x))
                           (m3 (dk-rewrite-h! m2 (list '* y rh) (list '* rh y))))
                      (dk-ass!)))
                  ;; phi <= (1/lo) psi from lo phi <= psi
                  (let ((m (begin (dk-type! (list '* lo x) 'RR)
                                  (dk-have! (list '<= 0 rl) (lambda () (dk-ineq! (list '< 0 rl))))
                                  (dk-cite! 'rr-mul-le-right (list '* lo x) y rl))))
                    (dk-have! (list '= (list '* (list '* lo x) rl) (list '* x (list '* lo rl))) (lambda () (dk-crs-opaque!)))
                    (dk-have! (list '= (list '* y rl) (list '* rl y)) (lambda () (dk-crs-opaque!)))
                    (dk-have! (list '= (list '* x (list '* lo rl)) x)
                      (lambda () (subst (list '= (list '* lo rl) 1)) (crs)))
                    (let* ((m1 (dk-rewrite-h! m (list '* (list '* lo x) rl) (list '* x (list '* lo rl))))
                           (m2 (dk-rewrite-h! m1 (list '* x (list '* lo rl)) x))
                           (m3 (dk-rewrite-h! m2 (list '* y rl) (list '* rl y))))
                      (dk-ass!))))))))))
  (dk-have! (list 'FORSOME 'bel_ (list 'FORSOME 'beu_ (list 'AND '(POS-RR bel_) (list 'AND '(POS-RR beu_) (mfi-bounds 'bel_ 'beu_ 'psi 'phi)))))
    (lambda () (ew rh) (ew rl) (dk-conj-close! dk-ass!)))
  (dk-have-and! '(IN psi (FUN NNREAL NNREAL)) '(IN phi (FUN NNREAL NNREAL))
                (list 'FORSOME 'bel_ (list 'FORSOME 'beu_ (list 'AND '(POS-RR bel_) (list 'AND '(POS-RR beu_) (mfi-bounds 'bel_ 'beu_ 'psi 'phi))))))
  (dk-iff-bwd! (dk-cite! 'is-boundedly-equivalent 'psi 'phi))
  (dk-ass!))
(mfi-qed! 'boundedly-equivalent-symmetric)

;; ---------------------------------------------------------------------------
;; Prop 4.44, one direction
(define mfi-mono '(FORALL mhr_ (IMPLIES (IN mhr_ NNREAL) (FORALL mhq_ (IMPLIES (IN mhq_ NNREAL)
                     (IMPLIES (<= mhr_ mhq_) (<= (psi mhr_) (psi mhq_))))))))
(sp (make-wff (dk-foralls '(phi psi) (dk-curry (list '(IS-BOUNDEDLY-EQUIVALENT phi psi) '(= (psi 0) 0) mfi-mono '(IS-DOUBLING phi))
  '(IS-DOUBLING psi)))))
(dk-peel!)
(let* ((pr (mfi-be-open! 'phi 'psi)) (lo (car pr)) (hi (cdr pr))
       (dparts (dk-iff-parts! (dk-cite! 'is-doubling 'phi)))
       (al (dk-skolem! (list-ref dparts 3)))
       (dbl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f al))) (dk-asms)))
       (rl (list 'RECIP lo))
       (p (list '* (list '* hi al) rl)))
  (mfi-pos! al)
  (mfi-recip! lo)
  (dk-cite! 'rr-mul-pos hi al)
  (dk-type! (list '* hi al) 'RR)
  (dk-cite! 'rr-mul-pos (list '* hi al) rl)
  (dk-type! p 'RR)
  (dk-cite! 'rr-pos-rr-of-lt p)
  (dk-have! (list 'FORALL 'mfir_ (list 'IMPLIES '(IN mfir_ RR) (list 'IMPLIES '(< 0 mfir_) (list '<= '(psi (* 2 mfir_)) (list '* p '(psi mfir_))))))
    (lambda ()
      (dk-peel!)
      (let* ((r (cadr (caddr (caddr (dk-goal)))))
             (r2 (list '* 2 r))
             (x (list 'phi r)) (y (list 'psi r)) (x2 (list 'phi r2)) (y2 (list 'psi r2)))
        (dk-type! r2 'RR)
        (dk-have! (list '< 0 r2) (lambda () (dk-ineq! (list '< 0 r))))
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (dk-have! (list '<= 0 r2) (lambda () (dk-ineq! (list '< 0 r))))
        (mfi-in-nn! r) (mfi-in-nn! r2)
        (mfi-val! 'phi r) (mfi-val! 'psi r) (mfi-val! 'phi r2) (mfi-val! 'psi r2)
        (dk-split-all! (list (dk-apply! (mfi-bounds lo hi 'phi 'psi) r)))
        (dk-split-all! (list (dk-apply! (mfi-bounds lo hi 'phi 'psi) r2)))
        (dk-apply! dbl r)
        (dk-type! (list '* al x) 'RR)
        (dk-have! (list '<= 0 hi) (lambda () (dk-ineq! (list '< 0 hi))))
        (dk-have! (list '<= 0 rl) (lambda () (dk-ineq! (list '< 0 rl))))
        (dk-type! (list '* lo x) 'RR)
        (let* ((m1 (dk-cite! 'rr-mul-le-right x2 (list '* al x) hi))
               (m2 (dk-cite! 'rr-mul-le-right (list '* lo x) y rl)))
          (dk-have! (list '= (list '* (list '* lo x) rl) (list '* x (list '* lo rl))) (lambda () (dk-crs-opaque!)))
          (dk-have! (list '= (list '* x (list '* lo rl)) x) (lambda () (subst (list '= (list '* lo rl) 1)) (crs)))
          (let* ((xa (dk-rewrite-h! m2 (list '* (list '* lo x) rl) (list '* x (list '* lo rl))))
                 (xb (dk-rewrite-h! xa (list '* x (list '* lo rl)) x)))   ; x <= y * (1/lo)
            (dk-type! (list '* y rl) 'RR)
            (dk-type! (list '* hi al) 'RR)
            (dk-have! (list '<= 0 (list '* hi al)) (lambda () (dk-ineq! (list '< 0 (list '* hi al)))))
            (dk-have! (list '= (list '* x2 hi) (list '* hi x2)) (lambda () (crs)))
            (dk-have! (list '= (list '* (list '* al x) hi) (list '* x (list '* hi al))) (lambda () (crs)))
            (let* ((ma (dk-rewrite-h! m1 (list '* x2 hi) (list '* hi x2)))
                   (mb (dk-rewrite-h! ma (list '* (list '* al x) hi) (list '* x (list '* hi al))))
                   (m3 (dk-cite! 'rr-mul-le-right x (list '* y rl) (list '* hi al))))
              (dk-have! (list '= (list '* (list '* y rl) (list '* hi al)) (list '* p y)) (lambda () (dk-crs-opaque!)))
              (let ((mc (dk-rewrite-h! m3 (list '* (list '* y rl) (list '* hi al)) (list '* p y))))
                (for-each (lambda (t) (dk-type! t 'RR)) (list (list '* hi x2) (list '* x (list '* hi al)) (list '* p y)))
                (dk-have-and! (list 'IN y2 'RR) (list 'IN (list '* hi x2) 'RR) (list 'IN (list '* x (list '* hi al)) 'RR))
                (dk-have-and! (list '<= y2 (list '* hi x2)) (list '<= (list '* hi x2) (list '* x (list '* hi al))))
                (dk-cite! 'rr-leq-transitive y2 (list '* hi x2) (list '* x (list '* hi al)))
                (dk-have-and! (list 'IN y2 'RR) (list 'IN (list '* x (list '* hi al)) 'RR) (list 'IN (list '* p y) 'RR))
                (dk-have-and! (list '<= y2 (list '* x (list '* hi al))) (list '<= (list '* x (list '* hi al)) (list '* p y)))
                (dk-cite! 'rr-leq-transitive y2 (list '* x (list '* hi al)) (list '* p y))
                (dk-ass!))))))))
  (dk-have! (list 'FORSOME 'mhp_ (list 'AND '(POS-RR mhp_)
              (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES '(< 0 mhr_) (list '<= '(psi (* 2 mhr_)) '(* mhp_ (psi mhr_))))))))
    (lambda () (ew p) (dk-conj-close! dk-ass!)))
  (dk-have-and! '(IN psi (FUN NNREAL NNREAL)) '(= (psi 0) 0) mfi-mono
                (list 'FORSOME 'mhp_ (list 'AND '(POS-RR mhp_)
                  (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES '(< 0 mhr_) (list '<= '(psi (* 2 mhr_)) '(* mhp_ (psi mhr_)))))))))
  (dk-iff-bwd! (dk-cite! 'is-doubling 'psi))
  (dk-ass!))
(mfi-qed! 'doubling-of-boundedly-equivalent)

;; Prop 4.44
(define mfi-mono-phi '(FORALL mhr_ (IMPLIES (IN mhr_ NNREAL) (FORALL mhq_ (IMPLIES (IN mhq_ NNREAL)
                         (IMPLIES (<= mhr_ mhq_) (<= (phi mhr_) (phi mhq_))))))))
(sp (make-wff (dk-foralls '(phi psi) (dk-curry (list '(IS-BOUNDEDLY-EQUIVALENT phi psi) '(= (phi 0) 0) '(= (psi 0) 0) mfi-mono-phi mfi-mono)
  '(IFF (IS-DOUBLING phi) (IS-DOUBLING psi))))))
(dk-peel!)
(dk-cite! 'boundedly-equivalent-symmetric 'phi 'psi)
(dk-iff!
  (lambda (g) (equal? g '(IS-DOUBLING psi)))
  (lambda () (dk-cite! 'doubling-of-boundedly-equivalent 'phi 'psi) (dk-ass!))
  (lambda () (dk-cite! 'doubling-of-boundedly-equivalent 'psi 'phi) (dk-ass!)))
(mfi-qed! 'doubling-iff-boundedly-equivalent)
