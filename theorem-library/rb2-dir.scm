;;; rb2-dir.scm -- calculus.pdf Lemmas 2.25, 2.26 and Prop. 2.27 for the LOCAL directional derivative
;;; HAS-DIR-DERIV over a normed vector space, f defined on an open set U.  Helper prefix r2d-.
;;;
;;;   ldir-deriv-value          HAS-DIR-DERIV(m, f, a, eta, l) => LDIR-DERIV(m, f, a, eta) = l
;;;   has-dir-deriv-scale       Lemma 2.25: d_(k.eta) f(a) = k d_eta f(a)
;;;   has-dir-deriv-add         Lemma 2.26: d_eta f, d_xi f defined on the open set U, continuous at
;;;                             a  =>  d_(eta + xi) f(a) = d_eta f(a) + d_xi f(a)
;;;   dir-deriv-span-formula    with the fields p = d_eta f, q = d_xi f continuous on U:
;;;                             d_(r.eta + s.xi) f(x) = r p(x) + s q(x) for x in U, r, s in RR
;;;   span2-unfold, span2-add-coeffs, span2-scale-coeffs   the space V = SPAN2(m, eta, xi)
;;;   dir-deriv-span-linear     PROPOSITION 2.27: for x in U, d_phi f(x) is defined for every phi in
;;;                             V, and phi |-> d_phi f(x) is IS-LINEAR-FUNCTIONAL-ON(m, V, .)
;;; f is a function on the open set U (as in the notes), never total on vec(m); the directional
;;; derivative is the LOCAL one (HAS-DIR-DERIV, through has-deriv-at).  The fields p, q are given
;;; as functions on U (the style of Prop 2.28, continuous-partials-dir-deriv).
;;; Library: analysis.  Needs rb2-vocab (LDIR-DERIV, SPAN2).  Load window: after
;;; theorem-library/calc2-dirderiv (has-dir-deriv-shift, -step) and calc2-prop228
;;; (ms-rr-scale-continuous-at).

(define (r2d-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "r2d-pick: nothing matching" what) (car l))))
(define (r2d-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (r2d-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))

;;; ---------------------------------------------------------------------------
;;; (L0) LDIR-DERIV reads the value off any witness.
(sp (make-wff (forall-guarded '(m f a eta dl)
  '((HAS-DIR-DERIV m f a eta dl))
  '(= (LDIR-DERIV m f a eta) dl))))
(dk-peel!)
(define r2d0-hd (r2d-pick 'hd (lambda (x) (dk-head-is? x 'HAS-DIR-DERIV))))
(define (r2d-hda! h)            ; HAS-DIR-DERIV hyp h: land its HAS-DERIV-AT
  (dk-project! (list 'HAS-DERIV-AT (list 'SEG-CURVE (list-ref h 1) (list-ref h 2) (list-ref h 3) (list-ref h 4)) 0 (list-ref h 5))
               (lambda () (mac-h 'HAS-DIR-DERIV h))))
(r2d-hda! r2d0-hd)
(fact 'has-deriv-at-in-rr '(SEG-CURVE m f a eta) 0 'dl)
(mac 'LDIR-DERIV)
(let ((iot (cadr (dk-goal))))
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (eq? (car (dk-goal)) 'FORSOME)
         (begin
           (ew 'dl)
           (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((pl (dk-peel!))
                         (oh (car (filter (lambda (x) (dk-head-is? x 'HAS-DIR-DERIV)) pl)))
                         (ov (list-ref oh 5)))
                    (r2d-hda! oh)
                    (fact 'has-deriv-at-unique '(SEG-CURVE m f a eta) 0 'dl ov)
                    (if (dk-asm? (dk-goal)) (ass)
                        (begin (subst (list '= 'dl ov)) (rfl))))
                  (ass)))))
         (let ((ih (r2d-pick 'iota-prop (lambda (x) (and (dk-head-is? x 'HAS-DIR-DERIV) (equal? (list-ref x 5) iot))))))
           (r2d-hda! ih)
           (fact 'has-deriv-at-in-rr '(SEG-CURVE m f a eta) 0 iot)
           (fact 'has-deriv-at-unique '(SEG-CURVE m f a eta) 0 iot 'dl)
           (ass))))
   (dk-opened (lambda () (iota-d iot)))))
(qed 'ldir-deriv-value)

;;; ---------------------------------------------------------------------------
;;; (L1) Lemma 2.25, local: d_(k.eta) f(a) = k d_eta f(a).
(define r2s-G '(SEG-CURVE m f a eta))
(define r2s-H '(SEG-CURVE m f a ((ACT m) k eta)))
(sp (make-wff (forall-guarded '(m f a eta k dl)
  '((IS-NORMED-VECTOR-SPACE m) (IN a (VEC m)) (IN eta (VEC m)) (IN k RR) (HAS-DIR-DERIV m f a eta dl))
  '(HAS-DIR-DERIV m f a ((ACT m) k eta) (* k dl)))))
(dk-peel!)
(dk-cite! 'nvs-act-in-vec 'm 'k 'eta)
(define r2s-hq (r2d-hda! (r2d-pick 'hd (lambda (x) (dk-head-is? x 'HAS-DIR-DERIV)))))
(dk-cite! 'has-deriv-at-in-rr r2s-G 0 'dl)
(dk-cite! 'rr-zero-in)
(dk-cite! 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'rr-pos-rr-of-lt 1)
(define r2s-w (dk-skolem! (dk-apply! (dk-cite! 'has-deriv-at-shrink r2s-G 0 'dl) 1) #t))
(define r2s-isd (r2d-pick 'is-diff-on (lambda (x) (dk-head-is? x 'IS-DIFF-ON))))
(define r2s-O0 (list 'OOINT (list '- 0 r2s-w) (list '+ 0 r2s-w)))
(define r2s-rg (list 'RESTRICT r2s-G r2s-O0))
(dk-cite! 'rr-pos-rr-in-rr r2s-w)
(dk-cite! 'rr-lt-of-pos-rr r2s-w)
(define r2s-rgf0 (dk-project! (list 'IN r2s-rg (list 'FUN r2s-O0 '(CARR RR-NORMED-FIELD)))
                              (lambda () (mac-h 'IS-DIFF-ON r2s-isd))))
(fact 'rr-nf-carr)
(define r2s-rgf (dk-rewrite-h! r2s-rgf0 '(CARR RR-NORMED-FIELD) 'RR))
;;; the radius r: r |k| <= h, h + h = w
(define r2s-hw (dk-halve! r2s-w))
(dk-cite! 'rr-abs-closed 'k)
(dk-cite! 'rr-abs-nonneg 'k)
(define r2s-r (dk-skolem! (dk-cite! 'rr-small-factor-real r2s-hw '(abs k)) #t))
(dk-cite! 'rr-pos-rr-in-rr r2s-r)
(dk-cite! 'rr-lt-of-pos-rr r2s-r)
(define r2s-Or (list 'OOINT (list '- 0 r2s-r) (list '+ 0 r2s-r)))
(define (r2s-s y) (list '+ 0 (list '* 'k y)))
;;; y in Or: k.y lands in O0
(define (r2s-in-O0! y)
  (dk-cite! 'ooint-elt-in-rr (list '- 0 r2s-r) (list '+ 0 r2s-r) y)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ooint-membership (list '- 0 r2s-r) (list '+ 0 r2s-r) y))))
  (dk-have! (list '< (list '- r2s-r) y) (lambda () (dk-ineq! (list '< (list '- 0 r2s-r) y))))
  (dk-have! (list '< y r2s-r) (lambda () (dk-ineq! (list '< y (list '+ 0 r2s-r)))))
  (dk-cite! 'rr-abs-lt-of-parts y r2s-r)
  (dk-cite! 'rr-abs-closed y)
  (dk-cite! 'rr-abs-nonneg y)
  (dk-cite! 'rr-lt-implies-le (list 'abs y) r2s-r)
  (let* ((ky (list '* 'k y)) (aky (list 'abs ky)) (ak '(abs k)) (ay (list 'abs y)))
    (r2d-rr! ky)
    (r2d-and! '(IN k RR) (list 'IN y 'RR))
    (dk-cite! 'rr-abs-mult 'k y)
    (dk-cite! 'rr-mul-le-right ay r2s-r ak)
    (r2d-rr! (list '* ak ay)) (r2d-rr! (list '* ay ak)) (r2d-rr! (list '* r2s-r ak))
    (r2d-and! (list 'IN ak 'RR) (list 'IN ay 'RR))
    (dk-cite! 'rr-mul-comm ak ay)
    (r2d-rr! aky)
    (dk-have! (list '< aky r2s-w)
      (lambda () (dk-ineq! (list '= aky (list '* ak ay)) (list '= (list '* ak ay) (list '* ay ak))
                           (list '<= (list '* ay ak) (list '* r2s-r ak)) (list '<= (list '* r2s-r ak) r2s-hw)
                           (list '= (list '+ r2s-hw r2s-hw) r2s-w) (list '< 0 r2s-hw))))
    (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts ky r2s-w)))
    (r2d-rr! (r2s-s y))
    (dk-have! (list 'IN (r2s-s y) r2s-O0)
      (lambda () (mac 'ooint-membership)
        (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                       (dk-ineq! (list '< (list '- r2s-w) ky) (list '< ky r2s-w)))))))))
;;; the two curves agree on Or: H(y) == G(0 + k y)
(define r2s-agree
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ r2s-Or)
              (list '== (list r2s-H 'hbx_) (list r2s-G (r2s-s 'hbx_)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (sv (r2s-s y)))
        (dk-cite! 'ooint-elt-in-rr (list '- 0 r2s-r) (list '+ 0 r2s-r) y)
        (r2d-rr! sv)
        (dk-cite! 'nvs-act-in-vec 'm 'k 'eta)
        (subst (dk-cite! 'seg-curve-apply 'm 'f 'a '((ACT m) k eta) y))
        (subst (dk-cite! 'seg-curve-apply 'm 'f 'a 'eta sv))
        (subst (dk-cite! 'nvs-act-scale-assoc 'm y 'k 'eta))
        (dk-have! (list '= (list '* y 'k) sv) (lambda () (crs)))
        (subst (list '= (list '* y 'k) sv))
        (qrfl)))))
(define r2s-agree-f (r2d-pick 'agree (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x '==) (dk-contains? x r2s-Or)))))
(fact 'rr-is-set)
(dk-cite! 'ooint-subset-rr (list '- 0 r2s-r) (list '+ 0 r2s-r))
(r2d-rr! (list '- 0 r2s-r)) (r2d-rr! (list '+ 0 r2s-r))
(dk-cite! 'subclass-of-set-is-set r2s-Or 'RR)
(dk-have! (list 'IN (list 'RESTRICT r2s-H r2s-Or) (list 'FUN r2s-Or 'RR))
  (lambda ()
    (mac 'RESTRICT)
    (dk-lam-type!
      (lambda ()
        (let* ((y (dk-di-var!)) (sv (r2s-s y)))
          (r2s-in-O0! y)
          (dk-apply! r2s-agree-f y)
          (r2d-and! r2s-rgf (list 'IN sv r2s-O0))
          (dk-cite! 'fun-apply-type r2s-rg r2s-O0 'RR sv)
          (dk-cite! 'restrict-apply r2s-G r2s-O0 sv)
          (subst (list '= (list r2s-H y) (list r2s-G sv)))
          (subst (list '= (list r2s-G sv) (list r2s-rg sv)))
          (ass)))
      (lambda () (ass)))))
(dk-have! (list '= 0 '(+ 0 (* k 0))) (lambda () (crs)))
(dk-have! (list 'HAS-DERIV-AT r2s-G '(+ 0 (* k 0)) 'dl)
  (lambda () (subst (list '= '(+ 0 (* k 0)) 0)) (ass)))
(define r2s-ch (dk-cite! 'has-deriv-at-affine-chain r2s-r r2s-G r2s-H 0 'k 0 'dl))
(dk-have! '(= (* dl k) (* k dl)) (lambda () (crs)))
(dk-rewrite-h! r2s-ch '(* dl k) '(* k dl))
(mac 'HAS-DIR-DERIV)
(ass)
(qed 'has-dir-deriv-scale)

;;; ---------------------------------------------------------------------------
;;; (L2) Lemma 2.26, local: d_eta f and d_xi f exist on the open set U and are continuous at a
;;; ==> d_(eta + xi) f(a) = d_eta f(a) + d_xi f(a).  The proof is the notes': split
;;; f(a + t(xi + eta)) - f(a) at a + t.xi, and the mean value theorem along each leg
;;; (has-dir-deriv-step) with the derivative within eps/2 of its value at a.
(define r2a-E '(NVS-METRIC-SPACE m))
(define r2a-SUB (list 'SUBSPACE-MS r2a-E 'u))
(define r2a-g '(SEG-CURVE m f a ((VADD m) eta xi)))
(define r2a-L '(+ (p a) (q a)))
(define (r2a-act t v) (list '(ACT m) t v))
(define (r2a-add x y) (list '(VADD m) x y))
(define (r2a-P1 t) (r2a-add 'a (r2a-act t 'xi)))
(define (r2a-P2 t tt) (r2a-add (r2a-P1 t) (r2a-act tt 'eta)))
(define r2a-Ne '((VNRM m) eta))
(define r2a-Nx '((VNRM m) xi))
(define r2a-K1 (list '+ 1 (list '+ r2a-Ne r2a-Nx)))

(sp (make-wff (forall-guarded '(m u f eta xi p q a)
  (list '(IS-NORMED-VECTOR-SPACE m) (list 'IS-OPEN r2a-E 'u) '(IN f (FUN u RR))
        '(IN eta (VEC m)) '(IN xi (VEC m))
        '(FORALL x (IMPLIES (IN x u) (HAS-DIR-DERIV m f x eta (p x))))
        '(FORALL x (IMPLIES (IN x u) (HAS-DIR-DERIV m f x xi (q x))))
        '(IN a u)
        (list 'IS-CONTINUOUS-AT r2a-SUB 'RR-MS 'p 'a)
        (list 'IS-CONTINUOUS-AT r2a-SUB 'RR-MS 'q 'a))
  (list 'HAS-DIR-DERIV 'm 'f 'a '((VADD m) eta xi) r2a-L))))
(dk-peel!)
(define r2a-Hp (r2d-pick 'Hp (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'eta) (dk-contains? x 'HAS-DIR-DERIV)))))
(define r2a-Hq (r2d-pick 'Hq (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'xi) (not (dk-contains? x 'eta))))))
;;; the setting
(dk-cite! 'nvs-metric-is-ms 'm)
(define r2a-ptsE (dk-cite! 'nvs-ms-pts 'm))                       ; PTS(E) == VEC(m)
(dk-project! (list 'SUBSET 'u (list 'PTS r2a-E)) 'is-open (list 'IS-OPEN r2a-E 'u))
(define r2a-subv (dk-rewrite-h! (list 'SUBSET 'u (list 'PTS r2a-E)) (list 'PTS r2a-E) '(VEC m)))
(dk-cite! 'vec-is-set 'm)
(dk-cite! 'subclass-of-set-is-set 'u '(VEC m))
(define r2a-ptsS (dk-cite! 'subspace-pts r2a-E 'u))                 ; PTS(SUB) == u
(dk-cite! 'subset-mem-fwd 'u '(VEC m) 'a)
(dk-cite! 'nvs-vadd-in-vec 'm 'eta 'xi)
(dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)
;;; the values at a
(define (r2a-field-at! H fn x)        ; x in u: HAS-DIR-DERIV at x, (fn x) in RR
  (let* ((hd (dk-apply! H x))
         (dir (list-ref hd 4))
         (ha (r2d-hda! hd)))
    (dk-cite! 'has-deriv-at-in-rr (list 'SEG-CURVE 'm 'f x dir) 0 (list fn x))
    hd))
(r2a-field-at! r2a-Hp 'p 'a)
(r2a-field-at! r2a-Hq 'q 'a)
(r2d-rr! r2a-L)
;;; norms and K
(dk-cite! 'vnrm-real 'm 'eta) (dk-cite! 'vnrm-nonneg 'm 'eta)
(dk-cite! 'vnrm-real 'm 'xi) (dk-cite! 'vnrm-nonneg 'm 'xi)
(r2d-rr! r2a-K1)
(dk-have! (list '<= 0 r2a-K1) (lambda () (dk-ineq! (list '<= 0 r2a-Ne) (list '<= 0 r2a-Nx))))
;;; the ball about a inside u
(define r2a-op (dk-project! (list 'FORALL 'y (list 'IMPLIES '(IN y u)
                   (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL r2a-E 'y 'r) 'u)))))
                 'is-open (list 'IS-OPEN r2a-E 'u)))
(define r2a-rb (dk-skolem! (dk-apply! r2a-op 'a) #t))
(dk-cite! 'rr-pos-rr-in-rr r2a-rb) (dk-cite! 'rr-lt-of-pos-rr r2a-rb)
(define r2a-hb (dk-halve! r2a-rb))
(define r2a-r (dk-skolem! (dk-cite! 'rr-small-factor-real r2a-hb r2a-K1) #t))   ; r K1 <= hb
(dk-cite! 'rr-pos-rr-in-rr r2a-r) (dk-cite! 'rr-lt-of-pos-rr r2a-r)
(dk-have! (list 'IN 'a (list 'PTS r2a-E)) (lambda () (subst r2a-ptsE) (ass)))

;;; c real, 0 <= c, |t| <= c, |tt| <= c, c <= r: land (IN (P2 t tt) u) and the bound
;;; dist(a, P2) <= c K1;  ONE? = #t for the one-leg point P1 t instead.
(define (r2a-near! t tt c one?)
  (let* ((w   (if one? (r2a-act t 'xi) (r2a-add (r2a-act t 'xi) (r2a-act tt 'eta))))
         (pt  (if one? (r2a-P1 t) (r2a-P2 t tt)))
         (aw  (r2a-add 'a w))
         (cK  (list '* c r2a-K1))
         (nw  (list '(VNRM m) w)))
    (for-each (lambda (x) (if (and (equal? c (list 'abs x)) (not (dk-asm? (list '<= c c))))
                              (begin (r2d-rr! c) (fact 'rr-leq-reflexive c))))
              (list t tt))
    (dk-cite! 'nvs-act-in-vec 'm t 'xi)
    (if (not one?) (begin (dk-cite! 'nvs-act-in-vec 'm tt 'eta)
                          (dk-cite! 'nvs-vadd-in-vec 'm (r2a-act t 'xi) (r2a-act tt 'eta))))
    (dk-cite! 'nvs-vadd-in-vec 'm 'a w)
    (if (not one?)
        (begin (dk-cite! 'nvs-vadd-in-vec 'm 'a (r2a-act t 'xi))
               (dk-cite! 'nvs-vadd-in-vec 'm (r2a-P1 t) (r2a-act tt 'eta))
               (dk-cite! 'nvs-vadd-assoc 'm 'a (r2a-act t 'xi) (r2a-act tt 'eta))))
    (dk-cite! 'vnrm-real 'm w)
    (if one?
        (dk-cite! 'nvs-norm-one-term-bound 'm 'xi 'eta t c)
        (dk-cite! 'nvs-norm-two-term-bound 'm 'xi 'eta t tt c))
    (r2d-rr! cK)
    (dk-cite! 'rr-mul-le-right c r2a-r r2a-K1)
    (r2d-rr! (list '* r2a-r r2a-K1))
    (dk-have! (list 'IN aw (list 'PTS r2a-E)) (lambda () (subst r2a-ptsE) (ass)))
    (dk-cite! 'metric-dist-real r2a-E 'a aw)
    (let ((dist-eq (dk-cite! 'nvs-dist-shift 'm 'a w))
          (dst (list (list 'DIST r2a-E) 'a aw)))
      (dk-have! (list '<= dst cK)
        (lambda () (dk-ineq! dist-eq (list '<= nw cK))))
      (dk-have! (list '< cK r2a-rb)
        (lambda () (dk-ineq! (list '<= cK (list '* r2a-r r2a-K1)) (list '<= (list '* r2a-r r2a-K1) r2a-hb)
                             (list '= (list '+ r2a-hb r2a-hb) r2a-rb) (list '< 0 r2a-hb))))
      (detach-with! (dk-cite! 'ball-mem-from-le r2a-E 'a aw cK r2a-rb)
                    (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-cite! 'subset-mem-fwd (list 'BALL r2a-E 'a r2a-rb) 'u aw)
      (if (not one?)
          (let ((dpt (list (list 'DIST r2a-E) 'a pt)))
            (dk-have! (list 'IN pt 'u) (lambda () (subst (list '= pt aw)) (ass)))
            (dk-have! (list 'IN pt (list 'PTS r2a-E)) (lambda () (subst r2a-ptsE) (ass)))
            (dk-cite! 'metric-dist-real r2a-E 'a pt)
            (dk-have! (list '<= dpt cK) (lambda () (subst (list '= pt aw)) (ass)))
            (list pt dpt cK))
          (list pt dst cK)))))
;;; the curve at t: g(t) == f(P2 t t), and g(0) == f(a)
(define (r2a-g-at! t)
  (let* ((gt (dk-cite! 'seg-curve-apply 'm 'f 'a '((VADD m) eta xi) t))
         (lhs (r2a-add 'a (r2a-act t '((VADD m) eta xi)))))
    (dk-cite! 'nvs-act-in-vec 'm t 'eta) (dk-cite! 'nvs-act-in-vec 'm t 'xi)
    (dk-cite! 'nvs-act-distrib-vec-rr 'm t 'eta 'xi)
    (dk-cite! 'nvs-vadd-comm 'm (r2a-act t 'eta) (r2a-act t 'xi))
    (dk-cite! 'nvs-vadd-in-vec 'm 'a (r2a-act t 'xi))
    (dk-cite! 'nvs-vadd-assoc 'm 'a (r2a-act t 'xi) (r2a-act t 'eta))
    (dk-have! (list '= lhs (r2a-P2 t t))
      (lambda ()
        (subst (list '= (r2a-act t '((VADD m) eta xi)) (r2a-add (r2a-act t 'eta) (r2a-act t 'xi))))
        (subst (list '= (r2a-add (r2a-act t 'eta) (r2a-act t 'xi)) (r2a-add (r2a-act t 'xi) (r2a-act t 'eta))))
        (subst (list '= (r2a-P2 t t) (r2a-add 'a (r2a-add (r2a-act t 'xi) (r2a-act t 'eta)))))
        (rfl)))
    (dk-rewrite-h! gt lhs (r2a-P2 t t))))

;;; (i) g is real on the window W = (-r, r)
(define r2a-W (list 'OOINT (list '- 0 r2a-r) (list '+ 0 r2a-r)))
(define (r2a-W-parts! t)      ; t in W: t in RR, |t| < r, |t| <= r, 0 <= |t|
  (dk-cite! 'ooint-elt-in-rr (list '- 0 r2a-r) (list '+ 0 r2a-r) t)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ooint-membership (list '- 0 r2a-r) (list '+ 0 r2a-r) t))))
  (dk-have! (list '< (list '- r2a-r) t) (lambda () (dk-ineq! (list '< (list '- 0 r2a-r) t))))
  (dk-have! (list '< t r2a-r) (lambda () (dk-ineq! (list '< t (list '+ 0 r2a-r)))))
  (dk-cite! 'rr-abs-lt-of-parts t r2a-r)
  (dk-cite! 'rr-abs-closed t) (dk-cite! 'rr-abs-nonneg t)
  (dk-cite! 'rr-lt-implies-le (list 'abs t) r2a-r))
(define (r2a-g-real! t)       ; t in W: (IN (g t) RR), returns the equation g(t) == f(P2)
  (r2a-W-parts! t)
  (r2a-near! t t (list 'abs t) #f)
  (dk-cite! 'fun-apply-type-c 'f 'u 'RR (r2a-P2 t t))
  (let ((ge (r2a-g-at! t)))
    (dk-have! (list 'IN (list r2a-g t) 'RR) (lambda () (subst ge) (ass)))
    ge))
(dk-cite! 'ooint-subset-rr (list '- 0 r2a-r) (list '+ 0 r2a-r))
(dk-have! (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ r2a-W) (list 'IN (list r2a-g 'et_) 'RR)))
  (lambda () (let ((t (dk-di-var!))) (r2a-g-real! t))))
;;; g(0) == f(a)
(define r2a-g0
  (let ((ge (dk-cite! 'seg-curve-apply 'm 'f 'a '((VADD m) eta xi) 0)))
    (dk-cite! 'nvs-act-zero 'm '((VADD m) eta xi) 'a)
    (dk-rewrite-h! ge (r2a-add 'a (r2a-act 0 '((VADD m) eta xi))) 'a)))
(dk-cite! 'fun-apply-type-c 'f 'u 'RR 'a)

;;; (ii) the eps-bound
(define r2a-target
  (list 'FORALL 'ee_ (list 'IMPLIES '(POS-RR ee_)
    (list 'FORSOME 'ed_ (list 'AND '(POS-RR ed_)
      (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ r2a-W)
        (list 'IMPLIES '(< (abs (- et_ 0)) ed_)
          (list '<= (list 'abs (list '- (list '- (list r2a-g 'et_) (list r2a-g 0)) (list '* '(- et_ 0) r2a-L)))
                    '(* ee_ (abs (- et_ 0))))))))))))
;;; the continuity of FN at a, at radius e: returns (delta . the universal)
(define (r2a-cont! fn e)
  (let* ((ct (r2d-pick 'cont (lambda (x) (and (dk-head-is? x 'IS-CONTINUOUS-AT) (eq? (list-ref x 3) fn)))))
         (fa (dk-project! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
                (list 'FORSOME 'delta (list 'AND '(POS-RR delta)
                  (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b (list 'PTS r2a-SUB))
                    (list 'IMPLIES (list '<= (list (list 'DIST r2a-SUB) 'a 'b) 'delta)
                      (list '<= (list '(DIST RR-MS) (list fn 'a) (list fn 'b)) 'eps))))))))
                'is-continuous-at ct))
         (ex (dk-apply! fa e))
         (d  (dk-skolem! ex #t))
         (u  (r2d-pick 'cont-u (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x d) (dk-contains? x fn))))))
    (dk-cite! 'rr-pos-rr-in-rr d) (dk-cite! 'rr-lt-of-pos-rr d)
    (cons d u)))
;;; b = point near a (dist(E)(a, b) = DST <= BND, BND <= delta): |fn(b) - fn(a)| <= e
(define (r2a-close! fn cu b dst bnd e)
  (let ((d (car cu)) (u (cdr cu)))
    (dk-have! (list 'IN b (list 'PTS r2a-SUB)) (lambda () (subst r2a-ptsS) (ass)))
    (let ((sd (dk-cite! 'subspace-dist r2a-E 'u 'a b)))
      (dk-cite! 'metric-dist-real r2a-E 'a b)
      (dk-have! (list '<= (list (list 'DIST r2a-SUB) 'a b) d)
        (lambda () (subst sd) (dk-ineq! (list '<= dst bnd) (list '<= bnd d))))
      (let* ((cl (dk-apply! u b))
             (rd (dk-cite! 'rr-ms-dist (list fn 'a) (list fn b))))
        (dk-rewrite-h! cl (list '(DIST RR-MS) (list fn 'a) (list fn b)) (list 'abs (list '- (list fn 'a) (list fn b))))
        (dk-cite! 'rr-abs-sub-sym (list fn 'a) (list fn b))
        (dk-have! (list '<= (list 'abs (list '- (list fn b) (list fn 'a))) e)
          (lambda () (dk-ineq! (list '<= (list 'abs (list '- (list fn 'a) (list fn b))) e)
                               (list '= (list 'abs (list '- (list fn 'a) (list fn b))) (list 'abs (list '- (list fn b) (list fn 'a)))))))))))
;;; one leg of the mean value step: base B, direction DIR, field FN with hypothesis H, continuity
;;; CU; point maker MK (tt -> (list pt dst cK)) under |tt| <= |t|; returns the step's conclusion.
(define (r2a-leg! base dir fn H cu t e at bndd mk)
  (let ((impl (dk-cite! 'has-dir-deriv-step 'm 'f base dir t (list fn 'a) e)))
    (dk-have! (cadr impl)
      (lambda ()
        (let* ((pl (dk-peel!))
               (tt (cadr (car (filter (lambda (x) (dk-head-is? x 'IN)) pl)))))
          (dk-cite! 'rr-abs-closed tt) (dk-cite! 'rr-abs-nonneg tt)
          (let* ((res (mk tt)) (pt (car res)) (dst (cadr res)) (cK (caddr res)))
            (r2a-field-at! H fn pt)
            (r2a-close! fn cu pt dst cK e)
            (ew (list fn pt))
            (dk-conj-close! (lambda () (ass)))))))
    (detach! impl)
    (caddr impl)))

(dk-have! r2a-target
  (lambda ()
    (let* ((pl (dk-peel!))
           (ee (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pl)))))
      (dk-pos-parts! ee)
      (let* ((e2 (dk-halve! ee))
             (cp (r2a-cont! 'p e2))
             (cq (r2a-cont! 'q e2))
             (d1 (car cp)) (d2 (car cq))
             (dd (dk-skolem! (dk-cite! 'rr-min-pos d1 d2) #t)))
        (dk-cite! 'rr-pos-rr-of-lt dd)
        (let ((ed0 (dk-skolem! (dk-cite! 'rr-small-factor-real dd r2a-K1) #t)))
          (dk-cite! 'rr-pos-rr-in-rr ed0) (dk-cite! 'rr-lt-of-pos-rr ed0)
          (let ((ed (dk-skolem! (dk-cite! 'rr-min-pos ed0 r2a-r) #t)))
            (dk-cite! 'rr-pos-rr-of-lt ed)
            (ew ed)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'POS-RR)
                   (ass)
                   (let* ((pl2 (dk-peel!))
                          (t (cadr (car (filter (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) r2a-W))) pl2))))
                          (dh (car (filter (lambda (x) (dk-head-is? x '<)) pl2)))
                          (at (list 'abs t))
                          (ge (r2a-g-real! t)))
                     (dk-have! (list '= (list '- t 0) t) (lambda () (crs)))
                     (dk-rewrite-h! dh (list '- t 0) t)
                     (dk-cite! 'rr-lt-implies-le at ed)
                     (dk-cite! 'rr-mul-le-right at ed r2a-K1)
                     (dk-cite! 'rr-mul-le-right ed ed0 r2a-K1)
                     (r2d-rr! (list '* at r2a-K1)) (r2d-rr! (list '* ed r2a-K1)) (r2d-rr! (list '* ed0 r2a-K1))
                     (dk-have! (list '<= (list '* at r2a-K1) d1)
                       (lambda () (dk-ineq! (list '<= (list '* at r2a-K1) (list '* ed r2a-K1))
                                            (list '<= (list '* ed r2a-K1) (list '* ed0 r2a-K1))
                                            (list '<= (list '* ed0 r2a-K1) dd) (list '<= dd d1))))
                     (dk-have! (list '<= (list '* at r2a-K1) d2)
                       (lambda () (dk-ineq! (list '<= (list '* at r2a-K1) (list '* ed r2a-K1))
                                            (list '<= (list '* ed r2a-K1) (list '* ed0 r2a-K1))
                                            (list '<= (list '* ed0 r2a-K1) dd) (list '<= dd d2))))
                     (r2a-near! t t at #t)                       ; P1(t) in u
                     (dk-cite! 'fun-apply-type-c 'f 'u 'RR (r2a-P1 t))
                     (dk-cite! 'fun-apply-type-c 'f 'u 'RR (r2a-P2 t t))
                     (let* ((resA (r2a-leg! 'a 'xi 'q r2a-Hq cq t e2 at (list (list '* at r2a-K1))
                                    (lambda (tt) (r2a-near! tt tt at #t))))
                            (resB (r2a-leg! (r2a-P1 t) 'eta 'p r2a-Hp cp t e2 at (list (list '* at r2a-K1))
                                    (lambda (tt) (r2a-near! t tt at #f))))
                            (fa '(f a)) (f1 (list 'f (r2a-P1 t))) (f2 (list 'f (r2a-P2 t t)))
                            (YA (list '- (list '- f1 fa) (list '* t '(q a))))
                            (XB (list '- (list '- f2 f1) (list '* t '(p a)))))
                       (subst ge)
                       (subst r2a-g0)
                       (subst (list '= (list '- t 0) t))
                       (r2d-rr! XB) (r2d-rr! YA)
                       (dk-have! (list '= (list '- (list '- f2 fa) (list '* t r2a-L)) (list '+ XB YA)) (lambda () (crs)))
                       (subst (list '= (list '- (list '- f2 fa) (list '* t r2a-L)) (list '+ XB YA)))
                       (dk-cite! 'rr-abs-triangle-c XB YA)
                       (r2d-rr! (list 'abs (list '+ XB YA))) (r2d-rr! (list 'abs XB)) (r2d-rr! (list 'abs YA))
                       (r2d-rr! (list '* e2 at)) (r2d-rr! (list '* ee at))
                       (dk-have! (list '= (list '* ee at) (list '+ (list '* e2 at) (list '* e2 at)))
                         (lambda () (subst (list '= ee (list '+ e2 e2))) (crs)))
                       (dk-ineq! (list '<= (list 'abs (list '+ XB YA)) (list '+ (list 'abs XB) (list 'abs YA)))
                                 resA resB
                                 (list '= (list '* ee at) (list '+ (list '* e2 at) (list '* e2 at)))))))))))))))
(dk-cite! 'has-deriv-at-of-eps-bound r2a-g 0 r2a-r r2a-L)
(mac 'HAS-DIR-DERIV)
(ass)
(qed 'has-dir-deriv-add)

;;; ---------------------------------------------------------------------------
;;; (L3) on the span, with the fields p = d_eta f, q = d_xi f continuous on U:
;;;      d_(r.eta + s.xi) f(x) = r p(x) + s q(x) for every x in U.
(define r2b-hyps
  (list '(IS-NORMED-VECTOR-SPACE m) (list 'IS-OPEN r2a-E 'u) '(IN f (FUN u RR))
        '(IN eta (VEC m)) '(IN xi (VEC m))
        '(FORALL x (IMPLIES (IN x u) (HAS-DIR-DERIV m f x eta (p x))))
        '(FORALL x (IMPLIES (IN x u) (HAS-DIR-DERIV m f x xi (q x))))
        (list 'FORALL 'x (list 'IMPLIES '(IN x u) (list 'IS-CONTINUOUS-AT r2a-SUB 'RR-MS 'p 'x)))
        (list 'FORALL 'x (list 'IMPLIES '(IN x u) (list 'IS-CONTINUOUS-AT r2a-SUB 'RR-MS 'q 'x)))))
(define (r2b-rep r s) (r2a-add (r2a-act r 'eta) (r2a-act s 'xi)))
(define (r2b-val x r s) (list '+ (list '* r (list 'p x)) (list '* s (list 'q x))))
(sp (make-wff (forall-guarded '(m u f eta xi p q) r2b-hyps
  '(FORALL x (IMPLIES (IN x u) (FORALL r (IMPLIES (IN r RR) (FORALL s (IMPLIES (IN s RR)
     (HAS-DIR-DERIV m f x ((VADD m) ((ACT m) r eta) ((ACT m) s xi)) (+ (* r (p x)) (* s (q x)))))))))))))
(dk-peel!)
(define r2b-g (dk-goal))
(define r2b-x (list-ref r2b-g 3))
(define r2b-r (cadr (cadr (list-ref r2b-g 4))))
(define r2b-s (cadr (caddr (list-ref r2b-g 4))))
(define r2b-Hp (r2d-pick 'Hp (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'HAS-DIR-DERIV) (dk-contains? z 'eta)))))
(define r2b-Hq (r2d-pick 'Hq (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'HAS-DIR-DERIV) (not (dk-contains? z 'eta))))))
(define r2b-Cp (r2d-pick 'Cp (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-CONTINUOUS-AT) (dk-contains? z 'p)))))
(define r2b-Cq (r2d-pick 'Cq (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-CONTINUOUS-AT) (dk-contains? z 'q)))))
(dk-cite! 'nvs-metric-is-ms 'm)
(define r2b-ptsE (dk-cite! 'nvs-ms-pts 'm))
(dk-project! (list 'SUBSET 'u (list 'PTS r2a-E)) 'is-open (list 'IS-OPEN r2a-E 'u))
(dk-rewrite-h! (list 'SUBSET 'u (list 'PTS r2a-E)) (list 'PTS r2a-E) '(VEC m))
(dk-cite! 'vec-is-set 'm)
(dk-cite! 'subclass-of-set-is-set 'u '(VEC m))
(define r2b-ptsS (dk-cite! 'subspace-pts r2a-E 'u))
(dk-cite! 'subspace-is-metric-space r2a-E 'u)
(dk-cite! 'r7q-rr-pts)
(dk-have! (list 'IN r2b-x (list 'PTS r2a-SUB)) (lambda () (subst r2b-ptsS) (ass)))
(dk-cite! 'subset-mem-fwd 'u '(VEC m) r2b-x)
;;; the scaled field F(sx_) = c * fn(sx_) on PTS(SUB): continuous at x, and the derivative in c.dir
(define (r2b-field! fn dir c hyp cont)
  (let* ((fld (list 'VNB-LAMBDA 'sx_ (list 'PTS r2a-SUB) (list '* c (list fn 'sx_))))
         (ct  (dk-apply! cont r2b-x))
         (ft  (dk-project! (list 'IN fn (list 'FUN (list 'PTS r2a-SUB) '(PTS RR-MS)))
                           (lambda () (mac-h 'IS-CONTINUOUS-AT ct))))
         (ft2 (dk-rewrite-h! ft '(PTS RR-MS) 'RR)))
    (dk-cite! 'ms-rr-scale-continuous-at r2a-SUB c fn r2b-x)
    (dk-cite! 'nvs-act-in-vec 'm c dir)
    (dk-have! (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'HAS-DIR-DERIV 'm 'f 'y (r2a-act c dir) (list fld 'y))))
      (lambda ()
        (let* ((pl (dk-peel!)) (y (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl)))))
          (dk-have! (list 'IN y (list 'PTS r2a-SUB)) (lambda () (subst r2b-ptsS) (ass)))
          (dk-cite! 'subset-mem-fwd 'u '(VEC m) y)
          (dk-apply! hyp y)
          (dk-lam-b!)
          (dk-cite! 'has-dir-deriv-scale 'm 'f y dir c (list fn y))
          (ass))))
    fld))
(define r2b-P (r2b-field! 'p 'eta r2b-r r2b-Hp r2b-Cp))
(define r2b-Q (r2b-field! 'q 'xi r2b-s r2b-Hq r2b-Cq))
(dk-cite! 'nvs-act-in-vec 'm r2b-r 'eta)
(dk-cite! 'nvs-act-in-vec 'm r2b-s 'xi)
(define r2b-sum (dk-cite! 'has-dir-deriv-add 'm 'u 'f (r2a-act r2b-r 'eta) (r2a-act r2b-s 'xi) r2b-P r2b-Q r2b-x))
(dk-lam-b-h! r2b-sum)
(ass)
(qed 'dir-deriv-span-formula)

;;; ---------------------------------------------------------------------------
;;; (L4) SPAN2: the unfold, and closure under + and scaling, with the coefficients.
(sp (make-wff '(FORALL m (FORALL eta (FORALL xi
  (== (SPAN2 m eta xi)
      (SEP s2v_ (VEC m) (FORSOME s2r_ (AND (IN s2r_ RR) (FORSOME s2s_ (AND (IN s2s_ RR)
        (= s2v_ ((VADD m) ((ACT m) s2r_ eta) ((ACT m) s2s_ xi))))))))))))))
(di)
(mac 'SPAN2)
(qrfl)
(qed 'span2-unfold)

(define (r2c-A) (r2a-act 'r1 'eta)) (define (r2c-B) (r2a-act 's1 'xi))
(define (r2c-C) (r2a-act 'r2 'eta)) (define (r2c-D) (r2a-act 's2 'xi))
(sp (make-wff (forall-guarded '(m eta xi r1 s1 r2 s2)
  '((IS-NORMED-VECTOR-SPACE m) (IN eta (VEC m)) (IN xi (VEC m)) (IN r1 RR) (IN s1 RR) (IN r2 RR) (IN s2 RR))
  '(= ((VADD m) ((VADD m) ((ACT m) r1 eta) ((ACT m) s1 xi)) ((VADD m) ((ACT m) r2 eta) ((ACT m) s2 xi)))
      ((VADD m) ((ACT m) (+ r1 r2) eta) ((ACT m) (+ s1 s2) xi))))))
(dk-peel!)
(let ((A (r2c-A)) (B (r2c-B)) (C (r2c-C)) (Dv (r2c-D)))
  (for-each (lambda (cf v) (dk-cite! 'nvs-act-in-vec 'm cf v)) '(r1 s1 r2 s2) '(eta xi eta xi))
  (dk-cite! 'nvs-vadd-in-vec 'm C Dv) (dk-cite! 'nvs-vadd-in-vec 'm B C) (dk-cite! 'nvs-vadd-in-vec 'm C B)
  (dk-cite! 'nvs-vadd-in-vec 'm B Dv)
  (subst (dk-cite! 'nvs-vadd-assoc 'm A B (r2a-add C Dv)))          ; A+(B+(C+D))
  (dk-cite! 'nvs-vadd-assoc 'm B C Dv)
  (subst (list '= (r2a-add B (r2a-add C Dv)) (r2a-add (r2a-add B C) Dv)))
  (subst (dk-cite! 'nvs-vadd-comm 'm B C))                          ; (C+B)+D
  (subst (dk-cite! 'nvs-vadd-assoc 'm C B Dv))                      ; C+(B+D)
  (dk-cite! 'nvs-vadd-assoc 'm A C (r2a-add B Dv))
  (subst (list '= (r2a-add A (r2a-add C (r2a-add B Dv))) (r2a-add (r2a-add A C) (r2a-add B Dv))))
  (subst (dk-cite! 'nvs-act-add-scalars 'm 'r1 'r2 'eta))
  (subst (dk-cite! 'nvs-act-add-scalars 'm 's1 's2 'xi))
  (r2d-rr! '(+ r1 r2)) (r2d-rr! '(+ s1 s2))
  (dk-cite! 'nvs-act-in-vec 'm '(+ r1 r2) 'eta) (dk-cite! 'nvs-act-in-vec 'm '(+ s1 s2) 'xi)
  (dk-cite! 'nvs-vadd-in-vec 'm '((ACT m) (+ r1 r2) eta) '((ACT m) (+ s1 s2) xi))
  (rfl))
(qed 'span2-add-coeffs)
(sp (make-wff (forall-guarded '(m eta xi c r s)
  '((IS-NORMED-VECTOR-SPACE m) (IN eta (VEC m)) (IN xi (VEC m)) (IN c RR) (IN r RR) (IN s RR))
  '(= ((ACT m) c ((VADD m) ((ACT m) r eta) ((ACT m) s xi)))
      ((VADD m) ((ACT m) (* c r) eta) ((ACT m) (* c s) xi))))))
(dk-peel!)
(dk-cite! 'nvs-act-in-vec 'm 'r 'eta) (dk-cite! 'nvs-act-in-vec 'm 's 'xi)
(subst (dk-cite! 'nvs-act-distrib-vec-rr 'm 'c '((ACT m) r eta) '((ACT m) s xi)))
(subst (dk-cite! 'nvs-act-scale-assoc 'm 'c 'r 'eta))
(subst (dk-cite! 'nvs-act-scale-assoc 'm 'c 's 'xi))
(r2d-rr! '(* c r)) (r2d-rr! '(* c s))
(dk-cite! 'nvs-act-in-vec 'm '(* c r) 'eta) (dk-cite! 'nvs-act-in-vec 'm '(* c s) 'xi)
(dk-cite! 'nvs-vadd-in-vec 'm '((ACT m) (* c r) eta) '((ACT m) (* c s) xi))
(rfl)
(qed 'span2-scale-coeffs)

;;; ---------------------------------------------------------------------------
;;; (L5) PROPOSITION 2.27.  For every x in U and phi in the space V generated by eta and xi,
;;; d_phi f(x) is defined (with the value LDIR-DERIV), and phi |-> d_phi f(x) is a linear
;;; functional on V.
(define r2m-V '(SPAN2 m eta xi))
(define (r2m-F x) (list 'VNB-LAMBDA 'phi r2m-V (list 'LDIR-DERIV 'm 'f x 'phi)))
(sp (make-wff (forall-guarded '(m u f eta xi p q) r2b-hyps
  (list 'FORALL 'x (list 'IMPLIES '(IN x u)
    (list 'AND
      (list 'FORALL 'phi (list 'IMPLIES (list 'IN 'phi r2m-V) '(HAS-DIR-DERIV m f x phi (LDIR-DERIV m f x phi))))
      (list 'IS-LINEAR-FUNCTIONAL-ON 'm r2m-V (r2m-F 'x))))))))
(dk-peel!)
(define r2m-x (list-ref (list-ref (list-ref (cadr (dk-goal)) 2) 2) 3))
(define r2m-span-eq (dk-cite! 'span2-unfold 'm 'eta 'xi))
(define r2m-SEP (caddr r2m-span-eq))
(define r2m-formula (dk-cite! 'dir-deriv-span-formula 'm 'u 'f 'eta 'xi 'p 'q))
(dk-project! (list 'SUBSET 'u (list 'PTS r2a-E)) 'is-open (list 'IS-OPEN r2a-E 'u))
(dk-cite! 'nvs-metric-is-ms 'm)
(dk-cite! 'nvs-ms-pts 'm)
(dk-rewrite-h! (list 'SUBSET 'u (list 'PTS r2a-E)) (list 'PTS r2a-E) '(VEC m))
(define r2m-Hp (r2d-pick 'Hp (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'HAS-DIR-DERIV) (dk-contains? z 'eta) (not (dk-contains? z 'xi))))))
(define r2m-Hq (r2d-pick 'Hq (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'HAS-DIR-DERIV) (dk-contains? z 'xi) (not (dk-contains? z 'eta))))))
;;; phi in V: its coefficients r, s; lands (= phi rep), r, s in RR; returns (r s rep)
(define (r2m-rep! phi)
  (let ((h (dk-rewrite-h! (list 'IN phi r2m-V) r2m-V r2m-SEP)))
    (sep-me h)
    (let* ((r (dk-skolem! (r2d-pick 'ex-r (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z phi)))) #t))
           (s (dk-skolem! (r2d-pick 'ex-s (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z phi)))) #t)))
      (list r s (r2b-rep r s)))))
;;; v = rep(r, s): (IN v V)
(define (r2m-in-V! v r s)
  (dk-have! (list 'IN v r2m-V)
    (lambda ()
      (subst r2m-span-eq)
      (for-each (lambda (leaf)
                  (dk-focus! leaf)
                  (if (dk-head-is? (dk-goal) 'IN)
                      (ass)
                      (begin (ew r)
                             (dk-conj-close!
                              (lambda ()
                                (if (dk-head-is? (dk-goal) 'FORSOME)
                                    (begin (ew s) (dk-conj-close! (lambda () (ass))))
                                    (ass)))))))
                (dk-opened (lambda () (sep-mi)))))))
;;; the value: lands (= (LDIR m f x phi) val) given (= phi rep(r,s)); returns val
(define (r2m-val! phi r s)
  (let* ((rep (r2b-rep r s))
         (val (r2b-val r2m-x r s))
         (hd  (dk-apply! r2m-formula r2m-x r s)))
    (dk-cite! 'ldir-deriv-value 'm 'f r2m-x rep val)
    (if (not (equal? phi rep))
        (dk-have! (list '= (list 'LDIR-DERIV 'm 'f r2m-x phi) val)
          (lambda () (subst (list '= phi rep)) (ass))))
    val))
(define (r2m-fields-real!)
  (let* ((hp (dk-apply! r2m-Hp r2m-x)) (hq (dk-apply! r2m-Hq r2m-x)))
    (r2d-hda! hp) (r2d-hda! hq)
    (dk-cite! 'subset-mem-fwd 'u '(VEC m) r2m-x)
    (dk-cite! 'has-deriv-at-in-rr (list 'SEG-CURVE 'm 'f r2m-x 'eta) 0 (list 'p r2m-x))
    (dk-cite! 'has-deriv-at-in-rr (list 'SEG-CURVE 'm 'f r2m-x 'xi) 0 (list 'q r2m-x))))
(r2m-fields-real!)
(dk-cite! 'vec-is-set 'm)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (dk-head-is? (dk-goal) 'FORALL)
       ;; d_phi f(x) is defined
       (let* ((pl (dk-peel!))
              (phi (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) r2m-V))) pl))))
              (rs (r2m-rep! phi)) (r (car rs)) (s (cadr rs)) (rep (caddr rs))
              (val (r2m-val! phi r s)))
         (dk-apply! r2m-formula r2m-x r s)
         (subst (list '= phi rep))
         (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x rep) val))
         (ass))
       ;; linear
       (begin
         (mac 'is-linear-functional-on)
         (for-each
          (lambda (lf)
            (dk-focus! lf)
            (let ((g (dk-goal)))
              (cond
               ((dk-head-is? g 'IN)                                  ; F in FUN(V, RR)
                (dk-lam-type!
                 (lambda ()
                   (let* ((phi (dk-di-var!))
                          (rs (r2m-rep! phi)) (r (car rs)) (s (cadr rs))
                          (val (r2m-val! phi r s)))
                     (r2d-rr! val)
                     (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x phi) val))
                     (ass)))
                 (lambda () (subst r2m-span-eq) (sep-set) (ass))))
               ((dk-contains? g '(VADD m))                           ; additivity
                (let* ((pl (dk-peel!))
                       (ins (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) r2m-V))) pl))
                       (phi (cadr (car ins))) (psi (cadr (cadr ins)))
                       (rs1 (r2m-rep! phi)) (rs2 (r2m-rep! psi))
                       (r1 (car rs1)) (s1 (cadr rs1)) (r2 (car rs2)) (s2 (cadr rs2))
                       (v1 (r2m-val! phi r1 s1)) (v2 (r2m-val! psi r2 s2))
                       (r12 (list '+ r1 r2)) (s12 (list '+ s1 s2))
                       (sum (r2a-add phi psi))
                       (rep12 (r2b-rep r12 s12)))
                  (r2d-rr! r12) (r2d-rr! s12)
                  (dk-cite! 'span2-add-coeffs 'm 'eta 'xi r1 s1 r2 s2)
                  (dk-have! (list '= sum rep12)
                    (lambda () (subst (list '= phi (r2b-rep r1 s1))) (subst (list '= psi (r2b-rep r2 s2))) (ass)))
                  (dk-cite! 'nvs-vadd-in-vec 'm phi psi)
                  (r2m-in-V! sum r12 s12)
                  (let ((v12 (r2m-val! sum r12 s12)))
                    (dk-lam-b!)
                    (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x sum) v12))
                    (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x phi) v1))
                    (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x psi) v2))
                    (crs))))
               (#t                                                   ; homogeneity
                (let* ((pl (dk-peel!))
                       (c (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'RR))) pl))))
                       (phi (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) r2m-V))) pl))))
                       (rs (r2m-rep! phi)) (r (car rs)) (s (cadr rs))
                       (v1 (r2m-val! phi r s))
                       (cr (list '* c r)) (cs (list '* c s))
                       (sc (r2a-act c phi))
                       (rep2 (r2b-rep cr cs)))
                  (r2d-rr! cr) (r2d-rr! cs)
                  (dk-cite! 'span2-scale-coeffs 'm 'eta 'xi c r s)
                  (dk-have! (list '= sc rep2)
                    (lambda () (subst (list '= phi (r2b-rep r s))) (ass)))
                  (dk-cite! 'nvs-act-in-vec 'm c phi)
                  (r2m-in-V! sc cr cs)
                  (let ((v2 (r2m-val! sc cr cs)))
                    (dk-lam-b!)
                    (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x sc) v2))
                    (subst (list '= (list 'LDIR-DERIV 'm 'f r2m-x phi) v1))
                    (crs)))))))
          (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
            (if (null? todo) (reverse acc)
                (begin (dk-focus! (car todo))
                       (if (dk-head-is? (dk-goal) 'AND)
                           (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                           (loop (cdr todo) (cons (car todo) acc))))))))))
 (dk-opened (lambda () (di))))
(qed 'dir-deriv-span-linear)

(display ";; R2D qed failures: ") (display *vnb-qed-failures*) (newline)
