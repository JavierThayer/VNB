;;; tb-rn.scm -- topological-vector-space.pdf Cor 1.5: R^n is a topological vector space (and, on the way,
;;; every normed vector space is one, with the topology of its norm).  Agent TB-01, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-rn.scm, after tvs-seminorm-tvs and the R^n files (rn-is-normed-vector-space).
;;; Library: analysis.  Helper prefix: tbr-.

(define (tbr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define tbr-mv '(NORMED-VECTOR-SPACE-AS-MODULE m))
(define tbr-rrv '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
;;; project the conjuncts of IS-NORMED-VECTOR-SPACE(m) that satisfy PRED (the hypothesis survives)
(define (tbr-nvs-parts! pred)
  (let* ((iff (dk-cite! 'is-normed-vector-space 'm))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND)) (loop (caddr r) (cons (cadr r) acc)) (reverse (cons r acc))))))
    (for-each (lambda (c)
                (if (and (pred c) (not (dk-asm? c)))
                    (dk-have! c (lambda () (mac-h 'IS-NORMED-VECTOR-SPACE '(IS-NORMED-VECTOR-SPACE m)) (dk-split-all!) (ass)))))
              cs)))
(define (tbr-views!)
  (for-each (lambda (n) (dk-cite! n 'm))
            '(normed-vector-space-as-module-is-module nvs-module-view-vec nvs-module-view-vadd nvs-module-view-act
              nvs-module-view-scal nvs-module-view-vzero nvs-module-view-vneg nvs-scal-carr)))

;;; ---------------------------------------------------------------------------
;;; the norm of a normed vector space is a seminorm on the underlying module
(sp (make-wff '(FORALL m (IMPLIES (IS-NORMED-VECTOR-SPACE m)
  (IS-SEMINORM RR-NORMED-FIELD (NORMED-VECTOR-SPACE-AS-MODULE m) (VNRM m))))))
(dk-peel!)
(fact 'rr-is-normed-field)
(tbr-views!)
(tbr-nvs-parts! (lambda (c) (or (equal? c '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))
                                (equal? c '(IN (VNRM m) (FUN (VEC m) RR)))
                                (and (dk-head-is? c 'FORALL) (dk-contains? c '<=) (not (dk-contains? c 'VADD))))))
(mac 'is-seminorm)
(subst (list '== (list 'SCAL tbr-mv) '(SCAL m)))
(subst (list '== (list 'VEC tbr-mv) '(VEC m)))
(subst (list '== (list 'VADD tbr-mv) '(VADD m)))
(subst (list '== (list 'ACT tbr-mv) '(ACT m)))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'FNRM))
         (subst '(== (CARR (SCAL m)) RR))
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld)))
                (lam (car vs)) (x (cadr vs)))
           (dk-cite! 'nvs-vnrm-homog 'm lam x)
           (dk-cite! 'hbs-rr-fnrm lam)
           (subst (list '= (list '(FNRM RR-NORMED-FIELD) lam) (list 'abs lam)))
           (dk-ass!)))
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'VADD))
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))))
           (dk-cite! 'nvs-vnrm-triangle 'm (car vs) (cadr vs))
           (dk-ass!)))
        (#t (error "tbr: unexpected conjunct" (expression->string g)))))))
(tbr-qed! 'nvs-norm-is-seminorm)

;;; ---------------------------------------------------------------------------
;;; a normed vector space, with the one-seminorm family {||.||}, is a topological vector space
(define tbr-ix '(PAIR 0 0))
(define tbr-pf '(VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM m)))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m)
  (list 'IS-SEMINORM-FAMILY-ON 'RR-NORMED-FIELD tbr-mv tbr-ix tbr-pf)))))
(dk-peel!)
(fact 'rr-is-normed-field)
(tbr-views!)
(tbr-nvs-parts! (lambda (c) (or (equal? c '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))
                                (equal? c '(IN (VNRM m) (FUN (VEC m) RR)))
                                (and (dk-head-is? c 'FORALL) (dk-contains? c 'IFF)))))
(dk-cite! 'nvs-norm-is-seminorm 'm)
(fact 'nn-zero-in)
(dk-cite! 'membership-implies-sethood 0 'NN)
(dk-cite! 'pair-self-member 0)
(dk-have! (list 'AND '(IN 0 SET) '(IN 0 SET)) (lambda () (dk-conj-close! dk-ass!)))
(dk-cite! 'pairing 0 0)
(dk-have! (list 'IS-SEMINORM-FAMILY-ON 'RR-NORMED-FIELD tbr-mv tbr-ix tbr-pf)
  (lambda ()
    (mac 'is-seminorm-family-on)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-ass!) #t)
            ((and (dk-head-is? g '=) (equal? (cadr g) (list 'SCAL tbr-mv)))
             (subst (list '== (list 'SCAL tbr-mv) '(SCAL m))) (dk-ass!))
            ((and (dk-head-is? g 'IN) (equal? (cadr g) tbr-pf))
             (dk-lam-type!
               (lambda ()
                 (let ((k (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (subst (list '== (list 'VEC tbr-mv) '(VEC m)))
                   (dk-ass!)))))
            ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-SEMINORM))
             (let ((k (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
               (dk-cite! 'membership-implies-sethood k tbr-ix)
               (dk-lam-b!)
               (dk-ass!)))
            (#t
             ;; separating: p_0(x) = 0 forces x = 0
             (let* ((ld (dk-peel!))
                    (x (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) ld))))
                    (allz (car (filter (lambda (f) (dk-head-is? f 'FORALL)) ld))))
               (subst (list '== (list 'VZERO tbr-mv) '(VZERO m)))
               (dk-rewrite-h! (list 'IN x (list 'VEC tbr-mv)) (list 'VEC tbr-mv) '(VEC m))
               (let ((z (inst*! allz 0)))
                 (dk-lam-b-h! z)
                 (let ((defn (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IFF))) "definiteness")))
                   (inst*! defn x)
                   (let ((iff (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (dk-contains? f x))) "def at x")))
                     (if (dk-only! iff (list '= (list '(VNRM m) x) 0)) (prop)))))))))))))
(dk-ass!)
(tbr-qed! 'nvs-norm-family)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m)
  (list 'IS-TVS 'RR-NORMED-FIELD tbr-mv (list 'SEMINORM-TOP tbr-mv tbr-ix tbr-pf))))))
(dk-peel!)
(dk-cite! 'nvs-norm-family 'm)
(dk-cite! 'seminorm-top-is-tvs 'RR-NORMED-FIELD tbr-mv tbr-ix tbr-pf)
(dk-ass!)
(tbr-qed! 'nvs-norm-top-is-tvs)

;;; ---------------------------------------------------------------------------
;;; COR 1.5: R^n, with the topology of the sup norm, is a topological vector space
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'IS-TVS 'RR-NORMED-FIELD '(NORMED-VECTOR-SPACE-AS-MODULE (RN n))
        (list 'SEMINORM-TOP '(NORMED-VECTOR-SPACE-AS-MODULE (RN n)) tbr-ix
              '(VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM (RN n)))))))))
(dk-peel!)
(dk-cite! 'rn-is-normed-vector-space 'n)
(dk-cite! 'nvs-norm-top-is-tvs '(RN n))
(dk-ass!)
(tbr-qed! 'rn-is-tvs)
