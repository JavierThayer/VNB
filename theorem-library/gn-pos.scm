;;; gn-pos.scm -- positivity through *-homomorphisms, and positivity in a commutative C*-algebra read off
;;; the characters (the commutative core of 1.38, 1.39, 1.43 of F. J. Thayer, "Banach Algebras and
;;; Applications", ch. 1 s. 5).  Agent BA-1117-GN, wave 2026-11-17.  All proofs modulo 0.
;;; Destination: theorem-library/gn-pos.scm, after gn-order and gn-onto.  Library: operator-algebras.
;;; Helper prefix gnp-.  Binders gnp*_ (gnpw_ gnpx_ gnpy_), used by no other file.
;;;
;;; hom-pos-cone: a unital *-homomorphism f maps A+ into B+ (induction on A+).  hom-pos-cone-reflect: if f
;;; is moreover bijective, f(x) in B+ gives x in A+ (induction on B+, pulling generators and sums back).
;;; Applied to the Gelfand transform (onto by 1.23, injective since isometric) and composed with 1.37
;;; (ccont-positive-iff-nonneg): in a commutative C*-algebra x >= 0 iff chi(x) >= 0 for every character.

(define (gnp-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-pos: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 300)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-pos: unfinished" name))))
(define (gnp-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gnp-ass!) (if (and (gnp-open?) (dk-asm? (dk-goal))) (ass)))
(define (gnp-detach-all! f)
  (let loop ((ch f))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gnp-cite2! . args) (gnp-detach-all! (apply dk-cite! args)))
(define (gnp-m s p q) (list (list 'VMUL s) p q))
(define (gnp-ad s p q) (list (list 'VADD s) p q))
(define (gnp-st s p) (list (list 'VSTAR s) p))
(define (gnp-sq s p) (gnp-m s (gnp-st s p) p))
(define (gnp-uvt s x)                  ; typing in VEC s, s unital involutive, bottom-up
  (let ((want (list 'IN x (list 'VEC s))))
    (cond ((dk-asm? want) x)
          ((equal? x (list 'VONE s)) (dk-cite! 'kal-uiba-vone-in s) x)
          ((and (pair? x) (equal? (car x) (list 'VSTAR s))) (gnp-uvt s (cadr x)) (dk-cite! 'kal-uiba-vstar-in s (cadr x)) x)
          ((and (pair? x) (equal? (car x) (list 'VNEG s))) (gnp-uvt s (cadr x)) (dk-cite! 'kal-uiba-vneg-in s (cadr x)) x)
          ((and (pair? x) (equal? (car x) (list 'VADD s)))
           (gnp-uvt s (cadr x)) (gnp-uvt s (caddr x)) (dk-cite! 'kal-uiba-vadd-in s (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) (list 'VMUL s)))
           (gnp-uvt s (cadr x)) (gnp-uvt s (caddr x)) (dk-cite! 'kal-uiba-vmul-in s (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) (list 'ACT s))) (gnp-uvt s (caddr x)) (dk-cite! 'kal-uiba-act-in s (cadr x) (caddr x)) x)
          ((equal? x (list 'VZERO s)) (dk-cite! 'kal-uiba-vzero-in s) x)
          (#t (error "gnp-uvt: cannot type" (expression->string x))))))
(define (gnp-fty! v)                   ; v in VEC a: land (f v) in VEC b
  (if (not (dk-asm? (list 'IN (list 'f v) '(VEC b))))
      (dk-cite! 'fun-apply-type-c 'f '(VEC a) '(VEC b) v)))
(define (gnp-hom-open!)                ; IS-HOM-UIBA(a, b, f) in context: its clauses
  (dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-hom-unital-involutive-banach-algebra-def 'a 'b 'f)))))
(define (gnp-law op)                   ; the clause of the hom carrying (OP a) and (OP b)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (list op 'a)) (dk-contains? h (list op 'b))
                            (not (and (not (eq? op 'VSTAR)) (dk-contains? h '(VSTAR a))))))
           (symbol->string op)))
(define (gnp-f-add! u v)               ; land f(u + v) = f u + f v
  (gnp-detach-all! (dk-apply! (gnp-law 'VADD) u v)))
(define (gnp-f-sq! y)                  ; land f(y* y) = (f y)* (f y)
  (gnp-uvt 'a (gnp-st 'a y))
  (let* ((m (gnp-detach-all! (dk-apply! (gnp-law 'VMUL) (gnp-st 'a y) y)))
         (s (gnp-detach-all! (dk-apply! (gnp-law 'VSTAR) y))))
    (dk-rewrite-h! m (list 'f (gnp-st 'a y)) (gnp-st 'b (list 'f y)))))
(define (gnp-vec-set! s)
  (if (not (dk-asm? (list 'IN (list 'VEC s) 'SET)))
      (begin (dk-cite! 'bcs-uiba-is-uba s) (dk-cite! 'bcp-ro-vec s)
             (dk-rewrite-h! (dk-cite! 'bal-uba-vec-set (list 'UIBA-AS-UBA s)) (list 'VEC (list 'UIBA-AS-UBA s)) (list 'VEC s)))))
(define (gnp-peeled-var ls)           ; the variable typed (IN v (VEC a)) among the landed hypotheses
  (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC a)))) ls))))
(define (gnp-peeled-in ls dom)        ; the variable typed (IN v DOM) among the landed hypotheses
  (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) dom))) ls))))
(define gnp-hom '(IS-HOM-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a b f))

;;; ---- a unital *-homomorphism is positive ----
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f (list 'IMPLIES gnp-hom
  '(FORALL x (IMPLIES (IN x (POS-CONE a)) (IN (f x) (POS-CONE b))))))))))
(dk-peel!)
(gnp-hom-open!)
(dk-cite! 'kal-uiba-vone-in 'a)
(gnp-vec-set! 'a)
(let* ((C (list 'SEP 'gnpw_ '(VEC a) '(IN (f gnpw_) (POS-CONE b))))
       (open! (lambda (u) (sep-me (list 'IN u C)) (dk-split-all!)))
       (_ (dk-have! (list 'SUBSET C '(VEC a)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (open! w) (gnp-ass!)))))
       (ind (dk-cite! 'pos-cone-induct 'a C))
       (i2 (detach-with! ind
             (lambda ()
               (let ((y (dk-di-var!)))
                 (gnp-uvt 'a (gnp-sq 'a y))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (gnp-fty! y)
                     (subst (gnp-f-sq! y))
                     (dk-cite! 'pos-cone-star-square 'b (list 'f y))
                     (gnp-ass!)))))))
       (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (open! u) (open! v)
                 (gnp-uvt 'a (gnp-ad 'a u v))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (subst (gnp-f-add! u v))
                     (dk-cite! 'pos-cone-add-closed 'b (list 'f u) (list 'f v))
                     (gnp-ass!))))))))
  (dk-apply! i3 'x)
  (open! 'x)
  (gnp-ass!))
(gnp-qed! 'hom-pos-cone)

;;; ---- a bijective one reflects positivity ----
(define gnp-onto '(FORALL gnpy_ (IMPLIES (IN gnpy_ (VEC b)) (FORSOME gnpx_ (AND (IN gnpx_ (VEC a)) (= (f gnpx_) gnpy_))))))
(define gnp-inj '(FORALL gnpx_ (IMPLIES (IN gnpx_ (VEC a)) (FORALL gnpy_ (IMPLIES (IN gnpy_ (VEC a))
  (IMPLIES (= (f gnpx_) (f gnpy_)) (= gnpx_ gnpy_)))))))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f (list 'IMPLIES gnp-hom (list 'IMPLIES gnp-onto (list 'IMPLIES gnp-inj
  '(FORALL x (IMPLIES (IN x (VEC a)) (IMPLIES (IN (f x) (POS-CONE b)) (IN x (POS-CONE a)))))))))))))
(dk-peel!)
(gnp-hom-open!)
(gnp-vec-set! 'b)
(define (gnp-pull! g)                  ; g in VEC b: a preimage p in VEC a with f p = g (landed); returns p
  (let ((ex (gnp-detach-all! (dk-apply! (dk-pick (lambda (h) (equal? h gnp-onto)) "onto") g))))
    (let ((p (dk-skolem! ex))) (dk-split-all!) p)))
(define (gnp-inj! p q)                 ; f p = f q in context: land p = q
  (gnp-detach-all! (dk-apply! (dk-pick (lambda (h) (equal? h gnp-inj)) "inj") p q)))
(let* ((C (list 'SEP 'gnpw_ '(VEC b) '(FORALL gnpx_ (IMPLIES (IN gnpx_ (VEC a)) (IMPLIES (= (f gnpx_) gnpw_) (IN gnpx_ (POS-CONE a)))))))
       (open! (lambda (u) (sep-me (list 'IN u C)) (dk-split-all!)))
       (_ (dk-have! (list 'SUBSET C '(VEC b)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (open! w) (gnp-ass!)))))
       (ind (dk-cite! 'pos-cone-induct 'b C))
       (i2 (detach-with! ind
             (lambda ()
               (let ((g (dk-di-var!)))
                 (gnp-uvt 'b (gnp-sq 'b g))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (let* ((ls (dk-peel!)) (w (gnp-peeled-var ls)) (y (gnp-pull! g)))
                       (gnp-uvt 'a (gnp-sq 'a y))
                       (let ((e (gnp-f-sq! y)))
                         (dk-rewrite-h! e (list 'f y) g)
                         (dk-have! (list '= (list 'f w) (list 'f (gnp-sq 'a y)))
                           (lambda () (subst (list '= (list 'f w) (gnp-sq 'b g))) (gnp-ass!)
                                      (if (gnp-open?) (begin (gnp-cite2! 'eq-sym (list 'f (gnp-sq 'a y)) (gnp-sq 'b g)) (gnp-ass!)))))
                         (gnp-inj! w (gnp-sq 'a y))
                         (dk-cite! 'pos-cone-star-square 'a y)
                         (subst (list '= w (gnp-sq 'a y)))
                         (gnp-ass!)))))))))
       (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (open! u) (open! v)
                 (gnp-uvt 'b (gnp-ad 'b u v))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (let* ((ls2 (dk-peel!)) (w (gnp-peeled-var ls2)) (p (gnp-pull! u)) (q (gnp-pull! v)))
                       (gnp-uvt 'a (gnp-ad 'a p q))
                       (let ((e (gnp-f-add! p q)))
                         (dk-rewrite-h! (dk-rewrite-h! e (list 'f p) u) (list 'f q) v)
                         (dk-have! (list '= (list 'f w) (list 'f (gnp-ad 'a p q)))
                           (lambda () (subst (list '= (list 'f w) (gnp-ad 'b u v))) (gnp-ass!)
                                      (if (gnp-open?) (begin (gnp-cite2! 'eq-sym (list 'f (gnp-ad 'a p q)) (gnp-ad 'b u v)) (gnp-ass!)))))
                         (gnp-inj! w (gnp-ad 'a p q))
                         (let ((hu (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h 'POS-CONE))) "u clause"))
                               (hv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h v) (dk-contains? h 'POS-CONE))) "v clause")))
                           (gnp-detach-all! (dk-apply! hu p))
                           (gnp-detach-all! (dk-apply! hv q)))
                         (dk-cite! 'pos-cone-add-closed 'a p q)
                         (subst (list '= w (gnp-ad 'a p q)))
                         (gnp-ass!))))))))))
  (gnp-fty! 'x)
  (dk-apply! i3 '(f x))
  (open! '(f x))
  (dk-have! '(= (f x) (f x)) (lambda () (rfl)))
  (gnp-detach-all! (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(f x)) (dk-contains? h 'POS-CONE))) "clause") 'x))
  (gnp-ass!))
(gnp-qed! 'hom-pos-cone-reflect)

;;; =====================================================================================================
;;; THE GELFAND TRANSFORM.  T = GELFAND-SPACE(a), C = CCONT-ALGEBRA(T), G = GELFAND-TRANSFORM(a).
;;; =====================================================================================================
(define gnp-T '(GELFAND-SPACE a))
(define gnp-PT '(PTS (GELFAND-SPACE a)))
(define gnp-CH '(CHARACTERS a))
(define gnp-C '(CCONT-ALGEBRA (GELFAND-SPACE a)))
(define gnp-GT '(GELFAND-TRANSFORM a))
(define (gnp-Gv x) (list '(GELFAND-TRANSFORM a) x))
(define (gnp-ccsa!)                    ; a commutative C*-algebra: its views and T's facts
  (dk-cite! 'bcs-ccsa-ucsa 'a)
  (dk-cite! 'bcp-ucsa-uiba 'a)
  (dk-cite! 'gno-u-pts 'a)
  (dk-cite! 'gno-u-pts-set 'a)
  (dk-cite! 'gno-u-compact 'a)
  (dk-project! (list 'IS-TOP-SPACE gnp-T) 'IS-COMPACT-T (list 'IS-COMPACT-T gnp-T))
  (dk-split-all! (list (dk-cite! 'gelfand-space-nonempty 'a)))
  (gnp-vec-set! 'a))
(define (gnp-in-pt! c)                 ; c in CHARACTERS a in context: land c in PTS(T)
  (if (not (dk-asm? (list 'IN c gnp-PT)))
      (dk-have! (list 'IN c gnp-PT) (lambda () (subst (list '== gnp-PT gnp-CH)) (gnp-ass!)))))
(define (gnp-in-ch! c)                 ; c in PTS(T) in context: land c in CHARACTERS a
  (if (not (dk-asm? (list 'IN c gnp-CH)))
      (dk-rewrite-h! (list 'IN c gnp-PT) gnp-PT gnp-CH)))

;;; the Gelfand transform is a unital *-homomorphism of unital involutive Banach algebras
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'IS-HOM-UNITAL-INVOLUTIVE-BANACH-ALGEBRA 'a gnp-C gnp-GT)))))
(dk-peel!)
(gnp-ccsa!)
(let* ((h0 (dk-cite! 'gelfand-star-iso 'a))
       (h1 (dk-project! (list 'IS-HOM-UNITAL-C-STAR-ALGEBRA 'a gnp-C gnp-GT) 'is-hom-commutative-c-star-algebra-def h0)))
  (dk-project! (list 'IS-HOM-UNITAL-INVOLUTIVE-BANACH-ALGEBRA 'a gnp-C gnp-GT) 'is-hom-unital-c-star-algebra-def h1))
(gnp-ass!)
(gnp-qed! 'gelfand-hom-uiba)

;;; x >= 0 in A iff G(x) >= 0 in C(A-hat)
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'IFF '(IN x (POS-CONE a)) (list 'IN (gnp-Gv 'x) (list 'POS-CONE gnp-C)))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'gelfand-hom-uiba 'a)
(dk-iff! (lambda (g) (dk-contains? g 'GELFAND-TRANSFORM))
  (lambda () (dk-cite! 'hom-pos-cone 'a gnp-C gnp-GT 'x) (gnp-ass!))
  (lambda ()
    (let ((imp (dk-cite! 'hom-pos-cone-reflect 'a gnp-C gnp-GT)))
      (dk-cite! 'ccont-algebra-vec gnp-T)
      (let* ((i2 (detach-with! imp
                   (lambda ()
                     (let ((y (dk-di-var!)))
                       (dk-rewrite-h! (list 'IN y (list 'VEC gnp-C)) (list 'VEC gnp-C) (list 'CCONT gnp-T))
                       (dk-cite! 'gelfand-onto 'a y)
                       (gnp-ass!)))))
             (i3 (detach-with! i2 (lambda () (dk-cite! 'gelfand-injective 'a) (gnp-ass!)))))
        (gnp-detach-all! (dk-apply! i3 'x))
        (gnp-ass!)))))
(gnp-qed! 'gelfand-pos-cone-iff)

;;; x >= 0 iff chi(x) >= 0 for every character chi
(define gnp-chi-nonneg '(FORALL c (IMPLIES (IN c (CHARACTERS a)) (AND (IN (c x) RR) (<= 0 (c x))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'IFF '(IN x (POS-CONE a)) gnp-chi-nonneg)))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'gno-u-in-ccont 'a 'x)
(let* ((i1 (dk-cite! 'gelfand-pos-cone-iff 'a 'x))
      (i2 (dk-cite! 'ccont-positive-iff-nonneg gnp-T (gnp-Gv 'x))))
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    (lambda ()
      (dk-iff-fwd! i1) (dk-iff-fwd! i2)
      (let* ((pw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (gnp-Gv 'x)) (dk-contains? h 'PTS))) "pointwise"))
             (c (gnp-peeled-in (dk-peel!) gnp-CH)))
        (gnp-in-pt! c)
        (dk-split-all! (list (gnp-detach-all! (dk-apply! pw c))))
        (dk-cite! 'gno-u-value 'a 'x c)
        (gnp-cite2! 'eq-sym (list (gnp-Gv 'x) c) (list c 'x))
        (dk-conj-close! (lambda () (subst (list '= (list c 'x) (list (gnp-Gv 'x) c))) (gnp-ass!)))))
    (lambda ()
      (let ((hq (dk-pick (lambda (h) (equal? h gnp-chi-nonneg)) "chi nonneg")))
        (let ((imp (dk-cite! 'ccont-nonneg-pos-cone gnp-T (gnp-Gv 'x))))
          (detach-with! imp
            (lambda ()
              (let ((p (dk-di-var!)))
                (gnp-in-ch! p)
                (dk-split-all! (list (gnp-detach-all! (dk-apply! hq p))))
                (dk-cite! 'gno-u-value 'a 'x p)
                (dk-conj-close! (lambda () (subst (list '= (list (gnp-Gv 'x) p) (list p 'x))) (gnp-ass!)))))))
        (if (dk-only! i1 (list 'IN (gnp-Gv 'x) (list 'POS-CONE gnp-C))) (prop))))))
(gnp-qed! 'gelfand-positive-iff)

;;; ---- consequences in a commutative C*-algebra ----
(sp (make-wff '(FORALL a (FORALL x (FORALL y (IFF (ALE a x y) (IN ((VADD a) y ((VNEG a) x)) (POS-CONE a))))))))
(dk-peel!) (mac 'ALE) (if (gnp-open?) (prop))
(gnp-qed! 'ale-unfold)

(define (gnp-sa-open! x)               ; x in SA-PART a: land x in VEC a, x* = x, IS-SELF-ADJOINT-EL(a, x)
  (let* ((u (dk-cite! 'sa-part-unfold 'a))
         (m (dk-rewrite-h! (list 'IN x '(SA-PART a)) '(SA-PART a) (caddr u))))
    (sep-me m) (dk-split-all!)
    (let ((i (dk-cite! 'is-self-adjoint-el 'a x)))
      (dk-have! (list 'IS-SELF-ADJOINT-EL 'a x)
        (lambda () (if (dk-only! i (list 'IN x '(VEC a)) (list '= (list '(VSTAR a) x) x)) (prop)))))))
(define (gnp-n x) (list '(VNRM a) x))
(define (gnp-norm! x)                  ; ||x|| in RR, 0 <= ||x||
  (dk-cite! 'bcp-u-bae-vnrm-type 'a x) (dk-cite! 'bcp-u-bal-uba-vnrm-nonneg 'a x))
(define (gnp-char-bound! c x)          ; c a character, x in VEC a, c(x) real in context: land -||x|| <= c x <= ||x||
  (gnp-norm! x)
  (let* ((mb (dk-cite! 'bcs-character-bound 'a c x))
         (ma (dk-cite! 'rr-magnitude-is-abs (list c x)))
         (ab (dk-rewrite-h! mb (list 'MAGNITUDE (list c x)) (list 'ABS (list c x)))))
    (dk-split-all! (list (gnp-cite2! 'rr-abs-le-parts (list c x) (gnp-n x))))))
(define (gnp-char-sa! c x)             ; x self-adjoint: c(x) in RR and the bound
  (dk-cite! 'kcs-character-sa-real 'a c x)
  (gnp-char-bound! c x))
(define (gnp-ceval! c e)               ; rewrite c(e) in the goal by the character laws, outside in
  (cond ((and (pair? e) (equal? (car e) '(VADD a)))
         (gnp-uvt 'a (cadr e)) (gnp-uvt 'a (caddr e))
         (subst (dk-cite! 'char-vadd 'a c (cadr e) (caddr e))) (gnp-ceval! c (cadr e)) (gnp-ceval! c (caddr e)))
        ((and (pair? e) (equal? (car e) '(VNEG a)))
         (gnp-uvt 'a (cadr e)) (subst (dk-cite! 'char-vneg 'a c (cadr e))) (gnp-ceval! c (cadr e)))
        ((and (pair? e) (equal? (car e) '(ACT a)))
         (gnp-uvt 'a (caddr e)) (subst (dk-cite! 'char-act 'a c (cadr e) (caddr e))) (gnp-ceval! c (caddr e)))
        ((equal? e '(VONE a)) (subst (dk-cite! 'char-vone 'a c)))
        (#t #t)))
(define (gnp-ceval-h! c e h)           ; the same on a hypothesis h containing c(e); returns the rewritten h
  (cond ((and (pair? e) (equal? (car e) '(VADD a)))
         (gnp-uvt 'a (cadr e)) (gnp-uvt 'a (caddr e))
         (let* ((q (dk-cite! 'char-vadd 'a c (cadr e) (caddr e))) (h1 (dk-rewrite-h! h (cadr q) (caddr q))))
           (gnp-ceval-h! c (caddr e) (gnp-ceval-h! c (cadr e) h1))))
        ((and (pair? e) (equal? (car e) '(VNEG a)))
         (gnp-uvt 'a (cadr e))
         (let* ((q (dk-cite! 'char-vneg 'a c (cadr e))) (h1 (dk-rewrite-h! h (cadr q) (caddr q)))) (gnp-ceval-h! c (cadr e) h1)))
        ((and (pair? e) (equal? (car e) '(ACT a)))
         (gnp-uvt 'a (caddr e))
         (let* ((q (dk-cite! 'char-act 'a c (cadr e) (caddr e))) (h1 (dk-rewrite-h! h (cadr q) (caddr q)))) (gnp-ceval-h! c (caddr e) h1)))
        ((equal? e '(VONE a)) (let ((q (dk-cite! 'char-vone 'a c))) (dk-rewrite-h! h (cadr q) (caddr q))))
        (#t h)))
(define (gnp-chi-of x)                 ; the right side of gelfand-positive-iff at x
  (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a)) (list 'AND (list 'IN (list 'c x) 'RR) (list '<= 0 (list 'c x))))))
(define (gnp-pos-from-chi! e thunk)    ; goal (IN e (POS-CONE a)); THUNK c proves (AND (IN (c e) RR) (<= 0 (c e)))
  (gnp-uvt 'a e)
  (let ((i (dk-cite! 'gelfand-positive-iff 'a e)))
    (dk-have! (gnp-chi-of e) (lambda () (let ((c (gnp-peeled-in (dk-peel!) gnp-CH))) (thunk c))))
    (if (dk-only! i (gnp-chi-of e)) (prop))))
(define (gnp-chi-from-pos! e c)        ; e in A+ in context, c a character: land c(e) in RR and 0 <= c(e)
  (gnp-uvt 'a e)
  (let ((i (dk-cite! 'gelfand-positive-iff 'a e)))
    (dk-iff-fwd! i)
    (dk-split-all! (list (gnp-detach-all! (dk-apply! (dk-pick (lambda (h) (equal? h (gnp-chi-of e))) "chi of e") c))))))
(define (gnp-in-cc! l) (if (not (dk-asm? (list 'IN l 'CC))) (dk-cite! 'rr-subset-cc l)))

;;; 1.36 exactly, commutative case: x <= l 1 for every real l >= ||x|| (in particular l = ||x||)
(define gnp-e (gnp-ad 'a '((ACT a) l (VONE a)) '((VNEG a) x)))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a))
  (list 'FORALL 'l (list 'IMPLIES '(IN l RR) (list 'IMPLIES (list '<= (gnp-n 'x) 'l) '(ALE a x ((ACT a) l (VONE a))))))))))))
(dk-peel!)
(gnp-ccsa!)
(gnp-sa-open! 'x)
(gnp-in-cc! 'l)
(dk-cite! 'bcs-uiba-scal-carr 'a)
(mac 'ALE)
(gnp-pos-from-chi! gnp-e
  (lambda (c)
    (gnp-ceval! c gnp-e)
    (gnp-char-sa! c 'x)
    (let ((v (list '+ (list '* 'l 1) (list '- (list c 'x)))))
      (dk-real! v)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (gnp-ass!) (dk-ineq! (list '<= (list c 'x) (gnp-n 'x)) (list '<= (gnp-n 'x) 'l))))))))
(if (gnp-open?) (begin (gnp-uvt 'a '((ACT a) l (VONE a))) (rfl)))
(gnp-qed! 'ccsa-order-unit-le)

;;; goal (<= ||x|| bm), bm real and 0 <= bm in context: through ||x|| = sup |G(x)|; PTW! p proves
;;; (<= (MAGNITUDE (p x)) bm) for a character p (landed in CHARACTERS a)
(define (gnp-norm-le! x bm ptw!)
  (gnp-uvt 'a x)
  (dk-cite! 'gno-u-in-ccont 'a x)
  (dk-split-all! (list (dk-cite! 'ccont-parts gnp-T (gnp-Gv x))))
  (let* ((iso (dk-cite! 'gelfand-isometric 'a x))
         (sup (cadr iso)))
    (gnp-norm! x)
    (gnp-cite2! 'eq-sym sup (gnp-n x))
    (subst (list '= (gnp-n x) sup))
    (let ((r (dk-cite! 'sup-norm-t-least gnp-T (gnp-Gv x) bm)))
      (dk-split-all! (list (detach-with! r
        (lambda ()
          (let ((p (dk-di-var!)))
            (gnp-in-ch! p)
            (dk-cite! 'gno-u-value 'a x p)
            (subst (list '= (list (gnp-Gv x) p) (list p x)))
            (ptw! p))))))
      (gnp-ass!))))
(define (gnp-mag-real! v)              ; v real: rewrite MAGNITUDE(v) to ABS(v) in the goal
  (subst (dk-cite! 'rr-magnitude-is-abs v)))

;;; 1.43, commutative case: 0 <= x <= y gives ||x|| <= ||y||
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (POS-CONE a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (POS-CONE a))
    (list 'IMPLIES '(ALE a x y) (list '<= (gnp-n 'x) (gnp-n 'y)))))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'pos-cone-in-vec 'a 'x) (dk-cite! 'pos-cone-in-vec 'a 'y)
(gnp-norm! 'y)
(let ((d (gnp-ad 'a 'y '((VNEG a) x))))
  (dk-iff-fwd! (dk-cite! 'ale-unfold 'a 'x 'y))
  (gnp-norm-le! 'x (gnp-n 'y)
    (lambda (p)
      (gnp-chi-from-pos! 'x p)
      (gnp-chi-from-pos! 'y p)
      (gnp-chi-from-pos! d p)
      (let ((h (gnp-ceval-h! p d (list '<= 0 (list p d)))))
        (gnp-char-bound! p 'y)
        (gnp-mag-real! (list p 'x))
        (subst (gnp-cite2! 'rr-abs-of-nonneg (list p 'x)))
        (dk-ineq! h (list '<= (list p 'y) (gnp-n 'y)))))))
(gnp-qed! 'ccsa-norm-monotone)

;;; 1.39 (second assertion), commutative case: 0 <= y, ||y|| <= 1 give ||1 - y|| <= 1
(define gnp-1y (gnp-ad 'a '(VONE a) '((VNEG a) y)))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'FORALL 'y (list 'IMPLIES '(IN y (POS-CONE a)) (list 'IMPLIES (list '<= (gnp-n 'y) 1) (list '<= (gnp-n gnp-1y) 1))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'pos-cone-in-vec 'a 'y)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 1) (lambda () (arith)))
(gnp-norm-le! gnp-1y 1
  (lambda (p)
    (gnp-ceval! p gnp-1y)
    (gnp-chi-from-pos! 'y p)
    (gnp-char-bound! p 'y)
    (let ((v (list '+ 1 (list '- (list p 'y)))))
      (dk-real! v)
      (gnp-mag-real! v)
      (dk-have! (list '<= (list '- 1) v) (lambda () (dk-ineq! (list '<= (list p 'y) (gnp-n 'y)) (list '<= (gnp-n 'y) 1))))
      (dk-have! (list '<= v 1) (lambda () (dk-ineq! (list '<= 0 (list p 'y)))))
      (gnp-cite2! 'rr-abs-le-of-parts v 1)
      (gnp-ass!))))
(gnp-qed! 'ccsa-one-minus-pos-norm)

;;; 1.40, commutative case: for x self-adjoint, x >= 0 iff || ||x|| 1 - x || <= ||x||
(define gnp-ex (gnp-ad 'a (list '(ACT a) (gnp-n 'x) '(VONE a)) '((VNEG a) x)))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a)) (list 'IFF '(IN x (POS-CONE a)) (list '<= (gnp-n gnp-ex) (gnp-n 'x)))))))))
(dk-peel!)
(gnp-ccsa!)
(gnp-sa-open! 'x)
(gnp-norm! 'x)
(gnp-in-cc! (gnp-n 'x))
(gnp-uvt 'a gnp-ex)
(define (gnp-v c) (list '+ (list '* (gnp-n 'x) 1) (list '- (list c 'x))))
(dk-iff! (lambda (g) (dk-head-is? g '<=))
  (lambda ()
    (gnp-norm-le! gnp-ex (gnp-n 'x)
      (lambda (p)
        (gnp-ceval! p gnp-ex)
        (gnp-chi-from-pos! 'x p)
        (gnp-char-sa! p 'x)
        (let ((v (gnp-v p)))
          (dk-real! v)
          (gnp-mag-real! v)
          (dk-have! (list '<= (list '- (gnp-n 'x)) v) (lambda () (dk-ineq! (list '<= (list p 'x) (gnp-n 'x)) (list '<= 0 (gnp-n 'x)))))
          (dk-have! (list '<= v (gnp-n 'x)) (lambda () (dk-ineq! (list '<= 0 (list p 'x)))))
          (gnp-cite2! 'rr-abs-le-of-parts v (gnp-n 'x))
          (gnp-ass!)))))
  (lambda ()
    (gnp-pos-from-chi! 'x
      (lambda (c)
        (gnp-char-sa! c 'x)
        (let* ((mb (dk-cite! 'bcs-character-bound 'a c gnp-ex))
               (h1 (gnp-ceval-h! c gnp-ex mb))
               (v (gnp-v c)))
          (dk-real! v)
          (gnp-norm! gnp-ex)
          (dk-cite! 'rr-magnitude-is-abs v)
          (dk-rewrite-h! h1 (list 'MAGNITUDE v) (list 'ABS v))
          (dk-have! (list '<= (list 'ABS v) (gnp-n 'x))
            (lambda () (dk-ineq! (list '<= (list 'ABS v) (gnp-n gnp-ex)) (list '<= (gnp-n gnp-ex) (gnp-n 'x)))))
          (dk-split-all! (list (gnp-cite2! 'rr-abs-le-parts v (gnp-n 'x))))
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (gnp-ass!) (dk-ineq! (list '<= v (gnp-n 'x)))))))))))
(gnp-qed! 'ccsa-pos-norm-test)

;;; 1.38 (A+ and -A+ meet in 0), commutative case
(define gnp-B '(UIBA-AS-UBA a))
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL x (IMPLIES (IN x (POS-CONE a))
  (IMPLIES (IN ((VNEG a) x) (POS-CONE a)) (= x (VZERO a)))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'pos-cone-in-vec 'a 'x)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(<= 0 0) (lambda () (arith)))
(dk-have! (list '<= (gnp-n 'x) 0)
  (lambda ()
    (gnp-norm-le! 'x 0
      (lambda (p)
        (gnp-chi-from-pos! 'x p)
        (gnp-chi-from-pos! '((VNEG a) x) p)
        (let ((h (gnp-ceval-h! p '((VNEG a) x) (list '<= 0 (list p '((VNEG a) x))))))
          (gnp-mag-real! (list p 'x))
          (subst (gnp-cite2! 'rr-abs-of-nonneg (list p 'x)))
          (dk-ineq! h))))))
(gnp-norm! 'x)
(dk-have! (list '= (gnp-n 'x) 0) (lambda () (dk-ineq! (list '<= (gnp-n 'x) 0) (list '<= 0 (gnp-n 'x)))))
(dk-cite! 'bcs-uiba-is-uba 'a)
(dk-cite! 'bcp-ro-vec 'a) (dk-cite! 'bcp-ro-vnrm 'a) (dk-cite! 'bcp-ro-vzero 'a)
(dk-have! (list 'IN 'x (list 'VEC gnp-B)) (lambda () (subst (list '== (list 'VEC gnp-B) '(VEC a))) (gnp-ass!)))
(let* ((i1 (dk-cite! 'bal-uba-vnrm-definite gnp-B 'x))
       (i2 (dk-rewrite-h! i1 (list 'VNRM gnp-B) '(VNRM a)))
       (i3 (dk-rewrite-h! i2 (list 'VZERO gnp-B) '(VZERO a))))
  (if (dk-only! i3 (list '= (gnp-n 'x) 0)) (prop)))
(gnp-qed! 'ccsa-pos-cone-antisym)

;;; 1.39 (first assertion), commutative case: x self-adjoint, ||x|| <= 1 give x <= 1, i.e. 1 - x >= 0
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a)) (list 'IMPLIES (list '<= (gnp-n 'x) 1) '(ALE a x (VONE a)))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(IN 1 CC) (lambda () (arith)))
(dk-cite! 'ccsa-order-unit-le 'a 'x 1)
(gnp-uvt 'a '(VONE a))
(let ((h (dk-pick (lambda (h) (and (dk-head-is? h 'ALE))) "x <= 1 1")))
  (dk-cite! 'kal-uiba-act-one 'a '(VONE a))
  (dk-rewrite-h! h '((ACT a) 1 (VONE a)) '(VONE a)))
(gnp-ass!)
(gnp-qed! 'ccsa-sa-le-one)

;;; =====================================================================================================
;;; UP TO AN AMBIENT C*-ALGEBRA b: a positive element of a unital C*-subalgebra a of b is positive in b.
;;; With a = C*(x, 1) (commutative for x self-adjoint) the commutative results above give the notes' forms.
;;; =====================================================================================================
(define gnp-sub '(IS-UNITAL-C-STAR-SUBALGEBRA a b))
(define (gnp-sub-setup!)
  (dk-cite! 'bcp-sub-ucsa-a 'a 'b) (dk-cite! 'bcp-sub-ucsa-b 'a 'b)
  (dk-cite! 'bcp-ucsa-uiba 'a) (dk-cite! 'bcp-ucsa-uiba 'b)
  (gnp-vec-set! 'a) (gnp-vec-set! 'b))
(define (gnp-sub-vec! v) (gnp-uvt 'a v) (if (not (dk-asm? (list 'IN v '(VEC b)))) (dk-cite! 'bcp-sub-vec 'a 'b v)))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES gnp-sub
  '(FORALL x (IMPLIES (IN x (POS-CONE a)) (IN x (POS-CONE b)))))))))
(dk-peel!)
(gnp-sub-setup!)
(let* ((C '(SEP gnpw_ (VEC a) (IN gnpw_ (POS-CONE b))))
       (open! (lambda (u) (sep-me (list 'IN u C)) (dk-split-all!)))
       (_ (dk-have! (list 'SUBSET C '(VEC a)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (open! w) (gnp-ass!)))))
       (ind (dk-cite! 'pos-cone-induct 'a C))
       (i2 (detach-with! ind
             (lambda ()
               (let ((z (dk-di-var!)))
                 (gnp-uvt 'a (gnp-sq 'a z))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (gnp-sub-vec! z) (gnp-uvt 'a (gnp-st 'a z))
                     (subst (dk-cite! 'bcp-sub-vmul 'a 'b (gnp-st 'a z) z))
                     (subst (dk-cite! 'bcp-sub-vstar 'a 'b z))
                     (dk-cite! 'pos-cone-star-square 'b z)
                     (gnp-ass!)))))))
       (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (open! u) (open! v)
                 (gnp-uvt 'a (gnp-ad 'a u v))
                 (in-sep! (lambda () (gnp-ass!))
                   (lambda ()
                     (subst (dk-cite! 'bcp-sub-vadd 'a 'b u v))
                     (dk-cite! 'pos-cone-add-closed 'b u v)
                     (gnp-ass!))))))))
  (dk-apply! i3 'x)
  (open! 'x)
  (gnp-ass!))
(gnp-qed! 'sub-pos-cone)

;;; 1.36 with lambda = ||x||, for x self-adjoint in b lying in a commutative unital C*-subalgebra a of b
(define (gnp-eb l) (list '(VADD b) (list '(ACT b) l '(VONE b)) '((VNEG b) x)))
(define (gnp-ea l) (list '(VADD a) (list '(ACT a) l '(VONE a)) '((VNEG a) x)))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(= ((VSTAR b) x) x)
    (list 'FORALL 'l (list 'IMPLIES '(IN l RR) (list 'IMPLIES '(<= ((VNRM b) x) l) '(ALE b x ((ACT b) l (VONE b)))))))))))))))
(dk-peel!)
(gnp-sub-setup!)
(gnp-in-cc! 'l)
(dk-cite! 'bcp-sub-vstar 'a 'b 'x)
(dk-cite! 'bcp-sub-vnrm 'a 'b 'x)
(dk-have! '(IN x (SA-PART a))
  (lambda ()
    (subst (dk-cite! 'sa-part-unfold 'a))
    (in-sep! (lambda () (gnp-ass!))
      (lambda () (subst (list '= '((VSTAR a) x) '((VSTAR b) x))) (gnp-ass!)))))
(dk-have! '(<= ((VNRM a) x) l) (lambda () (subst (list '= '((VNRM a) x) '((VNRM b) x))) (gnp-ass!)))
(dk-cite! 'ccsa-order-unit-le 'a 'x 'l)
(dk-iff-fwd! (dk-cite! 'ale-unfold 'a 'x '((ACT a) l (VONE a))))
(dk-cite! 'sub-pos-cone 'a 'b (gnp-ea 'l))
(gnp-sub-vec! 'x) (gnp-uvt 'a '(VONE a)) (gnp-uvt 'a '((ACT a) l (VONE a))) (gnp-uvt 'a '((VNEG a) x))
(let* ((h (list 'IN (gnp-ea 'l) '(POS-CONE b)))
       (h1 (dk-rewrite-h! h (gnp-ea 'l) (caddr (dk-cite! 'bcp-sub-vadd 'a 'b '((ACT a) l (VONE a)) '((VNEG a) x)))))
       (h2 (dk-rewrite-h! h1 '((ACT a) l (VONE a)) (caddr (dk-cite! 'bcp-sub-act 'a 'b 'l '(VONE a)))))
       (h3 (dk-rewrite-h! h2 '((VNEG a) x) (caddr (dk-cite! 'bcp-sub-vneg 'a 'b 'x))))
       (_o (dk-cite! 'bcp-sub-one 'a 'b))
       (h4 (dk-rewrite-h! h3 '(VONE a) '(VONE b))))
  #t)
(mac 'ALE)
(gnp-ass!)
(if (gnp-open?) (begin (gnp-uvt 'b '((ACT b) l (VONE b))) (rfl)))
(gnp-qed! 'sub-order-unit-le)

;;; =====================================================================================================
;;; SQUARE ROOTS, commutative case (1.38's A+ = A^2_sa, 1.39 first assertion in the notes' form):
;;; x >= 0 has a positive self-adjoint h with h h = x.  h = G^-1(sqrt o |Re G(x)|) (ccont-sqrt-re-ptw, 1.23).
;;; =====================================================================================================
(define (gnp-G-eq! u v ptw!)           ; goal (= u v), u v in VEC a: by injectivity; PTW! p proves (= (p u) (p v))
  (gnp-uvt 'a u) (gnp-uvt 'a v)
  (dk-cite! 'gno-u-in-ccont 'a u) (dk-cite! 'gno-u-in-ccont 'a v)
  (let ((imp (dk-cite! 'gelfand-injective 'a u v)))
    (detach-with! imp
      (lambda ()
        (dk-fun-ext! (gnp-Gv u) (gnp-Gv v) gnp-PT 'CC
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gnp-T (gnp-Gv u)))) (gnp-ass!))
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gnp-T (gnp-Gv v)))) (gnp-ass!))
          (lambda (p)
            (gnp-in-ch! p)
            (dk-cite! 'gno-u-value 'a u p) (dk-cite! 'gno-u-value 'a v p)
            (subst (list '= (list (gnp-Gv u) p) (list p u)))
            (subst (list '= (list (gnp-Gv v) p) (list p v)))
            (ptw! p)))))
    (gnp-ass!)))
(define gnp-f (gnp-Gv 'x))
(define gnp-g (list 'VNB-LAMBDA 'gnpz_ gnp-PT (list 'sqrt (list 'abs (list 'real-part (list gnp-f 'gnpz_))))))
(define (gnp-sqrt-ty! w)               ; w in CC: sqrt(|Re w|) in RR and CC
  (let ((r (list 'real-part w)))
    (dk-cite! 'real-part-in-rr w)
    (dk-cite! 'rr-abs-closed r) (dk-cite! 'rr-abs-nonneg r)
    (dk-split-all! (list (gnp-cite2! 'sqrt-nonneg (list 'abs r))))
    (dk-cite! 'rr-subset-cc (list 'sqrt (list 'abs r)))))
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL x (IMPLIES (IN x (POS-CONE a))
  (FORSOME gnph_ (AND (IN gnph_ (POS-CONE a)) (AND (IN gnph_ (SA-PART a)) (= ((VMUL a) gnph_ gnph_) x))))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'pos-cone-in-vec 'a 'x)
(dk-cite! 'gno-u-in-ccont 'a 'x)
(dk-split-all! (list (dk-cite! 'ccont-parts gnp-T gnp-f)))
(dk-have! (list 'IN gnp-g (list 'FUN gnp-PT 'CC))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                               (dk-cite! 'fun-apply-type-c gnp-f gnp-PT 'CC z)
                               (gnp-sqrt-ty! (list gnp-f z))
                               (gnp-ass!)))
                  (lambda () (gnp-ass!)))))
(let ((imp (dk-cite! 'ccont-sqrt-re-ptw gnp-T gnp-f gnp-g)))
  (detach-with! imp
    (lambda () (let ((z (dk-di-var!)))
                 (dk-cite! 'fun-apply-type-c gnp-f gnp-PT 'CC z)
                 (gnp-sqrt-ty! (list gnp-f z))
                 (dk-lam-b!)
                 (if (gnp-open?) (rfl))))))
(let* ((ex (dk-cite! 'gelfand-onto 'a gnp-g))
       (h (dk-skolem! ex))
       (_ (dk-split-all!))
       (hv! (lambda (c)               ; c a character: land (= (c h) (sqrt (c x))) and the sqrt facts at c x
              (gnp-in-pt! c)
              (gnp-chi-from-pos! 'x c)
              (dk-cite! 'gno-u-value 'a h c)
              (dk-cite! 'gno-u-value 'a 'x c)
              (let ((s (list 'sqrt (list c 'x))))
                (dk-split-all! (list (gnp-cite2! 'sqrt-prop (list c 'x))))
                (dk-have! (list '= (list c h) s)
                  (lambda ()
                    (gnp-cite2! 'eq-sym (list (gnp-Gv h) c) (list c h))
                    (subst (list '= (list c h) (list (gnp-Gv h) c)))
                    (subst (list '= (gnp-Gv h) gnp-g))
                    (dk-cite! 'fun-apply-type-c gnp-f gnp-PT 'CC c)
                    (gnp-sqrt-ty! (list gnp-f c))
                    (dk-lam-b!)
                    (subst (list '= (list gnp-f c) (list c 'x)))
                    (subst (dk-cite! 'cc-re-of-real (list c 'x)))
                    (subst (gnp-cite2! 'rr-abs-of-nonneg (list c 'x)))
                    (if (gnp-open?) (begin (dk-cite! 'rr-subset-cc s) (rfl)))))
                s))))
  (gnp-uvt 'a (gnp-m 'a h h)) (gnp-uvt 'a (gnp-st 'a h))
  (ew h)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
         ((equal? g (list 'IN h '(POS-CONE a)))
          (gnp-pos-from-chi! h (lambda (c) (let ((s (hv! c))) (subst (list '= (list c h) s)) (dk-conj-close! (lambda () (gnp-ass!)))))))
         ((equal? g (list 'IN h '(SA-PART a)))
          (subst (dk-cite! 'sa-part-unfold 'a))
          (in-sep! (lambda () (gnp-ass!))
            (lambda ()
              (gnp-G-eq! (gnp-st 'a h) h
                (lambda (p)
                  (let ((s (hv! p)))
                    (subst (dk-cite! 'character-preserves-involution 'a p h))
                    (subst (list '= (list p h) s))
                    (subst (dk-cite! 'cc-conjugate-fixes-rr s))
                    (if (gnp-open?) (begin (dk-cite! 'rr-subset-cc s) (rfl)))))))))
         (#t
          (gnp-G-eq! (gnp-m 'a h h) 'x
            (lambda (p)
              (let ((s (hv! p)))
                (subst (dk-cite! 'char-vmul 'a p h h))
                (subst (list '= (list p h) s))
                (subst (list '= (list '* s s) (list p 'x)))
                (if (gnp-open?) (begin (dk-cite! 'rr-subset-cc (list p 'x)) (rfl))))))))))))
(gnp-qed! 'ccsa-pos-sqrt)

;;; ---- A^2_sa (SA-SQUARES) against A+ ----
(define (gnp-sasq-open! s x)           ; x in SA-SQUARES(s): returns the witness w, landing w in SA-PART s and x = w w
  (let* ((u (dk-cite! 'sa-squares-unfold s))
         (m (dk-rewrite-h! (list 'IN x (list 'SA-SQUARES s)) (list 'SA-SQUARES s) (caddr u))))
    (sep-me m) (dk-split-all!)
    (let ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x))) "the witness")))
      (let ((w (dk-skolem! ex))) (dk-split-all!) w))))
(define (gnp-sasq-in! s x w)           ; goal x in SA-SQUARES(s), with w in SA-PART s and x = w w in context
  (subst (dk-cite! 'sa-squares-unfold s))
  (in-sep! (lambda () (gnp-ass!)) (lambda () (ew w) (dk-conj-close! (lambda () (gnp-ass!))))))
(define (gnp-sa-open-s! s x)           ; x in SA-PART s: x in VEC s, x* = x
  (let* ((u (dk-cite! 'sa-part-unfold s))
         (m (dk-rewrite-h! (list 'IN x (list 'SA-PART s)) (list 'SA-PART s) (caddr u))))
    (sep-me m) (dk-split-all!)))

;;; a square of a self-adjoint element is positive (any unital involutive Banach algebra)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (SA-SQUARES a)) (IN x (POS-CONE a))))))))
(dk-peel!)
(let ((w (gnp-sasq-open! 'a 'x)))
  (gnp-sa-open-s! 'a w)
  (dk-cite! 'pos-cone-star-square 'a w)
  (dk-rewrite-h! (list 'IN (gnp-sq 'a w) '(POS-CONE a)) (gnp-st 'a w) w)
  (gnp-cite2! 'eq-sym 'x (gnp-m 'a w w))
  (subst (list '= 'x (gnp-m 'a w w)))
  (gnp-ass!))
(gnp-qed! 'sa-square-pos)

;;; 1.38 (A+ = A^2_sa), commutative case
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (IFF (IN x (POS-CONE a)) (IN x (SA-SQUARES a)))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-iff! (lambda (g) (dk-contains? g 'SA-SQUARES))
  (lambda ()
    (let* ((ex (dk-cite! 'ccsa-pos-sqrt 'a 'x)) (h (dk-skolem! ex)))
      (dk-split-all!)
      (gnp-cite2! 'eq-sym (gnp-m 'a h h) 'x)
      (gnp-sasq-in! 'a 'x h)))
  (lambda () (dk-cite! 'sa-square-pos 'a 'x) (gnp-ass!)))
(gnp-qed! 'ccsa-pos-cone-sa-squares)

(define gnp-1x (gnp-ad 'a '(VONE a) '((VNEG a) x)))
;;; 1.39 (first assertion), the notes' form, commutative case: x self-adjoint, ||x|| <= 1 give 1 - x in A^2_sa
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a)) (list 'IMPLIES (list '<= (gnp-n 'x) 1)
    (list 'IN gnp-1x '(SA-SQUARES a)))))))))
(dk-peel!)
(gnp-ccsa!)
(dk-cite! 'ccsa-sa-le-one 'a 'x)
(dk-iff-fwd! (dk-cite! 'ale-unfold 'a 'x '(VONE a)))
(gnp-sa-open! 'x)
(gnp-uvt 'a gnp-1x)
(dk-cite! 'ccsa-pos-cone-sa-squares 'a gnp-1x)
(let ((i (dk-pick (lambda (h) (and (dk-head-is? h 'IFF) (dk-contains? h 'SA-SQUARES))) "iff")))
  (if (dk-only! i (list 'IN gnp-1x '(POS-CONE a))) (prop)))
(gnp-qed! 'ccsa-one-minus-sa-square)

;;; the same, up in an ambient C*-algebra b through a commutative unital C*-subalgebra a containing x
(define gnp-1xb '((VADD b) (VONE b) ((VNEG b) x)))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(= ((VSTAR b) x) x)
    (list 'IMPLIES '(<= ((VNRM b) x) 1) (list 'IN gnp-1xb '(SA-SQUARES b))))))))))))
(dk-peel!)
(gnp-sub-setup!)
(dk-cite! 'bcp-sub-vstar 'a 'b 'x)
(dk-cite! 'bcp-sub-vnrm 'a 'b 'x)
(dk-have! '(IN x (SA-PART a))
  (lambda ()
    (subst (dk-cite! 'sa-part-unfold 'a))
    (in-sep! (lambda () (gnp-ass!))
      (lambda () (subst (list '= '((VSTAR a) x) '((VSTAR b) x))) (gnp-ass!)))))
(dk-have! '(<= ((VNRM a) x) 1) (lambda () (subst (list '= '((VNRM a) x) '((VNRM b) x))) (gnp-ass!)))
(dk-cite! 'ccsa-one-minus-sa-square 'a 'x)
(let ((w (gnp-sasq-open! 'a gnp-1x)))
  (gnp-sa-open-s! 'a w)
  (gnp-sub-vec! w) (gnp-sub-vec! 'x) (gnp-uvt 'a '(VONE a)) (gnp-uvt 'a '((VNEG a) x))
  (dk-cite! 'bcp-sub-vstar 'a 'b w)
  (dk-cite! 'bcp-sub-vmul 'a 'b w w)
  (dk-have! (list 'IN w '(SA-PART b))
    (lambda ()
      (subst (dk-cite! 'sa-part-unfold 'b))
      (in-sep! (lambda () (gnp-ass!))
        (lambda () (gnp-cite2! 'eq-sym (gnp-st 'a w) (gnp-st 'b w)) (subst (list '= (gnp-st 'b w) (gnp-st 'a w))) (gnp-ass!)))))
  (let* ((e0 (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) gnp-1x))) "1 - x = w w"))
         (e1 (dk-rewrite-h! e0 (gnp-m 'a w w) (gnp-m 'b w w)))
         (_v (dk-cite! 'bcp-sub-vadd 'a 'b '(VONE a) '((VNEG a) x)))
         (e2 (dk-rewrite-h! e1 gnp-1x '((VADD b) (VONE a) ((VNEG a) x))))
         (_n (dk-cite! 'bcp-sub-vneg 'a 'b 'x))
         (e3 (dk-rewrite-h! e2 '((VNEG a) x) '((VNEG b) x)))
         (_o (dk-cite! 'bcp-sub-one 'a 'b))
         (e4 (dk-rewrite-h! e3 '(VONE a) '(VONE b))))
    (gnp-uvt 'b gnp-1xb)
    (gnp-sasq-in! 'b gnp-1xb w)))
(gnp-qed! 'sub-one-minus-sa-square)

;;; ---- 1.40 transferred to b, for x in a commutative unital C*-subalgebra a of b (BA-1117-GN round 2) ----
(define (gnp-exs s x) (list (list 'VADD s) (list (list 'ACT s) (list (list 'VNRM s) x) (list 'VONE s)) (list (list 'VNEG s) x)))
(define (gnp-ntest s x) (list '<= (list (list 'VNRM s) (gnp-exs s x)) (list (list 'VNRM s) x)))
(define (gnp-a2b-eqs! x)               ; cite the subalgebra equations, outermost first, for the norm-test term at x
  (let ((n (list '(VNRM a) x)))
    (gnp-norm! x) (gnp-in-cc! n) (gnp-uvt 'a (gnp-exs 'a x))
    (let* ((e1 (dk-cite! 'bcp-sub-vnrm 'a 'b (gnp-exs 'a x)))
           (e2 (dk-cite! 'bcp-sub-vadd 'a 'b (list '(ACT a) n '(VONE a)) (list '(VNEG a) x)))
           (e3 (dk-cite! 'bcp-sub-act 'a 'b n '(VONE a)))
           (e4 (dk-cite! 'bcp-sub-vneg 'a 'b x))
           (e5 (begin (dk-cite! 'bcp-sub-one 'a 'b) '(= (VONE a) (VONE b))))
           (e6 (dk-cite! 'bcp-sub-vnrm 'a 'b x)))
      (list e1 e2 e3 e4 e5 e6))))
;; sufficiency: the norm test in b gives x >= 0 in b
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(= ((VSTAR b) x) x)
    (list 'IMPLIES (gnp-ntest 'b 'x) '(IN x (POS-CONE b))))))))))))
(dk-peel!)
(gnp-sub-setup!)
(dk-cite! 'bcp-sub-vstar 'a 'b 'x)
(dk-have! '(IN x (SA-PART a))
  (lambda ()
    (subst (dk-cite! 'sa-part-unfold 'a))
    (in-sep! (lambda () (gnp-ass!))
      (lambda () (subst (list '= '((VSTAR a) x) '((VSTAR b) x))) (gnp-ass!)))))
(let* ((eqs (gnp-a2b-eqs! 'x))
       (iff (dk-cite! 'ccsa-pos-norm-test 'a 'x)))
  (dk-have! (caddr iff) (lambda () (for-each (lambda (e) (if (gnp-open?) (subst e))) eqs) (gnp-ass!)))
  (dk-iff-bwd! iff)
  (dk-cite! 'sub-pos-cone 'a 'b 'x)
  (gnp-ass!))
(gnp-qed! 'sub-pos-norm-test-suff)
;; necessity: x >= 0 in a gives the norm test in b
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'x (list 'IMPLIES '(IN x (POS-CONE a)) (gnp-ntest 'b 'x)))))))))
(dk-peel!)
(gnp-sub-setup!)
(dk-cite! 'pos-cone-in-vec 'a 'x)
(dk-cite! 'pos-cone-self-adjoint 'a 'x)
(let* ((eqs (gnp-a2b-eqs! 'x))
       (iff (dk-cite! 'ccsa-pos-norm-test 'a 'x)))
  (dk-iff-fwd! iff)
  (let loop ((h (caddr iff)) (es eqs))
    (if (pair? es) (loop (dk-rewrite-h! h (cadr (car es)) (caddr (car es))) (cdr es))))
  (gnp-ass!))
(gnp-qed! 'sub-pos-norm-test-nec)
;; a square of a self-adjoint of a is one of b
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES gnp-sub
  '(FORALL x (IMPLIES (IN x (SA-SQUARES a)) (IN x (SA-SQUARES b)))))))))
(dk-peel!)
(gnp-sub-setup!)
(let ((w (gnp-sasq-open! 'a 'x)))
  (gnp-sa-open-s! 'a w)
  (gnp-sub-vec! w)
  (dk-cite! 'bcp-sub-vstar 'a 'b w)
  (dk-cite! 'bcp-sub-vmul 'a 'b w w)
  (dk-have! (list 'IN w '(SA-PART b))
    (lambda ()
      (subst (dk-cite! 'sa-part-unfold 'b))
      (in-sep! (lambda () (gnp-ass!))
        (lambda () (gnp-cite2! 'eq-sym (gnp-st 'a w) (gnp-st 'b w)) (subst (list '= (gnp-st 'b w) (gnp-st 'a w))) (gnp-ass!)))))
  (let ((e0 (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) 'x) (equal? (caddr h) (gnp-m 'a w w)))) "x = w w")))
    (dk-rewrite-h! e0 (gnp-m 'a w w) (gnp-m 'b w w))
    (gnp-sub-vec! 'x)
    (gnp-sasq-in! 'b 'x w)))
(gnp-qed! 'sub-sa-squares)
;; the norm test in b makes x a square of a self-adjoint of b
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(= ((VSTAR b) x) x)
    (list 'IMPLIES (gnp-ntest 'b 'x) '(IN x (SA-SQUARES b))))))))))))
(dk-peel!)
(gnp-sub-setup!)
(dk-cite! 'bcp-sub-vstar 'a 'b 'x)
(dk-have! '(IN x (SA-PART a))
  (lambda ()
    (subst (dk-cite! 'sa-part-unfold 'a))
    (in-sep! (lambda () (gnp-ass!))
      (lambda () (subst (list '= '((VSTAR a) x) '((VSTAR b) x))) (gnp-ass!)))))
(let* ((eqs (gnp-a2b-eqs! 'x))
       (iff (dk-cite! 'ccsa-pos-norm-test 'a 'x)))
  (dk-have! (caddr iff) (lambda () (for-each (lambda (e) (if (gnp-open?) (subst e))) eqs) (gnp-ass!)))
  (dk-iff-bwd! iff)
  (dk-iff-fwd! (dk-cite! 'ccsa-pos-cone-sa-squares 'a 'x))
  (dk-cite! 'sub-sa-squares 'a 'b 'x)
  (gnp-ass!))
(gnp-qed! 'sub-pos-norm-test-sq)
;; 1.39 (second assertion) transferred: y >= 0 in a, ||y|| <= 1 give ||1 - y|| <= 1 in b
(define gnp-1yb '((VADD b) (VONE b) ((VNEG b) y)))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES gnp-sub
  (list 'FORALL 'y (list 'IMPLIES '(IN y (POS-CONE a)) (list 'IMPLIES '(<= ((VNRM b) y) 1) (list '<= (list '(VNRM b) gnp-1yb) 1))))))))))
(dk-peel!)
(gnp-sub-setup!)
(dk-cite! 'pos-cone-in-vec 'a 'y)
(dk-cite! 'bcp-sub-vnrm 'a 'b 'y)
(dk-have! '(<= ((VNRM a) y) 1) (lambda () (subst (list '= '((VNRM a) y) '((VNRM b) y))) (gnp-ass!)))
(gnp-uvt 'a gnp-1y)
(let* ((h (dk-cite! 'ccsa-one-minus-pos-norm 'a 'y))
       (e1 (dk-cite! 'bcp-sub-vnrm 'a 'b gnp-1y))
       (e2 (dk-cite! 'bcp-sub-vadd 'a 'b '(VONE a) '((VNEG a) y)))
       (e3 (dk-cite! 'bcp-sub-vneg 'a 'b 'y))
       (e4 (begin (dk-cite! 'bcp-sub-one 'a 'b) '(= (VONE a) (VONE b))))
       (eqs (list e1 e2 e3 e4)))
  (let loop ((h h) (es eqs))
    (if (pair? es) (loop (dk-rewrite-h! h (cadr (car es)) (caddr (car es))) (cdr es))))
  (gnp-ass!))
(gnp-qed! 'sub-one-minus-pos-norm)
