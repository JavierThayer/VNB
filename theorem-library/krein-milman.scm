;;; km-p11.scm -- BA-KM part 11: the closed convex hull (closed, convex, contains, least); Krein-Milman.
(define (km-cch e) (list 'CLOSED-CONV-HULL 'm 't e))
(define (km-cch-cond z e)
  (list 'FORALL 'khc_ (list 'IMPLIES '(IN khc_ SET) (list 'IMPLIES '(IS-CONVEX-SUBSET m khc_) (list 'IMPLIES '(IS-TOP-CLOSED t khc_)
    (list 'IMPLIES (list 'SUBSET e 'khc_) (list 'IN z 'khc_)))))))
(define (km-cch-out! z e)              ; (IN z CCH(e)) in context: land (IN z (VEC m)) and the condition; return the condition
  (let* ((iff (dk-cite! 'closed-conv-hull-mem 'm 't e z)) (h (list 'IN z (km-cch e))) (cnd (caddr (caddr iff))))
    (km-by-prop! cnd iff h)
    (km-by-prop! (list 'IN z '(VEC m)) iff h)
    cnd))
(define (km-cch-in! z e prove-cond)    ; (IN z (VEC m)) in context; PROVE-COND proves the condition (focus on it)
  (let* ((iff (dk-cite! 'closed-conv-hull-mem 'm 't e z)) (cnd (caddr (caddr iff))))
    (if (not (dk-asm? cnd)) (dk-have! cnd prove-cond))
    (km-by-prop! (list 'IN z (km-cch e)) iff (list 'IN z '(VEC m)) cnd)))
(define (km-cch-set! e)                ; IS-MODULE m in context: (IN (CLOSED-CONV-HULL m t e) SET)
  (let ((g (list 'IN (km-cch e) 'SET)))
    (if (not (dk-asm? g))
        (begin
          (if (not (dk-asm? '(IN (VEC m) SET))) (dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m)))
          (dk-cite! 'closed-conv-hull-unfold 'm 't e)
          (dk-have! g (lambda () (subst (list '== (km-cch e) (subst-free 'e e km-CH-body))) (sep-set) (dk-ass!)))))
    g))
(define (km-cch-peel!)                 ; the condition's goal: peel; return the set c
  (let ((ld (dk-peel!)))
    (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'SET))) ld))))

;;; ---- the closed convex hull lies in every closed convex set containing e ----
(sp (make-wff (km-alls '(m t e c) (km-imps '((IS-MODULE m) (IN c SET) (IS-CONVEX-SUBSET m c) (IS-TOP-CLOSED t c) (SUBSET e c))
   (list 'SUBSET (km-cch 'e) 'c)))))
(dk-peel!)
(km-cch-set! 'e)
(km-subset! (km-cch 'e) 'c (lambda (z) (let ((cz (km-cch-out! z 'e))) (dk-apply! (dk-ctx-form cz) 'c) (dk-ass!))))
(km-qed! 'closed-conv-hull-least)

;;; ---- e lies in its closed convex hull ----
(sp (make-wff (km-alls '(m t e) (km-imps '((IS-MODULE m) (SUBSET e (VEC m))) (list 'SUBSET 'e (km-cch 'e))))))
(dk-peel!)
(km-cch-set! 'e)
(km-subset! 'e (km-cch 'e)
  (lambda (z)
    (dk-cite! 'subset-mem-fwd 'e '(VEC m) z)
    (km-cch-in! z 'e (lambda () (let ((c (km-cch-peel!))) (dk-cite! 'subset-mem-fwd 'e c z) (dk-ass!))))
    (dk-ass!)))
(km-qed! 'closed-conv-hull-contains)

;;; ---- the closed convex hull is convex ----
(sp (make-wff (km-alls '(m t e) (km-imps km-rmod (list 'IS-CONVEX-SUBSET 'm (km-cch 'e))))))
(dk-peel!)
(km-cch-set! 'e)
(let ((kmhull (km-cch 'e)))
  (mac 'is-convex-subset)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (km-sub-goal! (lambda (z) (dk-close-if! (lambda () (km-cch-out! z 'e)) dk-ass!))))
        (#t
         (let* ((ld (dk-peel!))
                (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) kmhull))) ld)))
                (z1 (car zs)) (z2 (cadr zs))
                (tt (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
                (c1 (km-cch-out! z1 'e)) (c2 (km-cch-out! z2 'e))
                (cmb (km-vadd (km-act (list '- 1 tt) z1) (km-act tt z2))))
           (km-vt! cmb)
           (km-cch-in! cmb 'e
             (lambda ()
               (let* ((c (km-cch-peel!))
                      (cvc (list-ref (km-parts! 'is-convex-subset (list 'm c) (list 'IS-CONVEX-SUBSET 'm c)) 1)))
                 (dk-apply! (dk-ctx-form c1) c)
                 (dk-apply! (dk-ctx-form c2) c)
                 (dk-apply! cvc z1 z2 tt)
                 (dk-ass!))))
           (dk-ass!)))))))
(km-qed! 'closed-conv-hull-convex)

;;; ---- the closed convex hull is closed ----
(sp (make-wff (km-alls '(m t e) (km-imps (list km-tvs) (list 'IS-TOP-CLOSED 't (km-cch 'e))))))
(dk-peel!)
(km-tvs-parts!)
(km-cch-set! 'e)
(let* ((kmhull (km-cch 'e))
       (cH (list 'COMPLEMENT-IN '(PTS t) kmhull)))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (km-sub-goal! (lambda (z) (km-cch-out! z 'e) (subst '(= (PTS t) (VEC m))) (dk-ass!))))
        (#t
         (dk-cite! 'complement-in-subset kmhull '(PTS t))
         (km-open-local! 't cH
           (lambda (x)
             (km-cout! x '(PTS t) kmhull)
             (dk-rewrite-h! (list 'IN x '(PTS t)) '(PTS t) '(VEC m))
             (let ((exc (list 'FORSOME 'knc_ (list 'AND '(IN knc_ SET) (list 'AND '(IS-CONVEX-SUBSET m knc_) (list 'AND '(IS-TOP-CLOSED t knc_)
                          (list 'AND '(SUBSET e knc_) (list 'NOT (list 'IN x 'knc_)))))))))
               (dk-have! exc
                 (lambda ()
                   (pbc)
                   (km-cch-in! x 'e
                     (lambda ()
                       (let ((c (km-cch-peel!)))
                         (pbc)
                         (dk-have! exc (lambda () (ew c) (dk-conj-close! dk-ass!)))
                         (ai (list 'NOT exc)))))
                   (ai (list 'NOT (list 'IN x kmhull)))))
               (let* ((c (dk-skolem! (dk-ctx-form exc) #t))
                      (cC (list 'COMPLEMENT-IN '(PTS t) c)))
                 (km-parts! 'is-top-closed (list 't c) (list 'IS-TOP-CLOSED 't c))
                 (km-cin! x '(PTS t) c)
                 (km-subset! cC cH
                   (lambda (z)
                     (km-cout! z '(PTS t) c)
                     (dk-have! (list 'NOT (list 'IN z kmhull))
                       (lambda () (di) (let ((cz (km-cch-out! z 'e))) (dk-apply! (dk-ctx-form cz) c) (ai (list 'NOT (list 'IN z c))))))
                     (km-cin! z '(PTS t) kmhull)))
                 (km-ew-close! cC))))))))))
(km-qed! 'closed-conv-hull-closed)

;;; ---- Cor 4.41: a nonempty compact convex set has an extreme point (in EXTREME-POINTS form) ----
(define km-kmhyps (list km-lctvs '(SUBSET ks (VEC m)) '(IS-CONVEX-SUBSET m ks) (list 'IS-COMPACT-T km-SUB)))
(define km-EP '(EXTREME-POINTS m ks))
(define (km-ep-in! z)                  ; (IS-EXTREME-POINT m ks z), ks subset VEC in context: (IN z EP)
  (dk-project! (list 'IN z 'ks) 'is-extreme-point (list 'IS-EXTREME-POINT 'm 'ks z))
  (dk-cite! 'subset-mem-fwd 'ks '(VEC m) z)
  (km-by-prop! (list 'IN z km-EP) (dk-cite! 'extreme-points-mem 'm 'ks z) (list 'IN z '(VEC m)) (list 'IS-EXTREME-POINT 'm 'ks z)))
(sp (make-wff (km-alls '(m t ks) (km-imps (append km-kmhyps '((FORSOME kz0_ (IN kz0_ ks)))) (list 'FORSOME 'kep_ (list 'IN 'kep_ km-EP))))))
(dk-peel!)
(let ((e (dk-skolem! (dk-cite! 'extreme-point-exists 'm 't 'ks))))
  (km-ep-in! e)
  (ew e)
  (dk-ass!))
(km-qed! 'extreme-points-nonempty)

;;; ---- Krein-Milman: a compact convex set is the closed convex hull of its extreme points ----
(sp (make-wff (km-alls '(m t ks) (km-imps km-kmhyps (list '= 'ks (km-cch km-EP))))))
(dk-peel!)
(dk-project! km-tvs 'is-locally-convex-tvs km-lctvs)
(km-tvs-parts!)
(km-pts-of! 'ks)
(dk-cite! 'compact-hausdorff-closed 't 'ks)
(dk-project! '(IN (PTS t) SET) 'is-top-space '(IS-TOP-SPACE t))
(dk-cite! 'subclass-of-set-is-set 'ks '(PTS t))
(let ((kmcc (km-cch km-EP)))
  (km-subset! km-EP 'ks
    (lambda (z) (km-by-prop! (list 'IS-EXTREME-POINT 'm 'ks z) (dk-cite! 'extreme-points-mem 'm 'ks z) (list 'IN z km-EP))
                (dk-project! (list 'IN z 'ks) 'is-extreme-point (list 'IS-EXTREME-POINT 'm 'ks z))))
  (km-subset! km-EP '(VEC m)
    (lambda (z) (km-by-prop! (list 'IN z '(VEC m)) (dk-cite! 'extreme-points-mem 'm 'ks z) (list 'IN z km-EP))))
  (dk-cite! 'closed-conv-hull-contains 'm 't km-EP)
  (dk-cite! 'closed-conv-hull-convex 'm 't km-EP)
  (dk-cite! 'closed-conv-hull-closed 'm 't km-EP)
  (dk-cite! 'closed-conv-hull-least 'm 't km-EP 'ks)
  (km-subset! 'ks kmcc
    (lambda (x0)
      (pbc)
      (dk-cite! 'subset-mem-fwd 'ks '(VEC m) x0)
      (dk-cite! 'subset-mem-fwd 'ks '(PTS t) x0)
      (dk-have! '(FORSOME kz0_ (IN kz0_ ks)) (lambda () (ew x0) (dk-ass!)))
      (let ((e1 (dk-skolem! (dk-cite! 'extreme-points-nonempty 'm 't 'ks))))
        (dk-cite! 'subset-mem-fwd km-EP kmcc e1)
        (dk-have! (list 'FORSOME 'kc0_ (list 'IN 'kc0_ kmcc)) (lambda () (ew e1) (dk-ass!))))
      (let* ((u (list 'COMPLEMENT-IN '(PTS t) kmcc)))
        (km-parts! 'is-top-closed (list 't kmcc) (list 'IS-TOP-CLOSED 't kmcc))
        (km-cin! x0 '(PTS t) kmcc)
        (dk-have! (km-disj u kmcc)
          (lambda ()
            (let ((z (dk-di-var!)))
              (dk-have! (list 'NOT (list 'IN z u))
                (lambda () (di) (km-cout! z '(PTS t) kmcc) (ai (list 'NOT (list 'IN z kmcc))))))))
        (let* ((sx (dk-cite! 'locally-convex-separation 'm 't u x0 kmcc))
               (G (dk-skolem! sx #t))
               (below (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h G) (dk-contains? h 'kgz_))) "below")))
          (dk-cite! 'extremal-subset-refl 'm 'ks)
          (let* ((fc (dk-cite! 'closed-face-above 'm 't 'ks 'ks G x0))
                 (M (dk-skolem! fc #t))
                 (above (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h M) (dk-contains? h 'kfz_))) "above"))
                 (pm (km-parts! 'is-extremal-subset (list 'm M 'ks) (list 'IS-EXTREMAL-SUBSET 'm M 'ks))))
            (dk-have! (list 'FORSOME 'kz0_ (list 'IN 'kz0_ M)) (lambda () (dk-ass!)))
            (dk-cite! 'subset-trans M 'ks '(VEC m))
            (dk-cite! 'closed-in-subspace 't 'ks M)
            (dk-cite! 'closed-subset-compact km-SUB M)
            (dk-cite! 'subspace-of-subspace 't 'ks M)
            (dk-rewrite-h! (list 'IS-COMPACT-T (list 'SUBSPACE-TOP km-SUB M)) (list 'SUBSPACE-TOP km-SUB M) (list 'SUBSPACE-TOP 't M))
            (let ((e (dk-skolem! (dk-cite! 'extreme-point-exists 'm 't M))))
              (dk-cite! 'extreme-point-of-extremal-subset 'm M 'ks e)
              (dk-project! (list 'IN e M) 'is-extreme-point (list 'IS-EXTREME-POINT 'm M e))
              (km-ep-in! e)
              (dk-cite! 'subset-mem-fwd km-EP kmcc e)
              (dk-apply! below e)
              (dk-apply! above e)
              (km-lin-type! G e) (km-lin-type! G x0)
              (dk-absurd! (list 'IN (list G e) 'RR) (list 'IN (list G x0) 'RR)
                          (list '< (list G e) (list G x0)) (list '<= (list G x0) (list G e))))))))))
(km-set-eq! 'ks (km-cch km-EP))
(dk-ass!)
(km-qed! 'krein-milman)

;;; ======================================================================
;;; km-p12.scm -- BA-KM part 12: a separating family of seminorms over R defines a locally convex space.
(define km-snfam '(IS-SEMINORM-FAMILY-ON RR-NORMED-FIELD m ix pf))
(define (km-vneg x) (list '(VNEG m) x))
(define (km-vsub a b) (km-vadd a (km-vneg b)))
(define (km-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) km-ring)) (mac 'rr-scalar-ring-carr) (dk-ass!))))
    ty))

;;; ---- ((1-t) y1 + t y2) - x = (1-t)(y1 - x) + t(y2 - x) ----
(sp (make-wff (km-alls '(m t y1 y2 x) (km-imps (append km-rmod '((IN t RR) (IN y1 (VEC m)) (IN y2 (VEC m)) (IN x (VEC m))))
   (list '= (km-vsub (km-vadd (km-act '(- 1 t) 'y1) (km-act 't 'y2)) 'x)
            (km-vadd (km-act '(- 1 t) (km-vsub 'y1 'x)) (km-act 't (km-vsub 'y2 'x))))))))
(dk-peel!)
(km-real! km-m1) (km-real! '(- 1 t))
(subst (dk-cite! 'rmod-vneg-act 'm 'x))
(let* ((u '(- 1 t))
       (ux (km-act u 'x)) (tx (km-act 't 'x))
       (e (dk-cite! 'rmod-combination-sub 'm u 't 'y1 'y2 'x 'x)))
  (km-vt! ux) (km-vt! tx)
  (dk-have! (list '= (km-vadd ux tx) 'x)
    (lambda ()
      (km-subst-rev! (dk-cite! 'rmod-act-add 'm u 't 'x))
      (subst (km-eq! (list '+ u 't) 1))
      (km-real! 1)
      (subst (dk-cite! 'rmod-act-one 'm 'x))
      (rfl)))
  (let ((e2 (dk-rewrite-h! e (km-vadd ux tx) 'x)))
    (subst e2)
    (km-vt! (caddr e2))
    (rfl)))
(km-qed! 'rmod-combination-sub-point)

;;; ---- an open seminorm ball is convex ----
(sp (make-wff (km-alls '(m ix pf ff x r) (km-imps (list km-snfam '(SUBSET ff ix) '(IN x (VEC m)) '(IN r RR))
   '(IS-CONVEX-SUBSET m (SN-OBALL m pf ff x r))))))
(dk-peel!)
(dk-project! '(IS-MODULE m) 'is-seminorm-family-on km-snfam)
(dk-project! (list '= '(SCAL m) km-ring) 'is-seminorm-family-on km-snfam)
(dk-project! '(IN pf (FUN ix (FUN (VEC m) RR))) 'is-seminorm-family-on km-snfam)
(let* ((V '(SN-OBALL m pf ff x r))
       (sncl (dk-project! '(FORALL sni_ (IMPLIES (IN sni_ ix) (IS-SEMINORM RR-NORMED-FIELD m (pf sni_)))) 'is-seminorm-family-on km-snfam))
       (mem (lambda (y) (dk-cite! 'sn-oball-membership 'm 'pf 'ff 'x 'r y))))
  (mac 'is-convex-subset)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (km-sub-goal! (lambda (z) (dk-close-if! (lambda () (km-by-prop! (list 'IN z '(VEC m)) (mem z) (list 'IN z V))) dk-ass!))))
        (#t
         (let* ((ld (dk-peel!))
                (ys (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) V))) ld)))
                (y1 (car ys)) (y2 (cadr ys))
                (tt (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
                (u (list '- 1 tt))
                (m1 (mem y1)) (m2 (mem y2))
                (ex1 (caddr (caddr m1))) (ex2 (caddr (caddr m2))))
           (km-by-prop! (list 'IN y1 '(VEC m)) m1 (list 'IN y1 V))
           (km-by-prop! (list 'IN y2 '(VEC m)) m2 (list 'IN y2 V))
           (km-by-prop! ex1 m1 (list 'IN y1 V))
           (km-by-prop! ex2 m2 (list 'IN y2 V))
           (let* ((e1 (dk-skolem! (dk-ctx-form ex1) #t))
                  (b1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h e1))) "margin 1"))
                  (e2 (dk-skolem! (dk-ctx-form ex2) #t))
                  (b2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h e2))) "margin 2"))
                  (cmb (km-vadd (km-act u y1) (km-act tt y2)))
                  (P (list '* u e1)) (Q (list '* tt e2))
                  (e (list '+ P Q))
                  (d1 (km-vsub y1 'x)) (d2 (km-vsub y2 'x)))
             (dk-cite! 'rr-pos-rr-in-rr e1) (dk-cite! 'rr-pos-rr-in-rr e2)
             (dk-cite! 'rr-lt-of-pos-rr e1) (dk-cite! 'rr-lt-of-pos-rr e2)
             (dk-have! (list '<= 0 e1) (lambda () (dk-ineq! (list 'IN e1 'RR) (list '< 0 e1))))
             (dk-have! (list '<= 0 e2) (lambda () (dk-ineq! (list 'IN e2 'RR) (list '< 0 e2))))
             (km-real! u) (km-real! P) (km-real! Q) (km-real! e)
             (dk-have! (list '<= 0 u) (lambda () (dk-ineq! (list 'IN tt 'RR) (list '<= tt 1))))
             (fact 'rr-zero-in)
             ;; 0 < e
             (dk-have! (list '< 0 e)
               (lambda ()
                 (use-em (list '<= tt 0)
                   (lambda ()
                     (dk-have! (list '< 0 u) (lambda () (dk-ineq! (list 'IN tt 'RR) (list '<= tt 0))))
                     (dk-cite! 'rr-mul-pos u e1)
                     (dk-cite! 'rr-mul-le-right 0 tt e2)
                     (dk-have! (list '= (list '* 0 e2) 0) (lambda () (crs)))
                     (let* ((nP (dk-name! P)) (nQ (dk-name! Q))
                            (l1 (dk-rewrite-h! (list '< 0 P) P nP))
                            (l2 (dk-rewrite-h! (dk-rewrite-h! (list '<= (list '* 0 e2) Q) (list '* 0 e2) 0) Q nQ)))
                       (subst (list '= P nP)) (subst (list '= Q nQ))
                       (dk-ineq! (list 'IN nP 'RR) (list 'IN nQ 'RR) l1 l2)))
                   (lambda ()
                     (dk-cite! 'rr-not-le-lt tt 0)
                     (dk-cite! 'rr-mul-pos tt e2)
                     (dk-cite! 'rr-mul-le-right 0 u e1)
                     (dk-have! (list '= (list '* 0 e1) 0) (lambda () (crs)))
                     (let* ((nP (dk-name! P)) (nQ (dk-name! Q))
                            (l1 (dk-rewrite-h! (list '< 0 Q) Q nQ))
                            (l2 (dk-rewrite-h! (dk-rewrite-h! (list '<= (list '* 0 e1) P) (list '* 0 e1) 0) P nP)))
                       (subst (list '= P nP)) (subst (list '= Q nQ))
                       (dk-ineq! (list 'IN nP 'RR) (list 'IN nQ 'RR) l1 l2))))))
             (dk-cite! 'rr-pos-rr-of-lt e)
             (km-vt! cmb)
             (km-vt! d1) (km-vt! d2)
             (dk-cite! 'rmod-combination-sub-point 'm tt y1 y2 'x)
             ;; the margin e works at every index
             (let ((bnd (list 'FORALL 'sni_ (list 'IMPLIES '(IN sni_ ff)
                          (list '<= (list '+ (list '(pf sni_) (km-vsub cmb 'x)) e) 'r)))))
               (dk-have! bnd
                 (lambda ()
                   (let* ((i (dk-di-var!))
                          (pfi (list 'pf i))
                          (sp1 (begin (dk-cite! 'subset-mem-fwd 'ff 'ix i) (dk-apply! sncl i)))
                          (ps (km-parts! 'is-seminorm (list 'RR-NORMED-FIELD 'm pfi) (list 'IS-SEMINORM 'RR-NORMED-FIELD 'm pfi)))
                          (tri (list-ref ps 5)) (hom (list-ref ps 6))
                          (ud1 (km-act u d1)) (td2 (km-act tt d2)))
                     (dk-apply! b1 i) (dk-apply! b2 i)
                     (km-vt! ud1) (km-vt! td2)
                     (dk-cite! 'fun-apply-type-c pfi '(VEC m) 'RR d1)
                     (dk-cite! 'fun-apply-type-c pfi '(VEC m) 'RR d2)
                     (dk-cite! 'fun-apply-type-c pfi '(VEC m) 'RR ud1)
                     (dk-cite! 'fun-apply-type-c pfi '(VEC m) 'RR td2)
                     (km-vt! (km-vadd ud1 td2))
                     (dk-cite! 'fun-apply-type-c pfi '(VEC m) 'RR (km-vadd ud1 td2))
                     (dk-apply! tri ud1 td2)
                     (km-carr! u) (km-carr! tt)
                     (dk-apply! hom u d1) (dk-apply! hom tt d2)
                     (dk-cite! 'rr-nf-fnrm-apply u) (dk-cite! 'rr-nf-fnrm-apply tt)
                     (dk-have! (list '<= 0 tt) (lambda () (dk-ass!)))
                     (dk-cite! 'rr-abs-of-nonneg u) (dk-cite! 'rr-abs-of-nonneg tt)
                     (let* ((pd1 (list pfi d1)) (pd2 (list pfi d2))
                            (h1 (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (list '= (list pfi ud1) (list '* (list '(FNRM RR-NORMED-FIELD) u) pd1)))
                                                              (list '(FNRM RR-NORMED-FIELD) u) (list 'abs u)) (list 'abs u) u))
                            (h2 (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (list '= (list pfi td2) (list '* (list '(FNRM RR-NORMED-FIELD) tt) pd2)))
                                                              (list '(FNRM RR-NORMED-FIELD) tt) (list 'abs tt)) (list 'abs tt) tt))
                            (A (list '* u pd1)) (B (list '* tt pd2)))
                       ;; u (p(d1) + e1) <= u r and t (p(d2) + e2) <= t r
                       (km-real! (list '+ pd1 e1)) (km-real! (list '+ pd2 e2))
                       (dk-cite! 'rr-mul-le-right (list '+ pd1 e1) 'r u)
                       (dk-cite! 'rr-mul-le-right (list '+ pd2 e2) 'r tt)
                       (km-real! A) (km-real! B) (km-real! (list '* 'r u)) (km-real! (list '* 'r tt))
                       (km-real! (list '* (list '+ pd1 e1) u)) (km-real! (list '* (list '+ pd2 e2) tt))
                       (dk-have! (list '= (list '* (list '+ pd1 e1) u) (list '+ A P)) (lambda () (crs)))
                       (dk-have! (list '= (list '* (list '+ pd2 e2) tt) (list '+ B Q)) (lambda () (crs)))
                       (dk-have! (list '= (list '+ (list '* 'r u) (list '* 'r tt)) 'r) (lambda () (crs)))
                       (let* ((nA (dk-name! A)) (nB (dk-name! B)) (nP (dk-name! P)) (nQ (dk-name! Q))
                              (nR1 (dk-name! (list '* 'r u))) (nR2 (dk-name! (list '* 'r tt)))
                              (nX (dk-name! (list '* (list '+ pd1 e1) u))) (nY (dk-name! (list '* (list '+ pd2 e2) tt)))
                              (rw (lambda (f . pairs) (let loop ((f f) (ps pairs)) (if (null? ps) f (loop (dk-rewrite-h! f (caar ps) (cdar ps)) (cdr ps))))))
                              (i1 (rw (list '<= (list '* (list '+ pd1 e1) u) (list '* 'r u)) (cons (list '* (list '+ pd1 e1) u) nX) (cons (list '* 'r u) nR1)))
                              (i2 (rw (list '<= (list '* (list '+ pd2 e2) tt) (list '* 'r tt)) (cons (list '* (list '+ pd2 e2) tt) nY) (cons (list '* 'r tt) nR2)))
                              (q1 (rw (list '= (list '* (list '+ pd1 e1) u) (list '+ A P)) (cons (list '* (list '+ pd1 e1) u) nX) (cons A nA) (cons P nP)))
                              (q2 (rw (list '= (list '* (list '+ pd2 e2) tt) (list '+ B Q)) (cons (list '* (list '+ pd2 e2) tt) nY) (cons B nB) (cons Q nQ)))
                              (q3 (rw (list '= (list '+ (list '* 'r u) (list '* 'r tt)) 'r) (cons (list '* 'r u) nR1) (cons (list '* 'r tt) nR2)))
                              (h1n (rw h1 (cons A nA)))
                              (h2n (rw h2 (cons B nB)))
                              (tr (rw (list '<= (list pfi (km-vadd ud1 td2)) (list '+ (list pfi ud1) (list pfi td2)))))
                              (veq (list '= (km-vsub cmb 'x) (km-vadd ud1 td2))))
                         (subst veq)
                         (subst (list '= P nP)) (subst (list '= Q nQ))
                         (dk-ineq! (list 'IN (list pfi (km-vadd ud1 td2)) 'RR) (list 'IN (list pfi ud1) 'RR) (list 'IN (list pfi td2) 'RR)
                                   (list 'IN nA 'RR) (list 'IN nB 'RR) (list 'IN nP 'RR) (list 'IN nQ 'RR)
                                   (list 'IN nR1 'RR) (list 'IN nR2 'RR) (list 'IN nX 'RR) (list 'IN nY 'RR) '(IN r RR)
                                   tr h1n h2n i1 i2 q1 q2 q3)))))))
               (let* ((mc (mem cmb)) (exc (caddr (caddr mc))))
                 (dk-have! exc (lambda () (ew e) (dk-conj-close! dk-ass!)))
                 (km-by-prop! (list 'IN cmb V) mc (list 'IN cmb '(VEC m)) exc)))))))))
(km-qed! 'sn-oball-convex)

;;; ---- the topology of a separating family of seminorms over R is locally convex ----
(sp (make-wff (km-alls '(m ix pf) (km-imps (list km-snfam) '(IS-LOCALLY-CONVEX-TVS m (SEMINORM-TOP m ix pf))))))
(dk-peel!)
(dk-cite! 'seminorm-top-is-tvs 'RR-NORMED-FIELD 'm 'ix 'pf)
(mac 'is-locally-convex-tvs)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((ld (dk-peel!))
               (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC m)))) ld)))
               (u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'OPENS))) ld)))
               (bs (dk-cite! 'sntop-open-basic 'RR-NORMED-FIELD 'm 'ix 'pf u x))
               (F (dk-skolem! bs #t))
               (eps (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'sne_))) "the radius") #t))
               (V (list 'SN-OBALL 'm 'pf F x eps))
               (B (list 'SN-BALL 'm 'pf F x eps)))
          (dk-cite! 'rr-pos-rr-in-rr eps)
          (dk-cite! 'sntop-oball-open 'RR-NORMED-FIELD 'm 'ix 'pf F x eps)
          (dk-cite! 'sn-oball-center 'RR-NORMED-FIELD 'm 'ix 'pf F x eps)
          (dk-cite! 'sn-oball-in-ball 'RR-NORMED-FIELD 'm 'ix 'pf F x eps)
          (dk-cite! 'subset-trans V B u)
          (dk-cite! 'sn-oball-convex 'm 'ix 'pf F x eps)
          (ew V)
          (dk-conj-close! dk-ass!)))))
(km-qed! 'seminorm-top-locally-convex)
