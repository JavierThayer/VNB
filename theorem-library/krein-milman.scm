;;; km-p3.scm -- BA-KM part 3: union of two opens; a compact subspace covered by an upward-directed family of
;;; opens lies inside ONE member of the family.
;;; detach an implication chain R: an antecedent already in context is detached, the others proved by THUNKS in order
(define (km-chain! r . thunks)
  (let loop ((r r) (th thunks))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (let ((th2 (if (dk-asm? (cadr r)) th (begin (dk-have! (cadr r) (car th)) (cdr th)))))
          (if (not (dk-asm? (caddr r))) (detach! r))
          (loop (caddr r) th2))
        r)))
(define (km-union-in! z A B left?)
  (let ((iff (dk-cite! 'union-membership A B z)))
    (dk-have! (caddr iff) (lambda () (if left? (oi-l) (oi-r)) (dk-ass!)))
    (dk-meta-iff-l! iff)))

;;; ---- the union of two opens is open ----
(sp (make-wff (km-alls '(t u v) (km-imps '((IS-TOP-SPACE t) (IN u (OPENS t)) (IN v (OPENS t))) '(IN (UNION u v) (OPENS t))))))
(dk-peel!)
(let ((uv '(UNION u v)))
  (dk-cite! 'top-open-subset 't 'u)
  (dk-cite! 'top-open-subset 't 'v)
  (km-subset! uv '(PTS t)
    (lambda (z)
      (let ((iff (dk-cite! 'union-membership 'u 'v z)))
        (dk-meta-iff-r! iff)
        (use-em (list 'IN z 'u)
          (lambda () (dk-cite! 'subset-mem-fwd 'u '(PTS t) z) (dk-ass!))
          (lambda () (km-by-prop! (list 'IN z 'v) (list 'OR (list 'IN z 'u) (list 'IN z 'v)) (list 'NOT (list 'IN z 'u)))
                     (dk-cite! 'subset-mem-fwd 'v '(PTS t) z) (dk-ass!))))))
  (km-open-local! 't uv
    (lambda (x)
      (let ((iff (dk-cite! 'union-membership 'u 'v x)))
        (dk-meta-iff-r! iff)
        (use-em (list 'IN x 'u)
          (lambda ()
            (km-subset! 'u uv (lambda (z) (km-union-in! z 'u 'v #t) (dk-ass!)))
            (km-ew-close! 'u))
          (lambda ()
            (km-by-prop! (list 'IN x 'v) (list 'OR (list 'IN x 'u) (list 'IN x 'v)) (list 'NOT (list 'IN x 'u)))
            (km-subset! 'v uv (lambda (z) (km-union-in! z 'u 'v #f) (dk-ass!)))
            (km-ew-close! 'v)))))))
(km-qed! 'top-union-open)

;;; ---- a directed open cover of a compact subspace has a member containing it ----
(define km-SUB '(SUBSPACE-TOP t ks))
(define km-CV '(SEP kcw_ (POWER ks) (FORSOME kcu_ (AND (IN kcu_ dd) (= kcw_ (INTERSECTION kcu_ ks))))))
(define km-OPS '(SEP stw_ (POWER ks) (FORSOME stu_ (AND (IN stu_ (OPENS t)) (= stw_ (INTERSECTION stu_ ks))))))
(define (km-good fs u) (list 'FORALL 'kfw_ (list 'IMPLIES (list 'IN 'kfw_ fs) (list 'SUBSET 'kfw_ u))))
(define km-FC (list 'SEP 'kfz_ 'SET (list 'IMPLIES (list 'SUBSET 'kfz_ km-CV)
                 (list 'FORSOME 'kfu_ (list 'AND '(IN kfu_ dd) (km-good 'kfz_ 'kfu_))))))
(define km-dir '(FORALL kda_ (IMPLIES (IN kda_ dd) (FORALL kdb_ (IMPLIES (IN kdb_ dd)
                  (FORSOME kdc_ (AND (IN kdc_ dd) (AND (SUBSET kda_ kdc_) (SUBSET kdb_ kdc_)))))))))
(define km-dcov '(FORALL kdx_ (IMPLIES (IN kdx_ ks) (FORSOME kdu_ (AND (IN kdu_ dd) (IN kdx_ kdu_))))))
(define km-dopen '(FORALL kdu_ (IMPLIES (IN kdu_ dd) (IN kdu_ (OPENS t)))))
;;; (IN w CV) in context: skolemise its member of dd; return it (lands (IN u dd), (= w (INTERSECTION u ks)))
(define (km-cv-open! w)
  (let ((ex (km-sep-out! w km-CV)))
    (dk-skolem! (dk-ctx-form ex))))
;;; w = (INTERSECTION u ks) as a member of CV (u in dd in context)
(define (km-cv-in! u)
  (let ((w (list 'INTERSECTION u 'ks)))
    (km-subset! w 'ks (lambda (z) (km-iout! z u 'ks) (dk-ass!)))
    (dk-cite! 'subclass-of-set-is-set w 'ks)
    (dk-have! (list 'FORALL 'pz_ (list 'IMPLIES (list 'IN 'pz_ w) '(IN pz_ ks)))
      (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd w 'ks z) (dk-ass!))))
    (dk-cite! 'power-mem-intro 'ks w)
    (km-sep-in! w km-CV (lambda () (ew u) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
    w))

(sp (make-wff (km-alls '(t ks dd) (km-imps (list '(IS-TOP-SPACE t) '(SUBSET ks (PTS t)) (list 'IS-COMPACT-T km-SUB)
   km-dopen '(FORSOME kdu_ (IN kdu_ dd)) km-dir km-dcov)
   '(FORSOME kdu_ (AND (IN kdu_ dd) (SUBSET ks kdu_)))))))
(dk-peel!)
(dk-project! '(IN (PTS t) SET) 'is-top-space '(IS-TOP-SPACE t))
(dk-cite! 'subclass-of-set-is-set 'ks '(PTS t))
(dk-cite! 'power-set 'ks)
(dk-cite! 'subspace-top-pts 't 'ks)
(dk-cite! 'subspace-top-opens 't 'ks)
(define km-BU (list 'BIG-UNION 'U km-CV 'U))
(let* ((pc (km-parts! 'is-compact-t (list km-SUB) (list 'IS-COMPACT-T km-SUB)))
       (cl (list-ref pc 1))
       (dopen (dk-ctx-form km-dopen))
       (dcov (dk-ctx-form km-dcov))
       (dir (dk-ctx-form km-dir))
       (r (inst*! cl km-CV)))
  ;; the members of the cover are open in the subspace; they cover it
  (dk-have! (cadr r)
    (lambda ()
      (let* ((w (dk-di-var!)) (u (km-cv-open! w)))
        (dk-apply! dopen u)

        (subst (list '= (list 'OPENS km-SUB) km-OPS))
        (km-sep-out! w km-CV)
        (km-sep-in! w km-OPS (lambda () (ew u) (dk-conj-close! dk-ass!))))))
  (dk-have! (list 'FORALL 'kmx_ (list 'IFF (list 'IN 'kmx_ km-BU) '(IN kmx_ ks)))
    (lambda ()
      (let ((x (begin (dk-peel!) (cadr (cadr (dk-goal))))))
        (dk-iff! (lambda (g0) (equal? (caddr g0) 'ks))
          (lambda ()
            (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x km-BU)))))
                   (um (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) km-CV))) landed)))
                   (w (cadr um)))
              (km-sep-out! w km-CV)
              (dk-cite! 'power-mem-in 'ks w x)
              (dk-ass!)))
          (lambda ()
            (let* ((u (dk-skolem! (dk-apply! dcov x)))
                   (w (km-cv-in! u)))
              (km-iin! x u 'ks)
              (dk-each-leaf! (lambda () (bu-mi w)) (lambda () (dk-ass!)))))))))
  (dk-cite! 'class-extensionality km-BU 'ks)
  (dk-have! (cadr (caddr r)) (lambda () (subst (list '= (list 'PTS km-SUB) 'ks)) (subst (list '= km-BU 'ks)) (qrfl)))
  (km-chain! r))
;; the finite subfamily F
(define km-F (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'CARD))) "the finite subcover")))
(define km-ind
  (let ((ind0 (lookup-theorem 'finite-set-induction)))
    (subst-free (quantifier-var ind0) km-FC (quantifier-body ind0))))
(define km-hbase (cadr (cadr km-ind)))
(define km-hstep (caddr (cadr km-ind)))
(dk-have! km-hbase
  (lambda ()
    (in-sep! (lambda () (fact 'empty-set-is-set) (dk-ass!))
             (lambda ()
               (di)
               (let ((d0 (dk-skolem! (dk-ctx-form '(FORSOME kdu_ (IN kdu_ dd))))))
                 (ew d0)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) 'FORALL)
                         (let ((u (dk-di-var!))) (ai (dk-cite! 'empty-set-has-no-members u)))
                         (dk-ass!)))))))))
(dk-have! km-hstep
  (lambda ()
    (dk-split-all! (filter (lambda (f) (dk-head-is? f 'AND)) (dk-peel!)))
    (let* ((gl (dk-goal)) (u (cadr gl)) (s0 (cadr u)) (pxx (caddr u)) (x0 (cadr pxx))
           (ih (begin (dk-landed (lambda () (sep-me (list 'IN s0 km-FC))))
                      (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list 'SUBSET s0 km-CV))))
                               "the class property of the smaller family"))))
      (in-sep!
        (lambda ()
          (dk-meta-and! (list 'IN x0 'SET) (list 'IN x0 'SET))
          (dk-cite! 'pairing x0 x0)
          (dk-meta-and! (list 'IN s0 'SET) (list 'IN pxx 'SET))
          (dk-cite! 'union-set-closure s0 pxx)
          (dk-ass!))
        (lambda ()
          (di)
          (dk-cite! 'pair-self-member x0)
          (km-union-in! x0 s0 pxx #f)
          (km-subset! s0 km-CV
            (lambda (z) (km-union-in! z s0 pxx #t) (dk-cite! 'subset-mem-fwd u km-CV z) (dk-ass!)))
          (detach! ih)
          (let* ((u0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h s0))) "the bound of the smaller family")))
                 (gm (dk-ctx-form (km-good s0 u0))))
            (dk-cite! 'subset-mem-fwd u km-CV x0)
            (let* ((u1 (km-cv-open! x0))
                   (w0 (dk-skolem! (dk-apply! (dk-ctx-form km-dir) u0 u1))))
              (ew w0)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let ((w (dk-di-var!)))
                        (dk-meta-iff-r! (dk-cite! 'union-membership s0 pxx w))
                        (use-em (list 'IN w s0)
                          (lambda () (dk-apply! gm w) (dk-cite! 'subset-trans w u0 w0) (dk-ass!))
                          (lambda ()
                            (km-by-prop! (list 'IN w pxx) (list 'OR (list 'IN w s0) (list 'IN w pxx)) (list 'NOT (list 'IN w s0)))
                            (dk-cite! 'pair-self-eq x0 w)
                            (subst (list '= w x0))
                            (subst (list '= x0 (list 'INTERSECTION u1 'ks)))
                            (km-subset! (list 'INTERSECTION u1 'ks) w0
                              (lambda (z) (km-iout! z u1 'ks) (dk-cite! 'subset-mem-fwd u1 w0 z) (dk-ass!))))))
                      (dk-ass!)))))))))))
(dk-meta-and! km-hbase km-hstep)
(dk-cite! 'finite-set-induction km-FC)
(km-subset! km-CV '(POWER ks) (lambda (z) (km-sep-dom! z km-CV)))
(dk-cite! 'subset-trans km-F km-CV '(POWER ks))
(dk-cite! 'subclass-of-set-is-set km-F '(POWER ks))
(dk-meta-and! (list 'IN km-F 'SET) (list 'IN (list 'CARD km-F) 'NN))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h km-FC) (not (dk-contains? h 'EMPTY-SET)))) "the induction conclusion") km-F)
(km-sep-out! km-F km-FC)
(detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) (list 'SUBSET km-F km-CV)))) "the property of F"))
(define km-u (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h km-F) (dk-contains? h 'kfw_))) "the member for F")))
(ew km-u)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (mac 'subset-def)
          (let* ((z (dk-di-var!)) (fb (list 'BIG-UNION 'U km-F 'U)))
            (dk-have! (list 'IN z fb) (lambda () (subst (list '= fb (list 'PTS km-SUB))) (subst (list '= (list 'PTS km-SUB) 'ks)) (dk-ass!)))
            (let* ((landed (dk-landed (lambda () (bu-me (list 'IN z fb)))))
                   (um (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) km-F))) landed)))
                   (w (cadr um)))
              (dk-apply! (dk-ctx-form (km-good km-F km-u)) w)
              (dk-cite! 'subset-mem-fwd w km-u z)
              (dk-ass!)))))))
(km-qed! 'compact-directed-cover)

;;; ======================================================================
;;; km-p4.scm -- BA-KM part 4: a compact subset of a Hausdorff space is closed; a nonempty chain of nonempty closed
;;; subsets of a compact subspace has a common point.
(define (km-dd f dd) (subst-free 'dd dd f))
(define (km-open-dir! t ks dd prove-open prove-ne prove-dir prove-cov)
  ;; cite compact-directed-cover at dd after proving its four family hypotheses; return the member u with ks subset u
  (dk-have! (km-dd km-dopen dd) prove-open)
  (dk-have! (km-dd '(FORSOME kdu_ (IN kdu_ dd)) dd) prove-ne)
  (dk-have! (km-dd km-dir dd) prove-dir)
  (dk-have! (km-dd km-dcov dd) prove-cov)
  (dk-skolem! (dk-cite! 'compact-directed-cover t ks dd)))
(define (km-not-in-empty! z)            ; (IN z EMPTY-SET) in context, goal FALSITY
  (ai (dk-cite! 'empty-set-has-no-members z)))

;;; ---- a compact subset of a Hausdorff space is closed ----
(sp (make-wff (km-alls '(t ks) (km-imps (list '(IS-HAUSDORFF t) '(SUBSET ks (PTS t)) (list 'IS-COMPACT-T km-SUB))
   '(IS-TOP-CLOSED t ks)))))
(dk-peel!)
(let* ((ph (km-parts! 'is-hausdorff '(t) '(IS-HAUSDORFF t)))
       (hcl (list-ref ph 1))
       (pt (km-parts! 'is-top-space '(t) '(IS-TOP-SPACE t)))
       (icl (list-ref pt 5))
       (ck '(COMPLEMENT-IN (PTS t) ks)))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (dk-cite! 'complement-in-subset 'ks '(PTS t))
            (km-open-local! 't ck
              (lambda (x)
                (km-cout! x '(PTS t) 'ks)
                (let* ((disj (lambda (w v) (list 'FORALL 'kdz_ (list 'IMPLIES (list 'IN 'kdz_ w) (list 'NOT (list 'IN 'kdz_ v))))))
                       (dd (list 'SEP 'kdw_ '(OPENS t)
                             (list 'FORSOME 'kdv_ (list 'AND '(IN kdv_ (OPENS t)) (list 'AND (list 'IN x 'kdv_) (disj 'kdw_ 'kdv_))))))
                       (cnd (lambda (w) (subst-free 'kdw_ w (cadddr dd))))
                       (u (km-open-dir! 't 'ks dd
                            (lambda () (let ((w (dk-di-var!))) (km-sep-dom! w dd)))
                            (lambda ()
                              (ew 'EMPTY-SET)
                              (km-sep-in! 'EMPTY-SET dd
                                (lambda ()
                                  (ew '(PTS t))
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (not (dk-ass!))
                                          (let ((z (dk-di-var!))) (di) (km-not-in-empty! z))))))))
                            (lambda ()
                              (let* ((ld (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) dd))) (dk-peel!)))
                                     (u1 (cadr (car ld))) (u2 (cadr (cadr ld)))
                                     (v1 (dk-skolem! (dk-ctx-form (km-sep-out! u1 dd))))
                                     (v2 (dk-skolem! (dk-ctx-form (km-sep-out! u2 dd))))
                                     (w (list 'UNION u1 u2)) (v (list 'INTERSECTION v1 v2)))
                                (dk-cite! 'top-union-open 't u1 u2)
                                (dk-apply! icl v1 v2)
                                (km-iin! x v1 v2)
                                (ew w)
                                (dk-conj-close!
                                  (lambda ()
                                    (cond ((dk-ass!) #t)
                                          ((dk-head-is? (dk-goal) 'IN)
                                           (km-sep-in! w dd
                                             (lambda ()
                                               (ew v)
                                               (dk-conj-close!
                                                 (lambda ()
                                                   (if (not (dk-ass!))
                                                       (let ((z (dk-di-var!)))
                                                         (dk-meta-iff-r! (dk-cite! 'union-membership u1 u2 z))
                                                         (use-em (list 'IN z u1)
                                                           (lambda () (dk-apply! (dk-ctx-form (disj u1 v1)) z) (km-inot! z v1 v2 v1))
                                                           (lambda ()
                                                             (km-by-prop! (list 'IN z u2) (list 'OR (list 'IN z u1) (list 'IN z u2)) (list 'NOT (list 'IN z u1)))
                                                             (dk-apply! (dk-ctx-form (disj u2 v2)) z) (km-inot! z v1 v2 v2))))))))))
                                          ((equal? (dk-goal) (list 'SUBSET u1 w))
                                           (km-subset! u1 w (lambda (z) (km-union-in! z u1 u2 #t) (dk-ass!))))
                                          (#t (km-subset! u2 w (lambda (z) (km-union-in! z u1 u2 #f) (dk-ass!)))))))))
                            (lambda ()
                              (let ((y (dk-di-var!)))
                                (dk-cite! 'subset-mem-fwd 'ks '(PTS t) y)
                                (dk-have! (list 'NOT (list '== y x))
                                  (lambda () (di) (dk-rewrite-h! (list 'IN y 'ks) y x) (ai (list 'NOT (list 'IN x 'ks)))))
                                (let* ((ex (dk-apply! hcl y x))
                                       (u (dk-skolem! ex 'top))
                                       (v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u) (dk-contains? h 'EMPTY-SET))) "v") #t)))
                                  (ew u)
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (not (dk-ass!))
                                          (km-sep-in! u dd
                                            (lambda ()
                                              (ew v)
                                              (dk-conj-close!
                                                (lambda ()
                                                  (if (not (dk-ass!))
                                                      (let ((z (dk-di-var!)))
                                                        (di)
                                                        (km-iin! z u v)
                                                        (dk-rewrite-h! (list 'IN z (list 'INTERSECTION u v)) (list 'INTERSECTION u v) 'EMPTY-SET)
                                                        (km-not-in-empty! z))))))))))))))))
                  (let ((v (dk-skolem! (dk-ctx-form (km-sep-out! u dd)))))
                    (km-subset! v ck
                      (lambda (z)
                        (dk-cite! 'top-open-subset 't v)
                        (dk-cite! 'subset-mem-fwd v '(PTS t) z)
                        (dk-have! (list 'NOT (list 'IN z 'ks))
                          (lambda () (di) (dk-cite! 'subset-mem-fwd 'ks u z)
                                     (dk-apply! (dk-ctx-form (disj u v)) z)
                                     (ai (list 'NOT (list 'IN z v)))))
                        (km-cin! z '(PTS t) 'ks)))
                    (km-ew-close! v))))))))))
(km-qed! 'compact-hausdorff-closed)

;;; ---- a nonempty chain of nonempty closed subsets of a compact subspace has a common point ----
(define km-chain-hyps
  (list '(IS-TOP-SPACE t) '(SUBSET ks (PTS t)) (list 'IS-COMPACT-T km-SUB)
        '(FORSOME kca_ (IN kca_ ch))
        '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-TOP-CLOSED t kca_)))
        '(FORALL kca_ (IMPLIES (IN kca_ ch) (SUBSET kca_ ks)))
        '(FORALL kca_ (IMPLIES (IN kca_ ch) (FORSOME kcz_ (IN kcz_ kca_))))
        '(FORALL kca_ (IMPLIES (IN kca_ ch) (FORALL kcb_ (IMPLIES (IN kcb_ ch) (OR (SUBSET kca_ kcb_) (SUBSET kcb_ kca_))))))))
(define km-meet '(FORSOME kcp_ (AND (IN kcp_ ks) (FORALL kca_ (IMPLIES (IN kca_ ch) (IN kcp_ kca_))))))
(sp (make-wff (km-alls '(t ks ch) (km-imps km-chain-hyps km-meet))))
(dk-peel!)
(pbc)
(let* ((pt (km-parts! 'is-top-space '(t) '(IS-TOP-SPACE t)))
       (dd '(SEP kdw_ (OPENS t) (FORSOME kdm_ (AND (IN kdm_ ch) (= kdw_ (COMPLEMENT-IN (PTS t) kdm_))))))
       (clo (dk-ctx-form (list-ref km-chain-hyps 4)))
       (sub (dk-ctx-form (list-ref km-chain-hyps 5)))
       (nem (dk-ctx-form (list-ref km-chain-hyps 6)))
       (chn (dk-ctx-form (list-ref km-chain-hyps 7)))
       (cmp (lambda (a) (list 'COMPLEMENT-IN '(PTS t) a)))
       ;; a in ch: COMPLEMENT-IN(PTS t, a) in dd
       (cmp-in! (lambda (a)
                  (let ((pc (km-parts! 'is-top-closed (list 't a) (list 'IS-TOP-CLOSED 't a))))
                    (km-sep-in! (cmp a) dd (lambda () (ew a) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))))
       ;; w in dd: its a (lands (IN a ch), (= w (COMPLEMENT-IN (PTS t) a)))
       (cmp-out! (lambda (w) (dk-skolem! (dk-ctx-form (km-sep-out! w dd)))))
       ;; a subset b: COMPLEMENT(b) subset COMPLEMENT(a)
       (anti! (lambda (a b)
                (km-subset! (cmp b) (cmp a)
                  (lambda (z) (km-cout! z '(PTS t) b)
                              (dk-have! (list 'NOT (list 'IN z a))
                                (lambda () (di) (dk-cite! 'subset-mem-fwd a b z) (ai (list 'NOT (list 'IN z b)))))
                              (km-cin! z '(PTS t) a)))))
       (u (km-open-dir! 't 'ks dd
            (lambda () (let ((w (dk-di-var!))) (km-sep-dom! w dd)))
            (lambda ()
              (let ((a0 (dk-skolem! (dk-ctx-form (list-ref km-chain-hyps 3)))))
                (dk-apply! clo a0)
                (cmp-in! a0)
                (ew (cmp a0)) (dk-ass!)))
            (lambda ()
              (let* ((ld (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) dd))) (dk-peel!)))
                     (w1 (cadr (car ld))) (w2 (cadr (cadr ld)))
                     (a1 (cmp-out! w1)) (a2 (cmp-out! w2))
                     (or12 (dk-apply! chn a1 a2)))
                (use-em (list 'SUBSET a1 a2)
                  (lambda ()
                    (anti! a1 a2)
                    (ew w1)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((equal? (dk-goal) (list 'SUBSET w1 w1)) (dk-cite! 'subset-refl w1) (dk-ass!))
                              (#t (subst (list '= w2 (cmp a2))) (subst (list '= w1 (cmp a1))) (dk-ass!))))))
                  (lambda ()
                    (km-by-prop! (list 'SUBSET a2 a1) or12 (list 'NOT (list 'SUBSET a1 a2)))
                    (anti! a2 a1)
                    (ew w2)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((equal? (dk-goal) (list 'SUBSET w2 w2)) (dk-cite! 'subset-refl w2) (dk-ass!))
                              (#t (subst (list '= w1 (cmp a1))) (subst (list '= w2 (cmp a2))) (dk-ass!)))))))))
            (lambda ()
              (let* ((y (dk-di-var!))
                     (ex (list 'FORSOME 'kdm_ (list 'AND '(IN kdm_ ch) (list 'NOT (list 'IN y 'kdm_))))))
                (dk-have! ex
                  (lambda ()
                    (pbc)
                    (dk-have! km-meet
                      (lambda ()
                        (ew y)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let ((a (dk-di-var!)))
                                  (pbc)
                                  (dk-have! ex (lambda () (ew a) (dk-conj-close! dk-ass!)))
                                  (ai (list 'NOT ex))))))))
                    (ai (list 'NOT km-meet))))
                (let ((a (dk-skolem! (dk-ctx-form ex))))
                  (dk-apply! clo a)
                  (cmp-in! a)
                  (dk-cite! 'subset-mem-fwd 'ks '(PTS t) y)
                  (km-cin! y '(PTS t) a)
                  (ew (cmp a))
                  (dk-conj-close! dk-ass!)))))))
  (let* ((a (cmp-out! u))
         (z (dk-skolem! (dk-apply! nem a))))
    (dk-apply! sub a)
    (dk-cite! 'subset-mem-fwd a 'ks z)
    (dk-cite! 'subset-mem-fwd 'ks u z)
    (dk-rewrite-h! (list 'IN z u) u (cmp a))
    (km-cout! z '(PTS t) a)
    (ai (list 'NOT (list 'IN z a)))))
(km-qed! 'compact-chain-meet)

;;; ======================================================================
;;; km-p5.scm -- BA-KM part 5: superlevel sets of a continuous functional; a continuous real function attains its
;;; maximum on a nonempty compact set; the set of maximisers of a linear functional is an extremal subset.
(define km-RT '(SEMINORM-TOP (NORMED-VECTOR-SPACE-AS-MODULE RR-NVS) (PAIR 0 0) (VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS))))
(define (km-lev c) (list 'SEP 'kmh_ 'ks (list '<= c '(g kmh_))))
;;; g in FUN(PTS t, RR) from IS-HOM-TOP-SPACE(t, RT, g); returns the four parts
(define (km-hom-parts!)
  (let ((ph (km-parts! 'is-hom-top-space-def (list 't km-RT 'g) (list 'IS-HOM-TOP-SPACE 't km-RT 'g))))
    (dk-split-all! (list (dk-cite! 'rr-abs-top-facts)))
    (dk-rewrite-h! (list 'IN 'g (list 'FUN '(PTS t) (list 'PTS km-RT))) (list 'PTS km-RT) 'RR)
    ph))
(define (km-dd-ch f ch) (subst-free 'ch ch f))
(define (km-gtype! z)                  ; z in PTS t: (IN (g z) RR)
  (if (not (dk-asm? (list 'IN (list 'g z) 'RR))) (dk-cite! 'fun-apply-type-c 'g '(PTS t) 'RR z))
  (list 'IN (list 'g z) 'RR))

;;; ---- a superlevel set of a continuous functional inside a closed set is closed ----
(sp (make-wff (km-alls '(t g ks c) (km-imps (list (list 'IS-HOM-TOP-SPACE 't km-RT 'g) '(IS-TOP-CLOSED t ks) '(IN c RR))
   (list 'IS-TOP-CLOSED 't (km-lev 'c))))))
(dk-peel!)
(let* ((ph (km-hom-parts!))
       (hcl (list-ref ph 3))
       (pk (km-parts! 'is-top-closed '(t ks) '(IS-TOP-CLOSED t ks)))
       (S (km-lev 'c))
       (cS (list 'COMPLEMENT-IN '(PTS t) S))
       (cK '(COMPLEMENT-IN (PTS t) ks))
       (O '(SEP hlv_ RR (< hlv_ c)))
       (P (list 'PREIMAGE 't 'g O)))
  (dk-cite! 'rr-halfline-open 'c)
  (dk-apply! hcl O)
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'SUBSET)
              (km-subset! S '(PTS t) (lambda (z) (km-sep-dom! z S) (dk-cite! 'subset-mem-fwd 'ks '(PTS t) z) (dk-ass!)))
              (begin
                (dk-cite! 'complement-in-subset S '(PTS t))
                (km-open-local! 't cS
                  (lambda (x)
                    (km-cout! x '(PTS t) S)
                    (use-em (list 'IN x 'ks)
                      (lambda ()
                        (km-gtype! x)
                        (dk-have! (list 'NOT (list '<= 'c (list 'g x)))
                          (lambda () (di) (km-sep-in! x S) (ai (list 'NOT (list 'IN x S)))))
                        (dk-cite! 'rr-not-le-lt 'c (list 'g x))
                        (km-sep-in! (list 'g x) O)
                        (km-by-prop! (list 'IN x P) (dk-cite! 'preimage-membership 't 'g O x) (list 'IN x '(PTS t)) (list 'IN (list 'g x) O))
                        (km-subset! P cS
                          (lambda (z)
                            (let ((pm (dk-cite! 'preimage-membership 't 'g O z)))
                              (km-by-prop! (list 'IN z '(PTS t)) pm (list 'IN z P))
                              (km-by-prop! (list 'IN (list 'g z) O) pm (list 'IN z P))
                              (km-sep-out! (list 'g z) O)
                              (km-gtype! z)
                              (dk-cite! 'rr-lt-not-le (list 'g z) 'c)
                              (dk-have! (list 'NOT (list 'IN z S))
                                (lambda () (di) (km-sep-out! z S) (ai (list 'NOT (list '<= 'c (list 'g z))))))
                              (km-cin! z '(PTS t) S))))
                        (km-ew-close! P))
                      (lambda ()
                        (km-cin! x '(PTS t) 'ks)
                        (km-subset! cK cS
                          (lambda (z)
                            (km-cout! z '(PTS t) 'ks)
                            (dk-have! (list 'NOT (list 'IN z S))
                              (lambda () (di) (km-sep-dom! z S) (ai (list 'NOT (list 'IN z 'ks)))))
                            (km-cin! z '(PTS t) S)))
                        (km-ew-close! cK)))))))))))
(km-qed! 'closed-superlevel-set)

;;; ---- a continuous real function on a nonempty compact subset attains its maximum ----
(define km-max '(FORSOME kmp_ (AND (IN kmp_ ks) (FORALL kmw_ (IMPLIES (IN kmw_ ks) (<= (g kmw_) (g kmp_)))))))
(sp (make-wff (km-alls '(t ks g) (km-imps (list '(IS-HAUSDORFF t) '(SUBSET ks (PTS t)) (list 'IS-COMPACT-T km-SUB)
   '(FORSOME kmz_ (IN kmz_ ks)) (list 'IS-HOM-TOP-SPACE 't km-RT 'g))
   km-max))))
(dk-peel!)
(dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
(dk-cite! 'compact-hausdorff-closed 't 'ks)
(dk-project! '(IN (PTS t) SET) 'is-top-space '(IS-TOP-SPACE t))
(dk-cite! 'subclass-of-set-is-set 'ks '(PTS t))
(km-hom-parts!)
(let* ((ch (list 'SEP 'kma_ '(POWER ks) (list 'FORSOME 'kmq_ (list 'AND '(IN kmq_ ks) (list '= 'kma_ (km-lev '(g kmq_)))))))
       (gty! (lambda (w) (dk-cite! 'subset-mem-fwd 'ks '(PTS t) w) (km-gtype! w)))
       ;; w in ks: LEV(g w) in ch
       (lev-in! (lambda (w)
                  (let ((L (km-lev (list 'g w))))
                    (gty! w)
                    (km-subset! L 'ks (lambda (z) (km-sep-dom! z L)))
                    (dk-cite! 'subclass-of-set-is-set L 'ks)
                    (dk-have! (list 'FORALL 'pz_ (list 'IMPLIES (list 'IN 'pz_ L) '(IN pz_ ks)))
                      (lambda () (let ((z (dk-di-var!))) (km-sep-dom! z L))))
                    (dk-cite! 'power-mem-intro 'ks L)
                    (km-sep-in! L ch (lambda () (ew w) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
                    L)))
       (lev-out! (lambda (a) (dk-skolem! (dk-ctx-form (km-sep-out! a ch)))))
       ;; c1 <= c2: LEV(c2) subset LEV(c1)
       (mono! (lambda (c1 c2)
                (km-subset! (km-lev c2) (km-lev c1)
                  (lambda (z)
                    (km-sep-out! z (km-lev c2))
                    (gty! z)
                    (km-sep-in! z (km-lev c1)
                      (lambda () (dk-ineq! (list 'IN c1 'RR) (list 'IN c2 'RR) (list 'IN (list 'g z) 'RR)
                                           (list '<= c1 c2) (list '<= c2 (list 'g z)))))))))
       (_unused #f))
  (dk-have! (km-dd-ch (list-ref km-chain-hyps 3) ch)
    (lambda () (let ((w0 (dk-skolem! (dk-ctx-form '(FORSOME kmz_ (IN kmz_ ks)))))) (ew (lev-in! w0)) (dk-ass!))))
  (dk-have! (km-dd-ch (list-ref km-chain-hyps 4) ch)
    (lambda () (let* ((a (dk-di-var!)) (w (lev-out! a)))
                 (gty! w)
                 (dk-cite! 'closed-superlevel-set 't 'g 'ks (list 'g w))
                 (subst (list '= a (km-lev (list 'g w)))) (dk-ass!))))
  (dk-have! (km-dd-ch (list-ref km-chain-hyps 5) ch)
    (lambda () (let* ((a (dk-di-var!)) (w (lev-out! a)))
                 (subst (list '= a (km-lev (list 'g w))))
                 (km-subset! (km-lev (list 'g w)) 'ks (lambda (z) (km-sep-dom! z (km-lev (list 'g w))))))))
  (dk-have! (km-dd-ch (list-ref km-chain-hyps 6) ch)
    (lambda () (let* ((a (dk-di-var!)) (w (lev-out! a)))
                 (gty! w)
                 (dk-cite! 'rr-leq-reflexive (list 'g w))
                 (km-sep-in! w (km-lev (list 'g w)))
                 (ew w)
                 (subst (list '= a (km-lev (list 'g w)))) (dk-ass!))))
  (dk-have! (km-dd-ch (list-ref km-chain-hyps 7) ch)
    (lambda ()
      (let* ((ld (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ch))) (dk-peel!)))
             (a1 (cadr (car ld))) (a2 (cadr (cadr ld)))
             (w1 (lev-out! a1)) (w2 (lev-out! a2)))
        (gty! w1) (gty! w2)
        (subst (list '= a1 (km-lev (list 'g w1))))
        (subst (list '= a2 (km-lev (list 'g w2))))
        (dk-meta-and! (list 'IN (list 'g w1) 'RR) (list 'IN (list 'g w2) 'RR))
        (let ((tot (dk-cite! 'rr-leq-total (list 'g w1) (list 'g w2))))
          (use-em (list '<= (list 'g w1) (list 'g w2))
            (lambda () (mono! (list 'g w1) (list 'g w2)) (oi-r) (dk-ass!))
            (lambda ()
              (km-by-prop! (list '<= (list 'g w2) (list 'g w1)) tot (list 'NOT (list '<= (list 'g w1) (list 'g w2))))
              (mono! (list 'g w2) (list 'g w1)) (oi-l) (dk-ass!)))))))
  (let* ((meet (dk-cite! 'compact-chain-meet 't 'ks ch))
         (p (dk-skolem! meet))
         (allin (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h p) (dk-contains? h 'kma_))) "the meet")))
    (ew p)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let ((w (dk-di-var!)))
              (lev-in! w)
              (dk-apply! allin (km-lev (list 'g w)))
              (km-sep-out! p (km-lev (list 'g w)))
              (dk-ass!)))))))
(km-qed! 'compact-max-attained)

;;; ======================================================================
;;; km-p6.scm -- BA-KM part 6: the maximisers of a linear functional on a convex set form an extremal subset.
(define km-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (km-vadd a b) (list '(VADD m) a b))
(define (km-act r x) (list '(ACT m) r x))
(define (km-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (km-vec! x)                    ; x in ks (ks subset VEC m in context) or a combination: (IN x (VEC m))
  (let ((ty (list 'IN x '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((and (pair? x) (equal? (car x) '(ACT m)))
           (km-real! (cadr x)) (km-vec! (caddr x)) (dk-cite! 'rmod-act-type 'm (cadr x) (caddr x)) ty)
          ((and (pair? x) (equal? (car x) '(VADD m)))
           (km-vec! (cadr x)) (km-vec! (caddr x)) (dk-cite! 'module-vadd-type 'm (cadr x) (caddr x)) ty)
          (#t (dk-cite! 'subset-mem-fwd 'ks '(VEC m) x) ty))))
(define (km-gr! x) (km-vec! x) (if (not (dk-asm? (list 'IN (list 'g x) 'RR))) (dk-cite! 'fun-apply-type-c 'g '(VEC m) 'RR x)) (list 'IN (list 'g x) 'RR))
;;; g(r1 x + r2 y) = r1 g(x) + r2 g(y); ADD and HOM are the linearity clauses
(define (km-glin! add hom r1 x r2 y)
  (let* ((ax (km-act r1 x)) (ay (km-act r2 y)) (c (km-vadd ax ay))
         (rhs (list '+ (list '* r1 (list 'g x)) (list '* r2 (list 'g y))))
         (eq (list '= (list 'g c) rhs)))
    (km-vec! c) (km-gr! x) (km-gr! y)
    
    (if (not (dk-asm? eq))
        (begin
          (dk-apply! add ax ay) 
          (dk-apply! hom r1 x) 
          (dk-apply! hom r2 y) 
          (dk-have! eq (lambda () (subst (list '= (list 'g c) (list '+ (list 'g ax) (list 'g ay))))
                                  (subst (list '= (list 'g ax) (list '* r1 (list 'g x))))
                                  (subst (list '= (list 'g ay) (list '* r2 (list 'g y))))
                                  (rfl))) ))
    eq))

(define km-M (km-lev '(g p)))
(define km-face-hyps
  (list '(IS-MODULE m) (list '= '(SCAL m) km-ring) '(IS-LINEAR-FUNCTIONAL m g) '(IS-CONVEX-SUBSET m ks) '(IN p ks)
        '(FORALL kmw_ (IMPLIES (IN kmw_ ks) (<= (g kmw_) (g p))))))
(sp (make-wff (km-alls '(m g ks p) (km-imps km-face-hyps (list 'IS-EXTREMAL-SUBSET 'm km-M 'ks)))))
(dk-peel!)
(let* ((pl (km-parts! 'is-linear-functional '(m g) '(IS-LINEAR-FUNCTIONAL m g)))
       (add (list-ref pl 1)) (hom (list-ref pl 2))
       (pc (km-parts! 'is-convex-subset '(m ks) '(IS-CONVEX-SUBSET m ks)))
       (cc (list-ref pc 1))
       (mx (dk-ctx-form (list-ref km-face-hyps 5)))
       (gp '(g p)))
  ;; z in M: z in ks, gp <= g z, g z <= gp
  (define (m-out! z) (km-sep-out! z km-M) (km-gr! z) (dk-apply! mx z))
  ;; xx in ks, the combination value V = A + B (A = cx * g xx, B = cy * g yy) with gp <= V, cx > 0, cy >= 0, cx + cy = 1:
  ;; lands (<= gp (g xx))
  (define (face-pt! xx yy cx cy V kfa kfb)
    (dk-have! (list '<= gp (list 'g xx))
      (lambda ()
        (pbc)
        (km-gr! xx) (km-gr! yy)
        (dk-apply! mx yy)
        (dk-cite! 'rr-not-le-lt gp (list 'g xx))
        (let* ((dx (list '- gp (list 'g xx))) (dy (list '- gp (list 'g yy)))
               (P1 (list '* cx dx)) (P2 (list '* dy cy)))
          (km-real! dx) (km-real! dy) (km-real! cx) (km-real! cy)
          (dk-have! (list '< 0 dx) (lambda () (dk-ineq! (list 'IN gp 'RR) (list 'IN (list 'g xx) 'RR) (list '< (list 'g xx) gp))))
          (dk-have! (list '<= 0 dy) (lambda () (dk-ineq! (list 'IN gp 'RR) (list 'IN (list 'g yy) 'RR) (list '<= (list 'g yy) gp))))
          (fact 'rr-zero-in)
          (dk-cite! 'rr-mul-pos cx dx)
          (dk-cite! 'rr-mul-le-right 0 dy cy)
          (km-real! P1) (km-real! P2) (km-real! kfa) (km-real! kfb) (km-real! V)
          (dk-have! (list '= (list '* 0 cy) 0) (lambda () (crs)))
          (let* ((id (list '= (list '+ P1 P2) (list '- gp (list '+ kfa kfb)))))
            (dk-have! id (lambda () (crs)))
            (let* ((n1 (dk-name! P1)) (n2 (dk-name! P2)) (na (dk-name! kfa)) (nb (dk-name! kfb)))
              (let* ((id1 (dk-rewrite-h! id P1 n1)) (id2 (dk-rewrite-h! id1 P2 n2))
                     (id3 (dk-rewrite-h! id2 kfa na)) (id4 (dk-rewrite-h! id3 kfb nb))
                     (lt1 (dk-rewrite-h! (list '< 0 P1) P1 n1))
                     (le2 (dk-rewrite-h! (dk-rewrite-h! (list '<= (list '* 0 cy) P2) (list '* 0 cy) 0) P2 n2))
                     (veq (dk-rewrite-h! (dk-rewrite-h! (list '= V (list '+ kfa kfb)) kfa na) kfb nb)))
                (dk-absurd! (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN na 'RR) (list 'IN nb 'RR) (list 'IN gp 'RR)
                            (list 'IN V 'RR) id4 lt1 le2 veq (list '<= gp V)))))))))
  (km-gr! 'p)
  
  (mac 'is-extremal-subset)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IS-CONVEX-SUBSET)
         (mac 'is-convex-subset)
         (dk-conj-close!
           (lambda ()
             (cond
               ((dk-ass!) #t)
               ((dk-head-is? (dk-goal) 'SUBSET)
                (km-subset! km-M '(VEC m) (lambda (z) (km-sep-dom! z km-M) (km-vec! z) (dk-ass!))))
               (#t
                (let* ((ld (dk-peel!))
                       (ab (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) km-M))) ld)))
                       (a (car ab)) (b (cadr ab))
                       (tt (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
                       (s (list '- 1 tt))
                       (c (km-vadd (km-act s a) (km-act tt b))))
                  (m-out! a) (m-out! b) 
                  (km-and! (list 'IN (list 'g a) 'RR) (list 'IN gp 'RR))
                  (km-and! (list '<= (list 'g a) gp) (list '<= gp (list 'g a)))
                  (dk-cite! 'rr-leq-antisymmetric (list 'g a) gp)
                  (km-and! (list 'IN (list 'g b) 'RR) (list 'IN gp 'RR))
                  (km-and! (list '<= (list 'g b) gp) (list '<= gp (list 'g b)))
                  (dk-cite! 'rr-leq-antisymmetric (list 'g b) gp)
                  (dk-apply! cc a b tt) 
                  (km-real! s)
                  (km-glin! add hom s a tt b)
                  (dk-have! (list '<= gp gp) (lambda () (dk-ineq! (list 'IN gp 'RR))))
                  (dk-have! (list '= (list '+ (list '* s gp) (list '* tt gp)) gp) (lambda () (crs)))
                  (km-sep-in! c km-M
                    (lambda ()
                      
                      (subst (list '= (list 'g c) (list '+ (list '* s (list 'g a)) (list '* tt (list 'g b)))))
                      
                      (subst (list '= (list 'g a) gp))
                      
                      (subst (list '= (list 'g b) gp))
                      
                      (subst (list '= (list '+ (list '* s gp) (list '* tt gp)) gp))
                      (dk-ass!)))))))))
        ((dk-head-is? (dk-goal) 'FORSOME)
         (dk-have! (list '<= gp gp) (lambda () (dk-ineq! (list 'IN gp 'RR))))
         
         (km-sep-in! 'p km-M)
         
         (ew 'p) (dk-ass!))
        ((dk-head-is? (dk-goal) 'SUBSET)
         (dk-close-if! (lambda () (mac 'subset-def))
           (lambda () (dk-close-if! (lambda () (di)) (lambda () (km-sep-dom! (cadr (dk-goal)) km-M) (dk-ass!))))))
        (#t
         
         (let* ((ld (dk-peel!))
                (cm (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) km-M))) ld)))
                (c (cadr cm))
                (s (cadr (cadr c))) (x (caddr (cadr c))) (y (caddr (caddr c)))
                (s1 (list '- 1 s)))
           (km-sep-out! c km-M)
           (km-real! s1)
           (dk-have! (list '< 0 s1) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< s 1))))
           (dk-have! (list '<= 0 s1) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< s 1))))
           (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< 0 s))))
           (let* ((veq (km-glin! add hom s x s1 y))
                  (V (list 'g c)) (kfa (cadr (caddr veq))) (kfb (caddr (caddr veq))))
             (face-pt! x y s s1 V kfa kfb) 
             (face-pt! y x s1 s V kfa kfb)
             (km-sep-in! x km-M)
             (km-sep-in! y km-M)
             (dk-conj-close! dk-ass!)))))))
  'done)
(km-qed! 'max-face-extremal)

;;; ======================================================================
;;; km-p7.scm -- BA-KM part 7: separation of a convex set from a point by a continuous linear functional.
(define km-m1 '(- 1))
(define (km-neg x) (km-act km-m1 x))
(define (km-vt! t)                     ; (IN t (VEC m)) for a module term over vectors in context
  (let ((ty (list 'IN t '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((equal? t '(VZERO m)) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (km-real! (cadr t)) (km-vt! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (km-vt! (cadr t)) (km-vt! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VNEG m)))
           (km-vt! (cadr t)) (dk-cite! 'module-vneg-type 'm (cadr t)) ty)
          (#t (error "km-vt!: no typing for" t)))))
(define (km-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (km-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define km-rmod (list '(IS-MODULE m) (list '= '(SCAL m) km-ring)))
(define km-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define (km-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs km-tvs)
        (dk-project! (list '= '(SCAL m) km-ring) 'is-tvs km-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs km-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs km-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t)))))
(define (km-open-pt! w a1)             ; a1 in w, w open: (IN a1 (VEC m))
  (let ((ty (list 'IN a1 '(VEC m))))
    (if (not (dk-asm? ty))
        (begin
          (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) w)
          (dk-cite! 'power-mem-in '(PTS t) w a1)
          (dk-rewrite-h! (list 'IN a1 '(PTS t)) '(PTS t) '(VEC m))))
    ty))

;;; ---- (-1)(u z1 + t z2) = u((-1) z1) + t((-1) z2) ----
(sp (make-wff (km-alls '(m u t z1 z2) (km-imps (append km-rmod '((IN u RR) (IN t RR) (IN z1 (VEC m)) (IN z2 (VEC m))))
   (list '= (km-neg (km-vadd (km-act 'u 'z1) (km-act 't 'z2))) (km-vadd (km-act 'u (km-neg 'z1)) (km-act 't (km-neg 'z2))))))))
(dk-peel!)
(km-real! km-m1)
(for-each km-vt! (list (km-act 'u 'z1) (km-act 't 'z2) (km-neg 'z1) (km-neg 'z2)))
(subst (dk-cite! 'rmod-act-distrib 'm km-m1 (km-act 'u 'z1) (km-act 't 'z2)))
(km-subst-rev! (dk-cite! 'rmod-act-mul 'm km-m1 'u 'z1))
(km-subst-rev! (dk-cite! 'rmod-act-mul 'm km-m1 't 'z2))
(km-subst-rev! (dk-cite! 'rmod-act-mul 'm 'u km-m1 'z1))
(km-subst-rev! (dk-cite! 'rmod-act-mul 'm 't km-m1 'z2))
(subst (km-eq! '(* u (- 1)) '(* (- 1) u)))
(subst (km-eq! '(* t (- 1)) '(* (- 1) t)))
(km-vt! (km-vadd (km-act '(* (- 1) u) 'z1) (km-act '(* (- 1) t) 'z2)))
(rfl)
(km-qed! 'rmod-neg-combination)

;;; ---- (-1)((-1) x) = x ----
(sp (make-wff (km-alls '(m x) (km-imps (append km-rmod '((IN x (VEC m)))) (list '= (km-neg (km-neg 'x)) 'x)))))
(dk-peel!)
(km-real! km-m1)
(km-subst-rev! (dk-cite! 'rmod-act-mul 'm km-m1 km-m1 'x))
(subst (km-eq! '(* (- 1) (- 1)) 1))
(km-real! 1)
(subst (dk-cite! 'rmod-act-one 'm 'x))
(rfl)
(km-qed! 'rmod-neg-neg)

;;; ---- (x + z) + (-1) z = x ----
(sp (make-wff (km-alls '(m x z) (km-imps (append km-rmod '((IN x (VEC m)) (IN z (VEC m))))
   (list '= (km-vadd (km-vadd 'x 'z) (km-neg 'z)) 'x)))))
(dk-peel!)
(km-real! km-m1)
(km-vt! (km-neg 'z))
(subst (dk-cite! 'rmod-vadd-assoc 'm 'x 'z (km-neg 'z)))
(subst (dk-cite! 'rmod-add-neg 'm 'z))
(subst (dk-cite! 'rmod-vzero-right 'm 'x))
(rfl)
(km-qed! 'rmod-add-sub-cancel)

;;; ---- an open convex set and a disjoint nonempty convex set: a continuous linear functional below at x0 ----
(define km-sep-concl
  (list 'FORSOME 'kgf_ (list 'AND '(IS-LINEAR-FUNCTIONAL m kgf_)
    (list 'AND (list 'IS-HOM-TOP-SPACE 't km-RT 'kgf_)
               '(FORALL kgz_ (IMPLIES (IN kgz_ c) (< (kgf_ kgz_) (kgf_ x0))))))))
(define (km-disj u . c) (list 'FORALL 'kdz_ (list 'IMPLIES (list 'IN 'kdz_ (if (pair? c) (car c) 'c)) (list 'NOT (list 'IN 'kdz_ u)))))
(sp (make-wff (km-alls '(m t v x0 c) (km-imps (list km-tvs '(IN v (OPENS t)) '(IS-CONVEX-SUBSET m v) '(IN x0 v)
   '(IS-CONVEX-SUBSET m c) '(FORSOME kc0_ (IN kc0_ c)) (km-disj 'v)) km-sep-concl))))
(dk-peel!)
(km-tvs-parts!)
(km-open-pt! 'v 'x0)
(km-real! km-m1)
(let* ((N (list 'SEP 'kng_ '(VEC m) (list 'IN (km-neg 'kng_) 'c)))
       (A (list 'SUMSET 'm 'v N))
       (abody (list 'SEP 'smx_ '(VEC m) (list 'FORSOME 'smz_ (list 'AND (list 'IN 'smz_ N) (list 'IN '((VADD m) smx_ ((ACT m) (- 1) smz_)) 'v)))))
       (disj (dk-ctx-form (km-disj 'v)))
       (cvc (dk-project! (list-ref (km-conjs (caddr (dk-cite! 'is-convex-subset 'm 'c))) 1) 'is-convex-subset '(IS-CONVEX-SUBSET m c)))
       (csub (dk-project! '(SUBSET c (VEC m)) 'is-convex-subset '(IS-CONVEX-SUBSET m c))))
  ;; N is a convex subset of VEC m
  (km-subset! N '(VEC m) (lambda (z) (km-sep-dom! z N) (dk-ass!)))
  (dk-have! (list 'IS-CONVEX-SUBSET 'm N)
    (lambda ()
      (mac 'is-convex-subset)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((ld (dk-peel!))
                     (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) N))) ld)))
                     (z1 (car zs)) (z2 (cadr zs))
                     (tt (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
                     (u (list '- 1 tt)))
                (km-sep-out! z1 N) (km-sep-out! z2 N)
                (km-real! u)
                (let* ((m0 (dk-apply! cvc (km-neg z1) (km-neg z2) tt))
                       (e (dk-cite! 'rmod-neg-combination 'm u tt z1 z2))
                       (m1 (dk-rewrite-h! m0 (caddr e) (cadr e)))
                       (cmb (km-vadd (km-act u z1) (km-act tt z2))))
                  (km-vt! cmb)
                  (km-sep-in! cmb N))))))))
  (dk-cite! 'sumset-open 'm 't 'v N)
  (dk-cite! 'sumset-convex 'm 'v N)
  ;; for z in c: x0 + (-1) z in A
  (letrec ((pt-in! (lambda (z)
                     (let* ((w (km-neg z)) (x (km-vadd 'x0 w)))
                       (dk-cite! 'subset-mem-fwd 'c '(VEC m) z)
                       (km-vt! x)
                       (dk-cite! 'rmod-neg-neg 'm z)
                       (dk-have! (list 'IN w N)
                         (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (subst (list '= (km-neg w) z)) (dk-ass!)))))
                       (dk-cite! 'rmod-add-sub-cancel 'm 'x0 w)
                       (dk-have! (list 'IN x A)
                         (lambda ()
                           (mac 'SUMSET)
                           (in-sep! (lambda () (dk-ass!))
                                    (lambda () (ew w)
                                      (dk-conj-close!
                                        (lambda () (if (not (dk-ass!)) (begin (subst (list '= (km-vadd x (km-neg w)) 'x0)) (dk-ass!)))))))))
                       x))))
    (let ((c0 (dk-skolem! (dk-ctx-form '(FORSOME kc0_ (IN kc0_ c))))))
      (let ((x1 (pt-in! c0)))
        (dk-have! (list 'FORSOME 'sa0_ (list 'IN 'sa0_ A)) (lambda () (ew x1) (dk-ass!)))))
    ;; 0 is not in A
    (dk-have! (list 'NOT (list 'IN '(VZERO m) A))
      (lambda ()
        (di)
        (let* ((h (dk-ctx-form (list 'IN '(VZERO m) A)))
               (e (dk-cite! 'sumset-unfold 'm 'v N))
               (h2 (dk-rewrite-h! h A abody)))
          (sep-me h2)
          (dk-split-all!)
          (let* ((z (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'smz_))) (dk-asms)) #t)))
            (km-sep-out! z N)
            (km-sep-dom! z N)
            (km-vt! (km-neg z))
            (dk-cite! 'rmod-vzero-left 'm (km-neg z))
            (dk-rewrite-h! (list 'IN (km-vadd '(VZERO m) (km-neg z)) 'v) (km-vadd '(VZERO m) (km-neg z)) (km-neg z))
            (dk-apply! disj (km-neg z))
            (ai (list 'NOT (list 'IN (km-neg z) 'v)))))))
    (let* ((ex (dk-cite! 'open-convex-positive-functional 'm 't A))
           (ff (dk-skolem! ex #t))
           (pos (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ff) (dk-contains? h A))) "the positivity"))
           (pl (km-parts! 'is-linear-functional (list 'm ff) (list 'IS-LINEAR-FUNCTIONAL 'm ff)))
           (add (list-ref pl 1)) (hom (list-ref pl 2)))
      (ew ff)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((z (dk-di-var!))
                     (w (km-neg z))
                     (x (pt-in! z))
                     (fz (list ff z)) (fx0 (list ff 'x0)))
                (dk-apply! pos x)
                (dk-cite! 'subset-mem-fwd 'c '(VEC m) z)
                (km-vt! w)
                (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR z)
                (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR 'x0)
                (dk-apply! add 'x0 w)
                (dk-apply! hom km-m1 z)
                (let* ((p1 (dk-rewrite-h! (list '< 0 (list ff x)) (list ff x) (list '+ fx0 (list ff w))))
                       (p2 (dk-rewrite-h! p1 (list ff w) (list '* km-m1 fz))))
                  (dk-ineq! (list 'IN fz 'RR) (list 'IN fx0 'RR) p2)))))))))
(km-qed! 'convex-open-separation)

;;; ---- in a locally convex space: a nonempty convex set missing an open neighbourhood of x0 ----
(define km-lctvs '(IS-LOCALLY-CONVEX-TVS m t))
(define (km-lc-clause)
  (list-ref (km-conjs (caddr (dk-cite! 'is-locally-convex-tvs 'm 't))) 1))
(sp (make-wff (km-alls '(m t u x0 c) (km-imps (list km-lctvs '(IN u (OPENS t)) '(IN x0 u)
   '(IS-CONVEX-SUBSET m c) '(FORSOME kc0_ (IN kc0_ c)) (km-disj 'u)) km-sep-concl))))
(dk-peel!)
(dk-project! km-tvs 'is-locally-convex-tvs km-lctvs)
(km-tvs-parts!)
(km-open-pt! 'u 'x0)
(let* ((lc (dk-project! (km-lc-clause) 'is-locally-convex-tvs km-lctvs))
       (disj (dk-ctx-form (km-disj 'u)))
       (ex (dk-apply! lc 'x0 'u))
       (v (dk-skolem! ex #t)))
  (dk-have! (km-disj v)
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! disj z)
        (dk-have! (list 'NOT (list 'IN z v))
          (lambda () (di) (dk-cite! 'subset-mem-fwd v 'u z) (ai (list 'NOT (list 'IN z 'u))))))))
  (dk-cite! 'convex-open-separation 'm 't v 'x0 'c)
  (dk-ass!))
(km-qed! 'locally-convex-separation)

;;; ======================================================================
;;; km-p8.scm -- BA-KM part 8: the meet of a family of closed extremal subsets; the extreme point exists (Zorn).
;;; goal (SUBSET a b) on the focus leaf: BODY receives the eigenvariable with z in a in context (tolerates a leaf that
;;; hash-consing grounds on the way)
(define (km-sub-goal! body)
  (dk-close-if! (lambda () (mac 'subset-def))
    (lambda () (dk-close-if! (lambda () (di)) (lambda () (body (cadr (dk-goal))))))))
(define (km-UB ch) (list 'SEP 'kub_ 'ks (list 'FORALL 'kca_ (list 'IMPLIES (list 'IN 'kca_ ch) '(IN kub_ kca_)))))
(define km-ch-ext '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-EXTREMAL-SUBSET m kca_ ks))))
(define km-ch-cl '(FORALL kca_ (IMPLIES (IN kca_ ch) (IS-TOP-CLOSED t kca_))))

;;; ---- a nonempty convex set is an extremal subset of itself ----
(sp (make-wff (km-alls '(m ks) (km-imps '((IS-CONVEX-SUBSET m ks) (FORSOME kz0_ (IN kz0_ ks))) '(IS-EXTREMAL-SUBSET m ks ks)))))
(dk-peel!)
(mac 'is-extremal-subset)
(dk-conj-close!
  (lambda ()
    (cond ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) 'SUBSET) (dk-cite! 'subset-refl 'ks) (dk-ass!))
          (#t (dk-peel!) (dk-conj-close! dk-ass!)))))
(km-qed! 'extremal-subset-refl)

;;; ---- the meet over a family of extremal subsets, when nonempty, is extremal ----
(sp (make-wff (km-alls '(m ks ch) (km-imps (list '(IS-MODULE m) '(IS-CONVEX-SUBSET m ks) km-ch-ext (list 'FORSOME 'kuz_ (list 'IN 'kuz_ (km-UB 'ch))))
   (list 'IS-EXTREMAL-SUBSET 'm (km-UB 'ch) 'ks)))))
(dk-peel!)
(let* ((UB (km-UB 'ch))
       (ext (dk-ctx-form km-ch-ext))
       (cvk (list-ref (km-parts! 'is-convex-subset '(m ks) '(IS-CONVEX-SUBSET m ks)) 1))
       (ext-parts! (lambda (a)
                     (dk-apply! ext a)
                     (km-parts! 'is-extremal-subset (list 'm a 'ks) (list 'IS-EXTREMAL-SUBSET 'm a 'ks)))))
  (mac 'is-extremal-subset)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IS-CONVEX-SUBSET)
         (mac 'is-convex-subset)
         (dk-conj-close!
           (lambda ()
             (cond
               ((dk-ass!) #t)
               ((dk-head-is? (dk-goal) 'SUBSET)
                (km-subset! UB 'ks (lambda (z) (km-sep-dom! z UB) (dk-ass!)))
                (dk-cite! 'subset-trans UB 'ks '(VEC m))
                (dk-ass!))
               (#t
                (let* ((ld (dk-peel!))
                       (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) UB))) ld)))
                       (z1 (car zs)) (z2 (cadr zs))
                       (tt (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
                       (c1 (km-sep-out! z1 UB)) (c2 (km-sep-out! z2 UB))
                       (cmb (km-vadd (km-act (list '- 1 tt) z1) (km-act tt z2))))
                  (dk-apply! cvk z1 z2 tt)
                  (km-sep-in! cmb UB
                    (lambda ()
                      (let* ((a (dk-di-var!))
                             (pa (ext-parts! a))
                             (cva (list-ref (km-parts! 'is-convex-subset (list 'm a) (list 'IS-CONVEX-SUBSET 'm a)) 1)))
                        (dk-apply! (dk-ctx-form c1) a)
                        (dk-apply! (dk-ctx-form c2) a)
                        (dk-apply! cva z1 z2 tt)
                        (dk-ass!))))))))))
        ((dk-head-is? (dk-goal) 'SUBSET)
         (km-sub-goal! (lambda (z) (km-sep-dom! z UB) (dk-ass!))))
        (#t
         (let* ((ld (dk-peel!))
                (cm (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) UB))) ld)))
                (c (cadr cm))
                (s (cadr (cadr c))) (x (caddr (cadr c))) (y (caddr (caddr c)))
                (cc (km-sep-out! c UB))
                (in! (lambda (w)
                       (km-sep-in! w UB
                         (lambda ()
                           (let* ((a (dk-di-var!))
                                  (cla (list-ref (ext-parts! a) 3)))
                             (dk-apply! (dk-ctx-form cc) a)
                             (dk-split! (dk-apply! cla x y s))
                             (dk-ass!)))))))
           (in! x) (in! y)
           (dk-conj-close! dk-ass!)))))))
(km-qed! 'extremal-meet)

;;; ---- the meet over a family of closed sets, inside a closed set, is closed ----
(sp (make-wff (km-alls '(t ks ch) (km-imps (list '(IS-TOP-SPACE t) '(IS-TOP-CLOSED t ks) km-ch-cl) (list 'IS-TOP-CLOSED 't (km-UB 'ch))))))
(dk-peel!)
(let* ((UB (km-UB 'ch))
       (clh (dk-ctx-form km-ch-cl))
       (pk (km-parts! 'is-top-closed '(t ks) '(IS-TOP-CLOSED t ks)))
       (cU (list 'COMPLEMENT-IN '(PTS t) UB))
       (cK '(COMPLEMENT-IN (PTS t) ks)))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (km-sub-goal! (lambda (z) (km-sep-dom! z UB) (dk-cite! 'subset-mem-fwd 'ks '(PTS t) z) (dk-ass!))))
        (#t
         (dk-cite! 'complement-in-subset UB '(PTS t))
         (km-open-local! 't cU
           (lambda (x)
             (km-cout! x '(PTS t) UB)
             (use-em (list 'IN x 'ks)
               (lambda ()
                 (let ((exa (list 'FORSOME 'kna_ (list 'AND '(IN kna_ ch) (list 'NOT (list 'IN x 'kna_))))))
                   (dk-have! exa
                     (lambda ()
                       (pbc)
                       (km-sep-in! x UB
                         (lambda ()
                           (let ((a (dk-di-var!)))
                             (pbc)
                             (dk-have! exa (lambda () (ew a) (dk-conj-close! dk-ass!)))
                             (ai (list 'NOT exa)))))
                       (ai (list 'NOT (list 'IN x UB)))))
                   (let* ((a (dk-skolem! (dk-ctx-form exa) #t))
                          (ca (list 'COMPLEMENT-IN '(PTS t) a)))
                     (dk-apply! clh a)
                     (km-parts! 'is-top-closed (list 't a) (list 'IS-TOP-CLOSED 't a))
                     (km-cin! x '(PTS t) a)
                     (km-subset! ca cU
                       (lambda (z)
                         (km-cout! z '(PTS t) a)
                         (dk-have! (list 'NOT (list 'IN z UB))
                           (lambda () (di) (let ((cz (km-sep-out! z UB))) (dk-apply! (dk-ctx-form cz) a) (ai (list 'NOT (list 'IN z a))))))
                         (km-cin! z '(PTS t) UB)))
                     (km-ew-close! ca))))
               (lambda ()
                 (km-cin! x '(PTS t) 'ks)
                 (km-subset! cK cU
                   (lambda (z)
                     (km-cout! z '(PTS t) 'ks)
                     (dk-have! (list 'NOT (list 'IN z UB))
                       (lambda () (di) (km-sep-dom! z UB) (ai (list 'NOT (list 'IN z 'ks)))))
                     (km-cin! z '(PTS t) UB)))
                 (km-ew-close! cK))))))))))
(km-qed! 'closed-meet)

;;; ======================================================================
;;; km-p9.scm -- BA-KM part 9: continuous linear functionals separate points; a closed extremal subset has a closed
;;; extremal face on which a given functional stays above its value at a given point.
(define (km-pts-of! a)                 ; (SUBSET a (VEC m)) in context, PTS t == VEC m: (SUBSET a (PTS t))
  (let ((g (list 'SUBSET a '(PTS t))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst '(= (PTS t) (VEC m))) (dk-ass!))))
    g))
(define (km-lin-type! G z)             ; (IS-LINEAR-FUNCTIONAL m G), z in VEC m: (IN (G z) RR)
  (let ((ty (list 'IN (list G z) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (if (not (dk-asm? (list 'IN G '(FUN (VEC m) RR))))
              (dk-project! (list 'IN G '(FUN (VEC m) RR)) 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm G)))
          (dk-cite! 'fun-apply-type-c G '(VEC m) 'RR z)))
    ty))

;;; ---- in a locally convex space two distinct points are separated by a continuous linear functional ----
(define km-sep2-concl
  (list 'FORSOME 'kgf_ (list 'AND '(IS-LINEAR-FUNCTIONAL m kgf_)
    (list 'AND (list 'IS-HOM-TOP-SPACE 't km-RT 'kgf_) '(< (kgf_ y) (kgf_ x))))))
(sp (make-wff (km-alls '(m t x y) (km-imps (list km-lctvs '(IN x (VEC m)) '(IN y (VEC m)) '(NOT (= x y))) km-sep2-concl))))
(dk-peel!)
(dk-project! km-tvs 'is-locally-convex-tvs km-lctvs)
(km-tvs-parts!)
(let* ((hcl (list-ref (km-parts! 'is-hausdorff '(t) '(IS-HAUSDORFF t)) 1))
       (lc (dk-project! (km-lc-clause) 'is-locally-convex-tvs km-lctvs)))
  (dk-have! '(IN x (PTS t)) (lambda () (subst '(= (PTS t) (VEC m))) (dk-ass!)))
  (dk-have! '(IN y (PTS t)) (lambda () (subst '(= (PTS t) (VEC m))) (dk-ass!)))
  (dk-have! '(NOT (== x y))
    (lambda ()
      (di)
      (dk-rewrite-h! '(NOT (= x y)) 'x 'y)
      (dk-have! '(= y y) (lambda () (rfl)))
      (ai '(NOT (= y y)))))
  (let* ((ex (dk-apply! hcl 'x 'y))
         (u (dk-skolem! ex 'top))
         (v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u) (dk-contains? h 'EMPTY-SET))) "v") #t))
         (uv (list 'INTERSECTION u v))
         (ex2 (dk-apply! lc 'y v))
         (w (dk-skolem! ex2 #t)))
    (dk-have! (list 'FORSOME 'kc0_ (list 'IN 'kc0_ w)) (lambda () (ew 'y) (dk-ass!)))
    (dk-have! (km-disj u w)
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-have! (list 'NOT (list 'IN z u))
            (lambda ()
              (di)
              (dk-cite! 'subset-mem-fwd w v z)
              (km-iin! z u v)
              (dk-rewrite-h! (list 'IN z uv) uv 'EMPTY-SET)
              (km-not-in-empty! z))))))
    (let* ((sx (dk-cite! 'locally-convex-separation 'm 't u 'x w))
           (G (dk-skolem! sx #t))
           (below (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h G) (dk-contains? h w))) "below")))
      (dk-apply! below 'y)
      (ew G)
      (dk-conj-close! dk-ass!))))
(km-qed! 'locally-convex-separates-points)

;;; ---- a closed extremal subset f of a compact ks, a continuous linear g, x in f: a closed extremal face of ks inside
;;; f on which g stays >= g(x) ----
(define km-face-concl
  '(FORSOME kfm_ (AND (IS-TOP-CLOSED t kfm_) (AND (IS-EXTREMAL-SUBSET m kfm_ ks) (AND (SUBSET kfm_ f)
     (AND (FORSOME kfe_ (IN kfe_ kfm_)) (FORALL kfz_ (IMPLIES (IN kfz_ kfm_) (<= (g x) (g kfz_))))))))))
(sp (make-wff (km-alls '(m t ks f g x) (km-imps (list km-tvs '(SUBSET ks (VEC m)) (list 'IS-COMPACT-T km-SUB)
   '(IS-TOP-CLOSED t f) '(IS-EXTREMAL-SUBSET m f ks) '(IS-LINEAR-FUNCTIONAL m g) (list 'IS-HOM-TOP-SPACE 't km-RT 'g) '(IN x f))
   km-face-concl))))
(dk-peel!)
(km-tvs-parts!)
(km-pts-of! 'ks)
(let* ((pf (km-parts! 'is-extremal-subset '(m f ks) '(IS-EXTREMAL-SUBSET m f ks)))
       (SUBF '(SUBSPACE-TOP t f)))
  (dk-cite! 'subset-trans 'f 'ks '(PTS t))
  (dk-cite! 'closed-in-subspace 't 'ks 'f)
  (dk-cite! 'closed-subset-compact km-SUB 'f)
  (dk-cite! 'subspace-of-subspace 't 'ks 'f)
  (dk-rewrite-h! (list 'IS-COMPACT-T (list 'SUBSPACE-TOP km-SUB 'f)) (list 'SUBSPACE-TOP km-SUB 'f) SUBF)
  (dk-have! '(FORSOME kmz_ (IN kmz_ f)) (lambda () (ew 'x) (dk-ass!)))
  (let* ((mx (dk-cite! 'compact-max-attained 't 'f 'g))
         (p (dk-skolem! mx #t))
         (maxp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h p) (dk-contains? h 'f))) "the max"))
         (gp (list 'g p))
         (M (list 'SEP 'kmh_ 'f (list '<= gp '(g kmh_)))))
    (dk-cite! 'subset-mem-fwd 'f 'ks p)
    (dk-cite! 'subset-mem-fwd 'ks '(VEC m) p)
    (dk-cite! 'subset-mem-fwd 'f 'ks 'x)
    (dk-cite! 'subset-mem-fwd 'ks '(VEC m) 'x)
    (km-lin-type! 'g p) (km-lin-type! 'g 'x)
    (dk-cite! 'max-face-extremal 'm 'g 'f p)
    (dk-cite! 'extremal-subset-trans 'm M 'f 'ks)
    (dk-cite! 'closed-superlevel-set 't 'g 'f gp)
    (let ((pm (km-parts! 'is-extremal-subset (list 'm M 'f) (list 'IS-EXTREMAL-SUBSET 'm M 'f))))
      (dk-apply! maxp 'x)
      (ew M)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((z (dk-di-var!)))
                (km-sep-out! z M)
                (km-sep-dom! z M)
                (dk-cite! 'subset-mem-fwd 'f 'ks z)
                (dk-cite! 'subset-mem-fwd 'ks '(VEC m) z)
                (km-lin-type! 'g z)
                (dk-ineq! (list 'IN '(g x) 'RR) (list 'IN gp 'RR) (list 'IN (list 'g z) 'RR)
                          (list '<= '(g x) gp) (list '<= gp (list 'g z))))))))))
(km-qed! 'closed-face-above)

;;; ======================================================================
;;; km-p10.scm -- BA-KM part 10: a nonempty compact convex subset of a locally convex space has an extreme point
;;; (Zorn on the closed extremal subsets under reverse inclusion; a minimal one is a single point).
(define km-GRD '(SEP kgr_ (POWER ks) (AND (IS-TOP-CLOSED t kgr_) (IS-EXTREMAL-SUBSET m kgr_ ks))))
(define km-POR (list 'SEP 'kpr_ (list 'CARTESIAN km-GRD km-GRD) '(SUBSET (NTH 2 kpr_) (NTH 1 kpr_))))
(define (km-has-nth-list? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred km-has-nth-list? e))))
(define (km-nth-all!) (let loop ((k 0)) (if (and (< k 10) (km-has-nth-list? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
(define (km-pow-in! a)                 ; (SUBSET a ks), (IN ks SET): (IN a (POWER ks))
  (let ((g (list 'IN a '(POWER ks))))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'subclass-of-set-is-set a 'ks)
          (dk-have! (list 'FORALL 'kpz_ (list 'IMPLIES (list 'IN 'kpz_ a) '(IN kpz_ ks)))
            (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd a 'ks e) (dk-ass!))))
          (dk-cite! 'power-mem-intro 'ks a)))
    g))
(define (km-pow-out! a)
  (let ((g (list 'SUBSET a 'ks)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-cite! 'power-mem-in 'ks a e) (dk-ass!)))))
    g))
(define (km-grd-in! a)                 ; (SUBSET a ks), closed, extremal in context: (IN a GRD)
  (km-pow-in! a)
  (dk-have! (list 'IN a km-GRD) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!))))))
(define (km-grd-out! a)                ; (IN a GRD) in context: (SUBSET a ks), (IS-TOP-CLOSED t a), (IS-EXTREMAL-SUBSET m a ks)
  (let ((c (list 'AND (list 'IN a '(POWER ks)) (list 'AND (list 'IS-TOP-CLOSED 't a) (list 'IS-EXTREMAL-SUBSET 'm a 'ks)))))
    (if (not (dk-asm? (list 'IS-EXTREMAL-SUBSET 'm a 'ks)))
        (begin (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN a km-GRD))) (dk-split-all!) (dk-conj-close! dk-ass!)))
               (dk-split-all! (list c))
               (km-pow-out! a)))))
(define (km-por-in! a b)               ; a, b in GRD, (SUBSET b a): (IN (LIST a b) POR)
  (dk-cite! 'pair-in-cartesian km-GRD km-GRD a b)
  (dk-have! (list 'IN (list 'LIST a b) km-POR) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (km-nth-all!) (dk-ass!))))))
(define (km-por-out! a b)              ; (IN (LIST a b) POR) in context: (SUBSET b a)
  (let ((g (list 'SUBSET b a)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST a b) km-POR))) (dk-split-all!)
                               (dk-nth-h! (dk-pick (lambda (h) (and (dk-head-is? h 'SUBSET) (dk-contains? h 'NTH))) "the order"))
                               (dk-ass!))))
    g))
(define (km-set-eq! a b)               ; (SUBSET a b), (SUBSET b a) in context: (= a b)
  (dk-have! (list 'FORALL 'kqz_ (list 'IFF (list 'IN 'kqz_ a) (list 'IN 'kqz_ b)))
    (lambda () (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                 (dk-iff! (lambda (g) (equal? g (list 'IN z b)))
                   (lambda () (dk-cite! 'subset-mem-fwd a b z) (dk-ass!))
                   (lambda () (dk-cite! 'subset-mem-fwd b a z) (dk-ass!))))))
  (dk-cite! 'class-extensionality a b))

(sp (make-wff (km-alls '(m t ks) (km-imps (list km-lctvs '(SUBSET ks (VEC m)) '(IS-CONVEX-SUBSET m ks) (list 'IS-COMPACT-T km-SUB)
   '(FORSOME kz0_ (IN kz0_ ks))) '(FORSOME kep_ (IS-EXTREME-POINT m ks kep_))))))
(dk-peel!)
(dk-project! km-tvs 'is-locally-convex-tvs km-lctvs)
(km-tvs-parts!)
(km-pts-of! 'ks)
(dk-cite! 'compact-hausdorff-closed 't 'ks)
(dk-project! '(IN (PTS t) SET) 'is-top-space '(IS-TOP-SPACE t))
(dk-cite! 'subclass-of-set-is-set 'ks '(PTS t))
(fact 'power-set 'ks)
(dk-cite! 'extremal-subset-refl 'm 'ks)
(dk-cite! 'subset-refl 'ks)
(km-grd-in! 'ks)
(dk-have! (list 'IN km-GRD 'SET) (lambda () (sep-set) (dk-ass!)))
(dk-have! (list 'IN (list 'CARTESIAN km-GRD km-GRD) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
(dk-have! (list 'IN km-POR 'SET) (lambda () (sep-set) (dk-ass!)))
;; the partial order
(dk-have! (list 'IS-PARTIAL-ORDER km-GRD km-POR)
  (lambda ()
    (mac 'is-partial-order)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((ld (dk-peel!))
                   (vs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) km-GRD))) ld))))
              (dk-split-all!)
              (for-each km-grd-out! vs)
              (cond ((= (length vs) 1) (dk-cite! 'subset-refl (car vs)) (km-por-in! (car vs) (car vs)))
                    ((= (length vs) 2)
                     (let ((a (car vs)) (b (cadr vs)))
                       (km-por-out! a b) (km-por-out! b a) (km-set-eq! a b) (dk-ass!)))
                    (#t
                     (let ((a (car vs)) (b (cadr vs)) (c (caddr vs)))
                       (km-por-out! a b) (km-por-out! b c)
                       (dk-cite! 'subset-trans c b a)
                       (km-por-in! a c))))))))))
;; every chain has an upper bound: the meet (all of ks for the empty chain)
(dk-have! (list 'FORALL 'ch_ (list 'IMPLIES (list 'IS-CHAIN km-GRD km-POR 'ch_) (list 'FORSOME 'u_ (list 'IS-UPPER-BOUND km-GRD km-POR 'ch_ 'u_))))
  (lambda ()
    (let* ((ch (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-CHAIN)) (dk-peel!))))
           (ich (list 'IS-CHAIN km-GRD km-POR ch))
           (csub (dk-project! (list 'SUBSET ch km-GRD) 'is-chain ich))
           (ccmp (dk-project! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ch) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y ch)
                                  (list 'OR (list 'IN '(LIST x y) km-POR) (list 'IN '(LIST y x) km-POR))))))
                              'is-chain ich))
           (UB (km-UB ch))
           (mem! (lambda (a) (dk-cite! 'subset-mem-fwd ch km-GRD a) (km-grd-out! a)))
           (fam (lambda (f) (subst-free 'ch ch f))))
      (dk-have! (fam km-ch-ext) (lambda () (let ((a (dk-di-var!))) (mem! a) (dk-ass!))))
      (dk-have! (fam km-ch-cl) (lambda () (let ((a (dk-di-var!))) (mem! a) (dk-ass!))))
      ;; the meet is nonempty
      (dk-have! (list 'FORSOME 'kuz_ (list 'IN 'kuz_ UB))
        (lambda ()
          (use-em (list 'FORSOME 'kca_ (list 'IN 'kca_ ch))
            (lambda ()
              (dk-have! (fam (list-ref km-chain-hyps 5)) (lambda () (let ((a (dk-di-var!))) (mem! a) (dk-ass!))))
              (dk-have! (fam (list-ref km-chain-hyps 6))
                (lambda () (let ((a (dk-di-var!))) (mem! a)
                             (dk-project! (list 'FORSOME 'exz_ (list 'IN 'exz_ a)) 'is-extremal-subset (list 'IS-EXTREMAL-SUBSET 'm a 'ks))
                             (dk-ass!))))
              (dk-have! (fam (list-ref km-chain-hyps 7))
                (lambda ()
                  (let* ((ld (dk-peel!))
                         (ab (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ch))) ld)))
                         (a (car ab)) (b (cadr ab)))
                    (mem! a) (mem! b)
                    (let ((or1 (dk-apply! ccmp a b)))
                      (use-em (list 'IN (list 'LIST a b) km-POR)
                        (lambda () (km-por-out! a b) (oi-r) (dk-ass!))
                        (lambda ()
                          (km-by-prop! (list 'IN (list 'LIST b a) km-POR) or1 (list 'NOT (list 'IN (list 'LIST a b) km-POR)))
                          (km-por-out! b a) (oi-l) (dk-ass!)))))))
              (let* ((meet (dk-cite! 'compact-chain-meet 't 'ks ch))
                     (p (dk-skolem! meet #t))
                     (allp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h p) (dk-contains? h ch))) "the meet")))
                (km-sep-in! p UB)
                (ew p) (dk-ass!)))
            (lambda ()
              (let ((z0 (dk-skolem! (dk-ctx-form '(FORSOME kz0_ (IN kz0_ ks))))))
                (km-sep-in! z0 UB
                  (lambda ()
                    (let ((a (dk-di-var!)))
                      (pbc)
                      (dk-have! (list 'FORSOME 'kca_ (list 'IN 'kca_ ch)) (lambda () (ew a) (dk-ass!)))
                      (ai (list 'NOT (list 'FORSOME 'kca_ (list 'IN 'kca_ ch)))))))
                (ew z0) (dk-ass!))))))
      (dk-cite! 'extremal-meet 'm 'ks ch)
      (dk-cite! 'closed-meet 't 'ks ch)
      (km-subset! UB 'ks (lambda (z) (km-sep-dom! z UB) (dk-ass!)))
      (km-grd-in! UB)
      (ew UB)
      (mac 'is-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((x (dk-di-var!)))
                (mem! x)
                (km-subset! UB x
                  (lambda (z) (let ((cz (km-sep-out! z UB))) (dk-apply! (dk-ctx-form cz) x) (dk-ass!))))
                (km-por-in! x UB))))))))
(dk-have! (list 'FORSOME 'w_ (list 'IN 'w_ km-GRD)) (lambda () (ew 'ks) (dk-ass!)))
(let* ((zl (dk-cite! 'zorn-lemma km-GRD km-POR))
       (F (dk-skolem! zl #t))
       (im (list 'IS-MAXIMAL km-GRD km-POR F))
       (mxg (dk-project! (list 'IN F km-GRD) 'is-maximal im))
       (mcl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y km-GRD) (list 'IMPLIES (list 'IN (list 'LIST F 'y) km-POR) (list 'IN (list 'LIST 'y F) km-POR))))
                         'is-maximal im)))
  (km-grd-out! F)
  (let* ((pf (km-parts! 'is-extremal-subset (list 'm F 'ks) (list 'IS-EXTREMAL-SUBSET 'm F 'ks)))
         (e0 (dk-skolem! (dk-ctx-form (list 'FORSOME 'exz_ (list 'IN 'exz_ F)))))
         (alleq (list 'FORALL 'kmp_ (list 'IMPLIES (list 'IN 'kmp_ F) (list 'FORALL 'kmq_ (list 'IMPLIES (list 'IN 'kmq_ F) '(= kmp_ kmq_)))))))
    (dk-have! alleq
      (lambda ()
        (let* ((ld (dk-peel!))
               (xy (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) F))) ld)))
               (x (car xy)) (y (cadr xy)))
          (pbc)
          (dk-cite! 'subset-mem-fwd F 'ks x) (dk-cite! 'subset-mem-fwd F 'ks y)
          (dk-cite! 'subset-mem-fwd 'ks '(VEC m) x) (dk-cite! 'subset-mem-fwd 'ks '(VEC m) y)
          (let* ((sp2 (dk-cite! 'locally-convex-separates-points 'm 't x y))
                 (G (dk-skolem! sp2 #t))
                 (fc (dk-cite! 'closed-face-above 'm 't 'ks F G x))
                 (M (dk-skolem! fc #t))
                 (above (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h M) (dk-contains? h 'kfz_))) "above")))
            (dk-cite! 'subset-trans M F 'ks)
            (km-grd-in! M)
            (km-por-in! F M)
            (dk-apply! mcl M)
            (km-por-out! M F)
            (dk-cite! 'subset-mem-fwd F M y)
            (dk-apply! above y)
            (km-lin-type! G x) (km-lin-type! G y)
            (dk-absurd! (list 'IN (list G x) 'RR) (list 'IN (list G y) 'RR)
                        (list '< (list G y) (list G x)) (list '<= (list G x) (list G y)))))))
    (dk-cite! 'extremal-subset-singleton-extreme 'm F 'ks e0)
    (ew e0)
    (dk-ass!)))
(km-qed! 'extreme-point-exists)

