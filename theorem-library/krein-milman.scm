;;; km-p1.scm -- BA-KM part 1: unfolds, memberships, extreme points of an extremal subset.
(define (km-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; KM OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (km-alls vs body) (if (null? vs) body (list 'FORALL (car vs) (km-alls (cdr vs) body))))
(define (km-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (km-imps (cdr hs) body))))
(define (km-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (cons (cadr f) (km-conjs (caddr f))) (list f)))
;;; the conjuncts of the defining IFF of a predicate hypothesis HYP, each landed (HYP survives)
(define (km-parts! thm args hyp)
  (let ((iff (apply dk-cite! thm args)))
    (map (lambda (c) (dk-project! c thm hyp)) (km-conjs (caddr iff)))))
(define (km-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (km-mem-thm! name args setf body dom cnd unf)
  (sp (make-wff (km-alls (append args '(z)) (list 'IFF (list 'IN 'z setf) (list 'AND (list 'IN 'z dom) cnd)))))
  (dk-peel!)
  (apply dk-cite! unf args)
  (subst (list '== setf body))
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda () (sep-me (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'z) (dk-head-is? (caddr h) 'SEP))) "sep")) (dk-split-all!) (dk-conj-close! dk-ass!))
    (lambda () (dk-split-all!) (in-sep! (lambda () (ass)) (lambda () (ass)))))
  (km-qed! name))

;;; ---- unfolds and memberships -------------------------------------------------------------
(define km-EP-body '(SEP kez_ (VEC m) (IS-EXTREME-POINT m ks kez_)))
(define km-CH-body '(SEP khx_ (VEC m)
     (FORALL khc_ (IMPLIES (IN khc_ SET) (IMPLIES (IS-CONVEX-SUBSET m khc_) (IMPLIES (IS-TOP-CLOSED t khc_) (IMPLIES (SUBSET e khc_)
       (IN khx_ khc_))))))))
(sp (make-wff (km-alls '(m ks) (list '== '(EXTREME-POINTS m ks) km-EP-body))))
(dk-peel!) (mac 'EXTREME-POINTS) (qrfl)
(km-qed! 'extreme-points-unfold)
(sp (make-wff (km-alls '(m t e) (list '== '(CLOSED-CONV-HULL m t e) km-CH-body))))
(dk-peel!) (mac 'CLOSED-CONV-HULL) (qrfl)
(km-qed! 'closed-conv-hull-unfold)
(km-mem-thm! 'extreme-points-mem '(m ks) '(EXTREME-POINTS m ks) km-EP-body '(VEC m) '(IS-EXTREME-POINT m ks z)
             'extreme-points-unfold)
(km-mem-thm! 'closed-conv-hull-mem '(m t e) '(CLOSED-CONV-HULL m t e) km-CH-body '(VEC m)
             '(FORALL khc_ (IMPLIES (IN khc_ SET) (IMPLIES (IS-CONVEX-SUBSET m khc_) (IMPLIES (IS-TOP-CLOSED t khc_) (IMPLIES (SUBSET e khc_)
                (IN z khc_))))))
             'closed-conv-hull-unfold)

;;; ---- Remark 4.40: an extreme point of an extremal subset b of a is an extreme point of a ----
(define (km-cvx t x y) (list '(VADD m) (list '(ACT m) (list '- 1 t) x) (list '(ACT m) t y)))
(sp (make-wff (km-alls '(m b a e) (km-imps '((IS-EXTREMAL-SUBSET m b a) (IS-EXTREME-POINT m b e)) '(IS-EXTREME-POINT m a e)))))
(dk-peel!)
(let* ((pb (km-parts! 'is-extremal-subset '(m b a) '(IS-EXTREMAL-SUBSET m b a)))
       (clb (list-ref pb 3))
       (pe (km-parts! 'is-extreme-point '(m b e) '(IS-EXTREME-POINT m b e)))
       (cle (list-ref pe 1)))
  (mac 'is-extreme-point)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (dk-cite! 'subset-mem-fwd 'b 'a 'e) (dk-ass!))
              (let* ((ld (dk-peel!))
                     (eqx (find-first (lambda (h) (and (dk-head-is? h '=) (eq? (cadr h) 'e))) ld))
                     (combo (caddr eqx))
                     (t (cadr (caddr combo)))
                     (u (caddr (cadr combo)))
                     (v (caddr (caddr combo)))
                     (s (list '- 1 t))
                     (combo2 (list '(VADD m) (list '(ACT m) s u) (list '(ACT m) (list '- 1 s) v))))
                (dk-have! (list 'IN s 'RR) (lambda () (type-term)))
                (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< t 1))))
                (dk-have! (list '< s 1) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< 0 t))))
                (dk-have! (list '= (list '- 1 s) t) (lambda () (crs)))
                (dk-have! (list 'IN combo2 'b)
                  (lambda () (subst (list '= (list '- 1 s) t)) (subst (list '= combo 'e)) (dk-ass!)))
                (dk-split! (dk-apply! clb u v s))
                (dk-split! (dk-apply! cle u v t))
                (dk-conj-close! dk-ass!)))))))
(km-qed! 'extreme-point-of-extremal-subset)

;;; ---- Remark 4.40, the converse: an extreme point of a lying in a subset b of a is an extreme point of b ----
(sp (make-wff (km-alls '(m b a e) (km-imps '((SUBSET b a) (IS-EXTREME-POINT m a e) (IN e b)) '(IS-EXTREME-POINT m b e)))))
(dk-peel!)
(let* ((pe (km-parts! 'is-extreme-point '(m a e) '(IS-EXTREME-POINT m a e)))
       (cle (list-ref pe 1)))
  (mac 'is-extreme-point)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (eqx (find-first (lambda (h) (and (dk-head-is? h '=) (eq? (cadr h) 'e))) ld))
                 (combo (caddr eqx))
                 (t (cadr (caddr combo)))
                 (u (caddr (cadr combo)))
                 (v (caddr (caddr combo))))
            (dk-cite! 'subset-mem-fwd 'b 'a u)
            (dk-cite! 'subset-mem-fwd 'b 'a v)
            (dk-split! (dk-apply! cle u v t))
            (dk-conj-close! dk-ass!))))))
(km-qed! 'extreme-point-in-subset)

