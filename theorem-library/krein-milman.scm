;;; km-p2.scm -- BA-KM part 2 (helpers continue from km-p1 in the final file)
(define (km-by-prop! goal . facts)
  (if (not (dk-asm? goal))
      (dk-have! goal (lambda () (if (apply dk-only! facts) (prop)))))
  goal)
;;; z in COMPLEMENT-IN(A, B): land (IN z A) and (NOT (IN z B))
(define (km-cout! z A B)
  (let ((iff (dk-cite! 'complement-in-membership A B z)))
    (km-by-prop! (list 'IN z A) iff (list 'IN z (list 'COMPLEMENT-IN A B)))
    (km-by-prop! (list 'NOT (list 'IN z B)) iff (list 'IN z (list 'COMPLEMENT-IN A B)))))
(define (km-cin! z A B)
  (let ((iff (dk-cite! 'complement-in-membership A B z)))
    (km-by-prop! (list 'IN z (list 'COMPLEMENT-IN A B)) iff (list 'IN z A) (list 'NOT (list 'IN z B)))))
(define (km-iout! z A B)
  (let ((iff (dk-cite! 'intersection-membership A B z)))
    (km-by-prop! (list 'IN z A) iff (list 'IN z (list 'INTERSECTION A B)))
    (km-by-prop! (list 'IN z B) iff (list 'IN z (list 'INTERSECTION A B)))))
(define (km-iin! z A B)
  (let ((iff (dk-cite! 'intersection-membership A B z)))
    (km-by-prop! (list 'IN z (list 'INTERSECTION A B)) iff (list 'IN z A) (list 'IN z B))))
;;; (IN z sep) in context: land the domain membership and the condition at z; return the condition
(define (km-sep-out! z sep)
  (let* ((dom (caddr sep)) (v (cadr sep)) (cnd (subst-free v z (cadddr sep))))
    (if (not (dk-asm? (list 'IN z dom)))
        (dk-have! (list 'IN z dom) (lambda () (sep-me (dk-ctx-form (list 'IN z sep))) (dk-split-all!) (dk-ass!))))
    (if (not (dk-asm? cnd))
        (dk-have! cnd (lambda () (sep-me (dk-ctx-form (list 'IN z sep))) (dk-split-all!) (dk-ass!))))
    cnd))
(define (km-sep-dom! z sep)            ; (IN z sep) in context: land (IN z <domain>)
  (let ((dom (caddr sep)))
    (if (not (dk-asm? (list 'IN z dom)))
        (dk-have! (list 'IN z dom) (lambda () (sep-me (dk-ctx-form (list 'IN z sep))) (dk-split-all!) (dk-ass!))))
    (list 'IN z dom)))
(define (km-sep-in! z sep . opt)       ; domain membership in context; the condition in context or by (car opt)
  (dk-have! (list 'IN z sep) (lambda () (in-sep! (lambda () (dk-ass!)) (if (pair? opt) (car opt) (lambda () (dk-ass!)))))))
(define (km-subset! a b body)          ; prove (SUBSET a b): BODY receives the eigenvariable, z in a in context
  (let ((g (list 'SUBSET a b)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (body z)))))
    g))
;;; (IN u (OPENS t)) by top-open-of-local; u subset PTS t in context or provable by SUB!; LOCAL receives x in u and
;;; must land (IN w (OPENS t)), (IN x w), (SUBSET w u) and return w
(define (km-open-local! t u local)
  (let* ((r (dk-cite! 'top-open-of-local t u))
         (loc (cadr r)))
    (dk-have! loc
      (lambda ()
        (let ((x (dk-di-var!))) (local x))))
    (detach! r)
    (dk-ass!)
    (list 'IN u (list 'OPENS t))))

(define (km-ew-close! w) (ew w) (dk-conj-close! dk-ass!))
(define (km-inot! z A B which)         ; (NOT (IN z which)) in context, which = A or B: (NOT (IN z (INTERSECTION A B)))
  (let ((iff (dk-cite! 'intersection-membership A B z)))
    (km-by-prop! (list 'NOT (list 'IN z (list 'INTERSECTION A B))) iff (list 'NOT (list 'IN z which)))))
;;; ---- extremal subset whose points all coincide: its point is an extreme point ----
(sp (make-wff (km-alls '(m f a e) (km-imps '((IS-EXTREMAL-SUBSET m f a)
   (FORALL kmp_ (IMPLIES (IN kmp_ f) (FORALL kmq_ (IMPLIES (IN kmq_ f) (= kmp_ kmq_))))) (IN e f))
   '(IS-EXTREME-POINT m a e)))))
(dk-peel!)
(let* ((pb (km-parts! 'is-extremal-subset '(m f a) '(IS-EXTREMAL-SUBSET m f a)))
       (clb (list-ref pb 3))
       (alleq (dk-ctx-form '(FORALL kmp_ (IMPLIES (IN kmp_ f) (FORALL kmq_ (IMPLIES (IN kmq_ f) (= kmp_ kmq_))))))))
  (mac 'is-extreme-point)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (dk-cite! 'subset-mem-fwd 'f 'a 'e) (dk-ass!))
              (let* ((ld (dk-peel!))
                     (eqx (find-first (lambda (h) (and (dk-head-is? h '=) (eq? (cadr h) 'e))) ld))
                     (combo (caddr eqx))
                     (t (cadr (caddr combo)))
                     (u (caddr (cadr combo)))
                     (v (caddr (caddr combo)))
                     (s (list '- 1 t))
                     (combo2 (list '(VADD m) (list '(ACT m) s u) (list '(ACT m) (list '- 1 s) v))))
                (dk-have! (list 'IN s 'RR) (lambda () (type-term)))
                (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< t 1))))
                (dk-have! (list '< s 1) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< 0 t))))
                (dk-have! (list '= (list '- 1 s) t) (lambda () (crs)))
                (dk-have! (list 'IN combo2 'f)
                  (lambda () (subst (list '= (list '- 1 s) t)) (subst (list '= combo 'e)) (dk-ass!)))
                (dk-split! (dk-apply! clb u v s))
                (dk-apply! alleq u 'e)
                (dk-apply! alleq v 'e)
                (dk-conj-close! dk-ass!)))))))
(km-qed! 'extremal-subset-singleton-extreme)

;;; ---- the intersection of two closed sets is closed ----
(sp (make-wff (km-alls '(t a b) (km-imps '((IS-TOP-SPACE t) (IS-TOP-CLOSED t a) (IS-TOP-CLOSED t b))
   '(IS-TOP-CLOSED t (INTERSECTION a b))))))
(dk-peel!)
(let* ((pa (km-parts! 'is-top-closed '(t a) '(IS-TOP-CLOSED t a)))
       (pb (km-parts! 'is-top-closed '(t b) '(IS-TOP-CLOSED t b)))
       (ab '(INTERSECTION a b))
       (cab (list 'COMPLEMENT-IN '(PTS t) ab)))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'SUBSET)
              (begin (km-subset! ab '(PTS t) (lambda (z) (km-iout! z 'a 'b) (dk-cite! 'subset-mem-fwd 'a '(PTS t) z) (dk-ass!))))
              (begin
                (dk-cite! 'complement-in-subset ab '(PTS t))
                (km-open-local! 't cab
                  (lambda (x)
                    (km-cout! x '(PTS t) ab)
                    (let ((ii (dk-cite! 'intersection-membership 'a 'b x)))
                      (use-em (list 'IN x 'a)
                        (lambda ()
                          (km-by-prop! (list 'NOT (list 'IN x 'b)) ii (list 'IN x 'a) (list 'NOT (list 'IN x ab)))
                          (km-cin! x '(PTS t) 'b)
                          (km-subset! '(COMPLEMENT-IN (PTS t) b) cab
                            (lambda (z) (km-cout! z '(PTS t) 'b) (km-inot! z 'a 'b 'b) (km-cin! z '(PTS t) ab)))
                          (km-ew-close! '(COMPLEMENT-IN (PTS t) b)))
                        (lambda ()
                          (km-cin! x '(PTS t) 'a)
                          (km-subset! '(COMPLEMENT-IN (PTS t) a) cab
                            (lambda (z) (km-cout! z '(PTS t) 'a) (km-inot! z 'a 'b 'a) (km-cin! z '(PTS t) ab)))
                          (km-ew-close! '(COMPLEMENT-IN (PTS t) a)))))))))))))
(km-qed! 'top-closed-intersection)

