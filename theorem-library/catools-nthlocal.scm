;;; catools-nthlocal.scm -- derivatives are local; Cauchy's estimates as the notes state them
;;; (CA-TOOLS, 2026-10-26).  Destination: theorem-library/catools-nthlocal.scm, library complex-analysis.
;;;
;;;   nth-deriv-on-local   f holomorphic on u, V open, V subset u, z in V:
;;;                        nth-deriv-on(CC, V, f|V, k)(z) = nth-deriv-on(CC, u, f, k)(z)
;;;   cauchy-estimates     COROLLARY 3.48 as stated: |f^(k)(a)| <= k! M R^-k, f^(k) = nth-deriv-on(CC, u, f, k)
;;; Proof of the locality: induction on k; at each stage the derivative of the k-th derivative at z is
;;; read on u (holomorphic-on-diff), shrunk to V (diff-on-shrink), and transferred to the k-th
;;; derivative on V, which agrees with it on V by the induction hypothesis (diff-on-transfer-ptwise-eq).
;;; Load window: after scratchpad/ch3a/ch3a-estimates (holomorphic-nth-deriv, cauchy-estimates-on-ball).
;;; Helper prefix nlc-.
;;; ======================================================================
(define nlc-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (nlc-nth u f k) (list 'NTH-DERIV-ON 'CC-NORMED-FIELD u f k))
(define (nlc-holo-fun! u f)
  (let ((hi (dk-cite! 'holomorphic-on u f)))
    (dk-have! (caddr hi) (lambda () (dk-close-if! (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON u f))) prop)))
    (dk-split-all! (list (caddr hi)))))
(define (nlc-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'vv (list 'IMPLIES (list 'IS-OPEN nlc-nf 'vv) (list 'IMPLIES '(SUBSET vv u)
    (list 'FORALL 'z (list 'IMPLIES '(IN z vv)
      (list '= (list (nlc-nth 'vv '(RESTRICT f vv) 'k) 'z) (list (nlc-nth 'u 'f 'k) 'z))))))))))))))
(dk-ni-fixed! '(u f vv))   ; W1D: u, f, vv fixed
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (not (nlc-step-goal? (dk-goal)))
       (let* ((landed (dk-peel!))
              (eq (dk-goal))
              (lhs (car (cadr eq))) (rhs (car (caddr eq)))
              (vv (caddr lhs)) (rf (cadddr lhs)) (u (caddr rhs)) (f (cadddr rhs))
              (z (cadr (cadr eq))))
         (nlc-holo-fun! u f)
         (fact 'subset-mem-fwd vv u z)
         (fact 'fun-apply-type-c f u 'CC z)
         (subst (dk-cite! 'nth-deriv-on-zero 'CC-NORMED-FIELD vv rf))
         (subst (dk-cite! 'nth-deriv-on-zero 'CC-NORMED-FIELD u f))
         (subst (dk-cite! 'restrict-apply f vv z))
         (rfl))
       (let* ((landed (dk-peel!))
              (k (dk-landed-var landed 'NN))
              (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'NTH-DERIV-ON))) landed)))
              (eq (dk-goal))
              (lhs (car (cadr eq))) (rhs (car (caddr eq)))
              (vv (caddr lhs)) (rf (cadddr lhs)) (u (caddr rhs)) (f (cadddr rhs))
              (z (cadr (cadr eq)))
              (G (nlc-nth u f k))
              (g1 (nlc-nth vv rf k))
              (rG (list 'RESTRICT G vv)))
         (fact 'subset-mem-fwd vv u z)
         (dk-cite! 'holomorphic-on-restrict u f vv)
         (dk-cite! 'holomorphic-nth-deriv k vv rf)
         (dk-cite! 'holomorphic-nth-deriv k u f)
         (nlc-holo-fun! vv g1)
         (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff u G) z))))
           (dk-cite! 'diff-on-shrink 'CC-NORMED-FIELD u G z l vv)
           (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ vv) (list '== (list g1 'hbx_) (list rG 'hbx_))))
             (lambda ()
               (let ((w (dk-di-var!)))
                 (dk-apply! ih w)   ; W1D: u, f, vv fixed
                 (subst (dk-cite! 'restrict-apply G vv w))
                 (subst (list '= (list g1 w) (list G w)))
                 (qrfl))))
           (fact 'cc-nf-carr)
           (dk-have! (list 'IN g1 (list 'FUN vv '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
           (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD vv g1 rG z l)
           (dk-cite! 'cc-deriv-on-of-is-diff-on vv g1 z l)
           (dk-cite! 'cc-deriv-on-of-is-diff-on u G z l)
           (fact 'nn-succ-closed k)
           (subst (dk-cite! 'nth-deriv-on-succ-apply 'CC-NORMED-FIELD vv rf k z))
           (subst (dk-cite! 'nth-deriv-on-succ-apply 'CC-NORMED-FIELD u f k z))
           (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD vv g1 z) l))
           (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD u G z) l))
           (rfl)))))
 (dk-open-leaves))
(qed 'nth-deriv-on-local)
(topic! 'nth-deriv-on-local 'analysis)

;;; ======================================================================
;;; COROLLARY 3.48 as the notes state it
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL c (IMPLIES (IN c CC) (FORALL hr (IMPLIES (IN hr RR) (IMPLIES (< 0 hr)
    (IMPLIES (SUBSET (BALL CC-MS c hr) u)
      (FORALL bm (IMPLIES (IN bm RR)
        (IMPLIES (FORALL z (IMPLIES (IN z (BALL CC-MS c hr)) (<= (magnitude (f z)) bm)))
          (FORALL k (IMPLIES (IN k NN)
            (<= (magnitude ((NTH-DERIV-ON CC-NORMED-FIELD u f k) c))
                (* (factorial k) (* bm (power (recip hr) k))))))))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(let ((pi (dk-cite! 'pos-rr 'hr)))
  (dk-have! (caddr pi) (lambda () (dk-conj-close! (lambda () (let ((g (dk-goal))) (cond ((dk-asm? g) (ass)) ((dk-head-is? g '<=) (dk-ineq! '(< 0 hr))) (#t (di) (dk-absurd! '(= 0 hr) '(< 0 hr)))))))))
  (dk-have! '(POS-RR hr) (lambda () (prop))))
(let* ((rho (dk-halve! 'hr))
       (bb (list 'BALL 'CC-MS 'c rho)))
  (dk-have! (list '< rho 'hr) (lambda () (dk-ineq! (list '= (list '+ rho rho) 'hr) (list '< 0 rho))))
  (dk-have! (list '<= rho 'hr) (lambda () (dk-ineq! (list '< rho 'hr))))
  (dk-have! (list 'AND (list 'IN rho 'RR) (list 'AND (list '<= 0 rho) (list 'NOT (list '= 0 rho))))
    (lambda () (dk-conj-close! (lambda () (let ((g (dk-goal))) (cond ((dk-asm? g) (ass)) ((dk-head-is? g '<=) (dk-ineq! (list '< 0 rho))) (#t (di) (dk-absurd! (list '= 0 rho) (list '< 0 rho)))))))))
  (dk-cite! 'ball-is-open 'CC-MS 'c rho)
  (dk-cite! 'cc-ms-open-iff bb)
  (dk-have! (list 'IS-OPEN nlc-nf bb) (lambda () (prop)))
  (dk-cite! 'cc-ms-ball-mono 'c rho 'hr)
  (fact 'subset-trans bb '(BALL CC-MS c hr) 'u)
  (dk-cite! 'cc-ms-ball-centre 'c rho)
  (let* ((est (dk-cite! 'cauchy-estimates-on-ball 'u 'f 'c 'hr 'bm rho 'k))
         (loc (dk-cite! 'nth-deriv-on-local 'k 'u 'f bb 'c)))
    (dk-rewrite-h! est (list (nlc-nth bb (list 'RESTRICT 'f bb) 'k) 'c) (list (nlc-nth 'u 'f 'k) 'c))
    (ass)))
(qed 'cauchy-estimates)
(topic! 'cauchy-estimates 'analysis)
