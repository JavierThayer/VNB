           (b1 (dk-rewrite-h! b0 (list bdl-e g) (list g 'x)))
           (dvg (begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-norm-value-proven 'm g)))
           (b2 (dk-rewrite-h! b1 (list (list 'VNRM bdl-D) g) ng))
