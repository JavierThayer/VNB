(define bdl-D  '(DUAL m))
(define bdl-DV '(DUAL-VEC m))
(define (bdl-ev x) (list 'BIDUAL-EVAL 'm x))
(define bdl-e (bdl-ev 'x))
;; (IN (f y) RR) for f a member of DUAL-VEC(m), y in VEC m
(define (bdl-app! f y)
  (let ((ty (list 'IN (list f y) 'RR)))
    (if (not (dk-asm? ty))
        (begin (if (not (dk-asm? (list 'IN f (list 'FUN bdl-V 'RR)))) (dk-cite! 'dual-vec-fun 'm f))
               (dk-cite! 'fun-apply-type-c f bdl-V 'RR y)))
    ty))
(define (bdl-type-atoms! y)
  (let walk ((e (dk-goal)))
    (cond ((and (pair? e) (= (length e) 2) (symbol? (car e)) (equal? (cadr e) y)
                (dk-asm? (list 'IN (car e) bdl-DV)))
           (bdl-app! (car e) y))
          ((pair? e) (for-each walk e)))))

(sp (make-wff (forall-guarded '(m x f) (list '(IS-NORMED-VECTOR-SPACE m) '(IN x (VEC m)) (list 'IN 'f bdl-DV))
                              (list '= (list bdl-e 'f) '(f x)))))
(dk-peel!)
(mac 'BIDUAL-EVAL)
(dk-lam-b!)
(bdl-app! 'f 'x)
(rfl)
(bdl-qed! 'bidual-eval-apply)

(sp (make-wff (forall-guarded '(m x) (list '(IS-NORMED-VECTOR-SPACE m) '(IN x (VEC m)))
                              (list 'IN bdl-e (list 'FUN bdl-DV 'RR)))))
(dk-peel!)
(dk-cite! 'dual-vec-in-set 'm)
(mac 'BIDUAL-EVAL)
(dk-lam-type! (lambda () (let ((v (dk-di-var!))) (bdl-app! v 'x) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
              (lambda () (ass)))
(bdl-qed! 'bidual-eval-fun)

;;; the vectors of DUAL(m) a term denotes, typed
(define (bdl-dop? t h) (and (pair? t) (equal? (car t) (list h bdl-D))))
(define (bdl-dv! t)
  (let ((ty (list 'IN t bdl-DV)))
    (cond ((dk-asm? ty) ty)
          ((bdl-dop? t 'VADD) (bdl-dv! (cadr t)) (bdl-dv! (caddr t)) (dk-cite! 'dual-vadd-in-dual 'm (cadr t) (caddr t)) ty)
          ((bdl-dop? t 'ACT) (bdl-real! (cadr t)) (bdl-dv! (caddr t)) (dk-cite! 'dual-act-in-dual 'm (cadr t) (caddr t)) ty)
          (#t (error "bdl-dv!: no typing for" t)))))
;;; rewrite every (BIDUAL-EVAL(m, x) T), then every ((VADD/ACT (DUAL m)) ..)(x), in the goal
(define (bdl-eval! x)
  (let loop ((k 0))
    (let ((hit (dnv-find-b (lambda (e) (and (pair? e) (= (length e) 2) (equal? (car e) (bdl-ev x)))) (dk-goal))))
      (if (and hit (< k 20))
          (begin (bdl-dv! (cadr hit)) (subst (dk-cite! 'bidual-eval-apply 'm x (cadr hit))) (loop (+ k 1))))))
  (let loop ((k 0))
    (let ((hit (dnv-find-b (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) x)
                                            (or (bdl-dop? (car e) 'VADD) (bdl-dop? (car e) 'ACT))))
                           (dk-goal))))
      (if (and hit (< k 20))
          (let ((f (car hit)))
            (subst (if (bdl-dop? f 'VADD)
                       (begin (bdl-dv! (cadr f)) (bdl-dv! (caddr f)) (dk-cite! 'dual-vadd-apply 'm (cadr f) (caddr f) x))
                       (begin (bdl-real! (cadr f)) (bdl-dv! (caddr f)) (dk-cite! 'dual-act-apply 'm (cadr f) (caddr f) x))))
            (loop (+ k 1)))))))
(define (dnv-find-b pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((dnv-find-b pred (car l))) (#t (loop (cdr l))))))
        (#t #f)))

(sp (make-wff (forall-guarded '(m x) (list '(IS-NORMED-VECTOR-SPACE m) '(IN x (VEC m)))
                              (list 'IS-LINEAR-FUNCTIONAL bdl-D bdl-e))))
(dk-peel!)
(begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-carrier-proven 'm))
(mac 'is-linear-functional)
(subst (list '= (list 'VEC bdl-D) bdl-DV))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-head-is? (dk-goal) 'IN)
        (begin (dk-cite! 'bidual-eval-fun 'm 'x) (ass))
        (begin
          (dk-peel!)
          (bdl-eval! 'x)
          (bdl-type-atoms! 'x)
          (let ((g (dk-goal))) (if (equal? (cadr g) (caddr g)) (rfl) (crs))))))
  (dk-open-leaves))
(bdl-qed! 'bidual-eval-linear)

(define bdl-nx '((VNRM m) x))
(sp (make-wff (forall-guarded '(m x) (list '(IS-NORMED-VECTOR-SPACE m) '(IN x (VEC m)))
   (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (list 'VEC bdl-D))
     (list '<= (list 'abs (list bdl-e 'w)) (list '* bdl-nx (list (list 'VNRM bdl-D) 'w))))))))
(dk-peel!)
(begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-carrier-proven 'm))
(dk-have! (list 'IN 'w bdl-DV) (lambda () (subst (list '= bdl-DV (list 'VEC bdl-D))) (ass)))
(subst (dk-cite! 'bidual-eval-apply 'm 'x 'w))
(begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-norm-value-proven 'm 'w))
(subst (list '= (list (list 'VNRM bdl-D) 'w) (list 'DUAL-NORM 'm 'w)))
(dk-cite! 'dual-vec-blf 'm 'w)
(dk-split! (dk-cite! 'dual-norm-nonneg-nvs 'm 'w))
(bdl-real! bdl-nx)
(bdl-app! 'w 'x)
(dk-cite! 'dual-norm-is-bound-nvs 'm 'w 'x)
(subst (bdl-eq! (list '* bdl-nx '(DUAL-NORM m w)) (list '* '(DUAL-NORM m w) bdl-nx)))
(ass)
(bdl-qed! 'bidual-eval-bound)

(define bdl-D2 '(DUAL (DUAL m)))
(define (bdl-nvs2!)
  (dk-cite! 'dual-is-normed-vector-space 'm)
  (begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-carrier-proven 'm))
  (begin (dk-cite! 'dual-vec-in-set bdl-D) (dk-cite! 'dual-carrier-proven bdl-D)))

(sp (make-wff (forall-guarded '(m x) (list '(IS-NORMED-VECTOR-SPACE m) '(IN x (VEC m)))
                              (list 'IN bdl-e (list 'VEC bdl-D2)))))
(dk-peel!)
(bdl-nvs2!)
(subst (list '= (list 'VEC bdl-D2) (list 'DUAL-VEC bdl-D)))
(dk-cite! 'bidual-eval-fun 'm 'x)
(dk-have! (list 'IN bdl-e (list 'FUN (list 'VEC bdl-D) 'RR))
  (lambda () (subst (list '= (list 'VEC bdl-D) bdl-DV)) (ass)))
(dk-cite! 'bidual-eval-linear 'm 'x)
