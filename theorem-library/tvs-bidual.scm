;;; the canonical map is linear
(define (bdl-ext-close!)
  ;; goal (= L R), both vectors of DUAL(DUAL(m)), functions on DUAL-VEC(m)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (dk-fun-ext! l r bdl-DV 'RR #f #f
      (lambda (v)
        (dk-have! (list 'IN v (list 'VEC bdl-D)) (lambda () (subst (list '= (list 'VEC bdl-D) bdl-DV)) (ass)))
        (let loop ((k 0))
          (let ((hit (dnv-find-b (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) v)
                                                  (pair? (car e))
                                                  (member (car (car e)) (list (list 'VADD bdl-D2) (list 'ACT bdl-D2)))))
                                 (dk-goal))))
            (if (and hit (< k 10))
                (let ((f (car hit)))
                  (subst (if (equal? (car f) (list 'VADD bdl-D2))
                             (dk-cite! 'dual-vadd-apply bdl-D (cadr f) (caddr f) v)
                             (dk-cite! 'dual-act-apply bdl-D (cadr f) (caddr f) v)))
                  (loop (+ k 1))))))
        (let loop ((k 0))
          (let ((hit (dnv-find-b (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) v)
                                                  (dk-head-is? (car e) 'BIDUAL-EVAL)))
                                 (dk-goal))))
            (if (and hit (< k 10))
                (let ((y (caddr (car hit))))
                  (subst (dk-cite! 'bidual-eval-apply 'm y v))
                  (loop (+ k 1))))))
        (let loop ((k 0))
          (let ((hit (dnv-find-b (lambda (e) (and (pair? e) (= (length e) 2) (equal? (car e) v) (pair? (cadr e))
                                                  (member (car (cadr e)) '((VADD m) (ACT m)))))
                                 (dk-goal))))
            (if (and hit (< k 10))
                (let ((arg (cadr hit)))
                  (subst (if (equal? (car arg) '(VADD m))
                             (dk-cite! 'dual-vec-additive 'm v (cadr arg) (caddr arg))
                             (dk-cite! 'dual-vec-homogeneous 'm v (cadr arg) (caddr arg))))
                  (loop (+ k 1))))))
        (bdl-app! v 'x)
        (if (dk-asm? '(IN y (VEC m))) (bdl-app! v 'y))
        (let ((g2 (dk-goal))) (if (equal? (cadr g2) (caddr g2)) (rfl) (crs)))))))
(define (bdl-fun2! t)
  ;; (IN t (FUN (DUAL-VEC m) RR)) for t a vector of DUAL(DUAL(m))
  (dk-cite! 'dual-vec-fun bdl-D t)
  (dk-have! (list 'IN t (list 'FUN bdl-DV 'RR))
    (lambda () (subst (list '= bdl-DV (list 'VEC bdl-D))) (ass))))

