;;; bidual.scm -- topological-vector-space.pdf Prop 3.31: for a normed space E the canonical map
;;; iota_E : E -> E** is an isometry.  Agent DUAL-FIX, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-bidual.scm.  Library: analysis.  Helper prefix: bdl-.
;;;
;;; (1) norming-functional-exists: every x of a real normed space has a bounded linear functional
;;;     g with DUAL-NORM(g) <= 1 and g(x) = ||x||.  The notes cite Hahn-Banach; the library's
;;;     norm-attained-by-functional carries IS-FINITE-DIMENSIONAL, which is not needed: the seed
;;;     functional on LINE(m, x) (line-functional-exists) is dominated by the norm, which is
;;;     sublinear, and hbs-hahn-banach-sublinear (Zorn) extends it to the whole space, through
;;;     the module view NORMED-VECTOR-SPACE-AS-MODULE(m).
;;; (2) The canonical map: BIDUAL-EVAL(m, x) = (f |-> f(x)) is a vector of DUAL(DUAL(m)), the map
;;;     x |-> BIDUAL-EVAL(m, x) is additive and homogeneous, and its norm is ||x|| (<= by
;;;     |f(x)| <= ||f|| ||x||, >= at the norming functional).

(define (bdl-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; BDL OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (bdl-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (bdl-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (bdl-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((eqv? t 0) (dk-cite! 'rr-zero-in) ty)
          ((eqv? t 1) (dk-cite! 'rr-one-in) ty)
          ((and (pair? t) (equal? (car t) '(VNRM m))) (dk-cite! 'vnrm-real 'm (cadr t)) ty)
          ((dk-head-is? t 'abs) (bdl-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (bdl-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (bdl-real! (cadr t)) (bdl-real! (caddr t))
           (bdl-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))

(define bdl-V '(VEC m))
(define bdl-mv '(NORMED-VECTOR-SPACE-AS-MODULE m))
(define bdl-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define bdl-p '(VNRM m))
(define (bdl-n x) (list '(VNRM m) x))

;;; a <= b <= c <= d over RR
(sp (make-wff (forall-guarded '(a b c d) '((IN a RR) (IN b RR) (IN c RR) (IN d RR) (<= a b) (<= b c) (<= c d))
                              '(<= a d))))
(dk-peel!)
(dk-ineq! '(<= a b) '(<= b c) '(<= c d) '(IN a RR) '(IN b RR) '(IN c RR) '(IN d RR))
(bdl-qed! 'bidual-rr-le-chain)

;;; =====================================================================
;;; (1) THE NORMING FUNCTIONAL
;;; =====================================================================

(define (bdl-split-goal!)   ; split the AND goals of THIS proof, return the leaves
  (let loop ((k 0))
    (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
      (if (and l (< k 20)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
  (dk-open-leaves))

;; the norm is sublinear, read on the module view
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (list 'IS-SUBLINEAR bdl-mv bdl-p)))))
(dk-peel!)
(for-each (lambda (n) (dk-cite! n 'm)) '(nvs-module-view-vec nvs-module-view-vadd nvs-module-view-act))
(dk-project! (list 'IN bdl-p (list 'FUN bdl-V 'RR)) 'is-normed-vector-space '(IS-NORMED-VECTOR-SPACE m))
(mac 'is-sublinear)
(subst (list '= (list 'VEC bdl-mv) bdl-V))
(subst (list '= (list 'VADD bdl-mv) '(VADD m)))
(subst (list '= (list 'ACT bdl-mv) '(ACT m)))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-head-is? (dk-goal) 'IN)
        (ass)
        (begin
          (dk-peel!)
          (let ((g2 (dk-goal)))
            (if (dk-head-is? g2 '<=)
                (let ((a (cadr (cadr (cadr g2)))) (b (caddr (cadr (cadr g2)))))
                  (dk-cite! 'nvs-vnrm-triangle 'm a b) (ass))
                (let* ((arg (cadr (cadr g2))) (t (cadr arg)) (y (caddr arg)))
                  (subst (dk-cite! 'nvs-vnrm-homog 'm t y))
                  (subst (dk-cite! 'rr-abs-of-nonneg t))
                  (bdl-real! (bdl-n y))
                  (rfl)))))))
  (bdl-split-goal!))
(bdl-qed! 'bidual-norm-sublinear-view)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (list '= (list 'SCAL bdl-mv) bdl-ring)))))
(dk-peel!)
(dk-cite! 'nvs-module-view-scal 'm)
(dk-project! (list '= '(SCAL m) bdl-ring) 'is-normed-vector-space '(IS-NORMED-VECTOR-SPACE m))
(subst (list '= (list 'SCAL bdl-mv) '(SCAL m)))
(ass)
(bdl-qed! 'bidual-view-scal)

;; linear on a subspace of m  =>  linear on it, read on the module view
(sp (make-wff (forall-guarded '(m s f) '((IS-NORMED-VECTOR-SPACE m) (IS-LINEAR-FUNCTIONAL-ON m s f))
                              (list 'IS-LINEAR-FUNCTIONAL-ON bdl-mv 's 'f))))
(dk-peel!)
(for-each (lambda (n) (dk-cite! n 'm)) '(nvs-module-view-vadd nvs-module-view-act))
(mac 'is-linear-functional-on)
(subst (list '= (list 'VADD bdl-mv) '(VADD m)))
(subst (list '= (list 'ACT bdl-mv) '(ACT m)))
(mac-h 'is-linear-functional-on '(IS-LINEAR-FUNCTIONAL-ON m s f))
(ass)
(bdl-qed! 'bidual-lf-on-to-view)

;; linear on the whole view  =>  a linear functional of m
(sp (make-wff (forall-guarded '(m f) (list '(IS-NORMED-VECTOR-SPACE m) (list 'IS-LINEAR-FUNCTIONAL-ON bdl-mv bdl-V 'f))
                              '(IS-LINEAR-FUNCTIONAL m f))))
(dk-peel!)
(for-each (lambda (n) (dk-cite! n 'm)) '(nvs-module-view-vadd nvs-module-view-act))
(mac 'is-linear-functional)
(subst (list '= '(VADD m) (list 'VADD bdl-mv)))
(subst (list '= '(ACT m) (list 'ACT bdl-mv)))
(mac-h 'is-linear-functional-on (list 'IS-LINEAR-FUNCTIONAL-ON bdl-mv bdl-V 'f))
(ass)
(bdl-qed! 'bidual-lf-from-view)

;; the seed on LINE(m, x) is dominated by the norm
(sp (make-wff (forall-guarded '(m v f) (list '(IS-NORMED-VECTOR-SPACE m) '(IN v (VEC m))
                                             '(IS-BOUNDED-LINEAR-FUNCTIONAL-ON m (LINE m v) f)
                                             '(<= (DUAL-NORM-ON m (LINE m v) f) 1))
   '(FORALL z_ (IMPLIES (IN z_ (LINE m v)) (<= (f z_) ((VNRM m) z_)))))))
(dk-peel!)
(let* ((z (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(LINE m v)))) (dk-asms)))))
       (c '(DUAL-NORM-ON m (LINE m v) f))
       (fz (list 'f z)) (afz (list 'abs fz)) (nz (bdl-n z)))
  (dk-cite! 'lfe-line-in-vec 'm 'v z)
  (dk-cite! 'lfe-line-subset 'm 'v)
  (dk-project! '(IS-LINEAR-FUNCTIONAL-ON m (LINE m v) f) 'is-bounded-linear-functional-on
               '(IS-BOUNDED-LINEAR-FUNCTIONAL-ON m (LINE m v) f))
  (dk-project! '(IN f (FUN (LINE m v) RR)) 'is-linear-functional-on '(IS-LINEAR-FUNCTIONAL-ON m (LINE m v) f))
  (dk-cite! 'fun-apply-type-c 'f '(LINE m v) 'RR z)
  (bdl-real! afz) (bdl-real! nz) (bdl-real! 1)
  (dk-split! (dk-cite! 'dual-norm-on-nonneg-nvs 'm '(LINE m v) 'f))
  (dk-cite! 'vnrm-nonneg 'm z)
  (let* ((b (dk-cite! 'dual-norm-on-is-bound-nvs 'm '(LINE m v) 'f z))
         (h (dk-cite! 'rr-mul-le-right c 1 nz))
         (e (bdl-eq! (list '* 1 nz) nz))
         (h2 (dk-rewrite-h! h (list '* 1 nz) nz))
         (cn (list '* c nz)))
    (bdl-real! cn)
    (dk-have! (list '<= afz afz) (lambda () (dk-ineq! (list 'IN afz 'RR))))
    (dk-split! (dk-cite! 'rr-abs-le-parts fz afz))
    (dk-cite! 'bidual-rr-le-chain fz afz cn nz)
    (ass)))
(bdl-qed! 'bidual-line-seed-dominated)

;; g <= norm everywhere  =>  |g| <= 1 * norm
(sp (make-wff (forall-guarded '(m g) (list '(IS-NORMED-VECTOR-SPACE m) '(IS-LINEAR-FUNCTIONAL m g)
                                           '(FORALL w_ (IMPLIES (IN w_ (VEC m)) (<= (g w_) ((VNRM m) w_)))))
   '(FORALL w (IMPLIES (IN w (VEC m)) (<= (abs (g w)) (* 1 ((VNRM m) w))))))))
(dk-peel!)
(let* ((ub '(FORALL w_ (IMPLIES (IN w_ (VEC m)) (<= (g w_) ((VNRM m) w_)))))
       (w 'w) (m1 '(- 1)) (w2 (list '(ACT m) m1 w))
       (gw (list 'g w)) (nw (bdl-n w)))
  (dk-project! '(IN g (FUN (VEC m) RR)) 'is-linear-functional '(IS-LINEAR-FUNCTIONAL m g))
  (dk-project! '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (= (g ((ACT m) r_ x_)) (* r_ (g x_)))))))
               'is-linear-functional '(IS-LINEAR-FUNCTIONAL m g))
  (bdl-real! m1)
  (dk-cite! 'nvs-act-in-vec 'm m1 w)
  (dk-cite! 'fun-apply-type-c 'g '(VEC m) 'RR w)
  (bdl-real! nw)
  (let* ((u1 (dk-apply! ub w))
         (u2 (dk-apply! ub w2))
         (hg (dk-apply! '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (= (g ((ACT m) r_ x_)) (* r_ (g x_))))))) m1 w))
         (hn (dk-cite! 'nvs-vnrm-homog 'm m1 w))
         (ea (dk-cite! 'rr-abs-neg 1))
         (e1 (begin (dk-have! '(<= 0 1) (lambda () (dk-ineq!))) (dk-cite! 'rr-abs-of-nonneg 1)))
         (u3 (dk-rewrite-h! u2 (list 'g w2) (list '* m1 gw)))
         (u4 (dk-rewrite-h! u3 (bdl-n w2) (list '* (list 'abs m1) nw)))
         (u5 (dk-rewrite-h! u4 (list 'abs m1) '(abs 1)))
         (u6 (dk-rewrite-h! u5 '(abs 1) 1))
         (c (list '* 1 nw)))
    (bdl-real! c)
    (dk-have! (list '<= (list '- c) gw) (lambda () (dk-ineq! u6 (list 'IN gw 'RR) (list 'IN nw 'RR))))
    (dk-have! (list '<= gw c) (lambda () (dk-ineq! u1 (list 'IN gw 'RR) (list 'IN nw 'RR))))
    (dk-cite! 'rr-abs-le-of-parts gw c)
    (ass)))
(bdl-qed! 'bidual-two-sided-bound)

(sp (make-wff '(FORALL m (FORALL x (IMPLIES (IS-NORMED-VECTOR-SPACE m) (IMPLIES (IN x (VEC m))
   (FORSOME g (AND (IS-BOUNDED-LINEAR-FUNCTIONAL m g)
              (AND (<= (DUAL-NORM m g) 1) (= (g x) ((VNRM m) x)))))))))))
(dk-peel!)
(let* ((f0 (dk-skolem! (dk-cite! 'line-functional-exists 'm 'x)))
       (lx '(LINE m x)))
  (dk-cite! 'normed-vector-space-as-module-is-module 'm)
  (dk-cite! 'bidual-view-scal 'm)
  (dk-cite! 'bidual-norm-sublinear-view 'm)
  (dk-cite! 'line-is-submodule 'm 'x)
  (dk-cite! 'submodule-nvs-module-view 'm lx)
  (dk-project! (list 'IS-LINEAR-FUNCTIONAL-ON 'm lx f0) 'is-bounded-linear-functional-on
               (list 'IS-BOUNDED-LINEAR-FUNCTIONAL-ON 'm lx f0))
  (dk-cite! 'bidual-lf-on-to-view 'm lx f0)
  (dk-cite! 'bidual-line-seed-dominated 'm 'x f0)
  (let* ((ff (dk-skolem! (dk-cite! 'hbs-hahn-banach-sublinear bdl-mv bdl-p lx f0)))
         (ve (dk-cite! 'nvs-module-view-vec 'm))
         (lfv (dk-ctx-form (list 'IS-LINEAR-FUNCTIONAL-ON bdl-mv (list 'VEC bdl-mv) ff)))
         (lfv2 (dk-rewrite-h! lfv (list 'VEC bdl-mv) bdl-V))
         (ubv (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC bdl-mv)) (list '<= (list ff 'x_) (list bdl-p 'x_))))))
         (ubv2 (dk-rewrite-h! ubv (list 'VEC bdl-mv) bdl-V)))
    (dk-cite! 'bidual-lf-from-view 'm ff)
    (dk-cite! 'bidual-two-sided-bound 'm ff)
    (dk-project! (list 'IN ff (list 'FUN bdl-V 'RR)) 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff))
    (bdl-real! 1)
    (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (dk-have! (list 'IS-BOUNDED-LINEAR-FUNCTIONAL 'm ff)
      (lambda ()
        (mac 'is-bounded-linear-functional)
        (for-each (lambda (l)
                    (dk-focus! l)
                    (if (dk-head-is? (dk-goal) 'FORSOME)
                        (begin (ew 1) (dk-conj-close! (lambda () (ass))))
                        (ass)))
                  (dk-opened (lambda () (di))))))
    (dk-cite! 'dual-norm-le-bound-nvs 'm ff 1)
    (dk-cite! 'line-has-v 'm 'x)
    (let ((ext (dk-ctx-form (list 'EXTENDS-ON lx ff f0))))
      (dk-have! (list '= (list ff 'x) (list f0 'x))
        (lambda ()
          (mac-h 'extends-on ext)
          (dk-apply! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ lx) (list '= (list ff 'x_) (list f0 'x_)))) 'x)
          (ass))))
    (dk-cite! 'fun-apply-type-c ff bdl-V 'RR 'x)
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin (subst (list '= (list ff 'x) (list f0 'x))) (ass)))))))
(bdl-qed! 'norming-functional-exists)

