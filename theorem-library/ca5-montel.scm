;;; Montel itself
(define ca5-A '(IMAGE s NN))
;; equicontinuity of t on set, with binders no statement uses (the eigenvariables of the
;; enclosing proof are named k, eps, i, j, z)
(define (ca5-equi-on2 set t)
  (list 'FORALL 'cmx_ (list 'IMPLIES (list 'IN 'cmx_ set) (list 'FORALL 'cme_ (list 'IMPLIES '(POS-RR cme_)
    (list 'FORSOME 'cmd_ (list 'AND '(POS-RR cmd_)
      (list 'FORALL 'cmi_ (list 'IMPLIES '(IN cmi_ NN) (list 'FORALL 'cmy_ (list 'IMPLIES (list 'IN 'cmy_ set)
        (list 'IMPLIES '(< (magnitude (- cmy_ cmx_)) cmd_)
          (list '< (list 'magnitude (list '- (list (list t 'cmi_) 'cmy_) (list (list t 'cmi_) 'cmx_))) 'cme_)))))))))))))
(define (ca5-ucauchy-of t) (ca5x-subst-sym ca5-ucauchy 's t))
(define (ca5x-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (ca5x-subst-sym (car e) from to) (ca5x-subst-sym (cdr e) from to)))
        (#t e)))
;; k in NN: land (s k) in IMAGE(s, NN)
(define (ca5-in-image! k)
  (let* ((w (list 's k)) (ii (dk-cite! 'image-membership-iff 's 'NN w)) (rhs (caddr ii)))
    (fact 'fun-apply-type-c 's 'NN ca5-H k)
