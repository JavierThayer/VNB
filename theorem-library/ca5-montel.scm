    (dk-have! (caddr rhs) (lambda () (ew k) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
    (dk-have! rhs (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-have! (list 'IN w ca5-A) (lambda () (dk-only! ii rhs) (prop)))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca5-H)) (list 'IMPLIES (list 'CC-HOL-BOUNDED 'u ca5-A)
    (list 'FORSOME 'phi (list 'AND '(STRICTLY-MONO-NN phi) (ca5-ucauchy-of '(SUBSEQ s phi)))))))))))
