;; pointwise bounds on u
(let* ((bi (dk-cite! 'cc-hol-bounded 'u ca5-A)) (brhs (caddr bi)))
  (dk-have! brhs (lambda () (dk-only! bi (list 'CC-HOL-BOUNDED 'u ca5-A)) (prop)))
