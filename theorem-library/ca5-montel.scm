                ;; the uniform Cauchy property on jset, and on K_n inside it
                (let* ((uc (dk-cite! 'cc-unif-cauchy-on-compact jset dq t))
                       (cap (dk-skolem! (ca5-apply! uc ev))))
                  (dk-split-all!)
                  (ew cap)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
