(define ca5-bcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'chm_))) "the bound clause"))
(dk-have! '(FORALL z (IMPLIES (IN z u) (FORSOME bd (AND (IN bd RR) (FORALL k (IMPLIES (IN k NN) (<= (magnitude ((s k) z)) bd)))))))
  (lambda ()
    (let* ((z (dk-di-var!))
           (m (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u z)))
