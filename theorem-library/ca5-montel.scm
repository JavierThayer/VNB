                ;; convergence at the dense points of jset
                (dk-have! (list 'FORALL 'cmj_ (list 'IMPLIES '(IN cmj_ NN)
                            (list 'FORSOME 'cml_ (list 'AND '(IN cml_ CC)
                              (list 'CONVERGES-TO 'CC-MS (list 'VNB-LAMBDA 'cmk_ 'NN (list (list t 'cmk_) (list dq 'cmj_))) 'cml_)))))
                  (lambda ()
                    (let* ((j (dk-di-var!))
                           (m (list 'nnpair n j))
