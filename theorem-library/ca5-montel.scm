;;; ======================================================================
;;; (4) a coordinate (real or imaginary part) of an equicontinuous family on a compact K,
;;;     convergent at the points of a dense sequence of K, is uniformly Cauchy on K
;;;     (the tree's equicont-dense-conv-implies-unif-cauchy, rake-ascoli, on SUBSPACE-MS(CC-MS, K))
;;; ======================================================================
;;; dk-apply! that tolerates instances (final or intermediate) already in context: walk the
;;; instantiation, remember the deepest stage the context holds, and dk-apply! from there
(define (ca5-strip-imps g)
  (if (and (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g))) (ca5-strip-imps (caddr g)) g))
(define (ca5-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms) (best f) (rest terms))
    (let* ((g1 (ca5-strip-imps g))
           (here (and (not (eq? g (->raw-formula f))) (dk-ctx-form g1)))
           (best2 (if here here best))
           (rest2 (if here ts rest)))
      (cond ((null? ts)
             (or (dk-ctx-form g1)
                 (if (null? rest2) best2 (apply dk-apply! best2 rest2))))
            ((and (pair? g1) (eq? (car g1) 'FORALL))
             (loop (subst-free (cadr g1) (car ts) (caddr g1)) (cdr ts) best2 rest2))
            (#t (apply dk-apply! best2 rest2))))))
(define ca5-SK '(SUBSPACE-MS CC-MS kk))
(define (ca5-equi-on set)            ; equicontinuity of t at every point of set, inside set
  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x set) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'del (list 'AND '(POS-RR del)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y set)
        '(IMPLIES (< (magnitude (- y x)) del) (< (magnitude (- ((t k) y) ((t k) x))) eps)))))))))))))
(define (ca5-coord-stmt part)
  (list 'FORALL 'kk (list 'IMPLIES '(SUBSET kk CC) (list 'IMPLIES (list 'IS-COMPACT ca5-SK)
  (list 'FORALL 'dq (list 'IMPLIES (list 'IS-DENSE-SEQ ca5-SK 'dq)
  (list 'FORALL 't (list 'IMPLIES '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z kk) (IN ((t k) z) CC)))))
    (list 'IMPLIES (ca5-equi-on 'kk)
    (list 'IMPLIES (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
                     (list 'FORSOME 'lm (list 'AND '(IN lm RR)
                       (list 'CONVERGES-TO 'RR-MS (list 'VNB-LAMBDA 'cmk_ 'NN (list part '((t cmk_) (dq j)))) 'lm)))))
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
        (list 'FORSOME 'cap (list 'AND '(IN cap NN)
          (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES '(<= cap i)
            (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(<= cap j)
              (list 'FORALL 'z (list 'IMPLIES '(IN z kk)
                (list '< (list 'abs (list '- (list part '((t i) z)) (list part '((t j) z)))) 'eps)))))))))))))))))))))))

(define (ca5-coord-proof! part name)
  (sp (make-wff (ca5-coord-stmt part)))
  (dk-peel!)
  (fact 'cc-is-metric-space) (ca5v-pts-cc!)
  (fact 'rr-is-metric-space)
  (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'kk 'CC)
  (dk-have! '(SUBSET kk (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (fact 'subspace-is-metric-space 'CC-MS 'kk)
  (fact 'subspace-pts 'CC-MS 'kk)
  (let* ((hty (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(IN ((t k) z) CC)))) "the typing"))
         (heq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'del))) "the equicontinuity"))
         (hcv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CONVERGES-TO))) "the convergence"))
         (lam (list 'VNB-LAMBDA 'cmk_ 'NN (list 'VNB-LAMBDA 'cmz_ 'kk (list part '((t cmk_) cmz_)))))
         (ptl (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr))
         (dle (if (eq? part 'real-part) 'cc-re-dist-le 'cc-im-dist-le)))
    (define (tval! k z) (ca5-apply! hty k z))
    (dk-have! (list 'IN lam '(FUN NN (FUN kk RR)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((k (dk-di-var!)))
              (dk-lam-type!
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (let ((leaf (proof-state-focus *ps*))) (tval! k z) (fact ptl (list (list 't k) z)) (if (not (sequent-node-grounded? leaf)) (ass)))))))))))
    (let* ((fv (dk-name! lam '(FUN NN (FUN kk RR)))))
      ;; the values of fv
      (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'z (list 'IMPLIES '(IN z kk)
                  (list '= (list (list fv 'k) 'z) (list part '((t k) z)))))))
        (lambda ()
          (let* ((lk (dk-peel!))
                 (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                 (z (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'kk))) lk)))))
            (tval! k z) (fact ptl (list (list 't k) z))
            (subst (list '= fv lam))
            (if (dk--redex? (dk-goal)) (dk-lam-b!))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      (let* ((fval (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'z (list 'IMPLIES '(IN z kk)
                  (list '= (list (list fv 'k) 'z) (list part '((t k) z))))))))))
        (define (fv-at! k z) (ca5-apply! fval k z))
        (dk-have! (list 'IN fv (list 'FUN 'NN (list 'FUN (list 'PTS ca5-SK) 'RR)))
          (lambda () (subst (list '== (list 'PTS ca5-SK) 'kk)) (ass)))
        (dk-have! (list 'IN fv (list 'FUN 'NN (list 'FUN (list 'PTS ca5-SK) '(PTS RR-MS))))
          (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
        ;; equicontinuity of fv on S
        (let* ((eiff (dk-cite! 'is-equicontinuous ca5-SK 'RR-MS fv)) (erhs (caddr eiff)))
          (dk-have! erhs
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((lk (dk-peel!))
                             (x (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'PTS))) lk))))
                             (ev (cadr (car (filter (dk-head? 'POS-RR) lk)))))
                        (dk-have! (list 'IN x 'kk) (lambda () (subst (list '== 'kk (list 'PTS ca5-SK))) (ass)))
                        (let* ((dl (dk-skolem! (dk-apply! heq x ev))))
                          (dk-split-all!)
                          (ew dl)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (let* ((lk2 (dk-peel!))
                                         (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk2))))
                                         (y (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'PTS))) lk2))))
                                         (tx (list (list 't k) x)) (ty (list (list 't k) y)))
                                    (dk-have! (list 'IN y 'kk) (lambda () (subst (list '== 'kk (list 'PTS ca5-SK))) (ass)))
                                    (fact 'subset-mem-fwd 'kk 'CC x) (fact 'subset-mem-fwd 'kk 'CC y)
                                    (tval! k x) (tval! k y)
                                    (fact 'subspace-dist 'CC-MS 'kk x y)
                                    (fact 'cc-ms-dist x y)
                                    (ca5v-rr! (list 'magnitude (list '- x y))) (ca5v-rr! (list 'magnitude (list '- y x)))
                                    (dk-cite! 'cc-magnitude-sub-sym x y)
                                    (let ((hd (list '< (list (list 'DIST ca5-SK) x y) dl)))
                                      (dk-rewrite-h! hd (list (list 'DIST ca5-SK) x y) (list '(DIST CC-MS) x y))
                                      (dk-rewrite-h! (list '< (list '(DIST CC-MS) x y) dl) (list '(DIST CC-MS) x y) (list 'magnitude (list '- x y))))
                                    (fact 'rr-pos-rr-in-rr dl)
                                    (dk-have! (list '< (list 'magnitude (list '- y x)) dl)
                                      (lambda () (dk-ineq! (list '< (list 'magnitude (list '- x y)) dl)
                                                           (list '= (list 'magnitude (list '- x y)) (list 'magnitude (list '- y x))))))
                                    (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm dl))) "the del clause") k y)
                                    (fv-at! k x) (fv-at! k y)
                                    (fact ptl tx) (fact ptl ty)
                                    (subst (list '= (list (list fv k) x) (list part tx)))
                                    (subst (list '= (list (list fv k) y) (list part ty)))
                                    (fact 'rr-ms-dist (list part tx) (list part ty))
                                    (subst (list '== (list '(DIST RR-MS) (list part tx) (list part ty))
                                                 (list 'abs (list '- (list part tx) (list part ty)))))
                                    (dk-cite! dle tx ty)
                                    (ca5v-rr! (list 'abs (list '- (list part tx) (list part ty))))
                                    (ca5v-rr! (list 'magnitude (list '- tx ty))) (ca5v-rr! (list 'magnitude (list '- ty tx)))
                                    (dk-cite! 'cc-magnitude-sub-sym tx ty)
                                    (fact 'rr-pos-rr-in-rr ev)
                                    (dk-ineq! (list '<= (list 'abs (list '- (list part tx) (list part ty))) (list 'magnitude (list '- tx ty)))
                                              (list '= (list 'magnitude (list '- tx ty)) (list 'magnitude (list '- ty tx)))
                                              (list '< (list 'magnitude (list '- ty tx)) ev)))))))))))))
          (dk-have! (list 'IS-EQUICONTINUOUS ca5-SK 'RR-MS fv) (lambda () (dk-only! eiff erhs) (prop))))
        ;; convergence at the dense points
        (let* ((diff (dk-cite! 'is-dense-seq ca5-SK 'dq)) (drhs (caddr diff)))
          (dk-have! drhs (lambda () (dk-only! diff (list 'IS-DENSE-SEQ ca5-SK 'dq)) (prop)))
          (dk-split-all! (list drhs)))
        (dk-have! '(IN dq (FUN NN kk)) (lambda () (subst (list '== 'kk (list 'PTS ca5-SK))) (ass)))
        (let* ((ciff (dk-cite! 'converges-on ca5-SK fv 'dq)) (crhs (caddr ciff)))
          (dk-have! crhs
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((m (dk-di-var!))
                             (dm (list 'dq m))
                             (seqf (list 'VNB-LAMBDA 'k 'NN (list (list fv 'k) dm)))
                             (seqt (list 'VNB-LAMBDA 'cmk_ 'NN (list part (list (list 't 'cmk_) dm))))
                             (ex (dk-apply! hcv m))
                             (lm (dk-skolem! ex)))
                        (dk-split-all!)
                        (fact 'fun-apply-type-c 'dq 'NN 'kk m)
                        (dk-fun-ext! seqf seqt 'NN 'RR
                          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fv-at! k dm) (tval! k dm) (fact ptl (list (list 't k) dm))
                                                                  (subst (list '= (list (list fv k) dm) (list part (list (list 't k) dm)))) (ass)))))
                          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (tval! k dm) (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (begin (fact ptl (list (list 't k) dm)) (ass)))))))
                          (lambda (k)
                            (fv-at! k dm) (tval! k dm) (fact ptl (list (list 't k) dm))
                            (if (dk--redex? (dk-goal)) (dk-lam-b!))
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
                        (let* ((cv (dk-cite! 'converges 'RR-MS seqf)))
                          (dk-have! (caddr cv) (lambda () (ew lm) (subst (list '= seqf seqt)) (ass)))
                          (dk-only! cv (caddr cv)) (prop))))))))
          (dk-have! (list 'CONVERGES-ON ca5-SK fv 'dq) (lambda () (dk-only! ciff crhs) (prop))))
        (dk-have! (list 'FORSOME 'dseq (list 'AND (list 'IS-DENSE-SEQ ca5-SK 'dseq) (list 'CONVERGES-ON ca5-SK fv 'dseq)))
          (lambda () (ew 'dq) (dk-conj-close! (lambda () (ass)))))
        (dk-cite! 'equicont-dense-conv-implies-unif-cauchy ca5-SK fv)
        (let* ((uiff (dk-cite! 'is-unif-cauchy ca5-SK fv))
               (ucl (caddr (caddr (caddr uiff)))))
          (dk-have! (caddr uiff) (lambda () (dk-only! uiff (list 'IS-UNIF-CAUCHY ca5-SK fv)) (prop)))
          (dk-split-all! (list (caddr uiff)))
          (let* ((ev (cadr (car (filter (dk-head? 'POS-RR) (dk-asms)))))
                 (cap (dk-skolem! (dk-apply! (dk-ctx-form ucl) ev))))
            (dk-split-all!)
            (ew cap)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((lk (dk-peel!))
                           (gd (cadr (cadr (dk-goal))))
                           (i (cadr (car (cadr (cadr gd))))) (j (cadr (car (cadr (caddr gd)))))
                           (z (cadr (cadr (cadr gd))))
                           (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm ev))) "the tail")))
                      (ca5v-and! (list 'IN i 'NN) (list '<= cap i))
                      (ca5v-and! (list 'IN j 'NN) (list '<= cap j))
                      (dk-have! (list 'IN z (list 'PTS ca5-SK)) (lambda () (subst (list '== (list 'PTS ca5-SK) 'kk)) (ass)))
                      (dk-apply! tl i j z)
                      (fv-at! i z) (fv-at! j z)
                      (dk-rewrite-h! (list '< (list 'abs (list '- (list (list fv i) z) (list (list fv j) z))) ev)
                                     (list (list fv i) z) (list part (list (list 't i) z)))
                      (dk-rewrite-h! (list '< (list 'abs (list '- (list part (list (list 't i) z)) (list (list fv j) z))) ev)
                                     (list (list fv j) z) (list part (list (list 't j) z)))
                      (ass))))))))))
  (qed name)
  (topic! name 'analysis))

(ca5-coord-proof! 'real-part 'cc-re-unif-cauchy-on-compact)
(ca5-coord-proof! 'imag-part 'cc-im-unif-cauchy-on-compact)
;;; ======================================================================
;;; (5) the same for the complex values: uniformly Cauchy on K
;;; ======================================================================
(define (ca5-cvseq j) (list 'VNB-LAMBDA 'cmk_ 'NN (list (list 't 'cmk_) (list 'dq j))))
(define (ca5-cpseq part j) (list 'VNB-LAMBDA 'cmk_ 'NN (list part (list (list 't 'cmk_) (list 'dq j)))))
;; the coordinates converge at the dense points
(define (ca5-coord-conv! part hty hcv)
    (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
                (list 'FORSOME 'lm (list 'AND '(IN lm RR) (list 'CONVERGES-TO 'RR-MS (ca5-cpseq part 'j) 'lm)))))
      (lambda ()
        (let* ((j (dk-di-var!))
               (lm (dk-skolem! (ca5-apply! hcv j)))
               (dj (list 'dq j))
               (f (ca5-cvseq j)) (g (ca5-cpseq 'real-part j)) (q (ca5-cpseq 'imag-part j)))
          (dk-split-all!)
          (fact 'fun-apply-type-c 'dq 'NN 'kk j)
          (define (typ! k) (ca5-apply! hty k dj))
          (dk-have! (list 'IN f '(FUN NN CC)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (typ! k) (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
          (for-each
            (lambda (pq)
              (let ((pt (car pq)) (sq (cdr pq)))
                (dk-have! (list 'IN sq '(FUN NN RR))
                  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (typ! k) (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                                         (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                                             (begin (fact (if (eq? pt 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list (list 't k) dj))
                                                                    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))))
                (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list pt (list f 'n_)) (list sq 'n_))))
                  (lambda () (let ((k (dk-di-var!))) (typ! k) (fact (if (eq? pt 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list (list 't k) dj))
                                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
            (list (cons 'real-part g) (cons 'imag-part q)))
          (dk-split-all! (list (dk-cite! 'cc-coords-of-converges f g q lm)))
          (fact (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr) lm)
          (ew (list part lm))
          (dk-conj-close! (lambda () (ass)))))))

(sp (make-wff
  (list 'FORALL 'kk (list 'IMPLIES '(SUBSET kk CC) (list 'IMPLIES (list 'IS-COMPACT ca5-SK)
  (list 'FORALL 'dq (list 'IMPLIES (list 'IS-DENSE-SEQ ca5-SK 'dq)
  (list 'FORALL 't (list 'IMPLIES '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z kk) (IN ((t k) z) CC)))))
    (list 'IMPLIES (ca5-equi-on 'kk)
    (list 'IMPLIES (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
                     (list 'FORSOME 'lm (list 'AND '(IN lm CC) (list 'CONVERGES-TO 'CC-MS (ca5-cvseq 'j) 'lm)))))
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
        (list 'FORSOME 'cap (list 'AND '(IN cap NN)
          (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES '(<= cap i)
            (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(<= cap j)
              (list 'FORALL 'z (list 'IMPLIES '(IN z kk)
                '(< (magnitude (- ((t i) z) ((t j) z))) eps))))))))))))))))))))))))
(dk-peel!)
(let* ((hty (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(IN ((t k) z) CC)))) "the typing"))
       (hcv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CONVERGES-TO))) "the convergence")))
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'kk 'CC)
  (let* ((diff (dk-cite! 'is-dense-seq ca5-SK 'dq)) (drhs (caddr diff)))
    (dk-have! drhs (lambda () (dk-only! diff (list 'IS-DENSE-SEQ ca5-SK 'dq)) (prop)))
    (dk-split-all! (list drhs)))
  (fact 'subspace-pts 'CC-MS 'kk)
  (dk-have! '(IN dq (FUN NN kk)) (lambda () (subst (list '== 'kk (list 'PTS ca5-SK))) (ass)))
  (ca5-coord-conv! 'real-part hty hcv)
  (ca5-coord-conv! 'imag-part hty hcv)
  (let* ((ev (cadr (car (filter (dk-head? 'POS-RR) (dk-asms)))))
         (e2 (list '* 1/2 ev)))
    (fact 'rr-pos-rr-in-rr ev) (fact 'rr-lt-of-pos-rr ev)
    (ca5x-rr! e2)
    (dk-have! (list '< 0 e2) (lambda () (dk-ineq! (list '< 0 ev))))
    (dk-cite! 'rr-pos-rr-of-lt e2)
    (let* ((ure (dk-cite! 'cc-re-unif-cauchy-on-compact 'kk 'dq 't))
           (uim (dk-cite! 'cc-im-unif-cauchy-on-compact 'kk 'dq 't))
           (c1 (dk-skolem! (ca5-apply! ure e2)))
           (_1 (dk-split-all!))
           (c2 (dk-skolem! (ca5-apply! uim e2)))
           (_2 (dk-split-all!))
           (cap (list '+ c1 c2)))
      (ca5v-and! (list 'IN c1 'NN) (list 'IN c2 'NN))
      (fact 'nn-add-closed c1 c2)
      (fact 'nn-in-rr c1) (fact 'nn-in-rr c2) (fact 'nn-zero-le c1) (fact 'nn-zero-le c2)
      (fact 'nn-in-rr cap)
      (ew cap)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((lk (dk-peel!))
                     (gd (cadr (cadr (dk-goal))))
                     (i (cadr (car (cadr gd)))) (j (cadr (car (caddr gd)))) (z (cadr (cadr gd)))
                     (ti (list (list 't i) z)) (tj (list (list 't j) z)) (w (list '- ti tj))
                     (t1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm c1) (dk-contains? fm 'real-part))) "re tail"))
                     (t2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm c2) (dk-contains? fm 'imag-part))) "im tail")))
                (fact 'nn-in-rr i) (fact 'nn-in-rr j)
                (dk-have! (list '<= c1 i) (lambda () (dk-ineq! (list '<= cap i) (list '<= 0 c2))))
                (dk-have! (list '<= c1 j) (lambda () (dk-ineq! (list '<= cap j) (list '<= 0 c2))))
                (dk-have! (list '<= c2 i) (lambda () (dk-ineq! (list '<= cap i) (list '<= 0 c1))))
                (dk-have! (list '<= c2 j) (lambda () (dk-ineq! (list '<= cap j) (list '<= 0 c1))))
                (ca5-apply! t1 i j z)
                (ca5-apply! t2 i j z)
                (ca5-apply! hty i z) (ca5-apply! hty j z)
                (ca5v-cc! w)
                (dk-cite! 'cc-magnitude-le-re-im w)
                (dk-cite! 'cc-re-sub ti tj) (dk-cite! 'cc-im-sub ti tj)
                (fact 'real-part-in-rr ti) (fact 'real-part-in-rr tj) (fact 'imag-part-in-rr ti) (fact 'imag-part-in-rr tj)
                (dk-rewrite-h! (list '<= (list 'magnitude w) (list '+ (list 'abs (list 'real-part w)) (list 'abs (list 'imag-part w))))
                               (list 'real-part w) (list '- (list 'real-part ti) (list 'real-part tj)))
                (dk-rewrite-h! (list '<= (list 'magnitude w) (list '+ (list 'abs (list '- (list 'real-part ti) (list 'real-part tj))) (list 'abs (list 'imag-part w))))
                               (list 'imag-part w) (list '- (list 'imag-part ti) (list 'imag-part tj)))
                (ca5v-rr! (list 'magnitude w))
                (ca5v-rr! (list 'abs (list '- (list 'real-part ti) (list 'real-part tj))))
                (ca5v-rr! (list 'abs (list '- (list 'imag-part ti) (list 'imag-part tj))))
                (dk-ineq! (list '<= (list 'magnitude w) (list '+ (list 'abs (list '- (list 'real-part ti) (list 'real-part tj)))
                                                             (list 'abs (list '- (list 'imag-part ti) (list 'imag-part tj)))))
                          (list '< (list 'abs (list '- (list 'real-part ti) (list 'real-part tj))) e2)
                          (list '< (list 'abs (list '- (list 'imag-part ti) (list 'imag-part tj))) e2)))))))))
(qed 'cc-unif-cauchy-on-compact)
(topic! 'cc-unif-cauchy-on-compact 'analysis)
;;; ======================================================================
;;; (6) one subsequence converging at every point of a dense sequence of u
;;;     (ascoli-pointwise-diagonal of rake-ascoli-diagonal, on the real parts, then on the
;;;     imaginary parts of the first subsequence)
;;; ======================================================================
(define ca5-S0 '(SUBSPACE-MS CC-MS u))
(define (ca5-in-clause sk part)        ; forall k in NN, z in u: (v k) z = part((sk k) z)
  (lambda (v)
    (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'z (list 'IMPLIES '(IN z u)
      (list '= (list (list v 'k) 'z) (list part (list (sk 'k) 'z)))))))))
;; name the family k |-> (z |-> part((sk k) z)); TYP! lands ((sk k) z) in CC.  Returns the symbol.
(define (ca5-name-fam! sk part typ!)
  (let* ((lam (list 'VNB-LAMBDA 'cmk_ 'NN (list 'VNB-LAMBDA 'cmz_ 'u (list part (list (sk 'cmk_) 'cmz_)))))
         (ptl (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr)))
    (dk-have! (list 'IN lam '(FUN NN (FUN u RR)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((k (dk-di-var!)))
              (dk-lam-type!
                (lambda ()
                  (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                    (typ! k z) (fact ptl (list (sk k) z))
                    (if (not (sequent-node-grounded? leaf)) (ass))))))))))
    (let* ((v (dk-name! lam '(FUN NN (FUN u RR)))))
      (dk-have! ((ca5-in-clause sk part) v)
        (lambda ()
          (let* ((lk (dk-peel!))
                 (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                 (z (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'u))) lk)))))
            (typ! k z) (fact ptl (list (sk k) z))
            (subst (list '= v lam))
            (if (dk--redex? (dk-goal)) (dk-lam-b!))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      v)))
;; POINTWISE-BOUNDED(S0, v) for the family named by ca5-name-fam!; BND! lands |(sk k) z| <= bd, given k, z, bd
(define (ca5-ptwise-bounded! v sk part typ! hbd)
  (let* ((pi (dk-cite! 'pointwise-bounded ca5-S0 v)) (prhs (caddr pi))
         (vcl (dk-ctx-form ((ca5-in-clause sk part) v)))
         (ptl (if (eq? part 'real-part) 'cc-abs-re-le-magnitude 'cc-abs-im-le-magnitude)))
    (dk-have! prhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) 'IN)
               (subst (list '== (list 'PTS ca5-S0) 'u)) (ass))
              (#t
               (let* ((x (dk-di-var!)))
                 (dk-have! (list 'IN x 'u) (lambda () (subst (list '== 'u (list 'PTS ca5-S0))) (ass)))
                 (let* ((bd (dk-skolem! (ca5-apply! hbd x))))
                   (dk-split-all!)
                   (ew bd)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (let* ((k (dk-di-var!))
                                  (bcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm bd))) "the bound")))
                             (typ! k x)
                             (ca5-apply! vcl k x)
                             (subst (list '= (list (list v k) x) (list part (list (sk k) x))))
                             (dk-cite! ptl (list (sk k) x))
                             (ca5-apply! bcl (if (equal? (sk k) (list 's k)) k (cadr (sk k))))
                             (ca5v-rr! (list 'magnitude (list (sk k) x)))
                             (ca5v-rr! (list 'abs (list part (list (sk k) x))))
                             (dk-ineq! (list '<= (list 'abs (list part (list (sk k) x))) (list 'magnitude (list (sk k) x)))
                                       (list '<= (list 'magnitude (list (sk k) x)) bd))))))))))))))
    (dk-have! (list 'POINTWISE-BOUNDED ca5-S0 v) (lambda () (dk-only! pi prhs) (prop)))))
;; d strictly mono: land d in FUN(NN, NN)
(define (ca5-sm-fun-nn! d)
  (let ((smi (dk-cite! 'strictly-mono-nn d)))
    (dk-have! (caddr smi) (lambda () (dk-only! smi (list 'STRICTLY-MONO-NN d)) (prop)))
    (dk-split-all! (list (caddr smi)))))

(sp (make-wff '(FORALL u (IMPLIES (SUBSET u CC)
  (FORALL s (IMPLIES (FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z u) (IN ((s k) z) CC)))))
    (IMPLIES (FORALL z (IMPLIES (IN z u) (FORSOME bd (AND (IN bd RR) (FORALL k (IMPLIES (IN k NN) (<= (magnitude ((s k) z)) bd)))))))
      (FORALL dd (IMPLIES (IS-DENSE-SEQ (SUBSPACE-MS CC-MS u) dd)
        (FORSOME phi (AND (STRICTLY-MONO-NN phi)
          (FORALL j (IMPLIES (IN j NN)
            (FORSOME lm (AND (IN lm CC) (CONVERGES-TO CC-MS (VNB-LAMBDA cmk_ NN ((s (phi cmk_)) (dd j))) lm))))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space) (ca5v-pts-cc!)
(fact 'rr-is-metric-space)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(dk-have! '(SUBSET u (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
(fact 'subspace-is-metric-space 'CC-MS 'u)
(fact 'subspace-pts 'CC-MS 'u)
(let* ((hty (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(IN ((s k) z) CC)))) "the typing"))
       (hbd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'bd))) "the bound"))
       (typ0! (lambda (k z) (ca5-apply! hty k z)))
       (sk0 (lambda (k) (list 's k)))
       (vr (ca5-name-fam! sk0 'real-part typ0!)))
  (ca5-ptwise-bounded! vr sk0 'real-part typ0! hbd)
  (let* ((d1 (dk-skolem! (ca5-apply! (dk-cite! 'ascoli-pointwise-diagonal ca5-S0 vr) 'dd))))
    (dk-split-all!)
    (ca5-sm-fun-nn! d1)
    (let* ((sk1 (lambda (k) (list 's (list d1 k))))
           (typ1! (lambda (k z) (fact 'fun-apply-type-c d1 'NN 'NN k) (ca5-apply! hty (list d1 k) z)))
           (vi (ca5-name-fam! sk1 'imag-part typ1!)))
      (ca5-ptwise-bounded! vi sk1 'imag-part typ1! hbd)
      (let* ((d2 (dk-skolem! (ca5-apply! (dk-cite! 'ascoli-pointwise-diagonal ca5-S0 vi) 'dd))))
        (dk-split-all!)
        (ca5-sm-fun-nn! d2)
        ;; the composite index map
        (let* ((phl (list 'VNB-LAMBDA 'cmp_ 'NN (list d1 (list d2 'cmp_)))))
          (dk-have! (list 'IN phl '(FUN NN NN))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c d2 'NN 'NN k) (fact 'fun-apply-type-c d1 'NN 'NN (list d2 k))
                                                   (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
          (let* ((ph (dk-name! phl '(FUN NN NN))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list ph 'k) (list d1 (list d2 'k)))))
              (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c d2 'NN 'NN k) (fact 'fun-apply-type-c d1 'NN 'NN (list d2 k))
                           (subst (list '= ph phl)) (if (dk--redex? (dk-goal)) (dk-lam-b!))
                           (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
            (let ((phv (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list ph 'k) (list d1 (list d2 'k))))))))
              ;; ph is strictly monotone
              (let* ((smi (dk-cite! 'strictly-mono-nn ph)))
                (dk-have! (caddr smi)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (let* ((lk (dk-peel!))
                                   (gd (dk-goal))
                                   (m (cadr (cadr gd))) (n (cadr (caddr gd)))
                                   (c1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list d1 'm)))) "d1 mono"))
                                   (c2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list d2 'm)))) "d2 mono")))
                              (ca5-apply! phv m) (ca5-apply! phv n)
                              (subst (list '= (list ph m) (list d1 (list d2 m))))
                              (subst (list '= (list ph n) (list d1 (list d2 n))))
                              (ca5-apply! c2 m n)
                              (fact 'fun-apply-type-c d2 'NN 'NN m) (fact 'fun-apply-type-c d2 'NN 'NN n)
                              (ca5-apply! c1 (list d2 m) (list d2 n))
                              (ass)))))))
                (dk-have! (list 'STRICTLY-MONO-NN ph) (lambda () (dk-only! smi (caddr smi)) (prop))))
              (ew ph)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((j (dk-di-var!))
                             (dj (list 'dd j))
                             (dsi (dk-cite! 'is-dense-seq ca5-S0 'dd)))
                        (dk-have! (caddr dsi) (lambda () (dk-only! dsi (list 'IS-DENSE-SEQ ca5-S0 'dd)) (prop)))
                        (dk-split-all! (list (caddr dsi)))
                        (dk-have! '(IN dd (FUN NN u)) (lambda () (subst (list '== 'u (list 'PTS ca5-S0))) (ass)))
                        (fact 'fun-apply-type-c 'dd 'NN 'u j)
                        ;; the real parts along d1 converge at dd(j); then along d2
                        (let* ((cr (list 'CONVERGES-ON ca5-S0 (list 'SUBSEQ vr d1) 'dd))
                               (ci (list 'CONVERGES-ON ca5-S0 (list 'SUBSEQ vi d2) 'dd))
                               (ra (list 'VNB-LAMBDA 'k 'NN (list (list (list 'SUBSEQ vr d1) 'k) dj)))
                               (ib (list 'VNB-LAMBDA 'k 'NN (list (list (list 'SUBSEQ vi d2) 'k) dj))))
                          (define (conv-of! c sq)
                            (let* ((cvi (dk-cite! 'converges-on ca5-S0 (caddr c) 'dd)))
                              (dk-have! (caddr cvi) (lambda () (dk-only! cvi c) (prop)))
                              (dk-split-all! (list (caddr cvi)))
                              (let* ((all (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CONVERGES) (dk-contains? fm (caddr c)))) "the convergence clause"))
                                     (cv1 (ca5-apply! all j))
                                     (cvd (dk-cite! 'converges 'RR-MS sq)))
                                (dk-have! (caddr cvd) (lambda () (dk-only! cvd cv1) (prop)))
                                (let* ((l (dk-skolem! (caddr cvd)))
                                       (ct (dk-cite! 'converges-to 'RR-MS sq l)))
                                  (dk-have! (caddr ct) (lambda () (dk-only! ct (list 'CONVERGES-TO 'RR-MS sq l)) (prop)))
                                  (dk-split-all! (list (caddr ct)))
                                  (dk-have! (list 'IN l 'RR) (lambda () (subst '(== RR (PTS RR-MS))) (ass)))
                                  l))))
                          (let* ((a (conv-of! cr ra)) (b (conv-of! ci ib))
                                 (f (list 'VNB-LAMBDA 'cmk_ 'NN (list (list 's (list ph 'cmk_)) dj)))
                                 (g (list 'SUBSEQ ra d2))
                                 (lv (list '+ a (list '* b '+i)))
                                 (val! (lambda (n)
                                         (fact 'fun-apply-type-c d2 'NN 'NN n) (fact 'fun-apply-type-c d1 'NN 'NN (list d2 n))
                                         (ca5-apply! hty (list d1 (list d2 n)) dj))))
                            (dk-cite! 'subseq-of-convergent 'RR-MS ra d2 a)
                            (dk-have! (list 'IN ra '(FUN NN RR))
                              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                (fact 'subseq-apply vr d1 k) (subst (list '== (list (list 'SUBSEQ vr d1) k) (list vr (list d1 k))))
                                (fact 'fun-apply-type-c d1 'NN 'NN k) (ca5-apply! hty (list d1 k) dj)
                                (ca5-apply! (dk-ctx-form ((ca5-in-clause sk0 'real-part) vr)) (list d1 k) dj)
                                (subst (list '= (list (list vr (list d1 k)) dj) (list 'real-part (list (list 's (list d1 k)) dj))))
                                (fact 'real-part-in-rr (list (list 's (list d1 k)) dj)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                            (dk-have! (list 'IN ib '(FUN NN RR))
                              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                (fact 'subseq-apply vi d2 k) (subst (list '== (list (list 'SUBSEQ vi d2) k) (list vi (list d2 k))))
                                (fact 'fun-apply-type-c d2 'NN 'NN k) (fact 'fun-apply-type-c d1 'NN 'NN (list d2 k)) (ca5-apply! hty (list d1 (list d2 k)) dj)
                                (ca5-apply! (dk-ctx-form ((ca5-in-clause sk1 'imag-part) vi)) (list d2 k) dj)
                                (subst (list '= (list (list vi (list d2 k)) dj) (list 'imag-part (list (list 's (list d1 (list d2 k))) dj))))
                                (fact 'imag-part-in-rr (list (list 's (list d1 (list d2 k))) dj)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                            (dk-have! (list 'IN ra '(FUN NN (PTS RR-MS))) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
                            (ca5v-and! (list 'IN ra '(FUN NN (PTS RR-MS))) (list 'STRICTLY-MONO-NN d2))
                            (fact 'subseq-is-fun 'RR-MS ra d2)
                            (dk-have! (list 'IN g '(FUN NN RR)) (lambda () (subst '(== RR (PTS RR-MS))) (ass)))
                            (dk-have! (list 'IN f '(FUN NN CC))
                              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                (ca5-apply! phv k) (val! k)
                                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                (subst (list '= (list ph k) (list d1 (list d2 k))))
                                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                            ;; the pointwise coordinates
                            (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list 'real-part (list f 'n_)) (list g 'n_))))
                              (lambda () (let ((n (dk-di-var!)))
                                (val! n) (ca5-apply! phv n)
                                (fact 'subseq-apply ra d2 n)
                                (subst (list '== (list g n) (list ra (list d2 n))))
                                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                (fact 'subseq-apply vr d1 (list d2 n))
                                (subst (list '== (list (list 'SUBSEQ vr d1) (list d2 n)) (list vr (list d1 (list d2 n)))))
                                (ca5-apply! (dk-ctx-form ((ca5-in-clause sk0 'real-part) vr)) (list d1 (list d2 n)) dj)
                                (subst (list '= (list (list vr (list d1 (list d2 n))) dj) (list 'real-part (list (list 's (list d1 (list d2 n))) dj))))
                                (subst (list '= (list ph n) (list d1 (list d2 n))))
                                (fact 'real-part-in-rr (list (list 's (list d1 (list d2 n))) dj))
                                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                            (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list 'imag-part (list f 'n_)) (list ib 'n_))))
                              (lambda () (let ((n (dk-di-var!)))
                                (val! n) (ca5-apply! phv n)
                                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                (fact 'subseq-apply vi d2 n)
                                (subst (list '== (list (list 'SUBSEQ vi d2) n) (list vi (list d2 n))))
                                (ca5-apply! (dk-ctx-form ((ca5-in-clause sk1 'imag-part) vi)) (list d2 n) dj)
                                (subst (list '= (list (list vi (list d2 n)) dj) (list 'imag-part (list (list 's (list d1 (list d2 n))) dj))))
                                (subst (list '= (list ph n) (list d1 (list d2 n))))
                                (fact 'imag-part-in-rr (list (list 's (list d1 (list d2 n))) dj))
                                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                            ;; the limit
                            (dk-split-all!)
                            (fact 'rr-subset-cc a) (fact 'rr-subset-cc b)
                            (fact 'cc-i-in)
                            (ca5v-and! (list 'IN b 'CC) '(IN +i CC))
                            (fact 'cc-mul-closed b '+i)
                            (ca5v-and! (list 'IN a 'CC) (list 'IN (list '* b '+i) 'CC))
                            (fact 'cc-add-closed a (list '* b '+i))
                            (dk-have! (list '= lv lv) (lambda () (rfl)))
                            (dk-split-all! (list (dk-cite! 'cc-re-im-of lv a b)))
                            (dk-have! (list 'CONVERGES-TO 'RR-MS g (list 'real-part lv)) (lambda () (subst (list '= (list 'real-part lv) a)) (ass)))
                            (dk-have! (list 'CONVERGES-TO 'RR-MS ib (list 'imag-part lv)) (lambda () (subst (list '= (list 'imag-part lv) b)) (ass)))
                            (dk-cite! 'cc-converges-of-coords f g ib lv)
                            (ew lv)
                            (dk-conj-close! (lambda () (ass))))))))))))))))
(qed 'cc-pointwise-diagonal)
(topic! 'cc-pointwise-diagonal 'analysis)
;;; ======================================================================
;;; (7) dense sequences of the K_{n+n0} (all non-empty), and from them a dense sequence of u
;;; ======================================================================
;;; countable choice through rmm-nn-choice, copied from ca5-function-spaces.scm (ca5-choose-seq!)
(define ca5-seq-family '())
(define (ca5-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'ca5k_ 'NN (list 'SEP 'ca5w_ A (Pf 'ca5k_ 'ca5w_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! ca5-seq-family (cons (cons g L) ca5-seq-family))
      g)))
(define (ca5-seq-at! g k)
  (let* ((L  (cdr (assq g ca5-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (ca5-apply! (or cl (error "ca5-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
(define (ca5-SJ n n0) (list 'SUBSPACE-MS 'CC-MS (list 'CC-EXHAUST 'u (list '+ n n0))))

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (FORALL p (IMPLIES (IN p u)
  (FORSOME n0 (AND (IN n0 NN) (FORSOME dsq (AND (IN dsq (FUN NN (FUN NN CC)))
    (FORALL n (IMPLIES (IN n NN)
      (IS-DENSE-SEQ (SUBSPACE-MS CC-MS (CC-EXHAUST u (+ n n0))) (dsq n))))))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(fact 'cc-is-metric-space) (ca5v-pts-cc!)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(let* ((n0 (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u 'p)))
       (_0 (dk-split-all!))
       (fcc '(FUN NN CC)))
  (fact 'nn-in-rr n0) (fact 'nn-zero-le n0)
  (let* ((g (ca5-choose-seq! fcc
              (lambda (k w) (list 'IS-DENSE-SEQ (ca5-SJ k n0) w))
              (lambda (k)
                (let* ((kn (list '+ k n0)) (kx (list 'CC-EXHAUST 'u kn)) (sx (ca5-SJ k n0)))
                  (ca5v-and! (list 'IN k 'NN) (list 'IN n0 'NN))
                  (fact 'nn-add-closed k n0)
                  (fact 'nn-le-add-left k n0)
                  (dk-cite! 'cc-exhaust-mono 'u n0 kn)
                  (fact 'subset-mem-fwd (list 'CC-EXHAUST 'u n0) kx 'p)
                  (dk-cite! 'cc-exhaust-compact 'u kn)
                  (dk-cite! 'cc-exhaust-subset 'u kn)
                  (fact 'subset-trans kx 'u 'CC)
                  (dk-have! (list 'IN kx 'SET) (lambda () (dk-sethood! kx)))
                  (fact 'subspace-pts 'CC-MS kx)
                  (dk-have! (list 'FORSOME 'x (list 'IN 'x (list 'PTS sx)))
                    (lambda () (ew 'p) (subst (list '== (list 'PTS sx) kx)) (ass)))
                  (let* ((d (dk-skolem! (dk-cite! 'rmm-dense-seq-exists sx))))
                    (let* ((di (dk-cite! 'is-dense-seq sx d)))
                      (dk-have! (caddr di) (lambda () (dk-only! di (list 'IS-DENSE-SEQ sx d)) (prop)))
                      (dk-split-all! (list (caddr di))))
                    (dk-have! (list 'IN d (list 'FUN 'NN kx)) (lambda () (subst (list '== kx (list 'PTS sx))) (ass)))
                    (fact 'fun-codomain-superset d 'NN kx 'CC)
                    d))))))
    (ew n0)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin
              (ew g)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let ((n (dk-di-var!)))
                        (ca5-seq-at! g n)
                        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))))))
(qed 'cc-exhaust-dense-seqs)
(topic! 'cc-exhaust-dense-seqs 'analysis)

;;; the dense sequences, enumerated along nnpair, are dense in u
(define ca5-D '(VNB-LAMBDA cdm_ NN ((dsq (nnfst cdm_)) (nnsnd cdm_))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 'n0 (list 'IMPLIES '(IN n0 NN) (list 'FORALL 'dsq (list 'IMPLIES '(IN dsq (FUN NN (FUN NN CC)))
    (list 'IMPLIES '(FORALL n (IMPLIES (IN n NN) (IS-DENSE-SEQ (SUBSPACE-MS CC-MS (CC-EXHAUST u (+ n n0))) (dsq n))))
      (list 'IS-DENSE-SEQ '(SUBSPACE-MS CC-MS u) ca5-D))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(fact 'cc-is-metric-space) (ca5v-pts-cc!)
(dk-have! '(SUBSET u (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
(fact 'subspace-is-metric-space 'CC-MS 'u)
(fact 'subspace-pts 'CC-MS 'u)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(let* ((hd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DENSE-SEQ))) "the density"))
       (S0 '(SUBSPACE-MS CC-MS u))
       ;; n in NN in context: the n-th sequence's facts (its values lie in K_{n+n0}, a subset of u)
       (seqfacts! (lambda (n)
         (let* ((kn (list '+ n 'n0)) (kx (list 'CC-EXHAUST 'u kn)) (sx (list 'SUBSPACE-MS 'CC-MS kx)))
           (ca5v-and! (list 'IN n 'NN) '(IN n0 NN))
           (fact 'nn-add-closed n 'n0)
           (dk-cite! 'cc-exhaust-subset 'u kn)
           (fact 'subset-trans kx 'u 'CC)
           (dk-have! (list 'IN kx 'SET) (lambda () (dk-sethood! kx)))
           (fact 'subspace-pts 'CC-MS kx)
           (ca5-apply! hd n)
           (let ((di (dk-cite! 'is-dense-seq sx (list 'dsq n))))
             (dk-have! (caddr di) (lambda () (dk-only! di (list 'IS-DENSE-SEQ sx (list 'dsq n))) (prop)))
             (dk-split-all! (list (caddr di))))
           (dk-have! (list 'IN (list 'dsq n) (list 'FUN 'NN kx)) (lambda () (subst (list '== kx (list 'PTS sx))) (ass)))
           (list kx sx)))))
  (let* ((di (dk-cite! 'is-dense-seq S0 ca5-D)) (drhs (caddr di)))
    (dk-have! drhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-asm? g) (ass))
                ((dk-head-is? g 'IN)
                 (subst (list '== (list 'PTS S0) 'u))
                 (dk-lam-type!
                   (lambda ()
                     (let* ((m (dk-di-var!)) (a (list 'nnfst m)) (b (list 'nnsnd m)))
                       (fact 'nnfst-type m) (fact 'nnsnd-type m)
                       (let* ((ks (seqfacts! a)))
                         (fact 'fun-apply-type-c (list 'dsq a) 'NN (car ks) b)
                         (fact 'subset-mem-fwd (car ks) 'u (list (list 'dsq a) b))
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                (#t
                 (let* ((lk (dk-peel!))
                        (x (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'PTS))) lk))))
                        (ev (cadr (car (filter (dk-head? 'POS-RR) lk)))))
                   (dk-have! (list 'IN x 'u) (lambda () (subst (list '== 'u (list 'PTS S0))) (ass)))
                   (fact 'subset-mem-fwd 'u 'CC x)
                   (let* ((n1 (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u x)))
                          (_1 (dk-split-all!))
                          (ks (seqfacts! n1))
                          (kx (car ks)) (sx (cadr ks)))
                     (fact 'nn-le-add-right 'n0 n1)
                     (dk-cite! 'cc-exhaust-mono 'u n1 (list '+ n1 'n0))
                     (fact 'subset-mem-fwd (list 'CC-EXHAUST 'u n1) kx x)
