                (ca5-in-image! k)
                (ca5-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm bm) (dk-contains? fm 'chf_))) "bound") (list 's k) z)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))))
(define ca5-pbd (dk-ctx-form '(FORALL z (IMPLIES (IN z u) (FORSOME bd (AND (IN bd RR) (FORALL k (IMPLIES (IN k NN) (<= (magnitude ((s k) z)) bd)))))))))
;; equicontinuity of the members (5.8)
(define ca5-eqc (dk-cite! 'cc-hol-bounded-equicontinuous 'u ca5-A))
;; finish: phi strictly monotone and the subsequence uniformly Cauchy on every K_n, both in context
(define (ca5-finish! phi)
