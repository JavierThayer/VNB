(let* ((lu (dk-cite! 'cc-fn-module-limit-uniform 'u 's))
       (ui (dk-cite! 'cc-exhaust-uniform-iff-compacta 'u 's ca5-Flim)))
  (dk-have! (cadr ui) (lambda () (ass)))
  (dk-have! (list 'UNIF-ON-COMPACTA 'u 's ca5-Flim) (lambda () (dk-only! ui (cadr ui)) (prop)))
  (dk-have! '(FORALL k (IMPLIES (IN k NN) (HOLOMORPHIC-ON u (s k))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (fact 'fun-apply-type-c 's 'NN ca5-H k)
        (ca5-hol-open! (list 's k))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
  (dk-cite! 'holomorphic-limit-on-compacta 'u 's ca5-Flim)
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u ca5-Flim)) (hr (caddr hi)))
    (dk-have! hr (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-have! (list 'IN ca5-Flim ca5-H) (lambda () (dk-only! hi hr) (prop))))
  (ew ca5-Flim)
  (dk-conj-close! (lambda () (ass))))
