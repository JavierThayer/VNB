                              (if (dk-contains? (dk-goal) (list dd m)) (subst (list '= (list dd m) pt)))
                              (if (dk--redex? (dk-goal)) (dk-lam-b!))
                              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                  (begin
                                    (subst (list '== (list t k) (list 's (list phi k))))
                                    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
                          (ew lm)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
