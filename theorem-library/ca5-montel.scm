                          (let* ((lk2 (dk-peel!))
                                 (gd (cadr (cadr (dk-goal))))
                                 (i (cadr (car (cadr gd)))) (j (cadr (car (caddr gd)))) (z (cadr (cadr gd)))
                                 (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm ev))) "the tail")))
                            (fact 'subset-mem-fwd (list 'CC-EXHAUST 'u n) jset z)
