      (list 'FORSOME 'g (list 'AND (list 'IN 'g ca5-H) '(UNIF-ON-COMPACTA u (SUBSEQ s phi) g))))))))))))
(dk-peel!)
(let* ((phi (dk-skolem! (dk-cite! 'cc-montel-subsequence 'u 's)))
       (_0 (dk-split-all!))
       (t (list 'SUBSEQ 's phi)))
  (ca5-sm-fun-nn! phi)
  (dk-have! (list 'IN t (list 'FUN 'NN ca5-H))
    (lambda ()
      (mac 'SUBSEQ)
      (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                 (fact 'fun-apply-type-c phi 'NN 'NN k)
                                 (fact 'fun-apply-type-c 's 'NN ca5-H (list phi k))
                                 (if (not (sequent-node-grounded? leaf)) (ass)))))))
  (let* ((g (dk-skolem! (dk-cite! 'cc-montel-tail 'u t))))
    (dk-split-all!)
    (ew phi)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin (ew g) (dk-conj-close! (lambda () (ass)))))))))
(qed 'cc-montel)
(topic! 'cc-montel 'analysis)
;;; ======================================================================
;;; (9) convergence in the Frechet space C(u) is uniform convergence on compacta, and
;;;     PROPOSITION 5.20 (sequential form): differentiation is continuous on H(u)
;;; ======================================================================
(define ca5-V '(CC-CONT-FNS u))
(define ca5-MV (list 'CC-FN-MODULE 'u ca5-V))
(define ca5-FAM (list 'CC-EXHAUST-SEMINORMS 'u ca5-V))
(define (ca5-fdiff a b) (list 'VNB-LAMBDA 'cfz_ 'u (list '- (list a 'cfz_) (list b 'cfz_))))
(define (ca5-famdiff k a b)
  (list (list ca5-FAM k) (list (list 'VADD ca5-MV) a (list (list 'VNEG ca5-MV) b))))
(define (ca5-cfn-parts! a)
  (let* ((iff (dk-cite! 'cc-cont-fns-membership 'u a)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-have! rhs (lambda () (dk-only! iff (list 'IN a ca5-V)) (prop))))
    (dk-split-all! (list rhs))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca5-V))
    (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f ca5-V)
      (list 'IFF (list 'FR-CONV ca5-MV ca5-FAM 's 'f) '(UNIF-ON-COMPACTA u s f))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(dk-cite! 'cc-cont-fns-is-set 'u)
(dk-cite! 'cc-fn-module-is-module 'u)
(dk-cite! 'cc-exhaust-seminorms-family 'u)
(ca5-cfn-parts! 'f)
(let* ((ui (dk-cite! 'cc-exhaust-uniform-iff-compacta 'u 's 'f))
       (ul (cadr ui))
       (ciff (dk-cite! 'fr-conv ca5-MV ca5-FAM 's 'f))
       (crhs (caddr ciff))
       ;; i in NN, n in NN: land p_n(s_i - f) = CC-SUP-NORM(fdiff), the pointwise typing, its realness
       (diffsetup! (lambda (i nv)
         (let* ((si (list 's i)) (kk (list 'CC-EXHAUST 'u nv)) (d (ca5-fdiff si 'f)))
           (fact 'fun-apply-type-c 's 'NN ca5-V i)
           (dk-cite! 'cc-fn-module-seminorm-of-difference 'u si 'f nv)
           (dk-cite! 'cc-exhaust-subset 'u nv)
           (dk-cite! 'cc-cont-fns-fun 'u si)
           (dk-cite! 'cc-cont-fns-fun 'u 'f)
           (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list 'IN (list d 'ky_) 'CC)))
             (lambda ()
               (let ((y (dk-di-var!)))
                 (fact 'subset-mem-fwd kk 'u y)
                 (fact 'fun-apply-type-c si 'u 'CC y) (fact 'fun-apply-type-c 'f 'u 'CC y)
                 (if (dk--redex? (dk-goal)) (dk-lam-b!))
                 (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                     (begin (ca5x-cc! (cadr (dk-goal))) (ass))))))
           (dk-cite! 'cc-cont-fns-diff 'u si 'f)
           (ca5-cfn-parts! d)
           (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u d nv)))
           (list si kk d)))))
  (dk-iff! (lambda (g) (dk-head-is? g 'UNIF-ON-COMPACTA))
    ;; FR-CONV => uniform on every K_n => UNIF-ON-COMPACTA
    (lambda ()
      (dk-have! crhs (lambda () (dk-only! ciff (list 'FR-CONV ca5-MV ca5-FAM 's 'f)) (prop)))
      (dk-have! ul
        (lambda ()
          (let* ((lk (dk-peel!))
                 (nv (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                 (epsv (cadr (car (filter (dk-head? 'POS-RR) lk))))
                 (cap (dk-skolem! (ca5-apply! crhs nv epsv))))
            (dk-split-all!)
            (fact 'rr-pos-rr-in-rr epsv)
            (ew cap)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((lk2 (dk-peel!))
                           (gd (cadr (cadr (dk-goal))))
                           (i (cadr (car (cadr gd)))) (z (cadr (cadr gd)))
                           (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm epsv))) "the tail"))
                           (sd (diffsetup! i nv)) (si (car sd)) (kk (cadr sd)) (d (caddr sd)))
                      (ca5v-and! (list 'IN i 'NN) (list '<= cap i))
                      (let ((h (dk-apply! tl i)))
                        (dk-rewrite-h! h (ca5-famdiff nv si 'f) (list 'CC-SUP-NORM d kk)))
                      (fact 'subset-mem-fwd kk 'u z)
                      (fact 'fun-apply-type-c si 'u 'CC z) (fact 'fun-apply-type-c 'f 'u 'CC z)
                      (dk-cite! 'cc-sup-norm-upper d kk z)
                      (dk-have! (list '= (list d z) (list '- (list si z) (list 'f z))) (lambda () (if (not (dk-lam-b!)) (rfl))))
                      (dk-rewrite-h! (list '<= (list 'magnitude (list d z)) (list 'CC-SUP-NORM d kk)) (list d z) (list '- (list si z) (list 'f z)))
                      (ca5v-rr! (list 'magnitude (list '- (list si z) (list 'f z))))
                      (dk-ineq! (list '<= (list 'magnitude (list '- (list si z) (list 'f z))) (list 'CC-SUP-NORM d kk))
                                (list '< (list 'CC-SUP-NORM d kk) epsv)))))))))
      (dk-only! ui ul)
      (prop))
    ;; UNIF-ON-COMPACTA => uniform on every K_n => FR-CONV
    (lambda ()
      (dk-have! ul (lambda () (dk-only! ui '(UNIF-ON-COMPACTA u s f)) (prop)))
      (dk-have! crhs
        (lambda ()
          (let* ((lk (dk-peel!))
                 (nv (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                 (epsv (cadr (car (filter (dk-head? 'POS-RR) lk))))
                 (he (list '* 1/2 epsv)))
            (fact 'rr-pos-rr-in-rr epsv) (fact 'rr-lt-of-pos-rr epsv)
            (ca5x-rr! he)
            (dk-have! (list '< 0 he) (lambda () (dk-ineq! (list '< 0 epsv))))
            (dk-cite! 'rr-pos-rr-of-lt he)
            (let* ((cap (dk-skolem! (ca5-apply! ul nv he))))
              (dk-split-all!)
              (ew cap)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((lk2 (begin (dk-peel!) (dk-split-all!)))
                             (gd (dk-goal))
                             (i (cadr (cadr (cadr (cadr gd)))))
                             (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm he))) "the tail"))
                             (sd (diffsetup! i nv)) (si (car sd)) (kk (cadr sd)) (d (caddr sd)))
                        (subst (list '== (ca5-famdiff nv si 'f) (list 'CC-SUP-NORM d kk)))
                        (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list '<= (list 'magnitude (list d 'ky_)) he)))
                          (lambda ()
                            (let ((y (dk-di-var!)))
                              (fact 'subset-mem-fwd kk 'u y)
                              (fact 'fun-apply-type-c si 'u 'CC y) (fact 'fun-apply-type-c 'f 'u 'CC y)
                              (if (dk--redex? (dk-goal)) (dk-lam-b!))
                              (ca5-apply! tl i y)
                              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
                        (dk-have! (list '<= 0 he) (lambda () (dk-ineq! (list '< 0 he))))
                        (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound d kk he)))
                        (dk-ineq! (list '<= (list 'CC-SUP-NORM d kk) he) (list '< 0 epsv))))))))))
      (dk-only! ciff crhs)
      (prop))))
(qed 'cc-fr-conv-iff-unif-on-compacta)
(topic! 'cc-fr-conv-iff-unif-on-compacta 'analysis)

;;; PROPOSITION 5.20 (sequential): f_k -> f in H(u) for the Frechet structure gives f_k' -> f'
(define ca5-dfam '(VNB-LAMBDA wcvk_ NN (VNB-LAMBDA wcvw_ u (DERIV-ON CC-NORMED-FIELD u (s wcvk_) wcvw_))))
(define ca5-dlim '(VNB-LAMBDA wcvw_ u (DERIV-ON CC-NORMED-FIELD u f wcvw_)))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca5-H))
    (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f ca5-H)
      (list 'IMPLIES (list 'FR-CONV ca5-MV ca5-FAM 's 'f)
        (list 'FR-CONV ca5-MV ca5-FAM ca5-dfam ca5-dlim))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(dk-cite! 'cc-hol-fns-subset-cont 'u)
(fact 'fun-codomain-superset 's 'NN ca5-H ca5-V)
(fact 'subset-mem-fwd ca5-H ca5-V 'f)
(dk-split-all! (list (dk-cite! 'cc-fr-conv-iff-unif-on-compacta 'u 's 'f)))
(dk-have! '(UNIF-ON-COMPACTA u s f) (lambda () (prop)))
(ca5-hol-open! 'f)
(dk-have! '(FORALL k (IMPLIES (IN k NN) (HOLOMORPHIC-ON u (s k))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (fact 'fun-apply-type-c 's 'NN ca5-H k)
      (ca5-hol-open! (list 's k))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
(dk-cite! 'holomorphic-limit-derivatives 'u 's 'f)
;; the derivatives are continuous: in C(u)
(define (ca5-deriv-in-c! g)    ; HOLOMORPHIC-ON(u, g) in context: (VNB-LAMBDA cifdw_ u (DERIV-ON ... g cifdw_)) in C(u)
  (let* ((dg (list 'VNB-LAMBDA 'cifdw_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u g 'cifdw_))))
    (dk-cite! 'holomorphic-deriv-holomorphic 'u g)
    (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u dg)) (hr (caddr hi)))
      (dk-cite! 'holomorphic-on-in-fun 'u dg)
      (dk-have! hr (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! (list 'IN dg ca5-H) (lambda () (dk-only! hi hr) (prop))))
    (fact 'subset-mem-fwd ca5-H ca5-V dg)
    dg))
(let* ((dgf (ca5-deriv-in-c! 'f)))
  (dk-have! (list 'IN ca5-dlim ca5-V) (lambda () (ass)))
  (dk-have! (list 'IN ca5-dfam (list 'FUN 'NN ca5-V))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((k (dk-di-var!)))
            (fact 'fun-apply-type-c 's 'NN ca5-H k)
            (ca5-hol-open! (list 's k))
            (ca5-deriv-in-c! (list 's k))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
  (dk-split-all! (list (dk-cite! 'cc-fr-conv-iff-unif-on-compacta 'u ca5-dfam ca5-dlim)))
  (prop))
(qed 'cc-deriv-continuous-on-hol)
(topic! 'cc-deriv-continuous-on-hol 'analysis)
