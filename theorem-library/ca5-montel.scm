;;; ======================================================================
;;; (8) MONTEL'S THEOREM (Theorem 5.7, Corollary 5.19): a bounded sequence in H(u) has a
;;;     subsequence converging uniformly on the compact subsets of u, to a member of H(u)
;;; ======================================================================
(define ca5-ucauchy
  '(FORALL k (IMPLIES (IN k NN) (FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME cap (AND (IN cap NN)
       (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= cap i)
         (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= cap j)
           (FORALL z (IMPLIES (IN z (CC-EXHAUST u k))
             (< (magnitude (- ((s i) z) ((s j) z))) eps))))))))))))))))
(define ca5-H '(CC-HOL-FNS u))
(define ca5-C '(CC-CONT-FNS u))
(define ca5-Flim (list 'VNB-LAMBDA 'cfz_ 'u (list 'CHOICE (list 'SEP 'cfl_ 'CC (list 'CONVERGES-TO 'CC-MS (list 'VNB-LAMBDA 'cfi_ 'NN (list (list 's 'cfi_) 'cfz_)) 'cfl_)))))
;; h in H(u) in context: land h in FUN(u, CC) and HOLOMORPHIC-ON(u, h)
(define (ca5-hol-open! h)
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u h)) (hr (caddr hi)))
    (if (not (dk-asm? hr)) (dk-have! hr (lambda () (dk-only! hi (list 'IN h ca5-H)) (prop))))
    (dk-split-all! (list hr))))

;;; the tail: a uniformly Cauchy (on every K_n) sequence in H(u) converges uniformly on compacta
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca5-H)) (list 'IMPLIES ca5-ucauchy
    (list 'FORSOME 'g (list 'AND (list 'IN 'g ca5-H) '(UNIF-ON-COMPACTA u s g))))))))))
(dk-peel!)
