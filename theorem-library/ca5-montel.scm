(define ca5-goal0 (dk-goal))
;; the values of the members are complex numbers
(dk-have! '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z u) (IN ((s k) z) CC)))))
  (lambda ()
    (let* ((lk (dk-peel!))
           (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
