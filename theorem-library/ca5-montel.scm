                (fact 'subset-trans jset 'u 'CC)
                (dk-cite! 'cc-exhaust-compact 'u nn1)
                (ca5-apply! hdq n)
                ;; typing of the subsequence on jset
                (dk-have! (list 'FORALL 'cmi_ (list 'IMPLIES '(IN cmi_ NN) (list 'FORALL 'cmy_ (list 'IMPLIES (list 'IN 'cmy_ jset) (list 'IN (list (list t 'cmi_) 'cmy_) 'CC)))))
                  (lambda ()
                    (let* ((lk2 (dk-peel!))
                           (gk (cadr (dk-goal)))
                           (k (cadr (car gk)))
                           (z (cadr gk)))
                      (tval! k)
                      (fact 'subset-mem-fwd jset 'u z)
                      (ca5-apply! ca5-sty (list phi k) z)
                      (subst (list '== (list t k) (list 's (list phi k))))
                      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
                ;; equicontinuity on jset
                (dk-have! (ca5-equi-on2 jset t)
                  (lambda ()
                    (let* ((lk2 (dk-peel!))
                           (x (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) jset))) lk2))))
                           (e2 (cadr (car (filter (dk-head? 'POS-RR) lk2)))))
                      (fact 'subset-mem-fwd jset 'u x)
                      (let* ((dl (dk-skolem! (ca5-apply! ca5-eqc x e2))))
                        (dk-split-all!)
                        (ew dl)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (let* ((lk3 (dk-peel!))
                                       (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk3))))
                                       (y (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) jset))) lk3)))))
                                  (tval! k)
                                  (fact 'subset-mem-fwd jset 'u y)
                                  (ca5-in-image! (list phi k))
