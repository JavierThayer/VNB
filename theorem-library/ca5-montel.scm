                        (dk-split-all!)
                        (fact 'fun-apply-type-c dsq 'NN '(FUN NN CC) n)
                        (fact 'fun-apply-type-c (list dsq n) 'NN 'CC j)
                        (dk-have! (list '= (list dd m) pt)
                          (lambda () (dk-lam-b!)
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                (begin (subst (list '= (list 'nnfst m) n)) (subst (list '= (list 'nnsnd m) j)) (rfl)))))
                        (let* ((sq1 (list 'VNB-LAMBDA 'cmk_ 'NN (list (list 's (list phi 'cmk_)) (list dd m))))
                               (sq2 (list 'VNB-LAMBDA 'cmk_ 'NN (list (list t 'cmk_) pt))))
                          (dk-cite! 'cc-exhaust-subset 'u nn1)
                          (dk-have! (list 'IN pt jset)
                            (lambda ()
                              (let ((di (dk-cite! 'is-dense-seq (list 'SUBSPACE-MS 'CC-MS jset) dq)))
                                (dk-have! (caddr di) (lambda () (dk-only! di (list 'IS-DENSE-SEQ (list 'SUBSPACE-MS 'CC-MS jset) dq)) (prop)))
                                (dk-split-all! (list (caddr di)))
                                (dk-have! (list 'IN jset 'SET) (lambda () (dk-sethood! jset)))
                                (fact 'subspace-pts 'CC-MS jset)
                                (dk-have! (list 'IN dq (list 'FUN 'NN jset)) (lambda () (subst (list '== jset (list 'PTS (list 'SUBSPACE-MS 'CC-MS jset)))) (ass)))
