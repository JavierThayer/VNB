                            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (tval! k)
                                                                   (ca5-apply! ca5-sty (list phi k) pt)
                                                                   (if (dk-contains? (dk-goal) (list dd m)) (subst (list '= (list dd m) pt)))
                                                                   (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                                                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))
                            (lambda (k)
