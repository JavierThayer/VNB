(use-em '(FORSOME p (IN p u))
  (lambda ()
    (let* ((p (dk-skolem! '(FORSOME p (IN p u))))
           (n0 (dk-skolem! (dk-cite! 'cc-exhaust-dense-seqs 'u p)))
           (_0 (dk-split-all!))
           (dsq (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'IS-DENSE-SEQ))) "the dense sequences")))
           (_1 (dk-split-all!))
           (hdq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DENSE-SEQ) (dk-contains? fm dsq))) "density"))
           (dd (list 'VNB-LAMBDA 'cdm_ 'NN (list (list dsq '(nnfst cdm_)) '(nnsnd cdm_)))))
      (dk-cite! 'cc-exhaust-dense-in-u 'u n0 dsq)
      (let* ((phi (dk-skolem! (dk-cite! 'cc-pointwise-diagonal 'u 's dd))))
        (dk-split-all!)
        (ca5-sm-fun-nn! phi)
        (let* ((t (list 'SUBSEQ 's phi))
               (hconv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CONVERGES-TO) (dk-contains? fm phi))) "the diagonal"))
               (tval! (lambda (k) ; (t k) = (s (phi k)), both typed
                        (fact 'fun-apply-type-c phi 'NN 'NN k)
                        (fact 'fun-apply-type-c 's 'NN ca5-H (list phi k))
                        (fact 'subseq-apply 's phi k))))
          (dk-have! (ca5-ucauchy-of t)
            (lambda ()
              (let* ((lk (dk-peel!))
                     (n (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                     (ev (cadr (car (filter (dk-head? 'POS-RR) lk))))
                     (nn1 (list '+ n n0)) (jset (list 'CC-EXHAUST 'u nn1)) (dq (list dsq n)))
                (ca5v-and! (list 'IN n 'NN) (list 'IN n0 'NN))
                (fact 'nn-add-closed n n0)
                (fact 'nn-le-add-right n0 n)
                (dk-cite! 'cc-exhaust-mono 'u n nn1)
