;;; ======================================================================
;;; (2) CONTINUITY IS LOCAL: continuous at w on an open v inside u => on u
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC) (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN u CC))
  (list 'FORALL 'cmvv_ (cmv-imps (list (list 'IS-OPEN cmv-nfm 'cmvv_) '(SUBSET cmvv_ u))
    (list 'FORALL 'cmvw_ (cmv-imps (list '(IN cmvw_ cmvv_)
                                         (list 'IS-CONTINUOUS-AT (cmv-sub 'cmvv_) cmv-nfm '(RESTRICT h cmvv_) 'cmvw_))
      (list 'IS-CONTINUOUS-AT (cmv-sub 'u) cmv-nfm 'h 'cmvw_)))))))))))
(dk-peel!)
(let* ((v 'cmvv_) (w 'cmvw_) (rh '(RESTRICT h cmvv_))
       (sv (cmv-sub v)) (su (cmv-sub 'u))
       (dn (lambda (p q) (list (list 'DIST cmv-nfm) p q)))
       (dc (lambda (p q) (list '(DIST CC-MS) p q)))
       (mg (lambda (p q) (list 'magnitude (list '- p q)))))
  (fact 'cc-open-subset-cc v)
  (cmv-ms! 'u) (cmv-ms! v)
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (fact 'subset-mem-fwd v 'u w)
  (fact 'subset-mem-fwd 'u 'CC w)
  (let* ((cv (dk-ctx-form (list 'IS-CONTINUOUS-AT sv cmv-nfm rh w)))
         (iff (dk-cite! 'is-continuous-at sv cmv-nfm rh w))
         (conj (caddr iff))
         (edf (let loop ((r conj)) (if (eq? (car r) 'AND) (loop (caddr r)) r)))
         (oiff (dk-cite! 'is-open cmv-nfm v))
         (oconj (caddr oiff))
         (oball (let loop ((r oconj)) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (dk-have! edf (lambda () (if (dk-only! iff cv) (prop))))
    (dk-have! oball (lambda () (if (dk-only! oiff (list 'IS-OPEN cmv-nfm v)) (prop))))
    (let* ((rho (dk-skolem! (dk-apply! oball w)))
           (bl (list 'BALL cmv-nfm w rho)))
      (dk-split-all!)
      (fact 'rr-pos-rr-in-rr rho)
      (fact 'rr-lt-of-pos-rr rho)
      (let ((d (dk-halve! rho)))
        (dk-split-all!)
        (mac 'is-continuous-at)
        (dk-conj-close!
         (lambda ()
           (let ((g (dk-goal)))
             (cond
              ((dk-asm? g) (ass))
              ((eq? (cmv-hd g) 'IN)
               (if (dk-contains? g (list 'PTS su)) (subst (list '== (list 'PTS su) 'u)))
               (if (dk-contains? (dk-goal) (list 'PTS cmv-nfm)) (subst (list '== (list 'PTS cmv-nfm) 'CC)))
               (ass))
              ((eq? (cmv-hd g) 'FORALL)
               (let* ((eps (cadr (car (filter (dk-head? 'POS-RR) (dk-peel!)))))
                      (del (dk-skolem! (dk-apply! edf eps)))
                      (ub (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm del))) "the bound on v")))
                 (fact 'rr-pos-rr-in-rr del)
                 (fact 'rr-lt-of-pos-rr del)
                 (let ((w0 (dk-skolem! (dk-cite! 'rr-min-pos del d))))
                   (dk-split-all!)
                   (dk-cite! 'rr-pos-rr-of-lt w0)
                   (ew w0)
                   (dk-conj-close!
                    (lambda ()
                      (if (not (eq? (cmv-hd (dk-goal)) 'FORALL))
                          (ass)
                          (let* ((lk (dk-peel!))
                                 (b (cadr (car (filter (dk-head? 'IN) lk)))))
                            (dk-have! (list 'IN b 'u) (lambda () (subst (list '== 'u (list 'PTS su))) (ass)))
                            (fact 'subset-mem-fwd 'u 'CC b)
                            (for-each (lambda (p) (dk-have! (list 'IN p '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
                                      (list w b))
                            (fact 'subspace-dist cmv-nfm 'u w b)
                            (fact 'nf-cc-agree-dist w b)
                            (fact 'cc-ms-dist w b)
                            (cmv-cc! (list '- w b))
                            (fact 'cc-magnitude-closed (list '- w b))
                            (let ((m (mg w b)))
                              (dk-have! (list '<= m w0)
                                (lambda ()
                                  (subst (list '== m (dc w b)))
                                  (subst (list '== (dc w b) (dn w b)))
                                  (subst (list '== (dn w b) (list (list 'DIST su) w b)))
                                  (ass)))
                              ;; b in the ball about w of radius rho, hence in v
                              (dk-have! (list 'IN b bl)
                                (lambda ()
                                  (mac 'ball-membership)
                                  (subst (list '== (dn w b) (dc w b)))
                                  (subst (list '== (dc w b) m))
                                  (dk-conj-close!
                                    (lambda ()
                                      (let ((g2 (dk-goal)))
                                        (cond ((dk-asm? g2) (ass))
                                              ((eq? (cmv-hd g2) 'IN) (subst (list '== (list 'PTS cmv-nfm) 'CC)) (ass))
                                              ((eq? (cmv-hd g2) 'NOT)
                                               (di)
                                               (dk-absurd! (list '= m rho) (list '<= m w0) (list '<= w0 d) (list '= (list '+ d d) rho) (list '< 0 d)))
                                              (#t (dk-ineq! (list '<= m w0) (list '<= w0 d) (list '= (list '+ d d) rho) (list '< 0 d)))))))))
                              (fact 'subset-mem-fwd bl v b)
                              (dk-have! (list 'IN b (list 'PTS sv)) (lambda () (subst (list '== (list 'PTS sv) v)) (ass)))
                              (fact 'subspace-dist cmv-nfm v w b)
                              (dk-have! (list '<= (list (list 'DIST sv) w b) del)
                                (lambda ()
                                  (subst (list '== (list (list 'DIST sv) w b) (dn w b)))
                                  (subst (list '== (dn w b) (dc w b)))
                                  (subst (list '== (dc w b) m))
                                  (dk-ineq! (list '<= m w0) (list '<= w0 del))))
                              (dk-apply! ub b)
                              (fact 'restrict-apply 'h v w)
                              (fact 'restrict-apply 'h v b)
                              (subst (list '== '(h cmvw_) (list rh w)))
                              (subst (list '== (list 'h b) (list rh b)))
                              (ass)))))))))
              (#t (error "cc-continuous-at-local: unexpected leaf" (expression->string g)))))))))))
(qed 'cc-continuous-at-local)

;;; ======================================================================
;;; (3) THE DIFFERENCE QUOTIENT OF A HOLOMORPHIC FUNCTION (Caratheodory's form):
;;; f holomorphic on u, c in u: there is q on u, continuous on u, holomorphic off c,
;;; with f(x) - f(c) = q(x) (x - c) on u.  It is the witness of IS-DIFF-ON at c.
;;; ======================================================================
;;; y in u \ {c} in context (u subset CC): land y in u, y in CC, y /= c, y - c /= 0
(define (cmv-dpt-open! u c y)
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (dk-have! (list 'IN y u) (lambda () (if (dk-only! iff (list 'IN y (cmv-dpt u c))) (prop))))
    (fact 'subset-mem-fwd u 'CC y)
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (dk-have! (list 'NOT (list '= y c))
      (lambda () (if (dk-only! iff (list 'IN y (cmv-dpt u c)) (list 'IN y 'SET)
                           (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                 (prop))))
    (cmv-sub-nz! y c)))
;;; y, c in CC, y /= c in context: land y - c /= 0
(define (cmv-sub-nz! y c)
  (let ((nz (list 'NOT (list '= (list '- y c) 0))))
    (if (not (dk-asm? nz))
        (dk-have! nz
          (lambda ()
            (di)
            (dk-cite! 'cc-sub-zero-eq y c)
            (ai (dk-ctx-form (list 'NOT (list '= y c)))))))
    nz))
;;; y in u, y /= c in context: land y in u \ {c}
(define (cmv-dpt-in! u c y)
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (dk-have! (list 'IN y (cmv-dpt u c))
      (lambda () (if (dk-only! iff (list 'IN y u) (list 'NOT (list '= y c))
                           (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                 (prop))))))

(define cmv-q-concl
  (list 'FORSOME 'cmvq_
    (list 'AND '(IN cmvq_ (FUN u CC))
      (list 'AND (cmv-cont 'u 'cmvq_)
        (list 'AND (list 'HOLOMORPHIC-ON (cmv-dpt 'u 'c) (list 'RESTRICT 'cmvq_ (cmv-dpt 'u 'c)))
          '(FORALL cmvx_ (IMPLIES (IN cmvx_ u) (= (- (f cmvx_) (f c)) (* (cmvq_ cmvx_) (- cmvx_ c))))))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c u) cmv-q-concl)))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'f)
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'c)
(fact 'fun-apply-type-c 'f 'u 'CC 'c)
(cmv-ms! 'u)
(fact 'cc-is-normed-field)
(let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) 'c)))
       (dif (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f 'c l))
       (iff (dk-cite! 'is-diff-on 'CC-NORMED-FIELD 'u 'f 'c l))
       (ex (let loop ((r (caddr iff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
  (dk-have! ex (lambda () (if (dk-only! iff dif) (prop))))
  (let* ((phi (dk-skolem! (dk-ctx-form ex)))
         (V (cmv-dpt 'u 'c))
         (raw (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm phi) (dk-contains? fm '(MUL CC-NORMED-FIELD))))
                       "the Caratheodory identity"))
         (E (list 'FORALL 'cmvx_ (list 'IMPLIES '(IN cmvx_ u)
              (list '= '(- (f cmvx_) (f c)) (list '* (list phi 'cmvx_) '(- cmvx_ c)))))))
    (dk-split-all!)
    (dk-have! (list 'IN phi '(FUN u CC))
      (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
    ;; the identity in CC's own operations
    (dk-have! E
      (lambda ()
        (let* ((x (dk-di-var!)))
          (fact 'subset-mem-fwd 'u 'CC x)
          (fact 'fun-apply-type-c 'f 'u 'CC x)
          (fact 'fun-apply-type-c phi 'u 'CC x)
          (dk-apply! raw x)
          (cmv-cc! (list '- x 'c))
          (fact 'cc-nf-sub (list 'f x) '(f c))
          (fact 'cc-nf-sub x 'c)
          (fact 'cc-nf-mul-apply (list phi x) (list '- x 'c))
          (let ((h (dk-pick (lambda (fm) (and (cmv-op? fm '= 3) (dk-contains? fm '(MUL CC-NORMED-FIELD)) (dk-contains? fm x)
                                              (not (dk-contains? fm 'FORALL))))
                            "the identity at x")))
            (dk-have! (list '= (list '- (list 'f x) '(f c)) (list '* (list phi x) (list '- x 'c)))
              (lambda ()
                (subst (list '== (list '- (list 'f x) '(f c)) (cadr h)))
                (subst (list '== (list '* (list phi x) (list '- x 'c)) (list '(MUL CC-NORMED-FIELD) (list phi x) (list '- x 'c))))
                (subst (list '== (list '- x 'c) (list '(ADD CC-NORMED-FIELD) x (list '(NEG CC-NORMED-FIELD) 'c))))
                (ass)))))))
    ;; holomorphy of the quotient off c
    (fact 'cif-open-minus-point 'u 'c)
    (fact 'cc-open-subset-cc V)
    (cmv-ms! V)
    (dk-have! (list 'SUBSET V 'u)
      (lambda ()
        (let* ((y (subset-by-element!))
               (iff (dk-cite! 'difference-membership 'u (list 'SINGLETON 'c) y)))
          (if (dk-only! iff (list 'IN y V))
          (prop)))))
    (dk-have! (list 'SUBSET V (cmv-pz 'c))
      (lambda ()
        (let ((y (subset-by-element!)))
          (cmv-dpt-open! 'u 'c y)
          (let ((iff2 (dk-cite! 'cc-punctured-membership 'c y)))
            (if (dk-only! iff2 (list 'IN y 'CC) (list 'NOT (list '= y 'c)))
            (prop))))))
    (dk-split-all! (list (dk-cite! 'cc-ms-open-iff V)))
    (dk-have! (list 'IS-OPEN 'CC-MS V) (lambda () (prop)))
    (let* ((F (list 'RESTRICT 'f V))
           (G (list 'VNB-LAMBDA 'hbx_ V '(- (f c))))
           (A (list 'VNB-LAMBDA 'cmvz_ V '(+ (f cmvz_) (- (f c)))))
           (kern (list 'VNB-LAMBDA 'wnw_ (cmv-pz 'c) '(recip (- wnw_ c))))
           (RK (list 'RESTRICT kern V))
           (Q (list 'RESTRICT phi V)))
      (dk-cite! 'holomorphic-on-restrict 'u 'f V)
      (cmv-cc! '(- (f c)))
      (dk-cite! 'holomorphic-const V '(- (f c)))
      (dk-have! (list 'IN A (list 'FUN V 'CC))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((y (dk-di-var!)))
                (cmv-dpt-open! 'u 'c y)
                (fact 'fun-apply-type-c 'f 'u 'CC y)
                (cmv-cc! (list '+ (list 'f y) '(- (f c))))
                (dk-ass!))))))
      (dk-have! (list 'FORALL 'cmvh_ (list 'IMPLIES (list 'IN 'cmvh_ V)
                  (list '== (list A 'cmvh_) (list '+ (list F 'cmvh_) (list G 'cmvh_)))))
        (lambda ()
          (let ((y (dk-di-var!)))
            (cmv-dpt-open! 'u 'c y)
            (fact 'fun-apply-type-c 'f 'u 'CC y)
            (fact 'restrict-apply 'f V y)
            (subst (list '== (list F y) (list 'f y)))
            (dk-lam-b!)
            (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
      (dk-cite! 'holomorphic-sum V F G A)
      (fact 'subset-mem-fwd 'u 'CC 'c)
      (dk-cite! 'winding-integrand-holomorphic 'c)
      (dk-cite! 'cc-punctured-open 'c)
      (fact 'cc-is-metric-space)
      (dk-split-all! (list (dk-cite! 'cc-ms-open-iff (cmv-pz 'c))))
      (dk-have! (list 'IS-OPEN cmv-nfm (cmv-pz 'c)) (lambda () (prop)))
      (dk-cite! 'holomorphic-on-restrict (cmv-pz 'c) kern V)
      (fact 'restrict-in-fun phi 'u 'CC V)
      (dk-have! (list 'FORALL 'cmvh_ (list 'IMPLIES (list 'IN 'cmvh_ V)
                  (list '== (list Q 'cmvh_) (list '* (list A 'cmvh_) (list RK 'cmvh_)))))
        (lambda ()
          (let* ((y (dk-di-var!)) (fy (list 'f y)) (py (list phi y)) (dy (list '- y 'c)))
            (cmv-dpt-open! 'u 'c y)
            (fact 'fun-apply-type-c 'f 'u 'CC y)
            (fact 'fun-apply-type-c phi 'u 'CC y)
            (dk-have! (list 'IN y (cmv-pz 'c))
              (lambda () (fact 'subset-mem-fwd V (cmv-pz 'c) y) (ass)))
            (fact 'restrict-apply phi V y)
            (fact 'restrict-apply kern V y)
            (subst (list '== (list Q y) py))
            (subst (list '== (list RK y) (list kern y)))
            (dk-lam-b!)
            (cmv-cc! (list 'recip dy))
            (let ((k (dk-name! (list 'recip dy) 'CC)))
              (cmv-and! (list 'IN dy 'CC) (list 'NOT (list '= dy 0)))
              (dk-cite! 'cc-recip-inverse dy)
              (subst (list '= (list 'recip dy) k))
              (dk-have! (list '= (list '* dy k) 1) (lambda () (subst (list '= k (list 'recip dy))) (ass)))
              (dk-have! (list '= (list '+ fy '(- (f c))) (list '- fy '(f c))) (lambda () (crs)))
              (subst (list '= (list '+ fy '(- (f c))) (list '- fy '(f c))))
              (subst (dk-apply! (dk-ctx-form E) y))
              (dk-have! (list '= (list '* (list '* py dy) k) (list '* py (list '* dy k))) (lambda () (crs)))
              (subst (list '= (list '* (list '* py dy) k) (list '* py (list '* dy k))))
              (subst (list '= (list '* dy k) 1))
              (dk-have! (list '= (list '* py 1) py) (lambda () (crs)))
              (subst (list '= (list '* py 1) py))
              (qrfl)))))
      (dk-cite! 'holomorphic-product V A RK Q)
      ;; continuity of phi on u: at c by IS-DIFF-ON, off c by holomorphy and locality
      (dk-have! (cmv-cont 'u phi)
        (lambda ()
          (let ((y (dk-di-var!)))
            (use-em (list '= y 'c)
              (lambda () (subst (list '= y 'c)) (ass))
              (lambda ()
                (cmv-dpt-in! 'u 'c y)
                (dk-apply! (dk-cite! 'holomorphic-on-continuous V Q) y)
                (dk-cite! 'cc-continuous-at-local 'u phi V y)
                (ass))))))
      (ew phi)
      (dk-conj-close! dk-ass!))))
(qed 'holomorphic-difference-quotient)

;;; ======================================================================
;;; (4) THE CIRCLE: closed, and its trace at distance r from the centre
;;; ======================================================================
(define cmv-tp '(* 2 PI))
(define cmv-iv (list 'CCINT 0 cmv-tp))
(define (cmv-iv-ends!)      ; 0 and 2 pi in [0, 2 pi]; [0, 2 pi] a set
  (cmv-rr! 0)
  (cmv-rr! cmv-tp)
  (if (not (dk-asm? (list 'IN cmv-iv 'SET)))
      (begin (fact 'rr-is-set) (fact 'ccint-subset-rr 0 cmv-tp) (fact 'subclass-of-set-is-set cmv-iv 'RR)))
  (if (not (dk-asm? (list '< 0 cmv-tp))) (dk-have! (list '< 0 cmv-tp) (lambda () (dk-ineq! '(< 0 PI)))))
  (for-each
    (lambda (e)
      (if (not (dk-asm? (list 'IN e cmv-iv)))
          (dk-have! (list 'IN e cmv-iv)
            (lambda () (mac 'ccint-membership)
                       (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 cmv-tp)))))))))
    (list 0 cmv-tp)))

;;; (circle-path-ends-agree: CA-3's `circle-path-closed' is cited instead -- the duplicate proof was cut at integration, 2026-10-04)

;;; (circle-trace-radius: CA-3's `circle-trace-magnitude' is cited instead -- the duplicate proof was cut at integration, 2026-10-04)

;;; the trace of the circle of radius r about c lies in every disc B(c, R), R > r, and
;;; avoids the centre
(define cmv-P '(CIRCLE-PATH c r))
(define cmv-DP '(CIRCLE-DERIV c r))
(define cmv-T (list 'TRACE cmv-P 0 cmv-tp))
(define (cmv-ball z rad) (list 'BALL 'CC-MS z rad))
(sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (cmv-imps '((IN r RR) (< 0 r))
  (list 'FORALL 'cmvbr_ (cmv-imps '((IN cmvbr_ RR) (< r cmvbr_))
    (list 'FORALL 'cmvy_ (list 'IMPLIES (list 'IN 'cmvy_ cmv-T)
      (list 'AND (list 'IN 'cmvy_ (cmv-ball 'c 'cmvbr_)) '(NOT (= cmvy_ c)))))))))))))
(dk-peel!)
(let* ((y 'cmvy_) (R 'cmvbr_) (m (list 'magnitude (list '- y 'c))))
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'circle-trace-magnitude 'c 'r y)
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path cmv-P cmv-DP 0 cmv-tp)
  (fact 'is-path-in-fun cmv-P 0 cmv-tp)
  (fact 'trace-subset-cc cmv-P 0 cmv-tp)
  (fact 'subset-mem-fwd cmv-T 'CC y)
  (cmv-rr! m)
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
         ((dk-asm? g) (ass))
         ((eq? (cmv-hd g) 'IN)
          (mac 'ball-membership)
          (fact 'cc-ms-dist 'c y)
          (dk-cite! 'cc-magnitude-sub-sym 'c y)
          (subst (list '== (list '(DIST CC-MS) 'c y) (list 'magnitude (list '- 'c y))))
          (subst (list '= (list 'magnitude (list '- 'c y)) m))
          (dk-conj-close!
            (lambda ()
              (let ((g2 (dk-goal)))
                (cond ((dk-asm? g2) (ass))
                      ((eq? (cmv-hd g2) 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
                      ((eq? (cmv-hd g2) 'NOT) (di) (dk-absurd! (list '= m R) (list '= m 'r) (list '< 'r R)))
                      (#t (dk-ineq! (list '= m 'r) (list '< 'r R))))))))
         ((eq? (cmv-hd g) 'NOT)
          (di)
          (dk-have! (list '= m 0)
            (lambda ()
              (subst (list '= y 'c))
              (dk-have! '(= (- c c) 0) (lambda () (crs)))
              (subst '(= (- c c) 0))
              (fact 'cc-magnitude-zero)
              (ass)))
          (dk-absurd! (list '= m 0) (list '= m 'r) '(< 0 r)))
         (#t (error "circle-trace-in-punctured-ball: unexpected leaf" (expression->string g))))))))
(qed 'circle-trace-in-punctured-ball)


;;; ======================================================================
;;; (5) THE CAUCHY INTEGRAL FORMULA AT THE CENTRE OF A DISC (3.7 at z = c):
;;; f holomorphic on u, the closed disc of radius r about c inside u (written: some
;;; disc B(c, R) with R > r inside u), then
;;;     f(c) = 1/(2 pi i) int_{|w - c| = r} f(w) / (w - c) dw.
;;; ======================================================================
(define cmv-tpi '(* (* 2 PI) +i))
(define (cmv-tpi!)
  (cmv-rr! cmv-tp)
  (if (not (dk-asm? (list '< 0 cmv-tp))) (dk-have! (list '< 0 cmv-tp) (lambda () (dk-ineq! '(< 0 PI)))))
  (dk-cite! 'rr-pos-ne-zero cmv-tp)
  (cmv-cc! cmv-tp)
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero cmv-tp '+i)
  (cmv-cc! cmv-tpi)
  (cmv-cc! (list 'recip cmv-tpi)))
(define (cmv-kern z) (list 'VNB-LAMBDA 'wnw_ (cmv-pz z) (list 'recip (list '- 'wnw_ z))))
(define cmv-K (list 'VNB-LAMBDA 'cmvw_ (cmv-dpt 'u 'c) '(* (f cmvw_) (recip (- cmvw_ c)))))
(define (cmv-li g) (list 'LINE-INT g cmv-P cmv-DP 0 cmv-tp))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (cmv-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'cmvbr_ (cmv-imps '((IN cmvbr_ RR) (< r cmvbr_) (SUBSET (BALL CC-MS c cmvbr_) u))
      (list '= '(f c) (list '* (list 'recip cmv-tpi) (cmv-li cmv-K))))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (B (cmv-ball 'c R)) (D (cmv-dpt 'u 'c)) (V (cmv-dpt B 'c)) (PZ (cmv-pz 'c))
       (kern (cmv-kern 'c)) (rf (list 'RESTRICT 'f B))
       (KV (list 'RESTRICT kern V)) (KD (list 'RESTRICT kern D)) (rfd (list 'RESTRICT 'f D))
       (CV (list 'VNB-LAMBDA 'cmvw_ V '(* (f c) (recip (- cmvw_ c)))))
       (KK (list 'VNB-LAMBDA 'cmvw_ V '(* (f cmvw_) (recip (- cmvw_ c)))))
       (ptw (lambda (dom h rhs) (list 'FORALL 'cmvh_ (list 'IMPLIES (list 'IN 'cmvh_ dom) (list '== (list h 'cmvh_) (rhs 'cmvh_)))))))
  ;; the disc B
  (fact 'holomorphic-on-open 'u 'f) (fact 'holomorphic-on-in-fun 'u 'f) (fact 'cc-open-subset-cc 'u)
  (cmv-ms! 'u)
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! (list '<= 0 R) (lambda () (dk-ineq! (list '< 'r R) '(< 0 r))))
  (dk-have! (list 'NOT (list '= 0 R)) (lambda () (di) (dk-absurd! (list '= 0 R) (list '< 'r R) '(< 0 r))))
  (cmv-and! (list 'IN R 'RR) (cmv-and! (list '<= 0 R) (list 'NOT (list '= 0 R))))
  (dk-cite! 'ball-is-open 'CC-MS 'c R)
  (dk-split-all! (list (dk-cite! 'cc-ms-open-iff B)))
  (dk-have! (list 'IS-OPEN cmv-nfm B) (lambda () (prop)))
  (dk-cite! 'cc-ball-is-convex 'c R)
  (dk-cite! 'ball-center-in 'CC-MS 'c R)
  (fact 'cc-open-subset-cc B)
  (cmv-ms! B)
  (fact 'subset-mem-fwd B 'u 'c)
  (fact 'fun-apply-type-c 'f 'u 'CC 'c)
  ;; the difference quotient q of f on B, at c
  (dk-cite! 'holomorphic-on-restrict 'u 'f B)
  (let* ((q (dk-skolem! (dk-cite! 'holomorphic-difference-quotient B rf 'c)))
         (QV (list 'RESTRICT q V)))
    (dk-split-all!)
    (let ((Eq (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm q) (dk-contains? fm '-))) "the quotient identity")))
      ;; the circle
      (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
      (dk-cite! 'circle-is-road 'c 'r)
      (dk-cite! 'circle-path-closed 'c 'r)
      (fact 'is-road-is-path cmv-P cmv-DP 0 cmv-tp)
      (fact 'is-path-in-fun cmv-P 0 cmv-tp)
      (fact 'trace-subset-cc cmv-P 0 cmv-tp)
      (let ((tr (lambda (y) (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R y))
                            (fact 'subset-mem-fwd cmv-T 'CC y)
                            (fact 'subset-mem-fwd B 'u y))))
        (dk-have! (list 'SUBSET cmv-T B) (lambda () (let ((y (subset-by-element!))) (tr y) (dk-ass!))))
        (dk-have! (list 'SUBSET cmv-T V) (lambda () (let ((y (subset-by-element!))) (tr y) (cmv-dpt-in! B 'c y))))
        (dk-have! (list 'SUBSET cmv-T D) (lambda () (let ((y (subset-by-element!))) (tr y) (cmv-dpt-in! 'u 'c y))))
        (dk-have! (list 'SUBSET cmv-T PZ)
          (lambda () (let ((y (subset-by-element!)))
                       (tr y)
                       (let ((iff2 (dk-cite! 'cc-punctured-membership 'c y)))
                         (if (dk-only! iff2 (list 'IN y 'CC) (list 'NOT (list '= y 'c))) (prop)))))))
      ;; Cauchy with the exceptional point c: the integral of q over the circle is 0
      (dk-cite! 'cauchy-convex-closed-except B q 'c cmv-P cmv-DP 0 cmv-tp)
      ;; the punctured sets V = B \ {c}, D = u \ {c}, PZ = CC \ {c}
      (for-each
        (lambda (big)
          (let ((small (cmv-dpt big 'c)))
            (fact 'cif-open-minus-point big 'c)
            (fact 'cc-open-subset-cc small)
            (cmv-ms! small)
            (dk-have! (list 'SUBSET small big)
              (lambda ()
                (let* ((y (subset-by-element!))
                       (iff (dk-cite! 'difference-membership big (list 'SINGLETON 'c) y)))
                  (if (dk-only! iff (list 'IN y small)) (prop)))))
            (dk-have! (list 'SUBSET small PZ)
              (lambda ()
                (let ((y (subset-by-element!)))
                  (cmv-dpt-open! big 'c y)
                  (let ((iff2 (dk-cite! 'cc-punctured-membership 'c y)))
                    (if (dk-only! iff2 (list 'IN y 'CC) (list 'NOT (list '= y 'c))) (prop))))))))
        (list B 'u))
      (dk-cite! 'winding-integrand-holomorphic 'c)
      (dk-cite! 'cc-punctured-open 'c)
      (dk-split-all! (list (dk-cite! 'cc-ms-open-iff PZ)))
      (dk-have! (list 'IS-OPEN cmv-nfm PZ) (lambda () (prop)))
      (dk-cite! 'holomorphic-on-open PZ kern)
      (dk-cite! 'cc-open-subset-cc PZ)
      (cmv-ms! PZ)
      (for-each
        (lambda (dom)
          (dk-cite! 'holomorphic-on-restrict PZ kern dom)
          (dk-cite! 'holomorphic-on-in-fun dom (list 'RESTRICT kern dom))
          (dk-cite! 'holomorphic-on-continuous dom (list 'RESTRICT kern dom)))
        (list V D))
      (dk-cite! 'holomorphic-on-in-fun PZ kern)
      (dk-cite! 'holomorphic-on-continuous PZ kern)
      (dk-cite! 'holomorphic-on-in-fun V QV)
      (dk-cite! 'holomorphic-on-continuous V QV)
      (dk-cite! 'holomorphic-on-restrict 'u 'f D)
      (dk-cite! 'holomorphic-on-in-fun D rfd)
      (dk-cite! 'holomorphic-on-continuous D rfd)
      ;; at a point y of a punctured set: y - c /= 0, recip(y - c) in CC, y in PZ
      (let* ((pt! (lambda (big y)
                    (cmv-dpt-open! big 'c y)
                    (fact 'subset-mem-fwd (cmv-dpt big 'c) PZ y)
                    (cmv-cc! (list 'recip (list '- y 'c)))
                    (fact 'subset-mem-fwd big 'u y)
                    (fact 'fun-apply-type-c 'f 'u 'CC y)))
             (typ! (lambda (lam big)
                     (dk-have! (list 'IN lam (list 'FUN (cmv-dpt big 'c) 'CC))
                       (lambda ()
                         (dk-lam-type!
                           (lambda ()
                             (let ((y (dk-di-var!)))
                               (pt! big y)
                               (cmv-cc! (subst-free 'cmvw_ y (list-ref lam 3)))
                               (dk-ass!)))))))))
        (if (not (dk-asm? '(SUBSET u u))) (dk-have! '(SUBSET u u) (lambda () (let ((y (subset-by-element!))) (dk-ass!)))))
        (typ! CV B) (typ! KK B) (typ! cmv-K 'u)
        ;; CV = f(c) * KV on V
        (dk-have! (ptw V CV (lambda (h) (list '* '(f c) (list KV h))))
          (lambda ()
            (let ((y (dk-di-var!)))
              (pt! B y)
              (fact 'restrict-apply kern V y)
              (subst (list '== (list KV y) (list kern y)))
              (dk-lam-b!)
              (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
        (dk-cite! 'aif-cont-scale V '(f c) KV CV)
        ;; KK = QV + CV on V
        (dk-have! (ptw V KK (lambda (h) (list '+ (list QV h) (list CV h))))
          (lambda ()
            (let* ((y (dk-di-var!)) (fy (list 'f y)) (qy (list q y)) (dy (list '- y 'c)))
              (pt! B y)
              (fact 'fun-apply-type-c q B 'CC y)
              (fact 'restrict-apply q V y)
              (fact 'restrict-apply 'f B y)
              (fact 'restrict-apply 'f B 'c)
              (subst (list '== (list QV y) qy))
              (dk-lam-b!)
              (let ((k (dk-name! (list 'recip dy) 'CC)))
                (cmv-and! (list 'IN dy 'CC) (list 'NOT (list '= dy 0)))
                (dk-cite! 'cc-recip-inverse dy)
                (subst (list '= (list 'recip dy) k))
                (dk-have! (list '= (list '* dy k) 1) (lambda () (subst (list '= k (list 'recip dy))) (ass)))
                (dk-have! (list '= (list '- fy '(f c)) (list '* qy dy))
                  (lambda ()
                    (subst (list '== fy (list rf y)))
                    (subst (list '== '(f c) (list rf 'c)))
                    (dk-apply! Eq y)
                    (ass)))
                (dk-have! (list '= (list '* fy k) (list '+ (list '* (list '- fy '(f c)) k) (list '* '(f c) k))) (lambda () (crs)))
                (subst (list '= (list '* fy k) (list '+ (list '* (list '- fy '(f c)) k) (list '* '(f c) k))))
                (subst (list '= (list '- fy '(f c)) (list '* qy dy)))
                (dk-have! (list '= (list '* (list '* qy dy) k) (list '* qy (list '* dy k))) (lambda () (crs)))
                (subst (list '= (list '* (list '* qy dy) k) (list '* qy (list '* dy k))))
                (subst (list '= (list '* dy k) 1))
                (dk-have! (list '= (list '* qy 1) qy) (lambda () (crs)))
                (subst (list '= (list '* qy 1) qy))
                (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))))
        (dk-cite! 'aif-cont-sum V QV CV KK)
        ;; K = RF * KD on D
        (dk-have! (ptw D cmv-K (lambda (h) (list '* (list rfd h) (list KD h))))
          (lambda ()
            (let ((y (dk-di-var!)))
              (pt! 'u y)
              (fact 'restrict-apply 'f D y)
              (fact 'restrict-apply kern D y)
              (subst (list '== (list rfd y) (list 'f y)))
              (subst (list '== (list KD y) (list kern y)))
              (dk-lam-b!)
              (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
        (dk-cite! 'aif-cont-product D rfd KD cmv-K)
        ;; the integrals
        (dk-cite! 'line-int-sum V QV CV cmv-P cmv-DP 0 cmv-tp KK)
        (dk-cite! 'line-int-scalar V KV cmv-P cmv-DP 0 cmv-tp '(f c) CV)
        (let ((on-T (lambda (big g h)
                      (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ cmv-T) (list '== (list g 'wnx_) (list h 'wnx_))))
                        (lambda ()
                          (let ((y (dk-di-var!)))
                            (fact 'subset-mem-fwd cmv-T V y)
                            (fact 'subset-mem-fwd cmv-T D y)
                            (fact 'subset-mem-fwd V B y)
                            (pt! big y)
                            (if (and (pair? g) (eq? (car g) 'RESTRICT))
                                (begin (fact 'restrict-apply (cadr g) (caddr g) y)
                                       (subst (list '== (list g y) (list (cadr g) y)))))
                            (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                            (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))))))
          (on-T B QV q)
          (dk-cite! 'line-int-domain-congruence B q cmv-P cmv-DP 0 cmv-tp V QV)
          (on-T B KV kern)
          (dk-cite! 'line-int-domain-congruence PZ kern cmv-P cmv-DP 0 cmv-tp V KV)
          (on-T B KK cmv-K)
          (dk-cite! 'line-int-domain-congruence D cmv-K cmv-P cmv-DP 0 cmv-tp V KK))
        ;; the winding number about the centre
        (cmv-tpi!)
        (dk-cite! 'line-int-in-cc PZ kern cmv-P cmv-DP 0 cmv-tp)
        (dk-cite! 'winding-circle-center 'c 'r)
        (let* ((lk (cmv-li kern)) (rt (list 'recip cmv-tpi)) (w (list 'WINDING cmv-P cmv-DP 0 cmv-tp 'c)))
          (dk-have! (list '== w (list '* rt lk)) (lambda () (mac 'WINDING) (qrfl)))
          (dk-have! (list '= (list '* rt lk) 1) (lambda () (subst (list '== (list '* rt lk) w)) (ass)))
          (subst (list '= (cmv-li cmv-K) (cmv-li KK)))
          (subst (list '= (cmv-li KK) (list '+ (cmv-li QV) (cmv-li CV))))
          (subst (list '= (cmv-li QV) (cmv-li q)))
          (subst (list '= (cmv-li q) 0))
          (subst (list '= (cmv-li CV) (list '* '(f c) (cmv-li KV))))
          (subst (list '= (cmv-li KV) lk))
          (let* ((t (dk-name! rt 'CC)) (l (dk-name! lk 'CC)))
            (dk-have! (list '= (list '* t l) 1) (lambda () (subst (list '= t rt)) (subst (list '= l lk)) (ass)))
            (subst (list '= rt t))
            (subst (list '= lk l))
            (dk-have! (list '= (list '* t (list '+ 0 (list '* '(f c) l))) (list '* '(f c) (list '* t l))) (lambda () (crs)))
            (subst (list '= (list '* t (list '+ 0 (list '* '(f c) l))) (list '* '(f c) (list '* t l))))
            (subst (list '= (list '* t l) 1))
            (crs)))))))
(qed 'cauchy-integral-formula-centre)

;;; ======================================================================
;;; (6) THE MEAN VALUE PROPERTY (3.8, equation (92)):
;;;     f(c) = 1/(2 pi) int_0^{2 pi} f(c + r e^{i t}) dt
;;; ======================================================================
(define cmv-g (list 'VNB-LAMBDA 'cmvt_ cmv-iv '(f (+ c (* r (CC-EXP (* +i cmvt_)))))))

;;; the standing facts of the kernel K(w) = f(w)/(w - c) on D = u \ {c} and of the circle,
;;; in a proof whose context holds HOLOMORPHIC-ON(u, f), c in CC, r in RR, 0 < r,
;;; R in RR, r < R, BALL(CC-MS, c, R) subset u.  Lands: D open, K in FUN(D, CC), K
;;; continuous on D, the circle a road with trace inside D, B(c, R) open and inside u.
(define (cmv-kernel-setup! R)
  (let* ((B (cmv-ball 'c R)) (D (cmv-dpt 'u 'c)) (PZ (cmv-pz 'c)) (kern (cmv-kern 'c))
         (KD (list 'RESTRICT kern D)) (rfd (list 'RESTRICT 'f D)))
    (fact 'holomorphic-on-open 'u 'f) (fact 'holomorphic-on-in-fun 'u 'f) (fact 'cc-open-subset-cc 'u)
    (cmv-ms! 'u)
    (fact 'cc-is-metric-space) (cmv-pts-cc!)
    (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
    (dk-have! (list '<= 0 R) (lambda () (dk-ineq! (list '< 'r R) '(< 0 r))))
    (dk-have! (list 'NOT (list '= 0 R)) (lambda () (di) (dk-absurd! (list '= 0 R) (list '< 'r R) '(< 0 r))))
    (cmv-and! (list 'IN R 'RR) (cmv-and! (list '<= 0 R) (list 'NOT (list '= 0 R))))
    (dk-cite! 'ball-center-in 'CC-MS 'c R)
    (fact 'subset-mem-fwd B 'u 'c)
    (fact 'fun-apply-type-c 'f 'u 'CC 'c)
    (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
    (dk-cite! 'circle-is-road 'c 'r)
    (fact 'is-road-is-path cmv-P cmv-DP 0 cmv-tp)
    (fact 'is-path-in-fun cmv-P 0 cmv-tp)
    (fact 'is-road-dgam-in-fun cmv-P cmv-DP 0 cmv-tp)
    (fact 'trace-subset-cc cmv-P 0 cmv-tp)
    (cmv-iv-ends!)
    (fact 'cif-open-minus-point 'u 'c)
    (fact 'cc-open-subset-cc D)
    (cmv-ms! D)
    (dk-have! (list 'SUBSET D 'u)
      (lambda ()
        (let* ((y (subset-by-element!))
               (iff (dk-cite! 'difference-membership 'u (list 'SINGLETON 'c) y)))
          (if (dk-only! iff (list 'IN y D)) (prop)))))
    (dk-have! (list 'SUBSET D PZ)
      (lambda ()
        (let ((y (subset-by-element!)))
          (cmv-dpt-open! 'u 'c y)
          (let ((iff2 (dk-cite! 'cc-punctured-membership 'c y)))
            (if (dk-only! iff2 (list 'IN y 'CC) (list 'NOT (list '= y 'c))) (prop))))))
    (dk-have! (list 'SUBSET cmv-T D)
      (lambda ()
        (let ((y (subset-by-element!)))
          (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R y))
          (fact 'subset-mem-fwd cmv-T 'CC y)
          (fact 'subset-mem-fwd B 'u y)
          (cmv-dpt-in! 'u 'c y))))
    (dk-cite! 'winding-integrand-holomorphic 'c)
    (dk-cite! 'cc-punctured-open 'c)
    (dk-split-all! (list (dk-cite! 'cc-ms-open-iff PZ)))
    (dk-have! (list 'IS-OPEN cmv-nfm PZ) (lambda () (prop)))
    (dk-cite! 'cc-open-subset-cc PZ)
    (cmv-ms! PZ)
    (dk-cite! 'holomorphic-on-restrict PZ kern D)
    (dk-cite! 'holomorphic-on-in-fun D KD)
    (dk-cite! 'holomorphic-on-continuous D KD)
    (dk-cite! 'holomorphic-on-restrict 'u 'f D)
    (dk-cite! 'holomorphic-on-in-fun D rfd)
    (dk-cite! 'holomorphic-on-continuous D rfd)
    (dk-have! (list 'IN cmv-K (list 'FUN D 'CC))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((y (dk-di-var!)))
              (cmv-dpt-open! 'u 'c y)
              (fact 'fun-apply-type-c 'f 'u 'CC y)
              (cmv-cc! (subst-free 'cmvw_ y (list-ref cmv-K 3)))
              (dk-ass!))))))
    (dk-have! (list 'FORALL 'cmvh_ (list 'IMPLIES (list 'IN 'cmvh_ D)
                (list '== (list cmv-K 'cmvh_) (list '* (list rfd 'cmvh_) (list KD 'cmvh_)))))
      (lambda ()
        (let ((y (dk-di-var!)))
          (cmv-dpt-open! 'u 'c y)
          (fact 'subset-mem-fwd D PZ y)
          (fact 'fun-apply-type-c 'f 'u 'CC y)
          (cmv-cc! (list 'recip (list '- y 'c)))
          (fact 'restrict-apply 'f D y)
          (fact 'restrict-apply kern D y)
          (subst (list '== (list rfd y) (list 'f y)))
          (subst (list '== (list KD y) (list kern y)))
          (dk-lam-b!)
          (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
    (dk-cite! 'aif-cont-product D rfd KD cmv-K)))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (cmv-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'cmvbr_ (cmv-imps '((IN cmvbr_ RR) (< r cmvbr_) (SUBSET (BALL CC-MS c cmvbr_) u))
      (list '= '(f c) (list '* (list 'recip cmv-tp) (list 'CC-INT cmv-g 0 cmv-tp))))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (D (cmv-dpt 'u 'c)) (lik (cmv-li cmv-K))
       (psi (list 'VNB-LAMBDA 'pat_ cmv-iv (list '* (list cmv-K (list cmv-P 'pat_)) (list cmv-DP 'pat_)))))
  (dk-cite! 'cauchy-integral-formula-centre 'u 'f 'c 'r R)
  (cmv-kernel-setup! R)
  (let* ((p1 (dk-skolem! (dk-cite! 'line-int-exists D cmv-K cmv-P cmv-DP 0 cmv-tp)))
         (p2 (dk-skolem! (dk-pick (lambda (fm) (and (cmv-op? fm 'FORSOME 3) (dk-contains? fm p1))) "the second primitive"))))
    (dk-split-all!)
    (dk-cite! 'line-int-unfold cmv-K cmv-P cmv-DP 0 cmv-tp)
    (dk-cite! 'line-int-integrand-in-fun 0 cmv-tp cmv-P cmv-DP cmv-K D)
    (dk-cite! 'line-int-in-cc D cmv-K cmv-P cmv-DP 0 cmv-tp)
    (cmv-tpi!)
    (cmv-cc! '(recip +i))
    ;; at a parameter t: the point p = c + r e^{it} of the circle, its typings
    (let ((pt! (lambda (t)
                 (let* ((e (list 'CC-EXP (list '* '+i t))) (re (list '* 'r e)) (pp (list '+ 'c re)))
                   (fact 'ccint-elt-in-rr 0 cmv-tp t)
                   (cmv-cc! pp)
                   (fact 'trace-value-in cmv-P 0 cmv-tp t)
                   (dk-have! (list '= (list cmv-P t) pp)
                     (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                   (dk-have! (list 'IN pp cmv-T) (lambda () (subst (list '= pp (list cmv-P t))) (ass)))
                   (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R pp))
                   (fact 'subset-mem-fwd (cmv-ball 'c R) 'u pp)
                   (fact 'fun-apply-type-c 'f 'u 'CC pp)
                   (cmv-dpt-in! 'u 'c pp)
                   (cmv-sub-nz! pp 'c)
                   pp))))
      (dk-have! (list 'IN cmv-g (list 'FUN cmv-iv 'CC))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((t (dk-di-var!)))
                (pt! t)
                (dk-ass!))))))
      (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ cmv-iv)
                  (list '== (list cmv-g 'pay_) (list '* '(recip +i) (list psi 'pay_)))))
        (lambda ()
          (let* ((t (dk-di-var!)) (pp (pt! t))
                 (e (list 'CC-EXP (list '* '+i t))) (re (list '* 'r e)) (fp (list 'f pp)))
            (mac 'CIRCLE-PATH)
            (mac 'CIRCLE-DERIV)
            (dk-lam-b!)
            (cmv-cc! re)
            (dk-have! (list '= (list '- pp 'c) re) (lambda () (crs)))
            (dk-have! (list 'NOT (list '= re 0)) (lambda () (subst (list '= re (list '- pp 'c))) (ass)))
            (subst (list '= (list '- pp 'c) re))
            (cmv-cc! (list 'recip re))
            (let* ((k (dk-name! (list 'recip re) 'CC)) (ri (dk-name! '(recip +i) 'CC)))
              (cmv-and! (list 'IN re 'CC) (list 'NOT (list '= re 0)))
              (dk-cite! 'cc-recip-inverse re)
              (cmv-and! '(IN +i CC) '(NOT (= +i 0)))
              (dk-cite! 'cc-recip-inverse '+i)
              (dk-have! (list '= (list '* re k) 1) (lambda () (subst (list '= k (list 'recip re))) (ass)))
              (dk-have! (list '= (list '* '+i ri) 1) (lambda () (subst (list '= ri '(recip +i))) (ass)))
              (subst (list '= (list 'recip re) k))
              (subst (list '= '(recip +i) ri))
              (let ((rhs (list '* ri (list '* (list '* fp k) (list '* '+i re)))))
                (dk-have! (list '= rhs (list '* (list '* (list '* '+i ri) (list '* re k)) fp)) (lambda () (crs)))
                (subst (list '= rhs (list '* (list '* (list '* '+i ri) (list '* re k)) fp)))
                (subst (list '= (list '* '+i ri) 1))
                (subst (list '= (list '* re k) 1))
                (dk-have! (list '= (list '* (list '* 1 1) fp) fp) (lambda () (crs)))
                (subst (list '= (list '* (list '* 1 1) fp) fp))
                (qrfl))))))
      (dk-cite! 'cc-int-complex-mul 0 cmv-tp psi cmv-g '(recip +i) p1 p2)
      ;; the constants: recip(2 pi i) = recip(2 pi) recip(i)
      (cmv-cc! (list 'recip cmv-tp))
      (dk-cite! 'cc-recip-mul cmv-tp '+i)
      (subst (list '= (list 'CC-INT cmv-g 0 cmv-tp) (list '* '(recip +i) (list 'CC-INT psi 0 cmv-tp))))
      (subst (list '== (list 'CC-INT psi 0 cmv-tp) lik))
      (let* ((a (dk-name! (list 'recip cmv-tp) 'CC))
             (b (dk-name! '(recip +i) 'CC))
             (tt (dk-name! (list 'recip cmv-tpi) 'CC))
             (l (dk-name! lik 'CC)))
        (dk-have! (list '= tt (list '* a b))
          (lambda () (subst (list '= tt (list 'recip cmv-tpi))) (subst (list '= a (list 'recip cmv-tp))) (subst (list '= b '(recip +i))) (ass)))
        (dk-have! (list '= '(f c) (list '* tt l))
          (lambda () (subst (list '= tt (list 'recip cmv-tpi))) (subst (list '= l lik)) (ass)))
        (subst (list '= (list 'recip cmv-tp) a))
        (subst (list '= '(recip +i) b))
        (subst (list '= lik l))
        (subst (list '= '(f c) (list '* tt l)))
        (subst (list '= tt (list '* a b)))
        (crs)))))
(qed 'holomorphic-mean-value)

;;; ======================================================================
;;; (7) A NON-NEGATIVE CONTINUOUS FUNCTION WITH INTEGRAL 0 VANISHES (the fact the
;;; notes' proof of 3.55 quotes)
;;; ======================================================================
(define cmv-zprem '())             ; the linear facts of the running proof, for ineq
(define (cmv-zineq! . extra) (apply dk-ineq! (append cmv-zprem extra)))
(define (cmv-ccint-in! t lo hi . extra)     ; t in [lo, hi] by ineq from cmv-zprem and EXTRA
  (dk-have! (list 'IN t (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply cmv-zineq! extra)))))))
(define (cmv-ccint-out! t lo hi)    ; lo <= t <= hi and t in RR from t in [lo, hi]
  (fact 'ccint-elt-in-rr lo hi t)
  (let ((cj (list 'AND (list '<= lo t) (list '<= t hi))))
    (if (not (and (dk-asm? (list '<= lo t)) (dk-asm? (list '<= t hi))))
        (begin
          (dk-have! cj (lambda () (mac-h 'ccint-membership (list 'IN t (list 'CCINT lo hi))) (dk-split-all!)
                                  (dk-conj-close! dk-ass!)))
          (dk-split! cj)))))

(define cmv-zh '(FORALL cmzt_ (IMPLIES (IN cmzt_ (CCINT cmza_ cmzb_)) (<= 0 (cmzh_ cmzt_)))))
(sp (make-wff (list 'FORALL 'cmzf_ (list 'FORALL 'cmzh_ (list 'FORALL 'cmza_ (list 'FORALL 'cmzb_
  (cmv-imps (list '(IS-PRIMITIVE cmzf_ cmzh_ cmza_ cmzb_) '(IS-CONTINUOUS-ON cmzh_ (CCINT cmza_ cmzb_)) cmv-zh '(= (PW-INT cmzh_ cmza_ cmzb_) 0))
    '(FORALL cmzt_ (IMPLIES (IN cmzt_ (CCINT cmza_ cmzb_)) (= (cmzh_ cmzt_) 0))))))))))
(dk-peel!)
(let* ((F 'cmzf_) (h 'cmzh_) (dom '(CCINT cmza_ cmzb_))
       (t0 (cadr (cadr (dk-goal))))
       (m (list h t0))
       (ciff (dk-cite! 'is-continuous-on h dom)))
  (dk-split-all! (list (dk-cite! 'primitive-endpoints F h 'cmza_ 'cmzb_)))
  (dk-have! (caddr ciff) (lambda () (if (dk-only! ciff (list 'IS-CONTINUOUS-ON h dom)) (prop))))
  (dk-split-all! (list (caddr ciff)))
  (cmv-ccint-out! t0 'cmza_ 'cmzb_)
  (fact 'fun-apply-type-c h dom 'RR t0)
  (dk-apply! (dk-ctx-form cmv-zh) t0)
  (dk-have! (list 'NOT (list '< 0 m))
    (lambda ()
      (di)
      (dk-cite! 'rr-pos-rr-of-lt m)
      (let* ((d (dk-halve! m))
             (S (list 'SUBSPACE-MS 'RR-MS dom))
             (cA (dk-apply! (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm 'IS-CONTINUOUS-AT) (dk-contains? fm h)))
                                     "the continuity of h on [a, b]")
                            t0))
             (iff (dk-cite! 'is-continuous-at S 'RR-MS h t0))
             (edf (let loop ((r (caddr iff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
        (dk-split-all!)
        (dk-have! edf (lambda () (if (dk-only! iff cA) (prop))))
        (let* ((dl (dk-skolem! (dk-apply! edf d)))
               (cb (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm dl))) "the continuity bound")))
          (dk-split-all!)
          (fact 'rr-pos-rr-in-rr dl)
          (fact 'rr-lt-of-pos-rr dl)
          (let ((qa (list '* 1/4 (list '- 'cmzb_ 'cmza_))))
            (cmv-rr! qa)
            (dk-have! (list '< 0 qa) (lambda () (dk-ineq! '(< cmza_ cmzb_))))
            (let ((w0 (dk-skolem! (dk-cite! 'rr-min-pos dl qa))))
              (dk-split-all!)
              (fact 'rr-is-metric-space)
              (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
              (fact 'ccint-subset-rr 'cmza_ 'cmzb_)
              (fact 'subspace-pts 'RR-MS dom)
              ;; the core, for a < p < q < b with [p, q] inside [t0 - w0, t0 + w0]
              (let ((core!
                     (lambda (p q casep)
                       (set! cmv-zprem (list (list '<= 'cmza_ t0) (list '<= t0 'cmzb_) (list '< 0 w0) (list '<= w0 qa)
                                             '(< cmza_ cmzb_) casep))
                       (let* ((hp (list 'RESTRICT h (list 'CCINT p 'cmzb_))) (Fp (list 'RESTRICT F (list 'CCINT p 'cmzb_)))
                              (ha (list 'RESTRICT h (list 'CCINT 'cmza_ p))) (Fa (list 'RESTRICT F (list 'CCINT 'cmza_ p)))
                              (mid (list 'RESTRICT hp (list 'CCINT p q))) (Fmid (list 'RESTRICT Fp (list 'CCINT p q)))
                              (hb (list 'RESTRICT hp (list 'CCINT q 'cmzb_))) (Fb (list 'RESTRICT Fp (list 'CCINT q 'cmzb_)))
                              (cn (list 'VNB-LAMBDA 'cmzs_ (list 'CCINT p q) d))
                              (Fc (list 'VNB-LAMBDA 'cmzs_ (list 'CCINT p q) (list '+ 0 (list '* d 'cmzs_))))
                              (pi (lambda (g lo hi) (list 'PW-INT g lo hi))))
                         (cmv-rr! p) (cmv-rr! q)
                         (dk-have! (list 'IN p '(OOINT cmza_ cmzb_))
                           (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (cmv-zineq!))))))
                         (dk-have! (list 'IN q (list 'OOINT p 'cmzb_))
                           (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (cmv-zineq!))))))
                         (dk-have! (list '<= 'cmza_ p) (lambda () (cmv-zineq!)))
                         (dk-have! (list '<= p 'cmzb_) (lambda () (cmv-zineq!)))
                         (dk-have! (list '<= q 'cmzb_) (lambda () (cmv-zineq!)))
                         (dk-have! '(<= cmza_ cmza_) (lambda () (cmv-zineq!)))
                         (dk-have! '(<= cmzb_ cmzb_) (lambda () (cmv-zineq!)))
                         (dk-have! (list '<= p p) (lambda () (cmv-zineq!)))
                         (dk-have! (list '<= p q) (lambda () (cmv-zineq!)))
                         (dk-have! (list '< p q) (lambda () (cmv-zineq!)))
                         (dk-have! (list '< p 'cmzb_) (lambda () (cmv-zineq!)))
                         (dk-have! (list '< q 'cmzb_) (lambda () (cmv-zineq!)))
                         (dk-have! (list '< 'cmza_ p) (lambda () (cmv-zineq!)))
                         (dk-cite! 'pw-int-adjacent 'cmza_ 'cmzb_ p F h)
                         (dk-cite! 'pw-antiderivative-restrict 'cmza_ 'cmzb_ p 'cmzb_ F h)
                         (dk-cite! 'pw-antiderivative-restrict 'cmza_ 'cmzb_ 'cmza_ p F h)
                         (dk-cite! 'pw-int-adjacent p 'cmzb_ q Fp hp)
                         (dk-cite! 'pw-antiderivative-restrict p 'cmzb_ p q Fp hp)
                         (dk-cite! 'pw-antiderivative-restrict p 'cmzb_ q 'cmzb_ Fp hp)
                         ;; a value of a restriction, down to h, at a point of [lo, hi] inside [a, b]
                         (let ((val! (lambda (t lo hi)
                                       (cmv-ccint-out! t lo hi)
                                       (cmv-ccint-in! t 'cmza_ 'cmzb_ (list '<= lo t) (list '<= t hi))
                                       (fact 'fun-apply-type-c h dom 'RR t))))
                           ;; the two outer pieces are >= 0
                           (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT 'cmza_ p)) (list '<= 0 (list ha 'pay_))))
                             (lambda ()
                               (let ((t (dk-di-var!)))
                                 (val! t 'cmza_ p)
                                 (fact 'restrict-apply h (list 'CCINT 'cmza_ p) t)
                                 (subst (list '== (list ha t) (list h t)))
                                 (dk-apply! (dk-ctx-form cmv-zh) t)
                                 (dk-ass!))))
                           (dk-cite! 'pw-int-nonneg Fa ha 'cmza_ p)
                           (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT q 'cmzb_)) (list '<= 0 (list hb 'pay_))))
                             (lambda ()
                               (let ((t (dk-di-var!)))
                                 (val! t q 'cmzb_)
                                 (cmv-ccint-in! t p 'cmzb_ (list '<= q t) (list '<= t 'cmzb_))
                                 (fact 'restrict-apply hp (list 'CCINT q 'cmzb_) t)
                                 (fact 'restrict-apply h (list 'CCINT p 'cmzb_) t)
                                 (subst (list '== (list hb t) (list hp t)))
                                 (subst (list '== (list hp t) (list h t)))
                                 (dk-apply! (dk-ctx-form cmv-zh) t)
                                 (dk-ass!))))
                           (dk-cite! 'pw-int-nonneg Fb hb q 'cmzb_)
                           ;; the middle piece is >= d (q - p)
                           (fact 'rr-is-set) (fact 'ccint-subset-rr p q) (fact 'subclass-of-set-is-set (list 'CCINT p q) 'RR)
                           (for-each
                             (lambda (lam)
                               (dk-have! (list 'IN lam (list 'FUN (list 'CCINT p q) 'RR))
                                 (lambda () (dk-lam-type! (lambda () (let ((t (dk-di-var!))) (cmv-ccint-out! t p q) (cmv-rr! (subst-free 'cmzs_ t (list-ref lam 3))) (dk-ass!)))))))
                             (list cn Fc))
                           (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT p q)) (list '== (list Fc 'pay_) (list '+ 0 (list '* d 'pay_)))))
                             (lambda () (let ((t (dk-di-var!))) (cmv-ccint-out! t p q) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
                           (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT p q)) (list '== (list cn 'pay_) d)))
                             (lambda () (let ((t (dk-di-var!))) (cmv-ccint-out! t p q) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
                           (fact 'rr-zero-in)
                           (dk-cite! 'pw-affine-antiderivative p q 0 d Fc cn)
                           (dk-cite! 'pw-int-const p q d cn)
                           (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT p q)) (list '<= (list cn 'pay_) (list mid 'pay_))))
                             (lambda ()
                               (let* ((t (dk-di-var!)) (ht (list h t)) (dt (list '- t0 t)))
                                 (val! t p q)
                                 (cmv-ccint-in! t p 'cmzb_ (list '<= p t) (list '<= t q))
                                 (fact 'restrict-apply hp (list 'CCINT p q) t)
                                 (fact 'restrict-apply h (list 'CCINT p 'cmzb_) t)
                                 (subst (list '== (list mid t) (list hp t)))
                                 (subst (list '== (list hp t) ht))
                                 (dk-lam-b!)
                                 ;; |t0 - t| <= w0 <= dl, so |h(t0) - h(t)| <= d
                                 (cmv-rr! dt)
                                 (fact 'rr-abs-closed dt)
                                 (dk-have! (list '<= (list '- w0) dt) (lambda () (cmv-zineq! (list '<= p t) (list '<= t q))))
                                 (dk-have! (list '<= dt w0) (lambda () (cmv-zineq! (list '<= p t) (list '<= t q))))
                                 (dk-have! (list '<= (list 'abs dt) w0)
                                   (lambda () (dk-cite! 'rr-abs-le-of-parts dt w0) (dk-ass!)))
                                 (dk-have! (list 'IN t (list 'PTS S)) (lambda () (subst (list '== (list 'PTS S) dom)) (dk-ass!)))
                                 (fact 'subspace-dist 'RR-MS dom t0 t)
                                 (fact 'rr-ms-dist t0 t)
                                 (dk-have! (list '<= (list (list 'DIST S) t0 t) dl)
                                   (lambda ()
                                     (subst (list '== (list (list 'DIST S) t0 t) (list '(DIST RR-MS) t0 t)))
                                     (subst (list '== (list '(DIST RR-MS) t0 t) (list 'abs dt)))
                                     (dk-ineq! (list '<= (list 'abs dt) w0) (list '<= w0 dl))))
                                 (dk-apply! cb t)
                                 (fact 'rr-ms-dist m ht)
                                 (cmv-rr! (list '- m ht))
                                 (fact 'rr-abs-closed (list '- m ht))
                                 (dk-have! (list '<= (list 'abs (list '- m ht)) d)
                                   (lambda () (subst (list '== (list 'abs (list '- m ht)) (list '(DIST RR-MS) m ht))) (dk-ass!)))
                                 (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- m ht) d)))
                                 (dk-ineq! (list '<= (list '- m ht) d) (list '= (list '+ d d) m)))))
                           (dk-cite! 'pw-int-monotone Fc cn Fmid mid p q)
                           ;; the contradiction: 0 = I1 + J1 + J2 >= d (q - p) > 0
                           (for-each (lambda (pr) (dk-cite! 'pw-int-in-rr (car pr) (cadr pr) (caddr pr) (cadddr pr)))
                                     (list (list F h 'cmza_ 'cmzb_) (list Fa ha 'cmza_ p) (list Fp hp p 'cmzb_) (list Fmid mid p q) (list Fb hb q 'cmzb_)
                                           (list Fc cn p q)))
                           (cmv-rr! (list '- q p))
                           (dk-have! (list '< 0 (list '- q p)) (lambda () (cmv-zineq!)))
                           (dk-cite! 'rr-mul-pos d (list '- q p))
                           (cmv-rr! (list '* d (list '- q p)))
                           (dk-absurd! (list '= (pi h 'cmza_ 'cmzb_) (list '+ (pi ha 'cmza_ p) (pi hp p 'cmzb_)))
                                       (list '= (pi hp p 'cmzb_) (list '+ (pi mid p q) (pi hb q 'cmzb_)))
                                       (list '= (pi h 'cmza_ 'cmzb_) 0)
                                       (list '<= 0 (pi ha 'cmza_ p)) (list '<= 0 (pi hb q 'cmzb_))
                                       (list '<= (pi cn p q) (pi mid p q))
                                       (list '= (pi cn p q) (list '* d (list '- q p)))
                                       (list '< 0 (list '* d (list '- q p)))))))))
                (use-em (list '<= (list '* 2 t0) '(+ cmza_ cmzb_))
                  (lambda () (core! (list '+ t0 (list '* 1/4 w0)) (list '+ t0 (list '* 1/2 w0)) (list '<= (list '* 2 t0) '(+ cmza_ cmzb_))))
                  (lambda ()
                    (cmv-rr! (list '* 2 t0)) (cmv-rr! '(+ cmza_ cmzb_))
                    (dk-cite! 'rr-not-le-lt (list '* 2 t0) '(+ cmza_ cmzb_))
                    (core! (list '- t0 (list '* 1/2 w0)) (list '- t0 (list '* 1/4 w0)) (list '< '(+ cmza_ cmzb_) (list '* 2 t0))))))))))))
  (use-em (list '= m 0)
    (lambda () (dk-ass!))
    (lambda ()
      (fact 'neq-sym m 0)
      (cmv-and! (list '<= 0 m) (list 'NOT (list '= 0 m)))
      (dk-cite! 'rr-le-ne-lt 0 m)
      (ai (list 'NOT (list '< 0 m))))))
(qed 'pw-int-nonneg-zero)
(set! cmv-zprem '())

;;; ======================================================================
;;; (8) |f| <= |f(c)| ON A CIRCLE ABOUT c FORCES f = f(c) ON THE CIRCLE (the notes'
;;; proof of 3.55 at one radius: rotate f(c) to |f(c)| = M, apply the mean value
;;; property to psi = M - lambda f, whose real part is >= 0 on the circle with mean 0)
;;; ======================================================================
;;; x <= y and y <= x by ineq from PREMS: land x = y
(define (cmv-eq-by-le! x y . prems)
  (dk-have! (list '<= x y) (lambda () (apply dk-ineq! prems)))
  (dk-have! (list '<= y x) (lambda () (apply dk-ineq! prems)))
  (cmv-and! (list 'IN x 'RR) (list 'IN y 'RR))
  (cmv-and! (list '<= x y) (list '<= y x))
  (dk-cite! 'rr-leq-antisymmetric x y))

;;; the point c + r e^{it} of the circle, t in [0, 2 pi] in context: its typings, in the
;;; trace, in B(c, R), in u, f there typed; returns the point
(define (cmv-cpt! t R)
  (let* ((e (list 'CC-EXP (list '* '+i t))) (re (list '* 'r e)) (pp (list '+ 'c re)))
    (fact 'ccint-elt-in-rr 0 cmv-tp t)
    (cmv-cc! pp)
    (fact 'trace-value-in cmv-P 0 cmv-tp t)
    (if (not (dk-asm? (list '= (list cmv-P t) pp)))
        (dk-have! (list '= (list cmv-P t) pp)
          (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))
    (if (not (dk-asm? (list 'IN pp cmv-T)))
        (dk-have! (list 'IN pp cmv-T) (lambda () (subst (list '= pp (list cmv-P t))) (ass))))
    (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R pp))
    (fact 'subset-mem-fwd (cmv-ball 'c R) 'u pp)
    (fact 'fun-apply-type-c 'f 'u 'CC pp)
    pp))

(define cmv-mbound '(FORALL cmvy_ (IMPLIES (IN cmvy_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)))
                       (<= (magnitude (f cmvy_)) (magnitude (f c))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (cmv-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'cmvbr_ (cmv-imps (list '(IN cmvbr_ RR) '(< r cmvbr_) '(SUBSET (BALL CC-MS c cmvbr_) u) cmv-mbound)
      (list 'FORALL 'cmvt_ (list 'IMPLIES (list 'IN 'cmvt_ cmv-iv)
        '(= (f (+ c (* r (CC-EXP (* +i cmvt_))))) (f c)))))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (B (cmv-ball 'c R)) (t0 'cmvt_)
       (fc '(f c)) (M '(magnitude (f c))))
  ;; the standing facts
  (fact 'holomorphic-on-open 'u 'f) (fact 'holomorphic-on-in-fun 'u 'f) (fact 'cc-open-subset-cc 'u)
  (cmv-ms! 'u)
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! (list '<= 0 R) (lambda () (dk-ineq! (list '< 'r R) '(< 0 r))))
  (dk-have! (list 'NOT (list '= 0 R)) (lambda () (di) (dk-absurd! (list '= 0 R) (list '< 'r R) '(< 0 r))))
  (cmv-and! (list 'IN R 'RR) (cmv-and! (list '<= 0 R) (list 'NOT (list '= 0 R))))
  (dk-cite! 'ball-center-in 'CC-MS 'c R)
  (fact 'subset-mem-fwd B 'u 'c)
  (fact 'fun-apply-type-c 'f 'u 'CC 'c)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path cmv-P cmv-DP 0 cmv-tp)
  (fact 'is-path-in-fun cmv-P 0 cmv-tp)
  (fact 'trace-subset-cc cmv-P 0 cmv-tp)
  (cmv-iv-ends!)
  (dk-have! (list 'SUBSET cmv-T 'u)
    (lambda ()
      (let ((y (subset-by-element!)))
        (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R y))
        (fact 'subset-mem-fwd B 'u y)
        (dk-ass!))))
  (cmv-rr! M)
  (fact 'cc-magnitude-nonneg fc)
  (let* ((p0 (cmv-cpt! t0 R)) (fp0 (list 'f p0)) (mp0 (list 'magnitude fp0)))
    (dk-apply! (dk-ctx-form cmv-mbound) p0)
    (cmv-rr! mp0)
    (fact 'cc-magnitude-nonneg fp0)
    (use-em (list '= M 0)
      ;; M = 0: f vanishes at c and at p0
      (lambda ()
        (cmv-eq-by-le! mp0 0 (list '<= mp0 M) (list '= M 0) (list '<= 0 mp0))
        (dk-split-all! (list (dk-cite! 'cc-magnitude-zero-iff fp0)))
        (dk-split-all! (list (dk-cite! 'cc-magnitude-zero-iff fc)))
        (dk-have! (list '= fp0 0) (lambda () (prop)))
        (dk-have! (list '= fc 0) (lambda () (prop)))
        (subst (list '= fp0 0))
        (subst (list '= fc 0))
        (rfl))
      ;; M > 0: rotate
      (lambda ()
        (fact 'neq-sym M 0)
        (cmv-and! (list '<= 0 M) (list 'NOT (list '= 0 M)))
        (dk-cite! 'rr-le-ne-lt 0 M)
        (cmv-and! (list 'IN M 'RR) (list 'NOT (list '= M 0)))
        (dk-cite! 'rr-recip-closed M)
        (dk-cite! 'rr-recip-inverse M)
        (dk-cite! 'rr-recip-pos M)
        (let* ((kk (dk-name! (list 'recip M) 'RR))
               (cf (list 'conjugate fc))
               (lam (list '* cf kk))
               (psi (list 'VNB-LAMBDA 'cmvw_ 'u (list '+ M (list '* (list '- lam) '(f cmvw_)))))
               (cst (list 'VNB-LAMBDA 'hbx_ 'u M))
               (cng (list 'VNB-LAMBDA 'hbx_ 'u (list '- lam)))
               (prd (list 'VNB-LAMBDA 'cmvz_ 'u (list '* (list '- lam) '(f cmvz_))))
               (gpsi (list 'VNB-LAMBDA 'cmvt_ cmv-iv (list psi '(+ c (* r (CC-EXP (* +i cmvt_)))))))
               (h2R (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'real-part (list psi (list cmv-P 'pat_)))))
               (h2I (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'imag-part (list psi (list cmv-P 'pat_)))))
               (hR (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'real-part (list gpsi 'pat_))))
               (hI (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'imag-part (list gpsi 'pat_)))))
          (dk-have! (list '= (list '* M kk) 1) (lambda () (subst (list '= kk (list 'recip M))) (dk-ass!)))
          (dk-have! (list '< 0 kk) (lambda () (subst (list '= kk (list 'recip M))) (dk-ass!)))
          (fact 'cc-conjugate-closed fc)
          (fact 'rr-subset-cc kk) (fact 'rr-subset-cc M)
          (cmv-cc! lam) (cmv-cc! (list '- lam))
          ;; lambda f(c) = M and |lambda| = 1
          (dk-cite! 'cc-magnitude-sq-conjugate fc)
          (dk-have! (list '= (list '* lam fc) M)
            (lambda ()
              (dk-have! (list '= (list '* lam fc) (list '* (list '* fc cf) kk)) (lambda () (crs)))
              (subst (list '= (list '* lam fc) (list '* (list '* fc cf) kk)))
              (subst (list '= (list '* fc cf) (list '* M M)))
              (dk-have! (list '= (list '* (list '* M M) kk) (list '* M (list '* M kk))) (lambda () (crs)))
              (subst (list '= (list '* (list '* M M) kk) (list '* M (list '* M kk))))
              (subst (list '= (list '* M kk) 1))
              (crs)))
          (cmv-and! (list 'IN cf 'CC) (list 'IN kk 'CC))
          (dk-cite! 'cc-magnitude-mul cf kk)
          (dk-cite! 'cc-magnitude-conjugate fc)
          (dk-cite! 'rr-magnitude-is-abs kk)
          (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk))))
          (dk-cite! 'rr-abs-of-nonneg kk)
          (cmv-rr! (list 'magnitude lam))
          (dk-have! (list '= (list 'magnitude lam) 1)
            (lambda ()
              (subst (list '= (list 'magnitude lam) (list '* (list 'magnitude cf) (list 'magnitude kk))))
              (subst (list '= (list 'magnitude cf) M))
              (subst (list '= (list 'magnitude kk) (list 'abs kk)))
              (subst (list '= (list 'abs kk) kk))
              (dk-ass!)))
          (dk-have! (list 'NOT (list '= lam 0))
            (lambda ()
              (di)
              (dk-have! (list '= (list 'magnitude lam) 0)
                (lambda () (subst (list '= lam 0)) (fact 'cc-magnitude-zero) (dk-ass!)))
              (dk-absurd! (list '= (list 'magnitude lam) 0) (list '= (list 'magnitude lam) 1))))
          ;; psi = M - lambda f is holomorphic on u, and psi(c) = 0
          (cmv-cc! M)
          (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
          (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
          (dk-cite! 'holomorphic-const 'u M)
          (dk-cite! 'holomorphic-const 'u (list '- lam))
          (for-each
            (lambda (lm)
              (dk-have! (list 'IN lm '(FUN u CC))
                (lambda ()
                  (dk-lam-type!
                    (lambda ()
                      (let ((y (dk-di-var!)))
                        (fact 'fun-apply-type-c 'f 'u 'CC y)
                        (cmv-cc! (subst-free (cadr lm) y (list-ref lm 3)))
                        (dk-ass!)))))))
            (list psi prd))
          (let ((ptw (lambda (h rhs) (list 'FORALL 'cmvh_ (list 'IMPLIES '(IN cmvh_ u) (list '== (list h 'cmvh_) (rhs 'cmvh_)))))))
            (dk-have! (ptw prd (lambda (x) (list '* (list cng x) (list 'f x))))
              (lambda () (let ((y (dk-di-var!))) (fact 'fun-apply-type-c 'f 'u 'CC y) (dk-lam-b!)
                           (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
            (dk-cite! 'holomorphic-product 'u cng 'f prd)
            (dk-have! (ptw psi (lambda (x) (list '+ (list cst x) (list prd x))))
              (lambda () (let ((y (dk-di-var!))) (fact 'fun-apply-type-c 'f 'u 'CC y) (dk-lam-b!)
                           (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
            (dk-cite! 'holomorphic-sum 'u cst prd psi))
          (dk-cite! 'holomorphic-on-continuous 'u psi)
          (dk-cite! 'holomorphic-mean-value 'u psi 'c 'r R)
          (dk-have! (list '= (list psi 'c) 0)
            (lambda ()
              (dk-lam-b!)
              (dk-have! (list '= (list '+ M (list '* (list '- lam) fc)) (list '- M (list '* lam fc))) (lambda () (crs)))
              (subst (list '= (list '+ M (list '* (list '- lam) fc)) (list '- M (list '* lam fc))))
              (subst (list '= (list '* lam fc) M))
              (crs)))
          ;; so the integral of psi round the circle is 0
          (cmv-tpi!)
          (cmv-cc! (list 'recip cmv-tp))
          (let* ((X (list 'CC-INT gpsi 0 cmv-tp)))
            (dk-split-all! (list (dk-cite! 'continuous-on-compose-regulated 'u psi cmv-P 0 cmv-tp)))
            (dk-split-all! (list (dk-cite! 'continuous-on-compose-path 'u psi cmv-P 0 cmv-tp)))
            (let* ((q1 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 cmv-tp h2R)))
                   (q2 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 cmv-tp h2I))))
              ;; the real and imaginary parts of the two spellings of the integrand agree
              (for-each
                (lambda (h2 h pr)
                  (dk-have! (list 'IN h (list 'FUN cmv-iv 'RR))
                    (lambda ()
                      (dk-lam-type!
                        (lambda ()
                          (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)))
                            (dk-lam-b!)
                            (cmv-rr! (list pr (list '+ M (list '* (list '- lam) (list 'f pt)))))
                            (dk-ass!))))))
                  (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ cmv-iv) (list '== (list h2 'pay_) (list h 'pay_))))
                    (lambda ()
                      (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)))
                        (mac 'CIRCLE-PATH)
                        (dk-lam-b!)
                        (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
                  (dk-cite! 'pw-int-congruence (if (eq? pr 'real-part) q1 q2) h2 h 0 cmv-tp)
                  (dk-cite! 'pw-int-in-rr (if (eq? pr 'real-part) q1 q2) h2 0 cmv-tp))
                (list h2R h2I) (list hR hI) (list 'real-part 'imag-part))
              (dk-cite! 'cc-int-unfold gpsi 0 cmv-tp)
              (let* ((A (list 'PW-INT hR 0 cmv-tp)) (Bi (list 'PW-INT hI 0 cmv-tp))
                     (A2 (list 'PW-INT h2R 0 cmv-tp)) (B2 (list 'PW-INT h2I 0 cmv-tp))
                     (rt (dk-name! (list 'recip cmv-tp) 'CC)))
                (dk-have! (list 'IN A 'RR) (lambda () (subst (list '= A A2)) (dk-ass!)))
                (dk-have! (list 'IN Bi 'RR) (lambda () (subst (list '= Bi B2)) (dk-ass!)))
                (cmv-cc! (list '+ A (list '* Bi '+i)))
                (cmv-and! (list 'IN cmv-tp 'CC) (list 'NOT (list '= cmv-tp 0)))
                (dk-cite! 'cc-recip-inverse cmv-tp)
                (dk-have! (list '= (list '* cmv-tp rt) 1) (lambda () (subst (list '= rt (list 'recip cmv-tp))) (dk-ass!)))
                (let ((xx (dk-name! (list '+ A (list '* Bi '+i)) 'CC)))
                  (dk-have! (list '= (list '* rt xx) 0)
                    (lambda ()
                      (subst (list '= xx (list '+ A (list '* Bi '+i))))
                      (subst (list '== (list '+ A (list '* Bi '+i)) X))
                      (subst (list '= rt (list 'recip cmv-tp)))
                      (subst (list '= (list '* (list 'recip cmv-tp) X) (list psi 'c)))
                      (dk-ass!)))
                  (dk-have! (list '= xx 0)
                    (lambda ()
                      (dk-have! (list '= xx (list '* (list '* cmv-tp rt) xx)) (lambda () (subst (list '= (list '* cmv-tp rt) 1)) (crs)))
                      (subst (list '= xx (list '* (list '* cmv-tp rt) xx)))
                      (dk-have! (list '= (list '* (list '* cmv-tp rt) xx) (list '* cmv-tp (list '* rt xx))) (lambda () (crs)))
                      (subst (list '= (list '* (list '* cmv-tp rt) xx) (list '* cmv-tp (list '* rt xx))))
                      (subst (list '= (list '* rt xx) 0))
                      (crs)))
                  ;; real part: A = 0
                  (dk-have! (list '= 0 (list '+ A (list '* Bi '+i)))
                    (lambda () (subst (list '= (list '+ A (list '* Bi '+i)) xx)) (subst (list '= xx 0)) (rfl)))
                  (fact 'cc-zero-in) (fact 'rr-zero-in)
                  (dk-split-all! (list (dk-cite! 'cc-re-im-of 0 A Bi)))
                  (dk-have! (list '= 0 (list '+ 0 (list '* 0 '+i))) (lambda () (crs)))
                  (dk-split-all! (list (dk-cite! 'cc-re-im-of 0 0 0)))
                  (dk-have! (list '= A2 0)
                    (lambda () (subst (list '= A2 A)) (subst (list '= A (list 'real-part 0))) (dk-ass!)))))
              ;; the real part of psi round the circle is >= 0
              (let ((dec!
                     (lambda (pt)    ; land rz, iz, W = psi(pt) reduced, re(W) = M - rz, |z| = |f(pt)|; return (W rz iz z)
                       (let* ((fpt (list 'f pt)) (z (list '* lam fpt))
                              (W (list '+ M (list '* (list '- lam) fpt))))
                         (cmv-cc! z) (cmv-cc! W)
                         (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
                         (fact 'cc-re-im-decompose z)
                         (let* ((rz (dk-name! (list 'real-part z) 'RR)) (iz (dk-name! (list 'imag-part z) 'RR)))
                           (dk-have! (list '= z (list '+ rz (list '* '+i iz)))
                             (lambda () (subst (list '= rz (list 'real-part z))) (subst (list '= iz (list 'imag-part z))) (dk-ass!)))
                           (cmv-rr! (list '- M rz)) (cmv-rr! (list '- iz))
                           (let ((X (list '+ (list '- M rz) (list '* (list '- iz) '+i))))
                             (cmv-cc! X) (cmv-cc! (list '- M z))
                             (dk-have! (list '= W (list '- M z)) (lambda () (crs)))
                             (dk-have! (list '= (list '- M z) X)
                               (lambda () (subst (list '= z (list '+ rz (list '* '+i iz)))) (crs)))
                             (dk-have! (list '= W X)
                               (lambda () (subst (list '= W (list '- M z))) (dk-ass!))))
                           (dk-split-all! (list (dk-cite! 'cc-re-im-of W (list '- M rz) (list '- iz))))
                           ;; |z| = |f(pt)|
                           (cmv-and! (list 'IN lam 'CC) (list 'IN fpt 'CC))
                           (dk-cite! 'cc-magnitude-mul lam fpt)
                           (cmv-rr! (list 'magnitude z)) (cmv-rr! (list 'magnitude fpt))
                           (dk-have! (list '= (list 'magnitude z) (list 'magnitude fpt))
                             (lambda ()
                               (subst (list '= (list 'magnitude z) (list '* (list 'magnitude lam) (list 'magnitude fpt))))
                               (subst (list '= (list 'magnitude lam) 1))
                               (crs)))
                           (dk-cite! 'cc-abs-re-le-magnitude z)
                           (dk-cite! 'rr-le-abs (list 'real-part z))
                           (fact 'rr-abs-closed (list 'real-part z))
                           (dk-have! (list '<= rz (list 'magnitude z))
                             (lambda ()
                               (subst (list '= rz (list 'real-part z)))
                               (dk-ineq! (list '<= (list 'real-part z) (list 'abs (list 'real-part z)))
                                         (list '<= (list 'abs (list 'real-part z)) (list 'magnitude z)))))
                           (list W rz iz z))))))
                (dk-have! (list 'FORALL 'cmzt_ (list 'IMPLIES (list 'IN 'cmzt_ cmv-iv) (list '<= 0 (list h2R 'cmzt_))))
                  (lambda ()
                    (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)) (fpt (list 'f pt)))
                      (dk-apply! (dk-ctx-form cmv-mbound) pt)
                      (let* ((dd (dec! pt)) (W (car dd)) (rz (cadr dd)) (z (cadddr dd)))
                        (mac 'CIRCLE-PATH)
                        (dk-lam-b!)
                        (subst (list '= (list 'real-part W) (list '- M rz)))
                        (dk-ineq! (list '<= rz (list 'magnitude z)) (list '= (list 'magnitude z) (list 'magnitude fpt))
                                  (list '<= (list 'magnitude fpt) M))))))
                (dk-cite! 'pw-int-nonneg-zero q1 h2R 0 cmv-tp)
                ;; at t0: re(psi(p0)) = 0, so lambda f(p0) = M = lambda f(c)
                (let* ((dd (dec! p0)) (W (car dd)) (rz (cadr dd)) (iz (caddr dd)) (z (cadddr dd))
                       (mz (list 'magnitude z)))
                  (dk-have! (list '= (list 'real-part W) 0)
                    (lambda ()
                      (dk-have! (list '= (list h2R t0) (list 'real-part W))
                        (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                      (subst (list '= (list 'real-part W) (list h2R t0)))
                      (dk-apply! (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm h2R) (dk-contains? fm '=)))
                                          "h2R vanishes")
                                 t0)
                      (dk-ass!)))
                  (dk-have! (list '= (list '- M rz) 0) (lambda () (subst (list '= (list '- M rz) (list 'real-part W))) (dk-ass!)))
                  ;; |z| <= M and |z|^2 = rz^2 + iz^2 = M^2 + iz^2: iz = 0
                  (dk-cite! 'cc-magnitude-sq z)
                  (cmv-rr! (list '* mz mz)) (cmv-rr! (list '* iz iz)) (cmv-rr! (list '* M M)) (cmv-rr! (list '* rz rz))
                  (fact 'cc-magnitude-nonneg z)
                  (dk-have! (list '<= mz M) (lambda () (dk-ineq! (list '= mz (list 'magnitude fp0)) (list '<= (list 'magnitude fp0) M))))
                  (cmv-and! (list '<= mz M) (list '<= 0 mz))
                  (dk-cite! 'rr-mul-le-right mz M mz)
                  (cmv-and! (list '<= mz M) (list '<= 0 M))
                  (dk-cite! 'rr-mul-le-right mz M M)
                  (cmv-rr! (list '* M mz))
                  (cmv-eq-by-le! rz M (list '= (list '- M rz) 0))
                  (dk-have! (list '= (list '* mz mz) (list '+ (list '* rz rz) (list '* iz iz)))
                    (lambda () (subst (list '= rz (list 'real-part z))) (subst (list '= iz (list 'imag-part z))) (dk-ass!)))
                  (dk-have! (list '= (list '* rz rz) (list '* M M)) (lambda () (subst (list '= rz M)) (crs)))
                  (cmv-rr! (list '* mz M))
                  (dk-have! (list '= (list '* M mz) (list '* mz M)) (lambda () (crs)))
                  (dk-have! (list '= (list '* 0 0) 0) (lambda () (crs)))
                  (dk-have! (list '<= (list '* iz iz) (list '* 0 0))
                    (lambda () (cmv-rr! (list '* 0 0))
                               (dk-ineq! (list '= (list '* mz mz) (list '+ (list '* rz rz) (list '* iz iz)))
                                         (list '= (list '* rz rz) (list '* M M))
                                         (list '<= (list '* mz mz) (list '* M mz)) (list '<= (list '* mz M) (list '* M M))
                                         (list '= (list '* M mz) (list '* mz M)) (list '= (list '* 0 0) 0))))
                  (fact 'rr-zero-in)
                  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                  (dk-cite! 'rr-le-of-sq-le iz 0)
                  (dk-have! (list '<= (list '* (list '- iz) (list '- iz)) (list '* 0 0))
                    (lambda () (dk-have! (list '= (list '* (list '- iz) (list '- iz)) (list '* iz iz)) (lambda () (crs)))
                               (subst (list '= (list '* (list '- iz) (list '- iz)) (list '* iz iz))) (dk-ass!)))
                  (dk-cite! 'rr-le-of-sq-le (list '- iz) 0)
                  (cmv-eq-by-le! iz 0 (list '<= iz 0) (list '<= (list '- iz) 0))
                  (dk-have! (list '= z M)
                    (lambda () (subst (list '= z (list '+ rz (list '* '+i iz)))) (subst (list '= rz M)) (subst (list '= iz 0)) (crs)))
                  ;; cancel lambda
                  (cmv-and! (list 'IN lam 'CC) (list 'NOT (list '= lam 0)))
                  (dk-cite! 'cc-recip-inverse lam)
                  (cmv-cc! (list 'recip lam))
                  (let ((il (dk-name! (list 'recip lam) 'CC)))
                    (dk-have! (list '= (list '* lam il) 1) (lambda () (subst (list '= il (list 'recip lam))) (dk-ass!)))
                    (dk-have! (list '= fp0 (list '* (list '* lam il) fp0)) (lambda () (subst (list '= (list '* lam il) 1)) (crs)))
                    (subst (list '= fp0 (list '* (list '* lam il) fp0)))
                    (dk-have! (list '= (list '* (list '* lam il) fp0) (list '* il z)) (lambda () (crs)))
                    (subst (list '= (list '* (list '* lam il) fp0) (list '* il z)))
                    (subst (list '= z M))
                    (subst (list '= M (list '* lam fc)))
                    (dk-have! (list '= (list '* il (list '* lam fc)) (list '* (list '* lam il) fc)) (lambda () (crs)))
                    (subst (list '= (list '* il (list '* lam fc)) (list '* (list '* lam il) fc)))
                    (subst (list '= (list '* lam il) 1))
                    (crs)))))))))))
(qed 'holomorphic-circle-max-constant)

;;; ======================================================================
;;; (9) THE MAXIMUM MODULUS PRINCIPLE ON A DISC (3.55 in its disc form): f holomorphic on
;;; u, the open disc B(c, R) inside u, |f| <= |f(c)| on the disc: f is constant on it.
;;; Every point of the disc lies on a circle about c of radius < R (polar form), and (8)
;;; applies on that circle.  The open-set form of 3.55 needs connectedness, which the tree
;;; does not have (week 1, gap item 1).
;;; ======================================================================
(define cmv-dbound '(FORALL cmvz_ (IMPLIES (IN cmvz_ (BALL CC-MS c cmvbr_)) (<= (magnitude (f cmvz_)) (magnitude (f c))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
    (list 'FORALL 'cmvbr_ (cmv-imps (list '(IN cmvbr_ RR) '(< 0 cmvbr_) '(SUBSET (BALL CC-MS c cmvbr_) u) cmv-dbound)
      '(FORALL cmvz_ (IMPLIES (IN cmvz_ (BALL CC-MS c cmvbr_)) (= (f cmvz_) (f c)))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (B (cmv-ball 'c R))
       (z0 (cadr (cadr (dk-goal))))
       (dz (list '- z0 'c)) (rho (list 'magnitude dz)))
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (fact 'holomorphic-on-open 'u 'f)
  (fact 'cc-open-subset-cc 'u)
  (fact 'holomorphic-on-in-fun 'u 'f)
  (fact 'subset-mem-fwd B 'u z0)
  (fact 'subset-mem-fwd 'u 'CC z0)
  (fact 'fun-apply-type-c 'f 'u 'CC z0)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  (use-em (list '= z0 'c)
    (lambda () (subst (list '= 'c z0)) (rfl))
    (lambda ()
      (cmv-cc! dz)
      (cmv-rr! rho)
      (fact 'cc-magnitude-nonneg dz)
      ;; rho < R
      (dk-have! (list '< rho R)
        (lambda ()
          (let ((iff (dk-cite! 'ball-membership 'CC-MS 'c R z0)))
            (fact 'cc-ms-dist 'c z0)
            (cmv-cc! (list '- 'c z0))
            (dk-cite! 'cc-magnitude-sub-sym 'c z0)
            (cmv-rr! (list 'magnitude (list '- 'c z0)))
            (dk-have! (list 'AND (list '<= (list '(DIST CC-MS) 'c z0) R) (list 'NOT (list '= (list '(DIST CC-MS) 'c z0) R)))
              (lambda () (if (dk-only! iff (list 'IN z0 B)) (prop))))
            (dk-split-all!)
            (dk-have! (list '<= rho R)
              (lambda () (subst (list '= rho (list 'magnitude (list '- 'c z0)))) (subst (list '== (list 'magnitude (list '- 'c z0)) (list '(DIST CC-MS) 'c z0))) (dk-ass!)))
            (dk-have! (list 'NOT (list '= rho R))
              (lambda () (subst (list '= rho (list 'magnitude (list '- 'c z0)))) (subst (list '== (list 'magnitude (list '- 'c z0)) (list '(DIST CC-MS) 'c z0))) (dk-ass!)))
            (cmv-and! (list '<= rho R) (list 'NOT (list '= rho R)))
            (dk-cite! 'rr-le-ne-lt rho R)
            (dk-ass!))))
      ;; z0 - c /= 0, so rho > 0, and the polar form z0 - c = s e^{i th}
      (cmv-sub-nz! z0 'c)
      (let ((ziff (dk-cite! 'cc-magnitude-zero-iff dz)))
        (dk-have! (list 'NOT (list '= 0 rho))
          (lambda () (di) (fact 'eq-sym 0 rho)
                     (if (dk-only! (list '= rho 0) (list 'NOT (list '= dz 0)) ziff) (prop)))))
      (dk-have! (list '< 0 rho)
        (lambda ()
          (cmv-and! (list '<= 0 rho) (list 'NOT (list '= 0 rho)))
          (dk-cite! 'rr-le-ne-lt 0 rho)
          (dk-ass!)))
      (let* ((sr (dk-skolem! (dk-cite! 'cc-polar-form dz)))
             (th (begin (dk-split-all!) (dk-skolem! (dk-pick (lambda (fm) (and (cmv-op? fm 'FORSOME 3) (dk-contains? fm sr))) "the angle")))))
        (dk-split-all!)
        (let* ((e (list 'CC-EXP (list '* '+i th))))
          (cmv-cc! e)
          (fact 'cc-exp-magnitude-imaginary th)
          (fact 'rr-subset-cc sr)
          (cmv-and! (list 'IN sr 'CC) (list 'IN e 'CC))
          (dk-cite! 'cc-magnitude-mul sr e)
          (dk-cite! 'rr-magnitude-is-abs sr)
          (dk-have! (list '<= 0 sr) (lambda () (dk-ineq! (list '< 0 sr))))
          (dk-cite! 'rr-abs-of-nonneg sr)
          (dk-have! (list '= rho sr)
            (lambda ()
              (subst (list '= dz (list '* sr e)))
              (subst (list '= (list 'magnitude (list '* sr e)) (list '* (list 'magnitude sr) (list 'magnitude e))))
              (subst (list '= (list 'magnitude e) 1))
              (subst (list '= (list 'magnitude sr) (list 'abs sr)))
              (subst (list '= (list 'abs sr) sr))
              (crs)))
          ;; the circle of radius rho inside B(c, R') with R' = (rho + R)/2
          (let ((R2 (list '* 1/2 (list '+ rho R))))
            (cmv-rr! R2)
            (dk-have! (list '< rho R2) (lambda () (dk-ineq! (list '< rho R))))
            (dk-have! (list '< 0 R2) (lambda () (dk-ineq! (list '< rho R) (list '< 0 rho))))
            (dk-have! (list 'SUBSET (cmv-ball 'c R2) 'u)
              (lambda ()
                (let* ((y (subset-by-element!))
                       (iff (dk-cite! 'ball-membership 'CC-MS 'c R2 y)))
                  (dk-have! (list 'AND (list 'IN y '(PTS CC-MS)) (list 'AND (list '<= (list '(DIST CC-MS) 'c y) R2) (list 'NOT (list '= (list '(DIST CC-MS) 'c y) R2))))
                    (lambda () (if (dk-only! iff (list 'IN y (cmv-ball 'c R2))) (prop))))
                  (dk-split-all!)
                  (dk-have! (list 'IN y B)
                    (lambda ()
                      (mac 'ball-membership)
                      (fact 'subset-mem-fwd '(PTS CC-MS) 'CC y)
                      (dk-have! (list 'IN y 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (dk-ass!)))
                      (fact 'cc-ms-dist 'c y)
                      (cmv-cc! (list '- 'c y))
                      (cmv-rr! (list 'magnitude (list '- 'c y)))
                      (dk-have! (list '<= (list 'magnitude (list '- 'c y)) R2)
                        (lambda () (subst (list '== (list 'magnitude (list '- 'c y)) (list '(DIST CC-MS) 'c y))) (dk-ass!)))
                      (subst (list '== (list '(DIST CC-MS) 'c y) (list 'magnitude (list '- 'c y))))
                      (dk-conj-close!
                        (lambda ()
                          (let ((g2 (dk-goal)))
                            (cond ((dk-asm? g2) (ass))
                                  ((eq? (cmv-hd g2) 'NOT) (di) (dk-absurd! (list '= (list 'magnitude (list '- 'c y)) R) (list '<= (list 'magnitude (list '- 'c y)) R2) (list '< rho R)))
                                  (#t (dk-ineq! (list '<= (list 'magnitude (list '- 'c y)) R2) (list '< rho R)))))))))
                  (fact 'subset-mem-fwd B 'u y)
                  (dk-ass!))))
            ;; |f| <= |f(c)| on that circle
            (dk-have! (list 'FORALL 'cmvy_ (list 'IMPLIES (list 'IN 'cmvy_ (list 'TRACE (list 'CIRCLE-PATH 'c rho) 0 cmv-tp))
                        '(<= (magnitude (f cmvy_)) (magnitude (f c)))))
              (lambda ()
                (let ((y (dk-di-var!)))
                  (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c rho R y))
                  (dk-apply! (dk-ctx-form cmv-dbound) y)
                  (dk-ass!))))
            (dk-cite! 'holomorphic-circle-max-constant 'u 'f 'c rho R2)
            ;; the parameter of z0 on the circle: th, or th + 2 pi
            (let ((fin! (lambda (t)
                          ;; t in [0, 2 pi] and e^{i t} = e^{i th} in context
                          (dk-apply! (dk-pick (lambda (fm) (and (cmv-op? fm 'FORALL 3) (dk-contains? fm 'CC-EXP) (dk-contains? fm rho)
                                                                (dk-contains? fm '(f c))))
                                              "constancy on the circle")
                                     t)
                          (dk-have! (list '= z0 (list '+ 'c (list '* rho (list 'CC-EXP (list '* '+i t)))))
                            (lambda ()
                              (if (not (equal? t th)) (subst (list '= (list 'CC-EXP (list '* '+i t)) e)))
                              (subst (list '= rho sr))
                              (dk-have! (list '= z0 (list '+ 'c dz)) (lambda () (crs)))
                              (subst (list '= z0 (list '+ 'c dz)))
                              (subst (list '= dz (list '* sr e)))
                              (crs)))
                          (subst (list '= z0 (list '+ 'c (list '* rho (list 'CC-EXP (list '* '+i t))))))
                          (dk-ass!))))
              (cmv-iv-ends!)
              (use-em (list '<= 0 th)
                (lambda ()
                  (cmv-ccint-in! th 0 cmv-tp (list '<= 0 th) (list '< th 'PI) (list '< 0 'PI))
                  (fin! th))
                (lambda ()
                  (cmv-rr! 0) (cmv-rr! th)
                  (dk-cite! 'rr-not-le-lt 0 th)
                  (let ((t (list '+ th cmv-tp)))
                    (cmv-rr! t)
                    (cmv-ccint-in! t 0 cmv-tp (list '< th 0) (list '<= (list '- 'PI) th) (list '< 0 'PI))
                    (cmv-cc! (list '* '+i th)) (cmv-cc! (list '* cmv-tp '+i))
                    (dk-cite! 'cc-exp-add (list '* '+i th) (list '* cmv-tp '+i))
                    (fact 'cc-exp-two-pi-i)
                    (dk-have! (list '= (list 'CC-EXP (list '* '+i t)) e)
                      (lambda ()
                        (dk-have! (list '= (list '* '+i t) (list '+ (list '* '+i th) (list '* cmv-tp '+i))) (lambda () (crs)))
                        (subst (list '= (list '* '+i t) (list '+ (list '* '+i th) (list '* cmv-tp '+i))))
                        (subst (list '= (list 'CC-EXP (list '+ (list '* '+i th) (list '* cmv-tp '+i)))
                                     (list '* e (list 'CC-EXP (list '* cmv-tp '+i)))))
                        (subst (list '= (list 'CC-EXP (list '* cmv-tp '+i)) 1))
                        (crs)))
                    (fin! t)))))))))))
(qed 'maximum-modulus-disc)

;;; ======================================================================
;;; (10) THE MEAN VALUE INEQUALITY: |f| <= m on the circle of radius r about c gives
;;; |f(c)| <= m (the mean value property, the modulus of an integral, and the integral
;;; of the constant m over [0, 2 pi])
;;; ======================================================================
(define cmv-bbound '(FORALL cmvy_ (IMPLIES (IN cmvy_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)))
                       (<= (magnitude (f cmvy_)) cmvbm_))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (cmv-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'cmvbr_ (cmv-imps (list '(IN cmvbr_ RR) '(< r cmvbr_) '(SUBSET (BALL CC-MS c cmvbr_) u))
      (list 'FORALL 'cmvbm_ (cmv-imps (list '(IN cmvbm_ RR) cmv-bbound)
        '(<= (magnitude (f c)) cmvbm_))))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (B (cmv-ball 'c R)) (bm 'cmvbm_)
       (X (list 'CC-INT cmv-g 0 cmv-tp))
       (h2R (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'real-part (list 'f (list cmv-P 'pat_)))))
       (h2I (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'imag-part (list 'f (list cmv-P 'pat_)))))
       (hR (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'real-part (list cmv-g 'pat_))))
       (hI (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'imag-part (list cmv-g 'pat_))))
       (hab (list 'VNB-LAMBDA 'pat_ cmv-iv (list 'magnitude (list cmv-g 'pat_))))
       (cn (list 'VNB-LAMBDA 'cmzs_ cmv-iv bm))
       (fcn (list 'VNB-LAMBDA 'cmzs_ cmv-iv (list '+ 0 (list '* bm 'cmzs_)))))
  ;; the standing facts
  (fact 'holomorphic-on-open 'u 'f) (fact 'holomorphic-on-in-fun 'u 'f) (fact 'cc-open-subset-cc 'u)
  (cmv-ms! 'u)
  (fact 'cc-is-metric-space) (cmv-pts-cc!)
  (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! (list '<= 0 R) (lambda () (dk-ineq! (list '< 'r R) '(< 0 r))))
  (dk-have! (list 'NOT (list '= 0 R)) (lambda () (di) (dk-absurd! (list '= 0 R) (list '< 'r R) '(< 0 r))))
  (cmv-and! (list 'IN R 'RR) (cmv-and! (list '<= 0 R) (list 'NOT (list '= 0 R))))
  (dk-cite! 'ball-center-in 'CC-MS 'c R)
  (fact 'subset-mem-fwd B 'u 'c)
  (fact 'fun-apply-type-c 'f 'u 'CC 'c)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path cmv-P cmv-DP 0 cmv-tp)
  (fact 'is-path-in-fun cmv-P 0 cmv-tp)
  (fact 'trace-subset-cc cmv-P 0 cmv-tp)
  (cmv-iv-ends!)
  (dk-have! (list 'SUBSET cmv-T 'u)
    (lambda ()
      (let ((y (subset-by-element!)))
        (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R y))
        (fact 'subset-mem-fwd B 'u y)
        (dk-ass!))))
  (dk-cite! 'holomorphic-on-continuous 'u 'f)
  ;; the mean value property
  (dk-cite! 'holomorphic-mean-value 'u 'f 'c 'r R)
  ;; primitives of the real and imaginary parts and of the modulus of the integrand
  (dk-split-all! (list (dk-cite! 'continuous-on-compose-regulated 'u 'f cmv-P 0 cmv-tp)))
  (let* ((q1 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 cmv-tp h2R)))
         (q2 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 cmv-tp h2I))))
    (dk-have! (list 'IN cmv-g (list 'FUN cmv-iv 'CC))
      (lambda () (dk-lam-type! (lambda () (let ((t (dk-di-var!))) (cmv-cpt! t R) (dk-ass!))))))
    (for-each
      (lambda (h2 h q pr)
        (dk-have! (list 'IN h (list 'FUN cmv-iv 'RR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)))
                  (dk-lam-b!)
                  (cmv-rr! (list pr (list 'f pt)))
                  (dk-ass!))))))
        (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ cmv-iv) (list '== (list h2 'pay_) (list h 'pay_))))
          (lambda ()
            (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)))
              (mac 'CIRCLE-PATH)
              (dk-lam-b!)
              (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
        (dk-cite! 'pw-antiderivative-integrand-congruence q h2 h 0 cmv-tp))
      (list h2R h2I) (list hR hI) (list q1 q2) (list 'real-part 'imag-part))
    (dk-have! (list 'IN hab (list 'FUN cmv-iv 'RR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)))
              (dk-lam-b!)
              (cmv-rr! (list 'magnitude (list 'f pt)))
              (dk-ass!))))))
    (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ cmv-iv)
                (list '== (list hab 'liz_) (list 'magnitude (list '+ (list h2R 'liz_) (list '* (list h2I 'liz_) '+i))))))
      (lambda ()
        (let* ((t (dk-di-var!)) (pt (cmv-cpt! t R)) (fp (list 'f pt)))
          (mac 'CIRCLE-PATH)
          (dk-lam-b!)
          (fact 'real-part-in-rr fp) (fact 'imag-part-in-rr fp)
          (fact 'cc-re-im-decompose fp)
          (cmv-cc! (list '+ (list 'real-part fp) (list '* (list 'imag-part fp) '+i)))
          (dk-have! (list '= (list '+ (list 'real-part fp) (list '* (list 'imag-part fp) '+i)) fp)
            (lambda ()
              (dk-have! (list '= (list '+ (list 'real-part fp) (list '* (list 'imag-part fp) '+i))
                              (list '+ (list 'real-part fp) (list '* '+i (list 'imag-part fp))))
                (lambda () (crs)))
              (subst (list '= (list '+ (list 'real-part fp) (list '* (list 'imag-part fp) '+i))
                           (list '+ (list 'real-part fp) (list '* '+i (list 'imag-part fp)))))
              (subst (list '= (list '+ (list 'real-part fp) (list '* '+i (list 'imag-part fp))) fp))
              (rfl)))
          (subst (list '= (list '+ (list 'real-part fp) (list '* (list 'imag-part fp) '+i)) fp))
          (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
    (dk-cite! 'regulated-on-magnitude h2R h2I hab 0 cmv-tp)
