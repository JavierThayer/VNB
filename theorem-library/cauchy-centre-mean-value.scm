;;; cauchy-centre-mean-value.scm -- THE INTEGRAL FORMULA AT THE CENTRE, THE MEAN VALUE
;;; PROPERTY, THE MEAN VALUE INEQUALITY, THE MAXIMUM MODULUS PRINCIPLE ON A DISC
;;; (complex-analysis.pdf 3.7 at z = c; 3.8: equation (92), Definition 3.54, Proposition
;;; 3.55 in its disc form).  Agent CA-4 of week 2 of the October roadmap
;;; (scratchpad/triage/WEEK2.md), 2026-10-04.
;;;
;;; CONTENTS.
;;;  (1) open-minus-point-open            u open, x in CC: u \ {x} open
;;;  (2) cc-continuous-at-local           continuity at w on an open v inside u lifts to u
;;;  (3) holomorphic-difference-quotient  f holomorphic on u, c in u: q on u, continuous on u,
;;;                                       holomorphic on u \ {c}, f(x) - f(c) = q(x) (x - c)
;;;                                       (the witness of IS-DIFF-ON at c, made global by (2))
;;;  (4) circle-path-ends-agree           CIRCLE-PATH(c, r)(2 pi) = CIRCLE-PATH(c, r)(0)
;;;      circle-trace-radius              |y - c| = r on the trace of CIRCLE-PATH(c, r), r >= 0
;;;      circle-trace-in-punctured-ball   0 < r < R: the trace lies in B(c, R) and avoids c
;;;  (5) cauchy-integral-formula-centre   f(c) = 1/(2 pi i) int_circle f(w)/(w - c) dw
;;;  (6) holomorphic-mean-value           f(c) = 1/(2 pi) int_0^{2 pi} f(c + r e^{it}) dt   (92)
;;;  (7) pw-int-nonneg-zero               a continuous h >= 0 on [a, b] with integral 0 vanishes
;;;  (8) holomorphic-circle-max-constant  |f| <= |f(c)| on the circle of radius r: f = f(c) there
;;;  (9) maximum-modulus-disc             |f| <= |f(c)| on B(c, R) inside u: f = f(c) on B(c, R)
;;; (10) holomorphic-mean-value-bound     |f| <= m on the circle: |f(c)| <= m
;;;
;;; THE DISC.  "The closed disc of radius r about c inside u" is written: some R > r with
;;; BALL(CC-MS, c, R) inside u (closures are not in the vocabulary); the circle is
;;; CIRCLE-PATH(c, r) on [0, 2 pi] with CIRCLE-DERIV(c, r) (structure-library/winding-number).
;;; THE INTEGRAND of (5) is VNB-LAMBDA(w, u \ {c}, f(w) * recip(w - c)); another domain is one
;;; citation of line-int-domain-congruence away.  The mean value of (6) is the CC-INT of
;;; t |-> f(c + r e^{it}) over [0, 2 pi].
;;; THE PROOF OF (5): the difference quotient q of (3) on B(c, R) is continuous there and
;;; holomorphic off c, so cauchy-convex-closed-except gives int_circle q = 0; on the trace
;;; f(w)/(w - c) = q(w) + f(c)/(w - c), and winding-circle-center gives int dw/(w - c) = 2 pi i.
;;; THE PROOF OF (8)-(9) is the notes' (3.55), at one radius: with M = |f(c)| > 0 and
;;; lambda = conj(f(c))/M, psi = M - lambda f is holomorphic with psi(c) = 0, so by (6) the
;;; integral of psi round the circle is 0; its real part is >= 0 (Re(lambda f) <= |f| <= M) and
;;; continuous, hence 0 by (7); then Re(lambda f) = M = |lambda f| forces lambda f = M, i.e.
;;; f = f(c).  (9) reaches every point of the disc through cc-polar-form.  The OPEN-SET form of
;;; 3.55 needs connectedness, which the tree does not have (week 1, gap item 1): not attempted.
;;;
;;; DUPLICATES (found at the end, when CA-3's theorem-library/cauchy-integral-formula.scm
;;; appeared; both files were written the same day): circle-path-ends-agree is alpha-equivalent
;;; to CA-3's circle-path-closed, circle-trace-radius
;;; to circle-trace-magnitude, open-minus-point-open to cif-open-minus-point: the three proofs were CUT at
;;; integration (2026-10-04, archive/2026-10-04/) and CA-3's names are cited.
;;;
;;; NOTHING asserted, no definition.  Helper prefix cmv-; binders cmv*_ and cmz*_ (none used
;;; elsewhere in the tree).  LOAD WINDOW: lo = theorem-library/analytic-from-integral
;;; (load.scm:3541; aif-cont-product, aif-cont-scale, aif-cont-sum), above winding-number-laws
;;; (3540; winding-circle-center, circle-is-road, cauchy-convex-sub's helpers, ...),
;;; goursat-exceptional (cauchy-convex-closed-except), cc-exp-kernel (pi-pos), cc-exp; hi: none.
;;; No citation of CA-3's files.  Tactics: the early kit only (dk-*, use-em, prop, crs, ineq).

;;; ======================================================================
;;; local helpers (typers after winding-number-laws.scm's wnd-, copied)
;;; ======================================================================
(define (cmv-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cmv-hd t) (and (pair? t) (car t)))
(define cmv-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (cmv-sub u) (list 'SUBSPACE-MS cmv-nfm u))
(define (cmv-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (cmv-sub u) cmv-nfm f 'rgy_))))
(define (cmv-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (cmv-imps (cdr hyps) body))))
(define (cmv-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (cmv-all (cdr vars) body))))
(define (cmv-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (cmv-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((cmv-op? t '* 3) (cmv-rr! (cadr t)) (cmv-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cmv-op? t 'magnitude 2) (cmv-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cmv-op? t 'real-part 2) (cmv-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((cmv-op? t 'imag-part 2) (cmv-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          (#t (dk-type! t 'RR)))))
(define (cmv-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((cmv-op? t 'recip 2)
           (cmv-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cmv-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (cmv-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          ((cmv-op? t '* 3) (cmv-cc! (cadr t)) (cmv-cc! (caddr t))
           (cmv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cmv-op? t '+ 3) (cmv-cc! (cadr t)) (cmv-cc! (caddr t))
           (cmv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cmv-op? t '- 3) (cmv-cc! (cadr t)) (cmv-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cmv-op? t '- 2) (cmv-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((cmv-op? t 'CC-EXP 2) (cmv-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((or (eq? t 'PI) (and (number? t) (real? t)) (dk-asm? (list 'IN t 'RR))
               (cmv-op? t 'magnitude 2) (cmv-op? t 'real-part 2) (cmv-op? t 'imag-part 2))
           (cmv-rr! t) (fact 'rr-subset-cc t) typ)
          (#t (dk-type! t 'CC)))))
(define (cmv-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
;;; the metric facts on NFM and on the subspace u (u subset CC in context)
(define (cmv-ms! u)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS cmv-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS cmv-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS cmv-nfm) '(CARR CC-NORMED-FIELD))) (ass))))
  (if (not (dk-asm? (list 'SUBSET u (list 'PTS cmv-nfm))))
      (dk-have! (list 'SUBSET u (list 'PTS cmv-nfm))
        (lambda () (subst (list '== (list 'PTS cmv-nfm) 'CC)) (ass))))
  (if (not (dk-asm? (list 'IN u 'SET)))
      (dk-have! (list 'IN u 'SET)
        (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC) (ass))))
  (fact 'subspace-is-metric-space cmv-nfm u)
  (fact 'subspace-pts cmv-nfm u))

;;; ======================================================================
;;; (1) AN OPEN SET MINUS A POINT IS OPEN
;;; ======================================================================
(define (cmv-pz x) (list 'DIFFERENCE 'CC (list 'SINGLETON x)))
(define (cmv-dpt u x) (list 'DIFFERENCE u (list 'SINGLETON x)))

