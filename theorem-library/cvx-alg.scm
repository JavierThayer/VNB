;;; cvx-alg.scm -- the regrouping identity for convex combinations in a real normed vector space,
;;; and the bounds on its coefficients: the algebra under "the join of a convex set to a point is
;;; convex" and "the convex hull is convex" (compact-groups notes, Lemma 1.12).
;;; Agent ISOM, 2026-10-26.  Helper prefix: cva-.  Library: linear-algebra.

(define (cva-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cva-act r x) (list '(ACT m) r x))
(define (cva-add x y) (list '(VADD m) x y))
(define (cva-cvx x y t) (cva-add (cva-act (list '- 1 t) x) (cva-act t y)))
(define (cva-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (cva-forall (cdr vs) body))))
(define (cva-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (cva-implies (cdr hs) concl))))
(define (cva-act! r x) (dk-cite! 'nvs-act-in-vec 'm r x) (cva-act r x))
(define (cva-add! x y) (dk-cite! 'nvs-vadd-in-vec 'm x y) (cva-add x y))
(define (cva-rr! t) (dk-real! t) t)

;;; ---- the regrouping identity ----
;;;   (1-s)[(1-t1) y1 + t1 a] + s[(1-t2) y2 + t2 a]  =  (1-T)[(1-l) y1 + l y2] + T a
;;; for T = (1-s) t1 + s t2, whenever (1-T)(1-l) = (1-s)(1-t1) and (1-T) l = s (1-t2).
(define cva-A '(* (- 1 s) (- 1 t1)))
(define cva-B '(* (- 1 s) t1))
(define cva-C '(* s (- 1 t2)))
(define cva-D '(* s t2))
(define cva-T (list '+ cva-B cva-D))
(define cva-LHS (cva-cvx (cva-cvx 'y1 'a 't1) (cva-cvx 'y2 'a 't2) 's))
(define cva-RHS (cva-cvx (cva-cvx 'y1 'y2 'lam) 'a cva-T))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m)
   (cva-forall '(y1 y2 a s t1 t2 lam)
     (cva-implies (list '(IN y1 (VEC m)) '(IN y2 (VEC m)) '(IN a (VEC m)) '(IN s RR) '(IN t1 RR) '(IN t2 RR) '(IN lam RR)
                        (list '= (list '* (list '- 1 cva-T) '(- 1 lam)) cva-A)
                        (list '= (list '* (list '- 1 cva-T) 'lam) cva-C))
       (list '= cva-LHS cva-RHS)))))))
(dk-peel!)
(for-each cva-rr! (list '(- 1 s) '(- 1 t1) '(- 1 t2) '(- 1 lam) cva-A cva-B cva-C cva-D cva-T (list '- 1 cva-T)))
(let* ((p1 (cva-act! '(- 1 t1) 'y1)) (q1 (cva-act! 't1 'a)) (p2 (cva-act! '(- 1 t2) 'y2)) (q2 (cva-act! 't2 'a))
       (r1 (cva-act! '(- 1 lam) 'y1)) (r2 (cva-act! 'lam 'y2))
       (ay1 (cva-act! cva-A 'y1)) (ba (cva-act! cva-B 'a)) (cy2 (cva-act! cva-C 'y2)) (da (cva-act! cva-D 'a)))
  (cva-add! p1 q1) (cva-add! p2 q2) (cva-add! r1 r2)
  (cva-add! ay1 ba) (cva-add! cy2 da) (cva-add! ay1 cy2) (cva-add! ba da)
  ;; the left side
  (dk-cite! 'nvs-act-distrib-vec-rr 'm '(- 1 s) p1 q1)
  (subst (list '= (cva-act '(- 1 s) (cva-add p1 q1)) (cva-add (cva-act '(- 1 s) p1) (cva-act '(- 1 s) q1))))
  (dk-cite! 'nvs-act-distrib-vec-rr 'm 's p2 q2)
  (subst (list '= (cva-act 's (cva-add p2 q2)) (cva-add (cva-act 's p2) (cva-act 's q2))))
  (dk-cite! 'nvs-act-scale-assoc 'm '(- 1 s) '(- 1 t1) 'y1)
  (subst (list '= (cva-act '(- 1 s) p1) ay1))
  (dk-cite! 'nvs-act-scale-assoc 'm '(- 1 s) 't1 'a)
  (subst (list '= (cva-act '(- 1 s) q1) ba))
  (dk-cite! 'nvs-act-scale-assoc 'm 's '(- 1 t2) 'y2)
  (subst (list '= (cva-act 's p2) cy2))
  (dk-cite! 'nvs-act-scale-assoc 'm 's 't2 'a)
  (subst (list '= (cva-act 's q2) da))
  ;; the right side
  (dk-cite! 'nvs-act-distrib-vec-rr 'm (list '- 1 cva-T) r1 r2)
  (subst (list '= (cva-act (list '- 1 cva-T) (cva-add r1 r2)) (cva-add (cva-act (list '- 1 cva-T) r1) (cva-act (list '- 1 cva-T) r2))))
  (dk-cite! 'nvs-act-scale-assoc 'm (list '- 1 cva-T) '(- 1 lam) 'y1)
  (subst (list '= (cva-act (list '- 1 cva-T) r1) (cva-act (list '* (list '- 1 cva-T) '(- 1 lam)) 'y1)))
  (dk-cite! 'nvs-act-scale-assoc 'm (list '- 1 cva-T) 'lam 'y2)
  (subst (list '= (cva-act (list '- 1 cva-T) r2) (cva-act (list '* (list '- 1 cva-T) 'lam) 'y2)))
  (subst (list '= (list '* (list '- 1 cva-T) '(- 1 lam)) cva-A))
  (subst (list '= (list '* (list '- 1 cva-T) 'lam) cva-C))
  ;; regroup and collect
  (dk-cite! 'nvs-vadd-shuffle 'm ay1 cy2 ba da)
  (subst (list '= (cva-add (cva-add ay1 ba) (cva-add cy2 da)) (cva-add (cva-add ay1 cy2) (cva-add ba da))))
  (dk-cite! 'nvs-act-add-scalars 'm cva-B cva-D 'a)
  (subst (list '= (cva-add ba da) (cva-act cva-T 'a)))
  (cva-add! (cva-add ay1 cy2) (cva-act! cva-T 'a))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(qed 'convex-combination-regroup)
(topic! 'convex-combination-regroup 'algebra)

;;; ---- two real-product facts ----
(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN x RR) (IMPLIES (IN y RR) (IMPLIES (<= 0 x) (IMPLIES (<= 0 y) (<= 0 (* x y))))))))))
(dk-peel!)
(dk-real! '(* x y)) (dk-real! '(* y x)) (dk-real! '(* 0 x)) (fact 'rr-zero-in)
(dk-cite! 'rr-mul-le-right 0 'y 'x)
(dk-have! '(= (* 0 x) 0) (lambda () (crs)))
(dk-have! '(= (* y x) (* x y)) (lambda () (crs)))
(dk-rewrite-h! '(<= (* 0 x) (* y x)) '(* 0 x) 0)
(dk-rewrite-h! '(<= 0 (* y x)) '(* y x) '(* x y))
(cva-ass!)
(qed 'cvx-mul-nonneg)
(topic! 'cvx-mul-nonneg 'algebra)

(sp (make-wff '(FORALL c (FORALL x (IMPLIES (IN c RR) (IMPLIES (IN x RR) (IMPLIES (<= 0 c) (IMPLIES (<= x 1) (<= (* c x) c)))))))))
(dk-peel!)
(dk-real! '(* c x)) (dk-real! '(* x c)) (dk-real! '(* 1 c)) (fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right 'x 1 'c)
(dk-have! '(= (* 1 c) c) (lambda () (crs)))
(dk-have! '(= (* x c) (* c x)) (lambda () (crs)))
(dk-rewrite-h! '(<= (* x c) (* 1 c)) '(* 1 c) 'c)
(dk-rewrite-h! '(<= (* x c) c) '(* x c) '(* c x))
(cva-ass!)
(qed 'cvx-mul-le-self)
(topic! 'cvx-mul-le-self 'algebra)

;;; ---- the coefficients of the regrouping: T in [0, 1] and a lam in [0, 1] ----
(define cva-unit (lambda (v) (list (list 'IN v 'RR) (list '<= 0 v) (list '<= v 1))))
(define cva-coef-concl
  (list 'AND (list '<= 0 cva-T) (list 'AND (list '<= cva-T 1)
    (list 'FORSOME 'lam (list 'AND '(IN lam RR) (list 'AND '(<= 0 lam) (list 'AND '(<= lam 1)
      (list 'AND (list '= (list '* (list '- 1 cva-T) '(- 1 lam)) cva-A)
                 (list '= (list '* (list '- 1 cva-T) 'lam) cva-C)))))))))
(sp (make-wff (cva-forall '(s t1 t2) (cva-implies (append (cva-unit 's) (cva-unit 't1) (cva-unit 't2)) cva-coef-concl))))
(dk-peel!)
(define cva-1T (list '- 1 cva-T))
(for-each (lambda (t) (dk-real! t)) (list '(- 1 s) '(- 1 t1) '(- 1 t2) cva-A cva-B cva-C cva-D cva-T cva-1T))
(for-each (lambda (f) (dk-have! f (lambda () (dk-ineq! '(<= s 1) '(<= 0 s) '(<= t1 1) '(<= 0 t1) '(<= t2 1) '(<= 0 t2))))) '((<= 0 (- 1 s)) (<= 0 (- 1 t1)) (<= 0 (- 1 t2)) (<= (- 1 t1) 1) (<= (- 1 t2) 1)))
(dk-cite! 'cvx-mul-nonneg '(- 1 s) '(- 1 t1))
(dk-cite! 'cvx-mul-nonneg '(- 1 s) 't1)
(dk-cite! 'cvx-mul-nonneg 's '(- 1 t2))
(dk-cite! 'cvx-mul-nonneg 's 't2)
(dk-cite! 'cvx-mul-le-self '(- 1 s) 't1)
(dk-cite! 'cvx-mul-le-self 's 't2)
(dk-have! (list '= (list '+ cva-A cva-C) cva-1T) (lambda () (crs)))
(define (cva-lin! f) (dk-have! f (lambda () (dk-ineq! (list '<= 0 cva-B) (list '<= 0 cva-D) (list '<= cva-B '(- 1 s)) (list '<= cva-D 's)
                                                        (list '<= 0 cva-A) (list '<= 0 cva-C) (list '= (list '+ cva-A cva-C) cva-1T)))))
(cva-lin! (list '<= 0 cva-T))
(cva-lin! (list '<= cva-T 1))
(cva-lin! (list '<= cva-C cva-1T))
;; the lam: C / (1 - T) when 1 - T > 0, and 0 when 1 - T = 0 (then A = C = 0)
(define (cva-lam-pos!)
  (dk-have! (list 'NOT (list '= cva-1T 0))
    (lambda () (di)
               (dk-rewrite-h! (list '< 0 cva-1T) cva-1T 0)
               (fact 'rr-zero-in)
               (ai (dk-cite! 'rr-lt-irrefl 0))))
  (dk-have! (list 'AND (list 'IN cva-1T 'RR) (list 'NOT (list '= cva-1T 0))) (lambda () (dk-conj-close! (lambda () (cva-ass!)))))
  (dk-cite! 'rr-recip-closed cva-1T)
  (dk-cite! 'rr-recip-inverse cva-1T)
  (dk-cite! 'rr-recip-pos cva-1T)
  (let* ((w (dk-name! (list 'recip cva-1T)))
         (lam (list '* cva-C w)))
    (dk-rewrite-h! (list '= (list '* cva-1T (list 'recip cva-1T)) 1) (list 'recip cva-1T) w)
    (dk-rewrite-h! (list '< 0 (list 'recip cva-1T)) (list 'recip cva-1T) w)
    (dk-real! lam)
    (dk-have! (list '= (list '* cva-1T lam) cva-C)
      (lambda ()
        (dk-have! (list '= (list '* cva-1T lam) (list '* cva-C (list '* cva-1T w))) (lambda () (crs)))
        (subst (list '= (list '* cva-1T lam) (list '* cva-C (list '* cva-1T w))))
        (subst (list '= (list '* cva-1T w) 1))
        (crs)))
    (dk-have! (list '<= 0 w) (lambda () (dk-ineq! (list '< 0 w))))
    (dk-cite! 'cvx-mul-nonneg cva-C w)
    (dk-cite! 'rr-mul-le-right cva-C cva-1T w)
    (dk-rewrite-h! (list '<= lam (list '* cva-1T w)) (list '* cva-1T w) 1)
    (ew lam)
    (dk-conj-close!
     (lambda ()
       (let ((g0 (dk-goal)))
         (cond ((dk-asm? g0) (ass))
               ((and (dk-head-is? g0 '=) (equal? (caddr g0) cva-A))
                (dk-have! (list '= (list '* cva-1T (list '- 1 lam)) (list '- cva-1T (list '* cva-1T lam))) (lambda () (crs)))
                (subst (list '= (list '* cva-1T (list '- 1 lam)) (list '- cva-1T (list '* cva-1T lam))))
                (subst (list '= (list '* cva-1T lam) cva-C))
                (crs))
               (#t (cva-ass!))))))))
(define (cva-lam-zero!)
  (dk-cite! 'rr-lt-trichotomy 0 cva-1T)
  (fact 'rr-zero-in)
  (dk-cite! 'rr-lt-not-le cva-1T 0)
  (dk-have! (list '<= 0 cva-1T) (lambda () (dk-ineq! (list '<= cva-T 1))))
  (dk-have! (list '= 0 cva-1T)
    (lambda () (if (dk-only! (list 'OR (list '< 0 cva-1T) (list 'OR (list '= 0 cva-1T) (list '< cva-1T 0)))
                             (list 'NOT (list '< 0 cva-1T))
                             (list 'IMPLIES (list '< cva-1T 0) (list 'NOT (list '<= 0 cva-1T)))
                             (list '<= 0 cva-1T))
                   (prop))))
  (define prems (list (list '<= 0 cva-A) (list '<= 0 cva-C) (list '= (list '+ cva-A cva-C) cva-1T) (list '= 0 cva-1T)))
  (dk-have! (list '= cva-A 0) (lambda () (apply dk-ineq! prems)))
  (dk-have! (list '= cva-C 0) (lambda () (apply dk-ineq! prems)))
  (ew 0)
  (dk-conj-close!
   (lambda ()
     (let ((g0 (dk-goal)))
       (cond ((dk-asm? g0) (ass))
             ((and (dk-head-is? g0 '=) (dk-contains? g0 cva-1T))
              (subst (list '= cva-1T 0))
              (subst (list '= (caddr g0) 0))
              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))
             (#t (dk-ineq!)))))))
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'FORSOME)
       (use-em (list '< 0 cva-1T) cva-lam-pos! cva-lam-zero!)
       (cva-ass!))))
(qed 'convex-regroup-coefficients)
(topic! 'convex-regroup-coefficients 'algebra)
