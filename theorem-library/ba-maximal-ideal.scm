;;; ba-maximal-ideal.scm -- EVERY PROPER TWO-SIDED IDEAL OF A UNITAL BANACH ALGEBRA LIES IN A MAXIMAL ONE
;;; (Krull's theorem, the existence step under BanachAlgebras.pdf Remark 1.13 and Proposition 1.16), by
;;; Zorn's lemma (zorn-route-two.scm) on the proper ideals containing the given one, ordered by inclusion.
;;; A proper ideal is one that omits the unit (an ideal containing 1 is everything, `bmx-one-proper'), and
;;; the union of a nonempty chain of ideals omitting 1 is an ideal omitting 1.
;;; Agent BA-1D, wave 2026-11-09.  Destination: theorem-library/ba-maximal-ideal.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: bmx-.
;;; LOAD WINDOW: after zorn-route-two (zorn-lemma), subset-lemmas (subset-refl, subset-trans), the BA-1
;;; vocabulary and ba-laws (bal-uba-vone-right, bal-uba-vec-set, bal-uba-vone-in).

(define (bmx-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-maximal-ideal: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display "      asm: ") (display (expression->string h)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-maximal-ideal: unfinished" name))))

(define (bmx-contra! p)                ; p and (NOT p) in context: close the goal
  (if (not (and (dk-asm? p) (dk-asm? (list 'NOT p))))
      (begin (display "\n;; BMX-CONTRA miss: ") (write p) (write (list (dk-asm? p) (dk-asm? (list 'NOT p))))
             (newline) (for-each (lambda (h) (display ";;   asm: ") (write h) (newline)) (dk-asms))))
  (keep p (list 'NOT p))
  (prop))

;;; ---- subset antisymmetry (a set fact; no such theorem under this name in the tree) -----------
(sp (make-wff '(FORALL bmp (FORALL bmq (IMPLIES (SUBSET bmp bmq) (IMPLIES (SUBSET bmq bmp) (= bmp bmq)))))))
(dk-peel!)
(dk-have! '(FORALL bmz_ (IFF (IN bmz_ bmp) (IN bmz_ bmq)))
  (lambda ()
    (let ((z (begin (di) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g) (equal? g (list 'IN z 'bmq)))
               (lambda () (dk-cite! 'subset-mem-fwd 'bmp 'bmq z) (dk-ass!))
               (lambda () (dk-cite! 'subset-mem-fwd 'bmq 'bmp z) (dk-ass!))))))
(dk-cite! 'class-extensionality 'bmp 'bmq)
(dk-ass!)
(bmx-qed! 'bmx-subset-antisym)

;;; ---- the six parts of a two-sided ideal, out and in -------------------------------------------
(define (bmx-parts q)
  (list (list 'SUBSET q '(VEC a))
        (list 'IN '(VZERO a) q)
        (list 'FORALL 'bax_ (list 'IMPLIES (list 'IN 'bax_ q) (list 'FORALL 'bay_ (list 'IMPLIES (list 'IN 'bay_ q)
               (list 'IN '((VADD a) bax_ bay_) q)))))
        (list 'FORALL 'baz_ (list 'IMPLIES '(IN baz_ CC) (list 'FORALL 'bax_ (list 'IMPLIES (list 'IN 'bax_ q)
               (list 'IN '((ACT a) baz_ bax_) q)))))
        (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC a)) (list 'FORALL 'bax_ (list 'IMPLIES (list 'IN 'bax_ q)
               (list 'IN '((VMUL a) bay_ bax_) q)))))
        (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC a)) (list 'FORALL 'bax_ (list 'IMPLIES (list 'IN 'bax_ q)
               (list 'IN '((VMUL a) bax_ bay_) q)))))))
(define (bmx-conj fs) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (bmx-conj (cdr fs)))))
(define (bmx-imps hs c) (if (null? hs) c (list 'IMPLIES (car hs) (bmx-imps (cdr hs) c))))

(define (bmx-open-all!)                ; open every ideal-family predicate in context, to atoms
  (let loop ((n 0))
    (let ((h (find-first (lambda (f) (and (pair? f) (memq (car f) '(IS-TWO-SIDED-IDEAL IS-LEFT-IDEAL IS-RIGHT-IDEAL IS-ALG-SUBSPACE))))
                         (dk-asms))))
      (if (and h (< n 12))
          (begin
            (mac-h (car h) h)
            (dk-split-all!)
            (loop (+ n 1)))))))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'q (list 'IMPLIES '(IS-TWO-SIDED-IDEAL a q) (bmx-conj (bmx-parts 'q)))))))
(dk-peel!)
(bmx-open-all!)
(dk-conj-close! (lambda () (dk-ass!)))
(bmx-qed! 'bmx-ideal-parts)

(define (bmx-close-ideal!)
  (let ((g (dk-goal)))
    (cond ((dk-ass!) #t)
          ((and (pair? g) (memq (car g) '(IS-TWO-SIDED-IDEAL IS-LEFT-IDEAL IS-RIGHT-IDEAL IS-ALG-SUBSPACE)))
           (mac (car g))
           (dk-conj-close! bmx-close-ideal!))
          (#t (error "bmx-close-ideal!: cannot close" (expression->string g))))))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'q (bmx-imps (bmx-parts 'q) '(IS-TWO-SIDED-IDEAL a q))))))
(dk-peel!)
(bmx-close-ideal!)
(bmx-qed! 'bmx-ideal-intro)
(define (bmx-parts! q) (dk-split-all! (list (dk-cite! 'bmx-ideal-parts 'a q))))

;;; an ideal containing the unit is the whole algebra
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL q (IMPLIES (IS-TWO-SIDED-IDEAL a q)
  (IMPLIES (IN (VONE a) q) (= q (VEC a)))))))))
(dk-peel!)
(bmx-parts! 'q)
(dk-cite! 'bal-uba-vone-in 'a)
(dk-cite! 'bal-uba-vone-right 'a)
(dk-have! '(FORALL bmz_ (IFF (IN bmz_ q) (IN bmz_ (VEC a))))
  (lambda ()
    (let ((z (begin (di) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g) (equal? g (list 'IN z '(VEC a))))
               (lambda () (dk-cite! 'subset-mem-fwd 'q '(VEC a) z) (dk-ass!))
               (lambda ()
                 (let ((left (list-ref (bmx-parts 'q) 4)))
                   (dk-apply! left z '(VONE a))
                   (dk-cite! 'bal-uba-vone-right 'a z)
                   (subst (list '= z (list '(VMUL a) z '(VONE a))))
                   (dk-ass!)))))))
(dk-cite! 'class-extensionality 'q '(VEC a))
(dk-ass!)
(bmx-qed! 'bmx-one-proper)

;;; ---- the poset: proper ideals containing bmj, by inclusion -------------------------------------
(define bmx-GRD '(SEP bmi_ (POWER (VEC a)) (AND (IS-TWO-SIDED-IDEAL a bmi_) (AND (SUBSET bmj bmi_) (NOT (IN (VONE a) bmi_))))))
(define bmx-POREL (list 'SEP 'bmw_ (list 'CARTESIAN bmx-GRD bmx-GRD) '(SUBSET (NTH 1 bmw_) (NTH 2 bmw_))))
(define (bmx-st vars hyps concl)
  (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a)
    (list 'FORALL 'bmj (list 'IMPLIES '(IS-TWO-SIDED-IDEAL a bmj)
      (fold-right (lambda (v acc) (list 'FORALL v acc)) (bmx-imps hyps concl) vars)))))))

(sp (bmx-st '(q) '((IS-TWO-SIDED-IDEAL a q) (SUBSET bmj q) (NOT (IN (VONE a) q))) (list 'IN 'q bmx-GRD)))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(bmx-parts! 'q)
(dk-cite! 'subclass-of-set-is-set 'q '(VEC a))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ q) (IN z_ (VEC a))))
  (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd 'q '(VEC a) z) (dk-ass!))))
(dk-cite! 'power-mem-intro '(VEC a) 'q)
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (begin (dk-focus! l)
                       (if (not (dk-ass!)) (dk-conj-close! (lambda () (dk-ass!)))))))
          (dk-opened (lambda () (sep-mi))))
(bmx-qed! 'bmx-grd-in)

(sp (bmx-st '(q) (list (list 'IN 'q bmx-GRD))
  '(AND (IS-TWO-SIDED-IDEAL a q) (AND (SUBSET bmj q) (NOT (IN (VONE a) q))))))
(dk-peel!)
(dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN 'q bmx-GRD))))))
(dk-conj-close! (lambda () (dk-ass!)))
(bmx-qed! 'bmx-grd-parts)

(sp (bmx-st '(p q) (list (list 'IN 'p bmx-GRD) (list 'IN 'q bmx-GRD) '(SUBSET p q)) (list 'IN '(LIST p q) bmx-POREL)))
(dk-peel!)
(dk-cite! 'pair-in-cartesian bmx-GRD bmx-GRD 'p 'q)
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (begin (dk-focus! l)
                       (if (not (dk-ass!))
                           (begin (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
                                  (dk-conj-close! (lambda () (dk-ass!))))))))
          (dk-opened (lambda () (sep-mi))))
(bmx-qed! 'bmx-porel-in)

(sp (bmx-st '(p q) (list (list 'IN '(LIST p q) bmx-POREL)) '(SUBSET p q)))
(dk-peel!)
(let* ((parts (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN '(LIST p q) bmx-POREL))))))
       (cnd (find-first (lambda (f) (dk-head-is? f 'SUBSET)) parts)))
  (dk-nth-h! cnd))
(dk-ass!)
(bmx-qed! 'bmx-porel-parts)

;;; ---- KRULL: a proper ideal lies in a maximal ideal ----------------------------------------------
(define (bmx-in-grd! ch q)             ; q in ch, ch subset GRD: q's GRD parts and ideal parts
  (dk-cite! 'subset-mem-fwd ch bmx-GRD q)
  (dk-split-all! (list (dk-cite! 'bmx-grd-parts 'a 'bmj q)))
  (bmx-parts! q))
(define (bmx-bu-out! h)                ; h = (IN t U) in context: eigenvariable e with (IN e ch), (IN t e)
  (let* ((landed (dk-landed (lambda () (bu-me h))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (not (equal? (cadr f) (cadr h))))) landed)))
    (cadr ein)))
(define (bmx-bu-in! e)                 ; goal (IN t U): witness e, both leaves from context
  (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (dk-ass!))))
            (dk-opened (lambda () (bu-mi e)))))

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL bmj (IMPLIES (IS-TWO-SIDED-IDEAL a bmj)
  (IMPLIES (NOT (= bmj (VEC a))) (FORSOME bmm_ (AND (IS-MAXIMAL-IDEAL a bmm_) (SUBSET bmj bmm_))))))))))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(dk-cite! 'bal-uba-vone-in 'a)
(dk-cite! 'power-set '(VEC a))
(dk-have! '(NOT (IN (VONE a) bmj))
  (lambda () (di) (dk-cite! 'bmx-one-proper 'a 'bmj) (bmx-contra! '(= bmj (VEC a)))))
(dk-cite! 'subset-refl 'bmj)
(dk-cite! 'bmx-grd-in 'a 'bmj 'bmj)
(dk-have! (list 'IN bmx-GRD 'SET)
  (lambda () (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (dk-ass!))))
                       (dk-opened (lambda () (sep-set))))))
(dk-have! (list 'IN bmx-POREL 'SET)
  (lambda () (for-each (lambda (l)
                         (if (not (sequent-node-grounded? l))
                             (begin (dk-focus! l) (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!))))))
                       (dk-opened (lambda () (sep-set))))))
(define (bmx-gp! q) (dk-split-all! (list (dk-cite! 'bmx-grd-parts 'a 'bmj q))))
(dk-have! (list 'IS-PARTIAL-ORDER bmx-GRD bmx-POREL)
  (lambda ()
    (mac 'is-partial-order)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (dk-peel!)
              (let ((g (dk-goal)))
                (cond
                  ;; reflexive
                  ((and (dk-head-is? g 'IN) (equal? (cadr (cadr g)) (caddr (cadr g))))
                   (let ((x (cadr (cadr g))))
                     (dk-cite! 'subset-refl x)
                     (dk-cite! 'bmx-porel-in 'a 'bmj x x)
                     (dk-ass!)))
                  ;; antisymmetric
                  ((dk-head-is? g '=)
                   (let ((x (cadr g)) (y (caddr g)))
                     (dk-split-all!)
                     (dk-cite! 'bmx-porel-parts 'a 'bmj x y) (dk-cite! 'bmx-porel-parts 'a 'bmj y x)
                     (dk-cite! 'bmx-subset-antisym x y)
                     (dk-ass!)))
                  ;; transitive
                  (#t
                   (let* ((ab (cadr g)) (x (cadr ab)) (z (caddr ab))
                          (pr (dk-pick (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f x) (dk-contains? f z))) "the pair"))
                          (y (caddr (cadr (cadr pr)))))
                     (dk-split-all!)
                     (dk-cite! 'bmx-porel-parts 'a 'bmj x y) (dk-cite! 'bmx-porel-parts 'a 'bmj y z)
                     (dk-cite! 'subset-trans x y z)
                     (dk-cite! 'bmx-porel-in 'a 'bmj x z)
                     (dk-ass!)))))))))))
(dk-have! (list 'FORSOME 'w_ (list 'IN 'w_ bmx-GRD)) (lambda () (ew 'bmj) (dk-ass!)))
;;; every chain has an upper bound: bmj when it is empty, its union otherwise
(dk-have! (list 'FORALL 'ch_ (list 'IMPLIES (list 'IS-CHAIN bmx-GRD bmx-POREL 'ch_)
            (list 'FORSOME 'u_ (list 'IS-UPPER-BOUND bmx-GRD bmx-POREL 'ch_ 'u_))))
  (lambda ()
    (dk-peel!)
    (let* ((chh (dk-pick (lambda (f) (dk-head-is? f 'IS-CHAIN)) "the chain"))
           (ch (cadddr chh))
           (sub (dk-project! (list 'SUBSET ch bmx-GRD) 'is-chain chh))
           (comp (dk-project! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ch) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y ch)
                                (list 'OR (list 'IN '(LIST x y) bmx-POREL) (list 'IN '(LIST y x) bmx-POREL))))))
                              'is-chain chh))
           (ne (list 'FORSOME 'bmq_ (list 'IN 'bmq_ ch)))
           (uu (list 'BIG-UNION 'bmk_ ch 'bmk_)))
      (use-em ne
        (lambda ()
          (let ((q0 (dk-skolem! ne #f)))
            (bmx-in-grd! ch q0)
            (dk-have! (list 'SUBSET uu '(VEC a))
              (lambda ()
                (let* ((z (subset-by-element!)) (e (bmx-bu-out! (list 'IN z uu))))
                  (bmx-in-grd! ch e)
                  (dk-cite! 'subset-mem-fwd e '(VEC a) z)
                  (dk-ass!))))
            (dk-cite! 'subclass-of-set-is-set uu '(VEC a))
            (dk-have! (list-ref (bmx-parts uu) 1) (lambda () (bmx-bu-in! q0)))
            (dk-have! (list-ref (bmx-parts uu) 2)
              (lambda ()
                (dk-peel!)
                (let* ((g (dk-goal)) (x (cadr (cadr g))) (y (caddr (cadr g)))
                       (e1 (bmx-bu-out! (list 'IN x uu))) (e2 (bmx-bu-out! (list 'IN y uu))))
                  (bmx-in-grd! ch e1) (bmx-in-grd! ch e2)
                  (dk-apply! comp e1 e2)
                  (use-cases (list (list 'IN (list 'LIST e1 e2) bmx-POREL) (list 'IN (list 'LIST e2 e1) bmx-POREL))
                    (lambda ()
                      (dk-cite! 'bmx-porel-parts 'a 'bmj e1 e2)
                      (dk-cite! 'subset-mem-fwd e1 e2 x)
                      (dk-apply! (list-ref (bmx-parts e2) 2) x y)
                      (bmx-bu-in! e2))
                    (lambda ()
                      (dk-cite! 'bmx-porel-parts 'a 'bmj e2 e1)
                      (dk-cite! 'subset-mem-fwd e2 e1 y)
                      (dk-apply! (list-ref (bmx-parts e1) 2) x y)
                      (bmx-bu-in! e1))))))
            (for-each
              (lambda (k)
                (dk-have! (list-ref (bmx-parts uu) k)
                  (lambda ()
                    (dk-peel!)
                    (let* ((tv (cadr (dk-goal)))
                           (scal (if (= k 5) (caddr tv) (cadr tv)))
                           (mem (if (= k 5) (cadr tv) (caddr tv)))
                           (e (bmx-bu-out! (list 'IN mem uu))))
                      (bmx-in-grd! ch e)
                      (dk-apply! (list-ref (bmx-parts e) k) scal mem)
                      (bmx-bu-in! e)))))
              '(3 4 5))
            (dk-cite! 'bmx-ideal-intro 'a uu)
            (dk-have! (list 'SUBSET 'bmj uu)
              (lambda () (let ((z (subset-by-element!))) (dk-cite! 'subset-mem-fwd 'bmj q0 z) (bmx-bu-in! q0))))
            (dk-have! (list 'NOT (list 'IN '(VONE a) uu))
              (lambda ()
                (di)
                (let ((e (bmx-bu-out! (list 'IN '(VONE a) uu))))
                  (bmx-in-grd! ch e)
                  (bmx-contra! (list 'IN '(VONE a) e)))))
            (dk-cite! 'bmx-grd-in 'a 'bmj uu)
            (ew uu)
            (mac 'is-upper-bound)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let ((x (dk-di-var!)))
                      (bmx-in-grd! ch x)
                      (dk-have! (list 'SUBSET x uu) (lambda () (let ((z (subset-by-element!))) (bmx-bu-in! x))))
                      (dk-cite! 'bmx-porel-in 'a 'bmj x uu)
                      (dk-ass!)))))))
        (lambda ()
          (ew 'bmj)
          (mac 'is-upper-bound)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let ((q (dk-di-var!)))
                    (dk-have! ne (lambda () (ew q) (dk-ass!)))
                    (bmx-contra! ne))))))))))
;;; Zorn, and the maximal element is a maximal ideal
(let* ((mx (dk-skolem! (dk-cite! 'zorn-lemma bmx-GRD bmx-POREL)))
       (mxh (dk-ctx-form (list 'IS-MAXIMAL bmx-GRD bmx-POREL mx)))
       (mxin (dk-project! (list 'IN mx bmx-GRD) 'is-maximal mxh))
       (maxl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y bmx-GRD)
                             (list 'IMPLIES (list 'IN (list 'LIST mx 'y) bmx-POREL) (list 'IN (list 'LIST 'y mx) bmx-POREL))))
                          'is-maximal mxh)))
  (bmx-gp! mx)
  (ew mx)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (mac 'is-maximal-ideal)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((dk-ass!) #t)
                    ((dk-head-is? g 'NOT)
                     (di)
                     (dk-rewrite-h! '(IN (VONE a) (VEC a)) '(VEC a) mx)
                     (bmx-contra! (list 'IN '(VONE a) mx)))
                    (#t
                     (let* ((landed (dk-peel!))
                            (j (caddr (find-first (lambda (f) (dk-head-is? f 'IS-TWO-SIDED-IDEAL)) landed))))
                       (dk-have! (list 'NOT (list 'IN '(VONE a) j))
                         (lambda () (di) (dk-cite! 'bmx-one-proper 'a j) (bmx-contra! (list '= j '(VEC a)))))
                       (dk-cite! 'subset-trans 'bmj mx j)
                       (dk-cite! 'bmx-grd-in 'a 'bmj j)
                       (dk-cite! 'bmx-porel-in 'a 'bmj mx j)
                       (dk-apply! maxl j)
                       (dk-cite! 'bmx-porel-parts 'a 'bmj j mx)
                       (dk-cite! 'bmx-subset-antisym j mx)
                       (dk-ass!))))))))))))
(bmx-qed! 'maximal-ideal-exists)
