;; F[T] is a commutative ring
(define gw-ROS (list (list '(CARR (OP-ALG md tt)) '(OPS md tt)) (list '(ADD (OP-ALG md tt)) '(OP-ADD md tt))
                     (list '(MUL (OP-ALG md tt)) '(OP-MUL md tt)) (list '(NEG (OP-ALG md tt)) '(OP-NEG md tt))
                     (list '(ZERO (OP-ALG md tt)) '(OP-ZERO md)) (list '(ONE (OP-ALG md tt)) '(OP-ONE md))))
(define (gw-ro-cite!)
  (for-each (lambda (nm) (dk-cite! nm 'md 'tt)) '(op-alg-carr op-alg-add op-alg-mul op-alg-neg op-alg-zero op-alg-one)))
(define (gw-ro!) (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr))))) gw-ROS))
(define (gw-fun-typ! op arity)          ; goal (IN op FUN(...)) for op = (OP-ADD md tt) etc.
  (mac (car op))
  (let ((new (dk-opened (lambda () (lam-t)))))
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin
                      (dk-focus! l)
                      (let ((g (dk-goal)))
                        (cond ((and (dk-head-is? g 'IN) (equal? (caddr g) 'SET))
                               (if (dk-head-is? (cadr g) 'CARTESIAN)
                                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                                   (ass)))
                              (#t
                               (let* ((_p (dk-peel!))
                                      (body (cadr (dk-goal)))
                                      (app (cadddr body))
                                      (vs (if (= arity 2)
                                              (if (eq? (car op) 'OP-MUL)
                                                  (list (car app) (car (cadr app)))
                                                  (list (car (cadr app)) (car (caddr app))))
                                              (list (car (cadr app)))))
                                      (t (cons op vs)))
                                 (dk-have! (list '= t body) (lambda () (mac (car op)) (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)))
                                 (dk-split-all! (list (dk-cite! 'ops-closed 'md 'tt (car vs) (if (= arity 2) (cadr vs) (car vs)))))
                                 (dk-rewrite-h! (list 'IN t gw-OPS) t body)
                                 (ass))))))))
              new)))
(define (gw-prop!)                      ; a property clause, after the read-offs
  (let ((nm (car (dk-goal))))
    (if (not (eq? nm 'FORALL)) (mac nm))
    (let* ((ls (dk-peel!))
           (vs (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gw-OPS))) ls))))
      (for-each gw-elim! vs)
      (dk-conj-close! (lambda () (gw-eq-close!))))))
(define (gw-ring-conj!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((dk-head-is? g '=) (mac 'OP-ALG) (len-r) (go-rfl-or-ass!))
          (#t
           (gw-ro!)
           (let ((g (dk-goal)))
             (cond ((equal? g (list 'IN gw-OPS 'SET)) (dk-cite! 'ops-in-set 'md 'tt) (ass))
                   ((and (dk-head-is? g 'IN) (equal? (cadr g) '(OP-ADD md tt))) (gw-fun-typ! '(OP-ADD md tt) 2))
                   ((and (dk-head-is? g 'IN) (equal? (cadr g) '(OP-MUL md tt))) (gw-fun-typ! '(OP-MUL md tt) 2))
                   ((and (dk-head-is? g 'IN) (equal? (cadr g) '(OP-NEG md tt))) (gw-fun-typ! '(OP-NEG md tt) 1))
                   ((and (dk-head-is? g 'IN) (member (cadr g) '((OP-ZERO md) (OP-ONE md))))
                    (let* ((zero? (equal? (cadr g) '(OP-ZERO md))) (P (if zero? '(ZERO (POLY (SCAL md))) '(ONE (POLY (SCAL md))))))
                      (dk-cite! (if zero? 'op-zero-of 'op-one-of) 'md 'tt)
                      (gw-ptype! P) (gw-ops! P)
                      (subst (list '= (cadr g) (gw-of P)))
                      (ass)))
                   (#t (gw-prop!))))))))
(sp (make-wff (gw-pre '(IS-COMMUTATIVE-RING (OP-ALG md tt)))))
