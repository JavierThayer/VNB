(define go-mone '((NEG (SCAL md)) (ONE (SCAL md))))
(define (go-kh body)
  (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) (list 'IMPLIES '(IS-COMMUTATIVE-RING (SCAL md))
    (list 'FORALL 'v (list 'IMPLIES '(IN v (VEC md)) (list 'FORALL 'k (list 'IMPLIES '(IN k (CARR (POLY (SCAL md))))
