;; an element of OPS as p(T): return p, after rewriting F to p(T) in the goal
(define (gw-elim! f)
  (let ((c (dk-cite! 'ops-elim 'md 'tt f)))
    (if (not (and (dk-asm? (cadr c)) (dk-asm? (caddr c)))) (dk-split-all! (list c))))
  (let ((p (go-skolem!)))
    (subst (list '= f (gw-of p)))
    p))
(define (gw-ptype! P)                   ; P a polynomial expression over typed atoms: land P in CARR(POLY F)
  (if (not (dk-asm? (list 'IN P gw-CP)))
      (cond ((and (pair? P) (equal? (car P) '(ADD (POLY (SCAL md))))) (gw-ptype! (cadr P)) (gw-ptype! (caddr P)) (dk-cite! 'ring-add-closed gw-PF (cadr P) (caddr P)))
            ((and (pair? P) (equal? (car P) '(MUL (POLY (SCAL md))))) (gw-ptype! (cadr P)) (gw-ptype! (caddr P)) (dk-cite! 'ring-carrier-closed-mul gw-PF (cadr P) (caddr P)))
            ((and (pair? P) (equal? (car P) '(NEG (POLY (SCAL md))))) (gw-ptype! (cadr P)) (dk-cite! 'ring-neg-in-carr gw-PF (cadr P)))
            ((equal? P '(ZERO (POLY (SCAL md)))) (dk-cite! 'ring-zero-in gw-PF))
            ((equal? P '(ONE (POLY (SCAL md)))) (dk-cite! 'ring-one-in gw-PF))
            (#t (error "gw-ptype!: cannot type" (expression->string P))))))
(define (gw-norm! t)                    ; t an F[T] term over p(T)'s: return P with (= t P(T)) in context (or t = P(T))
  (cond ((dk-head-is? t 'OP-OF) (cadddr t))
        ((equal? t '(OP-ZERO md)) (dk-cite! 'op-zero-of 'md 'tt) '(ZERO (POLY (SCAL md))))
        ((equal? t '(OP-ONE md)) (dk-cite! 'op-one-of 'md 'tt) '(ONE (POLY (SCAL md))))
        ((and (pair? t) (member (car t) '((OP-ADD md tt) (OP-MUL md tt))))
         (let* ((a (cadr t)) (b (caddr t)) (P (gw-norm! a)) (Q (gw-norm! b))
                (add? (equal? (car t) '(OP-ADD md tt)))
                (R (if add? (gq-padd P Q) (gq-pmul P Q)))
                (st (list (car t) (gw-of P) (gw-of Q))))
           (gw-ptype! P) (gw-ptype! Q) (gw-ptype! R) (gw-ops! R)
           (dk-cite! (if add? 'op-add-of 'op-mul-of) 'md 'tt P Q)
           (if (not (dk-asm? (list '= t (gw-of R))))
               (dk-have! (list '= t (gw-of R))
                 (lambda ()
                   (if (not (equal? a (gw-of P))) (subst (list '= a (gw-of P))))
                   (if (not (equal? b (gw-of Q))) (subst (list '= b (gw-of Q))))
                   (subst (list '= st (gw-of R)))
                   (go-rfl-or-ass!))))
           R))
        ((and (pair? t) (equal? (car t) '(OP-NEG md tt)))
         (let* ((a (cadr t)) (P (gw-norm! a)) (R (list '(NEG (POLY (SCAL md))) P)) (st (list (car t) (gw-of P))))
           (gw-ptype! P) (gw-ptype! R) (gw-ops! R)
           (dk-cite! 'op-neg-of 'md 'tt P)
           (if (not (dk-asm? (list '= t (gw-of R))))
               (dk-have! (list '= t (gw-of R))
                 (lambda ()
                   (if (not (equal? a (gw-of P))) (subst (list '= a (gw-of P))))
                   (subst (list '= st (gw-of R)))
                   (go-rfl-or-ass!))))
           R))
        (#t (error "gw-norm!: not an F[T] term" (expression->string t)))))
(define (gw-eq-close!)                  ; goal (= L R) between F[T] terms
  (let* ((g (dk-goal)) (L (cadr g)) (R (caddr g)) (P (gw-norm! L)) (Q (gw-norm! R)))
    (if (not (equal? L (gw-of P))) (subst (list '= L (gw-of P))))
    (if (not (equal? R (gw-of Q))) (subst (list '= R (gw-of Q))))
    (gw-ptype! P) (gw-ptype! Q) (gw-ops! P) (gw-ops! Q)
    (if (equal? P Q)
        (go-rfl-or-ass!)
        (begin
          (dk-have! (list '= P Q) (lambda () (crs)))
          (dk-congr! (list '= P Q) (lambda (x) (gw-of x)))))))

