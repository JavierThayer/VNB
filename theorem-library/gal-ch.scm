  (AND (IN ((OP-ADD md tt) f g) (OPS md tt)) (AND (IN ((OP-MUL md tt) f g) (OPS md tt)) (IN ((OP-NEG md tt) f) (OPS md tt)))))))))))
(dk-peel!)
(gw-ctx!)
(gw-elim! 'f)
(gw-elim! 'g)
(dk-conj-close!
  (lambda ()
    (let* ((t (cadr (dk-goal))) (P (gw-norm! t)))
