;;; ch3b-const.scm -- complex-analysis.pdf ch. 3: two holomorphic logarithms of the same
;;; function differ by a constant 2 pi i n on a connected open set, and the uniqueness of
;;; the principal branch of log (Cor 3.24).  Agent ISOM (brief CH3-B), 2026-10-26.
;;;
;;;   holomorphic-continuous-mag    the continuity of a holomorphic f, in moduli:
;;;                                 |z - a| < del  =>  |f(z) - f(a)| < eps on u
;;;   exp-equal-diff-locally-constant
;;;   exp-equal-diff-constant       u connected, g, h holomorphic, exp g = exp h on u
;;;                                 ==>  g - h is constant on u
;;;   exp-equal-diff-2-pi-i         ... and the constant is 2 pi i n, n in ZZ
;;;   cc-log-unique-branch          (Cor 3.24, uniqueness) g holomorphic on the slit plane,
;;;                                 g(1) = 0, exp g(z) = z  ==>  g = log there
;;;   principal-log-exists-unique   (Cor 3.24) existence and uniqueness together
;;;
;;; The constancy argument is the discrete one: g - h takes values in 2 pi i ZZ, and two
;;; values closer than 1/2 are equal (cc-exp-kernel-discrete); continuity makes g - h
;;; locally constant, and connected-locally-constant does the rest.  No derivative and no
;;; integral is used.
;;;
;;; WINDOW.  Citations: holomorphic-on-continuous, subspace-pts / subspace-dist,
;;; nf-cc-agree-*, cc-ms-dist, cc-ms-ball-membership, connected-locally-constant,
;;; cc-exp-shift / -nonzero / -kernel-sub / -kernel-discrete / -one-iff, cc-log-spec,
;;; cc-log-holomorphic, cc-log-one, and cc-slit-plane-connected
;;; (scratchpad/camontel/ca-connected.scm, UNWIRED: it must be wired first).
;;; lo = after ca-connected.scm and cc-log-holomorphic.scm; hi = none.  Library:
;;; complex-analysis.
;;;
;;; Helper prefix: c3k-.

(define (c3k-head g) (and (pair? g) (car g)))
(define (c3k-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (c3k-cc! t)                    ; t in CC, by type-term
  (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))
(define (c3k-mag! t)                   ; magnitude(t) in RR
  (c3k-cc! t)
  (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))
(define c3k-NF '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define c3k-slit '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))

;;; =====================================================================
;;; holomorphic-continuous-mag
;;; =====================================================================
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
     (FORALL a (IMPLIES (IN a u) (FORALL eps (IMPLIES (POS-RR eps)
       (FORSOME del (AND (POS-RR del)
         (FORALL z (IMPLIES (IN z u)
           (IMPLIES (< (magnitude (- z a)) del) (< (magnitude (- (f z) (f a))) eps)))))))))))))))
(dk-peel!)
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-open 'u 'f)
(fact 'cc-is-metric-space)
(fact 'nf-cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(fact 'nf-cc-agree-pts)
(dk-have! '(SUBSET u CC)
  (lambda ()
    (dk-project! (list 'SUBSET 'u (list 'PTS c3k-NF)) 'is-open (list 'IS-OPEN c3k-NF 'u))
    (subst (list '== 'CC '(PTS CC-MS)))
    (subst (list '== '(PTS CC-MS) (list 'PTS c3k-NF)))
    (ass)))
(fact 'cc-is-set)
(dk-close-if! (lambda () (fact 'subclass-of-set-is-set 'u 'CC)) (lambda () #t))
(fact 'subspace-pts c3k-NF 'u)
(define c3k-SUB (list 'SUBSPACE-MS c3k-NF 'u))
(define c3k-cont (dk-apply! (dk-cite! 'holomorphic-on-continuous 'u 'f) 'a))
(dk-split-all! (dk-landed (lambda () (mac-h 'is-continuous-at c3k-cont))))
(define c3k-h (dk-halve! 'eps))
(define c3k-ccl (dk-pick (lambda (h) (and (eq? (c3k-head h) 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h 'f)))
                         "the continuity clause"))
(define c3k-del (dk-skolem! (dk-apply! c3k-ccl c3k-h)))
(define c3k-dcl (dk-pick (lambda (h) (and (eq? (c3k-head h) 'FORALL) (dk-contains? h c3k-del))) "the delta clause"))
(ew c3k-del)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (c3k-head (dk-goal)) 'FORALL))
       (ass)
       (let* ((pl (dk-peel!))
              (z (cadr (car (filter (lambda (q) (eq? (c3k-head q) 'IN)) pl)))))
         (fact 'subset-mem-fwd 'u 'CC z)
         (fact 'subset-mem-fwd 'u 'CC 'a)
         (fact 'fun-apply-type-c 'f 'u 'CC z)
         (fact 'fun-apply-type-c 'f 'u 'CC 'a)
         (c3k-mag! '(- z a)) (c3k-mag! (list '- 'z 'a))
         (let ((za (list '- z 'a)) (az (list '- 'a z))
               (fd (list '- (list 'f z) '(f a))) (fd2 (list '- '(f a) (list 'f z))))
           (c3k-mag! az) (c3k-mag! za) (c3k-mag! fd) (c3k-mag! fd2)
           (fact 'cc-magnitude-sub-sym 'a z)
           (fact 'cc-magnitude-sub-sym '(f a) (list 'f z))
           (fact 'rr-pos-rr-in-rr c3k-del)
           (fact 'rr-pos-rr-in-rr c3k-h)
           (fact 'rr-pos-rr-in-rr 'eps)
           (fact 'rr-lt-of-pos-rr c3k-h)
           ;; the subspace distance from a to z is |a - z|
           (dk-have! (list 'IN z (list 'PTS c3k-SUB)) (lambda () (subst (list '== (list 'PTS c3k-SUB) 'u)) (ass)))
           (dk-have! (list '<= (list (list 'DIST c3k-SUB) 'a z) c3k-del)
             (lambda ()
               (fact 'subspace-dist c3k-NF 'u 'a z)
               (subst (list '== (list (list 'DIST c3k-SUB) 'a z) (list (list 'DIST c3k-NF) 'a z)))
               (dk-have! '(IN a (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
               (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
               (fact 'nf-cc-agree-dist 'a z)
               (subst (list '== (list (list 'DIST c3k-NF) 'a z) (list '(DIST CC-MS) 'a z)))
               (fact 'cc-ms-dist 'a z)
               (subst (list '== (list '(DIST CC-MS) 'a z) (list 'magnitude az)))
               (dk-ineq! (list '= (list 'magnitude az) (list 'magnitude za))
                         (list '< (list 'magnitude za) c3k-del)
                         (list 'IN (list 'magnitude az) 'RR) (list 'IN (list 'magnitude za) 'RR)
                         (list 'IN c3k-del 'RR))))
           (let ((fz (dk-apply! c3k-dcl z)))
             (dk-have! (list '<= (list 'magnitude fd2) c3k-h)
               (lambda ()
                 (dk-have! '(IN (f a) (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (dk-have! (list 'IN (list 'f z) '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                 (fact 'nf-cc-agree-dist '(f a) (list 'f z))
                 (fact 'cc-ms-dist '(f a) (list 'f z))
                 (subst (list '== (list 'magnitude fd2) (list '(DIST CC-MS) '(f a) (list 'f z))))
                 (subst (list '== (list '(DIST CC-MS) '(f a) (list 'f z)) (list (list 'DIST c3k-NF) '(f a) (list 'f z))))
                 (ass)))
             (dk-ineq! (list '= (list 'magnitude fd2) (list 'magnitude fd))
                       (list '<= (list 'magnitude fd2) c3k-h)
                       (list '= (list '+ c3k-h c3k-h) 'eps) (list '< 0 c3k-h)
                       (list 'IN (list 'magnitude fd) 'RR) (list 'IN (list 'magnitude fd2) 'RR)
                       (list 'IN c3k-h 'RR) (list 'IN 'eps 'RR))))))))
(qed 'holomorphic-continuous-mag)
(topic! 'holomorphic-continuous-mag 'analysis)

;;; =====================================================================
;;; exp-eq-sub-one: exp a = exp b  ==>  exp(a - b) = 1
;;; =====================================================================
(sp (make-wff '(FORALL a (IMPLIES (IN a CC) (FORALL b (IMPLIES (IN b CC)
     (IMPLIES (= (CC-EXP a) (CC-EXP b)) (= (CC-EXP (- a b)) 1))))))))
(dk-peel!)
(define c3k-X '(CC-EXP (- a b)))
(define c3k-e '(CC-EXP b))
(c3k-cc! '(- a b))
(fact 'cc-exp-converges '(- a b))
(fact 'cc-exp-converges 'b)
(dk-split-all!)
(fact 'cc-exp-nonzero 'b)
(fact 'cc-exp-shift 'a 'b)
(dk-have! (list '= (list '* c3k-e c3k-X) c3k-e)
  (lambda () (subst (list '= (list '* c3k-e c3k-X) '(CC-EXP a))) (ass)))
(dk-have! (list '= (list '* (list '- c3k-X 1) c3k-e) 0)
  (lambda ()
    (dk-have! (list '= (list '* (list '- c3k-X 1) c3k-e) (list '- (list '* c3k-e c3k-X) c3k-e)) (lambda () (crs)))
    (subst (list '= (list '* (list '- c3k-X 1) c3k-e) (list '- (list '* c3k-e c3k-X) c3k-e)))
    (subst (list '= (list '* c3k-e c3k-X) c3k-e))
    (crs)))
(fact 'cc-one-in)
(c3k-cc! (list '- c3k-X 1))
(fact 'cc-mul-zero-left (list '- c3k-X 1) c3k-e)
(dk-have! (list '= c3k-X (list '+ (list '- c3k-X 1) 1)) (lambda () (crs)))
(subst (list '= c3k-X (list '+ (list '- c3k-X 1) 1)))
(subst (list '= (list '- c3k-X 1) 0))
(crs)
(qed 'exp-eq-sub-one)
(topic! 'exp-eq-sub-one 'analysis)

;;; =====================================================================
;;; exp-equal-diff-constant
;;; =====================================================================
(define (c3k-u-cc!)                    ; HOLOMORPHIC-ON(u, _) in context: u subset CC
  (if (not (dk-asm? '(SUBSET u CC)))
      (begin
        (fact 'cc-is-metric-space)
        (fact 'nf-cc-is-metric-space)
        (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
        (fact 'nf-cc-agree-pts)
        (dk-have! '(SUBSET u CC)
          (lambda ()
            (dk-project! (list 'SUBSET 'u (list 'PTS c3k-NF)) 'is-open (list 'IS-OPEN c3k-NF 'u))
            (subst (list '== 'CC '(PTS CC-MS)))
            (subst (list '== '(PTS CC-MS) (list 'PTS c3k-NF)))
            (ass))))))
(define c3k-D '(VNB-LAMBDA c3kz_ u (- (g c3kz_) (h c3kz_))))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'g (list 'FORALL 'h
     (list 'IMPLIES '(IS-CONNECTED CC-MS u)
       (list 'IMPLIES '(HOLOMORPHIC-ON u g)
         (list 'IMPLIES '(HOLOMORPHIC-ON u h)
           (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (CC-EXP (h z)))))
             '(FORALL p (IMPLIES (IN p u) (FORALL q (IMPLIES (IN q u)
                (= (- (g p) (h p)) (- (g q) (h q))))))))))))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'g)
(c3k-u-cc!)
(fact 'holomorphic-on-in-fun 'u 'g)
(fact 'holomorphic-on-in-fun 'u 'h)
(fact 'nn-is-set)
(define c3k-EXPEQ (dk-pick (lambda (q) (and (eq? (c3k-head q) 'FORALL) (dk-contains? q 'CC-EXP))) "the exp equation"))
(define (c3k-val! x)                   ; g x, h x, g x - h x in CC
  (fact 'subset-mem-fwd 'u 'CC x)
  (fact 'fun-apply-type-c 'g 'u 'CC x)
  (fact 'fun-apply-type-c 'h 'u 'CC x)
  (c3k-cc! (list '- (list 'g x) (list 'h x))))
(define c3k-loc (dk-cite! 'connected-locally-constant 'CC-MS 'u c3k-D))
(dk-have! (cadr c3k-loc)
  (lambda ()
    (let* ((x (dk-di-var!))
           (q4 1/4))
      (c3k-val! x)
      (dk-have! (list 'POS-RR q4)
        (lambda () (dk-have! (list 'IN q4 'RR) (lambda () (arith)))
                   (dk-have! (list '< 0 q4) (lambda () (arith)))
                   (dk-close-if! (lambda () (fact 'rr-pos-rr-of-lt q4)) ass)))
      (let* ((d1 (dk-skolem! (dk-cite! 'holomorphic-continuous-mag 'u 'g x q4)))
             (c1 (dk-pick (lambda (q) (and (eq? (c3k-head q) 'FORALL) (dk-contains? q d1))) "clause g"))
             (d2 (dk-skolem! (dk-cite! 'holomorphic-continuous-mag 'u 'h x q4)))
             (c2 (dk-pick (lambda (q) (and (eq? (c3k-head q) 'FORALL) (dk-contains? q d2))) "clause h")))
        (fact 'rr-pos-rr-in-rr d1) (fact 'rr-lt-of-pos-rr d1)
        (fact 'rr-pos-rr-in-rr d2) (fact 'rr-lt-of-pos-rr d2)
        (let* ((r (dk-skolem! (dk-cite! 'rr-min-pos d1 d2))))
          (dk-close-if! (lambda () (fact 'rr-pos-rr-of-lt r)) (lambda () #t))
          (ew r)
          (dk-conj-close!
           (lambda ()
             (if (not (eq? (c3k-head (dk-goal)) 'FORALL))
                 (ass)
                 (let* ((pl (dk-peel!))
                        (y (cadr (car (filter (lambda (q) (and (eq? (c3k-head q) 'IN) (eq? (caddr q) 'u))) pl))))
                        (gy (list 'g y)) (hy (list 'h y)) (gx (list 'g x)) (hx (list 'h x))
                        (dy (list '- gy hy)) (dx (list '- gx hx)) (w (list '- dy dx)))
                   (c3k-val! y)
                   (dk-project! (list '< (list 'magnitude (list '- y x)) r) 'cc-ms-ball-membership
                                (list 'IN y (list 'BALL 'CC-MS x r)))
                   (c3k-mag! (list '- y x))
                   (dk-have! (list '< (list 'magnitude (list '- y x)) d1)
                     (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y x)) r) (list '<= r d1)
                                          (list 'IN (list 'magnitude (list '- y x)) 'RR) (list 'IN r 'RR) (list 'IN d1 'RR))))
                   (dk-have! (list '< (list 'magnitude (list '- y x)) d2)
                     (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y x)) r) (list '<= r d2)
                                          (list 'IN (list 'magnitude (list '- y x)) 'RR) (list 'IN r 'RR) (list 'IN d2 'RR))))
                   (dk-apply! c1 y)
                   (dk-apply! c2 y)
                   (dk-lam-b!)
                   ;; exp(w) = 1
                   (dk-apply! c3k-EXPEQ y)
                   (dk-apply! c3k-EXPEQ x)
                   (dk-cite! 'exp-eq-sub-one gy hy)
                   (dk-cite! 'exp-eq-sub-one gx hx)
                   (c3k-and! (list '= (list 'CC-EXP dy) 1) (list '= (list 'CC-EXP dx) 1))
                   (fact 'cc-exp-kernel-sub dy dx)
                   ;; |w| < 1/2
                   (let* ((b (list '- gx hy)) (ab (list '- dy b)) (bc (list '- b dx))
                          (gg (list '- gy gx)) (hh (list '- hx hy)) (hh2 (list '- hy hx)))
                     (c3k-cc! b) (c3k-cc! w)
                     (fact 'cc-magnitude-sub-chain dy b dx)
                     (dk-have! (list '= ab gg) (lambda () (crs)))
                     (dk-have! (list '= bc hh) (lambda () (crs)))
                     (dk-rewrite-h! (list '<= (list 'magnitude w) (list '+ (list 'magnitude ab) (list 'magnitude bc))) ab gg)
                     (dk-rewrite-h! (list '<= (list 'magnitude w) (list '+ (list 'magnitude gg) (list 'magnitude bc))) bc hh)
                     (c3k-mag! gg) (c3k-mag! hh) (c3k-mag! hh2) (c3k-mag! w)
                     (fact 'cc-magnitude-sub-sym hx hy)
                     (dk-have! (list '< (list 'magnitude w) 1/2)
                       (lambda ()
                         (dk-ineq! (list '<= (list 'magnitude w) (list '+ (list 'magnitude gg) (list 'magnitude hh)))
                                   (list '= (list 'magnitude hh) (list 'magnitude hh2))
                                   (list '< (list 'magnitude gg) q4) (list '< (list 'magnitude hh2) q4)
                                   (list 'IN (list 'magnitude w) 'RR) (list 'IN (list 'magnitude gg) 'RR)
                                   (list 'IN (list 'magnitude hh) 'RR) (list 'IN (list 'magnitude hh2) 'RR))))
                     (fact 'cc-exp-kernel-discrete w)
                     (dk-have! (list '= dy (list '+ w dx)) (lambda () (crs)))
                     (subst (list '= dy (list '+ w dx)))
                     (subst (list '= w 0))
                     (crs)))))))))))
(define c3k-all (dk-apply! c3k-loc))
(dk-peel!)
(let* ((gl (dk-goal)) (p (cadr (cadr (cadr gl)))) (q (cadr (cadr (caddr gl)))))
  (c3k-val! p) (c3k-val! q)
  (dk-lam-b-h! (dk-apply! c3k-all p q))
  (ass))
(qed 'exp-equal-diff-constant)
(topic! 'exp-equal-diff-constant 'analysis)
(alias! 'exp-equal-diff-constant
        "two holomorphic logarithms of the same function on a connected open set differ by a constant")

;;; =====================================================================
;;; exp-equal-diff-2-pi-i: the constant is 2 pi i n
;;; =====================================================================
(define c3k-2pii '(* (* 2 PI) +i))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'g (list 'FORALL 'h
     (list 'IMPLIES '(IS-CONNECTED CC-MS u)
       (list 'IMPLIES '(HOLOMORPHIC-ON u g)
         (list 'IMPLIES '(HOLOMORPHIC-ON u h)
           (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (CC-EXP (h z)))))
             (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 u)
               (list 'FORSOME 'n (list 'AND '(IN n ZZ)
                 (list 'FORALL 'z (list 'IMPLIES '(IN z u)
                   (list '= '(g z) (list '+ '(h z) (list '* 'n c3k-2pii))))))))))))))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'g)
(c3k-u-cc!)
(fact 'holomorphic-on-in-fun 'u 'g)
(fact 'holomorphic-on-in-fun 'u 'h)
(define c3k-E2 (dk-pick (lambda (q) (and (eq? (c3k-head q) 'FORALL) (dk-contains? q 'CC-EXP))) "the exp equation"))
(define c3k-C (dk-cite! 'exp-equal-diff-constant 'u 'g 'h))
(c3k-val! 'z0)
(dk-apply! c3k-E2 'z0)
(dk-cite! 'exp-eq-sub-one '(g z0) '(h z0))
(define c3k-d0 '(- (g z0) (h z0)))
(define c3k-n (dk-skolem! (car (dk-landed (lambda () (mac-h 'cc-exp-one-iff (list '= (list 'CC-EXP c3k-d0) 1)))))))
(ew c3k-n)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (c3k-head (dk-goal)) 'FORALL))
       (ass)
       (let ((z (dk-di-var!)))
         (c3k-val! z)
         (dk-apply! c3k-C z 'z0)
         (subst (list '= (list '* c3k-n c3k-2pii) c3k-d0))
         (subst (list '= c3k-d0 (list '- (list 'g z) (list 'h z))))
         (crs)))))
(qed 'exp-equal-diff-2-pi-i)
(topic! 'exp-equal-diff-2-pi-i 'analysis)
(alias! 'exp-equal-diff-2-pi-i
        "two holomorphic logarithms of the same function on a connected open set differ by 2 pi i n")

;;; =====================================================================
;;; Cor 3.24: the principal branch of log is the only holomorphic g on the slit plane
;;; with g(1) = 0 and exp g(z) = z
;;; =====================================================================
(define c3k-L (list 'VNB-LAMBDA 'clhw_ c3k-slit '(CC-LOG clhw_)))
(define (c3k-one-in-slit!)
  (if (not (dk-asm? (list 'IN 1 c3k-slit)))
      (begin
        (fact 'cc-one-in) (fact 'rr-one-in)
        (dk-cite! 'cc-re-of-real 1)
        (dk-have! (list 'IN 1 c3k-slit)
          (lambda ()
            (in-sep! (lambda ()
                       (di) (dk-split-all!)
                       (dk-have! '(IN (real-part 1) RR) (lambda () (type-term)))
                       (dk-absurd! '(<= (real-part 1) 0) '(= (real-part 1) 1)))))))))
(define (c3k-slit-parts! z)            ; z in the slit plane: z in CC and the guard
  (dk-project! (list 'IN z 'CC) (lambda () (sep-me (list 'IN z c3k-slit))))
  (dk-project! (list 'NOT (list 'AND (list '= (list 'imag-part z) 0) (list '<= (list 'real-part z) 0)))
               (lambda () (sep-me (list 'IN z c3k-slit)))))

(sp (make-wff (list 'FORALL 'g (list 'IMPLIES (list 'HOLOMORPHIC-ON c3k-slit 'g)
     (list 'IMPLIES '(= (g 1) 0)
       (list 'IMPLIES (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) '(= (CC-EXP (g z)) z)))
         (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) '(= (g z) (CC-LOG z))))))))))
(dk-peel!)
(fact 'cc-log-holomorphic)
(fact 'cc-slit-plane-connected)
(fact 'cc-log-one)
(c3k-one-in-slit!)
(fact 'holomorphic-on-in-fun c3k-slit 'g)
(fact 'holomorphic-on-in-fun c3k-slit c3k-L)
(define c3k-gE (dk-pick (lambda (q) (and (eq? (c3k-head q) 'FORALL) (dk-contains? q 'CC-EXP))) "exp g = id"))
(define (c3k-logval! z)                ; L(z) = log z, in CC, exp(log z) = z
  (c3k-slit-parts! z)
  (dk-split-all! (list (dk-cite! 'cc-log-spec z))))
(dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) (list '= '(CC-EXP (g z)) (list 'CC-EXP (list c3k-L 'z)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (c3k-logval! z)
      (dk-lam-b!)
      (dk-apply! c3k-gE z)
      (subst (list '= (list 'CC-EXP (list 'g z)) z))
      (subst (list '= (list 'CC-EXP (list 'CC-LOG z)) z))
      (rfl))))
(define c3k-C3 (dk-cite! 'exp-equal-diff-constant c3k-slit 'g c3k-L))
(let ((z (cadr (cadr (dk-goal)))))
  (c3k-logval! z)
  (c3k-logval! 1)
  (fact 'fun-apply-type-c 'g c3k-slit 'CC z)
  (fact 'fun-apply-type-c 'g c3k-slit 'CC 1)
  (let ((eq0 (dk-apply! c3k-C3 z 1)))
    (dk-lam-b-h! eq0))
  (let ((e (dk-pick (lambda (q) (and (eq? (c3k-head q) '=) (dk-contains? q '(CC-LOG 1)) (dk-contains? q (list 'g z))))
                    "the constancy at z and 1")))
    (dk-rewrite-h! e '(CC-LOG 1) 0)
    (let ((e2 (dk-pick (lambda (q) (and (eq? (c3k-head q) '=) (dk-contains? q (list 'g z)) (dk-contains? q '(g 1)))) "after log 1")))
      (dk-rewrite-h! e2 '(g 1) 0))
    (dk-have! (list '= (list 'g z) (list '+ (list '- (list 'g z) (list 'CC-LOG z)) (list 'CC-LOG z))) (lambda () (crs)))
    (subst (list '= (list 'g z) (list '+ (list '- (list 'g z) (list 'CC-LOG z)) (list 'CC-LOG z))))
    (subst (list '= (list '- (list 'g z) (list 'CC-LOG z)) '(- 0 0)))
    (crs)))
(qed 'cc-log-unique-branch)
(topic! 'cc-log-unique-branch 'analysis)
(alias! 'cc-log-unique-branch
        "the principal logarithm is the only holomorphic g on the slit plane with g(1) = 0 and exp g(z) = z")

(sp (make-wff (list 'AND
     (list 'FORSOME 'g (list 'AND (list 'HOLOMORPHIC-ON c3k-slit 'g)
       (list 'AND '(= (g 1) 0)
         (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) '(= (CC-EXP (g z)) z))))))
     (list 'FORALL 'g (list 'IMPLIES (list 'HOLOMORPHIC-ON c3k-slit 'g)
       (list 'IMPLIES '(= (g 1) 0)
         (list 'IMPLIES (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) '(= (CC-EXP (g z)) z)))
           (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c3k-slit) '(= (g z) (CC-LOG z)))))))))))
(fact 'cc-log-unique-branch)
(dk-conj-close!
 (lambda ()
   (if (dk-asm? (dk-goal))
       (ass)
       (begin
         (fact 'cc-log-holomorphic)
         (fact 'cc-log-one)
         (c3k-one-in-slit!)
         (ew c3k-L)
         (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond
               ((eq? (c3k-head gl) '=)
                (c3k-logval! 1)
                (dk-lam-b!) (ass))
               ((eq? (c3k-head gl) 'FORALL)
                (let ((z (dk-di-var!)))
                  (c3k-logval! z)
                  (dk-lam-b!) (ass)))
               (#t (ass))))))))))
(qed 'principal-log-exists-unique)
(topic! 'principal-log-exists-unique 'analysis)
(alias! 'principal-log-exists-unique
        "there is a unique holomorphic g on the slit plane with g(1) = 0 and exp g(z) = z")
