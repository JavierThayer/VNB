;;; theorem-library/inclusion-exclusion.scm -- THE INCLUSION-EXCLUSION PRINCIPLE (ALGEBRAIC-NUMBERS notes, Prop. 1.20
;;; and Cor. 1.21; ALGNUM, bundle B2, 2026-10-26).
;;;   inclusion-exclusion          PROP. 1.20: for a finite index set I, a finite set X and sets A_k (k in I):
;;;                                card{x in X : x in no A_k} = sum over F in POWER(I) of (-1)^card(F) card{x in X : x in
;;;                                every A_k, k in F} (a FINSUM in C; the intersection over F = {} is X).
;;;   inclusion-exclusion-union    COR. 1.21: card{x in X : x in some A_k} = sum over the nonempty F of
;;;                                (-1)^(card(F) - 1) card(the intersection over F).
;;;   Route: finite-set induction on I with the property quantified over X (ma-induct!); adding j splits POWER(I u {j})
;;;   into POWER(I) and the image of F |-> F u {j} (power-insert-cover); the intersection over F u {j} is the one over
;;;   F inside X n A_j.  Bricks: inclusion-exclusion-base, -split-card, -split-sum.
;;; LOAD WINDOW.  lo: rake-combinatorics (power-insert-cover/-disjoint/-injective), rake-finsum-union
;;; (finsum-union-disjoint), finsum-reindex-ag, injection-image-is-bijection, card-insert-curried, rake-asm-b3
;;; (cc-scalar-ring-*).  hi: none.  Library: analysis (the sums are taken in C).  Helper prefix ie-.

;;; (0) the ma- kit
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))



;;; (42) ALGEBRAIC-NUMBERS ch. 1, bundle B2: the inclusion-exclusion principle (Prop. 1.20, Cor. 1.21).
;;; For a finite family {A_k}_{k in I} of subsets of a finite set X (A_k is the term (A k)):
;;;   INT(X, A, F) = {x in X : x in A_k for every k in F}     (INT(X, A, {}) = X: the notes' convention)
;;;   OUT(X, A, I) = {x in X : x in no A_k, k in I}           (X minus the union)
;;;   card OUT(X, A, I) = sum_{F subset I} (-1)^card(F) card INT(X, A, F), the sum a FINSUM over POWER(I) in C.
;;; Route: induction on the finite index set I (finite-set-induction, the property quantified over X); adding a
;;; point j splits POWER(I u {j}) into POWER(I) and its image under F |-> F u {j} (power-insert-cover), and
;;; INT(X, A, F u {j}) = INT(X n A_j, A, F).  Helper prefix ie-.
(define ie-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ie-ag (list 'RING-ADDITIVE-AG ie-r))
(define (ie-int x a f) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ f) (list 'IN 'iex_ (list a 'iek_))))))
(define (ie-out x a i) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ i) (list 'NOT (list 'IN 'iex_ (list a 'iek_)))))))
(define (ie-body x a f) (list '* (list 'power '(- 1) (list 'CARD f)) (list 'CARD (ie-int x a f))))
(define (ie-lam x a d) (list 'VNB-LAMBDA 'ief_ d (ie-body x a 'ief_)))
(define (ie-sum x a i) (list 'FINSUM ie-ag (ie-lam x a (list 'POWER i)) (list 'POWER i)))
(define (ie-sub x a j) (list 'SEP 'iey_ x (list 'IN 'iey_ (list a j))))

(define (ie-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (ie-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring ie-r)
  (dk-cite! 'ring-additive-ag-is-abelian-group ie-r)
  (fact 'cc-scalar-ring-carr)
  (dk-have! (list '= (list 'CARR ie-ag) 'CC) (lambda () (subst (dk-cite! 'ras-carr ie-r)) (subst (list '= (list 'CARR ie-r) 'CC)) (fact 'cc-is-set) (rfl)))
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (dk-type! '(- 1) 'CC))
;;; the subset SEP of a finite X is a finite set
(define (ie-fin! s x) (ma-sep-subset! s) (ie-finite-sub! s x))
(define (ie-finite-sub! s ca)
  ;; ma-finite-sub! with dk-cite! (the citation may already be in context)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))))
    (dk-apply! cs s)))
;;; (IN (ie-body x a f) CC), f a finite set
(define (ie-body-type! x a f)
  (ie-fin! (ie-int x a f) x)
  (cp-type!* (list 'power '(- 1) (list 'CARD f)))
  (cp-type!* (ie-body x a f)))
(define (cp-type!* t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))

;;; the base: I empty
(sp (make-wff '(FORALL af (FORALL xs (IMPLIES (IN xs SET) (IMPLIES (IN (CARD xs) NN)
  (= (CARD (SEP iex_ xs (FORALL iek_ (IMPLIES (IN iek_ EMPTY-SET) (NOT (IN iex_ (af iek_)))))))
     (FINSUM (RING-ADDITIVE-AG (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
             (VNB-LAMBDA ief_ (POWER EMPTY-SET) (* (power (- 1) (CARD ief_)) (CARD (SEP iex_ xs (FORALL iek_ (IMPLIES (IN iek_ ief_) (IN iex_ (af iek_))))))))
             (POWER EMPTY-SET)))))))))
(dk-peel!)
(ie-ring!)
(fact 'empty-set-is-set)
(let* ((o (ie-out 'xs 'af 'EMPTY-SET)) (n (ie-int 'xs 'af 'EMPTY-SET))
       (to-x! (lambda (s)
                (ma-ext2! s 'xs
                  (lambda (w) (ma-sep-parts! (list 'IN w s)) (ass))
                  (lambda (w)
                    (in-sep! dk-ass!
                      (lambda ()
                        (let ((k (dk-di-var!)))
                          (fact 'empty-set-has-no-members k)
                          (ma-prop-with! (list (list 'IN k 'EMPTY-SET) (list 'NOT (list 'IN k 'EMPTY-SET))))))))))))
  (to-x! o) (to-x! n)
  (fact 'power-of-empty)
  (subst '(= (POWER EMPTY-SET) (PAIR EMPTY-SET EMPTY-SET)))
  (fact 'pair-self-member 'EMPTY-SET)
  (fact 'card-empty)
  (let ((f (ie-lam 'xs 'af '(PAIR EMPTY-SET EMPTY-SET))))
    (dk-have! (list 'IN (list f 'EMPTY-SET) (list 'CARR ie-ag))
      (lambda ()
        (subst (list '= (list 'CARR ie-ag) 'CC))
        (dk-lam-b!)
        (subst '(= (CARD EMPTY-SET) 0))
        (fact 'power-zero '(- 1))
        (subst '(= (power (- 1) 0) 1))
        (subst (list '= n 'xs))
        (cp-type!* '(* 1 (CARD xs)))
        (ass)))
    (subst (dk-apply! (dk-cite! 'finsum-singleton-ptwise ie-ag) 'EMPTY-SET f))
    (dk-lam-b!)
    (subst '(= (CARD EMPTY-SET) 0))
    (fact 'power-zero '(- 1))
    (subst '(= (power (- 1) 0) 1))
    (subst (list '= n 'xs))
    (subst (list '= o 'xs))
    (crs)))
(qed 'inclusion-exclusion-base)

;;; one more index j: OUT(X, I) is the disjoint union of OUT(X, I u {j}) and OUT(X n A_j, I)
(define (ie-or-split! k a b thunk-a thunk-b)
  ;; (IN k (UNION a b)) in context: case split
  (ma-or-split! (car (ma-iff-parts! (dk-cite! 'union-membership a b k))) (list thunk-a thunk-b)))
(sp (make-wff (list 'FORALL 'af (list 'FORALL 'xs (list 'FORALL 's (list 'FORALL 'xv
  (list 'IMPLIES '(IN xs SET) (list 'IMPLIES '(IN (CARD xs) NN) (list 'IMPLIES '(IN xv SET)
    (list '= (list 'CARD (ie-out 'xs 'af 's))
             (list '+ (list 'CARD (ie-out 'xs 'af '(UNION s (PAIR xv xv)))) (list 'CARD (ie-out (ie-sub 'xs 'af 'xv) 'af 's)))))))))))))
(dk-peel!)
(let* ((pr '(PAIR xv xv)) (u (list 'UNION 's pr)) (xp (ie-sub 'xs 'af 'xv))
       (o0 (ie-out 'xs 'af 's)) (o1 (ie-out 'xs 'af u)) (o2 (ie-out xp 'af 's))
       (f0 (lambda (w) (list 'FORALL 'iek_ (list 'IMPLIES '(IN iek_ s) (list 'NOT (list 'IN w '(af iek_))))))))
  (ie-fin! o0 'xs) (ie-fin! o1 'xs) (ie-fin! xp 'xs) (ie-fin! o2 xp) 
  (ma-in-singleton! 'xv)
  (ma-in-union-right! 'xv 's pr) 
  (ma-ext2! o0 (list 'UNION o1 o2)
    (lambda (w)
      (ma-sep-parts! (list 'IN w o0))
      (use-em (list 'IN w '(af xv))
        (lambda ()
          (dk-have! (list 'IN w xp) (lambda () (in-sep! dk-ass! dk-ass!)))
          (dk-have! (list 'IN w o2) (lambda () (in-sep! dk-ass! dk-ass!)))
          (ma-in-union-right! w o1 o2)
          (ass))
        (lambda ()
          (dk-have! (list 'IN w o1)
            (lambda ()
              (in-sep! dk-ass!
                (lambda ()
                  (let ((k (dk-di-var!)))
                    (ie-or-split! k 's pr
                      (lambda () (dk-apply! (dk-ctx-form (f0 w)) k) (ass))
                      (lambda () (ma-singleton-eq! k 'xv) (subst (list '= k 'xv)) (ass))))))))
          (ma-in-union-left! w o1 o2)
          (ass))))
    (lambda (w)
      (ie-or-split! w o1 o2
        (lambda ()
          (ma-sep-parts! (list 'IN w o1))
          (in-sep! dk-ass!
            (lambda ()
              (let ((k (dk-di-var!)))
                (ma-in-union-left! k 's pr)
                (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ u) (list 'NOT (list 'IN w '(af iek_)))))) k)
                (ass)))))
        (lambda ()
          (ma-sep-parts! (list 'IN w o2))
          (ma-sep-parts! (list 'IN w xp))
          (in-sep! dk-ass! dk-ass!)))))
  
  (ma-ext2! (list 'INTERSECTION o1 o2) 'EMPTY-SET
    (lambda (w)
      (ma-iff-parts! (dk-cite! 'intersection-membership o1 o2 w))
      (ma-sep-parts! (list 'IN w o1))
      (ma-sep-parts! (list 'IN w o2))
      (ma-sep-parts! (list 'IN w xp))
      (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ u) (list 'NOT (list 'IN w '(af iek_)))))) 'xv)
      (ma-prop-with! (list (list 'IN w '(af xv)) (list 'NOT (list 'IN w '(af xv))))))
    (lambda (w)
      (fact 'empty-set-has-no-members w)
      (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
  
  (dk-have! (list 'AND (list 'IN o2 'SET) (list 'AND (list 'IN (list 'CARD o2) 'NN) (list '= (list 'INTERSECTION o1 o2) 'EMPTY-SET))))
  (dk-have! (list 'AND (list 'IN o1 'SET) (list 'IN (list 'CARD o1) 'NN)))
  (fact 'card-union-disjoint o1 o2)
  (subst (list '= o0 (list 'UNION o1 o2)))
  (ass))
(qed 'inclusion-exclusion-split-card)

;;; ((MUL R) x y) = x * y and ((ADD R) x y) = x + y for x, y typed in CC, named first
(define (ie-op-eq! op x y)
  (let* ((thm (if (eq? op 'MUL) 'cc-scalar-ring-mul 'cc-scalar-ring-add))
         (cop (if (eq? op 'MUL) '* '+))
         (eq (list '= (list (list op ie-r) x y) (list cop x y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! thm))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))
;;; z in POWER(base), base a finite set: land z in SET, card z in NN, every member of z in base
(define (ie-power-parts! z base)
  (ma-iff-parts! (dk-cite! 'power-set-membership base z))
  (dk-have! (list 'AND (list 'IN base 'SET) (list 'IN (list 'CARD base) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn base)))
    (dk-have! (list 'AND (list 'IN z 'SET) (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ z) (list 'IN 'iez_ base)))))
    (dk-apply! cs z)))

;;; one more index j: the sum over POWER(I u {j}) is the sum over POWER(I) minus the same sum for X n A_j
(sp (make-wff (list 'FORALL 'af (list 'FORALL 'xs (list 'FORALL 'ii (list 'FORALL 'xv
  (list 'IMPLIES '(IN xs SET) (list 'IMPLIES '(IN (CARD xs) NN) (list 'IMPLIES '(IN ii SET) (list 'IMPLIES '(IN (CARD ii) NN)
    (list 'IMPLIES '(IN xv SET) (list 'IMPLIES '(NOT (IN xv ii))
      (list '= (ie-sum 'xs 'af '(UNION ii (PAIR xv xv))) (list '- (ie-sum 'xs 'af 'ii) (ie-sum (ie-sub 'xs 'af 'xv) 'af 'ii)))))))))))))))
(dk-peel!)
(ie-ring!)
(let* ((pr '(PAIR xv xv)) (u (list 'UNION 'ii pr)) (xp (ie-sub 'xs 'af 'xv)) (p0 '(POWER ii)) (pu (list 'POWER u))
       (cag (list 'CARR ie-ag)))
  (ie-fin! xp 'xs)
  (dk-have! '(AND (IN xv SET) (IN xv SET))) (fact 'pairing 'xv 'xv)
  (dk-have! (list 'AND '(IN ii SET) (list 'IN pr 'SET))) (fact 'union-set-closure 'ii pr)
  (dk-apply! (dk-cite! 'card-insert-curried 'ii) 'xv)
  (dk-apply! (dk-cite! 'ord-succ-nn) '(CARD ii))
  (fact 'nn-succ-closed '(CARD ii))
  (dk-have! (list 'IN (list 'CARD u) 'NN)
    (lambda () (subst (list '= (list 'CARD u) (list 'succ_ord '(CARD ii)))) (subst (list '= (list 'succ_ord '(CARD ii)) '(succ (CARD ii)))) (ass)))
  (fact 'power-set 'ii) (fact 'power-set u)
  (dk-have! '(AND (IN ii SET) (IN (CARD ii) NN))) (fact 'card-power-nn 'ii)
  (dk-have! '(AND (IN xv SET) (NOT (IN xv ii))))
  (let* ((cov (dk-cite! 'power-insert-cover 'ii 'xv))
         (img (caddr (caddr cov)))
         (ph (cadr img))
         (un (list 'UNION p0 img)))
    (dk-cite! 'power-insert-disjoint 'ii 'xv)
    (dk-cite! 'power-insert-injective 'ii 'xv)
    (dk-have! (list 'AND (list 'IN ph (list 'INJECTION p0 pu)) (list 'AND (list 'IN p0 'SET) (list 'IN (list 'CARD p0) 'NN))))
    (fact 'card-image-injection p0 pu ph)
    (dk-have! (list 'IN (list 'CARD img) 'NN) (lambda () (subst (list '= (list 'CARD img) (list 'CARD p0))) (ass)))
    ;; IMG is a subset of POWER(u), so a set; every member of UNION(P0, IMG) is in POWER(u)
    (dk-have! (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ un) (list 'IN 'iew_ pu)))
      (lambda () (let ((z (dk-di-var!))) (dk-rewrite-h! (list 'IN z un) un pu) (ass))))
    (dk-have! (list 'SUBSET img pu)
      (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (ma-in-union-right! z p0 img) (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ un) (list 'IN 'iew_ pu)))) z) (ass))))
    (fact 'subclass-of-set-is-set img pu)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img) (list 'NOT (list 'IN 'z_ p0))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (di)
          (dk-have! (list 'IN z (list 'INTERSECTION p0 img)) (lambda () (ma-iff-back! (dk-cite! 'intersection-membership p0 img z))))
          (dk-rewrite-h! (list 'IN z (list 'INTERSECTION p0 img)) (list 'INTERSECTION p0 img) 'EMPTY-SET)
          (fact 'empty-set-has-no-members z)
          (ma-prop-with! (list (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET)))))))
    (let* ((fs (ie-lam 'xs 'af un))
           (val! (lambda (z dom lam)
                   ;; z in dom, dom inside POWER(u): (IN (lam z) (CARR AG))
                   (dk-have! (list 'IN (list lam z) cag)
                     (lambda ()
                       (subst (list '= cag 'CC))
                       (dk-lam-b!)
                       (ie-body-type! 'xs 'af z)
                       (ass))))))
      (subst cov)
      ;; the split
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list fs 'z_) cag)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ un) (list 'IN 'iew_ pu)))) z)
            (ie-power-parts! z u)
            (val! z un fs) (ass))))
      (let* ((esplit (dk-apply! (dk-cite! 'finsum-union-disjoint ie-ag) p0 img fs))
             (ap (list 'FINSUM ie-ag fs p0)) (bp (list 'FINSUM ie-ag fs img))
             (g0 (ie-lam 'xs 'af p0)) (g1 (ie-lam 'xs 'af img)) (g2 (ie-lam xp 'af p0))
             (s1 (list 'FINSUM ie-ag g0 p0)) (s2 (list 'FINSUM ie-ag g2 p0))
             (in-un! (lambda (z left?)
                       (if left? (ma-in-union-left! z p0 img) (ma-in-union-right! z p0 img))
                       (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ un) (list 'IN 'iew_ pu)))) z)
                       (ie-power-parts! z u)))
             (cong! (lambda (dom left? f g)
                      ;; FINSUM(f, dom) = FINSUM(g, dom), f = fs, g the same body on dom
                      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dom) (list '= (list f 'z) (list g 'z))))
                        (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*))) (in-un! z left?) (ie-body-type! 'xs 'af z) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
                      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dom) (list 'IN (list f 'z) cag)))
                        (lambda () (let ((z (dk-di-var!))) (in-un! z left?) (dk-apply! (dk-ctx-form (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list fs 'z_) cag)))) z) (ass))))
                      (dk-apply! (dk-cite! 'finsum-congruence ie-ag) dom f g))))
        (dk-have! (list 'AND (list 'IN p0 'SET) (list 'IN (list 'CARD p0) 'NN)))
        (cong! p0 #t fs g0)
        (cong! img #f fs g1)
        ;; reindex the image part by S |-> S u {j}
        (dk-have! (list 'IN g1 (list 'FUN img cag))
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((z (dk-di-var!))) (dk-have! (list 'IN z un) (lambda () (ma-in-union-right! z p0 img) (ass))) (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ un) (list 'IN 'iew_ pu)))) z) (ie-power-parts! z u) (subst (list '= cag 'CC)) (ie-body-type! 'xs 'af z) (ass)))
              (lambda () (ass)))))
        (let* ((bij (dk-apply! (dk-cite! 'injection-image-is-bijection) p0 pu ph))
               (phi (cadr bij))
               (er (begin (fact 'finsum-reindex-ag ie-ag img p0 phi g1)
                          (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list 'FINSUM ie-ag g1 img)))) (dk-asms))))
               (l3 (caddr (caddr er)))
               (h (list 'VNB-LAMBDA 'z p0 (list (list 'MUL ie-r) '(- 1) (list g2 'z))))
               (zfacts! (lambda (z)
                          ;; z in POWER(ii): land the facts on z u {j}; return (zs . int-equation)
                          (let ((zs (list 'UNION z pr)))
                            (ie-power-parts! z 'ii)
                            (dk-have! (list 'AND (list 'IN z 'SET) (list 'IN pr 'SET))) (fact 'union-set-closure z pr)
                            (dk-have! (list 'NOT (list 'IN 'xv z))
                              (lambda () (di) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ z) '(IN iez_ ii)))) 'xv)
                                         (ma-prop-with! (list '(IN xv ii) '(NOT (IN xv ii))))))
                            (dk-apply! (dk-cite! 'card-insert-curried z) 'xv)
                            (dk-apply! (dk-cite! 'ord-succ-nn) (list 'CARD z))
                            (fact 'nn-succ-closed (list 'CARD z))
                            (dk-have! (list 'IN (list 'CARD zs) 'NN)
                              (lambda () (subst (list '= (list 'CARD zs) (list 'succ_ord (list 'CARD z)))) (subst (list '= (list 'succ_ord (list 'CARD z)) (list 'succ (list 'CARD z)))) (ass)))
                            (let ((iff (dk-cite! 'image-membership-iff ph p0 zs)))
                              (dk-have! (caddr iff)
                                (lambda ()
                                  (dk-conj-close!
                                    (lambda ()
                                      (cond ((dk-ass!) #t)
                                            (#t (ew z) (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))))))
                              (ma-iff-back! iff))
                            (ma-in-singleton! 'xv) (ma-in-union-right! 'xv z pr)
                            (let ((ia (ie-int 'xs 'af zs)) (ib (ie-int xp 'af z)))
                              (ma-ext2! ia ib
                                (lambda (w)
                                  (ma-sep-parts! (list 'IN w ia))
                                  (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ zs) (list 'IN w '(af iek_))))) 'xv)
                                  (dk-have! (list 'IN w xp) (lambda () (in-sep! dk-ass! dk-ass!)))
                                  (in-sep! dk-ass!
                                    (lambda ()
                                      (let ((k (dk-di-var!)))
                                        (ma-in-union-left! k z pr)
                                        (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ zs) (list 'IN w '(af iek_))))) k)
                                        (ass)))))
                                (lambda (w)
                                  (ma-sep-parts! (list 'IN w ib))
                                  (ma-sep-parts! (list 'IN w xp))
                                  (in-sep! dk-ass!
                                    (lambda ()
                                      (let ((k (dk-di-var!)))
                                        (ie-or-split! k z pr
                                          (lambda () (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ z) (list 'IN w '(af iek_))))) k) (ass))
                                          (lambda () (ma-singleton-eq! k 'xv) (subst (list '= k 'xv)) (ass))))))))
                              (cons zs (list '= ia ib)))))))
          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z p0) (list 'IN (list l3 'z) cag)))
            (lambda ()
              (let* ((z (dk-di-var!)) (zz (zfacts! z)))
                (subst (list '= cag 'CC))
                (dk-lam-b!)
                (ie-body-type! 'xs 'af (car zz))
                (ass))))
          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z p0) (list '= (list l3 'z) (list h 'z))))
            (lambda ()
              (let* ((z (dk-di-var!)) (zz (zfacts! z)) (zs (car zz))
                     (b2 (ie-body xp 'af z)) (c (list 'CARD z)))
                (ie-body-type! xp 'af z)
                (dk-lam-b!)
                (ie-op-eq! 'MUL '(- 1) b2)
                (subst (list '= (list (list 'MUL ie-r) '(- 1) b2) (list '* '(- 1) b2)))
                (subst (list '= (list 'CARD zs) (list 'succ_ord c)))
                (subst (list '= (list 'succ_ord c) (list 'succ c)))
                (dk-have! (list 'AND '(IN (- 1) CC) (list 'IN c 'NN)))
                (fact 'power-succ '(- 1) c)
                (subst (list '= (list 'power '(- 1) (list 'succ c)) (list '* '(- 1) (list 'power '(- 1) c))))
                (subst (cdr zz))
                (crs))))
          (let ((ec (dk-apply! (dk-cite! 'finsum-congruence ie-ag) p0 l3 h)))
            (fact 'cc-scalar-ring-carr)
            (dk-have! (list 'IN g2 (list 'FUN p0 (list 'CARR ie-r)))
              (lambda ()
                (dk-lam-type!
                  (lambda () (let ((z (dk-di-var!))) (ie-power-parts! z 'ii) (subst (list '= (list 'CARR ie-r) 'CC)) (ie-body-type! xp 'af z) (ass)))
                  (lambda () (ass)))))
            (dk-have! (list 'IN '(- 1) (list 'CARR ie-r)) (lambda () (subst (list '= (list 'CARR ie-r) 'CC)) (ass)))
            (let ((ed (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen ie-r) '(- 1) p0 g2)))
              ;; the two sums are complex numbers
              (ma-for-each
                (lambda (pr2)
                  (let ((x (car pr2)) (g (cadr pr2)))
                    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z p0) (list 'IN (list g 'z) cag)))
                      (lambda () (let ((z (dk-di-var!))) (ie-power-parts! z 'ii) (subst (list '= cag 'CC)) (dk-lam-b!) (ie-body-type! x 'af z) (ass))))
                    (dk-apply! (dk-cite! 'finsum-type-ptwise ie-ag) p0 g)
                    (dk-have! (list 'IN (list 'FINSUM ie-ag g p0) 'CC) (lambda () (subst (list '= 'CC cag)) (ass)))))
                (list (list 'xs g0) (list xp g2)))
              (subst esplit)
              (subst (list '= ap s1))
              (subst (list '= bp (list 'FINSUM ie-ag g1 img)))
              (subst er)
              (subst ec)
              (subst (list '= (list 'FINSUM ie-ag h p0) (list (list 'MUL ie-r) '(- 1) s2)))
              (let* ((n1 (dk-name! s1 'CC)) (n2 (dk-name! s2 'CC)))
                (subst (list '= s1 n1)) (subst (list '= s2 n2))
                (subst (dk-cite! 'ras-op ie-r))
                (ie-op-eq! 'MUL '(- 1) n2)
                (subst (list '= (list (list 'MUL ie-r) '(- 1) n2) (list '* '(- 1) n2)))
                (cp-type!* (list '* '(- 1) n2))
                (ie-op-eq! 'ADD n1 (list '* '(- 1) n2))
                (subst (list '= (list (list 'ADD ie-r) n1 (list '* '(- 1) n2)) (list '+ n1 (list '* '(- 1) n2))))
                (crs)))))))))
(qed 'inclusion-exclusion-split-sum)

;;; PROP. 1.20 (inclusion-exclusion): card(X minus the union of the A_k, k in I) = sum over F subset I of
;;; (-1)^card(F) card(the intersection of the A_k, k in F), the intersection over F = {} being X
(sp (make-wff (list 'FORALL 'ii (list 'IMPLIES '(IN ii SET) (list 'IMPLIES '(IN (CARD ii) NN)
  (list 'FORALL 'af (list 'FORALL 'xs (list 'IMPLIES '(IN xs SET) (list 'IMPLIES '(IN (CARD xs) NN)
    (list '= (list 'CARD (ie-out 'xs 'af 'ii)) (ie-sum 'xs 'af 'ii)))))))))))
(dk-peel!)
(let* ((prop-of (lambda (s) (list 'FORALL 'iexs_ (list 'IMPLIES '(IN iexs_ SET) (list 'IMPLIES '(IN (CARD iexs_) NN)
                  (list '= (list 'CARD (ie-out 'iexs_ 'af s)) (ie-sum 'iexs_ 'af s)))))))
       (res (ma-induct! 'ii prop-of
              (lambda ()
                (let ((x (dk-di-var!)))
                  (dk-peel!)
                  (dk-apply! (dk-cite! 'inclusion-exclusion-base) 'af x)
                  (ass)))
              (lambda (sv xv u ih)
                
                (let ((x (dk-di-var!)))
                  
                  (dk-peel!)
                  (let ((xp (ie-sub x 'af xv)))
                    (ie-fin! xp x)
                    (let* ((e1 (dk-apply! (dk-ctx-form ih) x))
                           (e2 (dk-apply! (dk-ctx-form ih) xp))
                           (c1 (dk-apply! (dk-cite! 'inclusion-exclusion-split-card) 'af x sv xv))
                           (c2 (dk-apply! (dk-cite! 'inclusion-exclusion-split-sum) 'af x sv xv)))
                      
                      (subst c2)
                      (subst (list '= (ie-sum x 'af sv) (list 'CARD (ie-out x 'af sv))))
                      (subst (list '= (ie-sum xp 'af sv) (list 'CARD (ie-out xp 'af sv))))
                      (subst c1)
                      (let* ((o1 (ie-out x 'af u)) (o2 (ie-out xp 'af sv)))
                        (ie-fin! o1 x) (ie-fin! o2 xp)
                        (let ((k1 (dk-name! (list 'CARD o1) 'NN)) (k2 (dk-name! (list 'CARD o2) 'NN)))
                          (subst (list '= (list 'CARD o1) k1))
                          (subst (list '= (list 'CARD o2) k2))
                          (crs))))))))))
  (dk-apply! (dk-ctx-form res) 'xs)
  (ass))
(qed 'inclusion-exclusion)

;;; COR. 1.21: card(the union of the D_k, k in I) = sum over nonempty F subset I of
;;; (-1)^(card(F) - 1) card(the intersection of the D_k, k in F); the D_k taken inside a finite X
(define (ie-union x a i) (list 'SEP 'iex_ x (list 'FORSOME 'iek_ (list 'AND (list 'IN 'iek_ i) (list 'IN 'iex_ (list a 'iek_))))))
(define ie-e1 '(PAIR EMPTY-SET EMPTY-SET))
(define (ie-dom i) (list 'DIFFERENCE (list 'POWER i) ie-e1))
(define (ie-body1 x a f) (list '* (list 'power '(- 1) (list 'NN-MINUS (list 'CARD f) 1)) (list 'CARD (ie-int x a f))))
(sp (make-wff (list 'FORALL 'ii (list 'IMPLIES '(IN ii SET) (list 'IMPLIES '(IN (CARD ii) NN)
  (list 'FORALL 'af (list 'FORALL 'xs (list 'IMPLIES '(IN xs SET) (list 'IMPLIES '(IN (CARD xs) NN)
    (list '= (list 'CARD (ie-union 'xs 'af 'ii))
             (list 'FINSUM ie-ag (list 'VNB-LAMBDA 'ief_ (ie-dom 'ii) (ie-body1 'xs 'af 'ief_)) (ie-dom 'ii))))))))))))
(dk-peel!)
(ie-ring!)
(fact 'empty-set-is-set)
(let* ((un (ie-union 'xs 'af 'ii)) (o (ie-out 'xs 'af 'ii)) (p0 '(POWER ii)) (d (ie-dom 'ii))
       (cag (list 'CARR ie-ag)) (sp2 (list 'UNION ie-e1 d))
       (g (list 'VNB-LAMBDA 'ief_ d (ie-body1 'xs 'af 'ief_))))
  (ie-fin! un 'xs) (ie-fin! o 'xs)
  ;; X is the disjoint union of the union and the complement
  (ma-ext2! 'xs (list 'UNION un o)
    (lambda (w)
      (use-em (list 'FORSOME 'iek_ (list 'AND '(IN iek_ ii) (list 'IN w '(af iek_))))
        (lambda () (dk-have! (list 'IN w un) (lambda () (in-sep! dk-ass! dk-ass!))) (ma-in-union-left! w un o) (ass))
        (lambda ()
          (dk-have! (list 'IN w o)
            (lambda ()
              (in-sep! dk-ass!
                (lambda ()
                  (let ((k (dk-di-var!)))
                    (di)
                    (dk-have! (list 'FORSOME 'iek_ (list 'AND '(IN iek_ ii) (list 'IN w '(af iek_)))) (lambda () (ew k) (dk-conj-close! dk-ass!)))
                    (ma-prop-with! (list (list 'FORSOME 'iek_ (list 'AND '(IN iek_ ii) (list 'IN w '(af iek_)))) (list 'NOT (list 'FORSOME 'iek_ (list 'AND '(IN iek_ ii) (list 'IN w '(af iek_))))))))))))
          (ma-in-union-right! w un o) (ass))))
    (lambda (w)
      (ie-or-split! w un o
        (lambda () (ma-sep-parts! (list 'IN w un)) (ass))
        (lambda () (ma-sep-parts! (list 'IN w o)) (ass)))))
  (ma-ext2! (list 'INTERSECTION un o) 'EMPTY-SET
    (lambda (w)
      (ma-iff-parts! (dk-cite! 'intersection-membership un o w))
      (let ((k (dk-skolem! (ma-sep-parts! (list 'IN w un)))))
        (ma-sep-parts! (list 'IN w o))
        (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES '(IN iek_ ii) (list 'NOT (list 'IN w '(af iek_)))))) k)
        (ma-prop-with! (list (list 'IN w (list 'af k)) (list 'NOT (list 'IN w (list 'af k)))))))
    (lambda (w) (fact 'empty-set-has-no-members w) (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
  (dk-have! (list 'AND (list 'IN un 'SET) (list 'IN (list 'CARD un) 'NN)))
  (dk-have! (list 'AND (list 'IN o 'SET) (list 'AND (list 'IN (list 'CARD o) 'NN) (list '= (list 'INTERSECTION un o) 'EMPTY-SET))))
  (fact 'card-union-disjoint un o)
  (let ((ex (dk-rewrite-h! (list '= (list 'CARD (list 'UNION un o)) (list '+ (list 'CARD un) (list 'CARD o))) (list 'UNION un o) 'xs))
        (eo (dk-apply! (dk-cite! 'inclusion-exclusion) 'ii 'af 'xs)))
    ;; POWER(I) = {{}} u (POWER(I) minus {{}})
    (fact 'power-set 'ii)
    (dk-have! '(AND (IN ii SET) (IN (CARD ii) NN))) (fact 'card-power-nn 'ii)
    (fact 'power-empty-in 'ii)
    (ma-in-singleton! 'EMPTY-SET)
    (ma-ext2! p0 sp2
      (lambda (w)
        (use-em (list '= w 'EMPTY-SET)
          (lambda () (subst (list '= w 'EMPTY-SET)) (ma-in-union-left! 'EMPTY-SET ie-e1 d) (ass))
          (lambda ()
            (dk-have! (list 'NOT (list 'IN w ie-e1)) (lambda () (di) (ma-singleton-eq! w 'EMPTY-SET) (ma-prop-with! (list (list '= w 'EMPTY-SET) (list 'NOT (list '= w 'EMPTY-SET))))))
            (dk-have! (list 'IN w d) (lambda () (ma-iff-back! (dk-cite! 'difference-membership p0 ie-e1 w))))
            (ma-in-union-right! w ie-e1 d) (ass))))
      (lambda (w)
        (ie-or-split! w ie-e1 d
          (lambda () (ma-singleton-eq! w 'EMPTY-SET) (subst (list '= w 'EMPTY-SET)) (ass))
          (lambda () (ma-iff-parts! (dk-cite! 'difference-membership p0 ie-e1 w)) (ass)))))
    (dk-have! (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ sp2) (list 'IN 'iew_ p0)))
      (lambda () (let ((z (dk-di-var!))) (dk-rewrite-h! (list 'IN z sp2) sp2 p0) (ass))))
    (ma-for-each
      (lambda (sub)
        (dk-have! (list 'SUBSET sub p0)
          (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (if (equal? sub ie-e1) (ma-in-union-left! z ie-e1 d) (ma-in-union-right! z ie-e1 d))
                                                                 (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ sp2) (list 'IN 'iew_ p0)))) z) (ass))))
        (ie-finite-sub! sub p0))
      (list ie-e1 d))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ d) (list 'NOT (list 'IN 'z_ ie-e1))))
      (lambda () (let ((z (dk-di-var!))) (ma-iff-parts! (dk-cite! 'difference-membership p0 ie-e1 z)) (ass))))
    (let* ((fs (ie-lam 'xs 'af sp2))
           (h (list 'VNB-LAMBDA 'z d (list (list 'MUL ie-r) '(- 1) (list g 'z))))
           (sg (list 'FINSUM ie-ag g d))
           (nz! (lambda (z k)
                  ;; z in D: z is a finite set, card z = succ q; run (k q)
                  (ma-iff-parts! (dk-cite! 'difference-membership p0 ie-e1 z))
                  (ie-power-parts! z 'ii)
                  (dk-have! (list 'NOT (list '= (list 'CARD z) 0))
                    (lambda ()
                      (di)
                      (dk-apply! (dk-cite! 'card-zero-is-empty) z)
                      (dk-rewrite-h! (list 'NOT (list 'IN z ie-e1)) z 'EMPTY-SET)
                      (ma-prop-with! (list (list 'IN 'EMPTY-SET ie-e1) (list 'NOT (list 'IN 'EMPTY-SET ie-e1))))))
                  (ma-or-split! (dk-cite! 'nn-zero-or-succ (list 'CARD z))
                    (list (lambda () (ma-prop-with! (list (list '= (list 'CARD z) 0) (list 'NOT (list '= (list 'CARD z) 0)))))
                          (lambda ()
                            (k (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f (list 'CARD z)))) (dk-asms)))))))))
           (b1type! (lambda (z)
                      (fact 'nn-minus-in-nn (list 'CARD z) 1)
                      (ie-body-type! 'xs 'af z)
                      (cp-type!* (list 'power '(- 1) (list 'NN-MINUS (list 'CARD z) 1)))
                      (cp-type!* (ie-body1 'xs 'af z)))))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sp2) (list 'IN (list fs 'z_) cag)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-apply! (dk-ctx-form (list 'FORALL 'iew_ (list 'IMPLIES (list 'IN 'iew_ sp2) (list 'IN 'iew_ p0)))) z)
            (ie-power-parts! z 'ii)
            (subst (list '= cag 'CC)) (dk-lam-b!) (ie-body-type! 'xs 'af z) (ass))))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z d) (list 'IN (list fs 'z) cag)))
        (lambda () (let ((z (dk-di-var!))) (ma-in-union-right! z ie-e1 d) (dk-apply! (dk-ctx-form (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sp2) (list 'IN (list fs 'z_) cag)))) z) (ass))))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z d) (list '= (list fs 'z) (list h 'z))))
        (lambda ()
          (let ((z (dk-di-var!)))
            (ma-in-union-right! z ie-e1 d)
            (nz! z
              (lambda (q)
                
                (let ((b1 (ie-body1 'xs 'af z)) (c (list 'CARD z)))
                  (b1type! z)
                  
                  (dk-lam-b!)
                  
                  (ie-op-eq! 'MUL '(- 1) b1)
                  (subst (list '= (list (list 'MUL ie-r) '(- 1) b1) (list '* '(- 1) b1)))
                  (subst (list '= c (list 'succ q)))
                  (dk-apply! (dk-cite! 'nn-minus-succ-1) q)
                  (subst (list '= (list 'NN-MINUS (list 'succ q) 1) q))
                  (dk-have! (list 'AND '(IN (- 1) CC) (list 'IN q 'NN)))
                  (fact 'power-succ '(- 1) q)
                  (subst (list '= (list 'power '(- 1) (list 'succ q)) (list '* '(- 1) (list 'power '(- 1) q))))
                  (let ((kc (dk-name! (list 'CARD (ie-int 'xs 'af z)) 'NN)))
                    (subst (list '= (list 'CARD (ie-int 'xs 'af z)) kc))
                    (cp-type!* (list 'power '(- 1) q))
                    (let ((pq (dk-name! (list 'power '(- 1) q) 'CC)))
                      (subst (list '= (list 'power '(- 1) q) pq))
                      (crs)))))))))
      (fact 'cc-scalar-ring-carr)
      (dk-have! (list 'IN g (list 'FUN d (list 'CARR ie-r)))
        (lambda ()
          (dk-lam-type!
            (lambda () (let ((z (dk-di-var!))) (ma-iff-parts! (dk-cite! 'difference-membership p0 ie-e1 z)) (ie-power-parts! z 'ii) (b1type! z) (subst (list '= (list 'CARR ie-r) 'CC)) (ass)))
            (lambda () (ass)))))
      (dk-have! (list 'IN '(- 1) (list 'CARR ie-r)) (lambda () (subst (list '= (list 'CARR ie-r) 'CC)) (ass)))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z d) (list 'IN (list g 'z) cag)))
        (lambda () (let ((z (dk-di-var!))) (ma-iff-parts! (dk-cite! 'difference-membership p0 ie-e1 z)) (ie-power-parts! z 'ii) (b1type! z) (subst (list '= cag 'CC)) (dk-lam-b!) (ass))))
      (dk-apply! (dk-cite! 'finsum-type-ptwise ie-ag) d g)
      (dk-have! (list 'IN sg 'CC) (lambda () (subst (list '= 'CC cag)) (ass)))
      (let* ((ec (dk-apply! (dk-cite! 'finsum-congruence ie-ag) d fs h))
             (ed (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen ie-r) '(- 1) d g)))
        (ie-op-eq! 'MUL '(- 1) sg)
        ;; the empty-set term is card X
        (let ((ix (ie-int 'xs 'af 'EMPTY-SET)))
          (ma-ext2! ix 'xs
            (lambda (w) (ma-sep-parts! (list 'IN w ix)) (ass))
            (lambda (w) (in-sep! dk-ass! (lambda () (let ((k (dk-di-var!))) (fact 'empty-set-has-no-members k) (ma-prop-with! (list (list 'IN k 'EMPTY-SET) (list 'NOT (list 'IN k 'EMPTY-SET)))))))))
          (fact 'card-empty) (fact 'power-zero '(- 1))
          (ma-in-union-left! 'EMPTY-SET ie-e1 d)
          (dk-apply! (dk-ctx-form (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sp2) (list 'IN (list fs 'z_) cag)))) 'EMPTY-SET)
          (dk-apply! (dk-cite! 'finsum-singleton-ptwise ie-ag) 'EMPTY-SET fs)
          (cp-type!* '(CARD xs))
          (dk-have! (list '= (list fs 'EMPTY-SET) '(CARD xs))
            (lambda () (dk-lam-b!) (subst '(= (CARD EMPTY-SET) 0)) (subst '(= (power (- 1) 0) 1)) (subst (list '= ix 'xs)) (crs))))
        (cp-type!* (list '* '(- 1) sg))
        ;; card OUT = card X - S
        (let ((ks (dk-name! sg 'CC)))
          (ie-op-eq! 'MUL '(- 1) ks)
          (cp-type!* (list '* '(- 1) ks))
          (ie-op-eq! 'ADD '(CARD xs) (list '* '(- 1) ks))
          (dk-have! (list '= (list 'CARD o) (list '+ '(CARD xs) (list '* '(- 1) ks)))
            (lambda ()
              (subst eo)
              (subst (list '= p0 sp2))
              (let ((es (dk-apply! (dk-cite! 'finsum-union-disjoint ie-ag) ie-e1 d fs)))
                (subst es)
                (subst (list '= (list 'FINSUM ie-ag fs ie-e1) (list fs 'EMPTY-SET)))
                (subst (list '= (list fs 'EMPTY-SET) '(CARD xs)))
                (subst ec)
                (subst (list '= (list 'FINSUM ie-ag h d) (list (list 'MUL ie-r) '(- 1) sg)))
                (subst (list '= sg ks))
                (subst (list '= (list (list 'MUL ie-r) '(- 1) ks) (list '* '(- 1) ks)))
                (subst (dk-cite! 'ras-op ie-r))
                (subst (list '= (list (list 'ADD ie-r) '(CARD xs) (list '* '(- 1) ks)) (list '+ '(CARD xs) (list '* '(- 1) ks))))
                (ie-rfl!))))
          ;; card U = card X - card OUT = S
          (let* ((ku (dk-name! (list 'CARD un) 'NN)) (ko (dk-name! (list 'CARD o) 'NN))
                 (id (list '= ku (list '- (list '+ ku ko) ko))))
            (subst (list '= (list 'CARD un) ku))
            (subst (list '= sg ks))
            (dk-rewrite-h! (dk-rewrite-h! ex (list 'CARD un) ku) (list 'CARD o) ko)
            (dk-rewrite-h! (list '= (list 'CARD o) (list '+ '(CARD xs) (list '* '(- 1) ks))) (list 'CARD o) ko)
            (dk-have! id (lambda () (crs)))
            (subst id)
            (subst (list '= (list '+ ku ko) '(CARD xs)))
            (subst (list '= ko (list '+ '(CARD xs) (list '* '(- 1) ks))))
            (crs)))))))
