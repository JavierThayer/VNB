;;; ---- (4) K-linearity on the module view is CC-linearity on the algebra ---------------------
(sp (bsn-st (list 'FORALL 'bsf (list 'IMPLIES (list 'IS-K-LINEAR bsn-uam 'bsf) '(IS-CC-LINEAR-ON a bsf)))))
(dk-peel!)
(bsn-ro!)
(dk-cite! 'bal-uba-scal-pin 'a)
(dk-cite! 'rb3-c-carr-uba-as-module 'a)
(let* ((h (dk-landed-1 (lambda () (mac-h 'is-k-linear (list 'IS-K-LINEAR bsn-uam 'bsf)))))
       (parts (map bsn-ro-h! (dk-split-all! (list h))))
       (hadd (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (bsn-occurs? '(VADD a) f))) parts)))
       (hhom (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (bsn-occurs? '(ACT a) f))) parts))))
  (mac 'is-cc-linear-on)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-peel!))
                 (ins (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) landed))
                 (zs (filter (lambda (f) (eq? (caddr f) 'CC)) ins)))
            (if (null? zs)
                (let* ((app (cadr (cadr (dk-goal)))) (x1 (cadr app)) (x2 (caddr app))
                       (f1 (list 'bsf x1)) (f2 (list 'bsf x2)))
                  (dk-apply! hadd x1 x2)
                  (bsn-cc! f1) (bsn-cc! f2)
                  (dk-cite! 'rb3-c-add-eq-uba-as-module 'a f1 f2)
                  (subst (list '= (list '+ f1 f2) (list '(ADD (SCAL a)) f1 f2)))
                  (dk-ass!))
                (let* ((app (cadr (cadr (dk-goal)))) (z (cadr app)) (x1 (caddr app))
                       (f1 (list 'bsf x1)))
                  (dk-apply! hhom z x1)
                  (bsn-cc! f1)
                  (dk-cite! 'rb3-c-mul-eq-uba-as-module 'a z f1)
                  (subst (list '= (list '* z f1) (list '(MUL (SCAL a)) z f1)))
                  (dk-ass!))))))))
(bsn-qed! 'bsn-klin)

;;; ---- (5) the norming functional of a unital Banach algebra ---------------------------------
(sp (bsn-st '(FORALL bsy (IMPLIES (IN bsy (VEC a))
  (FORSOME bsf_ (AND (IS-CC-LINEAR-ON a bsf_)
    (AND (FORALL bsv_ (IMPLIES (IN bsv_ (VEC a)) (<= (MAGNITUDE (bsf_ bsv_)) ((VNRM a) bsv_))))
         (= (bsf_ bsy) ((VNRM a) bsy)))))))))
(dk-peel!)
(bsn-ro!)
(dk-cite! 'uba-norm-seminorm 'a)
(dk-rewrite-h! '(IN bsy (VEC a)) '(VEC a) (list 'VEC bsn-uam))
(let* ((f (dk-skolem! (dk-cite! 'cc-norming-functional bsn-uam '(VNRM a) 'bsy)))
       (hb (bsn-find (lambda (h) (and (pair? h) (eq? (car h) 'FORALL) (bsn-occurs? f h) (bsn-occurs? 'MAGNITUDE h))))))
  (dk-cite! 'bsn-klin 'a f)
  (bsn-ro-h! hb)
  (ew f)
  (dk-conj-close! (lambda () (dk-ass!))))
(bsn-qed! 'uba-norming-functional)

;;; ---- (6) the bridge: psi of the resolvent is holomorphic where every shift is invertible ---
(define (bsn-F z) (list 'INVERSE-EL 'a (list 'SHIFT-EL 'a z 'x)))
(define bsn-G (list 'VNB-LAMBDA 'bsw_ 'bsu (list 'bsf (bsn-F 'bsw_))))
(define bsn-Hb '(FORALL bsv_ (IMPLIES (IN bsv_ (VEC a)) (<= (MAGNITUDE (bsf bsv_)) ((VNRM a) bsv_)))))
(define bsn-Hinv '(FORALL bsz_ (IMPLIES (IN bsz_ bsu) (IS-INVERTIBLE-EL a (SHIFT-EL a bsz_ x)))))
(define (bsn-inv-at! z)
  (if (not (dk-asm? (list 'IN z 'CC))) (dk-cite! 'subset-mem-fwd 'bsu 'CC z))
  (if (not (dk-asm? (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a z 'x)))) (dk-apply! bsn-Hinv z))
  (bsn-vt (bsn-F z)))

(define (bsn-eps-point! u eps d hd)
  (let* ((landed (dk-peel!))
         (y (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'bsu))) landed))))
         (hlt (car (filter (lambda (f) (and (pair? f) (eq? (car f) '<))) landed)))
         (fu (bsn-F u)) (fy (bsn-F y))
         (ww (list '(VMUL a) fu fu)) (pw (list 'bsf ww))
         (c (list '+ u (list '- y)))
         (yu (list '+ y (list '- u)))
         (m (list 'MAGNITUDE yu))
         (v1 (list '(VADD a) fy (list '(VNEG a) fu)))
         (cw (list '(ACT a) c ww))
         (v2 (list '(VNEG a) cw))
         (ev (list '(VADD a) v1 v2))
         (py (list 'bsf fy)) (pu (list 'bsf fu))
         (sv (list '+ (list '+ py (list '- pu)) (list '- (list '* c pw)))))
    (dk-cite! 'subset-mem-fwd 'bsu 'CC y)
    (bsn-inv-at! y) (bsn-cc! py) (bsn-cc! pu) (bsn-vt ww) (bsn-cc! pw)
    (bsn-cc! (list '- py pu))
    (dk-lam-b!)
    (bsn-mac-fix! 'binary-minus-def)
    (dk-cite! 'binary-minus-def y u)
    (dk-rewrite-h! hlt (list '- y u) yu)
    (bsn-rr! m)
    (dk-cite! 'rr-pos-rr-in-rr d)
    (dk-cite! 'rr-lt-implies-le m d)
    (dk-split! (dk-apply! hd y))
    (bsn-inv-at! y)
    (bsn-cc! c) (bsn-vt ev)
    (bsn-cc! py) (bsn-cc! pu) (bsn-cc! pw)
    (dk-apply! bsn-Hb ev)
    (let ((pe (list 'MAGNITUDE (list 'bsf ev))) (ne (list '(VNRM a) ev)) (em (list '* eps m)))
      (bsn-rr! pe) (bsn-rr! ne) (dk-cite! 'rr-pos-rr-in-rr eps) (bsn-rr! em)
      (dk-le-chain! pe ne em))
    (dk-cite! 'bsn-cl-add 'a 'bsf v1 v2)
    (dk-cite! 'bsn-cl-add 'a 'bsf fy (list '(VNEG a) fu))
    (dk-cite! 'bsn-psi-neg 'a 'bsf fu)
    (dk-cite! 'bsn-psi-neg 'a 'bsf cw)
    (dk-cite! 'bsn-cl-act 'a 'bsf c ww)
    (dk-have! (list '= (list 'bsf ev) sv)
      (lambda ()
        (subst (list '= (list 'bsf ev) (list '+ (list 'bsf v1) (list 'bsf v2))))
        (subst (list '= (list 'bsf v1) (list '+ py (list 'bsf (list '(VNEG a) fu)))))
        (subst (list '= (list 'bsf (list '(VNEG a) fu)) (list '- pu)))
        (subst (list '= (list 'bsf v2) (list '- (list 'bsf cw))))
        (subst (list '= (list 'bsf cw) (list '* c pw)))
        (rfl)))
    (let* ((g (dk-goal)) (tv (cadr (cadr g))))
      (dk-have! (list '= tv sv) (lambda () (crs)))
      (subst (list '= tv sv))
      (subst (list '= sv (list 'bsf ev)))
      (dk-ass!))))

(define (bsn-eps-lane! u)
  (let* ((landed (dk-peel!))
         (eps (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'POS-RR))) landed))))
         (d (dk-skolem! (dk-cite! 'resolvent-derivative 'a 'x u eps)))
         (hd (bsn-find (lambda (h) (and (pair? h) (eq? (car h) 'FORALL) (bsn-occurs? d h)
                                        (bsn-occurs? 'IS-INVERTIBLE-EL h))))))
    (ew d)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (bsn-eps-point! u eps d hd))))))

(define (bsn-diff-at! u)
  (let* ((fu (bsn-F u)) (ww (list '(VMUL a) fu fu)) (pw (list 'bsf ww)) (lv (list '- pw)))
    (bsn-inv-at! u)
    (bsn-vt ww)
    (bsn-cc! lv)
    (ew lv)
    (let ((ch (dk-cite! 'cc-diff-on-of-eps-bound 'bsu bsn-G u lv)))
      (detach-with! ch (lambda () (bsn-eps-lane! u)))
      (dk-ass!))))

(sp (bsn-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'bsf (list 'IMPLIES '(IS-CC-LINEAR-ON a bsf) (list 'IMPLIES bsn-Hb
    (list 'FORALL 'bsu (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) bsu)
      (list 'IMPLIES bsn-Hinv (list 'HOLOMORPHIC-ON 'bsu bsn-G)))))))))))
(dk-peel!)
(dk-cite! 'bal-uba-scal-pin 'a)
(dk-cite! 'bsn-cl-fun 'a 'bsf)
(dk-cite! 'cc-open-subset-cc 'bsu)
(dk-cite! 'cc-is-set)
(dk-cite! 'subclass-of-set-is-set 'bsu 'CC)
(dk-have! (list 'IN bsn-G '(FUN bsu CC))
  (lambda ()
    (dk-lam-type!
      (lambda () (let ((w (dk-di-var!))) (bsn-inv-at! w) (bsn-cc! (list 'bsf (bsn-F w))) (dk-ass!)))
      (lambda () (dk-ass!)))))
(mac 'holomorphic-on)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (bsn-diff-at! (dk-di-var!)))))
(bsn-qed! 'resolvent-functional-holomorphic)

;;; ---- (7) no spectrum: every shift is invertible; CC is open --------------------------------
(sp (bsn-st '(FORALL x (IMPLIES (IN x (VEC a)) (IMPLIES (NOT (FORSOME bsq_ (IN bsq_ (SPECTRUM a x))))
     (FORALL z (IMPLIES (IN z CC) (IS-INVERTIBLE-EL a (SHIFT-EL a z x)))))))))
(dk-peel!)
(let ((g (dk-goal)))
  (use-em g
    (lambda () (dk-ass!))
    (lambda ()
      (fact 'bas-spectrum-unfold 'a 'x)
      (dk-have! '(FORSOME bsq_ (IN bsq_ (SPECTRUM a x)))
        (lambda ()
          (ew 'z)
          (subst '(= (SPECTRUM a x) (SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x))))))
          (in-sep! (lambda () (dk-ass!)))))
      (ai '(NOT (FORSOME bsq_ (IN bsq_ (SPECTRUM a x))))))))
(bsn-qed! 'bsn-no-spectrum)

(sp (make-wff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) CC)))
(mac 'cc-ms-open-iff)
(dk-cite! 'cc-is-metric-space)
(dk-cite! 'carrier-is-open 'CC-MS)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (dk-close-if! (lambda () (slot 'PTS)) qrfl)))
(dk-rewrite-h! '(IS-OPEN CC-MS (PTS CC-MS)) '(PTS CC-MS) 'CC)
(dk-ass!)
(bsn-qed! 'cc-plane-open)

;;; ---- (8) THEOREM 1.9: the spectrum of every element is nonempty -----------------------------
(define (bsn-in-ball! z rn prove-le!)       ; land (IN z (CLOSED-BALL CC-MS 0 rn))
  (bsn-cc! z)
  (dk-have! (list '<= (list 'MAGNITUDE (list '- z 0)) rn)
    (lambda ()
      (bsn-mac-fix! 'binary-minus-def)
      (let ((zz (list '+ z '(- 0))))
        (dk-have! (list '= zz z) (lambda () (crs)))
        (subst (list '= zz z)))
      (prove-le!)))
  (bsn-cite! 'cc-closed-ball-mem-intro 0 rn z))

(define (bsn-main!)
  (let* ((hinv (dk-cite! 'bsn-no-spectrum 'a 'x))
         (y0 (bsn-F 0))
         (ny (list '(VNRM a) y0))
         (nx '((VNRM a) x)))
    (dk-cite! 'bal-uba-scal-pin 'a)
    (dk-cite! 'cc-is-set)
    (dk-cite! 'cc-zero-in)
    (dk-apply! hinv 0)
    (bsn-vt y0)
    (dk-cite! 'ban-inverse-norm-pos 'a '(SHIFT-EL a 0 x))
    (bsn-rr! ny) (bsn-rr! nx)
    (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
    (let* ((f (dk-skolem! (dk-cite! 'uba-norming-functional 'a y0)))
           (hb (bsn-find (lambda (h) (and (pair? h) (eq? (car h) 'FORALL) (bsn-occurs? f h) (bsn-occurs? 'MAGNITUDE h)))))
           (hh (list 'VNB-LAMBDA 'bsw_ 'CC (list f (bsn-F 'bsw_))))
           (rterm (list '+ (list '* 2 nx) 1)))
      (dk-cite! 'bsn-cl-fun 'a f)
      (dk-cite! 'cc-plane-open)
      (dk-cite! 'resolvent-functional-holomorphic 'a 'x f 'CC)
      (dk-cite! 'holomorphic-on-continuous 'CC hh)
      (dk-cite! 'holomorphic-on-in-fun 'CC hh)
      (dk-cite! 'subset-refl 'CC)
      (bsn-rr! rterm)
      (let* ((rn (dk-name! rterm))
             (kk (list 'CLOSED-BALL 'CC-MS 0 rn))
             (rfacts (list (list '= rn rterm) (list '<= 0 nx) (bsn-in-rr nx) (bsn-in-rr rn))))
        (dk-have! (list 'SUBSET kk 'CC)
          (lambda ()
            (let ((z (subset-by-element!)))
              (dk-split! (dk-cite! 'cc-closed-ball-origin rn z))
              (dk-ass!))))
        (dk-cite! 'cc-closed-ball-compact 0 rn)
        (bsn-in-ball! 0 rn
          (lambda ()
            (dk-cite! 'cc-magnitude-zero)
            (subst '(= (MAGNITUDE 0) 0))
            (apply dk-ineq! rfacts)))
        (let* ((p (dk-skolem! (bsn-cite! 'cc-compact-modulus-max 'CC hh kk 0)))
               (hmax (bsn-find (lambda (h) (and (pair? h) (eq? (car h) 'FORALL) (bsn-occurs? p h) (bsn-occurs? kk h)))))
               (hp (list hh p))
               (hpm (list 'MAGNITUDE hp)))
          (dk-split! (dk-cite! 'cc-closed-ball-origin rn p))
          (bsn-rr! hpm)
          (dk-cite! 'cc-magnitude-nonneg hp)
          (bsn-rr! (list '+ 2 hpm))
          (let* ((bd (dk-name! (list '+ 2 hpm)))
                 (bfacts (list (list '= bd (list '+ 2 hpm)) (list '<= 0 hpm) (bsn-in-rr hpm) (bsn-in-rr bd)))
                 (bclaim (list 'FORALL 'bsc_ (list 'IMPLIES '(IN bsc_ CC)
                                                   (list '<= (list 'MAGNITUDE (list hh 'bsc_)) bd)))))
            ;; h is bounded by bd
            (dk-have! bclaim
              (lambda ()
                (let* ((w (dk-di-var!)) (hw (list hh w)) (mw (list 'MAGNITUDE w)) (hwm (list 'MAGNITUDE hw)))
                  (bsn-rr! mw) (bsn-rr! hwm)
                  (bsn-cite! 'rr-leq-total mw rn)
                  (use-cases (list (list '<= mw rn) (list '<= rn mw))
                    (lambda ()
                      (bsn-in-ball! w rn (lambda () (dk-ass!)))
                      (dk-apply! hmax w)
                      (apply dk-ineq! (append (list (list '<= hwm hpm) (bsn-in-rr hwm)) bfacts)))
                    (lambda ()
                      (let ((ofacts (append (list (list '<= rn mw) (bsn-in-rr mw)) rfacts)))
                        (dk-have! (list '< 0 mw) (lambda () (apply dk-ineq! ofacts)))
                        (dk-have! (list '<= (list '* 2 nx) mw) (lambda () (apply dk-ineq! ofacts)))
                        (dk-have! (list '<= 1 mw) (lambda () (apply dk-ineq! ofacts))))
                      (dk-split! (dk-cite! 'resolvent-norm-bound 'a 'x w))
                      (dk-cite! 'rr-pos-ne-zero mw)
                      (bsn-cite! 'rr-recip-closed mw)
                      (let* ((r (dk-name! (list 'recip mw)))
                             (fw (bsn-F w)) (pfw (list 'MAGNITUDE (list f fw))) (nfw (list '(VNRM a) fw))
                             (h1 (dk-rewrite-h! (bsn-cite! 'rr-recip-inverse mw) (list 'recip mw) r))
                             (h2 (dk-rewrite-h! (list '<= nfw (list '* 2 (list 'recip mw))) (list 'recip mw) r))
                             (h3 (dk-rewrite-h! (dk-cite! 'rr-recip-pos mw) (list 'recip mw) r)))
                        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! h3 (bsn-in-rr r))))
                        (dk-cite! 'rr-one-in)
                        (let ((h4 (dk-rewrite-h! (dk-cite! 'rr-mul-le-right 1 mw r) (list '* mw r) 1)))
                          (dk-lam-b!)
                          (bsn-vt fw)
                          (dk-apply! hb fw)
                          (bsn-rr! pfw) (bsn-rr! nfw)
                          (apply dk-ineq! (append (list (list '<= pfw nfw) h2 h4 (bsn-in-rr r) (bsn-in-rr pfw) (bsn-in-rr nfw)) bfacts)))))))))
            ;; Liouville: h is constant, h(z) = h(0) = ||y0||
            (let ((lv (dk-cite! 'liouville hh bd)))
              (dk-cite! 'rr-pos-ne-zero ny)
              (bsn-cite! 'rr-recip-closed ny)
              (let* ((rn0 (dk-name! (list 'recip ny)))
                     (p5 (dk-rewrite-h! (bsn-cite! 'rr-recip-inverse ny) (list 'recip ny) rn0))
                     (p8 (dk-rewrite-h! (dk-cite! 'rr-recip-pos ny) (list 'recip ny) rn0))
                     (w0t (list '+ rn (list '* 2 rn0))))
                (bsn-rr! w0t)
                (let* ((w0 (dk-name! w0t))
                       (m0 (list 'MAGNITUDE w0))
                       (wfacts (append (list (list '= w0 w0t) p8 (bsn-in-rr rn0) (bsn-in-rr w0)) rfacts)))
                  (dk-cite! 'rr-subset-cc w0)
                  (dk-have! (list '<= 0 w0) (lambda () (apply dk-ineq! wfacts)))
                  (dk-cite! 'rr-magnitude-is-abs w0)
                  (dk-cite! 'rr-abs-of-nonneg w0)
                  (dk-cite! 'eq-trans m0 (list 'ABS w0) w0)
                  (bsn-rr! m0)
                  (let ((mfacts (append (list (list '= m0 w0) (bsn-in-rr m0)) wfacts)))
                    (dk-have! (list '< 0 m0) (lambda () (apply dk-ineq! mfacts)))
                    (dk-have! (list '<= 0 m0) (lambda () (apply dk-ineq! mfacts)))
                    (dk-have! (list '<= (list '* 2 nx) m0) (lambda () (apply dk-ineq! mfacts))))
                  (dk-split! (dk-cite! 'resolvent-norm-bound 'a 'x w0))
                  (dk-cite! 'rr-pos-ne-zero m0)
                  (bsn-cite! 'rr-recip-closed m0)
                  (let* ((s (dk-name! (list 'recip m0)))
                         (fw0 (bsn-F w0)) (pf0 (list f fw0)) (nf0 (list '(VNRM a) fw0))
                         (h3 (dk-rewrite-h! (bsn-cite! 'rr-recip-inverse m0) (list 'recip m0) s))
                         (hb3 (dk-rewrite-h! (list '<= nf0 (list '* 2 (list 'recip m0))) (list 'recip m0) s))
                         (lw0 (dk-apply! lv w0)))
                    (dk-lam-b-h! lw0)
                    (if (not (dk-asm? (list '= pf0 (list f y0))))
                        (error "bsn-main!: the beta-reduced Liouville instance did not land"))
                    (bsn-vt fw0)
                    (bsn-cc! pf0) (bsn-cc! (list f y0))
                    (dk-have! (list '<= 0 ny) (lambda () (dk-ineq! (list '< 0 ny) (bsn-in-rr ny))))
                    (dk-have! (list '= (list 'MAGNITUDE pf0) ny)
                      (lambda ()
                        (subst (list '= pf0 (list f y0)))
                        (subst (list '= (list f y0) ny))
                        (dk-cite! 'rr-magnitude-is-abs ny)
                        (subst (list '= (list 'MAGNITUDE ny) (list 'ABS ny)))
                        (dk-cite! 'rr-abs-of-nonneg ny)
                        (subst (list '= (list 'ABS ny) ny))
                        (rfl)))
                    (dk-apply! hb fw0)
                    (bsn-rr! (list 'MAGNITUDE pf0)) (bsn-rr! nf0) (bsn-rr! (list '* 2 s))
                    (dk-have! (list '<= ny (list '* 2 s))
                      (lambda () (dk-ineq! (list '= (list 'MAGNITUDE pf0) ny) (list '<= (list 'MAGNITUDE pf0) nf0) hb3
                                           (bsn-in-rr (list 'MAGNITUDE pf0)) (bsn-in-rr nf0) (bsn-in-rr s) (bsn-in-rr ny))))
                    (let* ((p1 (dk-cite! 'rr-mul-le-right ny (list '* 2 s) m0))
                           (big (list '* (list '* 2 s) m0)))
                      (dk-have! (list '= big 2)
                        (lambda ()
                          (dk-have! (list '= big (list '* 2 (list '* m0 s))) (lambda () (crs)))
                          (subst (list '= big (list '* 2 (list '* m0 s))))
                          (subst (list '= (list '* m0 s) 1))
                          (crs)))
                      (let* ((p1b (dk-rewrite-h! p1 big 2))
                             (p4 (list '= (list '* ny m0) (list '+ (list '* rn ny) (list '* 2 (list '* ny rn0))))))
                        (dk-have! p4
                          (lambda ()
                            (subst (list '= m0 w0))
                            (subst (list '= w0 w0t))
                            (crs)))
                        (dk-have! (list '<= 1 rn) (lambda () (apply dk-ineq! rfacts)))
                        (dk-cite! 'rr-one-in)
                        (let* ((p6 (dk-cite! 'rr-mul-le-right 1 rn ny))
                               (p4b (dk-rewrite-h! p4 (list '* ny rn0) 1))
                               (p1c (dk-rewrite-h! p1b (list '* ny m0) (caddr p4b)))
                               (q (begin (bsn-rr! (list '* rn ny)) (dk-name! (list '* rn ny))))
                               (p1d (dk-rewrite-h! p1c (list '* rn ny) q))
                               (p6b (dk-rewrite-h! p6 (list '* rn ny) q)))
                          (dk-absurd! p1d p6b (list '< 0 ny) (bsn-in-rr ny) (bsn-in-rr q)))))))))))))))

(sp (bsn-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORSOME bsq_ (IN bsq_ (SPECTRUM a x)))))))
(dk-peel!)
(let ((g (dk-goal)))
  (use-em g (lambda () (dk-ass!)) (lambda () (bsn-main!))))
(bsn-qed! 'spectrum-nonempty)

;;; ---- (9) THEOREM 1.10 (Gelfand-Mazur), unconditionally --------------------------------------
(sp (bsn-st '(IMPLIES (FORALL y (IMPLIES (IN y (VEC a)) (IMPLIES (NOT (= y (VZERO a))) (IS-INVERTIBLE-EL a y))))
  (FORALL x (IMPLIES (IN x (VEC a)) (FORSOME z (AND (IN z CC) (= x ((ACT a) z (VONE a))))))))))
(di)
(let loop () (if (eq? (car (dk-goal)) 'IMPLIES) (begin (di) (loop))))
(dk-cite! 'spectrum-nonempty 'a)
(dk-cite! 'gelfand-mazur-from-nonempty-spectrum 'a)
(dk-ass!)
(bsn-qed! 'gelfand-mazur)
