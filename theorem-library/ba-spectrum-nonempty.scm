       (e2 (dk-rewrite-h! e1 '((ACT a) 1 bsw) 'bsw))
       (e3 (dk-rewrite-h! e2 '((NEG (SCAL a)) 1) '(- 1))))
  (subst '(= ((VNEG a) bsw) ((ACT a) (- 1) bsw)))
  (dk-cite! 'cc-neg-closed 1)
  (dk-cite! 'bsn-cl-act 'a 'bsf '(- 1) 'bsw)
