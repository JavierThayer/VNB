;;; ba-spectrum-nonempty.scm -- THE SPECTRUM IS NONEMPTY (BanachAlgebras.pdf, Theorem 1.9) and
;;; GELFAND-MAZUR (Theorem 1.10) unconditionally.
;;; Agent BA-1D, wave 2026-11-09.  Destination: theorem-library/ba-spectrum-nonempty.scm.
;;; Library: operator-algebras.  All proofs modulo 0.
;;;
;;; THE ROUTE (the notes' proof): suppose sigma(x) is empty, so every z.1 - x is invertible.
;;; Take y = (0.1 - x)^{-1}, which is nonzero, and a complex-linear psi with |psi| <= ||.|| and
;;; psi(y) = ||y|| (the complex norming functional, cc-norming-functional.scm, read through the
;;; module view of the algebra).  h(z) = psi((z.1 - x)^{-1}) is holomorphic on CC: its
;;; difference quotient is controlled by `resolvent-derivative' (ba-resolvent.scm) through the
;;; linearity and boundedness of psi, and `cc-diff-on-of-eps-bound' turns that control into
;;; IS-DIFF-ON.  h is bounded: on the closed disc of radius R = 2||x|| + 1 by the maximum of |h|
;;; on a compact set (cc-compact-modulus-max), outside it by `resolvent-norm-bound'
;;; (|h(z)| <= 2/|z| <= 2).  Liouville makes h constant, h(z) = h(0) = ||y|| > 0, and at a real
;;; point z0 = R + 2/||y|| the bound |h(z0)| <= 2/z0 gives ||y|| z0 <= 2 < ||y|| z0.
;;;
;;; THE BRIDGE THEOREM `resolvent-functional-holomorphic' is stated for any open U on which every
;;; shift is invertible (the resolvent set is the case of interest); the main theorem uses U = CC.
;;;
;;; LOAD WINDOW: after theorem-library/ch3a-schwarz (load.scm 4098: cc-compact-modulus-max) and
;;; cauchy-estimates (4054: liouville); after BA-1B's ba-resolvent.scm (resolvent-derivative,
;;; resolvent-norm-bound) and ba-gelfand-mazur.scm (gelfand-mazur-from-nonempty-spectrum); after
;;; cc-norming-functional.scm (this wave).  Helper prefix: bsn-.

(define (bsn-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-spectrum-nonempty: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display "      asm: ") (display (expression->string h)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-spectrum-nonempty: unfinished" name))))

(define (bsn-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bsn-occurs? x t)
  (or (equal? x t) (and (pair? t) (or (bsn-occurs? x (car t)) (bsn-occurs? x (cdr t))))))
(define (bsn-find pred)
  (let ((hs (filter pred (dk-asms))))
    (if (null? hs) (error "bsn-find: no such hypothesis") (car hs))))
(define (bsn-mac-fix! n)
  (let loop ((k 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (mac n)))
      (if (and (< k 6) (not (equal? g (dk-goal)))) (loop (+ k 1))))))

;;; dk-cite!, then every remaining antecedent detached: from context, else proved on a lane by
;;; closing its conjuncts from context
(define (bsn-cite! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES) (= (length r) 3))
        (let ((ante (cadr r)) (conseq (caddr r)))
          (if (dk-asm? ante)
              (begin (detach! r)
                     (loop (or (dk-ctx-form conseq) (error "bsn-cite!: detach landed nothing" conseq))))
              (loop (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))
        r)))

;;; ---- typings, by citation -----------------------------------------------------------------
(define (bsn-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VONE a)) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x '(VZERO a)) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bsn-vt (cadr x)) (bsn-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bsn-vt (cadr x)) (bsn-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bsn-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bsn-cc! (cadr x)) (bsn-vt (caddr x))
           (dk-cite! 'bal-uba-scal-pin 'a)
           (dk-cite! 'rb3-c-act-in-uba-as-module 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'SHIFT-EL))
           (bsn-cc! (caddr x)) (bsn-vt (cadddr x))
           (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          (#t (error "bsn-vt: cannot type" (expression->string x))))))

(define (bsn-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bsn-cc! (cadr t)) (bsn-cc! (caddr t)) (bsn-cite! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bsn-cc! (cadr t)) (bsn-cc! (caddr t)) (bsn-cite! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bsn-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 3))
         (let ((pl (list '+ (cadr t) (list '- (caddr t)))))
           (bsn-cc! pl)
           (dk-cite! 'binary-minus-def (cadr t) (caddr t))
           (dk-have! (list 'IN t 'CC) (lambda () (subst (list '= t pl)) (dk-ass!)))
           t))
        ((equal? t 0) (dk-cite! 'cc-zero-in) t)
        ((equal? t 1) (dk-cite! 'cc-one-in) t)
        ((dk-asm? (list 'IN t 'RR)) (dk-cite! 'rr-subset-cc t) t)
        ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN (VEC a) CC))))
         (bsn-vt (cadr t)) (dk-cite! 'fun-apply-type-c (car t) '(VEC a) 'CC (cadr t)) t)
        ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN CC CC))))
         (bsn-cc! (cadr t)) (dk-cite! 'fun-apply-type-c (car t) 'CC 'CC (cadr t)) t)
        (#t (error "bsn-cc!: cannot type" (expression->string t)))))

(define (bsn-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((equal? t 0) (dk-cite! 'rr-zero-in) t)
        ((equal? t 1) (dk-cite! 'rr-one-in) t)
        ((number? t) (dk-have! (list 'IN t 'RR) (lambda () (arith))) t)
        ((and (pair? t) (eq? (car t) 'MAGNITUDE))
         (bsn-cc! (cadr t)) (dk-cite! 'cc-magnitude-closed (cadr t)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (bsn-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bsn-rr! (cadr t)) (bsn-rr! (caddr t)) (bsn-cite! 'rr-add-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bsn-rr! (cadr t)) (bsn-rr! (caddr t)) (bsn-cite! 'rr-mul-in-rr (cadr t) (caddr t)) t)
        (#t (error "bsn-rr!: cannot type" (expression->string t)))))
(define (bsn-in-rr t) (bsn-rr! t) (list 'IN t 'RR))

;;; ---- (1) the module view of the algebra, read back onto the algebra ----------------------
(define (bsn-readoff! name acc)
  (sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a)
                  (list '== (list acc '(UBA-AS-MODULE a)) (list acc 'a))))))
  (dk-peel!)
  (mac 'UBA-AS-MODULE)
  (slot acc)
  (let loop ((n 0))
    (if (and (< n 8) (not (proof-done? *ps*)))
        (let ((g (dk-goal)))
          (quietly (lambda () (nth-r)))
          (if (equal? g (dk-goal)) (quietly (lambda () (slot acc))))
          (if (not (equal? g (dk-goal))) (loop (+ n 1))))))
  (if (not (proof-done? *ps*)) (qrfl))
  (bsn-qed! name))
(define bsn-ro-names '((VEC . bsn-uam-vec) (VADD . bsn-uam-vadd) (ACT . bsn-uam-act) (SCAL . bsn-uam-scal)))
(for-each (lambda (p) (bsn-readoff! (cdr p) (car p))) bsn-ro-names)
(define (bsn-ro!) (for-each (lambda (p) (dk-cite! (cdr p) 'a)) bsn-ro-names))
(define bsn-uam '(UBA-AS-MODULE a))

;;; rewrite a hypothesis from the view's accessors to the algebra's, and CARR(SCAL a) to CC
(define (bsn-ro-h! f)
  (let loop ((f f)
             (rs (append (map (lambda (p) (cons (list (car p) bsn-uam) (list (car p) 'a))) bsn-ro-names)
                         (list (cons '(CARR (SCAL a)) 'CC)))))
    (cond ((null? rs) f)
          ((bsn-occurs? (caar rs) f) (loop (dk-rewrite-h! f (caar rs) (cdar rs)) (cdr rs)))
          (#t (loop f (cdr rs))))))

;;; ---- (2) the norm of a unital Banach algebra is a seminorm on its module view -------------
(sp (bsn-st (list 'IS-SEMINORM 'CC-NORMED-FIELD bsn-uam '(VNRM a))))
(dk-peel!)
(bsn-ro!)
(mac 'is-seminorm)
(for-each (lambda (p) (subst (list '= (list (car p) bsn-uam) (list (car p) 'a)))) bsn-ro-names)
(dk-cite! 'bal-uba-scal-pin 'a)
(dk-cite! 'uba-as-module-is-module 'a)
(dk-cite! 'bal-uba-vnrm-fun 'a)
(dk-cite! 'bal-uba-vnrm-nonneg 'a)
(dk-cite! 'bal-uba-vnrm-triangle 'a)
(dk-cite! 'cc-is-normed-field)
(dk-cite! 'rb3-c-carr-uba-as-module 'a)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((landed (dk-peel!))
               (l (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) '(CARR (SCAL a))))) landed))))
               (v (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) '(VEC a)))) landed)))))
          (dk-cite! 'bal-uba-vnrm-homog 'a l v)
          (dk-rewrite-h! (list 'IN l '(CARR (SCAL a))) '(CARR (SCAL a)) 'CC)
          (dk-cite! 'cc-nf-fnrm-apply l)
          (subst (list '= (list '(FNRM CC-NORMED-FIELD) l) (list 'MAGNITUDE l)))
          (dk-ass!)))))
(bsn-qed! 'uba-norm-seminorm)

;;; ---- (3) the three projections of IS-CC-LINEAR-ON -------------------------------------------
(define (bsn-cl-open!)
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-cc-linear-on '(IS-CC-LINEAR-ON a bsf)))))))
(sp (bsn-st '(FORALL bsf (IMPLIES (IS-CC-LINEAR-ON a bsf) (IN bsf (FUN (VEC a) CC))))))
(dk-peel!)
(bsn-cl-open!)
(dk-ass!)
(bsn-qed! 'bsn-cl-fun)

(sp (bsn-st '(FORALL bsf (IMPLIES (IS-CC-LINEAR-ON a bsf)
  (FORALL bsx (IMPLIES (IN bsx (VEC a)) (FORALL bsy (IMPLIES (IN bsy (VEC a))
    (= (bsf ((VADD a) bsx bsy)) (+ (bsf bsx) (bsf bsy)))))))))))
(dk-peel!)
(let ((parts (bsn-cl-open!)))
  (dk-apply! (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (bsn-occurs? '(VADD a) f))) parts))
             'bsx 'bsy)
  (dk-ass!))
(bsn-qed! 'bsn-cl-add)

(sp (bsn-st '(FORALL bsf (IMPLIES (IS-CC-LINEAR-ON a bsf)
  (FORALL bsz (IMPLIES (IN bsz CC) (FORALL bsx (IMPLIES (IN bsx (VEC a))
    (= (bsf ((ACT a) bsz bsx)) (* bsz (bsf bsx)))))))))))
(dk-peel!)
(let ((parts (bsn-cl-open!)))
  (dk-apply! (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (bsn-occurs? '(ACT a) f))) parts))
             'bsz 'bsx)
  (dk-ass!))
(bsn-qed! 'bsn-cl-act)

;;; psi(-w) = -psi(w)
(sp (bsn-st '(FORALL bsf (IMPLIES (IS-CC-LINEAR-ON a bsf)
  (FORALL bsw (IMPLIES (IN bsw (VEC a)) (= (bsf ((VNEG a) bsw)) (- (bsf bsw)))))))))
(dk-peel!)
(dk-cite! 'bal-uba-scal-pin 'a)
(dk-cite! 'cc-one-in)
(dk-cite! 'rb3-c-in-carr-uba-as-module 'a 1)
(dk-cite! 'bas-act-one 'a 'bsw)
