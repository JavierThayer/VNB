;;; ccr4c-subnf.scm -- THE RESTRICTION SUB-NF(K, S) OF A NORMED FIELD K TO A SUBFIELD S IS A NORMED FIELD, an NV
;;; field when K is one, and its metric space is the subspace S of K (CCR-1109-C3 finding F2).  Agent CCR-1109-C4,
;;; 2026-11-09.  Destination: theorem-library/ccr4c-subnf.scm.  Library: analysis.  Helper prefix sn-.
;;;
;;;   sub-nf-add-val, -mul-val, -neg-val, -fnrm-val   the restricted operations at points of S
;;;   sub-nf-add-fun, -mul-fun, -neg-fun, -fnrm-fun   their typings on S
;;;   sub-nf-carr, -add, -mul, -neg, -zero, -one, -fnrm   the slots of SUB-NF(K, S)
;;;   sub-nf-is-normed-field     IS-NORMED-FIELD K, IS-NF-SUBFIELD(K, S) => IS-NORMED-FIELD(SUB-NF K S)
;;;   sub-nf-is-nv-field         IS-NV-FIELD K, IS-NF-SUBFIELD(K, S) => IS-NV-FIELD(SUB-NF K S)
;;;   nf-metric-space-unfold     the unfold of NF-METRIC-SPACE, as a theorem
;;;   sub-nf-metric              NF-METRIC-SPACE(SUB-NF K S) == SUBSPACE-MS(NF-METRIC-SPACE K, S)
;;;   sub-nf-integers            NV-INTEGERS(SUB-NF K S) = NV-INTEGERS(K) n S
;;;   nf-subfield-ring-power     x in S => x^n in S (n in NN, the power of the ring view)
;;;   nf-subfield-small          w in S with 0 < |w| < 1 => S has non-zero elements of arbitrarily small |.|
;;;   nf-subfield-zz-act-one     n.1 in S (n in NN, the multiple of the additive group of the ring view)
;;;
;;; Load window: after structure-library/ccr4c-subnf-vocab and ccr4b-vocab (IS-NF-SUBFIELD); theorem-library/
;;; rake-nf-norm (nf-norm-*), ccr2-nv (nv-ultra, nv-field-normed), views (normed-field-ring-view-*), nf-zero-ne-one,
;;; ring-power laws, and ccr4c-finite-char (zz-act-one-zero, zz-act-one-succ).

(define sn-r '(SUB-NF K S))
(define sn-ladd '(VNB-LAMBDA (LIST snu_ snv_) (CARTESIAN S S) ((ADD K) snu_ snv_)))
(define sn-lmul '(VNB-LAMBDA (LIST snu_ snv_) (CARTESIAN S S) ((MUL K) snu_ snv_)))
(define sn-lneg '(VNB-LAMBDA snu_ S ((NEG K) snu_)))
(define sn-lnrm '(VNB-LAMBDA snu_ S ((FNRM K) snu_)))
(define (sn-thm body) `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) ,body)))))
(define (sn-or-asm f thunk) (if (not (dk-asm? f)) (thunk)) f)
(define (sn-and-list f) (if (and (pair? f) (eq? (car f) 'AND)) (cons (cadr f) (sn-and-list (caddr f))) (list f)))
(define sn-conjs '())
;; IS-NORMED-FIELD K, IS-NF-SUBFIELD K S in context: open the subfield conjuncts, land S subset CARR K, S in SET
(define (sn-setup!)
  (let* ((iff (dk-cite! 'is-nf-subfield 'K 'S)) (rhs (caddr iff)))
    (set! sn-conjs (sn-and-list rhs))
    (if (not (dk-asm? (car sn-conjs)))
        (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) rhs)) (dk-split-all! (list rhs)))))
  (sn-or-asm '(IN (CARR K) SET) (lambda () (dk-project! '(IN (CARR K) SET) 'is-normed-field '(IS-NORMED-FIELD K))))
  (sn-or-asm '(SUBSET S (CARR K)) (lambda () (dk-have! '(SUBSET S (CARR K)) (lambda () (mac 'subset-def) (dk-close-if-asm!)))))
  (sn-or-asm '(IN S SET) (lambda () (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set 'S '(CARR K))))))
;; U in S: land U in CARR K
(define (sn-in! u)
  (sn-or-asm `(IN ,u (CARR K)) (lambda () (dk-chain-ass! (dk-apply! (list-ref sn-conjs 0) u))))
  u)
;; U, V in S: land (OP K) U V in S (and in CARR K); OP one of ADD MUL NEG
(define (sn-close! op u v)
  (let ((t (if v `((,op K) ,u ,v) `((,op K) ,u)))
        (law (list-ref sn-conjs (cdr (assq op '((ADD . 3) (MUL . 4) (NEG . 5)))))))
    (sn-or-asm `(IN ,t S) (lambda () (dk-chain-ass! (if v (dk-apply! law u v) (dk-apply! law u)))))
    (sn-in! t)
    t))
(define (sn-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))

;;; ---------------------------------------------------------------------------
;;; the restricted operations: values and typings
(define (sn-val! name lam args val)
  (dk-sp-qed! (make-wff (sn-thm
     (let wrap ((as args))
        (if (null? as) `(= (,lam ,@args) ,val)
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) S) ,(wrap (cdr as))))))))
  (lambda ()
    (dk-peel!)
    (sn-setup!)
    (for-each sn-in! args)
    (if (eq? lam sn-lnrm) (dk-cite! 'nf-norm-in-rr 'K (car args)))
    (dk-lam-b!)
    (sn-rfl!))
  name))
(sn-val! 'sub-nf-add-val sn-ladd '(u v) '((ADD K) u v))
(sn-val! 'sub-nf-mul-val sn-lmul '(u v) '((MUL K) u v))
(sn-val! 'sub-nf-neg-val sn-lneg '(u) '((NEG K) u))
(sn-val! 'sub-nf-fnrm-val sn-lnrm '(u) '((FNRM K) u))

(define (sn-fun! name lam arity op)
  (dk-sp-qed! (make-wff (sn-thm `(IN ,lam (FUN ,(if (= arity 2) '(CARTESIAN S S) 'S) ,(if (eq? op 'FNRM) 'RR 'S)))))
  (lambda ()
    (dk-peel!)
    (sn-setup!)
    (dk-each-leaf! (lambda () (lam-t))
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
              (cond ((= arity 2) (sn-close! op (car vs) (cadr vs)))
                    ((eq? op 'FNRM) (sn-in! (car vs)) (dk-cite! 'nf-norm-in-rr 'K (car vs)))
                    (#t (sn-close! 'NEG (car vs) #f)))
              (dk-close-if-asm!))
            (if (equal? (dk-goal) '(IN S SET))
                (dk-close-if-asm!)
                (begin (dk-have-and! '(IN S SET) '(IN S SET)) (mac 'cartesian-set-iff) (dk-close-if-asm!)))))))
  name))
(sn-fun! 'sub-nf-add-fun sn-ladd 2 'ADD)
(sn-fun! 'sub-nf-mul-fun sn-lmul 2 'MUL)
(sn-fun! 'sub-nf-neg-fun sn-lneg 1 'NEG)
(sn-fun! 'sub-nf-fnrm-fun sn-lnrm 1 'FNRM)

;;; ---------------------------------------------------------------------------
;;; the slots of SUB-NF(K, S)
(define (sn-nth-residues e)
  (let ((found '()))
    (let walk ((t e))
      (if (pair? t)
          (begin
            (if (and (eq? (car t) 'NTH) (= (length t) 3)
                     (not (and (pair? (caddr t)) (eq? (car (caddr t)) 'LIST))))
                (if (not (member t found)) (set! found (cons t found))))
            (for-each walk (cdr t))
            (if (pair? (car t)) (walk (car t))))))
    (reverse found)))
(define (sn-read-back! acc)
  (for-each (lambda (r)
              (let ((src (list acc (caddr r))))
                (have! (list '== r src) (lambda () (slot acc) (qrfl)))
                (subst (list '== r src))))
            (sn-nth-residues (dk-goal))))
(define sn-funs '(sub-nf-add-fun sub-nf-mul-fun sub-nf-neg-fun sub-nf-fnrm-fun))
(define (sn-read-off! name acc val)
  (dk-sp-qed! (make-wff (sn-thm `(== (,acc ,sn-r) ,val)))
  (lambda ()
    (dk-peel!)
    (sn-setup!)
    (for-each (lambda (n) (dk-cite! n 'K 'S)) sn-funs)
    (slot acc)
    (mac 'SUB-NF)
    (nth-r)
    (sn-read-back! acc)
    (qrfl))
  name))
(sn-read-off! 'sub-nf-carr 'CARR 'S)
(sn-read-off! 'sub-nf-add 'ADD sn-ladd)
(sn-read-off! 'sub-nf-mul 'MUL sn-lmul)
(sn-read-off! 'sub-nf-neg 'NEG sn-lneg)
(sn-read-off! 'sub-nf-zero 'ZERO '(ZERO K))
(sn-read-off! 'sub-nf-one 'ONE '(ONE K))
(sn-read-off! 'sub-nf-fnrm 'FNRM sn-lnrm)
(define sn-readoffs (list (list 'CARR 'S) (list 'ADD sn-ladd) (list 'MUL sn-lmul) (list 'NEG sn-lneg)
                          (list 'ZERO '(ZERO K)) (list 'ONE '(ONE K)) (list 'FNRM sn-lnrm)))
(define sn-readoff-names '(sub-nf-carr sub-nf-add sub-nf-mul sub-nf-neg sub-nf-zero sub-nf-one sub-nf-fnrm))

;;; ---------------------------------------------------------------------------
;;; evaluation of the restricted operations in the goal, innermost first
(define sn-lams (list (cons sn-ladd 'ADD) (cons sn-lmul 'MUL) (cons sn-lneg 'NEG) (cons sn-lnrm 'FNRM)))
(define (sn-has-lam? t) (and (pair? t) (or (assoc (car t) sn-lams) (any-pred sn-has-lam? (cdr t)))))
;; an innermost redex: head one of the lambdas, no lambda redex among its arguments
(define (sn-redex t)
  (if (not (pair? t)) #f
      (or (let loop ((xs (cdr t))) (cond ((null? xs) #f) ((sn-redex (car xs)) => (lambda (r) r)) (#t (loop (cdr xs)))))
          (and (pair? (car t)) (not (assoc (car t) sn-lams)) (sn-redex (car t)))
          (and (assoc (car t) sn-lams) t))))
(define (sn-eval-goal!)
  (let loop ((fuel 40))
    (let ((r (sn-redex (dk-goal))))
      (if r
          (let* ((op (cdr (assoc (car r) sn-lams)))
                 (args (cdr r))
                 (name (cdr (assq op '((ADD . sub-nf-add-val) (MUL . sub-nf-mul-val) (NEG . sub-nf-neg-val) (FNRM . sub-nf-fnrm-val)))))
                 (e (apply dk-cite! name 'K 'S args)))
            (if (= fuel 0) (error "sn-eval-goal!: no fixpoint" (expression->string (dk-goal))))
            (for-each sn-in! args)
            (cond ((memq op '(ADD MUL)) (sn-close! op (car args) (cadr args)))
                  ((eq? op 'NEG) (sn-close! 'NEG (car args) #f))
                  (#t (dk-cite! 'nf-norm-in-rr 'K (car args))))
            (subst e)
            (loop (- fuel 1)))))))

;; commutative-ring identities in K, through the ring view
(define sn-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (sn-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (sn-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,sn-view))))
      (dk-have! `(IN ,x (CARR ,sn-view)) (lambda () (subst `(= (CARR ,sn-view) (CARR K))) (dk-ass!)))))
(define (sn-crs! vs)
  (sn-view!)
  (for-each sn-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,sn-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,sn-view))))) '(ZERO ONE))
  (crs))
(define (sn-atoms t)
  (cond ((symbol? t) (list t)) ((pair? t) (delete-duplicates (append-map sn-atoms (cdr t)))) (#t '())))
(define (sn-law-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (sn-law-leaf!)))) (dk-opened (lambda () (di)))))
          ((memq (dk-head g) '(FORALL IMPLIES)) (dk-peel!) (sn-law-leaf!))
          ((dk-head-is? g '=)
           (sn-eval-goal!)
           (sn-crs! (filter (lambda (v) (dk-asm? `(IN ,v S))) (sn-atoms (dk-goal)))))
          (#t (error "sn-law-leaf!: unexpected" (expression->string g))))))
;; the conjuncts of is-norm, after the unfold
(define (sn-norm-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (sn-norm-leaf!)))) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'FORALL) (dk-peel!) (sn-norm-leaf!))
          (#t
           (sn-eval-goal!)
           (let ((g (dk-goal)))
             (cond ((dk-asm? g) (dk-ass!))
                   ((and (dk-head-is? g '<=) (eqv? (cadr g) 0)) (dk-cite! 'nf-norm-nonneg 'K (cadr (caddr g))) (dk-close-if-asm!))
                   ((dk-head-is? g 'IFF) (dk-cite! 'nf-norm-zero-iff 'K (cadr (cadr (cadr g)))) (dk-close-if-asm!))
                   ((dk-head-is? g '=)
                    (let ((p (cadr (cadr g)))) (dk-cite! 'nf-norm-mult 'K (cadr p) (caddr p)) (dk-close-if-asm!)))
                   ((dk-head-is? g '<=)
                    (let ((p (cadr (cadr g)))) (dk-cite! 'nf-norm-subadd 'K (cadr p) (caddr p)) (dk-close-if-asm!)))
                   (#t (error "sn-norm-leaf!: unexpected" (expression->string g)))))))))
;; the inverse law: forall a_ in S. a_ /= 0 => exists b_ in S. b_ /= 0 and a_ b_ = 1
(define (sn-inverse-leaf!)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-peel!))
    (sn-in! a)
    (let* ((b (dk-skolem! (dk-chain-ass! (dk-apply! (list-ref sn-conjs 6) a)) #t))
           (ab `((MUL K) ,a ,b)))
      (sn-in! b)
      (sn-close! 'MUL a b)
      (dk-cite! 'nf-zero-ne-one 'K)
      (ew b)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'NOT)
               (di)
               (let* ((e1 (dk-rewrite-h! `(= ,ab (ONE K)) b '(ZERO K)))
                      (_ (dk-have! `(= ((MUL K) ,a (ZERO K)) (ZERO K)) (lambda () (sn-crs! (list a)))))
                      (e2 (dk-rewrite-h! e1 `((MUL K) ,a (ZERO K)) '(ZERO K))))
                 (ai '(NOT (= (ZERO K) (ONE K))))))
              (#t (sn-eval-goal!) (dk-close-if-asm!)))))))))

;;; ---------------------------------------------------------------------------
;;; THE THEOREM: SUB-NF(K, S) is a normed field
(define (sn-struct-setup!)
  (for-each (lambda (n) (dk-cite! n 'K 'S)) sn-funs)
  (for-each (lambda (l) (dk-chain-ass! (dk-cite! 'membership-implies-sethood l
                                                 (if (eq? l sn-lnrm) '(FUN S RR) (if (eq? l sn-lneg) '(FUN S S) '(FUN (CARTESIAN S S) S))))))
            (list sn-ladd sn-lmul sn-lneg sn-lnrm))
  (dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K)
  (dk-cite! 'membership-implies-sethood '(ZERO K) '(CARR K)) (dk-cite! 'membership-implies-sethood '(ONE K) '(CARR K)))

(sp (make-wff (sn-thm `(IS-NORMED-FIELD ,sn-r))))
(dk-peel!)
(sn-setup!)
(sn-struct-setup!)
(mac 'IS-NORMED-FIELD)
(dk-isx-set!)
(for-each (lambda (n) (dk-cite! n 'K 'S)) sn-readoff-names)
(for-each (lambda (r) (if (dk-contains? (dk-goal) (list (car r) sn-r)) (subst `(== (,(car r) ,sn-r) ,(cadr r))))) sn-readoffs)
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "sn: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (dk-ass!))
                  ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'SUB-NF) (len-r) (arith))
                  ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses is-distributive))
                   (mac (dk-head g)) (sn-law-leaf!))
                  ((dk-head-is? g 'is-norm) (mac 'is-norm) (sn-norm-leaf!))
                  ((dk-head-is? g 'NOT) (dk-cite! 'nf-zero-ne-one 'K) (dk-close-if-asm!))
                  ((dk-head-is? g 'FORALL) (sn-inverse-leaf!))
                  (#t (error "sn normed field: unexpected conjunct" (expression->string g))))))))
  (dk-open-leaves))
(qed 'sub-nf-is-normed-field)

;;; ---------------------------------------------------------------------------
;;; ... an NV field when K is one
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) (IS-NV-FIELD ,sn-r)))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
(sn-setup!)
(dk-chain-ass! (dk-cite! 'sub-nf-is-normed-field 'K 'S))
(for-each (lambda (n) (dk-cite! n 'K 'S)) sn-readoff-names)
(mac 'IS-NV-FIELD)
(for-each (lambda (r) (if (dk-contains? (dk-goal) (list (car r) sn-r)) (subst `(== (,(car r) ,sn-r) ,(cadr r))))) sn-readoffs)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'S))) landed))))
          (sn-eval-goal!)
          (for-each sn-in! vs)
          (dk-cite! 'nv-ultra 'K (car vs) (cadr vs))
          (dk-close-if-asm!)))))
(qed 'sub-nf-is-nv-field)

;;; ---------------------------------------------------------------------------
;;; the metric space of SUB-NF(K, S) is the subspace S of the metric space of K
(sp (make-wff '(FORALL nf (== (NF-METRIC-SPACE nf)
   (LIST (CARR nf) (VNB-LAMBDA (LIST snx_ sny_) (CARTESIAN (CARR nf) (CARR nf)) ((FNRM nf) ((ADD nf) snx_ ((NEG nf) sny_)))))))))
(dk-peel!) (mac 'NF-METRIC-SPACE) (qrfl)
(qed 'nf-metric-space-unfold)

(define sn-ms '(NF-METRIC-SPACE K))
(define sn-lamL `(VNB-LAMBDA (LIST snx_ sny_) (CARTESIAN S S) (,sn-lnrm (,sn-ladd snx_ (,sn-lneg sny_)))))
(define sn-lamR `(VNB-LAMBDA (LIST sbu_ sbv_) (CARTESIAN S S) ((DIST ,sn-ms) sbu_ sbv_)))
;; a pointwise typing of a two-place lambda over S x S into RR, by lam-t; EVAL! closes the value
(define (sn-lam2-type! lam eval!)
  (dk-have! `(IN ,lam (FUN (CARTESIAN S S) RR))
    (lambda ()
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
                (for-each sn-in! vs)
                (eval! (car vs) (cadr vs))
                (dk-close-if-asm!))
              (begin (dk-have-and! '(IN S SET) '(IN S SET)) (mac 'cartesian-set-iff) (dk-close-if-asm!))))))))
;; the K-distance value at points U, V of S, typed
(define (sn-kdist! u v)
  (dk-cite! 'nf-neg-in-carr 'K v)
  (dk-cite! 'nf-add-in-carr 'K u `((NEG K) ,v))
  (dk-cite! 'nf-norm-in-rr 'K `((ADD K) ,u ((NEG K) ,v))))

(sp (make-wff (sn-thm `(== (NF-METRIC-SPACE ,sn-r) (SUBSPACE-MS ,sn-ms S)))))
(dk-peel!)
(sn-setup!)
(dk-chain-ass! (dk-cite! 'sub-nf-is-normed-field 'K 'S))
(for-each (lambda (n) (dk-cite! n 'K 'S)) sn-readoff-names)
(subst (dk-cite! 'nf-metric-space-unfold sn-r))
(mac 'SUBSPACE-MS)
(for-each (lambda (r) (if (dk-contains? (dk-goal) (list (car r) sn-r)) (subst `(== (,(car r) ,sn-r) ,(cadr r))))) sn-readoffs)
(sn-lam2-type! sn-lamL
  (lambda (u v) (sn-close! 'NEG v #f)
    (dk-cite! 'sub-nf-neg-val 'K 'S v) (dk-cite! 'sub-nf-add-val 'K 'S u `((NEG K) ,v))
    (sn-close! 'ADD u `((NEG K) ,v))
    (dk-cite! 'sub-nf-fnrm-val 'K 'S `((ADD K) ,u ((NEG K) ,v)))
    (sn-kdist! u v)
    (dk-lam-b!)
    (dk-close-if-asm!)))
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(sn-lam2-type! sn-lamR
  (lambda (u v)
    (sn-kdist! u v)
    (dk-cite! 'nf-metric-distance 'K u v)
    (subst `(= ((DIST ,sn-ms) ,u ,v) ((FNRM K) ((ADD K) ,u ((NEG K) ,v)))))
    (dk-close-if-asm!)))
(dk-fun-ext! sn-lamL sn-lamR '(CARTESIAN S S) 'RR (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))
  (lambda (w)
    (dk-split-all! (list (dk-cite! 'cartesian-nth w 'S 'S)))
    (let* ((v1 (dk-name! `(NTH 1 ,w) 'S)) (v2 (dk-name! `(NTH 2 ,w) 'S))
           (pe (dk-cite! 'cartesian-pair-eq w 'S 'S))
           (pe1 (dk-rewrite-h! pe `(NTH 1 ,w) v1))
           (pe2 (dk-rewrite-h! pe1 `(NTH 2 ,w) v2)))
      (sn-in! v1) (sn-in! v2)
      (subst `(= ,w (LIST ,v1 ,v2)))
      (dk-cite! 'apply-tupling-2 sn-lamL v1 v2) (dk-cite! 'apply-tupling-2 sn-lamR v1 v2)
      (subst `(== (,sn-lamL (LIST ,v1 ,v2)) (,sn-lamL ,v1 ,v2)))
      (subst `(== (,sn-lamR (LIST ,v1 ,v2)) (,sn-lamR ,v1 ,v2)))
      (sn-close! 'NEG v2 #f) (sn-close! 'ADD v1 `((NEG K) ,v2))
      (sn-kdist! v1 v2)
      (dk-lam-b!)
      (if (pair? (dk-open-leaves))
          (begin
            (subst (dk-cite! 'nf-metric-distance 'K v1 v2))
            (sn-rfl!))))))
(subst `(= ,sn-lamL ,sn-lamR))
(qrfl)
(qed 'sub-nf-metric)

;;; the integers of SUB-NF(K, S) are those of K that lie in S
(sp (make-wff (sn-thm `(= (NV-INTEGERS ,sn-r) (INTERSECTION (NV-INTEGERS K) S)))))
(dk-peel!)
(sn-setup!)
(dk-chain-ass! (dk-cite! 'sub-nf-is-normed-field 'K 'S))
(for-each (lambda (n) (dk-cite! n 'K 'S)) sn-readoff-names)
(let ((ce (dk-cite! 'class-extensionality `(NV-INTEGERS ,sn-r) '(INTERSECTION (NV-INTEGERS K) S))))
  (dk-have! (cadr ce)
    (lambda ()
      (let* ((x (begin (di) (cadr (cadr (dk-goal))))))
        (dk-cite! 'intersection-membership '(NV-INTEGERS K) 'S x)
        (dk-iff! (lambda (g) (equal? (caddr g) '(INTERSECTION (NV-INTEGERS K) S)))
          ;; x in Z(SUB) => x in Z(K) and x in S
          (lambda ()
            (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(NV-INTEGERS ,sn-r)))) "x in Z(SUB)"))
                   (h1 (car (dk-landed (lambda () (mac-h 'nv-integers-unfold h)))))
                   (parts (dk-landed (lambda () (sep-me h1)))))
              (for-each (lambda (f) (if (dk-head-is? f 'AND) (dk-split-all! (list f)))) parts)
              (let* ((xs (dk-rewrite-h! `(IN ,x (CARR ,sn-r)) `(CARR ,sn-r) 'S))
                     (n0 (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f sn-r))) "the norm bound"))
                     (n1 (dk-rewrite-h! n0 `(FNRM ,sn-r) sn-lnrm))
                     (fv (dk-cite! 'sub-nf-fnrm-val 'K 'S x))
                     (n2 (dk-rewrite-h! n1 `(,sn-lnrm ,x) `((FNRM K) ,x))))
                (sn-in! x)
                (dk-have! `(IN ,x (NV-INTEGERS K))
                  (lambda () (mac 'nv-integers-unfold) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                (dk-have-and! `(IN ,x (NV-INTEGERS K)) `(IN ,x S))
                (dk-iff-bwd! (dk-cite! 'intersection-membership '(NV-INTEGERS K) 'S x))
                (dk-close-if-asm!))))
          ;; x in Z(K) and x in S => x in Z(SUB)
          (lambda ()
            (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERSECTION (NV-INTEGERS K) S)))) "x in the intersection")))
              (dk-iff-fwd! (dk-cite! 'intersection-membership '(NV-INTEGERS K) 'S x))
              (let* ((hz `(IN ,x (NV-INTEGERS K)))
                     (h1 (car (dk-landed (lambda () (mac-h 'nv-integers-unfold hz)))))
                     (parts (dk-landed (lambda () (sep-me h1)))))
                (for-each (lambda (f) (if (dk-head-is? f 'AND) (dk-split-all! (list f)))) parts)
                (dk-cite! 'sub-nf-fnrm-val 'K 'S x)
                (mac 'nv-integers-unfold)
                (subst `(== (CARR ,sn-r) S))
                (subst `(== (FNRM ,sn-r) ,sn-lnrm))
                (in-sep! (lambda () (dk-ass!))
                         (lambda () (subst `(= (,sn-lnrm ,x) ((FNRM K) ,x))) (dk-ass!))))))))))
  (dk-chain-ass! ce)
  (dk-close-if-asm!))
(qed 'sub-nf-integers)

;;; ---------------------------------------------------------------------------
;;; a subfield holds the powers of its elements; it has arbitrarily small non-zero elements once it holds one
;;; element w with 0 < |w| < 1
(define sn-view-rp (lambda (x n) `(RING-POWER ,sn-view ,x ,n)))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S)
   (FORALL x (IMPLIES (IN x S) (IN ,(sn-view-rp 'x 'n) S)))))))))))
(let* ((br (dk-use-induction-fixed! '(K S)))
       (n (cdr (assq 'var br))) (st (cdr (assq 'step br))) (bs (cdr (assq 'base br))))
  (define (prep!)
    (sn-setup!)
    (sn-view!)
    (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring sn-view)))
  (dk-focus! bs)
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (prep!)
  (let ((x (caddr (cadr (dk-goal)))))
    (sn-in! x) (sn-in-view! x) (fact 'nn-zero-in)
    (dk-chain-ass! (dk-cite! 'ring-power-type sn-view x 0))
    (subst (dk-cite! 'ring-power-zero sn-view x))
    (subst `(= (ONE ,sn-view) (ONE K)))
    (dk-close-if-asm!))
  (dk-focus! st)
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (prep!)
  (let* ((x (caddr (cadr (dk-goal))))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RING-POWER))) "the IH")))
    (sn-in! x)
    (sn-in-view! x)
    (dk-chain-ass! (dk-apply! ih x))
    (subst (dk-cite! 'ring-power-succ sn-view x n))
    (subst `(= (MUL ,sn-view) (MUL K)))
    (sn-close! 'MUL (sn-view-rp x n) x)
    (dk-close-if-asm!)))
(qed 'nf-subfield-ring-power)

(sp (make-wff (sn-thm `(FORALL w (IMPLIES (IN w S) (IMPLIES (< 0 ((FNRM K) w)) (IMPLIES (< ((FNRM K) w) 1)
   (FORALL eps (IMPLIES (POS-RR eps) (FORSOME hs (AND (IN hs S) (AND (NOT (= hs (ZERO K))) (< ((FNRM K) hs) eps)))))))))))))
(dk-peel!)
(sn-setup!)
(sn-in! 'w)
(dk-cite! 'nf-norm-in-rr 'K 'w)
(dk-chain-ass! (dk-cite! 'rr-pos-rr-in-rr 'eps))
(dk-chain-ass! (dk-cite! 'rr-lt-of-pos-rr 'eps))
(dk-have! `(<= 0 ((FNRM K) w)) (lambda () (dk-ineq! `(< 0 ((FNRM K) w)))))
(let* ((k (dk-skolem! (dk-chain-ass! (dk-cite! 'rr-power-decay '((FNRM K) w) 'eps)) #t))
       (hs (sn-view-rp 'w k)))
  (dk-chain-ass! (dk-cite! 'nf-subfield-ring-power k 'K 'S 'w))
  (sn-in! hs)
  (let* ((ne (dk-chain-ass! (dk-cite! 'nv-pow-norm-power 'K 'w k)))
         (pp (dk-chain-ass! (dk-cite! 'rr-power-pos '((FNRM K) w) k))))
    (ew hs)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (dk-ass!))
                ((dk-head-is? g 'NOT)
                 (di)
                 (let* ((z (dk-cite! 'nf-norm-of-zero 'K))
                        (e1 (dk-rewrite-h! ne hs '(ZERO K)))
                        (e2 (dk-rewrite-h! e1 '((FNRM K) (ZERO K)) 0)))
                   (dk-cite! 'power-real-closed '((FNRM K) w) k)
                   (dk-absurd! e2 pp)))
                (#t (subst ne) (dk-close-if-asm!))))))))
(qed 'nf-subfield-small)

;;; a subfield holds the integer multiples n.1 of the identity (n in NN), the multiple taken in the additive group
;;; of the ring view, as HAS-CHARACTERISTIC takes it
(define sn-e1 (lambda (n) `(ZZ-ACT (RING-ADDITIVE-AG ,sn-view) ,n (ONE ,sn-view))))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S)
   (IN ,(sn-e1 'n) S)))))))))
(let* ((br (dk-use-induction-fixed! '(K S)))
       (n (cdr (assq 'var br))) (st (cdr (assq 'step br))) (bs (cdr (assq 'base br))))
  (define (prep!)
    (if (not (dk-head-is? (dk-goal) 'IN)) (dk-peel!))
    (sn-setup!)
    (sn-view!)
    (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring sn-view)))
  (dk-focus! bs)
  (prep!)
  (subst (dk-chain-ass! (dk-cite! 'zz-act-one-zero sn-view)))
  (subst `(= (ZERO ,sn-view) (ZERO K)))
  (dk-close-if-asm!)
  (dk-focus! st)
  (prep!)
  (let ((en (sn-e1 n)))
    (subst (dk-chain-ass! (dk-cite! 'zz-act-one-succ n sn-view)))
    (subst `(= (ADD ,sn-view) (ADD K)))
    (dk-rewrite-h! '(IN (ONE K) S) '(ONE K) `(ONE ,sn-view))
    (sn-close! 'ADD en `(ONE ,sn-view))
    (dk-close-if-asm!)))
(qed 'nf-subfield-zz-act-one)
