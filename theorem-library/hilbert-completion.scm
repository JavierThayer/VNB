    (dk-cite! 'metric-pos hcp-MK L R)
    (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= dLR 'eps)))
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed))))
