               (hcp-type-scalars! (dk-goal))
               (if (hcp-open?) (crs)))))
         (dk-cite! 'form-null-in 'md 'fq e)
         (dk-close-if-asm!)))
      (#t (error "hcp-sub-conj!: unexpected conjunct" (expression->string g))))))
