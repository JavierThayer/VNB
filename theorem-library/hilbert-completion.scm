;;; ---- the laws of the limit form -----------------------------------------------------------------------
(define (hcp-capp! s n cls)             ; (IN (s n) CLS) from s in FUN(NN, CLS)
  (hcp-or (list 'IN (list s n) cls) (lambda () (dk-cite! 'fun-apply-type-c s 'NN cls n))))
(define (hcp-sf! a b)                  ; a, b in V (or typed sequences): SEQ-FORM fq a b in FUN(NN, CC)
  (hcp-vf! a) (hcp-vf! b)
  (let ((t (list 'SEQ-FORM 'fq a b)))
    (hcp-or (list 'IN t '(FUN NN CC)) (lambda () (dk-cite! 'seq-form-type 'md 'fq a b)))
    t))
(define (hcp-lf a b) (list '(LIMIT-FORM md fq) a b))
(define (hcp-lfp! a b)                 ; land LF(a, b) in CC and the convergence; return LF(a, b)
  (let ((l (hcp-lf a b)))
    (if (not (dk-asm? (list 'IN l 'CC))) (dk-split! (dk-cite! 'limit-form-prop 'md 'fq a b)))
    l))
(define (hcp-sfat! a b j)               ; rewrite (SEQ-FORM fq a b)(j) in the goal
  (hcp-vf! a) (hcp-vf! b) (hcp-at! a j) (hcp-at! b j)
  (subst (dk-cite! 'seq-form-at 'md 'fq a b j)))
;;; pointwise identity proved by PTW at the index, then cc-limit-lincomb: land h -> c lv + d mv
(define (hcp-lincomb! s t h lv mv c d ptw)
  (hcp-ct! c) (hcp-ct! d)
  (let ((eqn (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN)
               (list '= (list h 'hcj_) (list '+ (list '* c (list s 'hcj_)) (list '* d (list t 'hcj_))))))))
    (if (not (dk-asm? eqn))
        (dk-have! eqn (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                        (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                   (ptw j)))))
    (dk-chain-ass! (dk-cite! 'cc-limit-lincomb s t h lv mv c d))))

(sp (make-wff (hcp-stmt '() hcp-HI '() (list 'IN '(LIMIT-FORM md fq) (list 'FUN (list 'CARTESIAN hcp-V hcp-V) 'CC)))))
(dk-peel!) (hcp-base!) (hcp-vset!)
(mac 'LIMIT-FORM)
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (if (and (hcp-open?) (hcp-has-head? 'VNB-LAMBDA (dk-goal))) (dk-lam-b!))
    (if (hcp-open?)
        (let* ((io (cadr (dk-goal))) (sf (caddr (caddr (caddr io)))))
          (dk-split! (dk-cite! 'limit-form-iota 'md 'fq (caddr sf) (cadddr sf)))
          (dk-close-if-asm!)))))
(hcp-qed! 'limit-form-type)

;;; LF(f + g, h) = LF(f, h) + LF(g, h)
(sp (make-wff (hcp-stmt '(f g h) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V) (list 'IN 'h hcp-V))
  (list '= (hcp-lf '(SEQ-VADD md f g) 'h) (list '+ (hcp-lf 'f 'h) (hcp-lf 'g 'h))))))
(dk-peel!) (hcp-base!) (hcp-vset!)
(hcp-in-V! '(SEQ-VADD md f g))
(let* ((s (hcp-sf! 'f 'h)) (t (hcp-sf! 'g 'h)) (hh (hcp-sf! '(SEQ-VADD md f g) 'h))
       (l1 (hcp-lfp! 'f 'h)) (l2 (hcp-lfp! 'g 'h))
       (c (list '+ (list '* 1 l1) (list '* 1 l2))))
  (hcp-lincomb! s t hh l1 l2 1 1
    (lambda (j)
      (hcp-sfat! '(SEQ-VADD md f g) 'h j)
      (hcp-at! 'f j) (hcp-at! 'g j) (hcp-at! 'h j)
      (subst (dk-cite! 'seq-vadd-at 'md 'fq 'f 'g j))
      (hcp-sfat! 'f 'h j) (hcp-sfat! 'g 'h j)
      (subst (dk-cite! 'herm-form-add-left 'md 'fq (list 'f j) (list 'g j) (list 'h j)))
      (let ((a (list 'fq (list 'f j) (list 'h j))) (b (list 'fq (list 'g j) (list 'h j))))
        (hcp-ct! a) (hcp-ct! b)
        (subst (dk-cite! 'cc-one-mul a)) (subst (dk-cite! 'cc-one-mul b))
        (if (hcp-open?) (rfl)))))
  (hcp-ct! c)
  (subst (dk-cite! 'limit-form-value 'md 'fq '(SEQ-VADD md f g) 'h c))
  (subst (dk-cite! 'cc-one-mul l1)) (subst (dk-cite! 'cc-one-mul l2))
  (hcp-ct! (list '+ l1 l2))
  (if (hcp-open?) (rfl)))
(hcp-qed! 'limit-form-add-left)

;;; LF(a f, h) = a LF(f, h)
(sp (make-wff (hcp-stmt '(a_ f h) hcp-HI (list '(IN a_ CC) (list 'IN 'f hcp-V) (list 'IN 'h hcp-V))
  (list '= (hcp-lf '(SEQ-ACT md a_ f) 'h) (list '* 'a_ (hcp-lf 'f 'h))))))
(dk-peel!) (hcp-base!) (hcp-vset!)
(hcp-in-V! '(SEQ-ACT md a_ f))
(let* ((s (hcp-sf! 'f 'h)) (hh (hcp-sf! '(SEQ-ACT md a_ f) 'h))
       (l1 (hcp-lfp! 'f 'h))
       (c (list '+ (list '* 'a_ l1) (list '* 0 l1))))
  (hcp-lincomb! s s hh l1 l1 'a_ 0
    (lambda (j)
      (hcp-sfat! '(SEQ-ACT md a_ f) 'h j)
      (hcp-at! 'f j) (hcp-at! 'h j)
      (subst (dk-cite! 'seq-act-at 'md 'fq 'a_ 'f j))
      (hcp-sfat! 'f 'h j)
      (subst (dk-cite! 'herm-form-homog-left 'md 'fq 'a_ (list 'f j) (list 'h j)))
      (hcp-ct! (list 'fq (list 'f j) (list 'h j)))
      (if (hcp-open?) (crs))))
  (hcp-ct! c)
  (subst (dk-cite! 'limit-form-value 'md 'fq '(SEQ-ACT md a_ f) 'h c))
  (if (hcp-open?) (crs)))
(hcp-qed! 'limit-form-homog-left)

;;; the conjugate of a convergent complex sequence converges to the conjugate of the limit
(sp (make-wff '(FORALL hcs_ (IMPLIES (IN hcs_ (FUN NN CC)) (FORALL hch_ (IMPLIES (IN hch_ (FUN NN CC))
  (FORALL hcl_ (IMPLIES (IN hcl_ CC)
    (IMPLIES (FORALL hcj_ (IMPLIES (IN hcj_ NN) (= (hch_ hcj_) (conjugate (hcs_ hcj_)))))
      (IMPLIES (CONVERGES-TO CC-MS hcs_ hcl_) (CONVERGES-TO CC-MS hch_ (conjugate hcl_))))))))))))
(dk-peel!) (hcp-ccms!)
(define hcp-cj-ptw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'conjugate))) "ptw"))
(hcp-ct! '(conjugate hcl_))
(mac 'CONVERGES-TO)
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-ass!) #t)
      ((dk-head-is? (dk-goal) 'IN) (subst '(= (PTS CC-MS) CC)) (dk-close-if-asm!))
      (#t
       (let* ((landed (dk-landed (lambda () (dk-peel!))))
              (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
              (ex (list 'FORSOME 'N (list 'AND '(IN N NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                     (list 'IMPLIES '(<= N n_) (list '<= '((DIST CC-MS) (hcs_ n_) hcl_) ep))))))))
         (dk-have! ex (lambda ()
                        (mac-h 'CONVERGES-TO '(CONVERGES-TO CC-MS hcs_ hcl_)) (dk-split-all!)
                        (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) "law")))
                          (dk-chain-ass! (dk-apply! lw ep)))
                        (dk-close-if-asm!)))
         (let* ((nn (dk-skolem! ex)))
           (dk-split-all!)
           (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'hcs_))) "law n")))
             (ew nn)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let* ((landed (dk-landed (lambda () (dk-peel!))))
                            (n (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed)))
                            (sn (list 'hcs_ n)) (hn (list 'hch_ n)))
                       (hcp-capp! 'hcs_ n 'CC) (hcp-capp! 'hch_ n 'CC)
                       (let ((bd (dk-chain-ass! (dk-apply! lw n))))
                         (subst (dk-cite! 'cc-ms-dist hn '(conjugate hcl_)))
                         (subst (dk-chain-ass! (dk-apply! hcp-cj-ptw n)))
                         (hcp-ct! (list 'conjugate sn))
                         (hcp-ct! (list '- sn 'hcl_))
                         (let ((cs (dk-cite! 'cc-conjugate-sub sn 'hcl_)))
                           (subst (list '= (caddr cs) (cadr cs))))
                         (subst (dk-cite! 'cc-magnitude-conjugate (list '- sn 'hcl_)))
                         (let ((dd (dk-cite! 'cc-ms-dist sn 'hcl_)))
                           (subst (list '= (caddr dd) (cadr dd))))
                         (dk-close-if-asm!)))))))))))))
(hcp-qed! 'cc-limit-conjugate)

;;; LF(g, f) = conj LF(f, g)
(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list '= (hcp-lf 'g 'f) (list 'conjugate (hcp-lf 'f 'g))))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ccms!)
(let* ((s (hcp-sf! 'f 'g)) (hh (hcp-sf! 'g 'f)) (l (hcp-lfp! 'f 'g))
       (eqn (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list hh 'hcj_) (list 'conjugate (list s 'hcj_)))))))
  (dk-have! eqn
    (lambda ()
      (let* ((landed (dk-landed (lambda () (dk-peel!))))
             (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
        (hcp-sfat! 'g 'f j) (hcp-sfat! 'f 'g j)
        (subst (dk-cite! 'herm-form-conj-sym 'md 'fq (list 'f j) (list 'g j)))
        (hcp-ct! (list 'conjugate (list 'fq (list 'f j) (list 'g j))))
        (if (hcp-open?) (rfl)))))
  (hcp-ct! (list 'conjugate l))
  (dk-chain-ass! (dk-cite! 'cc-limit-conjugate s hh l))
  (dk-cite! 'limit-form-value 'md 'fq 'g 'f (list 'conjugate l))
  (dk-close-if-asm!))
(hcp-qed! 'limit-form-conj-sym)

;;; x real: real-part(x) = x
(define (hcp-re-real! x)
  (let ((g (list '= (list 'real-part x) x)))
    (hcp-or g
      (lambda ()
        (hcp-ct! x)
        (dk-cite! 'real-part-in-rr x)
        (dk-have! g
          (lambda ()
            (dk-cite! 'cc-conjugate-fixes-rr x)
            (let* ((e (dk-cite! 'cc-plus-conj-is-2re x))
                   (e2 (dk-rewrite-h! e (list 'conjugate x) x)))
              (dk-ineq! e2))))))))
;;; LF(f, f) is real and >= 0
(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-V))
  (list 'AND (list 'IN (hcp-lf 'f 'f) 'RR) (list '<= 0 (hcp-lf 'f 'f))))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ccms!)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(let* ((s (hcp-sf! 'f 'f)) (l (hcp-lfp! 'f 'f))
       (zc (dk-cite! 'rr-const-converges-to 0))
       (z (caddr zc)))
  (dk-have! (list 'IN s '(FUN NN RR))
    (lambda ()
      (mac 'SEQ-FORM)
      (hcp-lam-type! (lambda (k) (hcp-at! 'f k) (dk-cite! 'psd-form-real 'md 'fq (list 'f k)) (dk-close-if-asm!)))))
  (dk-have! (list 'IN z '(FUN NN RR)) (lambda () (hcp-lam-type! (lambda (k) (dk-close-if-asm!)))))
  (let* ((re-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list 'real-part (list s 'hcj_)) (list s 'hcj_)))))
         (im-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list 'imag-part (list s 'hcj_)) (list z 'hcj_))))))
    (dk-have! re-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                       (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                  (hcp-capp! s j 'RR) (hcp-re-real! (list s j)) (dk-close-if-asm!))))
    (dk-have! im-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                       (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                  (hcp-capp! s j 'RR) (dk-lam-b!)
                                  (dk-cite! 'rr-imag-part-zero (list s j)) (dk-close-if-asm!))))
    (let* ((iff (dk-chain-ass! (dk-cite! 'cc-converges-iff-coords s s z l))))
      (dk-split! iff)
      (let ((fw (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-head-is? (cadr h) 'CONVERGES-TO)
                                          (eq? (cadr (cadr h)) 'CC-MS))) "forward")))
        (dk-split! (dk-chain-ass! fw)))
      (dk-cite! 'imag-part-in-rr l) (dk-cite! 'real-part-in-rr l)
      (dk-chain-ass! (dk-cite! 'rr-limit-unique z (list 'imag-part l) 0))
      (dk-chain-ass! (dk-cite! 'cc-real-of-im-zero l))
      (hcp-re-real! l)
      (let ((le-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '<= (list z 'hcj_) (list s 'hcj_))))))
        (dk-have! le-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                           (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                      (hcp-at! 'f j) (dk-lam-b!)
                                      (hcp-sfat! 'f 'f j)
                                      (dk-cite! 'psd-form-nonneg 'md 'fq (list 'f j)) (dk-close-if-asm!))))
        (dk-chain-ass! (dk-cite! 'rr-limit-le z s 0 (list 'real-part l))))
      (dk-conj-close!
        (lambda () (if (not (dk-ass!)) (dk-ineq! (list '<= 0 (list 'real-part l)) (list '= (list 'real-part l) l))))))))
(hcp-qed! 'limit-form-diag)

;;; ---- the limit form is a positive semi-definite form on the module of Cauchy sequences -----------------
(define (hcp-sub-head e hd)            ; the first subterm (HD-application ...) whose operator is HD
  (cond ((not (pair? e)) #f)
        ((equal? (car e) hd) e)
        (#t (let loop ((l e)) (if (pair? l) (or (hcp-sub-head (car l) hd) (loop (cdr l))) #f)))))
(define (hcp-psd-closer!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((dk-head-is? g 'IS-HERMITIAN-FORM) (mac 'IS-HERMITIAN-FORM) (dk-conj-close! hcp-psd-closer!))
      ((hcp-has-sub? (list 'VEC hcp-CS) g) (subst (list '= (list 'VEC hcp-CS) hcp-V)) (hcp-psd-closer!))
      ((dk-head-is? g 'IN) (dk-cite! 'limit-form-type 'md 'fq) (dk-close-if-asm!))
      ((dk-head-is? g 'FORALL)
       (dk-peel!)
       (let ((va (hcp-sub-head (dk-goal) (list 'VADD hcp-CS))))
         (if va (subst (dk-cite! 'cseq-module-vadd-computes 'md 'fq (cadr va) (caddr va)))))
       (let ((ac (hcp-sub-head (dk-goal) (list 'ACT hcp-CS))))
         (if ac (subst (dk-cite! 'cseq-module-act-computes 'md 'fq (cadr ac) (caddr ac)))))
       (let* ((g (dk-goal)))
         (cond
           ((dk-head-is? g '=)
            (let* ((lhs (cadr g)) (a (cadr lhs)) (b (caddr lhs)))
              (cond ((dk-head-is? a 'SEQ-VADD) (dk-cite! 'limit-form-add-left 'md 'fq (caddr a) (cadddr a) b))
                    ((dk-head-is? a 'SEQ-ACT) (dk-cite! 'limit-form-homog-left 'md 'fq (caddr a) (cadddr a) b))
                    (#t (dk-cite! 'limit-form-conj-sym 'md 'fq b a)))))
           ((dk-head-is? g 'IN) (dk-split! (dk-cite! 'limit-form-diag 'md 'fq (cadr (cadr g)))))
           (#t (dk-split! (dk-cite! 'limit-form-diag 'md 'fq (cadr (caddr g)))))))
       (dk-close-if-asm!))
      (#t (error "limit-form-psd: unexpected conjunct" (expression->string g))))))

(sp (make-wff (hcp-stmt '() hcp-HI '() (list 'IS-PSD-FORM hcp-CS '(LIMIT-FORM md fq)))))
(dk-peel!) (hcp-base!) (hcp-vset!)
(dk-cite! 'cseq-module-vec 'md 'fq)
(mac 'IS-PSD-FORM)
(dk-conj-close! hcp-psd-closer!)
(hcp-qed! 'limit-form-psd)

;;; ---- THE HILBERT COMPLETION IS A COMPLEX INNER PRODUCT SPACE ---------------------------------------------
(sp (make-wff (hcp-stmt '() hcp-HI '() '(IS-COMPLEX-INNER-PRODUCT-SPACE (HILBERT-COMPLETION md fq)))))
(dk-peel!) (hcp-base!)
(dk-cite! 'cseq-module-is-module 'md 'fq)
(dk-cite! 'cseq-module-scal 'md 'fq)
(dk-have! (list '= (list 'SCAL hcp-CS) '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
  (lambda () (subst (list '= (list 'SCAL hcp-CS) '(SCAL md))) (dk-close-if-asm!)))
(dk-cite! 'limit-form-psd 'md 'fq)
(dk-chain-ass! (dk-cite! 'form-quotient-is-cips hcp-CS '(LIMIT-FORM md fq)))
(mac 'HILBERT-COMPLETION)
(dk-close-if-asm!)
(hcp-qed! 'hilbert-completion-is-cips)

;;; ---- the inner product of a form quotient, and the embedding of the space in its completion ----------------
(define hcp-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define hcp-HP (list '(IS-MODULE md) (list '= '(SCAL md) hcp-R) '(IS-PSD-FORM md fq)))
(define hcp-qN '(FORM-NULL md fq))
(define hcp-QM (list 'QUOTIENT-MODULE 'md hcp-qN))
(define hcp-QIP '(FORM-QIP md fq))
(define (hcp-qsetup!)                  ; HP in context: the quotient module and the induced form typed
  (hcp-or '(IS-HERMITIAN-FORM md fq) (lambda () (dk-cite! 'psd-form-hermitian 'md 'fq)))
  (dk-cite! 'form-null-submodule 'md 'fq)
  (dk-cite! 'quotient-module-is-module 'md hcp-qN)
  (let ((v (dk-cite! 'qmod-ro-vec 'md hcp-qN)))
    (dk-cite! 'form-qip-type 'md 'fq)
    (let ((g (list 'IN hcp-QIP (list 'FUN (list 'CARTESIAN (list 'VEC hcp-QM) (list 'VEC hcp-QM)) 'CC))))
      (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (cadr v) (caddr v))) (dk-close-if-asm!))))))
    v))

(sp (make-wff (hcp-stmt '() hcp-HP '() (list '== '(IP (FORM-QUOTIENT md fq)) hcp-QIP))))
(dk-peel!) (hcp-qsetup!)
(mac 'FORM-QUOTIENT)
(dk-cite! 'module-with-form-ip hcp-QM hcp-QIP)
(dk-close-if-asm!)
(hcp-qed! 'form-quotient-ip)

(define (hcp-es x) (list 'EMBED-SEQ hcp-MS x))
(define (hcp-es-in! x)                 ; x in VEC md: the constant sequence of x is in V
  (hcp-ms!)
  (let ((g (list 'IN (hcp-es x) hcp-V)) (gp (list 'IN x (list 'PTS hcp-MS))))
    (hcp-or g (lambda ()
      (hcp-or gp (lambda () (dk-have! gp (lambda () (subst (list '= (list 'PTS hcp-MS) '(VEC md))) (dk-close-if-asm!)))))
      (dk-cite! 'rkt-embed-seq-in-cseq hcp-MS x)
      (dk-cite! 'form-cseq-unfold 'md 'fq)
      (dk-have! g (lambda () (subst (list '= hcp-V (list 'CSEQ hcp-MS))) (dk-close-if-asm!)))))
    (hcp-vf! (hcp-es x))
    (hcp-es x)))

;;; LF(const x, const y) = fq(x, y)
(sp (make-wff (hcp-stmt '(x_ y_) hcp-HI (list (hcp-in-vec 'x_) (hcp-in-vec 'y_))
  (list '= (hcp-lf (hcp-es 'x_) (hcp-es 'y_)) '(fq x_ y_)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ccms!)
(let* ((ex (hcp-es-in! 'x_)) (ey (hcp-es-in! 'y_))
       (c '(fq x_ y_))
       (hh (hcp-sf! ex ey))
       (cp (begin (hcp-ct! c) (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-close-if-asm!)))))
       (s (list 'EMBED-SEQ 'CC-MS c)))
  (dk-cite! 'rkt-embed-seq-in-fun 'CC-MS c)
  (dk-have! (list 'IN s '(FUN NN CC)) (lambda () (subst '(= CC (PTS CC-MS))) (dk-close-if-asm!)))
  (dk-cite! 'rko2-const-seq-converges 'CC-MS c)
  (hcp-lincomb! s s hh c c 1 0
    (lambda (j)
      (hcp-sfat! ex ey j)
      (mac 'EMBED-SEQ)
      (dk-lam-b!)
      (if (hcp-open?) (crs))))
  (let ((v (list '+ (list '* 1 c) (list '* 0 c))))
    (hcp-ct! v)
    (subst (dk-cite! 'limit-form-value 'md 'fq ex ey v))
    (if (hcp-open?) (crs))))
(hcp-qed! 'limit-form-embed)

;;; THE EMBEDDING PRESERVES THE INNER PRODUCT
(define hcp-HC '(HILBERT-COMPLETION md fq))
(define hcp-E '(HC-EMBED md fq))
(define (hcp-cs-setup!)                ; HI in context: the three hypotheses of the form quotient, for CSM and LF
  (hcp-base!) (hcp-vset!)
  (hcp-or (list 'IS-MODULE hcp-CS) (lambda () (dk-cite! 'cseq-module-is-module 'md 'fq)))
  (dk-cite! 'cseq-module-scal 'md 'fq)
  (dk-cite! 'cseq-module-vec 'md 'fq)
  (let ((g (list '= (list 'SCAL hcp-CS) hcp-R)))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'SCAL hcp-CS) '(SCAL md))) (dk-close-if-asm!))))))
  (hcp-or (list 'IS-PSD-FORM hcp-CS '(LIMIT-FORM md fq)) (lambda () (dk-cite! 'limit-form-psd 'md 'fq))))
(define (hcp-vcs! f)                   ; f in V: f in VEC(CSM)
  (let ((g (list 'IN f (list 'VEC hcp-CS))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'VEC hcp-CS) hcp-V)) (dk-close-if-asm!)))))))
(sp (make-wff (hcp-stmt '(x_ y_) hcp-HI (list (hcp-in-vec 'x_) (hcp-in-vec 'y_))
  (list '= (list (list 'IP hcp-HC) (list hcp-E 'x_) (list hcp-E 'y_)) '(fq x_ y_)))))
(dk-peel!) (hcp-cs-setup!)
(let* ((ex (hcp-es-in! 'x_)) (ey (hcp-es-in! 'y_)))
  (hcp-vcs! ex) (hcp-vcs! ey)
  (mac 'HILBERT-COMPLETION)
  (subst (dk-cite! 'form-quotient-ip hcp-CS '(LIMIT-FORM md fq)))
  (mac 'HC-EMBED) (dk-lam-b!)
  (subst (dk-cite! 'form-qip-computes hcp-CS '(LIMIT-FORM md fq) ex ey))
  (dk-cite! 'limit-form-embed 'md 'fq 'x_ 'y_)
  (dk-close-if-asm!))
(hcp-qed! 'hc-embed-ip)

;;; ---- the operations of a form quotient, and the linearity of the embedding ---------------------------------
(for-each
  (lambda (spec)
    (let ((acc (car spec)) (nm (cadr spec)) (ro (caddr spec)))
      (hcp-sp-qed! (make-wff (hcp-stmt '() hcp-HP '() (list '== (list acc '(FORM-QUOTIENT md fq)) (list acc hcp-QM))))
        (lambda ()
          (dk-peel!) (hcp-qsetup!)
          (mac 'FORM-QUOTIENT)
          (dk-cite! ro hcp-QM hcp-QIP)
          (dk-close-if-asm!))
        nm)))
  '((VADD form-quotient-vadd module-with-form-vadd) (ACT form-quotient-act module-with-form-act)
    (VEC form-quotient-vec module-with-form-vec) (VNEG form-quotient-vneg module-with-form-vneg)))

(define hcp-LFT '(LIMIT-FORM md fq))
(define hcp-CN (list 'FORM-NULL hcp-CS hcp-LFT))
(define (hcp-emb-pre! xs)              ; the classes of the constant sequences, and the submodule
  (hcp-cs-setup!)
  (dk-cite! 'form-null-submodule hcp-CS hcp-LFT)
  (for-each (lambda (x) (hcp-vt! x) (let ((e (hcp-es-in! x))) (hcp-vcs! e))) xs))
(define (hcp-es-ext! x lhs rhs ptw)    ; (= LHS RHS), both constant-sequence terms in FUN(NN, VEC md)
  (dk-fun-ext! lhs rhs 'NN '(VEC md) #f #f ptw))

;;; E(x + y) = E(x) + E(y)
(sp (make-wff (hcp-stmt '(x_ y_) hcp-HI (list (hcp-in-vec 'x_) (hcp-in-vec 'y_))
  (list '= (list hcp-E '((VADD md) x_ y_)) (list (list 'VADD hcp-HC) (list hcp-E 'x_) (list hcp-E 'y_))))))
(dk-peel!) (hcp-emb-pre! '(x_ y_ ((VADD md) x_ y_)))
(let* ((ex (hcp-es 'x_)) (ey (hcp-es 'y_)) (exy (hcp-es '((VADD md) x_ y_)))
       (sv (list 'SEQ-VADD 'md ex ey)))
  (hcp-in-V! sv) (hcp-vf! sv)
  (mac 'HILBERT-COMPLETION)
  (subst (dk-cite! 'form-quotient-vadd hcp-CS hcp-LFT))
  (mac 'HC-EMBED) (dk-lam-b!)
  (subst (dk-cite! 'qmod-vadd-computes hcp-CS hcp-CN ex ey))
  (subst (dk-cite! 'cseq-module-vadd-computes 'md 'fq ex ey))
  (let ((fe (hcp-es-ext! 'x_ exy sv
              (lambda (v)
                (subst (dk-cite! 'seq-vadd-at 'md 'fq ex ey v))
                (mac 'EMBED-SEQ) (dk-lam-b!)
                (if (hcp-open?) (rfl))))))
    (if (hcp-open?) (begin (subst (list '= exy sv)) (if (hcp-open?) (rfl))))))
(hcp-qed! 'hc-embed-vadd)

;;; E(a x) = a E(x)
(sp (make-wff (hcp-stmt '(a_ x_) hcp-HI (list '(IN a_ CC) (hcp-in-vec 'x_))
