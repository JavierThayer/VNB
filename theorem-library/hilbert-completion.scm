                 (dl (begin (dk-skolem! (dk-chain-ass! (dk-apply! hcp-uce q))) #f)))
            (dk-split-all!)
            (let* ((ucd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'hcg_) (dk-contains? h q) (not (dk-contains? h 'eps)))) "uc delta"))
                   (dl (cadr (find-first (lambda (h) (and (dk-head-is? h 'POS-RR) (dk-contains? ucd (cadr h)) (not (equal? (cadr h) q)))) (dk-asms)))))
              (dk-cite! 'rr-pos-rr-in-rr dl)
              (let* ((h1 (dk-halve! dl)) (h2 (dk-halve! h1))
                     (wx (begin (dk-cite! 'rr-pos-rr-in-rr h2) (dk-skolem! (dk-cite! 'hc-embed-near 'md 'fq X h2)))))
                (dk-split-all!)
                (let ((wy (dk-skolem! (dk-cite! 'hc-embed-near 'md 'fq Y h2))))
                  (dk-split-all!)
                  (let* ((ex (list hcp-E wx)) (ey (list hcp-E wy)) (xy (list '(VADD md) wx wy)) (exy (list hcp-E xy))
                         (tx (hcp-tv! wx)) (ty (hcp-tv! wy)) (txy (begin (hcp-vt! xy) (hcp-tv! xy)))
                         (m (hcp-kadd! tx ty)))
                    (for-each (lambda (z) (dk-cite! 'hc-embed-type 'md 'fq z) (hcp-gv! (list hcp-E z))) (list wx wy xy))
                    (dk-cite! 'hc-embed-vadd 'md 'fq wx wy)
                    (let* ((da0 (dk-cite! 'hc-dist-add-le 'md 'fq X Y ex ey))
                           (da (dk-rewrite-h! da0 (list (list 'VADD hcp-HC) ex ey) exy))
                           (dX (hcp-hd! X ex)) (dY (hcp-hd! Y ey)) (dS (hcp-hd! S exy))
                           (bX (list '<= dX h2)) (bY (list '<= dY h2))
                           (q1 (hcp-heq h1)) (q0 (hcp-heq dl)))
                      (for-each (lambda (d prems)
                                  (dk-have! (list '<= d dl) (lambda () (hcp-ineq-named! prems (list dX dY dS)))))
                                (list dX dY dS)
                                (list (list bX q1 q0 (list '< 0 h2)) (list bY q1 q0 (list '< 0 h2)) (list da bX bY q1 q0 (list '< 0 h2))))
                      (let* ((k1 (dk-chain-ass! (dk-apply! ucd S exy)))
                             (k2 (dk-chain-ass! (dk-apply! ucd X ex)))
                             (k3 (dk-chain-ass! (dk-apply! ucd Y ey)))
                             (e1 (dk-chain-ass! (dk-apply! hcp-extf xy)))
                             (e2x (dk-chain-ass! (dk-apply! hcp-extf wx)))
                             (e2y (dk-chain-ass! (dk-apply! hcp-extf wy)))
                             (ad (dk-chain-ass! (dk-apply! hcp-tadd wx wy)))
                             (k1a (dk-rewrite-h! k1 (list 'hcg_ exy) txy))
                             (k1b (dk-rewrite-h! k1a txy m))
                             (k2a (dk-rewrite-h! k2 (list 'hcg_ ex) tx))
                             (k3a (dk-rewrite-h! k3 (list 'hcg_ ey) ty))
                             (gx (list 'hcg_ X)) (gy (list 'hcg_ Y))
                             (k4 (dk-cite! 'form-dist-add-le 'hcm_ 'hcq_ gx gy tx ty))
                             (tri (dk-cite! 'metric-triangle hcp-MK L m R))
                             (sym (dk-cite! 'metric-sym hcp-MK m R))
                             (dz (let ((acc '())) (for-each (lambda (pr) (set! acc (cons (hcp-kd! (car pr) (cadr pr)) acc))) (list (list L m) (list m R) (list R m) (list gx tx) (list gy ty))) (reverse acc))))
                        (hcp-ineq-named! (list tri sym k1b k4 k2a k3a (hcp-heq ep) (hcp-heq e2) (list '< 0 q))
                                         (cons dLR dz))))))))))))
    (dk-chain-ass! (dk-cite! 'rr-nonneg-below-all-zero dLR))
    (dk-chain-ass! (dk-cite! 'metric-zero-eq hcp-MK L R))
    (dk-close-if-asm!)))
(hcp-qed! 'hc-ext-additive)

;;; ---- THE EXTENSION OF A HOMOGENEOUS MAP IS HOMOGENEOUS ------------------------------------------------------
(sp (make-wff (hcp-stmt '(a_ x_ y_) hcp-HI (list '(IN a_ CC) (hcp-in-vec 'x_) (hcp-in-vec 'y_))
  (list '= (list (list 'DIST hcp-MS) '((ACT md) a_ x_) '((ACT md) a_ y_))
           (list '* '(MAGNITUDE a_) (list (list 'DIST hcp-MS) 'x_ 'y_))))))
(dk-peel!) (hcp-base!)
(hcp-vt! '((ACT md) a_ x_)) (hcp-vt! '((ACT md) a_ y_))
(for-each (lambda (p) (subst (dk-cite! 'form-ms-dist 'md 'fq (car p) (cadr p))))
          '((((ACT md) a_ x_) ((ACT md) a_ y_)) (x_ y_)))
(dk-cite! 'form-norm-scale-diff 'md 'fq 'a_ 'x_ 'y_)
(dk-close-if-asm!)
