    (dk-close-if-asm!)))
(hcp-qed! 'hc-rel-fwd)

(sp (make-wff (hcp-stmt '(p_ q_) hcp-HI (list (list 'IN 'p_ hcp-V) (list 'IN 'q_ hcp-V))
  (list 'IMPLIES (list 'CSEQ-EQUIV hcp-MS 'p_ 'q_) (list 'IN (hcp-diff-cs 'p_ 'q_) hcp-CN)))))
(dk-peel!) (hcp-cs-setup!) (hcp-ms!)
(let* ((h (hcp-h 'p_ 'q_)) (de (hcp-diff-rw! 'p_ 'q_))
       (l (hcp-lf h h))
       (b (list 'DIST-SEQ hcp-MS 'p_ 'q_)))
  (mac-h 'CSEQ-EQUIV (list 'CSEQ-EQUIV hcp-MS 'p_ 'q_))
