(define hcp-tact
  '(FORALL hca_ (IMPLIES (IN hca_ CC) (FORALL hcx_ (IMPLIES (IN hcx_ (VEC md))
     (= (hct_ ((ACT md) hca_ hcx_)) ((ACT hcm_) hca_ (hct_ hcx_))))))))
(define (hcp-kcarr! a)                 ; (IN a CC): land (IN a (CARR (SCAL hcm_)))
  (let ((g (list 'IN a '(CARR (SCAL hcm_)))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= '(SCAL hcm_) hcp-R)) (subst (dk-cite! 'sip-cc-ring-carr)) (dk-close-if-asm!)))))))
(define (hcp-kact! a u)
  (let ((t (list '(ACT hcm_) a u)))
    (hcp-kcarr! a)
    (hcp-or (list 'IN t '(VEC hcm_)) (lambda () (dk-cite! 'module-act-type 'hcm_ a u)))
    (hcp-kv! t) t))
(define (hcp-mle! x y z)               ; x <= y, 0 <= z, all real: land (<= (* x z) (* y z))
  (hcp-mul-rr! x z) (hcp-mul-rr! y z)
  (dk-chain-ass! (dk-cite! 'rr-mul-le-right x y z)))
(define (hcp-comm! x y)
  (hcp-mul-rr! x y) (hcp-mul-rr! y x)
  (let ((g (list '= (list '* x y) (list '* y x)))) (hcp-or g (lambda () (dk-have! g (lambda () (crs))))) g))
(define (hcp-distr! x m)               ; (= (* x (+ m 1)) (+ (* x m) x))
  (hcp-mul-rr! x m) (hcp-mul-rr! x (list '+ m 1))
  (let ((g (list '= (list '* x (list '+ m 1)) (list '+ (list '* x m) x)))) (hcp-or g (lambda () (dk-have! g (lambda () (crs))))) g))
(define (hcp-pos-parts! v)             ; POS-RR v in context: v in RR, 0 < v, 0 <= v
  (dk-cite! 'rr-pos-rr-in-rr v) (dk-cite! 'rr-lt-of-pos-rr v)
  (let ((g (list '<= 0 v))) (hcp-or g (lambda () (dk-have! g (lambda () (dk-ineq! (list '< 0 v)))))) g))

(sp (make-wff (hcp-stmt '(hcm_ hcq_ hct_ hcg_) (append hcp-HI hcp-HIK)
  (list '(IN hct_ (FUN (VEC md) (VEC hcm_))) hcp-tact (list 'IS-UNIFORMLY-CONTINUOUS hcp-HMS hcp-MK 'hcg_) (hcp-ext-cl 'hcg_))
  (list 'FORALL 'hcaa_ (list 'IMPLIES '(IN hcaa_ CC)
    (list 'FORALL 'hcxx_ (list 'IMPLIES (list 'IN 'hcxx_ (list 'VEC hcp-HC))
      (list '= (list 'hcg_ (list (list 'ACT hcp-HC) 'hcaa_ 'hcxx_)) '((ACT hcm_) hcaa_ (hcg_ hcxx_))))))))))
(dk-peel!) (hcp-hc-pre!)
(dk-have! (list 'IN 'hcg_ (list 'FUN (list 'PTS hcp-HMS) (list 'PTS hcp-MK)))
  (lambda () (mac-h 'IS-UNIFORMLY-CONTINUOUS hcp-ucf) (dk-split-all!) (dk-close-if-asm!)))
(dk-have! hcp-uce (lambda () (mac-h 'IS-UNIFORMLY-CONTINUOUS hcp-ucf) (dk-split-all!) (dk-close-if-asm!)))
(dk-cite! 'form-ms-is-metric-space 'hcm_ 'hcq_)
(dk-cite! 'form-ms-pts 'hcm_ 'hcq_)
(dk-cite! 'ip-metric-space-is-metric-space hcp-HC)
(dk-cite! 'ip-metric-space-pts hcp-HC)
(let* ((g0 (dk-goal)) (L (cadr g0)) (S (cadr L)) (A (cadr S)) (X (caddr S)) (R (caddr g0))
       (mag (list 'MAGNITUDE A)) (a1 (list '+ mag 1)))
  (hcp-hp! X)
  (dk-cite! 'hc-act-type 'md 'fq A X)
  (hcp-gv! S) (hcp-gv! X)
  (hcp-kact! A (list 'hcg_ X))
  (dk-cite! 'cc-magnitude-closed A) (dk-cite! 'cc-magnitude-nonneg A)
  (hcp-rr! a1)
  (dk-have! (list '<= 0 a1) (lambda () (dk-ineq! (list '<= 0 mag))))
  (let ((dLR (hcp-kd! L R)))
    (dk-cite! 'metric-pos hcp-MK L R)
    (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= dLR 'eps)))
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed))))
          (dk-cite! 'rr-pos-rr-in-rr ep)
          (let ((q (dk-skolem! (dk-cite! 'rr-small-factor-real ep a1))))
            (dk-split-all!)
            (hcp-pos-parts! q)
            (dk-skolem! (dk-chain-ass! (dk-apply! hcp-uce q)))
            (dk-split-all!)
            (let* ((ucd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'hcg_) (dk-contains? h q) (not (dk-contains? h 'eps)))) "uc delta"))
                   (dl (cadr (find-first (lambda (h) (and (dk-head-is? h 'POS-RR) (dk-contains? ucd (cadr h)) (not (equal? (cadr h) q)))) (dk-asms)))))
              (hcp-pos-parts! dl)
              (let ((et (dk-skolem! (dk-cite! 'rr-small-factor-real dl a1))))
                (dk-split-all!)
                (hcp-pos-parts! et)
                (let ((wx (dk-skolem! (dk-cite! 'hc-embed-near 'md 'fq X et))))
                  (dk-split-all!)
                  (let* ((ex (list hcp-E wx)) (ax (list '(ACT md) A wx)) (eax (list hcp-E ax))
                         (tx (hcp-tv! wx)) (tax (begin (hcp-vt! ax) (hcp-tv! ax)))
                         (atx (hcp-kact! A tx)))
                    (for-each (lambda (z) (dk-cite! 'hc-embed-type 'md 'fq z) (hcp-gv! (list hcp-E z))) (list wx ax))
                    (dk-cite! 'hc-embed-act 'md 'fq A wx)
                    (let* ((ds0 (dk-cite! 'hc-dist-scale 'md 'fq A X ex))
                           (ds1 (dk-rewrite-h! ds0 (list (list 'ACT hcp-HC) A ex) eax))
                           (dX (hcp-hd! X ex)) (dS (hcp-hd! S eax))
                           (bX (list '<= dX et))
                           (sm-e (list '<= (list '* et a1) dl))
                           (p1 (hcp-mle! dX et mag))
                           (c1 (hcp-comm! mag dX))
                           (c2 (hcp-distr! et mag))
                           (n1 (begin (hcp-mul-rr! et mag) (dk-chain-ass! (dk-cite! 'rr-leq-mul-nonneg et mag)))))
                      (dk-have! (list '<= dX dl)
                        (lambda () (hcp-ineq-named! (list bX sm-e c2 n1) (list dX (list '* et a1) (list '* et mag)))))
                      (dk-have! (list '<= dS dl)
                        (lambda () (hcp-ineq-named! (list ds1 c1 p1 sm-e c2 n1 (list '<= 0 et))
                                     (list dS (list '* mag dX) (list '* dX mag) (list '* et mag) (list '* et a1)))))
                      (let* ((k1 (dk-chain-ass! (dk-apply! ucd S eax)))
                             (k2 (dk-chain-ass! (dk-apply! ucd X ex)))
                             (e1 (dk-chain-ass! (dk-apply! hcp-extf ax)))
                             (e2x (dk-chain-ass! (dk-apply! hcp-extf wx)))
                             (ad (dk-chain-ass! (dk-apply! hcp-tact A wx)))
                             (k1a (dk-rewrite-h! k1 (list 'hcg_ eax) tax))
                             (k1b (dk-rewrite-h! k1a tax atx))
                             (k2a (dk-rewrite-h! k2 (list 'hcg_ ex) tx))
                             (gx (list 'hcg_ X))
                             (k4 (dk-cite! 'form-dist-scale 'hcm_ 'hcq_ A gx tx))
                             (tri (dk-cite! 'metric-triangle hcp-MK L atx R))
                             (sym (dk-cite! 'metric-sym hcp-MK atx R))
                             (dz (let ((acc '())) (for-each (lambda (pr) (set! acc (cons (hcp-kd! (car pr) (cadr pr)) acc))) (list (list L atx) (list atx R) (list R atx) (list gx tx))) (reverse acc)))
                             (dg (list (list 'DIST hcp-MK) gx tx))
                             (p2 (hcp-mle! dg q mag))
                             (c3 (hcp-comm! mag dg))
                             (c4 (hcp-distr! q mag))
                             (sm-q (list '<= (list '* q a1) ep)))
                        (hcp-ineq-named! (list tri sym k1b k4 k2a c3 p2 sm-q c4)
                                         (append (list (list '* mag dg) (list '* dg mag) (list '* q mag) (list '* q a1) dLR) dz))))))))))))
    (dk-chain-ass! (dk-cite! 'rr-nonneg-below-all-zero dLR))
    (dk-chain-ass! (dk-cite! 'metric-zero-eq hcp-MK L R))
    (dk-close-if-asm!)))
(hcp-qed! 'hc-ext-homogeneous)
