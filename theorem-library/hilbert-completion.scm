;;; the norm of z: (IN (SQRT (fq z z)) RR) and (<= 0 (SQRT (fq z z)))
(define (hcp-nrm! z)
  (let ((n (hcp-nrm z)))
    (if (not (dk-asm? (list 'IN n 'RR)))
