                 (let ((h (find-first (lambda (h) (and (dk-head-is? h '=) (equal? (caddr h) (list hcp-E 'x_)))) (dk-asms))))
                   (dk-chain-ass! (dk-cite! 'hc-embed-injective 'md 'fq io 'x_))
                   (dk-close-if-asm!)))))
    (dk-opened (lambda () (iota-d io)))))
(hcp-qed! 'hc-embed-inverse)

;;; ---- THE UNIVERSAL PROPERTY: a Lipschitz map into a Hilbert space extends uniquely --------------------------
(define hcp-KM '(IP-METRIC-SPACE hck_))
(define (hcp-ext-cl g) (list 'FORALL 'hcx_ (list 'IMPLIES '(IN hcx_ (VEC md)) (list '= (list g (list hcp-E 'hcx_)) '(hct_ hcx_)))))
(define hcp-lip
  (list 'FORALL 'hcx_ (list 'IMPLIES '(IN hcx_ (VEC md)) (list 'FORALL 'hcy_ (list 'IMPLIES '(IN hcy_ (VEC md))
    (list '<= (list (list 'DIST hcp-KM) '(hct_ hcx_) '(hct_ hcy_)) (list '* 'hcb_ (list (list 'DIST hcp-MS) 'hcx_ 'hcy_))))))))
(define hcp-SUB (list 'SUBSPACE-MS hcp-HMS hcp-IM))
(define hcp-F (list 'VNB-LAMBDA 'hcw_ hcp-IM (list 'hct_ (hcp-io-inv 'hcw_))))
(define (hcp-in-im! x)                 ; x in VEC md: (IN (E x) A)
  (let ((g (list 'IN (list hcp-E x) hcp-IM)))
    (hcp-or g (lambda ()
      (dk-cite! 'hc-embed-type 'md 'fq x)
      (dk-cite! 'membership-implies-sethood (list hcp-E x) (list 'VEC hcp-HC))
      (dk-have! g (lambda ()
        (mac 'image-membership-iff)
        (dk-conj-close! (lambda () (cond ((dk-ass!) #t)
                                         ((dk-head-is? (dk-goal) 'FORSOME) (ew x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                                         (#t (rfl)))))))))))
(define (hcp-fval! x)                  ; x in VEC md: (= (F (E x)) (T x))
  (hcp-in-im! x)
  (let ((g (list '= (list hcp-F (list hcp-E x)) (list 'hct_ x))))
    (hcp-or (list 'IN (list 'hct_ x) '(VEC hck_)) (lambda () (dk-cite! 'fun-apply-type-c 'hct_ '(VEC md) '(VEC hck_) x)))
    (hcp-or g (lambda () (dk-have! g (lambda ()
      (dk-lam-b!)
      (subst (dk-cite! 'hc-embed-inverse 'md 'fq x))
      (if (hcp-open?) (rfl))))))
    g))
(define (hcp-wit! w)                   ; (IN w A) in context: x in VEC md with E(x) = w; return x
  (let ((ex (list 'FORSOME 'hcv_ (list 'AND '(IN hcv_ (VEC md)) (list '= (list hcp-E 'hcv_) w)))))
    (dk-have! ex (lambda () (mac-h 'image-membership-iff (list 'IN w hcp-IM)) (dk-split-all!) (dk-close-if-asm!)))
    (let ((x (dk-skolem! ex))) (dk-split-all!) x)))

(sp (make-wff (hcp-stmt '(hck_ hct_ hcb_) hcp-HI
  (list '(IS-HILBERT-SPACE hck_) '(IN hct_ (FUN (VEC md) (VEC hck_))) '(IN hcb_ RR) '(<= 0 hcb_) hcp-lip)
  (list 'FORSOME 'hcg_ (list 'AND (list 'IS-UNIFORMLY-CONTINUOUS hcp-HMS hcp-KM 'hcg_)
    (list 'AND (hcp-ext-cl 'hcg_)
      (list 'FORALL 'hch_ (list 'IMPLIES (list 'IS-UNIFORMLY-CONTINUOUS hcp-HMS hcp-KM 'hch_)
        (list 'IMPLIES (hcp-ext-cl 'hch_) '(= hch_ hcg_))))))))))
(dk-peel!) (hcp-hc-pre!)
(dk-have! (list 'IS-COMPLETE hcp-KM) (lambda () (mac-h 'IS-HILBERT-SPACE '(IS-HILBERT-SPACE hck_)) (dk-split-all!) (dk-close-if-asm!)))
(dk-have! '(IS-COMPLEX-INNER-PRODUCT-SPACE hck_) (lambda () (mac-h 'IS-HILBERT-SPACE '(IS-HILBERT-SPACE hck_)) (dk-split-all!) (dk-close-if-asm!)))
(dk-cite! 'ip-metric-space-is-metric-space 'hck_)
(define hcp-kpts (dk-cite! 'ip-metric-space-pts 'hck_))
(dk-cite! 'ip-metric-space-is-metric-space hcp-HC)
(define hcp-hpts2 (dk-cite! 'ip-metric-space-pts hcp-HC))
(define hcp-dense (dk-cite! 'hc-embed-dense 'md 'fq))
(dk-have! '(IN (VEC md) SET) (lambda () (mac-h 'is-module '(IS-MODULE md)) (dk-split-all!) (dk-close-if-asm!)))
(dk-cite! 'image-set hcp-E '(VEC md))
(define hcp-psub (dk-cite! 'subspace-pts hcp-HMS hcp-IM))
(dk-have! (list 'SUBSET hcp-IM (list 'PTS hcp-HMS)) (lambda () (mac-h 'IS-DENSE hcp-dense) (dk-split-all!) (dk-close-if-asm!)))
