       (let ((x (cadr (dk-goal)))) (hcp-null-out! x) (dk-close-if-asm!)))
      ((dk-head-is? g 'IN) (dk-cite! 'form-null-in 'md 'fq (cadr g)) (dk-close-if-asm!))
