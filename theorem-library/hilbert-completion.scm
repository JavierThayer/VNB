;;; Minkowski and Schwarz for the form, read off W: rewrite a W-level hypothesis down to md / fq
(define (hcp-sub-find pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((not (pair? l)) #f) ((hcp-sub-find pred (car l)) => (lambda (x) x)) (#t (loop (cdr l))))))
        (#t #f)))
(define (hcp-h->md! h)
  (let loop ((h h) (fuel 30))
    (let ((r (hcp-sub-find (lambda (e) (and (pair? e) (eq? (car e) 'IP-NORM) (equal? (cadr e) hcp-W))) h)))
      (if (and r (> fuel 0))
          (begin (dk-cite! 'ip-norm-unfold hcp-W (caddr r))
                 (loop (dk-rewrite-h! h r (list 'SQRT (list (list 'IP hcp-W) (caddr r) (caddr r)))) (- fuel 1)))
          (let inner ((h h) (accs '(IP VADD VNEG VZERO ACT VEC)) (vals '(fq (VADD md) (VNEG md) (VZERO md) (ACT md) (VEC md))))
            (cond ((null? accs) h)
                  ((hcp-has-sub? (list (car accs) hcp-W) h)
                   (inner (dk-rewrite-h! h (list (car accs) hcp-W) (car vals)) (cdr accs) (cdr vals)))
                  (#t (inner h (cdr accs) (cdr vals)))))))))
