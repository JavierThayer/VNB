;;; THE EXTENSION IS ADDITIVE.  K is a pre-Hilbert space in the same shape (hcm_, hcq_), its metric FORM-MS.
(define hcp-MK '(FORM-MS hcm_ hcq_))
(define hcp-HIK (list '(IS-MODULE hcm_) (list '= '(SCAL hcm_) hcp-R) '(IS-INNER-PRODUCT-FORM hcm_ hcq_)))
(define hcp-tadd
  '(FORALL hcx_ (IMPLIES (IN hcx_ (VEC md)) (FORALL hcy_ (IMPLIES (IN hcy_ (VEC md))
     (= (hct_ ((VADD md) hcx_ hcy_)) ((VADD hcm_) (hct_ hcx_) (hct_ hcy_))))))))
(define hcp-uce
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'delta (list 'AND '(POS-RR delta)
      (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a (list 'PTS hcp-HMS))
        (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b (list 'PTS hcp-HMS))
          (list 'IMPLIES (list '<= (list (list 'DIST hcp-HMS) 'a 'b) 'delta)
                (list '<= (list (list 'DIST hcp-MK) '(hcg_ a) '(hcg_ b)) 'eps)))))))))))
(define (hcp-heq v) (find-first (lambda (h) (and (dk-head-is? h '=) (equal? (caddr h) v) (dk-head-is? (cadr h) '+))) (dk-asms)))
(define (hcp-kv! t)                    ; (IN t (VEC hcm_)) in context: land (IN t (PTS MK))
  (let ((g (list 'IN t (list 'PTS hcp-MK))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'PTS hcp-MK) '(VEC hcm_))) (dk-close-if-asm!)))))))
(define (hcp-hp! t)                    ; (IN t (VEC HC)) in context: land (IN t (PTS HMS))
  (let ((g (list 'IN t (list 'PTS hcp-HMS))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'PTS hcp-HMS) (list 'VEC hcp-HC))) (dk-close-if-asm!)))))))
(define (hcp-gv! z)                    ; z in VEC HC: (hcg_ z) in PTS MK and in VEC hcm_
  (hcp-hp! z)
  (let ((gz (list 'hcg_ z)))
    (hcp-or (list 'IN gz (list 'PTS hcp-MK)) (lambda () (dk-cite! 'fun-apply-type-c 'hcg_ (list 'PTS hcp-HMS) (list 'PTS hcp-MK) z)))
    (let ((g (list 'IN gz '(VEC hcm_))))
      (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= '(VEC hcm_) (list 'PTS hcp-MK))) (dk-close-if-asm!))))))
    gz))
(define (hcp-tv! x)                    ; x in VEC md: (hct_ x) in VEC hcm_
  (let ((g (list 'IN (list 'hct_ x) '(VEC hcm_))))
    (hcp-or g (lambda () (dk-cite! 'fun-apply-type-c 'hct_ '(VEC md) '(VEC hcm_) x)))
    (hcp-kv! (list 'hct_ x))
    (list 'hct_ x)))
(define (hcp-kadd! a b)
  (let ((t (list '(VADD hcm_) a b)))
    (hcp-or (list 'IN t '(VEC hcm_)) (lambda () (dk-cite! 'module-vadd-type 'hcm_ a b)))
    (hcp-kv! t) t))
(define (hcp-kd! a b)
  (let ((d (list (list 'DIST hcp-MK) a b)))
