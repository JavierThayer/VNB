;;; ---- the square root is continuous on [0, +inf): |sqrt x - sqrt y| <= sqrt |x - y| ------------------------
(define (hcp-sqrt! a)                  ; (IN a RR), (<= 0 a) in context: type sqrt(a)
  (let ((s (list 'sqrt a)))
    (if (not (dk-asm? (list 'IN s 'RR)))
        (begin (hcp-and! (list 'IN a 'RR) (list '<= 0 a)) (dk-split! (dk-cite! 'sqrt-nonneg a))))
    s))
(define (hcp-sub! a b) (hcp-rr! a) (hcp-rr! b)
  (hcp-or (list 'IN (list '- a b) 'RR) (lambda () (hcp-and! (list 'IN a 'RR) (list 'IN b 'RR)) (dk-cite! 'rr-sub-in-rr a b)))
  (list '- a b))
(define (hcp-add! a b) (hcp-rr! a) (hcp-rr! b)
  (hcp-or (list 'IN (list '+ a b) 'RR) (lambda () (hcp-and! (list 'IN a 'RR) (list 'IN b 'RR)) (dk-cite! 'rr-add-in-rr a b)))
  (list '+ a b))
(define (hcp-abs! a) (hcp-rr! a)
  (hcp-or (list 'IN (list 'abs a) 'RR) (lambda () (dk-cite! 'rr-abs-closed a)))
  (hcp-or (list '<= 0 (list 'abs a)) (lambda () (dk-cite! 'rr-abs-nonneg a)))
  (list 'abs a))
(define (hcp-sqsq! a)                  ; (= (* (sqrt a) (sqrt a)) a)
  (hcp-and! (list 'IN a 'RR) (list '<= 0 a))
  (dk-cite! 'sqrt-sq a))

(sp (make-wff '(FORALL sdx_ (IMPLIES (IN sdx_ RR) (FORALL sdy_ (IMPLIES (IN sdy_ RR) (IMPLIES (<= 0 sdx_) (IMPLIES (<= 0 sdy_)
   (<= (abs (- (sqrt sdx_) (sqrt sdy_))) (sqrt (abs (- sdx_ sdy_))))))))))))
(dk-peel!)
(let* ((u (hcp-sqrt! 'sdx_)) (v (hcp-sqrt! 'sdy_))
       (d (hcp-sub! u v)) (t (hcp-abs! d))
       (xy (hcp-sub! 'sdx_ 'sdy_)) (axy (hcp-abs! xy))
       (s (hcp-add! u v))
       (su (hcp-sqsq! 'sdx_)) (sv (hcp-sqsq! 'sdy_)))
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '<= 0 u) (list '<= 0 v))))
  (dk-have! (list '<= (list '- s) d) (lambda () (dk-ineq! (list '<= 0 u) (list '<= 0 v))))
  (dk-have! (list '<= d s) (lambda () (dk-ineq! (list '<= 0 u) (list '<= 0 v))))
  (dk-chain-ass! (dk-cite! 'rr-abs-le-of-parts d s))
  (hcp-mul-rr! t t) (hcp-mul-rr! s t) (hcp-mul-rr! s d) (hcp-mul-rr! u u) (hcp-mul-rr! v v)
  (let* ((e1 (dk-chain-ass! (dk-cite! 'rr-mul-le-right t s t)))
         (sd2 (list '= (list '* s d) (list '- (list '* u u) (list '* v v))))
         (sdxy (list '= (list '* s d) xy))
         (stxy (list '= (list '* s t) axy)))
    (dk-have! sd2 (lambda () (mac 'binary-minus-def) (crs)))
    (dk-have! sdxy (lambda () (subst sd2) (subst su) (subst sv) (if (hcp-open?) (rfl))))
    (dk-cite! 'rr-abs-of-nonneg s)
    (hcp-and! (list 'IN s 'RR) (list 'IN d 'RR))
    (dk-cite! 'rr-abs-mult s d)
    (dk-have! stxy (lambda () (subst (list '= xy (list '* s d))) (subst (list '= (list 'abs (list '* s d)) (list '* (list 'abs s) t)))
                              (subst (list '= (list 'abs s) s)) (if (hcp-open?) (rfl))))
    (let ((tt (list '* t t)))
      (dk-have! (list '<= tt axy) (lambda () (hcp-ineq-named! (list e1 stxy) (list tt (list '* s t) axy))))
      (dk-have! (list '<= 0 tt) (lambda () (hcp-mulnn! t t) (dk-close-if-asm!)))
      (hcp-and! (list 'IN tt 'RR) (list '<= 0 tt))
      (hcp-and! (list 'IN axy 'RR) (list '<= tt axy))
      (let* ((m (dk-cite! 'sqrt-mono tt axy))
             (q (dk-cite! 'sqrt-of-sq t))
             (r (dk-cite! 'rr-abs-of-nonneg t)))
        (hcp-sqrt! tt) (hcp-sqrt! axy) (hcp-abs! t)
        (hcp-ineq-named! (list m q r) (list (list 'sqrt tt) (list 'sqrt axy) (list 'abs t) t))))))
(hcp-qed! 'sqrt-diff-le)

;;; sqrt of a convergent nonnegative real sequence converges to the sqrt of the limit
(sp (make-wff '(FORALL sqa_ (IMPLIES (IN sqa_ (FUN NN RR)) (FORALL sqb_ (IMPLIES (IN sqb_ (FUN NN RR)) (FORALL sql_ (IMPLIES (IN sql_ RR)
   (IMPLIES (FORALL sqj_ (IMPLIES (IN sqj_ NN) (<= 0 (sqa_ sqj_))))
   (IMPLIES (<= 0 sql_)
   (IMPLIES (FORALL sqj_ (IMPLIES (IN sqj_ NN) (= (sqb_ sqj_) (sqrt (sqa_ sqj_)))))
   (IMPLIES (CONVERGES-TO RR-MS sqa_ sql_) (CONVERGES-TO RR-MS sqb_ (sqrt sql_))))))))))))))
(dk-peel!)
(define hcp-sq-nn (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '<=))) "nonneg"))
(define hcp-sq-eq (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'sqrt))) "values"))
(define hcp-sq-L (hcp-sqrt! 'sql_))
(define hcp-sq-law
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n_ (list 'AND '(IN n_ NN)
    (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES '(<= n_ k_)
      (list '<= (list 'abs (list '- '(sqb_ k_) hcp-sq-L)) 'eps)))))))))
(dk-have! hcp-sq-law
  (lambda ()
    (let* ((landed (dk-landed (lambda () (dk-peel!))))
           (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed))))
      (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
      (dk-have! (list '<= 0 ep) (lambda () (dk-ineq! (list '< 0 ep))))
      (let* ((e2 (begin (hcp-mul-rr! ep ep) (list '* ep ep))))
        (dk-have! (list '< 0 e2) (lambda () (dk-chain-ass! (dk-cite! 'rr-mul-pos ep ep)) (dk-close-if-asm!)))
        (dk-have! (list 'POS-RR e2) (lambda () (dk-cite! 'rr-pos-rr-of-lt e2) (dk-close-if-asm!)))
        (dk-have! (list '<= 0 e2) (lambda () (hcp-ineq-named! (list (list '< 0 e2)) (list e2))))
        (let ((ex (list 'FORSOME 'N (list 'AND '(IN N NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                    (list 'IMPLIES '(<= N n_) (list '<= '((DIST RR-MS) (sqa_ n_) sql_) e2))))))))
          (dk-have! ex (lambda ()
                         (mac-h 'CONVERGES-TO '(CONVERGES-TO RR-MS sqa_ sql_)) (dk-split-all!)
                         (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) "law")))
                           (dk-chain-ass! (dk-apply! lw e2)))
                         (dk-close-if-asm!)))
          (let ((nn (dk-skolem! ex)))
            (dk-split-all!)
            (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'sqa_))) "law n")))
              (ew nn)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed)))
                             (ak (list 'sqa_ k)))
                        (hcp-capp! 'sqa_ k 'RR) (hcp-capp! 'sqb_ k 'RR)
                        (dk-chain-ass! (dk-apply! hcp-sq-nn k))
                        (let* ((bd0 (dk-chain-ass! (dk-apply! lw k)))
                               (rd (dk-cite! 'rr-ms-dist ak 'sql_))
                               (bd (dk-rewrite-h! bd0 (cadr rd) (caddr rd)))
                               (dl (hcp-sub! ak 'sql_)) (adl (hcp-abs! dl))
                               (sd (dk-chain-ass! (dk-cite! 'sqrt-diff-le ak 'sql_)))
                               (e2 (list '* ep ep)))
                          (hcp-and! (list 'IN adl 'RR) (list '<= 0 adl))
                          (hcp-and! (list 'IN e2 'RR) (list '<= adl e2))
                          (let* ((m (dk-cite! 'sqrt-mono adl e2))
                                 (q (dk-cite! 'sqrt-of-sq ep))
                                 (r (dk-cite! 'rr-abs-of-nonneg ep)))
                            (subst (dk-chain-ass! (dk-apply! hcp-sq-eq k)))
                            (hcp-sqrt! ak) (hcp-sqrt! adl) (hcp-sqrt! e2) (hcp-abs! ep)
                            (let ((sdf (hcp-sub! (list 'sqrt ak) hcp-sq-L)))
                              (hcp-abs! sdf)
                              (hcp-ineq-named! (list sd m q r)
                                (list (list 'abs sdf) (list 'sqrt adl) (list 'sqrt e2) (list 'abs ep)))))))))))))))))
(dk-chain-ass! (dk-cite! 'rr-converges-to-abs 'sqb_ hcp-sq-L))
(dk-close-if-asm!)
(hcp-qed! 'rr-limit-sqrt)

;;; ---- the limit form and the distance sequence of the completion ------------------------------------------
(define (hcp-sf-rr! f)                 ; (IN (SEQ-FORM fq f f) (FUN NN RR))
  (let* ((s (hcp-sf! f f)) (g (list 'IN s '(FUN NN RR))))
    (hcp-or g (lambda ()
      (dk-have! g (lambda ()
        (mac 'SEQ-FORM)
        (hcp-lam-type! (lambda (k) (hcp-at! f k) (dk-cite! 'psd-form-real 'md 'fq (list f k)) (dk-close-if-asm!)))))))
    s))

;;; fq(f(n), f(n)) -> LF(f, f) in the reals
(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-V))
  (list 'CONVERGES-TO 'RR-MS (list 'SEQ-FORM 'fq 'f 'f) (hcp-lf 'f 'f)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ccms!)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(let* ((s (hcp-sf-rr! 'f)) (l (hcp-lfp! 'f 'f))
       (zc (dk-cite! 'rr-const-converges-to 0))
       (z (caddr zc)))
  (dk-split! (dk-cite! 'limit-form-diag 'md 'fq 'f))
  (dk-have! (list 'IN z '(FUN NN RR)) (lambda () (hcp-lam-type! (lambda (k) (dk-close-if-asm!)))))
  (let* ((re-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list 'real-part (list s 'hcj_)) (list s 'hcj_)))))
         (im-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list 'imag-part (list s 'hcj_)) (list z 'hcj_))))))
    (dk-have! re-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                       (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                  (hcp-capp! s j 'RR) (hcp-re-real! (list s j)) (dk-close-if-asm!))))
    (dk-have! im-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                       (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                  (hcp-capp! s j 'RR) (dk-lam-b!)
                                  (dk-cite! 'rr-imag-part-zero (list s j)) (dk-close-if-asm!))))
    (let* ((iff (dk-chain-ass! (dk-cite! 'cc-converges-iff-coords s s z l))))
      (dk-split! iff)
      (let ((fw (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-head-is? (cadr h) 'CONVERGES-TO)
                                          (eq? (cadr (cadr h)) 'CC-MS))) "forward")))
        (dk-split! (dk-chain-ass! fw)))
      (hcp-re-real! l)
      (subst (list '= l (list 'real-part l)))
      (dk-close-if-asm!))))
(hcp-qed! 'limit-form-rr)

(define (hcp-h f g) (list 'SEQ-VADD 'md f (list 'SEQ-VNEG 'md g)))
(define (hcp-msf! f)                   ; f in V: f in FUN(NN, PTS(MS))
  (hcp-vf! f) (hcp-ms!)
  (let ((g (list 'IN f (list 'FUN 'NN (list 'PTS hcp-MS)))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'PTS hcp-MS) '(VEC md))) (dk-close-if-asm!)))))))

;;; d(f(n), g(n)) -> sqrt LF(f - g, f - g)
(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list 'CONVERGES-TO 'RR-MS (list 'DIST-SEQ hcp-MS 'f 'g) (list 'SQRT (hcp-lf (hcp-h 'f 'g) (hcp-h 'f 'g)))))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ms!)
(let* ((h (hcp-h 'f 'g)) (ng (list 'SEQ-VNEG 'md 'g))
       (b (list 'DIST-SEQ hcp-MS 'f 'g)))
  (hcp-in-V! ng) (hcp-vf! ng) (hcp-in-V! h) (hcp-vf! h)
  (let* ((a (hcp-sf-rr! h)) (l (hcp-lfp! h h)))
    (dk-cite! 'limit-form-rr 'md 'fq h)
    (dk-split! (dk-cite! 'limit-form-diag 'md 'fq h))
    (hcp-msf! 'f) (hcp-msf! 'g)
    (dk-cite! 'rko2-dist-seq-type hcp-MS 'f 'g)
    (let ((nn-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '<= 0 (list a 'hcj_)))))
          (v-ptw (list 'FORALL 'hcj_ (list 'IMPLIES '(IN hcj_ NN) (list '= (list b 'hcj_) (list 'sqrt (list a 'hcj_)))))))
      (dk-have! nn-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                         (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                    (hcp-sfat! h h j)
                                    (dk-cite! 'psd-form-nonneg 'md 'fq (list h j)) (dk-close-if-asm!))))
      (dk-have! v-ptw (lambda () (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                        (j (cadr (find-first (lambda (x) (dk-head-is? x 'IN)) landed))))
                                   (hcp-at! 'f j) (hcp-at! 'g j) (hcp-at! ng j) (hcp-at! h j)
                                   (subst (dk-cite! 'rko2-dist-seq-at hcp-MS 'f 'g j))
                                   (subst (dk-cite! 'form-ms-dist 'md 'fq (list 'f j) (list 'g j)))
                                   (hcp-sfat! h h j)
                                   (subst (dk-cite! 'seq-vadd-at 'md 'fq 'f ng j))
                                   (subst (dk-cite! 'seq-vneg-at 'md 'fq 'g j))
                                   (hcp-nrm! (hcp-d (list 'f j) (list 'g j)))
                                   (if (hcp-open?) (rfl)))))
      (dk-chain-ass! (dk-cite! 'rr-limit-sqrt a b l))
      (dk-close-if-asm!))))
(hcp-qed! 'dist-seq-limit)

;;; ---- the null space of the limit form is the null-distance relation: the two setoids coincide ------------
;;; qmod-rel-unfold: already in the tree (la-z3), cited as is.

(define (hcp-diff-cs p q) (list (list 'VADD hcp-CS) p (list (list 'VNEG hcp-CS) q)))
(define (hcp-diff-rw! p q)             ; the CSM difference of p, q in V is h(p, q): land the equation
  (let ((ng (list 'SEQ-VNEG 'md q)))
    (hcp-in-V! ng) (hcp-in-V! (hcp-h p q)) (hcp-vf! (hcp-h p q))
    (let* ((e1 (dk-cite! 'cseq-module-vneg-computes 'md 'fq q))
           (e2 (dk-cite! 'cseq-module-vadd-computes 'md 'fq p ng))
           (g (list '= (hcp-diff-cs p q) (hcp-h p q))))
      (hcp-or g (lambda () (dk-have! g (lambda () (subst e1) (subst e2) (if (hcp-open?) (rfl))))))
      g)))

(sp (make-wff (hcp-stmt '(p_ q_) hcp-HI (list (list 'IN 'p_ hcp-V) (list 'IN 'q_ hcp-V))
  (list 'IMPLIES (list 'IN (hcp-diff-cs 'p_ 'q_) hcp-CN) (list 'CSEQ-EQUIV hcp-MS 'p_ 'q_)))))
(dk-peel!) (hcp-cs-setup!)
(let* ((h (hcp-h 'p_ 'q_)) (de (hcp-diff-rw! 'p_ 'q_))
       (h0 (list 'IN (hcp-diff-cs 'p_ 'q_) hcp-CN))
