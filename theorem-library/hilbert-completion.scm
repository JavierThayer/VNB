;;; a, b real and >= 0 in context: land (IN (* a b) RR) and (<= 0 (* a b))
(define (hcp-mulnn! a b)
  (hcp-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (hcp-or (list 'IN (list '* a b) 'RR) (lambda () (dk-cite! 'rr-mul-in-rr a b)))
  (hcp-and! (list '<= 0 a) (list '<= 0 b))
  (hcp-or (list '<= 0 (list '* a b)) (lambda () (dk-cite! 'rr-leq-mul-nonneg a b)))
  (list '* a b))

;;; ineq over opaque real terms: name each TERM (typed in RR in context), rewrite the premises and the goal
(define (hcp-ineq-named! prems terms)
  (let loop ((prems prems) (terms terms))
    (if (null? terms)
        (begin
          (for-each (lambda (h) (if (not (dk-asm? h)) (begin (display ";; HCP INEQ PREMISE NOT IN CONTEXT ") (display (expression->string h)) (newline)))) prems)
          (apply dk-ineq! prems))
        (let* ((t (car terms)) (v (dk-name! t 'RR))
               (ps (map (lambda (h) (if (hcp-has-sub? t h) (dk-rewrite-h! h t v) h)) prems)))
          (if (hcp-has-sub? t (dk-goal)) (subst (list '= t v)))
          (loop ps (cdr terms))))))

;;; ---- norm estimates, through the form: two vectors with the same form value have the same norm --------
;;; land (= (fq D D) (fq E E)) by expanding both sides to the atoms
(define (hcp-fq-eq! d e)
  (let ((g (list '= (list 'fq d d) (list 'fq e e))))
    (hcp-vt! d) (hcp-vt! e)
    (hcp-or g (lambda () (dk-have! g (lambda () (hcp-expand!) (if (hcp-open?) (hcp-type-scalars! (dk-goal))) (if (hcp-open?) (crs))))))))
(define (hcp-fq-eq-scaled! d c e)     ; (= (fq D D) (* C (fq E E)))
  (let ((g (list '= (list 'fq d d) (list '* c (list 'fq e e)))))
    (hcp-vt! d) (hcp-vt! e)
    (hcp-or g (lambda () (dk-have! g (lambda () (hcp-expand!) (if (hcp-open?) (hcp-type-scalars! (dk-goal))) (if (hcp-open?) (crs))))))))

