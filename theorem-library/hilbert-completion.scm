  (dk-cite! 'rko2-dist-seq-type hcp-MS 'p_ 'q_)
  (let* ((sl (hcp-sqrt! l))
         (u (begin (dk-have! '(IN 0 RR) (lambda () (arith))) (dk-chain-ass! (dk-cite! 'rr-limit-unique b sl 0))))
         (sq (hcp-sqsq! l))
         (sq2 (dk-rewrite-h! sq sl 0)))
    (dk-have! (list '= l 0) (lambda () (dk-ineq! sq2)))
    (hcp-vcs! h)
    (dk-chain-ass! (dk-cite! 'form-null-in hcp-CS hcp-LFT h))
    (subst de)
    (dk-close-if-asm!)))
(hcp-qed! 'hc-rel-bwd)

(define hcp-QR (list 'QMOD-REL hcp-CS hcp-CN))
(define hcp-CR (list 'CREL hcp-MS))
(sp (make-wff (hcp-stmt '() hcp-HI '() (list '= hcp-QR hcp-CR))))
(dk-peel!) (hcp-cs-setup!) (hcp-ms!)
(dk-cite! 'form-cseq-unfold 'md 'fq)
(define hcp-qru (dk-cite! 'qmod-rel-unfold hcp-CS hcp-CN))
(define hcp-cru (dk-cite! 'rko2-crel-unfold hcp-MS))
(define (hcp-cart-typ! x a)            ; (IN x (CARTESIAN a a)) in context: the components in V
  (dk-split! (dk-cite! 'cartesian-nth x a a))
  (for-each (lambda (k)
              (let ((t (list 'NTH k x)))
                (if (not (dk-asm? (list 'IN t hcp-V)))
                    (dk-have! (list 'IN t hcp-V)
                      (lambda () (subst (list '= hcp-V a)) (dk-close-if-asm!))))))
            '(1 2)))
(let ((ce (dk-cite! 'class-extensionality hcp-QR hcp-CR)))
  (dk-have! (cadr ce)
    (lambda ()
      (di)
      (let ((x (cadr (cadr (dk-goal)))))
        (dk-iff! (lambda (c) (equal? (caddr c) hcp-CR))
          (lambda ()
            (let* ((h1 (dk-rewrite-h! (list 'IN x hcp-QR) hcp-QR (caddr hcp-qru)))
                   (cs (list 'CARTESIAN (list 'VEC hcp-CS) (list 'VEC hcp-CS))))
              (sep-me h1)
              (dk-cite! 'cseq-module-vec 'md 'fq)
              (let* ((d1 (dk-rewrite-h! (list 'IN x cs) (list 'VEC hcp-CS) hcp-V))
                     (d2 (dk-rewrite-h! d1 hcp-V (list 'CSEQ hcp-MS))))
                (hcp-cart-typ! x (list 'CSEQ hcp-MS))
                (dk-chain-ass! (dk-cite! 'hc-rel-fwd 'md 'fq (list 'NTH 1 x) (list 'NTH 2 x)))
                (subst hcp-cru)
                (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))
          (lambda ()
            (let* ((h1 (dk-rewrite-h! (list 'IN x hcp-CR) hcp-CR (caddr hcp-cru)))
                   (cs (list 'CARTESIAN (list 'CSEQ hcp-MS) (list 'CSEQ hcp-MS))))
              (sep-me h1)
