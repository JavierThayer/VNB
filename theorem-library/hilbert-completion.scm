;;; ---- the pointwise operations on sequences: typing and values ----------------------------------------
(define (hcp-lam-type! pointwise)     ; goal (IN (VNB-LAMBDA k NN body) (FUN NN C)): POINTWISE proves body at k
  (dk-each-leaf! (lambda () (lam-t))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
            (pointwise k))
          (begin (fact 'nn-is-set) (dk-ass!))))))
