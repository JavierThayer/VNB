(define hcp-seq-specs
  ;; name, extra vars, extra guards, the sequence term, the value at n_ , the value class
  (list
    (list 'seq-vadd '(f g) (list (list 'IN 'f hcp-fnv) (list 'IN 'g hcp-fnv)) '(SEQ-VADD md f g) '((VADD md) (f n_) (g n_)) '(VEC md))
    (list 'seq-vneg '(f) (list (list 'IN 'f hcp-fnv)) '(SEQ-VNEG md f) '((VNEG md) (f n_)) '(VEC md))
    (list 'seq-act '(a_ f) (list '(IN a_ CC) (list 'IN 'f hcp-fnv)) '(SEQ-ACT md a_ f) '((ACT md) a_ (f n_)) '(VEC md))
    (list 'seq-zero '() '() '(SEQ-ZERO md) '(VZERO md) '(VEC md))
    (list 'seq-form '(f g) (list (list 'IN 'f hcp-fnv) (list 'IN 'g hcp-fnv)) '(SEQ-FORM fq f g) '(fq (f n_) (g n_)) 'CC)))
;;; a proof opened and closed from inside a helper: through dk-sp-qed!, so a certified load installs it
(define (hcp-sp-qed! stmt steps! name)
  (dk-sp-qed! stmt (lambda () (steps!) (if (not (proof-done? *ps*)) (for-each (lambda (l) (display ";; HCP OPEN ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves)))) name)
  (topic! name 'analysis))
(define (hcp-type-val! t cls)
  (if (equal? cls 'CC) (hcp-ct! t) (hcp-vt! t)))
(define (hcp-pt! fs k) (for-each (lambda (f) (hcp-at! f k)) fs))
(for-each
  (lambda (spec)
    (let* ((nm (car spec)) (vs (cadr spec)) (gs (caddr spec)) (tm (cadddr spec)) (val (list-ref spec 4)) (cls (list-ref spec 5))
           (fs (filter (lambda (v) (memq v '(f g))) vs))
           (head (car tm)))
      ;; typing
      (hcp-sp-qed! (make-wff (hcp-stmt vs hcp-HI gs (list 'IN tm (list 'FUN 'NN cls))))
        (lambda ()
          (dk-peel!) (hcp-base!)
          (mac head)
          (hcp-lam-type! (lambda (k) (hcp-pt! fs k) (hcp-type-val! (subst-free 'n_ k val) cls) (dk-close-if-asm!))))
        (string->symbol (string-append (symbol->string nm) "-type")))
      ;; value
      (hcp-sp-qed! (make-wff (hcp-stmt (append vs '(n_)) hcp-HI (append gs '((IN n_ NN))) (list '= (list tm 'n_) val)))
        (lambda ()
          (dk-peel!) (hcp-base!)
          (hcp-pt! fs 'n_)
          (hcp-type-val! val cls)
          (mac head)
          (dk-lam-b!)
          (hcp-fin!))
        (string->symbol (string-append (symbol->string nm) "-at")))))
  hcp-seq-specs)

;;; ---- the Cauchy sequences are closed under the pointwise operations ---------------------------------
(define (hcp-cauchy! f)                ; (IS-CAUCHY-SEQ MS f) in context: land f's typing
  (hcp-or (list 'IN f hcp-fnv) (lambda () (dk-cite! 'form-cauchy-fun 'md 'fq f))))
;;; the law of f at E (POS-RR E in context): (N . law)
(define (hcp-law-at! f e)
  (let* ((cl (dk-chain-ass! (dk-cite! 'form-cauchy-elim 'md 'fq f)))
         (nn (dk-skolem! (dk-apply! cl e)))
         (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'SQRT)
                                       (dk-contains? h (list f 'ka)))) "the law at e")))
    (cons nn lw)))
;;; the law at A, C, both past N: land ||f(A) - f(C)|| <= E and return it
(define (hcp-law-pt! f nl a c)
  (let ((nn (car nl)) (lw (cdr nl)))
    (for-each (lambda (k) (if (not (dk-asm? (list '<= nn k)))
                              (dk-have! (list '<= nn k) (lambda () (dk-nn!)))))
              (list a c))
    (hcp-at! f a) (hcp-at! f c)
    (dk-chain-ass! (dk-apply! lw a c))))
;;; goal (IS-CAUCHY-SEQ MS h) for h typed in FUN(NN, VEC md): BODY gets eps, with (FORSOME nb ...) in focus
(define (hcp-cauchy-goal! h body)
  (let ((ch (dk-cite! 'form-cauchy-intro 'md 'fq h)))
    (dk-have! (hcp-law h)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) landed))))
          (hcp-or (list 'IN ep 'RR) (lambda () (dk-cite! 'rr-pos-rr-in-rr ep)))
          (body ep))))
    (dk-chain-ass! ch)
    (dk-close-if-asm!)))
;;; inside BODY: witness N, then for each pair ka, kc past N run PT on (ka kc)
(define (hcp-past! nn pt)
  (hcp-or (list 'IN nn 'NN) (lambda () (error "hcp-past!: untyped" nn)))
  (ew nn)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ins (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
            (for-each (lambda (x) (if (dk-head-is? x 'AND) (dk-split! x))) landed)
            (pt (car ins) (cadr ins)))))))
(define (hcp-nn-sum! a b)
  (hcp-and! (list 'IN a 'NN) (list 'IN b 'NN))
  (hcp-or (list 'IN (list '+ a b) 'NN) (lambda () (dk-cite! 'nn-add-closed a b)))
  (list '+ a b))

(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IS-CAUCHY-SEQ hcp-MS 'f) (list 'IS-CAUCHY-SEQ hcp-MS 'g))
  (list 'IS-CAUCHY-SEQ hcp-MS '(SEQ-VADD md f g)))))
(dk-peel!) (hcp-base!) (hcp-ms!)
(hcp-cauchy! 'f) (hcp-cauchy! 'g)
(dk-cite! 'seq-vadd-type 'md 'fq 'f 'g)
(hcp-cauchy-goal! '(SEQ-VADD md f g)
  (lambda (ep)
    (let* ((d (dk-halve! ep))
           (nf (hcp-law-at! 'f d)) (ng (hcp-law-at! 'g d))
           (nn (hcp-nn-sum! (car nf) (car ng))))
      (hcp-past! nn
        (lambda (a c)
          (let* ((e1 (hcp-law-pt! 'f nf a c)) (e2 (hcp-law-pt! 'g ng a c)))
            (hcp-at! 'g a) (hcp-at! 'g c)
            (subst (dk-cite! 'seq-vadd-at 'md 'fq 'f 'g a))
            (subst (dk-cite! 'seq-vadd-at 'md 'fq 'f 'g c))
            (let* ((fa (list 'f a)) (fc (list 'f c)) (ga (list 'g a)) (gc (list 'g c))
                   (es (dk-cite! 'form-norm-sum-diff 'md 'fq fa ga fc gc))
                   (t0 (hcp-nrm (hcp-d (list '(VADD md) fa ga) (list '(VADD md) fc gc))))
                   (t1 (hcp-nrm (hcp-d fa fc))) (t2 (hcp-nrm (hcp-d ga gc))))
              (hcp-vt! (list '(VADD md) fa ga)) (hcp-vt! (list '(VADD md) fc gc))
              (for-each hcp-nrm! (list (hcp-d (list '(VADD md) fa ga) (list '(VADD md) fc gc)) (hcp-d fa fc) (hcp-d ga gc)))
              (hcp-ineq-named! (list es e1 e2 (list '= (list '+ d d) ep)) (list t0 t1 t2)))))))))
(hcp-qed! 'seq-vadd-cauchy)

(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IS-CAUCHY-SEQ hcp-MS 'f)) (list 'IS-CAUCHY-SEQ hcp-MS '(SEQ-VNEG md f)))))
(dk-peel!) (hcp-base!) (hcp-ms!)
(hcp-cauchy! 'f)
(dk-cite! 'seq-vneg-type 'md 'fq 'f)
(hcp-cauchy-goal! '(SEQ-VNEG md f)
  (lambda (ep)
    (let ((nf (hcp-law-at! 'f ep)))
      (hcp-past! (car nf)
        (lambda (a c)
          (let ((e1 (hcp-law-pt! 'f nf a c)))
            (subst (dk-cite! 'seq-vneg-at 'md 'fq 'f a))
            (subst (dk-cite! 'seq-vneg-at 'md 'fq 'f c))
            (subst (dk-cite! 'form-norm-neg-diff 'md 'fq (list 'f a) (list 'f c)))
            (dk-close-if-asm!)))))))
(hcp-qed! 'seq-vneg-cauchy)

(sp (make-wff (hcp-stmt '(a_ f) hcp-HI (list '(IN a_ CC) (list 'IS-CAUCHY-SEQ hcp-MS 'f)) (list 'IS-CAUCHY-SEQ hcp-MS '(SEQ-ACT md a_ f)))))
(dk-peel!) (hcp-base!) (hcp-ms!)
(hcp-cauchy! 'f)
(dk-cite! 'seq-act-type 'md 'fq 'a_ 'f)
(dk-cite! 'cc-magnitude-closed 'a_) (dk-cite! 'cc-magnitude-nonneg 'a_)
(hcp-cauchy-goal! '(SEQ-ACT md a_ f)
  (lambda (ep)
    (let* ((ma '(magnitude a_))
           (cc (dk-skolem! (dk-cite! 'rr-small-factor-real ep ma)))
           (nf (begin (dk-cite! 'rr-pos-rr-in-rr cc) (hcp-law-at! 'f cc))))
      (hcp-past! (car nf)
        (lambda (a c)
          (let* ((e1 (hcp-law-pt! 'f nf a c))
                 (fa (list 'f a)) (fc (list 'f c))
                 (nr (hcp-nrm (hcp-d fa fc))))
            (subst (dk-cite! 'seq-act-at 'md 'fq 'a_ 'f a))
            (subst (dk-cite! 'seq-act-at 'md 'fq 'a_ 'f c))
            (subst (dk-cite! 'form-norm-scale-diff 'md 'fq 'a_ fa fc))
            (hcp-nrm! (hcp-d fa fc))
            (let* ((m1 (dk-cite! 'rr-mul-le-right nr cc ma))
                   (p1 (list '* ma nr)) (p2 (list '* nr ma)) (p3 (list '* cc ma)))
              (hcp-mulnn! ma nr) (hcp-mulnn! nr ma)
              (hcp-and! (list 'IN cc 'RR) (list 'IN ma 'RR)) (dk-cite! 'rr-mul-in-rr cc ma)
              (dk-have! (list '= p1 p2) (lambda () (crs)))
              (let ((sm (find-first (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) (list '* cc ma)))) (dk-asms))))
                (hcp-ineq-named! (list (list '= p1 p2) m1 sm) (list p1 p2 p3))))))))))
(hcp-qed! 'seq-act-cauchy)

(sp (make-wff (hcp-stmt '() hcp-HI '() (list '== '(SEQ-ZERO md) (list 'EMBED-SEQ hcp-MS '(VZERO md))))))
(dk-peel!) (mac 'SEQ-ZERO) (mac 'EMBED-SEQ) (qrfl)
(hcp-qed! 'seq-zero-embed)
(sp (make-wff (hcp-stmt '() hcp-HI '() (list 'IS-CAUCHY-SEQ hcp-MS '(SEQ-ZERO md)))))
(dk-peel!) (hcp-base!) (hcp-ms!)
(subst (dk-cite! 'seq-zero-embed 'md 'fq))
(hcp-vt! '(VZERO md))
(dk-have! (list 'IN '(VZERO md) (list 'PTS hcp-MS)) (lambda () (subst (list '= (list 'PTS hcp-MS) '(VEC md))) (dk-close-if-asm!)))
(dk-cite! 'rkt-embed-seq-cauchy hcp-MS '(VZERO md))
(dk-close-if-asm!)
(hcp-qed! 'seq-zero-cauchy)

;;; ---- the module of Cauchy sequences ---------------------------------------------------------------
(define hcp-CS '(CSEQ-MODULE md fq))
(define hcp-V '(FORM-CSEQ md fq))
(define hcp-cs-vadd (list 'VNB-LAMBDA '(LIST hcf_ hcg_) (list 'CARTESIAN hcp-V hcp-V) '(SEQ-VADD md hcf_ hcg_)))
(define hcp-cs-vneg (list 'VNB-LAMBDA 'hcf_ hcp-V '(SEQ-VNEG md hcf_)))
(define hcp-cs-act (list 'VNB-LAMBDA '(LIST hca_ hcf_) (list 'CARTESIAN 'CC hcp-V) '(SEQ-ACT md hca_ hcf_)))
(define (hcp-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (hcp-has-head? h (car e)) (let loop ((l (cdr e))) (and (pair? l) (or (hcp-has-head? h (car l)) (loop (cdr l))))))))
(define (hcp-owed-rfl!)
  (let loop ((fuel 10))
    (let ((k (find-first (lambda (n) (let ((g (dk-goal-of n))) (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))))
                         (dk-open-leaves))))
      (if (and k (> fuel 0)) (begin (dk-focus! k) (rfl) (loop (- fuel 1)))))))
(define (hcp-vset!)
  (hcp-ms!)
  (hcp-or (list 'IN hcp-V 'SET)
          (lambda () (dk-cite! 'rkt-cseq-is-set hcp-MS) (dk-cite! 'form-cseq-unfold 'md 'fq)
                     (dk-have! (list 'IN hcp-V 'SET) (lambda () (subst (list '= hcp-V (list 'CSEQ hcp-MS))) (dk-close-if-asm!))))))
(for-each
  (lambda (spec)
    (let ((nm (car spec)) (acc (cadr spec)) (val (caddr spec)))
      (hcp-sp-qed! (make-wff (hcp-stmt '() hcp-HI '() (list '== (list acc hcp-CS) val)))
        (lambda ()
          (dk-peel!) (hcp-base!) (hcp-vset!)
          (mac-h 'is-module '(IS-MODULE md)) (dk-split-all!)
          (slot acc)
          (mac 'CSEQ-MODULE)
          (nth-r)
          (let loop ((fuel 3))
            (if (and (> fuel 0) (hcp-open?) (hcp-has-head? acc (dk-goal))) (begin (slot acc) (loop (- fuel 1)))))
          (if (hcp-open?) (qrfl))
          (hcp-owed-rfl!))
        nm)))
  (list (list 'cseq-module-scal 'SCAL '(SCAL md))
        (list 'cseq-module-vec 'VEC hcp-V)
        (list 'cseq-module-vadd 'VADD hcp-cs-vadd)
        (list 'cseq-module-vzero 'VZERO '(SEQ-ZERO md))
        (list 'cseq-module-vneg 'VNEG hcp-cs-vneg)
        (list 'cseq-module-act 'ACT hcp-cs-act)))

;;; closure of FORM-CSEQ under the pointwise operations, and the typing of its members
(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-V)) (list 'IN 'f hcp-fnv))))
(dk-peel!) (hcp-base!)
(dk-cite! 'form-cseq-out 'md 'fq 'f) (dk-cite! 'form-cauchy-fun 'md 'fq 'f) (dk-close-if-asm!)
(hcp-qed! 'form-cseq-fun)
(define (hcp-ring-cc! r)              ; r a scalar term of SCAL(md): land (IN r CC)
  (let ((g (list 'IN r 'CC)))
    (cond ((dk-asm? g) g)
          ((dk-asm? (list 'IN r '(CARR (SCAL md))))
           (dk-have! g (lambda () (subst (list '= 'CC '(CARR (SCAL md)))) (dk-close-if-asm!))) g)
          ((and (pair? r) (= (length r) 3) (pair? (car r)) (memq (car (car r)) '(ADD MUL)))
           (hcp-ring-cc! (cadr r)) (hcp-ring-cc! (caddr r))
           (dk-have! g (lambda ()
                         (subst (list '= '(SCAL md) hcp-R))
                         (subst (dk-cite! (if (eq? (car (car r)) 'ADD) 'cc-scalar-ring-add 'cc-scalar-ring-mul)))
                         (if (hcp-has-head? 'VNB-LAMBDA (dk-goal)) (dk-lam-b!))
                         (if (hcp-open?) (begin (hcp-ct! (cadr (dk-goal))) (dk-close-if-asm!)))))
           g)
          ((equal? r '(ONE (SCAL md)))
           (dk-have! g (lambda () (subst (list '= '(SCAL md) hcp-R)) (subst (dk-cite! 'cc-scalar-ring-one)) (hcp-ct! 1) (dk-close-if-asm!)))
           g)
          (#t (hcp-ct! r) g))))
(define (hcp-ring-carr! r)            ; (IN r (CARR (SCAL md)))
  (let ((g (list 'IN r '(CARR (SCAL md)))))
    (hcp-ring-cc! r)
    (hcp-or g (lambda () (dk-have! g (lambda () (subst '(= (CARR (SCAL md)) CC)) (dk-close-if-asm!)))))))
(define (hcp-vf! f) (hcp-or (list 'IN f hcp-fnv) (lambda () (hcp-in-V! f) (dk-cite! 'form-cseq-fun 'md 'fq f))))
(define (hcp-in-V! t)
  (let ((g (list 'IN t hcp-V)))
    (cond ((dk-asm? g) g)
          ((dk-head-is? t 'SEQ-VADD) (hcp-in-V! (caddr t)) (hcp-in-V! (cadddr t)) (dk-cite! 'cseq-vadd-closed 'md 'fq (caddr t) (cadddr t)) g)
          ((dk-head-is? t 'SEQ-VNEG) (hcp-in-V! (caddr t)) (dk-cite! 'cseq-vneg-closed 'md 'fq (caddr t)) g)
          ((dk-head-is? t 'SEQ-ACT) (hcp-ring-cc! (caddr t)) (hcp-in-V! (cadddr t)) (dk-cite! 'cseq-act-closed 'md 'fq (caddr t) (cadddr t)) g)
          ((dk-head-is? t 'SEQ-ZERO) (dk-cite! 'cseq-zero-closed 'md 'fq) g)
          (#t (error "hcp-in-V!: no typing for" (expression->string t))))))
(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V)) (list 'IN '(SEQ-VADD md f g) hcp-V))))
(dk-peel!) (hcp-base!)
(dk-cite! 'form-cseq-out 'md 'fq 'f) (dk-cite! 'form-cseq-out 'md 'fq 'g)
(dk-cite! 'seq-vadd-cauchy 'md 'fq 'f 'g)
(dk-cite! 'form-cseq-in 'md 'fq '(SEQ-VADD md f g)) (dk-close-if-asm!)
(hcp-qed! 'cseq-vadd-closed)
(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-V)) (list 'IN '(SEQ-VNEG md f) hcp-V))))
(dk-peel!) (hcp-base!)
(dk-cite! 'form-cseq-out 'md 'fq 'f)
(dk-cite! 'seq-vneg-cauchy 'md 'fq 'f)
(dk-cite! 'form-cseq-in 'md 'fq '(SEQ-VNEG md f)) (dk-close-if-asm!)
(hcp-qed! 'cseq-vneg-closed)
(sp (make-wff (hcp-stmt '(a_ f) hcp-HI (list '(IN a_ CC) (list 'IN 'f hcp-V)) (list 'IN '(SEQ-ACT md a_ f) hcp-V))))
(dk-peel!) (hcp-base!)
(dk-cite! 'form-cseq-out 'md 'fq 'f)
(dk-cite! 'seq-act-cauchy 'md 'fq 'a_ 'f)
(dk-cite! 'form-cseq-in 'md 'fq '(SEQ-ACT md a_ f)) (dk-close-if-asm!)
(hcp-qed! 'cseq-act-closed)
(sp (make-wff (hcp-stmt '() hcp-HI '() (list 'IN '(SEQ-ZERO md) hcp-V))))
(dk-peel!) (hcp-base!)
(dk-cite! 'seq-zero-cauchy 'md 'fq)
(dk-cite! 'form-cseq-in 'md 'fq '(SEQ-ZERO md)) (dk-close-if-asm!)
(hcp-qed! 'cseq-zero-closed)

;;; the module operations compute
(define (hcp-cs-ro!) (for-each (lambda (nm) (dk-cite! nm 'md 'fq))
  '(cseq-module-scal cseq-module-vec cseq-module-vadd cseq-module-vzero cseq-module-vneg cseq-module-act)))
(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list '= (list (list 'VADD hcp-CS) 'f 'g) '(SEQ-VADD md f g)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-cs-ro!)
(hcp-in-V! '(SEQ-VADD md f g))
(subst (list '= (list 'VADD hcp-CS) hcp-cs-vadd))
(dk-lam-b!) (hcp-fin!)
(hcp-qed! 'cseq-module-vadd-computes)
(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-V))
  (list '= (list (list 'VNEG hcp-CS) 'f) '(SEQ-VNEG md f)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-cs-ro!)
(hcp-in-V! '(SEQ-VNEG md f))
(subst (list '= (list 'VNEG hcp-CS) hcp-cs-vneg))
(dk-lam-b!) (hcp-fin!)
(hcp-qed! 'cseq-module-vneg-computes)
(sp (make-wff (hcp-stmt '(a_ f) hcp-HI (list '(IN a_ CC) (list 'IN 'f hcp-V))
  (list '= (list (list 'ACT hcp-CS) 'a_ 'f) '(SEQ-ACT md a_ f)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-cs-ro!)
(hcp-in-V! '(SEQ-ACT md a_ f))
(subst (list '= (list 'ACT hcp-CS) hcp-cs-act))
(dk-lam-b!) (hcp-fin!)
(hcp-qed! 'cseq-module-act-computes)

;;; ---- THE MODULE OF CAUCHY SEQUENCES ----------------------------------------------------------------
;;; rewrite the module operations of CS applied to typed sequences, innermost first
(define (hcp-cs-redex e)
  (cond ((not (pair? e)) #f)
        ((let l2 ((l e)) (cond ((not (pair? l)) #f) ((hcp-cs-redex (car l)) => (lambda (x) x)) (#t (l2 (cdr l))))) => (lambda (x) x))
        ((and (equal? (car e) (list 'VADD hcp-CS)) (= (length e) 3)) e)
        ((and (equal? (car e) (list 'VNEG hcp-CS)) (= (length e) 2)) e)
        ((and (equal? (car e) (list 'ACT hcp-CS)) (= (length e) 3)) e)
        (#t #f)))
(define (hcp-cs-compute!)
  (let loop ((fuel 30))
    (let ((r (and (hcp-open?) (hcp-cs-redex (dk-goal)))))
      (if (and r (> fuel 0))
          (begin
            (cond ((equal? (car r) (list 'VADD hcp-CS))
                   (hcp-in-V! (cadr r)) (hcp-in-V! (caddr r))
                   (subst (dk-cite! 'cseq-module-vadd-computes 'md 'fq (cadr r) (caddr r))))
                  ((equal? (car r) (list 'VNEG hcp-CS))
                   (hcp-in-V! (cadr r)) (subst (dk-cite! 'cseq-module-vneg-computes 'md 'fq (cadr r))))
                  (#t (hcp-ring-cc! (cadr r)) (hcp-in-V! (caddr r))
                      (subst (dk-cite! 'cseq-module-act-computes 'md 'fq (cadr r) (caddr r)))))
            (loop (- fuel 1)))))))
;;; the pointwise values: ((SEQ-.. ) n) -> the md term, outermost first
(define (hcp-seq-redex e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 2) (pair? (car e)) (memq (car (car e)) '(SEQ-VADD SEQ-VNEG SEQ-ACT SEQ-ZERO))) e)
        (#t (let l2 ((l e)) (cond ((not (pair? l)) #f) ((hcp-seq-redex (car l)) => (lambda (x) x)) (#t (l2 (cdr l))))))))
(define (hcp-seq-compute! n)
  (let loop ((fuel 30))
    (let ((r (and (hcp-open?) (hcp-seq-redex (dk-goal)))))
      (if (and r (> fuel 0))
          (let ((t (car r)))
            (case (car t)
              ((SEQ-VADD) (hcp-vf! (caddr t)) (hcp-vf! (cadddr t)) (subst (dk-cite! 'seq-vadd-at 'md 'fq (caddr t) (cadddr t) n)))
              ((SEQ-VNEG) (hcp-vf! (caddr t)) (subst (dk-cite! 'seq-vneg-at 'md 'fq (caddr t) n)))
              ((SEQ-ACT) (hcp-ring-cc! (caddr t)) (hcp-vf! (cadddr t)) (subst (dk-cite! 'seq-act-at 'md 'fq (caddr t) (cadddr t) n)))
              ((SEQ-ZERO) (subst (dk-cite! 'seq-zero-at 'md 'fq n))))
            (loop (- fuel 1)))))))
;;; type every (f n) for a sequence variable f in V
(define (hcp-type-points! n)
  (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (equal? (caddr h) hcp-V))
                            (begin (hcp-vf! (cadr h)) (hcp-at! (cadr h) n))))
            (dk-asms)))
;;; the md-level law the pointwise goal has become
(define (hcp-md-law!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g))
         (op? (lambda (e o) (and (pair? e) (equal? (car e) (list o 'md)))))
         (cite (lambda (nm . args) (for-each (lambda (a) (if (not (or (op? a 'ADD) (memq a '()))) #t)) args) (apply dk-cite! nm 'md args))))
    (cond
      ((dk-asm? g) (ass))
      ((and (op? l 'VADD) (op? (cadr l) 'VADD)) (cite 'rmod-vadd-assoc (cadr (cadr l)) (caddr (cadr l)) (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'VADD) (equal? (cadr l) '(VZERO md))) (cite 'rmod-vzero-left (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'VADD) (equal? (caddr l) '(VZERO md))) (cite 'rmod-vzero-right (cadr l)) (dk-close-if-asm!))
      ((and (op? l 'VADD) (op? (cadr l) 'VNEG) (equal? (cadr (cadr l)) (caddr l))) (cite 'rmod-vneg-left (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'VADD) (op? (caddr l) 'VNEG) (equal? (cadr (caddr l)) (cadr l)))
       (hcp-vt! (caddr l))
       (subst (cite 'rmod-vadd-comm (cadr l) (caddr l))) (cite 'rmod-vneg-left (cadr l)) (dk-close-if-asm!))
      ((op? l 'VADD) (cite 'rmod-vadd-comm (cadr l) (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'ACT) (op? (caddr l) 'VADD))
       (hcp-ring-carr! (cadr l)) (cite 'module-act-distrib-vec (cadr l) (cadr (caddr l)) (caddr (caddr l))) (dk-close-if-asm!))
      ((and (op? l 'ACT) (pair? (cadr l)) (equal? (car (cadr l)) '(ADD (SCAL md))))
       (hcp-ring-carr! (cadr (cadr l))) (hcp-ring-carr! (caddr (cadr l)))
       (cite 'module-act-distrib-scalar (cadr (cadr l)) (caddr (cadr l)) (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'ACT) (pair? (cadr l)) (equal? (car (cadr l)) '(MUL (SCAL md))))
       (hcp-ring-carr! (cadr (cadr l))) (hcp-ring-carr! (caddr (cadr l)))
       (cite 'module-act-mul-compat (cadr (cadr l)) (caddr (cadr l)) (caddr l)) (dk-close-if-asm!))
      ((and (op? l 'ACT) (equal? (cadr l) '(ONE (SCAL md)))) (cite 'module-act-unital (caddr l)) (dk-close-if-asm!))
      (#t (error "hcp-md-law!: unexpected" (expression->string g))))))
;;; a law of CS on the focus goal (an equation of CS terms, its variables typed)
(define (hcp-cs-law!)
  (hcp-cs-compute!)
  (if (hcp-open?)
      (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
        (for-each (lambda (t) (if (not (symbol? t)) (begin (hcp-in-V! t) (hcp-vf! t)) (hcp-vf! t))) (list l r))
        (dk-fun-ext! l r 'NN '(VEC md) #f #f
          (lambda (n)
            (hcp-type-points! n)
            (hcp-seq-compute! n)
            (if (hcp-open?) (hcp-md-law!)))))))

(sp (make-wff (hcp-stmt '() hcp-HI '() (list 'IS-MODULE hcp-CS))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-cs-ro!)
(dk-cite! 'module-scalar-ring 'md)
(dk-cite! 'cseq-zero-closed 'md 'fq)
(let ((iff (dk-cite! 'is-module hcp-CS))) #t)
(mac 'IS-MODULE)
(dk-isx-set!)
(for-each (lambda (acc val) (if (hcp-has-sub? (list acc hcp-CS) (dk-goal)) (subst (list '= (list acc hcp-CS) val))))
          '(SCAL VEC VZERO) (list '(SCAL md) hcp-V '(SEQ-ZERO md)))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH))
         (mac 'CSEQ-MODULE) (len-r) (if (hcp-open?) (vnb-guard (lambda () (arith)))))
        ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'FUN))
         (let* ((acc (car (cadr g)))
                (val (cond ((eq? acc 'VADD) hcp-cs-vadd) ((eq? acc 'VNEG) hcp-cs-vneg) (#t hcp-cs-act))))
           (subst (list '= (cadr g) val))
           (if (hcp-has-sub? '(CARR (SCAL md)) (dk-goal)) (subst '(= (CARR (SCAL md)) CC)))
           (dk-lam-type!
             (lambda ()
               (dk-peel!)
               (if (and (hcp-open?) (hcp-has-head? 'VNB-LAMBDA (dk-goal))) (dk-lam-b!))
               (if (hcp-open?)
                   (let ((t (cadr (dk-goal))))
                     (if (dk-head-is? t 'SEQ-ACT) (hcp-ring-cc! (caddr t)))
                     (hcp-in-V! t) (dk-close-if-asm!)))))))
        ((memq (car g) '(is-associative is-commutative is-identity has-inverses IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES))
         (mac (car g))
         (dk-peel!)
         (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (hcp-cs-law!)))))
        ((dk-head-is? g 'FORALL)
         (dk-peel!)
         (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'CARR (list 'SCAL hcp-CS))))
                                   (dk-rewrite-h! h (list 'SCAL hcp-CS) '(SCAL md))))
                   (dk-asms))
         (for-each (lambda (acc val) (if (hcp-has-sub? (list acc hcp-CS) (dk-goal)) (subst (list '= (list acc hcp-CS) val))))
                   '(SCAL) (list '(SCAL md)))
         (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) '(CARR (SCAL md)))) (hcp-ring-cc! (cadr h)))) (dk-asms))
         (hcp-cs-law!))
        (#t (error "cseq-module: unexpected conjunct" (expression->string g)))))))
;;; owed definedness of the accessor terms the property macetes were instantiated at
(let loop ((fuel 10))
  (let ((k (find-first (lambda (n) (let ((g (dk-goal-of n))) (and (dk-head-is? g '=) (equal? (cadr g) (caddr g))))) (dk-open-leaves))))
    (if (and k (> fuel 0))
        (let* ((t (cadr (dk-goal-of k)))
               (val (and (pair? t) (equal? (cdr t) (list hcp-CS))
                         (cdr (assq (car t) (list (cons 'VADD hcp-cs-vadd) (cons 'VNEG hcp-cs-vneg) (cons 'ACT hcp-cs-act)))))))
          (dk-focus! k)
          (if val (subst (list '= t val)))
          (rfl)
          (loop (- fuel 1))))))
(hcp-qed! 'cseq-module-is-module)

;;; ---- the limit form: fq(f(n), g(n)) is Cauchy in CC for Cauchy f, g ---------------------------------
(define (hcp-ccms!)
  (hcp-or '(IS-METRIC-SPACE CC-MS) (lambda () (dk-cite! 'cc-is-metric-space)))
  (hcp-or '(== (PTS CC-MS) CC) (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))))
(define (hcp-rr! t) (hcp-or (list 'IN t 'RR) (lambda () (dk-type! t 'RR))))
;;; a <= c, b <= d, 0 <= a, 0 <= b (all real) in context: land a * b <= c * d and return it
(define (hcp-mul-rr! x y)
  (hcp-rr! x) (hcp-rr! y)
  (hcp-or (list 'IN (list '* x y) 'RR) (lambda () (hcp-and! (list 'IN x 'RR) (list 'IN y 'RR)) (dk-cite! 'rr-mul-in-rr x y))))
(define (hcp-prod-le! a b c d)
  (let ((goal (list '<= (list '* a b) (list '* c d))))
    (for-each (lambda (p) (hcp-mul-rr! (car p) (cadr p)))
              (list (list a b) (list c b) (list b c) (list d c) (list c d)))
    (if (not (dk-asm? (list '<= 0 c)))
        (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 0 a) (list '<= a c)))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (let* ((m1 (dk-cite! 'rr-mul-le-right a c b))
                   (m2 (dk-cite! 'rr-mul-le-right b d c)))
              (dk-have! (list '= (list '* c b) (list '* b c)) (lambda () (crs)))
              (dk-have! (list '= (list '* d c) (list '* c d)) (lambda () (crs)))
              (hcp-ineq-named! (list m1 m2 (list '= (list '* c b) (list '* b c)) (list '= (list '* d c) (list '* c d)))
                               (list (list '* a b) (list '* c b) (list '* b c) (list '* d c) (list '* c d)))))))
    goal))
(define (hcp-one-pos!)
  (hcp-or '(POS-RR 1) (lambda () (dk-have! '(< 0 1) (lambda () (arith))) (dk-have! '(IN 1 RR) (lambda () (arith))) (dk-cite! 'rr-pos-rr-of-lt 1))))
;;; ||f(m)|| <= ||f(N)|| + 1 for m past N, from the law of f at 1: land it
(define (hcp-bound-pt! f n1 m)
  (let* ((nn (car n1)) (fm (list f m)) (fN (list f nn))
         (e (hcp-law-pt! f n1 m nn)))
    (hcp-at! f m) (hcp-at! f nn)
    (let ((b (dk-cite! 'form-norm-bound 'md 'fq fm fN)))
      (for-each hcp-nrm! (list fm fN (hcp-d fm fN)))
      (let ((goal (list '<= (hcp-nrm fm) (list '+ (hcp-nrm fN) 1))))
        (hcp-or goal (lambda () (dk-have! goal (lambda () (hcp-ineq-named! (list b e) (list (hcp-nrm fm) (hcp-nrm fN) (hcp-nrm (hcp-d fm fN))))))))))))

(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list 'IS-CAUCHY-SEQ 'CC-MS '(SEQ-FORM fq f g)))))
(dk-peel!) (hcp-base!) (hcp-vset!) (hcp-ccms!)
(hcp-vf! 'f) (hcp-vf! 'g)
(dk-cite! 'form-cseq-out 'md 'fq 'f) (dk-cite! 'form-cseq-out 'md 'fq 'g)
(dk-cite! 'seq-form-type 'md 'fq 'f 'g)
(mac 'IS-CAUCHY-SEQ)
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-ass!) #t)
      ((dk-head-is? (dk-goal) 'IN) (subst '(= (PTS CC-MS) CC)) (dk-close-if-asm!))
      (#t
       (let* ((landed (dk-landed (lambda () (dk-peel!))))
              (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed))))
         (dk-cite! 'rr-pos-rr-in-rr ep)
         (hcp-one-pos!)
         (let* ((f1 (hcp-law-at! 'f 1)) (g1 (hcp-law-at! 'g 1))
                (fNb (list 'f (car f1))) (gNb (list 'g (car g1)))
                (bf (begin (hcp-at! 'f (car f1)) (hcp-nrm! fNb) (list '+ (hcp-nrm fNb) 1)))
                (bg (begin (hcp-at! 'g (car g1)) (hcp-nrm! gNb) (list '+ (hcp-nrm gNb) 1)))
                (kk (list '+ bf bg)))
           (hcp-rr! bf) (hcp-rr! bg) (hcp-rr! kk)
           (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '<= 0 (hcp-nrm fNb)) (list '<= 0 (hcp-nrm gNb)))))
           (let* ((cf (dk-skolem! (dk-cite! 'rr-small-factor-real ep kk)))
                  (fc (begin (dk-cite! 'rr-pos-rr-in-rr cf) (dk-cite! 'rr-lt-of-pos-rr cf) (hcp-law-at! 'f cf)))
                  (gc (hcp-law-at! 'g cf))
                  (n12 (hcp-nn-sum! (car f1) (car g1)))
                  (n34 (hcp-nn-sum! (car fc) (car gc)))
                  (nn (hcp-nn-sum! n12 n34)))
             (dk-have! (list '<= 0 cf) (lambda () (dk-ineq! (list '< 0 cf))))
             (hcp-past! nn
               (lambda (m n)
                 (let* ((fm (hcp-at! 'f m)) (fn (hcp-at! 'f n)) (gm (hcp-at! 'g m)) (gn (hcp-at! 'g n))
                        (a1 (hcp-law-pt! 'f fc m n)) (a2 (hcp-law-pt! 'g gc m n))
                        (b1 (hcp-bound-pt! 'g g1 m)) (b2 (hcp-bound-pt! 'f f1 n)))
                   (subst (dk-cite! 'seq-form-at 'md 'fq 'f 'g m))
                   (subst (dk-cite! 'seq-form-at 'md 'fq 'f 'g n))
                   (hcp-ct! (list 'fq fm gm)) (hcp-ct! (list 'fq fn gn))
                   (subst (dk-cite! 'cc-ms-dist (list 'fq fm gm) (list 'fq fn gn)))
                   (mac 'binary-minus-def)
                   (let* ((est (dk-cite! 'form-diff-estimate 'md 'fq fm gm fn gn))
                          (na (hcp-nrm (hcp-d fm fn))) (nb (hcp-nrm gm)) (nc (hcp-nrm fn)) (nd (hcp-nrm (hcp-d gm gn))))
                     (for-each hcp-nrm! (list (hcp-d fm fn) gm fn (hcp-d gm gn)))
                     (let* ((p1 (hcp-prod-le! na nb cf bg))
                            (p2 (hcp-prod-le! nc nd bf cf))
                            (q1 (list '* cf bg)) (q2 (list '* bf cf)) (qk (list '* cf kk))
                            (mt (list 'magnitude (list '+ (list 'fq fm gm) (list '- (list 'fq fn gn))))))
                       (hcp-mul-rr! cf kk)
                       (dk-have! (list '= (list '+ q1 q2) qk) (lambda () (crs)))
                       (hcp-ct! (list '+ (list 'fq fm gm) (list '- (list 'fq fn gn))))
                       (dk-cite! 'cc-magnitude-closed (list '+ (list 'fq fm gm) (list '- (list 'fq fn gn))))
                       (hcp-mulnn! na nb) (hcp-mulnn! nc nd)
                       (let ((sm (find-first (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) (list '* cf kk)))) (dk-asms))))
                         (hcp-ineq-named! (list est p1 p2 (list '= (list '+ q1 q2) qk) sm)
                                          (list mt (list '* na nb) (list '* nc nd) q1 q2 qk)))))))))))))))
(hcp-qed! 'seq-form-cauchy)

;;; ---- the limit form: its value is THE limit of fq(f(n), g(n)) ------------------------------------------
(define (hcp-find-sub t p)
  (cond ((p t) t) ((pair? t) (let loop ((l t)) (cond ((null? l) #f) ((not (pair? l)) #f) ((hcp-find-sub (car l) p) => (lambda (x) x)) (#t (loop (cdr l)))))) (#t #f)))
(define hcp-SF '(SEQ-FORM fq f g))
(define hcp-IO '(IOTA hcc_ (AND (IN hcc_ CC) (CONVERGES-TO CC-MS (SEQ-FORM fq f g) hcc_))))
(define hcp-LF0 '((LIMIT-FORM md fq) f g))
(define (hcp-sf-pre!)                  ; f, g in V in context: SF typed, Cauchy, convergent
  (hcp-base!) (hcp-vset!) (hcp-ccms!)
  (hcp-vf! 'f) (hcp-vf! 'g)
  (hcp-or (list 'IN hcp-SF '(FUN NN CC)) (lambda () (dk-cite! 'seq-form-type 'md 'fq 'f 'g)))
  (hcp-or (list 'IS-CAUCHY-SEQ 'CC-MS hcp-SF) (lambda () (dk-cite! 'seq-form-cauchy 'md 'fq 'f 'g)))
  (hcp-or (list 'CONVERGES 'CC-MS hcp-SF)
    (lambda ()
      (dk-have! (list 'CONVERGES 'CC-MS hcp-SF)
        (lambda ()
          (dk-cite! 'cc-complete) (mac-h 'IS-COMPLETE '(IS-COMPLETE CC-MS)) (dk-split-all!)
          (let ((u (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-CAUCHY-SEQ))) "complete law")))
            (dk-chain-ass! (dk-apply! u hcp-SF)))
          (dk-close-if-asm!))))))
;;; (CONVERGES-TO CC-MS SF l) in context: land (IN l CC)
(define (hcp-lim-cc! l)
  (hcp-or (list 'IN l 'CC)
    (lambda ()
      (dk-have! (list 'IN l 'CC)
        (lambda ()
          (mac-h 'CONVERGES-TO (list 'CONVERGES-TO 'CC-MS hcp-SF l)) (dk-split-all!)
          (subst '(= CC (PTS CC-MS))) (dk-close-if-asm!))))))

(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list 'AND (list 'IN hcp-IO 'CC) (list 'CONVERGES-TO 'CC-MS hcp-SF hcp-IO)))))
(dk-peel!) (hcp-sf-pre!)

(for-each
 (lambda (k)
   (dk-focus! k)
   (if (dk-head-is? (dk-goal) 'FORSOME)
       (let* ((cv (mac-h 'CONVERGES (list 'CONVERGES 'CC-MS hcp-SF)))
              (l (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'CONVERGES-TO))) "conv"))))
         (hcp-lim-cc! l)
         (ew l)
         (dk-conj-close!
           (lambda ()
             (cond ((dk-ass!) #t)
                   ((dk-head-is? (dk-goal) 'FORALL)
                    (begin
                      (di) (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                      (dk-split-all!)
                      (let ((y (caddr (dk-goal))))
                        (dk-chain-ass! (dk-cite! 'cc-limit-unique hcp-SF l y))
                        (dk-close-if-asm!))))
                   (#t (dk-conj-close! dk-ass!))))))
       (begin (dk-split-all!) (dk-conj-close! dk-ass!))))
 (dk-opened (lambda () (iota-d hcp-IO))))
(hcp-qed! 'limit-form-iota)

(sp (make-wff (hcp-stmt '(f g) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V))
  (list 'AND (list 'IN hcp-LF0 'CC) (list 'CONVERGES-TO 'CC-MS hcp-SF hcp-LF0)))))
(dk-peel!) (hcp-base!) (hcp-vset!)
(mac 'LIMIT-FORM) (dk-lam-b!)
(dk-cite! 'limit-form-iota 'md 'fq 'f 'g)
(dk-close-if-asm!)
(hcp-qed! 'limit-form-prop)

(sp (make-wff (hcp-stmt '(f g c) hcp-HI (list (list 'IN 'f hcp-V) (list 'IN 'g hcp-V) '(IN c CC) (list 'CONVERGES-TO 'CC-MS hcp-SF 'c))
  (list '= hcp-LF0 'c))))
(dk-peel!) (hcp-sf-pre!)
(dk-split! (dk-cite! 'limit-form-prop 'md 'fq 'f 'g))
(dk-chain-ass! (dk-cite! 'cc-limit-unique hcp-SF hcp-LF0 'c))
(dk-close-if-asm!)
