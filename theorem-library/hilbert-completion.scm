    (list 'FORALL 'hcyy_ (list 'IMPLIES (list 'IN 'hcyy_ (list 'VEC hcp-HC))
      (list '= (list 'hcg_ (list (list 'VADD hcp-HC) 'hcxx_ 'hcyy_)) '((VADD hcm_) (hcg_ hcxx_) (hcg_ hcyy_))))))))))
(dk-peel!) (hcp-hc-pre!)
(define hcp-ucf (list 'IS-UNIFORMLY-CONTINUOUS hcp-HMS hcp-MK 'hcg_))
