(dk-cite! 'form-ms-pts 'hcm_ 'hcq_)
(dk-cite! 'ip-metric-space-is-metric-space hcp-HC)
(dk-cite! 'ip-metric-space-pts hcp-HC)
(define hcp-extf (hcp-ext-cl 'hcg_))
(let* ((g0 (dk-goal)) (L (cadr g0)) (S (cadr L)) (X (cadr S)) (Y (caddr S)) (R (caddr g0)))
  (hcp-hp! X) (hcp-hp! Y)
