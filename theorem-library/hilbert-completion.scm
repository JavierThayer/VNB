         (c0 (dk-cite! 'dist-seq-limit 'md 'fq 'p_ 'q_))
         (c1 (dk-rewrite-h! c0 l 0))
         (z (dk-cite! 'sqrt-zero))
         (c2 (dk-rewrite-h! c1 '(sqrt 0) 0)))
