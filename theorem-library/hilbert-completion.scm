       (let* ((ls (dk-peel!))
              (g1 (dk-goal)) (e (cadr g1))
              (xs (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) hcp-N))) (dk-asms))))
         (for-each (lambda (f) (hcp-null-out! (cadr f))) xs)
