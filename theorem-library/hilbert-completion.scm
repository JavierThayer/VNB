                           (if (not (dk-asm? gc)) (dk-have! gc (lambda () (subst '(= CC (CARR (SCAL md)))) (ass)))))))
                   (dk-asms))
         (hcp-vt! e)
         (let ((nulls (map cadr xs)))
           (dk-have! (list '= (list 'fq e e) 0)
             (lambda ()
               (hcp-expand!)
