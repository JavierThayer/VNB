(sp (make-wff (hcp-stmt '(hcaa_ hcxx_ hcuu_) hcp-HI (list '(IN hcaa_ CC) (list 'IN 'hcxx_ (list 'VEC hcp-HC)) (list 'IN 'hcuu_ (list 'VEC hcp-HC)))
  (list '= (hcp-hcd (list (list 'ACT hcp-HC) 'hcaa_ 'hcxx_) (list (list 'ACT hcp-HC) 'hcaa_ 'hcuu_))
           (list '* '(MAGNITUDE hcaa_) (hcp-hcd 'hcxx_ 'hcuu_))))))
(dk-peel!) (hcp-hc-pre!) (hcp-qc-hi!)
