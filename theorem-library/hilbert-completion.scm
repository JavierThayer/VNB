  (dk-have! (list 'IN f (list 'CSEQ hcp-MS)) (lambda () (subst (list '= (list 'CSEQ hcp-MS) hcp-V)) (dk-close-if-asm!)))
  (dk-have! (list 'IN g (list 'CSEQ hcp-MS)) (lambda () (subst (list '= (list 'CSEQ hcp-MS) hcp-V)) (dk-close-if-asm!)))
