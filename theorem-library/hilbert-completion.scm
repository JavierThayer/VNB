;; F is a function from the subspace to K
(dk-have! (list 'IN hcp-F (list 'FUN (list 'PTS hcp-SUB) (list 'PTS hcp-KM)))
  (lambda ()
    (subst hcp-psub) (subst hcp-kpts)
    (dk-lam-type!
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (w (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed))))
          (if (and (hcp-open?) (hcp-has-head? 'VNB-LAMBDA (dk-goal))) (dk-lam-b!))
          (let ((x (hcp-wit! w)))
            (subst (list '= w (list hcp-E x)))
            (subst (dk-cite! 'hc-embed-inverse 'md 'fq x))
            (dk-cite! 'fun-apply-type-c 'hct_ '(VEC md) '(VEC hck_) x)
            (dk-close-if-asm!)))))))
;; F is uniformly continuous
(dk-have! (list 'IS-UNIFORMLY-CONTINUOUS hcp-SUB hcp-KM hcp-F)
  (lambda ()
    (mac 'IS-UNIFORMLY-CONTINUOUS)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
                   (dl (dk-skolem! (dk-cite! 'rr-small-factor-real ep 'hcb_))))
              (dk-split-all!)
              (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-pos-rr-in-rr dl)
              (ew dl)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (ins (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) landed))))
                        (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-peel!))
                        (let* ((a (car ins)) (b (cadr ins))
                               (bd0 (find-first (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h 'DIST))) (dk-asms))))
                          (for-each (lambda (u) (dk-rewrite-h! (list 'IN u (list 'PTS hcp-SUB)) (cadr hcp-psub) (caddr hcp-psub))) (list a b))
                          (let* ((sd (dk-cite! 'subspace-dist hcp-HMS hcp-IM a b))
                                 (bd1 (dk-rewrite-h! bd0 (cadr sd) (caddr sd)))
                                 (xa (hcp-wit! a)) (xb (hcp-wit! b))
                                 (bd2 (dk-rewrite-h! bd1 a (list hcp-E xa)))
                                 (bd3 (dk-rewrite-h! bd2 b (list hcp-E xb)))
                                 (iso (dk-cite! 'hc-embed-isometry 'md 'fq xa xb))
                                 (bd4 (dk-rewrite-h! bd3 (cadr iso) (caddr iso))))
                            (subst (list '= a (list hcp-E xa))) (subst (list '= b (list hcp-E xb)))
                            (subst (hcp-fval! xa)) (subst (hcp-fval! xb))
                            (let* ((lp (dk-chain-ass! (dk-apply! (dk-pick (lambda (h) (equal? h hcp-lip)) "lip") xa xb)))
                                   (dms (list (list 'DIST hcp-MS) xa xb))
                                   (dkm (list (list 'DIST hcp-KM) (list 'hct_ xa) (list 'hct_ xb))))
                              (hcp-ms!)
                              (for-each (lambda (x) (let ((gp (list 'IN x (list 'PTS hcp-MS))))
                                                      (hcp-or gp (lambda () (dk-have! gp (lambda () (subst (list '= (list 'PTS hcp-MS) '(VEC md))) (dk-close-if-asm!)))))
                                                      (let ((gk (list 'IN (list 'hct_ x) (list 'PTS hcp-KM))))
                                                        (hcp-or gk (lambda () (dk-have! gk (lambda () (subst hcp-kpts) (dk-close-if-asm!))))))))
                                        (list xa xb))
                              (dk-cite! 'metric-dist-real hcp-MS xa xb)
                              (dk-cite! 'metric-dist-real hcp-KM (list 'hct_ xa) (list 'hct_ xb))
                              (hcp-mul-rr! 'hcb_ dms) (hcp-mul-rr! dms 'hcb_) (hcp-mul-rr! dl 'hcb_)
                              (let ((m1 (dk-chain-ass! (dk-cite! 'rr-mul-le-right dms dl 'hcb_)))
                                    (cm (list '= (list '* 'hcb_ dms) (list '* dms 'hcb_))))
                                (dk-have! cm (lambda () (crs)))
                                (let ((sm (find-first (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) (list '* dl 'hcb_)))) (dk-asms))))
                                  (hcp-ineq-named! (list lp m1 cm sm)
                                    (list dkm (list '* 'hcb_ dms) (list '* dms 'hcb_) (list '* dl 'hcb_))))))))))))))))))
;; extend
(define hcp-ex (dk-chain-ass! (dk-cite! 'uniformly-continuous-extension-from-dense hcp-HMS hcp-KM hcp-IM hcp-F)))
(define hcp-gx (dk-skolem! hcp-ex))
(dk-split-all!)
(define hcp-uq (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'EXTENDS-ON))) "uniqueness"))
(ew hcp-gx)
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-ass!) #t)
      ((and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'hcx_) (not (dk-contains? (dk-goal) 'IS-UNIFORMLY-CONTINUOUS)))
       (let* ((landed (dk-landed (lambda () (dk-peel!))))
              (x (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed))))
         (hcp-fval! x)
         (mac-h 'EXTENDS-ON (list 'EXTENDS-ON hcp-IM hcp-gx hcp-F))
         (let ((ext (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h hcp-gx))) "ext")))
           (subst (dk-chain-ass! (dk-apply! ext (list hcp-E x))))
           (subst (hcp-fval! x))
           (if (hcp-open?) (rfl)))))
      (#t
       (di) (di) (di)
       (let* ((g (dk-goal)) (h (cadr g))
              (exth (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f h) (dk-contains? f 'hct_))) (dk-asms))))
         (dk-have! (list 'EXTENDS-ON hcp-IM h hcp-F)
           (lambda ()
             (mac 'EXTENDS-ON)
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (w (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                    (x (hcp-wit! w)))
               (subst (list '= w (list hcp-E x)))
               (subst (hcp-fval! x))
               (dk-chain-ass! (dk-apply! exth x))
               (dk-close-if-asm!))))
         (dk-chain-ass! (dk-apply! hcp-uq h))
         (dk-close-if-asm!))))))
(hcp-qed! 'hilbert-completion-universal)

