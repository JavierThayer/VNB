    (hcp-or (list 'IN d 'RR) (lambda () (dk-cite! 'metric-dist-real hcp-MK a b)))
    d))
(define (hcp-hd! a b)
  (let ((d (hcp-hcd a b)))
    (hcp-hp! a) (hcp-hp! b)
    (hcp-or (list 'IN d 'RR) (lambda () (dk-cite! 'metric-dist-real hcp-HMS a b)))
    d))

(sp (make-wff (hcp-stmt '(hcm_ hcq_ hct_ hcg_) (append hcp-HI hcp-HIK)
  (list '(IN hct_ (FUN (VEC md) (VEC hcm_))) hcp-tadd (list 'IS-UNIFORMLY-CONTINUOUS hcp-HMS hcp-MK 'hcg_) (hcp-ext-cl 'hcg_))
