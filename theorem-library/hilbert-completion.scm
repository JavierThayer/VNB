(let ((hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'kc))) "the law")))
  (mac 'IS-CAUCHY-SEQ)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS hcp-MS) '(VEC md))) (dk-close-if-asm!))
        (#t
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
                (nn (dk-skolem! (dk-apply! hyp ep)))
                (law (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'SQRT))) "the law at eps")))
           (ew nn)
           (dk-conj-close!
             (lambda ()
               (if (not (dk-ass!))
                   (let* ((landed2 (dk-landed (lambda () (dk-peel!) (dk-split-all!))))
                          (g (dk-goal)) (fm (cadr (cadr g))) (fn (caddr (cadr g))))
                     (dk-chain-ass! (dk-apply! law (cadr fm) (cadr fn)))
                     (hcp-at! 'f (cadr fm)) (hcp-at! 'f (cadr fn))
                     (subst (dk-cite! 'form-ms-dist 'md 'fq fm fn))
                     (dk-close-if-asm!)))))))))))
(hcp-qed! 'form-cauchy-intro)

(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IS-CAUCHY-SEQ hcp-MS 'f)) (list 'IN 'f hcp-fnv))))
