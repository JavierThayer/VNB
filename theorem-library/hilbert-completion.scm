(dk-peel!) (hcp-base!) (hcp-ms!)
(dk-cite! 'form-cauchy-fun 'md 'fq 'f)
(let* ((h (list 'IS-CAUCHY-SEQ hcp-MS 'f))
       (dl (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n (list 'AND '(IN n NN)
              (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list 'IMPLIES '(AND (<= n m) (<= n n_)) (list '<= (list (list 'DIST hcp-MS) '(f m) '(f n_)) 'eps)))))))))))
       (law (dk-project! dl 'is-cauchy-seq h)))
  (let* ((ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) (dk-asms))))
         (nn (dk-skolem! (dk-apply! law ep)))
         (lw (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x nn) (dk-contains? x 'DIST))) "the law at eps")))
    (ew nn)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                   (ins (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed2)))
                   (a (car ins)) (c (cadr ins)))
              (hcp-and! (list '<= nn a) (list '<= nn c))
              (let ((r (dk-chain-ass! (dk-apply! lw a c))))
                (hcp-at! 'f a) (hcp-at! 'f c)
                (hcp-dist->nrm-h! r (list 'f a) (list 'f c))
                (dk-close-if-asm!))))))))
