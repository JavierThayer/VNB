;;; ---- Cauchy sequences of the form, in norm terms ----------------------------------------------------
(define (hcp-law f)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
    (list 'FORALL 'ka (list 'IMPLIES '(IN ka NN) (list 'FORALL 'kc (list 'IMPLIES '(IN kc NN)
      (list 'IMPLIES '(<= nb ka) (list 'IMPLIES '(<= nb kc)
        (list '<= (hcp-nrm (hcp-d (list f 'ka) (list f 'kc))) 'eps))))))))))))
(define hcp-fnv '(FUN NN (VEC md)))
(define (hcp-ms!)
  (hcp-or (list 'IS-METRIC-SPACE hcp-MS) (lambda () (dk-cite! 'form-ms-is-metric-space 'md 'fq)))
  (hcp-or (list '== (list 'PTS hcp-MS) '(VEC md)) (lambda () (dk-cite! 'form-ms-pts 'md 'fq))))
(define (hcp-at! f n)                  ; (IN (f n) (VEC md)) from f in FUN(NN, VEC md), n in NN
  (let ((g (hcp-in-vec (list f n))))
    (hcp-or g (lambda () (dk-cite! 'fun-apply-type-c f 'NN '(VEC md) n)))
    (list f n)))
(define (hcp-dist->nrm-h! h a b)       ; a hypothesis with (DIST MS)(a, b): rewrite it to the norm
  (hcp-vt! a) (hcp-vt! b)
  (dk-cite! 'form-ms-dist 'md 'fq a b)
  (dk-rewrite-h! h (list (list 'DIST hcp-MS) a b) (hcp-nrm (hcp-d a b))))

(sp (make-wff (hcp-stmt '(f) hcp-HI (list (list 'IN 'f hcp-fnv) (hcp-law 'f)) (list 'IS-CAUCHY-SEQ hcp-MS 'f))))
