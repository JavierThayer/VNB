(define (hcp-qcarr! a)                 ; (IN a CC): land (IN a (CARR (SCAL QMc)))
  (let ((g (list 'IN a (list 'CARR (list 'SCAL hcp-QMc)))))
    (hcp-or g (lambda () (dk-have! g (lambda () (subst (list '= (list 'SCAL hcp-QMc) hcp-R)) (subst (dk-cite! 'sip-cc-ring-carr)) (dk-close-if-asm!)))))))
(sp (make-wff (hcp-stmt '(hcaa_ hcxx_) hcp-HI (list '(IN hcaa_ CC) (list 'IN 'hcxx_ (list 'VEC hcp-HC)))
  (list 'IN (list (list 'ACT hcp-HC) 'hcaa_ 'hcxx_) (list 'VEC hcp-HC)))))
(dk-peel!) (hcp-hc-pre!) (hcp-qc-hi!)
(dk-cite! 'hc-vec-form 'md 'fq) (dk-cite! 'hc-act-form 'md 'fq)
(hcp-to-qc! 'hcxx_) (hcp-qcarr! 'hcaa_)
(subst (list '= (list 'VEC hcp-HC) (list 'VEC hcp-QMc)))
(subst (list '= (list 'ACT hcp-HC) (list 'ACT hcp-QMc)))
