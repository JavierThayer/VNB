(define (qg-qsetup!)                     ; module, submodule, quotient module, and the read-off of PTS
  (qg-ag-open!) (qg-sub-open!)
  (qg-or-asm `(IS-MODULE ,QG-M) (lambda () (dk-cite! 'ag-zz-module-is-module 'g)))
  (qg-or-asm `(IS-SUBMODULE ,QG-M h) (lambda () (dk-cite! 'ag-subgroup-submodule 'g 'h)))
  (qg-or-asm `(IS-MODULE ,QG-QM) (lambda () (dk-cite! 'quotient-module-is-module QG-M 'h))))

