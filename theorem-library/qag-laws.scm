  (qg-ct a)
  (qg-or-asm (list 'IN a (list 'VEC QG-M))
    (lambda () (dk-have! (list 'IN a (list 'VEC QG-M)) (lambda () (subst (dk-cite! 'agm-vec 'g)) (dk-close-if-asm!)))))
  (qg-or-asm (list 'IN a (list 'PTS QG-S))
    (lambda () (dk-have! (list 'IN a (list 'PTS QG-S))
                 (lambda () (subst (dk-cite! 'qmod-setoid-pts QG-M 'h)) (dk-close-if-asm!))))))

