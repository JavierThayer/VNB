(dk-peel!)
(qg-qsetup!)
(qg-pts! 'a) (qg-pts! 'b)
(let ((iff (dk-cite! 'qmod-class-eq-iff QG-M 'h 'a 'b)))
  (dk-cite! 'agm-vadd 'g) (dk-cite! 'agm-vneg 'g)
  (subst (list '== '(OPR g) (list 'VADD QG-M)))
  (subst (list '== '(INV g) (list 'VNEG QG-M)))
  (dk-close-if-asm!))
(qg-done! 'qag-class-eq-iff)
(gloss! 'qag-class-eq-iff "In G/H two classes [a], [b] are equal exactly when a - b lies in H.")

;;; =====================================================================
;;; (5) Powers and orders in G/H.
;;; =====================================================================
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) ,(qg-agh `(FORALL a (IMPLIES (IN a (CARR g))
  (= (GPOW ,QG-Q ,(qg-cl 'a) n) ,(qg-cl '(GPOW g a n))))))))))
(let* ((ind (dk-use-induction-fixed! '(g h))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, h fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (qg-qsetup!)
  (subst (dk-cite! 'gpow-zero QG-Q (qg-cl 'a)))
  (subst (dk-cite! 'gpow-zero 'g 'a))
  (subst (dk-cite! 'qag-iden 'g 'h))
  (qg-rfl-classes!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (qg-qsetup!)
  (let ((p (list 'GPOW 'g 'a n)))
    (dk-cite! 'gpow-type n 'g 'a)
    (subst (dk-cite! 'gpow-succ QG-Q (qg-cl 'a) n))
    (subst (dk-apply! ih 'a))
    (subst (dk-cite! 'gpow-succ 'g 'a n))
    (subst (dk-cite! 'qag-opr-class 'g 'h 'a p))
    (qg-rfl-classes!)))
(qg-done! 'qag-gpow-class)

(sp (make-wff `(FORALL n (IMPLIES (IN n NN) ,(qg-agh `(FORALL a (IMPLIES (IN a (CARR g))
  (IFF (= (GPOW ,QG-Q ,(qg-cl 'a) n) (IDEN ,QG-Q)) (IN (GPOW g a n) h)))))))))
(dk-peel!)
(qg-qsetup!)
(let ((p '(GPOW g a n)))
  (dk-cite! 'gpow-type 'n 'g 'a)
  (subst (dk-cite! 'qag-gpow-class 'n 'g 'h 'a))
  (subst (dk-cite! 'qag-iden 'g 'h))
  (qg-ct '(IDEN g))
  (let* ((iff (dk-cite! 'qag-class-eq-iff 'g 'h p '(IDEN g)))
         (e1 (dk-cite! 'group-inv-iden 'g))
         (iff2 (dk-rewrite-h! iff '((INV g) (IDEN g)) '(IDEN g)))
         (e2 (dk-cite! 'group-op-right-id 'g p))
         (iff3 (dk-rewrite-h! iff2 (qg-op p '(IDEN g)) p)))
    (dk-close-if-asm!)))
(qg-done! 'qag-pow-iden-iff)
(gloss! 'qag-pow-iden-iff "In G/H the n-th power of [a] is the identity exactly when the n-th power of a lies in H.")

;;; =====================================================================
;;; (6) The classes are the cosets: [a] = a + H, and the points of G/H are LEFT-COSETS(G, H) (group-cosets-vocab),
;;;     which joins this file to the Lagrange file (group-cosets.scm).
;;; =====================================================================
(define (qg-csep a) (list 'SEP 'b_ (list 'PTS QG-S) (list 'RELATED QG-S a 'b_)))
(define (qg-lsep a) (list 'SEP 'gcx_ '(CARR g) (list 'FORSOME 'gcy_ (list 'AND '(IN gcy_ h) (list '= 'gcx_ (qg-op a 'gcy_))))))
(sp (make-wff (qg-agh `(FORALL a (IMPLIES (IN a (CARR g)) (= ,(qg-cl 'a) (LEFT-COSET g a h)))))))
(dk-peel!)
(qg-qsetup!)
(qg-pts! 'a)
(dk-cite! 'qmod-setoid-pts QG-M 'h) (dk-cite! 'agm-vec 'g) (dk-cite! 'agm-vadd 'g) (dk-cite! 'agm-vneg 'g)
(dk-cite! 'class-unfold QG-S 'a)
(dk-cite! 'left-coset-unfold 'g 'a 'h)
(dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x (qg-cl 'a)) '(IN x (LEFT-COSET g a h))))
  (lambda ()
    (di)
    (dk-iff! (lambda (g0) (and (dk-head-is? g0 'IN) (dk-head-is? (caddr g0) 'LEFT-COSET)))
      (lambda ()
        ;; x in [a]: a - x in H, and x = a + (x - a)
        (let* ((m1 (dk-rewrite-h! (list 'IN 'x (qg-cl 'a)) (qg-cl 'a) (qg-csep 'a))))
          (dk-sep-parts! m1)
          (dk-rewrite-h! (dk-rewrite-h! (list 'IN 'x (list 'PTS QG-S)) (list 'PTS QG-S) (list 'VEC QG-M)) (list 'VEC QG-M) '(CARR g))
          (let* ((r0 (dk-cite! 'qmod-related-out QG-M 'h 'a 'x))
                 (r1 (dk-rewrite-h! r0 (list 'VADD QG-M) '(OPR g)))
                 (r2 (dk-rewrite-h! r1 (list 'VNEG QG-M) '(INV g)))
                 (u (qg-op 'a (qg-inv 'x)))
                 (y (qg-inv u)))
            (qg-ct y)
            (qg-sub-inv! u)
            (subst '(== (LEFT-COSET g a h) (SEP gcx_ (CARR g) (FORSOME gcy_ (AND (IN gcy_ h) (= gcx_ ((OPR g) a gcy_)))))))
            (in-sep! (lambda () (dk-close-if-asm!))
              (lambda ()
                (ew y)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-ctx-form (dk-goal)) (ass)
                        (begin
                          (subst (dk-cite! 'abelian-group-inv-opr 'g 'a (qg-inv 'x)))
                          (subst (dk-cite! 'abelian-group-inv-inv 'g 'x))
                          (subst (dk-cite! 'group-mul-inv-cancel 'g 'a 'x))
                          (rfl))))))))))
      (lambda ()
        ;; x = a + y with y in H: a - x = -y in H
        (let* ((m1 (dk-rewrite-h! '(IN x (LEFT-COSET g a h)) '(LEFT-COSET g a h) (qg-lsep 'a)))
               (pp (dk-sep-parts! m1))
               (y (dk-skolem! (dk-ctx-form pp)))
               (xe (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'x))) (dk-asms))))
          (qg-sub-carr! y)
          (qg-pts! 'x)
          (qg-sub-inv! y)
          (qg-ct (qg-inv y))
          (dk-have! (list 'IN (qg-op 'a (qg-inv 'x)) 'h)
            (lambda ()
              (subst xe)
              (subst (dk-cite! 'abelian-group-inv-opr 'g 'a y))
              (subst (dk-cite! 'group-mul-inv-cancel 'g 'a (qg-inv y)))
              (dk-close-if-asm!)))
          (dk-have! (list 'IN (list (list 'VADD QG-M) 'a (list (list 'VNEG QG-M) 'x)) 'h)
            (lambda () (subst (list '== (list 'VADD QG-M) '(OPR g))) (subst (list '== (list 'VNEG QG-M) '(INV g))) (dk-close-if-asm!)))
          (dk-cite! 'qmod-related-in QG-M 'h 'a 'x)
          (subst (list '== (qg-cl 'a) (qg-csep 'a)))
          (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))))
(dk-chain-ass! (dk-cite! 'class-extensionality (qg-cl 'a) '(LEFT-COSET g a h)))
(dk-close-if-asm!)
(qg-done! 'qag-class-left-coset)
(gloss! 'qag-class-left-coset "In G/H the class of a is the left coset aH.")

(sp (make-wff (qg-agh `(= (CARR ,QG-Q) (LEFT-COSETS g h)))))
(dk-peel!)
(qg-qsetup!)
(dk-cite! 'quotient-ag-is-abelian-group 'g 'h)
(dk-cite! 'left-cosets-unfold 'g 'h)
(dk-cite! 'group-carr-set 'g)
(dk-cite! 'qmod-setoid-is-setoid QG-M 'h)
(dk-cite! 'qmod-setoid-pts QG-M 'h) (dk-cite! 'agm-vec 'g)
(define QG-LCS '(SEP gcc_ (POWER (CARR g)) (FORSOME gca_ (AND (IN gca_ (CARR g)) (= gcc_ (LEFT-COSET g gca_ h))))))
(dk-have! (list 'FORALL 'c (list 'IFF (list 'IN 'c (list 'CARR QG-Q)) '(IN c (LEFT-COSETS g h))))
  (lambda ()
    (di)
    (dk-iff! (lambda (g0) (and (dk-head-is? g0 'IN) (dk-head-is? (caddr g0) 'LEFT-COSETS)))
      (lambda ()
        (let* ((ex (dk-cite! 'qag-rep 'g 'h 'c))
               (a (dk-skolem! ex))
               (ce (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'c))) (dk-asms))))
          (qg-pts! a)
          (dk-cite! 'qag-class-left-coset 'g 'h a)
          (dk-cite! 'class-is-set QG-S a)
          (dk-cite! 'class-unfold QG-S a)
          (subst '(== (LEFT-COSETS g h) (SEP gcc_ (POWER (CARR g)) (FORSOME gca_ (AND (IN gca_ (CARR g)) (= gcc_ (LEFT-COSET g gca_ h)))))))
          (subst ce)
          (in-sep!
            (lambda ()
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (qg-cl a)) '(IN z_ (CARR g))))
                (lambda ()
                  (let* ((lk (dk-peel!)) (z (cadr (car lk)))
                         (m1 (dk-rewrite-h! (list 'IN z (qg-cl a)) (qg-cl a) (qg-csep a))))
                    (dk-sep-parts! m1)
                    (dk-rewrite-h! (dk-rewrite-h! (list 'IN z (list 'PTS QG-S)) (list 'PTS QG-S) (list 'VEC QG-M)) (list 'VEC QG-M) '(CARR g))
                    (dk-close-if-asm!))))
              (dk-cite! 'power-mem-intro '(CARR g) (qg-cl a))
              (dk-close-if-asm!))
            (lambda ()
              (ew a)
              (dk-conj-close! (lambda () (dk-close-if-asm!)))))))
      (lambda ()
        (let* ((m1 (dk-rewrite-h! '(IN c (LEFT-COSETS g h)) '(LEFT-COSETS g h) QG-LCS))
               (pp (dk-sep-parts! m1))
               (a (dk-skolem! (dk-ctx-form pp)))
               (ce (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'c))) (dk-asms))))
          (dk-cite! 'qag-class-left-coset 'g 'h a)
          (dk-cite! 'qag-class-in 'g 'h a)
          (subst ce)
          (subst (list '= (list 'LEFT-COSET 'g a 'h) (qg-cl a)))
          (dk-close-if-asm!))))))
(dk-chain-ass! (dk-cite! 'class-extensionality (list 'CARR QG-Q) '(LEFT-COSETS g h)))
(dk-close-if-asm!)
(qg-done! 'qag-carr-left-cosets)
(gloss! 'qag-carr-left-cosets "The points of G/H are exactly the left cosets of H in G (LEFT-COSETS).")
