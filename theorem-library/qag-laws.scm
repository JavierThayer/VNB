;;; qag-laws.scm -- EVERY ABELIAN GROUP IS A ZZ-MODULE; THE QUOTIENT GROUP G/H (agent CCR-PRUEFER, 2026-10-29).
;;; Vocabulary: qag-vocab.scm (AG-ZZ-MODULE, QUOTIENT-AG, IS-ISO-GROUP).  Prefix qg-.
;;; Destination theorem-library/.  Library: algebra.
;;;
;;; PLAN.  (1) The read-offs of AG-ZZ-MODULE(g).  (2) AG-ZZ-MODULE(g) is a module: the module laws are the ZZ-ACT laws
;;; of zz-action (zz-act-distrib, zz-act-add, zz-act-assoc, zz-act-one).  (3) A subgroup H is closed under ZZ-ACT
;;; (induction on NN, then the sign), so it is a submodule.  (4) G/H := MODULE-VECTOR-AG(QUOTIENT-MODULE(..)) is an
;;; abelian group, by the tree's quotient-module-is-module and module-vector-ag-is-abelian-group; its operations on
;;; classes are the quotient module's (qmod-vadd-computes, qmod-vneg-computes, qmod-class-eq-iff).  (5) Powers and
;;; orders in G/H: GPOW(G/H, [a], n) = [GPOW(g, a, n)], and [a]^n = e iff a^n lies in H.
;;;
;;; LOAD WINDOW: after qag-vocab, theorem-library/la-z3-quotient (quotient-module-is-module, qmod-*),
;;; rake-zz-act and rake-asm-2 (the ZZ-ACT laws), tg-group / cg4-gpow (group lemmas, gpow-zero / gpow-succ), views.

   ; KIT-9 link skipping, opt-in per file since 2026-10-29 (developed with it on)

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (qg-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** qag-laws: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (qg-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (qg-has-head? h (car e)) (qg-has-head? h (cdr e)))))
(define QG-M '(AG-ZZ-MODULE g))
(define QG-S '(QMOD-SETOID (AG-ZZ-MODULE g) h))
(define QG-Q '(QUOTIENT-AG g h))
(define QG-QM '(QUOTIENT-MODULE (AG-ZZ-MODULE g) h))
(define (qg-cl a) (list 'CLASS QG-S a))
(define (qg-op a b) (list '(OPR g) a b))
(define (qg-inv a) (list '(INV g) a))
(define (qg-ag body) `(FORALL g (IMPLIES (IS-ABELIAN-GROUP g) ,body)))
(define (qg-agh body) `(FORALL g (IMPLIES (IS-ABELIAN-GROUP g) (FORALL h (IMPLIES (IS-SUBGROUP g h) ,body)))))
(define (qg-or-asm f thunk) (if (not (dk-asm? f)) (thunk)))

;;; land the conjuncts of IS-ABELIAN-GROUP(g) and IS-GROUP(g)
(define (qg-ag-open!)
  (qg-or-asm '(IS-GROUP g) (lambda () (dk-cite! 'abelian-group-is-group 'g)))
  (qg-or-asm '(IN (OPR g) (FUN (CARTESIAN (CARR g) (CARR g)) (CARR g)))
    (lambda ()
      (let* ((iff (dk-cite! 'is-abelian-group 'g)) (rhs (dk-meta-iff-r! iff)))
        (dk-split-all! (list (dk-ctx-form rhs)))))))
;;; (IN ZZ-RING SET) and IS-RING(ZZ-RING), so the tuple AG-ZZ-MODULE(g) denotes
(define (qg-zzring!)
  (qg-or-asm '(IS-RING ZZ-RING) (lambda () (fact 'zz-is-ring)))
  (qg-or-asm '(IN ZZ-RING SET)
    (lambda ()
      (let ((iff (dk-meta-iff! 'ring-class 'ZZ-RING)))
        (dk-meta-iff-l! iff)
        (fact 'membership-implies-sethood 'ZZ-RING 'RING))))
  (qg-or-asm '(== (CARR ZZ-RING) ZZ) (lambda () (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))))
;;; type an element expression of g (OPR, INV, IDEN, ZZ-ACT at an integer typed in context)
(define (qg-ct x)
  (let ((want (list 'IN x '(CARR g))))
    (cond ((dk-asm? want) x)
          ((equal? x '(IDEN g)) (dk-cite! 'group-identity-in 'g) x)
          ((and (pair? x) (equal? (car x) '(OPR g)))
           (qg-ct (cadr x)) (qg-ct (caddr x)) (dk-cite! 'group-carrier-closed-opr 'g (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(INV g)))
           (qg-ct (cadr x)) (dk-cite! 'group-inv-in 'g (cadr x)) x)
          ((and (pair? x) (eq? (car x) 'ZZ-ACT))
           (qg-ct (cadddr x)) (dk-cite! 'zz-act-type 'g (caddr x) (cadddr x)) x)
          (#t (error "qg-ct: cannot type" (expression->string x))))))

;;; =====================================================================
;;; (1) The read-offs of AG-ZZ-MODULE(g).
;;; =====================================================================
(define QG-LAM '(VNB-LAMBDA (LIST azk_ aza_) (CARTESIAN ZZ (CARR g)) (ZZ-ACT g azk_ aza_)))
(define (qg-agm-read-off! name acc val)
  (dk-sp-qed! (make-wff (qg-ag `(== (,acc ,QG-M) ,val)))
    (lambda ()
      (dk-peel!)
      (qg-ag-open!)
      (qg-zzring!)
      (slot acc)
      (mac 'AG-ZZ-MODULE)
      (let loop ((fuel 10))
        (if (and (> fuel 0) (not (proof-done? *ps*)) (qg-has-head? 'NTH (dk-goal)))
            (begin (nth-r) (loop (- fuel 1)))))
      (if (not (proof-done? *ps*)) (qrfl)))
    name))
(qg-agm-read-off! 'agm-scal 'SCAL 'ZZ-RING)
(qg-agm-read-off! 'agm-vec 'VEC '(CARR g))
(qg-agm-read-off! 'agm-vadd 'VADD '(OPR g))
(qg-agm-read-off! 'agm-vzero 'VZERO '(IDEN g))
(qg-agm-read-off! 'agm-vneg 'VNEG '(INV g))
(qg-agm-read-off! 'agm-act 'ACT QG-LAM)

;;; the action as a function, and its value: k.a = ZZ-ACT(g, k, a)
(sp (make-wff (qg-ag `(IN (ACT ,QG-M) (FUN (CARTESIAN ZZ (CARR g)) (CARR g))))))
(dk-peel!)
(qg-ag-open!)
(subst (dk-cite! 'agm-act 'g))
(dk-lam-type! (lambda ()
  (let* ((lk (dk-peel!)) (g0 (dk-goal)) (body (cadr g0)))
    (qg-ct body)
    (dk-close-if-asm!))))
(dk-close-if-asm!)
(qg-done! 'agm-act-fun)

(sp (make-wff (qg-ag `(FORALL k (IMPLIES (IN k ZZ) (FORALL a (IMPLIES (IN a (CARR g))
  (= ((ACT ,QG-M) k a) (ZZ-ACT g k a)))))))))
(dk-peel!)
(qg-ag-open!)
(qg-ct '(ZZ-ACT g k a))
(subst (dk-cite! 'agm-act 'g))
(dk-lam-b!)
