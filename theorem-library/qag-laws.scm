(if (not (proof-done? *ps*)) (rfl))
(qg-done! 'agm-act-value)

;;; =====================================================================
;;; (2) Every abelian group is a ZZ-module.
;;; =====================================================================
;;; rewrite every application ((ACT M) k a) in the goal by agm-act-value, innermost first
(define (qg-act-app? t) (and (pair? t) (equal? (car t) (list 'ACT QG-M)) (= (length t) 3)))
(define (qg-find-act t)
  (cond ((not (pair? t)) #f)
        ((and (qg-act-app? t) (not (qg-find-act (cadr t))) (not (qg-find-act (caddr t)))) t)
        (#t (or (qg-find-act (car t)) (qg-find-act (cdr t))))))
(define (qg-act-values!)
  (let loop ((fuel 8))
    (let ((t (qg-find-act (dk-goal))))
      (if (and t (> fuel 0))
          (begin
            (qg-ct (caddr t))
            (subst (dk-cite! 'agm-act-value 'g (cadr t) (caddr t)))
            (loop (- fuel 1)))))))
(define (qg-zz! t)                       ; (IN t ZZ) for + / * of integers typed in context
  (let ((want (list 'IN t 'ZZ)))
    (cond ((dk-asm? want) #t)
          ((and (pair? t) (memq (car t) '(+ *)))
           (qg-zz! (cadr t)) (qg-zz! (caddr t))
           (dk-have-and! (list 'IN (cadr t) 'ZZ) (list 'IN (caddr t) 'ZZ))
           (dk-cite! (if (eq? (car t) '+) 'zz-add-closed 'zz-mul-closed) (cadr t) (caddr t)))
          (#t (dk-have! want (lambda () (from-context!)))))))
(define (qg-law!)
  (let* ((lk (dk-peel!)) (g0 (dk-goal)) (lhs (cadr g0)) (sc (cadr lhs)) (a (caddr lhs)))
    (cond
      ((and (pair? sc) (equal? (car sc) '(ADD ZZ-RING)))
       (subst (dk-cite! 'zz-ring-add-is-add (cadr sc) (caddr sc)))
       (qg-zz! (list '+ (cadr sc) (caddr sc)))
       (qg-act-values!)
       (dk-cite! 'zz-act-add 'g (cadr sc) (caddr sc) a)
       (dk-close-if-asm!))
      ((and (pair? sc) (equal? (car sc) '(MUL ZZ-RING)))
       (subst (dk-cite! 'zz-ring-mul-is-mul (cadr sc) (caddr sc)))
       (qg-zz! (list '* (cadr sc) (caddr sc)))
       (qg-act-values!)
       (dk-cite! 'zz-act-assoc 'g (cadr sc) (caddr sc) a)
       (dk-close-if-asm!))
      ((equal? sc '(ONE ZZ-RING))
       (subst (qg-one-eq!))
       (qg-zz! 1)
       (qg-act-values!)
       (dk-cite! 'zz-act-one 'g a)
       (dk-close-if-asm!))
      (#t
       (qg-ct a)
       (qg-act-values!)
       (dk-cite! 'zz-act-distrib 'g sc (cadr a) (caddr a))
       (dk-close-if-asm!)))))
(define (qg-one-eq!)
  (if (not (dk-asm? '(== (ONE ZZ-RING) 1))) (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl))))
  '(== (ONE ZZ-RING) 1))

(sp (make-wff (qg-ag `(IS-MODULE ,QG-M))))
(dk-peel!)
(qg-ag-open!)
(qg-zzring!)
(dk-cite! 'agm-act-fun 'g)
(mac 'IS-MODULE)
(dk-isx-set!)   ; W1J-B: the conjunct t in SET, from the typings
(for-each (lambda (n) (subst (dk-cite! n 'g))) '(agm-scal agm-vec agm-vadd agm-vzero agm-vneg))
(subst '(== (CARR ZZ-RING) ZZ))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond ((dk-asm? g0) (ass))
            ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
             (mac 'AG-ZZ-MODULE)
             (dk-close-if! (lambda () (len-r)) (lambda () (arith))))
            ((dk-head-is? g0 'FORALL) (qg-law!))
            (#t (error "ag-zz-module-is-module: unexpected conjunct" (expression->string g0)))))))
(qg-done! 'ag-zz-module-is-module)
(gloss! 'ag-zz-module-is-module "Every abelian group is a Z-module, the action of k being the k-th multiple (ZZ-ACT).")

;;; =====================================================================
;;; (3) A subgroup is closed under the integer action, so it is a submodule.
;;; =====================================================================
(define QG-SUB-OPR '(FORALL sga_ (IMPLIES (IN sga_ h) (FORALL sgb_ (IMPLIES (IN sgb_ h) (IN ((OPR g) sga_ sgb_) h))))))
(define QG-SUB-INV '(FORALL sga_ (IMPLIES (IN sga_ h) (IN ((INV g) sga_) h))))
(define (qg-sub-open!)
  (qg-or-asm '(SUBSET h (CARR g))
    (lambda ()
      (let* ((iff (dk-cite! 'is-subgroup 'g 'h)) (rhs (dk-meta-iff-r! iff)))
        (dk-split-all! (list (dk-ctx-form rhs)))))))
(define (qg-sub-carr! a)                 ; a in h  =>  a in CARR g
  (qg-or-asm (list 'IN a '(CARR g)) (lambda () (dk-cite! 'subset-mem-fwd 'h '(CARR g) a))))
(define (qg-sub-opr! a b) (qg-or-asm (list 'IN (qg-op a b) 'h) (lambda () (dk-apply! (dk-ctx-form QG-SUB-OPR) a b))))
(define (qg-sub-inv! a) (qg-or-asm (list 'IN (qg-inv a) 'h) (lambda () (dk-apply! (dk-ctx-form QG-SUB-INV) a))))

(sp (make-wff `(FORALL n (IMPLIES (IN n NN) ,(qg-agh '(FORALL a (IMPLIES (IN a h) (IN (ZZ-ACT g n a) h))))))))
(let* ((ind (dk-use-induction-fixed! '(g h))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, h fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (qg-ag-open!) (qg-sub-open!) (qg-sub-carr! 'a)
  (subst (dk-cite! 'zz-act-zero 'g 'a))
  (dk-close-if-asm!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (qg-ag-open!) (qg-sub-open!) (qg-sub-carr! 'a)
  (dk-apply! ih 'a)   ; W1G-B: g, h fixed
  (dk-cite! 'nn-subset-zz n)
  (qg-zz! 1)
  (subst (dk-cite! 'nn-succ-plus-one n))
  (subst (dk-cite! 'zz-act-add 'g n 1 'a))
  (subst (dk-cite! 'zz-act-one 'g 'a))
  (qg-sub-opr! (list 'ZZ-ACT 'g n 'a) 'a)
  (dk-close-if-asm!))
(qg-done! 'ag-subgroup-zz-act-nn)

(sp (make-wff (qg-agh '(FORALL k (IMPLIES (IN k ZZ) (FORALL a (IMPLIES (IN a h) (IN (ZZ-ACT g k a) h))))))))
(dk-peel!)
(qg-ag-open!) (qg-sub-open!) (qg-sub-carr! 'a)
(let* ((ex (dk-cite! 'zz-generated-by-nn 'k))
       (n (dk-skolem! ex))
       (o (find-first (lambda (f) (and (dk-head-is? f 'OR) (qg-has-head? 'k f))) (dk-asms))))
  (dk-cite! 'ag-subgroup-zz-act-nn n 'g 'h 'a)
  (dk-cite! 'nn-subset-zz n)
  (dk-or-each! o
    (lambda (d)
      (subst d)
      (if (equal? (caddr d) n)
          (dk-close-if-asm!)
          (begin
            (subst (dk-cite! 'zz-act-neg-sign 'g n 'a))
            (qg-sub-inv! (list 'ZZ-ACT 'g n 'a))
            (dk-close-if-asm!))))))
(qg-done! 'ag-subgroup-zz-act)

(sp (make-wff (qg-agh `(IS-SUBMODULE ,QG-M h))))
(dk-peel!)
(qg-ag-open!) (qg-sub-open!) (qg-zzring!)
(mac 'IS-SUBMODULE)
(for-each (lambda (n) (subst (dk-cite! n 'g))) '(agm-scal agm-vec agm-vadd agm-vzero agm-vneg))
(subst '(== (CARR ZZ-RING) ZZ))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond ((dk-ctx-form g0) (ass))
            ((dk-head-is? g0 'FORALL)
             (let* ((lk (dk-peel!)) (t (cadr (dk-goal))))
               (qg-sub-carr! (caddr t))
               (dk-cite! 'ag-subgroup-zz-act 'g 'h (cadr t) (caddr t))
               (qg-act-values!)
               (dk-close-if-asm!)))
            (#t (error "ag-subgroup-submodule: unexpected conjunct" (expression->string g0)))))))
(qg-done! 'ag-subgroup-submodule)

