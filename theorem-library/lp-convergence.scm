;;; md-lp.scm -- construction-of-measures.pdf Corollary 2.29: dominated convergence in L^p (1 <= p < inf).
;;; Agent M-D (worker-02), 2026-10-28.  DESTINATION: theorem-library/lp-convergence.scm.  Library: measure.
;;; Helper prefix: mdl-.  Load window: after lp-seminorm.scm (LP-NORM laws), integral-convergence.scm
;;; (dominated-convergence), lp-inequalities.scm (EPOW).
;;; The tree's dominated-convergence is the everywhere form on [0, +inf]-valued functions with ECONVERGES-TO; the
;;; notes' almost-everywhere hypotheses are reduced to it by cutting the functions down to 0 on one measurable null set.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mdl-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MDL OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mdl-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mdl-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mdl-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mdl-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (mdl-tree-sub x y s)) t)) (#t t)))
(define (mdl-mark! . xs)
  (let ((port (open-output-file "/tmp/mdl-trace.txt" #t)))
    (for-each (lambda (x) (write-string (if (string? x) x (expression->string x)) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mdl-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mdl-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mdl-has-lam? (car l)) (loop (cdr l))))))))
(define (mdl-beta!) (if (mdl-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mdl-pos-parts! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mdl-posrr! e)                 ; (IN e RR), (< 0 e): (POS-RR e)
  (let ((g (list 'POS-RR e)))
    (if (not (dk-asm? g))
        (begin
          (dk-project! (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))) (lambda () (mac-h '< (dk-ctx-form (list '< 0 e)))))
          (dk-split-all! (list (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e)))))
          (dk-have! g (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))))
    g))
(define (mdl-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))

;;; ---------------------------------------------------------------------------
;;; (1) small facts on [0, +inf]
;;; ---------------------------------------------------------------------------
;; a point of [0, +inf] below every positive real is 0
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR) (IMPLIES (FORALL r (IMPLIES (POS-RR r) (<= x r))) (= x 0))))))
(dk-peel!)
(fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(mdl-posrr! 1)
(dk-apply! (dk-ctx-form '(FORALL r (IMPLIES (POS-RR r) (<= x r)))) 1)
(let ((mi (dk-cite! 'rr-pos-star-membership 'x)))
  (dk-have! (caddr mi) (lambda () (if (dk-only! mi '(IN x RR-POS-STAR)) (prop))))
  (dk-have! '(IN x RR)
    (lambda () (pbc)
               (dk-have! '(= x POS-INF) (lambda () (if (dk-only! (caddr mi) '(NOT (IN x RR))) (prop))))
               (dk-cite! 'pos-inf-above-reals 1)
               (dk-have! '(<= POS-INF 1) (lambda () (subst '(= POS-INF x)) (dk-ass!)))
               (ai '(NOT (<= POS-INF 1))))))
(dk-cite! 'rr-pos-star-nonneg 'x)
(pbc)
(dk-have! '(< 0 x) (lambda () (mac '<) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (di) (dk-have! '(= x 0) (lambda () (dk-ineq! '(IN x RR) '(= 0 x)))) (ai '(NOT (= x 0)))))))))
(let ((h '(* 1/2 x)))
  (dk-have! (list 'IN h 'RR) (lambda () (dk-type! h)))
  (dk-have! (list '< 0 h) (lambda () (dk-ineq! '(IN x RR) '(< 0 x))))
  (mdl-posrr! h)
  (dk-apply! (dk-ctx-form '(FORALL r (IMPLIES (POS-RR r) (<= x r)))) h)
  (dk-absurd! '(IN x RR) (list '<= 'x h) '(< 0 x)))
(mdl-qed! 'rps-below-all-positive-zero)

;; a real sequence of nonnegative terms, eventually below every positive real, converges to 0 in [0, +inf]
(define mdl-small '(FORALL r (IMPLIES (POS-RR r) (FORSOME nb (AND (IN nb NN) (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= nb k) (<= (a k) r)))))))))
(sp (make-wff (mdl-alls '(a) (mdl-imps (list '(IN a (FUN NN RR)) '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k)))) mdl-small) '(ECONVERGES-TO a 0)))))
(dk-peel!)
(fact 'nn-is-set)
(dk-have! '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (IN (a cpsk_) RR))) (lambda () (let ((k (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'a 'NN 'RR k) (dk-ass!))))
(dk-have! '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (<= 0 (a cpsk_)))) (lambda () (let ((k (dk-di-var!))) (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))) k) (dk-ass!))))
(dk-cite! 'elimsup-in-rr-pos-star 'a)
(dk-cite! 'eliminf-in-rr-pos-star 'a)
(dk-have! '(IN a (FUN NN RR-POS-STAR))
  (lambda () (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR-POS-STAR 'a)) (fr (dk-cite! 'fun-codomain-iff 'NN 'RR 'a)))
               (dk-have! (caddr fr) (lambda () (if (dk-only! fr '(IN a (FUN NN RR))) (prop))))
               (mdl-split! (caddr fr))
               (dk-have! '(FORALL x (IMPLIES (IN x NN) (IN (a x) RR-POS-STAR)))
                 (lambda () (let ((k (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'a 'NN 'RR k)
                              (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))) k)
                              (mdl-rps! (list 'a k)) (dk-ass!))))
               (mdl-and! '(IN a (FUN NN)) '(FORALL x (IMPLIES (IN x NN) (IN (a x) RR-POS-STAR))))
               (if (dk-only! fi (caddr fi)) (prop)))))
(dk-have! '(FORALL r (IMPLIES (POS-RR r) (<= (ELIMSUP a) r)))
  (lambda () (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
               (mdl-pos-parts! r)
               (let ((nb (dk-skolem! (dk-apply! (dk-ctx-form mdl-small) r) #t)))
                 (dk-cite! 'elimsup-eventually-le 'a)
                 (dk-apply! (dk-ctx-form '(FORALL rtpr_ (IMPLIES (IN rtpr_ RR) (FORALL rtpn_ (IMPLIES (IN rtpn_ NN)
                              (IMPLIES (FORALL k_ (IMPLIES (IN k_ NN) (IMPLIES (<= rtpn_ k_) (<= (a k_) rtpr_)))) (<= (ELIMSUP a) rtpr_)))))))
                            r nb)
                 (dk-ass!)))))
(dk-cite! 'rps-below-all-positive-zero '(ELIMSUP a))
(dk-cite! 'eliminf-le-elimsup 'a)
(dk-have! '(FORALL r (IMPLIES (POS-RR r) (<= (ELIMINF a) r)))
  (lambda () (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
               (mdl-pos-parts! r)
               (dk-have! '(<= (ELIMINF a) 0) (lambda () (subst '(= 0 (ELIMSUP a))) (dk-ass!)))
               (fact 'rr-zero-in) (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
               (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
               (mdl-rps! 0) (mdl-rps! r)
               (mdl-and! '(IN (ELIMINF a) RR-POS-STAR) '(IN 0 RR-POS-STAR) (list 'IN r 'RR-POS-STAR))
               (mdl-and! '(<= (ELIMINF a) 0) (list '<= 0 r))
               (dk-cite! 'rr-pos-star-le-trans '(ELIMINF a) 0 r)
               (dk-ass!))))
(dk-cite! 'rps-below-all-positive-zero '(ELIMINF a))
(mac 'econverges-to)
(fact 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(mdl-rps! 0)
(dk-conj-close! (lambda () (dk-ass!)))
(mdl-qed! 'econverges-of-eventually-small)

;; t |-> t^q (q > 0) preserves convergence to 0 of a nonnegative real sequence
(define mdl-b '(VNB-LAMBDA k NN (epow (a k) q)))
(sp (make-wff (mdl-alls '(a q) (mdl-imps (list '(IN a (FUN NN RR)) '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k)))) '(ECONVERGES-TO a 0) '(IN q RR) '(< 0 q))
   (list 'ECONVERGES-TO mdl-b 0)))))
(dk-peel!)
(fact 'nn-is-set)
(fact 'rr-zero-in)
(define (mdl-ak! k)                    ; a(k) real, nonneg, in RPS; b(k) = epow(a k, q) real nonneg
  (dk-cite! 'fun-apply-type-c 'a 'NN 'RR k)
  (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))) k)
  (mdl-rps! (list 'a k))
  (mdl-split! (dk-apply! (dk-cite! 'epow-real-in (list 'a k)) 'q)))
(dk-have! (list 'IN mdl-b '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-ak! k) (dk-ass!))) (lambda () (dk-ass!)))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= 0 (list mdl-b 'k))))
  (lambda () (let ((k (dk-di-var!))) (mdl-ak! k) (mdl-beta!) (dk-ass!))))
(dk-project! '(= (ELIMSUP a) 0) 'econverges-to '(ECONVERGES-TO a 0))
(dk-have! (mdl-tree-sub 'a mdl-b mdl-small)
  (lambda ()
    (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld)))
           (rq '(recip q)) (s (list 'epow r rq)))
      (mdl-pos-parts! r)
      (dk-have! '(NOT (= q 0)) (lambda () (di) (dk-absurd! '(IN q RR) '(= q 0) '(< 0 q))))
      (mdl-and! '(IN q RR) '(NOT (= q 0)))
      (dk-cite! 'rr-recip-closed 'q)
      (mdl-split! (dk-apply! (dk-cite! 'epow-pos-real r) rq))
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
      (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< 0 s))))
      (mdl-rps! r) (mdl-rps! s)
      (dk-cite! 'rr-recip-pos 'q)
      (mdl-split! (dk-cite! 'epow-inverse r 'q))
      (dk-have! '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (IN (a cpsk_) RR))) (lambda () (let ((k (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'a 'NN 'RR k) (dk-ass!))))
      (dk-have! '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (<= 0 (a cpsk_)))) (lambda () (let ((k (dk-di-var!))) (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))) k) (dk-ass!))))
      (dk-have! (list '< '(ELIMSUP a) s) (lambda () (subst '(= (ELIMSUP a) 0)) (dk-ass!)))
      (let* ((ev (dk-apply! (dk-cite! 'elimsup-eventually-below 'a) s))
             (nb (dk-skolem! ev #t))
             (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h s))) "the tail")))
        (ew nb)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((g (begin (dk-peel!) (dk-goal))) (k (cadr (cadr g))))
                  (mdl-ak! k)
                  (mdl-beta!)
                  (dk-apply! (dk-ctx-form cl) k)
                  (dk-have! (list '<= (list 'a k) s) (lambda () (dk-ineq! (list 'IN (list 'a k) 'RR) (list 'IN s 'RR) (list '< (list 'a k) s))))
                  (let ((mo (dk-cite! 'epow-mono (list 'a k) s 'q)))
                    (dk-rewrite-h! mo (list 'epow s 'q) r))
                  (dk-ass!)))))))))
(dk-cite! 'econverges-of-eventually-small mdl-b)
(dk-ass!)
(mdl-qed! 'epow-econverges-zero)

;;; ---------------------------------------------------------------------------
;;; (2) null sets
;;; ---------------------------------------------------------------------------
(define (mdl-rps-zero! t)              ; (IN t RR-POS-STAR), (<= t 0) in context: (= t 0)
  (dk-have! (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list '<= t 'r)))
    (lambda () (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
                 (mdl-pos-parts! r)
                 (fact 'rr-zero-in) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))) (mdl-rps! 0)
                 (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r)))) (mdl-rps! r)
                 (mdl-and! (list 'IN t 'RR-POS-STAR) '(IN 0 RR-POS-STAR) (list 'IN r 'RR-POS-STAR))
                 (mdl-and! (list '<= t 0) (list '<= 0 r))
                 (dk-cite! 'rr-pos-star-le-trans t 0 r)
                 (dk-ass!))))
  (dk-cite! 'rps-below-all-positive-zero t))
(define (mdl-mu! a) (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR a))
(sp (make-wff (mdl-alls '(omega ca mu a b) (mdl-imps '((IS-MEASURE omega ca mu) (IN a ca) (IN b ca) (= (mu a) 0) (= (mu b) 0))
   '(AND (IN (UNION a b) ca) (= (mu (UNION a b)) 0))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-cite! 'sigma-algebra-union-closed-2 'omega 'ca 'a 'b)
(let* ((q '(VNB-LAMBDA mdn_ NN (IF (= mdn_ 0) a b)))
       (bu (list 'BIG-UNION 'n_ 'NN (list q 'n_)))
       (mq (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list q 'n_)))))
  (dk-have! (list 'IN q '(FUN NN ca))
    (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (dk-case-if! (list 'IF (list '= n 0) 'a 'b) (lambda (t? v) (dk-ass!))))) (lambda () (dk-ass!)))))
  (dk-cite! 'sigma-algebra-union-closed 'omega 'ca q)
  (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list mq 'ozn) 0)))
    (lambda () (let ((n (dk-di-var!)))
                 (dk-cite! 'fun-apply-type-c q 'NN 'ca n)
                 (mdl-mu! (list q n))
                 (mdl-beta!)
                 (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                     (dk-case-if! (list 'IF (list '= n 0) 'a 'b) (lambda (t? v) (dk-ass!)))))))
  (dk-have! (list 'IN mq '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (dk-cite! 'fun-apply-type-c q 'NN 'ca n) (mdl-mu! (list q n)) (dk-ass!))) (lambda () (dk-ass!)))))
  (dk-cite! 'esum-nn-zero mq)
  (let ((cs (dk-cite! 'measure-countably-subadditive 'omega 'ca 'mu q)))
    (mdl-mu! bu)
    (dk-rewrite-h! cs (list 'ESUM mq) 0))
  (dk-have! (list 'SUBSET '(UNION a b) bu)
    (lambda () (mac 'subset-def)
               (let* ((z (dk-di-var!)) (um (dk-cite! 'union-membership 'a 'b z)))
                 (dk-have! (caddr um) (lambda () (if (dk-only! um (list 'IN z '(UNION a b))) (prop))))
                 (fact 'nn-zero-in) (fact 'nn-one-in)
                 (dk-cite! 'nn-in-rr 0) (dk-cite! 'nn-in-rr 1)
                 (let ((e0 (list '= (list q 0) 'a)) (e1 (list '= (list q 1) 'b)))
                   (dk-have! e0 (lambda () (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                                          (dk-if-branch! #t (list 'IF '(= 0 0) 'a 'b) (lambda () (rfl)) (lambda () (if (not (dk-ass!)) (rfl)))))))
                   (dk-have! e1 (lambda () (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                                          (dk-if-branch! #f (list 'IF '(= 1 0) 'a 'b) (lambda () (di) (dk-absurd! '(IN 1 RR) '(= 1 0))) (lambda () (if (not (dk-ass!)) (rfl)))))))
                   (use-em (list 'IN z 'a)
                     (lambda () (for-each (lambda (l) (dk-focus! l) (if (not (dk-ass!)) (begin (subst e0) (dk-ass!)))) (dk-opened (lambda () (bu-mi 0)))))
                     (lambda () (dk-have! (list 'IN z 'b) (lambda () (if (dk-only! (caddr um) (list 'NOT (list 'IN z 'a))) (prop))))
                                (for-each (lambda (l) (dk-focus! l) (if (not (dk-ass!)) (begin (subst e1) (dk-ass!)))) (dk-opened (lambda () (bu-mi 1))))))))))
  (dk-cite! 'measure-monotone 'omega 'ca 'mu '(UNION a b) bu)
  (mdl-rps-zero! (list 'mu bu))
  (mdl-mu! '(UNION a b))
  (dk-have! (list '<= '(mu (UNION a b)) 0) (lambda () (subst (list '= 0 (list 'mu bu))) (dk-ass!)))
  (mdl-rps-zero! '(mu (UNION a b)))
  (dk-conj-close! (lambda () (dk-ass!))))
(mdl-qed! 'measure-null-union-2)

;;; ---------------------------------------------------------------------------
;;; (3) the countably many almost-everywhere hypotheses hold together off ONE measurable null set
;;; ---------------------------------------------------------------------------
(define (mdl-domk k x) (list '<= (list 'abs (list (list 'fs k) x)) (list 'g x)))
(define (mdl-off b P) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x b)) P))))
(define mdl-dom (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb) (mdl-off 'nb (mdl-domk 'k 'x)))))))
(define mdl-cvx '(CONVERGES-TO RR-MS (VNB-LAMBDA k NN ((fs k) x)) (f x)))
(define mdl-conv (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb) (mdl-off 'nb mdl-cvx))))
(define mdl-good (list 'AND (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mdl-domk 'k 'x))) mdl-cvx))
(define (mdl-sepk k) (list 'SEP 'mdb_ 'ca (list 'AND '(= (mu mdb_) 0) (mdl-off 'mdb_ (mdl-domk k 'x)))))
(define mdl-Bf (list 'VNB-LAMBDA 'mdk_ 'NN (list 'CHOICE (mdl-sepk 'mdk_))))
(define (mdl-null-out! nb)             ; (IS-NULL-SET omega ca mu nb): a measurable cover; returns it
  (let* ((ex2 (mdl-tree-sub 'mdnb nb '(FORSOME nla_ (AND (IN nla_ ca) (AND (SUBSET mdnb nla_) (= (mu nla_) 0))))))
         (ex (dk-project! ex2 'is-null-set (list 'IS-NULL-SET 'omega 'ca 'mu nb))))
    (dk-skolem! (dk-ctx-form ex2) #t)))
(sp (make-wff (mdl-alls '(omega ca mu fs f g) (mdl-imps (list '(IS-MEASURE omega ca mu) mdl-dom mdl-conv)
   (list 'FORSOME 'mda_ (list 'AND '(IN mda_ ca) (list 'AND '(= (mu mda_) 0) (mdl-off 'mda_ mdl-good))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(define (mdl-bk! k)                    ; k in NN: CHOICE(sepk k) in sepk k, in ca, mu 0, the domination off it
  (let* ((sk (mdl-sepk k)) (c (list 'CHOICE sk)))
    (if (not (dk-asm? (list 'IN c 'ca)))
        (begin
          (let* ((nb (dk-skolem! (dk-apply! (dk-ctx-form mdl-dom) k) #t))
                 (cv (mdl-null-out! nb)))
            (choose-mem! sk cv
              (lambda ()
                (in-sep! (lambda () (dk-ass!))
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let* ((x (dk-di-var!)))
                              (di)
                              (dk-have! (list 'NOT (list 'IN x nb)) (lambda () (di) (dk-cite! 'subset-mem-fwd nb cv x) (ai (list 'NOT (list 'IN x cv)))))
                              (dk-apply! (dk-ctx-form (mdl-off nb (mdl-domk k 'x))) x)
                              (dk-ass!))))))))))
          (sep-me (dk-ctx-form (list 'IN c sk)))
          (dk-split-all!)))
    c))
(dk-have! (list 'IN mdl-Bf '(FUN NN ca))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-bk! k) (dk-ass!))) (lambda () (dk-ass!)))))
(define (mdl-bfv! k)                   ; (= (Bf k) (CHOICE (sepk k)))
  (let* ((c (mdl-bk! k)) (e (list '= (list mdl-Bf k) c)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(let* ((u (list 'BIG-UNION 'n_ 'NN (list mdl-Bf 'n_)))
       (mq (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list mdl-Bf 'n_)))))
