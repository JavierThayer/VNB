(define (mdl-good! off x)              ; x in omega, not in A: domination, convergence and |f x| <= g x at x; returns the sequence
  (let ((u (list 'VNB-LAMBDA 'k 'NN (list '(fs k) x))))
    (if (not (dk-asm? (list '<= (list 'abs (list 'f x)) (list 'g x))))
        (begin
          (mdl-split! (dk-apply! (dk-ctx-form off) x))
          (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x) (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
          (dk-have! (list 'IN u '(FUN NN RR))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-fk! k) (dk-cite! 'fun-apply-type-c (list 'fs k) 'omega 'RR x) (dk-ass!))) (lambda () (dk-ass!)))))
          (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '<= (list 'abs (list u 'n_)) (list 'g x))))
            (lambda () (let ((k (dk-di-var!)))
                         (mdl-fk! k) (dk-cite! 'fun-apply-type-c (list 'fs k) 'omega 'RR x)
                         (mdl-beta!)
                         (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mdl-domk 'k x)))) k)
                         (dk-ass!))))
          (dk-cite! 'rr-limit-abs-le u (list 'f x) (list 'g x))))
    u))
(define (mdl-hx! A k x)                ; (= (h_k x) (etimes (ind x) (phi_k x)))
  (let ((e (list '= (list (mdl-h A k) x) (list 'etimes (list (mdl-ind A) x) (list (mdl-phi k) x))))
        (ind (mdl-ind A)))
    (if (not (dk-asm? (list 'IN ind '(FUN omega RR-POS-STAR))))
        (dk-project! (list 'IN ind '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca ind)))
    (mdl-phik! k)
    (dk-cite! 'fun-apply-type-c ind 'omega 'RR-POS-STAR x)
    (dk-cite! 'fun-apply-type-c (mdl-phi k) 'omega 'RR-POS-STAR x)
    (mdl-and! (list 'IN (list ind x) 'RR-POS-STAR) (list 'IN (list (mdl-phi k) x) 'RR-POS-STAR))
    (dk-cite! 'etimes-closed (list ind x) (list (mdl-phi k) x))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mac 'PTWISE-ETIMES) (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(define (mdl-ind-in! A x)              ; x in omega, not in A: (= (ind x) 1)
  (let* ((Ac (list 'COMPLEMENT-IN 'omega A)) (cm (dk-cite! 'complement-in-membership 'omega A x)))
    (mdl-and! (list 'IN x 'omega) (list 'NOT (list 'IN x A)))
    (if (not (dk-asm? (list 'IN x Ac))) (dk-have! (list 'IN x Ac) (lambda () (if (dk-only! cm (caddr cm)) (prop)))))
    (dk-cite! 'indicator-value-in 'omega Ac x)))
(define (mdl-ind-out! A x)             ; x in A: (= (ind x) 0)
  (let* ((Ac (list 'COMPLEMENT-IN 'omega A)) (cm (dk-cite! 'complement-in-membership 'omega A x)))
    (if (not (dk-asm? (list 'NOT (list 'IN x Ac))))
        (dk-have! (list 'NOT (list 'IN x Ac))
          (lambda () (di) (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN x Ac)) (prop))))
                     (mdl-split! (caddr cm)) (ai (list 'NOT (list 'IN x A))))))
    (dk-cite! 'indicator-value-out 'omega Ac x)))
(define (mdl-cfv! A k)                 ; (= (cf k) (h_k))
  (let ((e (list '= (list (mdl-cf A) k) (mdl-h A k))))
    (mdl-hk! A k)
    (if (not (dk-asm? (list 'IN (mdl-h A k) 'SET))) (dk-cite! 'membership-implies-sethood (mdl-h A k) '(FUN omega RR-POS-STAR)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(define (mdl-hk! A k)                  ; h_k measurable, typed
  (mdl-phik! k)
  (if (not (dk-asm? (list 'IS-MEASURABLE-FN 'omega 'ca (mdl-h A k))))
      (begin
        (dk-cite! 'measurable-fn-etimes 'omega 'ca (mdl-ind A) (mdl-phi k))
        (dk-project! (list 'IN (mdl-h A k) '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca (mdl-h A k))))))
(define (mdl-hval-off! A off k x)      ; x not in A: (= (h_k x) v), v = |fs_k x - f x|^p, returns v
  (let ((v (mdl-xv! k x)))
    (mdl-hk! A k)
    (dk-cite! 'fun-apply-type-c (mdl-phi k) 'omega 'RR-POS-STAR x)
    (mdl-ind-in! A x)
    (dk-cite! 'etimes-one-left (list (mdl-phi k) x))
    (let ((e (list '= (list (mdl-h A k) x) v)))
      (if (not (dk-asm? e))
          (dk-have! e (lambda () (subst (mdl-hx! A k x)) (subst (list '= (list (mdl-ind A) x) 1))
                                 (subst (list '= (list 'etimes 1 (list (mdl-phi k) x)) (list (mdl-phi k) x)))
                                 (subst (list '= (list (mdl-phi k) x) v)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      v)))
(define (mdl-hval-in! A k x)           ; x in A: (= (h_k x) 0)
  (mdl-phik! k)
  (mdl-hk! A k)
  (dk-cite! 'fun-apply-type-c (mdl-phi k) 'omega 'RR-POS-STAR x)
  (mdl-ind-out! A x)
  (dk-cite! 'etimes-zero-left (list (mdl-phi k) x))
  (let ((e (list '= (list (mdl-h A k) x) 0)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (subst (mdl-hx! A k x)) (subst (list '= (list (mdl-ind A) x) 0))
                               (subst (list '= (list 'etimes 0 (list (mdl-phi k) x)) 0)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(define (mdl-le-G! A off k x)          ; x not in A: (<= v (G x)) with v the value of h_k at x
  (let* ((v (mdl-hval-off! A off k x)) (gv (mdl-gx! x)))
    (mdl-good! off x)
    (mdl-fk! k) (dk-cite! 'fun-apply-type-c (list 'fs k) 'omega 'RR x)
    (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mdl-domk 'k x)))) k)
    (dk-cite! 'epow-abs-diff-le (list (list 'fs k) x) (list 'f x) (list 'g x) 'p)
    (list v gv)))
(define (mdl-phi-le-G! A off k x)      ; x not in A: (<= (phi_k x) (G x))
  (let* ((vg (mdl-le-G! A off k x)) (v (car vg)) (gv (cadr vg)) (g (list '<= (list (mdl-phi k) x) (list mdl-G x))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (list (mdl-phi k) x) v)) (subst (list '= (list mdl-G x) gv)) (dk-ass!))))
    g))
(define (mdl-int-real! A off k)        ; (IN (INTEGRAL phi_k) RR)
  (let ((ik (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))))
    (if (not (dk-asm? (list 'IN ik 'RR)))
        (begin
          (mdl-phik! k)
          (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x A)) (list '<= (list (mdl-phi k) 'x) (list mdl-G 'x)))))
            (lambda () (let ((x (dk-di-var!))) (di) (mdl-phi-le-G! A off k x) (dk-ass!))))
          (dk-cite! 'integral-le-off-null 'omega 'ca 'mu A (mdl-phi k) mdl-G)
          (dk-cite! 'rps-below-real-is-real ik (list 'INTEGRAL 'omega 'ca 'mu mdl-G))))
    ik))
(define (mdl-int-eq! A off k)          ; (= (INTEGRAL h_k) (INTEGRAL phi_k))
  (mdl-hk! A k)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x A)) (list '= (list (mdl-h A k) 'x) (list (mdl-phi k) 'x)))))
    (lambda () (let ((x (dk-di-var!))) (di)
                 (let ((v (mdl-hval-off! A off k x)))
                   (subst (list '= (list (mdl-h A k) x) v)) (subst (list '= (list (mdl-phi k) x) v))
                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
  (dk-cite! 'integral-ae-eq 'omega 'ca 'mu A (mdl-h A k) (mdl-phi k)))
(define (mdl-Lval! k)                  ; ||d_k||_p == (integral phi_k)^(1/p), real
  (let* ((ik (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))) (v (list 'epow ik '(recip p))))
    (mdl-phik! k)
    (dk-cite! 'rr-pos-star-nonneg ik)
    (dk-cite! 'lp-norm-as-epow 'omega 'ca 'mu 'p (mdl-d k))
    v))
(define (mdl-f-real! A off)            ; (IN (LP-NORM f) RR)
  (let ((Ff '(PTWISE-EPOW omega (ABS-FN omega f) p)))
    (mdl-ph-meas! 'f)
    (dk-cite! 'abs-fn-fun 'omega 'f)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x A)) (list '<= (list Ff 'x) (list mdl-G0 'x)))))
      (lambda ()
        (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list 'g x)))
          (di)
          (mdl-good! off x)
          (mdl-gx! x)
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
          (dk-cite! 'rr-abs-closed fx) (dk-cite! 'rr-abs-nonneg fx) (dk-cite! 'rr-abs-closed gx) (dk-cite! 'rr-le-abs gx)
          (dk-have! (list '<= (list 'abs fx) (list 'abs gx)) (lambda () (dk-ineq! (list 'IN (list 'abs fx) 'RR) (list 'IN gx 'RR) (list 'IN (list 'abs gx) 'RR)
                                                                              (list '<= (list 'abs fx) gx) (list '<= gx (list 'abs gx)))))
          (mdl-rps! (list 'abs fx)) (mdl-rps! (list 'abs gx))
          (dk-cite! 'epow-mono (list 'abs fx) (list 'abs gx) 'p)
          (dk-cite! 'abs-fn-value 'omega 'f x)
          (dk-cite! 'ptwise-epow-value 'omega '(ABS-FN omega f) 'p x)
          (subst (list '= (list Ff x) (list 'epow (list '(ABS-FN omega f) x) 'p)))
          (subst (list '== (list '(ABS-FN omega f) x) (list 'abs fx)))
          (subst (list '= (list mdl-G0 x) (list 'epow (list 'abs gx) 'p)))
          (dk-ass!))))
    (dk-cite! 'integral-le-off-null 'omega 'ca 'mu A Ff mdl-G0)
    (dk-cite! 'rps-below-real-is-real (mdl-I 'f) (mdl-I 'g))
    (let ((fi (dk-cite! 'lp-norm-finite-iff 'omega 'ca 'mu 'p 'f)))
      (dk-have! '(IN (LP-NORM omega ca mu p f) RR) (lambda () (if (dk-only! fi (caddr fi)) (prop)))))))
;; one measurable null set off which all the hypotheses hold
(let* ((A (dk-skolem! (dk-cite! 'ae-hypotheses-common-null-set 'omega 'ca 'mu 'fs 'f 'g) #t))
       (off (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h A) (dk-contains? h 'CONVERGES-TO))) "the good clause"))
       (Ac (list 'COMPLEMENT-IN 'omega A)) (ind (mdl-ind A)) (cf (mdl-cf A))
       (P '(VNB-LAMBDA k NN (INTEGRAL omega ca mu (PTWISE-EPOW omega (ABS-FN omega (VNB-LAMBDA sx_ omega (- ((fs k) sx_) (f sx_)))) p)))))
  (dk-cite! 'sigma-algebra-complement-closed 'omega 'ca A)
  (dk-cite! 'measurable-fn-indicator 'omega 'ca Ac)
  (dk-cite! 'measurable-fn-const 'omega 'ca 0)
  (dk-cite! 'integral-zero-fn 'omega 'ca 'mu)
  (dk-project! (list 'IN mdl-Z '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca mdl-Z))
  ;; the sequence of cut-down functions
  (dk-have! (list 'IN cf '(FUN NN (FUN omega RR-POS-STAR)))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-hk! A k) (dk-ass!))) (lambda () (dk-ass!)))))
  ;; (cf n) = h_n
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cf 'n_))))
    (lambda () (let ((n (dk-di-var!))) (mdl-hk! A n) (subst (mdl-cfv! A n)) (dk-ass!))))
  ;; domination
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list cf 'n_) mdl-G)))
    (lambda ()
      (let ((n (dk-di-var!)))
        (subst (mdl-cfv! A n))
        (mac 'ptwise-le)
        (let ((x (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c mdl-G 'omega 'RR-POS-STAR x)
          (dk-cite! 'rr-pos-star-nonneg (list mdl-G x))
          (use-em (list 'IN x A)
            (lambda () (subst (mdl-hval-in! A n x)) (dk-ass!))
            (lambda () (let ((vg (mdl-le-G! A off n x)))
                         (subst (list '= (list (mdl-h A n) x) (car vg)))
                         (subst (list '= (list mdl-G x) (cadr vg)))
                         (dk-ass!))))))))
  ;; pointwise convergence to 0
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list 'ECONVERGES-TO (list 'VNB-LAMBDA 'n_ 'NN (list (list cf 'n_) 'x_)) (list mdl-Z 'x_))))
    (lambda ()
      (let* ((x (dk-di-var!)) (S (list 'VNB-LAMBDA 'n_ 'NN (list (list cf 'n_) x))))
        (dk-have! (list '= (list mdl-Z x) 0) (lambda () (mdl-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (subst (list '= (list mdl-Z x) 0))
        (use-em (list 'IN x A)
          (lambda ()
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list S 'k) 0)))
              (lambda () (let ((k (dk-di-var!))) (mdl-cfv! A k) (mdl-hval-in! A k x) (mdl-beta!) (if (dk-contains? (dk-goal) 'PTWISE-ETIMES) (subst (mdl-hval-in! A k x))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
            (dk-have! (list 'IN S '(FUN NN RR))
              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (subst (mdl-cfv! A k)) (subst (mdl-hval-in! A k x)) (dk-ass!))) (lambda () (dk-ass!)))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= 0 (list S 'k))))
              (lambda () (let ((k (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list S 'k) 0)))) k)
                           (subst (list '= (list S k) 0)) (dk-ass!))))
            (dk-have! (mdl-tree-sub 'a S mdl-small)
              (lambda () (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
                           (mdl-pos-parts! r)
                           (fact 'nn-zero-in)
                           (ew 0)
                           (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                          (let* ((g (begin (dk-peel!) (dk-goal))) (k (cadr (cadr g))))
                                                            (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list S 'k) 0)))) k)
                                                            (subst (list '= (list S k) 0))
                                                            (dk-ineq! (list 'IN r 'RR) (list '< 0 r)))))))))
            (dk-cite! 'econverges-of-eventually-small S)
            (dk-ass!))
          (lambda ()
            (let* ((u (mdl-good! off x))
                   (inst (mdl-tree-sub 'l (list 'f x) (mdl-tree-sub 'u u mdl-up))))
              (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
              (dk-cite! 'econverges-abs-diff-epow u (list 'f x) 'p)
              (dk-have! (list 'IN S '(FUN NN RR))
                (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (subst (mdl-cfv! A k)) (subst (list '= (list (mdl-h A k) x) (mdl-hval-off! A off k x))) (dk-ass!))) (lambda () (dk-ass!)))))
              (dk-have! (list 'IN inst '(FUN NN RR))
                (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-xv! k x) (mdl-beta!) (dk-ass!))) (lambda () (dk-ass!)))))
              (for-each (lambda (h) (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR h)))
                                      (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN h '(FUN NN RR))) (prop))))
                                      (mdl-split! (caddr fi))))
                        (list S inst))
              (dk-have! (list 'FORALL 'mdq_ (list 'IMPLIES '(IN mdq_ NN) (list '= (list S 'mdq_) (list inst 'mdq_))))
                (lambda () (let ((k (dk-di-var!)))
                             (mdl-hval-off! A off k x)
                             (mdl-cfv! A k)
                             (mdl-beta!)
                             (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                 (begin (subst (mdl-cfv! A k)) (subst (list '= (list (mdl-h A k) x) (mdl-hval-off! A off k x)))
                                        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
              (dk-cite! 'fun-domain-extensionality 'NN S inst)
              (subst (list '= S inst))
              (dk-ass!)))))))
  ;; dominated convergence: the integrals of the cut-down functions tend to 0
  (let* ((dc (dk-cite! 'dominated-convergence 'omega 'ca 'mu cf mdl-Z mdl-G))
         (T (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'ca 'mu (list cf 'n_)))))
    (dk-rewrite-h! dc (list 'INTEGRAL 'omega 'ca 'mu mdl-Z) 0)
    ;; the integral of h_n is that of phi_n (they agree off A)
    (dk-have! (list 'IN T '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-int-eq! A off k) (mdl-int-real! A off k) (subst (mdl-cfv! A k))
                                             (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu (mdl-h A k)) (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k)))) (dk-ass!)))
                               (lambda () (dk-ass!)))))
    (dk-have! (list 'IN P '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdl-int-real! A off k) (dk-ass!))) (lambda () (dk-ass!)))))
    (for-each (lambda (h) (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR h)))
                            (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN h '(FUN NN RR))) (prop))))
                            (mdl-split! (caddr fi))))
              (list T P))
    (dk-have! (list 'FORALL 'mdq_ (list 'IMPLIES '(IN mdq_ NN) (list '= (list T 'mdq_) (list P 'mdq_))))
      (lambda () (let ((k (dk-di-var!)))
                   (mdl-int-eq! A off k) (mdl-int-real! A off k) (mdl-hk! A k)
                   (dk-cite! 'integral-in 'omega 'ca 'mu (mdl-h A k))
                   (mdl-cfv! A k)
                   (mdl-beta!)
                   (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                       (begin (subst (mdl-cfv! A k))
                              (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu (mdl-h A k)) (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))))
                              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
    (dk-cite! 'fun-domain-extensionality 'NN T P)
    (dk-rewrite-h! (list 'ECONVERGES-TO T 0) T P)
    ;; ||d_k||_p = (integral phi_k)^(1/p) -> 0
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= 0 (list P 'k))))
      (lambda () (let ((k (dk-di-var!))) (mdl-phik! k) (mdl-beta!) (dk-cite! 'rr-pos-star-nonneg (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))) (dk-ass!))))
    (dk-cite! 'epow-econverges-zero P '(recip p))
    (let* ((inst (mdl-tree-sub 'q '(recip p) (mdl-tree-sub 'a P mdl-b)))
           (L (list 'VNB-LAMBDA 'k 'NN (list 'LP-NORM 'omega 'ca 'mu 'p (mdl-d 'k)))))
      (for-each (lambda (h)
                  (dk-have! (list 'IN h '(FUN NN RR))
                    (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (v (mdl-Lval! k)))
                                                          (mdl-int-real! A off k)
                                                          (mdl-split! (dk-apply! (dk-cite! 'epow-real-in (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))) '(recip p)))
                                                          (mdl-beta!)
                                                          (if (dk-contains? (dk-goal) 'LP-NORM) (subst (list '== (list 'LP-NORM 'omega 'ca 'mu 'p (mdl-d k)) v)))
                                                          (dk-ass!)))
                                             (lambda () (dk-ass!)))))
                  (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR h)))
                    (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN h '(FUN NN RR))) (prop))))
                    (mdl-split! (caddr fi))))
                (list L inst))
      (dk-have! (list 'FORALL 'mdq_ (list 'IMPLIES '(IN mdq_ NN) (list '= (list L 'mdq_) (list inst 'mdq_))))
        (lambda () (let* ((k (dk-di-var!)) (v (mdl-Lval! k)))
                     (mdl-int-real! A off k)
                     (mdl-split! (dk-apply! (dk-cite! 'epow-real-in (list 'INTEGRAL 'omega 'ca 'mu (mdl-phi k))) '(recip p)))
                     (mdl-beta!)
                     (if (dk-contains? (dk-goal) 'LP-NORM) (subst (list '== (list 'LP-NORM 'omega 'ca 'mu 'p (mdl-d k)) v)))
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      (dk-cite! 'fun-domain-extensionality 'NN L inst)
      (mdl-f-real! A off)
      (subst (list '= L inst))
      (dk-conj-close! (lambda () (dk-ass!))))))
(mdl-qed! 'lp-dominated-convergence)
