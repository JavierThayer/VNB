;;; ba-metric-lemmas.scm -- two general facts about metric spaces, needed by the Banach-algebra
;;; files (F. J. Thayer, "Banach Algebras and Applications", ch. 1) and stated for any metric space.
;;;   metric-limit-dist-le   a limit of points eventually within distance B of c is within B of c
;;;                          (closed balls are sequentially closed; BA-1 finding F6)
;;;   closure-near-intro     a point of the carrier with points of A arbitrarily near it lies in the
;;;                          closure of A (the converse of fom-closure-near; BA-1 finding F7)
;;; Agent BA-1B, wave 2026-11-09.  Destination: theorem-library/ba-metric-lemmas.scm.
;;; Library: analysis (no Banach-algebra vocabulary).  All proofs modulo 0.
;;; LOAD WINDOW: after closed-ball-is-closed, closed-set-limit-in-tail, closed-ball-membership,
;;; closure-membership, ball-membership, metric-dist-real (all in the metric-space block, well
;;; before load.scm 1000).  Helper prefix: bml-.

(define (bml-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-metric-lemmas: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-metric-lemmas: unfinished" name))))

;;; ---- a limit of points eventually within B of c is within B of c --------------------------
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL c (IMPLIES (IN c (PTS s)) (FORALL bd (IMPLIES (IN bd RR)
    (FORALL f (FORALL l (FORALL nb (IMPLIES (IN nb NN)
      (IMPLIES (CONVERGES-TO s f l)
        (IMPLIES (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= nb n) (<= ((DIST s) c (f n)) bd))))
          (<= ((DIST s) c l) bd)))))))))))))))
(dk-peel!)
(let* ((cb '(CLOSED-BALL s c bd))
       (hyp '(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= nb n) (<= ((DIST s) c (f n)) bd))))))
  (dk-project! '(IN f (FUN NN (PTS s))) 'converges-to '(CONVERGES-TO s f l))
  (dk-cite! 'closed-ball-is-closed 's 'c 'bd)
  (let ((ch (dk-cite! 'closed-set-limit-in-tail 's cb 'f 'l 'nb)))
    (detach-with! ch
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (n (cadr (cadr g))))
          (mac 'closed-ball-membership)
          (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) n)
          (dk-apply! hyp n)
          (dk-conj-close! (lambda () (dk-ass!)))))))
  (dk-project! '(<= ((DIST s) c l) bd) 'closed-ball-membership (list 'IN 'l cb))
  (dk-ass!))
(bml-qed! 'metric-limit-dist-le)

;;; ---- points of A arbitrarily near x put x in the closure of A --------------------------------
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL aa (IMPLIES (SUBSET aa (PTS s))
  (FORALL x (IMPLIES (IN x (PTS s))
    (IMPLIES (FORALL rho (IMPLIES (POS-RR rho) (FORSOME y (AND (IN y aa) (< ((DIST s) x y) rho)))))
      (IN x (CLOSURE s aa)))))))))))
(dk-peel!)
(let ((near '(FORALL rho (IMPLIES (POS-RR rho) (FORSOME y (AND (IN y aa) (< ((DIST s) x y) rho)))))))
  (mac 'closure-membership)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-peel!))
                 (parts (dk-split-all! landed))
                 (op (car (filter (lambda (f) (dk-head-is? f 'IS-OPEN)) (dk-asms))))
                 (u (caddr op))
                 (opened (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-open op))))))
                 (fa (car (filter (lambda (f) (dk-head-is? f 'FORALL)) opened)))
                 (ex1 (dk-apply! fa 'x))
                 (r (dk-skolem! ex1))
                 (sub (car (filter (lambda (f) (and (dk-head-is? f 'SUBSET) (dk-head-is? (cadr f) 'BALL))) (dk-asms))))
                 (ex2 (dk-apply! near r))
                 (y (dk-skolem! ex2))
                 (d (list '(DIST s) 'x y)))
            (dk-cite! 'rr-pos-rr-in-rr r)
            (dk-cite! 'subset-def 'aa '(PTS s))
            (let ((sa (dk-landed-1 (lambda () (mac-h 'subset-def '(SUBSET aa (PTS s)))))))
              (dk-apply! sa y))
            (dk-cite! 'metric-dist-real 's 'x y)
            (dk-have! (list 'IN y (list 'BALL 's 'x r))
              (lambda ()
                (mac 'ball-membership)
                (dk-conj-close!
                  (lambda ()
                    (cond ((dk-ass!) #t)
                          ((dk-head-is? (dk-goal) 'NOT)
                           (di)
                           (dk-absurd! (dk-rewrite-h! (list '< d r) d r)))
                          (#t (dk-ineq! (list '< d r))))))))
            (let ((sb (dk-landed-1 (lambda () (mac-h 'subset-def sub)))))
              (dk-apply! sb y))
            (ew y)
            (dk-conj-close! (lambda () (dk-ass!))))))))
(bml-qed! 'closure-near-intro)

;;; ---- a Lipschitz self-map carries closures into closures ---------------------------------------
;;; f : PTS s -> PTS s with d(f x, f p) <= L d(x, p); if f maps A into closure(B), it maps closure(A)
;;; into closure(B).  (Continuity of the algebra operations, in the form the closure of an ideal needs.)
(define (bml-sub! sub y)          ; (SUBSET A B) and (IN y A) in context: land (IN y B)
  (let ((goal (list 'IN y (caddr sub))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (let ((fa (dk-landed-1 (lambda () (mac-h 'subset-def sub)))))
              (dk-apply! fa y)
              (dk-ass!)))))
    goal))
(define (bml-pos-rr! t)           ; with (< 0 t) and (IN t RR) in context, prove the goal (POS-RR t)
  (mac 'pos-rr)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'NOT)
             (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))
            (#t (dk-ineq! (list '< 0 t)))))))

