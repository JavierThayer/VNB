              (dk-have! (list 'NOT (list '= mm 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 mm) mm 0))))
              (dk-have! (list 'AND (list 'IN mm 'RR) (list 'NOT (list '= mm 0)))
