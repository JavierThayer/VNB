      (let ((bnd (list 'FORALL 'ivw_ (list 'IMPLIES (list 'IN 'ivw_ B) (list '<= (list 'magnitude (list '- '(DERIV-ON CC-NORMED-FIELD u f ivw_) iv-L)) iv-k)))))
        (dk-have! bnd
          (lambda ()
            (let* ((w (dk-di-var!)) (leaf (proof-state-focus *ps*)))
              (iv-ball-pt! 'a r0 w)
              (fact 'subset-mem-fwd B 'u w)
