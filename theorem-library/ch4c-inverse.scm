                               (fd (list '- (list 'f gw) '(f a))))
                          (dk-have! (list '= fd d) (lambda () (subst (list '= fd (list iv9-F gw))) (ass)))
                          (fact 'fun-apply-type-c 'f 'u 'CC gw)
