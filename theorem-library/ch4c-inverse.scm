(iv-dump-open!)
(qed 'holomorphic-locally-bilipschitz)

;;; (3) LOCAL ONTO: if k |z - a| <= |f(z) - f(a)| on B(a, r) (k > 0), then for 0 < rho < r every w with
;;;     |w - f(a)| < k rho / 2 is a value f(z), z in B(a, rho).  Otherwise 1/(f - w) is holomorphic on B(a, r) and
;;;     the mean-value bound on the circle of radius rho (where |f - w| >= k rho / 2) contradicts its value at a.
(define iv3-B '(BALL CC-MS a r))
(define iv3-goal '(FORSOME ivz_ (AND (IN ivz_ (BALL CC-MS a ivp_)) (= (f ivz_) ivv_))))
(define iv3-m0 '(* 1/2 (* k ivp_)))
(define iv3-lip (list 'FORALL 'ivy_ (list 'IMPLIES (list 'IN 'ivy_ iv3-B) '(<= (* k (magnitude (- ivy_ a))) (magnitude (- (f ivy_) (f a)))))))
(define (iv3-far! z)                   ; z in B(a, r): typings, the lower Lipschitz bound, the triangle inequality
  (iv-ball-pt! 'a 'r z) (fact 'subset-mem-fwd iv3-B 'u z) (fact 'fun-apply-type-c 'f 'u 'CC z)
  (dk-apply! (dk-ctx-form iv3-lip) z)
  (let* ((p (list '- (list 'f z) '(f a))) (q (list '- (list 'f z) 'ivv_)))
    (iv-cc! p) (iv-cc! q) (iv-and! (list 'IN p 'CC) (list 'IN q 'CC))
    (dk-cite! 'cc-magnitude-le-add p q)
    (iv-cc! '(- ivv_ (f a)))
    (dk-have! (list '= (list '- p q) '(- ivv_ (f a))) (lambda () (crs)))
    (for-each iv-mag! (list p q (list '- p q) (list '- z 'a) '(- ivv_ (f a))))
    (dk-have! (list '= (list 'magnitude (list '- p q)) '(magnitude (- ivv_ (f a))))
      (lambda () (let ((lf (proof-state-focus *ps*))) (subst (list '= (list '- p q) '(- ivv_ (f a)))) (if (not (sequent-node-grounded? lf)) (rfl)))))
    (iv-rr! (list '* 'k (list 'magnitude (list '- z 'a))))))
(define (iv3-lower! z)                 ; z in B(a, r), rho <= |z - a| in context: m0 <= |f z - w|
  (iv3-far! z)
  (let* ((mz (list 'magnitude (list '- z 'a))) (p (list '- (list 'f z) '(f a))) (q (list '- (list 'f z) 'ivv_)))
    (dk-have! '(<= 0 k) (lambda () (dk-ineq! '(< 0 k))))
    (iv-and! '(<= 0 k) (list '<= 'ivp_ mz))
    (fact 'rr-le-scale-nonneg 'k 'ivp_ mz)
    (dk-have! (list '<= iv3-m0 (list 'magnitude q))
      (lambda () (dk-ineq! (list '<= '(* k ivp_) (list '* 'k mz)) (list '<= (list '* 'k mz) (list 'magnitude p))
                           (list '<= (list 'magnitude p) (list '+ (list 'magnitude (list '- p q)) (list 'magnitude q)))
                           (list '= (list 'magnitude (list '- p q)) '(magnitude (- ivv_ (f a))))
                           (list '< '(magnitude (- ivv_ (f a))) iv3-m0) (list '= '(* k ivp_) (list '* 2 iv3-m0))
                           (list 'IN '(* k ivp_) 'RR) (list 'IN (list '* 'k mz) 'RR) (list 'IN iv3-m0 'RR)
                           (list 'IN (list 'magnitude p) 'RR) (list 'IN (list 'magnitude q) 'RR)
                           (list 'IN (list 'magnitude (list '- p q)) 'RR) (list 'IN '(magnitude (- ivv_ (f a))) 'RR))))))
(define (iv3-nz! z)                    ; z in B(a, r), NOT goal in context: f z - w /= 0
  (iv3-far! z)
  (let* ((q (list '- (list 'f z) 'ivv_)) (mz (list 'magnitude (list '- z 'a))))
    (if (not (dk-asm? (list 'NOT (list '= q 0))))
        (dk-have! (list 'NOT (list '= q 0))
          (lambda ()
            (di)
            (let ((far-case (lambda ()
                              (iv3-lower! z)
