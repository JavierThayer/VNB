;;; (16) PROPOSITION 4.19 / COROLLARY 4.21 (the argument principle, f holomorphic): E finite, the zeros of f in u
;;;      exactly, each of finite order; for a closed road gamma in u \ E null-homotopic in u,
;;;        (1 / 2 pi i) int_gamma f'/f  =  sum_{a in E} ZERO-ORDER(u, f, a) WINDING(gamma, a).
;;;      f'/f = h + m / (z - a) near each a in E (15); the residue theorem in its decomposition form
;;;      (residue-theorem-induction, CH4-B) and residue-of-decomposition give the residue m.
(define iv16-tpi '(* (* 2 PI) +i))
(define iv16-ag '(NORMED-FIELD-ADDITIVE-AG CC-NORMED-FIELD))
(define iv16-D '(DIFFERENCE u mse_))
(define iv16-LD (list 'VNB-LAMBDA 'ivz16_ iv16-D '(* (DERIV-ON CC-NORMED-FIELD u f ivz16_) (recip (f ivz16_)))))
(define iv16-Z '(VNB-LAMBDA mqx_ CC (* (ZERO-ORDER u f mqx_) (WINDING mdp_ mdq_ mds_ mdt_ mqx_))))
(define iv16-resF (list 'VNB-LAMBDA 'mqx_ 'CC (list '* (list 'RESIDUE iv16-LD 'mqx_) '(WINDING mdp_ mdq_ mds_ mdt_ mqx_))))
