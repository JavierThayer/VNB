      (iv-unfold! 'is-diff-on (list 'CC-NORMED-FIELD 'u 'f x0 L0) dif)
      (let* ((phi (iv-sk! 'phi)))
        (dk-split-all!)
        (set! iv4-phi phi)
        (fact 'cc-nf-carr)
        (dk-rewrite-h! (list 'IN phi (list 'FUN 'u '(CARR CC-NORMED-FIELD))) '(CARR CC-NORMED-FIELD) 'CC)
        (dk-rewrite-h! (list 'IN L0 '(CARR CC-NORMED-FIELD)) '(CARR CC-NORMED-FIELD) 'CC)
        (iv4-pick-E!)
        (iv-and! (list 'IN L0 'CC) (list 'NOT (list '= L0 0)))
        (fact 'cc-recip-closed L0)
        (let* ((phig (list 'VNB-LAMBDA 'iv4t_ 'ww (list 'recip (list phi (list 'g 'iv4t_))))))
          (iv-lam-typ! phig 'ww (lambda (v) (iv4-nz! v)))
          (dk-have! (list 'IN phig (list 'FUN 'ww '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (dk-have! (list 'IN 'g (list 'FUN 'ww '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (dk-have! (list 'IN (list 'recip L0) '(CARR CC-NORMED-FIELD)) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (ew (list 'recip L0))
          (mac 'IS-DIFF-ON)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'FORSOME)
