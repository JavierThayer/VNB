                              (iv-cc! (list '- fy 0))
                              (dk-have! (list '= (list '- fy 0) fy) (lambda () (crs)))
                              (let* ((h2 (dk-rewrite-h! h1 (list 'magnitude (list '- 0 fy)) (list 'magnitude (list '- fy 0))))
                                     (h3 (dk-rewrite-h! h2 (list '- fy 0) fy)))
                                (dk-absurd! h3 (list '< 0 K) (list 'IN K 'RR)))))))
                      (iv16-not-in-E! b)
                      (let ((iff (dk-cite! 'difference-membership 'u 'mse_ b)))
                        (iv-only-prop! iff (list 'IN b 'u) (list 'NOT (list 'IN b 'mse_))))))))))))))
(define (iv16-dec! e)                  ; e in mse_: (r m h Z0) with the decomposition of f'/f at e landed
  (let* ((m (dk-skolem! (iv4-inst! (dk-ctx-form iv16-H5) e)))
         (hzo (list 'HAS-ZERO-OF-ORDER 'u 'f e m)))
    (dk-project! (list 'IN m 'NN) 'has-zero-of-order hzo)
    (fact 'subset-mem-fwd 'mse_ 'u e) (fact 'subset-mem-fwd 'u 'CC e)
    ;; W1K: log-derivative-at-zero wants (IN f (FUN u CC)): from the zero's HOLOMORPHIC-ON conjunct.
    (if (not (dk-asm? '(HOLOMORPHIC-ON u f))) (dk-project! '(HOLOMORPHIC-ON u f) 'has-zero-of-order hzo))
    (dk-cite! 'holomorphic-on-in-fun 'u 'f)
    (let* ((r (dk-skolem! (iv4-inst! (dk-cite! 'log-derivative-at-zero m) 'u e 'f)))
           (h (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm r))) "h")))
           (_ (dk-split-all!))
           (B (iv16-B e r))
           (C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'DERIV-ON))) "the log-derivative clause"))
           (Z0 (list 'VNB-LAMBDA 'mdv_ (iv-pz e) 0)))
      (fact 'nn-in-rr m) (iv-cc! m)
      (dk-cite! 'holomorphic-on-in-fun B h)
      (let ((ze (dk-cite! 'md-zero-exact e)))
        (dk-split-all! (list ze))
        (iv-and! (list 'HOLOMORPHIC-ON (iv-pz e) Z0) (iv16-road-zero e Z0)))
      (dk-have! (iv16-law iv16-LD e m h Z0 r)
        (lambda ()
          (let* ((z (dk-di-var!)) (A (list '- z e)) (hz (list h z)))
            (iv-pb-open! e r z)
            (fact 'subset-mem-fwd B 'u z)
            (dk-split! (iv4-inst! C z))
            (iv16-not-in-E! z)
            (iv16-in-D! z)
            (fact 'fun-apply-type-c h B 'CC z)
            (iv-lam-b!)
            (subst (list '= (list '* (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f z) (list 'recip (list 'f z))) (list '+ hz (list '* m (list 'recip A)))))
            (let* ((RA (iv15-cc-name! (list 'recip A))) (hv (iv15-cc-name! hz)) (mv (iv15-cc-name! m)))
              (subst (list '= (list 'recip A) RA))
              (subst (list '= hz hv))
              (subst (list '= m mv))
              (crs)))))
      (list r m h Z0))))
