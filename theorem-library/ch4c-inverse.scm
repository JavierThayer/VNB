(define (iv16-vals! y)                 ; y in D: fD y = f y, gD y = f'(y), both typed, f y /= 0
  (iv16-in-D! y)
  (let ((Dy (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f y)))
