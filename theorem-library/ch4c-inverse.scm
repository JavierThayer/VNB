                 (e1 (dk-skolem! (dk-cite! 'cc-continuous-at-modulus 'u iv4-phi x0 d1)))
                 (_ (dk-split-all!))
                 (C1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm e1) (dk-contains? fm iv4-phi))) "phi clause"))
                 (_ (fact 'rr-pos-rr-in-rr e1))
                 (d2 (dk-halve! e1))
                 (_ (iv4-inst! (dk-ctx-form (iv-cont 'ww 'g)) y0))
                 (e2 (dk-skolem! (dk-cite! 'cc-continuous-at-modulus 'ww 'g y0 d2)))
                 (_ (dk-split-all!))
                 (C2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm e2) (dk-contains? fm 'g))) "g clause")))
            (fact 'rr-pos-rr-in-rr e2)
            (ew e2)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((b (dk-di-var!)))
                      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                      (let* ((gb (iv4-gy! b)) (p (list iv4-phi gb)))
                        (iv4-gy! y0)
                        (iv-mag! (list '- b y0))
                        (iv-mag! (list '- gb x0))
                        (iv4-inst! C2 b)
                        (dk-have! (list '< (list 'magnitude (list '- gb x0)) e1)
                          (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- gb x0)) d2) (list '= (list '+ d2 d2) e1) (list '< 0 d2) (list 'IN d2 'RR) (list 'IN e1 'RR) (list 'IN (list 'magnitude (list '- gb x0)) 'RR))))
                        (iv4-inst! C1 gb)
                        (let ((h (dk-rewrite-h! (list '<= (list 'magnitude (list '- p (list iv4-phi x0))) d1) (list iv4-phi x0) L0)))
                          (iv-mag! (list '- p L0))
                          (dk-have! (list '< (list 'magnitude (list '- p L0)) dr)
                            (lambda () (dk-ineq! h (list '= (list '+ d1 d1) dr) (list '< 0 d1) (list 'IN d1 'RR) (list 'IN dr 'RR) (list 'IN (list 'magnitude (list '- p L0)) 'RR)))))
                        (iv4-nz! b)
                        (iv-pz-in! 0 p)
                        (let ((rb (iv4-inst! Cr p)))
                          (iv-cc! (list 'recip p)) (iv-cc! (list 'recip L0))
                          (dk-have! (list '= (list rl p) (list 'recip p)) (lambda () (if (not (iv-lam-b!)) (rfl))))
                          (dk-have! (list '= (list rl L0) (list 'recip L0)) (lambda () (if (not (iv-lam-b!)) (rfl))))
                          (let* ((r1 (dk-rewrite-h! rb (list rl p) (list 'recip p)))
                                 (r2 (dk-rewrite-h! r1 (list rl L0) (list 'recip L0))))
                            (iv-lam-b!)
                            (subst (list '= (list iv4-phi x0) L0))
                            (ass))))))))))))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
(define (iv4-factor-eq!)               ; goal: forall x in ww. (ADD..) (g x) - (g y0) = (MUL..) (phig x) (x - y0)
  (let* ((x (dk-di-var!)) (y0 iv4-y0) (x0 (list 'g y0)))
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (let* ((gx (iv4-gy! x)) (p (list iv4-phi gx)) (eq (iv4-eq! x)))
      (iv4-gy! y0)
      (iv4-nz! x)
      (iv-cc! (list 'recip p))
      (iv-lam-b!)
      (iv-cc! (list '- x y0)) (iv-cc! (list '- gx x0))
      (let ((s1 (iv4-sub-eq! gx x0))) (subst (cons '== s1)))
      (let ((s2 (iv4-sub-eq! x y0))) (subst (cons '== s2)))
      (let ((s3 (iv4-mul-eq! (list 'recip p) (list '- x y0)))) (subst (cons '== s3)))
      (subst eq)
      (iv-and! (list 'IN p 'CC) (list 'NOT (list '= p 0)))
      (fact 'cc-recip-inverse p)
      (let* ((rp (dk-name! (list 'recip p) 'CC))
             (inv (dk-rewrite-h! (list '= (list '* p (list 'recip p)) 1) (list 'recip p) rp))
             (D (list '- gx x0)))
        (subst (list '= (list 'recip p) rp))
        (dk-have! (list '= (list '* rp (list '* p D)) (list '* (list '* p rp) D)) (lambda () (crs)))
        (subst (list '= (list '* rp (list '* p D)) (list '* (list '* p rp) D)))
        (subst (list '= (list '* p rp) 1))
        (crs)))))
(define (iv4-point!)                   ; goal: forall a in ww. forsome L. IS-DIFF-ON(CC-NF, ww, g, a, L)
  (let* ((y0 (dk-di-var!)) (x0 (list 'g y0)))
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (set! iv4-y0 y0)
    (let* ((c (iv4-inst! (dk-ctx-form iv4-hinv) y0)))
      (if (dk-head-is? c 'AND) (dk-split! c)))
    (fact 'subset-mem-fwd 'vv 'u x0) (fact 'subset-mem-fwd 'u 'CC x0) (fact 'subset-mem-fwd 'ww 'CC y0)
    (let* ((L0 (dk-skolem! (iv4-inst! (dk-cite! 'holomorphic-on-diff 'u 'f) x0)))
           (dif (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f x0 L0)))
      (set! iv4-L0 L0)
      (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f x0 L0)
