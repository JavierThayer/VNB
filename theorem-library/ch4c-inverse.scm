(define iv-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (iv-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (iv-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS iv-nfm u) iv-nfm f 'rgy_))))
(define (iv-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (iv-imps (cdr hyps) body))))
(define (iv-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (iv-all (cdr vars) body))))
(define (iv-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (iv-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))
(define (iv-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((iv-op? t 'succ 2) (iv-nn! t) (fact 'nn-in-rr t) typ)
          ((iv-op? t '* 3) (iv-rr! (cadr t)) (iv-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((iv-op? t '+ 3) (iv-rr! (cadr t)) (iv-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((iv-op? t '- 3) (iv-rr! (cadr t)) (iv-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((iv-op? t '- 2) (iv-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((iv-op? t 'magnitude 2) (iv-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((iv-op? t 'real-part 2) (iv-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((iv-op? t 'imag-part 2) (iv-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((iv-op? t 'abs 2) (iv-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((iv-op? t 'recip 2)
           (iv-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "iv-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (iv-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (iv-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((iv-op? t 'succ 2) (iv-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (iv-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (iv-op? t 'succ 2)
               (iv-op? t 'magnitude 2) (iv-op? t 'real-part 2) (iv-op? t 'imag-part 2))
           (iv-rr! t) (fact 'rr-subset-cc t) typ)
          ((iv-op? t '- 3) (iv-cc! (cadr t)) (iv-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((iv-op? t '- 2) (iv-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((iv-op? t '+ 3) (iv-cc! (cadr t)) (iv-cc! (caddr t))
           (iv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((iv-op? t '* 3) (iv-cc! (cadr t)) (iv-cc! (caddr t))
           (iv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((iv-op? t 'power 3) (iv-cc! (cadr t)) (iv-nn! (caddr t))
           (iv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((iv-op? t 'CC-EXP 2) (iv-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((iv-op? t 'recip 2) (iv-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "iv-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (iv-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (iv-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (iv-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (iv-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (iv-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (iv-only-prop! iff (list 'IN y (iv-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (iv-only-prop! iff (list 'IN y (iv-pz z))))))
      (lambda () (iv-sub-nz! y z)))))
(define (iv-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (iv-pz z))
      (lambda () (iv-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
(define (iv-pz-setup! z)
  (let* ((d (iv-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN iv-nfm d) (lambda () (iv-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
(define (iv-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (iv-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (iv-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
(define (iv-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (iv-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (iv-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (iv-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define iv-tpi '(* (* 2 PI) +i))
(define (iv-tpi!)
  (iv-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (iv-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (iv-cc! iv-tpi)
  (iv-cc! (list 'recip iv-tpi))
  (iv-and! (list 'IN iv-tpi 'CC) (list 'NOT (list '= iv-tpi 0)))
  (dk-cite! 'cc-recip-inverse iv-tpi))
(define (iv-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (iv-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
(define (iv-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
(define (iv-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (iv-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (iv-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (iv-rr! mag))
      (lambda () (iv-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))
(define (iv-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (iv-subst-sym (car e) from to) (iv-subst-sym (cdr e) from to)))
        (#t e)))
(define (iv-tpt! x . zs)
  (iv-steps
    (lambda () (fact 'subset-mem-fwd iv-T (iv-pz 'c) x))
    (lambda () (iv-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd iv-T (iv-pz z) x) (iv-pz-open! z x)) zs))))
(define (iv-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (iv-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (iv-rr! m)
    (iv-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (iv-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (iv-in-ball! a a r)))
(define iv-tp '(* 2 PI))
(define iv-I (list 'CCINT 0 iv-tp))
(define iv-C '(CIRCLE-PATH c r))
(define iv-Cd '(CIRCLE-DERIV c r))
(define iv-T (list 'TRACE iv-C 0 iv-tp))
(define (iv-kern z) (list 'VNB-LAMBDA 'wnw_ (iv-pz z) (list 'recip (list '- 'wnw_ z))))
(define (iv-in-I! v)
  (dk-have! (list 'IN v iv-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 iv-tp) '(< 0 PI))))))))
(define (iv-circle-basics!)
  (fact 'rr-zero-in)
  (iv-rr! iv-tp)
  (dk-have! (list '< 0 iv-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path iv-C iv-Cd 0 iv-tp)
  (fact 'is-path-in-fun iv-C 0 iv-tp)
  (dk-cite! 'trace-subset-cc iv-C 0 iv-tp))
(define (iv-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (iv-steps
      (lambda () (fact 'subset-mem-fwd iv-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (iv-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (iv-sub-nz! y 'c))
      (lambda () (iv-pz-in! 'c y)))))
(define (iv-LI f) (list 'LINE-INT f iv-C iv-Cd 0 iv-tp))
(define (iv-trace-in-pz! p)
  (dk-have! (list 'SUBSET iv-T (iv-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (iv-circ-pt! y)
        (if (eq? p 'z) (iv-circ-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (iv-kern-setup! p)
  (let* ((dd (iv-pz p)) (k (iv-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))
(define (iv-lam-b!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (iv-B e r) (list 'BALL 'CC-MS e r))
(define (iv-PB e r) (list 'DIFFERENCE (iv-B e r) (list 'SINGLETON e)))
(define (iv-pz e) (list 'DIFFERENCE 'CC (list 'SINGLETON e)))
(define (iv-pb-in! e r y)              ; y in B(e, r), y /= e (in context): y in B(e, r) \ {e}
  (let* ((iff (dk-cite! 'difference-membership (iv-B e r) (list 'SINGLETON e) y))
        (sf (begin (fact 'membership-implies-sethood y (iv-B e r)) (dk-cite! 'singleton-membership e y))))
    (dk-have! (list 'NOT (list 'IN y (list 'SINGLETON e))) (lambda () (iv-only-prop! sf (list 'NOT (list '= y e)))))
    (dk-have! (list 'IN y (iv-PB e r)) (lambda () (iv-only-prop! iff (list 'IN y (iv-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))))))
(define (iv-pb-open! e r y)            ; y in B(e, r) \ {e}: y in B, y in CC, y /= e, y - e /= 0, y in CC \ {e}
  (iv-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership (iv-B e r) (list 'SINGLETON e) y)))
                 (if (not (and (dk-asm? (list 'IN y (iv-B e r))) (dk-asm? (list 'NOT (list 'IN y (list 'SINGLETON e))))))
                     (begin
                       (dk-have! (list 'AND (list 'IN y (iv-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))
                         (lambda () (iv-only-prop! iff (list 'IN y (iv-PB e r)))))
                       (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y (iv-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e)))))))))))
    (lambda () (iv-ball-pt! e r y))
    (lambda () (fact 'membership-implies-sethood y 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership e y)))
                 (dk-have! (list 'NOT (list '= y e))
                   (lambda () (iv-only-prop! iff (list 'NOT (list 'IN y (list 'SINGLETON e))) (list 'IN y 'SET))))))
    (lambda () (iv-sub-nz! y e))
    (lambda () (iv-pz-in! e y))))
(define (iv-ball-pt! e r y)            ; y in B(e, r): y in CC, |y - e| < r
  (if (not (and (dk-asm? (list 'IN y 'CC)) (dk-asm? (list '< (list 'magnitude (list '- y e)) r))))
  (let ((iff (dk-cite! 'cc-ms-ball-membership e r y)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))
      (lambda () (iv-only-prop! iff (list 'IN y (iv-B e r)))))
    (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))))))))
(define iv-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (iv-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (iv-mag! t) (iv-cc! t) (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))
(define (iv-in01! v)                   ; v = 0 or 1: (IN v (CCINT 0 1))
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (dk-have! (list 'IN v '(CCINT 0 1))
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!)))))))

(define (iv-open-ball! u c)            ; IS-OPEN(nf, u), c in u: a radius with B(c, r) inside u; returns r (POS-RR r, 0 < r, r in RR)
  (fact 'cc-is-metric-space) (iv-pts-cc!)
  (let ((iff0 (dk-cite! 'cc-ms-open-iff u)))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS u))) (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (iv-only-prop! iff0 (list 'IS-OPEN iv-nf u))))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball)) (dk-have! oball (lambda () (iv-only-prop! oiff (list 'IS-OPEN 'CC-MS u)))))
    (let ((rho (dk-skolem! (dk-apply! (dk-ctx-form oball) c))))
      (fact 'rr-pos-rr-in-rr rho) (fact 'rr-lt-of-pos-rr rho)
      rho)))
(define (iv-min! r1 r2 K)              ; 0 < r1, r2 in RR: K applied to a radius r0 with 0 < r0 <= r1, r0 <= r2
  (use-em (list '<= r1 r2)
    (lambda () (dk-have! (list '<= r1 r1) (lambda () (dk-ineq! (list 'IN r1 'RR)))) (K r1))
    (lambda () (fact 'rr-not-le-lt r1 r2) (dk-have! (list '<= r2 r2) (lambda () (dk-ineq! (list 'IN r2 'RR))))
               (dk-have! (list '<= r2 r1) (lambda () (dk-ineq! (list '< r2 r1)))) (K r2))))
(define (iv-ball-setup! e r)           ; 0 < r: B(e, r) open (both spellings), inside CC, a set
  (let ((B (iv-B e r)))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list 'IN r 'RR) (list '< 0 r) (list '= 0 r))))
    (iv-and! (list 'IN r 'RR) (iv-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space)
    (iv-pts-cc!)
    (dk-have! (list 'IN e '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-cite! 'ball-is-open 'CC-MS e r)
    (let ((iff (dk-cite! 'cc-ms-open-iff B)))
      (dk-have! (list 'IS-OPEN iv-nf B) (lambda () (iv-only-prop! iff (list 'IS-OPEN 'CC-MS B)))))
    (dk-cite! 'cc-open-subset-cc B)
    (fact 'cc-is-set)
    (fact 'subclass-of-set-is-set B 'CC)))
(define (iv-unfold! name args pred)    ; PRED in context: land its defining right-hand side, split
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (dk-have! rhs (lambda () (iv-only-prop! iff pred)))
    (dk-split-all! (list (dk-ctx-form rhs)))
    rhs))
(define (iv-sk! binder . extra)        ; skolemise the FORSOME on BINDER (containing every EXTRA term)
  (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (symbol? (cadr fm)) (string-prefix? (symbol->string binder) (symbol->string (cadr fm)))
                                         (let loop ((es extra)) (or (null? es) (and (dk-contains? fm (car es)) (loop (cdr es)))))))
                       (symbol->string binder))))
(define (iv-ew-chain! ws)
  (if (pair? ws)
      (begin
        (ew (car ws))
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME) (iv-ew-chain! (cdr ws)))
                  (#t (error "iv-ew-chain!: open conjunct" (dk-goal)))))))))
(define (iv-ew-chain-k! ws K)
  (if (pair? ws)
      (begin
        (ew (car ws))
