                               ((dk-head-is? (dk-goal) '=)
                                (iv4-gy! y0)
                                (if (not (dk-asm? (list 'NOT (list '= (list phi x0) 0))))
                                    (dk-rewrite-h! (list 'NOT (list '= L0 0)) L0 (list phi x0)))
                                (iv-cc! (list 'recip (list phi x0)))
                                (let ((leaf (proof-state-focus *ps*)))
                                  (iv-lam-b!)
                                  (if (not (sequent-node-grounded? leaf)) (subst (list '= (list phi x0) L0)))
                                  (if (not (sequent-node-grounded? leaf)) (rfl))))
                               ((dk-head-is? (dk-goal) 'FORALL) (iv4-factor-eq!))
                               (#t (error "iv4: open conjunct" (dk-goal)))))))
                    (#t (error "iv4: open conjunct (outer)" (dk-goal)))))))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'vv (list 'IMPLIES '(SUBSET vv u)
    (list 'FORALL 'ww (list 'IMPLIES (list 'IS-OPEN iv-nf 'ww)
      (list 'FORALL 'g (iv-imps (list '(IN g (FUN ww CC)) iv4-hinv (iv-cont 'ww 'g) iv4-hnz)
        '(HOLOMORPHIC-ON ww g))))))))))))
