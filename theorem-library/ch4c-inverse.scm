          (iv-pz-in! 0 L0)
          (fact 'cc-nonzero-subset)
          (dk-cite! 'cc-recip-continuous-at L0)
          (let* ((dr (dk-skolem! (dk-cite! 'cc-continuous-at-modulus nz0 rl L0 e)))
                 (_ (dk-split-all!))
                 (Cr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm dr) (dk-contains? fm 'recip))) "recip clause"))
                 (_ (fact 'rr-pos-rr-in-rr dr))
