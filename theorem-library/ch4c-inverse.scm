          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME) (iv-ew-chain-k! (cdr ws) K))
                  (#t (K))))))))
;;; (1) THE SEGMENT ESTIMATE: |f'(w) - c| <= k on a ball B gives |f(z1) - f(z2) - c (z1 - z2)| <= |z1 - z2| k on B
