        (list 'FORSOME 'ivh15_ (list 'AND '(IN ivh15_ (FUN (BALL CC-MS c ivr15_) CC)) (list 'AND '(HOLOMORPHIC-ON (BALL CC-MS c ivr15_) ivh15_)
