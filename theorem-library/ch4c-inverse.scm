(fact 'rr-zero-in) (fact 'cc-zero-in)
(define iv6-r (dk-skolem! (iv4-inst! (dk-cite! 'holomorphic-locally-bilipschitz 'u 'f) 'a)))
(dk-split-all!)
;; 0 < |L|, 0 < k = |L| / 2, named kk
