                                               (list 'IN (list 'magnitude (list '- b y)) 'RR))))
                        (iv6-cancel! X e)
                        (ass)))))))))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
(define iv6-F7 (list 'FORALL 'ivx_ (list 'IMPLIES (list 'IN 'ivx_ iv6-V) (list 'NOT (list '= '(DERIV-ON CC-NORMED-FIELD u f ivx_) 0)))))
(dk-have! iv6-F7
  (lambda ()
    (let* ((x (dk-di-var!)) (D (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f x)))
      (dk-project! (list 'IN x iv6-Br) (lambda () (sep-me (list 'IN x iv6-V))))
