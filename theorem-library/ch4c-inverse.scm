;;; (9) AN INJECTIVE HOLOMORPHIC FUNCTION ON A CONNECTED OPEN SET HAS NONVANISHING DERIVATIVE.  If f'(a) = 0, the zero of
;;;     F = f - f(a) at a has order m >= 2; F = k^m near a with k'(a) /= 0 (7); k maps a neighbourhood of a onto an open
;;;     W containing 0 (6); t and zeta t (zeta from (8)) are in W, their preimages are distinct, and f takes the same
;;;     value f(a) + t^m at both.
(define iv9-inj '(FORALL ivx9_ (IMPLIES (IN ivx9_ u) (FORALL ivy9_ (IMPLIES (IN ivy9_ u) (IMPLIES (= (f ivx9_) (f ivy9_)) (= ivx9_ ivy9_)))))))
(define iv9-F (list 'VNB-LAMBDA 'iv9z_ 'u '(- (f iv9z_) (f a))))
(define (iv9-F! z)                     ; z in u: F z = f z - f a
  (fact 'fun-apply-type-c 'f 'u 'CC z)
  (iv-cc! (list '- (list 'f z) '(f a)))
  (let ((e (list '= (list iv9-F z) (list '- (list 'f z) '(f a)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (iv-lam-b!)) (rfl)))))
    e))
(define (iv9-diff-on-h! h)             ; F = (x - a)^1 h on u, h holomorphic: IS-DIFF-ON(CC-NF, u, f, a, h a)
  (let* ((ha (list h 'a))
         (fh (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'power))) "F = (x - a) h")))
    (dk-cite! 'holomorphic-on-in-fun 'u h)
    (fact 'fun-apply-type-c h 'u 'CC 'a)
    (iv4-inst! (dk-cite! 'holomorphic-on-continuous 'u h) 'a)
    (fact 'cc-nf-carr)
    (dk-have! (list 'IN 'f '(FUN u (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
    (dk-have! (list 'IN h '(FUN u (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
    (dk-have! (list 'IN ha '(CARR CC-NORMED-FIELD)) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
    (dk-have! (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f 'a ha)
      (lambda ()
        (mac 'IS-DIFF-ON)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew h)
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) '=) (rfl))
                             ((dk-head-is? (dk-goal) 'FORALL)
                              (let* ((x (dk-di-var!)) (hx (list h x)) (A (list '- x 'a)) (fd (list '- (list 'f x) '(f a))))
                                (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                                (fact 'subset-mem-fwd 'u 'CC x)
                                (fact 'fun-apply-type-c h 'u 'CC x)
                                (iv-cc! A)
                                (iv9-F! x)
                                (if (not (dk-asm? '(= 1 (succ 0)))) (fact 'nn-one-is-succ-zero))
                                (let* ((e0 (iv4-inst! fh x))
                                       (e1 (dk-rewrite-h! e0 1 '(succ 0))))
                                  (fact 'nn-zero-in)
                                  (iv-and! (list 'IN A 'CC) '(IN 0 NN))
                                  (fact 'power-succ A 0)
                                  (fact 'power-zero A)
                                  (let* ((e2 (dk-rewrite-h! e1 (list 'power A '(succ 0)) (list '* A (list 'power A 0))))
                                         (e3 (dk-rewrite-h! e2 (list 'power A 0) 1)))
                                    (subst (cons '== (iv4-sub-eq! (list 'f x) '(f a))))
