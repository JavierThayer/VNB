            (iv-and! (list 'IN iv6-k 'RR) (list 'IN e 'RR))
            (fact 'rr-mul-in-rr iv6-k e)
            (dk-cite! 'rr-mul-pos iv6-k e)
            (fact 'rr-pos-rr-of-lt ke)
            (ew ke)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((b (dk-di-var!)))
