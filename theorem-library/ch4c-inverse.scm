(define iv2-rho (iv-open-ball! 'u 'a))
(iv-min! iv2-del iv2-rho
  (lambda (r0)
    (let* ((B (list 'BALL 'CC-MS 'a r0))
           (sel (dk-ctx-form (if (equal? r0 iv2-del) (list '<= iv2-del iv2-rho) (list '< iv2-rho iv2-del)))))
