    (fact 'rr-power-mono-base m 0 c)
    (fact 'power-zero-base q)
    (dk-have! (list '= (list 'power 0 m) 0) (lambda () (subst (list '= m (list 'succ q))) (subst (list '= (list 'power 0 (list 'succ q)) 0)) (rfl)))
    (fact 'power-real-closed 0 m)
    (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '<= (list 'power 0 m) e) (list '= (list 'power 0 m) 0) (list 'IN e 'RR) (list 'IN (list 'power 0 m) 'RR))))
    (dk-have! (list 'NOT (list '= 0 e)) (lambda () (di) (dk-have! (list '= e 0) (lambda () (subst (list '= e 0)) (rfl))) (ai (list 'NOT (list '= e 0)))))
    (iv-and! (list '<= 0 e) (list 'NOT (list '= 0 e)))
    (dk-cite! 'rr-le-ne-lt 0 e)
    (fact 'rr-pos-rr-of-lt e)
    (ew e)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((v (dk-di-var!)))
              (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
              (let* ((d (list '- v '(f a))) (_ (iv-cc! d))
                     (w (dk-skolem! (dk-cite! 'cc-nth-root-exists m d)))
                     (_ (dk-split-all!))
                     (X (list 'magnitude w)))
                (iv-mag! w) (iv-mag! d)
                (fact 'cc-magnitude-nonneg w)
                (fact 'power-real-closed X m)
                (fact 'cc-magnitude-power m w)
                (dk-rewrite-h! (list '= (list 'magnitude (list 'power w m)) (list 'power X m)) (list 'power w m) d)
                (use-em (list '<= c X)
                  (lambda ()
                    (fact 'rr-power-mono-base m c X)
                    (dk-absurd! (list '<= e (list 'power X m)) (list '= (list 'magnitude d) (list 'power X m)) (list '< (list 'magnitude d) e)
                                (list 'IN e 'RR) (list 'IN (list 'power X m) 'RR) (list 'IN (list 'magnitude d) 'RR)))
                  (lambda ()
                    (fact 'rr-not-le-lt c X)
                    (let* ((prem (list (list '< X c) (list 'IN X 'RR) (list 'IN c 'RR) (list 'IN del 'RR) (list 'IN sW 'RR))))
                      (dk-have! (list '< X sW) (lambda () (apply dk-ineq! (append prem (list (dk-ctx-form (list '<= c sW)))))))
