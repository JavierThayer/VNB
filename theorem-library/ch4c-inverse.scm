                (lambda () (dk-ineq! (list '< (list 'magnitude (list '- w 'a)) r0) (list '<= r0 iv2-del) (list 'IN r0 'RR) (list 'IN iv2-del 'RR) (list 'IN (list 'magnitude (list '- w 'a)) 'RR))))
              (let ((e (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm iv2-del) (dk-contains? fm 'magnitude))) "the modulus") w)))
