;;; (7) LOCAL NORMAL FORM (the heart of Theorem 4.25): a zero of order m >= 1 at a is, on a ball about a, the m-th
;;;     power of a function k with k(a) = 0 and k'(a) /= 0.  k(z) = (z - a) q(z), q an m-th root of the factor h.
(define (iv7-mag-pos! t)               ; t in CC, NOT (t = 0) in context: lands 0 < |t|, |t| in RR
  (let* ((K (list 'magnitude t)))
    (iv-mag! t)
    (fact 'cc-magnitude-nonneg t)
    (if (not (dk-asm? (list '< 0 K)))
        (begin
          (let ((iff (dk-cite! 'cc-magnitude-zero-iff t)))
            (dk-have! (list 'NOT (list '= K 0)) (lambda () (iv-only-prop! iff (list 'NOT (list '= t 0))))))
          (dk-have! (list 'NOT (list '= 0 K)) (lambda () (di) (dk-have! (list '= K 0) (lambda () (subst (list '= K 0)) (rfl))) (ai (list 'NOT (list '= K 0)))))
          (fact 'rr-zero-in)
          (iv-and! (list '<= 0 K) (list 'NOT (list '= 0 K)))
          (dk-cite! 'rr-le-ne-lt 0 K)))
    K))
(define iv7-concl
  '(FORSOME ivr7_ (FORSOME ivk7_ (AND (IN ivr7_ RR) (AND (< 0 ivr7_) (AND (SUBSET (BALL CC-MS a ivr7_) u)
     (AND (HOLOMORPHIC-ON (BALL CC-MS a ivr7_) ivk7_) (AND (= (ivk7_ a) 0)
     (AND (NOT (= (DERIV-ON CC-NORMED-FIELD (BALL CC-MS a ivr7_) ivk7_ a) 0))
          (FORALL ivz7_ (IMPLIES (IN ivz7_ (BALL CC-MS a ivr7_)) (= (f ivz7_) (power (ivk7_ ivz7_) ivm_)))))))))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'a (list 'FORALL 'ivm_
  (iv-imps (list '(HAS-ZERO-OF-ORDER u f a ivm_) '(<= 1 ivm_)) iv7-concl)))))))
(dk-peel!)
(iv-unfold! 'has-zero-of-order '(u f a ivm_) '(HAS-ZERO-OF-ORDER u f a ivm_))
(define iv7-h (iv-sk! 'zoh))
(dk-split-all!)
(define iv7-fh (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm iv7-h) (dk-contains? fm 'power))) "f = (x - a)^m h"))
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-in-fun 'u iv7-h)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'a)
(fact 'cc-is-set) (fact 'cc-is-normed-field) (fact 'rr-zero-in) (fact 'cc-zero-in)
(fact 'fun-apply-type-c iv7-h 'u 'CC 'a)
(define iv7-ha (list iv7-h 'a))
(define iv7-K (iv7-mag-pos! iv7-ha))
(define iv7-eps (list '* 1/2 iv7-K))
(iv-rr! iv7-eps)
(dk-have! (list '< 0 iv7-eps) (lambda () (dk-ineq! (list '< 0 iv7-K) (list 'IN iv7-K 'RR) (list 'IN iv7-eps 'RR))))
(fact 'rr-pos-rr-of-lt iv7-eps)
(iv4-inst! (dk-cite! 'holomorphic-on-continuous 'u iv7-h) 'a)
(define iv7-del (dk-skolem! (dk-cite! 'cc-continuous-at-modulus 'u iv7-h 'a iv7-eps)))
(dk-split-all!)
(fact 'rr-pos-rr-in-rr iv7-del) (fact 'rr-lt-of-pos-rr iv7-del)
(define iv7-Ch (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm iv7-del))) "the continuity clause of h"))
(define iv7-s (iv-open-ball! 'u 'a))
(iv-min! iv7-del iv7-s
  (lambda (r0)
    (let* ((B (iv-B 'a r0)) (hB (list 'RESTRICT iv7-h B)) (m 'ivm_))
      (iv-ball-setup! 'a r0)
      (dk-have! (list '<= r0 iv7-s) (lambda () (dk-ineq! (dk-ctx-form (list '<= r0 iv7-s)))))
      (dk-cite! 'cc-ms-ball-mono 'a r0 iv7-s)
      (fact 'subset-trans B (iv-B 'a iv7-s) 'u)
      (iv-center-in-ball! 'a r0)
      ;; the restriction of h to B does not vanish
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z B) (list 'NOT (list '= (list hB 'z) 0))))
        (lambda ()
          (let* ((z (dk-di-var!)) (hz (list iv7-h z)))
            (fact 'restrict-apply iv7-h B z)
            (subst (list '== (list hB z) hz))
            (iv-ball-pt! 'a r0 z)
            (fact 'subset-mem-fwd B 'u z)
            (fact 'fun-apply-type-c iv7-h 'u 'CC z)
            (iv-mag! (list '- z 'a))
            (dk-have! (list '< (list 'magnitude (list '- z 'a)) iv7-del)
              (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z 'a)) r0) (dk-ctx-form (list '<= r0 iv7-del)) (list 'IN r0 'RR) (list 'IN iv7-del 'RR)
                                   (list 'IN (list 'magnitude (list '- z 'a)) 'RR))))
            (let ((h0 (iv4-inst! iv7-Ch z)))
              (di)
              (let* ((h1 (dk-rewrite-h! h0 hz 0)))
                (dk-cite! 'cc-magnitude-sub-sym 0 iv7-ha)
                (iv-cc! (list '- iv7-ha 0))
                (dk-have! (list '= (list '- iv7-ha 0) iv7-ha) (lambda () (crs)))
                (let* ((h2 (dk-rewrite-h! h1 (list 'magnitude (list '- 0 iv7-ha)) (list 'magnitude (list '- iv7-ha 0))))
                       (h3 (dk-rewrite-h! h2 (list '- iv7-ha 0) iv7-ha)))
                  (dk-absurd! h3 (list '< 0 iv7-K) (list 'IN iv7-K 'RR))))))))
      (dk-cite! 'holomorphic-on-restrict 'u iv7-h B)
      (dk-cite! 'cc-ball-is-convex 'a r0)
      (let* ((q (dk-skolem! (dk-cite! 'holomorphic-root-convex-exists B hB m))))
        (dk-split-all!)
        (dk-cite! 'holomorphic-on-in-fun B q)
        (let* ((Rq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm q) (dk-contains? fm 'power))) "q^m = h"))
               (k (list 'VNB-LAMBDA 'iv7z_ B (list '* '(- iv7z_ a) (list q 'iv7z_))))
               (qa (list q 'a)))
          (define (root-at! z)           ; z in B: (q z)^m = h z
            (let* ((r (iv4-inst! Rq z)))
              (fact 'restrict-apply iv7-h B z)
              (dk-rewrite-h! r (list hB z) (list iv7-h z))))
          (fact 'fun-apply-type-c q B 'CC 'a)
          (dk-have! (list 'HOLOMORPHIC-ON B k) (lambda () (dk-holomorphic! B k)))
          (dk-cite! 'holomorphic-on-in-fun B k)
          (dk-have! (list '= (list k 'a) 0) (lambda () (iv-lam-b!) (iv-cc! (list '- 'a 'a)) (crs)))
          ;; q(a) /= 0
          (let* ((ra (root-at! 'a))
                 (p (dk-skolem! (dk-cite! 'nn-pos-is-succ m))))
            (dk-have! (list 'NOT (list '= qa 0))
              (lambda ()
                (di)
                (let* ((e1 (dk-rewrite-h! ra qa 0))
                       (e2 (dk-rewrite-h! e1 m (list 'succ p))))
                  (fact 'power-zero-base p)
                  (let ((e3 (dk-rewrite-h! e2 (list 'power 0 (list 'succ p)) 0)))
                    (dk-have! (list '= iv7-ha 0) (lambda () (subst (list '= iv7-ha 0)) (rfl)))
                    (ai (list 'NOT (list '= iv7-ha 0))))))))
          ;; k'(a) = q(a), by the definition with factor q
          (fact 'cc-nf-carr)
          (dk-have! (list 'IN k (list 'FUN B '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (dk-have! (list 'IN q (list 'FUN B '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (dk-have! (list 'IN qa '(CARR CC-NORMED-FIELD)) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (iv4-inst! (dk-cite! 'holomorphic-on-continuous B q) 'a)
          (dk-have! (list 'IS-DIFF-ON 'CC-NORMED-FIELD B k 'a qa)
            (lambda ()
              (mac 'IS-DIFF-ON)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-asm? (dk-goal)) (ass))
                        ((dk-head-is? (dk-goal) 'FORSOME)
                         (ew q)
                         (dk-conj-close!
                           (lambda ()
                             (cond ((dk-asm? (dk-goal)) (ass))
                                   ((dk-head-is? (dk-goal) '=) (rfl))
                                   ((dk-head-is? (dk-goal) 'FORALL)
                                    (let* ((x (dk-di-var!)) (qx (list q x)))
                                      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                                      (fact 'subset-mem-fwd B 'CC x)
                                      (fact 'fun-apply-type-c q B 'CC x)
                                      (iv-lam-b!)
                                      (let* ((kx (list '* (list '- x 'a) qx)) (ka (list '* '(- a a) qa)))
                                        (iv-cc! kx) (iv-cc! ka)
                                        (subst (cons '== (iv4-sub-eq! kx ka)))
                                        (subst (cons '== (iv4-sub-eq! x 'a)))
                                        (subst (cons '== (iv4-mul-eq! qx (list '- x 'a))))
                                        (crs))))
                                   (#t (error "iv7: open factor conjunct" (dk-goal)))))))
                        (#t (error "iv7: open conjunct" (dk-goal))))))))
          (dk-cite! 'cc-deriv-on-of-is-diff-on B k 'a qa)
          (dk-rewrite-h! (list 'NOT (list '= qa 0)) qa (list 'DERIV-ON 'CC-NORMED-FIELD B k 'a))
          ;; f = k^m on B
          (dk-have! (list 'FORALL 'ivz7_ (list 'IMPLIES (list 'IN 'ivz7_ B) (list '= '(f ivz7_) (list 'power (list k 'ivz7_) m))))
            (lambda ()
              (let* ((z (dk-di-var!)) (qz (list q z)) (A (list '- z 'a)))
                (fact 'subset-mem-fwd B 'u z) (fact 'subset-mem-fwd B 'CC z)
                (fact 'fun-apply-type-c q B 'CC z)
                (iv-cc! A)
                (root-at! z)
                (iv4-inst! iv7-fh z)
                (iv-lam-b!)
                (fact 'cc-power-mul-base m A qz)
                (subst (list '= (list 'power (list '* A qz) m) (list '* (list 'power A m) (list 'power qz m))))
                (subst (list '= (list 'power qz m) (list iv7-h z)))
                (ass))))
          (iv-ew-chain! (list r0 k)))))))
