    (if (not (dk-asm? (list '= (list iv16-fD y) (list 'f y))))
        (dk-have! (list '= (list iv16-fD y) (list 'f y))
          (lambda () (subst (list '= iv16-fD iv16-rstf)) (fact 'restrict-apply 'f iv16-D y) (subst (list '== (list iv16-rstf y) (list 'f y))) (rfl))))
    (if (not (dk-asm? (list '= (list iv16-dD y) Dy)))
