(dk-have! (list 'NOT (list '= 0 iv6-mL)) (lambda () (di) (dk-have! (list '= iv6-mL 0) (lambda () (subst (list '= iv6-mL 0)) (rfl))) (ai (list 'NOT (list '= iv6-mL 0)))))
(iv-and! (list '<= 0 iv6-mL) (list 'NOT (list '= 0 iv6-mL)))
(dk-cite! 'rr-le-ne-lt 0 iv6-mL)
(iv-rr! iv-k)
(define iv6-k (dk-name! iv-k 'RR))
(dk-have! (list '< 0 iv6-k) (lambda () (dk-ineq! (list '< 0 iv6-mL) (list 'IN iv6-mL 'RR) (list 'IN iv6-k 'RR) (list '= iv6-k iv-k))))
(define (iv6-on-B? fm head)            ; fm = forall v. v in B(a, r) => (HEAD ...)
  (and (dk-head-is? fm 'FORALL) (pair? (caddr fm)) (dk-head-is? (caddr fm) 'IMPLIES)
       (equal? (cadr (caddr fm)) (list 'IN (cadr fm) (iv-B 'a iv6-r)))
       (dk-head-is? (caddr (caddr fm)) head)))
(define iv6-bnd (dk-rewrite-h! (dk-pick (lambda (fm) (iv6-on-B? fm '<=)) "the derivative bound") iv-k iv6-k))
(define iv6-lip (dk-rewrite-h! (dk-pick (lambda (fm) (iv6-on-B? fm 'FORALL)) "the Lipschitz bound") iv-k iv6-k))
;; rho = r / 2, m0 = (k rho) / 2
(fact 'rr-pos-rr-of-lt iv6-r)
(iv-rr! (list '* 1/2 iv6-r))
(define iv6-rho (dk-name! (list '* 1/2 iv6-r) 'RR))
(dk-have! (list '< 0 iv6-rho) (lambda () (dk-ineq! (list '< 0 iv6-r) (list 'IN iv6-r 'RR) (list 'IN iv6-rho 'RR) (list '= iv6-rho (list '* 1/2 iv6-r)))))
(dk-have! (list '< iv6-rho iv6-r) (lambda () (dk-ineq! (list '< 0 iv6-r) (list 'IN iv6-r 'RR) (list 'IN iv6-rho 'RR) (list '= iv6-rho (list '* 1/2 iv6-r)))))
(dk-have! (list '<= iv6-rho iv6-r) (lambda () (dk-ineq! (list '< iv6-rho iv6-r) (list 'IN iv6-r 'RR) (list 'IN iv6-rho 'RR))))
(define iv6-kr (list '* iv6-k iv6-rho))
(iv-and! (list 'IN iv6-k 'RR) (list 'IN iv6-rho 'RR))
(fact 'rr-mul-in-rr iv6-k iv6-rho)
(dk-cite! 'rr-mul-pos iv6-k iv6-rho)
(define iv6-m0 (list '* 1/2 iv6-kr))
(iv-rr! iv6-m0)
(dk-have! (list '< 0 iv6-m0) (lambda () (dk-ineq! (list '< 0 iv6-kr) (list 'IN iv6-kr 'RR) (list 'IN iv6-m0 'RR))))
(define iv6-B (iv-B 'a iv6-r))
(define iv6-Br (iv-B 'a iv6-rho))
(define iv6-fa '(f a))
(define iv6-W (iv-B iv6-fa iv6-m0))
(iv-ball-setup! 'a iv6-r)
(iv-ball-setup! 'a iv6-rho)
(iv-ball-setup! iv6-fa iv6-m0)
(dk-cite! 'cc-ms-ball-mono 'a iv6-rho iv6-r)
(fact 'subset-trans iv6-Br iv6-B 'u)
;; the lower bound at the centre, for (3)
(define iv6-lip3 (list 'FORALL 'ivy_ (list 'IMPLIES (list 'IN 'ivy_ iv6-B) (list '<= (list '* iv6-k '(magnitude (- ivy_ a))) '(magnitude (- (f ivy_) (f a)))))))
(iv-center-in-ball! 'a iv6-r)
(dk-have! iv6-lip3 (lambda () (let ((y (dk-di-var!))) (iv4-inst! iv6-lip y 'a) (ass))))
;; g(w) = CHOICE {z in B(a, rho) : f z = w}
(define (iv6-S w) (list 'SEP 'iv6z_ iv6-Br (list '= '(f iv6z_) w)))
(define (iv6-choice! w)                ; w in W: CHOICE S(w) in B(a, rho), f of it = w, in CC
  (let* ((S (iv6-S w)) (C (list 'CHOICE S)))
    (if (not (dk-asm? (list 'IN C iv6-Br)))
        (begin
          (iv-ball-pt! iv6-fa iv6-m0 w)
          (let* ((ex (dk-cite! 'holomorphic-local-onto 'u 'f 'a iv6-r iv6-k iv6-rho w))
                 (z (dk-skolem! ex)))
            (dk-split-all!)
            (choose-mem! S z (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
            (dk-project! (list 'IN C iv6-Br) (lambda () (sep-me (list 'IN C S))))
            (dk-project! (list '= (list 'f C) w) (lambda () (sep-me (list 'IN C S))))
            (fact 'subset-mem-fwd iv6-Br 'CC C))))
    C))
(define iv6-lam (list 'VNB-LAMBDA 'iv6w_ iv6-W (list 'CHOICE (iv6-S 'iv6w_))))
(iv-lam-typ! iv6-lam iv6-W (lambda (v) (iv6-choice! v)))
(define iv6-g (dk-name! iv6-lam (list 'FUN iv6-W 'CC)))
(define (iv6-gw! w)                    ; w in W: g w in B(a, rho), f (g w) = w, g w in CC, g w in B, in u
  (let* ((gw (list iv6-g w)))
    (if (not (dk-asm? (list 'IN gw iv6-Br)))
        (let* ((C (iv6-choice! w)))
          (dk-have! (list '= gw C) (lambda () (subst (list '= iv6-g iv6-lam)) (if (not (iv-lam-b!)) (rfl))))
          (dk-rewrite-h! (list 'IN C iv6-Br) C gw)
          (dk-rewrite-h! (list '= (list 'f C) w) C gw)
          (fact 'subset-mem-fwd iv6-Br 'CC gw)))
    (if (not (dk-asm? (list 'IN gw iv6-B))) (fact 'subset-mem-fwd iv6-Br iv6-B gw))
    (if (not (dk-asm? (list 'IN gw 'u))) (fact 'subset-mem-fwd iv6-Br 'u gw))
    gw))
(define (iv6-lipat! z1 z2)             ; z1, z2 in B: k |z1 - z2| <= |f z1 - f z2|
  (iv4-inst! iv6-lip z1 z2))
;; V
(define iv6-V (list 'SEP 'iv5z_ iv6-Br (list 'IN '(f iv5z_) iv6-W)))
(dk-have! (list 'IS-OPEN 'CC-MS iv6-W) (lambda () (ass)))
(dk-cite! 'cc-open-preimage-in-open 'u 'f iv6-Br iv6-W)
(let ((iff (dk-cite! 'cc-ms-open-iff iv6-V)))
  (dk-have! (list 'IS-OPEN iv-nf iv6-V) (lambda () (iv-only-prop! iff (list 'IS-OPEN 'CC-MS iv6-V)))))
(iv-center-in-ball! 'a iv6-rho)
(iv-center-in-ball! iv6-fa iv6-m0)
(dk-have! (list 'IN 'a iv6-V) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
(dk-have! (list 'SUBSET iv6-V 'u)
  (lambda () (let ((x (subset-by-element!)))
               (dk-project! (list 'IN x iv6-Br) (lambda () (sep-me (list 'IN x iv6-V))))
               (fact 'subset-mem-fwd iv6-Br 'u x)
               (ass))))
;; f : V -> W and g (f z) = z
(define (iv6-mag-zero! d)              ; |d| <= 0 in context: d = 0
  (let ((X (list 'magnitude d)))
    (fact 'cc-magnitude-nonneg d)
    (iv-and! (list 'IN X 'RR) (list 'IN 0 'RR))
    (iv-and! (list '<= X 0) (list '<= 0 X))
    (fact 'rr-leq-antisymmetric X 0)
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= d 0) (lambda () (iv-only-prop! iff (list '= X 0)))))))
(define (iv6-cancel! X e)              ; k X <= k e in context (X, e in RR): X <= e
  (let ((k iv6-k))
    (dk-have! (list '= (list '* X k) (list '* k X)) (lambda () (crs)))
    (dk-have! (list '= (list '* e k) (list '* k e)) (lambda () (crs)))
    (iv-rr! (list '* X k)) (iv-rr! (list '* k X)) (iv-rr! (list '* e k)) (iv-rr! (list '* k e))
    (dk-have! (list '<= (list '* X k) (list '* e k))
      (lambda () (dk-ineq! (list '<= (list '* k X) (list '* k e)) (list '= (list '* X k) (list '* k X)) (list '= (list '* e k) (list '* k e))
                           (list 'IN (list '* X k) 'RR) (list 'IN (list '* k X) 'RR) (list 'IN (list '* e k) 'RR) (list 'IN (list '* k e) 'RR))))
    (dk-cite! 'rr-mul-le-cancel-pos X k e)))
(define iv6-F3 (list 'FORALL 'ivz_ (list 'IMPLIES (list 'IN 'ivz_ iv6-V) (list 'AND (list 'IN '(f ivz_) iv6-W) (list '= (list iv6-g '(f ivz_)) 'ivz_)))))
(dk-have! iv6-F3
  (lambda ()
    (let* ((z (dk-di-var!)) (fz (list 'f z)))
      (dk-project! (list 'IN z iv6-Br) (lambda () (sep-me (list 'IN z iv6-V))))
      (dk-project! (list 'IN fz iv6-W) (lambda () (sep-me (list 'IN z iv6-V))))
      (fact 'subset-mem-fwd iv6-Br iv6-B z) (fact 'subset-mem-fwd iv6-Br 'u z) (fact 'subset-mem-fwd iv6-Br 'CC z)
      (fact 'fun-apply-type-c 'f 'u 'CC z)
      (let* ((gfz (iv6-gw! fz))
             (h0 (iv6-lipat! gfz z))
             (h1 (dk-rewrite-h! h0 (list 'f gfz) fz)))
        (iv-cc! (list '- fz fz))
        (dk-have! (list '= (list '- fz fz) 0) (lambda () (crs)))
        (let* ((h2 (dk-rewrite-h! h1 (list '- fz fz) 0)))
          (fact 'cc-magnitude-zero)
          (let* ((h3 (dk-rewrite-h! h2 '(magnitude 0) 0))
                 (d (list '- gfz z)) (X (list 'magnitude d)))
            (iv-mag! d)
            (iv-rr! (list '* iv6-k X)) (iv-rr! (list '* iv6-k 0))
            (dk-have! (list '= (list '* iv6-k 0) 0) (lambda () (crs)))
            (dk-have! (list '<= (list '* iv6-k X) (list '* iv6-k 0))
              (lambda () (dk-ineq! h3 (list '= (list '* iv6-k 0) 0) (list 'IN (list '* iv6-k X) 'RR) (list 'IN (list '* iv6-k 0) 'RR))))
            (iv6-cancel! X 0)
            (iv6-mag-zero! d)
            (dk-cite! 'cc-sub-zero-eq gfz z)
            (dk-conj-close! (lambda () (ass)))))))))
(define iv6-F4 (list 'FORALL 'ivy_ (list 'IMPLIES (list 'IN 'ivy_ iv6-W) (list 'AND (list 'IN (list iv6-g 'ivy_) iv6-V) (list '= (list 'f (list iv6-g 'ivy_)) 'ivy_)))))
