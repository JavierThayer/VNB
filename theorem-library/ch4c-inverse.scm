      (dk-rewrite-h! (list 'HOLOMORPHIC-ON B Rg) Rg gB)
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON B Rgd) Rgd gdB)
      (define (gB-at! y)                ; y in B: gB y = g y, gdB y = g'(y)
        (fact 'subset-mem-fwd B 'u y)
        (fact 'fun-apply-type-c g 'u 'CC y)
        (fact 'fun-apply-type-c gd 'u 'CC y)
        (if (not (dk-asm? (list '= (list gB y) (list g y))))
            (dk-have! (list '= (list gB y) (list g y))
              (lambda () (subst (list '= gB Rg)) (fact 'restrict-apply g B y) (subst (list '== (list Rg y) (list g y))) (rfl))))
        (let ((Dy (list 'DERIV-ON 'CC-NORMED-FIELD 'u g y)))
          (if (not (dk-asm? (list 'IN Dy 'CC))) (dk-lam-b-h! (list 'IN (list gd y) 'CC)))
          (if (not (dk-asm? (list '= (list gdB y) Dy)))
              (dk-have! (list '= (list gdB y) Dy)
                (lambda () (subst (list '= gdB Rgd)) (fact 'restrict-apply gd B y) (subst (list '== (list Rgd y) (list gd y)))
                           (if (not (iv-lam-b!)) (rfl)))))))
      (dk-have! (list 'FORALL 'ivy15_ (list 'IMPLIES (list 'IN 'ivy15_ B) (list 'NOT (list '= (list gB 'ivy15_) 0))))
        (lambda () (let* ((y (dk-di-var!)))
                     (gB-at! y)
                     (subst (list '= (list gB y) (list g y)))
                     (iv4-inst! (dk-ctx-form (list 'FORALL 'ivy15_ (list 'IMPLIES (list 'IN 'ivy15_ B) (list 'NOT (list '= (list g 'ivy15_) 0))))) y)
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
      (let* ((h (list 'VNB-LAMBDA 'ivw15_ B (list '* (list gdB 'ivw15_) (list 'recip (list gB 'ivw15_))))))
        (dk-have! (list 'HOLOMORPHIC-ON B h) (lambda () (dk-holomorphic! B h)))
        (dk-cite! 'holomorphic-on-in-fun B h)      ; W1K: the witness typing
        ;; f = g on u
        (define (fg-at! x)              ; x in u: f x = g x
          (let ((A (list '- x 'c)))
            (fact 'subset-mem-fwd 'u 'CC x) (fact 'fun-apply-type-c g 'u 'CC x) (iv-cc! A)
            (fact 'power-zero A)
            (let* ((e0 (iv4-inst! fg x))
                   (e1 (dk-rewrite-h! e0 (list 'power A 0) 1)))
              (dk-have! (list '= (list '* 1 (list g x)) (list g x)) (lambda () (crs)))
              (dk-rewrite-h! e1 (list '* 1 (list g x)) (list g x)))))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== '(f hbx_) (list g 'hbx_))))
          (lambda () (let* ((x (dk-di-var!))) (fg-at! x) (subst (list '= (list 'f x) (list g x)))
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))
        (fact 'cc-nf-carr)
        (dk-have! (list 'IN 'f '(FUN u (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
        (ew r0)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew h)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (let* ((z (dk-di-var!)) (A (list '- z 'c)) (gz (list g z)) (Dg (list 'DERIV-ON 'CC-NORMED-FIELD 'u g z)))
                             (iv-pb-open! 'c r0 z)
                             (fact 'subset-mem-fwd B 'u z)
                             (gB-at! z)
                             (fg-at! z)
                             (iv4-inst! (dk-ctx-form (list 'FORALL 'ivy15_ (list 'IMPLIES (list 'IN 'ivy15_ B) (list 'NOT (list '= (list g 'ivy15_) 0))))) z)
                             (iv15-dz! g z)
                             (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'u 'f g z Dg)
                             (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f z Dg)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-head-is? (dk-goal) 'NOT)
                                     (begin (subst (list '= (list 'f z) gz)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
                                     (let* ((rgv (iv15-cc-name! (list 'recip gz)))
                                            (RA (iv15-cc-name! (list 'recip A))))
                                       (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f z) Dg))
                                       (subst (list '= (list 'f z) gz))
                                       (iv-lam-b!)
                                       (subst (list '= (list gdB z) Dg))
                                       (subst (list '= (list gB z) gz))
                                       (subst (list '= (list 'recip gz) rgv))
                                       (subst (list '= (list 'recip A) RA))
                                       (crs))))))))))
                  (#t (error "iv15-base: open conjunct" (dk-goal))))))))))
(define (iv15-base!)
  (dk-peel!)
  (iv-unfold! 'has-zero-of-order '(u f c 0) '(HAS-ZERO-OF-ORDER u f c 0))
  (let* ((g (iv-sk! 'zoh)))
    (dk-split-all!)
    (let* ((fg (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm g) (dk-contains? fm 'power))) "f = (x - c)^0 g")))
      (iv15-setup! 'f g)
      (iv15-nonzero-ball! g (lambda (r0 B) (iv15-base-finish! g fg r0 B))))))
(define (iv15-setup! f g)
  (dk-cite! 'cc-open-subset-cc 'u)
  (fact 'subset-mem-fwd 'u 'CC 'c)
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC) (fact 'cc-is-normed-field)
  (fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in)
  (dk-cite! 'holomorphic-on-in-fun 'u f)
  (dk-cite! 'holomorphic-on-in-fun 'u g))
(define (iv15-step!)
  (if (dk-head-is? (dk-goal) 'FORALL) (di))
  (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
  ;; W1K: u and c are fixed (dk-ni-fixed!), so the IH quantifies over f only; n is read off its zero.
  (let* ((IH (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'HAS-ZERO-OF-ORDER))) "the induction hypothesis"))
         (n (let find ((t IH))
              (cond ((and (pair? t) (eq? (car t) 'HAS-ZERO-OF-ORDER) (= (length t) 5)) (list-ref t 4))
                    ((pair? t) (or (find (car t)) (find (cdr t))))
                    (#t #f))))
         (sn (list 'succ n)))
    (dk-peel!)
    (iv-unfold! 'has-zero-of-order (list 'u 'f 'c sn) (list 'HAS-ZERO-OF-ORDER 'u 'f 'c sn))
    (let* ((g (iv-sk! 'zoh))
           (_ (dk-split-all!))
           (fg (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm g) (dk-contains? fm 'power))) "f = (x - c)^(m+1) g"))
           (pw (list 'VNB-LAMBDA 'zlx_ 'u (list 'power '(- zlx_ c) n)))
           (f1 (list 'VNB-LAMBDA 'ivw15_ 'u (list '* (list 'power '(- ivw15_ c) n) (list g 'ivw15_)))))
      (iv15-setup! 'f g)
      (dk-cite! 'pow-sub-holomorphic n 'u 'c)
      (dk-cite! 'holomorphic-on-in-fun 'u pw)
      (iv-lam-typ! f1 'u (lambda (v) (fact 'subset-mem-fwd 'u 'CC v) (fact 'fun-apply-type-c g 'u 'CC v)))
      (let* ((f1s (dk-name! f1 '(FUN u CC))))
        (define (f1-at! x)              ; x in u: f1s x = (x - c)^n g x
          (let ((A (list '- x 'c)) (e (list '= (list f1s x) (list '* (list 'power (list '- x 'c) n) (list g x)))))
            (fact 'subset-mem-fwd 'u 'CC x) (fact 'fun-apply-type-c g 'u 'CC x)
            (iv-cc! A) (iv-cc! (list 'power A n)) (iv-cc! (list '* (list 'power A n) (list g x)))
            (fact 'fun-apply-type-c f1s 'u 'CC x)
            (if (not (dk-asm? e)) (dk-have! e (lambda () (subst (list '= f1s f1)) (if (not (iv-lam-b!)) (rfl)))))
            e))
        (define (fz-at! x)              ; x in u: f x = (x - c) f1s x
          (let* ((A (list '- x 'c)) (P (list 'power A n)) (gxv (list g x))
                 (e (list '= (list 'f x) (list '* A (list f1s x)))))
            (if (not (dk-asm? e))
                (begin
                  (f1-at! x)
                  (iv-and! (list 'IN A 'CC) (list 'IN n 'NN))
                  (fact 'power-succ A n)
                  (let* ((e0 (iv4-inst! fg x))
                         (e1 (dk-rewrite-h! e0 (list 'power A sn) (list '* A P))))
                    (dk-have! e
                      (lambda () (subst (list '= (list f1s x) (list '* P gxv)))
                                 (subst e1)
                                 (crs))))))
            e))
        ;; f1s is holomorphic, with a zero of order n at c
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== (list f1s 'hbx_) (list '* (list pw 'hbx_) (list g 'hbx_)))))
          (lambda () (let* ((x (dk-di-var!)))
                       (f1-at! x)
                       (subst (list '= (list f1s x) (list '* (list 'power (list '- x 'c) n) (list g x))))
                       (iv-lam-b!)
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))
        (dk-cite! 'holomorphic-product 'u pw g f1s)
        (dk-have! (list 'HAS-ZERO-OF-ORDER 'u f1s 'c n)
          (lambda ()
            (mac 'HAS-ZERO-OF-ORDER)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-asm? (dk-goal)) (ass))
                      ((dk-head-is? (dk-goal) 'FORSOME)
                       (ew g)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (ass)
                               (let* ((x (dk-di-var!))) (f1-at! x) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                      (#t (error "iv15-step: open HZO conjunct" (dk-goal))))))))
        (let* ((r1 (dk-skolem! (iv4-inst! IH f1s)))   ; W1K: (IN f1s (FUN u CC)) is in context (dk-name!)
               (h1 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "h1")))
               (_ (dk-split-all!))
               (B (iv-B 'c r1))
               (C1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h1) (dk-contains? fm 'DERIV-ON))) "the hypothesis on f1"))
               (lam (list 'VNB-LAMBDA 'ivv15_ 'u (list '* '(- ivv15_ c) (list f1s 'ivv15_)))))
          (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== '(f hbx_) (list lam 'hbx_))))
            (lambda () (let* ((x (dk-di-var!)))
                         (fz-at! x)
                         (iv-lam-b!)
                         (subst (list '= (list 'f x) (list '* (list '- x 'c) (list f1s x))))
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))
          (fact 'cc-nf-carr)
          (dk-have! (list 'IN 'f '(FUN u (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
          (ew r1)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'FORSOME)
                     (ew h1)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (ass)
                             (let* ((z (dk-di-var!)) (A (list '- z 'c)) (fz1 (list f1s z))
                                    (D1 (list 'DERIV-ON 'CC-NORMED-FIELD 'u f1s z))
                                    (D (list '+ fz1 (list '* A D1))))
                               (iv-pb-open! 'c r1 z)
                               (fact 'subset-mem-fwd B 'u z)
                               (f1-at! z) (fz-at! z)
                               (dk-split! (iv4-inst! C1 z))
                               (iv-and! (list 'IN A 'CC) (list 'IN fz1 'CC))
                               (dk-cite! 'cc-mul-nonzero A fz1)
                               (iv15-dz! f1s z)
                               (dk-diff! 'u lam z D)
                               (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'u 'f lam z D)
                               (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f z D)
                               (dk-conj-close!
                                 (lambda ()
                                   (if (dk-head-is? (dk-goal) 'NOT)
                                       (begin (subst (list '= (list 'f z) (list '* A fz1)))
                                              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
                                       (let* ((_ (dk-cite! 'cc-recip-mul A fz1))
                                              (_ (iv-and! (list 'IN A 'CC) (list 'NOT (list '= A 0))))
                                              (_ (fact 'cc-recip-inverse A))
                                              (_ (iv-and! (list 'IN fz1 'CC) (list 'NOT (list '= fz1 0))))
                                              (_ (fact 'cc-recip-inverse fz1))
                                              (RA (iv15-cc-name! (list 'recip A)))
                                              (RF (iv15-cc-name! (list 'recip fz1)))
                                              (hz1 (list h1 z))
                                              (ia (dk-rewrite-h! (list '= (list '* A (list 'recip A)) 1) (list 'recip A) RA))
                                              (if1 (dk-rewrite-h! (list '= (list '* fz1 (list 'recip fz1)) 1) (list 'recip fz1) RF))
                                              (eq1 (dk-ctx-form (list '= (list '* D1 (list 'recip fz1)) (list '+ hz1 (list '* n (list 'recip A))))))
                                              (eq2 (dk-rewrite-h! eq1 (list 'recip fz1) RF))
                                              (eq3 (dk-rewrite-h! eq2 (list 'recip A) RA))
                                              (big (list '* D (list '* RA RF))))
                                         (fact 'nn-succ-plus-one n)
                                         (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f z) D))
                                         (subst (list '= (list 'f z) (list '* A fz1)))
                                         (subst (list '= (list 'recip (list '* A fz1)) (list '* (list 'recip A) (list 'recip fz1))))
                                         (subst (list '= (list 'recip A) RA))
                                         (subst (list '= (list 'recip fz1) RF))
                                         (subst (list '= sn (list '+ n 1)))
                                         (dk-have! (list '= big (list '+ (list '* (list '* fz1 RF) RA) (list '* (list '* A RA) (list '* D1 RF))))
                                           (lambda () (crs)))
                                         (subst (list '= big (list '+ (list '* (list '* fz1 RF) RA) (list '* (list '* A RA) (list '* D1 RF)))))
                                         (subst (list '= (list '* fz1 RF) 1))
                                         (subst (list '= (list '* A RA) 1))
                                         (subst (list '= (list '* D1 RF) (list '+ hz1 (list '* n RA))))
                                         (dk-cite! 'holomorphic-on-in-fun B h1)
                                         (fact 'fun-apply-type-c h1 B 'CC z)
                                         (let* ((nv (iv15-cc-name! n)) (hv (iv15-cc-name! hz1)))
                                           (subst (list '= n nv))
                                           (subst (list '= hz1 hv))
                                           (crs)))))))))))
                    (#t (error "iv15-step: open conjunct" (dk-goal)))))))))))
(sp (make-wff (list 'FORALL 'ivn15_ (list 'IMPLIES '(IN ivn15_ NN) (iv15-body 'ivn15_)))))
(let ((leaves (cdr (assq 'cases (dk-ni-fixed! '(u c))))))   ; W1K: u, c fixed; the IH varies f
