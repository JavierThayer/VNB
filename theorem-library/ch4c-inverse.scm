;;; (4) THE INVERSE IS HOLOMORPHIC (the last paragraph of the proof of 4.27): f holomorphic on u, g continuous
;;;     on an open w with values in v (v inside u), f(g(y)) = y, f' /= 0 on v; then g is holomorphic on w, with
;;;     derivative 1 / f'(g(y)).  The factor of g at y0 is recip(phi(g(y))), phi the factor of f at g(y0).
(define iv4-hinv '(FORALL ivy_ (IMPLIES (IN ivy_ ww) (AND (IN (g ivy_) vv) (= (f (g ivy_)) ivy_)))))
(define iv4-hnz '(FORALL ivx_ (IMPLIES (IN ivx_ vv) (NOT (= (DERIV-ON CC-NORMED-FIELD u f ivx_) 0)))))
(define (iv4-inst! cl . args)          ; instantiate a context universal, detaching antecedents already in context
  (let loop ((r (apply dk-apply! cl args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
        (if (dk-asm? (caddr r)) (loop (dk-ctx-form (caddr r))) (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define iv4-y0 #f) (define iv4-phi #f) (define iv4-L0 #f) (define iv4-E #f)
(define (iv4-gy! y)                    ; y in ww: g y in vv, f (g y) = y, g y in u, in CC
  (let ((gy (list 'g y)))
    (if (not (dk-asm? (list 'IN gy 'vv)))
        (let ((c (iv4-inst! (dk-ctx-form iv4-hinv) y))) (if (dk-head-is? c 'AND) (dk-split! c))))
    (if (not (dk-asm? (list 'IN gy 'u))) (fact 'subset-mem-fwd 'vv 'u gy))
    (if (not (dk-asm? (list 'IN gy 'CC))) (fact 'subset-mem-fwd 'u 'CC gy))
    (if (not (dk-asm? (list 'IN y 'CC))) (fact 'subset-mem-fwd 'ww 'CC y))
    (if (not (dk-asm? (list 'IN (list 'f gy) 'CC))) (fact 'fun-apply-type-c 'f 'u 'CC gy))
    (if (not (dk-asm? (list 'IN (list iv4-phi gy) 'CC))) (fact 'fun-apply-type-c iv4-phi 'u 'CC gy))
    gy))
(define (iv4-sub-eq! a b)              ; ADD(K)(a, NEG(K) b) == a - b, landed; returns (FROM TO)
  (iv-cc! a) (iv-cc! b)
  (let ((from (list '(ADD CC-NORMED-FIELD) a (list '(NEG CC-NORMED-FIELD) b))) (to (list '- a b)))
    (if (not (dk-asm? (list '== from to))) (fact 'cc-nf-sub a b))
    (list from to)))
(define (iv4-mul-eq! a b)
  (iv-cc! a) (iv-cc! b) (iv-and! (list 'IN a 'CC) (list 'IN b 'CC))
  (let ((from (list '(MUL CC-NORMED-FIELD) a b)) (to (list '* a b)))
    (if (not (dk-asm? (list '== from to))) (fact 'cc-nf-mul-apply a b))
    (list from to)))
(define (iv4-eq! y)                    ; y in ww: y - y0 = phi(g y) (g y - g y0)
  (let* ((gy (iv4-gy! y)) (x0 (list 'g iv4-y0)) (p (list iv4-phi gy))
         (target (list '= (list '- y iv4-y0) (list '* p (list '- gy x0)))))
    (if (not (dk-asm? target))
        (let* ((e0 (iv4-inst! iv4-E gy))
               (s1 (cons 'eq (iv4-sub-eq! (list 'f gy) (list 'f x0))))
               (e1 (dk-rewrite-h! e0 (cadr s1) (caddr s1)))
               (s2 (cons 'eq (iv4-sub-eq! gy x0)))
               (e2 (dk-rewrite-h! e1 (cadr s2) (caddr s2))))
          (iv-cc! (list '- gy x0))
          (iv-and! (list 'IN p 'CC) (list 'IN (list '- gy x0) 'CC))
          (let* ((s3 (cons 'eq (iv4-mul-eq! p (list '- gy x0))))
                 (e3 (dk-rewrite-h! e2 (cadr s3) (caddr s3)))
                 (e4 (dk-rewrite-h! e3 (list 'f gy) y)))
            (dk-rewrite-h! e4 (list 'f x0) iv4-y0))))
    target))
(define (iv4-nz! y)                    ; y in ww: phi(g y) /= 0
  (let* ((eq (iv4-eq! y)) (gy (list 'g y)) (p (list iv4-phi gy)) (nz (list 'NOT (list '= p 0))))
    (if (not (dk-asm? nz))
        (dk-have! nz
          (lambda ()
            (di)
            (let* ((e1 (dk-rewrite-h! eq p 0))
                   (z0 (list '* 0 (list '- gy (list 'g iv4-y0)))))
              (dk-have! (list '= z0 0) (lambda () (crs)))
              (dk-rewrite-h! e1 z0 0)
              (iv-cc! y) (iv-cc! iv4-y0)
              (dk-cite! 'cc-sub-zero-eq y iv4-y0)
              (let* ((h1 (dk-rewrite-h! (list '= p 0) y iv4-y0))
                     (h2 (dk-rewrite-h! h1 (list iv4-phi (list 'g iv4-y0)) iv4-L0)))
                (ai (list 'NOT (list '= iv4-L0 0))))))))
    nz))
(define (iv4-pick-E!)
