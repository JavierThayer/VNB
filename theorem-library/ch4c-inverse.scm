;;; (5) the points of an open set oo (inside u) that a continuous f sends into an open ww form an open set
(define iv5-S '(SEP iv5z_ oo (IN (f iv5z_) ww)))
(define iv5-Ocl #f) (define iv5-Wcl #f)
(define (iv5-in-ball! c r x)           ; x in CC, c in CC, r in RR, |x - c| < r in context: x in BALL(CC-MS, c, r)
  (let ((iff (dk-cite! 'cc-ms-ball-membership c r x)))
    (dk-have! (list 'IN x (iv-B c r)) (lambda () (iv-only-prop! iff (list 'IN x 'CC) (list '< (list 'magnitude (list '- x c)) r))))))
(define (iv5-point!)
  (let* ((y (dk-di-var!)) (fy (list 'f y)))
    (dk-project! (list 'IN y 'oo) (lambda () (sep-me (list 'IN y iv5-S))))
    (dk-project! (list 'IN fy 'ww) (lambda () (sep-me (list 'IN y iv5-S))))
    (fact 'subset-mem-fwd 'oo 'u y) (fact 'subset-mem-fwd 'u 'CC y)
    (fact 'fun-apply-type-c 'f 'u 'CC y)
    (let* ((s1 (dk-skolem! (iv4-inst! iv5-Ocl y))))
      (dk-split-all!)
      (fact 'rr-pos-rr-in-rr s1) (fact 'rr-lt-of-pos-rr s1)
      (let* ((t (dk-skolem! (iv4-inst! iv5-Wcl fy))))
        (dk-split-all!)
        (fact 'rr-pos-rr-in-rr t) (fact 'rr-lt-of-pos-rr t)
        (iv4-inst! (dk-ctx-form (iv-cont 'u 'f)) y)
        (let* ((d1 (dk-halve! t))
               (dl (dk-skolem! (dk-cite! 'cc-continuous-at-modulus 'u 'f y d1))))
          (dk-split-all!)
          (fact 'rr-pos-rr-in-rr dl) (fact 'rr-lt-of-pos-rr dl)
          (let ((C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm dl))) "the f clause")))
            (iv-min! s1 dl
              (lambda (r0)
                (ew r0)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let* ((b (subset-by-element!)) (fb (list 'f b))
                               (prem (list (list 'IN r0 'RR) (list 'IN s1 'RR) (list 'IN dl 'RR)
                                           (list 'IN (list 'magnitude (list '- b y)) 'RR) (list '< (list 'magnitude (list '- b y)) r0))))
                          (iv-ball-pt! y r0 b)
                          (iv-mag! (list '- b y))
                          (dk-have! (list '< (list 'magnitude (list '- b y)) s1)
                            (lambda () (apply dk-ineq! (append prem (list (dk-ctx-form (list '<= r0 s1)))))))
                          (dk-have! (list '< (list 'magnitude (list '- b y)) dl)
                            (lambda () (apply dk-ineq! (append prem (list (dk-ctx-form (list '<= r0 dl)))))))
                          (iv5-in-ball! y s1 b)
                          (fact 'subset-mem-fwd (iv-B y s1) 'oo b)
                          (fact 'subset-mem-fwd 'oo 'u b)
                          (fact 'fun-apply-type-c 'f 'u 'CC b)
                          (iv4-inst! C b)
                          (iv-mag! (list '- fb fy))
                          (dk-have! (list '< (list 'magnitude (list '- fb fy)) t)
                            (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- fb fy)) d1) (list '= (list '+ d1 d1) t) (list '< 0 d1)
                                                 (list 'IN d1 'RR) (list 'IN t 'RR) (list 'IN (list 'magnitude (list '- fb fy)) 'RR))))
                          (iv5-in-ball! fy t fb)
                          (fact 'subset-mem-fwd (iv-B fy t) 'ww fb)
                          (in-sep! (lambda () (ass)) (lambda () (ass)))))))))))))))
(sp (make-wff (list 'FORALL 'u (iv-imps (list '(SUBSET u CC))
  (list 'FORALL 'f (iv-imps (list '(IN f (FUN u CC)) (iv-cont 'u 'f))
    (list 'FORALL 'oo (iv-imps (list '(IS-OPEN CC-MS oo) '(SUBSET oo u))
      (list 'FORALL 'ww (iv-imps (list '(IS-OPEN CC-MS ww))
        (list 'IS-OPEN 'CC-MS iv5-S)))))))))))
(dk-peel!)
(fact 'cc-is-metric-space) (iv-pts-cc!)
(set! iv5-Ocl (caddr (caddr (iv-unfold! 'is-open '(CC-MS oo) '(IS-OPEN CC-MS oo)))))
(set! iv5-Wcl (caddr (caddr (iv-unfold! 'is-open '(CC-MS ww) '(IS-OPEN CC-MS ww)))))
(dk-rewrite-h! '(SUBSET oo (PTS CC-MS)) '(PTS CC-MS) 'CC)
(mac 'is-open)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond ((dk-asm? g) (ass))
           ((dk-head-is? g 'SUBSET)
            (subst '(== (PTS CC-MS) CC))
            (let ((x (subset-by-element!)))
              (dk-project! (list 'IN x 'oo) (lambda () (sep-me (list 'IN x iv5-S))))
              (fact 'subset-mem-fwd 'oo 'CC x)
              (ass)))
           ((dk-head-is? g 'FORALL) (iv5-point!))
           (#t (error "iv5: open conjunct" g))))))
(qed 'cc-open-preimage-in-open)
(topic! 'cc-open-preimage-in-open 'analysis)

;;; (6) PROPOSITION 4.27 (the holomorphic inverse function theorem): f holomorphic on u, a in u, f'(a) /= 0: an open
;;;     V inside u with a in V and an open W, with f : V -> W bijective, its inverse g holomorphic on W.
;;;     V = {z in B(a, rho) : f z in W}, W = B(f a, m0) (rho, m0 from (2) and (3)), g(w) = CHOICE{z in B(a, rho) : f z = w}.
(define iv6-concl
  '(FORSOME vv (FORSOME ww (FORSOME g (AND (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) vv) (AND (IN a vv) (AND (SUBSET vv u)
     (AND (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) ww) (AND (IN g (FUN ww CC))
     (AND (FORALL ivz_ (IMPLIES (IN ivz_ vv) (AND (IN (f ivz_) ww) (= (g (f ivz_)) ivz_))))
     (AND (FORALL ivy_ (IMPLIES (IN ivy_ ww) (AND (IN (g ivy_) vv) (= (f (g ivy_)) ivy_))))
          (HOLOMORPHIC-ON ww g))))))))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'a (list 'IMPLIES '(IN a u) (list 'IMPLIES (list 'NOT (list '= iv-L 0)) iv6-concl))))))))
(dk-peel!)
