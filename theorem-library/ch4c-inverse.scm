;;; (13) LOCAL OPENNESS: f holomorphic and non-constant on a connected open u, a in an open oo inside u: a disc about f(a)
;;;      lies in f(oo).  F = f - f(a) = k^m near a (7); k is open at a (6) with a continuous inverse g, g(0) = a; for
;;;      |v - f(a)| < c^m an m-th root w of v - f(a) has |w| < c, and z = g(w) is in oo with f(z) = v.
(define iv13-nc '(FORSOME ivx13_ (AND (IN ivx13_ u) (FORSOME ivy13_ (AND (IN ivy13_ u) (NOT (= (f ivx13_) (f ivy13_))))))))
(define iv13-concl
  '(FORSOME ive13_ (AND (POS-RR ive13_) (FORALL ivv13_ (IMPLIES (IN ivv13_ CC) (IMPLIES (< (magnitude (- ivv13_ (f a))) ive13_)
