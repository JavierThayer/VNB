         (imp (dk-cite! 'cc-continuous-at-of-modulus 'ww phig y0)))
    (iv-detach! imp
      (lambda ()
        (di)
        (let* ((e (cadr (cadr (dk-goal)))))
          (di)
          (fact 'rr-pos-rr-in-rr e)
