      (dk-have! (list '<= r0 iv2-del) (lambda () (dk-ineq! (list 'IN r0 'RR) (list 'IN iv2-del 'RR) (list 'IN iv2-rho 'RR) sel)))
      (dk-have! (list '<= r0 iv2-rho) (lambda () (dk-ineq! (list 'IN r0 'RR) (list 'IN iv2-del 'RR) (list 'IN iv2-rho 'RR) sel)))
