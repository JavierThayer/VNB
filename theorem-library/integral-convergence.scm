;;; at x in omega with v(x) <= u(x) in context: land (= (D x) value) and the
;;; typings; FIN? says whether u(x) is real (#t) or not (#f).  Returns the value.
(define (icv-dif-at! uf vf x fin?)
  (let* ((ux (list uf x)) (vx (list vf x)) (ift (icv-dif-if uf vf x)) (d (icv-dif uf vf)))
    (fact 'fun-apply-type-c uf 'omega 'RR-POS-STAR x)
    (fact 'fun-apply-type-c vf 'omega 'RR-POS-STAR x)
    (if fin?
        (let ((val (list '- ux vx)))
          (dk-have! (list 'AND (list 'IN vx 'RR-POS-STAR) (list 'IN ux 'RR)))
          (fact 'rr-pos-star-le-real-in-rr vx ux)
          (fact 'rr-sub-in-rr ux vx)
          (fact 'rr-pos-star-nonneg vx)
          (dk-have! (list '<= 0 val) (lambda () (dk-ineq! (list 'IN ux 'RR) (list 'IN vx 'RR) (list '<= vx ux))))
          (icv-rps! val)
          (dk-cite! 'difference-value 'omega uf vf x)
          (dk-have! (list '= (list d x) val)
            (lambda ()
              (subst (list '== (list d x) ift))
              (dk-if-branch! #t ift #f (lambda () (rfl)))))
          val)
        (begin
          (fact 'rr-zero-in)
          (fact 'rr-leq-reflexive 0)
          (icv-rps! 0)
          (dk-cite! 'difference-value 'omega uf vf x)
          (dk-have! (list '= (list d x) 0)
            (lambda ()
              (subst (list '== (list d x) ift))
              (dk-if-branch! #f ift #f (lambda () (rfl)))))
          0))))

;;; measurable-fn-sub: the difference of v <= u is measurable
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL u (FORALL v
        (IMPLIES (IS-MEASURABLE-FN omega cA u)
          (IMPLIES (IS-MEASURABLE-FN omega cA v)
            (IMPLIES (FORALL x (IMPLIES (IN x omega) (<= (v x) (u x))))
              (IS-MEASURABLE-FN omega cA
                (VNB-LAMBDA dx_ omega (IF (IN (u dx_) RR) (- (u dx_) (v dx_)) 0))))))))))))
(dk-peel!)
(icv-mfn-parts! 'omega 'cA 'u)
(icv-mfn-parts! 'omega 'cA 'v)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(let* ((d (icv-dif 'u 'v))
       (hle '(FORALL x (IMPLIES (IN x omega) (<= (v x) (u x)))))
       (fs '(SEP fp_ omega (IN (u fp_) RR)))
       (at! (lambda (x)
              (dk-apply! hle x)
              (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR x)
              (if (dk-asm? (list 'IN (list 'u x) 'RR))
                  (icv-dif-at! 'u 'v x #t)
                  (if (dk-asm? (list 'NOT (list 'IN (list 'u x) 'RR)))
