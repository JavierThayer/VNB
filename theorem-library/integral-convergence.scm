        (let* ((ex (dk-fact! 'nn-unbounded-in-rr uw))
               (k (dk-skolem! ex)))
          (fact 'nn-in-rr k)
          (dk-apply! ve k)
          (dk-have! (list 'IN w (list hf k))
            (lambda ()
              (subst (list '== (list hf k) (body-of k)))
              (mac 'complement-in-membership)
              (icv-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (begin
                        (di)
                        (sep-me (list 'IN w (tl k)))
                        (dk-absurd! (list 'IN uw 'RR) (list 'IN k 'RR) (list '< uw k) (list '< k uw))))))))
          (for-each (lambda (l)
                      (if (not (sequent-node-grounded? l))
                          (begin (dk-focus! l) (ass))))
                    (dk-opened (lambda () (bu-mi k)))))))
    (lambda (w)
      (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
             (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
             (k (cadr nin))
             (uw (list 'u w)))
        (fact 'nn-in-rr k)
        (dk-apply! ve k)
        (dk-have! (list 'IN w (body-of k))
          (lambda () (subst (list '= (body-of k) (list hf k))) (ass)))
        (mac-h 'complement-in-membership (list 'IN w (body-of k)))
        (dk-split-all!)
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (dk-have! (list 'NOT (list '< k uw))
          (lambda ()
