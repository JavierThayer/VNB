;;; rr-lt-mul-of-div-lt: al / g < q, 0 < g  =>  al < q g
(sp (make-wff
     '(FORALL al (IMPLIES (IN al RR) (FORALL q (IMPLIES (IN q RR) (FORALL g (IMPLIES (IN g RR)
        (IMPLIES (< 0 g) (IMPLIES (< (* al (recip g)) q) (< al (* q g))))))))))))
(dk-peel!)
(let* ((ug (icv-recip-facts! 'g))
       (a  (list '* 'al ug)))
  (icv-mul-rr! 'al ug)
  (icv-scale! 'g a 'q)
  (dk-have! (list '= (list '* 'g a) 'al)
    (lambda ()
      (dk-have! (list '= (list '* 'g a) (list '* 'al (list '* 'g ug))) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '* 'g a) (list '* 'al (list '* 'g ug))))
      (subst (list '= (list '* 'g ug) 1))
      (crs)))
  (dk-have! '(= (* q g) (* g q)) (lambda () (crs)))
  (subst '(= (* q g) (* g q)))
  (subst (list '= 'al (list '* 'g a)))
  (ass))
(qed 'rr-lt-mul-of-div-lt)
(topic! 'rr-lt-mul-of-div-lt 'inequalities)

;;; rps-le-of-scaled: if c u <= L for every real c in (0, 1), then u <= L.
(sp (make-wff
     '(FORALL u (IMPLIES (IN u RR-POS-STAR) (FORALL L (IMPLIES (IN L RR-POS-STAR)
        (IMPLIES (FORALL c (IMPLIES (IN c RR) (IMPLIES (< 0 c) (IMPLIES (< c 1) (<= (etimes c u) L)))))
          (<= u L))))))))
(dk-peel!)
(let ((hc '(FORALL c (IMPLIES (IN c RR) (IMPLIES (< 0 c) (IMPLIES (< c 1) (<= (etimes c u) l)))))))
  (icv-star-cases! 'l
    (lambda ()
      (icv-star-cases! 'u
        (lambda ()
          (use-em '(<= u l)
            (lambda () (ass))
            (lambda ()
              (fact 'rr-not-le-lt 'u 'l)
              (dk-have! '(< 0 u) (lambda () (dk-ineq! '(IN u RR) '(IN l RR) '(<= 0 l) '(< l u))))
              (let* ((uu (icv-recip-facts! 'u))
                     (a  (list '* 'l uu)))
                (fact 'rr-lt-implies-le 0 uu)
                (icv-mul-nonneg! 'l uu)
                (fact 'rr-one-in)
                (fact 'rr-one-mul 'u)
                (dk-have! '(< l (* 1 u)) (lambda () (subst '(= (* 1 u) u)) (ass)))
                (fact 'rr-lt-div-of-lt-mul 'l 1 'u)
                (let* ((ex (dk-fact! 'rr-grid-between a 1))
                       (n  (dk-skolem! ex))
                       (ex2 (dk-pick (dk-head? 'forsome) "the grid numerator"))
                       (k  (dk-skolem! ex2))
                       (q  (icv-gq n k)))
                  (fact 'nn-recip-succ-pos n)
                  (fact 'rr-pos-rr-in-rr (icv-recip n))
                  (fact 'nn-in-rr k)
                  (icv-mul-rr! k (icv-recip n))
                  (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN q 'RR) (list '<= 0 a) (list '< a q))))
                  (dk-apply! hc q)
                  (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list 'IN q 'RR) (list '< 0 q))))
                  (icv-etimes-eq! q 'u)
                  (icv-mul-rr! q 'u)
                  (dk-have! (list '<= (list '* q 'u) 'l)
                    (lambda () (subst (list '= (list '* q 'u) (list 'etimes q 'u))) (ass)))
                  (fact 'rr-lt-mul-of-div-lt 'l q 'u)
                  (dk-have! 'FALSITY
                    (lambda () (dk-absurd! '(IN l RR) (list 'IN (list '* q 'u) 'RR)
                                           (list '<= (list '* q 'u) 'l) (list '< 'l (list '* q 'u)))))
                  (icv-keep-prop! 'FALSITY))))))
        (lambda ()
          (dk-have! '(IN 1/2 RR) (lambda () (arith)))
          (dk-have! '(< 0 1/2) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (dk-have! '(< 1/2 1) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (dk-apply! hc 1/2)
          (dk-have! '(<= 0 1/2) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (icv-rps! 1/2)
          (icv-nz-of-pos! 1/2)
          (fact 'etimes-pos-inf-right 1/2)
          (dk-have! '(<= POS-INF l)
            (lambda ()
              (subst '(= POS-INF (etimes 1/2 POS-INF)))
              (subst '(= POS-INF u))
              (ass)))
          (fact 'pos-inf-above-reals 'l)
          (icv-keep-prop! '(<= POS-INF l) '(NOT (<= POS-INF l))))))
    (lambda ()
      (subst '(= l POS-INF))
      (fact 'rr-pos-star-below-pos-inf 'u)
      (ass))))
(qed 'rps-le-of-scaled)
(topic! 'rps-le-of-scaled 'inequalities)

;;; esup-etimes-ge: w sup m <= sup (w m), w real >= 0.
(sp (make-wff
     '(FORALL w (IMPLIES (IN w RR) (IMPLIES (<= 0 w)
        (FORALL m (IMPLIES (IN m (FUN NN RR-POS-STAR))
          (<= (etimes w (ESUP (IMAGE m NN)))
              (ESUP (IMAGE (VNB-LAMBDA n_ NN (etimes w (m n_))) NN))))))))))
(dk-peel!)
(icv-rps! 'w)
(let* ((sm  (icv-seq-sup! 'm))
       (phi '(VNB-LAMBDA n_ NN (etimes w (m n_))))
       (tt  (list 'ESUP (list 'IMAGE phi 'NN))))
  (dk-have! (list 'IN phi '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((n (dk-di-var!)))
            (fact 'fun-apply-type-c 'm 'NN 'RR-POS-STAR n)
            (dk-have! (list 'AND '(IN w RR-POS-STAR) (list 'IN (list 'm n) 'RR-POS-STAR)))
            (fact 'etimes-closed 'w (list 'm n))
            (dk-ass!))))))
  (icv-seq-sup! phi)
  (use-em '(= w 0)
    (lambda ()
      (dk-have! (list '= (list 'etimes 'w sm) 0)
        (lambda () (subst '(= w 0)) (fact 'etimes-zero-left sm) (ass)))
      (subst (list '= (list 'etimes 'w sm) 0))
      (fact 'rr-pos-star-nonneg tt)
      (ass))
    (lambda ()
      (icv-pos! 'w)
      (icv-star-cases! tt
        (lambda ()
          (let* ((uw (icv-recip-facts! 'w))
                 (b  (list '* tt uw)))
            (fact 'rr-lt-implies-le 0 uw)
            (icv-mul-nonneg! tt uw)
            (icv-rps! b)
            (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (IMAGE m NN)) (list '<= 'x b)))
              (lambda ()
                (let* ((x (dk-di-var!))
                       (n (icv-img-elt! 'm 'NN x))
                       (mn (list 'm n))
                       (e (list 'etimes 'w mn)))
                  (fact 'fun-apply-type-c 'm 'NN 'RR-POS-STAR n)
                  (dk-have! (list 'AND '(IN w RR-POS-STAR) (list 'IN mn 'RR-POS-STAR)))
                  (fact 'etimes-closed 'w mn)
                  (icv-in-image! phi n e)
                  (dk-fact! 'esup-upper (list 'IMAGE phi 'NN) e)
                  (subst (list '= x mn))
                  (icv-star-cases! mn
                    (lambda ()
                      (icv-etimes-eq! 'w mn)
                      (icv-mul-rr! 'w mn)
                      (dk-have! (list '<= (list '* 'w mn) tt)
                        (lambda () (subst (list '= (list '* 'w mn) e)) (ass)))
                      (dk-have! (list 'AND (list '<= 0 uw) (list '<= (list '* 'w mn) tt)))
                      (fact 'rr-le-scale-nonneg uw (list '* 'w mn) tt)
                      (dk-have! (list '= (list '* uw (list '* 'w mn)) mn)
                        (lambda ()
                          (dk-have! (list '= (list '* uw (list '* 'w mn)) (list '* mn (list '* 'w uw)))
                            (lambda () (dk-crs-opaque!)))
                          (subst (list '= (list '* uw (list '* 'w mn)) (list '* mn (list '* 'w uw))))
                          (subst (list '= (list '* 'w uw) 1))
                          (crs)))
                      (dk-have! (list '= b (list '* uw tt)) (lambda () (dk-crs-opaque!)))
                      (subst (list '= b (list '* uw tt)))
                      (subst (list '= mn (list '* uw (list '* 'w mn))))
                      (ass))
                    (lambda ()
                      (icv-nz-of-pos! 'w)
                      (fact 'etimes-pos-inf-right 'w)
                      (dk-have! (list '<= 'POS-INF tt)
                        (lambda ()
                          (subst (list '= 'POS-INF (list 'etimes 'w 'POS-INF)))
                          (subst (list '= 'POS-INF mn))
                          (ass)))
                      (fact 'pos-inf-above-reals tt)
                      (icv-keep-prop! (list '<= 'POS-INF tt) (list 'NOT (list '<= 'POS-INF tt))))))))
            (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR)
                            (list 'FORALL 'x (list 'IMPLIES '(IN x (IMAGE m NN)) (list '<= 'x b)))))
            (dk-fact! 'esup-least '(IMAGE m NN) b)
            (dk-have! (list 'AND (list 'IN sm 'RR-POS-STAR) (list 'IN b 'RR)))
            (fact 'rr-pos-star-le-real-in-rr sm b)
            (fact 'rr-pos-star-nonneg sm)
            (icv-etimes-eq! 'w sm)
            (subst (list '= (list 'etimes 'w sm) (list '* 'w sm)))
            (dk-have! (list 'AND (list '<= 0 'w) (list '<= sm b)))
            (fact 'rr-le-scale-nonneg 'w sm b)
            (dk-have! (list '= (list '* 'w b) tt)
              (lambda ()
                (dk-have! (list '= (list '* 'w b) (list '* tt (list '* 'w uw))) (lambda () (dk-crs-opaque!)))
                (subst (list '= (list '* 'w b) (list '* tt (list '* 'w uw))))
                (subst (list '= (list '* 'w uw) 1))
                (crs)))
            (subst (list '= tt (list '* 'w b)))
            (ass)))
        (lambda ()
          (subst (list '= tt 'POS-INF))
          (dk-have! (list 'AND '(IN w RR-POS-STAR) (list 'IN sm 'RR-POS-STAR)))
          (fact 'etimes-closed 'w sm)
          (fact 'rr-pos-star-below-pos-inf (list 'etimes 'w sm))
          (ass))))))
(qed 'esup-etimes-ge)
(topic! 'esup-etimes-ge 'inequalities)
;;; =====================================================================
;;; (J) A SCALED SIMPLE FUNCTION RESTRICTED TO A SET.  For s simple, c >= 0
;;;     real and a set B meeting every level set { s = y } measurably, the
;;;     function t = c s on B, 0 off B, is simple and
;;;        SIMPLE-INTEGRAL(t) = SUM_{y in s(omega)} (c y) * mu({ s = y } n B).
;;;     t is factored through k : omega -> s(omega) u {+inf}, k = s on B and
;;;     +inf off B, and hh(p) = c p (hh(+inf) = 0); simple-integral-partition.
;;; =====================================================================

(define (icv-in-pair-self! kv)
  (dk-have! (list 'IN kv (list 'PAIR kv kv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN kv 'SET) (list 'IN kv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership kv kv) kv)))
        (have! (list '= kv kv) (lambda () (rfl)))
        (icv-keep-prop! pm (list '= kv kv))))))

;;; the conjuncts of a predicate's defining iff, landed, kept (igl-parts!)
(define (icv-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs  (let loop ((r rhs) (acc '()))
                (if (and (pair? r) (eq? (car r) 'and))
                    (loop (caddr r) (cons (cadr r) acc))
                    (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c pred (cons pred args))) cs)))

;;; tm = phi(kv) is in IMAGE(phi, d): (IN kv d), (IN tm RR-POS-STAR) in context
(define (icv-in-img! phi d kv tm)
  (let* ((iff (dk-cite! 'image-membership-iff phi d tm))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (if (not (dk-asm? lhs))
        (begin
          (dk-have! rhs
            (lambda ()
              (icv-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond ((dk-asm? g) (ass))
                          ((eq? (car g) 'FORSOME)
                           (ew kv)
                           (icv-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                          (#t (fact 'membership-implies-sethood tm 'RR-POS-STAR) (ass))))))))
          (ai iff)
          (detach! (list 'IMPLIES rhs lhs))))))

;;; y in IMAGE(s, omega), s simple (parts in context): (IN y RR), (<= 0 y), (IN y RR-POS-STAR)
(define (icv-range-real! y)
  (if (not (and (dk-asm? (list 'IN y 'RR)) (dk-asm? (list '<= 0 y)) (dk-asm? (list 'IN y 'RR-POS-STAR))))
      (icv-range-real-core! y)))
(define (icv-range-real-core! y)
  (let ((cj (list 'AND (list 'IN y 'RR) (list '<= 0 y))))
    (if (and (pair? y) (eq? (car y) 's) (dk-asm? (list 'IN (cadr y) 'omega))
             (not (and (dk-asm? (list 'IN y 'RR)) (dk-asm? (list '<= 0 y)))))
        (begin
          (inst+ (icv-ptw 'omega (lambda (z) (list 'IN (list 's z) 'RR))) (cadr y))
          (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR (cadr y))
          (fact 'rr-pos-star-nonneg y)))
    (if (not (and (dk-asm? (list 'IN y 'RR)) (dk-asm? (list '<= 0 y))))
        (begin
          (dk-have! cj
            (lambda ()
              (let* ((ex (dk-image-hyp! (list 'IN y '(IMAGE s omega))))
                     (x  (dk-skolem! ex)))
                (inst+ (icv-ptw 'omega (lambda (z) (list 'IN (list 's z) 'RR))) x)
                (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
                (fact 'rr-pos-star-nonneg (list 's x))
                (icv-conj-close!
                  (lambda () (subst (list '= y (list 's x))) (dk-ass!))))))
          (dk-split! cj)))
    (icv-rps! y)))

(define icv-yy '(IMAGE s omega))
(define (icv-lev y) (list 'SEP 'six_ 'omega (list '= '(s six_) y)))
(define (icv-ab y) (list 'INTERSECTION (icv-lev y) 'bset))
(define icv-ks '(UNION (IMAGE s omega) (PAIR POS-INF POS-INF)))
(define (icv-kif x) (list 'IF (list 'IN x 'bset) (list 's x) 'POS-INF))
(define (icv-hif p) (list 'IF (list '= p 'POS-INF) 0 (list '* 'c p)))
(define (icv-fib kf p) (list 'SEP 'fx_ 'omega (list '= (list kf 'fx_) p)))
(define icv-rlam '(VNB-LAMBDA y_ (IMAGE s omega)
                    (etimes (* c y_) (mu (INTERSECTION (SEP six_ omega (= (s six_) y_)) bset)))))

;;; simple-restrict-integral
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s (FORALL c (FORALL bset (FORALL tf
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
              (IMPLIES (FORALL y_ (IMPLIES (IN y_ (IMAGE s omega))
                         (IN (INTERSECTION (SEP six_ omega (= (s six_) y_)) bset) cA)))
                (IMPLIES (IN tf (FUN omega RR-POS-STAR))
                  (IMPLIES (FORALL x (IMPLIES (IN x omega) (= (tf x) (IF (IN x bset) (* c (s x)) 0))))
                    (AND (IS-SIMPLE-FN omega cA tf)
                         (= (SIMPLE-INTEGRAL omega mu tf)
                            (FINSUM RR-POS-STAR-ADD-MONOID
                              (VNB-LAMBDA y_ (IMAGE s omega)
                                (etimes (* c y_) (mu (INTERSECTION (SEP six_ omega (= (s six_) y_)) bset))))
                              (IMAGE s omega))))))))))))))))))))
(dk-peel!)
(let* ((yy icv-yy) (ks icv-ks)
       (hab '(FORALL y_ (IMPLIES (IN y_ (IMAGE s omega))
                (IN (INTERSECTION (SEP six_ omega (= (s six_) y_)) bset) cA))))
       (htv '(FORALL x (IMPLIES (IN x omega) (= (tf x) (IF (IN x bset) (* c (s x)) 0))))))
  (icv-parts! 'IS-MEASURE '(omega cA mu))
  (icv-parts! 'IS-SIMPLE-FN '(omega cA s))
  (icv-parts! 'IS-MEASURABLE-FN '(omega cA s))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'image-set 's 'omega)
  (icv-rps-setup!)
  (fact 'pos-inf-in-rr-pos-star)
  (fact 'membership-implies-sethood 'POS-INF 'RR-POS-STAR)
  (fact 'pos-inf-not-in-rr)
  (dk-have! (list 'NOT (list 'IN 'POS-INF yy))
    (lambda ()
      (di)
      (icv-range-real-core! 'POS-INF)
      (icv-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))
  ;; KS = s(omega) u {+inf}: a finite set
  (dk-have! (list 'AND '(IN POS-INF SET) '(IN POS-INF SET)))
  (fact 'pairing 'POS-INF 'POS-INF)
  (dk-have! (list 'AND (list 'IN yy 'SET) '(IN (PAIR POS-INF POS-INF) SET)))
  (fact 'union-set-closure yy '(PAIR POS-INF POS-INF))
  (dk-split! (dk-fact! 'card-union-singleton-bound yy 'POS-INF))
  (fact 'union-comm '(PAIR POS-INF POS-INF) yy)
  (dk-have! (list 'IN (list 'CARD ks) 'NN)
    (lambda () (subst (list '= ks (list 'UNION '(PAIR POS-INF POS-INF) yy))) (ass)))
  (let* ((in-ks-left! (lambda (z) (dk-have! (list 'IN z ks)
                                    (lambda () (mac 'union-membership) (oi-l) (dk-ass!)))))
         (inf-in-ks! (lambda ()
                       (icv-in-pair-self! 'POS-INF)
                       (dk-have! (list 'IN 'POS-INF ks)
                         (lambda () (mac 'union-membership) (oi-r) (dk-ass!)))))
         (sx-in-yy! (lambda (x)
                      (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
                      (icv-in-img! 's 'omega x (list 's x))))
         (k-typed! (lambda (x)
                     (let ((ift (icv-kif x)))
                       (dk-case-if! ift
                         (lambda (tr v)
                           (if tr
                               (begin (sx-in-yy! x) (in-ks-left! (list 's x)) (dk-ass!))
                               (begin (inf-in-ks!) (dk-ass!))))))))
         (kve (icv-abstract! 'omega ks icv-kif
                (lambda (x) (k-typed! x))
                (lambda (x)
                  (dk-have! (list 'IN (icv-kif x) ks) (lambda () (k-typed! x)))
                  (fact 'membership-implies-sethood (icv-kif x) ks))))
         (kf (car kve)) (kv (cdr kve))
         ;; k(x) = s(x) on B, +inf off B
         (k-in! (lambda (x)
                  (dk-have! (list '= (list kf x) (list 's x))
                    (lambda ()
                      (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
                      (dk-apply! kv x)
                      (subst (list '== (list kf x) (icv-kif x)))
                      (dk-if-branch! #t (icv-kif x) #f (lambda () (rfl)))))))
         (k-out! (lambda (x)
                   (dk-have! (list '= (list kf x) 'POS-INF)
                     (lambda ()
                       (dk-apply! kv x)
                       (subst (list '== (list kf x) (icv-kif x)))
                       (dk-if-branch! #f (icv-kif x) #f (lambda () (rfl)))))))
         (k-in-ks! (lambda (x)
                     (fact 'fun-apply-type-c kf 'omega ks x))))
    ;; the fibres over s(omega): { k = y } = { s = y } n B
    (dk-have! (icv-ptw yy (lambda (z) (list '= (icv-fib kf z) (icv-ab z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (icv-range-real! z)
          (icv-set-eq! (icv-fib kf z) (icv-ab z)
            (lambda (w)
              (sep-me (list 'IN w (icv-fib kf z)))
              (use-em (list 'IN w 'bset)
                (lambda ()
                  (k-in! w)
                  (mac 'intersection-membership)
                  (icv-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (icv-sep-in!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (begin (subst (list '= (list 's w) (list kf w))) (ass)))))))))
                (lambda ()
                  (k-out! w)
                  (dk-have! (list 'IN 'POS-INF yy)
                    (lambda () (subst (list '= 'POS-INF (list kf w))) (subst (list '= (list kf w) z)) (ass)))
                  (icv-keep-prop! (list 'IN 'POS-INF yy) (list 'NOT (list 'IN 'POS-INF yy))))))
            (lambda (w)
              (mac-h 'intersection-membership (list 'IN w (icv-ab z)))
              (dk-split-all!)
              (sep-me (list 'IN w (icv-lev z)))
              (k-in! w)
              (icv-sep-in!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (begin (subst (list '= (list kf w) (list 's w))) (ass)))))))
          (dk-ass!))))
    (let* ((fibeq (icv-ptw yy (lambda (z) (list '= (icv-fib kf z) (icv-ab z)))))
           (pre   (list 'SEP 'fx_ 'omega (list 'IN (list kf 'fx_) yy))))
      (dk-have! (icv-ptw yy (lambda (z) (list 'IN (icv-fib kf z) 'cA)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-apply! fibeq z)
            (dk-apply! hab z)
            (subst (list '= (icv-fib kf z) (icv-ab z)))
            (ass))))
      (fact 'sigma-algebra-preimage-finite-in 'omega 'cA yy kf)
      (fact 'sigma-algebra-complement-closed 'omega 'cA pre)
      ;; every fibre over KS is measurable
      (dk-have! (icv-ptw ks (lambda (z) (list 'IN (icv-fib kf z) 'cA)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (mac-h 'union-membership (list 'IN z ks))
            (let ((dis (dk-pick (dk-head? 'or) "the KS cases")))
              (use-cases dis
                (lambda ()
                  (inst+ (icv-ptw yy (lambda (zz) (list 'IN (icv-fib kf zz) 'cA))) z)
                  (dk-ass!))
                (lambda ()
                  (let ((pm (dk-cite! 'pairing-membership 'POS-INF 'POS-INF)))
                    (dk-have! (list '= z 'POS-INF)
                      (lambda ()
                        (let ((ins (inst*! pm z)))
                          (icv-keep-prop! ins (list 'IN z '(PAIR POS-INF POS-INF))))))
                    (subst (list '= z 'POS-INF))
                    (icv-set-eq! (icv-fib kf 'POS-INF) (list 'COMPLEMENT-IN 'omega pre)
                      (lambda (w)
                        (sep-me (list 'IN w (icv-fib kf 'POS-INF)))
                        (mac 'complement-in-membership)
                        (icv-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin
                                  (di)
                                  (sep-me (list 'IN w pre))
                                  (dk-have! (list 'IN 'POS-INF yy)
                                    (lambda () (subst (list '= 'POS-INF (list kf w))) (ass)))
                                  (icv-keep-prop! (list 'IN 'POS-INF yy) (list 'NOT (list 'IN 'POS-INF yy))))))))
                      (lambda (w)
                        (mac-h 'complement-in-membership (list 'IN w (list 'COMPLEMENT-IN 'omega pre)))
                        (dk-split-all!)
                        (use-em (list 'IN w 'bset)
                          (lambda ()
                            (k-in! w)
                            (sx-in-yy! w)
                            (dk-have! (list 'IN w pre)
                              (lambda ()
                                (icv-sep-in!
                                  (lambda ()
                                    (if (dk-asm? (dk-goal))
                                        (ass)
                                        (begin (subst (list '= (list kf w) (list 's w))) (ass)))))))
                            (icv-keep-prop! (list 'IN w pre) (list 'NOT (list 'IN w pre))))
                          (lambda ()
                            (k-out! w)
                            (icv-sep-in! (lambda () (dk-ass!)))))))
                    (subst (list '= (icv-fib kf 'POS-INF) (list 'COMPLEMENT-IN 'omega pre)))
                    (ass))))))))
      ;; hh(p) = c p, hh(+inf) = 0
      (let* ((h-typed! (lambda (p)
                         (dk-case-if! (icv-hif p)
                           (lambda (tr v)
                             (if tr
                                 (begin (fact 'rr-zero-in) (dk-ass!))
                                 (begin
                                   (mac-h 'union-membership (list 'IN p ks))
                                   (let ((dis (dk-pick (dk-head? 'or) "the KS cases")))
                                     (use-cases dis
                                       (lambda () (icv-range-real! p) (icv-mul-rr! 'c p) (dk-ass!))
                                       (lambda ()
                                         (let ((pm (dk-cite! 'pairing-membership 'POS-INF 'POS-INF)))
                                           (dk-have! (list '= p 'POS-INF)
                                             (lambda ()
                                               (let ((ins (inst*! pm p)))
                                                 (icv-keep-prop! ins (list 'IN p '(PAIR POS-INF POS-INF))))))
                                           (icv-keep-prop! (list '= p 'POS-INF) (list 'NOT (list '= p 'POS-INF)))))))))))))
             (hve (icv-abstract! ks 'RR icv-hif
                    (lambda (p) (h-typed! p))
                    (lambda (p)
                      (dk-have! (list 'IN (icv-hif p) 'RR) (lambda () (h-typed! p)))
                      (fact 'membership-implies-sethood (icv-hif p) 'RR))))
             (hf (car hve)) (hv (cdr hve))
             (h-real! (lambda (p)    ; p in Y: hh(p) = c p
                        (dk-have! (list '= (list hf p) (list '* 'c p))
                          (lambda ()
                            (icv-range-real! p)
                            (icv-mul-rr! 'c p)
                            (dk-have! (list 'NOT (list '= p 'POS-INF))
                              (lambda ()
                                (di)
                                (dk-have! (list 'IN 'POS-INF yy) (lambda () (subst (list '= 'POS-INF p)) (ass)))
                                (icv-keep-prop! (list 'IN 'POS-INF yy) (list 'NOT (list 'IN 'POS-INF yy)))))
                            (in-ks-left! p)
                            (dk-apply! hv p)
                            (subst (list '== (list hf p) (icv-hif p)))
                            (dk-if-branch! #f (icv-hif p) #f (lambda () (rfl)))))))
             (h-inf! (lambda ()
                       (dk-have! (list '= (list hf 'POS-INF) 0)
                         (lambda ()
                           (inf-in-ks!)
                           (dk-apply! hv 'POS-INF)
                           (subst (list '== (list hf 'POS-INF) (icv-hif 'POS-INF)))
                           (dk-if-branch! #t (icv-hif 'POS-INF) (lambda () (rfl)) (lambda () (rfl))))))))
        (dk-have! (icv-ptw ks (lambda (z) (list 'IN (list hf z) 'RR)))
          (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c hf ks 'RR z) (dk-ass!))))
        (dk-have! (icv-ptw ks (lambda (z) (list '<= 0 (list hf z))))
          (lambda ()
            (let ((z (dk-di-var!)))
              (mac-h 'union-membership (list 'IN z ks))
              (let ((dis (dk-pick (dk-head? 'or) "the KS cases")))
                (use-cases dis
                  (lambda ()
                    (icv-range-real! z)
                    (h-real! z)
                    (icv-mul-nonneg! 'c z)
                    (subst (list '= (list hf z) (list '* 'c z)))
                    (dk-ass!))
                  (lambda ()
                    (let ((pm (dk-cite! 'pairing-membership 'POS-INF 'POS-INF)))
                      (dk-have! (list '= z 'POS-INF)
                        (lambda ()
                          (let ((ins (inst*! pm z)))
                            (icv-keep-prop! ins (list 'IN z '(PAIR POS-INF POS-INF))))))
                      (subst (list '= z 'POS-INF))
                      (h-inf!)
                      (subst (list '= (list hf 'POS-INF) 0))
                      (fact 'rr-zero-in)
                      (fact 'rr-leq-reflexive 0)
                      (dk-ass!))))))))
        (dk-have! (icv-ptw 'omega (lambda (z) (list 'IN (list kf z) ks)))
          (lambda () (let ((z (dk-di-var!))) (k-in-ks! z) (dk-ass!))))
        ;; tf = hh o k
        (dk-have! (icv-ptw 'omega (lambda (z) (list '= (list 'tf z) (list hf (list kf z)))))
          (lambda ()
            (let* ((x (dk-di-var!)) (tif (list 'IF (list 'IN x 'bset) (list '* 'c (list 's x)) 0)))
              (dk-apply! htv x)
              (subst (list '= (list 'tf x) tif))
              (use-em (list 'IN x 'bset)
                (lambda ()
                  (k-in! x)
                  (sx-in-yy! x)
                  (h-real! (list 's x))
                  (subst (list '= (list kf x) (list 's x)))
                  (subst (list '= (list hf (list 's x)) (list '* 'c (list 's x))))
                  (dk-if-branch! #t tif #f (lambda () (rfl))))
                (lambda ()
                  (k-out! x)
                  (h-inf!)
                  (subst (list '= (list kf x) 'POS-INF))
                  (subst (list '= (list hf 'POS-INF) 0))
                  (fact 'rr-zero-in)
                  (dk-if-branch! #f tif #f (lambda () (rfl))))))))
        (fact 'simple-fn-of-partition 'omega 'cA ks kf hf 'tf)
        ;; the simple integral by the partition
        (let* ((gif (lambda (p) (list 'etimes (list hf p) (list 'mu (icv-fib kf p)))))
               (g-typed! (lambda (p)
                           (fact 'fun-apply-type-c hf ks 'RR p)
                           (inst+ (icv-ptw ks (lambda (z) (list '<= 0 (list hf z)))) p)
                           (icv-rps! (list hf p))
                           (inst+ (icv-ptw ks (lambda (z) (list 'IN (icv-fib kf z) 'cA))) p)
                           (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-fib kf p))
                           (dk-have! (list 'AND (list 'IN (list hf p) 'RR-POS-STAR)
                                           (list 'IN (list 'mu (icv-fib kf p)) 'RR-POS-STAR)))
                           (fact 'etimes-closed (list hf p) (list 'mu (icv-fib kf p)))))
               (gve (icv-abstract! ks 'RR-POS-STAR gif
                      (lambda (p) (g-typed! p) (dk-ass!))
                      (lambda (p) (g-typed! p) (fact 'membership-implies-sethood (gif p) 'RR-POS-STAR))))
               (gf (car gve)) (gv (cdr gve))
               (sint '(SIMPLE-INTEGRAL omega mu tf)))
          (dk-have! (icv-ptw ks (lambda (z) (list '= (list gf z) (gif z))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (g-typed! z)
                (dk-apply! gv z)
                (subst (list '== (list gf z) (gif z)))
                (rfl))))
          (dk-have! (icv-ptw ks (lambda (z) (list 'IN (list gf z) 'RR-POS-STAR)))
            (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c gf ks 'RR-POS-STAR z) (dk-ass!))))
          (fact 'simple-integral-partition 'omega 'cA 'mu 'tf ks kf hf gf)
          (dk-have! (icv-ptw yy (icv-rps-of gf))
            (lambda ()
              (let ((z (dk-di-var!)))
                (in-ks-left! z)
                (fact 'fun-apply-type-c gf ks 'RR-POS-STAR z)
                (dk-ass!))))
          (inf-in-ks!)
          (icv-rps-insert! yy 'POS-INF ks gf)
          (dk-apply! (icv-ptw ks (lambda (z) (list '= (list gf z) (gif z)))) 'POS-INF)
          (h-inf!)
          (inst+ (icv-ptw ks (lambda (z) (list 'IN (icv-fib kf z) 'cA))) 'POS-INF)
          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-fib kf 'POS-INF))
          (fact 'etimes-zero-left (list 'mu (icv-fib kf 'POS-INF)))
          (dk-have! (list '= (list gf 'POS-INF) 0)
            (lambda ()
              (subst (list '= (list gf 'POS-INF) (gif 'POS-INF)))
              (subst (list '= (list hf 'POS-INF) 0))
              (ass)))
          (icv-rps-typed! yy gf)
          (fact 'eplus-zero-right (icv-fs gf yy))
          ;; FINSUM over Y of gg is the stated sum
          (dk-have! (icv-ptw yy (lambda (z) (list '= (list gf z) (list icv-rlam z))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (in-ks-left! z)
                (icv-range-real! z)
                (icv-mul-rr! 'c z)
                (dk-apply! (icv-ptw ks (lambda (zz) (list '= (list gf zz) (gif zz)))) z)
                (dk-apply! fibeq z)
                (h-real! z)
                (dk-apply! hab z)
                (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-ab z))
                (icv-mul-nonneg! 'c z)
                (icv-rps! (list '* 'c z))
                (dk-have! (list 'AND (list 'IN (list '* 'c z) 'RR-POS-STAR) (list 'IN (list 'mu (icv-ab z)) 'RR-POS-STAR)))
                (fact 'etimes-closed (list '* 'c z) (list 'mu (icv-ab z)))
                (subst (list '= (list gf z) (gif z)))
                (subst (list '= (list hf z) (list '* 'c z)))
                (subst (list '= (icv-fib kf z) (icv-ab z)))
                (if (not (dk-lam-b!)) (rfl)))))
          (fact 'finsum-cm-congruence-q icv-m yy gf icv-rlam)
          (icv-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin
                    (subst (list '= sint (icv-fs gf ks)))
                    (subst (list '= (icv-fs gf ks) (list 'eplus (icv-fs gf yy) (list gf 'POS-INF))))
                    (subst (list '= (list gf 'POS-INF) 0))
                    (subst (list '= (list 'eplus (icv-fs gf yy) 0) (icv-fs gf yy)))
                    (icv-rps-typed! yy gf)
                    (dk-have! (list 'IN (icv-fs icv-rlam yy) 'RR-POS-STAR)
                      (lambda () (subst (list '== (icv-fs icv-rlam yy) (icv-fs gf yy))) (ass)))
                    (subst (list '== (icv-fs gf yy) (icv-fs icv-rlam yy)))
                    (rfl))))))))))
(qed 'simple-restrict-integral)
(topic! 'simple-restrict-integral 'analysis)
;;; =====================================================================
;;; (K) THE CORE OF MONOTONE CONVERGENCE (Rudin 1.26): for a simple s below
;;;     sup f_n and 0 < c < 1, the sets E_n = { c s <= f_n } increase to
;;;     omega on every level set of s, the restriction of c s to E_n is a
;;;     simple function below f_n, and its integral
;;;        SUM_y (c y) mu({s = y} n E_n)
;;;     has, by continuity from below and rps-finsum-esup-le, supremum at
;;;     least c SIMPLE-INTEGRAL(s).  Then c -> 1 (rps-le-of-scaled).
;;; =====================================================================

(define (icv-en n) (list 'SEP 'ex_ 'omega (list '<= (list '* 'c '(s ex_)) (list (list 'cf n) 'ex_))))
(define (icv-gn n y) (list 'SEP 'gx_ 'omega (list '<= (list '* 'c y) (list (list 'cf n) 'gx_))))
(define (icv-ae n y) (list 'INTERSECTION (icv-lev y) (icv-en n)))
(define icv-hh '(VNB-LAMBDA hn_ NN (VNB-LAMBDA y_ (IMAGE s omega)
                   (etimes (* c y_) (mu (INTERSECTION (SEP six_ omega (= (s six_) y_))
                                                     (SEP ex_ omega (<= (* c (s ex_)) ((cf hn_) ex_)))))))))
(define (icv-rl n) (list 'VNB-LAMBDA 'y_ '(IMAGE s omega)
                         (list 'etimes '(* c y_) (list 'mu (list 'INTERSECTION '(SEP six_ omega (= (s six_) y_))
                                                                  (icv-en n))))))
(define icv-af '(VNB-LAMBDA y_ (IMAGE s omega)
                  (ESUP (IMAGE (VNB-LAMBDA m_ NN (((VNB-LAMBDA hn_ NN (VNB-LAMBDA y_ (IMAGE s omega)
                   (etimes (* c y_) (mu (INTERSECTION (SEP six_ omega (= (s six_) y_))
                                                     (SEP ex_ omega (<= (* c (s ex_)) ((cf hn_) ex_)))))))) m_) y_)) NN))))
(define (icv-hseq z) (list 'VNB-LAMBDA 'm_ 'NN (list (list icv-hh 'm_) z)))
(define icv-sl '(VNB-LAMBDA y_ (IMAGE s omega) (etimes (* c y_) (mu (SEP six_ omega (= (s six_) y_))))))
(define icv-sv '(VNB-LAMBDA siy_ (IMAGE s omega) (etimes siy_ (mu (SEP six_ omega (= (s six_) siy_))))))
(define icv-il '(VNB-LAMBDA n_ NN (INTEGRAL omega cA mu (cf n_))))

;;; mct-simple-below
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL cF (FORALL s
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IN cF (FUN NN (FUN omega RR-POS-STAR)))
            (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cF n_))))
              (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (PTWISE-LE omega (cF n_) (cF (succ n_)))))
                (IMPLIES (IS-SIMPLE-FN omega cA s)
                  (IMPLIES (PTWISE-LE omega s (PTWISE-SUP omega cF))
                    (<= (SIMPLE-INTEGRAL omega mu s)
                        (ESUP (IMAGE (VNB-LAMBDA n_ NN (INTEGRAL omega cA mu (cF n_))) NN))))))))))))))))
(dk-peel!)
(define icv-hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
(define icv-hmono '(FORALL n_ (IMPLIES (IN n_ NN) (PTWISE-LE omega (cf n_) (cf (succ n_))))))
(icv-parts! 'IS-MEASURE '(omega cA mu))
(icv-parts! 'IS-SIMPLE-FN '(omega cA s))
(icv-parts! 'IS-MEASURABLE-FN '(omega cA s))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'image-set 's 'omega)
(icv-rps-setup!)
(fact 'simple-integral-in 'omega 'cA 'mu 's)

;;; (cf n)(w) typed; IS-MEASURABLE-FN (cf n)
(define (icv-fnw! n w)
  (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) n)
  (fact 'fun-apply-type-c (list 'cf n) 'omega 'RR-POS-STAR w))
(define (icv-fn-meas! n)
  (if (not (dk-asm? (list 'IS-MEASURABLE-FN 'omega 'cA (list 'cf n))))
      (dk-apply! icv-hm n)))
;;; (<= ((cf n) w) ((cf (succ n)) w)), w in omega, n in NN
(define (icv-step-le! n w)
  (let ((pl (dk-apply! icv-hmono n)))
    (let ((iff (dk-cite! 'PTWISE-LE 'omega (list 'cf n) (list 'cf (list 'succ n)))))
      (dk-have! (list '<= (list (list 'cf n) w) (list (list 'cf (list 'succ n)) w))
        (lambda ()
          (ai iff)
          (let ((fa (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))
            (dk-apply! (caddr iff) w)
            (dk-ass!)))))))

;;; L in RR-POS-STAR
(dk-have! (list 'IN icv-il '(FUN NN RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((n (dk-di-var!)))
          (icv-fn-meas! n)
          (fact 'integral-in 'omega 'cA 'mu (list 'cf n))
          (dk-ass!))))))
(define icv-ll (icv-seq-sup! icv-il))

;;; MEAS: { s = y } n E_n is measurable
(define (icv-ae-meas! n y)
  (if (not (dk-asm? (list 'IN (icv-ae n y) 'cA)))
      (dk-have! (list 'IN (icv-ae n y) 'cA)
        (lambda ()
          (icv-range-real! y)
          (icv-mul-rr! 'c y)
          (icv-fn-meas! n)
          (fact 'measurable-fn-level-set 'omega 'cA 's y)
          (fact 'measurable-fn-ge 'omega 'cA (list 'cf n) (list '* 'c y))
          (dk-have! (list 'IN (icv-lev y) 'cA) (lambda () (dk-ass!)))
          (fact 'sigma-algebra-inter-closed-2 'omega 'cA (icv-lev y) (icv-gn n y))
          (icv-set-eq! (icv-ae n y) (list 'INTERSECTION (icv-lev y) (icv-gn n y))
            (lambda (w)
              (mac-h 'intersection-membership (list 'IN w (icv-ae n y)))
              (dk-split-all!)
              (sep-me (list 'IN w (icv-en n)))
              (mac 'intersection-membership)
              (icv-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (begin
                        (dk-have! (list '= (list 's w) y)
                          (lambda () (sep-me (list 'IN w (icv-lev y))) (ass)))
                        (icv-sep-in!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin (subst (list '= y (list 's w))) (ass))))))))))
            (lambda (w)
              (mac-h 'intersection-membership (list 'IN w (list 'INTERSECTION (icv-lev y) (icv-gn n y))))
              (dk-split-all!)
              (sep-me (list 'IN w (icv-gn n y)))
              (mac 'intersection-membership)
              (icv-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (begin
                        (dk-have! (list '= (list 's w) y)
                          (lambda () (sep-me (list 'IN w (icv-lev y))) (ass)))
                        (icv-sep-in!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin (subst (list '= (list 's w) y)) (ass)))))))))))
          (subst (list '= (icv-ae n y) (list 'INTERSECTION (icv-lev y) (icv-gn n y))))
          (ass)))))

;;; E_n subset E_(n+1)
(define (icv-en-mono! n)
  (let ((n1 (list 'succ n)))
    (if (not (dk-asm? (list 'SUBSET (icv-en n) (icv-en n1))))
        (dk-have! (list 'SUBSET (icv-en n) (icv-en n1))
          (lambda ()
            (mac 'subset-def)
            (let ((w (dk-di-var!)))
              (sep-me (list 'IN w (icv-en n)))
              (fact 'nn-succ-closed n)
              (icv-fnw! n w)
              (icv-fnw! n1 w)
              (icv-step-le! n w)
              (icv-range-real! (list 's w))
              (icv-mul-nonneg! 'c (list 's w))
              (icv-rps! (list '* 'c (list 's w)))
              (let ((a (list '* 'c (list 's w))) (b (list (list 'cf n) w)) (d (list (list 'cf n1) w)))
                (dk-have! (list 'AND (list 'IN a 'RR-POS-STAR) (list 'AND (list 'IN b 'RR-POS-STAR) (list 'IN d 'RR-POS-STAR))))
                (dk-have! (list 'AND (list '<= a b) (list '<= b d)))
                (fact 'rr-pos-star-le-trans a b d))
              (icv-sep-in! (lambda () (dk-ass!)))))))))

;;; (H n)(y) typed: etimes(c y, mu(A_y n E_n)) in RR-POS-STAR
(define (icv-hval-typed! n y)
  (let ((e (list 'etimes (list '* 'c y) (list 'mu (icv-ae n y)))))
    (if (not (dk-asm? (list 'IN e 'RR-POS-STAR)))
        (begin
          (icv-range-real! y)
          (icv-mul-nonneg! 'c y)
          (icv-rps! (list '* 'c y))
          (icv-ae-meas! n y)
          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-ae n y))
          (dk-have! (list 'AND (list 'IN (list '* 'c y) 'RR-POS-STAR) (list 'IN (list 'mu (icv-ae n y)) 'RR-POS-STAR)))
          (fact 'etimes-closed (list '* 'c y) (list 'mu (icv-ae n y)))))
    e))
(define icv-af-sym #f)
(define icv-hseq-typed-g #f)
;;; the restriction t_n of c s to E_n
(define (icv-tif n x) (list 'IF (list 'IN x (icv-en n)) (list '* 'c (list 's x)) 0))
(define (icv-tn n) (list 'VNB-LAMBDA 'tx_ 'omega (icv-tif n 'tx_)))
(define (icv-tif-typed! n x)
  (if (not (dk-asm? (list 'IN (icv-tif n x) 'RR-POS-STAR)))
      (dk-have! (list 'IN (icv-tif n x) 'RR-POS-STAR)
        (lambda ()
          (dk-case-if! (icv-tif n x)
            (lambda (tr v)
              (if tr
                  (begin
                    (icv-range-real! (list 's x))
                    (icv-mul-nonneg! 'c (list 's x))
                    (icv-rps! (list '* 'c (list 's x)))
                    (dk-ass!))
                  (begin
                    (fact 'rr-zero-in)
                    (fact 'rr-leq-reflexive 0)
                    (icv-rps! 0)
                    (dk-ass!)))))))))

;;; the scaled bound: c SIMPLE-INTEGRAL(s) <= L for 0 < c < 1
(dk-have! (list 'FORALL 'c (list 'IMPLIES '(IN c RR) (list 'IMPLIES '(< 0 c) (list 'IMPLIES '(< c 1)
            (list '<= '(etimes c (SIMPLE-INTEGRAL omega mu s)) icv-ll)))))
  (lambda ()
    (dk-peel!)
    (fact 'rr-lt-implies-le 0 'c)
    (let ((yy '(IMAGE s omega)))
      ;; H in FUN(NN, FUN(Y, RR-POS-STAR))
      (dk-have! (list 'IN icv-hh '(FUN NN (FUN (IMAGE s omega) RR-POS-STAR)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((n (dk-di-var!)))
                (dk-lam-type!
                  (lambda ()
                    (let ((y (dk-di-var!)))
                      (icv-hval-typed! n y)
                      (dk-ass!)))))))))
      ;; monotone in n
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ yy)
                  (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                    (list '<= (list (list icv-hh 'n) 'z_) (list (list icv-hh '(succ n)) 'z_))))))
        (lambda ()
          (let* ((landed (dk-peel!))
                 (z (cadr (car (filter (lambda (f) (equal? (caddr f) '(image s omega))) landed))))
                 (n (cadr (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed))))
                 (n1 (list 'succ n)))
            (fact 'nn-succ-closed n)
            (icv-hval-typed! n z)
            (icv-hval-typed! n1 z)
            (icv-en-mono! n)
            (icv-ae-meas! n z)
            (icv-ae-meas! n1 z)
            (dk-have! (list 'SUBSET (icv-ae n z) (icv-ae n1 z))
              (lambda ()
                (mac 'subset-def)
                (let ((w (dk-di-var!)))
                  (mac-h 'intersection-membership (list 'IN w (icv-ae n z)))
                  (dk-split-all!)
                  (fact 'subset-mem-fwd (icv-en n) (icv-en n1) w)
                  (mac 'intersection-membership)
                  (icv-conj-close! (lambda () (dk-ass!))))))
            (fact 'measure-monotone 'omega 'cA 'mu (icv-ae n z) (icv-ae n1 z))
            (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-ae n z))
            (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-ae n1 z))
            (dk-have! (list 'AND (list 'IN (list 'mu (icv-ae n z)) 'RR-POS-STAR)
                            (list 'IN (list 'mu (icv-ae n1 z)) 'RR-POS-STAR)))
            (fact 'etimes-mono-left (list '* 'c z) (list 'mu (icv-ae n z)) (list 'mu (icv-ae n1 z)))
            (if (not (dk-lam-b!)) (dk-ass!)))))
      ;; A(y) = sup_n (H n)(y), as a function symbol on Y
      (let* ((hseq-typed! (lambda (z)
                            (if (not (dk-asm? (list 'IN (icv-hseq z) '(FUN NN RR-POS-STAR))))
                                (dk-have! (list 'IN (icv-hseq z) '(FUN NN RR-POS-STAR))
                                  (lambda ()
                                    (dk-lam-type!
                                      (lambda ()
                                        (let ((m (dk-di-var!)))
                                          (icv-hval-typed! m z)
                                          (if (not (dk-lam-b!)) (dk-ass!))))))))
                            (icv-seq-sup! (icv-hseq z))))
             (afe (icv-abstract! yy 'RR-POS-STAR (lambda (z) (list 'ESUP (list 'IMAGE (icv-hseq z) 'NN)))
                    (lambda (z) (hseq-typed! z) (dk-ass!))
                    (lambda (z) (let ((e (hseq-typed! z))) (fact 'membership-implies-sethood e 'RR-POS-STAR)))))
             (af (car afe)) (afv (cdr afe)))
        (set! icv-af-sym af)
        (set! icv-hseq-typed-g hseq-typed!)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ yy)
                    (list '= (list af 'z_) (list 'ESUP (list 'IMAGE (icv-hseq 'z_) 'NN)))))
          (lambda ()
            (let* ((z (dk-di-var!)) (e (hseq-typed! z)))
              (dk-apply! afv z)
              (subst (list '== (list af z) e))
              (rfl)))))
      ;; the bound at each n: SUM_y (H n)(y) = SIMPLE-INTEGRAL(t_n) <= INTEGRAL(f_n) <= L
      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                  (list '<= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID (list icv-hh 'n) yy) icv-ll)))
        (lambda ()
          (let* ((n (dk-di-var!)) (tn (icv-tn n)) (fn (list 'cf n)))
            (icv-fn-meas! n)
            (dk-have! (icv-ptw yy (lambda (y) (list 'IN (list 'INTERSECTION (icv-lev y) (icv-en n)) 'cA)))
              (lambda () (let ((y (dk-di-var!))) (icv-ae-meas! n y) (dk-ass!))))
            (dk-have! (list 'IN tn '(FUN omega RR-POS-STAR))
              (lambda ()
                (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (icv-tif-typed! n x) (dk-ass!))))))
            (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                        (list '= (list tn 'x) (icv-tif n 'x))))
              (lambda ()
                (let ((x (dk-di-var!)))
                  (icv-tif-typed! n x)
                  (if (not (dk-lam-b!)) (rfl)))))
            (let ((rr (dk-fact! 'simple-restrict-integral 'omega 'cA 'mu 's 'c (icv-en n) tn)))
              (dk-split! rr))
            (fact 'integral-simple 'omega 'cA 'mu tn)
            (dk-project! (list 'IS-MEASURABLE-FN 'omega 'cA tn) 'IS-SIMPLE-FN (list 'IS-SIMPLE-FN 'omega 'cA tn))
            (dk-have! (list 'PTWISE-LE 'omega tn fn)
              (lambda ()
                (mac 'PTWISE-LE)
                (let ((x (dk-di-var!)))
                  (icv-tif-typed! n x)
                  (icv-fnw! n x)
                  (if (not (dk-lam-b!)) #t)
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                      (dk-case-if! (icv-tif n x)
                        (lambda (tr v)
                          (if tr
                              (begin (sep-me (list 'IN x (icv-en n))) (dk-ass!))
                              (begin (fact 'rr-pos-star-nonneg (list fn x)) (dk-ass!)))))))))
            (fact 'integral-monotone 'omega 'cA 'mu tn fn)
            (fact 'integral-in 'omega 'cA 'mu tn)
            (fact 'integral-in 'omega 'cA 'mu fn)
            (icv-in-image! icv-il n (list 'INTEGRAL 'omega 'cA 'mu fn))
            (dk-fact! 'esup-upper (list 'IMAGE icv-il 'NN) (list 'INTEGRAL 'omega 'cA 'mu fn))
            (let ((i1 (list 'INTEGRAL 'omega 'cA 'mu tn)) (i2 (list 'INTEGRAL 'omega 'cA 'mu fn)))
              (dk-have! (list 'AND (list 'IN i1 'RR-POS-STAR) (list 'AND (list 'IN i2 'RR-POS-STAR) (list 'IN icv-ll 'RR-POS-STAR))))
              (dk-have! (list 'AND (list '<= i1 i2) (list '<= i2 icv-ll)))
              (fact 'rr-pos-star-le-trans i1 i2 icv-ll)
              (if (not (dk-lam-b!)) #t)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (begin
                    (subst (list '= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID (icv-rl n) yy)
                                 (list 'SIMPLE-INTEGRAL 'omega 'mu tn)))
                    (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu tn) i1))
                    (dk-ass!)))))))
      (dk-fact! 'rps-finsum-esup-le yy icv-hh icv-af-sym icv-ll)

      ;; termwise: (c y) mu({s = y}) <= A(y), by continuity from below on E_n
      (let ((af icv-af-sym))
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ yy) (list '<= (list icv-sl 'z_) (list af 'z_))))
          (lambda ()
            (let* ((z (dk-di-var!))
                   (lev (icv-lev z))
                   (gze (icv-abstract! 'NN 'cA (lambda (n) (icv-ae n z))
                          (lambda (n) (icv-ae-meas! n z) (dk-ass!))
                          (lambda (n) (icv-ae-meas! n z) (fact 'membership-implies-sethood (icv-ae n z) 'cA))))
                   (gz (car gze)) (gv (cdr gze))
                   (bu (list 'BIG-UNION 'n_ 'NN (list gz 'n_)))
                   (mg (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list gz 'n_))))
                   (ml (list 'VNB-LAMBDA 'n_ 'NN (list 'etimes (list '* 'c z) (list mg 'n_)))))
              (icv-range-real! z)
              (icv-mul-nonneg! 'c z)
              (icv-rps! (list '* 'c z))
              (fact 'measurable-fn-level-set 'omega 'cA 's z)
              ;; increasing
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'SUBSET (list gz 'n_) (list gz '(succ n_)))))
                (lambda ()
                  (let* ((n (dk-di-var!)) (n1 (list 'succ n)))
                    (fact 'nn-succ-closed n)
                    (icv-en-mono! n)
                    (dk-apply! gv n)
                    (dk-apply! gv n1)
                    (subst (list '== (list gz n) (icv-ae n z)))
                    (subst (list '== (list gz n1) (icv-ae n1 z)))
                    (mac 'subset-def)
                    (let ((w (dk-di-var!)))
                      (mac-h 'intersection-membership (list 'IN w (icv-ae n z)))
                      (dk-split-all!)
                      (fact 'subset-mem-fwd (icv-en n) (icv-en n1) w)
                      (mac 'intersection-membership)
                      (icv-conj-close! (lambda () (dk-ass!)))))))
              ;; the union is the level set
              (icv-set-eq! bu lev
                (lambda (w)
                  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                         (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                         (n (cadr nin)))
                    (dk-apply! gv n)
                    (dk-have! (list 'IN w (icv-ae n z))
                      (lambda () (subst (list '= (icv-ae n z) (list gz n))) (ass)))
                    (mac-h 'intersection-membership (list 'IN w (icv-ae n z)))
                    (dk-split-all!)
                    (dk-ass!)))
                (lambda (w)
                  (dk-have! (list 'IN w 'omega) (lambda () (sep-me (list 'IN w lev)) (ass)))
                  (dk-have! (list '= (list 's w) z) (lambda () (sep-me (list 'IN w lev)) (ass)))
                  (let* ((phi (icv-seq w))
                         (pie (icv-img-facts! w))
                         (img (cadr pie)) (e (caddr pie))
                         (into! (lambda (n)
                                  ;; (<= (* c z) ((cf n) w)) in context: w in gz(n), hence in the union
                                  (dk-have! (list 'IN w (icv-en n))
                                    (lambda ()
                                      (icv-sep-in!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal))
                                              (ass)
                                              (begin (subst (list '= (list 's w) z)) (dk-ass!)))))))
                                  (dk-apply! gv n)
                                  (dk-have! (list 'IN w (list gz n))
                                    (lambda ()
                                      (subst (list '== (list gz n) (icv-ae n z)))
                                      (mac 'intersection-membership)
                                      (icv-conj-close! (lambda () (dk-ass!)))))
                                  (for-each (lambda (l)
                                              (if (not (sequent-node-grounded? l))
                                                  (begin (dk-focus! l) (ass))))
                                            (dk-opened (lambda () (bu-mi n)))))))
                    (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR w)
                    (use-em (list '= z 0)
                      (lambda ()
                        (fact 'nn-zero-in)
                        (icv-fnw! 0 w)
                        (fact 'rr-mul-zero 'c)
                        (fact 'rr-pos-star-nonneg (list (list 'cf 0) w))
                        (dk-have! (list '<= (list '* 'c z) (list (list 'cf 0) w))
                          (lambda ()
                            (subst (list '= z 0))
                            (subst (list '= (list '* 'c 0) 0))
                            (ass)))
                        (into! 0))
                      (lambda ()
                        (icv-pos! z)
                        ;; s(w) <= F(w) = ESUP(IMG)
                        (let ((iff (dk-cite! 'PTWISE-LE 'omega 's '(PTWISE-SUP omega cf))))
                          (dk-have! (list '<= (list 's w) (list '(PTWISE-SUP omega cf) w))
                            (lambda ()
                              (ai iff)
                              (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                              (dk-apply! (caddr iff) w)
                              (dk-ass!))))
                        (dk-have! (list '= (list '(PTWISE-SUP omega cf) w) e)
                          (lambda () (mac 'PTWISE-SUP) (if (not (dk-lam-b!)) (rfl))))
                        (dk-have! (list '<= z e)
                          (lambda ()
                            (subst (list '= z (list 's w)))
                            (subst (list '= e (list '(PTWISE-SUP omega cf) w)))
                            (ass)))
                        (fact 'rr-one-in)
                        (fact 'rr-lt-scale-pos z 'c 1)
                        (dk-have! (list 'AND (list '< 0 z) '(< c 1)))
                        (fact 'rr-lt-scale-pos z 'c 1)
                        (icv-mul-rr! z 'c)
                        (dk-have! (list '< (list '* 'c z) z)
                          (lambda ()
                            (dk-have! (list '= (list '* 'c z) (list '* z 'c)) (lambda () (crs)))
                            (dk-have! (list '= z (list '* z 1)) (lambda () (crs)))
                            (subst (list '= (list '* 'c z) (list '* z 'c)))
                            (dk-ineq! (list 'IN z 'RR) (list 'IN (list '* z 'c) 'RR)
                                      (list '< (list '* z 'c) (list '* z 1)) (list '= z (list '* z 1)))))
                        (fact 'rps-lt-le-trans (list '* 'c z) z e)
                        (let* ((ex (dk-fact! 'esup-lt-witness img (list '* 'c z)))
                               (yv (dk-skolem! ex))
                               (n  (icv-img-elt! phi 'NN yv))
                               (fnw (list (list 'cf n) w)))
                          (icv-fnw! n w)
                          (dk-have! (list '= fnw yv)
                            (lambda () (subst (list '= yv (list phi n))) (if (not (dk-lam-b!)) (rfl))))
                          (dk-have! (list '<= (list '* 'c z) fnw)
                            (lambda ()
                              (subst (list '= fnw yv))
                              (let ((iff (dk-cite! '< (list '* 'c z) yv)))
                                (icv-keep-prop! iff (list '< (list '* 'c z) yv)))))
                          (into! n)))))))
              ;; continuity from below
              (dk-have! (list 'IN gz '(FUN NN cA)) (lambda () (dk-ass!)))
              (let ((cont (dk-fact! 'measure-continuity-from-below 'omega 'cA 'mu gz)))
                (dk-have! (list 'IN mg '(FUN NN RR-POS-STAR))
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((n (dk-di-var!)))
                          (fact 'fun-apply-type-c gz 'NN 'cA n)
                          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (list gz n))
                          (dk-ass!))))))
                (fact 'esup-etimes-ge (list '* 'c z) mg)
                (icv-hseq-typed-g z)
                (dk-fun-ext! ml (icv-hseq z) 'NN 'RR-POS-STAR
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((n (dk-di-var!)))
                          (fact 'fun-apply-type-c gz 'NN 'cA n)
                          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (list gz n))
                          (dk-have! (list 'AND (list 'IN (list '* 'c z) 'RR-POS-STAR) (list 'IN (list 'mu (list gz n)) 'RR-POS-STAR)))
                          (fact 'etimes-closed (list '* 'c z) (list 'mu (list gz n)))
                          (if (not (dk-lam-b!)) (dk-ass!))))))
                  #f
                  (lambda (v)
                    (icv-hval-typed! v z)
                    (dk-apply! gv v)
                    (if (not (dk-lam-b!))
                        (begin
                          (subst (list '== (list gz v) (icv-ae v z)))
                          (rfl)))))
                (icv-mul-rr! 'c z)
                (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR lev)
                (dk-have! (list 'AND (list 'IN (list '* 'c z) 'RR-POS-STAR) (list 'IN (list 'mu lev) 'RR-POS-STAR)))
                (fact 'etimes-closed (list '* 'c z) (list 'mu lev))
                (dk-apply! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ yy)
                             (list '= (list af 'z_) (list 'ESUP (list 'IMAGE (icv-hseq 'z_) 'NN))))) z)
                (dk-lam-b!)
                (subst (list '= (list af z) (list 'ESUP (list 'IMAGE (icv-hseq z) 'NN))))
                (subst (list '= lev bu))
                (subst (list '= (list 'mu bu) (list 'ESUP (list 'IMAGE mg 'NN))))
                (subst (list '= (icv-hseq z) ml))
                (dk-ass!)))))
        ;; c SIMPLE-INTEGRAL(s) = SUM_y (c y) mu({s = y}) <= SUM_y A(y) <= L
        (let ((sint '(SIMPLE-INTEGRAL omega mu s))
              (fsv (icv-fs icv-sv yy)) (fsl (icv-fs icv-sl yy)) (faf (icv-fs af yy)))
          (dk-have! (icv-ptw yy (lambda (z) (list 'IN (list icv-sv z) 'RR-POS-STAR)))
            (lambda ()
              (let ((z (dk-di-var!)))
                (icv-range-real! z)
                (fact 'measurable-fn-level-set 'omega 'cA 's z)
                (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-lev z))
                (dk-have! (list 'AND (list 'IN z 'RR-POS-STAR) (list 'IN (list 'mu (icv-lev z)) 'RR-POS-STAR)))
                (fact 'etimes-closed z (list 'mu (icv-lev z)))
                (if (not (dk-lam-b!)) (dk-ass!)))))
          (dk-have! (icv-ptw yy (lambda (z) (list 'IN (list icv-sl z) 'RR-POS-STAR)))
            (lambda ()
              (let ((z (dk-di-var!)))
                (icv-range-real! z)
                (icv-mul-nonneg! 'c z)
                (icv-rps! (list '* 'c z))
                (fact 'measurable-fn-level-set 'omega 'cA 's z)
                (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-lev z))
                (dk-have! (list 'AND (list 'IN (list '* 'c z) 'RR-POS-STAR) (list 'IN (list 'mu (icv-lev z)) 'RR-POS-STAR)))
                (fact 'etimes-closed (list '* 'c z) (list 'mu (icv-lev z)))
                (if (not (dk-lam-b!)) (dk-ass!)))))
          (dk-have! (icv-ptw yy (lambda (z) (list 'IN (list af z) 'RR-POS-STAR)))
            (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c af yy 'RR-POS-STAR z) (dk-ass!))))
          (dk-have! (icv-ptw yy (lambda (z) (list '= (list icv-sl z) (list 'etimes 'c (list icv-sv z)))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (icv-range-real! z)
                (icv-mul-nonneg! 'c z)
                (fact 'measurable-fn-level-set 'omega 'cA 's z)
                (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (icv-lev z))
                (fact 'etimes-assoc-real 'c z (list 'mu (icv-lev z)))
                (icv-rps! (list '* 'c z))
                (dk-have! (list 'AND (list 'IN (list '* 'c z) 'RR-POS-STAR) (list 'IN (list 'mu (icv-lev z)) 'RR-POS-STAR)))
                (fact 'etimes-closed (list '* 'c z) (list 'mu (icv-lev z)))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                    (begin
                      (subst (list '= (list 'etimes 'c (list 'etimes z (list 'mu (icv-lev z))))
                                   (list 'etimes (list '* 'c z) (list 'mu (icv-lev z)))))
                      (rfl))))))
          (fact 'rps-finsum-scale-ptwise 'c yy icv-sv icv-sl)
          (dk-have! (icv-ptw yy (lambda (z) (list '<= (list icv-sl z) (list af z))))
            (lambda () (let ((z (dk-di-var!)))
                         (dk-apply! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ yy) (list '<= (list icv-sl 'z_) (list af 'z_)))) z)
                         (dk-ass!))))
          (fact 'rps-finsum-le-ptwise yy icv-sl af)
          (icv-rps-typed! yy icv-sl)
          (icv-rps-typed! yy af)
          (fact 'simple-integral-unfold 'omega 'mu 's)
          (subst (list '== sint fsv))
          (subst (list '= (list 'etimes 'c fsv) fsl))
          (dk-have! (list 'AND (list 'IN fsl 'RR-POS-STAR) (list 'AND (list 'IN faf 'RR-POS-STAR) (list 'IN icv-ll 'RR-POS-STAR))))
          (dk-have! (list 'AND (list '<= fsl faf) (list '<= faf icv-ll)))
          (fact 'rr-pos-star-le-trans fsl faf icv-ll)
          (dk-ass!))))))
(let ((sint '(SIMPLE-INTEGRAL omega mu s)))
  (fact 'rps-le-of-scaled sint icv-ll)
  (dk-ass!))
(qed 'mct-simple-below)
(topic! 'mct-simple-below 'analysis)

;;; =====================================================================
;;; (L) MONOTONE CONVERGENCE (Rudin Thm. 1.26; the notes' Prop. 2.16 and
;;;     property (7) of Thm. 2.7).  Statement copied from
;;;     structure-library/integral.scm.
;;; =====================================================================

(sp (make-wff
  (forall-guarded '(omega cA mu cF)
                  (list '(IS-MEASURE omega cA mu)
                        '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(IS-MEASURABLE-FN omega cA (cF n_)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(PTWISE-LE omega (cF n_) (cF (succ n_)))))
    '(AND (IS-MEASURABLE-FN omega cA (PTWISE-SUP omega cF))
          (= (INTEGRAL omega cA mu (PTWISE-SUP omega cF))
             (ESUP (IMAGE (VNB-LAMBDA n_ NN (INTEGRAL omega cA mu (cF n_)))
                          NN)))))))
(dk-peel!)
(let* ((ff '(PTWISE-SUP omega cf))
       (iff (list 'INTEGRAL 'omega 'cA 'mu ff))
       (hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
       (sset (list 'SEP 'iny_ 'RR-POS-STAR
                   (list 'FORSOME 'ins_
                         (list 'AND '(IS-SIMPLE-FN omega cA ins_)
                               (list 'AND (list 'PTWISE-LE 'omega 'ins_ ff)
                                     '(= iny_ (SIMPLE-INTEGRAL omega mu ins_))))))))
  (icv-parts! 'IS-MEASURE '(omega cA mu))
  (fact 'measurable-fn-sup 'omega 'cA 'cf)
  (fact 'integral-in 'omega 'cA 'mu ff)
  (dk-have! (list 'IN icv-il '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((n (dk-di-var!)))
            (dk-apply! hm n)
            (fact 'integral-in 'omega 'cA 'mu (list 'cf n))
            (dk-ass!))))))
  (let ((ll (icv-seq-sup! icv-il)))
    ;; INTEGRAL(F) <= L: every simple s below F has SIMPLE-INTEGRAL(s) <= L
    (fact 'integral-unfold 'omega 'cA 'mu ff)
    (dk-have! (list 'SUBSET sset 'RR-POS-STAR)
      (lambda () (mac 'subset-def) (let ((v (dk-di-var!))) (sep-me (list 'IN v sset)) (dk-ass!))))
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sset) (list '<= 'x ll)))
      (lambda ()
        (let ((x (dk-di-var!)))
          (sep-me (list 'IN x sset))
          (let* ((ex (dk-pick (dk-head? 'forsome) "the simple function"))
                 (sv (dk-skolem! ex)))
            (fact 'mct-simple-below 'omega 'cA 'mu 'cf sv)
            (subst (list '= x (list 'SIMPLE-INTEGRAL 'omega 'mu sv)))
            (dk-ass!)))))
    (dk-have! (list 'AND (list 'IN ll 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sset) (list '<= 'x ll)))))
    (dk-fact! 'esup-least sset ll)
    (dk-have! (list '<= iff ll)
      (lambda () (subst (list '== iff (list 'ESUP sset))) (dk-ass!)))
    ;; L <= INTEGRAL(F): every INTEGRAL(f_n) <= INTEGRAL(F)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE icv-il 'NN)) (list '<= 'x iff)))
      (lambda ()
        (let* ((x (dk-di-var!))
               (n (icv-img-elt! icv-il 'NN x))
               (fn (list 'cf n))
               (i1 (list 'INTEGRAL 'omega 'cA 'mu fn)))
          (dk-apply! hm n)
          (fact 'integral-in 'omega 'cA 'mu fn)
          (dk-have! (list '= x i1)
            (lambda () (subst (list '= x (list icv-il n))) (if (not (dk-lam-b!)) (rfl))))
          (dk-have! (list 'PTWISE-LE 'omega fn ff)
            (lambda ()
              (mac 'PTWISE-LE)
              (let* ((w (dk-di-var!))
                     (pie (icv-img-facts! w))
                     (img (cadr pie)) (e (caddr pie)))
                (icv-fnw! n w)
                (icv-in-image! (icv-seq w) n (list fn w))
                (dk-fact! 'esup-upper img (list fn w))
                (dk-have! (list '= (list ff w) e)
                  (lambda () (mac 'PTWISE-SUP) (if (not (dk-lam-b!)) (rfl))))
                (subst (list '= (list ff w) e))
                (dk-ass!))))
          (fact 'integral-monotone 'omega 'cA 'mu fn ff)
          (subst (list '= x i1))
          (dk-ass!))))
    (dk-have! (list 'AND (list 'IN iff 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE icv-il 'NN)) (list '<= 'x iff)))))
    (dk-fact! 'esup-least (list 'IMAGE icv-il 'NN) iff)
    (dk-have! (list 'AND (list 'IN iff 'RR-POS-STAR) (list 'IN ll 'RR-POS-STAR)))
    (dk-have! (list 'AND (list '<= iff ll) (list '<= ll iff)))
    (fact 'rr-pos-star-le-antisymm iff ll)
    (icv-conj-close! (lambda () (dk-ass!)))))
(qed 'monotone-convergence)
(topic! 'monotone-convergence 'analysis)
;;; =====================================================================
;;; (M) FATOU'S LEMMA (Rudin Thm. 1.28; the notes' Thm. 2.26).  The tail
;;;     infima g_m = inf_{p >= m} f_p are measurable and nondecreasing, the
;;;     lower limit is their supremum, monotone convergence gives
;;;     INTEGRAL(liminf f_n) = sup_m INTEGRAL(g_m), and INTEGRAL(g_m) <= INTEGRAL(f_p)
;;;     for p >= m.  Statement copied from structure-library/integral.scm.
;;; =====================================================================

(define (icv-gm m) (list 'VNB-LAMBDA 'lx_ 'omega (icv-tinf 'lx_ m)))
(define icv-ilf '(VNB-LAMBDA n_ NN (INTEGRAL omega cA mu (cf n_))))

(sp (make-wff
  (forall-guarded '(omega cA mu cF)
                  (list '(IS-MEASURE omega cA mu)
                        '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(IS-MEASURABLE-FN omega cA (cF n_))))
    '(AND (IS-MEASURABLE-FN omega cA (PTWISE-LIMINF omega cF))
          (<= (INTEGRAL omega cA mu (PTWISE-LIMINF omega cF))
              (ELIMINF (VNB-LAMBDA n_ NN
                         (INTEGRAL omega cA mu (cF n_)))))))))
(dk-peel!)
(define icv-fhm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
(icv-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'measurable-fn-liminf 'omega 'cA 'cf)

;;; G(m) as a function symbol
(define icv-gve
  (icv-abstract! 'NN '(FUN omega RR-POS-STAR) icv-gm
    (lambda (m) (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (icv-tinf-typed! x m) (dk-ass!)))))
    (lambda (m)
      (dk-have! (list 'IN (icv-gm m) '(FUN omega RR-POS-STAR))
        (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (icv-tinf-typed! x m) (dk-ass!))))))
      (fact 'membership-implies-sethood (icv-gm m) '(FUN omega RR-POS-STAR)))))
(define icv-gs (car icv-gve))
(define icv-gsv (cdr icv-gve))

;;; (= ((gs m) x) EINF(ETAIL(phi_x, m))), m in NN, x in omega
(define (icv-gval! m x)
  (let ((e (list '= (list (list icv-gs m) x) (icv-tinf x m))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (icv-tinf-typed! x m)
            (dk-apply! icv-gsv m)
            (subst (list '== (list icv-gs m) (icv-gm m)))
            (if (not (dk-lam-b!)) (rfl)))))
    e))

;;; each G(m) is measurable
(dk-have! (list 'FORALL 'gm_ (list 'IMPLIES '(IN gm_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list icv-gs 'gm_))))
  (lambda ()
    (let* ((m (dk-di-var!))
           (d (icv-tail-sub! m)))
      (fact 'fun-apply-type-c icv-gs 'NN '(FUN omega RR-POS-STAR) m)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                  (list '= (list (list icv-gs m) 'x) (list 'EINF (list 'IMAGE (icv-seq 'x) d)))))
        (lambda ()
          (let ((x (dk-di-var!)))
            (icv-gval! m x)
            (fact 'einf-in (icv-img-sub! d x))
            (subst (list '= (list (list icv-gs m) x) (icv-tinf x m)))
            (mac 'ETAIL)
            (rfl))))
      (fact 'measurable-fn-inf-of-values 'omega 'cA 'cf d (list icv-gs m))
      (dk-ass!))))

;;; G is nondecreasing: the tail from m+1 lies in the tail from m
(dk-have! (list 'FORALL 'gm_ (list 'IMPLIES '(IN gm_ NN)
            (list 'PTWISE-LE 'omega (list icv-gs 'gm_) (list icv-gs '(succ gm_)))))
  (lambda ()
    (let* ((m (dk-di-var!)) (m1 (list 'succ m)))
      (fact 'nn-succ-closed m)
      (mac 'PTWISE-LE)
      (let* ((x (dk-di-var!))
             (d0 (icv-tail-sub! m)) (d1 (icv-tail-sub! m1))
             (i0 (icv-img-sub! d0 x)) (i1 (icv-img-sub! d1 x)))
        (icv-gval! m x)
        (icv-gval! m1 x)
        (subst (list '= (list (list icv-gs m) x) (icv-tinf x m)))
        (subst (list '= (list (list icv-gs m1) x) (icv-tinf x m1)))
        (mac 'ETAIL)
        (fact 'einf-in i0)
        (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y i1) (list '<= (list 'EINF i0) 'y)))
          (lambda ()
            (let* ((y (dk-di-var!))
                   (p (icv-img-elt! (icv-seq x) d1 y))
                   (fpx (list (list 'cf p) x)))
              (sep-me (list 'IN p d1))
              (fact 'nn-in-rr m)
              (dk-have! (list '<= m p) (lambda () (dk-nn! (list '<= m1 p))))
              (dk-have! (list 'IN p d0) (lambda () (icv-sep-in! (lambda () (dk-ass!)))))
              (icv-fpw! p x)
              (dk-have! (list '= fpx y)
                (lambda () (subst (list '= y (list (icv-seq x) p))) (if (not (dk-lam-b!)) (rfl))))
              (icv-in-image-d! (icv-seq x) d0 p fpx)
              (dk-fact! 'einf-lower i0 fpx)
              (subst (list '= y fpx))
              (dk-ass!))))
        (dk-have! (list 'AND (list 'IN (list 'EINF i0) 'RR-POS-STAR)
                        (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y i1) (list '<= (list 'EINF i0) 'y)))))
        (dk-fact! 'einf-greatest i1 (list 'EINF i0))
        (dk-ass!)))))

;;; the lower limit is the supremum of the G(m), as functions
(define icv-lf '(PTWISE-LIMINF omega cf))
(define icv-sg (list 'PTWISE-SUP 'omega icv-gs))
(dk-have! (list 'IN icv-lf '(FUN omega RR-POS-STAR))
  (lambda ()
    (mac 'PTWISE-LIMINF)
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (icv-liminf-typed! x)
          (mac 'ELIMINF)
          (dk-ass!))))))
;;; the sequence n |-> G(n)(x)
(define (icv-gseq x) (list 'VNB-LAMBDA 'n_ 'NN (list (list icv-gs 'n_) x)))
(define (icv-gseq-typed! x)
  (if (not (dk-asm? (list 'IN (icv-gseq x) '(FUN NN RR-POS-STAR))))
      (dk-have! (list 'IN (icv-gseq x) '(FUN NN RR-POS-STAR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((n (dk-di-var!)))
                (fact 'fun-apply-type-c icv-gs 'NN '(FUN omega RR-POS-STAR) n)
                (fact 'fun-apply-type-c (list icv-gs n) 'omega 'RR-POS-STAR x)
                (dk-ass!)))))))
  (icv-seq-sup! (icv-gseq x)))
(dk-have! (list 'IN icv-sg '(FUN omega RR-POS-STAR))
  (lambda ()
    (mac 'PTWISE-SUP)
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (icv-gseq-typed! x)
          (dk-ass!))))))
(dk-fun-ext! icv-lf icv-sg 'omega 'RR-POS-STAR #f #f
  (lambda (x)
    (let* ((l2 (icv-l2-typed! x))
           (e2 (icv-liminf-typed! x))
           (e1 (icv-gseq-typed! x)))
      (dk-fun-ext! (icv-gseq x) l2 'NN 'RR-POS-STAR #f #f
        (lambda (v)
          (icv-gval! v x)
          (icv-tinf-typed! x v)
          (if (not (dk-lam-b!))
              (begin (subst (list '= (list (list icv-gs v) x) (icv-tinf x v))) (rfl)))))
      (dk-have! (list '= (list icv-sg x) e1)
        (lambda () (mac 'PTWISE-SUP) (if (not (dk-lam-b!)) (rfl))))
      (subst (list '= (list icv-sg x) e1))
      (subst (list '= (icv-gseq x) l2))
      (mac 'PTWISE-LIMINF)
      (if (not (dk-lam-b!))
          (begin (mac 'ELIMINF) (rfl))))))

;;; monotone convergence for G
(dk-have! (list 'IN icv-gs '(FUN NN (FUN omega RR-POS-STAR))) (lambda () (dk-ass!)))
(let* ((mct (dk-fact! 'monotone-convergence 'omega 'cA 'mu icv-gs))
       (ig  (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'cA 'mu (list icv-gs 'n_))))
       (gmh (list 'FORALL 'gm_ (list 'IMPLIES '(IN gm_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list icv-gs 'gm_)))))
       (kl  (list 'VNB-LAMBDA 'n_ 'NN (list 'EINF (list 'ETAIL icv-ilf 'n_))))
       (lfi (list 'INTEGRAL 'omega 'cA 'mu icv-lf))
       (sgi (list 'INTEGRAL 'omega 'cA 'mu icv-sg)))
  (dk-split! mct)
  (dk-have! (list 'IN icv-ilf '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((n (dk-di-var!)))
            (dk-apply! icv-fhm n)
            (fact 'integral-in 'omega 'cA 'mu (list 'cf n))
            (dk-ass!))))))
  ;; EINF(ETAIL(IL, n)) typed, for n in NN
  (define (icv-kl-typed! n)
    (let* ((d (icv-tail-sub! n))
           (img (list 'IMAGE icv-ilf d)))
      (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
          (dk-have! (list 'SUBSET img 'RR-POS-STAR)
            (lambda ()
              (mac 'subset-def)
              (let* ((v (dk-di-var!)) (p (icv-img-elt! icv-ilf d v)))
                (fact 'subset-mem-fwd d 'NN p)
                (fact 'fun-apply-type-c icv-ilf 'NN 'RR-POS-STAR p)
                (subst (list '= v (list icv-ilf p)))
                (dk-ass!)))))
      (fact 'einf-in img)
      (dk-have! (list 'IN (list 'EINF (list 'ETAIL icv-ilf n)) 'RR-POS-STAR)
        (lambda () (mac 'ETAIL) (dk-ass!)))
      img))
  (dk-have! (list 'IN kl '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (icv-kl-typed! n) (dk-ass!))))))
  (let ((lim (icv-seq-sup! kl)))
    ;; INTEGRAL(G(n)) <= EINF(ETAIL(IL, n)) <= ELIMINF(IL)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE ig 'NN)) (list '<= 'x lim)))
      (lambda ()
        (let* ((x (dk-di-var!))
               (n (icv-img-elt! ig 'NN x))
               (gn (list icv-gs n))
               (ign (list 'INTEGRAL 'omega 'cA 'mu gn))
               (img (icv-kl-typed! n))
               (kn (list 'EINF img)))
          (dk-apply! gmh n)
          (fact 'integral-in 'omega 'cA 'mu gn)
          (dk-have! (list '= x ign)
            (lambda () (subst (list '= x (list ig n))) (if (not (dk-lam-b!)) (rfl))))
          (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y img) (list '<= ign 'y)))
            (lambda ()
              (let* ((y (dk-di-var!))
                     (d (icv-tail-sub! n))
                     (p (icv-img-elt! icv-ilf d y))
                     (fp (list 'cf p))
                     (ifp (list 'INTEGRAL 'omega 'cA 'mu fp)))
                (fact 'subset-mem-fwd d 'NN p)
                (dk-apply! icv-fhm p)
                (fact 'integral-in 'omega 'cA 'mu fp)
                (dk-have! (list '= y ifp)
                  (lambda () (subst (list '= y (list icv-ilf p))) (if (not (dk-lam-b!)) (rfl))))
                (dk-have! (list 'PTWISE-LE 'omega gn fp)
                  (lambda ()
                    (mac 'PTWISE-LE)
                    (let* ((w (dk-di-var!))
                           (dw (icv-tail-sub! n))
                           (iw (icv-img-sub! dw w))
                           (fpw (list fp w)))
                      (icv-gval! n w)
                      (icv-fpw! p w)
                      (icv-in-image-d! (icv-seq w) dw p fpw)
                      (dk-fact! 'einf-lower iw fpw)
                      (subst (list '= (list gn w) (icv-tinf w n)))
                      (mac 'ETAIL)
                      (dk-ass!))))
                (fact 'integral-monotone 'omega 'cA 'mu gn fp)
                (subst (list '= y ifp))
                (dk-ass!))))
          (dk-have! (list 'AND (list 'IN ign 'RR-POS-STAR)
                          (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y img) (list '<= ign 'y)))))
          (dk-fact! 'einf-greatest img ign)
          (dk-have! (list '<= ign (list 'EINF (list 'ETAIL icv-ilf n)))
            (lambda () (mac 'ETAIL) (dk-ass!)))
          (icv-in-image! kl n (list 'EINF (list 'ETAIL icv-ilf n)))
          (dk-fact! 'esup-upper (list 'IMAGE kl 'NN) (list 'EINF (list 'ETAIL icv-ilf n)))
          (let ((kt (list 'EINF (list 'ETAIL icv-ilf n))))
            (dk-have! (list 'AND (list 'IN ign 'RR-POS-STAR) (list 'AND (list 'IN kt 'RR-POS-STAR) (list 'IN lim 'RR-POS-STAR))))
            (dk-have! (list 'AND (list '<= ign kt) (list '<= kt lim)))
            (fact 'rr-pos-star-le-trans ign kt lim))
          (subst (list '= x ign))
          (dk-ass!))))
    (dk-have! (list 'IN ig '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((n (dk-di-var!)))
              (dk-apply! gmh n)
              (fact 'integral-in 'omega 'cA 'mu (list icv-gs n))
              (dk-ass!))))))
    (let ((sig (icv-seq-sup! ig)))
      (dk-have! (list 'AND (list 'IN lim 'RR-POS-STAR)
                      (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE ig 'NN)) (list '<= 'x lim)))))
      (dk-fact! 'esup-least (list 'IMAGE ig 'NN) lim)
      (icv-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (subst (list '= icv-lf icv-sg))
                (subst (list '= sgi sig))
                (mac 'ELIMINF)
                (dk-ass!))))))))
(qed 'fatou)
(topic! 'fatou 'analysis)
;;; =====================================================================
;;; (N) APPROXIMATION BY SIMPLE FUNCTIONS (Rudin Thm. 1.17).  The dyadic
;;;     staircase in ESUP form: with d_n = (1/2)^n,
;;;        s_n(x) = ESUP { k d_n : k in NN, k d_n <= f(x), k d_n <= n },
;;;     the largest grid point below min(f(x), n).  Monotone because the
;;;     grid of step d_n sits in the grid of step d_(n+1) (k d_n = (2k) d_(n+1));
;;;     simple because its values are k d_n with k d_n <= n.
;;; =====================================================================

(define (icv-dl n) (list 'power 1/2 n))
(define (icv-kset n fx) (list 'SEP 'sq_ 'NN (list 'AND (list '<= (list '* 'sq_ (icv-dl n)) fx)
                                                  (list '<= (list '* 'sq_ (icv-dl n)) n))))
(define (icv-phig n) (list 'VNB-LAMBDA 'sk_ 'NN (list '* 'sk_ (icv-dl n))))
(define (icv-sval n fx) (list 'ESUP (list 'IMAGE (icv-phig n) (icv-kset n fx))))

;;; d_n facts: (IN d RR), (< 0 d), (<= 0 d), (<= d 1)
(define (icv-dl-facts! n)
  (let ((d (icv-dl n)))
    (if (not (dk-asm? (list '< 0 d)))
        (begin
          (dk-have! '(IN 1/2 RR) (lambda () (arith)))
          (dk-have! '(< 0 1/2) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (dk-have! '(<= 0 1/2) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (dk-have! '(<= 1/2 1) (lambda () (dk-ineq! '(IN 1/2 RR))))
          (fact 'power-closed-at n 1/2)
          (fact 'rr-power-pos 1/2 n)
          (fact 'rr-lt-implies-le 0 d)
          (dk-have! '(AND (<= 0 1/2) (<= 1/2 1)))
          (fact 'rr-power-le-one n 1/2)))
    d))
;;; d_(n+1) = 1/2 d_n
(define (icv-dl-succ! n)
  (let ((e (list '= (icv-dl (list 'succ n)) (list '* 1/2 (icv-dl n)))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (dk-have! '(IN 1/2 RR) (lambda () (arith)))
            (fact 'rr-subset-cc 1/2)
            (dk-have! (list 'AND '(IN 1/2 CC) (list 'IN n 'NN)))
            (fact 'power-succ 1/2 n)
            (dk-ass!))))
    e))
;;; (* k d) typed real and >= 0, k in NN
(define (icv-kd! k d)
  (fact 'nn-in-rr k)
  (fact 'nn-zero-le k)
  (icv-mul-nonneg! k d)
  (icv-rps! (list '* k d)))

;;; esup-grid-max: the largest grid point of an index set is its supremum.
(sp (make-wff
     '(FORALL dd (IMPLIES (IN dd RR) (IMPLIES (< 0 dd)
        (FORALL y (IMPLIES (IN y RR)
          (FORALL m (IMPLIES (IN m NN)
            (FORALL kk (IMPLIES (SUBSET kk NN) (IMPLIES (IN m kk)
              (IMPLIES (< y (+ (* m dd) dd))
                (IMPLIES (FORALL k (IMPLIES (IN k kk) (<= (* k dd) y)))
                  (= (ESUP (IMAGE (VNB-LAMBDA sk_ NN (* sk_ dd)) kk)) (* m dd))))))))))))))))
(dk-peel!)
(fact 'rr-lt-implies-le 0 'dd)
(let* ((phi '(VNB-LAMBDA sk_ NN (* sk_ dd)))
       (img (list 'IMAGE phi 'kk))
       (md '(* m dd))
       (hk '(FORALL k (IMPLIES (IN k kk) (<= (* k dd) y)))))
  (icv-kd! 'm 'dd)
  (dk-have! (list 'SUBSET img 'RR-POS-STAR)
    (lambda ()
      (mac 'subset-def)
      (let* ((v (dk-di-var!)) (p (icv-img-elt! phi 'kk v)))
        (fact 'subset-mem-fwd 'kk 'NN p)
        (icv-kd! p 'dd)
        (dk-have! (list '= v (list '* p 'dd))
          (lambda () (subst (list '= v (list phi p))) (if (not (dk-lam-b!)) (rfl))))
        (subst (list '= v (list '* p 'dd)))
        (dk-ass!))))
  (fact 'esup-in img)
  (icv-in-image-d! phi 'kk 'm md)
  (dk-fact! 'esup-upper img md)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x img) (list '<= 'x md)))
    (lambda ()
      (let* ((v (dk-di-var!)) (p (icv-img-elt! phi 'kk v)) (pd (list '* p 'dd)))
        (fact 'subset-mem-fwd 'kk 'NN p)
        (icv-kd! p 'dd)
        (dk-apply! hk p)
        (dk-have! (list '= v pd)
          (lambda () (subst (list '= v (list phi p))) (if (not (dk-lam-b!)) (rfl))))
        (subst (list '= v pd))
        (use-em (list '<= p 'm)
          (lambda ()
            (fact 'nn-in-rr 'm)
            (fact 'rr-mul-le-right p 'm 'dd)
            (dk-ass!))
          (lambda ()
            (fact 'nn-not-le-succ-le p 'm)
            (fact 'nn-succ-plus-one 'm)
            (fact 'nn-in-rr 'm)
            (fact 'rr-one-in)
            (dk-have! '(AND (IN m RR) (IN 1 RR)))
            (fact 'rr-add-closed 'm 1)
            (dk-have! (list '<= '(+ m 1) p)
              (lambda () (subst '(= (+ m 1) (succ m))) (dk-ass!)))
            (fact 'rr-mul-le-right '(+ m 1) p 'dd)
            (icv-mul-rr! '(+ m 1) 'dd)
            (dk-have! '(= (* (+ m 1) dd) (+ (* m dd) dd)) (lambda () (crs)))
            (dk-have! 'FALSITY
              (lambda ()
                (dk-absurd! '(IN y RR) '(IN dd RR) (list 'IN md 'RR) (list 'IN pd 'RR)
                            (list 'IN '(* (+ m 1) dd) 'RR)
                            (list '<= '(* (+ m 1) dd) pd) '(= (* (+ m 1) dd) (+ (* m dd) dd))
                            (list '<= pd 'y) '(< y (+ (* m dd) dd)))))
            (icv-keep-prop! 'FALSITY))))))
  (dk-have! (list 'AND (list 'IN md 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x img) (list '<= 'x md)))))
  (dk-fact! 'esup-least img md)
  (dk-have! (list 'AND (list 'IN (list 'ESUP img) 'RR-POS-STAR) (list 'IN md 'RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= (list 'ESUP img) md) (list '<= md (list 'ESUP img))))
  (fact 'rr-pos-star-le-antisymm (list 'ESUP img) md)
  (dk-ass!))
(qed 'esup-grid-max)
(topic! 'esup-grid-max 'inequalities)

;;; grid-staircase-value: s_n at a value fx is a grid point m d_n of the index
;;; set, and every real z below fx and n lies below m d_n + d_n.
(sp (make-wff
     '(FORALL n (IMPLIES (IN n NN) (FORALL fx (IMPLIES (IN fx RR-POS-STAR)
        (FORSOME m (AND (IN m NN)
          (AND (IN m (SEP sq_ NN (AND (<= (* sq_ (power 1/2 n)) fx) (<= (* sq_ (power 1/2 n)) n))))
            (AND (= (ESUP (IMAGE (VNB-LAMBDA sk_ NN (* sk_ (power 1/2 n)))
                                 (SEP sq_ NN (AND (<= (* sq_ (power 1/2 n)) fx) (<= (* sq_ (power 1/2 n)) n)))))
                    (* m (power 1/2 n)))
                 (FORALL z (IMPLIES (IN z RR) (IMPLIES (<= z fx) (IMPLIES (<= z n)
                   (< z (+ (* m (power 1/2 n)) (power 1/2 n)))))))))))))))))
(dk-peel!)
(let* ((d (icv-dl-facts! 'n))
       (ks (icv-kset 'n 'fx))
       (finish!
        ;; y real >= 0 with y <= n, (y <= fx or y = fx-ish proofs): Y-FX! proves (<= t fx) from (<= t y);
        ;; K-Y! proves (<= t y) from (<= t fx), (<= t n), t real
        (lambda (y y-fx! k-y! z-y!)
          (if (equal? y 'n) (fact 'rr-leq-reflexive 'n))
          (icv-pos-rr! d)
          (let* ((ex (dk-fact! 'rr-nn-floor-mul y d))
                 (m  (dk-skolem! ex))
                 (md (list '* m d)))
            (icv-kd! m d)
            (dk-have! (list 'SUBSET ks 'NN)
              (lambda () (mac 'subset-def) (let ((v (dk-di-var!))) (sep-me (list 'IN v ks)) (dk-ass!))))
            (dk-have! (list 'IN m ks)
              (lambda ()
                (icv-sep-in!
                  (lambda ()
                    (cond ((dk-asm? (dk-goal)) (ass))
                          ((dk-head-is? (dk-goal) 'AND)
                           (icv-conj-close!
                             (lambda ()
                               (if (equal? (caddr (dk-goal)) 'n)
                                   (dk-ineq! (list 'IN y 'RR) '(IN n RR) (list 'IN md 'RR) (list '<= md y) (list '<= y 'n))
                                   (y-fx! md)))))
                          (#t (error "icv: unexpected sep leaf" (dk-goal))))))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES (list 'IN 'k ks) (list '<= (list '* 'k d) y)))
              (lambda ()
                (let ((k (dk-di-var!)))
                  (sep-me (list 'IN k ks))
                  (dk-split-all!)
                  (icv-kd! k d)
                  (k-y! (list '* k d)))))
            (fact 'esup-grid-max d y m ks)
            (ew m)
            (icv-conj-close!
              (lambda ()
                (cond ((dk-asm? (dk-goal)) (ass))
                      ((dk-head-is? (dk-goal) 'FORALL)
                       (dk-peel!)
                       (let ((z (cadr (dk-goal))))
                         (z-y! z)
                         (dk-ineq! (list 'IN z 'RR) (list 'IN y 'RR) (list 'IN md 'RR) (list 'IN d 'RR)
                                   (list '<= z y) (list '< y (list '+ md d)))))
                      (#t (dk-ass!)))))))))
  (fact 'nn-in-rr 'n)
  (fact 'nn-zero-le 'n)
  (icv-star-cases! 'fx
    (lambda ()
      (dk-have! '(AND (IN fx RR) (IN n RR)))
      (let ((tot (dk-fact! 'rr-leq-total 'fx 'n)))
        (use-cases tot
          (lambda ()
            (finish! 'fx
              (lambda (t) (dk-ass!))
              (lambda (t) (dk-ass!))
              (lambda (z) #t)))
          (lambda ()
            (finish! 'n
              (lambda (t) (dk-ineq! '(IN fx RR) '(IN n RR) (list 'IN t 'RR) (list '<= t 'n) '(<= n fx)))
              (lambda (t) (dk-ass!))
              (lambda (z) #t))))))
    (lambda ()
      (finish! 'n
        (lambda (t) (subst '(= fx POS-INF)) (icv-rr-star! t) (fact 'pos-inf-upper-bound t) (dk-ass!))
        (lambda (t) (dk-ass!))
        (lambda (z) #t)))))
(qed 'grid-staircase-value)
(topic! 'grid-staircase-value 'inequalities)

;;; measurable-fn-guarded-ge: { x : a < b <= c and b <= f(x) } is measurable
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (FORALL a (FORALL b (FORALL cc_ (IMPLIES (IN b RR)
            (IN (SEP x_ omega (AND (AND (< a b) (<= b cc_)) (<= b (f x_)))) cA)))))))))))
(dk-peel!)
(let* ((parts (icv-mfn-parts! 'omega 'cA 'f))
       (ge    '(SEP gx_ omega (<= b (f gx_))))
       (ss    '(SEP x_ omega (AND (AND (< a b) (<= b cc_)) (<= b (f x_)))))
       (gd    '(AND (< a b) (<= b cc_))))
  (use-em gd
    (lambda ()
      (dk-split! gd)
      (fact 'measurable-fn-ge 'omega 'cA 'f 'b)
      (icv-set-eq! ss ge
        (lambda (w) (sep-me (list 'IN w ss)) (dk-split-all!) (icv-sep-in! (lambda () (dk-ass!))))
        (lambda (w) (sep-me (list 'IN w ge)) (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
      (subst (list '= ss ge))
      (dk-ass!))
    (lambda ()
      (fact 'sigma-algebra-empty-in 'omega 'cA)
      (icv-set-eq! ss 'EMPTY-SET
        (lambda (w)
          (sep-me (list 'IN w ss))
          (icv-keep-prop! (list 'AND gd (list '<= 'b (list 'f w))) (list 'NOT gd)))
        (lambda (w)
          (fact 'empty-set-has-no-members w)
          (icv-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
      (subst (list '= ss 'EMPTY-SET))
      (dk-ass!))))
(qed 'measurable-fn-guarded-ge)
(topic! 'measurable-fn-guarded-ge 'analysis)
;;; s_n at the value fx: land (IN m NN), (IN m K), (= S (* m d)), the floor
;;; bound, and (IN S RR-POS-STAR); return m.  fx in RR-POS-STAR in context.
(define (icv-gsv! n fx)
  (let* ((d (icv-dl-facts! n))
         (sv (icv-sval n fx))
         (ex (dk-fact! 'grid-staircase-value n fx))
         (m  (dk-skolem! ex)))
    (icv-kd! m d)
    (dk-have! (list 'IN sv 'RR-POS-STAR)
      (lambda () (subst (list '= sv (list '* m d))) (dk-ass!)))
    m))
;;; (SUBSET (IMAGE phig K) RR-POS-STAR) for the grid index set K(n, fx)
(define (icv-gimg-sub! n fx)
  (let* ((d (icv-dl-facts! n))
         (phi (icv-phig n)) (ks (icv-kset n fx))
         (img (list 'IMAGE phi ks)))
    (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
        (dk-have! (list 'SUBSET img 'RR-POS-STAR)
          (lambda ()
            (mac 'subset-def)
            (let* ((v (dk-di-var!)) (p (icv-img-elt! phi ks v)))
              (sep-me (list 'IN p ks))
              (dk-split-all!)
              (icv-kd! p d)
              (dk-have! (list '= v (list '* p d))
                (lambda () (subst (list '= v (list phi p))) (if (not (dk-lam-b!)) (rfl))))
              (subst (list '= v (list '* p d)))
              (dk-ass!)))))
    img))

(define (icv-snl n) (list 'VNB-LAMBDA 'sx_ 'omega (icv-sval n '(f sx_))))

;;; grid-staircase-simple: each s_n is a simple function
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (IMPLIES (IS-MEASURABLE-FN omega cA f)
        (FORALL n (IMPLIES (IN n NN)
          (IS-SIMPLE-FN omega cA
            (VNB-LAMBDA sx_ omega
              (ESUP (IMAGE (VNB-LAMBDA sk_ NN (* sk_ (power 1/2 n)))
                           (SEP sq_ NN (AND (<= (* sq_ (power 1/2 n)) (f sx_))
                                            (<= (* sq_ (power 1/2 n)) n)))))))))))))))
(dk-peel!)
(let* ((parts (icv-mfn-parts! 'omega 'cA 'f))
       (d (icv-dl-facts! 'n))
       (sn (icv-snl 'n))
       (at! (lambda (w)     ; (= (sn w) S(n, f w)) and S typed; returns m
              (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
              (let ((m (icv-gsv! 'n (list 'f w))))
                (dk-have! (list '= (list sn w) (icv-sval 'n (list 'f w)))
                  (lambda () (if (not (dk-lam-b!)) (rfl))))
                m))))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'nn-in-rr 'n)
  (fact 'nn-zero-le 'n)
  (dk-have! (list 'IN sn '(FUN omega RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
            (icv-gsv! 'n (list 'f x))
            (dk-ass!))))))
  ;; measurable: the tails are countable unions of guarded closed tails of f
  (dk-have! (list 'FORALL 'al_ (list 'IMPLIES '(IN al_ RR) (list 'IMPLIES '(<= 0 al_)
               (list 'IN (list 'SEP 'x_ 'omega (list '< 'al_ (list sn 'x_))) 'cA))))
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal)))
             (al (cadr (cadddr tl)))
             (cell (lambda (k) (list 'SEP 'x_ 'omega
                                     (list 'AND (list 'AND (list '< al (list '* k d)) (list '<= (list '* k d) 'n))
                                           (list '<= (list '* k d) '(f x_))))))
             (inca! (lambda (k)
                      (icv-kd! k d)
                      (fact 'measurable-fn-guarded-ge 'omega 'cA 'f al (list '* k d) 'n)))
             (hve (icv-abstract! 'NN 'cA cell
                    (lambda (k) (inca! k) (dk-ass!))
                    (lambda (k) (inca! k) (fact 'membership-implies-sethood (cell k) 'cA))))
             (hf (car hve)) (ve (cdr hve))
             (bu (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
        (icv-rps! al)
        (fact 'sigma-algebra-union-closed 'omega 'cA hf)
        (icv-set-eq! tl bu
          (lambda (w)
            (sep-me (list 'IN w tl))
            (at! w)
            (let* ((fw (list 'f w))
                   (sv (icv-sval 'n fw))
                   (img (icv-gimg-sub! 'n fw))
                   (ks (icv-kset 'n fw)))
              (dk-have! (list '< al sv) (lambda () (subst (list '= sv (list sn w))) (dk-ass!)))
              (let* ((ex (dk-fact! 'esup-lt-witness img al))
                     (yv (dk-skolem! ex))
                     (k (icv-img-elt! (icv-phig 'n) ks yv))
                     (kd (list '* k d)))
                (dk-have! (list 'IN k 'NN) (lambda () (sep-me (list 'IN k ks)) (dk-ass!)))
                (dk-have! (list 'AND (list '<= kd fw) (list '<= kd 'n))
                  (lambda () (sep-me (list 'IN k ks)) (dk-ass!)))
                (dk-split! (list 'AND (list '<= kd fw) (list '<= kd 'n)))
                (icv-kd! k d)
                (dk-have! (list '= yv kd)
                  (lambda () (subst (list '= yv (list (icv-phig 'n) k))) (if (not (dk-lam-b!)) (rfl))))
                (dk-have! (list '< al kd) (lambda () (subst (list '= kd yv)) (dk-ass!)))
                (dk-apply! ve k)
                (dk-have! (list 'IN w (list hf k))
                  (lambda ()
                    (subst (list '== (list hf k) (cell k)))
                    (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
                (for-each (lambda (l)
                            (if (not (sequent-node-grounded? l))
                                (begin (dk-focus! l) (ass))))
                          (dk-opened (lambda () (bu-mi k)))))))
          (lambda (w)
            (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                   (k (cadr nin))
                   (kd (list '* k d))
                   (fw (list 'f w)))
              (dk-apply! ve k)
              (dk-have! (list 'IN w (cell k))
                (lambda () (subst (list '= (cell k) (list hf k))) (dk-ass!)))
              (sep-me (list 'IN w (cell k)))
              (dk-split-all!)
              (at! w)
              (icv-kd! k d)
              (let* ((sv (icv-sval 'n fw))
                     (img (icv-gimg-sub! 'n fw))
                     (ks (icv-kset 'n fw)))
                (dk-have! (list 'IN k ks) (lambda () (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
                (icv-in-image-d! (icv-phig 'n) ks k kd)
                (fact 'esup-gt-of-member img kd al)
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin (subst (list '= (list sn w) sv)) (dk-ass!)))))))))
        (subst (list '= tl bu))
        (dk-ass!))))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA sn)
  ;; the range lies in the finite set { k d : 0 <= k <= N }, n <= N d
  (icv-pos-rr! d)
  (let* ((ex (dk-fact! 'rr-archimedean-multiple d 'n))
         (nn (dk-skolem! ex))
         (iv (list 'INTERVAL 0 nn))
         (big (list 'IMAGE (icv-phig 'n) iv)))
    (fact 'nn-zero-in)
    (fact 'interval-in-set 0 nn)
    (fact 'interval-card-in-nn 0 nn)
    (fact 'card-image-finite (icv-phig 'n) iv)
    (fact 'image-set (icv-phig 'n) iv)
    (fact 'image-set sn 'omega)
    (fact 'nn-in-rr nn)
    (mac 'IS-SIMPLE-FN)
    (icv-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((dk-head-is? g 'FORALL)
                 (let* ((x (dk-di-var!)) (m (at! x)))
                   (subst (list '= (list sn x) (icv-sval 'n (list 'f x))))
                   (subst (list '= (icv-sval 'n (list 'f x)) (list '* m d)))
                   (dk-ass!)))
                (#t
                 (icv-fin-sub! big (list 'IMAGE sn 'omega)
                   (lambda (v)
                     (let* ((w (icv-img-elt! sn 'omega v))
                            (m (at! w))
                            (ks (icv-kset 'n (list 'f w)))
                            (md (list '* m d)))
                       (dk-have! (list '<= md 'n) (lambda () (sep-me (list 'IN m ks)) (dk-split-all!) (dk-ass!)))
                       (icv-mul-rr! nn d)
                       (dk-have! (list '<= md (list '* nn d))
                         (lambda () (dk-ineq! '(IN n RR) (list 'IN md 'RR) (list 'IN (list '* nn d) 'RR)
                                              (list '<= md 'n) (list '<= 'n (list '* nn d)))))
                       (fact 'nn-in-rr m)
                       (dk-have! (list '< 0 d) (lambda () (dk-ass!)))
                       (fact 'rr-mul-le-cancel-pos m d nn)
                       (fact 'nn-zero-le m)
                       (fact 'interval-mem-intro 0 nn m)
                       (icv-in-image-d! (icv-phig 'n) iv m md)
                       (subst (list '= v (list sn w)))
                       (subst (list '= (list sn w) (icv-sval 'n (list 'f w))))
                       (subst (list '= (icv-sval 'n (list 'f w)) md))
                       (dk-ass!))))
                 (dk-ass!))))))))
(qed 'grid-staircase-simple)
(topic! 'grid-staircase-simple 'analysis)
;;; integral-simple-approx -- statement copied from structure-library/integral.scm.
(define icv-cfa (list 'VNB-LAMBDA 'sn_ 'NN (icv-snl 'sn_)))
(sp (make-wff
  (forall-guarded '(omega cA f)
                  '((IS-SIGMA-ALGEBRA omega cA) (IS-MEASURABLE-FN omega cA f))
    (forsome-guarded '(cF)
                     (list '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                           (forall-guarded '(n_) '((IN n_ NN))
                             '(IS-SIMPLE-FN omega cA (cF n_)))
                           (forall-guarded '(n_) '((IN n_ NN))
                             '(PTWISE-LE omega (cF n_) (cF (succ n_)))))
      (forall-guarded '(x_) '((IN x_ omega))
        '(= ((PTWISE-SUP omega cF) x_) (f x_)))))))
(dk-peel!)
(icv-mfn-parts! 'omega 'cA 'f)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(ew icv-cfa)

;;; S(n, fx) <= fx
(define (icv-sv-le! n fx)
  (let* ((m (icv-gsv! n fx)) (d (icv-dl n)) (md (list '* m d)) (sv (icv-sval n fx)))
    (dk-have! (list '<= md fx)
      (lambda () (sep-me (list 'IN m (icv-kset n fx))) (dk-split-all!) (dk-ass!)))
    (dk-have! (list '<= sv fx) (lambda () (subst (list '= sv md)) (dk-ass!)))
    m))

(icv-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ;; typing
        ((dk-head-is? g 'IN)
         (dk-lam-type!
           (lambda ()
             (let ((n (dk-di-var!)))
               (dk-lam-type!
                 (lambda ()
                   (let ((x (dk-di-var!)))
                     (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
                     (icv-gsv! n (list 'f x))
                     (dk-ass!))))))))
        ;; each s_n is simple
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-SIMPLE-FN))
         (let ((n (dk-di-var!)))
           (fact 'grid-staircase-simple 'omega 'cA 'f n)
           (if (not (dk-lam-b!)) (dk-ass!))))
        ;; monotone
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'PTWISE-LE))
         (let* ((n (dk-di-var!)) (n1 (list 'succ n)))
           (fact 'nn-succ-closed n)
           (if (not (dk-lam-b!)) #t)
           (mac 'PTWISE-LE)
           (let* ((x (dk-di-var!)) (fx (list 'f x)))
             (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
             (if (dk--redex? (dk-goal)) (dk-lam-b!))
             (let* ((m (icv-sv-le! n fx))
                    (d (icv-dl n)) (d1 (icv-dl n1))
                    (md (list '* m d))
                    (m2 (list '* 2 m))
                    (q (list '* m2 d1)))
               (icv-dl-facts! n1)
               (icv-dl-succ! n)
               (dk-have! (list 'IN 2 'NN) (lambda () (arith)))
               (dk-have! (list 'AND '(IN 2 NN) (list 'IN m 'NN)))
               (fact 'nn-mul-closed 2 m)
               (icv-kd! m2 d1)
               (dk-have! (list '= q md)
                 (lambda () (subst (list '= d1 (list '* 1/2 d))) (crs)))
               (dk-have! (list '<= md n) (lambda () (sep-me (list 'IN m (icv-kset n fx))) (dk-split-all!) (dk-ass!)))
               (fact 'nn-succ-plus-one n)
               (fact 'nn-in-rr n)
               (dk-have! (list 'IN m2 (icv-kset n1 fx))
                 (lambda ()
                   (icv-sep-in!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'AND)
                              (icv-conj-close!
                                (lambda ()
                                  (if (equal? (caddr (dk-goal)) fx)
                                      (begin (subst (list '= q md)) (dk-ass!))
                                      (begin
                                        (subst (list '= q md))
                                        (subst (list '= n1 (list '+ n 1)))
                                        (dk-ineq! (list 'IN md 'RR) (list 'IN n 'RR) (list '<= md n)))))))
                             (#t (error "icv: unexpected leaf" (dk-goal))))))))
               (let ((img (icv-gimg-sub! n1 fx)))
                 (icv-in-image-d! (icv-phig n1) (icv-kset n1 fx) m2 q)
                 (fact 'esup-in img)
                 (dk-fact! 'esup-upper img q)
                 (subst (list '= (icv-sval n fx) md))
                 (subst (list '= md q))
                 (dk-ass!))))))
        ;; the supremum is f
        (#t
         (let* ((x (dk-di-var!)) (fx (list 'f x)))
           (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
           (mac 'PTWISE-SUP)
           (if (dk--redex? (dk-goal)) (dk-lam-b!))
           (let* ((tt (cadr (dk-goal)))
                  (lam (cadr (cadr tt)))
                  (val! (lambda (n)       ; (= (lam n) S(n, fx)), S typed
                          (icv-gsv! n fx)
                          (dk-have! (list '= (list lam n) (icv-sval n fx))
                            (lambda () (if (not (dk-lam-b!)) (rfl)))))))
             (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
               (lambda ()
                 (dk-lam-type!
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (if (dk--redex? (dk-goal)) (dk-lam-b!))
                       (icv-gsv! n fx)
                       (dk-ass!))))))
             (icv-seq-sup! lam)
             ;; T <= f(x)
             (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE lam 'NN)) (list '<= 'y fx)))
               (lambda ()
                 (let* ((v (dk-di-var!)) (n (icv-img-elt! lam 'NN v)))
                   (val! n)
                   (icv-sv-le! n fx)
                   (subst (list '= v (list lam n)))
                   (subst (list '= (list lam n) (icv-sval n fx)))
                   (dk-ass!))))
             (dk-have! (list 'AND (list 'IN fx 'RR-POS-STAR)
                             (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE lam 'NN)) (list '<= 'y fx)))))
             (dk-fact! 'esup-least (list 'IMAGE lam 'NN) fx)
             ;; f(x) <= T
             (let ((below! (lambda (n)   ; S(n, fx) <= T
                             (val! n)
                             (icv-in-image! lam n (icv-sval n fx))
                             (dk-fact! 'esup-upper (list 'IMAGE lam 'NN) (icv-sval n fx)))))
              (dk-have! (list '<= fx tt)
               (lambda ()
               (icv-star-cases! fx
                 (lambda ()
                   (use-em (list '<= fx tt)
                     (lambda () (dk-ass!))
                     (lambda ()
                       (dk-have! (list 'AND (list 'IN tt 'RR-POS-STAR) (list 'IN fx 'RR)))
                       (fact 'rr-pos-star-le-real-in-rr tt fx)
                       (fact 'rr-not-le-lt fx tt)
                       (let* ((eps (list '- fx tt)) (e2 (list '* 1/2 eps)))
                         (fact 'rr-sub-in-rr fx tt)
                         (dk-have! '(IN 1/2 RR) (lambda () (arith)))
                         (icv-mul-rr! 1/2 eps)
                         (dk-have! (list '< 0 e2) (lambda () (dk-ineq! (list 'IN fx 'RR) (list 'IN tt 'RR) (list '< tt fx))))
                         (icv-pos-rr! e2)
                         (dk-have! '(AND (<= 0 1/2) (< 1/2 1)) (lambda () (icv-conj-close! (lambda () (dk-ineq! '(IN 1/2 RR))))))
                         (let* ((pst (dk-fact! 'power-small-threshold 1/2 e2))
                                (cap (dk-skolem! pst))
                                (ex0 (dk-fact! 'nn-unbounded-in-rr fx))
                                (n0 (dk-skolem! ex0))
                                (n (list '+ cap n0)))
                           (dk-have! (list 'AND (list 'IN cap 'NN) (list 'IN n0 'NN)))
                           (fact 'nn-add-closed cap n0)
                           (fact 'nn-in-rr cap) (fact 'nn-in-rr n0) (fact 'nn-in-rr n)
                           (fact 'nn-zero-le cap) (fact 'nn-zero-le n0)
                           (dk-have! (list '<= cap n) (lambda () (dk-ineq! (list 'IN cap 'RR) (list 'IN n0 'RR) (list '<= 0 n0))))
                           (let* ((thr (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f e2))) "the threshold")))
                             (dk-apply! thr n))
                           (dk-have! (list '<= fx n) (lambda () (dk-ineq! (list 'IN fx 'RR) (list 'IN cap 'RR) (list 'IN n0 'RR)
                                                                          (list '< fx n0) (list '<= 0 cap))))
                           (let* ((m (icv-gsv! n fx)) (d (icv-dl n)) (md (list '* m d))
                                  (zb (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f (list '+ md d)))) "the floor bound")))
                             (fact 'rr-leq-reflexive fx)
                             (dk-apply! zb fx)
                             (below! n)
                             (dk-have! (list '<= md tt)
                               (lambda () (subst (list '= md (icv-sval n fx))) (dk-ass!)))
                             (dk-have! 'FALSITY
                               (lambda ()
                                 (dk-absurd! (list 'IN fx 'RR) (list 'IN tt 'RR) (list 'IN md 'RR) (list 'IN d 'RR)
                                             (list '< fx (list '+ md d)) (list '<= md tt) (list '<= d e2)
                                             (list '< 0 e2) (list '< tt fx))))
                             (icv-keep-prop! 'FALSITY)))))))
                 (lambda ()
                   (icv-star-cases! tt
                     (lambda ()
                       (fact 'rr-one-in)
                       (dk-have! (list 'AND (list 'IN tt 'RR) '(IN 1 RR)))
                       (fact 'rr-add-closed tt 1)
                       (let* ((ex0 (dk-fact! 'nn-unbounded-in-rr (list '+ tt 1)))
                              (n (dk-skolem! ex0)))
                         (fact 'nn-in-rr n)
                         (let* ((m (icv-gsv! n fx)) (d (icv-dl n)) (md (list '* m d))
                                (zb (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f (list '+ md d)))) "the floor bound")))
                           (fact 'rr-leq-reflexive n)
                           (dk-have! (list '<= n fx)
                             (lambda () (subst (list '= fx 'POS-INF)) (icv-rr-star! n) (fact 'pos-inf-upper-bound n) (dk-ass!)))
                           (dk-apply! zb n)
                           (below! n)
                           (dk-have! (list '<= md tt)
                             (lambda () (subst (list '= md (icv-sval n fx))) (dk-ass!)))
                           (dk-have! 'FALSITY
                             (lambda ()
                               (dk-absurd! (list 'IN n 'RR) (list 'IN tt 'RR) (list 'IN md 'RR) (list 'IN d 'RR)
                                           (list '< n (list '+ md d)) (list '<= md tt) (list '<= d 1)
                                           (list '< (list '+ tt 1) n))))
                           (icv-keep-prop! 'FALSITY))))
                     (lambda ()
                       (subst (list '= tt 'POS-INF))
                       (subst (list '= fx 'POS-INF))
                       (fact 'pos-inf-in-rr-pos-star)
                       (fact 'rr-pos-star-le-refl 'POS-INF)
                       (dk-ass!))))))))
             (dk-have! (list 'AND (list 'IN tt 'RR-POS-STAR) (list 'IN fx 'RR-POS-STAR)))
             (dk-have! (list 'AND (list '<= tt fx) (list '<= fx tt)))
             (fact 'rr-pos-star-le-antisymm tt fx)
             (dk-ass!))))))))
(qed 'integral-simple-approx)
(topic! 'integral-simple-approx 'analysis)
;;; =====================================================================
;;; (O) ADDITIVITY OF THE INTEGRAL (the notes' Thm. 2.7(4); Rudin Thm. 1.27
;;;     for two terms): simple s_n up to f, t_n up to g (integral-simple-approx),
;;;     s_n + t_n simple and up to f + g, then monotone convergence three times
;;;     and the simple-integral additivity in between.
;;; =====================================================================

;;; esup-eplus-eq: sup (u + v) = sup u + sup v for nondecreasing u, v
(sp (make-wff
     '(FORALL u (FORALL v
        (IMPLIES (IN u (FUN NN RR-POS-STAR))
          (IMPLIES (IN v (FUN NN RR-POS-STAR))
            (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (u n) (u (succ n)))))
              (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (v n) (v (succ n)))))
                (= (ESUP (IMAGE (VNB-LAMBDA n_ NN (eplus (u n_) (v n_))) NN))
                   (eplus (ESUP (IMAGE u NN)) (ESUP (IMAGE v NN))))))))))))
(dk-peel!)
(let* ((w '(VNB-LAMBDA n_ NN (eplus (u n_) (v n_))))
       (su (icv-seq-sup! 'u)) (sv (icv-seq-sup! 'v))
       (tw! (lambda (n)
              (fact 'fun-apply-type-c 'u 'NN 'RR-POS-STAR n)
              (fact 'fun-apply-type-c 'v 'NN 'RR-POS-STAR n)
              (dk-have! (list 'AND (list 'IN (list 'u n) 'RR-POS-STAR) (list 'IN (list 'v n) 'RR-POS-STAR)))
              (fact 'eplus-closed (list 'u n) (list 'v n)))))
  (dk-have! (list 'IN w '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (tw! n) (dk-ass!))))))
  (let ((sw (icv-seq-sup! w)) (ss (list 'eplus su sv)))
    (dk-have! (list 'AND (list 'IN su 'RR-POS-STAR) (list 'IN sv 'RR-POS-STAR)))
    (fact 'eplus-closed su sv)
    ;; sup w <= su + sv
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE w 'NN)) (list '<= 'x ss)))
      (lambda ()
        (let* ((x (dk-di-var!)) (n (icv-img-elt! w 'NN x)) (un (list 'u n)) (vn (list 'v n)))
          (tw! n)
          (dk-have! (list '= x (list 'eplus un vn))
            (lambda () (subst (list '= x (list w n))) (if (not (dk-lam-b!)) (rfl))))
          (icv-in-img! 'u 'NN n un)
          (icv-in-img! 'v 'NN n vn)
          (dk-fact! 'esup-upper '(IMAGE u NN) un)
          (dk-fact! 'esup-upper '(IMAGE v NN) vn)
          (dk-have! (list 'AND (list 'IN un 'RR-POS-STAR) (list 'AND (list 'IN vn 'RR-POS-STAR)
                          (list 'AND (list 'IN su 'RR-POS-STAR) (list 'IN sv 'RR-POS-STAR)))))
          (dk-have! (list 'AND (list '<= un su) (list '<= vn sv)))
          (fact 'eplus-mono un vn su sv)
          (subst (list '= x (list 'eplus un vn)))
          (dk-ass!))))
    (dk-have! (list 'AND (list 'IN ss 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE w 'NN)) (list '<= 'x ss)))))
    (dk-fact! 'esup-least (list 'IMAGE w 'NN) ss)
    ;; su + sv <= sup w
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= '(eplus (u n) (v n)) sw)))
      (lambda ()
        (let ((n (dk-di-var!)))
          (tw! n)
          (icv-in-image! w n (list 'eplus (list 'u n) (list 'v n)))
          (dk-fact! 'esup-upper (list 'IMAGE w 'NN) (list 'eplus (list 'u n) (list 'v n)))
          (dk-ass!))))
    (fact 'esup-eplus-le 'u 'v sw)
    (dk-have! (list 'AND (list 'IN sw 'RR-POS-STAR) (list 'IN ss 'RR-POS-STAR)))
    (dk-have! (list 'AND (list '<= sw ss) (list '<= ss sw)))
    (fact 'rr-pos-star-le-antisymm sw ss)
    (dk-ass!)))
(qed 'esup-eplus-eq)
(topic! 'esup-eplus-eq 'inequalities)

;;; simple-fn-eplus: the sum of two simple functions is simple
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL s (FORALL tf
        (IMPLIES (IS-SIMPLE-FN omega cA s)
          (IMPLIES (IS-SIMPLE-FN omega cA tf)
            (IS-SIMPLE-FN omega cA (PTWISE-EPLUS omega s tf))))))))))
(dk-peel!)
(let* ((ps (icv-parts! 'IS-SIMPLE-FN '(omega cA s)))
       (pt (icv-parts! 'IS-SIMPLE-FN '(omega cA tf)))
       (rs '(IMAGE s omega)) (rt '(IMAGE tf omega))
       (cc (list 'CARTESIAN rs rt))
       (st '(PTWISE-EPLUS omega s tf))
       (phi (list 'VNB-LAMBDA 'pp_ cc '(eplus (NTH 1 pp_) (NTH 2 pp_))))
       (hrs (icv-ptw 'omega (lambda (z) (list 'IN (list 's z) 'RR))))
       (hrt (icv-ptw 'omega (lambda (z) (list 'IN (list 'tf z) 'RR))))
       (val! (lambda (x)     ; (= (st x) (eplus (s x) (tf x))), both typed
               (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
               (fact 'fun-apply-type-c 'tf 'omega 'RR-POS-STAR x)
               (dk-have! (list 'AND (list 'IN (list 's x) 'RR-POS-STAR) (list 'IN (list 'tf x) 'RR-POS-STAR)))
               (fact 'eplus-closed (list 's x) (list 'tf x))
               (dk-have! (list '= (list st x) (list 'eplus (list 's x) (list 'tf x)))
                 (lambda () (mac 'PTWISE-EPLUS) (if (not (dk-lam-b!)) (rfl)))))))
  (icv-parts! 'IS-MEASURABLE-FN '(omega cA s))
  (icv-parts! 'IS-MEASURABLE-FN '(omega cA tf))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'measurable-fn-eplus 'omega 'cA 's 'tf)
  (icv-mfn-parts! 'omega 'cA '(PTWISE-EPLUS omega s tf))
  (fact 'image-set 's 'omega)
  (fact 'image-set 'tf 'omega)
  (let ((iff (dk-cite! 'cartesian-set-iff rs rt)))
    (dk-have! (list 'IN cc 'SET)
      (lambda () (icv-keep-prop! iff (list 'IN rs 'SET) (list 'IN rt 'SET)))))
  (fact 'card-cartesian-nn rs rt)
  (fact 'card-image-finite phi cc)
  (fact 'image-set phi cc)
  (fact 'image-set st 'omega)
  (mac 'IS-SIMPLE-FN)
  (icv-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'FORALL)
               (let ((x (dk-di-var!)))
                 (val! x)
                 (dk-apply! hrs x)
                 (dk-apply! hrt x)
                 (fact 'rr-pos-star-nonneg (list 's x))
                 (fact 'rr-pos-star-nonneg (list 'tf x))
                 (icv-eplus-eq! (list 's x) (list 'tf x))
                 (dk-have! (list 'AND (list 'IN (list 's x) 'RR) (list 'IN (list 'tf x) 'RR)))
                 (fact 'rr-add-closed (list 's x) (list 'tf x))
                 (subst (list '= (list st x) (list 'eplus (list 's x) (list 'tf x))))
                 (subst (list '= (list 'eplus (list 's x) (list 'tf x)) (list '+ (list 's x) (list 'tf x))))
                 (dk-ass!)))
              (#t
               (icv-fin-sub! (list 'IMAGE phi cc) (list 'IMAGE st 'omega)
                 (lambda (v)
                   (let* ((w (icv-img-elt! st 'omega v))
                          (pr (list 'LIST (list 's w) (list 'tf w))))
                     (val! w)
                     (icv-in-img! 's 'omega w (list 's w))
                     (icv-in-img! 'tf 'omega w (list 'tf w))
                     (fact 'pair-in-cartesian rs rt (list 's w) (list 'tf w))
                     (dk-have! (list '= (list phi pr) (list 'eplus (list 's w) (list 'tf w)))
                       (lambda ()
                         (dk-lam-b!)
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                             (begin (nth-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
                     (let* ((iff (dk-cite! 'image-membership-iff phi cc v))
                            (rhs (caddr iff)))
                       (dk-have! rhs
                         (lambda ()
                           (icv-conj-close!
                             (lambda ()
                               (cond ((dk-asm? (dk-goal)) (ass))
                                     ((dk-head-is? (dk-goal) 'FORSOME)
                                      (ew pr)
                                      (icv-conj-close!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal))
                                              (ass)
                                              (begin
                                                (subst (list '= (list phi pr) (list 'eplus (list 's w) (list 'tf w))))
                                                (subst (list '= v (list st w)))
                                                (subst (list '= (list st w) (list 'eplus (list 's w) (list 'tf w))))
                                                (rfl))))))
                                     (#t (fact 'fun-apply-type-c st 'omega 'RR-POS-STAR w)
                                         (fact 'membership-implies-sethood (list st w) 'RR-POS-STAR)
                                         (subst (list '= v (list st w)))
                                         (dk-ass!)))))))
                       (ai iff)
                       (detach! (list 'IMPLIES rhs (cadr iff)))
                       (dk-ass!)))))
               (dk-ass!)))))))
(qed 'simple-fn-eplus)
(topic! 'simple-fn-eplus 'analysis)
;;; integral-additive -- statement copied from structure-library/integral.scm.
(sp (make-wff
  (forall-guarded '(omega cA mu f g)
                  '((IS-MEASURE omega cA mu)
                    (IS-MEASURABLE-FN omega cA f)
                    (IS-MEASURABLE-FN omega cA g))
    '(= (INTEGRAL omega cA mu (PTWISE-EPLUS omega f g))
        (eplus (INTEGRAL omega cA mu f) (INTEGRAL omega cA mu g))))))
(dk-peel!)
(icv-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(icv-mfn-parts! 'omega 'cA 'f)
(icv-mfn-parts! 'omega 'cA 'g)

;;; IS-MEASURABLE-FN from IS-SIMPLE-FN of a term, by the defining iff
(define (icv-simple-mfn! tm)
  (let* ((iff (dk-cite! 'IS-SIMPLE-FN 'omega 'cA tm))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (dk-have! (list 'IS-MEASURABLE-FN 'omega 'cA tm)
      (lambda ()
        (ai iff)
        (detach! (list 'IMPLIES lhs rhs))
        (dk-split! rhs)
        (dk-ass!)))))

;;; dk-apply! unless the instance CLAIM is already in context
(define (icv-app! f claim . terms)
  (if (not (dk-asm? claim)) (apply dk-apply! f terms)))

;;; land the conjuncts of a predicate instance in context, by its defining iff
(define (icv-iff-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (ai iff)
    (detach! (list 'IMPLIES lhs rhs))
    (dk-split! rhs)))

;;; the approximating sequence of fv, as a symbol; land everything about it.
;;; Returns (A IA SA): A the sequence, IA = n |-> INTEGRAL(A n), SA = ESUP(IMAGE IA NN),
;;; with (= (INTEGRAL fv) SA) in context.
(define (icv-approx! fv)
  (let* ((ex (dk-fact! 'integral-simple-approx 'omega 'cA fv))
         (aa (dk-skolem! ex))
         (hs (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-SIMPLE-FN 'omega 'cA (list aa 'n_)))))
         (hm (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list aa 'n_)))))
         (hl (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list aa 'n_) (list aa '(succ n_))))))
         (ia (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'cA 'mu (list aa 'n_))))
         (psa (list 'PTWISE-SUP 'omega aa)))
    (dk-have! hm
      (lambda ()
        (let ((n (dk-di-var!)))
          (dk-apply! hs n)
          (icv-simple-mfn! (list aa n))
          (dk-ass!))))
    (let ((mct (dk-fact! 'monotone-convergence 'omega 'cA 'mu aa)))
      (dk-split! mct))
    (icv-mfn-parts! 'omega 'cA psa)
    (dk-fun-ext! psa fv 'omega 'RR-POS-STAR #f #f
      (lambda (x)
        (dk-apply! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list '= (list psa 'x_) (list fv 'x_)))) x)
        (dk-ass!)))
    (dk-have! (list 'IN ia '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((n (dk-di-var!)))
              (dk-apply! hm n)
              (fact 'integral-in 'omega 'cA 'mu (list aa n))
              (dk-ass!))))))
    (let ((sa (icv-seq-sup! ia)))
      (dk-have! (list '= (list 'INTEGRAL 'omega 'cA 'mu fv) sa)
        (lambda ()
          (subst (list '= fv psa))
          (dk-ass!)))
      ;; IA nondecreasing
      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list ia 'n) (list ia '(succ n)))))
        (lambda ()
          (let* ((n (dk-di-var!)) (n1 (list 'succ n)))
            (fact 'nn-succ-closed n)
            (dk-apply! hm n)
            (dk-apply! hm n1)
            (dk-apply! hl n)
            (fact 'integral-monotone 'omega 'cA 'mu (list aa n) (list aa n1))
            (fact 'integral-in 'omega 'cA 'mu (list aa n))
            (fact 'integral-in 'omega 'cA 'mu (list aa n1))
            (if (not (dk-lam-b!)) (dk-ass!)))))
      (list aa ia sa hs hl))))

(let* ((ra (icv-approx! 'f)) (aa (car ra)) (ia (cadr ra)) (sa (caddr ra)) (hsa (cadddr ra)) (hla (car (cddddr ra)))
       (rb (icv-approx! 'g)) (bb (car rb)) (ib (cadr rb)) (sb (caddr rb)) (hsb (cadddr rb)) (hlb (car (cddddr rb)))
       (pe (lambda (n) (list 'PTWISE-EPLUS 'omega (list aa n) (list bb n))))
       (uu (list 'VNB-LAMBDA 'un_ 'NN (pe 'un_)))
       (fg '(PTWISE-EPLUS omega f g))
       (psu (list 'PTWISE-SUP 'omega uu))
       (uval! (lambda (n)
                (if (not (dk-asm? (list 'IS-SIMPLE-FN 'omega 'cA (pe n))))
                    (begin
                      (icv-app! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list aa 'n_))))
                                (list 'IS-MEASURABLE-FN 'omega 'cA (list aa n)) n)
                      (icv-app! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list bb 'n_))))
                                (list 'IS-MEASURABLE-FN 'omega 'cA (list bb n)) n)
                      (icv-app! hsa (list 'IS-SIMPLE-FN 'omega 'cA (list aa n)) n)
                      (icv-app! hsb (list 'IS-SIMPLE-FN 'omega 'cA (list bb n)) n)
                      (fact 'simple-fn-eplus 'omega 'cA (list aa n) (list bb n))
                      (icv-simple-mfn! (pe n))
                      (icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA (pe n))))))))
  ;; U(n) = A(n) + B(n): typed, measurable, nondecreasing
  (dk-have! (list 'IN uu '(FUN NN (FUN omega RR-POS-STAR)))
    (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (uval! n) (dk-ass!))))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list uu 'n_))))
    (lambda () (let ((n (dk-di-var!))) (uval! n) (if (not (dk-lam-b!)) (dk-ass!)))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list uu 'n_) (list uu '(succ n_)))))
    (lambda ()
      (let* ((n (dk-di-var!)) (n1 (list 'succ n)))
        (fact 'nn-succ-closed n)
        (dk-lam-b!)
        (mac 'PTWISE-LE)
        (let* ((x (dk-di-var!))
               (le-at! (lambda (sq hl)
                         (let ((pl (dk-apply! hl n))
                               (iff (dk-cite! 'PTWISE-LE 'omega (list sq n) (list sq n1))))
                           (dk-have! (list '<= (list (list sq n) x) (list (list sq n1) x))
                             (lambda ()
                               (ai iff)
                               (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                               (dk-apply! (caddr iff) x)
                               (dk-ass!))))))
               (ty! (lambda (sq m) (fact 'fun-apply-type-c sq 'NN '(FUN omega RR-POS-STAR) m)
                                   (fact 'fun-apply-type-c (list sq m) 'omega 'RR-POS-STAR x))))
          (ty! aa n) (ty! aa n1) (ty! bb n) (ty! bb n1)
          (le-at! aa hla)
          (le-at! bb hlb)
          (mac 'PTWISE-EPLUS)
          (if (dk--redex? (dk-goal)) (dk-lam-b!))
          (let ((a0 (list (list aa n) x)) (a1 (list (list aa n1) x))
                (b0 (list (list bb n) x)) (b1 (list (list bb n1) x)))
            (dk-have! (list 'AND (list 'IN a0 'RR-POS-STAR) (list 'AND (list 'IN b0 'RR-POS-STAR)
                            (list 'AND (list 'IN a1 'RR-POS-STAR) (list 'IN b1 'RR-POS-STAR)))))
            (dk-have! (list 'AND (list '<= a0 a1) (list '<= b0 b1)))
            (fact 'eplus-mono a0 b0 a1 b1)
            (dk-ass!))))))
  (let ((mct (dk-fact! 'monotone-convergence 'omega 'cA 'mu uu)))
    (dk-split! mct))
  (icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA psu))
  (fact 'measurable-fn-eplus 'omega 'cA 'f 'g)
  (icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA fg))
  ;; sup U = f + g pointwise
  (dk-fun-ext! psu fg 'omega 'RR-POS-STAR #f #f
    (lambda (x)
      (let* ((ua (list 'VNB-LAMBDA 'n_ 'NN (list (list aa 'n_) x)))
             (ub (list 'VNB-LAMBDA 'n_ 'NN (list (list bb 'n_) x)))
             (ty! (lambda (sq u)
                    (dk-have! (list 'IN u '(FUN NN RR-POS-STAR))
                      (lambda ()
                        (dk-lam-type!
                          (lambda ()
                            (let ((m (dk-di-var!)))
                              (fact 'fun-apply-type-c sq 'NN '(FUN omega RR-POS-STAR) m)
                              (fact 'fun-apply-type-c (list sq m) 'omega 'RR-POS-STAR x)
                              (dk-ass!))))))
                    (icv-seq-sup! u)))
             (mono! (lambda (sq u hl)
                      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list u 'n) (list u '(succ n)))))
                        (lambda ()
                          (let* ((n (dk-di-var!)) (n1 (list 'succ n)))
                            (fact 'nn-succ-closed n)
                            (dk-apply! hl n)
                            (let ((iff (dk-cite! 'PTWISE-LE 'omega (list sq n) (list sq n1))))
                              (dk-have! (list '<= (list (list sq n) x) (list (list sq n1) x))
                                (lambda ()
                                  (ai iff)
                                  (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                                  (dk-apply! (caddr iff) x)
                                  (dk-ass!))))
                            (fact 'fun-apply-type-c sq 'NN '(FUN omega RR-POS-STAR) n)
                            (fact 'fun-apply-type-c (list sq n) 'omega 'RR-POS-STAR x)
                            (fact 'fun-apply-type-c sq 'NN '(FUN omega RR-POS-STAR) n1)
                            (fact 'fun-apply-type-c (list sq n1) 'omega 'RR-POS-STAR x)
                            (if (not (dk-lam-b!)) (dk-ass!)))))))
             (sua (ty! aa ua)) (sub (ty! bb ub)))
        (mono! aa ua hla)
        (mono! bb ub hlb)
        ;; f(x) = sup_n A(n)(x), g(x) likewise
        (dk-have! (list '= (list 'f x) sua)
          (lambda ()
            (dk-apply! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                         (list '= (list (list 'PTWISE-SUP 'omega aa) 'x_) '(f x_)))) x)
            (dk-have! (list '= (list (list 'PTWISE-SUP 'omega aa) x) sua)
              (lambda () (mac 'PTWISE-SUP) (if (not (dk-lam-b!)) (rfl))))
            (subst (list '= (list 'f x) (list (list 'PTWISE-SUP 'omega aa) x)))
            (dk-ass!)))
        (dk-have! (list '= (list 'g x) sub)
          (lambda ()
            (dk-apply! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                         (list '= (list (list 'PTWISE-SUP 'omega bb) 'x_) '(g x_)))) x)
            (dk-have! (list '= (list (list 'PTWISE-SUP 'omega bb) x) sub)
              (lambda () (mac 'PTWISE-SUP) (if (not (dk-lam-b!)) (rfl))))
            (subst (list '= (list 'g x) (list (list 'PTWISE-SUP 'omega bb) x)))
            (dk-ass!)))
        (let ((eq (dk-fact! 'esup-eplus-eq ua ub)))
          (if (dk--redex? eq) (dk-lam-b-h! eq)))
        (mac 'PTWISE-SUP)
        (mac 'PTWISE-EPLUS)
        (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
        (subst (list '= (list 'f x) sua))
        (subst (list '= (list 'g x) sub))
        (dk-ass!))))
  ;; the integrals: INTEGRAL(U n) = INTEGRAL(A n) + INTEGRAL(B n)
  (let* ((iu (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'cA 'mu (list uu 'n_))))
         (wp (list 'VNB-LAMBDA 'n_ 'NN (list 'eplus (list 'INTEGRAL 'omega 'cA 'mu (list aa 'n_))
                                                    (list 'INTEGRAL 'omega 'cA 'mu (list bb 'n_))))))
    (dk-fun-ext! iu wp 'NN 'RR-POS-STAR
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((n (dk-di-var!)))
              (uval! n)
              (fact 'integral-in 'omega 'cA 'mu (pe n))
              (if (not (dk-lam-b!)) (dk-ass!))))))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((n (dk-di-var!)))
              (uval! n)
              (fact 'integral-in 'omega 'cA 'mu (list aa n))
              (fact 'integral-in 'omega 'cA 'mu (list bb n))
              (dk-have! (list 'AND (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (list aa n)) 'RR-POS-STAR)
                              (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (list bb n)) 'RR-POS-STAR)))
              (fact 'eplus-closed (list 'INTEGRAL 'omega 'cA 'mu (list aa n)) (list 'INTEGRAL 'omega 'cA 'mu (list bb n)))
              (dk-ass!)))))
      (lambda (v)
        (uval! v)
        (icv-app! hsa (list 'IS-SIMPLE-FN 'omega 'cA (list aa v)) v)
        (icv-app! hsb (list 'IS-SIMPLE-FN 'omega 'cA (list bb v)) v)
        (fact 'integral-simple 'omega 'cA 'mu (pe v))
        (fact 'integral-simple 'omega 'cA 'mu (list aa v))
        (fact 'integral-simple 'omega 'cA 'mu (list bb v))
        (fact 'simple-integral-additive 'omega 'cA 'mu (list aa v) (list bb v))
        (fact 'integral-in 'omega 'cA 'mu (list aa v))
        (fact 'integral-in 'omega 'cA 'mu (list bb v))
        (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin
              (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu (pe v)) (list 'SIMPLE-INTEGRAL 'omega 'mu (pe v))))
              (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu (pe v))
                           (list 'eplus (list 'SIMPLE-INTEGRAL 'omega 'mu (list aa v)) (list 'SIMPLE-INTEGRAL 'omega 'mu (list bb v)))))
              (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu (list aa v)) (list 'INTEGRAL 'omega 'cA 'mu (list aa v))))
              (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu (list bb v)) (list 'INTEGRAL 'omega 'cA 'mu (list bb v))))
              (dk-have! (list 'AND (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (list aa v)) 'RR-POS-STAR)
                              (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (list bb v)) 'RR-POS-STAR)))
              (fact 'eplus-closed (list 'INTEGRAL 'omega 'cA 'mu (list aa v)) (list 'INTEGRAL 'omega 'cA 'mu (list bb v)))
              (rfl)))))
    (let ((eq (dk-fact! 'esup-eplus-eq ia ib)))
      (if (dk--redex? eq) (dk-lam-b-h! eq)))
    ;; the chain
    (subst (list '= fg psu))
    (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu psu) (list 'ESUP (list 'IMAGE iu 'NN))))
    (subst (list '= iu wp))
    (subst (list '= '(INTEGRAL omega cA mu f) sa))
    (subst (list '= '(INTEGRAL omega cA mu g) sb))
    (dk-ass!)))
(qed 'integral-additive)
(topic! 'integral-additive 'analysis)
;;; =====================================================================
;;; (P) BRICKS FOR DOMINATED CONVERGENCE: the set { v < u } of two measurable
;;;     functions, constants, the finite part { u in RR }, and a finite integral
;;;     is finite almost everywhere.
;;; =====================================================================

;;; measurable-fn-lt-row: one row of grid cells { v < q < u }, q = k r
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL u (FORALL v (FORALL r
        (IMPLIES (IS-MEASURABLE-FN omega cA u)
          (IMPLIES (IS-MEASURABLE-FN omega cA v)
            (IMPLIES (IN r RR)
              (IN (SEP x_ omega (FORSOME k_ (AND (IN k_ NN)
                                              (AND (< (v x_) (* k_ r)) (< (* k_ r) (u x_))))))
                  cA)))))))))))
(dk-peel!)
(let* ((pu (icv-mfn-parts! 'omega 'cA 'u))
       (pv (icv-mfn-parts! 'omega 'cA 'v))
       (tu (caddr pu))
       (row '(SEP x_ omega (FORSOME k_ (AND (IN k_ NN) (AND (< (v x_) (* k_ r)) (< (* k_ r) (u x_)))))))
       (ge (lambda (k) (list 'SEP 'gx_ 'omega (list '<= (list '* k 'r) '(v gx_)))))
       (ta (lambda (k) (list 'COMPLEMENT-IN 'omega (ge k))))
       (tb (lambda (k) (list 'SEP 'x_ 'omega (list '< (list '* k 'r) '(u x_)))))
       (body-of (lambda (k) (list 'INTERSECTION (ta k) (tb k))))
       (inca! (lambda (k)
                (fact 'nn-in-rr k)
                (icv-mul-rr! k 'r)
                (fact 'measurable-fn-ge 'omega 'cA 'v (list '* k 'r))
                (fact 'sigma-algebra-complement-closed 'omega 'cA (ge k))
                (dk-apply! tu (list '* k 'r))
                (fact 'sigma-algebra-inter-closed-2 'omega 'cA (ta k) (tb k))))
       (hve (icv-abstract! 'NN 'cA body-of
              (lambda (k) (inca! k) (dk-ass!))
              (lambda (k) (inca! k) (fact 'membership-implies-sethood (body-of k) 'cA))))
       (hf  (car hve))
       (ve  (cdr hve))
       (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
  (fact 'sigma-algebra-union-closed 'omega 'cA hf)
  (icv-set-eq! row bu
    (lambda (w)
      (sep-me (list 'IN w row))
      (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
             (k  (dk-skolem! ex))
             (kr (list '* k 'r))
             (vw (list 'v w)))
        (fact 'nn-in-rr k)
        (icv-mul-rr! k 'r)
        (fact 'fun-apply-type-c 'v 'omega 'RR-POS-STAR w)
        (dk-apply! ve k)
        (dk-have! (list 'IN w (list hf k))
          (lambda ()
            (subst (list '== (list hf k) (body-of k)))
            (mac 'intersection-membership)
            (icv-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (if (equal? (caddr (dk-goal)) (ta k))
                        (begin
                          (mac 'complement-in-membership)
                          (icv-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (begin
                                    (di)
                                    (sep-me (list 'IN w (ge k)))
                                    (icv-lt-clash! vw kr))))))
                        (icv-sep-in! (lambda () (dk-ass!))))
                    (dk-ass!))))))
        (for-each (lambda (l)
                    (if (not (sequent-node-grounded? l))
                        (begin (dk-focus! l) (ass))))
                  (dk-opened (lambda () (bu-mi k))))))
    (lambda (w)
      (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
             (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
             (k   (cadr nin))
             (kr  (list '* k 'r))
             (vw  (list 'v w)))
        (fact 'nn-in-rr k)
        (icv-mul-rr! k 'r)
        (dk-apply! ve k)
        (dk-have! (list 'IN w (body-of k))
          (lambda () (subst (list '= (body-of k) (list hf k))) (ass)))
        (mac-h 'intersection-membership (list 'IN w (body-of k)))
        (dk-split-all!)
        (mac-h 'complement-in-membership (list 'IN w (ta k)))
        (dk-split-all!)
        (fact 'fun-apply-type-c 'v 'omega 'RR-POS-STAR w)
        (sep-me (list 'IN w (tb k)))
        (dk-have! (list 'NOT (list '<= kr vw))
          (lambda ()
            (di)
            (dk-have! (list 'IN w (ge k)) (lambda () (icv-sep-in! (lambda () (dk-ass!)))))
            (icv-keep-prop! (list 'IN w (ge k)) (list 'NOT (list 'IN w (ge k))))))
        (dk-have! (list '< vw kr)
          (lambda ()
            (icv-star-cases! vw
              (lambda () (fact 'rr-not-le-lt kr vw) (dk-ass!))
              (lambda ()
                (dk-have! (list '<= kr vw)
                  (lambda () (subst (list '= vw 'POS-INF)) (icv-rr-star! kr) (fact 'pos-inf-upper-bound kr) (dk-ass!)))
                (icv-keep-prop! (list '<= kr vw) (list 'NOT (list '<= kr vw)))))))
        (icv-sep-in!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin (ew k) (icv-conj-close! (lambda () (dk-ass!))))))))))
  (subst (list '= row bu))
  (dk-ass!))
(qed 'measurable-fn-lt-row)
(topic! 'measurable-fn-lt-row 'analysis)

;;; measurable-fn-lt-set: { v < u } is measurable
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL u (FORALL v
        (IMPLIES (IS-MEASURABLE-FN omega cA u)
          (IMPLIES (IS-MEASURABLE-FN omega cA v)
            (IN (SEP x_ omega (< (v x_) (u x_))) cA)))))))))
(dk-peel!)
(let* ((pu (icv-mfn-parts! 'omega 'cA 'u))
       (pv (icv-mfn-parts! 'omega 'cA 'v))
       (tl '(SEP x_ omega (< (v x_) (u x_))))
       (row-of (lambda (n)
                 (let ((r (icv-recip n)))
                   (list 'SEP 'x_ 'omega
                         (list 'FORSOME 'k_ (list 'AND '(IN k_ NN)
                                                  (list 'AND (list '< '(v x_) (list '* 'k_ r))
                                                        (list '< (list '* 'k_ r) '(u x_)))))))))
       (rfacts! (lambda (n)
                  (fact 'nn-recip-succ-pos n)
                  (fact 'rr-pos-rr-in-rr (icv-recip n))
                  (fact 'rr-lt-of-pos-rr (icv-recip n))))
       (inca! (lambda (n) (rfacts! n) (fact 'measurable-fn-lt-row 'omega 'cA 'u 'v (icv-recip n))))
       (hve (icv-abstract! 'NN 'cA row-of
              (lambda (n) (inca! n) (dk-ass!))
              (lambda (n) (inca! n) (fact 'membership-implies-sethood (row-of n) 'cA))))
       (hf (car hve)) (ve (cdr hve))
       (bu (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
  (fact 'sigma-algebra-union-closed 'omega 'cA hf)
  (icv-set-eq! tl bu
    (lambda (w)
      (let ((uw (list 'u w)) (vw (list 'v w)))
        (sep-me (list 'IN w tl))
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (fact 'fun-apply-type-c 'v 'omega 'RR-POS-STAR w)
        (icv-star-cases! vw
          (lambda ()
            (let ((finish!
                   (lambda (b q-u!)
                     (let* ((ex (dk-fact! 'rr-grid-between vw b))
                            (n  (dk-skolem! ex))
                            (ex2 (dk-pick (dk-head? 'forsome) "the grid numerator"))
                            (k  (dk-skolem! ex2))
                            (q  (icv-gq n k)))
                       (rfacts! n)
                       (fact 'nn-in-rr k)
                       (icv-mul-rr! k (icv-recip n))
                       (dk-apply! ve n)
                       (dk-have! (list 'IN w (list hf n))
                         (lambda ()
                           (subst (list '== (list hf n) (row-of n)))
                           (icv-sep-in!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (ass)
                                   (begin
                                     (ew k)
                                     (icv-conj-close!
                                       (lambda ()
                                         (cond ((dk-asm? (dk-goal)) (ass))
                                               (#t (q-u! q)))))))))))
                       (for-each (lambda (l)
                                   (if (not (sequent-node-grounded? l))
                                       (begin (dk-focus! l) (ass))))
                                 (dk-opened (lambda () (bu-mi n))))))))
              (icv-star-cases! uw
                (lambda () (finish! uw (lambda (q) (dk-ass!))))
                (lambda ()
                  (fact 'rr-one-in)
                  (dk-have! (list 'AND (list 'IN vw 'RR) '(IN 1 RR)))
                  (fact 'rr-add-closed vw 1)
                  (dk-have! (list '< vw (list '+ vw 1)) (lambda () (dk-ineq! (list 'IN vw 'RR))))
                  (finish! (list '+ vw 1)
                    (lambda (q) (subst (list '= uw 'POS-INF)) (icv-lt-pos-inf! q)))))))
          (lambda ()
            (fact 'rr-pos-star-below-pos-inf uw)
            (dk-have! (list '< 'POS-INF uw) (lambda () (subst (list '= 'POS-INF vw)) (dk-ass!)))
            (let ((iff (dk-cite! '< 'POS-INF uw)))
              (dk-have! (list 'AND (list '<= 'POS-INF uw) (list 'NOT (list '= 'POS-INF uw)))
                (lambda () (icv-keep-prop! iff (list '< 'POS-INF uw))))
              (dk-split! (list 'AND (list '<= 'POS-INF uw) (list 'NOT (list '= 'POS-INF uw))))
              (fact 'pos-inf-in-rr-pos-star)
              (dk-have! (list 'AND '(IN POS-INF RR-POS-STAR) (list 'IN uw 'RR-POS-STAR)))
              (dk-have! (list 'AND '(<= POS-INF POS-INF) '(<= POS-INF POS-INF)) (lambda () (fact 'rr-pos-star-le-refl 'POS-INF) (icv-conj-close! (lambda () (dk-ass!)))))
              (dk-have! (list 'AND (list '<= 'POS-INF uw) (list '<= uw 'POS-INF)))
              (fact 'rr-pos-star-le-antisymm 'POS-INF uw)
              (icv-keep-prop! (list '= 'POS-INF uw) (list 'NOT (list '= 'POS-INF uw))))))))
    (lambda (w)
      (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
             (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
             (n (cadr nin))
             (uw (list 'u w)) (vw (list 'v w)))
        (dk-apply! ve n)
        (dk-have! (list 'IN w (row-of n))
          (lambda () (subst (list '= (row-of n) (list hf n))) (ass)))
        (sep-me (list 'IN w (row-of n)))
        (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
               (k  (dk-skolem! ex))
               (q  (icv-gq n k)))
          (rfacts! n)
          (fact 'nn-in-rr k)
          (icv-mul-rr! k (icv-recip n))
          (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
          (fact 'fun-apply-type-c 'v 'omega 'RR-POS-STAR w)
          (fact 'nn-zero-le k)
          (fact 'rr-lt-implies-le 0 (icv-recip n))
          (icv-mul-nonneg! k (icv-recip n))
          (icv-rps! q)
          (icv-sep-in!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin
                    (dk-have! (list 'IN vw 'RR)
                      (lambda ()
                        (let ((iff (dk-cite! '< vw q)))
                          (dk-have! (list '<= vw q) (lambda () (icv-keep-prop! iff (list '< vw q))))
                          (dk-have! (list 'AND (list 'IN vw 'RR-POS-STAR) (list 'IN q 'RR)))
                          (fact 'rr-pos-star-le-real-in-rr vw q)
                          (dk-ass!))))
                    (fact 'rr-pos-star-nonneg vw)
                    (icv-rps! vw)
                    (fact 'rps-lt-le-trans vw q uw)
                    (let ((iff (dk-cite! '< q uw)))
                      (dk-have! (list '<= q uw) (lambda () (icv-keep-prop! iff (list '< q uw)))))
                    (fact 'rps-lt-le-trans vw q uw)
                    (dk-ass!)))))))))
  (subst (list '= tl bu))
  (dk-ass!))
(qed 'measurable-fn-lt-set)
(topic! 'measurable-fn-lt-set 'analysis)
;;; measurable-fn-const: a constant function is measurable
(sp (make-wff
