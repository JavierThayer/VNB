  (let ((eqoff (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x nb))
                 (list '= (list h1 'x) '(u x)))))))
    (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x nb))
                (list '<= (list h1 'x) '(u x)))))
      (lambda ()
        (let* ((landed (dk-peel!))
               (x (cadr (car (filter (lambda (f) (and (eq? (car f) 'in) (equal? (caddr f) 'omega))) landed)))))
          (dk-apply! eqoff x)
          (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR x)
