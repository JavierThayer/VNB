        (fact 'eplus-closed h2x (list mi x))
        (dk-have! (list '= (list kk x) (list 'eplus h2x (list mi x)))
          (lambda () (mac 'PTWISE-EPLUS) (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (subst (list '= (list kk x) (list 'eplus h2x (list mi x))))
        (use-em (list 'IN x 'nb)
          (lambda ()
            (mi-in! x)
            (subst (list '= (list mi x) 'POS-INF))
            (fact 'eplus-pos-inf-right h2x)
            (subst (list '= (list 'eplus h2x 'POS-INF) 'POS-INF))
            (fact 'rr-pos-star-below-pos-inf h1x)
            (dk-ass!))
          (lambda ()
            (mi-out! x)
            (subst (list '= (list mi x) 0))
            (fact 'eplus-zero-right h2x)
            (subst (list '= (list 'eplus h2x 0) h2x))
            (dk-apply! hle x)
            (dk-ass!))))))
  (fact 'integral-monotone 'omega 'cA 'mu 'h1 kk)
  (fact 'integral-additive 'omega 'cA 'mu 'h2 mi)
  (fact 'integral-infinite-on-null 'omega 'cA 'mu 'nb)
  (fact 'integral-in 'omega 'cA 'mu 'h2)
  (fact 'eplus-zero-right '(INTEGRAL omega cA mu h2))
  (dk-have! (list '= (list 'INTEGRAL 'omega 'cA 'mu kk) '(INTEGRAL omega cA mu h2))
    (lambda ()
      (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu kk)
                   (list 'eplus '(INTEGRAL omega cA mu h2) (list 'INTEGRAL 'omega 'cA 'mu mi))))
      (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu mi) 0))
      (subst (list '= '(eplus (INTEGRAL omega cA mu h2) 0) '(INTEGRAL omega cA mu h2)))
      (fact 'integral-in 'omega 'cA 'mu 'h2)
      (rfl)))
  (subst (list '= '(INTEGRAL omega cA mu h2) (list 'INTEGRAL 'omega 'cA 'mu kk)))
  (dk-ass!))
