;;; =====================================================================
;;; (R) LOWER AND UPPER LIMITS OF SEQUENCES IN [0,+inf]: lim inf <= lim sup,
;;;     a bound passes to lim sup, and the reflection b = c - a of a sequence
;;;     below a real c exchanges them: lim inf b = c - lim sup a.
;;; =====================================================================

;;; the tail index set and image of a sequence sq at m; returns (D IMG),
;;; landing (SUBSET D NN), (SUBSET IMG RR-POS-STAR), (== (ETAIL sq m) IMG)
(define (icv-tail! sq m)
  (let* ((d (icv-tail-sub! m))
         (img (list 'IMAGE sq d)))
    (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
        (dk-have! (list 'SUBSET img 'RR-POS-STAR)
          (lambda ()
            (mac 'subset-def)
            (let* ((v (dk-di-var!)) (p (icv-img-elt! sq d v)))
              (fact 'subset-mem-fwd d 'NN p)
              (fact 'fun-apply-type-c sq 'NN 'RR-POS-STAR p)
              (subst (list '= v (list sq p)))
              (dk-ass!)))))
    (if (not (dk-asm? (list '== (list 'ETAIL sq m) img)))
        (dk-have! (list '== (list 'ETAIL sq m) img) (lambda () (mac 'ETAIL) (qrfl))))
    (list d img)))
;;; p in NN, m <= p: (IN (sq p) IMG(sq, m))
(define (icv-in-tail! sq m p)
  (let* ((td (icv-tail! sq m)) (d (car td)) (img (cadr td)))
    (if (equal? m p) (begin (fact 'nn-in-rr m) (fact 'rr-leq-reflexive m)))
    (dk-have! (list 'IN p d) (lambda () (icv-sep-in! (lambda () (dk-ass!)))))
    (fact 'fun-apply-type-c sq 'NN 'RR-POS-STAR p)
    (icv-in-img! sq d p (list sq p))
    img))

;;; elimsup-le-bound
(sp (make-wff
     '(FORALL a (IMPLIES (IN a (FUN NN RR-POS-STAR))
        (FORALL b (IMPLIES (IN b RR-POS-STAR)
          (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (a n) b)))
            (<= (ELIMSUP a) b))))))))
(dk-peel!)
(let* ((hb '(FORALL n (IMPLIES (IN n NN) (<= (a n) b))))
       (sl '(VNB-LAMBDA n_ NN (ESUP (ETAIL a n_)))))
  (fact 'nn-zero-in)
  (let* ((td (icv-tail! 'a 0)) (img (cadr td)))
    (fact 'esup-in img)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x img) (list '<= 'x 'b)))
      (lambda ()
        (let* ((v (dk-di-var!)) (p (icv-img-elt! 'a (car td) v)))
          (fact 'subset-mem-fwd (car td) 'NN p)
          (dk-apply! hb p)
          (subst (list '= v (list 'a p)))
          (dk-ass!))))
    (dk-have! (list 'AND '(IN b RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x img) (list '<= 'x 'b)))))
    (dk-fact! 'esup-least img 'b)
    (dk-have! (list 'IN sl '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((m (dk-di-var!)) (tm (icv-tail! 'a m)))
              (fact 'esup-in (cadr tm))
              (subst (list '== (list 'ETAIL 'a m) (cadr tm)))
              (dk-ass!))))))
    (dk-have! (list 'SUBSET (list 'IMAGE sl 'NN) 'RR-POS-STAR)
      (lambda ()
        (mac 'subset-def)
        (let ((v (dk-di-var!)))
          (fact 'image-subset-codomain 'NN 'RR-POS-STAR sl v)
          (dk-ass!))))
    (let ((s0 (list 'ESUP (list 'ETAIL 'a 0))))
      (dk-have! (list 'IN s0 'RR-POS-STAR)
        (lambda () (subst (list '== (list 'ETAIL 'a 0) img)) (dk-ass!)))
      (icv-in-image-d! sl 'NN 0 s0)
      (dk-fact! 'einf-lower (list 'IMAGE sl 'NN) s0)
      (fact 'einf-in (list 'IMAGE sl 'NN))
      (let ((li (list 'EINF (list 'IMAGE sl 'NN))))
        (dk-have! (list '<= s0 'b) (lambda () (subst (list '== (list 'ETAIL 'a 0) img)) (dk-ass!)))
        (dk-have! (list 'AND (list 'IN li 'RR-POS-STAR) (list 'AND (list 'IN s0 'RR-POS-STAR) '(IN b RR-POS-STAR))))
        (dk-have! (list 'AND (list '<= li s0) (list '<= s0 'b)))
        (fact 'rr-pos-star-le-trans li s0 'b)
        (mac 'ELIMSUP)
        (dk-ass!)))))
(qed 'elimsup-le-bound)
(topic! 'elimsup-le-bound 'inequalities)

;;; eliminf-le-elimsup
(sp (make-wff
     '(FORALL a (IMPLIES (IN a (FUN NN RR-POS-STAR))
        (<= (ELIMINF a) (ELIMSUP a))))))
(dk-peel!)
(let* ((il '(VNB-LAMBDA n_ NN (EINF (ETAIL a n_))))
       (sl '(VNB-LAMBDA n_ NN (ESUP (ETAIL a n_))))
       (ityped! (lambda (m) (let ((tm (icv-tail! 'a m)))
                              (fact 'einf-in (cadr tm))
                              (dk-have! (list 'IN (list 'EINF (list 'ETAIL 'a m)) 'RR-POS-STAR)
                                (lambda () (subst (list '== (list 'ETAIL 'a m) (cadr tm))) (dk-ass!))))))
       (styped! (lambda (m) (let ((tm (icv-tail! 'a m)))
                              (fact 'esup-in (cadr tm))
                              (dk-have! (list 'IN (list 'ESUP (list 'ETAIL 'a m)) 'RR-POS-STAR)
                                (lambda () (subst (list '== (list 'ETAIL 'a m) (cadr tm))) (dk-ass!)))))))
  (dk-have! (list 'IN il '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((m (dk-di-var!))) (ityped! m) (dk-ass!))))))
  (dk-have! (list 'IN sl '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((m (dk-di-var!))) (styped! m) (dk-ass!))))))
  (let ((lsup (icv-seq-sup! il))
        (linf (list 'EINF (list 'IMAGE sl 'NN))))
    (dk-have! (list 'SUBSET (list 'IMAGE sl 'NN) 'RR-POS-STAR)
      (lambda () (mac 'subset-def) (let ((v (dk-di-var!))) (fact 'image-subset-codomain 'NN 'RR-POS-STAR sl v) (dk-ass!))))
    (fact 'einf-in (list 'IMAGE sl 'NN))
    ;; every inf-tail is below every sup-tail
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE il 'NN)) (list '<= 'x linf)))
      (lambda ()
        (let* ((v (dk-di-var!)) (n (icv-img-elt! il 'NN v)) (iv (list 'EINF (list 'ETAIL 'a n))))
          (ityped! n)
          (dk-have! (list '= v iv) (lambda () (subst (list '= v (list il n))) (if (not (dk-lam-b!)) (rfl))))
          (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE sl 'NN)) (list '<= iv 'y)))
            (lambda ()
              (let* ((w (dk-di-var!)) (m (icv-img-elt! sl 'NN w)) (sv (list 'ESUP (list 'ETAIL 'a m)))
                     (k (list '+ n m)))
                (styped! m)
                (dk-have! (list '= w sv) (lambda () (subst (list '= w (list sl m))) (if (not (dk-lam-b!)) (rfl))))
                (dk-have! (list 'AND (list 'IN n 'NN) (list 'IN m 'NN)))
                (fact 'nn-add-closed n m)
                (fact 'nn-in-rr n) (fact 'nn-in-rr m) (fact 'nn-zero-le n) (fact 'nn-zero-le m) (fact 'nn-in-rr k)
                (dk-have! (list '<= n k) (lambda () (dk-ineq! (list 'IN n 'RR) (list 'IN m 'RR) (list '<= 0 m))))
                (dk-have! (list '<= m k) (lambda () (dk-ineq! (list 'IN n 'RR) (list 'IN m 'RR) (list '<= 0 n))))
                (let ((i1 (icv-in-tail! 'a n k)) (i2 (icv-in-tail! 'a m k)) (ak (list 'a k)))
                  (dk-fact! 'einf-lower i1 ak)
                  (dk-fact! 'esup-upper i2 ak)
                  (dk-have! (list '<= iv ak) (lambda () (subst (list '== (list 'ETAIL 'a n) i1)) (dk-ass!)))
                  (dk-have! (list '<= ak sv) (lambda () (subst (list '== (list 'ETAIL 'a m) i2)) (dk-ass!)))
                  (dk-have! (list 'AND (list 'IN iv 'RR-POS-STAR) (list 'AND (list 'IN ak 'RR-POS-STAR) (list 'IN sv 'RR-POS-STAR))))
                  (dk-have! (list 'AND (list '<= iv ak) (list '<= ak sv)))
                  (fact 'rr-pos-star-le-trans iv ak sv)
                  (subst (list '= w sv))
                  (dk-ass!)))))
          (dk-have! (list 'AND (list 'IN iv 'RR-POS-STAR)
                          (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE sl 'NN)) (list '<= iv 'y)))))
          (dk-fact! 'einf-greatest (list 'IMAGE sl 'NN) iv)
          (subst (list '= v iv))
          (dk-ass!))))
    (dk-have! (list 'AND (list 'IN linf 'RR-POS-STAR)
                    (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE il 'NN)) (list '<= 'x linf)))))
    (dk-fact! 'esup-least (list 'IMAGE il 'NN) linf)
    (mac 'ELIMINF)
    (mac 'ELIMSUP)
    (dk-ass!)))
(qed 'eliminf-le-elimsup)
(topic! 'eliminf-le-elimsup 'inequalities)
;;; reflection on one tail: inf_{p >= m} (c - a_p) = c - sup_{p >= m} a_p
(sp (make-wff
     '(FORALL cc_ (IMPLIES (IN cc_ RR) (FORALL a (FORALL b
        (IMPLIES (IN a (FUN NN RR-POS-STAR))
          (IMPLIES (IN b (FUN NN RR-POS-STAR))
            (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (a n) cc_)))
              (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (b n) (- cc_ (a n)))))
                (FORALL m (IMPLIES (IN m NN)
                  (AND (IN (ESUP (ETAIL a m)) RR)
                       (= (EINF (ETAIL b m)) (- cc_ (ESUP (ETAIL a m)))))))))))))))))
(dk-peel!)
(let* ((ha '(FORALL n (IMPLIES (IN n NN) (<= (a n) cc_))))
       (hb '(FORALL n (IMPLIES (IN n NN) (= (b n) (- cc_ (a n))))))
       (m (cadr (car (filter (lambda (f) (and (eq? (car f) 'in) (equal? (caddr f) 'nn) (not (memq (cadr f) '(a b))))) (dk-asms)))))
       (ta (icv-tail! 'a m)) (d (car ta)) (ia (cadr ta))
       (tb (icv-tail! 'b m)) (ib (cadr tb))
       (ss (list 'ESUP ia)) (ii (list 'EINF ib))
       (pt! (lambda (p)        ; a p, b p real, b p = c - a p, a p <= c
              (fact 'fun-apply-type-c 'a 'NN 'RR-POS-STAR p)
              (fact 'fun-apply-type-c 'b 'NN 'RR-POS-STAR p)
              (dk-apply! ha p)
              (dk-apply! hb p)
              (dk-have! (list 'AND (list 'IN (list 'a p) 'RR-POS-STAR) '(IN cc_ RR)))
              (fact 'rr-pos-star-le-real-in-rr (list 'a p) 'cc_)
              (fact 'rr-pos-star-nonneg (list 'a p))
              (fact 'rr-pos-star-nonneg (list 'b p))
              (fact 'rr-sub-in-rr 'cc_ (list 'a p))
              (dk-have! (list 'IN (list 'b p) 'RR)
                (lambda () (subst (list '= (list 'b p) (list '- 'cc_ (list 'a p)))) (dk-ass!))))))
  (pt! m)
  (fact 'esup-in ia)
  (fact 'einf-in ib)
  (dk-have! '(<= 0 cc_) (lambda () (dk-ineq! '(IN cc_ RR) (list 'IN (list 'a m) 'RR) (list '<= 0 (list 'a m)) (list '<= (list 'a m) 'cc_))))
  (icv-rps! 'cc_)
  ;; S <= c, so S is real
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ia) '(<= x cc_)))
    (lambda ()
      (let* ((v (dk-di-var!)) (p (icv-img-elt! 'a d v)))
        (fact 'subset-mem-fwd d 'NN p)
        (pt! p)
        (subst (list '= v (list 'a p)))
        (dk-ass!))))
  (dk-have! (list 'AND '(IN cc_ RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ia) '(<= x cc_)))))
  (dk-fact! 'esup-least ia 'cc_)
  (dk-have! (list 'AND (list 'IN ss 'RR-POS-STAR) '(IN cc_ RR)))
  (fact 'rr-pos-star-le-real-in-rr ss 'cc_)
  (fact 'rr-pos-star-nonneg ss)
  ;; I <= b m <= c, so I is real
  (let ((bm (list 'b m)))
    (icv-in-tail! 'b m m)
    (dk-fact! 'einf-lower ib bm)
    (dk-have! (list '<= bm 'cc_)
      (lambda () (dk-ineq! (list 'IN bm 'RR) '(IN cc_ RR) (list 'IN (list 'a m) 'RR)
                           (list '= bm (list '- 'cc_ (list 'a m))) (list '<= 0 (list 'a m)))))
    (dk-have! (list 'AND (list 'IN ii 'RR-POS-STAR) (list 'AND (list 'IN bm 'RR-POS-STAR) '(IN cc_ RR-POS-STAR))))
    (dk-have! (list 'AND (list '<= ii bm) (list '<= bm 'cc_)))
    (fact 'rr-pos-star-le-trans ii bm 'cc_)
    (dk-have! (list 'AND (list 'IN ii 'RR-POS-STAR) '(IN cc_ RR)))
    (fact 'rr-pos-star-le-real-in-rr ii 'cc_)
    (fact 'rr-pos-star-nonneg ii))
  ;; c - S <= I
  (let ((cs (list '- 'cc_ ss)))
    (fact 'rr-sub-in-rr 'cc_ ss)
    (dk-have! (list '<= 0 cs) (lambda () (dk-ineq! '(IN cc_ RR) (list 'IN ss 'RR) (list '<= ss 'cc_))))
    (icv-rps! cs)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ib) (list '<= cs 'x)))
      (lambda ()
        (let* ((v (dk-di-var!)) (p (icv-img-elt! 'b d v)))
          (fact 'subset-mem-fwd d 'NN p)
          (pt! p)
          (dk-fact! 'esup-upper ia (list 'a p))
          (icv-in-tail! 'a m p)
          (dk-fact! 'esup-upper ia (list 'a p))
          (subst (list '= v (list 'b p)))
          (dk-ineq! '(IN cc_ RR) (list 'IN ss 'RR) (list 'IN (list 'a p) 'RR) (list 'IN (list 'b p) 'RR)
                    (list '<= (list 'a p) ss) (list '= (list 'b p) (list '- 'cc_ (list 'a p)))))))
    (dk-have! (list 'AND (list 'IN cs 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ib) (list '<= cs 'x)))))
    (dk-fact! 'einf-greatest ib cs))
  ;; I <= c - S: S <= c - I
  (let ((ci (list '- 'cc_ ii)))
    (fact 'rr-sub-in-rr 'cc_ ii)
    (dk-have! (list '<= 0 ci) (lambda () (dk-ineq! '(IN cc_ RR) (list 'IN ii 'RR) (list '<= ii 'cc_))))
    (icv-rps! ci)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ia) (list '<= 'x ci)))
      (lambda ()
        (let* ((v (dk-di-var!)) (p (icv-img-elt! 'a d v)))
          (fact 'subset-mem-fwd d 'NN p)
          (pt! p)
          (icv-in-tail! 'b m p)
          (dk-fact! 'einf-lower ib (list 'b p))
          (subst (list '= v (list 'a p)))
          (dk-ineq! '(IN cc_ RR) (list 'IN ii 'RR) (list 'IN (list 'a p) 'RR) (list 'IN (list 'b p) 'RR)
                    (list '<= ii (list 'b p)) (list '= (list 'b p) (list '- 'cc_ (list 'a p)))))))
    (dk-have! (list 'AND (list 'IN ci 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ia) (list '<= 'x ci)))))
    (dk-fact! 'esup-least ia ci))
  (dk-have! (list '= ii (list '- 'cc_ ss))
    (lambda ()
      (fact 'rr-sub-in-rr 'cc_ ss)
      (dk-have! (list 'AND (list 'IN ii 'RR) (list 'IN (list '- 'cc_ ss) 'RR)))
      (dk-have! (list 'AND (list '<= ii (list '- 'cc_ ss)) (list '<= (list '- 'cc_ ss) ii))
        (lambda ()
          (icv-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (dk-ineq! '(IN cc_ RR) (list 'IN ii 'RR) (list 'IN ss 'RR) (list '<= ss (list '- 'cc_ ii))))))))
      (fact 'rr-leq-antisymmetric ii (list '- 'cc_ ss))
      (dk-ass!)))
  (subst (list '== (list 'ETAIL 'a m) ia))
  (subst (list '== (list 'ETAIL 'b m) ib))
  (icv-conj-close! (lambda () (dk-ass!))))
(qed 'einf-reflection-tail)
(topic! 'einf-reflection-tail 'inequalities)

;;; eliminf-reflection: lim inf (c - a) = c - lim sup a, for a below a real c
(sp (make-wff
     '(FORALL cc_ (IMPLIES (IN cc_ RR) (FORALL a (FORALL b
        (IMPLIES (IN a (FUN NN RR-POS-STAR))
          (IMPLIES (IN b (FUN NN RR-POS-STAR))
            (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (a n) cc_)))
              (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (b n) (- cc_ (a n)))))
                (AND (IN (ELIMSUP a) RR)
                     (= (ELIMINF b) (- cc_ (ELIMSUP a))))))))))))))
(dk-peel!)
(let* ((sl '(VNB-LAMBDA n_ NN (ESUP (ETAIL a n_))))
       (il '(VNB-LAMBDA n_ NN (EINF (ETAIL b n_))))
       (tl! (lambda (m)     ; S_m real, I_m = c - S_m, both typed
              (let ((pr (dk-fact! 'einf-reflection-tail 'cc_ 'a 'b m)))
                (dk-split! pr)
                (let ((sm (list 'ESUP (list 'ETAIL 'a m))) (im (list 'EINF (list 'ETAIL 'b m))))
                  (fact 'rr-sub-in-rr 'cc_ sm)
                  (dk-have! (list 'IN im 'RR) (lambda () (subst (list '= im (list '- 'cc_ sm))) (dk-ass!)))
                  (let ((ta (icv-tail! 'a m)) (tb (icv-tail! 'b m)))
                    (fact 'esup-in (cadr ta))
                    (fact 'einf-in (cadr tb))
                    (dk-have! (list 'IN sm 'RR-POS-STAR) (lambda () (subst (list '== (list 'ETAIL 'a m) (cadr ta))) (dk-ass!)))
                    (dk-have! (list 'IN im 'RR-POS-STAR) (lambda () (subst (list '== (list 'ETAIL 'b m) (cadr tb))) (dk-ass!))))
                  (list sm im))))))
  (fact 'nn-zero-in)
  (dk-have! (list 'IN sl '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let* ((m (dk-di-var!)) (ta (icv-tail! 'a m)))
                                          (fact 'esup-in (cadr ta))
                                          (subst (list '== (list 'ETAIL 'a m) (cadr ta)))
                                          (dk-ass!))))))
  (dk-have! (list 'IN il '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let* ((m (dk-di-var!)) (tb (icv-tail! 'b m)))
                                          (fact 'einf-in (cadr tb))
                                          (subst (list '== (list 'ETAIL 'b m) (cadr tb)))
                                          (dk-ass!))))))
  (dk-have! (list 'SUBSET (list 'IMAGE sl 'NN) 'RR-POS-STAR)
    (lambda () (mac 'subset-def) (let ((v (dk-di-var!))) (fact 'image-subset-codomain 'NN 'RR-POS-STAR sl v) (dk-ass!))))
  (fact 'einf-in (list 'IMAGE sl 'NN))
  (let* ((tt (icv-seq-sup! il))
         (ss (list 'EINF (list 'IMAGE sl 'NN)))
         (s0i (tl! 0)) (s0 (car s0i)))
    ;; S <= S_0 <= c
    (icv-in-image-d! sl 'NN 0 s0)
    (dk-fact! 'einf-lower (list 'IMAGE sl 'NN) s0)
    (dk-have! (list 'AND (list 'IN ss 'RR-POS-STAR) (list 'IN s0 'RR)))
    (fact 'rr-pos-star-le-real-in-rr ss s0)
    (fact 'rr-pos-star-nonneg ss)
    (fact 'rr-pos-star-nonneg s0)
    (dk-have! (list '<= s0 'cc_)
      (lambda ()
        (let ((i0 (cadr s0i)))
          (fact 'rr-pos-star-nonneg i0)
          (dk-ineq! '(IN cc_ RR) (list 'IN s0 'RR) (list 'IN i0 'RR) (list '<= 0 i0) (list '= i0 (list '- 'cc_ s0))))))
    ;; T <= c - S
    (let ((cs (list '- 'cc_ ss)))
      (fact 'rr-sub-in-rr 'cc_ ss)
      (dk-have! (list '<= 0 cs) (lambda () (dk-ineq! '(IN cc_ RR) (list 'IN ss 'RR) (list 'IN s0 'RR) (list '<= ss s0) (list '<= s0 'cc_))))
      (icv-rps! cs)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE il 'NN)) (list '<= 'x cs)))
        (lambda ()
          (let* ((v (dk-di-var!)) (m (icv-img-elt! il 'NN v)) (si (tl! m)) (sm (car si)) (im (cadr si)))
            (dk-have! (list '= v im) (lambda () (subst (list '= v (list il m))) (if (not (dk-lam-b!)) (rfl))))
            (icv-in-image-d! sl 'NN m sm)
            (dk-fact! 'einf-lower (list 'IMAGE sl 'NN) sm)
            (subst (list '= v im))
            (dk-ineq! '(IN cc_ RR) (list 'IN ss 'RR) (list 'IN sm 'RR) (list 'IN im 'RR)
                      (list '<= ss sm) (list '= im (list '- 'cc_ sm))))))
      (dk-have! (list 'AND (list 'IN cs 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'IMAGE il 'NN)) (list '<= 'x cs)))))
      (dk-fact! 'esup-least (list 'IMAGE il 'NN) cs)
      (dk-have! (list 'AND (list 'IN tt 'RR-POS-STAR) (list 'IN cs 'RR)))
      (fact 'rr-pos-star-le-real-in-rr tt cs)
      ;; c - S <= T
      (let ((ct (list '- 'cc_ tt)))
        (fact 'rr-sub-in-rr 'cc_ tt)
        (dk-have! (list '<= 0 ct) (lambda () (dk-ineq! '(IN cc_ RR) (list 'IN tt 'RR) (list 'IN ss 'RR) (list '<= tt cs) (list '<= 0 ss))))
        (icv-rps! ct)
        (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE sl 'NN)) (list '<= ct 'y)))
          (lambda ()
            (let* ((w (dk-di-var!)) (m (icv-img-elt! sl 'NN w)) (si (tl! m)) (sm (car si)) (im (cadr si)))
              (dk-have! (list '= w sm) (lambda () (subst (list '= w (list sl m))) (if (not (dk-lam-b!)) (rfl))))
              (icv-in-image-d! il 'NN m im)
              (dk-fact! 'esup-upper (list 'IMAGE il 'NN) im)
              (subst (list '= w sm))
              (dk-ineq! '(IN cc_ RR) (list 'IN tt 'RR) (list 'IN sm 'RR) (list 'IN im 'RR)
                        (list '<= im tt) (list '= im (list '- 'cc_ sm))))))
        (dk-have! (list 'AND (list 'IN ct 'RR-POS-STAR) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (list 'IMAGE sl 'NN)) (list '<= ct 'y)))))
        (dk-fact! 'einf-greatest (list 'IMAGE sl 'NN) ct)
        (dk-have! (list '= tt cs)
          (lambda ()
            (dk-have! (list 'AND (list 'IN tt 'RR) (list 'IN cs 'RR)))
            (dk-have! (list 'AND (list '<= tt cs) (list '<= cs tt))
              (lambda ()
                (icv-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (dk-ineq! '(IN cc_ RR) (list 'IN tt 'RR) (list 'IN ss 'RR) (list '<= ct ss)))))))
            (fact 'rr-leq-antisymmetric tt cs)
            (dk-ass!)))
        (mac 'ELIMINF)
        (mac 'ELIMSUP)
        (icv-conj-close! (lambda () (dk-ass!)))))))
(qed 'eliminf-reflection)
(topic! 'eliminf-reflection 'inequalities)
;;; =====================================================================
;;; (S) DOMINATED CONVERGENCE (Rudin Thm. 1.34; the notes' Prop. 2.28), in the
;;;     [0,+inf]-valued form integral.scm states.  Fatou on f_n gives
;;;     INTEGRAL(f) <= lim inf; Fatou on h_n = g - f_n (0 where g = +inf) gives
;;;     INTEGRAL(g) - INTEGRAL(f) = INTEGRAL(g - f) <= lim inf (INTEGRAL(g) - INTEGRAL(f_n))
;;;     = INTEGRAL(g) - lim sup INTEGRAL(f_n), by integral-sub (g has finite
;;;     integral, so g < +inf off a null set) and eliminf-reflection.
;;;     Statement copied from structure-library/integral.scm.
;;; =====================================================================

(sp (make-wff
  (forall-guarded '(omega cA mu cF f g)
                  (list '(IS-MEASURE omega cA mu)
                        '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(IS-MEASURABLE-FN omega cA (cF n_)))
                        '(IS-MEASURABLE-FN omega cA f)
                        '(IS-MEASURABLE-FN omega cA g)
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(PTWISE-LE omega (cF n_) g))
                        '(IN (INTEGRAL omega cA mu g) RR)
                        (forall-guarded '(x_) '((IN x_ omega))
                          '(ECONVERGES-TO (VNB-LAMBDA n_ NN ((cF n_) x_))
                                          (f x_))))
    '(ECONVERGES-TO (VNB-LAMBDA n_ NN (INTEGRAL omega cA mu (cF n_)))
                    (INTEGRAL omega cA mu f)))))
(dk-peel!)
(define icv-dhm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
(define icv-ddom '(FORALL n_ (IMPLIES (IN n_ NN) (PTWISE-LE omega (cf n_) g))))
(define icv-dconv '(FORALL x_ (IMPLIES (IN x_ omega) (ECONVERGES-TO (VNB-LAMBDA n_ NN ((cf n_) x_)) (f x_)))))
(define icv-cg '(INTEGRAL omega cA mu g))
(icv-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(icv-mfn-parts! 'omega 'cA 'f)
(icv-mfn-parts! 'omega 'cA 'g)
(fact 'integral-in 'omega 'cA 'mu 'g)
(fact 'rr-pos-star-nonneg icv-cg)

;;; (<= ((cf n) x) (g x)), n in NN, x in omega
(define (icv-dom-at! n x)
  (let ((e (list '<= (list (list 'cf n) x) (list 'g x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (dk-apply! icv-ddom n)
            (let ((iff (dk-cite! 'PTWISE-LE 'omega (list 'cf n) 'g)))
              (ai iff)
              (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
              (dk-apply! (caddr iff) x)
              (dk-ass!)))))
    e))
;;; the pointwise convergence at x: ELIMINF = ELIMSUP = f(x)
(define (icv-conv-at! x)
  (if (not (dk-asm? (list '= (list 'ELIMSUP (icv-seq x)) (list 'f x))))
      (begin
        (dk-apply! icv-dconv x)
        (icv-iff-parts! 'ECONVERGES-TO (list (icv-seq x) (list 'f x))))))
(define (icv-ptw-dom! n)        ; forall x in omega. (cf n) x <= g x
  (let ((cl (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '<= (list (list 'cf n) 'x) '(g x))))))
    (if (not (dk-asm? cl))
        (dk-have! cl (lambda () (let ((x (dk-di-var!))) (icv-dom-at! n x) (dk-ass!)))))
    cl))

;;; f <= g pointwise
(dk-have! '(FORALL x (IMPLIES (IN x omega) (<= (f x) (g x))))
  (lambda ()
    (let* ((x (dk-di-var!)) (phi (icv-seq x)))
      (icv-conv-at! x)
      (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list phi 'n) (list 'g x))))
        (lambda ()
          (let ((n (dk-di-var!)))
            (icv-dom-at! n x)
            (if (not (dk-lam-b!)) (dk-ass!)))))
      (fact 'elimsup-le-bound phi (list 'g x))
      (subst (list '= (list 'f x) (list 'ELIMSUP phi)))
      (dk-ass!))))

;;; (1) Fatou on f_n: INTEGRAL(f) <= lim inf INTEGRAL(f_n)
(let ((fat (dk-fact! 'fatou 'omega 'cA 'mu 'cf)))
  (dk-split! fat))
(icv-iff-parts! 'IS-MEASURABLE-FN '(omega cA (PTWISE-LIMINF omega cf)))
(dk-fun-ext! '(PTWISE-LIMINF omega cf) 'f 'omega 'RR-POS-STAR #f #f
  (lambda (x)
    (icv-conv-at! x)
    (mac 'PTWISE-LIMINF)
    (if (dk--redex? (dk-goal)) (dk-lam-b!))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
        (begin (subst (list '= (list 'ELIMINF (icv-seq x)) (list 'f x))) (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x) (rfl)))))
(dk-have! (list '<= '(INTEGRAL omega cA mu f) (list 'ELIMINF icv-ilf))
  (lambda ()
    (subst '(= f (PTWISE-LIMINF omega cf)))
    (dk-ass!)))

;;; (2) the differences h_n = g - f_n and h = g - f
(define icv-hh2 (list 'VNB-LAMBDA 'hn_ 'NN (icv-dif 'g '(cf hn_))))
(define (icv-dn n) (icv-dif 'g (list 'cf n)))
(define icv-hd (icv-dif 'g 'f))
(define icv-ih (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'cA 'mu (list icv-hh2 'n_))))

;;; INTEGRAL(D) real and = c - INTEGRAL(v), from integral-sub's eplus equation;
;;; INTEGRAL(v) <= c real.  Returns the equation.
(define (icv-sub-real! dterm vterm)
  (let* ((id (list 'INTEGRAL 'omega 'cA 'mu dterm))
         (iv (list 'INTEGRAL 'omega 'cA 'mu vterm))
         (eqn (list '= (list 'eplus id iv) icv-cg)))
    (fact 'integral-in 'omega 'cA 'mu dterm)
    (fact 'integral-in 'omega 'cA 'mu vterm)
    (fact 'rr-pos-star-nonneg iv)
    (dk-have! (list 'IN iv 'RR)
      (lambda ()
        (icv-star-cases! iv
          (lambda () (dk-ass!))
          (lambda ()
            (fact 'eplus-pos-inf-right id)
            (dk-have! (list 'IN 'POS-INF 'RR)
              (lambda ()
                (subst (list '= 'POS-INF (list 'eplus id 'POS-INF)))
                (subst (list '= 'POS-INF iv))
                (subst eqn)
                (dk-ass!)))
            (fact 'pos-inf-not-in-rr)
            (icv-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))))
    (dk-have! (list 'IN id 'RR)
      (lambda ()
        (icv-star-cases! id
          (lambda () (dk-ass!))
          (lambda ()
            (fact 'eplus-pos-inf-left iv)
            (dk-have! (list 'IN 'POS-INF 'RR)
              (lambda ()
                (subst (list '= 'POS-INF (list 'eplus 'POS-INF iv)))
                (subst (list '= 'POS-INF id))
                (subst eqn)
                (dk-ass!)))
            (fact 'pos-inf-not-in-rr)
            (icv-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))))
    (fact 'rr-pos-star-nonneg id)
    (icv-eplus-eq! id iv)
    (let ((res (list '= id (list '- icv-cg iv))))
      (dk-have! res
        (lambda ()
          (dk-have! (list '= (list '+ id iv) icv-cg)
            (lambda () (subst (list '= (list '+ id iv) (list 'eplus id iv))) (dk-ass!)))
          (fact 'rr-sub-in-rr icv-cg iv)
          (dk-have! (list 'AND (list 'IN id 'RR) (list 'IN (list '- icv-cg iv) 'RR)))
          (dk-have! (list 'AND (list '<= id (list '- icv-cg iv)) (list '<= (list '- icv-cg iv) id))
            (lambda ()
              (icv-conj-close!
                (lambda ()
                  (dk-ineq! (list 'IN id 'RR) (list 'IN iv 'RR) (list 'IN icv-cg 'RR)
                            (list '= (list '+ id iv) icv-cg))))))
          (fact 'rr-leq-antisymmetric id (list '- icv-cg iv))
          (dk-ass!)))
      res)))

;;; facts about h_n, n in NN
(define (icv-dn-facts! n)
  (let ((dn (icv-dn n)) (fn (list 'cf n)))
    (if (not (dk-asm? (list 'IS-MEASURABLE-FN 'omega 'cA dn)))
        (begin
          (dk-apply! icv-dhm n)
          (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) n)
          (icv-ptw-dom! n)
          (fact 'measurable-fn-sub 'omega 'cA 'g fn)
          (icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA dn))
          (fact 'integral-sub 'omega 'cA 'mu 'g fn)
          (icv-sub-real! dn fn)))
    dn))

(dk-have! (list 'IN icv-hh2 '(FUN NN (FUN omega RR-POS-STAR)))
  (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (icv-dn-facts! n) (dk-ass!))))))
(dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list icv-hh2 'n_))))
  (lambda () (let ((n (dk-di-var!))) (icv-dn-facts! n) (if (not (dk-lam-b!)) (dk-ass!)))))
(fact 'measurable-fn-sub 'omega 'cA 'g 'f)
(icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA icv-hd))
(fact 'integral-sub 'omega 'cA 'mu 'g 'f)
(define icv-hd-eq (icv-sub-real! icv-hd 'f))

;;; (3) Fatou on h_n
(let ((fat (dk-fact! 'fatou 'omega 'cA 'mu icv-hh2)))
  (dk-split! fat))
(define icv-lh (list 'PTWISE-LIMINF 'omega icv-hh2))
(icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA icv-lh))

;;; (4) h <= lim inf h_n pointwise
(dk-have! (list 'PTWISE-LE 'omega icv-hd icv-lh)
  (lambda ()
    (mac 'PTWISE-LE)
    (let* ((x (dk-di-var!)) (gx (list 'g x)) (fx (list 'f x)) (phi (icv-seq x)))
      (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
      (fact 'fun-apply-type-c icv-lh 'omega 'RR-POS-STAR x)
      (dk-apply! '(FORALL x (IMPLIES (IN x omega) (<= (f x) (g x)))) x)
      (use-em (list 'IN gx 'RR)
        (lambda ()
          (let ((hv (icv-dif-at! 'g 'f x #t)))
            (icv-conv-at! x)
            (subst (list '= (list icv-hd x) hv))
            (mac 'PTWISE-LIMINF)
            (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
            (let* ((rhs (caddr (dk-goal)))
                   (psi (cadr rhs)))
              (dk-have! (list 'IN psi '(FUN NN RR-POS-STAR))
                (lambda ()
                  (dk-lam-type!
                    (lambda ()
                      (let ((n (dk-di-var!)))
                        (icv-dn-facts! n)
                        (icv-dom-at! n x)
                        (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
                        (let* ((fnx (list (list 'cf n) x)) (val (list '- gx fnx)))
                          (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) n)
                          (fact 'fun-apply-type-c (list 'cf n) 'omega 'RR-POS-STAR x)
                          (dk-have! (list 'AND (list 'IN fnx 'RR-POS-STAR) (list 'IN gx 'RR)))
                          (fact 'rr-pos-star-le-real-in-rr fnx gx)
                          (fact 'rr-sub-in-rr gx fnx)
                          (dk-have! (list '<= 0 val) (lambda () (dk-ineq! (list 'IN gx 'RR) (list 'IN fnx 'RR) (list '<= fnx gx))))
                          (let ((fin! (lambda ()
                                        (let* ((tm (cadr (dk-goal)))
                                               (inst (dk-cite! 'rr-pos-star-membership tm)))
                                          (icv-keep-prop! inst (list 'IN tm 'RR) (list '<= 0 tm))))))
                            (let ((g0 (dk-goal)))
                              (if (and (pair? (cadr g0)) (eq? (car (cadr g0)) 'if))
                                  (dk-if-branch! #t (cadr g0) #f fin!)
                                  (fin!))))))))))
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list phi 'n) gx)))
                (lambda () (let ((n (dk-di-var!))) (icv-dom-at! n x) (if (not (dk-lam-b!)) (dk-ass!)))))
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '= (list psi 'n) (list '- gx (list phi 'n)))))
                (lambda ()
                  (let ((n (dk-di-var!)))
                    (icv-dn-facts! n)
                    (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) n)
                    (icv-dom-at! n x)
                    (let ((val (icv-dif-at! 'g (list 'cf n) x #t)))
                      (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
                      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                          (let ((g0 (dk-goal)))
                            (if (and (pair? (cadr g0)) (eq? (car (cadr g0)) 'if))
                                (dk-if-branch! #t (cadr g0) #f (lambda () (rfl)))
                                (rfl))))))))
              (fact 'eliminf-reflection gx phi psi)
              (dk-split! (list 'AND (list 'IN (list 'ELIMSUP phi) 'RR)
                               (list '= (list 'ELIMINF psi) (list '- gx (list 'ELIMSUP phi)))))
              (subst (list '= (list 'ELIMINF psi) (list '- gx (list 'ELIMSUP phi))))
              (subst (list '= (list 'ELIMSUP phi) fx))
              (fact 'rr-leq-reflexive hv)
              (dk-ass!))))
        (lambda ()
          (icv-dif-at! 'g 'f x #f)
          (subst (list '= (list icv-hd x) 0))
          (fact 'rr-pos-star-nonneg (list icv-lh x))
          (dk-ass!))))))

;;; (IN (ELIMINF a) RR-POS-STAR) for a in FUN(NN, RR-POS-STAR)
(define (icv-eliminf-typed! a)
  (let ((kl (list 'VNB-LAMBDA 'n_ 'NN (list 'EINF (list 'ETAIL a 'n_)))))
    (dk-have! (list 'IN kl '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((m (dk-di-var!)) (tm (icv-tail! a m)))
              (fact 'einf-in (cadr tm))
              (subst (list '== (list 'ETAIL a m) (cadr tm)))
              (dk-ass!))))))
    (icv-seq-sup! kl)
    (dk-have! (list 'IN (list 'ELIMINF a) 'RR-POS-STAR) (lambda () (mac 'ELIMINF) (dk-ass!)))))

;;; (5) the integrals: c - INTEGRAL(f) = INTEGRAL(h) <= INTEGRAL(lim inf h_n)
;;;     <= lim inf INTEGRAL(h_n) = c - lim sup INTEGRAL(f_n)
(fact 'integral-monotone 'omega 'cA 'mu icv-hd icv-lh)
(dk-have! (list 'IN icv-ilf '(FUN NN RR-POS-STAR))
  (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (dk-apply! icv-dhm n) (fact 'integral-in 'omega 'cA 'mu (list 'cf n)) (dk-ass!))))))
(dk-have! (list 'IN icv-ih '(FUN NN RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((n (dk-di-var!)))
          (icv-dn-facts! n)
          (fact 'integral-in 'omega 'cA 'mu (icv-dn n))
          (if (not (dk-lam-b!)) (dk-ass!)))))))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list icv-ilf 'n) icv-cg)))
  (lambda ()
    (let ((n (dk-di-var!)))
      (icv-dn-facts! n)
      (if (dk--redex? (dk-goal)) (dk-lam-b!))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (let ((ifn (list 'INTEGRAL 'omega 'cA 'mu (list 'cf n)))
                (idn (list 'INTEGRAL 'omega 'cA 'mu (icv-dn n))))
            (fact 'rr-pos-star-nonneg idn)
            (dk-ineq! (list 'IN ifn 'RR) (list 'IN idn 'RR) (list 'IN icv-cg 'RR)
                      (list '<= 0 idn) (list '= idn (list '- icv-cg ifn))))))))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '= (list icv-ih 'n) (list '- icv-cg (list icv-ilf 'n)))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (icv-dn-facts! n)
      (let ((ifn (list 'INTEGRAL 'omega 'cA 'mu (list 'cf n)))
            (idn (list 'INTEGRAL 'omega 'cA 'mu (icv-dn n))))
        (fact 'rr-sub-in-rr icv-cg ifn)
        (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin (subst (list '= idn (list '- icv-cg ifn))) (rfl)))))))
(fact 'eliminf-reflection icv-cg icv-ilf icv-ih)
(let* ((ls (list 'ELIMSUP icv-ilf))
       (li (list 'ELIMINF icv-ilf))
       (lih (list 'ELIMINF icv-ih))
       (ih (list 'INTEGRAL 'omega 'cA 'mu icv-hd))
       (ilh (list 'INTEGRAL 'omega 'cA 'mu icv-lh))
       (iff (list 'INTEGRAL 'omega 'cA 'mu 'f)))
  (dk-split! (list 'AND (list 'IN ls 'RR) (list '= lih (list '- icv-cg ls))))
  (fact 'rr-sub-in-rr icv-cg ls)
  (dk-have! (list 'IN lih 'RR) (lambda () (subst (list '= lih (list '- icv-cg ls))) (dk-ass!)))
  (fact 'integral-in 'omega 'cA 'mu icv-lh)
  (dk-have! (list 'AND (list 'IN ilh 'RR-POS-STAR) (list 'IN lih 'RR)))
  (fact 'rr-pos-star-le-real-in-rr ilh lih)
  (fact 'integral-in 'omega 'cA 'mu 'f)
  (dk-have! (list 'AND (list 'IN iff 'RR-POS-STAR) (list 'IN icv-cg 'RR)))
  (fact 'integral-monotone 'omega 'cA 'mu 'f 'g)
  (fact 'rr-pos-star-le-real-in-rr iff icv-cg)
  ;; lim sup <= INTEGRAL(f)
  (dk-have! (list '<= ls iff)
    (lambda ()
      (dk-ineq! (list 'IN icv-cg 'RR) (list 'IN iff 'RR) (list 'IN ih 'RR) (list 'IN ilh 'RR) (list 'IN lih 'RR) (list 'IN ls 'RR)
                (list '= ih (list '- icv-cg iff)) (list '<= ih ilh) (list '<= ilh lih) (list '= lih (list '- icv-cg ls)))))
  ;; lim inf <= lim sup, INTEGRAL(f) <= lim inf
  (fact 'eliminf-le-elimsup icv-ilf)
  (icv-eliminf-typed! icv-ilf)
  (dk-have! (list 'AND (list 'IN li 'RR-POS-STAR) (list 'IN ls 'RR)))
  (fact 'rr-pos-star-le-real-in-rr li ls)
  (dk-have! (list '= li iff)
    (lambda ()
      (dk-have! (list 'AND (list 'IN li 'RR) (list 'IN iff 'RR)))
      (dk-have! (list 'AND (list '<= li iff) (list '<= iff li))
        (lambda ()
          (icv-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (dk-ineq! (list 'IN li 'RR) (list 'IN ls 'RR) (list 'IN iff 'RR) (list '<= li ls) (list '<= ls iff)))))))
      (fact 'rr-leq-antisymmetric li iff)
      (dk-ass!)))
  (dk-have! (list '= ls iff)
    (lambda ()
      (dk-have! (list 'AND (list 'IN ls 'RR) (list 'IN iff 'RR)))
      (dk-have! (list 'AND (list '<= ls iff) (list '<= iff ls))
        (lambda ()
          (icv-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (dk-ineq! (list 'IN li 'RR) (list 'IN ls 'RR) (list 'IN iff 'RR) (list '<= li ls) (list '= li iff)))))))
      (fact 'rr-leq-antisymmetric ls iff)
      (dk-ass!)))
  (mac 'ECONVERGES-TO)
  (icv-conj-close! (lambda () (dk-ass!))))
(qed 'dominated-convergence)
