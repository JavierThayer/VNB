  (dk-have! (list 'IN d '(FUN omega RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (dk-apply! hle x)
            (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR x)
            (fact 'fun-apply-type-c 'v 'omega 'RR-POS-STAR x)
