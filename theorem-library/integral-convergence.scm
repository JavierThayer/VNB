;;; =====================================================================
;;; (G) SUPREMA OF NONDECREASING SEQUENCES IN [0,+inf] AGAINST SUMS.
;;;     The brick monotone convergence turns on: for nondecreasing u, v with
;;;     u(n) + v(n) <= L for all n, sup u + sup v <= L.  Then the finite-sum
;;;     form by induction on the index set.
;;; =====================================================================

;;; From (IN x (IMAGE phi d)) in context: land (IN n d), (= (phi n) x); return n.
(define (icv-img-elt! phi d x)
  (let ((iff (dk-fact! 'image-membership-iff phi d x)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (dk-skolem! (dk-ctx-form (caddr iff)))))

;;; (SUBSET (IMAGE u NN) RR-POS-STAR) and ESUP in RR-POS-STAR, u in FUN(NN, RR-POS-STAR)
(define (icv-seq-sup! u)
  (let ((img (list 'IMAGE u 'NN)))
    (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
        (dk-have! (list 'SUBSET img 'RR-POS-STAR)
          (lambda ()
            (mac 'subset-def)
            (let ((v (dk-di-var!)))
              (fact 'image-subset-codomain 'NN 'RR-POS-STAR u v)
              (ass)))))
    (fact 'esup-in img)
    (list 'ESUP img)))

;;; esup-eplus-le
(sp (make-wff
     '(FORALL u (FORALL v
        (IMPLIES (IN u (FUN NN RR-POS-STAR))
          (IMPLIES (IN v (FUN NN RR-POS-STAR))
            (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (u n) (u (succ n)))))
              (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (v n) (v (succ n)))))
                (FORALL L (IMPLIES (IN L RR-POS-STAR)
                  (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (eplus (u n) (v n)) L)))
                    (<= (eplus (ESUP (IMAGE u NN)) (ESUP (IMAGE v NN))) L))))))))))))
(dk-peel!)
(let* ((su (icv-seq-sup! 'u))
       (sv (icv-seq-sup! 'v))
       (bnd '(FORALL n (IMPLIES (IN n NN) (<= (eplus (u n) (v n)) L)))))
  (dk-have! (list 'AND (list 'IN su 'RR-POS-STAR) (list 'IN sv 'RR-POS-STAR)))
  (fact 'eplus-closed su sv)
  (icv-star-cases! 'l
    (lambda ()
      ;; every u(n), v(n) is real and below L
      (let ((parts!
             (lambda (n)
               (let ((un (list 'u n)) (vn (list 'v n)))
                 (fact 'fun-apply-type-c 'u 'NN 'RR-POS-STAR n)
                 (fact 'fun-apply-type-c 'v 'NN 'RR-POS-STAR n)
                 (dk-apply! bnd n)
                 (dk-have! (list 'AND (list 'IN un 'RR-POS-STAR) (list 'IN vn 'RR-POS-STAR)))
                 (fact 'eplus-le-left un vn)
                 (fact 'eplus-comm un vn)
                 (dk-have! (list 'AND (list 'IN vn 'RR-POS-STAR) (list 'IN un 'RR-POS-STAR)))
                 (fact 'eplus-le-left vn un)
                 (fact 'eplus-closed un vn)
                 (dk-have! (list '<= vn (list 'eplus un vn))
                   (lambda () (subst (list '= (list 'eplus un vn) (list 'eplus vn un))) (ass)))
                 (dk-have! (list 'AND (list 'IN un 'RR-POS-STAR)
                                 (list 'AND (list 'IN (list 'eplus un vn) 'RR-POS-STAR) '(IN l RR-POS-STAR))))
                 (dk-have! (list 'AND (list '<= un (list 'eplus un vn)) (list '<= (list 'eplus un vn) 'l)))
                 (fact 'rr-pos-star-le-trans un (list 'eplus un vn) 'l)
                 (dk-have! (list 'AND (list 'IN vn 'RR-POS-STAR)
                                 (list 'AND (list 'IN (list 'eplus un vn) 'RR-POS-STAR) '(IN l RR-POS-STAR))))
                 (dk-have! (list 'AND (list '<= vn (list 'eplus un vn)) (list '<= (list 'eplus un vn) 'l)))
                 (fact 'rr-pos-star-le-trans vn (list 'eplus un vn) 'l)
                 (dk-have! (list 'AND (list 'IN un 'RR-POS-STAR) '(IN l RR)))
                 (fact 'rr-pos-star-le-real-in-rr un 'l)
                 (dk-have! (list 'AND (list 'IN vn 'RR-POS-STAR) '(IN l RR)))
                 (fact 'rr-pos-star-le-real-in-rr vn 'l)
                 (fact 'rr-pos-star-nonneg un)
                 (fact 'rr-pos-star-nonneg vn)
                 (icv-eplus-eq! un vn)
                 (dk-have! (list '<= (list '+ un vn) 'l)
                   (lambda () (subst (list '= (list '+ un vn) (list 'eplus un vn))) (ass)))))))
        ;; u, v in FUN(NN, RR), hence monotone in the index
        (let ((real-fun!
               (lambda (fv)
                 (dk-have! (list 'IN fv '(FUN NN RR))
                   (lambda ()
                     (let ((iff (dk-cite! 'fun-codomain-iff 'NN 'RR fv))
                           (iff2 (dk-cite! 'fun-codomain-iff 'NN 'RR-POS-STAR fv)))
                       (dk-have! (list 'IN fv '(FUN NN))
                         (lambda () (icv-keep-prop! iff2 (list 'IN fv '(FUN NN RR-POS-STAR)))))
                       (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list 'IN (list fv 'x) 'RR)))
                         (lambda () (let ((n (dk-di-var!))) (parts! n) (dk-ass!))))
                       (icv-keep-prop! iff (list 'IN fv '(FUN NN))
                                       (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list 'IN (list fv 'x) 'RR))))))))))
          (real-fun! 'u)
          (real-fun! 'v)
          (let ((mu (dk-fact! 'nn-monotone-step-implies-le 'u))
                (mv (dk-fact! 'nn-monotone-step-implies-le 'v)))
            ;; for every m: sup u <= L - v(m)
            (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list '<= su (list '- 'l '(v m)))))
              (lambda ()
                (let* ((m (dk-di-var!)) (vm (list 'v m)) (b (list '- 'l vm)))
                  (parts! m)
                  (fact 'rr-sub-in-rr 'l vm)
                  (dk-have! (list '<= 0 b) (lambda () (dk-ineq! '(IN l RR) (list 'IN vm 'RR) (list '<= vm 'l))))
                  (icv-rps! b)
                  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x '(IMAGE u NN)) (list '<= 'x b)))
                    (lambda ()
                      (let* ((x (dk-di-var!))
                             (n (icv-img-elt! 'u 'NN x))
                             (k (list '+ n m)))
                        (fact 'nn-add-closed n m)
                        (dk-have! (list 'AND (list 'IN n 'NN) (list 'IN m 'NN)))
                        (fact 'nn-add-closed n m)
                        (parts! n)
                        (parts! k)
                        (fact 'nn-in-rr n) (fact 'nn-in-rr m) (fact 'nn-zero-le n) (fact 'nn-zero-le m)
                        (fact 'nn-in-rr k)
                        (dk-have! (list '<= n k) (lambda () (dk-ineq! (list 'IN n 'RR) (list 'IN m 'RR) (list '<= 0 m))))
                        (dk-have! (list '<= m k) (lambda () (dk-ineq! (list 'IN n 'RR) (list 'IN m 'RR) (list '<= 0 n))))
                        (dk-apply! mu k n)
                        (dk-apply! mv k m)
                        (subst (list '= x (list 'u n)))
                        (dk-ineq! '(IN l RR) (list 'IN (list 'u n) 'RR) (list 'IN (list 'u k) 'RR)
                                  (list 'IN (list 'v k) 'RR) (list 'IN vm 'RR)
                                  (list '<= (list 'u n) (list 'u k)) (list '<= vm (list 'v k))
                                  (list '<= (list '+ (list 'u k) (list 'v k)) 'l)))))
                  (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR)
                                  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x '(IMAGE u NN)) (list '<= 'x b)))))
                  (dk-fact! 'esup-least '(IMAGE u NN) b)
                  (dk-ass!)))))
            (fact 'nn-zero-in)
            (parts! 0)
            (let ((h0 (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f su))) "sup u bound")))
              (dk-apply! h0 0)
              (fact 'rr-sub-in-rr 'l '(v 0))
              (dk-have! (list 'AND (list 'IN su 'RR-POS-STAR) (list 'IN '(- l (v 0)) 'RR)))
              (fact 'rr-pos-star-le-real-in-rr su '(- l (v 0)))
              (fact 'rr-pos-star-nonneg su)
              ;; for every m: v(m) <= L - sup u, so sup v <= L - sup u
              (let ((b (list '- 'l su)))
                (fact 'rr-sub-in-rr 'l su)
                (dk-have! (list '<= 0 b)
                  (lambda () (dk-ineq! '(IN l RR) (list 'IN su 'RR) '(IN (v 0) RR)
                                       (list '<= su '(- l (v 0))) '(<= 0 (v 0)))))
                (icv-rps! b)
                (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x '(IMAGE v NN)) (list '<= 'x b)))
                  (lambda ()
                    (let* ((x (dk-di-var!))
                           (m (icv-img-elt! 'v 'NN x)))
                      (parts! m)
                      (dk-apply! h0 m)
                      (subst (list '= x (list 'v m)))
                      (dk-ineq! '(IN l RR) (list 'IN su 'RR) (list 'IN (list 'v m) 'RR)
                                (list '<= su (list '- 'l (list 'v m)))))))
                (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR)
                                (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x '(IMAGE v NN)) (list '<= 'x b)))))
                (dk-fact! 'esup-least '(IMAGE v NN) b)
                (dk-have! (list 'AND (list 'IN sv 'RR-POS-STAR) (list 'IN b 'RR)))
                (fact 'rr-pos-star-le-real-in-rr sv b)
                (fact 'rr-pos-star-nonneg sv)
                (icv-eplus-eq! su sv)
                (subst (list '= (list 'eplus su sv) (list '+ su sv)))
                (dk-ineq! '(IN l RR) (list 'IN su 'RR) (list 'IN sv 'RR) (list '<= sv b)))))))
    (lambda ()
      (subst '(= l POS-INF))
      (fact 'rr-pos-star-below-pos-inf (list 'eplus su sv))
      (ass))))
(qed 'esup-eplus-le)
(topic! 'esup-eplus-le 'inequalities)
;;; ---------------------------------------------------------------------
;;; Kit copied from integral-laws.scm (ibk-): pointwise claims, finite-set
;;; induction, finite sums in [0,+inf].
(define (icv-syms x)
  (cond ((symbol? x) (list x)) ((pair? x) (append (icv-syms (car x)) (icv-syms (cdr x)))) (#t '())))
(define (icv-ptw u body-of)
  (let* ((used (append (icv-syms u) (icv-syms (body-of 'icv-dummy))))
         (b    (let loop ((cs '(z_ zz_ zq_ zr_ zs_ zt_)))
                 (if (memq (car cs) used) (loop (cdr cs)) (car cs)))))
    (list 'FORALL b (list 'IMPLIES (list 'IN b u) (body-of b)))))
(define (icv-class prop-of) (list 'COMP 'iu_ (prop-of 'iu_)))
(define (icv-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (icv-induct! xs prop-of base! step!)
  (let* ((c     (icv-class prop-of))
         (stepf (icv-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let ((pu (list 'UNION (list 'PAIR xv xv) sv)))
            (dk-split! (dk-fact! 'card-union-singleton-bound sv xv))
            (fact 'union-comm (list 'PAIR xv xv) sv)
            (dk-have! (list 'IN (list 'CARD u) 'NN)
              (lambda () (subst (list '= u pu)) (ass))))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
(define (icv-in-union-left! z sv u)
  (dk-have! (list 'IN z u)
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (icv-in-union-new! xv u)
  (dk-have! (list 'IN xv u)
    (lambda ()
      (mac 'union-membership) (oi-r)
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) xv)))
        (have! (list '= xv xv) (lambda () (rfl)))
        (icv-keep-prop! pm (list '= xv xv))))))

(define icv-m 'RR-POS-STAR-ADD-MONOID)
(define (icv-fs fv u) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID fv u))
(define (icv-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))
(define icv-opr-eq  '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
(define icv-iden-eq '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
(define icv-carr-eq '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
(define (icv-rps-setup!)
  (fact 'rr-pos-star-is-comm-monoid)
  (icv-readoff! icv-opr-eq)
  (icv-readoff! icv-iden-eq)
  (icv-readoff! icv-carr-eq))
(define (icv-rps-of fv) (lambda (z) (list 'IN (list fv z) 'RR-POS-STAR)))
(define (icv-carr-rps-of fv) (lambda (z) (list 'IN (list fv z) '(CARR RR-POS-STAR-ADD-MONOID))))
(define (icv-carr-typing! u fv)
  (dk-have! (icv-ptw u (icv-carr-rps-of fv))
    (lambda () (subst icv-carr-eq) (ass))))
(define (icv-rps-typed! u fv)
  (let ((sm (icv-fs fv u)))
    (if (not (dk-asm? (list 'IN sm 'RR-POS-STAR)))
        (begin
          (icv-carr-typing! u fv)
          (fact 'finsum-comm-monoid-type-ptwise icv-m u fv)
          (dk-have! (list 'IN sm 'RR-POS-STAR)
            (lambda () (subst (list '= 'RR-POS-STAR '(CARR RR-POS-STAR-ADD-MONOID))) (ass)))))))
(define (icv-rps-insert! sv xv u fv)
  (let ((claim (list '= (icv-fs fv u) (list 'eplus (icv-fs fv sv) (list fv xv)))))
    (icv-carr-typing! u fv)
    (fact 'finsum-cm-insert-ptwise icv-m sv xv fv)
    (icv-rps-typed! sv fv)
    (if (not (dk-asm? (list 'IN (list fv xv) 'RR-POS-STAR)))
        (inst+ (icv-ptw u (icv-rps-of fv)) xv))
    (dk-have! (list 'AND (list 'IN (icv-fs fv sv) 'RR-POS-STAR) (list 'IN (list fv xv) 'RR-POS-STAR)))
    (fact 'eplus-closed (icv-fs fv sv) (list fv xv))
    (dk-have! claim
      (lambda ()
        (subst (list '= (icv-fs fv u)
                     (list '(OPR RR-POS-STAR-ADD-MONOID) (icv-fs fv sv) (list fv xv))))
        (subst icv-opr-eq)
        (rfl)))
    claim))
(define (icv-rps-empty! fv)
  (let ((claim (list '= (icv-fs fv 'EMPTY-SET) 0)))
    (fact 'finsum-empty icv-m fv)
    (dk-have! claim
      (lambda ()
        (subst (list '== (icv-fs fv 'EMPTY-SET) '(IDEN RR-POS-STAR-ADD-MONOID)))
        (subst icv-iden-eq)
        (rfl)))
    claim))

;;; goal (IN (FINSUM M fv u) RR-POS-STAR), fv RR-POS-STAR-typed on u in context
(define (icv-rps-typed-goal! u fv)
  (icv-carr-typing! u fv)
  (fact 'finsum-comm-monoid-type-ptwise icv-m u fv)
  (subst (list '= 'RR-POS-STAR '(CARR RR-POS-STAR-ADD-MONOID)))
  (ass))

;;; rps-finsum-esup-le: a finite sum of suprema of nondecreasing sequences is
;;; at most any bound of the finite sums of the terms.
(sp (make-wff
     '(FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
        (FORALL h (FORALL A
          (IMPLIES (IN h (FUN NN (FUN S RR-POS-STAR)))
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (FORALL n (IMPLIES (IN n NN) (<= ((h n) z_) ((h (succ n)) z_))))))
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (= (A z_) (ESUP (IMAGE (VNB-LAMBDA m_ NN ((h m_) z_)) NN)))))
                (FORALL L (IMPLIES (IN L RR-POS-STAR)
                  (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= (FINSUM RR-POS-STAR-ADD-MONOID (h n) S) L)))
                    (<= (FINSUM RR-POS-STAR-ADD-MONOID A S) L))))))))))))))
(dk-peel!)
(icv-rps-setup!)
(let* ((htz!  (lambda (z n)
                (fact 'fun-apply-type-c 'h 'NN '(FUN s RR-POS-STAR) n)
                (fact 'fun-apply-type-c (list 'h n) 's 'RR-POS-STAR z)))
       (hmono '(FORALL z_ (IMPLIES (IN z_ s) (FORALL n (IMPLIES (IN n NN) (<= ((h n) z_) ((h (succ n)) z_)))))))
       (ha    '(FORALL z_ (IMPLIES (IN z_ s) (= (a z_) (ESUP (IMAGE (VNB-LAMBDA m_ NN ((h m_) z_)) NN))))))
       (hb    '(FORALL n (IMPLIES (IN n NN) (<= (FINSUM RR-POS-STAR-ADD-MONOID (h n) s) l))))
       (phi   (lambda (z) (list 'VNB-LAMBDA 'm_ 'NN (list '(h m_) z))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (list 'SUBSET u 's)
                        (list 'FORALL 'lb_ (list 'IMPLIES '(IN lb_ RR-POS-STAR)
                          (list 'IMPLIES (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                                                            (list '<= (icv-fs '(h n) u) 'lb_)))
                                (list '<= (icv-fs 'a u) 'lb_)))))))
       ;; z in s: land (IN (phi z) (FUN NN RR-POS-STAR)), ESUP in RR-POS-STAR, (a z) typed
       (zfacts! (lambda (z)
                  (let ((ph (phi z)))
                    (if (not (dk-asm? (list 'IN ph '(FUN NN RR-POS-STAR))))
                        (dk-have! (list 'IN ph '(FUN NN RR-POS-STAR))
                          (lambda ()
                            (dk-lam-type!
                              (lambda ()
                                (let ((m (dk-di-var!)))
                                  (htz! z m)
                                  (dk-ass!)))))))
                    (let ((e (icv-seq-sup! ph)))
                      (dk-apply! ha z)
                      (if (not (dk-asm? (list 'IN (list 'a z) 'RR-POS-STAR)))
                          (dk-have! (list 'IN (list 'a z) 'RR-POS-STAR)
                            (lambda () (subst (list '= (list 'a z) e)) (ass))))
                      e))))
       ;; pointwise typing of (h n) on u (u subset s in context)
       (htyped! (lambda (n u)
                  (dk-have! (icv-ptw u (icv-rps-of (list 'h n)))
                    (lambda ()
                      (let ((z (dk-di-var!)))
                        (fact 'subset-mem-fwd u 's z)
                        (htz! z n)
                        (dk-ass!))))))
       (atyped! (lambda (u)
                  (dk-have! (icv-ptw u (icv-rps-of 'a))
                    (lambda ()
                      (let ((z (dk-di-var!)))
                        (fact 'subset-mem-fwd u 's z)
                        (zfacts! z)
                        (dk-ass!))))))
       (px (icv-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (let ((lb (caddr (dk-goal))))
                 (icv-rps-empty! 'a)
                 (subst (list '= (icv-fs 'a 'EMPTY-SET) 0))
                 (fact 'rr-pos-star-nonneg lb)
                 (ass)))
             (lambda (sv xv u ih)
               (dk-peel!)
               (let* ((lb  (caddr (dk-goal)))
                      (hbu (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f lb))) "the bound on u"))
                      (useq (list 'VNB-LAMBDA 'n_ 'NN (icv-fs '(h n_) sv)))
                      (vseq (phi xv)))
                 (dk-have! (list 'SUBSET sv 's)
                   (lambda ()
                     (mac 'subset-def)
                     (let ((w (dk-di-var!)))
                       (icv-in-union-left! w sv u)
                       (fact 'subset-mem-fwd u 's w)
                       (ass))))
                 (icv-in-union-new! xv u)
                 (fact 'subset-mem-fwd u 's xv)
                 (zfacts! xv)
                 ;; the sequence of partial sums over S'
                 (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN (icv-fs '(h n) sv) 'RR-POS-STAR)))
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (htyped! n sv)
                       (icv-rps-typed-goal! sv (list 'h n)))))
                 (dk-have! (list 'IN useq '(FUN NN RR-POS-STAR))
                   (lambda () (dk-lam-type! (lambda () (dk-ass!)))))
                 (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                             (list '<= (list useq 'n) (list useq '(succ n)))))
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (fact 'nn-succ-closed n)
                       (htyped! n sv)
                       (htyped! (list 'succ n) sv)
                       (dk-have! (icv-ptw sv (lambda (z) (list '<= (list (list 'h n) z) (list (list 'h (list 'succ n)) z))))
                         (lambda ()
                           (let ((z (dk-di-var!)))
                             (fact 'subset-mem-fwd sv 's z)
                             (dk-apply! hmono z n)
                             (dk-ass!))))
                       (fact 'rps-finsum-le-ptwise sv (list 'h n) (list 'h (list 'succ n)))
                       (if (not (dk-lam-b!)) (dk-ass!)))))
                 (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                             (list '<= (list vseq 'n) (list vseq '(succ n)))))
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (fact 'nn-succ-closed n)
                       (dk-apply! hmono xv n)
                       (if (not (dk-lam-b!)) (dk-ass!)))))
                 (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                             (list '<= (list 'eplus (list useq 'n) (list vseq 'n)) lb)))
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (htyped! n u)
                       (htyped! n sv)
                       (icv-rps-insert! sv xv u (list 'h n))
                       (dk-apply! hbu n)
                       (if (not (dk-lam-b!))
                           (begin
                             (subst (list '= (list 'eplus (icv-fs (list 'h n) sv) (list (list 'h n) xv))
                                          (icv-fs (list 'h n) u)))
                             (dk-ass!))))))
                 (let ((b1 (dk-fact! 'esup-eplus-le useq vseq lb))
                       (lp (icv-seq-sup! useq))
                       (ex (icv-seq-sup! vseq)))
                   ;; the induction hypothesis at L' = sup of the partial sums
                   (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (icv-fs '(h n) sv) lp)))
                     (lambda ()
                       (let ((n (dk-di-var!)))
                         (htyped! n sv)
                         (icv-rps-typed! sv (list 'h n))
                         (icv-in-image! useq n (icv-fs (list 'h n) sv))
                         (dk-fact! 'esup-upper (list 'IMAGE useq 'NN) (icv-fs (list 'h n) sv))
                         (dk-ass!))))
                   (detach! ih)
                   (let ((ihl (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f (icv-fs 'a sv)))) "the induction hypothesis")))
                     (dk-apply! ihl lp))
                   (atyped! sv)
                   (atyped! u)
                   (icv-rps-typed! sv 'a)
                   (icv-rps-insert! sv xv u 'a)
                   (subst (list '= (icv-fs 'a u) (list 'eplus (icv-fs 'a sv) (list 'a xv))))
                   (subst (list '= (list 'a xv) ex))
                   (fact 'rr-pos-star-le-refl ex)
                   (dk-have! (list 'AND (list 'IN (icv-fs 'a sv) 'RR-POS-STAR)
                                   (list 'AND (list 'IN ex 'RR-POS-STAR)
                                         (list 'AND (list 'IN lp 'RR-POS-STAR) (list 'IN ex 'RR-POS-STAR)))))
                   (dk-have! (list 'AND (list '<= (icv-fs 'a sv) lp) (list '<= ex ex)))
                   (fact 'eplus-mono (icv-fs 'a sv) ex lp ex)
                   (dk-have! (list 'AND (list 'IN (icv-fs 'a sv) 'RR-POS-STAR) (list 'IN ex 'RR-POS-STAR)))
                   (fact 'eplus-closed (icv-fs 'a sv) ex)
                   (dk-have! (list 'AND (list 'IN lp 'RR-POS-STAR) (list 'IN ex 'RR-POS-STAR)))
                   (fact 'eplus-closed lp ex)
                   (let ((x1 (list 'eplus (icv-fs 'a sv) ex)) (x2 (list 'eplus lp ex)))
                     (dk-have! (list 'AND (list 'IN x1 'RR-POS-STAR)
                                     (list 'AND (list 'IN x2 'RR-POS-STAR) (list 'IN lb 'RR-POS-STAR))))
                     (dk-have! (list 'AND (list '<= x1 x2) (list '<= x2 lb)))
                     (fact 'rr-pos-star-le-trans x1 x2 lb)
                     (dk-ass!))))))))
  (fact 'subset-refl 's)
  (detach! px)
  (let ((pl (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f '(FINSUM RR-POS-STAR-ADD-MONOID a s)))) "the property at S")))
    (dk-apply! pl 'l)
    (dk-ass!)))
(qed 'rps-finsum-esup-le)
(topic! 'rps-finsum-esup-le 'inequalities)
;;; =====================================================================
;;; (H) A FUNCTION FACTORED THROUGH A FINITE MEASURABLE PARTITION IS SIMPLE.
;;;     t = hh o k, k : omega -> KS finite with measurable fibres, hh real >= 0.
;;;     The tails are preimages k^-1{ p : alpha < hh(p) } (sigma-algebra-
;;;     preimage-finite-in), the range lies in hh(KS).
;;; =====================================================================

(define (icv-fin-sub! big sub memb!)
  (let ((incl (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sub) (list 'IN 'z big)))))
    (dk-have! incl (lambda () (let ((w (dk-di-var!))) (memb! w))))
    (dk-have! (list 'SUBSET sub big)
      (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (inst+ incl w) (ass))))
    (fact 'subclass-of-set-is-set sub big)
    (dk-have! (list 'AND (list 'IN big 'SET) (list 'IN (list 'CARD big) 'NN)))
    (dk-have! (list 'AND (list 'IN sub 'SET) incl))
    (fact 'card-subset-nn big sub)))

;;; simple-fn-of-partition
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL ks (FORALL k (FORALL hh (FORALL t
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN ks SET) (IMPLIES (IN (CARD ks) NN)
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ omega) (IN (k z_) ks)))
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ ks) (IN (SEP fx_ omega (= (k fx_) z_)) cA)))
                (IMPLIES (FORALL z_ (IMPLIES (IN z_ ks) (IN (hh z_) RR)))
                  (IMPLIES (FORALL z_ (IMPLIES (IN z_ ks) (<= 0 (hh z_))))
                    (IMPLIES (IN t (FUN omega RR-POS-STAR))
                      (IMPLIES (FORALL z_ (IMPLIES (IN z_ omega) (= (t z_) (hh (k z_)))))
                        (IS-SIMPLE-FN omega cA t))))))))))))))))))
(dk-peel!)
(let* ((hk  '(FORALL z_ (IMPLIES (IN z_ omega) (IN (k z_) ks))))
       (hf  '(FORALL z_ (IMPLIES (IN z_ ks) (IN (SEP fx_ omega (= (k fx_) z_)) cA))))
       (hr  '(FORALL z_ (IMPLIES (IN z_ ks) (IN (hh z_) RR))))
       (htv '(FORALL z_ (IMPLIES (IN z_ omega) (= (t z_) (hh (k z_))))))
       (tails!
        (lambda ()
          (let* ((al (dk-di-var!))
                 (kal (list 'SEP 'p_ 'ks (list '< al '(hh p_))))
                 (tl  (list 'SEP 'x_ 'omega (list '< al '(t x_))))
                 (pre (list 'SEP 'fx_ 'omega (list 'IN '(k fx_) kal))))
            (icv-fin-sub! 'ks kal (lambda (w) (sep-me (list 'IN w kal)) (ass)))
            (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ kal)
                        (list 'IN '(SEP fx_ omega (= (k fx_) z_)) 'cA)))
              (lambda ()
                (let ((z (dk-di-var!)))
                  (fact 'subset-mem-fwd kal 'ks z)
                  (dk-apply! hf z)
                  (dk-ass!))))
            (fact 'sigma-algebra-preimage-finite-in 'omega 'cA kal 'k)
            (icv-set-eq! tl pre
              (lambda (w)
                (sep-me (list 'IN w tl))
                (dk-apply! htv w)
                (dk-apply! hk w)
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (icv-sep-in!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin (subst (list '= (list 'hh (list 'k w)) (list 't w))) (ass)))))))))
              (lambda (w)
                (sep-me (list 'IN w pre))
                (sep-me (list 'IN (list 'k w) kal))
                (dk-apply! htv w)
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin (subst (list '= (list 't w) (list 'hh (list 'k w)))) (ass)))))))
            (subst (list '= tl pre))
            (ass)))))
  (fact 'image-set 'hh 'ks)
  (fact 'card-image-finite 'hh 'ks)
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'image-set 't 'omega)
  (mac 'IS-SIMPLE-FN)
  (icv-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'IS-MEASURABLE-FN)
               (mac 'IS-MEASURABLE-FN)
               (icv-conj-close!
                 (lambda ()
                   (if (dk-asm? (dk-goal)) (ass) (tails!)))))
              ((dk-head-is? g 'FORALL)
               (let ((x (dk-di-var!)))
                 (dk-apply! htv x)
                 (dk-apply! hk x)
                 (dk-apply! hr (list 'k x))
                 (subst (list '= (list 't x) (list 'hh (list 'k x))))
                 (ass)))
              (#t
               (icv-fin-sub! '(IMAGE hh ks) '(IMAGE t omega)
                 (lambda (w)
                   (let* ((n (icv-img-elt! 't 'omega w)))
                     (dk-apply! htv n)
                     (dk-apply! hk n)
                     (fact 'fun-apply-type-c 't 'omega 'RR-POS-STAR n)
                     (dk-have! (list '= (list 'hh (list 'k n)) w)
                       (lambda () (subst (list '= (list 'hh (list 'k n)) (list 't n))) (ass)))
                     (let* ((iff (dk-fact! 'image-membership-iff 'hh 'ks w))
                            (rhs (caddr iff)))
                       (dk-have! rhs
                         (lambda ()
                           (icv-conj-close!
                             (lambda ()
                               (cond ((dk-asm? (dk-goal)) (ass))
                                     ((dk-head-is? (dk-goal) 'FORSOME)
                                      (ew (list 'k n))
                                      (icv-conj-close! (lambda () (dk-ass!))))
                                     (#t (fact 'membership-implies-sethood (list 't n) 'RR-POS-STAR)
                                         (subst (list '= w (list 't n)))
                                         (ass)))))))
                       (ai iff)
                       (detach! (list 'IMPLIES rhs (cadr iff)))
                       (dk-ass!)))))
               (dk-ass!)))))))
(qed 'simple-fn-of-partition)
(topic! 'simple-fn-of-partition 'analysis)
