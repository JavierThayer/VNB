(define (icv-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (icv-conj-close! . opt)
  (let ((closer (if (pair? opt) (car opt) from-context!)))
    (let walk ()
      (let ((g (dk-goal)))
        (if (and (pair? g) (eq? (car g) 'AND))
            (for-each (lambda (k)
                        (if (not (sequent-node-grounded? k))
                            (begin (dk-focus! k) (walk))))
                      (dk-opened (lambda () (di))))
            (closer))))))

(define (icv-real-case tm) (list 'AND (list 'IN tm 'RR) (list '<= 0 tm)))
(define (icv-inf-case  tm) (list '= tm 'POS-INF))

;;; Split on tm in RR-POS-STAR: REAL-BODY with (IN tm RR), (<= 0 tm) in
;;; context, INF-BODY with (= tm POS-INF).
(define (icv-star-cases! tm real-body inf-body)
  (have! (list 'OR (icv-real-case tm) (icv-inf-case tm))
         (lambda ()
           (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
             (icv-keep-prop! inst (list 'IN tm 'RR-POS-STAR)))))
  (use-cases (list (icv-real-case tm) (icv-inf-case tm))
    (lambda () (dk-split! (icv-real-case tm)) (real-body))
    inf-body))

;;; (IN a RR-STAR) from (IN a RR)
(define (icv-rr-star! t)
  (dk-have! (list 'IN t 'RR-STAR)
    (lambda ()
      (let ((iff (dk-cite! 'rr-star-membership t)))
        (icv-keep-prop! iff (list 'IN t 'RR))))))

;;; Goal (IN tm RR-POS-STAR), with (IN tm RR) and (<= 0 tm) in context.
(define (icv-rps! tm)
  (if (not (dk-asm? (list 'IN tm 'RR-POS-STAR)))
      (dk-have! (list 'IN tm 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
            (icv-keep-prop! inst (list 'IN tm 'RR) (list '<= 0 tm)))))))

;;; Set equality by elements: lands (= A B).
(define (icv-set-eq! a b fwd! bwd!)
  (dk-have! (list 'FORALL 'ew_ (list 'IFF (list 'IN 'ew_ a) (list 'IN 'ew_ b)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (for-each (lambda (l)
                    (dk-focus! l)
                    (if (equal? (dk-goal) (list 'in w b)) (fwd! w) (bwd! w)))
                  (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality a b)
  (list '= a b))

(define (icv-sep-in! closer)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (closer))))
            (dk-opened (lambda () (sep-mi)))))

;;; dk-abstract! with a hook PRE-BETA! on the value lane (ibk-abstract!).
(define (icv-abstract! dom cod body-of typer pre-beta!)
  (let* ((body  (body-of 'dkak_))
         (lam   (list 'VNB-LAMBDA 'dkak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'dkak_ (list 'IMPLIES (list 'IN 'dkak_ dom)
                                                    (list '== (list g 'dkak_) body)))))
         (claim (list 'FORSOME 'dkag_ (list 'AND (list 'IN 'dkag_ (list 'FUN dom cod))
                                            (vals 'dkag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (icv-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!)))
                              (lambda ()
                                (if (dk-asm? (dk-goal))
                                    (ass)
                                    (dk-set-close! (cadr (dk-goal))))))
                (let ((k (dk-di-var!)))
                  (pre-beta! k)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "icv-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "icv-abstract!: the value equation did not land"
                          (expression->string (vals g))))))
      (cons g ve))))

;;; the three conjuncts of IS-MEASURABLE-FN(om, ca, fv), landed, kept
(define (icv-mfn-parts! om ca fv)
  (let* ((iff (dk-cite! 'is-measurable-fn om ca fv))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs))) (c3 (caddr (caddr rhs))))
    (map (lambda (c) (dk-project! c 'IS-MEASURABLE-FN (list 'IS-MEASURABLE-FN om ca fv)))
         (list c1 c2 c3))))
;;; =====================================================================
;;; (A) ORDER IN [0,+inf]: totality, the strict order against <=, and the
;;;     two faces of `a < ESUP(S)'.
;;; =====================================================================

;;; rps-le-total
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR)
                 (FORALL y (IMPLIES (IN y RR-POS-STAR) (OR (<= x y) (<= y x))))))))
(dk-peel!)
(icv-star-cases! 'x
  (lambda ()
    (icv-star-cases! 'y
      (lambda ()
        (dk-have! '(AND (IN x RR) (IN y RR)))
        (fact 'rr-leq-total 'x 'y)
        (ass))
      (lambda ()
        (subst '(= y POS-INF))
        (fact 'rr-pos-star-below-pos-inf 'x)
        (oi-l) (ass))))
  (lambda ()
    (subst '(= x POS-INF))
    (fact 'rr-pos-star-below-pos-inf 'y)
    (oi-r) (ass)))
(qed 'rps-le-total)
(topic! 'rps-le-total 'inequalities)

;;; rps-not-lt-le
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR)
                 (FORALL y (IMPLIES (IN y RR-POS-STAR)
                   (IMPLIES (NOT (< x y)) (<= y x))))))))
(dk-peel!)
(let ((tot (dk-fact! 'rps-le-total 'x 'y)))
  (use-cases tot
    (lambda ()
      (use-em '(= x y)
        (lambda () (subst '(= x y)) (fact 'rr-pos-star-le-refl 'y) (ass))
        (lambda ()
          (let ((iff (dk-cite! '< 'x 'y)))
            (icv-keep-prop! iff '(<= x y) '(NOT (= x y)) '(NOT (< x y)))))))
    (lambda () (ass))))
(qed 'rps-not-lt-le)
(topic! 'rps-not-lt-le 'inequalities)

;;; rps-lt-le-trans
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR)
                 (FORALL y (IMPLIES (IN y RR-POS-STAR)
                   (FORALL z (IMPLIES (IN z RR-POS-STAR)
                     (IMPLIES (< x y) (IMPLIES (<= y z) (< x z)))))))))))
(dk-peel!)
(let ((iff (dk-cite! '< 'x 'y)))
  (dk-have! '(AND (<= x y) (NOT (= x y))) (lambda () (icv-keep-prop! iff '(< x y))))
  (dk-split! '(AND (<= x y) (NOT (= x y))))
  (dk-have! '(AND (IN x RR-POS-STAR) (AND (IN y RR-POS-STAR) (IN z RR-POS-STAR))))
  (dk-have! '(AND (<= x y) (<= y z)))
  (fact 'rr-pos-star-le-trans 'x 'y 'z)
  (mac '<)
  (icv-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (di)
            (dk-have! '(<= y x) (lambda () (subst '(= x z)) (ass)))
            (dk-have! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
            (dk-have! '(AND (<= x y) (<= y x)))
            (fact 'rr-pos-star-le-antisymm 'x 'y)
            (icv-keep-prop! '(= x y) '(NOT (= x y))))))))
(qed 'rps-lt-le-trans)
(topic! 'rps-lt-le-trans 'inequalities)

;;; esup-lt-witness: below the supremum there is a member above.
(sp (make-wff '(FORALL S (IMPLIES (SUBSET S RR-POS-STAR)
                 (FORALL a (IMPLIES (IN a RR-POS-STAR)
                   (IMPLIES (< a (ESUP S)) (FORSOME y (AND (IN y S) (< a y))))))))))
(dk-peel!)
(fact 'esup-in 's)
(let ((p '(FORSOME y (AND (IN y s) (< a y))))
      (e '(ESUP s))
      (ub '(FORALL x (IMPLIES (IN x s) (<= x a)))))
  (use-em p
    (lambda () (ass))
    (lambda ()
      (dk-have! ub
        (lambda ()
          (let ((yv (dk-di-var!)))
            (fact 'subset-mem-fwd 's 'RR-POS-STAR yv)
            (use-em (list '< 'a yv)
              (lambda ()
                (dk-have! p (lambda () (ew yv) (icv-conj-close! (lambda () (ass)))))
                (icv-keep-prop! p (list 'NOT p)))
              (lambda () (fact 'rps-not-lt-le 'a yv) (ass))))))
      (dk-have! (list 'AND '(IN a RR-POS-STAR) ub))
      (fact 'esup-least 's 'a)
      (let ((iff (dk-cite! '< 'a e)))
        (dk-have! (list 'AND (list '<= 'a e) (list 'NOT (list '= 'a e)))
          (lambda () (icv-keep-prop! iff (list '< 'a e))))
        (dk-split! (list 'AND (list '<= 'a e) (list 'NOT (list '= 'a e))))
        (dk-have! (list 'AND '(IN a RR-POS-STAR) (list 'IN e 'RR-POS-STAR)))
        (dk-have! (list 'AND (list '<= 'a e) (list '<= e 'a)))
        (fact 'rr-pos-star-le-antisymm 'a e)
        (icv-keep-prop! (list '= 'a e) (list 'NOT (list '= 'a e)))))))
(qed 'esup-lt-witness)
(topic! 'esup-lt-witness 'inequalities)

;;; esup-gt-of-member: a point below a member is below the supremum.
(sp (make-wff '(FORALL S (IMPLIES (SUBSET S RR-POS-STAR)
                 (FORALL y (IMPLIES (IN y S)
                   (FORALL a (IMPLIES (IN a RR-POS-STAR)
                     (IMPLIES (< a y) (< a (ESUP S)))))))))))
(dk-peel!)
(fact 'subset-mem-fwd 's 'RR-POS-STAR 'y)
(fact 'esup-in 's)
(dk-fact! 'esup-upper 's 'y)
(fact 'rps-lt-le-trans 'a 'y '(ESUP s))
(ass)
(qed 'esup-gt-of-member)
(topic! 'esup-gt-of-member 'inequalities)
;;; =====================================================================
;;; (B) MEASURABILITY BY NONNEGATIVE TAILS, and THE SUPREMUM OF A SEQUENCE.
;;;     For alpha < 0 the tail { alpha < f } is omega, so the tail criterion
;;;     need only be checked at alpha >= 0, where alpha is a point of
;;;     [0,+inf] and the order lemmas of (A) apply.
;;; =====================================================================

;;; goal (< t POS-INF), (IN t RR) in context
(define (icv-lt-pos-inf! t)
  (mac '<)
  (icv-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) '<=)
          (begin (icv-rr-star! t) (fact 'pos-inf-upper-bound t) (ass))
          (begin
            (di)
            (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF t)) (ass)))
            (fact 'pos-inf-not-in-rr)
            (icv-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR))))))))

;;; measurable-fn-of-nonneg-tails
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN f (FUN omega RR-POS-STAR))
            (IMPLIES (FORALL al_ (IMPLIES (IN al_ RR)
                       (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (f x_))) cA))))
              (IS-MEASURABLE-FN omega cA f)))))))))
(dk-peel!)
(let ((hyp '(FORALL al_ (IMPLIES (IN al_ RR)
              (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (f x_))) cA))))))
  (mac 'IS-MEASURABLE-FN)
  (icv-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((al (dk-di-var!))
                 (tl (list 'SEP 'x_ 'omega (list '< al '(f x_)))))
            (use-em (list '<= 0 al)
              (lambda () (dk-apply! hyp al) (ass))
              (lambda ()
                (fact 'rr-zero-in)
                (fact 'rr-not-le-lt 0 al)
                (icv-set-eq! tl 'omega
                  (lambda (w) (sep-me (list 'IN w tl)) (ass))
                  (lambda (w)
                    (let ((fw (list 'f w)))
                      (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                      (icv-sep-in!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (ass)
                              (icv-star-cases! fw
                                (lambda ()
                                  (dk-ineq! (list 'IN al 'RR) (list 'IN fw 'RR)
                                            (list '< al 0) (list '<= 0 fw)))
                                (lambda ()
                                  (subst (list '= fw 'POS-INF))
                                  (icv-lt-pos-inf! al)))))))))
                (fact 'sigma-algebra-whole-in 'omega 'cA)
                (subst (list '= tl 'omega))
                (ass))))))))
(qed 'measurable-fn-of-nonneg-tails)
(topic! 'measurable-fn-of-nonneg-tails 'analysis)

;;; The sequence n |-> cF(n)(w) and its image, for w in omega:
;;; land phi in FUN(NN, RR-POS-STAR), IMG subset RR-POS-STAR, ESUP(IMG) in
;;; RR-POS-STAR.  Returns (PHI IMG E).
(define (icv-seq w) (list 'VNB-LAMBDA 'n_ 'NN (list (list 'cf 'n_) w)))
(define (icv-img-facts! w)
  (let* ((phi (icv-seq w))
         (img (list 'IMAGE phi 'NN))
         (e   (list 'ESUP img)))
    (if (not (dk-asm? (list 'IN e 'RR-POS-STAR)))
        (begin
          (dk-have! (list 'IN phi '(FUN NN RR-POS-STAR))
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let ((k (dk-di-var!)))
                    (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) k)
                    (fact 'fun-apply-type-c (list 'cf k) 'omega 'RR-POS-STAR w)
                    (ass))))))
          (dk-have! (list 'SUBSET img 'RR-POS-STAR)
            (lambda ()
              (mac 'subset-def)
              (let ((v (dk-di-var!)))
                (fact 'image-subset-codomain 'NN 'RR-POS-STAR phi v)
                (ass))))
          (fact 'esup-in img)))
    (list phi img e)))

;;; t = phi(k) is a member of IMAGE(phi, NN); (IN t RR-POS-STAR), (IN k NN) in
;;; context, phi(k) beta-reduces to t.  (mlw-in-image!, measure-laws.scm)
(define (icv-in-image! phi kv tm)
  (let* ((iff (dk-fact! 'image-membership-iff phi 'NN tm))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (icv-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((equal? g (list 'IN tm 'SET))
                     (fact 'membership-implies-sethood tm 'RR-POS-STAR) (ass))
                    ((eq? (car g) 'FORSOME)
                     (ew kv)
                     (icv-conj-close!
                       (lambda ()
                         (if (equal? (dk-goal) (list 'IN kv 'NN)) (ass)
                             (if (not (dk-lam-b!)) (rfl))))))
                    (#t (ass))))))))
    (ai iff)
    (detach! (list 'IMPLIES rhs lhs))))

;;; measurable-fn-sup-of-values: a function whose every value is the supremum
;;; of a sequence of measurable functions at that point is measurable.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL cF (FORALL g
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN cF (FUN NN (FUN omega RR-POS-STAR)))
            (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cF n_))))
              (IMPLIES (IN g (FUN omega RR-POS-STAR))
                (IMPLIES (FORALL x (IMPLIES (IN x omega)
                           (= (g x) (ESUP (IMAGE (VNB-LAMBDA n_ NN ((cF n_) x)) NN)))))
                  (IS-MEASURABLE-FN omega cA g))))))))))))
(dk-peel!)
(let* ((hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
       (hv '(FORALL x (IMPLIES (IN x omega)
              (= (g x) (ESUP (IMAGE (VNB-LAMBDA n_ NN ((cf n_) x)) NN))))))
       (nt '(FORALL al_ (IMPLIES (IN al_ RR)
              (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (g x_))) cA))))))
  (dk-have! nt
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal)))
             (al (cadr (cadddr tl)))
             (body-of (lambda (n) (list 'SEP 'x_ 'omega (list '< al (list (list 'cf n) 'x_)))))
             (tails! (lambda (n)
                       (dk-apply! hm n)
                       (let ((parts (icv-mfn-parts! 'omega 'cA (list 'cf n))))
                         (dk-apply! (caddr parts) al))))
             (hve (icv-abstract! 'NN 'cA body-of
                    (lambda (n) (tails! n) (ass))
                    (lambda (n) (tails! n)
                                (fact 'membership-implies-sethood (body-of n) 'cA))))
             (hf  (car hve))
             (ve  (cdr hve))
             (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
        (icv-rps! al)
        (fact 'sigma-algebra-union-closed 'omega 'cA hf)
        (icv-set-eq! tl bu
          ;; alpha < g(w)  =>  w in some tail
          (lambda (w)
            (sep-me (list 'IN w tl))
            (let* ((pie (icv-img-facts! w))
                   (phi (car pie)) (img (cadr pie)) (e (caddr pie)))
              (dk-apply! hv w)
              (dk-have! (list '< al e) (lambda () (subst (list '= e (list 'g w))) (ass)))
              (let* ((ex (dk-fact! 'esup-lt-witness img al))
                     (yv (dk-skolem! ex))
                     (iff (dk-fact! 'image-membership-iff phi 'NN yv)))
                (ai iff)
                (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                (let* ((nv (dk-skolem! (dk-ctx-form (caddr iff))))
                       (fnw (list (list 'cf nv) w)))
                  (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) nv)
                  (fact 'fun-apply-type-c (list 'cf nv) 'omega 'RR-POS-STAR w)
                  (dk-have! (list '= fnw yv)
                    (lambda ()
                      (subst (list '= yv (list phi nv)))
                      (if (not (dk-lam-b!)) (rfl))))
                  (dk-have! (list '< al fnw) (lambda () (subst (list '= fnw yv)) (ass)))
                  (dk-apply! ve nv)
                  (dk-have! (list 'IN w (list hf nv))
                    (lambda ()
                      (subst (list '== (list hf nv) (body-of nv)))
                      (icv-sep-in! (lambda () (dk-ass!)))))
                  (for-each (lambda (l)
                              (if (not (sequent-node-grounded? l))
                                  (begin (dk-focus! l) (ass))))
                            (dk-opened (lambda () (bu-mi nv))))))))
          ;; w in some tail  =>  alpha < g(w)
          (lambda (w)
            (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                   (nv  (cadr nin))
                   (fnw (list (list 'cf nv) w)))
              (dk-apply! ve nv)
              (dk-have! (list 'IN w (body-of nv))
                (lambda () (subst (list '= (body-of nv) (list hf nv))) (ass)))
              (sep-me (list 'IN w (body-of nv)))
              (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) nv)
              (fact 'fun-apply-type-c (list 'cf nv) 'omega 'RR-POS-STAR w)
              (let* ((pie (icv-img-facts! w))
                     (phi (car pie)) (img (cadr pie)) (e (caddr pie)))
                (dk-apply! hv w)
                (icv-in-image! phi nv fnw)
                (fact 'esup-gt-of-member img fnw al)
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin (subst (list '= (list 'g w) e)) (ass)))))))))
        (subst (list '= tl bu))
        (ass))))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA 'g)
  (ass))
(qed 'measurable-fn-sup-of-values)
(topic! 'measurable-fn-sup-of-values 'analysis)

;;; measurable-fn-sup -- statement copied from structure-library/integral.scm.
(sp (make-wff
  (forall-guarded '(omega cA cF)
                  (list '(IS-SIGMA-ALGEBRA omega cA)
                        '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(IS-MEASURABLE-FN omega cA (cF n_))))
    '(IS-MEASURABLE-FN omega cA (PTWISE-SUP omega cF)))))
(dk-peel!)
(let ((g '(PTWISE-SUP omega cf)))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (dk-have! (list 'IN g '(FUN omega RR-POS-STAR))
    (lambda ()
      (mac 'PTWISE-SUP)
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (icv-img-facts! x)
            (ass))))))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
              (list '= (list g 'x) '(ESUP (IMAGE (VNB-LAMBDA n_ NN ((cf n_) x)) NN)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (icv-img-facts! x)
        (mac 'PTWISE-SUP)
        (if (not (dk-lam-b!)) (rfl)))))
  (fact 'measurable-fn-sup-of-values 'omega 'cA 'cf g)
  (ass))
(qed 'measurable-fn-sup)
(topic! 'measurable-fn-sup 'analysis)
;;; =====================================================================
;;; (C) THE INFIMUM OF A SEQUENCE OVER AN INDEX SET, and THE LOWER LIMIT.
;;;     { alpha < inf_{p in D} f_p } = U_k { x : forall p in D. alpha + 1/(k+1) <= f_p(x) }
;;;     and the inner set is the complement of U_p { x : p in D and f_p(x) < beta }.
;;;     The lower limit is then the supremum of the tail infima (section B).
;;; =====================================================================

;;; t, b in RR, (NOT (< t b)) in context: land (<= b t)
(define (icv-real-not-lt-le! t b)
  (dk-have! (list '<= b t)
    (lambda ()
      (dk-have! (list 'AND (list 'IN b 'RR) (list 'IN t 'RR)))
      (let ((tot (dk-fact! 'rr-leq-total b t)))
        (use-cases tot
          (lambda () (ass))
          (lambda ()
            (use-em (list '= t b)
              (lambda () (subst (list '= t b)) (fact 'rr-leq-reflexive b) (ass))
              (lambda ()
                (let ((iff (dk-cite! '< t b)))
                  (icv-keep-prop! iff (list '<= t b) (list 'NOT (list '= t b))
                                  (list 'NOT (list '< t b))))))))))))

;;; t in RR-POS-STAR, b in RR, (NOT (< t b)): land (<= b t)
(define (icv-not-lt-le! t b)
  (if (not (dk-asm? (list '<= b t)))
      (dk-have! (list '<= b t)
        (lambda ()
          (icv-star-cases! t
            (lambda () (icv-real-not-lt-le! t b) (dk-ass!))
            (lambda ()
              (subst (list '= t 'POS-INF))
              (icv-rr-star! b) (fact 'pos-inf-upper-bound b) (ass)))))))

;;; FALSITY (or any goal) from (< t b) and (<= b t), t in RR-POS-STAR, b in RR
(define (icv-lt-clash! t b)
  (let ((iff (dk-cite! '< t b)))
    (dk-have! (list '<= t b) (lambda () (icv-keep-prop! iff (list '< t b))))
    (dk-have! (list 'AND (list 'IN t 'RR-POS-STAR) (list 'IN b 'RR)))
    (fact 'rr-pos-star-le-real-in-rr t b)
    (if (eq? (dk-goal) 'FALSITY)
        (dk-absurd! (list 'IN t 'RR) (list 'IN b 'RR) (list '< t b) (list '<= b t))
        (begin
          (dk-have! 'FALSITY
            (lambda () (dk-absurd! (list 'IN t 'RR) (list 'IN b 'RR) (list '< t b) (list '<= b t))))
          (icv-keep-prop! 'FALSITY)))))

;;; land (IN (f p) w) typings: cf(p) in FUN(omega, RR-POS-STAR), cf(p)(w) in RR-POS-STAR
(define (icv-fpw! p w)
  (fact 'fun-apply-type-c 'cf 'NN '(FUN omega RR-POS-STAR) p)
  (fact 'fun-apply-type-c (list 'cf p) 'omega 'RR-POS-STAR w))

;;; (SUBSET (IMAGE phi D) RR-POS-STAR), phi = icv-seq w, D subset NN in context
(define (icv-img-sub! d w)
  (let* ((phi (icv-seq w)) (img (list 'IMAGE phi d)))
    (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
        (dk-have! (list 'SUBSET img 'RR-POS-STAR)
          (lambda ()
            (mac 'subset-def)
            (let* ((v (dk-di-var!))
                   (iff (dk-fact! 'image-membership-iff phi d v)))
              (ai iff)
              (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
              (let* ((p (dk-skolem! (dk-ctx-form (caddr iff))))
                     (fpw (list (list 'cf p) w)))
                (fact 'subset-mem-fwd d 'NN p)
                (icv-fpw! p w)
                (dk-have! (list '= v fpw)
                  (lambda () (subst (list '= v (list phi p))) (if (not (dk-lam-b!)) (rfl))))
                (subst (list '= v fpw))
                (ass))))))
    img))

;;; t = phi(k) in IMAGE(phi, D): (IN t RR-POS-STAR), (IN k D), (IN k NN) in context
(define (icv-in-image-d! phi d kv tm)
  (let* ((iff (dk-fact! 'image-membership-iff phi d tm))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (icv-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((equal? g (list 'IN tm 'SET))
                     (fact 'membership-implies-sethood tm 'RR-POS-STAR) (ass))
                    ((eq? (car g) 'FORSOME)
                     (ew kv)
                     (icv-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (ass)
                             (if (not (dk-lam-b!)) (rfl))))))
                    (#t (ass))))))))
    (ai iff)
    (detach! (list 'IMPLIES rhs lhs))))

;;; measurable-fn-guarded-lt
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (FORALL p (FORALL ixs (FORALL b (IMPLIES (IN b RR)
            (IN (SEP x_ omega (AND (IN p ixs) (< (f x_) b))) cA)))))))))))
(dk-peel!)
(let* ((parts (icv-mfn-parts! 'omega 'cA 'f))
       (ge    '(SEP gx_ omega (<= b (f gx_))))
       (ss    '(SEP x_ omega (AND (IN p ixs) (< (f x_) b))))
       (cge   (list 'COMPLEMENT-IN 'omega ge)))
  (fact 'measurable-fn-ge 'omega 'cA 'f 'b)
  (use-em '(IN p ixs)
    (lambda ()
      (fact 'sigma-algebra-complement-closed 'omega 'cA ge)
      (icv-set-eq! ss cge
        (lambda (w)
          (let ((fw (list 'f w)))
            (sep-me (list 'IN w ss))
            (dk-split-all!)
            (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
            (mac 'complement-in-membership)
            (icv-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (begin
                      (di)
                      (sep-me (list 'IN w ge))
                      (icv-lt-clash! fw 'b)))))))
        (lambda (w)
          (let ((fw (list 'f w)))
            (mac-h 'complement-in-membership (list 'IN w cge))
            (dk-split-all!)
            (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
            (dk-have! (list 'NOT (list '<= 'b fw))
              (lambda ()
                (di)
                (dk-have! (list 'IN w ge) (lambda () (icv-sep-in! (lambda () (ass)))))
                (icv-keep-prop! (list 'IN w ge) (list 'NOT (list 'IN w ge)))))
            (icv-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (icv-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (icv-star-cases! fw
                              (lambda () (fact 'rr-not-le-lt 'b fw) (ass))
                              (lambda ()
                                (dk-have! (list '<= 'b fw)
                                  (lambda ()
                                    (subst (list '= fw 'POS-INF))
                                    (icv-rr-star! 'b) (fact 'pos-inf-upper-bound 'b) (ass)))
                                (icv-keep-prop! (list '<= 'b fw) (list 'NOT (list '<= 'b fw))))))))))))))
      (subst (list '= ss cge))
      (ass))
    (lambda ()
      (fact 'sigma-algebra-empty-in 'omega 'cA)
      (icv-set-eq! ss 'EMPTY-SET
        (lambda (w)
          (sep-me (list 'IN w ss))
          (dk-split-all!)
          (icv-keep-prop! '(IN p ixs) '(NOT (IN p ixs))))
        (lambda (w)
          (fact 'empty-set-has-no-members w)
          (icv-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
      (subst (list '= ss 'EMPTY-SET))
      (ass))))
(qed 'measurable-fn-guarded-lt)
(topic! 'measurable-fn-guarded-lt 'analysis)

;;; measurable-fn-lower-bound-set: { x : forall p in D. b <= f_p(x) } is measurable.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL cF (FORALL ixs (FORALL b
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN cF (FUN NN (FUN omega RR-POS-STAR)))
            (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cF n_))))
              (IMPLIES (SUBSET ixs NN)
                (IMPLIES (IN b RR)
                  (IN (SEP x_ omega (FORALL p_ (IMPLIES (IN p_ ixs) (<= b ((cF p_) x_))))) cA)))))))))))))
(dk-peel!)
(let* ((hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
       (lb '(SEP x_ omega (FORALL p_ (IMPLIES (IN p_ ixs) (<= b ((cf p_) x_))))))
       (body-of (lambda (p) (list 'SEP 'x_ 'omega (list 'AND (list 'IN p 'ixs) (list '< (list (list 'cf p) 'x_) 'b)))))
       (inca! (lambda (p)
                (dk-apply! hm p)
                (fact 'measurable-fn-guarded-lt 'omega 'cA (list 'cf p) p 'ixs 'b)))
       (hve (icv-abstract! 'NN 'cA body-of
              (lambda (p) (inca! p) (ass))
              (lambda (p) (inca! p) (fact 'membership-implies-sethood (body-of p) 'cA))))
       (hf  (car hve))
       (ve  (cdr hve))
       (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_)))
       (cc  (list 'COMPLEMENT-IN 'omega bu)))
  (fact 'sigma-algebra-union-closed 'omega 'cA hf)
  (fact 'sigma-algebra-complement-closed 'omega 'cA bu)
  (icv-set-eq! lb cc
    (lambda (w)
      (sep-me (list 'IN w lb))
      (let ((hyp (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'forall))) "the lower bound")))
        (mac 'complement-in-membership)
        (icv-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (di)
                  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                         (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                         (nv  (cadr nin))
                         (fnw (list (list 'cf nv) w)))
                    (dk-apply! ve nv)
                    (dk-have! (list 'IN w (body-of nv))
                      (lambda () (subst (list '= (body-of nv) (list hf nv))) (ass)))
                    (sep-me (list 'IN w (body-of nv)))
                    (dk-split-all!)
                    (icv-fpw! nv w)
                    (dk-apply! hyp nv)
                    (icv-lt-clash! fnw 'b))))))))
    (lambda (w)
      (mac-h 'complement-in-membership (list 'IN w cc))
      (dk-split-all!)
      (icv-sep-in!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((p (dk-di-var!))
                     (fpw (list (list 'cf p) w)))
                (fact 'subset-mem-fwd 'ixs 'NN p)
                (icv-fpw! p w)
                (use-em (list '< fpw 'b)
                  (lambda ()
                    (dk-apply! ve p)
                    (dk-have! (list 'IN w (list hf p))
                      (lambda ()
                        (subst (list '== (list hf p) (body-of p)))
                        (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
                    (dk-have! (list 'IN w bu)
                      (lambda ()
                        (for-each (lambda (l)
                                    (if (not (sequent-node-grounded? l))
                                        (begin (dk-focus! l) (ass))))
                                  (dk-opened (lambda () (bu-mi p))))))
                    (icv-keep-prop! (list 'IN w bu) (list 'NOT (list 'IN w bu))))
                  (lambda ()
                    (icv-not-lt-le! fpw 'b)
                    (dk-ass!)))))))))
  (subst (list '= lb cc))
  (ass))
(qed 'measurable-fn-lower-bound-set)
(topic! 'measurable-fn-lower-bound-set 'analysis)
;;; (NOT (= c 0)) from (< 0 c).
(define (icv-nz-of-pos! c)
  (dk-have! (list 'NOT (list '= c 0))
    (lambda ()
      (di)
      (fact 'equality-symmetry c 0)
      (let ((iff (dk-fact! '< 0 c)))
        (icv-keep-prop! iff (list '< 0 c) (list '= 0 c))))))

;;; k in NN, al in RR, 0 <= al in context.  r = recip(k+1), beta = al + r.
;;; Land (IN r RR), (< 0 r), (IN beta RR), (< al beta), (<= 0 beta),
;;; (IN beta RR-POS-STAR).
(define (icv-recip k) (list 'recip (list '+ k 1)))
(define (icv-beta al k) (list '+ al (icv-recip k)))
(define (icv-beta-facts! al k)
  (let* ((n1 (list '+ k 1)) (r (icv-recip k)) (b (icv-beta al k)))
    (if (not (dk-asm? (list 'IN b 'RR-POS-STAR)))
        (begin
          (fact 'nn-in-rr k)
          (fact 'nn-zero-le k)
          (dk-have! '(IN 1 RR) (lambda () (fact 'rr-one-in) (ass)))
          (dk-have! (list 'AND (list 'IN k 'RR) '(IN 1 RR)))
          (fact 'rr-add-closed k 1)
          (dk-have! (list '< 0 n1)
            (lambda () (dk-ineq! (list 'IN k 'RR) (list '<= 0 k))))
          (icv-nz-of-pos! n1)
          (dk-have! (list 'AND (list 'IN n1 'RR) (list 'NOT (list '= n1 0))))
          (fact 'rr-recip-closed n1)
          (fact 'rr-recip-pos n1)
          (dk-have! (list 'AND (list 'IN al 'RR) (list 'IN r 'RR)))
          (fact 'rr-add-closed al r)
          (dk-have! (list '< al b)
            (lambda () (dk-ineq! (list 'IN al 'RR) (list 'IN r 'RR) (list '< 0 r))))
          (dk-have! (list '<= 0 b)
            (lambda () (dk-ineq! (list 'IN al 'RR) (list 'IN r 'RR) (list '< 0 r) (list '<= 0 al))))
          (icv-rps! b)))
    b))

;;; measurable-fn-inf-of-values: a function whose every value is the infimum
;;; over an index set D of a sequence of measurable functions is measurable.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL cF (FORALL ixs (FORALL g
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN cF (FUN NN (FUN omega RR-POS-STAR)))
            (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cF n_))))
              (IMPLIES (SUBSET ixs NN)
                (IMPLIES (IN g (FUN omega RR-POS-STAR))
                  (IMPLIES (FORALL x (IMPLIES (IN x omega)
                             (= (g x) (EINF (IMAGE (VNB-LAMBDA n_ NN ((cF n_) x)) ixs)))))
                    (IS-MEASURABLE-FN omega cA g))))))))))))))
(dk-peel!)
(let* ((hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_)))))
       (hv '(FORALL x (IMPLIES (IN x omega)
              (= (g x) (EINF (IMAGE (VNB-LAMBDA n_ NN ((cf n_) x)) ixs))))))
       (nt '(FORALL al_ (IMPLIES (IN al_ RR)
              (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (g x_))) cA))))))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (dk-have! nt
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal)))
             (al (cadr (cadddr tl)))
             (lb-of (lambda (b) (list 'SEP 'x_ 'omega
                                  (list 'FORALL 'p_ (list 'IMPLIES '(IN p_ ixs)
                                                      (list '<= b '((cf p_) x_)))))))
             (body-of (lambda (k) (lb-of (icv-beta al k))))
             (inca! (lambda (k)
                      (icv-beta-facts! al k)
                      (fact 'measurable-fn-lower-bound-set 'omega 'cA 'cf 'ixs (icv-beta al k))))
             (hve (icv-abstract! 'NN 'cA body-of
                    (lambda (k) (inca! k) (ass))
                    (lambda (k) (inca! k) (fact 'membership-implies-sethood (body-of k) 'cA))))
             (hf  (car hve))
             (ve  (cdr hve))
             (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
        (icv-rps! al)
        (fact 'sigma-algebra-union-closed 'omega 'cA hf)
        (icv-set-eq! tl bu
          ;; alpha < g(w)  =>  some k with w in L(beta_k)
          (lambda (w)
            (sep-me (list 'IN w tl))
            (let* ((phi (icv-seq w))
                   (img (icv-img-sub! 'ixs w))
                   (ii  (list 'EINF img)))
              (fact 'einf-in img)
              (dk-apply! hv w)
              (dk-have! (list '< al ii) (lambda () (subst (list '= ii (list 'g w))) (ass)))
              (let ((finish!
                     (lambda (k)
                       (let* ((b (icv-beta-facts! al k))
                              (lw (list 'FORALL 'p_ (list 'IMPLIES '(IN p_ ixs)
                                                       (list '<= b (list '(cf p_) w))))))
                         (dk-have! lw
                           (lambda ()
                             (let* ((p (dk-di-var!))
                                    (fpw (list (list 'cf p) w)))
                               (fact 'subset-mem-fwd 'ixs 'NN p)
                               (icv-fpw! p w)
                               (icv-in-image-d! phi 'ixs p fpw)
                               (dk-fact! 'einf-lower img fpw)
                               (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR)
                                               (list 'AND (list 'IN ii 'RR-POS-STAR)
                                                     (list 'IN fpw 'RR-POS-STAR))))
                               (dk-have! (list 'AND (list '<= b ii) (list '<= ii fpw)))
                               (fact 'rr-pos-star-le-trans b ii fpw)
                               (ass))))
                         (dk-apply! ve k)
                         (dk-have! (list 'IN w (list hf k))
                           (lambda ()
                             (subst (list '== (list hf k) (body-of k)))
                             (icv-sep-in! (lambda () (dk-ass!)))))
                         (for-each (lambda (l)
                                     (if (not (sequent-node-grounded? l))
                                         (begin (dk-focus! l) (ass))))
                                   (dk-opened (lambda () (bu-mi k))))))))
                (icv-star-cases! ii
                  (lambda ()
                    (let ((eps (list '- ii al)))
                      (fact 'rr-sub-in-rr ii al)
                      (dk-have! (list '< 0 eps)
                        (lambda () (dk-ineq! (list 'IN al 'RR) (list 'IN ii 'RR) (list '< al ii))))
                      (let ((iff (dk-cite! '< 0 eps)))
                        (dk-have! (list 'AND (list 'IN eps 'RR)
                                        (list 'AND (list '<= 0 eps) (list 'NOT (list '= 0 eps))))
                          (lambda ()
                            (icv-keep-prop! iff (list '< 0 eps) (list 'IN eps 'RR)))))
                      (let ((iff2 (dk-cite! 'pos-rr eps)))
                        (dk-have! (list 'POS-RR eps)
                          (lambda ()
                            (icv-keep-prop! iff2 (list 'AND (list 'IN eps 'RR)
                                                 (list 'AND (list '<= 0 eps)
                                                       (list 'NOT (list '= 0 eps))))))))
                      (let* ((ex (dk-cite! 'nn-recip-succ-small eps))
                             (k  (dk-skolem! ex))
                             (b  (icv-beta-facts! al k)))
                        (dk-have! (list '<= b ii)
                          (lambda ()
                            (dk-ineq! (list 'IN al 'RR) (list 'IN ii 'RR) (list 'IN (icv-recip k) 'RR)
                                      (list '< (icv-recip k) eps))))
                        (finish! k))))
                  (lambda ()
                    (fact 'nn-zero-in)
                    (let ((b (icv-beta-facts! al 0)))
                      (dk-have! (list '<= b ii)
                        (lambda ()
                          (subst (list '= ii 'POS-INF))
                          (icv-rr-star! b) (fact 'pos-inf-upper-bound b) (ass)))
                      (finish! 0)))))))
          ;; w in L(beta_k)  =>  alpha < g(w)
          (lambda (w)
            (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                   (k   (cadr nin))
                   (b   (icv-beta-facts! al k))
                   (phi (icv-seq w)))
              (dk-apply! ve k)
              (dk-have! (list 'IN w (body-of k))
                (lambda () (subst (list '= (body-of k) (list hf k))) (ass)))
              (let* ((lbh (dk-landed-find (lambda () (sep-me (list 'IN w (body-of k))))
                                          (lambda (f) (eq? (car f) 'forall))))
                     (img (icv-img-sub! 'ixs w))
                     (ii  (list 'EINF img)))
                (fact 'einf-in img)
                (dk-apply! hv w)
                (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x img) (list '<= b 'x)))
                  (lambda ()
                    (let* ((v (dk-di-var!))
                           (iff (dk-fact! 'image-membership-iff phi 'ixs v)))
                      (ai iff)
                      (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                      (let* ((p (dk-skolem! (dk-ctx-form (caddr iff))))
                             (fpw (list (list 'cf p) w)))
                        (fact 'subset-mem-fwd 'ixs 'NN p)
                        (icv-fpw! p w)
                        (dk-have! (list '= v fpw)
                          (lambda () (subst (list '= v (list phi p))) (if (not (dk-lam-b!)) (rfl))))
                        (dk-apply! lbh p)
                        (subst (list '= v fpw))
                        (ass)))))
                (dk-fact! 'einf-greatest img b)
                (fact 'rps-lt-le-trans al b ii)
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin (subst (list '= (list 'g w) ii)) (ass)))))))))
        (subst (list '= tl bu))
        (ass))))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA 'g)
  (ass))
(qed 'measurable-fn-inf-of-values)
(topic! 'measurable-fn-inf-of-values 'analysis)
;;; The tail-infimum sequence G(m)(x) = EINF(ETAIL(n |-> cF(n)(x), m)).
(define icv-gg '(VNB-LAMBDA lm_ NN (VNB-LAMBDA lx_ omega
                   (EINF (ETAIL (VNB-LAMBDA n_ NN ((cf n_) lx_)) lm_)))))
(define (icv-tail-ixs m) (list 'SEP 'p_ 'NN (list '<= m 'p_)))
(define (icv-tinf w m) (list 'EINF (list 'ETAIL (icv-seq w) m)))

;;; (SUBSET {p in NN : m <= p} NN)
(define (icv-tail-sub! m)
  (let ((d (icv-tail-ixs m)))
    (if (not (dk-asm? (list 'SUBSET d 'NN)))
        (dk-have! (list 'SUBSET d 'NN)
          (lambda ()
            (mac 'subset-def)
            (let ((v (dk-di-var!)))
              (sep-me (list 'IN v d))
              (ass)))))
    d))

;;; land (IN (EINF (ETAIL phi_w m)) RR-POS-STAR); w in omega, m in NN in context
(define (icv-tinf-typed! w m)
  (let ((t (icv-tinf w m)))
    (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
        (dk-have! (list 'IN t 'RR-POS-STAR)
          (lambda ()
            (let* ((d (icv-tail-sub! m))
                   (img (icv-img-sub! d w)))
              (fact 'einf-in img)
              (mac 'ETAIL)
              (ass)))))
    t))

;;; the lambda n |-> EINF(ETAIL(phi_w, n)) is in FUN(NN, RR-POS-STAR)
(define (icv-l2 w) (list 'VNB-LAMBDA 'tm_ 'NN (icv-tinf w 'tm_)))
(define (icv-l2-typed! w)
  (let ((l2 (icv-l2 w)))
    (if (not (dk-asm? (list 'IN l2 '(FUN NN RR-POS-STAR))))
        (dk-have! (list 'IN l2 '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type! (lambda () (let ((m (dk-di-var!))) (icv-tinf-typed! w m) (dk-ass!)))))))
    l2))

;;; land (IN (ESUP (IMAGE L2 NN)) RR-POS-STAR)
(define (icv-liminf-typed! w)
  (let* ((l2 (icv-l2-typed! w))
         (img (list 'IMAGE l2 'NN)))
    (if (not (dk-asm? (list 'SUBSET img 'RR-POS-STAR)))
        (dk-have! (list 'SUBSET img 'RR-POS-STAR)
          (lambda ()
            (mac 'subset-def)
            (let ((v (dk-di-var!)))
              (fact 'image-subset-codomain 'NN 'RR-POS-STAR l2 v)
              (ass)))))
    (fact 'esup-in img)
    (list 'ESUP img)))

;;; measurable-fn-liminf -- statement copied from structure-library/integral.scm.
(sp (make-wff
  (forall-guarded '(omega cA cF)
                  (list '(IS-SIGMA-ALGEBRA omega cA)
                        '(IN cF (FUN NN (FUN omega RR-POS-STAR)))
                        (forall-guarded '(n_) '((IN n_ NN))
                          '(IS-MEASURABLE-FN omega cA (cF n_))))
    '(IS-MEASURABLE-FN omega cA (PTWISE-LIMINF omega cF)))))
(dk-peel!)
(let* ((gg icv-gg)
       (lf '(PTWISE-LIMINF omega cf))
       (hm '(FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega cA (cf n_))))))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  ;; G(m) is the lambda x |-> EINF(ETAIL(phi_x, m)); its typing
  (define (icv-gm-typed! m)
    (let ((gm (list 'VNB-LAMBDA 'lx_ 'omega (icv-tinf 'lx_ m))))
      (dk-have! (list 'IN gm '(FUN omega RR-POS-STAR))
        (lambda ()
          (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (icv-tinf-typed! x m) (dk-ass!))))))
      gm))
  ;; G in FUN(NN, FUN(omega, RR-POS-STAR))
  (dk-have! (list 'IN gg '(FUN NN (FUN omega RR-POS-STAR)))
    (lambda ()
      (dk-lam-type! (lambda () (let ((m (dk-di-var!))) (icv-gm-typed! m) (dk-ass!))))))
  ;; every G(m) is measurable: the infimum over the tail index set
  (dk-have! (list 'FORALL 'gm_ (list 'IMPLIES '(IN gm_ NN)
              (list 'IS-MEASURABLE-FN 'omega 'cA (list gg 'gm_))))
    (lambda ()
      (let* ((m  (dk-di-var!))
             (d  (icv-tail-sub! m)))
        (dk-lam-b!)
        (let ((gm (icv-gm-typed! m)))
          (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                      (list '= (list gm 'x) (list 'EINF (list 'IMAGE (icv-seq 'x) d)))))
            (lambda ()
              (let ((x (dk-di-var!)))
                (icv-tinf-typed! x m)
                (fact 'einf-in (icv-img-sub! d x))
                (dk-lam-b!)
                (mac 'ETAIL)
                (rfl))))
          (fact 'measurable-fn-inf-of-values 'omega 'cA 'cf d gm)
          (ass)))))
  ;; the lower limit is the supremum of the G(m)
  (dk-have! (list 'IN lf '(FUN omega RR-POS-STAR))
    (lambda ()
      (mac 'PTWISE-LIMINF)
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (icv-liminf-typed! x)
            (mac 'ELIMINF)
            (ass))))))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
              (list '= (list lf 'x)
                    (list 'ESUP (list 'IMAGE (list 'VNB-LAMBDA 'n_ 'NN (list (list gg 'n_) 'x)) 'NN)))))
    (lambda ()
      (let* ((x  (dk-di-var!))
             (l1 (list 'VNB-LAMBDA 'n_ 'NN (list (list gg 'n_) x)))
             (l2 (icv-l2-typed! x)))
        (icv-liminf-typed! x)
        (dk-fun-ext! l1 l2 'NN 'RR-POS-STAR
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((m (dk-di-var!)))
                  (icv-tinf-typed! x m)
                  (if (not (dk-lam-b!)) (ass))))))
          #f
          (lambda (v)
            (icv-tinf-typed! x v)
            (if (not (dk-lam-b!)) (rfl))))
        (subst (list '= l1 l2))
        (mac 'PTWISE-LIMINF)
        (if (not (dk-lam-b!))
            (begin (mac 'ELIMINF) (rfl))))))
  (fact 'measurable-fn-sup-of-values 'omega 'cA gg lf)
  (ass))
(qed 'measurable-fn-liminf)
(topic! 'measurable-fn-liminf 'analysis)
;;; =====================================================================
;;; (D) THE GRID k/(n+1): a floor for a positive step, and a grid point
;;;     strictly between two reals.  (No rational enumeration is needed:
;;;     the grid is indexed by NN x NN, and qq-dense-in-rr, an asserted
;;;     support, is not used.)
;;; =====================================================================

;;; (POS-RR e) from (IN e RR), (< 0 e)
(define (icv-pos-rr! e)
  (let ((iff (dk-cite! '< 0 e)))
    (dk-have! (list 'AND (list 'IN e 'RR)
                    (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))))
      (lambda ()
        (icv-keep-prop! iff (list '< 0 e) (list 'IN e 'RR)))))
  (let ((iff2 (dk-cite! 'pos-rr e)))
    (dk-have! (list 'POS-RR e)
      (lambda ()
        (icv-keep-prop! iff2 (list 'AND (list 'IN e 'RR)
                             (list 'AND (list '<= 0 e)
                                   (list 'NOT (list '= 0 e)))))))))

;;; (IN (* a b) RR) from (IN a RR), (IN b RR)
(define (icv-mul-rr! a b)
  (if (not (dk-asm? (list 'IN (list '* a b) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
        (fact 'rr-mul-closed a b))))

;;; rr-nn-floor-mul: for c >= 0 and r > 0 there is m in NN with m r <= c < m r + r.
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL r (IMPLIES (POS-RR r)
          (FORSOME mf_ (AND (IN mf_ NN)
            (AND (<= (* mf_ r) c) (< c (+ (* mf_ r) r))))))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'r)
(fact 'rr-lt-of-pos-rr 'r)
(dk-have! '(AND (IN c RR) (IN r RR)))
(fact 'rr-add-closed 'c 'r)
(let* ((tt  '(SEP k_ NN (< c (* k_ r))))
       (ex  (dk-fact! 'rr-archimedean-multiple 'r '(+ c r)))
       (k0  (dk-skolem! ex)))
  (fact 'nn-in-rr k0)
  (icv-mul-rr! k0 'r)
  (dk-have! (list 'IN k0 tt)
    (lambda ()
      (icv-sep-in!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (dk-ineq! '(IN c RR) '(IN r RR) (list 'IN (list '* k0 'r) 'RR)
                        (list '<= '(+ c r) (list '* k0 'r)) '(< 0 r)))))))
  (dk-have! (list 'SUBSET tt 'NN)
    (lambda ()
      (mac 'subset-def)
      (let ((v (dk-di-var!))) (sep-me (list 'IN v tt)) (ass))))
  (dk-have! (list 'FORSOME 'n (list 'IN 'n tt)) (lambda () (ew k0) (ass)))
  (dk-have! (list 'AND (list 'SUBSET tt 'NN) (list 'FORSOME 'n (list 'IN 'n tt))))
  (let* ((ex2 (dk-fact! 'nn-least-element tt))
         (m   (dk-skolem! ex2))
         (minh (dk-pick (lambda (f) (and (eq? (car f) 'forall) (dk-contains? f tt))) "minimality")))
    (dk-have! (list 'IN m 'NN) (lambda () (sep-me (list 'IN m tt)) (ass)))
    (dk-have! (list '< 'c (list '* m 'r)) (lambda () (sep-me (list 'IN m tt)) (ass)))
    (fact 'nn-in-rr m)
    (icv-mul-rr! m 'r)
    (dk-have! (list 'NOT (list '= m 0))
      (lambda ()
        (di)
        (dk-have! '(< c (* 0 r)) (lambda () (subst (list '= 0 m)) (ass)))
        (dk-absurd! '(IN c RR) '(IN r RR) '(<= 0 c) '(< c (* 0 r)))))
    (let* ((ex3 (dk-fact! 'nn-nonzero-is-succ m))
           (j   (dk-skolem! ex3))
           (jr  (list '* j 'r))
           (j1  (list '+ j 1)))
      (fact 'nn-succ-plus-one j)
      (fact 'nn-in-rr j)
      (icv-mul-rr! j 'r)
      (dk-have! (list 'NOT (list '< 'c jr))
        (lambda ()
          (di)
          (dk-have! (list 'IN j tt) (lambda () (icv-sep-in! (lambda () (dk-ass!)))))
          (dk-apply! minh j)
          (dk-have! (list '= m j1)
            (lambda () (subst (list '= m (list 'succ j))) (ass)))
          (dk-absurd! (list 'IN m 'RR) (list 'IN j 'RR) (list '= m j1) (list '<= m j))))
      (icv-real-not-lt-le! 'c jr)
      (dk-have! (list '< 'c (list '* j1 'r))
        (lambda ()
          (subst (list '= j1 (list 'succ j)))
          (subst (list '= (list 'succ j) m))
          (ass)))
      (dk-have! (list '= (list '* j1 'r) (list '+ jr 'r)) (lambda () (crs)))
      (ew j)
      (icv-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (subst (list '= (list '+ jr 'r) (list '* j1 'r)))
                (ass))))))))
(qed 'rr-nn-floor-mul)
(topic! 'rr-nn-floor-mul 'inequalities)

;;; rr-grid-between: between two reals a < b with 0 <= a there is a grid point
;;; k/(n+1), written k * recip(n+1).
(define (icv-gq n k) (list '* k (list 'recip (list '+ n 1))))
(sp (make-wff
     '(FORALL a (IMPLIES (IN a RR) (IMPLIES (<= 0 a)
        (FORALL b (IMPLIES (IN b RR) (IMPLIES (< a b)
          (FORSOME gn_ (AND (IN gn_ NN)
            (FORSOME gk_ (AND (IN gk_ NN)
              (AND (< a (* gk_ (recip (+ gn_ 1))))
                   (< (* gk_ (recip (+ gn_ 1))) b))))))))))))))
(dk-peel!)
(let ((eps '(- b a)))
  (fact 'rr-sub-in-rr 'b 'a)
  (dk-have! (list '< 0 eps) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(< a b))))
  (icv-pos-rr! eps)
  (let* ((ex (dk-cite! 'nn-recip-succ-small eps))
         (n  (dk-skolem! ex))
         (r  (icv-recip n)))
    (fact 'nn-recip-succ-pos n)
    (fact 'rr-pos-rr-in-rr r)
    (fact 'rr-lt-of-pos-rr r)
    (let* ((ex2 (dk-fact! 'rr-nn-floor-mul 'a r))
           (m   (dk-skolem! ex2))
           (mr  (list '* m r))
           (m1  (list '+ m 1))
           (q   (list '* m1 r)))
      (fact 'nn-in-rr m)
      (icv-mul-rr! m r)
      (fact 'nn-one-in)
      (dk-have! (list 'AND (list 'IN m 'NN) '(IN 1 NN)))
      (fact 'nn-add-closed m 1)
      (dk-have! (list '= q (list '+ mr r)) (lambda () (crs)))
      (ew n)
      (icv-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew m1)
                (icv-conj-close!
                  (lambda ()
                    (cond ((dk-asm? (dk-goal)) (ass))
                          ((equal? (cadr (dk-goal)) 'a)
                           (subst (list '= q (list '+ mr r))) (ass))
                          (#t
                           (subst (list '= q (list '+ mr r)))
                           (dk-ineq! '(IN a RR) '(IN b RR) (list 'IN r 'RR)
                                     (list 'IN mr 'RR) (list '<= mr 'a)
                                     (list '< r eps)))))))))))))
(qed 'rr-grid-between)
(topic! 'rr-grid-between 'inequalities)
;;; =====================================================================
;;; (E) THE SUM OF TWO MEASURABLE FUNCTIONS.  For alpha >= 0:
;;;   { alpha < f + g } = { alpha < g }  u  U_n U_k ({ q < f } n { alpha - q < g }),
;;;   q = k/(n+1).
;;; =====================================================================

(define (icv-fw fv w) (list fv w))

;;; measurable-fn-grid-row
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (FORALL g (FORALL al (FORALL r
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (IMPLIES (IS-MEASURABLE-FN omega cA g)
            (IMPLIES (IN al RR)
              (IMPLIES (IN r RR)
                (IN (SEP x_ omega (FORSOME k_ (AND (IN k_ NN)
                                                (AND (< (* k_ r) (f x_))
                                                     (< (- al (* k_ r)) (g x_))))))
                    cA)))))))))))))
(dk-peel!)
(let* ((pf (icv-mfn-parts! 'omega 'cA 'f))
       (pg (icv-mfn-parts! 'omega 'cA 'g))
       (tf (caddr pf)) (tg (caddr pg))
       (row '(SEP x_ omega (FORSOME k_ (AND (IN k_ NN)
                                          (AND (< (* k_ r) (f x_))
                                               (< (- al (* k_ r)) (g x_)))))))
       (ta (lambda (k) (list 'SEP 'x_ 'omega (list '< (list '* k 'r) '(f x_)))))
       (tb (lambda (k) (list 'SEP 'x_ 'omega (list '< (list '- 'al (list '* k 'r)) '(g x_)))))
       (body-of (lambda (k) (list 'INTERSECTION (ta k) (tb k))))
       (inca! (lambda (k)
                (fact 'nn-in-rr k)
                (icv-mul-rr! k 'r)
                (fact 'rr-sub-in-rr 'al (list '* k 'r))
                (dk-apply! tf (list '* k 'r))
                (dk-apply! tg (list '- 'al (list '* k 'r)))
                (fact 'sigma-algebra-inter-closed-2 'omega 'cA (ta k) (tb k))))
       (hve (icv-abstract! 'NN 'cA body-of
              (lambda (k) (inca! k) (ass))
              (lambda (k) (inca! k) (fact 'membership-implies-sethood (body-of k) 'cA))))
       (hf  (car hve))
       (ve  (cdr hve))
       (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
  (fact 'sigma-algebra-union-closed 'omega 'cA hf)
  (icv-set-eq! row bu
    (lambda (w)
      (sep-me (list 'IN w row))
      (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
             (k  (dk-skolem! ex)))
        (dk-apply! ve k)
        (dk-have! (list 'IN w (list hf k))
          (lambda ()
            (subst (list '== (list hf k) (body-of k)))
            (mac 'intersection-membership)
            (icv-conj-close! (lambda () (icv-sep-in! (lambda () (dk-ass!)))))))
        (for-each (lambda (l)
                    (if (not (sequent-node-grounded? l))
                        (begin (dk-focus! l) (ass))))
                  (dk-opened (lambda () (bu-mi k))))))
    (lambda (w)
      (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
             (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
             (k   (cadr nin)))
        (dk-apply! ve k)
        (dk-have! (list 'IN w (body-of k))
          (lambda () (subst (list '= (body-of k) (list hf k))) (ass)))
        (mac-h 'intersection-membership (list 'IN w (body-of k)))
        (dk-split-all!)
        (sep-me (list 'IN w (ta k)))
        (sep-me (list 'IN w (tb k)))
        (icv-sep-in!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (ew k)
                  (icv-conj-close! (lambda () (dk-ass!))))))))))
  (subst (list '= row bu))
  (ass))
(qed 'measurable-fn-grid-row)
(topic! 'measurable-fn-grid-row 'analysis)

;;; eplus(u, v) = u + v on the reals: land (= (eplus u v) (+ u v)); u, v real >= 0
(define (icv-eplus-eq! u v)
  (let ((e (list '= (list 'eplus u v) (list '+ u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'eplus-real-defined u v)
            (subst (list '= (list 'eplus u v) (list 'binplus u v)))
            (fact 'binplus-apply u v)
            (subst (list '== (list 'binplus u v) (list '+ u v)))
            (fact 'rr-add-closed u v)
            (rfl))))
    e))

;;; measurable-fn-eplus-of-values
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (FORALL g (FORALL h
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (IMPLIES (IS-MEASURABLE-FN omega cA g)
            (IMPLIES (IN h (FUN omega RR-POS-STAR))
              (IMPLIES (FORALL x (IMPLIES (IN x omega) (= (h x) (eplus (f x) (g x)))))
                (IS-MEASURABLE-FN omega cA h))))))))))))
(dk-peel!)
(let* ((pf (icv-mfn-parts! 'omega 'cA 'f))
       (pg (icv-mfn-parts! 'omega 'cA 'g))
       (tg (caddr pg))
       (hv '(FORALL x (IMPLIES (IN x omega) (= (h x) (eplus (f x) (g x))))))
       (nt '(FORALL al_ (IMPLIES (IN al_ RR)
              (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (h x_))) cA))))))
  (dk-have! nt
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal)))
             (al (cadr (cadddr tl)))
             (row-of (lambda (n)
                       (let ((r (icv-recip n)))
                         (list 'SEP 'x_ 'omega
                               (list 'FORSOME 'k_
                                     (list 'AND '(IN k_ NN)
                                           (list 'AND (list '< (list '* 'k_ r) '(f x_))
                                                 (list '< (list '- al (list '* 'k_ r)) '(g x_)))))))))
             (rfacts! (lambda (n)
                        (fact 'nn-recip-succ-pos n)
                        (fact 'rr-pos-rr-in-rr (icv-recip n))
                        (fact 'rr-lt-of-pos-rr (icv-recip n))))
             (inca! (lambda (n)
                      (rfacts! n)
                      (fact 'measurable-fn-grid-row 'omega 'cA 'f 'g al (icv-recip n))))
             (hve (icv-abstract! 'NN 'cA row-of
                    (lambda (n) (inca! n) (ass))
                    (lambda (n) (inca! n) (fact 'membership-implies-sethood (row-of n) 'cA))))
             (hf  (car hve))
             (ve  (cdr hve))
             (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_)))
             (bb  (list 'SEP 'x_ 'omega (list '< al '(g x_))))
             (uu  (list 'UNION bu bb)))
        (icv-rps! al)
        (fact 'sigma-algebra-union-closed 'omega 'cA hf)
        (dk-apply! tg al)
        (dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'IS-MEASURABLE-FN '(IS-MEASURABLE-FN omega cA f))
        (fact 'sigma-algebra-union-closed-2 'omega 'cA bu bb)
        (icv-set-eq! tl uu
          ;; alpha < f(w) + g(w)  =>  w in U u B
          (lambda (w)
            (let ((fw (list 'f w)) (gw (list 'g w)))
              (sep-me (list 'IN w tl))
              (dk-apply! hv w)
              (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
              (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR w)
              (mac 'union-membership)
              (use-em (list '< al gw)
                (lambda () (oi-r) (icv-sep-in! (lambda () (dk-ass!))))
                (lambda ()
                  (icv-star-cases! gw
                    (lambda ()
                      (icv-real-not-lt-le! al gw)
                      (let ((a (list '- al gw)))
                        (fact 'rr-sub-in-rr al gw)
                        (dk-have! (list '<= 0 a)
                          (lambda () (dk-ineq! (list 'IN al 'RR) (list 'IN gw 'RR) (list '<= gw al))))
                        (let ((finish!
                               (lambda (b fw-close!)
                                 (dk-have! (list '< a b) (lambda () (fw-close! 'gap)))
                                 (let* ((ex (dk-fact! 'rr-grid-between a b))
                                        (n  (dk-skolem! ex))
                                        (ex2 (dk-pick (dk-head? 'forsome) "the grid numerator"))
                                        (k  (dk-skolem! ex2))
                                        (q  (icv-gq n k)))
                                   (rfacts! n)
                                   (fact 'nn-in-rr k)
                                   (icv-mul-rr! k (icv-recip n))
                                   (oi-l)
                                   (dk-apply! ve n)
                                   (dk-have! (list 'IN w (list hf n))
                                     (lambda ()
                                       (subst (list '== (list hf n) (row-of n)))
                                       (icv-sep-in!
                                         (lambda ()
                                           (if (dk-asm? (dk-goal))
                                               (ass)
                                               (begin
                                                 (ew k)
                                                 (icv-conj-close!
                                                   (lambda ()
                                                     (let ((g (dk-goal)))
                                                       (cond ((dk-asm? g) (ass))
                                                             ((equal? (caddr g) fw) (fw-close! q))
                                                             (#t (dk-ineq! (list 'IN al 'RR) (list 'IN gw 'RR)
                                                                           (list 'IN q 'RR) (list '< a q)))))))))))))
                                   (for-each (lambda (l)
                                               (if (not (sequent-node-grounded? l))
                                                   (begin (dk-focus! l) (ass))))
                                             (dk-opened (lambda () (bu-mi n))))))))
                          (icv-star-cases! fw
                            (lambda ()
                              (icv-eplus-eq! fw gw)
                              (dk-have! (list '< al (list '+ fw gw))
                                (lambda ()
                                  (subst (list '= (list '+ fw gw) (list 'eplus fw gw)))
                                  (subst (list '= (list 'eplus fw gw) (list 'h w)))
                                  (ass)))
                              (finish! fw
                                (lambda (q)
                                  (if (eq? q 'gap)
                                      (dk-ineq! (list 'IN al 'RR) (list 'IN gw 'RR) (list 'IN fw 'RR)
                                                (list '< al (list '+ fw gw)))
                                      (ass)))))
                            (lambda ()
                              (let ((b (list '+ al 1)))
                                (fact 'rr-one-in)
                                (dk-have! (list 'AND (list 'IN al 'RR) '(IN 1 RR)))
                                (fact 'rr-add-closed al 1)
                                (finish! b
                                  (lambda (q)
                                    (if (eq? q 'gap)
                                        (dk-ineq! (list 'IN al 'RR) (list 'IN gw 'RR) (list '<= 0 gw))
                                        (begin (subst (list '= fw 'POS-INF)) (icv-lt-pos-inf! q)))))))))))
                    (lambda ()
                      (dk-have! (list '< al gw)
                        (lambda () (subst (list '= gw 'POS-INF)) (icv-lt-pos-inf! al)))
                      (icv-keep-prop! (list '< al gw) (list 'NOT (list '< al gw)))))))))
          ;; w in U u B  =>  alpha < f(w) + g(w)
          (lambda (w)
            (let ((fw (list 'f w)) (gw (list 'g w)) (hw (list 'h w)))
              (mac-h 'union-membership (list 'IN w uu))
              (let ((dis (dk-pick (dk-head? 'or) "the union cases")))
                (use-cases dis
                  (lambda ()
                    (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                           (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                           (n   (cadr nin)))
                      (dk-apply! ve n)
                      (dk-have! (list 'IN w (row-of n))
                        (lambda () (subst (list '= (row-of n) (list hf n))) (ass)))
                      (sep-me (list 'IN w (row-of n)))
                      (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
                             (k  (dk-skolem! ex))
                             (q  (icv-gq n k)))
                        (rfacts! n)
                        (fact 'nn-in-rr k)
                        (icv-mul-rr! k (icv-recip n))
                        (dk-apply! hv w)
                        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                        (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR w)
                        (icv-sep-in!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin
                                  (subst (list '= hw (list 'eplus fw gw)))
                                  (icv-star-cases! fw
                                    (lambda ()
                                      (icv-star-cases! gw
                                        (lambda ()
                                          (icv-eplus-eq! fw gw)
                                          (subst (list '= (list 'eplus fw gw) (list '+ fw gw)))
                                          (dk-ineq! (list 'IN al 'RR) (list 'IN q 'RR)
                                                    (list 'IN fw 'RR) (list 'IN gw 'RR)
                                                    (list '< q fw) (list '< (list '- al q) gw)))
                                        (lambda ()
                                          (subst (list '= gw 'POS-INF))
                                          (fact 'eplus-pos-inf-right fw)
                                          (subst (list '= (list 'eplus fw 'POS-INF) 'POS-INF))
                                          (icv-lt-pos-inf! al))))
                                    (lambda ()
                                      (subst (list '= fw 'POS-INF))
                                      (fact 'eplus-pos-inf-left gw)
                                      (subst (list '= (list 'eplus 'POS-INF gw) 'POS-INF))
                                      (icv-lt-pos-inf! al))))))))))
                  (lambda ()
                    (sep-me (list 'IN w bb))
                    (dk-apply! hv w)
                    (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                    (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR w)
                    (dk-have! (list 'AND (list 'IN gw 'RR-POS-STAR) (list 'IN fw 'RR-POS-STAR)))
                    (fact 'eplus-le-left gw fw)
                    (fact 'eplus-comm gw fw)
                    (dk-have! (list 'AND (list 'IN fw 'RR-POS-STAR) (list 'IN gw 'RR-POS-STAR)))
                    (fact 'eplus-closed fw gw)
                    (dk-have! (list '<= gw (list 'eplus fw gw))
                      (lambda () (subst (list '= (list 'eplus fw gw) (list 'eplus gw fw))) (ass)))
                    (fact 'rps-lt-le-trans al gw (list 'eplus fw gw))
                    (icv-sep-in!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (begin (subst (list '= hw (list 'eplus fw gw))) (ass)))))))))))
        (subst (list '= tl uu))
        (ass))))
  (dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'IS-MEASURABLE-FN '(IS-MEASURABLE-FN omega cA f))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA 'h)
  (ass))
(qed 'measurable-fn-eplus-of-values)
(topic! 'measurable-fn-eplus-of-values 'analysis)

;;; measurable-fn-eplus -- statement copied from structure-library/integral.scm.
(sp (make-wff
  (forall-guarded '(omega cA f g)
                  '((IS-MEASURABLE-FN omega cA f) (IS-MEASURABLE-FN omega cA g))
    '(IS-MEASURABLE-FN omega cA (PTWISE-EPLUS omega f g)))))
(dk-peel!)
(let ((h '(PTWISE-EPLUS omega f g)))
  (icv-mfn-parts! 'omega 'cA 'f)
  (icv-mfn-parts! 'omega 'cA 'g)
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (let ((typed! (lambda (x)
                  (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
                  (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
                  (dk-have! (list 'AND (list 'IN (list 'f x) 'RR-POS-STAR) (list 'IN (list 'g x) 'RR-POS-STAR)))
                  (fact 'eplus-closed (list 'f x) (list 'g x)))))
    (dk-have! (list 'IN h '(FUN omega RR-POS-STAR))
      (lambda ()
        (mac 'PTWISE-EPLUS)
        (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (typed! x) (dk-ass!))))))
    (dk-have! '(FORALL x (IMPLIES (IN x omega) (= ((PTWISE-EPLUS omega f g) x) (eplus (f x) (g x)))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (typed! x)
          (mac 'PTWISE-EPLUS)
          (if (not (dk-lam-b!)) (rfl))))))
  (fact 'measurable-fn-eplus-of-values 'omega 'cA 'f 'g h)
  (ass))
(qed 'measurable-fn-eplus)
(topic! 'measurable-fn-eplus 'analysis)
;;; =====================================================================
;;; (F) THE PRODUCT OF TWO MEASURABLE FUNCTIONS.  For alpha >= 0:
;;;   { alpha < f g } = U_n U_k { 0 < q, q < f, alpha/q < g },  q = k/(n+1).
;;;   First the real arithmetic behind the two inclusions.
;;; =====================================================================

;;; (< (* c x) (* c y)) from (< 0 c), (< x y), all three real
(define (icv-scale! c x y)
  (let ((r (list '< (list '* c x) (list '* c y))))
    (if (not (dk-asm? r))
        (begin
          (dk-have! (list 'AND (list '< 0 c) (list '< x y)))
          (fact 'rr-lt-scale-pos c x y)))
    r))

;;; land (IN (recip c) RR), (< 0 (recip c)), (= (* c (recip c)) 1) from (IN c RR), (< 0 c)
(define (icv-recip-facts! c)
  (let ((u (list 'recip c)))
    (if (not (dk-asm? (list 'IN u 'RR)))
        (begin
          (icv-nz-of-pos! c)
          (dk-have! (list 'AND (list 'IN c 'RR) (list 'NOT (list '= c 0))))
          (fact 'rr-recip-closed c)
          (fact 'rr-recip-pos c)
          (fact 'rr-recip-inverse c)))
    u))

;;; (<= 0 (* a b)), (IN (* a b) RR) from a, b real >= 0
(define (icv-mul-nonneg! a b)
  (let ((ab (list '* a b)))
    (icv-mul-rr! a b)
    (if (not (dk-asm? (list '<= 0 ab)))
        (dk-have! (list '<= 0 ab)
          (lambda ()
            (fact 'rr-zero-in)
            (fact 'rr-mul-le-right 0 a b)
            (fact 'rr-zero-mul b)
            (subst (list '= 0 (list '* 0 b)))
            (ass))))))

;;; rr-lt-div-of-lt-mul: al < f g, 0 < g  =>  al / g < f
(sp (make-wff
     '(FORALL al (IMPLIES (IN al RR) (FORALL f (IMPLIES (IN f RR) (FORALL g (IMPLIES (IN g RR)
        (IMPLIES (< 0 g) (IMPLIES (< al (* f g)) (< (* al (recip g)) f)))))))))))
(dk-peel!)
(let ((u (icv-recip-facts! 'g)))
  (icv-mul-rr! 'f 'g)
  (icv-scale! u 'al '(* f g))
  (dk-have! (list '= (list '* u '(* f g)) 'f)
    (lambda ()
      (dk-have! (list '= (list '* u '(* f g)) (list '* 'f (list '* 'g u))) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '* u '(* f g)) (list '* 'f (list '* 'g u))))
      (subst (list '= (list '* 'g u) 1))
      (crs)))
  (dk-have! (list '= (list '* 'al u) (list '* u 'al)) (lambda () (dk-crs-opaque!)))
  (subst (list '= (list '* 'al u) (list '* u 'al)))
  (subst (list '= 'f (list '* u '(* f g))))
  (ass))
(qed 'rr-lt-div-of-lt-mul)
(topic! 'rr-lt-div-of-lt-mul 'inequalities)

;;; rr-recip-swap-lt: al / g < q, 0 < g, 0 < q  =>  al / q < g
(sp (make-wff
     '(FORALL al (IMPLIES (IN al RR) (FORALL q (IMPLIES (IN q RR) (FORALL g (IMPLIES (IN g RR)
        (IMPLIES (< 0 g) (IMPLIES (< 0 q)
          (IMPLIES (< (* al (recip g)) q) (< (* al (recip q)) g))))))))))))
(dk-peel!)
(let* ((ug (icv-recip-facts! 'g))
       (uq (icv-recip-facts! 'q))
       (a  (list '* 'al ug))
       (gq (list '* 'g 'q)))
  (icv-mul-rr! 'al ug)
  (icv-mul-rr! 'g 'q)
  (icv-scale! 'g a 'q)
  (dk-have! (list '= (list '* 'g a) 'al)
    (lambda ()
      (dk-have! (list '= (list '* 'g a) (list '* 'al (list '* 'g ug))) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '* 'g a) (list '* 'al (list '* 'g ug))))
      (subst (list '= (list '* 'g ug) 1))
      (crs)))
  (dk-have! (list '< 'al gq)
    (lambda () (subst (list '= 'al (list '* 'g a))) (ass)))
  (icv-scale! uq 'al gq)
  (dk-have! (list '= (list '* uq gq) 'g)
    (lambda ()
      (dk-have! (list '= (list '* uq gq) (list '* 'g (list '* 'q uq))) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '* uq gq) (list '* 'g (list '* 'q uq))))
      (subst (list '= (list '* 'q uq) 1))
      (crs)))
  (dk-have! (list '= (list '* 'al uq) (list '* uq 'al)) (lambda () (dk-crs-opaque!)))
  (subst (list '= (list '* 'al uq) (list '* uq 'al)))
  (subst (list '= 'g (list '* uq gq)))
  (ass))
(qed 'rr-recip-swap-lt)
(topic! 'rr-recip-swap-lt 'inequalities)

;;; rr-lt-mul-of-grid: 0 <= al, 0 < q < f, al / q < g  =>  al < f g
(sp (make-wff
     '(FORALL al (IMPLIES (IN al RR) (FORALL q (IMPLIES (IN q RR)
        (FORALL f (IMPLIES (IN f RR) (FORALL g (IMPLIES (IN g RR)
          (IMPLIES (<= 0 al) (IMPLIES (< 0 q) (IMPLIES (< q f)
            (IMPLIES (< (* al (recip q)) g) (< al (* f g))))))))))))))))
(dk-peel!)
(let* ((uq (icv-recip-facts! 'q))
       (s  (list '* 'al uq)))
  (fact 'rr-lt-implies-le 0 uq)
  (icv-mul-nonneg! 'al uq)
  (dk-have! '(< 0 g) (lambda () (dk-ineq! (list 'IN s 'RR) '(IN g RR) (list '<= 0 s) (list '< s 'g))))
  (icv-scale! 'q s 'g)
  (dk-have! (list '= (list '* 'q s) 'al)
    (lambda ()
      (dk-have! (list '= (list '* 'q s) (list '* 'al (list '* 'q uq))) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '* 'q s) (list '* 'al (list '* 'q uq))))
      (subst (list '= (list '* 'q uq) 1))
      (crs)))
  (dk-have! '(< al (* q g)) (lambda () (subst (list '= 'al (list '* 'q s))) (ass)))
  (icv-scale! 'g 'q 'f)
  (icv-mul-rr! 'q 'g)
  (icv-mul-rr! 'f 'g)
  (dk-have! '(< (* q g) (* f g))
    (lambda ()
      (dk-have! '(= (* q g) (* g q)) (lambda () (crs)))
      (dk-have! '(= (* f g) (* g f)) (lambda () (crs)))
      (subst '(= (* q g) (* g q)))
      (subst '(= (* f g) (* g f)))
      (ass)))
  (dk-ineq! '(IN al RR) '(IN (* q g) RR) '(IN (* f g) RR) '(< al (* q g)) '(< (* q g) (* f g))))
(qed 'rr-lt-mul-of-grid)
(topic! 'rr-lt-mul-of-grid 'inequalities)
;;; (< 0 c) from (<= 0 c), (IN c RR) and (NOT (= c 0)).  (ibk-pos!)
(define (icv-pos! c)
  (if (not (dk-asm? (list '< 0 c)))
      (dk-have! (list '< 0 c)
        (lambda ()
          (mac '<)
          (icv-conj-close!
            (lambda ()
              (if (equal? (dk-goal) (list '<= 0 c))
                  (ass)
                  (begin
                    (di)
                    (fact 'equality-symmetry 0 c)
                    (icv-keep-prop! (list '= c 0) (list 'NOT (list '= c 0)))))))))))

;;; etimes(u, v) = u * v on the reals: land (= (etimes u v) (* u v)); u, v real >= 0
(define (icv-etimes-eq! u v)
  (let ((e (list '= (list 'etimes u v) (list '* u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'etimes-real-defined u v)
            (subst (list '= (list 'etimes u v) (list 'bintimes u v)))
            (fact 'bintimes-apply u v)
            (subst (list '== (list 'bintimes u v) (list '* u v)))
            (icv-mul-rr! u v)
            (rfl))))
    e))

;;; measurable-fn-etimes-cell
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (FORALL g (FORALL al (FORALL q
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (IMPLIES (IS-MEASURABLE-FN omega cA g)
            (IMPLIES (IN al RR)
              (IMPLIES (IN q RR)
                (IN (SEP x_ omega (AND (< 0 q) (AND (< q (f x_)) (< (* al (recip q)) (g x_)))))
                    cA)))))))))))))
(dk-peel!)
(let* ((pf (icv-mfn-parts! 'omega 'cA 'f))
       (pg (icv-mfn-parts! 'omega 'cA 'g))
       (sa (car pf))
       (cell '(SEP x_ omega (AND (< 0 q) (AND (< q (f x_)) (< (* al (recip q)) (g x_))))))
       (s  '(* al (recip q)))
       (ta '(SEP x_ omega (< q (f x_))))
       (tb (list 'SEP 'x_ 'omega (list '< s '(g x_))))
       (ii (list 'INTERSECTION ta tb)))
  (use-em '(< 0 q)
    (lambda ()
      (icv-recip-facts! 'q)
      (icv-mul-rr! 'al '(recip q))
      (dk-apply! (caddr pf) 'q)
      (dk-apply! (caddr pg) s)
      (fact 'sigma-algebra-inter-closed-2 'omega 'cA ta tb)
      (icv-set-eq! cell ii
        (lambda (w)
          (sep-me (list 'IN w cell))
          (dk-split-all!)
          (mac 'intersection-membership)
          (icv-conj-close! (lambda () (icv-sep-in! (lambda () (dk-ass!))))))
        (lambda (w)
          (mac-h 'intersection-membership (list 'IN w ii))
          (dk-split-all!)
          (sep-me (list 'IN w ta))
          (sep-me (list 'IN w tb))
          (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
      (subst (list '= cell ii))
      (ass))
    (lambda ()
      (fact 'sigma-algebra-empty-in 'omega 'cA)
      (icv-set-eq! cell 'EMPTY-SET
        (lambda (w)
          (sep-me (list 'IN w cell))
          (dk-split-all!)
          (icv-keep-prop! '(< 0 q) '(NOT (< 0 q))))
        (lambda (w)
          (fact 'empty-set-has-no-members w)
          (icv-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
      (subst (list '= cell 'EMPTY-SET))
      (ass))))
(qed 'measurable-fn-etimes-cell)
(topic! 'measurable-fn-etimes-cell 'analysis)

;;; measurable-fn-etimes-row
(define (icv-trow-body al r)
  (list 'FORSOME 'k_ (list 'AND '(IN k_ NN)
                           (list 'AND (list '< 0 (list '* 'k_ r))
                                 (list 'AND (list '< (list '* 'k_ r) '(f x_))
                                       (list '< (list '* al (list 'recip (list '* 'k_ r))) '(g x_)))))))
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (FORALL g (FORALL al (FORALL r
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (IMPLIES (IS-MEASURABLE-FN omega cA g)
            (IMPLIES (IN al RR)
              (IMPLIES (IN r RR)
                (IN (SEP x_ omega (FORSOME k_ (AND (IN k_ NN)
                                    (AND (< 0 (* k_ r))
                                      (AND (< (* k_ r) (f x_)) (< (* al (recip (* k_ r))) (g x_)))))))
                    cA)))))))))))))
(dk-peel!)
(let* ((row (list 'SEP 'x_ 'omega (icv-trow-body 'al 'r)))
       (body-of (lambda (k)
                  (let ((q (list '* k 'r)))
                    (list 'SEP 'x_ 'omega
                          (list 'AND (list '< 0 q)
                                (list 'AND (list '< q '(f x_)) (list '< (list '* 'al (list 'recip q)) '(g x_))))))))
       (inca! (lambda (k)
                (fact 'nn-in-rr k)
                (icv-mul-rr! k 'r)
                (fact 'measurable-fn-etimes-cell 'omega 'cA 'f 'g 'al (list '* k 'r))))
       (hve (icv-abstract! 'NN 'cA body-of
              (lambda (k) (inca! k) (ass))
              (lambda (k) (inca! k) (fact 'membership-implies-sethood (body-of k) 'cA))))
       (hf  (car hve))
       (ve  (cdr hve))
       (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
  (dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'IS-MEASURABLE-FN '(IS-MEASURABLE-FN omega cA f))
  (fact 'sigma-algebra-union-closed 'omega 'cA hf)
  (icv-set-eq! row bu
    (lambda (w)
      (sep-me (list 'IN w row))
      (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
             (k  (dk-skolem! ex)))
        (dk-apply! ve k)
        (dk-have! (list 'IN w (list hf k))
          (lambda ()
            (subst (list '== (list hf k) (body-of k)))
            (icv-sep-in! (lambda () (icv-conj-close! (lambda () (dk-ass!)))))))
        (for-each (lambda (l)
                    (if (not (sequent-node-grounded? l))
                        (begin (dk-focus! l) (ass))))
                  (dk-opened (lambda () (bu-mi k))))))
    (lambda (w)
      (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
             (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
             (k   (cadr nin)))
        (dk-apply! ve k)
        (dk-have! (list 'IN w (body-of k))
          (lambda () (subst (list '= (body-of k) (list hf k))) (ass)))
        (sep-me (list 'IN w (body-of k)))
        (dk-split-all!)
        (icv-sep-in!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (ew k)
                  (icv-conj-close! (lambda () (dk-ass!))))))))))
  (subst (list '= row bu))
  (ass))
(qed 'measurable-fn-etimes-row)
(topic! 'measurable-fn-etimes-row 'analysis)
;;; measurable-fn-etimes-of-values
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f (FORALL g (FORALL h
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (IMPLIES (IS-MEASURABLE-FN omega cA g)
            (IMPLIES (IN h (FUN omega RR-POS-STAR))
              (IMPLIES (FORALL x (IMPLIES (IN x omega) (= (h x) (etimes (f x) (g x)))))
                (IS-MEASURABLE-FN omega cA h))))))))))))
(dk-peel!)
(let* ((pf (icv-mfn-parts! 'omega 'cA 'f))
       (pg (icv-mfn-parts! 'omega 'cA 'g))
       (hv '(FORALL x (IMPLIES (IN x omega) (= (h x) (etimes (f x) (g x))))))
       (nt '(FORALL al_ (IMPLIES (IN al_ RR)
              (IMPLIES (<= 0 al_) (IN (SEP x_ omega (< al_ (h x_))) cA))))))
  (dk-have! nt
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal)))
             (al (cadr (cadddr tl)))
             (row-of (lambda (n) (list 'SEP 'x_ 'omega (icv-trow-body al (icv-recip n)))))
             (rfacts! (lambda (n)
                        (fact 'nn-recip-succ-pos n)
                        (fact 'rr-pos-rr-in-rr (icv-recip n))
                        (fact 'rr-lt-of-pos-rr (icv-recip n))))
             (inca! (lambda (n)
                      (rfacts! n)
                      (fact 'measurable-fn-etimes-row 'omega 'cA 'f 'g al (icv-recip n))))
             (hve (icv-abstract! 'NN 'cA row-of
                    (lambda (n) (inca! n) (ass))
                    (lambda (n) (inca! n) (fact 'membership-implies-sethood (row-of n) 'cA))))
             (hf  (car hve))
             (ve  (cdr hve))
             (bu  (list 'BIG-UNION 'n_ 'NN (list hf 'n_))))
        (icv-rps! al)
        (dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'IS-MEASURABLE-FN '(IS-MEASURABLE-FN omega cA f))
        (fact 'sigma-algebra-union-closed 'omega 'cA hf)
        (icv-set-eq! tl bu
          ;; alpha < f(w) g(w)  =>  w in some row
          (lambda (w)
            (let* ((fw (list 'f w)) (gw (list 'g w)) (e (list 'etimes fw gw)))
              (sep-me (list 'IN w tl))
              (dk-apply! hv w)
              (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
              (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR w)
              (dk-have! (list '< al e) (lambda () (subst (list '= e (list 'h w))) (ass)))
              (let ((finish!
                     ;; a, b real with 0 <= a < b; FCLOSE! proves (< q fw), GCLOSE! (< s gw)
                     (lambda (a b fclose! gclose!)
                       (let* ((ex (dk-fact! 'rr-grid-between a b))
                              (n  (dk-skolem! ex))
                              (ex2 (dk-pick (dk-head? 'forsome) "the grid numerator"))
                              (k  (dk-skolem! ex2))
                              (q  (icv-gq n k)))
                         (rfacts! n)
                         (fact 'nn-in-rr k)
                         (icv-mul-rr! k (icv-recip n))
                         (dk-have! (list '< 0 q)
                           (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN q 'RR) (list '<= 0 a) (list '< a q))))
                         (icv-recip-facts! q)
                         (icv-mul-rr! al (list 'recip q))
                         (dk-apply! ve n)
                         (dk-have! (list 'IN w (list hf n))
                           (lambda ()
                             (subst (list '== (list hf n) (row-of n)))
                             (icv-sep-in!
                               (lambda ()
                                 (if (dk-asm? (dk-goal))
                                     (ass)
                                     (begin
                                       (ew k)
                                       (icv-conj-close!
                                         (lambda ()
                                           (let ((g (dk-goal)))
                                             (cond ((dk-asm? g) (ass))
                                                   ((equal? (caddr g) fw) (fclose! q))
                                                   (#t (gclose! q))))))))))))
                         (for-each (lambda (l)
                                     (if (not (sequent-node-grounded? l))
                                         (begin (dk-focus! l) (ass))))
                                   (dk-opened (lambda () (bu-mi n)))))))
                    (nz! (lambda (t zero-eq)
                           ;; (NOT (= t 0)): else e = 0 by ZERO-EQ (a thunk landing (= e' 0))
                           (dk-have! (list 'NOT (list '= t 0))
                             (lambda ()
                               (di)
                               (dk-have! (list '< al 0)
                                 (lambda ()
                                   (zero-eq)
                                   (ass)))
                               (dk-absurd! (list 'IN al 'RR) (list '<= 0 al) (list '< al 0)))))))
                (icv-star-cases! fw
                  (lambda ()
                    (icv-star-cases! gw
                      (lambda ()
                        (icv-etimes-eq! fw gw)
                        (icv-mul-rr! fw gw)
                        (dk-have! (list '< al (list '* fw gw))
                          (lambda () (subst (list '= (list '* fw gw) e)) (ass)))
                        (nz! gw (lambda ()
                                  (fact 'rr-mul-zero fw)
                                  (subst (list '= 0 (list '* fw 0)))
                                  (subst (list '= 0 gw))))
                        (icv-pos! gw)
                        (let* ((ug (icv-recip-facts! gw))
                               (a  (list '* al ug)))
                          (fact 'rr-lt-implies-le 0 ug)
                          (icv-mul-nonneg! al ug)
                          (fact 'rr-lt-div-of-lt-mul al fw gw)
                          (finish! a fw
                            (lambda (q) (dk-ineq! (list 'IN q 'RR) (list 'IN a 'RR) (list 'IN fw 'RR)
                                                  (list '< q fw) (list '< a q) (list '< a fw)))
                            (lambda (q) (fact 'rr-recip-swap-lt al q gw) (ass)))))
                      (lambda ()
                        (nz! fw (lambda ()
                                  (fact 'etimes-zero-pos-inf)
                                  (subst (list '= 0 (list 'etimes 0 'POS-INF)))
                                  (subst (list '= 0 fw))
                                  (subst (list '= 'POS-INF gw))))
                        (icv-pos! fw)
                        (fact 'rr-zero-in)
                        (fact 'rr-leq-reflexive 0)
                        (finish! 0 fw
                          (lambda (q) (dk-ineq! (list 'IN q 'RR) (list 'IN fw 'RR) (list '< q fw)))
                          (lambda (q) (subst (list '= gw 'POS-INF)) (icv-lt-pos-inf! (list '* al (list 'recip q))))))))
                  (lambda ()
                    (icv-star-cases! gw
                      (lambda ()
                        (nz! gw (lambda ()
                                  (fact 'etimes-pos-inf-zero)
                                  (subst (list '= 0 (list 'etimes 'POS-INF 0)))
                                  (subst (list '= 0 gw))
                                  (subst (list '= 'POS-INF fw))))
                        (icv-pos! gw)
                        (let* ((ug (icv-recip-facts! gw))
                               (a  (list '* al ug))
                               (b  (list '+ a 1)))
                          (fact 'rr-lt-implies-le 0 ug)
                          (icv-mul-nonneg! al ug)
                          (fact 'rr-one-in)
                          (dk-have! (list 'AND (list 'IN a 'RR) '(IN 1 RR)))
                          (fact 'rr-add-closed a 1)
                          (dk-have! (list '< a b) (lambda () (dk-ineq! (list 'IN a 'RR))))
                          (finish! a b
                            (lambda (q) (subst (list '= fw 'POS-INF)) (icv-lt-pos-inf! q))
                            (lambda (q) (fact 'rr-recip-swap-lt al q gw) (ass)))))
                      (lambda ()
                        (fact 'rr-zero-in)
                        (fact 'rr-one-in)
                        (fact 'rr-leq-reflexive 0)
                        (dk-have! '(< 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
                        (finish! 0 1
                          (lambda (q) (subst (list '= fw 'POS-INF)) (icv-lt-pos-inf! q))
                          (lambda (q) (subst (list '= gw 'POS-INF)) (icv-lt-pos-inf! (list '* al (list 'recip q))))))))))))
          ;; w in some row  =>  alpha < f(w) g(w)
          (lambda (w)
            (let* ((fw (list 'f w)) (gw (list 'g w)) (hw (list 'h w))
                   (landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                   (n   (cadr nin)))
              (dk-apply! ve n)
              (dk-have! (list 'IN w (row-of n))
                (lambda () (subst (list '= (row-of n) (list hf n))) (ass)))
              (sep-me (list 'IN w (row-of n)))
              (let* ((ex (dk-pick (dk-head? 'forsome) "the grid index"))
                     (k  (dk-skolem! ex))
                     (q  (icv-gq n k))
                     (s  (list '* al (list 'recip q))))
                (rfacts! n)
                (fact 'nn-in-rr k)
                (icv-mul-rr! k (icv-recip n))
                (icv-recip-facts! q)
                (fact 'rr-lt-implies-le 0 (list 'recip q))
                (icv-mul-nonneg! al (list 'recip q))
                (dk-apply! hv w)
                (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR w)
                (dk-have! (list 'NOT (list '= gw 0))
                  (lambda ()
                    (di)
                    (dk-have! (list '< s 0) (lambda () (subst (list '= 0 gw)) (ass)))
                    (dk-absurd! (list 'IN s 'RR) (list '<= 0 s) (list '< s 0))))
                (icv-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin
                          (subst (list '= hw (list 'etimes fw gw)))
                          (icv-star-cases! fw
                            (lambda ()
                              (dk-have! (list 'NOT (list '= fw 0))
                                (lambda ()
                                  (di)
                                  (dk-have! (list '< q 0) (lambda () (subst (list '= 0 fw)) (ass)))
                                  (dk-absurd! (list 'IN q 'RR) (list '< 0 q) (list '< q 0))))
                              (icv-star-cases! gw
                                (lambda ()
                                  (icv-etimes-eq! fw gw)
                                  (subst (list '= (list 'etimes fw gw) (list '* fw gw)))
                                  (fact 'rr-lt-mul-of-grid al q fw gw)
                                  (ass))
                                (lambda ()
                                  (subst (list '= gw 'POS-INF))
                                  (fact 'etimes-pos-inf-right fw)
                                  (subst (list '= (list 'etimes fw 'POS-INF) 'POS-INF))
                                  (icv-lt-pos-inf! al))))
                            (lambda ()
                              (subst (list '= fw 'POS-INF))
                              (fact 'etimes-pos-inf-left gw)
                              (subst (list '= (list 'etimes 'POS-INF gw) 'POS-INF))
                              (icv-lt-pos-inf! al)))))))))))
        (subst (list '= tl bu))
        (ass))))
  (dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'IS-MEASURABLE-FN '(IS-MEASURABLE-FN omega cA f))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA 'h)
  (ass))
(qed 'measurable-fn-etimes-of-values)
(topic! 'measurable-fn-etimes-of-values 'analysis)

;;; measurable-fn-etimes -- statement copied from structure-library/integral.scm.
(sp (make-wff
  (forall-guarded '(omega cA f g)
                  '((IS-MEASURABLE-FN omega cA f) (IS-MEASURABLE-FN omega cA g))
    '(IS-MEASURABLE-FN omega cA (PTWISE-ETIMES omega f g)))))
(dk-peel!)
(let ((h '(PTWISE-ETIMES omega f g)))
  (icv-mfn-parts! 'omega 'cA 'f)
  (icv-mfn-parts! 'omega 'cA 'g)
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (let ((typed! (lambda (x)
                  (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
                  (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
                  (dk-have! (list 'AND (list 'IN (list 'f x) 'RR-POS-STAR) (list 'IN (list 'g x) 'RR-POS-STAR)))
                  (fact 'etimes-closed (list 'f x) (list 'g x)))))
    (dk-have! (list 'IN h '(FUN omega RR-POS-STAR))
      (lambda ()
        (mac 'PTWISE-ETIMES)
        (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (typed! x) (dk-ass!))))))
    (dk-have! '(FORALL x (IMPLIES (IN x omega) (= ((PTWISE-ETIMES omega f g) x) (etimes (f x) (g x)))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (typed! x)
          (mac 'PTWISE-ETIMES)
          (if (not (dk-lam-b!)) (rfl))))))
  (fact 'measurable-fn-etimes-of-values 'omega 'cA 'f 'g h)
  (ass))
