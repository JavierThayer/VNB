;;; =====================================================================
;;; (Q) NULL SETS AND DIFFERENCES.  Integrals are blind to a null set; the
;;;     difference u - v (v <= u, taken 0 where u = +inf) is measurable and,
;;;     when u has finite integral, INTEGRAL(u - v) + INTEGRAL(v) = INTEGRAL(u).
;;; =====================================================================

;;; FALSITY from linear premises, whatever the goal
(define (icv-absurd! . prems)
  (if (eq? (dk-goal) 'FALSITY)
      (apply dk-absurd! prems)
      (begin
        (dk-have! 'FALSITY (lambda () (apply dk-absurd! prems)))
        (icv-keep-prop! 'FALSITY))))

;;; integral-le-off-null: h1 <= h2 off a null set gives INTEGRAL(h1) <= INTEGRAL(h2)
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL nb (FORALL h1 (FORALL h2
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IN nb cA)
            (IMPLIES (= (mu nb) 0)
              (IMPLIES (IS-MEASURABLE-FN omega cA h1)
                (IMPLIES (IS-MEASURABLE-FN omega cA h2)
                  (IMPLIES (FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x nb)) (<= (h1 x) (h2 x)))))
                    (<= (INTEGRAL omega cA mu h1) (INTEGRAL omega cA mu h2))))))))))))))))
(dk-peel!)
(icv-parts! 'IS-MEASURE '(omega cA mu))
(icv-parts! 'IS-SIGMA-ALGEBRA '(omega cA))
(icv-mfn-parts! 'omega 'cA 'h1)
(icv-mfn-parts! 'omega 'cA 'h2)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(let* ((ind '(INDICATOR omega nb))
       (mi (list 'PTWISE-SCALE 'omega 'POS-INF ind))
       (kk (list 'PTWISE-EPLUS 'omega 'h2 mi))
       (hle '(FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x nb)) (<= (h1 x) (h2 x))))))
       (mi-in! (lambda (x)
                 (fact 'pos-inf-in-rr-pos-star)
                 (fact 'indicator-value-in 'omega 'nb x)
                 (fact 'rr-one-in)
                 (dk-have! '(<= 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
                 (icv-rps! 1)
                 (dk-have! '(< 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
                 (icv-nz-of-pos! 1)
                 (fact 'etimes-pos-inf-left 1)
                 (dk-have! (list '= (list mi x) 'POS-INF)
                   (lambda ()
                     (mac 'PTWISE-SCALE)
                     (if (dk--redex? (dk-goal)) (dk-lam-b!))
                     (subst (list '= (list ind x) 1))
                     (dk-ass!)))))
       (mi-out! (lambda (x)
                  (fact 'indicator-value-out 'omega 'nb x)
                  (fact 'etimes-pos-inf-zero)
                  (dk-have! (list '= (list mi x) 0)
                    (lambda ()
                      (mac 'PTWISE-SCALE)
                      (if (dk--redex? (dk-goal)) (dk-lam-b!))
                      (subst (list '= (list ind x) 0))
                      (dk-ass!))))))
  (fact 'measurable-fn-indicator 'omega 'cA 'nb)
  (icv-mfn-parts! 'omega 'cA ind)
  ;; mi is measurable: its tails at alpha >= 0 are nb
  (dk-have! (list 'IN mi '(FUN omega RR-POS-STAR))
    (lambda ()
      (mac 'PTWISE-SCALE)
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (fact 'pos-inf-in-rr-pos-star)
            (fact 'fun-apply-type-c ind 'omega 'RR-POS-STAR x)
            (dk-have! (list 'AND '(IN POS-INF RR-POS-STAR) (list 'IN (list ind x) 'RR-POS-STAR)))
            (fact 'etimes-closed 'POS-INF (list ind x))
            (dk-ass!))))))
  (dk-have! (list 'FORALL 'al_ (list 'IMPLIES '(IN al_ RR) (list 'IMPLIES '(<= 0 al_)
              (list 'IN (list 'SEP 'x_ 'omega (list '< 'al_ (list mi 'x_))) 'cA))))
    (lambda ()
      (dk-peel!)
      (let* ((tl (cadr (dk-goal))) (al (cadr (cadddr tl))))
        (icv-set-eq! tl 'nb
          (lambda (w)
            (sep-me (list 'IN w tl))
            (use-em (list 'IN w 'nb)
              (lambda () (dk-ass!))
              (lambda ()
                (mi-out! w)
                (dk-have! (list '< al 0) (lambda () (subst (list '= 0 (list mi w))) (dk-ass!)))
                (icv-absurd! (list 'IN al 'RR) (list '<= 0 al) (list '< al 0)))))
          (lambda (w)
            (fact 'subset-mem-fwd 'cA '(POWER omega) 'nb)
            (fact 'power-mem-in 'omega 'nb w)
            (mi-in! w)
            (icv-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (begin (subst (list '= (list mi w) 'POS-INF)) (icv-lt-pos-inf! al)))))))
        (subst (list '= tl 'nb))
        (dk-ass!))))
  (fact 'measurable-fn-of-nonneg-tails 'omega 'cA mi)
  (fact 'measurable-fn-eplus 'omega 'cA 'h2 mi)
  (icv-iff-parts! 'IS-MEASURABLE-FN (list 'omega 'cA kk))
  ;; h1 <= h2 + mi everywhere
  (dk-have! (list 'PTWISE-LE 'omega 'h1 kk)
    (lambda ()
      (mac 'PTWISE-LE)
      (let* ((x (dk-di-var!)) (h1x (list 'h1 x)) (h2x (list 'h2 x)))
