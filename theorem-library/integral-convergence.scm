             (w (list 'PTWISE-EPLUS 'omega cf 'v))
             (lt (list 'SEP 'x_ 'omega (list '< (list w 'x_) '(u x_))))
             (ii (list 'INTERSECTION fs lt))
             (w-at! (lambda (x)     ; (= (w x) (+ al (v x))), v(x) real
                      (let ((vx (list 'v x)))
                        (fact 'rr-pos-star-nonneg vx)
                        (icv-eplus-eq! al vx)
                        (fact 'rr-add-closed al vx)
                        (dk-have! (list 'AND (list 'IN al 'RR) (list 'IN vx 'RR)))
                        (fact 'rr-add-closed al vx)
                        (dk-have! (list '= (list w x) (list '+ al vx))
                          (lambda ()
                            (mac 'PTWISE-EPLUS)
                            (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop))))
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                (begin (subst (list '= (list 'eplus al vx) (list '+ al vx))) (rfl)))))))))
        (icv-rps! al)
        (fact 'measurable-fn-const 'omega 'cA al)
        (fact 'measurable-fn-eplus 'omega 'cA cf 'v)
        (fact 'measurable-fn-lt-set 'omega 'cA 'u w)
        (fact 'sigma-algebra-inter-closed-2 'omega 'cA fs lt)
        (icv-set-eq! tl ii
          (lambda (x)
