        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA u)
            (IMPLIES (IS-MEASURABLE-FN omega cA v)
              (IMPLIES (FORALL x (IMPLIES (IN x omega) (<= (v x) (u x))))
                (IMPLIES (IN (INTEGRAL omega cA mu u) RR)
                  (= (eplus (INTEGRAL omega cA mu
                              (VNB-LAMBDA dx_ omega (IF (IN (u dx_) RR) (- (u dx_) (v dx_)) 0)))
                            (INTEGRAL omega cA mu v))
                     (INTEGRAL omega cA mu u))))))))))))))
