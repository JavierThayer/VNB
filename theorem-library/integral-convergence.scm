;;; the difference u - v, 0 where u is infinite
(define (icv-dif uf vf) (list 'VNB-LAMBDA 'dx_ 'omega
                              (list 'IF (list 'IN (list uf 'dx_) 'RR) (list '- (list uf 'dx_) (list vf 'dx_)) 0)))
(define (icv-dif-if uf vf x) (list 'IF (list 'IN (list uf x) 'RR) (list '- (list uf x) (list vf x)) 0))

;;; difference-value: the value of the difference function at a point
(sp (make-wff
     '(FORALL omega (FORALL u (FORALL v (FORALL x (IMPLIES (IN x omega)
        (== ((VNB-LAMBDA dx_ omega (IF (IN (u dx_) RR) (- (u dx_) (v dx_)) 0)) x)
            (IF (IN (u x) RR) (- (u x) (v x)) 0)))))))))
(dk-peel!)
(if (not (dk-lam-b!)) (qrfl))
