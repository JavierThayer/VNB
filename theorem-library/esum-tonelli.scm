;;; Library: measure.

;;; ====================================================================
;;; th3b-esum.scm -- TH3-B, 2026-11-09.  Unordered sums in [0,+inf] over an
;;; ARBITRARY index set: monotonicity, superadditivity, a finite sum of sums,
;;; and the interchange of a double sum (Tonelli for ESUM).
;;;
;;; THE THEOREMS (every one `modulo 0'):
;;;   esum-le-ptwise          f <= g on D                      ==> ESUM f <= ESUM g
;;;   esum-superadditive      eplus(f z, g z) <= h z on D      ==> ESUM f + ESUM g <= ESUM h
;;;   esum-finsum-le          g : I -> (J -> [0,+inf]), gt its transpose, a(i) = ESUM(g i):
;;;                           for finite s <= I, FINSUM_s a <= ESUM_j FINSUM_s (gt j)
;;;   esum-swap-le            ESUM a <= ESUM b, b(j) = ESUM(gt j)
;;;   esum-swap               ESUM a = ESUM b        (the double sum may be summed in
;;;                                                   either order)
;;;   esum-subadditive        h z <= eplus(f z, g z) on D      ==> ESUM h <= ESUM f + ESUM g
;;; The double family is given CURRIED, g in FUN(I, FUN(J, RR-POS-STAR)), with its
;;; transpose gt in FUN(J, FUN(I, RR-POS-STAR)) and the iterated sums a, b given by
;;; their pointwise equations, so that no statement holds a lambda: a user builds
;;; the lambdas once and proves the pointwise equations by lam-b.
;;;
;;; THE ROUTE.  ESUM(f) is the ESUP of the finite partial sums (extended-sum.scm);
;;; everything goes through esum-upper / esum-least.  Superadditivity is the general-
;;; index form of esum-nn-superadditive (metric-outer-measure.scm): two finite sets S, T
;;; are replaced by their union, and the sup is taken in each variable in turn by real
;;; subtraction when ESUM h is real.  esum-finsum-le is a finite-set induction over the
;;; subsets of I, the step being superadditivity.  esum-swap-le: a finite partial sum of a
;;; is <= ESUM_j FINSUM_s (gt j) <= ESUM_j ESUM_i (gt j) i by monotonicity.
;;;
;;; LOAD WINDOW: after "theorem-library/outer-measure-construction" (load.scm 3766, for
;;; rps-finsum-le-ptwise's neighbours; the latest citation), integral-laws (3588:
;;; rps-finsum-le-ptwise, finsum-cm-add-ptwise), measure-laws (3587: rps-finsum-mono-set),
;;; rr-pos-star-order-lemmas (3758); rake-esum-defined (1374).  Library: measure (it
;;; cites measure-library files; the operator-algebras library imports measure).
;;; ====================================================================

(define tbe-m 'RR-POS-STAR-ADD-MONOID)
(define (tbe-fs f s) (list 'FINSUM tbe-m f s))
(define tbe-fin-guard
  (lambda (s dd) (list 'AND (list 'IN s 'SET) (list 'AND (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s dd)))))

(define (tbe-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))

(define (tbe-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))

(define (tbe-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))

;;; f in FUN(dd, RR-POS-STAR) in context: land (IN dd SET), (= (DOM f) dd) and
;;; (IN f (FUN (DOM f) RR-POS-STAR)), and ESUM f in RR-POS-STAR
(define (tbe-dom! f dd)
  (let ((ty (list 'IN f (list 'FUN dd 'RR-POS-STAR))))
    (if (not (dk-asm? (list 'IN dd 'SET)))
        (fact 'fun-domain-in-set dd 'RR-POS-STAR f))
    (if (not (dk-asm? (list '= (list 'DOM f) dd)))
        (begin
          (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff ty)
          (tbe-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
          (fact 'dom-of-fun dd f)
          (let ((dd2 (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
            (if dd2 (dk-split-all! (list dd2))))))
    (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) 'RR-POS-STAR))))
        (dk-have! (list 'IN f (list 'FUN (list 'DOM f) 'RR-POS-STAR))
          (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
    (if (not (dk-asm? (list 'IN (list 'ESUM f) 'RR-POS-STAR)))
        (fact 'esum-in f))))

;;; the partial-sum bound esum-least wants for F and B
(define (tbe-bound f b)
  (list 'FORALL 'tbs_ (list 'IMPLIES (tbe-fin-guard 'tbs_ (list 'DOM f)) (list '<= (tbe-fs f 'tbs_) b))))

;;; forall z_ in sv. (f z_) in RR-POS-STAR, from f in FUN(dd, RPS) and sv subset dd
(define (tbe-ptype! f dd sv)
  (let ((cl (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) (list 'IN (list f 'z_) 'RR-POS-STAR)))))
    (if (not (dk-asm? cl))
        (dk-have! cl
          (lambda ()
            (let ((zv (dk-di-var!)))
              (fact 'subset-mem-fwd sv dd zv)
              (fact 'fun-apply-type-c f dd 'RR-POS-STAR zv)
              (ass)))))
    cl))

;;; with sv finite, sv subset dd, f in FUN(dd, RPS) (tbe-dom! done): land the
;;; partial sum's typing and FINSUM f sv <= ESUM f
(define (tbe-partial! f dd sv)
  (if (not (dk-asm? (list 'SUBSET sv (list 'DOM f))))
      (dk-have! (list 'SUBSET sv (list 'DOM f)) (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (tbe-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN) (list 'SUBSET sv (list 'DOM f)))
  (if (not (dk-asm? (list 'IN (tbe-fs f sv) 'RR-POS-STAR))) (tbe-cite! 'esum-partial-sum-type f sv))
  (if (not (dk-asm? (list '<= (tbe-fs f sv) (list 'ESUM f)))) (tbe-cite! 'esum-upper f sv)))

;;; peel the finite-set guard of a bound; return the set variable, with
;;; (SUBSET sv dd) in context
(define (tbe-peel-set! f dd)
  (dk-peel!)
  (dk-split-all!)
  (let ((sv (cadddr (cadr (dk-goal)))))
    (if (and (not (dk-asm? (list 'SUBSET sv dd))) (dk-asm? (list 'SUBSET sv (list 'DOM f))))
        (dk-rewrite-h! (list 'SUBSET sv (list 'DOM f)) (list 'DOM f) dd))
    sv))

(define (tbe-trans! x y z)
  (if (not (dk-asm? (list '<= x z)))
      (begin
        (tbe-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
        (tbe-and! (list '<= x y) (list '<= y z))
        (fact 'rr-pos-star-le-trans x y z)))
  (list '<= x z))

(define (tbe-ep! x y)
  (let ((e (list 'eplus x y)))
    (if (not (dk-asm? (list 'IN e 'RR-POS-STAR)))
        (begin (tbe-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
               (fact 'eplus-closed x y)))
    e))

;;; ====================================================================
;;; esum-le-ptwise
;;; ====================================================================
(sp (make-wff '(FORALL dd (FORALL f (FORALL g
  (IMPLIES (IN f (FUN dd RR-POS-STAR))
  (IMPLIES (IN g (FUN dd RR-POS-STAR))
  (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (<= (f z_) (g z_))))
    (<= (ESUM f) (ESUM g))))))))))
(dk-peel!)
(tbe-dom! 'f 'dd)
(tbe-dom! 'g 'dd)
(let ((eg '(ESUM g))
      (hyp '(FORALL z_ (IMPLIES (IN z_ dd) (<= (f z_) (g z_))))))
  (dk-have! (tbe-bound 'f eg)
    (lambda ()
      (let ((sv (tbe-peel-set! 'f 'dd)))
        (tbe-partial! 'f 'dd sv)
        (tbe-partial! 'g 'dd sv)
        (tbe-ptype! 'f 'dd sv)
        (tbe-ptype! 'g 'dd sv)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) '(<= (f z_) (g z_))))
          (lambda ()
            (let ((zv (dk-di-var!)))
              (fact 'subset-mem-fwd sv 'dd zv)
              (dk-apply! hyp zv)
              (if (tbe-open?) (ass)))))
        (tbe-cite! 'rps-finsum-le-ptwise sv 'f 'g)
        (tbe-trans! (tbe-fs 'f sv) (tbe-fs 'g sv) eg)
        (ass))))
  (tbe-and! (list 'IN eg 'RR-POS-STAR) (tbe-bound 'f eg))
  (tbe-cite! 'esum-least 'f eg)
  (ass))
(qed 'esum-le-ptwise)
(topic! 'esum-le-ptwise 'analysis)

;;; ====================================================================
;;; esum-superadditive
;;; ====================================================================
;;; x in RR-POS-STAR, x <= hh, hh in RR: x in RR and 0 <= x
(define (tbe-real-le! x hh)
  (if (not (dk-asm? (list 'IN x 'RR)))
      (begin
        (tbe-and! (list 'IN x 'RR-POS-STAR) (list 'IN hh 'RR))
        (fact 'rr-pos-star-le-real-in-rr x hh)))
  (if (not (dk-asm? (list '<= 0 x))) (fact 'rr-pos-star-nonneg x)))
(define (tbe-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-cite! 'rr-pos-star-membership x)))
            (dk-only! inst (list 'IN x 'RR) (list '<= 0 x))
            (prop))))))
;;; FINSUM f EMPTY-SET = 0
(define (tbe-empty0! f)
  (let ((e (list '= (tbe-fs f 'EMPTY-SET) 0)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (let* ((a (dk-cite! 'finsum-empty tbe-m f))
                  (b (dk-cite! 'rr-pos-star-add-monoid@iden)))
              (subst a) (subst b) (if (tbe-open?) (rfl))))))
    e))
;;; the empty set as a finite subset of dd
(define (tbe-empty-fin! dd)
  (fact 'empty-set-is-set)
  (fact 'card-empty)
  (fact 'nn-zero-in)
  (dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (ass)))
  (fact 'empty-subset-any dd))

(sp (make-wff '(FORALL dd (FORALL f (FORALL g (FORALL h
  (IMPLIES (IN f (FUN dd RR-POS-STAR))
  (IMPLIES (IN g (FUN dd RR-POS-STAR))
  (IMPLIES (IN h (FUN dd RR-POS-STAR))
  (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (<= (eplus (f z_) (g z_)) (h z_))))
    (<= (eplus (ESUM f) (ESUM g)) (ESUM h))))))))))))
(dk-peel!)
(tbe-dom! 'f 'dd)
(tbe-dom! 'g 'dd)
(tbe-dom! 'h 'dd)
(tbe-ep! '(ESUM f) '(ESUM g))
(fact 'rr-pos-star-is-comm-monoid)
(let* ((hyp '(FORALL z_ (IMPLIES (IN z_ dd) (<= (eplus (f z_) (g z_)) (h z_)))))
       (kl '(VNB-LAMBDA tbk_ dd (eplus (f tbk_) (g tbk_))))
       (memb (dk-cite! 'rr-pos-star-membership '(ESUM h)))
       (disj (begin (ai memb) (detach! (list 'IMPLIES (cadr memb) (caddr memb))) (caddr memb))))
  (dk-each-leaf! (lambda () (ai disj))
    (lambda ()
      (if (dk-asm? '(= (ESUM h) POS-INF))
          (begin
            (fact 'rr-pos-star-below-pos-inf '(eplus (ESUM f) (ESUM g)))
            (dk-rewrite-h! '(<= (eplus (ESUM f) (ESUM g)) POS-INF) 'POS-INF '(ESUM h))
            (if (tbe-open?) (dk-ass!)))
          (let ((hh '(ESUM h)))
            (dk-split-all!)
            ;; k = f + g pointwise, a function on dd
            (dk-have! (list 'IN kl '(FUN dd RR-POS-STAR))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((kv (dk-di-var!)))
                      (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR kv)
                      (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR kv)
                      (tbe-ep! (list 'f kv) (list 'g kv))
                      (ass)))
                  (lambda () (ass)))))
            ;; S1: P_s(f) + P_t(g) <= H for finite s, t inside dd
            (dk-have! (list 'FORALL 's (list 'IMPLIES (tbe-fin-guard 's 'dd)
                        (list 'FORALL 't (list 'IMPLIES (tbe-fin-guard 't 'dd)
                          (list '<= (list 'eplus (tbe-fs 'f 's) (tbe-fs 'g 't)) hh)))))
              (lambda ()
                (dk-peel!)
                (dk-split-all!)
                (let* ((g0 (dk-goal))
                       (sv (cadddr (cadr (cadr g0))))
                       (tv (cadddr (caddr (cadr g0))))
                       (uv (list 'UNION sv tv)))
                  (tbe-and! (list 'IN sv 'SET) (list 'IN tv 'SET))
                  (fact 'union-set-closure sv tv)
                  (fact 'card-union-nn sv tv)
                  (fact 'union-subset-both sv tv 'dd)
                  (fact 'union-right-subset sv tv)
                  (fact 'union-right-subset tv sv)
                  (fact 'union-comm tv sv)
                  (dk-rewrite-h! (list 'SUBSET sv (list 'UNION tv sv)) (list 'UNION tv sv) uv)
                  (for-each (lambda (fv) (tbe-ptype! fv 'dd uv)) '(f g h))
                  (tbe-ptype! kl 'dd uv)
                  (for-each (lambda (fv sx) (tbe-partial! fv 'dd sx)) (list 'f 'g 'f 'g 'h) (list sv tv uv uv uv))
                  (tbe-cite! 'rps-finsum-mono-set 'f sv uv)
                  (tbe-cite! 'rps-finsum-mono-set 'g tv uv)
                  (tbe-and! (list 'IN (tbe-fs 'f sv) 'RR-POS-STAR) (list 'IN (tbe-fs 'g tv) 'RR-POS-STAR)
                            (list 'IN (tbe-fs 'f uv) 'RR-POS-STAR) (list 'IN (tbe-fs 'g uv) 'RR-POS-STAR))
                  (tbe-and! (list '<= (tbe-fs 'f sv) (tbe-fs 'f uv)) (list '<= (tbe-fs 'g tv) (tbe-fs 'g uv)))
                  (fact 'eplus-mono (tbe-fs 'f sv) (tbe-fs 'g tv) (tbe-fs 'f uv) (tbe-fs 'g uv))
                  ;; FINSUM k u = FINSUM f u + FINSUM g u
                  (let* ((carr (dk-cite! 'rr-pos-star-add-monoid@carr))
                        (opr (dk-cite! 'rr-pos-star-add-monoid@opr)))
                    (for-each
                      (lambda (fv)
                        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ uv) (list 'IN (list fv 'z_) (list 'CARR tbe-m))))
                          (lambda ()
                            (subst carr)
                            (if (tbe-open?) (ass)))))
                      '(f g))
                    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ uv)
                                (list '= (list kl 'z_) (list (list 'OPR tbe-m) '(f z_) '(g z_)))))
                      (lambda ()
                        (let ((zv (dk-di-var!)))
                          (subst opr)
                          (fact 'subset-mem-fwd uv 'dd zv)
                          (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR zv)
                          (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR zv)
                          (tbe-ep! (list 'f zv) (list 'g zv))
                          (if (not (dk-lam-b!)) (rfl)))))
                    (let* ((ad (tbe-cite! 'finsum-cm-add-ptwise tbe-m uv 'f 'g kl))
                           (ad2 (dk-rewrite-h! ad (list 'OPR tbe-m) 'eplus)))
                      ;; FINSUM k u <= FINSUM h u
                      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ uv) (list '<= (list kl 'z_) '(h z_))))
                        (lambda ()
                          (let ((zv (dk-di-var!)))
                            (fact 'subset-mem-fwd uv 'dd zv)
                            (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR zv)
                            (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR zv)
                            (tbe-ep! (list 'f zv) (list 'g zv))
                            (dk-lam-b!)
                            (if (tbe-open?) (dk-apply! hyp zv))
                            (if (tbe-open?) (ass)))))
                      (tbe-cite! 'rps-finsum-le-ptwise uv kl 'h)
                      (let* ((s1 (tbe-ep! (tbe-fs 'f sv) (tbe-fs 'g tv)))
                             (s2 (tbe-ep! (tbe-fs 'f uv) (tbe-fs 'g uv)))
                             (ku (tbe-fs kl uv)))
                        (if (not (dk-asm? (list 'IN ku 'RR-POS-STAR)))
                            (dk-have! (list 'IN ku 'RR-POS-STAR)
                              (lambda () (subst (list '= ku s2)) (ass))))
                        (dk-rewrite-h! (list '<= s1 s2) s2 ku)
                        (tbe-trans! s1 ku (tbe-fs 'h uv))
                        (tbe-trans! s1 (tbe-fs 'h uv) hh)
                        (ass)))))))
            (let ((s1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f hh)
                                               (dk-contains? f '(FINSUM RR-POS-STAR-ADD-MONOID g t))))
                               "S1")))
              (tbe-empty-fin! 'dd)
              (tbe-empty0! 'f)
              (tbe-empty0! 'g)
              ;; S2: ESUM g <= H - P_s(f)
              (dk-have! (list 'FORALL 's (list 'IMPLIES (tbe-fin-guard 's 'dd)
                          (list '<= '(ESUM g) (list '- hh (tbe-fs 'f 's)))))
                (lambda ()
                  (dk-peel!)
                  (dk-split-all!)
                  (let* ((sv (cadddr (caddr (caddr (dk-goal)))))
                         (pn (tbe-fs 'f sv)))
                    (tbe-partial! 'f 'dd sv)
                    (tbe-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN) (list 'SUBSET sv 'dd))
                    (tbe-and! '(IN EMPTY-SET SET) '(IN (CARD EMPTY-SET) NN) '(SUBSET EMPTY-SET dd))
                    (let ((z (dk-apply! s1 sv 'EMPTY-SET)))
                      (dk-rewrite-h! z (tbe-fs 'g 'EMPTY-SET) 0)
                      (fact 'eplus-zero-right pn)
                      (dk-rewrite-h! (list '<= (list 'eplus pn 0) hh) (list 'eplus pn 0) pn))
                    (tbe-real-le! pn hh)
                    (dk-have! (list 'IN (list '- hh pn) 'RR) (lambda () (type-term)))
                    (dk-have! (list '<= 0 (list '- hh pn)) (lambda () (dk-ineq! (list '<= pn hh) (list 'IN pn 'RR) (list 'IN hh 'RR))))
                    (tbe-rps-of-real! (list '- hh pn))
                    (dk-have! (tbe-bound 'g (list '- hh pn))
                      (lambda ()
                        (let* ((tv (tbe-peel-set! 'g 'dd)) (pm (tbe-fs 'g tv)))
                          (tbe-partial! 'g 'dd tv)
                          (tbe-and! (list 'IN tv 'SET) (list 'IN (list 'CARD tv) 'NN) (list 'SUBSET tv 'dd))
                          (let* ((part (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f pn)
                                                                 (dk-contains? f hh))) "s1 at s"))
                                 (le (dk-apply! part tv)))
                            (tbe-and! (list 'IN pm 'RR-POS-STAR) (list 'IN pn 'RR-POS-STAR))
                            (fact 'eplus-le-left pm pn)
                            (tbe-ep! pm pn)
                            (tbe-and! (list 'IN pn 'RR-POS-STAR) (list 'IN pm 'RR-POS-STAR))
                            (fact 'eplus-comm pm pn)
                            (dk-rewrite-h! (list '<= pm (list 'eplus pm pn)) (list 'eplus pm pn) (list 'eplus pn pm))
                            (tbe-ep! pn pm)
                            (tbe-trans! pm (list 'eplus pn pm) hh)
                            (tbe-real-le! pm hh)
                            (let* ((e (dk-cite! 'eplus-real-defined pn pm))
                                   (le1 (dk-rewrite-h! le (cadr e) (caddr e)))
                                   (bp (dk-cite! 'binplus-apply pn pm))
                                   (le2 (dk-rewrite-h! le1 (cadr bp) (caddr bp))))
                              (dk-ineq! le2 (list 'IN pn 'RR) (list 'IN pm 'RR) (list 'IN hh 'RR)))))))
                    (tbe-and! (list 'IN (list '- hh pn) 'RR-POS-STAR) (tbe-bound 'g (list '- hh pn)))
                    (tbe-cite! 'esum-least 'g (list '- hh pn))
                    (if (tbe-open?) (ass)))))
              (let ((s2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(ESUM g)) (dk-contains? f hh))) "S2")))
                (tbe-and! '(IN EMPTY-SET SET) '(IN (CARD EMPTY-SET) NN) '(SUBSET EMPTY-SET dd))
                (let ((z (dk-apply! s2 'EMPTY-SET)))
                  (dk-rewrite-h! z (tbe-fs 'f 'EMPTY-SET) 0))
                (dk-have! (list 'IN (list '- hh 0) 'RR) (lambda () (type-term)))
                (tbe-real-le! '(ESUM g) (list '- hh 0))
                (dk-have! (tbe-bound 'f (list '- hh '(ESUM g)))
                  (lambda ()
                    (let* ((sv (tbe-peel-set! 'f 'dd)) (pn (tbe-fs 'f sv)))
                      (tbe-partial! 'f 'dd sv)
                      (tbe-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN) (list 'SUBSET sv 'dd))
                      (let ((z (dk-apply! s2 sv)))
                        (tbe-and! '(IN EMPTY-SET SET) '(IN (CARD EMPTY-SET) NN) '(SUBSET EMPTY-SET dd))
                        (let ((z0 (dk-apply! s1 sv 'EMPTY-SET)))
                          (dk-rewrite-h! z0 (tbe-fs 'g 'EMPTY-SET) 0)
                          (fact 'eplus-zero-right pn)
                          (dk-rewrite-h! (list '<= (list 'eplus pn 0) hh) (list 'eplus pn 0) pn))
                        (tbe-real-le! pn hh)
                        (dk-ineq! z (list 'IN pn 'RR) (list 'IN hh 'RR) '(IN (ESUM g) RR))))))
                (dk-have! (list 'IN (list '- hh '(ESUM g)) 'RR) (lambda () (type-term)))
                (dk-have! (list '<= 0 (list '- hh '(ESUM g)))
                  (lambda () (dk-ineq! (list '<= '(ESUM g) (list '- hh 0)) (list 'IN hh 'RR) '(IN (ESUM g) RR))))
                (tbe-rps-of-real! (list '- hh '(ESUM g)))
                (tbe-and! (list 'IN (list '- hh '(ESUM g)) 'RR-POS-STAR) (tbe-bound 'f (list '- hh '(ESUM g))))
                (tbe-cite! 'esum-least 'f (list '- hh '(ESUM g)))
                (tbe-real-le! '(ESUM f) (list '- hh '(ESUM g)))
                (let ((e (dk-cite! 'eplus-real-defined '(ESUM f) '(ESUM g))))
                  (subst e)
                  (subst (dk-cite! 'binplus-apply '(ESUM f) '(ESUM g)))
                  (dk-ineq! (list '<= '(ESUM f) (list '- hh '(ESUM g))) '(IN (ESUM f) RR) '(IN (ESUM g) RR) (list 'IN hh 'RR))))))))))
(qed 'esum-superadditive)
(topic! 'esum-superadditive 'analysis)

;;; ====================================================================
;;; esum-finsum-le: a finite sum of sums is at most the sum of the finite sums
;;; ====================================================================
(define (tbe-K s) (list 'VNB-LAMBDA 'tbj_ 'jx (list 'FINSUM tbe-m '(gt tbj_) s)))
(define tbe-tr '(FORALL i_ (IMPLIES (IN i_ ix) (FORALL j_ (IMPLIES (IN j_ jx) (= ((gt j_) i_) ((g i_) j_)))))))
(define tbe-ah '(FORALL i_ (IMPLIES (IN i_ ix) (= (a i_) (ESUM (g i_))))))
;;; with s finite, s subset ix in context: K_s in FUN(jx, RPS)
(define (tbe-K-type! s)
  (let ((ty (list 'IN (tbe-K s) '(FUN jx RR-POS-STAR))))
    (if (not (dk-asm? ty))
        (dk-have! ty
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((jv (dk-di-var!)))
                  (fact 'fun-apply-type-c 'gt 'jx '(FUN ix RR-POS-STAR) jv)
                  (tbe-dom! (list 'gt jv) 'ix)
                  (tbe-partial! (list 'gt jv) 'ix s)
                  (ass)))
              (lambda () (ass))))))
    ty))
(define tbe-cls-body
  (lambda (w) (list 'IMPLIES (list 'SUBSET w 'ix)
                (list '<= (tbe-fs 'a w) (list 'ESUM (tbe-K w))))))
(define tbe-cls (list 'COMP 'tbw_ (tbe-cls-body 'tbw_)))

(sp (make-wff (list 'FORALL 'ix (list 'FORALL 'jx (list 'FORALL 'g (list 'FORALL 'gt (list 'FORALL 'a
  (list 'IMPLIES '(IN g (FUN ix (FUN jx RR-POS-STAR)))
  (list 'IMPLIES '(IN gt (FUN jx (FUN ix RR-POS-STAR)))
  (list 'IMPLIES tbe-tr
  (list 'IMPLIES '(IN a (FUN ix RR-POS-STAR))
  (list 'IMPLIES tbe-ah
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ SET) (list 'IMPLIES '(IN (CARD s_) NN) (list 'IMPLIES '(SUBSET s_ ix)
    (list '<= (tbe-fs 'a 's_) (list 'ESUM (tbe-K 's_)))))))))))))))))))
(define tbe-s0 #f)
(dk-peel!)
(set! tbe-s0 (cadddr (cadr (dk-goal))))
(fact 'fun-domain-in-set 'jx '(FUN ix RR-POS-STAR) 'gt)
(fact 'fun-domain-in-set 'ix '(FUN jx RR-POS-STAR) 'g)
(fact 'rr-pos-star-is-comm-monoid)
(tbe-dom! 'a 'ix)
(let* ((carr (dk-cite! 'rr-pos-star-add-monoid@carr))
       (opr (dk-cite! 'rr-pos-star-add-monoid@opr)))
  ;; base
  (dk-have! (list 'IN 'EMPTY-SET tbe-cls)
    (lambda ()
      (for-each
        (lambda (leaf)
          (dk-focus! leaf)
          (if (equal? (dk-goal) '(IN EMPTY-SET SET))
              (begin (fact 'empty-set-is-set) (ass))
              (begin
                (di)
                (tbe-empty-fin! 'ix)
                (tbe-empty0! 'a)
                (subst (list '= (tbe-fs 'a 'EMPTY-SET) 0))
                (tbe-K-type! 'EMPTY-SET)
                (tbe-dom! (tbe-K 'EMPTY-SET) 'jx)
                (fact 'rr-pos-star-nonneg (list 'ESUM (tbe-K 'EMPTY-SET)))
                (if (tbe-open?) (ass)))))
        (dk-opened (lambda () (comp-mi))))))
  ;; step
  (let ((stp (list 'FORALL 'u_
               (list 'IMPLIES (list 'AND '(IN u_ SET) (list 'AND '(IN (CARD u_) NN) (list 'IN 'u_ tbe-cls)))
                 (list 'FORALL 'x_
                   (list 'IMPLIES '(AND (IN x_ SET) (NOT (IN x_ u_)))
                     (list 'IN '(UNION u_ (PAIR x_ x_)) tbe-cls)))))))
    (dk-have! stp
      (lambda ()
        (dk-split-all! (dk-peel!))
        (let* ((gl (dk-goal))
               (t1 (cadr gl))
               (u  (cadr t1))
               (x  (cadr (caddr t1)))
               (pr (list 'PAIR x x))
               (ih (dk-landed-find (lambda () (comp-me (list 'IN u tbe-cls))) (dk-head? 'IMPLIES))))
          (tbe-and! (list 'IN x 'SET) (list 'IN x 'SET))
          (fact 'pairing x x)
          (tbe-and! (list 'IN u 'SET) (list 'IN pr 'SET))
          (fact 'union-set-closure u pr)
          (for-each
            (lambda (leaf)
              (dk-focus! leaf)
              (if (equal? (dk-goal) (list 'IN t1 'SET))
                  (ass)
                  (begin
                    (di)
                    ;; u, x inside ix; t1 finite
                    (fact 'union-right-subset pr u)
                    (fact 'union-comm pr u)
                    (dk-rewrite-h! (list 'SUBSET u (list 'UNION pr u)) (list 'UNION pr u) t1)
                    (fact 'subset-trans u t1 'ix)
                    (fact 'pair-self-member x)
                    (fact 'union-right-subset u pr)
                    (fact 'subset-mem-fwd pr t1 x)
                    (fact 'subset-mem-fwd t1 'ix x)
                    (fact 'card-union-singleton-nn u x)
                    (fact 'union-comm pr u)
                    (dk-rewrite-h! (list 'IN (list 'CARD (list 'UNION pr u)) 'NN) (list 'UNION pr u) t1)
                    (detach! ih)
                    (let* ((ku (tbe-K u)) (kt (tbe-K t1)) (gx (list 'g x)) (ax (list 'a x))
                           (fau (tbe-fs 'a u)) (fat (tbe-fs 'a t1)))
                      (tbe-partial! 'a 'ix u)
                      (tbe-partial! 'a 'ix t1)
                      (fact 'fun-apply-type-c 'a 'ix 'RR-POS-STAR x)
                      (fact 'fun-apply-type-c 'g 'ix '(FUN jx RR-POS-STAR) x)
                      (tbe-dom! gx 'jx)
                      (tbe-K-type! u)
                      (tbe-K-type! t1)
                      (tbe-dom! ku 'jx)
                      (tbe-dom! kt 'jx)
                      ;; FINSUM a t1 = FINSUM a u + a x
                      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ t1) (list 'IN '(a z_) (list 'CARR tbe-m))))
                        (lambda ()
                          (subst carr)
                          (let ((zv (dk-di-var!)))
                            (fact 'subset-mem-fwd t1 'ix zv)
                            (fact 'fun-apply-type-c 'a 'ix 'RR-POS-STAR zv)
                            (ass))))
                      (let* ((ins (tbe-cite! 'finsum-cm-insert-ptwise tbe-m u x 'a))
                             (ins2 (dk-rewrite-h! ins (list 'OPR tbe-m) 'eplus)))
                        ;; K_t1(j) = K_u(j) + g(x)(j)
                        (dk-have! (list 'FORALL 'tbq_ (list 'IMPLIES '(IN tbq_ jx)
                                    (list '<= (list 'eplus (list ku 'tbq_) (list gx 'tbq_)) (list kt 'tbq_))))
                          (lambda ()
                            (let* ((jv (dk-di-var!))
                                   (gtj (list 'gt jv)))
                              (fact 'fun-apply-type-c 'gt 'jx '(FUN ix RR-POS-STAR) jv)
                              (tbe-dom! gtj 'ix)
                              (tbe-partial! gtj 'ix u)
                              (tbe-partial! gtj 'ix t1)
                              (fact 'fun-apply-type-c gtj 'ix 'RR-POS-STAR x)
                              (fact 'fun-apply-type-c gx 'jx 'RR-POS-STAR jv)
                              (fact 'fun-apply-type-c ku 'jx 'RR-POS-STAR jv)
                              (fact 'fun-apply-type-c kt 'jx 'RR-POS-STAR jv)
                              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ t1) (list 'IN (list gtj 'z_) (list 'CARR tbe-m))))
                                (lambda ()
                                  (subst carr)
                                  (let ((zv (dk-di-var!)))
                                    (fact 'subset-mem-fwd t1 'ix zv)
                                    (fact 'fun-apply-type-c gtj 'ix 'RR-POS-STAR zv)
                                    (ass))))
                              (let* ((insj (tbe-cite! 'finsum-cm-insert-ptwise tbe-m u x gtj))
                                     (insj2 (dk-rewrite-h! insj (list 'OPR tbe-m) 'eplus))
                                     (trj (dk-apply! tbe-tr x jv))
                                     (kte (list '= (list kt jv) (list 'eplus (list ku jv) (list gx jv)))))
                                (tbe-ep! (tbe-fs gtj u) (list gx jv))
                                (dk-have! kte
                                  (lambda ()
                                    (dk-lam-b!)
                                    (if (tbe-open?) (subst insj2))
                                    (if (tbe-open?) (subst trj))
                                    (if (tbe-open?) (rfl))))
                                (subst kte)
                                (tbe-ep! (list ku jv) (list gx jv))
                                (fact 'rr-pos-star-le-refl (list 'eplus (list ku jv) (list gx jv)))
                                (if (tbe-open?) (ass))))))
                        (tbe-cite! 'esum-superadditive 'jx ku gx kt)
                        (let* ((eu (list 'ESUM ku)) (eg (list 'ESUM gx)) (et (list 'ESUM kt))
                               (axe (dk-apply! tbe-ah x)))
                          (dk-have! (list '<= ax eg)
                            (lambda () (subst axe) (fact 'rr-pos-star-le-refl eg) (if (tbe-open?) (ass))))
                          (tbe-and! (list 'IN fau 'RR-POS-STAR) (list 'IN ax 'RR-POS-STAR)
                                    (list 'IN eu 'RR-POS-STAR) (list 'IN eg 'RR-POS-STAR))
                          (tbe-and! (list '<= fau eu) (list '<= ax eg))
                          (fact 'eplus-mono fau ax eu eg)
                          (subst ins2)
                          (tbe-ep! fau ax)
                          (tbe-ep! eu eg)
                          (tbe-trans! (list 'eplus fau ax) (list 'eplus eu eg) et)
                          (if (tbe-open?) (ass))))))))
            (dk-opened (lambda () (comp-mi)))))))
  (dk-have! (list 'AND (list 'IN 'EMPTY-SET tbe-cls) stp)
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (let ((ind (dk-fact! 'finite-set-induction tbe-cls)))
    (tbe-and! (list 'IN tbe-s0 'SET) (list 'IN (list 'CARD tbe-s0) 'NN))
    (let* ((inw (dk-apply! ind tbe-s0))
           (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
      (detach! body)
      (if (tbe-open?) (ass))))))
(qed 'esum-finsum-le)
(topic! 'esum-finsum-le 'analysis)

;;; ====================================================================
;;; esum-swap-le, esum-swap: Tonelli for ESUM
;;; ====================================================================
(define tbe-bh '(FORALL j_ (IMPLIES (IN j_ jx) (= (b j_) (ESUM (gt j_))))))
(define (tbe-swap-hyps concl)
  (list 'FORALL 'ix (list 'FORALL 'jx (list 'FORALL 'g (list 'FORALL 'gt (list 'FORALL 'a (list 'FORALL 'b
    (list 'IMPLIES '(IN g (FUN ix (FUN jx RR-POS-STAR)))
    (list 'IMPLIES '(IN gt (FUN jx (FUN ix RR-POS-STAR)))
    (list 'IMPLIES tbe-tr
    (list 'IMPLIES '(IN a (FUN ix RR-POS-STAR))
    (list 'IMPLIES tbe-ah
    (list 'IMPLIES '(IN b (FUN jx RR-POS-STAR))
    (list 'IMPLIES tbe-bh concl))))))))))))))

(sp (make-wff (tbe-swap-hyps '(<= (ESUM a) (ESUM b)))))
(dk-peel!)
(fact 'fun-domain-in-set 'jx '(FUN ix RR-POS-STAR) 'gt)
(fact 'fun-domain-in-set 'ix '(FUN jx RR-POS-STAR) 'g)
(tbe-dom! 'a 'ix)
(tbe-dom! 'b 'jx)
(let ((eb '(ESUM b)))
  (dk-have! (tbe-bound 'a eb)
    (lambda ()
      (let* ((sv (tbe-peel-set! 'a 'ix))
             (ks (tbe-K sv)))
        (tbe-partial! 'a 'ix sv)
        (tbe-K-type! sv)
        (tbe-dom! ks 'jx)
        (tbe-cite! 'esum-finsum-le 'ix 'jx 'g 'gt 'a sv)
        (dk-have! (list 'FORALL 'tbq_ (list 'IMPLIES '(IN tbq_ jx) (list '<= (list ks 'tbq_) '(b tbq_))))
          (lambda ()
            (let* ((jv (dk-di-var!)) (gtj (list 'gt jv)))
              (fact 'fun-apply-type-c 'gt 'jx '(FUN ix RR-POS-STAR) jv)
              (tbe-dom! gtj 'ix)
              (tbe-partial! gtj 'ix sv)
              (dk-lam-b!)
              (if (tbe-open?)
                  (let ((bj (dk-apply! tbe-bh jv)))
                    (subst bj)
                    (if (tbe-open?) (ass)))))))
        (tbe-cite! 'esum-le-ptwise 'jx ks 'b)
        (tbe-trans! (tbe-fs 'a sv) (list 'ESUM ks) eb)
        (ass))))
  (tbe-and! (list 'IN eb 'RR-POS-STAR) (tbe-bound 'a eb))
  (tbe-cite! 'esum-least 'a eb)
  (ass))
(qed 'esum-swap-le)
(topic! 'esum-swap-le 'analysis)

(sp (make-wff (tbe-swap-hyps '(= (ESUM a) (ESUM b)))))
(dk-peel!)
(fact 'fun-domain-in-set 'jx '(FUN ix RR-POS-STAR) 'gt)
(fact 'fun-domain-in-set 'ix '(FUN jx RR-POS-STAR) 'g)
(tbe-dom! 'a 'ix)
(tbe-dom! 'b 'jx)
(tbe-cite! 'esum-swap-le 'ix 'jx 'g 'gt 'a 'b)
(dk-have! '(FORALL i_ (IMPLIES (IN i_ jx) (FORALL j_ (IMPLIES (IN j_ ix) (= ((g j_) i_) ((gt i_) j_))))))
  (lambda ()
    (dk-peel!)
    (let* ((gl (dk-goal))
           (iv (cadr (cadr gl)))
           (jv (cadr (car (cadr gl)))))
      (let ((e (dk-apply! tbe-tr jv iv)))
        (fact 'equality-symmetry (cadr e) (caddr e))
        (if (tbe-open?) (ass))))))
(tbe-cite! 'esum-swap-le 'jx 'ix 'gt 'g 'b 'a)
(tbe-and! '(IN (ESUM a) RR-POS-STAR) '(IN (ESUM b) RR-POS-STAR))
(tbe-and! '(<= (ESUM a) (ESUM b)) '(<= (ESUM b) (ESUM a)))
(fact 'rr-pos-star-le-antisymm '(ESUM a) '(ESUM b))
(ass)
(qed 'esum-swap)
(topic! 'esum-swap 'analysis)

;;; ====================================================================
;;; esum-subadditive: h <= f + g pointwise => ESUM h <= ESUM f + ESUM g (any index set)
;;; ====================================================================
(sp (make-wff '(FORALL dd (FORALL f (FORALL g (FORALL h
  (IMPLIES (IN f (FUN dd RR-POS-STAR))
  (IMPLIES (IN g (FUN dd RR-POS-STAR))
  (IMPLIES (IN h (FUN dd RR-POS-STAR))
  (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (<= (h z_) (eplus (f z_) (g z_)))))
    (<= (ESUM h) (eplus (ESUM f) (ESUM g)))))))))))))
(dk-peel!)
(tbe-dom! 'f 'dd)
(tbe-dom! 'g 'dd)
(tbe-dom! 'h 'dd)
(fact 'rr-pos-star-is-comm-monoid)
(let* ((ee (tbe-ep! '(ESUM f) '(ESUM g)))
       (hyp '(FORALL z_ (IMPLIES (IN z_ dd) (<= (h z_) (eplus (f z_) (g z_))))))
       (kl '(VNB-LAMBDA tbk_ dd (eplus (f tbk_) (g tbk_)))))
  (dk-have! (list 'IN kl '(FUN dd RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (dk-di-var!)))
            (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR kv)
            (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR kv)
            (tbe-ep! (list 'f kv) (list 'g kv))
            (ass)))
        (lambda () (ass)))))
  (dk-have! (tbe-bound 'h ee)
    (lambda ()
      (let ((sv (tbe-peel-set! 'h 'dd)))
        (for-each (lambda (fv) (tbe-partial! fv 'dd sv)) '(f g h))
        (for-each (lambda (fv) (tbe-ptype! fv 'dd sv)) '(f g h))
        (tbe-ptype! kl 'dd sv)
        (let* ((carr (dk-cite! 'rr-pos-star-add-monoid@carr))
               (opr (dk-cite! 'rr-pos-star-add-monoid@opr)))
          (for-each
            (lambda (fv)
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) (list 'IN (list fv 'z_) (list 'CARR tbe-m))))
                (lambda ()
                  (subst carr)
                  (if (tbe-open?) (ass)))))
            '(f g))
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv)
                      (list '= (list kl 'z_) (list (list 'OPR tbe-m) '(f z_) '(g z_)))))
            (lambda ()
              (let ((zv (dk-di-var!)))
                (subst opr)
                (fact 'subset-mem-fwd sv 'dd zv)
                (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR zv)
                (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR zv)
                (tbe-ep! (list 'f zv) (list 'g zv))
                (if (not (dk-lam-b!)) (rfl)))))
          (let* ((ad (tbe-cite! 'finsum-cm-add-ptwise tbe-m sv 'f 'g kl))
                 (ad2 (dk-rewrite-h! ad (list 'OPR tbe-m) 'eplus)))
            (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) (list '<= '(h z_) (list kl 'z_))))
              (lambda ()
                (let ((zv (dk-di-var!)))
                  (fact 'subset-mem-fwd sv 'dd zv)
                  (fact 'fun-apply-type-c 'f 'dd 'RR-POS-STAR zv)
                  (fact 'fun-apply-type-c 'g 'dd 'RR-POS-STAR zv)
                  (tbe-ep! (list 'f zv) (list 'g zv))
                  (dk-lam-b!)
                  (if (tbe-open?) (dk-apply! hyp zv))
                  (if (tbe-open?) (ass)))))
            (tbe-cite! 'rps-finsum-le-ptwise sv 'h kl)
            (let* ((pf (tbe-fs 'f sv)) (pg (tbe-fs 'g sv))
                   (s2 (tbe-ep! pf pg))
                   (ku (tbe-fs kl sv)))
              (if (not (dk-asm? (list 'IN ku 'RR-POS-STAR)))
                  (dk-have! (list 'IN ku 'RR-POS-STAR)
                    (lambda () (subst (list '= ku s2)) (ass))))
              (tbe-and! (list 'IN pf 'RR-POS-STAR) (list 'IN pg 'RR-POS-STAR)
                        (list 'IN '(ESUM f) 'RR-POS-STAR) (list 'IN '(ESUM g) 'RR-POS-STAR))
              (tbe-and! (list '<= pf '(ESUM f)) (list '<= pg '(ESUM g)))
              (fact 'eplus-mono pf pg '(ESUM f) '(ESUM g))
              (dk-rewrite-h! (list '<= s2 ee) s2 ku)
              (tbe-trans! (tbe-fs 'h sv) ku ee)
              (ass)))))))
  (tbe-and! (list 'IN ee 'RR-POS-STAR) (tbe-bound 'h ee))
  (tbe-cite! 'esum-least 'h ee)
  (if (tbe-open?) (ass)))
(qed 'esum-subadditive)
(topic! 'esum-subadditive 'analysis)
