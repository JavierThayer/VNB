  (dk-have! '(IN (* 2 +i) CC) (lambda () (arith)))
  (dk-have! '(NOT (= (* 2 +i) 0)) (lambda () (arith)))
  (cek-cc-typ! '(* (- (CC-EXP (* +i cekt_)) (CC-EXP (- (* +i cekt_)))) (recip (* 2 +i))))
  (rfl))
(qed 'cc-sin-real-part)

(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (AND (IN (CC-COS cekt_) RR) (IN (CC-SIN cekt_) RR))))))
(dk-peel!)
(fact 'rr-subset-cc 'cekt_)
(cek-exp-typ! '(* +i cekt_))
(fact 'cc-cos-real-part 'cekt_)
(fact 'cc-sin-real-part 'cekt_)
(fact 'real-part-in-rr '(CC-EXP (* +i cekt_)))
(fact 'imag-part-in-rr '(CC-EXP (* +i cekt_)))
(dk-conj-close!
