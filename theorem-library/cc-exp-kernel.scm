(sp (make-wff '(FORSOME cekt_ (AND (IN cekt_ RR) (AND (< 0 cekt_) (AND (< cekt_ 2) (= (CC-COS cekt_) 0)))))))
(let* ((nc cek-ncos))
  (dk-split-all! (list (dk-fact! 'cc-neg-cos-continuous-rr)))
  (fact 'rr-zero-in)
  (dk-have! '(IN 2 RR) (lambda () (arith)))
  (dk-have! '(<= 0 2) (lambda () (arith)))
  (fact 'cc-cos-zero)
  (fact 'cc-cos-two-neg)
  (fact 'rr-subset-cc 2) (fact 'rr-subset-cc 0)
  (fact 'cc-cos-sin-real 0) (fact 'cc-cos-sin-real 2)
  (dk-split-all!)
  (dk-have! '(FORALL x (IMPLIES (IN x (CCINT 0 2)) (IS-CONTINUOUS-AT RR-MS RR-MS (VNB-LAMBDA cekv_ RR (* -1 (CC-COS cekv_))) x)))
    (lambda ()
      (let* ((ld (dk-peel!)) (x (cadr (car ld))))
        (mac-h 'ccint-membership (car ld))
        (dk-split-all!)
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "continuity") x)
        (ass))))
  (let ((n0 (list nc 0)) (n2 (list nc 2)))
    (fact 'fun-apply-type-c nc 'RR 'RR 0)
    (fact 'fun-apply-type-c nc 'RR 'RR 2)
    (cek-rr-typ! '(* -1 (CC-COS 0))) (cek-rr-typ! '(* -1 (CC-COS 2)))
    (dk-have! (list '= n0 '(* -1 (CC-COS 0))) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
    (dk-have! (list '= n2 '(* -1 (CC-COS 2))) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
    (dk-have! (list 'AND (list '<= n0 0) (list '<= 0 n2))
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (dk-ineq! (list '= n0 '(* -1 (CC-COS 0))) (list '= n2 '(* -1 (CC-COS 2))) '(= (CC-COS 0) 1) '(< (CC-COS 2) 0)))))))
  (let* ((p (dk-skolem! (dk-fact! 'ivt nc 0 2 0)))
         (cp (list 'CC-COS p)) (np (list nc p)))
    (mac-h 'ccint-membership (list 'IN p '(CCINT 0 2)))
    (dk-split-all!)
    (fact 'fun-apply-type-c nc 'RR 'RR p)
    (fact 'rr-subset-cc p)
    (fact 'cc-cos-sin-real p)
    (dk-split-all!)
    (cek-rr-typ! (list '* -1 cp))
    (dk-have! (list '= np (list '* -1 cp)) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
    (dk-have! (list '= cp 0)
      (lambda ()
        (dk-have! (list '<= cp 0) (lambda () (dk-ineq! (list '= np 0) (list '= np (list '* -1 cp)))))
        (dk-have! (list '<= 0 cp) (lambda () (dk-ineq! (list '= np 0) (list '= np (list '* -1 cp)))))
        (cek-and! (list 'IN cp 'RR) '(IN 0 RR))
