  (cek-exp-typ! t)
  (cek-exp-typ! (list '+ z w))
  (dk-congr! (list '= (list '+ z w) t) (lambda (x) (list 'CC-EXP x)))
  (dk-have! (list '= (list 'CC-EXP t) 1)
    (lambda () (subst (list '= (list 'CC-EXP t) (list 'CC-EXP (list '+ z w)))) (ass)))
  (fact 'cc-exp-real-one-iff t)
  (mac-h 'cc-exp-real-one-iff (list '= (list 'CC-EXP t) 1))
  (cek-rr-typ! '(real-part cekz_))
