;;; ======================================================================
;;; (N) cos 2 < 0.  From the exponential series at i: exp(i) = 1 + i - 1/2 - i/6
;;; + E with |E| <= 2/4! = 1/12 (cc-exp-tail at m = 4), so |cos 1 - 1/2| <= 1/12,
;;; and cos 2 = 2 cos^2 1 - 1 <= 2 (7/12)^2 - 1 < 0 (cc-cos-add, cc-cos-sin-one).
;;; ======================================================================
(sp (make-wff '(AND (<= 5/12 (CC-COS 1)) (<= (CC-COS 1) 7/12))))
(let* ((z (list '* +i 1)) (w (list 'CC-EXP z)) (v (make-rectangular 1/2 5/6))
       (s4 (list 'CC-SERIES-PARTIAL-SUM (cek-el z) 4))
       (b (list '* 2 (list '* '(recip (FACTORIAL 4)) (list 'power (list 'magnitude z) 4))))
       (c '(CC-COS 1)))
  (cek-cc-typ! z)
  (cek-nn-typ! 4)
  (dk-have! (list '<= (list '* 2 (list 'magnitude z)) '(succ 4)) (lambda () (arith)))
  (dk-fact! 'cc-exp-tail z 4)
  (cek-psum-val! z 4 v (lambda () (arith)))
  (cek-exp-typ! z)
  (cek-cc-typ! s4)
  (dk-have! (list 'IN v 'CC) (lambda () (arith)))
  (cek-cc-typ! (list '- w v))
  (cek-rr-typ! (list 'magnitude (list '- w v)))
  (dk-have! (list '<= (list 'magnitude (list '- w v)) 1/12)
    (lambda ()
      (subst (list '= v s4))
      (cek-rr-typ! '(recip (FACTORIAL 4)))
      (cek-rr-typ! (list 'magnitude z))
      (cek-rr-typ! (list 'power (list 'magnitude z) 4))
      (cek-rr-typ! b)
      (cek-rr-typ! (list 'magnitude (list '- w s4)))
      (dk-have! (list '= b 1/12) (lambda () (subst (cek-fact-val! 4)) (arith)))
      (dk-have! (list '<= b 1/12) (lambda () (subst (list '= b 1/12)) (dk-ineq!)))
      (cek-rr-typ! 1/12)
      (dk-le-trans! (list 'magnitude (list '- w s4)) b 1/12)
      (ass)))
  (fact 'cc-re-dist-le w v)
  (dk-have! (list '= (list 'real-part v) 1/2) (lambda () (arith)))
  (fact 'rr-one-in)
  (fact 'cc-cos-real-part 1)
  (fact 'cc-cos-sin-real 1)
  (dk-split-all!)
  (let ((d (list '- (list 'real-part w) (list 'real-part v))))
    (cek-rr-typ! d)
    (cek-rr-typ! (list 'abs d))
    (cek-rr-typ! 1/12)
    (dk-le-trans! (list 'abs d) (list 'magnitude (list '- w v)) 1/12)
    (dk-split-all! (list (dk-fact! 'rr-abs-le-parts d 1/12)))
    (dk-conj-close!
      (lambda ()
        (dk-ineq! (list '<= (list '- 1/12) d) (list '<= d 1/12) (list '= (list 'real-part v) 1/2)
                  (list '= c (list 'real-part w)))))))
(qed 'cc-cos-one-bounds)

(sp (make-wff '(< (CC-COS 2) 0)))
(let* ((c '(CC-COS 1)) (s '(CC-SIN 1)) (cc (list '* c c)) (ss (list '* s s)))
  (fact 'rr-one-in)
  (fact 'rr-subset-cc 1)
  (fact 'cc-cos-sin-real 1)
  (dk-split-all!)
  (fact 'cc-cos-one-bounds)
  (dk-split-all!)
  (cek-cos-typ! 1) (cek-sin-typ! 1)
  (fact 'cc-cos-add 1 1)
  (fact 'cc-cos-sin-one 1)
  (dk-have! '(IN 2 CC) (lambda () (arith)))
  (cek-cos-typ! 2) (cek-cos-typ! '(+ 1 1))
  (dk-have! '(= (+ 1 1) 2) (lambda () (arith)))
  (dk-have! '(= (CC-COS 2) (CC-COS (+ 1 1))) (lambda () (subst '(= (+ 1 1) 2)) (rfl)))
  (cek-pow2! c) (cek-pow2! s)
  (cek-rr-typ! cc) (cek-rr-typ! ss)
  (fact 'cc-cos-sin-real 2)
  (dk-split-all!)
  (cek-rr-typ! 7/12)
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 5/12 c))))
  (fact 'rr-mul-le-right c 7/12 c)
  (cek-rr-typ! (list '* 7/12 c))
  (cek-rr-typ! (list 'power c 2)) (cek-rr-typ! (list 'power s 2)) (cek-rr-typ! (list '- cc ss))
  (dk-have! (list '= '(CC-COS 2) (list '- cc ss))
    (lambda ()
      (subst '(= (CC-COS 2) (CC-COS (+ 1 1))))
      (subst (list '= '(CC-COS (+ 1 1)) (list '- cc ss)))
      (rfl)))
  (dk-ineq! (list '= '(CC-COS 2) (list '- cc ss))
            (list '= (list '+ (list 'power c 2) (list 'power s 2)) 1)
            (list '= (list 'power c 2) cc) (list '= (list 'power s 2) ss)
            (list '<= cc (list '* 7/12 c)) (list '<= c 7/12)))
(qed 'cc-cos-two-neg)

;;; ======================================================================
;;; (I) cos HAS A ZERO IN (0, 2): continuity on the real line and the
;;; intermediate value theorem (ivt) for -cos on [0, 2] (-cos 0 = -1 < 0 <
;;; -cos 2).  The bridge: a complex function continuous at a real point (on
;;; the open set CC, as diff-on-implies-continuous states it) whose real
;;; restriction G is real-valued gives a real function continuous there.
;;; ======================================================================
(define cek-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define cek-sub '(SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) CC))
(define (cek-nf-setup!)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS cek-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS cek-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS cek-nfm) '(CARR CC-NORMED-FIELD))) (ass))))
  (fact 'subspace-pts cek-nfm 'CC)
  (cek-pts-cc!) (cek-pts-rr!))
(define (cek-in-pts! x sp)              ; (IN x (PTS SP)) from (IN x CC) / (IN x RR)
  (let ((g (list 'IN x (list 'PTS sp))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '== (list 'PTS sp) (if (eq? sp 'RR-MS) 'RR 'CC))) (ass))))
    g))
(sp (make-wff (list 'FORALL 'cekff_ (list 'FORALL 'cekgg_ (list 'FORALL 'cekx_
  (list 'IMPLIES (list 'IS-CONTINUOUS-AT cek-sub cek-nfm 'cekff_ 'cekx_)
    (list 'IMPLIES '(IN cekgg_ (FUN RR RR)) (list 'IMPLIES '(IN cekx_ RR)
      (list 'IMPLIES '(FORALL cekv_ (IMPLIES (IN cekv_ RR) (= (cekgg_ cekv_) (cekff_ cekv_))))
        '(IS-CONTINUOUS-AT RR-MS RR-MS cekgg_ cekx_))))))))))
(dk-peel!)
(define cek-cr-pw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cekgg_))) "G = F on RR"))
(mac-h 'is-continuous-at (dk-ctx-form (list 'IS-CONTINUOUS-AT cek-sub cek-nfm 'cekff_ 'cekx_)))
(dk-split-all!)
(define cek-cr-E (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'cekff_))) "F's continuity"))
(cek-nf-setup!)
(fact 'rr-subset-cc 'cekx_)
(define (cek-cr-main!)
  (let* ((ld (dk-peel!))
         (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) ld)))
         (d (dk-skolem! (dk-apply! cek-cr-E eps)))
         (inner (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'DIST))) "the delta clause"))
         (x 'cekx_))
    (ew d)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'POS-RR)
            (ass)
            (let* ((lb (dk-peel!))
                   (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) lb)))
                   (gx (list 'cekgg_ x)) (gb (list 'cekgg_ b)) (fx (list 'cekff_ x)) (fb (list 'cekff_ b))
                   (dxb (list '- x b)) (dfx (list '- fx fb)))
              (dk-have! (list 'IN b 'RR) (lambda () (subst '(= RR (PTS RR-MS))) (ass)))
              (fact 'rr-subset-cc b)
              (cek-in-pts! b cek-sub) (cek-in-pts! b 'CC-MS) (cek-in-pts! x 'CC-MS) (cek-in-pts! x cek-sub)
              (cek-in-pts! b cek-nfm) (cek-in-pts! x cek-nfm)
              (fact 'subspace-dist cek-nfm 'CC x b)
              (fact 'nf-cc-agree-dist x b)
              (fact 'cc-ms-dist x b)
              (fact 'rr-ms-dist x b)
              (cek-rr-typ! dxb)
              (fact 'rr-magnitude-is-abs dxb)
              (dk-have! (list '<= (list (list 'DIST cek-sub) x b) d)
                (lambda ()
                  (subst (list '== (list (list 'DIST cek-sub) x b) (list (list 'DIST cek-nfm) x b)))
                  (subst (list '== (list (list 'DIST cek-nfm) x b) (list '(DIST CC-MS) x b)))
                  (subst (list '== (list '(DIST CC-MS) x b) (list 'magnitude dxb)))
                  (subst (list '= (list 'magnitude dxb) (list 'abs dxb)))
                  (subst (list '= (list 'abs dxb) (list '(DIST RR-MS) x b)))
                  (ass)))
              (dk-apply! inner b)
              (fact 'fun-apply-type-c 'cekgg_ 'RR 'RR x)
              (fact 'fun-apply-type-c 'cekgg_ 'RR 'RR b)
              (dk-apply! cek-cr-pw x) (dk-apply! cek-cr-pw b)
              (dk-have! (list 'IN fx 'RR) (lambda () (subst (list '= fx gx)) (ass)))
              (dk-have! (list 'IN fb 'RR) (lambda () (subst (list '= fb gb)) (ass)))
              (fact 'rr-subset-cc fx) (fact 'rr-subset-cc fb)
              (cek-in-pts! fx 'CC-MS) (cek-in-pts! fb 'CC-MS)
              (cek-rr-typ! dfx)
              (fact 'rr-magnitude-is-abs dfx)
              (fact 'nf-cc-agree-dist fx fb)
              (fact 'cc-ms-dist fx fb)
              (fact 'rr-ms-dist gx gb)
              (subst (list '== (list '(DIST RR-MS) gx gb) (list 'abs (list '- gx gb))))
              (subst (list '= gx fx))
              (subst (list '= gb fb))
              (subst (list '= (list 'abs dfx) (list 'magnitude dfx)))
              (subst (list '= (list 'magnitude dfx) (list '(DIST CC-MS) fx fb)))
              (subst (list '= (list '(DIST CC-MS) fx fb) (list (list 'DIST cek-nfm) fx fb)))
              (ass)))))))
(mac 'is-continuous-at)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)) (leaf (proof-state-focus *ps*)))
      (cond
        ((dk-head-is? g 'IS-METRIC-SPACE) (fact 'rr-is-metric-space) (if (not (sequent-node-grounded? leaf)) (ass)))
        ((dk-head-is? g 'IN) (subst '(== (PTS RR-MS) RR)) (ass))
        (#t (cek-cr-main!))))))
