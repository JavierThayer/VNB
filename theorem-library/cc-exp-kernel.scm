;;; ======================================================================
;;; (C) cos AND sin ON THE REAL LINE ARE THE COORDINATES OF exp(i t):
;;; cos t = Re exp(it), sin t = Im exp(it) (from (35) and exp(conj z) =
;;; conj exp(z)); so both are real.
;;; ======================================================================
(define (cek-conj-it! t)                ; (= (conjugate (CC-EXP (* +i t))) (CC-EXP (- (* +i t)))), t in RR
  (let* ((z (list '* +i t)) (w (list 'CC-EXP z)) (nz (list '- z))
         (e (list '= (list 'conjugate w) (list 'CC-EXP nz))))
    (if (not (dk-asm? e))
        (begin
          (fact 'rr-subset-cc t)
          (cek-cc-typ! z) (cek-cc-typ! nz) (cek-conj-typ! z) (cek-exp-typ! z) (cek-exp-typ! nz) (cek-conj-typ! w)
          (dk-have! (list '= (list 'conjugate z) nz)
            (lambda ()
              (cek-cc-typ! +i)
              (cek-and! (list 'IN +i 'CC) (list 'IN t 'CC))
              (subst (dk-fact! 'cc-conjugate-mul +i t))
              (subst (dk-fact! 'cc-conjugate-i))
              (subst (dk-cite! 'cc-conjugate-fixes-rr t))
              (crs)))
          (fact 'cc-exp-conj z)
          (cek-exp-typ! (list 'conjugate z))
          (dk-have! e
            (lambda ()
              (subst (list '= (list 'conjugate w) (list 'CC-EXP (list 'conjugate z))))
              (subst (list '= (list 'conjugate z) nz))
              (rfl)))))
    e))
(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (= (CC-COS cekt_) (real-part (CC-EXP (* +i cekt_))))))))
(dk-peel!)
(let* ((t 'cekt_) (w '(CC-EXP (* +i cekt_))))
  (cek-conj-it! t)
  (cek-cos-typ! t)
  (subst (dk-fact! 'cc-cos-exp t))
  (subst (dk-fact! 'real-part-def w))
  (subst (list '= (list 'conjugate w) '(CC-EXP (- (* +i cekt_)))))
  (cek-cc-typ! '(* (+ (CC-EXP (* +i cekt_)) (CC-EXP (- (* +i cekt_)))) (recip 2)))
  (rfl))
(qed 'cc-cos-real-part)

(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (= (CC-SIN cekt_) (imag-part (CC-EXP (* +i cekt_))))))))
