(qed 'cc-exp-kernel-sub)

(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (IMPLIES (= (CC-EXP cekz_) 1) (= (real-part cekz_) 0))))))
(dk-peel!)
(let* ((z 'cekz_) (w '(conjugate cekz_)) (t '(* 2 (real-part cekz_))))
  (cek-conj-typ! z)
  (fact 'cc-exp-conj z)
  (fact 'rr-one-in)
  (dk-have! (list '= (list 'CC-EXP w) 1)
