;;; -cos is continuous on the real line, as a function RR -> RR
(define cek-ncos '(VNB-LAMBDA cekv_ RR (* -1 (CC-COS cekv_))))
(define cek-cosl '(VNB-LAMBDA cexy_ CC (CC-COS cexy_)))
(define (cek-ncos-typ!)
  (if (not (dk-asm? (list 'IN cek-ncos '(FUN RR RR))))
      (dk-have! (list 'IN cek-ncos '(FUN RR RR))
        (lambda ()
          (dk-lam-t!)
          (let ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
            (fact 'cc-cos-sin-real v) (dk-split-all!)
            (cek-rr-typ! (list '* -1 (list 'CC-COS v)))
            (if (not (sequent-node-grounded? leaf)) (ass)))))))
(sp (make-wff (list 'AND (list 'IN cek-ncos '(FUN RR RR))
  (list 'FORALL 'cekx_ (list 'IMPLIES '(IN cekx_ RR) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS cek-ncos 'cekx_))))))
(cek-ncos-typ!)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (ass)
        (let* ((ld (dk-peel!)) (x (cek-land-var ld 'RR)) (f (list 'VNB-LAMBDA 'cexy_ 'CC (list '* -1 (list cek-cosl 'cexy_)))))
          (fact 'rr-subset-cc x)
          (cek-cos-typ! x) (cek-sin-typ! x)
          (fact 'cc-cos-deriv x)
          (cek-cc-typ! -1)
          (let* ((l (list '- (list 'CC-SIN x)))
                 (sc (dk-fact! 'cc-diff-on-scale 'CC cek-cosl x l)))
            (cek-cc-typ! l)
            (dk-apply! sc -1)
            (fact 'diff-on-implies-continuous 'CC-NORMED-FIELD 'CC f x (list '* -1 l))
            (cek-chain!
              (detach-with! (dk-fact! 'cc-continuous-restrict-rr f cek-ncos x)
                (lambda ()
                  (let* ((lv (dk-peel!)) (v (cek-land-var lv 'RR)) (leaf (proof-state-focus *ps*)))
                    (fact 'rr-subset-cc v)
                    (cek-cos-typ! v)
                    (cek-cc-typ! (list '* -1 (list 'CC-COS v)))
                    (dk-lam-b!)
                    (if (not (sequent-node-grounded? leaf)) (rfl))))))
            (ass))))))
(qed 'cc-neg-cos-continuous-rr)

;;; cos itself is continuous on the real line, as a function RR -> RR (the brief's
