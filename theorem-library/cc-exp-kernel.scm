(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (ass)
        (let* ((ld (dk-peel!)) (x (cek-land-var ld 'RR)))
          (fact 'rr-subset-cc x)
