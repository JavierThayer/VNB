(sp (make-wff '(= (CC-COS 0) 1)))
(fact 'rr-zero-in)
(fact 'rr-subset-cc 0)
(fact 'cc-cos-real-part 0)
(cek-cc-typ! (list '* +i 0))
(cek-exp-typ! (list '* +i 0))
(cek-exp-typ! 0)
(dk-have! (list '= (list '* +i 0) 0) (lambda () (arith)))
(dk-congr! (list '= (list '* +i 0) 0) (lambda (x) (list 'CC-EXP x)))
(fact 'cc-exp-zero)
(subst (dk-ctx-form (list '= '(CC-COS 0) (list 'real-part (list 'CC-EXP (list '* +i 0))))))
(subst (list '= (list 'CC-EXP (list '* +i 0)) '(CC-EXP 0)))
