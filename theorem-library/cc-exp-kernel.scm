        (dk-have! (list '= cp 1) (lambda () (subst (list '= p 0)) (ass)))
        (cek-absurd! (list '= cp 1) (list '= cp 0))))
    (dk-have! (list 'NOT (list '= p 2))
      (lambda ()
        (di)
        (dk-have! (list '< cp 0) (lambda () (subst (list '= p 2)) (ass)))
        (cek-absurd! (list '< cp 0) (list '= cp 0))))
    (cek-and! (list '<= 0 p) (list 'NOT (list '= 0 p)))
    (fact 'rr-le-ne-lt 0 p)
    (cek-and! (list '<= p 2) (list 'NOT (list '= p 2)))
    (fact 'rr-le-ne-lt p 2)
    (ew p)
    (dk-conj-close! (lambda () (ass)))))
(qed 'cc-cos-has-zero)

;;; ======================================================================
;;; (P) A NONZERO PERIOD: with cos t0 = 0 (0 < t0 < 2), sin^2 t0 = 1 and
;;; exp(i t0) = i sin t0, so exp(4 i t0) = (i sin t0)^4 = 1; 0 < 4 t0 < 8.
;;; ======================================================================
(sp (make-wff '(FORSOME cekt_ (AND (IN cekt_ RR) (AND (< 0 cekt_) (AND (< cekt_ 8) (= (CC-EXP (* +i cekt_)) 1)))))))
(let* ((t0 (dk-skolem! (dk-fact! 'cc-cos-has-zero)))
       (c (list 'CC-COS t0)) (s (list 'CC-SIN t0)) (w (list '* +i t0)) (ww (list '+ w w)) (w4 (list '+ ww ww))
       (T (list '* 4 t0)) (iT (list '* +i T)))
  (fact 'rr-subset-cc t0)
  (fact 'cc-cos-sin-real t0) (dk-split-all!)
  (cek-cos-typ! t0) (cek-sin-typ! t0)
  (cek-rr-typ! T) (fact 'rr-subset-cc T)
  (cek-cc-typ! w) (cek-cc-typ! ww) (cek-cc-typ! w4) (cek-cc-typ! iT)
  (cek-exp-typ! w) (cek-exp-typ! ww) (cek-exp-typ! w4) (cek-exp-typ! iT)
  (fact 'cc-cos-sin-one t0)
  (cek-pow2! c) (cek-pow2! s)
  (dk-have! (list '= (list '* s s) 1)
    (lambda ()
      (subst (list '= 1 (list '+ (list 'power c 2) (list 'power s 2))))
      (subst (list '= (list 'power c 2) (list '* c c)))
      (subst (list '= (list 'power s 2) (list '* s s)))
      (subst (list '= c 0))
      (crs)))
  (dk-have! (list '= iT w4) (lambda () (crs)))
  (dk-congr! (list '= iT w4) (lambda (x) (list 'CC-EXP x)))
  (fact 'cc-exp-add ww ww)
  (cek-and! (list 'IN w 'CC) (list 'IN w 'CC))
  (fact 'cc-exp-add w w)
  (fact 'cc-exp-i t0)
  (dk-have! (list '< 0 T) (lambda () (dk-ineq! (list '< 0 t0))))
  (ew T)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'IN) (ass))
              ((dk-head-is? g '<) (dk-ineq! (list '< 0 t0) (list '< t0 2)))
              (#t
               (subst (list '= (list 'CC-EXP iT) (list 'CC-EXP w4)))
               (subst (list '= (list 'CC-EXP w4) (list '* (list 'CC-EXP ww) (list 'CC-EXP ww))))
               (subst (list '= (list 'CC-EXP ww) (list '* (list 'CC-EXP w) (list 'CC-EXP w))))
               (subst (list '= (list 'CC-EXP w) (list '+ c (list '* +i s))))
               (subst (list '= c 0))
               (subst (cek-ring-id! '(cxra_) '(= (* (* (+ 0 (* +i cxra_)) (+ 0 (* +i cxra_))) (* (+ 0 (* +i cxra_)) (+ 0 (* +i cxra_))))
                                               (* (* cxra_ cxra_) (* cxra_ cxra_))) (list s)))
               (subst (list '= (list '* s s) 1))
               (arith)))))))
(qed 'cc-exp-imaginary-period-exists)

;;; the notes' K /= {0}
(sp (make-wff '(FORSOME cekz_ (AND (IN cekz_ CC) (AND (= (CC-EXP cekz_) 1) (NOT (= cekz_ 0)))))))
(let* ((t (dk-skolem! (dk-fact! 'cc-exp-imaginary-period-exists))) (z (list '* +i t)))
  (fact 'rr-subset-cc t)
  (cek-cc-typ! z)
  (ew z)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'NOT)
               (di)
               (dk-have! (list '= t 0)
                 (lambda ()
                   (subst (cek-ring-id! '(cxra_) '(= cxra_ (* (- +i) (* +i cxra_))) (list t)))
                   (subst (list '= z 0))
                   (arith)))
               (cek-absurd! (list '< 0 t) (list '= t 0)))
              (#t (ass)))))))
(qed 'cc-exp-kernel-nontrivial)

;;; ======================================================================
;;; (L) THE LEAST POSITIVE PERIOD.  S = {t > 0 : exp(it) = 1} is non-empty
;;; (cc-exp-imaginary-period-exists) and every element is >= 1/2 (discreteness);
;;; its infimum a = -SUP{y < 0 : exp(iy) = 1} lies in S, since otherwise two
;;; elements of S within 1/2 of a would differ by a period in (0, 1/2).
;;; ======================================================================
(define (cek-mag-it! t)                 ; (= (magnitude (* +i t)) (abs t)), t in RR
  (let* ((z (list '* +i t)) (e (list '= (list 'magnitude z) (list 'abs t))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'rr-subset-cc t)
            (cek-cc-typ! +i) (cek-cc-typ! z)
            (cek-and! (list 'IN +i 'CC) (list 'IN t 'CC))
            (subst (dk-fact! 'cc-magnitude-mul +i t))
            (dk-have! (list '= (list 'magnitude +i) 1) (lambda () (arith)))
            (subst (list '= (list 'magnitude +i) 1))
            (subst (dk-cite! 'rr-magnitude-is-abs t))
            (cek-rr-typ! (list 'abs t)) (fact 'rr-subset-cc (list 'abs t))
            (crs))))
    e))
;;; i t = 0 ==> t = 0 (t real), landed
(define (cek-it-zero! t)
  (dk-have! (list '= t 0)
    (lambda ()
      (fact 'rr-subset-cc t)
      (subst (cek-ring-id! '(cxra_) '(= cxra_ (* (- +i) (* +i cxra_))) (list t)))
      (subst (list '= (list '* +i t) 0))
      (arith))))
(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (IMPLIES (< 0 cekt_) (IMPLIES (= (CC-EXP (* +i cekt_)) 1)
  (<= 1/2 cekt_)))))))
(dk-peel!)
(let ((t 'cekt_) (z '(* +i cekt_)))
  (cek-rr-typ! 1/2)
  (use-cases (dk-fact! 'rr-lt-trichotomy t 1/2)
    (lambda ()
      (cek-mag-it! t)
      (fact 'rr-abs-of-nonneg t)
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
      (fact 'rr-abs-of-nonneg t)
      (cek-rr-typ! (list 'magnitude z)) (cek-rr-typ! (list 'abs t))
      (dk-have! (list '< (list 'magnitude z) 1/2)
        (lambda () (dk-ineq! (list '= (list 'magnitude z) (list 'abs t)) (list '= (list 'abs t) t) (list '< t 1/2))))
      (cek-cc-typ! z)
      (fact 'cc-exp-kernel-discrete z)
      (cek-it-zero! t)
      (cek-absurd! (list '< 0 t) (list '= t 0)))
    (lambda () (dk-ineq! (list '= t 1/2)))
    (lambda () (dk-ineq! (list '< 1/2 t)))))
(qed 'cek-period-ge-half)

;;; exp(i(-t)) = 1 from exp(it) = 1, landed
(define (cek-neg-period! t)
  (let* ((z (list '* +i t)) (mt (list '- t)) (zm (list '* +i mt)) (e (list '= (list 'CC-EXP zm) 1)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'rr-subset-cc t)
            (cek-rr-typ! mt) (fact 'rr-subset-cc mt)
            (cek-cc-typ! z) (cek-cc-typ! (list '- z)) (cek-cc-typ! zm)
            (cek-exp-typ! (list '- z)) (cek-exp-typ! zm)
            (fact 'cc-exp-kernel-neg z)
            (dk-have! (list '= (list '- z) zm) (lambda () (crs)))
            (dk-congr! (list '= (list '- z) zm) (lambda (x) (list 'CC-EXP x)))
            (subst (list '= (list 'CC-EXP zm) (list 'CC-EXP (list '- z))))
            (ass))))
    e))
(define cek-N '(SEP ceky_ RR (AND (< ceky_ 0) (= (CC-EXP (* +i ceky_)) 1))))
(define (cek-in-N! y)                   ; (IN y N) from y in RR, y < 0, exp(iy) = 1
  (let ((g (list 'IN y cek-N)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass))))))))
    g))
(define (cek-open-N! y)                 ; from (IN y N): y in RR, y < 0, exp(iy) = 1 (membership consumed)
  (sep-me (dk-ctx-form (list 'IN y cek-N)))
  (dk-split-all!))
(sp (make-wff '(FORSOME ceka_ (AND (IN ceka_ RR) (AND (< 0 ceka_) (AND (= (CC-EXP (* +i ceka_)) 1)
  (FORALL cekt_ (IMPLIES (IN cekt_ RR) (IMPLIES (< 0 cekt_) (IMPLIES (= (CC-EXP (* +i cekt_)) 1) (<= ceka_ cekt_)))))))))))
(let* ((N cek-N) (T (dk-skolem! (dk-fact! 'cc-exp-imaginary-period-exists))) (mT (list '- T)) (b (list 'SUP N)) (a (list '- b)))
  (fact 'rr-zero-in)
  (cek-rr-typ! mT)
  (cek-neg-period! T)
  (dk-have! (list '< mT 0) (lambda () (dk-ineq! (list '< 0 T))))
  (cek-in-N! mT)
  (dk-have! (list 'IN N 'SET) (lambda () (sep-set) (fact 'rr-is-set) (ass)))
  (dk-have! (list 'FORSOME 'x (list 'IN 'x N)) (lambda () (ew mT) (ass)))
  (dk-have! (list 'SUBSET N 'RR)
    (lambda () (mac 'subset-def) (let ((y (cadr (dk-landed-1 (lambda () (di)))))) (cek-open-N! y) (ass))))
  (dk-have! (list 'RR-UPPER-BOUND N 0)
    (lambda ()
      (mac 'rr-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN) (ass)
              (let ((y (cadr (dk-landed-1 (lambda () (di))))))
                (cek-open-N! y)
                (dk-ineq! (list '< y 0))))))))
  (dk-have! (list 'RR-BOUNDED-ABOVE N) (lambda () (mac 'rr-bounded-above) (ew 0) (ass)))
  (fact 'rr-sup-in N)
  (fact 'rr-sup-upper N)
  (fact 'rr-sup-least N)
  (mac-h 'rr-upper-bound (list 'RR-UPPER-BOUND N b))
  (dk-split-all!)
  (let ((ub (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUP) (not (dk-contains? f 'RR-UPPER-BOUND)))) "the sup bounds N"))
        (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RR-UPPER-BOUND))) "the sup is least")))
    ;; b <= -1/2
    (cek-rr-typ! -1/2)
    (dk-have! (list 'RR-UPPER-BOUND N -1/2)
      (lambda ()
        (mac 'rr-upper-bound)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN) (ass)
                (let ((y (cadr (dk-landed-1 (lambda () (di))))))
                  (cek-open-N! y)
                  (cek-rr-typ! (list '- y))
                  (dk-have! (list '< 0 (list '- y)) (lambda () (dk-ineq! (list '< y 0))))
                  (cek-neg-period! y)
                  (fact 'cek-period-ge-half (list '- y))
                  (dk-ineq! (list '<= 1/2 (list '- y)))))))))
    (dk-apply! least -1/2)
    (cek-rr-typ! a)
    (dk-have! (list '< 0 a) (lambda () (dk-ineq! (list '<= b -1/2))))
    ;; the approximation: some y in N lies in (b - d, b]
    (cek-rr-typ! 1/2)
    (dk-have! (list '< 0 1/2) (lambda () (dk-ineq!)))
    (let* ((y1 (dk-skolem! (dk-fact! 'rr-sup-approx N 1/2))))
      (dk-apply! ub y1)
      (cek-open-N! y1)
      (dk-have! (list '= (list 'CC-EXP (list '* +i a)) 1)
        (lambda ()
          (use-cases (dk-fact! 'rr-lt-trichotomy y1 b)
            (lambda ()
              (let* ((e (list '- b y1)))
                (cek-rr-typ! e)
                (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< y1 b))))
                (let* ((y2 (dk-skolem! (dk-fact! 'rr-sup-approx N e))) (d (list '- y2 y1)))
                  (dk-apply! ub y2)
                  (cek-open-N! y2)
                  (cek-rr-typ! d)
                  (fact 'rr-subset-cc y1) (fact 'rr-subset-cc y2)
                  (cek-cc-typ! (list '* +i y1)) (cek-cc-typ! (list '* +i y2))
                  (fact 'cc-exp-kernel-sub (list '* +i y2) (list '* +i y1))
                  (fact 'rr-subset-cc d)
                  (let ((dd (list '- (list '* +i y2) (list '* +i y1))) (id (list '* +i d)))
                    (cek-cc-typ! dd) (cek-cc-typ! id) (cek-exp-typ! dd) (cek-exp-typ! id)
                    (dk-have! (list '= dd id) (lambda () (crs)))
                    (dk-congr! (list '= dd id) (lambda (x) (list 'CC-EXP x)))
                    (dk-have! (list '= (list 'CC-EXP id) 1) (lambda () (subst (list '= (list 'CC-EXP id) (list 'CC-EXP dd))) (ass))))
                  (dk-have! (list '< 0 d) (lambda () (dk-ineq! (list '< (list '- b e) y2))))
                  (fact 'cek-period-ge-half d)
                  (cek-absurd! (list '<= 1/2 d) (list '<= y2 b) (list '< (list '- b 1/2) y1)))))
            (lambda ()
              (cek-neg-period! y1)
              (let ((z1 (list '* +i (list '- y1))) (za (list '* +i a)))
                (fact 'rr-subset-cc (list '- y1)) (fact 'rr-subset-cc a)
                (cek-cc-typ! z1) (cek-cc-typ! za) (cek-exp-typ! z1) (cek-exp-typ! za)
                (dk-have! (list '= z1 za) (lambda () (subst (list '= y1 b)) (rfl)))
                (dk-congr! (list '= z1 za) (lambda (x) (list 'CC-EXP x)))
                (subst (list '= (list 'CC-EXP za) (list 'CC-EXP z1)))
                (ass)))
            (lambda () (cek-absurd! (list '< b y1) (list '<= y1 b))))))
      (ew a)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (if (dk-head-is? g 'FORALL)
                (let* ((ld (dk-peel!)) (t (cek-land-var ld 'RR)))
                  (cek-rr-typ! (list '- t))
                  (dk-have! (list '< (list '- t) 0) (lambda () (dk-ineq! (list '< 0 t))))
                  (cek-neg-period! t)
                  (cek-in-N! (list '- t))
                  (dk-apply! ub (list '- t))
                  (dk-ineq! (list '<= (list '- t) b)))
                (ass))))))))
(qed 'cc-exp-least-period)

;;; ======================================================================
;;; (Z) K = ZZ (i a) FOR THE LEAST PERIOD a.  Integer multiples of a kernel
;;; element are in the kernel (induction on NN, then negation); conversely a
;;; period t >= 0 below n a is k a for some k in NN (induction on n: subtract a,
;;; or t < a and minimality give t = 0), and the archimedean property gives n.
;;; ======================================================================
(sp (make-wff '(FORALL cekn_ (IMPLIES (IN cekn_ NN) (FORALL cekw_ (IMPLIES (IN cekw_ CC)
  (IMPLIES (= (CC-EXP cekw_) 1) (= (CC-EXP (* cekn_ cekw_)) 1))))))))
(cek-ind!
  (lambda ()
    (let* ((ld (dk-peel!)) (w (cek-land-var ld 'CC)) (m (list '* 0 w)))
      (cek-cc-typ! m) (cek-exp-typ! m) (cek-exp-typ! 0)
      (dk-have! (list '= m 0) (lambda () (crs)))
      (dk-congr! (list '= m 0) (lambda (x) (list 'CC-EXP x)))
      (subst (list '= (list 'CC-EXP m) '(CC-EXP 0)))
      (fact 'cc-exp-zero)
      (ass)))
  (lambda (v ih)
    (let* ((ld (dk-peel!)) (w (cek-land-var ld 'CC)) (vw (list '* v w)) (sv (list 'succ v)) (m (list '* sv w)) (s (list '+ vw w)))
      (fact 'nn-in-rr v) (fact 'rr-subset-cc v) (cek-cc-typ! sv)
      (cek-cc-typ! vw) (cek-cc-typ! m) (cek-cc-typ! s) (cek-exp-typ! m) (cek-exp-typ! s)
      (fact 'nn-succ-plus-one v)
      (dk-have! (list '= m s) (lambda () (subst (list '= sv (list '+ v 1))) (crs)))
      (dk-congr! (list '= m s) (lambda (x) (list 'CC-EXP x)))
      (dk-apply! ih w)
      (fact 'cc-exp-kernel-add vw w)
      (subst (list '= (list 'CC-EXP m) (list 'CC-EXP s)))
      (ass))))
(qed 'cek-kernel-nn-multiple)

(define (cek-leq-total! a b)
  (cek-rr-typ! a) (cek-rr-typ! b)
  (cek-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (dk-fact! 'rr-leq-total a b))
(sp (make-wff '(FORALL cekw_ (IMPLIES (IN cekw_ CC) (IMPLIES (= (CC-EXP cekw_) 1)
  (FORALL cekk_ (IMPLIES (IN cekk_ ZZ) (= (CC-EXP (* cekk_ cekw_)) 1))))))))
(dk-peel!)
(let* ((k 'cekk_) (w 'cekw_) (kw (list '* k w)))
  (fact 'zz-in-rr k) (fact 'rr-subset-cc k) (fact 'rr-zero-in)
  (cek-cc-typ! kw) (cek-exp-typ! kw)
  (use-cases (cek-leq-total! 0 k)
    (lambda ()
      (fact 'zz-nonneg-in-nn k)
      (fact 'cek-kernel-nn-multiple k w)
      (ass))
    (lambda ()
      (let* ((mk (list '- k)) (mkw (list '* mk w)))
        (fact 'zz-neg-closed k)
        (cek-rr-typ! mk)
        (dk-have! (list '<= 0 mk) (lambda () (dk-ineq! (list '<= k 0))))
        (fact 'zz-nonneg-in-nn mk)
        (fact 'rr-subset-cc mk)
        (cek-cc-typ! mkw) (cek-cc-typ! (list '- mkw)) (cek-exp-typ! (list '- mkw))
        (fact 'cek-kernel-nn-multiple mk w)
        (fact 'cc-exp-kernel-neg mkw)
        (dk-have! (list '= (list '- mkw) kw) (lambda () (crs)))
        (dk-congr! (list '= (list '- mkw) kw) (lambda (x) (list 'CC-EXP x)))
        (subst (list '= (list 'CC-EXP kw) (list 'CC-EXP (list '- mkw))))
        (ass)))))
(qed 'cc-exp-kernel-zz-multiple)

(define (cek-least-of a)
  (list 'FORALL 'cekt_ (list 'IMPLIES '(IN cekt_ RR) (list 'IMPLIES '(< 0 cekt_)
    (list 'IMPLIES '(= (CC-EXP (* +i cekt_)) 1) (list '<= a 'cekt_))))))
;;; exp(i(r - a)) = 1 from exp(ir) = 1 and exp(ia) = 1, landed
(define (cek-sub-period! r a)
  (let* ((q (list '- r a)) (ir (list '* +i r)) (ia (list '* +i a)) (iq (list '* +i q)) (d (list '- ir ia))
         (e (list '= (list 'CC-EXP iq) 1)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'rr-subset-cc r) (fact 'rr-subset-cc a) (cek-rr-typ! q) (fact 'rr-subset-cc q)
            (cek-cc-typ! ir) (cek-cc-typ! ia) (cek-cc-typ! iq) (cek-cc-typ! d)
            (cek-exp-typ! iq) (cek-exp-typ! d)
            (fact 'cc-exp-kernel-sub ir ia)
            (dk-have! (list '= d iq) (lambda () (crs)))
            (dk-congr! (list '= d iq) (lambda (x) (list 'CC-EXP x)))
            (subst (list '= (list 'CC-EXP iq) (list 'CC-EXP d)))
            (ass))))
    e))
(sp (make-wff (list 'FORALL 'cekn_ (list 'IMPLIES '(IN cekn_ NN) (list 'FORALL 'ceka_ (list 'IMPLIES '(IN ceka_ RR)
  (list 'IMPLIES '(< 0 ceka_) (list 'IMPLIES '(= (CC-EXP (* +i ceka_)) 1) (list 'IMPLIES (cek-least-of 'ceka_)
    '(FORALL cekr_ (IMPLIES (IN cekr_ RR) (IMPLIES (<= 0 cekr_) (IMPLIES (< cekr_ (* cekn_ ceka_))
       (IMPLIES (= (CC-EXP (* +i cekr_)) 1) (FORSOME cekk_ (AND (IN cekk_ NN) (= cekr_ (* cekk_ ceka_))))))))))))))))))
(define (cek-pm-vars ld)                ; (a r): a the period (0 < a in context), r the other
  (let* ((vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (eq? (caddr f) 'RR))) ld)))
         (a (find-first (lambda (v) (dk-asm? (list '< 0 v))) vs))
         (r (find-first (lambda (v) (not (eq? v a))) vs)))
    (list a r)))
(cek-ind!
  (lambda ()
    (let* ((ld (dk-peel!)) (vs (cek-pm-vars ld)) (a (car vs)) (r (cadr vs)))
      (cek-rr-typ! (list '* 0 a))
      (cek-absurd! (list '<= 0 r) (list '< r (list '* 0 a)))))
  (lambda (v ih)
    (let* ((ld (dk-peel!)) (vs (cek-pm-vars ld)) (a (car vs)) (r (cadr vs))
           (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CC-EXP) (dk-contains? f a))) "minimality"))
           (sv (list 'succ v)))
      (fact 'nn-in-rr v) (cek-rr-typ! sv) (fact 'rr-zero-in)
      (cek-rr-typ! (list '* v a)) (cek-rr-typ! (list '* sv a))
      (let ((case2
             (lambda ()
               (let ((q (list '- r a)))
                 (cek-rr-typ! q)
                 (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '<= a r))))
                 (fact 'nn-succ-plus-one v)
                 (fact 'rr-subset-cc v) (fact 'rr-subset-cc a) (cek-cc-typ! sv)
                 (cek-cc-typ! (list '* v a)) (cek-cc-typ! (list '* sv a))
                 (dk-have! (list '= (list '* sv a) (list '+ (list '* v a) a)) (lambda () (subst (list '= sv (list '+ v 1))) (crs)))
                 (dk-have! (list '< q (list '* v a))
                   (lambda () (dk-ineq! (list '< r (list '* sv a)) (list '= (list '* sv a) (list '+ (list '* v a) a)))))
                 (cek-sub-period! r a)
                 (let* ((rest (dk-apply! ih a))
                        (k1 (dk-skolem! (dk-apply! rest q)))
                        (sk (list 'succ k1)))
                   (fact 'nn-in-rr k1) (fact 'rr-subset-cc k1) (fact 'nn-succ-plus-one k1)
                   (cek-nn-typ! sk) (cek-cc-typ! sk) (fact 'rr-subset-cc r)
                   (ew sk)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'IN)
                           (ass)
                           (begin
                             (subst (list '= sk (list '+ k1 1)))
                             (subst (cek-ring-id! '(cxra_ cxrb_) '(= (* (+ cxra_ 1) cxrb_) (+ (* cxra_ cxrb_) cxrb_)) (list k1 a)))
                             (subst (list '= (list '* k1 a) q))
                             (crs))))))))))
        (use-cases (dk-fact! 'rr-lt-trichotomy r a)
          (lambda ()
            (use-cases (dk-fact! 'rr-lt-trichotomy 0 r)
              (lambda ()
                (dk-apply! least r)
                (cek-absurd! (list '<= a r) (list '< r a)))
              (lambda ()
                (fact 'nn-zero-in)
                (ew 0)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN) (ass)
                        (begin (subst (list '= r 0)) (fact 'rr-subset-cc a) (crs))))))
              (lambda () (cek-absurd! (list '< r 0) (list '<= 0 r)))))
          (lambda () (dk-have! (list '<= a r) (lambda () (dk-ineq! (list '= r a)))) (case2))
          (lambda () (dk-have! (list '<= a r) (lambda () (dk-ineq! (list '< a r)))) (case2)))))))
(qed 'cek-period-multiple-nn)

(sp (make-wff (list 'FORALL 'ceka_ (list 'IMPLIES '(IN ceka_ RR)
  (list 'IMPLIES '(< 0 ceka_) (list 'IMPLIES '(= (CC-EXP (* +i ceka_)) 1) (list 'IMPLIES (cek-least-of 'ceka_)
    '(FORALL cekr_ (IMPLIES (IN cekr_ RR) (IMPLIES (= (CC-EXP (* +i cekr_)) 1)
       (FORSOME cekk_ (AND (IN cekk_ ZZ) (= cekr_ (* cekk_ ceka_))))))))))))))
(dk-peel!)
(let* ((a 'ceka_) (r 'cekr_) (least (dk-ctx-form (cek-least-of 'ceka_))))
  (fact 'rr-zero-in)
  (cek-pos-rr! a)
  (let ((use-nn!
         (lambda (x)                     ; x >= 0 a period: lands (FORSOME k (AND (IN k NN) (= x (* k a))))
           (cek-rr-typ! (list '+ x a))
           (let* ((n (dk-skolem! (dk-apply! (dk-fact! 'rr-archimedean-multiple a) (list '+ x a)))))
             (cek-rr-typ! (list '* n a))
             (dk-have! (list '< x (list '* n a)) (lambda () (dk-ineq! (list '<= (list '+ x a) (list '* n a)) (list '< 0 a))))
             (dk-apply! (dk-apply! (dk-fact! 'cek-period-multiple-nn n a) x))))))
    (use-cases (cek-leq-total! 0 r)
      (lambda ()
        (let ((k (dk-skolem! (use-nn! r))))
          (fact 'nn-subset-zz k)
          (ew k)
          (dk-conj-close! (lambda () (ass)))))
      (lambda ()
        (let ((mr (list '- r)))
          (cek-rr-typ! mr)
          (dk-have! (list '<= 0 mr) (lambda () (dk-ineq! (list '<= r 0))))
          (cek-neg-period! r)
          (let* ((k (dk-skolem! (use-nn! mr))) (mk (list '- k)))
            (fact 'nn-subset-zz k)
            (fact 'zz-neg-closed k)
            (fact 'nn-in-rr k) (fact 'rr-subset-cc k) (fact 'rr-subset-cc a) (fact 'rr-subset-cc r)
            (cek-cc-typ! mk)
            (ew mk)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (begin
                      (subst (cek-ring-id! '(cxra_ cxrb_) '(= (* (- cxra_) cxrb_) (- (* cxra_ cxrb_))) (list k a)))
                      (subst (list '= (list '* k a) mr))
                      (crs)))))))))))
(qed 'cek-period-multiple-zz)

;;; ======================================================================
;;; (PI) EXISTENCE AND UNIQUENESS of the p that the definition of PI describes
;;; (structure-library/cc-pi.scm): p = a/2 for the least period a.
;;; ======================================================================
(define (cek-P p)
  (list 'AND (list 'IN p 'RR)
        (list 'AND (list '< 0 p)
              (list 'FORALL 'cekz_
                (list 'IMPLIES '(IN cekz_ CC)
                  (list 'IFF '(= (CC-EXP cekz_) 1)
                        (list 'FORSOME 'cekk_
                          (list 'AND '(IN cekk_ ZZ)
                                (list '= 'cekz_ (list '* 'cekk_ (list '* (list '* 2 p) +i)))))))))))
(sp (make-wff (list 'FORSOME 'cekp_ (cek-P 'cekp_))))
(let* ((a (dk-skolem! (dk-fact! 'cc-exp-least-period))) (p (list '* 1/2 a)) (g (list '* (list '* 2 p) +i)) (ia (list '* +i a)))
  (cek-rr-typ! p)
  (fact 'rr-subset-cc a)
  (cek-cc-typ! g) (cek-cc-typ! ia) (cek-exp-typ! g) (cek-exp-typ! ia)
  (dk-have! (list '= ia g) (lambda () (crs)))
  (dk-congr! (list '= ia g) (lambda (x) (list 'CC-EXP x)))
  (dk-have! (list '= (list 'CC-EXP g) 1) (lambda () (subst (list '= (list 'CC-EXP g) (list 'CC-EXP ia))) (ass)))
  (ew p)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
          ((dk-head-is? gl 'IN) (ass))
          ((dk-head-is? gl '<) (dk-ineq! (list '< 0 a)))
          (#t
           (let* ((ld (dk-peel!)) (z (cek-land-var ld 'CC)))
             (dk-iff! (dk-head? 'FORSOME)
               (lambda ()
                 (let ((t (list 'imag-part z)))
                   (fact 'cc-exp-kernel-on-imaginary-axis z)
                   (cek-rr-typ! t) (fact 'rr-subset-cc t) (cek-cc-typ! (list '* +i t))
                   (dk-have! (list '= (list 'CC-EXP (list '* +i t)) 1)
                     (lambda () (subst (list '= (list '* +i t) z)) (ass)))
                   (let ((k (dk-skolem! (dk-apply! (dk-fact! 'cek-period-multiple-zz a) t))))
                     (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
                     (ew k)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'IN) (ass)
                             (begin
                               (subst (list '= z (list '* +i t)))
                               (subst (list '= t (list '* k a)))
                               (crs))))))))
               (lambda ()
                 (let* ((ex (dk-pick (dk-head? 'FORSOME) "the multiple"))
                        (k (dk-skolem! ex)))
                   (subst (list '= z (list '* k g)))
                   (dk-apply! (dk-fact! 'cc-exp-kernel-zz-multiple g) k)
                   (ass)))))))))))
(qed 'cc-pi-exists)

;;; two such p: the larger is an integer multiple k >= 1 of the smaller
(sp (make-wff (list 'FORALL 'cekp_ (list 'FORALL 'cekq_ (list 'IMPLIES (cek-P 'cekp_) (list 'IMPLIES (cek-P 'cekq_)
  '(<= cekq_ cekp_)))))))
(dk-peel!)
(dk-split-all!)
(let* ((p 'cekp_) (q 'cekq_)
       (fp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f p))) "P(p)"))
       (fq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f q))) "P(q)"))
       (gp (list '* (list '* 2 p) +i)) (gq (list '* (list '* 2 q) +i)) (c (make-rectangular 0 -1/2)))
  (fact 'rr-subset-cc p) (fact 'rr-subset-cc q)
  (cek-cc-typ! gp) (cek-cc-typ! gq) (cek-exp-typ! gp)
  (let* ((ip (dk-apply! fp gp))
         (ims (dk-landed (lambda () (ai ip))))
         (bw (find-first (lambda (f) (dk-head-is? (cadr f) 'FORSOME)) ims)))
    (dk-have! (cadr bw)
      (lambda ()
        (fact 'nn-one-in) (fact 'nn-subset-zz 1)
        (ew 1)
        (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (crs))))))
    (detach! bw))
  (let* ((iq (dk-apply! fq gp))
         (ims (dk-landed (lambda () (ai iq))))
         (fw (find-first (lambda (f) (dk-head-is? (cadr f) '=)) ims)))
    (detach! fw))
  (let* ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the multiple")))
         (kq (list '* k q)) (kg (list '* k gq)))
    (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
    (dk-have! (list 'IN c 'CC) (lambda () (arith)))
    (cek-cc-typ! kg) (cek-cc-typ! (list '* kg c)) (cek-cc-typ! (list '* gp c))
    (dk-congr! (list '= gp kg) (lambda (u) (list '* u c)))
    (cek-rr-typ! kq) (fact 'rr-subset-cc kq)
    (dk-have! (list '= p kq)
      (lambda ()
        (subst (cek-ring-id! '(cxra_ cxrb_) (list '= '(* cxra_ cxrb_) (list '* (list '* 'cxra_ '(* (* 2 cxrb_) +i)) c)) (list k q)))
        (subst (list '= (list '* kg c) (list '* gp c)))
        (crs)))
    (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
      (lambda ()
        (fact 'rr-zero-in)
        (dk-have! (list '<= k 0) (lambda () (dk-ineq! (list '< k 0))))
        (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
        (fact 'rr-mul-le-right k 0 q)
        (cek-absurd! (list '<= kq (list '* 0 q)) (list '= p kq) (list '< 0 p)))
      (lambda ()
        (dk-have! (list '= p 0) (lambda () (subst (list '= p kq)) (subst (list '= k 0)) (crs)))
        (cek-absurd! (list '= p 0) (list '< 0 p)))
      (lambda ()
        (fact 'zz-discrete k)
        (fact 'rr-one-in)
        (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
        (fact 'rr-mul-le-right 1 k q)
        (dk-ineq! (list '<= (list '* 1 q) kq) (list '= p kq))))))
(qed 'cek-pi-le)

(sp (make-wff (list 'FORALL 'cekp_ (list 'FORALL 'cekq_ (list 'IMPLIES (cek-P 'cekp_) (list 'IMPLIES (cek-P 'cekq_)
  '(= cekp_ cekq_)))))))
(dk-peel!)
(fact 'cek-pi-le 'cekp_ 'cekq_)
(fact 'cek-pi-le 'cekq_ 'cekp_)
(dk-split-all!)
(cek-and! '(IN cekp_ RR) '(IN cekq_ RR))
(cek-and! '(<= cekp_ cekq_) '(<= cekq_ cekp_))
(fact 'rr-leq-antisymmetric 'cekp_ 'cekq_)
(ass)
(qed 'cc-pi-unique)

;;; ======================================================================
;;; (S) pi-spec: THE CHARACTERISATION OF PI, by `iota-d' from cc-pi-exists and
;;; cc-pi-unique (the definition, structure-library/cc-pi.scm, is the IOTA).
;;; Then Lemma 2.18 and the special values.
;;; ======================================================================
(sp (make-wff (cek-P 'PI)))
(fact 'pi-def)
(define cek-io (caddr (dk-pick (lambda (f) (and (dk-head-is? f '==) (eq? (cadr f) 'PI))) "the definition of PI")))
(subst (list '= 'PI cek-io))
(for-each
  (lambda (k)
    (dk-focus! k)
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (let ((w (dk-skolem! (dk-fact! 'cc-pi-exists) #f)))
          (ew w)
          (for-each
            (lambda (k2)
              (dk-focus! k2)
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((ld (dk-peel!)) (y (caddr (dk-goal))))
                    (fact 'cc-pi-unique w y)
                    (ass))
                  (ass)))
            (dk-opened (lambda () (di)))))
        (ass)))
  (dk-opened (lambda () (iota-d cek-io))))
(qed 'pi-spec)

(sp (make-wff '(AND (IN PI RR) (< 0 PI))))
(fact 'pi-spec)
(dk-split-all!)
(dk-conj-close! (lambda () (ass)))
(qed 'pi-pos)

;;; LEMMA 2.18: exp z = 1 iff z = 2 pi i k for an integer k
(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (IFF (= (CC-EXP cekz_) 1)
  (FORSOME cekk_ (AND (IN cekk_ ZZ) (= cekz_ (* cekk_ (* (* 2 PI) +i))))))))))
(fact 'pi-spec)
(dk-split-all!)
(ass)
(qed 'cc-exp-one-iff)

;;; the iff at z, as two landed implications; returns (FWD . BWD)
(define (cek-one-iff! z)
  (cek-cc-typ! z)
  (let* ((i (dk-apply! (dk-fact! 'cc-exp-one-iff) z))
         (ims (dk-landed (lambda () (ai i)))))
    (cons (find-first (lambda (f) (dk-head-is? (cadr f) '=)) ims)
          (find-first (lambda (f) (dk-head-is? (cadr f) 'FORSOME)) ims))))
(define (cek-pi-typ!)
  (if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
  (fact 'rr-subset-cc 'PI))
(define cek-2pii '(* (* 2 PI) +i))

(sp (make-wff (list '= (list 'CC-EXP cek-2pii) 1)))
(cek-pi-typ!)
(let ((bw (cdr (cek-one-iff! cek-2pii))))
  (dk-have! (cadr bw)
    (lambda ()
      (fact 'nn-one-in) (fact 'nn-subset-zz 1)
      (ew 1)
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (crs))))))
  (detach! bw)
  (ass))
(qed 'cc-exp-two-pi-i)

;;; exp(i t) for t = 2 pi, as i (2 pi) = (2 pi) i
(define (cek-exp-it-eq! t u)             ; lands (= (CC-EXP (* +i t)) (CC-EXP u)) when (* +i t) = u by crs
  (let ((it (list '* +i t)))
    (cek-cc-typ! it) (cek-cc-typ! u) (cek-exp-typ! it) (cek-exp-typ! u)
    (dk-have! (list '= it u) (lambda () (crs)))
    (dk-congr! (list '= it u) (lambda (x) (list 'CC-EXP x)))))
(sp (make-wff '(AND (= (CC-COS (* 2 PI)) 1) (= (CC-SIN (* 2 PI)) 0))))
(cek-pi-typ!)
(let* ((t '(* 2 PI)) (w (list 'CC-EXP (list '* +i t))))
  (cek-rr-typ! t) (fact 'rr-subset-cc t)
  (cek-exp-it-eq! t cek-2pii)
  (fact 'cc-exp-two-pi-i)
  (fact 'cc-cos-real-part t)
  (fact 'cc-sin-real-part t)
  (dk-conj-close!
    (lambda ()
      (subst (if (dk-contains? (dk-goal) 'CC-COS) (list '= (list 'CC-COS t) (list 'real-part w)) (list '= (list 'CC-SIN t) (list 'imag-part w))))
      (subst (list '= w (list 'CC-EXP cek-2pii)))
      (subst (list '= (list 'CC-EXP cek-2pii) 1))
      (arith))))
(qed 'cc-cos-sin-two-pi)

;;; (= (imag-part X) Y) landed, for X a complex term equal (crs) to Y i with Y real
(define (cek-im-eq! x y)
  (let ((e (list '= (list 'imag-part x) y)) (yi (list '* y +i)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (cek-rr-typ! y) (fact 'rr-subset-cc y) (cek-cc-typ! x) (cek-cc-typ! yi)
            (if (not (equal? x yi))
                (begin
                  (dk-have! (list '= x yi) (lambda () (crs)))
                  (subst (list '= x yi))))
            (subst (dk-fact! 'cc-im-real-mul y +i))
            (dk-have! (list '= (list 'imag-part +i) 1) (lambda () (arith)))
            (subst (list '= (list 'imag-part +i) 1))
            (crs))))
    e))
(define (cek-pi-eqs ip k)
  (let ((rhs (list '* k cek-2pii)))
    (list (list '= (list 'imag-part ip) (list 'imag-part rhs)) (list '= (list 'imag-part ip) 'PI)
          (list '= (list 'imag-part rhs) (list '* 2 (list '* k 'PI))))))
;;; exp(i pi) = -1: its square is exp(2 pi i) = 1, and it is not 1 (pi i is not
;;; an integer multiple of 2 pi i)
(sp (make-wff '(= (CC-EXP (* +i PI)) -1)))
(cek-pi-typ!)
(let* ((ip '(* +i PI)) (u (list 'CC-EXP ip)) (s (list '+ ip ip)))
  (cek-cc-typ! ip) (cek-exp-typ! ip) (cek-cc-typ! s) (cek-exp-typ! s) (cek-cc-typ! cek-2pii) (cek-exp-typ! cek-2pii)
  (fact 'cc-exp-two-pi-i)
  (cek-and! (list 'IN ip 'CC) (list 'IN ip 'CC))
  (fact 'cc-exp-add ip ip)
  (dk-have! (list '= s cek-2pii) (lambda () (crs)))
  (dk-congr! (list '= s cek-2pii) (lambda (x) (list 'CC-EXP x)))
  (cek-cc-typ! (list '* u u))
  (dk-have! (list '= (list '* u u) 1)
    (lambda ()
      (subst (list '= (list '* u u) (list 'CC-EXP s)))
      (subst (list '= (list 'CC-EXP s) (list 'CC-EXP cek-2pii)))
      (ass)))
  ;; u /= 1
  (dk-have! (list 'NOT (list '= u 1))
    (lambda ()
      (di)
      (detach! (car (cek-one-iff! ip)))
      (let* ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the multiple"))) (kp (list '* k 'PI)))
        (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
        (cek-rr-typ! kp) (fact 'rr-subset-cc kp)
        (let* ((rhs (list '* k cek-2pii)) (e1 (list '= (list 'imag-part ip) 'PI)) (e2 (list '= (list 'imag-part rhs) (list '* 2 kp))))
          (cek-cc-typ! rhs)
          (cek-rr-typ! (list 'imag-part ip)) (cek-rr-typ! (list 'imag-part rhs))
          (dk-congr! (list '= ip rhs) (lambda (x) (list 'imag-part x)))
          (cek-im-eq! ip 'PI)
          (cek-im-eq! rhs (list '* 2 kp)))
        (fact 'rr-zero-in)
        (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
          (lambda ()
            (dk-have! (list '<= k 0) (lambda () (dk-ineq! (list '< k 0))))
            (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
            (fact 'rr-mul-le-right k 0 'PI)
            (apply cek-absurd! (list '<= kp '(* 0 PI)) '(< 0 PI) (cek-pi-eqs ip k)))
          (lambda ()
            (dk-have! (list '= kp 0) (lambda () (subst (list '= k 0)) (crs)))
            (apply cek-absurd! (list '= kp 0) '(< 0 PI) (cek-pi-eqs ip k)))
          (lambda ()
            (fact 'zz-discrete k)
            (fact 'rr-one-in)
            (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
            (fact 'rr-mul-le-right 1 k 'PI)
            (apply cek-absurd! (list '<= '(* 1 PI) kp) '(< 0 PI) (cek-pi-eqs ip k)))))))
  ;; u^2 = 1, u /= 1  ==>  u = -1
  (let ((um (list '- u 1)) (up (list '+ u 1)))
    (cek-cc-typ! um) (cek-cc-typ! up) (cek-cc-typ! (list '* um up))
    (dk-have! (list 'NOT (list '= um 0))
      (lambda ()
        (di)
        (dk-have! (list '= u 1)
          (lambda ()
            (subst (cek-ring-id! '(cxra_) '(= cxra_ (+ (- cxra_ 1) 1)) (list u)))
            (subst (list '= um 0))
            (arith)))
        (ai (list 'NOT (list '= u 1)))))
    (use-em (list '= up 0)
      (lambda ()
        (subst (cek-ring-id! '(cxra_) '(= cxra_ (- (+ cxra_ 1) 1)) (list u)))
        (subst (list '= up 0))
        (arith))
      (lambda ()
        (fact 'cc-mul-nonzero um up)
        (dk-have! (list '= (list '* um up) 0)
          (lambda ()
            (subst (cek-ring-id! '(cxra_) '(= (* (- cxra_ 1) (+ cxra_ 1)) (- (* cxra_ cxra_) 1)) (list u)))
            (subst (list '= (list '* u u) 1))
            (arith)))
        (ai (list 'NOT (list '= (list '* um up) 0)))))))
(qed 'cc-exp-i-pi)

(sp (make-wff '(AND (= (CC-COS PI) -1) (= (CC-SIN PI) 0))))
(cek-pi-typ!)
(let ((w '(CC-EXP (* +i PI))))
  (cek-exp-typ! '(* +i PI))
  (fact 'cc-exp-i-pi)
  (fact 'cc-cos-real-part 'PI)
  (fact 'cc-sin-real-part 'PI)
  (dk-conj-close!
    (lambda ()
      (subst (if (dk-contains? (dk-goal) 'CC-COS) (list '= '(CC-COS PI) (list 'real-part w)) (list '= '(CC-SIN PI) (list 'imag-part w))))
      (subst (list '= w -1))
      (arith))))
(qed 'cc-cos-sin-pi)

;;; cos(pi/2) = 0 and sin(pi/2)^2 = 1: v = exp(i pi/2) has v^2 = exp(i pi) = -1
;;; and |v| = 1, so Re(v)^2 - Im(v)^2 = -1 and Re(v)^2 + Im(v)^2 = 1.
(sp (make-wff '(AND (= (CC-COS (* 1/2 PI)) 0) (= (power (CC-SIN (* 1/2 PI)) 2) 1))))
(cek-pi-typ!)
(let* ((h '(* 1/2 PI)) (ih (list '* +i h)) (v (list 'CC-EXP ih)) (s2 (list '+ ih ih))
       (re (list 'real-part v)) (im (list 'imag-part v)) (cc (list '* re re)) (ss (list '* im im)))
  (cek-rr-typ! h) (fact 'rr-subset-cc h)
  (cek-cc-typ! ih) (cek-exp-typ! ih) (cek-cc-typ! s2) (cek-exp-typ! s2)
  (cek-exp-typ! '(* +i PI))
  (fact 'cc-exp-i-pi)
  (cek-and! (list 'IN ih 'CC) (list 'IN ih 'CC))
  (fact 'cc-exp-add ih ih)
  (dk-have! (list '= s2 '(* +i PI)) (lambda () (crs)))
  (dk-congr! (list '= s2 '(* +i PI)) (lambda (x) (list 'CC-EXP x)))
  (cek-cc-typ! (list '* v v))
  (dk-have! (list '= (list '* v v) -1)
    (lambda ()
      (subst (list '= (list '* v v) (list 'CC-EXP s2)))
      (subst (list '= (list 'CC-EXP s2) '(CC-EXP (* +i PI))))
      (ass)))
  (cek-rr-typ! re) (cek-rr-typ! im) (cek-rr-typ! cc) (cek-rr-typ! ss)
  (cek-rr-typ! (list 'real-part (list '* v v)))
  (dk-have! '(IN -1 CC) (lambda () (arith)))
  (cek-rr-typ! '(real-part -1))
  (dk-congr! (list '= (list '* v v) -1) (lambda (x) (list 'real-part x)))
  (dk-have! '(= (real-part -1) -1) (lambda () (arith)))
  (fact 'cc-re-mul v v)
  (fact 'cc-exp-magnitude-imaginary h)
  (fact 'cc-magnitude-sq v)
  (cek-rr-typ! (list 'magnitude v))
  (cek-rr-typ! (list '* (list 'magnitude v) (list 'magnitude v)))
  (dk-have! (list '= (list '* (list 'magnitude v) (list 'magnitude v)) 1)
    (lambda () (subst (list '= (list 'magnitude v) 1)) (arith)))
  (let ((prem (list (list '= (list 'real-part (list '* v v)) '(real-part -1)) '(= (real-part -1) -1)
                    (list '= (list 'real-part (list '* v v)) (list '- cc ss))
                    (list '= (list '* (list 'magnitude v) (list 'magnitude v)) (list '+ cc ss))
                    (list '= (list '* (list 'magnitude v) (list 'magnitude v)) 1))))
    (dk-have! (list '= cc 0)
      (lambda ()
        (fact 'rr-zero-in)
        (dk-have! (list '<= cc 0) (lambda () (apply dk-ineq! prem)))
        (dk-have! (list '<= 0 cc) (lambda () (apply dk-ineq! prem)))
        (cek-and! (list 'IN cc 'RR) '(IN 0 RR))
        (cek-and! (list '<= cc 0) (list '<= 0 cc))
        (fact 'rr-leq-antisymmetric cc 0)
        (ass)))
    (dk-have! (list '= ss 1)
      (lambda ()
        (fact 'rr-one-in)
        (dk-have! (list '<= ss 1) (lambda () (apply dk-ineq! prem)))
        (dk-have! (list '<= 1 ss) (lambda () (apply dk-ineq! prem)))
        (cek-and! (list 'IN ss 'RR) '(IN 1 RR))
        (cek-and! (list '<= ss 1) (list '<= 1 ss))
        (fact 'rr-leq-antisymmetric ss 1)
        (ass))))
  (fact 'rr-subset-cc re)
  (dk-have! (list '= re 0)
    (lambda ()
      (use-em (list '= re 0)
        (lambda () (ass))
        (lambda ()
          (fact 'cc-mul-nonzero re re)
          (ai (list 'NOT (list '= cc 0)))))))
  (fact 'cc-cos-real-part h)
  (fact 'cc-sin-real-part h)
  (cek-sin-typ! h)
  (cek-pow2! (list 'CC-SIN h))
  (dk-conj-close!
    (lambda ()
      (if (dk-contains? (dk-goal) 'CC-COS)
          (begin (subst (list '= (list 'CC-COS h) re)) (ass))
          (begin
            (subst (list '= (list 'power (list 'CC-SIN h) 2) (list '* (list 'CC-SIN h) (list 'CC-SIN h))))
            (subst (list '= (list 'CC-SIN h) im))
            (ass))))))
(qed 'cc-cos-sin-half-pi)

;;; ======================================================================
;;; PROPOSITION 2.19 (the injectivity half): exp is injective on the strip
;;; S = {z : -pi <= Im z < pi}.  exp z = exp w gives exp(z - w) = 1, so
;;; z - w = 2 pi i k (2.18) with |Im(z - w)| < 2 pi, hence k = 0.
;;; ======================================================================
(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (FORALL cekw_ (IMPLIES (IN cekw_ CC)
  (IMPLIES (<= (- PI) (imag-part cekz_)) (IMPLIES (< (imag-part cekz_) PI)
  (IMPLIES (<= (- PI) (imag-part cekw_)) (IMPLIES (< (imag-part cekw_) PI)
  (IMPLIES (= (CC-EXP cekz_) (CC-EXP cekw_)) (= cekz_ cekw_))))))))))))
(dk-peel!)
(cek-pi-typ!)
(let* ((z 'cekz_) (w 'cekw_) (d '(- cekz_ cekw_)) (mw '(- cekw_)) (zm (list '+ z mw)))
  (cek-cc-typ! d) (cek-cc-typ! mw) (cek-cc-typ! zm)
  (cek-exp-typ! d) (cek-exp-typ! zm) (cek-exp-typ! z) (cek-exp-typ! w) (cek-exp-typ! mw)
  (cek-shift0! w)
  (cek-and! (list 'IN z 'CC) (list 'IN mw 'CC))
  (fact 'cc-exp-add z mw)
  (dk-have! (list '= d zm) (lambda () (crs)))
  (dk-congr! (list '= d zm) (lambda (x) (list 'CC-EXP x)))
  (dk-have! (list '= (list 'CC-EXP d) 1)
    (lambda ()
      (subst (list '= (list 'CC-EXP d) (list 'CC-EXP zm)))
      (subst (list '= (list 'CC-EXP zm) (list '* (list 'CC-EXP z) (list 'CC-EXP mw))))
      (subst (list '= (list 'CC-EXP z) (list 'CC-EXP w)))
      (ass)))
  (detach! (car (cek-one-iff! d)))
  (let* ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the multiple")))
         (kp (list '* k 'PI)) (rhs (list '* k cek-2pii))
         (imd (list 'imag-part d)) (iz '(imag-part cekz_)) (iw '(imag-part cekw_)))
    (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
    (cek-rr-typ! kp) (cek-cc-typ! rhs)
    (cek-rr-typ! imd) (cek-rr-typ! (list 'imag-part rhs)) (cek-rr-typ! iz) (cek-rr-typ! iw)
    (dk-congr! (list '= d rhs) (lambda (x) (list 'imag-part x)))
    (cek-im-eq! rhs (list '* 2 kp))
    (fact 'cc-im-sub z w)
    (let ((prem (list (list '= imd (list 'imag-part rhs)) (list '= (list 'imag-part rhs) (list '* 2 kp))
                      (list '= imd (list '- iz iw)) (list '<= '(- PI) iz) (list '< iz 'PI)
                      (list '<= '(- PI) iw) (list '< iw 'PI) '(< 0 PI))))
      (fact 'rr-zero-in) (fact 'rr-one-in)
      (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
      (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
        (lambda ()
          (let ((mk (list '- k)))
            (fact 'zz-neg-closed k)
            (cek-rr-typ! mk)
            (dk-have! (list '< 0 mk) (lambda () (dk-ineq! (list '< k 0))))
            (fact 'zz-discrete mk)
            (cek-rr-typ! -1)
            (dk-have! (list '<= k -1) (lambda () (dk-ineq! (list '<= 1 mk))))
            (fact 'rr-mul-le-right k -1 'PI)
            (apply cek-absurd! (list '<= kp '(* -1 PI)) prem)))
        (lambda ()
          (subst (cek-ring-id! '(cxra_ cxrb_) '(= cxra_ (+ (- cxra_ cxrb_) cxrb_)) (list z w)))
          (subst (list '= d rhs))
          (subst (list '= k 0))
          (crs))
        (lambda ()
          (fact 'zz-discrete k)
          (fact 'rr-mul-le-right 1 k 'PI)
          (apply cek-absurd! (list '<= '(* 1 PI) kp) prem))))))
(qed 'cc-exp-injective-strip)

;;; ======================================================================
;;; (G) THE GENERATOR OF K in the upper half plane: g = 2 pi i generates K, and
;;; it is the only generator with Im g > 0 (the user's definition, read back).
;;; ======================================================================
(define (cek-gen-of g)
  (list 'FORALL 'cekz_ (list 'IMPLIES '(IN cekz_ CC)
    (list 'IFF '(= (CC-EXP cekz_) 1)
          (list 'FORSOME 'cekk_ (list 'AND '(IN cekk_ ZZ) (list '= 'cekz_ (list '* 'cekk_ g))))))))
(sp (make-wff (list 'FORSOME 'cekg_ (list 'AND '(IN cekg_ CC) (list 'AND '(< 0 (imag-part cekg_)) (cek-gen-of 'cekg_))))))
(cek-pi-typ!)
(cek-cc-typ! cek-2pii)
(cek-rr-typ! (list 'imag-part cek-2pii))
(cek-im-eq! cek-2pii '(* 2 PI))
(fact 'pi-pos) (dk-split-all!)
(fact 'cc-exp-one-iff)
(ew cek-2pii)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) '<)
        (dk-ineq! (list '= (list 'imag-part cek-2pii) '(* 2 PI)) '(< 0 PI))
        (ass))))
(qed 'cc-exp-kernel-generator)

(sp (make-wff (list 'FORALL 'cekg_ (list 'IMPLIES '(IN cekg_ CC) (list 'IMPLIES '(< 0 (imag-part cekg_))
  (list 'IMPLIES (cek-gen-of 'cekg_) (list '= 'cekg_ cek-2pii)))))))
(dk-peel!)
(cek-pi-typ!)
(let* ((g 'cekg_) (h (dk-ctx-form (cek-gen-of 'cekg_))))
  ;; g is in K (k = 1), so g = i Im g
  (let* ((i (dk-apply! h g))
         (ims (dk-landed (lambda () (ai i))))
         (bw (find-first (lambda (f) (dk-head-is? (cadr f) 'FORSOME)) ims)))
    (dk-have! (cadr bw)
      (lambda ()
        (fact 'nn-one-in) (fact 'nn-subset-zz 1)
        (ew 1)
        (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (crs))))))
    (detach! bw))
  (fact 'cc-exp-kernel-on-imaginary-axis g)
  (cek-rr-typ! (list 'imag-part g))
  (dk-have! (list 'FORSOME 'cekyv_ (list '= 'cekyv_ (list 'imag-part g))) (lambda () (ew (list 'imag-part g)) (rfl)))
  (let* ((y (dk-skolem! (dk-ctx-form (list 'FORSOME 'cekyv_ (list '= 'cekyv_ (list 'imag-part g))))))
         (p (list '* 1/2 y)) (gg (list '* (list '* 2 p) +i)))
    (dk-have! (list 'IN y 'RR) (lambda () (subst (list '= y (list 'imag-part g))) (ass)))
    (cek-rr-typ! p) (fact 'rr-subset-cc y) (fact 'rr-subset-cc p) (cek-cc-typ! gg)
    (dk-have! (list '= g (list '* +i y))
      (lambda () (subst (list '= y (list 'imag-part g))) (ass)))
    (dk-have! (list '= g gg) (lambda () (subst (list '= g (list '* +i y))) (crs)))
    (dk-have! (cek-P p)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-head-is? gl 'IN) (ass))
                    ((dk-head-is? gl '<) (dk-ineq! (list '= y (list 'imag-part g)) (list '< 0 (list 'imag-part g))))
                    (#t
                     (let* ((ld (dk-peel!)) (z (cek-land-var ld 'CC)))
                       (subst (list '= gg g))
                       (dk-apply! h z)
                       (ass)))))))))
    (fact 'pi-spec)
    (fact 'cc-pi-unique p 'PI)
    (subst (list '= g gg))
    (subst (list '= 'PI p))
    (rfl)))
(qed 'cc-exp-kernel-generator-unique)

;;; ======================================================================
;;; (H) sin(pi/2) = 1.  The sign: pi < 4 (a period T = 4 t0 < 8 is a positive
;;; multiple of 2 pi), so x = pi/2 < 2, and on (0, 2] the exponential tail at
;;; m = 5 gives sin x >= x - x^3/6 - x^5/60 >= x/15 > 0; with sin^2 x = 1,
;;; sin x = 1.
;;; ======================================================================
(sp (make-wff '(< PI 4)))
(cek-pi-typ!)
(fact 'pi-pos) (dk-split-all!)
(let* ((T (dk-skolem! (dk-fact! 'cc-exp-imaginary-period-exists))) (iT (list '* +i T)))
  (fact 'rr-subset-cc T)
  (detach! (car (cek-one-iff! iT)))
  (let* ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the multiple")))
         (kp (list '* k 'PI)) (rhs (list '* k cek-2pii)))
    (fact 'zz-in-rr k) (fact 'rr-subset-cc k)
    (cek-rr-typ! kp) (cek-cc-typ! rhs)
    (cek-rr-typ! (list 'imag-part iT)) (cek-rr-typ! (list 'imag-part rhs))
    (dk-congr! (list '= iT rhs) (lambda (x) (list 'imag-part x)))
    (cek-im-eq! iT T)
    (cek-im-eq! rhs (list '* 2 kp))
    (let ((prem (list (list '= (list 'imag-part iT) (list 'imag-part rhs)) (list '= (list 'imag-part iT) T)
                      (list '= (list 'imag-part rhs) (list '* 2 kp)) (list '< 0 T) (list '< T 8) '(< 0 PI))))
      (fact 'rr-zero-in) (fact 'rr-one-in)
      (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
      (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
        (lambda ()
          (dk-have! (list '<= k 0) (lambda () (dk-ineq! (list '< k 0))))
          (fact 'rr-mul-le-right k 0 'PI)
          (apply cek-absurd! (list '<= kp '(* 0 PI)) prem))
        (lambda ()
          (dk-have! (list '= kp 0) (lambda () (subst (list '= k 0)) (crs)))
          (apply cek-absurd! (list '= kp 0) prem))
        (lambda ()
          (fact 'zz-discrete k)
          (fact 'rr-mul-le-right 1 k 'PI)
          (apply dk-ineq! (list '<= '(* 1 PI) kp) prem))))))
(qed 'cc-pi-lt-four)

;;; (= (power x n+1) (* x (power x n))) for a numeral n, landed
(define (cek-pow-succ! x n)
  (let* ((n1 (+ n 1)) (e (list '= (list 'power x n1) (list '* x (list 'power x n)))))
    (if (not (dk-asm? e))
        (let ((ps (list 'power x (list 'succ n))))
          (cek-cc-typ! x) (cek-nn-typ! n)
          (cek-and! (list 'IN x 'CC) (list 'IN n 'NN))
          (fact 'power-succ x n)
          (dk-have! (list '= (list 'succ n) n1) (lambda () (arith)))
          (cek-nn-typ! n1)
          (cek-cc-typ! ps) (cek-cc-typ! (list 'power x n1))
          (dk-congr! (list '= (list 'succ n) n1) (lambda (u) (list 'power x u)))
          (dk-have! e (lambda () (subst (list '= (list 'power x n1) ps)) (ass)))))
    e))
;;; (<= (* A C) (* B C)) from A <= B, 0 <= C: rr-mul-le-right, typed
(define (cek-mul-le! a b c)
  (cek-rr-typ! a) (cek-rr-typ! b) (cek-rr-typ! c)
  (cek-rr-typ! (list '* a c)) (cek-rr-typ! (list '* b c))
  (dk-cite! 'rr-mul-le-right a b c))
(sp (make-wff '(= (CC-SIN (* 1/2 PI)) 1)))
(cek-pi-typ!)
(fact 'pi-pos) (dk-split-all!)
(fact 'cc-pi-lt-four)
(let* ((x '(* 1/2 PI)) (z (list '* +i x)) (s (list 'CC-SIN x)) (s5 (list 'CC-SERIES-PARTIAL-SUM (cek-el z) 5))
       (p2 (list 'power x 2)) (p3 (list 'power x 3)) (p4 (list 'power x 4)) (p5 (list 'power x 5))
       (ra (list '+ (list '- 1 (list '* 1/2 p2)) (list '* 1/24 p4)))
       (ib (list '- x (list '* 1/6 p3)))
       (v (list '+ ra (list '* ib +i)))
       (b (list '* 2 (list '* '(recip (FACTORIAL 5)) (list 'power (list 'magnitude z) 5)))))
  (cek-rr-typ! x) (fact 'rr-subset-cc x)
  (dk-have! (list '< 0 x) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-have! (list '<= 0 x) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-have! (list '<= x 2) (lambda () (dk-ineq! '(< PI 4))))
  (cek-cc-typ! z)
  (cek-mag-it! x)
  (fact 'rr-abs-of-nonneg x)
  (cek-rr-typ! (list 'magnitude z)) (cek-rr-typ! (list 'abs x))
  (cek-nn-typ! 5)
  (dk-have! '(= (succ 5) 6) (lambda () (arith)))
  (cek-rr-typ! '(succ 5))
  (dk-have! (list '<= (list '* 2 (list 'magnitude z)) '(succ 5))
    (lambda () (dk-ineq! (list '= (list 'magnitude z) (list 'abs x)) (list '= (list 'abs x) x) (list '<= x 2) '(= (succ 5) 6))))
  (dk-fact! 'cc-exp-tail z 5)
  (for-each cek-rr-typ! (list p2 p3 p4 p5 ra ib))
  (for-each (lambda (t) (fact 'rr-subset-cc t)) (list p2 p3 p4 p5 ra ib))
  (cek-psum-val! z 5 v (lambda () (crs)))
  ;; |sin x - (x - x^3/6)| <= |exp(ix) - S5| <= b = x^5/60
  (cek-exp-typ! z)
  (cek-cc-typ! s5) (cek-cc-typ! v)
  (fact 'cc-re-im-of s5 ra ib)
  (dk-split-all!)
  (fact 'cc-im-dist-le (list 'CC-EXP z) s5)
  (fact 'cc-sin-real-part x)
  (let* ((w (list 'CC-EXP z)) (d (list '- (list 'imag-part w) (list 'imag-part s5))) (m (list 'magnitude (list '- w s5))))
    (cek-rr-typ! d) (cek-rr-typ! (list 'abs d)) (cek-rr-typ! m) (cek-rr-typ! b)
    (cek-rr-typ! (list 'power (list 'magnitude z) 5))
    (cek-rr-typ! '(recip (FACTORIAL 5)))
    (dk-have! (list '= b (list '* 1/60 p5))
      (lambda ()
        (subst (cek-fact-val! 5))
        (subst (list '= (list 'magnitude z) (list 'abs x)))
        (subst (list '= (list 'abs x) x))
        (crs)))
    (dk-le-trans! (list 'abs d) m b)
    (dk-split-all! (list (dk-fact! 'rr-abs-le-parts d b)))
    ;; x^3 <= 4x, x^5 <= 16x
    (cek-pow2! x)
    (cek-pow-succ! x 2) (cek-pow-succ! x 3) (cek-pow-succ! x 4)
    (let ((comm! (lambda (a c) (cek-cc-typ! (list '* a c)) (cek-cc-typ! (list '* c a))
                   (dk-have! (list '= (list '* a c) (list '* c a)) (lambda () (crs))))))
      (cek-rr-typ! (list '* x x)) (cek-rr-typ! 2) (cek-rr-typ! 4) (cek-rr-typ! 16)
      (cek-mul-le! x 2 x)
      (dk-have! (list '<= p2 4) (lambda () (dk-ineq! (list '= p2 (list '* x x)) (list '<= (list '* x x) (list '* 2 x)) (list '<= x 2))))
      (cek-mul-le! p2 4 x)
      (comm! x p2)
      (cek-rr-typ! (list '* 4 x))
      (dk-have! (list '<= p3 (list '* 4 x))
        (lambda () (dk-ineq! (list '= p3 (list '* x p2)) (list '= (list '* x p2) (list '* p2 x)) (list '<= (list '* p2 x) (list '* 4 x)))))
      (cek-mul-le! p3 (list '* 4 x) x)
      (comm! x p3)
      (cek-cc-typ! (list '* (list '* 4 x) x)) (cek-cc-typ! (list '* 4 (list '* x x)))
      (dk-have! (list '= (list '* (list '* 4 x) x) (list '* 4 (list '* x x))) (lambda () (crs)))
      (dk-have! (list '<= p4 16)
        (lambda () (dk-ineq! (list '= p4 (list '* x p3)) (list '= (list '* x p3) (list '* p3 x))
                             (list '<= (list '* p3 x) (list '* (list '* 4 x) x))
                             (list '= (list '* (list '* 4 x) x) (list '* 4 (list '* x x)))
                             (list '= p2 (list '* x x)) (list '<= (list '* x x) (list '* 2 x)) (list '<= x 2))))
      (cek-mul-le! p4 16 x)
      (comm! x p4)
      (cek-sin-typ! x)
      (fact 'cc-cos-sin-real x) (dk-split-all!)
      (dk-have! (list '< 0 s)
        (lambda ()
          (dk-ineq! (list '= s (list 'imag-part w)) (list '<= (list '- b) d) (list '= (list 'imag-part s5) ib)
                    (list '= b (list '* 1/60 p5)) (list '<= p3 (list '* 4 x))
                    (list '= p5 (list '* x p4)) (list '= (list '* x p4) (list '* p4 x)) (list '<= (list '* p4 x) (list '* 16 x))
                    (list '< 0 x))))
      ;; s^2 = 1 and s > 0
      (fact 'cc-cos-sin-half-pi) (dk-split-all!)
      (fact 'rr-subset-cc s)
      (cek-pow2! s)
      (cek-cc-typ! (list '* s s))
      (dk-have! (list '= (list '* s s) 1) (lambda () (subst (list '= (list '* s s) (list 'power s 2))) (ass)))
      (let ((sm (list '- s 1)) (sp1 (list '+ s 1)))
        (cek-rr-typ! sm) (cek-rr-typ! sp1) (fact 'rr-subset-cc sm) (fact 'rr-subset-cc sp1)
        (cek-cc-typ! (list '* sm sp1))
        (dk-have! (list 'NOT (list '= sp1 0)) (lambda () (di) (cek-absurd! (list '= sp1 0) (list '< 0 s))))
        (use-em (list '= sm 0)
          (lambda ()
            (subst (cek-ring-id! '(cxra_) '(= cxra_ (+ (- cxra_ 1) 1)) (list s)))
            (subst (list '= sm 0))
            (arith))
          (lambda ()
            (fact 'cc-mul-nonzero sm sp1)
            (dk-have! (list '= (list '* sm sp1) 0)
              (lambda ()
                (subst (cek-ring-id! '(cxra_) '(= (* (- cxra_ 1) (+ cxra_ 1)) (- (* cxra_ cxra_) 1)) (list s)))
                (subst (list '= (list '* s s) 1))
                (arith)))
            (ai (list 'NOT (list '= (list '* sm sp1) 0)))))))))
(qed 'cc-sin-half-pi)

