(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (FORALL cekw_ (IMPLIES (IN cekw_ CC)
  (IMPLIES (= (CC-EXP cekz_) 1) (IMPLIES (= (CC-EXP cekw_) 1) (= (CC-EXP (+ cekz_ cekw_)) 1)))))))))
