(sp (make-wff (list 'AND (list 'IN cek-cosr '(FUN RR RR))
  (list 'FORALL 'cekx_ (list 'IMPLIES '(IN cekx_ RR) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS cek-cosr 'cekx_))))))
