;;; cc-exp-kernel.scm -- THE KERNEL OF exp AND THE CONSTANT pi (the notes 2.3.3:
;;; Lemma 2.18, Prop 2.19, and what they rest on).
;;; Batch 31-B, 2026-09-25.  exp, cos, sin are theorem-library/cc-exp.scm's (31-A,
;;; definitions structure-library/cc-elementary.scm); PI is defined in
;;; structure-library/cc-pi.scm (the user's definition: the generator of
;;; K = {z : exp z = 1} in the upper half plane, divided by 2i; as a description:
;;; THE positive real p with K = {k (2 p i) : k in ZZ}).
;;;
;;; THE SOURCE.  ~/docs/complex-analysis.pdf, 2.3.3 (pp. 32-33).
;;;
;;; THE HEADLINES, in proof order.
;;;   tails        cc-series-ratio-tail  terms halving from m on: |sum - S_m| <= 2|f(m)|
;;;                cc-exp-tail           2|z| <= m+1: |exp z - S_m| <= 2 |z|^m / m!
;;;   near 0       cc-exp-near-one       |z| <= 1: |exp z - 1 - z| <= |z|^2
;;;                cc-exp-kernel-discrete exp z = 1, |z| < 1/2 => z = 0
;;;   real line    cc-exp-real-gt-one    t > 0 => 1 < exp t;  cc-exp-real-one-iff
;;;   K            cc-exp-kernel-add / -neg / -sub (a subgroup of (CC,+)),
;;;                cc-exp-kernel-imaginary (exp z = 1 => Re z = 0: the notes'
;;;                argument through conj), cc-exp-kernel-on-imaginary-axis
;;;   cos, sin     cc-cos-real-part, cc-sin-real-part (cos t = Re exp(it),
;;;                sin t = Im exp(it)), cc-cos-sin-real, cc-cos-zero,
;;;                cc-cos-one-bounds (5/12 <= cos 1 <= 7/12), cc-cos-two-neg,
;;;                cc-cos-real-continuous, cc-cos-has-zero (0 < t0 < 2, cos t0 = 0)
;;;   K /= {0}     cc-exp-imaginary-period-exists (exp(4 i t0) = 1),
;;;                cc-exp-kernel-nontrivial
;;;   K = ZZ g     cc-exp-least-period (the infimum of the positive periods is
;;;                one), cc-exp-kernel-zz-multiple, cek-period-multiple-zz
;;;   pi           cc-pi-exists, cc-pi-unique (existence and uniqueness of what
;;;                PI describes), pi-spec, pi-pos,
;;;                cc-exp-kernel-generator (+ -unique): 2 pi i is THE generator
;;;                with Im > 0
;;;   Lemma 2.18   cc-exp-one-iff        exp z = 1 iff z = k (2 pi i), k in ZZ
;;;   values       cc-exp-two-pi-i, cc-exp-i-pi (exp(i pi) = -1), cc-cos-two-pi,
;;;                cc-sin-two-pi, cc-cos-pi, cc-sin-pi, cc-cos-half-pi,
;;;                cc-sin-half-pi (with cc-pi-lt-four: pi < 4)
;;;   Prop 2.19    cc-exp-injective-strip  exp is injective on -pi <= Im z < pi
;;;                (the injectivity half; surjectivity onto CC \ {0} is NOT here)
;;;
;;; THE ROUTES.
;;;   * ONE mechanism for the three numerical estimates: a convergent series
;;;     whose terms at least halve from index m on is within 2|f(m)| of its m-th
;;;     partial sum (cek-limit-tail-le: a limit keeps a bound valid from an index
;;;     on; cek-half-ratio-partial: S(m+n) - S(m) + 2g(m+n) <= 2g(m), induction
;;;     on n).  For exp the ratio is |z|/(k+1).
;;;   * 1 < exp t: from the estimate near 0 for 0 < t <= 1/2, then induction on n
;;;     with t <= n/2 (exp t = exp(t - 1/2) exp(1/2)) and the archimedean
;;;     property.  No real-series bridge is needed.
;;;   * cos 2 < 0: cos 1 = Re exp(i) is 1/2 within 1/12 (the tail at m = 4), and
;;;     cos 2 = 2 cos^2 1 - 1 (cc-cos-add, cc-cos-sin-one) <= 2 (7/12)^2 - 1 < 0.
;;;   * the zero of cos: `ivt' for -cos on [0, 2]; continuity on RR from 31-A's
;;;     derivative through cc-continuous-restrict-rr (a complex function
;;;     continuous at a real point, real on RR, restricts to a continuous real
;;;     function -- eps-delta through the subspace, nf and cc-ms distances).
;;;   * the least period: a = -SUP{y < 0 : exp(iy) = 1} (rr-sup-*, rr-sup-approx);
;;;     two periods within 1/2 of a would differ by a period in (0, 1/2).
;;;   * K = ZZ (i a): a period 0 <= t < n a is k a (induction on n; minimality
;;;     settles t < a); no floor function is needed.
;;;   * PI = a/2 is unique: of two candidates each is a positive integer multiple
;;;     of the other (cek-pi-le).
;;;   * exp(i pi) = -1: u^2 = exp(2 pi i) = 1 and u /= 1 (pi i = k 2 pi i forces
;;;     2k = 1); sin(pi/2) = 1 needs its sign: pi < 4, and the tail at m = 5
;;;     gives sin x >= x - x^3/6 - x^5/60 >= x/15 on (0, 2].
;;;
;;; NOTHING asserted: no support, stamp or axiom; the one definition is
;;; cc-pi.scm's.  Helper prefix cek-; theorem binders cek..._ (and those of the
;;; cited theorems where an instance must match).  The driver helpers copied
;;; from cc-exp.scm (a helper is local to its file) carry the prefix cek-.
;;; LOAD WINDOW: lo = theorem-library/cc-exp (31-A's theorems); structure-library/
;;; cc-pi before this file (after cc-elementary); hi: none.  Oracles: crs, ineq,
;;; arith.  Tactics: none of the late ones (no contra, prep, ineq-supply).
;;; ---- typing and helpers (copied from theorem-library/cc-exp.scm, prefix cek- -> cek-; a driver helper is local to its file) ----
(define (cek-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cek-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (cek-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((eqv? t 1) (fact 'nn-one-in) typ)
          ((and (exact-nonnegative-integer? t)) (dk-have! typ (lambda () (arith))) typ)
          ((cek-op? t 'succ 2) (cek-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          ((or (cek-op? t '+ 3) (cek-op? t '* 3))
           (cek-nn-typ! (cadr t)) (cek-nn-typ! (caddr t))
           (cek-and! (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN))
           (fact (if (eq? (car t) '+) 'nn-add-closed 'nn-mul-closed) (cadr t) (caddr t)) typ)
          (#t (error "cek-nn-typ!: cannot type" (expression->string t))))))
(define (cek-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((and (number? t) (exact-rational? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (pair? t) (cek-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((cek-op? t 'FACTORIAL 2)
           (cek-nn-typ! (cadr t))
           (dk-split-all! (list (dk-fact! 'factorial-real-pos (cadr t)))) typ)
          ((or (cek-op? t 'succ 2) (and (cek-op? t '+ 3) (dk-asm? (list 'IN (cadr t) 'NN))
                                         (dk-asm? (list 'IN (caddr t) 'NN))))
           (cek-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((and (cek-op? t 'recip 2) (cek-op? (cadr t) 'FACTORIAL 2))
           (cek-nn-typ! (cadr (cadr t))) (fact 'recip-factorial-in-rr (cadr (cadr t))) typ)
          ((cek-op? t 'recip 2)
           (cek-rr-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cek-rr-typ!: recip of a term not known nonzero" (expression->string t)))
           (cek-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t)) typ)
          ((cek-op? t '* 3) (cek-rr-typ! (cadr t)) (cek-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cek-op? t '+ 3) (cek-rr-typ! (cadr t)) (cek-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((cek-op? t '- 3) (cek-rr-typ! (cadr t)) (cek-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((cek-op? t '- 2) (cek-rr-typ! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((cek-op? t 'real-part 2) (cek-cc-typ! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((cek-op? t 'imag-part 2) (cek-cc-typ! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((cek-op? t 'power 3) (cek-rr-typ! (cadr t)) (cek-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((cek-op? t 'magnitude 2) (cek-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cek-op? t 'abs 2) (cek-rr-typ! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          (#t (error "cek-rr-typ!: cannot type" (expression->string t))))))
(define (cek-real? t)
  (or (and (number? t) (exact-rational? t))
      (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
      (cek-op? t 'succ 2) (cek-op? t 'FACTORIAL 2) (cek-op? t 'magnitude 2) (cek-op? t 'abs 2) (cek-op? t 'real-part 2) (cek-op? t 'imag-part 2)
      (and (cek-op? t 'recip 2) (cek-op? (cadr t) 'FACTORIAL 2))
      (and (memq (dk-head t) '(* + -)) (= (length t) 3) (cek-real? (cadr t)) (cek-real? (caddr t)))
      (and (cek-op? t 'power 3) (cek-real? (cadr t)))))
;;; a ground numeric term (numbers under + - * recip): typed by arith
(define (cek-ground? t)
  (or (number? t)
      (and (pair? t) (memq (car t) '(+ - * recip)) (every cek-ground? (cdr t)))))
;;; D when (IN F (FUN D CC)) is in context
(define (cek-fun-dom f)
  (let ((hit (find-first (lambda (a) (and (cek-op? a 'IN 3) (equal? (cadr a) f)
                                          (cek-op? (caddr a) 'FUN 3) (eq? (caddr (caddr a)) 'CC)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
(define (cek-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((and (pair? t) (cek-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (number? t) (exact-rational? t)) (cek-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((cek-real? t) (cek-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
           (cek-nn-typ! (cadr t)) (fact 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) typ)
          ((and (pair? t) (= (length t) 2) (cek-fun-dom (car t)))
           (let ((dom (cek-fun-dom (car t))))
             (if (eq? dom 'NN) (cek-nn-typ! (cadr t)))
             (if (eq? dom 'CC) (cek-cc-typ! (cadr t)))
             (fact 'fun-apply-type-c (car t) dom 'CC (cadr t)) typ))
          ((cek-op? t 'CC-EXP 2) (cek-exp-typ! (cadr t)) typ)
          ((cek-op? t 'CC-COS 2) (cek-cos-typ! (cadr t)) typ)
          ((cek-op? t 'CC-SIN 2) (cek-sin-typ! (cadr t)) typ)
          ((and (cek-op? t 'CC-SERIES-PARTIAL-SUM 3) (dk-asm? (list 'IN (cadr t) '(FUN NN CC))))
           (cek-nn-typ! (caddr t)) (fact 'cc-series-partial-sum-in-cc (caddr t) (cadr t)) typ)
          ((and (cek-op? t 'CC-SERIES-LIMIT 2) (dk-asm? (list 'CC-SERIES-CONVERGES (cadr t))))
           (fact 'cc-series-limit-in-cc (cadr t)) typ)
          ((cek-op? t '* 3) (cek-cc-typ! (cadr t)) (cek-cc-typ! (caddr t))
           (cek-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cek-op? t '+ 3) (cek-cc-typ! (cadr t)) (cek-cc-typ! (caddr t))
           (cek-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cek-op? t '- 3) (cek-cc-typ! (cadr t)) (cek-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cek-op? t '- 2) (cek-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((cek-op? t 'conjugate 2) (cek-cc-typ! (cadr t)) (fact 'cc-conjugate-closed (cadr t)) typ)
          ((cek-op? t 'power 3) (cek-cc-typ! (cadr t)) (cek-nn-typ! (caddr t))
           (cek-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cek-op? t 'recip 2)
           (cek-cc-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cek-cc-typ!: recip of a term not known nonzero" (expression->string t)))
           (cek-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "cek-cc-typ!: cannot type" (expression->string t))))))

;;; (IN LAM (FUN NN COD)) for LAM = (VNB-LAMBDA v NN body): TYPER gets the
;;; eigenvariable and must land the body's typing.
(define (cek-lam-typ! lam cod typer)
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-t!)
            (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
              (typer j)
              (if (not (sequent-node-grounded? leaf)) (ass))))))
    typ))

;;; beta-reduce the focus goal; the reduct is a NEW node that becomes the focus
;;; while the worked leaf stays open, unless beta grounded it: run CLOSER then.
(define (cek-beta! closer)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (closer))))

;;; A commutative-ring identity with opaque atoms: prove BODY over fresh complex
;;; variables VARS by crs on a lane, then instantiate it at TERMS (typed in CC
;;; first); returns the landed instance.
(define (cek-ring-id! vars body terms)
  (let ((gen (let build ((vs vars))
               (if (null? vs) body
                   (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) (build (cdr vs))))))))
    (if (not (dk-asm? gen)) (dk-have! gen (lambda () (dk-peel!) (crs))))
    (for-each cek-cc-typ! terms)
    (apply dk-apply! (dk-ctx-form gen) terms)))

;;; detach an implication chain: an antecedent in context by detach!, one not in
;;; context (a conjunction of context facts) by detach-with!
(define (cek-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

;;; POS-RR c from (IN c RR) and (< 0 c) in context
(define (cek-pos-rr! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (dk-have! (list 'POS-RR c)
        (lambda ()
          (mac-h '< (dk-ctx-form (list '< 0 c)))
          (dk-split-all!)
          (mac 'pos-rr)
          (dk-conj-close! (lambda () (ass)))))))

;;; close the focus goal from a contradiction (< 0 0) proved by dk-ineq! from PREMS
(define (cek-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

;;; ======================================================================
;;; (0) THE UNFOLD EQUATIONS.  A def-functoid unfolds in a GOAL by `mac' but not
;;; in an assumption; these theorems are what `mac-h' can name.
;;; ======================================================================
(define (cek-ind! base-k step-k)
  (let* ((br (use-induction))
         (v (cdr (assq 'var br)))
         (ih (cdr (assq 'ih br)))
         (step (cdr (assq 'step br))))
    (dk-focus! (cdr (assq 'base br)))
    (base-k)
    (dk-focus! step)
    (step-k v ih)))
(define (cek-pw! z k)                    ; z^(succ k) = z z^k, rewritten in the goal
  (cek-cc-typ! z) (cek-nn-typ! k)
  (cek-and! (list 'IN z 'CC) (list 'IN k 'NN))
  (subst (dk-fact! 'power-succ z k)))

(define (cek-exp-typ! z)
  (cek-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC)))
      (dk-split-all! (list (dk-fact! 'cc-exp-converges z)))))

(define (cek-cos-typ! z)
  (cek-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-COS z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-cos-converges z)))))
(define (cek-sin-typ! z)
  (cek-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-SIN z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-sin-converges z)))))
(define (cek-conj-typ! z) (cek-cc-typ! (list 'conjugate z)))
(define (cek-i2! )                        ; (= (power +i 2) -1) in context
  (if (not (dk-asm? (list '= (list 'power +i 2) -1)))
      (dk-have! (list '= (list 'power +i 2) -1)
        (lambda ()
          (fact 'nn-two-is-succ-succ-zero)
          (subst '(= 2 (succ (succ 0))))
          (fact 'nn-zero-in)
          (cek-nn-typ! '(succ 0))
          (cek-pw! +i '(succ 0))
          (cek-pw! +i 0)
          (subst (dk-fact! 'power-zero +i))
          (crs)))))
(define (cek-pow2! x)                    ; (= (power x 2) (* x x)) in context
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (cek-cc-typ! x)
            (fact 'nn-two-is-succ-succ-zero)
            (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in)
            (cek-nn-typ! '(succ 0))
            (cek-pw! x '(succ 0))
            (cek-pw! x 0)
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (cek-shift0! z)                  ; lands (= (* (CC-EXP z) (CC-EXP (- z))) 1)
  (let ((e (list '= (list '* (list 'CC-EXP z) (list 'CC-EXP (list '- z))) 1)))
    (if (not (dk-asm? e))
        (begin
          (cek-cc-typ! z)
          (fact 'cc-zero-in)
          (fact 'cc-exp-shift 0 z)
          (cek-cc-typ! (list '- z))
          (cek-cc-typ! (list '- 0 z))
          (dk-have! (list '= (list '- 0 z) (list '- z)) (lambda () (crs)))
          (dk-have! e
            (lambda ()
              (subst (list '= (list '- z) (list '- 0 z)))
              (subst (list '= (list '* (list 'CC-EXP z) (list 'CC-EXP (list '- 0 z))) '(CC-EXP 0)))
              (subst (dk-fact! 'cc-exp-zero))
              (fact 'cc-one-in)
              (rfl)))))
    e))

;;; ======================================================================
;;; (T) TAIL BOUNDS FOR A SERIES.  One general mechanism serves the three
;;; numerical estimates of this file (|exp z - 1 - z| <= |z|^2, cos 2 < 0, and
;;; 1 < exp t): when the terms of a convergent series at least HALVE from index
;;; m on, the sum differs from the m-th partial sum by at most twice the m-th
;;; term.  Three steps: a limit inherits a bound that holds from some index on
;;; (cek-limit-tail-le); the real partial sums of such a series satisfy
;;; S(m+n) - S(m) + 2 g(m+n) <= 2 g(m) (cek-half-ratio-partial, by induction on
;;; n); and the two together through cc-series-block-le (cc-series-ratio-tail).
;;; ======================================================================
(define (cek-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (cek-pts-rr!)
  (if (not (dk-asm? '(== (PTS RR-MS) RR)))
      (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))))

;;; a limit inherits a bound on |s(n) - c| that holds for n >= m
(sp (make-wff '(FORALL cekts_ (IMPLIES (IN cekts_ (FUN NN CC)) (FORALL ceklv_ (IMPLIES (IN ceklv_ CC)
  (FORALL cekc_ (IMPLIES (IN cekc_ CC) (FORALL cekbd_ (IMPLIES (IN cekbd_ RR) (FORALL cekm_ (IMPLIES (IN cekm_ NN)
  (IMPLIES (CONVERGES-TO CC-MS cekts_ ceklv_)
    (IMPLIES (FORALL cekn_ (IMPLIES (IN cekn_ NN) (IMPLIES (<= cekm_ cekn_) (<= (magnitude (- (cekts_ cekn_) cekc_)) cekbd_))))
      (<= (magnitude (- ceklv_ cekc_)) cekbd_)))))))))))))))
(dk-peel!)
(define cek-lt-bound (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cekbd_))) "the tail bound"))
(mac-h 'converges-to '(CONVERGES-TO CC-MS cekts_ ceklv_))
(dk-split-all!)
(define cek-lt-tail (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "the convergence tail"))
(cek-pts-cc!)
(define cek-lt-d '(- ceklv_ cekc_))
(cek-cc-typ! cek-lt-d)
(cek-rr-typ! (list 'magnitude cek-lt-d))
(cek-rr-typ! (list '- (list 'magnitude cek-lt-d) 'cekbd_))
(dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= (list '- (list 'magnitude cek-lt-d) 'cekbd_) 'eps)))
  (lambda ()
    (dk-peel!)
    (let* ((eps (caddr (dk-goal)))
           (bign (dk-skolem! (dk-apply! cek-lt-tail eps)))
           (inner (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f bign) (dk-contains? f 'DIST))) "the tail at N"))
           (k (list '+ bign 'cekm_))
           (sk (list 'cekts_ k)))
      (fact 'rr-pos-rr-in-rr eps)
      (cek-nn-typ! k)
      (fact 'nn-le-add-right 'cekm_ bign)
      (fact 'nn-le-add-left bign 'cekm_)
      (dk-apply! inner k)
      (dk-apply! cek-lt-bound k)
      (cek-cc-typ! sk)
      (dk-have! (list 'IN sk '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
      (fact 'cc-ms-dist sk 'ceklv_)
      (let* ((p cek-lt-d) (q (list '- sk 'cekc_)) (dd (list '- sk 'ceklv_)))
        (cek-cc-typ! q) (cek-cc-typ! dd) (cek-cc-typ! (list '- p q))
        (cek-rr-typ! (list 'magnitude q)) (cek-rr-typ! (list 'magnitude dd)) (cek-rr-typ! (list 'magnitude (list '- p q)))
        (fact 'cc-magnitude-le-add p q)
        (dk-have! (list '= (list 'magnitude (list '- p q)) (list 'magnitude dd))
          (lambda ()
            (dk-have! (list '= (list '- p q) (list '- 'ceklv_ sk)) (lambda () (crs)))
            (subst (list '= (list '- p q) (list '- 'ceklv_ sk)))
            (subst (dk-fact! 'cc-magnitude-sub-sym 'ceklv_ sk))
            (rfl)))
        (dk-have! (list '<= (list 'magnitude dd) eps)
          (lambda () (subst (list '= (list 'magnitude dd) (list '(DIST CC-MS) sk 'ceklv_))) (ass)))
        (dk-ineq! (list '<= (list 'magnitude p) (list '+ (list 'magnitude (list '- p q)) (list 'magnitude q)))
                  (list '= (list 'magnitude (list '- p q)) (list 'magnitude dd))
                  (list '<= (list 'magnitude dd) eps)
                  (list '<= (list 'magnitude q) 'cekbd_))))))
(fact 'rr-le-all-pos-nonpos (list '- (list 'magnitude cek-lt-d) 'cekbd_))
(dk-ineq! (list '<= (list '- (list 'magnitude cek-lt-d) 'cekbd_) 0))
(qed 'cek-limit-tail-le)

;;; the partial sums of a series whose terms halve from index m on:
;;; S(m+n) - S(m) + 2 g(m+n) <= 2 g(m)   (induction on n, stated first)
(define (cek-land-var landed dom)
  (let ((hit (find-first (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) dom))) landed)))
    (if hit (cadr hit) (error "cek-land-var: no typing landed in" dom))))
(define (cek-rr-app! g x)                 ; (IN (g x) RR) from (IN g (FUN NN RR)), x typed in NN
  (cek-nn-typ! x)
  (if (not (dk-asm? (list 'IN (list g x) 'RR))) (fact 'fun-apply-type-c g 'NN 'RR x)))
(sp (make-wff '(FORALL cekn_ (IMPLIES (IN cekn_ NN) (FORALL cekg_ (IMPLIES (IN cekg_ (FUN NN RR)) (FORALL cekm_ (IMPLIES (IN cekm_ NN)
  (IMPLIES (FORALL cekj_ (IMPLIES (IN cekj_ NN) (IMPLIES (<= cekm_ cekj_) (<= (* 2 (cekg_ (succ cekj_))) (cekg_ cekj_)))))
    (<= (+ (- (SERIES-PARTIAL-SUM cekg_ (+ cekm_ cekn_)) (SERIES-PARTIAL-SUM cekg_ cekm_)) (* 2 (cekg_ (+ cekm_ cekn_))))
        (* 2 (cekg_ cekm_))))))))))))
(cek-ind!
  (lambda ()
    (let* ((landed (dk-peel!)) (g (cek-land-var landed '(FUN NN RR))) (m (cek-land-var landed 'NN)))
      (subst (dk-fact! 'nn-add-zero m))
      (fact 'series-partial-sum-in-rr m g)
      (cek-rr-app! g m)
      (dk-ineq!)))
  (lambda (v ih)
    (let* ((landed (dk-peel!)) (g (cek-land-var landed '(FUN NN RR)))
           (m (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN) (not (eq? (cadr f) v)))) landed)))
           (hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f g) (dk-contains? f 'succ))) "the halving hypothesis"))
           (mv (list '+ m v)) (smv (list 'succ mv)))
      (subst (dk-fact! 'nn-add-succ m v))
      (cek-nn-typ! smv)
      (fact 'series-partial-sum-in-rr mv g)
      (fact 'series-partial-sum-in-rr m g)
      (cek-rr-app! g mv) (cek-rr-app! g smv) (cek-rr-app! g m)
      (subst (dk-fact! 'series-partial-sum-succ g mv))
      (fact 'nn-le-add-right v m)
      (let ((r (dk-apply! hyp mv))
            (i (dk-apply! ih g m)))
        (fact 'series-partial-sum-in-rr smv g)
        (dk-ineq! r i)))))
(qed 'cek-half-ratio-partial)

;;; THE TAIL BOUND: the terms of a convergent complex series halve from index m
;;; on  ==>  |sum - S(m)| <= 2 |f(m)|
(sp (make-wff '(FORALL cekf_ (IMPLIES (IN cekf_ (FUN NN CC)) (FORALL cekm_ (IMPLIES (IN cekm_ NN)
  (IMPLIES (CC-SERIES-CONVERGES cekf_)
    (IMPLIES (FORALL cekj_ (IMPLIES (IN cekj_ NN) (IMPLIES (<= cekm_ cekj_)
                (<= (* 2 (magnitude (cekf_ (succ cekj_)))) (magnitude (cekf_ cekj_))))))
      (<= (magnitude (- (CC-SERIES-LIMIT cekf_) (CC-SERIES-PARTIAL-SUM cekf_ cekm_))) (* 2 (magnitude (cekf_ cekm_))))))))))))
(dk-peel!)
(define cek-rt-hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'succ))) "the halving hypothesis"))
(define cek-rt-G '(VNB-LAMBDA cekq_ NN (magnitude (cekf_ cekq_))))
(cek-lam-typ! cek-rt-G 'RR (lambda (k) (cek-rr-typ! (list 'magnitude (list 'cekf_ k)))))
(define cek-rt-gv (list 'FORALL 'cekj_ (list 'IMPLIES '(IN cekj_ NN) (list '= (list cek-rt-G 'cekj_) '(magnitude (cekf_ cekj_))))))
(dk-have! cek-rt-gv
  (lambda () (let ((j (dk-di-var!))) (cek-rr-typ! (list 'magnitude (list 'cekf_ j))) (cek-beta! (lambda () (rfl))))))
(define cek-rt-L '(CC-SERIES-LIMIT cekf_))
(define cek-rt-Sm '(CC-SERIES-PARTIAL-SUM cekf_ cekm_))
(fact 'cc-series-limit-in-cc 'cekf_)
(fact 'cc-series-partial-sum-in-cc 'cekm_ 'cekf_)
(mac-h 'cc-series-converges-to (dk-fact! 'cc-series-limit-converges-to 'cekf_))
(define cek-rt-P (caddr (dk-pick (dk-head? 'CONVERGES-TO) "the partial sums converge")))
(cek-lam-typ! cek-rt-P 'CC (lambda (k) (fact 'cc-series-partial-sum-in-cc k 'cekf_)))
(define cek-rt-bd '(* 2 (magnitude (cekf_ cekm_))))
(cek-rr-typ! cek-rt-bd)
(cek-chain!
  (detach-with! (dk-fact! 'cek-limit-tail-le cek-rt-P cek-rt-L cek-rt-Sm cek-rt-bd 'cekm_)
    (lambda ()
      (let* ((landed (dk-peel!)) (n (cek-land-var landed 'NN)) (G cek-rt-G) (sn (list 'CC-SERIES-PARTIAL-SUM 'cekf_ n)))
        (fact 'cc-series-partial-sum-in-cc n 'cekf_)
        (cek-cc-typ! (list '- sn cek-rt-Sm))
        (cek-rr-typ! (list 'magnitude (list '- sn cek-rt-Sm)))
        (cek-beta!
          (lambda ()
            (let* ((blk (dk-fact! 'cc-series-block-le n 'cekm_ 'cekf_ G))
                   (d (dk-skolem! (dk-fact! 'nn-le-gap n 'cekm_)))
                   (md (list '+ 'cekm_ d))
                   (rh (list 'FORALL 'cekj_ (list 'IMPLIES '(IN cekj_ NN) (list 'IMPLIES '(<= cekm_ cekj_)
                          (list '<= (list '* 2 (list G '(succ cekj_))) (list G 'cekj_)))))))
              (cek-nn-typ! md)
              (dk-have! rh
                (lambda ()
                  (let* ((ld (dk-peel!)) (j (cek-land-var ld 'NN)))
                    (cek-nn-typ! (list 'succ j))
                    (cek-rr-typ! (list 'magnitude (list 'cekf_ j)))
                    (cek-rr-typ! (list 'magnitude (list 'cekf_ (list 'succ j))))
                    (dk-lam-b!)
                    (dk-apply! cek-rt-hyp j)
                    (ass))))
              (let ((l2 (dk-fact! 'cek-half-ratio-partial d G 'cekm_)))
                (fact 'series-partial-sum-in-rr n G)
                (fact 'series-partial-sum-in-rr 'cekm_ G)
                (fact 'series-partial-sum-in-rr md G)
                (cek-rr-app! G md) (cek-rr-app! G 'cekm_)
                (dk-have! (list '= (list 'SERIES-PARTIAL-SUM G md) (list 'SERIES-PARTIAL-SUM G n))
                  (lambda () (subst (list '= md n)) (rfl)))
                (dk-have! (list '<= 0 (list G md))
                  (lambda ()
                    (cek-rr-typ! (list 'magnitude (list 'cekf_ md)))
                    (dk-lam-b!)
                    (fact 'cc-magnitude-nonneg (list 'cekf_ md))
                    (ass)))
                (let ((gm (dk-apply! cek-rt-gv 'cekm_)))
                  (dk-ineq! blk l2 gm
                            (list '= (list 'SERIES-PARTIAL-SUM G md) (list 'SERIES-PARTIAL-SUM G n))
                            (list '<= 0 (list G md))))))))))))
(ass)
(qed 'cc-series-ratio-tail)

;;; ======================================================================
;;; (E) THE TAIL OF THE EXPONENTIAL SERIES: for 2|z| <= m + 1,
;;;     |exp z - sum_{k<m} z^k/k!| <= 2 |z|^m / m!.
;;; From the tail bound: the ratio of consecutive terms is |z|/(k+1) <= 1/2.
;;; ======================================================================
(define (cek-el z) (list 'VNB-LAMBDA 'cek_ 'NN (list '* '(recip (FACTORIAL cek_)) (list 'power z 'cek_))))
(define (cek-el-term z k) (list '* (list 'recip (list 'FACTORIAL k)) (list 'power z k)))
(define (cek-nonneg-mul! a b)            ; (<= 0 (* a b)) from (<= 0 a), (<= 0 b), typed
  (let ((g (list '<= 0 (list '* a b))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'rr-zero-in)
            (dk-ineq! (dk-cite! 'rr-mul-le-right 0 a b)))))
    g))
;;; |recip(k!) w^k| = recip(k!) |w|^k, landed; w typed in CC, k in NN
(define (cek-mag-term! z k)
  (let* ((r (list 'recip (list 'FACTORIAL k))) (p (list 'power z k)) (a (list 'magnitude z))
         (e (list '= (list 'magnitude (list '* r p)) (list '* r (list 'power a k)))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (cek-fact-pos! k)
            (cek-rr-typ! r) (cek-cc-typ! r) (cek-cc-typ! p) (cek-rr-typ! a)
            (cek-rr-typ! (list 'power a k))
            (fact 'rr-recip-pos (list 'FACTORIAL k))
            (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
            (cek-and! (list 'IN r 'CC) (list 'IN p 'CC))
            (subst (dk-fact! 'cc-magnitude-mul r p))
            (subst (dk-cite! 'rr-magnitude-is-abs r))
            (subst (dk-cite! 'rr-abs-of-nonneg r))
            (subst (dk-cite! 'cc-magnitude-power k z))
            (cek-rr-typ! (list '* r (list 'power a k)))
            (rfl))))
    e))
(define (cek-fact-pos! k)                   ; (IN k! RR), (< 0 k!)
  (cek-nn-typ! k)
  (if (not (dk-asm? (list '< 0 (list 'FACTORIAL k))))
      (dk-split-all! (list (dk-fact! 'factorial-real-pos k)))))
(sp (make-wff (list 'FORALL 'cekz_ (list 'IMPLIES '(IN cekz_ CC) (list 'FORALL 'cekm_ (list 'IMPLIES '(IN cekm_ NN)
  (list 'IMPLIES '(<= (* 2 (magnitude cekz_)) (succ cekm_))
    (list '<= (list 'magnitude (list '- '(CC-EXP cekz_) (list 'CC-SERIES-PARTIAL-SUM (cek-el 'cekz_) 'cekm_)))
              '(* 2 (* (recip (FACTORIAL cekm_)) (power (magnitude cekz_) cekm_)))))))))))
(dk-peel!)
(define cek-et-el (cek-el 'cekz_))
(dk-split-all! (list (dk-fact! 'cc-exp-converges 'cekz_)))
(cek-lam-typ! cek-et-el 'CC (lambda (k) (cek-cc-typ! (cek-el-term 'cekz_ k))))
(mac 'CC-EXP)
(cek-chain!
  (detach-with! (dk-fact! 'cc-series-ratio-tail cek-et-el 'cekm_)
    (lambda ()
      (let* ((ld (dk-peel!)) (j (cek-land-var ld 'NN)) (sj (list 'succ j))
             (a '(magnitude cekz_)) (r (list 'recip (list 'FACTORIAL sj))) (p (list 'power a j)))
        (cek-nn-typ! sj)
        (cek-cc-typ! (cek-el-term 'cekz_ j)) (cek-cc-typ! (cek-el-term 'cekz_ sj))
        (cek-rr-typ! (list 'magnitude (cek-el-term 'cekz_ j))) (cek-rr-typ! (list 'magnitude (cek-el-term 'cekz_ sj)))
        (dk-lam-b!)
        (subst (cek-mag-term! 'cekz_ j))
        (subst (cek-mag-term! 'cekz_ sj))
        (subst (dk-cite! 'tgd-recip-factorial-succ j))
        (cek-rr-typ! a) (fact 'rr-subset-cc a)
        (cek-and! (list 'IN a 'CC) (list 'IN j 'NN))
        (subst (dk-fact! 'power-succ a j))
        (cek-fact-pos! sj)
        (cek-rr-typ! r) (cek-rr-typ! p) (cek-rr-typ! sj)
        (fact 'rr-recip-pos (list 'FACTORIAL sj))
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (fact 'cc-magnitude-nonneg 'cekz_)
        (fact 'rr-power-nonneg j a)
        (cek-rr-typ! (list '* r p))
        (cek-nonneg-mul! r p)
        (subst (cek-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* 2 (* cxra_ (* cxrb_ cxrc_))) (* (* 2 cxrb_) (* cxra_ cxrc_))) (list r a p)))
        (subst (cek-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* (* cxra_ cxrb_) cxrc_) (* cxra_ (* cxrb_ cxrc_))) (list sj r p)))
        (cek-rr-typ! (list '* 2 a))
        (fact 'nn-succ-plus-one 'cekm_) (fact 'nn-succ-plus-one j)
        (cek-rr-typ! '(succ cekm_))
        (fact 'nn-in-rr j) (fact 'nn-in-rr 'cekm_)
        (dk-have! (list '<= (list '* 2 a) sj)
          (lambda () (dk-ineq! '(<= (* 2 (magnitude cekz_)) (succ cekm_)) '(= (succ cekm_) (+ cekm_ 1))
                               (list '= sj (list '+ j 1)) (list '<= 'cekm_ j))))
        (fact 'rr-mul-le-right (list '* 2 a) sj (list '* r p))
        (ass)))))
(let* ((m 'cekm_) (a '(magnitude cekz_)) (rp (list '* (list 'recip (list 'FACTORIAL m)) (list 'power a m)))
       (e (list '= rp (list 'magnitude (list cek-et-el m)))))
  (cek-mag-term! 'cekz_ m)
  (cek-rr-typ! (list 'magnitude (cek-el-term 'cekz_ m)))
  (dk-have! e
    (lambda ()
      (let ((leaf (proof-state-focus *ps*)))
        (dk-lam-b!)
        (if (not (sequent-node-grounded? leaf))
            (begin (subst (cek-mag-term! 'cekz_ m)) (rfl))))))
  (subst e)
  (ass))
(qed 'cc-exp-tail)

;;; ======================================================================
;;; (D) exp NEAR 0 AND THE DISCRETENESS OF ITS KERNEL.  |exp z - 1 - z| <= |z|^2
;;; for |z| <= 1 (the tail at m = 2), hence exp z = 1 and |z| < 1/2 force z = 0.
;;; ======================================================================
;;; (= (recip (FACTORIAL k)) 1/k!) for a numeral k, landed
(define (cek-fact-val! k)
  (let ((e (list '= (list 'recip (list 'FACTORIAL k)) (/ 1 (let f ((n k)) (if (= n 0) 1 (* n (f (- n 1)))))))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (let loop ((n k)) (if (> n 0) (begin (mac 'factorial-succ) (loop (- n 1)))))
            (mac 'factorial-zero)
            (arith))))
    e))
;;; (= (CC-SERIES-PARTIAL-SUM (cek-el z) n) VAL) for a numeral n; FINISH closes
;;; the goal once the partial sums are unrolled, beta-reduced and the factorials
;;; evaluated (arith for a ground z, crs otherwise)
(define (cek-psum-val! z n val finish)
  (let* ((el (cek-el z)) (e (list '= (list 'CC-SERIES-PARTIAL-SUM el n) val)))
    (if (not (dk-asm? e))
        (begin
          (cek-cc-typ! z)
          (cek-lam-typ! el 'CC (lambda (k) (cek-cc-typ! (cek-el-term z k))))
          (let loop ((k 0))
            (if (< k n)
                (begin
                  (cek-nn-typ! k)
                  (fact 'cc-series-partial-sum-in-cc k el)
                  (fact 'fun-apply-type-c el 'NN 'CC k)
                  (cek-fact-val! k)
                  (loop (+ k 1)))))
          (dk-have! e
            (lambda ()
              (let loop ((k n)) (if (> k 0) (begin (mac 'cc-series-partial-sum-succ) (loop (- k 1)))))
              (mac 'cc-series-partial-sum-zero)
              (dk-lam-b!)
              (let loop ((k 0)) (if (< k n) (begin (subst (cek-fact-val! k)) (loop (+ k 1)))))
              (finish)))))
    e))

(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (IMPLIES (<= (magnitude cekz_) 1)
  (<= (magnitude (- (- (CC-EXP cekz_) 1) cekz_)) (power (magnitude cekz_) 2)))))))
(dk-peel!)
(let* ((z 'cekz_) (a '(magnitude cekz_)) (e '(CC-EXP cekz_)) (s2 (list 'CC-SERIES-PARTIAL-SUM (cek-el z) 2))
       (b (list '* 2 (list '* '(recip (FACTORIAL 2)) (list 'power a 2)))))
  (cek-rr-typ! a) (fact 'cc-magnitude-nonneg z)
  (cek-nn-typ! 2)
  (dk-have! '(= (succ 2) 3) (lambda () (arith)))
  (cek-rr-typ! '(succ 2))
  (dk-have! (list '<= (list '* 2 a) '(succ 2)) (lambda () (dk-ineq! (list '<= a 1) '(= (succ 2) 3))))
  (dk-fact! 'cc-exp-tail z 2)
  (cek-psum-val! z 2 '(+ 1 cekz_)
    (lambda ()
      (fact 'nn-one-in)
      (mac 'power-succ)
      (subst (dk-fact! 'power-zero z))
      (crs)))
  (cek-exp-typ! z)
  (cek-cc-typ! s2)
  (dk-have! (list '= (list '- (list '- e 1) z) (list '- e s2))
    (lambda () (subst (list '= s2 '(+ 1 cekz_))) (crs)))
  (subst (list '= (list '- (list '- e 1) z) (list '- e s2)))
  (cek-rr-typ! (list 'power a 2))
  (cek-rr-typ! (list 'magnitude (list '- e s2)))
  (cek-rr-typ! '(recip (FACTORIAL 2)))
  (dk-have! (list '= b (list 'power a 2))
    (lambda ()
      (subst (cek-fact-val! 2))
      (cek-cc-typ! (list 'power a 2))
      (crs)))
  (dk-have! (list '<= b (list 'power a 2)) (lambda () (subst (list '= b (list 'power a 2))) (dk-ineq!)))
  (cek-rr-typ! b)
  (dk-le-trans! (list 'magnitude (list '- e s2)) b (list 'power a 2))
  (ass))
(qed 'cc-exp-near-one)

(sp (make-wff '(FORALL cekz_ (IMPLIES (IN cekz_ CC) (IMPLIES (= (CC-EXP cekz_) 1) (IMPLIES (< (magnitude cekz_) 1/2)
  (= cekz_ 0)))))))
(dk-peel!)
(let* ((z 'cekz_) (a '(magnitude cekz_)) (e '(CC-EXP cekz_)) (d (list '- (list '- e 1) z)))
  (cek-rr-typ! a) (fact 'cc-magnitude-nonneg z)
  (dk-have! (list '<= a 1) (lambda () (dk-ineq! (list '< a 1/2))))
  (dk-fact! 'cc-exp-near-one z)
  (cek-exp-typ! z)
  (cek-cc-typ! d)
  (cek-rr-typ! (list 'magnitude d))
  (dk-have! (list '= (list 'magnitude d) a)
    (lambda ()
      (subst (list '= e 1))
      (cek-cc-typ! (list '- z))
      (cek-cc-typ! (list '- (list '- 1 1) z))
      (dk-have! (list '= (list '- (list '- 1 1) z) (list '- z)) (lambda () (crs)))
      (subst (list '= (list '- (list '- 1 1) z) (list '- z)))
      (subst (dk-fact! 'cc-magnitude-neg z))
      (rfl)))
  (fact 'rr-subset-cc a)
  (cek-pow2! a)
  (cek-rr-typ! (list 'power a 2))
  (cek-rr-typ! (list '* a a))
  (cek-rr-typ! 1/2)
  (dk-have! (list '<= a 1/2) (lambda () (dk-ineq! (list '< a 1/2))))
  (fact 'rr-mul-le-right a 1/2 a)
  (dk-have! (list '<= a 0)
    (lambda () (dk-ineq! (list '<= (list 'magnitude d) (list 'power a 2)) (list '= (list 'magnitude d) a)
                         (list '= (list 'power a 2) (list '* a a)) (list '<= (list '* a a) (list '* 1/2 a)))))
  (fact 'rr-zero-in)
  (cek-and! (list 'IN a 'RR) '(IN 0 RR))
  (cek-and! (list '<= a 0) (list '<= 0 a))
  (fact 'rr-leq-antisymmetric a 0)
  (mac-h 'cc-magnitude-zero-iff (list '= a 0))
  (ass))
(qed 'cc-exp-kernel-discrete)

;;; ======================================================================
;;; (R) exp ON THE REAL LINE: 1 < exp t for t > 0, so exp t = 1 only at t = 0.
;;; Small t by the estimate near 0 (exp t >= 1 + t - t^2); every t > 0 by
;;; induction on n with t <= n/2 (exp t = exp(t - 1/2) exp(1/2)) and the
;;; archimedean property.
;;; ======================================================================
(define (cek-exp-rr! t)                 ; (IN (CC-EXP t) RR) and (IN (CC-EXP t) CC), t typed in RR
  (cek-rr-typ! t) (fact 'rr-subset-cc t)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP t) 'RR))) (fact 'cc-exp-real-valued t))
  (cek-exp-typ! t))
(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (IMPLIES (< 0 cekt_) (IMPLIES (<= cekt_ 1/2)
  (< 1 (CC-EXP cekt_))))))))
(dk-peel!)
(let* ((t 'cekt_) (a '(magnitude cekt_)) (e '(CC-EXP cekt_)) (d (list '- (list '- e 1) t)) (p (list 'power a 2)))
  (cek-exp-rr! t)
  (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
  (cek-rr-typ! a)
  (dk-have! (list '= a t) (lambda () (subst (dk-cite! 'rr-magnitude-is-abs t)) (subst (dk-cite! 'rr-abs-of-nonneg t)) (rfl)))
  (dk-have! (list '<= a 1) (lambda () (dk-ineq! (list '= a t) (list '<= t 1/2))))
  (fact 'cc-exp-near-one t)
  (cek-rr-typ! d)
  (cek-rr-typ! p)
  (fact 'rr-magnitude-is-abs d)
  (dk-have! (list '<= (list 'abs d) p)
    (lambda () (subst (list '= (list 'abs d) (list 'magnitude d))) (ass)))
  (dk-split-all! (list (dk-fact! 'rr-abs-le-parts d p)))
  (fact 'rr-subset-cc a)
  (cek-pow2! a)
  (cek-rr-typ! (list '* a a))
  (cek-rr-typ! 1/2)
  (fact 'cc-magnitude-nonneg t)
  (dk-have! (list '<= a 1/2) (lambda () (dk-ineq! (list '= a t) (list '<= t 1/2))))
  (fact 'rr-mul-le-right a 1/2 a)
  (dk-ineq! (list '<= (list '- p) d) (list '= p (list '* a a)) (list '<= (list '* a a) (list '* 1/2 a))
            (list '= a t) (list '< 0 t)))
(qed 'cek-exp-gt-one-small)

;;; 1 < x, 1 < y (reals)  ==>  1 < x y, landed
(define (cek-one-lt-mul! x y)
  (let ((g (list '< 1 (list '* x y))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'rr-one-in)
            (dk-have! (list '<= 1 x) (lambda () (dk-ineq! (list '< 1 x))))
            (dk-have! (list '<= 0 y) (lambda () (dk-ineq! (list '< 1 y))))
            (cek-rr-typ! (list '* x y))
            (dk-ineq! (dk-cite! 'rr-mul-le-right 1 x y) (list '< 1 y)))))
    g))
(sp (make-wff '(FORALL cekn_ (IMPLIES (IN cekn_ NN) (FORALL cekt_ (IMPLIES (IN cekt_ RR) (IMPLIES (< 0 cekt_)
  (IMPLIES (<= cekt_ (* cekn_ 1/2)) (< 1 (CC-EXP cekt_))))))))))
(cek-ind!
  (lambda ()
    (let* ((ld (dk-peel!)) (t (cek-land-var ld 'RR)))
      (cek-exp-rr! t)
      (fact 'rr-zero-in)
      (dk-ineq! (list '< 0 t) (list '<= t '(* 0 1/2)))))
  (lambda (v ih)
    (let* ((ld (dk-peel!)) (t (cek-land-var ld 'RR)) (sv (list 'succ v)))
      (cek-exp-rr! t)
      (fact 'nn-in-rr v) (cek-rr-typ! sv) (fact 'nn-succ-plus-one v)
      (fact 'rr-one-in) (cek-rr-typ! 1/2)
      (use-cases (dk-fact! 'rr-lt-trichotomy t 1/2)
        (lambda ()
          (dk-have! (list '<= t 1/2) (lambda () (dk-ineq! (list '< t 1/2))))
          (fact 'cek-exp-gt-one-small t) (ass))
        (lambda ()
          (dk-have! (list '<= t 1/2) (lambda () (dk-ineq! (list '= t 1/2))))
          (fact 'cek-exp-gt-one-small t) (ass))
        (lambda ()
          (let* ((s (list '- t 1/2)) (h 1/2) (es (list 'CC-EXP s)) (eh (list 'CC-EXP h)) (sh (list '+ s h)))
            (cek-rr-typ! s) (cek-rr-typ! sh)
            (cek-exp-rr! s) (cek-exp-rr! h) (cek-exp-rr! sh)
            (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 1/2 t))))
            (cek-rr-typ! (list '* v 1/2)) (cek-rr-typ! (list '* sv 1/2))
            (dk-have! (list '<= s (list '* v 1/2))
              (lambda () (dk-ineq! (list '<= t (list '* sv 1/2)) (list '= sv (list '+ v 1)))))
            (dk-apply! ih s)
            (dk-have! (list '< 0 h) (lambda () (dk-ineq!)))
            (dk-have! (list '<= h 1/2) (lambda () (dk-ineq!)))
            (fact 'cek-exp-gt-one-small h)
            (cek-and! (list 'IN s 'CC) (list 'IN h 'CC))
            (fact 'cc-exp-add s h)
            (cek-cc-typ! t)
            (dk-have! (list '= sh t) (lambda () (crs)))
            (dk-congr! (list '= sh t) (lambda (x) (list 'CC-EXP x)))
            (cek-one-lt-mul! es eh)
            (cek-rr-typ! (list '* es eh))
            (dk-ineq! (list '= (list 'CC-EXP sh) (list '* es eh)) (list '= (list 'CC-EXP sh) (list 'CC-EXP t))
                      (list '< 1 (list '* es eh)))))))))
(qed 'cek-exp-gt-one-n)

(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (IMPLIES (< 0 cekt_) (< 1 (CC-EXP cekt_)))))))
(dk-peel!)
(cek-rr-typ! 1/2)
(dk-have! '(< 0 1/2) (lambda () (dk-ineq!)))
(cek-pos-rr! 1/2)
(let ((n (dk-skolem! (dk-apply! (dk-fact! 'rr-archimedean-multiple 1/2) 'cekt_))))
  (dk-apply! (dk-fact! 'cek-exp-gt-one-n n) 'cekt_)
  (ass))
(qed 'cc-exp-real-gt-one)

(sp (make-wff '(FORALL cekt_ (IMPLIES (IN cekt_ RR) (IFF (= (CC-EXP cekt_) 1) (= cekt_ 0))))))
(dk-peel!)
(cek-exp-rr! 'cekt_)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(dk-iff! (lambda (g) (equal? g '(= cekt_ 0)))
  (lambda ()
    (use-cases (dk-fact! 'rr-lt-trichotomy 'cekt_ 0)
      (lambda ()
        (let ((m '(- cekt_)))
