            (lambda () (subst (list '= (list 'CC-EXP m) '(recip (CC-EXP cekt_)))) (subst '(= (CC-EXP cekt_) 1)) (arith)))
          (cek-exp-rr! m)
          (cek-absurd! (list '< 1 (list 'CC-EXP m)) (list '= (list 'CC-EXP m) 1))))
      (lambda () (ass))
      (lambda ()
        (fact 'cc-exp-real-gt-one 'cekt_)
        (cek-absurd! '(< 1 (CC-EXP cekt_)) '(= (CC-EXP cekt_) 1)))))
  (lambda ()
    (subst '(= cekt_ 0))
    (fact 'cc-exp-zero)
    (ass)))
(qed 'cc-exp-real-one-iff)

;;; ======================================================================
;;; (K) THE KERNEL K = {z : exp z = 1} IS A SUBGROUP OF (CC, +) INSIDE i RR.
