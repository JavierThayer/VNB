;;; mb4-sieve.scm -- construction of measures, Proposition 5.6 (M-B4, 2026-10-26): in a complete metric space
;;; a decreasing sequence of closed nonempty sets whose diameters tend to 0 meets in exactly one point (the
;;; notes' proof of 5.6: for each infinite sequence z the sets S_{z|n} of a sieve are such a sequence, so S_z
;;; is a singleton).  Vocabulary: mb4-vocab.scm (DIAM).  Library: measure.  Helper prefix mbc-.
;;;
;;;   diam-unfold, diam-dist-le    d(x, y) <= DIAM(s, a) for x, y in a
;;;   nested-closed-intersection   (Prop 5.6) the singleton intersection
;;;
;;; Load window: after mb4-vocab, theorem-library/riesz-markov-model (rmm-nn-choice) and the metric laws
;;; (closed-set-limit-in-tail, metric-limit-unique).
(define (mbc-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mbc-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define mbc-dset '(SEP dmr_ RR-POS-STAR (FORSOME dmx_ (AND (IN dmx_ mca_) (FORSOME dmy_ (AND (IN dmy_ mca_) (= dmr_ ((DIST s) dmx_ dmy_))))))))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'mca_ (list '== '(DIAM s mca_) (list 'ESUP mbc-dset))))))
(dk-peel!) (mac 'DIAM) (qrfl)
(qed 'diam-unfold)
(topic! 'diam-unfold 'analysis)

;;; CUT 2026-10-27 (integration): `diam-dist-le' was proven here AND in theorem-library/method-ii.scm (M-H),
;;; with alpha-equal statements (an accidental duplicate).  method-ii.scm loads earlier and keeps it; the
;;; citations below are to that theorem.

;;; ----------------------------------------------------------------------
;;; PROPOSITION 5.6, the intersection of nested closed nonempty sets with diameters tending to 0
;;; ----------------------------------------------------------------------
(define mbc-A 'mca_)
(define mbc-nonempty '(FORALL n (IMPLIES (IN n NN) (FORSOME mcx_ (IN mcx_ (mca_ n))))))
(define mbc-closed '(FORALL n (IMPLIES (IN n NN) (IS-CLOSED s (mca_ n)))))
(define mbc-mono '(FORALL n (IMPLIES (IN n NN) (SUBSET (mca_ (succ n)) (mca_ n)))))
(define mbc-diam '(FORALL eps (IMPLIES (POS-RR eps) (FORSOME mcbn_ (AND (IN mcbn_ NN)
                    (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= mcbn_ n) (<= (DIAM s (mca_ n)) eps)))))))))
(define mbc-in-all (lambda (p) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN p '(mca_ n))))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMPLETE s) (list 'FORALL 'mca_ (list 'IMPLIES '(IN mca_ (FUN NN (POWER (PTS s))))
  (list 'IMPLIES mbc-nonempty (list 'IMPLIES mbc-closed (list 'IMPLIES mbc-mono (list 'IMPLIES mbc-diam
    (list 'FORSOME 'mcp_ (list 'AND '(IN mcp_ (PTS s)) (list 'AND (mbc-in-all 'mcp_)
      (list 'FORALL 'mcq_ (list 'IMPLIES '(IN mcq_ (PTS s)) (list 'IMPLIES (mbc-in-all 'mcq_) '(= mcq_ mcp_)))))))))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-complete '(IS-COMPLETE s))
(fact 'ms-pts-is-set 's)
;; A(n) subset PTS(s)
(define (mbc-sub! n)
  (let ((g (list 'SUBSET (list 'mca_ n) '(PTS s))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'fun-apply-type-c 'mca_ 'NN '(POWER (PTS s)) n)
            (mac 'subset-def)
            (let ((z (dk-di-var!))) (fact 'power-mem-in '(PTS s) (list 'mca_ n) z) (mbc-close-open!)))))
    g))
;; nested: n <= m  ==>  A(m) subset A(n)
(define mbc-nest '(FORALL m (IMPLIES (IN m NN) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= n m) (SUBSET (mca_ m) (mca_ n))))))))
(dk-have! mbc-nest
  (lambda ()
    (let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
      (dk-focus! (cdr (assq 'base ind)))
      (let* ((lk (dk-peel!)) (n (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (mbc-chain! (dk-fact! 'nn-le-zero-is-zero n))
        (subst (list '= n 0))
        (fact 'nn-zero-in)
        (fact 'fun-apply-type-c 'mca_ 'NN '(POWER (PTS s)) 0)
        (fact 'subset-refl '(mca_ 0))
        (mbc-close-open!))
      (dk-focus! (cdr (assq 'step ind)))
      (let* ((lk (dk-peel!)) (n (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (eq? (cadr f) v)))) lk)))))
        (use-cases (mbc-chain! (dk-fact! 'nn-le-succ-cases v n))
          (lambda ()
            (dk-apply! ih n)
            (dk-apply! mbc-mono v)
            (fact 'nn-succ-closed v)
            (for-each (lambda (k) (fact 'fun-apply-type-c 'mca_ 'NN '(POWER (PTS s)) k)) (list (list 'succ v) v n))
            (fact 'subset-trans (list 'mca_ (list 'succ v)) (list 'mca_ v) (list 'mca_ n))
            (mbc-close-open!))
          (lambda ()
            (subst (list '= n (list 'succ v)))
            (fact 'nn-succ-closed v)
            (fact 'fun-apply-type-c 'mca_ 'NN '(POWER (PTS s)) (list 'succ v))
            (fact 'subset-refl (list 'mca_ (list 'succ v)))
            (mbc-close-open!)))))))
;; d(x, y) <= eps for x, y in A(n) and DIAM(A(n)) <= eps
(define (mbc-close! x y n eps)
  (mbc-sub! n)
  (dk-cite! 'diam-dist-le 's (list 'mca_ n) x y)
  (fact 'subset-mem-fwd (list 'mca_ n) '(PTS s) x)
  (fact 'subset-mem-fwd (list 'mca_ n) '(PTS s) y)
  (let ((d (list '(DIST s) x y)) (dm (list 'DIAM 's (list 'mca_ n))))
    (dk-cite! 'metric-dist-real 's x y) (dk-cite! 'metric-pos 's x y)
    (mbc-chain! (dk-fact! 'rmc-rps-of-nonneg d))
    (fact 'rr-pos-rr-in-rr eps) (fact 'rr-lt-of-pos-rr eps)
    (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
    (mbc-chain! (dk-fact! 'rmc-rps-of-nonneg eps))
    (let* ((du (dk-cite! 'diam-unfold 's (list 'mca_ n))) (es (caddr du)))
      (dk-have! (list 'IN dm 'RR-POS-STAR)
        (lambda ()
          (subst du)
          (dk-have! (list 'SUBSET (cadr es) 'RR-POS-STAR)
            (lambda () (mac 'subset-def) (let ((r (dk-di-var!))) (sep-me (list 'IN r (cadr es))) (dk-split-all!) (mbc-close-open!))))
          (dk-cite! 'esup-in (cadr es))
          (mbc-close-open!))))
    (mbc-chain! (dk-fact! 'rr-pos-star-le-trans d dm eps))))
;; choose x(n) in A(n)
(dk-have! '(FORALL k (IMPLIES (IN k NN) (FORSOME w (AND (IN w (PTS s)) (IN w (mca_ k))))))
  (lambda ()
    (let* ((k (dk-di-var!)) (x (dk-skolem! (dk-apply! mbc-nonempty k))))
      (mbc-sub! k)
      (fact 'subset-mem-fwd (list 'mca_ k) '(PTS s) x)
      (ew x)
      (dk-conj-close! (lambda () (ass))))))
(define mbc-g (dk-skolem! (dk-cite! 'rmm-nn-choice '(PTS s) 'mca_)))
(dk-split-all!)
(define mbc-gin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mbc-g) (dk-contains? f 'mca_))) "the choice"))
;; g(m) in A(n) for n <= m
(define (mbc-g-in! m n)
  (dk-apply! mbc-gin m)
  (dk-apply! mbc-nest m n)
  (fact 'subset-mem-fwd (list 'mca_ m) (list 'mca_ n) (list mbc-g m)))
;; g is Cauchy
(let* ((iff (dk-cite! 'is-cauchy-seq 's mbc-g)) (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((lk (dk-peel!))
                     (eps (cadr (car (filter (dk-head? 'POS-RR) lk))))
                     (bn (dk-skolem! (dk-apply! mbc-diam eps)))
                     (_0 (dk-split-all!)))
                (ew bn)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (let* ((lk2 (dk-peel!))
                               (g (dk-goal))
                               (m (cadr (cadr g))) (n2 (caddr (cadr g))))
                          (dk-split-all!)
                          (fact 'nn-le-refl bn)
                          (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIAM) (dk-contains? f bn))) "the diameter tail") bn)
                          (mbc-g-in! (cadr m) bn) (mbc-g-in! (cadr n2) bn)
                          (mbc-close! m n2 bn eps)
                          (mbc-close-open!)))))))))))
  (dk-have! (list 'IS-CAUCHY-SEQ 's mbc-g) (lambda () (dk-only! iff rhs) (prop))))
;; the limit p
(let* ((ci (dk-cite! 'is-complete 's)) (crhs (caddr ci)))
  (dk-have! crhs (lambda () (dk-only! ci '(IS-COMPLETE s)) (prop)))
  (dk-split-all! (list crhs)))
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CAUCHY-SEQ) (dk-contains? f 'CONVERGES))) "completeness") mbc-g)
(define mbc-p
  (let* ((cv (dk-cite! 'converges 's mbc-g)) (ex (caddr cv)))
    (dk-have! ex (lambda () (dk-only! cv (list 'CONVERGES 's mbc-g)) (prop)))
    (let ((p (dk-skolem! ex))) p)))
(define mbc-conv (list 'CONVERGES-TO 's mbc-g mbc-p))
(dk-project! (list 'IN mbc-p '(PTS s)) 'converges-to mbc-conv)
(ew mbc-p)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ;; p in every A(n): closed, and the tail of g lies in A(n)
        ((not (dk-contains? g 'mcq_))
         (let ((n (dk-di-var!)))
           (dk-have! (list 'FORALL 'mck_ (list 'IMPLIES '(IN mck_ NN) (list 'IMPLIES (list '<= n 'mck_) (list 'IN (list mbc-g 'mck_) (list 'mca_ n)))))
             (lambda () (let* ((lk (dk-peel!)) (m (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (eq? (cadr f) n)))) lk)))))
                          (mbc-g-in! m n) (mbc-close-open!))))
           (dk-apply! mbc-closed n)
           (dk-cite! 'closed-set-limit-in-tail 's (list 'mca_ n) mbc-g mbc-p n)
           (mbc-close-open!)))
        ;; uniqueness: g converges to every q of the intersection
        (#t
         (let* ((lk (dk-peel!)) (q (cadr (dk-goal))))
           (let* ((iff (dk-cite! 'converges-to 's mbc-g q)) (rhs (caddr iff)))
             (dk-have! rhs
               (lambda ()
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal))
                         (ass)
                         (let* ((lk2 (dk-peel!))
                                (eps (cadr (car (filter (dk-head? 'POS-RR) lk2))))
                                (bn (dk-skolem! (dk-apply! mbc-diam eps)))
                                (_0 (dk-split-all!)))
                           (ew bn)
                           (dk-conj-close!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (ass)
                                   (let* ((lk3 (dk-peel!))
                                          (n2 (cadr (cadr (cadr (dk-goal))))))
                                     (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIAM) (dk-contains? f bn))) "the diameter tail") n2)
                                     (dk-apply! mbc-gin n2)
                                     (dk-apply! (mbc-in-all q) n2)
                                     (mbc-close! (list mbc-g n2) q n2 eps)
                                     (mbc-close-open!)))))))))))
             (dk-have! (list 'CONVERGES-TO 's mbc-g q) (lambda () (dk-only! iff rhs) (prop)))
             (dk-cite! 'metric-limit-unique 's mbc-g q mbc-p)
             (mbc-close-open!))))))))
(qed 'nested-closed-intersection)
(topic! 'nested-closed-intersection 'analysis)
