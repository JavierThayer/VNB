;;; la-z2-principal.scm -- linear algebra 3.48: the principal sequence of a subgroup
;;; is uniquely determined (LA-Z2, 2026-10-23).
;;;
;;; Vocabulary: IS-PRINCIPAL-SEQUENCE (la-z2-vocab).  Uses la-z2-action (3.43 and the
;;; coefficient and cancellation lemmas) and la-z2-diag (3.36 uniqueness).  Prefix lzp-.
;;;
;;; PLAN.  Let (es, dm) and (es2, dm2) be principal sequences for sm: ws = dm . es and
;;; ws2 = dm2 . es2 both span sm.  By 3.43 es2 = um . es with um invertible.  Since ws2
;;; lies in sm, ws2 = xm . ws, and likewise ws = ym . ws2 (spans-coeff-matrix).
;;; Cancelling the relation-free es (rel-free-matact-cancel):
;;;     dm2 um = xm dm          and          (ym dm2) um = dm.
;;; By diagonal-right-factor-sdet-divisible the product c_s of the first s diagonal
;;; entries of dm divides every order-s subdeterminant of xm dm = dm2 um, hence (3.29 /
;;; 3.31 machinery, um^-1 a product of elementary matrices by 3.38) every one of
;;; dm2 = (dm2 um) um^-1, in particular the leading one c2_s.  Symmetrically c2_s | c_s.
;;; So c_s = +/- c2_s for every s, and diagonal-chain-products-determine gives dm = dm2.
;;; The notes' proof goes through the uniqueness in 3.36 by way of bases of F; this
;;; route needs no basis of F and no rank of F: the diagonal right factor replaces the
;;; Cauchy-Binet formula the minors of a product would otherwise need.
;;;
;;; Destination theorem-library/; after la-z2-diag and la-z2-vocab.  Library:
;;; linear-algebra.

(define (lzp-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z2-principal: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))
(define (lzp-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lzp-cite! thm . args) (lzp-detach-all! (apply dk-cite! thm args)))
(define (lzp-open! name . args)
  (let* ((hyp (cons name args))
         (ignore (apply fact name args))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let loop ((todo (list (dk-ctx-form rhs))) (acc '()))
      (cond ((null? todo) (reverse acc))
            ((dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo)) acc))
            (#t (loop (cdr todo) (cons (car todo) acc)))))))
(define (lzp-skolem-split! ex)
  (let ((w (dk-skolem! ex)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    w))

;;; the builders of la-z2-diag, for an n-by-n matrix (m := n) over ZZ-RING
(define (lzp-iv s) (list 'INTERVAL 1 s))
(define (lzp-pf d s) (list 'VNB-LAMBDA 'pk_ (lzp-iv s) (list 'ENTRY d 'pk_ 'pk_)))
(define (lzp-ps d s) (list 'PROD-RING 'ZZ-RING (lzp-pf d s) (lzp-iv s)))
(define (lzp-id s) (list 'VNB-LAMBDA 'idx_ (lzp-iv s) 'idx_))
(define (lzp-zdiv c x)
  (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR ZZ-RING)) (list '= x (list '(MUL ZZ-RING) c 'dvy_)))))
(define (lzp-rchain d)                     ; la-z2-diag's (lzd-chain d), R := ZZ-RING, m := n
  (list 'FORALL 'ci_ (list 'FORALL 'cj_
    (list 'IMPLIES '(IN ci_ (INTERVAL 1 n)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 n)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n))
    (list 'IMPLIES '(<= ci_ cj_) (lzp-zdiv (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(define (lzp-zchain d)                     ; (lzd-zchain d), m := n
  (list 'FORALL 'ci_ (list 'FORALL 'cj_
    (list 'IMPLIES '(IN ci_ (INTERVAL 1 n)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 n)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n))
    (list 'IMPLIES '(<= ci_ cj_) (list 'ZZ-DIVIDES (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(define (lzp-nonneg d)                     ; (lzd-nonneg d), m := n
  (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '<= 0 (list 'ENTRY d 'i_ 'i_))))))
(define (lzp-psign d d2)                   ; LZD-PSIGN, m := n
  (list 'FORALL 'ps_ (list 'IMPLIES '(IN ps_ NN) (list 'IMPLIES '(<= ps_ n) (list 'IMPLIES '(<= ps_ n)
    (list 'OR (list '= (lzp-ps d 'ps_) (lzp-ps d2 'ps_)) (list '= (lzp-ps d 'ps_) (list '- (lzp-ps d2 'ps_)))))))))
(define (lzp-colbody c q s)                ; la-z-gcd's (lzg-colbody q), R := ZZ-RING, m := n
  (list 'FORALL 'gca_ (list 'IMPLIES '(IN gca_ (MAT n n (CARR ZZ-RING)))
    (list 'IMPLIES (lzp-div-all c (list 'SDET 'ZZ-RING 'n 'n 'gca_ s))
                   (lzp-div-all c (list 'SDET 'ZZ-RING 'n 'n (list 'MATMUL 'ZZ-RING 'gca_ q) s))))))
(define (lzp-div-all c S)
  (list 'FORALL 'dvx_ (list 'IMPLIES (list 'IN 'dvx_ S)
    (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR ZZ-RING)) (list '= 'dvx_ (list '(MUL ZZ-RING) c 'dvy_)))))))

(define LZP-S '(SCAL md))
(define (lzp-mm a b) (list 'MATMUL LZP-S a b))
(define (lzp-zmm a b) (list 'MATMUL 'ZZ-RING a b))
(define (lzp-ma a b) (list 'MATACT 'md a b))

(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(n sm es es2 dm dm2)
    '((IN n NN) (IS-PRINCIPAL-SEQUENCE md n sm es dm) (IS-PRINCIPAL-SEQUENCE md n sm es2 dm2))
    '(= dm dm2)))))
(dk-peel!)
(define LZP-P1 (lzp-open! 'IS-PRINCIPAL-SEQUENCE 'md 'n 'sm 'es 'dm))
(define LZP-P2 (lzp-open! 'IS-PRINCIPAL-SEQUENCE 'md 'n 'sm 'es2 'dm2))
(fact 'module-scalar-ring 'md)
(fact 'zz-is-commutative-ring) (fact 'zz-is-ring) (fact 'zz-is-euclidean-ring)
(fact 'nn-one-in)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(dk-rewrite-h! '(IS-COMMUTATIVE-RING ZZ-RING) 'ZZ-RING LZP-S)
(define (lzp-up! a)                       ; a in MAT(n,n,ZZ) => over CARR(ZZ-RING) and CARR(SCAL md)
  (let ((f1 (dk-rewrite-h! (list 'IN a '(MAT n n ZZ)) 'ZZ '(CARR ZZ-RING))))
    (dk-rewrite-h! f1 'ZZ-RING LZP-S)))
(define (lzp-down! f)                     ; F over (SCAL md) => F over ZZ-RING
  (dk-rewrite-h! f LZP-S 'ZZ-RING))
(lzp-up! 'dm)
(lzp-up! 'dm2)
(define LZP-WS (lzp-ma 'dm 'es))
(define LZP-WS2 (lzp-ma 'dm2 'es2))
(lzp-cite! 'matact-type 'md 'n 'n 1 'dm 'es)
(lzp-cite! 'matact-type 'md 'n 'n 1 'dm2 'es2)
(dk-have-prop! '(IMPLIES (= n 0) (= n 0)))
;; es2 = um . es; ws2 = xm . ws; ws = ym . ws2
(define LZP-UM (lzp-skolem-split! (dk-cite! 'free-generating-action-transitive 'md 'n 'es 'es2)))
(dk-cite! 'invertible-mat-is-mat LZP-S 'n LZP-UM)
(define (lzp-entries! ws)
  (let ((parts (lzp-open! 'SPANS 'md 'n ws 'sm)))
    (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'LINCOMB)))) parts)))
(lzp-entries! LZP-WS)
(lzp-entries! LZP-WS2)
(define LZP-XM (lzp-skolem-split! (dk-cite! 'spans-coeff-matrix 'md 'n 'n LZP-WS LZP-WS2 'sm)))
(define LZP-YM (lzp-skolem-split! (dk-cite! 'spans-coeff-matrix 'md 'n 'n LZP-WS2 LZP-WS 'sm)))
(define LZP-YD2 (lzp-mm LZP-YM 'dm2))
(for-each (lambda (ab) (lzp-cite! 'matmul-type LZP-S 'n 'n 'n (car ab) (cadr ab)))
          (list (list 'dm2 LZP-UM) (list LZP-XM 'dm) (list LZP-YM 'dm2)))
(lzp-cite! 'matmul-type LZP-S 'n 'n 'n LZP-YD2 LZP-UM)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'es)
;; the two matrix relations, by cancelling es
(let ((a1 (lzp-cite! 'matact-assoc 'md 'n 'n 'n 1 'dm2 LZP-UM 'es))
      (a2 (lzp-cite! 'matact-assoc 'md 'n 'n 'n 1 LZP-XM 'dm 'es)))
  (dk-have! (list '= (lzp-ma (lzp-mm 'dm2 LZP-UM) 'es) (lzp-ma (lzp-mm LZP-XM 'dm) 'es))
    (lambda ()
      (subst a1)
      (subst (list '= (lzp-ma LZP-UM 'es) 'es2))
      (subst a2)
      (subst (list '= (lzp-ma LZP-XM LZP-WS) LZP-WS2))
      (rfl))))
(define LZP-C1 (dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'es (lzp-mm 'dm2 LZP-UM) (lzp-mm LZP-XM 'dm)))
(let ((a3 (lzp-cite! 'matact-assoc 'md 'n 'n 'n 1 LZP-YD2 LZP-UM 'es))
      (a4 (lzp-cite! 'matact-assoc 'md 'n 'n 'n 1 LZP-YM 'dm2 'es2)))
  (dk-have! (list '= (lzp-ma (lzp-mm LZP-YD2 LZP-UM) 'es) LZP-WS)
    (lambda ()
      (subst a3)
      (subst (list '= (lzp-ma LZP-UM 'es) 'es2))
      (subst a4)
      (subst (list '= (lzp-ma LZP-YM LZP-WS2) LZP-WS))
      (rfl))))
(define LZP-C2 (dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'es (lzp-mm LZP-YD2 LZP-UM) 'dm))

;;; ---- the matrix stage, over ZZ-RING ----
(define LZP-ZC1 (lzp-down! LZP-C1))
(define LZP-ZC2 (lzp-down! LZP-C2))
(for-each (lambda (a) (lzp-down! (list 'IN a '(MAT n n (CARR (SCAL md)))))) (list LZP-UM LZP-XM LZP-YM))
(lzp-down! (list 'IS-INVERTIBLE-MAT LZP-S 'n LZP-UM))
(define LZP-ZYD2 (lzp-zmm LZP-YM 'dm2))
(lzp-cite! 'matmul-type 'ZZ-RING 'n 'n 'n 'dm2 LZP-UM)
(lzp-cite! 'matmul-type 'ZZ-RING 'n 'n 'n LZP-YM 'dm2)
;; um and its inverse are products of elementary matrices
(define LZP-UM1
  (let* ((parts (lzp-open! 'IS-INVERTIBLE-MAT 'ZZ-RING 'n LZP-UM))
         (ex (find-first (dk-head? 'FORSOME) parts)))
    (lzp-skolem-split! ex)))
(dk-cite! 'inverse-is-invertible 'ZZ-RING 'n LZP-UM LZP-UM1)
(define (lzp-elem-gen! w)
  (let* ((iff (dk-cite! 'euclidean-invertible-iff-elem-gen 'ZZ-RING 'n w))
         (want (list 'IN w '(ELEM-GEN ZZ-RING n))))
    (dk-have! want (dk-lane (lambda () (dk-only! iff (list 'IS-INVERTIBLE-MAT 'ZZ-RING 'n w)) (dk-lane-if! prop))))))
(lzp-elem-gen! LZP-UM)
(lzp-elem-gen! LZP-UM1)
;; (dm2 um) um^-1 = dm2
(let ((as (lzp-cite! 'matmul-assoc 'ZZ-RING 'n 'n 'n 'n 'dm2 LZP-UM LZP-UM1)))
  (fact 'identmat-right-identity 'ZZ-RING 'n 'n 'dm2)
  (dk-have! (list '= (lzp-zmm (lzp-zmm 'dm2 LZP-UM) LZP-UM1) 'dm2)
    (lambda ()
      (subst as)
      (subst (list '= (lzp-zmm LZP-UM LZP-UM1) '(IDENTMAT ZZ-RING n)))
      (subst (list '= (lzp-zmm 'dm2 '(IDENTMAT ZZ-RING n)) 'dm2))
      (rfl))))
;; the chain, the diagonal and the signs in the forms of la-z2-diag
(define (lzp-forms! d)
  (let ((ch1 (list 'FORALL 'psi_ (list 'FORALL 'psj_ (list 'IMPLIES '(IN psi_ (INTERVAL 1 n)) (list 'IMPLIES '(IN psj_ (INTERVAL 1 n))
               (list 'IMPLIES '(<= psi_ psj_) (list 'ZZ-DIVIDES (list 'ENTRY d 'psi_ 'psi_) (list 'ENTRY d 'psj_ 'psj_))))))))
        (nn1 (list 'FORALL 'psi_ (list 'IMPLIES '(IN psi_ (INTERVAL 1 n)) (list '<= 0 (list 'ENTRY d 'psi_ 'psi_))))))
    (dk-have! (lzp-zchain d)
      (lambda ()
        (let* ((ld (dk-peel!)) (le (find-first (dk-head? '<=) ld)))
          (dk-apply! ch1 (cadr le) (caddr le))
          (ass))))
    (dk-have! (lzp-rchain d)
      (lambda ()
        (let* ((ld (dk-peel!)) (le (find-first (dk-head? '<=) ld)) (ci (cadr le)) (cj (caddr le)))
          (dk-apply! ch1 ci cj)
          (dk-cite! 'lzg-zz-to-ring (list 'ENTRY d ci ci) (list 'ENTRY d cj cj))
          (ass))))
    (dk-have! (lzp-nonneg d)
      (lambda ()
        (let ((x (cadr (find-first (dk-head? 'IN) (dk-peel!)))))
          (dk-apply! nn1 x)
          (ass))))))
(lzp-forms! 'dm)
(lzp-forms! 'dm2)
;; the leading subdeterminant of d is in SDET and equals its product
(define (lzp-lead! d s)
  (let* ((idm (lzp-id s))
         (lead (list 'SUBMATRIX d s idm idm))
         (ps (lzp-ps d s)))
    (dk-cite! 'lzd-id-injection s 'n)
    (dk-cite! 'injection-membership-iff (lzp-iv s) (lzp-iv 'n) idm)
    (let* ((iff (iff-for (list 'IN idm (list 'INJECTION (lzp-iv s) (lzp-iv 'n)))))
           (c1 (cadr (caddr iff))))
      (if (not (dk-asm? c1)) (dk-have! c1 (dk-lane (lambda () (dk-only! iff (list 'IN idm (list 'INJECTION (lzp-iv s) (lzp-iv 'n)))) (dk-lane-if! prop))))))
    (dk-cite! 'submatrix-type 'ZZ-RING 'n 'n s d idm idm)
    (dk-cite! 'sdet-intro 'ZZ-RING 'n 'n s d idm idm)
    (dk-cite! 'diagonal-leading-minor 'ZZ-RING 'n 'n d s)
    (dk-cite! 'det-in-carrier 'ZZ-RING s lead)
    (let* ((t1 (dk-rewrite-h! (list 'IN (list 'DET 'ZZ-RING s lead) '(CARR ZZ-RING)) (list 'DET 'ZZ-RING s lead) ps)))
      (if (not (dk-asm? (list 'IN ps 'ZZ))) (dk-rewrite-h! t1 '(CARR ZZ-RING) 'ZZ)))
    (list 'DET 'ZZ-RING s lead)))
;; from DIV-ALL(c, SDET(d)) in context: (ZZ-DIVIDES c PS(d, s))
(define (lzp-divides-lead! c d s)
  (let* ((dl (lzp-lead! d s))
         (all (lzp-div-all c (list 'SDET 'ZZ-RING 'n 'n d s)))
         (y (lzp-skolem-split! (dk-apply! all dl)))
         (ps (lzp-ps d s))
         (h (dk-rewrite-h! (list '= dl (list '(MUL ZZ-RING) c y)) dl ps)))
    (dk-cite! 'lzg-ring-to-zz c ps y)))
(dk-have! (lzp-psign 'dm 'dm2)
  (lambda ()
    (let* ((ld (dk-peel!))
           (sv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld)))
           (c (lzp-ps 'dm sv)) (c2 (lzp-ps 'dm2 sv)))
      (lzp-lead! 'dm sv)
      (lzp-lead! 'dm2 sv)
      (dk-rewrite-h! (list 'IN c 'ZZ) 'ZZ '(CARR ZZ-RING))
      (dk-rewrite-h! (list 'IN c2 'ZZ) 'ZZ '(CARR ZZ-RING))
      ;; c divides the subdeterminants of xm dm = dm2 um, hence of dm2
      (let* ((d1 (dk-cite! 'diagonal-right-factor-sdet-divisible 'ZZ-RING 'n 'n sv LZP-XM 'dm))
             (d1b (dk-rewrite-h! d1 (lzp-zmm LZP-XM 'dm) (lzp-zmm 'dm2 LZP-UM))))
        (dk-cite! 'sdet-divisor-col-gen 'ZZ-RING 'n 'n sv c LZP-UM1)
        (let* ((r (dk-apply! (lzp-colbody c LZP-UM1 sv) (lzp-zmm 'dm2 LZP-UM)))
               (r2 (dk-rewrite-h! r (lzp-zmm (lzp-zmm 'dm2 LZP-UM) LZP-UM1) 'dm2)))
          (lzp-divides-lead! c 'dm2 sv)))
      ;; c2 divides the subdeterminants of ym dm2, hence of (ym dm2) um = dm
      (let ((d2 (dk-cite! 'diagonal-right-factor-sdet-divisible 'ZZ-RING 'n 'n sv LZP-YM 'dm2)))
        (dk-cite! 'sdet-divisor-col-gen 'ZZ-RING 'n 'n sv c2 LZP-UM)
        (let* ((r (dk-apply! (lzp-colbody c2 LZP-UM sv) LZP-ZYD2))
               (r2 (dk-rewrite-h! r (lzp-zmm LZP-ZYD2 LZP-UM) 'dm)))
          (lzp-divides-lead! c2 'dm sv)))
      (dk-cite! 'zz-divides-antisym c c2)
      (ass))))
(dk-cite! 'diagonal-chain-products-determine 'n 'n 'dm 'dm2)
(ass)
(lzp-done! 'principal-sequence-unique)
(topic! 'principal-sequence-unique 'algebra)
(gloss! 'principal-sequence-unique "Linear algebra 3.48: the principal sequence of a subgroup of a free abelian group of rank n does not depend on the basis it corresponds to.")
