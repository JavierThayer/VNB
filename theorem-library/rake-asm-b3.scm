    (if (dk-asm? (dk-goal)) (ass)
      (begin
        (mac 'rr-scalar-ring-carr)
        (dk-peel!)
        (let* ((g (dk-goal)) (app (cadr g)) (r (cadr app)) (x (caddr app)))
