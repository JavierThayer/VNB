;;; a goal among the metric laws at points in context, closed by the named law
(define (rb3-metric-law! g1)
  (let* ((lhs (if (eq? (car g1) '<=) (caddr g1) (cadr g1))))
    (cond
      ((and (eq? (car g1) '=) (eqv? (caddr g1) 0))
       (dk-cite! 'metric-self-zero 'md (cadr (cadr g1))))
      ((and (eq? (car g1) '<=) (eqv? (cadr g1) 0))
       (dk-cite! 'metric-pos 'md (cadr lhs) (caddr lhs)))
      ((eq? (car g1) '=)
       (dk-cite! 'metric-sym 'md (cadr (cadr g1)) (caddr (cadr g1))))
      (#t
       (let ((u (cadr (cadr g1))) (w (caddr (cadr g1))) (v (caddr (cadr (caddr g1)))))
         (dk-cite! 'metric-triangle 'md u v w))))
    (rb3-close!)))

;;; P2.  a metric is a pseudometric.
(sp (make-wff '(FORALL md (IMPLIES (IS-METRIC-SPACE md) (IS-PSEUDOMETRIC (DIST md) (PTS md))))))
(dk-peel!)
(mac 'is-pseudometric)
(let loop ()
  (let ((g0 (dk-goal)))
    (cond
      ((memq (car g0) '(FORALL IMPLIES)) (dk-peel!) (loop))
      ((eq? (car g0) 'AND)
       (dk-conj-close!
         (lambda ()
           (let* ((g1 (dk-goal)))
             (if (memq (car g1) '(FORALL IMPLIES))
                 (begin (dk-peel!) (loop))
                 (rb3-metric-law! g1))))))
      (#t (rb3-metric-law! g0)))))
(rb3-qed! 'rb3-metric-pseudo)

(define rb3-fam1 '(VNB-LAMBDA zn_ NN (LIST (PTS md) (DIST md))))
(sp (make-wff (list 'FORALL 'md (list 'IMPLIES '(IS-METRIC-SPACE md)
  (rb3-fa 'n_ 'NN (list '== (list 'DIST (list rb3-fam1 'n_)) '(DIST md)))))))
(dk-peel!)
(dk-lam-b!)
(dk-split-all! (list (dk-cite! 'rb3-tuple2 '(PTS md) '(DIST md))))
(rb3-close!)
(rb3-qed! 'rb3-fam1-dist)

;;; detach a cited implication whose antecedent is a conjunction, proving the conjunction
;;; leaf by leaf with CLOSER
(define (rb3-detach-and! imp closer)
  (dk-have! (cadr imp) (lambda () (dk-conj-close! closer)))
  (rb3-apply! imp))

;;; P3.  for a metric, the metric-open sets are the gauge-open sets of the one-member family.
(define (rb3-ew-close! w k)       ; (ew w) on the focus, then K on the one non-context leaf
  (ew w)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (k)))))

;;; metric-open => gauge-open: the radius of a ball, at k = 0
(define (rb3-p3-point! y r)
  (let* ((ld (dk-peel!))
         (x (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) ld))))
         (h (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL))) ld)))
         (d (list '(DIST md) y x)))
    (dk-have! '(<= 0 0) (lambda () (arith)))
    (let ((lt (rb3-apply! h 0)))
      (dk-cite! 'rb3-fam1-dist 'md 0)
      (dk-rewrite-h! lt (list 'DIST (list rb3-fam1 0)) '(DIST md)))
    (dk-cite! 'metric-dist-real 'md y x)
    (rb3-detach-and! (dk-cite! 'ball-mem-from-le 'md y x d r)
      (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list 'IN d 'RR)))))
    (dk-cite! 'subset-mem-fwd (list 'BALL 'md y r) 'u x)
    (rb3-close!)))
(define (rb3-p3-fwd!)
  (let* ((iff (dk-cite! 'is-open 'md 'u))
         (fa (dk-project! (caddr (caddr (caddr iff))) 'is-open '(IS-OPEN md u))))
    (mac 'is-open-gauge)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
          (let* ((y (dk-di-var!))
                 (r (dk-skolem! (rb3-apply! fa y))))
            (dk-cite! 'nn-zero-in)
            (dk-cite! 'subset-mem-fwd 'u '(PTS md) y)
            (rb3-pos-parts! r)
            (rb3-ew-close! 0 (lambda () (rb3-ew-close! r (lambda () (rb3-p3-point! y r)))))))))))

;;; gauge-open => metric-open: the ball of the gauge radius
(define (rb3-p3-ball! y k r imp)
  (mac 'subset-def)
  (let* ((z (dk-di-var!)) (d (list '(DIST md) y z))
         (bm (dk-cite! 'ball-membership 'md y r z))
         (parts (list 'AND (list 'IN z '(PTS md)) (list 'AND (list '<= d r) (list 'NOT (list '= d r))))))
    (dk-have! parts (lambda () (rb3-prop! bm (list 'IN z (list 'BALL 'md y r)))))
    (dk-split-all! (list (dk-ctx-form parts)))
    (dk-cite! 'metric-dist-real 'md y z)
    (dk-have! (list 'AND (list '<= d r) (list 'NOT (list '= d r))))
    (dk-cite! 'rr-le-ne-lt d r)
    (let ((ant (subst-free (cadr imp) z (cadr (caddr (caddr imp))))))
      (dk-have! ant
        (lambda ()
          (let* ((ld (dk-peel!))
                 (n (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) ld)))))
            (dk-cite! 'rb3-fam1-dist 'md n)
            (subst (list '= (list 'DIST (list rb3-fam1 n)) '(DIST md)))
            (rb3-close!)))))
    (rb3-apply! imp z)
    (rb3-close!)))
(define (rb3-p3-bwd!)
  (mac 'is-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
        (let* ((y (dk-di-var!))
               (kw (rb3-og-at-with! rb3-fam1 '(PTS md) 'u y))
               (k (car kw)) (r (cadr kw)) (imp (caddr kw)))
          (dk-cite! 'subset-mem-fwd 'u '(PTS md) y)
          (rb3-pos-parts! r)
          (rb3-ew-close! r (lambda () (rb3-p3-ball! y k r imp))))))))

(sp (make-wff (list 'FORALL 'md (list 'IMPLIES '(IS-METRIC-SPACE md) (list 'FORALL 'u (list 'IMPLIES '(SUBSET u (PTS md))
  (list 'IFF '(IS-OPEN md u) (list 'IS-OPEN-GAUGE rb3-fam1 '(PTS md) 'u))))))))
(dk-peel!)
(dk-iff! (lambda (g0) (eq? (car g0) 'IS-OPEN-GAUGE)) rb3-p3-fwd! rb3-p3-bwd!)
(rb3-qed! 'rb3-metric-gauge-iff)

(define (rb3-sub-of-pow-in! w a)     ; (SUBSET w a) from (IN w (POWER a))
  (dk-have! (list 'SUBSET w a)
    (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (rb3-pow-mem! w a z)))))

;;; the (=>) half
(define rb3-sep-g1 (list 'SEP 'u '(POWER (PTS md)) (list 'IS-OPEN-GAUGE rb3-fam1 '(PTS md) 'u)))
(define rb3-sep-m '(SEP u (POWER (PTS md)) (IS-OPEN md u)))
(sp (make-wff '(FORALL s (IMPLIES (IS-TOP-SPACE s) (IMPLIES (IS-METRIZABLE-TOP-SPACE s)
   (AND (IS-HAUSDORFF s) (IS-GAUGE-COUNTABLE s)))))))
(dk-peel!)
(dk-cite! 'rb3-metrizable-hausdorff 's)
(let* ((mdv (dk-skolem! (dk-cite! 'metrizable-has-metric-top 's)))
       (mz (lambda (f) (rb3-replace f 'md mdv)))
       (fam1 (mz rb3-fam1)) (sg (mz rb3-sep-g1)) (sm (mz rb3-sep-m)))
  (dk-have! (mz '(= (PTS s) (PTS md))) (lambda () (subst (mz '(= s (METRIC-TOP md)))) (slot 'PTS) (rfl)))
  (dk-have! (mz '(AND (IN (PTS md) SET) (IN (DIST md) (FUN (CARTESIAN (PTS md) (PTS md)) RR))))
    (lambda () (mac-h 'is-metric-space (dk-ctx-form (mz '(IS-METRIC-SPACE md)))) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
  (dk-split-all! (list (dk-ctx-form (mz '(AND (IN (PTS md) SET) (IN (DIST md) (FUN (CARTESIAN (PTS md) (PTS md)) RR)))))))
  (dk-cite! 'rb3-metric-pseudo mdv)
  (dk-cite! 'rb3-pms-of (mz '(PTS md)) (mz '(DIST md)))
  (dk-split-all! (list (dk-cite! 'rb3-tuple2 (mz '(PTS md)) (mz '(DIST md)))))
  (dk-have! (list 'IS-COUNTABLE-PSEUDOMETRIC-FAMILY fam1 (mz '(PTS md)))
    (lambda () (mac 'is-countable-pseudometric-family) (dk-peel!) (dk-lam-b!) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list '= sg sm)
    (lambda ()
      (let ((ext (list 'FORALL 'hx_ (list 'IFF (list 'IN 'hx_ sg) (list 'IN 'hx_ sm)))))
        (dk-have! ext
          (lambda ()
            (let ((x (begin (di) (cadr (cadr (dk-goal))))))
              (define (side! from to)
                (let ((both (list 'AND (list 'IN x (mz '(POWER (PTS md)))) (subst-free 'u x (cadddr from)))))
                  (dk-have! both (lambda () (sep-me (dk-ctx-form (list 'IN x from))) (dk-conj-close! (lambda () (ass)))))
                  (dk-split-all! (list (dk-ctx-form both))))
                (rb3-sub-of-pow-in! x (mz '(PTS md)))
                (let ((iff (dk-cite! 'rb3-metric-gauge-iff mdv x)))
                  (for-each (lambda (l) (dk-focus! l)
                              (if (not (dk-asm? (dk-goal)))
                                  (rb3-prop! iff (subst-free 'u x (cadddr from))))
                              (rb3-close!))
                            (dk-opened (lambda () (sep-mi))))))
              (dk-iff! (lambda (g0) (equal? g0 (list 'IN x sm)))
                (lambda () (side! sg sm))
                (lambda () (side! sm sg))))))
        (dk-cite! 'class-extensionality sg sm)
        (rb3-close!))))
  (dk-have! (list '== (list 'PSEUDO-GAUGE-TOP fam1 (mz '(PTS md))) (mz '(METRIC-TOP md)))
    (lambda () (mac 'PSEUDO-GAUGE-TOP) (mac 'METRIC-TOP) (subst (list '= sg sm)) (qrfl)))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
        (begin
          (mac 'is-gauge-countable)
          (subst (mz '(= (PTS s) (PTS md))))
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                (rb3-ew-close! fam1 (lambda () (subst (mz '(= s (METRIC-TOP md)))) (rb3-close!)))))))))))
(rb3-qed! 'rb3-mgc-fwd)

;;; =====================================================================
;;; (VII) metrizable-iff-gauge-countable, (<=): the canonical metric of the family
;;;       (c-metric-space.scm, proven a metric in c-metric-is-metric.scm) induces the
;;;       gauge topology.  The two estimates: a term of the defining series is at most
;;;       the distance (K1), and the distance is at most r + e once the first bnd
;;;       pseudometrics are below r, bnd chosen from the weight tail (K2).
;;; =====================================================================
(define rb3-cmw '(C-METRIC-W cs w))
(define (rb3-dd x y) (list (list 'DIST rb3-cmw) x y))
(define (rb3-dk n x y) (list (list '(DISTS cs) n) x y))
(define (rb3-fxy x y) (list 'VNB-LAMBDA 'k 'NN (list '* '(w k) (list 'min 1 (rb3-dk 'k x y)))))
(define (rb3-sw-part! claim)
  (dk-have! claim (lambda () (mac-h 'summable-weight (dk-ctx-form '(SUMMABLE-WEIGHT w))) (dk-split-all!) (ass))))

;;; K1.  a term is at most the distance.
(sp (make-wff '(FORALL cs (IMPLIES (IS-C-METRIC-SPACE cs) (FORALL w (IMPLIES (SUMMABLE-WEIGHT w)
  (FORALL x (FORALL y (IMPLIES (IN x (PTS cs)) (IMPLIES (IN y (PTS cs))
    (FORALL n_ (IMPLIES (IN n_ NN) (<= (* (w n_) (min 1 (((DISTS cs) n_) x y))) ((DIST (C-METRIC-W cs w)) x y))))))))))))))
(dk-peel!)
(dk-cite! 'c-metric-dist-converges 'cs 'w 'x 'y)
(dk-cite! 'c-metric-term-seq-in-fun 'cs 'w 'x 'y)
(dk-cite! 'cmim-term-nonneg 'cs 'w 'x 'y)
(let ((h (rb3-apply! (dk-cite! 'series-term-le-sum (rb3-fxy 'x 'y)) (rb3-dd 'x 'y) 'n_)))
  (dk-lam-b-h! h)
  (rb3-close!))
(rb3-qed! 'rb3-cm-term-le)

;;; K2.  the distance is at most r + e once the first bnd pseudometrics are below r.
(define (rb3-innermost f)        ; the final consequent under leading FORALL / IMPLIES
  (cond ((and (pair? f) (eq? (car f) 'FORALL)) (rb3-innermost (caddr f)))
        ((and (pair? f) (eq? (car f) 'IMPLIES)) (rb3-innermost (caddr f)))
        (#t f)))
(define (rb3-peel-var!)          ; peel; return the variable of the first (IN v _) landed
  (let ((ld (dk-peel!)))
    (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) ld)))))
(define (rb3-w-nonneg! i)        ; (<= 0 (w i)) from SUMMABLE-WEIGHT's positivity
  (rb3-ty! (list 'w i) 'RR)
  (let ((pos (rb3-apply! (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (< 0 (w n))))) i)))
    (dk-have! (list '<= 0 (list 'w i)) (lambda () (dk-ineq! pos (list 'IN (list 'w i) 'RR))))))

(define rb3-k2-statement
  (list 'FORALL 'cs (list 'IMPLIES '(IS-C-METRIC-SPACE cs) (list 'FORALL 'w (rb3-imps (list '(SUMMABLE-WEIGHT w)
    (rb3-fa 'k_ 'NN '(<= (series-partial-sum w k_) 1)))
  (list 'FORALL 'e (list 'IMPLIES '(POS-RR e)
    (list 'FORSOME 'bnd (list 'AND '(IN bnd NN)
      (rb3-fa 'x '(PTS cs) (rb3-fa 'y '(PTS cs) (rb3-fa 'r 'RR (list 'IMPLIES '(< 0 r)
        (list 'IMPLIES (rb3-fa 'n_ 'NN (list 'IMPLIES '(<= n_ bnd) (list '< (rb3-dk 'n_ 'x 'y) 'r)))
              (list '<= (rb3-dd 'x 'y) '(+ r e))))))))))))))))

(define (rb3-k2-point! bnd tail)
  ;; focus: the main clause at bnd, with x y r (0 < r) and the bound H peeled
  (let* ((ld (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) ld)))
         (x (car vs)) (y (cadr vs)) (r (caddr vs))
         (hh (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL))) ld)))
         (f (rb3-fxy x y))
         (h (list 'VNB-LAMBDA 'k 'NN (list '* '(w k) (list 'min (list 'min 1 (rb3-dk 'k x y)) r))))
         (rw (list 'VNB-LAMBDA 'k 'NN (list '* r '(w k))))
         (ps (list 'VNB-LAMBDA 'k 'NN (list 'series-partial-sum f 'k)))
         (dxy (rb3-dd x y))
         (sw (list 'series-partial-sum 'w bnd)))
    (dk-cite! 'c-metric-term-seq-in-fun 'cs 'w x y)
    (dk-cite! 'cmim-dist-in-rr 'cs 'w x y)
    (rb3-ty! (list '+ r 'e) 'RR)
    (let ((conv (dk-cite! 'c-metric-dist-converges 'cs 'w x y)))
      (mac-h 'series-converges-to conv))
    (dk-cite! 'series-partial-sum-seq-in-fun f)
    ;; S(f, bnd) <= r
    (let ((sfb (list 'series-partial-sum f bnd)) (shb (list 'series-partial-sum h bnd))
          (srb (list 'series-partial-sum rw bnd)))
      (define (dk-of k) (rb3-dk k x y))
      (define (h-type!)
        (let ((k (rb3-peel-var!))) (if (not (dk-lam-b!)) (begin (rb3-ty! (cadr (dk-goal)) 'RR) (rb3-close!)))))
      (dk-chain! (dk-cite! 'series-partial-sum-agree-below bnd f h)
        (lambda (ante)
          (if (eq? (car (rb3-innermost ante)) 'IN)
              h-type!
              (lambda ()
                (let* ((k (rb3-peel-var!)) (d (dk-of k)) (m (list 'min 1 d)))
                  (dk-lam-b!)
                  (dk-have! (list '<= k bnd) (lambda () (dk-nn! (list '< k bnd))))
                  (rb3-apply! hh k)
                  (rb3-ty! m 'RR)
                  (dk-cite! 'rr-min-le-right 1 d)
                  (dk-have! (list '<= m r) (lambda () (dk-ineq! (list '<= m d) (list '< d r) (list 'IN m 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
                  (subst (dk-cite! 'rr-min-left-le m r))
                  (rb3-ty! (list '* (list 'w k) m) 'RR)
                  (rfl))))))
      (dk-chain! (dk-cite! 'series-partial-sum-le-termwise-ptwise bnd h rw)
        (lambda (ante)
          (let ((body (rb3-innermost ante)))
            (cond
              ((and (eq? (car body) 'IN) (dk-contains? body 'min)) h-type!)
              ((eq? (car body) 'IN)
               (lambda () (let ((k (rb3-peel-var!))) (if (not (dk-lam-b!)) (begin (rb3-ty! (cadr (dk-goal)) 'RR) (rb3-close!))))))
              (#t
               (lambda ()
                 (let* ((k (rb3-peel-var!)) (d (dk-of k)) (mm (list 'min (list 'min 1 d) r)) (wk (list 'w k)))
                   (dk-lam-b!)
                   (rb3-ty! mm 'RR) (rb3-w-nonneg! k)
                   (dk-cite! 'rr-min-le-right (list 'min 1 d) r)
                   (dk-cite! 'rr-mul-le-right mm r wk)
                   (subst (rb3-comm! wk mm))
                   (subst (rb3-comm! r wk))
                   (subst (rb3-comm! wk r))
                   (rb3-close!))))))))
      (dk-chain! (dk-cite! 'series-partial-sum-scale-ptwise bnd r 'w rw)
        (lambda (ante)
          (if (eq? (car (rb3-innermost ante)) 'IN)
              (lambda () (let ((k (rb3-peel-var!))) (rb3-ty! (list 'w k) 'RR) (rb3-close!)))
              (lambda () (let ((k (rb3-peel-var!))) (rb3-ty! (list '* r (list 'w k)) 'RR) (if (not (dk-lam-b!)) (rfl)))))))
      (rb3-apply! (dk-ctx-form (rb3-fa 'k_ 'NN '(<= (series-partial-sum w k_) 1))) bnd)
      (rb3-ty! sw 'RR) (rb3-ty! sfb 'RR)
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
      (dk-cite! 'rr-mul-le-right sw 1 r)
      (rb3-comm! r sw)
      (dk-have! (list 'IN shb 'RR) (lambda () (subst (list '= shb sfb)) (rb3-close!)))
      (dk-have! (list 'IN srb 'RR) (lambda () (subst (list '= srb (list '* r sw))) (rb3-ty! (list '* r sw) 'RR) (rb3-close!)))
      (rb3-ty! (list '* r sw) 'RR) (rb3-ty! (list '* sw r) 'RR)
      (dk-have! (list '<= sfb r)
        (lambda ()
          (dk-ineq! (list '= sfb shb) (list '<= shb srb) (list '= srb (list '* r sw))
                    (list '= (list '* r sw) (list '* sw r)) (list '<= (list '* sw r) (list '* 1 r))
                    (list 'IN sfb 'RR) (list 'IN shb 'RR) (list 'IN srb 'RR) (list 'IN (list '* r sw) 'RR)
                    (list 'IN (list '* sw r) 'RR) (list 'IN r 'RR))))
      ;; the tail: for K >= bnd, S(f, K) <= S(f, bnd) + (S(w, K) - S(w, bnd)) <= r + e
      (dk-chain! (dk-cite! 'rr-limit-le-of-tail ps dxy (list '+ r 'e) bnd)
        (lambda (ante)
          (lambda ()
            (let* ((kk (rb3-peel-var!)) (sfk (list 'series-partial-sum f kk)) (swk (list 'series-partial-sum 'w kk)))
              (subst (dk-cite! 'series-partial-sum-seq-apply f kk))
              (rb3-ty! sfk 'RR) (rb3-ty! swk 'RR)
              (dk-chain! (dk-cite! 'series-block-le kk bnd f 'w)
                (lambda (a2)
                  (lambda ()
                    (let* ((i (rb3-peel-var!)) (d (dk-of i)) (m (list 'min 1 d)) (wi (list 'w i)))
                      (dk-cite! 'cmim-term-nonneg 'cs 'w x y i)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (ass)
                            (begin
                              (dk-lam-b!)
                              (rb3-ty! m 'RR) (rb3-w-nonneg! i)
                              (dk-cite! 'rr-min-le-left 1 d)
                              (dk-cite! 'rr-mul-le-right m 1 wi)
                              (subst (rb3-comm! wi m))
                              (rb3-ty! (list '* m wi) 'RR) (rb3-ty! (list '* 1 wi) 'RR)
                              (dk-ineq! (list '<= (list '* m wi) (list '* 1 wi)) (list 'IN (list '* m wi) 'RR) (list 'IN wi 'RR))))))))))
              (rb3-apply! tail kk)
              (dk-ineq! (list '<= (list '- sfk sfb) (list '- swk sw)) (list '<= (list '- swk sw) 'e) (list '<= sfb r)
                        (list 'IN sfk 'RR) (list 'IN sfb 'RR) (list 'IN swk 'RR) (list 'IN sw 'RR) (list 'IN r 'RR)
                        '(IN e RR))))))
      (rb3-close!))))

(sp (make-wff rb3-k2-statement))
(dk-peel!)
(rb3-sw-part! '(IN w (FUN NN RR)))
(rb3-sw-part! '(FORALL n (IMPLIES (IN n NN) (< 0 (w n)))))
(rb3-sw-part! '(SERIES-CONVERGES w))
(rb3-pos-parts! 'e)
(let* ((ex (rb3-apply! (dk-cite! 'series-tail-small 'w) 'e))
       (bnd (dk-skolem! ex 'top))
       (tail (dk-ctx-form (subst-free (cadr ex) bnd (caddr (caddr ex))))))
  (rb3-ew-close! bnd (lambda () (rb3-k2-point! bnd tail))))
(rb3-qed! 'rb3-cm-dist-le)

;;; the countably-metrised space of a gauge: [g, k |-> DIST(fam k)]
(define rb3-lam '(VNB-LAMBDA zk_ NN (DIST (fam zk_))))
(define rb3-cs (list 'LIST 'g rb3-lam))
(sp (make-wff '(FORALL ta_ (FORALL tb_ (AND (== (PTS (LIST ta_ tb_)) ta_) (== (DISTS (LIST ta_ tb_)) tb_))))))
(dk-peel!)
(dk-conj-close! (lambda () (slot (car (cadr (dk-goal)))) (nth-r) (qrfl)))
(rb3-qed! 'rb3-tuple2d)

(define rb3-sephyp (rb3-fa 'pu_ 'g (rb3-fa 'pv_ 'g (list 'IMPLIES (rb3-fa 'k_ 'NN '(= ((DIST (fam k_)) pu_ pv_) 0)) '(= pu_ pv_)))))

;;; Q3.  a separating countable family on a set is a countably-metrised space.
