  (dk-cite! 'power-closed-at k 2)
  (dk-cite! 'rr-recip-pos p2)
  (dk-have! (list 'NOT (list '= p2 0)) (lambda () (di) (dk-absurd! (list '= p2 0) (list '< 0 p2) (list 'IN p2 'RR))))
  (dk-have! (list 'AND (list 'IN p2 'RR) (list 'NOT (list '= p2 0))))
