(rb3-qed! 'rb3-mr-submodule)

;;; a conjunct of IS-K-LINEAR-ON(m, s, f), read off on a lane
(define (rb3-klin-part! claim)
  (dk-have! claim
    (lambda () (mac-h 'is-k-linear-on (dk-ctx-form '(IS-K-LINEAR-ON m s f))) (dk-split-all!) (ass))))
(define rb3-f-add '(FORALL x (IMPLIES (IN x s) (FORALL y (IMPLIES (IN y s)
                     (= (f ((VADD m) x y)) ((ADD (SCAL m)) (f x) (f y))))))))
(define rb3-f-hom '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x s)
                     (= (f ((ACT m) lam x)) ((MUL (SCAL m)) lam (f x))))))))
(define rb3-fr-eq '(FORALL z_ (IMPLIES (IN z_ s) (== (fr z_) (real-part (f z_))))))
;;; f(x) in CC, x in s
(define (rb3-fv! x) (dk-cite! 'fun-apply-type-c 'f 's 'CC x))

;;; C3.  Re o f is a real linear functional on s, as a submodule of mr.
(sp (make-wff (rb3-mrhyp (list 'FORALL 's (list 'IMPLIES '(IS-SUBMODULE m s) (list 'FORALL 'f (list 'IMPLIES '(IS-K-LINEAR-ON m s f)
  (list 'FORALL 'fr (list 'IMPLIES '(IN fr (FUN s RR)) (list 'IMPLIES rb3-fr-eq '(IS-LINEAR-FUNCTIONAL-ON mr s fr)))))))))))
(dk-peel!)
(dk-cite! 'submodule-subset 'm 's)
(rb3-klin-part! '(IN f (FUN s (CARR (SCAL m)))))
(rb3-klin-part! rb3-f-add)
(rb3-klin-part! rb3-f-hom)
(dk-cite! 'rb3-c-carr 'm)
(dk-rewrite-h! (dk-ctx-form '(IN f (FUN s (CARR (SCAL m))))) '(CARR (SCAL m)) 'CC)
(mac 'is-linear-functional-on)
(rb3-mr-subst!)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
      (begin
        (dk-peel!)
        (let* ((g (dk-goal)) (app (cadr (cadr g))))
          (if (equal? (car app) '(VADD m))
              (let* ((x (cadr app)) (y (caddr app)))
                (dk-cite! 'submodule-vadd-closed 'm 's x y)
                (rb3-fv! x) (rb3-fv! y) (rb3-fv! app)
                (subst (rb3-apply! (dk-ctx-form rb3-fr-eq) app))
                (subst (rb3-apply! (dk-ctx-form rb3-fr-eq) x))
                (subst (rb3-apply! (dk-ctx-form rb3-fr-eq) y))
                (subst (rb3-apply! (dk-ctx-form rb3-f-add) x y))
                (subst (dk-cite! 'rb3-c-add-eq 'm (list 'f x) (list 'f y)))
                (dk-cite! 'cc-re-add (list 'f x) (list 'f y))
                (ass))
              (let* ((r (cadr app)) (x (caddr app)))
                (rb3-cc! r)
                (dk-cite! 'rb3-c-in-carr 'm r)
                (dk-cite! 'subset-mem-fwd 's '(VEC m) x)
                (rb3-mr-act! r x)
                (let ((ax (list '(ACT m) r x)))
                  (dk-cite! 'submodule-act-closed 'm 's r x)
                  (rb3-fv! x) (rb3-fv! ax)
                  (subst (rb3-apply! (dk-ctx-form rb3-fr-eq) ax))
                  (subst (rb3-apply! (dk-ctx-form rb3-fr-eq) x))
                  (subst (rb3-apply! (dk-ctx-form rb3-f-hom) r x))
                  (subst (dk-cite! 'rb3-c-mul-eq 'm r (list 'f x)))
                  (dk-cite! 'cc-re-real-mul r (list 'f x))
                  (ass)))))))))
(rb3-qed! 'rb3-mr-re-linear)

;;; =====================================================================
;;; (C) THE COMPLEXIFICATION of a real-linear rfn : VEC(m) -> RR:
;;;     cfn(y) = rfn(y) + (-(rfn(i.y))) * i.
;;; =====================================================================

;;; typing of the terms these proofs build: a vector of m, a real, a complex number
(define (rb3-ctx-fun f)        ; (D . C) when (IN f (FUN D C)) is in context
  (let loop ((as (dk-asms)))
    (cond ((null? as) #f)
          ((let ((a (car as))) (and (pair? a) (eq? (car a) 'IN) (equal? (cadr a) f)
                                    (pair? (caddr a)) (eq? (car (caddr a)) 'FUN)))
           (cons (cadr (caddr (car as))) (caddr (caddr (car as)))))
          (#t (loop (cdr as))))))
(define (rb3-ty! t cls)
  (let ((g (list 'IN t cls)))
    (cond
      ((dk-asm? g) #t)
      ((eqv? t '+i) (if (eq? cls 'CC) (dk-cite! 'cc-i-in) (error "rb3-ty!: i is not real")))
      ((and (eq? cls 'CC) (not (and (pair? t) (memq (car t) '(+ * -))))
            (not (and (pair? t) (pair? (cdr t)) (let ((dc (rb3-ctx-fun (car t)))) (and dc (eq? (cdr dc) 'CC)))))
            (begin (rb3-ty! t 'RR) #t))
       (dk-cite! 'rr-subset-cc t))
      ((number? t) (dk-have! g (lambda () (arith))))
      ((and (pair? t) (memq (car t) '(+ *)))
       (rb3-ty! (cadr t) cls) (rb3-ty! (caddr t) cls)
       (dk-have! (list 'AND (list 'IN (cadr t) cls) (list 'IN (caddr t) cls)))
       (dk-cite! (cdr (assoc (list (car t) cls) '(((+ RR) . rr-add-closed) ((* RR) . rr-mul-closed)
                                                  ((+ CC) . cc-add-closed) ((* CC) . cc-mul-closed))))
                 (cadr t) (caddr t)))
      ((and (pair? t) (eq? (car t) '-) (null? (cddr t)))
       (rb3-ty! (cadr t) cls)
       (dk-cite! (if (eq? cls 'RR) 'rr-neg-closed 'cc-neg-closed) (cadr t)))
      ((and (pair? t) (eq? (car t) 'min))
       (rb3-ty! (cadr t) cls) (rb3-ty! (caddr t) cls)
       (dk-cite! 'rr-min-closed (cadr t) (caddr t)))
      ((and (pair? t) (pair? (car t)) (pair? (caar t)) (equal? (car (caar t)) 'DISTS))
       (dk-cite! 'c-metric-dist-real (cadr (caar t)) (cadr (car t)) (cadr t) (caddr t)))
      ((and (pair? t) (eq? (car t) 'series-partial-sum))
       (dk-cite! 'series-partial-sum-in-rr (caddr t) (cadr t)))
      ((and (pair? t) (equal? (car t) '(VADD m)))
       (rb3-ty! (cadr t) '(VEC m)) (rb3-ty! (caddr t) '(VEC m))
       (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)))
      ((and (pair? t) (equal? (car t) '(ACT m)))
       (rb3-ty! (cadr t) 'CC) (rb3-ty! (caddr t) '(VEC m))
       (dk-cite! 'rb3-c-act-in 'm (cadr t) (caddr t)))
      ((and (pair? t) (pair? (cdr t)) (null? (cddr t)) (rb3-ctx-fun (car t)))
       => (lambda (dc)
            (rb3-ty! (cadr t) (car dc))
            (dk-cite! 'fun-apply-type-c (car t) (car dc) (cdr dc) (cadr t))
            (if (not (dk-asm? g)) (error "rb3-ty!: function typed into another class" t cls))))
      (#t (error "rb3-ty!: cannot type" t cls)))))

(define rb3-rf-add (rb3-fa 'rax_ '(VEC m) (rb3-fa 'ray_ '(VEC m) '(= (rfn ((VADD m) rax_ ray_)) (+ (rfn rax_) (rfn ray_))))))
(define rb3-rf-hom (rb3-fa 'rhr_ 'RR (rb3-fa 'rhx_ '(VEC m) '(= (rfn ((ACT m) rhr_ rhx_)) (* rhr_ (rfn rhx_))))))
(define (rb3-cf-of y) (list '+ (list 'rfn y) (list '* (list '- (list 'rfn (list '(ACT m) '+i y))) '+i)))
(define rb3-cf-val (rb3-fa 'cvy_ '(VEC m) (list '== '(cfn cvy_) (rb3-cf-of 'cvy_))))
(define (rb3-cfhyp body)
  (rb3-cmod (list 'FORALL 'rfn (rb3-imps (list '(IN rfn (FUN (VEC m) RR)) rb3-rf-add rb3-rf-hom)
              (list 'FORALL 'cfn (rb3-imps (list '(IN cfn (FUN (VEC m) CC)) rb3-cf-val) body))))))
;;; crs with every non-arithmetic subterm (and the imaginary unit, which `crs' would
;;; evaluate with `<') abstracted to a variable typed CC; proved universally, instantiated.
(define (rb3-opaques t acc)
  (cond ((and (number? t) (not (eqv? t '+i))) acc)
        ((and (pair? t) (memq (car t) '(+ * -)))
         (let loop ((us (cdr t)) (a acc)) (if (null? us) a (loop (cdr us) (rb3-opaques (car us) a)))))
        ((member t acc) acc)
        (#t (append acc (list t)))))
(define (rb3-replace t from to)
  (cond ((equal? t from) to) ((pair? t) (map (lambda (u) (rb3-replace u from to)) t)) (#t t)))
(define (rb3-crs!)
  (let* ((g (dk-goal))
         (rs (rb3-opaques (caddr g) (rb3-opaques (cadr g) '())))
         (vs (list-head '(rca_ rcb_ rcc_ rcd_ rce_ rcf_ rcg_ rch_ rci_ rcj_ rck_ rcl_) (length rs)))
         (g2 (let walk ((t g))
               (let find ((rs1 rs) (vs1 vs))
                 (cond ((null? rs1) (if (pair? t) (map walk t) t))
                       ((equal? t (car rs1)) (car vs1))
                       (#t (find (cdr rs1) (cdr vs1)))))))
         (univ (let loop ((vs (reverse vs)) (body g2))
                 (if (null? vs) body (loop (cdr vs) (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) body))))))
         (leaf (proof-state-focus *ps*)))
    (for-each (lambda (r) (rb3-ty! r 'CC)) rs)
    (dk-have! univ (lambda () (dk-peel!) (crs)))
    (apply rb3-apply! (dk-ctx-form univ) rs)
    (if (not (sequent-node-grounded? leaf)) (ass))
    (if (not (sequent-node-grounded? leaf)) (error "rb3-crs!: did not close" (expression->string g)))))
(define (rb3-comm! a b)          ; (= (* a b) (* b a)), both typed; returns the equation
  (let ((e (list '= (list '* a b) (list '* b a))))
    (dk-have! e (lambda () (rb3-crs!)))
    e))
;;; cfn(y) rewritten to its value, y a typed vector
(define (rb3-cfv! y) (subst (rb3-apply! (dk-ctx-form rb3-cf-val) y)))

;;; D1.  Re(cfn y) = rfn y.
(sp (make-wff (rb3-cfhyp (rb3-fa 'y '(VEC m) '(= (real-part (cfn y)) (rfn y))))))
(dk-peel!)
(let* ((e (rb3-cf-of 'y)) (a '(rfn y)) (b (list '- (list 'rfn (list '(ACT m) '+i 'y)))))
  (rb3-ty! a 'RR) (rb3-ty! b 'RR) (rb3-ty! e 'CC)
  (rb3-cfv! 'y)
  (dk-have! (list '= e e) (lambda () (rfl)))
  (dk-split-all! (list (dk-cite! 'cc-re-im-of e a b)))
  (ass))
(rb3-qed! 'rb3-cf-re)

;;; D2.  cfn is additive.
(sp (make-wff (rb3-cfhyp (rb3-fa 'x '(VEC m) (rb3-fa 'y '(VEC m) '(= (cfn ((VADD m) x y)) (+ (cfn x) (cfn y))))))))
(dk-peel!)
(let* ((xy '((VADD m) x y)) (ix '((ACT m) +i x)) (iy '((ACT m) +i y)))
  (rb3-ty! (rb3-cf-of xy) 'CC) (rb3-ty! (rb3-cf-of 'x) 'CC) (rb3-ty! (rb3-cf-of 'y) 'CC)
  (rb3-cfv! xy) (rb3-cfv! 'x) (rb3-cfv! 'y)
  (subst (dk-cite! 'rb3-c-act-vadd 'm '+i 'x 'y))
  (subst (rb3-apply! (dk-ctx-form rb3-rf-add) 'x 'y))
  (subst (rb3-apply! (dk-ctx-form rb3-rf-add) ix iy))
  (rb3-crs!))
(rb3-qed! 'rb3-cf-add)

;;; D3.  cfn is real-homogeneous.
(sp (make-wff (rb3-cfhyp (rb3-fa 'r_ 'RR (rb3-fa 'x '(VEC m) '(= (cfn ((ACT m) r_ x)) (* r_ (cfn x))))))))
(dk-peel!)
(let* ((rx '((ACT m) r_ x)) (ix '((ACT m) +i x))
       (e1 (list '= (list '(ACT m) '+i rx) (list '(ACT m) 'r_ ix))))
  (rb3-ty! (rb3-cf-of rx) 'CC) (rb3-ty! (rb3-cf-of 'x) 'CC) (rb3-ty! (list '(ACT m) 'r_ ix) '(VEC m))
  (dk-have! e1
    (lambda ()
      (dk-cite! 'rb3-c-act-mul 'm '+i 'r_ 'x)
      (dk-cite! 'rb3-c-act-mul 'm 'r_ '+i 'x)
      (dk-have! '(= (* +i r_) (* r_ +i)) (lambda () (rb3-crs!)))
      (subst (list '= (list '(ACT m) '+i rx) '((ACT m) (* +i r_) x)))
      (subst '(= (* +i r_) (* r_ +i)))
      (ass)))
  (rb3-cfv! rx) (rb3-cfv! 'x)
  (subst e1)
  (subst (rb3-apply! (dk-ctx-form rb3-rf-hom) 'r_ ix))
  (subst (rb3-apply! (dk-ctx-form rb3-rf-hom) 'r_ 'x))
  (rb3-crs!))
(rb3-qed! 'rb3-cf-rhom)

;;; D4.  cfn(i.x) = i cfn(x).
(sp (make-wff (rb3-cfhyp (rb3-fa 'x '(VEC m) '(= (cfn ((ACT m) +i x)) (* +i (cfn x)))))))
(dk-peel!)
(let* ((ix '((ACT m) +i x)) (iix (list '(ACT m) '+i ix)) (mx '((ACT m) -1 x))
       (e2 (list '= iix mx))
       (rhs (list '* '+i (rb3-cf-of 'x)))
       (h (list '= rhs (list '+ '(* +i (rfn x)) (list '* (list '- (list 'rfn ix)) '(* +i +i))))))
  (rb3-ty! (rb3-cf-of ix) 'CC) (rb3-ty! (rb3-cf-of 'x) 'CC) (rb3-ty! mx '(VEC m)) (rb3-ty! -1 'RR)
  (dk-have! e2
    (lambda ()
      (dk-cite! 'rb3-c-act-mul 'm '+i '+i 'x)
      (dk-cite! 'cc-i-squared)
      (subst (list '= iix '((ACT m) (* +i +i) x)))
      (subst '(= (* +i +i) -1))
      (rfl)))
  (rb3-cfv! ix) (rb3-cfv! 'x)
  (subst e2)
  (subst (rb3-apply! (dk-ctx-form rb3-rf-hom) -1 'x))
  (dk-have! h (lambda () (rb3-crs!)))
  (subst h)
  (dk-cite! 'cc-i-squared)
  (subst '(= (* +i +i) -1))
  (rb3-crs!))
(rb3-qed! 'rb3-cf-ihom)

;;; D5.  cfn((a + i b).x) = (a + i b) cfn(x), a, b real.
(sp (make-wff (rb3-cfhyp (rb3-fa 'a_ 'RR (rb3-fa 'b_ 'RR (rb3-fa 'x '(VEC m)
  '(= (cfn ((ACT m) (+ a_ (* +i b_)) x)) (* (+ a_ (* +i b_)) (cfn x)))))))))
(dk-peel!)
(let* ((ax '((ACT m) a_ x)) (bx '((ACT m) b_ x)) (ibx (list '(ACT m) '+i '((ACT m) b_ x))))
  (rb3-ty! '(* +i b_) 'CC) (rb3-ty! ax '(VEC m)) (rb3-ty! ibx '(VEC m))
  (rb3-ty! '(cfn x) 'CC) (rb3-ty! (list 'cfn bx) 'CC)
  (subst (dk-cite! 'rb3-c-act-add 'm 'a_ '(* +i b_) 'x))
  (subst (dk-cite! 'rb3-c-act-mul 'm '+i 'b_ 'x))
  (subst (dk-cite! 'rb3-cf-add 'm 'rfn 'cfn ax ibx))
  (subst (dk-cite! 'rb3-cf-rhom 'm 'rfn 'cfn 'a_ 'x))
  (subst (dk-cite! 'rb3-cf-ihom 'm 'rfn 'cfn bx))
  (subst (dk-cite! 'rb3-cf-rhom 'm 'rfn 'cfn 'b_ 'x))
  (rb3-crs!))
(rb3-qed! 'rb3-cf-abhom)

;;; D5'.  cfn is complex-homogeneous.
(sp (make-wff (rb3-cfhyp (rb3-fa 'lam 'CC (rb3-fa 'x '(VEC m) '(= (cfn ((ACT m) lam x)) (* lam (cfn x))))))))
(dk-peel!)
(let ((d (dk-cite! 'cc-re-im-decompose 'lam)))
  (dk-cite! 'real-part-in-rr 'lam)
  (dk-cite! 'imag-part-in-rr 'lam)
  (let ((inst (dk-cite! 'rb3-cf-abhom 'm 'rfn 'cfn '(real-part lam) '(imag-part lam) 'x)))
    (dk-rewrite-h! inst (caddr d) 'lam)
    (ass)))
(rb3-qed! 'rb3-cf-chom)

;;; D6.  cfn is K-linear on m.
(sp (make-wff (rb3-cfhyp '(IS-K-LINEAR m cfn))))
(dk-peel!)
(dk-cite! 'rb3-c-carr 'm)
(mac 'is-k-linear)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((eq? (car g) 'IN) (subst '(= (CARR (SCAL m)) CC)) (ass))
        (#t
         (let* ((landed (dk-peel!)) (g (dk-goal)) (app (cadr (cadr g))))
           (if (equal? (car app) '(VADD m))
               (let ((x (cadr app)) (y (caddr app)))
                 (rb3-ty! (list 'cfn x) 'CC) (rb3-ty! (list 'cfn y) 'CC)
                 (subst (dk-cite! 'rb3-c-add-eq 'm (list 'cfn x) (list 'cfn y)))
                 (dk-cite! 'rb3-cf-add 'm 'rfn 'cfn x y)
                 (ass))
               (let ((lam (cadr app)) (x (caddr app)))
                 (dk-rewrite-h! (dk-ctx-form (list 'IN lam '(CARR (SCAL m)))) '(CARR (SCAL m)) 'CC)
                 (rb3-ty! (list 'cfn x) 'CC)
                 (subst (dk-cite! 'rb3-c-mul-eq 'm lam (list 'cfn x)))
                 (dk-cite! 'rb3-cf-chom 'm 'rfn 'cfn lam x)
                 (ass)))))))))
(rb3-qed! 'rb3-cf-klinear)

;;; w = Re z + i Im z  =>  w = z
(sp (make-wff (rb3-fa 'z 'CC '(FORALL w (IMPLIES (= w (+ (real-part z) (* +i (imag-part z)))) (= w z))))))
(dk-peel!)
(dk-cite! 'cc-re-im-decompose 'z)
(subst '(= z (+ (real-part z) (* +i (imag-part z)))))
(ass)
(rb3-qed! 'rb3-eq-decomp)

;;; Re i = 0, Im i = 1
(sp (make-wff '(AND (= (real-part +i) 0) (= (imag-part +i) 1))))
(dk-cite! 'cc-i-in)
(dk-cite! 'rr-zero-in)
(dk-cite! 'rr-one-in)
(dk-have! '(= +i (+ 0 (* 1 +i))) (lambda () (rb3-crs!)))
(dk-cite! 'cc-re-im-of '+i 0 1)
(ass)
(rb3-qed! 'rb3-re-im-i)

;;; D7.  cfn extends f, when Re o f = rfn on s and f(i.x) = i f(x).
(sp (make-wff (rb3-cfhyp (list 'FORALL 's (list 'IMPLIES '(IS-SUBMODULE m s) (list 'FORALL 'f
  (rb3-imps (list '(IN f (FUN s CC))
                  (rb3-fa 'eix_ 's '(= (f ((ACT m) +i eix_)) (* +i (f eix_))))
                  (rb3-fa 'erx_ 's '(= (rfn erx_) (real-part (f erx_)))))
            '(EXTENDS-ON s cfn f))))))))
(dk-peel!)
(dk-cite! 'submodule-subset 'm 's)
(dk-cite! 'cc-i-in)
(dk-cite! 'rb3-c-in-carr 'm '+i)
(dk-split-all! (list (dk-cite! 'rb3-re-im-i)))
(mac 'extends-on)
(let* ((x (dk-di-var!)) (ix (list '(ACT m) '+i x)) (fx (list 'f x))
       (h1 (list '= (list 'cfn x) (list '+ (list 'real-part fx) (list '* '+i (list 'imag-part fx))))))
  (dk-cite! 'subset-mem-fwd 's '(VEC m) x)
  (dk-cite! 'submodule-act-closed 'm 's '+i x)
  (rb3-ty! fx 'CC) (rb3-ty! (list 'f ix) 'CC)
  (dk-cite! 'real-part-in-rr fx) (dk-cite! 'imag-part-in-rr fx)
  (rb3-ty! (rb3-cf-of x) 'CC)
  (dk-have! h1
    (lambda ()
      (rb3-cfv! x)
      (subst (rb3-apply! (dk-ctx-form (rb3-fa 'erx_ 's '(= (rfn erx_) (real-part (f erx_))))) x))
      (subst (rb3-apply! (dk-ctx-form (rb3-fa 'erx_ 's '(= (rfn erx_) (real-part (f erx_))))) ix))
      (subst (rb3-apply! (dk-ctx-form (rb3-fa 'eix_ 's '(= (f ((ACT m) +i eix_)) (* +i (f eix_))))) x))
      (subst (dk-cite! 'cc-re-mul '+i fx))
      (subst '(= (real-part +i) 0))
      (subst '(= (imag-part +i) 1))
      (rb3-crs!)))
  (dk-cite! 'rb3-eq-decomp fx (list 'cfn x))
  (ass))
(rb3-qed! 'rb3-cf-extends)

;;; |z|^2 = z conj(z) and |conj z| = |z|, from cc-magnitude-sqrt-self-conj (analysis), so that
;;; this file need not cite cc-exp.scm (complex-analysis) for them.
(sp (make-wff (rb3-fa 'z 'CC '(= (* (magnitude z) (magnitude z)) (* z (conjugate z))))))
(dk-peel!)
(let ((a '(* z (conjugate z))))
  (dk-split-all! (list (dk-cite! 'cc-self-conj-nonneg 'z)))
  (dk-cite! 'cc-magnitude-sqrt-self-conj 'z)
  (subst (list '= '(magnitude z) (list 'sqrt a)))
  (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
  (dk-cite! 'sqrt-sq a)
  (rb3-close!))
(rb3-qed! 'rb3-mag-sq-conj)

(sp (make-wff (rb3-fa 'z 'CC '(= (magnitude (conjugate z)) (magnitude z)))))
(dk-peel!)
(dk-cite! 'cc-conjugate-closed 'z)
(dk-cite! 'cc-magnitude-sqrt-self-conj 'z)
(dk-cite! 'cc-magnitude-sqrt-self-conj '(conjugate z))
(dk-cite! 'cc-conjugate-involution 'z)
(subst '(= (magnitude (conjugate z)) (sqrt (* (conjugate z) (conjugate (conjugate z))))))
(subst '(= (conjugate (conjugate z)) z))
(subst '(= (magnitude z) (sqrt (* z (conjugate z)))))
(subst (rb3-comm! '(conjugate z) 'z))
(dk-split-all! (list (dk-cite! 'cc-self-conj-nonneg 'z)))
(dk-cite! 'cc-magnitude-closed 'z)
(rfl)
(rb3-qed! 'rb3-mag-conj)

;;; D8.  |cfn y| <= p(y) when rfn <= p.  |z|^2 = z conj(z) = cfn(conj(z).y), real, so
;;;      |z|^2 = rfn(conj(z).y) <= p(conj(z).y) = |z| p(y).
(sp (make-wff (rb3-cfhyp (list 'FORALL 'p (rb3-imps (list '(IS-SEMINORM CC-NORMED-FIELD m p)
                                                          (rb3-fa 'bx_ '(VEC m) '(<= (rfn bx_) (p bx_))))
  (rb3-fa 'y '(VEC m) '(<= ((FNRM CC-NORMED-FIELD) (cfn y)) (p y))))))))
(dk-peel!)
(rb3-semi-part! '(IN p (FUN (VEC m) RR)))
(rb3-semi-part! '(FORALL x (IMPLIES (IN x (VEC m)) (<= 0 (p x)))))
(rb3-semi-part! rb3-semi-hom)
(let* ((z '(cfn y)) (w (list 'conjugate z)) (wy (list '(ACT m) w 'y))
       (mm (list 'magnitude z)) (pp '(p y))
       (m2 (list '* mm mm)) (mp (list '* mm pp)))
  (rb3-ty! z 'CC)
  (dk-cite! 'cc-conjugate-closed z)
  (rb3-ty! wy '(VEC m))
  (dk-cite! 'rb3-c-in-carr 'm w)
  (dk-cite! 'cc-magnitude-closed z)
  (dk-cite! 'cc-magnitude-nonneg z)
  (rb3-ty! pp 'RR) (rb3-ty! (list 'p wy) 'RR) (rb3-ty! (list 'rfn wy) 'RR)
  (rb3-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x (VEC m)) (<= 0 (p x))))) 'y)
  (rb3-ty! m2 'RR) (rb3-ty! mp 'RR)
  ;; rfn(w.y) = |z|^2
  (dk-cite! 'rb3-cf-chom 'm 'rfn 'cfn w 'y)
  (dk-cite! 'rb3-cf-re 'm 'rfn 'cfn wy)
  (dk-cite! 'rb3-mag-sq-conj z)
  (rb3-ty! (list '* w z) 'CC)
  (dk-have! (list '= (list '* w z) (list '* z w)) (lambda () (rb3-crs!)))
  (dk-cite! 'rr-zero-in)
  (dk-have! (list '= m2 (list '+ m2 '(* 0 +i))) (lambda () (rb3-crs!)))
  (rb3-ty! m2 'CC)
  (dk-split-all! (list (dk-cite! 'cc-re-im-of m2 m2 0)))
  (dk-have! (list '= (list 'rfn wy) m2)
    (lambda ()
      (subst (list '= (list 'rfn wy) (list 'real-part (list 'cfn wy))))
      (subst (list '= (list 'cfn wy) (list '* w z)))
      (subst (list '= (list '* w z) (list '* z w)))
      (subst (list '= (list '* z w) m2))
      (ass)))
  ;; p(w.y) = |z| p(y)
  (rb3-apply! (dk-ctx-form rb3-semi-hom) w 'y)
  (dk-cite! 'cc-nf-fnrm-apply w)
  (dk-cite! 'rb3-mag-conj z)
  (dk-have! (list '= (list 'p wy) mp)
    (lambda ()
      (subst (list '= (list 'p wy) (list '* (list '(FNRM CC-NORMED-FIELD) w) pp)))
      (subst (list '= (list '(FNRM CC-NORMED-FIELD) w) (list 'magnitude w)))
      (subst (list '= (list 'magnitude w) mm))
      (rfl)))
  (rb3-apply! (dk-ctx-form (rb3-fa 'bx_ '(VEC m) '(<= (rfn bx_) (p bx_)))) wy)
  (dk-have! (list '<= m2 mp)
    (lambda ()
      (subst (list '= m2 (list 'rfn wy)))
      (subst (list '= mp (list 'p wy)))
      (ass)))
  ;; |z| <= p(y)
  (dk-cite! 'cc-nf-fnrm-apply z)
  (subst (list '= (list '(FNRM CC-NORMED-FIELD) z) mm))
  (let ((cases (dk-cite! 'rr-le-cases 0 mm)))
    (use-cases cases
      (lambda ()
        (dk-have! (list '= mp (list '* pp mm)) (lambda () (rb3-crs!)))
        (dk-have! (list '<= m2 (list '* pp mm)) (lambda () (subst (list '= (list '* pp mm) mp)) (ass)))
        (dk-cite! 'rr-mul-le-cancel-pos mm mm pp)
        (ass))
      (lambda ()
        (dk-ineq! (list '= 0 mm) (list '<= 0 pp) (list 'IN mm 'RR) (list 'IN pp 'RR))))))
(rb3-qed! 'rb3-cf-bound)

(define (rb3-in-vmr! x mr)
  (dk-have! (list 'IN x (list 'VEC mr)) (lambda () (subst (list '= (list 'VEC mr) '(VEC m))) (ass))))
(define rb3-mr-act-eq-at #f)

;;; =====================================================================
;;; (D) hahn-banach-seminorm -- the support's statement, verbatim.
;;; =====================================================================
(define rb3-hbs-statement
  (forall-guarded '(m p s f fld)
    (list
      '(IS-MODULE m)
      '(IS-NORMED-FIELD fld)
      '(OR (= fld RR-NORMED-FIELD) (= fld CC-NORMED-FIELD))
      '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING fld))
      '(IS-SEMINORM fld m p)
      '(IS-SUBMODULE m s)
      '(IS-K-LINEAR-ON m s f)
      '(FORALL x (IMPLIES (IN x s) (<= ((FNRM fld) (f x)) (p x)))))
    (forsome-guarded 'ff '(IS-K-LINEAR m ff)
      (conjuncts->and
        (list
          '(EXTENDS-ON s ff f)
          '(FORALL x (IMPLIES (IN x (VEC m))
             (<= ((FNRM fld) (ff x)) (p x)))))))))

(define rb3-fld-hyps
  '((= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING fld))
    (IS-SEMINORM fld m p)
    (FORALL x (IMPLIES (IN x s) (<= ((FNRM fld) (f x)) (p x))))))
(define (rb3-fix-fld! val)
  (for-each (lambda (h) (dk-rewrite-h! (dk-ctx-form h) 'fld val)) rb3-fld-hyps)
  (subst (list '= 'fld val)))

(sp (make-wff rb3-hbs-statement))
(dk-peel!)
(use-cases (dk-ctx-form '(OR (= fld RR-NORMED-FIELD) (= fld CC-NORMED-FIELD)))
  ;; RR: hahn-banach-sublinear.scm's corollary
  (lambda ()
    (rb3-fix-fld! 'RR-NORMED-FIELD)
    (dk-cite! 'hahn-banach-seminorm-rr 'm 'p 's 'f)
    (ass))
  ;; CC: the real-part reduction
  (lambda ()
    (rb3-fix-fld! 'CC-NORMED-FIELD)
    (dk-cite! 'submodule-subset 'm 's)
    (dk-cite! 'cc-i-in)
    (rb3-mod-part! '(IN (VEC m) SET))
    (dk-cite! 'subclass-of-set-is-set 's '(VEC m))
    (dk-cite! 'rb3-c-carr 'm)
    (rb3-klin-part! '(IN f (FUN s (CARR (SCAL m)))))
    (rb3-klin-part! rb3-f-hom)
    (dk-rewrite-h! (dk-ctx-form '(IN f (FUN s (CARR (SCAL m))))) '(CARR (SCAL m)) 'CC)
    (rb3-semi-part! '(IN p (FUN (VEC m) RR)))
    ;; the realification and Re o f
    (let* ((mr (dk-skolem! (dk-cite! 'rb3-mr-exists 'm)))
           (fr-pair (dk-abstract! 's 'RR (lambda (k) (list 'real-part (list 'f k)))
                                  (lambda (k) (rb3-ty! (list 'f k) 'CC) (dk-cite! 'real-part-in-rr (list 'f k)) (rb3-close!))))
           (fr (car fr-pair)) (fr-eq (cdr fr-pair)))
      (set! rb3-mr-act-eq-at (subst-free 'mr mr rb3-mr-act-eq))
      (dk-cite! 'rb3-mr-sublinear 'm mr 'p)
      (dk-cite! 'rb3-mr-submodule 'm mr 's)
      (dk-cite! 'rb3-mr-re-linear 'm mr 's 'f fr)
      (let ((fr-le (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s) (list '<= (list fr 'z_) '(p z_))))))
        (dk-have! fr-le
          (lambda ()
            (let* ((z (dk-di-var!)) (fz (list 'f z)) (rz (list 'real-part fz)))
              (dk-cite! 'subset-mem-fwd 's '(VEC m) z)
              (rb3-ty! fz 'CC) (rb3-ty! (list 'p z) 'RR)
              (dk-cite! 'real-part-in-rr fz)
              (subst (rb3-apply! fr-eq z))
              (dk-cite! 'rr-le-abs rz)
              (dk-cite! 'cc-abs-re-le-magnitude fz)
              (dk-cite! 'cc-magnitude-closed fz)
              (dk-cite! 'cc-nf-fnrm-apply fz)
              (let ((b (rb3-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x s) (<= ((FNRM CC-NORMED-FIELD) (f x)) (p x))))) z)))
                (dk-rewrite-h! b (list '(FNRM CC-NORMED-FIELD) fz) (list 'magnitude fz)))
              (dk-ineq! (list '<= rz (list 'abs rz)) (list '<= (list 'abs rz) (list 'magnitude fz))
                        (list '<= (list 'magnitude fz) (list 'p z))
                        (list 'IN rz 'RR) (list 'IN (list 'magnitude fz) 'RR) (list 'IN (list 'p z) 'RR)))))
        ;; the real extension
        (let* ((rf (dk-skolem! (dk-cite! 'hbs-hahn-banach-sublinear mr 'p 's fr)))
               (rf-add (subst-free 'rfn rf rb3-rf-add))
               (rf-hom (subst-free 'rfn rf rb3-rf-hom))
               (lf (list 'IS-LINEAR-FUNCTIONAL-ON mr (list 'VEC mr) rf)))
          (dk-have! (list 'IN rf '(FUN (VEC m) RR))
            (lambda () (dk-cite! 'hbs-lf-fun mr (list 'VEC mr) rf) (subst (list '= '(VEC m) (list 'VEC mr))) (ass)))
          (dk-have! rf-add
            (lambda ()
              (dk-peel!)
              (let* ((g (dk-goal)) (app (cadr (cadr g))) (x (cadr app)) (y (caddr app)))
                (rb3-in-vmr! x mr) (rb3-in-vmr! y mr)
                (subst (list '= '(VADD m) (list 'VADD mr)))
                (dk-cite! 'hbs-lf-add mr (list 'VEC mr) rf x y)
                (ass))))
          (dk-have! rf-hom
            (lambda ()
              (dk-peel!)
              (let* ((g (dk-goal)) (app (cadr (cadr g))) (r (cadr app)) (x (caddr app)))
                (rb3-in-vmr! x mr)
                (let ((e (rb3-apply! (dk-ctx-form rb3-mr-act-eq-at) r x)))
                  (subst (list '= (caddr e) (cadr e))))
                (dk-cite! 'hbs-lf-hom mr (list 'VEC mr) rf r x)
                (ass))))
          (dk-have! (rb3-fa 'eix_ 's '(= (f ((ACT m) +i eix_)) (* +i (f eix_))))
            (lambda ()
              (let ((x (dk-di-var!)))
                (dk-cite! 'rb3-c-in-carr 'm '+i)
                (rb3-ty! (list 'f x) 'CC)
                (dk-cite! 'rb3-c-mul-eq 'm '+i (list 'f x))
                (subst (list '= (list '* '+i (list 'f x)) (list '(MUL (SCAL m)) '+i (list 'f x))))
                (rb3-apply! (dk-ctx-form rb3-f-hom) '+i x)
                (ass))))
          (dk-have! (rb3-fa 'erx_ 's (list '= (list rf 'erx_) '(real-part (f erx_))))
            (lambda ()
              (let ((x (dk-di-var!)))
                (dk-project! (list '= (list rf x) (list fr x))
                  (lambda () (mac-h 'extends-on (dk-ctx-form (list 'EXTENDS-ON 's rf fr)))
                             (rb3-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ s) (list '= (list rf 'x_) (list fr 'x_))))) x)))
                (subst (list '= (list rf x) (list fr x)))
                (subst (rb3-apply! fr-eq x))
                (rb3-ty! (list 'f x) 'CC)
                (dk-cite! 'real-part-in-rr (list 'f x))
                (rfl))))
          (dk-have! (rb3-fa 'bx_ '(VEC m) (list '<= (list rf 'bx_) '(p bx_)))
            (lambda ()
              (let ((x (dk-di-var!)))
                (rb3-in-vmr! x mr)
                (rb3-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC mr)) (list '<= (list rf 'x_) '(p x_))))) x)
                (ass))))
          ;; the complexification
          (let* ((cf-pair (dk-abstract! '(VEC m) 'CC (lambda (k) (subst-free 'rfn rf (rb3-cf-of k)))
                                        (lambda (k) (rb3-ty! (subst-free 'rfn rf (rb3-cf-of k)) 'CC) (rb3-close!))))
                 (cf (car cf-pair)))
            (dk-cite! 'rb3-cf-klinear 'm rf cf)
            (dk-cite! 'rb3-cf-extends 'm rf cf 's 'f)
            (dk-cite! 'rb3-cf-bound 'm rf cf 'p)
            (ew cf)
            (dk-conj-close! (lambda () (ass)))))))))
(rb3-qed! 'hahn-banach-seminorm)

;;; =====================================================================
;;; (II) THE GAUGE TOPOLOGY OF A COUNTABLE PSEUDOMETRIC FAMILY.
;;; =====================================================================
(define (rb3-pgt-slot! name acc val)
  (sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list '== (list acc '(PSEUDO-GAUGE-TOP fam g)) val)))))
  (dk-peel!)
  (mac 'PSEUDO-GAUGE-TOP)
  (slot acc)
  (nth-r)
  (qrfl)
  (rb3-qed! name))
(rb3-pgt-slot! 'rb3-pgt-pts 'PTS 'g)
(rb3-pgt-slot! 'rb3-pgt-opens 'OPENS '(SEP u (POWER g) (IS-OPEN-GAUGE fam g u)))

(define rb3-cpf '(IS-COUNTABLE-PSEUDOMETRIC-FAMILY fam g))
;;; the n-th member of the family, read off on a lane: IS-PSEUDOMETRIC-SPACE(fam n), PTS(fam n) == g
(define (rb3-fam-at! n)
  (let ((both (list 'AND (list 'IS-PSEUDOMETRIC-SPACE (list 'fam n)) (list '== (list 'PTS (list 'fam n)) 'g))))
    (dk-have! both
      (lambda ()
        (mac-h 'is-countable-pseudometric-family (dk-ctx-form rb3-cpf))
        (rb3-apply! (dk-ctx-form '(FORALL n_ (IMPLIES (IN n_ NN) (AND (IS-PSEUDOMETRIC-SPACE (fam n_)) (== (PTS (fam n_)) g))))) n)
        (ass)))
    (dk-split-all! (list (dk-ctx-form both)))))
(define (rb3-pms-part! p claim)
  (dk-have! claim
    (lambda () (mac-h 'is-pseudometric-space (dk-ctx-form (list 'IS-PSEUDOMETRIC-SPACE p))) (dk-split-all!) (ass))))

(sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list 'IMPLIES rb3-cpf
  (rb3-fa 'n_ 'NN (rb3-fa 'y 'g (rb3-fa 'x 'g '(IN ((DIST (fam n_)) y x) RR)))))))))
(dk-peel!)
(rb3-fam-at! 'n_)
(rb3-pms-part! '(fam n_) '(IN (DIST (fam n_)) (FUN (CARTESIAN (PTS (fam n_)) (PTS (fam n_))) RR)))
(dk-rewrite-h! (dk-ctx-form '(IN (DIST (fam n_)) (FUN (CARTESIAN (PTS (fam n_)) (PTS (fam n_))) RR))) '(PTS (fam n_)) 'g)
(dk-cite! 'pair-in-cartesian 'g 'g 'y 'x)
(dk-cite! 'fun-apply-type-c '(DIST (fam n_)) '(CARTESIAN g g) 'RR '(LIST y x))
(dk-cite! 'apply-tupling-2 '(DIST (fam n_)) 'y 'x)
(subst '(== ((DIST (fam n_)) y x) ((DIST (fam n_)) (LIST y x))))
(ass)
(rb3-qed! 'rb3-fam-dist-real)

(sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list 'IMPLIES rb3-cpf
  (rb3-fa 'n_ 'NN '(IS-PSEUDOMETRIC (DIST (fam n_)) g)))))))
(dk-peel!)
(rb3-fam-at! 'n_)
(rb3-pms-part! '(fam n_) '(IS-PSEUDOMETRIC (DIST (fam n_)) (PTS (fam n_))))
(subst '(= g (PTS (fam n_))))
(ass)
(rb3-qed! 'rb3-fam-pseudo)

;;; helpers: (IN z B) from (IN A (POWER B)) and (IN z A); the two halves of a binary intersection
(define (rb3-pow-mem! a b z)
  (dk-have! (list 'IN z b)
    (lambda ()
      (mac-h 'power-set-membership (dk-ctx-form (list 'IN a (list 'POWER b))))
      (dk-split-all!)
      (rb3-apply! (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z a) (list 'IN 'z b)))) z)
      (rb3-close!))))
(define (rb3-in-inter! z u v)
  (dk-have! (list 'AND (list 'IN z u) (list 'IN z v))
    (lambda () (mac-h 'intersection-membership (dk-ctx-form (list 'IN z (list 'INTERSECTION u v)))) (ass)))
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN z u) (list 'IN z v))))))
;;; the gauge-open witnesses of U at y (y in U in context): skolemised; returns (k r imp)
(define (rb3-og-at! u y) (rb3-og-at-with! 'fam 'g u y))
(define (rb3-og-at-with! fm gr u y)
  (let* ((iff (dk-cite! 'is-open-gauge fm gr u))
         (fa (caddr (caddr iff)))
         (fa (dk-project! fa 'is-open-gauge (list 'IS-OPEN-GAUGE fm gr u)))
         (ex (rb3-apply! fa y))
         (k (dk-skolem! ex 'top))
         (ex2 (dk-ctx-form (subst-free (cadr ex) k (caddr (caddr ex)))))
         (r (dk-skolem! ex2 'top))
         (imp (dk-ctx-form (subst-free (cadr ex2) r (caddr (caddr ex2))))))
    (if (not imp) (error "rb3-og-at!: the neighbourhood clause did not land"))
    (list k r imp)))

;;; Close a gauge neighbourhood goal for the set W at y from the witnesses (ks rs imps) of
;;; finitely many gauge-open sets: k = the sum of the ks, r = a positive real below every r
;;; (rr-min-pos, folded), and FINISH, run on the goal (IN x W), may use (IN x U_i) for each i.
(define (rb3-sum-nn! ks)
  (if (null? (cdr ks)) (car ks)
      (let* ((a (car ks)) (b (rb3-sum-nn! (cdr ks))) (t (list '+ a b)))
        (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)))
        (dk-cite! 'nn-add-closed a b)
        t)))
(define (rb3-pos-parts! r)
  (dk-cite! 'rr-pos-rr-in-rr r) (dk-cite! 'rr-lt-of-pos-rr r))
(define (rb3-below! rs)      ; a real w with 0 < w and w <= each r; returns w
  (for-each rb3-pos-parts! rs)
  (if (null? (cdr rs)) (car rs)
      (let* ((a (car rs)) (b (rb3-below! (cdr rs)))
             (w (dk-skolem! (dk-cite! 'rr-min-pos a b))))
        (if (not (dk-asm? (list 'IN b 'RR))) (dk-cite! 'rr-pos-rr-in-rr b))
        w)))
(define (rb3-og-finish! y ks rs imps w-set finish)
  (let* ((k (rb3-sum-nn! ks)) (w (rb3-below! rs)))
    (dk-cite! 'rr-pos-rr-of-lt w)
    (ew k)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
          (begin
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                  (let* ((landed (dk-peel!))
                         (x (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'g))) landed))))
                         (h (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL))) landed))))
                    (for-each
                      (lambda (ki ri imp)
                        (let ((ai (cadr (caddr (caddr imp)))))      ; the antecedent at x, before instantiation
                          (let ((ant (subst-free (cadr imp) x ai)))
                            (dk-have! ant
                              (lambda ()
                                (let* ((ld (dk-peel!))
                                       (n (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) ld))))
                                       (d (list (list 'DIST (list 'fam n)) y x)))
                                  (dk-have! (list '<= n k) (lambda () (dk-nn! (list '<= n ki))))
                                  (rb3-apply! h n)
                                  (dk-cite! 'rb3-fam-dist-real 'fam 'g n y x)
                                  (dk-ineq! (list '< d w) (list '<= w ri) (list 'IN d 'RR) (list 'IN w 'RR) (list 'IN ri 'RR)))))
                            (rb3-apply! imp x))))
                      ks rs imps)
                    (finish x)))))))))))

;;; G2.  the gauge-open sets are closed under binary intersection.
(sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list 'IMPLIES rb3-cpf (list 'FORALL 'u (list 'FORALL 'v
  (rb3-imps (list '(IS-OPEN-GAUGE fam g u) '(IS-OPEN-GAUGE fam g v)) '(IS-OPEN-GAUGE fam g (INTERSECTION u v))))))))))
(dk-peel!)
(dk-project! '(SUBSET u g) 'is-open-gauge '(IS-OPEN-GAUGE fam g u))
(mac 'is-open-gauge)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (if (eq? (car g0) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let ((z (dk-di-var!)))
              (rb3-in-inter! z 'u 'v)
              (dk-cite! 'subset-mem-fwd 'u 'g z)
              (rb3-close!)))
          (let* ((y (dk-di-var!)))
            (rb3-in-inter! y 'u 'v)
            (let* ((ku (rb3-og-at! 'u y)) (kv (rb3-og-at! 'v y))
                   (k1 (car ku)) (r1 (cadr ku)) (i1 (caddr ku))
                   (k2 (car kv)) (r2 (cadr kv)) (i2 (caddr kv)))
              (dk-cite! 'subset-mem-fwd 'u 'g y)
              (rb3-og-finish! y (list k1 k2) (list r1 r2) (list i1 i2) '(INTERSECTION u v)
                (lambda (x) (mac 'intersection-membership) (dk-conj-close! (lambda () (ass)))))))))))
(rb3-qed! 'rb3-og-inter)

;;; G3.  ... and under arbitrary unions.
(define rb3-bu '(BIG-UNION u fw u))
(define (rb3-bu-me! z)          ; from (IN z BU): the member w, with (IN w fw) and (IN z w); returns w
  (let* ((ld (dk-landed (lambda () (bu-me (list 'IN z rb3-bu)))))
         (wf (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'fw))) ld))))
    (cadr wf)))
(sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list 'IMPLIES rb3-cpf (list 'FORALL 'fw
  (rb3-imps (list (rb3-fa 'w_ 'fw '(IS-OPEN-GAUGE fam g w_)) (rb3-fa 'w_ 'fw '(SUBSET w_ g)))
            (list 'IS-OPEN-GAUGE 'fam 'g rb3-bu))))))))
(dk-peel!)
(mac 'is-open-gauge)
(dk-conj-close!
  (lambda ()
    (if (eq? (car (dk-goal)) 'SUBSET)
        (begin
          (mac 'subset-def)
          (let* ((z (dk-di-var!)) (w (rb3-bu-me! z)))
            (rb3-apply! (dk-ctx-form (rb3-fa 'w_ 'fw '(SUBSET w_ g))) w)
            (dk-cite! 'subset-mem-fwd w 'g z)
            (rb3-close!)))
        (let* ((y (dk-di-var!)) (w (rb3-bu-me! y)))
          (rb3-apply! (dk-ctx-form (rb3-fa 'w_ 'fw '(IS-OPEN-GAUGE fam g w_))) w)
          (rb3-apply! (dk-ctx-form (rb3-fa 'w_ 'fw '(SUBSET w_ g))) w)
          (dk-cite! 'subset-mem-fwd w 'g y)
          (let ((kw (rb3-og-at! w y)))
            (rb3-og-finish! y (list (car kw)) (list (cadr kw)) (list (caddr kw)) rb3-bu
              (lambda (x)
                (for-each (lambda (l) (dk-focus! l) (rb3-close!)) (dk-opened (lambda () (bu-mi w)))))))))))
(rb3-qed! 'rb3-og-union)

;;; G4.  the empty set and the whole carrier are gauge-open.
(sp (make-wff (list 'FORALL 'fam (list 'FORALL 'g (list 'IMPLIES rb3-cpf '(IS-OPEN-GAUGE fam g EMPTY-SET))))))
(dk-peel!)
(mac 'is-open-gauge)
(dk-conj-close!
  (lambda ()
    (if (eq? (car (dk-goal)) 'SUBSET) (mac 'subset-def))
    (let ((z (dk-di-var!)))
      (dk-cite! 'empty-set-has-no-members z)
      (rb3-prop! (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET))))))
(rb3-qed! 'rb3-og-empty)

