      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
          (let* ((y (dk-di-var!))
                 (eps (dk-skolem! (rb3-apply! fa y)))
                 (e (list '* 1/4 eps)))
            (dk-cite! 'subset-mem-fwd 'u 'g y)
            (rb3-in-pts! y)
            (rb3-pos-parts! eps)
            (rb3-ty! e 'RR)
            (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR))))
            (dk-cite! 'rr-pos-rr-of-lt e)
            (let* ((ex (rb3-apply! (dk-cite! 'rb3-cm-dist-le 'cs 'w) e))
                   (bnd (dk-skolem! ex 'top))
                   (cl (dk-ctx-form (subst-free (cadr ex) bnd (caddr (caddr ex))))))
              (rb3-ew-close! bnd
                (lambda ()
                  (rb3-ew-close! e
                    (lambda ()
                      (let* ((ld (dk-peel!))
                             (x (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) ld))))
                             (hh (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'FORALL))) ld)))
                             (d (list (list 'DIST rb3-mdw) y x)))
                        (rb3-in-pts! x)
                        (dk-have! (rb3-fa 'n_ 'NN (list 'IMPLIES (list '<= 'n_ bnd) (list '< (rb3-dk 'n_ y x) e)))
                          (lambda ()
                            (let ((n (rb3-peel-var!)))
                              (rb3-dists-at! n)
                              (subst (list '= (list '(DISTS cs) n) (list 'DIST (list 'fam n))))
                              (rb3-apply! hh n)
                              (rb3-close!))))
                        (rb3-apply! cl y x e)
                        (dk-cite! 'cmim-dist-in-rr 'cs 'w y x)
                        (rb3-detach-and! (dk-cite! 'ball-mem-from-le rb3-mdw y x d eps)
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (dk-ineq! (list '<= d (list '+ e e)) (list '< 0 eps) (list 'IN d 'RR) (list 'IN eps 'RR)))))
                        (dk-cite! 'subset-mem-fwd (list 'BALL rb3-mdw y eps) 'u x)
                        (rb3-close!)))))))))))))

;;; gauge-open => metric-open
(define (rb3-q7-contra! d r m wn wk w0 dd)
  ;; context: r <= d, w0 <= 1, w0 <= r, 0 <= wn, 0 <= w0, wk <= wn, (wn m) <= dd, dd < (wk w0)
  ;; goal: anything linear; the premises are contradictory
  (let ((mc (dk-cite! 'rr-min-cases 1 d)))
    (use-cases mc
      (lambda () (rb3-q7-contra2! d r m wn wk w0 dd))
      (lambda () (rb3-q7-contra2! d r m wn wk w0 dd)))))
(define (rb3-q7-contra2! d r m wn wk w0 dd)
  (let ((ce (car (filter (lambda (f) (and (pair? f) (eq? (car f) '=) (equal? (cadr f) m))) (dk-asms)))))
    (dk-have! (list '<= w0 m)
      (lambda () (dk-ineq! ce (list '<= w0 1) (list '<= w0 r) (list '<= r d)
                           (list 'IN w0 'RR) (list 'IN r 'RR) (list 'IN d 'RR) (list 'IN m 'RR))))
    (dk-cite! 'rr-mul-le-right w0 m wn)
    (dk-cite! 'rr-mul-le-right wk wn w0)
    (rb3-comm! wn w0) (rb3-comm! m wn)
    (for-each (lambda (t) (rb3-ty! t 'RR))
              (list (list '* w0 wn) (list '* m wn) (list '* wk w0) (list '* wn w0) (list '* wn m)))
    (dk-absurd! (list '<= (list '* w0 wn) (list '* m wn)) (list '<= (list '* wk w0) (list '* wn w0))
                (list '= (list '* wn w0) (list '* w0 wn)) (list '= (list '* m wn) (list '* wn m))
                (list '<= (list '* wn m) dd) (list '< dd (list '* wk w0))
                (list 'IN (list '* w0 wn) 'RR) (list 'IN (list '* m wn) 'RR) (list 'IN (list '* wk w0) 'RR)
                (list 'IN (list '* wn w0) 'RR) (list 'IN (list '* wn m) 'RR) (list 'IN dd 'RR))))
(define (rb3-q7-bwd!)
  (mac 'is-open)
  (dk-conj-close!
    (lambda ()
      (let ((g0 (dk-goal)))
        (cond
          ((dk-asm? g0) (ass))
          ((eq? (car g0) 'SUBSET) (subst (list '= (list 'PTS rb3-mdw) 'g)) (rb3-close!))
          (#t
           (let* ((y (dk-di-var!))
                  (kw (rb3-og-at-with! 'fam 'g 'u y))
                  (k (car kw)) (r (cadr kw)) (imp (caddr kw))
                  (wk (list 'w k)))
             (dk-cite! 'subset-mem-fwd 'u 'g y)
             (rb3-in-pts! y)
             (rb3-pos-parts! r)
             (dk-cite! 'rr-one-in)
             (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
             (let* ((w0 (dk-skolem! (dk-cite! 'rr-min-pos 1 r)))
                    (eps (list '* wk w0)))
               (rb3-ty! wk 'RR)
               (rb3-apply! (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (< 0 (w n))))) k)
               (dk-cite! 'rr-mul-pos wk w0)
               (rb3-ty! eps 'RR)
               (dk-cite! 'rr-pos-rr-of-lt eps)
               (rb3-ew-close! eps
                 (lambda ()
                   (mac 'subset-def)
                   (let* ((z (dk-di-var!)) (dd (list (list 'DIST rb3-mdw) y z))
                          (bm (dk-cite! 'ball-membership rb3-mdw y eps z))
                          (parts (list 'AND (list 'IN z (list 'PTS rb3-mdw)) (list 'AND (list '<= dd eps) (list 'NOT (list '= dd eps))))))
                     (dk-have! parts (lambda () (rb3-prop! bm (list 'IN z (list 'BALL rb3-mdw y eps)))))
                     (dk-split-all! (list (dk-ctx-form parts)))
                     (dk-have! (list 'IN z 'g) (lambda () (subst (list '= 'g (list 'PTS rb3-mdw))) (rb3-close!)))
                     (rb3-in-pts! z)
                     (dk-cite! 'cmim-dist-in-rr 'cs 'w y z)
                     (dk-have! (list 'AND (list '<= dd eps) (list 'NOT (list '= dd eps))))
                     (dk-cite! 'rr-le-ne-lt dd eps)
                     (let ((ant (subst-free (cadr imp) z (cadr (caddr (caddr imp))))))
                       (dk-have! ant
                         (lambda ()
                           (let* ((n (rb3-peel-var!)) (d (rb3-dk n y z)) (wn (list 'w n)) (m (list 'min 1 d)))
                             (rb3-dists-at! n)
                             (subst (list '= (list 'DIST (list 'fam n)) (list '(DISTS cs) n)))
                             (rb3-ty! d 'RR) (rb3-ty! m 'RR) (rb3-w-nonneg! n)
                             (dk-have! (list '<= 0 w0) (lambda () (dk-ineq! (list '< 0 w0) (list 'IN w0 'RR))))
                             (dk-cite! 'rb3-cm-term-le 'cs 'w y z n)
                             (rb3-apply! (dk-ctx-form rb3-w-anti) n k)
                             (use-cases (dk-cite! 'rr-lt-trichotomy d r)
                               (lambda () (rb3-close!))
                               (lambda ()
                                 (dk-have! (list '<= r d) (lambda () (dk-ineq! (list '= d r) (list 'IN d 'RR) (list 'IN r 'RR))))
                                 (rb3-q7-contra! d r m wn wk w0 dd))
                               (lambda ()
                                 (dk-have! (list '<= r d) (lambda () (dk-ineq! (list '< r d) (list 'IN d 'RR) (list 'IN r 'RR))))
                                 (rb3-q7-contra! d r m wn wk w0 dd)))))))
                     (rb3-apply! imp z)
                     (rb3-close!))))))))))))

(sp (make-wff (list 'FORALL 'cs (list 'IMPLIES '(IS-C-METRIC-SPACE cs) (list 'FORALL 'w (rb3-imps (list '(SUMMABLE-WEIGHT w) rb3-w-le1 rb3-w-anti)
