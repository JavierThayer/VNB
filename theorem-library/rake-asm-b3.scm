;;; the dyadic weight satisfies the two extra hypotheses of K2 / Q7
(define rb3-dy '(VNB-LAMBDA n NN (/ 1 (power 2 (+ n 1)))))
(sp (make-wff (subst-free 'w rb3-dy rb3-w-le1)))
(let* ((k (rb3-peel-var!)) (p2 (list 'power 2 k)))
