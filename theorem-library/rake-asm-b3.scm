(mac 'is-metrizable-top-space-def)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
      (rb3-ew-close! rb3-mdc
        (lambda ()
          (subst (list '= (list 'PTS rb3-mdc) 'g))
          (subst (list '= rb3-sepc rb3-sepg))
          (subst (list '= 's rb3-pgt))
          (mac 'PSEUDO-GAUGE-TOP)
          (qrfl))))))
(rb3-qed! 'rb3-mgc-bwd)

;;; =====================================================================
;;; (VIII) the two supports, verbatim.
;;; =====================================================================
(sp (make-wff
  (forall-guarded '(s) '((IS-TOP-SPACE s))
    (list 'IFF
      '(IS-METRIZABLE-TOP-SPACE s)
      (conjuncts->and (list '(IS-HAUSDORFF s) '(IS-GAUGE-COUNTABLE s)))))))
(dk-peel!)
(dk-iff! (lambda (g0) (eq? (car g0) 'AND))
  (lambda () (dk-cite! 'rb3-mgc-fwd 's) (rb3-close!))
  (lambda ()
    (dk-split-all!)
    (let* ((cl (dk-project! (caddr (caddr (dk-cite! 'is-gauge-countable 's))) 'is-gauge-countable '(IS-GAUGE-COUNTABLE s)))
           (fam (dk-skolem! cl)))
      (dk-cite! 'rb3-mgc-bwd 's fam '(PTS s))
      (rb3-close!))))
(rb3-qed! 'metrizable-iff-gauge-countable)

(sp (make-wff
  (forall-guarded '(s) '((IS-TOP-SPACE s))
    (list 'IFF
      (list 'FORSOME 'md
        (conjuncts->and (list '(IS-BOUNDED-METRIC-SPACE md) '(== (METRIC-TOP md) s))))
      (conjuncts->and (list '(IS-HAUSDORFF s) '(IS-GAUGE-COUNTABLE s)))))))
(dk-peel!)
(let ((t1 (dk-cite! 'metrizable-iff-bounded-metrizable 's))
      (t2 (dk-cite! 'metrizable-iff-gauge-countable 's)))
  (rb3-prop! t1 t2))
(rb3-qed! 'bounded-metrizable-iff-gauge-countable)
