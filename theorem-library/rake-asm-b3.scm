;;; metric-open => gauge-open
(define (rb3-q7-fwd!)
  (let* ((iff (dk-cite! 'is-open rb3-mdw 'u))
         (fa (dk-project! (caddr (caddr (caddr iff))) 'is-open (list 'IS-OPEN rb3-mdw 'u))))
    (mac 'is-open-gauge)
