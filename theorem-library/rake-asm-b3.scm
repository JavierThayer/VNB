(rfl)
(rb3-qed! 'rb3-c-one-eq)

(sp (make-wff (rb3-cmod (rb3-fa 'r_ 'CC (rb3-fa 'x_ '(VEC m) '(IN ((ACT m) r_ x_) (VEC m)))))))
