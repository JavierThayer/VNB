(define rb3-C '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define rb3-R '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define rb3-cpin '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
(define (rb3-cmod body) (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES rb3-cpin body))))
(define (rb3-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))

(define (rb3-qed! name)
  (if (not (proof-done? *ps*))
      (error "rake-asm-b3: proof did not close" name (expression->string (dk-goal))))
  (qed name)
  (topic! name 'analysis))

(define (rb3-prop! . keepers) (if (apply dk-only! keepers) (prop)))
(define (rb3-close!) (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-asm? (dk-goal))) (ass)))

;;; =====================================================================
;;; (A) THE COMPLEX RING VIEW, slot by slot (normed-field-ring-view.scm's five steps)
;;; =====================================================================
(define (rb3-view-slot! name acc val)
  (sp (make-wff (list '== (list acc rb3-C) val)))
  (slot acc)
  (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
  (nth-r)
  (slot acc)
  (qrfl)
  (rb3-qed! name))

(rb3-view-slot! 'rb3-cc-ring-carr 'CARR 'CC)
(rb3-view-slot! 'rb3-cc-ring-add 'ADD '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
(rb3-view-slot! 'rb3-cc-ring-mul 'MUL '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))
(rb3-view-slot! 'rb3-cc-ring-one 'ONE 1)
(rb3-view-slot! 'rb3-cc-ring-zero 'ZERO 0)

;;; ---- a CC-module: the scalar slots read as complex numbers ----
(sp (make-wff (rb3-cmod '(= (CARR (SCAL m)) CC))))
(dk-peel!)
(subst rb3-cpin)
(mac 'rb3-cc-ring-carr)
(rfl)
(rb3-qed! 'rb3-c-carr)

(sp (make-wff (rb3-cmod (rb3-fa 'r_ 'CC '(IN r_ (CARR (SCAL m)))))))
