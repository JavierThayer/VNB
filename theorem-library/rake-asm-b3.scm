;;; =====================================================================
;;; (B) THE REALIFICATION mr of a CC-module m: the same vectors, the action restricted
;;;     to RR x VEC(m), the scalars RR's ring view.  A real module.
;;; =====================================================================
(define rb3-lact '(VNB-LAMBDA (LIST r_ x_) (CARTESIAN RR (VEC m)) ((ACT m) r_ x_)))
(define (rb3-tup a2 a3 a4 a5 a6) (list 'LIST rb3-R a2 a3 a4 a5 a6))
(define rb3-L (rb3-tup '(VEC m) '(VADD m) '(VZERO m) '(VNEG m) rb3-lact))

;;; the slots of a six-tuple whose scalar slot is RR's ring view
(define rb3-tv (rb3-tup 'ta2_ 'ta3_ 'ta4_ 'ta5_ 'ta6_))
(sp (make-wff (list 'FORALL 'ta2_ (list 'FORALL 'ta3_ (list 'FORALL 'ta4_ (list 'FORALL 'ta5_ (list 'FORALL 'ta6_
  (list 'AND (list '== (list 'SCAL rb3-tv) rb3-R)
  (list 'AND (list '== (list 'VEC rb3-tv) 'ta2_)
  (list 'AND (list '== (list 'VADD rb3-tv) 'ta3_)
  (list 'AND (list '== (list 'VZERO rb3-tv) 'ta4_)
  (list 'AND (list '== (list 'VNEG rb3-tv) 'ta5_)
  (list 'AND (list '== (list 'ACT rb3-tv) 'ta6_)
             (list '= (list 'LENGTH rb3-tv) 6))))))))))))))
(dk-peel!)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (eq? (car g) '==)
          (begin (slot (car (cadr g))) (nth-r) (qrfl))
          (begin (len-r) (arith))))))
(rb3-qed! 'rb3-tuple6)

(define rb3-mr-eqs
  (list (list '= '(SCAL mr) rb3-R)
        '(= (VEC mr) (VEC m))
        '(= (VADD mr) (VADD m))
        '(= (VZERO mr) (VZERO m))
        '(= (VNEG mr) (VNEG m))
        (rb3-fa 'r_ 'RR (rb3-fa 'x_ '(VEC m) '(= ((ACT mr) r_ x_) ((ACT m) r_ x_))))))
(define (rb3-conj l) (if (null? (cdr l)) (car l) (list 'AND (car l) (rb3-conj (cdr l)))))

;;; a conjunct of IS-MODULE(m), read off on a lane (the hypothesis survives)
(define (rb3-mod-part! claim)
  (dk-have! claim
    (lambda () (mac-h 'is-module (dk-ctx-form '(IS-MODULE m))) (dk-split-all!) (ass))))

;;; a goal (IN t RR) / (IN t CC) / (IN t (VEC m)) closed from context or by a closure law
(define (rb3-type! g)
  (cond ((dk-asm? g) #t)
        (#t (dk-have! g))))

(sp (make-wff (rb3-cmod (list 'FORSOME 'mr (rb3-conj (cons '(IS-MODULE mr) rb3-mr-eqs))))))
(dk-peel!)
(dk-cite! 'rr-is-set)
(dk-cite! 'rr-one-in)
(dk-cite! 'rb3-c-one-eq 'm)
(dk-split-all! (list (dk-cite! 'rb3-tuple6 '(VEC m) '(VADD m) '(VZERO m) '(VNEG m) rb3-lact)))
(define rb3-vs (dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m)))
(ew rb3-L)
(define (rb3-slot-subst!)
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc rb3-L)) (subst (list '= (list acc rb3-L) val))))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list rb3-R '(VEC m) '(VADD m) '(VZERO m) '(VNEG m) rb3-lact)))
(define (rb3-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-cite! 'rr-subset-cc t)))
(define (rb3-rr2! thm a b)
  (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
  (dk-cite! thm a b))
(define (rb3-act-law!)
  (if (dk-contains? (dk-goal) (list 'CARR rb3-R)) (mac 'rr-scalar-ring-carr))
  (let ((g (dk-goal)))
    (cond
      ((eq? (car g) 'IN)
       (for-each
         (lambda (k)
           (dk-focus! k)
           (let ((h (dk-goal)))
                          (if (eq? (car h) 'FORALL)
                 (begin
                   (dk-peel!)
                                      (let* ((app (cadr (dk-goal))) (r (cadr app)) (x (caddr app)))
                     (rb3-cc! r)
                     (dk-cite! 'rb3-c-act-in 'm r x)
                     (ass)))
                 (begin
                   (dk-have! '(AND (IN RR SET) (IN (VEC m) SET)))
                   (mac 'cartesian-set-iff)
                   (ass)))))
         (dk-opened (lambda () (lam-t)))))
      (#t
       (for-each (lambda (acc thm) (if (dk-contains? (dk-goal) (list acc rb3-R)) (mac thm)))
                 '(ADD MUL ONE) '(rr-scalar-ring-add rr-scalar-ring-mul rr-scalar-ring-one))
       (dk-peel!)
              (let ((rs (filter (lambda (v) (dk-asm? (list 'IN v 'RR))) '(r_ s_)))
             (xs (filter (lambda (v) (dk-asm? (list 'IN v '(VEC m)))) '(x_ y_))))
         (for-each rb3-cc! rs)
         (if (= (length rs) 2)
             (begin (rb3-rr2! 'rr-add-closed 'r_ 's_) (rb3-rr2! 'rr-mul-closed 'r_ 's_)
                    (rb3-cc! '(+ r_ s_)) (rb3-cc! '(* r_ s_))))
         (if (= (length xs) 2) (dk-cite! 'module-vadd-type 'm 'x_ 'y_))
         (for-each (lambda (r) (for-each (lambda (x) (dk-cite! 'rb3-c-act-in 'm r x)) xs)) rs))
       (if (not (dk-lam-b!))
       (let* ((g (dk-goal)) (lhs (cadr g)) (sc (cadr lhs)) (v (caddr lhs)))
         (cond
           ((equal? lhs (caddr g)) (rfl))
           ((and (pair? v) (equal? (car v) '(VADD m))) (dk-cite! 'rb3-c-act-vadd 'm sc (cadr v) (caddr v)))
           ((and (pair? sc) (eq? (car sc) '+)) (dk-cite! 'rb3-c-act-add 'm (cadr sc) (caddr sc) v))
           ((and (pair? sc) (eq? (car sc) '*)) (dk-cite! 'rb3-c-act-mul 'm (cadr sc) (caddr sc) v))
           ((eqv? sc 1) (dk-cite! 'module-act-unital 'm v) (subst '(= 1 (ONE (SCAL m)))))
           (#t (error "rb3: unknown act law" g)))
         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))

(dk-conj-close!
  (lambda ()
    (rb3-slot-subst!)
    (let ((g (dk-goal)))
            (cond
        ((dk-asm? g) (ass))
        ((eq? (car g) 'IS-MODULE)
         (mac 'is-module)
         (dk-conj-close!
           (lambda ()
             (rb3-slot-subst!)
             (let ((h (dk-goal)))
                              (cond
                 ((dk-asm? h) (ass))
                 ((eq? (car h) 'IS-RING)
                  (dk-cite! 'rr-is-normed-field)
                  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
                  (dk-cite! 'commutative-ring-is-ring rb3-R)
                  (ass))
                 ((and (eq? (car h) 'IN) (equal? (cadr h) rb3-lact))
                  (rb3-act-law!))
                 ((dk-contains? h rb3-lact) (rb3-act-law!))
                 (#t (rb3-mod-part! h))))))) 
        ((equal? g (list '= rb3-R rb3-R))
         (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
         (quietly (lambda () (surface-goal! 'RR-NORMED-FIELD)))
         (rfl))
        ((eq? (car g) '=) (rfl))
        (#t (rb3-act-law!))))))
(rb3-qed! 'rb3-mr-exists)

;;; ---- the realification, abstractly: mr with the six facts rb3-mr-exists gives ----
(define (rb3-imps hyps body) (if (null? hyps) body (list 'IMPLIES (car hyps) (rb3-imps (cdr hyps) body))))
(define (rb3-mrhyp body)
  (rb3-cmod (list 'FORALL 'mr (list 'IMPLIES '(IS-MODULE mr) (rb3-imps rb3-mr-eqs body)))))
(define rb3-mr-act-eq (car (last-pair rb3-mr-eqs)))

;;; dk-apply! that tolerates an instance already in context (then returns it)
(define (rb3-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms) (best (cons (->raw-formula f) terms)))
    (let ((best (let ((h (dk-ctx-form g))) (if h (cons h ts) best))))
      (cond ((and (pair? g) (eq? (car g) 'FORALL) (pair? ts))
             (loop (subst-free (cadr g) (car ts) (caddr g)) (cdr ts) best))
            ((and (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g)))
             (loop (caddr g) ts best))
            ((and (null? ts) (dk-ctx-form g)) => (lambda (h) h))
            ((and (null? (cdr best)) (pair? (car best)) (eq? (caar best) 'IMPLIES))
             (dk-apply! (car best)))
            (#t (apply dk-apply! (car best) (cdr best)))))))

;;; rewrite mr's slots to m's in the goal
(define (rb3-mr-subst!)
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc 'mr)) (subst (list '= (list acc 'mr) val))))
            '(SCAL VEC VADD VZERO VNEG)
            (list rb3-R '(VEC m) '(VADD m) '(VZERO m) '(VNEG m))))
;;; ((ACT mr) r x) -> ((ACT m) r x), r real, x a vector, both typed
(define (rb3-mr-act! r x)
  (subst (rb3-apply! (dk-ctx-form rb3-mr-act-eq) r x)))

;;; a conjunct of IS-SEMINORM(CC-NORMED-FIELD, m, p), read off on a lane
(define (rb3-semi-part! claim)
  (dk-have! claim
    (lambda () (mac-h 'is-seminorm (dk-ctx-form '(IS-SEMINORM CC-NORMED-FIELD m p))) (dk-split-all!) (ass))))
(define rb3-semi-hom
  '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x (VEC m))
     (= (p ((ACT m) lam x)) (* ((FNRM CC-NORMED-FIELD) lam) (p x))))))))

;;; C1.  p is sublinear on mr.
(sp (make-wff (rb3-mrhyp '(FORALL p (IMPLIES (IS-SEMINORM CC-NORMED-FIELD m p) (IS-SUBLINEAR mr p))))))
(dk-peel!)
(rb3-semi-part! '(IN p (FUN (VEC m) RR)))
(rb3-semi-part! '(FORALL x (IMPLIES (IN x (VEC m)) (FORALL y (IMPLIES (IN y (VEC m))
                   (<= (p ((VADD m) x y)) (+ (p x) (p y))))))))
(rb3-semi-part! rb3-semi-hom)
(mac 'is-sublinear)
(rb3-mr-subst!)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
      (begin
        (dk-peel!)
        (let* ((g (dk-goal)) (app (cadr (cadr g))) (t (cadr app)) (x (caddr app)))
          (rb3-mr-act! t x)
          (rb3-cc! t)
          (dk-cite! 'rb3-c-in-carr 'm t)
          (rb3-apply! (dk-ctx-form rb3-semi-hom) t x)
          (dk-cite! 'cc-nf-fnrm-apply t)
          (dk-cite! 'rr-magnitude-is-abs t)
          (dk-cite! 'rr-abs-of-nonneg t)
          (subst (list '= (list 'p (list '(ACT m) t x)) (list '* (list '(FNRM CC-NORMED-FIELD) t) (list 'p x))))
          (subst (list '= (list '(FNRM CC-NORMED-FIELD) t) (list 'magnitude t)))
          (subst (list '= (list 'magnitude t) (list 'abs t)))
          (subst (list '= (list 'abs t) t))
          (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR x)
          (rfl))))))
(rb3-qed! 'rb3-mr-sublinear)

;;; C2.  a submodule of m is a submodule of mr.
(sp (make-wff (rb3-mrhyp '(FORALL s (IMPLIES (IS-SUBMODULE m s) (IS-SUBMODULE mr s))))))
(dk-peel!)
(dk-cite! 'submodule-subset 'm 's)
(dk-cite! 'submodule-vzero-in 'm 's)
(dk-cite! 'submodule-vadd-closed 'm 's)
(dk-cite! 'submodule-vneg-closed 'm 's)
(mac 'is-submodule)
(rb3-mr-subst!)
(dk-conj-close!
