(dk-cite! 'rb3-c-in-carr 'm 'r_)
(dk-cite! 'rb3-c-in-carr 'm 's_)
(dk-cite! 'rb3-c-add-eq 'm 'r_ 's_)
(dk-cite! 'module-act-distrib-scalar 'm 'r_ 's_ 'x_)
