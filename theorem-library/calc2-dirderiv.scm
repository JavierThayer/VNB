;;; calc2-dirderiv.scm -- the local directional derivative HAS-DIR-DERIV over a normed vector
;;; space: moving the base point along the direction.  CALC-2, 2026-10-19.  Prefix c2d-.

(define (c2d-open) (dk-open-leaves))
(define (c2d-dump tag)
  (display ";; C2D ") (display tag) (display " goal: ") (display (dk-goal)) (newline)
  (for-each (lambda (a) (display ";; C2D   asm: ") (display a) (newline)) (dk-asms))
  (for-each (lambda (l) (display ";; C2D   open: ") (display (dk-goal-of l)) (newline)) (c2d-open)))
(define (c2d-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))

;;; (1) HAS-DIR-DERIV at b + t.e in the direction e is the derivative of the curve of b at t.
(define c2d-q '((VADD sm_) sb_ ((ACT sm_) st_ se_)))
(define c2d-Gb '(SEG-CURVE sm_ sf_ sb_ se_))
(define c2d-Gq (list 'SEG-CURVE 'sm_ 'sf_ c2d-q 'se_))
(sp (make-wff (forall-guarded '(sm_ sf_ sb_ se_ st_ sl_)
  (list '(IS-NORMED-VECTOR-SPACE sm_) '(IN sb_ (VEC sm_)) '(IN se_ (VEC sm_)) '(IN st_ RR)
        (list 'HAS-DIR-DERIV 'sm_ 'sf_ c2d-q 'se_ 'sl_))
  (list 'HAS-DERIV-AT c2d-Gb 'st_ 'sl_))))
(dk-peel!)
(dk-cite! 'nvs-act-in-vec 'sm_ 'st_ 'se_)
(dk-cite! 'nvs-vadd-in-vec 'sm_ 'sb_ '((ACT sm_) st_ se_))
(define c2d-hd (dk-pick (lambda (f) (dk-head-is? f 'HAS-DIR-DERIV)) "hd"))
(define c2d-hq (dk-project! (list 'HAS-DERIV-AT c2d-Gq 0 'sl_) (lambda () (mac-h 'HAS-DIR-DERIV c2d-hd))))
(dk-cite! 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'rr-pos-rr-of-lt 1)
(define c2d-w (dk-skolem! (dk-apply! (dk-cite! 'has-deriv-at-shrink c2d-Gq 0 'sl_) 1) #t))
(define c2d-isd (dk-pick (lambda (f) (dk-head-is? f 'IS-DIFF-ON)) "is-diff-on"))
(define c2d-O0 (list 'OOINT (list '- 0 c2d-w) (list '+ 0 c2d-w)))
(define c2d-Ot (list 'OOINT (list '- 'st_ c2d-w) (list '+ 'st_ c2d-w)))
(define c2d-rq (list 'RESTRICT c2d-Gq c2d-O0))
(dk-cite! 'rr-pos-rr-in-rr c2d-w)
(dk-cite! 'rr-lt-of-pos-rr c2d-w)
(define c2d-rqf0 (dk-project! (list 'IN c2d-rq (list 'FUN c2d-O0 '(CARR RR-NORMED-FIELD)))
                              (lambda () (mac-h 'IS-DIFF-ON c2d-isd))))
(fact 'rr-nf-carr)
(define c2d-rqf (dk-rewrite-h! c2d-rqf0 '(CARR RR-NORMED-FIELD) 'RR))
(define (c2d-s y) (list '+ '(- st_) (list '* 1 y)))
;;; the two curves agree: Gb(y) == Gq(-t + 1.y)
(define c2d-agree
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c2d-Ot)
              (list '== (list c2d-Gb 'hbx_) (list c2d-Gq (c2d-s 'hbx_)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (sv (c2d-s y)))
        (dk-cite! 'ooint-elt-in-rr (list '- 'st_ c2d-w) (list '+ 'st_ c2d-w) y)
        (dk-type! sv)
        (subst (dk-cite! 'seg-curve-apply 'sm_ 'sf_ 'sb_ 'se_ y))
        (subst (dk-cite! 'seg-curve-apply 'sm_ 'sf_ c2d-q 'se_ sv))
        (subst (dk-cite! 'nvs-act-collect 'sm_ 'st_ sv 'se_ 'sb_))
        (dk-have! (list '= (list '+ 'st_ sv) y) (lambda () (crs)))
        (subst (list '= (list '+ 'st_ sv) y))
        (qrfl)))))
(define c2d-agree-f (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '==) (dk-contains? f c2d-Ot))) "agree"))
;;; the curve of b is defined on (t - w, t + w)
(fact 'rr-is-set)
(dk-cite! 'ooint-subset-rr (list '- 'st_ c2d-w) (list '+ 'st_ c2d-w))
(dk-type! (list '- 'st_ c2d-w)) (dk-type! (list '+ 'st_ c2d-w))
(dk-cite! 'subclass-of-set-is-set c2d-Ot 'RR)
(dk-have! (list 'IN (list 'RESTRICT c2d-Gb c2d-Ot) (list 'FUN c2d-Ot 'RR))
  (lambda ()
    (mac 'RESTRICT)
    (dk-lam-type!
      (lambda ()
        (let* ((y (dk-di-var!)) (sv (c2d-s y)))
          (dk-cite! 'ooint-elt-in-rr (list '- 'st_ c2d-w) (list '+ 'st_ c2d-w) y)
          (dk-type! sv)
          (dk-apply! c2d-agree-f y)
          (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ooint-membership (list '- 'st_ c2d-w) (list '+ 'st_ c2d-w) y))))
          (dk-have! (list 'IN sv c2d-O0)
            (lambda () (mac 'ooint-membership)
              (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                             (dk-ineq! (list '< (list '- 'st_ c2d-w) y) (list '< y (list '+ 'st_ c2d-w))))))))
          (c2d-and! c2d-rqf (list 'IN sv c2d-O0))
          (dk-cite! 'fun-apply-type c2d-rq c2d-O0 'RR sv)
          (dk-cite! 'restrict-apply c2d-Gq c2d-O0 sv)
          (subst (list '= (list c2d-Gb y) (list c2d-Gq sv)))
          (subst (list '= (list c2d-Gq sv) (list c2d-rq sv)))
          (ass)))
      (lambda () (ass)))))
;;; the chain rule through the affine map y |-> -t + 1.y
(dk-cite! 'rr-neg-closed 'st_)
(dk-have! (list '= 0 '(+ (- st_) (* 1 st_))) (lambda () (crs)))
(dk-rewrite-h! c2d-hq 0 '(+ (- st_) (* 1 st_)))
(define c2d-ch (dk-cite! 'has-deriv-at-affine-chain c2d-w c2d-Gq c2d-Gb '(- st_) 1 'st_ 'sl_))
(dk-cite! 'has-deriv-at-in-rr c2d-Gq 0 'sl_)
(dk-have! '(= (* sl_ 1) sl_) (lambda () (crs)))
(dk-rewrite-h! c2d-ch '(* sl_ 1) 'sl_)
(ass)
(qed 'has-dir-deriv-shift)

;;; (2) THE STEP ALONG ONE DIRECTION: if along the segment b + t.e, |t| <= |lam|, the
;;; directional derivative in the direction e exists and stays within dc_ of dll_, then
;;; f(b + lam.e) - f(b) is lam.dll_ up to dc_ |lam|.  (The mean value theorem, Prop. 2.24,
;;; in the form the proof of Prop. 2.29 uses it.)
(define c2d-g '(SEG-CURVE dm_ df_ db_ de_))
(define (c2d-pt t) (list '(VADD dm_) 'db_ (list '(ACT dm_) t 'de_)))
(define c2d-K #f)
(sp (make-wff (forall-guarded '(dm_ df_ db_ de_ dlam_ dll_ dc_)
  (list '(IS-NORMED-VECTOR-SPACE dm_) '(IN db_ (VEC dm_)) '(IN de_ (VEC dm_)) '(IN dlam_ RR) '(IN dll_ RR) '(IN dc_ RR)
        (list 'FORALL 'tt_ (list 'IMPLIES '(IN tt_ RR) (list 'IMPLIES '(<= (abs tt_) (abs dlam_))
          (list 'FORSOME 'dd_ (list 'AND (list 'HAS-DIR-DERIV 'dm_ 'df_ (c2d-pt 'tt_) 'de_ 'dd_)
                                       '(<= (abs (- dd_ dll_)) dc_)))))))
  (list '<= (list 'abs (list '- (list '- (list 'df_ (c2d-pt 'dlam_)) '(df_ db_)) '(* dlam_ dll_)))
            '(* dc_ (abs dlam_))))))
(dk-peel!)
(set! c2d-K (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DIR-DERIV))) "K"))
(dk-cite! 'rr-abs-closed 'dlam_)
;;; at t with |t| <= |lam| in context: the curve's derivative at t, within dc_ of dll_
(define (c2d-curve-deriv! t)
  (dk-cite! 'rr-abs-closed t)
  (let* ((ex (dk-apply! c2d-K t))
         (d  (dk-skolem! ex #t)))
    (dk-cite! 'has-dir-deriv-shift 'dm_ 'df_ 'db_ 'de_ t d)
    d))
;;; the MVI hypothesis on [lo, hi], given a prover of |x| <= |lam| for x in [lo, hi]
(define (c2d-mvi-hyp! lo hi absle!)
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'CCINT lo hi))
              (list 'FORSOME 'l_ (list 'AND (list 'HAS-DERIV-AT c2d-g 'x_ 'l_) '(<= (abs (- l_ dll_)) dc_)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-split-all! (list (dk-cite! 'ccint-parts lo hi x)))
        (absle! x)
        (let ((d (c2d-curve-deriv! x)))
          (ew d)
          (dk-conj-close! (lambda () (ass))))))))
;;; the values of the curve: g(t) == f(b + t.e); g(0) == f(b)
(define (c2d-g-at! t) (dk-cite! 'seg-curve-apply 'dm_ 'df_ 'db_ 'de_ t))
(dk-cite! 'rr-zero-in)
(dk-cite! 'nvs-act-in-vec 'dm_ 0 'de_)
(define c2d-b0 (dk-cite! 'nvs-act-zero 'dm_ 'de_ 'db_))       ; b + 0.e = b
(dk-have! '(<= (abs 0) (abs dlam_))
  (lambda () (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0)) (dk-cite! 'rr-abs-nonneg 'dlam_) (ass)))
(define c2d-d0 (c2d-curve-deriv! 0))
(dk-cite! 'has-deriv-at-value-in-rr c2d-g 0 c2d-d0)
(define c2d-g0 (c2d-g-at! 0))
(define c2d-fb '(df_ db_))
(define c2d-ptl (c2d-pt 'dlam_))
(define c2d-fl (list 'df_ c2d-ptl))
(define c2d-g0b (dk-rewrite-h! c2d-g0 (c2d-pt 0) 'db_))     ; g(0) == f(b)
(dk-have! (list 'IN c2d-fb 'RR) (lambda () (subst (list '= c2d-fb (list c2d-g 0))) (ass)))
;;; |f(b + lam.e) - f(b) - lam.dll_| <= dc_ |lam|, both nonzero cases, from the MVI on [lo, hi]
(define (c2d-at-lam!)
  (dk-cite! 'rr-leq-reflexive '(abs dlam_))
  (let ((d (c2d-curve-deriv! 'dlam_)))
    (dk-cite! 'has-deriv-at-value-in-rr c2d-g 'dlam_ d)
    (let ((gl (c2d-g-at! 'dlam_)))
      (dk-have! (list 'IN c2d-fl 'RR) (lambda () (subst (list '= c2d-fl (list c2d-g 'dlam_))) (ass)))
      gl)))
(define (c2d-pos-case!)
  (dk-have! '(<= 0 dlam_) (lambda () (dk-ineq! '(< 0 dlam_))))
  (c2d-mvi-hyp! 0 'dlam_
    (lambda (x)
      (dk-have! (list '<= (list 'abs x) '(abs dlam_))
        (lambda ()
          (subst (dk-cite! 'rr-abs-of-nonneg x))
          (subst (dk-cite! 'rr-abs-of-nonneg 'dlam_))
          (dk-ineq! (list '<= x 'dlam_))))))
  (let* ((gl (c2d-at-lam!))
         (mvi (dk-cite! 'mean-value-inequality-on-interval 0 'dlam_ c2d-g 'dll_ 'dc_))
         (m1 (dk-rewrite-h! mvi (list c2d-g 'dlam_) c2d-fl))
         (m2 (dk-rewrite-h! m1 (list c2d-g 0) c2d-fb)))
    (dk-have! '(= (* dll_ (- dlam_ 0)) (* dlam_ dll_)) (lambda () (crs)))
    (dk-have! '(= (* dc_ (- dlam_ 0)) (* dc_ (abs dlam_)))
      (lambda () (subst (dk-cite! 'rr-abs-of-nonneg 'dlam_)) (crs)))
    (let* ((m3 (dk-rewrite-h! m2 '(* dll_ (- dlam_ 0)) '(* dlam_ dll_)))
           (m4 (dk-rewrite-h! m3 '(* dc_ (- dlam_ 0)) '(* dc_ (abs dlam_)))))
      (ass))))
(define (c2d-neg-case!)
  (dk-have! '(<= dlam_ 0) (lambda () (dk-ineq! '(< dlam_ 0))))
  (c2d-mvi-hyp! 'dlam_ 0
    (lambda (x)
      (dk-have! (list '<= (list 'abs x) '(abs dlam_))
        (lambda ()
          (subst (dk-cite! 'rr-abs-of-nonpos x))
          (subst (dk-cite! 'rr-abs-of-neg 'dlam_))
          (dk-ineq! (list '<= 'dlam_ x))))))
  (let* ((gl (c2d-at-lam!))
         (mvi (dk-cite! 'mean-value-inequality-on-interval 'dlam_ 0 c2d-g 'dll_ 'dc_))
         (m1 (dk-rewrite-h! mvi (list c2d-g 'dlam_) c2d-fl))
         (m2 (dk-rewrite-h! m1 (list c2d-g 0) c2d-fb))
         (xex (list '- (list '- c2d-fl c2d-fb) '(* dlam_ dll_))))
    (dk-type! xex)
    (dk-have! (list '= (list '- (list '- c2d-fb c2d-fl) '(* dll_ (- 0 dlam_))) (list '- xex)) (lambda () (crs)))
    (dk-have! '(= (* dc_ (- 0 dlam_)) (* dc_ (abs dlam_)))
      (lambda () (subst (dk-cite! 'rr-abs-of-neg 'dlam_)) (crs)))
    (let* ((m3 (dk-rewrite-h! m2 (list '- (list '- c2d-fb c2d-fl) '(* dll_ (- 0 dlam_))) (list '- xex)))
           (m4 (dk-rewrite-h! m3 '(* dc_ (- 0 dlam_)) '(* dc_ (abs dlam_))))
           (an (dk-cite! 'rr-abs-neg xex))
           (m5 (dk-rewrite-h! m4 (list 'abs (list '- xex)) (list 'abs xex))))
      (ass))))
(define (c2d-zero-case! eqn)
  (subst eqn)
  (subst c2d-b0)
  (dk-have! (list '= (list '- (list '- c2d-fb c2d-fb) '(* 0 dll_)) 0) (lambda () (crs)))
  (subst (list '= (list '- (list '- c2d-fb c2d-fb) '(* 0 dll_)) 0))
  (fact 'rr-abs-zero-value)
  (subst '(= (abs 0) 0))
  (dk-have! '(= (* dc_ 0) 0) (lambda () (crs)))
  (subst '(= (* dc_ 0) 0))
  (dk-cite! 'rr-leq-reflexive 0)
  (ass))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-asm? '(<= dlam_ 0))
        (use-em '(= dlam_ 0)
          (lambda () (c2d-zero-case! '(= dlam_ 0)))
          (lambda () (dk-have! '(< dlam_ 0) (lambda () (mac '<) (dk-conj-close! (lambda () (ass)))))
                     (c2d-neg-case!)))
        (use-em '(= 0 dlam_)
          (lambda () (c2d-zero-case! '(= dlam_ 0)))
          (lambda () (dk-have! '(< 0 dlam_) (lambda () (mac '<) (dk-conj-close! (lambda () (ass)))))
                     (c2d-pos-case!)))))
  (dk-opened (lambda () (ai (dk-cite! 'rr-le-total 'dlam_ 0)))))
(qed 'has-dir-deriv-step)
