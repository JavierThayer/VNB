;;; =============================================================================================
;;; the spectral radius lies below every root ||x^n||^(1/n), n >= 1 (einf-lower on the defining set)
(define (bgf-ss)
  (list 'SEP 'bsw_ 'RR (list 'FORSOME 'bsn_ (list 'AND '(IN bsn_ NN) (list 'AND '(<= 1 bsn_)
    (list '= 'bsw_ (list 'RPOW-STAR (list '(VNRM a) (list 'EL-POW 'a 'x 'bsn_)) '(RECIP-STAR bsn_))))))))
(define (bgf-rt j) (list 'RPOW-STAR (bgf-nr (bgf-p 'x j)) (list 'RECIP-STAR j)))
(define (bgf-rtype! j)
