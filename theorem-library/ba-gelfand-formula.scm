  (bgf-ss-subset!)
  (bgf-rtype! 'n)
  (dk-have! (list 'IN (bgf-rt 'n) ss)
    (lambda () (in-sep! (lambda () (dk-ass!))
                        (lambda () (ew 'n) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
  (dk-apply! (dk-cite! 'einf-lower ss) (bgf-rt 'n))
  (subst (list '= rho lv))
  (dk-ass!))
(bgf-qed! 'bgf-radius-le-root)

;;; =============================================================================================
;;; (E) from ||x^n|| <= s^(n+1) M for all n: rho(x) <= t for every t > s
(sp (bgf-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL s (IMPLIES (IN s RR) (IMPLIES (< 0 s) (FORALL bm (IMPLIES (IN bm RR) (IMPLIES (<= 0 bm)
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (<= ((VNRM a) (EL-POW a x n)) (* (* s (POWER s n)) bm))))
    (FORALL gft (IMPLIES (IN gft RR) (IMPLIES (< s gft) (<= (SPECTRAL-RADIUS a x) gft)))))))))))))))
(dk-peel!)
(let* ((hest (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'EL-POW h) (bgf-occurs? 'bm h))) "the estimate"))
       (rho '(SPECTRAL-RADIUS a x)))
  (bgf-rr! 0)
  (bgf-lin! '(< 0 gft) '(< 0 s) '(< s gft))
  (bgf-lin! '(<= 0 s) '(< 0 s))
  (bgf-lin! '(<= 0 gft) '(< 0 gft))
  (bgf-nonzero! 'gft)
  (bgf-rr! '(recip gft))
  (dk-cite! 'rr-recip-pos 'gft)
  (bgf-cite2! 'rr-recip-inverse 'gft)
  (let* ((w (dk-name! '(recip gft)))
         (hw1 (dk-rewrite-h! '(< 0 (recip gft)) '(recip gft) w))
         (hw2 (dk-rewrite-h! '(= (* gft (recip gft)) 1) '(recip gft) w))
         (r (list '* 's w)))
    (bgf-rr! r)
    (bgf-lin! (list '<= 0 w) hw1)
    (dk-have! (list '= (list '* w 's) r) (lambda () (crs)))
    (dk-have! (list '= (list '* w 'gft) (list '* 'gft w)) (lambda () (crs)))
    (bgf-rr! (list '* w 's)) (bgf-rr! (list '* w 'gft)) (bgf-rr! (list '* 'gft w)) (bgf-rr! '(* s 0))
    (let ((lt (bgf-cite2! 'rr-lt-scale-pos w 's 'gft)))
      (bgf-lin! (list '< r 1) lt (list '= (list '* w 's) r) (list '= (list '* w 'gft) (list '* 'gft w)) hw2))
    (dk-cite! 'rr-mul-zero 's)
    (let ((nn0 (bgf-cite2! 'rr-le-scale-nonneg 's 0 w)))
      (bgf-lin! (list '<= 0 r) nn0 '(= (* s 0) 0)))
    (bgf-rr! '(* s bm))
    (let ((qq0 (bgf-cite2! 'rr-le-scale-nonneg 's 0 'bm)))
      (bgf-lin! '(<= 0 (* s bm)) qq0 '(= (* s 0) 0)))
    (let* ((qv (dk-name! '(* s bm)))
           (hq0 (dk-rewrite-h! '(<= 0 (* s bm)) '(* s bm) qv))
           (q1 (list '+ qv 1)))
      (bgf-rr! q1)
      (bgf-lin! (list '< 0 q1) hq0)
      (bgf-lin! (list '<= 0 q1) hq0)
      (bgf-nonzero! q1)
      (bgf-rr! (list 'recip q1))
      (dk-cite! 'rr-recip-pos q1)
      (bgf-cite2! 'rr-recip-inverse q1)
      (let* ((e (dk-name! (list 'recip q1)))
             (he1 (dk-rewrite-h! (list '< 0 (list 'recip q1)) (list 'recip q1) e))
             (he2 (dk-rewrite-h! (list '= (list '* q1 (list 'recip q1)) 1) (list 'recip q1) e)))
        (bgf-cite2! 'rr-pos-rr-of-lt e)
        (let* ((hthr (bgf-cite2! 'power-small-threshold r))
               (cap (dk-skolem! (dk-apply! hthr e) #t))
               (hk (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? cap h) (bgf-occurs? 'POWER h))) "the threshold"))
               (n (list '+ cap 1)))
          (dk-have! '(IN 1 NN) (lambda () (arith)))
          (bgf-cite2! 'nn-add-closed cap 1)
          (dk-have! (list '<= 1 n) (lambda () (dk-nn!)))
          (dk-have! (list '<= cap n) (lambda () (dk-nn!)))
          (let* ((Rn (list 'POWER r n)) (Pn (list 'POWER 'gft n)) (Sn (list 'POWER 's n)))
            (dk-apply! hk n)
            (dk-cite! 'rr-power-nonneg n r)
            (dk-cite! 'rr-power-nonneg n 'gft)
            (bgf-rr! Rn) (bgf-rr! Pn) (bgf-rr! Sn)
            (dk-have! (list '= (list '* r 'gft) 's)
              (lambda ()
                (dk-have! (list '= (list '* r 'gft) (list '* 's (list '* 'gft w))) (lambda () (crs)))
                (subst (list '= (list '* r 'gft) (list '* 's (list '* 'gft w))))
                (subst (list '= (list '* 'gft w) 1))
                (crs)))
            (let* ((pm (dk-cite! 'rr-power-mul-base n r 'gft))
                   (pm2 (dk-rewrite-h! pm (list '* r 'gft) 's))
                   (hn (dk-apply! hest n))
                   (rv (dk-name! Rn))
                   (pv (dk-name! Pn))
                   (pm3 (dk-rewrite-h! (dk-rewrite-h! pm2 Rn rv) Pn pv))
                   (hn2 (dk-rewrite-h! hn Sn (list '* rv pv)))
                   (hle (dk-rewrite-h! (list '<= Rn e) Rn rv))
                   (hr0 (dk-rewrite-h! (list '<= 0 Rn) Rn rv))
                   (hp0 (dk-rewrite-h! (list '<= 0 Pn) Pn pv))
                   (iden (list '= (list '* (list '* 's (list '* rv pv)) 'bm) (list '* pv (list '* rv '(* s bm))))))
              (dk-have! iden (lambda () (crs)))
              (let* ((hn3 (dk-rewrite-h! hn2 (cadr iden) (caddr iden)))
                     (hn4 (dk-rewrite-h! hn3 '(* s bm) qv))
                     (rq (list '* rv qv)))
                (bgf-rr! rq) (bgf-rr! (list '* rv q1)) (bgf-rr! (list '* e q1)) (bgf-rr! (list '* q1 e))
                (let ((m1 (bgf-cite2! 'rr-mul-le-right rv e q1)))
                  (dk-have! (list '= (list '* rv q1) (list '+ rq rv)) (lambda () (crs)))
                  (dk-have! (list '= (list '* e q1) (list '* q1 e)) (lambda () (crs)))
                  (bgf-lin! (list '<= rq 1) m1 (list '= (list '* rv q1) (list '+ rq rv))
                            (list '= (list '* e q1) (list '* q1 e)) he2 hr0))
                (dk-cite! 'rr-one-in)
                (let* ((m2 (bgf-cite2! 'rr-le-scale-nonneg pv rq 1)))
                  (dk-have! (list '= (list '* pv 1) pv) (lambda () (crs)))
                  (let* ((m3 (dk-rewrite-h! m2 (list '* pv 1) pv))
                         (xn (bgf-p 'x n)) (nxn (bgf-nr xn)) (big (list '* pv rq)))
                    (bgf-vt xn) (bgf-rr! nxn) (bgf-rr! big)
                    (dk-have! (list '<= nxn pv) (lambda () (dk-le-chain! nxn big pv)))
                    (dk-rewrite-h! (list '<= nxn pv) pv Pn)
                    (dk-cite! 'bal-uba-vnrm-nonneg 'a xn)
                    (bgf-cite2! 'fek-root-le nxn 'gft n)
                    (bgf-cite2! 'bgf-radius-le-root 'a 'x n)
                    (dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
                    (bgf-rtype! n)
                    (dk-le-chain! rho (bgf-rt n) 'gft)))))))))))
(bgf-qed! 'bgf-radius-from-estimate)

;;; =============================================================================================
;;; (F) GELFAND'S BOUND: if every z with |z| >= s > 0 lies in the resolvent set, then rho(x) <= s
(sp (bgf-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
  (list 'IMPLIES bgf-Hs '(<= (SPECTRAL-RADIUS a x) s)))))))))
(dk-peel!)
(let* ((rho '(SPECTRAL-RADIUS a x)))
  (bgf-lin! '(<= 0 s) '(< 0 s))
  (let ((bm (dk-skolem! (bgf-cite2! 'bgf-resolvent-circle-bound 'a 'x 's) #t)))
    (dk-split-all!)
    (bgf-cite2! 'bgf-power-estimate 'a 'x 's bm)
    (dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
    (let* ((hr (bgf-cite2! 'bgf-radius-from-estimate 'a 'x 's bm))
           (ch (dk-cite! 'rr-le-of-le-add-all-pos rho 's)))
      (bgf-detach-lane! ch
        (lambda ()
          (let ((d (cadr (dk-goal))))
            (dk-peel!)
            (dk-cite! 'rr-pos-rr-in-rr d)
            (dk-cite! 'rr-lt-of-pos-rr d)
            (bgf-rr! (list '+ 's d))
            (bgf-lin! (list '< 's (list '+ 's d)) (list '< 0 d))
            (dk-apply! hr (list '+ 's d))
            (dk-ass!))))
      (dk-ass!))))
(bgf-qed! 'gelfand-spectral-radius-le)


;;; =============================================================================================
;;; (G) THE MAXIMUM: some z0 in sigma(x) has |z0| = rho(x) and |z| <= |z0| on sigma(x)
(define bgf-sig '(SPECTRUM a x))
(define (bgf-sig-cc! w)            ; (IN w sigma) in context: land (IN w CC), (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a w x)))
  (let ((m0 (list 'IN w bgf-sig)) (ni (list 'NOT (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a w 'x)))))
    (if (not (and (dk-asm? (list 'IN w 'CC)) (dk-asm? ni)))
        (begin
          (fact 'bas-spectrum-unfold 'a 'x)
          (let ((m1 (dk-rewrite-h! m0 bgf-sig bgf-sep-sigma)))
            (if (not (dk-asm? ni)) (dk-project! ni (lambda () (sep-me m1))))
            (if (not (dk-asm? (list 'IN w 'CC))) (dk-project! (list 'IN w 'CC) (lambda () (sep-me m1)))))))
    ni))
(define (bgf-in-sig! w)            ; (IN w CC), (NOT invertible) in context: land (IN w sigma)
  (let ((goal (list 'IN w bgf-sig)))
    (if (not (dk-asm? goal))
        (begin
          (fact 'bas-spectrum-unfold 'a 'x)
          (dk-have! goal
            (lambda ()
              (subst (list '= bgf-sig bgf-sep-sigma))
              (in-sep! (lambda () (dk-ass!)))))))
    goal))
(define (bgf-cc-reverse! p q)      ; p, q in CC: land (<= (abs (- |p| |q|)) |p - q|)
  (let* ((mp (list 'magnitude p)) (mq (list 'magnitude q)) (pq (list '- p q)) (qp (list '- q p))
         (mpq (list 'magnitude pq)) (mqp (list 'magnitude qp)) (d (list '- mp mq)))
    (bgf-cc! pq) (bgf-cc! qp)
    (bgf-rr! mp) (bgf-rr! mq) (bgf-rr! mpq) (bgf-rr! mqp) (bgf-rr! d) (bgf-rr! (list '- mpq))
    (dk-have! (list '= (list '+ pq q) p) (lambda () (mac 'binary-minus-def) (crs)))
    (dk-have! (list '= (list '+ qp p) q) (lambda () (mac 'binary-minus-def) (crs)))
    (let* ((t1 (bgf-cite2! 'cc-magnitude-triangle pq q))
           (t1b (dk-rewrite-h! t1 (list '+ pq q) p))
           (t2 (bgf-cite2! 'cc-magnitude-triangle qp p))
           (t2b (dk-rewrite-h! t2 (list '+ qp p) q)))
      (dk-cite! 'cc-magnitude-sub-sym q p)
      (bgf-lin! (list '<= d mpq) t1b)
      (bgf-lin! (list '<= (list '- mpq) d) t2b (list '= mqp mpq))
      (bgf-cite2! 'rr-abs-le-of-parts d mpq))))
(define (bgf-antes f)              ; the antecedents along the FORALL / IMPLIES spine of f
  (cond ((dk-head-is? f 'FORALL) (bgf-antes (caddr f)))
        ((dk-head-is? f 'IMPLIES) (cons (cadr f) (bgf-antes (caddr f))))
        (#t '())))
(sp (bgf-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORSOME gfz (AND (IN gfz (SPECTRUM a x))
  (AND (= (magnitude gfz) (SPECTRAL-RADIUS a x)) (FORALL z (IMPLIES (IN z (SPECTRUM a x)) (<= (magnitude z) (magnitude gfz)))))))))))
(dk-peel!)
(let* ((sig bgf-sig) (gm '(VNB-LAMBDA gfm_ (SPECTRUM a x) (magnitude gfm_)))
       (rho '(SPECTRAL-RADIUS a x)) (nx (bgf-rr! (bgf-nr 'x))))
  (dk-cite! 'cc-is-set)
  (dk-cite! 'cc-zero-in)
  (bgf-hinv!)
  (dk-have! (list 'SUBSET sig 'CC)
    (lambda () (mac 'subset-def)
      (let ((w (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
        (dk-close-if! (lambda () (bgf-sig-cc! w)) (lambda () (dk-ass!))))))
  (bgf-cite2! 'subclass-of-set-is-set sig 'CC)
  (dk-have! (list 'IN gm (list 'FUN sig 'RR))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((w (dk-di-var!))) (bgf-sig-cc! w) (dk-cite! 'cc-magnitude-closed w) (dk-ass!)))
        (lambda () (dk-ass!)))))
  (dk-cite! 'spectrum-in-closed-ball 'a 'x)
  (dk-cite! 'spectrum-nonempty 'a 'x)
  (let* ((ch0 (dk-cite! 'cc-closed-bounded-max sig gm))
         (antes (bgf-antes ch0))
         (clos (car (filter (lambda (f) (and (dk-head-is? f 'FORALL) (bgf-occurs? 'POS-RR f) (bgf-occurs? 'FORSOME f)
                                             (not (bgf-occurs? 'abs f)))) antes)))
         (cont (car (filter (lambda (f) (and (dk-head-is? f 'FORALL) (bgf-occurs? 'abs f))) antes))))
    ;; ---- sigma is closed
    (dk-have! clos
      (lambda ()
        (dk-peel!)
        (let* ((y (cadr (dk-goal)))
               (hcl (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'POS-RR h) (bgf-occurs? y h))) "the approximation")))
          (use-em (list 'IN y sig)
            (lambda () (dk-ass!))
            (lambda ()
              (dk-have! (list 'IN y bgf-U) (lambda () (mac 'difference-membership) (dk-conj-close! (lambda () (dk-ass!)))))
              (bgf-off-spectrum! y)
              (bgf-rr! 1)
              (bgf-lin! '(< 0 1))
              (bgf-cite2! 'rr-pos-rr-of-lt 1)
              (let* ((del (dk-skolem! (bgf-cite2! 'resolvent-continuous 'a 'x y 1) #t))
                     (hres (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? del h)
                                                      (bgf-occurs? 'INVERSE-EL h))) "the resolvent modulus")))
                (dk-cite! 'rr-pos-rr-in-rr del)
                (let* ((w (dk-skolem! (dk-apply! hcl del) #t))
                       (ni (bgf-sig-cc! w))
                       (eqm (list '= (list '- w y) (list '+ w (list '- y)))))
                  (dk-have! eqm (lambda () (mac 'binary-minus-def) (crs)))
                  (let* ((hl (bgf-find (lambda (h) (and (dk-head-is? h '<) (equal? (cadr h) (list 'magnitude (list '- w y)))))
                                       "|w - y| < del"))
                         (hl2 (dk-rewrite-h! hl (list '- w y) (list '+ w (list '- y)))))
                    (bgf-rr! (list 'magnitude (list '+ w (list '- y))))
                    (bgf-lin! (list '<= (list 'magnitude (list '+ w (list '- y))) del) hl2)
                    (dk-split-all! (list (dk-apply! hres w)))
                    (ai ni)))))))))
    ;; ---- the modulus is continuous on sigma
    (dk-have! cont
      (lambda ()
        (dk-peel!)
        (let* ((g0 (dk-goal)) (inner (caddr (caddr (caddr (caddr g0)))))
               (xv (cadr (cadr (cadr (cadr inner)))))
               (eps (caddr (caddr inner))))
          (dk-cite! 'rr-pos-rr-in-rr eps)
          (ew eps)
          (dk-have! (caddr (dk-goal))
            (lambda ()
              (let ((y (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                (bgf-sig-cc! xv) (bgf-sig-cc! y)
                (bgf-rr! (list 'magnitude xv)) (bgf-rr! (list 'magnitude y))
                (dk-have! (list '= (list gm xv) (list 'magnitude xv)) (lambda () (if (not (dk-lam-b!)) (rfl))))
                (dk-have! (list '= (list gm y) (list 'magnitude y)) (lambda () (if (not (dk-lam-b!)) (rfl))))
                (subst (list '= (list gm xv) (list 'magnitude xv)))
                (subst (list '= (list gm y) (list 'magnitude y)))
                (bgf-cc-reverse! xv y)
                (let ((d (list '- (list 'magnitude xv) (list 'magnitude y))))
                  (bgf-rr! (list 'abs d))
                  (dk-le-chain! (list 'abs d) (list 'magnitude (list '- xv y)) eps)))))
          (dk-conj-close! (lambda () (dk-ass!))))))
    ;; ---- the maximum
    (let* ((res (dk-cite! 'cc-closed-bounded-max sig gm nx))
           (z0 (dk-skolem! res #t))
           (hmx (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? z0 h) (bgf-occurs? gm h))) "the maximum"))
           (m0 (list 'magnitude z0))
           (hmax2 (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sig) (list '<= '(magnitude z) m0)))))
      (bgf-sig-cc! z0)
      (bgf-rr! m0)
      (dk-cite! 'cc-magnitude-nonneg z0)
      (dk-have! (list '= (list gm z0) m0) (lambda () (if (not (dk-lam-b!)) (rfl))))
      (dk-have! hmax2
        (lambda ()
          (let ((z (dk-di-var!)))
            (bgf-sig-cc! z)
            (bgf-rr! (list 'magnitude z))
            (dk-have! (list '= (list gm z) (list 'magnitude z)) (lambda () (if (not (dk-lam-b!)) (rfl))))
            (let* ((h0 (dk-apply! hmx z))
                   (h1 (dk-rewrite-h! h0 (list gm z) (list 'magnitude z)))
                   (h2 (dk-rewrite-h! h1 (list gm z0) m0)))
              (dk-ass!)))))
      (dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
      (dk-cite! 'spectrum-in-spectral-radius-disc 'a 'x z0)
      ;; rho <= |z0| + d for every d > 0, by Gelfand's bound at s = |z0| + d
      (let ((ch (dk-cite! 'rr-le-of-le-add-all-pos rho m0)))
        (bgf-detach-lane! ch
          (lambda ()
            (let* ((d (cadr (dk-goal))) (sv (list '+ m0 d)))
              (dk-peel!)
              (dk-cite! 'rr-pos-rr-in-rr d)
              (dk-cite! 'rr-lt-of-pos-rr d)
              (bgf-rr! sv)
              (bgf-lin! (list '< 0 sv) (list '< 0 d) (list '<= 0 m0))
              (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES (list '<= sv '(magnitude z))
                          '(IS-INVERTIBLE-EL a (SHIFT-EL a z x)))))
                (lambda ()
                  (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                    (let ((inv (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a z 'x))))
                      (use-em inv
                        (lambda () (dk-ass!))
                        (lambda ()
                          (bgf-in-sig! z)
                          (dk-apply! (dk-ctx-form hmax2) z)
                          (bgf-rr! (list 'magnitude z))
                          (dk-absurd! (list '<= (list 'magnitude z) m0) (list '<= sv (list 'magnitude z))
                                      (list '< 0 d) (list 'IN m0 'RR) (list 'IN d 'RR) (list 'IN (list 'magnitude z) 'RR))))))))
              (bgf-cite2! 'gelfand-spectral-radius-le 'a 'x sv)
              (dk-ass!))))
        (bgf-lin! (list '= m0 rho) (list '<= m0 rho) (list '<= rho m0))
        (ew z0)
        (dk-conj-close! (lambda () (dk-ass!)))))))
(bgf-qed! 'gelfand-spectral-radius-max)

;;; =============================================================================================
;;; GELFAND'S FORMULA: lim ||x^n||^(1/n) = max { |z| : z in sigma(x) }
(define bgf-roots '(VNB-LAMBDA bfn_ NN (RPOW-STAR ((VNRM a) (EL-POW a x (succ bfn_))) (RECIP-STAR (succ bfn_)))))
(sp (bgf-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORSOME 'gfz (list 'AND '(IN gfz (SPECTRUM a x))
  (list 'AND '(FORALL z (IMPLIES (IN z (SPECTRUM a x)) (<= (magnitude z) (magnitude gfz))))
    (list 'CONVERGES-TO 'RR-MS bgf-roots '(magnitude gfz)))))))))
(dk-peel!)
(let* ((rho '(SPECTRAL-RADIUS a x))
       (z0 (dk-skolem! (dk-cite! 'gelfand-spectral-radius-max 'a 'x) #t)))
  (dk-split-all!)
  (dk-rewrite-h! (dk-cite! 'spectral-radius-limit 'a 'x) rho (list 'magnitude z0))
  (ew z0)
  (dk-conj-close! (lambda () (dk-ass!))))
(bgf-qed! 'gelfand-formula)

