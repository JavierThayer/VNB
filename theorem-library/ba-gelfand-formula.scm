;;; ba-gelfand-formula.scm -- BANACH ALGEBRAS: Gelfand's spectral radius formula
;;; rho(x) = lim ||x^n||^(1/n) = max{|z| : z in sigma(x)}, the reverse inequality of Proposition 1.8
;;; (F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 1, remark after 1.8).
;;; Agent BA-1H, wave 2026-11-09.  Destination: theorem-library/ba-gelfand-formula.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: bgf-.
;;;
;;; THE ROUTE (no vector-valued integral, no Banach-Steinhaus).  Fix a functional psi with
;;; |psi(v)| <= ||v|| and let f(z) = psi((z 1 - x)^(-1)) on the resolvent set U = CC \ sigma(x),
;;; holomorphic there (resolvent-functional-holomorphic, resolvent-set-open).
;;;  (1) THE DISSOLVING LEMMA (bgf-laurent-resolvent): for |z| > ||x||, f(z) is the LAURENT-SUM
;;;      about 0 of the two-sided family c with c(k) = 0 (k >= 0) and c(-(k+1)) = psi(x^k): the
;;;      Neumann series of (1 - x/z)^(-1) pushed through psi (bgf-psi-nsum, bgf-psi-conv).
;;;  (2) Uniqueness of Laurent coefficients (laurent-coefficients) then reads psi(x^n) as the
;;;      coefficient LAURENT-COEFS(f, 0, S)(-(n+1)) on a large circle |z| = S, and
;;;      laurent-coef-radius-free moves it to any circle |z| = s whose closed annulus up to S
;;;      lies in U (both inside bgf-functional-estimate).
;;;  (3) On |z| = s the norm of the resolvent is bounded by some M (compactness of the circle,
;;;      bgf-resolvent-circle-bound), so |f| <= M there for EVERY such psi and
;;;      laurent-coef-sup-bound gives |psi(x^n)| <= s^(n+1) M.  The norming functional of x^n
;;;      (uba-norming-functional) turns this into ||x^n|| <= M s^(n+1)  (bgf-power-estimate).
;;;  (4) A real lemma (bgf-radius-from-estimate): ||x^n|| <= C s^n for all n forces rho(x) <= t
;;;      for every t > s, hence rho(x) <= s (gelfand-spectral-radius-le).
;;;  (5) sigma(x) is closed, bounded and nonempty, so |z| attains its maximum on it at some z0
;;;      (cc-closed-bounded-max); (4) at s = |z0| + d gives rho(x) <= |z0|, and 1.8 gives
;;;      |z0| <= rho(x) (gelfand-spectral-radius-max).  With BA-1C's spectral-radius-limit this
;;;      is the formula (gelfand-formula).
;;; The uniform boundedness principle of the notes is replaced by the norming functional and the
;;; bound M on ||(z 1 - x)^(-1)||, which does not depend on psi.
;;;
;;; LOAD WINDOW: after BA-1F's ba-spectral-radius (resolvent-set-open, bsr-el-pow-act,
;;; spectrum-in-spectral-radius-disc, spectral-radius-real, spectral-radius-unfold), BA-1D's
;;; ba-spectrum-nonempty (resolvent-functional-holomorphic, uba-norming-functional, bsn-cl-*,
;;; spectrum-nonempty), BA-1C's fekete (fek-root-le), BA-1B's ba-resolvent (brv-shift-factor,
;;; brv-act-inverse, brv-w-norm, resolvent-continuous), BA-1's ba-neumann (neumann-series,
;;; ban-dist, ban-pts, ban-ms), ba-spectrum, ba-elem; and the tree's Laurent file (laurent-
;;; coefficients, laurent-coef-integrands, laurent-coef-radius-free, laurent-coef-sup-bound),
;;; cc-power-series (cps-radius-from-bound), cc-series (cc-series-single-term,
;;; cc-series-limit-of-converges-to), path-trace-compact, ch3a-schwarz (cc-compact-modulus-max),
;;; power-small-threshold, cc-closed-bounded-max, cc-magnitude-triangle, rr-le-of-le-add-all-pos,
;;; ban-telescope, ring-neg-zero-uba-as-ring, ring-add-right-id-uba-as-ring.

(define (bgf-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-gelfand-formula: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-gelfand-formula: unfinished" name))))

(define (bgf-dump! tag)
  (display "\n;; BGF-DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (write (dk-goal-of l)) (newline)
              (for-each (lambda (a) (display "      asm: ") (write a) (newline)) (dk-asms-of l)))
            (dk-open-leaves)))

(define (bgf-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bgf-m x y) (list '(VMUL a) x y))
(define (bgf-ad x y) (list '(VADD a) x y))
(define (bgf-ng x) (list '(VNEG a) x))
(define (bgf-sb x y) (bgf-ad x (bgf-ng y)))
(define (bgf-nr x) (list '(VNRM a) x))
(define (bgf-ac z x) (list '(ACT a) z x))
(define (bgf-inv x) (list 'INVERSE-EL 'a x))
(define (bgf-p x n) (list 'EL-POW 'a x n))
(define (bgf-s x n) (list 'NEUMANN-SUM 'a x n))
(define bgf-one '(VONE a))
(define bgf-zero '(VZERO a))
(define (bgf-rw! from to) (subst (list '= from to)))
(define (bgf-pin!) (dk-cite! 'bal-uba-scal-pin 'a))
(define (bgf-occurs? x t)
  (or (equal? x t) (and (pair? t) (or (bgf-occurs? x (car t)) (bgf-occurs? x (cdr t))))))
(define (bgf-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (bgf-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))
(define (bgf-find pred what)
  (let ((hs (filter pred (dk-asms))))
    (if (null? hs) (error "bgf-find: no hypothesis" what) (car hs))))

;;; the functional of the statements: gfp, with gfp in FUN(VEC a, CC) once (bgf-psi-fun!) ran
(define bgf-Hb '(FORALL bsv_ (IMPLIES (IN bsv_ (VEC a)) (<= (MAGNITUDE (gfp bsv_)) ((VNRM a) bsv_)))))

(define (bgf-cc! t)                       ; type a CC term built from + - * recip POWER of typed atoms
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bgf-cc! (cadr t)) (bgf-cc! (caddr t)) (bgf-cite2! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bgf-cc! (cadr t)) (bgf-cc! (caddr t)) (bgf-cite2! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 3))
         (bgf-cc! (cadr t)) (bgf-cc! (caddr t)) (bgf-cite2! 'cc-sub-in-cc (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bgf-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'recip))
         (bgf-cc! (cadr t)) (bgf-cite2! 'cc-recip-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (bgf-cc! (cadr t)) (bgf-cite2! 'power-typing-nonneg (cadr t) (caddr t)) t)
        ((member t '(0 1)) (dk-cite! (if (equal? t 0) 'cc-zero-in 'cc-one-in)) t)
        ((dk-asm? (list 'IN t 'RR)) (dk-cite! 'rr-subset-cc t) t)
        ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN (VEC a) CC))))
         (bgf-vt (cadr t)) (dk-cite! 'fun-apply-type-c (car t) '(VEC a) 'CC (cadr t)) t)
        ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN ZZ CC))))
         (dk-cite! 'fun-apply-type-c (car t) 'ZZ 'CC (cadr t)) t)
        ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
         (dk-cite! 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) t)
        (#t (error "bgf-cc!: cannot type" (expression->string t)))))

(define (bgf-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bgf-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bgf-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bgf-vt (cadr x)) (bgf-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bgf-vt (cadr x)) (bgf-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bgf-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bgf-cc! (cadr x)) (bgf-vt (caddr x))
           (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'SHIFT-EL))
           (bgf-cc! (caddr x)) (bgf-vt (cadddr x))
           (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          ((and (pair? x) (eq? (car x) 'NEUMANN-SUM))
           (bgf-vt (caddr x))
           (dk-cite! 'ban-nsum-type (cadddr x) 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'EL-POW))
           (bgf-vt (caddr x))
           (dk-cite! 'bae-el-pow-type (cadddr x) 'a (caddr x)) x)
          (#t (error "bgf-vt: cannot type" (expression->string x))))))

(define (bgf-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((equal? t 0) (dk-cite! 'rr-zero-in) t)
        ((equal? t 1) (dk-cite! 'rr-one-in) t)
        ((number? t) (dk-have! (list 'IN t 'RR) (lambda () (arith))) t)
        ((and (pair? t) (eq? (car t) 'MAGNITUDE))
         (bgf-cc! (cadr t)) (dk-cite! 'cc-magnitude-closed (cadr t)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (bgf-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bgf-rr! (cadr t)) (bgf-rr! (caddr t)) (bgf-cite2! 'rr-add-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bgf-rr! (cadr t)) (bgf-rr! (caddr t)) (bgf-cite2! 'rr-mul-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (bgf-rr! (cadr t)) (dk-cite! 'power-real-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 3))
         (bgf-rr! (cadr t)) (bgf-rr! (caddr t)) (bgf-cite2! 'rr-sub-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bgf-rr! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'abs))
         (bgf-rr! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'recip))
         (bgf-rr! (cadr t)) (bgf-cite2! 'rr-recip-closed (cadr t)) t)
        (#t (error "bgf-rr!: cannot type" (expression->string t)))))

(define (bgf-z-nonzero! z)        ; z /= 0 in CC from 0 < |z|
  (let ((f (list 'NOT (list '= z 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (di)
            (dk-cite! 'cc-magnitude-zero)
            (let* ((h1 (dk-rewrite-h! (list '< 0 (list 'magnitude z)) z 0))
                   (h2 (dk-rewrite-h! h1 '(magnitude 0) 0)))
              (dk-absurd! h2)))))
    f))

