(dk-peel!)
(dk-cite! 'bsn-cl-fun 'a 'gfp)
(dk-have! (list 'IN bgf-W '(FUN ZZ CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((j (dk-di-var!)) (ift (cadr (dk-goal))))
          (dk-case-if! ift
            (lambda (true? val)
              (if true?
                  (begin (bgf-cc! 0) (dk-ass!))
                  (let ((m (list '- (list '+ j 1))))
                    (dk-cite! 'zz-in-rr j)
                    (dk-cite! 'rr-zero-in)
                    (bgf-cite2! 'rr-not-le-lt 0 j)
                    (dk-cite! 'zz-zero-in)
                    (bgf-cite2! 'zz-lt-succ-le j 0)
                    (dk-cite! 'zz-one-in)
                    (bgf-cite2! 'zz-add-closed j 1)
                    (dk-cite! 'zz-neg-closed (list '+ j 1))
                    (bgf-lin! (list '<= 0 m) (list '<= (list '+ j 1) 0))
                    (bgf-cite2! 'zz-nonneg-in-nn m)
                    (bgf-cc! (list 'gfp (bgf-p 'x m)))
                    (dk-ass!))))))))))
(ew bgf-W)
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-ass!) #t)
      ((not (equal? (caddr (caddr (caddr (dk-goal)))) 0))
       (let* ((k (dk-di-var!)) (m (bgf-zz-neg-succ! k)))
         (dk-lam-b!)
         (dk-cite! 'nn-in-rr k)
         (dk-cite! 'nn-zero-le k)
         (bgf-lin! (list '< m 0) (list '<= 0 k))
         (dk-cite! 'rr-zero-in)
         (bgf-cite2! 'rr-lt-not-le m 0)
         (bgf-cc! (list 'gfp (bgf-p 'x k)))
         (let ((ift (cadr (dk-goal))))
           (dk-if-branch! #f ift #f
             (lambda ()
               (dk-have! (list '= (list '- (list '+ m 1)) k) (lambda () (crs)))
               (subst (list '= (list '- (list '+ m 1)) k))
               (rfl))))))
      (#t
       (let ((k (dk-di-var!)))
         (dk-cite! 'nn-subset-zz k)
         (dk-lam-b!)
         (dk-cite! 'nn-zero-le k)
         (dk-if-branch! #t (cadr (dk-goal)) #f (lambda () (rfl))))))))
(bgf-qed! 'bgf-coef-family)

;;; =============================================================================================
;;; (A5) THE DISSOLVING LEMMA: for |z| > ||x||, psi((z 1 - x)^(-1)) is the Laurent sum about 0 of c
(sp (bgf-st (list 'FORALL 'gfp (list 'IMPLIES '(IS-CC-LINEAR-ON a gfp) (list 'IMPLIES bgf-Hb
  '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL gfc (IMPLIES (IN gfc (FUN ZZ CC))
     (IMPLIES (FORALL gfk_ (IMPLIES (IN gfk_ NN) (= (gfc gfk_) 0)))
     (IMPLIES (FORALL gfk_ (IMPLIES (IN gfk_ NN) (= (gfc (- (+ gfk_ 1))) (gfp (EL-POW a x gfk_)))))
     (FORALL z (IMPLIES (IN z CC) (IMPLIES (< ((VNRM a) x) (magnitude z))
       (= (LAURENT-SUM gfc 0 z) (gfp (INVERSE-EL a (SHIFT-EL a z x))))))))))))))))))
(dk-peel!)
(dk-cite! 'bsn-cl-fun 'a 'gfp)
(let* ((hz0 (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (equal? (caddr (caddr (caddr h))) 0)
                                       (bgf-occurs? 'gfc h))) "c = 0 on NN"))
       (hneg (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'gfc h) (bgf-occurs? 'EL-POW h))) "c at -(k+1)"))
       (n (bgf-rr! (bgf-nr 'x))) (m (bgf-rr! '(magnitude z)))
       (zr '(recip z)) (w (bgf-ac zr 'x)) (om (bgf-sb bgf-one w)) (V (bgf-inv om)))
  (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
  (dk-have! (list '< 0 m) (lambda () (dk-ineq! (list '< n m) (list '<= 0 n))))
  (bgf-z-nonzero! 'z)
  (bgf-cc! zr) (bgf-vt w) (bgf-vt om)
  (bgf-nonzero! m)
  (bgf-cite2! 'rr-recip-closed m)
  (let ((wn (dk-cite! 'brv-w-norm 'a 'x 'z)))
    (dk-have! (list '< n (list '* 1 m)) (lambda () (dk-ineq! (list '< n m))))
    (dk-cite! 'rr-lt-div-of-lt-mul n 1 m)
    (bgf-rr! (list '* (list 'recip m) n)) (bgf-rr! (list '* n (list 'recip m)))
    (dk-have! (list '= (list '* (list 'recip m) n) (list '* n (list 'recip m))) (lambda () (crs)))
    (dk-have! (list '< (bgf-nr w) 1)
      (lambda ()
        (bgf-rw! (bgf-nr w) (list '* (list 'recip m) n))
        (bgf-rw! (list '* (list 'recip m) n) (list '* n (list 'recip m)))
        (dk-ass!))))
  (dk-split-all! (list (dk-cite! 'neumann-series 'a w)))
  (bgf-vt V)
  (mac 'LAURENT-SUM)
  (dk-have! '(= (- z 0) z) (lambda () (mac 'binary-minus-def) (crs)))
  (subst '(= (- z 0) z))
  (let* ((lhs (cadr (dk-goal)))
         (zser (cadr (cadr lhs)))
         (nser (cadr (caddr (caddr lhs))))
         (zl (list 'CC-SERIES-LIMIT zser)) (nl (list 'CC-SERIES-LIMIT nser)))
    ;; ---- the nonnegative part is the zero series
    (dk-have! (list 'IN zser '(FUN NN CC))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((j (dk-di-var!)))
              (dk-cite! 'nn-subset-zz j)
              (bgf-cc! (list '* (list 'gfc j) (list 'POWER 'z j)))
              (dk-ass!))))))
    (let ((hzall (list 'FORALL 'gfj_ (list 'IMPLIES '(IN gfj_ NN) (list '= (list zser 'gfj_) 0)))))
      (dk-have! hzall
        (lambda ()
          (let ((j (dk-di-var!)))
            (dk-lam-b!)
            (dk-apply! hz0 j)
            (subst (list '= (list 'gfc j) 0))
            (bgf-cc! (list 'POWER 'z j))
            (dk-have! (list '= (list '* 0 (list 'POWER 'z j)) 0) (lambda () (dk-crs-opaque!))))))
      (dk-have! (list 'FORALL 'gfj_ (list 'IMPLIES '(IN gfj_ NN) (list 'IMPLIES '(NOT (= gfj_ 0)) (list '= (list zser 'gfj_) 0))))
        (lambda () (let ((j (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                     (dk-apply! (dk-ctx-form hzall) j) (dk-ass!))))
      (dk-have! '(IN 0 NN) (lambda () (arith)))
      (dk-apply! (dk-ctx-form hzall) 0)
      (let* ((st (bgf-cite2! 'cc-series-single-term zser 0))
             (st2 (dk-rewrite-h! st (list zser 0) 0)))
        (dk-split-all! (list (bgf-cite2! 'cc-series-limit-of-converges-to zser 0)))
        (subst (list '= zl 0))))
    ;; ---- the negative part: psi of the Neumann series of w = z^-1 x
    (dk-have! (list 'IN nser '(FUN NN CC))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((j (dk-di-var!)) (mj (bgf-zz-neg-succ! j)))
              (bgf-cc! (list '* (list 'gfc mj) (list 'POWER zr j)))
              (dk-ass!))))))
    (let ((hNp (list 'FORALL 'gfk_ (list 'IMPLIES '(IN gfk_ NN) (list '= (list nser 'gfk_) (list 'gfp (bgf-p w 'gfk_)))))))
      (dk-have! hNp
        (lambda ()
          (let* ((k (dk-di-var!)) (mk (bgf-zz-neg-succ! k)) (pk (list 'POWER zr k)) (xk (bgf-p 'x k)))
            (dk-lam-b!)
            (dk-apply! hneg k)
            (subst (list '= (list 'gfc mk) (list 'gfp xk)))
            (bgf-cc! pk) (bgf-vt xk)
            (dk-cite! 'bsr-el-pow-act k 'a zr 'x)
            (subst (list '= (bgf-p w k) (bgf-ac pk xk)))
            (dk-cite! 'bsn-cl-act 'a 'gfp pk xk)
            (subst (list '= (list 'gfp (bgf-ac pk xk)) (list '* pk (list 'gfp xk))))
            (bgf-cc! (list 'gfp xk))
            (crs))))
      (let* ((hcv (bgf-find (lambda (h) (dk-head-is? h 'CONVERGES-TO)) "the Neumann convergence"))
             (sq (caddr hcv))
             (target (list 'CC-SERIES-CONVERGES-TO nser (list 'gfp V))))
        (dk-have! (list 'IN sq '(FUN NN (VEC a)))
          (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (bgf-vt (bgf-s w j)) (dk-ass!))))))
        (dk-have! target
          (lambda ()
            (mac 'cc-series-converges-to)
            (let ((hser (caddr (dk-goal))))
              (dk-have! (list 'IN hser '(FUN NN CC))
                (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                      (dk-cite! 'cc-series-partial-sum-in-cc j nser) (dk-ass!))))))
              (dk-have! (list 'FORALL 'gfn_ (list 'IMPLIES '(IN gfn_ NN) (list '= (list hser 'gfn_) (list 'gfp (list sq 'gfn_)))))
                (lambda ()
                  (let ((j (dk-di-var!)))
                    (dk-lam-b!)
                    (bgf-cite2! 'bgf-psi-nsum j 'a 'gfp w nser)
                    (dk-ass!))))
              (bgf-cite2! 'bgf-psi-conv 'a 'gfp sq V hser)
              (dk-ass!))))
        (dk-split-all! (list (bgf-cite2! 'cc-series-limit-of-converges-to nser (list 'gfp V))))
        (subst (list '= nl (list 'gfp V)))))
    ;; ---- the value: psi((z(1 - w))^-1) = z^-1 psi((1 - w)^-1)
    (dk-cite! 'brv-shift-factor 'a 'x 'z)
    (subst (list '= '(SHIFT-EL a z x) (bgf-ac 'z om)))
    (dk-cite! 'brv-act-inverse 'a 'z om)
    (subst (list '= (bgf-inv (bgf-ac 'z om)) (bgf-ac zr V)))
    (dk-cite! 'bsn-cl-act 'a 'gfp zr V)
    (subst (list '= (list 'gfp (bgf-ac zr V)) (list '* zr (list 'gfp V))))
    (bgf-cc! (list 'gfp V))
    (crs)))
(bgf-qed! 'bgf-laurent-resolvent)


;;; =============================================================================================
;;; THE RESOLVENT SET AND THE CIRCLES
(define bgf-U '(DIFFERENCE CC (SPECTRUM a x)))
(define bgf-sep-sigma '(SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))
(define (bgf-tr r) (list 'TRACE (list 'CIRCLE-PATH 0 r) 0 '(* 2 PI)))
(define (bgf-R y) (bgf-inv (list 'SHIFT-EL 'a y 'x)))
;;; with (IN y U) in context: land (IN y CC) and (IS-INVERTIBLE-EL a (SHIFT-EL a y x))
(define (bgf-off-spectrum! y)
  (let ((hy (list 'IN y bgf-U)))
    (dk-project! (list 'IN y 'CC) (lambda () (mac-h 'difference-membership hy)))
    (let ((nsig (dk-project! (list 'NOT (list 'IN y '(SPECTRUM a x))) (lambda () (mac-h 'difference-membership hy))))
          (inv (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a y 'x))))
      (fact 'bas-spectrum-unfold 'a 'x)
      (dk-have! inv
        (lambda ()
          (use-em inv
            (lambda () (dk-ass!))
            (lambda ()
              (dk-have! (list 'IN y '(SPECTRUM a x))
                (lambda ()
                  (subst (list '= '(SPECTRUM a x) bgf-sep-sigma))
                  (in-sep! (lambda () (dk-ass!)))))
              (ai (list 'NOT (list 'IN y '(SPECTRUM a x))))))))
      inv)))
;;; with (IN y CC) and the shift at y invertible in context: land (IN y U)
(define (bgf-in-u! y)
  (let ((goal (list 'IN y bgf-U)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (mac 'difference-membership)
            (dk-conj-close!
              (lambda ()
                (cond
                  ((dk-ass!) #t)
                  (#t
                   (di)
                   (fact 'bas-spectrum-unfold 'a 'x)
                   (let ((m1 (dk-rewrite-h! (list 'IN y '(SPECTRUM a x)) '(SPECTRUM a x) bgf-sep-sigma)))
                     (dk-project! (list 'NOT (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a y 'x)))
                                  (lambda () (sep-me m1)))
                     (ai (list 'NOT (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a y 'x))))))))))))
    goal))
(define (bgf-minus-zero! y)
  (let ((e (list '= (list '- y 0) y)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mac 'binary-minus-def) (crs))))
    e))
;;; with (IN v (TRACE (CIRCLE-PATH 0 r) 0 (* 2 PI))), 0 < r in context: land (IN v CC), (= (magnitude v) r)
(define (bgf-on-circle! v r)
  (dk-cite! 'cc-zero-in)
  (let ((r1 (list '+ r 1)))
    (bgf-rr! r1)
    (bgf-lin! (list '< r r1) (list '< 0 r))
    (let* ((h (bgf-cite2! 'circle-trace-in-punctured-ball 0 r r1))
           (hv (dk-apply! h v))
           (hb (list 'IN v (list 'BALL 'CC-MS 0 r1))))
      (dk-split-all! (list hv))
      (dk-project! (list 'IN v 'CC) (lambda () (mac-h 'cc-ms-ball-membership hb)))
      (bgf-lin! (list '<= 0 r) (list '< 0 r))
      (let* ((hm (dk-apply! (bgf-cite2! 'circle-trace-magnitude 0 r) v)))
        (bgf-minus-zero! v)
        (dk-rewrite-h! hm (list '- v 0) v)
        (list '= (list 'magnitude v) r)))))
;;; with the annulus hypothesis HS (shifts invertible for s <= |z|) and s <= r, 0 < r: (SUBSET trace_r U)
(define (bgf-trace-in-u! hs r)
  (let ((goal (list 'SUBSET (bgf-tr r) bgf-U)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (mac 'subset-def)
            (let ((v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
              (bgf-on-circle! v r)
              (bgf-rr! (list 'magnitude v))
              (bgf-lin! (list '<= 's (list 'magnitude v)) (list '= (list 'magnitude v) r) (list '<= 's r))
              (dk-apply! hs v)
              (dk-close-if! (lambda () (bgf-in-u! v)) (lambda () (dk-ass!)))))))
    goal))
(define (bgf-trace-set! r)
  (dk-cite! 'rr-zero-in)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  (bgf-rr! '(* 2 PI))
  (dk-cite! 'trace-is-set (list 'CIRCLE-PATH 0 r) 0 '(* 2 PI))
  (dk-ass!))
(define bgf-Hs '(FORALL z (IMPLIES (IN z CC) (IMPLIES (<= s (magnitude z)) (IS-INVERTIBLE-EL a (SHIFT-EL a z x))))))

;;; =============================================================================================
;;; (B) for each bounded functional: |psi(x^n)| <= s^(n+1) M, M a bound of ||(z 1 - x)^-1|| on |z| = s
(sp (bgf-st (list 'FORALL 'gfp (list 'IMPLIES '(IS-CC-LINEAR-ON a gfp) (list 'IMPLIES bgf-Hb
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
    (list 'IMPLIES bgf-Hs
     '(FORALL bm (IMPLIES (IN bm RR) (IMPLIES (<= 0 bm)
       (IMPLIES (FORALL z (IMPLIES (IN z CC) (IMPLIES (= (magnitude z) s) (<= ((VNRM a) (INVERSE-EL a (SHIFT-EL a z x))) bm))))
         (FORALL n (IMPLIES (IN n NN) (<= (magnitude (gfp (EL-POW a x n))) (* (* s (POWER s n)) bm)))))))))))))))))))
(dk-peel!)
(dk-cite! 'bsn-cl-fun 'a 'gfp)
(dk-cite! 'cc-zero-in)
(let* ((hs (dk-ctx-form bgf-Hs))
       (hbm (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'bm h))) "the bound on the circle"))
       (U bgf-U)
       (hopen (dk-cite! 'resolvent-set-open 'a 'x))
       (hinv (list 'FORALL 'bsz_ (list 'IMPLIES (list 'IN 'bsz_ U) '(IS-INVERTIBLE-EL a (SHIFT-EL a bsz_ x))))))
  (dk-have! hinv (lambda () (let ((y (dk-di-var!))) (dk-close-if! (lambda () (bgf-off-spectrum! y)) (lambda () (dk-ass!))))))
  (let* ((hol (bgf-cite2! 'resolvent-functional-holomorphic 'a 'x 'gfp U))
         (f (caddr hol))
         (gfc (dk-skolem! (bgf-cite2! 'bgf-coef-family 'a 'gfp 'x) #t))
         (hz0 (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? gfc h) (equal? (caddr (caddr (caddr h))) 0))) "c = 0"))
         (hneg (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? gfc h) (bgf-occurs? 'EL-POW h))) "c neg"))
         (nx (bgf-rr! (bgf-nr 'x)))
         (t (list '+ nx 1)) (bigs (list '+ 's t))
         (mk (bgf-zz-neg-succ! 'n)) (xn (bgf-p 'x 'n)))
    (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
    (bgf-rr! t) (bgf-rr! bigs)
    (bgf-lin! (list '< 0 t) (list '<= 0 nx))
    (bgf-lin! (list '< t bigs) (list '< 0 's))
    (bgf-lin! (list '< 's bigs) (list '< 0 t))
    (bgf-lin! (list '< 0 bigs) (list '< 0 's) (list '< 0 t))
    (bgf-lin! (list '<= 's bigs) (list '< 's bigs))
    (bgf-lin! (list '<= 's 's))
    (bgf-trace-in-u! hs bigs)
    (bgf-trace-in-u! hs 's)
    ;; ---- the radii of the two halves of the family
    (let ((cfp (list 'VNB-LAMBDA 'lak_ 'NN (list gfc 'lak_)))
          (cfn (list 'VNB-LAMBDA 'lak_ 'NN (list gfc '(- (+ lak_ 1)))))
          (q1 (list '+ bigs 1)) (q2 (list 'recip t)))
      (bgf-rr! q1)
      (bgf-lin! (list '< 0 q1) (list '< 0 bigs))
      (bgf-lin! (list '< bigs q1))
      (bgf-nonzero! q1) (bgf-cite2! 'rr-recip-closed q1)
      (bgf-nonzero! t) (bgf-cite2! 'rr-recip-closed t) (dk-cite! 'rr-recip-pos t)
      (bgf-nonzero! bigs) (bgf-cite2! 'rr-recip-closed bigs)
      (dk-have! (list 'IN cfp '(FUN NN CC))
        (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (dk-cite! 'nn-subset-zz j)
                                              (bgf-cc! (list gfc j)) (dk-ass!))))))
      (dk-have! (list 'IN cfn '(FUN NN CC))
        (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (mj (bgf-zz-neg-succ! j)))
                                              (bgf-cc! (list gfc mj)) (dk-ass!))))))
      (dk-have! (list 'FORALL 'lrk_ (list 'IMPLIES '(IN lrk_ NN)
                  (list '<= (list 'magnitude (list cfp 'lrk_)) (list '* 0 (list 'POWER (list 'recip q1) 'lrk_)))))
        (lambda ()
          (let* ((k (dk-di-var!)) (pw (list 'POWER (list 'recip q1) k)))
            (dk-cite! 'nn-subset-zz k)
            (dk-lam-b!)
            (dk-apply! hz0 k)
            (subst (list '= (list gfc k) 0))
            (dk-cite! 'cc-magnitude-zero)
            (subst '(= (magnitude 0) 0))
            (bgf-rr! pw)
            (dk-cite! 'rr-zero-mul pw)
            (subst (list '= (list '* 0 pw) 0))
            (dk-ineq!))))
      (dk-have! (list 'FORALL 'lrk_ (list 'IMPLIES '(IN lrk_ NN)
                  (list '<= (list 'magnitude (list cfn 'lrk_)) (list '* 1 (list 'POWER (list 'recip q2) 'lrk_)))))
        (lambda ()
          (let* ((k (dk-di-var!)) (mj (bgf-zz-neg-succ! k)) (xk (bgf-p 'x k))
                 (tk (list 'POWER t k)) (nk (list 'POWER nx k)))
            (dk-lam-b!)
            (dk-apply! hneg k)
            (subst (list '= (list gfc mj) (list 'gfp xk)))
            (dk-cite! 'rr-recip-recip-pos t)
            (subst (list '= (list 'recip q2) t))
            (bgf-rr! tk)
            (dk-cite! 'rr-one-mul tk)
            (subst (list '= (list '* 1 tk) tk))
            (bgf-vt xk)
            (dk-apply! (dk-ctx-form bgf-Hb) xk)
            (dk-cite! 'bae-el-pow-norm k 'a 'x)
            (bgf-lin! (list '<= nx t))
            (dk-cite! 'rr-power-mono-base k nx t)
            (bgf-rr! (list 'magnitude (list 'gfp xk))) (bgf-rr! (bgf-nr xk)) (bgf-rr! nk)
            (dk-le-chain! (list 'magnitude (list 'gfp xk)) (bgf-nr xk) nk tk))))
      (dk-have! (list '< bigs (list 'CPS-RADIUS cfp))
        (lambda ()
          (let* ((h (dk-apply! (bgf-cite2! 'cps-radius-from-bound cfp 0 q1) bigs)))
            (if (dk-head-is? h 'IMPLIES) (detach! h))
            (dk-ass!))))
      (dk-have! (list '< (list 'recip bigs) (list 'CPS-RADIUS cfn))
        (lambda ()
          (bgf-cite2! 'baire-recip-lt t bigs)
          (dk-cite! 'rr-one-in)
          (bgf-lin! (list '<= 0 1))
          (let* ((h (dk-apply! (bgf-cite2! 'cps-radius-from-bound cfn 1 q2) (list 'recip bigs))))
            (if (dk-head-is? h 'IMPLIES) (detach! h))
            (dk-ass!)))))
    ;; ---- psi(x^n) is the coefficient of z^-(n+1) on the circle of radius S
    (let* ((cS (dk-apply! (bgf-cite2! 'laurent-coefficients gfc 0 bigs) 'n))
           (ceqS (begin (dk-split-all! (list cS))
                        (bgf-find (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) (list gfc mk)))) "the S coefficient")))
           (L1 (cadr (caddr (caddr ceqS))))
           (iS (dk-apply! (bgf-cite2! 'laurent-coef-integrands U f 0 bigs) 'n))
           (iSs (begin (dk-split-all! (list iS)) #t))
           (eqS (bgf-find (lambda (h) (and (dk-head-is? h '=) (pair? (cadr h))
                                            (equal? (cadr h) (list (list 'LAURENT-COEFS f 0 bigs) mk)))) "the S integrand eq"))
           (L2 (cadr (caddr (caddr eqS))))
           (TS (caddr L1)))
      (dk-fun-ext! L1 L2 TS 'CC
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((v (dk-di-var!)))
                (bgf-on-circle! v bigs)
                (bgf-rr! (list 'magnitude v))
                (bgf-lin! (list '< nx (list 'magnitude v)) (list '= (list 'magnitude v) bigs) (list '< t bigs))
                (bgf-lin! (list '<= 's (list 'magnitude v)) (list '= (list 'magnitude v) bigs) (list '< 's bigs))
                (dk-apply! hs v)
                (bgf-cite2! 'bgf-laurent-resolvent 'a 'gfp 'x gfc v)
                (subst (list '= (list 'LAURENT-SUM gfc 0 v) (list 'gfp (bgf-R v))))
                (bgf-minus-zero! v)
                (subst (list '= (list '- v 0) v))
                (bgf-vt (bgf-R v))
                (bgf-cc! (list '* (list 'gfp (bgf-R v)) (list 'POWER v 'n)))
                (dk-ass!)))
            (lambda () (bgf-trace-set! bigs))))
        #f
        (lambda (v)
          (bgf-on-circle! v bigs)
          (bgf-rr! (list 'magnitude v))
          (bgf-lin! (list '< nx (list 'magnitude v)) (list '= (list 'magnitude v) bigs) (list '< t bigs))
          (bgf-lin! (list '<= 's (list 'magnitude v)) (list '= (list 'magnitude v) bigs) (list '< 's bigs))
          (dk-apply! hs v)
          (bgf-in-u! v)
          (dk-lam-b!)
          (bgf-cite2! 'bgf-laurent-resolvent 'a 'gfp 'x gfc v)
          (subst (list '= (list 'LAURENT-SUM gfc 0 v) (list 'gfp (bgf-R v))))
          (bgf-vt (bgf-R v))
          (bgf-minus-zero! v)
          (bgf-cc! v)
          (bgf-cc! (list '* (list 'gfp (bgf-R v)) (list 'POWER (list '- v 0) 'n)))
          (rfl)))
      (let* ((ceqS2 (dk-rewrite-h! ceqS L1 L2))
             (hann (list 'FORALL 'lxb_ (list 'IMPLIES '(IN lxb_ CC) (list 'IMPLIES '(<= s (magnitude (- lxb_ 0)))
                     (list 'IMPLIES (list '<= '(magnitude (- lxb_ 0)) bigs) (list 'IN 'lxb_ U)))))))
        (dk-have! hann
          (lambda ()
            (let ((y (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
              (bgf-minus-zero! y)
              (let ((h1 (bgf-find (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) 's))) "s <= |y - 0|")))
                (dk-rewrite-h! h1 (list '- y 0) y))
              (dk-apply! hs y)
              (dk-close-if! (lambda () (bgf-in-u! y)) (lambda () (dk-ass!))))))
        (let* ((rf (dk-apply! (bgf-cite2! 'laurent-coef-radius-free U f 0 's bigs) 'n))
               (rfs (begin (dk-split-all! (list rf)) #t))
               (ints (dk-apply! (bgf-cite2! 'laurent-coef-integrands U f 0 's) 'n))
               (intss (begin (dk-split-all! (list ints)) #t))
               (eqs (bgf-find (lambda (h) (and (dk-head-is? h '=)
                                               (equal? (cadr h) (list (list 'LAURENT-COEFS f 0 's) mk)))) "the s integrand eq"))
               (L2s (cadr (caddr (caddr eqs))))
               (li-small (caddr (caddr eqs))) (li-big (caddr (caddr ceqS2)))
               (hsup (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ (bgf-tr 's))
                        (list '<= (list 'magnitude (list f 'aiy_)) 'bm)))))
          (dk-have! hsup
            (lambda ()
              (let ((y (dk-di-var!)))
                (bgf-on-circle! y 's)
                (dk-cite! 'subset-mem-fwd (bgf-tr 's) U y)
                (dk-lam-b!)
                (dk-apply! hbm y)
                (bgf-off-spectrum! y)
                (bgf-vt (bgf-R y))
                (dk-apply! (dk-ctx-form bgf-Hb) (bgf-R y))
                (bgf-rr! (list 'magnitude (list 'gfp (bgf-R y)))) (bgf-rr! (bgf-nr (bgf-R y)))
                (dk-le-chain! (list 'magnitude (list 'gfp (bgf-R y))) (bgf-nr (bgf-R y)) 'bm))))
          (let* ((sb (dk-apply! (dk-apply! (bgf-cite2! 'laurent-coef-sup-bound U f 0 's) 'bm) 'n)))
            (if (dk-head-is? sb 'IMPLIES) (detach! sb))
            (dk-split-all! (list (or (dk-ctx-form (if (dk-head-is? sb 'IMPLIES) (caddr sb) sb)) sb)))
            (dk-apply! hneg 'n)
            (subst (list '= (list 'gfp xn) (list gfc mk)))
            (subst (list '= (list gfc mk) (caddr ceqS2)))
            (subst (list '= li-big li-small))
            (subst (list '= (caddr eqs) (cadr eqs)))
            (dk-ass!)))))))
(bgf-qed! 'bgf-functional-estimate)


;;; =============================================================================================
;;; (R) the reverse triangle inequality for the norm of the algebra
(define (bgf-det! h)
  (if (dk-head-is? h 'IMPLIES)
      (bgf-det! (detach-with! h (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
      h))
(define (bgf-cancel! p q)          ; land (= (VADD (p - q) q) p)
  (let ((e (list '= (bgf-ad (bgf-sb p q) q) p)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (bgf-vt p) (bgf-vt q) (bgf-vt bgf-zero)
            (dk-cite! 'ring-neg-zero-uba-as-ring 'a)
            (dk-cite! 'ring-add-right-id-uba-as-ring 'a p)
            (dk-cite! 'ring-add-right-id-uba-as-ring 'a q)
            (let* ((h0 (dk-cite! 'ban-telescope 'a p q bgf-zero))
                   (rw (lambda (h from to) (if (bgf-occurs? from h) (dk-rewrite-h! h from to) h)))
                   (h1 (rw h0 (bgf-ng bgf-zero) bgf-zero))
                   (h2 (rw h1 (bgf-ad q bgf-zero) q))
                   (h3 (rw h2 (bgf-ad p bgf-zero) p)))
              (dk-ass!)))))
    e))
(define (bgf-tri-half! p q)        ; land (<= ||p|| (+ ||p - q|| ||q||))
  (bgf-vt p) (bgf-vt q) (bgf-vt (bgf-sb p q))
  (bgf-cancel! p q)
  (let ((t0 (dk-cite! 'bal-uba-vnrm-triangle 'a (bgf-sb p q) q)))
    (dk-rewrite-h! t0 (bgf-ad (bgf-sb p q) q) p)))
(sp (bgf-st '(FORALL gfu (IMPLIES (IN gfu (VEC a)) (FORALL gfv (IMPLIES (IN gfv (VEC a))
  (<= (abs (- ((VNRM a) gfu) ((VNRM a) gfv))) ((VNRM a) ((VADD a) gfu ((VNEG a) gfv))))))))))
(dk-peel!)
(let* ((nu (bgf-rr! (bgf-nr 'gfu))) (nv (bgf-rr! (bgf-nr 'gfv)))
       (duv (bgf-rr! (bgf-nr (bgf-sb 'gfu 'gfv)))) (dvu (bgf-rr! (bgf-nr (bgf-sb 'gfv 'gfu))))
       (d (bgf-rr! (list '- nu nv))) (md (bgf-rr! (list '- duv))))
  (bgf-tri-half! 'gfu 'gfv)
  (bgf-tri-half! 'gfv 'gfu)
  (dk-cite! 'ban-dist-sym 'a 'gfu 'gfv)
  (bgf-lin! (list '<= d duv) (list '<= nu (list '+ duv nv)))
  (bgf-lin! (list '<= md d) (list '<= nv (list '+ dvu nu)) (list '= duv dvu))
  (bgf-cite2! 'rr-abs-le-of-parts d duv)
  (dk-ass!))
(bgf-qed! 'bgf-vnrm-reverse)

;;; =============================================================================================
;;; (C) the resolvent is bounded on each circle |z| = s lying in the resolvent set
(define (bgf-hinv!)
  (let ((hinv (list 'FORALL 'bsz_ (list 'IMPLIES (list 'IN 'bsz_ bgf-U) '(IS-INVERTIBLE-EL a (SHIFT-EL a bsz_ x))))))
    (if (not (dk-asm? hinv))
        (dk-have! hinv (lambda () (let ((y (dk-di-var!))) (dk-close-if! (lambda () (bgf-off-spectrum! y)) (lambda () (dk-ass!)))))))
    hinv))
(define (bgf-mag-real! t)          ; t real, 0 <= t in context: land (= (magnitude t) t)
  (let ((e (list '= (list 'magnitude t) t)))
    (if (not (dk-asm? e))
        (begin
          (dk-cite! 'rr-magnitude-is-abs t)
          (bgf-cite2! 'rr-abs-of-nonneg t)
          (dk-have! e (lambda () (subst (list '= (list 'magnitude t) (list 'abs t))) (dk-ass!)))))
    e))
(define (bgf-on-trace! v r)        ; v in CC, (= (magnitude v) r), 0 < r in context: land v in trace_r
  (let ((goal (list 'IN v (bgf-tr r))))
    (if (not (dk-asm? goal))
        (begin
          (bgf-minus-zero! v)
          (dk-have! (list '= (list 'magnitude (list '- v 0)) r)
            (lambda () (subst (list '= (list '- v 0) v)) (dk-ass!)))
          (dk-cite! 'cc-zero-in)
          (bgf-det! (dk-apply! (bgf-cite2! 'circle-trace-of-magnitude 0 r) v))))
    goal))
(define (bgf-detach-lane! ch body)
  (let ((ante (cadr ch)))
    (dk-have! ante body)
    (detach! ch)))
(define bgf-g '(VNB-LAMBDA gfw_ (DIFFERENCE CC (SPECTRUM a x)) ((VNRM a) (INVERSE-EL a (SHIFT-EL a gfw_ x)))))
(define (bgf-g-value! w)           ; w in U in context: land (= (g w) ||R(w)||)
  (let ((e (list '= (list bgf-g w) (bgf-nr (bgf-R w)))))
    (if (not (dk-asm? e))
        (begin
          (bgf-vt (bgf-R w)) (bgf-rr! (bgf-nr (bgf-R w)))
          (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl))))))
    e))
(sp (bgf-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
  (list 'IMPLIES bgf-Hs
   '(FORSOME bm (AND (IN bm RR) (AND (<= 0 bm)
      (FORALL z (IMPLIES (IN z CC) (IMPLIES (= (magnitude z) s) (<= ((VNRM a) (INVERSE-EL a (SHIFT-EL a z x))) bm)))))))))))))))
(dk-peel!)
(dk-cite! 'cc-zero-in)
(let* ((hs (dk-ctx-form bgf-Hs)) (U bgf-U) (g bgf-g) (kk (bgf-tr 's))
       (cms '(SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) (DIFFERENCE CC (SPECTRUM a x)))))
  (bgf-hinv!)
  (dk-cite! 'difference-subset 'CC '(SPECTRUM a x))
  (dk-have! (list 'IN g (list 'FUN U 'CC))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((w (dk-di-var!)))
            (bgf-off-spectrum! w)
            (bgf-rr! (bgf-nr (bgf-R w)))
            (dk-cite! 'rr-subset-cc (bgf-nr (bgf-R w)))
            (dk-ass!)))
        (lambda ()
          (dk-cite! 'cc-is-set)
          (bgf-cite2! 'difference-set 'CC '(SPECTRUM a x))
          (dk-ass!)))))
  ;; ---- g is continuous on U
  (dk-have! (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ U)
              (list 'IS-CONTINUOUS-AT cms '(NF-METRIC-SPACE CC-NORMED-FIELD) g 'rgy_)))
    (lambda ()
      (let* ((y (dk-di-var!))
             (ch (dk-cite! 'cc-continuous-at-of-modulus U g y)))
        (bgf-off-spectrum! y)
        (bgf-detach-lane! ch
          (lambda ()
            (let* ((eps (cadr (dk-goal))))
              (dk-peel!)
              (dk-cite! 'rr-pos-rr-in-rr eps)
              (let* ((del (dk-skolem! (bgf-cite2! 'resolvent-continuous 'a 'x y eps) #t))
                     (hres (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? del h)
                                                      (bgf-occurs? 'INVERSE-EL h))) "the resolvent modulus")))
                (dk-cite! 'rr-pos-rr-in-rr del)
                (ew del)
                (dk-have! (caddr (dk-goal))
                  (lambda ()
                    (let ((b (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                      (bgf-off-spectrum! b)
                      (let* ((eqm (list '= (list '- b y) (list '+ b (list '- y)))))
                        (dk-have! eqm (lambda () (mac 'binary-minus-def) (crs)))
                        (let* ((hl (bgf-find (lambda (h) (and (dk-head-is? h '<) (equal? (cadr h) (list 'magnitude (list '- b y)))))
                                             "|b - y| < del"))
                               (hl2 (dk-rewrite-h! hl (list '- b y) (list '+ b (list '- y)))))
                          (bgf-rr! (list 'magnitude (list '+ b (list '- y))))
                          (bgf-lin! (list '<= (list 'magnitude (list '+ b (list '- y))) del) hl2)
                          (dk-split-all! (list (dk-apply! hres b)))
                          (let* ((nb (bgf-nr (bgf-R b))) (ny (bgf-nr (bgf-R y)))
                                 (d (list '- nb ny)) (dr (bgf-sb (bgf-R b) (bgf-R y))))
                            (bgf-g-value! b) (bgf-g-value! y)
                            (subst (list '= (list g b) nb))
                            (subst (list '= (list g y) ny))
                            (bgf-vt (bgf-R b)) (bgf-vt (bgf-R y))
                            (bgf-rr! d) (bgf-rr! (list 'abs d)) (bgf-rr! (bgf-nr dr))
                            (dk-cite! 'rr-magnitude-is-abs d)
                            (subst (list '= (list 'magnitude d) (list 'abs d)))
                            (bgf-cite2! 'bgf-vnrm-reverse 'a (bgf-R b) (bgf-R y))
                            (dk-le-chain! (list 'abs d) (bgf-nr dr) eps)))))))
                (dk-conj-close! (lambda () (dk-ass!)))))))
        (dk-ass!))))
  ;; ---- the circle is a compact subset of U
  (bgf-lin! '(<= s s))
  (bgf-lin! '(<= 0 s) '(< 0 s))
  (bgf-trace-in-u! hs 's)
  (dk-cite! 'circle-is-road 0 's)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  (bgf-rr! '(* 2 PI))
  (bgf-cite2! 'is-road-is-path '(CIRCLE-PATH 0 s) '(CIRCLE-DERIV 0 s) 0 '(* 2 PI))
  (bgf-cite2! 'path-trace-compact '(CIRCLE-PATH 0 s) 0 '(* 2 PI))
  (dk-cite! 'rr-subset-cc 's)
  (bgf-mag-real! 's)
  (bgf-on-trace! 's 's)
  (let* ((h1 (bgf-cite2! 'cc-compact-modulus-max U))
         (h2 (bgf-det! (dk-apply! h1 g)))
         (h3 (bgf-det! (dk-apply! h2 kk)))
         (h4 (bgf-det! (dk-apply! h3 's)))
         (p (dk-skolem! h4 #t))
         (hmax (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? p h) (bgf-occurs? 'magnitude h))) "the max"))
         (bm (bgf-nr (bgf-R p))))
    (bgf-cite2! 'subset-mem-fwd kk U p)
    (bgf-off-spectrum! p)
    (bgf-vt (bgf-R p))
    (bgf-rr! bm)
    (dk-cite! 'bal-uba-vnrm-nonneg 'a (bgf-R p))
    (bgf-g-value! p)
    (bgf-mag-real! bm)
    (ew bm)
    (dk-have! (caddr (caddr (dk-goal)))
      (lambda ()
        (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
          (bgf-on-trace! z 's)
          (bgf-cite2! 'subset-mem-fwd kk U z)
          (bgf-off-spectrum! z)
          (bgf-vt (bgf-R z))
          (bgf-rr! (bgf-nr (bgf-R z)))
          (dk-cite! 'bal-uba-vnrm-nonneg 'a (bgf-R z))
          (bgf-g-value! z)
          (bgf-mag-real! (bgf-nr (bgf-R z)))
          (let* ((m0 (dk-apply! hmax z))
                 (m1 (dk-rewrite-h! m0 (list g z) (bgf-nr (bgf-R z))))
                 (m2 (dk-rewrite-h! m1 (list g p) bm))
                 (m3 (dk-rewrite-h! m2 (list 'magnitude (bgf-nr (bgf-R z))) (bgf-nr (bgf-R z))))
                 (m4 (dk-rewrite-h! m3 (list 'magnitude bm) bm)))
            (dk-ass!)))))
    (dk-conj-close! (lambda () (dk-ass!)))))
(bgf-qed! 'bgf-resolvent-circle-bound)


;;; =============================================================================================
;;; (D) the same bound for the norm itself, through the norming functional of x^n (Hahn-Banach)
(sp (bgf-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
  (list 'IMPLIES bgf-Hs
