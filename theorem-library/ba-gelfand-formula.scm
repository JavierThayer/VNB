        (let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
          (sep-me (list 'IN r ss))
          (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
            (dk-split-all!)
