(define (bgf-nonzero! t)          ; (< 0 t) in context: land (NOT (= t 0))
  (let ((f (list 'NOT (list '= t 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))))
    f))
(define (bgf-zz-neg-succ! k)      ; k in NN: land (IN (- (+ k 1)) ZZ) and (IN (- (+ k 1)) RR)
  (let ((m (list '- (list '+ k 1))))
    (dk-cite! 'nn-subset-zz k)
    (dk-cite! 'zz-one-in)
    (bgf-cite2! 'zz-add-closed k 1)
    (dk-cite! 'zz-neg-closed (list '+ k 1))
    (dk-cite! 'zz-in-rr m)
    m))

