            (bgf-lin! (list '<= 0 r) (list '= r (bgf-rt k)) (list '<= 0 (bgf-rt k)))
            (dk-cite! 'rmc-rps-of-nonneg r)
            (dk-ass!)))))))
(sp (bgf-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (<= (SPECTRAL-RADIUS a x) (RPOW-STAR ((VNRM a) (EL-POW a x n)) (RECIP-STAR n))))))))))
(dk-peel!)
(let* ((ss (bgf-ss)) (lv (list 'EINF ss)) (rho '(SPECTRAL-RADIUS a x)))
