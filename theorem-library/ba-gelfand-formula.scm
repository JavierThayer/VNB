;;; =============================================================================================
;;; (A2) psi of a Neumann partial sum is the partial sum of the psi(y^k)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL gfp (IMPLIES (IS-CC-LINEAR-ON a gfp) (FORALL y (IMPLIES (IN y (VEC a))
    (FORALL gfh (IMPLIES (IN gfh (FUN NN CC))
      (IMPLIES (FORALL gfk_ (IMPLIES (IN gfk_ NN) (= (gfh gfk_) (gfp (EL-POW a y gfk_)))))
        (= (CC-SERIES-PARTIAL-SUM gfh n) (gfp (NEUMANN-SUM a y n))))))))))))))))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (fact 'cc-series-partial-sum-zero 'gfh)
  (subst '(== (CC-SERIES-PARTIAL-SUM gfh 0) 0))
  (fact 'NEUMANN-SUM-zero 'a 'y)
  (subst (list '== (bgf-s 'y 0) bgf-zero))
  (dk-cite! 'bgf-psi-zero 'a 'gfp)
  (subst '(= (gfp (VZERO a)) 0))
  (rfl)
  (dk-focus! step)
  (dk-peel!)
  (let* ((sv (bgf-s 'y v)) (pv (bgf-p 'y v)) (hk (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'gfh h)
                                                                              (bgf-occurs? 'EL-POW h))) "the pointwise hyp")))
    (dk-cite! 'bsn-cl-fun 'a 'gfp)
    (bgf-vt sv) (bgf-vt pv)
    (fact 'NEUMANN-SUM-succ 'a 'y v)
    (subst (list '== (bgf-s 'y (list 'succ v)) (bgf-ad sv pv)))
    (dk-cite! 'bsn-cl-add 'a 'gfp sv pv)
    (subst (list '= (list 'gfp (bgf-ad sv pv)) (list '+ (list 'gfp sv) (list 'gfp pv))))
    (dk-cite! 'cc-series-partial-sum-in-cc v 'gfh)
    (dk-cite! 'fun-apply-type-c 'gfh 'NN 'CC v)
    (bgf-cite2! 'cc-series-partial-sum-succ 'gfh v)
    (subst (list '== (list 'CC-SERIES-PARTIAL-SUM 'gfh (list 'succ v))
                 (list '+ (list 'CC-SERIES-PARTIAL-SUM 'gfh v) (list 'gfh v))))
    (let ((ihv (apply dk-apply! ih (list 'y 'gfh))))
      (let loop ((f ihv))
        (if (dk-head-is? f 'IMPLIES)
            (begin (detach! f) (loop (dk-ctx-form (caddr f)))))))
    (subst (list '= (list 'CC-SERIES-PARTIAL-SUM 'gfh v) (list 'gfp sv)))
    (dk-apply! hk v)
    (subst (list '= (list 'gfh v) (list 'gfp pv)))
    (rfl)))
(bgf-qed! 'bgf-psi-nsum)

