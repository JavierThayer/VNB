;;; (A3) a bounded functional carries norm convergence to convergence in CC
(sp (bgf-st (list 'FORALL 'gfp (list 'IMPLIES '(IS-CC-LINEAR-ON a gfp) (list 'IMPLIES bgf-Hb
  '(FORALL gfs (IMPLIES (IN gfs (FUN NN (VEC a))) (FORALL gfl (IMPLIES (IN gfl (VEC a))
     (IMPLIES (CONVERGES-TO (BA-METRIC-SPACE a) gfs gfl)
       (FORALL gfh (IMPLIES (IN gfh (FUN NN CC))
         (IMPLIES (FORALL gfn_ (IMPLIES (IN gfn_ NN) (= (gfh gfn_) (gfp (gfs gfn_)))))
           (CONVERGES-TO CC-MS gfh (gfp gfl)))))))))))))))
(dk-peel!)
(dk-cite! 'bsn-cl-fun 'a 'gfp)
(dk-cite! 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (dk-close-if! (lambda () (slot 'PTS)) qrfl)))
(dk-cite! 'ban-pts 'a)
(let* ((hc '(CONVERGES-TO (BA-METRIC-SPACE a) gfs gfl))
       (heps (begin (mac-h 'converges-to hc) (dk-split-all!)
                    (bgf-find (lambda (f) (and (dk-head-is? f 'FORALL) (bgf-occurs? 'POS-RR f))) "the eps clause")))
       (hk (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? 'gfh h) (bgf-occurs? 'gfs h))) "pointwise")))
  (bgf-cc! '(gfp gfl))
  (mac 'converges-to)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((and (dk-head-is? (dk-goal) 'IN) (equal? (caddr (dk-goal)) '(PTS CC-MS)))
         (subst '(= (PTS CC-MS) CC)) (dk-ass!))
        ((and (dk-head-is? (dk-goal) 'IN) (equal? (caddr (dk-goal)) '(FUN NN (PTS CC-MS))))
         (subst '(= (PTS CC-MS) CC)) (dk-ass!))
        (#t
         (let* ((landed (dk-peel!))
                (eps (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) landed))))
                (nb (dk-skolem! (dk-apply! heps eps) #t))
                (hn (bgf-find (lambda (h) (and (dk-head-is? h 'FORALL) (bgf-occurs? nb h))) "the tail")))
           (ew nb)
           (dk-conj-close!
             (lambda ()
               (cond
                 ((dk-ass!) #t)
                 (#t
                  (let* ((landed2 (dk-peel!))
                         (m (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) landed2))))
                         (sm (list 'gfs m)) (hm (list 'gfh m))
                         (dv (bgf-sb sm 'gfl)))
                    (dk-cite! 'fun-apply-type-c 'gfs 'NN '(VEC a) m)
                    (dk-cite! 'fun-apply-type-c 'gfh 'NN 'CC m)
                    (dk-split-all! (list (dk-apply! hn m)))
                    (dk-cite! 'ban-dist 'a sm 'gfl)
                    (bgf-vt dv)
                    (dk-apply! (dk-ctx-form bgf-Hb) dv)
                    (dk-cite! 'cc-ms-dist hm '(gfp gfl))
                    (subst (list '= (list '(DIST CC-MS) hm '(gfp gfl)) (list 'MAGNITUDE (list '- hm '(gfp gfl)))))
                    (dk-apply! hk m)
                    (subst (list '= hm (list 'gfp sm)))
                    (dk-cite! 'bsn-cl-add 'a 'gfp sm (bgf-ng 'gfl))
                    (dk-cite! 'bsn-psi-neg 'a 'gfp 'gfl)
                    (bgf-cc! (list 'gfp sm))
                    (dk-cite! 'binary-minus-def (list 'gfp sm) '(gfp gfl))
                    (subst (list '= (list '- (list 'gfp sm) '(gfp gfl)) (list '+ (list 'gfp sm) (list '- '(gfp gfl)))))
                    (subst (list '= (list '- '(gfp gfl)) (list 'gfp (bgf-ng 'gfl))))
                    (subst (list '= (list '+ (list 'gfp sm) (list 'gfp (bgf-ng 'gfl))) (list 'gfp dv)))
                    (let ((pe (list 'MAGNITUDE (list 'gfp dv))) (ne (bgf-nr dv)))
                      (bgf-rr! pe) (bgf-rr! ne) (dk-cite! 'rr-pos-rr-in-rr eps)
                      (dk-have! (list '<= ne 'eps)
                        (lambda ()
                          (subst (list '= ne (list '(DIST (BA-METRIC-SPACE a)) sm 'gfl)))
                          (dk-ass!)))
                      (dk-le-chain! pe ne 'eps)))))))))))))
