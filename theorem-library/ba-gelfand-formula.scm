      (IMPLIES (FORALL z (IMPLIES (IN z CC) (IMPLIES (= (magnitude z) s) (<= ((VNRM a) (INVERSE-EL a (SHIFT-EL a z x))) bm))))
        (FORALL n (IMPLIES (IN n NN) (<= ((VNRM a) (EL-POW a x n)) (* (* s (POWER s n)) bm))))))))))))))))
(dk-peel!)
(let* ((xn (bgf-p 'x 'n)) (nx (bgf-nr xn)))
