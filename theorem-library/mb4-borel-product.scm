  (dk-rewrite-h! (list 'IN 'mpe_ (list 'BOREL-SETS mbp-prod)) (list 'BOREL-SETS mbp-prod) (caddr bu)))
(dk-rewrite-h! (list 'IN 'mpe_ (list 'SIGMA-GENERATED (list 'PTS mbp-prod) (mbk-gens mbp-prod))) (list 'PTS mbp-prod) mbp-cart)
(dk-cite! 'sigma-generated-in-every mbp-cart mbp-gens2 'mpe_ mbp-psig)
