;;; mb4-borel-product.scm -- construction of measures, Proposition 5.3: for separable metric spaces X, Y the
;;; Borel sets of X x Y (the max metric, PRODUCT2-MS) are the product sigma-algebra of the Borel sets (M-B4,
;;; 2026-10-26).  Library: measure.  Helper prefixes mbk- (kit copied from push-forward.scm) and mbp-.
;;;
;;;   mbp-rect-borel       A, B Borel  ==>  A x B is Borel in X x Y           (any metric spaces)
;;;   mbp-product-in-borel  PRODUCT-SIGMA(B_X, B_Y)  subset  B_{X x Y}        (any metric spaces)
;;;   mbp-open-in-product  X, Y separable: an open set of X x Y is in PRODUCT-SIGMA (a countable union of
;;;                        products of balls, indexed by NNPAIR)
;;;   borel-sets-product   (Prop 5.3) X, Y separable  ==>  B_{X x Y} = B_X (x) B_Y
;;;
;;; Load window: after theorem-library/push-forward (pfw-borel-preimage, pfw-borel-sigma-algebra,
;;; pfw-open-borel), theorem-library/product2-laws (product2-*), theorem-library/product-measure
;;; (product-sigma-*), the NNPAIR laws (nnfst-nnpair).

(define (mbk-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (mbk-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (mbk-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed
(define (mbk-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (mbk-map (lambda (c) (mbk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
;;; Proved as ONE conjunction on a lane (never in place: either part may be the focus goal).
(define (mbk-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mbk-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element
(define (mbk-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
;;; w in BIG-UNION(n_, NN, g(n_)) gives the index and w in g(index): returns (k . formula)
(define (mbk-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (w in the k-th term in context)
(define (mbk-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)
(define (mbk-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (mbk-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)
(define (mbk-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mbak_))
         (lam   (list 'VNB-LAMBDA 'mbak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mbak_ (list 'IMPLIES (list 'IN 'mbak_ dom)
                                                    (list '== (list g 'mbak_) body)))))
         (claim (list 'FORSOME 'mbag_ (list 'AND (list 'IN 'mbag_ (list 'FUN dom cod))
                                            (vals 'mbag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "mbk-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "mbk-abstract!: the value equation did not land"))))
      (cons g ve))))


(define (mbk-gens s) (list 'SEP 'mou_ (list 'POWER (list 'PTS s)) (list 'IS-OPEN s 'mou_)))
(define (mbk-gens-sub! s)
  (dk-have! (list 'SUBSET (mbk-gens s) (list 'POWER (list 'PTS s)))
    (lambda () (mac 'subset-def)
      (let ((uv (dk-di-var!)))
        (mbk-sep-parts! (list 'IN uv (mbk-gens s)))
        (ass)))))

(define (mbp-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define mbp-prod '(PRODUCT2-MS s t))
(define mbp-cart '(CARTESIAN (PTS s) (PTS t)))
(define (mbp-setup!)                       ; s, t metric spaces in context
  (dk-cite! 'product2-is-metric-space 's 't)
  (dk-cite! 'product2-pts 's 't)
  (fact 'ms-pts-is-set 's) (fact 'ms-pts-is-set 't))
;; A in Borel(m): A subset PTS(m), as a citable fact (A in POWER(PTS m))
(define (mbp-borel-pow! m a)
  (let ((g (list 'IN a (list 'POWER (list 'PTS m)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (let ((u (dk-cite! 'borel-sets-unfold m)))
              (dk-rewrite-h! (list 'IN a (list 'BOREL-SETS m)) (list 'BOREL-SETS m) (caddr u))
              (dk-cite! 'sigma-generated-in-power (list 'PTS m) (mbk-gens m) a)
              (mbp-close-open!)))))
    g))
;; the projection NTH i on the product, a continuous map: returns the lambda
(define (mbp-proj! i)
  (let* ((cod (if (= i 1) '(PTS s) '(PTS t)))
         (sp (if (= i 1) 's 't))
         (lam (list 'VNB-LAMBDA 'mpz_ mbp-cart (list 'NTH i 'mpz_))))
    (dk-have! (list 'IN lam (list 'FUN mbp-cart cod))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-split-all! (list (dk-cite! 'cartesian-nth z '(PTS s) '(PTS t)))) (mbp-close-open!))))))
    (dk-have! (list 'FORALL 'p2z_ (list 'IMPLIES (list 'IN 'p2z_ mbp-cart) (list '= (list lam 'p2z_) (list 'NTH i 'p2z_))))
      (lambda () (let ((z (dk-di-var!)))
                   (dk-split-all! (list (dk-cite! 'cartesian-nth z '(PTS s) '(PTS t))))
                   (dk-close-if! (lambda () (dk-lam-b!)) rfl))))
    (dk-cite! (if (= i 1) 'product2-fst-continuous-at 'product2-snd-continuous-at) 's 't lam)
    (let* ((iff (dk-cite! 'is-continuous mbp-prod sp lam)) (rhs (caddr iff)))
      (dk-have! rhs
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'IN) (subst (list '== (list 'PTS mbp-prod) mbp-cart)) (ass))
                    (#t (let ((a (dk-di-var!)))
                          (dk-rewrite-h! (list 'IN a (list 'PTS mbp-prod)) (list 'PTS mbp-prod) mbp-cart)
                          (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT) (dk-contains? f lam))) "continuity") a)
                          (mbp-close-open!))))))))
      (dk-have! (list 'IS-CONTINUOUS mbp-prod sp lam) (lambda () (dk-only! iff rhs) (prop))))
    lam))

;;; ----------------------------------------------------------------------
;;; (1) rectangles of Borel sets are Borel in the product
;;; ----------------------------------------------------------------------
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL t (IMPLIES (IS-METRIC-SPACE t)
  (FORALL mpa_ (IMPLIES (IN mpa_ (BOREL-SETS s)) (FORALL mpb_ (IMPLIES (IN mpb_ (BOREL-SETS t))
    (IN (CARTESIAN mpa_ mpb_) (BOREL-SETS (PRODUCT2-MS s t)))))))))))))
(dk-peel!)
(mbp-setup!)
(mbp-borel-pow! 's 'mpa_) (mbp-borel-pow! 't 'mpb_)
(let* ((p1 (mbp-proj! 1)) (p2 (mbp-proj! 2))
       (pre1 (list 'SEP 'pwx_ (list 'PTS mbp-prod) (list 'IN (list p1 'pwx_) 'mpa_)))
       (pre2 (list 'SEP 'pwx_ (list 'PTS mbp-prod) (list 'IN (list p2 'pwx_) 'mpb_)))
       (rect '(CARTESIAN mpa_ mpb_)))
  (dk-cite! 'pfw-borel-preimage mbp-prod 's p1 'mpa_)
  (dk-cite! 'pfw-borel-preimage mbp-prod 't p2 'mpb_)
  (dk-cite! 'pfw-borel-sigma-algebra mbp-prod)
  (dk-cite! 'sigma-algebra-inter-closed-2 (list 'PTS mbp-prod) (list 'BOREL-SETS mbp-prod) pre1 pre2)
  (let ((nth-val (lambda (i w) (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (if (= i 1) p1 p2)) (dk-contains? f 'p2z_))) "projection value") w))))
    (mbk-ext2! rect (list 'INTERSECTION pre1 pre2)
      (lambda (w)
        (mbk-iff-parts! (dk-cite! 'cartesian-membership-nth 'mpa_ 'mpb_ w))
        (fact 'power-mem-in '(PTS s) 'mpa_ (list 'NTH 1 w))
        (fact 'power-mem-in '(PTS t) 'mpb_ (list 'NTH 2 w))
        (dk-have! (list 'IN w mbp-cart)
          (lambda () (let ((i (dk-cite! 'cartesian-membership-nth '(PTS s) '(PTS t) w))) (dk-only! i (list '= w (list 'LIST (list 'NTH 1 w) (list 'NTH 2 w))) (list 'IN (list 'NTH 1 w) '(PTS s)) (list 'IN (list 'NTH 2 w) '(PTS t))) (prop))))
        (dk-have! (list 'IN w (list 'PTS mbp-prod)) (lambda () (subst (list '== (list 'PTS mbp-prod) mbp-cart)) (ass)))
        (nth-val 1 w) (nth-val 2 w)
        (dk-have! (list 'IN w pre1) (lambda () (in-sep! (lambda () (subst (list '= (list p1 w) (list 'NTH 1 w))) (ass)))))
        (dk-have! (list 'IN w pre2) (lambda () (in-sep! (lambda () (subst (list '= (list p2 w) (list 'NTH 2 w))) (ass)))))
        (let ((i (dk-cite! 'intersection-membership pre1 pre2 w))) (dk-only! i (list 'IN w pre1) (list 'IN w pre2)) (prop)))
      (lambda (w)
        (mbk-iff-parts! (dk-cite! 'intersection-membership pre1 pre2 w))
        (mbk-sep-parts! (list 'IN w pre1))
        (mbk-sep-parts! (list 'IN w pre2))
        (dk-rewrite-h! (list 'IN w (list 'PTS mbp-prod)) (list 'PTS mbp-prod) mbp-cart)
        (nth-val 1 w) (nth-val 2 w)
        (dk-rewrite-h! (list 'IN (list p1 w) 'mpa_) (list p1 w) (list 'NTH 1 w))
        (dk-rewrite-h! (list 'IN (list p2 w) 'mpb_) (list p2 w) (list 'NTH 2 w))
        (fact 'cartesian-pair-eq w '(PTS s) '(PTS t))
        (let ((i (dk-cite! 'cartesian-membership-nth 'mpa_ 'mpb_ w)))
          (dk-only! i (list '= w (list 'LIST (list 'NTH 1 w) (list 'NTH 2 w))) (list 'IN (list 'NTH 1 w) 'mpa_) (list 'IN (list 'NTH 2 w) 'mpb_))
          (prop)))))
  (subst (list '= rect (list 'INTERSECTION pre1 pre2)))
  (ass))
(qed 'mbp-rect-borel)
(topic! 'mbp-rect-borel 'analysis)

;;; ----------------------------------------------------------------------
;;; (2) the product sigma-algebra is contained in the Borel sets of the product
;;; ----------------------------------------------------------------------
(define mbp-rects '(RECTANGLES (PTS s) (BOREL-SETS s) (PTS t) (BOREL-SETS t)))
(define mbp-psig '(PRODUCT-SIGMA (PTS s) (BOREL-SETS s) (PTS t) (BOREL-SETS t)))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 't (list 'IMPLIES '(IS-METRIC-SPACE t)
  (list 'FORALL 'mpe_ (list 'IMPLIES (list 'IN 'mpe_ mbp-psig) (list 'IN 'mpe_ (list 'BOREL-SETS mbp-prod))))))))))
(dk-peel!)
(mbp-setup!)
(let* ((sa (dk-cite! 'pfw-borel-sigma-algebra mbp-prod)))
  (dk-rewrite-h! sa (list 'PTS mbp-prod) mbp-cart))
(let* ((ru (dk-cite! 'rectangles-unfold '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t)))
       (rsep (caddr ru)))
  (dk-have! (list 'SUBSET mbp-rects (list 'BOREL-SETS mbp-prod))
    (lambda ()
      (mac 'subset-def)
      (let* ((r (dk-di-var!)))
        (dk-rewrite-h! (list 'IN r mbp-rects) mbp-rects rsep)
        (mbk-sep-parts! (list 'IN r rsep))
        (let* ((ex1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f r))) "the rectangle"))
               (a (dk-skolem! ex1))
               (_0 (dk-split-all!))
               (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f r))) "the second side"))
               (b (dk-skolem! ex2))
               (_1 (dk-split-all!)))
          (dk-cite! 'mbp-rect-borel 's 't a b)
          (subst (list '= r (list 'CARTESIAN a b)))
          (ass))))))
(let ((pu (dk-cite! 'product-sigma-unfold '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t))))
  (dk-rewrite-h! (list 'IN 'mpe_ mbp-psig) mbp-psig (caddr pu)))
(dk-cite! 'sigma-generated-in-every mbp-cart mbp-rects 'mpe_ (list 'BOREL-SETS mbp-prod))
(mbp-close-open!)
(qed 'mbp-product-in-borel)
(topic! 'mbp-product-in-borel 'analysis)

;;; ----------------------------------------------------------------------
;;; (3) a generator lies in the sigma-algebra it generates
;;; ----------------------------------------------------------------------
(sp (make-wff '(FORALL omega (FORALL ce (FORALL mpa_ (IMPLIES (IN mpa_ ce) (IMPLIES (IN mpa_ (POWER omega)) (IN mpa_ (SIGMA-GENERATED omega ce)))))))))
(dk-peel!)
(dk-have! '(FORALL cb_ (IMPLIES (AND (IS-SIGMA-ALGEBRA omega cb_) (SUBSET ce cb_)) (IN mpa_ cb_)))
  (lambda ()
    (dk-peel!)
    (dk-split-all!)
    (let ((cb (caddr (dk-goal))))
      (fact 'subset-mem-fwd 'ce cb 'mpa_)
      (mbp-close-open!))))
(dk-cite! 'sigma-generated-intro 'omega 'ce 'mpa_)
(mbp-close-open!)
(qed 'mbp-gen-in-sigma)
(topic! 'mbp-gen-in-sigma 'analysis)

;;; ----------------------------------------------------------------------
;;; (4) X, Y separable: every open set of X x Y is in the product sigma-algebra
;;; ----------------------------------------------------------------------
(define (mbp-m n) (list 'NNFST (list 'NNFST n)))
(define (mbp-k n) (list 'NNSND (list 'NNFST n)))
(define (mbp-q n) (list 'recip (list '+ (list 'NNSND n) 1)))
(define mbp-ds 'mpds_)
(define mbp-dt 'mpdt_)
(define (mbp-B1 n) (list 'BALL 's (list mbp-ds (mbp-m n)) (mbp-q n)))
(define (mbp-B2 n) (list 'BALL 't (list mbp-dt (mbp-k n)) (mbp-q n)))
(define (mbp-RB n) (list 'CARTESIAN (mbp-B1 n) (mbp-B2 n)))
(define (mbp-R n) (list 'SEP 'mpw_ (mbp-RB n) (list 'SUBSET (mbp-RB n) 'mpu_)))
(define (mbp-dense ds sp) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp) 'x (list ds 'n)) 'eps))))))))
;; y in BALL(sp, c, r) from (< (dist c y) r), c, y in PTS sp, r in RR
(define (mbp-in-ball! sp c y r)
  (let ((d (list (list 'DIST sp) c y)))
    (dk-cite! 'metric-dist-real sp c y)
    (dk-have! (list '<= d d) (lambda () (dk-ineq!)))
    (dk-have! (list 'AND (list 'IN y (list 'PTS sp)) (list 'AND (list 'IN d 'RR) (list 'AND (list 'IN r 'RR) (list 'AND (list '<= d d) (list '< d r)))))
      (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-cite! 'ball-mem-from-le sp c y d r)))
;; the index facts at n in NN
(define (mbp-idx! n)
  (fact 'nnfst-type n) (fact 'nnsnd-type n)
  (fact 'nnfst-type (list 'NNFST n)) (fact 'nnsnd-type (list 'NNFST n))
  (fact 'nn-in-rr (list 'NNSND n))
  (let ((j1 (list '+ (list 'NNSND n) 1)))
    (if (not (dk-asm? (list 'IN j1 'RR))) (dk-type! j1 'RR))
    (dk-have! (list '< 0 j1) (lambda () (fact 'nn-zero-le (list 'NNSND n)) (fact 'nn-in-rr (list 'NNSND n)) (dk-ineq! (list '<= 0 (list 'NNSND n)))))
    (dk-have! (list 'NOT (list '= j1 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= j1 0) (list '< 0 j1)))) (ai (dk-cite! 'rr-lt-irrefl 0))))
    (pfw-chain-local! (dk-fact! 'rr-recip-closed j1))
    (pfw-chain-local! (dk-fact! 'rr-recip-pos j1))
    (dk-have! (list '<= 0 (mbp-q n)) (lambda () (dk-ineq! (list '< 0 (mbp-q n)))))
    (dk-have! (list 'NOT (list '= 0 (mbp-q n))) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= 0 (mbp-q n)) (list '< 0 (mbp-q n))))) (ai (dk-cite! 'rr-lt-irrefl 0))))))
(define (pfw-chain-local! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
;; d < q from (<= d q) and (NOT (= d q)) in context
(define (mbp-lt! d q)
  (dk-have! (list '< d q) (lambda () (mac '<) (dk-conj-close! (lambda () (ass))))))
;; ball membership parts: y in BALL(sp, c, r) gives (IN y (PTS sp)) and (< (dist c y) r)
(define (mbp-ball-parts! sp c r y)
  (mbk-iff-parts! (dk-cite! 'ball-membership sp c r y))
  (dk-cite! 'metric-dist-real sp c y)
  (mbp-lt! (list (list 'DIST sp) c y) r))
;; R(n) in the product sigma-algebra, n in NN
(define (mbp-R-in! n)
  (let* ((q (mbp-q n)) (m (mbp-m n)) (k (mbp-k n))
         (c1 (list mbp-ds m)) (c2 (list mbp-dt k))
         (b1 (mbp-B1 n)) (b2 (mbp-B2 n)) (rb (mbp-RB n)) (r (mbp-R n)))
    (mbp-idx! n)
    (fact 'fun-apply-type-c mbp-ds 'NN '(PTS s) m)
    (fact 'fun-apply-type-c mbp-dt 'NN '(PTS t) k)
    (pfw-chain-local! (dk-fact! 'ball-is-open 's c1 q))
    (pfw-chain-local! (dk-fact! 'ball-is-open 't c2 q))
    (dk-cite! 'pfw-open-borel 's b1)
    (dk-cite! 'pfw-open-borel 't b2)
    (dk-cite! 'mbp-rect-borel 's 't b1 b2)
    (mbp-borel-pow! mbp-prod rb)
    (dk-rewrite-h! (list 'IN rb (list 'POWER (list 'PTS mbp-prod))) (list 'PTS mbp-prod) mbp-cart)
    (let* ((ru (dk-cite! 'rectangles-unfold '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t)))
           (rsep (caddr ru)))
      (dk-have! (list 'IN rb rsep)
        (lambda () (in-sep! (lambda () (ew b1) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew b2) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))))
      (dk-rewrite-h! (list 'IN rb rsep) rsep mbp-rects))
    (dk-cite! 'mbp-gen-in-sigma mbp-cart mbp-rects rb)
    (let ((pu (dk-cite! 'product-sigma-unfold '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t))))
      (dk-rewrite-h! (list 'IN rb (caddr pu)) (caddr pu) mbp-psig))
    (dk-have! (list 'IN r mbp-psig)
      (lambda ()
        (use-em (list 'SUBSET rb 'mpu_)
          (lambda ()
            (mbk-ext2! r rb
              (lambda (w) (mbk-sep-parts! (list 'IN w r)) (mbp-close-open!))
              (lambda (w) (in-sep! (lambda () (ass)))))
            (subst (list '= r rb))
            (ass))
          (lambda ()
            (mbk-ext2! r 'EMPTY-SET
              (lambda (w) (mbk-sep-parts! (list 'IN w r)) (dk-only! (list 'SUBSET rb 'mpu_) (list 'NOT (list 'SUBSET rb 'mpu_))) (prop))
              (lambda (w) (fact 'empty-set-has-no-members w) (dk-only! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))) (prop)))
            (subst (list '= r 'EMPTY-SET))
            (dk-cite! 'sigma-algebra-empty-in mbp-cart mbp-psig)
            (mbp-close-open!)))))))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-SEPARABLE s) (list 'FORALL 't (list 'IMPLIES '(IS-SEPARABLE t)
  (list 'FORALL 'mpu_ (list 'IMPLIES (list 'IS-OPEN mbp-prod 'mpu_) (list 'IN 'mpu_ mbp-psig)))))))))
(dk-peel!)
(define (mbp-sep-open! sp)                 ; is-metric-space(sp) and a dense sequence: returns it
  (let* ((iff (dk-cite! 'is-separable sp)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(set! mbp-ds (mbp-sep-open! 's))
(set! mbp-dt (mbp-sep-open! 't))
(mbp-setup!)
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-cite! 'pfw-borel-sigma-algebra 't)
(dk-cite! 'product-sigma-is-sigma-algebra '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t))
(mbk-iff-parts! (dk-cite! 'is-sigma-algebra mbp-cart mbp-psig))
(mbk-iff-parts! (dk-cite! 'is-open mbp-prod 'mpu_))
(dk-rewrite-h! (list 'SUBSET 'mpu_ (list 'PTS mbp-prod)) (list 'PTS mbp-prod) mbp-cart)
(define mbp-rs-ex
  (list 'FORSOME 'mprs_ (list 'AND (list 'IN 'mprs_ (list 'FUN 'NN mbp-psig))
    (list 'FORALL 'mpn_ (list 'IMPLIES '(IN mpn_ NN) (list '== '(mprs_ mpn_) (mbp-R 'mpn_)))))))
(dk-have! mbp-rs-ex
  (lambda ()
    (let ((lam (list 'VNB-LAMBDA 'mpn_ 'NN (mbp-R 'mpn_))))
      (ew lam)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (dk-lam-type! (lambda () (let* ((n (dk-di-var!)) (leaf (proof-state-focus *ps*))) (mbp-R-in! n) (mbp-close-open!))))
              (let ((n (dk-di-var!))) (mbp-R-in! n) (dk-close-if! (lambda () (dk-lam-b!)) qrfl))))))))
(define mbp-rs (dk-skolem! mbp-rs-ex))
(dk-split-all!)
(define mbp-rsv (list 'FORALL 'mpn_ (list 'IMPLIES '(IN mpn_ NN) (list '== (list mbp-rs 'mpn_) (mbp-R 'mpn_)))))
(define mbp-bu (list 'BIG-UNION 'n_ 'NN (list mbp-rs 'n_)))
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BIG-UNION) (dk-contains? f mbp-psig))) "unions") mbp-rs)
(mbk-ext2! 'mpu_ mbp-bu
  ;; w in U: a product of balls around w inside U, and its index
  (lambda (w)
    (let* ((bclause (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'POS-RR) (dk-contains? f 'mpu_))) "the ball clause"))
           (r (dk-skolem! (dk-apply! bclause w)))
           (_0 (dk-split-all!))
           (_1 (begin (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)))
           (_2 (fact 'subset-mem-fwd 'mpu_ mbp-cart w))
           (x (list 'NTH 1 w)) (y (list 'NTH 2 w))
           (_3 (dk-split-all! (list (dk-cite! 'cartesian-nth w '(PTS s) '(PTS t)))))
           (_4 (fact 'cartesian-pair-eq w '(PTS s) '(PTS t)))
           (h (list '* 1/2 r))
           (_5 (begin (dk-type! h 'RR) (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 r)))) (pfw-chain-local! (dk-fact! 'rr-pos-rr-of-lt h))))
           (j (dk-skolem! (dk-cite! 'nn-recip-succ-small h)))
           (_6 (dk-split-all!))
           (j1 (list '+ j 1)) (q (list 'recip j1))
           (_7 (begin (fact 'nn-in-rr j) (dk-type! j1 'RR)
                      (dk-have! (list '< 0 j1) (lambda () (fact 'nn-zero-le j) (dk-ineq! (list '<= 0 j))))
                      (dk-have! (list 'NOT (list '= j1 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= j1 0) (list '< 0 j1)))) (ai (dk-cite! 'rr-lt-irrefl 0))))
                      (pfw-chain-local! (dk-fact! 'rr-recip-closed j1))
                      (pfw-chain-local! (dk-fact! 'rr-recip-pos j1))
                      (pfw-chain-local! (dk-fact! 'rr-pos-rr-of-lt q))))
           (m (dk-skolem! (dk-apply! (mbp-dense mbp-ds 's) x q)))
           (_8 (dk-split-all!))
           (k (dk-skolem! (dk-apply! (mbp-dense mbp-dt 't) y q)))
           (_9 (dk-split-all!))
           (mk (list 'NNPAIR m k))
           (n (list 'NNPAIR mk j))
           (c1 (list mbp-ds m)) (c2 (list mbp-dt k))
           (b1 (list 'BALL 's c1 q)) (b2 (list 'BALL 't c2 q))
           (rb (list 'CARTESIAN b1 b2)))
      (fact 'fun-apply-type-c mbp-ds 'NN '(PTS s) m)
      (fact 'fun-apply-type-c mbp-dt 'NN '(PTS t) k)
      (pfw-chain-local! (dk-fact! 'nnpair-type m k))
      (pfw-chain-local! (dk-fact! 'nnpair-type mk j))
      ;; w in rb
      (dk-cite! 'metric-sym 's x c1) (dk-cite! 'metric-sym 't y c2)
      (dk-rewrite-h! (list '< (list '(DIST s) x c1) q) (list '(DIST s) x c1) (list '(DIST s) c1 x))
      (dk-rewrite-h! (list '< (list '(DIST t) y c2) q) (list '(DIST t) y c2) (list '(DIST t) c2 y))
      (mbp-in-ball! 's c1 x q)
      (mbp-in-ball! 't c2 y q)
      (dk-have! (list 'IN w rb)
        (lambda () (let ((i (dk-cite! 'cartesian-membership-nth b1 b2 w)))
                     (dk-only! i (list '= w (list 'LIST x y)) (list 'IN x b1) (list 'IN y b2)) (prop))))
      ;; rb inside U
      (dk-have! (list 'SUBSET rb 'mpu_)
        (lambda ()
          (mac 'subset-def)
          (let* ((v (dk-di-var!)) (v1 (list 'NTH 1 v)) (v2 (list 'NTH 2 v)))
            (mbk-iff-parts! (dk-cite! 'cartesian-membership-nth b1 b2 v))
            (mbp-ball-parts! 's c1 q v1)
            (mbp-ball-parts! 't c2 q v2)
            (dk-cite! 'metric-triangle 's x c1 v1)
            (dk-cite! 'metric-triangle 't y c2 v2)
            (dk-cite! 'metric-dist-real 's x c1) (dk-cite! 'metric-dist-real 't y c2)
            (dk-cite! 'metric-dist-real 's x v1) (dk-cite! 'metric-dist-real 't y v2)
            (let ((d1 (list '(DIST s) x v1)) (d2 (list '(DIST t) y v2)))
              (dk-have! (list '< d1 r) (lambda () (dk-ineq! (list '<= d1 (list '+ (list '(DIST s) x c1) (list '(DIST s) c1 v1)))
                                                             (list '< (list '(DIST s) c1 x) q) (list '< (list '(DIST s) c1 v1) q)
                                                             (list '= (list '(DIST s) x c1) (list '(DIST s) c1 x))
                                                             (list '< q h))))
              (dk-have! (list '< d2 r) (lambda () (dk-ineq! (list '<= d2 (list '+ (list '(DIST t) y c2) (list '(DIST t) c2 v2)))
                                                             (list '< (list '(DIST t) c2 y) q) (list '< (list '(DIST t) c2 v2) q)
                                                             (list '= (list '(DIST t) y c2) (list '(DIST t) c2 y))
                                                             (list '< q h))))
              (pfw-chain-local! (dk-fact! 'rr-max-lt d1 d2 r))
              (dk-have! (list 'IN v mbp-cart)
                (lambda () (let ((i (dk-cite! 'cartesian-membership-nth '(PTS s) '(PTS t) v)))
                             (dk-only! i (list '= v (list 'LIST v1 v2)) (list 'IN v1 '(PTS s)) (list 'IN v2 '(PTS t))) (prop))))
              (let* ((pd (dk-cite! 'product2-dist 's 't w v))
                     (dp (list (list 'DIST mbp-prod) w v)))
                (dk-have! (list '< dp r) (lambda () (subst pd) (ass)))
                (dk-have! (list 'IN w (list 'PTS mbp-prod)) (lambda () (subst (list '== (list 'PTS mbp-prod) mbp-cart)) (ass)))
                (dk-have! (list 'IN v (list 'PTS mbp-prod)) (lambda () (subst (list '== (list 'PTS mbp-prod) mbp-cart)) (ass)))
                (mbp-in-ball! mbp-prod w v r)
                (fact 'subset-mem-fwd (list 'BALL mbp-prod w r) 'mpu_ v)
                (mbp-close-open!))))))
      ;; w in R(n) = rs(n), and so in the union
      (dk-cite! 'nnfst-nnpair mk j) (dk-cite! 'nnsnd-nnpair mk j)
      (dk-cite! 'nnfst-nnpair m k) (dk-cite! 'nnsnd-nnpair m k)
      (dk-have! (list 'IN w (list mbp-rs n))
        (lambda ()
          (subst (dk-apply! mbp-rsv n))
          (subst (list '= (list 'NNFST n) mk))
          (subst (list '= (list 'NNSND n) j))
          (subst (list '= (list 'NNFST mk) m))
          (subst (list '= (list 'NNSND mk) k))
          (in-sep! (lambda () (ass)))))
      (mbk-bu-close! n)))
  ;; w in the union: w in some R(k), inside U
  (lambda (w)
    (let* ((ka (mbk-bu-open! w mbp-bu)) (k (car ka)))
      (dk-apply! mbp-rsv k)
      (dk-rewrite-h! (list 'IN w (list mbp-rs k)) (list mbp-rs k) (mbp-R k))
      (mbk-sep-parts! (list 'IN w (mbp-R k)))
      (fact 'subset-mem-fwd (mbp-RB k) 'mpu_ w)
      (mbp-close-open!))))
(subst (list '= 'mpu_ mbp-bu))
(ass)
(qed 'mbp-open-in-product)
(topic! 'mbp-open-in-product 'analysis)

