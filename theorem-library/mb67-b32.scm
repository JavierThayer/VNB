;;; ======================================================================
;;; an injective Borel map between Polish spaces maps Borel sets to Borel sets
;;; ======================================================================
(define (m32-inter-in! y a b)         ; y in a and y in b in context: y in INTERSECTION(a, b)
  (let ((iff (dk-cite! 'intersection-membership a b y)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
    (mr-iff-back! iff)))
(define (m32-nth-r!)                 ; reduce NTH of a literal list in the goal, to a fixpoint
  (let loop ((n 0))
    (if (and (< n 12)
             (let scan ((e (dk-goal)))
               (and (pair? e)
                    (or (and (eq? (car e) 'NTH) (pair? (cddr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST))
                        (any-pred scan e)))))
        (begin (nth-r) (loop (+ n 1))))))
(define m32-P '(PRODUCT2-MS sx sz))
(define m32-C '(CARTESIAN (PTS sx) (PTS sz)))
(define m32-G '(GRAPH-OF (PTS sx) (PTS sz) th))
(define m32-Gs (list 'SEP 'grp_ m32-C '(= (th (NTH 1 grp_)) (NTH 2 grp_))))
(define m32-R '(CARTESIAN eb (PTS sz)))
(define m32-GE (list 'INTERSECTION m32-G m32-R))
(define m32-sub (list 'SUBSPACE-MS m32-P m32-GE))
(define m32-snd (list 'VNB-LAMBDA 'm32w_ m32-GE '(NTH 2 m32w_)))
(define m32-inj '(FORALL x (IMPLIES (IN x (PTS sx)) (FORALL x2 (IMPLIES (IN x2 (PTS sx)) (IMPLIES (= (th x) (th x2)) (= x x2)))))))
(define (m32-ge-parts! w)            ; w in GE: w in C, its coordinates typed, th(NTH 1 w) = NTH 2 w, NTH 1 w in eb
  (if (not (dk-asm? (list 'IN (list 'NTH 1 w) 'eb)))
      (begin
        (mr-iff-parts! (dk-cite! 'intersection-membership m32-G m32-R w))
        (dk-rewrite-h! (list 'IN w m32-G) m32-G m32-Gs)
        (dk-split-all! (list (mr-sep-parts! (list 'IN w m32-Gs))))
        (dk-split! (dk-cite! 'cartesian-nth w '(PTS sx) '(PTS sz)))
        (dk-split! (dk-cite! 'cartesian-nth w 'eb '(PTS sz))))))
(sp (make-wff (list 'FORALL 'sx (list 'IMPLIES '(IS-POLISH sx) (list 'FORALL 'sz (list 'IMPLIES '(IS-POLISH sz) (list 'FORALL 'th
  (list 'IMPLIES '(IS-MEASURABLE-MAP (PTS sx) (BOREL-SETS sx) (PTS sz) (BOREL-SETS sz) th) (list 'IMPLIES m32-inj
    (list 'FORALL 'eb (list 'IMPLIES '(IN eb (BOREL-SETS sx)) '(IN (IMAGE th eb) (BOREL-SETS sz)))))))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 'sx)) (mr-iff-parts! (dk-cite! 'is-complete 'sx))
(mr-iff-parts! (dk-cite! 'is-polish 'sz)) (mr-iff-parts! (dk-cite! 'is-complete 'sz))
(mr-iff-parts! (dk-cite! 'is-measurable-map '(PTS sx) '(BOREL-SETS sx) '(PTS sz) '(BOREL-SETS sz) 'th))
(dk-cite! 'ms-pts-is-set 'sx) (dk-cite! 'ms-pts-is-set 'sz)
