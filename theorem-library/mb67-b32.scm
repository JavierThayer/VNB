;;; mb67-b32.scm -- construction of measures, chapter 5 sections 1.7-1.8 (M-B67, 2026-10-27): Theorem 5.32 (an
;;; injective Borel map of a Polish space into a separable metric space maps Borel sets to Borel sets) and its
;;; consequences 5.34 and 5.37.  The core is borel-injection-image: for X, Z Polish and theta: X -> Z injective and
;;; Borel, theta(E) = snd(Gr(theta) /\ (E x Z)), where the graph is Borel in X x Z (5.33 with 5.3) and the second
;;; projection is continuous and injective on it (5.30).  A separable metric Y is countably separated, so it embeds
;;; injectively and measurably into N^N (5.36); the notes' passage through the completion of Y is not needed.
;;; Library: measure.  Helper prefixes mr- (copied), m32-.
;;; Load window: after mb67-ls (lusin-souslin-borel-domain), mb67-standard (graph-measurable,
;;; countably-separated-of-injection, countably-separated-embeds-baire), mb4-borel-product (borel-sets-product,
;;; mbp-rect-borel), mb67-prod2 (product2-polish), product2-laws, metric-subspace-laws, rake-measure2, rake-measure
;;; (measurable-map-compose).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define (m32-lam-type! claim per-var!) ; claim (IN lambda (FUN A B)): lam-t, PER-VAR! on the peeled variable of each pointwise leaf
  (dk-have! claim
    (lambda ()
      (for-each (lambda (kn)
                  (if (not (sequent-node-grounded? kn))
                      (begin (dk-focus! kn)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (let ((v (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                   (per-var! v)
                                   (for-each (lambda (lf) (if (not (sequent-node-grounded? lf)) (begin (dk-focus! lf) (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (mr-close-open!))))))
                                             (dk--open-below kn)))))))
                (dk-opened (lambda () (lam-t)))))))
(define (m32-img-open! f dom p)      ; p in IMAGE(f, dom) in context: the witness x, x in dom and f(x) = p landed
  (let* ((ps (mr-iff-parts! (dk-cite! 'image-membership-iff f dom p)))
         (x (dk-skolem! (cadr ps))))
    (dk-split-all!)
    x))
(define (m32-img-in! f dom x y cod)  ; x in dom, f(x) = y, y in cod (a set's member) in context: y in IMAGE(f, dom)
  (dk-cite! 'membership-implies-sethood y cod)
  (let ((iff (dk-cite! 'image-membership-iff f dom y)))
    (dk-have! (caddr iff)
      (lambda () (mr-and-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                                 ((dk-head-is? (dk-goal) 'FORSOME) (ew x) (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                                                 (#t (error "m32-img-in!" (expression->string (dk-goal)))))))))
    (mr-iff-back! iff)))
(define (m32-borel-sub! sp0 c)       ; c Borel(sp0): c subset PTS sp0
  (let ((g0 (list 'SUBSET c (list 'PTS sp0))))
    (if (not (dk-asm? g0))
        (begin
          (dk-cite! 'pfw-borel-sigma-algebra sp0)
          (mr-iff-parts! (dk-cite! 'is-sigma-algebra (list 'PTS sp0) (list 'BOREL-SETS sp0)))
          (dk-cite! 'subset-mem-fwd (list 'BOREL-SETS sp0) (list 'POWER (list 'PTS sp0)) c)
          (dk-have! g0 (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-cite! 'power-mem-in (list 'PTS sp0) c z) (mr-close-open!))))))
    g0))

;;; ======================================================================
;;; a separable metric space is countably separated (its identity is an injective Borel map into it)
;;; ======================================================================
(define m32-id '(VNB-LAMBDA m32i_ (PTS ysp) m32i_))
(sp (make-wff '(FORALL ysp (IMPLIES (IS-SEPARABLE ysp) (IS-COUNTABLY-SEPARATED (PTS ysp) (BOREL-SETS ysp))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-separable 'ysp))
(dk-cite! 'pfw-borel-sigma-algebra 'ysp)
(dk-cite! 'ms-pts-is-set 'ysp)
(m32-lam-type! (list 'IN m32-id '(FUN (PTS ysp) (PTS ysp))) (lambda (v) #t))
(define (m32-idv! x)                 ; x in PTS Y: id(x) = x
  (dk-have! (list '= (list m32-id x) x) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
(let ((iff (dk-cite! 'is-measurable-map '(PTS ysp) '(BOREL-SETS ysp) '(PTS ysp) '(BOREL-SETS ysp) m32-id)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((b (dk-di-var!)) (sp0 (list 'SEP 'x_ '(PTS ysp) (list 'IN (list m32-id 'x_) b))))
                (m32-borel-sub! 'ysp b)
                (mr-ext2! sp0 b
                  (lambda (x)
                    (dk-split-all! (list (mr-sep-parts! (list 'IN x sp0))))
                    (m32-idv! x)
                    (dk-rewrite-h! (list 'IN (list m32-id x) b) (list m32-id x) x)
                    (mr-close-open!))
                  (lambda (x)
                    (dk-cite! 'subset-mem-fwd b '(PTS ysp) x)
                    (m32-idv! x)
                    (in-sep! (lambda () (subst (list '= (list m32-id x) x)) (mr-close-open!)))))
                (subst (list '= sp0 b))
                (mr-close-open!)))))))
  (mr-iff-back! iff))
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS ysp)) (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS ysp))
            (list 'IMPLIES (list '= (list m32-id 'x) (list m32-id 'y)) '(= x y))))))
  (lambda ()
    (let* ((ls (dk-peel!)) (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS ysp)))) ls)))
           (x (car vs)) (y (cadr vs)))
      (m32-idv! x) (m32-idv! y)
      (subst (list '= x (list m32-id x)))
      (subst (list '= y (list m32-id y)))
      (mr-close-open!))))
(dk-cite! 'countably-separated-of-injection '(PTS ysp) '(BOREL-SETS ysp) 'ysp m32-id)
(mr-close-open!)
(qed 'separable-countably-separated)
(topic! 'separable-countably-separated 'analysis)

