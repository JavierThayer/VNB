(define (m32-ge-c! w)                ; w in GE: w in C
  (if (not (dk-asm? (list 'IN w m32-C)))
      (begin (dk-cite! 'subset-mem-fwd m32-GE (list 'PTS m32-P) w)
             (dk-have! (list 'IN w m32-C) (lambda () (subst (list '= m32-C (list 'PTS m32-P))) (mr-close-open!))))))
(define (m32-sndv! w)                ; w in GE: snd(w) = NTH 2 w, typed in PTS sz
  (m32-ge-c! w) (m32-ge-parts! w)
  (dk-have! (list '= (list m32-snd w) (list 'NTH 2 w)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
(m32-lam-type! (list 'IN m32-snd (list 'FUN m32-GE '(PTS sz))) (lambda (w) (m32-ge-c! w) (m32-ge-parts! w)))
;; the second projection is continuous on the subspace GE
(let ((iff (dk-cite! 'is-continuous m32-sub 'sz m32-snd)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (cond
            ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS m32-sub) m32-GE)) (mr-close-open!))
            (#t
             (let* ((a0 (dk-di-var!))
                    (_0 (dk-have! (list 'IN a0 m32-GE) (lambda () (subst (list '= m32-GE (list 'PTS m32-sub))) (mr-close-open!))))
                    (iff2 (dk-cite! 'is-continuous-at m32-sub 'sz m32-snd a0)))
               (m32-sndv! a0)
               (dk-have! (list 'IN m32-snd (list 'FUN (list 'PTS m32-sub) '(PTS sz))) (lambda () (subst (list '= (list 'PTS m32-sub) m32-GE)) (mr-close-open!)))
               (dk-have! (caddr iff2)
                 (lambda ()
                   (mr-and-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (let* ((ls (dk-peel!)) (eps (cadr (mr-find 'eps (lambda (f) (dk-head-is? f 'POS-RR)) ls))))
                             (mr-pos! eps)
                             (ew eps)
                             (mr-and-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal)) (ass)
                                     (let* ((lb (dk-peel!))
                                            (b (cadr (mr-find 'b (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS m32-sub)))) lb)))
                                            (_1 (dk-have! (list 'IN b m32-GE) (lambda () (subst (list '= m32-GE (list 'PTS m32-sub))) (mr-close-open!))))
                                            (dx (list '(DIST sx) (list 'NTH 1 a0) (list 'NTH 1 b)))
                                            (dz (list '(DIST sz) (list 'NTH 2 a0) (list 'NTH 2 b)))
                                            (dp (list (list 'DIST m32-P) a0 b))
                                            (ds0 (list (list 'DIST m32-sub) a0 b)))
                                       (m32-sndv! b)
                                       (dk-cite! 'subspace-dist m32-P m32-GE a0 b)
                                       (dk-cite! 'product2-dist 'sx 'sz a0 b)
                                       (dk-cite! 'metric-dist-real 'sx (list 'NTH 1 a0) (list 'NTH 1 b))
                                       (dk-cite! 'metric-dist-real 'sz (list 'NTH 2 a0) (list 'NTH 2 b))
                                       (dk-cite! 'rr-le-max-right dx dz)
                                       (dk-cite! 'rr-max-closed dx dz)
                                       (let* ((le0 (mr-find 'dle (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) ds0))) (dk-asms)))
                                              (le1 (dk-rewrite-h! le0 ds0 dp))
                                              (le2 (dk-rewrite-h! le1 dp (list 'max dx dz))))
                                         (subst (list '= (list m32-snd a0) (list 'NTH 2 a0)))
                                         (subst (list '= (list m32-snd b) (list 'NTH 2 b)))
                                         (dk-ineq! (list '<= dz (list 'max dx dz)) le2 (list 'IN dz 'RR) (list 'IN (list 'max dx dz) 'RR) (list 'IN eps 'RR)))))))))))))
               (mr-iff-back! iff2)
               (mr-close-open!))))))))
  (mr-iff-back! iff))
;; injective on GE
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x m32-GE) (list 'FORALL 'x2 (list 'IMPLIES (list 'IN 'x2 m32-GE)
            (list 'IMPLIES (list '= (list m32-snd 'x) (list m32-snd 'x2)) '(= x x2))))))
  (lambda ()
    (let* ((ls (dk-peel!)) (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) m32-GE))) ls)))
           (w (car vs)) (w2 (cadr vs)))
      (m32-sndv! w) (m32-sndv! w2)
      (let ((eq2 (list '= (list 'NTH 2 w) (list 'NTH 2 w2))))
        (dk-have! eq2 (lambda () (subst (list '= (list 'NTH 2 w) (list m32-snd w))) (subst (list '= (list 'NTH 2 w2) (list m32-snd w2))) (mr-close-open!)))
        (dk-have! (list '= (list 'th (list 'NTH 1 w)) (list 'th (list 'NTH 1 w2)))
          (lambda () (subst (list '= (list 'th (list 'NTH 1 w)) (list 'NTH 2 w))) (subst (list '= (list 'th (list 'NTH 1 w2)) (list 'NTH 2 w2))) (mr-close-open!)))
