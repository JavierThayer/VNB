      (lambda () (di) (let ((h (dk-rewrite-h! `(= ,(a5f-ta 'a5x) 0) (a5f-ta 'a5x) 1))) (dk-absurd! h))))
    (keep '(NOT (= a5x (ZERO kq_))) `(NOT (= ,(a5f-ta 'a5x) 0)))
    (prop)))
(qed 'triv-abs-zero-iff)

;; |x y| = |x| |y| over an integral domain
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-INTEGRAL-DOMAIN kq_) ,(a5f-all 'a5x '(CARR kq_) (a5f-all 'a5y '(CARR kq_)
  `(= ,(a5f-ta '((MUL kq_) a5x a5y)) (* ,(a5f-ta 'a5x) ,(a5f-ta 'a5y)))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring 'kq_))
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
(dk-cite! 'ring-zero-in 'kq_)
(dk-cite! 'triv-abs-zero 'kq_)
(dk-cite! 'triv-abs-range 'kq_ 'a5x) (dk-cite! 'triv-abs-range 'kq_ 'a5y) (dk-split-all!)
(let ((xy '((MUL kq_) a5x a5y)))
  (use-em '(= a5x (ZERO kq_))
    (lambda ()
      (subst '(= a5x (ZERO kq_)))
      (dk-cite! 'ring-mul-zero-left 'kq_ 'a5y)
      (subst '(= ((MUL kq_) (ZERO kq_) a5y) (ZERO kq_)))
      (subst `(= ,(a5f-ta '(ZERO kq_)) 0))
      (dk-ineq! `(IN ,(a5f-ta 'a5y) RR)))
    (lambda ()
      (use-em '(= a5y (ZERO kq_))
        (lambda ()
          (subst '(= a5y (ZERO kq_)))
          (dk-cite! 'ring-mul-zero-right 'kq_ 'a5x)
          (subst '(= ((MUL kq_) a5x (ZERO kq_)) (ZERO kq_)))
          (subst `(= ,(a5f-ta '(ZERO kq_)) 0))
          (dk-ineq! `(IN ,(a5f-ta 'a5x) RR)))
        (lambda ()
          (dk-cite! 'ring-carrier-closed-mul 'kq_ 'a5x 'a5y)
          (dk-have! `(NOT (= ,xy (ZERO kq_)))
            (lambda ()
              (di)
              (dk-chain-ass! (dk-cite! 'integral-domain-cancel-zero 'kq_ 'a5x 'a5y))
              (ai '(NOT (= a5x (ZERO kq_))))))
          (dk-cite! 'triv-abs-nonzero 'kq_ 'a5x) (dk-cite! 'triv-abs-nonzero 'kq_ 'a5y) (dk-cite! 'triv-abs-nonzero 'kq_ xy)
          (subst `(= ,(a5f-ta xy) 1)) (subst `(= ,(a5f-ta 'a5x) 1)) (subst `(= ,(a5f-ta 'a5y) 1))
          (arith))))))
(qed 'triv-abs-mul)

;; |x + y| <= |x| + |y|
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) ,(a5f-all 'a5x '(CARR kq_) (a5f-all 'a5y '(CARR kq_)
  `(<= ,(a5f-ta '((ADD kq_) a5x a5y)) (+ ,(a5f-ta 'a5x) ,(a5f-ta 'a5y)))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
(dk-cite! 'ring-zero-in 'kq_)
(dk-cite! 'triv-abs-zero 'kq_)
(a5f-and! '(IS-RING kq_) '(IN a5x (CARR kq_)) '(IN a5y (CARR kq_)))
(dk-cite! 'ring-carrier-closed-add 'kq_ 'a5x 'a5y)
(dk-cite! 'triv-abs-range 'kq_ 'a5x) (dk-cite! 'triv-abs-range 'kq_ 'a5y) (dk-cite! 'triv-abs-range 'kq_ '((ADD kq_) a5x a5y))
(dk-split-all!)
(use-em '(= a5x (ZERO kq_))
  (lambda ()
    (subst '(= a5x (ZERO kq_)))
    (dk-have! '(= ((ADD kq_) (ZERO kq_) a5y) a5y) (lambda () (crs)))
    (subst '(= ((ADD kq_) (ZERO kq_) a5y) a5y))
    (subst `(= ,(a5f-ta '(ZERO kq_)) 0))
    (dk-ineq! `(IN ,(a5f-ta 'a5y) RR)))
  (lambda ()
    (dk-cite! 'triv-abs-nonzero 'kq_ 'a5x)
    (dk-ineq! `(= ,(a5f-ta 'a5x) 1) `(<= ,(a5f-ta '((ADD kq_) a5x a5y)) 1) `(<= 0 ,(a5f-ta 'a5y))
              `(IN ,(a5f-ta 'a5x) RR) `(IN ,(a5f-ta 'a5y) RR) `(IN ,(a5f-ta '((ADD kq_) a5x a5y)) RR))))
(qed 'triv-abs-add)

;;; the slots of TRIV-NF(K)
(define a5f-nrm-lam '(VNB-LAMBDA a5x_ (CARR kq_) (TRIV-ABS kq_ a5x_)))
(define (a5f-nf-setup!)
  (let ((k 'kq_))
    (dk-project! `(IN (CARR ,k) SET) 'IS-RING `(IS-RING ,k))
    (dk-have! `(IN ,a5f-nrm-lam (FUN (CARR ,k) RR))
      (lambda ()
        (dk-each-leaf! (lambda () (lam-t))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                  (dk-cite! 'triv-abs-range k x) (dk-split-all!)
                  (dk-close-if-asm!))
                (dk-close-if-asm!))))))
    (dk-cite! 'membership-implies-sethood a5f-nrm-lam `(FUN (CARR ,k) RR))
    (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-RING `(IS-RING ,k))))))))
(define (a5f-nf-readoff! name acc rhs)
  (dk-sp-qed! (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (== (,acc (TRIV-NF kq_)) ,rhs))))
    (lambda ()
      (dk-peel!)
      (a5f-nf-setup!) (slot acc) (mac 'TRIV-NF) (nth-r)
      (for-each (lambda (ia)
                  (let ((r (list 'NTH (car ia) 'kq_)) (src (list (cdr ia) 'kq_)))
                    (if (string-search-forward (string-downcase (expression->string r)) (string-downcase (expression->string (dk-goal))) 0)
                        (begin (dk-have! (list '== r src) (lambda () (slot (cdr ia)) (qrfl)))
                               (subst (list '== r src))))))
                '((1 . CARR) (2 . ADD) (3 . MUL) (4 . NEG) (5 . ZERO) (6 . ONE)))
      (qrfl))
    name))
(a5f-nf-readoff! 'triv-nf-carr 'CARR '(CARR kq_))
(a5f-nf-readoff! 'triv-nf-add 'ADD '(ADD kq_))
(a5f-nf-readoff! 'triv-nf-mul 'MUL '(MUL kq_))
(a5f-nf-readoff! 'triv-nf-neg 'NEG '(NEG kq_))
(a5f-nf-readoff! 'triv-nf-zero 'ZERO '(ZERO kq_))
(a5f-nf-readoff! 'triv-nf-one 'ONE '(ONE kq_))
(a5f-nf-readoff! 'triv-nf-fnrm 'FNRM a5f-nrm-lam)

;; the norm conjunct of IS-NORMED-FIELD(TRIV-NF K), after the read-offs: the focus is the universal over a
(define (a5f-norm-body!)
  (let* ((k 'kq_)
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (let disp ()
      (if (and (not (dk-head-is? (dk-goal) 'AND)) (not (dk-head-is? (dk-goal) 'FORALL)) (dk--redex? (dk-goal))) (dk-lam-b!))
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (disp)))) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'IFF) (dk-cite! 'triv-abs-zero-iff k a) (dk-close-if-asm!))
          ((and (dk-head-is? g '<=) (eqv? (cadr g) 0)) (dk-cite! 'triv-abs-range k a) (dk-split-all!) (dk-close-if-asm!))
          ((dk-head-is? g 'FORALL)
           (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                  (b (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed2))))
             (dk-cite! 'ring-carrier-closed-mul k a b)
             (a5f-and! `(IS-RING ,k) `(IN ,a (CARR ,k)) `(IN ,b (CARR ,k)))
             (dk-cite! 'ring-carrier-closed-add k a b)
             (disp)))
          ((dk-head-is? g '=)
           (let ((b (caddr (caddr (cadr g)))))
             (dk-cite! 'triv-abs-mul k a b) (dk-close-if-asm!)))
          ((dk-head-is? g '<=)
           (let ((b (caddr (caddr (cadr g)))))
             (dk-cite! 'triv-abs-add k a b) (dk-close-if-asm!)))
          (#t (error "a5f-norm-body!: unexpected" (expression->string g))))))))

(define (a5f-inverse-body!)
  (let* ((k 'kq_)
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
         (law (dk-project! `(FORALL a_ (IMPLIES (IN a_ (CARR ,k)) (IMPLIES (NOT (= a_ (ZERO ,k)))
                                (FORSOME b_ (AND (IN b_ (CARR ,k)) (= ((MUL ,k) a_ b_) (ONE ,k)))))))
                           'is-field-ring-def `(IS-FIELD-RING ,k)))
         (b (dk-skolem! (dk-chain-ass! (dk-apply! law a)))))
    (dk-split-all!)
    (ew b)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (dk-ass!))
            ((dk-head-is? g 'NOT)
             (di)
             (let* ((e0 `(= ((MUL ,k) ,a ,b) (ONE ,k)))
                    (e1 (dk-rewrite-h! e0 b `(ZERO ,k)))
                    (z (dk-chain-ass! (dk-cite! 'ring-mul-zero-right k a)))
                    (e2 (dk-rewrite-h! e1 `((MUL ,k) ,a (ZERO ,k)) `(ZERO ,k))))
               (keep e2 `(NOT (= (ZERO ,k) (ONE ,k))))
               (prop)))
            (#t (error "a5f-inverse-body!: unexpected" (expression->string g)))))))))

;;; a field with its trivial absolute value is a normed field
(sp (make-wff '(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (IS-NORMED-FIELD (TRIV-NF kq_))))))
(dk-peel!)
(let ((k 'kq_))
  (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain k))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-chain-ass! (dk-cite! 'ladet-field-one-ne k))
  (dk-have! `(NOT (= (ZERO ,k) (ONE ,k))) (lambda () (di) (dk-have! `(= (ONE ,k) (ZERO ,k)) (lambda () (subst `(= (ONE ,k) (ZERO ,k))) (rfl))) (ai `(NOT (= (ONE ,k) (ZERO ,k))))))
  (for-each (lambda (n) (dk-cite! n k)) '(triv-nf-carr triv-nf-add triv-nf-mul triv-nf-neg triv-nf-zero triv-nf-one triv-nf-fnrm))
  (a5f-nf-setup!)
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-commutative-ring-def `(IS-COMMUTATIVE-RING ,k))))))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (mac 'IS-NORMED-FIELD)
  (dk-isx-set!)
  (for-each mac '(triv-nf-carr triv-nf-add triv-nf-mul triv-nf-neg triv-nf-zero triv-nf-one triv-nf-fnrm))
  (let split ((fuel 40))
    (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
      (when andl
        (if (= fuel 0) (error "a5f: AND split did not terminate"))
        (dk-focus! andl) (di) (split (- fuel 1)))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (dk-ass!))
                    ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'TRIV-NF) (len-r) (arith))
                    ((dk-head-is? g 'is-commutative) (mac 'is-commutative) (dk-close-if-asm!))
                    ((dk-head-is? g 'is-norm)
                     (mac 'is-norm)
                     (for-each (lambda (l2) (dk-focus! l2) (if (dk-asm? (dk-goal)) (dk-ass!) (a5f-norm-body!)))
                               (dk-opened (lambda () (di)))))
                    ((dk-head-is? g 'FORALL) (a5f-inverse-body!))
                    (#t (error "a5f nf: unexpected conjunct" (expression->string g))))))))
    (dk-open-leaves)))
(qed 'triv-nf-is-normed-field)

;;; "a character of F_q": every additive homomorphism of a finite field into T is a character of TRIV-NF(F_q)
(sp (make-wff '(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (IMPLIES (IN (CARD (CARR kq_)) NN)
  (FORALL a5c (IMPLIES (IN a5c (FUN (CARR kq_) UNIT-CIRCLE))
    (IMPLIES (FORALL chx_ (IMPLIES (IN chx_ (CARR kq_)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kq_))
               (= (a5c ((ADD kq_) chx_ chy_)) (* (a5c chx_) (a5c chy_)))))))
      (IS-ADD-CHARACTER (TRIV-NF kq_) a5c)))))))))
(dk-peel!)
(let* ((k 'kq_) (tn '(TRIV-NF kq_))
       (hom (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a5c))) "the homomorphism law")))
  (dk-chain-ass! (dk-cite! 'triv-nf-is-normed-field k))
  (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain k))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-cite! 'triv-nf-carr k) (dk-cite! 'triv-nf-add k)
  (dk-have! `(IN (CARD (CARR ,tn)) NN) (lambda () (subst `(== (CARR ,tn) (CARR ,k))) (dk-ass!)))
  (dk-have! `(IN a5c (FUN (CARR ,tn) UNIT-CIRCLE)) (lambda () (subst `(== (CARR ,tn) (CARR ,k))) (dk-ass!)))
  (dk-have! `(FORALL chx_ (IMPLIES (IN chx_ (CARR ,tn)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,tn))
               (= (a5c ((ADD ,tn) chx_ chy_)) (* (a5c chx_) (a5c chy_)))))))
    (lambda () (subst `(== (CARR ,tn) (CARR ,k))) (subst `(== (ADD ,tn) (ADD ,k))) (dk-ass!)))
  (dk-chain-ass! (dk-cite! 'nf-finite-add-character tn 'a5c))
  (dk-close-if-asm!))
(qed 'triv-nf-add-character)
