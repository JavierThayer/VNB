;;; integral-unique.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/md/md-unique.scm.
;;; Library: measure.

;;; md-unique.scm -- construction-of-measures.pdf Theorem 2.7, the UNIQUENESS half: a function on the measurable
;;; f : X -> [0, +inf] with the notes' properties (1)-(7) is the integral.  (Existence, (1)-(7) for INTEGRAL, is the
;;; tree's: integral-in, -indicator, -infinite-on-null, -additive, -homogeneous, -monotone, monotone-convergence.)
;;; Agent M-D (worker-02), 2026-10-27.  DESTINATION: theorem-library/integral-unique.scm.  Library: measure.
;;; Helper prefix: mdu-.  Load window: after integral-laws.scm, integral-convergence.scm (monotone-convergence,
;;; integral-simple-approx).
;;; Proof: on a simple s, by finite-set induction over subsets W of the range of s, on the truncations
;;; t_W = x |-> (s(x) if s(x) in W else 0); t_{W u {y}} = t_W + y 1_{s = y}, and both J and INTEGRAL are additive,
;;; positively homogeneous and right on indicators.  For a measurable f, a nondecreasing simple sequence with supremum f
;;; (integral-simple-approx) and property (7) against monotone-convergence.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mdu-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MDU OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mdu-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mdu-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mdu-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mdu-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (mdu-tree-sub x y s)) t)) (#t t)))
(define (mdu-mark! . xs)
  (let ((port (open-output-file "/tmp/mdu-trace.txt" #t)))
    (for-each (lambda (x) (write-string (if (string? x) x (expression->string x)) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mdu-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mdu-has-lam? (car l)) (loop (cdr l))))))))
(define (mdu-beta!) (if (mdu-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mdu-if! true? ift k) (dk-if-branch! true? ift #f k))
(define (mdu-rps! t)                   ; (IN t RR), (<= 0 t) in context: (IN t RR-POS-STAR)
  (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))

;;; ---------------------------------------------------------------------------
;;; the pointwise identity of the induction step:
;;;   [s(x) in W u {y}] s(x)  =  [s(x) in W] s(x)  +  y [s(x) = y]       (y not in W)
;;; ---------------------------------------------------------------------------
(define mdu-A '(SEP gx_ omega (= (s gx_) y)))
(define (mdu-tw w x) (list 'IF (list 'IN '(s x) w) '(s x) 0))
(sp (make-wff (mdu-alls '(omega s ww y x)
  (mdu-imps '((IN x omega) (IN (s x) RR) (<= 0 (s x)) (IN y RR) (<= 0 y) (NOT (IN y ww)) (IN ww SET))
    (list '= (mdu-tw '(UNION ww (PAIR y y)) 'x)
             (list 'eplus (mdu-tw 'ww 'x) (list 'etimes 'y (list 'IF (list 'IN 'x mdu-A) 1 0))))))))
(dk-peel!)
(let* ((wp '(UNION ww (PAIR y y))) (sx '(s x))
       (lhs (mdu-tw wp 'x)) (tw (mdu-tw 'ww 'x)) (ia (list 'IF (list 'IN 'x mdu-A) 1 0)))
  (mdu-rps! 'y) (mdu-rps! sx)
  (dk-cite! 'membership-implies-sethood 'y 'RR)
  (dk-cite! 'membership-implies-sethood sx 'RR)
  (fact 'rr-zero-in) (fact 'nn-one-in)
  (dk-have! '(IN 1 RR) (lambda () (arith)))
  (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
  (mdu-rps! 0) (mdu-rps! 1)
  (mdu-and! '(IN y SET) '(IN y SET))
  (let* ((um (dk-cite! 'union-membership 'ww '(PAIR y y) sx))
        (pm (dk-cite! 'pairing-membership 'y 'y)))
    (use-em (list '= sx 'y)
      (lambda ()
        (dk-apply! (dk-ctx-form pm) sx)
        (dk-have! (list 'IN sx '(PAIR y y)) (lambda () (let ((i (dk-ctx-form (list 'IFF (list 'IN sx '(PAIR y y)) (list 'OR (list '= sx 'y) (list '= sx 'y))))))
                                                          (if (dk-only! i (list '= sx 'y)) (prop)))))
        (dk-have! (list 'IN sx wp) (lambda () (if (dk-only! um (list 'IN sx '(PAIR y y))) (prop))))
        (dk-have! (list 'NOT (list 'IN sx 'ww)) (lambda () (subst (list '= sx 'y)) (dk-ass!)))
        (dk-have! (list 'IN 'x mdu-A) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
        (mdu-if! #t lhs
          (lambda ()
            (mdu-if! #f tw
              (lambda ()
                (mdu-if! #t ia
                  (lambda ()
                    (mdu-and! '(IN y RR-POS-STAR) '(IN 1 RR-POS-STAR))
                    (dk-cite! 'etimes-comm 'y 1)
                    (dk-cite! 'etimes-one-left 'y)
                    (dk-cite! 'eplus-zero-left 'y)
                    (subst (list '= (list 'etimes 'y 1) (list 'etimes 1 'y)))
                    (subst (list '= (list 'etimes 1 'y) 'y))
                    (subst (list '= (list 'eplus 0 'y) 'y))
                    (if (not (dk-ass!)) (begin (subst (list '= sx 'y)) (if (not (proof-done? *ps*)) (rfl)))))))))))
      (lambda ()
        (dk-have! (list 'NOT (list 'IN 'x mdu-A))
          (lambda () (di) (sep-me (dk-ctx-form (list 'IN 'x mdu-A))) (dk-split-all!) (ai (list 'NOT (list '= sx 'y)))))
        (dk-apply! (dk-ctx-form pm) sx)
        (dk-have! (list 'NOT (list 'IN sx '(PAIR y y)))
          (lambda () (di) (let ((i (dk-ctx-form (list 'IFF (list 'IN sx '(PAIR y y)) (list 'OR (list '= sx 'y) (list '= sx 'y))))))
                            (dk-have! (list 'OR (list '= sx 'y) (list '= sx 'y)) (lambda () (if (dk-only! i (list 'IN sx '(PAIR y y))) (prop))))
                            (if (dk-only! (list 'OR (list '= sx 'y) (list '= sx 'y)) (list 'NOT (list '= sx 'y))) (prop)))))
        (dk-cite! 'etimes-zero-right 'y)
        (use-em (list 'IN sx 'ww)
          (lambda ()
            (dk-have! (list 'IN sx wp) (lambda () (if (dk-only! um (list 'IN sx 'ww)) (prop))))
            (mdu-if! #t lhs
              (lambda ()
                (mdu-if! #t tw
                  (lambda ()
                    (mdu-if! #f ia
                      (lambda ()
                        (dk-cite! 'eplus-zero-right sx)
                        (subst (list '= (list 'etimes 'y 0) 0))
                        (subst (list '= (list 'eplus sx 0) sx))
                        (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl))))))))))
          (lambda ()
            (dk-have! (list 'NOT (list 'IN sx wp)) (lambda () (di) (dk-have! (caddr um) (lambda () (if (dk-only! um (list 'IN sx wp)) (prop))))
                                                     (if (dk-only! (caddr um) (list 'NOT (list 'IN sx 'ww)) (list 'NOT (list 'IN sx '(PAIR y y)))) (prop))))
            (mdu-if! #f lhs
              (lambda ()
                (mdu-if! #f tw
                  (lambda ()
                    (mdu-if! #f ia
                      (lambda ()
                        (dk-cite! 'eplus-zero-left 0)
                        (subst (list '= (list 'etimes 'y 0) 0))
                        (subst (list '= (list 'eplus 0 0) 0))
                        (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl)))))))))))))))
(mdu-qed! 'integral-unique-step-ptwise)

;;; ---------------------------------------------------------------------------
;;; the hypotheses on J: the notes' properties (1)-(7)
;;; ---------------------------------------------------------------------------
(define (mdu-meas f) (list 'IS-MEASURABLE-FN 'omega 'ca f))
(define mdu-H1 '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (IN (jj mdf_) RR-POS-STAR))))
(define mdu-H2 '(FORALL mda_ (IMPLIES (IN mda_ ca) (= (jj (INDICATOR omega mda_)) (mu mda_)))))
(define mdu-H3 '(FORALL mda_ (IMPLIES (IN mda_ ca) (IMPLIES (= (mu mda_) 0) (= (jj (PTWISE-SCALE omega POS-INF (INDICATOR omega mda_))) 0)))))
(define mdu-H4 '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdg_ (IMPLIES (IS-MEASURABLE-FN omega ca mdg_)
                  (= (jj (PTWISE-EPLUS omega mdf_ mdg_)) (eplus (jj mdf_) (jj mdg_))))))))
(define mdu-H5 '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdc_ (IMPLIES (IN mdc_ RR) (IMPLIES (<= 0 mdc_)
                  (= (jj (PTWISE-SCALE omega mdc_ mdf_)) (etimes mdc_ (jj mdf_)))))))))
(define mdu-H6 '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdg_ (IMPLIES (IS-MEASURABLE-FN omega ca mdg_)
                  (IMPLIES (PTWISE-LE omega mdf_ mdg_) (<= (jj mdf_) (jj mdg_))))))))
(define mdu-H7 '(FORALL mdcf_ (IMPLIES (IN mdcf_ (FUN NN (FUN omega RR-POS-STAR)))
                  (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega ca (mdcf_ n_))))
                    (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (PTWISE-LE omega (mdcf_ n_) (mdcf_ (succ n_)))))
                      (= (jj (PTWISE-SUP omega mdcf_)) (ESUP (IMAGE (VNB-LAMBDA n_ NN (jj (mdcf_ n_))) NN))))))))

;;; ---------------------------------------------------------------------------
;;; on simple functions J is the integral
;;; ---------------------------------------------------------------------------
(define (mdu-trunc w) (list 'VNB-LAMBDA 'mdx_ 'omega (list 'IF (list 'IN '(s mdx_) w) '(s mdx_) 0)))
(define (mdu-P w) (list 'AND (mdu-meas (mdu-trunc w)) (list '= (list 'jj (mdu-trunc w)) (list 'INTEGRAL 'omega 'ca 'mu (mdu-trunc w)))))
(define mdu-V '(IMAGE s omega))
(define mdu-C (list 'SEP 'mdw_ 'SET (list 'IMPLIES (list 'SUBSET 'mdw_ mdu-V) (mdu-P 'mdw_))))
(define mdu-Z '(VNB-LAMBDA cx_ omega 0))
(define (mdu-sx! x)                    ; x in omega: s(x) in RR, in RR-POS-STAR, 0 <= s(x)
  (let ((sx (list 's x)))
    (if (not (dk-asm? (list 'IN sx 'RR-POS-STAR)))
        (begin
          (dk-apply! (dk-ctx-form '(FORALL x_ (IMPLIES (IN x_ omega) (IN (s x_) RR)))) x)
          (dk-cite! 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
          (dk-cite! 'rr-pos-star-nonneg sx)))
    sx))
(define (mdu-fun1! f)                  ; (IN f (FUN omega RR-POS-STAR)) in context: (IN f (FUN omega))
  (if (not (dk-asm? (list 'IN f '(FUN omega))))
      (let ((fi (dk-cite! 'fun-codomain-iff 'omega 'RR-POS-STAR f)))
        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN f '(FUN omega RR-POS-STAR))) (prop))))
        (dk-split! (caddr fi)))))
(define (mdu-tw-fun! w)                ; (IN tW (FUN omega RR-POS-STAR))
  (let ((g (list 'IN (mdu-trunc w) '(FUN omega RR-POS-STAR))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (sx (mdu-sx! x)))
                                                           (mdu-beta!)
                                                           (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                                               (dk-case-if! (dk-pick-if (dk-goal)) (lambda (t? v) (dk-ass!))))))
                                             (lambda () (dk-ass!))))))
    g))
(define (dk-pick-if t)                 ; the first IF subterm of t
  (cond ((and (pair? t) (eq? (car t) 'IF)) t)
        ((pair? t) (or (dk-pick-if (car t)) (dk-pick-if (cdr t))))
        (#t #f)))
(define (mdu-funext! f g pt!)          ; f, g in FUN(omega, RR-POS-STAR) in context; PT! x proves (= (f x) (g x)): (= f g)
  (mdu-fun1! f) (mdu-fun1! g)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list f 'x) (list g 'x))))
    (lambda () (let ((x (dk-di-var!))) (pt! x))))
  (dk-cite! 'fun-domain-extensionality 'omega f g))

(define (mdu-step! w y)               ; W in SET, CARD W in NN, W in C, y in SET, y not in W; goal (IN (UNION W {y}) C)
  (let* ((py (list 'PAIR y y)) (wp (list 'UNION w py)) (tw (mdu-trunc w)) (twp (mdu-trunc wp))
         (A (list 'SEP 'gx_ 'omega (list '= '(s gx_) y))) (mdu-ind (list 'INDICATOR 'omega A))
         (Sy (list 'PTWISE-SCALE 'omega y mdu-ind)) (mdu-esum (list 'PTWISE-EPLUS 'omega tw Sy)))
    (mdu-and! (list 'IN y 'SET) (list 'IN y 'SET))
    (dk-cite! 'pairing y y)
    (mdu-and! (list 'IN w 'SET) (list 'IN py 'SET))
    (dk-cite! 'union-set-closure w py)
    (in-sep! (lambda () (dk-ass!))
      (lambda ()
        (di)
        (dk-have! (list 'SUBSET w wp)
          (lambda () (mac 'subset-def)
                     (let* ((ev (dk-di-var!)) (um (dk-cite! 'union-membership w py ev)))
                       (if (dk-only! um (list 'IN ev w)) (prop)))))
        (mdu-and! (list 'SUBSET w wp) (list 'SUBSET wp mdu-V))
        (dk-cite! 'subset-trans w wp mdu-V)
        (dk-have! (list 'IMPLIES (list 'SUBSET w mdu-V) (mdu-P w))
          (lambda () (sep-me (dk-ctx-form (list 'IN w mdu-C))) (dk-split-all!) (dk-ass!)))
        (dk-split! (dk-apply! (dk-ctx-form (list 'IMPLIES (list 'SUBSET w mdu-V) (mdu-P w)))))
        ;; y is a value of s, hence a nonnegative real
        (let ((pm (dk-cite! 'pairing-membership y y)))
          (dk-apply! (dk-ctx-form pm) y)
          (dk-have! (list 'IN y py) (lambda () (let ((pmi (dk-ctx-form (list 'IFF (list 'IN y py) (list 'OR (list '= y y) (list '= y y))))))
                                                  (dk-have! (list '= y y) (lambda () (rfl)))
                                                  (if (dk-only! pmi (list '= y y)) (prop))))))
        (let ((um (dk-cite! 'union-membership w py y)))
          (dk-have! (list 'IN y wp) (lambda () (if (dk-only! um (list 'IN y py)) (prop)))))
        (dk-cite! 'subset-mem-fwd wp mdu-V y)
        (let* ((im (dk-cite! 'image-membership-iff 's 'omega y)))
          (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN y mdu-V)) (prop))))
          (dk-split! (caddr im))
          (let* ((x0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y) (dk-contains? h 's))) "the preimage") #t)))
            (mdu-sx! x0)
            (dk-have! (list 'IN y 'RR) (lambda () (subst (list '= y (list 's x0))) (dk-ass!)))
            (dk-have! (list '<= 0 y) (lambda () (subst (list '= y (list 's x0))) (dk-ass!)))))
        (mdu-rps! y)
        (dk-apply! (dk-cite! 'measurable-fn-level-set 'omega 'ca 's) y)
        (dk-cite! 'measurable-fn-indicator 'omega 'ca A)
        (dk-cite! 'ptwise-scale-measurable 'omega 'ca mdu-ind y)
        (dk-cite! 'measurable-fn-eplus 'omega 'ca tw Sy)
        (dk-project! (list 'IN mdu-esum '(FUN omega RR-POS-STAR)) 'is-measurable-fn (mdu-meas mdu-esum))
        (mdu-tw-fun! wp)
        (mdu-funext! twp mdu-esum
          (lambda (x) (mdu-sx! x)
                      (mac 'PTWISE-EPLUS) (mac 'PTWISE-SCALE) (mac 'INDICATOR)
                      (mdu-beta!)
                      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                          (begin (dk-cite! 'integral-unique-step-ptwise 'omega 's w y x) (dk-ass!)))))
        (dk-apply! (dk-ctx-form mdu-H4) tw Sy)
        (dk-apply! (dk-ctx-form mdu-H5) mdu-ind y)
        (dk-apply! (dk-ctx-form mdu-H2) A)
        (dk-cite! 'integral-additive 'omega 'ca 'mu tw Sy)
        (dk-cite! 'integral-homogeneous 'omega 'ca 'mu mdu-ind y)
        (dk-cite! 'integral-indicator 'omega 'ca 'mu A)
        (subst (list '= twp mdu-esum))
        (let ((eq (list '= (list 'jj mdu-esum) (list 'INTEGRAL 'omega 'ca 'mu mdu-esum))))
          (dk-have! eq
            (lambda ()
              (subst (list '= (list 'jj mdu-esum) (list 'eplus (list 'jj tw) (list 'jj Sy))))
              (subst (list '= (list 'jj Sy) (list 'etimes y (list 'jj mdu-ind))))
              (subst (list '= (list 'jj mdu-ind) (list 'mu A)))
              (subst (list '= (list 'jj tw) (list 'INTEGRAL 'omega 'ca 'mu tw)))
              (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu mdu-esum) (list 'eplus (list 'INTEGRAL 'omega 'ca 'mu tw) (list 'INTEGRAL 'omega 'ca 'mu Sy))))
              (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu Sy) (list 'etimes y (list 'INTEGRAL 'omega 'ca 'mu mdu-ind))))
              (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu mdu-ind) (list 'mu A)))
              (let* ((it (list 'INTEGRAL 'omega 'ca 'mu tw)) (ma (list 'mu A)) (ey (list 'etimes y ma)))
                (dk-cite! 'integral-in 'omega 'ca 'mu tw)
                (dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
                (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR A)
                (mdu-and! (list 'IN y 'RR-POS-STAR) (list 'IN ma 'RR-POS-STAR))
                (dk-cite! 'etimes-closed y ma)
                (mdu-and! (list 'IN it 'RR-POS-STAR) (list 'IN ey 'RR-POS-STAR))
                (dk-cite! 'eplus-closed it ey))
              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
         
          (mdu-and! (mdu-meas mdu-esum) eq))))))
(sp (make-wff (mdu-alls '(omega ca mu jj s)
  (mdu-imps (list '(IS-MEASURE omega ca mu) mdu-H1 mdu-H2 mdu-H4 mdu-H5 '(IS-SIMPLE-FN omega ca s))
    '(= (jj s) (INTEGRAL omega ca mu s))))))
(dk-peel!)
(dk-project! '(IS-MEASURABLE-FN omega ca s) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(IN (CARD (IMAGE s omega)) NN) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(FORALL x_ (IMPLIES (IN x_ omega) (IN (s x_) RR))) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca s))
(dk-project! '(IN s (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca s))
(dk-cite! 'fun-domain-in-set 'omega 'RR-POS-STAR 's)
(dk-cite! 'image-set 's 'omega)
(fact 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(mdu-rps! 0)
(fact 'empty-set-is-set)
(let* ((ind (dk-cite! 'finite-set-induction mdu-C)) (ante (cadr ind)))
  (dk-have! ante
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              ;; the base: t_{} is the zero function
              (in-sep! (lambda () (dk-ass!))
                (lambda ()
                  (di)
                  (let* ((t0 (mdu-trunc 'EMPTY-SET)) (ps (list 'PTWISE-SCALE 'omega 0 mdu-Z)))
                    (mdu-tw-fun! 'EMPTY-SET)
                    (dk-cite! 'measurable-fn-const 'omega 'ca 0)
                    (dk-project! (list 'IN mdu-Z '(FUN omega RR-POS-STAR)) 'is-measurable-fn (mdu-meas mdu-Z))
                    (mdu-funext! t0 mdu-Z
                      (lambda (x) (dk-cite! 'empty-set-has-no-members (list 's x)) (mdu-sx! x)
                                  (mdu-beta!)
                                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                      (mdu-if! #f (dk-pick-if (dk-goal)) (lambda () (if (not (dk-ass!)) (rfl)))))))
                    (dk-cite! 'ptwise-scale-measurable 'omega 'ca mdu-Z 0)
                    (dk-project! (list 'IN ps '(FUN omega RR-POS-STAR)) 'is-measurable-fn (mdu-meas ps))
                    (mdu-funext! mdu-Z ps
                      (lambda (x) (mac 'PTWISE-SCALE) (mdu-beta!)
                                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                      (begin (dk-cite! 'etimes-zero-left 0) (subst '(= (etimes 0 0) 0)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
                    (dk-apply! (dk-ctx-form mdu-H5) mdu-Z 0)
                    (dk-apply! (dk-ctx-form mdu-H1) mdu-Z)
                    (dk-cite! 'etimes-zero-left (list 'jj mdu-Z))
                    (dk-congr! (list '= mdu-Z ps) (lambda (t) (list 'jj t)))
                    (dk-cite! 'integral-zero-fn 'omega 'ca 'mu)
                    (subst (list '= t0 mdu-Z))
                    (dk-have! (list '= (list 'jj mdu-Z) 0)
                      (lambda () (subst (list '= (list 'jj mdu-Z) (list 'jj ps)))
                                 (subst (list '= (list 'jj ps) (list 'etimes 0 (list 'jj mdu-Z))))
                                 (subst (list '= (list 'etimes 0 (list 'jj mdu-Z)) 0))
                                 (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                    (dk-have! (list '= (list 'jj mdu-Z) (list 'INTEGRAL 'omega 'ca 'mu mdu-Z))
                      (lambda () (subst (list '= (list 'jj mdu-Z) 0)) (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu mdu-Z) 0))
                                 (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                    (mdu-and! (mdu-meas mdu-Z) (list '= (list 'jj mdu-Z) (list 'INTEGRAL 'omega 'ca 'mu mdu-Z))))))
              ;; the step
              (let* ((ld (dk-peel!)))
                (dk-split-all!)
                (let* ((g (dk-goal)) (wp (cadr g)) (w (cadr wp)) (y (cadr (caddr wp))))
                  (mdu-step! w y))))))))
  (dk-have! (list 'IN mdu-V mdu-C) (lambda () (mdu-and! (list 'IN mdu-V 'SET) (list 'IN (list 'CARD mdu-V) 'NN)) (dk-cite! 'finite-set-induction mdu-C)
                                             (dk-apply! (dk-ctx-form (caddr ind)) mdu-V) (dk-ass!))))
(sep-me (dk-ctx-form (list 'IN mdu-V mdu-C)))
(dk-split-all!)
(dk-have! (list 'SUBSET mdu-V mdu-V) (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-ass!))))
(let* ((tv (mdu-trunc mdu-V)) (pv (dk-apply! (dk-ctx-form (list 'IMPLIES (list 'SUBSET mdu-V mdu-V) (mdu-P mdu-V))))))
  (dk-split! (mdu-P mdu-V))
  (mdu-tw-fun! mdu-V)
  (mdu-funext! tv 's
    (lambda (x) (let ((sx (mdu-sx! x)))
                  (dk-cite! 'membership-implies-sethood sx 'RR)
                  (let ((im (dk-cite! 'image-membership-iff 's 'omega sx)))
                    (dk-have! (caddr (caddr im)) (lambda () (ew x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
                    (mdu-and! (list 'IN sx 'SET) (caddr (caddr im)))
                    (dk-have! (list 'IN sx mdu-V) (lambda () (if (dk-only! im (caddr im)) (prop)))))
                  (mdu-beta!)
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                      (mdu-if! #t (dk-pick-if (dk-goal)) (lambda () (if (not (dk-ass!)) (rfl))))))))
  (let ((e (dk-rewrite-h! (list '= (list 'jj tv) (list 'INTEGRAL 'omega 'ca 'mu tv)) tv 's)))
    (dk-ass!)))
(mdu-qed! 'integral-unique-simple)

(define (mdu-cfn! cf n)
  (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-SIMPLE-FN 'omega 'ca (list cf 'n_))))) n)
  (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cf 'n_))))) n)
  (dk-apply! (dk-ctx-form mdu-H1) (list cf n))
  (dk-cite! 'integral-in 'omega 'ca 'mu (list cf n)))
;;; ---------------------------------------------------------------------------
;;; THEOREM 2.7, uniqueness: a function on the measurable f : X -> [0, +inf] with properties (1)-(7) is the integral
;;; ---------------------------------------------------------------------------
(sp (make-wff (mdu-alls '(omega ca mu jj)
  (mdu-imps (list '(IS-MEASURE omega ca mu) mdu-H1 mdu-H2 mdu-H3 mdu-H4 mdu-H5 mdu-H6 mdu-H7)
    '(FORALL f (IMPLIES (IS-MEASURABLE-FN omega ca f) (= (jj f) (INTEGRAL omega ca mu f))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca f))
(dk-project! '(IN f (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca f))
(let* ((ex (dk-cite! 'integral-simple-approx 'omega 'ca 'f))
       (cf (dk-skolem! ex #t))
       (sup (list 'PTWISE-SUP 'omega cf))
       (lj (list 'VNB-LAMBDA 'n_ 'NN (list 'jj (list cf 'n_))))
       (li (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'ca 'mu (list cf 'n_)))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cf 'n_))))
    (lambda () (let ((n (dk-di-var!)))
                 (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-SIMPLE-FN 'omega 'ca (list cf 'n_))))) n)
                 (dk-project! (list 'IS-MEASURABLE-FN 'omega 'ca (list cf n)) 'is-simple-fn (list 'IS-SIMPLE-FN 'omega 'ca (list cf n))))))
  (dk-split! (dk-cite! 'monotone-convergence 'omega 'ca 'mu cf))
  (dk-apply! (dk-ctx-form mdu-H7) cf)
  ;; the two sequences of values agree: J = INTEGRAL on each simple cf(n)
  (for-each (lambda (lam)
              (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
                (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (mdu-cfn! cf n) (dk-ass!))) (lambda () (dk-ass!)))))
              (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR-POS-STAR lam)))
                (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN lam '(FUN NN RR-POS-STAR))) (prop))))
                (dk-split! (caddr fi))))
            (list lj li))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list '= (list lj 'x) (list li 'x))))
    (lambda () (let ((n (dk-di-var!)))
                 (mdu-cfn! cf n)
                 (dk-cite! 'integral-unique-simple 'omega 'ca 'mu 'jj (list cf n))
                 (mdu-beta!)
                 (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))))
  (dk-cite! 'fun-domain-extensionality 'NN lj li)
  ;; the supremum of the sequence is f
  (dk-project! (list 'IN sup '(FUN omega RR-POS-STAR)) 'is-measurable-fn (mdu-meas sup))
  (mdu-funext! sup 'f (lambda (x) (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list '= (list sup 'x_) '(f x_))))) x) (dk-ass!)))
  (dk-cite! 'integral-in 'omega 'ca 'mu sup)
  (subst (list '= 'f sup))
  (subst (list '= (list 'jj sup) (list 'ESUP (list 'IMAGE lj 'NN))))
  (subst (list '= lj li))
  (subst (list '= (list 'INTEGRAL 'omega 'ca 'mu sup) (list 'ESUP (list 'IMAGE li 'NN))))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(mdu-qed! 'integral-unique)
