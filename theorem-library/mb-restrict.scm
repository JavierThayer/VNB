;;; mb-restrict.scm -- construction-of-measures.pdf Prop. 3.4: "If nu is a complete countably
;;; additive measure on B, then for any sigma-subalgebra A of B, nu extends the completion of
;;; nu restricted to A".  Agent M-B, 2026-10-26.
;;; DESTINATION: theorem-library/mb-restrict.scm.  Library: measure.
;;;
;;;   measure-restrict                a measure restricted to a sub-sigma-algebra is a measure
;;;                                   (RES(nu, cA); the restriction the notes write nu|A)
;;;   completion-of-restrict-in       the completion of cA for nu|A lies inside cB (nu complete)
;;;   complete-extends-completion     Prop. 3.4: on it, nu equals the completion measure of nu|A
;;;
;;; THE ROUTE: the notes' for the inclusion (a nu|A-null set is nu-null, hence in cB by
;;; completeness); for the values, completion-measure-unique applied to nu restricted to the
;;; completion, which is a measure there (measure-restrict) agreeing with nu|A on cA.
;;; CITATIONS: is-measure, is-complete-measure, res-apply, res-codomain, fun-codomain-iff,
;;; fun-codomain-superset, sigma-algebra-union-closed(-2), completion-sigma-algebra,
;;; completion-sigma-membership, completion-measure-unique (mb-completion).
;;; LOAD WINDOW: after mb-completion; no citer.
;;; Helper prefix: mbr-.

(define (mbr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define (mbr-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))

(define (mbr-measure-parts! om ca mu)
  (let* ((iff (dk-fact! 'is-measure om ca mu))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs))) (c3 (cadr (caddr (caddr rhs)))) (c4 (caddr (caddr (caddr rhs)))))
    (map (lambda (c) (dk-project! c 'IS-MEASURE (list 'IS-MEASURE om ca mu)))
         (list c1 c2 c3 c4))))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL omega (FORALL cB (FORALL nu (FORALL cA
  (IMPLIES (IS-MEASURE omega cB nu)
    (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
      (IMPLIES (SUBSET cA cB)
        (IS-MEASURE omega cA (RES nu cA)))))))))))
(dk-peel!)
(let* ((parts (mbr-measure-parts! 'omega 'cB 'nu))
       (add (list-ref parts 3))
       (rs '(RES nu cA)))
  (dk-project! '(IN nu (FUN cB)) 'fun-codomain-iff '(IN nu (FUN cB RR-POS-STAR)))
  (mbr-and! '(IN nu (FUN cB RR-POS-STAR)) '(SUBSET cA cB))
  (dk-cite! 'res-codomain 'cB 'cA 'RR-POS-STAR 'nu)
  (mac 'IS-MEASURE)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? g '=)
           (fact 'sigma-algebra-empty-in 'omega 'cA)
           (mbr-and! '(IN nu (FUN cB)) '(SUBSET cA cB) '(IN EMPTY-SET cA))
           (dk-cite! 'res-apply 'cB 'cA 'nu 'EMPTY-SET)
           (subst (list '= (list rs 'EMPTY-SET) '(nu EMPTY-SET)))
           (dk-ass!))
          (#t
           (let* ((landed (dk-peel!))
                  (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'FUN))) landed)))
                  (fu (list 'BIG-UNION 'n_ 'NN (list fv 'n_)))
                  (lam-r (list 'VNB-LAMBDA 'n_ 'NN (list rs (list fv 'n_))))
                  (lam-n (list 'VNB-LAMBDA 'n_ 'NN (list 'nu (list fv 'n_)))))
             (dk-cite! 'fun-codomain-superset fv 'NN 'cA 'cB)
             (let ((inst (inst*! add fv)))
               (let loop ((f inst))
                 (if (and (dk-head-is? f 'IMPLIES) (dk-asm? (cadr f)))
                     (begin (detach! f) (loop (caddr f))))))
             (dk-cite! 'sigma-algebra-union-closed 'omega 'cA fv)
             (mbr-and! '(IN nu (FUN cB)) '(SUBSET cA cB) (list 'IN fu 'cA))
             (dk-cite! 'res-apply 'cB 'cA 'nu fu)
             (subst (list '= (list rs fu) (list 'nu fu)))
             (dk-fun-ext! lam-r lam-n 'NN 'RR-POS-STAR
               (lambda () (dk-lam-type! (lambda ()
                 (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (fact 'fun-apply-type-c fv 'NN 'cA kv)
                   (dk-cite! 'fun-apply-type-c rs 'cA 'RR-POS-STAR (list fv kv))
                   (dk-ass!)))))
               (lambda () (dk-lam-type! (lambda ()
                 (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (fact 'fun-apply-type-c fv 'NN 'cB kv)
                   (dk-cite! 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR (list fv kv))
                   (dk-ass!)))))
               (lambda (kv)
                 (fact 'fun-apply-type-c fv 'NN 'cA kv)
                 (fact 'fun-apply-type-c fv 'NN 'cB kv)
                 (dk-lam-b!)
                 (mbr-and! '(IN nu (FUN cB)) '(SUBSET cA cB) (list 'IN (list fv kv) 'cA))
                 (dk-cite! 'res-apply 'cB 'cA 'nu (list fv kv))
                 (dk-ass!)))
             (subst (list '= lam-r lam-n))
             (dk-ass!))))))))
(mbr-qed! 'measure-restrict)

(define mbr-rs '(RES nu cA))
(define mbr-cs '(COMPLETION-SIGMA omega cA (RES nu cA)))
(define mbr-cm '(COMPLETION-MEASURE omega cA (RES nu cA)))

;;; the completion of cA for nu|A lies inside cB when nu is complete
(sp (make-wff '(FORALL omega (FORALL cB (FORALL nu (FORALL cA
  (IMPLIES (IS-COMPLETE-MEASURE omega cB nu)
    (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
      (IMPLIES (SUBSET cA cB)
        (SUBSET (COMPLETION-SIGMA omega cA (RES nu cA)) cB))))))))))
(dk-peel!)
(let ((cmp '(IS-COMPLETE-MEASURE omega cB nu))
      (call '(FORALL nls_ (IMPLIES (IS-NULL-SET omega cB nu nls_) (IN nls_ cB)))))
  (dk-have! '(IS-MEASURE omega cB nu) (lambda () (mac-h 'IS-COMPLETE-MEASURE cmp) (dk-split-all!) (ass)))
  (dk-have! call (lambda () (mac-h 'IS-COMPLETE-MEASURE cmp) (dk-split-all!) (ass)))
  (mbr-measure-parts! 'omega 'cB 'nu)
  (dk-project! '(IN nu (FUN cB)) 'fun-codomain-iff '(IN nu (FUN cB RR-POS-STAR)))
  (dk-cite! 'measure-restrict 'omega 'cB 'nu 'cA)
  (mac 'subset-def)
  (let* ((w (dk-di-var!))
         (i (dk-cite! 'completion-sigma-membership 'omega 'cA mbr-rs w)))
    (dk-have! (caddr i) (lambda () (if (dk-only! i (list 'IN w mbr-cs)) (prop))))
    (let* ((parts (dk-split! (caddr i)))
           (ex1 (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
           (a (dk-skolem! ex1 #t))
           (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a) (dk-contains? f w)))
                         "the null part"))
           (n (dk-skolem! ex2 #t))
           (n0 (dk-skolem! (dk-landed-1 (lambda () (mac-h 'IS-NULL-SET (list 'IS-NULL-SET 'omega 'cA mbr-rs n)))) #t)))
      (dk-cite! 'subset-mem-fwd 'cA 'cB a)
      (dk-cite! 'subset-mem-fwd 'cA 'cB n0)
      (mbr-and! '(IN nu (FUN cB)) '(SUBSET cA cB) (list 'IN n0 'cA))
      (dk-cite! 'res-apply 'cB 'cA 'nu n0)
      (dk-rewrite-h! (list '= (list mbr-rs n0) 0) (list mbr-rs n0) (list 'nu n0))
      (dk-have! (list 'IS-NULL-SET 'omega 'cB 'nu n)
        (lambda () (mac 'IS-NULL-SET) (ew n0) (dk-conj-close! dk-ass!)))
      (inst*! call n)
      (dk-cite! 'sigma-algebra-union-closed-2 'omega 'cB a n)
      (subst (list '= w (list 'UNION a n)))
      (dk-ass!))))
(mbr-qed! 'completion-of-restrict-in)

;;; Prop. 3.4: nu equals the completion measure of nu|A on the completion of cA
(sp (make-wff '(FORALL omega (FORALL cB (FORALL nu (FORALL cA
  (IMPLIES (IS-COMPLETE-MEASURE omega cB nu)
    (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
      (IMPLIES (SUBSET cA cB)
        (FORALL x (IMPLIES (IN x (COMPLETION-SIGMA omega cA (RES nu cA)))
          (= (nu x) ((COMPLETION-MEASURE omega cA (RES nu cA)) x)))))))))))))
(dk-peel!)
(let* ((cmp '(IS-COMPLETE-MEASURE omega cB nu))
       (rcs (list 'RES 'nu mbr-cs)))
  (dk-have! '(IS-MEASURE omega cB nu) (lambda () (mac-h 'IS-COMPLETE-MEASURE cmp) (dk-split-all!) (ass)))
  (mbr-measure-parts! 'omega 'cB 'nu)
  (dk-project! '(IN nu (FUN cB)) 'fun-codomain-iff '(IN nu (FUN cB RR-POS-STAR)))
  (dk-cite! 'measure-restrict 'omega 'cB 'nu 'cA)
  (dk-cite! 'completion-sigma-algebra 'omega 'cA mbr-rs)
  (dk-cite! 'completion-of-restrict-in 'omega 'cB 'nu 'cA)
  (dk-cite! 'measure-restrict 'omega 'cB 'nu mbr-cs)
  (dk-have! (list 'FORALL 'aa (list 'IMPLIES '(IN aa cA) (list '= (list rcs 'aa) (list mbr-rs 'aa))))
    (lambda ()
      (let ((av (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
        (dk-cite! 'completion-sigma-contains 'omega 'cA mbr-rs av)
        (mbr-and! '(IN nu (FUN cB)) (list 'SUBSET mbr-cs 'cB) (list 'IN av mbr-cs))
        (dk-cite! 'res-apply 'cB mbr-cs 'nu av)
        (mbr-and! '(IN nu (FUN cB)) '(SUBSET cA cB) (list 'IN av 'cA))
        (dk-cite! 'res-apply 'cB 'cA 'nu av)
        (subst (list '= (list rcs av) (list 'nu av)))
        (subst (list '= (list mbr-rs av) (list 'nu av)))
        (rfl))))
  (let ((u (dk-cite! 'completion-measure-unique 'omega 'cA mbr-rs rcs)))
    (inst*! u 'x))
  (mbr-and! '(IN nu (FUN cB)) (list 'SUBSET mbr-cs 'cB) (list 'IN 'x mbr-cs))
  (dk-cite! 'res-apply 'cB mbr-cs 'nu 'x)
  (subst (list '= '(nu x) (list rcs 'x)))
  (dk-ass!))
(mbr-qed! 'complete-extends-completion)
