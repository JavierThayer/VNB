;;; ch3c-gen.scm -- general lemmas for the general Cauchy theorem.  Prefix cm-.  Library: analysis.
;;; Destination: theorem-library/compact-margins.scm.
;;;
;;;   compact-open-margin   K compact inside an open u of CC  ==>  some eps > 0 with B(z, eps) in u
;;;                         for every z in K (the notes' eps = d(K, C \ U) > 0, 3.11 and 3.17)
;;;
;;; Heine-Cantor (a continuous map on a compact metric space is uniformly continuous) is
;;; compact-continuous-uniformly-continuous of scratchpad/isom/isom-uc.scm (agent ISOM, calculus 3.21),
;;; cited where it is needed, not re-proved here.

(define (mh2-split-goal-cm!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
;;; the right side of IFF, from the left side in context, landed and returned
(define (dk-have-f-cm! rhs iff lhs)
  (dk-have! rhs (lambda () (if (dk-only! iff lhs) (prop))))
  rhs)
(define (cm-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "cm-pick: nothing matching" what) (car l))))

(define (cm-rs x) (list 'SEP 'cmr_ 'RR (list 'AND '(< 0 cmr_) (list 'SUBSET (list 'BALL 'CC-MS x '(* 2 cmr_)) 'u))))
(define (cm-hx x) (list 'CHOICE (cm-rs x)))
(define cm-h (list 'VNB-LAMBDA 'cmx_ 'kk (cm-hx 'cmx_)))
(define (cm-ns x) (list 'SEP 'cmm_ 'NN (list '<= 1 (list '* 'cmm_ (cm-hx x)))))
(define cm-nf (list 'VNB-LAMBDA 'cmx_ 'cmp_ (list 'CHOICE (cm-ns 'cmx_))))

(sp (make-wff (forall-guarded '(kk u) '((SUBSET kk u) (IS-OPEN CC-MS u) (IS-COMPACT (SUBSPACE-MS CC-MS kk)))
  '(FORSOME cme_ (AND (POS-RR cme_) (FORALL cmz_ (IMPLIES (IN cmz_ kk) (SUBSET (BALL CC-MS cmz_ cme_) u))))))))
(dk-peel!)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'cc-is-set)
(let* ((rhs (caddr (dk-cite! 'is-open 'CC-MS 'u))))
  (dk-project! rhs 'is-open '(IS-OPEN CC-MS u))
  (dk-split-all! (list rhs)))
(dk-rewrite-h! '(SUBSET u (PTS CC-MS)) '(PTS CC-MS) 'CC)
(fact 'subset-trans 'kk 'u 'CC)
(fact 'subclass-of-set-is-set 'kk 'CC)
(define cm-op (cm-pick 'op (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'BALL)))))
;;; x in kk: the chosen half-radius c (ball(x, 2c) inside u), typed and positive; returns c
(define (cm-rad! x)
  (let* ((sv (cm-rs x)) (c (list 'CHOICE sv)))
    (if (not (dk-asm? (list 'IN c sv)))
        (begin
          (fact 'subset-mem-fwd 'kk 'u x)
          (let* ((r (dk-skolem! (dk-apply! cm-op x) #t))
                 (d (dk-halve! r)))
            (dk-pos-parts! r)
            (dk-have! (list '= (list '* 2 d) r)
              (lambda () (dk-ineq! (cm-pick 'half (lambda (z) (and (dk-head-is? z '=) (dk-contains? z d) (dk-contains? z r)))))))
            (dk-have! (list 'SUBSET (list 'BALL 'CC-MS x (list '* 2 d)) 'u)
              (lambda () (subst (list '= (list '* 2 d) r)) (ass)))
            (dk-have! (list 'IN d sv) (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
            (dk-have! (list 'FORSOME 'cmw_ (list 'IN 'cmw_ sv)) (lambda () (ew d) (ass)))
            (dk-cite! 'choice-axiom sv)
            (sep-me (list 'IN c sv))
            (dk-split-all!))))
    c))
(dk-have! (list 'IN cm-h '(FUN kk RR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (cm-rad! x) (ass))) (lambda () (ass)))))
(dk-have! (list 'FORALL 'wcvx_ (list 'IMPLIES '(IN wcvx_ kk) (list '< 0 (list cm-h 'wcvx_))))
  (lambda () (let ((x (dk-di-var!))) (cm-rad! x) (if (not (dk-lam-b!)) (ass)))))
(let* ((P (dk-skolem! (dk-cite! 'compact-cover-by-balls 'kk cm-h) 'top))
       (_sp (dk-split-all!))
       (cov (cm-pick 'cov (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z P) (dk-contains? z 'BALL)))))
       (nf (list 'VNB-LAMBDA 'cmx_ P (list 'CHOICE (cm-ns 'cmx_))))
       (T (list 'IMAGE nf P)))
  (dk-split-all!)
  (fact 'subclass-of-set-is-set P 'kk)
  (fact 'card-image-finite nf P)
  ;; x in P: its threshold N with 1 <= N c; returns N
  (letrec ((thr! (lambda (x)
                   (let* ((sv (cm-ns x)) (n (list 'CHOICE sv)))
                     (if (not (dk-asm? (list 'IN n sv)))
                         (let* ((_ (fact 'subset-mem-fwd P 'kk x)) (c (cm-rad! x)))
                           (fact 'rr-pos-rr-of-lt c)
                           (dk-have! '(IN 1 RR))
                           (let ((n0 (dk-skolem! (dk-apply! (dk-cite! 'rr-archimedean-multiple c) 1) #t)))
                             (dk-have! (list 'IN n0 sv) (lambda () (in-sep! (lambda () (ass)))))
                             (dk-have! (list 'FORSOME 'cmw_ (list 'IN 'cmw_ sv)) (lambda () (ew n0) (ass)))
                             (dk-cite! 'choice-axiom sv)
                             (sep-me (list 'IN n sv))
                             (dk-split-all!))))
                     n))))
    (dk-have! (list 'SUBSET T 'NN)
      (lambda ()
        (let* ((y (subset-by-element!))
               (iff (dk-cite! 'image-membership-iff nf P y)))
          (dk-have! (caddr iff) (lambda () (prop)))
          (dk-split! (caddr iff))
          (let* ((x (dk-skolem! (cm-pick 'mem (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm y)))) #t))
                 (n (thr! x)))
            (dk-lam-b-h! (list '= (list nf x) y))
            (subst (list '= y n))
            (ass)))))
    (let* ((M (dk-skolem! (dk-cite! 'nn-finite-subset-bounded T) 'top))
           (mb (cm-pick 'mb (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm M) (dk-contains? fm T)))))
           (M1 (list '+ M 1)) (e (list 'recip M1)))
      (fact 'nn-in-rr M) (dk-have! '(IN 1 RR)) (dk-have! '(IN 0 RR))
      (dk-have! (list 'AND (list 'IN M 'RR) '(IN 1 RR))) (fact 'rr-add-closed M 1)
      (dk-have! '(IN 0 NN))
      (fact 'nn-in-rr 0)
      (dk-have! (list '<= 0 M) (lambda () (dk-nn!)))
      (dk-have! (list '< 0 M1) (lambda () (dk-ineq! (list '<= 0 M))))
      (fact 'rr-pos-ne-zero M1)
      (dk-have! (list 'AND (list 'IN M1 'RR) (list 'NOT (list '= M1 0))))
      (fact 'rr-recip-closed M1) (fact 'rr-recip-pos M1) (fact 'rr-recip-inverse M1)
      (fact 'rr-pos-rr-of-lt e)
      (ew e)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-asm? (dk-goal)) (ass)
             (let* ((pl (dk-peel!)) (z (cadr (car pl)))
                    (x (dk-skolem! (dk-apply! cov z) 'top)))
               (fact 'subset-mem-fwd P 'kk x)
               (let* ((c (cm-rad! x)) (n (thr! x)))
                 (dk-lam-b-h! (list 'IN z (list 'BALL 'CC-MS x (list cm-h x))))
                 ;; n is in T, so n < M, so 1 <= n c <= (M + 1) c, so e <= c
                 (dk-have! (list 'IN n T)
                   (lambda ()
                     (let ((iff (dk-cite! 'image-membership-iff nf P n)))
                       (dk-have! (caddr iff)
                         (lambda ()
                           (dk-conj-close!
                             (lambda ()
                               (cond ((dk-asm? (dk-goal)) (ass))
                                     ((dk-head-is? (dk-goal) 'IN) (fact 'membership-implies-sethood n 'NN) (ass))
                                     (#t (ew x) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (rfl)))))))))))
                       (prop))))
                 (fact 'nn-in-rr n)
                 (dk-have! (list '<= n M1)
                   (lambda ()
                     (use-em (list '<= M n)
                       (lambda () (let ((ni (dk-apply! mb n))) (if (dk-only! ni (list 'IN n T)) (prop))))
                       (lambda () (dk-cite! 'rr-not-le-lt M n) (dk-ineq! (list '< n M))))))
                 (dk-have! (list 'AND (list 'IN n 'RR) (list 'IN c 'RR))) (fact 'rr-mul-closed n c)
                 (dk-have! (list 'AND (list 'IN M1 'RR) (list 'IN c 'RR))) (fact 'rr-mul-closed M1 c)
                 (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c))))
                 (dk-have! (list 'AND (list '<= 0 c) (list '<= n M1)))
                 (fact 'rr-le-scale-nonneg-right n M1 c)
                 (dk-have! (list '<= 1 (list '* M1 c)) (lambda () (dk-ineq! (list '<= 1 (list '* n c)) (list '<= (list '* n c) (list '* M1 c)))))
                 (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
                 (dk-have! (list 'AND (list '<= 0 e) (list '<= 1 (list '* M1 c))))
                 (fact 'rr-le-scale-nonneg e 1 (list '* M1 c))
                 (dk-have! (list 'AND (list 'IN e 'RR) (list 'IN (list '* M1 c) 'RR))) (fact 'rr-mul-closed e (list '* M1 c))
                 (dk-have! (list 'AND (list 'IN e 'RR) '(IN 1 RR))) (fact 'rr-mul-closed e 1)
                 (dk-have! (list '= (list '* e (list '* M1 c)) c)
                   (lambda ()
                     (dk-have! (list '= (list '* e (list '* M1 c)) (list '* (list '* M1 e) c)) (lambda () (dk-crs-opaque!)))
                     (subst (list '= (list '* e (list '* M1 c)) (list '* (list '* M1 e) c)))
                     (subst (list '= (list '* M1 e) 1))
                     (crs)))
                 (dk-have! (list '= (list '* e 1) e) (lambda () (dk-crs-opaque!)))
                 (dk-have! (list '<= e c)
                   (lambda () (dk-ineq! (list '<= (list '* e 1) (list '* e (list '* M1 c)))
                                        (list '= (list '* e (list '* M1 c)) c) (list '= (list '* e 1) e))))
                 ;; the ball of radius e about z lies in the ball of radius 2c about x, inside u
                 (mac 'subset-def)
                 (let* ((pl2 (dk-peel!)) (w (cadr (car pl2))))
                   (fact 'subset-mem-fwd 'kk 'CC z) (fact 'subset-mem-fwd 'kk 'CC x)
                   (for-each (lambda (pr)
                               (let ((iff (dk-cite! 'cc-ms-ball-membership (car pr) (cadr pr) (caddr pr))))
                                 (dk-split-all! (list (dk-have-f-cm! (caddr iff) iff (list 'IN (caddr pr) (list 'BALL 'CC-MS (car pr) (cadr pr))))))))
                             (list (list z e w) (list x c z)))
                   (let* ((wz (list '- w z)) (zx (list '- z x)) (wx (list '- w x)) (c2 (list '* 2 c)))
                     (fact 'cc-sub-in-cc w z) (fact 'cc-sub-in-cc z x) (fact 'cc-sub-in-cc w x)
                     (for-each (lambda (v) (fact 'cc-magnitude-closed v)) (list wz zx wx))
                     (dk-have! (list 'AND (list 'IN wz 'CC) (list 'IN zx 'CC)))
                     (fact 'cc-magnitude-triangle wz zx)
                     (dk-have! (list '= (list '+ wz zx) wx) (lambda () (crs)))
                     (dk-rewrite-h! (list '<= (list 'magnitude (list '+ wz zx)) (list '+ (list 'magnitude wz) (list 'magnitude zx)))
                                    (list '+ wz zx) wx)
                     (dk-have! '(IN 2 RR)) (dk-have! (list 'AND '(IN 2 RR) (list 'IN c 'RR))) (fact 'rr-mul-closed 2 c)
                     (dk-have! (list '< (list 'magnitude wx) c2)
                       (lambda () (dk-ineq! (list '<= (list 'magnitude wx) (list '+ (list 'magnitude wz) (list 'magnitude zx)))
                                            (list '< (list 'magnitude wz) e) (list '< (list 'magnitude zx) c) (list '<= e c))))
                     (let ((iff3 (dk-cite! 'cc-ms-ball-membership x c2 w)))
                       (dk-have! (list 'IN w (list 'BALL 'CC-MS x c2))
                         (lambda () (if (dk-only! iff3 (list 'IN w 'CC) (list '< (list 'magnitude wx) c2)) (prop)))))
                     (fact 'subset-mem-fwd (list 'BALL 'CC-MS x c2) 'u w)
                     (ass)))))))
       (mh2-split-goal-cm!)))))
(qed 'compact-open-margin)

;;; ---------------------------------------------------------------------------
;;; THE PASTING LEMMA (for 3.16): f continuous on two closed pieces covering s is continuous.
;;; First the local clause on one closed piece ks: near x, points of ks map near f(x)
;;; (vacuously when x is not in ks, since ks is closed).
(define cm-loc '(FORSOME cmd_ (AND (POS-RR cmd_) (FORALL cmb_ (IMPLIES (IN cmb_ (PTS s)) (IMPLIES (<= ((DIST s) x cmb_) cmd_)
                 (IMPLIES (IN cmb_ ks) (<= ((DIST t) (f x) (f cmb_)) eps))))))))
(define cm-piece-cont '(FORALL cmy_ (IMPLIES (IN cmy_ ks) (IS-CONTINUOUS-AT (SUBSPACE-MS s ks) t (RESTRICT f ks) cmy_))))
(sp (make-wff (forall-guarded '(s t f ks x eps)
  (list '(IS-METRIC-SPACE s) '(IS-METRIC-SPACE t) '(IN f (FUN (PTS s) (PTS t))) '(SUBSET ks (PTS s)) '(IS-CLOSED s ks)
        cm-piece-cont '(IN x (PTS s)) '(POS-RR eps))
  cm-loc)))
(dk-peel!)
(let ((sub '(SUBSPACE-MS s ks)) (rf '(RESTRICT f ks)))
  (fact 'ms-pts-is-set 's)
  (fact 'subclass-of-set-is-set 'ks '(PTS s))
  (fact 'subspace-pts 's 'ks)
  (use-em '(IN x ks)
    (lambda ()
      (let* ((pc (dk-apply! (cm-pick 'pc (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-CONTINUOUS-AT)))) 'x))
             (rhs (caddr (dk-cite! 'is-continuous-at sub 't rf 'x))))
        (dk-project! rhs 'is-continuous-at pc)
        (dk-split-all! (list rhs))
        (let* ((d (dk-skolem! (dk-apply! (cm-pick 'ep (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'POS-RR) (dk-contains? z rf)))) 'eps) #t))
               (cl (cm-pick 'cl (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z d))))))
          (ew d)
          (for-each
           (lambda (leaf)
             (dk-focus! leaf)
             (if (dk-asm? (dk-goal)) (ass)
                 (let* ((pl (dk-peel!)) (b (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) '(PTS s)))) pl)))))
                   (dk-have! (list 'IN b (list 'PTS sub)) (lambda () (subst (list '= (list 'PTS sub) 'ks)) (ass)))
                   (dk-cite! 'subspace-dist 's 'ks 'x b)
                   (dk-rewrite-h! (list '<= (list '(DIST s) 'x b) d) (list '(DIST s) 'x b) (list (list 'DIST sub) 'x b))
                   (let ((r (dk-apply! cl b)))
                     (dk-cite! 'restrict-apply 'f 'ks 'x) (dk-cite! 'restrict-apply 'f 'ks b)
                     (let ((r2 (dk-rewrite-h! r (list rf 'x) '(f x))))
                       (dk-rewrite-h! r2 (list rf b) (list 'f b))))
                   (ass))))
           (mh2-split-goal-cm!)))))
    (lambda ()
      (let* ((crhs (caddr (dk-cite! 'is-closed 's 'ks)))
             (comp '(COMPLEMENT-IN (PTS s) ks)))
        (dk-project! crhs 'is-closed '(IS-CLOSED s ks))
        (dk-split-all! (list crhs))
        (let ((orhs (caddr (dk-cite! 'is-open 's comp))))
          (dk-project! orhs 'is-open (list 'IS-OPEN 's comp))
          (dk-split-all! (list orhs))
          (let ((ciff (dk-cite! 'complement-in-membership '(PTS s) 'ks 'x)))
            (dk-have! (list 'IN 'x comp) (lambda () (if (dk-only! ciff '(IN x (PTS s)) '(NOT (IN x ks))) (prop)))))
          (let* ((r (dk-skolem! (dk-apply! (cm-pick 'op (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'BALL) (dk-contains? z comp)))) 'x) #t))
                 (d (dk-halve! r))
                 (ball (list 'BALL 's 'x r)))
            (dk-pos-parts! r) (dk-pos-parts! d)
            (fact 'rr-pos-rr-of-lt d)
            (ew d)
            (for-each
             (lambda (leaf)
               (dk-focus! leaf)
               (if (dk-asm? (dk-goal)) (ass)
                   (let* ((pl (dk-peel!))
                          (b (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) '(PTS s)))) pl))))
                          (db (list '(DIST s) 'x b)))
                     (fact 'metric-dist-real 's 'x b)
                     (dk-have! (list '< db r)
                       (lambda () (dk-ineq! (list '<= db d) (cm-pick 'half (lambda (z) (and (dk-head-is? z '=) (dk-contains? z d) (dk-contains? z r)))) (list '< 0 d))))
                     (let ((biff (dk-cite! 'ball-membership 's 'x r b)))
                       (dk-have! (list '<= db r) (lambda () (dk-ineq! (list '< db r))))
                       (dk-have! (list 'NOT (list '= db r)) (lambda () (di) (dk-absurd! (list '< db r) (list '= db r))))
                       (dk-have! (list 'IN b ball) (lambda () (if (dk-only! biff (list 'IN b '(PTS s)) (list '<= db r) (list 'NOT (list '= db r))) (prop)))))
                     (fact 'subset-mem-fwd ball comp b)
                     (let ((ciff2 (dk-cite! 'complement-in-membership '(PTS s) 'ks b)))
                       (if (dk-only! ciff2 (list 'IN b comp) (list 'IN b 'ks)) (prop))))))
             (mh2-split-goal-cm!))))))))
(qed 'pasting-local)

(define cm-pa-hyps
  (list '(IS-METRIC-SPACE s) '(IS-METRIC-SPACE t) '(IN f (FUN (PTS s) (PTS t)))
        '(SUBSET ka (PTS s)) '(SUBSET kb (PTS s)) '(IS-CLOSED s ka) '(IS-CLOSED s kb)
        '(FORALL cmx_ (IMPLIES (IN cmx_ (PTS s)) (OR (IN cmx_ ka) (IN cmx_ kb))))
        '(FORALL cmy_ (IMPLIES (IN cmy_ ka) (IS-CONTINUOUS-AT (SUBSPACE-MS s ka) t (RESTRICT f ka) cmy_)))
        '(FORALL cmy_ (IMPLIES (IN cmy_ kb) (IS-CONTINUOUS-AT (SUBSPACE-MS s kb) t (RESTRICT f kb) cmy_)))))
(sp (make-wff (forall-guarded '(s t f ka kb) cm-pa-hyps
  '(FORALL cmz_ (IMPLIES (IN cmz_ (PTS s)) (IS-CONTINUOUS-AT s t f cmz_))))))
(dk-peel!)
(let* ((x (list-ref (dk-goal) 4)))
  (mac 'is-continuous-at)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (cond
      ((dk-asm? (dk-goal)) (ass))
      ((dk-head-is? (dk-goal) 'FORALL)
       (let* ((pl (dk-peel!)) (eps (cadr (car (filter (lambda (z) (dk-head-is? z 'POS-RR)) pl))))
              (da (dk-skolem! (dk-fact! 'pasting-local 's 't 'f 'ka x eps) #t))
              (la (cm-pick 'la (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z da)))))
              (db (dk-skolem! (dk-fact! 'pasting-local 's 't 'f 'kb x eps) #t))
              (lb (cm-pick 'lb (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z db)))))
              (cover (cm-pick 'cover (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'OR))))))
         (dk-pos-parts! da) (dk-pos-parts! db)
         (fact 'metric-dist-real 's x x)
         (define (finish! d)
           (ew d)
           (for-each
            (lambda (leaf2)
              (dk-focus! leaf2)
              (if (dk-asm? (dk-goal)) (ass)
                  (let* ((pl2 (dk-peel!))
                         (b (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) '(PTS s)))) pl2))))
                         (dxb (list '(DIST s) x b)))
                    (fact 'metric-dist-real 's x b)
                    (dk-have! (list '<= dxb da) (lambda () (dk-ineq! (list '<= dxb d) (list '<= d da))))
                    (dk-have! (list '<= dxb db) (lambda () (dk-ineq! (list '<= dxb d) (list '<= d db))))
                    (let* ((ra (inst*! la b)) (rb (inst*! lb b)) (orb (inst*! cover b)))
                      (if (dk-only! ra rb orb) (prop))))))
            (mh2-split-goal-cm!)))
         (dk-have! (list 'AND (list 'IN da 'RR) (list 'IN db 'RR)))
         (let ((tot (dk-fact! 'rr-leq-total da db)))
           (use-cases (list (list '<= da db) (list '<= db da))
             (lambda () (dk-have! (list '<= da da) (lambda () (dk-ineq!))) (finish! da))
             (lambda () (dk-have! (list '<= db db) (lambda () (dk-ineq!))) (finish! db))))))
      (#t (ass))))
   (mh2-split-goal-cm!)))
(qed 'pasting-closed)

(display ";; CM qed failures: ") (display *vnb-qed-failures*) (newline)
