;;; Library: analysis.

;;; cnvs-a.scm -- COMPLEX NORMED VECTOR SPACES: the projections of the structure, the laws of J,
;;; and the complex module laws of CACT (CNVS, 2026-11-09).  All PROVEN modulo 0.
;;; Destination: theorem-library/cnvs-a.scm.  Vocabulary: structure-library/cnvs-vocab.scm.
;;;
;;; The CACT laws follow sip-b.scm's proofs for a complex semi-inner-product space verbatim in
;;; method: the two-term normal form NF(p, q, x) = p.x + q.Jx (p, q real) carries every
;;; computation, CACT(z, x) = NF(Re z, Im z, x), and the real module laws come from the
;;; companions `<name>-cnvs-as-module' that the view CNVS-AS-MODULE installs.
;;;
;;; Helper prefix: cnva-.
;;; LOAD WINDOW: right after structure-library/cnvs-vocab (the companions are installed there);
;;; cites rr / cc arithmetic (cc-re-add, cc-re-mul, cc-re-im-of, real-part-in-rr) and the
;;; companions only.  Library: analysis.

(define (cnva-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cnvs-a: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "cnvs-a: unfinished" name))))

(define cnva-rr-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define cnva-is '(IS-COMPLEX-NORMED-VECTOR-SPACE v))
(define (cnva-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (cnva-has-head? h (car e)) (cnva-has-head? h (cdr e)))))

;;; ==========================================================================================
;;; THE PROJECTIONS of IS-COMPLEX-NORMED-VECTOR-SPACE
;;; ==========================================================================================
(define (cnva-proj! name conj)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is conj))))
  (di) (di)
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-COMPLEX-NORMED-VECTOR-SPACE cnva-is)))))
  (ass)
  (cnva-qed! name))
(cnva-proj! 'cnvs-vec-set '(IN (VEC v) SET))
(cnva-proj! 'cnvs-jop-fun '(IN (JOP v) (FUN (VEC v) (VEC v))))
(cnva-proj! 'cnvs-vnrm-fun '(IN (VNRM v) (FUN (VEC v) RR)))
(cnva-proj! 'cnvs-nvs '(IS-NORMED-VECTOR-SPACE (LIST (SCAL v) (VEC v) (VADD v) (VZERO v) (VNEG v) (ACT v) (VNRM v))))
(cnva-proj! 'cnvs-real-linear '(IS-REAL-LINEAR-OP v (JOP v)))
(cnva-proj! 'cnvs-square '(IS-SQUARE-MINUS-ID v (JOP v)))
(cnva-proj! 'cnvs-vnrm-cact
  '(FORALL cnc_ (IMPLIES (IN cnc_ CC) (FORALL cnx_ (IMPLIES (IN cnx_ (VEC v))
     (= ((VNRM v) ((CACT v) cnc_ cnx_)) (* (magnitude cnc_) ((VNRM v) cnx_))))))))

;;; the complete refinement
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-BANACH-SPACE v) (IS-COMPLEX-NORMED-VECTOR-SPACE v)))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-complex-banach-space-def '(IS-COMPLEX-BANACH-SPACE v))))))
(ass)
(cnva-qed! 'cbs-is-cnvs)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-BANACH-SPACE v) (IS-COMPLETE (CNVS-METRIC-SPACE v))))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-complex-banach-space-def '(IS-COMPLEX-BANACH-SPACE v))))))
(ass)
(cnva-qed! 'cbs-complete)

;;; read-offs of the view CNVS-AS-NVS (the scalar pin is read through it)
(define (cnva-view-read-off! name view acc)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is (list '== (list acc (list view 'v)) (list acc 'v))))))
  (di) (di)
  (slot acc)
  (mac view)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (cnva-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (cnva-qed! name))
(cnva-view-read-off! 'cnvs-nvs-view-scal 'CNVS-AS-NVS 'SCAL)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is (list '= '(SCAL (CNVS-AS-NVS v)) cnva-rr-ring)))))
(di) (di)
(fact 'cnvs-as-nvs-is-normed-vector-space 'v)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-NORMED-VECTOR-SPACE '(IS-NORMED-VECTOR-SPACE (CNVS-AS-NVS v)))))))
(ass)
(cnva-qed! 'cnvs-nvs-view-scal-pin)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is (list '= '(SCAL v) cnva-rr-ring)))))
(di) (di)
(fact 'cnvs-nvs-view-scal-pin 'v)
(fact 'cnvs-nvs-view-scal 'v)
(subst '(= (SCAL v) (SCAL (CNVS-AS-NVS v))))
(ass)
(cnva-qed! 'cnvs-scal-pin)

;;; ==========================================================================================
;;; THE LAWS OF J
;;; ==========================================================================================
(define (cnva-jlaw! name pred conj)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is conj))))
  (di) (di)
  (let ((h (dk-cite! (cdr (assq pred '((IS-REAL-LINEAR-OP . cnvs-real-linear) (IS-SQUARE-MINUS-ID . cnvs-square))))
                     'v)))
    (dk-split-all! (list (dk-landed-1 (lambda () (mac-h pred h))))))
  (ass)
  (cnva-qed! name))
(cnva-jlaw! 'cnvs-jop-add 'IS-REAL-LINEAR-OP
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= ((JOP v) ((VADD v) x_ y_)) ((VADD v) ((JOP v) x_) ((JOP v) y_))))))))
(cnva-jlaw! 'cnvs-jop-act 'IS-REAL-LINEAR-OP
  '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v))
     (= ((JOP v) ((ACT v) a_ x_)) ((ACT v) a_ ((JOP v) x_))))))))
(cnva-jlaw! 'cnvs-jop-sq 'IS-SQUARE-MINUS-ID
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((JOP v) ((JOP v) x_)) ((VNEG v) x_)))))

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IN ((JOP v) x_) (VEC v))))))))
(dk-peel!)
(fact 'cnvs-jop-fun 'v)
(fact 'fun-apply-type-c '(JOP v) '(VEC v) '(VEC v) 'x_)
(ass)
(cnva-qed! 'cnvs-jop-type)

;;; ==========================================================================================
;;; THE COMPLEX SCALAR MULTIPLICATION.  NF(p, q, x) = p.x + q.Jx, and
;;;     NF(p,q,x) + NF(r,s,x) = NF(p+r, q+s, x)     t.NF(p,q,x) = NF(tp, tq, x)
;;;     J NF(p,q,x) = NF(-q, p, x)                    CACT(z, x) = NF(Re z, Im z, x).
;;; ==========================================================================================
(define (cnva-nf p q x) (list '(VADD v) (list '(ACT v) p x) (list '(ACT v) q (list '(JOP v) x))))
(define (cnva-pin!) (fact 'cnvs-scal-pin 'v))
(define (cnva-vt x)                     ; type a vector expression over a CNVS v
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-cnvs-as-module 'v) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (cnva-vt (cadr x)) (cnva-vt (caddr x))
           (dk-cite! 'module-vadd-type-cnvs-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (cnva-vt (cadr x))
           (dk-cite! 'module-vneg-type-cnvs-as-module 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT v)))
           (cnva-vt (caddr x))
           (dk-real! (cadr x))
           (dk-cite! 'hbs-act-in-cnvs-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(JOP v)))
           (cnva-vt (cadr x))
           (dk-cite! 'cnvs-jop-type 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(CACT v)))
           (cnva-vt (caddr x))
           (dk-cite! 'cnvs-cact-type-pt 'v (cadr x) (caddr x)) x)
          (#t (error "cnva-vt: cannot type" (expression->string x))))))
(define cnva-jx '((JOP v) x_))

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is
  (forall-guarded '(p_ q_ r_ s_ x_) '((IN p_ RR) (IN q_ RR) (IN r_ RR) (IN s_ RR) (IN x_ (VEC v)))
    (list '= (list '(VADD v) (cnva-nf 'p_ 'q_ 'x_) (cnva-nf 'r_ 's_ 'x_)) (cnva-nf '(+ p_ r_) '(+ q_ s_) 'x_)))))))
(dk-peel!)
(cnva-pin!)
(cnva-vt (cnva-nf 'p_ 'q_ 'x_)) (cnva-vt (cnva-nf 'r_ 's_ 'x_))
(dk-real! '(+ p_ r_)) (dk-real! '(+ q_ s_))
(fact 'hbs-interchange-cnvs-as-module 'v '((ACT v) p_ x_) (list '(ACT v) 'q_ cnva-jx) '((ACT v) r_ x_) (list '(ACT v) 's_ cnva-jx))
(fact 'hbs-act-add-cnvs-as-module 'v 'p_ 'r_ 'x_)
(fact 'hbs-act-add-cnvs-as-module 'v 'q_ 's_ cnva-jx)
(subst (list '= (list '(VADD v) (cnva-nf 'p_ 'q_ 'x_) (cnva-nf 'r_ 's_ 'x_))
             (list '(VADD v) '((VADD v) ((ACT v) p_ x_) ((ACT v) r_ x_))
                   (list '(VADD v) (list '(ACT v) 'q_ cnva-jx) (list '(ACT v) 's_ cnva-jx)))))
(subst '(= ((ACT v) (+ p_ r_) x_) ((VADD v) ((ACT v) p_ x_) ((ACT v) r_ x_))))
(subst (list '= (list '(ACT v) '(+ q_ s_) cnva-jx) (list '(VADD v) (list '(ACT v) 'q_ cnva-jx) (list '(ACT v) 's_ cnva-jx))))
(rfl)
(cnva-qed! 'cnvs-nf-add)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is
  (forall-guarded '(t_ p_ q_ x_) '((IN t_ RR) (IN p_ RR) (IN q_ RR) (IN x_ (VEC v)))
    (list '= (list '(ACT v) 't_ (cnva-nf 'p_ 'q_ 'x_)) (cnva-nf '(* t_ p_) '(* t_ q_) 'x_)))))))
(dk-peel!)
(cnva-pin!)
(cnva-vt (cnva-nf 'p_ 'q_ 'x_))
(dk-real! '(* t_ p_)) (dk-real! '(* t_ q_))
(fact 'hbs-act-vadd-cnvs-as-module 'v 't_ '((ACT v) p_ x_) (list '(ACT v) 'q_ cnva-jx))
(fact 'hbs-act-mul-cnvs-as-module 'v 't_ 'p_ 'x_)
(fact 'hbs-act-mul-cnvs-as-module 'v 't_ 'q_ cnva-jx)
(subst (list '= (list '(ACT v) 't_ (cnva-nf 'p_ 'q_ 'x_))
             (list '(VADD v) '((ACT v) t_ ((ACT v) p_ x_)) (list '(ACT v) 't_ (list '(ACT v) 'q_ cnva-jx)))))
(subst '(= ((ACT v) (* t_ p_) x_) ((ACT v) t_ ((ACT v) p_ x_))))
(subst (list '= (list '(ACT v) '(* t_ q_) cnva-jx) (list '(ACT v) 't_ (list '(ACT v) 'q_ cnva-jx))))
(rfl)
(cnva-qed! 'cnvs-nf-scale)

;;; (-q).x = -(q.x), from the NVS companion vneg(r.x) = (-1 r).x
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is
  (forall-guarded '(q_ x_) '((IN q_ RR) (IN x_ (VEC v)))
    '(= ((ACT v) (- q_) x_) ((VNEG v) ((ACT v) q_ x_))))))))
(dk-peel!)
(cnva-pin!)
(cnva-vt '((ACT v) (- q_) x_))
(let* ((e (dk-cite! 'nvs-act-vneg-cnvs-as-nvs 'v 'q_ 'x_))
       (mq (cadr (caddr e))))
  (dk-have! (list '= mq '(- q_)) (lambda () (crs)))
  (subst (list '= '((VNEG v) ((ACT v) q_ x_)) (caddr e)))
  (subst (list '= mq '(- q_))))
(if (not (proof-done? *ps*)) (rfl))
(cnva-qed! 'cnvs-act-neg-scalar)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES cnva-is
  (forall-guarded '(p_ q_ x_) '((IN p_ RR) (IN q_ RR) (IN x_ (VEC v)))
    (list '= (list '(JOP v) (cnva-nf 'p_ 'q_ 'x_)) (cnva-nf '(- q_) 'p_ 'x_)))))))
(dk-peel!)
(cnva-pin!)
(dk-real! '(- q_))
(define cnva-px '((ACT v) p_ x_))
(define cnva-qjx (list '(ACT v) 'q_ cnva-jx))
(cnva-vt cnva-px) (cnva-vt cnva-qjx) (cnva-vt (list '(JOP v) cnva-jx)) (cnva-vt '((ACT v) q_ x_))
(fact 'cnvs-jop-add 'v cnva-px cnva-qjx)
(fact 'cnvs-jop-act 'v 'p_ 'x_)
(fact 'cnvs-jop-act 'v 'q_ cnva-jx)
(fact 'cnvs-jop-sq 'v 'x_)
(fact 'hbs-in-carr-cnvs-as-module 'v 'q_)
(fact 'frm-act-neg-vec-cnvs-as-module 'v 'q_ 'x_)
(fact 'cnvs-act-neg-scalar 'v 'q_ 'x_)
(cnva-vt '((VNEG v) ((ACT v) q_ x_)))
(cnva-vt (list '(ACT v) 'p_ cnva-jx))
(fact 'hbs-vadd-comm-cnvs-as-module 'v (list '(ACT v) 'p_ cnva-jx) '((VNEG v) ((ACT v) q_ x_)))
(subst (list '= (list '(JOP v) (cnva-nf 'p_ 'q_ 'x_)) (list '(VADD v) (list '(JOP v) cnva-px) (list '(JOP v) cnva-qjx))))
(subst (list '= (list '(JOP v) cnva-px) (list '(ACT v) 'p_ cnva-jx)))
(subst (list '= (list '(JOP v) cnva-qjx) (list '(ACT v) 'q_ (list '(JOP v) cnva-jx))))
(subst (list '= (list '(JOP v) cnva-jx) '((VNEG v) x_)))
(subst '(= ((ACT v) q_ ((VNEG v) x_)) ((VNEG v) ((ACT v) q_ x_))))
(subst '(= ((ACT v) (- q_) x_) ((VNEG v) ((ACT v) q_ x_))))
(subst (list '= (list '(VADD v) (list '(ACT v) 'p_ cnva-jx) '((VNEG v) ((ACT v) q_ x_)))
             (list '(VADD v) '((VNEG v) ((ACT v) q_ x_)) (list '(ACT v) 'p_ cnva-jx))))
(rfl)
(cnva-qed! 'cnvs-nf-jop)

(define (cnva-reim! z)                  ; type Re z, Im z in RR (z in CC in context)
  (dk-cite! 'real-part-in-rr z) (dk-cite! 'imag-part-in-rr z))
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) z_ x_)
       ((VADD v) ((ACT v) (real-part z_) x_) ((ACT v) (imag-part z_) ((JOP v) x_))))))))))))
(dk-peel!)
(cnva-pin!)
(cnva-reim! 'z_)
(cnva-vt (cnva-nf '(real-part z_) '(imag-part z_) 'x_))
(mac 'CACT)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(cnva-qed! 'cnvs-cact-value)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IN ((CACT v) z_ x_) (VEC v))))))))))
(dk-peel!)
(cnva-pin!)
(cnva-reim! 'z_)
(fact 'cnvs-cact-value 'v 'z_ 'x_)
(subst (list '= '((CACT v) z_ x_) (cnva-nf '(real-part z_) '(imag-part z_) 'x_)))
(cnva-vt (cnva-nf '(real-part z_) '(imag-part z_) 'x_))
(ass)
(cnva-qed! 'cnvs-cact-type-pt)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (IN (CACT v) (FUN (CARTESIAN CC (VEC v)) (VEC v)))))))
(dk-peel!)
(cnva-pin!)
(fact 'cnvs-vec-set 'v)
(fact 'cc-is-set)
(mac 'CACT)
(dk-lam-type!
  (lambda ()
    (let* ((lk (dk-peel!))
           (z (cadr (or (any-pred (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk)
                        (error "cnvs-cact-fun: no complex variable")))))
      (cnva-reim! z)
      (cnva-vt (cadr (dk-goal)))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(cnva-qed! 'cnvs-cact-fun)

;;; z.(x + y) = z.x + z.y
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((CACT v) z_ ((VADD v) x_ y_)) ((VADD v) ((CACT v) z_ x_) ((CACT v) z_ y_)))))))))))))
(dk-peel!)
(cnva-pin!)
(cnva-reim! 'z_)
(let* ((a '(real-part z_)) (b '(imag-part z_)) (xy '((VADD v) x_ y_))
       (jx '((JOP v) x_)) (jy '((JOP v) y_)))
  (cnva-vt xy) (cnva-vt jx) (cnva-vt jy)
  (fact 'cnvs-cact-value 'v 'z_ xy)
  (fact 'cnvs-cact-value 'v 'z_ 'x_)
  (fact 'cnvs-cact-value 'v 'z_ 'y_)
  (subst (list '= (list '(CACT v) 'z_ xy) (cnva-nf a b xy)))
  (subst (list '= '((CACT v) z_ x_) (cnva-nf a b 'x_)))
  (subst (list '= '((CACT v) z_ y_) (cnva-nf a b 'y_)))
  (fact 'hbs-act-vadd-cnvs-as-module 'v a 'x_ 'y_)
  (fact 'cnvs-jop-add 'v 'x_ 'y_)
  (fact 'hbs-act-vadd-cnvs-as-module 'v b jx jy)
  (cnva-vt (list '(ACT v) a 'x_)) (cnva-vt (list '(ACT v) b jx)) (cnva-vt (list '(ACT v) a 'y_)) (cnva-vt (list '(ACT v) b jy))
  (fact 'hbs-interchange-cnvs-as-module 'v (list '(ACT v) a 'x_) (list '(ACT v) b jx) (list '(ACT v) a 'y_) (list '(ACT v) b jy))
  (subst (list '= (list '(ACT v) a xy) (list '(VADD v) (list '(ACT v) a 'x_) (list '(ACT v) a 'y_))))
  (subst (list '= (list '(JOP v) xy) (list '(VADD v) jx jy)))
  (subst (list '= (list '(ACT v) b (list '(VADD v) jx jy)) (list '(VADD v) (list '(ACT v) b jx) (list '(ACT v) b jy))))
  (subst (list '= (list '(VADD v) (cnva-nf a b 'x_) (cnva-nf a b 'y_))
               (list '(VADD v) (list '(VADD v) (list '(ACT v) a 'x_) (list '(ACT v) a 'y_))
                               (list '(VADD v) (list '(ACT v) b jx) (list '(ACT v) b jy)))))
  (rfl))
(cnva-qed! 'cnvs-cact-vadd)

;;; (z + w).x = z.x + w.x
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL w_ (IMPLIES (IN w_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) (+ z_ w_) x_) ((VADD v) ((CACT v) z_ x_) ((CACT v) w_ x_)))))))))))))
(dk-peel!)
(cnva-pin!)
(cnva-reim! 'z_) (cnva-reim! 'w_)
(dk-have! '(IN (+ z_ w_) CC) (lambda () (dk-have! '(AND (IN z_ CC) (IN w_ CC))) (fact 'cc-add-closed 'z_ 'w_) (ass)))
(cnva-reim! '(+ z_ w_))
(fact 'cnvs-cact-value 'v '(+ z_ w_) 'x_)
(fact 'cnvs-cact-value 'v 'z_ 'x_)
(fact 'cnvs-cact-value 'v 'w_ 'x_)
(fact 'cc-re-add 'z_ 'w_)
(fact 'cc-im-add 'z_ 'w_)
(fact 'cnvs-nf-add 'v '(real-part z_) '(imag-part z_) '(real-part w_) '(imag-part w_) 'x_)
(subst (list '= '((CACT v) (+ z_ w_) x_) (cnva-nf '(real-part (+ z_ w_)) '(imag-part (+ z_ w_)) 'x_)))
(subst '(= (real-part (+ z_ w_)) (+ (real-part z_) (real-part w_))))
(subst '(= (imag-part (+ z_ w_)) (+ (imag-part z_) (imag-part w_))))
(subst (list '= '((CACT v) z_ x_) (cnva-nf '(real-part z_) '(imag-part z_) 'x_)))
(subst (list '= '((CACT v) w_ x_) (cnva-nf '(real-part w_) '(imag-part w_) 'x_)))
(subst (list '= (list '(VADD v) (cnva-nf '(real-part z_) '(imag-part z_) 'x_) (cnva-nf '(real-part w_) '(imag-part w_) 'x_))
             (cnva-nf '(+ (real-part z_) (real-part w_)) '(+ (imag-part z_) (imag-part w_)) 'x_)))
(rfl)
(cnva-qed! 'cnvs-cact-add)

;;; (z w).x = z.(w.x)
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL w_ (IMPLIES (IN w_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) (* z_ w_) x_) ((CACT v) z_ ((CACT v) w_ x_)))))))))))))
(dk-peel!)
(cnva-pin!)
(cnva-reim! 'z_) (cnva-reim! 'w_)
(dk-have! '(IN (* z_ w_) CC) (lambda () (dk-have! '(AND (IN z_ CC) (IN w_ CC))) (fact 'cc-mul-closed 'z_ 'w_) (ass)))
(cnva-reim! '(* z_ w_))
(let* ((a '(real-part z_)) (b '(imag-part z_)) (c '(real-part w_)) (d '(imag-part w_))
       (y (cnva-nf c d 'x_))
       (ac (list '* a c)) (ad (list '* a d)) (bnd (list '* b (list '- d))) (bc (list '* b c)))
  (for-each dk-real! (list (list '- d) ac ad bnd bc (list '+ ac bnd) (list '+ ad bc)))
  (cnva-vt y)
  (fact 'cnvs-cact-value 'v '(* z_ w_) 'x_)
  (fact 'cnvs-cact-value 'v 'w_ 'x_)
  (fact 'cnvs-cact-value 'v 'z_ y)
  (fact 'cc-re-mul 'z_ 'w_)
  (fact 'cc-im-mul 'z_ 'w_)
  (fact 'cnvs-nf-scale 'v a c d 'x_)
  (fact 'cnvs-nf-jop 'v c d 'x_)
  (fact 'cnvs-nf-scale 'v b (list '- d) c 'x_)
  (fact 'cnvs-nf-add 'v ac ad bnd bc 'x_)
  (dk-have! (list '= (list '- ac (list '* b d)) (list '+ ac bnd)) (lambda () (crs)))
  (subst (list '= '((CACT v) (* z_ w_) x_) (cnva-nf '(real-part (* z_ w_)) '(imag-part (* z_ w_)) 'x_)))
  (subst (list '= '(real-part (* z_ w_)) (list '- ac (list '* b d))))
  (subst (list '= '(imag-part (* z_ w_)) (list '+ ad bc)))
  (subst (list '= (list '- ac (list '* b d)) (list '+ ac bnd)))
  (subst (list '= '((CACT v) w_ x_) y))
  (subst (list '= (list '(CACT v) 'z_ y) (list '(VADD v) (list '(ACT v) a y) (list '(ACT v) b (list '(JOP v) y)))))
  (subst (list '= (list '(ACT v) a y) (cnva-nf ac ad 'x_)))
  (subst (list '= (list '(JOP v) y) (cnva-nf (list '- d) c 'x_)))
  (subst (list '= (list '(ACT v) b (cnva-nf (list '- d) c 'x_)) (cnva-nf bnd bc 'x_)))
  (subst (list '= (list '(VADD v) (cnva-nf ac ad 'x_) (cnva-nf bnd bc 'x_)) (cnva-nf (list '+ ac bnd) (list '+ ad bc) 'x_)))
  (rfl))
(cnva-qed! 'cnvs-cact-mul)

;;; 1.x = x
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) 1 x_) x_)))))))
(dk-peel!)
(cnva-pin!)
(fact 'cc-one-in)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(= 1 (+ 1 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 1 1 0)))
(fact 'cnvs-cact-value 'v 1 'x_)
(cnva-vt '((JOP v) x_))
(fact 'hbs-act-one-cnvs-as-module 'v 'x_)
(fact 'hbs-act-zero-cnvs-as-module 'v '((JOP v) x_))
(fact 'hbs-vzero-r-cnvs-as-module 'v 'x_)
(subst (list '= '((CACT v) 1 x_) (cnva-nf '(real-part 1) '(imag-part 1) 'x_)))
(subst '(= (real-part 1) 1))
(subst '(= (imag-part 1) 0))
(subst '(= ((ACT v) 1 x_) x_))
(subst '(= ((ACT v) 0 ((JOP v) x_)) (VZERO v)))
(subst '(= ((VADD v) x_ (VZERO v)) x_))
(if (not (proof-done? *ps*)) (rfl))
(cnva-qed! 'cnvs-cact-one)

;;; a real scalar acts through CACT as through ACT: r.x (complex) = r.x (real)
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) r_ x_) ((ACT v) r_ x_))))))))))
(dk-peel!)
(cnva-pin!)
(dk-cite! 'rr-subset-cc 'r_)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(= r_ (+ r_ (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 'r_ 'r_ 0)))
(fact 'cnvs-cact-value 'v 'r_ 'x_)
(cnva-vt '((JOP v) x_))
(cnva-vt '((ACT v) r_ x_))
(fact 'hbs-act-zero-cnvs-as-module 'v '((JOP v) x_))
(fact 'hbs-vzero-r-cnvs-as-module 'v '((ACT v) r_ x_))
(subst (list '= '((CACT v) r_ x_) (cnva-nf '(real-part r_) '(imag-part r_) 'x_)))
(subst '(= (real-part r_) r_))
(subst '(= (imag-part r_) 0))
(subst '(= ((ACT v) 0 ((JOP v) x_)) (VZERO v)))
(subst '(= ((VADD v) ((ACT v) r_ x_) (VZERO v)) ((ACT v) r_ x_)))
(if (not (proof-done? *ps*)) (rfl))
(cnva-qed! 'cnvs-cact-real)

;;; i.x = Jx
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) +i x_) ((JOP v) x_))))))))
(dk-peel!)
(cnva-pin!)
(fact 'cc-i-in)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(= +i (+ 0 (* 1 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of '+i 0 1)))
(fact 'cnvs-cact-value 'v '+i 'x_)
(cnva-vt '((JOP v) x_))
(fact 'hbs-act-one-cnvs-as-module 'v '((JOP v) x_))
(fact 'hbs-act-zero-cnvs-as-module 'v 'x_)
(fact 'hbs-vzero-l-cnvs-as-module 'v '((JOP v) x_))
(subst (list '= '((CACT v) +i x_) (cnva-nf '(real-part +i) '(imag-part +i) 'x_)))
(subst '(= (real-part +i) 0))
(subst '(= (imag-part +i) 1))
(subst '(= ((ACT v) 1 ((JOP v) x_)) ((JOP v) x_)))
(subst '(= ((ACT v) 0 x_) (VZERO v)))
(subst '(= ((VADD v) (VZERO v) ((JOP v) x_)) ((JOP v) x_)))
(if (not (proof-done? *ps*)) (rfl))
(cnva-qed! 'cnvs-cact-i)

;;; J is an isometry: the case c = i of the complex homogeneity law
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((VNRM v) ((JOP v) x_)) ((VNRM v) x_))))))))
(dk-peel!)
(fact 'cc-i-in)
(fact 'cnvs-cact-i 'v 'x_)
(fact 'cnvs-vnrm-cact 'v '+i 'x_)
(fact 'cc-magnitude-i)
(subst '(= ((JOP v) x_) ((CACT v) +i x_)))
(subst '(= ((VNRM v) ((CACT v) +i x_)) (* (magnitude +i) ((VNRM v) x_))))
(subst '(= (magnitude +i) 1))
(dk-cite! 'cnvs-vnrm-fun 'v)
(dk-cite! 'fun-apply-type-c '(VNRM v) '(VEC v) 'RR 'x_)
(dk-ineq! '(IN ((VNRM v) x_) RR))
(cnva-qed! 'cnvs-jop-isometric)
