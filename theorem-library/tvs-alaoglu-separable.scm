(define (b6s-coord-iv! f n)            ; f in UB, n in NN: (IN (f (xs n)) iv(n))
  (let* ((iv (b6s-iv-facts! n)) (r (b6s-r n)) (fx (list f (list 'xs n))) (g (list 'IN fx iv)))
    (if (not (dk-asm? g))
        (begin
          (b6s-ub! f)
          (b6s-fval! f (list 'xs n))
          (dk-apply! (dk-ctx-form (b6s-nbd f)) (list 'xs n))
          (b6s-abs-out! fx r)
          (let ((cm (dk-cite! 'ccint-membership (list '- r) r fx)))
            (b6s-and! (list '<= (list '- r) fx) (list '<= fx r))
            (b6s-and! (list 'IN fx 'RR) (list 'AND (list '<= (list '- r) fx) (list '<= fx r)))
            (dk-have! g (lambda () (if (dk-only! cm (caddr cm)) (prop)))))))
    g))
(define (b6s-coord! f n)               ; f in UB, n in NN: (IN (f (xs n)) (PTS (DBI n)))  (and the interval facts)
  (let* ((iv (b6s-iv-facts! n)) (r (b6s-r n)) (fx (list f (list 'xs n))) (g (list 'IN fx (list 'PTS (list b6s-DBI n)))))
    (if (not (dk-asm? g))
        (begin
          (b6s-ub! f)
          (b6s-fval! f (list 'xs n))
          (dk-apply! (dk-ctx-form (b6s-nbd f)) (list 'xs n))
          (b6s-abs-out! fx r)
          (let ((cm (dk-cite! 'ccint-membership (list '- r) r fx)))
            (b6s-and! (list '<= (list '- r) fx) (list '<= fx r))
            (b6s-and! (list 'IN fx 'RR) (list 'AND (list '<= (list '- r) fx) (list '<= fx r)))
            (dk-have! (list 'IN fx iv) (lambda () (if (dk-only! cm (caddr cm)) (prop)))))
          (dk-have! g (lambda () (subst (list '== (list 'PTS (list b6s-DBI n)) iv)) (dk-ass!)))))
    g))
(define (b6s-jf f) (list b6s-DBJ f))
