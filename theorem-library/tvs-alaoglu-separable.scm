    (lambda () (subst (list '== '(DUAL-WEAK-STAR-TOP m) (list 'SUBSPACE-TOP b6s-PR '(DUAL-VEC m)))) (dk-ass!))))
(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense)
   (list 'FORALL 'u (list 'IFF (list 'IN 'u (list 'OPENS b6s-TW0)) (list 'IS-OPEN b6s-D 'u)))))))
