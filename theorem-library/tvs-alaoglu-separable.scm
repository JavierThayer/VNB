;;; ===========================================================================
(define b6s-RRT '(METRIC-TOP RR-MS))
(define b6s-RF '(VNB-LAMBDA b6n_ (VEC m) (METRIC-TOP RR-MS)))
(define b6s-PR (list 'TPRODUCT-TOP '(VEC m) b6s-RF))
(define b6s-PRP (list 'TPROD-PTS '(VEC m) b6s-RF))
(define b6s-TW (b6s-sub b6s-PR b6s-UB))
(define b6s-TD (list 'METRIC-TOP b6s-D))
(define b6s-ID (list 'VNB-LAMBDA 'b6i_ b6s-UB 'b6i_))

;;; CUT 2026-10-27 (integration): `metric-top-pts-b6s' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `metric-top-pts', which is cited below in its place (proven-duplicate audit).

(define (b6s-weak-setup!)              ; nvs, (VEC m) a set: R^E facts, UB in its points, the subspace facts
  (dk-project! '(IN (VEC m) SET) 'is-normed-vector-space b6s-nvs)
  (dk-split-all! (list (dk-cite! 'line-product-facts '(VEC m))))
  (dk-cite! 'dual-unit-ball-in-set 'm)
  (if (not (dk-asm? (list 'SUBSET b6s-UB (list 'PTS b6s-PR))))
      (b6s-subset! b6s-UB (list 'PTS b6s-PR)
        (lambda (f) (b6s-ub! f) (dk-cite! 'fun-in-line-product '(VEC m) f) (subst (list '== (list 'PTS b6s-PR) b6s-PRP)) (dk-ass!))))
  (b6s-sub-facts! b6s-PR b6s-UB))
(define (b6s-rfy! y)
  (let ((e (list '= (list b6s-RF y) b6s-RRT)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))

(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense) (list 'IS-HOM-TOP-SPACE b6s-TD b6s-TW b6s-ID)))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(dk-cite! 'rr-metric-top-pts)
(dk-cite! 'metric-top-is-top-space 'RR-MS)
(b6s-weak-setup!)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-cite! 'metric-top-is-top-space b6s-D)
(dk-cite! 'metric-top-pts b6s-D)
(dk-have! (list '== (list 'PTS b6s-TD) b6s-UB) (lambda () (subst (list '== (list 'PTS b6s-TD) (list 'PTS b6s-D))) (subst (list '== (list 'PTS b6s-D) b6s-UB)) (qrfl)))
(dk-have! (list 'IS-TOP-FAMILY '(VEC m) b6s-RF)
  (lambda () (mac 'is-top-family) (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((y (dk-di-var!))) (subst (b6s-rfy! y)) (dk-ass!)))))))
(dk-have! (list 'IN b6s-ID (list 'FUN (list 'PTS b6s-TD) b6s-PRP))
  (lambda () (subst (list '== (list 'PTS b6s-TD) b6s-UB))
             (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (dk-cite! 'subset-mem-fwd b6s-UB (list 'PTS b6s-PR) q) (dk-rewrite-h! (list 'IN q (list 'PTS b6s-PR)) (list 'PTS b6s-PR) b6s-PRP) (dk-ass!)))
                           (lambda () (dk-ass!)))))
(let ((iff (dk-cite! 'tprod-hom-iff '(VEC m) b6s-RF b6s-TD b6s-ID)))
  (dk-have! (caddr iff)
    (lambda ()
      (let* ((k (dk-di-var!)) (ev (b6s-EV k))
             (cm (list 'VNB-LAMBDA 'tpq_ (list 'PTS b6s-TD) (list (list b6s-ID 'tpq_) k))))
        (subst (b6s-rfy! k))
        (dk-cite! 'dual-ball-evaluation-continuous 'm 'xs k)
        (let ((mh (dk-cite! 'metric-top-hom b6s-D 'RR-MS ev)))
          (dk-have! (cadr mh) (lambda () (if (dk-only! mh (caddr mh)) (prop)))))
        (dk-have! (list 'IN cm (list 'FUN (list 'PTS b6s-TD) (list 'PTS b6s-RRT)))
          (lambda () (subst (list '== (list 'PTS b6s-TD) b6s-UB)) (subst (list '== (list 'PTS b6s-RRT) 'RR))
                     (dk-lam-type! (lambda () (let ((q (dk-di-var!)))
                                                (b6s-fval! q k)
                                                (dk-have! (list '= (list b6s-ID q) q) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                                                (subst (list '= (list b6s-ID q) q))
                                                (dk-ass!)))
                                   (lambda () (dk-ass!)))))
        (dk-have! (list 'FORALL 'tpq_ (list 'IMPLIES (list 'IN 'tpq_ (list 'PTS b6s-TD)) (list '= (list cm 'tpq_) (list ev 'tpq_))))
          (lambda () (let ((q (dk-di-var!)))
                       (dk-rewrite-h! (list 'IN q (list 'PTS b6s-TD)) (list 'PTS b6s-TD) b6s-UB)
                       (b6s-fval! q k)
                       (dk-have! (list '= (list b6s-ID q) q) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                       (dk-have! (list '= (list ev q) (list q k)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                       (dk-have! (list 'IN (list 'PTS b6s-TD) 'SET) (lambda () (subst (list '== (list 'PTS b6s-TD) b6s-UB)) (dk-ass!)))
                       (dk-have! (list 'IN q (list 'PTS b6s-TD)) (lambda () (subst (list '== (list 'PTS b6s-TD) b6s-UB)) (dk-ass!)))
                       (dk-lam-b!)
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                           (begin (subst (list '= (list b6s-ID q) q)) (subst (list '= (list ev q) (list q k))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
        (dk-cite! 'hom-top-space-ptwise-eq b6s-TD b6s-RRT ev cm)
        (dk-ass!))))
  (dk-have! (list 'IS-HOM-TOP-SPACE b6s-TD b6s-PR b6s-ID) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(dk-have! (list 'FORALL 'b6x_ (list 'IMPLIES (list 'IN 'b6x_ (list 'PTS b6s-TD)) (list 'IN (list b6s-ID 'b6x_) b6s-UB)))
  (lambda () (let ((q (dk-di-var!)))
               (dk-rewrite-h! (list 'IN q (list 'PTS b6s-TD)) (list 'PTS b6s-TD) b6s-UB)
               (dk-have! (list '= (list b6s-ID q) q) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
               (subst (list '= (list b6s-ID q) q)) (dk-ass!))))
(dk-cite! 'hom-into-subspace b6s-TD b6s-PR b6s-UB b6s-ID)
(dk-ass!)
(b6s-qed! 'dual-ball-identity-continuous)

;;; ===========================================================================
;;; (9) THE BOXES: a weak*-open neighbourhood of fo constraining the first nb points x_j to within dl
;;; ===========================================================================
(define (b6s-psi fo nb dl) (list 'VNB-LAMBDA 'b6j_ (list 'ORD-SEGMENT nb) (list 'LIST '(xs b6j_) (list 'BALL 'RR-MS (list fo '(xs b6j_)) dl))))
(define (b6s-bb fo nb dl) (list 'IMAGE (b6s-psi fo nb dl) (list 'ORD-SEGMENT nb)))
(define (b6s-box fo nb dl) (list 'TPROD-BOX '(VEC m) b6s-RF (b6s-bb fo nb dl)))
(define b6s-K (list 'TPROD-CONSTR '(VEC m) b6s-RF))
(define (b6s-ball-open! c r)           ; c, r in RR, 0 < r: BALL(RR-MS, c, r) in OPENS(METRIC-TOP RR-MS); returns it
  (let ((bl (list 'BALL 'RR-MS c r)))
    (dk-cite! 'rr-is-metric-space) (dk-cite! 'r7q-rr-pts)
    (dk-have! (list 'IN c '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
    (dk-pos-parts! r)
    (dk-apply! (dk-cite! 'ball-is-open 'RR-MS) c r)
    (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'RR-MS) bl)))
      (dk-have! (list 'IN bl (list 'OPENS b6s-RRT)) (lambda () (if (dk-only! oi (list 'IS-OPEN 'RR-MS bl)) (prop)))))
    bl))
;; one constraint [z, BALL(c, r)] of the product of lines over VEC m
(sp (make-wff (b6s-alls '(m z c r) (b6s-imps (list b6s-nvs '(IN z (VEC m)) '(IN c RR) '(IN r RR) '(< 0 r))
   (list 'IN '(LIST z (BALL RR-MS c r)) b6s-K)))))
(dk-peel!)
(let* ((bl (b6s-ball-open! 'c 'r)) (w (list 'LIST 'z bl))
       (bu (list 'BIG-UNION 'tpj_ '(VEC m) (list 'OPENS (list b6s-RF 'tpj_))))
       (im (dk-cite! 'tprod-constr-mem '(VEC m) b6s-RF w)))
  (b6s-rfy! 'z)
  (dk-have! (list 'IN bl (list 'OPENS (list b6s-RF 'z))) (lambda () (subst (b6s-rfy! 'z)) (dk-ass!)))
  (dk-have! (list 'IN bl bu) (lambda () (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi 'z))))))
  (dk-cite! 'pair-in-cartesian '(VEC m) bu 'z bl)
