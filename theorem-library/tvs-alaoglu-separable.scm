;; the evaluation map is injective on the unit ball (density + the Lipschitz bound)
(define b6s-injB (list 'FORALL 'pbx_ (list 'IMPLIES (list 'IN 'pbx_ b6s-UB) (list 'FORALL 'pby_ (list 'IMPLIES (list 'IN 'pby_ b6s-UB)
                   (list 'IMPLIES (list '= (list b6s-DBJ 'pbx_) (list b6s-DBJ 'pby_)) '(= pbx_ pby_)))))))
(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense) b6s-injB))))
(dk-peel!)
(let* ((gl (dk-goal)) (f (cadr gl)) (g (caddr gl))
       (heq (list '= (list b6s-DBJ f) (list b6s-DBJ g))))
  (b6s-ub! f) (b6s-ub! g)
  (for-each (lambda (h) (let ((fi (dk-cite! 'fun-codomain-iff '(VEC m) 'RR h)))
                          (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN h '(FUN (VEC m) RR))) (prop))))
                          (dk-split! (caddr fi))))
            (list f g))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m)) (list '= (list f 'x) (list g 'x))))
    (lambda ()
      (let* ((z (dk-di-var!)) (fz (list f z)) (gz (list g z)) (u (list '- fz gz)) (d (list 'abs u)) (e (list '* 1/4 d)))
        (pbc)
        (b6s-fval! f z) (b6s-fval! g z)
        (b6s-real! u) (b6s-real! d) (b6s-real! e)
        (dk-cite! 'rr-abs-nonneg u)
        (let ((zr (dk-cite! 'rr-abs-zero u)))
          (dk-have! (list '< 0 d)
            (lambda () (mac '<)
                       (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                      (begin (di)
                                                             (dk-have! (list '= d 0) (lambda () (dk-ineq! (list 'IN d 'RR) (list '= 0 d))))
                                                             (dk-have! (list '= u 0) (lambda () (if (dk-only! zr (list '= d 0)) (prop))))
                                                             (dk-have! (list '= fz gz) (lambda () (dk-ineq! (list 'IN fz 'RR) (list 'IN gz 'RR) (list '= u 0))))
                                                             (ai (list 'NOT (list '= fz gz))))))))))
        (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list 'IN d 'RR) (list '< 0 d))))
        (b6s-posrr! e)
        (let* ((ex (dk-apply! (dk-ctx-form b6s-dense) z e))
               (n (dk-skolem! ex #t))
               (xn (list 'xs n)) (nv (list '(VNRM m) (list '(VADD m) z (list '(VNEG m) xn)))))
          (b6s-norm! (list '(VADD m) z (list '(VNEG m) xn)))
          (b6s-fval! f xn) (b6s-fval! g xn)
          (dk-cite! 'dbj-value 'm 'xs f n) (dk-cite! 'dbj-value 'm 'xs g n)
          (for-each (lambda (h) (dk-have! (list 'IN (list (list b6s-DBJ h) n) 'RR)
                                  (lambda () (subst (list '= (list (list b6s-DBJ h) n) (list h xn))) (dk-ass!))))
                    (list f g))
          (dk-congr! heq (lambda (t) (list t n)))
          (dk-cite! 'dual-ball-lipschitz 'm f z xn) (dk-cite! 'dual-ball-lipschitz 'm g z xn)
          (b6s-abs-out! (list '- fz (list f xn)) nv)
          (b6s-abs-out! (list '- gz (list g xn)) nv)
          (let ((prems (list (list 'IN fz 'RR) (list 'IN gz 'RR) (list 'IN (list f xn) 'RR) (list 'IN (list g xn) 'RR) (list 'IN nv 'RR)
                             (list 'IN (list (list b6s-DBJ f) n) 'RR) (list 'IN (list (list b6s-DBJ g) n) 'RR)
                             (list '= (list (list b6s-DBJ f) n) (list (list b6s-DBJ g) n))
                             (list '= (list (list b6s-DBJ f) n) (list f xn)) (list '= (list (list b6s-DBJ g) n) (list g xn))
                             (list '<= (list '- nv) (list '- fz (list f xn))) (list '<= (list '- fz (list f xn)) nv)
                             (list '<= (list '- nv) (list '- gz (list g xn))) (list '<= (list '- gz (list g xn)) nv))))
            (b6s-real! (list '* 2 nv))
            (dk-have! (list '<= (list '- (list '* 2 nv)) u) (lambda () (apply dk-ineq! prems)))
            (dk-have! (list '<= u (list '* 2 nv)) (lambda () (apply dk-ineq! prems)))
            (dk-cite! 'rr-abs-le-of-parts u (list '* 2 nv))
            (dk-absurd! (list 'IN d 'RR) (list 'IN nv 'RR) (list '<= d (list '* 2 nv)) (list '< nv e) (list '< 0 d)))))))
  (dk-cite! 'fun-domain-extensionality '(VEC m) f g)
  (dk-ass!))
(b6s-qed! 'dbj-injective)

