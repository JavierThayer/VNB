(define (b6s-posrr! e)                 ; (IN e RR), (< 0 e) in context: lands (POS-RR e)
  (let ((g (list 'POS-RR e)))
    (if (not (dk-asm? g))
        (begin
          (dk-project! (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))) (lambda () (mac-h '< (dk-ctx-form (list '< 0 e)))))
          (dk-split-all! (list (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e)))))
          (dk-have! g (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))))
    g))
(define (b6s-abs-out! u c)             ; (<= (abs u) c) in context: lands -c <= u, u <= c
  (b6s-real! u) (b6s-real! c)
  (dk-split! (dk-cite! 'rr-abs-le-parts u c)))

;; the product carrier, membership
