(b6s-qed! 'pullback-is-metric-space)

;; convergence in the pullback is convergence of the images
(define (b6s-xfer! src mkeq!)          ; goal: the eps-clause of a CONVERGES-TO; src: the other eps-clause, in context
  (let* ((ld (dk-peel!))
         (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld)))
         (ex (dk-apply! src eps))
         (nb (dk-skolem! ex #t))
         (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h eps))) "the tail clause")))
    (ew nb)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((g (begin (dk-peel!) (dk-goal))) (n (cadr (cadr (cadr g)))))
              (dk-apply! cl n)
              (mkeq! n)
              (dk-ass!)))))))
(define b6s-cv-hyps (append b6s-pbhyps (list '(IN sq (FUN NN ss)) '(IN a ss))))
(define b6s-csq '(COMPOSE jj sq))
(define (b6s-clause s f l)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= n n_) (list '<= (list (list 'DIST s) (list f 'n_) l) 'eps)))))))))
(sp (make-wff (b6s-alls '(mt ss jj sq a) (b6s-imps b6s-cv-hyps (list 'IFF (list 'CONVERGES-TO b6s-PB 'sq 'a) (list 'CONVERGES-TO 'mt b6s-csq '(jj a)))))))
(dk-peel!)
(dk-cite! 'pullback-is-metric-space 'mt 'ss 'jj)
(dk-cite! 'pullback-pts 'mt 'ss 'jj)
(fact 'nn-is-set)
(b6s-and! '(IN sq (FUN NN ss)) '(IN jj (FUN ss (PTS mt))))
(dk-cite! 'compose-type 'NN 'ss '(PTS mt) 'jj 'sq)
(dk-cite! 'fun-apply-type-c 'jj 'ss '(PTS mt) 'a)
(dk-have! (list 'IN 'sq (list 'FUN 'NN (list 'PTS b6s-PB))) (lambda () (subst (list '== (list 'PTS b6s-PB) 'ss)) (dk-ass!)))
(dk-have! (list 'IN 'a (list 'PTS b6s-PB)) (lambda () (subst (list '== (list 'PTS b6s-PB) 'ss)) (dk-ass!)))
(let* ((ca (dk-cite! 'compose-apply 'NN 'ss '(PTS mt) 'jj 'sq))
       (prep! (lambda (n)
                (dk-cite! 'fun-apply-type-c 'sq 'NN 'ss n)
                (dk-apply! ca n)
                (dk-cite! 'pullback-dist 'mt 'ss 'jj (list 'sq n) 'a)))
       (dpb (lambda (n) (list (list 'DIST b6s-PB) (list 'sq n) 'a)))
       (dmt (lambda (n) (list '(DIST mt) (list 'jj (list 'sq n)) '(jj a)))))
  (mac 'converges-to)
  (dk-iff! (lambda (g) (dk-contains? g b6s-csq))
    (lambda ()
      (dk-split-all!)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (b6s-xfer! (dk-ctx-form (b6s-clause b6s-PB 'sq 'a))
                         (lambda (n) (prep! n)
                                 (subst (list '= (list b6s-csq n) (list 'jj (list 'sq n))))
                                 (subst (list '= (dmt n) (dpb n)))))))))
    (lambda ()
      (dk-split-all!)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (b6s-xfer! (dk-ctx-form (b6s-clause 'mt b6s-csq '(jj a)))
                         (lambda (n) (prep! n)
                                 (subst (list '= (dpb n) (dmt n)))
                                 (subst (list '= (list 'jj (list 'sq n)) (list b6s-csq n)))))))))))
(b6s-qed! 'pullback-converges-to)

;;; ===========================================================================
;;; (2) THE INTERVALS, THE EVALUATION MAP, THE METRIC
;;; ===========================================================================
(define b6s-nvs '(IS-NORMED-VECTOR-SPACE m))
(define b6s-xs '(IN xs (FUN NN (VEC m))))
(define b6s-dense '(FORALL dz_ (IMPLIES (IN dz_ (VEC m)) (FORALL deps_ (IMPLIES (POS-RR deps_)
                     (FORSOME dk_ (AND (IN dk_ NN) (< ((VNRM m) ((VADD m) dz_ ((VNEG m) (xs dk_)))) deps_))))))))
(define b6s-UB '(DUAL-UNIT-BALL m))
(define b6s-DBI '(DBI m xs))
(define b6s-DBJ '(DBJ m xs))
(define b6s-PC '(PRODUCT-CARRIER (DBI m xs)))
(define b6s-PM '(PRODUCT-METRIC (DBI m xs)))
(define b6s-W0 '(VNB-LAMBDA n NN (/ 1 (power 2 (+ n 1)))))
(define b6s-D '(DUAL-BALL-MS m xs))
(define (b6s-r n) (list '(VNRM m) (list 'xs n)))
(define (b6s-iv n) (list 'CCINT (list '- (b6s-r n)) (b6s-r n)))
(define (b6s-nbd f) (list 'FORALL 'dbx_ (list 'IMPLIES '(IN dbx_ (VEC m)) (list '<= (list 'abs (list f 'dbx_)) '((VNRM m) dbx_)))))

(define (b6s-real! t)                  ; typed atoms, - + * abs, numbers
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((dk-head-is? t 'abs) (b6s-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (b6s-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3)) (b6s-real! (cadr t)) (b6s-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (b6s-real! (cadr t)) (b6s-real! (caddr t)) (b6s-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t)) ty)
          (#t (dk-type! t) ty))))
(define (b6s-vec! v)                   ; (IN v (VEC m)) for xs(n), vadd, vneg, act of typed pieces
  (let ((ty (list 'IN v '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((and (pair? v) (eq? (car v) 'xs)) (dk-cite! 'fun-apply-type-c 'xs 'NN '(VEC m) (cadr v)) ty)
          ((and (pair? v) (equal? (car v) '(VADD m))) (b6s-vec! (cadr v)) (b6s-vec! (caddr v)) (dk-apply! (dk-cite! 'nvs-vadd-in-vec 'm) (cadr v) (caddr v)) ty)
          ((and (pair? v) (equal? (car v) '(VNEG m))) (b6s-vec! (cadr v)) (dk-apply! (dk-cite! 'nvs-vneg-in-vec 'm) (cadr v)) ty)
          ((and (pair? v) (equal? (car v) '(ACT m))) (b6s-real! (cadr v)) (b6s-vec! (caddr v)) (dk-apply! (dk-cite! 'nvs-act-in-vec 'm) (cadr v) (caddr v)) ty)
          (#t (error "b6s-vec!: no typing for" v)))))
(define (b6s-norm! v) (b6s-vec! v) (dk-cite! 'vnrm-real 'm v) (dk-cite! 'vnrm-nonneg 'm v) (list 'IN (list '(VNRM m) v) 'RR))

;; the unit ball: pieces of a member (FUN, linear, |f(x)| <= ||x||)
(define (b6s-ub! f)
  (if (not (dk-asm? (b6s-nbd f)))
      (let ((um (dk-cite! 'dual-unit-ball-mem 'm f)))
        (dk-have! (caddr um) (lambda () (if (dk-only! um (list 'IN f b6s-UB)) (prop))))
        (dk-split-all! (list (caddr um)))
        (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m)) (list '= (list f '((VADD m) x_ y_)) (list '+ (list f 'x_) (list f 'y_)))))))
                     'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm f))
        (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '= (list f '((ACT m) r_ x_)) (list '* 'r_ (list f 'x_)))))))
                     'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm f)))))
(define (b6s-fadd f) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m)) (list '= (list f '((VADD m) x_ y_)) (list '+ (list f 'x_) (list f 'y_))))))))
(define (b6s-fhom f) (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '= (list f '((ACT m) r_ x_)) (list '* 'r_ (list f 'x_))))))))
(define (b6s-fval! f v)
  (b6s-vec! v)
  (if (and (not (dk-asm? (list 'IN f '(FUN (VEC m) RR)))) (dk-asm? (list 'IN f b6s-UB))) (b6s-ub! f))
  (dk-cite! 'fun-apply-type-c f '(VEC m) 'RR v) (list 'IN (list f v) 'RR))

;; f(z - y) = f(z) - f(y) for f in the unit ball
(sp (make-wff (b6s-alls '(m f z y) (b6s-imps (list b6s-nvs (list 'IN 'f b6s-UB) '(IN z (VEC m)) '(IN y (VEC m)))
                                            '(= (f ((VADD m) z ((VNEG m) y))) (- (f z) (f y)))))))
(dk-peel!)
(b6s-ub! 'f)
(let* ((ny '((VNEG m) y))
       (e1 (dk-apply! (dk-cite! 'nvs-neg-one-act 'm) 'y))    ; (ACT m) -1 y = vneg y
       (act (cadr e1)) (m1 (cadr act)))
  (b6s-vec! ny) (b6s-real! m1)
  (b6s-fval! 'f 'z) (b6s-fval! 'f 'y) (b6s-fval! 'f ny) (b6s-fval! 'f act)
  (dk-apply! (dk-ctx-form (b6s-fadd 'f)) 'z ny)
  (dk-apply! (dk-ctx-form (b6s-fhom 'f)) m1 'y)
  (dk-congr! e1 (lambda (t) (list 'f t)))
  (dk-have! (list '= (list '* m1 '(f y)) '(- (f y))) (lambda () (crs)))
  (b6s-real! (list '* m1 '(f y)))
  (b6s-fval! 'f (list '(VADD m) 'z ny))
  (dk-ineq! '(IN (f z) RR) '(IN (f y) RR) (list 'IN (list 'f ny) 'RR) (list 'IN (list 'f act) 'RR) (list 'IN (list '* m1 '(f y)) 'RR)
            (list 'IN (list 'f (list '(VADD m) 'z ny)) 'RR)
            (list '= (list 'f (list '(VADD m) 'z ny)) (list '+ '(f z) (list 'f ny)))
            (list '= (list 'f act) (list '* m1 '(f y))) (list '= (list 'f act) (list 'f ny))
            (list '= (list '* m1 '(f y)) '(- (f y)))))
(b6s-qed! 'dual-ball-sub)

;; |f(z) - f(y)| <= ||z - y|| on the unit ball
(sp (make-wff (b6s-alls '(m f z y) (b6s-imps (list b6s-nvs (list 'IN 'f b6s-UB) '(IN z (VEC m)) '(IN y (VEC m)))
                                            '(<= (abs (- (f z) (f y))) ((VNRM m) ((VADD m) z ((VNEG m) y))))))))
(dk-peel!)
(b6s-ub! 'f)
(let ((d '((VADD m) z ((VNEG m) y))))
  (b6s-vec! d)
  (dk-cite! 'dual-ball-sub 'm 'f 'z 'y)
  (dk-apply! (dk-ctx-form (b6s-nbd 'f)) d)
  (subst (list '= '(- (f z) (f y)) (list 'f d)))
  (dk-ass!))
(b6s-qed! 'dual-ball-lipschitz)

;; the intervals
(sp (make-wff (b6s-alls '(m xs n) (b6s-imps (list b6s-nvs b6s-xs '(IN n NN)) (list '== (list b6s-DBI 'n) (list 'SUBSPACE-MS 'RR-MS (b6s-iv 'n)))))))
(dk-peel!)
(mac 'DBI)
(lam-b)
(if (not (proof-done? *ps*)) (qrfl))
(b6s-qed! 'dbi-at)
(define (b6s-iv-facts! n)              ; n in NN: r = ||x_n|| typed; the interval a set; DBI(n) == SUBSPACE-MS; its PTS
  (let ((r (b6s-r n)) (iv (b6s-iv n)))
    (if (not (dk-asm? (list '== (list 'PTS (list b6s-DBI n)) iv)))
        (begin
          (b6s-norm! (list 'xs n))
          (b6s-real! (list '- r))
          (fact 'rr-is-set)
          (dk-cite! 'ccint-subset-rr (list '- r) r)
          (dk-cite! 'subclass-of-set-is-set iv 'RR)
          (dk-cite! 'dbi-at 'm 'xs n)
          (dk-cite! 'subspace-pts 'RR-MS iv)
          (dk-have! (list '== (list 'PTS (list b6s-DBI n)) iv)
            (lambda () (subst (list '== (list b6s-DBI n) (list 'SUBSPACE-MS 'RR-MS iv))) (dk-ass!)))))
    iv))
(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs)
  (list 'AND (list 'IS-MS-SEQUENCE b6s-DBI) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'SEQ-COMPACT (list b6s-DBI 'n)))))))))
(dk-peel!)
(dk-cite! 'rr-is-metric-space)
(define (b6s-sub-ms! n)                ; IS-METRIC-SPACE(SUBSPACE-MS RR-MS iv(n))
  (let ((iv (b6s-iv n)))
    (dk-cite! 'r7q-rr-pts)
    (dk-have! (list 'SUBSET iv '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
    (dk-apply! (dk-cite! 'subspace-is-metric-space 'RR-MS) iv)))
(define (b6s-cpt! n)
  (let ((iv (b6s-iv-facts! n)) (r (b6s-r n)))
    (dk-cite! 'heine-borel-ccint (list '- r) r)
    (subst (list '== (list b6s-DBI n) (list 'SUBSPACE-MS 'RR-MS iv)))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IS-MS-SEQUENCE)
        (begin (mac 'is-ms-sequence)
               (let ((n (dk-di-var!)))
                 (b6s-cpt! n)
                 (b6s-sub-ms! n)
                 (dk-ass!)))
        (let ((n (dk-di-var!)))
