;;; tb6s.scm -- topological-vector-space.pdf Remark 3.30: the SEPARABLE Banach-Alaoglu theorem by the METRIC route.
;;; For a normed space with a dense sequence (x_n), the dual unit ball B* carries the metric
;;; d(f, g) = sum_n 2^-(n+1) rho(f(x_n), g(x_n)) (PRODUCT-METRIC of the intervals [-||x_n||, ||x_n||], pulled back);
;;; its topology is the weak* topology on B*, and (B*, d) is compact, by the diagonal argument (sequential
;;; compactness) -- with NO citation of the general Tychonoff theorem.
;;; Agent TB-6 (worker-08), 2026-10-27.  DESTINATION: theorem-library/tvs-alaoglu-separable.scm.  Library: analysis.
;;; Helper prefix: b6s-.
;;; Needs: tb6s-vocab.scm; tb6.scm for its NON-Tychonoff lemmas only (dual-unit-ball-mem, the line-product
;;; coordinate-ball lemmas, hom-into-subspace, subspace-of-subspace, fun-in-line-product, line-product-facts);
;;; tych.scm for tprod-hom-iff, tprod-box-open (no tychonoff); the tree's product-metric, coordinatewise-diagonal-subseq,
;;; compact-iff-seq-compact, heine-borel-ccint, rr-cauchy-converges, rr-limit-*, sequential-implies-continuous-at.

(define (b6s-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; B6S OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (b6s-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (b6s-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (b6s-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (b6s-head g) (and (pair? g) (car g)))
(define (b6s-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (b6s-tree-sub x y s)) t)) (#t t)))

