(define (b6s-has-lam? g)
  (cond ((and (pair? g) (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA)) #t)
        ((pair? g) (or (b6s-has-lam? (car g)) (b6s-has-lam? (cdr g))))
        (#t #f)))
(define (b6s-jpt! x) (dk-cite! 'fun-apply-type-c 'jj 'ss '(PTS mt) x))
(define (b6s-drive!)
  (let loop ((fuel 200))
    (let ((k (find-first (lambda (n) (memq (b6s-head (dk-goal-of n)) '(FORALL IMPLIES AND))) (dk-open-leaves))))
      (if (and k (> fuel 0))
          (begin (dk-focus! k)
                 (let lp ((f 20)) (if (and (> f 0) (b6s-has-lam? (dk-goal))) (let ((b (dk-goal))) (lam-b) (if (not (equal? b (dk-goal))) (lp (- f 1))))))
                 (if (memq (b6s-head (dk-goal)) '(FORALL IMPLIES AND)) (di))
                 (loop (- fuel 1)))))))
(define (b6s-jarg t) (cadr t))          ; (jj a) -> a
(define (b6s-law!)
  (let ((g (dk-goal)))
    (cond
      ((and (eq? (b6s-head g) '=) (equal? (caddr g) 0))
       (let ((a (b6s-jarg (cadr (cadr g))))) (b6s-jpt! a) (fact 'metric-self-zero 'mt (list 'jj a)) (dk-ass!)))
      ((and (eq? (b6s-head g) '<=) (equal? (cadr g) 0))
       (let* ((d (caddr g)) (a (b6s-jarg (cadr d))) (b (b6s-jarg (caddr d))))
         (b6s-jpt! a) (b6s-jpt! b) (fact 'metric-pos 'mt (list 'jj a) (list 'jj b)) (dk-ass!)))
      ((and (eq? (b6s-head g) '=) (symbol? (cadr g)))
       (let ((a (cadr g)) (b (caddr g)))
         (b6s-jpt! a) (b6s-jpt! b) (fact 'metric-zero-eq 'mt (list 'jj a) (list 'jj b))
         (dk-apply! (dk-ctx-form b6s-inj) a b) (dk-ass!)))
      ((eq? (b6s-head g) '=)
       (let* ((d (cadr g)) (a (b6s-jarg (cadr d))) (b (b6s-jarg (caddr d))))
         (b6s-jpt! a) (b6s-jpt! b) (fact 'metric-sym 'mt (list 'jj a) (list 'jj b)) (dk-ass!)))
      ((eq? (b6s-head g) '<=)
       (let* ((d (cadr g)) (a (b6s-jarg (cadr d))) (c (b6s-jarg (caddr d))) (b (b6s-jarg (caddr (cadr (caddr g))))))
         (b6s-jpt! a) (b6s-jpt! b) (b6s-jpt! c) (fact 'metric-triangle 'mt (list 'jj a) (list 'jj b) (list 'jj c)) (dk-ass!)))
      (#t (error "b6s-law!: unexpected leaf" g)))))
(define (b6s-and-split! closer)
  (if (eq? (b6s-head (dk-goal)) 'AND)
      (for-each (lambda (k) (dk-focus! k) (b6s-and-split! closer)) (dk-opened (lambda () (di))))
      (closer)))
(sp (make-wff (b6s-alls '(mt ss jj) (b6s-imps b6s-pbhyps (list 'IS-METRIC-SPACE b6s-PB)))))
