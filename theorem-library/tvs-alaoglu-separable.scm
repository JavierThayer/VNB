                                 (let* ((g3 (dk-goal)) (d (cadr g3)) (a (b6s-jarg (cadr d))) (b (b6s-jarg (caddr d))))
                                   (b6s-jpt! a) (b6s-jpt! b) (fact 'metric-dist-real 'mt (list 'jj a) (list 'jj b)) (dk-ass!))))))
                   (dk-opened (lambda () (lam-t)))))
        (#t (let ((before (dk-open-leaves)))
