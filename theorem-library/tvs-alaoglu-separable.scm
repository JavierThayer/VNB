;; THE THEOREM (Remark 3.30): for a normed space with a dense sequence (x_n), the dual unit ball with the metric
;; d(f, g) = sum_n 2^-(n+1) rho(f(x_n), g(x_n)) is a compact metric space whose open sets are exactly the weak*-open
;; subsets of the ball.
(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense)
   (list 'AND (list 'IS-METRIC-SPACE b6s-D)
         (list 'AND (list '== (list 'PTS b6s-D) b6s-UB)
               (list 'AND (list 'FORALL 'u (list 'IFF (list 'IN 'u (list 'OPENS b6s-TW0)) (list 'IS-OPEN b6s-D 'u)))
                     (list 'IS-COMPACT b6s-D))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-cite! 'dual-ball-topology-agrees 'm 'xs)
(dk-cite! 'dual-ball-compact 'm 'xs)
(dk-conj-close! (lambda () (dk-ass!)))
(b6s-qed! 'banach-alaoglu-separable)

;; Remark 3.30 as the notes state it: for a SEPARABLE normed space the weak* topology of the dual unit ball is
;; metrizable -- and (B*, weak*) is compact, by the metric route (no Tychonoff).
(define b6s-NMS '(NVS-METRIC-SPACE m))
(define b6s-sepcl (list 'FORSOME 'dseq (list 'AND (list 'IN 'dseq (list 'FUN 'NN (list 'PTS b6s-NMS)))
                    (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS b6s-NMS)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
                      (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST b6s-NMS) 'x '(dseq n)) 'eps))))))))))
(sp (make-wff (b6s-alls '(m) (b6s-imps (list b6s-nvs (list 'IS-SEPARABLE b6s-NMS))
   (list 'AND (list 'IS-METRIZABLE-TOP-SPACE b6s-TW0) (list 'IS-COMPACT-T b6s-TW0))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'nvs-metric-is-ms 'm)
(dk-cite! 'nvs-ms-pts 'm)
(dk-project! b6s-sepcl 'is-separable (list 'IS-SEPARABLE b6s-NMS))
(let* ((xs0 (dk-skolem! (dk-ctx-form b6s-sepcl) #t))
       (dcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h xs0) (dk-contains? h 'eps))) "the density clause"))
       (X! (lambda (t) (b6s-tree-sub 'xs xs0 t)))
       (Dm (X! b6s-D)))
  (dk-rewrite-h! (list 'IN xs0 (list 'FUN 'NN (list 'PTS b6s-NMS))) (list 'PTS b6s-NMS) '(VEC m))
  (dk-have! (X! b6s-dense)
    (lambda ()
      (let* ((ld (dk-peel!))
             (z (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC m)))) ld)))
             (e (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
        (dk-have! (list 'IN z (list 'PTS b6s-NMS)) (lambda () (subst (list '== (list 'PTS b6s-NMS) '(VEC m))) (dk-ass!)))
        (let ((k (dk-skolem! (dk-apply! dcl z e) #t)))
          (dk-cite! 'fun-apply-type-c xs0 'NN '(VEC m) k)
          (dk-apply! (dk-cite! 'nvs-metric-distance 'm) z (list xs0 k))
          (ew k)
          (dk-conj-close! (lambda () (if (not (dk-ass!))
                                         (begin (subst (list '= (list '(VNRM m) (list '(VADD m) z (list '(VNEG m) (list xs0 k)))) (list (list 'DIST b6s-NMS) z (list xs0 k))))
                                                (dk-ass!)))))))))
  (let ((thm (dk-cite! 'banach-alaoglu-separable 'm xs0)))
    (dk-split-all! (list thm)))
  (b6s-tw-unfold!)
  (dk-cite! 'subspace-top-unfold b6s-PR b6s-UB)
  (let* ((agr (X! (list 'FORALL 'u (list 'IFF (list 'IN 'u (list 'OPENS b6s-TW0)) (list 'IS-OPEN b6s-D 'u)))))
         (sepD (list 'SEP 'u (list 'POWER (list 'PTS Dm)) (list 'IS-OPEN Dm 'u)))
         (sepU (list 'SEP 'u (list 'POWER b6s-UB) (list 'IS-OPEN Dm 'u)))
         (so (b6s-subopens b6s-PR b6s-UB))
         (lst (list 'LIST b6s-UB sepU)))
    ;; the opens of the weak* subspace are the d-open sets
    (dk-have! (list 'FORALL 'b6z_ (list 'IFF (list 'IN 'b6z_ so) (list 'IN 'b6z_ sepU)))
      (lambda ()
        (let ((v (begin (di) (cadr (cadr (dk-goal))))))
          (dk-apply! (dk-ctx-form agr) v)
          (dk-iff! (lambda (g) (equal? g (list 'IN v sepU)))
            (lambda ()
              (dk-have! (list 'IN v (list 'OPENS b6s-TW0))
                (lambda () (subst (list '== b6s-TW0 b6s-TW)) (subst (list '== (list 'OPENS b6s-TW) so)) (dk-ass!)))
              (dk-have! (list 'IS-OPEN Dm v) (lambda () (let ((i (dk-ctx-form (list 'IFF (list 'IN v (list 'OPENS b6s-TW0)) (list 'IS-OPEN Dm v))))) (if (dk-only! i (list 'IN v (list 'OPENS b6s-TW0))) (prop)))))
              (dk-project! (list 'SUBSET v (list 'PTS Dm)) 'is-open (list 'IS-OPEN Dm v))
              (dk-rewrite-h! (list 'SUBSET v (list 'PTS Dm)) (list 'PTS Dm) b6s-UB)
              (dk-cite! 'subclass-of-set-is-set v b6s-UB)
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ v) (list 'IN 'z_ b6s-UB))) (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd v b6s-UB e) (dk-ass!))))
              (dk-cite! 'power-mem-intro b6s-UB v)
