      (dk-have! (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ u) (list 'FORSOME 'tlw_ (list 'AND (list 'IN 'tlw_ (list 'OPENS b6s-TW)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ u))))))
        (lambda ()
