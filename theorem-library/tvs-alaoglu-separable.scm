;;; ===========================================================================
;;; (10) d-OPEN => weak*-OPEN: around fo, some box(fo, nb, 1/(nb+1)) meets B* inside the open set
;;;      (otherwise a choice g_nb from each box outside the set converges to fo at every x_n, hence in d)
;;; ===========================================================================
(define (b6s-dlt n) (list 'recip (list '+ n 1)))
(define (b6s-boxn n) (b6s-box 'fo n (b6s-dlt n)))
(define (b6s-sel n) (list 'SEP 'b6g_ b6s-UB (list 'AND (list 'IN 'b6g_ (b6s-boxn n)) '(NOT (IN b6g_ uu)))))
(define b6s-GSEL (list 'VNB-LAMBDA 'b6gn_ 'NN (list 'CHOICE (b6s-sel 'b6gn_))))
(define b6s-hasbox (list 'FORSOME 'b6b_ (list 'AND '(IN b6b_ NN) (list 'SUBSET (list 'INTERSECTION (b6s-boxn 'b6b_) b6s-UB) 'uu))))
(define (b6s-dlt-facts! n)             ; n in NN: dlt(n) in RR, 0 < dlt(n), (n+1) * dlt(n) = 1
  (let ((k (list '+ n 1)) (d (b6s-dlt n)))
    (if (not (dk-asm? (list '< 0 d)))
        (begin
          (dk-cite! 'nn-in-rr n)
          (b6s-real! k)
          (dk-have! (list '< 0 k) (lambda () (dk-nn! (list 'IN n 'NN))))
          (dk-have! (list 'NOT (list '= k 0)) (lambda () (di) (dk-absurd! (list 'IN k 'RR) (list '= k 0) (list '< 0 k))))
          (b6s-and! (list 'IN k 'RR) (list 'NOT (list '= k 0)))
          (dk-cite! 'rr-recip-closed k)
          (dk-cite! 'rr-recip-inverse k)
          (dk-cite! 'rr-recip-pos k)))
    d))
(sp (make-wff (b6s-alls '(m xs uu fo) (b6s-imps (list b6s-nvs b6s-xs b6s-dense (list 'IS-OPEN b6s-D 'uu) '(IN fo uu)) b6s-hasbox))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-project! (list 'SUBSET 'uu (list 'PTS b6s-D)) 'is-open (list 'IS-OPEN b6s-D 'uu))
(dk-rewrite-h! (list 'SUBSET 'uu (list 'PTS b6s-D)) (list 'PTS b6s-D) b6s-UB)
(dk-cite! 'subset-mem-fwd 'uu b6s-UB 'fo)
(pbc)
(define b6s-allg (list 'FORALL 'b6M_ (list 'IMPLIES '(IN b6M_ NN) (list 'FORSOME 'b6h_ (list 'IN 'b6h_ (b6s-sel 'b6M_))))))
(dk-have! b6s-allg
  (lambda ()
    (let* ((n (dk-di-var!)) (bx (b6s-boxn n)))
      (pbc)
      (dk-have! (list 'SUBSET (list 'INTERSECTION bx b6s-UB) 'uu)
        (lambda () (mac 'subset-def)
                   (let* ((g (dk-di-var!)) (im (dk-cite! 'intersection-membership bx b6s-UB g)))
                     (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN g (list 'INTERSECTION bx b6s-UB))) (prop))))
                     (dk-split! (caddr im))
                     (pbc)
                     (dk-have! (list 'FORSOME 'b6h_ (list 'IN 'b6h_ (b6s-sel n)))
                       (lambda () (ew g) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
                     (ai (list 'NOT (list 'FORSOME 'b6h_ (list 'IN 'b6h_ (b6s-sel n))))))))
      (dk-have! b6s-hasbox (lambda () (ew n) (dk-conj-close! (lambda () (dk-ass!)))))
      (ai (list 'NOT b6s-hasbox)))))
(define (b6s-gsat! k)                  ; k in NN: (= (GS k) (CHOICE sel k)); its membership facts
  (let* ((c (list 'CHOICE (b6s-sel k))) (e (list '= (list b6s-GSEL k) c)))
    (if (not (dk-asm? (list 'IN c (b6s-sel k))))
        (begin
          (dk-apply! (dk-ctx-form b6s-allg) k)
          (dk-cite! 'choice-axiom (b6s-sel k))
          (sep-me (dk-ctx-form (list 'IN c (b6s-sel k))))
          (dk-split-all!)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    (dk-have! (list 'IN (list b6s-GSEL k) b6s-UB) (lambda () (subst e) (dk-ass!)))
    c))
(dk-have! (list 'IN b6s-GSEL (list 'FUN 'NN b6s-UB))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-gsat! k) (dk-ass!))) (lambda () (dk-ass!)))))
;; convergence at every x_n
(dk-have! (b6s-tree-sub 'fs b6s-GSEL (b6s-cv-all 'fo))
  (lambda ()
    (let* ((n (dk-di-var!)) (sqn (b6s-tree-sub 'fs b6s-GSEL (b6s-H n))) (fxn (list 'fo (list 'xs n))))
      (b6s-fval! 'fo (list 'xs n))
      (dk-have! (list 'IN sqn '(FUN NN RR))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-gsat! k) (b6s-ub! (list b6s-GSEL k)) (b6s-fval! (list b6s-GSEL k) (list 'xs n)) (dk-ass!))) (lambda () (dk-ass!)))))
      (dk-have! (cadr (dk-cite! 'rr-converges-to-abs sqn fxn))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
            (b6s-pos-parts! eps)
            (fact 'nn-one-in)
            (dk-cite! 'rr-is-set)
            (let* ((n0 (dk-skolem! (dk-apply! (dk-cite! 'rr-archimedean-multiple eps) 1) #t))
                   (nb (list '+ n0 (list '+ n 1))))
              (b6s-and! (list 'IN n 'NN) '(IN 1 NN))
              (dk-cite! 'nn-add-closed n 1)
              (b6s-and! (list 'IN n0 'NN) (list 'IN (list '+ n 1) 'NN))
              (dk-cite! 'nn-add-closed n0 (list '+ n 1))
              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((g (begin (dk-peel!) (dk-goal))) (k (cadr (cadr (cadr (cadr g)))))
                             (gk (list b6s-GSEL k)) (gkx (list gk (list 'xs n))) (dk_ (b6s-dlt k)))
                        (b6s-gsat! k) (b6s-ub! gk) (b6s-fval! gk (list 'xs n))
                        (dk-have! (list '= (list sqn k) gkx) (lambda () (let ((c (b6s-gsat! k))) (b6s-ub! c) (b6s-fval! c (list 'xs n))) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                        (subst (list '= (list sqn k) gkx))
                        (b6s-dlt-facts! k)
                        (dk-cite! 'nn-in-rr n0) (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr n)
                        (dk-have! (list '< n k) (lambda () (dk-nn! (list 'IN n0 'NN) (list 'IN n 'NN) (list 'IN k 'NN) (list '<= nb k))))
                        (dk-cite! 'seg-mem-lt k n)
                        (dk-have! (list 'IN n (list 'ORD-SEGMENT k)) (lambda () (let ((sm (dk-ctx-form (list 'IFF (list 'IN n (list 'ORD-SEGMENT k)) (list '< n k))))) (if (dk-only! sm (list '< n k)) (prop)))))
                        (dk-have! (list 'IN gk (b6s-boxn k)) (lambda () (subst (list '= gk (list 'CHOICE (b6s-sel k)))) (dk-ass!)))
                        (dk-cite! 'dual-ball-box-coord 'm 'xs 'fo k dk_ gk n)
                        (b6s-real! (list '- fxn gkx)) (dk-split! (dk-cite! 'rr-abs-lt-parts (list '- fxn gkx) dk_))
                        ;; dlt(k) <= eps:  (k+1) dlt(k) = 1 <= n0 eps <= (k+1) eps
                        (let ((k1 (list '+ k 1)))
                          (dk-have! (list '<= n0 k1) (lambda () (dk-nn! (list 'IN n0 'NN) (list 'IN n 'NN) (list 'IN k 'NN) (list '<= nb k))))
                          (b6s-real! k1) (b6s-real! n0)
                          (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list 'IN eps 'RR) (list '< 0 eps))))
                          (dk-cite! 'rr-mul-le-right n0 k1 eps)
                          (dk-have! (list '= (list '* k1 dk_) (list '* dk_ k1)) (lambda () (crs)))
                          (b6s-real! (list '* n0 eps)) (b6s-real! (list '* k1 eps)) (b6s-real! (list '* dk_ k1)) (b6s-real! (list '* eps k1)) (b6s-real! (list '* k1 dk_))
                          (dk-have! (list '= (list '* k1 eps) (list '* eps k1)) (lambda () (crs)))
                          (dk-have! (list '<= (list '* dk_ k1) (list '* eps k1))
                            (lambda () (dk-ineq! (list 'IN (list '* n0 eps) 'RR) (list 'IN (list '* k1 eps) 'RR) (list 'IN (list '* dk_ k1) 'RR) (list 'IN (list '* eps k1) 'RR) (list 'IN (list '* k1 dk_) 'RR)
                                                 (list '<= 1 (list '* n0 eps)) (list '<= (list '* n0 eps) (list '* k1 eps)) (list '= (list '* k1 eps) (list '* eps k1))
                                                 (list '= (list '* k1 dk_) 1) (list '= (list '* k1 dk_) (list '* dk_ k1)))))
                          (dk-have! (list '< 0 k1) (lambda () (dk-nn! (list 'IN k 'NN))))
                          (dk-cite! 'rr-mul-le-cancel-pos dk_ k1 eps))
                        (let ((u (list '- gkx fxn)))
                          (b6s-real! u)
                          (dk-have! (list '<= (list '- eps) u) (lambda () (dk-ineq! (list 'IN gkx 'RR) (list 'IN fxn 'RR) (list 'IN dk_ 'RR) (list 'IN eps 'RR) (list '<= dk_ eps) (list '< (list '- dk_) (list '- fxn gkx)) (list '< (list '- fxn gkx) dk_))))
                          (dk-have! (list '<= u eps) (lambda () (dk-ineq! (list 'IN gkx 'RR) (list 'IN fxn 'RR) (list 'IN dk_ 'RR) (list 'IN eps 'RR) (list '<= dk_ eps) (list '< (list '- dk_) (list '- fxn gkx)) (list '< (list '- fxn gkx) dk_))))
                          (dk-cite! 'rr-abs-le-of-parts u eps)
                          (dk-ass!))))))))))
      (dk-cite! 'rr-converges-to-abs sqn fxn)
      (dk-ass!))))
(let ((ci (dk-cite! 'dual-ball-converges-iff 'm 'xs b6s-GSEL 'fo)))
  (dk-have! (cadr ci) (lambda () (if (dk-only! ci (caddr ci)) (prop)))))
;; eventually in a ball around fo inside uu: a contradiction
(let* ((cl (dk-project! (list 'FORALL 'y (list 'IMPLIES '(IN y uu) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL b6s-D 'y 'r) 'uu)))))
                        'is-open (list 'IS-OPEN b6s-D 'uu)))
       (r (dk-skolem! (dk-apply! cl 'fo) #t))
       (r2 (list '* 1/2 r)))
  (b6s-pos-parts! r)
  (b6s-real! r2)
  (dk-have! (list '< 0 r2) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
  (b6s-posrr! r2)
  (let* ((tl (dk-project! (b6s-clause b6s-D b6s-GSEL 'fo) 'converges-to (list 'CONVERGES-TO b6s-D b6s-GSEL 'fo)))
         (n1 (dk-skolem! (dk-apply! (dk-ctx-form (b6s-clause b6s-D b6s-GSEL 'fo)) r2) #t))
         (tcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n1) (dk-contains? h r2))) "the tail"))
         (g1 (list b6s-GSEL n1)))
    (dk-have! (list '<= n1 n1) (lambda () (dk-nn! (list 'IN n1 'NN))))
    (dk-apply! (dk-ctx-form tcl) n1)
    (b6s-gsat! n1)
    (dk-have! (list 'IN g1 (list 'PTS b6s-D)) (lambda () (subst (list '== (list 'PTS b6s-D) b6s-UB)) (dk-ass!)))
    (dk-have! (list 'IN 'fo (list 'PTS b6s-D)) (lambda () (subst (list '== (list 'PTS b6s-D) b6s-UB)) (dk-ass!)))
    (dk-apply! (dk-cite! 'metric-sym b6s-D) g1 'fo)
    (dk-apply! (dk-cite! 'metric-dist-real b6s-D) 'fo g1)
    (dk-have! (list '<= (list (list 'DIST b6s-D) 'fo g1) r2) (lambda () (subst (list '= (list (list 'DIST b6s-D) 'fo g1) (list (list 'DIST b6s-D) g1 'fo))) (dk-ass!)))
    (dk-have! (list '< r2 r) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
    (b6s-and! (list 'IN g1 (list 'PTS b6s-D)) (list 'IN r2 'RR) (list 'IN r 'RR) (list '<= (list (list 'DIST b6s-D) 'fo g1) r2) (list '< r2 r))
    (dk-apply! (dk-cite! 'ball-mem-from-le b6s-D) 'fo g1 r2 r)
    (dk-cite! 'subset-mem-fwd (list 'BALL b6s-D 'fo r) 'uu g1)
    (dk-have! (list 'NOT (list 'IN g1 'uu))
      (lambda () (subst (list '= g1 (list 'CHOICE (b6s-sel n1)))) (dk-ass!)))
    (ai (list 'NOT (list 'IN g1 'uu)))))
(b6s-qed! 'dual-ball-open-has-box)

