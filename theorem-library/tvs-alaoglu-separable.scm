              (dk-have! (list 'IN v (list 'OPENS b6s-TW0)) (lambda () (let ((i (dk-ctx-form (list 'IFF (list 'IN v (list 'OPENS b6s-TW0)) (list 'IS-OPEN Dm v))))) (if (dk-only! i (list 'IS-OPEN Dm v)) (prop)))))
              (dk-rewrite-h! (list 'IN v (list 'OPENS b6s-TW0)) b6s-TW0 b6s-TW)
              (dk-rewrite-h! (list 'IN v (list 'OPENS b6s-TW)) (list 'OPENS b6s-TW) so)
              (dk-ass!))))))
    (dk-cite! 'class-extensionality so sepU)
    (dk-have! (list '== b6s-TW0 lst)
      (lambda () (subst (list '== b6s-TW0 b6s-TW)) (subst (list '== b6s-TW (list 'LIST b6s-UB so))) (subst (list '= so sepU)) (qrfl)))
    (dk-have! (list '== b6s-TW0 (list 'LIST (list 'PTS Dm) sepD))
      (lambda () (subst (list '== (list 'PTS Dm) b6s-UB)) (dk-ass!)))
    (dk-have! (list '== b6s-TW0 (list 'METRIC-TOP Dm))
      (lambda () (mac 'METRIC-TOP) (dk-ass!)))
    (dk-have! (list 'IS-TOP-SPACE b6s-TW0) (lambda () (subst (list '== b6s-TW0 b6s-TW)) (dk-ass!)))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IS-METRIZABLE-TOP-SPACE)
            ;; W1F (2026-11-05): the law's existential is confined to SET and Dm is not known
