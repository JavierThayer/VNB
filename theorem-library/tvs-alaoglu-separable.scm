(dk-isx-set!)                ; W1J-A: the conjunct t in SET, from the typings
(dk-cite! 'pullback-pts 'mt 'ss 'jj)
(dk-cite! 'pullback-dist-slot 'mt 'ss 'jj)
(subst (list '== (list 'PTS b6s-PB) 'ss))
(subst (list '== (list 'DIST b6s-PB) b6s-dlam))
(b6s-and-split!
  (lambda ()
