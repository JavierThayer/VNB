(let* ((u (cadr (cadr (dk-goal)))))
  (dk-iff! (lambda (g) (dk-head-is? g 'IS-OPEN))
    (lambda ()
      ;; weak* open => d-open: the preimage under the continuous identity
      (let* ((pre (dk-project! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (list 'OPENS b6s-TW)) (list 'IN (list 'PREIMAGE b6s-TD b6s-ID 'w) (list 'OPENS b6s-TD))))
                               'is-hom-top-space-def (list 'IS-HOM-TOP-SPACE b6s-TD b6s-TW b6s-ID)))
             (pu (list 'PREIMAGE b6s-TD b6s-ID u))
