  (dk-cite! 'dual-unit-ball-unfold 'm)
  (if (not (dk-asm? (list 'SUBSET '(DUAL-VEC m) (list 'PTS b6s-PR))))
      (b6s-subset! '(DUAL-VEC m) (list 'PTS b6s-PR)
        (lambda (f) (dk-cite! 'dual-vec-fun 'm f) (dk-cite! 'fun-in-line-product '(VEC m) f) (subst (list '== (list 'PTS b6s-PR) b6s-PRP)) (dk-ass!))))
  (if (not (dk-asm? (list 'SUBSET b6s-UB '(DUAL-VEC m))))
