          (dk-have! (list 'IS-OPEN b6s-D pu) (lambda () (if (dk-only! oi (list 'IN pu (list 'OPENS b6s-TD))) (prop)))))
        (dk-have! (list 'FORALL 'b6z_ (list 'IFF (list 'IN 'b6z_ pu) (list 'IN 'b6z_ u)))
          (lambda ()
            (let* ((q (begin (di) (cadr (cadr (dk-goal)))))
                   (pm (dk-cite! 'preimage-membership b6s-TD b6s-ID u q))
                   (im (dk-cite! 'intersection-membership wu b6s-UB q)))
              (dk-iff! (lambda (g) (equal? g (list 'IN q u)))
                (lambda ()
                  (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN q pu)) (prop))))
                  (dk-split! (caddr pm))
                  (dk-rewrite-h! (list 'IN q (list 'PTS b6s-TD)) (list 'PTS b6s-TD) b6s-UB)
                  (dk-have! (list '= (list b6s-ID q) q) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                  (dk-rewrite-h! (list 'IN (list b6s-ID q) u) (list b6s-ID q) q)
                  (dk-ass!))
                (lambda ()
                  (dk-rewrite-h! (list 'IN q u) u (list 'INTERSECTION wu b6s-UB))
                  (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN q (list 'INTERSECTION wu b6s-UB))) (prop))))
                  (dk-split! (caddr im))
                  (dk-have! (list '= (list b6s-ID q) q) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                  (dk-have! (list 'IN q (list 'PTS b6s-TD)) (lambda () (subst (list '== (list 'PTS b6s-TD) b6s-UB)) (dk-ass!)))
                  (dk-have! (list 'IN (list b6s-ID q) u) (lambda () (subst (list '= (list b6s-ID q) q)) (dk-ass!)))
                  (b6s-and! (list 'IN q (list 'PTS b6s-TD)) (list 'IN (list b6s-ID q) u))
                  (if (dk-only! pm (caddr pm)) (prop)))))))
