;;; ===========================================================================
;;; (3) CONVERGENCE IN THE METRIC = CONVERGENCE AT EVERY x_n
;;; ===========================================================================
(define b6s-fs '(IN fs (FUN NN (DUAL-UNIT-BALL m))))
(define b6s-cjf (list 'COMPOSE b6s-DBJ 'fs))
(define (b6s-G n) (list 'VNB-LAMBDA 'k 'NN (list (list b6s-cjf 'k) n)))
(define (b6s-H n) (list 'VNB-LAMBDA 'k 'NN (list '(fs k) (list 'xs n))))
(define (b6s-fsk! k) (dk-cite! 'fun-apply-type-c 'fs 'NN b6s-UB k) (list 'IN (list 'fs k) b6s-UB))
(define (b6s-cjf-at! k)                ; ((COMPOSE DBJ fs) k) = DBJ(fs k)
  (b6s-fsk! k)
  (dk-cite! 'dbj-type 'm 'xs)
  (b6s-and! b6s-fs (list 'IN b6s-DBJ (list 'FUN b6s-UB b6s-PC)))
  (dk-apply! (dk-cite! 'compose-apply 'NN b6s-UB b6s-PC b6s-DBJ 'fs) k))
(sp (make-wff (b6s-alls '(m xs fs k n) (b6s-imps (list b6s-nvs b6s-xs b6s-fs '(IN k NN) '(IN n NN))
   (list '= (list (list b6s-cjf 'k) 'n) '((fs k) (xs n)))))))
(dk-peel!)
(fact 'nn-is-set)
(let ((e (b6s-cjf-at! 'k)))
  (b6s-fval! '(fs k) '(xs n))
  (dk-cite! 'dbj-value 'm 'xs '(fs k) 'n)
  (subst e)
  (subst (list '= (list (list b6s-DBJ '(fs k)) 'n) '((fs k) (xs n))))
  (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl))))
(b6s-qed! 'dbj-compose-value)
(sp (make-wff (b6s-alls '(m xs fs n) (b6s-imps (list b6s-nvs b6s-xs b6s-fs '(IN n NN)) (list '= (b6s-G 'n) (b6s-H 'n))))))
(dk-peel!)
(fact 'nn-is-set)
(define (b6s-gval! k)
  (b6s-fsk! k)
  (b6s-fval! (list 'fs k) '(xs n))
  (dk-cite! 'dbj-compose-value 'm 'xs 'fs k 'n))
(dk-have! (list 'IN (b6s-G 'n) '(FUN NN RR)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (subst (b6s-gval! k)) (dk-ass!))) (lambda () (dk-ass!)))))
(dk-have! (list 'IN (b6s-H 'n) '(FUN NN RR)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-fsk! k) (b6s-fval! (list 'fs k) '(xs n)) (dk-ass!))) (lambda () (dk-ass!)))))
(for-each (lambda (h) (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR h)))
                        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN h '(FUN NN RR))) (prop))))
                        (dk-split! (caddr fi))))
          (list (b6s-G 'n) (b6s-H 'n)))
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list '= (list (b6s-G 'n) 'x) (list (b6s-H 'n) 'x))))
  (lambda () (let ((k (dk-di-var!))) (b6s-gval! k) (b6s-fsk! k) (b6s-fval! (list 'fs k) '(xs n)) (dk-lam-b!)
               (if (not (proof-done? *ps*)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!))))))
(dk-cite! 'fun-domain-extensionality 'NN (b6s-G 'n) (b6s-H 'n))
(dk-ass!)
(b6s-qed! 'dbj-coord-seq)

;; one coordinate: convergence in the interval of the J-images = convergence of the values in R
(sp (make-wff (b6s-alls '(m xs fs f n) (b6s-imps (list b6s-nvs b6s-xs b6s-fs (list 'IN 'f b6s-UB) '(IN n NN))
   (list 'IFF (list 'CONVERGES-TO (list b6s-DBI 'n) (b6s-G 'n) (list (list b6s-DBJ 'f) 'n)) (list 'CONVERGES-TO 'RR-MS (b6s-H 'n) '(f (xs n))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(let ((iv (b6s-iv-facts! 'n)))
  (b6s-sub-ms! 'n)
  (dk-cite! 'dbj-coord-seq 'm 'xs 'fs 'n)
  (dk-cite! 'dbj-value 'm 'xs 'f 'n)
  (b6s-coord! 'f 'n)
  (dk-have! (list 'IN (b6s-H 'n) (list 'FUN 'NN iv))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-fsk! k) (b6s-coord-iv! (list 'fs k) 'n) (dk-ass!))) (lambda () (dk-ass!)))))
  (dk-cite! 'subspace-converges-to 'RR-MS iv (b6s-H 'n) '(f (xs n)))
  (subst (list '== (list b6s-DBI 'n) (list 'SUBSPACE-MS 'RR-MS iv)))
  (subst (list '= (b6s-G 'n) (b6s-H 'n)))
  (subst (list '= (list (list b6s-DBJ 'f) 'n) '(f (xs n))))
  (dk-ass!))
(b6s-qed! 'dbj-coord-converges)

(define (b6s-cv-all f) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'CONVERGES-TO 'RR-MS (b6s-H 'n) (list f '(xs n))))))
(sp (make-wff (b6s-alls '(m xs fs f) (b6s-imps (list b6s-nvs b6s-xs b6s-dense b6s-fs (list 'IN 'f b6s-UB))
   (list 'IFF (list 'CONVERGES-TO b6s-D 'fs 'f) (b6s-cv-all 'f))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-split! (dk-cite! 'dbi-product-facts 'm 'xs))
(dk-split! (dk-cite! 'dbi-seq-compact 'm 'xs))
(dk-cite! 'dual-unit-ball-in-set 'm)
(dk-cite! 'dbj-type 'm 'xs)
(dk-have! (list 'IN b6s-DBJ (list 'FUN b6s-UB (list 'PTS b6s-PM))) (lambda () (subst (list '== (list 'PTS b6s-PM) b6s-PC)) (dk-ass!)))
(dk-cite! 'dbj-injective 'm 'xs)
(let* ((i1 (dk-cite! 'pullback-converges-to b6s-PM b6s-UB b6s-DBJ 'fs 'f))
       (pmw (list 'PRODUCT-METRIC-W b6s-DBI b6s-W0)))
  (dk-cite! 'product-metric-unfold b6s-DBI)
  (fact 'product-metric-default-summable)
  (b6s-and! b6s-fs (list 'IN b6s-DBJ (list 'FUN b6s-UB b6s-PC)))
  (dk-cite! 'compose-type 'NN b6s-UB b6s-PC b6s-DBJ 'fs)
  (b6s-jf-pc! 'f)
  (let* ((i2a (dk-apply! (dk-cite! 'product-convergence-coordinatewise b6s-DBI) b6s-W0 b6s-cjf (b6s-jf 'f)))
         (i2 (dk-rewrite-h! i2a pmw b6s-PM))
         (cl (caddr i2)))
    (subst (list '== b6s-D (list 'PULLBACK-MS b6s-PM b6s-UB b6s-DBJ)))
    (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
      (lambda ()
        (dk-have! (caddr i1) (lambda () (if (dk-only! i1 (cadr i1)) (prop))))
        (dk-have! cl (lambda () (if (dk-only! i2 (cadr i2)) (prop))))
        (let ((n (dk-di-var!)))
          (dk-apply! (dk-ctx-form cl) n)
          (let ((ci (dk-cite! 'dbj-coord-converges 'm 'xs 'fs 'f n)))
            (if (dk-only! ci (cadr ci)) (prop)))))
      (lambda ()
        (dk-have! cl
          (lambda () (let ((n (dk-di-var!)))
                       (dk-apply! (dk-ctx-form (b6s-cv-all 'f)) n)
                       (let ((ci (dk-cite! 'dbj-coord-converges 'm 'xs 'fs 'f n)))
                         (if (dk-only! ci (caddr ci)) (prop))))))
        (dk-have! (cadr i2) (lambda () (if (dk-only! i2 cl) (prop))))
        (if (dk-only! i1 (caddr i1)) (prop))))))
(b6s-qed! 'dual-ball-converges-iff)

;;; ===========================================================================
;;; (4) A POINTWISE LIMIT OF FUNCTIONALS OF THE UNIT BALL IS IN THE UNIT BALL (linear, norm <= 1)
;;; ===========================================================================
(define b6s-gs '(IN gs (FUN NN (DUAL-UNIT-BALL m))))
(define (b6s-sq z) (list 'VNB-LAMBDA 'k 'NN (list '(gs k) z)))
(define (b6s-lset z) (list 'SEP 'b6l_ 'RR (list 'CONVERGES-TO 'RR-MS (b6s-sq z) 'b6l_)))
(define b6s-F (list 'VNB-LAMBDA 'b6w_ '(VEC m) (list 'CHOICE (b6s-lset 'b6w_))))
(define b6s-haslim '(FORALL b6z_ (IMPLIES (IN b6z_ (VEC m)) (FORSOME b6l_ (CONVERGES-TO RR-MS (VNB-LAMBDA k NN ((gs k) b6z_)) b6l_)))))
(define (b6s-cvF f) (list 'FORALL 'b6z_ (list 'IMPLIES '(IN b6z_ (VEC m)) (list 'CONVERGES-TO 'RR-MS (b6s-sq 'b6z_) (list f 'b6z_)))))
(define (b6s-gsk! k) (dk-cite! 'fun-apply-type-c 'gs 'NN b6s-UB k) (b6s-ub! (list 'gs k)) (list 'IN (list 'gs k) b6s-UB))
(define (b6s-sq-type! z)               ; (IN (sq z) (FUN NN RR))
  (let ((g (list 'IN (b6s-sq z) '(FUN NN RR))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-gsk! k) (b6s-fval! (list 'gs k) z) (dk-ass!))) (lambda () (dk-ass!))))))
    g))
(define (b6s-sq-at! z j)               ; ((sq z) j) = ((gs j) z)
  (b6s-gsk! j) (b6s-fval! (list 'gs j) z)
  (let ((e (list '= (list (b6s-sq z) j) (list (list 'gs j) z))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(define (b6s-lim! z)                   ; z in VEC m: c = CHOICE(lset z) in RR, converges-to(sq z, c); (= (F z) c); returns c
  (let* ((ls (b6s-lset z)) (c (list 'CHOICE ls)))
    (if (not (dk-asm? (list 'IN c ls)))
        (let* ((ex (dk-apply! (dk-ctx-form b6s-haslim) z))
               (l0 (dk-skolem! ex #t)))
          (dk-project! (list 'IN l0 '(PTS RR-MS)) 'converges-to (list 'CONVERGES-TO 'RR-MS (b6s-sq z) l0))
          (dk-rewrite-h! (list 'IN l0 '(PTS RR-MS)) '(PTS RR-MS) 'RR)
          (choose-mem! ls l0 (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (if (not (dk-asm? (list 'IN c 'RR)))
        (begin (sep-me (dk-ctx-form (list 'IN c ls))) (dk-split-all!)))
    (let ((e (list '= (list b6s-F z) c)))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
    c))
(sp (make-wff (b6s-alls '(m gs) (b6s-imps (list b6s-nvs b6s-gs b6s-haslim)
   (list 'FORSOME 'b6f_ (list 'AND (list 'IN 'b6f_ b6s-UB) (b6s-cvF 'b6f_)))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(dk-project! '(IN (VEC m) SET) 'is-normed-vector-space b6s-nvs)
(dk-have! (list 'IN b6s-F '(FUN (VEC m) RR))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (b6s-lim! z) (dk-ass!))) (lambda () (dk-ass!)))))
(define (b6s-Fv! z) (b6s-lim! z) (dk-cite! 'fun-apply-type-c b6s-F '(VEC m) 'RR z) (list b6s-F z))
;; additivity
(dk-have! (b6s-fadd b6s-F)
  (lambda ()
    (di)
    (let* ((g (dk-goal)) (xy (cadr (cadr g))) (x (cadr xy)) (y (caddr xy)))
      (b6s-vec! xy)
      (let ((cx (b6s-lim! x)) (cy (b6s-lim! y)) (cxy (b6s-lim! xy)))
        (for-each b6s-sq-type! (list x y xy))
        (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list (b6s-sq xy) 'j_) (list '+ (list (b6s-sq x) 'j_) (list (b6s-sq y) 'j_)))))
          (lambda () (let ((j (dk-di-var!)))
                       (subst (b6s-sq-at! xy j)) (subst (b6s-sq-at! x j)) (subst (b6s-sq-at! y j))
                       (dk-apply! (dk-ctx-form (b6s-fadd (list 'gs j))) x y)
                       (dk-ass!))))
        (dk-cite! 'rr-limit-add (b6s-sq x) (b6s-sq y) (b6s-sq xy) cx cy)
        (b6s-real! (list '+ cx cy))
        (dk-cite! 'rr-limit-unique (b6s-sq xy) cxy (list '+ cx cy))
        (subst (list '= (list b6s-F xy) cxy)) (subst (list '= (list b6s-F x) cx)) (subst (list '= (list b6s-F y) cy))
        (dk-ass!)))))
;; homogeneity
(dk-have! (b6s-fhom b6s-F)
  (lambda ()
    (di)
    (let* ((g (dk-goal)) (rx (cadr (cadr g))) (r (cadr rx)) (x (caddr rx)))
      (b6s-vec! rx)
      (let ((cx (b6s-lim! x)) (crx (b6s-lim! rx)))
        (for-each b6s-sq-type! (list x rx))
        (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list (b6s-sq rx) 'j_) (list '* (list (b6s-sq x) 'j_) r))))
          (lambda () (let ((j (dk-di-var!)))
                       (subst (b6s-sq-at! rx j)) (subst (b6s-sq-at! x j))
                       (dk-apply! (dk-ctx-form (b6s-fhom (list 'gs j))) r x)
                       (subst (list '= (list (list 'gs j) rx) (list '* r (list (list 'gs j) x))))
                       (crs))))
        (dk-cite! 'rr-limit-scale r (b6s-sq x) (b6s-sq rx) cx)
        (b6s-real! (list '* cx r))
        (dk-cite! 'rr-limit-unique (b6s-sq rx) crx (list '* cx r))
        (subst (list '= (list b6s-F rx) crx)) (subst (list '= (list b6s-F x) cx))
        (subst (list '= crx (list '* cx r)))
        (crs)))))
(dk-have! (list 'IS-LINEAR-FUNCTIONAL 'm b6s-F) (lambda () (mac 'is-linear-functional) (dk-conj-close! (lambda () (dk-ass!)))))
;; the bound
(dk-have! (b6s-nbd b6s-F)
  (lambda ()
    (let* ((x (dk-di-var!)) (cx (b6s-lim! x)) (nx (list '(VNRM m) x)))
      (b6s-norm! x)
      (b6s-sq-type! x)
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '<= (list 'abs (list (b6s-sq x) 'n_)) nx)))
        (lambda () (let ((j (dk-di-var!)))
                     (subst (b6s-sq-at! x j))
                     (dk-apply! (dk-ctx-form (b6s-nbd (list 'gs j))) x)
                     (dk-ass!))))
      (dk-cite! 'rr-limit-abs-le (b6s-sq x) cx nx)
      (subst (list '= (list b6s-F x) cx))
      (dk-ass!))))
(let ((um (dk-cite! 'dual-unit-ball-mem 'm b6s-F)))
  (b6s-and! (list 'IS-LINEAR-FUNCTIONAL 'm b6s-F) (b6s-nbd b6s-F))
  (b6s-and! (list 'IN b6s-F '(FUN (VEC m) RR)) (list 'AND (list 'IS-LINEAR-FUNCTIONAL 'm b6s-F) (b6s-nbd b6s-F)))
  (dk-have! (list 'IN b6s-F b6s-UB) (lambda () (if (dk-only! um (caddr um)) (prop)))))
(dk-have! (b6s-cvF b6s-F)
  (lambda () (let* ((z (dk-di-var!)) (c (b6s-lim! z))) (subst (list '= (list b6s-F z) c)) (dk-ass!))))
(ew b6s-F)
(dk-conj-close! (lambda () (dk-ass!)))
(b6s-qed! 'dual-ball-pointwise-limit)

;;; ===========================================================================
;;; (5) CONVERGENCE AT EVERY x_n GIVES CONVERGENCE AT EVERY z (density: the sequence at z is Cauchy)
;;; ===========================================================================
(define (b6s-Hg n) (list 'VNB-LAMBDA 'k 'NN (list '(gs k) (list 'xs n))))
(define b6s-haslim-n '(FORALL b6n_ (IMPLIES (IN b6n_ NN) (FORSOME b6l_ (CONVERGES-TO RR-MS (VNB-LAMBDA k NN ((gs k) (xs b6n_))) b6l_)))))
(define (b6s-pos-parts! e)             ; (POS-RR e): (IN e RR), (< 0 e)
  (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(sp (make-wff (b6s-alls '(m xs gs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense b6s-gs b6s-haslim-n) b6s-haslim))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(let* ((z (cadr (cadddr (caddr (caddr (dk-goal)))))) (sz (b6s-sq z)))
  (b6s-sq-type! z)
  (let* ((imp (dk-cite! 'rr-cauchy-converges sz)) (cau (cadr imp)))
    (dk-have! cau
      (lambda ()
        (let* ((ld (dk-peel!))
               (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld)))
               (e4 (list '* 1/4 eps)))
          (b6s-pos-parts! eps)
          (b6s-real! e4)
          (dk-have! (list '< 0 e4) (lambda () (dk-ineq! (list 'IN eps 'RR) (list '< 0 eps))))
          (b6s-posrr! e4)
          (let* ((n (dk-skolem! (dk-apply! (dk-ctx-form b6s-dense) z e4) #t))
                 (xn (list 'xs n)) (dv (list '(VADD m) z (list '(VNEG m) xn))) (nv (list '(VNRM m) dv))
                 (hg (b6s-Hg n))
                 (L (dk-skolem! (dk-apply! (dk-ctx-form b6s-haslim-n) n) #t))
                 (cv (list 'CONVERGES-TO 'RR-MS hg L)))
            (b6s-norm! dv)
            (dk-project! (list 'IN L '(PTS RR-MS)) 'converges-to cv)
            (dk-rewrite-h! (list 'IN L '(PTS RR-MS)) '(PTS RR-MS) 'RR)
            (let* ((tl (dk-project! (b6s-clause 'RR-MS hg L) 'converges-to cv))
                   (nb (dk-skolem! (dk-apply! (dk-ctx-form (b6s-clause 'RR-MS hg L)) e4) #t))
                   (tcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h e4))) "the tail clause")))
              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((g (begin (dk-peel!) (dk-goal)))
                             (a (cadr (cadr g))) (j (cadr (cadr a))) (p (cadr (caddr a))))
                        (subst (b6s-sq-at! z j)) (subst (b6s-sq-at! z p))
                        (let ((pieces
                               (apply append
                                 (map (lambda (q)
                                        (let* ((gq (list 'gs q)) (gqx (list gq xn)) (gqz (list gq z)))
                                          (b6s-gsk! q) (b6s-fval! gq xn) (b6s-fval! gq z)
                                          (dk-apply! (dk-ctx-form tcl) q)
                                          (let ((hv (list '= (list hg q) gqx)))
                                            (dk-have! hv (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                                          (dk-have! (list 'IN (list hg q) 'RR) (lambda () (subst (list '= (list hg q) gqx)) (dk-ass!)))
                                          (dk-cite! 'rr-ms-dist (list hg q) L)
                                          (dk-have! (list '<= (list 'abs (list '- gqx L)) e4)
                                            (lambda () (subst (list '= gqx (list hg q)))
                                                       (subst (list '= (list 'abs (list '- (list hg q) L)) (list '(DIST RR-MS) (list hg q) L)))
                                                       (dk-ass!)))
                                          (b6s-abs-out! (list '- gqx L) e4)
                                          (dk-cite! 'dual-ball-lipschitz 'm gq z xn)
                                          (b6s-abs-out! (list '- gqz gqx) nv)
                                          (list (list 'IN gqx 'RR) (list 'IN gqz 'RR)
                                                (list '<= (list '- e4) (list '- gqx L)) (list '<= (list '- gqx L) e4)
                                                (list '<= (list '- nv) (list '- gqz gqx)) (list '<= (list '- gqz gqx) nv))))
                                      (list j p)))))
                          (let* ((u (list '- (list (list 'gs j) z) (list (list 'gs p) z)))
                                 (prems (append pieces (list (list 'IN L 'RR) (list 'IN nv 'RR) (list 'IN eps 'RR) (list '< nv e4)))))
                            (b6s-real! u)
                            (dk-have! (list '<= (list '- eps) u) (lambda () (apply dk-ineq! prems)))
                            (dk-have! (list '<= u eps) (lambda () (apply dk-ineq! prems)))
                            (dk-cite! 'rr-abs-le-of-parts u eps)
                            (dk-ass!))))))))))))
    (let ((cvg (caddr imp)))
      (dk-have! cvg (lambda () (if (dk-only! imp cau) (prop))))
      (let ((ex (dk-project! (list 'FORSOME 'l (list 'CONVERGES-TO 'RR-MS sz 'l)) 'converges cvg)))
        (dk-ass!)))))
(b6s-qed! 'dual-ball-limits-everywhere)

;;; ===========================================================================
;;; (6) SEQUENTIAL COMPACTNESS (the diagonal argument) AND COMPACTNESS
;;; ===========================================================================
(define b6s-seq (list 'COMPOSE b6s-DBJ 'fs))
(define b6s-gsd '(SUBSEQ fs delta))
(define (b6s-Gd n) (list 'VNB-LAMBDA 'k 'NN (list (list (list 'SUBSEQ b6s-seq 'delta) 'k) n)))
(define (b6s-Hd n) (list 'VNB-LAMBDA 'k 'NN (list (list b6s-gsd 'k) (list 'xs n))))
(sp (make-wff (b6s-alls '(m xs fs delta k n) (b6s-imps (list b6s-nvs b6s-xs b6s-fs '(IN delta (FUN NN NN)) '(IN k NN) '(IN n NN))
   (list '= (list (list (list 'SUBSEQ b6s-seq 'delta) 'k) 'n) (list (list b6s-gsd 'k) '(xs n)))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'fun-apply-type-c 'delta 'NN 'NN 'k)
(let ((dk '(delta k)))
  (dk-cite! 'subseq-apply b6s-seq 'delta 'k)
  (dk-cite! 'subseq-apply 'fs 'delta 'k)
  (dk-cite! 'dbj-compose-value 'm 'xs 'fs dk 'n)
  (subst (list '= (list (list 'SUBSEQ b6s-seq 'delta) 'k) (list b6s-seq dk)))
  (subst (list '= (list b6s-gsd 'k) (list 'fs dk)))
  (if (not (proof-done? *ps*)) (dk-ass!)))
(b6s-qed! 'dbj-diagonal-value)

(sp (make-wff (b6s-alls '(m xs gs k n) (b6s-imps (list b6s-nvs b6s-xs b6s-gs '(IN k NN) '(IN n NN))
   (list 'AND (list 'IN '((gs k) (xs n)) (b6s-iv 'n)) '(IN ((gs k) (xs n)) RR))))))
(dk-peel!)
(b6s-gsk! 'k)
(b6s-coord-iv! '(gs k) 'n)
(b6s-fval! '(gs k) '(xs n))
(dk-conj-close! (lambda () (dk-ass!)))
(b6s-qed! 'dual-ball-seq-coord)
(define b6s-subcv (list 'FORSOME 'phi (list 'AND '(STRICTLY-MONO-NN phi) (list 'FORSOME 'l (list 'AND (list 'IN 'l b6s-UB) (list 'CONVERGES-TO b6s-D '(SUBSEQ fs phi) 'l))))))
(sp (make-wff (b6s-alls '(m xs fs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense b6s-fs) b6s-subcv))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-split! (dk-cite! 'dbi-seq-compact 'm 'xs))
(dk-cite! 'dbj-type 'm 'xs)
(b6s-and! b6s-fs (list 'IN b6s-DBJ (list 'FUN b6s-UB b6s-PC)))
(dk-cite! 'compose-type 'NN b6s-UB b6s-PC b6s-DBJ 'fs)
(let* ((ex (dk-apply! (dk-cite! 'coordinatewise-diagonal-subseq b6s-DBI) b6s-seq))
       (dl (dk-skolem! ex #t))
       (D! (lambda (t) (b6s-tree-sub 'delta dl t)))
       (gsd (D! b6s-gsd))
       (Gd (lambda (n) (D! (b6s-Gd n))))
       (Hd (lambda (n) (D! (b6s-Hd n))))
       (l (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h dl))) "the diagonal limit") #t))
       (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h l) (dk-contains? h 'SUBSEQ))) "the coordinate clause")))
  (dk-project! (list 'IN dl '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN dl))
  (dk-apply! (dk-cite! 'subseq-fun-typing 'fs b6s-UB) dl)
  (let ((pcm (dk-cite! 'product-carrier-mem b6s-DBI l)))
    (dk-have! (caddr pcm) (lambda () (if (dk-only! pcm (list 'IN l b6s-PC)) (prop))))
    (dk-split! (caddr pcm)))
  ;; at every x_n the subsequence converges (to l(n))
  (dk-have! (b6s-tree-sub 'gs gsd b6s-haslim-n)
    (lambda ()
      (let* ((n (dk-di-var!)) (iv (b6s-iv-facts! n)) (ln (list l n))
             (val! (lambda (k) (let ((c (dk-cite! 'dual-ball-seq-coord 'm 'xs gsd k n))) (if (not (and (dk-asm? (cadr c)) (dk-asm? (caddr c)))) (dk-split! c)))
                               (dk-cite! 'dbj-diagonal-value 'm 'xs 'fs dl k n))))
        (b6s-sub-ms! n)
        (dk-apply! cl n)
        (dk-apply! (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN (list l 'n) (list 'PTS (list b6s-DBI 'n)))))) n)
        (dk-rewrite-h! (list 'IN ln (list 'PTS (list b6s-DBI n))) (list 'PTS (list b6s-DBI n)) iv)
        (dk-rewrite-h! (list 'CONVERGES-TO (list b6s-DBI n) (Gd n) ln) (list b6s-DBI n) (list 'SUBSPACE-MS 'RR-MS iv))
        (dk-have! (list 'IN (Gd n) (list 'FUN 'NN iv))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (subst (val! k)) (dk-ass!))) (lambda () (dk-ass!)))))
        (let ((sc (dk-cite! 'subspace-converges-to 'RR-MS iv (Gd n) ln)))
          (dk-have! (caddr sc) (lambda () (if (dk-only! sc (cadr sc)) (prop)))))
        (fact 'rr-is-set)
        (dk-cite! 'ccint-subset-rr (list '- (b6s-r n)) (b6s-r n))
        (dk-cite! 'subset-mem-fwd iv 'RR ln)
        (dk-have! (list 'IN (Gd n) '(FUN NN RR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (subst (val! k)) (dk-ass!))) (lambda () (dk-ass!)))))
        (dk-have! (list 'IN (Hd n) '(FUN NN RR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (val! k) (dk-ass!))) (lambda () (dk-ass!)))))
        (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list (Hd n) 'j_) (list (Gd n) 'j_))))
          (lambda () (let ((k (dk-di-var!)))
                       (val! k)
                       (dk-lam-b!)
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (if (not (dk-ass!)) (begin (subst (val! k)) (rfl)))))))
        (dk-cite! 'rr-limit-ptwise-eq (Gd n) (Hd n) ln)
        (ew ln)
        (dk-ass!))))
  (dk-cite! 'dual-ball-limits-everywhere 'm 'xs gsd)
  (let* ((f (dk-skolem! (dk-cite! 'dual-ball-pointwise-limit 'm gsd) #t)))
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'CONVERGES-TO 'RR-MS (Hd 'n) (list f '(xs n)))))
      (lambda () (let ((n (dk-di-var!)))
                   (dk-cite! 'fun-apply-type-c 'xs 'NN '(VEC m) n)
                   (dk-apply! (dk-ctx-form (b6s-tree-sub 'gs gsd (b6s-cvF f))) (list 'xs n))
                   (dk-ass!))))
    (let ((ci (dk-cite! 'dual-ball-converges-iff 'm 'xs gsd f)))
      (dk-have! (cadr ci) (lambda () (if (dk-only! ci (caddr ci)) (prop)))))
    (ew dl)
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew f) (dk-conj-close! (lambda () (dk-ass!)))))))))
(b6s-qed! 'dual-ball-subseq-converges)

(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense) (list 'SEQ-COMPACT b6s-D)))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(mac 'seq-compact)
(subst (list '== (list 'PTS b6s-D) b6s-UB))
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let ((f (dk-di-var!)))
          (dk-cite! 'dual-ball-subseq-converges 'm 'xs f)
          (dk-ass!)))))
(b6s-qed! 'dual-ball-seq-compact)

(sp (make-wff (b6s-alls '(m xs) (b6s-imps (list b6s-nvs b6s-xs b6s-dense) (list 'IS-COMPACT b6s-D)))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-cite! 'dual-ball-seq-compact 'm 'xs)
(let ((ci (dk-cite! 'compact-iff-seq-compact b6s-D)))
  (if (dk-only! ci (list 'SEQ-COMPACT b6s-D)) (prop)))
(b6s-qed! 'dual-ball-compact)

;;; ===========================================================================
;;; (7) THE METRIC TOPOLOGY IS FINER THAN WEAK*: every evaluation f |-> f(z) is d-continuous
;;; ===========================================================================
;; d-convergence gives convergence at every point z (density, epsilon/3)
(define (b6s-sqf z) (list 'VNB-LAMBDA 'k 'NN (list '(fs k) z)))
(sp (make-wff (b6s-alls '(m xs fs f z) (b6s-imps (list b6s-nvs b6s-xs b6s-dense b6s-fs (list 'IN 'f b6s-UB) (list 'CONVERGES-TO b6s-D 'fs 'f) '(IN z (VEC m)))
   (list 'CONVERGES-TO 'RR-MS (b6s-sqf 'z) '(f z))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(let ((ci (dk-cite! 'dual-ball-converges-iff 'm 'xs 'fs 'f)))
  (dk-have! (caddr ci) (lambda () (if (dk-only! ci (cadr ci)) (prop)))))
(b6s-fval! 'f 'z)
(dk-have! (list 'IN (b6s-sqf 'z) '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b6s-fsk! k) (b6s-fval! (list 'fs k) 'z) (dk-ass!))) (lambda () (dk-ass!)))))
(let ((goal (dk-goal)))
  (dk-have! (cadr (dk-cite! 'rr-converges-to-abs (b6s-sqf 'z) '(f z)))
    (lambda ()
      (let* ((ld (dk-peel!))
             (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld)))
             (e3 (list '* 1/3 eps)))
        (b6s-pos-parts! eps)
        (b6s-real! e3)
        (dk-have! (list '< 0 e3) (lambda () (dk-ineq! (list 'IN eps 'RR) (list '< 0 eps))))
        (b6s-posrr! e3)
        (let* ((n (dk-skolem! (dk-apply! (dk-ctx-form b6s-dense) 'z e3) #t))
               (xn (list 'xs n)) (dv (list '(VADD m) 'z (list '(VNEG m) xn))) (nv (list '(VNRM m) dv))
               (hn (b6s-H n)) (fxn (list 'f xn))
               (cv (list 'CONVERGES-TO 'RR-MS hn fxn)))
          (b6s-norm! dv)
          (b6s-fval! 'f xn)
          (dk-apply! (dk-ctx-form (b6s-cv-all 'f)) n)
          (let* ((nb (dk-skolem! (dk-apply! (dk-project! (b6s-clause 'RR-MS hn fxn) 'converges-to cv) e3) #t))
                 (tcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h e3))) "the tail clause")))
            (dk-cite! 'dual-ball-lipschitz 'm 'f 'z xn)
            (b6s-abs-out! (list '- '(f z) fxn) nv)
            (ew nb)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((g (begin (dk-peel!) (dk-goal))) (j (cadr (cadr (cadr (cadr g)))))
                           (fj (list 'fs j)) (fjx (list fj xn)) (fjz (list fj 'z)))
                      (b6s-fsk! j) (b6s-fval! fj xn) (b6s-fval! fj 'z)
                      (let ((sv (list '= (list (b6s-sqf 'z) j) fjz)))
                        (dk-have! sv (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                        (subst sv))
                      (dk-apply! (dk-ctx-form tcl) j)
                      (let ((hv (list '= (list hn j) fjx)))
                        (dk-have! hv (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                        (dk-have! (list 'IN (list hn j) 'RR) (lambda () (subst hv) (dk-ass!))))
                      (dk-cite! 'rr-ms-dist (list hn j) fxn)
                      (dk-have! (list '<= (list 'abs (list '- fjx fxn)) e3)
                        (lambda () (subst (list '= fjx (list hn j)))
                                   (subst (list '= (list 'abs (list '- (list hn j) fxn)) (list '(DIST RR-MS) (list hn j) fxn)))
                                   (dk-ass!)))
                      (b6s-abs-out! (list '- fjx fxn) e3)
                      (dk-cite! 'dual-ball-lipschitz 'm fj 'z xn)
                      (b6s-abs-out! (list '- fjz fjx) nv)
                      (let* ((u (list '- fjz '(f z)))
                             (prems (list (list 'IN fjz 'RR) (list 'IN fjx 'RR) (list 'IN fxn 'RR) '(IN (f z) RR) (list 'IN nv 'RR) (list 'IN eps 'RR)
                                          (list '< nv e3)
                                          (list '<= (list '- e3) (list '- fjx fxn)) (list '<= (list '- fjx fxn) e3)
                                          (list '<= (list '- nv) (list '- fjz fjx)) (list '<= (list '- fjz fjx) nv)
                                          (list '<= (list '- nv) (list '- '(f z) fxn)) (list '<= (list '- '(f z) fxn) nv))))
                        (b6s-real! u)
                        (dk-have! (list '<= (list '- eps) u) (lambda () (apply dk-ineq! prems)))
                        (dk-have! (list '<= u eps) (lambda () (apply dk-ineq! prems)))
                        (dk-cite! 'rr-abs-le-of-parts u eps)
                        (dk-ass!)))))))))))
  (dk-cite! 'rr-converges-to-abs (b6s-sqf 'z) '(f z))
  (dk-ass!))
(b6s-qed! 'dual-ball-converges-pointwise)

(define (b6s-EV z) (list 'VNB-LAMBDA 'b6e_ b6s-UB (list 'b6e_ z)))
(sp (make-wff (b6s-alls '(sa) (list '== '(SQN sa) '(FUN NN sa)))))
(dk-peel!) (mac 'SQN) (qrfl)
(b6s-qed! 'sqn-unfold-b6s)
(sp (make-wff (b6s-alls '(m xs z) (b6s-imps (list b6s-nvs b6s-xs b6s-dense '(IN z (VEC m))) (list 'IS-CONTINUOUS b6s-D 'RR-MS (b6s-EV 'z))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(dk-split-all! (list (dk-cite! 'dual-ball-ms-facts 'm 'xs)))
(dk-cite! 'dual-unit-ball-in-set 'm)
(let* ((ev (b6s-EV 'z)) (pd (list 'PTS b6s-D)))
  (dk-have! (list 'IN ev (list 'FUN b6s-UB 'RR))
    (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (b6s-fval! q 'z) (dk-ass!))) (lambda () (dk-ass!)))))
  (dk-have! (list 'IN ev (list 'FUN pd '(PTS RR-MS)))
    (lambda () (subst (list '== pd b6s-UB)) (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
  (mac 'is-continuous)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((a (dk-di-var!)))
            (dk-rewrite-h! (list 'IN a pd) pd b6s-UB)
            (dk-have! (list 'IN a pd) (lambda () (subst (list '== pd b6s-UB)) (dk-ass!)))
            (dk-have! (list 'FORALL 'sq (list 'IMPLIES (list 'IN 'sq (list 'SQN pd))
                        (list 'IMPLIES (list 'CONVERGES-TO b6s-D 'sq a) (list 'CONVERGES-TO 'RR-MS (list 'COMPOSE ev 'sq) (list ev a)))))
              (lambda ()
                (let* ((sq (dk-di-var!)) (sqf (b6s-tree-sub 'fs sq (b6s-sqf 'z))) (cmp (list 'COMPOSE ev sq)))
                  (di)
                  (dk-cite! 'sqn-unfold-b6s pd)
                  (let* ((h1 (dk-rewrite-h! (list 'IN sq (list 'SQN pd)) (list 'SQN pd) (list 'FUN 'NN pd))))
                    (dk-rewrite-h! h1 pd b6s-UB))
                  (dk-cite! 'dual-ball-converges-pointwise 'm 'xs sq a 'z)
                  (b6s-fval! a 'z)
                  (dk-have! (list '= (list ev a) (list a 'z)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                  (subst (list '= (list ev a) (list a 'z)))
                  (b6s-and! (list 'IN sq (list 'FUN 'NN b6s-UB)) (list 'IN ev (list 'FUN b6s-UB 'RR)))
                  (dk-cite! 'compose-type 'NN b6s-UB 'RR ev sq)
                  (let ((ca (dk-cite! 'compose-apply 'NN b6s-UB 'RR ev sq)))
                    (dk-have! (list 'IN sqf '(FUN NN RR))
                      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-cite! 'fun-apply-type-c sq 'NN b6s-UB k) (b6s-fval! (list sq k) 'z) (dk-ass!))) (lambda () (dk-ass!)))))
                    (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list cmp 'j_) (list sqf 'j_))))
                      (lambda () (let ((j (dk-di-var!)))
                                   (dk-cite! 'fun-apply-type-c sq 'NN b6s-UB j)
                                   (b6s-fval! (list sq j) 'z)
                                   (dk-apply! ca j)
                                   (subst (list '= (list cmp j) (list ev (list sq j))))
                                   (dk-lam-b!)
                                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                    (dk-cite! 'rr-limit-ptwise-eq sqf cmp (list a 'z))
                    (dk-ass!)))))
            (dk-cite! 'sequential-implies-continuous-at b6s-D 'RR-MS ev a)
            (dk-ass!))))))
(b6s-qed! 'dual-ball-evaluation-continuous)

;;; ---- subspace helpers (copies of tb6.scm's, prefix b6s-) ----
(define (b6s-subset! x y memb!)
  (dk-have! (list 'SUBSET x y) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (memb! w)))))
(define (b6s-top! s)
  (if (not (dk-asm? (list 'IN (list 'PTS s) 'SET)))
      (begin
        (dk-project! (list 'IN (list 'PTS s) (list 'OPENS s)) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-project! (list 'IN (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s)))) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-cite! 'membership-implies-sethood (list 'PTS s) (list 'OPENS s))
        (dk-cite! 'membership-implies-sethood (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s)))))))
(define (b6s-sub t a) (list 'SUBSPACE-TOP t a))
(define (b6s-subopens t a) (list 'SEP 'stw_ (list 'POWER a) (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS t)) (list '= 'stw_ (list 'INTERSECTION 'stu_ a))))))
(define (b6s-sub-facts! t a)
  (b6s-top! t)
  (dk-cite! 'subclass-of-set-is-set a (list 'PTS t))
  (dk-cite! 'subspace-top-is-top-space t a)
  (dk-cite! 'subspace-top-pts t a)
  (dk-cite! 'subspace-top-opens t a)
  (dk-cite! 'power-set a))
(define (b6s-inter-sub! u a)
  (b6s-subset! (list 'INTERSECTION u a) a
    (lambda (q) (let ((im (dk-cite! 'intersection-membership u a q))) (if (dk-only! im (list 'IN q (list 'INTERSECTION u a))) (prop)))))
  (dk-cite! 'subclass-of-set-is-set (list 'INTERSECTION u a) a))
(define (b6s-sub-open-in! t a u)
  (let ((w (list 'INTERSECTION u a)))
    (b6s-inter-sub! u a)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN 'z_ a)))
      (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd w a e) (dk-ass!))))
    (dk-cite! 'power-mem-intro a w)
    (dk-have! (list 'IN w (list 'OPENS (b6s-sub t a)))
      (lambda () (subst (list '== (list 'OPENS (b6s-sub t a)) (b6s-subopens t a)))
                 (in-sep! (lambda () (ass)) (lambda () (ew u) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
(define (b6s-sub-open-out! t a w)
  (let ((ex (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS t)) (list '= w (list 'INTERSECTION 'stu_ a))))))
    (dk-have! ex (lambda () (let ((h (dk-rewrite-h! (list 'IN w (list 'OPENS (b6s-sub t a))) (list 'OPENS (b6s-sub t a)) (b6s-subopens t a))))
                              (sep-me h) (dk-split-all!) (dk-ass!))))
    (dk-skolem! (dk-ctx-form ex) #t)))

