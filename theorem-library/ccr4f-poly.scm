;;; ccr4f-poly.scm -- POLYNOMIALS EVALUATED IN A NORMED FIELD, AND THE SUBFIELD GENERATED BY ONE ELEMENT AS
;;; QUOTIENTS OF THEIR VALUES (CCR-1111 finding F2).  Agent CCR-1111B, 2026-11-11.
;;; Destination: theorem-library/ccr4f-poly.scm.  Helper prefix fp7-.  Library: analysis (normed fields); the
;;; first two lemmas are algebra (monoid algebras) and could be hoisted.
;;;
;;;   monalg-mul-coef-in   in a monoid algebra A[M]: a class S containing 0 and closed under + and * contains every
;;;                        coefficient of f g when it contains those of f and g
;;;   poly-mul-coef-in     the same for A[x]
;;;   nf-poly-eval-in-subfield  w in a subfield S, the coefficients of p in S  =>  p(w) in S
;;;
;;; Load window: after monalg-is-ring (monalg-mul-apply, finsupp-membership), gal-poly (poly-mul-unfold,
;;; poly-carrier), finsum-in-subset, ccr4b-base / ccr4c-subnf (IS-NF-SUBFIELD, nf-subfield-ring-power),
;;; poly-eval-mul.scm (CCR-1111B).

(define (fp7-has? t x) (or (equal? t x) (and (pair? t) (or (fp7-has? (car t) x) (fp7-has? (cdr t) x)))))
(define (fp7-or! f thunk) (if (not (dk-asm? f)) (thunk)) f)

;;; ---------------------------------------------------------------------------
;;; 1. coefficients of a product in a monoid algebra
(define fp7-cl
  '(AND (IN (ZERO pca) pcs)
    (AND (FORALL pcu (IMPLIES (IN pcu pcs) (FORALL pcv (IMPLIES (IN pcv pcs) (IN ((ADD pca) pcu pcv) pcs)))))
         (FORALL pcu (IMPLIES (IN pcu pcs) (FORALL pcv (IMPLIES (IN pcv pcs) (IN ((MUL pca) pcu pcv) pcs))))))))
(define (fp7-coefs f m) `(FORALL pcy (IMPLIES (IN pcy (CARR ,m)) (IN (,f pcy) pcs))))
(sp (make-wff `(FORALL pca (FORALL pcm (FORALL pcs (IMPLIES (IS-RING pca) (IMPLIES (IS-MONOID pcm) (IMPLIES ,fp7-cl
   (FORALL pcf (IMPLIES (IN pcf (FINSUPP pca pcm)) (IMPLIES ,(fp7-coefs 'pcf 'pcm)
   (FORALL pcg (IMPLIES (IN pcg (FINSUPP pca pcm)) (IMPLIES ,(fp7-coefs 'pcg 'pcm)
   (FORALL pcx (IMPLIES (IN pcx (CARR pcm)) (IN ((MONALG-MUL pca pcm pcf pcg) pcx) pcs)))))))))))))))))
(dk-peel!)
(dk-split-all!)
(define fp7-addh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (fp7-has? f '(ADD pca)))) "the + closure"))
(define fp7-mulh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (fp7-has? f '(MUL pca)))) "the * closure"))
(define fp7-cf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (fp7-has? f '(pcf pcy)))) "f's coefficients"))
(define fp7-cg (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (fp7-has? f '(pcg pcy)))) "g's coefficients"))
(dk-cite! 'monoid-carrier-is-set 'pcm)
(define (fp7-supp f) `(SUPP pca pcm ,f))
(define (fp7-fs! f)
  (dk-have! `(IN ,f (FUN (CARR pcm) (CARR pca)))
    (lambda () (mac-h 'finsupp-membership `(IN ,f (FINSUPP pca pcm))) (dk-split-all!) (dk-close-if-asm!)))
  (dk-have! `(IN (CARD ,(fp7-supp f)) NN)
    (lambda () (mac-h 'finsupp-membership `(IN ,f (FINSUPP pca pcm))) (dk-split-all!) (dk-close-if-asm!)))
  (dk-cite! 'supp-in-set 'pca 'pcm f))
(fp7-fs! 'pcf) (fp7-fs! 'pcg)
(define fp7-P `(CARTESIAN ,(fp7-supp 'pcf) ,(fp7-supp 'pcg)))
(dk-have! `(IN ,fp7-P SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close!)))
(dk-cite! 'card-cartesian-nn (fp7-supp 'pcf) (fp7-supp 'pcg))
(dk-cite! 'ring-additive-ag-is-abelian-group 'pca)
(mac 'monalg-mul-apply)
(define fp7-fs (cadr (dk-goal)))
(define fp7-L (caddr fp7-fs))
(define fp7-I (cadddr fp7-fs))
(define fp7-ag '(RING-ADDITIVE-AG pca))
(dk-have! `(IN ,fp7-I SET) (lambda () (sep-set) (dk-close-if-asm!)))
(dk-have! `(AND (IN ,fp7-P SET) (IN (CARD ,fp7-P) NN)) (lambda () (dk-conj-close!)))
(dk-have! `(AND (IN ,fp7-I SET) (FORALL pcz_ (IMPLIES (IN pcz_ ,fp7-I) (IN pcz_ ,fp7-P))))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let ((z (dk-di-var!))) (sep-me `(IN ,z ,fp7-I)) (dk-close-if-asm!)))))))
(dk-cite! 'card-subset-nn fp7-P fp7-I)
;; z in I: the two coordinates are in the supports, hence in CARR m; land the summand facts
(define (fp7-pt! z)
  (dk-have! `(IN ,z ,fp7-P) (lambda () (sep-me `(IN ,z ,fp7-I)) (dk-close-if-asm!)))
  (dk-split-all! (list (dk-cite! 'cartesian-nth z (fp7-supp 'pcf) (fp7-supp 'pcg))))
  (for-each (lambda (pr)
              (let ((c (car pr)) (f (cadr pr)))
                (dk-have! `(IN ,c (CARR pcm))
                  (lambda () (mac-h 'supp-membership `(IN ,c ,(fp7-supp f))) (dk-split-all!) (dk-close-if-asm!)))
                (dk-cite! 'fun-apply-type-c f '(CARR pcm) '(CARR pca) c)
                (dk-apply! (if (eq? f 'pcf) fp7-cf fp7-cg) c)))
            (list (list `(NTH 1 ,z) 'pcf) (list `(NTH 2 ,z) 'pcg)))
  (dk-cite! 'ring-carrier-closed-mul 'pca `(pcf (NTH 1 ,z)) `(pcg (NTH 2 ,z))))
(dk-have! `(IN ,fp7-L (FUN ,fp7-I (CARR ,fp7-ag)))
  (lambda ()
    (subst (dk-cite! 'raag-carr 'pca))
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fp7-pt! z) (dk-close-if-asm!)))
                  (lambda () (dk-close-if-asm!)))))
(dk-have! `(IN (IDEN ,fp7-ag) pcs) (lambda () (subst (dk-cite! 'raag-iden 'pca)) (dk-close-if-asm!)))
(dk-have! `(FORALL pcx_ (IMPLIES (IN pcx_ pcs) (FORALL pcy_ (IMPLIES (IN pcy_ pcs) (IN ((OPR ,fp7-ag) pcx_ pcy_) pcs)))))
  (lambda ()
    (subst (dk-cite! 'raag-opr 'pca))
    (dk-peel!)
    (let* ((t (cadr (dk-goal))) (x (cadr t)) (y (caddr t)))
      (dk-apply! fp7-addh x y)
      (dk-close-if-asm!))))
(dk-have! `(FORALL pcz_ (IMPLIES (IN pcz_ ,fp7-I) (IN (,fp7-L pcz_) pcs)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fp7-pt! z)
      (dk-lam-b!)
      (dk-apply! fp7-mulh `(pcf (NTH 1 ,z)) `(pcg (NTH 2 ,z)))
      (dk-close-if-asm!))))
(dk-cite! 'finsum-in-subset fp7-ag 'pcs fp7-I fp7-L)
(dk-close-if-asm!)
(qed 'monalg-mul-coef-in)

(define fp7-nm 'NN-ADD-MONOID)
(sp (make-wff `(FORALL pca (FORALL pcs (IMPLIES (IS-RING pca) (IMPLIES ,fp7-cl
   (FORALL pcf (IMPLIES (IN pcf (CARR (POLY pca))) (IMPLIES (FORALL pcy (IMPLIES (IN pcy NN) (IN (pcf pcy) pcs)))
   (FORALL pcg (IMPLIES (IN pcg (CARR (POLY pca))) (IMPLIES (FORALL pcy (IMPLIES (IN pcy NN) (IN (pcg pcy) pcs)))
   (FORALL pcx (IMPLIES (IN pcx NN) (IN (((MUL (POLY pca)) pcf pcg) pcx) pcs)))))))))))))))
(dk-peel!)
(dk-cite! 'nn-add-monoid-is-comm-monoid)
(dk-cite! 'comm-monoid-is-monoid fp7-nm)
(dk-cite! 'nn-add-monoid@carr)
(define fp7-pc (dk-cite! 'poly-carrier 'pca))
(for-each (lambda (f)
            (dk-have! `(IN ,f (FINSUPP pca ,fp7-nm)) (lambda () (subst `(== (FINSUPP pca ,fp7-nm) (CARR (POLY pca)))) (dk-close-if-asm!)))
            (dk-have! `(FORALL pcy_ (IMPLIES (IN pcy_ (CARR ,fp7-nm)) (IN (,f pcy_) pcs)))
              (lambda () (subst `(== (CARR ,fp7-nm) NN))
                         (let ((y (dk-di-var!)))
                           (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (fp7-has? h (list f 'pcy)))) "coefs") y)
                           (dk-close-if-asm!)))))
          '(pcf pcg))
(dk-have! `(IN pcx (CARR ,fp7-nm)) (lambda () (subst `(== (CARR ,fp7-nm) NN)) (dk-close-if-asm!)))
(subst (dk-cite! 'poly-mul-unfold 'pca 'pcf 'pcg))
(dk-cite! 'monalg-mul-coef-in 'pca fp7-nm 'pcs 'pcf 'pcg 'pcx)
(dk-close-if-asm!)
(qed 'poly-mul-coef-in)

;;; ---------------------------------------------------------------------------
;;; 2. a polynomial with coefficients in a subfield S, evaluated at a point of S, lands in S
(define fp7-V '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define fp7-conjs '())
(define (fp7-and-list f) (if (dk-head-is? f 'AND) (cons (cadr f) (fp7-and-list (caddr f))) (list f)))
;; IS-NORMED-FIELD K, IS-NF-SUBFIELD K S in context: the ring view facts and the subfield conjuncts
(define (fp7-setup!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring fp7-V)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul normed-field-ring-view-neg
              normed-field-ring-view-zero normed-field-ring-view-one))
  (let* ((iff (dk-cite! 'is-nf-subfield 'K 'S)) (rhs (caddr iff)))
    (set! fp7-conjs (fp7-and-list rhs))
    (if (not (dk-asm? (car fp7-conjs)))
        (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) rhs)) (dk-split-all! (list rhs))))))
(define (fp7-inK! u) (fp7-or! `(IN ,u (CARR K)) (lambda () (dk-apply! (list-ref fp7-conjs 0) u))))
(define (fp7-inV! u)
  (fp7-inK! u)
  (fp7-or! `(IN ,u (CARR ,fp7-V)) (lambda () (dk-rewrite-h! `(IN ,u (CARR K)) '(CARR K) `(CARR ,fp7-V)))))
(define (fp7-coefs-in body) `(IMPLIES (FORALL pcy (IMPLIES (IN pcy NN) (IN (pcp pcy) S))) ,body))
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S)
   (FORALL pcw (IMPLIES (IN pcw S) (FORALL pcp (IMPLIES (IN pcp (CARR (POLY ,fp7-V)))
     ,(fp7-coefs-in `(IN (POLY-EVAL ,fp7-V pcp pcw) S))))))))))))
(dk-peel!)
(fp7-setup!)
(fp7-inV! 'pcw)
(define fp7-ch (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (fp7-has? h '(pcp pcy)))) "the coefficients"))
(dk-split-all! (list (dk-cite! 'deg-well-defined fp7-V 'pcp)))
(define fp7-n `(succ (DEG ,fp7-V pcp)))
(dk-cite! 'nn-succ-closed `(DEG ,fp7-V pcp))
(dk-cite! 'ring-additive-ag-is-abelian-group fp7-V)
(mac 'POLY-EVAL)
(define fp7-G (caddr (cadr (dk-goal))))
(define fp7-rag `(RING-ADDITIVE-AG ,fp7-V))
(dk-have! `(IN (IDEN ,fp7-rag) S)
  (lambda () (subst (dk-cite! 'ras-id fp7-V)) (subst `(== (ZERO ,fp7-V) (ZERO K))) (dk-close-if-asm!)))
(dk-have! `(FORALL pcx_ (IMPLIES (IN pcx_ S) (FORALL pcy_ (IMPLIES (IN pcy_ S) (IN ((OPR ,fp7-rag) pcx_ pcy_) S)))))
  (lambda ()
    (subst (dk-cite! 'ras-op fp7-V)) (subst `(== (ADD ,fp7-V) (ADD K)))
    (dk-peel!)
    (let* ((t (cadr (dk-goal))))
      (dk-apply! (list-ref fp7-conjs 3) (cadr t) (caddr t))
      (dk-close-if-asm!))))
(dk-have! `(FORALL pci_ (IMPLIES (IN pci_ (ORD-SEGMENT ,fp7-n)) (IN (,fp7-G pci_) S)))
  (lambda ()
    (let ((i (dk-di-var!)))
      (dk-cite! 'ord-segment-nn-subset fp7-n i)
      (dk-cite! 'poly-coef-in fp7-V 'pcp i)
      (dk-cite! 'ring-power-type fp7-V 'pcw i)
      (dk-lam-b!)
      (subst `(== (MUL ,fp7-V) (MUL K)))
      (dk-apply! fp7-ch i)
      (dk-cite! 'nf-subfield-ring-power i 'K 'S 'pcw)
      (dk-apply! (list-ref fp7-conjs 4) `(pcp ,i) `(RING-POWER ,fp7-V pcw ,i))
      (dk-close-if-asm!))))
(dk-cite! 'sum-ag-in-subset-ind fp7-n fp7-rag 'S fp7-G)
(dk-close-if-asm!)
(qed 'nf-poly-eval-in-subfield)

;;; ---------------------------------------------------------------------------
;;; 3. F(w) as quotients: NF-RAT-AT(K, F, w) is a subfield of K
(define fp7-PV `(POLY ,fp7-V))
(define (fp7-ev p) `(POLY-EVAL ,fp7-V ,p pcw))
(define fp7-fc '())                     ; the subfield conjuncts of fsub
(define fp7-RL #f)                      ; NF-RAT-AT K fsub pcw, unfolded (read off the goal)
(define fp7-PL #f)                      ; NF-POLY-OVER K fsub, unfolded
(define fp7-clv #f)                     ; fsub's closure facts in the ring view, as poly-mul-coef-in wants them
(define (fp7-base!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring fp7-V)
  (dk-cite! 'poly-is-ring fp7-V)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul normed-field-ring-view-neg
              normed-field-ring-view-zero normed-field-ring-view-one))
  (let* ((iff (dk-cite! 'is-nf-subfield 'K 'fsub)) (rhs (caddr iff)))
    (set! fp7-fc (fp7-and-list rhs))
    (if (not (dk-asm? (car fp7-fc)))
        (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) rhs)) (dk-split-all! (list rhs))))))
(define (fp7-k->v! f)                   ; F in context with K's ring operations: land it with the view's
  (let loop ((f f) (ops '(ADD MUL NEG ZERO ONE CARR)))
    (if (null? ops) f
        (let ((kt (list (car ops) 'K)) (vt (list (car ops) fp7-V)))
          (loop (if (fp7-has? f kt) (dk-rewrite-h! f kt vt) f) (cdr ops))))))
(define (fp7-goal-v->k!)
  (for-each (lambda (op)
              (let ((kt (list op 'K)) (vt (list op fp7-V)))
                (if (fp7-has? (dk-goal) vt) (subst (list '== vt kt)))))
            '(ADD MUL NEG ZERO ONE CARR)))
(define (fp7-goal-k->v!)
  (for-each (lambda (op)
              (let ((kt (list op 'K)) (vt (list op fp7-V)))
                (if (fp7-has? (dk-goal) kt) (subst (list '== kt vt)))))
            '(ADD MUL NEG ZERO ONE)))
(define (fp7-inF->K! u) (fp7-or! `(IN ,u (CARR K)) (lambda () (dk-apply! (list-ref fp7-fc 0) u))))
(define (fp7-carr! u)                   ; u in CARR K in context: land u in CARR V
  (fp7-or! `(IN ,u (CARR ,fp7-V))
    (lambda ()
      (cond ((equal? u `(ZERO ,fp7-V)) (dk-cite! 'ring-zero-in fp7-V))
            ((equal? u `(ONE ,fp7-V)) (dk-cite! 'ring-one-in fp7-V))
            (#t (dk-rewrite-h! `(IN ,u (CARR K)) '(CARR K) `(CARR ,fp7-V)))))))
(define (fp7-carrk! u)                  ; u in CARR V in context: land u in CARR K
  (fp7-or! `(IN ,u (CARR K)) (lambda () (dk-rewrite-h! `(IN ,u (CARR ,fp7-V)) `(CARR ,fp7-V) '(CARR K)))))
(define (fp7-op? t op) (and (pair? t) (equal? (car t) (list op fp7-PV))))
(define (fp7-mono? t) (and (pair? t) (eq? (car t) 'MONOMIAL)))
;; fp7num built from opened polynomials by ADD / MUL / NEG of POLY V and MONOMIAL(V, c, n): land fp7num in CARR (POLY V)
(define (fp7-ptype! p)
  (let ((g `(IN ,p (CARR ,fp7-PV))))
    (if (not (dk-asm? g))
        (cond ((fp7-mono? p) (fp7-carr! (caddr p)) (dk-cite! 'monomial-in-poly fp7-V (caddr p) (cadddr p)))
              ((fp7-op? p 'ADD) (fp7-ptype! (cadr p)) (fp7-ptype! (caddr p)) (dk-cite! 'ring-add-closed fp7-PV (cadr p) (caddr p)))
              ((fp7-op? p 'MUL) (fp7-ptype! (cadr p)) (fp7-ptype! (caddr p)) (dk-cite! 'ring-carrier-closed-mul fp7-PV (cadr p) (caddr p)))
              ((fp7-op? p 'NEG) (fp7-ptype! (cadr p)) (dk-cite! 'ring-neg-in-carr fp7-PV (cadr p)))
              (#t (error "fp7-ptype!: not an opened polynomial" (expression->string p)))))
    g))
(define (fp7-cf p) `(FORALL pcy (IMPLIES (IN pcy NN) (IN (,p pcy) fsub))))
;; land the coefficient universal of fp7num
(define (fp7-coef-all! p)
  (let ((g (fp7-cf p)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (let ((i (dk-di-var!))) (fp7-coef-at! p i) (dk-close-if-asm!)))))
    g))
;; land (IN (fp7num i) fsub), i in NN in context
(define (fp7-coef-at! p i)
  (let ((g `(IN (,p ,i) fsub)))
    (if (not (dk-asm? g))
        (cond
          ((fp7-op? p 'ADD)
           (let ((a (cadr p)) (b (caddr p)))
             (fp7-ptype! a) (fp7-ptype! b)
             (fp7-coef-at! a i) (fp7-coef-at! b i)
             (dk-apply! (list-ref fp7-fc 3) `(,a ,i) `(,b ,i))
             (dk-cite! 'poly-add-at fp7-V a b i)
             (let ((f (dk-rewrite-h! `(IN ((ADD K) (,a ,i) (,b ,i)) fsub) '(ADD K) `(ADD ,fp7-V))))
               (dk-rewrite-h! f `((ADD ,fp7-V) (,a ,i) (,b ,i)) `(,p ,i)))))
          ((fp7-op? p 'NEG)
           (let ((a (cadr p)))
             (fp7-ptype! a) (fp7-coef-at! a i)
             (dk-apply! (list-ref fp7-fc 5) `(,a ,i))
             (dk-cite! 'poly-neg-at fp7-V a i)
             (let ((f (dk-rewrite-h! `(IN ((NEG K) (,a ,i)) fsub) '(NEG K) `(NEG ,fp7-V))))
               (dk-rewrite-h! f `((NEG ,fp7-V) (,a ,i)) `(,p ,i)))))
          ((fp7-op? p 'MUL)
           (let ((a (cadr p)) (b (caddr p)))
             (fp7-ptype! a) (fp7-ptype! b)
             (fp7-coef-all! a) (fp7-coef-all! b)
             (if (not (dk-asm? fp7-clv)) (dk-have! fp7-clv (lambda () (dk-conj-close! (lambda () (ass))))))
             (dk-cite! 'poly-mul-coef-in fp7-V 'fsub a b i)))
          ((fp7-mono? p)
           (let* ((c (caddr p)) (n (cadddr p)) (o `(OR (= ,i ,n) (NOT (= ,i ,n)))))
             (fp7-carr! c)
             (dk-have! g
               (lambda ()
                 (dk-have! o (lambda () (prop)))
                 (dk-or-each! (dk-ctx-form o)
                   (lambda (h)
                     (if (dk-head-is? h 'NOT)
                         (begin (subst (dk-cite! 'monomial-off fp7-V c n i))
                                (fp7-goal-v->k!) (dk-close-if-asm!))
                         (begin (subst h) (subst (dk-cite! 'monomial-at fp7-V c n)) (fp7-goal-v->k!) (dk-close-if-asm!)))))))))
          ((dk-asm? (fp7-cf p)) (dk-apply! (fp7-cf p) i))
          (#t (error "fp7-coef-at!: no coefficient facts for" (expression->string p)))))
    g))
;; goal (IN fp7num PL): fp7num built as above
(define (fp7-pov-in! p)
  (fp7-ptype! p)
  (fp7-coef-all! p)
  (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))
;; rewrite the values at w in the goal, outermost constructors first, to the view's operations on the parts
(define (fp7-ev-step! p)
  (cond ((not (fp7-has? (dk-goal) (fp7-ev p))) '()) ((fp7-op? p 'ADD) (fp7-ptype! (cadr p)) (fp7-ptype! (caddr p))
                          (subst (dk-cite! 'poly-eval-add fp7-V (cadr p) (caddr p) 'pcw)) (list (cadr p) (caddr p)))
        ((fp7-op? p 'MUL) (fp7-ptype! (cadr p)) (fp7-ptype! (caddr p))
                          (subst (dk-cite! 'poly-eval-mul fp7-V 'pcw (cadr p) (caddr p))) (list (cadr p) (caddr p)))
        ((fp7-op? p 'NEG) (fp7-ptype! (cadr p))
                          (subst (dk-cite! 'poly-eval-neg fp7-V (cadr p) 'pcw)) (list (cadr p)))
        ((fp7-mono? p) (fp7-carr! (caddr p))
                       (subst (dk-cite! 'poly-eval-monomial fp7-V (caddr p) (cadddr p) 'pcw))
                       (let ((n (cadddr p)))
                         (cond ((eqv? n 0) (subst (dk-cite! 'ring-power-zero fp7-V 'pcw)))
                               ((eqv? n 1) (subst (dk-cite! 'ring-power-one fp7-V 'pcw)))))
                       '())
        (#t '())))
(define (fp7-ev-all! p) (for-each fp7-ev-all! (fp7-ev-step! p)))
;; x in RL in context: open it; land the parts and return (p q); the values typed in K and V
(define (fp7-open! x)
  (let* ((part (dk-sep-parts! `(IN ,x ,fp7-RL)))
         (p (dk-skolem! part #t))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (fp7-has? f (fp7-ev p)))) "the denominator"))
         (q (dk-skolem! ex2 #t)))
    (dk-split-all!)
    (for-each (lambda (r)
                (dk-sep-parts! `(IN ,r ,fp7-PL))
                (dk-cite! 'poly-eval-type fp7-V r 'pcw)
                (fp7-carrk! (fp7-ev r)))
              (list p q))
    (fp7-carr! x)
    (fp7-k->v! `(= ((MUL K) ,x ,(fp7-ev q)) ,(fp7-ev p)))
    (list p q)))
;; a, b in CARR K, both /= 0: land (NOT (= ((MUL K) a b) (ZERO K)))
(define (fp7-nz-mul! a b)
  (let ((g `(NOT (= ((MUL K) ,a ,b) (ZERO K)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (di)
            (let ((na `((FNRM K) ,a)) (nb `((FNRM K) ,b)) (nab `((FNRM K) ((MUL K) ,a ,b))))
              (dk-cite! 'nf-norm-in-rr 'K a) (dk-cite! 'nf-norm-in-rr 'K b)
              (dk-cite! 'nf-norm-pos-of-nonzero 'K a) (dk-cite! 'nf-norm-pos-of-nonzero 'K b)
              (dk-cite! 'rr-mul-pos na nb)
              (dk-cite! 'nf-norm-mult 'K a b)
              (dk-have! `(= ,nab 0)
                (lambda () (subst `(= ((MUL K) ,a ,b) (ZERO K))) (subst (dk-cite! 'nf-norm-of-zero 'K)) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
              (dk-have! `(< 0 ,nab) (lambda () (subst `(= ,nab (* ,na ,nb))) (dk-close-if-asm!)))
              (dk-rewrite-h! `(< 0 ,nab) nab 0)
              (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
              (ai (dk-cite! 'rr-lt-irrefl 0))))))
    g))
;; goal (IN X RL): witnesses fp7num, fp7den (built), X in CARR K in context.  NZ! proves (NOT (= ev(fp7den) (ZERO K))) as a goal,
;; EQ! proves (= ((MUL K) X ev(fp7den)) ev(fp7num)) as a goal
(define (fp7-rat-in! x p q nz! eq!)
  (in-sep! (lambda () (dk-close-if-asm!))
    (lambda ()
      (witness! p
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (ass))
                  ((and (dk-head-is? g 'IN) (equal? (cadr g) p)) (fp7-pov-in! p))
                  ((dk-head-is? g 'FORSOME)
                   (witness! q
                     (lambda ()
                       (dk-conj-close!
                         (lambda ()
                           (let ((g2 (dk-goal)))
                             (cond ((dk-asm? g2) (ass))
                                   ((dk-head-is? g2 'IN) (fp7-pov-in! q))
                                   ((dk-head-is? g2 'NOT) (nz!))
                                   (#t (eq!)))))))))
                  (#t (error "fp7-rat-in!: unexpected leaf" (expression->string g))))))))))))
;; an equation goal between view / K expressions in the values: rewrite the values, move to the view, rewrite the
;; numerators by the hypotheses x q(w) = p(w) (view form) given as (x . (p q)) pairs, then crs
(define (fp7-eq-close! fp7num fp7den pairs)
  (fp7-ev-all! fp7num) (fp7-ev-all! fp7den)
  (fp7-goal-k->v!)
  (for-each (lambda (pr)
              (let* ((x (car pr)) (p (cadr pr)) (q (caddr pr)))
                (if (fp7-has? (dk-goal) (fp7-ev p))
                    (subst `(= ,(fp7-ev p) ((MUL ,fp7-V) ,x ,(fp7-ev q)))))))
            pairs)
  (dk-close-if! (lambda () #t) (lambda () (crs))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL fsub (IMPLIES (IS-NF-SUBFIELD K fsub)
   (FORALL pcw (IMPLIES (IN pcw (CARR K)) (IS-NF-SUBFIELD K (NF-RAT-AT K fsub pcw))))))))))
(dk-peel!)
(fp7-base!)
(fp7-carr! 'pcw)
(set! fp7-clv `(AND (IN (ZERO ,fp7-V) fsub)
                (AND (FORALL pcu (IMPLIES (IN pcu fsub) (FORALL pcv (IMPLIES (IN pcv fsub) (IN ((ADD ,fp7-V) pcu pcv) fsub)))))
                     (FORALL pcu (IMPLIES (IN pcu fsub) (FORALL pcv (IMPLIES (IN pcv fsub) (IN ((MUL ,fp7-V) pcu pcv) fsub))))))))
(dk-have! fp7-clv (lambda () (fp7-goal-v->k!) (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-zero-ne-one 'K)
(fp7-carr! '(ZERO K)) (fp7-carr! '(ONE K))
(mac 'is-nf-subfield)
(mac 'NF-RAT-AT)
(mac 'NF-POLY-OVER)
(set! fp7-RL (caddr (cadr (caddr (cadr (dk-goal))))))
(set! fp7-PL (caddr (cadr (caddr (cadddr fp7-RL)))))
(define (fp7-m c n) `(MONOMIAL ,fp7-V ,c ,n))
(define fp7-one-p (fp7-m `(ONE ,fp7-V) 0))
(define (fp7-mul a b) `((MUL ,fp7-PV) ,a ,b))
(define (fp7-add a b) `((ADD ,fp7-PV) ,a ,b))
(define (fp7-neg a) `((NEG ,fp7-PV) ,a))
;; the denominator 1: its value is 1 /= 0
(dk-have! '(NOT (= (ONE K) (ZERO K)))
  (lambda () (di) (dk-have! '(= (ZERO K) (ONE K)) (lambda () (subst '(= (ONE K) (ZERO K))) (rfl)))
             (ai '(NOT (= (ZERO K) (ONE K))))))
(define (fp7-nz-one!) (fp7-ev-all! fp7-one-p) (subst (dk-cite! 'ring-mul-left-id fp7-V `(ONE ,fp7-V)))
                      (fp7-goal-v->k!) (dk-close-if-asm!))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) '(ZERO K)))           ; 0 = 0(w) / 1(w)
         (fp7-rat-in! '(ZERO K) (fp7-m `(ZERO ,fp7-V) 0) fp7-one-p fp7-nz-one!
           (lambda () (fp7-eq-close! (fp7-m `(ZERO ,fp7-V) 0) fp7-one-p '()))))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) '(ONE K)))            ; 1 = 1(w) / 1(w)
         (fp7-rat-in! '(ONE K) fp7-one-p fp7-one-p fp7-nz-one!
           (lambda () (fp7-eq-close! fp7-one-p fp7-one-p '()))))
        (#t
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (g2 (dk-goal)))
           (cond
             ((and (dk-head-is? g2 'IN) (equal? (caddr g2) '(CARR K)))    ; RL lies in K
              (dk-sep-parts! (car (filter (lambda (f) (dk-head-is? f 'IN)) landed))) (dk-close-if-asm!))
             ((dk-head-is? g2 'FORSOME)                                    ; inverses
              (let* ((x (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
                     (pq (fp7-open! x)) (p (car pq)) (q (cadr pq)) (ep (fp7-ev p)) (eq (fp7-ev q)))
                (fp7-carrk! x)
                ;; p(w) /= 0, else x q(w) = 0 with q(w) /= 0
                (dk-have! `(NOT (= ,ep (ZERO K)))
                  (lambda ()
                    (di)
                    (dk-have! `(= ((MUL K) ,x ,eq) (ZERO K))
                      (lambda () (subst `(= ((MUL K) ,x ,eq) ,ep)) (dk-close-if-asm!)))
                    (fp7-nz-mul! x eq)
                    (ai `(NOT (= ((MUL K) ,x ,eq) (ZERO K))))))
                (let* ((iv (dk-skolem! (dk-cite! 'nf-inverse 'K ep) #t))
                       (y `((MUL K) ,eq ,iv)))
                  (dk-split-all!)
                  (dk-cite! 'nf-mul-in-carr 'K eq iv)
                  (fp7-carr! iv)
                  (fp7-k->v! `(= ((MUL K) ,ep ,iv) (ONE K)))
                  (witness! y
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'IN)
                              (fp7-rat-in! y q p (lambda () (dk-close-if-asm!))
                                (lambda ()
                                  (fp7-goal-k->v!)
                                  (let* ((m (lambda (a b) `((MUL ,fp7-V) ,a ,b)))
                                         (lhs (m (m eq iv) ep)) (rhs (m eq (m ep iv))))
                                    (dk-have! `(= ,lhs ,rhs) (lambda () (crs)))
                                    (subst `(= ,lhs ,rhs)))
                                  (subst `(= ((MUL ,fp7-V) ,ep ,iv) (ONE ,fp7-V)))
                                  (dk-close-if! (lambda () #t) (lambda () (crs)))))
                              (begin                                       ; x y = 1
                                (fp7-goal-k->v!)
                                (subst `(= (ONE ,fp7-V) ((MUL ,fp7-V) ,ep ,iv)))
                                (subst `(= ,ep ((MUL ,fp7-V) ,x ,eq)))
                                (dk-close-if! (lambda () #t) (lambda () (crs))))))))))))
             (#t                                                           ; +, *, -
              (let* ((xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                     (x (car xs))
                     (pq (fp7-open! x)) (p (car pq)) (q (cadr pq)))
                (fp7-carrk! x)
                (if (null? (cdr xs))
                    (begin                                                 ; -x = (-p) / q
                      (dk-cite! 'nf-neg-in-carr 'K x)
                      (fp7-rat-in! `((NEG K) ,x) (fp7-neg p) q (lambda () (dk-close-if-asm!))
                        (lambda () (fp7-eq-close! (fp7-neg p) q (list (list x p q))))))
                    (let* ((y (cadr xs)) (pq2 (fp7-open! y)) (p2 (car pq2)) (q2 (cadr pq2))
                           (fp7den (fp7-mul q q2))
                           (nz (lambda ()
                                 (fp7-ev-all! fp7den) (fp7-goal-v->k!)
                                 (fp7-nz-mul! (fp7-ev q) (fp7-ev q2)) (dk-close-if-asm!))))
                      (fp7-carrk! y)
                      (if (fp7-has? g2 '(ADD K))
                          (let ((fp7num (fp7-add (fp7-mul p q2) (fp7-mul p2 q))))
                            (dk-cite! 'nf-add-in-carr 'K x y)
                            (fp7-rat-in! `((ADD K) ,x ,y) fp7num fp7den nz
                              (lambda () (fp7-eq-close! fp7num fp7den (list (list x p q) (list y p2 q2))))))
                          (let ((fp7num (fp7-mul p p2)))
                            (dk-cite! 'nf-mul-in-carr 'K x y)
                            (fp7-rat-in! `((MUL K) ,x ,y) fp7num fp7den nz
                              (lambda () (fp7-eq-close! fp7num fp7den (list (list x p q) (list y p2 q2))))))))))))))))))
(qed 'nf-rat-at-subfield)

;;; ---------------------------------------------------------------------------
;;; 4. F(w) is the least subfield containing F and w: it contains F and w, and lies in every such subfield
(define (fp7-main-setup!)
  (fp7-base!)
  (fp7-carr! 'pcw)
  (dk-have! fp7-clv (lambda () (fp7-goal-v->k!) (dk-conj-close! (lambda () (ass)))))
  (dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K)
  (fp7-carr! '(ZERO K)) (fp7-carr! '(ONE K)))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL fsub (IMPLIES (IS-NF-SUBFIELD K fsub)
   (FORALL pcw (IMPLIES (IN pcw (CARR K))
     (AND (FORALL pcz (IMPLIES (IN pcz fsub) (IN pcz (NF-RAT-AT K fsub pcw)))) (IN pcw (NF-RAT-AT K fsub pcw)))))))))))
(dk-peel!)
(fp7-main-setup!)
(dk-cite! 'nf-zero-ne-one 'K)
(dk-have! '(NOT (= (ONE K) (ZERO K)))
  (lambda () (di) (dk-have! '(= (ZERO K) (ONE K)) (lambda () (subst '(= (ONE K) (ZERO K))) (rfl)))
             (ai '(NOT (= (ZERO K) (ONE K))))))
(mac 'NF-RAT-AT)
(mac 'NF-POLY-OVER)
(set! fp7-RL (caddr (caddr (dk-goal))))
(set! fp7-PL (caddr (cadr (caddr (cadddr fp7-RL)))))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-head-is? g 'FORALL)                                           ; z = z(w) / 1(w)
         (let ((z (dk-di-var!)))
           (fp7-inF->K! z) (fp7-carr! z)
           (fp7-rat-in! z (fp7-m z 0) fp7-one-p fp7-nz-one!
             (lambda () (fp7-eq-close! (fp7-m z 0) fp7-one-p '())))))
        (#t                                                                ; w = (1 x)(w) / 1(w)
         (fp7-rat-in! 'pcw (fp7-m `(ONE ,fp7-V) 1) fp7-one-p fp7-nz-one!
           (lambda () (fp7-eq-close! (fp7-m `(ONE ,fp7-V) 1) fp7-one-p '()))))))))
(qed 'nf-rat-at-contains)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL fsub (IMPLIES (IS-NF-SUBFIELD K fsub)
   (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) (IMPLIES (FORALL pcz (IMPLIES (IN pcz fsub) (IN pcz S)))
   (FORALL pcw (IMPLIES (IN pcw S)
     (FORALL pcx (IMPLIES (IN pcx (NF-RAT-AT K fsub pcw)) (IN pcx S))))))))))))))
(mac 'NF-RAT-AT)
(mac 'NF-POLY-OVER)
(dk-peel!)
(fp7-setup!)
(fp7-inK! 'pcw)
(fp7-main-setup!)
(set! fp7-RL (caddr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'pcx) (dk-head-is? (caddr h) 'SEP))) "x in F(w)")))
(set! fp7-PL (caddr (cadr (caddr (cadddr fp7-RL)))))
(define fp7-sub (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (fp7-has? h '(IN pcz S)))) "F in S"))
(define fp7-pq (fp7-open! 'pcx))
(define (fp7-in-s! r)                   ; ev(r) in S
  (let ((cf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (fp7-has? h 'fsub) (fp7-has? h r))) "coefficients in F")))
    (dk-have! `(FORALL pcy (IMPLIES (IN pcy NN) (IN (,r pcy) S)))
      (lambda () (let ((i (dk-di-var!))) (dk-apply! cf i) (dk-apply! fp7-sub `(,r ,i)) (dk-close-if-asm!))))
    (dk-cite! 'nf-poly-eval-in-subfield 'K 'S 'pcw r)))
(for-each fp7-in-s! fp7-pq)
(define fp7-ep (fp7-ev (car fp7-pq)))
(define fp7-eq (fp7-ev (cadr fp7-pq)))
(define fp7-iv (dk-skolem! (dk-apply! (list-ref fp7-conjs 6) fp7-eq) #t))
(fp7-inV! fp7-iv)
(fp7-k->v! `(= ((MUL K) ,fp7-eq ,fp7-iv) (ONE K)))
(dk-apply! (list-ref fp7-conjs 4) fp7-ep fp7-iv)
(dk-have! `(= pcx ((MUL K) ,fp7-ep ,fp7-iv))
  (lambda ()
    (fp7-goal-k->v!)
    (subst `(= ,fp7-ep ((MUL ,fp7-V) pcx ,fp7-eq)))
    (let* ((m (lambda (a b) `((MUL ,fp7-V) ,a ,b)))
           (lhs (m (m 'pcx fp7-eq) fp7-iv)) (rhs (m 'pcx (m fp7-eq fp7-iv))))
      (dk-have! `(= ,lhs ,rhs) (lambda () (crs)))
      (subst `(= ,lhs ,rhs)))
    (subst `(= ((MUL ,fp7-V) ,fp7-eq ,fp7-iv) (ONE ,fp7-V)))
    (dk-close-if! (lambda () #t) (lambda () (crs)))))
(subst `(= pcx ((MUL K) ,fp7-ep ,fp7-iv)))
(dk-close-if-asm!)
(qed 'nf-rat-at-least)
