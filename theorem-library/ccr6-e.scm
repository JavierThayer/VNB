  (dk-project! '(IS-E-BILINEAR-BICHARACTER kf md w) 'is-e-unipolar hu)
  (dk-project! `(= (E-POLAR md w ,c6-b1) ,c6-b1) 'is-e-unipolar hu))
(c6-norm-on-parts! 'kf 'md 'nu)
(dk-have! '(IS-K-VECTOR-SPACE kf md) (lambda () (mac 'is-k-vector-space) (dk-conj-close! (lambda () (dk-ass!)))))
(let ((bil (dk-project! (c6-bil-law 'kf 'md 'w) 'is-e-bilinear-bicharacter '(IS-E-BILINEAR-BICHARACTER kf md w)))
      (hom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ACT) (dk-contains? f 'FNRM) (dk-contains? f 'nu))) "nu homogeneous")))
  (dk-cite! 'nf-norm-in-rr 'kf 'c) (dk-cite! 'nf-norm-nonneg 'kf 'c)
  (dk-cite! 'c6-act-in 'kf 'md 'c 'eta)
  (c6-nu! 'nu 'md c6-ce)
  (fact 'rr-one-in)
  (dk-iff! (lambda (gl) (dk-head-is? gl '<=))
