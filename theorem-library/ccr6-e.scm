      (IFF (IN eta (E-POLAR md w (NORM-BALL md nu ((FNRM kf) c)))) (<= (nu ((ACT md) c eta)) 1)))))))))))))))
(dk-peel!)
(let ((hu '(IS-E-UNIPOLAR kf md nu w)))
