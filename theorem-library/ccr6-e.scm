                 (r2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a2) (dk-contains? f 'BICHAR-OF) (not (dk-contains? f 'VNB-LAMBDA)))) "rel a2")))
