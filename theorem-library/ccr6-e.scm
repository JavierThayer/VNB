;;; =======================================================================
;;; 6. (66), THE EXPANSION: a bicharacter on E at two finite sums is the double product of its values
;;;    (the first step of the proof of 6.24), from c6-char-finsum in each argument.

(define c6-mv '(MODULE-VECTOR-AG md))
(define (c6-eb-stmt body)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md)
     (FORALL w (IMPLIES (IS-E-BICHARACTER kf md w) ,body)))))))
(define (c6-eb-setup!)
  (dk-peel!)
  (c6-vs! 'kf 'md)
  (dk-cite! 'nf-zero-in-carr 'kf)
  (let ((hc '(IS-E-BICHARACTER kf md w)))
    (dk-project! (c6-e-type 'md 'w) 'is-e-bicharacter hc)
    (dk-project! (c6-e-line 'kf 'md 'w) 'is-e-bicharacter hc)
    (dk-project! (c6-e-add 'md 'w) 'is-e-bicharacter hc))
  (dk-cite! 'module-vzero-in 'md)
  (dk-cite! 'module-vector-ag-is-abelian-group 'md)
  (dk-cite! 'mvag-carr 'md) (dk-cite! 'mvag-op 'md) (dk-cite! 'mvag-id 'md))
(define (c6-e-add md w)
  `(FORALL c6vx_ (IMPLIES (IN c6vx_ (VEC ,md)) (FORALL c6vy_ (IMPLIES (IN c6vy_ (VEC ,md))
     (FORALL c6vz_ (IMPLIES (IN c6vz_ (VEC ,md))
       (AND (= (,w ((VADD ,md) c6vx_ c6vy_) c6vz_) (* (,w c6vx_ c6vz_) (,w c6vy_ c6vz_)))
            (= (,w c6vz_ ((VADD ,md) c6vx_ c6vy_)) (* (,w c6vz_ c6vx_) (,w c6vz_ c6vy_)))))))))))
(define (c6-wv! a b) (c6-app2! 'w '(VEC md) '(VEC md) 'UNIT-CIRCLE a b))

;; w(0, y) = 1 = w(y, 0)
(define (c6-w-zero! side name)
  (sp (make-wff (c6-eb-stmt `(FORALL y (IMPLIES (IN y (VEC md))
    (= ,(if (eq? side 'l) '(w (VZERO md) y) '(w y (VZERO md))) 1))))))
  (c6-eb-setup!)
  (let* ((y (if (eq? side 'l) (caddr (cadr (dk-goal))) (cadr (cadr (dk-goal)))))
         (z0 '(VZERO md)) (a0z `((ACT md) (ZERO kf) ,z0))
         (two (dk-apply! (c6-e-line 'kf 'md 'w) z0 y))
         (ac (if (eq? side 'l) (cadr two) (caddr two))))
    (if (not (dk-asm? ac)) (dk-have! ac (lambda () (dk-split-all!) (dk-close-if-asm!))))
    (let* ((lch (caddr ac)) (ch0 (dk-cite! 'ch-zero 'kf lch)))
      (dk-cite! 'c6-act-in 'kf 'md '(ZERO kf) z0)
      (c6-in-scal! 'kf 'md '(ZERO kf))
      (let ((az (dk-cite! 'module-act-zero-vec 'md '(ZERO kf))))
        (if (eq? side 'l) (c6-wv! a0z y) (c6-wv! y a0z))
        (dk-have! `(= (,lch (ZERO kf)) ,(if (eq? side 'l) `(w ,a0z ,y) `(w ,y ,a0z)))
          (lambda () (if (not (dk-lam-b!)) (rfl))))
        (let* ((h1 (dk-rewrite-h! ch0 `(,lch (ZERO kf)) (if (eq? side 'l) `(w ,a0z ,y) `(w ,y ,a0z))))
               (h2 (dk-rewrite-h! h1 a0z z0)))
          (dk-close-if-asm!)))))
  (c6-dump!)
  (qed name))
(c6-w-zero! 'l 'c6-w-zero-l)
(c6-w-zero! 'r 'c6-w-zero-r)

(define (c6-uc-cc! t)                   ; t in UNIT-CIRCLE: land t in CC
  (if (not (dk-asm? `(IN ,t CC))) (c6-iff-fwd! (dk-cite! 'unit-circle-membership t))))
(define (c6-fs-stmt side)
  (c6-eb-stmt `(FORALL n (IMPLIES (IN n NN) (FORALL f (IMPLIES (FORALL z (IMPLIES (IN z (INTERVAL 1 n)) (IN (f z) (VEC md))))
    (FORALL y (IMPLIES (IN y (VEC md))
      ,(if (eq? side 'l)
           `(= (w (FINSUM ,c6-mv f (INTERVAL 1 n)) y) (FINSUM ,c6-cm (VNB-LAMBDA c6i_ (INTERVAL 1 n) (w (f c6i_) y)) (INTERVAL 1 n)))
           `(= (w y (FINSUM ,c6-mv f (INTERVAL 1 n))) (FINSUM ,c6-cm (VNB-LAMBDA c6i_ (INTERVAL 1 n) (w y (f c6i_))) (INTERVAL 1 n))))))))))))
(define (c6-fs! side name)
  (sp (make-wff (c6-fs-stmt side)))
  (c6-eb-setup!)
  (c6-cm!)
  (let* ((gl (dk-goal)) (l? (eq? side 'l))
         (fs (if l? (cadr (cadr gl)) (caddr (cadr gl)))) (y (if l? (caddr (cadr gl)) (cadr (cadr gl))))
         (n (caddr (cadddr fs))) (I `(INTERVAL 1 ,n)) (f (caddr fs))
         (app (lambda (t) (if l? `(w ,t ,y) `(w ,y ,t))))
         (chi `(VNB-LAMBDA c6u_ (VEC md) ,(app 'c6u_)))
         (g1 `(VNB-LAMBDA c6i_ ,I ,(app `(,f c6i_))))
         (hf (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x I) (dk-contains? x '(VEC md)))) "f typing"))
         (cmv `(CARR ,c6-mv)))
    (dk-cite! 'interval-in-set 1 n) (dk-cite! 'interval-card-in-nn 1 n)
    (dk-have! `(FORALL c6x_ (IMPLIES (IN c6x_ ,cmv) (IN (,chi c6x_) CC)))
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-rewrite-h! `(IN ,x ,cmv) cmv '(VEC md))
          (if l? (c6-wv! x y) (c6-wv! y x)) (c6-uc-cc! (app x))
          (if (not (dk-lam-b!)) (dk-close-if-asm!)))))
    (dk-have! `(FORALL c6x_ (IMPLIES (IN c6x_ ,cmv) (FORALL c6y_ (IMPLIES (IN c6y_ ,cmv)
                 (= (,chi ((OPR ,c6-mv) c6x_ c6y_)) (* (,chi c6x_) (,chi c6y_)))))))
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (x (cadr (cadr (cadr g)))) (x2 (caddr (cadr (cadr g)))))
          (dk-rewrite-h! `(IN ,x ,cmv) cmv '(VEC md)) (dk-rewrite-h! `(IN ,x2 ,cmv) cmv '(VEC md))
          (subst `(= (OPR ,c6-mv) (VADD md)))
          (dk-cite! 'module-vadd-type 'md x x2)
          (dk-lam-b!)
          (c6-conj-eq! (c6-e-add 'md 'w) (list x x2 y) (if l? 1 2))
          (dk-close-if-asm!))))
    (dk-have! `(= (,chi (IDEN ,c6-mv)) 1)
      (lambda ()
        (subst `(= (IDEN ,c6-mv) (VZERO md)))
        (dk-lam-b!)
        (dk-cite! (if l? 'c6-w-zero-l 'c6-w-zero-r) 'kf 'md 'w y)
        (dk-close-if-asm!)))
    (dk-have! `(FORALL z (IMPLIES (IN z ,I) (IN (,f z) ,cmv)))
      (lambda () (let ((z (dk-di-var!))) (dk-apply! hf z) (subst `(= ,cmv (VEC md))) (dk-close-if-asm!))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,I) (= (,g1 z) (,chi (,f z)))))
      (lambda () (let ((z (dk-di-var!)))
                   (dk-apply! hf z) (if l? (c6-wv! `(,f ,z) y) (c6-wv! y `(,f ,z)))
                   (if (not (dk-lam-b!)) (if (dk-asm? (dk-goal)) (dk-ass!) (rfl))))))
    (let ((e (dk-cite! 'c6-char-finsum n c6-mv chi f g1)))
      (dk-cite! 'finsum-type-ptwise c6-mv I f)
      (dk-rewrite-h! `(IN ,fs ,cmv) cmv '(VEC md))
      (if l? (c6-wv! fs y) (c6-wv! y fs))
      (dk-have! `(= (,chi ,fs) ,(app fs)) (lambda () (if (not (dk-lam-b!)) (rfl))))
      (dk-rewrite-h! e `(,chi ,fs) (app fs))
      (dk-close-if-asm!)))
  (c6-dump!)
  (qed name))
(c6-fs! 'l 'c6-w-finsum-l)
(c6-fs! 'r 'c6-w-finsum-r)

;; (66), the double product
(sp (make-wff (c6-eb-stmt `(FORALL n (IMPLIES (IN n NN) (FORALL f (IMPLIES (FORALL z (IMPLIES (IN z (INTERVAL 1 n)) (IN (f z) (VEC md))))
  (FORALL h (IMPLIES (FORALL z (IMPLIES (IN z (INTERVAL 1 n)) (IN (h z) (VEC md))))
    (= (w (FINSUM ,c6-mv f (INTERVAL 1 n)) (FINSUM ,c6-mv h (INTERVAL 1 n)))
       (FINSUM ,c6-cm (VNB-LAMBDA c6i_ (INTERVAL 1 n) (FINSUM ,c6-cm (VNB-LAMBDA c6j_ (INTERVAL 1 n) (w (f c6i_) (h c6j_))) (INTERVAL 1 n)))
               (INTERVAL 1 n))))))))))))
(c6-eb-setup!)
(c6-cm!)
(let* ((gl (dk-goal)) (fsf (cadr (cadr gl))) (fsh (caddr (cadr gl))) (n (caddr (cadddr fsf))) (I `(INTERVAL 1 ,n))
       (f (caddr fsf)) (h (caddr fsh)) (G (caddr (caddr gl)))
       (cmv `(CARR ,c6-mv))
       (hh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x I) (dk-contains? x `(,h z)))) "h typing"))
       (hf (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x I) (dk-contains? x `(,f z)))) "f typing")))
  (dk-cite! 'interval-in-set 1 n) (dk-cite! 'interval-card-in-nn 1 n)
  (dk-have! `(FORALL z (IMPLIES (IN z ,I) (IN (,h z) ,cmv)))
    (lambda () (let ((z (dk-di-var!))) (dk-apply! hh z) (subst `(= ,cmv (VEC md))) (dk-close-if-asm!))))
  (dk-cite! 'finsum-type-ptwise c6-mv I h)
  (dk-rewrite-h! `(IN ,fsh ,cmv) cmv '(VEC md))
  (let* ((e1 (dk-cite! 'c6-w-finsum-l 'kf 'md 'w n f fsh))
         (g1 (caddr (caddr e1))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,I) (= (,g1 z) (,G z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-apply! hf z)
          (c6-wv! `(,f ,z) fsh)
          (dk-cite! 'c6-w-finsum-r 'kf 'md 'w n h `(,f ,z))
          (dk-lam-b!)
          (dk-close-if-asm!))))
    (let ((cg (dk-cite! 'finsum-cm-congruence-q c6-cm I g1 G)))
      (dk-rewrite-h! e1 `(FINSUM ,c6-cm ,g1 ,I) `(FINSUM ,c6-cm ,G ,I))
      (dk-close-if-asm!))))
(c6-dump!)
