(sp (make-wff (c6-vs '(FORALL r (IMPLIES (IN r (CARR kf)) (FORALL x (IMPLIES (IN x (VEC md)) (FORALL y (IMPLIES (IN y (VEC md))
  (= ((ACT md) r ((VADD md) x y)) ((VADD md) ((ACT md) r x) ((ACT md) r y))))))))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(c6-in-scal! 'kf 'md 'r)
(dk-cite! 'module-act-distrib-vec 'md 'r 'x 'y)
