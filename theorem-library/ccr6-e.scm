;;; =======================================================================
;;; 4. THE FINITE PRODUCT OF (66): a character of an abelian group, taken at a finite sum over 1..n, is the
;;;    product of its values, the product taken in the multiplicative monoid of CC (CC as a commutative ring).

(define c6-ccv '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define c6-cm `(COMMUTATIVE-RING-MULTIPLICATIVE-CM ,c6-ccv))
(define (c6-cm!)
  (if (not (dk-asm? `(IS-COMM-MONOID ,c6-cm)))
      (begin
        (dk-cite! 'cc-is-normed-field)
        (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
        (dk-cite! 'commutative-ring-multiplicative-cm-is-comm-monoid c6-ccv)
        (dk-cite! 'crmcm-carr c6-ccv) (dk-cite! 'crmcm-iden c6-ccv) (dk-cite! 'crmcm-op c6-ccv)
        (dk-cite! 'cc-scalar-ring-carr) (dk-cite! 'cc-scalar-ring-one) (dk-cite! 'cc-scalar-ring-mul)
        (dk-have! `(= (CARR ,c6-cm) CC) (lambda () (subst `(= (CARR ,c6-cm) (CARR ,c6-ccv))) (subst `(== (CARR ,c6-ccv) CC)) (rfl)))
        (dk-cite! 'cc-is-set) (dk-cite! 'cc-one-in))))
;; (= ((MUL ccv) x y) (* x y)), x, y typed in CC (D2's sdl-op-eq!)
(define (c6-mul-eq! x y)
  (let ((eq `(= ((MUL ,c6-ccv) ,x ,y) (* ,x ,y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! 'cc-scalar-ring-mul))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))

(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL ag (IMPLIES (IS-ABELIAN-GROUP ag) (FORALL chi
  (IMPLIES (FORALL c6x_ (IMPLIES (IN c6x_ (CARR ag)) (IN (chi c6x_) CC)))
    (IMPLIES (FORALL c6x_ (IMPLIES (IN c6x_ (CARR ag)) (FORALL c6y_ (IMPLIES (IN c6y_ (CARR ag))
               (= (chi ((OPR ag) c6x_ c6y_)) (* (chi c6x_) (chi c6y_)))))))
      (IMPLIES (= (chi (IDEN ag)) 1)
        (FORALL f (FORALL g (IMPLIES (FORALL z (IMPLIES (IN z (INTERVAL 1 n)) (IN (f z) (CARR ag))))
          (IMPLIES (FORALL z (IMPLIES (IN z (INTERVAL 1 n)) (= (g z) (chi (f z)))))
            (= (chi (FINSUM ag f (INTERVAL 1 n))) (FINSUM ,c6-cm g (INTERVAL 1 n)))))))))))))))))
(define c6-cases (dk-ni-fixed!))
(dk-focus! (cdr (assq 'base c6-cases)))
(c6-cm!)
(dk-peel!)
(let* ((gl (dk-goal)) (chi (car (cadr gl))) (ag (cadr (cadr (cadr gl)))) (f (caddr (cadr (cadr gl)))) (g (caddr (caddr gl))))
  (subst (dk-cite! 'interval-1-0-empty))
  (subst (dk-cite! 'finsum-empty ag f))
  (subst (dk-cite! 'finsum-empty c6-cm g))
  (subst `(= (IDEN ,c6-cm) (ONE ,c6-ccv)))
  (subst `(== (ONE ,c6-ccv) 1))
  (subst `(= (,chi (IDEN ,ag)) 1))
  (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (dk-ass!) (rfl))))
(dk-focus! (cdr (assq 'step c6-cases)))
(c6-cm!)
(let* ((n (dk-di-var!)) (ih (cadr (dk-goal))))
  (di)
  (dk-peel!)
  (let* ((gl (dk-goal)) (chi (car (cadr gl))) (ag (cadr (cadr (cadr gl)))) (f (caddr (cadr (cadr gl)))) (g (caddr (caddr gl)))
         (sn `(succ ,n)) (In `(INTERVAL 1 ,n)) (Is `(INTERVAL 1 ,sn)) (U `(UNION ,In (PAIR ,sn ,sn)))
         (hf (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x Is) (dk-contains? x `(CARR ,ag)))) "f typing"))
         (hg (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x Is) (dk-contains? x g))) "g = chi f"))
         (hct (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'CC) (not (dk-contains? x 'OPR)))) "chi typing"))
         (hadd (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'OPR) (dk-contains? x chi))) "chi additive"))
         (hfn `(FORALL z (IMPLIES (IN z ,In) (IN (,f z) (CARR ,ag)))))
         (hgn `(FORALL z (IMPLIES (IN z ,In) (= (,g z) (,chi (,f z)))))))
    (dk-cite! 'nn-succ-closed n)
    (dk-cite! 'nn-le-succ n)
    (dk-have! hfn (lambda () (let ((z (dk-di-var!))) (dk-cite! 'interval-widen n sn 1 z) (dk-apply! hf z) (dk-close-if-asm!))))
    (dk-have! hgn (lambda () (let ((z (dk-di-var!))) (dk-cite! 'interval-widen n sn 1 z) (dk-apply! hg z) (dk-close-if-asm!))))
    ;; the induction hypothesis at n
    (let loop ((h ih))
      (if (dk-head-is? h 'IMPLIES)
          (begin (if (not (dk-asm? (caddr h))) (detach! h)) (loop (caddr h)))))
    ;; the finite-sum bookkeeping
    (dk-cite! 'interval-in-set 1 n)
    (dk-cite! 'interval-card-in-nn 1 n)
    (dk-cite! 'membership-implies-sethood sn 'NN)
    (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr sn)
    (dk-have! `(NOT (IN ,sn ,In))
      (lambda ()
        (di)
        (dk-cite! 'interval-hi 1 n sn)
        (dk-have! `(< ,n ,sn) (lambda () (dk-nn!)))
        (dk-absurd! `(< ,n ,sn) `(<= ,sn ,n) `(IN ,n RR) `(IN ,sn RR))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-have! `(<= ,sn ,sn) (lambda () (dk-nn!)))
    (dk-cite! 'interval-mem-intro 1 sn sn)
    (dk-apply! hf sn) (dk-apply! hg sn)
    (dk-cite! 'finsum-type-ptwise ag In f)
    (let ((ins (dk-cite! 'interval-succ-insert n)))
      (dk-rewrite-h! hf Is U)
      (dk-have! `(FORALL z (IMPLIES (IN z ,U) (IN (,g z) (CARR ,c6-cm))))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-rewrite-h! `(IN ,z ,U) U Is)
            (dk-apply! hg z) (dk-apply! hf z) (dk-apply! hct `(,f ,z))
            (subst `(= (CARR ,c6-cm) CC))
            (subst `(= (,g ,z) (,chi (,f ,z))))
            (dk-close-if-asm!))))
      (subst ins))
    (subst (dk-cite! 'finsum-insert-ptwise ag In sn f))
    (subst (dk-apply! hadd `(FINSUM ,ag ,f ,In) `(,f ,sn)))
    (subst (dk-cite! 'finsum-cm-insert-ptwise c6-cm In sn g))
    (subst `(= (FINSUM ,c6-cm ,g ,In) (,chi (FINSUM ,ag ,f ,In))))
    (subst `(= (,g ,sn) (,chi (,f ,sn))))
    (subst `(= (OPR ,c6-cm) (MUL ,c6-ccv)))
    (dk-apply! hct `(FINSUM ,ag ,f ,In)) (dk-apply! hct `(,f ,sn))
    (subst (c6-mul-eq! `(,chi (FINSUM ,ag ,f ,In)) `(,chi (,f ,sn))))
    (if (not (proof-done? *ps*)) (rfl))))
(c6-dump!)
(qed 'c6-char-finsum)

;;; =======================================================================
;;; 5. PROPOSITION 6.24, the entries: for basis vectors e, e' the map (y, x) |-> w_E(y e, x e') is a bilinear
;;;    bicharacter on K, so by 6.20 it is w_K(a y, x) for a unique a (the entry a_ij of (66)).

(define (c6-wij e e2) `(VNB-LAMBDA (LIST c6s_ c6t_) (CARTESIAN (CARR kf) (CARR kf)) (w ((ACT md) c6s_ ,e) ((ACT md) c6t_ ,e2))))
(define c6-Wij (c6-wij 'e 'e2))
(define (c6-e-line kf md w)
  `(FORALL c6vx_ (IMPLIES (IN c6vx_ (VEC ,md)) (FORALL c6vy_ (IMPLIES (IN c6vy_ (VEC ,md))
     (AND (IS-ADD-CHARACTER ,kf (VNB-LAMBDA c6va_ (CARR ,kf) (,w ((ACT ,md) c6va_ c6vx_) c6vy_)))
          (IS-ADD-CHARACTER ,kf (VNB-LAMBDA c6va_ (CARR ,kf) (,w c6vy_ ((ACT ,md) c6va_ c6vx_))))))))))
(define (c6-e-type md w) `(IN ,w (FUN (CARTESIAN (VEC ,md) (VEC ,md)) UNIT-CIRCLE)))
(define (c6-ebil-parts! kf md w)
  (let ((hb `(IS-E-BILINEAR-BICHARACTER ,kf ,md ,w)) (hc `(IS-E-BICHARACTER ,kf ,md ,w)))
    (dk-project! hc 'is-e-bilinear-bicharacter hb)
    (dk-project! (c6-e-type md w) 'is-e-bicharacter hc)
    (dk-project! (c6-e-line kf md w) 'is-e-bicharacter hc)
    (dk-project! (c6-bil-law kf md w) 'is-e-bilinear-bicharacter hb)))
(define (c6-ew! a b)                    ; a, b in CARR kf: land w(a e, b e2) in UNIT-CIRCLE
  (dk-cite! 'c6-act-in 'kf 'md a 'e) (dk-cite! 'c6-act-in 'kf 'md b 'e2)
  (c6-app2! 'w '(VEC md) '(VEC md) 'UNIT-CIRCLE `((ACT md) ,a e) `((ACT md) ,b e2)))
(define (c6-e-stmt body)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md)
     (FORALL w (IMPLIES (IS-E-BILINEAR-BICHARACTER kf md w)
       (FORALL e (IMPLIES (IN e (VEC md)) (FORALL e2 (IMPLIES (IN e2 (VEC md)) ,body)))))))))))
(define (c6-e-setup!)
  (dk-peel!)
  (c6-vs! 'kf 'md)
  (dk-cite! 'nf-one-in-carr 'kf)
  (dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf))
  (c6-ebil-parts! 'kf 'md 'w))

;; the value of W_ij
(sp (make-wff (c6-e-stmt `(FORALL y (IMPLIES (IN y (CARR kf)) (FORALL x (IMPLIES (IN x (CARR kf))
  (= (,c6-Wij y x) (w ((ACT md) y e) ((ACT md) x e2))))))))))
(c6-e-setup!)
(let* ((g (dk-goal)) (y (cadr (cadr g))) (x (caddr (cadr g))))
  (c6-ew! y x)
  (if (not (dk-lam-b!)) (rfl)))
(c6-dump!)
(qed 'c6-wij-value)

(define (c6-wij-close!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (dk-ass!))
      ((dk-head-is? g 'AND) (dk-conj-close! c6-wij-close!))
      ((dk-head-is? g 'FORALL) (dk-peel!) (c6-wij-close!))
      ((dk-head-is? g 'IS-BILINEAR-BICHARACTER) (mac 'is-bilinear-bicharacter) (c6-wij-close!))
      ((dk-head-is? g 'IS-BICHARACTER) (mac 'is-bicharacter) (c6-wij-close!))
      ((dk-head-is? g 'IN)
       (dk-lam-type!
         (lambda ()
           (dk-peel!)
           (let* ((t (cadr (dk-goal))) (a (cadr (cadr t))) (b (cadr (caddr t))))
             (c6-ew! a b)
             (dk-close-if-asm!)))
         (lambda () (dk-set-close! '(CARTESIAN (CARR kf) (CARR kf))))))
      ((dk-head-is? g 'IS-ADD-CHARACTER)
       ;; lam chx. W(chx, y) or lam chx. W(y, chx): the line character of w at e (resp. e2)
       (let* ((lch (caddr g)) (app (cadddr lch)) (first? (eq? (cadr app) (cadr lch)))
              (y (if first? (caddr app) (cadr app)))
              (yv (if first? `((ACT md) ,y e2) `((ACT md) ,y e)))
              (_ (dk-cite! 'c6-act-in 'kf 'md y (if first? 'e2 'e)))
              (two (dk-apply! (c6-e-line 'kf 'md 'w) (if first? 'e 'e2) yv))
              (ac (if first? (cadr two) (caddr two)))
              (_2 (if (not (dk-asm? ac)) (dk-have! ac (lambda () (dk-split-all!) (dk-close-if-asm!)))))
              (lrh (caddr ac)))
         (dk-project! `(IN ,lrh (FUN (CARR kf) UNIT-CIRCLE)) 'is-add-character ac)
         (dk-fun-ext! lch lrh '(CARR kf) 'UNIT-CIRCLE
           (lambda ()
             (dk-lam-type!
               (lambda ()
                 (let* ((b (dk-di-var!)))
                   (if first? (c6-ew! b y) (c6-ew! y b))
                   (if first? (dk-cite! 'c6-wij-value 'kf 'md 'w 'e 'e2 b y) (dk-cite! 'c6-wij-value 'kf 'md 'w 'e 'e2 y b))
                   (subst (if first? `(= (,c6-Wij ,b ,y) (w ((ACT md) ,b e) ((ACT md) ,y e2)))
                                     `(= (,c6-Wij ,y ,b) (w ((ACT md) ,y e) ((ACT md) ,b e2)))))
                   (dk-close-if-asm!)))
               (lambda () (dk-close-if-asm!))))
           #f
           (lambda (b)
             (if first? (c6-ew! b y) (c6-ew! y b))
             (if (not (dk-lam-b!)) (if (dk-asm? (dk-goal)) (dk-ass!) (rfl)))))
         (subst `(= ,lch ,lrh))
         (dk-ass!)))
      ((dk-head-is? g '=)
       ;; W(a x, y) = W(x, a y)
       (let* ((p (cadr (cadr g))) (y (caddr (cadr g))) (a (cadr p)) (x (caddr p)) (ay (caddr (caddr g))))
         (dk-cite! 'nf-mul-in-carr 'kf a x) (dk-cite! 'nf-mul-in-carr 'kf a y)
         (c6-ew! p y) (c6-ew! x ay)
         (subst (dk-cite! 'c6-wij-value 'kf 'md 'w 'e 'e2 p y))
         (subst (dk-cite! 'c6-wij-value 'kf 'md 'w 'e 'e2 x ay))
         (dk-cite! 'c6-act-in 'kf 'md x 'e) (dk-cite! 'c6-act-in 'kf 'md y 'e2)
         (subst (dk-cite! 'c6-act-mul 'kf 'md a x 'e))
         (subst (dk-cite! 'c6-act-mul 'kf 'md a y 'e2))
         (dk-apply! (c6-bil-law 'kf 'md 'w) a `((ACT md) ,x e) `((ACT md) ,y e2))
         (dk-close-if-asm!)))
      (#t (error "c6-wij-close!: unexpected goal" (expression->string g))))))

(sp (make-wff (c6-e-stmt `(IS-BILINEAR-BICHARACTER kf ,c6-Wij))))
(c6-e-setup!)
(c6-wij-close!)
(c6-dump!)
(qed 'c6-wij-bilinear)

(define (c6-rel a) `(FORALL y (IMPLIES (IN y (CARR kf)) (FORALL x (IMPLIES (IN x (CARR kf))
                      (= (w ((ACT md) y e) ((ACT md) x e2)) ((BICHAR-OF kf chi c) ((MUL kf) ,a y) x)))))))
(define (c6-relw a) `(FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                       (= (,c6-Wij x eta) ((BICHAR-OF kf chi c) ((MUL kf) ,a x) eta)))))))
;; Proposition 6.24, the entries, K local: w_E(y e, x e') = w_K(a y, x) for a unique a, w_K = BICHAR-OF(chi, c)
(sp (make-wff `(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw) (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi)
  (FORALL c (IMPLIES (IN c (CARR kf)) (IMPLIES (NOT (= c (ZERO kf)))
    (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md) (FORALL w (IMPLIES (IS-E-BILINEAR-BICHARACTER kf md w)
      (FORALL e (IMPLIES (IN e (VEC md)) (FORALL e2 (IMPLIES (IN e2 (VEC md))
        (AND (FORSOME c6a_ (AND (IN c6a_ (CARR kf)) ,(c6-rel 'c6a_)))
             (FORALL c6a_ (IMPLIES (IN c6a_ (CARR kf)) (FORALL c6b_ (IMPLIES (IN c6b_ (CARR kf))
               (IMPLIES ,(c6-rel 'c6a_) (IMPLIES ,(c6-rel 'c6b_) (= c6a_ c6b_))))))))))))))))))))))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(c6-vs! 'kf 'md)
(c6-ebil-parts! 'kf 'md 'w)
(dk-cite! 'c6-wij-bilinear 'kf 'md 'w 'e 'e2)
(let* ((r (dk-cite! 'ccr-6-20-local 'kf 'uw 'chi 'c c6-Wij))
       (ex (cadr r)) (uq (caddr r))
       (relw! (lambda (a rel)
