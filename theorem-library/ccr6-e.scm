;;; 3. PROPOSITION 6.32: bilinear bicharacters on E as K-bilinear maps.

;; land (IN (F A B) COD) from F in FUN(CARTESIAN(D1, D2), COD), A in D1, B in D2
(define (c6-app2! f d1 d2 cod a b)
  (let ((g `(IN (,f ,a ,b) ,cod)))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-cite! 'pair-in-cartesian d1 d2 a b)
            (dk-cite! 'fun-apply-type-c f `(CARTESIAN ,d1 ,d2) cod `(LIST ,a ,b))
            (subst (dk-cite! 'apply-tupling-2 f a b))
            (dk-ass!))))
    g))
(define (c6-wk-type kf wk) `(IN ,wk (FUN (CARTESIAN (CARR ,kf) (CARR ,kf)) UNIT-CIRCLE)))
(define (c6-bil-k kf wk)
  `(FORALL cha_ (IMPLIES (IN cha_ (CARR ,kf)) (FORALL chx_ (IMPLIES (IN chx_ (CARR ,kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,kf))
     (= (,wk ((MUL ,kf) cha_ chx_) chy_) (,wk chx_ ((MUL ,kf) cha_ chy_))))))))))
(define (c6-bic-r kf wk)
  `(FORALL chy_ (IMPLIES (IN chy_ (CARR ,kf)) (IS-ADD-CHARACTER ,kf (VNB-LAMBDA chx_ (CARR ,kf) (,wk chy_ chx_))))))
(define (c6-bic-l kf wk)
  `(FORALL chy_ (IMPLIES (IN chy_ (CARR ,kf)) (IS-ADD-CHARACTER ,kf (VNB-LAMBDA chx_ (CARR ,kf) (,wk chx_ chy_))))))
;; with IS-BILINEAR-BICHARACTER KF WK in context: land IS-BICHARACTER, the typing, both clauses, the law
(define (c6-wk-parts! kf wk)
  (let ((hb `(IS-BILINEAR-BICHARACTER ,kf ,wk)) (hc `(IS-BICHARACTER ,kf ,wk)))
    (dk-project! hc 'is-bilinear-bicharacter hb)
    (dk-project! (c6-wk-type kf wk) 'is-bicharacter hc)
    (dk-project! (c6-bic-r kf wk) 'is-bicharacter hc)
    (dk-project! (c6-bic-l kf wk) 'is-bicharacter hc)
    (dk-project! (c6-bil-k kf wk) 'is-bilinear-bicharacter hb)))
(define (c6-kbl-type kf md l) `(IN ,l (FUN (CARTESIAN (VEC ,md) (VEC ,md)) (CARR ,kf))))
(define (c6-kbl-add kf md l)
  `(FORALL c6vx_ (IMPLIES (IN c6vx_ (VEC ,md)) (FORALL c6vy_ (IMPLIES (IN c6vy_ (VEC ,md))
     (FORALL c6vz_ (IMPLIES (IN c6vz_ (VEC ,md))
       (AND (= (,l ((VADD ,md) c6vx_ c6vy_) c6vz_) ((ADD ,kf) (,l c6vx_ c6vz_) (,l c6vy_ c6vz_)))
            (= (,l c6vz_ ((VADD ,md) c6vx_ c6vy_)) ((ADD ,kf) (,l c6vz_ c6vx_) (,l c6vz_ c6vy_)))))))))))
(define (c6-kbl-hom kf md l)
  `(FORALL c6va_ (IMPLIES (IN c6va_ (CARR ,kf)) (FORALL c6vx_ (IMPLIES (IN c6vx_ (VEC ,md)) (FORALL c6vy_ (IMPLIES (IN c6vy_ (VEC ,md))
     (AND (= (,l ((ACT ,md) c6va_ c6vx_) c6vy_) ((MUL ,kf) c6va_ (,l c6vx_ c6vy_)))
          (= (,l c6vx_ ((ACT ,md) c6va_ c6vy_)) ((MUL ,kf) c6va_ (,l c6vx_ c6vy_)))))))))))
(define (c6-kbl-parts! kf md l)
  (let ((h `(IS-K-BILINEAR-FORM ,kf ,md ,l)))
    (dk-project! (c6-kbl-type kf md l) 'is-k-bilinear-form h)
    (dk-project! (c6-kbl-add kf md l) 'is-k-bilinear-form h)
    (dk-project! (c6-kbl-hom kf md l) 'is-k-bilinear-form h)))
;; the I-th (1 or 2) equation of a conjunctive law instance
(define (c6-conj-eq! law args i)
  (let* ((c (apply dk-apply! law args)) (e (if (= i 1) (cadr c) (caddr c))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-split-all!) (dk-close-if-asm!))))
    e))

;; w(a l, 1) = w(l, a) for a bilinear bicharacter on K
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL wk (IMPLIES (IS-BILINEAR-BICHARACTER kf wk)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL l (IMPLIES (IN l (CARR kf))
    (= (wk ((MUL kf) a l) (ONE kf)) (wk l a))))))))))))
(dk-peel!)
(dk-cite! 'nf-one-in-carr 'kf)
(c6-wk-parts! 'kf 'wk)
(let ((eq (dk-apply! (c6-bil-k 'kf 'wk) 'a 'l '(ONE kf))))
  (dk-have! '(= ((MUL kf) a (ONE kf)) a) (lambda () (c6-crs! 'kf '(a))))
  (subst eq)
  (subst '(= ((MUL kf) a (ONE kf)) a))
  (c6-app2! 'wk '(CARR kf) '(CARR kf) 'UNIT-CIRCLE 'l 'a)
  (rfl))
(c6-dump!)
(qed 'c6-wk-swap)

;; 6.32, uniqueness: two K-bilinear maps with w_K(lam(u, v), 1) = w_K(lam'(u, v), 1) agree
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL wk (IMPLIES (IS-BILINEAR-BICHARACTER kf wk) (IMPLIES (IS-FAITHFUL-BICHARACTER kf wk)
  (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md) (FORALL lmb (FORALL lmc (IMPLIES (IS-K-BILINEAR-FORM kf md lmb) (IMPLIES (IS-K-BILINEAR-FORM kf md lmc)
    (IMPLIES (FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md)) (= (wk (lmb u v) (ONE kf)) (wk (lmc u v) (ONE kf)))))))
      (FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md)) (= (lmb u v) (lmc u v))))))))))))))))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(dk-cite! 'nf-one-in-carr 'kf)
(c6-wk-parts! 'kf 'wk)
(c6-kbl-parts! 'kf 'md 'lmb)
(c6-kbl-parts! 'kf 'md 'lmc)
(let* ((gl (dk-goal)) (u (cadr (cadr gl))) (v (caddr (cadr gl)))
       (l (cadr gl)) (l2 (caddr gl))
       (h70 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'lmb) (dk-contains? f 'lmc) (dk-contains? f '(ONE kf)))) "(70)"))
       (vm '(VEC md)) (ck '(CARR kf))
       (fc (dk-project! '(FORALL c5c_ (IMPLIES (IS-ADD-CHARACTER kf c5c_)
                (AND (FORSOME c5x_ (AND (IN c5x_ (CARR kf))
                       (AND (= c5c_ (VNB-LAMBDA c5h_ (CARR kf) (wk c5h_ c5x_)))
                            (FORALL c5y_ (IMPLIES (IN c5y_ (CARR kf))
                              (IMPLIES (= c5c_ (VNB-LAMBDA c5h_ (CARR kf) (wk c5h_ c5y_))) (= c5y_ c5x_)))))))
                     (FORSOME c5x_ (AND (IN c5x_ (CARR kf))
                       (AND (= c5c_ (VNB-LAMBDA c5h_ (CARR kf) (wk c5x_ c5h_)))
                            (FORALL c5y_ (IMPLIES (IN c5y_ (CARR kf))
                              (IMPLIES (= c5c_ (VNB-LAMBDA c5h_ (CARR kf) (wk c5y_ c5h_))) (= c5y_ c5x_))))))))))
              'is-faithful-bicharacter '(IS-FAITHFUL-BICHARACTER kf wk))))
  (c6-app2! 'lmb vm vm ck u v)
  (c6-app2! 'lmc vm vm ck u v)
  (let* ((ac2 (dk-apply! (c6-bic-r 'kf 'wk) l2))
         (c2 (caddr ac2))
         (lam-of (lambda (y) `(VNB-LAMBDA c5h_ (CARR kf) (wk ,y c5h_))))
         (ext! (lambda (y ptwise)
                 (dk-project! `(IN ,c2 (FUN (CARR kf) UNIT-CIRCLE)) 'is-add-character ac2)
                 (dk-fun-ext! c2 (lam-of y) ck 'UNIT-CIRCLE #f
                   (lambda ()
                     (let ((ay (dk-apply! (c6-bic-r 'kf 'wk) y)))
                       (dk-project! `(IN ,(caddr ay) (FUN (CARR kf) UNIT-CIRCLE)) 'is-add-character ay))
                     (dk-close-if-asm!))
                   ptwise))))
    (let* ((both (dk-apply! fc c2))
           (ex2 (caddr both)))
      (if (not (dk-asm? ex2)) (dk-have! ex2 (lambda () (dk-split-all!) (dk-close-if-asm!))))
      (let* ((x0 (dk-skolem! ex2))
             (uq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f x0) (dk-contains? f 'c5y_))) "uniqueness")))
        ;; c2 = lam y. w(l2, y)
        (ext! l2 (lambda (b) (if (not (dk-lam-b!)) (begin (c6-app2! 'wk ck ck 'UNIT-CIRCLE l2 b) (rfl)))))
        ;; c2 = lam y. w(l, y)
        (ext! l (lambda (b)
                  (dk-lam-b!)
                  (let ((ab `((ACT md) ,b ,u)))
                    (dk-cite! 'c6-act-in 'kf 'md b u)
                    (dk-cite! 'c6-wk-swap 'kf 'wk b l)
                    (dk-cite! 'c6-wk-swap 'kf 'wk b l2)
                    (c6-conj-eq! (c6-kbl-hom 'kf 'md 'lmb) (list b u v) 1)
                    (c6-conj-eq! (c6-kbl-hom 'kf 'md 'lmc) (list b u v) 1)
                    (dk-apply! h70 ab v)
                    (subst `(= (wk ,l2 ,b) (wk ((MUL kf) ,b ,l2) (ONE kf))))
                    (subst `(= (wk ,l ,b) (wk ((MUL kf) ,b ,l) (ONE kf))))
                    (subst `(= ((MUL kf) ,b ,l2) (lmc ,ab ,v)))
                    (subst `(= ((MUL kf) ,b ,l) (lmb ,ab ,v)))
                    (subst `(= (wk (lmb ,ab ,v) (ONE kf)) (wk (lmc ,ab ,v) (ONE kf))))
                    (c6-app2! 'lmc vm vm ck ab v)
                    (c6-app2! 'wk ck ck 'UNIT-CIRCLE `(lmc ,ab ,v) '(ONE kf))
                    (rfl))))
        (dk-apply! uq l2)
        (dk-apply! uq l)
        (subst `(= ,l ,x0))
        (subst `(= ,l2 ,x0))
        (rfl)))))
(c6-dump!)
(qed 'ccr-6-32-unique)

;;; 6.32, the converse: w_E(u, v) = w_K(lam(u, v), 1) is a bilinear bicharacter on E with (69)

;; w(a + b, y) = w(a, y) w(b, y) and w(y, a + b) = w(y, a) w(y, b) for a bicharacter on K
(define (c6-wk-add-stmt side)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL wk (IMPLIES (IS-BILINEAR-BICHARACTER kf wk)
     (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL b (IMPLIES (IN b (CARR kf)) (FORALL y (IMPLIES (IN y (CARR kf))
       ,(if (eq? side 'l)
            '(= (wk ((ADD kf) a b) y) (* (wk a y) (wk b y)))
            '(= (wk y ((ADD kf) a b)) (* (wk y a) (wk y b)))))))))))))))
(define (c6-wk-add! side name)
  (sp (make-wff (c6-wk-add-stmt side)))
  (dk-peel!)
  (c6-wk-parts! 'kf 'wk)
  (dk-cite! 'nf-add-in-carr 'kf 'a 'b)
  (let* ((ac (dk-apply! (if (eq? side 'l) (c6-bic-l 'kf 'wk) (c6-bic-r 'kf 'wk)) 'y))
         (chi (caddr ac))
         (app (lambda (t) (if (eq? side 'l) `(wk ,t y) `(wk y ,t))))
         (ck '(CARR kf)))
    (c5-hom-local! 'kf chi)
    (for-each (lambda (t)
                (if (eq? side 'l) (c6-app2! 'wk ck ck 'UNIT-CIRCLE t 'y) (c6-app2! 'wk ck ck 'UNIT-CIRCLE 'y t))
                (dk-have! `(= (,chi ,t) ,(app t)) (lambda () (if (not (dk-lam-b!)) (rfl)))))
              '(a b ((ADD kf) a b)))
    (let ((add (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f chi) (dk-contains? f '*))) "additivity")))
      (dk-apply! add 'a 'b)
      (subst `(= ,(app '((ADD kf) a b)) (,chi ((ADD kf) a b))))
      (subst `(= ,(app 'a) (,chi a)))
      (subst `(= ,(app 'b) (,chi b)))
      (dk-ass!)))
  (c6-dump!)
  (qed name))
(define (c5-hom-local! kf chi)
  (dk-project! `(IN ,chi (FUN (CARR ,kf) UNIT-CIRCLE)) 'is-add-character `(IS-ADD-CHARACTER ,kf ,chi))
  (dk-project! `(FORALL chx_ (IMPLIES (IN chx_ (CARR ,kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,kf))
                   (= (,chi ((ADD ,kf) chx_ chy_)) (* (,chi chx_) (,chi chy_)))))))
               'is-add-character `(IS-ADD-CHARACTER ,kf ,chi)))
(c6-wk-add! 'l 'c6-wk-add-l)
(c6-wk-add! 'r 'c6-wk-add-r)

(define c6-W '(VNB-LAMBDA (LIST c6p_ c6q_) (CARTESIAN (VEC md) (VEC md)) (wk (lmb c6p_ c6q_) (ONE kf))))
(define (c6-cv body)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL wk (IMPLIES (IS-BILINEAR-BICHARACTER kf wk)
     (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md) (FORALL lmb (IMPLIES (IS-K-BILINEAR-FORM kf md lmb) ,body)))))))))
(define (c6-cv-setup!)
  (dk-peel!)
  (c6-vs! 'kf 'md)
  (dk-cite! 'nf-one-in-carr 'kf)
  (c6-wk-parts! 'kf 'wk)
  (c6-kbl-parts! 'kf 'md 'lmb))
(define (c6-wl! u v)                    ; land (IN (wk (lmb U V) (ONE kf)) UNIT-CIRCLE)
  (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) u v)
  (c6-app2! 'wk '(CARR kf) '(CARR kf) 'UNIT-CIRCLE `(lmb ,u ,v) '(ONE kf)))

(sp (make-wff (c6-cv `(FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md))
  (= (,c6-W u v) (wk (lmb u v) (ONE kf))))))))))
(c6-cv-setup!)
(let* ((g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
  (c6-wl! u v)
  (if (not (dk-lam-b!)) (rfl)))
(c6-dump!)
(qed 'c6-w-value)

(sp (make-wff (c6-cv `(IN ,c6-W (FUN (CARTESIAN (VEC md) (VEC md)) UNIT-CIRCLE)))))
(c6-cv-setup!)
(dk-cite! 'frm-module-vec-set 'md)
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (t (cadr (cadr g))))
      (c6-wl! (cadr t) (caddr t))
      (dk-close-if-asm!)))
  (lambda () (dk-set-close! '(CARTESIAN (VEC md) (VEC md)))))
(c6-dump!)
(qed 'c6-w-type)

;; (69): w_E(b u, v) = w_K(lam(u, v), b) = w_E(u, b v)
(define (c6-w69! side name)
  (sp (make-wff (c6-cv `(FORALL b (IMPLIES (IN b (CARR kf)) (FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md))
    (= ,(if (eq? side 'l) `(,c6-W ((ACT md) b u) v) `(,c6-W u ((ACT md) b v))) (wk (lmb u v) b)))))))))))
  (c6-cv-setup!)
  (let* ((g (dk-goal)) (rhs (caddr g)) (b (caddr rhs)) (u (cadr (cadr rhs))) (v (caddr (cadr rhs)))
         (bu `((ACT md) ,b ,u)) (bv `((ACT md) ,b ,v)))
    (dk-cite! 'c6-act-in 'kf 'md b (if (eq? side 'l) u v))
    (if (eq? side 'l)
        (begin (dk-cite! 'c6-w-value 'kf 'wk 'md 'lmb bu v)
               (subst `(= (,c6-W ,bu ,v) (wk (lmb ,bu ,v) (ONE kf))))
               (subst (c6-conj-eq! (c6-kbl-hom 'kf 'md 'lmb) (list b u v) 1)))
        (begin (dk-cite! 'c6-w-value 'kf 'wk 'md 'lmb u bv)
               (subst `(= (,c6-W ,u ,bv) (wk (lmb ,u ,bv) (ONE kf))))
               (subst (c6-conj-eq! (c6-kbl-hom 'kf 'md 'lmb) (list b u v) 2))))
    (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) u v)
    (subst (dk-cite! 'c6-wk-swap 'kf 'wk b `(lmb ,u ,v)))
    (c6-app2! 'wk '(CARR kf) '(CARR kf) 'UNIT-CIRCLE `(lmb ,u ,v) b)
    (rfl))
  (c6-dump!)
  (qed name))
(c6-w69! 'l 'c6-w-69-left)
(c6-w69! 'r 'c6-w-69-right)

(define (c6-wapps t)                    ; the applications of W in T
  (cond ((not (pair? t)) '())
        ((equal? (car t) c6-W) (list t))
        (#t (apply append (map c6-wapps t)))))
(define (c6-wval-goal!)                 ; rewrite every W(p, q) in the goal by c6-w-value
  (for-each (lambda (a)
              (subst (dk-cite! 'c6-w-value 'kf 'wk 'md 'lmb (cadr a) (caddr a))))
            (c6-wapps (dk-goal))))
(define (c6-act-term? p) (and (pair? p) (equal? (car p) '(ACT md))))
(define (c6-vadd-term? p) (and (pair? p) (equal? (car p) '(VADD md))))
(define (c6-linechar! lch)                ; goal IS-ADD-CHARACTER kf L, L = lam a. W(a x, y) or W(y, a x)
  (let* ((body (cadddr lch)) (left? (c6-act-term? (cadr body)))
         (ax (if left? (cadr body) (caddr body))) (x (caddr ax)) (y (if left? (caddr body) (cadr body)))
         (lxy (if left? `(lmb ,x ,y) `(lmb ,y ,x)))
         (_ (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) (if left? x y) (if left? y x)))
         (ac (dk-apply! (c6-bic-r 'kf 'wk) lxy))
         (lrh (caddr ac)))
    (dk-project! `(IN ,lrh (FUN (CARR kf) UNIT-CIRCLE)) 'is-add-character ac)
    (dk-fun-ext! lch lrh '(CARR kf) 'UNIT-CIRCLE
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((a (dk-di-var!)) (g (dk-goal)) (t (cadr g)))
              (dk-cite! 'c6-act-in 'kf 'md a x)
              (dk-cite! 'c6-w-type 'kf 'wk 'md 'lmb)
              (c6-app2! c6-W '(VEC md) '(VEC md) 'UNIT-CIRCLE (cadr t) (caddr t))
              (dk-close-if-asm!)))
          (lambda () (dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf)) (dk-close-if-asm!))))
      #f
      (lambda (b)
        (dk-cite! 'c6-act-in 'kf 'md b x)
        (dk-cite! (if left? 'c6-w-69-left 'c6-w-69-right) 'kf 'wk 'md 'lmb b (if left? x y) (if left? y x))
        (c6-app2! 'wk '(CARR kf) '(CARR kf) 'UNIT-CIRCLE lxy b)
        (if (not (dk-lam-b!))
            (begin
              (if (pair? (c6-wapps (dk-goal)))
                  (subst (if left? `(= (,c6-W ((ACT md) ,b ,x) ,y) (wk ,lxy ,b)) `(= (,c6-W ,y ((ACT md) ,b ,x)) (wk ,lxy ,b))))
                  (begin
                    (subst (c6-conj-eq! (c6-kbl-hom 'kf 'md 'lmb) (if left? (list b x y) (list b y x)) (if left? 1 2)))
                    (subst (dk-cite! 'c6-wk-swap 'kf 'wk b lxy))))
              (if (and (pair? (dk-open-leaves)) (not (dk-asm? (dk-goal)))) (rfl) (dk-close-if-asm!))))))
    (subst `(= ,lch ,lrh))
    (dk-ass!)))
(define (c6-cv-close!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (dk-ass!))
      ((dk-head-is? g 'AND) (dk-conj-close! c6-cv-close!))
      ((dk-head-is? g 'FORALL) (dk-peel!) (c6-cv-close!))
      ((dk-head-is? g 'IS-E-BILINEAR-BICHARACTER) (mac 'is-e-bilinear-bicharacter) (c6-cv-close!))
      ((dk-head-is? g 'IS-E-BICHARACTER) (mac 'is-e-bicharacter) (c6-cv-close!))
      ((dk-head-is? g 'IS-ADD-CHARACTER) (c6-linechar! (caddr g)))
      ((dk-head-is? g 'IN) (dk-cite! 'c6-w-type 'kf 'wk 'md 'lmb) (dk-close-if-asm!))
      ((and (dk-head-is? g '=) (pair? (c6-wapps (caddr g))) (pair? (c6-wapps (cadr g))))
       ;; bilinearity W(a x, y) = W(x, a y), or additivity W(x + y, z) = W(x, z) W(y, z)
       (let* ((lw (cadr g)) (p (cadr lw)) (q (caddr lw)))
         (cond
           ((c6-act-term? p)
            (let ((a (cadr p)) (x (caddr p)) (y q))
              (subst (dk-cite! 'c6-w-69-left 'kf 'wk 'md 'lmb a x y))
              (subst (dk-cite! 'c6-w-69-right 'kf 'wk 'md 'lmb a x y))
              (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) x y)
              (c6-app2! 'wk '(CARR kf) '(CARR kf) 'UNIT-CIRCLE `(lmb ,x ,y) a)
              (rfl)))
           (#t
            (let* ((left? (c6-vadd-term? p)) (s (if left? p q)) (x (cadr s)) (y (caddr s)) (z (if left? q p)))
              (dk-cite! 'module-vadd-type 'md x y)
              (c6-wval-goal!)
              (subst (c6-conj-eq! (c6-kbl-add 'kf 'md 'lmb) (list x y z) (if left? 1 2)))
              (let ((A (if left? `(lmb ,x ,z) `(lmb ,z ,x))) (B (if left? `(lmb ,y ,z) `(lmb ,z ,y))))
                (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) (cadr A) (caddr A))
                (c6-app2! 'lmb '(VEC md) '(VEC md) '(CARR kf) (cadr B) (caddr B))
                (dk-cite! 'c6-wk-add-l 'kf 'wk A B '(ONE kf))
                (dk-ass!)))))))
      ((dk-head-is? g '=)
       ;; (69) or (70)
       (let* ((lw (cadr g)) (p (cadr lw)) (q (caddr lw)))
         (cond ((c6-act-term? p) (dk-cite! 'c6-w-69-left 'kf 'wk 'md 'lmb (cadr p) (caddr p) q))
               ((c6-act-term? q) (dk-cite! 'c6-w-69-right 'kf 'wk 'md 'lmb (cadr q) p (caddr q)))
               (#t (dk-cite! 'c6-w-value 'kf 'wk 'md 'lmb p q)))
         (dk-close-if-asm!)))
      (#t (error "c6-cv-close!: unexpected goal" (expression->string g))))))

(sp (make-wff (c6-cv '(FORSOME c6we_ (AND (IS-E-BILINEAR-BICHARACTER kf md c6we_)
  (AND (FORALL b (IMPLIES (IN b (CARR kf)) (FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md))
         (AND (= (c6we_ ((ACT md) b u) v) (wk (lmb u v) b)) (= (c6we_ u ((ACT md) b v)) (wk (lmb u v) b)))))))))
       (FORALL u (IMPLIES (IN u (VEC md)) (FORALL v (IMPLIES (IN v (VEC md)) (= (c6we_ u v) (wk (lmb u v) (ONE kf)))))))))))))
(c6-cv-setup!)
(ew c6-W)
(c6-cv-close!)
(c6-dump!)
