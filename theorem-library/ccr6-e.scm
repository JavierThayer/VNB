;; membership in a polar and in a norm ball, as theorems (mac-h cannot open a functoid by its name)
(sp (make-wff '(FORALL md (FORALL w (FORALL vv (FORALL h (IFF (IN h (E-POLAR md w vv))
  (AND (IN h (VEC md)) (FORALL x (IMPLIES (IN x vv) (= (w h x) 1)))))))))))
(dk-peel!)
(mac 'e-polar)
(dk-iff! (lambda (gl) (dk-head-is? gl 'AND))
  (lambda ()
    (let ((s (dk-pick (lambda (f) (dk-head-is? f 'IN)) "the membership")))
      (dk-landed (lambda () (sep-me s)))
      (dk-conj-close! (lambda () (dk-ass!)))))
  (lambda ()
    (dk-split! (dk-pick (lambda (f) (dk-head-is? f 'AND)) "the conjunction"))
    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(qed 'c6-epolar-mem)

(sp (make-wff '(FORALL md (FORALL nu (FORALL r (FORALL x (IFF (IN x (NORM-BALL md nu r)) (AND (IN x (VEC md)) (<= (nu x) r)))))))))
(dk-peel!)
(mac 'norm-ball)
(dk-iff! (lambda (gl) (dk-head-is? gl 'AND))
  (lambda ()
    (let ((s (dk-pick (lambda (f) (dk-head-is? f 'IN)) "the membership")))
      (dk-landed (lambda () (sep-me s)))
      (dk-conj-close! (lambda () (dk-ass!)))))
  (lambda ()
    (dk-split! (dk-pick (lambda (f) (dk-head-is? f 'AND)) "the conjunction"))
    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(qed 'c6-ball-mem)

;; the bilinearity law of IS-E-BILINEAR-BICHARACTER(KF, MD, W), as the definition states it
(define (c6-bil-law kf md w)
  `(FORALL c6va_ (IMPLIES (IN c6va_ (CARR ,kf)) (FORALL c6vx_ (IMPLIES (IN c6vx_ (VEC ,md)) (FORALL c6vy_ (IMPLIES (IN c6vy_ (VEC ,md))
     (= (,w ((ACT ,md) c6va_ c6vx_) c6vy_) (,w c6vx_ ((ACT ,md) c6va_ c6vy_))))))))))
;; the parts of IS-NORM-ON
(define (c6-norm-on-parts! kf md nu)
  (let ((h `(IS-NORM-ON ,kf ,md ,nu)))
    (dk-project! `(IS-MODULE ,md) 'is-norm-on h)
    (dk-project! `(= (SCAL ,md) (NORMED-FIELD-AS-COMMUTATIVE-RING ,kf)) 'is-norm-on h)
    (dk-project! `(IN ,nu (FUN (VEC ,md) RR)) 'is-norm-on h)
    (dk-project! `(FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC ,md)) (<= 0 (,nu zkvx_)))) 'is-norm-on h)
    (dk-project! `(FORALL zkvr_ (IMPLIES (IN zkvr_ (CARR ,kf)) (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC ,md))
                    (= (,nu ((ACT ,md) zkvr_ zkvx_)) (* ((FNRM ,kf) zkvr_) (,nu zkvx_))))))) 'is-norm-on h)))
(define (c6-nu! nu md x)               ; X in VEC MD: land NU(X) in RR and 0 <= NU(X)
  (if (not (dk-asm? `(IN (,nu ,x) RR)))
      (begin
        (dk-have-and! `(IN ,nu (FUN (VEC ,md) RR)) `(IN ,x (VEC ,md)))
        (dk-cite! 'fun-apply-type nu `(VEC ,md) 'RR x)))
  (if (not (dk-asm? `(<= 0 (,nu ,x))))
      (dk-apply! `(FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC ,md)) (<= 0 (,nu zkvx_)))) x))
  `(,nu ,x))
(define (c6-rr-mul! p q)
  (dk-have-and! `(IN ,p RR) `(IN ,q RR))
  (dk-cite! 'rr-mul-closed p q))

;; Proposition 6.30 (membership form, any c /= 0 in place of uw^k): for a unipolar w on E,
;; eta in pol_w B(|c|) iff nu(c eta) <= 1, i.e. pol_w B(s) = B(1/s) with s = |c|
(define c6-nc '((FNRM kf) c))
(define c6-b1 '(NORM-BALL md nu 1))
(define c6-bc `(NORM-BALL md nu ,c6-nc))
(define c6-ce '((ACT md) c eta))
;; x in B(1): c x in B(|c|)
(define (c6-630-scale-in! hom x)
  (let* ((nc c6-nc) (cx `((ACT md) c ,x)) (nx `(nu ,x)))
    (c6-iff-fwd! (dk-cite! 'c6-ball-mem 'md 'nu 1 x))
    (dk-cite! 'c6-act-in 'kf 'md 'c x)
    (c6-nu! 'nu 'md x) (c6-nu! 'nu 'md cx)
    (dk-apply! hom 'c x)
    (dk-cite! 'rr-mul-le-right nx 1 nc)
    (c6-rr-mul! nc nx) (c6-rr-mul! nx nc) (c6-rr-mul! 1 nc)
    (dk-have! `(= (* ,nc ,nx) (* ,nx ,nc)) (lambda () (crs)))
    (dk-have! `(= (* 1 ,nc) ,nc) (lambda () (crs)))
    (dk-have! `(<= (nu ,cx) ,nc)
      (lambda () (dk-ineq! `(= (nu ,cx) (* ,nc ,nx)) `(= (* ,nc ,nx) (* ,nx ,nc)) `(<= (* ,nx ,nc) (* 1 ,nc)) `(= (* 1 ,nc) ,nc))))
    (c6-iff-bwd! (dk-cite! 'c6-ball-mem 'md 'nu nc cx))
    cx))
;; forward: c eta is in pol B(1) = B(1)
(define (c6-630-fwd! bil hom)
  (c6-iff-fwd! (dk-cite! 'c6-epolar-mem 'md 'w c6-bc 'eta))
  (let ((pl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'NORM-BALL))) "polarity")))
    (c6-iff-bwd! (dk-cite! 'c6-epolar-mem 'md 'w c6-b1 c6-ce)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((x (dk-di-var!)) (cx (c6-630-scale-in! hom x)))
                  (dk-apply! pl cx)
                  (subst (dk-apply! bil 'c 'eta x))
                  (dk-ass!)))))))
    (dk-rewrite-h! `(IN ,c6-ce (E-POLAR md w ,c6-b1)) `(E-POLAR md w ,c6-b1) c6-b1)
    (c6-iff-fwd! (dk-cite! 'c6-ball-mem 'md 'nu 1 c6-ce))
    (dk-ass!)))
;; xi in B(|c|), d c = 1: d xi in B(1)
(define (c6-630-unscale-in! hom d xi)
  (let* ((nc c6-nc) (nd `((FNRM kf) ,d)) (dxi `((ACT md) ,d ,xi)) (nxi `(nu ,xi)))
    (c6-iff-fwd! (dk-cite! 'c6-ball-mem 'md 'nu nc xi))
    (dk-cite! 'c6-act-in 'kf 'md d xi)
    (c6-nu! 'nu 'md xi) (c6-nu! 'nu 'md dxi)
    (dk-apply! hom d xi)
    (dk-cite! 'rr-mul-le-right nxi nc nd)
    (c6-rr-mul! nd nxi) (c6-rr-mul! nxi nd) (c6-rr-mul! nc nd)
    (dk-have! `(= (* ,nd ,nxi) (* ,nxi ,nd)) (lambda () (crs)))
    (let ((h1 (dk-rewrite-h! `(= ((FNRM kf) ((MUL kf) c ,d)) (* ,nc ,nd)) `((MUL kf) c ,d) '(ONE kf))))
      (dk-have! `(<= (nu ,dxi) 1)
        (lambda () (dk-ineq! `(= (nu ,dxi) (* ,nd ,nxi)) `(= (* ,nd ,nxi) (* ,nxi ,nd))
