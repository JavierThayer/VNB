(define (c6-iff-bwd! iff . opt)
  (let ((rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-have! rhs (if (pair? opt) (car opt) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
    (ai iff)
    (detach! `(IMPLIES ,rhs ,(cadr iff)))
    (cadr iff)))
(define (c6-vs body)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL md (IMPLIES (IS-K-VECTOR-SPACE kf md) ,body)))))
(define c6-V '(NORMED-FIELD-AS-COMMUTATIVE-RING kf))

(sp (make-wff (c6-vs '(IS-MODULE md))))
(dk-peel!)
(dk-project! '(IS-MODULE md) 'is-k-vector-space '(IS-K-VECTOR-SPACE kf md))
(dk-ass!)
(qed 'c6-vs-module)

(sp (make-wff (c6-vs `(= (SCAL md) ,c6-V))))
(dk-peel!)
(dk-project! `(= (SCAL md) ,c6-V) 'is-k-vector-space '(IS-K-VECTOR-SPACE kf md))
(dk-ass!)
(qed 'c6-vs-scal)

;; the scalar slots of E read as those of K
(define (c6-scal-eq! name acc thm)
  (sp (make-wff (c6-vs `(== (,acc (SCAL md)) (,acc kf)))))
  (dk-peel!)
  (dk-cite! 'c6-vs-scal 'kf 'md)
  (dk-cite! thm 'kf)
  (subst `(= (SCAL md) ,c6-V))
  (subst `(== (,acc ,c6-V) (,acc kf)))
  (qrfl)
  (qed name))
(c6-scal-eq! 'c6-scal-carr 'CARR 'normed-field-ring-view-carr)
(c6-scal-eq! 'c6-scal-add 'ADD 'normed-field-ring-view-add)
(c6-scal-eq! 'c6-scal-mul 'MUL 'normed-field-ring-view-mul)
(c6-scal-eq! 'c6-scal-one 'ONE 'normed-field-ring-view-one)

;; inside a proof with IS-NORMED-FIELD KF and IS-K-VECTOR-SPACE KF MD in context
(define (c6-vs! kf md)
  (if (not (dk-asm? `(IS-MODULE ,md)))
      (begin
        (dk-cite! 'c6-vs-module kf md)
        (for-each (lambda (n) (dk-cite! n kf md)) '(c6-scal-carr c6-scal-add c6-scal-mul c6-scal-one)))))
(define (c6-in-scal! kf md r)
  (let ((f `(IN ,r (CARR (SCAL ,md)))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (subst `(== (CARR (SCAL ,md)) (CARR ,kf))) (dk-ass!))))
    f))

(sp (make-wff (c6-vs '(FORALL r (IMPLIES (IN r (CARR kf)) (FORALL x (IMPLIES (IN x (VEC md)) (IN ((ACT md) r x) (VEC md)))))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(c6-in-scal! 'kf 'md 'r)
(dk-cite! 'module-act-type 'md 'r 'x)
(dk-ass!)
(qed 'c6-act-in)

(sp (make-wff (c6-vs '(FORALL r (IMPLIES (IN r (CARR kf)) (FORALL s (IMPLIES (IN s (CARR kf)) (FORALL x (IMPLIES (IN x (VEC md))
  (= ((ACT md) ((MUL kf) r s) x) ((ACT md) r ((ACT md) s x))))))))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(c6-in-scal! 'kf 'md 'r) (c6-in-scal! 'kf 'md 's)
(let ((e (dk-cite! 'module-act-mul-compat 'md 'r 's 'x)))
  (dk-rewrite-h! e '(MUL (SCAL md)) '(MUL kf))
  (dk-ass!))
(qed 'c6-act-mul)

(sp (make-wff (c6-vs '(FORALL r (IMPLIES (IN r (CARR kf)) (FORALL s (IMPLIES (IN s (CARR kf)) (FORALL x (IMPLIES (IN x (VEC md))
  (= ((ACT md) ((ADD kf) r s) x) ((VADD md) ((ACT md) r x) ((ACT md) s x))))))))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(c6-in-scal! 'kf 'md 'r) (c6-in-scal! 'kf 'md 's)
(let ((e (dk-cite! 'module-act-distrib-scalar 'md 'r 's 'x)))
  (dk-rewrite-h! e '(ADD (SCAL md)) '(ADD kf))
  (dk-ass!))
(qed 'c6-act-add)

(sp (make-wff (c6-vs '(FORALL x (IMPLIES (IN x (VEC md)) (= ((ACT md) (ONE kf) x) x))))))
(dk-peel!)
(c6-vs! 'kf 'md)
(let ((e (dk-cite! 'module-act-unital 'md 'x)))
