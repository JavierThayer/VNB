                      (dk-have! `(= ((ACT md) c ,dxi) ,xi)
                        (lambda () (subst `(= ((ACT md) c ,dxi) ((ACT md) (ONE kf) ,xi))) (dk-ass!))))
                    (dk-rewrite-h! (dk-apply! bil 'c 'eta dxi) `((ACT md) c ,dxi) xi)
                    (subst `(= (w eta ,xi) (w ,ce ,dxi)))
                    (dk-ass!)))))))
      (dk-close-if-asm!))))

(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL md (FORALL nu (FORALL w (IMPLIES (IS-E-UNIPOLAR kf md nu w)
  (FORALL c (IMPLIES (IN c (CARR kf)) (IMPLIES (NOT (= c (ZERO kf)))
