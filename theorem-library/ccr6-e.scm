    (dk-have! `(IN ,ce (E-POLAR md w ,b1)) (lambda () (subst `(= (E-POLAR md w ,b1) ,b1)) (dk-ass!)))
    (c6-iff-fwd! (dk-cite! 'c6-epolar-mem 'md 'w b1 ce))
    (let ((pl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ce) (dk-contains? f 'NORM-BALL))) "polarity")))
      (c6-iff-bwd! (dk-cite! 'c6-epolar-mem 'md 'w c6-bc 'eta)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let* ((xi (dk-di-var!)) (dxi (c6-630-unscale-in! hom d xi)))
                    (dk-apply! pl dxi)
                    (let* ((m1 (dk-cite! 'c6-act-mul 'kf 'md 'c d xi))
