(define (c6-iff-fwd! iff) (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
(define (c6-view kf) `(NORMED-FIELD-AS-COMMUTATIVE-RING ,kf))
(define (c6-view! kf)
  (let ((v (c6-view kf)))
    (if (not (dk-asm? `(IS-COMMUTATIVE-RING ,v)))
        (begin
          (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring kf)
          (for-each (lambda (n) (dk-cite! n kf))
                    '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                      normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))))))
(define (c6-leaves kf u)
  (if (and (pair? u) (pair? (car u)) (memq (caar u) '(ADD MUL NEG)) (equal? (cdar u) (list kf)))
      (apply append (map (lambda (t) (c6-leaves kf t)) (cdr u)))
      (if (member u (list `(ZERO ,kf) `(ONE ,kf))) '() (list u))))
;; a ring identity goal in KF's accessors, the atoms of ELEMS typed in (CARR KF)
(define (c6-crs! kf elems0)
  (c6-view! kf)
  (let ((v (c6-view kf)) (elems (apply append (map (lambda (u) (c6-leaves kf u)) elems0))))
    (for-each (lambda (u)
                (if (not (dk-asm? `(IN ,u (CARR ,v))))
                    (dk-have! `(IN ,u (CARR ,v)) (lambda () (subst `(== (CARR ,v) (CARR ,kf))) (dk-ass!)))))
              elems)
    (for-each (lambda (acc)
                (if (dk-contains? (dk-goal) `(,acc ,kf))
                    (subst `(== (,acc ,kf) (,acc ,v)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))
(define (c6-N kf t) `((FNRM ,kf) ,t))
(define (c6-dump!)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (display ";; c6 OPEN: ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves))))

;;; =======================================================================
;;; 1. THE Q_p INSTANCE OF PROPOSITION 6.18
;;; Q_p has compact integers and the uniformizing parameter p (qp-zp-compact-domain, qp-maximal-principal);
;;; lambda (Proposition 5.20) is a character with lambda(x) = 1 iff x in Z_p, hence non-trivial (1/p is not in
;;; Z_p); ccr-6-18 (CCR-1109-D2) then gives a faithful unipolar bicharacter of Q_p.

(define c6-qf '(QP-FIELD p))
(define c6-uw '((EMBED (NF-METRIC-SPACE (QQ-PADIC p))) p))

;; Q_p is a local NV field with uniformizing parameter p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IS-LOCAL-UNIFORMIZER ,c6-qf ,c6-uw)))))
(dk-peel!)
(let* ((qf c6-qf) (uw c6-uw) (nu (c6-N qf uw)) (pa '((PADIC-ABS p) p)))
  (dk-project! '(IN p ZZ) 'zz-prime '(ZZ-PRIME p))
  (dk-cite! 'zz-subset-qq 'p)
  (dk-cite! 'qp-is-nv-field 'p)
  (dk-cite! 'qp-is-normed-field 'p)
  (dk-split-all! (list (dk-cite! 'qp-embed-abs 'p 'p)))
  (dk-cite! 'ccr-1-26-carrier 'p)
  (dk-rewrite-h! `(IN ,uw (PTS (QP p))) '(PTS (QP p)) `(CARR ,qf))
  (dk-cite! 'qp-field-fnrm 'p)
  (dk-cite! 'nf-norm-in-rr qf uw)
  (dk-cite! 'qo-abs-p 'p)
  (dk-have! `(= ,nu ,pa) (lambda () (subst `(== (FNRM ,qf) (QP-ABS p))) (dk-ass!)))
  (dk-have! `(IN ,pa RR) (lambda () (subst `(= ,pa ,nu)) (dk-ass!)))
  (dk-have! `(<= ,nu 1) (lambda () (dk-ineq! `(= ,nu ,pa) `(= (* ,pa 2) 1))))
  (dk-have! `(NOT (= ,uw (ZERO ,qf)))
    (lambda () (di)
      (let* ((z0 (dk-cite! 'nf-norm-of-zero qf)) (z1 (dk-rewrite-h! z0 `(ZERO ,qf) uw)))
        (dk-absurd! z1 `(= ,nu ,pa) `(= (* ,pa 2) 1)))))
  (dk-have! `(IN ,uw (NV-INTEGERS ,qf)) (lambda () (mac 'nv-integers) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
  (let ((c (dk-cite! 'qp-zp-compact-domain 'p)) (m (dk-cite! 'qp-maximal-principal 'p)))
    (dk-rewrite-h! c '(ZP p) `(NV-INTEGERS ,qf))
    (dk-rewrite-h! m '(ZP p) `(NV-INTEGERS ,qf)))
  (mac 'is-local-uniformizer)
  (dk-conj-close! (lambda () (dk-ass!))))
(c6-dump!)
(qed 'c6-qp-uniformizer)

;; a character of a local field that is 1 exactly on Z(K) is non-trivial (1/uw is not in Z(K))
(sp (make-wff '(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (IFF (= (chi x) 1) (IN x (NV-INTEGERS kf)))))
    (IS-NONTRIVIAL-CHARACTER kf chi)))))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(let ((r (dk-cite! 'c5-lu-norm 'kf 'uw))) (if (dk-head-is? r 'AND) (dk-split-all! (list r))))
(dk-cite! 'c5-lu-nonzero 'kf 'uw)
(dk-cite! 'nf-norm-in-rr 'kf 'uw)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-cite! 'nf-norm-one 'kf)
(fact 'rr-one-in)
(let* ((iffs (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IFF))) "the kernel"))
       (uwi (dk-skolem! (dk-cite! 'nf-inverse 'kf 'uw)))
       (h1 `((MUL kf) ,uwi (ONE kf))))
  (dk-cite! 'nf-norm-in-rr 'kf uwi) (dk-cite! 'nf-norm-nonneg 'kf uwi)
  (dk-cite! 'nf-mul-in-carr 'kf uwi '(ONE kf))
  (dk-cite! 'nf-norm-in-rr 'kf h1)
  (dk-have! `(<= ,(c6-N 'kf 'uw) 1) (lambda () (dk-ineq! `(< ,(c6-N 'kf 'uw) 1))))
  (dk-cite! 'sdl-inv-ge1 'kf 'uw uwi)
  (dk-have! `(= ((MUL kf) ,uwi uw) (ONE kf))
    (lambda () (subst `(= (ONE kf) ((MUL kf) uw ,uwi))) (c6-crs! 'kf (list 'uw uwi))))
  (dk-have! `(< 0 ,(c6-N 'kf uwi)) (lambda () (dk-ineq! `(<= 1 ,(c6-N 'kf uwi)))))
  (dk-have! `(< ,(c6-N 'kf 'uw) ,(c6-N 'kf '(ONE kf))) (lambda () (subst `(= ,(c6-N 'kf '(ONE kf)) 1)) (dk-ass!)))
  (dk-cite! 'sdl-scale-gt 'kf uwi 'uw '(ONE kf))
  (dk-have! `(NOT (= (chi ,h1) 1))
    (lambda ()
      (di)
      (c6-iff-fwd! (dk-apply! iffs h1))
      (c6-iff-fwd! (dk-cite! 'c5-integers-mem 'kf h1))
      (dk-absurd! `(< 1 ,(c6-N 'kf h1)) `(<= ,(c6-N 'kf h1) 1))))
  (mac 'is-nontrivial-character)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          (begin (ew h1) (dk-conj-close! (lambda () (dk-ass!))))
          (dk-ass!)))))
(c6-dump!)
(qed 'c6-integers-char-nontrivial)

;; lambda is a non-trivial character of Q_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IS-NONTRIVIAL-CHARACTER ,c6-qf (QP-LAMBDA p))))))
(dk-peel!)
(let ((qf c6-qf))
  (dk-cite! 'c6-qp-uniformizer 'p)
  (dk-split-all! (list (dk-cite! 'ccr-5-20 'p)))
  (dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
  (let ((k (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IFF) (dk-contains? f '(ZP p)))) "lambda's kernel")))
    (dk-rewrite-h! k '(ZP p) `(NV-INTEGERS ,qf)))
  (dk-cite! 'c6-integers-char-nontrivial qf c6-uw '(QP-LAMBDA p))
  (dk-close-if-asm!))
(c6-dump!)
(qed 'ccr-5-20-nontrivial)

;; Proposition 6.18 for Q_p: a faithful unipolar bicharacter
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
  (FORSOME sdw_ (AND (IS-UNIPOLAR ,c6-qf sdw_) (IS-FAITHFUL-BICHARACTER ,c6-qf sdw_)))))))
(dk-peel!)
(dk-cite! 'c6-qp-uniformizer 'p)
(dk-cite! 'ccr-5-20-nontrivial 'p)
(dk-cite! 'ccr-6-18 c6-qf c6-uw '(QP-LAMBDA p))
(dk-close-if-asm!)
(c6-dump!)
(qed 'ccr-6-18-qp)

