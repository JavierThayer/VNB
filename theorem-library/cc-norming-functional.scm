;;; cc-norming-functional.scm -- THE COMPLEX NORMING FUNCTIONAL: for a seminorm p on a complex
;;; module m and a vector v there is a CC-linear functional f on m with |f(x)| <= p(x) everywhere
;;; and f(v) = p(v).  The complex twin of `norming-functional-exists' (tvs-bidual.scm), through
;;; the complex `hahn-banach-seminorm' (rake-asm-b3.scm), which no theorem had cited.
;;; Agent BA-1D, wave 2026-11-09.  Destination: theorem-library/cc-norming-functional.scm.
;;; Library: analysis (a fact about complex modules and seminorms; nothing of the BA vocabulary).
;;; All proofs modulo 0.
;;;
;;; THE CONSTRUCTION follows rake-line-functional.scm (the real seed): the seed functional on the
;;; complex line S = {c.v : c in CC} is ONE lambda whose value at u is the DESCRIPTION
;;;     IOTA t. t in CC and (some q in CC with u = q.v and t = q p(v)),
;;; which denotes for every v (for p(v) = 0 every admissible t is 0), so there is no case split
;;; on v = 0.  The content is `cnf-coef-unique': c.v = q.v  =>  c p(v) = q p(v), from
;;; p((c - q).v) = |c - q| p(v) and p(0.v) = 0, without vector-group cancellation.
;;; The seed is CC-linear on S and |seed| <= p on S (equality, in fact); hahn-banach-seminorm
;;; extends it to all of m, keeping |f| <= p.
;;;
;;; LOAD WINDOW: after theorem-library/rake-asm-b3 (load.scm 3753: hahn-banach-seminorm,
;;; rb3-c-act-add, rb3-c-act-mul, rb3-c-act-in, rb3-c-in-carr, rb3-c-carr, rb3-c-add-eq,
;;; rb3-c-mul-eq, rb3-c-one-eq, cc-scalar-ring-zero); the frm-sn-* seminorm laws and frm-act-neg-scal
;;; (frechet files, earlier); cc-nf-fnrm-apply, cc-nf-neg-apply, cc-magnitude-mul,
;;; rr-magnitude-is-abs, rr-no-zero-divisors (early).  Helper prefix: cnf-.

(define (cnf-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cc-norming-functional: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cc-norming-functional: unfinished" name))))

(define cnf-sn '(IS-SEMINORM CC-NORMED-FIELD m p))
(define cnf-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define cnf-pin (list '= '(SCAL m) cnf-ring))
(define (cnf-act c v) (list '(ACT m) c v))
(define (cnf-add u v) (list '(VADD m) u v))
(define cnf-S '(SEP cnw_ (VEC m) (FORSOME cnr_ (AND (IN cnr_ CC) (= cnw_ ((ACT m) cnr_ cny))))))
(define (cnf-iota u)
  (list 'IOTA 'cnt_
        (list 'AND '(IN cnt_ CC)
              (list 'FORSOME 'cnq_
                    (list 'AND '(IN cnq_ CC)
                          (list 'AND (list '= u '((ACT m) cnq_ cny))
                                '(= cnt_ (* cnq_ (p cny)))))))))
(define cnf-F (list 'VNB-LAMBDA 'cnu_ cnf-S (cnf-iota 'cnu_)))
(define cnf-py '(p cny))

(define (cnf-cite2! . args)
  (let ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        r)))

;;; the seminorm's module, pin and typing
(define (cnf-basics!)
  (dk-cite! 'frm-sn-module 'CC-NORMED-FIELD 'm 'p)
  (dk-cite! 'frm-sn-type 'CC-NORMED-FIELD 'm 'p)
  (dk-project! cnf-pin 'is-seminorm cnf-sn))

(define (cnf-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((and (pair? t) (eq? (car t) 'p))
         (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'magnitude))
         (cnf-cc! (cadr t)) (dk-cite! 'cc-magnitude-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (cnf-rr! (cadr t)) (cnf-rr! (caddr t)) (dk-real! t) t)
        (#t (dk-real! t) t)))

(define (cnf-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (cnf-cc! (cadr t)) (cnf-cc! (caddr t)) (cnf-cite2! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (cnf-cc! (cadr t)) (cnf-cc! (caddr t)) (cnf-cite2! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (cnf-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((equal? t 0) (dk-cite! 'cc-zero-in) t)
        ((equal? t 1) (dk-cite! 'cc-one-in) t)
        ((and (pair? t) (eq? (car t) 'p))
         (cnf-rr! t) (dk-cite! 'rr-subset-cc t) t)
        (#t (error "cnf-cc!: cannot type" (expression->string t)))))

(define (cnf-vt! v)
  (cond ((dk-asm? (list 'IN v '(VEC m))) v)
        ((and (pair? v) (equal? (car v) '(ACT m)))
         (cnf-cc! (cadr v)) (cnf-vt! (caddr v))
         (dk-cite! 'rb3-c-act-in 'm (cadr v) (caddr v)) v)
        ((and (pair? v) (equal? (car v) '(VADD m)))
         (cnf-vt! (cadr v)) (cnf-vt! (caddr v))
         (dk-cite! 'module-vadd-type 'm (cadr v) (caddr v)) v)
        (#t (error "cnf-vt!: cannot type" (expression->string v)))))

;;; close (= A B) from (= A B) or (= B A) in context
(define (cnf-sym-ass!)
  (if (not (dk-ass!))
      (let ((g (dk-goal)))
        (dk-cite! 'eq-sym (caddr g) (cadr g))
        (dk-ass!))))

