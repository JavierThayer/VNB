                (dk-ass!)))
          (dk-opened (lambda () (sep-mi))))
(cnf-qed! 'cnf-line-mem)

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'cny (list 'FORALL 'cnu_
  (list 'IMPLIES (list 'IN 'cnu_ cnf-S)
    '(AND (IN cnu_ (VEC m)) (FORSOME cnr_ (AND (IN cnr_ CC) (= cnu_ ((ACT m) cnr_ cny)))))))))))
(dk-peel!)
(sep-me (list 'IN 'cnu_ cnf-S))
(dk-conj-close! (lambda () (dk-ass!)))
(cnf-qed! 'cnf-line-coef)

;;; a point of S: its typing and its coefficient (returned)
(define (cnf-decompose! u)
  (let ((c (dk-cite! 'cnf-line-coef 'm 'cny u)))
    (dk-split! c)
    (dk-skolem! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME) (memq u (free-vars f))))
                         "the decomposition of a point of the line"))))

(define (cnf-in-S-landed landed)
  (map cadr (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'SEP))) landed)))

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'p (list 'IMPLIES cnf-sn
  (list 'FORALL 'cny (list 'IMPLIES '(IN cny (VEC m)) (list 'IS-SUBMODULE 'm cnf-S))))))))
(dk-peel!)
(cnf-basics!)
(dk-cite! 'rb3-c-carr 'm)
(mac 'IS-SUBMODULE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((eq? (car g) 'SUBSET)
         (mac 'subset-def)
         (let ((x (dk-di-var!)))
           (dk-split! (dk-cite! 'cnf-line-coef 'm 'cny x))
           (dk-ass!)))
        ((and (eq? (car g) 'IN) (equal? (cadr g) '(VZERO m)))
         (dk-cite! 'cc-scalar-ring-zero)
         (let* ((z0 (dk-cite! 'module-zero-act 'm 'cny))
                (z1 (dk-rewrite-h! z0 '(SCAL m) cnf-ring))
                (z2 (dk-rewrite-h! z1 (list 'ZERO cnf-ring) 0)))
           (dk-cite! 'eq-sym (cnf-act 0 'cny) '(VZERO m))
           (cnf-cc! 0)
           (dk-cite! 'cnf-line-mem 'm 'p 'cny '(VZERO m) 0)
           (dk-ass!)))
        (#t
         (let* ((landed (dk-peel!))
                (xs (cnf-in-S-landed landed))
                (g2 (dk-goal))
                (el (cadr g2)))
           (cond
             ((and (pair? el) (equal? (car el) '(VADD m)))
              (let* ((x1 (car xs)) (x2 (cadr xs))
                     (a (cnf-decompose! x1)) (b (cnf-decompose! x2))
                     (ab (list '+ a b)))
                (cnf-cc! ab)
                (dk-cite! 'rb3-c-act-add 'm a b 'cny)
                (dk-have! (list '= el (cnf-act ab 'cny))
                  (lambda ()
                    (subst (list '= x1 (cnf-act a 'cny)))
                    (subst (list '= x2 (cnf-act b 'cny)))
                    (cnf-sym-ass!)))
                (dk-cite! 'cnf-line-mem 'm 'p 'cny el ab)
                (dk-ass!)))
             ((and (pair? el) (equal? (car el) '(VNEG m)))
              (let* ((x1 (car xs)) (a (cnf-decompose! x1)) (na (list '- a)))
                (cnf-cc! na)
                (dk-cite! 'rb3-c-in-carr 'm a)
                (dk-cite! 'cnf-c-neg-eq 'm a)
                (let* ((h0 (dk-cite! 'frm-act-neg-scal 'm a 'cny))
                       (h1 (dk-rewrite-h! h0 (list '(NEG (SCAL m)) a) na)))
                  (dk-have! (list '= el (cnf-act na 'cny))
                    (lambda () (subst (list '= x1 (cnf-act a 'cny))) (cnf-sym-ass!)))
                  (dk-cite! 'cnf-line-mem 'm 'p 'cny el na)
                  (dk-ass!))))
             ((and (pair? el) (equal? (car el) '(ACT m)))
              (let* ((r (cadr el)) (x1 (car xs)) (a (cnf-decompose! x1)) (ra (list '* r a)))
                (if (not (dk-asm? (list 'IN r 'CC)))
                    (dk-rewrite-h! (list 'IN r '(CARR (SCAL m))) '(CARR (SCAL m)) 'CC))
                (cnf-cc! ra)
                (dk-cite! 'rb3-c-act-mul 'm r a 'cny)
                (dk-have! (list '= el (cnf-act ra 'cny))
                  (lambda () (subst (list '= x1 (cnf-act a 'cny))) (cnf-sym-ass!)))
                (dk-cite! 'cnf-line-mem 'm 'p 'cny el ra)
                (dk-ass!)))
             (#t (error "cnf-line-submodule: unexpected conjunct" (expression->string g2))))))))))
(cnf-qed! 'cnf-line-submodule)

;;; ---- the seed is CC-linear on S -------------------------------------------------------------------
(define (cnf-value! u c)            ; rewrite the goal's IOTA at u (= c.v) to c p(v)
  (dk-cite! 'cnf-coef-value 'm 'p 'cny u c)
  (subst (list '= (cnf-iota u) (list '* c cnf-py))))

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'p (list 'IMPLIES cnf-sn
  (list 'FORALL 'cny (list 'IMPLIES '(IN cny (VEC m)) (list 'IS-K-LINEAR-ON 'm cnf-S cnf-F))))))))
(dk-peel!)
(cnf-basics!)
(dk-cite! 'rb3-c-carr 'm)
(dk-cite! 'cnf-line-submodule 'm 'p 'cny)
(dk-cite! 'frm-module-vec-set 'm)
(cnf-rr! cnf-py)
(cnf-cc! cnf-py)
(mac 'IS-K-LINEAR-ON)
(subst '(= (CARR (SCAL m)) CC))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((and (eq? (car g) 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
         (dk-lam-type!
           (lambda ()
             (let* ((u (dk-di-var!)) (q (cnf-decompose! u)))
               (cnf-value! u q)
               (cnf-cc! (list '* q cnf-py))
               (dk-ass!)))
           (lambda ()
             (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (sep-set)))))))
        (#t
         (let* ((landed (dk-peel!))
                (xs (cnf-in-S-landed landed))
                (g2 (dk-goal)))
           (if (= (length xs) 2)
               ;; additivity
               (let* ((x1 (car xs)) (x2 (cadr xs))
                      (a (cnf-decompose! x1)) (b (cnf-decompose! x2))
                      (ab (list '+ a b)) (sum (cnf-add x1 x2)))
                 (cnf-cc! ab)
                 (dk-cite! 'rb3-c-act-add 'm a b 'cny)
                 (dk-have! (list '= sum (cnf-act ab 'cny))
                   (lambda ()
                     (subst (list '= x1 (cnf-act a 'cny)))
                     (subst (list '= x2 (cnf-act b 'cny)))
                     (cnf-sym-ass!)))
                 (dk-cite! 'cnf-line-mem 'm 'p 'cny sum ab)
                 (dk-lam-b!)
                 (cnf-value! sum ab)
                 (cnf-value! x1 a)
                 (cnf-value! x2 b)
                 (cnf-cc! (list '* a cnf-py)) (cnf-cc! (list '* b cnf-py))
                 (dk-cite! 'rb3-c-add-eq 'm (list '* a cnf-py) (list '* b cnf-py))
                 (subst (list '= (list '(ADD (SCAL m)) (list '* a cnf-py) (list '* b cnf-py))
                              (list '+ (list '* a cnf-py) (list '* b cnf-py))))
                 (crs))
               ;; homogeneity
               (let* ((r (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'CC))) landed))))
                      (x1 (car xs)) (q (cnf-decompose! x1))
                      (rq (list '* r q)) (rx (cnf-act r x1)))
                 (cnf-cc! rq)
                 (dk-cite! 'rb3-c-act-mul 'm r q 'cny)
                 (dk-have! (list '= rx (cnf-act rq 'cny))
                   (lambda () (subst (list '= x1 (cnf-act q 'cny))) (cnf-sym-ass!)))
                 (dk-cite! 'cnf-line-mem 'm 'p 'cny rx rq)
                 (dk-lam-b!)
