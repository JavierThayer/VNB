;;; ---- c.v = q.v  =>  c p(v) = q p(v) ----------------------------------------------------------
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'p (list 'IMPLIES cnf-sn
  '(FORALL cny (IMPLIES (IN cny (VEC m)) (FORALL cna_ (IMPLIES (IN cna_ CC) (FORALL cnb_ (IMPLIES (IN cnb_ CC)
     (IMPLIES (= ((ACT m) cna_ cny) ((ACT m) cnb_ cny)) (= (* cna_ (p cny)) (* cnb_ (p cny)))))))))))))))
(dk-peel!)
(cnf-basics!)
(let* ((nb '(- cnb_)) (d '(+ cna_ (- cnb_))) (py cnf-py)
       (ad (cnf-act d 'cny)) (a0 (cnf-act 0 'cny))
       (aa (cnf-act 'cna_ 'cny)) (ab (cnf-act 'cnb_ 'cny)) (anb (cnf-act nb 'cny))
       (fd (list '(FNRM CC-NORMED-FIELD) d)) (f0 '((FNRM CC-NORMED-FIELD) 0)))
  (cnf-cc! nb) (cnf-cc! d) (cnf-cc! 0) (cnf-rr! py)
  (cnf-vt! aa) (cnf-vt! ab) (cnf-vt! anb) (cnf-vt! ad) (cnf-vt! a0)
  (dk-cite! 'rb3-c-act-add 'm 'cna_ nb 'cny)
  (dk-cite! 'rb3-c-act-add 'm 'cnb_ nb 'cny)
  (dk-have! '(= (+ cnb_ (- cnb_)) 0) (lambda () (crs)))
  (dk-have! (list '= ad a0)
    (lambda ()
      (subst (list '= ad (cnf-add aa anb)))
      (subst (list '= aa ab))
      (subst (list '= (cnf-add ab anb) (cnf-act '(+ cnb_ (- cnb_)) 'cny)))
      (subst '(= (+ cnb_ (- cnb_)) 0))
      (rfl)))
  (dk-cite! 'rb3-c-in-carr 'm d)
  (dk-cite! 'rb3-c-in-carr 'm 0)
  (dk-cite! 'frm-sn-homog 'CC-NORMED-FIELD 'm 'p d 'cny)
  (dk-cite! 'frm-sn-homog 'CC-NORMED-FIELD 'm 'p 0 'cny)
  (dk-cite! 'cc-nf-fnrm-apply d)
  (dk-cite! 'cc-nf-fnrm-apply 0)
  (dk-cite! 'cc-magnitude-zero)
  (cnf-rr! (list 'magnitude d))
  (dk-have! (list '= (list '* (list 'magnitude d) py) 0)
    (lambda ()
      (subst (list '= (list 'magnitude d) fd))
      (subst (list '= (list '* fd py) (list 'p ad)))
      (subst (list '= ad a0))
      (subst (list '= (list 'p a0) (list '* f0 py)))
      (subst (list '= f0 '(magnitude 0)))
      (subst '(= (magnitude 0) 0))
      (crs)))
  (dk-cite! 'rr-no-zero-divisors (list 'magnitude d) py)
  (use-cases (list (list '= (list 'magnitude d) 0) (list '= py 0))
    (lambda ()
      (dk-cite! 'cc-magnitude-zero-iff d)
      (dk-have! (list '= d 0) (lambda () (keep (list '= (list 'magnitude d) 0) (iff-for (list '= (list 'magnitude d) 0))) (prop)))
      (let* ((e1 (begin (dk-have! (list '= 'cna_ (list '+ d 'cnb_)) (lambda () (crs)))
                        (list '= 'cna_ (list '+ d 'cnb_))))
             (e2 (dk-rewrite-h! e1 d 0)))
        (dk-have! '(= (+ 0 cnb_) cnb_) (lambda () (crs)))
        (dk-rewrite-h! e2 '(+ 0 cnb_) 'cnb_)
        (subst '(= cna_ cnb_))
        (rfl)))
    (lambda ()
      (subst (list '= py 0))
      (crs))))
(cnf-qed! 'cnf-coef-unique)

;;; ---- the description denotes: its value at c.v is c p(v) ----------------------------------------
(define (cnf-same-coef! q)
  (dk-cite! 'eq-sym 'cnu_ '((ACT m) cnc_ cny))
  (dk-cite! 'eq-trans '((ACT m) cnc_ cny) 'cnu_ (list '(ACT m) q 'cny))
  (dk-cite! 'cnf-coef-unique 'm 'p 'cny 'cnc_ q))

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'p (list 'FORALL 'cny (list 'FORALL 'cnu_ (list 'FORALL 'cnc_
  (list 'IMPLIES cnf-sn (list 'IMPLIES '(IN cny (VEC m)) (list 'IMPLIES '(IN cnc_ CC)
    (list 'IMPLIES '(= cnu_ ((ACT m) cnc_ cny))
      (list '= (cnf-iota 'cnu_) (list '* 'cnc_ cnf-py)))))))))))))
(dk-peel!)
(cnf-basics!)
(cnf-cc! (list '* 'cnc_ cnf-py))
(cnf-vt! (cnf-act 'cnc_ 'cny))
(let ((io (cadr (dk-goal))))
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (eq? (car (dk-goal)) 'FORSOME)
         (begin
           (ew (list '* 'cnc_ cnf-py))
           (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((eq? (car g) 'IN) (dk-ass!))
                  ((eq? (car g) 'FORSOME)
                   (ew 'cnc_)
                   (dk-conj-close!
                    (lambda ()
                      (let ((h (dk-goal)))
                        (if (and (eq? (car h) '=) (equal? (cadr h) (caddr h)))
                            (rfl)
                            (dk-ass!))))))
                  ((eq? (car g) 'FORALL)
                   (dk-peel!)
                   (dk-split-all!)
                   (let* ((yy (caddr (dk-goal)))
                          (q1 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the other decomposition"))))
                     (cnf-same-coef! q1)
                     (subst (list '= yy (list '* q1 cnf-py)))
                     (dk-ass!)))
                  (#t (error "cnf: unexpected exuniq conjunct" (expression->string g))))))))
         (begin
           (dk-split-all!)
           (let ((q0 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the granted decomposition"))))
             (cnf-same-coef! q0)
             (subst (list '= io (list '* q0 cnf-py)))
             (dk-cite! 'eq-sym (list '* 'cnc_ cnf-py) (list '* q0 cnf-py))
             (dk-ass!)))))
   (dk-opened (lambda () (iota-d io)))))
(cnf-qed! 'cnf-coef-value)

;;; ---- the complex line S = {c.v : c in CC} ----------------------------------------------------------
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'p (list 'FORALL 'cny (list 'FORALL 'cnu_ (list 'FORALL 'cnc_
  (list 'IMPLIES cnf-sn (list 'IMPLIES '(IN cny (VEC m)) (list 'IMPLIES '(IN cnc_ CC)
    (list 'IMPLIES '(= cnu_ ((ACT m) cnc_ cny)) (list 'IN 'cnu_ cnf-S))))))))))))
(dk-peel!)
(cnf-basics!)
(cnf-vt! (cnf-act 'cnc_ 'cny))
(dk-have! '(IN cnu_ (VEC m)) (lambda () (subst '(= cnu_ ((ACT m) cnc_ cny))) (dk-ass!)))
(for-each (lambda (l)
            (dk-focus! l)
            (if (eq? (car (dk-goal)) 'FORSOME)
