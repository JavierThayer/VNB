;;; cg4-ext.scm -- Proposition 5.36, existence: the extension psi = OPG-EXT(g, al, phi) of a group
;;; segment phi is a one-parameter group (continuous: at t by continuity at 0, translated; at 0 by
;;; phi's continuity at 0 on the right and, through the inverse, on the left) and agrees with phi
;;; on [0, al].  Proved for a group topology (s, g) under NAME-gt, restated for TOP-GROUP under NAME.
;;; Agent ISOM, 2026-10-27.  Helper prefix: ex4-.  Library: analysis.

(define (ex4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (ex4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (ex4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (ex4-op x y) (list '(OPR g) x y))
(define (ex4-inv x) (list '(INV g) x))
(define ex4-E '(IDEN g))
(define (ex4-P t) (list 'OPG-VAL 'g 'al 'phi t))
(define ex4-psi '(OPG-EXT g al phi))
(define (ex4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (ex4-forall (cdr vs) body))))
(define (ex4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (ex4-implies (cdr hs) concl))))
(define ex4-law '(FORALL gsr_ (IMPLIES (IN gsr_ (CCINT 0 al)) (FORALL gsu_ (IMPLIES (IN gsu_ (CCINT 0 al))
                   (IMPLIES (<= (+ gsr_ gsu_) al) (= (phi (+ gsr_ gsu_)) ((OPR g) (phi gsr_) (phi gsu_)))))))))
(define ex4-hyps (list '(IS-GROUP g) '(IN al RR) '(< 0 al) '(IN phi (FUN (CCINT 0 al) (CARR g))) ex4-law))
(define (ex4-cc! t)
  (let ((iff (dk-cite! 'ccint-membership 0 'al t)))
    (if (not (dk-asm? (cadr iff)))
        (begin (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ex4-ass!)))))
               (dk-meta-iff-l! iff)))
    (dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) t)))
(define (ex4-pt! t) (dk-real! t) (dk-split-all! (list (dk-cite! 'opg-val-rep 'g 'al 'phi t))))

;;; ---- psi as a function, and its values ----
(sp (make-wff (ex4-forall '(g al phi) (ex4-implies ex4-hyps (list 'IN ex4-psi '(FUN RR (CARR g)))))))
(dk-peel!)
(fact 'rr-is-set)
(mac 'OPG-EXT)
(dk-lam-type! (lambda () (let ((t (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                           (ex4-pt! t) (ex4-ass!)))
              (lambda () (ex4-ass!)))
(qed 'opg-ext-fun)
(topic! 'opg-ext-fun 'analysis)

(sp (make-wff (ex4-forall '(g al phi t) (ex4-implies (append ex4-hyps (list '(IN t RR))) (list '= (list ex4-psi 't) (ex4-P 't))))))
(dk-peel!)
(ex4-pt! 't)
(mac 'OPG-EXT)
(if (not (dk-lam-b!)) (ex4-ass-rfl!))
(qed 'opg-ext-apply)
(topic! 'opg-ext-apply 'analysis)

;;; ---- psi agrees with phi on [0, al] ----
(define (ex4-small! h)                   ; 0 <= h < al: (= (P h) (phi h))
  (fact 'nn-zero-in)
  (dk-real! (list '+ (list '* 0 'al) h))
  (dk-have! (list '= h (list '+ (list '* 0 'al) h)) (lambda () (crs)))
  (dk-cite! 'opg-val-nonneg 'g 'al 'phi 0 h h)
  (dk-cite! 'gpow-zero 'g '(phi al))
  (dk-cite! 'group-left-id 'g (list 'phi h))
  (dk-rewrite-h! (list '= (ex4-P h) (ex4-op '(GPOW g (phi al) 0) (list 'phi h))) '(GPOW g (phi al) 0) ex4-E)
  (dk-rewrite-h! (list '= (ex4-P h) (ex4-op ex4-E (list 'phi h))) (ex4-op ex4-E (list 'phi h)) (list 'phi h)))
(sp (make-wff (ex4-forall '(g al phi t) (ex4-implies (append ex4-hyps (list '(IN t (CCINT 0 al))))
   (list '= (list ex4-psi 't) '(phi t))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'group-identity-in 'g)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ccint-membership 0 'al 't))))
(dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) 't)
(dk-cite! 'opg-ext-apply 'g 'al 'phi 't)
(subst (list '= (list ex4-psi 't) (ex4-P 't)))
(use-em '(< t al)
  (lambda () (ex4-small! 't) (ex4-ass!))
  (lambda ()
    (dk-cite! 'rr-lt-trichotomy 't 'al)
    (dk-cite! 'rr-lt-not-le 'al 't)
    (dk-have! '(= t al) (lambda () (if (dk-only! '(OR (< t al) (OR (= t al) (< al t))) '(NOT (< t al))
                                                 '(IMPLIES (< al t) (NOT (<= t al))) '(<= t al)) (prop))))
    (subst '(= t al))
    (dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
    (dk-have! '(<= al al) (lambda () (dk-ineq!)))
    (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
    (ex4-cc! 'al) (ex4-cc! 0)
    (dk-have! '(IN 1 NN) (lambda () (arith)))
    (dk-real! '(+ (* 1 al) 0))
    (dk-have! '(= al (+ (* 1 al) 0)) (lambda () (crs)))
    (dk-cite! 'opg-val-nonneg 'g 'al 'phi 1 0 'al)
    (dk-cite! 'gpow-one 'g '(phi al))
    (dk-cite! 'segment-at-zero 'g 'al 'phi)
    (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g '(phi al))))
    (subst (list '= (ex4-P 'al) (ex4-op '(GPOW g (phi al) 1) '(phi 0))))
    (subst (list '= '(GPOW g (phi al) 1) '(phi al)))
    (subst (list '= '(phi 0) ex4-E))
    (subst (list '= (ex4-op '(phi al) ex4-E) '(phi al)))
    (ex4-ass-rfl!)))
(qed 'opg-ext-extends)
(topic! 'opg-ext-extends 'analysis)

;;; ---- continuity ----
(define ex4-stmts '())
(define (ex4-keep! nm f) (set! ex4-stmts (cons (cons nm f) ex4-stmts)) f)
(define (ex4-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map ex4-subst e)) (#t e)))
(define (ex4-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt ex4-stmts)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (ex4-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))
(define (ex4-seg-open!)                  ; the parts of the segment and of the group topology
  (dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-group-segment 's 'g 'al 'phi))))
  (dk-cite! 'rr-pos-rr-in-rr 'al)
  (dk-cite! 'rr-lt-of-pos-rr 'al)
  (fact 'rr-zero-in) (fact 'group-identity-in 'g))
(define (ex4-pts! x)                     ; x in CARR g: x in PTS s
  (if (not (dk-asm? (list 'IN x '(PTS s))))
      (dk-rewrite-h! (list 'IN x '(CARR g)) '(CARR g) '(PTS s))))
(define ex4-SC-head 'gst_)
(sp (make-wff (ex4-keep! 'opg-val-continuous-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (ex4-forall '(al phi) (ex4-implies (list '(IS-GROUP-SEGMENT s g al phi))
     (ex4-forall '(t) (ex4-implies (list '(IN t RR))
       (ex4-forall '(W) (ex4-implies (list '(IN W (OPENS s)) (list 'IN (ex4-P 't) 'W))
         (list 'FORSOME 'd (list 'AND '(POS-RR d)
           (list 'FORALL 'v (list 'IMPLIES '(IN v RR) (list 'IMPLIES '(< (abs (- v t)) d) (list 'IN (ex4-P 'v) 'W))))))))))))))))))
(dk-peel!)
(ex4-seg-open!)
(define ex4-SC (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'gst_))) "the segment's continuity"))
(dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(ex4-cc! 0)
(dk-cite! 'segment-at-zero 'g 'al 'phi)
(ex4-pt! 't)
(define ex4-at (ex4-P 't))
(define ex4-a (ex4-inv ex4-at))
(dk-cite! 'group-inv-in 'g ex4-at)
(dk-cite! 'group-inv-inv 'g ex4-at)
(define ex4-W1 (list 'SEP 'tz_ '(PTS s) (list 'IN (ex4-op (ex4-inv ex4-a) 'tz_) 'W)))
(define ex4-W2 (list 'SEP 'iz_ '(PTS s) (list 'IN (ex4-inv 'iz_) ex4-W1)))
(dk-cite! 'top-group-translate-open-gt 's 'g ex4-a 'W)
(dk-cite! 'top-group-inv-open-gt 's 'g ex4-W1)
(ex4-pts! ex4-E)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g ex4-at)))
(dk-cite! 'group-inv-iden 'g)
(dk-have! (list 'IN ex4-E ex4-W1)
  (lambda () (in-sep! (lambda () (ex4-ass!))
                      (lambda () (subst (list '= (ex4-inv ex4-a) ex4-at)) (subst (list '= (ex4-op ex4-at ex4-E) ex4-at)) (ex4-ass!)))))
(dk-have! (list 'IN ex4-E ex4-W2)
  (lambda () (in-sep! (lambda () (ex4-ass!))
                      (lambda () (subst (list '= (ex4-inv ex4-E) ex4-E)) (ex4-ass!)))))
(define (ex4-delta! Wk)                  ; phi continuous at 0 into Wk: returns (dk Ck)
  (dk-have! (list 'IN '(phi 0) Wk) (lambda () (subst (list '= '(phi 0) ex4-E)) (ex4-ass!)))
  (let* ((dd (dk-skolem! (dk-apply! ex4-SC 0 Wk))))
    (ex4-split-if! (lambda (h) (dk-contains? h dd)))
    (dk-cite! 'rr-pos-rr-in-rr dd)
    (dk-cite! 'rr-lt-of-pos-rr dd)
    (list dd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h dd) (dk-contains? h Wk))) "the clause"))))
(let* ((dc1 (ex4-delta! ex4-W1)) (d1 (car dc1)) (c1 (cadr dc1))
       (dc2 (ex4-delta! ex4-W2)) (d2 (car dc2)) (c2 (cadr dc2))
       (m12 (list 'min d1 d2)) (dd (list 'min m12 'al)))
  (dk-cite! 'rr-min-closed d1 d2) (dk-cite! 'rr-min-closed m12 'al)
  (dk-cite! 'rr-lt-min 0 d1 d2) (dk-cite! 'rr-lt-min 0 m12 'al)
  (dk-cite! 'rr-min-le-left d1 d2) (dk-cite! 'rr-min-le-right d1 d2)
  (dk-cite! 'rr-min-le-left m12 'al) (dk-cite! 'rr-min-le-right m12 'al)
  (dk-cite! 'rr-pos-rr-of-lt dd)
  (ew dd)
  (dk-conj-close!
   (lambda ()
     (if (dk-head-is? (dk-goal) 'FORALL)
         (let* ((pl (dk-peel!))
                (v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) pl))))
                (h (list '- v 't)) (nh (list '- 0 h)))
           (dk-real! h) (dk-real! nh)
           (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts h dd)))
           (define ex4-lowb (dk-pick (lambda (q) (and (dk-head-is? q '<) (equal? (caddr q) h) (dk-contains? (cadr q) dd))) "the lower bound"))
           (dk-cite! 'opg-val-additive 'g 'al 'phi 't h)
           (dk-real! (list '+ 't h))
           (dk-have! (list '= (list '+ 't h) v) (lambda () (crs)))
           (dk-rewrite-h! (list '= (ex4-P (list '+ 't h)) (ex4-op ex4-at (ex4-P h))) (list '+ 't h) v)
           (ex4-pt! h)
           ;; P(h) in W1
           (dk-have! (list 'IN (ex4-P h) ex4-W1)
             (lambda ()
               (use-em (list '< h 0)
                 (lambda ()
                   (dk-have! (list '<= 0 nh) (lambda () (dk-ineq! (list '< h 0))))
                   (dk-have! (list '< nh 'al) (lambda () (dk-ineq! ex4-lowb (list '<= dd 'al))))
                   (dk-have! (list '<= nh 'al) (lambda () (dk-ineq! (list '< nh 'al))))
                   (ex4-cc! nh)
                   (dk-cite! 'opg-val-negative 'g 'al 'phi h)
                   (ex4-small! nh)
                   (dk-real! (list '- nh 0))
                   (dk-have! (list '<= 0 (list '- nh 0)) (lambda () (dk-ineq! (list '<= 0 nh))))
                   (dk-cite! 'rr-abs-of-nonneg (list '- nh 0))
                   (dk-cite! 'rr-abs-closed (list '- nh 0))
                   (dk-have! (list '< (list 'abs (list '- nh 0)) d2)
                     (lambda () (dk-ineq! (list '= (list 'abs (list '- nh 0)) (list '- nh 0)) ex4-lowb
                                          (list '<= dd m12) (list '<= m12 d2))))
                   (dk-apply! c2 nh)
                   (dk-landed (lambda () (sep-me (list 'IN (list 'phi nh) ex4-W2))))
                   (subst (list '= (ex4-P h) (ex4-inv (ex4-P nh))))
                   (subst (list '= (ex4-P nh) (list 'phi nh)))
                   (ex4-ass!))
                 (lambda ()
                   (dk-cite! 'rr-lt-trichotomy h 0)
                   (dk-have! (list '<= 0 h)
                     (lambda () (use-em (list '= h 0)
                                  (lambda () (dk-ineq! (list '= h 0)))
                                  (lambda () (dk-have! (list '< 0 h) (lambda () (if (dk-only! (list 'OR (list '< h 0) (list 'OR (list '= h 0) (list '< 0 h)))
                                                                                              (list 'NOT (list '< h 0)) (list 'NOT (list '= h 0))) (prop))))
                                             (dk-ineq! (list '< 0 h))))))
                   (dk-have! (list '< h 'al) (lambda () (dk-ineq! (list '< h dd) (list '<= dd 'al))))
                   (dk-have! (list '<= h 'al) (lambda () (dk-ineq! (list '< h 'al))))
                   (ex4-cc! h)
                   (ex4-small! h)
                   (dk-real! (list '- h 0))
                   (dk-have! (list '<= 0 (list '- h 0)) (lambda () (dk-ineq! (list '<= 0 h))))
                   (dk-cite! 'rr-abs-of-nonneg (list '- h 0))
                   (dk-cite! 'rr-abs-closed (list '- h 0))
                   (dk-have! (list '< (list 'abs (list '- h 0)) d1)
                     (lambda () (dk-ineq! (list '= (list 'abs (list '- h 0)) (list '- h 0)) (list '< h dd)
                                          (list '<= dd m12) (list '<= m12 d1))))
                   (dk-apply! c1 h)
                   (subst (list '= (ex4-P h) (list 'phi h)))
                   (ex4-ass!)))))
           (dk-landed (lambda () (sep-me (list 'IN (ex4-P h) ex4-W1))))
           (dk-rewrite-h! (list 'IN (ex4-op (ex4-inv ex4-a) (ex4-P h)) 'W) (ex4-inv ex4-a) ex4-at)
           (subst (list '= (ex4-P v) (ex4-op ex4-at (ex4-P h))))
           (ex4-ass!))
         (ex4-ass!)))))
(qed 'opg-val-continuous-gt)
(topic! 'opg-val-continuous-gt 'analysis)

;;; ---- Proposition 5.36, existence ----
(sp (make-wff (ex4-keep! 'one-parameter-group-extension-exists-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (ex4-forall '(al phi) (ex4-implies (list '(IS-GROUP-SEGMENT s g al phi))
     '(FORSOME psi (AND (IS-ONE-PARAMETER-GROUP s g psi)
                        (FORALL t (IMPLIES (IN t (CCINT 0 al)) (= (psi t) (phi t))))))))))))))
(dk-peel!)
(ex4-seg-open!)
(dk-cite! 'opg-ext-fun 'g 'al 'phi)
(define (ex4-app! x) (dk-real! x) (dk-cite! 'opg-ext-apply 'g 'al 'phi x) (ex4-pt! x))
(ew ex4-psi)
(dk-conj-close!
 (lambda ()
   (cond
    ((dk-head-is? (dk-goal) 'IS-ONE-PARAMETER-GROUP)
     (let ((iff (dk-cite! 'is-one-parameter-group 's 'g ex4-psi)))
       (dk-have! (caddr iff)
         (lambda ()
           (dk-conj-close!
            (lambda ()
              (cond
               ((dk-asm? (dk-goal)) (ass))
               ((and (dk-head-is? (dk-goal) 'FORALL) (eq? (cadr (dk-goal)) 'oqr_))
                (let* ((pl (dk-peel!)) (gl (dk-goal))
                       (r (cadr (cadr (cadr gl)))) (u (caddr (cadr (cadr gl)))))
                  (ex4-app! (list '+ r u)) (ex4-app! r) (ex4-app! u)
                  (dk-cite! 'opg-val-additive 'g 'al 'phi r u)
                  (subst (list '= (list ex4-psi (list '+ r u)) (ex4-P (list '+ r u))))
                  (subst (list '= (list ex4-psi r) (ex4-P r)))
                  (subst (list '= (list ex4-psi u) (ex4-P u)))
                  (ex4-ass!)))
               (#t
                (let* ((pl (dk-peel!))
                       (tin (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl)))
                       (t (cadr tin))
                       (win (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(OPENS s)))) pl)))
                       (W (cadr win)))
                  (ex4-app! t)
                  (dk-rewrite-h! (list 'IN (list ex4-psi t) W) (list ex4-psi t) (ex4-P t))
                  (let ((d (dk-skolem! (dk-cite! 'opg-val-continuous-gt 's 'g 'al 'phi t W))))
                    (ex4-split-if! (lambda (h) (dk-contains? h d)))
                    (ew d)
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'FORALL)
                           (let* ((pl2 (dk-peel!))
                                  (v (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl2)))))
                             (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h d) (dk-contains? h W))) "the delta clause") v)
                             (ex4-app! v)
                             (subst (list '= (list ex4-psi v) (ex4-P v)))
                             (ex4-ass!))
                           (ex4-ass!))))))))))))
       (dk-meta-iff-l! iff)
       (ex4-ass!)))
    ((dk-head-is? (dk-goal) 'FORALL)
     (let ((t (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
       (dk-cite! 'opg-ext-extends 'g 'al 'phi t)
       (ex4-ass!)))
    (#t (ex4-ass!)))))
(qed 'one-parameter-group-extension-exists-gt)
(topic! 'one-parameter-group-extension-exists-gt 'analysis)
(ex4-lift! 'one-parameter-group-extension-exists-gt 'one-parameter-group-extension-exists)
(ex4-lift! 'opg-val-continuous-gt 'opg-val-continuous)
