;;; gn-dual.scm -- Proposition 1.26 of F. J. Thayer, "Banach Algebras and Applications", ch. 1: a unital
;;; algebra homomorphism f : A -> B induces the continuous map phi-hat : B-hat -> A-hat, omega |-> omega o f.
;;; Agent BA-1117-GN, wave 2026-11-17.  All proofs modulo 0.  Destination: theorem-library/gn-dual.scm, after
;;; structure-library/gn-vocab (DUAL-MAP).  Library: operator-algebras.  Helper prefix gnd-.  Binders gnd*_.
;;;
;;; Stated for unital Banach algebras and an f given by its algebra laws as curried antecedents (the notes
;;; ask for commutative C*-algebras and an involution-preserving f; neither is used).  THE ROUTE.  omega o f
;;; is linear, multiplicative and unital, so a character.  Continuity into the subspace CHARACTERS(a) of the
;;; product of copies of CC (hom-into-subspace) is continuity of every coordinate (tprod-hom-iff), and the
;;; coordinate at y is omega |-> omega(f y) = G_b(f y), continuous (gelfand-transform-continuous).

(define (gnd-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-dual: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 300)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-dual: unfinished" name))))
(define (gnd-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gnd-ass!) (if (and (gnd-open?) (dk-asm? (dk-goal))) (ass)))
(define (gnd-detach-all! f)
  (let loop ((ch f))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gnd-cite2! . args) (gnd-detach-all! (apply dk-cite! args)))
(define (gnd-char-open! s c)           ; c in CHARACTERS(s): land c in FUN, and return (add act mul one)
  (let* ((m0 (list 'IN c (list 'CHARACTERS s)))
         (body (caddr (dk-cite! 'bas-characters-unfold s)))
         (m1 (dk-rewrite-h! m0 (list 'CHARACTERS s) body))
         (rest (subst-free 'bac_ c (caddr (cadddr body)))))
    (dk-project! (list 'IN c (list 'FUN (list 'VEC s) 'CC)) (lambda () (sep-me m1)))
    (dk-project! (list 'IS-CC-LINEAR-ON s c) (lambda () (sep-me m1)))
    (dk-project! (cadr rest) (lambda () (sep-me m1)))
    (dk-project! (caddr rest) (lambda () (sep-me m1)))
    (let* ((ld (caddr (dk-cite! 'is-cc-linear-on s c)))
           (la (dk-project! (cadr (caddr ld)) 'is-cc-linear-on (list 'IS-CC-LINEAR-ON s c)))
           (lm (dk-project! (caddr (caddr ld)) 'is-cc-linear-on (list 'IS-CC-LINEAR-ON s c))))
      (list la lm (cadr rest) (caddr rest)))))
(define (gnd-fty! v) (if (not (dk-asm? (list 'IN (list 'f v) '(VEC b)))) (dk-cite! 'fun-apply-type-c 'f '(VEC a) '(VEC b) v)))
(define (gnd-wty! w v) (if (not (dk-asm? (list 'IN (list w v) 'CC))) (dk-cite! 'fun-apply-type-c w '(VEC b) 'CC v)))
(define (gnd-vty! s v) (if (not (dk-asm? (list 'IN v (list 'VEC s)))) (dk-cite! 'kal-uba-in s v)))

(define gnd-hyps
  '(IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (IMPLIES (IS-UNITAL-BANACH-ALGEBRA b) (IMPLIES (IN f (FUN (VEC a) (VEC b)))
    (IMPLIES (FORALL gndx_ (IMPLIES (IN gndx_ (VEC a)) (FORALL gndy_ (IMPLIES (IN gndy_ (VEC a))
               (= (f ((VADD a) gndx_ gndy_)) ((VADD b) (f gndx_) (f gndy_)))))))
    (IMPLIES (FORALL gndz_ (IMPLIES (IN gndz_ CC) (FORALL gndx_ (IMPLIES (IN gndx_ (VEC a))
               (= (f ((ACT a) gndz_ gndx_)) ((ACT b) gndz_ (f gndx_)))))))
    (IMPLIES (FORALL gndx_ (IMPLIES (IN gndx_ (VEC a)) (FORALL gndy_ (IMPLIES (IN gndy_ (VEC a))
               (= (f ((VMUL a) gndx_ gndy_)) ((VMUL b) (f gndx_) (f gndy_)))))))
    (IMPLIES (= (f (VONE a)) (VONE b))
      BODY))))))))
(define (gnd-tree-replace old new e) (cond ((eq? e old) new) ((pair? e) (map (lambda (s) (gnd-tree-replace old new s)) e)) (#t e)))
(define (gnd-stmt body) (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f (gnd-tree-replace 'BODY body gnd-hyps)))))
(define (gnd-law head)                 ; the hypothesis on f carrying (HEAD a)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (list head 'a)) (dk-contains? h (list head 'b)))) (symbol->string head)))
;;; omega o f is a character of a
(define gnd-C '(COMPOSE w f))
(define (gnd-goal-args)                ; the arguments of the outer application on the goal's left side
  (cdr (cadr (cadr (dk-goal)))))
(sp (make-wff (gnd-stmt '(FORALL w (IMPLIES (IN w (CHARACTERS b)) (IN (COMPOSE w f) (CHARACTERS a)))))))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(dk-cite! 'bal-uba-vone-in 'a) (dk-cite! 'bal-uba-vone-in 'b)
(define gnd-laws (gnd-char-open! 'b 'w))
(gnd-cite2! 'compose-type '(VEC a) '(VEC b) 'CC 'w 'f)
(define gnd-ca (gnd-cite2! 'compose-apply '(VEC a) '(VEC b) 'CC 'w 'f))
(define (gnd-cv! v) (gnd-detach-all! (dk-apply! gnd-ca v)))       ; land C(v) = w(f v)
(define (gnd-law-close!)
  (let ((g2 (dk-goal)))
    (cond
     ((dk-head-is? g2 'IN) (gnd-ass!))
     ((dk-contains? g2 '(VADD a))
      (dk-peel!)
      (let* ((xy (cdr (cadr (cadr (dk-goal))))) (x (car xy)) (y (cadr xy)))
        (dk-cite! 'kal-uba-vadd-in 'a x y)
        (subst (gnd-cv! (list '(VADD a) x y))) (subst (gnd-cv! x)) (subst (gnd-cv! y))
        (gnd-fty! x) (gnd-fty! y)
        (subst (gnd-detach-all! (dk-apply! (gnd-law 'VADD) x y)))
        (subst (gnd-detach-all! (dk-apply! (car gnd-laws) (list 'f x) (list 'f y))))
        (if (gnd-open?) (begin (gnd-wty! 'w (list 'f x)) (gnd-wty! 'w (list 'f y)) (rfl)))))
     (#t
      (dk-peel!)
      (let* ((zx (cdr (cadr (cadr (dk-goal))))) (z (car zx)) (x (cadr zx)))
        (dk-cite! 'kal-uba-act-in 'a z x)
        (subst (gnd-cv! (list '(ACT a) z x))) (subst (gnd-cv! x))
        (gnd-fty! x)
        (subst (gnd-detach-all! (dk-apply! (gnd-law 'ACT) z x)))
        (subst (gnd-detach-all! (dk-apply! (cadr gnd-laws) z (list 'f x))))
        (if (gnd-open?) (begin (gnd-wty! 'w (list 'f x)) (rfl))))))))
(subst (dk-cite! 'bas-characters-unfold 'a))
(in-sep! (lambda () (gnd-ass!))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
           ((dk-head-is? g 'IS-CC-LINEAR-ON)
            (let ((i (dk-cite! 'is-cc-linear-on 'a gnd-C)))
              (dk-have! (caddr i) (lambda () (dk-conj-close! gnd-law-close!)))
              (if (dk-only! i (caddr i)) (prop))))
           ((dk-head-is? g 'FORALL)
            (dk-peel!)
            (let* ((xy (cdr (cadr (cadr (dk-goal))))) (x (car xy)) (y (cadr xy)))
              (dk-cite! 'kal-uba-vmul-in 'a x y)
              (subst (gnd-cv! (list '(VMUL a) x y))) (subst (gnd-cv! x)) (subst (gnd-cv! y))
              (gnd-fty! x) (gnd-fty! y)
              (subst (gnd-detach-all! (dk-apply! (gnd-law 'VMUL) x y)))
              (subst (gnd-detach-all! (dk-apply! (caddr gnd-laws) (list 'f x) (list 'f y))))
              (if (gnd-open?) (begin (gnd-wty! 'w (list 'f x)) (gnd-wty! 'w (list 'f y)) (rfl)))))
           (#t
            (subst (gnd-cv! '(VONE a)))
            (subst '(= (f (VONE a)) (VONE b)))
            (dk-have! (cadddr gnd-laws) (lambda () (gnd-ass!)))
            (subst (cadddr gnd-laws))
            (if (gnd-open?) (rfl)))))))))
(gnd-qed! 'dual-map-character)

;;; ---- the unfoldings, as theorems ----
(define gnd-MT '(METRIC-TOP CC-MS))
(define (gnd-cf s) (list 'VNB-LAMBDA 'bgx_ (list 'VEC s) gnd-MT))
(define (gnd-P s) (list 'TPRODUCT-TOP (list 'VEC s) (gnd-cf s)))
(define (gnd-PP s) (list 'TPROD-PTS (list 'VEC s) (gnd-cf s)))
(sp (make-wff (list 'FORALL 'a (list '== '(GELFAND-SPACE a) (list 'SUBSPACE-TOP (gnd-P 'a) '(CHARACTERS a))))))
(di) (mac 'GELFAND-SPACE) (qrfl)
(gnd-qed! 'gelfand-space-unfold)
(sp (make-wff '(FORALL b (FORALL f (== (DUAL-MAP b f) (VNB-LAMBDA gnvw_ (CHARACTERS b) (COMPOSE gnvw_ f)))))))
(di) (mac 'DUAL-MAP) (qrfl)
(gnd-qed! 'dual-map-unfold)

;;; 1.26: phi-hat is continuous from B-hat to A-hat
(define gnd-F '(DUAL-MAP b f))
(define gnd-GSa '(GELFAND-SPACE a))
(define gnd-GSb '(GELFAND-SPACE b))
(define gnd-PTb '(PTS (GELFAND-SPACE b)))
(define (gnd-Gb v) (list '(GELFAND-TRANSFORM b) v))
(sp (make-wff (gnd-stmt (list 'AND '(FORALL w (IMPLIES (IN w (CHARACTERS b)) (= ((DUAL-MAP b f) w) (COMPOSE w f))))
                               (list 'IS-HOM-TOP-SPACE gnd-GSb gnd-GSa gnd-F)))))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a) (dk-cite! 'bal-uba-vec-set 'b)
(dk-cite! 'characters-in-set 'a) (dk-cite! 'characters-in-set 'b)
(dk-cite! 'gelfand-space-compact 'b)
(dk-project! (list 'IS-TOP-SPACE gnd-GSb) 'IS-COMPACT-T (list 'IS-COMPACT-T gnd-GSb))
(dk-cite! 'gelfand-space-pts 'b)
(dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS) (dk-cite! 'cc-metric-top-pts)
(dk-cite! 'cc-product-family '(VEC a))
(dk-cite! 'tprod-top-pts '(VEC a) (gnd-cf 'a))
(dk-cite! 'tprod-top-is-top-space '(VEC a) (gnd-cf 'a))
(define (gnd-cty! w)                   ; w a character of b: COMPOSE(w, f) in FUN(VEC a, CC) and in the product
  (gnd-char-open! 'b w)
  (gnd-cite2! 'compose-type '(VEC a) '(VEC b) 'CC w 'f)
  (dk-cite! 'fun-in-cc-product '(VEC a) (list 'COMPOSE w 'f)))
(define (gnd-in-chb! q)                ; q in PTS(GS b) in context: land q in CHARACTERS b
  (if (not (dk-asm? (list 'IN q '(CHARACTERS b)))) (dk-rewrite-h! (list 'IN q gnd-PTb) gnd-PTb '(CHARACTERS b))))
(define (gnd-Fv! w)                    ; w a character of b: land F(w) = COMPOSE(w, f)
  (let ((e (list '= (list gnd-F w) (list 'COMPOSE w 'f))))
    (if (not (dk-asm? e))
        (begin
          (gnd-cty! w)
          (dk-have! e (lambda () (subst (dk-cite! 'dual-map-unfold 'b 'f)) (if (not (dk-lam-b!)) (rfl))))))
    e))
(dk-have! (list 'IN gnd-F (list 'FUN gnd-PTb (gnd-PP 'a)))
  (lambda ()
    (subst (list '== gnd-PTb '(CHARACTERS b)))
    (subst (dk-cite! 'dual-map-unfold 'b 'f))
    (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (gnd-cty! w) (gnd-ass!)))
                  (lambda () (gnd-ass!)))))
(define gnd-part1 '(FORALL w (IMPLIES (IN w (CHARACTERS b)) (= ((DUAL-MAP b f) w) (COMPOSE w f)))))
(dk-have! gnd-part1 (lambda () (let ((w (dk-di-var!))) (gnd-Fv! w) (gnd-ass!))))
;; (A) continuous into the product: coordinatewise
(let* ((i (dk-cite! 'tprod-hom-iff '(VEC a) (gnd-cf 'a) gnd-GSb gnd-F))
       (rhs (caddr i)))
  (dk-have! rhs
    (lambda ()
      (let* ((ls (dk-peel!)) (k (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC a)))) ls))))
             (g (dk-goal)) (lam (cadddr g)))
        (gnd-fty! k)
        (dk-have! (list '= (list (gnd-cf 'a) k) gnd-MT) (lambda () (if (not (dk-lam-b!)) (rfl))))
        (subst (list '= (list (gnd-cf 'a) k) gnd-MT))
        (dk-cite! 'gelfand-transform-in-fun 'b (list 'f k))
        (dk-fun-ext! lam (gnd-Gb (list 'f k)) gnd-PTb 'CC
          (lambda ()
            (dk-lam-type! (lambda () (let ((q (dk-di-var!)))
                                       (gnd-in-chb! q) (gnd-Fv! q)
                                       (subst (list '= (list gnd-F q) (list 'COMPOSE q 'f)))
                                       (gnd-cty! q)
                                       (dk-cite! 'fun-apply-type-c (list 'COMPOSE q 'f) '(VEC a) 'CC k)
                                       (gnd-ass!)))
                          (lambda () (dk-cite! 'gelfand-space-pts 'b) (subst (list '== gnd-PTb '(CHARACTERS b))) (gnd-ass!))))
          (lambda () (subst (list '== gnd-PTb '(CHARACTERS b))) (gnd-ass!))
          (lambda (q)
            (gnd-in-chb! q) (gnd-Fv! q)
            (gnd-cty! q)
            (dk-cite! 'fun-apply-type-c (list 'COMPOSE q 'f) '(VEC a) 'CC k)
            (dk-lam-b!)
            (subst (list '= (list gnd-F q) (list 'COMPOSE q 'f)))
            (subst (gnd-detach-all! (dk-apply! (gnd-cite2! 'compose-apply '(VEC a) '(VEC b) 'CC q 'f) k)))
            (subst (dk-cite! 'gelfand-transform-value 'b (list 'f k) q))
            (if (gnd-open?) (begin (gnd-wty! q (list 'f k)) (rfl)))))
        (subst (list '= lam (gnd-Gb (list 'f k))))
        (dk-cite! 'gelfand-transform-continuous 'b (list 'f k))
        (gnd-ass!))))
  (dk-have! (cadr i) (lambda () (if (dk-only! i rhs) (prop)))))
;; (B) the characters of a lie in the product
(dk-have! (list 'SUBSET '(CHARACTERS a) (list 'PTS (gnd-P 'a)))
  (lambda ()
    (mac 'subset-def)
    (let ((v (dk-di-var!)))
      (dk-cite! 'character-in-fun 'a v)
      (dk-cite! 'fun-in-cc-product '(VEC a) v)
      (subst (list '== (list 'PTS (gnd-P 'a)) (gnd-PP 'a)))
      (gnd-ass!))))
;; (C) into the subspace
(let ((imp (dk-cite! 'hom-into-subspace gnd-GSb (gnd-P 'a) '(CHARACTERS a) gnd-F)))
  (detach-with! imp
    (lambda ()
      (let ((w (dk-di-var!)))
        (gnd-in-chb! w) (gnd-Fv! w)
        (subst (list '= (list gnd-F w) (list 'COMPOSE w 'f)))
        (dk-cite! 'dual-map-character 'a 'b 'f w)
        (gnd-ass!)))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (gnd-ass!)
        (begin (subst (dk-cite! 'gelfand-space-unfold 'a)) (gnd-ass!)))))
(gnd-qed! 'dual-map-continuous)

;;; =====================================================================================================
;;; 1.28: a continuous g : B-hat -> A-hat (a, b commutative C*-algebras) is the dual map of the unital
;;; *-homomorphism P = DUAL-PULL(a, b, g), x |-> G_b^-1(G_a(x) o g) (onto by 1.23), and of no other map.
;;; =====================================================================================================
(define gnd-P '(DUAL-PULL a b g))
(define (gnd-Pv x) (list gnd-P x))
(define (gnd-GT s v) (list (list 'GELFAND-TRANSFORM s) v))
(define (gnd-GS s) (list 'GELFAND-SPACE s))
(define (gnd-PT s) (list 'PTS (list 'GELFAND-SPACE s)))
(define (gnd-CH s) (list 'CHARACTERS s))
(define gnd-h28 '(IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA b)
  (IMPLIES (IS-HOM-TOP-SPACE (GELFAND-SPACE b) (GELFAND-SPACE a) g) BODY))))
(define (gnd-stmt28 body) (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'g (gnd-tree-replace 'BODY body gnd-h28)))))
(define (gnd-setup28!)
  (for-each (lambda (s)
              (dk-cite! 'bcs-ccsa-ucsa s) (dk-cite! 'bcp-ucsa-uiba s)
              (dk-cite! 'bcs-uiba-is-uba s)
              (dk-cite! 'gno-u-pts s) (dk-cite! 'gno-u-pts-set s) (dk-cite! 'gno-u-compact s)
              (dk-project! (list 'IS-TOP-SPACE (gnd-GS s)) 'IS-COMPACT-T (list 'IS-COMPACT-T (gnd-GS s))))
            '(a b))
  (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS) (dk-cite! 'cc-metric-top-pts)
  (dk-project! (list 'IN 'g (list 'FUN (gnd-PT 'b) (gnd-PT 'a))) 'is-hom-top-space-def
               (list 'IS-HOM-TOP-SPACE (gnd-GS 'b) (gnd-GS 'a) 'g)))
(define (gnd-vin! s v)                 ; v in VEC s for s a unital involutive one: typing via the kit
  (if (not (dk-asm? (list 'IN v (list 'VEC s))))
      (cond ((and (pair? v) (equal? (car v) (list 'VADD s))) (gnd-vin! s (cadr v)) (gnd-vin! s (caddr v)) (dk-cite! 'kal-uiba-vadd-in s (cadr v) (caddr v)))
            ((and (pair? v) (equal? (car v) (list 'VMUL s))) (gnd-vin! s (cadr v)) (gnd-vin! s (caddr v)) (dk-cite! 'kal-uiba-vmul-in s (cadr v) (caddr v)))
            ((and (pair? v) (equal? (car v) (list 'ACT s))) (gnd-vin! s (caddr v)) (dk-cite! 'kal-uiba-act-in s (cadr v) (caddr v)))
            ((and (pair? v) (equal? (car v) (list 'VSTAR s))) (gnd-vin! s (cadr v)) (dk-cite! 'kal-uiba-vstar-in s (cadr v)))
            ((equal? v (list 'VONE s)) (dk-cite! 'kal-uiba-vone-in s))
            ((and (pair? v) (equal? (car v) gnd-P)) (gnd-vin! 'a (cadr v)) (dk-split-all! (list (dk-cite! 'dual-pull-spec 'a 'b 'g (cadr v)))))
            (#t (error "gnd-vin!: cannot type" (expression->string v))))))
(define (gnd-gw! w)                    ; w a character of b: land w in PTS(GS b), (g w) in PTS(GS a) and in CHARACTERS a
  (if (not (dk-asm? (list 'IN w (gnd-PT 'b))))
      (dk-have! (list 'IN w (gnd-PT 'b)) (lambda () (subst (list '== (gnd-PT 'b) (gnd-CH 'b))) (gnd-ass!))))
  (dk-cite! 'fun-apply-type-c 'g (gnd-PT 'b) (gnd-PT 'a) w)
  (if (not (dk-asm? (list 'IN (list 'g w) (gnd-CH 'a))))
      (dk-rewrite-h! (list 'IN (list 'g w) (gnd-PT 'a)) (gnd-PT 'a) (gnd-CH 'a))))

(sp (make-wff '(FORALL a (FORALL b (FORALL g (== (DUAL-PULL a b g) (VNB-LAMBDA gnvx_ (VEC a) (CHOICE (SEP gnvy_ (VEC b)
     (= ((GELFAND-TRANSFORM b) gnvy_) (COMPOSE ((GELFAND-TRANSFORM a) gnvx_) g)))))))))))
(di) (mac 'DUAL-PULL) (qrfl)
(gnd-qed! 'dual-pull-unfold)

;;; P(x) is in b and G_b(P x) = G_a(x) o g
(sp (make-wff (gnd-stmt28 (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'AND (list 'IN (gnd-Pv 'x) '(VEC b)) (list '= (gnd-GT 'b (gnd-Pv 'x)) (list 'COMPOSE (gnd-GT 'a 'x) 'g))))))))
(dk-peel!)
(gnd-setup28!)
(let* ((K (list 'COMPOSE (gnd-GT 'a 'x) 'g))
       (S (list 'SEP 'gnvy_ '(VEC b) (list '= '((GELFAND-TRANSFORM b) gnvy_) K))))
  (dk-cite! 'gno-u-in-ccont 'a 'x)
  (dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'a) (gnd-GT 'a 'x))))
  (dk-cite! 'hom-top-space-compose (gnd-GS 'b) (gnd-GS 'a) gnd-MT 'g (gnd-GT 'a 'x))
  (gnd-cite2! 'compose-type (gnd-PT 'b) (gnd-PT 'a) 'CC (gnd-GT 'a 'x) 'g)
  (dk-have! (list 'IN K (list 'CCONT (gnd-GS 'b)))
    (lambda () (subst (dk-cite! 'ccont-unfold (gnd-GS 'b))) (in-sep! (lambda () (gnd-ass!)) (lambda () (gnd-ass!)))))
  (let* ((ex (dk-cite! 'gelfand-onto 'b K))
         (y (dk-skolem! ex)))
    (dk-split-all!)
    (dk-have! (list 'FORSOME 'gnvq_ (list 'IN 'gnvq_ S))
      (lambda () (ew y) (in-sep! (lambda () (gnd-ass!)) (lambda () (gnd-ass!)))))
    (dk-cite! 'choice-axiom S)
    (sep-me (list 'IN (list 'CHOICE S) S)) (dk-split-all!)
    (subst (dk-cite! 'dual-pull-unfold 'a 'b 'g))
    (dk-lam-b!)
    (if (gnd-open?) (dk-conj-close! (lambda () (gnd-ass!))))))
(gnd-qed! 'dual-pull-spec)

;;; its values: omega(P x) = (g omega)(x)
(sp (make-wff (gnd-stmt28 (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'w (list 'IMPLIES '(IN w (CHARACTERS b))
  (list '= (list 'w (gnd-Pv 'x)) '((g w) x)))))))))
(dk-peel!)
(gnd-setup28!)
(dk-split-all! (list (dk-cite! 'dual-pull-spec 'a 'b 'g 'x)))
(gnd-gw! 'w)
(dk-cite! 'gno-u-in-ccont 'a 'x)
(dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'a) (gnd-GT 'a 'x))))
(dk-cite! 'gno-u-value 'b (gnd-Pv 'x) 'w)
(dk-cite! 'gno-u-value 'a 'x '(g w))
(let ((ca (gnd-cite2! 'compose-apply (gnd-PT 'b) (gnd-PT 'a) 'CC (gnd-GT 'a 'x) 'g)))
  (dk-apply! ca 'w))
(gnd-cite2! 'eq-sym (list (gnd-GT 'b (gnd-Pv 'x)) 'w) (list 'w (gnd-Pv 'x)))
(subst (list '= (list 'w (gnd-Pv 'x)) (list (gnd-GT 'b (gnd-Pv 'x)) 'w)))
(subst (list '= (gnd-GT 'b (gnd-Pv 'x)) (list 'COMPOSE (gnd-GT 'a 'x) 'g)))
(subst (list '= (list (list 'COMPOSE (gnd-GT 'a 'x) 'g) 'w) (list (gnd-GT 'a 'x) '(g w))))
(subst (list '= (list (gnd-GT 'a 'x) '(g w)) '((g w) x)))
(if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) '(g w)) (rfl)))
(gnd-qed! 'dual-pull-value)

(define (gnd-Gb-eq! u v ptw!)          ; goal (= u v), u v in VEC b: by injectivity of G_b; PTW! p proves (= (p u) (p v))
  (gnd-vin! 'b u) (gnd-vin! 'b v)
  (dk-cite! 'gno-u-in-ccont 'b u) (dk-cite! 'gno-u-in-ccont 'b v)
  (let ((imp (dk-cite! 'gelfand-injective 'b u v)))
    (detach-with! imp
      (lambda ()
        (dk-fun-ext! (gnd-GT 'b u) (gnd-GT 'b v) (gnd-PT 'b) 'CC
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'b) (gnd-GT 'b u)))) (gnd-ass!))
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'b) (gnd-GT 'b v)))) (gnd-ass!))
          (lambda (p)
            (dk-rewrite-h! (list 'IN p (gnd-PT 'b)) (gnd-PT 'b) (gnd-CH 'b))
            (dk-cite! 'gno-u-value 'b u p) (dk-cite! 'gno-u-value 'b v p)
            (subst (list '= (list (gnd-GT 'b u) p) (list p u)))
            (subst (list '= (list (gnd-GT 'b v) p) (list p v)))
            (ptw! p)))))
    (gnd-ass!)))
(define (gnd-pv! x w)                  ; rewrite w(P x) to (g w)(x) in the goal
  (gnd-vin! 'a x)
  (subst (dk-cite! 'dual-pull-value 'a 'b 'g x w)))
(define (gnd-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-cite! 'fun-apply-type-c (car t) '(VEC a) 'CC (cadr t))))

;;; P is a function from VEC a to VEC b
(sp (make-wff (gnd-stmt28 (list 'IN gnd-P '(FUN (VEC a) (VEC b))))))
(dk-peel!)
(gnd-setup28!)
(dk-cite! 'bal-uba-vec-set '(UIBA-AS-UBA a)) (dk-cite! 'bcp-ro-vec 'a)
(dk-rewrite-h! (list 'IN '(VEC (UIBA-AS-UBA a)) 'SET) '(VEC (UIBA-AS-UBA a)) '(VEC a))
(let ((u (dk-cite! 'dual-pull-unfold 'a 'b 'g)))
  (subst u)
  (dk-lam-type! (lambda ()
                  (let* ((x (dk-di-var!))
                         (h0 (car (dk-split-all! (list (dk-cite! 'dual-pull-spec 'a 'b 'g x)))))
                         (h1 (dk-rewrite-h! (list 'IN (gnd-Pv x) '(VEC b)) gnd-P (caddr u))))
                    (dk-lam-b-h! h1)
                    (gnd-ass!)))
                (lambda () (gnd-ass!))))
(gnd-qed! 'dual-pull-fun)

;;; P is a unital *-homomorphism
(define (gnd-law28! name vars lhs-of rhs-of ptw!)
  (sp (make-wff (gnd-stmt28
    (let loop ((vs vars))
      (cond ((null? vs) (list '= (gnd-Pv (lhs-of)) (rhs-of)))
            ((eq? (car vs) 'z) (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (loop (cdr vs)))))
            (#t (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) '(VEC a)) (loop (cdr vs))))))))))
  (dk-peel!)
  (gnd-setup28!)
  (gnd-vin! 'a (lhs-of))
  (gnd-Gb-eq! (gnd-Pv (lhs-of)) (rhs-of)
    (lambda (p)
      (gnd-gw! p)
      (ptw! p)))
  (gnd-qed! name))
(gnd-law28! 'dual-pull-vadd '(x y) (lambda () '((VADD a) x y)) (lambda () (list '(VADD b) (gnd-Pv 'x) (gnd-Pv 'y)))
  (lambda (p)
    (subst (dk-cite! 'char-vadd 'b p (gnd-Pv 'x) (gnd-Pv 'y)))
    (gnd-pv! '((VADD a) x y) p) (gnd-pv! 'x p) (gnd-pv! 'y p)
    (subst (dk-cite! 'char-vadd 'a (list 'g p) 'x 'y))
    (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) (list 'g p)) (rfl)))))
(gnd-law28! 'dual-pull-vmul '(x y) (lambda () '((VMUL a) x y)) (lambda () (list '(VMUL b) (gnd-Pv 'x) (gnd-Pv 'y)))
  (lambda (p)
    (subst (dk-cite! 'char-vmul 'b p (gnd-Pv 'x) (gnd-Pv 'y)))
    (gnd-pv! '((VMUL a) x y) p) (gnd-pv! 'x p) (gnd-pv! 'y p)
    (subst (dk-cite! 'char-vmul 'a (list 'g p) 'x 'y))
    (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) (list 'g p)) (rfl)))))
(gnd-law28! 'dual-pull-act '(z x) (lambda () '((ACT a) z x)) (lambda () (list '(ACT b) 'z (gnd-Pv 'x)))
  (lambda (p)
    (subst (dk-cite! 'char-act 'b p 'z (gnd-Pv 'x)))
    (gnd-pv! '((ACT a) z x) p) (gnd-pv! 'x p)
    (subst (dk-cite! 'char-act 'a (list 'g p) 'z 'x))
    (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) (list 'g p)) (rfl)))))
(gnd-law28! 'dual-pull-star '(x) (lambda () '((VSTAR a) x)) (lambda () (list '(VSTAR b) (gnd-Pv 'x)))
  (lambda (p)
    (subst (dk-cite! 'character-preserves-involution 'b p (gnd-Pv 'x)))
    (gnd-pv! '((VSTAR a) x) p) (gnd-pv! 'x p)
    (subst (dk-cite! 'character-preserves-involution 'a (list 'g p) 'x))
    (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) (list 'g p)) (rfl)))))
(gnd-law28! 'dual-pull-one '() (lambda () '(VONE a)) (lambda () '(VONE b))
  (lambda (p)
    (subst (dk-cite! 'char-vone 'b p))
    (gnd-pv! '(VONE a) p)
    (subst (dk-cite! 'char-vone 'a (list 'g p)))
    (if (gnd-open?) (rfl))))

;;; g is the dual map of P: omega o P = g(omega) for every character omega of b
(sp (make-wff (gnd-stmt28 '(FORALL w (IMPLIES (IN w (CHARACTERS b)) (= ((DUAL-MAP b (DUAL-PULL a b g)) w) (g w)))))))
(dk-peel!)
(gnd-setup28!)
(gnd-gw! 'w)
(dk-cite! 'dual-pull-fun 'a 'b 'g)
(dk-cite! 'bal-uba-vec-set '(UIBA-AS-UBA a)) (dk-cite! 'bcp-ro-vec 'a)
(dk-rewrite-h! (list 'IN '(VEC (UIBA-AS-UBA a)) 'SET) '(VEC (UIBA-AS-UBA a)) '(VEC a))
(gnd-char-open! 'b 'w)
(gnd-char-open! 'a '(g w))
(let ((C (list 'COMPOSE 'w gnd-P)))
  (gnd-cite2! 'compose-type '(VEC a) '(VEC b) 'CC 'w gnd-P)
  (dk-have! (list '= (list (list 'DUAL-MAP 'b gnd-P) 'w) C)
    (lambda () (subst (dk-cite! 'dual-map-unfold 'b gnd-P)) (if (not (dk-lam-b!)) (rfl))))
  (subst (list '= (list (list 'DUAL-MAP 'b gnd-P) 'w) C))
  (dk-fun-ext! C '(g w) '(VEC a) 'CC
    (lambda () (gnd-ass!))
    (lambda () (gnd-ass!))
    (lambda (x)
      (dk-apply! (gnd-cite2! 'compose-apply '(VEC a) '(VEC b) 'CC 'w gnd-P) x)
      (subst (list '= (list C x) (list 'w (gnd-Pv x))))
      (gnd-pv! x 'w)
      (if (gnd-open?) (begin (dk-cite! 'fun-apply-type-c '(g w) '(VEC a) 'CC x) (rfl))))))
(gnd-qed! 'dual-pull-dual)

;;; uniqueness: a map f : VEC a -> VEC b with omega(f x) = (g omega)(x) for all omega, x is P
(sp (make-wff (gnd-stmt28 '(FORALL f (IMPLIES (IN f (FUN (VEC a) (VEC b)))
  (IMPLIES (FORALL w (IMPLIES (IN w (CHARACTERS b)) (FORALL x (IMPLIES (IN x (VEC a)) (= (w (f x)) ((g w) x))))))
    (FORALL x (IMPLIES (IN x (VEC a)) (= (f x) ((DUAL-PULL a b g) x))))))))))
(dk-peel!)
(gnd-setup28!)
(dk-cite! 'fun-apply-type-c 'f '(VEC a) '(VEC b) 'x)
(let ((hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(f x)) (dk-contains? h 'CHARACTERS))) "the values of f")))
  (gnd-Gb-eq! '(f x) (gnd-Pv 'x)
    (lambda (p)
      (gnd-gw! p)
      (subst (gnd-detach-all! (dk-apply! hyp p 'x)))
      (gnd-pv! 'x p)
      (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA a) (list 'g p)) (rfl))))))
(gnd-qed! 'dual-pull-unique)

;;; 1.28, one half of "P injective iff g onto": g onto gives P injective
(sp (make-wff (gnd-stmt28 '(IMPLIES (FORALL c (IMPLIES (IN c (CHARACTERS a)) (FORSOME gndw_ (AND (IN gndw_ (CHARACTERS b)) (= (g gndw_) c)))))
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL y (IMPLIES (IN y (VEC a))
    (IMPLIES (= ((DUAL-PULL a b g) x) ((DUAL-PULL a b g) y)) (= x y))))))))))
(dk-peel!)
(gnd-setup28!)
(gnd-vin! 'a 'x) (gnd-vin! 'a 'y)
(gnd-vin! 'b (gnd-Pv 'x)) (gnd-vin! 'b (gnd-Pv 'y))
(dk-cite! 'gno-u-in-ccont 'a 'x) (dk-cite! 'gno-u-in-ccont 'a 'y)
(let ((onto (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FORSOME))) "g onto"))
      (imp (dk-cite! 'gelfand-injective 'a 'x 'y)))
  (detach-with! imp
    (lambda ()
      (dk-fun-ext! (gnd-GT 'a 'x) (gnd-GT 'a 'y) (gnd-PT 'a) 'CC
        (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'a) (gnd-GT 'a 'x)))) (gnd-ass!))
        (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts (gnd-GS 'a) (gnd-GT 'a 'y)))) (gnd-ass!))
        (lambda (c)
          (dk-rewrite-h! (list 'IN c (gnd-PT 'a)) (gnd-PT 'a) (gnd-CH 'a))
          (dk-cite! 'gno-u-value 'a 'x c) (dk-cite! 'gno-u-value 'a 'y c)
          (subst (list '= (list (gnd-GT 'a 'x) c) (list c 'x)))
          (subst (list '= (list (gnd-GT 'a 'y) c) (list c 'y)))
          (let* ((ex (gnd-detach-all! (dk-apply! onto c)))
                 (w (dk-skolem! ex)))
            (dk-split-all!)
            (gnd-gw! w)
            (gnd-cite2! 'eq-sym (list 'g w) c)
            (subst (list '= c (list 'g w)))
            (let* ((vx (dk-cite! 'dual-pull-value 'a 'b 'g 'x w))
                  (vy (dk-cite! 'dual-pull-value 'a 'b 'g 'y w)))
              (gnd-cite2! 'eq-sym (cadr vx) (caddr vx))
              (gnd-cite2! 'eq-sym (cadr vy) (caddr vy))
              (subst (list '= (caddr vx) (cadr vx)))
              (subst (list '= (caddr vy) (cadr vy)))
              (subst (list '= (gnd-Pv 'x) (gnd-Pv 'y)))
              (if (gnd-open?) (begin (dk-cite! 'character-in-fun '(UIBA-AS-UBA b) w) (rfl)))))))))
  (gnd-ass!))
(gnd-qed! 'dual-pull-injective-of-onto)
