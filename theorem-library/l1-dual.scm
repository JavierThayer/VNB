      (let* ((ia (list 'INDICATOR 'omega (list ml5-d k))) (c (ml5-c k))
             (val (if (eqv? v 1) c 0)) (e (list '= (list (list ml5-g0 k) x) val)))
        (if (not (dk-asm? e))
            (begin
              (ml5-c-facts! k)
              (if (eqv? v 1)
                  (begin (ml5-et! c 1) (dk-have! (list '= (list '* c 1) c) (lambda () (crs))))
                  (dk-cite! 'etimes-zero-right c))
              (dk-have! e (lambda ()
                            (subst (ml5-g! k))
