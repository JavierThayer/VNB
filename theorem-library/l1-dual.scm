(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (ml1-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; ML1 OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (ml1-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (ml1-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (ml1-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (ml1-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (car (car g)) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (ml1-has-lam? (car l)) (loop (cdr l))))))))
(define (ml1-beta!) (if (ml1-has-lam? (dk-goal)) (dk-lam-b!)))
(define (ml1-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (ml1-close-ass!) (if (ml1-open?) (dk-ass!)))
(define (ml1-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))
(define (ml1-zero! t)                  ; (IN t RPS), (<= t 0) in context: (= t 0)
  (if (not (dk-asm? (list '= t 0)))
      (begin
        (ml1-and! (list 'IN t 'RR-POS-STAR) '(IN 0 RR))
        (dk-cite! 'rr-pos-star-le-real-in-rr t 0)
        (dk-cite! 'rr-pos-star-nonneg t)
        (ml1-and! (list 'IN t 'RR) '(IN 0 RR))
        (ml1-and! (list '<= t 0) (list '<= 0 t))
        (dk-cite! 'rr-leq-antisymmetric t 0))))
(define (ml1-lt-le! y t)               ; (< y t) in context: (<= y t)
  (if (not (dk-asm? (list '<= y t)))
      (dk-project! (list '<= y t)
        (lambda () (let ((iff (dk-cite! '< y t))) (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))))

;;; ===========================================================================
;;; (1) ||f||_inf is an essential bound: mu{ ||f||_inf < |f| } = 0 when ||f||_inf is finite
;;; ===========================================================================
(define ml1-L '(LINF-NORM omega ca mu f))
(define ml1-S '(SEP lim_ RR-POS-STAR (= (mu (SEP lix_ omega (< lim_ (abs (f lix_))))) 0)))
(define (ml1-B t) (list 'SEP 'lix_ 'omega (list '< t '(abs (f lix_)))))
(sp (make-wff (ml1-alls '(omega ca mu f) (ml1-imps (list '(IS-MEASURE omega ca mu) '(IS-REAL-MEASURABLE-FN omega ca f) (list 'IN ml1-L 'RR))
   (list 'AND (list '<= 0 ml1-L) (list '= (list 'mu (ml1-B ml1-L)) 0))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-is-set)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN f (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(dk-have! (list 'SUBSET ml1-S 'RR-POS-STAR)
  (lambda () (let ((z (subset-by-element!))) (sep-me (dk-ctx-form (list 'IN z ml1-S))) (dk-split-all!) (ml1-close-ass!))))
(define ml1-E (list 'EINF ml1-S))
(dk-cite! 'einf-in ml1-S)
(dk-have! (list '= ml1-L ml1-E) (lambda () (mac 'LINF-NORM) (if (ml1-open?) (rfl))))
(dk-rewrite-h! (dk-ctx-form (list 'IN ml1-L 'RR)) ml1-L ml1-E)
(dk-cite! 'rr-pos-star-nonneg ml1-E)
(subst (list '= ml1-L ml1-E))
(define (ml1-fz! z)                    ; z in omega: f z, |f z| real
  (dk-cite! 'fun-apply-type-c 'f 'omega 'RR z)
  (dk-cite! 'rr-abs-closed (list 'f z)))
(define (ml1-tk k) (list '+ ml1-E (list 'recip (list '+ k 1))))
(define (ml1-tk! k)                    ; k in NN: tk real, E < tk, tk in RPS, B(tk) in ca, mu(B tk) = 0
  (let* ((r (list 'recip (list '+ k 1))) (t (ml1-tk k)) (b (ml1-B t)))
    (if (not (dk-asm? (list '= (list 'mu b) 0)))
        (begin
          (dk-cite! 'nn-recip-succ-pos k)
          (dk-cite! 'rr-pos-rr-in-rr r) (dk-cite! 'rr-lt-of-pos-rr r)
          (dk-type! t)
          (dk-have! (list '< ml1-E t) (lambda () (dk-ineq! (list 'IN ml1-E 'RR) (list 'IN r 'RR) (list 'IN t 'RR) (list '< 0 r))))
          (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list 'IN ml1-E 'RR) (list 'IN r 'RR) (list 'IN t 'RR) (list '< 0 r) (list '<= 0 ml1-E))))
          (ml1-rps! t)
          (dk-cite! 'abs-level-set-measurable 'omega 'ca 'mu 'f t)
          (let* ((ex (dk-cite! 'einf-lt-witness ml1-S t))
                 (y (dk-skolem! ex #t)))
            (dk-project! (list 'IN y 'RR-POS-STAR) (lambda () (sep-me (dk-ctx-form (list 'IN y ml1-S))) (dk-split-all!)))
            (dk-project! (list '= (list 'mu (ml1-B y)) 0) (lambda () (sep-me (dk-ctx-form (list 'IN y ml1-S))) (dk-split-all!)))
            (ml1-lt-le! y t)
            (dk-cite! 'rps-below-real-is-real y t)
            (dk-cite! 'abs-level-set-measurable 'omega 'ca 'mu 'f y)
            (dk-have! (list 'SUBSET b (ml1-B y))
              (lambda ()
                (let ((z (subset-by-element!)))
                  (sep-me (dk-ctx-form (list 'IN z b))) (dk-split-all!)
                  (ml1-fz! z)
                  (in-sep! (lambda () (dk-ass!))
                           (lambda () (dk-ineq! (list 'IN y 'RR) (list 'IN t 'RR) (list 'IN (list 'abs (list 'f z)) 'RR)
                                                (list '< y t) (list '< t (list 'abs (list 'f z)))))))))
            (dk-cite! 'measure-monotone 'omega 'ca 'mu b (ml1-B y))
            (dk-rewrite-h! (dk-ctx-form (list '<= (list 'mu b) (list 'mu (ml1-B y)))) (list 'mu (ml1-B y)) 0)
            (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR b)
            (ml1-zero! (list 'mu b)))))))
(define ml1-fl (list 'VNB-LAMBDA 'bk_ 'NN (ml1-B (ml1-tk 'bk_))))
(dk-have! (list 'IN ml1-fl '(FUN NN ca))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (ml1-beta!) (ml1-tk! k) (ml1-close-ass!))) (lambda () (dk-ass!)))))
(define ml1-fam (dk-name! ml1-fl '(FUN NN ca)))
(define (ml1-fam! k)                   ; k in NN: (= (fam k) B(tk)), mu of it 0
  (let ((e (list '= (list ml1-fam k) (ml1-B (ml1-tk k)))))
    (if (not (dk-asm? e))
        (begin
          (ml1-tk! k)
          (dk-cite! 'fun-apply-type-c ml1-fam 'NN 'ca k)
          (dk-have! e (lambda () (subst (list '= ml1-fam ml1-fl)) (ml1-beta!) (if (ml1-open?) (rfl))))))
    e))
(define ml1-bu (list 'BIG-UNION 'n_ 'NN (list ml1-fam 'n_)))
(define ml1-ml (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list ml1-fam 'n_))))
(dk-cite! 'measure-countably-subadditive 'omega 'ca 'mu ml1-fam)
(dk-cite! 'sigma-algebra-union-closed 'omega 'ca ml1-fam)
(dk-have! (list 'IN ml1-ml '(FUN NN RR-POS-STAR))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (ml1-beta!)
                                        (dk-cite! 'fun-apply-type-c ml1-fam 'NN 'ca k)
                                        (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR (list ml1-fam k))
                                        (ml1-close-ass!)))
                           (lambda () (dk-ass!)))))
(dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list ml1-ml 'ozn) 0)))
  (lambda () (let ((k (dk-di-var!)))
               (ml1-fam! k)
               (dk-cite! 'fun-apply-type-c ml1-fam 'NN 'ca k)
               (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR (list ml1-fam k))
               (ml1-beta!)
               (subst (ml1-fam! k))
               (ml1-close-ass!))))
(dk-cite! 'esum-nn-zero ml1-ml)
(define ml1-BE (ml1-B ml1-E))
(ml1-rps! ml1-E)
(dk-cite! 'abs-level-set-measurable 'omega 'ca 'mu 'f ml1-E)
(dk-have! (list 'SUBSET ml1-BE ml1-bu)
  (lambda ()
    (let ((z (subset-by-element!)))
      (sep-me (dk-ctx-form (list 'IN z ml1-BE))) (dk-split-all!)
      (ml1-fz! z)
      (let* ((az (list 'abs (list 'f z))) (eps (list '- az ml1-E)))
        (dk-type! eps)
        (dk-have! (list '< 0 eps) (lambda () (dk-ineq! (list 'IN az 'RR) (list 'IN ml1-E 'RR) (list 'IN eps 'RR) (list '< ml1-E az))))
        (dk-cite! 'rr-pos-rr-of-lt eps)
        (let* ((k (dk-skolem! (dk-cite! 'nn-recip-succ-small eps) #t))
               (r (list 'recip (list '+ k 1))) (t (ml1-tk k)))
          (ml1-fam! k)
          (dk-have! (list 'IN z (list ml1-fam k))
            (lambda () (subst (ml1-fam! k))
                       (in-sep! (lambda () (dk-ass!))
                                (lambda () (dk-ineq! (list 'IN ml1-E 'RR) (list 'IN r 'RR) (list 'IN t 'RR) (list 'IN az 'RR) (list 'IN eps 'RR)
                                                     (list '< r eps))))))
          (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi k)))))))))
(dk-cite! 'measure-monotone 'omega 'ca 'mu ml1-BE ml1-bu)
(dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR ml1-bu)
(dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR ml1-BE)
(dk-rewrite-h! (dk-ctx-form (list '<= (list 'mu ml1-bu) (list 'ESUM ml1-ml))) (list 'ESUM ml1-ml) 0)
(ml1-zero! (list 'mu ml1-bu))
(dk-rewrite-h! (dk-ctx-form (list '<= (list 'mu ml1-BE) (list 'mu ml1-bu))) (list 'mu ml1-bu) 0)
(ml1-zero! (list 'mu ml1-BE))
(dk-conj-close! (lambda () (dk-ass!)))
(ml1-qed! 'linf-norm-essential-bound)

;;; ===========================================================================
;;; (2) unfolding L1-SET and L1-PAIRING (def-functoid: the equations are proven, so a hypothesis can use them)
;;; ===========================================================================
(define ml1-L1 '(L1-SET omega ca mu))
(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu (FORALL g
   (IFF (IN g (L1-SET omega ca mu)) (AND (IN g (FUN omega RR)) (IS-INTEGRABLE omega ca mu g)))))))))
(dk-peel!)
(mac 'L1-SET)
(dk-iff! (lambda (gg) (dk-head-is? gg 'AND))
  (lambda () (sep-me (dk-ctx-form (list 'IN 'g (list 'SEP 'l1g_ '(FUN omega RR) '(IS-INTEGRABLE omega ca mu l1g_)))))
             (dk-split-all!) (dk-conj-close! (lambda () (dk-ass!))))
  (lambda () (dk-split-all!) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(ml1-qed! 'l1-set-membership)

(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu (IMPLIES (IN omega SET) (IN (L1-SET omega ca mu) SET)))))))
(dk-peel!)
(fact 'rr-is-set)
(let ((fs (dk-cite! 'fun-set-iff 'omega 'RR)))
  (ml1-and! '(IN omega SET) '(IN RR SET))
  (dk-have! '(IN (FUN omega RR) SET) (lambda () (if (dk-only! fs '(AND (IN omega SET) (IN RR SET))) (prop)))))
(mac 'L1-SET)
(sep-set)
(ml1-close-ass!)
(ml1-qed! 'l1-set-is-set)

(define (ml1-P g) (list 'VNB-LAMBDA 'sx_ 'omega (list '* '(f sx_) (list g 'sx_))))
(sp (make-wff (ml1-alls '(omega ca mu f g)
   (list 'IMPLIES (list 'IN 'g ml1-L1)
     (list '== (list '(L1-PAIRING omega ca mu f) 'g) (list 'RINTEGRAL 'omega 'ca 'mu (ml1-P 'g)))))))
(dk-peel!)
(mac 'L1-PAIRING)
(ml1-beta!)
(if (ml1-open?) (qrfl))
(ml1-qed! 'l1-pairing-value)

;;; ===========================================================================
;;; (3) |f| <= M off a null set, g integrable: f g is integrable and int |f g| <= M int |g|
;;; ===========================================================================
(define (ml1-l1! g)                    ; (IN g L1-SET) in context: FUN, integrable, real measurable, int |g| real
  (if (not (dk-asm? (list 'IS-INTEGRABLE 'omega 'ca 'mu g)))
      (let ((iff (dk-cite! 'l1-set-membership 'omega 'ca 'mu g)))
        (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IN g ml1-L1)) (prop))))
        (dk-split! (caddr iff))))
  (ml1-integrable! g))
(define (ml1-integrable! g)            ; (IS-INTEGRABLE g): real measurable, FUN, |g| measurable, int |g| real
  (let ((ag (list 'ABS-FN 'omega g)))
    (if (not (dk-asm? (list 'IN (list 'INTEGRAL 'omega 'ca 'mu ag) 'RR)))
        (begin
          (dk-project! (list 'IS-REAL-MEASURABLE-FN 'omega 'ca g) 'is-integrable (list 'IS-INTEGRABLE 'omega 'ca 'mu g))
          (dk-project! (list 'IN g '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca g))
          (let ((ia (dk-cite! 'integral-abs-fn 'omega 'ca 'mu g)))
            (if (and (pair? ia) (eq? (car ia) 'AND) (not (dk-asm? (cadr ia)))) (dk-split! ia)))
          (dk-project! (list 'IN ag '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca ag))
          (let ((iff (dk-cite! 'integrable-iff-abs-finite 'omega 'ca 'mu g)))
            (dk-have! (list 'IN (list 'INTEGRAL 'omega 'ca 'mu ag) 'RR)
              (lambda () (if (dk-only! iff (list 'IS-INTEGRABLE 'omega 'ca 'mu g)) (prop)))))
          (dk-cite! 'integral-in 'omega 'ca 'mu ag)
          (dk-cite! 'rr-pos-star-nonneg (list 'INTEGRAL 'omega 'ca 'mu ag))))))
(define (ml1-l1-in! g)                 ; (IN g (FUN omega RR)), (IS-INTEGRABLE g): (IN g L1-SET)
  (if (not (dk-asm? (list 'IN g ml1-L1)))
      (let ((iff (dk-cite! 'l1-set-membership 'omega 'ca 'mu g)))
        (ml1-and! (list 'IN g '(FUN omega RR)) (list 'IS-INTEGRABLE 'omega 'ca 'mu g))
        (dk-have! (list 'IN g ml1-L1) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))))
(define (ml1-fun-vals! z)              ; z in omega: every (IN h (FUN omega RR)) in context, h not a lambda, applied at z
  (for-each (lambda (h) (if (and (not (dk-head-is? h 'VNB-LAMBDA)) (not (dk-asm? (list 'IN (list h z) 'RR))))
                            (dk-cite! 'fun-apply-type-c h 'omega 'RR z)))
            (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN omega RR)))) (dk-asms)))))
(define (ml1-lam-b-all!)                ; beta to a fixpoint ON THIS LEAF only (a closing step moves the focus)
  (let ((leaf (proof-state-focus *ps*)))
    (let loop ((n 0))
      (if (and (< n 6) (eq? (proof-state-focus *ps*) leaf) (not (sequent-node-grounded? leaf)) (ml1-has-lam? (dk-goal)))
          (begin (dk-lam-b!) (loop (+ n 1)))))))
(define (ml1-funrr! lam)               ; a lambda on omega with real values: (IN lam (FUN omega RR))
  (if (not (dk-asm? (list 'IN lam '(FUN omega RR))))
      (dk-have! (list 'IN lam '(FUN omega RR))
        (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                              (ml1-fun-vals! z) (ml1-lam-b-all!)
                                              (if (ml1-open?) (dk-type! (cadr (dk-goal))))))
                                 (lambda () (dk-ass!)))))))
(define (ml1-ptwise-eq! a b)           ; a, b in FUN(omega, RR): (FORALL ex_ ... (= (a ex_) (b ex_))) by beta + crs
  (let ((e (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list a 'ex_) (list b 'ex_))))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (let ((z (dk-di-var!)))
                                 (ml1-fun-vals! z)
                                 (dk-cite! 'fun-apply-type-c a 'omega 'RR z) (dk-cite! 'fun-apply-type-c b 'omega 'RR z)
                                 (ml1-lam-b-all!)
                                 (if (ml1-open?) (crs))))))
    e))
(define ml1-BM (ml1-B 'M))
(sp (make-wff (ml1-alls '(omega ca mu f M g)
   (ml1-imps (list '(IS-MEASURE omega ca mu) '(IS-REAL-MEASURABLE-FN omega ca f) '(IN M RR) '(<= 0 M) (list '= (list 'mu ml1-BM) 0)
                   (list 'IN 'g ml1-L1))
     (list 'AND (list 'IS-INTEGRABLE 'omega 'ca 'mu (ml1-P 'g))
                (list '<= (list 'INTEGRAL 'omega 'ca 'mu (list 'ABS-FN 'omega (ml1-P 'g))) (list '* 'M '(INTEGRAL omega ca mu (ABS-FN omega g)))))))))
(dk-peel!)
(fact 'rr-zero-in)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN f (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f))
(ml1-l1! 'g)
(define ml1-pg (ml1-P 'g))
(define ml1-ap (list 'ABS-FN 'omega ml1-pg))
(define ml1-ag '(ABS-FN omega g))
(define ml1-h2 (list 'PTWISE-SCALE 'omega 'M ml1-ag))
(dk-cite! 'real-measurable-mul 'omega 'ca 'f 'g)
(dk-project! (list 'IN ml1-pg '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca ml1-pg))
(let ((ia (dk-cite! 'integral-abs-fn 'omega 'ca 'mu ml1-pg))) (if (and (pair? ia) (eq? (car ia) 'AND)) (dk-split! ia)))
(ml1-rps! 'M)
(dk-cite! 'abs-level-set-measurable 'omega 'ca 'mu 'f 'M)
(dk-cite! 'ptwise-scale-measurable 'omega 'ca ml1-ag 'M)
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x ml1-BM)) (list '<= (list ml1-ap 'x) (list ml1-h2 'x)))))
  (lambda ()
    (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list 'g x)) (afx (list 'abs fx)) (agx (list 'abs gx)))
      (di)
      (ml1-fun-vals! x)
      (dk-cite! 'rr-abs-closed fx) (dk-cite! 'rr-abs-closed gx) (dk-cite! 'rr-abs-nonneg gx)
      (dk-have! (list '<= afx 'M)
        (lambda () (pbc) (dk-cite! 'rr-not-le-lt afx 'M)
                   (dk-have! (list 'IN x ml1-BM) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                   (ai (list 'NOT (list 'IN x ml1-BM)))))
      (ml1-and! (list 'IN fx 'RR) (list 'IN gx 'RR))
      (dk-cite! 'rr-abs-mult fx gx)
      (dk-cite! 'rr-mul-le-right afx 'M agx)
      (dk-type! (list '* fx gx)) (dk-type! (list '* afx agx)) (dk-type! (list '* 'M agx))
      (dk-have! (list '= (list ml1-pg x) (list '* fx gx)) (lambda () (ml1-lam-b-all!) (if (ml1-open?) (rfl))))
      (dk-cite! 'abs-fn-value 'omega ml1-pg x)
      (dk-cite! 'abs-fn-value 'omega 'g x)
      (dk-cite! 'fun-apply-type-c ml1-ag 'omega 'RR-POS-STAR x)
      (dk-cite! 'ptwise-scale-value 'omega 'M ml1-ag x)
      (ml1-rps! agx)
      (dk-cite! 'etimes-real-defined 'M agx)
      (dk-cite! 'bintimes-apply 'M agx)
      (subst (list '== (list ml1-ap x) (list 'abs (list ml1-pg x))))
      (subst (list '= (list ml1-pg x) (list '* fx gx)))
      (subst (list '= (list 'abs (list '* fx gx)) (list '* afx agx)))
      (subst (list '= (list ml1-h2 x) (list 'etimes 'M (list ml1-ag x))))
      (subst (list '== (list ml1-ag x) agx))
      (subst (list '= (list 'etimes 'M agx) (list 'bintimes 'M agx)))
      (subst (list '== (list 'bintimes 'M agx) (list '* 'M agx)))
      (ml1-close-ass!))))
(dk-cite! 'integral-le-off-null 'omega 'ca 'mu ml1-BM ml1-ap ml1-h2)
(define ml1-Ig '(INTEGRAL omega ca mu (ABS-FN omega g)))
(dk-cite! 'integral-homogeneous 'omega 'ca 'mu ml1-ag 'M)
(dk-cite! 'etimes-real-defined 'M ml1-Ig)
(dk-cite! 'bintimes-apply 'M ml1-Ig)
(dk-type! (list '* 'M ml1-Ig))
