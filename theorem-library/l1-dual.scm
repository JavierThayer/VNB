(define (ml2-sign! z pos?)             ; (IN z omega), (IN z E): lands (< cb (f z)) or (< cb (- (f z))), on a lane
  (let* ((fz (list 'f z)) (afz (list 'abs fz)) (claim (if pos? (list '< 'cb fz) (list '< 'cb (list '- fz)))))
    (dk-cite! 'fun-apply-type-c 'f 'omega 'RR z)
    (dk-cite! 'rr-abs-closed fz)
    (ml2-inter-in! z ml2-B (if pos? ml2-Pp ml2-Pn))
    (ml2-sep-in! z ml2-B)
    (ml2-sep-in! z (if pos? ml2-Pp ml2-Pn))
    (dk-cite! (if pos? 'pos-part-value 'neg-part-value) 'omega 'f z)
    (dk-type! (list '- fz))
    (dk-have! claim
      (lambda ()
        (ml2-cases! (list '<= 0 fz)
          (lambda ()
            (dk-cite! 'rr-abs-of-nonneg fz)
            (if pos?
                (let ((pv (list (list 'POS-PART 'omega 'f) z)))
                  (dk-have! (list '= pv fz) (lambda () (subst (list '== pv (list 'IF (list '<= 0 fz) fz 0))) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (dk-ass!)) (lambda () (if (ml2-open?) (rfl))))))
                  (dk-ineq! '(IN cb RR) (list 'IN fz 'RR) (list 'IN afz 'RR) (list '< 'cb afz) (list '= afz fz)))
                (let ((nv (list (list 'NEG-PART 'omega 'f) z)))
                  (dk-have! (list '= nv 0) (lambda () (subst (list '== nv (list 'IF (list '<= 0 fz) 0 (list '- fz)))) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (dk-ass!)) (lambda () (if (ml2-open?) (rfl))))))
                  (dk-rewrite-h! (dk-ctx-form (list '< 0 nv)) nv 0)
                  (dk-absurd! '(IN 0 RR) '(< 0 0)))))
          (lambda ()
            (dk-cite! 'rr-not-le-lt 0 fz)
