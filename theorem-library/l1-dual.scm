                           (dk-have! (list '= (list uq z) (list '* (list 'f z) 1)) (lambda () (ml2-lam-b-all!) (subst (list '= (list iq z) 1)) (if (ml2-open?) (rfl))))
                           (k 1))
                (lambda () (dk-cite! 'indicator-value-out 'omega q z)
                           (dk-have! (list '= (list uq z) (list '* (list 'f z) 0)) (lambda () (ml2-lam-b-all!) (subst (list '= (list iq z) 0)) (if (ml2-open?) (rfl))))
                           (k 0))))
            (if pos?
                (begin
                  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'IN 'x q) (list '< 'cb (list uq 'x)))))
                    (lambda () (let ((z (dk-di-var!))) (di)
                                 (ml2-inter-in! z e (list ml2-d n)) (ml2-sign! z #t)
                                 (ux! z (lambda (v) (subst (list '= (list uq z) (list '* (list 'f z) v)))
                                                    (dk-ineq! '(IN cb RR) (list 'IN (list 'f z) 'RR) (list '< 'cb (list 'f z)))))))) 
                  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x q)) (list '= (list uq 'x) 0))))
                    (lambda () (let ((z (dk-di-var!))) (di)
                                 (ux! z (lambda (v) (subst (list '= (list uq z) (list '* (list 'f z) v))) (dk-ineq! (list 'IN (list 'f z) 'RR)))))))
                  (dk-have! (list '<= ru (list '* 'cb (list 'mu q)))
                    (lambda () (dk-ineq! (list 'IN ru 'RR) (list 'IN (list 'abs ru) 'RR) (list 'IN (list '* 'cb (list 'mu q)) 'RR)
                                         (list '<= ru (list 'abs ru)) (list '<= (list 'abs ru) (list '* 'cb (list 'mu q))))))
                  (dk-cite! 'positive-excess-null 'omega 'ca 'mu q uq 'cb))
                (let* ((nu (list 'VNB-LAMBDA 'sx_ 'omega (list '* '(- 1) (list uq 'sx_))))
                       (rn (list 'RINTEGRAL 'omega 'ca 'mu nu)))
                  (dk-type! '(- 1))
