                  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'IN 'x q) (list '< 'cb (list nu 'x)))))
                    (lambda () (let ((z (dk-di-var!))) (di)
                                 (ml2-inter-in! z e (list ml2-d n)) (ml2-sign! z #f)
                                 (ux! z (lambda (v)
                                          (ml2-lam-b-all!)
                                          (subst (list '= (list iq z) v))
                                          (dk-ineq! '(IN cb RR) (list 'IN (list 'f z) 'RR) (list '< 'cb (list '- (list 'f z)))))))))
                  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x q)) (list '= (list nu 'x) 0))))
                    (lambda () (let ((z (dk-di-var!))) (di)
