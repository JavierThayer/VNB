      (ml5-l1m! 'mu g)
      (dk-cite! 'real-measurable-mul 'omega 'ca g ml5-rwl)
      (dk-project! (list 'IN hl '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca hl))
     (let* ((h (dk-name! hl '(FUN omega RR))) (hw (ml5-hwl h))
            (peh (ml5-P ml5-e h)) (hpeh (ml5-hwl peh)) (peg (ml5-P ml5-e g)))
      (dk-rewrite-h! (dk-ctx-form (list 'IS-REAL-MEASURABLE-FN 'omega 'ca hl)) hl h)
      (dk-cite! 'real-measurable-mul 'omega 'ca h ml5-wt)
      (dk-project! (list 'IN hw '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca hw))
      ;; (h w)(x) = g(x)
      (define (hx! x)                  ; lands (== (h x) (* (g x) v)) and (== (hw x) (* (h x) (w x))); returns v
        (let ((rw (ml5-Rx! x)))
          (dk-cite! 'fun-apply-type-c g 'omega 'RR x)
          (if (not (dk-asm? (list '== (list h x) (list '* (list g x) (list ml5-rwl x)))))
              (dk-have! (list '== (list h x) (list '* (list g x) (list ml5-rwl x))) (lambda () (subst (list '= h hl)) (ml5-lam-b-all!) (if (ml5-open?) (qrfl)))))
          rw))
      (dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list hw 'mdtz_) (list g 'mdtz_))))
        (lambda ()
          (let* ((x (dk-di-var!)) (rw (hx! x)) (wx (list ml5-wt x)) (gx (list g x)))
            (dk-have! (list '== (list hw x) (list '* (list h x) wx)) (lambda () (ml5-lam-b-all!) (if (ml5-open?) (qrfl))))
            (subst (list '== (list hw x) (list '* (list h x) wx)))
            (subst (list '== (list h x) (list '* gx (list ml5-rwl x))))
            (subst (list '== (list ml5-rwl x) rw))
            (let ((v (dk-name! rw)))
              (dk-rewrite-h! (dk-ctx-form (list '= (list '* wx rw) 1)) rw v)
              (subst (list '= rw v))
              (dk-type! (list '* (list '* gx v) wx)) (dk-type! (list '* gx (list '* wx v)))
              (dk-have! (list '= (list '* (list '* gx v) wx) (list '* gx (list '* wx v))) (lambda () (crs)))
              (subst (list '= (list '* (list '* gx v) wx) (list '* gx (list '* wx v))))
              (subst (list '= (list '* wx v) 1))
              (if (ml5-open?) (crs))))))
      (ml5-fun-any! hw 'omega 'RR) (ml5-fun-any! g 'omega 'RR)
      (dk-cite! 'fun-domain-extensionality 'omega hw g)
      ;; h is in L^1(nu)
      (ml5-tr! h)
      (dk-have! (list 'IS-INTEGRABLE 'omega 'ca 'mu hw) (lambda () (subst (list '= hw g)) (dk-ass!)))
      (let ((iff (dk-ctx-form (list 'IFF (list 'IS-INTEGRABLE 'omega 'ca ml5-nu h) (list 'IS-INTEGRABLE 'omega 'ca 'mu hw)))))
        (dk-have! (list 'IS-INTEGRABLE 'omega 'ca ml5-nu h) (lambda () (if (dk-only! iff (list 'IS-INTEGRABLE 'omega 'ca 'mu hw)) (prop)))))
      (ml5-l1m-in! ml5-nu h)
      (ml5-fh! h)
      ;; the pairing against nu, moved back to mu
      (dk-apply! (dk-ctx-form ml5-repn) h)
      (dk-cite! 'l1-pairing-value 'omega 'ca ml5-nu ml5-e h)
      (ml5-split-and! (dk-cite! 'l1-product-bound 'omega 'ca ml5-nu ml5-e ml5-Lnu h))
      (ml5-integ-m! ml5-nu peh)
      (ml5-tr! peh)
      (let ((imp (dk-ctx-form (list 'IMPLIES (list 'IS-INTEGRABLE 'omega 'ca ml5-nu peh)
                                    (list '= (list 'RINTEGRAL 'omega 'ca ml5-nu peh) (list 'RINTEGRAL 'omega 'ca 'mu hpeh))))))
        (dk-apply! imp))
      (let ((iff (dk-ctx-form (list 'IFF (list 'IS-INTEGRABLE 'omega 'ca ml5-nu peh) (list 'IS-INTEGRABLE 'omega 'ca 'mu hpeh)))))
        (dk-have! (list 'IS-INTEGRABLE 'omega 'ca 'mu hpeh) (lambda () (if (dk-only! iff (list 'IS-INTEGRABLE 'omega 'ca ml5-nu peh)) (prop)))))
      (dk-cite! 'real-measurable-mul 'omega 'ca peh ml5-wt)
      (dk-project! (list 'IN hpeh '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca hpeh))
      (ml5-funrr! peg)
      (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list hpeh 'ex_) (list peg 'ex_))))
        (lambda ()
          (let* ((x (dk-di-var!)) (rw (hx! x)) (wx (list ml5-wt x)) (gx (list g x)) (ex (list ml5-e x)))
            (dk-cite! 'fun-apply-type-c ml5-e 'omega 'RR x)
            (dk-have! (list '== (list hpeh x) (list '* (list peh x) wx)) (lambda () (ml5-lam-b-all!) (if (ml5-open?) (qrfl))))
            (dk-have! (list '== (list peh x) (list '* ex (list h x))) (lambda () (ml5-lam-b-all!) (if (ml5-open?) (qrfl))))
            (dk-have! (list '== (list peg x) (list '* ex gx)) (lambda () (ml5-lam-b-all!) (if (ml5-open?) (qrfl))))
            (subst (list '== (list hpeh x) (list '* (list peh x) wx)))
            (subst (list '== (list peh x) (list '* ex (list h x))))
            (subst (list '== (list h x) (list '* gx (list ml5-rwl x))))
            (subst (list '== (list ml5-rwl x) rw))
            (subst (list '== (list peg x) (list '* ex gx)))
            (let ((v (dk-name! rw)))
              (dk-rewrite-h! (dk-ctx-form (list '= (list '* wx rw) 1)) rw v)
              (subst (list '= rw v))
              (dk-type! (list '* (list '* ex (list '* gx v)) wx)) (dk-type! (list '* (list '* ex gx) (list '* wx v)))
              (dk-have! (list '= (list '* (list '* ex (list '* gx v)) wx) (list '* (list '* ex gx) (list '* wx v))) (lambda () (crs)))
              (subst (list '= (list '* (list '* ex (list '* gx v)) wx) (list '* (list '* ex gx) (list '* wx v))))
              (subst (list '= (list '* wx v) 1))
              (if (ml5-open?) (crs))))))
      (ml5-split-and! (dk-cite! 'integrable-ptwise-eq 'omega 'ca 'mu hpeh peg))
      (dk-cite! 'l1-pairing-value 'omega 'ca 'mu ml5-e g)
      (dk-cite! 'fun-apply-type-c 'F ml5-L1 'RR g)
      (dk-have! (list '= (list 'F hw) '(F g)) (lambda () (subst (list '= hw g)) (if (ml5-open?) (rfl))))
      (subst (list '= (list 'F g) (list 'F hw)))
      (subst (list '== (list 'F hw) (list ml5-fnl h)))
      (subst (list '= (list ml5-fnl h) (list (list 'L1-PAIRING 'omega 'ca ml5-nu ml5-e) h)))
      (subst (list '== (list (list 'L1-PAIRING 'omega 'ca ml5-nu ml5-e) h) (list 'RINTEGRAL 'omega 'ca ml5-nu peh)))
      (subst (list '= (list 'RINTEGRAL 'omega 'ca ml5-nu peh) (list 'RINTEGRAL 'omega 'ca 'mu hpeh)))
      (subst (list '= (list 'RINTEGRAL 'omega 'ca 'mu hpeh) (list 'RINTEGRAL 'omega 'ca 'mu peg)))
      (subst (list '== (list (list 'L1-PAIRING 'omega 'ca 'mu ml5-e) g) (list 'RINTEGRAL 'omega 'ca 'mu peg)))
      (if (ml5-open?) (begin (dk-cite! 'rintegral-in-rr 'omega 'ca 'mu peg) (rfl)))))))
(ew ml5-e)
(dk-conj-close! (lambda () (dk-ass!)))
(ml5-qed! 'l1-dual-onto)

;;; ===========================================================================
;;; PROPOSITION 2.31: for sigma-finite mu, f |-> Phi(f) maps the essentially bounded measurable functions onto the
;;; bounded linear functionals on L^1, and the dual norm of Phi(f) is ||f||_inf (an isometric isomorphism, the
;;; functions taken without the a.e. quotient).
;;; ===========================================================================
(define ml5-Phi-f '(L1-PAIRING omega ca mu f))
(define ml5-def-f (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g ml5-L1) (list 'IS-INTEGRABLE 'omega 'ca 'mu (list 'VNB-LAMBDA 'sx_ 'omega '(* (f sx_) (g sx_)))))))
(sp (make-wff (ml5-alls '(omega ca mu)
   (ml5-imps '((IS-MEASURE omega ca mu) (IS-SIGMA-FINITE omega ca mu))
     (list 'AND
       (list 'FORALL 'f (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega ca f) (list 'IMPLIES '(IN (LINF-NORM omega ca mu f) RR)
         (list 'IS-BOUNDED-L1-FUNCTIONAL 'omega 'ca 'mu ml5-Phi-f '(LINF-NORM omega ca mu f)))))
       (list 'AND
         (list 'FORALL 'f (list 'FORALL 'cb (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega ca f)
           (list 'IMPLIES (list 'IS-BOUNDED-L1-FUNCTIONAL 'omega 'ca 'mu ml5-Phi-f 'cb) (list 'IMPLIES ml5-def-f '(<= (LINF-NORM omega ca mu f) cb))))))
         (list 'FORALL 'F (list 'FORALL 'cb (list 'IMPLIES '(IS-BOUNDED-L1-FUNCTIONAL omega ca mu F cb) ml5-ontoconc)))))))))
(dk-peel!)
(dk-conj-close!
  (lambda ()
    (let* ((g (dk-goal)) (ld (dk-peel!)))
      (cond ((dk-head-is? (dk-goal) 'IS-BOUNDED-L1-FUNCTIONAL) (dk-cite! 'l1-pairing-bounded 'omega 'ca 'mu 'f))
            ((dk-head-is? (dk-goal) '<=)
             (dk-cite! 'l1-pairing-norm-bound 'omega 'ca 'mu 'f 'cb))
            (#t (dk-cite! 'l1-dual-onto 'omega 'ca 'mu 'F 'cb)))
      (ml5-close-ass!))))
(ml5-qed! 'linf-is-l1-dual)
