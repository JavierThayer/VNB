                                          (subst (list '= (list iq z) v))
                                          (dk-ineq! (list 'IN (list 'f z) 'RR)))))))
                  (dk-have! (list '= (list '* '(- 1) ru) (list '- ru)) (lambda () (crs)))
                  (dk-rewrite-h! (dk-ctx-form (list '= rn (list '* '(- 1) ru))) (list '* '(- 1) ru) (list '- ru))
                  (dk-have! (list '<= rn (list '* 'cb (list 'mu q)))
