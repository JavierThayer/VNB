            (dk-cite! 'rr-neg-abs-le ru)
            (define (ux! z k)          ; z in omega: K with the value of 1_q at z after landing (= (uq z) (* (f z) v))
              (dk-cite! 'fun-apply-type-c 'f 'omega 'RR z)
