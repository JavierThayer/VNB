(define (ml2-inter-in! z a b)          ; (IN z (INTERSECTION a b)): lands (IN z a), (IN z b); never closes the focus
  (let ((conj (list 'AND (list 'IN z a) (list 'IN z b))))
    (if (not (and (dk-asm? (cadr conj)) (dk-asm? (caddr conj))))
        (let ((iff (dk-cite! 'intersection-membership a b z)))
          (if (not (dk-asm? conj)) (dk-have! conj (lambda () (if (dk-only! iff (list 'IN z (list 'INTERSECTION a b))) (prop)))))
          (dk-split! conj)))))
(define (ml2-sep-in! z s)              ; (IN z (SEP v D body)): lands (IN z D) and body[z]; never closes the focus
  (let* ((body (mr-subst-var (cadr s) z (cadddr s))) (conj (list 'AND (list 'IN z (caddr s)) body)))
    (if (not (dk-asm? body))
        (begin (dk-have! conj (lambda () (sep-me (dk-ctx-form (list 'IN z s))) (dk-split-all!) (dk-conj-close! (lambda () (dk-ass!)))))
               (dk-split! conj)))))
(define (mr-subst-var v t e) (cond ((eq? e v) t) ((pair? e) (map (lambda (u) (mr-subst-var v t u)) e)) (#t e)))
