                                  (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL CC-MS y r) mq-Dp))))))
                          (op (begin (dk-project! opf (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS mq-Dp)))) opf))
                          (ry (dk-skolem! (dk-apply! (dk-ctx-form op) y))))
