(qed 'residue-of-decomposition)

;;; ===============================================================================================================
;;; (11) THE STEP OF THE RESIDUE THEOREM: remove one singular point b.  f holomorphic on u \ (S u {b}), decomposed at
;;;      b and at every point of S.  Then g = f - P_b (P_b = RESIDUE(f, b)/(z - b) + F_b, the principal part), set to
;;;      h_b(b) at b, is holomorphic on u \ S, decomposes at every point of S with the same residues as f, and for every
;;;      closed road in u \ (S u {b}):  int f = int g + 2 pi i RESIDUE(f, b) WINDING(road, b).
;;; ===============================================================================================================
(define (mq-B e r) (list 'BALL 'CC-MS e r))
(define (mq-PB e r) (list 'DIFFERENCE (mq-B e r) (list 'SINGLETON e)))
(define (mq-pz e) (list 'DIFFERENCE 'CC (list 'SINGLETON e)))
(define (mq-road-zero e F)
  (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
    (list 'IMPLIES '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'IMPLIES (list 'SUBSET '(TRACE mdp_ mds_ mdt_) (mq-pz e))
      (list 'IMPLIES '(= (mdp_ mdt_) (mdp_ mds_)) (list '= (list 'LINE-INT F 'mdp_ 'mdq_ 'mds_ 'mdt_) 0)))))))))
(define (mq-exact e F) (list 'AND (list 'HOLOMORPHIC-ON (mq-pz e) F) (mq-road-zero e F)))
(define (mq-law fn e d h fd r)
  (list 'FORALL 'mqz_ (list 'IMPLIES (list 'IN 'mqz_ (mq-PB e r))
    (list '= (list fn 'mqz_) (list '+ (list h 'mqz_) (list '+ (list '* d (list 'recip (list '- 'mqz_ e))) (list fd 'mqz_)))))))
(define (mq-dec fn e)
  (list 'FORSOME 'mqr_ (list 'AND '(IN mqr_ RR) (list 'AND '(< 0 mqr_)
    (list 'FORSOME 'mqd_ (list 'AND '(IN mqd_ CC)
      (list 'FORSOME 'mqh_ (list 'AND (list 'HOLOMORPHIC-ON (mq-B e 'mqr_) 'mqh_)
        (list 'FORSOME 'mqf_ (list 'AND (mq-exact e 'mqf_) (mq-law fn e 'mqd_ 'mqh_ 'mqf_ 'mqr_)))))))))))
(define mq-SB '(UNION ms (PAIR b b)))
(define mq-Dp (list 'DIFFERENCE 'u mq-SB))
(define mq-D '(DIFFERENCE u ms))
(define (mq-LI F p q s t) (list 'LINE-INT F p q s t))
(define (mq-roadpart g)
  (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
    (list 'IMPLIES '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'IMPLIES (list 'SUBSET '(TRACE mdp_ mds_ mdt_) mq-Dp)
      (list 'IMPLIES '(= (mdp_ mdt_) (mdp_ mds_))
        (list '= (mq-LI 'f 'mdp_ 'mdq_ 'mds_ 'mdt_)
                 (list '+ (mq-LI g 'mdp_ 'mdq_ 'mds_ 'mdt_)
                          (list '* (list '* md-tpi '(RESIDUE f b)) '(WINDING mdp_ mdq_ mds_ mdt_ b))))))))))))
(define mq-step-concl
  (list 'FORSOME 'mqg_ (list 'AND (list 'HOLOMORPHIC-ON mq-D 'mqg_)
    (list 'AND (list 'FORALL 'mqe_ (list 'IMPLIES '(IN mqe_ ms)
                 (list 'AND (mq-dec 'mqg_ 'mqe_) '(= (RESIDUE mqg_ mqe_) (RESIDUE f mqe_)))))
               (mq-roadpart 'mqg_)))))
(define mq-step-stmt
  (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN md-nfm 'u)
    (list 'FORALL 'ms (list 'IMPLIES '(SUBSET ms u)
      (list 'FORALL 'b (list 'IMPLIES '(IN b u) (list 'IMPLIES '(NOT (IN b ms))
        (list 'FORALL 'f (md-imps (list (list 'HOLOMORPHIC-ON mq-Dp 'f) (mq-dec 'f 'b)
                                        (list 'FORALL 'mqe_ (list 'IMPLIES '(IN mqe_ ms) (mq-dec 'f 'mqe_))))
          mq-step-concl))))))))))
;; ---- helpers for (11)
(define (mq-pb-in! e r y)              ; y in B(e, r), y /= e (in context): y in B(e, r) \ {e}
  (let ((iff (dk-cite! 'difference-membership (mq-B e r) (list 'SINGLETON e) y))
        (sf (begin (fact 'membership-implies-sethood y (mq-B e r)) (dk-cite! 'singleton-membership e y))))
    (dk-have! (list 'NOT (list 'IN y (list 'SINGLETON e))) (lambda () (md-only-prop! sf (list 'NOT (list '= y e)))))
    (dk-have! (list 'IN y (mq-PB e r)) (lambda () (md-only-prop! iff (list 'IN y (mq-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))))))
(define (mq-pb-open! e r y)            ; y in B(e, r) \ {e}: y in B, y in CC, y /= e, y - e /= 0, y in CC \ {e}
  (md-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership (mq-B e r) (list 'SINGLETON e) y)))
                 (if (not (and (dk-asm? (list 'IN y (mq-B e r))) (dk-asm? (list 'NOT (list 'IN y (list 'SINGLETON e))))))
                     (begin
                       (dk-have! (list 'AND (list 'IN y (mq-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))
                         (lambda () (md-only-prop! iff (list 'IN y (mq-PB e r)))))
                       (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y (mq-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e)))))))))))
    (lambda () (mq-ball-pt! e r y))
    (lambda () (fact 'membership-implies-sethood y 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership e y)))
                 (dk-have! (list 'NOT (list '= y e))
                   (lambda () (md-only-prop! iff (list 'NOT (list 'IN y (list 'SINGLETON e))) (list 'IN y 'SET))))))
    (lambda () (md-sub-nz! y e))
    (lambda () (md-pz-in! e y))))
(define (mq-ball-pt! e r y)            ; y in B(e, r): y in CC, |y - e| < r
  (if (not (and (dk-asm? (list 'IN y 'CC)) (dk-asm? (list '< (list 'magnitude (list '- y e)) r))))
  (let ((iff (dk-cite! 'cc-ms-ball-membership e r y)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))
      (lambda () (md-only-prop! iff (list 'IN y (mq-B e r)))))
    (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))))))))
(define (mq-ne-b! y)                   ; y in CC, y /= b in context: y in CC \ {b}, y - b /= 0
  (md-sub-nz! y 'b) (md-pz-in! 'b y))
(define (mq-sb-out! y)                 ; y not in ms, y /= b, y a set: y not in ms u {b}
  (let ((ui (dk-cite! 'union-membership 'ms '(PAIR b b) y)))
    (md-and! '(IN b SET) '(IN b SET))
    (let ((pi (dk-cite! 'pairing-membership 'b 'b y)))
      (dk-have! (list 'NOT (list 'IN y mq-SB))
        (lambda () (md-only-prop! ui pi (list 'NOT (list 'IN y 'ms)) (list 'NOT (list '= y 'b))))))))
(define (mq-dp-in! y)                  ; y in u, y not in ms, y /= b: y in D'
  (fact 'membership-implies-sethood y 'u)
  (mq-sb-out! y)
  (let ((iff (dk-cite! 'difference-membership 'u mq-SB y)))
    (dk-have! (list 'IN y mq-Dp) (lambda () (md-only-prop! iff (list 'IN y 'u) (list 'NOT (list 'IN y mq-SB)))))))
(define (mq-dp-open! y)                ; y in D': y in u, CC, not in ms, /= b, in D, in CC \ {b}
  (md-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership 'u mq-SB y)))
                 (dk-have! (list 'IN y 'u) (lambda () (md-only-prop! iff (list 'IN y mq-Dp))))
                 (dk-have! (list 'NOT (list 'IN y mq-SB)) (lambda () (md-only-prop! iff (list 'IN y mq-Dp))))))
    (lambda () (fact 'subset-mem-fwd 'u 'CC y))
    (lambda () (fact 'membership-implies-sethood y 'u))
    (lambda () (let ((ui (dk-cite! 'union-membership 'ms '(PAIR b b) y)))
                 (md-and! '(IN b SET) '(IN b SET))
                 (let ((pi (dk-cite! 'pairing-membership 'b 'b y)))
                   (dk-have! (list 'NOT (list 'IN y 'ms)) (lambda () (md-only-prop! ui pi (list 'NOT (list 'IN y mq-SB)))))
                   (dk-have! (list 'NOT (list '= y 'b)) (lambda () (md-only-prop! ui pi (list 'NOT (list 'IN y mq-SB))))))))
    (lambda () (mq-d-in! y))
    (lambda () (mq-ne-b! y))))
(define (mq-d-in! y)                   ; y in u, y not in ms: y in D
  (let ((iff (dk-cite! 'difference-membership 'u 'ms y)))
    (dk-have! (list 'IN y mq-D) (lambda () (md-only-prop! iff (list 'IN y 'u) (list 'NOT (list 'IN y 'ms)))))))
(define (mq-d-open! y)                 ; y in D: y in u, CC, not in ms
  (let ((iff (dk-cite! 'difference-membership 'u 'ms y)))
    (dk-have! (list 'IN y 'u) (lambda () (md-only-prop! iff (list 'IN y mq-D))))
    (dk-have! (list 'NOT (list 'IN y 'ms)) (lambda () (md-only-prop! iff (list 'IN y mq-D))))
    (fact 'subset-mem-fwd 'u 'CC y)
    (fact 'membership-implies-sethood y 'u)))
(define (mq-dec-open! fn e)            ; DEC(fn, e) in context: skolemise; returns (r d h F law)
  (let* ((r (dk-skolem! (dk-ctx-form (mq-dec fn e))))
         (d (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mqd_) (dk-contains? fm r))) "d")))
         (h (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mqh_) (dk-contains? fm d))) "h")))
         (F (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mqf_) (dk-contains? fm h))) "F")))
         (law (mq-law fn e d h F r)))
    (md-and! (list 'HOLOMORPHIC-ON (mq-pz e) F) (mq-road-zero e F))
    (dk-cite! 'holomorphic-on-in-fun (mq-B e r) h)
    (dk-cite! 'holomorphic-on-in-fun (mq-pz e) F)
    (list r d h F law)))
(define (mq-hol-sub! V F1 dom1 F2 dom2 pt!)  ; V open subset of dom1, dom2: the difference lambda, holomorphic on V
  (let* ((L (list 'VNB-LAMBDA 'mqw_ V (list '- (list F1 'mqw_) (list F2 'mqw_))))
         (R (lambda (F dom) (if (equal? dom V) F
                                (begin (dk-cite! 'holomorphic-on-restrict dom F V) (list 'RESTRICT F V)))))
         (R1 (R F1 dom1)) (R2 (R F2 dom2)))
    (dk-cite! 'holomorphic-on-in-fun V R1) (dk-cite! 'holomorphic-on-in-fun V R2)
    (let* ((q1 (if (symbol? R1) R1 (dk-name! R1 (list 'FUN V 'CC))))
           (q2 (if (symbol? R2) R2 (dk-name! R2 (list 'FUN V 'CC))))
           (L0 (list 'VNB-LAMBDA 'mqw_ V (list '- (list q1 'mqw_) (list q2 'mqw_)))))
      (if (not (symbol? R1)) (dk-have! (list 'HOLOMORPHIC-ON V q1) (lambda () (subst (list '= q1 R1)) (ass))))
      (if (not (symbol? R2)) (dk-have! (list 'HOLOMORPHIC-ON V q2) (lambda () (subst (list '= q2 R2)) (ass))))
      (dk-have! (list 'HOLOMORPHIC-ON V L0) (lambda () (dk-holomorphic! V L0)))
      (dk-have! (list 'IN L (list 'FUN V 'CC))
        (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                              (pt! x) (fact 'subset-mem-fwd V dom1 x) (fact 'subset-mem-fwd V dom2 x)
                                              (fact 'fun-apply-type-c F1 dom1 'CC x) (fact 'fun-apply-type-c F2 dom2 'CC x)
                                              (if (and (not (sequent-node-grounded? leaf)) (dk--redex? (dk-goal))) (dk-lam-b!))
                                              (if (not (sequent-node-grounded? leaf))
                                                  (begin (md-cc! (cadr (dk-goal))) (if (not (sequent-node-grounded? leaf)) (ass)))))))))
      (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ V) (list '== (list L 'hbx_) (list L0 'hbx_))))
        (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                     (pt! x) (fact 'subset-mem-fwd V dom1 x) (fact 'subset-mem-fwd V dom2 x)
                     (fact 'fun-apply-type-c F1 dom1 'CC x) (fact 'fun-apply-type-c F2 dom2 'CC x)
                     (md-lam-b!)
                     (if (not (symbol? R1)) (begin (subst (list '= q1 R1)) (dk-cite! 'restrict-apply F1 V x) (subst (list '== (list R1 x) (list F1 x)))))
                     (if (not (symbol? R2)) (begin (subst (list '= q2 R2)) (dk-cite! 'restrict-apply F2 V x) (subst (list '== (list R2 x) (list F2 x)))))
                     (if (and (not (sequent-node-grounded? leaf)) (dk--redex? (dk-goal))) (dk-lam-b!))
                     (if (not (sequent-node-grounded? leaf)) (qrfl)))))
      (dk-cite! 'holomorphic-transfer-ptwise-eq V L L0)
      L)))
;; ---- the step
(sp (make-wff mq-step-stmt))
(dk-peel!)
(fact 'nf-cc-is-metric-space) (fact 'cc-is-metric-space)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'b)
(fact 'membership-implies-sethood 'b 'CC)
(dk-cite! 'holomorphic-on-in-fun mq-Dp 'f)
(dk-cite! 'holomorphic-on-open mq-Dp 'f)
(let ((iff (dk-cite! 'cc-ms-open-iff mq-Dp)))
  (dk-have! (list 'IS-OPEN 'CC-MS mq-Dp) (lambda () (md-only-prop! iff (list 'IS-OPEN md-nfm mq-Dp)))))
(md-tpi!)
(md-pz-setup! 'b)
(define mq-db-data (mq-dec-open! 'f 'b))
(define mq-rb (list-ref mq-db-data 0))
(define mq-db (list-ref mq-db-data 1))
(define mq-hb (list-ref mq-db-data 2))
(define mq-Fb (list-ref mq-db-data 3))
(define mq-lawb (list-ref mq-db-data 4))
(define mq-Bb (mq-B 'b mq-rb))
(define mq-pzb (mq-pz 'b))
(dk-cite! 'residue-of-decomposition 'b mq-rb mq-db mq-hb mq-Fb 'f)
;; B(b, rb): open, holds b
(define (mq-ball-setup! e r)
  (let ((B (mq-B e r)))
    (md-and! (list 'IN r 'RR) (md-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (dk-have! (list 'IN e '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-cite! 'ball-is-open 'CC-MS e r)
    (let ((iff (dk-cite! 'cc-ms-open-iff B)))
      (dk-have! (list 'IS-OPEN md-nfm B) (lambda () (md-only-prop! iff (list 'IS-OPEN 'CC-MS B)))))
    (dk-cite! 'cc-open-subset-cc B)))
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-have! (list '<= 0 mq-rb) (lambda () (dk-ineq! (list '< 0 mq-rb))))
(dk-have! (list 'NOT (list '= 0 mq-rb)) (lambda () (di) (dk-absurd! (list 'IN mq-rb 'RR) (list '< 0 mq-rb) (list '= 0 mq-rb))))
(mq-ball-setup! 'b mq-rb)
(md-center-in-ball! 'b mq-rb)
(dk-cite! 'holomorphic-on-continuous mq-Bb mq-hb)
(fact 'fun-apply-type-c mq-hb mq-Bb 'CC 'b)
;; the principal part P_b on CC \ {b}
(define mq-kern (list 'VNB-LAMBDA 'wnw_ mq-pzb '(recip (- wnw_ b))))
(define mq-kd (list 'VNB-LAMBDA 'mqw_ mq-pzb (list '* mq-db '(recip (- mqw_ b)))))
(define mq-cst (list 'VNB-LAMBDA 'hbx_ mq-pzb mq-db))
(define mq-Prin (list 'VNB-LAMBDA 'mqw_ mq-pzb (list '+ (list '* mq-db '(recip (- mqw_ b))) (list mq-Fb 'mqw_))))
(define (mq-pz-pt! y) (md-pz-open! 'b y) (fact 'fun-apply-type-c mq-Fb mq-pzb 'CC y) (md-cc! (list 'recip (list '- y 'b))))
(dk-cite! 'winding-integrand-holomorphic 'b)
(dk-cite! 'holomorphic-const mq-pzb mq-db)
(md-lam-typ! mq-kd mq-pzb mq-pz-pt!)
(md-lam-typ! mq-Prin mq-pzb mq-pz-pt!)
(define (mq-ptw! U L rhs-of pt!)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ U) (list '== (list L 'hbx_) (rhs-of 'hbx_))))
    (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                 (pt! x) (md-lam-b!) (if (not (sequent-node-grounded? leaf)) (qrfl))))))
(mq-ptw! mq-pzb mq-kd (lambda (x) (list '* (list mq-cst x) (list mq-kern x))) mq-pz-pt!)
(dk-cite! 'holomorphic-product mq-pzb mq-cst mq-kern mq-kd)
(mq-ptw! mq-pzb mq-Prin (lambda (x) (list '+ (list mq-kd x) (list mq-Fb x))) mq-pz-pt!)
(dk-cite! 'holomorphic-sum mq-pzb mq-kd mq-Fb mq-Prin)
(for-each (lambda (F) (dk-cite! 'holomorphic-on-in-fun mq-pzb F) (dk-cite! 'holomorphic-on-continuous mq-pzb F)) (list mq-kern mq-kd mq-Fb mq-Prin))
;; D' subset D; B(b, rb) subset D
(dk-have! (list 'SUBSET mq-Dp mq-D)
  (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*))) (mq-dp-open! y) (if (not (sequent-node-grounded? leaf)) (ass)))))
(define (mq-pb-dom! y)                 ; y in B(b, rb) \ {b}: y in D' (f is defined there)
  (mq-pb-open! 'b mq-rb y)
  (let ((e (dk-apply! (dk-ctx-form mq-lawb) y)))
    (dk-cite! 'fun-value-in-domain mq-Dp 'CC 'f y (caddr e))))
(dk-have! (list 'SUBSET mq-Bb mq-D)
  (lambda ()
    (let* ((y (subset-by-element!)))
      (use-em (list '= y 'b)
        (lambda () (let ((leaf (proof-state-focus *ps*))) (subst (list '= y 'b)) (mq-d-in! 'b) (if (not (sequent-node-grounded? leaf)) (ass))))
        (lambda () (let ((leaf (proof-state-focus *ps*)))
                     (mq-pb-in! 'b mq-rb y) (mq-pb-dom! y) (mq-dp-open! y) (if (not (sequent-node-grounded? leaf)) (ass))))))))
;; D is open
(dk-have! (list 'IS-OPEN 'CC-MS mq-D)
