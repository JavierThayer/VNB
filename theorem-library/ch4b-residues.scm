(dk-have! (list 'SUBSET md6-T md-B) (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*))) (md-tpt! y 'rho) (if (not (sequent-node-grounded? leaf)) (ass)))))
