;; g = f - P_b off b, h_b(b) at b
(define mq-g (list 'VNB-LAMBDA 'mqw_ mq-D (list 'IF '(= mqw_ b) (list mq-hb 'b) (list '- '(f mqw_) (list '+ (list '* mq-db '(recip (- mqw_ b))) (list mq-Fb 'mqw_))))))
(define (mq-off-b! y)                  ; y in D, y /= b: y in D', f(y), P_b(y) typed
  (mq-dp-in! y) (mq-dp-open! y)
  (fact 'fun-apply-type-c 'f mq-Dp 'CC y)
  (fact 'fun-apply-type-c mq-Prin mq-pzb 'CC y))
(define (mq-g-at! y K)                 ; y in D, focus goal mentions (g y): beta, then the IF by cases; K: (K true?)
  (md-lam-b!)
  (let ((ift (let find ((t (dk-goal))) (cond ((not (pair? t)) #f) ((eq? (car t) 'IF) t) (#t (or (find (car t)) (find (cdr t))))))))
    (cond
      ((not ift) (K 'none))
      ((dk-asm? (list 'NOT (list '= y 'b)))
       (dk-if-branch! #f ift (lambda () (ass)) (lambda () (mq-off-b! y) (K #f))))
      ((dk-asm? (list '= y 'b))
       (dk-if-branch! #t ift (lambda () (ass)) (lambda () (K #t))))
      (#t (dk-case-if! ift (lambda (true? v) (if (not true?) (mq-off-b! y)) (K true?)))))))
(dk-have! (list 'IN mq-g (list 'FUN mq-D 'CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (mq-d-open! y)
          (mq-g-at! y (lambda (t?) (if (and (pair? (dk-open-leaves)) (not (dk-asm? (dk-goal)))) (md-cc! (cadr (dk-goal))))
