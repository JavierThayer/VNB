;;; ch4b-residues.scm -- the local decomposition at a point where f is meromorphic, the residue, and the residue theorem (CH4-B, 2026-10-29).
;;; If f(z) = (1/(z - a))^N g(z) on a punctured ball B(a, r) \ {a}, g holomorphic on B(a, r), then
;;;     f(z) = h(z) + d/(z - a) + F(z)        on B(a, r) \ {a},
;;; with h holomorphic on B(a, r), d in CC, and F holomorphic on CC \ {a} with zero integral over every closed road
;;; in CC \ {a} (F is a combination of the powers (1/(z - a))^k, k >= 2, each a derivative there).  Induction on N:
;;; g = g(a) + (z - a) q with q holomorphic on the ball (holomorphic-difference-quotient, then CH3-A's
;;; holomorphic-removable-point), so (1/(z - a))^(N+1) g = g(a) (1/(z - a))^(N+1) + (1/(z - a))^N q.
;;; This is the principal-part decomposition behind Def 4.14 and the residue theorem (Prop 4.15): d is the residue.
;;; Library: complex-analysis.  Load window: after ch3a-schwarz (holomorphic-removable-point),
;;; cauchy-centre-mean-value (holomorphic-difference-quotient), cauchy-integral-formula (cif-recip-power-diff),
;;; goursat-bricks (line-int-closed-road-of-derivative), line-int-laws, holomorphic-basics-2.  Prefix md-.
   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define md-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (md-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (md-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS md-nfm u) md-nfm f 'rgy_))))
(define (md-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (md-imps (cdr hyps) body))))
(define (md-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (md-all (cdr vars) body))))
(define (md-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (md-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (md-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((md-op? t 'succ 2) (md-nn! t) (fact 'nn-in-rr t) typ)
          ((md-op? t '* 3) (md-rr! (cadr t)) (md-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((md-op? t '+ 3) (md-rr! (cadr t)) (md-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((md-op? t '- 3) (md-rr! (cadr t)) (md-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((md-op? t '- 2) (md-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((md-op? t 'magnitude 2) (md-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((md-op? t 'real-part 2) (md-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((md-op? t 'imag-part 2) (md-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((md-op? t 'abs 2) (md-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((md-op? t 'recip 2)
           (md-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "md-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (md-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (md-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((md-op? t 'succ 2) (md-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (md-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (md-op? t 'succ 2)
               (md-op? t 'magnitude 2) (md-op? t 'real-part 2) (md-op? t 'imag-part 2))
           (md-rr! t) (fact 'rr-subset-cc t) typ)
          ((md-op? t '- 3) (md-cc! (cadr t)) (md-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((md-op? t '- 2) (md-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((md-op? t '+ 3) (md-cc! (cadr t)) (md-cc! (caddr t))
           (md-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((md-op? t '* 3) (md-cc! (cadr t)) (md-cc! (caddr t))
           (md-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((md-op? t 'power 3) (md-cc! (cadr t)) (md-nn! (caddr t))
           (md-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((md-op? t 'CC-EXP 2) (md-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((md-op? t 'recip 2) (md-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "md-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (md-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (md-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (md-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (md-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (md-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (md-only-prop! iff (list 'IN y (md-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (md-only-prop! iff (list 'IN y (md-pz z))))))
      (lambda () (md-sub-nz! y z)))))
(define (md-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (md-pz z))
      (lambda () (md-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (md-pz-setup! z)
  (let* ((d (md-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN md-nfm d) (lambda () (md-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (md-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (md-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (md-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (md-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (md-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (md-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (md-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (md-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; 2 pi i: in CC and non-zero, its reciprocal in CC
(define md-tpi '(* (* 2 PI) +i))
(define (md-tpi!)
  (md-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (md-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (md-cc! md-tpi)
  (md-cc! (list 'recip md-tpi))
  (md-and! (list 'IN md-tpi 'CC) (list 'NOT (list '= md-tpi 0)))
  (dk-cite! 'cc-recip-inverse md-tpi))
;;; x in CC, c in CC, s in RR, |x - c| < s in context: land x in BALL(CC-MS, c, s)
(define (md-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (md-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (md-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (md-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (md-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (md-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (md-rr! mag))
      (lambda () (md-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (md-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (md-subst-sym (car e) from to) (md-subst-sym (cdr e) from to)))
        (#t e)))
;;; a point x of the trace, the trace already known inside CC \ {c} (and CC \ {z} ...):
;;; land x in CC, x /= c, x - c /= 0 (the same for each z in ZS)
(define (md-tpt! x . zs)
  (md-steps
    (lambda () (fact 'subset-mem-fwd md-T (md-pz 'c) x))
    (lambda () (md-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd md-T (md-pz z) x) (md-pz-open! z x)) zs))))
(define (md-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (md-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (md-rr! m)
    (md-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (md-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (md-in-ball! a a r)))
;;; (1) an open set minus a point is open
(define md-tp '(* 2 PI))
(define md-I (list 'CCINT 0 md-tp))
(define md-C '(CIRCLE-PATH c r))
(define md-Cd '(CIRCLE-DERIV c r))
(define md-T (list 'TRACE md-C 0 md-tp))
(define (md-kern z) (list 'VNB-LAMBDA 'wnw_ (md-pz z) (list 'recip (list '- 'wnw_ z))))
(define (md-in-I! v)
  (dk-have! (list 'IN v md-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 md-tp) '(< 0 PI))))))))
(define (md-circle-basics!)
  (fact 'rr-zero-in)
  (md-rr! md-tp)
  (dk-have! (list '< 0 md-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path md-C md-Cd 0 md-tp)
  (fact 'is-path-in-fun md-C 0 md-tp)
  (dk-cite! 'trace-subset-cc md-C 0 md-tp))

(define (md-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (md-steps
      (lambda () (fact 'subset-mem-fwd md-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (md-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (md-sub-nz! y 'c))
      (lambda () (md-pz-in! 'c y)))))
(define (md-LI f) (list 'LINE-INT f md-C md-Cd 0 md-tp))
;;; the trace lies in CC \ {p} (p = c or z); land it
(define (md-trace-in-pz! p)
  (dk-have! (list 'SUBSET md-T (md-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (md-circ-pt! y)
        (if (eq? p 'z) (md-circ-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
;;; the winding kernel about p: typed, continuous on CC \ {p}
(define (md-kern-setup! p)
  (let* ((dd (md-pz p)) (k (md-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))

;;; ---------------------------------------------------------------------------------------------------------------
(define md-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define md-B '(BALL CC-MS a r))
(define md-PB (list 'DIFFERENCE md-B '(SINGLETON a)))
(define md-PUN (md-pz 'a))
(define (md-Pw n) (list 'VNB-LAMBDA 'mdv_ md-PUN (list 'power '(recip (- mdv_ a)) n)))
(define (md-road-zero F)               ; F integrates to 0 over every closed road in CC \ {a}
  (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
    (list 'IMPLIES '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'IMPLIES (list 'SUBSET '(TRACE mdp_ mds_ mdt_) md-PUN)
      (list 'IMPLIES '(= (mdp_ mdt_) (mdp_ mds_)) (list '= (list 'LINE-INT F 'mdp_ 'mdq_ 'mds_ 'mdt_) 0)))))))))
(define (md-exact F) (list 'AND (list 'HOLOMORPHIC-ON md-PUN F) (md-road-zero F)))
(define (md-road-peel!)                ; focus goal (md-road-zero F) or its peeled equation: return (p q s t)
  (if (not (dk-head-is? (dk-goal) '=)) (dk-peel!))
  (let ((ln (cadr (dk-goal)))) (cddr ln)))
(define (md-road-facts! p q s t)       ; road in context: path, trace in CC
  (fact 'is-road-is-path p q s t)
  (fact 'is-path-in-fun p s t)
  (dk-cite! 'trace-subset-cc p s t))
;; z in B(a, r) \ {a}: z in B, z in CC, z /= a, z - a /= 0, z in CC \ {a}
(define (md-pb-open! z)
  (md-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership md-B '(SINGLETON a) z)))
                 (dk-have! (list 'AND (list 'IN z md-B) (list 'NOT (list 'IN z '(SINGLETON a))))
                   (lambda () (md-only-prop! iff (list 'IN z md-PB))))
                 (if (not (and (dk-asm? (list 'IN z md-B)) (dk-asm? (list 'NOT (list 'IN z '(SINGLETON a))))))
                     (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN z md-B) (list 'NOT (list 'IN z '(SINGLETON a))))))))))
    (lambda () (fact 'subset-mem-fwd md-B 'CC z))
    (lambda () (fact 'membership-implies-sethood z 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership 'a z)))
                 (dk-have! (list 'NOT (list '= z 'a))
                   (lambda () (md-only-prop! iff (list 'NOT (list 'IN z '(SINGLETON a))) (list 'IN z 'SET))))))
    (lambda () (md-sub-nz! z 'a))
    (lambda () (md-pz-in! 'a z))))
(define (md-ball-setup!)               ; a in CC, r in RR, 0 < r: B open (both spellings), B subset CC, a in B; CC \ {a}
  (fact 'cc-is-metric-space)
  (fact 'nf-cc-is-metric-space)
  (md-center-in-ball! 'a 'r)
  (fact 'membership-implies-sethood 'a md-B)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (fact 'rr-pos-ne-zero 'r)
  (dk-have! '(NOT (= 0 r)) (lambda () (di) (dk-absurd! '(IN r RR) '(< 0 r) '(= 0 r))))
  (dk-have! '(IN a (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (md-and! '(IN r RR) (md-and! '(<= 0 r) '(NOT (= 0 r))))
  (dk-cite! 'ball-is-open 'CC-MS 'a 'r)
  (let* ((iff (dk-cite! 'cc-ms-open-iff md-B)))
    (dk-have! (list 'IS-OPEN md-nfm md-B) (lambda () (md-only-prop! iff (list 'IS-OPEN 'CC-MS md-B)))))
  (dk-cite! 'cc-open-subset-cc md-B)
  (md-pz-setup! 'a))
(define (md-lam-b!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))

;;; (1) the powers (1/(z - a))^(succ j) are holomorphic on CC \ {a}
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'mdj_ (list 'IMPLIES '(IN mdj_ NN)
  (list 'HOLOMORPHIC-ON md-PUN (md-Pw '(succ mdj_)))))))))
(dk-peel!)
(fact 'nf-cc-is-metric-space)
(md-pz-setup! 'a)
(fact 'nn-succ-closed 'mdj_)
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)) (leaf (proof-state-focus *ps*)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-head-is? g 'IN)
         (md-lam-typ! (cadr g) md-PUN (lambda (v) (md-pz-open! 'a v)))
         (if (not (sequent-node-grounded? leaf)) (ass)))
        (#t
         (let* ((w (dk-di-var!)) (dv (list '* '(- (succ mdj_)) (list 'power (list 'recip (list '- w 'a)) '(succ (succ mdj_))))))
           (md-pz-open! 'a w) (md-cc! dv)
           (ew (list '* '(- (succ mdj_)) (list 'power (list 'recip (list '- w 'a)) '(succ (succ mdj_)))))
           (dk-cite! 'cif-recip-power-diff 'mdj_ 'a w)
           (if (not (sequent-node-grounded? leaf)) (ass))))))))
(qed 'md-recip-power-holomorphic)

;;; (2) for j in NN, (1/(z - a))^(j+2) integrates to 0 over every closed road in CC \ {a}: it is a multiple of the
;;;     derivative of (1/(z - a))^(j+1) (cif-recip-power-diff, line-int-closed-road-of-derivative)
(define (md-nz-succ! j)                ; j in NN: (succ j) in RR, 0 < succ j, - (succ j) in CC, not 0
  (let* ((s (list 'succ j)) (ms (list '- s)))
    (fact 'nn-succ-closed j)
    (md-rr! s)
    (dk-have! (list '< 0 s) (lambda () (dk-nn!)))
    (md-cc! ms)
    (dk-have! (list 'NOT (list '= ms 0))
      (lambda () (di) (md-rr! ms) (dk-absurd! (list 'IN s 'RR) (list 'IN ms 'RR) (list '< 0 s) (list '= ms 0))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'mdj_ (list 'IMPLIES '(IN mdj_ NN)
  (md-road-zero (md-Pw '(succ (succ mdj_))))))))))
(dk-peel!)
(fact 'nf-cc-is-metric-space)
(md-pz-setup! 'a)
(fact 'nn-succ-closed 'mdj_) (fact 'nn-succ-closed '(succ mdj_))
(md-nz-succ! 'mdj_)
(define md2-P1 (md-Pw '(succ mdj_)))
(define md2-P2 (md-Pw '(succ (succ mdj_))))
(define md2-df (list 'VNB-LAMBDA 'mdv_ md-PUN '(* (- (succ mdj_)) (power (recip (- mdv_ a)) (succ (succ mdj_))))))
(dk-cite! 'md-recip-power-holomorphic 'a 'mdj_)
(dk-cite! 'md-recip-power-holomorphic 'a '(succ mdj_))
(dk-cite! 'holomorphic-on-in-fun md-PUN md2-P2)
(dk-cite! 'holomorphic-on-continuous md-PUN md2-P2)
(md-lam-typ! md2-df md-PUN (lambda (v) (md-pz-open! 'a v)))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ md-PUN) (list 'IS-DIFF-ON 'CC-NORMED-FIELD md-PUN md2-P1 'hbz_ (list md2-df 'hbz_))))
  (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
               (md-pz-open! 'a z)
               (md-lam-b!)
               (dk-cite! 'cif-recip-power-diff 'mdj_ 'a z)
               (if (not (sequent-node-grounded? leaf)) (ass)))))
(dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ md-PUN) (list '== (list md2-df 'liz_) (list '* '(- (succ mdj_)) (list md2-P2 'liz_)))))
  (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
               (md-pz-open! 'a z)
               (md-lam-b!)
               (if (not (sequent-node-grounded? leaf)) (qrfl)))))
(let* ((rd (md-road-peel!)) (p (car rd)) (q (cadr rd)) (s (caddr rd)) (t (cadddr rd))
       (L2 (list 'LINE-INT md2-P2 p q s t)) (Ld (list 'LINE-INT md2-df p q s t)) (c '(- (succ mdj_))))
  (md-road-facts! p q s t)
  (dk-cite! 'line-int-closed-road-of-derivative md-PUN md2-P1 md2-df p q s t)
  (dk-apply! (dk-cite! 'line-int-scalar md-PUN md2-P2 p q s t) c md2-df)
  (dk-cite! 'line-int-in-cc md-PUN md2-P2 p q s t)
  (dk-have! (list '= (list '* c L2) 0) (lambda () (subst (list '= (list '* c L2) Ld)) (ass)))
  (use-em (list '= L2 0)
    (lambda () (ass))
    (lambda ()
      (md-and! (list 'IN c 'CC) (list 'NOT (list '= c 0)))
      (md-and! (list 'IN L2 'CC) (list 'NOT (list '= L2 0)))
      (dk-cite! 'cc-mul-nonzero c L2)
      (ai (list 'NOT (list '= (list '* c L2) 0))))))
(md-dump-open!)
(qed 'md-recip-power-road-zero)

;;; (3) the zero function on CC \ {a}: holomorphic, zero integral over closed roads
(define md-Z (list 'VNB-LAMBDA 'mdv_ md-PUN 0))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (md-exact md-Z)))))
(dk-peel!)
(fact 'nf-cc-is-metric-space)
(md-pz-setup! 'a)
(fact 'cc-zero-in)
(dk-cite! 'holomorphic-const md-PUN 0)
(dk-have! (list 'HOLOMORPHIC-ON md-PUN md-Z) (lambda () (ass)))
(dk-cite! 'holomorphic-on-in-fun md-PUN md-Z)
(dk-cite! 'holomorphic-on-continuous md-PUN md-Z)
(dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ md-PUN) (list '== (list md-Z 'liz_) (list '* 0 (list md-Z 'liz_)))))
  (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
               (md-lam-b!)
               (if (not (sequent-node-grounded? leaf))
                   (begin (dk-have! '(= (* 0 0) 0) (lambda () (crs))) (subst '(= (* 0 0) 0))
                          (if (not (sequent-node-grounded? leaf)) (qrfl)))))))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
        (let* ((rd (md-road-peel!)) (p (car rd)) (q (cadr rd)) (s (caddr rd)) (t (cadddr rd))
               (L (list 'LINE-INT md-Z p q s t)))
          (md-road-facts! p q s t)
          (dk-apply! (dk-cite! 'line-int-scalar md-PUN md-Z p q s t) 0 md-Z)
          (dk-cite! 'line-int-in-cc md-PUN md-Z p q s t)
          (let ((v (dk-name! L 'CC)))
            (subst (list '= L (list '* 0 L)))
            (subst (list '= L v))
            (crs))))))
(md-dump-open!)
(qed 'md-zero-exact)

;;; (4) n in NN is 0 or a successor
;;; CUT 2026-10-30 (wave-2 integration): `md-nn-cases' was an accidental duplicate of `nn-zero-or-succ' (theorem-library/nn-parity-proof.scm), the same
;;; statement up to binder names (proven-duplicate audit); citations renamed to `nn-zero-or-succ'.

;;; (5) THE LOCAL DECOMPOSITION (induction on N)
(define (md-concl n G)
  (list 'FORSOME 'mdd0_ (list 'AND '(IN mdd0_ CC)
   (list 'FORSOME 'mdh_ (list 'AND (list 'HOLOMORPHIC-ON md-B 'mdh_)
    (list 'FORSOME 'mdf_ (list 'AND (md-exact 'mdf_)
      (list 'FORALL 'mdz_ (list 'IMPLIES (list 'IN 'mdz_ md-PB)
        (list '= (list '* (list 'power '(recip (- mdz_ a)) n) (list G 'mdz_))
                 (list '+ '(mdh_ mdz_) (list '+ '(* mdd0_ (recip (- mdz_ a))) '(mdf_ mdz_)))))))))))))
(define md-stmt
  (list 'FORALL 'mdn_ (list 'IMPLIES '(IN mdn_ NN)
    (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r)
      (list 'FORALL 'mdg_ (list 'IMPLIES (list 'HOLOMORPHIC-ON md-B 'mdg_) (md-concl 'mdn_ 'mdg_)))))))))))
;; the three witnesses in turn, then the pointwise law by PTW! (the eigenvariable z of md-PB); the side
;; conjuncts are closed from context
(define (md-witness! d h F ptw!)
  (ew d)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g 'FORSOME)
           (ew h)
           (dk-conj-close!
             (lambda ()
               (let ((g2 (dk-goal)))
                 (cond
                   ((dk-asm? g2) (ass))
                   ((dk-head-is? g2 'FORSOME)
                    (ew F)
                    (dk-conj-close!
                      (lambda ()
                        (let ((g3 (dk-goal)))
                          (cond
                            ((dk-asm? g3) (ass))
                            (#t (let* ((z (dk-di-var!))) (ptw! z))))))))
                   (#t (error "md-witness!: unexpected" g2)))))))
          (#t (error "md-witness!: unexpected" g)))))))
(define (md-fun-typ! F dom z)          ; F holomorphic on dom: (IN (F z) CC), z in dom
  (if (not (dk-asm? (list 'IN F (list 'FUN dom 'CC)))) (dk-cite! 'holomorphic-on-in-fun dom F))
  (fact 'fun-apply-type-c F dom 'CC z))

(sp (make-wff md-stmt))
(define md-ind (use-induction))
(define md-n (cdr (assq 'var md-ind)))
(define md-ih (cdr (assq 'ih md-ind)))
;; ---- step
(dk-peel!)
(md-ball-setup!)
(fact 'cc-zero-in)
(dk-cite! 'holomorphic-on-in-fun md-B 'mdg_)
(fact 'fun-apply-type-c 'mdg_ md-B 'CC 'a)
(define md-Ga '(mdg_ a))
(define md-q (dk-skolem! (dk-cite! 'holomorphic-difference-quotient md-B 'mdg_ 'a)))
(define md-dq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f md-Ga) (dk-contains? f md-q))) "the quotient law"))
(dk-cite! 'holomorphic-removable-point md-B md-q 'a)
(dk-cite! 'holomorphic-on-in-fun md-B md-q)
(define md-ihc (dk-apply! md-ih 'a 'r md-q))
(define md-d1 (dk-skolem! md-ihc))
(define md-h1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'mdh_))) "h")))
(define md-F1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'mdf_))) "F")))
(define md-ihp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f md-F1) (dk-contains? f md-q))) "the IH law"))
(dk-cite! 'holomorphic-on-in-fun md-B md-h1)
(dk-cite! 'holomorphic-on-in-fun md-PUN md-F1)
(define (md-rv z) (list 'recip (list '- z 'a)))
(define (md-W-rhs z)
  (list '+ (list md-h1 z) (list '+ (list '* md-d1 (md-rv z))
    (list '+ (list md-F1 z) (list '* md-Ga (list 'power (md-rv z) (list 'succ md-n)))))))
(define (md-pt! z)                     ; z in B \ {a}: everything typed
  (md-pb-open! z)
  (for-each (lambda (F) (md-fun-typ! F md-B z)) (list 'mdg_ md-q md-h1))
  (md-fun-typ! md-F1 md-PUN z)
  (fact 'nn-succ-closed md-n)
  (md-cc! (md-rv z))
  (md-cc! (list 'power (md-rv z) md-n))
  (md-cc! (list 'power (md-rv z) (list 'succ md-n))))
;; W: (1/(z - a))^(n+1) g(z) = h1(z) + d1/(z - a) + F1(z) + g(a) (1/(z - a))^(n+1) on B \ {a}
(define md-W
  (list 'FORALL 'mdz_ (list 'IMPLIES (list 'IN 'mdz_ md-PB)
    (list '= (list '* (list 'power (md-rv 'mdz_) (list 'succ md-n)) '(mdg_ mdz_)) (md-W-rhs 'mdz_)))))
(dk-have! md-W
  (lambda ()
    (let* ((z (dk-di-var!)) (rv (md-rv z)) (pn (list 'power rv md-n)) (ps (list 'power rv (list 'succ md-n)))
           (e (list '- z 'a)) (Gz (list 'mdg_ z)) (qz (list md-q z)) (h1z (list md-h1 z)) (F1z (list md-F1 z)))
      (md-pt! z)
      (let* ((e1 (dk-apply! md-dq z))
             (e2 (dk-apply! md-ihp z)))
        (md-and! (list 'IN rv 'CC) (list 'IN md-n 'NN))
        (fact 'power-succ rv md-n)
        (md-and! (list 'IN e 'CC) (list 'NOT (list '= e 0)))
        (fact 'cc-recip-inverse e)
        (let* ((L (list '* ps Gz)) (R (md-W-rhs z)))
          (md-cc! L) (md-cc! R)
          (subst (list '= ps (list '* rv pn)))
          (let* ((pv (dk-name! pn 'CC)) (vv (dk-name! rv 'CC))
                 (e2n (dk-rewrite-h! (dk-rewrite-h! e2 pn pv) rv vv))
                 (e4n (dk-rewrite-h! (list '= (list '* e rv) 1) rv vv)))
            (subst (list '= pn pv)) (subst (list '= rv vv))
            (let* ((g (dk-goal)) (Ln (cadr g)) (Rn (caddr g))
                   (D1 (list '- (list '- Gz md-Ga) (list '* qz e)))
                   (D4 (list '- (list '* e vv) 1))
                   (D2 (list '- (list '* pv qz) (list '+ h1z (list '+ (list '* md-d1 vv) F1z))))
                   (comb (list '+ (list '* (list '* vv pv) D1) (list '+ (list '* (list '* pv qz) D4) D2))))
              (dk-have! (list '= D1 0) (lambda () (subst e1) (crs)))
              (dk-have! (list '= D4 0) (lambda () (subst e4n) (crs)))
              (dk-have! (list '= D2 0) (lambda () (subst e2n) (crs)))
              (dk-have! (list '= (list '- Ln Rn) comb) (lambda () (crs)))
              (md-cc! Ln) (md-cc! Rn)
              (dk-have! (list '= (list '- Ln Rn) 0)
                (lambda () (subst (list '= (list '- Ln Rn) comb)) (subst (list '= D1 0)) (subst (list '= D4 0)) (subst (list '= D2 0)) (crs)))
              (dk-cite! 'cc-sub-zero-eq Ln Rn)
              (if (pair? (dk-open-leaves)) (ass)))))))))
(define md-cases (dk-cite! 'nn-zero-or-succ md-n))
(use-em (list '= md-n 0)
  ;; n = 0: d = d1 + g(a), h = h1, F = F1
  (lambda ()
    (md-cc! (list '+ md-d1 md-Ga))
    (md-and! (list 'HOLOMORPHIC-ON md-PUN md-F1) (md-road-zero md-F1))
    (md-witness! (list '+ md-d1 md-Ga) md-h1 md-F1
      (lambda (z)
        (let* ((leaf (proof-state-focus *ps*)) (rv (md-rv z)))
          (md-pt! z)
          (dk-apply! (dk-ctx-form md-W) z)
          (subst (list '= (list '* (list 'power rv (list 'succ md-n)) (list 'mdg_ z)) (md-W-rhs z)))
          (md-and! (list 'IN rv 'CC) (list 'IN md-n 'NN))
          (fact 'power-succ rv md-n)
          (subst (list '= (list 'power rv (list 'succ md-n)) (list '* rv (list 'power rv md-n))))
          (subst (list '= md-n 0))
          (fact 'nn-zero-in)
          (fact 'power-zero rv)
          (subst (list '= (list 'power rv 0) 1))
          (let ((vv (dk-name! rv 'CC)))
            (subst (list '= rv vv))
            (if (not (sequent-node-grounded? leaf)) (crs)))))))
  ;; n = j + 1: d = d1, h = h1, F = F1 + g(a) (1/(z - a))^(n+1)
  (lambda ()
    (dk-have! (caddr md-cases) (lambda () (md-only-prop! md-cases (list 'NOT (list '= md-n 0)))))
    (let* ((j (dk-skolem! (dk-ctx-form (caddr md-cases))))
           (sn (list 'succ md-n))
           (P (md-Pw sn))
           (C (list 'VNB-LAMBDA 'hbx_ md-PUN md-Ga))
           (K (list 'VNB-LAMBDA 'mdw_ md-PUN (list '* md-Ga (list 'power '(recip (- mdw_ a)) sn))))
           (F2 (list 'VNB-LAMBDA 'mdw_ md-PUN (list '+ (list md-F1 'mdw_) (list '* md-Ga (list 'power '(recip (- mdw_ a)) sn)))))
           (pz-pt! (lambda (v) (md-pz-open! 'a v) (md-fun-typ! md-F1 md-PUN v) (fact 'nn-succ-closed md-n)
                     (md-cc! (list 'power (md-rv v) sn))))
           (ptw (lambda (U lhs-of rhs-of)
                  (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ U) (list '== (lhs-of 'liz_) (rhs-of 'liz_))))
                    (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                 (pz-pt! z) (md-lam-b!) (if (not (sequent-node-grounded? leaf)) (qrfl))))))))
      (fact 'nn-succ-closed md-n)
      (dk-cite! 'holomorphic-const md-PUN md-Ga)
      (dk-cite! 'md-recip-power-holomorphic 'a md-n)
      (md-lam-typ! K md-PUN pz-pt!)
      (md-lam-typ! F2 md-PUN pz-pt!)
      (ptw md-PUN (lambda (x) (list K x)) (lambda (x) (list '* (list C x) (list P x))))
      (dk-cite! 'holomorphic-product md-PUN C P K)
      (ptw md-PUN (lambda (x) (list F2 x)) (lambda (x) (list '+ (list md-F1 x) (list K x))))
      (dk-cite! 'holomorphic-sum md-PUN md-F1 K F2)
      (ptw md-PUN (lambda (x) (list K x)) (lambda (x) (list '* md-Ga (list P x))))
      (for-each (lambda (F) (dk-cite! 'holomorphic-on-continuous md-PUN F) (dk-cite! 'holomorphic-on-in-fun md-PUN F)) (list md-F1 K P))
      (dk-have! (md-road-zero F2)
        (lambda ()
          (let* ((rd (md-road-peel!)) (rp (car rd)) (rq (cadr rd)) (rs (caddr rd)) (rt (cadddr rd))
                 (LI (lambda (F) (list 'LINE-INT F rp rq rs rt))))
            (md-road-facts! rp rq rs rt)
            (dk-apply! (dk-ctx-form (md-road-zero md-F1)) rp rq rs rt)
            (let ((rz (dk-rewrite-h! (dk-cite! 'md-recip-power-road-zero 'a j) (list 'succ j) md-n)))
              (dk-apply! rz rp rq rs rt))
            (dk-apply! (dk-cite! 'line-int-scalar md-PUN P rp rq rs rt) md-Ga K)
            (dk-apply! (dk-cite! 'line-int-sum md-PUN md-F1 K rp rq rs rt) F2)
            (subst (list '= (LI F2) (list '+ (LI md-F1) (LI K))))
            (subst (list '= (LI md-F1) 0))
            (subst (list '= (LI K) (list '* md-Ga (LI P))))
            (subst (list '= (LI P) 0))
            (crs))))
      (md-and! (list 'HOLOMORPHIC-ON md-PUN F2) (md-road-zero F2))
      (md-witness! md-d1 md-h1 F2
        (lambda (z)
          (let* ((leaf (proof-state-focus *ps*)) (rv (md-rv z)))
            (md-pt! z)
            (md-fun-typ! md-F1 md-PUN z)
            (md-lam-b!)
            (dk-apply! (dk-ctx-form md-W) z)
            (subst (list '= (list '* (list 'power rv sn) (list 'mdg_ z)) (md-W-rhs z)))
            (if (not (sequent-node-grounded? leaf)) (rfl))))))))
;; ---- base: N = 0: d = 0, h = g, F = 0
(dk-focus! (cdr (assq 'base md-ind)))
(dk-peel!)
(md-ball-setup!)
(fact 'cc-zero-in)
(dk-cite! 'holomorphic-on-in-fun md-B 'mdg_)
(dk-split-all! (list (dk-cite! 'md-zero-exact 'a)))
(md-witness! 0 'mdg_ md-Z
  (lambda (z)
    (let* ((leaf (proof-state-focus *ps*)) (rv (md-rv z)))
      (md-pb-open! z)
      (md-fun-typ! 'mdg_ md-B z)
      (md-cc! rv)
      (md-lam-b!)
      (fact 'power-zero rv)
      (subst (list '= (list 'power rv 0) 1))
      (let ((vv (dk-name! rv 'CC)))
        (subst (list '= rv vv))
        (if (not (sequent-node-grounded? leaf)) (crs))))))
(md-dump-open!)
(qed 'meromorphic-local-decomposition)

;;; ===============================================================================================================
;;; (6) THE RESIDUE OF A DECOMPOSED FUNCTION.  If f = h + d/(z - a) + F on B(a, r) \ {a} (h holomorphic on the ball,
;;;     F as in (5)), then 1/(2 pi i) int_{|w - a| = rho} f = d for every 0 < rho < r, and RESIDUE(f, a) = d.
;;; ===============================================================================================================
(define md-tp '(* 2 PI))
(define md-tpi '(* (* 2 PI) +i))
(define (md-C rho) (list 'CIRCLE-PATH 'a rho))
(define (md-Cd rho) (list 'CIRCLE-DERIV 'a rho))
(define (md-T rho) (list 'TRACE (md-C rho) 0 md-tp))
(define (md-LI F rho) (list 'LINE-INT F (md-C rho) (md-Cd rho) 0 md-tp))
(define (md-fT f rho) (list 'VNB-LAMBDA 'mrw_ (md-T rho) (list f 'mrw_)))
(define (md-resprop x f)               ; the body of RESIDUE(f, a) at x
  (list 'AND (list 'IN x 'CC)
     (list 'FORSOME 'mrr_ (list 'AND '(IN mrr_ RR) (list 'AND '(< 0 mrr_)
       (list 'FORALL 'mrp_ (list 'IMPLIES '(IN mrp_ RR) (list 'IMPLIES '(< 0 mrp_) (list 'IMPLIES '(< mrp_ mrr_)
         (list '= x (list '* (list 'recip md-tpi) (md-LI (md-fT f 'mrp_) 'mrp_))))))))))))
(define (md-dec-law fn d h fd)         ; fn = h + d/(z - a) + fd on B \ {a}
  (list 'FORALL 'mdz_ (list 'IMPLIES (list 'IN 'mdz_ md-PB)
    (list '= (list fn 'mdz_) (list '+ (list h 'mdz_) (list '+ (list '* d '(recip (- mdz_ a))) (list fd 'mdz_)))))))
(define (md-circle! rho)               ; 0 < rho in context: the circle a closed road, its trace a set in CC
  (dk-cite! 'circle-is-road 'a rho)
  (fact 'is-road-is-path (md-C rho) (md-Cd rho) 0 md-tp)
  (fact 'is-path-in-fun (md-C rho) 0 md-tp)
  (dk-cite! 'trace-subset-cc (md-C rho) 0 md-tp)
