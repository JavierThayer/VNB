(dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ md6-T) (list '== (list md6-qT 'wnx_) (list 'mdf_ 'wnx_))))
  (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))) (md6-pt! y) (md-lam-b!) (if (not (sequent-node-grounded? leaf)) (qrfl)))))
(define (md6-LI F) (md-LI F 'rho))
