;;; (7) RESIDUE(f, a) is the d of any decomposition (6): the circle integrals agree below both radii
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'a (list 'FORALL 'mdx_ (list 'FORALL 'mdy_
  (list 'IMPLIES (md-resprop 'mdx_ 'f) (list 'IMPLIES (md-resprop 'mdy_ 'f) '(= mdx_ mdy_)))))))))
(dk-peel!)
(for-each (lambda (v) (if (dk-asm? (md-resprop v 'f)) (dk-split-all! (list (md-resprop v 'f))))) '(mdx_ mdy_))
(define md7-r1 (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'mdx_))) "x's radius")))
(define md7-r2 (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'mdy_))) "y's radius")))
(define (md7-at! rho)
  (let* ((ux (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'mdx_))) "x's law"))
         (uy (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'mdy_))) "y's law")))
    (dk-type! rho 'RR)
    (for-each (lambda (cl) (dk-have! cl (lambda () (dk-ineq! (list 'IN rho 'RR) (list 'IN md7-r1 'RR) (list 'IN md7-r2 'RR)
                                                             (list '< 0 md7-r1) (list '< 0 md7-r2) (dk-ctx-form (if (eq? (caddr rho) md7-r1) (list '<= md7-r1 md7-r2) (list '< md7-r2 md7-r1)))))))
              (list (list '< 0 rho) (list '< rho md7-r1) (list '< rho md7-r2)))
    (let* ((ex (dk-apply! ux rho)) (ey (dk-apply! uy rho)))
      (subst ex) (subst ey)
      (if (pair? (dk-open-leaves)) (rfl)))))
(use-em (list '<= md7-r1 md7-r2)
  (lambda () (md7-at! (list '* 1/2 md7-r1)))
  (lambda () (fact 'rr-not-le-lt md7-r1 md7-r2) (md7-at! (list '* 1/2 md7-r2))))
(md-dump-open!)
(qed 'residue-property-unique)

(define (md-resprop-land! x)            ; the property of x as ONE conjunction (dk-split! consumes it)
