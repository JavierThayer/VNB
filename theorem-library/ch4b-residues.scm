    (if (not (dk-asm? (rt-Q S))) (dk-landed-1 (lambda () (detach! (list 'IMPLIES (list 'SUBSET S 'u) (rt-Q S))))))
    (dk-peel!)
    (let* ((g (dk-goal)) (ln (caddr (cadr g))) (rd (cddr ln)) (rp1 (car rd)) (rq1 (cadr rd)) (rs1 (caddr rd)) (rt1 (cadddr rd))
           (TR (list 'TRACE rp1 rs1 rt1))
           (LI (lambda (F) (list 'LINE-INT F rp1 rq1 rs1 rt1)))
           (Fn (lambda (fn) (list 'VNB-LAMBDA 'mqx_ 'CC (list '* (list 'RESIDUE fn 'mqx_) (list 'WINDING rp1 rq1 rs1 rt1 'mqx_)))))
           (decU (list 'FORALL 'mqe_ (list 'IMPLIES (list 'IN 'mqe_ SB) (mq-dec 'f 'mqe_)))))
      (md-road-facts! rp1 rq1 rs1 rt1)
      (dk-apply! (dk-ctx-form decU) x)
      (dk-have! (list 'FORALL 'mqe_ (list 'IMPLIES (list 'IN 'mqe_ S) (mq-dec 'f 'mqe_)))
        (lambda () (let* ((e (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                     (rt-mem-sb! S x e) (dk-apply! (dk-ctx-form decU) e) (if (not (sequent-node-grounded? leaf)) (ass)))))
      ;; the step lemma
      (let* ((gg (dk-skolem! (dk-cite! 'residue-theorem-step 'u S x 'f)))
             (conjU (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (eq? (cadr fm) 'mqe_) (dk-contains? fm gg) (dk-contains? fm 'RESIDUE))) "g's decompositions"))
             (roadU (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (eq? (cadr fm) 'mdp_) (dk-contains? fm gg))) "g's road law")))
        (dk-have! (list 'FORALL 'mqe_ (list 'IMPLIES (list 'IN 'mqe_ S) (mq-dec gg 'mqe_)))
          (lambda () (let* ((e (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                       (dk-split-all! (list (dk-apply! conjU e))) (if (not (sequent-node-grounded? leaf)) (ass)))))
        (dk-have! (list 'SUBSET DSB DS)
          (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                       (let ((iff (dk-cite! 'difference-membership 'u SB y)) (iff2 (dk-cite! 'difference-membership 'u S y))
                             (ui (dk-cite! 'union-membership S (list 'PAIR x x) y)))
                         (md-only-prop! iff iff2 ui (list 'IN y DSB))))))
        (fact 'subset-trans TR DSB DS)
        ;; the induction hypothesis at g, the road law
        (let* ((ih (dk-apply! (dk-ctx-form (rt-Q S)) gg rp1 rq1 rs1 rt1))
               (rl (dk-apply! roadU rp1 rq1 rs1 rt1)))
          (rt-ag-setup!)
          (md-tpi!)
          (dk-cite! 'holomorphic-on-continuous DS gg)
          (dk-cite! 'holomorphic-on-in-fun DS gg)
          (dk-cite! 'holomorphic-on-open DS gg)
          (dk-cite! 'cc-open-subset-cc DS)
          (dk-cite! 'line-int-in-cc DS gg rp1 rq1 rs1 rt1)
          ;; residues and windings typed at the points of S u {x}
          (let ((pt-typ! (lambda (z)
                           (md-steps
                             (lambda () (fact 'subset-mem-fwd SB 'u z))
                             (lambda () (fact 'subset-mem-fwd 'u 'CC z))
                             (lambda () (dk-apply! (dk-ctx-form decU) z))
                             (lambda () (let* ((dat (mq-dec-open! 'f z)))
                                          (dk-cite! 'residue-of-decomposition z (list-ref dat 0) (list-ref dat 1) (list-ref dat 2) (list-ref dat 3) 'f)
                                          (dk-have! (list 'IN (list 'RESIDUE 'f z) 'CC) (lambda () (subst (list '= (list 'RESIDUE 'f z) (list-ref dat 1))) (ass)))))
                             (lambda () (dk-have! (list 'NOT (list 'IN z TR))
                                          (lambda () (di)
                                            (fact 'subset-mem-fwd TR DSB z)
                                            (let ((iff (dk-cite! 'difference-membership 'u SB z))) (md-only-prop! iff (list 'IN z DSB) (list 'IN z SB))))))
                             (lambda () (dk-cite! 'winding-in-cc rp1 rq1 rs1 rt1 z))
                             (lambda () (md-cc! (list '* (list 'RESIDUE 'f z) (list 'WINDING rp1 rq1 rs1 rt1 z))))))))
            (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ SB) (list 'IN (list (Fn 'f) 'z_) (list 'CARR rt-ag))))
              (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (pt-typ! z)
                           (subst (list '== (list 'CARR rt-ag) 'CC))
                           (md-lam-b!)
                           (if (not (sequent-node-grounded? leaf)) (ass)))))
            (let ((ins (dk-cite! 'finsum-insert-ptwise rt-ag S x (Fn 'f))))
              (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z S) (list '= (list (Fn gg) 'z) (list (Fn 'f) 'z))))
                (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                             (rt-mem-sb! S x z) (pt-typ! z)
                             (dk-split-all! (list (dk-apply! conjU z)))
                             (md-lam-b!)
                             (subst (list '= (list 'RESIDUE gg z) (list 'RESIDUE 'f z)))
                             (if (not (sequent-node-grounded? leaf)) (rfl)))))
              (dk-cite! 'finsum-congruence-q rt-ag S (Fn gg) (Fn 'f))
              (pt-typ! x)
              (let* ((FSg (list 'FINSUM rt-ag (Fn gg) S)) (FSf (list 'FINSUM rt-ag (Fn 'f) S))
                     (R (list 'RESIDUE 'f x)) (W (list 'WINDING rp1 rq1 rs1 rt1 x)))
                (dk-have! (list 'IN FSg 'CC) (lambda () (subst (list '= FSg (cadr ih))) (md-cc! (cadr ih)) (if (pair? (dk-open-leaves)) (ass))))
                (dk-have! (list 'IN FSf 'CC) (lambda () (subst (list '== FSf FSg)) (ass)))
                (subst ins)
                (subst (list '== (list 'OPR rt-ag) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_))))
                (md-lam-b!)
                (subst rl)
                (subst (list '== FSf FSg))
                (subst (list '= FSg (cadr ih)))
                (let* ((mdd-gfun (dk-name! (LI gg) 'CC)) (Rv (dk-name! R 'CC)) (Wv (dk-name! W 'CC)) (rti (rt-rho-name!)))
                  (subst (list '= (LI gg) mdd-gfun)) (subst (list '= R Rv)) (subst (list '= W Wv)) (subst (list '= (list 'recip md-tpi) rti))
                  (let ((lhs (cadr (dk-goal))))
                    (dk-have! (list '= lhs (list '+ (list '* rti mdd-gfun) (list '* (list '* md-tpi rti) (list '* Rv Wv)))) (lambda () (crs)))
                    (subst (list '= lhs (list '+ (list '* rti mdd-gfun) (list '* (list '* md-tpi rti) (list '* Rv Wv)))))
                    (subst (list '= (list '* md-tpi rti) 1))
                    (crs)))))))))))
;; ---- induction on the cardinality
(define rt-P
  (list 'FORALL 'rtn_ (list 'IMPLIES '(IN rtn_ NN)
    (list 'FORALL 'mse_ (md-imps (list '(IN mse_ SET) '(= (CARD mse_) rtn_) '(SUBSET mse_ u)) (rt-Q 'mse_))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN md-nfm 'u) rt-P))))
(di) (di)
(fact 'nf-cc-is-metric-space) (fact 'cc-is-metric-space)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'empty-set-is-set)
(define rt-ind (use-induction))
(define rt-n (cdr (assq 'var rt-ind)))
(define rt-ih (cdr (assq 'ih rt-ind)))
;; step: CARD S = succ n
(let* ((S (cadr (dk-goal))))
  (di) (di) (di)
  (fact 'nn-succ-closed rt-n)
  ;; S has an element
  (dk-have! (list 'FORSOME 'rtx_ (list 'IN 'rtx_ S))
    (lambda ()
      (use-em (list 'FORSOME 'rtx_ (list 'IN 'rtx_ S))
        (lambda () (ass))
        (lambda ()
          (let ((ce (dk-cite! 'class-extensionality S 'EMPTY-SET)))
            (dk-have! (cadr ce) (lambda () (let ((y (begin (di) (cadr (cadr (dk-goal))))))
                                             (fact 'empty-set-has-no-members y)
                                             (dk-have! (list 'NOT (list 'IN y S)) (lambda () (di) (dk-have! (list 'FORSOME 'rtx_ (list 'IN 'rtx_ S)) (lambda () (ew y) (ass))) (ai (list 'NOT (list 'FORSOME 'rtx_ (list 'IN 'rtx_ S))))))
                                             (prop))))
            (dk-landed-1 (lambda () (detach! ce)))
            (fact 'card-empty)
            (dk-have! (list '= (list 'succ rt-n) 0)
              (lambda () (subst (list '= (list 'succ rt-n) (list 'CARD S))) (subst (list '= S 'EMPTY-SET)) (ass)))
            (md-rr! (list 'succ rt-n))
            (dk-have! (list '< 0 (list 'succ rt-n)) (lambda () (dk-nn!)))
            (dk-absurd! (list '< 0 (list 'succ rt-n)) (list '= (list 'succ rt-n) 0) (list 'IN (list 'succ rt-n) 'RR)))))))
  (let* ((x (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'rtx_))) "an element")))
         (S1 (list 'DIFFERENCE S (list 'PAIR x x))))
    (fact 'membership-implies-sethood x S)
    (md-and! (list 'IN x 'SET) (list 'IN x 'SET))
    (fact 'pairing x x)
    (dk-cite! 'difference-set S (list 'PAIR x x))
    (dk-cite! 'remove-restore S x)
    (let ((dm (dk-cite! 'difference-membership S (list 'PAIR x x) x)) (pm (dk-cite! 'pairing-membership x x x)))
      (dk-have! (list '= x x) (lambda () (rfl)))
      (dk-have! (list 'NOT (list 'IN x S1)) (lambda () (prop))))
    (md-and! (list 'IN x 'SET) (list 'NOT (list 'IN x S1)))
    (dk-have! (list '= (list 'CARD (list 'UNION S1 (list 'PAIR x x))) (list 'succ rt-n))
      (lambda () (subst (list '= (list 'UNION S1 (list 'PAIR x x)) S)) (ass)))
    (dk-cite! 'card-insert-converse S1 x rt-n)
    (dk-have! (list 'SUBSET S1 'u)
      (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                   (let ((dm (dk-cite! 'difference-membership S (list 'PAIR x x) y))) (dk-have! (list 'IN y S) (lambda () (prop))))
                   (fact 'subset-mem-fwd S 'u y) (if (not (sequent-node-grounded? leaf)) (ass)))))
    (dk-apply! rt-ih S1)
    (fact 'nn-in-rr rt-n)
    (dk-have! (list 'IN (list 'CARD S1) 'NN) (lambda () (subst (list '= (list 'CARD S1) rt-n)) (ass)))
    (subst (list '= S (list 'UNION S1 (list 'PAIR x x))))
    (dk-have! (list 'SUBSET (list 'UNION S1 (list 'PAIR x x)) 'u) (lambda () (subst (list '= (list 'UNION S1 (list 'PAIR x x)) S)) (ass)))
    (rt-step-q! S1 x (list 'UNION S1 (list 'PAIR x x)))))
;; base: CARD S = 0, S is empty
(dk-focus! (cdr (assq 'base rt-ind)))
(let* ((S (cadr (dk-goal))))
  (di) (di) (di)
  (dk-cite! 'card-zero-is-empty S)
  (subst (list '= S 'EMPTY-SET))
  (rt-base!))
(md-dump-open!)
(qed 'residue-theorem-induction)

;;; (13) PROPOSITION 4.15 in the notes' terms: f holomorphic on u \ E, E a finite subset of u, f meromorphic at
;;;      every point of E (a pole or a removable singularity); a closed road in u \ E, null-homotopic in u:
;;;        1/(2 pi i) int f = sum over a in E of RESIDUE(f, a) WINDING(road, a)
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN md-nfm 'u)
  (list 'FORALL 'mse_ (md-imps (list '(IN mse_ SET) '(IN (CARD mse_) NN) '(SUBSET mse_ u))
    (list 'FORALL 'f (md-imps (list '(HOLOMORPHIC-ON (DIFFERENCE u mse_) f) '(FORALL mqe_ (IMPLIES (IN mqe_ mse_) (IS-MEROMORPHIC-AT f mqe_))))
      (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
        (md-imps (list '(IS-ROAD mdp_ mdq_ mds_ mdt_) '(SUBSET (TRACE mdp_ mds_ mdt_) (DIFFERENCE u mse_))
                       '(= (mdp_ mdt_) (mdp_ mds_)) '(NULL-HOMOTOPIC u mdp_ mds_ mdt_))
          (list '= (list '* (list 'recip md-tpi) '(LINE-INT f mdp_ mdq_ mds_ mdt_)) (list 'FINSUM rt-ag (rt-F 'f) 'mse_)))))))))))))))
(dk-peel!)
(dk-have! (list 'FORALL 'mqe_ (list 'IMPLIES '(IN mqe_ mse_) (mq-dec 'f 'mqe_)))
  (lambda ()
    (let* ((e (dk-di-var!)))
      (dk-apply! (dk-ctx-form '(FORALL mqe_ (IMPLIES (IN mqe_ mse_) (IS-MEROMORPHIC-AT f mqe_)))) e)
      (let* ((c (dk-split-all! (list (dk-cite! 'meromorphic-residue-decomposition 'f e))))
             (r (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'r) (dk-contains? fm e))) "r")))
             (h (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mdh_) (dk-contains? fm r))) "h")))
             (F (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mdf_) (dk-contains? fm h))) "F"))))
        (md-and! (list 'HOLOMORPHIC-ON (mq-pz e) F) (mq-road-zero e F))
        (mq-ew-chain! (list r (list 'RESIDUE 'f e) h F))))))
(let* ((P (dk-cite! 'residue-theorem-induction 'u)))
  (dk-have! '(= (CARD mse_) (CARD mse_)) (lambda () (rfl)))
  (let ((Q (dk-apply! P '(CARD mse_) 'mse_)))
    (dk-apply! Q 'f 'mdp_ 'mdq_ 'mds_ 'mdt_)
    (if (pair? (dk-open-leaves)) (ass))))
(md-dump-open!)
(qed 'residue-theorem)
