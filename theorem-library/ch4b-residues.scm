                                    ((dk-asm? g3) (ass))
                                    ((dk-head-is? g3 'AND) (dk-conj-close! (lambda () (ass))))
                                    (#t (subst (list '= '(RESIDUE f a) md8-d)) (ass)))))))
                           (#t (error "md8: unexpected" g2)))))))
                  (#t (error "md8: unexpected" g))))))))))
(md-dump-open!)
