;;; (8) THE INTERFACE: f meromorphic at a decomposes on a punctured ball with d = RESIDUE(f, a)
(define (md8-concl)
  (list 'AND '(IN (RESIDUE f a) CC)
    (list 'FORSOME 'r (list 'AND '(IN r RR) (list 'AND '(< 0 r)
      (list 'FORSOME 'mdh_ (list 'AND (list 'HOLOMORPHIC-ON md-B 'mdh_)
        (list 'FORSOME 'mdf_ (list 'AND (md-exact 'mdf_) (md-dec-law 'f '(RESIDUE f a) 'mdh_ 'mdf_))))))))))
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'a (list 'IMPLIES '(IS-MEROMORPHIC-AT f a) (md8-concl))))))
(dk-peel!)
(let* ((iff (dk-cite! 'is-meromorphic-at 'f 'a)) (rhs (caddr iff)))
  (dk-have! rhs (lambda () (md-only-prop! iff '(IS-MEROMORPHIC-AT f a))))
  (dk-split-all! (list (dk-ctx-form rhs))))
(define md8-N (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mrn_))) "N")))
(define md8-r (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mrr_))) "r")))
(define md8-g (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mrg_))) "g")))
(define md8-law0 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm md8-g))) "f = (1/(z - a))^N g"))
(define (md8-B) (list 'BALL 'CC-MS 'a md8-r))
(define md8-dec (dk-cite! 'meromorphic-local-decomposition md8-N 'a md8-r md8-g))
(define md8-d (dk-skolem! md8-dec))
(define md8-h (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mdh_))) "h")))
(define md8-F (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mdf_))) "F")))
(define md8-law1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm md8-F) (dk-contains? fm md8-g))) "the decomposition"))
(define md8-PB (list 'DIFFERENCE (md8-B) '(SINGLETON a)))
(define md8-dlaw
  (list 'FORALL 'mdz_ (list 'IMPLIES (list 'IN 'mdz_ md8-PB)
    (list '= '(f mdz_) (list '+ (list md8-h 'mdz_) (list '+ (list '* md8-d '(recip (- mdz_ a))) (list md8-F 'mdz_)))))))
(dk-have! md8-dlaw
  (lambda () (let* ((z (dk-di-var!)) (e0 (dk-apply! md8-law0 z)) (e1 (dk-apply! md8-law1 z)))
               (subst e0) (subst e1) (if (pair? (dk-open-leaves)) (rfl)))))
(md-and! (list 'HOLOMORPHIC-ON md-PUN md8-F) (md-road-zero md8-F))
(define md8-res (dk-cite! 'residue-circle-integral 'a md8-r md8-d md8-h md8-F 'f))
(dk-have! (md-resprop md8-d 'f)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (begin
              (ew md8-r)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (let* ((lk (dk-peel!)) (rho (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'RR))) lk)))))
                        (let ((e (dk-apply! md8-res rho)) (leaf (proof-state-focus *ps*)))
                          (subst e)
                          (if (not (sequent-node-grounded? leaf)) (rfl)))))))))))))
(dk-cite! 'residue-of-property 'f 'a md8-d)
(dk-have! '(IN (RESIDUE f a) CC) (lambda () (subst (list '= '(RESIDUE f a) md8-d)) (ass)))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
        (begin
          (ew md8-r)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (ass))
