;;; ======================================================================
;;; (5), THE PART THAT IS PROVEN: a composition law for HOLOMORPHIC-ON (absent
;;; from the tree: only diff-on-chain pointwise), and the notes' "for any
;;; positive s, log is holomorphic in s B(1, r) = B(s, s r)".
;;; ======================================================================
(define alg-hc-comp '(VNB-LAMBDA d2x_ algu_ (algg_ (algf_ d2x_))))
(sp (make-wff (list 'FORALL 'algu_ (list 'FORALL 'algv_ (list 'FORALL 'algf_ (list 'FORALL 'algg_
  (list 'IMPLIES '(HOLOMORPHIC-ON algu_ algf_) (list 'IMPLIES '(HOLOMORPHIC-ON algv_ algg_)
    (list 'IMPLIES '(FORALL d2y_ (IMPLIES (IN d2y_ algu_) (IN (algf_ d2y_) algv_)))
      (list 'HOLOMORPHIC-ON 'algu_ alg-hc-comp))))))))))
(dk-peel!)
(fact 'cc-is-normed-field)
(fact 'holomorphic-on-open 'algu_ 'algf_)
(fact 'holomorphic-on-in-fun 'algu_ 'algf_)
(fact 'holomorphic-on-in-fun 'algv_ 'algg_)
(fact 'fun-domain-in-set 'algu_ 'CC 'algf_)
(define alg-hc-maps (dk-ctx-form '(FORALL d2y_ (IMPLIES (IN d2y_ algu_) (IN (algf_ d2y_) algv_)))))
(define alg-hc-df (dk-fact! 'holomorphic-on-diff 'algu_ 'algf_))
(define alg-hc-dg (dk-fact! 'holomorphic-on-diff 'algv_ 'algg_))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (cond ((dk-head-is? (dk-goal) 'FORALL)
           (let* ((a (dk-di-var!))
                  (fa (list 'algf_ a)))
             (dk-apply! alg-hc-maps a)
             (let* ((l1 (dk-skolem! (dk-apply! alg-hc-df a)))
                    (l2 (dk-skolem! (dk-apply! alg-hc-dg fa))))
               (ew (list '(MUL CC-NORMED-FIELD) l2 l1))
               (alg-chain! (dk-fact! 'diff-on-chain 'CC-NORMED-FIELD 'algu_ 'algv_ 'algf_ 'algg_ a l1 l2))
               (ass))))
          ((dk-head-is? (dk-goal) 'IN)
           (dk-lam-type!
             (lambda ()
               (let ((x (dk-di-var!)))
                 (dk-apply! alg-hc-maps x)
                 (alg-guard! (lambda () (fact 'fun-apply-type-c 'algg_ 'algv_ 'CC (list 'algf_ x))) ass)))))
          (#t (ass)))))
(qed 'holomorphic-compose)

;;; (= (real-part X) X) for a real X
(define (alg-re-real! x)
  (let ((e (list '= (list 'real-part x) x)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (alg-rr-typ! x) (fact 'rr-subset-cc x) (fact 'rr-zero-in)
            (alg-cc-typ! (list '+ x (list '* 0 +i)))
            (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
            (dk-split-all! (list (alg-chain! (dk-fact! 'cc-re-im-of x x 0))))
            (ass))))
    e))
;;; (< 0 (real-part V)) from (< (magnitude (- V C)) D), C real, (<= D C)
(define (alg-re-pos! v c d)
  (let ((goal (list '< 0 (list 'real-part v))) (vc (list '- v c)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (alg-rr-typ! c) (fact 'rr-subset-cc c)
            (alg-cc-typ! vc)
            (alg-rr-typ! (list 'real-part vc)) (alg-rr-typ! (list 'real-part v)) (alg-rr-typ! (list 'magnitude vc))
            (fact 'cc-abs-re-le-magnitude vc)
            (dk-split-all! (list (alg-chain! (dk-fact! 'rr-abs-le-parts (list 'real-part vc) (list 'magnitude vc)))))
            (alg-and! (list 'IN v 'CC) (list 'IN c 'CC))
            (fact 'cc-re-sub v c)
            (alg-re-real! c)
            (alg-rr-typ! (list 'real-part c))
            (dk-ineq! (list '<= (list '- (list 'magnitude vc)) (list 'real-part vc))
                      (list '= (list 'real-part vc) (list '- (list 'real-part v) (list 'real-part c)))
                      (list '= (list 'real-part c) c)
                      (list '< (list 'magnitude vc) d)
                      (list '<= d c)))))
    goal))
;;; the slit-plane condition from a positive real part
(define (alg-slit-re! v)
  (let ((f (alg-slit v)))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (alg-rr-typ! (list 'real-part v))
            (di)
            (dk-split-all!)
            (dk-absurd! (list '<= (list 'real-part v) 0) (list '< 0 (list 'real-part v))))))
    f))

;;; log is holomorphic on B(s, s r) for every real s > 0 (r (1 + pi) <= pi)
(define alg-sc-sr '(* algs_ algr_))
(define alg-sc-B (list 'BALL 'CC-MS 'algs_ alg-sc-sr))
(define alg-sc-L (list 'VNB-LAMBDA 'algz_ alg-sc-B '(CC-LOG algz_)))
(define alg-sc-u '(recip algs_))
(define alg-sc-M (list 'VNB-LAMBDA 'algx_ alg-sc-B (list '* alg-sc-u 'algx_)))
(sp (make-wff (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR) (list 'IMPLIES '(< 0 algr_)
  (list 'IMPLIES '(<= (* algr_ (+ 1 PI)) PI)
    (list 'FORALL 'algs_ (list 'IMPLIES '(IN algs_ RR) (list 'IMPLIES '(< 0 algs_)
      (list 'HOLOMORPHIC-ON alg-sc-B alg-sc-L))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
(alg-rho-lt-one!)
(alg-r-facts!)
(alg-ball-open! 1)
(fact 'rr-subset-cc 'algs_)
(alg-rr-typ! alg-sc-sr)
(fact 'rr-subset-cc alg-sc-sr)
(dk-have! '(NOT (= algs_ 0)) (lambda () (di) (dk-absurd! '(= algs_ 0) '(< 0 algs_))))
(alg-rr-typ! alg-sc-u) (fact 'rr-subset-cc alg-sc-u)
(fact 'rr-recip-pos 'algs_)
(define alg-sc-inv (alg-chain! (dk-fact! 'rr-recip-inverse 'algs_)))
;; 0 < s r < s
(alg-chain! (dk-fact! 'rr-lt-scale-pos 'algs_ 0 'algr_))
(alg-chain! (dk-fact! 'rr-lt-scale-pos 'algs_ 'algr_ 1))
(alg-rr-typ! '(* algs_ 0)) (alg-rr-typ! '(* algs_ 1))
(dk-have! '(= (* algs_ 0) 0) (lambda () (subst (alg-ring-id! '(algu_) '(= (* algu_ 0) 0) (list 'algs_))) (rfl)))
(dk-have! '(= (* algs_ 1) algs_) (lambda () (subst (alg-ring-id! '(algu_) '(= (* algu_ 1) algu_) (list 'algs_))) (rfl)))
(dk-have! (list '< 0 alg-sc-sr) (lambda () (dk-ineq! '(< (* algs_ 0) (* algs_ algr_)) '(= (* algs_ 0) 0))))
(dk-have! (list '<= alg-sc-sr 'algs_) (lambda () (dk-ineq! '(< (* algs_ algr_) (* algs_ 1)) '(= (* algs_ 1) algs_))))
(dk-have! (list '<= 0 alg-sc-sr) (lambda () (dk-ineq! (list '< 0 alg-sc-sr))))
(dk-have! (list 'NOT (list '= 0 alg-sc-sr)) (lambda () (di) (dk-absurd! (list '= 0 alg-sc-sr) (list '< 0 alg-sc-sr))))
(alg-pts! 'algs_)
(fact 'ball-is-set 'CC-MS 'algs_ alg-sc-sr)
(alg-chain! (dk-fact! 'ball-is-open 'CC-MS 'algs_ alg-sc-sr))
;; a point x of B(s, s r): x in CC, |x - s| < s r, Re x > 0, u x in B(1, r)
(define (alg-sc-pt! x)
  (let* ((ux (list '* alg-sc-u x)) (xs (list '- x 'algs_)) (d (list '(DIST CC-MS) 'algs_ x)))
    (if (not (dk-asm? (list 'IN ux alg-B1)))
        (begin
          (fact 'ball-membership 'CC-MS 'algs_ alg-sc-sr x)
          (let ((iff (iff-for (list 'IN x alg-sc-B))))
            (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (if (dk-only! iff (list 'IN x alg-sc-B)) (prop))))
            (dk-have! (list 'IN x 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
            (dk-have! (list '< d alg-sc-sr)
              (lambda () (mac '<) (dk-conj-close! (lambda () (if (dk-only! iff (list 'IN x alg-sc-B)) (prop)))))))
          (alg-cc-typ! xs) (alg-cc-typ! (list '- 'algs_ x)) (alg-cc-typ! ux)
          (alg-rr-typ! (list 'magnitude xs))
          (fact 'cc-ms-dist 'algs_ x)
          (dk-have! (list '< (list 'magnitude xs) alg-sc-sr)
            (lambda ()
              (dk-have! (list '= xs (list '- (list '- 'algs_ x))) (lambda () (crs)))
              (subst (list '= xs (list '- (list '- 'algs_ x))))
              (subst (dk-fact! 'cc-magnitude-neg (list '- 'algs_ x)))
              (subst (list '= (list 'magnitude (list '- 'algs_ x)) d))
              (ass)))
          ;; |u x - 1| = u |x - s| < u s r = r
          (alg-cc-typ! (list '- ux 1))
          (dk-have! (list '= (list '- ux 1) (list '* alg-sc-u xs))
            (lambda ()
              (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (- (* algu_ algv_) 1) (+ (* algu_ (- algv_ algw_)) (- (* algu_ algw_) 1))) (list alg-sc-u x 'algs_)))
              (subst (alg-ring-id! '(algu_ algv_) '(= (* algu_ algv_) (* algv_ algu_)) (list alg-sc-u 'algs_)))
              (subst alg-sc-inv)
              (subst (alg-ring-id! '(algu_) '(= (+ algu_ (- 1 1)) algu_) (list (list '* alg-sc-u xs))))
              (rfl)))
          (alg-and! (list 'IN alg-sc-u 'CC) (list 'IN xs 'CC))
          (alg-rr-typ! (list '* alg-sc-u (list 'magnitude xs)))
          (alg-rr-typ! (list '* alg-sc-u alg-sc-sr))
          (dk-have! (list 'AND (list '< 0 alg-sc-u) (list '< (list 'magnitude xs) alg-sc-sr)) (lambda () (dk-conj-close! (lambda () (ass)))))
          (alg-chain! (dk-fact! 'rr-lt-scale-pos alg-sc-u (list 'magnitude xs) alg-sc-sr))
          (dk-have! (list '= (list '* alg-sc-u alg-sc-sr) 'algr_)
            (lambda ()
              (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* algu_ (* algv_ algw_)) (* (* algv_ algu_) algw_)) (list alg-sc-u 'algs_ 'algr_)))
              (subst alg-sc-inv)
              (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list 'algr_)))
              (rfl)))
          (alg-pts! ux)
          (alg-rr-typ! (list 'magnitude (list '- ux 1)))
          (dk-have! (list '<= (list '(DIST CC-MS) 1 ux) (list '* alg-sc-u (list 'magnitude xs)))
            (lambda ()
              (fact 'cc-ms-dist 1 ux)
              (alg-cc-typ! (list '- 1 ux))
              (subst (list '== (list '(DIST CC-MS) 1 ux) (list 'magnitude (list '- 1 ux))))
              (dk-have! (list '= (list '- 1 ux) (list '- (list '- ux 1))) (lambda () (crs)))
              (subst (list '= (list '- 1 ux) (list '- (list '- ux 1))))
              (subst (dk-fact! 'cc-magnitude-neg (list '- ux 1)))
              (subst (list '= (list '- ux 1) (list '* alg-sc-u xs)))
              (subst (dk-fact! 'cc-magnitude-mul alg-sc-u xs))
              (subst (dk-fact! 'rr-magnitude-is-abs alg-sc-u))
              (dk-have! (list '<= 0 alg-sc-u) (lambda () (dk-ineq! (list '< 0 alg-sc-u))))
              (subst (alg-chain! (dk-fact! 'rr-abs-of-nonneg alg-sc-u)))
              (dk-ineq!)))
          (dk-have! (list '< (list '* alg-sc-u (list 'magnitude xs)) 'algr_)
            (lambda () (dk-ineq! (list '< (list '* alg-sc-u (list 'magnitude xs)) (list '* alg-sc-u alg-sc-sr))
                                 (list '= (list '* alg-sc-u alg-sc-sr) 'algr_))))
          (alg-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 1 ux (list '* alg-sc-u (list 'magnitude xs)) 'algr_))
          (alg-re-pos! x 'algs_ alg-sc-sr)
          (alg-slit-re! x)
          (alg-ball-lt! ux 1)
          (alg-re-pos! ux 1 'algr_)
          (alg-slit-re! ux)))))
(dk-have! '(<= algr_ 1) (lambda () (dk-ineq! '(< algr_ 1))))
;; the point facts once, as a universal (each use is then one instantiation)
(define alg-sc-ptf
  (list 'FORALL 'algx_ (list 'IMPLIES (list 'IN 'algx_ alg-sc-B)
    (list 'AND '(IN algx_ CC) (list 'AND (list 'IN (list '* alg-sc-u 'algx_) alg-B1)
      (list 'AND (alg-slit 'algx_) (alg-slit (list '* alg-sc-u 'algx_))))))))
(dk-have! alg-sc-ptf
  (lambda ()
    (let ((x (dk-di-var!)))
      (alg-sc-pt! x)
      (dk-conj-close! (lambda () (ass))))))
(define (alg-sc-pt1! x)
  (if (not (dk-asm? (list 'IN (list '* alg-sc-u x) alg-B1)))
      (dk-split-all! (list (dk-apply! (dk-ctx-form alg-sc-ptf) x))))
  (alg-cc-typ! (list '* alg-sc-u x)))
;; the pieces: M(x) = u x maps B(s, s r) into B(1, r), holomorphically
(alg-lam-typ! alg-sc-M alg-sc-B 'CC (lambda (x) (alg-sc-pt1! x)))
(fact 'cc-ms-open-iff alg-sc-B)
(define alg-sc-cst (list 'VNB-LAMBDA 'hbx_ alg-sc-B alg-sc-u))
(define alg-sc-id (list 'VNB-LAMBDA 'hbx_ alg-sc-B 'hbx_))
(define alg-sc-hc (alg-chain! (dk-fact! 'holomorphic-const alg-sc-B)))
(dk-apply! alg-sc-hc alg-sc-u)
(alg-chain! (dk-fact! 'holomorphic-identity alg-sc-B))
(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ alg-sc-B) (list '== (list alg-sc-M 'hbx_) (list '* (list alg-sc-cst 'hbx_) (list alg-sc-id 'hbx_)))))
  (lambda () (let ((x (dk-di-var!))) (alg-sc-pt1! x) (alg-beta! (lambda () (qrfl))))))
(alg-chain! (dk-fact! 'holomorphic-product alg-sc-B alg-sc-cst alg-sc-id alg-sc-M))
(dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES (list 'IN 'd2y_ alg-sc-B) (list 'IN (list alg-sc-M 'd2y_) alg-B1)))
  (lambda () (let ((y (dk-di-var!))) (alg-sc-pt1! y) (alg-beta! (lambda () (ass))))))
(alg-chain! (dk-fact! 'cc-log-holomorphic-near-one 'algr_))
(define alg-sc-comp (list 'VNB-LAMBDA 'd2x_ alg-sc-B (list alg-lh-L (list alg-sc-M 'd2x_))))
(alg-chain! (dk-fact! 'holomorphic-compose alg-sc-B alg-B1 alg-sc-M alg-lh-L))
;; log x = log s + log(u x)
(define alg-sc-ls '(LOG algs_))
(alg-rr-typ! alg-sc-ls) (fact 'rr-subset-cc alg-sc-ls)
(define alg-sc-c2 (list 'VNB-LAMBDA 'hbx_ alg-sc-B alg-sc-ls))
(dk-apply! alg-sc-hc alg-sc-ls)
(alg-lam-typ! alg-sc-L alg-sc-B 'CC
  (lambda (x) (alg-sc-pt1! x) (dk-split-all! (list (alg-chain! (dk-fact! 'cc-log-in-slit x))))))
(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ alg-sc-B) (list '== (list alg-sc-L 'hbx_) (list '+ (list alg-sc-c2 'hbx_) (list alg-sc-comp 'hbx_)))))
  (lambda ()
    (let* ((x (dk-di-var!)) (ux (list '* alg-sc-u x)) (sux (list '* 'algs_ ux)))
      (alg-sc-pt1! x)
      (alg-cc-typ! sux)
      (dk-have! (list '= sux x)
        (lambda ()
          (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* algu_ (* algv_ algw_)) (* (* algu_ algv_) algw_)) (list 'algs_ alg-sc-u x)))
          (subst alg-sc-inv)
          (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list x)))
          (rfl)))
      (dk-congr! (list '= sux x) (lambda (t) (list 'CC-LOG t)) '==)
      (alg-beta!
        (lambda ()
          (subst (list '= (list 'CC-LOG x) (list 'CC-LOG sux)))
          (subst (alg-chain! (dk-fact! 'cc-log-scale 'algs_ ux)))
          (qrfl))))))
(alg-chain! (dk-fact! 'holomorphic-sum alg-sc-B alg-sc-c2 alg-sc-comp alg-sc-L))
(ass)
(qed 'cc-log-holomorphic-scale)

;;; ----------------------------------------------------------------------
;;; PROP 2.21 AS THE NOTES STATE IT: log0 = ln on (0, 2).  On the real axis
;;; the strip condition is free: the series has real terms there, so its sum is
;;; real (Im = 0: cc-coords-of-converges against the zero sequence), and
;;; exp(log0 t) = t (log0-exp, any r < 1) gives log t = log0 t by
;;; cc-log-char; cc-log-real turns log t into LOG t.
;;; ----------------------------------------------------------------------
(define (alg-coef-real! k)               ; (IN (algc_ k) RR)
  (let ((f (list 'IN (list 'algc_ k) 'RR)))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (use-em (list '= k 0)
              (lambda () (subst (list '= k 0)) (subst alg-lv0) (fact 'rr-zero-in) (ass))
              (lambda ()
                (let* ((q (dk-skolem! (alg-chain! (dk-fact! 'nn-nonzero-is-succ k))))
                       (sq (list 'succ q)))
                  (subst (list '= k sq))
                  (subst (dk-apply! (dk-ctx-form alg-lv1) q))
                  (alg-succ-nz! q)
                  (alg-guard! (lambda () (alg-rr-typ! (list '* (list 'power -1 q) (list 'recip sq)))) ass)))))))
    f))
(sp (make-wff (alg-log-r-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-B1) (list 'IMPLIES '(IN algz_ RR)
    (list 'AND (list 'IN (alg-S1 'algz_) 'CC) (list '= (list 'imag-part (alg-S1 'algz_)) 0))))))))
(alg-log1-setup!)
(alg-ball-lt! 'algz_ 1)
(alg-shift-pt1! 'algz_)
(alg-rr-typ! alg-lb-w)
(alg-rr-typ! alg-lb-t)
(fact 'cc-magnitude-nonneg alg-lb-w)
(dk-have! (list '< alg-lb-t 1) (lambda () (dk-ineq! (list '< alg-lb-t 'algr_) '(< algr_ 1))))
(alg-lam-typ! alg-lb-f 'NN 'CC (lambda (k) (alg-cc-typ! (list '* (list 'algc_ k) (list 'power alg-lb-w k)))))
;; the partial sums are real
(define alg-lr-claim
  (list 'FORALL 'algm_ (list 'IMPLIES '(IN algm_ NN) (list 'IN (list 'CC-SERIES-PARTIAL-SUM alg-lb-f 'algm_) 'RR))))
(dk-have! alg-lr-claim
  (lambda ()
    (let* ((br (use-induction))
           (m (cdr (assq 'var br)))
           (step (cdr (assq 'step br))))
      (dk-focus! (cdr (assq 'base br)))
      (subst (dk-fact! 'cc-series-partial-sum-zero alg-lb-f))
      (ass)
      (dk-focus! step)
      (let ((term (list '* (list 'algc_ m) (list 'power alg-lb-w m))))
        (fact 'cc-series-partial-sum-in-cc m alg-lb-f)
        (alg-cc-typ! (list alg-lb-f m))
        (subst (alg-chain! (dk-fact! 'cc-series-partial-sum-succ alg-lb-f m)))
        (alg-coef-real! m)
        (alg-rr-typ! (list 'power alg-lb-w m))
        (alg-rr-typ! term)
        (alg-beta!
          (lambda ()
            (alg-guard! (lambda () (alg-rr-typ! (list '+ (list 'CC-SERIES-PARTIAL-SUM alg-lb-f m) term))) ass)))))))
;; the series converges at w (as in log0-bound)
(fact 'rr-subset-cc alg-lb-t)
(alg-chain! (dk-fact! 'cps-log-radius 'algc_ alg-lb-t))
(fact 'cc-ms-dist 0 alg-lb-w)
(alg-cc-typ! (list '- 0 alg-lb-w))
(dk-have! (list 'IN alg-lb-w (list 'CLOSED-BALL 'CC-MS 0 alg-lb-t))
  (lambda ()
    (mac 'closed-ball-membership)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (begin (subst '(== (PTS CC-MS) CC)) (ass))
            (begin
              (subst (list '== (list '(DIST CC-MS) 0 alg-lb-w) (list 'magnitude (list '- 0 alg-lb-w))))
              (dk-have! (list '= (list '- 0 alg-lb-w) (list '- alg-lb-w)) (lambda () (crs)))
              (subst (list '= (list '- 0 alg-lb-w) (list '- alg-lb-w)))
              (subst (dk-fact! 'cc-magnitude-neg alg-lb-w))
              (dk-ineq!)))))))
(dk-apply! (alg-chain! (dk-fact! 'cps-converges-closed-ball 'algc_ alg-lb-t)) alg-lb-w)
(define alg-lr-sl (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM alg-lb-f 'k)))
(alg-lam-typ! alg-lr-sl 'NN 'CC (lambda (k) (fact 'cc-series-partial-sum-in-cc k alg-lb-f)))
(define alg-lr-S (list 'CC-SERIES-LIMIT alg-lb-f))
(fact 'cc-series-limit-in-cc alg-lb-f)
(dk-have! (list 'CONVERGES-TO 'CC-MS alg-lr-sl alg-lr-S)
  (lambda ()
    (let ((c (alg-chain! (dk-fact! 'cc-series-limit-converges-to alg-lb-f))))
      (mac-h 'cc-series-converges-to c)
      (ass))))
;; real and imaginary parts of the partial sums
(define alg-lr-g (list 'VNB-LAMBDA 'n 'NN (list 'real-part (list 'CC-SERIES-PARTIAL-SUM alg-lb-f 'n))))
(define alg-lr-q '(VNB-LAMBDA n NN 0))
(alg-lam-typ! alg-lr-g 'NN 'RR (lambda (k) (fact 'cc-series-partial-sum-in-cc k alg-lb-f) (alg-rr-typ! (list 'real-part (list 'CC-SERIES-PARTIAL-SUM alg-lb-f k)))))
(alg-lam-typ! alg-lr-q 'NN 'RR (lambda (k) (fact 'rr-zero-in)))
(dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list 'real-part (list alg-lr-sl 'n_)) (list alg-lr-g 'n_))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (fact 'cc-series-partial-sum-in-cc n alg-lb-f)
      (alg-rr-typ! (list 'real-part (list 'CC-SERIES-PARTIAL-SUM alg-lb-f n)))
      (alg-beta! (lambda () (rfl))))))
(dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list 'imag-part (list alg-lr-sl 'n_)) (list alg-lr-q 'n_))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (dk-apply! (dk-ctx-form alg-lr-claim) n)
      (alg-im-real! (list 'CC-SERIES-PARTIAL-SUM alg-lb-f n))
      (alg-beta! (lambda () (ass))))))
(dk-split-all! (list (alg-chain! (dk-fact! 'cc-coords-of-converges alg-lr-sl alg-lr-g alg-lr-q alg-lr-S))))
(fact 'rr-zero-in)
(fact 'rr-const-converges-to 0)
(alg-rr-typ! (list 'imag-part alg-lr-S))
(alg-chain! (dk-fact! 'rr-limit-unique alg-lr-q (list 'imag-part alg-lr-S) 0))
(dk-conj-close! (lambda () (ass)))
(qed 'log0-real)

;;; THE NOTES' PROP 2.21: for 0 < t < 2, log0(t) = ln t
(define alg-ln-d '(abs (- algt_ 1)))
(define alg-ln-r (list '* (list '+ alg-ln-d 1) 1/2))
(sp (make-wff (alg-log-hyps
  (list 'FORALL 'algt_ (list 'IMPLIES '(IN algt_ RR) (list 'IMPLIES '(< 0 algt_) (list 'IMPLIES '(< algt_ 2)
    (list '= (alg-S1 'algt_) '(LOG algt_)))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
(fact 'rr-subset-cc 'algt_)
(alg-rr-typ! '(- algt_ 1))
(alg-rr-typ! alg-ln-d)
(fact 'rr-abs-nonneg '(- algt_ 1))
(dk-have! (list '< alg-ln-d 1)
  (lambda ()
    (dk-have! '(< (- 1) (- algt_ 1)) (lambda () (dk-ineq! '(< 0 algt_))))
    (dk-have! '(< (- algt_ 1) 1) (lambda () (dk-ineq! '(< algt_ 2))))
    (alg-chain! (dk-fact! 'rr-abs-lt-of-parts '(- algt_ 1) 1))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
(alg-rr-typ! alg-ln-r)
(dk-have! (list '< 0 alg-ln-r) (lambda () (dk-ineq! (list '<= 0 alg-ln-d))))
(dk-have! (list '< alg-ln-r 1) (lambda () (dk-ineq! (list '< alg-ln-d 1))))
(dk-have! (list '< alg-ln-d alg-ln-r) (lambda () (dk-ineq! (list '< alg-ln-d 1))))
(define alg-ln-B (list 'BALL 'CC-MS 1 alg-ln-r))
(alg-pts! 1) (alg-pts! 'algt_)
(fact 'cc-ms-dist 1 'algt_)
(alg-cc-typ! '(- 1 algt_))
(alg-rr-typ! '(- 1 algt_))
(dk-have! (list '<= '((DIST CC-MS) 1 algt_) alg-ln-d)
  (lambda ()
    (subst '(== ((DIST CC-MS) 1 algt_) (magnitude (- 1 algt_))))
    (subst (dk-fact! 'rr-magnitude-is-abs '(- 1 algt_)))
    (dk-have! '(= (- 1 algt_) (- (- algt_ 1))) (lambda () (crs)))
    (subst '(= (- 1 algt_) (- (- algt_ 1))))
    (subst (dk-fact! 'rr-abs-neg '(- algt_ 1)))
    (dk-ineq!)))
(alg-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 1 'algt_ alg-ln-d alg-ln-r))
(define alg-ln-S (alg-S1 'algt_))
(dk-split-all! (list (alg-chain! (dk-fact! 'log0-real 'algc_ alg-ln-r 'algt_))))
(alg-chain! (dk-fact! 'log0-exp 'algc_ alg-ln-r 'algt_))
(alg-pi-typ!)
(dk-have! (alg-lo alg-ln-S) (lambda () (subst (list '= (list 'imag-part alg-ln-S) 0)) (dk-ineq! '(< 0 PI))))
(dk-have! (alg-hi alg-ln-S) (lambda () (subst (list '= (list 'imag-part alg-ln-S) 0)) (dk-ineq! '(< 0 PI))))
(define alg-ln-c (alg-chain! (dk-fact! 'cc-log-char 'algt_ alg-ln-S)))
(fact 'cc-log-real 'algt_)
(subst (list '= alg-ln-S '(CC-LOG algt_)))
(ass)
(qed 'log0-is-ln)
