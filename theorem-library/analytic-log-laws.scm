(fact 'is-path-in-fun alg-zd-pg 0 1)
(define alg-zd-m (list 'magnitude alg-zd-w))
(alg-ball-lt! 'algz_ 'alga_)
(alg-rr-typ! alg-zd-m)
(fact 'cc-magnitude-nonneg alg-zd-w)
(dk-have! (list 'SUBSET (list 'TRACE alg-zd-pg 0 1) alg-Ba)
  (lambda ()
    (mac 'subset-def)
    (let* ((y (dk-di-var!))
           (tt (dk-skolem! (alg-chain! (dk-fact! 'seg-trace-elim 'alga_ 'algz_ y))))
           (tw (list '* tt alg-zd-w))
           (yy (list '+ 'alga_ tw))
           (d (list '* tt alg-zd-m))
           (dist (list '(DIST CC-MS) 'alga_ yy)))
      (mac-h 'ccint-membership (list 'IN tt '(CCINT 0 1)))
      (dk-split-all!)
      (subst (list '= y yy))
      (fact 'rr-subset-cc tt)
      (alg-cc-typ! tw) (alg-cc-typ! yy) (alg-rr-typ! d)
      (alg-pts! yy)
      (alg-chain! (dk-fact! 'rr-mul-le-right tt 1 alg-zd-m))
