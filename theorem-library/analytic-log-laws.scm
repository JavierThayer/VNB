;;; ----------------------------------------------------------------------
;;; PROP 2.21: log0 IS THE PRINCIPAL LOGARITHM on B(1, r) for every r with
;;; r (1 + pi) <= pi (so r < 1, and |Im log0 z| <= |log0 z| <= t/(1-t) < pi
;;; for t = |z - 1| < r): exp(log0 z) = z (log0-exp) and cc-log-char.
;;; ----------------------------------------------------------------------
(define (alg-log-rho-hyps concl)
  (alg-log-hyps (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR) (list 'IMPLIES '(< 0 algr_)
    (list 'IMPLIES '(<= (* algr_ (+ 1 PI)) PI) concl))))))
(define alg-lg-q '(+ 1 PI))
(define (alg-rho-lt-one!)                ; (< algr_ 1) from r (1 + pi) <= pi
  (alg-pi-typ!)
  (alg-rr-typ! alg-lg-q)
  (alg-rr-typ! '(* algr_ PI))
  (dk-have! '(<= (+ algr_ (* algr_ PI)) PI)
    (lambda ()
      (subst (alg-ring-id! '(algu_ algv_) '(= (+ algu_ (* algu_ algv_)) (* algu_ (+ 1 algv_))) (list 'algr_ 'PI)))
      (ass)))
  (dk-have! '(< algr_ 1)
    (lambda ()
      (use-cases (dk-fact! 'rr-lt-trichotomy 'algr_ 1)
        (lambda () (ass))
        (lambda ()
          (dk-have! '(= (* algr_ PI) PI) (lambda () (subst '(= algr_ 1)) (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list 'PI))) (rfl)))
          (dk-absurd! '(<= (+ algr_ (* algr_ PI)) PI) '(= (* algr_ PI) PI) '(= algr_ 1)))
        (lambda ()
          (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
          (dk-have! '(<= 1 algr_) (lambda () (dk-ineq! '(< 1 algr_))))
          (alg-chain! (dk-fact! 'rr-mul-le-right 1 'algr_ 'PI))
          (alg-rr-typ! '(* 1 PI))
          (dk-have! '(= (* 1 PI) PI) (lambda () (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list 'PI))) (rfl)))
          (dk-absurd! '(<= (+ algr_ (* algr_ PI)) PI) '(<= (* 1 PI) (* algr_ PI)) '(= (* 1 PI) PI) '(< 1 algr_)))))))
(sp (make-wff (alg-log-rho-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-B1) (list '= '(CC-LOG algz_) (alg-S1 'algz_)))))))
(dk-peel!)
(alg-ms-setup!)
