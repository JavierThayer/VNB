;;; ----------------------------------------------------------------------
;;; the log coefficients exist: C(k) = -((-1)^k) recip*(k)  (recip*(0) = 0)
;;; ----------------------------------------------------------------------
(define (alg-log-coefs!)
  (let* ((body (lambda (v) (list '* (list '- (list 'power -1 v)) (list 'RECIP-STAR v))))
         (ab (dk-abstract! 'NN 'CC body
               (lambda (v)
                 (alg-rr-typ! (list 'RECIP-STAR v))
                 (fact 'rr-subset-cc (list 'RECIP-STAR v))
                 (alg-cc-typ! (body v))
                 (ass))))
         (c (car ab)) (ve (cdr ab)))
    (alg-cc-typ! -1)
    (dk-have! (list '= (list c 0) 0)
      (lambda ()
        (fact 'nn-zero-in)
        (alg-cc-typ! '(- (power -1 0)))
        (subst (dk-apply! ve 0))
        (subst (dk-fact! 'recip-star-zero))
        (subst (alg-ring-id! '(algu_) '(= (* algu_ 0) 0) (list '(- (power -1 0)))))
        (rfl)))
    (dk-have! (subst-free 'algc_ c alg-lv1)
      (lambda ()
        (let* ((j (dk-di-var!)) (sj (list 'succ j)) (a (list 'power -1 j)) (rj (list 'recip sj)))
          (alg-nn-typ! sj)
          (alg-succ-nz! j)
          (alg-rr-typ! sj) (alg-rr-typ! rj) (fact 'rr-subset-cc rj)
          (alg-cc-typ! a)
          (alg-and! (list 'IN -1 'CC) (list 'IN j 'NN))
          (subst (dk-apply! ve sj))
          (subst (dk-fact! 'power-succ -1 j))
          (subst (alg-chain! (dk-fact! 'recip-star-value sj)))
          (subst (alg-ring-id! '(algu_ algv_) '(= (* (- (* -1 algu_)) algv_) (* algu_ algv_)) (list a rj)))
          (rfl))))
    c))

