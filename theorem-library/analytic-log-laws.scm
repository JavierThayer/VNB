      (dk-have! (list '< d 'algr_)
        (lambda () (dk-ineq! (list '<= d (list '* 1 alg-zd-m)) (list '< alg-zd-m 'algr_))))
      (fact 'cc-ms-dist 'alga_ yy)
      (alg-cc-typ! (list '- 'alga_ yy))
      (dk-have! (list '<= dist d)
        (lambda ()
          (subst (list '== dist (list 'magnitude (list '- 'alga_ yy))))
          (dk-have! (list '= (list '- 'alga_ yy) (list '- tw)) (lambda () (crs)))
          (subst (list '= (list '- 'alga_ yy) (list '- tw)))
          (subst (dk-fact! 'cc-magnitude-neg tw))
          (alg-and! (list 'IN tt 'CC) (list 'IN alg-zd-w 'CC))
          (subst (dk-fact! 'cc-magnitude-mul tt alg-zd-w))
          (subst (dk-fact! 'rr-magnitude-is-abs tt))
          (subst (alg-chain! (dk-fact! 'rr-abs-of-nonneg tt)))
          (dk-ineq!)))
      (alg-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 'alga_ yy d 'algr_))
      (ass))))
;; the line integral of the zero function is 0
(dk-have! '(IN 0 (CARR CC-NORMED-FIELD)) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(define alg-zd-const (dk-apply! (dk-fact! 'diff-on-const 'CC-NORMED-FIELD alg-Ba) 0))
(dk-have! (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ alg-Ba)
            (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS alg-nfm alg-Ba) alg-nfm alg-zd-Z 'rgy_)))
  (lambda ()
    (let ((y (dk-di-var!)))
      (dk-apply! alg-zd-const y)
      (fact 'diff-on-implies-continuous 'CC-NORMED-FIELD alg-Ba alg-zd-Z y '(ZERO CC-NORMED-FIELD))
      (ass))))
(define alg-zd-li (list 'LINE-INT alg-zd-Z alg-zd-pg alg-zd-dg 0 1))
(fact 'line-int-in-cc alg-Ba alg-zd-Z alg-zd-pg alg-zd-dg 0 1)
(define alg-zd-sc (dk-fact! 'line-int-scalar alg-Ba alg-zd-Z alg-zd-pg alg-zd-dg 0 1))
(dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ alg-Ba) (list '== (list alg-zd-Z 'liz_) (list '* 0 (list alg-zd-Z 'liz_)))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (alg-beta!
        (lambda ()
          (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
          (subst '(= (* 0 0) 0))
          (qrfl))))))
(define alg-zd-x0 (dk-apply! alg-zd-sc 0 alg-zd-Z))
(dk-have! (list '= alg-zd-li 0)
  (lambda ()
    (subst alg-zd-x0)
    (subst (alg-ring-id! '(algu_) '(= (* 0 algu_) 0) (list alg-zd-li)))
    (rfl)))
;; the fundamental theorem along the segment
(dk-fact! 'line-int-of-derivative alg-Ba 'algh_ alg-zd-Z alg-zd-pg alg-zd-dg 0 1)
(define (alg-zd-ccint! t)
  (dk-have! (list 'IN t '(CCINT 0 1))
    (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq!)))))))
(alg-zd-ccint! 1)
(alg-zd-ccint! 0)
(define alg-zd-p1 (list alg-zd-pg 1))
(define alg-zd-p0 (list alg-zd-pg 0))
(dk-have! (list '= alg-zd-p1 'algz_)
  (lambda () (subst (dk-fact! 'seg-path-apply 'alga_ 'algz_ 1)) (crs)))
(dk-have! (list '= alg-zd-p0 'alga_)
  (lambda () (subst (dk-fact! 'seg-path-apply 'alga_ 'algz_ 0)) (crs)))
(define alg-zd-h1 (list 'algh_ alg-zd-p1))
(define alg-zd-h0 (list 'algh_ alg-zd-p0))
(fact 'fun-apply-type-c 'algh_ alg-Ba 'CC 'algz_)
(fact 'fun-apply-type-c 'algh_ alg-Ba 'CC 'alga_)
(dk-have! (list '= '(algh_ algz_) alg-zd-h1) (lambda () (subst (list '= alg-zd-p1 'algz_)) (rfl)))
(dk-have! (list '= '(algh_ alga_) alg-zd-h0) (lambda () (subst (list '= alg-zd-p0 'alga_)) (rfl)))
(alg-cc-typ! '(- (algh_ algz_) (algh_ alga_)))
(dk-have! '(= (- (algh_ algz_) (algh_ alga_)) 0)
  (lambda ()
    (subst (list '= '(algh_ algz_) alg-zd-h1))
    (subst (list '= '(algh_ alga_) alg-zd-h0))
    (subst (list '= (list '- alg-zd-h1 alg-zd-h0) alg-zd-li))
    (subst (list '= alg-zd-li 0))
    (rfl)))
(subst (alg-ring-id! '(algu_ algv_) '(= algu_ (+ (- algu_ algv_) algv_)) (list '(algh_ algz_) '(algh_ alga_))))
(subst '(= (- (algh_ algz_) (algh_ alga_)) 0))
(subst (alg-ring-id! '(algu_) '(= (+ 0 algu_) algu_) (list '(algh_ alga_))))
(rfl)
(qed 'alg-zero-deriv-ball)

;;; ----------------------------------------------------------------------
;;; the series (39) about 1: log0(z) = sum c(k) (z - 1)^k on B(1, r), r < 1
;;; ----------------------------------------------------------------------
(define alg-B1 (alg-B 1))
(define (alg-G1 g) (list 'VNB-LAMBDA 'algz_ alg-B1 (list 'CC-SERIES-LIMIT (alg-psum g '(- algz_ 1)))))
(define (alg-S1 x) (list 'CC-SERIES-LIMIT (alg-psum 'algc_ (list '- x 1))))
(define (alg-shift-pt1! x)
  (if (not (dk-asm? (list 'IN (list '- x 1) alg-B0)))
      (dk-split-all! (list (dk-fact! 'alg-shift-in-ball 1 'algr_ x))))
  (alg-cc-typ! (list '- x 1)))
(define (alg-G1-typ! g)
  (alg-lam-typ! (alg-G1 g) alg-B1 'CC (lambda (x) (alg-shift-pt1! x) (alg-series-typ! g (list '- x 1)))))
(define (alg-log-r-hyps concl)          ; c the log coefficients, 0 < r < 1
  (alg-log-hyps (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR) (list 'IMPLIES '(< 0 algr_) (list 'IMPLIES '(< algr_ 1) concl))))))
(define (alg-log1-setup!)
  (dk-peel!)
  (alg-ms-setup!)
  (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
  (fact 'cc-nf-carr)
  (alg-r-facts!)
  (alg-chain! (dk-fact! 'cps-log-radius 'algc_ 'algr_))
  (alg-ball-open! 1)
  (alg-ball-open! 0)
  (alg-center-in! 1)
  (alg-center-in! 0))
;;; w in B(1, r), r < 1: w /= 0 and |w - 1| < 1
(define (alg-nz1! w)
  (let ((f (list 'NOT (list '= w 0))))
    (if (not (dk-asm? f))
        (begin
          (alg-ball-lt! w 1)
          (dk-have! f
            (lambda ()
              (di)
              (dk-have! (list '= (list 'magnitude (list '- w 1)) 1)
                (lambda () (subst (list '= w 0)) (alg-cc-typ! '(- 0 1)) (dk-have! '(= (- 0 1) -1) (lambda () (arith))) (subst '(= (- 0 1) -1)) (alg-guard! alg-mag-neg-one! ass)))
              (dk-absurd! (list '= (list 'magnitude (list '- w 1)) 1) (list '< (list 'magnitude (list '- w 1)) 'algr_) '(< algr_ 1))))))
    f))

;;; log0'(w) = 1/w on B(1, r)
(sp (make-wff (alg-log-r-hyps
  (list 'FORALL 'algw_ (list 'IMPLIES (list 'IN 'algw_ alg-B1)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-B1 (alg-G1 'algc_) 'algw_ '(recip algw_)))))))
(alg-log1-setup!)
(define alg-l1-d (alg-log-derived!))
(dk-apply! (alg-chain! (dk-fact! 'cps-translate-diff 'algc_ alg-l1-d 1 'algr_)) 'algw_)
(alg-ball-lt! 'algw_ 1)
(alg-rr-typ! '(magnitude (- algw_ 1)))
(dk-have! '(< (magnitude (- algw_ 1)) 1) (lambda () (dk-ineq! '(< (magnitude (- algw_ 1)) algr_) '(< algr_ 1))))
(alg-shift-pt1! 'algw_)
(dk-split-all! (list (alg-chain! (dk-fact! 'cc-geometric-alternating alg-l1-d '(- algw_ 1)))))
(alg-cc-typ! '(+ 1 (- algw_ 1)))
(dk-have! '(= (+ 1 (- algw_ 1)) algw_) (lambda () (crs)))
(dk-have! (list '= '(recip algw_) (list 'CC-SERIES-LIMIT (alg-psum alg-l1-d '(- algw_ 1))))
  (lambda ()
    (subst (list '= (list 'CC-SERIES-LIMIT (alg-psum alg-l1-d '(- algw_ 1))) '(recip (+ 1 (- algw_ 1)))))
    (subst '(= (+ 1 (- algw_ 1)) algw_))
    (alg-nz1! 'algw_)
    (alg-cc-typ! '(recip algw_))
    (rfl)))
(subst (list '= '(recip algw_) (list 'CC-SERIES-LIMIT (alg-psum alg-l1-d '(- algw_ 1)))))
(ass)
(qed 'cps-log-deriv-at-one)

;;; ----------------------------------------------------------------------
;;; exp(log0 z) = z on B(1, r), r < 1: the notes' "directly by
;;; differentiation": h(z) = z^-1 exp(log0 z) has derivative
;;; -z^-2 exp(log0 z) + z^-1 exp(log0 z) log0'(z) = 0, so h is constant on the
;;; ball (alg-zero-deriv-ball), and h(1) = exp(log0 1) = exp 0 = 1.
;;; ----------------------------------------------------------------------
(define alg-le-H (list 'VNB-LAMBDA 'algx_ alg-B1 (list '* '(recip algx_) (list 'CC-EXP (alg-S1 'algx_)))))
(define alg-le-E '(VNB-LAMBDA cexy_ CC (CC-EXP cexy_)))
(define alg-le-Id (list 'VNB-LAMBDA 'd2x_ alg-B1 'd2x_))
(define alg-le-Q (list 'VNB-LAMBDA 'algx_ alg-B1 '(recip algx_)))
(define alg-le-K 'CC-NORMED-FIELD)
(define (alg-le-pt! x)                   ; x in B(1, r): x /= 0, x - 1 in B(0, r), log0 x and exp(log0 x) typed
  (alg-nz1! x)
  (alg-shift-pt1! x)
  (alg-series-typ! 'algc_ (list '- x 1))
  (alg-exp-typ! (alg-S1 x))
  (alg-cc-typ! (list 'recip x)))
(define (alg-le-deriv! w)                ; goal (IS-DIFF-ON K B1 H w 0)
  (let* ((g1 (alg-G1 'algc_)) (g1w (list g1 w)))
    (alg-le-pt! w)
    (fact 'fun-apply-type-c g1 alg-B1 'CC w)
    (alg-exp-typ! g1w)
    (dk-apply! (alg-chain! (dk-fact! 'cps-log-deriv-at-one 'algc_ 'algr_)) w)
    (fact 'cc-exp-deriv g1w)
    (dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES (list 'IN 'd2y_ alg-B1) (list 'IN (list g1 'd2y_) 'CC)))
      (lambda () (let ((y (dk-di-var!))) (alg-guard! (lambda () (fact 'fun-apply-type-c g1 alg-B1 'CC y)) ass))))
    (let* ((r1 (alg-stage-apply! (dk-fact! 'diff-on-chain alg-le-K) (list alg-B1 'CC g1 alg-le-E)
                                 (list w (list 'recip w) (list 'CC-EXP g1w))))
           (p1 (list-ref r1 3)) (lp (list-ref r1 5))
           (idw (list alg-le-Id w)))
      (dk-apply! (dk-fact! 'diff-on-identity alg-le-K alg-B1) w)
      (fact 'fun-apply-type-c alg-le-Id alg-B1 'CC w)
      (dk-have! (list '= idw w) (lambda () (alg-beta! (lambda () (rfl)))))
      (dk-have! (list 'NOT (list '= idw 0)) (lambda () (subst (list '= idw w)) (ass)))
      (alg-and! (list 'IN idw 'CC) (list 'IN idw 'CC))
      (alg-chain! (dk-fact! 'cc-mul-nonzero idw idw))
      (dk-have! (list 'FORALL 'cry_ (list 'IMPLIES (list 'IN 'cry_ alg-B1) (list 'NOT (list '= (list alg-le-Id 'cry_) 0))))
        (lambda () (let ((y (dk-di-var!))) (alg-beta! (lambda () (alg-guard! (lambda () (alg-nz1! y)) ass))))))
      (dk-have! (list 'FORALL 'cry_ (list 'IMPLIES (list 'IN 'cry_ alg-B1) (list '== (list alg-le-Q 'cry_) (list 'recip (list alg-le-Id 'cry_)))))
        (lambda () (let ((y (dk-di-var!))) (alg-beta! (lambda () (qrfl))))))
      (let* ((r2 (alg-chain! (dk-fact! 'diff-on-recip-cc alg-B1 alg-le-Id w (list 'ONE alg-le-K) alg-le-Q)))
             (lq (list-ref r2 5)))
        (alg-cc-typ! lq)
        (let* ((r3 (alg-stage-apply! (dk-fact! 'diff-on-product alg-le-K) (list alg-B1 alg-le-Q p1) (list w lq lp)))
               (pr (list-ref r3 3)) (dd (list-ref r3 5)))
          (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ alg-B1) (list '== (list alg-le-H 'hbx_) (list pr 'hbx_))))
            (lambda () (let ((x (dk-di-var!))) (alg-le-pt! x) (alg-beta! (lambda () (alg-kops!) (qrfl))))))
          (dk-fact! 'diff-on-transfer-ptwise-eq alg-le-K alg-B1 alg-le-H pr w dd)
          (let ((u (list 'recip w)) (x (list 'CC-EXP (alg-S1 w))))
            (alg-and! (list 'IN w 'CC) (list 'IN w 'CC))
            (alg-chain! (dk-fact! 'cc-mul-nonzero w w))
            (alg-cc-typ! (list 'recip (list '* w w)))
            (dk-have! (list '= 0 dd)
              (lambda ()
                (alg-beta!
                  (lambda ()
                    (subst '(== (ONE CC-NORMED-FIELD) 1))
                    (alg-kops!)
                    (subst (alg-chain! (dk-fact! 'cc-recip-mul w w)))
                    (alg-ring-id! '(algu_ algv_) '(= 0 (+ (* (- (* 1 (* algu_ algu_))) algv_) (* (* algv_ algu_) algu_))) (list u x))
                    (ass)))))
            (subst (list '= 0 dd))
            (ass)))))))
(sp (make-wff (alg-log-r-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-B1) (list '= (list 'CC-EXP (alg-S1 'algz_)) 'algz_))))))
(alg-log1-setup!)
(fact 'cc-is-normed-field)
(dk-have! '(== (ONE CC-NORMED-FIELD) 1) (lambda () (slot 'ONE) (qrfl)))
(dk-have! '(IN (ONE CC-NORMED-FIELD) CC) (lambda () (subst '(== (ONE CC-NORMED-FIELD) 1)) (ass)))
(alg-G1-typ! 'algc_)
(alg-lam-typ! alg-le-H alg-B1 'CC (lambda (x) (alg-le-pt! x) (alg-cc-typ! (list '* (list 'recip x) (list 'CC-EXP (alg-S1 x))))))
(alg-lam-typ! alg-le-Id alg-B1 'CC (lambda (x) (alg-ball-cc! x 1)))
(alg-lam-typ! alg-le-Q alg-B1 'CC (lambda (x) (alg-le-pt! x)))
(dk-have! (list 'IN alg-le-H (list 'FUN alg-B1 '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ alg-B1) (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-B1 alg-le-H 'hbz_ 0)))
  (lambda () (let ((w (dk-di-var!))) (alg-le-deriv! w))))
(define alg-le-hz (dk-apply! (alg-chain! (dk-fact! 'alg-zero-deriv-ball 1 'algr_ alg-le-H)) 'algz_))
(alg-le-pt! 'algz_)
(define alg-le-u '(recip algz_))
(define alg-le-x (list 'CC-EXP (alg-S1 'algz_)))
(alg-cc-typ! (list '* alg-le-u alg-le-x))
(dk-have! (list '= (list alg-le-H 1) 1)
  (lambda ()
    (alg-beta!
      (lambda ()
        (alg-cc-typ! '(- 1 1))
        (dk-have! '(= (- 1 1) 0) (lambda () (arith)))
        (subst '(= (- 1 1) 0))
        (dk-split-all! (list (dk-fact! 'cps-sum-at-zero 'algc_)))
        (subst (list '= (list 'CC-SERIES-LIMIT (alg-psum 'algc_ 0)) '(algc_ 0)))
        (subst alg-lv0)
        (subst (dk-fact! 'cc-exp-zero))
        (dk-have! '(= (recip 1) 1) (lambda () (arith)))
        (subst '(= (recip 1) 1))
        (crs)))))
(dk-have! (list '= (list '* alg-le-u alg-le-x) 1)
  (lambda ()
    (dk-have! (list '= (list alg-le-H 'algz_) (list '* alg-le-u alg-le-x)) (lambda () (alg-beta! (lambda () (rfl)))))
    (subst (list '= (list '* alg-le-u alg-le-x) (list alg-le-H 'algz_)))
    (subst alg-le-hz)
    (subst (list '= (list alg-le-H 1) 1))
    (rfl)))
(alg-chain! (dk-fact! 'cc-recip-inverse 'algz_))
(dk-have! (list '= alg-le-x (list '* (list '* 'algz_ alg-le-u) alg-le-x))
  (lambda ()
    (subst (list '= (list '* 'algz_ alg-le-u) 1))
    (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list alg-le-x)))
    (rfl)))
(subst (list '= alg-le-x (list '* (list '* 'algz_ alg-le-u) alg-le-x)))
(subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* (* algu_ algv_) algw_) (* algu_ (* algv_ algw_))) (list 'algz_ alg-le-u alg-le-x)))
(subst (list '= (list '* alg-le-u alg-le-x) 1))
(subst (alg-ring-id! '(algu_) '(= (* algu_ 1) algu_) (list 'algz_)))
(rfl)
(qed 'log0-exp)

;;; ----------------------------------------------------------------------
;;; |log0 z| <= t/(1 - t) = 1/(1 - t) - 1,  t = |z - 1| < r < 1:
;;; |partial sums| <= sum_{1<=k<n} t^k (c(0) = 0, |c(k)| <= 1), and
;;; cc-limit-magnitude-le passes the bound to the sum.
;;; ----------------------------------------------------------------------
(define alg-lb-w '(- algz_ 1))
(define alg-lb-t (list 'magnitude alg-lb-w))
(define alg-lb-s (list '- 1 alg-lb-t))
(define alg-lb-R (list 'recip alg-lb-s))
(define alg-lb-bd (list '- alg-lb-R 1))
(define alg-lb-f (alg-psum 'algc_ alg-lb-w))
(define alg-lb-g (list 'VNB-LAMBDA 'algj_ 'NN (list 'magnitude (list '* '(algc_ algj_) (list 'power alg-lb-w 'algj_)))))
(define alg-lb-geo (list 'VNB-LAMBDA 'n 'NN (list 'power alg-lb-t 'n)))
(define (alg-sps f k) (list 'SERIES-PARTIAL-SUM f k))
(sp (make-wff (alg-log-r-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-B1)
    (list '<= (list 'magnitude (alg-S1 'algz_)) alg-lb-bd))))))
(alg-log1-setup!)
(alg-ball-lt! 'algz_ 1)
(alg-shift-pt1! 'algz_)
(alg-rr-typ! alg-lb-t)
(fact 'cc-magnitude-nonneg alg-lb-w)
(dk-have! (list '< alg-lb-t 1) (lambda () (dk-ineq! (list '< alg-lb-t 'algr_) '(< algr_ 1))))
(alg-rr-typ! alg-lb-s)
(dk-have! (list '< 0 alg-lb-s) (lambda () (dk-ineq! (list '< alg-lb-t 1))))
(dk-have! (list 'NOT (list '= alg-lb-s 0)) (lambda () (di) (dk-absurd! (list '= alg-lb-s 0) (list '< 0 alg-lb-s))))
(dk-have! (list 'NOT (list '= alg-lb-t 1)) (lambda () (di) (dk-absurd! (list '= alg-lb-t 1) (list '< alg-lb-t 1))))
(alg-rr-typ! alg-lb-R)
(fact 'rr-recip-pos alg-lb-s)
(alg-rr-typ! alg-lb-bd)
(define alg-lb-inv (alg-chain! (dk-fact! 'rr-recip-inverse alg-lb-s)))
;; R >= 1
(dk-have! (list '<= alg-lb-s 1) (lambda () (dk-ineq! (list '<= 0 alg-lb-t))))
(dk-have! (list '<= 0 alg-lb-R) (lambda () (dk-ineq! (list '< 0 alg-lb-R))))
(alg-chain! (dk-fact! 'rr-le-scale-nonneg alg-lb-R alg-lb-s 1))
(alg-rr-typ! (list '* alg-lb-R alg-lb-s))
(alg-rr-typ! (list '* alg-lb-R 1))
(dk-have! (list '= (list '* alg-lb-R alg-lb-s) 1)
  (lambda () (subst (alg-ring-id! '(algu_ algv_) '(= (* algu_ algv_) (* algv_ algu_)) (list alg-lb-R alg-lb-s))) (subst alg-lb-inv) (rfl)))
(dk-have! (list '= (list '* alg-lb-R 1) alg-lb-R)
  (lambda () (subst (alg-ring-id! '(algu_) '(= (* algu_ 1) algu_) (list alg-lb-R))) (rfl)))
(dk-have! (list '<= 0 alg-lb-bd)
  (lambda () (dk-ineq! (list '<= (list '* alg-lb-R alg-lb-s) (list '* alg-lb-R 1))
                       (list '= (list '* alg-lb-R alg-lb-s) 1) (list '= (list '* alg-lb-R 1) alg-lb-R))))
;; the sequences
(alg-lam-typ! alg-lb-f 'NN 'CC (lambda (k) (alg-cc-typ! (list '* (list 'algc_ k) (list 'power alg-lb-w k)))))
(alg-lam-typ! alg-lb-g 'NN 'RR (lambda (k) (alg-rr-typ! (list 'magnitude (list '* (list 'algc_ k) (list 'power alg-lb-w k))))))
(alg-lam-typ! alg-lb-geo 'NN 'RR (lambda (k) (alg-rr-typ! (list 'power alg-lb-t k))))
(dk-have! (list 'FORALL 'algj_ (list 'IMPLIES '(IN algj_ NN) (list '= (list alg-lb-g 'algj_) (list 'magnitude (list alg-lb-f 'algj_)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (alg-rr-typ! (list 'magnitude (list '* (list 'algc_ j) (list 'power alg-lb-w j))))
      (alg-beta! (lambda () (rfl))))))
(define (alg-lb-sps-typ! f k) (alg-nn-typ! k) (fact 'series-partial-sum-in-rr k f))
(define (alg-lb-succ! f k)             ; rewrite SPS(f, succ k) = SPS(f, k) + f(k) in the goal
  (alg-lb-sps-typ! f k)
  (alg-nn-typ! k)
  (fact 'fun-apply-type-c f 'NN 'RR k)
  (subst (alg-chain! (dk-fact! 'series-partial-sum-succ f k))))
(define alg-lb-claim
  (list 'FORALL 'algm_ (list 'IMPLIES '(IN algm_ NN)
    (list '<= (list '+ (alg-sps alg-lb-g '(succ algm_)) 1) (alg-sps alg-lb-geo '(succ algm_))))))
(dk-have! alg-lb-claim
  (lambda ()
    (let* ((br (use-induction))
           (m (cdr (assq 'var br)))
           (ih (cdr (assq 'ih br)))
           (step (cdr (assq 'step br))))
      (dk-focus! (cdr (assq 'base br)))
      (alg-lb-succ! alg-lb-g 0)
      (alg-lb-succ! alg-lb-geo 0)
      (subst (dk-fact! 'series-partial-sum-zero alg-lb-g))
      (subst (dk-fact! 'series-partial-sum-zero alg-lb-geo))
      (fact 'rr-subset-cc alg-lb-t)
      (alg-cc-typ! (list 'power alg-lb-w 0))
      (dk-have! (list '= (list alg-lb-g 0) 0)
        (lambda ()
          (alg-beta!
            (lambda ()
              (subst alg-lv0)
              (subst (alg-ring-id! '(algu_) '(= (* 0 algu_) 0) (list (list 'power alg-lb-w 0))))
              (subst (dk-fact! 'cc-magnitude-zero))
              (rfl)))))
      (dk-have! (list '= (list alg-lb-geo 0) 1)
        (lambda () (alg-beta! (lambda () (subst (dk-fact! 'power-zero alg-lb-t)) (rfl)))))
      (subst (list '= (list alg-lb-g 0) 0))
      (subst (list '= (list alg-lb-geo 0) 1))
      (dk-ineq!)
      (dk-focus! step)
      (let* ((sm (list 'succ m))
             (cm (list 'algc_ sm)) (mm (list 'magnitude cm))
             (pw (list 'power alg-lb-w sm)) (pt (list 'power alg-lb-t sm)))
        (alg-nn-typ! sm)
