        (dk-have! (list '= (list '* 1 pt) pt) (lambda () (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list pt))) (rfl)))
        (dk-have! (list '<= (list alg-lb-g sm) (list alg-lb-geo sm))
          (lambda ()
            (alg-beta!
              (lambda ()
                (alg-and! (list 'IN cm 'CC) (list 'IN pw 'CC))
                (subst (dk-fact! 'cc-magnitude-mul cm pw))
                (subst (dk-fact! 'cc-magnitude-power sm alg-lb-w))
                (dk-ineq! (list '<= (list '* mm pt) (list '* 1 pt)) (list '= (list '* 1 pt) pt))))))
        (dk-ineq! ih (list '<= (list alg-lb-g sm) (list alg-lb-geo sm)))))))
;; every partial sum is bounded by 1/(1-t) - 1
(define alg-lb-pbound
  (list 'FORALL 'algn_ (list 'IMPLIES '(IN algn_ NN)
    (list '<= (list 'magnitude (list 'CC-SERIES-PARTIAL-SUM alg-lb-f 'algn_)) alg-lb-bd))))
(dk-have! alg-lb-pbound
  (lambda ()
    (let ((n (dk-di-var!)))
      (fact 'cc-series-partial-sum-in-cc n alg-lb-f)
      (use-em (list '= n 0)
        (lambda ()
          (subst (list '= n 0))
          (subst (dk-fact! 'cc-series-partial-sum-zero alg-lb-f))
          (subst (dk-fact! 'cc-magnitude-zero))
          (ass))
        (lambda ()
          (let* ((q (dk-skolem! (alg-chain! (dk-fact! 'nn-nonzero-is-succ n))))
                 (sq (list 'succ q))
                 (pt (list 'power alg-lb-t sq))
                 (sg (alg-sps alg-lb-g sq)) (sgeo (alg-sps alg-lb-geo sq))
                 (pp (list 'CC-SERIES-PARTIAL-SUM alg-lb-f sq)))
            (subst (list '= n sq))
            (alg-nn-typ! sq)
            (fact 'cc-series-partial-sum-in-cc sq alg-lb-f)
            (alg-rr-typ! (list 'magnitude pp))
            (alg-lb-sps-typ! alg-lb-g sq) (alg-lb-sps-typ! alg-lb-geo sq)
            (alg-chain! (dk-fact! 'cc-series-partial-sum-magnitude-le sq alg-lb-f alg-lb-g))
            (dk-apply! (dk-ctx-form alg-lb-claim) q)
            (alg-rr-typ! pt)
            (alg-chain! (dk-fact! 'rr-power-nonneg sq alg-lb-t))
            (alg-chain! (dk-fact! 'rr-mul-le-right 0 pt alg-lb-R))
            (alg-rr-typ! (list '* pt alg-lb-R)) (alg-rr-typ! (list '* 0 alg-lb-R))
            (dk-have! (list '= (list '* 0 alg-lb-R) 0) (lambda () (subst (alg-ring-id! '(algu_) '(= (* 0 algu_) 0) (list alg-lb-R))) (rfl)))
            (alg-and! (list 'IN alg-lb-t 'RR) (list 'NOT (list '= alg-lb-t 1)))
            (dk-have! (list '= sgeo (list '- alg-lb-R (list '* pt alg-lb-R)))
              (lambda ()
                (subst (dk-apply! (alg-chain! (dk-fact! 'geometric-partial-sum alg-lb-t)) sq))
                (subst (alg-ring-id! '(algu_ algv_) '(= (* (- 1 algu_) algv_) (- algv_ (* algu_ algv_))) (list pt alg-lb-R)))
                (rfl)))
            (dk-ineq! (list '<= (list 'magnitude pp) sg)
                      (list '<= (list '+ sg 1) sgeo)
                      (list '= sgeo (list '- alg-lb-R (list '* pt alg-lb-R)))
                      (list '<= (list '* 0 alg-lb-R) (list '* pt alg-lb-R))
                      (list '= (list '* 0 alg-lb-R) 0))))))))
