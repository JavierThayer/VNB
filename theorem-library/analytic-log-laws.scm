(sp (make-wff (list 'FORALL 'alga_ (list 'IMPLIES '(IN alga_ CC) (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR) (list 'IMPLIES '(< 0 algr_)
  (list 'FORALL 'algh_ (list 'IMPLIES (list 'IN 'algh_ (list 'FUN alg-Ba 'CC)) (list 'IMPLIES alg-zd-hyp
    (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-Ba) '(= (algh_ algz_) (algh_ alga_))))))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'cc-nf-carr)
(fact 'cc-nf-zero)
(fact 'rr-zero-in) (fact 'rr-one-in)
(alg-ball-open! 'alga_)
(alg-center-in! 'alga_)
(alg-ball-cc! 'algz_ 'alga_)
(alg-lam-typ! alg-zd-Z alg-Ba 'CC (lambda (x) (fact 'cc-zero-in)))
(define alg-zd-dh (dk-ctx-form alg-zd-hyp))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ alg-Ba) (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-Ba 'algh_ 'hbz_ (list alg-zd-Z 'hbz_))))
  (lambda () (let ((x (dk-di-var!))) (alg-beta! (lambda () (dk-apply! alg-zd-dh x) (ass))))))
