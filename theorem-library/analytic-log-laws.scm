;;; analytic-log-laws.scm -- ANALYTICITY AT A CENTRE (Def 2.11, Cor 2.14 at a),
;;; THE PRINCIPAL LOGARITHM, LEMMA 2.20 AND PROPOSITION 2.21.
;;; Batch 38, 2026-09-27.  Definitions: structure-library/analytic-log.scm
;;; (IS-ANALYTIC-AT, CC-LOG).  The source: scratchpad/triage/ca.txt 1142-1150
;;; (Def 2.11), 1480-1580 (the principal log, Lemma 2.20, Prop 2.21, (40), the
;;; holomorphy of log, Remark 2.22).
;;;
;;; (1) THE TRANSLATION.  The tree's power-series layer is centred at 0 (2.10,
;;; 2.14 on ball(cc-ms, 0, r)).  G_g(z) = sum g(k) (z - a)^k on B(a, r) is F_g
;;; composed with z |-> z - a:
;;;   alg-shift-in-ball          z in B(a, r)  ==>  z - a in B(0, r)
;;;   alg-shift-diff             z |-> z - a has derivative 1 on B(a, r)
;;;   cps-translate-diff         G_cf'(w) = sum dcf(k) (w - a)^k on B(a, r)
;;;   cps-translate-holomorphic  G_cf is holomorphic on B(a, r)
;;;   cps-translate-nth-deriv    NTH-DERIV-ON(CC-NF, B(a,r), G_cf, k) = G_g, V(g, k)
;;;   taylor-coefficients-at     THE NOTES' 2.14 AT a: f = sum cf(k)(z - a)^k on
;;;                              B(a, r) inside U  ==>  f^(k)(a) = k! cf(k),
;;;                              f^(k) the k-th derivative of f|B(a, r)
;;;   analytic-rep-holomorphic   ... f|B(a, r) is holomorphic
;;;   analytic-deriv             ... f'(a) = cf(1), on U
;;;   analytic-at-intro          the data, with U open, is IS-ANALYTIC-AT(f, U, a)
;;;   analytic-holomorphic-ball  IS-ANALYTIC-AT(f, U, a)  ==>  f is holomorphic
;;;                              on a ball B(a, r) inside U
;;; (2) THE PRINCIPAL LOGARITHM.  Existence is cc-exp-open-strip-onto (batch 34:
;;; its statement IS the satisfiability of the description, so it is cited, not
;;; restated).
;;;   cc-log-unique, cc-log-spec (iota-d), cc-log-in-slit, cc-exp-log,
;;;   cc-log-char (the z of the strip with exp z = w IS log w), cc-log-exp,
;;;   cc-log-real (= the real log on (0, inf)), cc-log-one, cc-log-polar (40),
;;;   cc-log-scale (log(s w) = ln s + log w, s > 0)
;;; (3) LEMMA 2.20, the coefficients c(0) = 0, c(j+1) = (-1)^j/(j+1) given by
;;; their values:
;;;   cc-geometric-alternating   sum (-1)^k z^k -> 1/(1 + z), |z| < 1
;;;   cps-log-radius             0 <= r < 1  ==>  r < R(c)   (radius >= 1)
;;;   cps-log-series             on B(0, r), 0 < r < 1: f'(z) = 1/(1 + z)
;;; (4) PROP 2.21 by the notes' differentiation argument:
;;;   alg-zero-deriv-ball        derivative 0 on a ball  ==>  constant there
;;;   cps-log-deriv-at-one       log0'(w) = 1/w on B(1, r), r < 1
;;;   log0-exp                   exp(log0 z) = z on B(1, r), r < 1
;;;   log0-bound                 |log0 z| <= 1/(1 - |z - 1|) - 1
;;;   log0-is-log-on-ball        log z = log0 z on B(1, r) for r (1 + pi) <= pi
;;;   log0-real, log0-is-ln      THE NOTES' 2.21: log0 t = ln t for 0 < t < 2
;;;                              (on the real axis Im log0 = 0, so the strip
;;;                              condition is free and the whole of (0, 2) is reached)
;;;   cc-log-holomorphic-near-one  log is holomorphic on that ball
;;;   cc-log-one-plus            Remark 2.22: log(1 + z) = sum (-1)^(k+1) z^k/k, |z| < r
;;; (5) the part proven: holomorphic-compose (absent from the tree) and
;;;   cc-log-holomorphic-scale   log is holomorphic on B(s, s r), every s > 0
;;;
;;; NOTHING asserted: no support, stamp or axiom; the two definitions are in the
;;; structure-library file.  Helper prefix alg-; theorem binders alg..._ / clg..._
;;; (and the binders of cited theorems where an instance must match).
;;; LOAD WINDOW: lo = theorem-library/cc-exp-surjective (cc-exp-open-strip-onto,
;;; cc-exp-open-strip-avoids-negatives, cc-exp-real-is-r-exp); also cc-exp-kernel
;;; (cc-exp-injective-strip, pi-pos), nth-deriv-laws / cps-taylor-coefficients,
;;; cc-exp (cc-diff-on-local, cc-exp-deriv), line-int-fundamental, goursat-era
;;; segment roads.  hi: none.  Oracles: crs, ineq, arith (sos via citations).
(define (alg-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (alg-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (alg-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((eqv? t 1) (fact 'nn-one-in) typ)
          ((and (exact-nonnegative-integer? t)) (dk-have! typ (lambda () (arith))) typ)
          ((alg-op? t 'succ 2) (alg-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          ((or (alg-op? t '+ 3) (alg-op? t '* 3))
           (alg-nn-typ! (cadr t)) (alg-nn-typ! (caddr t))
           (alg-and! (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN))
           (fact (if (eq? (car t) '+) 'nn-add-closed 'nn-mul-closed) (cadr t) (caddr t)) typ)
          (#t (error "alg-nn-typ!: cannot type" (expression->string t))))))
(define (alg-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((and (number? t) (exact-rational? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (pair? t) (alg-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((alg-op? t 'FACTORIAL 2)
           (alg-nn-typ! (cadr t))
           (dk-split-all! (list (dk-fact! 'factorial-real-pos (cadr t)))) typ)
          ((or (alg-op? t 'succ 2) (and (alg-op? t '+ 3) (dk-asm? (list 'IN (cadr t) 'NN))
                                         (dk-asm? (list 'IN (caddr t) 'NN))))
           (alg-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((and (alg-op? t 'recip 2) (alg-op? (cadr t) 'FACTORIAL 2))
           (alg-nn-typ! (cadr (cadr t))) (fact 'recip-factorial-in-rr (cadr (cadr t))) typ)
          ((alg-op? t 'recip 2)
           (alg-rr-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "alg-rr-typ!: recip of a term not known nonzero" (expression->string t)))
           (alg-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t)) typ)
          ((alg-op? t '* 3) (alg-rr-typ! (cadr t)) (alg-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((alg-op? t '+ 3) (alg-rr-typ! (cadr t)) (alg-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((alg-op? t '- 3) (alg-rr-typ! (cadr t)) (alg-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((alg-op? t '- 2) (alg-rr-typ! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((alg-op? t 'real-part 2) (alg-cc-typ! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((alg-op? t 'imag-part 2) (alg-cc-typ! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((alg-op? t 'power 3) (alg-rr-typ! (cadr t)) (alg-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((alg-op? t 'magnitude 2) (alg-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((alg-op? t 'abs 2) (alg-rr-typ! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((alg-op? t 'LOG 2) (alg-rr-typ! (cadr t)) (fact 'log-in-rr (cadr t)) typ)
          ((alg-op? t 'R-EXP 2) (alg-rr-typ! (cadr t)) (fact 'r-exp-in-rr (cadr t)) typ)
          ((alg-op? t 'RECIP-STAR 2) (alg-rr-typ! (cadr t)) (fact 'recip-star-in-rr (cadr t)) typ)
          ((alg-op? t 'CC-EXP 2) (alg-exp-rr! (cadr t)) typ)
          ((or (alg-op? t 'CC-COS 2) (alg-op? t 'CC-SIN 2))
           (alg-rr-typ! (cadr t)) (dk-split-all! (list (dk-cite! 'cc-cos-sin-real (cadr t)))) typ)
          ((eq? t 'PI) (alg-pi-typ!) typ)
          (#t (error "alg-rr-typ!: cannot type" (expression->string t))))))
(define (alg-real? t)
  (or (and (number? t) (exact-rational? t))
      (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
      (alg-op? t 'succ 2) (alg-op? t 'FACTORIAL 2) (alg-op? t 'magnitude 2) (alg-op? t 'abs 2) (alg-op? t 'real-part 2) (alg-op? t 'imag-part 2)
      (and (alg-op? t 'recip 2) (alg-op? (cadr t) 'FACTORIAL 2))
      (and (memq (dk-head t) '(* + -)) (= (length t) 3) (alg-real? (cadr t)) (alg-real? (caddr t)))
      (and (alg-op? t 'power 3) (alg-real? (cadr t)))))
;;; a ground numeric term (numbers under + - * recip): typed by arith
(define (alg-ground? t)
  (or (number? t)
      (and (pair? t) (memq (car t) '(+ - * recip)) (every alg-ground? (cdr t)))))
;;; D when (IN F (FUN D CC)) is in context
(define (alg-fun-dom f)
  (let ((hit (find-first (lambda (a) (and (alg-op? a 'IN 3) (equal? (cadr a) f)
                                          (alg-op? (caddr a) 'FUN 3) (eq? (caddr (caddr a)) 'CC)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
(define (alg-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((and (pair? t) (alg-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (number? t) (exact-rational? t)) (alg-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((alg-real? t) (alg-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
           (alg-nn-typ! (cadr t)) (fact 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) typ)
          ((and (pair? t) (= (length t) 2) (alg-fun-dom (car t)))
           (let ((dom (alg-fun-dom (car t))))
             (if (eq? dom 'NN) (alg-nn-typ! (cadr t)))
             (if (eq? dom 'CC) (alg-cc-typ! (cadr t)))
             (fact 'fun-apply-type-c (car t) dom 'CC (cadr t)) typ))
          ((alg-op? t 'CC-EXP 2) (alg-exp-typ! (cadr t)) typ)
          ((alg-op? t 'CC-COS 2) (alg-cos-typ! (cadr t)) typ)
          ((alg-op? t 'CC-SIN 2) (alg-sin-typ! (cadr t)) typ)
          ((and (alg-op? t 'CC-SERIES-PARTIAL-SUM 3) (dk-asm? (list 'IN (cadr t) '(FUN NN CC))))
           (alg-nn-typ! (caddr t)) (fact 'cc-series-partial-sum-in-cc (caddr t) (cadr t)) typ)
          ((and (alg-op? t 'CC-SERIES-LIMIT 2) (dk-asm? (list 'CC-SERIES-CONVERGES (cadr t))))
           (fact 'cc-series-limit-in-cc (cadr t)) typ)
          ((alg-op? t '* 3) (alg-cc-typ! (cadr t)) (alg-cc-typ! (caddr t))
           (alg-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((alg-op? t '+ 3) (alg-cc-typ! (cadr t)) (alg-cc-typ! (caddr t))
           (alg-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((alg-op? t '- 3) (alg-cc-typ! (cadr t)) (alg-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((alg-op? t '- 2) (alg-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((alg-op? t 'conjugate 2) (alg-cc-typ! (cadr t)) (fact 'cc-conjugate-closed (cadr t)) typ)
          ((alg-op? t 'power 3) (alg-cc-typ! (cadr t)) (alg-nn-typ! (caddr t))
           (alg-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((alg-op? t 'recip 2)
           (alg-cc-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "alg-cc-typ!: recip of a term not known nonzero" (expression->string t)))
           (alg-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "alg-cc-typ!: cannot type" (expression->string t))))))

;;; (IN LAM (FUN NN COD)) for LAM = (VNB-LAMBDA v NN body): TYPER gets the
;;; eigenvariable and must land the body's typing.
;;; (IN LAM (FUN DOM COD)) for LAM = (VNB-LAMBDA v DOM body): TYPER gets the
;;; eigenvariable and must land the body's typing (dk-lam-type!, not dk-lam-t!).
(define (alg-lam-typ! lam dom cod typer)
  (let ((typ (list 'IN lam (list 'FUN dom cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (typer j)
                  (if (not (sequent-node-grounded? leaf)) (ass))))))))
    typ))

;;; beta-reduce the focus goal; the reduct is a NEW node that becomes the focus
;;; while the worked leaf stays open, unless beta grounded it: run CLOSER then.
(define (alg-beta! closer)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (closer))))

;;; A commutative-ring identity with opaque atoms: prove BODY over fresh complex
;;; variables VARS by crs on a lane, then instantiate it at TERMS (typed in CC
;;; first); returns the landed instance.
(define (alg-ring-id! vars body terms)
  (let ((gen (let build ((vs vars))
               (if (null? vs) body
                   (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) (build (cdr vs))))))))
    (if (not (dk-asm? gen)) (dk-have! gen (lambda () (dk-peel!) (crs))))
    (for-each alg-cc-typ! terms)
    (apply dk-apply! (dk-ctx-form gen) terms)))

;;; detach an implication chain: an antecedent in context by detach!, one not in
;;; context (a conjunction of context facts) by detach-with!
(define (alg-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

;;; POS-RR c from (IN c RR) and (< 0 c) in context
(define (alg-pos-rr! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (dk-have! (list 'POS-RR c)
        (lambda ()
          (mac-h '< (dk-ctx-form (list '< 0 c)))
          (dk-split-all!)
          (mac 'pos-rr)
          (dk-conj-close! (lambda () (ass)))))))

;;; close the focus goal from a contradiction (< 0 0) proved by dk-ineq! from PREMS
(define (alg-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

(define (alg-ind! base-k step-k)
  (let* ((br (use-induction))
         (v (cdr (assq 'var br)))
         (ih (cdr (assq 'ih br)))
         (step (cdr (assq 'step br))))
    (dk-focus! (cdr (assq 'base br)))
    (base-k)
    (dk-focus! step)
    (step-k v ih)))
(define (alg-pw! z k)                    ; z^(succ k) = z z^k, rewritten in the goal
  (alg-cc-typ! z) (alg-nn-typ! k)
  (alg-and! (list 'IN z 'CC) (list 'IN k 'NN))
  (subst (dk-fact! 'power-succ z k)))

(define (alg-exp-typ! z)
  (alg-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC)))
      (dk-split-all! (list (dk-fact! 'cc-exp-converges z)))))

(define (alg-cos-typ! z)
  (alg-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-COS z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-cos-converges z)))))
(define (alg-sin-typ! z)
  (alg-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-SIN z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-sin-converges z)))))
(define (alg-conj-typ! z) (alg-cc-typ! (list 'conjugate z)))
(define (alg-pow2! x)                    ; (= (power x 2) (* x x)) in context
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (alg-cc-typ! x)
            (fact 'nn-two-is-succ-succ-zero)
            (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in)
            (alg-nn-typ! '(succ 0))
            (alg-pw! x '(succ 0))
            (alg-pw! x 0)
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (alg-land-var landed dom)
  (let ((hit (find-first (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) dom))) landed)))
    (if hit (cadr hit) (error "alg-land-var: no typing landed in" dom))))
(define (alg-exp-rr! t)                 ; (IN (CC-EXP t) RR) and (IN (CC-EXP t) CC), t typed in RR
  (alg-rr-typ! t) (fact 'rr-subset-cc t)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP t) 'RR))) (fact 'cc-exp-real-valued t))
  (alg-exp-typ! t))
(define (alg-leq-total! a b)
  (alg-rr-typ! a) (alg-rr-typ! b)
  (alg-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (dk-fact! 'rr-leq-total a b))
(define (alg-pi-typ!)
  (if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
  (fact 'rr-subset-cc 'PI))
(define (alg-im-eq! x y)
  (let ((e (list '= (list 'imag-part x) y)) (yi (list '* y +i)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (alg-rr-typ! y) (fact 'rr-subset-cc y) (alg-cc-typ! x) (alg-cc-typ! yi)
            (if (not (equal? x yi))
                (begin
                  (dk-have! (list '= x yi) (lambda () (crs)))
                  (subst (list '= x yi))))
            (subst (dk-fact! 'cc-im-real-mul y +i))
            (dk-have! (list '= (list 'imag-part +i) 1) (lambda () (arith)))
            (subst (list '= (list 'imag-part +i) 1))
            (crs))))
    e))

;;; (= (imag-part X) 0) for a real X (cc-re-im-of: X = X + 0 i)
(define (alg-im-real! x)
  (let ((e (list '= (list 'imag-part x) 0)))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (alg-rr-typ! x) (fact 'rr-subset-cc x) (fact 'rr-zero-in)
            (alg-cc-typ! (list '+ x (list '* 0 +i)))
            (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
            (dk-split-all! (list (alg-chain! (dk-fact! 'cc-re-im-of x x 0))))
            (ass))))
    e))
;;; the slit-plane condition and the open strip, as cc-exp-open-strip-onto spells them
(define (alg-slit w) (list 'NOT (list 'AND (list '= (list 'imag-part w) 0) (list '<= (list 'real-part w) 0))))
(define (alg-lo z) (list '< '(- PI) (list 'imag-part z)))
(define (alg-hi z) (list '< (list 'imag-part z) 'PI))

;;; run THUNK on the focus leaf; run CLOSER only if that leaf is still open
;;; (a dk-have! of a claim equal to the focus goal proves it in place)
(define (alg-guard! thunk closer)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (closer))))
(define (alg-kop-find e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 3) (member (car e) '((ADD CC-NORMED-FIELD) (MUL CC-NORMED-FIELD)))
              (not (alg-kop-find (cadr e))) (not (alg-kop-find (caddr e))))
         e)
        ((and (= (length e) 2) (equal? (car e) '(NEG CC-NORMED-FIELD)) (not (alg-kop-find (cadr e))))
         e)
        (#t (let loop ((xs e)) (cond ((null? xs) #f) ((alg-kop-find (car xs))) (#t (loop (cdr xs))))))))
(define (alg-kops!)
  (let loop ()
    (let ((k (alg-kop-find (dk-goal))))
      (if k
          (begin
            (cond ((equal? (car k) '(NEG CC-NORMED-FIELD))
                   (alg-cc-typ! (cadr k))
                   (fact 'cc-nf-neg-apply (cadr k))
                   (subst (list '== k (list '- (cadr k)))))
                  (#t
                   (alg-cc-typ! (cadr k)) (alg-cc-typ! (caddr k))
                   (let ((add? (equal? (car k) '(ADD CC-NORMED-FIELD))))
                     (fact (if add? 'cc-nf-add-apply 'cc-nf-mul-apply) (cadr k) (caddr k))
                     (subst (list '== k (list (if add? '+ '*) (cadr k) (caddr k)))))))
            (loop))))))

;;; ======================================================================
;;; (1) THE TRANSLATION TO A CENTRE.  The tree's power-series machinery (2.10,
;;; 2.14: cps-holomorphic-ball, cps-diff-on-ball, cps-taylor-coefficients,
;;; taylor-coefficients) is CENTRED AT 0: F_g on B(0, r).  Here the series
;;; centred at a, G_g(z) = sum g(k) (z - a)^k on B(a, r), is F_g composed with
;;; the shift z |-> z - a (diff-on-chain, the shift's derivative being 1), and
;;; the k-th derivatives follow by induction as in cps-nth-deriv.
;;; ======================================================================
(define alg-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (alg-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (alg-psum g z) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list g 'cpsk_) (list 'power z 'cpsk_))))
(define (alg-B c) (list 'BALL 'CC-MS c 'algr_))
(define alg-Ba (alg-B 'alga_))
(define alg-B0 (alg-B 0))
(define (alg-F g) (list 'VNB-LAMBDA 'cpdz_ alg-B0 (list 'CC-SERIES-LIMIT (alg-psum g 'cpdz_))))
(define (alg-G g) (list 'VNB-LAMBDA 'algz_ alg-Ba (list 'CC-SERIES-LIMIT (alg-psum g '(- algz_ alga_)))))
(define alg-S (list 'VNB-LAMBDA 'algx_ alg-Ba '(- algx_ alga_)))
(define (alg-dcf-h g d)
  (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list d 'cpdj_) (list '* '(succ cpdj_) (list g '(succ cpdj_)))))))

;;; (<= 0 r), (NOT (= 0 r)) from (IN r RR), (< 0 r)
(define (alg-r-facts!)
  (if (not (dk-asm? '(<= 0 algr_))) (dk-have! '(<= 0 algr_) (lambda () (dk-ineq! '(< 0 algr_)))))
  (if (not (dk-asm? '(NOT (= 0 algr_))))
      (dk-have! '(NOT (= 0 algr_)) (lambda () (di) (dk-absurd! '(= 0 algr_) '(< 0 algr_))))))
(define (alg-ms-setup!)
  (fact 'cc-is-metric-space)
  (fact 'cc-is-normed-field)
  (fact 'cc-zero-in)
  (alg-pts-cc!))
;;; C in CC in context: (IN C (PTS CC-MS))
(define (alg-pts! c)
  (let ((f (list 'IN c '(PTS CC-MS))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
    f))
;;; B(C, r) open, in CC-MS and in the metric of the normed field
(define (alg-ball-open! c)
  (let ((b (alg-B c)))
    (alg-pts! c)
    (alg-r-facts!)
    (if (not (dk-asm? (list 'IN b 'SET))) (fact 'ball-is-set 'CC-MS c 'algr_))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS b)))
        (alg-chain! (dk-fact! 'ball-is-open 'CC-MS c 'algr_)))
    (if (not (dk-asm? (list 'IS-OPEN alg-nfm b)))
        (dk-have! (list 'IS-OPEN alg-nfm b) (lambda () (mac 'cc-ms-open-iff) (ass))))))
;;; C in B(C, r)
(define (alg-center-in! c)
  (if (not (dk-asm? (list 'IN c (alg-B c))))
      (begin (alg-pts! c) (alg-r-facts!) (alg-chain! (dk-fact! 'ball-center-in 'CC-MS c 'algr_)))))
;;; X in CC off (IN X (BALL CC-MS C R)) in context
(define (alg-ball-cc! x c)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (begin
        (fact 'ball-membership 'CC-MS c 'algr_ x)
        (let ((iff (iff-for (list 'IN x (alg-B c)))))
          (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (if (dk-only! iff (list 'IN x (alg-B c))) (prop))))
          (dk-have! (list 'IN x 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))))))

;;; ----------------------------------------------------------------------
;;; z in B(a, r)  ==>  z in CC and z - a in B(0, r)
;;; ----------------------------------------------------------------------
(sp (make-wff (list 'FORALL 'alga_ (list 'IMPLIES '(IN alga_ CC) (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR)
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-Ba)
    (list 'AND '(IN algz_ CC) (list 'IN '(- algz_ alga_) alg-B0))))))))))
(dk-peel!)
(alg-ms-setup!)
(alg-ball-cc! 'algz_ 'alga_)
(fact 'ball-membership 'CC-MS 'alga_ 'algr_ 'algz_)
(define alg-t0-iff (iff-for (list 'IN 'algz_ alg-Ba)))
(define alg-t0-d '((DIST CC-MS) alga_ algz_))
(dk-have! (list '<= alg-t0-d 'algr_) (lambda () (if (dk-only! alg-t0-iff (list 'IN 'algz_ alg-Ba)) (prop))))
(dk-have! (list 'NOT (list '= alg-t0-d 'algr_)) (lambda () (if (dk-only! alg-t0-iff (list 'IN 'algz_ alg-Ba)) (prop))))
(alg-cc-typ! '(- algz_ alga_))
(alg-cc-typ! '(- alga_ algz_))
(fact 'cc-ms-dist 'alga_ 'algz_)
(fact 'cc-ms-dist 0 '(- algz_ alga_))
(alg-cc-typ! '(- 0 (- algz_ alga_)))
(dk-have! '(= (- 0 (- algz_ alga_)) (- alga_ algz_)) (lambda () (crs)))
(define (alg-t0-close!)
  (subst '(== ((DIST CC-MS) 0 (- algz_ alga_)) (magnitude (- 0 (- algz_ alga_)))))
  (subst '(= (- 0 (- algz_ alga_)) (- alga_ algz_)))
  (subst (list '= '(magnitude (- alga_ algz_)) alg-t0-d))
  (ass))
(dk-conj-close!
  (lambda ()
    (if (equal? (dk-goal) '(IN algz_ CC))
        (ass)
        (begin
          (mac 'ball-membership)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (begin (subst '(== (PTS CC-MS) CC)) (ass))
                  (alg-t0-close!))))))))
(qed 'alg-shift-in-ball)

;;; ----------------------------------------------------------------------
;;; the shift z |-> z - a on B(a, r) has derivative 1 (the quadratic
;;; criterion with M = 0, as cex-sub-deriv)
;;; ----------------------------------------------------------------------
(define (alg-shift-pt! x)                ; x in B(a, r) in context: x in CC, x - a in B(0, r)
  (if (not (dk-asm? (list 'IN (list '- x 'alga_) alg-B0)))
      (dk-split-all! (list (dk-fact! 'alg-shift-in-ball 'alga_ 'algr_ x))))
  (alg-cc-typ! (list '- x 'alga_)))
(sp (make-wff (list 'FORALL 'alga_ (list 'IMPLIES '(IN alga_ CC) (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR)
  (list 'IMPLIES '(< 0 algr_)
    (list 'FORALL 'algw_ (list 'IMPLIES (list 'IN 'algw_ alg-Ba)
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-Ba alg-S 'algw_ 1))))))))))
(dk-peel!)
(alg-ms-setup!)
(alg-ball-open! 'alga_)
(alg-shift-pt! 'algw_)
(alg-lam-typ! alg-S alg-Ba 'CC (lambda (x) (alg-shift-pt! x)))
(alg-cc-typ! 1)
(fact 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-fact! 'cc-diff-on-quadratic alg-Ba alg-S 'algw_ 1 0)
(define (alg-sd-bound!)
  (let* ((x (dk-di-var!)) (d (list '- x 'algw_)) (m (list 'magnitude d)))
    (alg-shift-pt! x)
    (alg-cc-typ! d)
    (alg-rr-typ! m)
    (alg-beta!
      (lambda ()
        (let ((inner (cadr (cadr (dk-goal)))))
          (alg-cc-typ! inner)
          (dk-have! (list '= inner 0) (lambda () (crs)))
          (subst (list '= inner 0))
          (subst (dk-fact! 'cc-magnitude-zero))
          (alg-rr-typ! (list '* m m))
          (dk-ineq!))))))
(let ((ch (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f alg-S) (dk-contains? f 'magnitude))) "the quadratic criterion")))
  (alg-chain! (detach-with! ch alg-sd-bound!)))
(ass)
(qed 'alg-shift-diff)

;;; F_g is a function on B(0, r) when r < R(g) is in context (2.10: cps-holomorphic-ball)
(define (alg-Fg-fun! g)
  (let ((h (list 'HOLOMORPHIC-ON alg-B0 (alg-F g))))
    (if (not (dk-asm? h)) (dk-split-all! (list (dk-fact! 'cps-holomorphic-ball g 'algr_))))
    (if (not (dk-asm? (list 'IN (alg-F g) (list 'FUN alg-B0 'CC))))
        (fact 'holomorphic-on-in-fun alg-B0 (alg-F g)))))
;;; (IN (CC-SERIES-LIMIT (psum g z)) CC) for z in B(0, r): it is F_g(z)
(define (alg-series-typ! g z)
  (let ((s (list 'CC-SERIES-LIMIT (alg-psum g z))) (fz (list (alg-F g) z)))
    (if (not (dk-asm? (list 'IN s 'CC)))
        (begin
          (alg-Fg-fun! g)
          (fact 'fun-apply-type-c (alg-F g) alg-B0 'CC z)
          (dk-have! (list '== fz s) (lambda () (alg-beta! (lambda () (qrfl)))))
          (dk-have! (list 'IN s 'CC) (lambda () (subst (list '= s fz)) (ass)))))
    s))
;;; (< r R(D)) from (< r R(G)) and R(D) = R(G) landed by CITE
(define (alg-radius-lt! d eqn)
  (if (not (dk-asm? (list '< 'algr_ (list 'CPS-RADIUS d))))
      (dk-have! (list '< 'algr_ (list 'CPS-RADIUS d)) (lambda () (subst eqn) (ass)))))
(define (alg-stage-apply! f terms1 terms2)
  (let ((c1 (apply inst*! f terms1)))
    (apply dk-apply! c1 terms2)))
;;; G_g is a function on B(a, r) (g with r < R(g) in context)
(define (alg-G-typ! g)
  (alg-lam-typ! (alg-G g) alg-Ba 'CC
    (lambda (x) (alg-shift-pt! x) (alg-series-typ! g (list '- x 'alga_)))))

;;; ----------------------------------------------------------------------
;;; THE TRANSLATED SERIES IS DIFFERENTIABLE ON B(a, r), termwise (2.10 at the
;;; centre a): G_cf'(w) = sum dcf(k) (w - a)^k, dcf(k) = (k+1) cf(k+1).
;;; ----------------------------------------------------------------------
(sp (make-wff
  (list 'FORALL 'algc_ (list 'IMPLIES '(IN algc_ (FUN NN CC))
    (list 'FORALL 'algd_ (list 'IMPLIES '(IN algd_ (FUN NN CC)) (list 'IMPLIES (alg-dcf-h 'algc_ 'algd_)
      (list 'FORALL 'alga_ (list 'IMPLIES '(IN alga_ CC) (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR)
        (list 'IMPLIES '(< 0 algr_) (list 'IMPLIES '(< algr_ (CPS-RADIUS algc_))
          (list 'FORALL 'algw_ (list 'IMPLIES (list 'IN 'algw_ alg-Ba)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-Ba (alg-G 'algc_) 'algw_
                  (list 'CC-SERIES-LIMIT (alg-psum 'algd_ '(- algw_ alga_)))))))))))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'cc-nf-carr)
(alg-ball-open! 'alga_)
(alg-ball-open! 0)
(alg-shift-pt! 'algw_)
(alg-Fg-fun! 'algc_)
(alg-radius-lt! 'algd_ (dk-fact! 'cps-radius-derived 'algc_ 'algd_))
(alg-Fg-fun! 'algd_)
(define alg-td-sw (list alg-S 'algw_))
(dk-have! (list '= alg-td-sw '(- algw_ alga_)) (lambda () (alg-beta! (lambda () (rfl)))))
(dk-have! (list 'IN alg-td-sw alg-B0) (lambda () (subst (list '= alg-td-sw '(- algw_ alga_))) (ass)))
(define alg-td-m (alg-series-typ! 'algd_ alg-td-sw))
(dk-apply! (alg-chain! (dk-fact! 'cps-diff-on-ball 'algc_ 'algd_ 'algr_)) alg-td-sw)
(dk-fact! 'alg-shift-diff 'alga_ 'algr_ 'algw_)
(dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES (list 'IN 'd2y_ alg-Ba) (list 'IN (list alg-S 'd2y_) alg-B0)))
  (lambda () (let ((y (dk-di-var!))) (alg-shift-pt! y) (alg-beta! (lambda () (ass))))))
(define alg-td-r1
  (alg-stage-apply! (dk-fact! 'diff-on-chain 'CC-NORMED-FIELD) (list alg-Ba alg-B0 alg-S (alg-F 'algc_)) (list 'algw_ 1 alg-td-m)))
(define alg-td-p (list-ref alg-td-r1 3))
(define alg-td-l0 (list-ref alg-td-r1 5))
(alg-G-typ! 'algc_)
(dk-have! (list 'IN (alg-G 'algc_) (list 'FUN alg-Ba '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ alg-Ba) (list '== (list (alg-G 'algc_) 'hbx_) (list alg-td-p 'hbx_))))
  (lambda () (let ((x (dk-di-var!))) (alg-shift-pt! x) (alg-beta! (lambda () (qrfl))))))
(dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD alg-Ba (alg-G 'algc_) alg-td-p 'algw_ alg-td-l0)
(define alg-td-t (alg-series-typ! 'algd_ '(- algw_ alga_)))
(dk-have! (list '= alg-td-t alg-td-l0)
  (lambda ()
    (alg-beta!
      (lambda ()
        (alg-kops!)
        (subst (alg-ring-id! '(algu_) '(= (* algu_ 1) algu_) (list alg-td-t)))
        (rfl)))))
(subst (list '= alg-td-t alg-td-l0))
(ass)
(qed 'cps-translate-diff)

;;; ----------------------------------------------------------------------
;;; THE TRANSLATED SERIES IS HOLOMORPHIC ON B(a, r)
;;; ----------------------------------------------------------------------
;;; a fresh symbol D with D in FUN(NN, CC) and the derived-sequence equation of G
(define (alg-derived! g)
  (let* ((body (lambda (v) (list '* (list 'succ v) (list g (list 'succ v)))))
         (ab (dk-abstract! 'NN 'CC body (lambda (v) (alg-cc-typ! (body v)) (ass))))
         (d (car ab)) (ve (cdr ab)))
    (dk-have! (alg-dcf-h g d)
      (lambda ()
        (let ((v (dk-di-var!)))
          (alg-cc-typ! (body v))
          (subst (dk-apply! ve v))
          (rfl))))
    d))
(define (alg-cps-hyps concl)
  (list 'FORALL 'algc_ (list 'IMPLIES '(IN algc_ (FUN NN CC))
    (list 'FORALL 'alga_ (list 'IMPLIES '(IN alga_ CC) (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR)
      (list 'IMPLIES '(< 0 algr_) (list 'IMPLIES '(< algr_ (CPS-RADIUS algc_)) concl)))))))))
(sp (make-wff (alg-cps-hyps (list 'HOLOMORPHIC-ON alg-Ba (alg-G 'algc_)))))
(dk-peel!)
(alg-ms-setup!)
(alg-ball-open! 'alga_)
(alg-ball-open! 0)
(alg-G-typ! 'algc_)
(define alg-th-d (alg-derived! 'algc_))
(define alg-th-df (alg-chain! (dk-fact! 'cps-translate-diff 'algc_ alg-th-d 'alga_ 'algr_)))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let ((w (dk-di-var!)))
          (ew (list 'CC-SERIES-LIMIT (alg-psum alg-th-d (list '- w 'alga_))))
          (dk-apply! alg-th-df w)
          (ass))
        (ass))))
(qed 'cps-translate-holomorphic)

;;; ----------------------------------------------------------------------
;;; THE k-TH DERIVATIVE OF THE TRANSLATED SERIES IS THE TRANSLATED k-TH
;;; DERIVED SERIES: 0 < r < R(cf), V(g, k) =>
;;;   NTH-DERIV-ON(CC-NF, B(a,r), G_cf, k) = G_g
;;; (induction on k, as cps-nth-deriv; the step is cps-translate-diff at the
;;; k-th derived sequence, whose derived sequence is the (k+1)-th:
;;; cps-kth-derived-step).  V(g, k) is 27-A's: g(n) = (n+k)!/n! cf(n+k).
;;; ----------------------------------------------------------------------
(define (alg-coef n k)
  (list '* (list '* (list 'FACTORIAL (list '+ n k)) (list 'recip (list 'FACTORIAL n))) (list 'algc_ (list '+ n k))))
(define (alg-val g k)
  (list 'FORALL 'ctcn_ (list 'IMPLIES '(IN ctcn_ NN) (list '= (list g 'ctcn_) (alg-coef 'ctcn_ k)))))
(define (alg-nd k) (list 'NTH-DERIV-ON 'CC-NORMED-FIELD alg-Ba (alg-G 'algc_) k))
;;; A FRESH SYMBOL G with V(G, K) in context (ndl-seq!, nth-deriv-laws.scm)
(define (alg-seq! k)
  (alg-nn-typ! k)
  (let* ((ab (dk-abstract! 'NN 'CC (lambda (v) (alg-coef v k)) (lambda (v) (alg-cc-typ! (alg-coef v k)) (ass))))
         (g (car ab))
         (veq (cdr ab)))
    (dk-have! (alg-val g k)
      (lambda ()
        (let ((v (dk-di-var!)))
          (alg-cc-typ! (alg-coef v k))
          (subst (dk-apply! veq v))
          (rfl))))
    g))
(define (alg-fun-dom! f)
  (dk-have! (list 'IN f '(FUN NN))
    (lambda ()
      (mac-h 'fun-codomain-iff (list 'IN f '(FUN NN CC)))
      (dk-split-all!)
      (ass))))
(define alg-tn-claim
  (list 'FORALL 'algm_ (list 'IMPLIES '(IN algm_ NN)
    (list 'FORALL 'algq_ (list 'IMPLIES '(IN algq_ (FUN NN CC))
      (list 'IMPLIES (alg-val 'algq_ 'algm_) (list '= (alg-nd 'algm_) (alg-G 'algq_))))))))
(sp (make-wff (alg-cps-hyps
  (list 'FORALL 'algk_ (list 'IMPLIES '(IN algk_ NN)
    (list 'FORALL 'algg_ (list 'IMPLIES '(IN algg_ (FUN NN CC))
      (list 'IMPLIES (alg-val 'algg_ 'algk_) (list '= (alg-nd 'algk_) (alg-G 'algg_))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'nn-zero-in)
(alg-ball-open! 'alga_)
(alg-ball-open! 0)
(dk-have! alg-tn-claim
  (lambda ()
    (let* ((br (use-induction))
           (m (cdr (assq 'var br)))
           (ih (cdr (assq 'ih br)))
           (step (cdr (assq 'step br))))
      ;; k = 0: q = cf
      (dk-focus! (cdr (assq 'base br)))
      (dk-peel!)
      (let* ((q (car (cadr (cadddr (cadr (cadddr (caddr (dk-goal))))))))
             (vq (dk-pick (lambda (f) (alpha-equiv? f (alg-val q 0))) "the values of q"))
             (eqn (list '= q 'algc_)))
        (alg-fun-dom! q)
        (alg-fun-dom! 'algc_)
        (dk-have! eqn
          (lambda ()
            (let ((ch (dk-fact! 'fun-domain-extensionality 'NN q 'algc_))
                  (fa (list 'FORALL 'algx_ (list 'IMPLIES '(IN algx_ NN) (list '= (list q 'algx_) '(algc_ algx_))))))
              (dk-have! fa
                (lambda ()
                  (let ((v (dk-di-var!)))
                    (subst (dk-deepest (lambda () (inst+ vq v))))
                    (subst (dk-fact! 'nn-add-zero v))
                    (subst (dk-fact! 'rr-recip-factorial v))
                    (alg-cc-typ! (list 'algc_ v))
                    (crs))))
              (detach! ch)
              (ass))))
        (mac 'nth-deriv-on-zero)
        (subst eqn)
        (rfl))
      ;; k -> k + 1
      (dk-focus! step)
      (dk-peel!)
      (let* ((gq (caddr (dk-goal)))
             (q (car (cadr (cadddr (cadr (cadddr gq))))))
             (sm (list 'succ m)))
        (alg-nn-typ! sm)
        (let* ((g0 (alg-seq! m)))
          (mac 'nth-deriv-on-succ)
          (subst (dk-apply! ih g0))
          (alg-radius-lt! g0 (dk-fact! 'cps-kth-derived-radius 'algc_ m g0))
          (alg-radius-lt! q (dk-fact! 'cps-kth-derived-radius 'algc_ sm q))
          (dk-fact! 'cps-kth-derived-step 'algc_ m g0 q)
          (alg-G-typ! q)
          (let* ((tdiff (alg-chain! (dk-fact! 'cps-translate-diff g0 q 'alga_ 'algr_)))
                (lhs (cadr (dk-goal)))
                (deq! (lambda (v)
                        (alg-shift-pt! v)
                        (alg-series-typ! q (list '- v 'alga_))
                        (dk-apply! tdiff v)
                        (dk-cite! 'cc-deriv-on-of-is-diff-on alg-Ba (alg-G g0) v
                                  (list 'CC-SERIES-LIMIT (alg-psum q (list '- v 'alga_)))))))
            (dk-fun-ext! lhs (alg-G q) alg-Ba 'CC
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((v (dk-di-var!)))
                      (subst (deq! v))
                      (ass)))))
              (lambda () (ass))
              (lambda (v)
                (deq! v)
                (alg-beta! (lambda () (ass)))))))))))
(dk-apply! alg-tn-claim 'algk_ 'algg_)
(ass)
(qed 'cps-translate-nth-deriv)

;;; ----------------------------------------------------------------------
;;; f GIVEN AS A POWER SERIES AT a ON B(a, r) INSIDE ITS OPEN SET U (the data
;;; of Def 2.11, named): f in FUN(U, CC), cf in FUN(NN, CC), a in CC,
;;; 0 < r < R(cf), B(a, r) subset U, f(z) = sum cf(k) (z - a)^k on B(a, r).
;;; ----------------------------------------------------------------------
(define alg-rep-eq
  (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-Ba)
    (list '= '(algf_ algz_) (list 'CC-SERIES-LIMIT (alg-psum 'algc_ '(- algz_ alga_)))))))
(define (alg-rep-hyps concl)
  (list 'FORALL 'algf_ (list 'FORALL 'algu_ (list 'IMPLIES '(IN algf_ (FUN algu_ CC))
    (alg-cps-hyps
      (list 'IMPLIES (list 'SUBSET alg-Ba 'algu_) (list 'IMPLIES alg-rep-eq concl)))))))
(define alg-fB (list 'RESTRICT 'algf_ alg-Ba))
;;; after the peel: (= (RESTRICT f B(a,r)) G_cf) in context
(define (alg-restrict-eq!)
  (alg-G-typ! 'algc_)
  (dk-fun-ext! alg-fB (alg-G 'algc_) alg-Ba 'CC
    (lambda () (alg-chain! (dk-fact! 'restrict-in-fun 'algf_ 'algu_ 'CC alg-Ba)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
    (lambda () (ass))
    (lambda (v)
      (subst (dk-cite! 'restrict-apply 'algf_ alg-Ba v))
      (subst (dk-apply! (dk-ctx-form alg-rep-eq) v))
      (alg-shift-pt! v)
      (alg-series-typ! 'algc_ (list '- v 'alga_))
      (alg-beta! (lambda () (rfl))))))
(define (alg-rep-setup!)
  (dk-peel!)
  (alg-ms-setup!)
  (fact 'nn-zero-in)
  (alg-ball-open! 'alga_)
  (alg-ball-open! 0)
  (alg-center-in! 'alga_)
  (alg-center-in! 0))

;;; THE NOTES' COROLLARY 2.14 AT A CENTRE a, LITERALLY: f^(k)(a) = k! a_k,
;;; f^(k) the k-th derivative of f on the ball B(a, r) (f restricted to it)
(sp (make-wff (alg-rep-hyps
  (list 'FORALL 'algk_ (list 'IMPLIES '(IN algk_ NN)
    (list '= (list (list 'NTH-DERIV-ON 'CC-NORMED-FIELD alg-Ba alg-fB 'algk_) 'alga_) '(* (FACTORIAL algk_) (algc_ algk_))))))))
(alg-rep-setup!)
(subst (alg-restrict-eq!))
(define alg-tc-g (alg-seq! 'algk_))
(subst (alg-chain! (dk-fact! 'cps-translate-nth-deriv 'algc_ 'alga_ 'algr_ 'algk_ alg-tc-g)))
(define alg-tc-h (alg-seq! '(succ algk_)))
(dk-split-all! (list (dk-fact! 'cps-taylor-coefficients 'algc_ 'algk_ alg-tc-g alg-tc-h 'algr_)))
(alg-cc-typ! '(- alga_ alga_))
(dk-have! '(= (- alga_ alga_) 0) (lambda () (crs)))
(dk-have! (list '== (list (alg-G alg-tc-g) 'alga_) (list (alg-F alg-tc-g) 0))
  (lambda () (alg-beta! (lambda () (subst '(= (- alga_ alga_) 0)) (qrfl)))))
(subst (list '= (list (alg-G alg-tc-g) 'alga_) (list (alg-F alg-tc-g) 0)))
(ass)
(qed 'taylor-coefficients-at)

;;; f is holomorphic on the ball B(a, r) (restricted to it)
(sp (make-wff (alg-rep-hyps (list 'HOLOMORPHIC-ON alg-Ba alg-fB))))
(alg-rep-setup!)
(subst (alg-restrict-eq!))
(dk-fact! 'cps-translate-holomorphic 'algc_ 'alga_ 'algr_)
(ass)
(qed 'analytic-rep-holomorphic)

;;; f has derivative cf(1) at a, on its open set U
(sp (make-wff (alg-rep-hyps (list 'IMPLIES '(IS-OPEN CC-MS algu_)
  '(IS-DIFF-ON CC-NORMED-FIELD algu_ algf_ alga_ (algc_ 1))))))
(alg-rep-setup!)
(define alg-ad-d (alg-derived! 'algc_))
(alg-G-typ! 'algc_)
(dk-apply! (alg-chain! (dk-fact! 'cps-translate-diff 'algc_ alg-ad-d 'alga_ 'algr_)) 'alga_)
(alg-radius-lt! alg-ad-d (dk-fact! 'cps-radius-derived 'algc_ alg-ad-d))
(alg-shift-pt! 'alga_)
(define alg-ad-l (alg-series-typ! alg-ad-d '(- alga_ alga_)))
(dk-have! (list 'IS-OPEN alg-nfm 'algu_) (lambda () (mac 'cc-ms-open-iff) (ass)))
(dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ alg-Ba) (list '= '(algf_ cexx_) (list (alg-G 'algc_) 'cexx_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (subst (dk-apply! (dk-ctx-form alg-rep-eq) x))
      (alg-shift-pt! x)
      (alg-series-typ! 'algc_ (list '- x 'alga_))
      (alg-beta! (lambda () (rfl))))))
(alg-chain! (dk-fact! 'cc-diff-on-local 'algu_ 'algf_ alg-Ba (alg-G 'algc_) 'alga_ alg-ad-l))
(alg-cc-typ! '(- alga_ alga_))
(dk-have! '(= (- alga_ alga_) 0) (lambda () (crs)))
(alg-cc-typ! '(algc_ 1))
(fact 'nn-one-is-succ-zero)
(alg-nn-typ! '(succ 0))
(dk-have! (list '= '(algc_ 1) alg-ad-l)
  (lambda ()
    (subst '(= (- alga_ alga_) 0))
    (dk-split-all! (list (dk-fact! 'cps-sum-at-zero alg-ad-d)))
    (subst (list '= (list 'CC-SERIES-LIMIT (alg-psum alg-ad-d 0)) (list alg-ad-d 0)))
    (subst (dk-apply! (dk-ctx-form (alg-dcf-h 'algc_ alg-ad-d)) 0))
    (subst '(= (succ 0) 1))
    (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list '(algc_ 1))))
    (rfl)))
(subst (list '= '(algc_ 1) alg-ad-l))
(ass)
(qed 'analytic-deriv)

;;; ----------------------------------------------------------------------
;;; IS-ANALYTIC-AT: the data above, with U open, IS analyticity at a (Def 2.11);
;;; and analyticity at a gives holomorphy on a ball around a.
;;; ----------------------------------------------------------------------
(sp (make-wff (alg-rep-hyps (list 'IMPLIES '(IS-OPEN CC-MS algu_) '(IS-ANALYTIC-AT algf_ algu_ alga_)))))
(alg-rep-setup!)
(alg-chain! (dk-fact! 'subset-mem-fwd alg-Ba 'algu_ 'alga_))
(mac 'IS-ANALYTIC-AT)
(define (alg-ai-close!)
  (let ((g (dk-goal)))
    (cond ((and (dk-head-is? g 'FORSOME) (eq? (cadr g) 'anlcf_)) (ew 'algc_) (dk-conj-close! alg-ai-close!))
          ((and (dk-head-is? g 'FORSOME) (eq? (cadr g) 'anlr_)) (ew 'algr_) (dk-conj-close! alg-ai-close!))
          (#t (ass)))))
(dk-conj-close! alg-ai-close!)
(qed 'analytic-at-intro)

;;; "if f is analytic at a, then f is holomorphic in a neighbourhood of a"
(sp (make-wff '(FORALL algf_ (FORALL algu_ (FORALL alga_ (IMPLIES (IS-ANALYTIC-AT algf_ algu_ alga_)
  (FORSOME algr_ (AND (IN algr_ RR) (AND (< 0 algr_) (AND (SUBSET (BALL CC-MS alga_ algr_) algu_)
    (HOLOMORPHIC-ON (BALL CC-MS alga_ algr_) (RESTRICT algf_ (BALL CC-MS alga_ algr_)))))))))))))
(dk-peel!)
(mac-h 'IS-ANALYTIC-AT '(IS-ANALYTIC-AT algf_ algu_ alga_))
(dk-split-all!)
(define alg-ah-c (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the coefficients")))
(define alg-ah-r (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the radius")))
(fact 'cc-is-metric-space)
(alg-pts-cc!)
(dk-have! '(IN alga_ CC)
  (lambda ()
    (mac-h 'IS-OPEN '(IS-OPEN CC-MS algu_))
    (dk-split-all!)
    (alg-chain! (dk-fact! 'subset-mem-fwd 'algu_ '(PTS CC-MS) 'alga_))
    (subst '(== CC (PTS CC-MS)))
    (ass)))
(ew alg-ah-r)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'HOLOMORPHIC-ON)
        (begin
          (alg-chain! (dk-fact! 'analytic-rep-holomorphic 'algf_ 'algu_ alg-ah-c 'alga_ alg-ah-r))
          (ass))
        (ass))))
(qed 'analytic-holomorphic-ball)
;;; ======================================================================
;;; (2) THE PRINCIPAL LOGARITHM.  CC-LOG(w) = THE z with -pi < Im z < pi and
;;; exp z = w (structure-library/analytic-log.scm).  Existence is Prop 2.19's
;;; cc-exp-open-strip-onto (its statement IS "the description is satisfiable",
;;; so it is cited, not restated); uniqueness is the injectivity of exp on the
;;; strip (31-B), restricted to the open strip.
;;; ======================================================================
(sp (make-wff '(FORALL clga_ (IMPLIES (IN clga_ CC) (FORALL clgb_ (IMPLIES (IN clgb_ CC)
  (IMPLIES (< (- PI) (imag-part clga_)) (IMPLIES (< (imag-part clga_) PI)
  (IMPLIES (< (- PI) (imag-part clgb_)) (IMPLIES (< (imag-part clgb_) PI)
  (IMPLIES (= (CC-EXP clga_) (CC-EXP clgb_)) (= clga_ clgb_))))))))))))
(dk-peel!)
(alg-pi-typ!)
(alg-rr-typ! '(imag-part clga_))
(alg-rr-typ! '(imag-part clgb_))
(dk-have! '(<= (- PI) (imag-part clga_)) (lambda () (dk-ineq! '(< (- PI) (imag-part clga_)))))
(dk-have! '(<= (- PI) (imag-part clgb_)) (lambda () (dk-ineq! '(< (- PI) (imag-part clgb_)))))
(alg-chain! (dk-fact! 'cc-exp-injective-strip 'clga_ 'clgb_))
(ass)
(qed 'cc-log-unique)

;;; the characterisation, by iota-d (the model: pi-spec, cc-exp-kernel.scm)
(sp (make-wff (list 'FORALL 'clgw_ (list 'IMPLIES '(IN clgw_ CC) (list 'IMPLIES (alg-slit 'clgw_)
  '(AND (IN (CC-LOG clgw_) CC) (AND (< (- PI) (imag-part (CC-LOG clgw_)))
     (AND (< (imag-part (CC-LOG clgw_)) PI) (= (CC-EXP (CC-LOG clgw_)) clgw_)))))))))
(dk-peel!)
(mac 'CC-LOG)
(define alg-io (cadr (cadr (dk-goal))))
(for-each
  (lambda (k)
    (dk-focus! k)
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (let ((w (dk-skolem! (alg-chain! (dk-fact! 'cc-exp-open-strip-onto 'clgw_)) #f)))
          (ew w)
          (for-each
            (lambda (k2)
              (dk-focus! k2)
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (begin
                    (dk-peel!)
                    (dk-split-all!)
                    (let* ((g (dk-goal)) (x (cadr g)) (y (caddr g)))
                      (alg-exp-typ! x) (alg-exp-typ! y)
                      (dk-have! (list '= (list 'CC-EXP x) (list 'CC-EXP y))
                        (lambda () (subst (list '= (list 'CC-EXP x) 'clgw_)) (subst (list '= (list 'CC-EXP y) 'clgw_)) (rfl)))
                      (alg-chain! (dk-fact! 'cc-log-unique x y))
                      (ass)))
                  (ass)))
            (dk-opened (lambda () (di)))))
        (ass)))
  (dk-opened (lambda () (iota-d alg-io))))
(qed 'cc-log-spec)

;;; the value lies in CC, in the open strip
(sp (make-wff (list 'FORALL 'clgw_ (list 'IMPLIES '(IN clgw_ CC) (list 'IMPLIES (alg-slit 'clgw_)
  '(AND (IN (CC-LOG clgw_) CC) (AND (< (- PI) (imag-part (CC-LOG clgw_))) (< (imag-part (CC-LOG clgw_)) PI))))))))
(dk-peel!)
(dk-split-all! (list (dk-fact! 'cc-log-spec 'clgw_)))
(dk-conj-close! (lambda () (ass)))
(qed 'cc-log-in-slit)

;;; THE NOTES' DEFINING PROPERTY: exp log w = w
(sp (make-wff (list 'FORALL 'clgw_ (list 'IMPLIES '(IN clgw_ CC) (list 'IMPLIES (alg-slit 'clgw_)
  '(= (CC-EXP (CC-LOG clgw_)) clgw_))))))
(dk-peel!)
(dk-split-all! (list (dk-fact! 'cc-log-spec 'clgw_)))
(ass)
(qed 'cc-exp-log)

;;; CC-LOG(w) IS the z of the strip with exp z = w
(sp (make-wff '(FORALL clgw_ (IMPLIES (IN clgw_ CC) (FORALL clgz_ (IMPLIES (IN clgz_ CC)
  (IMPLIES (< (- PI) (imag-part clgz_)) (IMPLIES (< (imag-part clgz_) PI)
  (IMPLIES (= (CC-EXP clgz_) clgw_) (= (CC-LOG clgw_) clgz_))))))))))
(dk-peel!)
(dk-have! (alg-slit 'clgw_)
  (lambda ()
    (subst '(= clgw_ (CC-EXP clgz_)))
    (alg-chain! (dk-fact! 'cc-exp-open-strip-avoids-negatives 'clgz_))
    (ass)))
(dk-split-all! (list (dk-fact! 'cc-log-spec 'clgw_)))
(alg-exp-typ! 'clgz_)
(dk-have! '(= (CC-EXP (CC-LOG clgw_)) (CC-EXP clgz_))
  (lambda () (subst '(= (CC-EXP (CC-LOG clgw_)) clgw_)) (subst '(= (CC-EXP clgz_) clgw_)) (rfl)))
(alg-chain! (dk-fact! 'cc-log-unique '(CC-LOG clgw_) 'clgz_))
(ass)
(qed 'cc-log-char)

;;; log exp z = z on the open strip
(sp (make-wff '(FORALL clgz_ (IMPLIES (IN clgz_ CC)
  (IMPLIES (< (- PI) (imag-part clgz_)) (IMPLIES (< (imag-part clgz_) PI)
    (= (CC-LOG (CC-EXP clgz_)) clgz_)))))))
(dk-peel!)
(alg-exp-typ! 'clgz_)
(dk-have! '(= (CC-EXP clgz_) (CC-EXP clgz_)) (lambda () (rfl)))
(alg-chain! (dk-fact! 'cc-log-char '(CC-EXP clgz_) 'clgz_))
(ass)
(qed 'cc-log-exp)

;;; on the positive reals, the principal logarithm is the real logarithm
(define (alg-exp-log-real! t)            ; (= (CC-EXP (LOG t)) t), t real and positive in context
  (alg-rr-typ! (list 'LOG t))
  (fact 'rr-subset-cc (list 'LOG t))
  (dk-have! (list '= (list 'CC-EXP (list 'LOG t)) t)
    (lambda ()
      (subst (dk-fact! 'cc-exp-real-is-r-exp (list 'LOG t)))
      (subst (alg-chain! (dk-fact! 'r-exp-log t)))
      (rfl))))
(sp (make-wff '(FORALL clgt_ (IMPLIES (IN clgt_ RR) (IMPLIES (< 0 clgt_) (= (CC-LOG clgt_) (LOG clgt_)))))))
(dk-peel!)
(alg-pi-typ!)
(fact 'rr-subset-cc 'clgt_)
(alg-exp-log-real! 'clgt_)
(alg-im-real! '(LOG clgt_))
(dk-have! '(< (- PI) (imag-part (LOG clgt_))) (lambda () (subst '(= (imag-part (LOG clgt_)) 0)) (dk-ineq! '(< 0 PI))))
(dk-have! '(< (imag-part (LOG clgt_)) PI) (lambda () (subst '(= (imag-part (LOG clgt_)) 0)) (dk-ineq! '(< 0 PI))))
(alg-chain! (dk-fact! 'cc-log-char 'clgt_ '(LOG clgt_)))
(ass)
(qed 'cc-log-real)

(sp (make-wff '(= (CC-LOG 1) 0)))
(fact 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(subst (dk-fact! 'cc-log-real 1))
(subst (dk-fact! 'log-one))
(fact 'rr-zero-in)
(rfl)
(qed 'cc-log-one)

;;; THE NOTES' (40): log(r exp(i th)) = ln r + i th, r > 0, -pi < th < pi
(sp (make-wff '(FORALL clgr_ (IMPLIES (IN clgr_ RR) (FORALL clgth_ (IMPLIES (IN clgth_ RR)
  (IMPLIES (< 0 clgr_) (IMPLIES (< (- PI) clgth_) (IMPLIES (< clgth_ PI)
    (= (CC-LOG (* clgr_ (CC-EXP (* +i clgth_)))) (+ (LOG clgr_) (* +i clgth_))))))))))))
(dk-peel!)
(alg-pi-typ!)
(define alg-pz '(+ (LOG clgr_) (* +i clgth_)))
(alg-exp-log-real! 'clgr_)
(alg-cc-typ! alg-pz)
(alg-cc-typ! '(* +i clgth_))
(alg-exp-typ! '(* +i clgth_))
(alg-cc-typ! '(* clgr_ (CC-EXP (* +i clgth_))))
(dk-have! (list '= alg-pz '(+ (LOG clgr_) (* clgth_ +i))) (lambda () (crs)))
(dk-split-all! (list (alg-chain! (dk-fact! 'cc-re-im-of alg-pz '(LOG clgr_) 'clgth_))))
(dk-have! (alg-lo alg-pz) (lambda () (subst (list '= (list 'imag-part alg-pz) 'clgth_)) (ass)))
(dk-have! (alg-hi alg-pz) (lambda () (subst (list '= (list 'imag-part alg-pz) 'clgth_)) (ass)))
(alg-and! '(IN (LOG clgr_) CC) '(IN (* +i clgth_) CC))
(dk-have! (list '= (list 'CC-EXP alg-pz) '(* clgr_ (CC-EXP (* +i clgth_))))
  (lambda ()
    (subst (dk-fact! 'cc-exp-add '(LOG clgr_) '(* +i clgth_)))
    (subst '(= (CC-EXP (LOG clgr_)) clgr_))
    (rfl)))
(alg-chain! (dk-fact! 'cc-log-char '(* clgr_ (CC-EXP (* +i clgth_))) alg-pz))
(ass)
(qed 'cc-log-polar)

;;; log(s w) = ln s + log w for a positive real s
(sp (make-wff (list 'FORALL 'clgs_ (list 'IMPLIES '(IN clgs_ RR) (list 'IMPLIES '(< 0 clgs_)
  (list 'FORALL 'clgw_ (list 'IMPLIES '(IN clgw_ CC) (list 'IMPLIES (alg-slit 'clgw_)
    '(= (CC-LOG (* clgs_ clgw_)) (+ (LOG clgs_) (CC-LOG clgw_)))))))))))
(dk-peel!)
(dk-split-all! (list (dk-fact! 'cc-log-spec 'clgw_)))
(define alg-sz '(+ (LOG clgs_) (CC-LOG clgw_)))
(alg-exp-log-real! 'clgs_)
(alg-cc-typ! alg-sz)
(alg-cc-typ! '(* clgs_ clgw_))
(alg-im-real! '(LOG clgs_))
(alg-rr-typ! '(imag-part (CC-LOG clgw_)))
(alg-and! '(IN (LOG clgs_) CC) '(IN (CC-LOG clgw_) CC))
(dk-have! (list '= (list 'imag-part alg-sz) '(imag-part (CC-LOG clgw_)))
  (lambda ()
    (subst (dk-fact! 'cc-im-add '(LOG clgs_) '(CC-LOG clgw_)))
    (subst '(= (imag-part (LOG clgs_)) 0))
    (crs)))
(dk-have! (alg-lo alg-sz) (lambda () (subst (list '= (list 'imag-part alg-sz) '(imag-part (CC-LOG clgw_)))) (ass)))
(dk-have! (alg-hi alg-sz) (lambda () (subst (list '= (list 'imag-part alg-sz) '(imag-part (CC-LOG clgw_)))) (ass)))
(dk-have! (list '= (list 'CC-EXP alg-sz) '(* clgs_ clgw_))
  (lambda ()
    (subst (dk-fact! 'cc-exp-add '(LOG clgs_) '(CC-LOG clgw_)))
    (subst '(= (CC-EXP (LOG clgs_)) clgs_))
    (subst '(= (CC-EXP (CC-LOG clgw_)) clgw_))
    (rfl)))
(alg-chain! (dk-fact! 'cc-log-char '(* clgs_ clgw_) alg-sz))
(ass)
(qed 'cc-log-scale)

;;; ======================================================================
;;; (3) LEMMA 2.20: THE LOGARITHMIC SERIES sum_{k>=1} (-1)^(k-1) z^k / k.
;;; Its coefficients are given by their values, as 27-A's theorems give
;;; theirs:  c(0) = 0,  c(j+1) = (-1)^j / (j+1).
;;;   cc-geometric-alternating   sum (-1)^k z^k converges to 1/(1+z), |z| < 1
;;;   cps-log-radius             every real 0 <= r < 1 is below R(c)
;;;                              (the convergence half of "the radius is 1")
;;;   cps-log-series             on B(0, r), 0 < r < 1: f'(z) = 1/(1+z)
;;; ======================================================================
(define (alg-succ-nz! j)                 ; (NOT (= (succ j) 0)), j in NN
  (let ((f (list 'NOT (list '= (list 'succ j) 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (alg-rr-typ! (list 'succ j))
            (fact 'nn-one-le-succ j)
            (fact 'rr-zero-in)
            (di)
            (dk-absurd! (list '= (list 'succ j) 0) (list '<= 1 (list 'succ j))))))
    f))
(define (alg-mag-neg-one!)               ; (= (magnitude -1) 1)
  (if (not (dk-asm? '(= (magnitude -1) 1)))
      (dk-have! '(= (magnitude -1) 1)
        (lambda ()
          (alg-rr-typ! -1)
          (subst (dk-fact! 'rr-magnitude-is-abs -1))
          (arith)))))
(define alg-gh '(FORALL algj_ (IMPLIES (IN algj_ NN) (= (algg_ algj_) (power -1 algj_)))))
(sp (make-wff (list 'FORALL 'algg_ (list 'IMPLIES '(IN algg_ (FUN NN CC)) (list 'IMPLIES alg-gh
  (list 'FORALL 'algz_ (list 'IMPLIES '(IN algz_ CC) (list 'IMPLIES '(< (magnitude algz_) 1)
    (list 'AND (list 'CC-SERIES-CONVERGES (alg-psum 'algg_ 'algz_))
               (list '= (list 'CC-SERIES-LIMIT (alg-psum 'algg_ 'algz_)) '(recip (+ 1 algz_))))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'nn-zero-in)
(define alg-gs-s (alg-psum 'algg_ 'algz_))
(define alg-gs-l '(recip (+ 1 algz_)))
(define alg-gs-t '(magnitude algz_))
(alg-rr-typ! alg-gs-t)
(fact 'cc-magnitude-nonneg 'algz_)
(alg-cc-typ! -1)
(alg-cc-typ! '(+ 1 algz_))
(alg-mag-neg-one!)
;; 1 + z /= 0: else z = -1 and |z| = 1
(dk-have! '(NOT (= (+ 1 algz_) 0))
  (lambda ()
    (di)
    (dk-have! '(= algz_ -1) (lambda () (dk-have! '(= algz_ (- (+ 1 algz_) 1)) (lambda () (crs))) (subst '(= algz_ (- (+ 1 algz_) 1))) (subst '(= (+ 1 algz_) 0)) (arith)))
    (dk-have! '(= (magnitude algz_) 1) (lambda () (subst '(= algz_ -1)) (ass)))
    (dk-absurd! '(= (magnitude algz_) 1) '(< (magnitude algz_) 1))))
(alg-cc-typ! alg-gs-l)
(alg-lam-typ! alg-gs-s 'NN 'CC (lambda (k) (alg-cc-typ! (list '* (list 'algg_ k) (list 'power 'algz_ k)))))
(define (alg-gs-p k) (list 'CC-SERIES-PARTIAL-SUM alg-gs-s k))
(define (alg-gs-ab k) (list '* (list 'power -1 k) (list 'power 'algz_ k)))
(define alg-gs-claim
  (list 'FORALL 'algm_ (list 'IMPLIES '(IN algm_ NN)
    (list '= (list '* '(+ 1 algz_) (alg-gs-p 'algm_)) (list '- 1 (alg-gs-ab 'algm_))))))
(dk-have! alg-gs-claim
  (lambda ()
    (let* ((br (use-induction))
           (m (cdr (assq 'var br)))
           (ih (cdr (assq 'ih br)))
           (step (cdr (assq 'step br))))
      (dk-focus! (cdr (assq 'base br)))
      (subst (dk-fact! 'cc-series-partial-sum-zero alg-gs-s))
      (subst (dk-fact! 'power-zero -1))
      (subst (dk-fact! 'power-zero 'algz_))
      (crs)
      (dk-focus! step)
      (let* ((p (alg-gs-p m)) (a (list 'power -1 m)) (b (list 'power 'algz_ m)) (sm (list 'succ m)))
        (fact 'cc-series-partial-sum-in-cc m alg-gs-s)
        (alg-cc-typ! a) (alg-cc-typ! b)
        (alg-nn-typ! sm)
        (alg-cc-typ! (list alg-gs-s m))
        (subst (alg-chain! (dk-fact! 'cc-series-partial-sum-succ alg-gs-s m)))
        (alg-and! (list 'IN -1 'CC) (list 'IN m 'NN))
        (alg-and! (list 'IN 'algz_ 'CC) (list 'IN m 'NN))
        (subst (dk-fact! 'power-succ -1 m))
        (subst (dk-fact! 'power-succ 'algz_ m))
        (alg-beta!
          (lambda ()
            (subst (dk-apply! (dk-ctx-form alg-gh) m))
            (let ((x (list '* a b)))
              (alg-cc-typ! x)
              (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* (+ 1 algu_) (+ algv_ algw_)) (+ (* (+ 1 algu_) algv_) (* (+ 1 algu_) algw_)))
                                   (list 'algz_ p x)))
              (subst ih)
              (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (+ (- 1 (* algv_ algw_)) (* (+ 1 algu_) (* algv_ algw_))) (- 1 (* (* -1 algv_) (* algu_ algw_))))
                                   (list 'algz_ a b)))
              (rfl))))))))
;; the partial sums converge to 1/(1+z)
(define alg-gs-inv (alg-chain! (dk-fact! 'cc-recip-inverse '(+ 1 algz_))))
(define (alg-gs-bound! j)                ; |P_j - L| <= |L| t^j
  (let* ((p (alg-gs-p j)) (a (list 'power -1 j)) (b (list 'power 'algz_ j)) (ab (list '* a b))
         (ps (dk-apply! (dk-ctx-form alg-gs-claim) j)))
    (fact 'cc-series-partial-sum-in-cc j alg-gs-s)
    (alg-cc-typ! ab)
    (dk-have! (list '= p (list '* alg-gs-l (list '- 1 ab)))
      (lambda ()
        (subst (list '= (list '- 1 ab) (list '* '(+ 1 algz_) p)))
        (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* algu_ (* algv_ algw_)) (* (* algv_ algu_) algw_)) (list alg-gs-l '(+ 1 algz_) p)))
        (subst alg-gs-inv)
        (subst (alg-ring-id! '(algu_) '(= (* 1 algu_) algu_) (list p)))
        (rfl)))
    (subst (list '= p (list '* alg-gs-l (list '- 1 ab))))
    (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (- (* algu_ (- 1 (* algv_ algw_))) algu_) (- (* algv_ (* algw_ algu_))))
                         (list alg-gs-l a b)))
    (alg-cc-typ! (list '* b alg-gs-l))
    (alg-cc-typ! (list '* a (list '* b alg-gs-l)))
    (subst (dk-fact! 'cc-magnitude-neg (list '* a (list '* b alg-gs-l))))
    (alg-and! (list 'IN a 'CC) (list 'IN (list '* b alg-gs-l) 'CC))
    (subst (dk-fact! 'cc-magnitude-mul a (list '* b alg-gs-l)))
    (alg-and! (list 'IN b 'CC) (list 'IN alg-gs-l 'CC))
    (subst (dk-fact! 'cc-magnitude-mul b alg-gs-l))
    (subst (dk-fact! 'cc-magnitude-power j -1))
    (subst (dk-fact! 'cc-magnitude-power j 'algz_))
    (subst '(= (magnitude -1) 1))
    (subst (dk-fact! 'rr-power-one j))
    (let ((c (list 'magnitude alg-gs-l)) (tj (list 'power alg-gs-t j)))
      (alg-rr-typ! c) (alg-rr-typ! tj)
      (dk-have! (list '= (list '* 1 (list '* tj c)) (list '* c tj))
        (lambda () (subst (alg-ring-id! '(algu_ algv_) '(= (* 1 (* algu_ algv_)) (* algv_ algu_)) (list tj c))) (rfl)))
      (subst (list '= (list '* 1 (list '* tj c)) (list '* c tj)))
      (alg-rr-typ! (list '* c tj))
      (dk-ineq!))))
;; the partial sums converge to L, by the squeeze with |L| t^k (t = |z| < 1)
(define alg-gs-sl (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM alg-gs-s 'k)))
(define alg-gs-c (list 'magnitude alg-gs-l))
(define alg-gs-f (list 'VNB-LAMBDA 'n 'NN (list 'power alg-gs-t 'n)))
(define alg-gs-m (list 'VNB-LAMBDA 'algk_ 'NN (list '* alg-gs-c (list 'power alg-gs-t 'algk_))))
(alg-rr-typ! alg-gs-c)
(fact 'cc-magnitude-nonneg alg-gs-l)
(alg-lam-typ! alg-gs-sl 'NN 'CC (lambda (k) (fact 'cc-series-partial-sum-in-cc k alg-gs-s)))
(alg-lam-typ! alg-gs-f 'NN 'RR (lambda (k) (alg-rr-typ! (list 'power alg-gs-t k))))
(alg-lam-typ! alg-gs-m 'NN 'RR (lambda (k) (alg-rr-typ! (list '* alg-gs-c (list 'power alg-gs-t k)))))
(dk-have! (list '< (list 'abs alg-gs-t) 1)
  (lambda () (subst (alg-chain! (dk-fact! 'rr-abs-of-nonneg alg-gs-t))) (ass)))
(alg-chain! (dk-fact! 'power-tends-to-zero alg-gs-t))
(dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list alg-gs-m 'j_) (list '* alg-gs-c (list alg-gs-f 'j_)))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (alg-rr-typ! (list 'power alg-gs-t j))
      (alg-beta! (lambda () (alg-rr-typ! (list '* alg-gs-c (list 'power alg-gs-t j))) (rfl))))))
(alg-chain! (dk-fact! 'rr-null-scale alg-gs-c alg-gs-f alg-gs-m))
(dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
            (list '<= (list 'magnitude (list '- (list alg-gs-sl 'cpdj_) alg-gs-l)) (list alg-gs-m 'cpdj_))))
  (lambda ()
    (let ((j (dk-di-var!)))
      (fact 'cc-series-partial-sum-in-cc j alg-gs-s)
      (alg-beta! (lambda () (alg-gs-bound! j))))))
(define alg-gs-ct (alg-chain! (dk-fact! 'cpd-cc-squeeze alg-gs-sl alg-gs-l alg-gs-m)))
(dk-have! (list 'CC-SERIES-CONVERGES alg-gs-s)
  (lambda () (mac 'cc-series-converges) (mac 'converges) (ew alg-gs-l) (ass)))
(define alg-gs-lim (list 'CC-SERIES-LIMIT alg-gs-s))
(fact 'cc-series-limit-in-cc alg-gs-s)
(dk-have! (list 'CONVERGES-TO 'CC-MS alg-gs-sl alg-gs-lim)
  (lambda ()
    (let ((c (alg-chain! (dk-fact! 'cc-series-limit-converges-to alg-gs-s))))
      (mac-h 'cc-series-converges-to c)
      (ass))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) '=)
        (begin (alg-chain! (dk-fact! 'cc-limit-unique alg-gs-sl alg-gs-lim alg-gs-l)) (ass))
        (ass))))
(qed 'cc-geometric-alternating)

;;; ----------------------------------------------------------------------
;;; the log coefficients: c(0) = 0, c(j+1) = (-1)^j / (j+1)
;;; ----------------------------------------------------------------------
(define alg-lv0 '(= (algc_ 0) 0))
(define alg-lv1 '(FORALL algj_ (IMPLIES (IN algj_ NN) (= (algc_ (succ algj_)) (* (power -1 algj_) (recip (succ algj_)))))))
(define (alg-log-hyps concl)
  (list 'FORALL 'algc_ (list 'IMPLIES '(IN algc_ (FUN NN CC)) (list 'IMPLIES alg-lv0 (list 'IMPLIES alg-lv1 concl)))))
;;; |c(k)| <= 1
(define (alg-coef-le-one! k)
  (let ((goal (list '<= (list 'magnitude (list 'algc_ k)) 1)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (alg-cc-typ! (list 'algc_ k))
            (use-em (list '= k 0)
              (lambda ()
                (subst (list '= k 0))
                (subst alg-lv0)
                (subst (dk-fact! 'cc-magnitude-zero))
                (dk-ineq!))
              (lambda ()
                (let* ((q (dk-skolem! (alg-chain! (dk-fact! 'nn-nonzero-is-succ k))))
                       (a (list 'power -1 q)) (sq (list 'succ q)) (rq (list 'recip sq)))
                  (subst (list '= k sq))
                  (subst (dk-apply! (dk-ctx-form alg-lv1) q))
                  (alg-succ-nz! q)
                  (alg-rr-typ! sq) (alg-rr-typ! rq)
                  (fact 'rr-subset-cc rq)
                  (alg-cc-typ! a)
                  (alg-and! (list 'IN a 'CC) (list 'IN rq 'CC))
                  (subst (dk-fact! 'cc-magnitude-mul a rq))
                  (subst (dk-fact! 'cc-magnitude-power q -1))
                  (alg-mag-neg-one!)
                  (subst '(= (magnitude -1) 1))
                  (subst (dk-fact! 'rr-power-one q))
                  (fact 'nn-one-le-succ q)
                  (fact 'rr-zero-in) (fact 'rr-one-in)
                  (dk-have! (list '< 0 sq) (lambda () (dk-ineq! (list '<= 1 sq))))
                  (fact 'rr-recip-pos sq)
                  (dk-have! (list '<= 0 rq) (lambda () (dk-ineq! (list '< 0 rq))))
                  (subst (dk-fact! 'rr-magnitude-is-abs rq))
                  (subst (alg-chain! (dk-fact! 'rr-abs-of-nonneg rq)))
                  (alg-chain! (dk-fact! 'rr-mul-le-right 1 sq rq))
                  (alg-chain! (dk-fact! 'rr-recip-inverse sq))
                  (alg-rr-typ! (list '* 1 rq))
                  (alg-rr-typ! (list '* sq rq))
                  (dk-ineq! (list '<= (list '* 1 rq) (list '* sq rq)) (list '= (list '* sq rq) 1))))))))
    goal))

;;; every real 0 <= r < 1 lies below the radius: the convergence half of
;;; "the radius of convergence is 1" (comparison with the geometric series at
;;; t = (r + 1)/2, then esup-upper)
(define alg-lr-t '(* (+ algr_ 1) 1/2))
(define alg-lr-f (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(magnitude (algc_ cpsk_)) (list 'power alg-lr-t 'cpsk_))))
(define alg-lr-g (list 'VNB-LAMBDA 'n 'NN (list 'power alg-lr-t 'n)))
(define alg-lr-sep '(SEP cpsr_ RR (AND (<= 0 cpsr_) (SERIES-CONVERGES (VNB-LAMBDA cpsk_ NN (* (magnitude (algc_ cpsk_)) (power cpsr_ cpsk_)))))))
(sp (make-wff (alg-log-hyps
  '(FORALL algr_ (IMPLIES (IN algr_ RR) (IMPLIES (<= 0 algr_) (IMPLIES (< algr_ 1) (< algr_ (CPS-RADIUS algc_)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(alg-rr-typ! alg-lr-t)
(dk-have! (list '<= 0 alg-lr-t) (lambda () (dk-ineq! '(<= 0 algr_))))
(dk-have! (list '< alg-lr-t 1) (lambda () (dk-ineq! '(< algr_ 1))))
(dk-have! (list '< 'algr_ alg-lr-t) (lambda () (dk-ineq! '(< algr_ 1))))
(alg-lam-typ! alg-lr-f 'NN 'RR (lambda (k) (alg-rr-typ! (list '* (list 'magnitude (list 'algc_ k)) (list 'power alg-lr-t k)))))
(alg-lam-typ! alg-lr-g 'NN 'RR (lambda (k) (alg-rr-typ! (list 'power alg-lr-t k))))
(alg-chain! (dk-fact! 'geometric-series-converges alg-lr-t))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list '<= 0 (list alg-lr-f 'n)) (list '<= (list alg-lr-f 'n) (list alg-lr-g 'n)))))
  (lambda ()
    (let* ((k (dk-di-var!)) (m (list 'magnitude (list 'algc_ k))) (p (list 'power alg-lr-t k)))
      (alg-rr-typ! m) (alg-rr-typ! p)
      (alg-coef-le-one! k)
      (fact 'cc-magnitude-nonneg (list 'algc_ k))
      (alg-chain! (dk-fact! 'rr-power-nonneg k alg-lr-t))
      (alg-chain! (dk-fact! 'rr-mul-le-right 0 m p))
      (alg-chain! (dk-fact! 'rr-mul-le-right m 1 p))
      (alg-rr-typ! (list '* 0 p)) (alg-rr-typ! (list '* 1 p)) (alg-rr-typ! (list '* m p))
      (dk-have! (list '= (list '* 0 p) 0) (lambda () (crs)))
      (dk-have! (list '= (list '* 1 p) p) (lambda () (crs)))
      (alg-beta!
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (equal? (cadr (dk-goal)) 0)
                  (dk-ineq! (list '<= (list '* 0 p) (list '* m p)) (list '= (list '* 0 p) 0))
                  (dk-ineq! (list '<= (list '* m p) (list '* 1 p)) (list '= (list '* 1 p) p))))))))))
(alg-chain! (dk-fact! 'comparison-test alg-lr-f alg-lr-g))
(dk-have! (list 'IN alg-lr-t alg-lr-sep)
  (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
(dk-have! (list 'SUBSET alg-lr-sep 'RR-POS-STAR)
  (lambda ()
    (mac 'subset-def)
    (let ((x (dk-di-var!)))
      (sep-me (list 'IN x alg-lr-sep))
      (dk-split-all!)
      (mac 'rr-pos-star-membership)
      (oi-l)
      (dk-conj-close! (lambda () (ass))))))
(define alg-lr-e (list 'ESUP alg-lr-sep))
(dk-apply! (alg-chain! (dk-fact! 'esup-upper alg-lr-sep)) alg-lr-t)
(alg-chain! (dk-fact! 'esup-in alg-lr-sep))
(subst (dk-fact! 'cps-radius-unfold 'algc_))
(mac-h 'rr-pos-star-membership (list 'IN alg-lr-e 'RR-POS-STAR))
(use-cases (dk-pick (dk-head? 'OR) "the two kinds of extended real")
  (lambda ()
    (dk-split-all!)
    (dk-ineq! (list '< 'algr_ alg-lr-t) (list '<= alg-lr-t alg-lr-e)))
  (lambda ()
    (subst (list '= alg-lr-e 'POS-INF))
    (mac '<)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) '<=)
            (begin
              (dk-have! '(IN algr_ RR-POS-STAR)
                (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))
              (fact 'rr-pos-star-below-pos-inf 'algr_)
              (ass))
            (begin
              (di)
              (fact 'pos-inf-not-in-rr)
              (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF 'algr_)) (ass)))
              (ai '(NOT (IN POS-INF RR)))))))))
(qed 'cps-log-radius)

;;; ----------------------------------------------------------------------
;;; the derived sequence of c is (-1)^j; |z| < r for z in B(0, r)
;;; ----------------------------------------------------------------------
(define (alg-log-derived!)               ; D with dcf-h(c, D) and D(j) = (-1)^j
  (let* ((d (alg-derived! 'algc_))
         (dh (dk-ctx-form (alg-dcf-h 'algc_ d)))
         (vals (list 'FORALL 'algj_ (list 'IMPLIES '(IN algj_ NN) (list '= (list d 'algj_) '(power -1 algj_))))))
    (dk-have! vals
      (lambda ()
        (let* ((j (dk-di-var!)) (sj (list 'succ j)) (rj (list 'recip sj)) (a (list 'power -1 j)))
          (alg-succ-nz! j)
          (alg-rr-typ! sj) (alg-rr-typ! rj)
          (fact 'rr-subset-cc sj) (fact 'rr-subset-cc rj)
          (alg-cc-typ! a)
          (subst (dk-apply! dh j))
          (subst (dk-apply! (dk-ctx-form alg-lv1) j))
          (subst (alg-ring-id! '(algu_ algv_ algw_) '(= (* algu_ (* algv_ algw_)) (* algv_ (* algu_ algw_))) (list sj a rj)))
          (subst (alg-chain! (dk-fact! 'rr-recip-inverse sj)))
          (subst (alg-ring-id! '(algu_) '(= (* algu_ 1) algu_) (list a)))
          (rfl))))
    d))
;;; |x - C| < r in context, for x in B(C, r), C in CC: lands (< (magnitude (- x C)) algr_)
(define (alg-ball-lt! x c)
  (let ((goal (list '< (list 'magnitude (list '- x c)) 'algr_))
        (d (list (list 'DIST 'CC-MS) c x)))
    (if (not (dk-asm? goal))
        (begin
          (alg-ball-cc! x c)
          (fact 'ball-membership 'CC-MS c 'algr_ x)
          (let ((iff (iff-for (list 'IN x (alg-B c)))))
            (dk-have! (list '< d 'algr_)
              (lambda ()
                (mac '<)
                (dk-conj-close! (lambda () (if (dk-only! iff (list 'IN x (alg-B c))) (prop)))))))
          (alg-cc-typ! (list '- x c)) (alg-cc-typ! (list '- c x))
          (alg-rr-typ! (list 'magnitude (list '- x c)))
          (fact 'cc-ms-dist c x)
          (dk-have! goal
            (lambda ()
              (dk-have! (list '= (list 'magnitude (list '- x c)) (list 'magnitude (list '- c x)))
                (lambda ()
                  (dk-have! (list '= (list '- x c) (list '- (list '- c x))) (lambda () (crs)))
                  (subst (list '= (list '- x c) (list '- (list '- c x))))
                  (subst (dk-fact! 'cc-magnitude-neg (list '- c x)))
                  (alg-rr-typ! (list 'magnitude (list '- c x)))
                  (rfl)))
              (subst (list '= (list 'magnitude (list '- x c)) (list 'magnitude (list '- c x))))
              (subst (list '= (list 'magnitude (list '- c x)) d))
              (ass)))))
    goal))

;;; LEMMA 2.20, the derivative: on B(0, r), 0 < r < 1, f'(z) = 1/(1+z)
(sp (make-wff (alg-log-hyps
  (list 'FORALL 'algr_ (list 'IMPLIES '(IN algr_ RR) (list 'IMPLIES '(< 0 algr_) (list 'IMPLIES '(< algr_ 1)
    (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ alg-B0)
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD alg-B0 (alg-F 'algc_) 'algz_ '(recip (+ 1 algz_))))))))))))
(dk-peel!)
(alg-ms-setup!)
(fact 'rr-one-in)
(alg-r-facts!)
(alg-chain! (dk-fact! 'cps-log-radius 'algc_ 'algr_))
(define alg-ls-d (alg-log-derived!))
(alg-ball-lt! 'algz_ 0)
(alg-cc-typ! '(- algz_ 0))
(dk-have! '(= (- algz_ 0) algz_) (lambda () (crs)))
(alg-rr-typ! '(magnitude algz_))
(dk-have! '(< (magnitude algz_) 1)
  (lambda () (subst '(= algz_ (- algz_ 0))) (dk-ineq! '(< (magnitude (- algz_ 0)) algr_) '(< algr_ 1))))
(dk-apply! (alg-chain! (dk-fact! 'cps-diff-on-ball 'algc_ alg-ls-d 'algr_)) 'algz_)
(dk-split-all! (list (alg-chain! (dk-fact! 'cc-geometric-alternating alg-ls-d 'algz_))))
(subst (list '= '(recip (+ 1 algz_)) (list 'CC-SERIES-LIMIT (alg-psum alg-ls-d 'algz_))))
(ass)
(qed 'cps-log-series)

;;; ======================================================================
;;; (4) PROP 2.21 BY DIFFERENTIATION.  First a general tool: a function whose
;;; derivative vanishes on a ball is constant there (the segment from the
