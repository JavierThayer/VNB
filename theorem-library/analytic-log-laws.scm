  (lambda ()
    (mac 'HOLOMORPHIC-ON)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let ((a (dk-di-var!))) (ew 0) (dk-apply! alg-zd-dh a) (ass))
            (ass))))))
(dk-have! (list 'SUBSET alg-Ba 'CC)
  (lambda () (mac 'subset-def) (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (alg-ball-cc! x 'alga_) (if (not (sequent-node-grounded? leaf)) (ass)))))
;; the segment from the centre a to z
(define alg-zd-w '(- algz_ alga_))
(alg-cc-typ! alg-zd-w)
(define alg-zd-road (dk-cite! 'seg-path-is-road 'alga_ 'algz_))
(define alg-zd-pg (list-ref alg-zd-road 1))
(define alg-zd-dg (list-ref alg-zd-road 2))
