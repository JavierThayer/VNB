;;; cg2-setprod.scm -- set products and set powers in a group: V^k inside the carrier,
;;; V^k V inside V^(k+1), and the union H of the V^k is a subgroup when V is symmetric and
;;; contains e (compact-groups notes, Prop 5.8, the algebraic part: "for any set E such that
;;; E = E^-1, the union of the E^k is clearly a subgroup").
;;; Agent ISOM, 2026-10-26.  Helper prefix: sp2-.  Library: algebra.

(define (sp2-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (sp2-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (sp2-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
;; split the conjunctions in context satisfying PRED, if any (dk-skolem! may have split already)
(define (sp2-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (sp2-rhs! iff) (dk-split-all! (list (dk-meta-iff-r! iff))))
(define (sp2-op x y) (list '(OPR g) x y))
(define (sp2-inv x) (list '(INV g) x))
(define sp2-E '(IDEN g))
(define (sp2-pow k) (list 'SET-POWER 'g 'V k))
(define sp2-H '(POWERS-UNION g V))

;;; ---- SET-PROD ----
(define sp2-sep '(SEP spz_ (CARR g) (FORSOME spx_ (AND (IN spx_ A) (FORSOME spy_ (AND (IN spy_ B) (= spz_ ((OPR g) spx_ spy_))))))))
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'A (list 'FORALL 'B (list '== '(SET-PROD g A B) sp2-sep))))))
(dk-peel!)
(mac 'SET-PROD)
(qrfl)
(qed 'set-prod-unfold)
(topic! 'set-prod-unfold 'plumbing)
(sp (make-wff '(FORALL g (FORALL A (FORALL B (FORALL x (FORALL y (IMPLIES (IS-GROUP g) (IMPLIES (IN x (CARR g))
   (IMPLIES (IN y (CARR g)) (IMPLIES (IN x A) (IMPLIES (IN y B) (IN ((OPR g) x y) (SET-PROD g A B))))))))))))))
(dk-peel!)
(dk-cite! 'group-carrier-closed-opr 'g 'x 'y)
(mac 'SET-PROD)
(in-sep! (lambda () (sp2-ass!))
         (lambda () (ew 'x)
                    (dk-conj-close!
                     (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                    (begin (ew 'y) (dk-conj-close! sp2-ass-rfl!))
                                    (sp2-ass!))))))
(qed 'set-prod-intro)
(topic! 'set-prod-intro 'algebra)

(sp (make-wff '(FORALL g (FORALL A (FORALL B (FORALL z (IMPLIES (IN z (SET-PROD g A B))
   (AND (IN z (CARR g)) (FORSOME x (AND (IN x A) (FORSOME y (AND (IN y B) (= z ((OPR g) x y))))))))))))))
(dk-peel!)
(dk-cite! 'set-prod-unfold 'g 'A 'B)
(dk-rewrite-h! '(IN z (SET-PROD g A B)) '(SET-PROD g A B) sp2-sep)
(dk-landed (lambda () (sep-me (list 'IN 'z sp2-sep))))
(dk-conj-close! sp2-ass!)
(qed 'set-prod-elim)
(topic! 'set-prod-elim 'algebra)

;;; ---- SET-POWER: the two cases ----
(sp (make-wff '(FORALL g (FORALL V (FORALL z (IMPLIES (IN z (SET-POWER g V 0)) (= z (IDEN g))))))))
(dk-peel!)
(dk-cite! 'set-power-zero 'g 'V)
(dk-rewrite-h! '(IN z (SET-POWER g V 0)) '(SET-POWER g V 0) '(SINGLETON (IDEN g)))
(sp2-rhs! (dk-cite! 'singleton-membership '(IDEN g) 'z))
(sp2-ass!)
(qed 'set-power-zero-elim)
(topic! 'set-power-zero-elim 'algebra)

(sp (make-wff '(FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IN (IDEN g) (SET-POWER g V 0)))))))
(dk-peel!)
(fact 'group-identity-in 'g)
(dk-cite! 'membership-implies-sethood '(IDEN g) '(CARR g))
(dk-cite! 'set-power-zero 'g 'V)
(let ((iff (dk-cite! 'singleton-membership '(IDEN g) '(IDEN g))))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! sp2-ass-rfl!)))
  (dk-meta-iff-l! iff))
(subst '(= (SET-POWER g V 0) (SINGLETON (IDEN g))))
(sp2-ass!)
(qed 'set-power-zero-iden)
(topic! 'set-power-zero-iden 'algebra)

;;; ---- V^k is a set ----
(define (sp2-set! k) (dk-cite! 'set-power-is-set k 'g 'V))
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IN (SET-POWER g V k) SET))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'set-power-zero 'g 'V)
  (fact 'group-identity-in 'g)
  (dk-cite! 'membership-implies-sethood sp2-E '(CARR g))
  (dk-cite! 'singleton-is-set sp2-E)
  (subst '(= (SET-POWER g V 0) (SINGLETON (IDEN g))))
  (sp2-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-apply! ih 'g 'V)
  (dk-cite! 'set-power-succ 'g 'V n)
  (dk-cite! 'group-carr-set 'g)
  (subst (list '= (list 'SET-POWER 'g 'V (list 'succ n)) (list 'SET-PROD 'g (sp2-pow n) 'V)))
  (mac 'SET-PROD)
  (dk-close-all! (lambda () (sep-set))))
(qed 'set-power-is-set)
(topic! 'set-power-is-set 'algebra)

(sp (make-wff '(FORALL g (FORALL V (FORALL k (FORALL z (IMPLIES (IS-GROUP g) (IMPLIES (IN k NN) (IMPLIES (IN z (SET-POWER g V (succ k)))
   (AND (IN z (CARR g)) (FORSOME x (AND (IN x (SET-POWER g V k)) (FORSOME y (AND (IN y V) (= z ((OPR g) x y))))))))))))))))
(dk-peel!)
(sp2-set! 'k)
(dk-cite! 'set-power-succ 'g 'V 'k)
(dk-rewrite-h! '(IN z (SET-POWER g V (succ k))) '(SET-POWER g V (succ k)) '(SET-PROD g (SET-POWER g V k) V))
(dk-cite! 'set-prod-elim 'g '(SET-POWER g V k) 'V 'z)
(sp2-ass!)
(qed 'set-power-succ-elim)
(topic! 'set-power-succ-elim 'algebra)

(sp (make-wff '(FORALL g (FORALL V (FORALL k (FORALL x (FORALL y (IMPLIES (IS-GROUP g) (IMPLIES (IN k NN)
   (IMPLIES (IN x (CARR g)) (IMPLIES (IN y (CARR g)) (IMPLIES (IN x (SET-POWER g V k)) (IMPLIES (IN y V)
     (IN ((OPR g) x y) (SET-POWER g V (succ k))))))))))))))))
(dk-peel!)
(sp2-set! 'k)
(dk-cite! 'set-prod-intro 'g '(SET-POWER g V k) 'V 'x 'y)
(dk-cite! 'set-power-succ 'g 'V 'k)
(dk-rewrite-h! '(IN ((OPR g) x y) (SET-PROD g (SET-POWER g V k) V)) '(SET-PROD g (SET-POWER g V k) V) '(SET-POWER g V (succ k)))
(sp2-ass!)
(qed 'set-power-succ-intro)
(topic! 'set-power-succ-intro 'algebra)

;;; ---- V^k lies in the carrier ----
(define (sp2-succ-parts! k y)            ; y in V^(succ k): returns (y1 y2) with y1 in V^k, y2 in V, y = y1 y2
  (sp2-set! k)
  (let* ((c (dk-cite! 'set-power-succ-elim 'g 'V k y)))
    (dk-split-all! (list c))
    (let* ((y1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y) (dk-contains? h (sp2-pow k)))) "the first factor")))
           (_ (sp2-split-if! (lambda (h) (and (dk-contains? h y1) (dk-contains? h (sp2-pow k))))))
           (y2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y1) (dk-contains? h y))) "the second factor"))))
      (sp2-split-if! (lambda (h) (and (dk-contains? h y2) (dk-contains? h y1))))
      (list y1 y2))))
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g))
   (SUBSET (SET-POWER g V k) (CARR g))))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in)
  (sp2-set! 0)
  (mac 'subset-def)
  (let ((z (sp2-peel-var!)))
    (dk-cite! 'set-power-zero-elim 'g 'V z)
    (fact 'group-identity-in 'g)
    (subst (list '= z sp2-E))
    (sp2-ass!))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-cite! 'nn-succ-closed n)
  (sp2-set! (list 'succ n))
  (mac 'subset-def)
  (let ((z (sp2-peel-var!)))
    (sp2-set! n)
    (dk-split-all! (list (dk-cite! 'set-power-succ-elim 'g 'V n z)))
    (sp2-ass!)))
(qed 'set-power-sub-carr)
(topic! 'set-power-sub-carr 'algebra)

(sp (make-wff '(FORALL g (FORALL V (FORALL k (FORALL z (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g))
   (IMPLIES (IN (IDEN g) V) (IMPLIES (IN k NN) (IMPLIES (IN z (SET-POWER g V k)) (IN z (SET-POWER g V (succ k))))))))))))))
(dk-peel!)
(sp2-set! 'k)
(dk-cite! 'set-power-sub-carr 'k 'g 'V)
(dk-cite! 'subset-mem-fwd '(SET-POWER g V k) '(CARR g) 'z)
(fact 'group-identity-in 'g)
(dk-cite! 'set-power-succ-intro 'g 'V 'k 'z sp2-E)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'z)))
(dk-rewrite-h! (list 'IN (sp2-op 'z sp2-E) '(SET-POWER g V (succ k))) (sp2-op 'z sp2-E) 'z)
(sp2-ass!)
(qed 'set-power-mono-succ)
(topic! 'set-power-mono-succ 'algebra)

;;; ---- the union H of the powers ----
(define sp2-bu '(BIG-UNION puk_ NN (SET-POWER g V puk_)))
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'V (list '== sp2-H sp2-bu)))))
(dk-peel!)
(mac 'POWERS-UNION)
(qrfl)
(qed 'powers-union-unfold)
(topic! 'powers-union-unfold 'plumbing)

(sp (make-wff '(FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IN (POWERS-UNION g V) SET))))))
(dk-peel!)
(mac 'POWERS-UNION)
(dk-each-leaf! (lambda () (bu-set))
  (lambda ()
    (cond ((equal? (dk-goal) '(IN NN SET)) (fact 'nn-is-set) (sp2-ass!))
          ((dk-head-is? (dk-goal) 'FORALL) (let ((k (sp2-peel-var!))) (sp2-set! k) (sp2-ass!)))
          (#t (sp2-ass!)))))
(qed 'powers-union-is-set)
(topic! 'powers-union-is-set 'algebra)
(define (sp2-hset!) (dk-cite! 'powers-union-is-set 'g 'V))

(sp (make-wff '(FORALL g (FORALL V (FORALL k (FORALL z (IMPLIES (IN k NN) (IMPLIES (IN z (SET-POWER g V k)) (IN z (POWERS-UNION g V))))))))))
(dk-peel!)
(mac 'POWERS-UNION)
(dk-each-leaf! (lambda () (bu-mi 'k)) (lambda () (sp2-ass!)))
(qed 'powers-union-intro)
(topic! 'powers-union-intro 'algebra)

(sp (make-wff '(FORALL g (FORALL V (FORALL z (IMPLIES (IN z (POWERS-UNION g V)) (FORSOME k (AND (IN k NN) (IN z (SET-POWER g V k))))))))))
(dk-peel!)
(dk-cite! 'powers-union-unfold 'g 'V)
(dk-rewrite-h! (list 'IN 'z sp2-H) sp2-H sp2-bu)
(let* ((landed (dk-landed (lambda () (bu-me (list 'IN 'z sp2-bu)))))
       (kin (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))))
  (ew (cadr kin))
  (dk-conj-close! sp2-ass!))
(qed 'powers-union-elim)
(topic! 'powers-union-elim 'algebra)

(define (sp2-elim! z)                    ; z in H: returns k with k in NN, z in V^k
  (let ((k (dk-skolem! (dk-cite! 'powers-union-elim 'g 'V z))))
    (sp2-split-if! (lambda (h) (and (dk-contains? h k) (dk-contains? h z))))
    (sp2-set! k)
    k))
(sp (make-wff '(FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g)) (SUBSET (POWERS-UNION g V) (CARR g))))))))
(dk-peel!)
(sp2-hset!)
(mac 'subset-def)
(let* ((z (sp2-peel-var!)) (k (sp2-elim! z)))
  (dk-cite! 'set-power-sub-carr k 'g 'V)
  (dk-cite! 'subset-mem-fwd (sp2-pow k) '(CARR g) z)
  (sp2-ass!))
(qed 'powers-union-sub-carr)
(topic! 'powers-union-sub-carr 'algebra)

(sp (make-wff '(FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IN (IDEN g) (POWERS-UNION g V)))))))
(dk-peel!)
(fact 'nn-zero-in)
(dk-cite! 'set-power-zero-iden 'g 'V)
(dk-cite! 'powers-union-intro 'g 'V 0 sp2-E)
(sp2-ass!)
(qed 'powers-union-iden)
(topic! 'powers-union-iden 'algebra)

(sp (make-wff '(FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g)) (SUBSET V (POWERS-UNION g V))))))))
(dk-peel!)
(sp2-hset!)
(mac 'subset-def)
(let ((z (sp2-peel-var!)))
  (fact 'nn-zero-in)
  (fact 'group-identity-in 'g)
  (dk-cite! 'subset-mem-fwd 'V '(CARR g) z)
  (dk-cite! 'set-power-zero-iden 'g 'V)
  (dk-cite! 'set-power-succ-intro 'g 'V 0 sp2-E z)
  (dk-cite! 'group-left-id 'g z)
  (dk-rewrite-h! (list 'IN (sp2-op sp2-E z) '(SET-POWER g V (succ 0))) (sp2-op sp2-E z) z)
  (dk-cite! 'nn-succ-closed 0)
  (dk-cite! 'powers-union-intro 'g 'V '(succ 0) z)
  (sp2-ass!))
(qed 'powers-union-contains)
(topic! 'powers-union-contains 'algebra)

(sp (make-wff '(FORALL g (FORALL V (FORALL z (FORALL y (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g))
   (IMPLIES (IN z (POWERS-UNION g V)) (IMPLIES (IN y V) (IN ((OPR g) z y) (POWERS-UNION g V))))))))))))
(dk-peel!)
(let ((k (sp2-elim! 'z)))
  (dk-cite! 'set-power-sub-carr k 'g 'V)
  (dk-cite! 'subset-mem-fwd (sp2-pow k) '(CARR g) 'z)
  (dk-cite! 'subset-mem-fwd 'V '(CARR g) 'y)
  (dk-cite! 'set-power-succ-intro 'g 'V k 'z 'y)
  (dk-cite! 'nn-succ-closed k)
  (dk-cite! 'powers-union-intro 'g 'V (list 'succ k) (sp2-op 'z 'y))
  (sp2-ass!))
(qed 'powers-union-right-mult)
(topic! 'powers-union-right-mult 'algebra)

;;; ---- H is closed under the product: x in H, y in V^m => x y in H, by induction on m ----
(sp (make-wff '(FORALL m (IMPLIES (IN m NN) (FORALL g (FORALL V (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g))
   (FORALL x (IMPLIES (IN x (POWERS-UNION g V)) (FORALL y (IMPLIES (IN y (SET-POWER g V m))
     (IN ((OPR g) x y) (POWERS-UNION g V))))))))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'set-power-zero-elim 'g 'V 'y)
  (sp2-hset!)
  (dk-cite! 'powers-union-sub-carr 'g 'V)
  (dk-cite! 'subset-mem-fwd sp2-H '(CARR g) 'x)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'x)))
  (subst (list '= 'y sp2-E))
  (subst (list '= (sp2-op 'x sp2-E) 'x))
  (sp2-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((yy (sp2-succ-parts! n 'y)) (y1 (car yy)) (y2 (cadr yy)))
    (sp2-hset!)
    (dk-cite! 'powers-union-sub-carr 'g 'V)
    (dk-cite! 'subset-mem-fwd sp2-H '(CARR g) 'x)
    (dk-cite! 'set-power-sub-carr n 'g 'V)
    (dk-cite! 'subset-mem-fwd (sp2-pow n) '(CARR g) y1)
    (dk-cite! 'subset-mem-fwd 'V '(CARR g) y2)
    (dk-apply! ih 'g 'V 'x y1)
    (dk-cite! 'group-carrier-closed-opr 'g 'x y1)
    (dk-cite! 'powers-union-right-mult 'g 'V (sp2-op 'x y1) y2)
    (dk-cite! 'group-assoc 'g 'x y1 y2)
    (subst (list '= 'y (sp2-op y1 y2)))
    (subst (list '= (sp2-op 'x (sp2-op y1 y2)) (sp2-op (sp2-op 'x y1) y2)))
    (sp2-ass!)))
(qed 'powers-union-prod)
(topic! 'powers-union-prod 'algebra)

;;; ---- and under the inverse, when V is symmetric: by induction on the power ----
(define sp2-sym '(FORALL p (IMPLIES (IN p V) (IN ((INV g) p) V))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'g (list 'FORALL 'V (list 'IMPLIES '(IS-GROUP g) (list 'IMPLIES '(SUBSET V (CARR g))
   (list 'IMPLIES sp2-sym '(FORALL y (IMPLIES (IN y (SET-POWER g V k)) (IN ((INV g) y) (POWERS-UNION g V)))))))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'set-power-zero-elim 'g 'V 'y)
  (fact 'group-inv-iden 'g)
  (dk-cite! 'powers-union-iden 'g 'V)
  (subst (list '= 'y sp2-E))
  (subst (list '= (sp2-inv sp2-E) sp2-E))
  (sp2-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((yy (sp2-succ-parts! n 'y)) (y1 (car yy)) (y2 (cadr yy)))
    (dk-cite! 'set-power-sub-carr n 'g 'V)
    (dk-cite! 'subset-mem-fwd (sp2-pow n) '(CARR g) y1)
    (dk-cite! 'subset-mem-fwd 'V '(CARR g) y2)
    (dk-apply! ih 'g 'V y1)
    (dk-apply! (dk-ctx-form sp2-sym) y2)
    (sp2-hset!)
    (dk-cite! 'powers-union-contains 'g 'V)
    (dk-cite! 'subset-mem-fwd 'V sp2-H (sp2-inv y2))
    (let ((m (sp2-elim! (sp2-inv y1))))
      (dk-cite! 'powers-union-prod m 'g 'V (sp2-inv y2) (sp2-inv y1)))
    (dk-cite! 'group-inv-opr 'g y1 y2)
    (subst (list '= 'y (sp2-op y1 y2)))
    (subst (list '= (sp2-inv (sp2-op y1 y2)) (sp2-op (sp2-inv y2) (sp2-inv y1))))
    (sp2-ass!)))
(qed 'powers-union-inv)
(topic! 'powers-union-inv 'algebra)

;;; ---- the union of the powers of a symmetric V is a subgroup ----
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'V (list 'IMPLIES '(IS-GROUP g) (list 'IMPLIES '(SUBSET V (CARR g))
   (list 'IMPLIES sp2-sym (list 'IS-SUBGROUP 'g sp2-H))))))))
(dk-peel!)
(sp2-hset!)
(dk-cite! 'powers-union-sub-carr 'g 'V)
(dk-cite! 'powers-union-iden 'g 'V)
(let ((iff (dk-cite! 'is-subgroup 'g sp2-H)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'FORALL)
             (begin
               (dk-peel!)
               (let ((gl (cadr (dk-goal))))
                 (if (equal? (car gl) '(OPR g))
                     (let ((m (sp2-elim! (caddr gl))))
                       (dk-cite! 'powers-union-prod m 'g 'V (cadr gl) (caddr gl)))
                     (let ((k (sp2-elim! (cadr gl))))
                       (dk-cite! 'powers-union-inv k 'g 'V (cadr gl))))
                 (sp2-ass!)))
             (sp2-ass!))))))
  (dk-meta-iff-l! iff)
  (sp2-ass!))
(qed 'powers-union-subgroup)
(topic! 'powers-union-subgroup 'algebra)
