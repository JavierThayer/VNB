;;; mg-struct.scm -- the structure METRIC-GROUP and the group metrics (in the pattern of
;;; tb11/tg-struct.scm): the typing and functoriality obligations of METRIC-GROUP-MS and
;;; METRIC-GROUP-GROUP, the bridge IS-METRIC-GROUP(G) => IS-GROUP-METRIC(space, group), the way
;;; back IS-GROUP-METRIC(ms, g) => IS-METRIC-GROUP(MAKE-METRIC-GROUP(ms, g)), and the isometry
;;; group restated over the structure (calculus.pdf ch. 3 sec. 8).
;;; Agent ISOM, 2026-10-26.  Helper prefix: mgs-.  Library: analysis.

(define (mgs-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (mgs-rhs! iff) (dk-split-all! (list (dk-meta-iff-r! iff))))
(define (mgs-length! functoid)
  (mac functoid) (len-r)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (mgs-close-conjuncts! functoid)
  (dk-conj-close!
   (lambda ()
     (let ((g0 (dk-goal)))
       (if (and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
           (mgs-length! functoid)
           (mgs-ass!))))))
(define mgs-MS '(METRIC-GROUP-MS G))
(define mgs-GG '(METRIC-GROUP-GROUP G))

;;; ---- the typing obligations ----
(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-METRIC-GROUP G) (list 'IS-METRIC-SPACE mgs-MS)))))
(dk-peel!)
(mgs-rhs! (dk-cite! 'is-metric-group 'G))
(mac 'is-metric-space)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(slot 'PTS)
(slot 'DIST)
(mgs-close-conjuncts! 'METRIC-GROUP-MS)
(qed 'metric-group-ms-is-metric-space)
(topic! 'metric-group-ms-is-metric-space 'analysis)

(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-METRIC-GROUP G) (list 'IS-GROUP mgs-GG)))))
(dk-peel!)
(mgs-rhs! (dk-cite! 'is-metric-group 'G))
(mac 'is-group)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(mgs-close-conjuncts! 'METRIC-GROUP-GROUP)
(qed 'metric-group-group-is-group)
(topic! 'metric-group-group-is-group 'analysis)

;;; ---- the functoriality obligations ----
(define (mgs-hom-close! typing)
  (dk-conj-close!
   (lambda ()
     (let ((g0 (dk-goal)))
       (cond ((dk-asm? g0) (ass))
             ((and (pair? g0) (pair? (cdr g0)) (pair? (cadr g0)))
              (dk-cite! typing (cadr (cadr g0))) (mgs-ass!))
             (#t (mgs-ass!)))))))
(sp (make-wff '(FORALL a (FORALL b (FORALL f (IMPLIES (IS-HOM-METRIC-GROUP a b f)
   (IS-HOM-METRIC-SPACE (METRIC-GROUP-MS a) (METRIC-GROUP-MS b) f)))))))
(dk-peel!)
(dk-split-all! (dk-landed (lambda () (mac-h 'is-hom-metric-group-def '(IS-HOM-METRIC-GROUP a b f)))))
(mac 'is-hom-metric-space-def)
(slot 'PTS)
(slot 'DIST)
(mgs-hom-close! 'metric-group-ms-is-metric-space)
(qed 'metric-group-ms-functorial)
(topic! 'metric-group-ms-functorial 'analysis)

(sp (make-wff '(FORALL a (FORALL b (FORALL f (IMPLIES (IS-HOM-METRIC-GROUP a b f)
   (IS-HOM-GROUP (METRIC-GROUP-GROUP a) (METRIC-GROUP-GROUP b) f)))))))
(dk-peel!)
(dk-split-all! (dk-landed (lambda () (mac-h 'is-hom-metric-group-def '(IS-HOM-METRIC-GROUP a b f)))))
(mac 'is-hom-group-def)
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(mgs-hom-close! 'metric-group-group-is-group)
(qed 'metric-group-group-functorial)
(topic! 'metric-group-group-functorial 'analysis)

;;; ---- a metric group is a group metric on its group ----
(define mgs-invlaw
  '(FORALL mga_ (IMPLIES (IN mga_ (CARR G))
     (FORALL mge_ (IMPLIES (POS-RR mge_)
       (FORSOME mgd_ (AND (POS-RR mgd_)
         (FORALL mgb_ (IMPLIES (IN mgb_ (CARR G))
           (IMPLIES (<= ((GDIST G) mga_ mgb_) mgd_)
             (<= ((GDIST G) ((INV G) mga_) ((INV G) mgb_)) mge_)))))))))))
(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-METRIC-GROUP G) (list 'IS-GROUP-METRIC mgs-MS mgs-GG)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(dk-cite! 'metric-group-group-is-group 'G)
(mgs-rhs! (dk-cite! 'is-metric-group 'G))
(mac 'IS-GROUP-METRIC)
(slot 'PTS)
(slot 'DIST)
(slot 'CARR)
(slot 'OPR)
(slot 'INV)
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((dk-asm? g0) (ass))
      ((dk-head-is? g0 'IS-CONTINUOUS)
       (mac 'IS-CONTINUOUS)
       (slot 'PTS)
       (dk-conj-close!
        (lambda ()
          (cond
           ((dk-asm? (dk-goal)) (ass))
           ((dk-head-is? (dk-goal) 'FORALL)
            (let ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
              (mac 'IS-CONTINUOUS-AT)
              (slot 'PTS)
              (slot 'DIST)
              (dk-apply! (dk-ctx-form mgs-invlaw) a)
              (dk-conj-close! (lambda () (mgs-ass!)))))
           (#t (mgs-ass!))))))
      (#t (rfl))))))
(qed 'metric-group-group-metric)
(topic! 'metric-group-group-metric 'analysis)

;;; ---- and back ----
(define mgs-M '(MAKE-METRIC-GROUP ms g))
(define (mgs-sets!)
  (let ((ts (dk-meta-iff-r! (dk-cite! 'is-metric-space 'ms)))
        (gs (dk-meta-iff-r! (dk-cite! 'is-group 'g))))
    (dk-split-all! (list ts gs))
    (dk-cite! 'membership-implies-sethood '(OPR g) '(FUN (CARTESIAN (CARR g) (CARR g)) (CARR g)))
    (dk-cite! 'membership-implies-sethood '(IDEN g) '(CARR g))
    (dk-cite! 'membership-implies-sethood '(INV g) '(FUN (CARR g) (CARR g)))
    (dk-cite! 'membership-implies-sethood '(DIST ms) '(FUN (CARTESIAN (PTS ms) (PTS ms)) RR))))
(define (mgs-readoff! acc)
  (slot acc)
  (nth-r)
  (let ((g0 (dk-goal)))
    (if (not (equal? (cadr g0) (caddr g0))) (slot acc))
    (qrfl)))
(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-METRIC-SPACE ms) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'CARR mgs-M) '(CARR g))))))))
(dk-peel!)
(mgs-sets!)
(mac 'MAKE-METRIC-GROUP)
(mgs-readoff! 'CARR)
(qed 'make-metric-group-carr)
(topic! 'make-metric-group-carr 'plumbing)
(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-METRIC-SPACE ms) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'OPR mgs-M) '(OPR g))))))))
(dk-peel!)
(mgs-sets!)
(mac 'MAKE-METRIC-GROUP)
(mgs-readoff! 'OPR)
(qed 'make-metric-group-opr)
(topic! 'make-metric-group-opr 'plumbing)
(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-METRIC-SPACE ms) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'IDEN mgs-M) '(IDEN g))))))))
(dk-peel!)
(mgs-sets!)
(mac 'MAKE-METRIC-GROUP)
(mgs-readoff! 'IDEN)
(qed 'make-metric-group-iden)
(topic! 'make-metric-group-iden 'plumbing)
(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-METRIC-SPACE ms) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'INV mgs-M) '(INV g))))))))
(dk-peel!)
(mgs-sets!)
(mac 'MAKE-METRIC-GROUP)
(mgs-readoff! 'INV)
(qed 'make-metric-group-inv)
(topic! 'make-metric-group-inv 'plumbing)
(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-METRIC-SPACE ms) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'GDIST mgs-M) '(DIST ms))))))))
(dk-peel!)
(mgs-sets!)
(mac 'MAKE-METRIC-GROUP)
(mgs-readoff! 'GDIST)
(qed 'make-metric-group-gdist)
(topic! 'make-metric-group-gdist 'plumbing)

(sp (make-wff (list 'FORALL 'ms (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-METRIC ms g) (list 'IS-METRIC-GROUP mgs-M))))))
(dk-peel!)
(mgs-rhs! (dk-cite! 'is-group-metric 'ms 'g))
(mgs-rhs! (dk-cite! 'is-metric-space 'ms))
(mgs-rhs! (dk-cite! 'is-group 'g))
(for-each (lambda (nm) (dk-cite! nm 'ms 'g))
          '(make-metric-group-carr make-metric-group-opr make-metric-group-iden make-metric-group-inv make-metric-group-gdist))
(define mgs-cont (dk-pick (lambda (h) (dk-head-is? h 'IS-CONTINUOUS)) "the continuity of the inverse"))
(define mgs-cparts (dk-meta-iff-r! (dk-cite! 'is-continuous 'ms 'ms '(INV g))))
(dk-split-all! (list mgs-cparts))
(mac 'is-metric-group)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(for-each (lambda (acc val) (subst (list '= (list acc mgs-M) val)))
          '(GDIST CARR OPR IDEN INV)
          '((DIST ms) (CARR g) (OPR g) (IDEN g) (INV g)))
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond ((dk-asm? g0) (ass))
           ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH)) (mgs-length! 'MAKE-METRIC-GROUP))
           ((and (dk-head-is? g0 'FORALL) (eq? (cadr g0) 'mga_))
            (let* ((pl (dk-peel!))
                   (a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) pl))))
                   (ps (filter (lambda (q) (dk-head-is? q 'POS-RR)) pl)))
              (dk-rewrite-h! (list 'IN a '(CARR g)) '(CARR g) '(PTS ms))
              (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-CONTINUOUS-AT))) "pointwise continuity") a)
              (mgs-rhs! (dk-cite! 'is-continuous-at 'ms 'ms '(INV g) a))
              (if (pair? ps)
                  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(INV g)) (dk-contains? h a) (dk-contains? h 'POS-RR))) "the eps-delta clause")
                             (cadr (car ps))))
              (subst '(= (CARR g) (PTS ms)))
              (mgs-ass!)))
           (#t (subst '(= (CARR g) (PTS ms))) (mgs-ass!))))))
(qed 'make-metric-group-is-metric-group)
(topic! 'make-metric-group-is-metric-group 'analysis)

;;; ---- the isometry group over the structure (the names of isom2-group.scm) ----
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
     (IS-METRIC-GROUP (MAKE-METRIC-GROUP (ISOMETRY-GROUP-MS s) (ISOMETRY-GROUP-GRP s)))))))
(dk-peel!)
(dk-cite! 'isometry-group-is-metric-group-gm 's)
(dk-cite! 'make-metric-group-is-metric-group '(ISOMETRY-GROUP-MS s) '(ISOMETRY-GROUP-GRP s))
(mgs-ass!)
(qed 'isometry-group-is-metric-group)
(topic! 'isometry-group-is-metric-group 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
     (AND (IS-COMPACT (ISOMETRY-GROUP-MS s))
          (IS-METRIC-GROUP (MAKE-METRIC-GROUP (ISOMETRY-GROUP-MS s) (ISOMETRY-GROUP-GRP s))))))))
(dk-peel!)
(fact 'isometry-group-compact 's)
(dk-cite! 'isometry-group-is-metric-group 's)
(dk-conj-close! (lambda () (mgs-ass!)))
(qed 'isometry-group-compact-metric-group)
(topic! 'isometry-group-compact-metric-group 'analysis)
