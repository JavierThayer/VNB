;;; ca-lft-cayley.scm -- Prop. 1.21 of complex-analysis.pdf: the Cayley transform C z = (z - i)/(z + i)
;;; maps R bijectively onto T \ {1} and the upper half plane H+ bijectively onto the disc D = B(0, 1).
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;;
;;; THE ROUTE.  The notes argue by connectedness of H+.  Here the comparison is direct:
;;; |z + i|^2 = |z - i|^2 + 4 Im z, so |C z| < 1 iff Im z > 0 and |C z| = 1 iff Im z = 0; and the
;;; inverse C^-1 u = i (u + 1)/(1 - u) = LFT(i, i, -1, 1) is C's inverse on all of C u {oo} by the
;;; composition law (C^-1 o C = L(2i, 0, 0, 2i) = id), which is (12) of the notes.
;;;
;;;   cayley-mag-sq         |w + i|^2 = |w - i|^2 + 4 Im w
;;;   cayley-at             C w = (w - i)/(w + i)                     (w + i /= 0)
;;;   cayley-mag            |C w| |w + i| = |w - i|
;;;   cayley-disc-iff       |C w| < 1 iff Im w > 0
;;;   cayley-circle-iff     |C w| = 1 iff Im w = 0
;;;   cayley-inv-left, cayley-inv-right     C^-1 o C = id = C o C^-1 on C u {oo}
;;;   cayley-real-circle    C maps R bijectively onto T \ {1}               (Prop. 1.21)
;;;   cayley-upper-disc     C maps H+ bijectively onto D                    (Prop. 1.21)
;;;
;;; Helper prefix clk-.

(define (clk-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(define (clk-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))
(define (clk-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))
(define (clk-real! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))
(define (clk-rewrite! s t prove)
  (if (not (equal? s t))
      (begin (dk-have! (list '= s t) prove) (subst (list '= s t)))))
(define (clk-crs-rewrite! s t) (clk-rewrite! s t (lambda () (crs))))
(define (clk-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (clk-conj (cdr fs)))))
(define (clk-cite-and! thm fs . terms)
  (let ((c (clk-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))

(define clk-c '(LFT 1 (- +i) 1 +i))

;;; rewrite (CAYLEY t) to (C t) in the goal: CAYLEY is a registered constant in APPLIED position, which
;;; no rewriter unfolds, so its definition goes through apply-congruence-1.
(define (clk-unfold-cayley! t)
  (fact 'cayley-def)
  (let ((e (dk-cite! 'apply-congruence-1 'CAYLEY clk-c t)))
    (subst e)))

(define clk-wp '(+ w +i))
(define clk-wm '(- w +i))

;;; Re i = 0 and Im i = 1 is rb3-re-im-i (theorem-library/rake-asm-b3.scm); this file's own
;;; copy, cc-i-parts, was dropped at the wiring of 2026-10-20 (proven-duplicate-audit).

;;; |w + i|^2 = |w - i|^2 + 4 Im w.
(sp (make-wff '(FORALL w (IMPLIES (IN w CC)
      (= (* (magnitude (+ w +i)) (magnitude (+ w +i)))
         (+ (* (magnitude (- w +i)) (magnitude (- w +i))) (* 4 (imag-part w))))))))
(dk-peel!)
(fact 'cc-i-in)
(dk-split-all! (list (dk-cite! 'rb3-re-im-i)))
(clk-type! clk-wp) (clk-type! clk-wm)
(subst (dk-cite! 'cc-magnitude-sq clk-wp))
(subst (dk-cite! 'cc-magnitude-sq clk-wm))
(subst (dk-cite! 'cc-re-add 'w '+i))
(subst (dk-cite! 'cc-im-add 'w '+i))
(subst (dk-cite! 'cc-re-sub 'w '+i))
(subst (dk-cite! 'cc-im-sub 'w '+i))
(dk-cite! 'real-part-in-rr 'w) (dk-cite! 'imag-part-in-rr 'w)
(crs)
(qed 'cayley-mag-sq)

;;; C w = (w - i)/(w + i) when w + i /= 0.
(sp (make-wff `(FORALL w (IMPLIES (IN w CC) (IMPLIES (NOT (= ,clk-wp 0))
      (= (CAYLEY w) (* ,clk-wm (recip ,clk-wp))))))))
(dk-peel!)
(fact 'cc-i-in) (fact 'cc-one-in)
(clk-type! '(- +i))
(dk-cite! 'lft-in-fun 1 '(- +i) 1 '+i)
(clk-unfold-cayley! 'w)
(dk-have! (list 'NOT (list '= '(+ (* 1 w) +i) 0))
  (lambda () (clk-crs-rewrite! '(+ (* 1 w) +i) clk-wp) (clk-finish-ass!)))
(subst (dk-cite! 'lft-at-finite 1 '(- +i) 1 '+i 'w))
(clk-crs-rewrite! '(+ (* 1 w) (- +i)) clk-wm)
(clk-crs-rewrite! '(+ (* 1 w) +i) clk-wp)
(clk-type! clk-wp) (clk-type! clk-wm)
(dk-cite! 'cc-div-closed clk-wm clk-wp)
(clk-finish!)
(qed 'cayley-at)

;;; |C w| |w + i| = |w - i|.
(define clk-m '(magnitude (CAYLEY w)))
(define clk-a (list 'magnitude clk-wm))
(define clk-b (list 'magnitude clk-wp))
(define clk-nz (list 'NOT (list '= clk-wp 0)))

(sp (make-wff `(FORALL w (IMPLIES (IN w CC) (IMPLIES ,clk-nz (= (* ,clk-m ,clk-b) ,clk-a))))))
(dk-peel!)
(fact 'cc-i-in)
(clk-type! clk-wp) (clk-type! clk-wm)
(subst (dk-cite! 'cayley-at 'w))
(clk-cite-and! 'cc-recip-closed (list (list 'IN clk-wp 'CC) clk-nz) clk-wp)
(clk-cite-and! 'cc-magnitude-mul (list (list 'IN clk-wm 'CC) (list 'IN (list 'recip clk-wp) 'CC)) clk-wm (list 'recip clk-wp))
(subst (list '= (list 'magnitude (list '* clk-wm (list 'recip clk-wp))) (list '* clk-a (list 'magnitude (list 'recip clk-wp)))))
(subst (dk-cite! 'aif-magnitude-recip clk-wp))
(dk-cite! 'cc-magnitude-closed clk-wp) (dk-cite! 'cc-magnitude-closed clk-wm)
(let ((iff (dk-cite! 'cc-magnitude-zero-iff clk-wp)))
  (dk-have! (list 'NOT (list '= clk-b 0)) (lambda () (dk-only! iff clk-nz) (prop))))
(clk-cite-and! 'rr-recip-inverse (list (list 'IN clk-b 'RR) (list 'NOT (list '= clk-b 0))) clk-b)
(dk-cite! 'rr-subset-cc clk-b)
(clk-cite-and! 'cc-recip-closed (list (list 'IN clk-b 'CC) (list 'NOT (list '= clk-b 0))) clk-b)
(let ((rb (dk-name! (list 'recip clk-b) 'CC)))
  (subst (list '= (list 'recip clk-b) rb))
  (dk-rewrite-h! (list '= (list '* clk-b (list 'recip clk-b)) 1) (list 'recip clk-b) rb)
  (dk-cite! 'rr-subset-cc clk-a)
  (clk-crs-rewrite! (list '* (list '* clk-a rb) clk-b) (list '* clk-a (list '* clk-b rb)))
  (subst (list '= (list '* clk-b rb) 1))
  (crs))
(qed 'cayley-mag)

;;; Shared set-up for the two comparisons: m = |C w|, A = |w - i|, B = |w + i| > 0,
;;; E1: m B = A, E2: B B = A A + 4 Im w.
(define clk-im '(imag-part w))
(define (clk-setup!)
  (fact 'cc-i-in)
  (clk-type! clk-wp) (clk-type! clk-wm)
  (dk-cite! 'cayley-at 'w)
  (clk-cite-and! 'cc-recip-closed (list (list 'IN clk-wp 'CC) clk-nz) clk-wp)
  (dk-cite! 'cc-div-closed clk-wm clk-wp)
  (dk-have! (list 'IN '(CAYLEY w) 'CC) (lambda () (subst (list '= '(CAYLEY w) (list '* clk-wm (list 'recip clk-wp)))) (clk-finish-ass!)))
  (for-each (lambda (z) (dk-cite! 'cc-magnitude-closed z) (dk-cite! 'cc-magnitude-nonneg z))
            (list '(CAYLEY w) clk-wm clk-wp))
  (dk-cite! 'imag-part-in-rr 'w)
  (let ((iff (dk-cite! 'cc-magnitude-zero-iff clk-wp)))
    (dk-have! (list 'NOT (list '= clk-b 0)) (lambda () (dk-only! iff clk-nz) (prop))))
  (dk-have! (list 'POS-RR clk-b)
    (lambda ()
      (mac 'POS-RR)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'NOT)
              (begin (di)
                     (dk-have! (list '= clk-b 0) (lambda () (subst (list '= clk-b 0)) (rfl)))
                     (dk-only! (list '= clk-b 0) (list 'NOT (list '= clk-b 0)))
                     (prop))
              (clk-finish-ass!))))))
  (dk-cite! 'rr-lt-of-pos-rr clk-b)
  (dk-cite! 'cayley-mag 'w)
  (dk-cite! 'cayley-mag-sq 'w)
  (clk-real! (list '* clk-b clk-b)) (clk-real! (list '* clk-a clk-a))
  (clk-real! (list '* clk-m clk-b)) (clk-real! (list '* clk-b clk-m))
  (clk-real! (list '* 1 clk-b)) (clk-real! (list '* clk-b 1))
  (let* ((p (dk-name! (list '* clk-b clk-b) 'RR))
         (q (dk-name! (list '* clk-a clk-a) 'RR)))
    (set! clk-p p) (set! clk-q q)
    (dk-rewrite-h! (dk-rewrite-h! clk-e2 (list '* clk-b clk-b) p) (list '* clk-a clk-a) q)))

(define clk-p #f)
(define clk-q #f)
;;; (<= (* S S) (* T T)) from the named squares, by ineq on PREMS
(define (clk-sq-le! s t . prems)
  (let ((ns (if (equal? s clk-b) clk-p clk-q)) (nt (if (equal? t clk-b) clk-p clk-q)))
    (dk-have! (list '<= (list '* s s) (list '* t t))
      (lambda ()
        (subst (list '= (list '* s s) ns))
        (subst (list '= (list '* t t) nt))
        (apply dk-ineq! (list '= clk-p (list '+ clk-q (list '* 4 clk-im))) prems)))))

(define (clk-antisym! a b)              ; a, b real, a <= b and b <= a in context: close (= a b)
  (let ((c1 (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
        (c2 (list 'AND (list '<= a b) (list '<= b a))))
    (dk-have! c1 (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-have! c2 (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-cite! 'rr-leq-antisymmetric a b)
    (clk-finish-ass!)))

;;; goal (< x y), x y real: trichotomy; LT closes the x < y case, GE runs with (<= y x) in context.
(define (clk-trich! x y lt ge)
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (let ((tri (dk-cite! 'rr-lt-trichotomy x y)))
    (use-cases tri
      lt
      (lambda () (dk-have! (list '<= y x) (lambda () (dk-ineq! (list '= x y)))) (ge))
      (lambda () (dk-have! (list '<= y x) (lambda () (dk-ineq! (list '< y x)))) (ge)))))

(define clk-e1 (list '= (list '* clk-m clk-b) clk-a))
(define clk-e2 (list '= (list '* clk-b clk-b) (list '+ (list '* clk-a clk-a) (list '* 4 clk-im))))

;;; |C w| < 1 iff Im w > 0.
(sp (make-wff `(FORALL w (IMPLIES (IN w CC) (IMPLIES ,clk-nz (IFF (< ,clk-m 1) (< 0 (imag-part w))))))))
(dk-peel!)
(clk-setup!)
(dk-iff! (lambda (g) (equal? g (list '< 0 clk-im)))
  (lambda ()
    (clk-trich! 0 clk-im
      (lambda () (clk-finish-ass!))
      (lambda ()
        (clk-sq-le! clk-b clk-a (list '<= clk-im 0))
        (dk-cite! 'rr-le-of-sq-le clk-b clk-a)
        (dk-cite! 'fom-mul-lt-left clk-m 1 clk-b)
        (dk-have! (list '= (list '* clk-b clk-m) clk-a)
          (lambda () (clk-crs-rewrite! (list '* clk-b clk-m) (list '* clk-m clk-b)) (clk-finish-ass!)))
        (dk-ineq! (list '< (list '* clk-b clk-m) (list '* clk-b 1)) (list '= (list '* clk-b clk-m) clk-a)
                  (list '<= clk-b clk-a)))))
  (lambda ()
    (clk-trich! clk-m 1
      (lambda () (clk-finish-ass!))
      (lambda ()
        (fact 'rr-one-in)
        (dk-cite! 'rr-mul-le-right 1 clk-m clk-b)
        (dk-have! (list '<= clk-b clk-a)
          (lambda () (dk-ineq! (list '<= (list '* 1 clk-b) (list '* clk-m clk-b)) clk-e1)))
        (clk-cite-and! 'rr-prod-le-prod
          (list (list 'AND (list '<= 0 clk-b) (list '<= clk-b clk-a)) (list '<= 0 clk-b) (list '<= clk-b clk-a))
          clk-b clk-a clk-b clk-a)
        (let ((pq (list '<= clk-p clk-q)))
          (dk-have! pq (lambda () (subst (list '= clk-p (list '* clk-b clk-b))) (subst (list '= clk-q (list '* clk-a clk-a))) (clk-finish-ass!)))
          (dk-ineq! pq (list '= clk-p (list '+ clk-q (list '* 4 clk-im))) (list '< 0 clk-im)))))))
(qed 'cayley-disc-iff)

;;; |C w| = 1 iff Im w = 0.
(sp (make-wff `(FORALL w (IMPLIES (IN w CC) (IMPLIES ,clk-nz (IFF (= ,clk-m 1) (= (imag-part w) 0)))))))
(dk-peel!)
(clk-setup!)
(dk-iff! (lambda (g) (equal? g (list '= clk-im 0)))
  (lambda ()
    (let* ((e1b (dk-rewrite-h! clk-e1 clk-m 1))
           (ab  (list '= clk-a clk-b)))
      (dk-have! ab (lambda () (subst (list '= clk-a (list '* 1 clk-b))) (crs)))
      (dk-have! (list '= clk-q clk-p)
        (lambda () (subst (list '= clk-q (list '* clk-a clk-a))) (subst (list '= clk-p (list '* clk-b clk-b)))
                   (subst ab) (rfl)))
      (dk-have! (list '<= (list '* 4 clk-im) 0) (lambda () (dk-ineq! (list '= clk-q clk-p) (list '= clk-p (list '+ clk-q (list '* 4 clk-im))))))
      (dk-have! (list '<= 0 (list '* 4 clk-im)) (lambda () (dk-ineq! (list '= clk-q clk-p) (list '= clk-p (list '+ clk-q (list '* 4 clk-im))))))
      (dk-have! (list '<= clk-im 0) (lambda () (dk-ineq! (list '<= (list '* 4 clk-im) 0))))
      (dk-have! (list '<= 0 clk-im) (lambda () (dk-ineq! (list '<= 0 (list '* 4 clk-im)))))
      (fact 'rr-zero-in)
      (clk-antisym! clk-im 0)))
  (lambda ()
    (clk-sq-le! clk-b clk-a (list '= clk-im 0))
    (clk-sq-le! clk-a clk-b (list '= clk-im 0))
    (dk-cite! 'rr-le-of-sq-le clk-b clk-a)
    (dk-cite! 'rr-le-of-sq-le clk-a clk-b)
    (dk-have! (list '<= (list '* clk-m clk-b) (list '* 1 clk-b)) (lambda () (dk-ineq! clk-e1 (list '<= clk-a clk-b))))
    (dk-have! (list '<= (list '* 1 clk-b) (list '* clk-m clk-b)) (lambda () (dk-ineq! clk-e1 (list '<= clk-b clk-a))))
    (fact 'rr-one-in)
    (dk-cite! 'rr-mul-le-cancel-pos clk-m clk-b 1)
    (dk-cite! 'rr-mul-le-cancel-pos 1 clk-b clk-m)
    (clk-antisym! clk-m 1)))
(qed 'cayley-circle-iff)

;;; ---------------------------------------------------------------------------
;;; Small facts.

(sp (make-wff '(= (imag-part 0) 0)))
(fact 'cc-zero-in) (fact 'rr-zero-in) (fact 'cc-i-in)
(dk-have! '(= 0 (+ 0 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 0 0 0)))
(clk-finish-ass!)
(qed 'cc-im-zero)

(sp (make-wff '(= (magnitude 1) 1)))
(fact 'cc-i-in) (fact 'cc-one-in)
(clk-type! '(* +i +i))
(fact 'cc-i-squared)
(clk-rewrite! 1 '(- (* +i +i)) (lambda () (subst '(= (* +i +i) -1)) (crs)))
(subst (dk-cite! 'cc-magnitude-neg '(* +i +i)))
(clk-cite-and! 'cc-magnitude-mul '((IN +i CC) (IN +i CC)) '+i '+i)
(subst '(= (magnitude (* +i +i)) (* (magnitude +i) (magnitude +i))))
(fact 'cc-magnitude-i)
(subst '(= (magnitude +i) 1))
(crs)
(qed 'cc-magnitude-one)

;;; Im w >= 0 keeps w away from the pole -i.
(sp (make-wff `(FORALL w (IMPLIES (IN w CC) (IMPLIES (<= 0 (imag-part w)) ,clk-nz)))))
(dk-peel!)
(fact 'cc-i-in)
(dk-split-all! (list (dk-cite! 'rb3-re-im-i)))
(dk-cite! 'imag-part-in-rr 'w)
(di)
(let ((e (dk-cite! 'cc-im-add 'w '+i)))
  (fact 'cc-im-zero)
  (let* ((e2 (dk-rewrite-h! e clk-wp 0))
         (e3 (dk-rewrite-h! e2 '(imag-part 0) 0))
         (e4 (dk-rewrite-h! e3 '(imag-part +i) 1)))
    (dk-have! '(< 0 0) (lambda () (dk-ineq! e4 (list '<= 0 clk-im))))
    (dk-cite! 'rr-lt-irrefl 0)
    (dk-only! '(< 0 0) '(NOT (< 0 0)))
    (prop)))
(qed 'cayley-no-pole)

;;; z real iff Im z = 0 (for z in CC).
(sp (make-wff "forall([x in rr], imag-part(x) = 0)"))
(let ((x (dk-di-var!)))
  (fact 'rr-zero-in) (fact 'cc-i-in)
  (dk-cite! 'rr-subset-cc x)
  (dk-have! (list '= x (list '+ x (list '* 0 '+i))) (lambda () (crs)))
  (dk-split-all! (list (dk-cite! 'cc-re-im-of x x 0)))
  (clk-finish-ass!))
(qed 'rr-imag-part-zero)

(sp (make-wff "forall([z in cc], imag-part(z) = 0 implies z in rr)"))
(let ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
  (fact 'cc-i-in)
  (dk-cite! 'real-part-in-rr z)
  (let* ((e (dk-cite! 'cc-re-im-decompose z))
         (x (caddr e)))
    (dk-cite! 'rr-subset-cc (list 'real-part z))
    (dk-have! (list '= x (list 'real-part z))
      (lambda () (subst (list '= (list 'imag-part z) 0)) (crs)))
    (dk-rewrite-h! e x (list 'real-part z))
    (subst (list '= z (list 'real-part z)))
    (clk-finish-ass!)))
(qed 'cc-real-of-im-zero)

;;; ---------------------------------------------------------------------------
;;; The four sets, as memberships.

(define (clk-sep-iff! def-thm)          ; goal (IFF (IN x C) (AND ...)) with C == SEP: unfold and split both ways
  (let ((x (cadr (cadr (dk-goal)))))
    (mac def-thm)
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda ()
        (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
          (sep-me h)
          (dk-conj-close! (lambda () (clk-finish-ass!)))))
      (lambda () (dk-split-all!) (in-sep! (lambda () (clk-finish-ass!)))))))

(sp (make-wff "forall([u], u in unit-circle iff u in cc and magnitude(u) = 1)"))
(di)
(clk-sep-iff! 'unit-circle-def)
(qed 'unit-circle-membership)

(sp (make-wff "forall([z], z in upper-half-plane iff z in cc and 0 < imag-part(z))"))
(di)
(clk-sep-iff! 'upper-half-plane-def)
(qed 'upper-half-plane-membership)

;;; goal (< x y), x y real, with (<= x y) and (NOT (= x y)) in context
(define (clk-lt-from-le-ne! x y)
  (clk-trich! x y
    (lambda () (clk-finish-ass!))
    (lambda ()
      (dk-have! (list '= x y)
        (lambda ()
          (let ((c1 (list 'AND (list 'IN x 'RR) (list 'IN y 'RR)))
                (c2 (list 'AND (list '<= x y) (list '<= y x))))
            (dk-have! c1 (lambda () (dk-conj-close! (lambda () (ass)))))
            (dk-have! c2 (lambda () (dk-conj-close! (lambda () (ass)))))
            (dk-cite! 'rr-leq-antisymmetric x y)
            (clk-finish-ass!))))
      (dk-only! (list '= x y) (list 'NOT (list '= x y)))
      (prop))))

;;; dist(CC-MS)(0, u) = magnitude(u), u in CC
(define (clk-dist0! u)
  (let ((d (list '(DIST CC-MS) 0 u)))
    (fact 'cc-zero-in)
    (dk-cite! 'cc-ms-dist 0 u)
    (dk-cite! 'cc-magnitude-closed u)
    (dk-have! (list '= d (list 'magnitude u))
      (lambda ()
        (subst (list '= d (list 'magnitude (list '- 0 u))))
        (clk-crs-rewrite! (list '- 0 u) (list '- u))
        (subst (dk-cite! 'cc-magnitude-neg u))
        (clk-finish!)))
    d))

(define clk-disc '(BALL CC-MS 0 1))
(define (clk-ball-iff! u)
  (fact 'cc-zero-in) (fact 'cc-is-metric-space) (fact 'rr-zero-in) (fact 'rr-one-in)
  (fact 'cc-ms@pts)
  (dk-cite! 'ball-membership 'CC-MS 0 1 u))

(sp (make-wff "forall([u], u in ball(cc-ms, 0, 1) implies u in cc and magnitude(u) < 1)"))
(let ((u (car (map cadr (dk-peel!)))))
  (let ((bm (clk-ball-iff! u)))
    (dk-have! (caddr bm) (lambda () (dk-only! bm (list 'IN u clk-disc)) (prop)))
    (dk-split-all!)
    (dk-have! (list 'IN u 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (clk-finish-ass!)))
    (let* ((d (clk-dist0! u))
           (mu (list 'magnitude u)))
      (dk-rewrite-h! (list '<= d 1) d mu)
      (dk-rewrite-h! (list 'NOT (list '= d 1)) d mu)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) '<)
              (clk-lt-from-le-ne! mu 1)
              (clk-finish-ass!)))))))
(qed 'unit-disc-elim)

(sp (make-wff "forall([u in cc], magnitude(u) < 1 implies u in ball(cc-ms, 0, 1))"))
(let ((u (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
  (clk-ball-iff! u)
  (dk-cite! 'cc-magnitude-closed u)
  (dk-have! (list 'IN u '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clk-finish-ass!)))
  (dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clk-finish-ass!)))
  (let ((d (clk-dist0! u)))
    (dk-have! (list '<= d (list 'magnitude u)) (lambda () (subst (list '= d (list 'magnitude u))) (dk-ineq!))))
  (clk-cite-and! 'ball-mem-from-le
    (list (list 'IN u '(PTS CC-MS)) (list 'IN (list 'magnitude u) 'RR) '(IN 1 RR)
          (list '<= '((DIST CC-MS) 0 u) (list 'magnitude u)) (list '< (list 'magnitude u) 1))
    'CC-MS 0 u (list 'magnitude u) 1)
  (clk-finish-ass!))
(qed 'unit-disc-intro)

;;; ---------------------------------------------------------------------------
;;; C^-1 = LFT(i, i, -1, 1), the inverse (12), on all of C u {oo}.

(define clk-ci '(LFT +i +i (- 1) 1))
(define clk-2i '(* 2 +i))
(define clk-id '(ID-FUN CC-HAT))

(define (clk-consts!)
  (fact 'cc-i-in) (fact 'cc-one-in) (fact 'cc-zero-in)
  (clk-type! '(- +i)) (clk-type! '(- 1)) (clk-type! clk-2i)
  (if (not (dk-asm? (list 'NOT (list '= clk-2i 0))))
      (begin
        (dk-have! '(NOT (= +i 0))
          (lambda ()
            (di)
            (fact 'cc-magnitude-i) (fact 'cc-magnitude-zero)
            (dk-have! '(= 1 0) (lambda () (subst '(= 1 (magnitude +i))) (subst '(= +i 0)) (clk-finish-ass!)))
            (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
            (dk-only! '(= 1 0) '(NOT (= 1 0)))
            (prop)))
        (dk-have! '(NOT (= 2 0)) (lambda () (arith)))
        (dk-have! '(IN 2 CC) (lambda () (type-term)))
        (dk-cite! 'cc-mul-nonzero 2 '+i))))

(sp (make-wff '(IN CAYLEY (FUN CC-HAT CC-HAT))))
(clk-consts!)
(fact 'cayley-def)
(subst (list '= 'CAYLEY clk-c))
(dk-cite! 'lft-in-fun 1 '(- +i) 1 '+i)
(clk-finish-ass!)
(qed 'cayley-in-fun)

;;; L(a,b,c,d) o L(a2,b2,c2,d2) = id when the product's coefficients reduce to (2i, 0, 0, 2i)
(define (clk-inv-compose! l1 l2)
  (clk-consts!)
  (fact 'cayley-def)
  (subst (list '= 'CAYLEY clk-c))
  (for-each (lambda (l)
              (let ((dt (list '- (list '* (cadr l) (car (cddddr l))) (list '* (caddr l) (cadddr l)))))
                (dk-have! (list 'NOT (list '= dt 0))
                  (lambda () (clk-crs-rewrite! dt clk-2i) (clk-finish-ass!)))))
            (list l1 l2))
  (subst (apply dk-cite! 'lft-compose (append (cdr l1) (cdr l2))))
  (let ((l3 (cadr (dk-goal))))
    (clk-crs-rewrite! (cadr l3) clk-2i)
    (clk-crs-rewrite! (caddr l3) 0)
    (clk-crs-rewrite! (cadddr l3) 0)
    (clk-crs-rewrite! (car (cddddr l3)) clk-2i)
    (subst (dk-cite! 'lft-scalar-identity clk-2i))
    (clk-finish!)))

(sp (make-wff (list '= (list 'COMPOSE clk-ci 'CAYLEY) clk-id)))
(clk-inv-compose! clk-ci clk-c)
(qed 'cayley-inv-left)

(sp (make-wff (list '= (list 'COMPOSE 'CAYLEY clk-ci) clk-id)))
(clk-inv-compose! clk-c clk-ci)
(qed 'cayley-inv-right)

(define (clk-inv-apply! outer inner thm)
  (let ((z (dk-di-var!)))
    (clk-consts!)
    (fact 'cayley-in-fun)
    (dk-cite! 'lft-in-fun '+i '+i '(- 1) 1)
    (fact 'cc-hat-in-set)
    (fact thm)
    (clk-cite-and! 'compose-apply (list (list 'IN inner '(FUN CC-HAT CC-HAT)) (list 'IN outer '(FUN CC-HAT CC-HAT)))
                   'CC-HAT 'CC-HAT 'CC-HAT outer inner z)
    (subst (list '= (list outer (list inner z)) (list (list 'COMPOSE outer inner) z)))
    (subst (list '= (list 'COMPOSE outer inner) clk-id))
    (subst (dk-cite! 'id-fun-apply 'CC-HAT z))
    (clk-finish!)))

(sp (make-wff `(FORALL z (IMPLIES (IN z CC-HAT) (= (,clk-ci (CAYLEY z)) z)))))
(clk-inv-apply! clk-ci 'CAYLEY 'cayley-inv-left)
(qed 'cayley-inv-apply-left)

(sp (make-wff `(FORALL u (IMPLIES (IN u CC-HAT) (= (CAYLEY (,clk-ci u)) u)))))
(clk-inv-apply! 'CAYLEY clk-ci 'cayley-inv-right)
(qed 'cayley-inv-apply-right)

;;; ---------------------------------------------------------------------------
;;; Values of C^-1 and the two poles.

(define (clk-ci-val u) (list '* (list '+ (list '* '+i u) '+i) (list 'recip (list '+ (list '* '(- 1) u) 1))))

(sp (make-wff `(FORALL u (IMPLIES (IN u CC) (IMPLIES (NOT (= u 1))
      (AND (= (,clk-ci u) ,(clk-ci-val 'u)) (IN (,clk-ci u) CC)))))))
(dk-peel!)
(clk-consts!)
(let ((den '(+ (* (- 1) u) 1)) (num '(+ (* +i u) +i)))
  (dk-have! (list 'NOT (list '= den 0))
    (lambda ()
      (di)
      (dk-have! '(= u 1) (lambda () (clk-crs-rewrite! 'u (list '- 1 den)) (subst (list '= den 0)) (crs)))
      (dk-only! '(= u 1) '(NOT (= u 1)))
      (prop)))
  (clk-type! num) (clk-type! den)
  (dk-cite! 'cc-div-closed num den)
  (let ((e (dk-cite! 'lft-at-finite '+i '+i '(- 1) 1 'u)))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN) (subst e))
        (clk-finish-ass!)))))
(qed 'cayley-inv-at)

(sp (make-wff (list '= (list clk-ci 1) 'CC-INF)))
(clk-consts!)
(dk-have! '(= (+ (* (- 1) 1) 1) 0) (lambda () (crs)))
(subst (dk-cite! 'lft-at-pole '+i '+i '(- 1) 1 1))
(clk-finish!)
(qed 'cayley-inv-pole)

(sp (make-wff '(= (CAYLEY (- +i)) CC-INF)))
(clk-consts!)
(dk-cite! 'lft-in-fun 1 '(- +i) 1 '+i)
(clk-unfold-cayley! '(- +i))
(dk-have! '(= (+ (* 1 (- +i)) +i) 0) (lambda () (crs)))
(subst (dk-cite! 'lft-at-pole 1 '(- +i) 1 '+i '(- +i)))
(clk-finish!)
(qed 'cayley-pole)

;;; w = C^-1(u), u in CC: C(w) = u and w + i /= 0.
(define (clk-w-facts! u)
  (let* ((w (list clk-ci u)))
    (dk-cite! 'cc-in-cc-hat u)
    (let ((cw (dk-cite! 'cayley-inv-apply-right u)))
      (dk-have! (list 'NOT (list '= (list '+ w '+i) 0))
        (lambda ()
          (di)
          (dk-have! (list '= w '(- +i))
            (lambda () (clk-crs-rewrite! w (list '- (list '+ w '+i) '+i)) (subst (list '= (list '+ w '+i) 0)) (crs)))
          (let* ((c2 (dk-rewrite-h! cw w '(- +i))))
            (fact 'cayley-pole)
            (let ((c3 (dk-rewrite-h! c2 '(CAYLEY (- +i)) 'CC-INF)))
              (dk-cite! 'cc-ne-inf u)
              (dk-have! (list '= u 'CC-INF) (lambda () (subst (list '= u 'CC-INF)) (rfl)))
              (dk-only! (list '= u 'CC-INF) (list 'NOT (list '= u 'CC-INF)))
              (prop)))))
      cw)))

;;; ---------------------------------------------------------------------------
;;; The four maps.

(define clk-y1 '(DIFFERENCE UNIT-CIRCLE (SINGLETON 1)))

(define (clk-y1-iff! u)                 ; u in Y1 iff u in CC and |u| = 1 and u /= 1, landed as an IFF
  (fact 'cc-one-in)
  (dk-cite! 'membership-implies-sethood 1 'CC)
  (let* ((d (dk-cite! 'difference-membership 'UNIT-CIRCLE '(SINGLETON 1) u))
         (c (dk-cite! 'unit-circle-membership u))
         (s (dk-cite! 'singleton-membership 1 u)))
    (list d c s)))

(sp (make-wff `(FORALL x (IMPLIES (IN x RR) (IN (CAYLEY x) ,clk-y1)))))
(let ((x (dk-di-var!)))
  (clk-consts!)
  (dk-cite! 'rr-subset-cc x)
  (dk-cite! 'rr-imag-part-zero x)
  (dk-cite! 'imag-part-in-rr x)
  (dk-have! (list '<= 0 (list 'imag-part x)) (lambda () (dk-ineq! (list '= (list 'imag-part x) 0))))
  (dk-cite! 'cayley-no-pole x)
  (let ((ca (dk-cite! 'cayley-at x)))
    (clk-type! (list '- x '+i)) (clk-type! (list '+ x '+i))
    (dk-cite! 'cc-div-closed (list '- x '+i) (list '+ x '+i))
    (dk-have! (list 'IN (list 'CAYLEY x) 'CC) (lambda () (subst ca) (clk-finish-ass!))))
  (let* ((ci (dk-cite! 'cayley-circle-iff x)))
    (dk-have! (list '= (list 'magnitude (list 'CAYLEY x)) 1) (lambda () (dk-only! ci (list '= (list 'imag-part x) 0)) (prop))))
  (dk-cite! 'membership-implies-sethood (list 'CAYLEY x) 'CC)
  (dk-have! (list 'NOT (list '= (list 'CAYLEY x) 1))
    (lambda ()
      (di)
      (dk-cite! 'cc-in-cc-hat x)
      (let* ((e1 (dk-cite! 'cayley-inv-apply-left x))
             (e2 (dk-rewrite-h! e1 (list 'CAYLEY x) 1)))
        (fact 'cayley-inv-pole)
        (dk-rewrite-h! e2 (list clk-ci 1) 'CC-INF)
        (dk-cite! 'cc-ne-inf x)
        (dk-have! (list '= x 'CC-INF) (lambda () (subst (list '= x 'CC-INF)) (rfl)))
        (dk-only! (list '= x 'CC-INF) (list 'NOT (list '= x 'CC-INF)))
        (prop))))
  (let ((fs (clk-y1-iff! (list 'CAYLEY x))))
    (dk-only! (car fs) (cadr fs) (caddr fs) (list 'IN (list 'CAYLEY x) 'CC) (list 'IN (list 'CAYLEY x) 'SET)
              (list '= (list 'magnitude (list 'CAYLEY x)) 1) (list 'NOT (list '= (list 'CAYLEY x) 1)))
    (prop)))
(qed 'cayley-maps-real)

(sp (make-wff `(FORALL u (IMPLIES (IN u ,clk-y1) (IN (,clk-ci u) RR)))))
(let ((u (dk-di-var!)))
  (clk-consts!)
  (let ((fs (clk-y1-iff! u)))
    (dk-have! (list 'AND (list 'IN u 'CC) (list 'AND (list '= (list 'magnitude u) 1) (list 'NOT (list '= u 1))))
      (lambda ()
        (dk-have! (list 'IN u 'SET)
          (lambda () (dk-have! (list 'IN u 'UNIT-CIRCLE) (lambda () (dk-only! (car fs) (list 'IN u clk-y1)) (prop)))
                     (dk-cite! 'membership-implies-sethood u 'UNIT-CIRCLE) (clk-finish-ass!)))
        (dk-only! (car fs) (cadr fs) (caddr fs) (list 'IN u clk-y1) (list 'IN u 'SET))
        (prop))))
  (dk-split-all!)
  (dk-split-all! (list (dk-cite! 'cayley-inv-at u)))
  (let* ((w (list clk-ci u))
         (cw (clk-w-facts! u)))
    (let* ((ci (dk-cite! 'cayley-circle-iff w)))
      (dk-have! (list '= (list 'magnitude (list 'CAYLEY w)) 1)
        (lambda () (subst cw) (clk-finish-ass!)))
      (dk-have! (list '= (list 'imag-part w) 0) (lambda () (dk-only! ci (list '= (list 'magnitude (list 'CAYLEY w)) 1)) (prop))))
    (dk-cite! 'cc-real-of-im-zero w)
    (clk-finish-ass!)))
(qed 'cayley-inv-maps-circle)

(sp (make-wff '(FORALL z (IMPLIES (IN z UPPER-HALF-PLANE) (IN (CAYLEY z) (BALL CC-MS 0 1))))))
(let ((z (dk-di-var!)))
  (clk-consts!)
  (let ((m (dk-cite! 'upper-half-plane-membership z)))
    (dk-have! (caddr m) (lambda () (dk-only! m (list 'IN z 'UPPER-HALF-PLANE)) (prop)))
    (dk-split-all!))
  (dk-cite! 'imag-part-in-rr z)
  (dk-have! (list '<= 0 (list 'imag-part z)) (lambda () (dk-ineq! (list '< 0 (list 'imag-part z)))))
  (dk-cite! 'cayley-no-pole z)
  (let ((ca (dk-cite! 'cayley-at z)))
    (clk-type! (list '- z '+i)) (clk-type! (list '+ z '+i))
    (dk-cite! 'cc-div-closed (list '- z '+i) (list '+ z '+i))
    (dk-have! (list 'IN (list 'CAYLEY z) 'CC) (lambda () (subst ca) (clk-finish-ass!))))
  (let ((di_ (dk-cite! 'cayley-disc-iff z)))
    (dk-have! (list '< (list 'magnitude (list 'CAYLEY z)) 1) (lambda () (dk-only! di_ (list '< 0 (list 'imag-part z))) (prop))))
  (dk-cite! 'unit-disc-intro (list 'CAYLEY z))
  (clk-finish-ass!))
(qed 'cayley-maps-upper)

(sp (make-wff `(FORALL u (IMPLIES (IN u (BALL CC-MS 0 1)) (IN (,clk-ci u) UPPER-HALF-PLANE)))))
(let ((u (dk-di-var!)))
  (clk-consts!)
  (dk-split-all! (list (dk-cite! 'unit-disc-elim u)))
  (dk-have! (list 'NOT (list '= u 1))
    (lambda ()
      (di)
      (fact 'cc-magnitude-one)
      (dk-have! (list '= (list 'magnitude u) 1) (lambda () (subst (list '= u 1)) (clk-finish-ass!)))
      (dk-cite! 'cc-magnitude-closed u)
      (dk-have! '(< 1 1) (lambda () (dk-ineq! (list '= (list 'magnitude u) 1) (list '< (list 'magnitude u) 1))))
      (fact 'rr-one-in)
      (dk-cite! 'rr-lt-irrefl 1)
      (dk-only! '(< 1 1) '(NOT (< 1 1)))
      (prop)))
  (dk-split-all! (list (dk-cite! 'cayley-inv-at u)))
  (let* ((w (list clk-ci u))
         (cw (clk-w-facts! u)))
    (let ((di_ (dk-cite! 'cayley-disc-iff w)))
      (dk-have! (list '< (list 'magnitude (list 'CAYLEY w)) 1) (lambda () (subst cw) (clk-finish-ass!)))
      (dk-have! (list '< 0 (list 'imag-part w)) (lambda () (dk-only! di_ (list '< (list 'magnitude (list 'CAYLEY w)) 1)) (prop))))
    (let ((m (dk-cite! 'upper-half-plane-membership w)))
      (dk-only! m (list 'IN w 'CC) (list '< 0 (list 'imag-part w)))
      (prop))))
(qed 'cayley-inv-maps-disc)

;;; ---------------------------------------------------------------------------
;;; Prop. 1.21.

(define (clk-sep-set! def-thm const)    ; (IN CONST SET) for CONST == SEP over CC
  (fact 'cc-is-set)
  (let ((e (dk-cite! def-thm)))
    (subst (list '= const (caddr e)))
    (sep-set)
    (if (pair? (dk-open-leaves)) (clk-finish-ass!))))

(define (clk-set-closer! dom)
  (cond ((eq? dom 'RR) (fact 'rr-is-set) (clk-finish-ass!))
        ((eq? dom 'UPPER-HALF-PLANE) (clk-sep-set! 'upper-half-plane-def 'UPPER-HALF-PLANE))
        ((equal? dom '(BALL CC-MS 0 1)) (fact 'cc-is-metric-space) (dk-cite! 'ball-is-set 'CC-MS 0 1) (clk-finish-ass!))
        ((equal? dom clk-y1)
         (dk-have! '(IN UNIT-CIRCLE SET) (lambda () (clk-sep-set! 'unit-circle-def 'UNIT-CIRCLE)))
         (dk-cite! 'difference-set 'UNIT-CIRCLE '(SINGLETON 1))
         (clk-finish-ass!))
        (#t (error "clk-set-closer!: unknown domain" dom))))

(define (clk-in-cc-hat! v dom)          ; v in DOM in context: land v in CC-HAT
  (cond ((eq? dom 'RR) (dk-cite! 'rr-subset-cc v))
        ((eq? dom 'UPPER-HALF-PLANE)
         (let ((m (dk-cite! 'upper-half-plane-membership v)))
           (dk-have! (list 'IN v 'CC) (lambda () (dk-only! m (list 'IN v dom)) (prop)))))
        ((equal? dom '(BALL CC-MS 0 1)) (dk-split-all! (list (dk-cite! 'unit-disc-elim v))))
        ((equal? dom clk-y1)
         (let ((fs (clk-y1-iff! v)))
           (dk-have! (list 'IN v 'CC)
             (lambda () (dk-only! (car fs) (cadr fs) (list 'IN v dom)) (prop))))))
  (dk-cite! 'cc-in-cc-hat v))

(define (clk-bij! x y map-phi map-psi)
  (let* ((phi (list 'VNB-LAMBDA 'cxr_ x '(CAYLEY cxr_)))
         (psi (list 'VNB-LAMBDA 'cxu_ y (list clk-ci 'cxu_))))
    (clk-consts!)
    (dk-have! (list 'IN phi (list 'FUN x y))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-cite! map-phi v) (clk-finish-ass!)))
                               (lambda () (clk-set-closer! x)))))
    (dk-have! (list 'IN psi (list 'FUN y x))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-cite! map-psi v) (clk-finish-ass!)))
                               (lambda () (clk-set-closer! y)))))
    (let* ((inst (dk--fact-instance 'bijection-from-inverse (list x y phi psi)))
           (a3 (cadr inst))
           (a4 (cadr (caddr inst))))
      (dk-have! a3
        (lambda ()
          (let ((v (car (map cadr (dk-peel!)))))
            (dk-cite! map-phi v)
            (dk-lam-b!)
            (clk-in-cc-hat! v x)
            (dk-cite! 'cayley-inv-apply-left v)
            (clk-finish-ass!))))
      (dk-have! a4
        (lambda ()
          (let ((v (car (map cadr (dk-peel!)))))
            (dk-cite! map-psi v)
            (dk-lam-b!)
            (clk-in-cc-hat! v y)
            (dk-cite! 'cayley-inv-apply-right v)
            (clk-finish-ass!))))
      (dk-cite! 'bijection-from-inverse x y phi psi)
      (clk-finish-ass!))))

;;; C maps R bijectively onto T \ {1}.
(sp (make-wff (list 'IN '(VNB-LAMBDA cxr_ RR (CAYLEY cxr_)) (list 'BIJECTION 'RR clk-y1))))
(clk-bij! 'RR clk-y1 'cayley-maps-real 'cayley-inv-maps-circle)
(qed 'cayley-real-circle)

;;; C maps H+ bijectively onto D.
(sp (make-wff '(IN (VNB-LAMBDA cxr_ UPPER-HALF-PLANE (CAYLEY cxr_)) (BIJECTION UPPER-HALF-PLANE (BALL CC-MS 0 1)))))
(clk-bij! 'UPPER-HALF-PLANE '(BALL CC-MS 0 1) 'cayley-maps-upper 'cayley-inv-maps-disc)
(qed 'cayley-upper-disc)
