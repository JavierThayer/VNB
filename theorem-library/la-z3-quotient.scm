;;; (5) A ring as a module over itself; an ideal (a) as a submodule; Z/(a).
;;; =====================================================================
(define LZQ-RM '(RING-AS-MODULE R))
(define (lzq-ring-open!)                ; land the conjuncts of IS-RING(R)
  (let* ((iff (dk-cite! 'is-ring 'R))
         (rhs (dk-meta-iff-r! iff)))
    (dk-split-all! (list (dk-ctx-form rhs)))))
(define (lzq-rm-reduce!)                ; accessors of RING-AS-MODULE(R) in the goal, read off
  (for-each (lambda (acc) (if (lzq-has-head? acc (dk-goal)) (slot acc))) '(SCAL VEC VADD VZERO VNEG ACT))
  (if (dk--occurs? LZQ-RM (dk-goal)) (mac 'RING-AS-MODULE))
  (let loop ((fuel 20))
    (if (and (> fuel 0) (lzq-has-head? 'NTH (dk-goal)))
        (begin (nth-r) (loop (- fuel 1))))))
(define (lzq-ring-set!)                 ; (IN R SET), so the tuple RING-AS-MODULE(R) denotes
  (let ((iff (dk-meta-iff! 'ring-class 'R)))
    (dk-meta-iff-l! iff)
    (fact 'membership-implies-sethood 'R 'RING)))
(sp (make-wff '(FORALL R (IMPLIES (IS-RING R) (IS-MODULE (RING-AS-MODULE R))))))
(di) (di)
(lzq-ring-set!)
(lzq-ring-open!)
(for-each (lambda (n) (fact n 'R)) '(ring-left-dist ring-right-dist ring-mul-assoc ring-mul-left-id))
(mac 'IS-MODULE)
(lzq-rm-reduce!)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (len-r) (if (not (proof-done? *ps*)) (arith)))
            (#t (error "ring-as-module: unexpected conjunct" (expression->string g)))))))
(lzq-done! 'ring-as-module-is-module)
(gloss! 'ring-as-module-is-module "A ring is a module over itself, the action being the multiplication.")

(define LZQ-PI '(PRINCIPAL-IDEAL R a))
(define (lzq-pi-in! z r eq-thunk)       ; z, r in CARR R and z = r a (by EQ-THUNK) => z in (a)
  (let* ((iff (dk-meta-iff! 'principal-ideal-membership 'R 'a z))
         (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (begin (ew r)
                       (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq-thunk)))))
                (ass))))))
    (dk-meta-iff-l! iff)
    (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-asm? (dk-goal))) (ass))))
(define (lzq-pi-open! z)                ; z in (a) => z in CARR R, z = r a; returns r
  (let* ((iff (dk-meta-iff! 'principal-ideal-membership 'R 'a z))
         (rhs (dk-meta-iff-r! iff)))
    (dk-split-all! (list (dk-ctx-form rhs)))
    (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z))) (dk-asms)))))
(define (lzq-rcarr! t) (lz3q-rcarr! t))
(define (lz3q-rcarr! t)
  (let ((want (list 'IN t '(CARR R))))
    (cond ((dk-asm? want) #t)
          ((equal? t '(ZERO R)) (fact 'ring-zero-in 'R))
          ((equal? t '(ONE R)) (fact 'ring-one-in 'R))
          ((and (pair? t) (equal? (car t) '(ADD R)))
           (lz3q-rcarr! (cadr t)) (lz3q-rcarr! (caddr t)) (fact 'ring-add-closed 'R (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) '(MUL R)))
           (lz3q-rcarr! (cadr t)) (lz3q-rcarr! (caddr t)) (fact 'ring-carrier-closed-mul 'R (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) '(NEG R)))
           (lz3q-rcarr! (cadr t)) (fact 'ring-neg-in-carr 'R (cadr t)))
          (#t (error "lz3q-rcarr!: cannot type" (expression->string t))))))
(sp (make-wff '(FORALL R (IMPLIES (IS-COMMUTATIVE-RING R) (FORALL a (IMPLIES (IN a (CARR R))
  (IS-SUBMODULE (RING-AS-MODULE R) (PRINCIPAL-IDEAL R a))))))))
