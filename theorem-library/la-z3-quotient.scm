;;; la-z3-quotient.scm -- the quotient module E/F of a module by a submodule (LA-Z3,
;;; 2026-10-24).  Vocabulary: structure-library/la-z3-vocab (QMOD-REL, QMOD-SETOID,
;;; QUOTIENT-MODULE).  Prefix lzq-.
;;;
;;; PLAN (the recipe of SIP-QUOTIENT, theorem-library/sip-a.scm).
;;;  (1) The group algebra of a module that the congruence needs, from the axioms:
;;;      commutativity, the identity and the inverses on both sides, -(a+b) = -a + -b,
;;;      -(-a) = a, r(-u) = -(ru); and the six identities of differences d(x,y) = x + -y.
;;;  (2) x ~ y iff d(x,y) in F is an equivalence relation; QMOD-SETOID is a setoid.
;;;  (3) +, -, and each scalar's action respect ~; they descend and COMPUTE on classes.
;;;  (4) The module laws of E/F: lift each class to a representative, compute, cite the
;;;      law of E.  QUOTIENT-MODULE(md, sm) is a module (qmod-is-module).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; structure-library/la-z3-vocab, theorem-library/rake-setoid2 (class-eq-iff,
;;; descend-computes, rko2-related-unfold) and lastcoeff-ideal-proof (the
;;; module-vector-ag companions); nothing later is cited.

(define (lzq-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z3-quotient: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzq-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (lzq-has-head? h (car e)) (lzq-has-head? h (cdr e)))))
(define (lzq-mstmt body) (list 'FORALL 'md (list 'IMPLIES '(IS-MODULE md) body)))
(define (lzq-qstmt body)
  (list 'FORALL 'md (list 'IMPLIES '(IS-MODULE md) (list 'FORALL 'sm (list 'IMPLIES '(IS-SUBMODULE md sm) body)))))
(define (lzq-hdr2!) (di) (di))
(define (lzq-hdr4!) (di) (di) (di) (di))

;;; a PROJECTION of IS-MODULE
(define (lzq-project! name conj)
  (sp (make-wff (lzq-mstmt conj)))
  (lzq-hdr2!)
  (let ((u (dk-landed-1 (lambda () (mac-h 'IS-MODULE '(IS-MODULE md))))))
    (dk-split-all! (list u)))
  (ass)
  (lzq-done! name))
(lzq-project! 'lzq-vec-set '(IN (VEC md) SET))
(lzq-project! 'lzq-vadd-fun '(IN (VADD md) (FUN (CARTESIAN (VEC md) (VEC md)) (VEC md))))
(lzq-project! 'lzq-vneg-fun '(IN (VNEG md) (FUN (VEC md) (VEC md))))
(lzq-project! 'lzq-act-fun '(IN (ACT md) (FUN (CARTESIAN (CARR (SCAL md)) (VEC md)) (VEC md))))
(lzq-project! 'lzq-comm-prop '(is-commutative (VADD md) (VEC md)))
(lzq-project! 'lzq-ident-prop '(is-identity (VADD md) (VZERO md) (VEC md)))
(lzq-project! 'lzq-inv-prop '(has-inverses (VADD md) (VZERO md) (VNEG md) (VEC md)))

;;; type a vector expression of md (VADD, VNEG, VZERO, ACT at a scalar typed in context)
(define (lzq-vt x)
  (let ((want (list 'IN x '(VEC md))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO md)) (dk-cite! 'module-vzero-in 'md) x)
          ((and (pair? x) (equal? (car x) '(VADD md)))
           (lzq-vt (cadr x)) (lzq-vt (caddr x))
           (dk-cite! 'module-vadd-type 'md (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG md)))
           (lzq-vt (cadr x))
           (dk-cite! 'module-vneg-type 'md (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT md)))
           (lzq-vt (caddr x))
           (dk-cite! 'module-act-type 'md (cadr x) (caddr x)) x)
          (#t (error "lzq-vt: cannot type" (expression->string x))))))
(define (lzq-add a b) (list '(VADD md) a b))
(define (lzq-neg a) (list '(VNEG md) a))
(define (lzq-d a b) (lzq-add a (lzq-neg b)))
;;; rewrite the goal by the equation THM(ARGS), after typing the vector arguments
(define (lzq-rw! thm . args)
  (for-each (lambda (a) (if (and (pair? a) (not (equal? (car a) '(ONE (SCAL md))))) (vnb-guard (lambda () (lzq-vt a))))) args)
  (subst (apply dk-cite! thm 'md args)))

;;; ---- (1) group algebra ----------------------------------------------------------------
(define (lzq-law! name vars body thunk)
  (sp (make-wff (lzq-mstmt (forall-guarded vars (map (lambda (v) (list 'IN v '(VEC md))) vars) body))))
  (dk-peel!)
  (thunk)
  (lzq-done! name))
;; close the goal: in context, or (= t t) with t a typed vector term
(define (lzq-fin!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (lzq-vt (cadr g)) (rfl))
          (#t (error "lzq-fin!: cannot close" (expression->string g))))))
;; unfold the operation property THM(md) in context; return the unfolded formula
(define (lzq-prop! thm unfold)
  (let ((h0 (dk-fact! thm 'md)))
    (dk-landed-1 (lambda () (mac-h unfold h0)))))
(lzq-law! 'lzq-vadd-comm '(x_ y_) '(= ((VADD md) x_ y_) ((VADD md) y_ x_))
  (lambda ()
    (let ((h (lzq-prop! 'lzq-comm-prop 'is-commutative)))
      (dk-apply! h 'x_ 'y_)
      (ass))))
(lzq-law! 'lzq-vzero-l '(x_) '(= ((VADD md) (VZERO md) x_) x_)
  (lambda ()
    (let ((h (lzq-prop! 'lzq-ident-prop 'is-identity)))
      (dk-split! (dk-apply! h 'x_))
      (ass))))
(lzq-law! 'lzq-inv-r '(x_) '(= ((VADD md) x_ ((VNEG md) x_)) (VZERO md))
  (lambda ()
    (let ((h (lzq-prop! 'lzq-inv-prop 'has-inverses)))
      (dk-split! (dk-apply! h 'x_))
      (ass))))
(lzq-law! 'lzq-inv-l '(x_) '(= ((VADD md) ((VNEG md) x_) x_) (VZERO md))
  (lambda ()
    (let ((h (lzq-prop! 'lzq-inv-prop 'has-inverses)))
      (dk-split! (dk-apply! h 'x_))
      (ass))))
;; -(a+b) = -a + -b
(lzq-law! 'lzq-neg-sum '(a_ b_) '(= ((VNEG md) ((VADD md) a_ b_)) ((VADD md) ((VNEG md) a_) ((VNEG md) b_)))
  (lambda ()
    (let* ((s (lzq-add 'a_ 'b_)) (t (lzq-add (lzq-neg 'a_) (lzq-neg 'b_))))
      (lzq-vt s) (lzq-vt t)
      (dk-have! (list '= (lzq-add s t) '(VZERO md))
        (lambda ()
          (lzq-rw! 'abelian-group-assoc-module-vector-ag 'a_ 'b_ t)
          (dk-cite! 'abelian-group-assoc-module-vector-ag 'md 'b_ (lzq-neg 'a_) (lzq-neg 'b_))
          (subst (list '= (lzq-add 'b_ t) (lzq-add (lzq-add 'b_ (lzq-neg 'a_)) (lzq-neg 'b_))))
          (lzq-rw! 'lzq-vadd-comm 'b_ (lzq-neg 'a_))
          (lzq-rw! 'abelian-group-assoc-module-vector-ag (lzq-neg 'a_) 'b_ (lzq-neg 'b_))
          (lzq-rw! 'lzq-inv-r 'b_)
          (lzq-rw! 'abelian-group-right-id-module-vector-ag (lzq-neg 'a_))
          (lzq-rw! 'lzq-inv-r 'a_)
          (lzq-fin!)))
      (let ((e (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'md s t)))
        (subst e)
        (lzq-vt (lzq-neg s))
        (rfl)))))
(lzq-law! 'lzq-neg-neg '(a_) '(= ((VNEG md) ((VNEG md) a_)) a_)
  (lambda ()
    (lzq-vt (lzq-neg 'a_))
    (fact 'lzq-inv-l 'md 'a_)
    (let ((e (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'md (lzq-neg 'a_) 'a_)))
      (subst (list '= (lzq-neg (lzq-neg 'a_)) 'a_))
      (lzq-fin!))))
;; r(-u) = -(r u)
(sp (make-wff (lzq-mstmt (forall-guarded '(r_ u_) '((IN r_ (CARR (SCAL md))) (IN u_ (VEC md)))
  '(= ((ACT md) r_ ((VNEG md) u_)) ((VNEG md) ((ACT md) r_ u_)))))))
(dk-peel!)
(let ((ru '((ACT md) r_ u_)) (rnu '((ACT md) r_ ((VNEG md) u_))))
  (lzq-vt ru) (lzq-vt rnu)
  (dk-have! (list '= (lzq-add ru rnu) '(VZERO md))
    (lambda ()
      (lzq-vt (lzq-neg 'u_))
      (dk-cite! 'module-act-distrib-vec 'md 'r_ 'u_ (lzq-neg 'u_))
      (subst (list '= (lzq-add ru rnu) (list '(ACT md) 'r_ (lzq-add 'u_ (lzq-neg 'u_)))))
      (lzq-rw! 'lzq-inv-r 'u_)
      (subst (dk-cite! 'module-act-zero-vec 'md 'r_))
      (lzq-fin!)))
  (subst (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'md ru rnu))
  (lzq-fin!))
(lzq-done! 'lzq-act-neg)

;;; ---- the six identities of differences ------------------------------------------------
(lzq-law! 'lzq-d-refl '(x_) (list '= (lzq-d 'x_ 'x_) '(VZERO md))
  (lambda () (fact 'lzq-inv-r 'md 'x_) (ass)))
(lzq-law! 'lzq-d-sym '(x_ y_) (list '= (lzq-d 'y_ 'x_) (lzq-neg (lzq-d 'x_ 'y_)))
  (lambda ()
    (lzq-rw! 'lzq-neg-sum 'x_ (lzq-neg 'y_))
    (lzq-rw! 'lzq-neg-neg 'y_)
    (lzq-rw! 'lzq-vadd-comm (lzq-neg 'x_) 'y_)
    (lzq-fin!)))
(lzq-law! 'lzq-d-trans '(x_ y_ z_) (list '= (lzq-d 'x_ 'z_) (lzq-add (lzq-d 'x_ 'y_) (lzq-d 'y_ 'z_)))
  (lambda ()
    (lzq-rw! 'abelian-group-assoc-module-vector-ag 'x_ (lzq-neg 'y_) (lzq-d 'y_ 'z_))
    (lzq-vt (lzq-neg 'z_))
    (dk-cite! 'abelian-group-assoc-module-vector-ag 'md (lzq-neg 'y_) 'y_ (lzq-neg 'z_))
    (subst (list '= (lzq-add (lzq-neg 'y_) (lzq-d 'y_ 'z_)) (lzq-add (lzq-add (lzq-neg 'y_) 'y_) (lzq-neg 'z_))))
    (lzq-rw! 'lzq-inv-l 'y_)
    (lzq-rw! 'lzq-vzero-l (lzq-neg 'z_))
    (lzq-fin!)))
(lzq-law! 'lzq-d-vadd '(x_ y_ u_ w_)
  (list '= (lzq-d (lzq-add 'x_ 'y_) (lzq-add 'u_ 'w_)) (lzq-add (lzq-d 'x_ 'u_) (lzq-d 'y_ 'w_)))
  (lambda ()
    (let ((nu (lzq-neg 'u_)) (nw (lzq-neg 'w_)))
      (lzq-vt nu) (lzq-vt nw)
      (lzq-rw! 'lzq-neg-sum 'u_ 'w_)
      ;; (x + y) + (-u + -w) = x + (y + (-u + -w)) = x + ((y + -u) + -w) = x + ((-u + y) + -w)
      ;;   = x + (-u + (y + -w)) = (x + -u) + (y + -w)
      (lzq-rw! 'abelian-group-assoc-module-vector-ag 'x_ 'y_ (lzq-add nu nw))
      (dk-cite! 'abelian-group-assoc-module-vector-ag 'md 'y_ nu nw)
      (subst (list '= (lzq-add 'y_ (lzq-add nu nw)) (lzq-add (lzq-add 'y_ nu) nw)))
      (lzq-rw! 'lzq-vadd-comm 'y_ nu)
      (lzq-rw! 'abelian-group-assoc-module-vector-ag nu 'y_ nw)
      (lzq-vt (lzq-add 'y_ nw))
      (dk-cite! 'abelian-group-assoc-module-vector-ag 'md 'x_ nu (lzq-add 'y_ nw))
      (subst (list '= (lzq-add 'x_ (lzq-add nu (lzq-add 'y_ nw))) (lzq-add (lzq-add 'x_ nu) (lzq-add 'y_ nw))))
      (lzq-fin!))))
(lzq-law! 'lzq-d-vneg '(x_ u_) (list '= (lzq-d (lzq-neg 'x_) (lzq-neg 'u_)) (lzq-neg (lzq-d 'x_ 'u_)))
  (lambda ()
    (lzq-rw! 'lzq-neg-sum 'x_ (lzq-neg 'u_))
    (lzq-fin!)))
(sp (make-wff (lzq-mstmt (forall-guarded '(r_ x_ u_) '((IN r_ (CARR (SCAL md))) (IN x_ (VEC md)) (IN u_ (VEC md)))
  (list '= (lzq-d '((ACT md) r_ x_) '((ACT md) r_ u_)) (list '(ACT md) 'r_ (lzq-d 'x_ 'u_)))))))
(dk-peel!)
(lzq-vt (lzq-neg 'u_))
(subst (dk-cite! 'module-act-distrib-vec 'md 'r_ 'x_ (lzq-neg 'u_)))
(lzq-rw! 'lzq-act-neg 'r_ 'u_)
(lzq-fin!)
(lzq-done! 'lzq-d-act)

;;; ---- the submodule's closure, read off IS-SUBMODULE ----------------------------------
(define (lzq-sub-open!)                 ; land the conjuncts of IS-SUBMODULE(md, sm)
  (let* ((iff (dk-cite! 'is-submodule 'md 'sm))
         (rhs (caddr iff)))
    (if (not (dk-asm? rhs))
        (dk-have! rhs (dk-lane (lambda () (dk-only! iff '(IS-SUBMODULE md sm)) (dk-lane-if! prop)))))
    (dk-split-all! (list (dk-ctx-form rhs)))))
(define (lzq-sub-find pred) (find-first pred (dk-asms)))
(define (lzq-sub-zero!) '(IN (VZERO md) sm))
(define LZQ-ADDCL '(FORALL x_ (IMPLIES (IN x_ sm) (FORALL y_ (IMPLIES (IN y_ sm) (IN ((VADD md) x_ y_) sm))))))
(define LZQ-NEGCL '(FORALL x_ (IMPLIES (IN x_ sm) (IN ((VNEG md) x_) sm))))
(define LZQ-ACTCL '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL md))) (FORALL x_ (IMPLIES (IN x_ sm) (IN ((ACT md) r_ x_) sm))))))
(define (lzq-in-sm-add! a b) (dk-apply! LZQ-ADDCL a b))   ; a, b in sm => a + b in sm
(define (lzq-in-sm-neg! a) (dk-apply! LZQ-NEGCL a))
(define (lzq-in-sm-act! r a) (dk-apply! LZQ-ACTCL r a))
(define (lzq-vec-of-sm! a)              ; a in sm => a in VEC md
  (let ((sb (lzq-sub-find (lambda (f) (and (dk-head-is? f 'SUBSET) (equal? (cadr f) 'sm))))))
    (if (not (dk-asm? (list 'IN a '(VEC md))))
        (let ((ss (dk-landed-1 (lambda () (mac-h 'subset-def sb)))))
          (dk-apply! ss a)))))

;;; =====================================================================
;;; (2) The setoid: x ~ y iff x + (-y) lies in sm.
;;; =====================================================================
(define LZQ-REL '(QMOD-REL md sm))
(define LZQ-S '(QMOD-SETOID md sm))
(define (lzq-ins t) (list 'IN t 'sm))

(sp (make-wff '(FORALL md (FORALL sm (== (QMOD-REL md sm)
  (SEP qmp_ (CARTESIAN (VEC md) (VEC md))
     (IN ((VADD md) (NTH 1 qmp_) ((VNEG md) (NTH 2 qmp_))) sm)))))))
(di)
(mac 'QMOD-REL)
(qrfl)
(lzq-done! 'qmod-rel-unfold)

(sp (make-wff (lzq-qstmt (forall-guarded '(a_ b_) '((IN a_ (VEC md)) (IN b_ (VEC md)))
  (list 'IMPLIES (lzq-ins (lzq-d 'a_ 'b_)) (list 'IN '(LIST a_ b_) LZQ-REL))))))
(dk-peel!)
(mac 'QMOD-REL)
(in-sep! (lambda () (fact 'pair-in-cartesian '(VEC md) '(VEC md) 'a_ 'b_) (ass))
         (lambda () (nth-r) (ass)))
(lzq-done! 'qmod-rel-in)

(sp (make-wff (lzq-qstmt (list 'FORALL 'a_ (list 'FORALL 'b_
  (list 'IMPLIES (list 'IN '(LIST a_ b_) LZQ-REL) (lzq-ins (lzq-d 'a_ 'b_))))))))
(dk-peel!)
(let* ((h  (dk-landed-1 (lambda () (mac-h 'qmod-rel-unfold (list 'IN '(LIST a_ b_) LZQ-REL)))))
       (ls (dk-landed (lambda () (sep-me h))))
       (c  (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'sm))) ls)
               (error "qmod-rel-out: no condition landed"))))
  (dk-nth-h! c))
(ass)
(lzq-done! 'qmod-rel-out)

(sp (make-wff (lzq-qstmt '(is-equivalence (QMOD-REL md sm) (VEC md)))))
(lzq-hdr4!)
(fact 'lzq-vec-set 'md)
(lzq-sub-open!)
(mac 'is-equivalence)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
          (begin
            (mac 'QMOD-REL)
            (mac 'power-set-membership)
            (dk-conj-close!
              (lambda ()
                (let ((g2 (dk-goal)))
                  (if (and (dk-head-is? g2 'IN) (eq? (caddr g2) 'SET))
                      (begin (sep-set)
                             (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                 (begin (mac 'cartesian-set-iff)
                                        (dk-conj-close! (lambda () (ass))))))
                      (let* ((lk (dk-peel!))
                             (h (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f))
                                                                 (eq? (car (caddr f)) 'SEP))) lk)
                                    (error "qmod-rel-is-equivalence: no SEP membership"))))
                        (sep-me h)
                        (ass)))))))
          (let* ((lk (dk-peel!))
                 (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC md)))) lk))))
            (cond
              ((= (length vs) 1)
               (let ((u (car vs)))
                 (fact 'lzq-d-refl 'md u)
                 (dk-have! (lzq-ins (lzq-d u u)) (lambda () (subst (list '= (lzq-d u u) '(VZERO md))) (ass)))
                 (fact 'qmod-rel-in 'md 'sm u u)
                 (ass)))
              ((= (length vs) 2)
               (let ((u (car vs)) (w (cadr vs)))
                 (fact 'qmod-rel-out 'md 'sm u w)
                 (lzq-vt (lzq-d u w))
                 (lzq-in-sm-neg! (lzq-d u w))
                 (fact 'lzq-d-sym 'md u w)
                 (dk-have! (lzq-ins (lzq-d w u))
                   (lambda () (subst (list '= (lzq-d w u) (lzq-neg (lzq-d u w)))) (ass)))
                 (fact 'qmod-rel-in 'md 'sm w u)
                 (ass)))
              (#t
               (let ((u (car vs)) (m (cadr vs)) (w (caddr vs)))
                 (dk-split-all!)
                 (fact 'qmod-rel-out 'md 'sm u m)
                 (fact 'qmod-rel-out 'md 'sm m w)
                 (lzq-in-sm-add! (lzq-d u m) (lzq-d m w))
                 (fact 'lzq-d-trans 'md u m w)
                 (dk-have! (lzq-ins (lzq-d u w))
                   (lambda () (subst (list '= (lzq-d u w) (lzq-add (lzq-d u m) (lzq-d m w)))) (ass)))
                 (fact 'qmod-rel-in 'md 'sm u w)
                 (ass)))))))))
(lzq-done! 'qmod-rel-is-equivalence)

(sp (make-wff (lzq-qstmt '(IS-SETOID (QMOD-SETOID md sm)))))
(lzq-hdr4!)
(fact 'lzq-vec-set 'md)
(fact 'qmod-rel-is-equivalence 'md 'sm)
(mac 'IS-SETOID)
(slot 'pts)
(slot 'rel)
(mac 'QMOD-SETOID)
(nth-r)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
             (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
            ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
             (let ((h (dk-pick (lambda (f) (dk-head-is? f 'is-equivalence)) "the equivalence")))
               (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-EQUIVALENCE h)))))
               (ass)))
            (#t (error "qmod-setoid-is-setoid: unexpected conjunct" (expression->string g)))))))
(lzq-done! 'qmod-setoid-is-setoid)

(sp (make-wff (lzq-qstmt '(== (PTS (QMOD-SETOID md sm)) (VEC md)))))
(lzq-hdr4!)
(slot 'PTS)
(mac 'QMOD-SETOID)
(nth-r)
(qrfl)
(lzq-done! 'qmod-setoid-pts)

(sp (make-wff (lzq-qstmt '(== (REL (QMOD-SETOID md sm)) (QMOD-REL md sm)))))
(lzq-hdr4!)
(slot 'REL)
(mac 'QMOD-SETOID)
(nth-r)
(qrfl)
(lzq-done! 'qmod-setoid-rel)

(sp (make-wff (lzq-qstmt (list 'FORALL 'a_ (list 'FORALL 'b_ (list 'IMPLIES '(RELATED (QMOD-SETOID md sm) a_ b_)
  (lzq-ins (lzq-d 'a_ 'b_))))))))
(dk-peel!)
(mac-h 'rko2-related-unfold '(RELATED (QMOD-SETOID md sm) a_ b_))
(mac-h 'qmod-setoid-rel '(IN (LIST a_ b_) (REL (QMOD-SETOID md sm))))
(fact 'qmod-rel-out 'md 'sm 'a_ 'b_)
(ass)
(lzq-done! 'qmod-related-out)

(sp (make-wff (lzq-qstmt (forall-guarded '(a_ b_) '((IN a_ (VEC md)) (IN b_ (VEC md)))
  (list 'IMPLIES (lzq-ins (lzq-d 'a_ 'b_)) '(RELATED (QMOD-SETOID md sm) a_ b_))))))
(dk-peel!)
(mac 'RELATED)
(mac 'qmod-setoid-rel)
(fact 'qmod-rel-in 'md 'sm 'a_ 'b_)
(ass)
(lzq-done! 'qmod-related-in)

(sp (make-wff (lzq-qstmt (forall-guarded '(a_ b_) '((IN a_ (VEC md)) (IN b_ (VEC md)))
  (list 'IFF '(= (CLASS (QMOD-SETOID md sm) a_) (CLASS (QMOD-SETOID md sm) b_)) (lzq-ins (lzq-d 'a_ 'b_)))))))
(dk-peel!)
(fact 'qmod-setoid-is-setoid 'md 'sm)
(dk-have! '(IN a_ (PTS (QMOD-SETOID md sm))) (lambda () (mac 'qmod-setoid-pts) (ass)))
(dk-have! '(IN b_ (PTS (QMOD-SETOID md sm))) (lambda () (mac 'qmod-setoid-pts) (ass)))
(fact 'class-eq-iff LZQ-S 'a_ 'b_)
(fact 'qmod-related-out 'md 'sm 'a_ 'b_)
(fact 'qmod-related-in 'md 'sm 'a_ 'b_)
(let ((iff (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (dk-head-is? (caddr f) 'RELATED))) "the class-eq iff"))
      (o (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (cadr f) 'RELATED))) "related-out"))
      (i (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'RELATED))) "related-in")))
  (dk-only! iff o i)
  (prop))
(lzq-done! 'qmod-class-eq-iff)

;;; =====================================================================
;;; (3) The quotient.  S = QMOD-SETOID(md, sm), Q = QUOTIENT(S), QS = QUOTIENT-MODULE(md, sm).
