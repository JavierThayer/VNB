;;; =====================================================================
;;; (4) The quotient is a module.
;;; =====================================================================
(define lzq-ro-names '(qmod-ro-scal qmod-ro-vec qmod-ro-vadd qmod-ro-vzero qmod-ro-vneg qmod-ro-act))
(define (lzq-readoffs!)
  (lzq-components!)
  (for-each (lambda (n) (fact n 'md 'sm)) lzq-ro-names)
  (for-each (lambda (acc val) (if (lzq-has-head? acc (dk-goal)) (subst (list '= (list acc LZQ-QS) val))))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list '(SCAL md) LZQ-Q '(QMOD-VADD md sm) (lzq-cl '(VZERO md)) '(QMOD-VNEG md sm) '(QMOD-ACT md sm))))
(define (lzq-simple! name conj closer)
  (sp (make-wff (lzq-qstmt conj)))
  (lzq-hdr4!)
  (lzq-readoffs!)
  (closer)
  (lzq-done! name))
(lzq-simple! 'qmod-length '(= (LENGTH (QUOTIENT-MODULE md sm)) 6)
  (lambda () (mac 'QUOTIENT-MODULE) (len-r) (if (not (proof-done? *ps*)) (arith))))
(lzq-simple! 'qmod-scal-ring '(IS-RING (SCAL (QUOTIENT-MODULE md sm))) (lambda () (ass)))
(lzq-simple! 'qmod-vec-set '(IN (VEC (QUOTIENT-MODULE md sm)) SET) (lambda () (ass)))
(lzq-simple! 'qmod-vzero-in '(IN (VZERO (QUOTIENT-MODULE md sm)) (VEC (QUOTIENT-MODULE md sm))) (lambda () (ass)))
(lzq-simple! 'qmod-vadd-fun
  '(IN (VADD (QUOTIENT-MODULE md sm)) (FUN (CARTESIAN (VEC (QUOTIENT-MODULE md sm)) (VEC (QUOTIENT-MODULE md sm))) (VEC (QUOTIENT-MODULE md sm))))
  (lambda () (ass)))
(lzq-simple! 'qmod-vneg-fun
  '(IN (VNEG (QUOTIENT-MODULE md sm)) (FUN (VEC (QUOTIENT-MODULE md sm)) (VEC (QUOTIENT-MODULE md sm))))
  (lambda () (ass)))
(lzq-simple! 'qmod-act-fun
  '(IN (ACT (QUOTIENT-MODULE md sm)) (FUN (CARTESIAN (CARR (SCAL (QUOTIENT-MODULE md sm))) (VEC (QUOTIENT-MODULE md sm))) (VEC (QUOTIENT-MODULE md sm))))
  (lambda () (ass)))

(define (lzq-law-open!)
  (lzq-hdr4!)
  (lzq-components!)
  (lzq-sub-open!)
  (for-each (lambda (n) (fact n 'md 'sm)) lzq-ro-names)
  (for-each (lambda (n) (fact n 'md 'sm))
            '(qmod-scal-ring qmod-vec-set qmod-vzero-in qmod-vadd-fun qmod-vneg-fun qmod-act-fun)))
(define (lzq-lift-var! u)
  (dk-have! (list 'IN u LZQ-Q) (lambda () (subst (list '= LZQ-Q (list 'VEC LZQ-QS))) (ass)))
  (let* ((ex (dk-cite! 'quotient-rep LZQ-S u))
         (a  (dk-skolem! ex)))
    (dk-have! (list 'IN a '(VEC md)) (lambda () (subst (list '= '(VEC md) LZQ-PTS)) (ass)))
    (subst (list '= u (lzq-cl a)))
    a))
(define (lzq-lift-scalar! r)
  (dk-have! (list 'IN r '(CARR (SCAL md))) (lambda () (subst (list '= '(SCAL md) (list 'SCAL LZQ-QS))) (ass)))
  r)
(define (lzq-scalar! t)
  (let ((in-c (list 'IN t '(CARR (SCAL md)))))
    (cond ((dk-asm? in-c) #t)
          ((and (pair? t) (equal? (car t) '(ADD (SCAL md))))
           (lzq-scalar! (cadr t)) (lzq-scalar! (caddr t))
           (dk-cite! 'ring-add-closed '(SCAL md) (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) '(MUL (SCAL md))))
           (lzq-scalar! (cadr t)) (lzq-scalar! (caddr t))
           (dk-cite! 'ring-carrier-closed-mul '(SCAL md) (cadr t) (caddr t)))
          ((equal? t '(ONE (SCAL md))) (dk-cite! 'ring-one-in '(SCAL md)))
          (#t (error "lzq-scalar!: cannot type" (expression->string t))))))
(define (lzq-class? e) (and (pair? e) (eq? (car e) 'CLASS) (equal? (cadr e) LZQ-S)))
(define (lzq-redex e)
  (if (not (pair? e))
      #f
      (or (let loop ((xs e)) (cond ((not (pair? xs)) #f) ((lzq-redex (car xs))) (#t (loop (cdr xs)))))
          (let ((h (car e)))
            (cond ((and (equal? h (list 'VADD LZQ-QS)) (= (length e) 3) (lzq-class? (cadr e)) (lzq-class? (caddr e))) e)
                  ((and (equal? h (list 'VNEG LZQ-QS)) (= (length e) 2) (lzq-class? (cadr e))) e)
                  ((and (equal? h (list 'ACT LZQ-QS)) (= (length e) 3) (lzq-class? (caddr e))) e)
                  (#t #f))))))
(define (lzq-norm!)
  (if (lzq-has-head? 'SCAL (dk-goal)) (vnb-guard (lambda () (subst (list '= (list 'SCAL LZQ-QS) '(SCAL md))))))
  (if (dk--occurs? (list 'VZERO LZQ-QS) (dk-goal)) (subst (list '= (list 'VZERO LZQ-QS) (lzq-cl '(VZERO md)))))
  (let loop ((fuel 40))
    (let ((rx (lzq-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let* ((h (car (car rx)))
                 (eqn (case h
                        ((VADD) (lzq-vt (caddr (cadr rx))) (lzq-vt (caddr (caddr rx)))
                                (dk-cite! 'qmod-vadd-computes 'md 'sm (caddr (cadr rx)) (caddr (caddr rx))))
                        ((VNEG) (lzq-vt (caddr (cadr rx)))
                                (dk-cite! 'qmod-vneg-computes 'md 'sm (caddr (cadr rx))))
                        ((ACT)  (lzq-scalar! (cadr rx)) (lzq-vt (caddr (caddr rx)))
                                (dk-cite! 'qmod-act-computes 'md 'sm (cadr rx) (caddr (caddr rx))))
                        (else (error "lzq-norm!: unexpected redex" rx)))))
            (subst eqn)
            (loop (- fuel 1)))))))
(define (lzq-close-class-eq!)
  (let* ((leaf (proof-state-focus *ps*))
         (g (dk-goal)) (t1 (caddr (cadr g))) (t2 (caddr (caddr g)))
         (eqs (filter (lambda (f) (dk-head-is? f '=)) (dk-asms)))
         (nbrs (lambda (t) (append (map caddr (filter (lambda (f) (equal? (cadr f) t)) eqs))
                                   (map cadr (filter (lambda (f) (equal? (caddr f) t)) eqs))))))
    (let ((path (let search ((t t1) (d 0) (seen (list t1)))
                  (cond ((equal? t t2) '())
                        ((> d 2) #f)
                        (#t (let try ((ns (nbrs t)))
                              (cond ((null? ns) #f)
                                    ((member (car ns) seen) (try (cdr ns)))
                                    (#t (let ((p (search (car ns) (+ d 1) (cons (car ns) seen))))
                                          (if p (cons (cons t (car ns)) p) (try (cdr ns))))))))))))
      (if (not path) (error "lzq-close-class-eq!: no chain from" (expression->string t1) 'to (expression->string t2)))
      (for-each (lambda (st) (if (not (sequent-node-grounded? leaf)) (subst (list '= (car st) (cdr st))))) path)
      (if (not (sequent-node-grounded? leaf))
