(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'SUBSET)
         (mac 'subset-def)
         (let* ((ld (dk-peel!)) (z (cadr (car ld))))
           (lzq-pi-open! z)
           (ass)))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) '(ZERO R)))
         (lzq-pi-in! '(ZERO R) '(ZERO R)
           (lambda () (subst (dk-cite! 'ring-mul-zero-left 'R 'a)) (rfl))))
        (#t
         (let* ((ld (dk-peel!))
                (zs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZQ-PI))) ld)))
                (cs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR R)))) ld)))
                (rs (map (lambda (z) (lzq-pi-open! z)) zs))
                (w (cadr (dk-goal))))
           (for-each lz3q-rcarr! rs)
           (let ((r (cond ((= (length zs) 2) (list '(ADD R) (car rs) (cadr rs)))
                          ((pair? cs) (list '(MUL R) (car cs) (car rs)))
                          (#t (list '(NEG R) (car rs))))))
             (lz3q-rcarr! r)
             (lz3q-rcarr! w)
             (lzq-pi-in! w r
               (lambda ()
                 (for-each (lambda (z rr) (subst (list '= z (list '(MUL R) rr 'a)))) zs rs)
                 (crs))))))))))
(lzq-done! 'principal-ideal-is-submodule)
(gloss! 'principal-ideal-is-submodule "In a commutative ring R the principal ideal (a) is a submodule of R as a module over itself.")

