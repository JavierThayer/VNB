(sp (make-wff (lzq-qstmt (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ (CARR (SCAL md)))
  (list 'IN (lzq-lsc 'r_) (list 'FUN LZQ-PTS LZQ-Q)))))))
(dk-peel!)
