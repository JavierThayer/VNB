(subst (list '= LZQ-PTS '(VEC md)))
(dk-lam-type! lzq-lam-typer!)
(lzq-done! 'qmod-lsc-fun)

;;; goal (= [T1] [T2]) with T1 - T2 in sm in context
(define (lzq-class-eq!)
  (let* ((g (dk-goal)) (t1 (caddr (cadr g))) (t2 (caddr (caddr g))))
    (lzq-vt t1) (lzq-vt t2)
    (let ((iff (dk-cite! 'qmod-class-eq-iff 'md 'sm t1 t2))
          (in (lzq-ins (lzq-d t1 t2))))
