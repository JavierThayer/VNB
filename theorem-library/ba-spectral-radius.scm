;;; ba-spectral-radius.scm -- BANACH ALGEBRAS: Proposition 1.8 of Thayer's notes,
;;; sigma(x) lies in the closed disc of radius rho(x) = lim ||x^n||^(1/n), and the resolvent set
;;; CC \ sigma(x) is open.
;;; Agent BA-1F, wave 2026-11-09.  Destination: theorem-library/ba-spectral-radius.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: bsr-.
;;;
;;; ROUTE for 1.8 (no root test, no Laurent series).  If rho(x) < |z|, the infimum gives a k >= 1
;;; with ||x^k||^(1/k) < |z|, so ||x^k|| < |z|^k.  With y = z^(-1) x, y^k = z^(-k) x^k
;;; (bsr-el-pow-act) has norm < 1, so 1 - y^k is invertible (neumann-series).  The Neumann partial
;;; sum S_k commutes with 1 - y and (1 - y) S_k = S_k (1 - y) = 1 - y^k (ban-nsum-left / -right), so
;;; 1 - y has a left and a right inverse (bsr-one-minus-pow-invertible), and z 1 - x = z (1 - y) is
;;; invertible (brv-shift-factor, bas-act-invertible).
;;;
;;; LOAD WINDOW: after ba-fekete and fekete (BA-1C: SPECTRAL-RADIUS read as an infimum, fek-root-lt),
;;; ba-resolvent (BA-1B: brv-shift-factor, resolvent-continuous), ba-neumann and ba-spectrum (BA-1);
;;; einf-lt-witness (outer-measure-construction), rmc-rps-of-nonneg (riesz-markov-cantor),
;;; rps-below-real-is-real (lp-convergence), aif-magnitude-recip (analytic-from-integral).

(define (bsr-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-spectral-radius: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-spectral-radius: unfinished" name))))

(define (bsr-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bsr-m x y) (list '(VMUL a) x y))
(define (bsr-ad x y) (list '(VADD a) x y))
(define (bsr-ng x) (list '(VNEG a) x))
(define (bsr-sb x y) (bsr-ad x (bsr-ng y)))
(define (bsr-nr x) (list '(VNRM a) x))
(define (bsr-ac z x) (list '(ACT a) z x))
(define (bsr-inv x) (list 'INVERSE-EL 'a x))
(define (bsr-p x n) (list 'EL-POW 'a x n))
(define (bsr-s x n) (list 'NEUMANN-SUM 'a x n))
(define bsr-one '(VONE a))
(define bsr-zero '(VZERO a))
(define (bsr-rw! from to) (subst (list '= from to)))
(define (bsr-pin!) (dk-cite! 'bal-uba-scal-pin 'a))
(define (bsr-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (bsr-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))

(define (bsr-cc! t)                       ; type a CC term built from + - * recip POWER of typed atoms
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bsr-cc! (cadr t)) (bsr-cc! (caddr t)) (bsr-cite2! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bsr-cc! (cadr t)) (bsr-cc! (caddr t)) (bsr-cite2! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bsr-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'recip))
         (bsr-cc! (cadr t)) (bsr-cite2! 'cc-recip-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (bsr-cc! (cadr t)) (bsr-cite2! 'power-typing-nonneg (cadr t) (caddr t)) t)
        ((member t '(0 1)) (dk-cite! (if (equal? t 0) 'cc-zero-in 'cc-one-in)) t)
        (#t (error "bsr-cc!: cannot type" (expression->string t)))))

(define (bsr-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bsr-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bsr-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bsr-vt (cadr x)) (bsr-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bsr-vt (cadr x)) (bsr-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bsr-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bsr-cc! (cadr x)) (bsr-vt (caddr x))
           (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'SHIFT-EL))
           (bsr-cc! (caddr x)) (bsr-vt (cadddr x))
           (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          ((and (pair? x) (eq? (car x) 'NEUMANN-SUM))
           (bsr-vt (caddr x))
           (dk-cite! 'ban-nsum-type (cadddr x) 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'EL-POW))
           (bsr-vt (caddr x))
           (dk-cite! 'bae-el-pow-type (cadddr x) 'a (caddr x)) x)
          (#t (error "bsr-vt: cannot type" (expression->string x))))))

(define (bsr-nonzero! t)          ; (< 0 t) in context: land (NOT (= t 0))
  (let ((f (list 'NOT (list '= t 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))))
    f))

(define (bsr-z-nonzero! z)        ; z /= 0 in CC from 0 < |z|
  (let ((f (list 'NOT (list '= z 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (di)
            (dk-cite! 'cc-magnitude-zero)
            (let* ((h1 (dk-rewrite-h! (list '< 0 (list 'magnitude z)) z 0))
                   (h2 (dk-rewrite-h! h1 '(magnitude 0) 0)))
              (dk-absurd! h2)))))
    f))

;;; the set whose infimum is the spectral radius, at x
(define (bsr-ss x)
  (list 'SEP 'bsw_ 'RR (list 'FORSOME 'bsn_ (list 'AND '(IN bsn_ NN) (list 'AND '(<= 1 bsn_)
    (list '= 'bsw_ (list 'RPOW-STAR (list '(VNRM a) (list 'EL-POW 'a x 'bsn_)) '(RECIP-STAR bsn_))))))))
(define (bsr-nrm j) (bsr-nr (bsr-p 'x j)))
(define (bsr-rt j) (list 'RPOW-STAR (bsr-nrm j) (list 'RECIP-STAR j)))
(define (bsr-ntype! j)
  (bsr-vt (bsr-p 'x j))
  (dk-cite! 'bae-vnrm-type 'a (bsr-p 'x j))
  (dk-cite! 'bal-uba-vnrm-nonneg 'a (bsr-p 'x j))
  (list 'IN (bsr-nrm j) 'RR))
(define (bsr-rtype! j)
  (bsr-ntype! j)
  (dk-cite! 'nn-in-rr j)
  (dk-cite! 'recip-star-nn-pos j)
  (dk-cite! 'recip-star-in-rr j)
  (bsr-lin! (list '<= 0 (list 'RECIP-STAR j)) (list '< 0 (list 'RECIP-STAR j)))
  (dk-cite! 'rpow-star-nonneg-in-rr (bsr-nrm j) (list 'RECIP-STAR j))
  (dk-cite! 'rpow-star-nonneg-nonneg (bsr-nrm j) (list 'RECIP-STAR j))
  (list 'IN (bsr-rt j) 'RR))
;;; land (SUBSET ss RR-POS-STAR)
(define (bsr-ss-subset!)
  (let ((ss (bsr-ss 'x)))
    (dk-have! (list 'SUBSET ss 'RR-POS-STAR)
      (lambda ()
        (mac 'subset-def)
        (let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
          (sep-me (list 'IN r ss))
          (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
            (dk-split-all!)
            (bsr-rtype! k)
            (bsr-lin! (list '<= 0 r) (list '= r (bsr-rt k)) (list '<= 0 (bsr-rt k)))
            (dk-cite! 'rmc-rps-of-nonneg r)
            (dk-ass!)))))
    (list 'SUBSET ss 'RR-POS-STAR)))

