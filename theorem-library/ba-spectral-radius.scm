;;; ---- (3) (c x)^n = c^n x^n ----------------------------------------------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL c (IMPLIES (IN c CC) (FORALL x (IMPLIES (IN x (VEC a))
    (= (EL-POW a ((ACT a) c x) n) ((ACT a) (POWER c n) (EL-POW a x n)))))))))))))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (let ((cx (bsr-ac 'c 'x)))
    (bsr-vt cx)
    (fact 'EL-POW-zero 'a cx) (subst (list '== (bsr-p cx 0) bsr-one))
    (fact 'EL-POW-zero 'a 'x) (subst (list '== (bsr-p 'x 0) bsr-one))
    (dk-cite! 'power-zero 'c) (subst '(= (POWER c 0) 1))
    (bsr-vt bsr-one)
    (dk-cite! 'bas-act-one 'a bsr-one)
    (bsr-rw! (bsr-ac 1 bsr-one) bsr-one)
    (rfl))
  (dk-focus! step)
  (dk-peel!)
  (let* ((cx (bsr-ac 'c 'x)) (pv (bsr-p 'x v)) (cv (list 'POWER 'c v)) (xpv (bsr-m 'x pv)))
    (bsr-vt cx) (bsr-vt pv) (bsr-cc! cv)
    (fact 'EL-POW-succ 'a cx v) (subst (list '== (bsr-p cx (list 'succ v)) (bsr-m cx (bsr-p cx v))))
    (fact 'EL-POW-succ 'a 'x v) (subst (list '== (bsr-p 'x (list 'succ v)) xpv))
    (dk-apply! ih 'c 'x)
    (subst (list '= (bsr-p cx v) (bsr-ac cv pv)))
    (bsr-cite2! 'power-succ 'c v)
    (subst (list '= (list 'POWER 'c (list 'succ v)) (list '* 'c cv)))
    (bsr-pin!)
    (dk-cite! 'rb3-c-in-carr-uba-as-module 'a 'c)
    (dk-cite! 'rb3-c-in-carr-uba-as-module 'a cv)
    (bsr-vt (bsr-ac cv pv)) (bsr-vt xpv) (bsr-vt (bsr-ac cv xpv))
    (dk-cite! 'bal-uba-vmul-act-left 'a 'c 'x (bsr-ac cv pv))
    (bsr-rw! (bsr-m cx (bsr-ac cv pv)) (bsr-ac 'c (bsr-m 'x (bsr-ac cv pv))))
    (dk-cite! 'bal-uba-vmul-act-right 'a cv 'x pv)
    (bsr-rw! (bsr-m 'x (bsr-ac cv pv)) (bsr-ac cv xpv))
    (dk-cite! 'rb3-c-act-mul-uba-as-module 'a 'c cv xpv)
    (bsr-rw! (bsr-ac (list '* 'c cv) xpv) (bsr-ac 'c (bsr-ac cv xpv)))
    (bsr-vt (bsr-ac 'c (bsr-ac cv xpv)))
    (rfl)))
(bsr-qed! 'bsr-el-pow-act)

;;; ---- (4) 1 - x^n invertible  ==>  1 - x invertible ---------------------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a))
    (IMPLIES (IS-INVERTIBLE-EL a ((VADD a) (VONE a) ((VNEG a) (EL-POW a x n))))
             (IS-INVERTIBLE-EL a ((VADD a) (VONE a) ((VNEG a) x))))))))))))
(dk-peel!)
(let* ((w (bsr-sb bsr-one (bsr-p 'x 'n))) (om (bsr-sb bsr-one 'x)) (s (bsr-s 'x 'n)) (wi (bsr-inv w))
       (r (bsr-m s wi)) (l (bsr-m wi s)))
  (dk-cite! 'ban-nsum-left 'n 'a 'x)
  (dk-cite! 'ban-nsum-right 'n 'a 'x)
  (dk-cite! 'bae-inverse-left 'a w)
  (dk-cite! 'bae-inverse-right 'a w)
  (bsr-vt om) (bsr-vt s) (bsr-vt wi) (bsr-vt w) (bsr-vt r) (bsr-vt l)
  (dk-have! (list '= (bsr-m om r) bsr-one)
    (lambda ()
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a om s wi)
      (bsr-rw! (bsr-m om r) (bsr-m (bsr-m om s) wi))
      (bsr-rw! (bsr-m om s) w)
      (dk-ass!)))
  (dk-have! (list '= (bsr-m l om) bsr-one)
    (lambda ()
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a wi s om)
      (bsr-rw! (bsr-m l om) (bsr-m wi (bsr-m s om)))
      (bsr-rw! (bsr-m s om) w)
      (dk-ass!)))
  (dk-cite! 'bae-inv-unique 'a om l r)
  (dk-have! (list '= (bsr-m r om) bsr-one)
    (lambda ()
      (bsr-rw! r l)
      (dk-ass!)))
  (dk-cite! 'bae-invertible-intro 'a om r)
  (dk-ass!))
(bsr-qed! 'bsr-one-minus-pow-invertible)

;;; ---- (5) rho(x) < |z|  ==>  z 1 - x invertible ---------------------------------------------------
(sp (bsr-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL z (IMPLIES (IN z CC)
  (IMPLIES (< (SPECTRAL-RADIUS a x) (magnitude z)) (IS-INVERTIBLE-EL a (SHIFT-EL a z x)))))))))
(dk-peel!)
(let* ((ss (bsr-ss 'x)) (lv (list 'EINF ss)) (rho '(SPECTRAL-RADIUS a x)) (mz '(magnitude z)))
  (dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
  (dk-cite! 'cc-magnitude-closed 'z)
  (dk-cite! 'cc-magnitude-nonneg 'z)
  (bsr-lin! (list '< 0 mz) (list '< rho mz) (list '<= 0 rho))
  (bsr-z-nonzero! 'z)
  (bsr-nonzero! mz)
  (dk-cite! 'spectral-radius-unfold 'a 'x)
  (bsr-ss-subset!)
  (dk-have! (list '< lv mz) (lambda () (bsr-rw! lv rho) (dk-ass!)))
  (dk-cite! 'rmc-rps-of-nonneg mz)
  (let* ((y (dk-skolem! (dk-cite! 'einf-lt-witness ss mz) #t)))
    (sep-me (list 'IN y ss))
    (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the index"))))
      (dk-split-all!)
      (bsr-rtype! k)
      (let* ((nk (bsr-nrm k)) (xk (bsr-p 'x k))
             (c '(recip z)) (y1 (bsr-ac c 'x)) (yk (bsr-p y1 k)) (ck (list 'POWER c k))
             (q (list 'recip mz)) (qk (list 'POWER q k)) (zk (list 'POWER mz k)))
        (dk-have! (list '< (bsr-rt k) mz) (lambda () (bsr-rw! (bsr-rt k) y) (dk-ass!)))
        (dk-cite! 'fek-root-lt nk mz k)
        ;; the scalars
        (bsr-cc! c) (bsr-cc! ck)
        (bsr-cite2! 'cc-recip-inverse 'z)
        (bsr-cite2! 'rr-recip-closed mz)
        (bsr-cite2! 'rr-recip-inverse mz)
        (dk-cite! 'rr-recip-pos mz)
        (dk-cite! 'power-real-closed q k)
        (dk-cite! 'power-real-closed mz k)
        (dk-cite! 'rr-power-pos q k)
        (dk-cite! 'cc-magnitude-power k c)
        (dk-cite! 'aif-magnitude-recip 'z)
        (dk-have! (list '= (list '* qk zk) 1)
          (lambda ()
            (dk-cite! 'rr-power-mul-base k q mz)
            (bsr-rw! (list '* qk zk) (list 'POWER (list '* q mz) k))
            (bsr-cite2! 'rr-mul-comm q mz)
            (bsr-rw! (list '* q mz) (list '* mz q))
            (bsr-rw! (list '* mz q) 1)
            (dk-cite! 'rr-power-one k)
            (dk-ass!)))
        (bsr-cite2! 'rr-lt-scale-pos qk nk zk)
        (let ((h (dk-rewrite-h! (list '< (list '* qk nk) (list '* qk zk)) (list '* qk zk) 1)))
          h)
        ;; the element y1 = z^(-1) x and its k-th power
        (bsr-vt y1) (bsr-vt yk) (bsr-vt xk)
        (dk-cite! 'bsr-el-pow-act k 'a c 'x)
        (bsr-pin!)
        (dk-cite! 'rb3-c-in-carr-uba-as-module 'a ck)
        (dk-cite! 'bal-uba-vnrm-homog 'a ck xk)
        (dk-have! (list '< (bsr-nr yk) 1)
          (lambda ()
            (bsr-rw! yk (bsr-ac ck xk))
            (bsr-rw! (bsr-nr (bsr-ac ck xk)) (list '* (list 'magnitude ck) nk))
            (bsr-rw! (list 'magnitude ck) (list 'POWER (list 'magnitude c) k))
            (bsr-rw! (list 'magnitude c) q)
            (dk-ass!)))
        (dk-split-all! (list (dk-cite! 'neumann-series 'a yk)))
        (dk-cite! 'bsr-one-minus-pow-invertible k 'a y1)
        (dk-cite! 'bas-act-invertible 'a 'z (bsr-sb bsr-one y1))
        (dk-cite! 'brv-shift-factor 'a 'x 'z)
        (bsr-rw! '(SHIFT-EL a z x) (bsr-ac 'z (bsr-sb bsr-one y1)))
        (dk-ass!)))))
(bsr-qed! 'shift-invertible-beyond-spectral-radius)

;;; ---- (6) PROPOSITION 1.8: sigma(x) lies in the closed disc of radius rho(x) ----------------------
(sp (bsr-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL z (IMPLIES (IN z (SPECTRUM a x))
  (<= (magnitude z) (SPECTRAL-RADIUS a x))))))))
(dk-peel!)
(let* ((rho '(SPECTRAL-RADIUS a x)) (mz '(magnitude z))
       (m0 '(IN z (SPECTRUM a x))))
  (fact 'bas-spectrum-unfold 'a 'x)
  (let* ((m1 (dk-rewrite-h! m0 '(SPECTRUM a x) '(SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))))
    (dk-project! '(IN z CC) (lambda () (sep-me m1)))
    (dk-project! '(NOT (IS-INVERTIBLE-EL a (SHIFT-EL a z x))) (lambda () (sep-me m1))))
  (dk-split-all! (list (dk-cite! 'spectral-radius-real 'a 'x)))
  (dk-cite! 'cc-magnitude-closed 'z)
  (dk-have! (list 'NOT (list '< rho mz))
    (lambda ()
      (di)
      (dk-cite! 'shift-invertible-beyond-spectral-radius 'a 'x 'z)
      (ai '(NOT (IS-INVERTIBLE-EL a (SHIFT-EL a z x))))))
  (dk-cite! 'rr-not-lt-ge rho mz)
  (dk-ass!))
(bsr-qed! 'spectrum-in-spectral-radius-disc)

;;; ---- (7) the resolvent set CC \ sigma(x) is open ------------------------------------------------
(define bsr-D '(DIFFERENCE CC (SPECTRUM a x)))
(define bsr-sep-sigma '(SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))
;;; with (IN y D) in context: land (IN y CC) and (IS-INVERTIBLE-EL a (SHIFT-EL a y x))
(define (bsr-off-spectrum! y)
  (let ((hy (list 'IN y bsr-D)))
    (dk-project! (list 'IN y 'CC) (lambda () (mac-h 'difference-membership hy)))
    (let ((nsig (dk-project! (list 'NOT (list 'IN y '(SPECTRUM a x))) (lambda () (mac-h 'difference-membership hy))))
          (inv (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a y 'x))))
      (fact 'bas-spectrum-unfold 'a 'x)
      (dk-have! inv
        (lambda ()
