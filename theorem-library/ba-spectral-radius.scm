  (AND (IN (SPECTRAL-RADIUS a x) RR) (<= 0 (SPECTRAL-RADIUS a x)))))))
(dk-peel!)
(let* ((ss (bsr-ss 'x)) (lv (list 'EINF ss)) (rho '(SPECTRAL-RADIUS a x)))
