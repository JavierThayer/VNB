;;; gn-gen.scm -- the notes' general (non-commutative) forms of Propositions 1.31, 1.36 and 1.39(a) of F. J.
;;; Thayer, "Banach Algebras and Applications", ch. 1, by instantiating the relative forms (gn-onto cfc-normal-*,
;;; gn-pos sub-order-unit-le, sub-one-minus-sa-square) at a := C*(x, 1) = SUB-UCSA(b, CSTAR-GEN(b, x)), a
;;; commutative unital C*-subalgebra of b containing x (gn-cgen: cstar-gen-ucsa, cstar-gen-commutative-c-star).
;;; Agent BA-1117-GN, wave 2026-11-17, round 2.  All proofs modulo 0.  Destination: theorem-library/gn-gen.scm,
;;; after gn-onto, gn-pos and gn-cgen.  Library: operator-algebras.  Helper prefix gng-.  No binders.

(define (gng-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-gen: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 300)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-gen: unfinished" name))))
(define (gng-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gng-ass!) (if (and (gng-open?) (dk-asm? (dk-goal))) (ass)))
(define (gng-replace old new e) (cond ((eq? e old) new) ((pair? e) (map (lambda (s) (gng-replace old new s)) e)) (#t e)))
(define gng-A '(SUB-UCSA b (CSTAR-GEN b x)))
(define gng-K '(SPEC-TOP b x))
(define (gng-setup!)                   ; x normal in b: C*(x) a commutative unital C*-subalgebra of b containing x
  (dk-cite! 'bcp-ucsa-uiba 'b)
  (dk-split-all! (list (dk-cite! 'cstar-gen-ucsa 'b 'x)))
  (dk-cite! 'cstar-gen-commutative-c-star 'b 'x))
(define gng-hyps '(IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL x (IMPLIES (IS-NORMAL-EL b x)
  (FORALL f (IMPLIES (IN f (CCONT (SPEC-TOP b x))) BODY))))))
(define (gng-stmt body) (list 'FORALL 'b (gng-replace 'BODY body gng-hyps)))
(define (gng-n f) (list 'CFC-N 'b 'x f))
(define (gng-x!) (dk-project! '(IN x (VEC b)) 'is-normal-el '(IS-NORMAL-EL b x)))

;;; ---- 1.31 for a normal element of any unital C*-algebra ----
(define (gng-cfc! name body rel args)
  (sp (make-wff (gng-stmt body)))
  (dk-peel!)
  (gng-x!)
  (gng-setup!)
  (mac 'CFC-N)
  (apply dk-cite! rel gng-A 'b 'x args)
  (gng-ass!)
  (gng-qed! name))
(gng-cfc! 'cfc-n-in (list 'IN (gng-n 'f) '(VEC b)) 'cfc-normal-in '(f))
(gng-cfc! 'cfc-n-add (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'CCONT gng-K))
  (list '= (gng-n (list (list 'CCONT-VADD gng-K) 'f 'g)) (list '(VADD b) (gng-n 'f) (gng-n 'g))))) 'cfc-normal-add '(f g))
(gng-cfc! 'cfc-n-mul (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'CCONT gng-K))
  (list '= (gng-n (list (list 'CCONT-VMUL gng-K) 'f 'g)) (list '(VMUL b) (gng-n 'f) (gng-n 'g))))) 'cfc-normal-mul '(f g))
(gng-cfc! 'cfc-n-act (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
  (list '= (gng-n (list (list 'CCONT-ACT gng-K) 'z 'f)) (list '(ACT b) 'z (gng-n 'f))))) 'cfc-normal-act '(f z))
(gng-cfc! 'cfc-n-star (list '= (gng-n (list (list 'CCONT-VSTAR gng-K) 'f)) (list '(VSTAR b) (gng-n 'f))) 'cfc-normal-star '(f))
(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL x (IMPLIES (IS-NORMAL-EL b x)
  (AND (= (CFC-N b x (CCONT-VONE (SPEC-TOP b x))) (VONE b))
       (= (CFC-N b x (VNB-LAMBDA gnvz_ (SPECTRUM b x) gnvz_)) x))))))))
(dk-peel!)
(gng-x!)
(gng-setup!)
(mac 'CFC-N)
(dk-split-all! (list (dk-cite! 'cfc-normal-one-id gng-A 'b 'x)))
(dk-conj-close! (lambda () (gng-ass!)))
(gng-qed! 'cfc-n-one-id)

;;; a self-adjoint element is normal
(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA b) (FORALL x (IMPLIES (IN x (VEC b))
  (IMPLIES (= ((VSTAR b) x) x) (IS-NORMAL-EL b x))))))))
(dk-peel!)
(mac 'is-normal-el)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (gng-ass!)
        (begin (subst '(= ((VSTAR b) x) x)) (dk-cite! 'kal-uiba-vmul-in 'b 'x 'x) (if (gng-open?) (rfl))))))
(gng-qed! 'self-adjoint-normal)

;;; ---- 1.36 exactly: x <= ||x|| 1 (any l >= ||x||) for x self-adjoint in any unital C*-algebra ----
(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL x (IMPLIES (IN x (VEC b)) (IMPLIES (= ((VSTAR b) x) x)
  (FORALL l (IMPLIES (IN l RR) (IMPLIES (<= ((VNRM b) x) l) (ALE b x ((ACT b) l (VONE b)))))))))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'b)
(dk-cite! 'self-adjoint-normal 'b 'x)
(gng-setup!)
(dk-cite! 'sub-order-unit-le gng-A 'b 'x 'l)
(gng-ass!)
(gng-qed! 'order-unit-le)

;;; ---- 1.39(a): 1 - x is a square of a self-adjoint for x self-adjoint, ||x|| <= 1, in any unital C*-algebra ----
(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL x (IMPLIES (IN x (VEC b)) (IMPLIES (= ((VSTAR b) x) x)
  (IMPLIES (<= ((VNRM b) x) 1) (IN ((VADD b) (VONE b) ((VNEG b) x)) (SA-SQUARES b))))))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'b)
(dk-cite! 'self-adjoint-normal 'b 'x)
(gng-setup!)
(dk-cite! 'sub-one-minus-sa-square gng-A 'b 'x)
(gng-ass!)
(gng-qed! 'one-minus-sa-square)

;;; ---- 1.40 in any unital C*-algebra: (i) the norm test makes a self-adjoint x positive; (ii) every square of
;;; a self-adjoint (an element of SA-SQUARES) passes the norm test.  (ii) for all of POS-CONE b needs A+ =
;;; squares in general, i.e. that A+ is closed under addition in the sense of the norm test (Kelley-Vaught).
(define (gng-exs x) (list '(VADD b) (list '(ACT b) (list '(VNRM b) x) '(VONE b)) (list '(VNEG b) x)))
(define (gng-ntest x) (list '<= (list '(VNRM b) (gng-exs x)) (list '(VNRM b) x)))
(sp (make-wff (list 'FORALL 'b (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA b) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC b))
  (list 'IMPLIES '(= ((VSTAR b) x) x) (list 'IMPLIES (gng-ntest 'x) '(IN x (POS-CONE b))))))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'b)
(dk-cite! 'self-adjoint-normal 'b 'x)
(gng-setup!)
(dk-cite! 'sub-pos-norm-test-suff gng-A 'b 'x)
(gng-ass!)
(gng-qed! 'pos-norm-test-suff)

(define (gng-sq-open! k)               ; y in SA-SQUARES(b): K receives A = C*(w), wa = w w in A (in POS-CONE A), w w in b,
  (dk-cite! 'bcp-ucsa-uiba 'b)          ; and the equation y = w w (b's product) in context
(let* ((u (dk-cite! 'sa-squares-unfold 'b))
       (m (dk-rewrite-h! '(IN y (SA-SQUARES b)) '(SA-SQUARES b) (caddr u))))
  (dk-sep-parts! m) (dk-split-all!)
  (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'y))) "the witness"))
         (w (dk-skolem! ex)))
    (dk-split-all!)
    (let* ((su (dk-cite! 'sa-part-unfold 'b))
           (m2 (dk-rewrite-h! (list 'IN w '(SA-PART b)) '(SA-PART b) (caddr su))))
      (dk-sep-parts! m2) (dk-split-all!))
    (let* ((A (list 'SUB-UCSA 'b (list 'CSTAR-GEN 'b w)))
           (ww (list '(VMUL b) w w)))
      (dk-cite! 'self-adjoint-normal 'b w)
      (dk-split-all! (list (dk-cite! 'cstar-gen-ucsa 'b w)))
      (dk-cite! 'cstar-gen-commutative-c-star 'b w)
      (dk-cite! 'bcp-sub-ucsa-a A 'b)
      (dk-cite! 'bcp-ucsa-uiba A)
      (dk-cite! 'bcp-sub-vstar A 'b w)
      (dk-cite! 'bcp-sub-vmul A 'b w w)
      (dk-cite! 'kal-uiba-vmul-in A w w)
      (dk-have! (list 'IN w (list 'SA-PART A))
        (lambda ()
          (subst (dk-cite! 'sa-part-unfold A))
          (in-sep! (lambda () (gng-ass!))
            (lambda () (subst (list '= (list (list 'VSTAR A) w) (list '(VSTAR b) w))) (gng-ass!)))))
      (let ((wa (list (list 'VMUL A) w w)))
        (dk-have! (list 'IN wa (list 'SA-SQUARES A))
          (lambda ()
            (subst (dk-cite! 'sa-squares-unfold A))
            (in-sep! (lambda () (gng-ass!)) (lambda () (ew w) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (gng-ass!) (rfl))))))))
        (dk-cite! 'sa-square-pos A wa)
        (k A wa ww (dk-pick (lambda (h) (and (dk-head-is? h '=) (or (equal? (cadr h) 'y) (equal? (caddr h) 'y)))) "y = w w")))))))
(sp (make-wff (list 'FORALL 'b (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA b) (list 'FORALL 'y (list 'IMPLIES '(IN y (SA-SQUARES b))
  (gng-ntest 'y)))))))
(dk-peel!)
(gng-sq-open!
  (lambda (A wa ww ey)
    (dk-rewrite-h! (dk-cite! 'sub-pos-norm-test-nec A 'b wa) wa ww)
    (subst ey)
    (gng-ass!)))
(gng-qed! 'sa-square-norm-test)

;;; 1.40 exactly: the norm test makes x a square of a self-adjoint
(sp (make-wff (list 'FORALL 'b (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA b) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC b))
  (list 'IMPLIES '(= ((VSTAR b) x) x) (list 'IMPLIES (gng-ntest 'x) '(IN x (SA-SQUARES b))))))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'b)
(dk-cite! 'self-adjoint-normal 'b 'x)
(gng-setup!)
(dk-cite! 'sub-pos-norm-test-sq gng-A 'b 'x)
(gng-ass!)
(gng-qed! 'pos-norm-test-sq)

;;; 1.39 (second assertion): y in A_sa^2, ||y|| <= 1 give ||1 - y|| <= 1
(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL y (IMPLIES (IN y (SA-SQUARES b))
  (IMPLIES (<= ((VNRM b) y) 1) (<= ((VNRM b) ((VADD b) (VONE b) ((VNEG b) y))) 1))))))))
(dk-peel!)
(gng-sq-open!
  (lambda (A wa ww ey)
    (subst ey)
    (let ((hy (dk-rewrite-h! '(<= ((VNRM b) y) 1) (cadr ey) (caddr ey))))
      (dk-have! (list '<= (list (list 'VNRM 'b) wa) 1)
        (lambda () (subst (list '= wa ww)) (gng-ass!)))
      (dk-rewrite-h! (dk-cite! 'sub-one-minus-pos-norm A 'b wa) wa ww)
      (gng-ass!))))
(gng-qed! 'one-minus-sq-norm)

;;; ---- the positive cone is closed under nonnegative real scalars: t x >= 0 for t >= 0, x >= 0 ----
;;; induction on the cone (pos-cone-induct): t (z* z) = (s z)* (s z) with s = sqrt(t); t (u + v) = t u + t v.
(define (gng-act s x) (list '(ACT a) s x))
(define gng-S '(SEP gngv_ (VEC a) (IN ((ACT a) t gngv_) (POS-CONE a))))
(define (gng-vt! x)                    ; x in VEC a, bottom-up, for the terms built here
  (if (not (dk-asm? (list 'IN x '(VEC a))))
      (cond ((and (pair? x) (equal? (car x) '(ACT a))) (gng-vt! (caddr x)) (dk-cite! 'kal-uiba-act-in 'a (cadr x) (caddr x)))
            ((and (pair? x) (equal? (car x) '(VSTAR a))) (gng-vt! (cadr x)) (dk-cite! 'kal-uiba-vstar-in 'a (cadr x)))
            ((and (pair? x) (equal? (car x) '(VMUL a))) (gng-vt! (cadr x)) (gng-vt! (caddr x)) (dk-cite! 'kal-uiba-vmul-in 'a (cadr x) (caddr x)))
            ((and (pair? x) (equal? (car x) '(VADD a))) (gng-vt! (cadr x)) (gng-vt! (caddr x)) (dk-cite! 'kal-uiba-vadd-in 'a (cadr x) (caddr x)))
            (#t #f))))
(define (gng-S-open! v)                ; v in gng-S: v in VEC a and t v >= 0
  (if (not (dk-asm? (list 'IN v '(VEC a))))
      (begin (sep-me (dk-ctx-form (list 'IN v gng-S))) (dk-split-all!))))
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL t (IMPLIES (IN t RR) (IMPLIES (<= 0 t)
  (FORALL x (IMPLIES (IN x (POS-CONE a)) (IN ((ACT a) t x) (POS-CONE a)))))))))))
(dk-peel!)
(dk-have! '(AND (IN t RR) (<= 0 t)) (lambda () (dk-conj-close! (lambda () (gng-ass!)))))
(dk-split-all! (list (dk-cite! 'sqrt-prop 't)))
(define gng-rt '(sqrt t))
(dk-cite! 'rr-subset-cc 't)
(dk-cite! 'rr-subset-cc gng-rt)
(dk-have! (list '= 't (list '* gng-rt gng-rt)) (lambda () (subst (list '= (list '* gng-rt gng-rt) 't)) (if (gng-open?) (rfl))))
(dk-have! (list 'SUBSET gng-S '(VEC a))
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (gng-S-open! z) (gng-ass!))))
(let* ((ind (dk-cite! 'pos-cone-induct 'a gng-S))
       (i2 (detach-with! ind
             (lambda ()
               (let* ((ls (dk-peel!)) (z (caddr (cadr (dk-goal)))) (zz (list '(VMUL a) (list '(VSTAR a) z) z)) (sz (gng-act gng-rt z)))
                 (gng-vt! zz) (gng-vt! sz)
                 (in-sep! (lambda () (gng-ass!))
                   (lambda ()
                     (subst (list '= 't (list '* gng-rt gng-rt)))
                     (let ((e (dk-alg-have! 'kal-uiba 'a
                                (list '= (gng-act (list '* gng-rt gng-rt) zz) (list '(VMUL a) (list '(VSTAR a) sz) sz)))))
                       (subst e)
                       (dk-cite! 'pos-cone-star-square 'a sz)
                       (gng-ass!))))))))
      (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (gng-S-open! u) (gng-S-open! v)
                 (gng-vt! (list '(VADD a) u v)) (gng-vt! (gng-act 't u)) (gng-vt! (gng-act 't v))
                 (in-sep! (lambda () (gng-ass!))
                   (lambda ()
                     (subst (dk-alg-have! 'kal-uiba 'a
                              (list '= (gng-act 't (list '(VADD a) u v)) (list '(VADD a) (gng-act 't u) (gng-act 't v)))))
                     (dk-cite! 'pos-cone-add-closed 'a (gng-act 't u) (gng-act 't v))
                     (gng-ass!))))))))
 (dk-apply! i3 'x)
  (gng-S-open! 'x)
  (gng-ass!))
(gng-qed! 'pos-cone-act-nonneg)
