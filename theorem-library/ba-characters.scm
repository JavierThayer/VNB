;;; ==== B. THE IDEAL GENERATED BY AN IDEAL ii AND AN ELEMENT x =================================
;;; G(ii, x) = { w : w = b x mod ii for some b }, written with the cosets of ii:
;;;   { w in A : exists b in A, CLASS(w) = CLASS(b x) }.
;;; Its ideal laws are proved by class arithmetic in A/ii (qmod-*-computes, qna-vmul-computes):
;;; no subtraction identity is needed.
(define bch-S '(QMOD-SETOID (UBA-AS-MODULE a) ii))
(define bch-QS '(QUOTIENT (QMOD-SETOID (UBA-AS-MODULE a) ii)))
(define bch-QVADD '(VADD (QUOTIENT-MODULE (UBA-AS-MODULE a) ii)))
(define bch-QACT '(ACT (QUOTIENT-MODULE (UBA-AS-MODULE a) ii)))
(define bch-QVMUL '(QNA-VMUL a ii))
(define (bch-cl x) (list 'CLASS bch-S x))
(define (bch-G x)
  (list 'SEP 'bchw_ '(VEC a)
        (list 'FORSOME 'bchb_ (list 'AND '(IN bchb_ (VEC a))
                                    (list '= (bch-cl 'bchw_) (bch-cl (list '(VMUL a) 'bchb_ x)))))))
(define (bch-G-cond w b x) (list '= (bch-cl w) (bch-cl (bch-mu b x))))
(define (bch-ist body) (bch-cst (list 'FORALL 'ii (list 'IMPLIES '(IS-TWO-SIDED-IDEAL a ii) body))))

;;; the ideal ii opened: IS-UBA a, ii a submodule, the setoid; returns (left right) clauses
(define (bch-setup!)
  (dk-cite! 'bch-comm-uba 'a)
  (let* ((tf '(IS-TWO-SIDED-IDEAL a ii))
         (body (caddr (dk-cite! 'IS-TWO-SIDED-IDEAL 'a 'ii)))
         (lf (dk-project! (cadr body) 'IS-TWO-SIDED-IDEAL tf)))
    (dk-cite! 'ba-left-ideal-submodule 'a 'ii)
    (dk-cite! 'qmod-setoid-is-setoid-uba-as-module 'a 'ii)
    (dk-cite! 'qmod-setoid-pts-uba-as-module 'a 'ii)
    (dk-cite! 'bal-uba-vec-set 'a)
    (dk-project! '(SUBSET ii (VEC a)) (lambda () (dk-split-all! (list (dk-cite! 'bmx-ideal-parts 'a 'ii)))))
    lf))
(define bch-PTS (list 'PTS bch-S))
(define (bch-pts! t)
  (bch-vt t)
  (if (not (dk-asm? (list 'IN t bch-PTS)))
      (dk-have! (list 'IN t bch-PTS)
        (lambda () (let ((l (proof-state-focus *ps*)))
                     (subst (list '= bch-PTS '(VEC a)))
                     (if (not (sequent-node-grounded? l)) (dk-ass!)))))))
(define (bch-clq! t)
  (bch-pts! t)
  (dk-cite! 'class-in-quotient bch-S t))
;;; w in G(x) in context: land w in VEC a and the class equation; return the witness b
(define (bch-out-G! w x)
  (let* ((g (bch-G x)) (m (list 'IN w g))
         (cnd (subst-free 'bchw_ w (cadddr g))))
    (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me m)))
    (dk-project! cnd (lambda () (sep-me m)))
    (dk-skolem! cnd)))
;;; prove the goal (IN w G(x)) from b typed and the class equation in context
(define (bch-in-G! w b)
  (bch-vt w) (bch-vt b)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l)
                         (if (eq? (dk-head (dk-goal)) 'FORSOME)
                             (begin (ew b) (dk-conj-close! (lambda () (dk-ass!))))
                             (dk-ass!)))))
            (dk-opened (lambda () (sep-mi)))))
(define (bch-sb! from to) (subst (list '= from to)))

;;; CLASS m = CLASS 0 iff m in ii
(sp (bch-ist (bch-fa 'm '(VEC a) (list 'IFF (list '= (bch-cl 'm) (bch-cl bch-zero)) '(IN m ii)))))
(dk-peel!)
(bch-setup!)
(bch-vt bch-zero)
(let ((iff (dk-cite! 'qmod-class-eq-iff-uba-as-module 'a 'ii 'm bch-zero)))
  (dk-cite! 'ring-neg-zero-uba-as-ring 'a)
  (dk-cite! 'ring-add-right-id-uba-as-ring 'a 'm)
  (let* ((h1 (dk-rewrite-h! iff (bch-ng bch-zero) bch-zero))
         (h2 (dk-rewrite-h! h1 (bch-ad 'm bch-zero) 'm)))
    (dk-ass!)))
(bch-qed! 'bch-class-zero-iff)

;;; G(ii, x) is a two-sided ideal
(sp (bch-ist (bch-fa 'x '(VEC a) (list 'IS-TWO-SIDED-IDEAL 'a (bch-G 'x)))))
(dk-peel!)
(bch-setup!)
(define bch-Gx (bch-G 'x))
(let* ((inst (dk-cite! 'bmx-ideal-intro 'a bch-Gx))
       (antes (let loop ((f inst) (acc '()))
                (if (and (pair? f) (eq? (car f) 'IMPLIES)) (loop (caddr f) (cons (cadr f) acc)) (reverse acc)))))
  ;; 1. subset
  (dk-have! (list-ref antes 0)
    (lambda ()
      (let ((iff (dk-cite! 'subset-def bch-Gx '(VEC a))))
        (dk-have! (caddr iff)
          (lambda ()
            (dk-peel!)
            (let ((w (cadr (dk-goal))) (l (proof-state-focus *ps*)))
              (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me (list 'IN w bch-Gx))))
              (if (not (sequent-node-grounded? l)) (dk-ass!)))))
        (keep iff (caddr iff))
        (prop))))
  ;; 2. zero: 0 = 0 x
  (dk-have! (list-ref antes 1)
    (lambda ()
      (bch-vt bch-zero)
      (dk-have! (bch-G-cond bch-zero bch-zero 'x)
        (lambda ()
          (subst (dk-cite! 'ring-mul-zero-left-uba-as-ring 'a 'x))
          (bch-clq! bch-zero)
          (rfl)))
      (bch-in-G! bch-zero bch-zero)))
  ;; 3. sums: w1 + w2 = (b1 + b2) x
  (dk-have! (list-ref antes 2)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (w1 (cadr (cadr g))) (w2 (caddr (cadr g)))
             (b1 (bch-out-G! w1 'x)) (b2 (bch-out-G! w2 'x))
             (p1 (bch-mu b1 'x)) (p2 (bch-mu b2 'x)) (b (bch-ad b1 b2)))
        (bch-vt p1) (bch-vt p2) (bch-vt b)
        (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii w1 w2)
        (dk-have! (bch-G-cond (bch-ad w1 w2) b 'x)
          (lambda ()
            (subst (dk-cite! 'ring-right-dist-uba-as-ring 'a b1 b2 'x))
            (bch-sb! (bch-cl (bch-ad w1 w2)) (list bch-QVADD (bch-cl w1) (bch-cl w2)))
            (bch-sb! (bch-cl w1) (bch-cl p1))
            (bch-sb! (bch-cl w2) (bch-cl p2))
            (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii p1 p2)
            (bch-sb! (list bch-QVADD (bch-cl p1) (bch-cl p2)) (bch-cl (bch-ad p1 p2)))
            (bch-clq! (bch-ad p1 p2))
            (rfl)))
        (bch-in-G! (bch-ad w1 w2) b))))
  ;; 4. scalars: c w = (c b) x
  (dk-have! (list-ref antes 3)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (c (cadr (cadr g))) (w (caddr (cadr g)))
             (b (bch-out-G! w 'x)) (p (bch-mu b 'x)) (cb (bch-ac c b)))
        (dk-cite! 'bal-uba-scal-pin 'a)
        (dk-cite! 'rb3-c-in-carr-uba-as-module 'a c)
        (bch-vt p) (bch-vt cb) (bch-vt (bch-ac c w)) (bch-vt (bch-ac c p))
        (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii c w)
        (dk-have! (bch-G-cond (bch-ac c w) cb 'x)
          (lambda ()
            (subst (dk-cite! 'bal-uba-vmul-act-left 'a c b 'x))
            (bch-sb! (bch-cl (bch-ac c w)) (list bch-QACT c (bch-cl w)))
            (bch-sb! (bch-cl w) (bch-cl p))
            (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii c p)
            (bch-sb! (list bch-QACT c (bch-cl p)) (bch-cl (bch-ac c p)))
            (bch-clq! (bch-ac c p))
            (rfl)))
        (bch-in-G! (bch-ac c w) cb))))
  ;; 5. left multiples: y w = (y b) x
  (dk-have! (list-ref antes 4)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (y (cadr (cadr g))) (w (caddr (cadr g)))
             (b (bch-out-G! w 'x)) (p (bch-mu b 'x)) (yb (bch-mu y b)))
        (bch-vt p) (bch-vt yb) (bch-vt (bch-mu y p)) (bch-vt (bch-mu y w))
        (dk-cite! 'qna-vmul-computes 'a 'ii y w)
        (dk-have! (bch-G-cond (bch-mu y w) yb 'x)
          (lambda ()
            (subst (dk-cite! 'ring-mul-assoc-uba-as-ring 'a y b 'x))
            (bch-sb! (bch-cl (bch-mu y w)) (list bch-QVMUL (bch-cl y) (bch-cl w)))
            (bch-sb! (bch-cl w) (bch-cl p))
            (dk-cite! 'qna-vmul-computes 'a 'ii y p)
            (bch-sb! (list bch-QVMUL (bch-cl y) (bch-cl p)) (bch-cl (bch-mu y p)))
            (bch-clq! (bch-mu y p))
            (rfl)))
        (bch-in-G! (bch-mu y w) yb))))
  ;; 6. right multiples: w y = (b y) x, by commutativity
  (dk-have! (list-ref antes 5)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (w (cadr (cadr g))) (y (caddr (cadr g)))
             (b (bch-out-G! w 'x)) (p (bch-mu b 'x)) (by (bch-mu b y)))
        (bch-vt p) (bch-vt by) (bch-vt (bch-mu p y)) (bch-vt (bch-mu w y))
        (bch-vt (bch-mu 'x y)) (bch-vt (bch-mu y 'x))
        (dk-cite! 'qna-vmul-computes 'a 'ii w y)
        (dk-have! (bch-G-cond (bch-mu w y) by 'x)
          (lambda ()
            (subst (dk-cite! 'ring-mul-assoc-uba-as-ring 'a b y 'x))
            (subst (dk-cite! 'bch-comm 'a y 'x))
            (dk-cite! 'ring-mul-assoc-uba-as-ring 'a b 'x y)
            (bch-sb! (bch-mu b (bch-mu 'x y)) (bch-mu p y))
            (bch-sb! (bch-cl (bch-mu w y)) (list bch-QVMUL (bch-cl w) (bch-cl y)))
            (bch-sb! (bch-cl w) (bch-cl p))
            (dk-cite! 'qna-vmul-computes 'a 'ii p y)
            (bch-sb! (list bch-QVMUL (bch-cl p) (bch-cl y)) (bch-cl (bch-mu p y)))
            (bch-clq! (bch-mu p y))
            (rfl)))
        (bch-in-G! (bch-mu w y) by))))
  (dk-apply! inst)
  (dk-ass!))
(bch-qed! 'bch-gen-ideal)

;;; ii is contained in G(ii, x), and x lies in G(ii, x)
(sp (bch-ist (bch-fa 'x '(VEC a) (list 'SUBSET 'ii (bch-G 'x)))))
(dk-peel!)
(bch-setup!)
(let ((iff (dk-cite! 'subset-def 'ii (bch-G 'x))))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-peel!)
      (let ((m (cadr (dk-goal))))
        (dk-cite! 'subset-mem-fwd 'ii '(VEC a) m)
        (bch-vt bch-zero)
        (let ((ci (dk-cite! 'bch-class-zero-iff 'a 'ii m)))
          (dk-have! (bch-G-cond m bch-zero 'x)
            (lambda ()
              (subst (dk-cite! 'ring-mul-zero-left-uba-as-ring 'a 'x))
              (keep ci (list 'IN m 'ii) (list 'IN m '(VEC a)))
              (prop))))
        (bch-in-G! m bch-zero))))
  (keep iff (caddr iff))
  (prop))
(bch-qed! 'bch-gen-contains)

(sp (bch-ist (bch-fa 'x '(VEC a) (list 'IN 'x (bch-G 'x)))))
(dk-peel!)
(bch-setup!)
(bch-vt bch-one)
(dk-have! (bch-G-cond 'x bch-one 'x)
  (lambda ()
    (subst (dk-cite! 'bal-uba-vone-left 'a 'x))
    (bch-clq! 'x)
    (rfl)))
(bch-in-G! 'x bch-one)
(bch-qed! 'bch-gen-mem)


;;; ==== C. A/M IS A FIELD, AND A/M = C (Corollary 1.11) =========================================
(define bch-Q '(QUOTIENT-BA a ii))
(define bch-QM '(QUOTIENT-MODULE (UBA-AS-MODULE a) ii))
(define (bch-mst body) (bch-cst (list 'FORALL 'ii (list 'IMPLIES '(IS-MAXIMAL-IDEAL a ii) body))))
(define (bch-guarded-ass! l) (if (not (sequent-node-grounded? l)) (dk-ass!)))
;;; IS-MAXIMAL-IDEAL a ii in context: open it, set up the quotient; return the maximality clause
(define (bch-msetup!)
