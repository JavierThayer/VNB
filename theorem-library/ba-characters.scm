;;; every nonzero element of A/M is invertible
(sp (bch-mst (list 'FORALL 'c (list 'IMPLIES (list 'IN 'c (list 'VEC bch-Q))
       (list 'IMPLIES (list 'NOT (list '= 'c (list 'VZERO bch-Q))) (list 'IS-INVERTIBLE-EL bch-Q 'c))))))
(dk-peel!)
(let* ((maxcl (bch-msetup!))
