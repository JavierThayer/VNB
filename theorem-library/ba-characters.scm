(define (bch-chi-law!)
  (let* ((g (dk-goal)) (tt (cadr (cadr g))))
    (bch-vt tt)
    (dk-lam-b!)
    (dk-cite! 'bal-uba-scal-pin 'a)
    (bch-vt bch-one)
    (cond
      ((and (pair? tt) (equal? (car tt) '(VADD a)))
       (let* ((x (cadr tt)) (y (caddr tt)) (vx (bch-val! x)) (vy (bch-val! y))
              (w (list '+ vx vy)) (px (bch-ac vx bch-one)) (py (bch-ac vy bch-one)))
         (bch-cite2! 'cc-add-closed vx vy)
         (bch-vt (bch-ad px py))
         (bch-unique! tt w
           (lambda ()
             (subst (dk-cite! 'rb3-c-act-add-uba-as-module 'a vx vy bch-one))
             (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii x y)
             (bch-sb! (bch-cl tt) (list bch-QVADD (bch-cl x) (bch-cl y)))
             (bch-sb! (bch-cl x) (bch-cl px))
             (bch-sb! (bch-cl y) (bch-cl py))
             (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii px py)
             (bch-sb! (list bch-QVADD (bch-cl px) (bch-cl py)) (bch-cl (bch-ad px py)))
             (bch-clq! (bch-ad px py))
             (rfl)))
         (bch-sb! (bch-io x) vx) (bch-sb! (bch-io y) vy)
         (dk-ass!)))
      ((and (pair? tt) (equal? (car tt) '(ACT a)))
       (let* ((c (cadr tt)) (x (caddr tt)) (vx (bch-val! x))
              (w (list '* c vx)) (px (bch-ac vx bch-one)))
         (dk-cite! 'rb3-c-in-carr-uba-as-module 'a c)
         (bch-cite2! 'cc-mul-closed c vx)
         (bch-vt (bch-ac c px))
         (bch-unique! tt w
           (lambda ()
             (subst (dk-cite! 'rb3-c-act-mul-uba-as-module 'a c vx bch-one))
             (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii c x)
             (bch-sb! (bch-cl tt) (list bch-QACT c (bch-cl x)))
             (bch-sb! (bch-cl x) (bch-cl px))
             (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii c px)
             (bch-sb! (list bch-QACT c (bch-cl px)) (bch-cl (bch-ac c px)))
             (bch-clq! (bch-ac c px))
             (rfl)))
         (bch-sb! (bch-io x) vx)
         (dk-ass!)))
      ((and (pair? tt) (equal? (car tt) '(VMUL a)))
       (let* ((x (cadr tt)) (y (caddr tt)) (vx (bch-val! x)) (vy (bch-val! y))
              (w (list '* vx vy)) (px (bch-ac vx bch-one)) (py (bch-ac vy bch-one)))
         (bch-cite2! 'cc-mul-closed vx vy)
         (bch-vt (bch-mu px py)) (bch-vt (bch-mu bch-one py)) (bch-vt (bch-ac vx py))
         (bch-unique! tt w
           (lambda ()
             (subst (dk-cite! 'rb3-c-act-mul-uba-as-module 'a vx vy bch-one))
             (dk-cite! 'qna-vmul-computes 'a 'ii x y)
             (bch-sb! (bch-cl tt) (list bch-QVMUL (bch-cl x) (bch-cl y)))
             (bch-sb! (bch-cl x) (bch-cl px))
             (bch-sb! (bch-cl y) (bch-cl py))
             (dk-cite! 'qna-vmul-computes 'a 'ii px py)
             (bch-sb! (list bch-QVMUL (bch-cl px) (bch-cl py)) (bch-cl (bch-mu px py)))
             (subst (dk-cite! 'bal-uba-vmul-act-left 'a vx bch-one py))
             (subst (dk-cite! 'bal-uba-vone-left 'a py))
             (bch-clq! (bch-ac vx py))
             (rfl)))
         (bch-sb! (bch-io x) vx) (bch-sb! (bch-io y) vy)
         (dk-ass!)))
      ((equal? tt bch-one)
       (dk-have! '(IN 1 CC) (lambda () (from-context!)))
       (bch-unique! tt 1
         (lambda ()
           (subst (dk-cite! 'bas-act-one 'a bch-one))
           (bch-clq! bch-one)
           (rfl)))
       (dk-ass!))
      (#t (error "bch-chi-law!: unexpected goal" (expression->string g))))))
(define (bch-chi-kernel!)
  (let* ((g (dk-goal)) (x (cadr (cadr (cadr g)))))
    (dk-lam-b!)
    (let* ((vx (bch-val! x)) (io (bch-io x)) (px (bch-ac vx bch-one)))
      (bch-sb! io vx)
      (dk-cite! 'bas-act-zero 'a bch-one)
      (dk-have! '(IN 0 CC) (lambda () (from-context!)))
      (dk-iff! (lambda (g) (eq? (dk-head g) 'IN))
        (lambda ()
          (let* ((e1 (dk-rewrite-h! (list '= (bch-cl x) (bch-cl px)) vx 0))
                 (e2 (dk-rewrite-h! e1 (bch-ac 0 bch-one) bch-zero))
                 (ci (dk-cite! 'bch-class-zero-iff 'a 'ii x)))
            (keep ci e2)
            (prop)))
        (lambda ()
          (let ((ci (dk-cite! 'bch-class-zero-iff 'a 'ii x)))
            (dk-have! (list '= (bch-cl x) (bch-cl bch-zero)) (lambda () (keep ci (list 'IN x 'ii)) (prop)))
            (bch-unique! x 0
              (lambda ()
                (let ((l (proof-state-focus *ps*)))
                  (subst (list '= (bch-ac 0 bch-one) bch-zero))
                  (bch-guarded-ass! l))))
            (let ((l (proof-state-focus *ps*)))
              (subst (list '= vx io))
              (bch-guarded-ass! l))))))))
(define (bch-chi-fun!)
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (not (dk-ass!))
                (begin
                  (if (memq (dk-head (dk-goal)) '(FORALL IMPLIES)) (dk-peel!))
                  (let* ((t (bch-io-arg (cadr (dk-goal)))))
                    (dk-split-all! (list (dk-cite! 'bch-chi-value 'a 'ii t)))
                    (dk-ass!)))))))
    (dk-opened (lambda () (lam-t)))))
(define (bch-char-close!)
  (let ((g (dk-goal)))
    (cond ((and (eq? (dk-head g) 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN)) (bch-chi-fun!))
          ((dk-asm? g) (dk-ass!))
          ((eq? (dk-head g) 'IS-CC-LINEAR-ON) (mac 'IS-CC-LINEAR-ON) (dk-conj-close! bch-char-close!))
          ((eq? (dk-head g) 'AND) (dk-conj-close! bch-char-close!))
          ((eq? (dk-head g) 'FORALL) (dk-peel!) (bch-char-close!))
          ((eq? (dk-head g) 'IFF) (bch-chi-kernel!))
          ((eq? (dk-head g) '=) (bch-chi-law!))
          (#t (error "bch-char-close!: unexpected goal" (expression->string g))))))

