       (n2 (dk-rewrite-h! n1 (list 'VZERO bch-QM) (bch-cl bch-zero)))
       (x (dk-skolem! (dk-cite! 'quotient-rep bch-S 'c))))
  (dk-have! (list 'IN x '(VEC a))
    (lambda () (let ((l (proof-state-focus *ps*))) (subst (list '= '(VEC a) bch-PTS)) (bch-guarded-ass! l))))
  (let ((nx (dk-rewrite-h! n2 'c (bch-cl x))))
    (dk-have! (list 'NOT (list 'IN x 'ii))
      (lambda () (let ((ci (dk-cite! 'bch-class-zero-iff 'a 'ii x))) (keep ci nx) (prop)))))
  (let ((g (bch-G x)))
