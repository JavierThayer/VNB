    (dk-cite! 'bal-uba-vone-in 'a)
    (dk-have! (list 'IN bch-one g)
      (lambda () (let ((l (proof-state-focus *ps*))) (subst (list '= g '(VEC a))) (bch-guarded-ass! l))))
    (let* ((b (bch-out-G! bch-one x)) (u (bch-cl b)) (bx (bch-mu b x)) (xb (bch-mu x b)))
