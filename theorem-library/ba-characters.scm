;;; ==== D. THE CHARACTER OF A MAXIMAL IDEAL (Corollary 1.11 / Remark 1.12) ========================
;;; chi_M(x) := the unique z in C with x + M = z 1 + M.
(define (bch-io t)
  (list 'IOTA 'bczv_ (list 'AND '(IN bczv_ CC) (list '= (bch-cl t) (bch-cl (list '(ACT a) 'bczv_ bch-one))))))
(define bch-CHI (list 'VNB-LAMBDA 'bctv_ '(VEC a) (bch-io 'bctv_)))
(define (bch-io-arg io) (caddr (cadr (caddr (caddr io)))))
(define (bch-cite2! . args)
  (let ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        r)))

;;; the value: chi_M(t) is in C and t + M = chi_M(t) 1 + M
(sp (bch-mst (bch-fa 't '(VEC a) (list 'AND (list 'IN (bch-io 't) 'CC)
       (list '= (bch-cl 't) (bch-cl (bch-ac (bch-io 't) bch-one)))))))
(dk-peel!)
(bch-msetup!)
(let ((io (bch-io 't)))
  (for-each
    (lambda (k)
      (if (not (sequent-node-grounded? k))
          (begin
            (dk-focus! k)
            (if (eq? (dk-head (dk-goal)) 'FORSOME)
                (let ((z (dk-skolem! (dk-cite! 'maximal-quotient-scalar 'a 'ii 't))))
                  (ew z)
                  (dk-conj-close!
                    (lambda ()
                      (if (eq? (dk-head (dk-goal)) 'FORALL)
                          (let* ((landed (dk-peel!)))
                            (dk-split-all!)
                            (let* ((y (caddr (dk-goal)))
                                   (ey (list '= (bch-cl 't) (bch-cl (bch-ac y bch-one))))
                                   (e2 (dk-rewrite-h! ey (bch-cl 't) (bch-cl (bch-ac z bch-one)))))
                              (dk-cite! 'maximal-quotient-scalar-unique 'a 'ii z y)
                              (dk-ass!)))
                          (dk-ass!)))))
                (dk-ass!)))))
    (dk-opened (lambda () (iota-d io)))))
(bch-qed! 'bch-chi-value)

;;; t in VEC a: name chi_M(t) as a fresh v in C with t + M = v 1 + M in context; return v
(define (bch-val! t)
  (let* ((io (bch-io t))
         (r (dk-split-all! (list (dk-cite! 'bch-chi-value 'a 'ii t))))
         (v (dk-name! io 'CC))
         (eq (list '= (bch-cl t) (bch-cl (bch-ac io bch-one)))))
