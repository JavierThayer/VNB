  (subst (list '= (bch-cl 'x) (bch-cl (bch-ac 'z bch-one))))
  (subst (list '= (bch-cl (bch-ac 'z bch-one)) (list bch-QACT 'z (bch-cl bch-one))))
  (subst (list '= bch-QACT aq))
  (subst (list '= (bch-cl bch-one) vq))
  (subst h)
  (subst (list '= (list nq vq) 1))
  (crs))
(bch-qed! 'maximal-quotient-norm-magnitude)

;;; ==== E. CHARACTERS AND THEIR KERNELS (Remark 1.13) ===========================================
;;; ker(chi) = { x in A : chi(x) = 0 }
(define (bch-K c) (list 'SEP 'bkx_ '(VEC a) (list '= (list c 'bkx_) 0)))
(define (bch-cv! c v) (bch-vt v) (dk-cite! 'fun-apply-type-c c '(VEC a) 'CC v) (list c v))
;;; c in CHARACTERS(a) in context: land c in FUN(VEC a, CC); return (additivity homogeneity
;;; multiplicativity c(1)=1) as the context holds them  (a copy of ba-gelfand's bgt-char-open!)
(define (bch-char-open! c)
  (let* ((m0 (list 'IN c '(CHARACTERS a)))
         (body (caddr (dk-cite! 'bas-characters-unfold 'a)))
         (m1 (dk-rewrite-h! m0 '(CHARACTERS a) body))
         (sb (lambda (f) (subst-free 'bac_ c f)))
         (rest (sb (caddr (cadddr body)))))
    (dk-project! (list 'IN c '(FUN (VEC a) CC)) (lambda () (sep-me m1)))
    (dk-project! (list 'IS-CC-LINEAR-ON 'a c) (lambda () (sep-me m1)))
    (dk-project! (cadr rest) (lambda () (sep-me m1)))
    (dk-project! (caddr rest) (lambda () (sep-me m1)))
    (let* ((ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a c)))
           (la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c)))
           (lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c))))
      (list la lm (cadr rest) (caddr rest)))))
;;; s + x = z 1 for s = SHIFT-EL(a, z, x)
(define (bch-shift-back! z x)
  (let* ((z1 (bch-ac z bch-one)) (s (list 'SHIFT-EL 'a z x)) (sx (bch-ad s x)))
    (bch-vt z1) (bch-vt s) (bch-vt sx) (bch-vt (bch-ng x))
    (dk-cite! 'bas-shift-unfold 'a z x)
    (dk-cite! 'ring-add-assoc-uba-as-ring 'a z1 (bch-ng x) x)
    (dk-cite! 'ring-add-left-inv-uba-as-ring 'a x)
    (dk-cite! 'ring-add-right-id-uba-as-ring 'a z1)
    (dk-have! (list '= sx z1)
      (lambda ()
        (subst (list '== s (bch-ad z1 (bch-ng x))))
        (bch-sb! (bch-ad (bch-ad z1 (bch-ng x)) x) (bch-ad z1 (bch-ad (bch-ng x) x)))
        (bch-sb! (bch-ad (bch-ng x) x) bch-zero)
        (bch-sb! (bch-ad z1 bch-zero) z1)
        (rfl)))
    sx))

;;; chi(z 1 - x) = z - chi(x)
(sp (bch-st '(FORALL c (IMPLIES (IN c (CHARACTERS a)) (FORALL z (IMPLIES (IN z CC) (FORALL x (IMPLIES (IN x (VEC a))
  (= (c (SHIFT-EL a z x)) (+ z (- (c x))))))))))))
(dk-peel!)
(let* ((laws (bch-char-open! 'c))
       (cx (bch-cv! 'c 'x))
       (s (list 'SHIFT-EL 'a 'z 'x))
       (z1 (bch-ac 'z bch-one))
       (sx (bch-shift-back! 'z 'x))
       (cs (bch-cv! 'c s)))
  (bch-cv! 'c sx) (bch-cv! 'c z1) (bch-cv! 'c bch-one)
  (dk-apply! (car laws) s 'x)
  (dk-apply! (cadr laws) 'z bch-one)
  (dk-have! (list '= (list '+ cs cx) (list '* 'z 1))
    (lambda ()
      (bch-sb! (list '+ cs cx) (list 'c sx))
      (bch-sb! sx z1)
      (bch-sb! (list 'c z1) (list '* 'z (list 'c bch-one)))
      (bch-sb! (list 'c bch-one) 1)
      (rfl)))
  (let* ((f0 (list '= cs (list '+ (list '+ cs cx) (list '- cx)))))
    (dk-have! f0 (lambda () (crs)))
    (let ((f1 (dk-rewrite-h! f0 (list '+ cs cx) (list '* 'z 1))))
      (dk-have! (list '= (list '+ (list '* 'z 1) (list '- cx)) (list '+ 'z (list '- cx))) (lambda () (crs)))
      (dk-rewrite-h! f1 (list '+ (list '* 'z 1) (list '- cx)) (list '+ 'z (list '- cx)))
      (dk-ass!))))
(bch-qed! 'character-shift-value)

;;; membership in ker(c)
(define (bch-out-K! c w)
  (let ((m (list 'IN w (bch-K c))))
    (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me m)))
    (dk-project! (list '= (list c w) 0) (lambda () (sep-me m)))))
(define (bch-in-K! c w val!)
  (bch-vt w)
  (bch-cv! c w)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l)
                         (if (not (dk-ass!))
                             (val!)))))
            (dk-opened (lambda () (sep-mi)))))
(define (bch-and-list f) (if (and (pair? f) (eq? (car f) 'AND)) (cons (cadr f) (bch-and-list (caddr f))) (list f)))

;;; the kernel of a character is a maximal ideal
(sp (bch-st (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a)) (list 'IS-MAXIMAL-IDEAL 'a (bch-K 'c))))))
(dk-peel!)
(let* ((laws (bch-char-open! 'c)) (la (car laws)) (lm (cadr laws)) (lmul (caddr laws)) (l1 (cadddr laws))
       (kk (bch-K 'c))
       (mbody (caddr (dk-cite! 'IS-MAXIMAL-IDEAL 'a kk))))
  (bch-vt bch-zero) (bch-vt bch-one)
  (bch-cv! 'c bch-zero) (bch-cv! 'c bch-one)
  (dk-have! '(IN 0 CC) (lambda () (from-context!)))
  (dk-cite! 'bas-act-zero 'a bch-one)
  (bch-vt (bch-ac 0 bch-one))
  (dk-apply! lm 0 bch-one)
  (dk-have! (list '= (list 'c bch-zero) 0)
    (lambda ()
      (bch-sb! bch-zero (bch-ac 0 bch-one))
      (bch-sb! (list 'c (bch-ac 0 bch-one)) (list '* 0 (list 'c bch-one)))
      (bch-sb! (list 'c bch-one) 1)
      (crs)))
  ;; two-sided
  (let* ((inst (dk-cite! 'bmx-ideal-intro 'a kk))
         (antes (let loop ((f inst) (acc '()))
                  (if (and (pair? f) (eq? (car f) 'IMPLIES)) (loop (caddr f) (cons (cadr f) acc)) (reverse acc)))))
    (dk-have! (list-ref antes 0)
      (lambda ()
        (let ((iff (dk-cite! 'subset-def kk '(VEC a))))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-peel!)
              (let ((w (cadr (dk-goal))) (l (proof-state-focus *ps*)))
                (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me (list 'IN w kk))))
                (bch-guarded-ass! l))))
          (keep iff (caddr iff))
          (prop))))
    (dk-have! (list-ref antes 1) (lambda () (bch-in-K! 'c bch-zero (lambda () (dk-ass!)))))
    (dk-have! (list-ref antes 2)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (w1 (cadr (cadr g))) (w2 (caddr (cadr g))))
          (bch-out-K! 'c w1) (bch-out-K! 'c w2)
          (bch-cv! 'c w1) (bch-cv! 'c w2)
          (bch-in-K! 'c (bch-ad w1 w2)
            (lambda ()
              (dk-apply! la w1 w2)
              (bch-sb! (list 'c (bch-ad w1 w2)) (list '+ (list 'c w1) (list 'c w2)))
              (bch-sb! (list 'c w1) 0) (bch-sb! (list 'c w2) 0)
              (crs))))))
    (dk-have! (list-ref antes 3)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (z (cadr (cadr g))) (w (caddr (cadr g))))
          (bch-out-K! 'c w) (bch-cv! 'c w)
          (bch-in-K! 'c (bch-ac z w)
            (lambda ()
              (dk-apply! lm z w)
              (bch-sb! (list 'c (bch-ac z w)) (list '* z (list 'c w)))
              (bch-sb! (list 'c w) 0)
              (crs))))))
    (dk-have! (list-ref antes 4)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (y (cadr (cadr g))) (w (caddr (cadr g))))
          (bch-out-K! 'c w) (bch-cv! 'c w) (bch-cv! 'c y)
          (bch-in-K! 'c (bch-mu y w)
            (lambda ()
              (dk-apply! lmul y w)
              (bch-sb! (list 'c (bch-mu y w)) (list '* (list 'c y) (list 'c w)))
              (bch-sb! (list 'c w) 0)
              (crs))))))
    (dk-have! (list-ref antes 5)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (w (cadr (cadr g))) (y (caddr (cadr g))))
          (bch-out-K! 'c w) (bch-cv! 'c w) (bch-cv! 'c y)
          (bch-in-K! 'c (bch-mu w y)
            (lambda ()
              (dk-apply! lmul w y)
              (bch-sb! (list 'c (bch-mu w y)) (list '* (list 'c w) (list 'c y)))
              (bch-sb! (list 'c w) 0)
              (crs))))))
    (dk-apply! inst))
  ;; proper: 1 is not in the kernel
  (dk-have! (cadr (caddr mbody))
    (lambda ()
      (di)
      (dk-have! (list 'IN bch-one kk)
        (lambda () (let ((l (proof-state-focus *ps*))) (subst (list '= kk '(VEC a))) (bch-guarded-ass! l))))
      (bch-out-K! 'c bch-one)
      (let ((e (dk-rewrite-h! (list '= (list 'c bch-one) 0) (list 'c bch-one) 1)))
        (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
        (keep e '(NOT (= 1 0)))
        (prop))))
  ;; maximal: an ideal J above ker(c) with c(y) /= 0 for some y in J contains 1
  (dk-have! (caddr (caddr mbody))
    (lambda ()
      (dk-peel!)
      (let* ((jj (cadr (dk-goal)))
             (parts (bch-and-list (dk-cite! 'bmx-ideal-parts 'a jj)))
             (addj (list-ref parts 2)) (actj (list-ref parts 3)))
        (dk-split-all! (list (dk-cite! 'bmx-ideal-parts 'a jj)))
        (dk-have! (list 'SUBSET jj kk) (lambda ()
        (let ((iff (dk-cite! 'subset-def jj kk)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-peel!)
              (let* ((y (cadr (dk-goal))) (cy (list 'c y)))
                (dk-cite! 'subset-mem-fwd jj '(VEC a) y)
                (bch-cv! 'c y)
                (use-em (list '= cy 0)
                  (lambda () (bch-in-K! 'c y (lambda () (dk-ass!))))
                  (lambda ()
                    (let* ((s (list 'SHIFT-EL 'a cy y))
                           (sx (bch-shift-back! cy y))
                           (z1 (bch-ac cy bch-one)))
                      (bch-cv! 'c s)
                      (dk-cite! 'character-shift-value 'a 'c cy y)
                      (dk-have! (list '= (list '+ cy (list '- cy)) 0) (lambda () (crs)))
                      (dk-have! (list 'IN s kk)
                        (lambda ()
                          (bch-in-K! 'c s
                            (lambda ()
                              (bch-sb! (list 'c s) (list '+ cy (list '- cy)))
                              (dk-ass!)))))
                      (dk-cite! 'subset-mem-fwd kk jj s)
                      (dk-apply! addj s y)
                      (let* ((m1 (dk-rewrite-h! (list 'IN sx jj) sx z1))
                             (r (list 'recip cy)))
                        (bch-cite2! 'cc-recip-closed cy)
                        (bch-cite2! 'cc-recip-inverse cy)
                        (bch-cite2! 'cc-mul-comm r cy)
                        (dk-cite! 'bal-uba-scal-pin 'a)
                        (bch-vt (bch-ac r z1))
                        (dk-apply! actj r z1)
                        (dk-have! (list '= (bch-ac r z1) bch-one)
                          (lambda ()
                            (let ((e (dk-cite! 'rb3-c-act-mul-uba-as-module 'a r cy bch-one))) (subst (list '= (caddr e) (cadr e))))
                            (bch-sb! (list '* r cy) (list '* cy r))
                            (bch-sb! (list '* cy r) 1)
                            (subst (dk-cite! 'bas-act-one 'a bch-one))
                            (rfl)))
                        (dk-rewrite-h! (list 'IN (bch-ac r z1) jj) (bch-ac r z1) bch-one)
                        (dk-cite! 'bmx-one-proper 'a jj)
                        (keep (list '= jj '(VEC a)) (list 'NOT (list '= jj '(VEC a))))
                        (prop))))))))
          (keep iff (caddr iff))
          (prop))))
        (dk-cite! 'bmx-subset-antisym jj kk)
        (dk-ass!))))
  (mac 'IS-MAXIMAL-IDEAL)
  (dk-conj-close! (lambda () (dk-ass!))))
(bch-qed! 'character-kernel-maximal)

;;; a character is determined by its kernel
(sp (bch-st (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a)) (list 'FORALL 'd (list 'IMPLIES '(IN d (CHARACTERS a))
  (list 'IMPLIES (list '= (bch-K 'c) (bch-K 'd)) '(= c d))))))))
(dk-peel!)
(bch-char-open! 'c)
(bch-char-open! 'd)
(dk-fun-ext! 'c 'd '(VEC a) 'CC #f #f
  (lambda (v)
    (let* ((cv (bch-cv! 'c v)) (dv (bch-cv! 'd v)) (s (list 'SHIFT-EL 'a cv v)))
      (bch-vt s)
      (dk-cite! 'character-shift-value 'a 'c cv v)
      (dk-cite! 'character-shift-value 'a 'd cv v)
      (dk-have! (list '= (list '+ cv (list '- cv)) 0) (lambda () (crs)))
      (dk-have! (list 'IN s (bch-K 'c))
        (lambda () (bch-in-K! 'c s (lambda () (bch-sb! (list 'c s) (list '+ cv (list '- cv))) (dk-ass!)))))
      (dk-rewrite-h! (list 'IN s (bch-K 'c)) (bch-K 'c) (bch-K 'd))
      (bch-out-K! 'd s)
      (let* ((e1 (dk-rewrite-h! (list '= (list 'd s) 0) (list 'd s) (list '+ cv (list '- dv))))
             (f0 (list '= cv (list '+ (list '+ cv (list '- dv)) dv))))
        (dk-have! f0 (lambda () (crs)))
        (let ((f1 (dk-rewrite-h! f0 (list '+ cv (list '- dv)) 0)))
          (dk-have! (list '= (list '+ 0 dv) dv) (lambda () (crs)))
          (dk-rewrite-h! f1 (list '+ 0 dv) dv)
          (dk-ass!))))))
(bch-qed! 'character-kernel-injective)

;;; every maximal ideal is a kernel (Corollary 1.11 restated as a set equation)
(sp (bch-mst (list 'FORSOME 'chi (list 'AND '(IN chi (CHARACTERS a)) (list '= (bch-K 'chi) 'ii)))))
(dk-peel!)
(bch-msetup!)
(let* ((ex (dk-cite! 'maximal-ideal-character 'a 'ii))
       (chi (dk-skolem! ex))
       (kf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ii) (dk-contains? h chi))) "the kernel clause")))
  (ew chi)
  (dk-conj-close!
    (lambda ()
      (if (eq? (dk-head (dk-goal)) '=)
          (let ((ce (dk-cite! 'class-extensionality (bch-K chi) 'ii)))
            (dk-have! (cadr ce)
              (lambda ()
                (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
                  (dk-iff! (lambda (g) (equal? g (list 'IN w 'ii)))
                    (lambda ()
                      (bch-out-K! chi w)
                      (let ((i (dk-apply! kf w))) (keep i (list '= (list chi w) 0)) (prop)))
                    (lambda ()
                      (dk-cite! 'subset-mem-fwd 'ii '(VEC a) w)
                      (dk-cite! 'character-in-fun 'a chi)
                      (let ((i (dk-apply! kf w)))
                        (bch-in-K! chi w (lambda () (keep i (list 'IN w 'ii)) (prop)))))))))
            (dk-apply! ce)
            (dk-ass!))
          (dk-ass!)))))
(bch-qed! 'maximal-ideal-kernel)


;;; ==== F. THE SPECTRUM IS THE RANGE OF THE GELFAND TRANSFORM (Proposition 1.16) ==================
;;; the principal ideal A s = { b s : b in A }
(define (bch-P x) (list 'SEP 'bcpw_ '(VEC a)
  (list 'FORSOME 'bcpb_ (list 'AND '(IN bcpb_ (VEC a)) (list '= 'bcpw_ (bch-mu 'bcpb_ x))))))
;;; w in P(x) in context: land w in VEC a and w = b x; return b
(define (bch-out-P! w x)
  (let* ((pp (bch-P x)) (m (list 'IN w pp))
         (cnd (subst-free 'bcpw_ w (cadddr pp))))
    (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me m)))
    (dk-project! cnd (lambda () (sep-me m)))
    (dk-skolem! cnd)))
;;; the goal (IN w P(x)): witness b; EQ! proves w = b x
(define (bch-in-P! w b x eq!)
  (bch-vt w) (bch-vt b)
  (let ((e (list '= w (bch-mu b x))))
    (if (not (dk-asm? e)) (dk-have! e eq!))
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin (dk-focus! l)
                           (if (eq? (dk-head (dk-goal)) 'FORSOME)
                               (begin (ew b) (dk-conj-close! (lambda () (dk-ass!))))
                               (dk-ass!)))))
              (dk-opened (lambda () (sep-mi))))))
(define (bch-sub-close! g)  ; prove SUBSET A (VEC a) for a SEP over VEC a, A = g
  (let ((iff (dk-cite! 'subset-def g '(VEC a))))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-peel!)
        (let ((w (cadr (dk-goal))) (l (proof-state-focus *ps*)))
          (dk-project! (list 'IN w '(VEC a)) (lambda () (sep-me (list 'IN w g))))
          (bch-guarded-ass! l))))
    (keep iff (caddr iff))
    (prop)))

(sp (bch-cst (bch-fa 's '(VEC a) (list 'IS-TWO-SIDED-IDEAL 'a (bch-P 's)))))
(dk-peel!)
(dk-cite! 'bch-comm-uba 'a)
(dk-cite! 'bal-uba-scal-pin 'a)
(let* ((pp (bch-P 's))
       (inst (dk-cite! 'bmx-ideal-intro 'a pp))
       (antes (let loop ((f inst) (acc '()))
                (if (and (pair? f) (eq? (car f) 'IMPLIES)) (loop (caddr f) (cons (cadr f) acc)) (reverse acc)))))
  (dk-have! (list-ref antes 0) (lambda () (bch-sub-close! pp)))
  (dk-have! (list-ref antes 1)
    (lambda ()
      (dk-cite! 'ring-mul-zero-left-uba-as-ring 'a 's)
      (bch-in-P! bch-zero bch-zero 's
        (lambda () (bch-sb! (bch-mu bch-zero 's) bch-zero) (rfl)))))
  (dk-have! (list-ref antes 2)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (w1 (cadr (cadr g))) (w2 (caddr (cadr g)))
             (b1 (bch-out-P! w1 's)) (b2 (bch-out-P! w2 's)))
        (bch-vt (bch-ad b1 b2))
        (dk-cite! 'ring-right-dist-uba-as-ring 'a b1 b2 's)
        (bch-in-P! (bch-ad w1 w2) (bch-ad b1 b2) 's
          (lambda ()
            (bch-sb! w1 (bch-mu b1 's)) (bch-sb! w2 (bch-mu b2 's))
            (bch-sb! (bch-mu (bch-ad b1 b2) 's) (bch-ad (bch-mu b1 's) (bch-mu b2 's)))
            (rfl))))))
  (dk-have! (list-ref antes 3)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (z (cadr (cadr g))) (w (caddr (cadr g)))
             (b (bch-out-P! w 's)))
        (dk-cite! 'rb3-c-in-carr-uba-as-module 'a z)
        (bch-vt (bch-ac z b)) (bch-vt (bch-mu b 's))
        (dk-cite! 'bal-uba-vmul-act-left 'a z b 's)
        (bch-in-P! (bch-ac z w) (bch-ac z b) 's
          (lambda ()
            (bch-sb! w (bch-mu b 's))
            (bch-sb! (bch-mu (bch-ac z b) 's) (bch-ac z (bch-mu b 's)))
            (rfl))))))
  (dk-have! (list-ref antes 4)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (y (cadr (cadr g))) (w (caddr (cadr g)))
             (b (bch-out-P! w 's)))
        (bch-vt (bch-mu y b))
        (dk-cite! 'ring-mul-assoc-uba-as-ring 'a y b 's)
        (bch-in-P! (bch-mu y w) (bch-mu y b) 's
          (lambda ()
            (bch-sb! w (bch-mu b 's))
            (bch-sb! (bch-mu (bch-mu y b) 's) (bch-mu y (bch-mu b 's)))
            (rfl))))))
  (dk-have! (list-ref antes 5)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (w (cadr (cadr g))) (y (caddr (cadr g)))
             (b (bch-out-P! w 's)))
        (bch-vt (bch-mu b y)) (bch-vt (bch-mu 's y)) (bch-vt (bch-mu y 's))
        (dk-cite! 'ring-mul-assoc-uba-as-ring 'a b 's y)
        (dk-cite! 'ring-mul-assoc-uba-as-ring 'a b y 's)
        (dk-cite! 'bch-comm 'a 's y)
        (bch-in-P! (bch-mu w y) (bch-mu b y) 's
          (lambda ()
            (bch-sb! w (bch-mu b 's))
            (bch-sb! (bch-mu (bch-mu b 's) y) (bch-mu b (bch-mu 's y)))
            (bch-sb! (bch-mu (bch-mu b y) 's) (bch-mu b (bch-mu y 's)))
            (bch-sb! (bch-mu 's y) (bch-mu y 's))
            (rfl))))))
  (dk-apply! inst)
  (dk-ass!))
(bch-qed! 'principal-ideal-two-sided)

;;; a non-invertible element lies in a maximal ideal
(sp (bch-cst (bch-fa 's '(VEC a) (list 'IMPLIES '(NOT (IS-INVERTIBLE-EL a s))
  (list 'FORSOME 'mm (list 'AND '(IS-MAXIMAL-IDEAL a mm) '(IN s mm)))))))
(dk-peel!)
(dk-cite! 'bch-comm-uba 'a)
(let* ((pp (bch-P 's)))
  (dk-cite! 'principal-ideal-two-sided 'a 's)
  (dk-have! (list 'NOT (list '= pp '(VEC a)))
    (lambda ()
      (di)
      (bch-vt bch-one)
      (dk-have! (list 'IN bch-one pp)
        (lambda () (let ((l (proof-state-focus *ps*))) (subst (list '= pp '(VEC a))) (bch-guarded-ass! l))))
      (let* ((b (bch-out-P! bch-one 's)))
        (bch-vt (bch-mu b 's)) (bch-vt (bch-mu 's b))
        (dk-cite! 'bch-comm 'a 's b)
        (dk-have! (list '= (bch-mu b 's) bch-one)
          (lambda () (bch-sb! (bch-mu b 's) bch-one) (rfl)))
        (dk-have! (list '= (bch-mu 's b) bch-one)
          (lambda () (bch-sb! (bch-mu 's b) (bch-mu b 's)) (bch-sb! (bch-mu b 's) bch-one) (rfl)))
        (dk-cite! 'bae-invertible-intro 'a 's b)
        (keep '(IS-INVERTIBLE-EL a s) '(NOT (IS-INVERTIBLE-EL a s)))
        (prop))))
  (let* ((ex (dk-cite! 'maximal-ideal-exists 'a pp))
         (mm (dk-skolem! ex #t)))
    (dk-cite! 'bal-uba-vone-left 'a 's)
    (dk-have! (list 'IN 's pp)
      (lambda () (bch-in-P! 's bch-one 's (lambda () (bch-sb! (bch-mu bch-one 's) 's) (rfl)))))
    (dk-cite! 'subset-mem-fwd pp mm 's)
    (ew mm)
    (dk-conj-close! (lambda () (dk-ass!)))))
(bch-qed! 'noninvertible-in-maximal-ideal)

;;; z in sigma(x) => z = chi(x) for some character chi
(sp (bch-cst (bch-fa 'x '(VEC a) (list 'FORALL 'z (list 'IMPLIES '(IN z (SPECTRUM a x))
  (list 'FORSOME 'chi (list 'AND '(IN chi (CHARACTERS a)) '(= (chi x) z))))))))
(dk-peel!)
(dk-cite! 'bch-comm-uba 'a)
(let* ((sx (caddr (dk-cite! 'bas-spectrum-unfold 'a 'x)))
       (m1 (dk-rewrite-h! '(IN z (SPECTRUM a x)) '(SPECTRUM a x) sx))
       (s '(SHIFT-EL a z x)))
  (dk-project! '(IN z CC) (lambda () (sep-me m1)))
  (dk-project! (list 'NOT (list 'IS-INVERTIBLE-EL 'a s)) (lambda () (sep-me m1)))
  (bch-vt s)
  (let* ((mm (dk-skolem! (dk-cite! 'noninvertible-in-maximal-ideal 'a s) #t))
         (chi (dk-skolem! (dk-cite! 'maximal-ideal-kernel 'a mm) #t))
         (kk (bch-K chi)))
    (dk-cite! 'character-in-fun 'a chi)
    (let ((cx (bch-cv! chi 'x)))
      (bch-cv! chi s)
      (dk-cite! 'character-shift-value 'a chi 'z 'x)
      (dk-rewrite-h! (list 'IN s mm) mm kk)
      (bch-out-K! chi s)
      (let* ((e1 (dk-rewrite-h! (list '= (list chi s) 0) (list chi s) (list '+ 'z (list '- cx))))
             (f0 (list '= cx (list '+ 'z (list '- (list '+ 'z (list '- cx)))))))
        (dk-have! f0 (lambda () (crs)))
        (let ((f1 (dk-rewrite-h! f0 (list '+ 'z (list '- cx)) 0)))
          (dk-have! (list '= (list '+ 'z (list '- 0)) 'z) (lambda () (crs)))
          (dk-rewrite-h! f1 (list '+ 'z (list '- 0)) 'z)
          (ew chi)
          (dk-conj-close! (lambda () (dk-ass!))))))))
(bch-qed! 'spectrum-character-value)

;;; the characters form a set, and the Gelfand transform of x is a function on them
(sp (bch-st '(IN (CHARACTERS a) SET)))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(dk-cite! 'cc-is-set)
(dk-have! '(IN (FUN (VEC a) CC) SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (dk-ass!)))))
(subst (dk-cite! 'bas-characters-unfold 'a))
(sep-set)
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (dk-ass!)))) (dk-open-leaves))
(bch-qed! 'characters-in-set)

(sp (bch-st (bch-fa 'x '(VEC a) '(IN ((GELFAND-TRANSFORM a) x) (FUN (CHARACTERS a) CC)))))
(dk-peel!)
(dk-cite! 'characters-in-set 'a)
(mac 'GELFAND-TRANSFORM)
(dk-lam-b!)
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (if (not (dk-ass!))
              (begin
                (if (memq (dk-head (dk-goal)) '(FORALL IMPLIES)) (dk-peel!))
                (let* ((g (dk-goal)) (c (car (cadr g))))
                  (dk-cite! 'character-in-fun 'a c)
                  (bch-cv! c 'x)
                  (dk-ass!)))))))
  (dk-opened (lambda () (lam-t))))
(bch-qed! 'gelfand-transform-in-fun)

;;; sigma(x) = the range of the Gelfand transform of x
(sp (bch-cst (bch-fa 'x '(VEC a) (list '= '(SPECTRUM a x) '(IMAGE ((GELFAND-TRANSFORM a) x) (CHARACTERS a))))))
(dk-peel!)
(dk-cite! 'bch-comm-uba 'a)
(let* ((gx '((GELFAND-TRANSFORM a) x))
       (img (list 'IMAGE gx '(CHARACTERS a)))
       (ce (begin (dk-cite! 'gelfand-transform-in-fun 'a 'x)
                  (dk-cite! 'cc-is-set)
                  (dk-cite! 'fun-image-set '(CHARACTERS a) 'CC gx '(CHARACTERS a))
                  (dk-cite! 'class-extensionality '(SPECTRUM a x) img))))
  (dk-have! (cadr ce)
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN w img)))
          (lambda ()
            (let* ((iff (dk-cite! 'image-membership-iff gx '(CHARACTERS a) w))
                   (ex (dk-cite! 'spectrum-character-value 'a 'x w))
                   (sx (caddr (dk-cite! 'bas-spectrum-unfold 'a 'x))))
              (dk-have! (list 'IN w 'CC)
                (lambda ()
                  (let ((m1 (dk-rewrite-h! (list 'IN w '(SPECTRUM a x)) '(SPECTRUM a x) sx))
                        (l (proof-state-focus *ps*)))
                    (dk-project! (list 'IN w 'CC) (lambda () (sep-me m1)))
                    (bch-guarded-ass! l))))
              (dk-cite! 'membership-implies-sethood w 'CC)
              (let ((chi (dk-skolem! ex #t)))
                (dk-cite! 'gelfand-transform-value 'a 'x chi)
                (dk-have! (caddr iff)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (eq? (dk-head (dk-goal)) 'FORSOME)
                            (begin (ew chi)
                                   (dk-conj-close!
                                     (lambda ()
                                       (if (eq? (dk-head (dk-goal)) '=)
                                           (let ((l (proof-state-focus *ps*)))
                                             (bch-sb! (list gx chi) (list chi 'x))
                                             (bch-guarded-ass! l))
                                           (dk-ass!)))))
                            (dk-ass!))))))
                (keep iff (caddr iff))
                (prop))))
          (lambda ()
            (let* ((iff (dk-cite! 'image-membership-iff gx '(CHARACTERS a) w)))
              (dk-have! (caddr iff) (lambda () (keep iff (list 'IN w img)) (prop)))
              (dk-split-all! (list (caddr iff)))
              (let* ((exf (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h gx))) "the image witness"))
                     (chi (dk-skolem! exf #t)))
                (dk-cite! 'gelfand-transform-value 'a 'x chi)
                (dk-cite! 'character-value-in-spectrum 'a 'x chi)
                (let ((l (proof-state-focus *ps*)))
                  (bch-sb! w (list gx chi))
                  (if (not (sequent-node-grounded? l))
                      (begin (bch-sb! (list gx chi) (list chi 'x)) (bch-guarded-ass! l)))))))))))
  (dk-apply! ce)
  (dk-ass!))
(bch-qed! 'gelfand-range-spectrum)


;;; ==== G. A CHARACTER HAS NORM EXACTLY 1 (Remark 1.13, last sentence) ========================
;;; S = { |c(y)| : ||y|| <= 1 } is the set whose ESUP is CDUAL-NORM(a, c); read off the goal
(define (bch-ns-parts S) (list (cadr S) (caddr S)))   ; (L B)
;;; w in S in context: land y in B, y in VEC a, ||y|| <= 1, |c(y)| = w; return y
(define (bch-out-S! c S w)
  (let* ((L (cadr S)) (B (caddr S))
         (iff (dk-cite! 'image-membership-iff L B w))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (keep iff (list 'IN w S)) (prop)))
    (dk-split-all! (list rhs))
    (let* ((y (dk-skolem! (caddr rhs) #t))
           (cy (list c y)) (m (list 'MAGNITUDE cy)))
      (dk-project! (list 'IN y '(VEC a)) (lambda () (sep-me (list 'IN y B))))
      (dk-project! (subst-free (cadr B) y (cadddr B)) (lambda () (sep-me (list 'IN y B))))
      (bch-cv! c y)
      (dk-cite! 'cc-magnitude-closed cy)
      (dk-have! (list '= (list L y) m)
        (lambda () (if (not (dk-lam-b!)) (rfl))))
      (dk-rewrite-h! (list '= (list L y) w) (list L y) m)
      y)))
(define (bch-pos-star! t)  ; t in RR and 0 <= t in context: land t in RR-POS-STAR
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR-POS-STAR) (lambda () (keep iff (list 'IN t 'RR) (list '<= 0 t)) (prop)))))

(sp (bch-st (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a)) '(= (CDUAL-NORM a c) 1)))))
(dk-peel!)
(let ((laws (bch-char-open! 'c)))
  (mac 'CDUAL-NORM)
  (let* ((S (cadr (cadr (dk-goal)))) (L (cadr S)) (B (caddr S)) (es (list 'ESUP S)))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(<= 0 1) (lambda () (arith)))
    (bch-pos-star! 1)
    ;; S lies in RR-POS-STAR
    (dk-have! (list 'SUBSET S 'RR-POS-STAR)
      (lambda ()
        (let ((iff (dk-cite! 'subset-def S 'RR-POS-STAR)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-peel!)
              (let* ((w (cadr (dk-goal))) (l (proof-state-focus *ps*))
                     (y (bch-out-S! 'c S w)) (m (list 'MAGNITUDE (list 'c y))))
                (dk-cite! 'cc-magnitude-closed (list 'c y))
                (dk-cite! 'cc-magnitude-nonneg (list 'c y))
                (bch-pos-star! m)
                (dk-rewrite-h! (list 'IN m 'RR-POS-STAR) m w)
                (bch-guarded-ass! l))))
          (keep iff (caddr iff))
          (prop))))
    ;; 1 bounds S
    (dk-have! (list 'FORALL 'bnx_ (list 'IMPLIES (list 'IN 'bnx_ S) '(<= bnx_ 1)))
      (lambda ()
        (dk-peel!)
        (let* ((w (cadr (dk-goal))) (l (proof-state-focus *ps*))
               (y (bch-out-S! 'c S w)) (m (list 'MAGNITUDE (list 'c y)))
               (ny (list '(VNRM a) y)))
          (dk-cite! 'cc-magnitude-closed (list 'c y))
          (dk-cite! 'bae-vnrm-type 'a y)
          (dk-cite! 'character-bounded 'a 'c y)
          (dk-have! (list '<= m 1) (lambda () (dk-ineq! (list '<= m ny) (list '<= ny 1))))
          (dk-rewrite-h! (list '<= m 1) m w)
          (bch-guarded-ass! l))))
    ;; 1 is in S (at y = 1)
    (dk-have! (list 'IN 1 S)
      (lambda ()
        (let* ((iff (dk-cite! 'image-membership-iff L B 1)))
          (dk-cite! 'membership-implies-sethood 1 'RR)
          (bch-vt bch-one)
          (dk-cite! 'bal-uba-vone-norm 'a)
          (bch-cv! 'c bch-one)
          (dk-cite! 'cc-magnitude-one)
          (dk-cite! 'cc-magnitude-closed (list 'c bch-one))
          (dk-have! (list 'IN bch-one B)
            (lambda ()
              (for-each (lambda (lf)
                          (if (not (sequent-node-grounded? lf))
                              (begin (dk-focus! lf)
                                     (if (not (dk-ass!))
                                         (begin (bch-sb! (list '(VNRM a) bch-one) 1) (arith))))))
                        (dk-opened (lambda () (sep-mi))))))
          (dk-have! (list '= (list L bch-one) 1)
            (lambda ()
              (let ((lf (proof-state-focus *ps*)))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? lf))
                    (begin (bch-sb! (list 'c bch-one) 1)
                           (bch-sb! '(MAGNITUDE 1) 1)
                           (rfl))))))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (eq? (dk-head (dk-goal)) 'FORSOME)
                      (begin (ew bch-one) (dk-conj-close! (lambda () (dk-ass!))))
                      (dk-ass!))))))
          (keep iff (caddr iff))
          (prop))))
    (dk-cite! 'esup-in S)
    (dk-cite! 'esup-upper S 1)
    (bch-cite2! 'esup-least S 1)
    (let* ((r (dk-cite! 'rr-pos-star-le-antisymm es 1))
           (r2 (if (and (pair? r) (eq? (car r) 'IMPLIES))
                   (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                   r))
           (r3 (if (and (pair? r2) (eq? (car r2) 'IMPLIES))
                   (detach-with! r2 (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                   r2)))
      (dk-ass!))))
(bch-qed! 'character-norm-one)

