          (subst (list '= (list 'VONE bch-Q) (bch-cl bch-one)))
          (subst (list '= 'c (bch-cl x)))
          (subst (list '= (list bch-QVMUL (bch-cl x) u) (bch-cl xb)))
          (subst (dk-cite! 'bch-comm 'a x b))
