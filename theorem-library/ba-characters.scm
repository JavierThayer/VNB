       (e3 (dk-cite! 'qba-ro-vzero 'a 'ii)) (e4 (dk-cite! 'qmod-ro-vzero-uba-as-module 'a 'ii))
       (h1 (dk-rewrite-h! (list 'IN 'c (list 'VEC bch-Q)) (list 'VEC bch-Q) (list 'VEC bch-QM)))
       (h2 (dk-rewrite-h! h1 (list 'VEC bch-QM) bch-QS))
