;;; ba-characters.scm -- BANACH ALGEBRAS: maximal ideals and characters.
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 1: Corollary 1.11 / Remark 1.12
;;; (A/M is C, hence a character with kernel M), Remark 1.13 (the bijection between characters and
;;; maximal ideals), Proposition 1.16 (the range of G(x) is sigma(x)).
;;; Agent BA-1G, wave 2026-11-09.  Destination: theorem-library/ba-characters.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: bch-.
;;;
;;; PLAN.
;;;  * A maximal ideal of a COMMUTATIVE algebra is a maximal LEFT ideal (every left ideal is
;;;    two-sided), hence closed (maximal-left-ideal-closed, BA-1B), so A/M = QUOTIENT-BA(a, M) is a
;;;    unital Banach algebra (quotient-ba-is-uba-proper, BA-1E).
;;;  * A/M is a field: for x not in M, the ideal G(M, x) = {w : w = b x mod M} is two-sided
;;;    (commutativity), contains M and x, so it is everything by maximality; 1 = b x mod M.  The
;;;    ideal laws of G(M, x) are proved in A/M (class arithmetic), with no subtraction algebra.
;;;  * Gelfand-Mazur (BA-1D) on A/M: every coset is z (1 + M), z unique (scalar-embedding-injective
;;;    on A/M).  chi(x) := the z with x + M = z 1 + M is a character with kernel M (1.12).
;;;  * The kernel of a character is a maximal ideal; a character is determined by its kernel (1.13).
;;;  * z in sigma(x): s = z 1 - x lies in the principal ideal A s = {b s}, proper since s is not
;;;    invertible (commutativity), hence in a maximal ideal (maximal-ideal-exists, BA-1D), whose
;;;    character takes the value z at x; with character-value-in-spectrum, sigma(x) = range G(x) (1.16).
;;;  * A character has norm exactly 1 (CDUAL-NORM, an ESUP over the unit ball; 1.13), and the quotient
;;;    norm of A/M is the absolute value (1.12).
;;;
;;; LOAD WINDOW: after BA-1's ba-vocab, ba-laws, ba-elem, ba-neumann, ba-spectrum; BA-1B's
;;; ba-ideal-closure (maximal-left-ideal-closed), ba-gelfand-mazur (scalar-embedding-injective),
;;; ba-gelfand (character-value-in-spectrum, gelfand-transform-value); BA-1D's
;;; ba-spectrum-nonempty (gelfand-mazur), ba-maximal-ideal (maximal-ideal-exists, bmx-*);
;;; BA-1E's ba-quotient-na-vocab and ba-quotient-na (quotient-ba-is-uba-proper, qba-ro-*,
;;; qna-vmul-computes, qba-vone-norm, ba-left-ideal-submodule); the tree's la-z3 (qmod-*).

(define (bch-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-characters: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (write (dk-goal-of l)) (newline)
                    (for-each (lambda (h) (display "      asm: ") (write h) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-characters: unfinished" name))))

(define (bch-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bch-cst body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-BANACH-ALGEBRA a) body))))
(define bch-one '(VONE a))
(define bch-zero '(VZERO a))
(define (bch-ad x y) (list '(VADD a) x y))
(define (bch-ng x) (list '(VNEG a) x))
(define (bch-mu x y) (list '(VMUL a) x y))
(define (bch-ac z x) (list '(ACT a) z x))
(define (bch-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))

;;; type a vector expression of a (IS-UNITAL-BANACH-ALGEBRA a in context)
(define (bch-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bch-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bch-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bch-vt (cadr x)) (bch-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bch-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bch-vt (cadr x)) (bch-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bch-vt (caddr x))
           (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'SHIFT-EL))
           (bch-vt (cadddr x)) (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          (#t (error "bch-vt: cannot type" (expression->string x))))))

