    (bch-guarded-ass! l)))
(bch-qed! 'bch-chi-unique)

(define (bch-unique! t w claim-proof!)
  (dk-have! (list '= (bch-cl t) (bch-cl (bch-ac w bch-one))) claim-proof!)
