      (dk-cite! 'qna-vmul-computes 'a 'ii b x)
      (dk-cite! 'qna-vmul-computes 'a 'ii x b)
      (bch-clq! bx)
      (dk-have! (list '= (list (list 'VMUL bch-Q) u 'c) (list 'VONE bch-Q))
        (lambda ()
          (subst (list '= (list 'VMUL bch-Q) bch-QVMUL))
          (subst (list '= (list 'VONE bch-Q) (bch-cl bch-one)))
          (subst (list '= 'c (bch-cl x)))
          (subst (list '= (list bch-QVMUL u (bch-cl x)) (bch-cl bx)))
