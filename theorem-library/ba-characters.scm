;;; uniqueness: t + M = w 1 + M implies chi_M(t) = w
(sp (bch-mst (bch-fa 't '(VEC a) (bch-fa 'w 'CC (list 'IMPLIES
       (list '= (bch-cl 't) (bch-cl (bch-ac 'w bch-one))) (list '= (bch-io 't) 'w))))))
(dk-peel!)
(bch-msetup!)
(let* ((io (bch-io 't)) (v (bch-val! 't)))
  (dk-rewrite-h! (list '= (bch-cl 't) (bch-cl (bch-ac 'w bch-one))) (bch-cl 't) (bch-cl (bch-ac v bch-one)))
  (dk-cite! 'maximal-quotient-scalar-unique 'a 'ii v 'w)
  (let ((l (proof-state-focus *ps*)))
