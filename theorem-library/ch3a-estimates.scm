;;; ch3a-estimates.scm -- Cauchy's estimates with the full radius (Corollary 3.48 of the complex
;;; analysis notes) (CH3-A, 2026-10-26).  Destination: theorem-library/ch3a-estimates.scm,
;;; library complex-analysis (the real lemma rr-le-of-power-bounds is analysis vocabulary only).
;;;
;;;   holomorphic-nth-deriv      every derivative nth-deriv-on(CC, u, f, k) of a holomorphic f is
;;;                              holomorphic on u (induction, holomorphic-deriv-holomorphic)
;;;   rr-le-of-power-bounds      0 <= x, x r^k <= C for every r in (rho, R) ==> x R^k <= C
;;;                              (Bernoulli: r = R (1 - t), r^k >= R^k (1 - k t))
;;;   cauchy-estimates-on-ball   |f^(k)(a)| <= k! M R^-k when |f| <= M on B(a, R), f^(k) read on a sub-ball
;;; Helper prefix ces-.
;;; ======================================================================
(define (ces-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (ces-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))

;;; ======================================================================
;;; (1) the derivatives of a holomorphic function are holomorphic
;;; ======================================================================
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (HOLOMORPHIC-ON u (NTH-DERIV-ON CC-NORMED-FIELD u f k)))))))))
(ni)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (not (dk-contains? (dk-goal) 'succ))
       (begin
         (dk-peel!)
         (let ((u (cadr (dk-goal))) (nth (caddr (dk-goal))))
           (subst (dk-cite! 'nth-deriv-on-zero 'CC-NORMED-FIELD u (cadddr nth)))
           (ass)))
       (let* ((landed (dk-peel!))
              (k (dk-landed-var landed 'NN))
              (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (not (dk-contains? fm 'succ)))) landed)))
              (g (dk-goal))
              (u (cadr g))
              (f (cadddr (caddr g)))
              (nk (list 'NTH-DERIV-ON 'CC-NORMED-FIELD u f k)))
         (dk-apply! ih u f)
         (dk-cite! 'holomorphic-deriv-holomorphic u nk)
         (subst (dk-cite! 'nth-deriv-on-succ 'CC-NORMED-FIELD u f k))
         (ass))))
 (dk-open-leaves))
(qed 'holomorphic-nth-deriv)
(topic! 'holomorphic-nth-deriv 'analysis)

;;; ======================================================================
;;; (2) a real lemma: bounds x r^k <= C for r in (lo, hi) give x hi^k <= C (x >= 0)
;;; ======================================================================
(define (ces-and! a b) (if (not (dk-asm? (list 'AND a b))) (dk-have! (list 'AND a b) (lambda () (dk-conj-close!)))))
(define (ces-pos! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (let ((pi (dk-cite! 'pos-rr c)))
        (dk-have! (caddr pi)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        ((dk-head-is? g '<=) (dk-ineq! (list '< 0 c)))
                        (#t (di) (dk-absurd! (list '= 0 c) (list '< 0 c)))))))))
        (dk-have! (list 'POS-RR c) (lambda () (prop))))))
;; recip(a) for a in RR with 0 < a: typed, positive, a * recip(a) = 1
(define (ces-recip! a)
  (let ((ra (list 'recip a)))
    (if (not (dk-asm? (list 'IN ra 'RR)))
        (begin
          (dk-have! (list 'NOT (list '= a 0)) (lambda () (di) (dk-absurd! (list '= a 0) (list '< 0 a))))
          (ces-and! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
          (fact 'rr-recip-closed a)
          (fact 'rr-recip-inverse a)
          (dk-cite! 'rr-recip-pos a)))
    ra))
;; a <= b, 0 <= c ==> a*c <= b*c, products typed
(define (ces-mul-le! a b c)
  (ces-rr! (list '* a c)) (ces-rr! (list '* b c))
  (dk-cite! 'rr-mul-le-right a b c))
(define (ces-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin (ces-and! (list 'IN a 'NN) (list 'IN b 'NN)) (fact 'nn-add-closed a b))))
;; e1, e2 positive reals: t = recip(n+1), 0 < t, t < e1, t < e2, t <= 1
(define (ces-small! e1 e2)
  (ces-pos! e1) (ces-pos! e2)
  (let* ((n1 (dk-skolem! (dk-cite! 'nn-recip-succ-small e1)))
         (_1 (dk-split-all!))
         (n2 (dk-skolem! (dk-cite! 'nn-recip-succ-small e2)))
         (_2 (dk-split-all!))
         (n (list '+ n1 n2))
         (r1 (list 'recip (list '+ n1 1)))
         (r2 (list 'recip (list '+ n2 1)))
         (t (list 'recip (list '+ n 1))))
    (ces-nn-add! n1 n2)
    (for-each (lambda (m) (let ((r (list 'recip (list '+ m 1))))
                            (if (not (dk-asm? (list 'IN r 'RR)))
                                (begin (dk-cite! 'nn-recip-succ-pos m) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)))))
              (list n1 n2 n))
    (dk-have! (list '<= n1 n) (lambda () (dk-nn!)))
    (dk-have! (list '<= n2 n) (lambda () (dk-nn!)))
    (dk-cite! 'nn-recip-succ-antitone n1 n)
    (dk-cite! 'nn-recip-succ-antitone n2 n)
    (fact 'nn-zero-in)
    (dk-have! (list '<= 0 n) (lambda () (dk-nn!)))
    (dk-cite! 'nn-recip-succ-antitone 0 n)
    (fact 'rr-recip-one)
    (dk-have! '(= (+ 0 1) 1) (lambda () (crs)))
    (dk-rewrite-h! (list '<= t '(recip (+ 0 1))) '(+ 0 1) 1)
    (dk-rewrite-h! (list '<= t '(recip 1)) '(recip 1) 1)
    (dk-have! (list '< t e1) (lambda () (dk-ineq! (list '<= t r1) (list '< r1 e1))))
    (dk-have! (list '< t e2) (lambda () (dk-ineq! (list '<= t r2) (list '< r2 e2))))
    t))

(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL xv (IMPLIES (IN xv RR) (FORALL cv (IMPLIES (IN cv RR)
  (FORALL lo (IMPLIES (IN lo RR) (FORALL hi (IMPLIES (IN hi RR)
    (IMPLIES (<= 0 xv) (IMPLIES (< 0 lo) (IMPLIES (< lo hi)
      (IMPLIES (FORALL r (IMPLIES (IN r RR) (IMPLIES (< lo r) (IMPLIES (< r hi) (<= (* xv (power r k)) cv)))))
        (<= (* xv (power hi k)) cv)))))))))))))))))
(dk-peel!)
(define ces-2-H (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'lo))) "the bounds"))
(fact 'nn-in-rr 'k)
(fact 'nn-zero-le 'k)
(fact 'rr-one-in)
(define ces-Q '(power hi k))
(define ces-X (list '* 'xv ces-Q))
(define ces-A (list '* ces-X 'k))
(ces-rr! ces-Q)
(dk-have! '(< 0 hi) (lambda () (dk-ineq! '(< 0 lo) '(< lo hi))))
(dk-cite! 'rr-power-pos 'hi 'k)
(dk-have! (list '<= 0 ces-Q) (lambda () (dk-ineq! (list '< 0 ces-Q))))
(ces-mul-le! 0 'xv ces-Q)
(dk-have! (list '= (list '* 0 ces-Q) 0) (lambda () (crs)))
(ces-rr! ces-X)
(dk-have! (list '<= 0 ces-X) (lambda () (dk-ineq! (list '<= (list '* 0 ces-Q) ces-X) (list '= (list '* 0 ces-Q) 0))))
(ces-mul-le! 0 ces-X 'k)
(dk-have! (list '= (list '* 0 'k) 0) (lambda () (crs)))
(ces-rr! ces-A)
(dk-have! (list '<= 0 ces-A) (lambda () (dk-ineq! (list '<= (list '* 0 'k) ces-A) (list '= (list '* 0 'k) 0))))
(let ((ch (dk-cite! 'rr-le-of-le-add-all-pos ces-X 'cv)))
  (dk-chain! ch
    (lambda (ante)
      (lambda ()
        (let* ((d (dk-landed-eps (dk-peel!)))
               (A ces-A) (X ces-X) (Q ces-Q)
               (A1 (list '+ A 1)))
          (fact 'rr-pos-rr-in-rr d) (fact 'rr-lt-of-pos-rr d)
          (ces-rr! A1)
          (dk-have! (list '< 0 A1) (lambda () (dk-ineq! (list '<= 0 A))))
          (let* ((iA (ces-recip! A1))
                 (e2 (list '* d iA))
                 (iR (ces-recip! 'hi))
                 (dl '(- hi lo))
                 (e1 (list '* dl iR)))
            (ces-rr! e2) (dk-cite! 'rr-mul-pos d iA)
            (ces-rr! dl) (dk-have! (list '< 0 dl) (lambda () (dk-ineq! '(< lo hi))))
            (ces-rr! e1) (dk-cite! 'rr-mul-pos dl iR)
            (let* ((en1 (dk-name! e1)))
              (dk-have! (list '< 0 en1) (lambda () (dk-ineq! (list '= en1 e1) (list '< 0 e1))))
              (dk-have! (list '= (list '* 'hi en1) dl)
                (lambda ()
                  (subst (list '= en1 e1))
                  (dk-have! (list '= (list '* 'hi e1) (list '* dl (list '* 'hi iR))) (lambda () (dk-crs-opaque!)))
                  (subst (list '= (list '* 'hi e1) (list '* dl (list '* 'hi iR))))
                  (subst (list '= (list '* 'hi iR) 1))
                  (crs)))
              (let* ((t (ces-small! en1 e2))
                     (omt (list '- 1 t))
                     (r (list '* 'hi omt))
                     (nt (list '- t))
                     (B (list 'power omt 'k))
                     (L (list '+ 1 (list '* 'k nt))))
                (ces-rr! omt) (ces-rr! r) (ces-rr! nt) (ces-rr! B) (ces-rr! L)
                (dk-have! (list '<= 0 omt) (lambda () (dk-ineq! (list '<= t 1))))
                ;; lo < r < hi
                (ces-rr! (list '* 'hi t))
                (dk-cite! 'rr-mul-pos 'hi t)
                (dk-have! (list '= (list '- 'hi r) (list '* 'hi t)) (lambda () (crs)))
                (ces-rr! (list '- en1 t))
                (dk-have! (list '< 0 (list '- en1 t)) (lambda () (dk-ineq! (list '< t en1))))
                (ces-rr! (list '* 'hi (list '- en1 t)))
                (dk-cite! 'rr-mul-pos 'hi (list '- en1 t))
                (ces-rr! (list '* 'hi en1))
                (dk-have! (list '= (list '* 'hi (list '- en1 t)) (list '- (list '* 'hi en1) (list '* 'hi t))) (lambda () (crs)))
                (dk-have! (list '< r 'hi) (lambda () (dk-ineq! (list '= (list '- 'hi r) (list '* 'hi t)) (list '< 0 (list '* 'hi t)))))
                (dk-have! (list '< 'lo r)
                  (lambda () (dk-ineq! (list '= (list '- 'hi r) (list '* 'hi t)) (list '< 0 (list '* 'hi (list '- en1 t)))
                                       (list '= (list '* 'hi (list '- en1 t)) (list '- (list '* 'hi en1) (list '* 'hi t)))
                                       (list '= (list '* 'hi en1) dl))))
                (dk-apply! ces-2-H r)
                ;; r^k = hi^k (1 - t)^k >= hi^k (1 - k t)
                (dk-cite! 'rr-power-mul-base 'k 'hi omt)
                (let ((hr (dk-pick (lambda (fm) (and (dk-head-is? fm '<=) (equal? (cadr fm) (list '* 'xv (list 'power r 'k))))) "x r^k <= C")))
                  (dk-rewrite-h! hr (list 'power r 'k) (list '* Q B)))
                (dk-have! (list '<= -1 nt) (lambda () (dk-ineq! (list '<= t 1))))
                (let ((bern (dk-chain! (dk-fact! 'rr-bernoulli nt 'k) (lambda (ante) (lambda () (ass))))))
                  (ces-rr! (list '+ 1 nt))
                  (dk-have! (list '= (list '+ 1 nt) omt) (lambda () (crs)))
                  (dk-rewrite-h! bern (list '+ 1 nt) omt))
                (ces-mul-le! L B X)
                (ces-rr! (list '* (list '* A t) 1))
                (ces-rr! (list '* A t)) (ces-rr! (list '* t A))
                (ces-rr! (list '* 'xv (list '* Q B)))
                (dk-have! (list '= (list '* L X) (list '- X (list '* A t))) (lambda () (crs)))
                (dk-have! (list '= (list '* 'xv (list '* Q B)) (list '* B X)) (lambda () (crs)))
                (dk-have! (list '<= t e2) (lambda () (dk-ineq! (list '< t e2))))
                (ces-mul-le! t e2 A)
                (dk-have! (list '= (list '* A t) (list '* t A)) (lambda () (crs)))
                (dk-have! (list '<= A A1) (lambda () (dk-ineq!)))
                (dk-have! (list '<= 0 e2) (lambda () (dk-ineq! (list '< 0 e2))))
                (ces-mul-le! A A1 e2)
                (dk-have! (list '= (list '* e2 A) (list '* A e2)) (lambda () (dk-crs-opaque!)))
                (dk-have! (list '= (list '* A1 e2) d)
                  (lambda ()
                    (dk-have! (list '= (list '* A1 e2) (list '* d (list '* A1 iA))) (lambda () (dk-crs-opaque!)))
                    (subst (list '= (list '* A1 e2) (list '* d (list '* A1 iA))))
                    (subst (list '= (list '* A1 iA) 1))
                    (crs)))
                (dk-ineq! (list '<= (list '* L X) (list '* B X))
                          (list '= (list '* L X) (list '- X (list '* A t)))
                          (list '= (list '* 'xv (list '* Q B)) (list '* B X))
                          (list '<= (list '* 'xv (list '* Q B)) 'cv)
                          (list '<= (list '* t A) (list '* e2 A))
                          (list '= (list '* A t) (list '* t A))
                          (list '<= (list '* A e2) (list '* A1 e2))
                          (list '= (list '* e2 A) (list '* A e2))
                          (list '= (list '* A1 e2) d)))))))))
  (ass))
(qed 'rr-le-of-power-bounds)
(topic! 'rr-le-of-power-bounds 'inequalities)

;;; ======================================================================
;;; (3) COROLLARY 3.48: Cauchy's estimates with the full radius
;;;     f^(k)(a) is read as the tree reads it everywhere (cauchy-derivative-formula,
;;;     cauchy-estimate-derivative): the k-th derivative on a ball B(a, rho), rho < R, of the
;;;     restriction of f -- any rho in (0, R).
;;; ======================================================================
(define ces-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define ces-tp '(* 2 PI))
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL c (IMPLIES (IN c CC) (FORALL hr (IMPLIES (IN hr RR) (IMPLIES (< 0 hr)
    (IMPLIES (SUBSET (BALL CC-MS c hr) u)
      (FORALL bm (IMPLIES (IN bm RR)
        (IMPLIES (FORALL z (IMPLIES (IN z (BALL CC-MS c hr)) (<= (magnitude (f z)) bm)))
          (FORALL rho (IMPLIES (IN rho RR) (IMPLIES (< 0 rho) (IMPLIES (< rho hr)
            (FORALL k (IMPLIES (IN k NN)
              (<= (magnitude ((NTH-DERIV-ON CC-NORMED-FIELD (BALL CC-MS c rho) (RESTRICT f (BALL CC-MS c rho)) k) c))
                  (* (factorial k) (* bm (power (recip hr) k))))))))))))))))))))))))
(dk-peel!)
(define ces-3-bnd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(BALL CC-MS c hr)) (dk-contains? fm 'magnitude))) "|f| <= M"))
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'nn-in-rr 'k)
(fact 'nn-zero-le 'k)
(define ces-B '(BALL CC-MS c rho))
(define ces-rf (list 'RESTRICT 'f ces-B))
(define ces-Df (list 'NTH-DERIV-ON 'CC-NORMED-FIELD ces-B ces-rf 'k))
(define ces-val (list ces-Df 'c))
(define ces-mv (list 'magnitude ces-val))
;; B(c, rho) is open, inside u, and f restricted to it is holomorphic; so is its k-th derivative
(dk-have! (list 'AND '(IN rho RR) (list 'AND '(<= 0 rho) '(NOT (= 0 rho))))
  (lambda () (dk-conj-close! (lambda () (let ((g (dk-goal))) (cond ((dk-asm? g) (ass)) ((dk-head-is? g '<=) (dk-ineq! '(< 0 rho))) (#t (di) (dk-absurd! '(= 0 rho) '(< 0 rho)))))))))
(dk-cite! 'ball-is-open 'CC-MS 'c 'rho)
(dk-cite! 'cc-ms-open-iff ces-B)
(dk-have! (list 'IS-OPEN ces-nf ces-B) (lambda () (prop)))
(dk-have! '(<= rho hr) (lambda () (dk-ineq! '(< rho hr))))
(dk-cite! 'cc-ms-ball-mono 'c 'rho 'hr)
(fact 'subset-trans ces-B '(BALL CC-MS c hr) 'u)
(dk-cite! 'holomorphic-on-restrict 'u 'f ces-B)
(dk-cite! 'holomorphic-nth-deriv 'k ces-B ces-rf)
(let ((hi (dk-cite! 'holomorphic-on ces-B ces-Df)))
  (dk-have! (caddr hi) (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON ces-B ces-Df)) (prop)))
  (dk-split-all! (list (caddr hi))))
(dk-cite! 'cc-ms-ball-centre 'c 'rho)
(fact 'fun-apply-type-c ces-Df ces-B 'CC 'c)
(fact 'cc-magnitude-closed ces-val)
(fact 'cc-magnitude-nonneg ces-val)
;; 0 <= M
(dk-cite! 'cc-ms-ball-centre 'c 'hr)
(fact 'subset-mem-fwd '(BALL CC-MS c hr) 'u 'c)
(let ((hi (dk-cite! 'holomorphic-on 'u 'f)))
  (dk-have! (caddr hi) (lambda () (dk-only! hi '(HOLOMORPHIC-ON u f)) (prop)))
  (dk-split-all! (list (caddr hi))))
(fact 'fun-apply-type-c 'f 'u 'CC 'c)
(fact 'cc-magnitude-closed '(f c))
(fact 'cc-magnitude-nonneg '(f c))
(dk-apply! ces-3-bnd 'c)
(dk-have! '(<= 0 bm) (lambda () (dk-ineq! '(<= (magnitude (f c)) bm) '(<= 0 (magnitude (f c))))))
(define ces-kf '(factorial k))
(dk-split-all! (list (dk-cite! 'factorial-real-pos 'k)))
(define ces-C (list '* ces-kf 'bm))
(ces-rr! ces-C)
;; for every r in (rho, hr): |f^(k)(c)| r^k <= k! M
(define ces-3-H
  (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< rho r) (list 'IMPLIES '(< r hr)
    (list '<= (list '* ces-mv '(power r k)) ces-C))))))
(dk-have! ces-3-H
  (lambda ()
    (let* ((landed (dk-peel!))
           (r (dk-landed-var landed 'RR))
           (cp (list 'CIRCLE-PATH 'c r)) (cd (list 'CIRCLE-DERIV 'c r))
           (tr (list 'TRACE cp 0 ces-tp))
           (ir (list 'recip r))
           (P1 (list 'power ir 'k))
           (P2 (list 'power r 'k)))
      (dk-have! (list '< 0 r) (lambda () (dk-ineq! '(< 0 rho) (list '< 'rho r))))
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
      (dk-cite! 'circle-is-road 'c r)
      (fact 'is-road-is-path cp cd 0 ces-tp)
      (fact 'is-path-in-fun cp 0 ces-tp)
      (dk-cite! 'trace-subset-cc cp 0 ces-tp)
      (dk-cite! 'circle-trace-magnitude 'c r)
      (dk-have! (list 'FORALL 'ciey_ (list 'IMPLIES (list 'IN 'ciey_ tr) '(<= (magnitude (f ciey_)) bm)))
        (lambda ()
          (let ((y (dk-di-var!)))
            (fact 'subset-mem-fwd tr 'CC y)
            (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'cify_))) "circle magnitude") y)
            (fact 'cc-sub-in-cc y 'c)
            (fact 'cc-magnitude-closed (list '- y 'c))
            (let ((bi (dk-cite! 'cc-ms-ball-membership 'c 'hr y)))
              (dk-have! (list '< (list 'magnitude (list '- y 'c)) 'hr)
                (lambda () (dk-ineq! (list '= (list 'magnitude (list '- y 'c)) r) (list '< r 'hr))))
              (dk-have! (list 'IN y '(BALL CC-MS c hr)) (lambda () (dk-only! bi (list 'IN y 'CC) (list '< (list 'magnitude (list '- y 'c)) 'hr)) (prop))))
            (dk-apply! ces-3-bnd y)
            (ass))))
      (dk-cite! 'cauchy-estimate-derivative 'u 'f 'c 'hr r 'rho 'bm 'k)
      ;; multiply by r^k: (1/r)^k r^k = (r/r)^k = 1
      (ces-recip! r)
      (ces-rr! P1) (ces-rr! P2)
      (dk-cite! 'rr-power-nonneg 'k r)
      (let* ((n1 (dk-name! P1))
             (n2 (dk-name! P2))
             (est (dk-pick (lambda (fm) (and (dk-head-is? fm '<=) (equal? (cadr fm) ces-mv))) "the estimate at r"))
             (est1 (dk-rewrite-h! est P1 n1))
             (rhs (list '* ces-kf (list '* 'bm n1))))
        (ces-rr! rhs)
        (dk-have! (list '<= 0 n2) (lambda () (dk-ineq! (list '= n2 P2) (list '<= 0 P2))))
        (ces-mul-le! ces-mv rhs n2)
        (let* ((pm (dk-cite! 'rr-power-mul-base 'k ir r))
               (pm1 (dk-rewrite-h! pm P1 n1))
               (pm2 (dk-rewrite-h! pm1 P2 n2)))
          (dk-have! (list '= (list '* ir r) 1) (lambda () (dk-have! (list '= (list '* ir r) (list '* r ir)) (lambda () (dk-crs-opaque!))) (subst (list '= (list '* ir r) (list '* r ir))) (ass)))
          (dk-rewrite-h! pm2 (list '* ir r) 1))
        (dk-cite! 'rr-power-one 'k)
        (ces-rr! (list '* n1 n2))
        (dk-rewrite-h! (list '= (list 'power 1 'k) (list '* n1 n2)) (list 'power 1 'k) 1)
        (dk-have! (list '= (list '* rhs n2) (list '* ces-C (list '* n1 n2))) (lambda () (crs)))
        (ces-rr! (list '* ces-C (list '* n1 n2)))
        (dk-have! (list '= (list '* ces-C (list '* n1 n2)) ces-C) (lambda () (subst (list '= (list '* n1 n2) 1)) (crs)))
        (ces-rr! (list '* ces-mv n2))
        (dk-have! (list '<= (list '* ces-mv n2) ces-C)
          (lambda () (dk-ineq! (list '<= (list '* ces-mv n2) (list '* rhs n2))
                               (list '= (list '* rhs n2) (list '* ces-C (list '* n1 n2)))
                               (list '= (list '* ces-C (list '* n1 n2)) ces-C))))
        (dk-rewrite-h! (list '<= (list '* ces-mv n2) ces-C) n2 P2)
        (ass)))))
(dk-cite! 'rr-le-of-power-bounds 'k ces-mv ces-C 'rho 'hr)
;; divide by hr^k
(let* ((ih (ces-recip! 'hr))
       (Ph (list 'power 'hr 'k))
       (Pi (list 'power ih 'k)))
  (ces-rr! Ph) (ces-rr! Pi)
  (dk-have! (list '<= 0 ih) (lambda () (dk-ineq! (list '< 0 ih))))
  (dk-cite! 'rr-power-nonneg 'k ih)
  (let* ((nh (dk-name! Ph))
         (ni (dk-name! Pi))
         (g0 (dk-pick (lambda (fm) (and (dk-head-is? fm '<=) (equal? (cadr fm) (list '* ces-mv Ph)))) "|v| hr^k <= C"))
         (g1 (dk-rewrite-h! g0 Ph nh))
         (lhs (list '* ces-mv nh)))
    (ces-rr! lhs)
    (dk-have! (list '<= 0 ni) (lambda () (dk-ineq! (list '= ni Pi) (list '<= 0 Pi))))
    (ces-mul-le! lhs ces-C ni)
    (let* ((pm (dk-cite! 'rr-power-mul-base 'k 'hr ih))
           (pm1 (dk-rewrite-h! pm Ph nh))
           (pm2 (dk-rewrite-h! pm1 Pi ni)))
      (dk-rewrite-h! pm2 (list '* 'hr ih) 1))
    (dk-cite! 'rr-power-one 'k)
    (ces-rr! (list '* nh ni))
    (dk-rewrite-h! (list '= (list 'power 1 'k) (list '* nh ni)) (list 'power 1 'k) 1)
    (dk-have! (list '= (list '* lhs ni) (list '* ces-mv (list '* nh ni))) (lambda () (crs)))
    (ces-rr! (list '* ces-mv (list '* nh ni)))
    (dk-have! (list '= (list '* ces-mv (list '* nh ni)) ces-mv) (lambda () (subst (list '= (list '* nh ni) 1)) (crs)))
    (dk-have! (list '= (list '* ces-C ni) (list '* ces-kf (list '* 'bm ni))) (lambda () (crs)))
    (ces-rr! (list '* ces-kf (list '* 'bm ni)))
    (subst (list '= Pi ni))
    (dk-ineq! (list '<= (list '* lhs ni) (list '* ces-C ni))
              (list '= (list '* lhs ni) (list '* ces-mv (list '* nh ni)))
              (list '= (list '* ces-mv (list '* nh ni)) ces-mv)
              (list '= (list '* ces-C ni) (list '* ces-kf (list '* 'bm ni))))))
