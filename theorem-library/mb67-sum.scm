(sp (make-wff (list 'FORALL 'ts (list '== (list 'PTS msm-S) msm-SP))))
(dk-peel!) (mac 'SUM-MS) (slot 'PTS) (nth-r) (qrfl)
(qed 'sum-ms-pts)
(topic! 'sum-ms-pts 'analysis)

(sp (make-wff (list 'FORALL 'ts (list '== (list 'DIST msm-S) msm-LAM))))
(dk-peel!) (mac 'SUM-MS) (slot 'DIST) (nth-r) (slot 'DIST) (qrfl)
(qed 'sum-ms-dist-slot)
(topic! 'sum-ms-dist-slot 'analysis)

(sp (make-wff (list 'FORALL 'ts (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u msm-SP) (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v msm-SP)
  (list '== (msm-D 'u 'v) (msm-ifv 'u 'v)))))))))
