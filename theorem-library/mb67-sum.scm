(dk-have! (list 'IN 'x msm-BU) (lambda () (mr-bu-close! 'k)))
(dk-cite! 'pair-in-cartesian 'NN msm-BU 'k 'x)
(in-sep! (lambda () (nth-r) (mr-close-open!)))
(qed 'sum-pts-intro)
