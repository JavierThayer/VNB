(define msm-alls '(FORALL n (IMPLIES (IN n NN) (IS-SEPARABLE (ts n)))))
(define msm-ca '(BIG-UNION mpm_ NN (FUN NN (PTS (ts mpm_)))))
;;; NBGSEP (2026-10-28): mde_ is bounded by mde_ in RR (implied by POS-RR), so the separation in
;;; the choice family below is predicative (NBG).  DENSE-CONV! passes from the IS-SEPARABLE form.
(define (msm-dense-f ds sp) (list 'FORALL 'mdx_ (list 'IMPLIES (list 'IN 'mdx_ (list 'PTS sp)) (list 'FORALL 'mde_ (list 'IMPLIES '(IN mde_ RR) (list 'IMPLIES '(POS-RR mde_)
  (list 'FORSOME 'mdn_ (list 'AND '(IN mdn_ NN) (list '< (list (list 'DIST sp) 'mdx_ (list ds 'mdn_)) 'mde_)))))))))
(define (msm-dense-conv! d sp)         ; goal DENSE-F(d, sp), the IS-SEPARABLE density of d in context
  (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'POS-RR)
                                      (not (dk-contains? f 'mdx_))))
                     "the separable density"))
         (lk (dk-peel!))
         (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS sp)))) lk)))
         (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk))))
    (dk-apply! h x e)
    (ass)))
(define msm-fam (list 'VNB-LAMBDA 'mpm_ 'NN (list 'SEP 'mpd_ '(FUN NN (PTS (ts mpm_))) (msm-dense-f 'mpd_ '(ts mpm_)))))
(define msm-D0 #f) (define msm-Din #f)
(define (msm-Dk! k)
  (let ((dk (list msm-D0 k)))
    (if (not (dk-asm? (list 'IN dk (list 'FUN 'NN (list 'PTS (list 'ts k))))))
        (begin
          (dk-cite! 'fun-apply-type-c msm-D0 'NN msm-ca k)
          (dk-lam-b-h! (dk-apply! msm-Din k))
          (mr-sep-parts! (list 'IN dk (subst-free 'mpm_ k (cadddr msm-fam))))))
    (dk-ctx-form (msm-dense-f dk (list 'ts k)))))
(sp (make-wff (list 'FORALL 'ts (list 'IMPLIES msm-hyp (list 'IMPLIES msm-alls (list 'IS-SEPARABLE msm-S))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-ms-sequence 'ts))
(dk-cite! 'sum-ms-is-metric-space 'ts)
(dk-cite! 'sum-ms-pts 'ts)
(fact 'nn-is-set)
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'AND (list 'IN 'y msm-ca) (list 'IN 'y (list msm-fam 'k))))))
  (lambda ()
    (let* ((k (dk-di-var!)))
      (dk-apply! msm-alls k)
      (let ((d (mr-sep-open! (list 'ts k))))
        (ew d)
        (mr-and-close!
          (lambda ()
            (if (dk-head-is? (caddr (dk-goal)) 'BIG-UNION)
                (mr-bu-close! k)
                (begin (dk-lam-b!) (in-sep! (lambda () (msm-dense-conv! d (list 'ts k))))))))))))
(set! msm-D0 (dk-skolem! (dk-cite! 'rmm-nn-choice msm-ca msm-fam)))
(dk-split-all!)
(set! msm-Din (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f msm-D0) (dk-contains? f 'mpd_))) "D choice"))
(define msm-ds (list 'VNB-LAMBDA 'msi_ 'NN (list 'LIST '(NNFST msi_) (list (list msm-D0 '(NNFST msi_)) '(NNSND msi_)))))
(define (msm-dpt! k n)               ; k, n in NN: [k, D(k)(n)] in SP
  (msm-Dk! k)
  (dk-cite! 'fun-apply-type-c (list msm-D0 k) 'NN (list 'PTS (list 'ts k)) n)
  (dk-cite! 'sum-pts-intro 'ts k (list (list msm-D0 k) n)))
(let ((iff (dk-cite! 'is-separable msm-S)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew msm-ds)
                (mr-and-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN)
                        (begin
                          (subst (list '= (list 'PTS msm-S) msm-SP))
                          (for-each (lambda (kn)
                                      (if (not (sequent-node-grounded? kn))
                                          (begin (dk-focus! kn)
                                                 (if (dk-asm? (dk-goal)) (ass)
                                                     (let ((i (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                                       (dk-cite! 'nnfst-type i) (dk-cite! 'nnsnd-type i)
                                                       (msm-dpt! (list 'NNFST i) (list 'NNSND i))
                                                       (mr-close-open!))))))
                                    (dk-opened (lambda () (lam-t)))))
                        (let* ((lx (dk-peel!))
                               (p (cadr (mr-find 'sp (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS msm-S)))) lx)))
                               (eps (cadr (mr-find 'se (lambda (f) (dk-head-is? f 'POS-RR)) lx)))
                               (_0 (dk-have! (list 'IN p msm-SP) (lambda () (subst (list '= msm-SP (list 'PTS msm-S))) (mr-close-open!))))
                               (pp (msm-pt! p)) (k (car pp)) (x (cadr pp))
                               (den (msm-Dk! k))
                               (_e (dk-cite! 'rr-pos-rr-in-rr eps))
                               (n (dk-skolem! (dk-apply! den x eps)))
                               (_1 (dk-split-all!))
                               (i (list 'NNPAIR k n))
                               (y (list (list msm-D0 k) n))
                               (q (list 'LIST k y)))
                          (dk-cite! 'nnpair-type k n) (dk-cite! 'nnfst-nnpair k n) (dk-cite! 'nnsnd-nnpair k n)
                          (msm-dpt! k n)
                          (ew i)
                          (mr-and-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal)) (ass)
                                  (begin
                                    (dk-lam-b!)
                                    (subst (list '= (list 'NNFST i) k))
                                    (subst (list '= (list 'NNSND i) n))
                                    (dk-have! (list '= k (list 'NTH 1 q)) (lambda () (nth-r) (rfl)))
                                    (dk-have! (list '= (list 'NTH 2 q) y) (lambda () (nth-r) (rfl)))
                                    (msm-pt! q)
                                    (dk-cite! 'sum-dist-same 'ts p q)
                                    (let ((h (mr-find 'sdq (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (msm-D p q)))) (dk-asms)))
                                          (sk (list 'ts k)))
                                      (dk-rewrite-h! h (list 'NTH 2 q) y)
                                      (msm-sp! k)
                                      (msm-bddpt! k y)
                                      (dk-cite! 'bdd-metric-dist-le sk x y)
                                      (dk-cite! 'metric-dist-real sk x y)
                                      (dk-cite! 'metric-dist-real (list 'BDD-METRIC sk) x y)
                                      (dk-cite! 'rr-pos-rr-in-rr eps)
                                      (msm-gen! p q)
                                      (dk-ineq! (list '= (msm-D p q) (msm-bdd k x y)) (list '<= (msm-bdd k x y) (list (list 'DIST sk) x y))
                                                (list '< (list (list 'DIST sk) x y) eps)
                                                (list 'IN (msm-bdd k x y) 'RR) (list 'IN (list (list 'DIST sk) x y) 'RR) (list 'IN eps 'RR)))))))))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'sum-ms-separable)
(topic! 'sum-ms-separable 'analysis)

(define msm-allp '(FORALL n (IMPLIES (IN n NN) (IS-POLISH (ts n)))))
(sp (make-wff (list 'FORALL 'ts (list 'IMPLIES msm-hyp (list 'IMPLIES msm-allp (list 'IS-POLISH msm-S))))))
(dk-peel!)
(dk-have! msm-allc (lambda () (let ((k (dk-di-var!))) (dk-apply! msm-allp k) (mac-h 'is-polish (list 'IS-POLISH (list 'ts k))) (dk-split-all!) (mr-close-open!))))
(dk-have! msm-alls (lambda () (let ((k (dk-di-var!))) (dk-apply! msm-allp k) (mac-h 'is-polish (list 'IS-POLISH (list 'ts k))) (dk-split-all!) (mr-close-open!))))
(dk-cite! 'sum-ms-complete 'ts)
(dk-cite! 'sum-ms-separable 'ts)
(let ((iff (dk-cite! 'is-polish msm-S)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'sum-ms-polish)
(topic! 'sum-ms-polish 'analysis)
