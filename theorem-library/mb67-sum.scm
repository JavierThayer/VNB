                                    (dk-have! (list '<= n1 m2) (lambda () (dk-ineq! (list '<= nn2 m2) (list '<= 0 n0) (list 'IN n1 'RR) (list 'IN n0 'RR) (list 'IN m2 'RR))))
                                    (dk-have! (list 'AND (list '<= n1 m1) (list '<= n1 m2)) (lambda () (dk-conj-close! dk-ass!)))
                                    (let* ((le (dk-apply! cn1 m1 m2))
