(dk-rewrite-h! (list 'IN 'p msm-SP) msm-SP msm-SEP)
(mr-sep-parts! (list 'IN 'p msm-SEP))
(dk-split-all! (list (mr-chain! (dk-cite! 'cartesian-nth 'p 'NN msm-BU))))
(dk-cite! 'cartesian-pair-eq 'p 'NN msm-BU)
(mr-and-close! (lambda () (mr-close-open!)))
(qed 'sum-pts-parts)
(topic! 'sum-pts-parts 'analysis)

(sp (make-wff (list 'FORALL 'ts (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS (ts k)))
  (list 'IN '(LIST k x) msm-SP))))))))
(dk-peel!)
(dk-cite! 'sum-pts-unfold 'ts)
