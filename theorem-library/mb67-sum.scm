(sp (make-wff (list 'FORALL 'ts (list 'IMPLIES msm-hyp (list 'IN msm-SP 'SET)))))
(dk-peel!)
(define msm-ims (car (mr-iff-parts! (dk-cite! 'is-ms-sequence 'ts))))
(fact 'nn-is-set)
(dk-have! (list 'IN msm-BU 'SET)
  (lambda ()
    (for-each (lambda (l) (dk-focus! l)
                (if (dk-asm? (dk-goal)) (ass)
                    (let ((k (dk-di-var!))) (dk-apply! msm-ims k) (dk-cite! 'ms-pts-is-set (list 'ts k)) (mr-close-open!))))
              (dk-opened (lambda () (bu-set))))))
(let ((iff (dk-cite! 'cartesian-set-iff 'NN msm-BU)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
  (mr-iff-back! iff))
(dk-cite! 'sum-pts-unfold 'ts)
(dk-have! (list 'SUBSET msm-SP (list 'CARTESIAN 'NN msm-BU))
  (lambda () (mac 'subset-def)
    (let ((p (dk-di-var!)))
      (dk-rewrite-h! (list 'IN p msm-SP) msm-SP msm-SEP)
      (mr-sep-parts! (list 'IN p msm-SEP))
      (mr-close-open!))))
(mr-chain! (dk-cite! 'subclass-of-set-is-set msm-SP (list 'CARTESIAN 'NN msm-BU)))
(mr-close-open!)
(qed 'sum-pts-is-set)
(topic! 'sum-pts-is-set 'analysis)

;;; the value of the distance on one summand and across summands
(define (msm-pt! u)                  ; u in SP: u = [u1, u2], u1 in NN, u2 in PTS(ts u1) and in PTS of its bounded metric
  (let ((u1 (list 'NTH 1 u)) (u2 (list 'NTH 2 u)))
    (if (not (dk-asm? (list 'IN u1 'NN)))
        (begin
          (dk-split-all! (list (dk-cite! 'sum-pts-parts 'ts u)))
          (msm-sp! u1)
          (msm-bddpt! u1 u2)))
    (list u1 u2)))
(define (msm-sp! k)                  ; k in NN: IS-METRIC-SPACE(ts k) and of its bounded metric
  (let ((g0 (list 'IS-METRIC-SPACE (list 'ts k))))
    (if (not (dk-asm? g0))
        (begin
          (dk-apply! (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (IS-METRIC-SPACE (ts n))))) k)
          (dk-cite! 'bdd-metric-is-metric-space (list 'ts k))
          (dk-cite! 'bdd-metric-carrier (list 'ts k))))))
(define (msm-bddpt! k x)             ; x in PTS(ts k): x in PTS(BDD-METRIC(ts k))
  (let ((g0 (list 'IN x (list 'PTS (list 'BDD-METRIC (list 'ts k))))))
    (if (not (dk-asm? g0))
        (dk-have! g0 (lambda () (subst (list '= (list 'PTS (list 'BDD-METRIC (list 'ts k))) (list 'PTS (list 'ts k)))) (mr-close-open!))))))
(define (msm-bdd k x y) (list (list 'DIST (list 'BDD-METRIC (list 'ts k))) x y))
(define msm-pre (lambda (body) (list 'FORALL 'ts (list 'IMPLIES msm-hyp (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u msm-SP)
  (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v msm-SP) body))))))))
(sp (make-wff (msm-pre (list 'IMPLIES '(= (NTH 1 u) (NTH 1 v)) (list '= (msm-D 'u 'v) (msm-bdd '(NTH 1 u) '(NTH 2 u) '(NTH 2 v)))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-ms-sequence 'ts))
(msm-pt! 'u) (msm-pt! 'v)
(dk-rewrite-h! '(IN (NTH 2 v) (PTS (ts (NTH 1 v)))) '(NTH 1 v) '(NTH 1 u))
(msm-bddpt! '(NTH 1 u) '(NTH 2 v))
(dk-cite! 'metric-dist-real '(BDD-METRIC (ts (NTH 1 u))) '(NTH 2 u) '(NTH 2 v))
(dk-cite! 'sum-dist-value 'ts 'u 'v)
(subst (list '= (msm-D 'u 'v) (msm-ifv 'u 'v)))
(dk-if-branch! #t (cadr (dk-goal)) #f (lambda () (rfl)))
(qed 'sum-dist-same)
(topic! 'sum-dist-same 'analysis)

(sp (make-wff (msm-pre (list 'IMPLIES '(NOT (= (NTH 1 u) (NTH 1 v))) (list '= (msm-D 'u 'v) 1)))))
(dk-peel!)
(dk-cite! 'sum-dist-value 'ts 'u 'v)
(subst (list '= (msm-D 'u 'v) (msm-ifv 'u 'v)))
(dk-if-branch! #f (cadr (dk-goal)) #f (lambda () (rfl)))
(qed 'sum-dist-diff)
(topic! 'sum-dist-diff 'analysis)

(define (msm-em c yes no)            ; use-em unless the context already decides c
  (cond ((dk-asm? c) (yes))
        ((dk-asm? (list 'NOT c)) (no))
        (#t (use-em c yes no))))
(define (msm-gen! u v)               ; d(u, v) real, 0 <= d <= 1 (u, v in SP)
  (let ((d (msm-D u v)))
    (if (not (dk-asm? (list 'IN d 'RR)))
        (let* ((uu (msm-pt! u)) (vv (msm-pt! v)))
          (dk-have! (list 'AND (list 'IN d 'RR) (list 'AND (list '<= 0 d) (list '<= d 1)))
            (lambda ()
              (msm-em (list '= (car uu) (car vv))
                (lambda ()
                  (dk-cite! 'sum-dist-same 'ts u v)
                  (dk-rewrite-h! (list 'IN (cadr vv) (list 'PTS (list 'ts (car vv)))) (car vv) (car uu))
                  (msm-bddpt! (car uu) (cadr vv))
                  (let ((b (msm-bdd (car uu) (cadr uu) (cadr vv))) (sp0 (list 'BDD-METRIC (list 'ts (car uu)))))
                    (dk-cite! 'metric-dist-real sp0 (cadr uu) (cadr vv))
                    (dk-cite! 'metric-pos sp0 (cadr uu) (cadr vv))
                    (dk-cite! 'bdd-metric-bounded (list 'ts (car uu)) (cadr uu) (cadr vv))
                    (subst (list '= d b))
                    (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< b 1) (list 'IN b 'RR)))))))
                (lambda ()
                  (dk-cite! 'sum-dist-diff 'ts u v)
                  (subst (list '= d 1))
                  (fact 'rr-one-in)
                  (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!))))))))
          (dk-split-all!)))
    d))

(sp (make-wff (list 'FORALL 'ts (list 'IMPLIES msm-hyp (list 'IN msm-LAM (list 'FUN (list 'CARTESIAN msm-SP msm-SP) 'RR))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-ms-sequence 'ts))
(dk-cite! 'sum-pts-is-set 'ts)
(for-each (lambda (k)
            (if (not (sequent-node-grounded? k))
                (begin
                  (dk-focus! k)
                  (if (dk-asm? (dk-goal)) (ass)
                      (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                          (begin (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!))
                          (let* ((lk (dk-peel!))
                                 (pts (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) msm-SP))) lk)))
                                 (uu (msm-pt! (car pts))) (vv (msm-pt! (cadr pts))))
                            (dk-case-if! (cadr (dk-goal))
                              (lambda (tv val)
                                (if tv
                                    (begin
                                      (dk-rewrite-h! (list 'IN (cadr vv) (list 'PTS (list 'ts (car vv)))) (car vv) (car uu))
                                      (msm-bddpt! (car uu) (cadr vv))
                                      (dk-cite! 'metric-dist-real (list 'BDD-METRIC (list 'ts (car uu))) (cadr uu) (cadr vv))
                                      (mr-close-open!))
                                    (begin (fact 'rr-one-in) (mr-close-open!)))))))))))
          (dk-opened (lambda () (lam-t))))
(qed 'sum-ms-lam-type)
(topic! 'sum-ms-lam-type 'analysis)

;;; the metric laws
(define (msm-same! u v)              ; (= u1 v1) in context: d(u, v) = bdd_u1(u2, v2), v2 typed in ts(u1); returns the bdd term
  (let* ((uu (msm-pt! u)) (vv (msm-pt! v)) (b (msm-bdd (car uu) (cadr uu) (cadr vv))))
    (if (not (dk-asm? (list '= (msm-D u v) b)))
        (begin
          (dk-cite! 'sum-dist-same 'ts u v)
          (if (not (dk-asm? (list 'IN (cadr vv) (list 'PTS (list 'ts (car uu))))))
              (dk-rewrite-h! (list 'IN (cadr vv) (list 'PTS (list 'ts (car vv)))) (car vv) (car uu)))
          (msm-bddpt! (car uu) (cadr vv))
          (dk-cite! 'metric-dist-real (list 'BDD-METRIC (list 'ts (car uu))) (cadr uu) (cadr vv))))
    b))
(define (msm-ne-sym! a b)            ; NOT (a = b) in context: NOT (b = a)
  (dk-have! (list 'NOT (list '= b a))
    (lambda () (di) (dk-have! (list '= a b) (lambda () (subst (list '= a b)) (rfl))) (ai (list 'NOT (list '= a b))))))
(define (msm-law!)
  (let ((g (dk-goal)))
    (cond
      ;; a definedness side goal t = t
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
       (dk-cite! 'sum-ms-lam-type 'ts)
       (dk-cite! 'sum-ms-dist-slot 'ts)
       (if (equal? (cadr g) (list 'DIST msm-S))
           (dk-have! (list 'IN (list 'DIST msm-S) (list 'FUN (list 'CARTESIAN msm-SP msm-SP) 'RR))
             (lambda () (subst (list '= (list 'DIST msm-S) msm-LAM)) (mr-close-open!))))
       (rfl))
      ;; d(u, u) = 0
      ((and (dk-head-is? g '=) (equal? (caddr g) 0))
       (let* ((u (cadr (cadr g))) (uu (msm-pt! u)))
         (dk-have! (list '= (car uu) (car uu)) (lambda () (rfl)))
         (let ((b (msm-same! u u)))
           (dk-cite! 'metric-self-zero (list 'BDD-METRIC (list 'ts (car uu))) (cadr uu))
           (subst (list '= (msm-D u u) b))
           (mr-close-open!))))
      ;; 0 <= d(u, v)
      ((and (dk-head-is? g '<=) (equal? (cadr g) 0))
       (let ((d (caddr g))) (msm-gen! (cadr d) (caddr d)) (mr-close-open!)))
      ;; d(u, v) = 0 => u = v
      ((and (dk-head-is? g '=) (symbol? (cadr g)) (symbol? (caddr g)))
       (let* ((u (cadr g)) (v (caddr g)) (uu (msm-pt! u)) (vv (msm-pt! v)) (d (msm-D u v)))
         (msm-gen! u v)
         (use-em (list '= (car uu) (car vv))
           (lambda ()
             (let ((b (msm-same! u v)))
               (dk-have! (list '= b 0) (lambda () (dk-ineq! (list '= d b) (list '= d 0) (list 'IN d 'RR) (list 'IN b 'RR))))
               (mr-chain! (dk-cite! 'metric-zero-eq (list 'BDD-METRIC (list 'ts (car uu))) (cadr uu) (cadr vv)))
               (subst (list '= u (list 'LIST (car uu) (cadr uu))))
               (subst (list '= v (list 'LIST (car vv) (cadr vv))))
               (subst (list '= (car uu) (car vv)))
               (subst (list '= (cadr uu) (cadr vv)))
               (dk-cite! 'membership-implies-sethood (cadr vv) (list 'PTS (list 'ts (car vv))))
               (dk-cite! 'membership-implies-sethood (car vv) 'NN)
               (rfl)))
           (lambda ()
             (dk-cite! 'sum-dist-diff 'ts u v)
             (pbc)
             (dk-absurd! (list '= d 1) (list '= d 0) (list 'IN d 'RR))))))
      ;; symmetry
      ((dk-head-is? g '=)
       (let* ((d1 (cadr g)) (u (cadr d1)) (v (caddr d1)) (uu (msm-pt! u)) (vv (msm-pt! v)) (d2 (msm-D v u)))
         (msm-gen! u v) (msm-gen! v u)
         (use-em (list '= (car uu) (car vv))
           (lambda ()
             (dk-have! (list '= (car vv) (car uu)) (lambda () (subst (list '= (car uu) (car vv))) (rfl)))
             (let* ((b1 (msm-same! u v)) (b2 (msm-same! v u)))
               (dk-rewrite-h! (list '= d2 b2) (car vv) (car uu))
               (dk-cite! 'metric-sym (list 'BDD-METRIC (list 'ts (car uu))) (cadr uu) (cadr vv))
