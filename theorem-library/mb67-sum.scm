                                           (a1 (msm-pt! (list u m1))) (a2 (msm-pt! (list u m2))))
                                      (bval! m1) (bval! m2)
                                      (msm-gen! (list u m1) (list u m2))
                                      (dk-have! (list '<= bd (list '/ eps ope))
                                        (lambda () (mac 'binary-divide-def)
