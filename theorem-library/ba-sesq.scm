;;; ba-sesq.scm -- Thayer, Banach Algebras and Applications, ch. 5 (used for 5.10): a bounded sesquilinear
;;; form on a Hilbert space is <S x | y> for a unique bounded operator S.  The form is CURRIED,
;;; bf in FUN(VEC v, FUN(VEC v, CC)), linear in its first and conjugate-linear in its second argument.
;;; Route: for each y, x |-> bf(x)(y) is a bounded CC-linear functional, so Riesz gives R(y) with
;;; bf(x)(y) = <x | R y>; R is a function by unique choice, linear and bounded by uniqueness of the Riesz
;;; vector, and S = R*.  Agent BA-1111-C2, 2026-11-11.  DESTINATION: theorem-library/ba-sesq.scm, after
;;; theorem-library/ba-optop-adjoint (op-adjoint-*), hilbert-projection (cips-ip-bound-least) and the Riesz
;;; file.  Library: operator-algebras.  Helper prefix bsf-.  Every qed is modulo 0.

(define (bsf-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (bsf-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ba-sesq: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 12 (length (dk-asms-of l))))))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (bsf-ass!) (if (not (bsf-done?)) (dk-ass!)))
(define bsf-V '(VEC v))
(define bsf-F '(FUN (VEC v) (FUN (VEC v) CC)))
(define (bsf-b x y) (list (list 'bf_ x) y))
(define (bsf-ip x y) (list '(IP v) x y))
(define (bsf-all vs body)
  (if (null? vs) body
      (list 'FORALL (car (car vs)) (list 'IMPLIES (list 'IN (car (car vs)) (cadr (car vs))) (bsf-all (cdr vs) body)))))
(define bsf-H1 (bsf-all '((bsa_ (VEC v)) (bsb_ (VEC v)) (bsy_ (VEC v)))
  (list '= (bsf-b '((VADD v) bsa_ bsb_) 'bsy_) (list '+ (bsf-b 'bsa_ 'bsy_) (bsf-b 'bsb_ 'bsy_)))))
(define bsf-H2 (bsf-all '((bsk_ CC) (bsa_ (VEC v)) (bsy_ (VEC v)))
  (list '= (bsf-b '((ACT v) bsk_ bsa_) 'bsy_) (list '* 'bsk_ (bsf-b 'bsa_ 'bsy_)))))
(define bsf-H3 (bsf-all '((bsa_ (VEC v)) (bsb_ (VEC v)) (bsy_ (VEC v)))
  (list '= (bsf-b 'bsa_ '((VADD v) bsb_ bsy_)) (list '+ (bsf-b 'bsa_ 'bsb_) (bsf-b 'bsa_ 'bsy_)))))
(define bsf-H4 (bsf-all '((bsk_ CC) (bsa_ (VEC v)) (bsy_ (VEC v)))
  (list '= (bsf-b 'bsa_ '((ACT v) bsk_ bsy_)) (list '* '(CONJUGATE bsk_) (bsf-b 'bsa_ 'bsy_)))))
(define bsf-HB (bsf-all '((bsa_ (VEC v)) (bsy_ (VEC v)))
  (list '<= (list 'MAGNITUDE (bsf-b 'bsa_ 'bsy_)) '(* c_ (* (IP-NORM v bsa_) (IP-NORM v bsy_))))))
(define bsf-Hx (list '(IS-HILBERT-SPACE v) (list 'IN 'bf_ bsf-F) bsf-H1 bsf-H2 '(IN c_ RR) '(<= 0 c_) bsf-HB))
;;; (bf x)(y) in CC
(define (bsf-type! x y)
  (dk-cite! 'fun-apply-type-c 'bf_ bsf-V '(FUN (VEC v) CC) x)
  (dk-cite! 'fun-apply-type-c (list 'bf_ x) bsf-V 'CC y))

;;; ---------------------------------------------------------------------------------------------
;;; for each y the Riesz vector of x |-> bf(x)(y)
(define (bsf-g y) (list 'VNB-LAMBDA 'bsg_ bsf-V (bsf-b 'bsg_ y)))
(define (bsf-point y)
  (list 'FORSOME 'bse_ (list 'AND '(IN bse_ (VEC v))
    (bsf-all '((bsx_ (VEC v))) (list '= (bsf-b 'bsx_ y) (bsf-ip 'bsx_ 'bse_))))))
(sp (make-wff (forall-guarded '(v bf_ c_ y_) (append bsf-Hx '((IN y_ (VEC v)))) (bsf-point 'y_))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'cc-is-set)
(let* ((g (bsf-g 'y_))
       (m '(* c_ (IP-NORM v y_))))
  (dk-have! (list 'IS-CC-LINEAR-FUNCTIONAL 'v g)
    (lambda ()
      (mac 'is-cc-linear-functional)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((bsf-done?) #t)
                  ((dk-head-is? gl 'IN)
                   (dk-lam-type! (lambda () (let ((x (cadr (car (dk-peel!))))) (bsf-type! x 'y_) (bsf-ass!)))))
                  ((dk-contains? gl 'ACT)
                   (let* ((pl (dk-peel!)) (k (cadr (car pl))) (a (cadr (cadr pl))))
                     (dk-cite! 'cips-act-type 'v k a)
                     (dk-lam-b!)
                     (if (not (bsf-done?))
                         (begin (subst (dk-apply! bsf-H2 k a 'y_)) (bsf-type! a 'y_) (rfl)))))
                  (#t
                   (let* ((pl (dk-peel!)) (a (cadr (car pl))) (b (cadr (cadr pl))))
                     (dk-cite! 'cips-vadd-type 'v a b)
                     (dk-lam-b!)
                     (if (not (bsf-done?))
                         (begin (subst (dk-apply! bsf-H1 a b 'y_)) (bsf-type! a 'y_) (bsf-type! b 'y_) (rfl)))))))))))
  (dk-cite! 'ip-norm-in-rr 'v 'y_) (dk-cite! 'ip-norm-nonneg 'v 'y_)
  (dk-real! m)
  (dk-cite! 'cvx-mul-nonneg 'c_ '(IP-NORM v y_))
  (dk-have! (bsf-all '((bcx_ (VEC v))) (list '<= (list 'MAGNITUDE (list g 'bcx_)) (list '* m '(IP-NORM v bcx_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-lam-b!)
        (dk-cite! 'ip-norm-in-rr 'v x)
        (let ((h (dk-apply! bsf-HB x 'y_)))
          (dk-have! (list '= (list '* 'c_ (list '* (list 'IP-NORM 'v x) '(IP-NORM v y_))) (list '* m (list 'IP-NORM 'v x)))
            (lambda () (crs)))
          (subst (list '= (list '* m (list 'IP-NORM 'v x)) (list '* 'c_ (list '* (list 'IP-NORM 'v x) '(IP-NORM v y_)))))
          (bsf-ass!)))))
  (dk-cite! 'cc-functional-continuous-of-bound 'v g m)
  (let* ((ex (dk-cite! 'riesz-representation-exists 'v g))
         (e (dk-skolem! ex #t))
         (rz (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h e) (dk-contains? h 'bsg_))) "riesz")))
    (ew e)
    (dk-conj-close!
      (lambda ()
        (cond ((bsf-done?) #t)
              ((dk-ass!) #t)
              (#t
               (let* ((x (dk-di-var!)))
                 (bsf-type! x 'y_)
                 (dk-have! (list '= (bsf-b x 'y_) (list g x)) (lambda () (dk-lam-b!) (if (not (bsf-done?)) (rfl))))
                 (subst (list '= (bsf-b x 'y_) (list g x)))
                 (dk-apply! rz x)
                 (bsf-ass!))))))))
(bsf-qed! 'sesq-riesz-point)

;;; ---------------------------------------------------------------------------------------------
;;; the Riesz vectors form a function R with bf(x)(y) = <x | R y>
(define (bsf-prop e y) (bsf-all '((bsx_ (VEC v))) (list '= (bsf-b 'bsx_ y) (bsf-ip 'bsx_ e))))
(define bsf-Q (list 'VNB-LAMBDA 'bsw_ bsf-V (list 'SEP 'bse_ bsf-V (bsf-prop 'bse_ 'bsw_))))
(define bsf-mapprop (bsf-all '((bsy_ (VEC v)) (bsx_ (VEC v))) (list '= (bsf-b 'bsx_ 'bsy_) (bsf-ip 'bsx_ '(bsr_ bsy_)))))
(define bsf-map (list 'FORSOME 'bsr_ (list 'AND '(IN bsr_ (FUN (VEC v) (VEC v))) bsf-mapprop)))
;;; with (bsf-prop e1 y) and (bsf-prop e2 y) in context (e1, e2 typed): e1 = e2
(define (bsf-unique! e1 e2 y p1 p2)
  (dk-have! (bsf-all '((hrx_ (VEC v))) (list '= (bsf-ip 'hrx_ e1) (bsf-ip 'hrx_ e2)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-apply! p1 x)
        (dk-apply! p2 x)
        (bsf-type! x y)
        (subst (list '= (bsf-ip x e1) (bsf-b x y)))
        (subst (list '= (bsf-ip x e2) (bsf-b x y)))
        (rfl))))
  (dk-cite! 'cips-ip-separates 'v e1 e2))
(sp (make-wff (forall-guarded '(v bf_ c_) bsf-Hx bsf-map)))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(dk-have! (bsf-all '((ucx (VEC v)))
            (list 'FORSOME 'ucy (list 'AND (list 'IN 'ucy bsf-V)
              (list 'AND (list 'IN 'ucy (list bsf-Q 'ucx))
                (bsf-all '((ucz (VEC v))) (list 'IMPLIES (list 'IN 'ucz (list bsf-Q 'ucx)) '(= ucz ucy)))))))
  (lambda ()
    (let* ((y (dk-di-var!))
           (ex (dk-cite! 'sesq-riesz-point 'v 'bf_ 'c_ y))
           (e (dk-skolem! ex #t))
           (pe (bsf-prop e y)))
      (dk-split-all!)
      (ew e)
      (dk-conj-close!
        (lambda ()
          (cond ((bsf-done?) #t)
                ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'IN)
                 (dk-lam-b!)
                 (if (not (bsf-done?)) (in-sep! (lambda () (bsf-ass!)) (lambda () (bsf-ass!)))))
                (#t
                 (let* ((pl (dk-peel!))
                        (hz (car (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (pair? (car (caddr f))))) pl)))
                        (z (cadr hz)))
                   (dk-lam-b-h! hz)
                   (let ((hz2 (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) z) (dk-head-is? (caddr h) 'SEP))) "z")))
                     (sep-me hz2)
                     (dk-split-all!)
                     (bsf-unique! z e y (bsf-prop z y) pe)
                     (bsf-ass!))))))))))
(let* ((ch (dk-cite! 'uniq-choice-fun bsf-V bsf-V bsf-Q))
       (r (dk-skolem! ch #t))
       (rq (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h r) (dk-contains? h 'VNB-LAMBDA))) "R in Q")))
  (dk-split-all!)
  (ew r)
  (dk-conj-close!
    (lambda ()
      (cond ((bsf-done?) #t)
            ((dk-ass!) #t)
            (#t
             (let* ((pl (dk-peel!))
                    (y (cadr (car pl))) (x (cadr (cadr pl)))
                    (h (dk-apply! rq y)))
               (dk-cite! 'fun-apply-type-c r bsf-V bsf-V y)
               (dk-lam-b-h! h)
               (let ((h2 (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list r y)) (dk-head-is? (caddr f) 'SEP))) "Ry")))
                 (sep-me h2)
                 (dk-split-all!)
                 (dk-apply! (bsf-prop (list r y) y) x)
                 (bsf-ass!))))))))
(bsf-qed! 'sesq-riesz-map)

;;; ---------------------------------------------------------------------------------------------
;;; R is linear and bounded, by uniqueness of the Riesz vector
(define (bsf-rprop r) (bsf-all '((bsy_ (VEC v)) (bsx_ (VEC v))) (list '= (bsf-b 'bsx_ 'bsy_) (bsf-ip 'bsx_ (list r 'bsy_)))))
(define bsf-Hr (append bsf-Hx (list bsf-H3 bsf-H4 '(IN r_ (FUN (VEC v) (VEC v))) (bsf-rprop 'r_))))
(define (bsf-rv! y) (dk-cite! 'fun-apply-type-c 'r_ bsf-V bsf-V y))
(define (bsf-rp! y x) (dk-apply! (bsf-rprop 'r_) y x))
(sp (make-wff (forall-guarded '(v bf_ c_ r_) bsf-Hr '(IN r_ (BOUNDED-OPS v v)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(define (bsf-sep-close! e1 e2 ptwise)
  ;; e1 = e2 in VEC v from <x | e1> = <x | e2> for all x, PTWISE run on the eigenvariable x
  (dk-have! (bsf-all '((hrx_ (VEC v))) (list '= (bsf-ip 'hrx_ e1) (bsf-ip 'hrx_ e2)))
    (lambda () (let ((x (dk-di-var!))) (ptwise x))))
  (dk-cite! 'cips-ip-separates 'v e1 e2)
  (bsf-ass!))
(dk-have! '(IS-LINEAR-OP v v r_)
  (lambda ()
    (mac 'is-linear-op)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((bsf-done?) #t)
                ((dk-ass!) #t)
                ((dk-contains? g 'ACT)
                 (let* ((pl (dk-peel!)) (k (cadr (car pl))) (a (cadr (cadr pl)))
                        (ka (list '(ACT v) k a)) (ra (list 'r_ a)))
                   (dk-cite! 'cips-act-type 'v k a)
                   (bsf-rv! ka) (bsf-rv! a)
                   (dk-cite! 'cips-act-type 'v k ra)
                   (bsf-sep-close! (list 'r_ ka) (list '(ACT v) k ra)
                     (lambda (x)
                       (bsf-rp! ka x) (bsf-rp! a x)
                       (bsf-type! x a) (bsf-type! x ka)
                       (subst (list '= (bsf-ip x (list 'r_ ka)) (bsf-b x ka)))
                       (subst (dk-apply! bsf-H4 k x a))
                       (subst (dk-apply! (dk-cite! 'cips-ip-conj-homog-right 'v) k x ra))
                       (subst (list '= (bsf-ip x ra) (bsf-b x a)))
                       (dk-cite! 'cc-conjugate-closed k)
                       (rfl)))))
                (#t
                 (let* ((pl (dk-peel!)) (a (cadr (car pl))) (b (cadr (cadr pl)))
                        (ab (list '(VADD v) a b)) (ra (list 'r_ a)) (rb (list 'r_ b)))
                   (dk-cite! 'cips-vadd-type 'v a b)
                   (bsf-rv! ab) (bsf-rv! a) (bsf-rv! b)
                   (dk-cite! 'cips-vadd-type 'v ra rb)
                   (bsf-sep-close! (list 'r_ ab) (list '(VADD v) ra rb)
                     (lambda (x)
                       (bsf-rp! ab x) (bsf-rp! a x) (bsf-rp! b x)
                       (bsf-type! x a) (bsf-type! x b) (bsf-type! x ab)
                       (subst (list '= (bsf-ip x (list 'r_ ab)) (bsf-b x ab)))
                       (subst (dk-apply! bsf-H3 x a b))
                       (subst (dk-apply! (dk-cite! 'cips-ip-add-right 'v) x ra rb))
                       (subst (list '= (bsf-ip x ra) (bsf-b x a)))
                       (subst (list '= (bsf-ip x rb) (bsf-b x b)))
                       (rfl)))))))))))
(dk-have! (bsf-all '((box_ (VEC v))) '(<= (IP-NORM v (r_ box_)) (* c_ (IP-NORM v box_))))
  (lambda ()
    (let* ((y (dk-di-var!)) (ry (list 'r_ y)) (m (list '* 'c_ (list 'IP-NORM 'v y))))
      (bsf-rv! y)
      (dk-cite! 'ip-norm-in-rr 'v y) (dk-cite! 'ip-norm-nonneg 'v y)
      (dk-real! m)
      (dk-cite! 'cvx-mul-nonneg 'c_ (list 'IP-NORM 'v y))
      (dk-have! (bsf-all '((hrx_ (VEC v))) (list '<= (list 'MAGNITUDE (bsf-ip 'hrx_ ry)) (list '* m '(IP-NORM v hrx_))))
        (lambda ()
          (let ((x (dk-di-var!)))
            (bsf-rp! y x)
            (bsf-type! x y)
            (dk-cite! 'ip-norm-in-rr 'v x)
            (subst (list '= (bsf-ip x ry) (bsf-b x y)))
            (dk-apply! bsf-HB x y)
            (dk-have! (list '= (list '* 'c_ (list '* (list 'IP-NORM 'v x) (list 'IP-NORM 'v y))) (list '* m (list 'IP-NORM 'v x)))
              (lambda () (crs)))
            (subst (list '= (list '* m (list 'IP-NORM 'v x)) (list '* 'c_ (list '* (list 'IP-NORM 'v x) (list 'IP-NORM 'v y)))))
            (bsf-ass!))))
      (dk-cite! 'cips-ip-bound-least 'v ry m)
      (bsf-ass!))))
(dk-cite! 'bop-intro 'v 'v 'r_ 'c_)
(bsf-ass!)
(bsf-qed! 'sesq-riesz-bounded)

;;; ---------------------------------------------------------------------------------------------
;;; the theorem: bf(x)(y) = <S x | y> for a bounded S (S = R*), and S is unique
(define (bsf-rep s) (bsf-all '((bsx_ (VEC v)) (bsy_ (VEC v))) (list '= (bsf-b 'bsx_ 'bsy_) (bsf-ip (list s 'bsx_) 'bsy_))))
(define bsf-Hall (append bsf-Hx (list bsf-H3 bsf-H4)))
(sp (make-wff (forall-guarded '(v bf_ c_) bsf-Hall
   (list 'FORSOME 'bss_ (list 'AND '(IN bss_ (BOUNDED-OPS v v)) (bsf-rep 'bss_))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(let* ((ex (dk-cite! 'sesq-riesz-map 'v 'bf_ 'c_))
       (r (dk-skolem! ex #t)))
  (dk-split-all!)
  (let* ((rp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h r) (dk-contains? h 'bf_))) "R"))
         (rb (dk-cite! 'sesq-riesz-bounded 'v 'bf_ 'c_ r))
         (s (list 'OP-ADJOINT 'v 'v r)))
    (dk-cite! 'op-adjoint-bounded 'v 'v r)
    (dk-cite! 'bop-fun 'v 'v s)
    (ew s)
    (dk-conj-close!
      (lambda ()
        (cond ((bsf-done?) #t)
              ((dk-ass!) #t)
              (#t
               (let* ((pl (dk-peel!)) (x (cadr (car pl))) (y (cadr (cadr pl)))
                      (sx (list s x)) (ry (list r y)))
                 (dk-cite! 'fun-apply-type-c s bsf-V bsf-V x)
                 (dk-cite! 'fun-apply-type-c r bsf-V bsf-V y)
                 (subst (dk-apply! (dk-cite! 'cips-ip-conj-sym 'v) y sx))
                 (let ((e2 (dk-cite! 'op-adjoint-ip 'v 'v r y x)))
                   (subst (list '= (caddr e2) (cadr e2))))
                 (subst (dk-apply! (dk-cite! 'cips-ip-conj-sym 'v) x ry))
                 (dk-apply! (dk-cite! 'cips-ip-type 'v) x ry)
                 (subst (dk-cite! 'cc-conjugate-involution (bsf-ip x ry)))
                 (dk-apply! rp y x)
                 (bsf-ass!))))))))
(bsf-qed! 'bounded-sesquilinear-form-operator)

(sp (make-wff (forall-guarded '(v bf_ s1_ s2_)
   (list '(IS-HILBERT-SPACE v) (list 'IN 'bf_ bsf-F) '(IN s1_ (BOUNDED-OPS v v)) '(IN s2_ (BOUNDED-OPS v v))
         (bsf-rep 's1_) (bsf-rep 's2_))
   '(= s1_ s2_))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bop-fun 'v 'v 's1_) (dk-cite! 'bop-fun 'v 'v 's2_)
(dk-fun-ext! 's1_ 's2_ bsf-V bsf-V
  (lambda () (bsf-ass!)) (lambda () (bsf-ass!))
  (lambda (x)
    (let ((e1 (list 's1_ x)) (e2 (list 's2_ x)))
      (dk-cite! 'fun-apply-type-c 's1_ bsf-V bsf-V x)
      (dk-cite! 'fun-apply-type-c 's2_ bsf-V bsf-V x)
      (dk-have! (bsf-all '((hrx_ (VEC v))) (list '= (bsf-ip 'hrx_ e1) (bsf-ip 'hrx_ e2)))
        (lambda ()
          (let ((h (dk-di-var!)))
            (subst (dk-apply! (dk-cite! 'cips-ip-conj-sym 'v) e1 h))
            (subst (dk-apply! (dk-cite! 'cips-ip-conj-sym 'v) e2 h))
            (let* ((q1 (dk-apply! (bsf-rep 's1_) x h)) (q2 (dk-apply! (bsf-rep 's2_) x h)))
              (bsf-type! x h)
              (subst (list '= (bsf-ip e1 h) (bsf-b x h)))
              (subst (list '= (bsf-ip e2 h) (bsf-b x h)))
              (dk-cite! 'cc-conjugate-closed (bsf-b x h))
              (rfl)))))
      (dk-cite! 'cips-ip-separates 'v e1 e2)
      (bsf-ass!))))
(bsf-qed! 'bounded-sesquilinear-form-unique)
