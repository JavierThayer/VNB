                  (dk-cite! 'dual-lam-neg-in-dual 'm (car (cadr body))) (ass))))
(dnv-qed! 'dual-vneg-typing)

(sp (make-wff (dnv-st '() '() (list 'IN '(VNRM (DUAL m)) (list 'FUN dnv-DV 'RR)))))
(dnv-slot-type! 'VNRM
  (lambda (t) (dnv-dn-parts! (caddr t)) (ass)))
(dnv-qed! 'dual-vnrm-typing)

;;; =====================================================================
;;; (7) THE VECTOR-SPACE EQUATIONS, POINTWISE
;;; =====================================================================

(define (dnv-dop? t h) (and (pair? t) (equal? (car t) (list h dnv-D))))
(define dnv-vz '(VZERO (DUAL m)))
(define (dnv-dterm? t) (or (equal? t dnv-vz) (dnv-dop? t 'VADD) (dnv-dop? t 'ACT) (dnv-dop? t 'VNEG)))
(define (dnv-dv! t)
  (let ((ty (dnv-inDV t)))
    (cond ((dk-asm? ty) ty)
          ((equal? t dnv-vz) (dk-cite! 'dual-vzero-in-dual 'm) ty)
          ((dnv-dop? t 'VADD) (dnv-dv! (cadr t)) (dnv-dv! (caddr t))
           (dk-cite! 'dual-vadd-in-dual 'm (cadr t) (caddr t)) ty)
          ((dnv-dop? t 'ACT) (dnv-real! (cadr t)) (dnv-dv! (caddr t))
           (dk-cite! 'dual-act-in-dual 'm (cadr t) (caddr t)) ty)
          ((dnv-dop? t 'VNEG) (dnv-dv! (cadr t)) (dk-cite! 'dual-vneg-in-dual 'm (cadr t)) ty)
          (#t (error "dnv-dv!: no typing for" t)))))
(define (dnv-eval! v)
  (let loop ((k 0))
    (let ((hit (dnv-find (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) v) (dnv-dterm? (car e))))
                         (dk-goal))))
      (if (and hit (< k 40))
          (let* ((f (car hit))
                 (eqn (cond ((equal? f dnv-vz) (dk-cite! 'dual-vzero-apply 'm v))
                            ((dnv-dop? f 'VADD) (dnv-dv! (cadr f)) (dnv-dv! (caddr f))
                             (dk-cite! 'dual-vadd-apply 'm (cadr f) (caddr f) v))
                            ((dnv-dop? f 'ACT) (dnv-real! (cadr f)) (dnv-dv! (caddr f))
                             (dk-cite! 'dual-act-apply 'm (cadr f) (caddr f) v))
                            (#t (dnv-dv! (cadr f)) (dk-cite! 'dual-vneg-apply 'm (cadr f) v)))))
            (subst eqn)
            (loop (+ k 1)))))))
(define (dnv-ext!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (dnv-dv! l) (dnv-dv! r)
    (if (not (dk-asm? (list 'IN l dnv-F))) (dk-cite! 'dual-vec-fun 'm l))
    (if (not (dk-asm? (list 'IN r dnv-F))) (dk-cite! 'dual-vec-fun 'm r))
    (dk-fun-ext! l r dnv-V 'RR #f #f
      (lambda (v) (dnv-eval! v) (dnv-type-atoms!) (dnv-close-eq!)))))

;;; =====================================================================
;;; (8) DUAL(m) IS A NORMED VECTOR SPACE
;;; =====================================================================

(define dnv-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (dnv-has-redex? e)
  (cond ((and (pair? e) (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) #t)
        ((pair? e) (or (dnv-has-redex? (car e)) (dnv-has-redex? (cdr e))))
        (#t #f)))
(define (dnv-close-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'DUAL) (len-r) (arith))
      ((dk-head-is? g 'IS-RING) (dk-cite! 'commutative-ring-is-ring (cadr g)) (ass))
      ((and (dk-head-is? g 'IN) (dk-asm? g)) (ass))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) dnv-vz)) (dk-cite! 'dual-vzero-in-dual 'm) (ass))
      ((and (dk-head-is? g 'IN) (pair? (cadr g)) (memq (car (cadr g)) '(VADD VNEG ACT VNRM)))
       (dk-cite! (cdr (assq (car (cadr g)) '((VADD . dual-vadd-typing) (VNEG . dual-vneg-typing)
                                            (ACT . dual-act-typing) (VNRM . dual-vnrm-typing))))
                 'm)
       (ass))
      ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses))
       (mac (dk-head g)) (dnv-close-leaf!))
      ((dk-head-is? g 'FORALL)
       (dk-peel!)
       (if (dnv-has-redex? (dk-goal)) (dk-lam-b!))
       (dnv-close-leaf!))
      ((dk-head-is? g 'AND)
       (for-each (lambda (l) (dk-focus! l) (dnv-close-leaf!)) (dk-opened (lambda () (di)))))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
      ((and (dk-head-is? g '=) (pair? (cadr g)) (equal? (car (cadr g)) '(VNRM (DUAL m))))
       (let ((arg (cadr (cadr g))))
         (dk-cite! 'dual-vnrm-homogeneous 'm (cadr arg) (caddr arg)) (ass)))
      ((dk-head-is? g '=) (dnv-ext!))
      ((dk-head-is? g 'IFF)
       (dk-cite! 'dual-vnrm-definite 'm (cadr (cadr (cadr g)))) (ass))
      ((and (dk-head-is? g '<=) (eqv? (cadr g) 0))
       (dk-cite! 'dual-vnrm-nonneg 'm (cadr (caddr g))) (ass))
      ((dk-head-is? g '<=)
       (let ((arg (cadr (cadr g))))
         (dk-cite! 'dual-vnrm-triangle 'm (cadr arg) (caddr arg)) (ass)))
      (#t (error "dnv-close-leaf!: unexpected leaf" g)))))

(sp (make-wff '(FORALL m (IMPLIES (IS-NORMED-VECTOR-SPACE m) (IS-NORMED-VECTOR-SPACE (DUAL m))))))
(dk-peel!)
(dnv-certify!)
(begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-carrier-proven 'm))
(begin (dk-cite! 'dual-vec-in-set 'm) (dk-cite! 'dual-scal-proven 'm))
(mac 'IS-NORMED-VECTOR-SPACE)
(subst (list '= '(VEC (DUAL m)) dnv-DV))
(subst (list '= '(SCAL (DUAL m)) dnv-ring))
(for-each (lambda (mc) (vnb-guard (lambda () (mac mc))))
          '(rr-scalar-ring-carr rr-scalar-ring-add rr-scalar-ring-mul rr-scalar-ring-one))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 60)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (dnv-close-leaf!))))
          (dk-open-leaves))
;;; the owed definedness leaves of the slot macetes, (= (OP (DUAL m)) (OP (DUAL m))): read the slot
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (let ((g (dk-goal-of l)))
                  (dk-focus! l)
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)) (pair? (cadr g))
                           (equal? (cdr (cadr g)) (list dnv-D)))
                      (begin (dnv-vec-set!) (mac 'DUAL) (slot (car (cadr g))) (nth-r) (rfl))
                      (dnv-close-leaf!)))))
          (dk-open-leaves))
(dnv-qed! 'dual-is-normed-vector-space)
