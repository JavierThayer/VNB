;; DUAL-NORM(LAM) <= C from LAM's linearity and bound lemmas; C typed, 0 <= C in context
(define (dnv-le-bound! lam lin-thm bound-thm args c)
  (apply dk-cite! lin-thm 'm args)
  (apply dk-cite! bound-thm 'm args)
  (dk-cite! 'dual-norm-le-bound-nvs 'm lam c))

(sp (make-wff (dnv-st '(f g) (list (dnv-inDV 'f) (dnv-inDV 'g))
