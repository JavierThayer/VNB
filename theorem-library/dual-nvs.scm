(define (dnv-cart-set!)
  (let ((g (dk-goal)))
    (if (dk-head-is? (cadr g) 'CARTESIAN)
        (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (ass))))
;; the slot lambda, read off; TYPER gets the pointwise goal after the peel
(define (dnv-slot-type! acc typer)
  (dk-peel!)
  (dnv-certify!)
  (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
  (mac 'DUAL)
  (slot acc)
  (nth-r)
  (dk-lam-type!
    (lambda () (dk-peel!) (typer (cadr (dk-goal))))
    dnv-cart-set!))

(sp (make-wff (dnv-st '() '() (list 'IN '(VADD (DUAL m)) (list 'FUN (list 'CARTESIAN dnv-DV dnv-DV) dnv-DV)))))
(dnv-slot-type! 'VADD
  (lambda (lam) (let ((body (cadddr lam)))
                  (dk-cite! 'dual-lam-add-in-dual 'm (car (cadr body)) (car (caddr body))) (ass))))
(dnv-qed! 'dual-vadd-typing)

(sp (make-wff (dnv-st '() '() (list 'IN '(ACT (DUAL m)) (list 'FUN (list 'CARTESIAN 'RR dnv-DV) dnv-DV)))))
(dnv-slot-type! 'ACT
  (lambda (lam) (let ((body (cadddr lam)))
                  (dk-cite! 'dual-lam-act-in-dual 'm (cadr body) (car (caddr body))) (ass))))
(dnv-qed! 'dual-act-typing)

(sp (make-wff (dnv-st '() '() (list 'IN '(VNEG (DUAL m)) (list 'FUN dnv-DV dnv-DV)))))
(dnv-slot-type! 'VNEG
