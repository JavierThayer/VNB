                                                 (list 'IN (dnv-dn 'f) 'RR) (list 'IN (dnv-dn 'g) 'RR))))
  (dnv-le-bound! (dnv-lam-add 'f 'g) 'dual-lam-add-linear 'dual-lam-add-bound '(f g) c)
  (ass))
(dnv-qed! 'dual-vnrm-triangle)

;;; ---- definiteness -------------------------------------------------------
(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f) (list '= (dnv-dn 'f) 0)) '(= f (VZERO (DUAL m))))))
(dk-peel!)
(subst (dnv-eqn (dk-cite! 'dual-vzero-readoff 'm)))
(dk-cite! 'dual-vec-fun 'm 'f)
(dk-cite! 'dual-lam-zero-fun 'm)
(dk-fun-ext! 'f dnv-lam-zero dnv-V 'RR #f #f
  (lambda (v)
    (dk-lam-b!)
    (let* ((fv (list 'f v)) (afv (list 'abs fv)) (nv (list '(VNRM m) v)))
      (dnv-real! fv) (dnv-real! afv) (dnv-real! nv) (dnv-dn-parts! 'f)
      (let* ((b0 (dk-cite! 'dual-norm-is-bound-nvs 'm 'f v))
             (b1 (dk-rewrite-h! b0 (dnv-dn 'f) 0)))
        (dk-have! (list '<= afv 0) (lambda () (dk-ineq! b1 (list 'IN afv 'RR) (list 'IN nv 'RR))))
        (dk-cite! 'rr-abs-nonneg fv)
        (dnv-real! 0)
        (dnv-and! (list 'IN afv 'RR) '(IN 0 RR))
        (dnv-and! (list '<= afv 0) (list '<= 0 afv))
        (let* ((e (dk-cite! 'rr-leq-antisymmetric afv 0))
              (iff (dk-cite! 'rr-abs-zero fv)))
          (dk-only! e iff)
          (prop))))))
(dnv-qed! 'dual-norm-zero-is-vzero)

(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f) '(= f (VZERO (DUAL m)))) (list '= (dnv-dn 'f) 0))))
(dk-peel!)
(subst '(= f (VZERO (DUAL m))))
(subst (dnv-eqn (dk-cite! 'dual-vzero-readoff 'm)))
(dk-cite! 'dual-lam-zero-in-dual 'm)
