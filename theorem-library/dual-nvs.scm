(sp (make-wff (forall-guarded '(m f r x) (list (dnv-inDV 'f) '(IN r RR) (list 'IN 'x dnv-V))
                              '(= (f ((ACT m) r x)) (* r (f x))))))
(dk-peel!)
(dk-cite! 'dual-vec-blf 'm 'f)
(dk-project! '(IS-LINEAR-FUNCTIONAL m f) 'is-bounded-linear-functional '(IS-BOUNDED-LINEAR-FUNCTIONAL m f))
(mac-h 'is-linear-functional '(IS-LINEAR-FUNCTIONAL m f))
(dk-split-all!)
(dk-apply! (dk-ctx-form '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m))
                            (= (f ((ACT m) r_ x_)) (* r_ (f x_))))))))
           'r 'x)
(ass)
(dnv-qed! 'dual-vec-homogeneous)

