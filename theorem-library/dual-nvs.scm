;;; the two linearity laws and the operator-norm facts of a member
(sp (make-wff (forall-guarded '(m f x y) (list (dnv-inDV 'f) (list 'IN 'x dnv-V) (list 'IN 'y dnv-V))
                              '(= (f ((VADD m) x y)) (+ (f x) (f y))))))
(dk-peel!)
(dk-cite! 'dual-vec-blf 'm 'f)
(dk-project! '(IS-LINEAR-FUNCTIONAL m f) 'is-bounded-linear-functional '(IS-BOUNDED-LINEAR-FUNCTIONAL m f))
