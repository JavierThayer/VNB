(define (dnv-fun-set!)
  (dnv-vec-set!)
  (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
  (if (not (dk-asm? (list 'IN dnv-F 'SET)))
      (dk-have! (list 'IN dnv-F 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))))

(sp (make-wff (dnv-st '() '() (list 'IN dnv-DV 'SET))))
(dk-peel!)
(dnv-fun-set!)
