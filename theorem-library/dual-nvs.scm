(dk-split-all!)
(dk-apply! (dk-ctx-form '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m))
                            (= (f ((VADD m) x_ y_)) (+ (f x_) (f y_))))))))
           'x 'y)
(ass)
