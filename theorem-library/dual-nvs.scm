;;; dual-nvs.scm -- THE DUAL OF A REAL NORMED VECTOR SPACE IS A NORMED VECTOR SPACE.
;;; Agent DUAL-FIX, 2026-10-26.  DESTINATION: theorem-library/dual-nvs.scm.  Library: analysis.
;;; Helper prefix: dnv-.
;;;
;;; structure-library/dual-space.scm defines DUAL(m) = [ring view of RR, DUAL-VEC(m), pointwise +,
;;; the zero functional, pointwise -, pointwise scaling, DUAL-NORM(m, .)].  Its scalar slot held the
;;; 7-tuple RR-NORMED-FIELD until 2026-10-26, which made dual-is-normed-vector-space FALSE (7 = 6 at
;;; m = RR-NVS); with the slot holding NORMED-FIELD-AS-COMMUTATIVE-RING(RR-NORMED-FIELD), as
;;; IS-NORMED-VECTOR-SPACE pins it, the statement is proven here:
;;;
;;;   dual-is-normed-vector-space:  forall m. IS-NORMED-VECTOR-SPACE(m) => IS-NORMED-VECTOR-SPACE(DUAL(m)).
;;;
;;; THE ROUTE.  (1) DUAL-VEC(m) is a set; its members are the functions VEC m -> RR that are bounded
;;; linear functionals.  (2) Each slot of the tuple, read off and beta-reduced, is a lambda on VEC m;
;;; each such lambda is linear, is bounded by an explicit constant (DUAL-NORM f + DUAL-NORM g for the
;;; sum, DUAL-NORM f for the negative, 0 for zero, |r| DUAL-NORM f for the scaling), hence lies in
;;; DUAL-VEC(m).  (3) The operator-norm laws: nonnegativity and the triangle inequality from
;;; DUAL-NORM's leastness (dual-norm-le-bound-nvs); definiteness by extensionality; homogeneity in
;;; both directions, the reverse one by scaling the bound of r f by recip |r| (r /= 0) and a case on
;;; r = 0.  (4) The eight vector-space equations by extensionality over VEC m, pointwise ring
;;; identities.  (5) The structure predicate, slot by slot.
;;;
;;; The read-offs of dual-space.scm are cited in their PROVEN forms (theorem-library/dual-space-readoffs:
;;; dual-vec-membership-proven, and dual-carrier-proven, dual-scal-proven, dual-norm-value-proven with
;;; the guard DUAL-VEC(m) in SET, landed from dual-vec-in-set); no stamp is cited.  Every qed modulo 0.

(define (dnv-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; DNV OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (dnv-dump tag)
  (display ";; DNV ") (display tag) (display " goal: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (l) (display ";; DNV   open: ") (display (expression->string (dk-goal-of l))) (newline))
            (dk-open-leaves)))
(define (dnv-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))

(define dnv-D  '(DUAL m))
(define dnv-DV '(DUAL-VEC m))
(define dnv-V  '(VEC m))
(define dnv-F  '(FUN (VEC m) RR))
(define dnv-nvs '(IS-NORMED-VECTOR-SPACE m))
(define (dnv-st vars guards body) (forall-guarded (cons 'm vars) (cons dnv-nvs guards) body))
(define (dnv-inDV v) (list 'IN v dnv-DV))

;;; the lambdas of the tuple, at the functionals / scalar given
(define (dnv-lam-add f g) (list 'VNB-LAMBDA 'dlax_ dnv-V (list '+ (list f 'dlax_) (list g 'dlax_))))
(define (dnv-lam-neg f)   (list 'VNB-LAMBDA 'dlnx_ dnv-V (list '- (list f 'dlnx_))))
(define (dnv-lam-act r f) (list 'VNB-LAMBDA 'dlsx_ dnv-V (list '* r (list f 'dlsx_))))
(define dnv-lam-zero      (list 'VNB-LAMBDA 'dlzx_ dnv-V 0))

