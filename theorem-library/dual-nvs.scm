;; 0 <= |r| DUAL-NORM(f), landed
(define (dnv-act-c-nonneg! c)
  (dnv-real! c)
  (dk-cite! 'rr-abs-nonneg 'r)
  (let ((h (dk-cite! 'rr-mul-le-right 0 (dnv-dn 'f) '(abs r))))
    (dk-have! (list '<= 0 c)
      (lambda ()
        (subst (dnv-eq! c (list '* (dnv-dn 'f) '(abs r))))
        (dnv-eq! '(* 0 (abs r)) 0)
        (dk-rewrite-h! h '(* 0 (abs r)) 0)
        (ass)))))

;; |r| DUAL-NORM(f) <= DUAL-NORM(x |-> r f(x))
(define dnv-lams (dnv-lam-act 'r 'f))
(sp (make-wff (dnv-st '(r f) (list '(IN r RR) (dnv-inDV 'f))
                      (list '<= (list '* '(abs r) (dnv-dn 'f)) (dnv-dn dnv-lams)))))
(dk-peel!)
(dk-cite! 'dual-lam-act-in-dual 'm 'r 'f)
(dk-cite! 'dual-vec-blf 'm dnv-lams)
(dnv-dn-parts! dnv-lams)
(dnv-dn-parts! 'f)
(dnv-real! '(abs r))
(dk-cite! 'rr-abs-nonneg 'r)
(use-em '(= r 0)
  (lambda ()
    (dk-have! '(= (abs r) 0) (lambda () (subst '(= r 0)) (fact 'rr-abs-zero-value) (ass)))
    (subst '(= (abs r) 0))
    (dk-ineq! (list '<= 0 (dnv-dn dnv-lams)) (list 'IN (dnv-dn dnv-lams) 'RR) (list 'IN (dnv-dn 'f) 'RR)))
  (lambda ()
    (let* ((a '(abs r)) (k (dnv-dn dnv-lams)) (n (dnv-dn 'f))
           (iff (dk-cite! 'rr-abs-zero 'r)))
      (dk-have! (list 'NOT (list '= a 0)) (lambda () (dk-only! iff '(NOT (= r 0))) (prop)))
      (dk-cite! 'dual-rr-pos-of-nonneg-nonzero a)
      (dnv-and! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
      (dk-cite! 'rr-recip-closed a)
      (let* ((inv (dk-cite! 'rr-recip-inverse a))
             (v (dk-name! (list 'recip a)))
             (av (list '* a v)))
        (dk-have! (list '= av 1) (lambda () (subst (list '= v (list 'recip a))) (ass)))
        (dk-cite! 'rr-recip-pos a)
        (dk-have! (list '<= 0 v) (lambda () (subst (list '= v (list 'recip a)))
                                            (dk-ineq! (list '< 0 (list 'recip a)) (list 'IN (list 'recip a) 'RR))))
        (let ((kv (list '* k v)))
          (dnv-real! kv)
          ;; every w: |f w| <= (K v) ||w||
          (dk-have! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w dnv-V)
                          (list '<= '(abs (f w)) (list '* kv dnv-nw))))
            (lambda ()
              (dk-peel!)
              (let* ((fw '(f w)) (afw '(abs (f w))))
                (dnv-real! fw) (dnv-real! afw) (dnv-real! dnv-nw)
                (let* ((b0 (dk-cite! 'dual-norm-is-bound-nvs 'm dnv-lams 'w))
                       (ap (dk-have! (list '= (list dnv-lams 'w) (list '* 'r fw)) (lambda () (dk-lam-b!) (rfl))))
                       (b1 (dk-rewrite-h! b0 (list dnv-lams 'w) (list '* 'r fw))))
                  (dnv-and! '(IN r RR) (list 'IN fw 'RR))
                  (dk-cite! 'rr-abs-mult 'r fw)
                  (let* ((b2 (dk-rewrite-h! b1 (list 'abs (list '* 'r fw)) (list '* a afw)
                                            ))
                         (rhs (list '* (list '* kv dnv-nw) a)))
                    (dnv-real! rhs)
                    (dk-have! (list '<= (list '* afw a) rhs)
                      (lambda ()
                        (subst (dnv-eq! (list '* afw a) (list '* a afw)))
                        (subst (dnv-eq! rhs (list '* (list '* k dnv-nw) av)))
                        (subst (list '= av 1))
                        (subst (dnv-eq! (list '* (list '* k dnv-nw) 1) (list '* k dnv-nw)))
                        (ass)))
                    (dk-cite! 'rr-mul-le-cancel-pos afw a (list '* kv dnv-nw))
                    (ass))))))
          ;; hence DUAL-NORM(f) <= K v
          (dk-cite! 'dual-vec-blf 'm 'f)
          (dk-project! '(IS-LINEAR-FUNCTIONAL m f) 'is-bounded-linear-functional '(IS-BOUNDED-LINEAR-FUNCTIONAL m f))
          (let ((h (dk-cite! 'rr-mul-le-right 0 k v)))
            (dk-have! (list '<= 0 kv)
              (lambda ()
                (dnv-eq! (list '* 0 v) 0)
                (dk-rewrite-h! h (list '* 0 v) 0)
                (ass))))
          (dk-cite! 'dual-norm-le-bound-nvs 'm 'f kv)
          ;; times |r|
          (let* ((h1 (dk-cite! 'rr-mul-le-right n kv a))
                 (e1 (dnv-eq! (list '* kv a) (list '* k av)))
                 (h2 (dk-rewrite-h! h1 (list '* kv a) (list '* k av)))
                 (h3 (dk-rewrite-h! h2 av 1))
                 (e2 (dnv-eq! (list '* k 1) k))
                 (h4 (dk-rewrite-h! h3 (list '* k 1) k)))
            (subst (dnv-eq! (list '* a n) (list '* n a)))
            (ass)))))))
(dnv-qed! 'dual-lam-act-norm-ge)

(sp (make-wff (dnv-st '(r f) (list '(IN r RR) (dnv-inDV 'f))
                      (list '= (dnv-vn '((ACT (DUAL m)) r f)) (list '* '(abs r) (dnv-vn 'f))))))
(dk-peel!)
(dk-cite! 'dual-act-in-dual 'm 'r 'f)
(dnv-norm-value! '((ACT (DUAL m)) r f))
(dnv-norm-value! 'f)
(subst (dnv-eqn (dk-cite! 'dual-act-readoff 'm 'r 'f)))
(dk-cite! 'dual-lam-act-in-dual 'm 'r 'f)
(dk-cite! 'dual-vec-blf 'm dnv-lams)
(dnv-dn-parts! dnv-lams)
(dnv-dn-parts! 'f)
(let ((c (list '* '(abs r) (dnv-dn 'f))) (k (dnv-dn dnv-lams)))
  (dnv-act-c-nonneg! c)
  (dnv-le-bound! dnv-lams 'dual-lam-act-linear 'dual-lam-act-bound '(r f) c)
  (dk-cite! 'dual-lam-act-norm-ge 'm 'r 'f)
  (dnv-and! (list 'IN k 'RR) (list 'IN c 'RR))
  (dnv-and! (list '<= k c) (list '<= c k))
  (dk-cite! 'rr-leq-antisymmetric k c)
  (ass))
(dnv-qed! 'dual-vnrm-homogeneous)

