(dnv-dn-parts! dnv-lam-zero)
(dnv-real! 0)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dnv-le-bound! dnv-lam-zero 'dual-lam-zero-linear 'dual-lam-zero-bound '() 0)
(let ((k (dnv-dn dnv-lam-zero)))
  (dnv-and! (list 'IN k 'RR) '(IN 0 RR))
  (dnv-and! (list '<= k 0) (list '<= 0 k))
  (dk-cite! 'rr-leq-antisymmetric k 0)
  (ass))
(dnv-qed! 'dual-vzero-norm-zero)

(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f))
                      (list 'IFF (list '= (dnv-vn 'f) 0) '(= f (VZERO (DUAL m)))))))
