;;; =====================================================================
;;; (3) THE FOUR LAMBDAS ARE BOUNDED LINEAR FUNCTIONALS
;;; =====================================================================

;;; (IN (f x) RR) for a member f of DUAL-VEC(m) and x in VEC m
(define (dnv-app! f x)
  (let ((ty (list 'IN (list f x) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (if (not (dk-asm? (list 'IN f dnv-F))) (dk-cite! 'dual-vec-fun 'm f))
          (dk-cite! 'fun-apply-type-c f dnv-V 'RR x)))
    ty))
(define (dnv-dn-parts! f)
  (if (not (dk-asm? (list 'IN (list 'DUAL-NORM 'm f) 'RR)))
      (begin
        (if (not (dk-asm? (list 'IS-BOUNDED-LINEAR-FUNCTIONAL 'm f))) (dk-cite! 'dual-vec-blf 'm f))
        (dk-split! (dk-cite! 'dual-norm-nonneg-nvs 'm f)))))
(define (dnv-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((eqv? t 0) (dk-cite! 'rr-zero-in) ty)
          ((eqv? t 1) (dk-cite! 'rr-one-in) ty)
          ((and (pair? t) (= (length t) 2) (symbol? (car t)) (dk-asm? (dnv-inDV (car t))))
           (dnv-app! (car t) (cadr t)))
          ((and (pair? t) (equal? (car t) '(VNRM m))) (dk-cite! 'vnrm-real 'm (cadr t)) ty)
          ((dk-head-is? t 'DUAL-NORM) (dnv-dn-parts! (caddr t)) ty)
          ((dk-head-is? t 'abs) (dnv-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (dnv-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (dnv-real! (cadr t)) (dnv-real! (caddr t))
           (dnv-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))
;;; (IN t (VEC m)) for a vector term of m
(define (dnv-vtype! t)
  (let ((ty (list 'IN t dnv-V)))
    (cond ((dk-asm? ty) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (dnv-vtype! (cadr t)) (dnv-vtype! (caddr t)) (dk-cite! 'nvs-vadd-in-vec 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (dnv-real! (cadr t)) (dnv-vtype! (caddr t)) (dk-cite! 'nvs-act-in-vec 'm (cadr t) (caddr t)) ty)
          (#t (error "dnv-vtype!: no typing for" t)))))
(define (dnv-find pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((dnv-find pred (car l))) (#t (loop (cdr l))))))
        (#t #f)))
(define (dnv-close-eq!)
  (let ((g (dk-goal)))
    (if (equal? (cadr g) (caddr g)) (rfl) (crs))))

;;; ---- the pointwise typing of each lambda -------------------------------
(define (dnv-lam-fun!)
  (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dnv-real! (cadr (dk-goal))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
                (lambda () (dnv-vec-set!) (ass))))
(sp (make-wff (dnv-st '(f g) (list (dnv-inDV 'f) (dnv-inDV 'g)) (list 'IN (dnv-lam-add 'f 'g) dnv-F))))
(dk-peel!)
(dnv-lam-fun!)
(dnv-qed! 'dual-lam-add-fun)
(sp (make-wff (dnv-st '(r f) (list '(IN r RR) (dnv-inDV 'f)) (list 'IN (dnv-lam-act 'r 'f) dnv-F))))
(dk-peel!)
(dnv-lam-fun!)
(dnv-qed! 'dual-lam-act-fun)
(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f)) (list 'IN (dnv-lam-neg 'f) dnv-F))))
(dk-peel!)
(dnv-lam-fun!)
(dnv-qed! 'dual-lam-neg-fun)
(sp (make-wff (dnv-st '() '() (list 'IN dnv-lam-zero dnv-F))))
(dk-peel!)
(dnv-lam-fun!)
(dnv-qed! 'dual-lam-zero-fun)

;;; ---- linearity ----------------------------------------------------------
;;; rewrite every (phi ((VADD m) a b)) / (phi ((ACT m) c a)), phi a member, by the member's laws
(define (dnv-linearize!)
  (let loop ((k 0))
    (let ((hit (dnv-find (lambda (e) (and (pair? e) (= (length e) 2) (symbol? (car e))
                                          (dk-asm? (dnv-inDV (car e)))
                                          (pair? (cadr e))
                                          (member (car (cadr e)) '((VADD m) (ACT m)))))
                         (dk-goal))))
      (if (and hit (< k 20))
          (let* ((phi (car hit)) (arg (cadr hit))
                 (eqn (if (equal? (car arg) '(VADD m))
                          (begin (dnv-vtype! (cadr arg)) (dnv-vtype! (caddr arg))
                                 (dk-cite! 'dual-vec-additive 'm phi (cadr arg) (caddr arg)))
                          (begin (dnv-real! (cadr arg)) (dnv-vtype! (caddr arg))
                                 (dk-cite! 'dual-vec-homogeneous 'm phi (cadr arg) (caddr arg))))))
            (subst eqn)
            (loop (+ k 1)))))))
;;; type every atom (phi a) of the goal
(define (dnv-type-atoms!)
  (let walk ((e (dk-goal)))
    (cond ((and (pair? e) (= (length e) 2) (symbol? (car e)) (dk-asm? (dnv-inDV (car e))))
           (dnv-app! (car e) (cadr e)))
          ((pair? e) (for-each walk e)))))
(define (dnv-linear! lam-fun-thm lam-fun-args)
  (mac 'is-linear-functional)
  (let loop ((k 0))
    (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
      (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (dk-head-is? (dk-goal) 'IN)
                (begin (apply dk-cite! lam-fun-thm 'm lam-fun-args) (ass))
                (begin
                  (dk-peel!)
                  (let ((g (dk-goal)))
                    (dnv-vtype! (cadr (cadr g))))
                  (dk-lam-b!)
                  (dnv-linearize!)
                  (dnv-type-atoms!)
                  (dnv-close-eq!))))))
    (dk-open-leaves)))

(sp (make-wff (dnv-st '(f g) (list (dnv-inDV 'f) (dnv-inDV 'g))
                      (list 'IS-LINEAR-FUNCTIONAL 'm (dnv-lam-add 'f 'g)))))
(dk-peel!)
(dnv-linear! 'dual-lam-add-fun '(f g))
(dnv-qed! 'dual-lam-add-linear)
(sp (make-wff (dnv-st '(r f) (list '(IN r RR) (dnv-inDV 'f))
                      (list 'IS-LINEAR-FUNCTIONAL 'm (dnv-lam-act 'r 'f)))))
(dk-peel!)
(dnv-linear! 'dual-lam-act-fun '(r f))
(dnv-qed! 'dual-lam-act-linear)
(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f))
                      (list 'IS-LINEAR-FUNCTIONAL 'm (dnv-lam-neg 'f)))))
(dk-peel!)
(dnv-linear! 'dual-lam-neg-fun '(f))
(dnv-qed! 'dual-lam-neg-linear)
(sp (make-wff (dnv-st '() '() (list 'IS-LINEAR-FUNCTIONAL 'm dnv-lam-zero))))
(dk-peel!)
(dnv-linear! 'dual-lam-zero-fun '())
(dnv-qed! 'dual-lam-zero-linear)

;;; ---- the bounds ---------------------------------------------------------
(define (dnv-bound-st vars guards lam c)
  (dnv-st vars guards
    (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w dnv-V)
                           (list '<= (list 'abs (list lam 'w)) (list '* c '((VNRM m) w)))))))
(define (dnv-dn f) (list 'DUAL-NORM 'm f))
(define dnv-nw '((VNRM m) w))
;; |f w| <= DUAL-NORM(f) ||w||, with every atom typed
(define (dnv-isbound! f)
  (dnv-real! (list f 'w)) (dnv-real! dnv-nw) (dnv-dn-parts! f)
  (dk-cite! 'dual-norm-is-bound-nvs 'm f 'w))
(define (dnv-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))

;; ineq drops the products DUAL-NORM(f) ||w|| as premises: the linear step is a lemma over variables.
(sp (make-wff (forall-guarded '(a b c p q) '((IN a RR) (IN b RR) (IN c RR) (IN p RR) (IN q RR)
                                              (<= c (+ a b)) (<= a p) (<= b q))
                              '(<= c (+ p q)))))
(dk-peel!)
(dk-ineq! '(<= c (+ a b)) '(<= a p) '(<= b q) '(IN a RR) '(IN b RR) '(IN c RR) '(IN p RR) '(IN q RR))
(dnv-qed! 'dual-rr-le-sum-of-bounds)

(sp (make-wff (dnv-bound-st '(f g) (list (dnv-inDV 'f) (dnv-inDV 'g)) (dnv-lam-add 'f 'g)
                            (list '+ (dnv-dn 'f) (dnv-dn 'g)))))
(dk-peel!)
(dk-lam-b!)
(let* ((bf (dnv-isbound! 'f)) (bg (dnv-isbound! 'g))
       (tri (begin (dnv-and! '(IN (f w) RR) '(IN (g w) RR)) (dk-cite! 'rr-abs-triangle '(f w) '(g w))))
       (e (dnv-eq! (list '* (list '+ (dnv-dn 'f) (dnv-dn 'g)) dnv-nw)
                   (list '+ (list '* (dnv-dn 'f) dnv-nw) (list '* (dnv-dn 'g) dnv-nw)))))
  (subst e)
  (dnv-real! '(abs (f w))) (dnv-real! '(abs (g w))) (dnv-real! '(abs (+ (f w) (g w))))
  (dnv-real! (list '* (dnv-dn 'f) dnv-nw)) (dnv-real! (list '* (dnv-dn 'g) dnv-nw))
  (dk-cite! 'dual-rr-le-sum-of-bounds '(abs (f w)) '(abs (g w)) '(abs (+ (f w) (g w)))
             (list '* (dnv-dn 'f) dnv-nw) (list '* (dnv-dn 'g) dnv-nw))
  (ass))
(dnv-qed! 'dual-lam-add-bound)

(sp (make-wff (dnv-bound-st '(f) (list (dnv-inDV 'f)) (dnv-lam-neg 'f) (dnv-dn 'f))))
(dk-peel!)
(dk-lam-b!)
(dnv-isbound! 'f)
(subst (dk-cite! 'rr-abs-neg '(f w)))
(ass)
(dnv-qed! 'dual-lam-neg-bound)

(sp (make-wff (dnv-bound-st '() '() dnv-lam-zero 0)))
(dk-peel!)
(dk-lam-b!)
(dnv-real! dnv-nw)
(fact 'rr-abs-zero-value)
(subst '(= (abs 0) 0))
(subst (dnv-eq! (list '* 0 dnv-nw) 0))
(dk-ineq!)
(dnv-qed! 'dual-lam-zero-bound)

(sp (make-wff (dnv-bound-st '(r f) (list '(IN r RR) (dnv-inDV 'f)) (dnv-lam-act 'r 'f)
                            (list '* '(abs r) (dnv-dn 'f)))))
(dk-peel!)
(dk-lam-b!)
(let* ((bf (dnv-isbound! 'f)))
  (dnv-real! '(abs r)) (dnv-real! '(abs (f w))) (dnv-real! (list '* (dnv-dn 'f) dnv-nw))
  (dk-cite! 'rr-abs-nonneg 'r)
  (dnv-and! '(IN r RR) '(IN (f w) RR))
  (subst (dk-cite! 'rr-abs-mult 'r '(f w)))
  (dk-cite! 'rr-mul-le-right '(abs (f w)) (list '* (dnv-dn 'f) dnv-nw) '(abs r))
  (subst (dnv-eq! '(* (abs r) (abs (f w))) '(* (abs (f w)) (abs r))))
  (subst (dnv-eq! (list '* (list '* '(abs r) (dnv-dn 'f)) dnv-nw)
                  (list '* (list '* (dnv-dn 'f) dnv-nw) '(abs r))))
  (ass))
(dnv-qed! 'dual-lam-act-bound)

;;; ---- membership ---------------------------------------------------------
;;; goal (IN LAM DUAL-VEC(m)); C the bound constant, already typed with 0 <= C in context
(define (dnv-in-dv! lam fun-thm lin-thm bound-thm args c)
  (apply dk-cite! fun-thm 'm args)
  (apply dk-cite! lin-thm 'm args)
  (apply dk-cite! bound-thm 'm args)
  (dk-have! (list 'IS-BOUNDED-LINEAR-FUNCTIONAL 'm lam)
    (lambda ()
      (mac 'is-bounded-linear-functional)
      (for-each (lambda (l)
                  (dk-focus! l)
                  (if (dk-head-is? (dk-goal) 'FORSOME)
                      (begin (ew c) (dk-conj-close! (lambda () (ass))))
                      (ass)))
                (dk-opened (lambda () (di))))))
  (dk-cite! 'dual-vec-intro 'm lam)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))

(sp (make-wff (dnv-st '(f g) (list (dnv-inDV 'f) (dnv-inDV 'g)) (dnv-inDV (dnv-lam-add 'f 'g)))))
(dk-peel!)
(let ((c (list '+ (dnv-dn 'f) (dnv-dn 'g))))
  (dnv-real! c)
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 0 (dnv-dn 'f)) (list '<= 0 (dnv-dn 'g))
                                                 (list 'IN (dnv-dn 'f) 'RR) (list 'IN (dnv-dn 'g) 'RR))))
  (dnv-in-dv! (dnv-lam-add 'f 'g) 'dual-lam-add-fun 'dual-lam-add-linear 'dual-lam-add-bound '(f g) c))
(dnv-qed! 'dual-lam-add-in-dual)

(sp (make-wff (dnv-st '(f) (list (dnv-inDV 'f)) (dnv-inDV (dnv-lam-neg 'f)))))
(dk-peel!)
(dnv-real! (dnv-dn 'f))
(dnv-in-dv! (dnv-lam-neg 'f) 'dual-lam-neg-fun 'dual-lam-neg-linear 'dual-lam-neg-bound '(f) (dnv-dn 'f))
(dnv-qed! 'dual-lam-neg-in-dual)

(sp (make-wff (dnv-st '() '() (dnv-inDV dnv-lam-zero))))
