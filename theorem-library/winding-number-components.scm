;;; ======================================================================
;;; (5) WINDING-JUXTA and (6) WINDING-OPPOSITE: the winding number of a juxtaposition
;;; is the sum, of the opposite road the negative
;;; ======================================================================
(define wnc-tpi '(* (* 2 PI) +i))
(define (wnc-tpi!)
  (wnc-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (wnc-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (wnc-cc! wnc-tpi)
  (wnc-cc! (list 'recip wnc-tpi)))
;;; the trace of the road P on [LO, HI] lies in CC \ {z} when z is off it
(define (wnc-trace-off! pg lo hi z)
  (let ((tr (list 'TRACE pg lo hi)))
    (dk-have! (list 'SUBSET tr (wnc-pz z))
      (lambda ()
        (let ((w (subset-by-element!)))
          (fact 'subset-mem-fwd tr 'CC w)
          (dk-have! (list 'NOT (list '= w z))
            (lambda () (di) (dk-have! (list 'IN z tr) (lambda () (subst (list '= z w)) (dk-ass!)))
                       (ai (dk-ctx-form (list 'NOT (list 'IN z tr))))))
          (wnc-pz-in! z w))))))
(define (wnc-road-basics! pg dg lo hi)
  (fact 'is-road-is-path pg dg lo hi)
  (fact 'is-path-in-fun pg lo hi)
  (dk-cite! 'trace-subset-cc pg lo hi)
  (dk-split! (dk-fact! 'is-path-endpoints pg lo hi))
  (dk-split-all!))

(sp (make-wff '(FORALL pgam1 (FORALL dgam1 (FORALL pgam2 (FORALL dgam2 (FORALL a (FORALL b (FORALL c
  (IMPLIES (IS-ROAD pgam1 dgam1 a b) (IMPLIES (IS-ROAD pgam2 dgam2 b c) (IMPLIES (= (pgam1 b) (pgam2 b))
    (FORALL wnz_ (IMPLIES (IN wnz_ CC)
      (IMPLIES (NOT (IN wnz_ (TRACE pgam1 a b))) (IMPLIES (NOT (IN wnz_ (TRACE pgam2 b c)))
        (= (WINDING (JUXTA pgam1 pgam2 a b c) (JUXTA dgam1 dgam2 a b c) a c wnz_)
           (+ (WINDING pgam1 dgam1 a b wnz_) (WINDING pgam2 dgam2 b c wnz_)))))))))))))))))))
(dk-peel!)
(let* ((z 'wnz_) (u (wnc-pz z)) (k (wnc-kern z))
       (l1 (list 'LINE-INT k 'pgam1 'dgam1 'a 'b))
       (l2 (list 'LINE-INT k 'pgam2 'dgam2 'b 'c))
       (l  (list 'LINE-INT k '(JUXTA pgam1 pgam2 a b c) '(JUXTA dgam1 dgam2 a b c) 'a 'c)))
  (wnc-road-basics! 'pgam1 'dgam1 'a 'b)
  (wnc-road-basics! 'pgam2 'dgam2 'b 'c)
  (wnc-pz-setup! z)
  (wnc-kern-setup! z)
  (wnc-trace-off! 'pgam1 'a 'b z)
  (wnc-trace-off! 'pgam2 'b 'c z)
  (dk-cite! 'line-int-juxta u k 'pgam1 'dgam1 'pgam2 'dgam2 'a 'b 'c)
  (dk-cite! 'line-int-in-cc u k 'pgam1 'dgam1 'a 'b)
  (dk-cite! 'line-int-in-cc u k 'pgam2 'dgam2 'b 'c)
  (wnc-tpi!)
  (mac 'WINDING)
  (subst (list '= l (list '+ l1 l2)))
  (let ((v (dk-name! (list 'recip wnc-tpi) 'CC)))
    (subst (list '= (list 'recip wnc-tpi) v))
    (crs)))
(qed 'winding-juxta)

(sp (make-wff "forall([pgam, dgam, a, b], is-road(pgam, dgam, a, b) implies
  forall([prgb_, prdb_], prgb_ in fun(ccint(a, b), cc) implies prdb_ in fun(ccint(a, b), cc) implies
    forall([pay_ in ccint(a, b)], prgb_(pay_) == pgam(a + b - pay_)) implies
    forall([pay_ in ccint(a, b)], prdb_(pay_) == -1 * dgam(a + b - pay_)) implies
    forall([wnz_ in cc], not(wnz_ in trace(pgam, a, b)) implies
      winding(prgb_, prdb_, a, b, wnz_) = -1 * winding(pgam, dgam, a, b, wnz_))))"))
(dk-peel!)
(let* ((z 'wnz_) (u (wnc-pz z)) (k (wnc-kern z))
       (l  (list 'LINE-INT k 'pgam 'dgam 'a 'b))
       (lo (list 'LINE-INT k 'prgb_ 'prdb_ 'a 'b)))
  (wnc-road-basics! 'pgam 'dgam 'a 'b)
  (wnc-pz-setup! z)
  (wnc-kern-setup! z)
  (wnc-trace-off! 'pgam 'a 'b z)
  (dk-apply! (dk-cite! 'line-int-opposite-road u k 'pgam 'dgam 'a 'b) 'prgb_ 'prdb_)
  (dk-cite! 'line-int-in-cc u k 'pgam 'dgam 'a 'b)
  (wnc-tpi!)
  (mac 'WINDING)
  (subst (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) '=) (equal? (cadr fm) lo))) "the opposite integral"))
  (let ((v (dk-name! (list 'recip wnc-tpi) 'CC)))
    (subst (list '= (list 'recip wnc-tpi) v))
    (crs)))
(qed 'winding-opposite)

