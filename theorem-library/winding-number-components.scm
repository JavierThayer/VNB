(define wnc-wi-sz (dk-cite! 'cps-sum-at-zero wnc-wi-tt))
(dk-split-all! (list wnc-wi-sz))
(define wnc-wi-tt2 (cadr (dk-pick (dk-head? 'CC-SERIES-CONVERGES) "the series at 0")))
