(dk-have! (list 'CC-SERIES-CONVERGES-TO wnc-wi-tt2 wnc-wi-lz)
  (lambda () (wnc-subst-ass! (list '= wnc-wi-tt2 wnc-wi-tt))))
(fact 'cc-series-limit-converges-to wnc-wi-tt2)
(define wnc-wi-ps (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM wnc-wi-tt2 'k)))
(define wnc-wi-l2 (list 'CC-SERIES-LIMIT wnc-wi-tt2))
(dk-project! (list 'CONVERGES-TO 'CC-MS wnc-wi-ps wnc-wi-lz) 'cc-series-converges-to
