;;; winding-number-components.scm -- THE WINDING NUMBER IS LOCALLY CONSTANT OFF THE
;;; TRACE, CONSTANT ON A CONNECTED SET OFF THE TRACE, AND 0 ON THE UNBOUNDED COMPONENT
;;; (complex-analysis.pdf ch. 3: Proposition 3.27, second half; Corollary 3.30).
;;; Agent CA-5 of week 3 of the October roadmap, 2026-10-04.
;;; Definitions: structure-library/winding-number.scm (WINDING), structure-library/
;;; metric-connected.scm (IS-CONNECTED, new this batch).
;;;
;;; CONTENTS.
;;;  (1) winding-disc-constant        a closed road, every point of its trace at distance
;;;                                   >= r from c: WINDING(z) = WINDING(c) for |z - c| < r.
;;;                                   The proof of `winding-circle-inside'
;;;                                   (cauchy-integral-formula.scm) for a GENERAL closed
;;;                                   road: Lemma 3.33 (`cauchy-kernel-integral-series')
;;;                                   with the weight 1 expands int 1/(w - z) as
;;;                                   sum_k a_k (z - c)^k, a_k = int (1/(w - c))^(k+1), and
;;;                                   a_k = 0 for k >= 1 (`cif-recip-power-closed-zero').
;;;                                   No integrality is needed for local constancy.
;;;  (2) winding-locally-constant     z0 off the trace: a ball about z0 misses the trace
;;;                                   and WINDING is constant on it.  The radius is
;;;                                   1/(M + 1) for a bound M of |1/(w - z0)| on the trace
;;;                                   (`aif-trace-bounded': a continuous function is bounded
;;;                                   on the trace of a path).
;;;  (3) winding-constant-on-connected  WINDING is constant on every connected set off the
;;;                                   trace (3.27, "constant on the connected components";
;;;                                   a component is such a set).
;;;  (4) winding-zero-unbounded       ... and 0 on a connected set off the trace that
;;;                                   reaches outside a disc containing the trace (3.30;
;;;                                   the unbounded component is such a set).
;;;  (5) winding-juxta                the winding number of a juxtaposition (JUXTA) is the
;;;                                   sum of the two (both pieces off z; no closedness).
;;;  (6) winding-opposite             of the opposite road (written as line-int-opposite-road
;;;                                   writes it, by its pointwise equations) the negative.
;;;
;;; THE NOTES' ROUTE AND THIS ONE.  The notes prove continuity in u, then use "a continuous
;;; integer-valued function is constant on connected components".  Here local constancy
;;; is proven directly from Lemma 3.33, which is stronger than continuity and needs no
;;; integrality (integrality is `winding-number-integer', winding-number-integer.scm);
;;; the passage to connected sets is `connected-locally-constant'
;;; (metric-connected-laws.scm).
;;;
;;; Helper prefix wnc-; the cif- helpers of cauchy-integral-formula.scm are copied under
;;; it (that file is not ours).  NOTHING asserted; no definition here.
;;; LOAD WINDOW: lo = theorem-library/cauchy-integral-formula (cif-recip-power-closed-zero),
;;; above analytic-from-integral (cauchy-kernel-integral-series, aif-trace-bounded,
;;; aif-magnitude-recip, aif-cont-*), winding-number-laws (winding-in-cc,
;;; winding-zero-outside-disc), road-juxtaposition-laws (line-int-juxta), line-int-laws
;;; (line-int-opposite-road), and theorem-library/metric-connected-laws
;;; (connected-locally-constant).  hi: none.  Tactics: the early kit.


;;; ======================================================================
;;; local helpers (copies of cauchy-integral-formula.scm's cif- helpers)
;;; ======================================================================
(define wnc-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (wnc-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (wnc-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS wnc-nfm u) wnc-nfm f 'rgy_))))
(define (wnc-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (wnc-imps (cdr hyps) body))))
(define (wnc-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (wnc-all (cdr vars) body))))
(define (wnc-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (wnc-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (wnc-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((wnc-op? t 'succ 2) (wnc-nn! t) (fact 'nn-in-rr t) typ)
          ((wnc-op? t '* 3) (wnc-rr! (cadr t)) (wnc-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((wnc-op? t '+ 3) (wnc-rr! (cadr t)) (wnc-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((wnc-op? t '- 3) (wnc-rr! (cadr t)) (wnc-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((wnc-op? t '- 2) (wnc-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((wnc-op? t 'magnitude 2) (wnc-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((wnc-op? t 'real-part 2) (wnc-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((wnc-op? t 'imag-part 2) (wnc-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((wnc-op? t 'abs 2) (wnc-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((wnc-op? t 'recip 2)
           (wnc-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "wnc-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (wnc-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (wnc-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((wnc-op? t 'succ 2) (wnc-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (wnc-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (wnc-op? t 'succ 2)
               (wnc-op? t 'magnitude 2) (wnc-op? t 'real-part 2) (wnc-op? t 'imag-part 2))
           (wnc-rr! t) (fact 'rr-subset-cc t) typ)
          ((wnc-op? t '- 3) (wnc-cc! (cadr t)) (wnc-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((wnc-op? t '- 2) (wnc-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((wnc-op? t '+ 3) (wnc-cc! (cadr t)) (wnc-cc! (caddr t))
           (wnc-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((wnc-op? t '* 3) (wnc-cc! (cadr t)) (wnc-cc! (caddr t))
           (wnc-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((wnc-op? t 'power 3) (wnc-cc! (cadr t)) (wnc-nn! (caddr t))
           (wnc-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((wnc-op? t 'CC-EXP 2) (wnc-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((wnc-op? t 'recip 2) (wnc-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "wnc-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (wnc-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (wnc-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (wnc-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (wnc-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (wnc-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (wnc-only-prop! iff (list 'IN y (wnc-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (wnc-only-prop! iff (list 'IN y (wnc-pz z))))))
      (lambda () (wnc-sub-nz! y z)))))
(define (wnc-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (wnc-pz z))
      (lambda () (wnc-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (wnc-pz-setup! z)
  (let* ((d (wnc-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN wnc-nfm d) (lambda () (wnc-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (wnc-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (wnc-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (wnc-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (wnc-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (wnc-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (wnc-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (wnc-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (wnc-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (wnc-R c) (list 'VNB-LAMBDA 'cifv_ (wnc-pz c) (list 'recip (list '- 'cifv_ c))))
(define (wnc-S c) (list 'VNB-LAMBDA 'cifv_ (wnc-pz c) (list '- 'cifv_ c)))
(define (wnc-P c n) (list 'VNB-LAMBDA 'cifv_ (wnc-pz c) (list 'power (list 'recip (list '- 'cifv_ c)) n)))
(define (wnc-pow-succ! a n)
  (wnc-cc! a) (wnc-nn! n)
  (wnc-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
(define (wnc-Hk g k)
  (list 'VNB-LAMBDA 'aiw_ wnc-T (list '* (list g 'aiw_) (list 'power '(recip (- aiw_ c)) (list 'succ k)))))
(define (wnc-LI f) (list 'LINE-INT f 'pgam 'dgam 'a 'b))
(define (wnc-kern-setup! p)
  (let* ((dd (wnc-pz p)) (k (wnc-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))

;;; the road's trace and the kernel about p
(define wnc-T '(TRACE pgam a b))
(define (wnc-kern z) (list 'VNB-LAMBDA 'wnw_ (wnc-pz z) (list 'recip (list '- 'wnw_ z))))
(define (wnc-tpt! x . zs)
  (wnc-steps
    (lambda () (fact 'subset-mem-fwd wnc-T (wnc-pz 'c) x))
    (lambda () (wnc-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd wnc-T (wnc-pz z) x) (wnc-pz-open! z x)) zs))))

;;; ======================================================================
;;; (1) WINDING-DISC-CONSTANT
;;; ======================================================================
(define wnc-dist-h '(FORALL wcy_ (IMPLIES (IN wcy_ (TRACE pgam a b)) (<= r (magnitude (- wcy_ c))))))
;;; y in the trace: y in CC, y /= c, y /= z, y in CC \ {c}, CC \ {z}
(define wnc-dh #f)
(define (wnc-trace-pt! y)
  (let* ((m (list 'magnitude (list '- y 'c))))
    (wnc-steps
      (lambda () (fact 'subset-mem-fwd wnc-T 'CC y))
      (lambda () (dk-apply! wnc-dh y))
      (lambda () (wnc-rr! m))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '<= 'r m) '(< 0 r)))))
      (lambda () (wnc-sub-nz! y 'c))
      (lambda () (wnc-pz-in! 'c y)))))
(define (wnc-trace-not-z! y)
  (wnc-steps
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'z))
        (lambda ()
          (di)
          (dk-have! (list '<= 'r '(magnitude (- z c)))
            (lambda () (subst (list '= 'z y)) (ass)))
          (wnc-rr! '(magnitude (- z c)))
          (dk-absurd! '(IN (magnitude (- z c)) RR) '(IN r RR) '(<= r (magnitude (- z c))) '(< (magnitude (- z c)) r)))))
    (lambda () (wnc-sub-nz! y 'z))
    (lambda () (wnc-pz-in! 'z y))))
(define (wnc-trace-in-pz! p)
  (dk-have! (list 'SUBSET wnc-T (wnc-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (wnc-trace-pt! y)
        (if (eq? p 'z) (wnc-trace-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))

(sp (make-wff (list 'FORALL 'pgam (list 'FORALL 'dgam (list 'FORALL 'a (list 'FORALL 'b
  (list 'IMPLIES '(IS-ROAD pgam dgam a b) (list 'IMPLIES '(= (pgam b) (pgam a))
    (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r)
      (list 'IMPLIES wnc-dist-h
        (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES '(< (magnitude (- z c)) r)
          '(= (WINDING pgam dgam a b z) (WINDING pgam dgam a b c)))))))))))))))))))
(dk-peel!)
(set! wnc-dh (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm 'wcy_))) "the distance hypothesis"))
(fact 'is-road-is-path 'pgam 'dgam 'a 'b)
(fact 'is-path-in-fun 'pgam 'a 'b)
(dk-cite! 'trace-subset-cc 'pgam 'a 'b)
(dk-split! (dk-fact! 'is-path-endpoints 'pgam 'a 'b))
(dk-split-all!)
(dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
(dk-cite! 'trace-is-set 'pgam 'a 'b)
(fact 'subset-refl wnc-T)
(wnc-pz-setup! 'c)
(wnc-pz-setup! 'z)
(wnc-kern-setup! 'c)
(wnc-kern-setup! 'z)
(wnc-trace-in-pz! 'c)
(wnc-trace-in-pz! 'z)
(fact 'cc-one-in)
(define wnc-wi-pair
  (dk-abstract! wnc-T 'CC (lambda (y) 1) (lambda (y) (ass))))
(define wnc-wi-g (car wnc-wi-pair))
(define wnc-wi-gv (cdr wnc-wi-pair))
(dk-cite! 'aif-cont-const wnc-T 1 wnc-wi-g)
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ wnc-T) '(<= r (magnitude (- aix_ c)))))
  (lambda () (let ((y (dk-di-var!))) (dk-apply! wnc-dh y) (dk-ass!))))
(define wnc-wi-ks (dk-cite! 'cauchy-kernel-integral-series wnc-T 'c 'r wnc-wi-g 'pgam 'dgam 'a 'b 'z))
(define wnc-wi-tt (cadr wnc-wi-ks))
(define wnc-wi-lz (caddr wnc-wi-ks))
;;; G(y) = 1 on the trace, as an equation at a point y of the trace
(define (wnc-wi-g1! y) (dk-apply! wnc-wi-gv y))
;;; a_0 = int 1/(w - c)
(define wnc-wi-h0 (wnc-Hk wnc-wi-g 0))
(wnc-lam-typ! wnc-wi-h0 wnc-T (lambda (v) (wnc-tpt! v) (wnc-wi-g1! v) (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
                                   (wnc-lam-b-if!) (subst (list '== (list wnc-wi-g v) 1))))
(dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ wnc-T) (list '== (list wnc-wi-h0 'wnx_) (list (wnc-kern 'c) 'wnx_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (ax (list 'recip (list '- x 'c))))
      (wnc-tpt! x)
      (wnc-wi-g1! x)
      (dk-lam-b!)
      (subst (list '== (list wnc-wi-g x) 1))
      (subst (wnc-pow-succ! ax 0))
      (subst (dk-cite! 'power-zero ax))
      (dk-have! (list '= (list '* 1 (list '* ax 1)) ax) (lambda () (crs)))
      (subst (list '= (list '* 1 (list '* ax 1)) ax))
      (qrfl))))
(define wnc-wi-a0
  (dk-cite! 'line-int-domain-congruence (wnc-pz 'c) (wnc-kern 'c) 'pgam 'dgam 'a 'b wnc-T wnc-wi-h0))
(dk-cite! 'line-int-in-cc (wnc-pz 'c) (wnc-kern 'c) 'pgam 'dgam 'a 'b)
;;; a_(q+1) = 0
(define wnc-wi-az
  (list 'FORALL 'cifq_ (list 'IMPLIES '(IN cifq_ NN) (list '= (wnc-LI (wnc-Hk wnc-wi-g '(succ cifq_))) 0))))
(dk-have! wnc-wi-az
  (lambda ()
    (let* ((q (dk-di-var!)) (sq (list 'succ q)) (ssq (list 'succ sq))
           (d (wnc-pz 'c)) (R (wnc-R 'c)) (P (wnc-P 'c ssq)) (H (wnc-Hk wnc-wi-g sq)))
      (fact 'nn-succ-closed q)
      (fact 'nn-succ-closed sq)
      (wnc-lam-typ! P d (lambda (v) (wnc-pz-open! 'c v)))
      (wnc-lam-typ! R d (lambda (v) (wnc-pz-open! 'c v)))
      (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ d) '(NOT (= aix_ c))))
        (lambda () (let* ((v (dk-di-var!))) (wnc-steps (lambda () (wnc-pz-open! 'c v)) ass))))
      (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ d) (list '== (list R 'aix_) '(recip (- aix_ c)))))
        (lambda () (let* ((v (dk-di-var!))) (wnc-pz-open! 'c v) (dk-lam-b!) (qrfl))))
      (dk-cite! 'aif-cont-recip-shift d 'c R)
      (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ d) (list '== (list P 'aix_) (list 'power (list R 'aix_) ssq))))
        (lambda () (let* ((v (dk-di-var!))) (wnc-pz-open! 'c v) (dk-lam-b!) (qrfl))))
      (dk-cite! 'aif-cont-power-of d R ssq P)
      (wnc-lam-typ! H wnc-T (lambda (v) (wnc-tpt! v) (wnc-wi-g1! v)
                                 (wnc-lam-b-if!) (subst (list '== (list wnc-wi-g v) 1))))
      (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ wnc-T) (list '== (list H 'wnx_) (list P 'wnx_))))
        (lambda ()
          (let* ((x (dk-di-var!)) (px (list 'power (list 'recip (list '- x 'c)) ssq)))
            (wnc-tpt! x)
            (wnc-wi-g1! x)
            (dk-lam-b!)
            (subst (list '== (list wnc-wi-g x) 1))
            (wnc-cc! px)
            (dk-have! (list '= (list '* 1 px) px) (lambda () (crs)))
            (subst (list '= (list '* 1 px) px))
            (qrfl))))
      (let* ((e1 (dk-cite! 'line-int-domain-congruence d P 'pgam 'dgam 'a 'b wnc-T H))
            (e2 (dk-cite! 'cif-recip-power-closed-zero q 'c 'pgam 'dgam 'a 'b)))
        (wnc-subst-ass! e1)))))
;;; every a_k is a complex number
(define wnc-wi-at
  (list 'FORALL 'cifk_ (list 'IMPLIES '(IN cifk_ NN) (list 'IN (wnc-LI (wnc-Hk wnc-wi-g 'cifk_)) 'CC))))
(dk-have! wnc-wi-at
  (lambda ()
    (let* ((k (dk-di-var!)))
      (use-cases (dk-fact! 'nn-zero-or-succ k)
        (lambda ()
          (subst (list '= k 0))
          (wnc-subst-ass! wnc-wi-a0))
        (lambda ()
          (let* ((q (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the predecessor"))))
            (subst (list '= k (list 'succ q)))
            (fact 'cc-zero-in)
            (wnc-subst-ass! (dk-apply! (dk-ctx-form wnc-wi-az) q))))))))
(define (wnc-wi-typ-tt! lam)
  (wnc-lam-typ! lam 'NN (lambda (v) (dk-apply! (dk-ctx-form wnc-wi-at) v) (wnc-cc! '(- z c)))))
