;;; ======================================================================
;;; (2) WINDING-LOCALLY-CONSTANT
;;; ======================================================================
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |c - x| < r; return the latter
;;; (winding-number-laws.scm's wnd-ball-open!, copied)
(define (wnc-ball-open! c r x)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (iff (dk-cite! 'ball-membership 'CC-MS c r x))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (dk-have! cj (lambda () (dk-only! iff (list 'IN x (list 'BALL 'CC-MS c r))) (prop)))
    (dk-split-all! (list (dk-ctx-form cj)))
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
    (dk-cite! 'cc-ms-dist c x)
    (wnc-rr! mag)
    (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
      (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!)))
    (dk-cite! 'rr-le-ne-lt mag r)))

(define (wnc-kp! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? node)) (prop))))
(define wnc-z0 'wnz_)
(sp (make-wff '(FORALL pgam (FORALL dgam (FORALL a (FORALL b (IMPLIES (IS-ROAD pgam dgam a b)
  (IMPLIES (= (pgam b) (pgam a))
    (FORALL wnz_ (IMPLIES (IN wnz_ CC) (IMPLIES (NOT (IN wnz_ (TRACE pgam a b)))
      (FORSOME wcr_ (AND (POS-RR wcr_)
        (FORALL wcz_ (IMPLIES (IN wcz_ (BALL CC-MS wnz_ wcr_))
          (AND (NOT (IN wcz_ (TRACE pgam a b)))
               (= (WINDING pgam dgam a b wcz_) (WINDING pgam dgam a b wnz_))))))))))))))))))
(dk-peel!)
(fact 'is-road-is-path 'pgam 'dgam 'a 'b)
(fact 'is-path-in-fun 'pgam 'a 'b)
(dk-cite! 'trace-subset-cc 'pgam 'a 'b)
(dk-split! (dk-fact! 'is-path-endpoints 'pgam 'a 'b))
(dk-split-all!)
(wnc-pz-setup! wnc-z0)
(wnc-kern-setup! wnc-z0)
;; the trace lies in CC \ {z0}
(dk-have! (list 'SUBSET wnc-T (wnc-pz wnc-z0))
  (lambda ()
    (let ((w (subset-by-element!)))
      (fact 'subset-mem-fwd wnc-T 'CC w)
      (dk-have! (list 'NOT (list '= w wnc-z0))
        (lambda () (di) (dk-have! (list 'IN wnc-z0 wnc-T) (lambda () (subst (list '= wnc-z0 w)) (dk-ass!)))
                   (ai (dk-ctx-form (list 'NOT (list 'IN wnc-z0 wnc-T))))))
      (wnc-pz-in! wnc-z0 w))))
;; a bound M of |1/(w - z0)| on the trace; N = M + 1; the radius 1/N
(define wnc-mm (dk-skolem! (dk-cite! 'aif-trace-bounded (wnc-pz wnc-z0) (wnc-kern wnc-z0) 'pgam 'a 'b)))
(dk-split-all!)
(define wnc-mb (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm wnc-mm))) "the bound"))
(define wnc-nn (list '+ wnc-mm 1))
(wnc-rr! wnc-nn)
(dk-have! (list '< 0 wnc-nn) (lambda () (dk-ineq! (list '<= 0 wnc-mm))))
(define wnc-r0 (list 'recip wnc-nn))
(wnc-rr! wnc-r0)
(dk-cite! 'rr-recip-pos wnc-nn)
(dk-cite! 'rr-pos-rr-of-lt wnc-r0)
;; every point of the trace is at distance >= 1/N from z0
(dk-have! (list 'FORALL 'wcy_ (list 'IMPLIES (list 'IN 'wcy_ wnc-T) (list '<= wnc-r0 (list 'magnitude (list '- 'wcy_ wnc-z0)))))
  (lambda ()
    (let* ((w (dk-di-var!))
           (d (list '- w wnc-z0))
           (md (list 'magnitude d))
           (rd (list 'recip md)))
      (fact 'subset-mem-fwd wnc-T (wnc-pz wnc-z0) w)
      (wnc-pz-open! wnc-z0 w)
      (dk-apply! wnc-mb w)
      (wnc-cc! d)
      (wnc-cc! (list 'recip d))
      (dk-have! (list '= (list (wnc-kern wnc-z0) w) (list 'recip d)) (lambda () (dk-lam-b!) (rfl)))
      (dk-cite! 'aif-magnitude-recip d)
      (wnc-rr! md)
      (dk-cite! 'cc-magnitude-nonneg d)
      (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
        (dk-have! (list 'NOT (list '= 0 md))
          (lambda ()
            (di)
            (dk-have! (list '= md 0) (lambda () (subst (list '= md 0)) (rfl)))
            (wnc-kp! iff (list '= md 0) (list 'NOT (list '= d 0))))))
      (wnc-and! (list '<= 0 md) (list 'NOT (list '= 0 md)))
      (fact 'rr-zero-in)
      (dk-cite! 'rr-le-ne-lt 0 md)
      (wnc-rr! rd)
      (dk-cite! 'rr-recip-pos md)
      (dk-have! (list '<= rd wnc-nn)
        (lambda ()
          (wnc-cc! (list 'recip d))
          (dk-cite! 'cc-magnitude-closed (list 'recip d))
          (dk-have! (list '<= (list 'magnitude (list 'recip d)) wnc-mm)
            (lambda () (subst (list '= (list 'recip d) (list (wnc-kern wnc-z0) w))) (dk-ass!)))
          (subst (list '= rd (list 'magnitude (list 'recip d))))
          (dk-ineq! (list '<= (list 'magnitude (list 'recip d)) wnc-mm))))
      (dk-cite! 'rr-recip-antitone rd wnc-nn)
      (dk-cite! 'rr-recip-recip-pos md)
      (subst (list '= md (list 'recip rd)))
      (dk-ass!))))
(define wnc-lc-ball (list 'BALL 'CC-MS wnc-z0 wnc-r0))
(ew wnc-r0)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((z (dk-di-var!))
               (lt (wnc-ball-open! wnc-z0 wnc-r0 z))
               (mz (list 'magnitude (list '- z wnc-z0))))
          (wnc-rr! mz)
          (dk-cite! 'cc-magnitude-sub-sym wnc-z0 z)
          (dk-have! (list '< mz wnc-r0)
            (lambda () (subst (list '= mz (list 'magnitude (list '- wnc-z0 z)))) (dk-ass!)))
          (dk-conj-close!
            (lambda ()
              (if (eq? (car (dk-goal)) 'NOT)
                  (begin
                    (di)
                    (let ((dh (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm 'wcy_))) "the distance bound")))
                      (dk-apply! dh z)
                      (dk-absurd! (list 'IN mz 'RR) (list 'IN wnc-r0 'RR) (list '<= wnc-r0 mz) (list '< mz wnc-r0))))
                  (let ((dh (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm 'wcy_))) "the distance bound")))
                    (dk-have! (list '< 0 wnc-r0) (lambda () (dk-ass!)))
                    (dk-cite! 'winding-disc-constant 'pgam 'dgam 'a 'b wnc-z0 wnc-r0 z)
                    (dk-ass!)))))))))
(qed 'winding-locally-constant)

