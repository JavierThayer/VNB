(sp (make-wff (list 'FORALL 'pgam (list 'FORALL 'dgam (list 'FORALL 'a (list 'FORALL 'b
  (wnc-imps wnc-road-closed
    (list 'FORALL 'c (wnc-imps '((IN c CC))
      (list 'FORALL 'r (wnc-imps '((IN r RR) (< 0 r) (SUBSET (TRACE pgam a b) (BALL CC-MS c r)))
        (list 'FORALL 'wca_ (wnc-imps (list '(IS-CONNECTED CC-MS wca_) wnc-off-h)
          '(FORALL wcu_ (IMPLIES (IN wcu_ wca_) (IMPLIES (NOT (IN wcu_ (BALL CC-MS c r)))
             (FORALL wcp_ (IMPLIES (IN wcp_ wca_) (= (WINDING pgam dgam a b wcp_) 0)))))))))))))))))))
(dk-peel!)
(dk-project! '(SUBSET wca_ (PTS CC-MS)) 'IS-CONNECTED '(IS-CONNECTED CC-MS wca_))
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-have! '(SUBSET wca_ CC) (lambda () (subst '(= CC (PTS CC-MS))) (dk-ass!)))
(fact 'subset-mem-fwd 'wca_ 'CC 'wcu_)
(dk-cite! 'winding-zero-outside-disc 'pgam 'dgam 'a 'b 'c 'r 'wcu_)
(dk-apply! (dk-cite! 'winding-constant-on-connected 'pgam 'dgam 'a 'b 'wca_) 'wcp_ 'wcu_)
