(define wnc-road-closed '((IS-ROAD pgam dgam a b) (= (pgam b) (pgam a))))
(define (wnc-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (wnc-imps (cdr hs) body))))
(define wnc-off-h '(FORALL wcx_ (IMPLIES (IN wcx_ wca_) (NOT (IN wcx_ (TRACE pgam a b))))))
(define wnc-wf '(VNB-LAMBDA wcv_ wca_ (WINDING pgam dgam a b wcv_)))
(sp (make-wff (list 'FORALL 'pgam (list 'FORALL 'dgam (list 'FORALL 'a (list 'FORALL 'b
  (wnc-imps wnc-road-closed
    (list 'FORALL 'wca_ (wnc-imps (list '(IS-CONNECTED CC-MS wca_) wnc-off-h)
      '(FORALL wcp_ (IMPLIES (IN wcp_ wca_) (FORALL wcq_ (IMPLIES (IN wcq_ wca_)
         (= (WINDING pgam dgam a b wcp_) (WINDING pgam dgam a b wcq_)))))))))))))))
(dk-peel!)
(define wnc-offu (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (eq? (cadr fm) 'wcx_))) "off the trace"))
(dk-project! '(SUBSET wca_ (PTS CC-MS)) 'IS-CONNECTED '(IS-CONNECTED CC-MS wca_))
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-have! '(SUBSET wca_ CC) (lambda () (subst '(= CC (PTS CC-MS))) (dk-ass!)))
(define (wnc-at-a! x)
  ;; x in A: x in CC, x off the trace
  (fact 'subset-mem-fwd 'wca_ 'CC x)
  (dk-apply! wnc-offu x))
(dk-have! (list 'FORALL 'mcx_ (list 'IMPLIES '(IN mcx_ wca_)
            (list 'FORSOME 'mcr_ (list 'AND '(POS-RR mcr_)
              (list 'FORALL 'mcy_ (list 'IMPLIES '(IN mcy_ wca_)
                (list 'IMPLIES '(IN mcy_ (BALL CC-MS mcx_ mcr_)) (list '= (list wnc-wf 'mcy_) (list wnc-wf 'mcx_)))))))))
  (lambda ()
    (let* ((x (dk-di-var!)))
      (wnc-at-a! x)
      (let* ((ex (dk-cite! 'winding-locally-constant 'pgam 'dgam 'a 'b x))
             (r (dk-skolem! ex 'top))
             (bu (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm (list 'BALL 'CC-MS x r))))
                          "the ball of constancy")))
        (ew r)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((y (dk-di-var!)))
                  (di)
                  (dk-split-all! (list (dk-apply! bu y)))
                  (dk-lam-b!)
                  (dk-ass!)))))))))
(define wnc-cl (dk-cite! 'connected-locally-constant 'CC-MS 'wca_ wnc-wf))
(dk-apply! wnc-cl 'wcp_ 'wcq_)
(for-each (lambda (x) (wnc-at-a! x) (dk-cite! 'winding-in-cc 'pgam 'dgam 'a 'b x)) '(wcp_ wcq_))
(dk-have! (list '= (list wnc-wf 'wcp_) '(WINDING pgam dgam a b wcp_)) (lambda () (dk-lam-b!) (rfl)))
(dk-have! (list '= (list wnc-wf 'wcq_) '(WINDING pgam dgam a b wcq_)) (lambda () (dk-lam-b!) (rfl)))
(subst (list '= '(WINDING pgam dgam a b wcp_) (list wnc-wf 'wcp_)))
(subst (list '= '(WINDING pgam dgam a b wcq_) (list wnc-wf 'wcq_)))
(dk-ass!)
(qed 'winding-constant-on-connected)

