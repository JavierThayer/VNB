;;; Library: measure.

;;; ====================================================================
;;; tb3-esum.scm -- TH3-B3, 2026-11-09.  An unordered sum in [0, +inf] over a PRODUCT index
;;; set is the iterated sum (th-main Prop. 3.38, the isometry step
;;; ||T||_HS^2 = sum_i sum_j |<T e_i | f_j>|^2 = sum_(i,j) |alpha_ij|^2).
;;;
;;; THE THEOREMS (every one `modulo 0'):
;;;   finsum-cm-image-inj   phi injective on a finite t, k = f o phi on t:
;;;                         FINSUM_t k = FINSUM_{phi(t)} f     (any commutative monoid)
;;;   esum-cartesian-le     h on ii x jj, a(i) = ESUM_j h(i, j):  ESUM h <= ESUM a
;;;   finsum-cm-cartesian   s, u finite: FINSUM over s x u = FINSUM_u FINSUM_s (comm. monoid)
;;;   esum-cartesian-ge     the same:                              ESUM a <= ESUM h
;;;   esum-cartesian        ESUM_{ii x jj} h = ESUM_i ESUM_j h(i, j)
;;; The double family is given curried, g in FUN(ii, FUN(jj, RR-POS-STAR)) with
;;; g(i)(j) = h([i, j]), and the iterated sum a by its pointwise equation, as in TH3-B's
;;; esum-swap (th3b-esum.scm), so that no statement holds a lambda.
;;;
;;; THE ROUTE.  (<=) For a finite t inside ii x jj, sum over t by the fibres of the first
;;; projection (rps-finsum-fiber-le): the fibre over i is carried injectively onto a finite
;;; subset of jj by the second projection (finsum-cm-image-inj), so its sum is a partial sum of
;;; g(i), at most a(i); and a finite sum of the a(i) is at most ESUM a.  (>=) TH3-B's
;;; esum-finsum-le gives FINSUM_s a <= ESUM_j FINSUM_s g(.)(j); for a finite u inside jj the
;;; double finite sum FINSUM_u FINSUM_s is the sum of h over s x u (finsum-cm-fiber-ptwise by
;;; the second projection, each fibre the injective image of s under i |-> [i, j]), at most
;;; ESUM h.
;;;
;;; LOAD WINDOW: after TH3-B's th3b-esum (esum-finsum-le) and the tree's finsum-cm-fiber-ptwise,
;;; rps-finsum-fiber-le, card-image-finite, card-cartesian-nn, cartesian-membership-nth,
;;; class-extensionality.  Library: analysis (the statements use only ESUM, FINSUM, IMAGE,
;;; CARTESIAN); it cites esum-finsum-le, which TH3-B placed in measure, so it goes beside
;;; th3b-esum unless that file is moved to analysis.  Prefix tb3-.
;;; ====================================================================

(define (tb3-open?)
  (let ((leaf (or *dk-lane-leaf* (proof-state-focus *ps*))))
    (not (sequent-node-grounded? leaf))))
(define (tb3-have! f th) (dk-have! f (dk-lane th)))
(define (tb3-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (tb3-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb3-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (tb3-close!)
  (cond ((not (tb3-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tb3-ctx f)
  (or (dk-ctx-form f) (error "tb3-ctx: not in context" (expression->string f))))
(define (tb3-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tb3-try tag thunk)
  (with-exception-handler
    (lambda (e)
      (let ((asms (dk-asms)))
        (error (string-append "TB3-TRY " tag ": "
                              (if (condition? e) (condition/report-string e) "non-condition"))
               (list 'GOAL (expression->string (dk-goal)))
               (list 'N (length asms) 'W (map expression->string (filter (lambda (a) (string-search-forward "tbz_" (expression->string a) 0)) asms))))))
    thunk))
(define (tb3-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb3: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))

;;; ====================================================================
;;; finsum-cm-image-inj
;;; ====================================================================
(define tb3-ii-h1 '(FORALL x_ (IMPLIES (IN x_ t) (IN (phi x_) SET))))
(define tb3-ii-h2 '(FORALL x_ (IMPLIES (IN x_ t) (FORALL y_ (IMPLIES (IN y_ t) (IMPLIES (= (phi x_) (phi y_)) (= x_ y_)))))))
(define tb3-ii-h3 '(FORALL z_ (IMPLIES (IN z_ (IMAGE phi t)) (IN (f z_) (CARR m)))))
(define tb3-ii-h4 '(FORALL x_ (IMPLIES (IN x_ t) (= (k x_) (f (phi x_))))))

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-COMM-MONOID m)
  (list 'FORALL 't (list 'IMPLIES '(IN t SET) (list 'IMPLIES '(IN (CARD t) NN)
    (list 'FORALL 'phi (list 'FORALL 'f (list 'FORALL 'k
      (list 'IMPLIES tb3-ii-h1 (list 'IMPLIES tb3-ii-h2 (list 'IMPLIES tb3-ii-h3 (list 'IMPLIES tb3-ii-h4
        '(= (FINSUM m k t) (FINSUM m f (IMAGE phi t)))))))))))))))))
(dk-peel!)
(let* ((img '(IMAGE phi t))
       (h1 (tb3-ctx tb3-ii-h1)) (h2 (tb3-ctx tb3-ii-h2)) (h3 (tb3-ctx tb3-ii-h3)) (h4 (tb3-ctx tb3-ii-h4))
       (pmap '(FORALL z_ (IMPLIES (IN z_ t) (IN (phi z_) (IMAGE phi t)))))
       (ktyp '(FORALL z_ (IMPLIES (IN z_ t) (IN (k z_) (CARR m)))))
       (fib '(FORALL z_ (IMPLIES (IN z_ (IMAGE phi t)) (== (f z_) (FINSUM m k (SEP fw_ t (= (phi fw_) z_))))))))
  (fact 'image-set 'phi 't)
  (fact 'card-image-finite 'phi 't)
  ;; phi maps t into its image
  (tb3-have! pmap
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! h1 z)
        (mac 'image-membership-iff)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (begin (ew z) (dk-conj-close! (lambda () (tb3-close!))))
                (tb3-close!)))))))
  ;; k is typed on t
  (tb3-have! ktyp
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! (tb3-ctx pmap) z)
        (dk-apply! h3 (list 'phi z))
        (subst (dk-apply! h4 z))
        (tb3-close!))))
  ;; each fibre of phi over a point of the image is a singleton
  (tb3-have! fib
    (lambda ()
      (let* ((y (dk-di-var!))
             (fy (dk-apply! h3 y))
             (ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN y img)))))))
        (let* ((x0 (dk-skolem! ex))
               (sep (list 'SEP 'fw_ 't (list '= '(phi fw_) y)))
               (pr (list 'PAIR x0 x0))
               (ph0 (list '= (list 'phi x0) y)))
          (fact 'membership-implies-sethood x0 't)
          (tb3-have! (list '= sep pr)
            (lambda ()
              (let ((ce (dk-cite! 'class-extensionality sep pr)))
                (tb3-have! (cadr ce)
                  (lambda ()
                    (let ((x (dk-di-var! (lambda (g) (cadr (cadr g))))))
                      (dk-iff! (lambda (g) (or (equal? g (list 'IN x pr))
                                               (and (dk-head-is? g 'IMPLIES) (equal? (caddr g) (list 'IN x pr)))))
                        (lambda ()
                          (let ((mx (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-landed-1 (lambda () (di))) (dk-pick (lambda (q) (equal? q (list 'IN x sep))) "x in sep"))))
                            (sep-me mx)
                            (dk-split-all!)
                            (let ((e1 (list '= (list 'phi x) (list 'phi x0))))
                              (tb3-have! e1 (lambda () (subst ph0) (tb3-close!)))
                              (dk-apply! h2 x x0)
                              (subst (list '= x x0))
                              (fact 'pair-self-member x0)
                              (tb3-close!))))
                        (lambda ()
                          (let ((mx (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-landed-1 (lambda () (di))) (dk-pick (lambda (q) (equal? q (list 'IN x pr))) "x in pair"))))
                            (tb3-and! (list 'IN x0 'SET) (list 'IN x0 'SET))
                            (let* ((pm (dk-cite! 'pairing-membership x0 x0))
                                   (iff (dk-apply! pm x)))
                              (tb3-have! (list '= x x0) (lambda () (keep iff mx) (prop)))
                              (subst (list '= x x0))
                              (in-sep! (lambda () (tb3-close!)) (lambda () (tb3-close!))))))))))
                (detach! ce)
                (tb3-close!))))
          (subst (list '= sep pr))
          (dk-apply! (tb3-ctx ktyp) x0)
          (subst (tb3-cite! 'finsum-cm-singleton-ptwise 'm x0 'k))
          (subst (dk-apply! h4 x0))
          (subst ph0)
          (tb3-close!)))))
  (tb3-cite! 'finsum-cm-fiber-ptwise 'm 't img 'phi 'k 'f)
  (tb3-close!))
(tb3-done! 'finsum-cm-image-inj)

;;; ====================================================================
;;; shared helpers for the product sums
;;; ====================================================================
(define tb3-m 'RR-POS-STAR-ADD-MONOID)
(define (tb3-fs f s) (list 'FINSUM tb3-m f s))
;;; f in FUN(dd, cod) in context: land (IN dd SET), (= (DOM f) dd), f in FUN(DOM f, cod)
(define (tb3-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tb3-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (tb3-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (if (and (eq? cod 'RR-POS-STAR) (not (dk-asm? (list 'IN (list 'ESUM f) 'RR-POS-STAR))))
      (fact 'esum-in f)))
(define (tb3-bound f b)
  (let ((v (if (memq 'tbs_ (free-vars (list 'AND f b))) 'tbt_ 'tbs_)))
    (list 'FORALL v (list 'IMPLIES (list 'AND (list 'IN v 'SET) (list 'AND (list 'IN (list 'CARD v) 'NN) (list 'SUBSET v (list 'DOM f))))
                             (list '<= (tb3-fs f v) b)))))
(define (tb3-peel-set! f dd)
  (dk-peel!)
  (dk-split-all!)
  (let ((sv (cadddr (cadr (dk-goal)))))
    (if (and (not (dk-asm? (list 'SUBSET sv dd))) (dk-asm? (list 'SUBSET sv (list 'DOM f))))
        (dk-rewrite-h! (list 'SUBSET sv (list 'DOM f)) (list 'DOM f) dd))
    sv))
(define (tb3-sub! s d)          ; (SUBSET s d) from (tb3-subs s d)
  (if (not (dk-asm? (list 'SUBSET s d)))
      (tb3-have! (list 'SUBSET s d) (lambda () (mac 'subset-def) (tb3-close!)))))
(define (tb3-partial! f dd sv)
  (if (and (not (dk-asm? (list 'SUBSET sv dd))) (dk-asm? (tb3-subs sv dd))) (tb3-sub! sv dd))
  (if (not (dk-asm? (list 'SUBSET sv (list 'DOM f))))
      (tb3-have! (list 'SUBSET sv (list 'DOM f)) (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (tb3-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN) (list 'SUBSET sv (list 'DOM f)))
  (if (not (dk-asm? (list 'IN (tb3-fs f sv) 'RR-POS-STAR))) (tb3-cite! 'esum-partial-sum-type f sv))
  (if (not (dk-asm? (list '<= (tb3-fs f sv) (list 'ESUM f)))) (tb3-cite! 'esum-upper f sv)))
(define (tb3-trans! x y z)
  (if (not (dk-asm? (list '<= x z)))
      (begin
        (tb3-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
        (tb3-and! (list '<= x y) (list '<= y z))
        (fact 'rr-pos-star-le-trans x y z)))
  (list '<= x z))
;;; forall z_ in s. (phi z_) in cod
(define (tb3-maps phi s cod) (list 'FORALL 'tbz_ (list 'IMPLIES (list 'IN 'tbz_ s) (list 'IN (list phi 'tbz_) cod))))
(define (tb3-subs s d) (list 'FORALL 'tbz_ (list 'IMPLIES (list 'IN 'tbz_ s) (list 'IN 'tbz_ d))))
;;; prove (tb3-maps phi s cod) from s subset dd (as tb3-subs or SUBSET) and phi in FUN(dd, cod)
(define (tb3-maps-sub! phi s dd cod)
  (let ((cl (tb3-maps phi s cod)))
    (if (not (dk-asm? cl))
        (tb3-have! cl
          (lambda ()
            (let ((z (dk-di-var!)))
              (if (dk-asm? (list 'SUBSET s dd)) (fact 'subset-mem-fwd s dd z) (dk-apply! (tb3-ctx (tb3-subs s dd)) z))
              (tb3-ap! phi dd cod z)
              (tb3-close!)))))
    cl))
;;; with (IN s SET), (IN (CARD s) NN) and (tb3-maps phi s cod) in context: the image is a finite
;;; set, phi maps s into it, and it lies inside cod.  Returns the image.
(define (tb3-img! phi s cod)
  (let* ((img (list 'IMAGE phi s))
         (maps (tb3-ctx (tb3-maps phi s cod)))
         (into (tb3-maps phi s img))
         (sub (tb3-subs img cod)))
    (if (not (dk-asm? (list 'IN img 'SET))) (fact 'image-set phi s))
    (if (not (dk-asm? (list 'IN (list 'CARD img) 'NN))) (fact 'card-image-finite phi s))
    (if (not (dk-asm? into))
        (tb3-have! into
          (lambda ()
            (let ((z (dk-di-var!)))
              (dk-apply! maps z)
              (fact 'membership-implies-sethood (list phi z) cod)
              (mac 'image-membership-iff)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORSOME)
                      (begin (ew z) (dk-conj-close! tb3-close!))
                      (tb3-close!))))))))
    (if (not (dk-asm? sub))
        (tb3-have! sub
          (lambda ()
            (let* ((z (dk-di-var!))
                   (ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN z img))))))
                   (x (dk-skolem! ex)))
              (subst (list '= z (list phi x)))
              (dk-apply! maps x)
              (tb3-close!)))))
    img))
;;; (IN (SEP ..) SET)
(define (tb3-sep-set! sp)
  (if (not (dk-asm? (list 'IN sp 'SET)))
      (tb3-have! (list 'IN sp 'SET)
        (lambda () (for-each (lambda (l) (dk-focus! l) (tb3-close!)) (dk-opened (lambda () (sep-set))))))))
;;; a SEP over a finite set s: it is a finite set inside s
(define (tb3-sep-fin! sp s)
  (tb3-sep-set! sp)
  (let ((sub (tb3-subs sp s)))
    (if (not (dk-asm? sub))
        (tb3-have! sub (lambda () (let ((z (dk-di-var!))) (sep-me (list 'IN z sp)) (dk-split-all!) (tb3-close!)))))
    (if (not (dk-asm? (list 'IN (list 'CARD sp) 'NN)))
        (begin
          (tb3-and! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN))
          (tb3-and! (list 'IN sp 'SET) sub)
          (tb3-cite! 'card-subset-nn s sp)))))
;;; x = [p1 x, p2 x] for x in cc (HPE in context)
(define tb3-hpe '(FORALL w_ (IMPLIES (IN w_ (CARTESIAN ii jj)) (= w_ (LIST (p1 w_) (p2 w_))))))
(define (tb3-rps-carr!)
  (if (not (dk-asm? (list '== (list 'CARR tb3-m) 'RR-POS-STAR))) (dk-cite! 'rr-pos-star-add-monoid@carr))
  (if (not (dk-asm? (list 'IS-COMM-MONOID tb3-m))) (fact 'rr-pos-star-is-comm-monoid)))

;;; ====================================================================
;;; esum-cartesian-le: ESUM over ii x jj <= the iterated ESUM
;;; ====================================================================
(define tb3-cc '(CARTESIAN ii jj))
(define tb3-ht '(FORALL i_ (IMPLIES (IN i_ ii) (FORALL j_ (IMPLIES (IN j_ jj) (= ((g i_) j_) (h (LIST i_ j_))))))))
(define tb3-hae '(FORALL i_ (IMPLIES (IN i_ ii) (= (a i_) (ESUM (g i_))))))
(define (tb3-le-hyps concl)
  (list 'FORALL 'ii (list 'FORALL 'jj (list 'FORALL 'h (list 'FORALL 'g (list 'FORALL 'a (list 'FORALL 'p1 (list 'FORALL 'p2
    (list 'IMPLIES '(IN h (FUN (CARTESIAN ii jj) RR-POS-STAR))
    (list 'IMPLIES '(IN g (FUN ii (FUN jj RR-POS-STAR)))
    (list 'IMPLIES tb3-ht
    (list 'IMPLIES '(IN a (FUN ii RR-POS-STAR))
    (list 'IMPLIES tb3-hae
    (list 'IMPLIES '(IN p1 (FUN (CARTESIAN ii jj) ii))
    (list 'IMPLIES '(IN p2 (FUN (CARTESIAN ii jj) jj))
    (list 'IMPLIES tb3-hpe concl))))))))))))))))

(sp (make-wff (tb3-le-hyps '(<= (ESUM h) (ESUM a)))))
(dk-peel!)
(tb3-rps-carr!)
(tb3-dom! 'h tb3-cc 'RR-POS-STAR)
(tb3-dom! 'a 'ii 'RR-POS-STAR)
(let ((ea '(ESUM a)) (hpe (tb3-ctx tb3-hpe)) (ht (tb3-ctx tb3-ht)) (hae (tb3-ctx tb3-hae)))
  (tb3-have! (tb3-bound 'h ea)
    (lambda ()
      (let* ((sv (tb3-peel-set! 'h tb3-cc)))
        (tb3-partial! 'h tb3-cc sv)
        (tb3-maps-sub! 'h sv tb3-cc 'RR-POS-STAR)
        (tb3-maps-sub! 'p1 sv tb3-cc 'ii)
        (let* ((oft (tb3-img! 'p1 sv 'ii))
               (fib (list 'FORALL 'tbi_ (list 'IMPLIES (list 'IN 'tbi_ oft)
                      (list '<= (tb3-fs 'h (list 'SEP 'ofw_ sv '(= (p1 ofw_) tbi_))) '(a tbi_))))))
          (tb3-maps-sub! 'a oft 'ii 'RR-POS-STAR)
          (tb3-have! fib
            (lambda ()
              (let* ((i (dk-di-var!))
                     (fi (list 'SEP 'ofw_ sv (list '= '(p1 ofw_) i)))
                     (gi (list 'g i))
                     (in-fi! (lambda (x)        ; x in Fi: land x in sv, x in cc, p1 x = i, p2 x in jj
                               (sep-me (list 'IN x fi))
                               (dk-split-all!)
                               (fact 'subset-mem-fwd sv tb3-cc x)
                               (tb3-ap! 'p2 tb3-cc 'jj x)
                               (tb3-ap! 'p1 tb3-cc 'ii x))))
                (dk-apply! (tb3-ctx (tb3-subs oft 'ii)) i)
                (fact 'membership-implies-sethood i 'ii)
                (tb3-sep-fin! fi sv)
                (tb3-ap! 'g 'ii '(FUN jj RR-POS-STAR) i)
                (tb3-dom! gi 'jj 'RR-POS-STAR)
                ;; L1's four hypotheses with t = Fi, phi = p2, f = g(i), k = h
                (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fi) (list 'IN '(p2 x_) 'SET)))
                  (lambda () (let ((x (dk-di-var!))) (in-fi! x) (fact 'membership-implies-sethood (list 'p2 x) 'jj) (tb3-close!))))
                (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fi) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ fi)
                            '(IMPLIES (= (p2 x_) (p2 y_)) (= x_ y_))))))
                  (lambda ()
                    (let* ((pl (dk-peel!)) (x (cadr (dk-goal))) (y (caddr (dk-goal))))
                      (in-fi! x) (in-fi! y)
                      (fact 'membership-implies-sethood (list 'p2 y) 'jj)
                      (let ((ex (dk-apply! hpe x)) (ey (dk-apply! hpe y)))
                        (subst ex)
                        (subst ey)
                        (subst (list '= (list 'p1 x) i))
                        (subst (list '= (list 'p1 y) i))
                        (subst (list '= (list 'p2 x) (list 'p2 y)))
                        (tb3-close!)))))
                (tb3-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ fi) (list 'IN '(p2 z_) 'jj)))
                  (lambda () (let ((x (dk-di-var!))) (in-fi! x) (tb3-close!))))
                (let ((img2 (tb3-img! 'p2 fi 'jj)))
                  (tb3-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img2) (list 'IN (list gi 'z_) (list 'CARR tb3-m))))
                    (lambda ()
                      (subst (list '= (list 'CARR tb3-m) 'RR-POS-STAR))
                      (let ((z (dk-di-var!)))
                        (dk-apply! (tb3-ctx (tb3-subs img2 'jj)) z)
                        (tb3-ap! gi 'jj 'RR-POS-STAR z)
                        (tb3-close!))))
                  (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fi) (list '= '(h x_) (list gi '(p2 x_)))))
                    (lambda ()
                      (let ((x (dk-di-var!)))
                        (in-fi! x)
                        (fact 'membership-implies-sethood (list 'p2 x) 'jj)
                        (let* ((tr (dk-apply! ht i (list 'p2 x)))
                               (lst (list 'LIST i (list 'p2 x)))
                               (ex (dk-apply! hpe x))
                               (e1 (list '= lst x)))
                          (subst tr)
                          (tb3-have! e1
                            (lambda ()
                              (subst (list '= i (list 'p1 x)))
                              (subst (list '= (caddr ex) x))
                              (tb3-close!)))
                          (subst e1)
                          (tb3-close!)))))
                  (let ((l1 (tb3-cite! 'finsum-cm-image-inj tb3-m fi 'p2 gi 'h)))
                    (tb3-partial! gi 'jj img2)
                    (subst l1)
                    (subst (dk-apply! hae i))
                    (tb3-close!))))))
          (tb3-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN))
          (tb3-cite! 'rps-finsum-fiber-le sv oft 'p1 'h 'a)
          (tb3-partial! 'a 'ii oft)
          (tb3-trans! (tb3-fs 'h sv) (tb3-fs 'a oft) ea)
          (tb3-close!)))))
  (tb3-and! (list 'IN ea 'RR-POS-STAR) (tb3-bound 'h ea))
  (tb3-cite! 'esum-least 'h ea)
  (tb3-close!))
(tb3-done! 'esum-cartesian-le)

;;; ====================================================================
;;; finsum-cm-cartesian: a finite sum over s x u is the iterated finite sum (any commutative
;;; monoid); the pair projections p1, p2 are given with w = [p1 w, p2 w] on s x u.
;;; ====================================================================
;;; w in CARTESIAN(s, u) with (FORALL w_ in CARTESIAN(s, u). w_ = [p1 w_, p2 w_]) = PE in
;;; context: land w = [p1 w, p2 w], p1 w in s, p2 w in u.  Returns the pair equation.
(define (tb3-proj! pe w s u) (tb3-try "proj" (lambda () (tb3-proj0! pe w s u))))
(define (tb3-proj0! pe w s u)
  (let* ((ex (dk-apply! pe w))
         (lst (caddr ex))
         (nlst (list 'LIST (list 'NTH 1 w) (list 'NTH 2 w))))
    (if (not (dk-asm? (list 'IN (list 'p1 w) s)))
        (begin
          (dk-split-all! (list (tb3-cite! 'cartesian-nth w s u)))
          (tb3-cite! 'cartesian-pair-eq w s u)
          (tb3-have! (list '= lst nlst)
            (lambda () (subst (list '= lst w)) (tb3-close!)))
          (let ((npi (tb3-cite! 'node-pair-injective (list 'p1 w) (list 'p2 w) (list 'NTH 1 w) (list 'NTH 2 w))))
            (if (not (dk-asm? (list '= (list 'p2 w) (list 'NTH 2 w))))
                (dk-split-all! (list npi)))
            (if (not (dk-asm? (list '= (list 'p2 w) (list 'NTH 2 w))))
                (error "TB3 npi" (expression->string npi) (expression->string (dk-goal))
                       (map expression->string (filter (lambda (a) (string-search-forward (symbol->string w) (expression->string a) 0)) (dk-asms))))))
          (if (tb3-open?) (tb3-have! (list 'IN (list 'p1 w) s) (lambda () (subst (list '= (list 'p1 w) (list 'NTH 1 w))) (tb3-close!))))
          (if (and (tb3-open?) (not (dk-asm? (list 'IN (list 'p2 w) u))))
          (tb3-have! (list 'IN (list 'p2 w) u) (lambda () (subst (list '= (list 'p2 w) (list 'NTH 2 w))) (tb3-close!))))))
    ex))

(define tb3-ff-pe '(FORALL w_ (IMPLIES (IN w_ (CARTESIAN s u)) (= w_ (LIST (p1 w_) (p2 w_))))))
(define tb3-ff-hz '(FORALL z_ (IMPLIES (IN z_ (CARTESIAN s u)) (IN (h z_) (CARR m)))))
(define tb3-ff-gtt '(FORALL j_ (IMPLIES (IN j_ u) (FORALL i_ (IMPLIES (IN i_ s) (IN ((gt j_) i_) (CARR m)))))))
(define tb3-ff-gte '(FORALL j_ (IMPLIES (IN j_ u) (FORALL i_ (IMPLIES (IN i_ s) (= ((gt j_) i_) (h (LIST i_ j_))))))))
(define tb3-ff-gts '(FORALL j_ (IMPLIES (IN j_ u) (IN (gt j_) SET))))
(define tb3-ff-ke '(FORALL j_ (IMPLIES (IN j_ u) (== (kk j_) (FINSUM m (gt j_) s)))))

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-COMM-MONOID m)
  (list 'FORALL 's (list 'IMPLIES '(IN s SET) (list 'IMPLIES '(IN (CARD s) NN)
  (list 'FORALL 'u (list 'IMPLIES '(IN u SET) (list 'IMPLIES '(IN (CARD u) NN)
  (list 'FORALL 'h (list 'FORALL 'gt (list 'FORALL 'kk (list 'FORALL 'p1 (list 'FORALL 'p2
    (list 'IMPLIES tb3-ff-hz (list 'IMPLIES tb3-ff-gtt (list 'IMPLIES tb3-ff-gte (list 'IMPLIES tb3-ff-gts (list 'IMPLIES tb3-ff-ke
    (list 'IMPLIES tb3-ff-pe
      '(= (FINSUM m h (CARTESIAN s u)) (FINSUM m kk u)))))))))))))))))))))))
(dk-peel!)
(let* ((ss '(CARTESIAN s u))
       (pe (tb3-ctx tb3-ff-pe)) (gtt (tb3-ctx tb3-ff-gtt)) (gte (tb3-ctx tb3-ff-gte)) (ke (tb3-ctx tb3-ff-ke))
       (fib (list 'FORALL 'tbj_ (list 'IMPLIES '(IN tbj_ u)
              (list '== '(kk tbj_) (list 'FINSUM 'm 'h (list 'SEP 'fw_ ss '(= (p2 fw_) tbj_))))))))
  (tb3-have! (list 'IN ss 'SET) (lambda () (dk-set-close! ss)))
  (tb3-cite! 'card-cartesian-nn 's 'u)
  (tb3-have! (tb3-maps 'p2 ss 'u) (lambda () (let ((w (dk-di-var!))) (tb3-proj! pe w 's 'u) (tb3-close!))))
  (tb3-have! fib
    (lambda ()
      (let* ((j (dk-di-var!))
             (fj (list 'SEP 'fw_ ss (list '= '(p2 fw_) j)))
             (gj (list 'gt j))
             (in-fj! (lambda (x)
                       (sep-me (list 'IN x fj))
                       (dk-split-all!)
                       (tb3-proj! pe x 's 'u))))
        (fact 'membership-implies-sethood j 'u)
        (dk-apply! (tb3-ctx tb3-ff-gts) j)
        (tb3-sep-fin! fj ss)
        ;; L1's hypotheses with t = Fj, phi = p1, f = gt(j), k = h
        (tb3-have! (tb3-maps 'p1 fj 's) (lambda () (let ((x (dk-di-var!))) (in-fj! x) (tb3-close!))))
        (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fj) '(IN (p1 x_) SET)))
          (lambda () (let ((x (dk-di-var!))) (in-fj! x) (fact 'membership-implies-sethood (list 'p1 x) 's) (tb3-close!))))
        (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fj) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ fj)
                    '(IMPLIES (= (p1 x_) (p1 y_)) (= x_ y_))))))
          (lambda ()
            (let* ((pl (dk-peel!)) (x (cadr (dk-goal))) (y (caddr (dk-goal))))
              (let ((ex (in-fj! x)) (ey (in-fj! y)))
                (fact 'membership-implies-sethood (list 'p1 y) 's)
                (subst ex)
                (subst ey)
                (subst (list '= (list 'p2 x) j))
                (subst (list '= (list 'p2 y) j))
                (subst (list '= (list 'p1 x) (list 'p1 y)))
                (tb3-close!)))))
        (let ((img (tb3-img! 'p1 fj 's)))
          (tb3-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img) (list 'IN (list gj 'z_) '(CARR m))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (dk-apply! (tb3-ctx (tb3-subs img 's)) z)
                (dk-apply! gtt j z)
                (tb3-close!))))
          (tb3-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ fj) (list '= '(h x_) (list gj '(p1 x_)))))
            (lambda ()
              (let* ((x (dk-di-var!)) (ex (in-fj! x)))
                (let* ((tr (dk-apply! gte j (list 'p1 x)))
                       (lst (list 'LIST (list 'p1 x) j))
                       (e1 (list '= lst x)))
                  (subst tr)
                  (tb3-have! e1
                    (lambda ()
                      (subst (list '= j (list 'p2 x)))
                      (subst (list '= (caddr ex) x))
                      (tb3-close!)))
                  (subst e1)
                  (dk-apply! (tb3-ctx tb3-ff-hz) x)
                  (tb3-close!)))))
          (let ((l1 (tb3-cite! 'finsum-cm-image-inj 'm fj 'p1 gj 'h))
                (se (list '= img 's)))
            ;; the image of the fibre under p1 is all of s
            (tb3-have! se
              (lambda ()
                (let ((ce (dk-cite! 'class-extensionality img 's)))
                  (tb3-have! (cadr ce)
                    (lambda ()
                      (let ((z (dk-di-var! (lambda (g) (cadr (cadr g))))))
                        (dk-iff! (lambda (g) (or (equal? g (list 'IN z 's))
                                                 (and (dk-head-is? g 'IMPLIES) (equal? (caddr g) (list 'IN z 's)))))
                          (lambda ()
                            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                            (dk-apply! (tb3-ctx (tb3-subs img 's)) z)
                            (tb3-close!))
                          (lambda ()
                            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                            (let* ((zj (list 'LIST z j)))
                              (fact 'membership-implies-sethood z 's)
                              (tb3-cite! 'pair-in-cartesian 's 'u z j)
                              (let ((ez (dk-apply! pe zj)))
                                (dk-split-all! (list (tb3-cite! 'node-pair-injective z j (list 'p1 zj) (list 'p2 zj))))
                                (mac 'image-membership-iff)
                                (dk-conj-close!
                                  (lambda ()
                                    (if (dk-head-is? (dk-goal) 'FORSOME)
                                        (begin
                                          (ew zj)
                                          (dk-conj-close!
                                            (lambda ()
                                              (cond ((dk-head-is? (dk-goal) 'IN)
                                                     (in-sep! (lambda () (tb3-close!))
                                                              (lambda () (subst (list '= (list 'p2 zj) j)) (tb3-close!))))
                                                    (#t (subst (list '= (list 'p1 zj) z)) (tb3-close!))))))
                                        (tb3-close!)))))))))))
                  (tb3-cite! 'class-extensionality img 's)
                  (tb3-close!))))
            (subst l1)
            (subst se)
            (dk-apply! ke j)
            (tb3-close!))))))
  (tb3-cite! 'finsum-cm-fiber-ptwise 'm ss 'u 'p2 'h 'kk)
  (tb3-close!))
(tb3-done! 'finsum-cm-cartesian)

;;; ====================================================================
;;; esum-cartesian-ge: the iterated ESUM <= the ESUM over ii x jj
;;; (gt is the transposed family: (gt j) i = (g i) j)
;;; ====================================================================
(define (tb3-det! r)
  (if (and (pair? r) (eq? (car r) 'IMPLIES))
      (if (dk-asm? (caddr r))
          (tb3-det! (caddr r))
          (tb3-det! (dk-landed-1 (lambda () (detach! r)))))
      r))
(define tb3-trt '(FORALL i_ (IMPLIES (IN i_ ii) (FORALL j_ (IMPLIES (IN j_ jj) (= ((gt j_) i_) ((g i_) j_)))))))
(define (tb3-ge-hyps concl)
  (list 'FORALL 'ii (list 'FORALL 'jj (list 'FORALL 'h (list 'FORALL 'g (list 'FORALL 'gt (list 'FORALL 'a
    (list 'FORALL 'p1 (list 'FORALL 'p2
    (list 'IMPLIES '(IN h (FUN (CARTESIAN ii jj) RR-POS-STAR))
    (list 'IMPLIES '(IN g (FUN ii (FUN jj RR-POS-STAR)))
    (list 'IMPLIES tb3-ht
    (list 'IMPLIES '(IN gt (FUN jj (FUN ii RR-POS-STAR)))
    (list 'IMPLIES tb3-trt
    (list 'IMPLIES '(IN a (FUN ii RR-POS-STAR))
    (list 'IMPLIES tb3-hae
    (list 'IMPLIES '(IN p1 (FUN (CARTESIAN ii jj) ii))
    (list 'IMPLIES '(IN p2 (FUN (CARTESIAN ii jj) jj))
    (list 'IMPLIES tb3-hpe concl)))))))))))))))))))
;;; z in CARTESIAN(s, u), s subset ii, u subset jj (SUBSET in context) => z in CARTESIAN(ii, jj)
(define (tb3-cart-sub! s u)
  (let ((cl (tb3-subs (list 'CARTESIAN s u) tb3-cc)))
    (if (not (dk-asm? cl))
        (tb3-have! cl
          (lambda ()
            (let* ((z (dk-di-var!)) (n1 (list 'NTH 1 z)) (n2 (list 'NTH 2 z)))
              (dk-split-all! (list (tb3-cite! 'cartesian-nth z s u)))
              (tb3-cite! 'cartesian-pair-eq z s u)
              (fact 'subset-mem-fwd s 'ii n1)
              (if (not (dk-asm? (list 'SUBSET u 'jj)))
                  (error "TB3 no subset" (map expression->string (filter (lambda (a) (dk-head-is? a 'SUBSET)) (dk-asms)))))
              (fact 'subset-mem-fwd u 'jj n2)
              (tb3-cite! 'pair-in-cartesian 'ii 'jj n1 n2)
              (subst (list '= z (list 'LIST n1 n2)))
              (tb3-close!)))))
    cl))

(sp (make-wff (tb3-ge-hyps '(<= (ESUM a) (ESUM h)))))
(dk-peel!)
(tb3-rps-carr!)
(tb3-dom! 'h tb3-cc 'RR-POS-STAR)
(tb3-dom! 'a 'ii 'RR-POS-STAR)
(let ((eh '(ESUM h)) (hpe (tb3-ctx tb3-hpe)) (ht (tb3-ctx tb3-ht)) (trt (tb3-ctx tb3-trt)))
  (tb3-have! (tb3-bound 'a eh)
    (lambda ()
      (let* ((sv (tb3-peel-set! 'a 'ii))
             (gtd (tb3-dom! 'gt 'jj '(FUN ii RR-POS-STAR)))
             (r (tb3-det! (dk-apply! (tb3-cite! 'esum-finsum-le 'ii 'jj 'g 'gt 'a) sv)))
             (ek (caddr r))
             (kk (cadr ek)))
        (tb3-partial! 'a 'ii sv)
        ;; K = j |-> FINSUM (gt j) sv is in FUN(jj, RPS)
        (tb3-have! (list 'IN kk '(FUN jj RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((j (dk-di-var!)))
                  (tb3-ap! 'gt 'jj '(FUN ii RR-POS-STAR) j)
                  (tb3-dom! (list 'gt j) 'ii 'RR-POS-STAR)
                  (tb3-partial! (list 'gt j) 'ii sv)
                  (tb3-close!))))))
        (tb3-dom! kk 'jj 'RR-POS-STAR)
        (tb3-have! (tb3-bound kk eh)
          (lambda ()
            (let* ((u (tb3-peel-set! kk 'jj))
                   (ss (list 'CARTESIAN sv u)))
              (tb3-have! (list 'IN ss 'SET) (lambda () (dk-set-close! ss)))
              (tb3-cite! 'card-cartesian-nn sv u)
              (let ((sub (tb3-cart-sub! sv u)))
                ;; the five hypotheses of finsum-cm-cartesian at m = M, s = sv, h, gt, kk = K
                (tb3-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ss) (list 'IN '(h z_) (list 'CARR tb3-m))))
                  (lambda ()
                    (subst (list '= (list 'CARR tb3-m) 'RR-POS-STAR))
                    (let ((z (dk-di-var!)))
                      (dk-apply! sub z)
                      (tb3-ap! 'h tb3-cc 'RR-POS-STAR z)
                      (tb3-close!))))
                (tb3-have! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ u) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ sv)
                             (list 'IN '((gt j_) i_) (list 'CARR tb3-m))))))
                  (lambda ()
                    (subst (list '= (list 'CARR tb3-m) 'RR-POS-STAR))
                    (dk-peel!)
                    (let* ((tm (cadr (dk-goal))) (j (cadr (car tm))) (i (cadr tm)))
                      (fact 'subset-mem-fwd u 'jj j)
                      (fact 'subset-mem-fwd sv 'ii i)
                      (tb3-ap! 'gt 'jj '(FUN ii RR-POS-STAR) j)
                      (tb3-ap! (list 'gt j) 'ii 'RR-POS-STAR i)
                      (tb3-close!))))
                (tb3-have! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ u) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ sv)
                             '(= ((gt j_) i_) (h (LIST i_ j_)))))))
                  (lambda ()
                    (dk-peel!)
                    (let* ((tm (cadr (dk-goal))) (j (cadr (car tm))) (i (cadr tm)))
                      (fact 'subset-mem-fwd u 'jj j)
                      (fact 'subset-mem-fwd sv 'ii i)
                      (subst (dk-apply! trt i j))
                      (dk-apply! ht i j)
                      (tb3-close!))))
                (tb3-have! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ u) '(IN (gt j_) SET)))
                  (lambda ()
                    (let ((j (dk-di-var!)))
                      (fact 'subset-mem-fwd u 'jj j)
                      (tb3-ap! 'gt 'jj '(FUN ii RR-POS-STAR) j)
                      (fact 'membership-implies-sethood (list 'gt j) '(FUN ii RR-POS-STAR))
                      (tb3-close!))))
                (tb3-have! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ u) (list '== (list kk 'j_) (list 'FINSUM tb3-m '(gt j_) sv))))
                  (lambda ()
                    (let ((j (dk-di-var!)))
                      (fact 'subset-mem-fwd u 'jj j)
                      (dk-lam-b!)
                      (tb3-close!))))
                (tb3-have! (list 'FORALL 'w_ (list 'IMPLIES (list 'IN 'w_ ss) '(= w_ (LIST (p1 w_) (p2 w_)))))
                  (lambda ()
                    (let ((w (dk-di-var!)))
                      (dk-apply! sub w)
                      (dk-apply! hpe w)
                      (tb3-close!))))
                (let ((fc (tb3-cite! 'finsum-cm-cartesian tb3-m sv u 'h 'gt kk 'p1 'p2)))
                  (if (not (dk-head-is? fc '=)) (error "TB3 fc" (expression->string fc)))
                  (tb3-partial! 'h tb3-cc ss)
                  (subst (list '= (caddr fc) (cadr fc)))
                  (tb3-close!))))))
        (tb3-and! (list 'IN eh 'RR-POS-STAR) (tb3-bound kk eh))
        (tb3-cite! 'esum-least kk eh)
        (tb3-trans! (tb3-fs 'a sv) ek eh)
        (tb3-close!))))
  (tb3-and! (list 'IN eh 'RR-POS-STAR) (tb3-bound 'a eh))
  (tb3-cite! 'esum-least 'a eh)
  (tb3-close!))
(tb3-done! 'esum-cartesian-ge)

;;; ====================================================================
;;; esum-cartesian (Prop 3.38's lemma): an ESUM over ii x jj is the iterated ESUM
;;; ====================================================================
(sp (make-wff (list 'FORALL 'ii (list 'FORALL 'jj (list 'IMPLIES '(IN jj SET)
  (list 'FORALL 'h (list 'FORALL 'g (list 'FORALL 'a
    (list 'IMPLIES '(IN h (FUN (CARTESIAN ii jj) RR-POS-STAR))
    (list 'IMPLIES '(IN g (FUN ii (FUN jj RR-POS-STAR)))
    (list 'IMPLIES tb3-ht
    (list 'IMPLIES '(IN a (FUN ii RR-POS-STAR))
    (list 'IMPLIES tb3-hae
      '(= (ESUM h) (ESUM a)))))))))))))))
(dk-peel!)
(tb3-rps-carr!)
(tb3-dom! 'h tb3-cc 'RR-POS-STAR)
(tb3-dom! 'a 'ii 'RR-POS-STAR)
(tb3-dom! 'g 'ii '(FUN jj RR-POS-STAR))
(let* ((pp1 (list 'VNB-LAMBDA 'tbw_ tb3-cc '(NTH 1 tbw_)))
       (pp2 (list 'VNB-LAMBDA 'tbw_ tb3-cc '(NTH 2 tbw_)))
       (gg (list 'VNB-LAMBDA 'tbu_ 'jj (list 'VNB-LAMBDA 'tbv_ 'ii '((g tbv_) tbu_))))
       (ht (tb3-ctx tb3-ht))
       (proj-typ! (lambda (pp k cod)
                    (tb3-have! (list 'IN pp (list 'FUN tb3-cc cod))
                      (lambda ()
                        (dk-lam-type!
                          (lambda ()
                            (let ((w (dk-di-var!)))
                              (dk-split-all! (list (tb3-cite! 'cartesian-nth w 'ii 'jj)))
                              (tb3-close!)))))))))
  (proj-typ! pp1 1 'ii)
  (proj-typ! pp2 2 'jj)
  (tb3-have! (list 'IN gg '(FUN jj (FUN ii RR-POS-STAR)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((j (dk-di-var!)))
            (dk-lam-type!
              (lambda ()
                (let ((i (dk-di-var!)))
                  (tb3-ap! 'g 'ii '(FUN jj RR-POS-STAR) i)
                  (tb3-ap! (list 'g i) 'jj 'RR-POS-STAR j)
                  (tb3-close!)))))))))
  (tb3-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ ii) (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ jj)
               (list '= (list (list gg 'j_) 'i_) '((g i_) j_))))))
    (lambda ()
      (dk-peel!)
      (let* ((rh (caddr (dk-goal))) (i (cadr (car rh))) (j (cadr rh)))
        (tb3-ap! 'g 'ii '(FUN jj RR-POS-STAR) i)
        (tb3-ap! (list 'g i) 'jj 'RR-POS-STAR j)
        (dk-lam-b!)
        (tb3-close!))))
  (tb3-have! (list 'FORALL 'w_ (list 'IMPLIES (list 'IN 'w_ tb3-cc) (list '= 'w_ (list 'LIST (list pp1 'w_) (list pp2 'w_)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (dk-split-all! (list (tb3-cite! 'cartesian-nth w 'ii 'jj)))
        (dk-lam-b!)
        (tb3-cite! 'cartesian-pair-eq w 'ii 'jj)
        (tb3-close!))))
  (let ((le (tb3-cite! 'esum-cartesian-le 'ii 'jj 'h 'g 'a pp1 pp2))
        (ge (tb3-cite! 'esum-cartesian-ge 'ii 'jj 'h 'g gg 'a pp1 pp2)))
    (tb3-and! '(IN (ESUM h) RR-POS-STAR) '(IN (ESUM a) RR-POS-STAR))
    (tb3-and! le ge)
    (tb3-cite! 'rr-pos-star-le-antisymm '(ESUM h) '(ESUM a))
    (tb3-close!)))
(tb3-done! 'esum-cartesian)
