;;; calc2-segment.scm -- the one-variable facts the coordinate segments need.  CALC-2, 2026-10-19.
;;; Prefix c2s-.

(define (c2s-open) (dk-open-leaves))
(define (c2s-dump tag)
  (display ";; C2S ") (display tag) (display " goal: ") (display (dk-goal)) (newline)
  (for-each (lambda (a) (display ";; C2S   asm: ") (display a) (newline)) (dk-asms))
  (for-each (lambda (l) (display ";; C2S   open: ") (display (dk-goal-of l)) (newline)) (c2s-open)))
(define (c2s-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))

;;; (1) A function that agrees on [lo, hi] with a function having a derivative at every
;;; point of [lo, hi] is continuous on [lo, hi].
(define c2s-D '(CCINT lo_ hi_))
(sp (make-wff (forall-guarded '(lo_ hi_ ff_ hh_)
  (list '(IN lo_ RR) '(IN hi_ RR) (list 'IN 'hh_ (list 'FUN c2s-D 'RR))
        (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ c2s-D) '(= (hh_ y_) (ff_ y_))))
        (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ c2s-D) '(FORSOME l_ (HAS-DERIV-AT ff_ x_ l_)))))
  (list 'IS-CONTINUOUS-ON 'hh_ c2s-D))))
(dk-peel!)
(define c2s-agree (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hh_))) "agree"))
(define c2s-derivs (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DERIV-AT))) "derivs"))
(fact 'rr-is-set)
(fact 'ccint-subset-rr 'lo_ 'hi_)
(dk-cite! 'subclass-of-set-is-set c2s-D 'RR)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(dk-have! (list 'SUBSET c2s-D '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(dk-cite! 'subspace-is-metric-space 'RR-MS c2s-D)
(fact 'subspace-pts 'RR-MS c2s-D)
;;; the eps-delta clause at the point x of [lo, hi]
(define (c2s-eps-delta! x)
  (dk-peel!)                                            ; eps, (POS-RR eps)
  (let* ((eps (cadr (dk-pick (lambda (f) (dk-head-is? f 'POS-RR)) "eps")))
         (ex  (dk-apply! c2s-derivs x))
         (l   (dk-skolem! ex))
         (fx  (list 'ff_ x)))
    (dk-cite! 'rr-one-in)
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-pos-rr-of-lt 1)
    (let* ((mi (dk-cite! 'has-deriv-at-maps-into 'ff_ x l))
           (wex (dk-apply! mi eps 1))
           (w (dk-skolem! wex #t))
           (wall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w))) "the w-universal")))
      (dk-cite! 'rr-pos-rr-in-rr w)
      (dk-cite! 'rr-lt-of-pos-rr w)
      (let ((d (dk-halve! w)))
        (ew d)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'POS-RR) (ass)
              (let* ((y (begin (dk-peel!) (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) c2s-D)
                                                                          (not (equal? (cadr f) x)) (not (eq? (cadr f) 'hh_)))) "y"))))
                     (fy (list 'ff_ y))
                     (hx (dk-apply! c2s-agree x))
                     (hy (dk-apply! c2s-agree y)))
                (dk-cite! 'ccint-elt-in-rr 'lo_ 'hi_ x)
                (dk-cite! 'ccint-elt-in-rr 'lo_ 'hi_ y)
                (let* ((dh (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'DIST))) "the distance hypothesis"))
                       (dsub (dk-cite! 'subspace-dist 'RR-MS c2s-D x y))
                       (h1 (dk-rewrite-h! dh (cadr dsub) (caddr dsub)))
                       (drr (dk-cite! 'rr-ms-dist x y))
                       (h2 (dk-rewrite-h! h1 (cadr drr) (caddr drr))))
                  (dk-type! (list '- x y))
                  (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- x y) d)))
                  (dk-have! (list 'IN y (list 'OOINT (list '- x w) (list '+ x w)))
                    (lambda ()
                      (mac 'ooint-membership)
                      (dk-conj-close! (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN) (ass)
                            (dk-ineq! (list '<= (list '- d) (list '- x y)) (list '<= (list '- x y) d)
                                      (list '= (list '+ d d) w) (list '< 0 d)))))))
                  (let* ((mem (dk-apply! wall y))
                         (iff (dk-cite! 'ooint-membership (list '- fx eps) (list '+ fx eps) fy)))
                    (dk-split-all! (list (dk-meta-iff-r! iff)))
                    (subst hx) (subst hy)
                    (dk-have! (list 'IN fx 'RR) (lambda () (subst (list '= fx (list 'hh_ x)))
                                                   (c2s-and! (list 'IN 'hh_ (list 'FUN c2s-D 'RR)) (list 'IN x c2s-D))
                                                   (dk-cite! 'fun-apply-type 'hh_ c2s-D 'RR x) (ass)))
                    (subst (dk-cite! 'rr-ms-dist fx fy))
                    (dk-cite! 'rr-pos-rr-in-rr eps)
                    (dk-type! (list '- fx fy))
                    (dk-have! (list '<= (list '- eps) (list '- fx fy))
                      (lambda () (dk-ineq! (list '< fy (list '+ fx eps)))))
                    (dk-have! (list '<= (list '- fx fy) eps)
                      (lambda () (dk-ineq! (list '< (list '- fx eps) fy))))
                    (dk-cite! 'rr-abs-le-of-parts (list '- fx fy) eps)
                    (ass)))))))))))

(mac 'IS-CONTINUOUS-ON)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN) (ass)
      (let ((x (begin (dk-peel!) (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) c2s-D)
                                                                  (not (eq? (cadr f) 'hh_)))) "x")))))
        (mac 'IS-CONTINUOUS-AT)
        (subst (list '= (list 'PTS (list 'SUBSPACE-MS 'RR-MS c2s-D)) c2s-D))
        (subst '(= (PTS RR-MS) RR))
        (dk-conj-close!
          (lambda ()
            (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
                (c2s-eps-delta! x))))))))
(qed 'continuous-on-of-derivs-on-ccint)

;;; (2) THE MEAN VALUE INEQUALITY on [lo, hi]: a function whose derivative exists at every
;;; point of [lo, hi] and stays within bd of ll moves by ll (hi - lo) up to bd (hi - lo).
(define c2s-H #f)
(sp (make-wff (forall-guarded '(lo_ hi_ ff_ ll_ bd_)
  (list '(IN lo_ RR) '(IN hi_ RR) '(< lo_ hi_) '(IN ll_ RR) '(IN bd_ RR)
        (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ c2s-D)
          '(FORSOME l_ (AND (HAS-DERIV-AT ff_ x_ l_) (<= (abs (- l_ ll_)) bd_))))))
  '(<= (abs (- (- (ff_ hi_) (ff_ lo_)) (* ll_ (- hi_ lo_)))) (* bd_ (- hi_ lo_))))))
(dk-peel!)
(set! c2s-H (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DERIV-AT))) "H"))
(define c2s-rh (list 'RESTRICT 'ff_ c2s-D))
(fact 'rr-is-set)
(fact 'ccint-subset-rr 'lo_ 'hi_)
(dk-cite! 'subclass-of-set-is-set c2s-D 'RR)
;;; at a point t of [lo, hi]: skolemize the derivative, return (l . bound)
(define (c2s-deriv-at! t)
  (let* ((ex (dk-apply! c2s-H t))
         (l  (dk-skolem! ex #t)))
    (dk-cite! 'has-deriv-at-value-in-rr 'ff_ t l)
    (dk-cite! 'has-deriv-at-in-rr 'ff_ t l)
    l))
(dk-have! (list 'IN c2s-rh (list 'FUN c2s-D 'RR))
  (lambda ()
    (mac 'RESTRICT)
    (dk-lam-type! (lambda () (let ((t (dk-di-var!))) (c2s-deriv-at! t) (ass))) (lambda () (ass)))))
(dk-have! (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ c2s-D) (list '= (list c2s-rh 'y_) '(ff_ y_))))
  (lambda ()
    (let ((y (dk-di-var!)))
      (c2s-deriv-at! y)
      (subst (dk-cite! 'restrict-apply 'ff_ c2s-D y))
      (rfl))))
(dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ c2s-D) '(FORSOME l_ (HAS-DERIV-AT ff_ x_ l_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (l (c2s-deriv-at! x)))
      (ew l) (ass))))
(dk-cite! 'continuous-on-of-derivs-on-ccint 'lo_ 'hi_ 'ff_ c2s-rh)
;;; the derivative of the restriction at an interior point x is that of ff_
(define (c2s-interior! x)
  (let* ((l (c2s-deriv-at! x)))
    (dk-cite! 'ooint-elt-in-rr 'lo_ 'hi_ x)
    (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'ooint-membership 'lo_ 'hi_ x))))
    (dk-type! (list '- x 'lo_)) (dk-type! (list '- 'hi_ x))
    (dk-have! (list '< 0 (list '- x 'lo_)) (lambda () (dk-ineq! (list '< 'lo_ x))))
    (dk-have! (list '< 0 (list '- 'hi_ x)) (lambda () (dk-ineq! (list '< x 'hi_))))
    (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos (list '- x 'lo_) (list '- 'hi_ x)) #t))
           (O (list 'OOINT (list '- x w) (list '+ x w))))
      (dk-cite! 'rr-pos-rr-of-lt w)
      (dk-type! (list '- x w)) (dk-type! (list '+ x w))
      (dk-have! (list '<= 'lo_ (list '- x w)) (lambda () (dk-ineq! (list '<= w (list '- x 'lo_)))))
      (dk-have! (list '<= (list '+ x w) 'hi_) (lambda () (dk-ineq! (list '<= w (list '- 'hi_ x)))))
      (dk-cite! 'ooint-subset-ccint (list '- x w) (list '+ x w))
      (dk-cite! 'ccint-subset-ccint 'lo_ 'hi_ (list '- x w) (list '+ x w))
      (dk-cite! 'subset-trans O (list 'CCINT (list '- x w) (list '+ x w)) c2s-D)
      (dk-cite! 'restrict-in-fun c2s-rh c2s-D 'RR O)
      (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ O) (list '== (list c2s-rh 'hbx_) '(ff_ hbx_))))
        (lambda ()
          (let ((y (dk-di-var!)))
            (dk-cite! 'subset-mem-fwd O c2s-D y)
            (dk-cite! 'restrict-apply 'ff_ c2s-D y)
            (ass))))
      (dk-cite! 'has-deriv-at-local w c2s-rh 'ff_ x l)
      l)))
(define (c2s-bound-claim lower?)
  (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (OOINT lo_ hi_))
    (list 'FORSOME 'l_ (list 'AND (list 'HAS-DERIV-AT c2s-rh 'x_ 'l_)
                               (if lower? '(<= (- ll_ bd_) l_) '(<= l_ (+ ll_ bd_))))))))
(define (c2s-bound! lower?)
  (dk-have! (c2s-bound-claim lower?)
    (lambda ()
      (let* ((x (dk-di-var!)))
        (dk-cite! 'ooint-subset-ccint 'lo_ 'hi_)
        (dk-cite! 'subset-mem-fwd '(OOINT lo_ hi_) c2s-D x)
        (let* ((l (c2s-interior! x))
               (b (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f l) (dk-contains? f 'abs))) "the bound")))
          (dk-type! (list '- l 'll_))
          (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- l 'll_) 'bd_)))
          (ew l)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'HAS-DERIV-AT) (ass)
                  (dk-ineq! (list '<= (list '- 'bd_) (list '- l 'll_)) (list '<= (list '- l 'll_) 'bd_))))))))))
(c2s-bound! #f)
(c2s-bound! #t)
(dk-type! '(+ ll_ bd_)) (dk-type! '(- ll_ bd_))
(define c2s-up (dk-cite! 'mvt-upper-bound-on-interval 'lo_ 'hi_ '(+ ll_ bd_) c2s-rh))
(define c2s-lo (dk-cite! 'mvt-lower-bound-on-interval 'lo_ 'hi_ '(- ll_ bd_) c2s-rh))
;;; the algebra: the restriction's endpoint values are ff_'s, and the products are named
(define (c2s-endpoint! t)
  (dk-have! (list 'IN t c2s-D)
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq! '(< lo_ hi_)))))))
  (c2s-deriv-at! t)
  (dk-cite! 'restrict-apply 'ff_ c2s-D t))
(define c2s-eh (c2s-endpoint! 'hi_))
(define c2s-el (c2s-endpoint! 'lo_))
(define c2s-up2 (dk-rewrite-h! (dk-rewrite-h! c2s-up (cadr c2s-eh) (caddr c2s-eh)) (cadr c2s-el) (caddr c2s-el)))
(define c2s-lo2 (dk-rewrite-h! (dk-rewrite-h! c2s-lo (cadr c2s-eh) (caddr c2s-eh)) (cadr c2s-el) (caddr c2s-el)))
(define c2s-P '(* ll_ (- hi_ lo_)))
(define c2s-Q '(* bd_ (- hi_ lo_)))
(dk-type! '(- hi_ lo_))
(dk-type! c2s-P) (dk-type! c2s-Q)
(dk-have! (list '= '(* (+ ll_ bd_) (- hi_ lo_)) (list '+ c2s-P c2s-Q)) (lambda () (crs)))
(dk-have! (list '= '(* (- ll_ bd_) (- hi_ lo_)) (list '- c2s-P c2s-Q)) (lambda () (crs)))
(define c2s-up3 (dk-rewrite-h! c2s-up2 '(* (+ ll_ bd_) (- hi_ lo_)) (list '+ c2s-P c2s-Q)))
(define c2s-lo3 (dk-rewrite-h! c2s-lo2 '(* (- ll_ bd_) (- hi_ lo_)) (list '- c2s-P c2s-Q)))
(define c2s-vp (dk-name! c2s-P))
(define c2s-vq (dk-name! c2s-Q))
(define c2s-up4 (dk-rewrite-h! (dk-rewrite-h! c2s-up3 c2s-P c2s-vp) c2s-Q c2s-vq))
(define c2s-lo4 (dk-rewrite-h! (dk-rewrite-h! c2s-lo3 c2s-P c2s-vp) c2s-Q c2s-vq))
(subst (list '= c2s-P c2s-vp))
(subst (list '= c2s-Q c2s-vq))
(define c2s-x (list '- '(- (ff_ hi_) (ff_ lo_)) c2s-vp))
(dk-type! c2s-x)
(dk-have! (list '<= (list '- c2s-vq) c2s-x) (lambda () (dk-ineq! c2s-lo4)))
(dk-have! (list '<= c2s-x c2s-vq) (lambda () (dk-ineq! c2s-up4)))
(dk-cite! 'rr-abs-le-of-parts c2s-x c2s-vq)
(ass)
(qed 'mean-value-inequality-on-interval)

;;; (3) A DERIVATIVE FROM A LITTLE-O BOUND, on the line.  If g is real on (c - r, c + r) and
;;; for every e > 0 there is d > 0 with |g(t) - g(c) - (t - c) L| <= e |t - c| for |t - c| < d,
;;; then g has derivative L at c.  The real twin of cc-diff-on-of-eps-bound
;;; (goursat-exceptional.scm), through has-deriv-at-of-within-ooint.
(define c2s-W '(OOINT (- ec_ er_) (+ ec_ er_)))
(define (c2s-err t) (list '- (list '- (list 'eg_ t) '(eg_ ec_)) (list '* (list '- t 'ec_) 'el_)))
(define c2s-eb
  (list 'FORALL 'ee_ (list 'IMPLIES '(POS-RR ee_)
    (list 'FORSOME 'ed_ (list 'AND '(POS-RR ed_)
      (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ c2s-W)
        (list 'IMPLIES '(< (abs (- et_ ec_)) ed_)
          (list '<= (list 'abs (c2s-err 'et_)) '(* ee_ (abs (- et_ ec_))))))))))))
(sp (make-wff (forall-guarded '(eg_ ec_ er_ el_)
  (list '(IN ec_ RR) '(POS-RR er_) '(IN el_ RR)
        (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ c2s-W) '(IN (eg_ et_) RR)))
        c2s-eb)
  '(HAS-DERIV-AT eg_ ec_ el_))))
(dk-peel!)
(define c2s-gty (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'ee_)))) "g typing"))
(define c2s-ebf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ee_))) "the bound"))
(dk-cite! 'rr-pos-rr-in-rr 'er_) (dk-cite! 'rr-lt-of-pos-rr 'er_)
(dk-type! '(- ec_ er_)) (dk-type! '(+ ec_ er_))
(fact 'rr-is-set)
(dk-cite! 'ooint-subset-rr '(- ec_ er_) '(+ ec_ er_))
(dk-cite! 'subclass-of-set-is-set c2s-W 'RR)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(dk-have! (list 'SUBSET c2s-W '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(dk-cite! 'subspace-is-metric-space 'RR-MS c2s-W)
(dk-cite! 'subspace-pts 'RR-MS c2s-W)
(define (c2s-inW! t)                  ; (IN t W) from |t - c| < r style facts: membership by ineq
  (dk-have! (list 'IN t c2s-W)
    (lambda () (mac 'ooint-membership)
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq! '(< 0 er_))))))))
(c2s-inW! 'ec_)
(dk-apply! c2s-gty 'ec_)
(define (c2s-quot v) (list '* (list '- (list 'eg_ v) '(eg_ ec_)) (list 'recip (list '- v 'ec_))))
(define (c2s-ift v) (list 'IF (list '= v 'ec_) 'el_ (c2s-quot v)))
(define c2s-phi (list 'VNB-LAMBDA 'hpv_ c2s-W (c2s-ift 'hpv_)))
;;; v in W, v /= c: v - c /= 0, recip(v - c) real, q(v) real, (v - c) recip(v - c) = 1
(define (c2s-nz! v)
  (let ((d (list '- v 'ec_)))
    (dk-cite! 'ooint-elt-in-rr '(- ec_ er_) '(+ ec_ er_) v)
    (dk-apply! c2s-gty v)
    (dk-type! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= v 'ec_)
          (lambda ()
            (dk-have! (list '= v (list '+ d 'ec_)) (lambda () (crs)))
            (subst (list '= v (list '+ d 'ec_)))
            (subst (list '= d 0))
            (crs)))
        (ai (list 'NOT (list '= v 'ec_)))))
    (c2s-and! (list 'IN d 'RR) (list 'NOT (list '= d 0)))
    (dk-cite! 'rr-recip-closed d)
    (dk-cite! 'rr-recip-inverse d)
    (dk-type! (list '- (list 'eg_ v) '(eg_ ec_)))
    (c2s-and! (list 'IN (list '- (list 'eg_ v) '(eg_ ec_)) 'RR) (list 'IN (list 'recip d) 'RR))
    (dk-cite! 'rr-mul-closed (list '- (list 'eg_ v) '(eg_ ec_)) (list 'recip d))))
;;; the factor is real on W, so phi is a function W -> RR
(define c2s-pt
  (list 'FORALL 'hpv_ (list 'IMPLIES (list 'IN 'hpv_ c2s-W) (list 'IN (c2s-ift 'hpv_) 'RR))))
(dk-have! c2s-pt
  (lambda ()
    (let ((v (dk-di-var!)))
      (use-em (list '= v 'ec_)
        (lambda () (dk-if-branch! #t (c2s-ift v) #f (lambda () (ass))))
        (lambda () (c2s-nz! v) (dk-if-branch! #f (c2s-ift v) #f (lambda () (ass))))))))
(dk-have! (list 'IN c2s-phi (list 'FUN c2s-W 'RR))
  (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-apply! c2s-pt v) (ass))) (lambda () (ass)))))
(define c2s-pa (list '= (list c2s-phi 'ec_) 'el_))
(dk-have! c2s-pa
  (lambda () (dk-lam-b!) (dk-if-branch! #t (c2s-ift 'ec_) (lambda () (rfl)) (lambda () (rfl)))))
;;; the restriction of g to W is a function W -> RR
(dk-have! (list 'IN (list 'RESTRICT 'eg_ c2s-W) (list 'FUN c2s-W 'RR))
  (lambda () (mac 'RESTRICT)
    (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-apply! c2s-gty v) (ass))) (lambda () (ass)))))
;;; continuity of phi at c
(define (c2s-cont-eps!)
  (dk-peel!)
  (let* ((eps (cadr (dk-pick (lambda (f) (dk-head-is? f 'POS-RR)) "eps")))
         (d1 (dk-skolem! (dk-apply! c2s-ebf eps) #t))
         (eb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "the bound at eps")))
    (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
    (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1)
    (let ((del (dk-halve! d1)))
      (ew del)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
            (let* ((b (begin (dk-peel!) (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) c2s-W)
                                                                        (not (eq? (cadr f) 'ec_)))) "b"))))
                   (dh (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'DIST))) "the distance hypothesis"))
                   (dsub (dk-cite! 'subspace-dist 'RR-MS c2s-W 'ec_ b))
                   (h1 (dk-rewrite-h! dh (cadr dsub) (caddr dsub)))
                   (dk1 (begin (dk-cite! 'ooint-elt-in-rr '(- ec_ er_) '(+ ec_ er_) b) (dk-cite! 'rr-ms-dist 'ec_ b)))
                   (h2 (dk-rewrite-h! h1 (cadr dk1) (caddr dk1)))
                   (dba (list 'abs (list '- b 'ec_))))
              (dk-type! (list '- 'ec_ b)) (dk-type! (list '- b 'ec_))
              (dk-cite! 'rr-abs-closed (list '- 'ec_ b)) (dk-cite! 'rr-abs-closed (list '- b 'ec_))
              (dk-cite! 'rr-abs-sub-sym 'ec_ b)
              (dk-have! (list '< dba d1)
                (lambda () (subst (list '= dba (list 'abs (list '- 'ec_ b))))
                  (dk-ineq! h2 (list '= (list '+ del del) d1) (list '< 0 del))))
              (subst c2s-pa)
              (dk-lam-b!)
              (let ((pb (c2s-ift b)))
                (dk-apply! c2s-pt b)
                (subst (dk-cite! 'rr-ms-dist 'el_ pb))
                (use-em (list '= b 'ec_)
                  (lambda ()
                    (dk-if-branch! #t pb #f (lambda ()
                      (dk-have! '(= (- el_ el_) 0) (lambda () (crs)))
                      (subst '(= (- el_ el_) 0))
                      (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0))
                      (dk-ineq! (list '< 0 eps)))))
                  (lambda ()
                    (c2s-nz! b)
                    (dk-if-branch! #f pb #f (lambda ()
                      (let* ((q (c2s-quot b)) (lq (list '- 'el_ q)) (d (list '- b 'ec_)) (e (c2s-err b))
                             (mlq (list 'abs lq)))
                        (dk-type! lq) (dk-type! e)
                        (dk-cite! 'rr-abs-closed lq) (dk-cite! 'rr-abs-closed e)
                        (dk-have! (list '= (list '* lq d) (list '- e))
                          (lambda ()
                            (let ((ex (list '- (list '* 'el_ d)
                                               (list '* (list '- (list 'eg_ b) '(eg_ ec_)) (list '* d (list 'recip d))))))
                              (dk-have! (list '= (list '* lq d) ex) (lambda () (dk-crs-opaque!)))
                              (subst (list '= (list '* lq d) ex))
                              (subst (list '= (list '* d (list 'recip d)) 1))
                              (crs))))
                        (c2s-and! (list 'IN lq 'RR) (list 'IN d 'RR))
                        (dk-cite! 'rr-abs-mult lq d)
                        (dk-cite! 'rr-abs-neg e)
                        (dk-apply! eb b)
                        (dk-type! (list '* mlq dba)) (dk-type! (list '* eps dba))
                        (dk-have! (list '<= (list '* mlq dba) (list '* eps dba))
                          (lambda ()
                            (subst (list '= (list '* mlq dba) (list 'abs (list '* lq d))))
                            (subst (list '= (list '* lq d) (list '- e)))
                            (subst (list '= (list 'abs (list '- e)) (list 'abs e)))
                            (ass)))
                        ;; |b - c| > 0: cancel it
                        (dk-cite! 'rr-abs-nonneg d)
                        (dk-have! (list 'NOT (list '= dba 0))
                          (lambda () (di) (dk-meta-iff-r! (dk-cite! 'rr-abs-zero d)) (ai (list 'NOT (list '= d 0)))))
                        (dk-cite! 'neq-sym dba 0)
                        (c2s-and! (list '<= 0 dba) (list 'NOT (list '= 0 dba)))
                        (dk-cite! 'rr-le-ne-lt 0 dba)
                        (dk-cite! 'rr-mul-le-cancel-pos mlq dba eps)
                        (ass))))))))))))))
(dk-have! (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS 'RR-MS c2s-W) 'RR-MS c2s-phi 'ec_)
  (lambda ()
    (mac 'IS-CONTINUOUS-AT)
    (subst (list '= (list 'PTS (list 'SUBSPACE-MS 'RR-MS c2s-W)) c2s-W))
    (subst '(= (PTS RR-MS) RR))
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORALL) (c2s-cont-eps!) (ass))))))
;;; the identity g(t) - g(c) = phi(t) (t - c) on W
(dk-have! (list 'FORALL 'ost_ (list 'IMPLIES (list 'IN 'ost_ c2s-W)
            (list '= '(- (eg_ ost_) (eg_ ec_)) (list '* (list c2s-phi 'ost_) '(- ost_ ec_)))))
  (lambda ()
    (let* ((t (dk-di-var!)) (pt (c2s-ift t)))
      (dk-apply! c2s-pt t)
      (dk-lam-b!)
      (use-em (list '= t 'ec_)
        (lambda () (dk-if-branch! #t pt #f (lambda () (subst (list '= t 'ec_)) (crs))))
        (lambda ()
          (c2s-nz! t)
          (dk-if-branch! #f pt #f (lambda ()
            (let* ((d (list '- t 'ec_))
                   (ex (list '* (list '- (list 'eg_ t) '(eg_ ec_)) (list '* d (list 'recip d)))))
              (dk-have! (list '= (list '* (c2s-quot t) d) ex) (lambda () (dk-crs-opaque!)))
              (subst (list '= (list '* (c2s-quot t) d) ex))
              (subst (list '= (list '* d (list 'recip d)) 1))
              (crs)))))))))
(dk-cite! 'has-deriv-at-of-within-ooint 'ec_ 'er_)
(dk-have! (list 'HAS-DERIV-AT-WITHIN 'eg_ c2s-W 'ec_ 'el_)
  (lambda ()
    (mac 'HAS-DERIV-AT-WITHIN)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORSOME)
            (begin (ew c2s-phi) (dk-conj-close! (lambda () (ass))))
            (ass))))))
