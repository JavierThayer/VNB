;;; ba-forms.scm -- BanachAlgebras.pdf ch. 3, sec. 4-5: closed quadratic forms, T*T, Friedrichs.
;;;   3.16 form-closed-iff-hilbert: a positive form Q is closed iff H_Q+ is a Hilbert space.
;;;   3.17 form-operator-self-adjoint / -positive / -functional / -dom-dense: the operator T_Q of a
;;;        closed positive form is a densely defined positive self-adjoint operator.
;;;   3.23 closed-op-adjoint-compose-self-adjoint / -positive / -dom-dense: for a closed operator T
;;;        (a linear map ff on a dense submodule dd, its graph closed in H (+) H), T*T is densely
;;;        defined, positive and self-adjoint; graph-form-closed: Q(x, y) = <T x | T y> is closed.
;;;   3.21 friedrichs-extension: a positive symmetric densely defined T has the self-adjoint positive
;;;        extension T_Q1, Q1 the closure of Q(x, y) = <x | T y> (friedrichs-extension-of-form for a
;;;        general positive form).  Route of th-main 5.8: H1 = Hilbert completion of (dom Q, Q+),
;;;        g : H1 -> H the continuous extension of dom Q -> H (fr-g-exists), <u | E psi>_H1 =
;;;        <g u | T psi + psi> (fr-key, Lemma 5.50), g one-to-one (fr-g-injective), dom Q1 = g(H1),
;;;        Q1(a, b) = <g^-1 a | g^-1 b>_H1 - <a | b> (pb-closed: closed since H_Q1+ is isometric to H1).
;;;   Bridges: form-ms-cips-module (FORM-MS of a CIPS's module view = its IP-METRIC-SPACE);
;;;        complete-of-isometric-cover (completeness passes along an isometry with a right inverse).
;;; Unbounded operators are graphs in H (+) H (decision D4); vocabulary ba-unbdd-vocab.scm.
;;; Helper prefix bff-; binders bf*_ bg*_ bp*_ bi*_ br*_.
;;; ---- PART A: the space H_Q+ at points of dom Q -------------------------------------------------
;;; Helper prefix bff-.  Parameters v (the Hilbert space), dd (dom Q), q (the form), as in
;;; theorem-library/ipf-form-plus.scm.
(define (bff-open?) (pair? (dk-open-leaves)))
(define (bff-dump!)
  (for-each (lambda (l) (display ";; BFF OPEN ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;    asm ") (display (expression->string a)) (newline)) (dk-asms-of l)))
            (dk-open-leaves)))
(define (bff-qed! name)
  (if (not (proof-done? *ps*)) (bff-dump!))
  (qed name) (topic! name 'analysis))
(define bff-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define bff-S '(SUB-CIPS v dd))
(define bff-M '(COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE (SUB-CIPS v dd)))
(define bff-FP '(FORM-PLUS v dd q))
(define bff-FPS '(FORM-PLUS-SPACE v dd q))
(define bff-MS '(IP-METRIC-SPACE (FORM-PLUS-SPACE v dd q)))
(define bff-MV '(IP-METRIC-SPACE v))
(define bff-H '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v dd) (IS-POSITIVE-FORM v dd q)))
(define (bff-sub a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (bff-qq z) (list 'q z z))
(define (bff-ii z) (list '(IP v) z z))
(define (bff-dv a b) (list (list 'DIST bff-MV) a b))
(define (bff-dp a b) (list (list 'DIST bff-MS) a b))

;;; the laws of Q, as they land from IS-QUADRATIC-FORM / IS-POSITIVE-FORM (binders of ba-unbdd-vocab)
(define bff-q-typ '(IN q (FUN (CARTESIAN dd dd) CC)))
(define bff-q-add
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd) (FORALL ubz_ (IMPLIES (IN ubz_ dd)
     (= (q ((VADD v) ubx_ uby_) ubz_) (+ (q ubx_ ubz_) (q uby_ ubz_))))))))))
(define bff-q-homog
  '(FORALL ubk_ (IMPLIES (IN ubk_ CC) (FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd)
     (= (q ((ACT v) ubk_ ubx_) uby_) (* ubk_ (q ubx_ uby_))))))))))
(define bff-q-herm
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd) (= (q uby_ ubx_) (conjugate (q ubx_ uby_))))))))
(define bff-q-pos
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (AND (IN (q ubx_ ubx_) RR) (<= 0 (q ubx_ ubx_))))))
(define bff-ipf-typ (list 'IN bff-FP (list 'FUN (list 'CARTESIAN (list 'VEC bff-M) (list 'VEC bff-M)) 'CC)))

(define (bff-base!)
  (if (not (dk-asm? '(SUBSET dd (VEC v)))) (dk-cite! 'submodule-subset 'v 'dd))
  (if (not (dk-asm? '(IN dd SET)))
      (begin (dk-cite! 'cips-vec-set 'v) (dk-cite! 'subclass-of-set-is-set 'dd '(VEC v))))
  (if (not (dk-asm? '(IN CC SET))) (fact 'cc-is-set))
  (if (not (dk-asm? '(IS-NORMED-FIELD CC-NORMED-FIELD))) (fact 'cc-is-normed-field))
  (if (not (dk-asm? (list 'IS-COMMUTATIVE-RING bff-R)))
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))
  (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE bff-S))) (dk-cite! 'sub-cips-is-cips 'v 'dd))
  (if (not (dk-asm? (list 'IS-MODULE bff-M)))
      (dk-cite! 'complex-inner-product-space-as-module-is-module bff-S))
  (if (not (dk-asm? '(IS-QUADRATIC-FORM v dd q)))
      (dk-project! '(IS-QUADRATIC-FORM v dd q) 'is-positive-form '(IS-POSITIVE-FORM v dd q)))
  (for-each (lambda (f) (if (not (dk-asm? f)) (dk-project! f 'is-quadratic-form '(IS-QUADRATIC-FORM v dd q))))
            (list bff-q-typ bff-q-add bff-q-homog bff-q-herm))
  (if (not (dk-asm? bff-q-pos)) (dk-project! bff-q-pos 'is-positive-form '(IS-POSITIVE-FORM v dd q)))
  (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE bff-FPS))) (dk-cite! 'form-plus-space-is-cips 'v 'dd 'q))
  (if (not (dk-asm? bff-ipf-typ))
      (let ((ipf (list 'IS-INNER-PRODUCT-FORM bff-M bff-FP)))
        (if (not (dk-asm? ipf)) (dk-cite! 'form-plus-inner-product-form 'v 'dd 'q))
        (dk-project! bff-ipf-typ
          (lambda ()
            (dk-split-all! (dk-landed (lambda () (mac-h 'is-inner-product-form ipf))))
            (dk-split-all! (dk-landed (lambda () (mac-h 'is-psd-form (list 'IS-PSD-FORM bff-M bff-FP)))))
            (dk-split-all! (dk-landed (lambda () (mac-h 'is-hermitian-form (list 'IS-HERMITIAN-FORM bff-M bff-FP))))))))))

;;; typing helpers (after ipf-form-plus.scm's fps-dt! / fps-vv! / fps-ct!)
(define (bff-cscal! c)
  (let ((g (list 'IN c '(CARR (SCAL v)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'cips-scal-carrier 'v)
               (dk-have! g (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))))))
(define (bff-dt! e)
  (let ((g (list 'IN e 'dd)))
    (cond ((dk-asm? g) g)
          ((equal? e '(VZERO v)) (dk-cite! 'submodule-vzero-in 'v 'dd) g)
          ((and (pair? e) (equal? (car e) '(VADD v)))
           (bff-dt! (cadr e)) (bff-dt! (caddr e)) (dk-cite! 'submodule-vadd-closed 'v 'dd (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG v)))
           (bff-dt! (cadr e)) (dk-cite! 'submodule-vneg-closed 'v 'dd (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT v)))
           (bff-cscal! (cadr e)) (bff-dt! (caddr e)) (dk-cite! 'submodule-act-closed 'v 'dd (cadr e) (caddr e)) g)
          (#t (error "bff-dt!: no dd typing for" (expression->string e))))))
(define (bff-vv! e)
  (let ((g (list 'IN e '(VEC v))))
    (cond ((dk-asm? g) g)
          ((dk-asm? (list 'IN e 'dd)) (dk-cite! 'subset-mem-fwd 'dd '(VEC v) e) g)
          ((and (pair? e) (equal? (car e) '(VADD v)))
           (bff-vv! (cadr e)) (bff-vv! (caddr e)) (dk-cite! 'cips-vadd-type 'v (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG v)))
           (bff-vv! (cadr e)) (dk-cite! 'cips-vneg-type 'v (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT v)))
           (bff-ct! (cadr e)) (bff-vv! (caddr e)) (dk-cite! 'cips-act-type 'v (cadr e) (caddr e)) g)
          ((and (pair? e) (eq? (car e) 'ff) (= (length e) 2))     ; an operator ff in FUN(dd, VEC v)
           (bff-dt! (cadr e)) (dk-cite! 'fun-apply-type-c 'ff 'dd '(VEC v) (cadr e)) g)
          (#t (bff-dt! e) (dk-cite! 'subset-mem-fwd 'dd '(VEC v) e) g))))
(define (bff-ct! c)
  (let ((g (list 'IN c 'CC)))
    (cond ((dk-asm? g) g)
          ((and (pair? c) (equal? (car c) '(IP v)))
           (bff-vv! (cadr c)) (bff-vv! (caddr c)) (dk-cite! 'cips-ip-type 'v (cadr c) (caddr c)) g)
          ((and (pair? c) (eq? (car c) 'q) (= (length c) 3))
           (bff-dt! (cadr c)) (bff-dt! (caddr c))
           (dk-have! g (lambda ()
             (dk-cite! 'pair-in-cartesian 'dd 'dd (cadr c) (caddr c))
             (dk-cite! 'fun-apply-type-c 'q '(CARTESIAN dd dd) 'CC (list 'LIST (cadr c) (caddr c)))
             (subst (dk-cite! 'apply-tupling-2 'q (cadr c) (caddr c)))
             (dk-ass!)))
           g)
          ((and (pair? c) (memq (car c) '(+ *)) (= (length c) 3))
           (bff-ct! (cadr c)) (bff-ct! (caddr c))
           (dk-have! (list 'AND (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC)) (lambda () (dk-conj-close! dk-ass!)))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) g)
          (#t (dk-have! g (lambda () (type-term))) g))))
;;; q(z, z) and <z | z> in RR and >= 0, z in dd
(define (bff-real-facts! z)
  (bff-vv! z)
  (if (not (dk-asm? (list 'IN (bff-qq z) 'RR))) (dk-split! (dk-apply! bff-q-pos z)))
  (dk-cite! 'cips-ip-self-real 'v z)
  (dk-cite! 'cips-ip-self-nonneg 'v z)
  (let ((s (list '+ (bff-qq z) (bff-ii z))))
    (if (not (dk-asm? (list 'IN s 'RR))) (dk-cite! 'rr-add-in-rr (bff-qq z) (bff-ii z)))
    s))
(define (bff-sum-nonneg! z)               ; 0 <= Q(z,z) + <z|z>, and sqrt of it typed
  (let ((s (bff-real-facts! z)))
    (if (not (dk-asm? (list '<= 0 s)))
        (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN (bff-qq z) 'RR) (list 'IN (bff-ii z) 'RR)
                                                     (list '<= 0 (bff-qq z)) (list '<= 0 (bff-ii z))))))
    (bff-and! (list 'IN s 'RR) (list '<= 0 s))
    (if (not (dk-asm? (list 'IN (list 'SQRT s) 'RR))) (dk-split! (dk-cite! 'sqrt-nonneg s)))
    s))
(define (bff-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
;;; the points peeled into dd, in order
(define (bff-peel-pts!)
  (reverse (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (eq? (caddr f) 'dd))) (dk-peel!)))))

;;; ---- the read-offs ---------------------------------------------------------------------------
(define (bff-read-off! name acc mwf-ro mod-ro val)   ; opens its proof through dk-sp-qed! (certified loader)
  (dk-sp-qed! (make-wff (forall-guarded '(v dd q) bff-H (list '== (list acc bff-FPS) val)))
    (lambda ()
      (dk-peel!)
      (bff-base!)
      (subst (dk-cite! 'form-plus-space-as-module-with-form 'v 'dd 'q))
      (subst (dk-cite! mwf-ro bff-M bff-FP))
      (if mod-ro (subst (dk-cite! mod-ro 'v 'dd)))
      (if (bff-open?) (qrfl))
      (if (not (proof-done? *ps*)) (bff-dump!)))
    name)
  (topic! name 'analysis))
(bff-read-off! 'form-plus-space-vec 'VEC 'module-with-form-vec 'form-plus-module-vec 'dd)
(bff-read-off! 'form-plus-space-ip 'IP 'module-with-form-ip #f bff-FP)
(bff-read-off! 'form-plus-space-vadd 'VADD 'module-with-form-vadd 'form-plus-module-vadd
  '(VNB-LAMBDA (LIST tsbx_ tsby_) (CARTESIAN dd dd) ((VADD v) tsbx_ tsby_)))
(bff-read-off! 'form-plus-space-vneg 'VNEG 'module-with-form-vneg 'form-plus-module-vneg
  '(VNB-LAMBDA tsbx_ dd ((VNEG v) tsbx_)))

;;; the operations at points of dd
(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  '(= ((IP (FORM-PLUS-SPACE v dd q)) bfx_ bfy_) (+ (q bfx_ bfy_) ((IP v) bfx_ bfy_))))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-base!)
  (subst (dk-cite! 'form-plus-space-ip 'v 'dd 'q))
  (mac 'FORM-PLUS)
  (dk-lam-b!)
  (bff-ct! (list '+ (list 'q x y) (list '(IP v) x y)))
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'form-plus-space-ip-apply)

(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  '(= ((VADD (FORM-PLUS-SPACE v dd q)) bfx_ bfy_) ((VADD v) bfx_ bfy_)))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-base!)
  (subst (dk-cite! 'form-plus-space-vadd 'v 'dd 'q))
  (dk-lam-b!)
  (bff-vv! x) (bff-vv! y) (bff-vv! (list '(VADD v) x y))
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'form-plus-space-vadd-apply)

(sp (make-wff (forall-guarded '(v dd q bfx_) (append bff-H '((IN bfx_ dd)))
  '(= ((VNEG (FORM-PLUS-SPACE v dd q)) bfx_) ((VNEG v) bfx_)))))
(let* ((x (car (bff-peel-pts!))))
  (bff-base!)
  (subst (dk-cite! 'form-plus-space-vneg 'v 'dd 'q))
  (dk-lam-b!)
  (bff-vv! (list '(VNEG v) x))
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'form-plus-space-vneg-apply)

;;; (IN x (VEC FPS)) from (IN x dd)
(define (bff-in-fps! x)
  (let ((g (list 'IN x (list 'VEC bff-FPS))))
    (if (not (dk-asm? g))
        (begin (bff-dt! x)
               (dk-cite! 'form-plus-space-vec 'v 'dd 'q)
               (dk-have! g (lambda () (subst (list '= (list 'VEC bff-FPS) 'dd)) (ass)))))
    g))

;;; d+(x, y) = sqrt(Q(z, z) + <z | z>),  z = x - y
(define bff-Z '((VADD v) bfx_ ((VNEG v) bfy_)))
(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  (list '= (bff-dp 'bfx_ 'bfy_) (list 'SQRT (list '+ (bff-qq bff-Z) (bff-ii bff-Z)))))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)) (ny (list '(VNEG v) y)) (z (bff-sub x y)))
  (bff-base!)
  (bff-in-fps! x) (bff-in-fps! y)
  (subst (dk-cite! 'ip-metric-space-dist bff-FPS x y))
  (subst (dk-cite! 'form-plus-space-vneg-apply 'v 'dd 'q y))
  (bff-dt! ny)
  (subst (dk-cite! 'form-plus-space-vadd-apply 'v 'dd 'q x ny))
  (bff-dt! z)
  (subst (dk-cite! 'form-plus-space-ip-apply 'v 'dd 'q z z))
  (bff-sum-nonneg! z)
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'form-plus-space-dist)

;;; the three comparisons of d (in H), sqrt Q and d+ (in H_Q+)
(define (bff-dist-open! x y)
  (let ((z (bff-sub x y)))
    (bff-dt! x) (bff-dt! y) (bff-dt! z)
    (subst (dk-cite! 'form-plus-space-dist 'v 'dd 'q x y))
    (if (dk-contains? (dk-goal) (bff-dv x y))
        (begin (bff-vv! x) (bff-vv! y) (subst (dk-cite! 'ip-metric-space-dist 'v x y))))
    (bff-real-facts! z)
    z))
(define (bff-sqrt-mono! a b)
  (bff-and! (list 'IN a 'RR) (list '<= 0 a))
  (bff-and! (list 'IN b 'RR) (list '<= a b))
  (dk-cite! 'sqrt-mono a b))

(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  (list '<= (bff-dv 'bfx_ 'bfy_) (bff-dp 'bfx_ 'bfy_)))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-base!)
  (let* ((z (bff-dist-open! x y)) (a (bff-ii z)) (s (list '+ (bff-qq z) a)))
    (dk-have! (list '<= a s) (lambda () (dk-ineq! (list 'IN (bff-qq z) 'RR) (list 'IN a 'RR) (list '<= 0 (bff-qq z)))))
    (bff-sqrt-mono! a s)
    (dk-close-if-asm!)))
(bff-qed! 'form-plus-space-dist-ge)

(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  (list '<= (list 'SQRT (bff-qq bff-Z)) (bff-dp 'bfx_ 'bfy_)))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-base!)
  (let* ((z (bff-dist-open! x y)) (a (bff-qq z)) (s (list '+ a (bff-ii z))))
    (dk-have! (list '<= a s) (lambda () (dk-ineq! (list 'IN (bff-ii z) 'RR) (list 'IN a 'RR) (list '<= 0 (bff-ii z)))))
    (bff-sqrt-mono! a s)
    (dk-close-if-asm!)))
(bff-qed! 'form-plus-space-form-le)

(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd)))
  (list '<= (bff-dp 'bfx_ 'bfy_) (list '+ (list 'SQRT (bff-qq bff-Z)) (bff-dv 'bfx_ 'bfy_))))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-base!)
  (let* ((z (bff-dist-open! x y)))
    (dk-cite! 'rr-sqrt-add-le (bff-qq z) (bff-ii z))
    (dk-close-if-asm!)))
(bff-qed! 'form-plus-space-dist-le)
;;; ---- PART B: Proposition 3.16 -- Q closed iff H_Q+ is a Hilbert space ------------------------
(define (bff-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (bff-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
;;; the eps-clauses of IS-CAUCHY-SEQ and CONVERGES-TO, literally (metric-completeness.scm)
(define (bff-cauchy-clause s f)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'N (list 'AND '(IN N NN)
      (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
        (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
          (list 'IMPLIES '(AND (<= N m) (<= N n_))
            (list '<= (list (list 'DIST s) (list f 'm) (list f 'n_)) 'eps)))))))))))
(define (bff-conv-clause s f l)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'N (list 'AND '(IN N NN)
      (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
        (list 'IMPLIES '(<= N n_)
          (list '<= (list (list 'DIST s) (list f 'n_) l) 'eps)))))))))
;;; apply an in-context eps-clause at E: skolemise its N; return (N . the universal that landed)
(define (bff-eventually! clause e)
  (let* ((ex (dk-apply! clause e))
         (n #f)
         (landed (dk-landed (lambda () (set! n (dk-skolem! ex))))))
    (cons n (or (find-first (dk-head? 'FORALL) landed)
                (error "bff-eventually!: no universal landed" (map expression->string landed))))))
;;; the projections of the hypotheses
(define (bff-pre!)
  (if (and (dk-asm? '(IS-HILBERT-SPACE v)) (not (dk-asm? '(IS-COMPLEX-INNER-PRODUCT-SPACE v))))
      (dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE v) 'is-hilbert-space '(IS-HILBERT-SPACE v)))
  (if (and (dk-asm? '(IS-HILBERT-SPACE v)) (not (dk-asm? (list 'IS-COMPLETE bff-MV))))
      (dk-cite! 'hilbert-space-complete 'v))
  (if (and (dk-asm? '(IS-CLOSED-FORM v dd q)) (not (dk-asm? '(IS-POSITIVE-FORM v dd q))))
