;;; ---- the sequence arguments of Proposition 3.16 ----------------------------------------------
(define (bff-fd! f j)                     ; f(j) in dd, f in FUN(NN, dd), j in NN
  (if (not (dk-asm? (list 'IN (list f j) 'dd))) (dk-cite! 'fun-apply-type-c f 'NN 'dd j))
  (list f j))
(define (bff-flat e) (if (pair? e) (append-map bff-flat e) (list e)))
(define (bff-by-goal vs)                  ; VS ordered by first occurrence in the focus goal
  (let ((fl (bff-flat (dk-goal))))
    (define (pos v) (let loop ((l fl) (k 0)) (cond ((null? l) 100000) ((eq? (car l) v) k) (#t (loop (cdr l) (+ k 1))))))
    (sort vs (lambda (a b) (< (pos a) (pos b))))))
(define (bff-nn-vars ls)                  ; the NN typings among the landings, in goal order
  (bff-by-goal (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (symbol? (cadr x)) (eq? (caddr x) 'NN))) ls))))
(define (bff-pos-parts! e)                ; e in RR, 0 < e, 0 <= e from POS-RR e
  (dk-cite! 'rr-pos-rr-in-rr e)
  (dk-cite! 'rr-lt-of-pos-rr e)
  (if (not (dk-asm? (list '<= 0 e)))
      (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list 'IN e 'RR) (list '< 0 e))))))
(define (bff-sq-pos! h)                   ; POS-RR(h h) from POS-RR h
  (let ((hh (list '* h h)))
    (bff-pos-parts! h)
    (dk-cite! 'rr-mul-in-rr h h)
    (dk-cite! 'rr-mul-pos h h)
    (dk-cite! 'rr-pos-rr-of-lt hh)
    hh))
(define (bff-sqrt-parts! e)               ; s = sqrt e: POS-RR s, s in RR, 0 <= s, s s = e
  (let ((s (list 'SQRT e)))
    (bff-pos-parts! e)
    (dk-cite! 'rr-sqrt-pos-rr e)
    (bff-pos-parts! s)
    (bff-and! (list 'IN e 'RR) (list '<= 0 e))
    (dk-cite! 'sqrt-sq e)
    s))
(define (bff-ft-plus! fd f)               ; f in FUN(NN, PTS MS+) from f in FUN(NN, dd)
  (let ((g (list 'IN f (list 'FUN 'NN (list 'PTS bff-MS)))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (list 'PTS bff-MS) (list 'VEC bff-FPS)))
                               (subst (list '= (list 'VEC bff-FPS) 'dd)) (ass))))
    g))
(define (bff-ft-v! f)                     ; f in FUN(NN, PTS MV) from f in FUN(NN, dd)
  (let ((g (list 'IN f (list 'FUN 'NN (list 'PTS bff-MV)))))
    (if (not (dk-asm? g))
        (let ((fv (dk-cite! 'fun-codomain-superset f 'NN 'dd '(VEC v))))
          (dk-rewrite-h! fv '(VEC v) (list 'PTS bff-MV))))
    g))
(define (bff-pt-plus! x)                  ; x in PTS MS+ from x in dd
  (let ((g (list 'IN x (list 'PTS bff-MS))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (list 'PTS bff-MS) (list 'VEC bff-FPS)))
                               (subst (list '= (list 'VEC bff-FPS) 'dd)) (ass))))
    g))
(define (bff-pt-v! x)                     ; x in PTS MV from x in dd
  (let ((g (list 'IN x (list 'PTS bff-MV))))
    (if (not (dk-asm? g))
        (begin (bff-vv! x)
               (dk-have! g (lambda () (subst (list '= (list 'PTS bff-MV) '(VEC v))) (ass)))))
    g))
;;; instantiate an in-context universal F at TERMS, detaching every antecedent in context
(define (bff-inst! f . terms)
  (let loop ((r (apply inst*! f terms)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
        (loop (dk-landed-1 (lambda () (detach! r))))
        r)))
;;; close a goal (FORSOME n (AND (IN n NN) BODY)) at the witness N; BODY by the thunk
(define (bff-witness! n body!)
  (ew n)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (body!)))))

;;; Q closed: a Cauchy sequence of H_Q+ converges in H_Q+
(sp (make-wff (forall-guarded '(v dd q bfs_) (list '(IS-HILBERT-SPACE v) '(IS-CLOSED-FORM v dd q) (list 'IS-CAUCHY-SEQ bff-MS 'bfs_))
  (list 'CONVERGES bff-MS 'bfs_))))
(let* ((ls (dk-peel!))
       (f (caddr (find-first (dk-head? 'IS-CAUCHY-SEQ) ls))))
  (bff-pre!)
  (let* ((ft (dk-cite! 'cauchy-seq-is-fun bff-MS f))
         (ft2 (dk-rewrite-h! ft (list 'PTS bff-MS) (list 'VEC bff-FPS)))
         (fd (dk-rewrite-h! ft2 (list 'VEC bff-FPS) 'dd))
         (fv (bff-ft-v! f))
         (pcc (begin (bff-iff-fwd! 'is-cauchy-seq bff-MS f) (bff-cauchy-clause bff-MS f))))
    ;; H-Cauchy, dominated by d+
    (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list '<= (bff-dv (list f 'm) (list f 'n_)) (bff-dp (list f 'm) (list f 'n_)))))))
      (lambda ()
        (let* ((ks (bff-nn-vars (dk-peel!))) (a (bff-fd! f (car ks))) (b (bff-fd! f (cadr ks))))
          (dk-cite! 'form-plus-space-dist-ge 'v 'dd 'q a b)
          (dk-close-if-asm!))))
    (dk-cite! 'ms-cauchy-of-dominated bff-MS bff-MV f f)
    (dk-cite! 'complete-cauchy-converges bff-MV f)
    (let* ((c1 (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES bff-MV f))))))
           (x (dk-skolem! c1))
           (hcv (begin (bff-iff-fwd! 'converges-to bff-MV f x) (bff-conv-clause bff-MV f x)))
           (cl (begin (bff-iff-fwd! 'is-closed-form 'v 'dd 'q)
                      (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CONVERGES-TO))) "the closedness clause")))
           (r (bff-inst! cl f x)))
      (if (not (dk-head-is? r 'IMPLIES)) (error "bff: closedness clause did not detach to the Q-Cauchy antecedent" (expression->string r)))
      ;; Q-Cauchy, from H_Q+-Cauchy at sqrt(eps)
      (dk-have! (cadr r)
        (lambda ()
          (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                 (s (bff-sqrt-parts! e))
                 (ni (bff-eventually! pcc s)) (n (car ni)) (inner (cdr ni)))
            (bff-witness! n
              (lambda ()
                (let* ((ls2 (dk-peel!)) (ks (bff-nn-vars ls2)) (m (car ks)) (k (cadr ks)))
                  (bff-and! (list '<= n m) (list '<= n k))
                  (dk-apply! inner m k)
                  (bff-fd! f m) (bff-fd! f k)
                  (dk-cite! 'form-plus-space-small-form 'v 'dd 'q (list f m) (list f k) s)
                  (subst (list '= e (list '* s s)))
                  (dk-close-if-asm!)))))))
      (detach! r)
      (dk-split! (caddr r))
      (let ((qcv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'magnitude) (dk-contains? h x))) "Q-convergence")))
        (bff-pt-plus! x)
        (bff-ft-plus! fd f)
        (dk-have! (bff-conv-clause bff-MS f x)
          (lambda ()
            (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                   (h (dk-halve! e))
                   (hh (bff-sq-pos! h))
                   (n1i (bff-eventually! qcv hh)) (n1 (car n1i))
                   (n2i (bff-eventually! hcv h)) (n2 (car n2i))
                   (nn (list '+ n1 n2)))
              (bff-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
              (dk-cite! 'nn-add-closed n1 n2)
              (bff-witness! nn
                (lambda ()
                  (let* ((ls2 (dk-peel!)) (j (car (bff-nn-vars ls2))))
                    (dk-have! (list '<= n1 j) (lambda () (dk-nn! (list '<= nn j))))
                    (dk-have! (list '<= n2 j) (lambda () (dk-nn! (list '<= nn j))))
                    (dk-apply! (cdr n1i) j)
                    (dk-apply! (cdr n2i) j)
                    (bff-fd! f j)
                    (dk-cite! 'form-plus-space-small-dist 'v 'dd 'q (list f j) x h)
                    (subst (list '= e (list '+ h h)))
                    (dk-close-if-asm!)))))))
        (bff-iff-bwd! 'converges-to bff-MS f x)
        (mac 'converges)
        (ew x)
        (dk-close-if-asm!)))))
(bff-qed! 'form-closed-plus-cauchy-converges)

;;; H_Q+ a Hilbert space: Q is closed
(sp (make-wff (forall-guarded '(v dd q) (list '(IS-HILBERT-SPACE v) '(IS-POSITIVE-FORM v dd q) (list 'IS-HILBERT-SPACE bff-FPS))
  '(IS-CLOSED-FORM v dd q))))
(dk-peel!)
(bff-pre!)
(dk-cite! 'hilbert-space-complete bff-FPS)
(let* ((iff (dk-cite! 'is-closed-form 'v 'dd 'q))
       (clause (caddr (caddr iff))))
  (dk-have! clause
    (lambda ()
      (let* ((ls (dk-peel!))
             (fd (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) ls))
             (f (cadr fd))
             (x (cadddr (find-first (dk-head? 'CONVERGES-TO) ls)))
             (qc (find-first (dk-head? 'FORALL) ls)))
        (bff-ft-plus! fd f)
        (bff-ft-v! f)
        (dk-cite! 'metric-converges-to-cauchy bff-MV f x)
        (bff-iff-fwd! 'is-cauchy-seq bff-MV f)
        (let ((hcc (bff-cauchy-clause bff-MV f)))
          ;; Cauchy in H_Q+
          (dk-have! (bff-cauchy-clause bff-MS f)
            (lambda ()
              (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                     (h (dk-halve! e))
                     (hh (bff-sq-pos! h))
                     (n1i (bff-eventually! qc hh)) (n1 (car n1i))
                     (n2i (bff-eventually! hcc h)) (n2 (car n2i))
                     (nn (list '+ n1 n2)))
                (bff-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
                (dk-cite! 'nn-add-closed n1 n2)
                (bff-witness! nn
                  (lambda ()
                    (let* ((ls2 (dk-peel!)) (ks (bff-nn-vars ls2)) (m (car ks)) (k (cadr ks))
                           (andf (find-first (dk-head? 'AND) ls2)))
                      (if andf (dk-split! andf))
                      (for-each (lambda (b) (for-each (lambda (j) (dk-have! (list '<= b j) (lambda () (dk-nn! (list '<= nn j)))))
                                                      (list m k)))
                                (list n1 n2))
                      (dk-apply! (cdr n1i) m k)
                      (bff-and! (list '<= n2 m) (list '<= n2 k))
                      (dk-apply! (cdr n2i) m k)
                      (bff-fd! f m) (bff-fd! f k)
                      (dk-cite! 'form-plus-space-small-dist 'v 'dd 'q (list f m) (list f k) h)
                      (subst (list '= e (list '+ h h)))
                      (dk-close-if-asm!))))))))
        (bff-iff-bwd! 'is-cauchy-seq bff-MS f)
        (dk-cite! 'complete-cauchy-converges bff-MS f)
        (let* ((c1 (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES bff-MS f))))))
               (y (dk-skolem! c1))
               (pcv (begin (bff-iff-fwd! 'converges-to bff-MS f y) (bff-conv-clause bff-MS f y)))
               (yd (dk-rewrite-h! (dk-rewrite-h! (list 'IN y (list 'PTS bff-MS)) (list 'PTS bff-MS) (list 'VEC bff-FPS))
                                  (list 'VEC bff-FPS) 'dd)))
          (bff-pt-v! y)
          (dk-have! '(IN 1 RR) (lambda () (arith)))
          (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
          (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                      (list '<= (bff-dv (list f 'n_) y) (list '* 1 (bff-dp (list f 'n_) y)))))
            (lambda ()
              (let* ((j (car (bff-nn-vars (dk-peel!)))) (a (bff-fd! f j)))
                (dk-cite! 'form-plus-space-dist-ge 'v 'dd 'q a y)
                (bff-dp-typed! a y)
                (bff-dv-typed! a y)
                (dk-ineq! (list 'IN (bff-dp a y) 'RR) (list 'IN (bff-dv a y) 'RR)
                          (list '<= (bff-dv a y) (bff-dp a y))))))
          (dk-cite! 'ms-converges-of-scaled bff-MV bff-MS f f y y 1)
          (dk-cite! 'metric-limit-unique bff-MV f x y)
          (dk-conj-close!
            (lambda ()
              (subst (list '= x y))
              (if (dk-asm? (dk-goal))
                  (ass)
                  (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                         (s (bff-sqrt-parts! e))
                         (ni (bff-eventually! pcv s)) (n (car ni)))
                    (bff-witness! n
                      (lambda ()
                        (let* ((j (car (bff-nn-vars (dk-peel!)))))
                          (dk-apply! (cdr ni) j)
                          (bff-fd! f j)
                          (dk-cite! 'form-plus-space-small-form 'v 'dd 'q (list f j) y s)
                          (subst (list '= e (list '* s s)))
                          (dk-close-if-asm!))))))))))))
  (bff-iff-bwd! 'is-closed-form 'v 'dd 'q)
  (dk-close-if-asm!))
(bff-qed! 'form-plus-hilbert-closed)

;;; PROPOSITION 3.16
(sp (make-wff (forall-guarded '(v dd q) (list '(IS-HILBERT-SPACE v) '(IS-POSITIVE-FORM v dd q))
  (list 'IFF '(IS-CLOSED-FORM v dd q) (list 'IS-HILBERT-SPACE bff-FPS)))))
(dk-peel!)
(bff-pre!)
(dk-iff! (dk-head? 'IS-HILBERT-SPACE)
  (lambda ()
    (bff-pre!)
    (dk-have! (list 'FORALL 'f (list 'IMPLIES (list 'IS-CAUCHY-SEQ bff-MS 'f) (list 'CONVERGES bff-MS 'f)))
      (lambda ()
        (let ((f (caddr (find-first (dk-head? 'IS-CAUCHY-SEQ) (dk-peel!)))))
          (dk-cite! 'form-closed-plus-cauchy-converges 'v 'dd 'q f)
          (dk-close-if-asm!))))
    (bff-iff-bwd! 'is-complete bff-MS)
    (bff-iff-bwd! 'is-hilbert-space bff-FPS)
    (dk-close-if-asm!))
  (lambda ()
    (dk-cite! 'form-plus-hilbert-closed 'v 'dd 'q)
    (dk-close-if-asm!)))
(bff-qed! 'form-closed-iff-hilbert)
;;; ---- PART D: Proposition 3.17 -- the operator of a closed positive form ----------------------
(define bff-T '(FORM-OPERATOR v dd q))
(define bff-ADJ '(GRAPH-ADJOINT v (FORM-OPERATOR v dd q)))
(define (bff-ip a b) (list '(IP v) a b))
(define (bff-pr a b) (list 'LIST a b))
(define (bff-peel-pts-of ls)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (eq? (caddr f) 'dd))) ls)))
(bff-read-off! 'form-plus-space-act 'ACT 'module-with-form-act 'form-plus-module-act
  '(VNB-LAMBDA (LIST tsbc_ tsbx_) (CARTESIAN CC dd) ((ACT v) tsbc_ tsbx_)))
(sp (make-wff (forall-guarded '(v dd q bfc_ bfx_) (append bff-H '((IN bfc_ CC) (IN bfx_ dd)))
  '(= ((ACT (FORM-PLUS-SPACE v dd q)) bfc_ bfx_) ((ACT v) bfc_ bfx_)))))
(let* ((ls (dk-peel!)) (x (car (bff-peel-pts-of ls))) (c 'bfc_))
  (bff-base!)
  (subst (dk-cite! 'form-plus-space-act 'v 'dd 'q))
  (dk-lam-b!)
  (bff-vv! x)
  (dk-cite! 'cips-act-type 'v c x)
  (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'form-plus-space-act-apply)

;;; ||x|| <= ||x||_+
(sp (make-wff (forall-guarded '(v dd q bfx_) (append bff-H '((IN bfx_ dd)))
  (list '<= '(IP-NORM v bfx_) (list 'IP-NORM bff-FPS 'bfx_)))))
(let* ((x (car (bff-peel-pts!))))
  (bff-base!)
  (subst (dk-cite! 'ip-norm-unfold 'v x))
  (subst (dk-cite! 'ip-norm-unfold bff-FPS x))
  (subst (dk-cite! 'form-plus-space-ip-apply 'v 'dd 'q x x))
  (let* ((s (bff-real-facts! x)) (a (bff-ii x)))
    (dk-have! (list '<= a s) (lambda () (dk-ineq! (list 'IN (bff-qq x) 'RR) (list 'IN a 'RR) (list '<= 0 (bff-qq x)))))
    (bff-sqrt-mono! a s)
    (dk-close-if-asm!)))
(bff-qed! 'form-plus-space-norm-ge)

;;; membership of a pair in T_Q, read off and established
(define (bff-pair-out! c d)            ; [c, d] in T_Q in context: land c in dd and its clause; return the clause
  (bff-vv-pair! c d)
  (let ((iff (dk-cite! 'form-operator-pair-iff 'v 'dd 'q c d)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (dk-split! (caddr iff))
    (caddr (caddr iff))))
(define (bff-pair-in! c d clause-prover!)   ; prove [c, d] in T_Q from c in dd (in context) and the clause
  (bff-vv-pair! c d)
  (let* ((iff (dk-cite! 'form-operator-pair-iff 'v 'dd 'q c d))
         (cl (caddr (caddr iff))))
    (dk-have! cl clause-prover!)
    (bff-and! (cadr (caddr iff)) cl)
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
(define (bff-has-lam? g)
  (and (pair? g) (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
                     (let loop ((l g)) (and (pair? l) (or (bff-has-lam? (car l)) (loop (cdr l))))))))
(define (bff-vv-pair! c d) (bff-vv! c) (bff-vv! d))
(define (bff-adj-out! gg c d)          ; [c, d] in G* in context: land and return the adjoint clause
  (bff-vv-pair! c d)
  (let ((iff (dk-cite! 'graph-adjoint-pair-iff 'v gg c d)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (caddr iff)))
(define (bff-vec-vars ls)
  (bff-by-goal (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (symbol? (cadr x)) (equal? (caddr x) '(VEC v)))) ls))))

;;; T_Q is symmetric
(sp (make-wff (forall-guarded '(v dd q) bff-H (list 'IS-SYMMETRIC-GRAPH 'v bff-T))))
(dk-peel!)
(bff-base!)
(mac 'is-symmetric-graph)
(dk-cite! 'form-operator-subset 'v 'dd 'q)
(dk-have! (list 'FORALL 'ugc_ (list 'IMPLIES '(IN ugc_ (VEC v)) (list 'FORALL 'ugd_ (list 'IMPLIES '(IN ugd_ (VEC v))
            (list 'IMPLIES (list 'IN '(LIST ugc_ ugd_) bff-T) (list 'IN '(LIST ugc_ ugd_) bff-ADJ))))))
  (lambda ()
    (let* ((ls (dk-peel!)) (cd (bff-vec-vars ls)) (c (car cd)) (d (cadr cd))
           (c1 (bff-pair-out! c d))
           (iff (dk-cite! 'graph-adjoint-pair-iff 'v bff-T c d))
           (rhs (caddr iff)))
      (dk-have! rhs
        (lambda ()
          (let* ((ls2 (dk-peel!)) (ab (bff-vec-vars ls2)) (a (car ab)) (b (cadr ab))
                 (c2 (bff-pair-out! a b)))
            (bff-dt! a) (bff-dt! c)
            (subst (dk-apply! c1 a))
            (subst (dk-cite! 'cips-ip-conj-sym 'v c b))
            (subst (dk-apply! c2 c))
            (subst (dk-apply! bff-q-herm c a))
            (bff-ct! (list 'q c a))
            (dk-cite! 'cc-conjugate-closed (list 'q c a))
            (dk-close-if! (lambda () #t) (lambda () (rfl))))))
      (ai iff)
      (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
      (dk-close-if-asm!))))
(dk-cite! 'relation-pair-subset '(VEC v) '(VEC v) bff-T bff-ADJ)
(dk-close-if-asm!)
(bff-qed! 'form-operator-symmetric)

;;; T_Q is positive: <xi | T_Q xi> = Q(xi, xi) >= 0
(sp (make-wff (forall-guarded '(v dd q bfc_ bfd_) (append bff-H '((IN bfc_ (VEC v)) (IN bfd_ (VEC v))))
  (list 'IMPLIES (list 'IN '(LIST bfc_ bfd_) bff-T)
        '(AND (IN ((IP v) bfc_ bfd_) RR) (<= 0 ((IP v) bfc_ bfd_)))))))
(dk-peel!)
(bff-base!)
(let ((c1 (bff-pair-out! 'bfc_ 'bfd_)))
  (subst (dk-apply! c1 'bfc_))
  (dk-split! (dk-apply! bff-q-pos 'bfc_))
  (dk-conj-close! dk-ass!))
(bff-qed! 'form-operator-positive)

;;; a CC identity: a = p - c and (a + c) - e = r - e give p = r
(sp (make-wff '(FORALL bfa_ (IMPLIES (IN bfa_ CC) (FORALL bfp_ (IMPLIES (IN bfp_ CC) (FORALL bfc_ (IMPLIES (IN bfc_ CC)
  (FORALL bfr_ (IMPLIES (IN bfr_ CC) (FORALL bfe_ (IMPLIES (IN bfe_ CC)
    (IMPLIES (= bfa_ (+ bfp_ (- bfc_)))
      (IMPLIES (= (+ (+ bfa_ bfc_) (- bfe_)) (+ bfr_ (- bfe_)))
        (= bfp_ bfr_)))))))))))))))
(dk-peel!)
(dk-have! '(= bfp_ (+ bfa_ bfc_)) (lambda () (subst '(= bfa_ (+ bfp_ (- bfc_)))) (crs)))
(dk-have! '(= bfr_ (+ (+ (+ bfa_ bfc_) (- bfe_)) bfe_))
  (lambda () (subst '(= (+ (+ bfa_ bfc_) (- bfe_)) (+ bfr_ (- bfe_)))) (crs)))
(subst '(= bfr_ (+ (+ (+ bfa_ bfc_) (- bfe_)) bfe_)))
(subst '(= bfp_ (+ bfa_ bfc_)))
(crs)
(bff-qed! 'cc-sub-cancel-eq)

;;; I + T_Q is onto: every phi is (I + T_Q) e for some e in dom Q (Riesz in H_Q+)
(define bff-F '(VNB-LAMBDA bfw_ dd ((IP v) bfw_ bfp_)))
(sp (make-wff (forall-guarded '(v dd q bfp_) (list '(IS-HILBERT-SPACE v) '(IS-CLOSED-FORM v dd q) '(IN bfp_ (VEC v)))
  (list 'FORSOME 'bfe_ (list 'AND '(IN bfe_ dd) (list 'IN '(LIST bfe_ ((VADD v) bfp_ ((VNEG v) bfe_))) bff-T))))))
(dk-peel!)
(bff-pre!)
(let ((iff (dk-cite! 'form-closed-iff-hilbert 'v 'dd 'q)))
  (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))))
(let* ((phi 'bfp_) (fps bff-FPS) (vf (list 'VEC fps)))
  ;; the functional x |-> <x | phi> on H_Q+
  (dk-have! (list 'IS-CC-LINEAR-FUNCTIONAL fps bff-F)
    (lambda ()
      (mac 'is-cc-linear-functional)
      (subst (list '= vf 'dd))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-head-is? g 'IN)                            ; the typing
               (dk-lam-type! (lambda ()
                               (if (memq (dk-head (dk-goal)) '(FORALL IMPLIES)) (dk-peel!))
                               (if (bff-has-lam? (dk-goal)) (dk-lam-b!))
                               (let ((w (cadr (cadr (dk-goal)))))
                                 (bff-ct! (bff-ip w phi))
                                 (dk-close-if-asm!)))))
              ((dk-contains? g '(ACT (FORM-PLUS-SPACE v dd q)))   ; homogeneity
               (let* ((ls (dk-peel!)) (x (car (bff-peel-pts-of ls)))
                      (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'CC))) ls))))
                 (subst (dk-cite! 'form-plus-space-act-apply 'v 'dd 'q c x))
                 (bff-cscal! c)
                 (bff-dt! (list '(ACT v) c x))
                 (dk-lam-b!)
                 (bff-vv! x)
                 (subst (dk-cite! 'cips-ip-homog-left 'v c x phi))
                 (bff-ct! (list '* c (bff-ip x phi)))
                 (dk-close-if! (lambda () #t) (lambda () (rfl)))))
              (#t                                             ; additivity
               (let* ((ls (dk-peel!)) (xy (bff-by-goal (bff-peel-pts-of ls))) (x (car xy)) (y (cadr xy)))
                 (subst (dk-cite! 'form-plus-space-vadd-apply 'v 'dd 'q x y))
                 (bff-dt! (list '(VADD v) x y))
                 (dk-lam-b!)
                 (bff-vv! x) (bff-vv! y)
                 (subst (dk-cite! 'cips-ip-add-left 'v x y phi))
                 (bff-ct! (list '+ (bff-ip x phi) (bff-ip y phi)))
                 (dk-close-if! (lambda () #t) (lambda () (rfl)))))))))))
  ;; bounded by ||phi|| in the norm of H_Q+
  (let ((m (list 'IP-NORM 'v phi)))
    (dk-cite! 'ip-norm-in-rr 'v phi)
    (dk-cite! 'ip-norm-nonneg 'v phi)
    (dk-have! (list 'FORALL 'bcx_ (list 'IMPLIES (list 'IN 'bcx_ vf)
                (list '<= (list 'magnitude (list bff-F 'bcx_)) (list '* m (list 'IP-NORM fps 'bcx_)))))
      (lambda ()
        (let* ((ls (dk-peel!)) (xf (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) vf))) ls))
               (x (cadr xf)))
          (dk-cite! 'form-plus-space-vec 'v 'dd 'q)
          (dk-rewrite-h! xf vf 'dd)
          (dk-lam-b!)
          (bff-vv! x)
          (let* ((nx (list 'IP-NORM 'v x)) (np (list 'IP-NORM fps x)) (mg (list 'magnitude (bff-ip x phi))))
            (dk-cite! 'cips-ip-magnitude-le 'v x phi)
            (dk-cite! 'form-plus-space-norm-ge 'v 'dd 'q x)
            (dk-cite! 'ip-norm-in-rr 'v x)
            (bff-in-fps! x)
            (dk-cite! 'ip-norm-in-rr fps x)
            (dk-cite! 'rr-mul-le-right nx np m)
            (dk-cite! 'rr-mul-in-rr nx m)
            (dk-cite! 'rr-mul-in-rr np m)
            (dk-cite! 'rr-mul-in-rr m np)
            (bff-ct! (bff-ip x phi))
            (dk-cite! 'cc-magnitude-closed (bff-ip x phi))
            (dk-have! (list '= (list '* np m) (list '* m np)) (lambda () (crs)))
            (dk-ineq! (list 'IN mg 'RR) (list 'IN (list '* nx m) 'RR) (list 'IN (list '* np m) 'RR) (list 'IN (list '* m np) 'RR)
                      (list '<= mg (list '* nx m)) (list '<= (list '* nx m) (list '* np m))
                      (list '= (list '* np m) (list '* m np)))))))
    (dk-cite! 'cc-functional-continuous-of-bound fps bff-F m))
  ;; Riesz in H_Q+
  (let* ((ex (dk-cite! 'riesz-representation-exists fps bff-F))
         (ls (dk-landed (lambda () (dk-skolem! ex))))
         (ef (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) vf))) ls))
         (e (cadr ef))
         (rz (find-first (dk-head? 'FORALL) ls))
         (w (list '(VADD v) phi (list '(VNEG v) e))))
    (dk-cite! 'form-plus-space-vec 'v 'dd 'q)
    (dk-rewrite-h! ef vf 'dd)
    (ew e)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin
              (bff-vv! w)
              (bff-pair-in! e w
                (lambda ()
                  (let* ((x (car (bff-peel-pts-of (dk-peel!)))))
                    (bff-in-fps! x)
                    (bff-vv! x) (bff-vv! e)
                    (let* ((r1 (dk-apply! rz x))
                           (fx (cadr r1)))
                      (dk-have! (list '= fx (bff-ip x phi)) (lambda () (dk-lam-b!) (bff-ct! (bff-ip x phi)) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                      (bff-vv! (list '(VNEG v) e))
                      (subst (dk-cite! 'cips-ip-add-right 'v x phi (list '(VNEG v) e)))
                      (subst (dk-cite! 'cips-ip-neg-right 'v x e))
                      (subst (list '= (bff-ip x phi) fx))
                      (subst r1)
                      (subst (dk-cite! 'form-plus-space-ip-apply 'v 'dd 'q x e))
                      (bff-ct! (list 'q x e)) (bff-ct! (bff-ip x e))
                      (crs)))))
              (dk-close-if-asm!)))))))
(bff-qed! 'form-operator-onto-plus)

;;; T_Q is self-adjoint
(define (bff-op? e) (and (pair? e) (member (car e) '((VADD v) (VNEG v))) #t))
(define (bff-expand-ip-h! h)          ; rewrite inside hypothesis H the IP of sums / negatives; return the result
  (let loop ((h h) (fuel 8))
    (let ((t (find-first (lambda (s) (and (pair? s) (equal? (car s) '(IP v)) (= (length s) 3)
                                          (or (bff-op? (cadr s)) (bff-op? (caddr s)))))
                         (dk-subterms h))))
      (if (or (not t) (= fuel 0))
          h
          (let* ((a (cadr t)) (b (caddr t))
                 (eq (cond ((and (pair? a) (equal? (car a) '(VADD v)))
                            (for-each bff-vv! (list (cadr a) (caddr a) b))
                            (dk-cite! 'cips-ip-add-left 'v (cadr a) (caddr a) b))
                           ((and (pair? a) (equal? (car a) '(VNEG v)))
                            (bff-vv! (cadr a)) (bff-vv! b)
                            (dk-cite! 'cips-ip-neg-left 'v (cadr a) b))
                           ((equal? (car b) '(VADD v))
                            (for-each bff-vv! (list a (cadr b) (caddr b)))
                            (dk-cite! 'cips-ip-add-right 'v a (cadr b) (caddr b)))
                           (#t (bff-vv! a) (bff-vv! (cadr b))
                               (dk-cite! 'cips-ip-neg-right 'v a (cadr b))))))
            (loop (dk-rewrite-h! h (cadr eq) (caddr eq)) (- fuel 1)))))))

(sp (make-wff (forall-guarded '(v dd q) (list '(IS-HILBERT-SPACE v) '(IS-CLOSED-FORM v dd q))
  (list 'IS-SELF-ADJOINT-GRAPH 'v bff-T))))
(dk-peel!)
(bff-pre!)
(mac 'is-self-adjoint-graph)
(dk-cite! 'form-operator-subset 'v 'dd 'q)
(dk-cite! 'graph-adjoint-subset 'v bff-T)
(dk-cite! 'form-operator-symmetric 'v 'dd 'q)
(dk-project! (list 'SUBSET bff-T bff-ADJ) 'is-symmetric-graph (list 'IS-SYMMETRIC-GRAPH 'v bff-T))
(dk-have! (list 'FORALL 'ugc_ (list 'IMPLIES '(IN ugc_ (VEC v)) (list 'FORALL 'ugd_ (list 'IMPLIES '(IN ugd_ (VEC v))
            (list 'IFF (list 'IN '(LIST ugc_ ugd_) bff-ADJ) (list 'IN '(LIST ugc_ ugd_) bff-T))))))
  (lambda ()
    (let* ((ls (dk-peel!)) (cd (bff-vec-vars ls)) (c (car cd)) (d (cadr cd)))
      (dk-iff! (lambda (g) (equal? (caddr g) bff-T))
        (lambda ()                                  ; [c, d] in T_Q* => [c, d] in T_Q
          (let* ((ac (bff-adj-out! bff-T c d))
                 (dc (list '(VADD v) d c))
                 (ex (begin (bff-vv! dc) (dk-cite! 'form-operator-onto-plus 'v 'dd 'q dc)))
                 (ls1 (dk-landed (lambda () (dk-skolem! ex))))
                 (e (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd))) ls1)))
                 (w (list '(VADD v) dc (list '(VNEG v) e)))
                 (ew-in (list 'IN (bff-pr e w) bff-T))
                 (cw (bff-pair-out! e w)))
            (dk-cite! 'subset-mem-fwd bff-T bff-ADJ (bff-pr e w))
            (let ((aw (bff-adj-out! bff-T e w)))
              ;; c = e
              (dk-have! (list 'FORALL 'hrx_ (list 'IMPLIES '(IN hrx_ (VEC v)) (list '= (bff-ip 'hrx_ c) (bff-ip 'hrx_ e))))
                (lambda ()
                  (let* ((psi (car (bff-vec-vars (dk-peel!))))
                         (ex2 (dk-cite! 'form-operator-onto-plus 'v 'dd 'q psi))
                         (ls2 (dk-landed (lambda () (dk-skolem! ex2))))
                         (xi (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd))) ls2)))
                         (u (list '(VADD v) psi (list '(VNEG v) xi))))
                    (bff-vv! xi) (bff-vv! u)
                    (let* ((h1 (bff-expand-ip-h! (bff-inst! ac xi u)))
                           (h2 (bff-expand-ip-h! (bff-inst! aw xi u))))
                      (for-each bff-ct! (list (bff-ip xi d) (bff-ip psi c) (bff-ip xi c) (bff-ip psi e) (bff-ip xi e)))
                      (dk-cite! 'cc-sub-cancel-eq (bff-ip xi d) (bff-ip psi c) (bff-ip xi c) (bff-ip psi e) (bff-ip xi e))
                      (dk-close-if-asm!)))))
              (bff-vv! e)
              (dk-cite! 'cips-ip-separates 'v c e)
              (dk-have! (list 'IN c 'dd) (lambda () (subst (list '= c e)) (ass)))
              (bff-pair-in! c d
                (lambda ()
                  (let* ((x (car (bff-peel-pts-of (dk-peel!))))
                         (h0 (bff-expand-ip-h! (dk-apply! cw x)))
                         (h1 (dk-rewrite-h! h0 c e)))
                    (subst (list '= c e))
                    (subst (list '= (list 'q x e) (cadr h1)))
                    (for-each bff-ct! (list (bff-ip x d) (bff-ip x e)))
                    (crs))))
              (dk-close-if-asm!))))
        (lambda ()                                  ; [c, d] in T_Q => [c, d] in T_Q*
          (dk-cite! 'subset-mem-fwd bff-T bff-ADJ (bff-pr c d))
          (dk-close-if-asm!))))))
(dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) bff-ADJ bff-T)
(dk-close-if-asm!)
(bff-qed! 'form-operator-self-adjoint)
;;; ---- PART E: Proposition 3.23 completed -- T*T for a closed operator T ----------------------
;;; T is a linear map ff on a dense submodule dd of a Hilbert space v; its graph is the SEP of
;;; adjoint-compose-form-operator (ba-graph-commutation.scm); Q(x, y) = <ff x | ff y> on dd.
(define bff-G '(SEP bgp_ (CARTESIAN (VEC v) (VEC v)) (AND (IN (NTH 1 bgp_) dd) (= (NTH 2 bgp_) (ff (NTH 1 bgp_))))))
(define bff-QF '(VNB-LAMBDA (LIST bgx_ bgy_) (CARTESIAN dd dd) ((IP v) (ff bgx_) (ff bgy_))))
(define bff-ADD '(FORALL bax_ (IMPLIES (IN bax_ dd) (FORALL bay_ (IMPLIES (IN bay_ dd)
                   (= (ff ((VADD v) bax_ bay_)) ((VADD v) (ff bax_) (ff bay_))))))))
(define bff-HOM '(FORALL bac_ (IMPLIES (IN bac_ CC) (FORALL bax_ (IMPLIES (IN bax_ dd)
                   (= (ff ((ACT v) bac_ bax_)) ((ACT v) bac_ (ff bax_))))))))
(define bff-LH (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-SUBMODULE v dd) '(IN ff (FUN dd (VEC v))) bff-ADD bff-HOM))
(define bff-LHH (list '(IS-HILBERT-SPACE v) '(IS-SUBMODULE v dd) '(IS-DENSE (IP-METRIC-SPACE v) dd)
                      '(IN ff (FUN dd (VEC v))) bff-ADD bff-HOM))
(define (bff-qfa a b) (list bff-QF a b))
(define (bff-ff a) (list 'ff a))
(define (bff-lin-pre!)                    ; CIPS v from the Hilbert hypothesis; dd subset VEC v
  (if (and (dk-asm? '(IS-HILBERT-SPACE v)) (not (dk-asm? '(IS-COMPLEX-INNER-PRODUCT-SPACE v))))
      (dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE v) 'is-hilbert-space '(IS-HILBERT-SPACE v)))
  (dk-cite! 'submodule-subset 'v 'dd)
  (if (not (dk-asm? '(IN dd SET)))
      (begin (dk-cite! 'cips-vec-set 'v) (dk-cite! 'subclass-of-set-is-set 'dd '(VEC v)))))

;;; Q(x, y) = <ff x | ff y>
(sp (make-wff (forall-guarded '(v dd ff bfx_ bfy_) (append bff-LH '((IN bfx_ dd) (IN bfy_ dd)))
  (list '= (bff-qfa 'bfx_ 'bfy_) (list '(IP v) '(ff bfx_) '(ff bfy_))))))
(let* ((xy (bff-peel-pts!)) (x (car xy)) (y (cadr xy)))
  (bff-lin-pre!)
  (bff-ct! (list '(IP v) (bff-ff x) (bff-ff y)))
  (if (not (dk-lam-b!)) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
(bff-qed! 'graph-form-value)

;;; ff(-y) = -ff(y)
(sp (make-wff (forall-guarded '(v dd ff bfy_) (append bff-LH '((IN bfy_ dd)))
  '(= (ff ((VNEG v) bfy_)) ((VNEG v) (ff bfy_))))))
(let* ((y (car (bff-peel-pts!))))
  (bff-lin-pre!)
  (bff-vv! y)
  (let* ((e1 (dk-cite! 'cips-act-neg-one 'v y)) (act (cadr e1)) (c (cadr act)))
