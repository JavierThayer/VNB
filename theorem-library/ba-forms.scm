                    (let ((r2 (begin (dk-apply! pve j) (dk-rewrite-h! r (list p j) hj))))
                      (subst is)
                      (dk-close-if-asm!))))))))
        (bff-iff-bwd! 'converges-to 'bit_ c fl)
        (let ((iff (dk-cite! 'converges 'bit_ c)))
          (dk-have! (caddr iff) (lambda () (ew fl) (dk-close-if-asm!)))
          (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
          (dk-close-if-asm!))))))
