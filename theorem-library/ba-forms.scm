(define bff-PH (list '(IS-HILBERT-SPACE v) '(IS-HILBERT-SPACE w) '(IS-SUBMODULE v dd) '(IS-DENSE (IP-METRIC-SPACE v) dd)
                     '(IN gi (FUN dd (VEC w))) bff-GADD bff-GHOM bff-GBND))
(define bff-PV '(v dd w gi))
(define (bff-pba a b) (list bff-PB a b))
(define (bff-pw-pre!)
  (bff-lin-pre!)
  (if (not (dk-asm? '(IS-COMPLEX-INNER-PRODUCT-SPACE w)))
      (dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE w) 'is-hilbert-space '(IS-HILBERT-SPACE w))))
(define (bff-wv! x)                       ; gi x in VEC w
  (bff-dt! x)
  (if (not (dk-asm? (list 'IN (list 'gi x) '(VEC w)))) (dk-cite! 'fun-apply-type-c 'gi 'dd '(VEC w) x))
  (list 'gi x))
(define (bff-wc! a b) (dk-cite! 'cips-ip-type 'w a b) (list '(IP w) a b))

(sp (make-wff (forall-guarded (append bff-PV '(bfx_ bfy_)) (append bff-PH '((IN bfx_ dd) (IN bfy_ dd)))
  (list '= (bff-pba 'bfx_ 'bfy_) (list '- (list '(IP w) '(gi bfx_) '(gi bfy_)) '((IP v) bfx_ bfy_))))))
(dk-peel!)
(bff-pw-pre!)
(bff-wv! 'bfx_) (bff-wv! 'bfy_) (bff-wc! '(gi bfx_) '(gi bfy_))
(bff-ct! '((IP v) bfx_ bfy_))
(bff-ct! (list '- (list '(IP w) '(gi bfx_) '(gi bfy_)) '((IP v) bfx_ bfy_)))
(if (not (dk-lam-b!)) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(if (bff-open?) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'pb-value)

(define (bff-pb-out!)                     ; rewrite every PB application of the goal by pb-value
  (let ((seen '()))
    (for-each (lambda (s)
                (if (and (pair? s) (equal? (car s) bff-PB) (= (length s) 3) (not (member s seen)))
                    (begin (set! seen (cons s seen))
                           (bff-dt! (cadr s)) (bff-dt! (caddr s))
                           (subst (dk-cite! 'pb-value 'v 'dd 'w 'gi (cadr s) (caddr s))))))
              (dk-subterms (dk-goal)))))
(define (bff-cc-all! . cs) (for-each bff-ct! cs))

(sp (make-wff (forall-guarded bff-PV bff-PH (list 'IS-POSITIVE-FORM 'v 'dd bff-PB))))
(dk-peel!)
(bff-pw-pre!)
(mac 'is-positive-form)
(mac 'is-quadratic-form)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) bff-PB))       ; the typing
         (dk-lam-type! (lambda ()
                         (bff-peel-goal!)
                         (if (bff-has-lam? (dk-goal)) (dk-lam-b!))
                         (let* ((t (cadr (dk-goal))) (a (cadr (cadr (cadr t)))) (b (cadr (caddr (cadr t)))))
                           (bff-wv! a) (bff-wv! b) (bff-wc! (list 'gi a) (list 'gi b))
                           (bff-ct! (caddr t))
                           (bff-ct! t))
                         (dk-close-if-asm!))))
        (#t
         (bff-peel-goal!)
         (bff-pb-out!)
         (let ((g (dk-goal)))
           (cond
             ((not (dk-head-is? g '=))                           ; positivity
              (let* ((d (if (dk-head-is? g 'AND) (cadr (cadr g)) (cadr g)))
                     (d (if (dk-head-is? d '-) d (caddr g)))
                     (s1 (cadr d)) (s2 (caddr d)) (x (cadr s2)))
                (bff-vv! x) (bff-wv! x)
                (dk-cite! 'cips-ip-self-real 'v x)
                (dk-cite! 'cips-ip-self-real 'w (list 'gi x))
                (bff-inst! bff-GBND x)
                (dk-cite! 'rr-sub-in-rr s1 s2)
                (dk-conj-close! (lambda () (if (dk-ass!) #t
                                               (dk-ineq! (list 'IN s1 'RR) (list 'IN s2 'RR) (list '<= s2 s1)))))))
             ((dk-head-is? (caddr g) 'conjugate)                 ; conjugate symmetry
              (let* ((d (cadr (caddr g))) (s1 (cadr d)) (s2 (caddr d))
                     (gx (cadr s1)) (gy (caddr s1)) (x (cadr s2)) (y (caddr s2)))
                (bff-wv! (cadr gx)) (bff-wv! (cadr gy)) (bff-vv! x) (bff-vv! y)
                (bff-wc! gx gy) (bff-wc! gy gx) (bff-ct! s2) (bff-ct! (list '(IP v) y x))
                (subst (dk-cite! 'cc-conjugate-sub s1 s2))
                (subst (dk-cite! 'cips-ip-conj-sym 'w gx gy))
                (subst (dk-cite! 'cips-ip-conj-sym 'v x y))
                (dk-close-if! (lambda () #t) (lambda () (bff-ct! (caddr (dk-goal))) (rfl)))))
             ((dk-head-is? (caddr g) '+)                         ; additivity
              (let* ((d (cadr g)) (s2 (caddr d)) (ab (cadr s2)) (a (cadr ab)) (b (caddr ab)) (c (caddr s2)))
                (bff-wv! a) (bff-wv! b) (bff-wv! c) (bff-vv! a) (bff-vv! b) (bff-vv! c)
                (subst (bff-inst! bff-GADD a b))
                (subst (dk-cite! 'cips-ip-add-left 'w (list 'gi a) (list 'gi b) (list 'gi c)))
                (subst (dk-cite! 'cips-ip-add-left 'v a b c))
                (bff-cc-all! (list '(IP v) a c) (list '(IP v) b c))
                (bff-wc! (list 'gi a) (list 'gi c)) (bff-wc! (list 'gi b) (list 'gi c))
                (dk-close-if! (lambda () #t) (lambda () (crs)))))
             (#t                                                 ; homogeneity
              (let* ((d (cadr g)) (s2 (caddr d)) (ka (cadr s2)) (k (cadr ka)) (a (caddr ka)) (c (caddr s2)))
                (bff-ct! k) (bff-wv! a) (bff-wv! c) (bff-vv! a) (bff-vv! c)
                (subst (bff-inst! bff-GHOM k a))
                (subst (dk-cite! 'cips-ip-homog-left 'w k (list 'gi a) (list 'gi c)))
                (subst (dk-cite! 'cips-ip-homog-left 'v k a c))
                (bff-ct! (list '(IP v) a c)) (bff-wc! (list 'gi a) (list 'gi c))
                (dk-close-if! (lambda () #t) (lambda () (crs))))))))))))
(bff-qed! 'pb-positive)
;;; ---- PART Q (round 2): with a two-sided inverse hh, H_PB+ is isometric to w; PB is closed --------
(define bff-HL '(FORALL bpy_ (IMPLIES (IN bpy_ (VEC w)) (= (gi (hh bpy_)) bpy_))))
(define bff-HR '(FORALL bpx_ (IMPLIES (IN bpx_ dd) (= (hh (gi bpx_)) bpx_))))
(define bff-PHH (append bff-PH (list '(IN hh (FUN (VEC w) dd)) bff-HL bff-HR)))
(define bff-FPSB (list 'FORM-PLUS-SPACE 'v 'dd bff-PB))
(define bff-MSB (list 'IP-METRIC-SPACE bff-FPSB))
(define bff-MW '(IP-METRIC-SPACE w))

;;; gi(-y) = -gi(y)
(sp (make-wff (forall-guarded (append bff-PV '(bfy_)) (append bff-PH '((IN bfy_ dd)))
  '(= (gi ((VNEG v) bfy_)) ((VNEG w) (gi bfy_))))))
(dk-peel!)
(bff-pw-pre!)
(let ((y 'bfy_))
  (bff-vv! y)
  (let* ((e1 (dk-cite! 'cips-act-neg-one 'v y)) (act (cadr e1)) (c (cadr act)))
    (subst (list '= (caddr e1) act))
    (bff-ct! c)
    (bff-dt! act)
    (subst (bff-inst! bff-GHOM c y))
    (bff-wv! y)
    (dk-cite! 'cips-act-neg-one 'w (list 'gi y))
    (dk-close-if-asm!)))
(bff-qed! 'pb-gi-vneg)

(sp (make-wff (forall-guarded (append bff-PV '(hh bix_ biz_)) (append bff-PHH '((IN bix_ (VEC w)) (IN biz_ (VEC w))))
  (list '= (list (list 'DIST bff-MSB) '(hh bix_) '(hh biz_)) (list (list 'DIST bff-MW) 'bix_ 'biz_)))))
(dk-peel!)
(bff-pw-pre!)
(dk-cite! 'pb-positive 'v 'dd 'w 'gi)
(let ((x 'bix_) (z 'biz_))
      (let* ((a (list 'hh x)) (b (list 'hh z)) (nb (list '(VNEG v) b)) (zz (list '(VADD v) a nb))
             (nzw (list '(VNEG w) z)) (xx (list '(VADD w) x nzw)))
        (dk-cite! 'fun-apply-type-c 'hh '(VEC w) 'dd x)
        (dk-cite! 'fun-apply-type-c 'hh '(VEC w) 'dd z)
        (subst (dk-cite! 'form-plus-space-dist 'v 'dd bff-PB a b))
        (subst (dk-cite! 'ipms-dist-norm 'w x z))
        (dk-cite! 'cips-vneg-type 'w z) (dk-cite! 'cips-vadd-type 'w x nzw)
        (subst (dk-cite! 'ip-norm-unfold 'w xx))
        (bff-dt! zz)
        (bff-pb-out!)
        ;; gi Z = x - z
        (dk-have! (list '= (list 'gi zz) xx)
          (lambda ()
            (bff-dt! nb)
            (subst (bff-inst! bff-GADD a nb))
            (subst (dk-cite! 'pb-gi-vneg 'v 'dd 'w 'gi b))
            (subst (bff-inst! bff-HL x))
            (subst (bff-inst! bff-HL z))
            (dk-close-if! (lambda () #t) (lambda () (rfl)))))
        (subst (list '= (list 'gi zz) xx))
        (let* ((ix (bff-wc! xx xx)) (iz (begin (bff-vv! zz) (bff-ct! (bff-ii zz)) (bff-ii zz))))
          (dk-have! (list '= (list '+ (list '- ix iz) iz) ix) (lambda () (crs)))
          (subst (list '= (list '+ (list '- ix iz) iz) ix))
          (dk-cite! 'cips-ip-self-real 'w xx)
          (dk-cite! 'cips-ip-self-nonneg 'w xx)
          (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(bff-qed! 'pb-isometry)

(sp (make-wff (forall-guarded (append bff-PV '(hh)) bff-PHH (list 'IS-HILBERT-SPACE bff-FPSB))))
(dk-peel!)
(bff-pw-pre!)
(dk-cite! 'pb-positive 'v 'dd 'w 'gi)
(dk-cite! 'form-plus-space-is-cips 'v 'dd bff-PB)
(dk-cite! 'ip-metric-space-is-metric-space bff-FPSB)
(dk-cite! 'ip-metric-space-pts bff-FPSB)
(dk-cite! 'form-plus-space-vec 'v 'dd bff-PB)
(dk-cite! 'hilbert-space-complete 'w)
(dk-cite! 'ip-metric-space-pts 'w)
(define (bff-to-pts! f)                   ; rewrite VEC w / dd in F to the PTS forms
  (dk-have! f (lambda () (subst (list '== (list 'PTS bff-MW) '(VEC w))) (subst (list '== (list 'PTS bff-MSB) (list 'VEC bff-FPSB)))
                         (subst (list '== (list 'VEC bff-FPSB) 'dd)) (dk-close-if-asm!))))
(bff-to-pts! (list 'IN 'hh (list 'FUN (list 'PTS bff-MW) (list 'PTS bff-MSB))))
(bff-to-pts! (list 'IN 'gi (list 'FUN (list 'PTS bff-MSB) (list 'PTS bff-MW))))
(dk-have! (list 'FORALL 'biy_ (list 'IMPLIES (list 'IN 'biy_ (list 'PTS bff-MSB)) '(= (hh (gi biy_)) biy_)))
  (lambda ()
    (let* ((ls (dk-peel!)) (y (cadr (find-first (dk-head? 'IN) ls))))
      (dk-rewrite-h! (dk-rewrite-h! (list 'IN y (list 'PTS bff-MSB)) (list 'PTS bff-MSB) (list 'VEC bff-FPSB)) (list 'VEC bff-FPSB) 'dd)
      (bff-inst! bff-HR y)
      (dk-close-if-asm!))))
(dk-have! (list 'FORALL 'bix_ (list 'IMPLIES (list 'IN 'bix_ (list 'PTS bff-MW)) (list 'FORALL 'biz_ (list 'IMPLIES (list 'IN 'biz_ (list 'PTS bff-MW))
            (list '= (list (list 'DIST bff-MSB) '(hh bix_) '(hh biz_)) (list (list 'DIST bff-MW) 'bix_ 'biz_))))))
  (lambda ()
    (let* ((ls (dk-peel!)) (x 'bix_) (z 'biz_))
      (dk-rewrite-h! (list 'IN x (list 'PTS bff-MW)) (list 'PTS bff-MW) '(VEC w))
      (dk-rewrite-h! (list 'IN z (list 'PTS bff-MW)) (list 'PTS bff-MW) '(VEC w))
      (dk-cite! 'pb-isometry 'v 'dd 'w 'gi 'hh x z)
      (dk-close-if-asm!))))
(dk-cite! 'complete-of-isometric-cover bff-MW bff-MSB 'hh 'gi)
(bff-iff-bwd! 'is-hilbert-space bff-FPSB)
(dk-close-if-asm!)
(bff-qed! 'pb-hilbert)

(sp (make-wff (forall-guarded (append bff-PV '(hh)) bff-PHH (list 'IS-CLOSED-FORM 'v 'dd bff-PB))))
(dk-peel!)
(bff-pw-pre!)
(dk-cite! 'pb-positive 'v 'dd 'w 'gi)
(dk-cite! 'pb-hilbert 'v 'dd 'w 'gi 'hh)
(let ((iff (dk-cite! 'form-closed-iff-hilbert 'v 'dd bff-PB)))
  (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff))))
(dk-close-if-asm!)
(bff-qed! 'pb-closed)
;;; ---- PART R (round 2): the closure form Q1 on dom Q1 = g(H1): PB at gi = GI, hh = g, w = H1 ------
(define (bff-tsub t al) (cond ((and (symbol? t) (assq t al)) => cdr) ((pair? t) (map (lambda (x) (bff-tsub x al)) t)) (#t t)))
(define bff-GIL (list 'VNB-LAMBDA 'bgi_ bff-D1 (bff-GI 'bgi_)))
(define bff-GL (list 'VNB-LAMBDA 'bgj_ (list 'VEC bff-H1) '(g bgj_)))
(define bff-RAL (list (cons 'dd bff-D1) (cons 'w bff-H1) (cons 'gi bff-GIL) (cons 'hh bff-GL)))
(define (bff-at-r x) (bff-tsub x bff-RAL))
(define bff-Q1 (bff-at-r bff-PB))
(define (bff-q1a a b) (list bff-Q1 a b))
(define (bff-gila a) (list bff-GIL a))
(define (bff-gla a) (list bff-GL a))
(define (bff-r-pre!)
  (bff-hc-base!)
  (dk-cite! 'fr-d1-submodule 'v 'dd 'q 'g 'ff)
  (dk-cite! 'fr-d1-subset 'v 'dd 'q 'g 'ff)
  (dk-cite! 'cips-vec-set 'v)
  (if (not (dk-asm? (list 'IN bff-D1 'SET))) (dk-cite! 'subclass-of-set-is-set bff-D1 '(VEC v)))
  (dk-cite! 'cips-vec-set bff-H1))
(define (bff-d1! e)                       ; e in D1 for e built from D1 points by + - and scalars
  (let ((g (list 'IN e bff-D1)))
    (cond ((dk-asm? g) g)
          ((and (pair? e) (equal? (car e) '(VADD v)))
           (bff-d1! (cadr e)) (bff-d1! (caddr e)) (dk-cite! 'submodule-vadd-closed 'v bff-D1 (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG v)))
           (bff-d1! (cadr e)) (dk-cite! 'submodule-vneg-closed 'v bff-D1 (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT v)))
           (bff-ct! (cadr e))
           (dk-cite! 'cips-scal-carrier 'v)
           (dk-have! (list 'IN (cadr e) '(CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))
           (bff-d1! (caddr e)) (dk-cite! 'submodule-act-closed 'v bff-D1 (cadr e) (caddr e)) g)
          ((dk-asm? (list 'IN e 'dd)) (dk-split! (dk-cite! 'fr-dd-in-d1 'v 'dd 'q 'g 'ff e)) g)
          (#t (error "bff-d1!: no D1 typing for" (expression->string e))))))

(sp (bff-kstmt '() '() (list 'IN bff-GIL (list 'FUN bff-D1 (list 'VEC bff-H1)))))
(dk-peel!)
(bff-r-pre!)
(dk-lam-type! (lambda ()
                (let* ((ls (dk-peel!)) (a (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) bff-D1))) ls))))
                  (if (bff-has-lam? (dk-goal)) (dk-lam-b!))
                  (bff-gi! a)
                  (dk-close-if-asm!))))
(bff-qed! 'fr-gil-type)
(sp (bff-kstmt '(bfa_) (list (list 'IN 'bfa_ bff-D1)) (list '= (bff-gila 'bfa_) (bff-GI 'bfa_))))
(dk-peel!)
(bff-r-pre!)
(bff-gi! 'bfa_)
(if (not (dk-lam-b!)) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(if (bff-open?) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'fr-gil-value)
(sp (bff-kstmt '() '() (list 'IN bff-GL (list 'FUN (list 'VEC bff-H1) bff-D1))))
(dk-peel!)
(bff-r-pre!)
(dk-lam-type! (lambda ()
                (let* ((ls (dk-peel!)) (u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'VEC bff-H1)))) ls))))
                  (if (bff-has-lam? (dk-goal)) (dk-lam-b!))
                  (bff-d1-of! u)
                  (dk-close-if-asm!))))
(bff-qed! 'fr-gl-type)
(sp (bff-kstmt '(bfu_) (list (bff-h1v! 'bfu_)) (list '= (bff-gla 'bfu_) '(g bfu_))))
(dk-peel!)
(bff-r-pre!)
(bff-gu! 'bfu_)
(if (not (dk-lam-b!)) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(if (bff-open?) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(bff-qed! 'fr-gl-value)
(define (bff-gilv! a) (bff-d1! a) (subst (dk-cite! 'fr-gil-value 'v 'dd 'q 'g 'ff a)))
(define (bff-glv! u) (subst (dk-cite! 'fr-gl-value 'v 'dd 'q 'g 'ff u)))

;;; the hypotheses of pb-closed at this instance
(sp (bff-kstmt '() '() (bff-at-r bff-GADD)))
(let* ((ls (dk-peel!)) (x 'bpx_) (y 'bpy_))
  (bff-r-pre!)
  (bff-gilv! (list '(VADD v) x y)) (bff-gilv! x) (bff-gilv! y)
  (dk-cite! 'fr-gi-add 'v 'dd 'q 'g 'ff x y)
  (dk-close-if-asm!))
(bff-qed! 'fr-gil-add)
(sp (bff-kstmt '() '() (bff-at-r bff-GHOM)))
(let* ((ls (dk-peel!)) (c 'bpc_) (x 'bpx_))
  (bff-r-pre!)
  (bff-gilv! (list '(ACT v) c x)) (bff-gilv! x)
  (dk-cite! 'fr-gi-act 'v 'dd 'q 'g 'ff c x)
  (dk-close-if-asm!))
(bff-qed! 'fr-gil-hom)
(sp (bff-kstmt '() '() (bff-at-r bff-GBND)))
(let* ((ls (dk-peel!)) (x 'bpx_))
  (bff-r-pre!)
  (bff-gilv! x)
  (let* ((u (bff-gi! x)) (le (dk-cite! 'fr-g-ip-le 'v 'dd 'q 'g u)))
    (dk-rewrite-h! le (list 'g u) x)
    (dk-close-if-asm!)))
(bff-qed! 'fr-gil-bnd)
(sp (bff-kstmt '() '() (bff-at-r bff-HL)))
(let* ((ls (dk-peel!)) (y 'bpy_))
  (bff-r-pre!)
  (bff-glv! y)
  (bff-d1-of! y)
  (bff-gilv! '(g bpy_))
  (dk-cite! 'fr-gi-left 'v 'dd 'q 'g 'ff y)
  (dk-close-if-asm!))
(bff-qed! 'fr-hl)
(sp (bff-kstmt '() '() (bff-at-r bff-HR)))
(let* ((ls (dk-peel!)) (x 'bpx_))
  (bff-r-pre!)
  (bff-gilv! x)
  (let ((u (bff-gi! x)))
    (bff-glv! u)
    (dk-close-if-asm!)))
(bff-qed! 'fr-hr)

;;; Q1 is a closed positive form on dom Q1
(sp (bff-kstmt '() '() (list 'IS-CLOSED-FORM 'v bff-D1 bff-Q1)))
(dk-peel!)
(bff-r-pre!)
(dk-cite! 'fr-d1-dense 'v 'dd 'q 'g 'ff)
(for-each (lambda (n) (dk-cite! n 'v 'dd 'q 'g 'ff)) '(fr-gil-type fr-gl-type fr-gil-add fr-gil-hom fr-gil-bnd fr-hl fr-hr))
(dk-cite! 'pb-closed 'v bff-D1 bff-H1 bff-GIL bff-GL)
(dk-close-if-asm!)
(bff-qed! 'fr-q1-closed)
;;; ---- PART S (round 2): Q1 extends Q, T_Q1 extends T, T_Q1 self-adjoint and positive ------------
(define (bff-ph-r!)                       ; the hypotheses of pb-value at this instance
  (bff-r-pre!)
  (dk-cite! 'fr-d1-dense 'v 'dd 'q 'g 'ff)
  (for-each (lambda (n) (dk-cite! n 'v 'dd 'q 'g 'ff)) '(fr-gil-type fr-gil-add fr-gil-hom fr-gil-bnd)))
(define (bff-gie! x)                     ; (= (GI x) (E x)) for x in dd
  (let ((f (list '= (bff-GI x) (bff-emb x))))
    (if (not (dk-asm? f)) (dk-split! (dk-cite! 'fr-dd-in-d1 'v 'dd 'q 'g 'ff x)))
    f))
(define (bff-q1-out! a b)                 ; Q1(a, b) = <GI a | GI b>_H1 - <a | b>
  (bff-d1! a) (bff-d1! b)
  (subst (dk-cite! 'pb-value 'v bff-D1 bff-H1 bff-GIL a b))
  (bff-gilv! a) (bff-gilv! b))

(sp (bff-kstmt '(bfx_ bfy_) '((IN bfx_ dd) (IN bfy_ dd)) (list '= (bff-q1a 'bfx_ 'bfy_) '(q bfx_ bfy_))))
(dk-peel!)
(bff-ph-r!)
(let ((x 'bfx_) (y 'bfy_))
  (bff-q1-out! x y)
  (subst (bff-gie! x))
  (subst (bff-gie! y))
  (subst (dk-cite! 'fr-embed-ip 'v 'dd 'q x y))
