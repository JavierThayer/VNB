;;; |Q(x - y, x - y)| <= h h  and  d(x, y) <= h  =>  d+(x, y) <= h + h
(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_ bfh_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd) (IN bfh_ RR) (<= 0 bfh_)))
  (list 'IMPLIES (list '<= (list 'magnitude (bff-qq bff-Z)) '(* bfh_ bfh_))
    (list 'IMPLIES (list '<= (bff-dv 'bfx_ 'bfy_) 'bfh_)
      (list '<= (bff-dp 'bfx_ 'bfy_) '(+ bfh_ bfh_)))))))
(let* ((ls (dk-peel!))
       (xy (reverse (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (eq? (caddr f) 'dd))) ls))))
       (x (car xy)) (y (cadr xy)) (h 'bfh_))
  (bff-base!)
  (let* ((z (bff-sub x y)) (qz (bff-qq z)) (sq (list 'SQRT qz)) (hh '(* bfh_ bfh_))
         (dp (bff-dp-typed! x y)) (dv (bff-dv-typed! x y)))
    (bff-real-facts! z)
    (let* ((h1 (list '<= (list 'magnitude qz) hh))
           (e1 (dk-cite! 'rr-magnitude-is-abs qz))
           (h2 (dk-rewrite-h! h1 (list 'magnitude qz) (list 'abs qz)))
