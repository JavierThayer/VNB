    (let* ((fa (list 'FORALL 'bfe_ (list 'IMPLIES '(POS-RR bfe_) (list '<= (list 'magnitude (list '- a b)) (list '* 'bfe_ cc)))))
           (r (begin
          (begin
            (dk-have! fa
              (lambda ()
                (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                       (ex (dk-cite! 'fr-approx 'v 'dd 'q 'g u e))
                       (z (dk-skolem! ex)))
                  (dk-split-all!)
                  (bff-pos-parts! e)
                  (bff-vv! z)
                  (let* ((ez (bff-ez! z)) (zw (bff-ip z w)) (c (bff-i1 ez ep))
                         (d1 (bff-dr! bff-M1 u ez)) (d2 (bff-dr! bff-MV gu z)))
                    (bff-vv! z)
                    (dk-cite! 'cips-ip-type bff-H1 ez ep)
                    (bff-ct! zw)
                    ;; <E z | E psi> = <z | w>
                    (dk-have! (list '= c zw)
                      (lambda ()
                        (subst (dk-cite! 'fr-embed-ip 'v 'dd 'q z p))
                        (subst (bff-inst! bff-TQ p z))
                        (bff-vv! (list 'ff p))
                        (subst (dk-cite! 'cips-ip-add-right 'v z (list 'ff p) p))
