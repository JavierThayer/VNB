;;; typings of the two distances
(define (bff-dp-typed! x y)
  (let ((dp (bff-dp x y)))
    (if (not (dk-asm? (list 'IN dp 'RR)))
        (let* ((z (bff-sub x y)) (s (begin (bff-dt! x) (bff-dt! y) (bff-dt! z) (bff-sum-nonneg! z)))
               (eq (dk-cite! 'form-plus-space-dist 'v 'dd 'q x y)))
          (dk-have! (list 'IN dp 'RR) (lambda () (subst eq) (ass)))
          (dk-have! (list '<= 0 dp) (lambda () (subst eq) (ass)))))
    dp))
(define (bff-dv-typed! x y)
  (let ((dv (bff-dv x y)))
    (if (not (dk-asm? (list 'IN dv 'RR)))
        (let* ((z (bff-sub x y)))
          (bff-vv! x) (bff-vv! y) (bff-vv! z)
          (dk-cite! 'cips-ip-self-real 'v z) (dk-cite! 'cips-ip-self-nonneg 'v z)
          (bff-and! (list 'IN (bff-ii z) 'RR) (list '<= 0 (bff-ii z)))
          (dk-split! (dk-cite! 'sqrt-nonneg (bff-ii z)))
          (let ((eq (dk-cite! 'ip-metric-space-dist 'v x y)))
            (dk-have! (list 'IN dv 'RR) (lambda () (subst eq) (ass)))
            (dk-have! (list '<= 0 dv) (lambda () (subst eq) (ass))))))
    dv))

;;; sqrt of a positive real is positive
(sp (make-wff '(FORALL bfe_ (IMPLIES (POS-RR bfe_) (POS-RR (SQRT bfe_))))))
(dk-peel!)
