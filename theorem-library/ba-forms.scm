                    (dk-close-if-asm!))))
              (dk-cite! 'ms-converges-of-dominated-sum bff-HM bff-MV bff-MV p s t xy x y)
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IN (list p 'n_) bff-G)))
                (lambda ()
