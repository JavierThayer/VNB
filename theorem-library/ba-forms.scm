        (bff-vec-of! (list 'IN x (list 'PTS bff-MV)) x)
        ;; t(n) = ff(s(n))
        (let* ((tr (dk-abstract! 'NN '(VEC v) (lambda (k) (list 'ff (list s k)))
                                 (lambda (k) (bff-fd! s k) (bff-vv! (list 'ff (list s k))) (dk-close-if-asm!))))
               (t (car tr)) (tve (cdr tr)))
          (dk-rewrite-h! (list 'IN t '(FUN NN (VEC v))) '(VEC v) (list 'PTS bff-MV))
          ;; t is Cauchy in H
          (dk-have! (bff-cauchy-clause bff-MV t)
            (lambda ()
              (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                     (ee (bff-sq-pos! e))
                     (ni (bff-eventually! qc ee)) (n (car ni)) (inner (cdr ni)))
                (bff-witness! n
                  (lambda ()
                    (let* ((ls2 (dk-peel!)) (ks (bff-nn-vars ls2)) (m (car ks)) (k (cadr ks))
                           (andf (find-first (dk-head? 'AND) ls2)))
                      (if andf (dk-split! andf))
