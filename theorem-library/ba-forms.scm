;;; d+(x, y) <= h  =>  |Q(x - y, x - y)| <= h h
(sp (make-wff (forall-guarded '(v dd q bfx_ bfy_ bfh_) (append bff-H '((IN bfx_ dd) (IN bfy_ dd) (IN bfh_ RR) (<= 0 bfh_)))
  (list 'IMPLIES (list '<= (bff-dp 'bfx_ 'bfy_) 'bfh_)
