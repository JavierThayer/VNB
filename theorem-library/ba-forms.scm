        (bff-and! (list 'IN qz 'RR) (list '<= 0 qz))
        (dk-split! (dk-cite! 'sqrt-nonneg qz))
        (dk-cite! 'form-plus-space-dist-le 'v 'dd 'q x y)
        (dk-ineq! (list 'IN sq 'RR) (list 'IN dp 'RR) (list 'IN dv 'RR) (list 'IN h 'RR)
