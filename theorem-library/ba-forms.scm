(define (bff-h1-ip! a b) (dk-cite! 'cips-ip-type bff-H1 a b) (bff-i1 a b))

;;; vectors of H1 that agree against every E psi are equal (E(dom Q) is dense)
(define bff-AGREE (list 'FORALL 'bfy_ (list 'IMPLIES '(IN bfy_ dd) (list '= (bff-i1 'bfu_ (bff-emb 'bfy_)) (bff-i1 'bfw_ (bff-emb 'bfy_))))))
