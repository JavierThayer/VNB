                                (dk-cite! 'cips-sq-le-of-dist-le 'v fsj fx sr)
                                (subst (dk-cite! 'graph-form-sub-value 'v 'dd 'ff sj x))
                                (subst (list '= e (list '* sr sr)))
                                (dk-close-if-asm!)))))))))))))))
  (bff-iff-bwd! 'is-closed-form 'v 'dd bff-QF)
  (dk-close-if-asm!))
