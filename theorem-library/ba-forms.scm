  (dk-rewrite-h! (dk-rewrite-h! f bff-CVV '(VEC (HSUM v v))) '(VEC (HSUM v v)) (list 'PTS bff-HM)))

(sp (make-wff (forall-guarded '(v dd ff) (append bff-LHH (list (list 'IS-CLOSED-GRAPH 'v bff-G)))
