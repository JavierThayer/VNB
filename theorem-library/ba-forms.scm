;;; Q is a positive quadratic form on dd
(define (bff-qf-args! g)                  ; type in dd the arguments of every Q-application in G
  (for-each (lambda (s) (if (and (pair? s) (equal? (car s) bff-QF) (= (length s) 3))
                            (begin (bff-dt! (cadr s)) (bff-dt! (caddr s)))))
            (dk-subterms g)))
(define (bff-beta!)
  (bff-qf-args! (dk-goal))
  (if (bff-has-lam? (dk-goal)) (dk-lam-b!)))
(define (bff-peel-goal!)
  (let loop () (if (and (bff-open?) (memq (dk-head (dk-goal)) '(FORALL IMPLIES))) (begin (dk-peel!) (loop)))))
(sp (make-wff (forall-guarded '(v dd ff) (append bff-LH '((IS-DENSE (IP-METRIC-SPACE v) dd)))
  (list 'IS-POSITIVE-FORM 'v 'dd bff-QF))))
