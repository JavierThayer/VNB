                      (let* ((r (bff-inst! inner m k))
                             (eq0 (dk-cite! 'graph-form-sub-value 'v 'dd 'ff (list s m) (list s k)))
                             (r2 (dk-rewrite-h! r (cadr eq0) (caddr eq0))))
                        (bff-vv! (list 'ff (list s m))) (bff-vv! (list 'ff (list s k)))
                        (dk-cite! 'cips-dist-le-of-sq-le 'v (list 'ff (list s m)) (list 'ff (list s k)) e)
                        (subst (dk-apply! tve m))
                        (subst (dk-apply! tve k))
                        (dk-close-if-asm!))))))))
          (bff-iff-bwd! 'is-cauchy-seq bff-MV t)
          (dk-cite! 'complete-cauchy-converges bff-MV t)
          (let* ((c1 (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES bff-MV t))))))
                 (y (dk-skolem! c1))
                 (tcv (begin (bff-iff-fwd! 'converges-to bff-MV t y) (bff-conv-clause bff-MV t y))))
            (bff-vec-of! (list 'IN y (list 'PTS bff-MV)) y)
            ;; p(n) = [s(n), ff(s(n))] -> [x, y] in H (+) H
            (let* ((pr (dk-abstract! 'NN bff-CVV (lambda (k) (list 'LIST (list s k) (list 'ff (list s k))))
                                     (lambda (k) (bff-fd! s k) (bff-vv! (list s k)) (bff-vv! (list 'ff (list s k)))
                                             (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (list s k) (list 'ff (list s k)))
                                             (dk-close-if-asm!))))
                   (p (car pr)) (pve (cdr pr))
                   (xy (list 'LIST x y)))
              (bff-hm-pts! (list 'IN p (list 'FUN 'NN bff-CVV)))
              (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) x y)
              (bff-hm-pts! (list 'IN xy bff-CVV))
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                          (list '<= (list (list 'DIST bff-HM) (list p 'n_) xy)
                                (list '+ (bff-dv (list s 'n_) x) (bff-dv (list t 'n_) y)))))
                (lambda ()
                  (let* ((j (car (bff-nn-vars (dk-peel!)))) (sj (list s j)) (fsj (list 'ff sj)))
                    (subst (dk-apply! pve j))
                    (subst (dk-apply! tve j))
