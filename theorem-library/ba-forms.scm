  (if (not (dk-asm? '(IS-SUBMODULE v dd)))
      (begin
        (dk-project! '(IS-QUADRATIC-FORM v dd q) 'is-positive-form '(IS-POSITIVE-FORM v dd q))
        (dk-project! '(IS-SUBMODULE v dd) 'is-quadratic-form '(IS-QUADRATIC-FORM v dd q))))
  (bff-base!)
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
