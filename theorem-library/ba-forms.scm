    (lambda ()
      (let* ((p (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd))) (dk-peel!))))
             (ep (bff-ez! p)))
        (bff-h1-ip! u ep) (bff-h1-ip! w ep)
