  '(= bfu_ bfw_))))
(dk-peel!)
(bff-hc-base!)
(let* ((u 'bfu_) (w 'bfw_) (nw (list (list 'VNEG bff-H1) w)) (x (list (list 'VADD bff-H1) u nw))
       (xx (list (list 'IP bff-H1) x x)) (nx (list 'IP-NORM bff-H1 x)))
  (dk-cite! 'cips-vneg-type bff-H1 w)
  (dk-cite! 'cips-vadd-type bff-H1 u nw)
  (bff-h1-ip! x x)
  (bff-nrm! bff-H1 x)
  ;; <x | E psi> = 0
