;;; THE KEY IDENTITY (Lemma 5.50): <u | E psi>_H1 = <g u | T psi + psi>
(define bff-TQ '(FORALL bty_ (IMPLIES (IN bty_ dd) (FORALL btx_ (IMPLIES (IN btx_ dd) (= (q btx_ bty_) ((IP v) btx_ (ff bty_))))))))
(define bff-KH (append bff-GH (list '(IN ff (FUN dd (VEC v))) bff-TQ)))
(define (bff-wpsi p) (list '(VADD v) (list 'ff p) p))
(define (bff-bound-chain! a c b ba bb e aa bbn)
  ;; |a - b| <= e (aa + bbn) from |a - c| <= da aa, |c - b| <= db bbn, da <= e, db <= e
  (let* ((mab (list 'magnitude (list '- a b))) (mac (list 'magnitude (list '- a c))) (mcb (list 'magnitude (list '- c b)))
         (da (cadr (caddr ba))) (db (cadr (caddr bb))))
    (for-each (lambda (t) (bff-ct! t) (dk-cite! 'cc-magnitude-closed t)) (list (list '- a b) (list '- a c) (list '- c b)))
    (dk-cite! 'cc-magnitude-sub-chain a c b)
    (dk-cite! 'rr-mul-le-right da e aa)
    (dk-cite! 'rr-mul-le-right db e bbn)
    (for-each (lambda (p) (dk-cite! 'rr-mul-in-rr (car p) (cdr p))) (list (cons da aa) (cons e aa) (cons db bbn) (cons e bbn)))
    (dk-cite! 'rr-add-in-rr aa bbn)
    (dk-cite! 'rr-mul-in-rr e (list '+ aa bbn))
    (dk-have! (list '= (list '* e (list '+ aa bbn)) (list '+ (list '* e aa) (list '* e bbn))) (lambda () (crs)))
    (dk-ineq! (list 'IN mab 'RR) (list 'IN mac 'RR) (list 'IN mcb 'RR)
              (list 'IN (list '* da aa) 'RR) (list 'IN (list '* e aa) 'RR) (list 'IN (list '* db bbn) 'RR) (list 'IN (list '* e bbn) 'RR)
              (list 'IN (list '* e (list '+ aa bbn)) 'RR)
              (list '<= mab (list '+ mac mcb)) ba bb
              (list '<= (list '* da aa) (list '* e aa)) (list '<= (list '* db bbn) (list '* e bbn))
              (list '= (list '* e (list '+ aa bbn)) (list '+ (list '* e aa) (list '* e bbn))))))

(sp (make-wff (forall-guarded '(v dd q g ff bfu_ bfy_) (append bff-KH (list (list 'IN 'bfu_ (list 'VEC bff-H1)) '(IN bfy_ dd)))
  (list '= (bff-i1 'bfu_ (bff-emb 'bfy_)) (bff-ip '(g bfu_) (bff-wpsi 'bfy_))))))
(dk-peel!)
(bff-hc-base!)
(let* ((u 'bfu_) (p 'bfy_) (w (bff-wpsi p)) (ep (bff-ez! p)) (gu (bff-gu! u))
       (a (bff-i1 u ep)) (b (bff-ip gu w)))
  (bff-vv! w)
