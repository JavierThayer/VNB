;;; ---- PART M (round 2): completeness passes along an isometry with a right inverse --------------
(define bff-ISO-H
  '((IS-COMPLETE bis_) (IS-METRIC-SPACE bit_)
    (IN bif_ (FUN (PTS bis_) (PTS bit_))) (IN bih_ (FUN (PTS bit_) (PTS bis_)))
    (FORALL biy_ (IMPLIES (IN biy_ (PTS bit_)) (= (bif_ (bih_ biy_)) biy_)))
    (FORALL bix_ (IMPLIES (IN bix_ (PTS bis_)) (FORALL biz_ (IMPLIES (IN biz_ (PTS bis_))
      (= ((DIST bit_) (bif_ bix_) (bif_ biz_)) ((DIST bis_) bix_ biz_))))))))
(define (bff-iso-at! a b)                 ; d_t(f a', f b') = d_s(a, b) with f(h .) cancelled, a = h(a') ...
  (let* ((iso (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'bix_))) (dk-asms)))
         (r (bff-inst! iso a b)))
    r))
(sp (make-wff (forall-guarded '(bis_ bit_ bif_ bih_) bff-ISO-H '(IS-COMPLETE bit_))))
(dk-peel!)
(bff-iff-fwd! 'is-complete 'bis_)
(define bff-RIGHT '(FORALL biy_ (IMPLIES (IN biy_ (PTS bit_)) (= (bif_ (bih_ biy_)) biy_))))
(dk-have! '(FORALL bic_ (IMPLIES (IS-CAUCHY-SEQ bit_ bic_) (CONVERGES bit_ bic_)))
  (lambda ()
    (dk-peel!)
    (let* ((c 'bic_) (cc0 (bff-iff-fwd! 'is-cauchy-seq 'bit_ c))
           (cl (bff-cauchy-clause 'bit_ c))
           (pr (dk-abstract! 'NN '(PTS bis_) (lambda (k) (list 'bih_ (list c k)))
                 (lambda (k) (dk-cite! 'fun-apply-type-c c 'NN '(PTS bit_) k)
                             (dk-cite! 'fun-apply-type-c 'bih_ '(PTS bit_) '(PTS bis_) (list c k))
                             (dk-close-if-asm!))))
           (p (car pr)) (pve (cdr pr)))
      (define (hc! k)                     ; h(c k) in pts s, and the iso at it with f(h(c k)) = c k
        (dk-cite! 'fun-apply-type-c c 'NN '(PTS bit_) k)
        (dk-cite! 'fun-apply-type-c 'bih_ '(PTS bit_) '(PTS bis_) (list c k))
        (bff-inst! bff-RIGHT (list c k))
        (list 'bih_ (list c k)))
      (define (iso! a b)                  ; a, b of the form h(c k) or arbitrary
        (let ((r (bff-iso-at! a b)))
          (let loop ((r r) (xs (list a b)))
            (if (null? xs) r
                (loop (if (and (pair? (car xs)) (eq? (caar xs) 'bih_)) (dk-rewrite-h! r (list 'bif_ (car xs)) (cadr (car xs))) r)
                      (cdr xs))))))
      ;; p is Cauchy in s
      (dk-have! (bff-cauchy-clause 'bis_ p)
        (lambda ()
          (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                 (ni (bff-eventually! cl e)) (n (car ni)) (inner (cdr ni)))
            (bff-witness! n
              (lambda ()
                (let* ((ls2 (dk-peel!)) (ks (bff-nn-vars ls2)) (m (car ks)) (k (cadr ks))
                       (andf (find-first (dk-head? 'AND) ls2)))
                  (let* ((r (bff-inst! inner m k)) (hm (hc! m)) (hk (hc! k)) (is (iso! hm hk)))
                    (subst (dk-apply! pve m))
                    (subst (dk-apply! pve k))
                    (dk-rewrite-h! r (cadr is) (caddr is))
                    (dk-close-if-asm!))))))))
      (bff-iff-bwd! 'is-cauchy-seq 'bis_ p)
      (bff-inst! '(FORALL f (IMPLIES (IS-CAUCHY-SEQ bis_ f) (CONVERGES bis_ f))) p)
      (bff-iff-fwd! 'converges 'bis_ p)
      (let* ((l (dk-skolem! (find-first (dk-head? 'FORSOME) (dk-asms))))
             (dummy (bff-iff-fwd! 'converges-to 'bis_ p l))
             (pcl (bff-conv-clause 'bis_ p l))
