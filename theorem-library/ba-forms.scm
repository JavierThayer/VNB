;;; THEOREM 3.21 for a positive form q with q(x, psi) = <x | T psi> (dom T = dom q):
;;; there are dom Q1 and a closed positive form Q1 on it extending q, T_Q1 self-adjoint, positive, and
;;; T_Q1 extends T
(define (bff-fr-concl d1 q1)
  (let ((t1 (list 'FORM-OPERATOR 'v d1 q1)))
    (list 'AND (list 'IS-CLOSED-FORM 'v d1 q1)
     (list 'AND (list 'IS-DENSE (list 'IP-METRIC-SPACE (list 'FORM-PLUS-SPACE 'v d1 q1)) 'dd)
     (list 'AND (list 'SUBSET 'dd d1)
      (list 'AND (list 'FORALL 'brx_ (list 'IMPLIES '(IN brx_ dd) (list 'FORALL 'bry_ (list 'IMPLIES '(IN bry_ dd)
                   (list '= (list q1 'brx_ 'bry_) '(q brx_ bry_))))))
       (list 'AND (list 'FORALL 'bry_ (list 'IMPLIES '(IN bry_ dd) (list 'IN '(LIST bry_ (ff bry_)) t1)))
        (list 'AND (list 'IS-SELF-ADJOINT-GRAPH 'v t1)
          (list 'FORALL 'brc_ (list 'IMPLIES '(IN brc_ (VEC v)) (list 'FORALL 'brd_ (list 'IMPLIES '(IN brd_ (VEC v))
            (list 'IMPLIES (list 'IN '(LIST brc_ brd_) t1) '(AND (IN ((IP v) brc_ brd_) RR) (<= 0 ((IP v) brc_ brd_))))))))))))))))
(sp (make-wff (forall-guarded '(v dd q ff) (append bff-FH (list '(IN ff (FUN dd (VEC v))) bff-TQ))
  (list 'FORSOME 'bfd1_ (list 'FORSOME 'bfq1_ (bff-fr-concl 'bfd1_ 'bfq1_))))))
(dk-peel!)
(bff-pre!)
(let ((g0 (dk-skolem! (dk-cite! 'fr-g-exists 'v 'dd 'q))))
  (dk-split-all!)
  ;; from here on the extension is named g: rename by a universal instance of the K-lemmas
  (let* ((al (list (cons 'g g0)))
         (sub (lambda (x) (bff-tsub x al)))
         (d1 (sub bff-D1)) (q1 (sub bff-Q1)))
    (define (k! name . args) (apply dk-cite! name 'v 'dd 'q g0 'ff args))
    (define (dd-vars ls) (bff-by-goal (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd) (symbol? (cadr h)))) ls))))
    (ew d1) (ew q1)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-ass!) #t)
            ((dk-head-is? g 'IS-CLOSED-FORM) (k! 'fr-q1-closed) (dk-close-if-asm!))
            ((dk-head-is? g 'SUBSET) (k! 'fr-dd-subset-d1) (dk-close-if-asm!))
            ((dk-head-is? g 'IS-DENSE) (k! 'fr-dd-dense-plus) (dk-close-if-asm!))
            ((dk-head-is? g 'IS-SELF-ADJOINT-GRAPH) (k! 'fr-t1-self-adjoint) (dk-close-if-asm!))
            ((and (dk-head-is? g 'FORALL) (memq (cadr g) '(brc_ bry_)))
             (if (eq? (cadr g) 'brc_)
                 (let* ((ls (dk-peel!)))
                   (k! 'fr-q1-closed)
                   (dk-project! (list 'IS-POSITIVE-FORM 'v d1 q1) 'is-closed-form (list 'IS-CLOSED-FORM 'v d1 q1))
                   (k! 'fr-d1-submodule)
                   (dk-cite! 'form-operator-positive 'v d1 q1 'brc_ 'brd_)
                   (dk-close-if-asm!))
                 (let* ((ls (dk-peel!)) (ys (dd-vars ls))) (k! 'fr-graph-in-t1 (car ys)) (dk-close-if-asm!))))
            (#t (let* ((ls (dk-peel!)) (ys (dd-vars ls))) (k! 'fr-q1-extends (car ys) (cadr ys)) (dk-close-if-asm!)))))))))
(bff-qed! 'friedrichs-extension-of-form)

;;; THEOREM 3.21 (Friedrichs): a positive symmetric operator T on a dense dom T has a self-adjoint
;;; positive extension T_Q1, where Q1 is the closure of Q(x, y) = <x | T y> on its form domain
(define (bff-trep t old new) (cond ((equal? t old) new) ((pair? t) (map (lambda (x) (bff-trep x old new)) t)) (#t t)))
(define bff-FRH (append bff-LHH (list bff-SYM bff-POS)))
(sp (make-wff (forall-guarded '(v dd ff) bff-FRH
  (list 'FORSOME 'bfd1_ (list 'FORSOME 'bfq1_
    (bff-trep (bff-fr-concl 'bfd1_ 'bfq1_) '(q brx_ bry_) '((IP v) brx_ (ff bry_))))))))
(dk-peel!)
(bff-lin-pre!)
(dk-cite! 'symmetric-op-form-positive 'v 'dd 'ff)
(define (bff-qs-val! x y)                 ; QS(x, y) = <x | ff y>
  (let ((f (list '= (list bff-QS x y) (list '(IP v) x (list 'ff y)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (bff-ct! (list '(IP v) x (list 'ff y)))
                               (dk-lam-b!)
                               (let ((g (dk-goal)))
                                 (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))))))
    f))
(dk-have! (bff-tsub bff-TQ (list (cons 'q bff-QS)))
  (lambda ()
    (let* ((ls (dk-peel!)) (ys (bff-by-goal (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd))) ls)))))
      (bff-qs-val! (car ys) (cadr ys))
      (dk-close-if-asm!))))
(let* ((ex (dk-cite! 'friedrichs-extension-of-form 'v 'dd bff-QS 'ff))
       (d1 (dk-skolem! ex))
       (ex2 (find-first (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h d1))) (dk-asms)))
       (q1 (dk-skolem! ex2)))
  (dk-split-all!)
  (ew d1) (ew q1)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        (#t
         (let* ((ls (dk-peel!))
                (ys (bff-by-goal (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'dd))) ls))))
                (x (car ys)) (y (cadr ys))
                (ext (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h q1) (dk-contains? h bff-QS))) (dk-asms))))
           (subst (bff-inst! ext x y))
           (bff-qs-val! x y)
           (dk-close-if-asm!)))))))
(bff-qed! 'friedrichs-extension)
