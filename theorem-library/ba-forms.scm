        (dk-have! (list '= (list '- (bff-i1 w ep) (bff-i1 w ep)) 0) (lambda () (crs)))
        (dk-have! (list '= (bff-i1 x ep) 0)
          (lambda () (subst (list '= (bff-i1 x ep) (list '- (bff-i1 u ep) (bff-i1 w ep))))
                     (subst (list '= (bff-i1 u ep) (bff-i1 w ep))) (ass)))
        (dk-close-if-asm!))))
  (define bff-x0 (list 'FORALL 'bfy_ (list 'IMPLIES '(IN bfy_ dd) (list '= (bff-i1 x (bff-emb 'bfy_)) 0))))
  ;; <x | x> = 0
  (dk-have! '(IN 0 CC) (lambda () (type-term)))
  (dk-have! (list 'FORALL 'bfe_ (list 'IMPLIES '(POS-RR bfe_) (list '<= (list 'magnitude (list '- xx 0)) (list '* 'bfe_ nx))))
    (lambda ()
      (let* ((e (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
             (z (dk-skolem! (dk-cite! 'hc-embed-near bff-M bff-FP x e))))
        (dk-split-all!)
        (bff-pos-parts! e)
        (bff-m-dd! (list 'IN z (list 'VEC bff-M)))
        (let* ((ez (bff-ez! z)) (d (bff-dr! bff-M1 x ez)) (zx (bff-h1-ip! ez x)))
          (bff-h1-ip! x ez)
          (dk-have! (list '= zx 0)
            (lambda ()
              (subst (dk-cite! 'cips-ip-conj-sym bff-H1 x ez))
              (subst (bff-inst! bff-x0 z))
              (dk-cite! 'cc-conjugate-zero) (dk-close-if-asm!)))
          (let* ((b (dk-cite! 'cips-ip-sub-left-bound bff-H1 x ez x))
                 (b1 (dk-rewrite-h! b zx 0)))
            (dk-cite! 'rr-mul-le-right d e nx)
            (dk-cite! 'rr-mul-in-rr d nx) (dk-cite! 'rr-mul-in-rr e nx)
            (bff-ct! (list '- xx 0)) (dk-cite! 'cc-magnitude-closed (list '- xx 0))
            (dk-ineq! (list 'IN (list 'magnitude (list '- xx 0)) 'RR) (list 'IN (list '* d nx) 'RR) (list 'IN (list '* e nx) 'RR)
                      b1 (list '<= (list '* d nx) (list '* e nx))))))))
  (let lp ((r (dk-cite! 'cc-eq-of-small xx 0 nx)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r))) (lp (dk-landed-1 (lambda () (detach! r))))))
  (let ((iff (dk-cite! 'cips-ip-definite bff-H1 x)))
