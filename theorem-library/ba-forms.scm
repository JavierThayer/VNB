(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) bff-QF))       ; the typing
         (dk-lam-type! (lambda ()
                         (bff-peel-goal!)
                         (if (bff-has-lam? (dk-goal)) (dk-lam-b!))
                         (bff-ct! (cadr (dk-goal)))
                         (dk-close-if-asm!))))
        (#t
         (bff-peel-goal!)
         (if (and (bff-open?) (not (dk-asm? (dk-goal)))) (bff-beta!))
         (let ((g (dk-goal)))
           (cond
             ((not (dk-head-is? g '=))                           ; positivity
              (let* ((ip (cond ((dk-head-is? g 'AND) (cadr (cadr g))) ((dk-head-is? g 'IN) (cadr g)) (#t (caddr g))))
                     (x (cadr ip)))
                (bff-vv! x)
                (dk-cite! 'cips-ip-self-real 'v x)
                (dk-cite! 'cips-ip-self-nonneg 'v x)
                (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! dk-ass!) (dk-close-if-asm!))))
             ((dk-head-is? (caddr g) 'conjugate)                 ; conjugate symmetry
              (let ()
                (let ((fx (cadr (caddr g))))
                  (bff-vv! (cadr fx)) (bff-vv! (caddr fx))
                  (dk-cite! 'cips-ip-conj-sym 'v (cadr fx) (caddr fx))
                  (dk-close-if-asm!))))
             ((dk-head-is? (caddr g) '+)                         ; additivity
              (let* ((l (cadr g)) (fs (cadr l)) (s (cadr fs)) (a (cadr s)) (b (caddr s)) (fz (caddr l)))
                (subst (bff-inst! bff-ADD a b))
                (for-each bff-vv! (list (bff-ff a) (bff-ff b) fz))
                (subst (dk-cite! 'cips-ip-add-left 'v (bff-ff a) (bff-ff b) fz))
                (dk-close-if! (lambda () #t) (lambda () (bff-ct! (caddr (dk-goal))) (rfl)))))
             (#t                                                 ; homogeneity
              (let* ((l (cadr g)) (fs (cadr l)) (s (cadr fs)) (k (cadr s)) (a (caddr s)) (fz (caddr l)))
                (bff-ct! k)
                (subst (bff-inst! bff-HOM k a))
                (for-each bff-vv! (list (bff-ff a) fz))
                (subst (dk-cite! 'cips-ip-homog-left 'v k (bff-ff a) fz))
                (dk-close-if! (lambda () #t) (lambda () (bff-ct! (caddr (dk-goal))) (rfl))))))))))))
