;;; hs-inner-product.scm -- wave of 2026-11-09/10 (agent TH3-B2), wired 2026-11-10 from scratchpad/th3-1109/b2/tb2-hip.scm.
;;; Library: operator-algebras.

;;; ====================================================================
;;; tb2-hip.scm -- TH3-B2, 2026-11-09.  The Hilbert-Schmidt inner product (th-main (3.12),
;;; (3.13), Prop. 3.37) and the trace (Prop. 3.45, Def. 3.46) on the TH3 vocabulary.
;;;
;;;   hs-ip-family-sums        S, T Hilbert-Schmidt, {e_i} any ONB: the family <S e_i | T e_i> is
;;;                            summable in CC (absolutely: |<S e|T e>| <= ||S e||^2 + ||T e||^2)
;;;   hs-sum-polar             HS-SUM(S + c T) = HS-SUM(S) + conj(c) q + c conj(q) + |c|^2 HS-SUM(T),
;;;                            q = sum_i <S e_i | T e_i>   (the expansion behind polarization)
;;;   (the basis independence and the trace laws are in tb2-hip2.scm and tb2-hip3.scm)
;;;
;;; THE ROUTE (technique): no double sum of complex numbers is ever interchanged.  The sum
;;; q_e(S, T) is recovered from the real sums HS-SUM(S + c T) at c = 1 and c = i, which do not
;;; depend on the basis (hs-sum-basis-independent, TH3-B); the CC algebra of unordered sums
;;; is the pointwise file tb2-sums.scm.
;;;
;;; LOAD WINDOW: after tb2-sums.scm, TH3-B's hilbert-schmidt (th3b-hs: hs-sum-real-any-basis,
;;; hs-add, hs-scale, hs-sum-basis-independent, hs-sum-adjoint-eq, hs-adjoint), BA-BH / BA-BH2
;;; (bop-*, op-adjoint-*, ip-norm-*, cips-expand-scaled), BA-ONB3 (esum-sums-to-cc),
;;; BA-ONB2 (cc-family-sum-value, cc-nag-*), BA-ONB3's l2-families-2 (esum-real-add-le) and
;;; complete-transfer (cc-nag-complete), rake-asm-b2 (absolute-summable-implies-summable),
;;; th3-vocab-unfold.  Library: operator-algebras.
;;; ====================================================================

;;; ---- helper defines COPIED 2026-11-10 (integration) from th3-1109/b2/tb2-sums.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (tb2-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (tb2-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb2-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (tb2-close!)
  (cond ((not (tb2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tb2-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tb2-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tb2-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))))
(define (tb2-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (tb2-cc! (cadr t)) (tb2-cc! (caddr t))
         (tb2-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'conjugate))
         (tb2-cc! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (tb2-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t))
        (#t (error "tb2-cc!: cannot type in CC" (expression->string t)))))
(define (tb2-nag!)
  (if (not (dk-asm? '(IS-NORMED-AG CC-NAG))) (fact 'cc-nag-is-normed-ag))
  (if (not (dk-asm? '(== (CARR CC-NAG) CC))) (fact 'cc-nag@carr)))
(define (tb2-carr! form)          ; form mentions CC where CARR CC-NAG is wanted, given as the target
  (if (not (dk-asm? form))
      (dk-have! form (lambda () (subst '(= (CARR CC-NAG) CC)) (tb2-close!)))))
(define (tb2-pw dd h body-of)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ dd) (list '= (list h 'z_) (body-of 'z_)))))
(define (tb2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
;;; ---- end of copied helpers ----

(define (tb2-ns w y) (list '* (list 'IP-NORM w y) (list 'IP-NORM w y)))
(define (tb2-lam-ns w ix e t) (list 'VNB-LAMBDA 'kqk_ ix (tb2-ns w (list t (list e 'kqk_)))))
(define (tb2-Q w ix e s t) (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP w) (list s (list e 'kqk_)) (list t (list e 'kqk_)))))
(define (tb2-qsum w ix e s t) (list 'CC-FAMILY-SUM (tb2-Q w ix e s t)))
(define (tb2-hs v w ix e t) (list 'HS-SUM v w ix e t))
(define (tb2-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-cite! 'rr-pos-star-membership x)))
            (dk-only! inst (list 'IN x 'RR) (list '<= 0 x))
            (prop))))))

;;; the ONB projections
(define (tb2-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (if (not (dk-asm? onf)) (dk-project! onf 'is-orthonormal-basis onb))
    (if (not (dk-asm? (list 'IN e (list 'FUN ix (list 'VEC v)))))
        (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf))
    (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix (list 'VEC v) e))))
;;; IS-HILBERT-SCHMIDT(v, w, t) in context: t bounded, t in FUN(VEC v, VEC w)
(define (tb2-hs-bounded! v w t)
  (let ((bx (list 'IN t (list 'BOUNDED-OPS v w))))
    (if (not (dk-asm? bx))
        (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT v w t)))))
    (if (not (dk-asm? (list 'IN t (list 'FUN (list 'VEC v) (list 'VEC w))))) (fact 'bop-fun v w t))))
;;; the vector typings at the index k: e k in VEC v, (t (e k)) in VEC w for each t in TS
(define (tb2-pt! v w ix e ts k)
  (tb2-ap! e ix (list 'VEC v) k)
  (for-each (lambda (t) (tb2-ap! t (list 'VEC v) (list 'VEC w) (list e k))) ts))
;;; ||y||, ||y||^2 typed real and nonneg
(define (tb2-ns-type! w y)
  (let ((n (list 'IP-NORM w y)))
    (if (not (dk-asm? (list 'IN n 'RR))) (fact 'ip-norm-in-rr w y))
    (if (not (dk-asm? (list '<= 0 n))) (fact 'ip-norm-nonneg w y))
    (if (not (dk-asm? (list 'IN (tb2-ns w y) 'RR)))
        (begin (tb2-and! (list 'IN n 'RR) (list 'IN n 'RR)) (fact 'rr-mul-closed n n)))
    (if (not (dk-asm? (list '<= 0 (tb2-ns w y)))) (fact 'rr-sq-nonneg n))))
;;; the family k |-> ||t e_k||^2 : typed in FUN(ix, RR), nonneg, with its ESUM real when
;;; IS-HILBERT-SCHMIDT(v, w, t) is in context; returns the lambda
(define (tb2-nn-univ L ix) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ix) (list '<= 0 (list L 'z_)))))
(define (tb2-ns-fam! v w ix e t)
  (let ((L (tb2-lam-ns w ix e t)))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'RR))))
        (dk-have! (list 'IN L (list 'FUN ix 'RR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-pt! v w ix e (list t) k)
                  (tb2-ns-type! w (list t (list e k)))
                  (tb2-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'CC))))
        (dk-have! (list 'IN L (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-pt! v w ix e (list t) k)
                  (tb2-ns-type! w (list t (list e k)))
                  (tb2-cc! (tb2-ns w (list t (list e k))))
                  (tb2-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (tb2-nn-univ L ix)))
        (dk-have! (tb2-nn-univ L ix)
          (lambda ()
            (let ((k (dk-di-var!)))
              (tb2-pt! v w ix e (list t) k)
              (tb2-ns-type! w (list t (list e k)))
              (dk-lam-b!)
              (tb2-close!)))))
    
    (if (and (dk-asm? (list 'IS-HILBERT-SCHMIDT v w t)) (not (dk-asm? (list 'IN (list 'ESUM L) 'RR))))
        (let* ((r (tb2-cite! 'hs-sum-real-any-basis v w t ix e))
               (u (dk-cite! 'hs-sum-unfold v w ix e t)))
          (dk-rewrite-h! r (cadr u) (caddr u))))
    L))
;;; with ESUM L real: SUMS-TO CC-NAG L (ESUM L) (esum-sums-to-cc), L over ix
(define (tb2-ns-sums! L ix)
  (tb2-dom! L ix 'RR)
  (let ((nn (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'DOM L)) (list '<= 0 (list L 'z_))))))
    (if (not (dk-asm? nn))
        (dk-have! nn (lambda () (subst (list '= (list 'DOM L) ix)) (tb2-close!)))))
  (tb2-cite! 'esum-sums-to-cc L))

;;; the statement prefix: v, w Hilbert, s_, t_ Hilbert-Schmidt from v to w, (ix, e) an ONB of v
(define (tb2-st2 concl)
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e)) concl))))
(define (tb2-open-st2!)
  (dk-peel!)
  (fact 'hilbert-space-is-cips 'v)
  (fact 'hilbert-space-is-cips 'w)
  (tb2-onb! 'v 'ix 'e)
  (tb2-hs-bounded! 'v 'w 's_)
  (tb2-hs-bounded! 'v 'w 't_))

;;; ====================================================================
;;; hs-ip-family-sums  (th-main (3.12): the sum is well defined)
;;; ====================================================================
(define tb2-Qst (tb2-Q 'w 'ix 'e 's_ 't_))
(sp (make-wff (tb2-st2 (list 'AND (list 'IN (list 'CC-FAMILY-SUM tb2-Qst) 'CC)
                                  (list 'SUMS-TO 'CC-NAG tb2-Qst (list 'CC-FAMILY-SUM tb2-Qst))))))

(tb2-open-st2!)

(tb2-nag!)
(fact 'cc-nag@nrm)
(fact 'cc-nag-complete)
(define (tb2-ip-at k) (list '(IP w) (list 's_ (list 'e k)) (list 't_ (list 'e k))))
(define (tb2-ipt! k)
  (tb2-pt! 'v 'w 'ix 'e '(s_ t_) k)
  (if (not (dk-asm? (list 'IN (tb2-ip-at k) 'CC))) (fact 'cips-ip-type 'w (list 's_ (list 'e k)) (list 't_ (list 'e k)))))
(let* ((Q tb2-Qst)
       (F1 (tb2-ns-fam! 'v 'w 'ix 'e 's_))
       (F2 (tb2-ns-fam! 'v 'w 'ix 'e 't_)))
  
  (dk-have! (list 'IN Q '(FUN ix CC))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (tb2-ipt! k) (tb2-close!))) (lambda () (ass)))))
  
  (tb2-dom! Q 'ix 'CC)
  (dk-have! (list 'IS-ABSOLUTELY-SUMMABLE 'CC-NAG Q)
    (lambda ()
      
      (mac 'is-absolutely-summable)
      (subst (list '= (list 'DOM Q) 'ix))
      (subst '(== (NRM CC-NAG) (VNB-LAMBDA x_ CC (magnitude x_))))
      (let* ((N (cadr (cadr (dk-goal))))
             (Nval! (lambda (z)
                      (tb2-ipt! z)
                      (let ((m (list 'MAGNITUDE (tb2-ip-at z))))
                        (if (not (dk-asm? (list 'IN m 'RR))) (fact 'cc-magnitude-closed (tb2-ip-at z)))
                        (tb2-ap! Q 'ix 'CC z)
                        (dk-have! (list '= (list N z) m) (lambda () (dk-lam-b!) (tb2-close!)))
                        (subst (list '= (list N z) m))
                        m))))
        (dk-have! (list 'IN N '(FUN ix RR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                 (tb2-ipt! k)
                                                 (fact 'cc-magnitude-closed (tb2-ip-at k))
                                                 (tb2-ap! Q 'ix 'CC k)
                                                 (dk-lam-b!)
                                                 (tb2-close!)))
                                   (lambda () (ass)))))
        (dk-have! (tb2-nn-univ N 'ix)
          (lambda () (let ((z (dk-di-var!))) (Nval! z) (fact 'cc-magnitude-nonneg (tb2-ip-at z)) (tb2-close!))))
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list N 'z_) (list '+ (list F1 'z_) (list F2 'z_)))))
          (lambda ()
            (let* ((z (dk-di-var!))
                   (sz (list 's_ (list 'e z))) (tz (list 't_ (list 'e z)))
                   (m (Nval! z))
                   (n1 (list 'IP-NORM 'w sz)) (n2 (list 'IP-NORM 'w tz))
                   (p (list '* n1 n2)) (dl (list '- n1 n2)))
              (tb2-ns-type! 'w sz)
              (tb2-ns-type! 'w tz)
              (dk-lam-b!)
              (tb2-cite! 'cips-ip-magnitude-le 'w sz tz)
              (tb2-and! (list 'IN n1 'RR) (list 'IN n2 'RR))
              (fact 'rr-mul-closed n1 n2)
              (fact 'rr-sub-in-rr n1 n2)
              (tb2-and! (list 'IN dl 'RR) (list 'IN dl 'RR))
              (fact 'rr-mul-closed dl dl)
              (fact 'rr-sq-nonneg dl)
              (let ((ide (list '= (list '* dl dl) (list '- (list '+ (tb2-ns 'w sz) (tb2-ns 'w tz)) (list '* 2 p)))))
                (dk-have! ide (lambda () (crs)))
                (dk-rewrite-h! (list '<= 0 (list '* dl dl)) (list '* dl dl) (caddr ide))
                (if (tb2-open?)
                    (dk-ineq! (list '<= m p) (list '<= 0 (caddr ide))
                              (list '<= 0 (tb2-ns 'w sz)) (list '<= 0 (tb2-ns 'w tz))
                              (list 'IN m 'RR) (list 'IN p 'RR) (list 'IN (tb2-ns 'w sz) 'RR) (list 'IN (tb2-ns 'w tz) 'RR)))))))
        
        (dk-split-all! (list (tb2-cite! 'esum-real-add-le 'ix F1 F2 N)))
        (tb2-close!))))
  
  (tb2-and! '(IS-NORMED-AG CC-NAG) '(IS-COMPLETE (NAG-METRIC-SPACE CC-NAG)))
  (tb2-carr! (list 'IN Q (list 'FUN (list 'DOM Q) '(CARR CC-NAG))))
  (tb2-and! (list 'IN Q (list 'FUN (list 'DOM Q) '(CARR CC-NAG))) (list 'IS-ABSOLUTELY-SUMMABLE 'CC-NAG Q))
  (let* ((sm (dk-cite! 'absolute-summable-implies-summable 'CC-NAG Q))
         (r (dk-skolem! (dk-landed-1 (lambda () (mac-h 'is-summable sm))) #t)))
    (dk-have! (list 'IN r 'CC) (lambda () (subst '(= CC (CARR CC-NAG))) (tb2-close!)))
    (subst (tb2-cite! 'cc-family-sum-value Q r))
    (dk-conj-close! (lambda () (tb2-close!)))))
(tb2-done! 'hs-ip-family-sums)

;;; ====================================================================
;;; hs-sum-polar: sum ||(S + c T) e_i||^2 = sum ||S e_i||^2 + conj(c) q + c conj(q) + |c|^2 sum ||T e_i||^2
;;; with q = sum_i <S e_i | T e_i>; pointwise this is cips-expand-scaled, and the four families
;;; are combined by cc-sums-to-comb; the two sides are compared by sums-to-unique.
;;; ====================================================================
(define tb2-X '(BOP-SUM v w s_ (BOP-SCALE v w c_ t_)))
(define tb2-polar-rhs
  (list '+ (list '+ (tb2-hs 'v 'w 'ix 'e 's_) (list '* '(conjugate c_) (tb2-qsum 'w 'ix 'e 's_ 't_)))
           (list '+ (list '* 'c_ (list 'conjugate (tb2-qsum 'w 'ix 'e 's_ 't_)))
                    (list '* '(* c_ (conjugate c_)) (tb2-hs 'v 'w 'ix 'e 't_)))))
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(c_) '((IN c_ CC))
        (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
          (list '= (tb2-hs 'v 'w 'ix 'e tb2-X) tb2-polar-rhs)))))))
(tb2-open-st2!)
(tb2-nag!)
(let* ((sc '(BOP-SCALE v w c_ t_))
       (X tb2-X)
       (Q tb2-Qst)
       (qv (list 'CC-FAMILY-SUM Q)))
  (fact 'hs-scale 'v 'w 'c_ 't_)
  (fact 'hs-add 'v 'w 's_ sc)
  (tb2-hs-bounded! 'v 'w sc)
  (tb2-hs-bounded! 'v 'w X)
  (dk-split-all! (list (tb2-cite! 'hs-ip-family-sums 'v 'w 's_ 't_ 'ix 'e)))
  (let* ((NS (tb2-ns-fam! 'v 'w 'ix 'e 's_))
         (NT (tb2-ns-fam! 'v 'w 'ix 'e 't_))
         (NX (tb2-ns-fam! 'v 'w 'ix 'e X))
         (PS (list 'ESUM NS)) (PT (list 'ESUM NT)) (PX (list 'ESUM NX))
         (c1 1) (c2 '(conjugate c_)) (c3 'c_) (c4 '(* c_ (conjugate c_))))
    (tb2-ns-sums! NS 'ix)
    (tb2-ns-sums! NT 'ix)
    (tb2-ns-sums! NX 'ix)
    (dk-have! (list 'IN Q '(FUN ix CC))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (tb2-ipt! k) (tb2-close!))) (lambda () (ass)))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (for-each tb2-cc! (list 1 c2 c3 c4 PS PT qv))
    ;; the pointwise expansion NX z = (1 NS z + conj(c) Q z) + (c conj(Q z) + |c|^2 NT z)
    (dk-have! (tb2-pw 'ix NX (lambda (z) (list '+ (list '+ (list '* c1 (list NS z)) (list '* c2 (list Q z)))
                                                 (list '+ (list '* c3 (list 'conjugate (list Q z))) (list '* c4 (list NT z))))))
      (lambda ()
        (let* ((z (dk-di-var!))
               (ez (list 'e z)) (p (list 's_ ez)) (tq (list 't_ ez)) (xz (list X ez))
               (ctq (list '(ACT w) 'c_ tq)))
          (tb2-pt! 'v 'w 'ix 'e (list 's_ 't_ sc X) z)
          (tb2-ipt! z)
          (tb2-ns-type! 'w p) (tb2-ns-type! 'w tq) (tb2-ns-type! 'w xz)
          (dk-lam-b!)
          (subst (dk-cite! 'ip-norm-sq 'w xz))
          (subst (dk-cite! 'ip-norm-sq 'w p))
          (subst (dk-cite! 'ip-norm-sq 'w tq))
          (subst (tb2-cite! 'bop-sum-apply 'v 'w 's_ sc ez))
          (subst (tb2-cite! 'bop-scale-apply 'v 'w 'c_ 't_ ez))
          (subst (tb2-cite! 'cips-expand-scaled 'w 'c_ p tq))
          (subst (tb2-cite! 'cips-ip-conj-sym 'w p tq))
          (fact 'cips-ip-type 'w p p)
          (fact 'cips-ip-type 'w tq tq)
          (tb2-cc! (list 'conjugate (list '(IP w) p tq)))
          (crs))))
    (tb2-cite! 'cc-sums-to-comb 'ix NS Q NT NX PS qv PT c1 c2 c3 c4)
    (let* ((V (list '+ (list '+ (list '* c1 PS) (list '* c2 qv)) (list '+ (list '* c3 (list 'conjugate qv)) (list '* c4 PT)))))
      (tb2-dom! NX 'ix 'RR)
      (dk-have! (list 'IN NX (list 'FUN (list 'DOM NX) '(CARR CC-NAG)))
        (lambda () (subst '(= (CARR CC-NAG) CC)) (subst (list '= (list 'DOM NX) 'ix)) (tb2-close!)))
      (tb2-cc! PX)
      (tb2-cc! V)
      (tb2-carr! (list 'IN PX '(CARR CC-NAG)))
      (tb2-carr! (list 'IN V '(CARR CC-NAG)))
      (tb2-and! (list 'SUMS-TO 'CC-NAG NX PX) (list 'SUMS-TO 'CC-NAG NX V))
      (let ((un (tb2-cite! 'sums-to-unique 'CC-NAG NX PX V)))
        (subst (dk-cite! 'hs-sum-unfold 'v 'w 'ix 'e X))
        (subst (dk-cite! 'hs-sum-unfold 'v 'w 'ix 'e 's_))
