;;; lebesgue-interval-length.scm -- THE LEBESGUE OUTER MEASURE OF AN INTERVAL IS ITS
;;; LENGTH.  Agent MEASURE-3-B, 2026-10-09 (scratchpad/triage/MEASURE-3-B.md).
;;; Library: measure.  Helper prefix lil-.  No definition, no support, no stamp.
;;;
;;; lam* is written as MEASURE-2 writes it (theorem-library/outer-measure-
;;; construction.scm): METHOD-I-OUTER(RR, CLOSED-INTERVALS, VNB-LAMBDA s
;;; CLOSED-INTERVALS (INTERVAL-LENGTH s)), INTERVAL-LENGTH the diameter.
;;;
;;; THE RESULTS
;;;   lebesgue-outer-ccint      lam*([a, b]) = b - a           (a <= b real)
;;;   lebesgue-outer-point      lam*({x}) = 0
;;;   lebesgue-outer-empty      lam*(empty) = 0
;;;   lebesgue-outer-ooint, -coint, -ocint   the same for (a,b), [a,b), (a,b]
;;;   lebesgue-outer-between    any set between [a,b] less its endpoints and [a,b]
;;;   lebesgue-outer-mono       monotonicity on sets of reals
;;;   lebesgue-outer-translate  lam*(es + c) = lam*(es), es a set of reals, c real;
;;;                             the translate es + c is written out as the SEP
;;;                             { z in RR : z - c in es } (the tree has no translate
;;;                             of a set of reals; none is defined here)
;;;   lebesgue-outer-translate-le, translate-closed-interval,
;;;   interval-length-translate-le   its bricks
;;; THE COVERING LEMMA (the >= half), stated for ARBITRARY sets of reals:
;;;   ccint-cover-sum-ge        a countable cover of [a, b] by sets of reals has
;;;                             total diameter >= b - a
;;;   ccint-cover-widened-sum   the same with each set widened to its open
;;;                             he 2^-(n+1)-neighbourhood
;;; AND THE BRICKS: interval-length-{unfold,type,mono,extend,widen},
;;;   rps-prefix-mono-range, rps-prefix-bump, rr-near-center-half, subset-rr-in-power-rr.
;;;
;;; THE ROUTE, AND WHERE IT LEAVES THE BRIEF.  The brief proposed Heine-Borel plus a
;;; finite lemma on open intervals (induction on their number).  The proof here uses
;;; neither: it creeps (ccint-creep, the tree's one creeping principle) along [a, b]
;;; with the set
;;;    G = { x in [a,b] : for every z in [a,x], z - a <= some prefix sum
;;;          sum_{n < m} diam(W_n intersected with (-inf, z]) }
;;; where W_n is the open r_n-neighbourhood of the n-th covering set, r_n = he 2^-(n+1).
;;; The local step at t in fs(k) needs only that W_k contains (t - r_k, t + r_k), which
;;; is the definition of W_k: NO ENDPOINTS of the covering intervals are ever read
;;; (so no countable choice of endpoints), and no finite subcover, finite family or
;;; re-indexing is formed.  The prefix sum grows by z - w at index k
;;; (interval-length-extend) and does not shrink elsewhere (interval-length-mono);
;;; rps-prefix-bump turns the two into the prefix inequality.  At b the prefix sum
;;; is <= sum diam(W_n) <= sum (diam fs(n) + 2 r_n) (interval-length-widen)
;;; <= sum diam fs(n) + 2 he, and he is half of an arbitrary eps.
;;; The other intervals: lam*(X) <= lam*([a,b]) by monotonicity, and
;;; lam*([a,b]) <= lam*(X) + lam*({a}) + lam*({b}) by binary subadditivity.
;;;
;;; LOAD WINDOW: after "theorem-library/outer-measure-construction" (load.scm 3483):
;;; lebesgue-premeasure, lebesgue-outer-measure, method-i-outer-value,
;;; method-i-outer-le-single, cover-sums-subset/-elim, interval-length-ccint,
;;; esum-nn-add-le, dyadic-eps-type, dyadic-eps-sum-le are there; caratheodory
;;; (3478) gives outer-measure-binary-subadditive; everything else is earlier
;;; (ccint-creep 2640, measure-laws 3386, limsup-tests, rake-extended-order 1207,
;;; field-ring-view 1221, interval-calculus-laws 2967, one-sided-derivative-laws).
;;; Nothing in the tree cites these names.  libraries.sexp: measure.
;;; ====================================================================

;;; =====================================================================
;;; (0) file-local kit (lil- prefix; several copied from the omc- kit of
;;;     outer-measure-construction.scm, which loads in its own environment).
;;; =====================================================================

(define (lil-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (lil-and3! p q r)
  (dk-have! (list 'AND p (list 'AND q r)) (lambda () (dk-conj-close! dk-ass!))))

;;; x <= z from x <= y, y <= z, all in [0, +inf]
(define (lil-trans! x y z)
  (lil-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (lil-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))

;;; x = y in [0, +inf] from x <= y, y <= x
(define (lil-antisymm! x y)
  (lil-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (lil-and2! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))

;;; (IN t RR-POS-STAR) from (IN t RR) and (<= 0 t) in context
(define (lil-rps! t)
  (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
      (dk-have! (list 'IN t 'RR-POS-STAR)
        (lambda ()
          (mac 'rr-pos-star-membership)
          (oi-l)
          (dk-conj-close! dk-ass!)))))

;;; the set of differences whose ESUP is INTERVAL-LENGTH(s), as the functoid unfolds
(define (lil-dset s)
  (list 'SEP 'odv_ 'RR-POS-STAR
        (list 'OR '(= odv_ 0)
              (list 'FORSOME 'odx_ (list 'AND (list 'IN 'odx_ s)
                (list 'FORSOME 'ody_ (list 'AND (list 'IN 'ody_ s) '(AND (<= odx_ ody_) (= odv_ (- ody_ odx_))))))))))
(define (lil-il s) (list 'INTERVAL-LENGTH s))

;;; (SUBSET D(s) RR-POS-STAR)
(define (lil-dset-sub! s)
  (if (not (dk-asm? (list 'SUBSET (lil-dset s) 'RR-POS-STAR)))
      (dk-have! (list 'SUBSET (lil-dset s) 'RR-POS-STAR)
        (lambda () (mac 'subset-def)
          (let ((wv (dk-di-var!))) (sep-me (list 'IN wv (lil-dset s))) (dk-split-all!) (ass))))))

;;; the cases of a member XV of D(s): run ZERO with (= xv 0) in context, PAIR with the
;;; two endpoints (x0 y0) landed and split: (IN x0 s) (IN y0 s) (<= x0 y0) (= xv (- y0 x0))
(define (lil-dcases! xv s zero pair)
  (sep-me (list 'IN xv (lil-dset s)))
  (dk-split-all!)
  (let ((orf (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h xv))) "the cases")))
    (use-cases (list (cadr orf) (caddr orf))
      zero
      (lambda ()
        (let* ((x0 (dk-skolem! (caddr orf) 'top))
               (_ (dk-split-all!))
               (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x0))) "y"))
               (y0 (dk-skolem! ex 'top)))
          (dk-split-all!)
          (pair x0 y0))))))

;;; (IN (- y x) D(s)) from x, y in s, x <= y, the difference typed in RR-POS-STAR
(define (lil-diff-in! s x y)
  (dk-have! (list 'IN (list '- y x) (lil-dset s))
    (lambda ()
      (in-sep! dk-ass!
        (lambda () (oi-r) (ew x)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew y) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))))))))

;;; the IFF case split of a member of RR-POS-STAR: REAL runs with (IN e RR) (<= 0 e),
;;; INF with (= e POS-INF)
(define (lil-rps-cases! e real inf)
  (let ((iff (dk-cite! 'rr-pos-star-membership e)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (let ((orf (caddr iff)))
      (use-cases (list (cadr orf) (caddr orf))
        (lambda () (dk-split-all! (list (cadr orf))) (real))
        inf))))

;;; =====================================================================
;;; (1) INTERVAL-LENGTH, the diameter: unfold, typing, monotonicity.
;;; =====================================================================

(sp (make-wff (list 'FORALL 'ils_ (list '== (lil-il 'ils_) (list 'ESUP (lil-dset 'ils_))))))
(di)
(mac 'INTERVAL-LENGTH)
(qrfl)
(qed 'interval-length-unfold)
(topic! 'interval-length-unfold 'plumbing)

(sp (make-wff '(FORALL ils_ (IN (INTERVAL-LENGTH ils_) RR-POS-STAR))))
(di)
(mac 'INTERVAL-LENGTH)
(lil-dset-sub! 'ils_)
(fact 'esup-in (lil-dset 'ils_))
(ass)
(qed 'interval-length-type)
(topic! 'interval-length-type 'inequalities)

;;; the diameter is monotone
(sp (make-wff (forall-guarded '(aa bb) '((SUBSET aa bb))
   '(<= (INTERVAL-LENGTH aa) (INTERVAL-LENGTH bb)))))
(dk-peel!)
(mac 'INTERVAL-LENGTH)
(let* ((da (lil-dset 'aa)) (db (lil-dset 'bb)) (eb (list 'ESUP db)))
  (lil-dset-sub! 'aa)
  (lil-dset-sub! 'bb)
  (fact 'esup-in db)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x da) (list '<= 'x eb)))
    (lambda ()
      (let ((xv (dk-di-var!)))
        (dk-have! (list 'IN xv db)
          (lambda ()
            (lil-dcases! xv 'aa
              (lambda () (fact 'zero-in-rr-pos-star) (subst (list '= xv 0))
                         (in-sep! dk-ass! (lambda () (oi-l) (rfl))))
              (lambda (x0 y0)
                (fact 'subset-mem-fwd 'aa 'bb x0)
                (fact 'subset-mem-fwd 'aa 'bb y0)
                (subst (list '= xv (list '- y0 x0)))
                (dk-have! (list 'IN (list '- y0 x0) 'RR-POS-STAR) (lambda () (subst (list '= (list '- y0 x0) xv)) (ass)))
                (in-sep! dk-ass!
                  (lambda () (oi-r) (ew x0)
                    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew y0) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))))))
        (fact 'esup-upper db xv)
        (ass))))
  (lil-and2! (list 'IN eb 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x da) (list '<= 'x eb))))
  (fact 'esup-least da eb)
  (ass))
(qed 'interval-length-mono)
(topic! 'interval-length-mono 'inequalities)
;;; =====================================================================
;;; (2) two estimates on diameters.
;;; =====================================================================

;;; EXTENDING TO THE RIGHT.  If aa lies inside bb and to the left of w, and bb
;;; contains w and z >= w, then diam(aa) + (z - w) <= diam(bb).
(sp (make-wff (forall-guarded '(aa bb w_ z_)
   '((SUBSET bb RR) (SUBSET aa bb) (IN w_ RR) (IN z_ RR) (<= w_ z_) (IN w_ bb) (IN z_ bb)
     (FORALL lx_ (IMPLIES (IN lx_ aa) (<= lx_ w_))))
   '(<= (eplus (INTERVAL-LENGTH aa) (- z_ w_)) (INTERVAL-LENGTH bb)))))
(dk-peel!)
(mac 'INTERVAL-LENGTH)
(let* ((da (lil-dset 'aa)) (db (lil-dset 'bb)) (ea (list 'ESUP da)) (eb (list 'ESUP db))
       (c '(- z_ w_))
       (hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'w_))) "the bound")))
  (lil-dset-sub! 'aa)
  (lil-dset-sub! 'bb)
  (fact 'esup-in da)
  (fact 'esup-in db)
  (dk-have! (list 'IN c 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! '(IN w_ RR) '(IN z_ RR) '(<= w_ z_))))
  (lil-rps! c)
  (lil-diff-in! 'bb 'w_ 'z_)
  (fact 'esup-upper db c)
  (lil-rps-cases! eb
    (lambda ()
      (let ((mp (list '- eb c)))
        (dk-have! (list 'IN mp 'RR) (lambda () (type-term)))
        (dk-have! (list '<= 0 mp) (lambda () (dk-ineq! (list 'IN eb 'RR) (list 'IN c 'RR) (list '<= c eb))))
        (lil-rps! mp)
        (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x da) (list '<= 'x mp)))
          (lambda ()
            (let ((xv (dk-di-var!)))
              (lil-dcases! xv 'aa
                (lambda () (subst (list '= xv 0)) (dk-ineq! (list 'IN mp 'RR) (list '<= 0 mp)))
                (lambda (x0 y0)
                  (fact 'subset-mem-fwd 'aa 'bb x0)
                  (fact 'subset-mem-fwd 'aa 'bb y0)
                  (fact 'subset-mem-fwd 'bb 'RR x0)
                  (fact 'subset-mem-fwd 'bb 'RR y0)
                  (dk-apply! hyp y0)
                  (let ((d0 (list '- 'z_ x0)))
                    (dk-have! (list 'IN d0 'RR) (lambda () (type-term)))
                    (dk-have! (list '<= x0 'z_) (lambda () (dk-ineq! (list 'IN x0 'RR) (list 'IN y0 'RR) '(IN w_ RR) '(IN z_ RR)
                                                                 (list '<= x0 y0) (list '<= y0 'w_) '(<= w_ z_))))
                    (dk-have! (list '<= 0 d0) (lambda () (dk-ineq! (list 'IN x0 'RR) '(IN z_ RR) (list '<= x0 'z_))))
                    (lil-rps! d0)
                    (lil-diff-in! 'bb x0 'z_)
                    (fact 'esup-upper db d0)
                    (dk-have! (list 'IN xv 'RR) (lambda () (subst (list '= xv (list '- y0 x0))) (type-term)))
                    (dk-ineq! (list 'IN xv 'RR) (list 'IN eb 'RR) (list 'IN x0 'RR) (list 'IN y0 'RR) '(IN w_ RR) '(IN z_ RR)
                              (list '= xv (list '- y0 x0)) (list '<= y0 'w_) (list '<= d0 eb))))))))
        (lil-and2! (list 'IN mp 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x da) (list '<= 'x mp))))
        (fact 'esup-least da mp)
        (lil-and2! (list 'IN ea 'RR-POS-STAR) (list 'IN mp 'RR))
        (fact 'rr-pos-star-le-real-in-rr ea mp)
        (fact 'rr-pos-star-nonneg ea)
        (let ((e1 (dk-cite! 'eplus-real-defined ea c)))
          (subst e1)
          (dk-ineq! (list 'IN ea 'RR) (list 'IN eb 'RR) '(IN w_ RR) '(IN z_ RR) (list '<= ea mp)))))
    (lambda ()
      (subst (list '= eb 'POS-INF))
      (lil-and2! (list 'IN ea 'RR-POS-STAR) (list 'IN c 'RR-POS-STAR))
      (fact 'eplus-closed ea c)
      (fact 'rr-pos-star-below-pos-inf (list 'eplus ea c))
      (ass))))
(qed 'interval-length-extend)
(topic! 'interval-length-extend 'inequalities)

;;; THE r-NEIGHBOURHOOD of a set of reals, written out: the reals within r of a member.
(define (lil-nb s r)
  (list 'SEP 'nbz_ 'RR (list 'FORSOME 'nbu_ (list 'AND (list 'IN 'nbu_ s)
                                                 (list 'AND (list '< '(- nbz_ nbu_) r) (list '< '(- nbu_ nbz_) r))))))

;;; WIDENING.  The r-neighbourhood of a set of reals has diameter at most diam + 2r.
(sp (make-wff (forall-guarded '(es r_) '((SUBSET es RR) (IN r_ RR) (< 0 r_))
   (list '<= (lil-il (lil-nb 'es 'r_)) '(eplus (INTERVAL-LENGTH es) (eplus r_ r_))))))
(dk-peel!)
(mac 'INTERVAL-LENGTH)
(let* ((w (lil-nb 'es 'r_)) (dw (lil-dset w)) (ds (lil-dset 'es)) (ew_ (list 'ESUP dw)) (es_ (list 'ESUP ds))
       (rr2 '(eplus r_ r_)))
  (lil-dset-sub! w)
  (lil-dset-sub! 'es)
  (fact 'esup-in dw)
  (fact 'esup-in ds)
  (dk-have! '(<= 0 r_) (lambda () (dk-ineq! '(IN r_ RR) '(< 0 r_))))
  (lil-rps! 'r_)
  (let ((e2 (dk-cite! 'eplus-real-defined 'r_ 'r_)))
    (subst e2))
  (dk-have! '(IN (binplus r_ r_) RR) (lambda () (type-term)))
  (dk-have! '(<= 0 (binplus r_ r_)) (lambda () (dk-ineq! '(IN r_ RR) '(< 0 r_))))
  (lil-rps! '(binplus r_ r_))
  (lil-rps-cases! es_
    (lambda ()
      (let ((tt (list 'binplus es_ '(binplus r_ r_))))
        (dk-have! (list 'IN tt 'RR) (lambda () (type-term)))
        (dk-have! (list '<= 0 tt) (lambda () (dk-ineq! (list 'IN es_ 'RR) (list '<= 0 es_) '(IN r_ RR) '(< 0 r_))))
        (lil-rps! tt)
        (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x dw) (list '<= 'x tt)))
          (lambda ()
            (let ((xv (dk-di-var!)))
              (lil-dcases! xv w
                (lambda () (subst (list '= xv 0)) (dk-ineq! (list 'IN tt 'RR) (list '<= 0 tt)))
                (lambda (x0 y0)
                  (let ((unpack (lambda (p)
                                  (sep-me (list 'IN p w))
                                  (dk-split-all!)
                                  (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h p))) "the centre"))
                                         (u (dk-skolem! ex)))
                                    (fact 'subset-mem-fwd 'es 'RR u)
                                    u))))
                    (let* ((u0 (unpack x0)) (u1 (unpack y0))
                           (orf (dk-cite! 'rr-le-total u0 u1)))
                      (dk-have! (list 'IN xv 'RR) (lambda () (subst (list '= xv (list '- y0 x0))) (type-term)))
                      (fact 'rr-pos-star-nonneg es_)
                      (use-cases (list (cadr orf) (caddr orf))
                        (lambda ()
                          (dk-have! (list 'IN (list '- u1 u0) 'RR) (lambda () (type-term)))
                          (dk-have! (list '<= 0 (list '- u1 u0)) (lambda () (dk-ineq! (list 'IN u0 'RR) (list 'IN u1 'RR) (list '<= u0 u1))))
                          (lil-rps! (list '- u1 u0))
                          (lil-diff-in! 'es u0 u1)
                          (fact 'esup-upper ds (list '- u1 u0))
                          (dk-ineq! (list 'IN xv 'RR) (list 'IN es_ 'RR) (list 'IN x0 'RR) (list 'IN y0 'RR)
                                    (list 'IN u0 'RR) (list 'IN u1 'RR) '(IN r_ RR)
                                    (list '= xv (list '- y0 x0))
                                    (list '< (list '- x0 u0) 'r_) (list '< (list '- u0 x0) 'r_)
                                    (list '< (list '- y0 u1) 'r_) (list '< (list '- u1 y0) 'r_)
                                    (list '<= (list '- u1 u0) es_)))
                        (lambda ()
                          (dk-ineq! (list 'IN xv 'RR) (list 'IN es_ 'RR) (list 'IN x0 'RR) (list 'IN y0 'RR)
                                    (list 'IN u0 'RR) (list 'IN u1 'RR) '(IN r_ RR)
                                    (list '= xv (list '- y0 x0))
                                    (list '< (list '- x0 u0) 'r_) (list '< (list '- u0 x0) 'r_)
                                    (list '< (list '- y0 u1) 'r_) (list '< (list '- u1 y0) 'r_)
                                    (list '<= u1 u0) (list '<= 0 es_)))))))))))
        (lil-and2! (list 'IN tt 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x dw) (list '<= 'x tt))))
        (fact 'esup-least dw tt)
        (let ((e3 (dk-cite! 'eplus-real-defined es_ '(binplus r_ r_))))
          (subst e3)
          (ass))))
    (lambda ()
      (subst (list '= es_ 'POS-INF))
      (fact 'eplus-pos-inf-left '(binplus r_ r_))
      (subst (list '= (list 'eplus 'POS-INF '(binplus r_ r_)) 'POS-INF))
      (fact 'rr-pos-star-below-pos-inf ew_)
      (ass))))
(qed 'interval-length-widen)
(topic! 'interval-length-widen 'inequalities)
;;; =====================================================================
;;; (3) prefix sums in [0, +inf]: monotone in the length; a bump at one index.
;;; =====================================================================

(define (lil-fs f n) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID f (list 'ORD-SEGMENT n)))

;;; seg(n) is a finite set
(define (lil-seg-finite! nv)
  (let ((sv (list 'ORD-SEGMENT nv)))
    (if (not (dk-asm? (list 'IN (list 'CARD sv) 'NN)))
        (begin
          (fact 'nn-subset-ord nv)
          (fact 'ord-segment-is-set nv)
          (fact 'card-segment nv)
          (dk-have! (list 'IN (list 'CARD sv) 'NN) (lambda () (subst (list '= (list 'CARD sv) nv)) (ass)))))))
;;; z in seg(n) gives z in NN and z < n
(define (lil-seg-mem! nv zv)
  (fact 'ord-segment-nn-subset nv zv)
  (let ((iff (dk-cite! 'seg-mem-lt nv zv)))
    (dk-project! (list '< zv nv) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))
;;; x in NN, x < n gives x in seg(n)
(define (lil-into-seg! nv xv)
  (let ((iff (dk-cite! 'seg-mem-lt nv xv)))
    (dk-have! (list 'IN xv (list 'ORD-SEGMENT nv))
      (lambda () (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff))) (ass)))))

(sp (make-wff (forall-guarded '(f m_ n_) '((IN f (FUN NN RR-POS-STAR)) (IN m_ NN) (IN n_ NN) (<= m_ n_))
   (list '<= (lil-fs 'f 'm_) (lil-fs 'f 'n_)))))
(dk-peel!)
(lil-seg-finite! 'n_)
(dk-have! '(SUBSET (ORD-SEGMENT m_) (ORD-SEGMENT n_))
  (lambda ()
    (mac 'subset-def)
    (let ((jv (dk-di-var!)))
      (lil-seg-mem! 'm_ jv)
      (dk-have! (list '< jv 'n_) (lambda () (dk-nn! (list '< jv 'm_) '(<= m_ n_))))
      (lil-into-seg! 'n_ jv))))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ (ORD-SEGMENT n_)) (IN (f z_) RR-POS-STAR)))
  (lambda ()
    (let ((zv (dk-di-var!)))
      (fact 'ord-segment-nn-subset 'n_ zv)
      (fact 'fun-apply-type-c 'f 'NN 'RR-POS-STAR zv)
      (ass))))
(fact 'rps-finsum-mono-set 'f '(ORD-SEGMENT m_) '(ORD-SEGMENT n_))
(ass)
(qed 'rps-prefix-mono-range)
(topic! 'rps-prefix-mono-range 'inequalities)

;;; THE BUMP.  f <= g pointwise and f(k) + c <= g(k): every prefix through k gains c.
(sp (make-wff (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
   (list 'FORALL 'k (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'c_
     (list 'IMPLIES '(IN k NN)
     (list 'IMPLIES '(IN f (FUN NN RR-POS-STAR))
     (list 'IMPLIES '(IN g (FUN NN RR-POS-STAR))
     (list 'IMPLIES '(IN c_ RR-POS-STAR)
     (list 'IMPLIES '(FORALL q (IMPLIES (IN q NN) (<= (f q) (g q))))
     (list 'IMPLIES '(<= (eplus (f k) c_) (g k))
     (list 'IMPLIES '(< k n_)
       (list '<= (list 'eplus (lil-fs 'f 'n_) 'c_) (lil-fs 'g 'n_)))))))))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (let* ((landed (dk-peel!))
               (lt (find-first (lambda (f) (dk-head-is? f '<)) landed))
               (kv (cadr lt)))
          (dk-have! '(< 0 0) (lambda () (dk-nn! lt)))
          (fact 'rr-zero-in)
          (fact 'rr-lt-irrefl 0)
          (ai '(NOT (< 0 0))))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (nv (cadr nin))
               (ih (dk-landed-1 (lambda () (di))))
               (hs (dk-peel!))
               (g0 (dk-goal))
               (fv (caddr (cadr (cadr g0))))
               (cv (caddr (cadr g0)))
               (gv (caddr (caddr g0)))
               (lt (find-first (lambda (f) (dk-head-is? f '<)) hs))
               (kv (cadr lt))
               (pf (lil-fs fv nv)) (pg (lil-fs gv nv))
               (ptw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (pair? (caddr h)) (eq? (car (caddr h)) 'IMPLIES)
                                              (dk-head-is? (caddr (caddr h)) '<=))) "pointwise")))
          (fact 'rps-prefix-succ fv nv)
          (fact 'rps-prefix-succ gv nv)
          (subst (list '= (lil-fs fv (list 'succ nv)) (list 'eplus pf (list fv nv))))
          (subst (list '= (lil-fs gv (list 'succ nv)) (list 'eplus pg (list gv nv))))
          (fact 'rps-prefix-type fv nv)
          (fact 'rps-prefix-type gv nv)
          (fact 'fun-apply-type-c fv 'NN 'RR-POS-STAR nv)
          (fact 'fun-apply-type-c gv 'NN 'RR-POS-STAR nv)
          (dk-apply! ptw nv)
          (use-em (list '= kv nv)
            (lambda ()
              (let ((bump (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h cv) (dk-contains? h kv))) "the bump")))
                (dk-rewrite-h! bump kv nv))
              (fact 'rps-prefix-le-termwise nv fv gv)
              (lil-and2! (list 'IN (list fv nv) 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR))
              (fact 'eplus-closed (list fv nv) cv)
              (lil-and3! (list 'IN pf 'RR-POS-STAR) (list 'IN (list fv nv) 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR))
              (fact 'eplus-assoc pf (list fv nv) cv)
              (subst (list '= (list 'eplus (list 'eplus pf (list fv nv)) cv) (list 'eplus pf (list 'eplus (list fv nv) cv))))
              (dk-have! (list 'AND (list 'IN pf 'RR-POS-STAR)
                              (list 'AND (list 'IN (list 'eplus (list fv nv) cv) 'RR-POS-STAR)
                                    (list 'AND (list 'IN pg 'RR-POS-STAR) (list 'IN (list gv nv) 'RR-POS-STAR))))
                (lambda () (dk-conj-close! dk-ass!)))
              (lil-and2! (list '<= pf pg) (list '<= (list 'eplus (list fv nv) cv) (list gv nv)))
              (fact 'eplus-mono pf (list 'eplus (list fv nv) cv) pg (list gv nv))
              (ass))
            (lambda ()
              (fact 'nn-in-rr kv)
              (fact 'nn-in-rr nv)
              (fact 'nn-succ-closed nv)
              (let ((sl (dk-cite! 'nn-lt-succ-le kv (list 'succ nv))))
                (dk-have! (list '<= kv nv) (lambda () (dk-nn! sl))))
              (lil-and2! (list '<= kv nv) (list 'NOT (list '= kv nv)))
              (fact 'rr-le-ne-lt kv nv)
              (dk-apply! ih kv fv gv cv)
              (let ((pfc (list 'eplus pf cv)))
                (lil-and3! (list 'IN pf 'RR-POS-STAR) (list 'IN (list fv nv) 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR))
                (fact 'eplus-assoc pf (list fv nv) cv)
                (lil-and2! (list 'IN (list fv nv) 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR))
                (fact 'eplus-comm (list fv nv) cv)
                (lil-and3! (list 'IN pf 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR) (list 'IN (list fv nv) 'RR-POS-STAR))
                (fact 'eplus-assoc pf cv (list fv nv))
                (subst (list '= (list 'eplus (list 'eplus pf (list fv nv)) cv) (list 'eplus pf (list 'eplus (list fv nv) cv))))
                (subst (list '= (list 'eplus (list fv nv) cv) (list 'eplus cv (list fv nv))))
                (subst (list '= (list 'eplus pf (list 'eplus cv (list fv nv))) (list 'eplus pfc (list fv nv))))
                (lil-and2! (list 'IN pf 'RR-POS-STAR) (list 'IN cv 'RR-POS-STAR))
                (fact 'eplus-closed pf cv)
                (dk-have! (list 'AND (list 'IN pfc 'RR-POS-STAR)
                                (list 'AND (list 'IN (list fv nv) 'RR-POS-STAR)
                                      (list 'AND (list 'IN pg 'RR-POS-STAR) (list 'IN (list gv nv) 'RR-POS-STAR))))
                  (lambda () (dk-conj-close! dk-ass!)))
                (lil-and2! (list '<= pfc pg) (list '<= (list fv nv) (list gv nv)))
                (fact 'eplus-mono pfc (list fv nv) pg (list gv nv))
                (ass)))))))
  (dk-opened (lambda () (ni))))
(qed 'rps-prefix-bump)
(topic! 'rps-prefix-bump 'inequalities)
;;; =====================================================================
;;; (4) THE COVERING LEMMA, by creeping along [a, b] (ccint-creep).
;;; =====================================================================

;;; DOM f = NN and f in FUN(DOM f, RR-POS-STAR); then ESUM f typed (omc-dom!)
(define (lil-esum-type! fv)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin
        (fact 'nn-is-set)
        (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
        (lil-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
        (fact 'dom-of-fun 'NN fv)
        (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                                (list '= (list 'DOM fv) 'NN)))))
        (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
                  (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
        (fact 'esum-in fv))))

;;; a point within d of t, d + d = r, is within r of t (strictly, both ways)
(sp (make-wff (forall-guarded '(t_ d_ r_ w_)
   '((IN t_ RR) (IN d_ RR) (IN r_ RR) (IN w_ RR) (< 0 d_) (= (+ d_ d_) r_) (< (- t_ d_) w_) (<= w_ (+ t_ d_)))
   '(AND (< (- w_ t_) r_) (< (- t_ w_) r_)))))
(dk-peel!)
(dk-conj-close!
  (lambda ()
    (dk-ineq! '(IN t_ RR) '(IN d_ RR) '(IN r_ RR) '(IN w_ RR) '(< 0 d_) '(= (+ d_ d_) r_) '(< (- t_ d_) w_) '(<= w_ (+ t_ d_)))))
(qed 'rr-near-center-half)
(topic! 'rr-near-center-half 'inequalities)

;;; the radius at index n: e * 2^-(n+1)
(define (lil-r-e e n) (list '* e (list 'recip (list 'power 2 (list 'succ n)))))
(define (lil-r n) (lil-r-e 'he n))
;;; with (IN e RR), (< 0 e) in context: (IN r_k RR), (< 0 r_k), and its RR-POS-STAR typing
(define (lil-w-facts-e! e k)
  (let* ((sk (list 'succ k)) (p (list 'power 2 sk)) (w (list 'recip p)) (ewt (lil-r-e e k)))
    (if (not (dk-asm? (list '< 0 ewt)))
        (begin
          (fact 'nn-succ-closed k)
          (dk-have! '(IN 2 RR) (lambda () (arith)))
          (fact 'power-real-closed 2 sk)
          (fact 'power-two-pos sk)
          (dk-have! (list 'NOT (list '= p 0)) (lambda () (di) (dk-absurd! (list '= p 0) (list '< 0 p))))
          (lil-and2! (list 'IN p 'RR) (list 'NOT (list '= p 0)))
          (fact 'rr-recip-closed p)
          (fact 'rr-recip-pos p)
          (fact 'rr-mul-pos e w)
          (dk-have! (list 'IN ewt 'RR) (lambda () (type-term)))
          (dk-have! (list '<= 0 ewt) (lambda () (dk-ineq! (list '< 0 ewt))))
          (lil-rps! ewt)))))
(define (lil-w-facts! k) (lil-w-facts-e! 'he k))

;;; the neighbourhood at n, its part left of x, the two families of diameters
(define (lil-nbn n) (lil-nb (list 'fs n) (lil-r n)))
(define (lil-trunc n x) (list 'SEP 'lfz_ (lil-nbn n) (list '<= 'lfz_ x)))
(define (lil-phi x) (list 'VNB-LAMBDA 'lfn_ 'NN (lil-il (lil-trunc 'lfn_ x))))
(define lil-nbl (list 'VNB-LAMBDA 'lnn_ 'NN (lil-il (lil-nbn 'lnn_))))
(define (lil-p m x) (lil-fs (lil-phi x) m))
(define lil-g
  (list 'SEP 'lgx_ 'RR
        (list 'AND '(<= a_ lgx_)
              (list 'AND '(<= lgx_ b_)
                    (list 'FORALL 'lgy_ (list 'IMPLIES '(IN lgy_ (CCINT a_ lgx_))
                      (list 'FORSOME 'lgm_ (list 'AND '(IN lgm_ NN) (list '<= '(- lgy_ a_) (lil-p 'lgm_ 'lgy_))))))))))

;;; a family of diameters over NN is a sequence in [0, +inf]: run on the focus goal (IN lam (FUN NN RR-POS-STAR))
(define (lil-diam-type! lam)
  (if (not (dk-asm? (list 'IN lam '(FUN NN RR-POS-STAR))))
      (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (dk-peel!)
              (fact 'interval-length-type (cadr (cadr (dk-goal))))
              (ass)))))))

;;; (IN p RR) for p in the neighbourhood at n (the membership survives)
(define (lil-nb-real! n p)
  (dk-project! (list 'IN p 'RR) (lambda () (sep-me (list 'IN p (lil-nbn n))))))

;;; x, y, z in RR, x in CCINT(lo, hi): land (IN x RR) (<= lo x) (<= x hi)
(define (lil-ccint-parts! lo hi x)
  (let ((iff (dk-cite! 'ccint-membership lo hi x)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (dk-split-all!)))
(define (lil-into-ccint! lo hi x)
  (dk-have! (list 'IN x (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! (list 'IN x 'RR) (list 'IN lo 'RR) (list 'IN hi 'RR))))))))

;;; trunc(n, x) inside trunc(n, y) for x <= y
(define (lil-trunc-sub! n x y)
  (dk-have! (list 'SUBSET (lil-trunc n x) (lil-trunc n y))
    (lambda ()
      (mac 'subset-def)
      (let ((pv (dk-di-var!)))
        (sep-me (list 'IN pv (lil-trunc n x)))
        (dk-split-all!)
        (lil-nb-real! n pv)
        (in-sep! dk-ass! (lambda () (dk-ineq! (list 'IN pv 'RR) (list 'IN x 'RR) (list 'IN y 'RR) (list '<= pv x) (list '<= x y))))))))

(define lil-cover-stmt
  (forall-guarded '(a_ b_ fs he)
    '((IN a_ RR) (IN b_ RR) (<= a_ b_) (IN fs (FUN NN (POWER RR)))
      (SUBSET (CCINT a_ b_) (BIG-UNION lcn_ NN (fs lcn_))) (POS-RR he))
    (list '<= '(- b_ a_) (list 'ESUM lil-nbl))))

(sp (make-wff lil-cover-stmt))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'he)
(fact 'rr-lt-of-pos-rr 'he)
;; G is a set of reals bounded by b
(dk-have! (list 'SUBSET lil-g 'RR)
  (lambda () (mac 'subset-def) (let ((xv (dk-di-var!))) (sep-me (list 'IN xv lil-g)) (dk-split-all!) (ass))))
(dk-have! (list 'RR-UPPER-BOUND lil-g 'b_)
  (lambda ()
    (mac 'rr-upper-bound)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let ((xv (dk-di-var!))) (sep-me (list 'IN xv lil-g)) (dk-split-all!) (ass)))))))
;; a is in G
(dk-have! (list 'IN 'a_ lil-g)
  (lambda ()
    (in-sep! dk-ass!
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  ((dk-head-is? (dk-goal) '<=) (dk-ineq! '(IN a_ RR)))
                  (#t
                   (let ((yv (dk-di-var!)))
                     (lil-ccint-parts! 'a_ 'a_ yv)
                     (fact 'nn-zero-in)
                     (ew 0)
                     (dk-conj-close!
                       (lambda ()
                         (if (not (dk-ass!))
                             (begin
                               (fact 'rps-prefix-zero (lil-phi yv))
                               (subst (list '= (lil-p 0 yv) 0))
                               (dk-ineq! (list 'IN yv 'RR) '(IN a_ RR) (list '<= yv 'a_)))))))))))))))
;; the local step
(define lil-local
  (list 'FORALL 't_
        (list 'IMPLIES '(IN t_ (CCINT a_ b_))
              (list 'FORSOME 'd_
                    (list 'AND '(IN d_ RR)
                          (list 'AND '(< 0 d_)
                                (list 'IMPLIES (list 'FORSOME 'w_ (list 'AND (list 'IN 'w_ lil-g) '(< (- t_ d_) w_)))
                                      (list 'FORALL 'y_
                                            (list 'IMPLIES '(AND (IN y_ (CCINT a_ b_)) (<= y_ (+ t_ d_)))
                                                  (list 'IN 'y_ lil-g))))))))))

;;; the case w <= z of the local step: z - a is bounded by a prefix sum at z.  Context:
;;; t in fs(k), w in G with its prefix bound at w, the radius facts.
(define (lil-gain! tv kv dv wv yv zv wforall)
  (let* ((rk (lil-r kv))
         (ex (begin (lil-into-ccint! 'a_ wv wv) (dk-apply! wforall wv)))
         (mw (dk-skolem! ex))
         (mm (list 'succ (list '+ mw kv)))
         (fw (lil-phi wv)) (fz (lil-phi zv))
         (cz (list '- zv wv)))
    (lil-and2! (list 'IN mw 'NN) (list 'IN kv 'NN))
    (fact 'nn-add-closed mw kv)
    (fact 'nn-succ-closed (list '+ mw kv))
    (let ((z1 (dk-cite! 'nn-zero-le mw)) (z2 (dk-cite! 'nn-zero-le kv)))
      (dk-have! (list '< kv mm) (lambda () (dk-nn! z1 z2)))
      (dk-have! (list '<= mw mm) (lambda () (dk-nn! z1 z2))))
    (lil-diam-type! fw)
    (lil-diam-type! fz)
    (dk-have! (list 'IN cz 'RR) (lambda () (type-term)))
    (dk-have! (list '<= 0 cz) (lambda () (dk-ineq! (list 'IN wv 'RR) (list 'IN zv 'RR) (list '<= wv zv))))
    (lil-rps! cz)
    ;; pointwise: the part left of w is inside the part left of z
    (dk-have! (list 'FORALL 'q (list 'IMPLIES '(IN q NN) (list '<= (list fw 'q) (list fz 'q))))
      (lambda ()
        (let ((qv (dk-di-var!)))
          (dk-lam-b!)
          (lil-trunc-sub! qv wv zv)
          (fact 'interval-length-mono (lil-trunc qv wv) (lil-trunc qv zv))
          (ass))))
    ;; at k: the part left of z gains z - w
    (dk-have! (list '<= (list 'eplus (list fw kv) cz) (list fz kv))
      (lambda ()
        (dk-lam-b!)
        (let ((tw (lil-trunc kv wv)) (tz (lil-trunc kv zv)) (nb (lil-nbn kv)))
          (lil-trunc-sub! kv wv zv)
          (dk-have! (list 'SUBSET tz 'RR)
            (lambda () (mac 'subset-def)
              (let ((pv (dk-di-var!)))
                (sep-me (list 'IN pv tz)) (dk-split-all!)
                (sep-me (list 'IN pv nb))
                (ass))))
          (dk-have! (list '<= wv (list '+ tv dv))
            (lambda () (dk-ineq! (list 'IN wv 'RR) (list 'IN zv 'RR) (list 'IN yv 'RR) (list 'IN tv 'RR) (list 'IN dv 'RR)
                                 (list '<= wv zv) (list '<= zv yv) (list '<= yv (list '+ tv dv)))))
          (dk-have! (list '< (list '- tv dv) zv)
            (lambda () (dk-ineq! (list 'IN wv 'RR) (list 'IN zv 'RR) (list 'IN tv 'RR) (list 'IN dv 'RR)
                                 (list '< (list '- tv dv) wv) (list '<= wv zv))))
          (dk-have! (list '<= zv (list '+ tv dv))
            (lambda () (dk-ineq! (list 'IN zv 'RR) (list 'IN yv 'RR) (list 'IN tv 'RR) (list 'IN dv 'RR)
                                 (list '<= zv yv) (list '<= yv (list '+ tv dv)))))
          (for-each
            (lambda (pt)
              (let ((near (dk-cite! 'rr-near-center-half tv dv rk pt)))
                (dk-split-all! (list near))
                (dk-have! (list 'IN pt tz)
                  (lambda ()
                    (in-sep!
                      (lambda ()
                        (in-sep! dk-ass!
                          (lambda () (ew tv) (dk-conj-close! dk-ass!))))
                      (lambda () (if (eq? pt zv) (dk-ineq! (list 'IN zv 'RR))
                                     (dk-ineq! (list 'IN pt 'RR) (list 'IN zv 'RR) (list '<= pt zv)))))))))
            (list wv zv))
          (dk-have! (list 'FORALL 'lx_ (list 'IMPLIES (list 'IN 'lx_ tw) (list '<= 'lx_ wv)))
            (lambda () (let ((pv (dk-di-var!))) (sep-me (list 'IN pv tw)) (dk-split-all!) (ass))))
          (fact 'interval-length-extend tw tz wv zv)
          (ass))))
    (let ((bump (dk-cite! 'rps-prefix-bump mm kv fw fz cz)))
      (fact 'rps-prefix-mono-range fw mw mm)
      (ew mm)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((xx (list '- wv 'a_))
                     (pmw (lil-fs fw mw)) (pmm (lil-fs fw mm)) (pzz (lil-fs fz mm))
                     (za (list '- zv 'a_)))
                (dk-have! (list 'IN xx 'RR) (lambda () (type-term)))
                (dk-have! (list '<= 0 xx) (lambda () (dk-ineq! (list 'IN wv 'RR) '(IN a_ RR) (list '<= 'a_ wv))))
                (lil-rps! xx)
                (dk-have! (list 'IN za 'RR) (lambda () (type-term)))
                (dk-have! (list '<= 0 za) (lambda () (dk-ineq! (list 'IN zv 'RR) '(IN a_ RR) (list '<= 'a_ zv))))
                (lil-rps! za)
                (fact 'rps-prefix-type fw mw)
                (fact 'rps-prefix-type fw mm)
                (fact 'rps-prefix-type fz mm)
                (fact 'rr-pos-star-le-refl cz)
                (let ((e1 (dk-cite! 'eplus-real-defined xx cz)))
                  (dk-have! (list '<= za (list 'eplus xx cz))
                    (lambda () (subst e1)
                      (dk-ineq! (list 'IN zv 'RR) (list 'IN wv 'RR) '(IN a_ RR)))))
                (lil-and2! (list 'IN xx 'RR-POS-STAR) (list 'IN cz 'RR-POS-STAR))
                (fact 'eplus-closed xx cz)
                (lil-and2! (list 'IN pmw 'RR-POS-STAR) (list 'IN cz 'RR-POS-STAR))
                (fact 'eplus-closed pmw cz)
                (lil-and2! (list 'IN pmm 'RR-POS-STAR) (list 'IN cz 'RR-POS-STAR))
                (fact 'eplus-closed pmm cz)
                (dk-have! (list 'AND (list 'IN xx 'RR-POS-STAR) (list 'AND (list 'IN cz 'RR-POS-STAR)
                            (list 'AND (list 'IN pmw 'RR-POS-STAR) (list 'IN cz 'RR-POS-STAR))))
                  (lambda () (dk-conj-close! dk-ass!)))
                (lil-and2! (list '<= xx pmw) (list '<= cz cz))
                (fact 'eplus-mono xx cz pmw cz)
                (dk-have! (list 'AND (list 'IN pmw 'RR-POS-STAR) (list 'AND (list 'IN cz 'RR-POS-STAR)
                            (list 'AND (list 'IN pmm 'RR-POS-STAR) (list 'IN cz 'RR-POS-STAR))))
                  (lambda () (dk-conj-close! dk-ass!)))
                (lil-and2! (list '<= pmw pmm) (list '<= cz cz))
                (fact 'eplus-mono pmw cz pmm cz)
                (lil-trans! za (list 'eplus xx cz) (list 'eplus pmw cz))
                (lil-trans! za (list 'eplus pmw cz) (list 'eplus pmm cz))
                (lil-trans! za (list 'eplus pmm cz) pzz)
                (ass))))))))

(dk-have! lil-local
  (lambda ()
    (let* ((tv (dk-di-var!))
           (_ (fact 'subset-mem-fwd '(CCINT a_ b_) '(BIG-UNION lcn_ NN (fs lcn_)) tv))
           (_ (lil-ccint-parts! 'a_ 'b_ tv))
           (bl (dk-landed (lambda () (bu-me (list 'IN tv '(BIG-UNION lcn_ NN (fs lcn_))))))))
      (let* ((kin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) bl))
             (kv (cadr kin))
             (rk (lil-r kv)))
        (lil-w-facts! kv)
        (fact 'rr-pos-rr-of-lt rk)
        (let ((dv (dk-halve! rk)))
          (ew dv)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let* ((ante (dk-landed-1 (lambda () (di))))
                         (wv (dk-skolem! ante)))
                    (sep-me (list 'IN wv lil-g))
                    (dk-split-all!)
                    (let* ((wforall (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (list 'CCINT 'a_ wv)))) "w's bound"))
                           (hs (dk-peel!))
                           (yand (find-first (lambda (f) (dk-head-is? f 'AND)) hs))
                           (yv (cadr (cadr yand))))
                      (dk-split-all! (list yand))
                      (lil-ccint-parts! 'a_ 'b_ yv)
                      (in-sep! dk-ass!
                        (lambda ()
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (let* ((zv (dk-di-var!))
                                         (_ (lil-ccint-parts! 'a_ yv zv))
                                         (orf (dk-cite! 'rr-le-total zv wv)))
                                    (use-cases (list (cadr orf) (caddr orf))
                                      (lambda ()
                                        (lil-into-ccint! 'a_ wv zv)
                                        (dk-apply! wforall zv)
                                        (ass))
                                      (lambda ()
                                        (lil-gain! tv kv dv wv yv zv wforall)))))))))))))))))))
;; creep; read the bound at b; compare with the neighbourhoods
(let* ((atb (dk-fact! 'ccint-creep 'a_ 'b_ lil-g)))
  (sep-me atb)
  (dk-split-all!)
  (let* ((bforall (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(CCINT a_ b_)) (dk-contains? h 'lgm_))) "the bound at b"))
         (_ (lil-into-ccint! 'a_ 'b_ 'b_))
         (ex (dk-apply! bforall 'b_))
         (mv (dk-skolem! ex))
         (fb (lil-phi 'b_))
         (pb (lil-fs fb mv)))
    (lil-diam-type! fb)
    (lil-diam-type! lil-nbl)
    (fact 'esum-nn-prefix-le fb mv)
    (fact 'rps-prefix-type fb mv)
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list fb 'k) (list lil-nbl 'k))))
      (lambda ()
        (let ((kv (dk-di-var!)))
          (dk-lam-b!)
          (dk-have! (list 'SUBSET (lil-trunc kv 'b_) (lil-nbn kv))
            (lambda () (mac 'subset-def)
              (let ((pv (dk-di-var!))) (sep-me (list 'IN pv (lil-trunc kv 'b_))) (dk-split-all!) (ass))))
          (fact 'interval-length-mono (lil-trunc kv 'b_) (lil-nbn kv))
          (ass))))
    (fact 'esum-nn-le-termwise fb lil-nbl)
    (lil-esum-type! fb)
    (lil-esum-type! lil-nbl)
    (dk-have! '(IN (- b_ a_) RR) (lambda () (type-term)))
    (dk-have! '(<= 0 (- b_ a_)) (lambda () (dk-ineq! '(IN a_ RR) '(IN b_ RR) '(<= a_ b_))))
    (lil-rps! '(- b_ a_))
    (lil-trans! '(- b_ a_) pb (list 'ESUM fb))
    (lil-trans! '(- b_ a_) (list 'ESUM fb) (list 'ESUM lil-nbl))
    (ass)))
(qed 'ccint-cover-widened-sum)
(topic! 'ccint-cover-widened-sum 'inequalities)
;;; =====================================================================
;;; (5) a countable cover of [a, b] by sets of reals has total diameter >= b - a.
;;; =====================================================================

(define lil-ilf '(VNB-LAMBDA lkn_ NN (INTERVAL-LENGTH (fs lkn_))))
(define (lil-el e) (list 'VNB-LAMBDA 'oei_ 'NN (list '* e '(recip (power 2 (succ oei_))))))

;;; a lambda over NN whose values are eplus of [0,+inf] terms: typed pointwise by TYPER on the
;;; peeled goal, closing with eplus-closed
(define (lil-eplus-lam-type! lam typer)
  (if (not (dk-asm? (list 'IN lam '(FUN NN RR-POS-STAR))))
      (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (dk-peel!)
              (let* ((g (dk-goal)) (e (cadr g)) (x (cadr e)) (y (caddr e)))
                (typer x) (typer y)
                (lil-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
                (fact 'eplus-closed x y)
                (ass))))))))

(sp (make-wff (forall-guarded '(a_ b_ fs)
   '((IN a_ RR) (IN b_ RR) (<= a_ b_) (IN fs (FUN NN (POWER RR)))
     (SUBSET (CCINT a_ b_) (BIG-UNION lcn_ NN (fs lcn_))))
   (list '<= '(- b_ a_) (list 'ESUM lil-ilf)))))
(dk-peel!)
(let ((sm (list 'ESUM lil-ilf)) (x '(- b_ a_)))
  (lil-diam-type! lil-ilf)
  (lil-esum-type! lil-ilf)
  (dk-have! (list 'IN x 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 x) (lambda () (dk-ineq! '(IN a_ RR) '(IN b_ RR) '(<= a_ b_))))
  (lil-rps! x)
  (lil-rps-cases! sm
    (lambda ()
      (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= x (list 'eplus sm 'eps))))
        (lambda ()
          (dk-peel!)
          (let* ((ev (caddr (caddr (dk-goal))))
                 (_ (begin (fact 'rr-pos-rr-in-rr ev) (fact 'rr-lt-of-pos-rr ev)))
                 (hv (dk-halve! ev))
                 (el (lil-el hv))
                 (creep (dk-cite! 'ccint-cover-widened-sum 'a_ 'b_ 'fs hv))
                 (nbl (cadr (caddr creep)))
                 (dt (dk-cite! 'dyadic-eps-type hv)))
            (dk-split-all! (list dt))
            (let* ((add1 (dk-cite! 'esum-nn-add-le el el))
                   (gg (cadr (cadr add1))))
              (lil-eplus-lam-type! gg
                (lambda (t) (fact 'fun-apply-type-c el 'NN 'RR-POS-STAR (cadr t))))
              (let* ((add2 (dk-cite! 'esum-nn-add-le lil-ilf gg))
                     (hl (cadr (cadr add2))))
                (lil-eplus-lam-type! hl
                  (lambda (t) (fact 'fun-apply-type-c (car t) 'NN 'RR-POS-STAR (cadr t))))
                (lil-diam-type! nbl)
                (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list nbl 'k) (list hl 'k))))
                  (lambda ()
                    (let ((kv (dk-di-var!)))
                      (lil-w-facts-e! hv kv)
                      (fact 'fun-apply-type-c 'fs 'NN '(POWER RR) kv)
                      (dk-have! (list 'SUBSET (list 'fs kv) 'RR)
                        (lambda ()
                          (let ((iff (dk-cite! 'power-set-membership 'RR (list 'fs kv))))
                            (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)
                            (mac 'subset-def)
                            (let ((pv (dk-di-var!)))
                              (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (list 'fs kv)))) "power elements") pv)
                              (ass)))))
                      (dk-lam-b!)
                      (fact 'interval-length-widen (list 'fs kv) (lil-r-e hv kv))
                      (ass))))
                (fact 'esum-nn-le-termwise nbl hl)
                (lil-esum-type! nbl)
                (lil-esum-type! hl)
                (lil-esum-type! gg)
                (lil-esum-type! el)
                (fact 'dyadic-eps-sum-le hv)
                (dk-have! (list '<= 0 hv) (lambda () (dk-ineq! (list '< 0 hv))))
                (lil-rps! hv)
                (let* ((se (list 'ESUM el)) (sg (list 'ESUM gg)) (sh (list 'ESUM hl)) (sn (list 'ESUM nbl))
                       (see (list 'eplus se se)) (hh (list 'eplus hv hv)))
                  (lil-and2! (list 'IN se 'RR-POS-STAR) (list 'IN se 'RR-POS-STAR))
                  (fact 'eplus-closed se se)
                  (lil-and2! (list 'IN hv 'RR-POS-STAR) (list 'IN hv 'RR-POS-STAR))
                  (fact 'eplus-closed hv hv)
                  (dk-have! (list 'AND (list 'IN se 'RR-POS-STAR) (list 'AND (list 'IN se 'RR-POS-STAR)
                              (list 'AND (list 'IN hv 'RR-POS-STAR) (list 'IN hv 'RR-POS-STAR))))
                    (lambda () (dk-conj-close! dk-ass!)))
                  (lil-and2! (list '<= se hv) (list '<= se hv))
                  (fact 'eplus-mono se se hv hv)
                  (lil-trans! sg see hh)
                  (fact 'rr-pos-star-le-refl sm)
                  (dk-have! (list 'AND (list 'IN sm 'RR-POS-STAR) (list 'AND (list 'IN sg 'RR-POS-STAR)
                              (list 'AND (list 'IN sm 'RR-POS-STAR) (list 'IN hh 'RR-POS-STAR))))
                    (lambda () (dk-conj-close! dk-ass!)))
                  (lil-and2! (list '<= sm sm) (list '<= sg hh))
                  (fact 'eplus-mono sm sg sm hh)
                  (lil-and2! (list 'IN sm 'RR-POS-STAR) (list 'IN sg 'RR-POS-STAR))
                  (fact 'eplus-closed sm sg)
                  (lil-and2! (list 'IN sm 'RR-POS-STAR) (list 'IN hh 'RR-POS-STAR))
                  (fact 'eplus-closed sm hh)
                  (lil-trans! x sn sh)
                  (lil-trans! x sh (list 'eplus sm sg))
                  (lil-trans! x (list 'eplus sm sg) (list 'eplus sm hh))
                  (let ((e1 (dk-cite! 'eplus-real-defined hv hv)))
                    (dk-have! (list '= hh ev)
                      (lambda () (subst e1)
                        (dk-ineq! (list 'IN hv 'RR) (list 'IN ev 'RR) (list '= (list '+ hv hv) ev)))))
                  (subst (list '= ev hh))
                  (ass)))))))
      (fact 'rps-le-of-forall-eps x sm)
      (ass))
    (lambda ()
      (subst (list '= sm 'POS-INF))
      (fact 'rr-pos-star-below-pos-inf x)
      (ass))))
(qed 'ccint-cover-sum-ge)
(topic! 'ccint-cover-sum-ge 'inequalities)
;;; =====================================================================
;;; (6) LEBESGUE OUTER MEASURE OF INTERVALS, written as MEASURE-2 writes it:
;;;     METHOD-I-OUTER(RR, CLOSED-INTERVALS, VNB-LAMBDA s CLOSED-INTERVALS (INTERVAL-LENGTH s)).
;;; =====================================================================

(define lil-lp '(VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_)))
(define lil-lo (list 'METHOD-I-OUTER 'RR 'CLOSED-INTERVALS lil-lp))
(define (lil-lo-at s) (list lil-lo s))
(define lil-ci-body
  '(SEP oci_ (POWER RR)
     (OR (= oci_ EMPTY-SET)
         (FORSOME oca_ (AND (IN oca_ RR)
           (FORSOME ocb_ (AND (IN ocb_ RR) (AND (<= oca_ ocb_) (= oci_ (CCINT oca_ ocb_))))))))))

;;; a set of reals is a member of POWER(RR)
(sp (make-wff (forall-guarded '(es) '((SUBSET es RR)) '(IN es (POWER RR)))))
(dk-peel!)
(fact 'rr-is-set)
(fact 'subclass-of-set-is-set 'es 'RR)
(dk-have! '(FORALL z_ (IMPLIES (IN z_ es) (IN z_ RR)))
  (lambda () (let ((zv (dk-di-var!))) (fact 'subset-mem-fwd 'es 'RR zv) (ass))))
(fact 'power-mem-intro 'RR 'es)
(ass)
(qed 'subset-rr-in-power-rr)
(topic! 'subset-rr-in-power-rr 'plumbing)

;;; the conjuncts of IS-OUTER-MEASURE(RR, lam*), landed
(define (lil-om-parts!)
  (if (not (dk-asm? (list 'IS-OUTER-MEASURE 'RR lil-lo))) (fact 'lebesgue-outer-measure))
  (let* ((iff (dk-cite! 'is-outer-measure 'RR lil-lo))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-OUTER-MEASURE (list 'IS-OUTER-MEASURE 'RR lil-lo))) cs)))

;;; (IN es (POWER RR)) from (SUBSET es RR)
(define (lil-pow! s)
  (if (not (dk-asm? (list 'IN s '(POWER RR))))
      (fact 'subset-rr-in-power-rr s)))
;;; lam*(s) in [0, +inf]
(define (lil-lo-type! s)
  (lil-pow! s)
  (if (not (dk-asm? (list 'IN lil-lo '(FUN (POWER RR) RR-POS-STAR)))) (lil-om-parts!))
  (if (not (dk-asm? (list 'IN (lil-lo-at s) 'RR-POS-STAR)))
      (fact 'fun-apply-type-c lil-lo '(POWER RR) 'RR-POS-STAR s)))

;;; Lebesgue outer measure is monotone (on sets of reals)
(sp (make-wff (forall-guarded '(aa bb) '((SUBSET aa RR) (SUBSET bb RR) (SUBSET aa bb))
   (list '<= (lil-lo-at 'aa) (lil-lo-at 'bb)))))
(dk-peel!)
(let ((parts (lil-om-parts!)))
  (lil-pow! 'aa)
  (lil-pow! 'bb)
  (dk-apply! (list-ref parts 3) 'aa 'bb)
  (ass))
(qed 'lebesgue-outer-mono)
(topic! 'lebesgue-outer-mono 'inequalities)

;;; THE THEOREM: the Lebesgue outer measure of [a, b] is b - a
(sp (make-wff (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR) (<= a_ b_))
   (list '= (lil-lo-at '(CCINT a_ b_)) '(- b_ a_)))))
(dk-peel!)
(let* ((ab '(CCINT a_ b_))
       (cs (list 'COVER-SUMS 'RR 'CLOSED-INTERVALS lil-lp ab))
       (ei (list 'EINF cs))
       (len '(- b_ a_))
       (pm (dk-fact! 'lebesgue-premeasure)))
  (fact 'ccint-subset-rr 'a_ 'b_)
  (lil-pow! ab)
  (dk-project! '(SUBSET CLOSED-INTERVALS (POWER RR)) 'IS-PREMEASURE pm)
  (dk-project! (list 'IN lil-lp '(FUN CLOSED-INTERVALS RR-POS-STAR)) 'IS-PREMEASURE pm)
  (dk-have! (list 'IN ab 'CLOSED-INTERVALS)
    (lambda ()
      (fact 'closed-intervals-def)
      (subst (list '= 'CLOSED-INTERVALS lil-ci-body))
      (in-sep! dk-ass!
        (lambda () (oi-r) (ew 'a_)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 'b_) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))))
  (fact 'method-i-outer-value 'RR 'CLOSED-INTERVALS lil-lp ab)
  (subst (list '= (lil-lo-at ab) ei))
  (fact 'cover-sums-subset 'RR 'CLOSED-INTERVALS lil-lp ab)
  (fact 'einf-in cs)
  (dk-have! (list 'IN len 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 len) (lambda () (dk-ineq! '(IN a_ RR) '(IN b_ RR) '(<= a_ b_))))
  (lil-rps! len)
  ;; <= : the interval covers itself
  (fact 'subset-refl ab)
  (let* ((le (dk-cite! 'method-i-outer-le-single 'RR 'CLOSED-INTERVALS lil-lp ab ab))
         (lv (dk-cite! 'interval-length-ccint 'a_ 'b_)))
    (dk-rewrite-h! le (cadr lv) (caddr lv)))
  ;; >= : every covering sum is at least b - a
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cs) (list '<= len 'x)))
    (lambda ()
      (let* ((xv (dk-di-var!))
             (ex (dk-fact! 'cover-sums-elim 'RR 'CLOSED-INTERVALS lil-lp ab xv))
             (sv (dk-skolem! ex))
             (hsum (list 'VNB-LAMBDA 'cvk_ 'NN (list lil-lp (list sv 'cvk_))))
             (ilf (list 'VNB-LAMBDA 'lkn_ 'NN (list 'INTERVAL-LENGTH (list sv 'lkn_)))))
        (fact 'fun-codomain-superset sv 'NN 'CLOSED-INTERVALS '(POWER RR))
        (let ((ge (dk-cite! 'ccint-cover-sum-ge 'a_ 'b_ sv)))
          (lil-diam-type! ilf)
          (dk-have! (list 'IN hsum '(FUN NN RR-POS-STAR))
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let ((kv (cadr (car (dk-peel!)))))
                    (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                    (fact 'fun-apply-type-c lil-lp 'CLOSED-INTERVALS 'RR-POS-STAR (list sv kv))
                    (ass))))))
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list ilf 'k) (list hsum 'k))))
            (lambda ()
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                (dk-lam-b!)
                (fact 'interval-length-type (list sv kv))
                (fact 'rr-pos-star-le-refl (list 'INTERVAL-LENGTH (list sv kv)))
                (ass))))
          (fact 'esum-nn-le-termwise ilf hsum)
          (lil-esum-type! ilf)
          (lil-esum-type! hsum)
          (subst (list '= xv (list 'ESUM hsum)))
          (lil-trans! len (list 'ESUM ilf) (list 'ESUM hsum))
          (ass)))))
  (lil-and2! (list 'IN len 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cs) (list '<= len 'x))))
  (fact 'einf-greatest cs len)
  (lil-antisymm! ei len)
  (ass))
(qed 'lebesgue-outer-ccint)
(topic! 'lebesgue-outer-ccint 'inequalities)
(gloss! 'lebesgue-outer-ccint
  "The Lebesgue outer measure of a closed interval [a, b], a <= b, is its length b - a.
   The outer measure is the method I outer measure of the length on the closed
   intervals (MEASURE-2), so <= is the cover of [a, b] by itself; >= is
   ccint-cover-sum-ge: a countable cover of [a, b] by sets of reals has total
   diameter at least b - a.")
;;; =====================================================================
;;; (7) points, the empty set, and the open and half-open intervals.
;;; =====================================================================

(define (lil-sing x) (list 'SINGLETON x))
;;; z = x (in context), z in RR: z in {x}
(define (lil-into-sing! zv x)
  (mac 'singleton-membership)
  (fact 'membership-implies-sethood zv 'RR)
  (dk-conj-close! dk-ass!))
;;; (SUBSET {x} RR) for x in RR
(define (lil-sing-sub! x)
  (dk-have! (list 'SUBSET (lil-sing x) 'RR)
    (lambda ()
      (mac 'subset-def)
      (let* ((zv (dk-di-var!))
             (iff (dk-cite! 'singleton-membership x zv)))
        (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)
        (subst (list '= zv x))
        (ass)))))
;;; (SUBSET (UNION A B) RR) from A, B subsets of RR
(define (lil-union-sub! a b)
  (dk-have! (list 'SUBSET (list 'UNION a b) 'RR)
    (lambda ()
      (mac 'subset-def)
      (let* ((zv (dk-di-var!))
             (iff (dk-cite! 'union-membership a b zv)))
        (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
        (use-cases (list (list 'IN zv a) (list 'IN zv b))
          (lambda () (fact 'subset-mem-fwd a 'RR zv) (ass))
          (lambda () (fact 'subset-mem-fwd b 'RR zv) (ass)))))))

;;; a point has Lebesgue outer measure 0
(sp (make-wff (forall-guarded '(x_) '((IN x_ RR)) (list '= (lil-lo-at '(SINGLETON x_)) 0))))
(dk-peel!)
(let ((sx '(SINGLETON x_)) (cc '(CCINT x_ x_)))
  (dk-have! '(<= x_ x_) (lambda () (dk-ineq! '(IN x_ RR))))
  (dk-have! (list 'SUBSET sx cc)
    (lambda ()
      (mac 'subset-def)
      (let* ((zv (dk-di-var!))
             (iff (dk-cite! 'singleton-membership 'x_ zv)))
        (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)
        (subst (list '= zv 'x_))
        (lil-into-ccint! 'x_ 'x_ 'x_))))
  (fact 'ccint-subset-rr 'x_ 'x_)
  (lil-sing-sub! 'x_)
  (let* ((mono (dk-cite! 'lebesgue-outer-mono sx cc))
         (val (dk-cite! 'lebesgue-outer-ccint 'x_ 'x_))
         (m1 (dk-rewrite-h! mono (cadr val) (caddr val))))
    (dk-have! '(= (- x_ x_) 0) (lambda () (dk-ineq! '(IN x_ RR))))
    (dk-rewrite-h! m1 '(- x_ x_) 0))
  (lil-lo-type! sx)
  (fact 'rr-pos-star-nonneg (lil-lo-at sx))
  (fact 'zero-in-rr-pos-star)
  (lil-antisymm! (lil-lo-at sx) 0)
  (ass))
(qed 'lebesgue-outer-point)
(topic! 'lebesgue-outer-point 'inequalities)

;;; the empty set has Lebesgue outer measure 0
(sp (make-wff (list '= (lil-lo-at 'EMPTY-SET) 0)))
(lil-om-parts!)
(ass)
(qed 'lebesgue-outer-empty)
(topic! 'lebesgue-outer-empty 'inequalities)

;;; a set between [a, b] minus its endpoints and [a, b] has outer measure b - a
(sp (make-wff (forall-guarded '(a_ b_ es)
   '((IN a_ RR) (IN b_ RR) (<= a_ b_) (SUBSET es (CCINT a_ b_))
     (SUBSET (CCINT a_ b_) (UNION (UNION es (SINGLETON a_)) (SINGLETON b_))))
   (list '= (lil-lo-at 'es) '(- b_ a_)))))
(dk-peel!)
(let* ((cc '(CCINT a_ b_)) (sa '(SINGLETON a_)) (sb '(SINGLETON b_))
       (u1 (list 'UNION 'es sa)) (u2 (list 'UNION u1 sb))
       (len '(- b_ a_)))
  (fact 'ccint-subset-rr 'a_ 'b_)
  (fact 'subset-trans 'es cc 'RR)
  (lil-sing-sub! 'a_)
  (lil-sing-sub! 'b_)
  (lil-union-sub! 'es sa)
  (lil-union-sub! u1 sb)
  (for-each lil-lo-type! (list 'es sa sb u1 u2 cc))
  (lil-om-parts!)
  (dk-have! (list 'IN len 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 len) (lambda () (dk-ineq! '(IN a_ RR) '(IN b_ RR) '(<= a_ b_))))
  (lil-rps! len)
  (let* ((val (dk-cite! 'lebesgue-outer-ccint 'a_ 'b_))
         (pa (dk-cite! 'lebesgue-outer-point 'a_))
         (pb (dk-cite! 'lebesgue-outer-point 'b_))
         (le (dk-rewrite-h! (dk-cite! 'lebesgue-outer-mono 'es cc) (cadr val) (caddr val)))
         (g0 (dk-rewrite-h! (dk-cite! 'lebesgue-outer-mono cc u2) (cadr val) (caddr val)))
         (s2 (dk-rewrite-h! (dk-cite! 'outer-measure-binary-subadditive 'RR lil-lo u1 sb) (cadr pb) 0))
         (s1 (dk-rewrite-h! (dk-cite! 'outer-measure-binary-subadditive 'RR lil-lo 'es sa) (cadr pa) 0))
         (z2 (dk-cite! 'eplus-zero-right (lil-lo-at u1)))
         (z1 (dk-cite! 'eplus-zero-right (lil-lo-at 'es))))
    (dk-rewrite-h! s2 (cadr z2) (caddr z2))
    (dk-rewrite-h! s1 (cadr z1) (caddr z1))
    (lil-trans! len (lil-lo-at u2) (lil-lo-at u1))
    (lil-trans! len (lil-lo-at u1) (lil-lo-at 'es))
    (lil-antisymm! (lil-lo-at 'es) len)
    (ass)))
(qed 'lebesgue-outer-between)
(topic! 'lebesgue-outer-between 'inequalities)

;;; X inside [a, b] (MEM is X's membership iff, interval endpoints a_, b_)
(define (lil-x-in-cc! x mem)
  (dk-have! (list 'SUBSET x '(CCINT a_ b_))
    (lambda ()
      (mac 'subset-def)
      (let* ((zv (dk-di-var!))
             (iff (dk-cite! mem 'a_ 'b_ zv)))
        (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)
        (mac 'ccint-membership)
        (dk-conj-close! (lambda () (if (not (dk-ass!)) (apply dk-ineq! (filter dk-asm? (list (list 'IN zv 'RR) '(IN a_ RR) '(IN b_ RR) (list '<= 'a_ zv) (list '< 'a_ zv) (list '<= zv 'b_) (list '< zv 'b_)))))))))))
;;; [a, b] inside (X u {a}) u {b}
(define (lil-cc-in-u2! x mem)
  (dk-have! (list 'SUBSET '(CCINT a_ b_) (list 'UNION (list 'UNION x '(SINGLETON a_)) '(SINGLETON b_)))
    (lambda ()
      (mac 'subset-def)
      (let ((zv (dk-di-var!)))
        (lil-ccint-parts! 'a_ 'b_ zv)
        (use-em (list '= 'a_ zv)
          (lambda ()
            (mac 'union-membership) (oi-l) (mac 'union-membership) (oi-r)
            (mac 'singleton-membership)
            (fact 'membership-implies-sethood zv 'RR)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= 'a_ zv)) (rfl))))))
          (lambda ()
            (use-em (list '= zv 'b_)
              (lambda ()
                (mac 'union-membership) (oi-r)
                (mac 'singleton-membership)
                (fact 'membership-implies-sethood zv 'RR)
                (dk-conj-close! dk-ass!))
              (lambda ()
                (lil-and2! (list '<= 'a_ zv) (list 'NOT (list '= 'a_ zv)))
                (fact 'rr-le-ne-lt 'a_ zv)
                (lil-and2! (list '<= zv 'b_) (list 'NOT (list '= zv 'b_)))
                (fact 'rr-le-ne-lt zv 'b_)
                (mac 'union-membership) (oi-l) (mac 'union-membership) (oi-l)
                (mac mem)
                (dk-conj-close! dk-ass!)))))))))

(sp (make-wff (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR) (<= a_ b_))
   '(= ((METHOD-I-OUTER RR CLOSED-INTERVALS (VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_))) (OOINT a_ b_)) (- b_ a_)))))
(dk-peel!)
(lil-x-in-cc! '(OOINT a_ b_) 'ooint-membership)
(lil-cc-in-u2! '(OOINT a_ b_) 'ooint-membership)
(fact 'lebesgue-outer-between 'a_ 'b_ '(OOINT a_ b_))
(ass)
(qed 'lebesgue-outer-ooint)
(topic! 'lebesgue-outer-ooint 'inequalities)

