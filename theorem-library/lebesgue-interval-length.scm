;;; =====================================================================
;;; (8) TRANSLATION INVARIANCE.  The tree has no translate of a set of reals; it
;;;     is written out as a SEP:  es + c = { z in RR : z - c in es }.
;;; =====================================================================

(define (lil-tr s c) (list 'SEP 'ltz_ 'RR (list 'IN (list '- 'ltz_ c) s)))

;;; the goal (= A B) by class-extensionality: BODY-AB proves (IN x B) from (IN x A),
;;; BODY-BA the converse; both get the eigenvariable
(define (lil-class-eq! a b body-ab body-ba)
  (let ((ext (list 'FORALL 'lex_ (list 'IFF (list 'IN 'lex_ a) (list 'IN 'lex_ b)))))
    (dk-have! ext
      (lambda ()
        (dk-peel!)
        (let ((xv (cadr (cadr (dk-goal)))))
          (for-each (lambda (l)
                      (dk-focus! l)
                      (if (equal? (dk-goal) (list 'IN xv b)) (body-ab xv) (body-ba xv)))
                    (dk-opened (lambda () (di)))))))
    (fact 'class-extensionality a b)
    (ass)))

;;; (IN x (CCINT lo hi)) proved by ineq from PREMS
(define (lil-into-ccint-p! lo hi x prems)
  (dk-have! (list 'IN x (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (not (dk-ass!)) (apply dk-ineq! prems)))))))

;;; (z in TR(s, c)) gives z in RR and z - c in s (the membership is consumed)
(define (lil-tr-out! s c z)
  (sep-me (list 'IN z (lil-tr s c)))
  (dk-split-all!))

;;; the diameter does not grow under translation
(sp (make-wff (forall-guarded '(es c_) '((IN c_ RR))
   (list '<= (lil-il (lil-tr 'es 'c_)) '(INTERVAL-LENGTH es)))))
(dk-peel!)
(mac 'INTERVAL-LENGTH)
(let* ((ts (lil-tr 'es 'c_)) (dt (lil-dset ts)) (da (lil-dset 'es)) (ea (list 'ESUP da)))
  (lil-dset-sub! ts)
  (lil-dset-sub! 'es)
  (fact 'esup-in da)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x dt) (list '<= 'x ea)))
    (lambda ()
      (let ((xv (dk-di-var!)))
        (dk-have! (list 'IN xv da)
          (lambda ()
            (lil-dcases! xv ts
              (lambda () (fact 'zero-in-rr-pos-star) (subst (list '= xv 0))
                         (in-sep! dk-ass! (lambda () (oi-l) (rfl))))
              (lambda (x0 y0)
                (lil-tr-out! 'es 'c_ x0)
                (lil-tr-out! 'es 'c_ y0)
                (dk-have! (list 'IN xv 'RR) (lambda () (subst (list '= xv (list '- y0 x0))) (type-term)))
                (let ((u0 (list '- x0 'c_)) (u1 (list '- y0 'c_)))
                  (dk-have! (list '<= u0 u1) (lambda () (dk-ineq! (list 'IN x0 'RR) (list 'IN y0 'RR) '(IN c_ RR) (list '<= x0 y0))))
                  (dk-have! (list '= xv (list '- u1 u0))
                    (lambda () (dk-ineq! (list 'IN x0 'RR) (list 'IN y0 'RR) '(IN c_ RR) (list '= xv (list '- y0 x0)))))
                  (subst (list '= xv (list '- u1 u0)))
                  (dk-have! (list 'IN (list '- u1 u0) 'RR-POS-STAR) (lambda () (subst (list '= (list '- u1 u0) xv)) (ass)))
                  (in-sep! dk-ass!
                    (lambda () (oi-r) (ew u0)
                      (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew u1) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))))))))))
        (fact 'esup-upper da xv)
        (ass))))
  (lil-and2! (list 'IN ea 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x dt) (list '<= 'x ea))))
  (fact 'esup-least dt ea)
  (ass))
(qed 'interval-length-translate-le)
(topic! 'interval-length-translate-le 'inequalities)

;;; the translate of a member of CLOSED-INTERVALS is a member
(sp (make-wff (forall-guarded '(ii c_) '((IN ii CLOSED-INTERVALS) (IN c_ RR))
   (list 'IN (lil-tr 'ii 'c_) 'CLOSED-INTERVALS))))
(dk-peel!)
(let ((ts (lil-tr 'ii 'c_)))
  (dk-have! (list 'SUBSET ts 'RR)
    (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (lil-tr-out! 'ii 'c_ zv) (ass))))
  (fact 'subset-rr-in-power-rr ts)
  (fact 'closed-intervals-def)
  (dk-rewrite-h! '(IN ii CLOSED-INTERVALS) 'CLOSED-INTERVALS lil-ci-body)
  (subst (list '= 'CLOSED-INTERVALS lil-ci-body))
  (sep-me (list 'IN 'ii lil-ci-body))
  (dk-split-all!)
  (let ((orf (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h 'ii))) "the two kinds")))
    (in-sep! dk-ass!
      (lambda ()
        (use-cases (list (cadr orf) (caddr orf))
          (lambda ()
            (oi-l)
            (subst '(= ii EMPTY-SET))
            (lil-class-eq! (lil-tr 'EMPTY-SET 'c_) 'EMPTY-SET
              (lambda (xv)
                (lil-tr-out! 'EMPTY-SET 'c_ xv)
                (fact 'empty-set-has-no-members (list '- xv 'c_))
                (ai (list 'NOT (list 'IN (list '- xv 'c_) 'EMPTY-SET))))
              (lambda (xv)
                (fact 'empty-set-has-no-members xv)
                (ai (list 'NOT (list 'IN xv 'EMPTY-SET))))))
          (lambda ()
            (let* ((pv (dk-skolem! (caddr orf) 'top))
                   (_ (dk-split-all!))
                   (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h pv))) "q"))
                   (qv (dk-skolem! ex 'top)))
              (dk-split-all!)
              (subst (list '= 'ii (list 'CCINT pv qv)))
              (let ((p2 (list '+ pv 'c_)) (q2 (list '+ qv 'c_)))
                (dk-have! (list 'IN p2 'RR) (lambda () (type-term)))
                (dk-have! (list 'IN q2 'RR) (lambda () (type-term)))
                (oi-r) (ew p2)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin
                          (ew q2)
                          (dk-conj-close!
                            (lambda ()
                              (cond ((dk-ass!) #t)
                                    ((dk-head-is? (dk-goal) '<=)
                                     (dk-ineq! (list 'IN pv 'RR) (list 'IN qv 'RR) '(IN c_ RR) (list '<= pv qv)))
                                    (#t
                                     (lil-class-eq! (lil-tr (list 'CCINT pv qv) 'c_) (list 'CCINT p2 q2)
                                       (lambda (xv)
                                         (lil-tr-out! (list 'CCINT pv qv) 'c_ xv)
                                         (lil-ccint-parts! pv qv (list '- xv 'c_))
                                         (mac 'ccint-membership)
                                         (dk-conj-close!
                                           (lambda ()
                                             (if (not (dk-ass!))
                                                 (dk-ineq! (list 'IN xv 'RR) (list 'IN pv 'RR) (list 'IN qv 'RR) '(IN c_ RR)
                                                           (list '<= pv (list '- xv 'c_)) (list '<= (list '- xv 'c_) qv))))))
                                       (lambda (xv)
                                         (lil-ccint-parts! p2 q2 xv)
                                         (in-sep! dk-ass!
                                           (lambda ()
                                             (dk-have! (list 'IN (list '- xv 'c_) 'RR) (lambda () (type-term)))
                                             (lil-into-ccint-p! pv qv (list '- xv 'c_)
                                               (list (list 'IN xv 'RR) (list 'IN pv 'RR) (list 'IN qv 'RR) '(IN c_ RR)
                                                     (list '<= p2 xv) (list '<= xv q2)))))))))))))))))))))))
(qed 'translate-closed-interval)
(topic! 'translate-closed-interval 'plumbing)
;;; Lebesgue outer measure does not grow under translation
(sp (make-wff (forall-guarded '(es c_) '((SUBSET es RR) (IN c_ RR))
   (list '<= (lil-lo-at (lil-tr 'es 'c_)) (lil-lo-at 'es)))))
(dk-peel!)
(let* ((ts (lil-tr 'es 'c_))
       (cst (list 'COVER-SUMS 'RR 'CLOSED-INTERVALS lil-lp ts))
       (cse (list 'COVER-SUMS 'RR 'CLOSED-INTERVALS lil-lp 'es))
       (et (list 'EINF cst)) (ee (list 'EINF cse))
       (pm (dk-fact! 'lebesgue-premeasure)))
  (dk-project! '(SUBSET CLOSED-INTERVALS (POWER RR)) 'IS-PREMEASURE pm)
  (dk-project! (list 'IN lil-lp '(FUN CLOSED-INTERVALS RR-POS-STAR)) 'IS-PREMEASURE pm)
  (dk-have! (list 'SUBSET ts 'RR)
    (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (lil-tr-out! 'es 'c_ zv) (ass))))
  (lil-pow! ts)
  (lil-pow! 'es)
  (fact 'method-i-outer-value 'RR 'CLOSED-INTERVALS lil-lp ts)
  (fact 'method-i-outer-value 'RR 'CLOSED-INTERVALS lil-lp 'es)
  (subst (list '= (lil-lo-at ts) et))
  (subst (list '= (lil-lo-at 'es) ee))
  (fact 'cover-sums-subset 'RR 'CLOSED-INTERVALS lil-lp ts)
  (fact 'cover-sums-subset 'RR 'CLOSED-INTERVALS lil-lp 'es)
  (fact 'einf-in cst)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cse) (list '<= et 'x)))
    (lambda ()
      (let* ((xv (dk-di-var!))
             (ex (dk-fact! 'cover-sums-elim 'RR 'CLOSED-INTERVALS lil-lp 'es xv))
             (sv (dk-skolem! ex))
             (sp2 (list 'VNB-LAMBDA 'ltk_ 'NN (lil-tr (list sv 'ltk_) 'c_)))
             (h1 (list 'VNB-LAMBDA 'cvk_ 'NN (list lil-lp (list sp2 'cvk_))))
             (h0 (list 'VNB-LAMBDA 'cvk_ 'NN (list lil-lp (list sv 'cvk_))))
             (bu0 (list 'BIG-UNION 'cvn_ 'NN (list sv 'cvn_))))
        (dk-have! (list 'IN sp2 '(FUN NN CLOSED-INTERVALS))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                  (fact 'translate-closed-interval (list sv kv) 'c_)
                  (ass))))))
        (dk-have! (list 'SUBSET ts (list 'BIG-UNION 'cvn_ 'NN (list sp2 'cvn_)))
          (lambda ()
            (mac 'subset-def)
            (let ((zv (dk-di-var!)))
              (lil-tr-out! 'es 'c_ zv)
              (fact 'subset-mem-fwd 'es bu0 (list '- zv 'c_))
              (let* ((bl (dk-landed (lambda () (bu-me (list 'IN (list '- zv 'c_) bu0)))))
                     (kin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) bl))
                     (kv (cadr kin)))
                (for-each (lambda (l)
                            (dk-focus! l)
                            (if (equal? (dk-goal) (list 'IN kv 'NN))
                                (ass)
                                (begin
                                  (dk-lam-b!)
                                  (in-sep! dk-ass! dk-ass!))))
                          (dk-opened (lambda () (bu-mi kv))))))))
        (fact 'cover-sums-intro 'RR 'CLOSED-INTERVALS lil-lp ts sp2)
        (dk-have! (list 'IN h1 '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (fact 'fun-apply-type-c sp2 'NN 'CLOSED-INTERVALS kv)
                  (fact 'fun-apply-type-c lil-lp 'CLOSED-INTERVALS 'RR-POS-STAR (list sp2 kv))
                  (ass))))))
        (dk-have! (list 'IN h0 '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                  (fact 'fun-apply-type-c lil-lp 'CLOSED-INTERVALS 'RR-POS-STAR (list sv kv))
                  (ass))))))
        (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list h1 'k) (list h0 'k))))
          (lambda ()
            (let ((kv (dk-di-var!)))
              (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
              (fact 'translate-closed-interval (list sv kv) 'c_)
              (dk-lam-b!)
              (fact 'interval-length-translate-le (list sv kv) 'c_)
              (ass))))
        (fact 'esum-nn-le-termwise h1 h0)
        (lil-esum-type! h1)
        (lil-esum-type! h0)
        (fact 'einf-lower cst (list 'ESUM h1))
        (subst (list '= xv (list 'ESUM h0)))
        (lil-trans! et (list 'ESUM h1) (list 'ESUM h0))
        (ass))))
  (lil-and2! (list 'IN et 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cse) (list '<= et 'x))))
  (fact 'einf-greatest cse et)
  (ass))
(qed 'lebesgue-outer-translate-le)
(topic! 'lebesgue-outer-translate-le 'inequalities)

;;; TRANSLATION INVARIANCE: lam*(es + c) = lam*(es) for a set of reals es and real c
(sp (make-wff (forall-guarded '(es c_) '((SUBSET es RR) (IN c_ RR))
   (list '= (lil-lo-at (lil-tr 'es 'c_)) (lil-lo-at 'es)))))
(dk-peel!)
(let* ((ts (lil-tr 'es 'c_)) (nc '(- 0 c_)) (tts (lil-tr ts nc)))
  (dk-have! (list 'IN nc 'RR) (lambda () (type-term)))
  (dk-have! (list 'SUBSET ts 'RR)
    (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (lil-tr-out! 'es 'c_ zv) (ass))))
  (fact 'lebesgue-outer-translate-le 'es 'c_)
  (fact 'lebesgue-outer-translate-le ts nc)
  (dk-have! (list '= tts 'es)
    (lambda ()
      (lil-class-eq! tts 'es
        (lambda (xv)
          (lil-tr-out! ts nc xv)
          (lil-tr-out! 'es 'c_ (list '- xv nc))
          (dk-have! (list '= (list '- (list '- xv nc) 'c_) xv)
            (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN c_ RR))))
          (dk-rewrite-h! (list 'IN (list '- (list '- xv nc) 'c_) 'es) (list '- (list '- xv nc) 'c_) xv)
          (ass))
        (lambda (xv)
          (fact 'subset-mem-fwd 'es 'RR xv)
          (dk-have! (list 'IN (list '- xv nc) 'RR) (lambda () (type-term)))
          (in-sep! dk-ass!
            (lambda ()
              (in-sep! dk-ass!
                (lambda ()
                  (dk-have! (list '= (list '- (list '- xv nc) 'c_) xv)
                    (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN c_ RR))))
                  (subst (list '= (list '- (list '- xv nc) 'c_) xv))
                  (ass)))))))))
  (let ((le2 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h tts))) "the reverse bound")))
    (dk-rewrite-h! le2 tts 'es))
  (lil-lo-type! ts)
  (lil-lo-type! 'es)
  (lil-antisymm! (lil-lo-at ts) (lil-lo-at 'es))
  (ass))
(qed 'lebesgue-outer-translate)
(topic! 'lebesgue-outer-translate 'inequalities)
(gloss! 'lebesgue-outer-translate
  "Lebesgue outer measure is translation invariant: for a set of reals E and a real c,
   the outer measure of E + c = { z in RR : z - c in E } is that of E.")
