                             (b2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d2))) "g's law")))
                        (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1)
                        (dk-cite! 'rr-pos-rr-in-rr d2) (dk-cite! 'rr-lt-of-pos-rr d2)
                        (let ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2))))
                          (dk-have! `(POS-RR ,w)
                            (lambda () (mac 'pos-rr)
                              (dk-conj-close! (lambda () (cond ((dk-ass!) #t)
                                                               ((dk-head-is? (dk-goal) 'NOT) (let ((at (cadr (dk-goal)))) (di) (dk-absurd! at `(< 0 ,w))))
                                                               (#t (dk-ineq! `(< 0 ,w))))))))
                          (ch-witness! w
                            (lambda ()
                              (let* ((landed3 (dk-landed (lambda () (dk-peel!))))
                                     (bb (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed3)))
                                     (hd (find-first (lambda (f) (dk-head-is? f '<=)) landed3)))
                                (dk-cite! 'metric-dist-real 's x0 bb)
                                (dk-have! `(<= ((DIST s) ,x0 ,bb) ,d1) (lambda () (dk-ineq! hd `(<= ,w ,d1))))
                                (dk-have! `(<= ((DIST s) ,x0 ,bb) ,d2) (lambda () (dk-ineq! hd `(<= ,w ,d2))))
                                (dk-apply! b1 bb) (dk-apply! b2 bb)
                                (ch-unit! 's 'f x0) (ch-unit! 's 'g x0) (ch-unit! 's 'f bb) (ch-unit! 's 'g bb)
                                (dk-lam-b!)
                                (ch-prod-estimate! x0 bb h))))))))))))))))))
(qed 'ch-unit-product-continuous)

;; the product of two characters is a character
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi) (FORALL psi (IMPLIES (IS-ADD-CHARACTER kf psi)
  (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (* (chi chx_) (psi chx_))))))))))))
(dk-peel!)
(dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf))
(let* ((ms '(NF-METRIC-SPACE kf))
       (h1 (ch-hom! 'kf 'chi)) (h2 (ch-hom! 'kf 'psi)))
  (dk-project! `(IS-CONTINUOUS ,ms CC-MS chi) 'is-add-character '(IS-ADD-CHARACTER kf chi))
  (dk-project! `(IS-CONTINUOUS ,ms CC-MS psi) 'is-add-character '(IS-ADD-CHARACTER kf psi))
  (dk-cite! 'nf-metric-space-is-metric-space 'kf)
  (dk-cite! 'nf-metric-carrier 'kf)
  (dk-have! `(IN chi (FUN (PTS ,ms) UNIT-CIRCLE)) (lambda () (subst `(== (PTS ,ms) (CARR kf))) (dk-ass!)))
  (dk-have! `(IN psi (FUN (PTS ,ms) UNIT-CIRCLE)) (lambda () (subst `(== (PTS ,ms) (CARR kf))) (dk-ass!)))
  (let ((c (dk-cite! 'ch-unit-product-continuous ms 'chi 'psi)))
    (dk-rewrite-h! c `(PTS ,ms) '(CARR kf)))
  (mac 'IS-ADD-CHARACTER)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-asm? (dk-goal)) (dk-ass!))
        ((dk-head-is? (dk-goal) 'IN)
         (for-each (lambda (l)
                     (dk-focus! l)
                     (if (dk-head-is? (dk-goal) 'FORALL)
                         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                                (p `(* (chi ,x) (psi ,x))))
                           (ch-val! 'kf 'chi x) (ch-val! 'kf 'psi x)
                           (ch-and! `(IN (chi ,x) CC) `(IN (psi ,x) CC))
                           (dk-cite! 'cc-mul-closed `(chi ,x) `(psi ,x))
                           (dk-cite! 'cc-magnitude-mul `(chi ,x) `(psi ,x))
                           (mac 'unit-circle-membership)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (begin
                                     (subst `(= (magnitude ,p) (* (magnitude (chi ,x)) (magnitude (psi ,x)))))
                                     (subst `(= (magnitude (chi ,x)) 1)) (subst `(= (magnitude (psi ,x)) 1))
                                     (arith))))))
                         (dk-ass!)))
                   (dk-opened (lambda () (lam-t)))))
        (#t
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (ins (filter (lambda (f) (dk-head-is? f 'IN)) landed))
                (x (cadr (car ins))) (y (cadr (cadr ins)))
                (s `((ADD kf) ,x ,y)))
           (dk-cite! 'nf-add-in-carr 'kf x y)
           (for-each (lambda (u) (ch-val! 'kf 'chi u) (ch-val! 'kf 'psi u)) (list x y s))
           (dk-lam-b!)
           (subst (dk-apply! h1 x y))
           (subst (dk-apply! h2 x y))
           (crs)))))))
(qed 'ch-product-character)

;; the inverse character x |-> chi(-x) = Psi_chi(-1)(x)
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (AND (IS-ADD-CHARACTER kf (DUALITY-MAP kf chi ((NEG kf) (ONE kf))))
       (FORALL x (IMPLIES (IN x (CARR kf)) (= (* (chi x) ((DUALITY-MAP kf chi ((NEG kf) (ONE kf))) x)) 1))))))))))
(dk-peel!)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-cite! 'nf-neg-in-carr 'kf '(ONE kf))
(let ((m1 '((NEG kf) (ONE kf))))
  (dk-cite! 'ccr-5-12-character 'kf 'chi m1)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (dk-ass!)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
            (dk-cite! 'nf-mul-in-carr 'kf m1 x)
            (dk-cite! 'nf-neg-in-carr 'kf x)
            (subst (dk-cite! 'ch-psi-value 'kf 'chi m1 x))
            (dk-have! `(= ((MUL kf) ,m1 ,x) ((NEG kf) ,x)) (lambda () (ch-crs! 'kf (list x))))
            (subst `(= ((MUL kf) ,m1 ,x) ((NEG kf) ,x)))
            (ch-hom! 'kf 'chi)
            (ch-val! 'kf 'chi x) (ch-val! 'kf 'chi `((NEG kf) ,x))
            (dk-cite! 'ch-neg 'kf 'chi x)
            (dk-have! `(= (* (chi ,x) (chi ((NEG kf) ,x))) (* (chi ((NEG kf) ,x)) (chi ,x))) (lambda () (crs)))
            (subst `(= (* (chi ,x) (chi ((NEG kf) ,x))) (* (chi ((NEG kf) ,x)) (chi ,x))))
            (dk-ass!))))))
(qed 'ch-inverse-character)

;; the trivial character
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) 1))))))
(dk-peel!)
(dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf))
(dk-cite! 'nf-metric-space-is-metric-space 'kf)
(dk-cite! 'nf-metric-carrier 'kf)
(fact 'cc-is-metric-space)
(fact 'cc-one-in)
(dk-cite! 'cc-magnitude-one)
(let ((one-in-t! (lambda () (mac 'unit-circle-membership) (dk-conj-close! (lambda () (dk-ass!))))))
  (mac 'IS-ADD-CHARACTER)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-asm? (dk-goal)) (dk-ass!))
        ((dk-head-is? (dk-goal) 'IN)
         (for-each (lambda (l) (dk-focus! l) (if (dk-head-is? (dk-goal) 'FORALL) (begin (dk-peel!) (one-in-t!)) (dk-ass!)))
                   (dk-opened (lambda () (lam-t)))))
        ((dk-head-is? (dk-goal) 'FORALL)
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (ins (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
           (dk-cite! 'nf-add-in-carr 'kf (car ins) (cadr ins))
           (dk-lam-b!) (arith)))
        (#t
         (mac 'IS-CONTINUOUS)
         (subst '(== (PTS (NF-METRIC-SPACE kf)) (CARR kf)))
         (let ((typ! (lambda ()
                       (for-each (lambda (l) (dk-focus! l)
                                   (if (dk-head-is? (dk-goal) 'FORALL) (begin (dk-peel!) (slot 'PTS) (dk-ass!)) (dk-ass!)))
                                 (dk-opened (lambda () (lam-t)))))))
           (dk-conj-close!
             (lambda ()
               (cond
                 ((dk-asm? (dk-goal)) (dk-ass!))
                 ((dk-head-is? (dk-goal) 'IN) (typ!))
                 (#t
                  (dk-peel!)
                  (mac 'IS-CONTINUOUS-AT)
                  (subst '(== (PTS (NF-METRIC-SPACE kf)) (CARR kf)))
                  (dk-conj-close!
                    (lambda ()
                      (cond
                        ((dk-asm? (dk-goal)) (dk-ass!))
                        ((dk-head-is? (dk-goal) 'IN) (typ!))
                        (#t
                         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                (ep (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) landed))))
                           (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
                           (dk-have! '(POS-RR 1) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (arith)))))
                           (ch-witness! 1
                             (lambda ()
                               (dk-peel!)
                               (dk-lam-b!)
                               (subst (dk-cite! 'cc-ms-dist 1 1))
                               (dk-have! '(= (- 1 1) 0) (lambda () (arith)))
                               (subst '(= (- 1 1) 0))
                               (fact 'cc-magnitude-zero)
                               (subst '(= (magnitude 0) 0))
                               (dk-ineq! `(< 0 ,ep)))))))))))))))))))
(qed 'ch-trivial-character)
