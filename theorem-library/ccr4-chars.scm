;;; theorem-library/ccr2-nv (nf-inverse, nf-norm-one), diff-on-laws (nf-*), metric-continuity laws.
;;; Statements are for any normed field K: the notes' K is a local NV field, but none of these results
;;; uses local compactness.  Helper prefix ch-.

(define (ch-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (ch-iff-fwd! iff) (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
(define (ch-view kf) `(NORMED-FIELD-AS-COMMUTATIVE-RING ,kf))
;; the ring view of KF, its read-offs and the commutative-ring predicate
(define (ch-view! kf)
  (let ((v (ch-view kf)))
    (if (not (dk-asm? `(IS-COMMUTATIVE-RING ,v)))
        (begin
          (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring kf)
          (for-each (lambda (n) (dk-cite! n kf))
                    '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                      normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))))))
;; a ring identity in KF's accessors, the variables ELEMS typed in (CARR KF)
(define (ch-crs! kf elems)
  (ch-view! kf)
  (let ((v (ch-view kf)))
    (for-each (lambda (u)
                (if (not (dk-asm? `(IN ,u (CARR ,v))))
                    (dk-have! `(IN ,u (CARR ,v)) (lambda () (subst `(== (CARR ,v) (CARR ,kf))) (dk-ass!)))))
              elems)
    (for-each (lambda (acc)
                (if (dk-contains? (dk-goal) `(,acc ,kf))
                    (subst `(== (,acc ,kf) (,acc ,v)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))
;; IS-ADD-CHARACTER(KF, CHI) in context: land its typing and return the homomorphism law
(define (ch-hom! kf chi)
  (dk-project! `(IN ,chi (FUN (CARR ,kf) UNIT-CIRCLE)) 'is-add-character `(IS-ADD-CHARACTER ,kf ,chi))
  (dk-project! `(FORALL chx_ (IMPLIES (IN chx_ (CARR ,kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,kf))
                   (= (,chi ((ADD ,kf) chx_ chy_)) (* (,chi chx_) (,chi chy_)))))))
               'is-add-character `(IS-ADD-CHARACTER ,kf ,chi)))
;; X in (CARR KF): land CHI(X) in UNIT-CIRCLE, in CC, |CHI(X)| = 1, CHI(X) /= 0
(define (ch-val! kf chi x)
  (let ((w `(,chi ,x)))
    (ch-and! `(IN ,chi (FUN (CARR ,kf) UNIT-CIRCLE)) `(IN ,x (CARR ,kf)))
    (dk-cite! 'fun-apply-type chi `(CARR ,kf) 'UNIT-CIRCLE x)
    (ch-iff-fwd! (dk-cite! 'unit-circle-membership w))
    (dk-have! `(NOT (= ,w 0))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! `(= (magnitude ,w) 1) w 0)))
          (fact 'cc-zero-in) (dk-cite! 'cc-magnitude-closed 0) (fact 'cc-magnitude-zero)
          (dk-absurd! h '(= (magnitude 0) 0)))))
    w))
;; goal (FORSOME v (AND (IN v C) BODY)): witness W, close the typing by ass and BODY by THUNK
(define (ch-witness! w thunk)
  (ew w)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (thunk)))))
(define (cw-rr-mul-2! p q)
  (dk-have! `(AND (IN ,p RR) (IN ,q RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-mul-closed p q))
(define (ch-carr! kf thm . args)
  (let ((f (apply dk-cite! thm kf args)))
    f))

;; cancellation in CC
(sp (make-wff '(FORALL cz (IMPLIES (IN cz CC) (FORALL cu (IMPLIES (IN cu CC) (FORALL cv (IMPLIES (IN cv CC)
  (IMPLIES (NOT (= cz 0)) (IMPLIES (= (* cz cu) (* cz cv)) (= cu cv)))))))))))
(dk-peel!)
(ch-and! '(IN cz CC) '(NOT (= cz 0)))
(dk-cite! 'cc-recip-closed 'cz)
(dk-cite! 'cc-recip-inverse 'cz)
(let ((r (dk-name! '(recip cz) 'CC)))
  (dk-rewrite-h! '(= (* cz (recip cz)) 1) '(recip cz) r)
  (ch-and! '(IN cz CC) '(IN cu CC)) (dk-cite! 'cc-mul-closed 'cz 'cu)
  (ch-and! '(IN cz CC) '(IN cv CC)) (dk-cite! 'cc-mul-closed 'cz 'cv)
  (ch-and! `(IN ,r CC) '(IN (* cz cv) CC)) (dk-cite! 'cc-mul-closed r '(* cz cv))
  (dk-have! `(= cu (* (* cz ,r) cu)) (lambda () (subst `(= (* cz ,r) 1)) (crs)))
  (dk-have! `(= cv (* (* cz ,r) cv)) (lambda () (subst `(= (* cz ,r) 1)) (crs)))
  (dk-have! `(= (* (* cz ,r) cu) (* ,r (* cz cu))) (lambda () (crs)))
  (dk-have! `(= (* (* cz ,r) cv) (* ,r (* cz cv))) (lambda () (crs)))
  (subst `(= cu (* (* cz ,r) cu)))
  (subst `(= cv (* (* cz ,r) cv)))
  (subst `(= (* (* cz ,r) cu) (* ,r (* cz cu))))
  (subst `(= (* (* cz ,r) cv) (* ,r (* cz cv))))
  (subst '(= (* cz cu) (* cz cv)))
  (rfl))
(qed 'ch-cc-cancel)

;; chi(0) = 1
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi) (= (chi (ZERO kf)) 1)))))))
(dk-peel!)
(dk-cite! 'nf-zero-in-carr 'kf)
(let* ((z0 '(ZERO kf)) (hom (ch-hom! 'kf 'chi)) (e (dk-apply! hom z0 z0)) (w (ch-val! 'kf 'chi z0)))
  (dk-have! `(= ((ADD kf) ,z0 ,z0) ,z0) (lambda () (ch-crs! 'kf '())))
  (dk-rewrite-h! e `((ADD kf) ,z0 ,z0) z0)
  (fact 'cc-one-in)
  (dk-have! `(= (* ,w ,w) (* ,w 1)) (lambda () (subst `(= (* ,w ,w) ,w)) (crs)))
  (dk-cite! 'ch-cc-cancel w w 1)
  (dk-ass!))
(qed 'ch-zero)

;; chi(-x) chi(x) = 1
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi) (FORALL x (IMPLIES (IN x (CARR kf))
  (= (* (chi ((NEG kf) x)) (chi x)) 1)))))))))
(dk-peel!)
(dk-cite! 'nf-neg-in-carr 'kf 'x)
(dk-cite! 'nf-zero-in-carr 'kf)
(dk-cite! 'ch-zero 'kf 'chi)
(let* ((hom (ch-hom! 'kf 'chi)) (nx '((NEG kf) x)) (e (dk-apply! hom nx 'x)))
  (ch-val! 'kf 'chi nx) (ch-val! 'kf 'chi 'x)
  (dk-have! `(= ((ADD kf) ,nx x) (ZERO kf)) (lambda () (ch-crs! 'kf '(x))))
  (let ((e2 (dk-rewrite-h! e `((ADD kf) ,nx x) '(ZERO kf))))
    (subst `(= (* (chi ,nx) (chi x)) (chi (ZERO kf))))
    (dk-ass!)))
(qed 'ch-neg)

;; the value of Psi_chi(a)
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL x (IMPLIES (IN x (CARR kf))
    (= ((DUALITY-MAP kf chi a) x) (chi ((MUL kf) a x)))))))))))))
(dk-peel!)
(dk-cite! 'nf-mul-in-carr 'kf 'a 'x)
(ch-hom! 'kf 'chi)
(ch-val! 'kf 'chi '((MUL kf) a x))
(mac 'DUALITY-MAP)
(dk-lam-b!)
(rfl)
(qed 'ch-psi-value)

;; KF a normed field, X /= 0 in (CARR KF): land an inverse D (in CARR, D /= 0, X D = 1) and return it
(define (ch-inverse! kf x)
  (dk-skolem! (dk-cite! 'nf-inverse kf x)))

;; on the unit circle the conjugate is the inverse
(sp (make-wff '(FORALL cz (IMPLIES (IN cz CC) (IMPLIES (= (magnitude cz) 1) (FORALL cw (IMPLIES (IN cw CC)
  (IMPLIES (= (* cw cz) 1) (= (conjugate cz) cw)))))))))
(dk-peel!)
(dk-cite! 'cc-conjugate-closed 'cz)
(let ((h (dk-cite! 'cc-magnitude-sq-conjugate 'cz)))
  (dk-rewrite-h! h '(magnitude cz) 1))
(dk-have! '(NOT (= cz 0))
  (lambda ()
    (di)
    (let ((h (dk-rewrite-h! '(= (magnitude cz) 1) 'cz 0)))
      (fact 'cc-zero-in) (dk-cite! 'cc-magnitude-closed 0) (fact 'cc-magnitude-zero)
      (dk-absurd! h '(= (magnitude 0) 0)))))
(dk-have! '(= (* cz (conjugate cz)) (* cz cw))
  (lambda ()
    (subst '(= (* cz (conjugate cz)) (* 1 1)))
    (dk-have! '(= (* cz cw) (* cw cz)) (lambda () (crs)))
    (subst '(= (* cz cw) (* cw cz)))
    (subst '(= (* cw cz) 1))
    (arith)))
(dk-cite! 'ch-cc-cancel 'cz '(conjugate cz) 'cw)
(dk-ass!)
(qed 'ch-unit-conj)

;; Remark 5.14: Psi(a)(eta) Psi(b)(eta) = Psi(a + b)(eta)
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL b (IMPLIES (IN b (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
    (= (* ((DUALITY-MAP kf chi a) eta) ((DUALITY-MAP kf chi b) eta)) ((DUALITY-MAP kf chi ((ADD kf) a b)) eta))))))))))))))
(dk-peel!)
(dk-cite! 'nf-add-in-carr 'kf 'a 'b)
(dk-cite! 'nf-mul-in-carr 'kf 'a 'eta) (dk-cite! 'nf-mul-in-carr 'kf 'b 'eta)
(subst (dk-cite! 'ch-psi-value 'kf 'chi 'a 'eta))
(subst (dk-cite! 'ch-psi-value 'kf 'chi 'b 'eta))
(subst (dk-cite! 'ch-psi-value 'kf 'chi '((ADD kf) a b) 'eta))
(let* ((hom (ch-hom! 'kf 'chi)) (ae '((MUL kf) a eta)) (be '((MUL kf) b eta)) (e (dk-apply! hom ae be)))
  (dk-have! `(= ((MUL kf) ((ADD kf) a b) eta) ((ADD kf) ,ae ,be)) (lambda () (ch-crs! 'kf '(a b eta))))
  (subst `(= ((MUL kf) ((ADD kf) a b) eta) ((ADD kf) ,ae ,be)))
  (subst e)
  (ch-val! 'kf 'chi ae) (ch-val! 'kf 'chi be)
  (dk-cite! 'cc-mul-closed `(chi ,ae) `(chi ,be))
  (rfl))
(qed 'ch-psi-add)

;; Remark 5.14: the conjugate of Psi(a)(eta) is Psi(-a)(eta)
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
    (= (conjugate ((DUALITY-MAP kf chi a) eta)) ((DUALITY-MAP kf chi ((NEG kf) a)) eta))))))))))))
(dk-peel!)
(dk-cite! 'nf-neg-in-carr 'kf 'a)
(let ((ae '((MUL kf) a eta)))
  (dk-cite! 'nf-mul-in-carr 'kf 'a 'eta)
  (dk-cite! 'nf-neg-in-carr 'kf ae)
  (subst (dk-cite! 'ch-psi-value 'kf 'chi 'a 'eta))
  (subst (dk-cite! 'ch-psi-value 'kf 'chi '((NEG kf) a) 'eta))
  (dk-have! `(= ((MUL kf) ((NEG kf) a) eta) ((NEG kf) ,ae)) (lambda () (ch-crs! 'kf '(a eta))))
  (subst `(= ((MUL kf) ((NEG kf) a) eta) ((NEG kf) ,ae)))
  (ch-hom! 'kf 'chi)
  (ch-val! 'kf 'chi ae) (ch-val! 'kf 'chi `((NEG kf) ,ae))
  (dk-cite! 'ch-neg 'kf 'chi ae)
  (dk-cite! 'ch-unit-conj `(chi ,ae) `(chi ((NEG kf) ,ae)))
  (dk-ass!))
(qed 'ch-psi-conj)

;; Remark 5.14: for a non-trivial chi the Psi(c) separate every eta /= 0 from 0
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi)
  (FORALL eta (IMPLIES (IN eta (CARR kf)) (IMPLIES (NOT (= eta (ZERO kf)))
    (FORSOME cc_ (AND (IN cc_ (CARR kf))
      (NOT (= ((DUALITY-MAP kf chi cc_) eta) ((DUALITY-MAP kf chi cc_) (ZERO kf)))))))))))))))
(dk-peel!)
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(let* ((xi (dk-skolem! (dk-project! '(FORSOME chx_ (AND (IN chx_ (CARR kf)) (NOT (= (chi chx_) 1))))
                                    'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))))
       (d (ch-inverse! 'kf 'eta))
       (c `((MUL kf) ,xi ,d)))
  (dk-cite! 'nf-zero-in-carr 'kf)
  (dk-cite! 'nf-mul-in-carr 'kf xi d)
  (dk-cite! 'nf-mul-in-carr 'kf c 'eta)
  (dk-cite! 'nf-mul-in-carr 'kf c '(ZERO kf))
  (dk-cite! 'ch-zero 'kf 'chi)
  (ch-witness! c
    (lambda ()
      (subst (dk-cite! 'ch-psi-value 'kf 'chi c 'eta))
      (subst (dk-cite! 'ch-psi-value 'kf 'chi c '(ZERO kf)))
      (dk-have! `(= ((MUL kf) ,c (ZERO kf)) (ZERO kf)) (lambda () (ch-crs! 'kf (list xi d))))
      (dk-have! `(= ((MUL kf) ,c eta) ((MUL kf) ,xi ((MUL kf) eta ,d))) (lambda () (ch-crs! 'kf (list xi d 'eta))))
      (dk-have! `(= ((MUL kf) ,c eta) ,xi)
        (lambda ()
          (subst `(= ((MUL kf) ,c eta) ((MUL kf) ,xi ((MUL kf) eta ,d))))
          (subst `(= ((MUL kf) eta ,d) (ONE kf)))
          (ch-crs! 'kf (list xi))))
      (subst `(= ((MUL kf) ,c eta) ,xi))
      (subst `(= ((MUL kf) ,c (ZERO kf)) (ZERO kf)))
      (subst '(= (chi (ZERO kf)) 1))
      (dk-ass!))))
(qed 'ch-psi-separates)

;; Proposition 5.12: for a non-trivial chi, a |-> Psi_chi(a) is injective
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL b (IMPLIES (IN b (CARR kf))
    (IMPLIES (= (DUALITY-MAP kf chi a) (DUALITY-MAP kf chi b)) (= a b))))))))))))
(dk-peel!)
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(pbc)
(dk-cite! 'nf-neg-in-carr 'kf 'b)
(dk-cite! 'nf-add-in-carr 'kf 'a '((NEG kf) b))
(let ((c '((ADD kf) a ((NEG kf) b))))
  (dk-have! `(NOT (= ,c (ZERO kf)))
    (lambda () (di) (dk-cite! 'nf-sub-zero-eq 'kf 'a 'b) (ai '(NOT (= a b)))))
  (let* ((xi (dk-skolem! (dk-project! '(FORSOME chx_ (AND (IN chx_ (CARR kf)) (NOT (= (chi chx_) 1))))
                                      'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))))
         (d (ch-inverse! 'kf c))
         (eta `((MUL kf) ,d ,xi))
         (ae `((MUL kf) a ,eta)) (be `((MUL kf) b ,eta)))
    (dk-cite! 'nf-mul-in-carr 'kf d xi)
    (dk-cite! 'nf-mul-in-carr 'kf 'a eta) (dk-cite! 'nf-mul-in-carr 'kf 'b eta)
    (dk-cite! 'nf-mul-in-carr 'kf c eta)
    (dk-cite! 'nf-neg-in-carr 'kf be)
    (dk-cite! 'ch-psi-value 'kf 'chi 'a eta) (dk-cite! 'ch-psi-value 'kf 'chi 'b eta)
    (dk-have! `(= (chi ,ae) (chi ,be))
      (lambda ()
        (subst `(= (chi ,ae) ((DUALITY-MAP kf chi a) ,eta)))
        (subst '(= (DUALITY-MAP kf chi a) (DUALITY-MAP kf chi b)))
        (dk-ass!)))
    (let* ((hom (ch-hom! 'kf 'chi)) (e (dk-apply! hom ae `((NEG kf) ,be))))
      (dk-have! `(= ((ADD kf) ,ae ((NEG kf) ,be)) ((MUL kf) ,c ,eta)) (lambda () (ch-crs! 'kf (list 'a 'b d xi))))
      (dk-have! `(= ((MUL kf) ,c ,eta) ,xi)
        (lambda ()
          (dk-have! `(= ((MUL kf) ,c ,eta) ((MUL kf) ((MUL kf) ,c ,d) ,xi)) (lambda () (ch-crs! 'kf (list 'a 'b d xi))))
          (subst `(= ((MUL kf) ,c ,eta) ((MUL kf) ((MUL kf) ,c ,d) ,xi)))
          (subst `(= ((MUL kf) ,c ,d) (ONE kf)))
          (ch-crs! 'kf (list xi))))
      (let* ((e2 (dk-rewrite-h! e `((ADD kf) ,ae ((NEG kf) ,be)) `((MUL kf) ,c ,eta)))
             (e3 (dk-rewrite-h! e2 `((MUL kf) ,c ,eta) xi))
             (e4 (dk-rewrite-h! e3 `(chi ,ae) `(chi ,be))))
        (ch-val! 'kf 'chi be) (ch-val! 'kf 'chi `((NEG kf) ,be))
        (dk-cite! 'ch-neg 'kf 'chi be)
        (dk-have! `(= (chi ,xi) 1)
          (lambda ()
            (subst e4)
            (dk-have! `(= (* (chi ,be) (chi ((NEG kf) ,be))) (* (chi ((NEG kf) ,be)) (chi ,be))) (lambda () (crs)))
            (subst `(= (* (chi ,be) (chi ((NEG kf) ,be))) (* (chi ((NEG kf) ,be)) (chi ,be))))
            (dk-ass!)))
        (ai `(NOT (= (chi ,xi) 1)))))))
(qed 'ccr-5-12-injective)

;; Lemma 5.15, its core: chi trivial on b B(1) is trivial on B(|b|)
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (FORALL b (IMPLIES (IN b (CARR kf)) (IMPLIES (NOT (= b (ZERO kf)))
    (IMPLIES (FORALL eta (IMPLIES (IN eta (CARR kf)) (IMPLIES (<= ((FNRM kf) eta) 1) (= (chi ((MUL kf) b eta)) 1))))
      (FORALL xi (IMPLIES (IN xi (CARR kf)) (IMPLIES (<= ((FNRM kf) xi) ((FNRM kf) b)) (= (chi xi) 1))))))))))))))
(dk-peel!)
(let* ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FNRM))) "the hypothesis"))
       (d (ch-inverse! 'kf 'b))
       (eta `((MUL kf) ,d xi))
       (nm (lambda (t) `((FNRM kf) ,t))))
  (dk-cite! 'nf-mul-in-carr 'kf d 'xi)
  (dk-cite! 'nf-mul-in-carr 'kf 'b d)
  (dk-cite! 'nf-one-in-carr 'kf)
  (for-each (lambda (t) (dk-cite! 'nf-norm-in-rr 'kf t)) (list 'xi 'b d eta `((MUL kf) b ,d) '(ONE kf)))
  (dk-cite! 'nf-norm-nonneg 'kf d)
  (dk-cite! 'nf-norm-mult 'kf d 'xi)
  (let ((h (dk-cite! 'nf-norm-mult 'kf 'b d)))
    (dk-rewrite-h! h `((MUL kf) b ,d) '(ONE kf)))
  (dk-cite! 'nf-norm-one 'kf)
  (dk-cite! 'rr-mul-le-right (nm 'xi) (nm 'b) (nm d))
  (cw-rr-mul-2! (nm 'xi) (nm d)) (cw-rr-mul-2! (nm 'b) (nm d)) (cw-rr-mul-2! (nm d) (nm 'xi))
  (dk-have! `(= (* ,(nm d) ,(nm 'xi)) (* ,(nm 'xi) ,(nm d))) (lambda () (crs)))
  (dk-have! `(<= ,(nm eta) 1)
    (lambda () (dk-ineq! `(= ,(nm eta) (* ,(nm d) ,(nm 'xi))) `(= (* ,(nm d) ,(nm 'xi)) (* ,(nm 'xi) ,(nm d)))
                         `(<= (* ,(nm 'xi) ,(nm d)) (* ,(nm 'b) ,(nm d))) `(= ((FNRM kf) (ONE kf)) (* ,(nm 'b) ,(nm d)))
                         `(= ((FNRM kf) (ONE kf)) 1))))
  (let ((h (dk-apply! hyp eta)))
    (dk-have! `(= ((MUL kf) b ,eta) xi)
      (lambda ()
        (dk-have! `(= ((MUL kf) b ,eta) ((MUL kf) ((MUL kf) b ,d) xi)) (lambda () (ch-crs! 'kf (list 'b d 'xi))))
        (subst `(= ((MUL kf) b ,eta) ((MUL kf) ((MUL kf) b ,d) xi)))
        (subst `(= ((MUL kf) b ,d) (ONE kf)))
        (ch-crs! 'kf '(xi))))
    (dk-rewrite-h! h `((MUL kf) b ,eta) 'xi)
    (dk-ass!)))
(qed 'ccr-5-15-core)

;; the point step of ch-scale-continuous, BY CITATION: x |-> sc x is continuous as a product of the constant
;; and the identity (nf-product-continuous-at), compose with f (ms-compose-continuous-at), and move the
;; continuity to the goal's lambda (ms-cont-transfer-ptwise-eq).  Goal: IS-CONTINUOUS-AT(MS, CC-MS, T, X0).
(define (ch-scale-at! ms cont-univ x0 lam-typ!)
  (let* ((g (dk-goal)) (tl (list-ref g 3))
         (lc `(VNB-LAMBDA msz_ (PTS ,ms) sc)) (li `(VNB-LAMBDA msz_ (PTS ,ms) msz_)))
    (dk-have! `(IN sc (PTS ,ms)) (lambda () (subst `(== (PTS ,ms) (CARR kf))) (dk-ass!)))
