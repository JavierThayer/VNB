                             (dk-have! `(IN (- ,u ,v) CC) (lambda () (mac 'binary-minus-def) (dk-ass!)))
                             (dk-cite! 'cc-magnitude-closed `(- ,u ,v))
                             (dk-cite! 'cc-magnitude-nonneg `(- ,u ,v)))))
    (cmul f0 g0) (cmul fb gb)
    (csub f0 fb) (csub g0 gb) (csub p0 pb)
    (let* ((t1 `(* ,f0 (- ,g0 ,gb))) (t2 `(* ,gb (- ,f0 ,fb))))
      (cmul f0 `(- ,g0 ,gb)) (cmul gb `(- ,f0 ,fb))
      (dk-have! `(= (- ,p0 ,pb) (+ ,t1 ,t2)) (lambda () (mac 'binary-minus-def) (crs)))
