      (ch-and! `(IN ,f0 CC) `(IN (- ,g0 ,gb) CC)) (dk-cite! 'cc-magnitude-mul f0 `(- ,g0 ,gb))
      (ch-and! `(IN ,gb CC) `(IN (- ,f0 ,fb) CC)) (dk-cite! 'cc-magnitude-mul gb `(- ,f0 ,fb))
      (dk-cite! 'cc-magnitude-closed `(+ ,t1 ,t2))
      (dk-cite! 'cc-magnitude-closed t1) (dk-cite! 'cc-magnitude-closed t2)
      (let* ((e1 (dk-rewrite-h! `(= (magnitude ,t1) (* (magnitude ,f0) (magnitude (- ,g0 ,gb)))) `(magnitude ,f0) 1))
             (e2 (dk-rewrite-h! `(= (magnitude ,t2) (* (magnitude ,gb) (magnitude (- ,f0 ,fb)))) `(magnitude ,gb) 1))
             (dd0 (dk-cite! 'cc-ms-dist f0 fb)) (dd1 (dk-cite! 'cc-ms-dist g0 gb)) (dd2 (dk-cite! 'cc-ms-dist p0 pb))
             (bf (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f `((DIST CC-MS) ,f0 ,fb)))) "the f bound"))
             (bg (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f `((DIST CC-MS) ,g0 ,gb)))) "the g bound"))
             (bf2 (dk-rewrite-h! bf `((DIST CC-MS) ,f0 ,fb) `(magnitude (- ,f0 ,fb))))
