  (dk-project! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME delta (AND (POS-RR delta)
                  (FORALL b (IMPLIES (IN b (PTS ,s)) (IMPLIES (<= ((DIST ,s) ,x0 b) delta)
                    (<= ((DIST CC-MS) (,fn ,x0) (,fn b)) eps))))))))
               'is-continuous-at cat))
;; FN in FUN(PTS S, UNIT-CIRCLE), X in PTS S: land FN(X) in CC with magnitude 1
(define (ch-unit! s fn x)
  (ch-and! `(IN ,fn (FUN (PTS ,s) UNIT-CIRCLE)) `(IN ,x (PTS ,s)))
  (dk-cite! 'fun-apply-type fn `(PTS ,s) 'UNIT-CIRCLE x)
  (ch-iff-fwd! (dk-cite! 'unit-circle-membership `(,fn ,x))))

