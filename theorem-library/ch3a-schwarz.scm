;;; ======================================================================
;;; (3) the quotient f(z)/z of Schwarz's lemma: holomorphic on D and bounded by 1
;;; ======================================================================
(define csw-D '(BALL CC-MS 0 1))
(define (csw-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (if (not (dk-asm? (list 'AND (list 'IN a 'NN) (list 'IN b 'NN))))
            (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close!))))
        (fact 'nn-add-closed a b))))
(define (csw-rad! m)
  (let ((r (list 'recip (list '+ m 1))))
    (if (not (dk-asm? (list 'IN r 'RR)))
        (begin (dk-cite! 'nn-recip-succ-pos m) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)))
    r))
;; e1, e2 POS-RR: a t = recip(n+1) with 0 < t, t < e1, t < e2
(define (csw-small! e1 e2)
  (let* ((n1 (dk-skolem! (dk-cite! 'nn-recip-succ-small e1)))
         (_1 (dk-split-all!))
         (n2 (dk-skolem! (dk-cite! 'nn-recip-succ-small e2)))
         (_2 (dk-split-all!))
         (n (list '+ n1 n2)))
    (csw-nn-add! n1 n2)
    (csw-rad! n1) (csw-rad! n2)
    (let ((t (csw-rad! n)))
      (dk-have! (list '<= n1 n) (lambda () (dk-nn!)))
      (dk-have! (list '<= n2 n) (lambda () (dk-nn!)))
      (dk-cite! 'nn-recip-succ-antitone n1 n)
      (dk-cite! 'nn-recip-succ-antitone n2 n)
      (dk-have! (list '< t e1) (lambda () (dk-ineq! (list '<= t (list 'recip (list '+ n1 1))) (list '< (list 'recip (list '+ n1 1)) e1))))
      (dk-have! (list '< t e2) (lambda () (dk-ineq! (list '<= t (list 'recip (list '+ n2 1))) (list '< (list 'recip (list '+ n2 1)) e2))))
      t)))
;; w in CC: (DIST CC-MS)(0, w) = |w| and |w - 0| = |w|
(define (csw-d0! w)
  (csw-mag! w)
  (fact 'cc-zero-in)
  (if (not (dk-asm? (list '= (list 'magnitude (list '- w 0)) (list 'magnitude w))))
      (begin
        (dk-have! (list '= (list '- w 0) w) (lambda () (crs)))
        (dk-have! (list '= (list '- 0 w) (list '- w))
          (lambda () (crs)))
        (csw-mag! (list '- w 0))
        (dk-have! (list '= (list 'magnitude (list '- w 0)) (list 'magnitude w)) (lambda () (subst (list '= (list '- w 0) w)) (rfl)))
        (dk-cite! 'cc-ms-dist 0 w)
        (dk-cite! 'cc-magnitude-neg w)
        (dk-have! (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude w))
          (lambda ()
            (subst (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude (list '- 0 w))))
            (subst (list '= (list '- 0 w) (list '- w)))
            (ass)))
        (dk-have! (list 'IN (list '(DIST CC-MS) 0 w) 'RR)
          (lambda () (subst (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude w))) (ass))))))
;; s real, 0 <= s: |s| = s
(define (csw-mag-real! s)
  (dk-cite! 'rr-magnitude-is-abs s)
  (dk-cite! 'rr-abs-of-nonneg s)
  (dk-have! (list '= (list 'magnitude s) s)
    (lambda () (subst (list '= (list 'magnitude s) (list 'abs s))) (subst (list '= (list 'abs s) s)) (rfl))))
;; w in CC with |w| < r (r in RR): w in BALL(CC-MS, 0, r)
(define (csw-in-ball! w r)
  (csw-d0! w)
  (let ((bi (dk-cite! 'cc-ms-ball-membership 0 r w)))
    (dk-have! (list '< (list 'magnitude (list '- w 0)) r)
      (lambda () (dk-ineq! (list '= (list 'magnitude (list '- w 0)) (list 'magnitude w)) (list '< (list 'magnitude w) r))))
    (dk-have! (list 'IN w (list 'BALL 'CC-MS 0 r))
      (lambda () (dk-only! bi (list 'IN w 'CC) (list '< (list 'magnitude (list '- w 0)) r)) (prop)))))
;; w in BALL(CC-MS, 0, r): land w in CC and |w| < r
(define (csw-of-ball! w r)
  (let ((bi (dk-cite! 'cc-ms-ball-membership 0 r w)))
    (dk-have! (caddr bi) (lambda () (prop)))
    (dk-split-all! (list (caddr bi)))
    (csw-d0! w)
    (dk-have! (list '< (list 'magnitude w) r)
      (lambda () (dk-ineq! (list '= (list 'magnitude (list '- w 0)) (list 'magnitude w)) (list '< (list 'magnitude (list '- w 0)) r))))))

;; the two cases of the bound |q(z)| <= 1: the maximum point p of |q| on K = B'(0, rho) lies inside
;; B(0, rho) (then q is constant there, and |f| >= 1 at a point s with recip(A) < s < rho), or on
;; |p| = rho (then |q(p)| rho = |f(p)| < 1 < A rho).  Goal FALSITY.
(define (csw-schwarz-cases! p qp gp aa ra rho kk mx)
  (let ((mp (list 'magnitude p)))
    (dk-have! (list '= (list '* rho aa) (list '* aa rho)) (lambda () (crs)))
    (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list '< 0 rho))))
    (fact 'subset-mem-fwd kk csw-D p)
    (dk-apply! csw-fr p)
    (dk-apply! csw-3-H1 p)
    (dk-have! (list 'AND (list 'IN csw-q (list 'FUN csw-D 'CC)) '(IN 0 CC)) (lambda () (dk-conj-close!)))
    (dk-have! (list 'AND (list 'IN qp 'CC) (list 'IN p 'CC)) (lambda () (dk-conj-close!)))
    (dk-cite! 'cc-magnitude-mul qp p)
    (dk-rewrite-h! (list '< (list 'magnitude (list 'f p)) 1) (list 'f p) (list '* qp p))
    (dk-rewrite-h! (list '< (list 'magnitude (list '* qp p)) 1) (list 'magnitude (list '* qp p)) (list '* gp mp))
    (use-em (list '= mp rho)
      (lambda ()
        ;; on the circle |p| = rho
        (dk-rewrite-h! (list '< (list '* gp mp) 1) mp rho)
        (dk-cite! 'rr-mul-le-right aa gp rho)
        (csw-rr! (list '* gp rho)) (csw-rr! (list '* aa rho)) (csw-rr! (list '* rho aa))
        (dk-absurd! (list '< (list '* gp rho) 1) (list '<= (list '* aa rho) (list '* gp rho))
                    (list '< 1 (list '* rho aa)) (list '= (list '* rho aa) (list '* aa rho))))
      (lambda ()
        ;; inside: |p| < rho
        (dk-have! (list 'AND (list '<= mp rho) (list 'NOT (list '= mp rho))) (lambda () (dk-conj-close!)))
        (fact 'rr-le-ne-lt mp rho)
        (let* ((bb (list 'BALL 'CC-MS 0 rho))
               (rq (list 'RESTRICT csw-q bb)))
          (dk-have! (list 'AND (list 'IN rho 'RR) (list 'AND (list '<= 0 rho) (list 'NOT (list '= 0 rho))))
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond ((dk-asm? g) (ass))
                          ((dk-head-is? g '<=) (dk-ineq! (list '< 0 rho)))
                          (#t (di) (dk-absurd! (list '= 0 rho) (list '< 0 rho)))))))))
          (dk-cite! 'ball-is-open 'CC-MS 0 rho)
          (dk-cite! 'cc-ms-open-iff bb)
          (dk-have! (list 'IS-OPEN csw-nf bb) (lambda () (prop)))
          (dk-cite! 'ball-in-closed-ball 'CC-MS 0 rho)
          (fact 'subset-trans bb kk csw-D)
          (dk-cite! 'holomorphic-on-restrict csw-D csw-q bb)
          (dk-cite! 'cc-ball-connected 0 rho)
          (csw-in-ball! p rho)
          (dk-have! (list 'FORALL 'cswo_ (list 'IMPLIES (list 'IN 'cswo_ bb) (list '<= (list 'magnitude (list rq 'cswo_)) (list 'magnitude (list rq p)))))
            (lambda ()
              (let ((w (dk-di-var!)))
                (dk-cite! 'restrict-apply csw-q bb w)
                (dk-cite! 'restrict-apply csw-q bb p)
                (subst (list '= (list rq w) (list csw-q w)))
                (subst (list '= (list rq p) qp))
                (fact 'subset-mem-fwd bb kk w)
                (dk-apply! mx w)
                (ass))))
          (let* ((mmc (dk-cite! 'maximum-modulus-connected bb rq p))
                 (e (csw-pos-diff! ra rho))
                 (h (dk-halve! e))
                 (sv (list '+ ra h)))
            (fact 'rr-add-in-rr ra h)
            (dk-have! (list '<= 0 sv) (lambda () (dk-ineq! (list '< 0 ra) (list '< 0 h))))
            (csw-mag-real! sv)
            (csw-mag! sv)
            (dk-have! (list '< (list 'magnitude sv) rho)
              (lambda () (dk-ineq! (list '= (list 'magnitude sv) sv) (list '= (list '+ h h) e) (list '< 0 h))))
            (csw-in-ball! sv rho)
            (fact 'subset-mem-fwd bb csw-D sv)
            (dk-apply! mmc sv)
            (dk-cite! 'restrict-apply csw-q bb sv)
            (dk-cite! 'restrict-apply csw-q bb p)
            (let* ((qs (list csw-q sv))
                   (eq0 (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list rq sv)) (equal? (caddr fm) (list rq p)))) "R(s) = R(p)"))
                   (eq1 (dk-rewrite-h! eq0 (list rq sv) qs))
                   (eq2 (dk-rewrite-h! eq1 (list rq p) qp)))
              (fact 'fun-apply-type-c csw-q csw-D 'CC sv)
              (csw-mag! qs)
              (dk-apply! csw-fr sv)
              (dk-apply! csw-3-H1 sv)
              (dk-have! (list 'AND (list 'IN qs 'CC) (list 'IN sv 'CC)) (lambda () (dk-conj-close!)))
              (dk-cite! 'cc-magnitude-mul qs sv)
              (dk-rewrite-h! (list '< (list 'magnitude (list 'f sv)) 1) (list 'f sv) (list '* qs sv))
              (dk-rewrite-h! (list '< (list 'magnitude (list '* qs sv)) 1) (list 'magnitude (list '* qs sv)) (list '* (list 'magnitude qs) (list 'magnitude sv)))
              (dk-rewrite-h! (list '< (list '* (list 'magnitude qs) (list 'magnitude sv)) 1) (list 'magnitude sv) sv)
              (dk-rewrite-h! (list '< (list '* (list 'magnitude qs) sv) 1) qs qp)
              (dk-cite! 'rr-mul-le-right aa gp sv)
              (csw-rr! (list '* gp sv)) (csw-rr! (list '* aa sv)) (csw-rr! (list '* sv aa))
              (dk-have! (list '< (list '* 1 ra) sv) (lambda () (dk-ineq! (list '< 0 h))))
              (dk-cite! 'rr-lt-mul-of-div-lt 1 sv aa)
              (dk-have! (list '= (list '* sv aa) (list '* aa sv)) (lambda () (crs)))
              (dk-absurd! (list '< (list '* gp sv) 1) (list '<= (list '* aa sv) (list '* gp sv))
                          (list '< 1 (list '* sv aa)) (list '= (list '* sv aa) (list '* aa sv))))))))))

(sp (make-wff (list 'FORALL 'f (list 'IMPLIES (list 'HOLOMORPHIC-ON csw-D 'f)
  (list 'IMPLIES '(= (f 0) 0)
    (list 'IMPLIES (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z csw-D) '(< (magnitude (f z)) 1)))
      (list 'FORSOME 'q (list 'AND (list 'HOLOMORPHIC-ON csw-D 'q)
        (list 'AND (list 'FORALL 'xw (list 'IMPLIES (list 'IN 'xw csw-D) '(= (f xw) (* (q xw) xw))))
                   (list 'FORALL 'xw (list 'IMPLIES (list 'IN 'xw csw-D) '(<= (magnitude (q xw)) 1))))))))))))
(dk-peel!)
(define csw-3-H1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude))) "|f| < 1"))
(fact 'cc-is-metric-space)
(csw-pts-cc!)
(fact 'cc-zero-in)
(fact 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(let ((hi (dk-cite! 'holomorphic-on csw-D 'f)))
  (dk-have! (caddr hi) (lambda () (prop)))
  (dk-split-all! (list (caddr hi))))
(fact 'cc-open-subset-cc csw-D)
(dk-cite! 'cc-ms-ball-centre 0 1)
(define csw-q (dk-skolem! (dk-cite! 'holomorphic-difference-quotient csw-D 'f 0)))
(dk-split-all!)
(define csw-rel (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(f 0)))) "the quotient relation"))
(dk-cite! 'holomorphic-removable-point csw-D csw-q 0)
;; f(x) = q(x) x
(define csw-fr (list 'FORALL 'xw (list 'IMPLIES (list 'IN 'xw csw-D) (list '= '(f xw) (list '* (list csw-q 'xw) 'xw)))))
(dk-have! csw-fr
  (lambda ()
    (let* ((x (dk-di-var!))
           (e (dk-apply! csw-rel x)))
      (fact 'subset-mem-fwd csw-D 'CC x)
      (fact 'fun-apply-type-c 'f csw-D 'CC x)
      (fact 'fun-apply-type-c csw-q csw-D 'CC x)
      (let* ((e1 (dk-rewrite-h! e '(f 0) 0))
             (_ (dk-have! (list '= (list '- (list 'f x) 0) (list 'f x)) (lambda () (crs))))
             (e2 (dk-rewrite-h! e1 (list '- (list 'f x) 0) (list 'f x)))
             (_2 (dk-have! (list '= (list '- x 0) x) (lambda () (crs))))
             (e3 (dk-rewrite-h! e2 (list '- x 0) x)))
        (ass)))))
;; |q| <= 1 on D
(define csw-qb (list 'FORALL 'xw (list 'IMPLIES (list 'IN 'xw csw-D) (list '<= (list 'magnitude (list csw-q 'xw)) 1))))
(define csw-cont-q (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT) (dk-contains? fm csw-q))) "continuity of q"))
(dk-have! csw-qb
  (lambda ()
    (let* ((z (dk-di-var!))
           (qz (list csw-q z))
           (aa (list 'magnitude qz)))
      (fact 'subset-mem-fwd csw-D 'CC z)
      (fact 'fun-apply-type-c csw-q csw-D 'CC z)
      (csw-mag! qz)
      (use-em (list '<= aa 1)
        (lambda () (ass))
        (lambda ()
          (pbc)
          (dk-cite! 'rr-not-le-lt aa 1)
          (csw-of-ball! z 1)
          (dk-have! (list 'NOT (list '= aa 0)) (lambda () (di) (dk-absurd! (list '= aa 0) (list '< 1 aa))))
          (dk-have! (list 'AND (list 'IN aa 'RR) (list 'NOT (list '= aa 0))) (lambda () (dk-conj-close!)))
          (fact 'rr-recip-closed aa)
          (fact 'rr-recip-inverse aa)
          (dk-have! (list '< 0 aa) (lambda () (dk-ineq! (list '< 1 aa))))
          (dk-cite! 'rr-recip-pos aa)
          (let* ((ra (list 'recip aa)))
            ;; recip(A) < 1: recip(A) <= recip(1) = 1, and recip(A) = 1 would make A = 1
            (fact 'rr-recip-one)
            (dk-have! (list '<= 1 aa) (lambda () (dk-ineq! (list '< 1 aa))))
            (dk-cite! 'rr-recip-antitone 1 aa)
            (dk-rewrite-h! (list '<= ra '(recip 1)) '(recip 1) 1)
            (dk-have! (list 'NOT (list '= ra 1))
              (lambda ()
                (di)
                (dk-rewrite-h! (list '= (list '* aa ra) 1) ra 1)
                (dk-have! (list '= (list '* aa 1) aa) (lambda () (crs)))
                (dk-absurd! (list '= (list '* aa 1) 1) (list '= (list '* aa 1) aa) (list '< 1 aa))))
            (dk-have! (list 'AND (list '<= ra 1) (list 'NOT (list '= ra 1))) (lambda () (dk-conj-close!)))
            (fact 'rr-le-ne-lt ra 1)
            (let* ((e1 (csw-pos-diff! (list 'magnitude z) 1))
                   (e2 (csw-pos-diff! ra 1))
                   (t (csw-small! e1 e2))
                   (rho0 (list '- 1 t))
                   (_rs (fact 'rr-sub-in-rr 1 t))
                   (rho (dk-name! rho0))
                   (req (list '= rho rho0)))
              (dk-have! (list '< (list 'magnitude z) rho) (lambda () (dk-ineq! req (list '< t e1))))
              (dk-have! (list '< ra rho) (lambda () (dk-ineq! req (list '< t e2))))
              (dk-have! (list '< rho 1) (lambda () (dk-ineq! req (list '< 0 t))))
              (csw-mag-real! 1)
              (dk-cite! 'cc-magnitude-nonneg z)
              (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '< (list 'magnitude z) rho) (list '<= 0 (list 'magnitude z)))))
              (let* ((kk (list 'CLOSED-BALL 'CC-MS 0 rho)))
                (dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                (dk-cite! 'closed-ball-in-ball 'CC-MS 0 rho 1)
                (dk-cite! 'cc-closed-ball-compact 0 rho)
                ;; z in K
                (csw-d0! z)
                (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                (let ((ci (dk-cite! 'closed-ball-membership 'CC-MS 0 rho z)))
                  (dk-have! (list '<= (list '(DIST CC-MS) 0 z) rho)
                    (lambda () (dk-ineq! (list '= (list '(DIST CC-MS) 0 z) (list 'magnitude z)) (list '< (list 'magnitude z) rho))))
                  (dk-have! (list 'IN z kk) (lambda () (dk-only! ci (list 'IN z '(PTS CC-MS)) (list '<= (list '(DIST CC-MS) 0 z) rho)) (prop))))
                (let* ((p (dk-skolem! (dk-cite! 'cc-compact-modulus-max csw-D csw-q kk z)))
                       (_ (dk-split-all!))
                       (qp (list csw-q p))
                       (gp (list 'magnitude qp))
                       (mx (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm gp))) "the maximum")))
                  (dk-apply! mx z)
                  (fact 'subset-mem-fwd kk csw-D p)
                  (fact 'subset-mem-fwd csw-D 'CC p)
                  (fact 'fun-apply-type-c csw-q csw-D 'CC p)
                  (csw-mag! qp)
                  (csw-d0! p)
                  (let ((ci (dk-cite! 'closed-ball-membership 'CC-MS 0 rho p)))
                    (dk-have! (caddr ci) (lambda () (prop)))
                    (dk-split-all! (list (caddr ci))))
                  (dk-have! (list '<= (list 'magnitude p) rho)
                    (lambda () (dk-ineq! (list '= (list '(DIST CC-MS) 0 p) (list 'magnitude p)) (list '<= (list '(DIST CC-MS) 0 p) rho))))
                  (dk-have! (list '< (list '* 1 ra) rho) (lambda () (dk-ineq! (list '< ra rho))))
                  (dk-cite! 'rr-lt-mul-of-div-lt 1 rho aa)
                  (csw-schwarz-cases! p qp gp aa ra rho kk mx))))))))))
(ew csw-q)
(dk-conj-close!)
