;;; ======================================================================
;;; (4) PROPOSITION 3.57: Schwarz's lemma
;;; ======================================================================
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES (list 'HOLOMORPHIC-ON csw-D 'f)
  (list 'IMPLIES '(= (f 0) 0)
    (list 'IMPLIES (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z csw-D) '(< (magnitude (f z)) 1)))
      (list 'AND (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z csw-D) '(<= (magnitude (f z)) (magnitude z))))
        (list 'IMPLIES (list 'FORSOME 'u0 (list 'AND (list 'IN 'u0 csw-D) '(AND (NOT (= u0 0)) (= (magnitude (f u0)) (magnitude u0)))))
          (list 'FORSOME 'r (list 'AND '(IN r CC) (list 'AND '(= (magnitude r) 1)
            (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z csw-D) '(= (f z) (* r z)))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(csw-pts-cc!)
(fact 'cc-zero-in)
(fact 'rr-one-in)
(define csw-4-q (dk-skolem! (dk-cite! 'schwarz-quotient 'f)))
(dk-split-all!)
(let ((hi (dk-cite! 'holomorphic-on csw-D csw-4-q)))
  (dk-have! (caddr hi) (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON csw-D csw-4-q)) (prop)))
  (dk-split-all! (list (caddr hi))))
(let ((hi (dk-cite! 'holomorphic-on csw-D 'f)))
  (dk-have! (caddr hi) (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON csw-D 'f)) (prop)))
  (dk-split-all! (list (caddr hi))))
(fact 'cc-open-subset-cc csw-D)
(define csw-4-fr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(f xw)))) "f = q z"))
(define csw-4-qb (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude) (dk-contains? fm csw-4-q) (not (dk-contains? fm 'f)))) "|q| <= 1"))
;; w in D: |f(w)| = |q(w)| |w|, typed
(define (csw-4-abs! w)
  (let ((qw (list csw-4-q w)))
    (fact 'subset-mem-fwd csw-D 'CC w)
    (fact 'fun-apply-type-c csw-4-q csw-D 'CC w)
    (fact 'fun-apply-type-c 'f csw-D 'CC w)
    (csw-mag! qw) (csw-mag! w) (csw-mag! (list 'f w))
    (dk-apply! csw-4-fr w)
    (dk-have! (list 'AND (list 'IN qw 'CC) (list 'IN w 'CC)) (lambda () (dk-conj-close!)))
    (dk-cite! 'cc-magnitude-mul qw w)
    (dk-have! (list '= (list 'magnitude (list 'f w)) (list '* (list 'magnitude qw) (list 'magnitude w)))
      (lambda () (subst (list '= (list 'f w) (list '* qw w))) (ass)))
    (dk-apply! csw-4-qb w)
    (dk-cite! 'cc-magnitude-nonneg w)
    (csw-rr! (list '* (list 'magnitude qw) (list 'magnitude w)))))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (if (dk-head-is? (dk-goal) 'FORALL)
            ;; (1) |f(z)| <= |z|
            (let* ((z (dk-di-var!))
                   (qz (list csw-4-q z)))
              (csw-4-abs! z)
              (dk-cite! 'rr-mul-le-right (list 'magnitude qz) 1 (list 'magnitude z))
              (dk-have! (list '= (list '* 1 (list 'magnitude z)) (list 'magnitude z)) (lambda () (crs)))
              (dk-ineq! (list '= (list 'magnitude (list 'f z)) (list '* (list 'magnitude qz) (list 'magnitude z)))
                        (list '<= (list '* (list 'magnitude qz) (list 'magnitude z)) (list '* 1 (list 'magnitude z)))
                        (list '= (list '* 1 (list 'magnitude z)) (list 'magnitude z))))
            ;; (2) equality at u0 /= 0
            (let* ((ex (car (dk-landed (lambda () (di)))))
                   (u0 (dk-skolem! ex))
                   (_ (dk-split-all!))
                   (qu (list csw-4-q u0))
                   (mu (list 'magnitude u0))
                   (mq (list 'magnitude qu)))
              (csw-4-abs! u0)
              (let ((zi (dk-cite! 'cc-magnitude-zero-iff u0)))
                (dk-have! (list 'NOT (list '= 0 mu))
                  (lambda () (di) (dk-have! (list '= mu 0) (lambda () (dk-ineq! (list '= 0 mu)))) (dk-only! zi (list '= mu 0) (list 'NOT (list '= u0 0))) (prop))))
              (dk-have! (list 'AND (list '<= 0 mu) (list 'NOT (list '= 0 mu))) (lambda () (dk-conj-close!)))
              (fact 'rr-le-ne-lt 0 mu)
              (dk-have! (list '<= (list '* 1 mu) (list '* mq mu))
                (lambda () (dk-have! (list '= (list '* 1 mu) mu) (lambda () (crs)))
                           (dk-ineq! (list '= (list '* 1 mu) mu) (list '= (list 'magnitude (list 'f u0)) mu)
                                     (list '= (list 'magnitude (list 'f u0)) (list '* mq mu)))))
              (dk-cite! 'rr-mul-le-cancel-pos 1 mu mq)
              ;; |q| attains its maximum 1 at u0: q is constant on the connected D
              (dk-cite! 'cc-ball-connected 0 1)
              (dk-have! (list 'FORALL 'cswm_ (list 'IMPLIES (list 'IN 'cswm_ csw-D) (list '<= (list 'magnitude (list csw-4-q 'cswm_)) mq)))
                (lambda ()
                  (let ((w (dk-di-var!)))
                    (dk-apply! csw-4-qb w)
                    (fact 'subset-mem-fwd csw-D 'CC w)
                    (fact 'fun-apply-type-c csw-4-q csw-D 'CC w)
                    (csw-mag! (list csw-4-q w))
                    (dk-ineq! (list '<= (list 'magnitude (list csw-4-q w)) 1) (list '<= 1 mq)))))
              (let ((const (dk-cite! 'maximum-modulus-connected csw-D csw-4-q u0)))
                (ew qu)
                (dk-conj-close!
                  (lambda ()
                    (let ((g (dk-goal)))
                      (cond ((dk-asm? g) (ass))
                            ((dk-head-is? g '=)
                             (dk-have! (list 'AND (list '<= mq 1) (list '<= 1 mq)) (lambda () (dk-conj-close!)))
                             (dk-have! (list 'AND (list 'IN mq 'RR) '(IN 1 RR)) (lambda () (dk-conj-close!)))
                             (fact 'rr-leq-antisymmetric mq 1)
                             (ass))
                            (#t
                             (let ((z (dk-di-var!)))
                               (csw-4-abs! z)
                               (dk-apply! const z)
                               (subst (list '= (list 'f z) (list '* (list csw-4-q z) z)))
                               (subst (list '= (list csw-4-q z) qu))
                               (rfl)))))))))))))
(qed 'schwarz-lemma)
(topic! 'schwarz-lemma 'analysis)

