;;; ch3a-schwarz.scm -- the maximum of |g| on a compact set, removable points, and Schwarz's lemma
;;; (Proposition 3.57 and Lemma 10.11 of the complex analysis notes) (CH3-A, 2026-10-26).
;;; Destination: theorem-library/ch3a-schwarz.scm, library complex-analysis.
;;; Helper prefix csw-.
;;; ======================================================================
(define (csw-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (csw-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (csw-mag! t) (csw-cc! t) (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))
(define csw-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (csw-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))

;;; ======================================================================
;;; (0) continuity on a subset of CC, read with moduli
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'g (list 'FORALL 'y (list 'IMPLIES '(IN y u)
    (list 'IMPLIES (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS csw-nf 'u) csw-nf 'g 'y)
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
        '(FORSOME del (AND (POS-RR del)
           (FORALL b (IMPLIES (IN b u) (IMPLIES (< (magnitude (- b y)) del)
             (<= (magnitude (- (g b) (g y))) eps))))))))))))))))
(dk-peel!)
(define csw-0-sub (list 'SUBSPACE-MS csw-nf 'u))
(csw-pts-cc!)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'u 'CC)
(fact 'nf-cc-is-metric-space)
(fact 'nf-cc-agree-pts)
(dk-have! (list 'SUBSET 'u (list 'PTS csw-nf)) (lambda () (subst (list '== (list 'PTS csw-nf) '(PTS CC-MS))) (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'subspace-is-metric-space csw-nf 'u)
(dk-cite! 'subspace-pts csw-nf 'u)
(let ((ci (dk-cite! 'is-continuous-at csw-0-sub csw-nf 'g 'y)))
  (dk-have! (caddr ci) (lambda () (prop)))
  (dk-split-all! (list (caddr ci))))
(define csw-0-cl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'delta))) "the continuity clause"))
(dk-rewrite-h! (list 'IN 'g (list 'FUN (list 'PTS csw-0-sub) (list 'PTS csw-nf))) (list 'PTS csw-0-sub) 'u)
(dk-rewrite-h! (list 'IN 'g (list 'FUN 'u (list 'PTS csw-nf))) (list 'PTS csw-nf) '(PTS CC-MS))
(dk-rewrite-h! (list 'IN 'g (list 'FUN 'u '(PTS CC-MS))) '(PTS CC-MS) 'CC)
(let* ((del (dk-skolem! (dk-apply! csw-0-cl 'eps)))
       (_ (dk-split-all!)))
  (fact 'rr-pos-rr-in-rr del)
  (fact 'rr-pos-rr-in-rr 'eps)
  (fact 'subset-mem-fwd 'u 'CC 'y)
  (fact 'fun-apply-type-c 'g 'u 'CC 'y)
  (ew del)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((landed (dk-peel!))
                 (b (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'u))) landed)))))
            (fact 'subset-mem-fwd 'u 'CC b)
            (fact 'fun-apply-type-c 'g 'u 'CC b)
            (dk-have! (list 'IN b (list 'PTS csw-0-sub)) (lambda () (subst (list '== (list 'PTS csw-0-sub) 'u)) (ass)))
            (let* ((dsub (list (list 'DIST csw-0-sub) 'y b))
                   (dnf (list (list 'DIST csw-nf) 'y b))
                   (dcc (list '(DIST CC-MS) 'y b))
                   (gy '(g y)) (gb (list 'g b))
                   (enf (list (list 'DIST csw-nf) gy gb))
                   (ecc (list '(DIST CC-MS) gy gb)))
              (dk-have! '(IN y (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
              (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
              (dk-have! (list 'IN gy '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
              (dk-have! (list 'IN gb '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
              (dk-cite! 'subspace-dist csw-nf 'u 'y b)
              (dk-cite! 'nf-cc-agree-dist 'y b)
              (dk-cite! 'cc-ms-dist 'y b)
              (dk-cite! 'nf-cc-agree-dist gy gb)
              (dk-cite! 'cc-ms-dist gy gb)
              (csw-mag! (list '- 'y b)) (csw-mag! (list '- b 'y))
              (csw-mag! (list '- gy gb)) (csw-mag! (list '- gb gy))
              (dk-cite! 'cc-magnitude-sub-sym 'y b)
              (dk-cite! 'cc-magnitude-sub-sym gy gb)
              (dk-have! (list '<= dsub del)
                (lambda ()
                  (subst (list '= dsub dnf)) (subst (list '= dnf dcc)) (subst (list '= dcc (list 'magnitude (list '- 'y b))))
                  (dk-ineq! (list '< (list 'magnitude (list '- b 'y)) del)
                            (list '= (list 'magnitude (list '- 'y b)) (list 'magnitude (list '- b 'y))))))
              (let ((cl2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm '(DIST (NF-METRIC-SPACE CC-NORMED-FIELD))))) "the delta clause")))
                (dk-apply! cl2 b))
              (dk-rewrite-h! (list '<= enf 'eps) enf ecc)
              (dk-rewrite-h! (list '<= ecc 'eps) ecc (list 'magnitude (list '- gy gb)))
              (dk-ineq! (list '<= (list 'magnitude (list '- gy gb)) 'eps)
                        (list '= (list 'magnitude (list '- gy gb)) (list 'magnitude (list '- gb gy))))))))))
(qed 'cc-continuous-at-modulus)
(topic! 'cc-continuous-at-modulus 'analysis)

;;; ======================================================================
;;; (1) EXTREME VALUE: |g| attains its maximum on a nonempty compact subset of CC
;;;     (the supremum of the image, a maximizing sequence, a cluster point of it)
;;; ======================================================================
(define csw-seq-family '())
(define (csw-choose-seq! A Pf witness-of)
  (let* ((lfam (list 'VNB-LAMBDA 'cswk_ 'NN (list 'SEP 'csww_ A (Pf 'cswk_ 'csww_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list lfam 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let* ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (for-each (lambda (lv)
                                (if (memq lv (dk-open-leaves))
                                    (begin (dk-focus! lv) (ass))))
                              (dk-opened (lambda () (sep-mi))))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A lfam))))
      (set! csw-seq-family (cons (cons g lfam) csw-seq-family))
      g)))
(define (csw-seq-at! g k)
  (let* ((lfam (cdr (assq g csw-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list lfam 'k))))))
         (h  (dk-apply! (or cl (error "csw-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
;; POS-RR(b - a) from a < b (both typed RR)
(define (csw-pos-diff! a b)
  (let* ((d (list '- b a)))
    (if (not (dk-asm? (list 'IN d 'RR))) (fact 'rr-sub-in-rr b a))
    (let ((pi (dk-cite! 'pos-rr d)))
      (dk-have! (caddr pi)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-asm? g) (ass))
                      ((dk-head-is? g '<=) (dk-ineq! (list '< a b)))
                      (#t (di) (dk-absurd! (list '= 0 d) (list '< a b)))))))))
      (dk-have! (list 'POS-RR d) (lambda () (prop))))
    d))
(define (csw-pos1!)
  (fact 'rr-one-in)
  (if (not (dk-asm? '(POS-RR 1)))
      (let ((pi (dk-cite! 'pos-rr 1)))
        (dk-have! (caddr pi)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        ((dk-head-is? g '<=) (dk-ineq!))
                        (#t (di) (dk-absurd! '(= 0 1)))))))))
        (dk-have! '(POS-RR 1) (lambda () (prop))))))
;; continuity of g at y (in u), tolerance eps: returns del, landing the clause
(define (csw-cont! y eps)
  (let ((del (dk-skolem! (dk-cite! 'cc-continuous-at-modulus 'u 'g y eps))))
    (dk-split-all!)
    (fact 'rr-pos-rr-in-rr del)
    del))
(define (csw-cont-clause del)
  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm 'magnitude))) "the continuity clause"))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN u CC))
    (list 'IMPLIES (list 'FORALL 'rgy_ (list 'IMPLIES '(IN rgy_ u) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS csw-nf 'u) csw-nf 'g 'rgy_)))
      '(FORALL kk (IMPLIES (SUBSET kk u) (IMPLIES (IS-COMPACT (SUBSPACE-MS CC-MS kk))
         (FORALL p0 (IMPLIES (IN p0 kk)
           (FORSOME p (AND (IN p kk) (FORALL z (IMPLIES (IN z kk) (<= (magnitude (g z)) (magnitude (g p)))))))))))))))))))
(dk-peel!)
(define csw-1-cont (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT))) "continuity"))
(fact 'cc-is-metric-space)
(csw-pts-cc!)
(fact 'subset-trans 'kk 'u 'CC)
(dk-have! '(SUBSET kk (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'nn-zero-in)
(csw-pos1!)
;; z in kk: z in u, z in CC, g(z) in CC, |g(z)| in RR
(define (csw-pt! z)
  (if (not (dk-asm? (list 'IN (list 'magnitude (list 'g z)) 'RR)))
      (begin
        (fact 'subset-mem-fwd 'kk 'u z)
        (fact 'subset-mem-fwd 'u 'CC z)
        (fact 'fun-apply-type-c 'g 'u 'CC z)
        (fact 'cc-magnitude-closed (list 'g z)))))
(define (csw-cont-at! y) (csw-pt! y) (dk-apply! csw-1-cont y))
;; the cluster point of a sequence sq in kk: returns it, landing the cluster clause
(define (csw-cluster! sq)
  (let ((x (dk-skolem! (dk-cite! 'lc5-compact-subset-cluster 'CC-MS 'kk sq))))
    (dk-split-all!)
    (let ((ci (dk-cite! 'cluster-point 'CC-MS sq x)))
      (dk-have! (caddr ci) (lambda () (dk-only! ci (list 'CLUSTER-POINT 'CC-MS sq x)) (prop)))
      (dk-split-all! (list (caddr ci))))
    (csw-pt! x)
    x))
(define (csw-cluster-clause sq)
  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(DIST CC-MS)) (dk-contains? fm sq))) "the cluster clause"))
;; d(sq(j), x) < del in context: land |sq(j) - x| < del, sq(j) typed
(define (csw-near! sq j x del)
  (let ((sj (list sq j)))
    (fact 'fun-apply-type-c sq 'NN 'kk j)
    (csw-pt! sj)
    (dk-cite! 'cc-ms-dist sj x)
    (dk-rewrite-h! (list '< (list '(DIST CC-MS) sj x) del) (list '(DIST CC-MS) sj x) (list 'magnitude (list '- sj x)))
    sj))

;; (A) |g| is bounded on kk
(define csw-bnd '(FORSOME bb (AND (IN bb RR) (FORALL z (IMPLIES (IN z kk) (<= (magnitude (g z)) bb))))))
(dk-have! csw-bnd (lambda () (use-em csw-bnd
  (lambda () (ass))
  (lambda ()
    (let* ((sq (csw-choose-seq! 'kk
                 (lambda (k w) (list '< k (list 'magnitude (list 'g w))))
                 (lambda (k)
                   (fact 'nn-in-rr k)
                   (let ((nf (list 'NOT (list 'FORALL 'cswz_ (list 'IMPLIES '(IN cswz_ kk) (list '<= '(magnitude (g cswz_)) k))))))
                     (dk-have! nf
                       (lambda ()
                         (di)
                         (dk-have! csw-bnd (lambda () (ew k) (dk-conj-close!)))
                         (ai (dk-ctx-form (list 'NOT csw-bnd)))))
                     (let* ((ex (car (dk-landed (lambda () (push-not-h nf)))))
                            (w (dk-skolem! ex)))
                       (dk-split-all!)
                       (csw-pt! w)
                       (dk-cite! 'rr-not-le-lt (list 'magnitude (list 'g w)) k)
                       w)))))
           (x (csw-cluster! sq))
           (gx (list 'magnitude (list 'g x)))
           (del (begin (csw-cont-at! x) (csw-cont! x 1)))
           (cl (csw-cont-clause del))
           (_ (fact 'rr-add-in-rr gx 1))
           (nn_ (dk-skolem! (dk-cite! 'nn-unbounded-in-rr (list '+ gx 1))))
           (_2 (dk-split-all!))
           (j (dk-skolem! (dk-apply! (csw-cluster-clause sq) del nn_)))
           (_3 (dk-split-all!))
           (sj (csw-near! sq j x del))
           (gsj (list 'g sj)))
      (dk-apply! cl sj)
      (csw-seq-at! sq j)
      (csw-mag! (list '- gsj (list 'g x)))
      (dk-cite! 'cc-magnitude-le-add gsj (list 'g x))
      (fact 'nn-in-rr nn_) (fact 'nn-in-rr j)
      (pbc)
      (dk-absurd! (list '< j (list 'magnitude gsj))
                  (list '<= (list 'magnitude gsj) (list '+ (list 'magnitude (list '- gsj (list 'g x))) gx))
                  (list '<= (list 'magnitude (list '- gsj (list 'g x))) 1)
                  (list '< (list '+ gx 1) nn_)
                  (list '<= nn_ j)))))))
(define csw-bb (dk-skolem! csw-bnd))
(dk-split-all!)
;; (B) the supremum M of the image
(define csw-img '(SEP cswv_ RR (FORSOME cswz_ (AND (IN cswz_ kk) (= cswv_ (magnitude (g cswz_)))))))
(define csw-M (list 'SUP csw-img))
;; z in kk: |g(z)| in IMG
(define (csw-in-img! z)
  (csw-pt! z)
  (dk-have! (list 'IN (list 'magnitude (list 'g z)) csw-img)
    (lambda ()
      (for-each (lambda (lv)
                  (if (memq lv (dk-open-leaves))
                      (begin (dk-focus! lv)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (ew z) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))
                (dk-opened (lambda () (sep-mi)))))))
(dk-have! (list 'SUBSET csw-img 'RR)
  (lambda () (let ((x (subset-by-element!))) (sep-me (list 'IN x csw-img)) (ass))))
(csw-in-img! 'p0)
(dk-have! (list 'FORSOME 'cswx_ (list 'IN 'cswx_ csw-img)) (lambda () (ew '(magnitude (g p0))) (ass)))
(let ((ui (dk-cite! 'rr-upper-bound csw-img csw-bb)))
  (dk-have! (caddr ui)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((x (dk-di-var!)))
                (sep-me (list 'IN x csw-img))
                (let ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the point"))))
                  (dk-split-all!)
                  (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm csw-bb))) "the bound") z)
                  (subst (list '= x (list 'magnitude (list 'g z))))
                  (ass))))))))
  (dk-have! (list 'RR-UPPER-BOUND csw-img csw-bb) (lambda () (prop))))
(let ((bi (dk-cite! 'rr-bounded-above csw-img)))
  (dk-have! (caddr bi) (lambda () (ew csw-bb) (ass)))
  (dk-have! (list 'RR-BOUNDED-ABOVE csw-img) (lambda () (prop))))
(dk-cite! 'rr-sup-in csw-img)
(dk-cite! 'rr-sup-upper csw-img)
(let ((ui (dk-cite! 'rr-upper-bound csw-img csw-M)))
  (dk-have! (caddr ui) (lambda () (prop)))
  (dk-split-all! (list (caddr ui))))
(define csw-ub (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUP) (dk-contains? fm 'cswv_))) "M bounds the image"))
;; z in kk: |g(z)| <= M
(define (csw-le-M! z)
  (csw-in-img! z)
  (dk-apply! csw-ub (list 'magnitude (list 'g z))))

;; (C) a maximizing sequence: M - 1/(k+1) < |g(t(k))|
(define csw-t
  (csw-choose-seq! 'kk
    (lambda (k w) (list '< (list '- csw-M (list 'recip (list '+ k 1))) (list 'magnitude (list 'g w))))
    (lambda (k)
      (let* ((r (list 'recip (list '+ k 1)))
             (a (list '- csw-M r))
             (ex (list 'FORSOME 'cswy_ (list 'AND '(IN cswy_ kk) (list '< a '(magnitude (g cswy_)))))))
        (dk-cite! 'nn-recip-succ-pos k) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
        (fact 'rr-sub-in-rr csw-M r)
        (dk-have! ex
          (lambda ()
            (use-em ex
              (lambda () (ass))
              (lambda ()
                ;; M - r bounds the image, so M <= M - r
                (let ((ui (dk-cite! 'rr-upper-bound csw-img a)))
                  (dk-have! (caddr ui)
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (ass)
                              (let ((x (dk-di-var!)))
                                (sep-me (list 'IN x csw-img))
                                (let ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the point"))))
                                  (dk-split-all!)
                                  (csw-pt! z)
                                  (subst (list '= x (list 'magnitude (list 'g z))))
                                  (use-em (list '<= (list 'magnitude (list 'g z)) a)
                                    (lambda () (ass))
                                    (lambda ()
                                      (dk-cite! 'rr-not-le-lt (list 'magnitude (list 'g z)) a)
                                      (dk-have! ex (lambda () (ew z) (dk-conj-close!)))
                                      (dk-only! ex (list 'NOT ex))
                                      (prop))))))))))
                  (dk-have! (list 'RR-UPPER-BOUND csw-img a) (lambda () (prop))))
                (dk-cite! 'rr-sup-least csw-img)
                (let ((lst (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'RR-UPPER-BOUND) (dk-contains? fm 'SUP))) "sup least")))
                  (dk-apply! lst a))
                (pbc)
                (dk-absurd! (list '<= csw-M a) (list '< 0 r))))))
        (let ((w (dk-skolem! ex)))
          (dk-split-all!)
          w)))))
;; (D) a cluster point p of t attains M
(define csw-p (csw-cluster! csw-t))
(define csw-gp (list 'magnitude (list 'g csw-p)))
(csw-le-M! csw-p)
(dk-have! (list '<= csw-M csw-gp)
  (lambda ()
    (use-em (list '<= csw-M csw-gp)
      (lambda () (ass))
      (lambda ()
        (dk-cite! 'rr-not-le-lt csw-M csw-gp)
        (let* ((d (csw-pos-diff! csw-gp csw-M))
               (h (dk-halve! d))
               (_0 (csw-cont-at! csw-p))
               (del (csw-cont! csw-p h))
               (cl (csw-cont-clause del))
               (n0 (dk-skolem! (dk-cite! 'nn-recip-succ-small h)))
               (_1 (dk-split-all!))
               (j (dk-skolem! (dk-apply! (csw-cluster-clause csw-t) del n0)))
               (_2 (dk-split-all!))
               (tj (csw-near! csw-t j csw-p del))
               (gtj (list 'g tj))
               (rj (list 'recip (list '+ j 1)))
               (r0 (list 'recip (list '+ n0 1))))
          (dk-apply! cl tj)
          (csw-seq-at! csw-t j)
          (dk-cite! 'nn-recip-succ-pos j) (fact 'rr-pos-rr-in-rr rj)
          (dk-cite! 'nn-recip-succ-pos n0) (fact 'rr-pos-rr-in-rr r0)
          (dk-cite! 'nn-recip-succ-antitone n0 j)
          (csw-mag! (list '- gtj (list 'g csw-p)))
          (dk-cite! 'cc-magnitude-le-add gtj (list 'g csw-p))
          (pbc)
          (dk-absurd! (list '< (list '- csw-M rj) (list 'magnitude gtj))
                      (list '<= (list 'magnitude gtj) (list '+ (list 'magnitude (list '- gtj (list 'g csw-p))) csw-gp))
                      (list '<= (list 'magnitude (list '- gtj (list 'g csw-p))) h)
                      (list '= (list '+ h h) d)
                      (list '<= rj r0)
                      (list '< r0 h)))))))
(ew csw-p)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (let ((z (dk-di-var!)))
          (csw-le-M! z)
          (dk-ineq! (list '<= (list 'magnitude (list 'g z)) csw-M) (list '<= csw-M csw-gp))))))
(qed 'cc-compact-modulus-max)
(topic! 'cc-compact-modulus-max 'analysis)

;;; ======================================================================
;;; (2) a removable point: continuous on u and holomorphic off one point ==> holomorphic
;;;     (Morera, with goursat-triangle-except giving the triangle integrals)
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN csw-nf 'u)
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN u CC))
    (list 'IMPLIES (list 'FORALL 'rgy_ (list 'IMPLIES '(IN rgy_ u) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS csw-nf 'u) csw-nf 'g 'rgy_)))
      '(FORALL x0 (IMPLIES (IN x0 u)
         (IMPLIES (HOLOMORPHIC-ON (DIFFERENCE u (SINGLETON x0)) (RESTRICT g (DIFFERENCE u (SINGLETON x0))))
           (HOLOMORPHIC-ON u g)))))))))))
(dk-peel!)
(dk-cite! 'goursat-triangle-except 'u 'g 'x0)
(let ((ch (dk-cite! 'morera 'u 'g)))
  (dk-chain! ch (lambda (ante) (lambda () (ass))))
  (ass))
