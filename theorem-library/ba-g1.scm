;;; ==== h-closure.scm ====
;;; ---- PART H: J and the orthogonal complement; Proposition 3.4 (1), the closure is G** ----------
(set! ubg-v 'v)
(define ubg-H '(HSUM v v))
(define (ubg-perp s) (list 'PERP ubg-H s))
(define (ubg-j s) (list 'GRAPH-J 'v s))
(define (ubg-ext-goal l r)
  (list 'FORALL 'uga_ (list 'IMPLIES '(IN uga_ (VEC v)) (list 'FORALL 'ugb_ (list 'IMPLIES '(IN ugb_ (VEC v))
    (list 'IFF (list 'IN '(LIST uga_ ugb_) l) (list 'IN '(LIST uga_ ugb_) r)))))))
;;; the pointwise IFF of relation-pair-ext, proved by BODY! (called with a, b), then the equation
(define (ubg-by-ext! l r body!)
  (dk-have! (ubg-ext-goal l r)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (pr (cadr (cadr g))) (a (cadr pr)) (b (caddr pr)))
        (ubg-set! a '(VEC v)) (ubg-set! b '(VEC v))
        (body! a b))))
  (dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) l r)
  (ubg-done-ass!))
(define (ubg-close-by-ident! lhs z)       ; goal (= LHS 0), Z = 0 in context, LHS = Z by expansion
  (ubg-ident! lhs z)
  (subst (list '= lhs z))
  (dk-close-if! (lambda () (subst (list '= z 0))) (lambda () (rfl))))

;;; J(S-perp) = (J S)-perp
(sp (make-wff (forall-guarded '(v ss) (append ubg-CV (list (list 'SUBSET 'ss ubg-HH)))
   (list '= (ubg-j (ubg-perp 'ss)) (ubg-perp (ubg-j 'ss))))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'hsum-is-set 'v 'v)
(ubg-hsum-vec-eq!)
(dk-cite! 'hsum-perp-subset 'v 'ss)
(dk-cite! 'hsum-perp-is-set 'v 'ss)
(dk-cite! 'graph-j-subset 'v 'ss)
(dk-cite! 'graph-j-is-set 'v 'ss)
(dk-cite! 'graph-j-subset 'v (ubg-perp 'ss))
(dk-cite! 'hsum-perp-subset 'v (ubg-j 'ss))
(ubg-by-ext! (ubg-j (ubg-perp 'ss)) (ubg-perp (ubg-j 'ss))
  (lambda (a b)
    (let* ((na (ubg-neg a)))
      (ubg-vt! na) (ubg-set! na '(VEC v))
      (let* ((i1 (dk-cite! 'graph-j-pair-iff 'v (ubg-perp 'ss) a b))
             (i2 (dk-cite! 'hsum-perp-pair-iff 'v 'ss b na))
             (i3 (dk-cite! 'hsum-perp-pair-iff 'v (ubg-j 'ss) a b)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) (ubg-perp (ubg-j 'ss))))
          (lambda ()
            (ubg-iff->! i1)
            (let ((af (ubg-iff->! i2)))
              (dk-have! (caddr i3)
                (lambda ()
                  (let* ((cd (ubg-peel-new! (ubg-j 'ss))) (c (car cd)) (d (cadr cd)) (nc (ubg-neg c)))
                    (ubg-vt! nc) (ubg-set! nc '(VEC v))
                    (ubg-iff->! (dk-cite! 'graph-j-pair-iff 'v 'ss c d))
                    (dk-apply! (dk-ctx-form af) d nc)
                    (ubg-close-by-ident! (list '+ (ubg-ip a c) (ubg-ip b d))
                                         (list '+ (ubg-ip b d) (ubg-ip na nc))))))
              (ubg-iff<-! i3)
              (ubg-done-ass!)))
          (lambda ()
            (let ((bf (ubg-iff->! i3)))
              (dk-have! (caddr i2)
                (lambda ()
                  (let* ((cd (ubg-peel-new! 'ss)) (c (car cd)) (d (cadr cd))
                         (nd (ubg-neg d)) (nnd (ubg-neg nd)))
                    (ubg-vt! nnd) (ubg-set! nd '(VEC v)) (ubg-set! nnd '(VEC v))
                    (ubg-vec-eq! nnd d)
                    (dk-have! (list 'IN (ubg-pr c nnd) 'ss) (lambda () (subst (list '= nnd d)) (ass)))
                    (ubg-iff<-! (dk-cite! 'graph-j-pair-iff 'v 'ss nd c))
                    (dk-apply! (dk-ctx-form bf) nd c)
                    (ubg-close-by-ident! (list '+ (ubg-ip b c) (ubg-ip na d))
                                         (list '+ (ubg-ip a nd) (ubg-ip b c))))))
              (ubg-iff<-! i2)
              (ubg-iff<-! i1)
              (ubg-done-ass!)))))))
  )
(ubg-qed! 'graph-j-of-perp)

;;; J(J G) = G for G linear
(sp (make-wff (forall-guarded '(v gg) (append ubg-CV '((IS-LINEAR-GRAPH v gg)))
   (list '= (ubg-j (ubg-j 'gg)) 'gg))))
(dk-peel!)
(ubg-lin-facts-of! 'gg)
(dk-cite! 'graph-j-subset 'v 'gg)
(dk-cite! 'graph-j-is-set 'v 'gg)
(dk-cite! 'graph-j-subset 'v (ubg-j 'gg))
(ubg-by-ext! (ubg-j (ubg-j 'gg)) 'gg
  (lambda (a b)
    (let* ((na (ubg-neg a)) (nb (ubg-neg b)) (nna (ubg-neg na)) (nnb (ubg-neg nb)))
      (for-each (lambda (x) (ubg-vt! x) (ubg-set! x '(VEC v))) (list na nb nna nnb))
      (let* ((i1 (dk-cite! 'graph-j-pair-iff 'v (ubg-j 'gg) a b))
             (i2 (dk-cite! 'graph-j-pair-iff 'v 'gg b na)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) 'gg))
          (lambda ()
            (ubg-iff->! i1) (ubg-iff->! i2)              ; [-a, -b] in G
            (let* ((r (dk-cite! 'submodule-vneg-closed ubg-H 'gg (ubg-pr na nb)))
                   (eq (dk-cite! 'hsum-vneg-pair 'v 'v na nb)))
              (dk-rewrite-h! r (cadr eq) (caddr eq)))
            (ubg-vec-eq! nna a) (ubg-vec-eq! nnb b)
            (dk-have! (list 'IN (ubg-pr a b) 'gg)
              (lambda () (subst (list '= a nna)) (subst (list '= b nnb)) (ass)))
            (ubg-done-ass!))
          (lambda ()
            (let* ((r (dk-cite! 'submodule-vneg-closed ubg-H 'gg (ubg-pr a b)))
                   (eq (dk-cite! 'hsum-vneg-pair 'v 'v a b)))
              (dk-rewrite-h! r (cadr eq) (caddr eq)))
            (ubg-iff<-! i2) (ubg-iff<-! i1)
            (ubg-done-ass!)))))))
(ubg-qed! 'graph-j-j-linear)

