;;; Library: operator-algebras.

;;; ba-g1.scm -- BA-G1 (2026-11-09): graphs in H (+) H, the adjoint, J, the Cayley transform.
;;; Banach Algebras and Applications, ch. 3: Prop 3.3, 3.4 (1), 3.9, 3.11, 3.12 (<=), and PERP-PERP = closure.
;;; Concatenation of ubg-helpers.scm and parts a-hsum .. h-closure (the working copies). Helper prefix ubg-.

;;; ==== ubg-helpers.scm ====
;;; ubg helpers: copies of ba-bh.scm's bbh- helpers (themselves copies of hilbert-projection.scm's hpr- kit), prefix ubg-.
(define ubg-v 'v)
(define (ubg-ip a b) (list (list 'IP ubg-v) a b))
(define (ubg-sub a b) (list (list 'VADD ubg-v) a (list (list 'VNEG ubg-v) b)))
(define (ubg-add a b) (list (list 'VADD ubg-v) a b))
(define (ubg-act c a) (list (list 'ACT ubg-v) c a))
(define (ubg-q a) (ubg-ip a a))

(define (ubg-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) ubg-v)))
(define (ubg-zero? e) (equal? e (list 'VZERO ubg-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (ubg-vt! e)
  (let ((goal (list 'IN e (list 'VEC ubg-v))))
    (cond ((and (dk-asm? goal) (not (or (ubg-op? e 'VADD) (ubg-op? e 'VNEG) (ubg-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((ubg-op? e 'VADD) (ubg-vt! (cadr e)) (ubg-vt! (caddr e)))
                 ((ubg-op? e 'VNEG) (ubg-vt! (cadr e)))
                 ((ubg-op? e 'ACT)  (ubg-ct! (cadr e)) (ubg-vt! (caddr e))))
           goal)
          ((ubg-op? e 'VADD) (ubg-vt! (cadr e)) (ubg-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type ubg-v (cadr e) (caddr e)) goal)
          ((ubg-op? e 'VNEG) (ubg-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type ubg-v (cadr e)) goal)
          ((ubg-op? e 'ACT)  (ubg-ct! (cadr e)) (ubg-vt! (caddr e))
                             (dk-cite! 'cips-act-type ubg-v (cadr e) (caddr e)) goal)
          ((ubg-zero? e) (dk-cite! 'cips-vzero-in ubg-v) goal)
          ((ubg-app-fun e) => (lambda (ft) (ubg-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "ubg-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (ubg-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC ubg-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (ubg-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC ubg-v)) (ubg-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((ubg-v (cadr d))) (ubg-vt! a)))
        (#t (error "ubg-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (ubg-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((ubg-op? c 'IP) (ubg-vt! (cadr c)) (ubg-vt! (caddr c))
                           (dk-cite! 'cips-ip-type ubg-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (pair? (car c)) (eq? (car (car c)) 'IP) (= (length c) 3))   ; another space
           (fluid-let ((ubg-v (cadr (car c)))) (ubg-ct! c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (ubg-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (ubg-ct! (cadr c)) (ubg-ct! (caddr c))
           (ubg-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (ubg-ct! (cadr c)) (ubg-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (ubg-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (ubg-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (ubg-op? e 'IP) (= (length e) 3)
              (or (ubg-compound? (cadr e)) (ubg-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((ubg-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (ubg-compound? e)
  (or (ubg-op? e 'VADD) (ubg-op? e 'VNEG) (ubg-op? e 'ACT) (ubg-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (ubg-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (ubg-vt! a) (ubg-vt! b)
    (cond ((ubg-op? a 'VADD) (dk-cite! 'cips-ip-add-left ubg-v (cadr a) (caddr a) b))
          ((ubg-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left ubg-v (cadr a) b))
          ((ubg-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left ubg-v (cadr a) (caddr a) b))
          ((ubg-zero? a)     (dk-cite! 'cips-ip-zero-left ubg-v b))
          ((ubg-op? b 'VADD) (dk-cite! 'cips-ip-add-right ubg-v a (cadr b) (caddr b)))
          ((ubg-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right ubg-v a (cadr b)))
          ((ubg-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right ubg-v (cadr b) a (caddr b)))
          ((ubg-zero? b)     (dk-cite! 'cips-ip-zero-right ubg-v a))
          (#t (error "ubg-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (ubg-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (ubg-op? x 'IP) (= (length x) 3))))))
(define (ubg-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((ubg-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((ubg-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (ubg-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "ubg-expand!: out of fuel"))
    (let ((r (ubg-find-redex (dk-goal))))
      (if r
          (let ((eq (ubg-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (ubg-find-real-conj (dk-goal))))
            (if c
                (begin
                  (ubg-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (ubg-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((ubg-op? x 'IP)
           (ubg-vt! (cadr x)) (ubg-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym ubg-v (cadr x) (caddr x))
           (subst (list '= c (ubg-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (ubg-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (ubg-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (ubg-ct! (cadr x)) (ubg-ct! (caddr x))
           (ubg-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (ubg-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (ubg-q-facts! u)
  (ubg-vt! u)
  (dk-cite! 'cips-ip-self-real ubg-v u)
  (dk-cite! 'cips-ip-self-nonneg ubg-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (ubg-norm-sq! u)
  (ubg-vt! u)
  (subst (dk-cite! 'ip-norm-unfold ubg-v u))
  (ubg-q-facts! u)
  (ubg-sqrt! (ubg-q u))
  (subst (dk-cite! 'sqrt-sq (ubg-q u))))
(define (ubg-nsq u) (list '* (list 'IP-NORM ubg-v u) (list 'IP-NORM ubg-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (ubg-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (ubg-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (ubg-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (ubg-and (cdr fs)))))
(define (ubg-have-and! . fs)
  (let ((c (ubg-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (ubg-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((ubg-op? e 'IP) (ubg-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (ubg-ct! e))
        (#t (for-each ubg-type-ips! e))))

(define (ubg-qd p xi) (ubg-q (ubg-sub p xi)))
(define (ubg-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (ubg-vt! a) (ubg-vt! b)
          (dk-have! (list '= (ubg-qd a b) 0)
            (lambda () (ubg-expand!) (ubg-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero ubg-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (ubg-q-eq! a b)
  (let ((goal (list '= (ubg-q a) (ubg-q b))))
    (if (not (dk-asm? goal))
        (begin (ubg-vt! a) (ubg-vt! b)
               (dk-have! goal (lambda () (ubg-expand!) (ubg-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (ubg-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** BBH: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "BBH: unfinished" name))))
;;; dump the focus leaf (debugging)
(define (ubg-show! tag)
  (display "\n--- BBH ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (ubg-sub! ks x)
  (dk-cite! 'submodule-subset ubg-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC ubg-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (ubg-scal! c)
  (dk-cite! 'cips-scal-carrier ubg-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL ubg-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL ubg-v)) 'CC)) (ass))))

;;; ==== a-hsum.scm ====
;;; ---- PART A: the Hilbert direct sum H (+) K at literal pairs ---------------------------------
;;; The accessors of the 7-tuple HSUM(v, w) read off, and the four operations and the inner
;;; product at literal pairs [a, b].

(define ubg-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w)))
(define ubg-HS '(HSUM v w))

;;; NTH of a literal list everywhere in the goal, its entries first landed as sets
(define (ubg-set-atoms! e)
  ;; every (IN x (VEC u)) in context whose x occurs in e: land (IN x SET)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (pair? (caddr h)) (dk-contains? e (cadr h))
                       (not (eq? (caddr h) 'SET)) (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (ubg-nth!)
  (let loop ((k 0))
    (if (and (< k 40) (not (proof-done? *ps*)) (dk-contains? (dk-goal) 'NTH)
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (ubg-set-atoms! (dk-goal)) (nth-r) (loop (+ k 1))))))

(define (ubg-hsum-sets!)
  (dk-cite! 'cips-vec-set 'v) (dk-cite! 'cips-vec-set 'w)
  (dk-cite! 'cips-vzero-in 'v) (dk-cite! 'cips-vzero-in 'w))

;;; the read-offs
(define (ubg-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v w) ubg-C2 (list '== (list acc ubg-HS) val))))
  (dk-peel!)
  (ubg-hsum-sets!)
  (slot acc)
  (mac 'HSUM)
  (nth-r)
  ;; the same accessor in the value (VEC v, VZERO v): read it off there too, to a fixpoint
  (let loop ((k 0))
    (if (and (< k 4) (not (proof-done? *ps*)) (dk-contains? (dk-goal) acc))
        (begin (slot acc) (ubg-nth!) (loop (+ k 1)))))
  (if (not (proof-done? *ps*)) (qrfl))
  (ubg-qed! name))

(ubg-read-off! 'hsum-scal-acc 'SCAL '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(ubg-read-off! 'hsum-vec-acc 'VEC '(CARTESIAN (VEC v) (VEC w)))
(ubg-read-off! 'hsum-vadd-acc 'VADD '(HSUM-VADD v w))
(ubg-read-off! 'hsum-vzero-acc 'VZERO '(LIST (VZERO v) (VZERO w)))
(ubg-read-off! 'hsum-vneg-acc 'VNEG '(HSUM-VNEG v w))
(ubg-read-off! 'hsum-act-acc 'ACT '(HSUM-ACT v w))
(ubg-read-off! 'hsum-ip-acc 'IP '(HSUM-IP v w))

;;; the values at literal pairs
;;; type a value term: a vector of v or w (by its head's space), a list of such, or a scalar
(define (ubg-rhs-type! e)
  (cond ((and (pair? e) (eq? (car e) 'LIST)) (for-each ubg-rhs-type! (cdr e)))
        ((and (pair? e) (pair? (car e)) (memq (car (car e)) '(VADD VNEG ACT)))
         (fluid-let ((ubg-v (cadr (car e)))) (ubg-vt! e)))
        (#t (ubg-ct! e))))
(define ubg-pair-guards '((IN a_ (VEC v)) (IN b_ (VEC w)) (IN c_ (VEC v)) (IN d_ (VEC w))))
(define (ubg-pair-value! name vars guards lhs rhs acc fun)
  (sp (make-wff (forall-guarded (append '(v w) vars) (append ubg-C2 guards) (list '= lhs rhs))))
  (dk-peel!)
  (ubg-hsum-sets!)
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) 'a_ 'b_)
  (if (memq 'c_ vars) (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) 'c_ 'd_))
  (subst (dk-cite! acc 'v 'w))
  (mac fun)
  (dk-lam-b!)
  (ubg-nth!)
  (if (not (proof-done? *ps*))
      (begin
        (ubg-rhs-type! rhs)
        (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))
                                  (dk-cite! 'membership-implies-sethood (cadr h) '(VEC v))))
                  (dk-asms))
        (rfl)))
  (ubg-qed! name))

(define (ubg-vadd u a b) (list (list 'VADD u) a b))
(define (ubg-vneg u a) (list (list 'VNEG u) a))
(define (ubg-vact u c a) (list (list 'ACT u) c a))
(define (ubg-ipu u a b) (list (list 'IP u) a b))

(ubg-pair-value! 'hsum-ip-pair '(a_ b_ c_ d_) ubg-pair-guards
  '((IP (HSUM v w)) (LIST a_ b_) (LIST c_ d_))
  (list '+ (ubg-ipu 'v 'a_ 'c_) (ubg-ipu 'w 'b_ 'd_)) 'hsum-ip-acc 'HSUM-IP)

(ubg-pair-value! 'hsum-vadd-pair '(a_ b_ c_ d_) ubg-pair-guards
  '((VADD (HSUM v w)) (LIST a_ b_) (LIST c_ d_))
  (list 'LIST (ubg-vadd 'v 'a_ 'c_) (ubg-vadd 'w 'b_ 'd_)) 'hsum-vadd-acc 'HSUM-VADD)
(ubg-pair-value! 'hsum-vneg-pair '(a_ b_) (list-head ubg-pair-guards 2)
  '((VNEG (HSUM v w)) (LIST a_ b_))
  (list 'LIST (ubg-vneg 'v 'a_) (ubg-vneg 'w 'b_)) 'hsum-vneg-acc 'HSUM-VNEG)
(ubg-pair-value! 'hsum-act-pair '(k_ a_ b_) (cons '(IN k_ CC) (list-head ubg-pair-guards 2))
  '((ACT (HSUM v w)) k_ (LIST a_ b_))
  (list 'LIST (ubg-vact 'v 'k_ 'a_) (ubg-vact 'w 'k_ 'b_)) 'hsum-act-acc 'HSUM-ACT)

;;; the operations are functions
(define ubg-HV '(CARTESIAN (VEC v) (VEC w)))
(define (ubg-split-carts!)                ; NTH typings of every pair variable in context
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (dk-head-is? (caddr h) 'CARTESIAN)
                       (= (length (caddr h)) 3)
                       (not (dk-asm? (list 'IN (list 'NTH 1 (cadr h)) (cadr (caddr h))))))
                  (dk-split! (dk-cite! 'cartesian-nth (cadr h) (cadr (caddr h)) (caddr (caddr h))))))
            (dk-asms)))
(define (ubg-type! t c)
  (cond ((dk-asm? (list 'IN t c)) #t)
        ((and (dk-head-is? t 'LIST) (dk-head-is? c 'CARTESIAN))
         (ubg-type! (cadr t) (cadr c)) (ubg-type! (caddr t) (caddr c))
         (dk-cite! 'pair-in-cartesian (cadr c) (caddr c) (cadr t) (caddr t)))
        ((eq? c 'CC) (ubg-ct! t))
        ((dk-head-is? c 'VEC) (fluid-let ((ubg-v (cadr c))) (ubg-vt! t)))
        (#t (error "ubg-type!: no route" (expression->string (list 'IN t c))))))
(define (ubg-op-type! name op cod)
  (sp (make-wff (forall-guarded '(v w) ubg-C2 (list 'IN (list op 'v 'w) cod))))
  (dk-peel!)
  (ubg-hsum-sets!)
  (dk-cite! 'cc-is-set)
  (dk-have! (list 'IN ubg-HV 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (mac op)
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (ubg-split-carts!)
      (let ((g (dk-goal))) (ubg-type! (cadr g) (caddr g)) (ass)))
    (lambda () (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                   (ass))))
  (ubg-qed! name))
(ubg-op-type! 'hsum-vadd-type 'HSUM-VADD (list 'FUN (list 'CARTESIAN ubg-HV ubg-HV) ubg-HV))
(ubg-op-type! 'hsum-vneg-type 'HSUM-VNEG (list 'FUN ubg-HV ubg-HV))
(ubg-op-type! 'hsum-act-type 'HSUM-ACT (list 'FUN (list 'CARTESIAN 'CC ubg-HV) ubg-HV))
(ubg-op-type! 'hsum-ip-type 'HSUM-IP (list 'FUN (list 'CARTESIAN ubg-HV ubg-HV) 'CC))

;;; H (+) K is a set (so that terms built on it are certified defined)
(sp (make-wff (forall-guarded '(v w) ubg-C2 '(IN (HSUM v w) SET))))
(dk-peel!)
(ubg-hsum-sets!)
(dk-cite! 'cc-is-normed-field)
(dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(for-each (lambda (n) (dk-cite! n 'v 'w)) '(hsum-vadd-type hsum-vneg-type hsum-act-type hsum-ip-type))
(dk-list-in-set!)
(ubg-qed! 'hsum-is-set)

;;; ==== b-graphs.scm ====
;;; ---- PART B: graphs at literal pairs: extensionality, the membership laws ----------------------
(define ubg-CV '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define ubg-HH '(CARTESIAN (VEC v) (VEC v)))
(define (ubg-pr a b) (list 'LIST a b))

;;; every typed atom in context (IN x C), C not SET: land (IN x SET)
(define (ubg-sets!)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (not (eq? (caddr h) 'SET))
                       (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (ubg-set! x c)
  (if (not (dk-asm? (list 'IN x 'SET))) (dk-cite! 'membership-implies-sethood x c)))

;;; q in CARTESIAN(X, Y) in context: land NTH 1 q in X, NTH 2 q in Y, q = [NTH 1 q, NTH 2 q]
;;; (and the sethood of both); return the two components
(define (ubg-pair-of! q xs ys)
  (let ((n1 (list 'NTH 1 q)) (n2 (list 'NTH 2 q)))
    (dk-split! (dk-cite! 'cartesian-nth q xs ys))
    (dk-cite! 'cartesian-pair-eq q xs ys)
    (ubg-set! n1 xs) (ubg-set! n2 ys)
    (list n1 n2)))
;;; q in S and q = [n1, n2] in context: land [n1, n2] in S
(define (ubg-pair-mem! q s n1 n2)
  (let ((g (list 'IN (ubg-pr n1 n2) s)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (ubg-pr n1 n2) q)) (ass))))
    g))

;;; reduce every NTH of a literal list in the goal (entries landed as sets first)
(define (ubg-nth-goal!)
  (ubg-sets!)
  (let loop ((k 0))
    (if (and (< k 40) (not (proof-done? *ps*))
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (nth-r) (loop (+ k 1))))))
;;; reduce the NTHs of literal lists inside the hypotheses LANDED
(define (ubg-nth-hs! landed)
  (ubg-sets!)
  (map (lambda (h) (if (dk-asm? h) (dk-nth-h! h) h)) landed))

;;; ---- extensionality for relations, at pairs --------------------------------------------------
(sp (make-wff (forall-guarded '(xs ys aa bb)
   '((SUBSET aa (CARTESIAN xs ys)) (SUBSET bb (CARTESIAN xs ys))
     (FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IFF (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
   '(= aa bb))))
(dk-peel!)
(define ubg-ext-h '(FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IFF (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
(dk-have! '(FORALL ugp_ (IFF (IN ugp_ aa) (IN ugp_ bb)))
  (lambda ()
    (dk-peel!)
    (let ((p (cadr (cadr (dk-goal)))))
      (define (side! from to sub)
        (dk-cite! 'subset-mem-fwd from '(CARTESIAN xs ys) p)
        (let* ((ns (ubg-pair-of! p 'xs 'ys)) (n1 (car ns)) (n2 (cadr ns)))
          (ubg-pair-mem! p from n1 n2)
          (let ((iff (dk-apply! (dk-ctx-form ubg-ext-h) n1 n2)))
            (ai iff)
            (if sub
                (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                (detach! (list 'IMPLIES (caddr iff) (cadr iff))))
            (subst (list '= p (ubg-pr n1 n2)))
            (ass))))
      (dk-iff! (lambda (g) (equal? (caddr g) 'bb))
        (lambda () (side! 'aa 'bb #t))
        (lambda () (side! 'bb 'aa #f))))))
(dk-cite! 'class-extensionality 'aa 'bb)
(ass)
(ubg-qed! 'relation-pair-ext)

(sp (make-wff (forall-guarded '(xs ys aa bb)
   '((SUBSET aa (CARTESIAN xs ys))
     (FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IMPLIES (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
   '(SUBSET aa bb))))
(dk-peel!)
(define ubg-sub-h '(FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IMPLIES (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
(mac 'subset-def)
(dk-peel!)
(let* ((p (cadr (dk-goal))))
  (dk-cite! 'subset-mem-fwd 'aa '(CARTESIAN xs ys) p)
  (let* ((ns (ubg-pair-of! p 'xs 'ys)) (n1 (car ns)) (n2 (cadr ns)))
    (ubg-pair-mem! p 'aa n1 n2)
    (dk-apply! (dk-ctx-form ubg-sub-h) n1 n2)
    (subst (list '= p (ubg-pr n1 n2)))
    (ass)))
(ubg-qed! 'relation-pair-subset)

;;; close the reflexivity side leaves a definitional unfold may post (C = C)
(define (ubg-refl-leaves!)
  (let ((home (proof-state-focus *ps*)))
    (for-each (lambda (l)
                (let ((g (dk-goal-of l)))
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
                      (begin (dk-focus! l) (rfl)))))
              (dk-open-leaves))
    (if (not (sequent-node-grounded? home)) (dk-focus! home))))
;;; ---- the graph constructions are relations on H -----------------------------------------------
(define (ubg-sep-subset! name fun)
  (sp (make-wff (forall-guarded '(v gg) ubg-CV (list 'SUBSET (list fun 'v 'gg) ubg-HH))))
  (dk-peel!)
  (dk-cite! 'cips-vec-set 'v)
  (mac fun)
  (mac 'subset-def)
  (ubg-refl-leaves!)
  (dk-peel!)
  (let ((h (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))))
    (sep-me h)
    (dk-split-all!)
    (ass))
  (ubg-qed! name))
(ubg-sep-subset! 'graph-adjoint-subset 'GRAPH-ADJOINT)
(ubg-sep-subset! 'graph-j-subset 'GRAPH-J)
(ubg-sep-subset! 'graph-inverse-subset 'GRAPH-INVERSE)
(ubg-sep-subset! 'cayley-graph-subset 'CAYLEY-GRAPH)

;;; PERP in H (+) H is a relation on H
(sp (make-wff (forall-guarded '(v ss) ubg-CV (list 'SUBSET '(PERP (HSUM v v) ss) ubg-HH))))
(dk-peel!)
(subst (dk-cite! 'perp-unfold '(HSUM v v) 'ss))
(subst (dk-cite! 'hsum-vec-acc 'v 'v))
(dk-cite! 'cips-vec-set 'v)
(mac 'subset-def)
(ubg-refl-leaves!)
(dk-peel!)
(let ((h (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))))
  (sep-me h)
  (dk-split-all!)
  (ass))
(ubg-qed! 'hsum-perp-subset)

;;; VEC(H (+) H) = H x H as a strict equation in context: it certifies VEC(HSUM v v), and with
;;; it PERP(HSUM v v, S), defined
(define (ubg-hsum-vec-eq!)
  (let ((g (list '= '(VEC (HSUM v v)) ubg-HH)))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'cips-vec-set 'v)
               (dk-have! g (lambda () (subst (dk-cite! 'hsum-vec-acc 'v 'v)) (rfl)))))
    g))
;;; ---- ... and SETS (so that an instantiation at them is certified defined) ----
(define (ubg-cart-set!)
  (dk-cite! 'cips-vec-set 'v)
  (dk-have! (list 'IN ubg-HH 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))
(define (ubg-is-set! name term sub-thm args)
  (sp (make-wff (forall-guarded (append '(v) args) ubg-CV (list 'IN term 'SET))))
  (dk-peel!)
  (ubg-cart-set!)
  (dk-cite! 'hsum-is-set 'v 'v)
  (ubg-hsum-vec-eq!)
  (apply dk-cite! sub-thm 'v args)
  (dk-cite! 'subclass-of-set-is-set term ubg-HH)
  (ass)
  (ubg-qed! name))
(ubg-is-set! 'graph-adjoint-is-set '(GRAPH-ADJOINT v gg) 'graph-adjoint-subset '(gg))
(ubg-is-set! 'graph-j-is-set '(GRAPH-J v gg) 'graph-j-subset '(gg))
(ubg-is-set! 'graph-inverse-is-set '(GRAPH-INVERSE v gg) 'graph-inverse-subset '(gg))
(ubg-is-set! 'cayley-graph-is-set '(CAYLEY-GRAPH v gg) 'cayley-graph-subset '(gg))
(ubg-is-set! 'hsum-perp-is-set '(PERP (HSUM v v) ss) 'hsum-perp-subset '(ss))

;;; ---- membership at a literal pair ------------------------------------------------------------
;;; (ubg-mem-iff! NAME VARS GUARDS ELT SETTERM UNFOLD RHS FWD-BODY! BWD-BODY!)
;;; ELT = [a_, b_]; UNFOLD is the functoid (or a thunk that unfolds the set in the goal).
;;; FWD-BODY! runs with the SEP condition at ELT (NTHs reduced) in context, goal RHS;
;;; BWD-BODY! runs with RHS in context, goal the SEP condition at ELT (NTHs reduced).
(define (ubg-mem-iff! name vars guards elt setterm unfold rhs fwd! bwd!)
  (sp (make-wff (forall-guarded vars guards (list 'IFF (list 'IN elt setterm) rhs))))
  (dk-peel!)
  (ubg-sets!)
  (if (procedure? unfold) (unfold) (mac unfold))
  (let* ((g (dk-goal)) (mem (cadr g)))
    (dk-iff! (lambda (gl) (alpha-equiv? gl rhs))
      (lambda ()
        (let* ((ls (dk-landed (lambda () (sep-me mem))))
               (ls2 (ubg-nth-hs! (filter (lambda (h) (not (and (dk-head-is? h 'IN) (equal? (cadr h) elt)))) ls))))
          (fwd! (car ls2))))
      (lambda ()
        (in-sep! (lambda () (ass)) (lambda () (ubg-nth-goal!) (if (not (proof-done? *ps*)) (bwd!)))))))
  (ubg-qed! name))
(define ubg-ab '((IN a_ (VEC v)) (IN b_ (VEC v))))
(define (ubg-cart-ab!) (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) 'a_ 'b_))

;;; J G: [a, b] in J(G) iff [b, -a] in G
(ubg-mem-iff! 'graph-j-pair-iff '(v gg a_ b_) (append ubg-CV ubg-ab) '(LIST a_ b_) '(GRAPH-J v gg)
  (lambda () (ubg-cart-ab!) (mac 'GRAPH-J))
  '(IN (LIST b_ ((VNEG v) a_)) gg)
  (lambda (h) (ass)) (lambda () (ass)))

;;; G^-1: [a, b] in G^-1 iff [b, a] in G
(ubg-mem-iff! 'graph-inverse-pair-iff '(v gg a_ b_) (append ubg-CV ubg-ab) '(LIST a_ b_) '(GRAPH-INVERSE v gg)
  (lambda () (ubg-cart-ab!) (mac 'GRAPH-INVERSE))
  '(IN (LIST b_ a_) gg)
  (lambda (h) (ass)) (lambda () (ass)))

;;; a universal over the graph S, from the q-form (forall q in S. P(NTH 1 q, NTH 2 q)) in
;;; context H, to the pair-form goal (forall c, d in VEC v. [c, d] in S => P(c, d))
(define (ubg-q-to-pair! h s)
  (dk-peel!)
  (ubg-sets!)
  (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST) (equal? (caddr f) s))) (dk-asms))))
         (pr (cadr mem)))
    (ubg-set! (cadr pr) '(VEC v)) (ubg-set! (caddr pr) '(VEC v))
    (let ((r (dk-apply! (dk-ctx-form h) pr)))
      (dk-nth-h! r)
      (ass))))
;;; the converse: pair-form H in context, q-form goal; S a subset of H x H by citation THM
(define (ubg-pair-to-q! h s sub!)
  (ubg-nth-goal!)
  (dk-peel!)
  (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) s))) (dk-asms))))
         (q (cadr mem)))
    (sub!)
    (dk-cite! 'subset-mem-fwd s ubg-HH q)
    (let* ((ns (ubg-pair-of! q '(VEC v) '(VEC v))) (n1 (car ns)) (n2 (cadr ns)))
      (ubg-pair-mem! q s n1 n2)
      (dk-apply! (dk-ctx-form h) n1 n2)
      (ass))))

;;; G*: [a, b] in G* iff for all [c, d] in G, <c | b> = <d | a>
(define ubg-adj-rhs
  '(FORALL ugc_ (IMPLIES (IN ugc_ (VEC v)) (FORALL ugd_ (IMPLIES (IN ugd_ (VEC v))
     (IMPLIES (IN (LIST ugc_ ugd_) gg) (= ((IP v) ugc_ b_) ((IP v) ugd_ a_))))))))
(ubg-mem-iff! 'graph-adjoint-pair-iff '(v gg a_ b_)
  (append ubg-CV (list (list 'SUBSET 'gg ubg-HH)) ubg-ab) '(LIST a_ b_) '(GRAPH-ADJOINT v gg)
  (lambda () (ubg-cart-ab!) (mac 'GRAPH-ADJOINT))
  ubg-adj-rhs
  (lambda (h) (ubg-q-to-pair! h 'gg))
  (lambda () (ubg-pair-to-q! ubg-adj-rhs 'gg (lambda () #t))))

;;; PERP in H (+) H: [a, b] in S-perp iff for all [c, d] in S, <a | c> + <b | d> = 0
(define ubg-perp-rhs
  '(FORALL ugc_ (IMPLIES (IN ugc_ (VEC v)) (FORALL ugd_ (IMPLIES (IN ugd_ (VEC v))
     (IMPLIES (IN (LIST ugc_ ugd_) ss) (= (+ ((IP v) a_ ugc_) ((IP v) b_ ugd_)) 0)))))))
(define (ubg-ip-pair! p q)              ; rewrite <p | q>_(H+H) at two literal pairs in the goal
  (subst (dk-cite! 'hsum-ip-pair 'v 'v (cadr p) (caddr p) (cadr q) (caddr q))))
(ubg-mem-iff! 'hsum-perp-pair-iff '(v ss a_ b_)
  (append ubg-CV (list (list 'SUBSET 'ss ubg-HH)) ubg-ab) '(LIST a_ b_) '(PERP (HSUM v v) ss)
  (lambda () (ubg-cart-ab!)
    (subst (dk-cite! 'perp-unfold '(HSUM v v) 'ss))
    (subst (dk-cite! 'hsum-vec-acc 'v 'v)))
  ubg-perp-rhs
  (lambda (h)
    (dk-peel!)
    (ubg-sets!)
    (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST)
                                              (equal? (caddr f) 'ss))) (dk-asms))))
           (pr (cadr mem)))
      (let* ((r (dk-apply! (dk-ctx-form h) pr))
             (e (dk-cite! 'hsum-ip-pair 'v 'v 'a_ 'b_ (cadr pr) (caddr pr))))
        (dk-rewrite-h! r (cadr e) (caddr e))
        (ass))))
  (lambda ()
    (dk-peel!)
    (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) 'ss))) (dk-asms))))
           (q (cadr mem)))
      (dk-cite! 'subset-mem-fwd 'ss ubg-HH q)
      (let* ((ns (ubg-pair-of! q '(VEC v) '(VEC v))) (n1 (car ns)) (n2 (cadr ns)))
        (ubg-pair-mem! q 'ss n1 n2)
        (dk-apply! (dk-ctx-form ubg-perp-rhs) n1 n2)
        (subst (list '= q (ubg-pr n1 n2)))
        (ubg-ip-pair! '(LIST a_ b_) (ubg-pr n1 n2))
        (ass)))))

;;; ==== c-adjoint.scm ====
;;; ---- PART C: Proposition 3.3, G* = (J G)-perp = J(G-perp) -----------------------------------
(set! ubg-v 'v)

;;; x + (-y) = 0 gives x = y in CC
(sp (make-wff (forall-guarded '(x_ y_) '((IN x_ CC) (IN y_ CC) (= (+ x_ (- y_)) 0)) '(= x_ y_))))
(dk-peel!)
(dk-have! '(= x_ (+ (+ x_ (- y_)) y_)) (lambda () (crs)))
(subst '(= x_ (+ (+ x_ (- y_)) y_)))
(subst '(= (+ x_ (- y_)) 0))
(crs)
(ubg-qed! 'cc-eq-of-add-neg-zero)

;;; the two scalar moves.  X, Y, Z are polynomials in inner products of typed vectors of v.
;;; (ubg-zero-of-eq! X Y Z): with X = Y in context, land Z = 0, where Z = conj X - conj Y
;;; after expansion.  (ubg-eq-of-zero! X Y Z): with Z = 0 in context, land X = Y, where
;;; X - Y = conj Z after expansion.
(define (ubg-ident! lhs rhs)             ; lhs = rhs by expansion and crs
  (let ((g (list '= lhs rhs)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (ubg-expand!) (ubg-type-ips! (dk-goal)) (crs))))
    g))
(define (ubg-zero-of-eq! x y z)
  (let ((w (list '+ (list 'conjugate x) (list '- (list 'conjugate y)))))
    (ubg-type-ips! (list x y))
    (ubg-ident! z w)
    (dk-have! (list '= z 0)
      (lambda ()
        (subst (list '= z w))
        (subst (list '= x y))
        (ubg-type-ips! (dk-goal))
        (crs)))))
(define (ubg-eq-of-zero! x y z)
  (let ((d (list '+ x (list '- y))))
    (ubg-type-ips! (list x y z))
    (ubg-ident! d (list 'conjugate z))
    (dk-have! '(= (conjugate 0) 0) (lambda () (arith)))
    (dk-have! (list '= d 0)
      (lambda ()
        (subst (list '= d (list 'conjugate z)))
        (subst (list '= z 0))
        (subst '(= (conjugate 0) 0))
        (rfl)))
    (ubg-ct! x) (ubg-ct! y)
    (dk-cite! 'cc-eq-of-add-neg-zero x y)))

;;; an IFF in context used one way: land the other side (split if it is a conjunction)
(define (ubg-iff->! iff)
  (if (not (dk-asm? (caddr iff)))
      (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))
  (caddr iff))
(define (ubg-iff<-! iff)
  (if (not (dk-asm? (cadr iff)))
      (begin (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff)))))
  (cadr iff))

;;; peel a pair-form goal (forall c, d in VEC v. [c, d] in S => P): return (c d)
(define (ubg-peel-pair! s)
  (dk-peel!)
  (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST) (equal? (caddr f) s)
                                              (not (dk-asm? (list 'IN (cadr f) 'SEP-NEVER)))))
                           (reverse (dk-asms))))))
    (ubg-set! (cadr (cadr mem)) '(VEC v)) (ubg-set! (caddr (cadr mem)) '(VEC v))
    (list (cadr (cadr mem)) (caddr (cadr mem)))))
(define (ubg-ip a b) (list '(IP v) a b))
(define (ubg-neg a) (list '(VNEG v) a))
(define ubg-hyps '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET gg (CARTESIAN (VEC v) (VEC v)))))
(define ubg-G* '(GRAPH-ADJOINT v gg))
(define ubg-Gp '(PERP (HSUM v v) gg))
(define ubg-JG '(GRAPH-J v gg))

;;; ---- G* = J(G-perp) ----
(sp (make-wff (forall-guarded '(v gg) ubg-hyps (list '= ubg-G* (list 'GRAPH-J 'v ubg-Gp)))))
(dk-peel!)
(dk-cite! 'hsum-is-set 'v 'v)
(ubg-hsum-vec-eq!)
(dk-cite! 'hsum-perp-is-set 'v 'gg)
(dk-cite! 'graph-adjoint-is-set 'v 'gg)
(dk-cite! 'graph-j-is-set 'v ubg-Gp)
(dk-cite! 'graph-adjoint-subset 'v 'gg)
(dk-cite! 'graph-j-subset 'v ubg-Gp)
(dk-cite! 'hsum-perp-subset 'v 'gg)
(dk-have! (list 'FORALL 'uga_ (list 'IMPLIES '(IN uga_ (VEC v)) (list 'FORALL 'ugb_ (list 'IMPLIES '(IN ugb_ (VEC v))
            (list 'IFF (list 'IN '(LIST uga_ ugb_) ubg-G*) (list 'IN '(LIST uga_ ugb_) (list 'GRAPH-J 'v ubg-Gp)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (pr (cadr (cadr g))) (a (cadr pr)) (b (caddr pr)) (na (ubg-neg a)))
      (ubg-vt! na)
      (ubg-set! a '(VEC v)) (ubg-set! b '(VEC v)) (ubg-set! na '(VEC v))
      (let* ((i1 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg a b))
             (i2 (dk-cite! 'graph-j-pair-iff 'v ubg-Gp a b))
             (i3 (dk-cite! 'hsum-perp-pair-iff 'v 'gg b na)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) (list 'GRAPH-J 'v ubg-Gp)))
          (lambda ()                      ; [a, b] in G*  =>  [a, b] in J(G-perp)
            (let ((af (ubg-iff->! i1)))
              (dk-have! (caddr i3)
                (lambda ()
                  (let* ((cd (ubg-peel-pair! 'gg)) (c (car cd)) (d (cadr cd)))
                    (dk-apply! (dk-ctx-form af) c d)
                    (ubg-zero-of-eq! (ubg-ip c b) (ubg-ip d a) (list '+ (ubg-ip b c) (ubg-ip na d)))
                    (ass))))
              (ubg-iff<-! i3)
              (ubg-iff<-! i2)
              (ass)))
          (lambda ()                      ; [a, b] in J(G-perp)  =>  [a, b] in G*
            (ubg-iff->! i2)
            (let ((bf (ubg-iff->! i3)))
              (dk-have! (caddr i1)
                (lambda ()
                  (let* ((cd (ubg-peel-pair! 'gg)) (c (car cd)) (d (cadr cd)))
