            (lambda ()
              (subst (dk-cite! 'cips-ip-conj-sym 'v x z))
              (subst (list '= (ubg-ip x z) 0))
              (subst (dk-cite! 'cc-conjugate-fixes-rr 0))
              (rfl)))))
    g))

