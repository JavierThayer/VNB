;;; <z | x> = 0 from <x | z> = 0
(define (ubg-orth-swap! x z)
  (let ((g (list '= (ubg-ip z x) 0)))
    (if (not (dk-asm? g))
        (begin
          (ubg-vt! x) (ubg-vt! z)
          (dk-have! '(IN 0 RR) (lambda () (arith)))
