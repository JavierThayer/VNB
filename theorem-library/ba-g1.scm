;;; ==== e-cayley.scm ====
;;; ---- PART E: the Cayley transform (60) and Proposition 3.9 ----------------------------------
(set! ubg-v 'v)

;;; the expansion meets conj(i) (the conjugate-homogeneity law at the scalar i): conj(i) = -i
(define ubg-push-conj-0 ubg-push-conj!)
(set! ubg-push-conj!
  (lambda (c)
    (let ((x (cadr c)))
      (if (and (number? x) (not (real? x)))
          (let ((e (list '= c (make-rectangular (real-part x) (- (imag-part x))))))
            (dk-have! e (lambda () (arith)))
            (subst e))
          (ubg-push-conj-0 c)))))

;;; the two components of the Cayley transform at (c, d): i c + d and -i c + d
(define (ubg-cy1 c d) (ubg-add (ubg-act +i c) d))
(define (ubg-cy2 c d) (ubg-add (ubg-act '(- +i) c) d))
(define (ubg-cy-type! c d)
  (let ((u1 (ubg-cy1 c d)) (u2 (ubg-cy2 c d)))
    (ubg-vt! u1) (ubg-vt! u2)
    (ubg-set! u1 '(VEC v)) (ubg-set! u2 '(VEC v))
    (list u1 u2)))
(define ubg-cd '((IN c_ (VEC v)) (IN d_ (VEC v))))

;;; [c, d] in G  =>  [i c + d, -i c + d] in C(G)
(sp (make-wff (forall-guarded '(v gg c_ d_) (append ubg-CV ubg-cd (list '(IN (LIST c_ d_) gg)))
   (list 'IN (ubg-pr (ubg-cy1 'c_ 'd_) (ubg-cy2 'c_ 'd_)) '(CAYLEY-GRAPH v gg)))))
(dk-peel!)
(ubg-sets!)
(let* ((us (ubg-cy-type! 'c_ 'd_)))
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (car us) (cadr us))
  (mac 'CAYLEY-GRAPH)
  (in-sep! (lambda () (ass))
           (lambda ()
             (ew '(LIST c_ d_))
             (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) 'IN)
                     (ass)
                     (dk-close-if! (lambda () (ubg-nth-goal!)) (lambda () (rfl)))))))))
(ubg-qed! 'cayley-pair-in)

;;; ||i c + d|| = ||-i c + d||  iff  <c | d> = <d | c>
(sp (make-wff (forall-guarded '(v c_ d_) (append ubg-CV ubg-cd)
   (list 'IFF (list '= (list 'IP-NORM 'v (ubg-cy1 'c_ 'd_)) (list 'IP-NORM 'v (ubg-cy2 'c_ 'd_)))
              (list '= (ubg-ip 'c_ 'd_) (ubg-ip 'd_ 'c_))))))
(dk-peel!)
(let* ((us (ubg-cy-type! 'c_ 'd_)) (u1 (car us)) (u2 (cadr us))
       (q1 (ubg-q u1)) (q2 (ubg-q u2))
       (n1 (list 'IP-NORM 'v u1)) (n2 (list 'IP-NORM 'v u2))
       (cd (ubg-ip 'c_ 'd_)) (dc (ubg-ip 'd_ 'c_)))
  (ubg-q-facts! u1) (ubg-q-facts! u2)
  (ubg-sqrt! q1) (ubg-sqrt! q2)
  (ubg-type-ips! (list cd dc q1 q2))
  (dk-iff! (lambda (gl) (equal? gl (list '= cd dc)))
    (lambda ()                            ; the norms agree => <c|d> = <d|c>
      (dk-have! (list '= (ubg-nsq u1) q1) (lambda () (dk-close-if! (lambda () (ubg-norm-sq! u1)) (lambda () (rfl)))))
      (dk-have! (list '= (ubg-nsq u2) q2) (lambda () (dk-close-if! (lambda () (ubg-norm-sq! u2)) (lambda () (rfl)))))
      (dk-have! (list '= q1 q2)
        (lambda ()
          (subst (list '= q1 (ubg-nsq u1)))
          (subst (list '= n1 n2))
          (dk-close-if! (lambda () (subst (list '= (ubg-nsq u2) q2))) (lambda () (rfl)))))
      (let ((big (list '+ dc (list '* 1/2 (list '* '(- +i) (list '+ q1 (list '- q2)))))))
        (ubg-ident! cd big)
        (subst (list '= cd big))
        (subst (list '= q1 q2))
        (ubg-expand!)
        (ubg-type-ips! (dk-goal))
        (crs)))
    (lambda ()                            ; <c|d> = <d|c> => the norms agree
      (dk-have! (list '= q1 q2)
        (lambda () (ubg-expand!) (subst (list '= cd dc)) (ubg-type-ips! (dk-goal)) (crs)))
      (subst (dk-cite! 'ip-norm-unfold 'v u1))
      (subst (dk-cite! 'ip-norm-unfold 'v u2))
      (dk-close-if! (lambda () (subst (list '= q1 q2))) (lambda () (rfl))))))
(ubg-qed! 'cayley-norm-iff)

;;; ---- Proposition 3.9, symmetric => C(G) isometric (no linearity needed) ----
(define ubg-sym-hyps (append ubg-CV (list (list 'SUBSET 'gg ubg-HH) '(IS-SYMMETRIC-GRAPH v gg))))
(sp (make-wff (forall-guarded '(v gg) ubg-sym-hyps '(IS-ISOMETRIC-GRAPH v (CAYLEY-GRAPH v gg)))))
