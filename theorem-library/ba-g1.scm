(let* ((pm (car (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (dk-head-is? (caddr f) 'SEP)))
                        (dk-asms))))
       (p (cadr pm))
       (ls (dk-landed (lambda () (sep-me pm))))
       (ex (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
       (q (dk-skolem! ex)))
  (dk-cite! 'subset-mem-fwd 'gg ubg-HH q)
  (let* ((ns (ubg-pair-of! q '(VEC v) '(VEC v))) (n1 (car ns)) (n2 (cadr ns)))
    (ubg-pair-mem! q 'gg n1 n2)
    (dk-cite! 'subset-mem-fwd 'gg ubg-G* (ubg-pr n1 n2))
    (let ((af (ubg-iff->! (dk-cite! 'graph-adjoint-pair-iff 'v 'gg n1 n2))))
      (dk-apply! (dk-ctx-form af) n1 n2))
    (ubg-cy-type! n1 n2)
    (let ((peq (car (filter (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) p))) (dk-asms)))))
      (subst peq))
    (ubg-nth-goal!)
    (ubg-iff<-! (dk-cite! 'cayley-norm-iff 'v n1 n2))
    (ass)))
(ubg-qed! 'cayley-isometric-of-symmetric)

;;; ---- Proposition 3.9, C(G) isometric => symmetric, for G linear ----
;;; G linear: G a subset of H x H
(define (ubg-lin-facts!)
  (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'hsum-is-set 'v 'v)
  (ubg-hsum-vec-eq!)
  (dk-have! '(IS-SUBMODULE (HSUM v v) gg)
    (lambda () (mac-h 'is-linear-graph '(IS-LINEAR-GRAPH v gg)) (ass)))
  (dk-cite! 'submodule-subset '(HSUM v v) 'gg)
  (dk-have! (list 'SUBSET 'gg ubg-HH)
    (lambda () (subst (list '= ubg-HH '(VEC (HSUM v v)))) (ass))))
;;; [a, b], [c, e] in G (G linear): land [a + c, b + e] in G; return it
(define (ubg-lin-add! a b c e)
  (let* ((s (list '(VADD (HSUM v v)) (ubg-pr a b) (ubg-pr c e)))
         (r (dk-cite! 'submodule-vadd-closed '(HSUM v v) 'gg (ubg-pr a b) (ubg-pr c e)))
         (eq (dk-cite! 'hsum-vadd-pair 'v 'v a b c e)))
    (dk-rewrite-h! r s (caddr eq))))
;;; [c, e] in G: land [k c, k e] in G for the scalar k; return it
(define (ubg-lin-act! k c e)
  (let ((g (list 'IN k '(CARR (SCAL (HSUM v v))))))
    (ubg-ct! k)
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (subst (dk-cite! 'hsum-scal-acc 'v 'v))
                      (subst (dk-cite! 'sip-cc-ring-carr))
                      (ass))))
    (let* ((s (list '(ACT (HSUM v v)) k (ubg-pr c e)))
           (r (dk-cite! 'submodule-act-closed '(HSUM v v) 'gg k (ubg-pr c e)))
           (eq (dk-cite! 'hsum-act-pair 'v 'v k c e)))
      (dk-rewrite-h! r s (caddr eq)))))
;;; with the isometry of C(G) in context as the q-form ISO: [c, d] in G gives <c|d> = <d|c>
(define (ubg-diag! iso c d)
  (let ((g (list '= (ubg-ip c d) (ubg-ip d c))))
    (if (not (dk-asm? g))
        (let* ((us (ubg-cy-type! c d)) (pr (ubg-pr (car us) (cadr us))))
          (dk-cite! 'cayley-pair-in 'v 'gg c d)
          (let ((r (dk-apply! (dk-ctx-form iso) pr)))
            (dk-nth-h! r))
          (ubg-iff->! (dk-cite! 'cayley-norm-iff 'v c d))))
    g))
(define (ubg-dd x y) (list '+ (ubg-ip x y) (list '- (ubg-ip y x))))

(define ubg-iso-hyps (append ubg-CV '((IS-LINEAR-GRAPH v gg) (IS-ISOMETRIC-GRAPH v (CAYLEY-GRAPH v gg)))))
(sp (make-wff (forall-guarded '(v gg) ubg-iso-hyps '(IS-SYMMETRIC-GRAPH v gg))))
(dk-peel!)
(ubg-lin-facts!)
(dk-cite! 'graph-adjoint-is-set 'v 'gg)
(dk-cite! 'graph-adjoint-subset 'v 'gg)
(dk-cite! 'cayley-graph-is-set 'v 'gg)
(define ubg-iso-q '(FORALL ubp_ (IMPLIES (IN ubp_ (CAYLEY-GRAPH v gg))
                     (= (IP-NORM v (NTH 1 ubp_)) (IP-NORM v (NTH 2 ubp_))))))
(dk-have! ubg-iso-q
  (lambda () (mac-h 'is-isometric-graph '(IS-ISOMETRIC-GRAPH v (CAYLEY-GRAPH v gg))) (ass)))
;;; pointwise: [a, b] in G => [a, b] in G*, by polarization on the pairs (a,b), (c,e),
;;; (a,b) + (c,e) and (a,b) + i(c,e)
(dk-have! '(FORALL uga_ (IMPLIES (IN uga_ (VEC v)) (FORALL ugb_ (IMPLIES (IN ugb_ (VEC v))
             (IMPLIES (IN (LIST uga_ ugb_) gg) (IN (LIST uga_ ugb_) (GRAPH-ADJOINT v gg)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g)))
           (iff (dk-cite! 'graph-adjoint-pair-iff 'v 'gg a b)))
      (ubg-set! a '(VEC v)) (ubg-set! b '(VEC v))
      (dk-have! (caddr iff)
        (lambda ()
          (let* ((ls (dk-landed (lambda () (dk-peel!))))
                 (mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST)
                                                    (equal? (caddr f) 'gg))) ls)))
                 (c (cadr (cadr mem))) (e (caddr (cadr mem)))
                 (ic (ubg-act +i c)) (ie (ubg-act +i e))
                 (ac (ubg-add a c)) (be (ubg-add b e))
                 (aic (ubg-add a ic)) (bie (ubg-add b ie)))
            (ubg-set! c '(VEC v)) (ubg-set! e '(VEC v))
            (for-each (lambda (x) (ubg-vt! x) (ubg-set! x '(VEC v))) (list ic ie ac be aic bie))
            (ubg-lin-add! a b c e)
            (ubg-lin-act! +i c e)
            (ubg-lin-add! a b ic ie)
            (for-each (lambda (xy) (ubg-diag! ubg-iso-q (car xy) (cadr xy)))
                      (list (list a b) (list c e) (list ac be) (list aic bie)))
            (let* ((d12 (list '+ (ubg-dd a b) (ubg-dd c e)))
                   (big (list '+ (ubg-ip e a)
                              (list '* 1/2 (list '+ (list '+ (ubg-dd ac be) (list '- d12))
                                                 (list '* '(- +i) (list '+ (ubg-dd aic bie) (list '- d12))))))))
              (ubg-ident! (ubg-ip c b) big)
              (subst (list '= (ubg-ip c b) big))
              (for-each (lambda (xy) (subst (list '= (ubg-ip (car xy) (cadr xy)) (ubg-ip (cadr xy) (car xy)))))
                        (list (list a b) (list c e) (list ac be) (list aic bie)))
              (ubg-expand!)
              (ubg-type-ips! (dk-goal))
              (crs)))))
      (ubg-iff<-! iff)
      (ass))))
(dk-cite! 'relation-pair-subset '(VEC v) '(VEC v) 'gg ubg-G*)
(mac 'is-symmetric-graph)
(ass)
(ubg-qed! 'cayley-symmetric-of-isometric)

;;; ---- Proposition 3.9 as the notes state it: for G linear, G symmetric iff C(G) isometric ----
(sp (make-wff (forall-guarded '(v gg) (append ubg-CV '((IS-LINEAR-GRAPH v gg)))
   '(IFF (IS-SYMMETRIC-GRAPH v gg) (IS-ISOMETRIC-GRAPH v (CAYLEY-GRAPH v gg))))))
(dk-peel!)
(ubg-lin-facts!)
(dk-iff! (lambda (gl) (dk-head-is? gl 'IS-ISOMETRIC-GRAPH))
  (lambda () (dk-cite! 'cayley-isometric-of-symmetric 'v 'gg) (ass))
  (lambda () (dk-cite! 'cayley-symmetric-of-isometric 'v 'gg) (ass)))
(ubg-qed! 'cayley-symmetric-iff-isometric)

;;; ==== f-cayley-adj.scm ====
;;; ---- PART F: the inverse Cayley transform and Proposition 3.11, C(G*) = (C(G)*)^-1 ----------
(set! ubg-v 'v)
(define (ubg-half!)
  (if (not (dk-asm? '(IN 1/2 CC)))
      (begin (dk-have! '(IN 1/2 RR) (lambda () (arith)))
             (dk-cite! 'rr-subset-cc 1/2))))
;;; the preimage of [p, q] under the Cayley map: x = -i (1/2 (p - q)), y = 1/2 (p + q)
(define (ubg-cx p q) (ubg-act '(- +i) (ubg-act 1/2 (ubg-sub p q))))
(define (ubg-cyy p q) (ubg-act 1/2 (ubg-add p q)))
(define (ubg-pre-type! p q)
  (ubg-half!)
  (let ((x (ubg-cx p q)) (y (ubg-cyy p q)))
    (ubg-vt! x) (ubg-vt! y) (ubg-set! x '(VEC v)) (ubg-set! y '(VEC v))
    (list x y)))
;;; peel a pair-form goal, the pair read off what the peel LANDED in S; return its components
(define (ubg-peel-new! s)
  (let* ((ls (dk-landed (lambda () (dk-peel!))))
         (mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST) (equal? (caddr f) s))) ls)))
         (c (cadr (cadr mem))) (d (caddr (cadr mem))))
    (ubg-set! c '(VEC v)) (ubg-set! d '(VEC v))
    (list c d)))
(define (ubg-dd2 s t) (list (quote +) s (list (quote -) t)))
(define (ubg-done-ass!) (if (not (proof-done? *ps*)) (dk-close-if! (lambda () #t) (lambda () (ass)))))

;;; [a, b] in C(H)  iff  [x(a, b), y(a, b)] in H   (H a subset of H x H)
(ubg-mem-iff! 'cayley-pair-iff '(v hh a_ b_)
  (append ubg-CV (list (list 'SUBSET 'hh ubg-HH)) ubg-ab) '(LIST a_ b_) '(CAYLEY-GRAPH v hh)
  (lambda () (ubg-cart-ab!) (ubg-pre-type! 'a_ 'b_) (mac 'CAYLEY-GRAPH))
  (list 'IN (ubg-pr (ubg-cx 'a_ 'b_) (ubg-cyy 'a_ 'b_)) 'hh)
  (lambda (h)
    (let* ((q0 (dk-skolem! h)))
      (dk-cite! 'subset-mem-fwd 'hh ubg-HH q0)
      (let* ((ns (ubg-pair-of! q0 '(VEC v) '(VEC v))) (n1 (car ns)) (n2 (cadr ns))
             (us (ubg-cy-type! n1 n2)) (u1 (car us)) (u2 (cadr us)))
        (ubg-pair-mem! q0 'hh n1 n2)
        (dk-split! (dk-cite! 'node-pair-injective 'a_ 'b_ u1 u2))
        (subst (list '= 'a_ u1))
        (subst (list '= 'b_ u2))
        (ubg-pre-type! u1 u2)
        (ubg-vec-eq! (ubg-cx u1 u2) n1)
        (ubg-vec-eq! (ubg-cyy u1 u2) n2)
        (subst (list '= (ubg-cx u1 u2) n1))
        (subst (list '= (ubg-cyy u1 u2) n2))
        (ass))))
  (lambda ()
    (let* ((x (ubg-cx 'a_ 'b_)) (y (ubg-cyy 'a_ 'b_))
           (us (ubg-cy-type! x y)) (u1 (car us)) (u2 (cadr us)))
      (ew (ubg-pr x y))
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (ass)
              (begin
                (ubg-nth-goal!)
                (ubg-vec-eq! 'a_ u1) (ubg-vec-eq! 'b_ u2)
                (subst (list '= u1 'a_))
                (dk-close-if! (lambda () (subst (list '= u2 'b_))) (lambda () (rfl))))))))))

;;; ---- Proposition 3.11 ----
(define ubg-CG '(CAYLEY-GRAPH v gg))
(define ubg-lhs11 (list 'CAYLEY-GRAPH 'v ubg-G*))
(define ubg-rhs11 (list 'GRAPH-INVERSE 'v (list 'GRAPH-ADJOINT 'v ubg-CG)))
(sp (make-wff (forall-guarded '(v gg) ubg-hyps (list '= ubg-lhs11 ubg-rhs11))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(ubg-half!)
(dk-cite! 'graph-adjoint-subset 'v 'gg)
(dk-cite! 'graph-adjoint-is-set 'v 'gg)
(dk-cite! 'cayley-graph-subset 'v 'gg)
(dk-cite! 'cayley-graph-is-set 'v 'gg)
(dk-cite! 'cayley-graph-subset 'v ubg-G*)
(dk-cite! 'cayley-graph-is-set 'v ubg-G*)
(dk-cite! 'graph-adjoint-subset 'v ubg-CG)
(dk-cite! 'graph-adjoint-is-set 'v ubg-CG)
(dk-cite! 'graph-inverse-subset 'v (list 'GRAPH-ADJOINT 'v ubg-CG))
(dk-cite! 'graph-inverse-is-set 'v (list 'GRAPH-ADJOINT 'v ubg-CG))
(dk-have! (list 'FORALL 'uga_ (list 'IMPLIES '(IN uga_ (VEC v)) (list 'FORALL 'ugb_ (list 'IMPLIES '(IN ugb_ (VEC v))
            (list 'IFF (list 'IN '(LIST uga_ ugb_) ubg-lhs11) (list 'IN '(LIST uga_ ugb_) ubg-rhs11))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (pr (cadr (cadr g))) (a (cadr pr)) (b (caddr pr)))
      (ubg-set! a '(VEC v)) (ubg-set! b '(VEC v))
      (let* ((xy (ubg-pre-type! a b)) (x (car xy)) (y (cadr xy))
             (i1 (dk-cite! 'cayley-pair-iff 'v ubg-G* a b))
             (i2 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg x y))
             (i3 (dk-cite! 'graph-inverse-pair-iff 'v (list 'GRAPH-ADJOINT 'v ubg-CG) a b))
             (i4 (dk-cite! 'graph-adjoint-pair-iff 'v ubg-CG b a)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) ubg-rhs11))
          (lambda ()                      ; [a, b] in C(G*)  =>  [a, b] in (C(G)*)^-1
            (ubg-iff->! i1)
            (let ((af (ubg-iff->! i2)))
              (dk-have! (caddr i4)
                (lambda ()
                  (let* ((cd (ubg-peel-new! ubg-CG)) (c1 (car cd)) (d1 (cadr cd))
                         (xy1 (ubg-pre-type! c1 d1)) (x1 (car xy1)) (y1 (cadr xy1)))
                    (ubg-iff->! (dk-cite! 'cayley-pair-iff 'v 'gg c1 d1))
                    (dk-apply! (dk-ctx-form af) x1 y1)
                    (let ((big (list '+ (ubg-ip d1 b) (list '* (list '* 2 +i) (ubg-dd2 (ubg-ip x1 y) (ubg-ip y1 x))))))
                      (ubg-ident! (ubg-ip c1 a) big)
                      (subst (list '= (ubg-ip c1 a) big))
                      (subst (list '= (ubg-ip x1 y) (ubg-ip y1 x)))
                      (ubg-expand!) (ubg-type-ips! (dk-goal)) (crs)))))
              (ubg-iff<-! i4)
              (ubg-iff<-! i3)
              (ubg-done-ass!)))
          (lambda ()                      ; [a, b] in (C(G)*)^-1  =>  [a, b] in C(G*)
            (ubg-iff->! i3)
            (let ((bf (ubg-iff->! i4)))
              (dk-have! (caddr i2)
                (lambda ()
                  (let* ((cd (ubg-peel-new! 'gg)) (c (car cd)) (d (cadr cd))
                         (us (ubg-cy-type! c d)) (u1 (car us)) (u2 (cadr us)))
                    (dk-cite! 'cayley-pair-in 'v 'gg c d)
                    (dk-apply! (dk-ctx-form bf) u1 u2)
                    (let ((big (list '+ (ubg-ip d x) (list '* (list '* 1/2 '(- +i)) (ubg-dd2 (ubg-ip u1 a) (ubg-ip u2 b))))))
                      (ubg-ident! (ubg-ip c y) big)
                      (subst (list '= (ubg-ip c y) big))
                      (subst (list '= (ubg-ip u1 a) (ubg-ip u2 b)))
                      (ubg-expand!) (ubg-type-ips! (dk-goal)) (crs)))))
              (ubg-iff<-! i2)
              (ubg-iff<-! i1)
              (ubg-done-ass!))))))))
(dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) ubg-lhs11 ubg-rhs11)
(ubg-done-ass!)
(ubg-qed! 'cayley-of-adjoint)

;;; ==== g-unitary.scm ====
;;; ---- PART G: unitary graphs, and Proposition 3.12 (C(G) unitary => G self-adjoint) ---------
(set! ubg-v 'v)

;;; the closure laws of a linear graph G, at literal pairs (G named)
(define (ubg-lin-facts-of! g)
  (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'hsum-is-set 'v 'v)
  (ubg-hsum-vec-eq!)
  (dk-have! (list 'IS-SUBMODULE '(HSUM v v) g)
    (lambda () (mac-h 'is-linear-graph (list 'IS-LINEAR-GRAPH 'v g)) (ass)))
  (dk-cite! 'submodule-subset '(HSUM v v) g)
  (dk-have! (list 'SUBSET g ubg-HH)
    (lambda () (subst (list '= ubg-HH '(VEC (HSUM v v)))) (ass))))
(define (ubg-lin-add-in! g a b c e)
  (let* ((s (list '(VADD (HSUM v v)) (ubg-pr a b) (ubg-pr c e)))
         (r (dk-cite! 'submodule-vadd-closed '(HSUM v v) g (ubg-pr a b) (ubg-pr c e)))
         (eq (dk-cite! 'hsum-vadd-pair 'v 'v a b c e)))
    (dk-rewrite-h! r s (caddr eq))))
(define (ubg-lin-act-in! g k c e)
  (let ((gl (list 'IN k '(CARR (SCAL (HSUM v v))))))
    (ubg-ct! k)
    (if (not (dk-asm? gl))
        (dk-have! gl (lambda ()
                       (subst (dk-cite! 'hsum-scal-acc 'v 'v))
                       (subst (dk-cite! 'sip-cc-ring-carr))
                       (ass))))
    (let* ((s (list '(ACT (HSUM v v)) k (ubg-pr c e)))
           (r (dk-cite! 'submodule-act-closed '(HSUM v v) g k (ubg-pr c e)))
           (eq (dk-cite! 'hsum-act-pair 'v 'v k c e)))
      (dk-rewrite-h! r s (caddr eq)))))
;;; with the q-form isometry ISO of G in context and [x, y] in G: land <x|x> = <y|y>
(define (ubg-qeq! iso x y)
  (let ((g (list '= (ubg-q x) (ubg-q y))))
    (if (not (dk-asm? g))
        (let ((n1 (list 'IP-NORM 'v x)) (n2 (list 'IP-NORM 'v y)))
          (ubg-vt! x) (ubg-vt! y) (ubg-set! x '(VEC v)) (ubg-set! y '(VEC v))
          (ubg-q-facts! x) (ubg-q-facts! y) (ubg-sqrt! (ubg-q x)) (ubg-sqrt! (ubg-q y))
          (dk-nth-h! (dk-apply! (dk-ctx-form iso) (ubg-pr x y)))
          (dk-have! (list '= (ubg-nsq x) (ubg-q x)) (lambda () (dk-close-if! (lambda () (ubg-norm-sq! x)) (lambda () (rfl)))))
          (dk-have! (list '= (ubg-nsq y) (ubg-q y)) (lambda () (dk-close-if! (lambda () (ubg-norm-sq! y)) (lambda () (rfl)))))
          (dk-have! g
            (lambda ()
              (subst (list '= (ubg-q x) (ubg-nsq x)))
              (subst (list '= n1 n2))
              (dk-close-if! (lambda () (subst (list '= (ubg-nsq y) (ubg-q y)))) (lambda () (rfl)))))))
    g))
(define (ubg-iso-q g)
  (list 'FORALL 'ubp_ (list 'IMPLIES (list 'IN 'ubp_ g)
     '(= (IP-NORM v (NTH 1 ubp_)) (IP-NORM v (NTH 2 ubp_))))))
;;; the four parts of IS-UNITARY-GRAPH v g, each on its own lane
(define (ubg-unitary-part! g part)
  (dk-have! part
    (lambda () (mac-h 'is-unitary-graph (list 'IS-UNITARY-GRAPH 'v g)) (dk-split-all!) (ass))))

;;; ---- a unitary graph preserves the inner product ----
(define ubg-u-hyps (append ubg-CV '((IS-UNITARY-GRAPH v uu))))
(sp (make-wff (forall-guarded '(v uu c_ d_ e_ f_)
   (append ubg-u-hyps '((IN c_ (VEC v)) (IN d_ (VEC v)) (IN e_ (VEC v)) (IN f_ (VEC v))
                        (IN (LIST c_ d_) uu) (IN (LIST e_ f_) uu)))
   '(= ((IP v) c_ e_) ((IP v) d_ f_)))))
(dk-peel!)
(ubg-sets!)
(ubg-unitary-part! 'uu '(IS-LINEAR-GRAPH v uu))
(ubg-unitary-part! 'uu '(IS-ISOMETRIC-GRAPH v uu))
(ubg-lin-facts-of! 'uu)
(dk-have! (ubg-iso-q 'uu) (lambda () (mac-h 'is-isometric-graph '(IS-ISOMETRIC-GRAPH v uu)) (ass)))
(let* ((iso (ubg-iso-q 'uu))
       (ie (ubg-act +i 'e_)) (if_ (ubg-act +i 'f_))
       (ce (ubg-add 'c_ 'e_)) (df (ubg-add 'd_ 'f_))
       (cie (ubg-add 'c_ ie)) (dif (ubg-add 'd_ if_)))
  (for-each (lambda (x) (ubg-vt! x) (ubg-set! x '(VEC v))) (list ie if_ ce df cie dif))
  (ubg-lin-add-in! 'uu 'c_ 'd_ 'e_ 'f_)
  (ubg-lin-act-in! 'uu +i 'e_ 'f_)
  (ubg-lin-add-in! 'uu 'c_ 'd_ ie if_)
  (for-each (lambda (xy) (ubg-qeq! iso (car xy) (cadr xy)))
            (list (list 'c_ 'd_) (list 'e_ 'f_) (list ce df) (list cie dif)))
  (let* ((pol (lambda (x y xy xiy)
                (let ((s (list '+ (ubg-q x) (ubg-q y))))
                  (list '* 1/2 (list '+ (list '+ (ubg-q xy) (list '- s))
                                     (list '* +i (list '+ (ubg-q xiy) (list '- s))))))))
         (bc (pol 'c_ 'e_ ce cie)) (bd (pol 'd_ 'f_ df dif)))
    (ubg-ident! (ubg-ip 'c_ 'e_) bc)
    (ubg-ident! (ubg-ip 'd_ 'f_) bd)
    (subst (list '= (ubg-ip 'c_ 'e_) bc))
    (subst (list '= (ubg-ip 'd_ 'f_) bd))
    (for-each (lambda (xy) (subst (list '= (ubg-q (car xy)) (ubg-q (cadr xy)))))
              (list (list 'c_ 'd_) (list 'e_ 'f_) (list ce df) (list cie dif)))
    (ubg-type-ips! (dk-goal))
    (dk-close-if! (lambda () #t) (lambda () (rfl)))))
(ubg-qed! 'unitary-graph-preserves-ip)

;;; ---- the unfolds of the domain and the range (theorems, so that a hypothesis can be opened) ----
(sp (make-wff '(FORALL v (FORALL uu (== (GRAPH-DOM v uu)
   (SEP ubx_ (VEC v) (FORSOME uby_ (AND (IN uby_ (VEC v)) (IN (LIST ubx_ uby_) uu)))))))))
(dk-peel!) (mac 'GRAPH-DOM) (if (not (proof-done? *ps*)) (qrfl))
(ubg-qed! 'graph-dom-unfold)
(sp (make-wff '(FORALL v (FORALL uu (== (GRAPH-RAN v uu)
   (SEP uby_ (VEC v) (FORSOME ubx_ (AND (IN ubx_ (VEC v)) (IN (LIST ubx_ uby_) uu)))))))))
(dk-peel!) (mac 'GRAPH-RAN) (if (not (proof-done? *ps*)) (qrfl))
(ubg-qed! 'graph-ran-unfold)
;;; t in VEC v = DOM / RAN of uu (in context): land the witness of its partner; return it
(define (ubg-partner! which t)
  (let* ((fun (if (eq? which 'dom) 'GRAPH-DOM 'GRAPH-RAN))
         (eqn (dk-cite! (if (eq? which 'dom) 'graph-dom-unfold 'graph-ran-unfold) 'v 'uu))
         (sep (caddr eqn))
         (m (list 'IN t sep)))
    (dk-have! m
      (lambda ()
        (subst (list '= sep (list fun 'v 'uu)))
        (subst (list '= (list fun 'v 'uu) '(VEC v)))
        (ass)))
    (let* ((ls (dk-landed (lambda () (sep-me m))))
           (ex (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls))))
      (dk-skolem! ex))))

;;; ---- the adjoint of a unitary graph is its inverse ----
(sp (make-wff (forall-guarded '(v uu) ubg-u-hyps '(= (GRAPH-ADJOINT v uu) (GRAPH-INVERSE v uu)))))
(dk-peel!)
(ubg-unitary-part! 'uu '(IS-LINEAR-GRAPH v uu))
(ubg-unitary-part! 'uu '(= (GRAPH-DOM v uu) (VEC v)))
(ubg-unitary-part! 'uu '(= (GRAPH-RAN v uu) (VEC v)))
(ubg-lin-facts-of! 'uu)
(dk-cite! 'graph-adjoint-subset 'v 'uu)
(dk-cite! 'graph-inverse-subset 'v 'uu)
(dk-have! '(FORALL uga_ (IMPLIES (IN uga_ (VEC v)) (FORALL ugb_ (IMPLIES (IN ugb_ (VEC v))
            (IFF (IN (LIST uga_ ugb_) (GRAPH-ADJOINT v uu)) (IN (LIST uga_ ugb_) (GRAPH-INVERSE v uu)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (pr (cadr (cadr g))) (x (cadr pr)) (y (caddr pr)))
      (ubg-set! x '(VEC v)) (ubg-set! y '(VEC v))
      (let* ((i1 (dk-cite! 'graph-adjoint-pair-iff 'v 'uu x y))
             (i2 (dk-cite! 'graph-inverse-pair-iff 'v 'uu x y)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) '(GRAPH-INVERSE v uu)))
          (lambda ()                      ; [x, y] in U*  =>  [y, x] in U
            (let* ((af (ubg-iff->! i1))
                   (z (ubg-partner! 'dom y))
                   (w (ubg-sub x z)))
              (ubg-set! z '(VEC v))
              (ubg-vt! w) (ubg-set! w '(VEC v))
              (let ((u (ubg-partner! 'ran w)))
                (ubg-set! u '(VEC v))
                (dk-apply! (dk-ctx-form af) u w)              ; <u|y> = <w|x>
                (dk-cite! 'unitary-graph-preserves-ip 'v 'uu u w y z)   ; <u|y> = <w|z>
                (let ((big (list '+ (ubg-ip w x) (list '- (ubg-ip w z)))))
                  (ubg-type-ips! (list (ubg-ip u y) (ubg-ip w x) (ubg-ip w z)))
                  (ubg-ident! (ubg-q w) big)
                  (dk-have! (list '= (ubg-q w) 0)
                    (lambda ()
                      (subst (list '= (ubg-q w) big))
                      (subst (list '= (ubg-ip w x) (ubg-ip u y)))
                      (subst (list '= (ubg-ip w z) (ubg-ip u y)))
                      (ubg-type-ips! (dk-goal))
                      (crs)))
                  (dk-cite! 'cips-eq-of-dist-sq-zero 'v x z)))
              (dk-have! (list 'IN (ubg-pr y x) 'uu) (lambda () (subst (list '= x z)) (ass)))
              (ubg-iff<-! i2)
              (ubg-done-ass!)))
          (lambda ()                      ; [y, x] in U  =>  [x, y] in U*
            (ubg-iff->! i2)
            (dk-have! (caddr i1)
              (lambda ()
                (let* ((cd (ubg-peel-new! 'uu)) (c (car cd)) (d (cadr cd)))
                  (dk-cite! 'unitary-graph-preserves-ip 'v 'uu c d y x)
                  (ubg-done-ass!))))
            (ubg-iff<-! i1)
            (ubg-done-ass!)))))))
(dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) '(GRAPH-ADJOINT v uu) '(GRAPH-INVERSE v uu))
(ubg-done-ass!)
(ubg-qed! 'unitary-graph-adjoint-is-inverse)

;;; ---- the inverse is an involution ----
(sp (make-wff (forall-guarded '(v gg) ubg-hyps '(= (GRAPH-INVERSE v (GRAPH-INVERSE v gg)) gg))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'graph-inverse-subset 'v 'gg)
(dk-cite! 'graph-inverse-is-set 'v 'gg)
(dk-cite! 'graph-inverse-subset 'v '(GRAPH-INVERSE v gg))
(dk-have! '(FORALL uga_ (IMPLIES (IN uga_ (VEC v)) (FORALL ugb_ (IMPLIES (IN ugb_ (VEC v))
            (IFF (IN (LIST uga_ ugb_) (GRAPH-INVERSE v (GRAPH-INVERSE v gg))) (IN (LIST uga_ ugb_) gg))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (pr (cadr (cadr g))) (x (cadr pr)) (y (caddr pr)))
      (ubg-set! x '(VEC v)) (ubg-set! y '(VEC v))
      (let* ((i1 (dk-cite! 'graph-inverse-pair-iff 'v '(GRAPH-INVERSE v gg) x y))
             (i2 (dk-cite! 'graph-inverse-pair-iff 'v 'gg y x)))
        (dk-iff! (lambda (gl) (equal? (caddr gl) 'gg))
          (lambda () (ubg-iff->! i1) (ubg-iff->! i2) (ubg-done-ass!))
          (lambda () (ubg-iff<-! i2) (ubg-iff<-! i1) (ubg-done-ass!)))))))
(dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) '(GRAPH-INVERSE v (GRAPH-INVERSE v gg)) 'gg)
(ubg-done-ass!)
(ubg-qed! 'graph-inverse-involutive)

;;; ---- the Cayley transform is injective ----
;;; [a, b] in H, C(H) = C(K): land [a, b] in K
(define (ubg-cy-transfer! h k a b)
  (let* ((us (ubg-cy-type! a b)) (u1 (car us)) (u2 (cadr us))
         (m (dk-cite! 'cayley-pair-in 'v h a b)))
    (dk-have! (list 'IN (ubg-pr u1 u2) (list 'CAYLEY-GRAPH 'v k))
      (lambda () (subst (list '= (list 'CAYLEY-GRAPH 'v k) (list 'CAYLEY-GRAPH 'v h))) (ass)))
    (ubg-pre-type! u1 u2)
    (ubg-iff->! (dk-cite! 'cayley-pair-iff 'v k u1 u2))
    (ubg-vec-eq! (ubg-cx u1 u2) a)
    (ubg-vec-eq! (ubg-cyy u1 u2) b)
    (let ((h1 (dk-rewrite-h! (list 'IN (ubg-pr (ubg-cx u1 u2) (ubg-cyy u1 u2)) k) (ubg-cx u1 u2) a)))
      (dk-rewrite-h! h1 (ubg-cyy u1 u2) b))))
(sp (make-wff (forall-guarded '(v hh kk)
   (append ubg-CV (list (list 'SUBSET 'hh ubg-HH) (list 'SUBSET 'kk ubg-HH)
                        '(= (CAYLEY-GRAPH v hh) (CAYLEY-GRAPH v kk))))
   '(= hh kk))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-have! '(FORALL uga_ (IMPLIES (IN uga_ (VEC v)) (FORALL ugb_ (IMPLIES (IN ugb_ (VEC v))
            (IFF (IN (LIST uga_ ugb_) hh) (IN (LIST uga_ ugb_) kk))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (pr (cadr (cadr g))) (a (cadr pr)) (b (caddr pr)))
      (ubg-set! a '(VEC v)) (ubg-set! b '(VEC v))
      (dk-iff! (lambda (gl) (equal? (caddr gl) 'kk))
        (lambda () (ubg-cy-transfer! 'hh 'kk a b) (ubg-done-ass!))
        (lambda () (ubg-cy-transfer! 'kk 'hh a b) (ubg-done-ass!))))))
(dk-cite! 'relation-pair-ext '(VEC v) '(VEC v) 'hh 'kk)
(ubg-done-ass!)
