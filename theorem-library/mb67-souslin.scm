;;; mb67-souslin.scm -- construction of measures, chapter 5 sections 1.4-1.4.1 (M-B67, 2026-10-26): the necessity
;;; half of Proposition 5.14 (so 5.14 as an IFF), Corollary 5.15, Proposition 5.16, Corollary 5.17.
;;; Vocabulary: mb35-souslin-vocab.scm (IS-SOUSLIN, IS-BAIRE-CONTINUOUS), mb67-vocab.scm (BAIRE-MS, SEQ-TAIL,
;;; SEQ-CONS, SEQ-PROJ).  Library: measure.  Helper prefixes mr- (copied from mb35-souslin.scm) and msx-.
;;;
;;; Load window: after mb67-baire (the Baire space), mb35-souslin (souslin-baire-image, baire-image-souslin,
;;; continuous-image-polish-souslin, prefix-eq-*, polish-open-souslin), mb4-polish-open
;;; (coarser-metric-separable), riesz-markov-model (rmm-nn-choice), nn-pairing.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define msx-F '(FUN NN NN))
(define msx-W '(VNB-LAMBDA bwk_ NN 2))
(define (msx-P y n) (list 'PREFIX-PROD msx-W y n))
(define (msx-dd x y) (list (list 'DIST 'BAIRE-MS) x y))
(define (msx-seg n) (list 'ORD-SEGMENT n))
(define (msx-pre z n) (list 'RESTRICT z (msx-seg n)))
(define (msx-ff! z f cod)            ; z in N^N: (f z) in cod
  (dk-cite! 'fun-apply-type-c f msx-F cod z))
(define (msx-img-in! f dom cod w)    ; f in FUN(dom, cod), w in dom:  f(w) in IMAGE(f, dom)
  (let ((fw (list f w)))
    (dk-cite! 'fun-apply-type-c f dom cod w)
    (dk-cite! 'membership-implies-sethood fw cod)
    (dk-have! (list 'IN fw (list 'IMAGE f dom))
      (lambda () (mac 'image-membership-iff)
        (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew w) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))))
(define (msx-img-open! f dom p)      ; p in IMAGE(f, dom): returns w in dom with f(w) = p landed
  (let* ((ps (mr-iff-parts! (dk-cite! 'image-membership-iff f dom p)))
         (w (dk-skolem! (cadr ps))))
    (dk-split-all!)
    w))
(define (msx-fset!)                  ; FUN(NN, NN) is a set
  (if (not (dk-asm? (list 'IN msx-F 'SET)))
      (begin
        (dk-cite! 'nn-is-set)
        (let ((iff (dk-cite! 'fun-set-iff 'NN 'NN)))
          (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
          (mr-iff-back! iff)))))
(define (msx-P! y n)                 ; y in N^N, n in NN: recip P(y, n) typed and positive
  (let* ((P (msx-P y n)) (rP (list 'recip P)))
    (if (not (dk-asm? (list '< 0 rP)))
        (begin
          (if (not (dk-asm? (list '<= (list '+ n 1) P))) (dk-split-all! (list (dk-cite! 'baire-prod-facts n y y))))
          (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-zero-le n)
          (dk-have! (list '< 0 P) (lambda () (dk-ineq! (list '<= (list '+ n 1) P) (list '<= 0 n) (list 'IN n 'RR) (list 'IN P 'RR))))
          (mr-ne! P 0 (list '< 0 P))
          (mr-chain! (dk-fact! 'rr-recip-closed P))
          (dk-cite! 'rr-recip-pos P)))
    rP))
(define (msx-close-agree! a b n)     ; a, b in N^N, n in NN, d(a, b) <= 1/P(a, n+1) in context: RESTRICT b = RESTRICT a at n
  (let* ((r1 (list 'recip (msx-P a (list 'succ n)))) (r0 (list 'recip (msx-P a n)))
         (dd (msx-dd a b)))
    (if (not (dk-asm? (list 'IN (list 'PREFIX-DIST msx-W a b) 'RR))) (dk-split-all! (list (dk-cite! 'baire-ms-dist a b))))
    (dk-have! (list 'IN dd 'RR) (lambda () (subst (list '= dd (list 'PREFIX-DIST msx-W a b))) (ass)))
    (if (not (dk-asm? (list '< r1 r0))) (dk-split-all! (list (dk-cite! 'baire-delta a n))))
    (dk-cite! 'rr-pos-rr-in-rr r1)
    (msx-P! a n)
    (dk-cite! 'nn-in-rr n)
    (let ((ag (begin (dk-have! (list '< dd r0) (lambda () (dk-ineq! (list '<= dd r1) (list '< r1 r0) (list 'IN dd 'RR) (list 'IN r1 'RR) (list 'IN r0 'RR))))
                     (mr-chain! (dk-cite! 'baire-close-agree a a b n)))))
      (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '< 'k n) (list '= (list b 'k) (list a 'k)))))
        (lambda ()
          (let* ((lk (dk-peel!))
                 (lt (mr-find 'ca-lt (lambda (f) (dk-head-is? f '<)) lk))
                 (k (cadr lt)))
            (dk-cite! 'nn-in-rr k)
            (dk-have! (list '<= k n) (lambda () (dk-ineq! lt (list 'IN k 'RR) (list 'IN n 'RR))))
            (dk-apply! ag k)
            (dk-cite! 'fun-apply-type-c b 'NN 'NN k)
            (subst (list '= (list a k) (list b k)))
            (rfl))))
      (mr-chain! (dk-cite! 'prefix-eq-intro a b n)))))

;;; ======================================================================
;;; a Baire-continuous map is continuous from BAIRE-MS onto its image
;;; ======================================================================
(define msx-sub '(SUBSPACE-MS s e))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'e (list 'IMPLIES '(SUBSET e (PTS s))
  (list 'FORALL 'f (list 'IMPLIES '(IS-BAIRE-CONTINUOUS s f) (list 'IMPLIES (list '= (list 'IMAGE 'f msx-F) 'e)
    (list 'IS-CONTINUOUS 'BAIRE-MS msx-sub 'f))))))))))
(dk-peel!)
(define msx-bc (mr-iff-parts! (dk-cite! 'is-baire-continuous 's 'f)))
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'subclass-of-set-is-set 'e '(PTS s))
(dk-cite! 'subspace-pts 's 'e)
(dk-cite! 'subspace-is-metric-space 's 'e)
(dk-cite! 'baire-ms-is-metric-space)
(dk-cite! 'baire-ms-pts)
(let ((iff (dk-cite! 'fun-codomain-iff msx-F 'e 'f)))
  (mr-iff-parts! (dk-cite! 'fun-codomain-iff msx-F '(PTS s) 'f))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let ((x (dk-di-var!)))
                (msx-img-in! 'f msx-F '(PTS s) x)
                (subst (list '= 'e (list 'IMAGE 'f msx-F)))
                (mr-close-open!)))))))
  (mr-iff-back! iff))
(let ((iff (dk-cite! 'is-continuous 'BAIRE-MS msx-sub 'f)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (cond
            ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'IN)
             (subst '(= (PTS BAIRE-MS) (FUN NN NN))) (subst (list '= (list 'PTS msx-sub) 'e)) (mr-close-open!))
            (#t
             (let ((a (cadr (car (dk-peel!)))))
               (dk-have! (list 'IN a msx-F) (lambda () (subst '(= (FUN NN NN) (PTS BAIRE-MS))) (mr-close-open!)))
               (let ((iff2 (dk-cite! 'is-continuous-at 'BAIRE-MS msx-sub 'f a)))
                 (dk-have! (caddr iff2)
                   (lambda ()
                     (mr-and-close!
                       (lambda ()
                         (cond
                           ((dk-asm? (dk-goal)) (ass))
                           ((dk-head-is? (dk-goal) 'IN)
                            (subst '(= (PTS BAIRE-MS) (FUN NN NN))) (subst (list '= (list 'PTS msx-sub) 'e)) (mr-close-open!))
                           (#t
                            (let* ((eps (cadr (car (dk-peel!))))
                                   (n (dk-skolem! (dk-apply! (cadr msx-bc) a eps)))
                                   (ncl (begin (dk-split-all!) (mr-find 'ncl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n) (dk-contains? f 'RESTRICT))) (dk-asms))))
                                   (r1 (begin (dk-cite! 'nn-succ-closed n) (list 'recip (msx-P a (list 'succ n))))))
                              (dk-split-all! (list (dk-cite! 'baire-delta a n)))
                              (ew r1)
                              (mr-and-close!
                                (lambda ()
                                  (if (dk-asm? (dk-goal)) (ass)
                                      (let* ((lb (dk-peel!))
                                             (b (cadr (mr-find 'cb (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS BAIRE-MS)))) lb))))
                                        (dk-have! (list 'IN b msx-F) (lambda () (subst '(= (FUN NN NN) (PTS BAIRE-MS))) (mr-close-open!)))
                                        (msx-close-agree! a b n)
                                        (dk-apply! ncl b)
                                        (dk-cite! 'fun-apply-type-c 'f msx-F 'e a)
                                        (dk-cite! 'fun-apply-type-c 'f msx-F 'e b)
                                        (dk-cite! 'subspace-dist 's 'e (list 'f a) (list 'f b))
                                        (subst (list '= (list (list 'DIST msx-sub) (list 'f a) (list 'f b)) (list '(DIST s) (list 'f a) (list 'f b))))
                                        (mr-close-open!))))))))))))
                 (mr-iff-back! iff2))
               (mr-close-open!))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'baire-continuous-subspace)
(topic! 'baire-continuous-subspace 'analysis)

;;; ======================================================================
;;; PROPOSITION 5.14, necessity, and the IFF
;;; ======================================================================
(define msx-rhs '(FORSOME t (AND (IS-COMPLETE t) (AND (IS-SEPARABLE t)
                   (FORSOME h (AND (IS-CONTINUOUS t (SUBSPACE-MS s e) h) (= (IMAGE h (PTS t)) e)))))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'e (list 'IMPLIES '(IS-SOUSLIN s e) msx-rhs))))))
(dk-peel!)
(define msx-f1 (dk-skolem! (dk-cite! 'souslin-baire-image 's 'e)))
(dk-split-all!)
(mr-iff-parts! (dk-cite! 'is-baire-continuous 's msx-f1))
(dk-have! '(SUBSET e (PTS s))
  (lambda ()
    (mac 'subset-def)
    (let ((w (dk-di-var!)))
      (dk-rewrite-h! (list 'IN w 'e) 'e (list 'IMAGE msx-f1 msx-F))
      (dk-cite! 'image-subset-codomain msx-F '(PTS s) msx-f1 w)
      (mr-close-open!))))
(dk-cite! 'baire-continuous-subspace 's 'e msx-f1)
(dk-cite! 'baire-ms-complete)
(dk-cite! 'baire-ms-separable)
(dk-cite! 'baire-ms-pts)
(ew 'BAIRE-MS)
(mr-and-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
        (begin
          (ew msx-f1)
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (begin (subst '(= (PTS BAIRE-MS) (FUN NN NN))) (mr-close-open!)))))))))
(qed 'souslin-polish-image)
(topic! 'souslin-polish-image 'analysis)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'e (list 'IMPLIES '(SUBSET e (PTS s))
  (list 'IFF '(IS-SOUSLIN s e) msx-rhs)))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda () (dk-cite! 'souslin-polish-image 's 'e) (mr-close-open!))
  (lambda ()
    (let ((t0 (dk-skolem! msx-rhs)))
      (dk-split-all!)
      (let ((h0 (dk-skolem! (mr-find 'h-ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0))) (dk-asms)))))
        (dk-split-all!)
        (dk-cite! 'continuous-image-polish-souslin 's 'e t0 h0)
        (mr-close-open!)))))
(qed 'souslin-iff-polish-image)
(topic! 'souslin-iff-polish-image 'analysis)

;;; ======================================================================
;;; COROLLARY 5.15: continuous images of Souslin sets are Souslin
;;; ======================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL phi (IMPLIES (IS-CONTINUOUS s t phi)
   (FORALL e (IMPLIES (IS-SOUSLIN s e) (IS-SOUSLIN t (IMAGE phi e))))))))))
(dk-peel!)
(define msx-cp (mr-iff-parts! (dk-cite! 'is-continuous 's 't 'phi)))
(define msx-hat (list-ref msx-cp 3))
(define msx-f2 (dk-skolem! (dk-cite! 'souslin-baire-image 's 'e)))
(dk-split-all!)
(define msx-bc2 (mr-iff-parts! (dk-cite! 'is-baire-continuous 's msx-f2)))
(define msx-g (list 'VNB-LAMBDA 'msg_ msx-F (list 'phi (list msx-f2 'msg_))))
(define (msx-gpt! z)                 ; z in N^N: f z in PTS s, phi(f z) in PTS t, (g z) == phi(f z)
  (let* ((fz (list msx-f2 z)) (pz (list 'phi fz)) (eqn (list '== (list msx-g z) pz)))
    (if (not (dk-asm? eqn))
        (begin
          (dk-cite! 'fun-apply-type-c msx-f2 msx-F '(PTS s) z)
          (dk-cite! 'fun-apply-type-c 'phi '(PTS s) '(PTS t) fz)
          (dk-have! eqn (lambda () (dk-lam-b!) (qrfl)))))
    pz))
(msx-fset!)
(dk-have! (list 'IN msx-g (list 'FUN msx-F '(PTS t)))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (msx-gpt! z) (mr-close-open!))))))
(dk-have! (list 'IS-BAIRE-CONTINUOUS 't msx-g)
  (lambda ()
    (mac 'is-baire-continuous)
    (mr-and-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((lk (dk-peel!))
                   (z (cadr (mr-find 'z5 (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) msx-F))) lk)))
                   (eps (cadr (mr-find 'e5 (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
                   (pz (msx-gpt! z)) (fz (list msx-f2 z))
                   (cat (dk-apply! msx-hat fz))
                   (cparts (mr-iff-parts! (dk-cite! 'is-continuous-at 's 't 'phi fz)))
                   (cl (list-ref cparts 4))
                   (delta (dk-skolem! (dk-apply! cl eps)))
                   (dcl (begin (dk-split-all!) (mr-find 'dcl5 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f delta) (dk-contains? f 'phi))) (dk-asms))))
                   (n (dk-skolem! (dk-apply! (cadr msx-bc2) z delta)))
                   (ncl (begin (dk-split-all!) (mr-find 'ncl5 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n) (dk-contains? f 'RESTRICT))) (dk-asms)))))
              (ew n)
              (mr-and-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (let* ((lk2 (dk-peel!))
                             (w (cadr (mr-find 'w5 (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) msx-F))) lk2)))
                             (pw (msx-gpt! w)) (fw (list msx-f2 w)))
                        (dk-apply! ncl w)
                        (dk-apply! dcl fw)
                        (subst (list '= (list msx-g z) pz))
                        (subst (list '= (list msx-g w) pw))
                        (mr-close-open!)))))))))))
(define msx-ie (list 'IMAGE msx-f2 msx-F))
(dk-have! (list '= (list 'IMAGE msx-g msx-F) '(IMAGE phi e))
  (lambda ()
    (mr-ext2! (list 'IMAGE msx-g msx-F) '(IMAGE phi e)
      (lambda (p)
        (let* ((z (msx-img-open! msx-g msx-F p))
               (pz (msx-gpt! z)) (fz (list msx-f2 z)))
          (subst (list '= p (list msx-g z)))
          (subst (list '= (list msx-g z) pz))
          (msx-img-in! msx-f2 msx-F '(PTS s) z)
          (dk-rewrite-h! (list 'IN fz msx-ie) msx-ie 'e)
          (dk-cite! 'membership-implies-sethood pz '(PTS t))
          (mac 'image-membership-iff)
          (dk-conj-close!
            (lambda () (if (dk-asm? (dk-goal)) (ass)
                           (begin (ew fz) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))
      (lambda (p)
        (let* ((x (msx-img-open! 'phi 'e p))
               (x1 (dk-rewrite-h! (list 'IN x 'e) 'e msx-ie))
