(dk-apply! msb-sek msb-k0)
(define msb-E (list 'VNB-LAMBDA 'mbe_ 'NN (list 'IF '(FORSOME mbx_ (IN mbx_ (f mbe_))) '(f mbe_) msb-fk0)))
(dk-cite! 'nn-is-set)
(dk-have! (list 'IN msb-E '(FUN NN (POWER (PTS s))))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (dk-cite! 'fun-apply-type-c 'f 'NN '(POWER (PTS s)) k)
                                 (dk-case-if! (cadr (dk-goal)) (lambda (tv val) (mr-close-open!))))))))
              (dk-opened (lambda () (lam-t))))))
(define (msb-Ek! k)                  ; k in NN: E(k) beta-reduced in the goal, case on its IF; BODY gets the branch value
  (dk-cite! 'fun-apply-type-c 'f 'NN '(POWER (PTS s)) k))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-SOUSLIN 's (list msb-E 'k))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (msb-Ek! k)
      (dk-lam-b!)
      (dk-case-if! (caddr (dk-goal))
        (lambda (tv val)
          (if tv (begin (dk-apply! msb-sek k) (mr-close-open!)) (mr-close-open!)))))))
(mr-chain! (dk-cite! 'souslin-countable-union 's msb-E))
(define msb-UE (list 'BIG-UNION 'mxk_ 'NN (list msb-E 'mxk_)))
(dk-have! (list '= msb-UE msb-U)
  (lambda ()
    (mr-ext2! msb-UE msb-U
      (lambda (p)
        (let* ((ka (mr-bu-open! p msb-UE)) (k (car ka)))
          (msb-Ek! k)
          (dk-lam-b-h! (cdr ka))
          (let ((h (mr-find 'pin (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) p) (dk-head-is? (caddr f) 'IF))) (dk-asms))))
            (use-em (cadr (caddr h))
              (lambda ()
                (dk-have! (list '= (caddr h) (list 'f k)) (lambda () (dk-if-branch! #t (caddr h) #f (lambda () (rfl)))))
                (dk-rewrite-h! h (caddr h) (list 'f k))
                (mr-bu-close! k))
              (lambda ()
                (dk-have! (list '= (caddr h) msb-fk0) (lambda () (dk-if-branch! #f (caddr h) #f (lambda () (rfl)))))
                (dk-rewrite-h! h (caddr h) msb-fk0)
                (mr-bu-close! msb-k0))))))
      (lambda (p)
