          (msb-Ek! k)
          (dk-have! (list 'FORSOME 'mbx_ (list 'IN 'mbx_ (list 'f k))) (lambda () (ew p) (mr-close-open!)))
          (for-each (lambda (l) (if (not (sequent-node-grounded? l))
