;; "Souslin or empty" is closed under countable unions
(define (msb-se a) (list 'IMPLIES (list 'FORSOME 'mbx_ (list 'IN 'mbx_ a)) (list 'IS-SOUSLIN 's a)))
(define msb-U '(BIG-UNION n_ NN (f n_)))
