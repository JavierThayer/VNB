              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-SOUSLIN 's (list msb-Ec 'k))))
  (lambda ()
    (let* ((k (dk-di-var!)) (ck (msb-cf! k)))
