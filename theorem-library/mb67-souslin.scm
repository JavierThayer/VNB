(dk-peel!)
(define msb-sek (mr-find 'sek (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-SOUSLIN))) (dk-asms)))
(define msb-x (dk-skolem! (mr-find 'xU (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'BIG-UNION))) (dk-asms))))
