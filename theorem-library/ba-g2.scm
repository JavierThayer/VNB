;;; Library: operator-algebras.

;;; ba-g2.scm -- Banach Algebras and Applications (F. J. Thayer), chapter 3, the rest of BA-G1's
;;; graph theory.  Proving agent BA-G2, 2026-11-09/10.  Helper prefix bg2-.
;;;
;;;   Part A  HSUM(v, w) is a complex inner product space (hsum-is-cips).
;;;   Part B  HSUM(v, w) is a Hilbert space when v and w are (hsum-is-hilbert), by the component
;;;           sequences: d_v, d_w <= d_S <= d_v + d_w.
;;;   Part C  3.4 (1) without the extra hypothesis; G* linear and closed; 3.4 (2), (3).
;;;   Part D  dom(G^-1) = ran G, (G^-1)* = (G*)^-1, G^-1 linear; 3.5 (1), (2).
;;;   Part E  C(G) is linear when G is.
;;;   Part F  [y, 0] in G* iff y is orthogonal to ran G; G self-adjoint => C(G)* = C(G)^-1, and
;;;           C(G) has dense domain and range.
;;;   Part G  G self-adjoint => dom C(G) = ran C(G) = H (projection onto the closed graph G in
;;;           H (+) H), hence 3.12 in both directions.
;;;
;;; Loads after: theorem-library/ba-g1 (and its window), sip-d1 (ms-cauchy-of-dominated,
;;; ms-converges-of-dominated-sum), cvx-alg (cvx-mul-nonneg), hilbert-projection.
;;;

;;; ======== bg2-helpers.scm
;;; bg2 helpers: the helper definitions of ba-g1.scm (BA-G1's ubg- kit, itself a copy of ba-bh.scm's bbh- kit), prefix bg2-.
(define bg2-v 'v)
(define (bg2-ip a b) (list (list 'IP bg2-v) a b))
(define (bg2-sub a b) (list (list 'VADD bg2-v) a (list (list 'VNEG bg2-v) b)))
(define (bg2-add a b) (list (list 'VADD bg2-v) a b))
(define (bg2-act c a) (list (list 'ACT bg2-v) c a))
(define (bg2-q a) (bg2-ip a a))
(define (bg2-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) bg2-v)))
(define (bg2-zero? e) (equal? e (list 'VZERO bg2-v)))
(define (bg2-vt! e)
  (let ((goal (list 'IN e (list 'VEC bg2-v))))
    (cond ((and (dk-asm? goal) (not (or (bg2-op? e 'VADD) (bg2-op? e 'VNEG) (bg2-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((bg2-op? e 'VADD) (bg2-vt! (cadr e)) (bg2-vt! (caddr e)))
                 ((bg2-op? e 'VNEG) (bg2-vt! (cadr e)))
                 ((bg2-op? e 'ACT)  (bg2-ct! (cadr e)) (bg2-vt! (caddr e))))
           goal)
          ((bg2-op? e 'VADD) (bg2-vt! (cadr e)) (bg2-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type bg2-v (cadr e) (caddr e)) goal)
          ((bg2-op? e 'VNEG) (bg2-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type bg2-v (cadr e)) goal)
          ((bg2-op? e 'ACT)  (bg2-ct! (cadr e)) (bg2-vt! (caddr e))
                             (dk-cite! 'cips-act-type bg2-v (cadr e) (caddr e)) goal)
          ((bg2-zero? e) (dk-cite! 'cips-vzero-in bg2-v) goal)
          ((bg2-app-fun e) => (lambda (ft) (bg2-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "bg2-vt!: no typing for the vector" (expression->string e))))))
(define (bg2-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC bg2-v))))
                   (dk-asms))))
(define (bg2-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC bg2-v)) (bg2-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((bg2-v (cadr d))) (bg2-vt! a)))
        (#t (error "bg2-arg-t!: argument not typed" (expression->string (list 'IN a d))))))
(define (bg2-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((bg2-op? c 'IP) (bg2-vt! (cadr c)) (bg2-vt! (caddr c))
                           (dk-cite! 'cips-ip-type bg2-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (pair? (car c)) (eq? (car (car c)) 'IP) (= (length c) 3))   ; another space
           (fluid-let ((bg2-v (cadr (car c)))) (bg2-ct! c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (bg2-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (bg2-ct! (cadr c)) (bg2-ct! (caddr c))
           (bg2-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (bg2-ct! (cadr c)) (bg2-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (bg2-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))
(define (bg2-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (bg2-op? e 'IP) (= (length e) 3)
              (or (bg2-compound? (cadr e)) (bg2-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bg2-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (bg2-compound? e)
  (or (bg2-op? e 'VADD) (bg2-op? e 'VNEG) (bg2-op? e 'ACT) (bg2-zero? e)))
(define (bg2-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (bg2-vt! a) (bg2-vt! b)
    (cond ((bg2-op? a 'VADD) (dk-cite! 'cips-ip-add-left bg2-v (cadr a) (caddr a) b))
          ((bg2-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left bg2-v (cadr a) b))
          ((bg2-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left bg2-v (cadr a) (caddr a) b))
          ((bg2-zero? a)     (dk-cite! 'cips-ip-zero-left bg2-v b))
          ((bg2-op? b 'VADD) (dk-cite! 'cips-ip-add-right bg2-v a (cadr b) (caddr b)))
          ((bg2-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right bg2-v a (cadr b)))
          ((bg2-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right bg2-v (cadr b) a (caddr b)))
          ((bg2-zero? b)     (dk-cite! 'cips-ip-zero-right bg2-v a))
          (#t (error "bg2-open-law!: not a redex" (expression->string r))))))
(define (bg2-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (bg2-op? x 'IP) (= (length x) 3))))))
(define (bg2-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((bg2-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bg2-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (bg2-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "bg2-expand!: out of fuel"))
    (let ((r (bg2-find-redex (dk-goal))))
      (if r
          (let ((eq (bg2-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (bg2-find-real-conj (dk-goal))))
            (if c
                (begin
                  (bg2-push-conj! c)
                  (loop (- fuel 1)))))))))
(define (bg2-push-conj! c)
  (let ((x (cadr c)))
    (cond ((eqv? x +i)
           (if (not (dk-asm? '(= (conjugate +i) (- +i))))
               (dk-have! '(= (conjugate +i) (- +i)) (lambda () (arith))))
           (subst '(= (conjugate +i) (- +i))))
          ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((bg2-op? x 'IP)
           (bg2-vt! (cadr x)) (bg2-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym bg2-v (cadr x) (caddr x))
           (subst (list '= c (bg2-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (bg2-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (bg2-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (bg2-ct! (cadr x)) (bg2-ct! (caddr x))
           (bg2-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))
(define (bg2-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))
(define (bg2-q-facts! u)
  (bg2-vt! u)
  (dk-cite! 'cips-ip-self-real bg2-v u)
  (dk-cite! 'cips-ip-self-nonneg bg2-v u))
(define (bg2-norm-sq! u)
  (bg2-vt! u)
  (subst (dk-cite! 'ip-norm-unfold bg2-v u))
  (bg2-q-facts! u)
  (bg2-sqrt! (bg2-q u))
  (subst (dk-cite! 'sqrt-sq (bg2-q u))))
(define (bg2-nsq u) (list '* (list 'IP-NORM bg2-v u) (list 'IP-NORM bg2-v u)))
(define (bg2-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (bg2-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
(define (bg2-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (bg2-and (cdr fs)))))
(define (bg2-have-and! . fs)
  (let ((c (bg2-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))
(define (bg2-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((bg2-op? e 'IP) (bg2-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (bg2-ct! e))
        (#t (for-each bg2-type-ips! e))))
(define (bg2-qd p xi) (bg2-q (bg2-sub p xi)))
(define (bg2-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (bg2-vt! a) (bg2-vt! b)
          (dk-have! (list '= (bg2-qd a b) 0)
            (lambda () (bg2-expand!) (bg2-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero bg2-v a b)))
    goal))
(define (bg2-q-eq! a b)
  (let ((goal (list '= (bg2-q a) (bg2-q b))))
    (if (not (dk-asm? goal))
        (begin (bg2-vt! a) (bg2-vt! b)
               (dk-have! goal (lambda () (bg2-expand!) (bg2-type-ips! (dk-goal)) (crs)))))
    goal))
(define (bg2-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** BG2: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "BG2: unfinished" name))))
(define (bg2-show! tag)
  (display "\n--- BG2 ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
(define (bg2-sub! ks x)
  (dk-cite! 'submodule-subset bg2-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC bg2-v) x))
(define (bg2-scal! c)
  (dk-cite! 'cips-scal-carrier bg2-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL bg2-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL bg2-v)) 'CC)) (ass))))
(define bg2-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w)))
(define bg2-HS '(HSUM v w))
(define (bg2-set-atoms! e)
  ;; every (IN x (VEC u)) in context whose x occurs in e: land (IN x SET)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (pair? (caddr h)) (dk-contains? e (cadr h))
                       (not (eq? (caddr h) 'SET)) (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (bg2-nth!)
  (let loop ((k 0))
    (if (and (< k 40) (not (proof-done? *ps*)) (dk-contains? (dk-goal) 'NTH)
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (bg2-set-atoms! (dk-goal)) (nth-r) (loop (+ k 1))))))
(define (bg2-hsum-sets!)
  (dk-cite! 'cips-vec-set 'v) (dk-cite! 'cips-vec-set 'w)
  (dk-cite! 'cips-vzero-in 'v) (dk-cite! 'cips-vzero-in 'w))
(define (bg2-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v w) bg2-C2 (list '== (list acc bg2-HS) val))))
  (dk-peel!)
  (bg2-hsum-sets!)
  (slot acc)
  (mac 'HSUM)
  (nth-r)
  ;; the same accessor in the value (VEC v, VZERO v): read it off there too, to a fixpoint
  (let loop ((k 0))
    (if (and (< k 4) (not (proof-done? *ps*)) (dk-contains? (dk-goal) acc))
        (begin (slot acc) (bg2-nth!) (loop (+ k 1)))))
  (if (not (proof-done? *ps*)) (qrfl))
  (bg2-qed! name))
(define (bg2-rhs-type! e)
  (cond ((and (pair? e) (eq? (car e) 'LIST)) (for-each bg2-rhs-type! (cdr e)))
        ((and (pair? e) (pair? (car e)) (memq (car (car e)) '(VADD VNEG ACT)))
         (fluid-let ((bg2-v (cadr (car e)))) (bg2-vt! e)))
        (#t (bg2-ct! e))))
(define bg2-pair-guards '((IN a_ (VEC v)) (IN b_ (VEC w)) (IN c_ (VEC v)) (IN d_ (VEC w))))
(define (bg2-pair-value! name vars guards lhs rhs acc fun)
  (sp (make-wff (forall-guarded (append '(v w) vars) (append bg2-C2 guards) (list '= lhs rhs))))
  (dk-peel!)
  (bg2-hsum-sets!)
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) 'a_ 'b_)
  (if (memq 'c_ vars) (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) 'c_ 'd_))
  (subst (dk-cite! acc 'v 'w))
  (mac fun)
  (dk-lam-b!)
  (bg2-nth!)
  (if (not (proof-done? *ps*))
      (begin
        (bg2-rhs-type! rhs)
        (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))
                                  (dk-cite! 'membership-implies-sethood (cadr h) '(VEC v))))
                  (dk-asms))
        (rfl)))
  (bg2-qed! name))
(define (bg2-vadd u a b) (list (list 'VADD u) a b))
(define (bg2-vneg u a) (list (list 'VNEG u) a))
(define (bg2-vact u c a) (list (list 'ACT u) c a))
(define (bg2-ipu u a b) (list (list 'IP u) a b))
(define bg2-HV '(CARTESIAN (VEC v) (VEC w)))
(define (bg2-split-carts!)                ; NTH typings of every pair variable in context
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (dk-head-is? (caddr h) 'CARTESIAN)
                       (= (length (caddr h)) 3)
                       (not (dk-asm? (list 'IN (list 'NTH 1 (cadr h)) (cadr (caddr h))))))
                  (dk-split! (dk-cite! 'cartesian-nth (cadr h) (cadr (caddr h)) (caddr (caddr h))))))
            (dk-asms)))
(define (bg2-type! t c)
  (cond ((dk-asm? (list 'IN t c)) #t)
        ((and (dk-head-is? t 'LIST) (dk-head-is? c 'CARTESIAN))
         (bg2-type! (cadr t) (cadr c)) (bg2-type! (caddr t) (caddr c))
         (dk-cite! 'pair-in-cartesian (cadr c) (caddr c) (cadr t) (caddr t)))
        ((eq? c 'CC) (bg2-ct! t))
        ((dk-head-is? c 'VEC) (fluid-let ((bg2-v (cadr c))) (bg2-vt! t)))
        (#t (error "bg2-type!: no route" (expression->string (list 'IN t c))))))
(define (bg2-op-type! name op cod)
  (sp (make-wff (forall-guarded '(v w) bg2-C2 (list 'IN (list op 'v 'w) cod))))
  (dk-peel!)
  (bg2-hsum-sets!)
  (dk-cite! 'cc-is-set)
  (dk-have! (list 'IN bg2-HV 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (mac op)
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (bg2-split-carts!)
      (let ((g (dk-goal))) (bg2-type! (cadr g) (caddr g)) (ass)))
    (lambda () (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                   (ass))))
  (bg2-qed! name))
(define bg2-CV '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define bg2-HH '(CARTESIAN (VEC v) (VEC v)))
(define (bg2-pr a b) (list 'LIST a b))
(define (bg2-sets!)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (not (eq? (caddr h) 'SET))
                       (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (bg2-set! x c)
  (if (not (dk-asm? (list 'IN x 'SET))) (dk-cite! 'membership-implies-sethood x c)))
(define (bg2-pair-of! q xs ys)
  (let ((n1 (list 'NTH 1 q)) (n2 (list 'NTH 2 q)))
    (dk-split! (dk-cite! 'cartesian-nth q xs ys))
    (dk-cite! 'cartesian-pair-eq q xs ys)
    (bg2-set! n1 xs) (bg2-set! n2 ys)
    (list n1 n2)))
(define (bg2-pair-mem! q s n1 n2)
  (let ((g (list 'IN (bg2-pr n1 n2) s)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (bg2-pr n1 n2) q)) (ass))))
    g))
(define (bg2-nth-goal!)
  (bg2-sets!)
  (let loop ((k 0))
    (if (and (< k 40) (not (proof-done? *ps*))
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (nth-r) (loop (+ k 1))))))
(define (bg2-nth-hs! landed)
  (bg2-sets!)
  (map (lambda (h) (if (dk-asm? h) (dk-nth-h! h) h)) landed))
(define bg2-ext-h '(FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IFF (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
(define bg2-sub-h '(FORALL ugc_ (IMPLIES (IN ugc_ xs) (FORALL ugd_ (IMPLIES (IN ugd_ ys)
       (IMPLIES (IN (LIST ugc_ ugd_) aa) (IN (LIST ugc_ ugd_) bb)))))))
(define (bg2-refl-leaves!)
  (let ((home (proof-state-focus *ps*)))
    (for-each (lambda (l)
                (let ((g (dk-goal-of l)))
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
                      (begin (dk-focus! l) (rfl)))))
              (dk-open-leaves))
    (if (not (sequent-node-grounded? home)) (dk-focus! home))))
(define (bg2-sep-subset! name fun)
  (sp (make-wff (forall-guarded '(v gg) bg2-CV (list 'SUBSET (list fun 'v 'gg) bg2-HH))))
  (dk-peel!)
  (dk-cite! 'cips-vec-set 'v)
  (mac fun)
  (mac 'subset-def)
  (bg2-refl-leaves!)
  (dk-peel!)
  (let ((h (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))))
    (sep-me h)
    (dk-split-all!)
    (ass))
