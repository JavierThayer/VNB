;;; ======== a-cips.scm
;;; ---- PART A: H (+) K is a complex inner product space ---------------------------------------
;;; The CIPS laws of HSUM(v, w) at pairs: each pair variable is split into named components,
;;; every HSUM operation at literal pairs is rewritten by its pair value (ba-g1's hsum-*-pair),
;;; and the componentwise law is closed in v and in w by the expansion kit.

(define bg2-S '(HSUM v w))
(define bg2-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define bg2-HV '(CARTESIAN (VEC v) (VEC w)))
(define (bg2-sacc a) (list a bg2-S))
(define (bg2-open?) (pair? (dk-open-leaves)))

;;; run THUNK; on an error dump the focus leaf and re-raise with TAG
(define (bg2-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (if (bg2-open?) (bg2-show! tag))
          (k (error "BG2 stop" tag (if (condition? e) (condition/report-string e) e))))
        thunk))))

;;; the common context: both spaces, their carriers sets, CC, the ring view, HSUM a set
(define (bg2-base!)
  (bg2-hsum-sets!)
  (if (not (dk-asm? '(IN CC SET))) (fact 'cc-is-set))
  (if (not (dk-asm? '(IS-NORMED-FIELD CC-NORMED-FIELD))) (fact 'cc-is-normed-field))
  (if (not (dk-asm? (list 'IS-COMMUTATIVE-RING bg2-R)))
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))
  (if (not (dk-asm? (list 'IN bg2-HV 'SET)))
      (dk-have! (list 'IN bg2-HV 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))
  (if (not (dk-asm? (list 'IN bg2-S 'SET))) (dk-cite! 'hsum-is-set 'v 'w)))

;;; a pair variable p in VEC v x VEC w: name its components a, b, land p = [a, b], and
;;; substitute it in the goal.  Returns (a b).
(define (bg2-split-pair! p)
  (dk-split! (dk-cite! 'cartesian-nth p '(VEC v) '(VEC w)))
  (let* ((pe (dk-cite! 'cartesian-pair-eq p '(VEC v) '(VEC w)))
         (a (dk-name! (list 'NTH 1 p) '(VEC v)))
         (b (dk-name! (list 'NTH 2 p) '(VEC w)))
         (pe1 (dk-rewrite-h! pe (list 'NTH 1 p) a))
         (pe2 (dk-rewrite-h! pe1 (list 'NTH 2 p) b)))
    (bg2-set! a '(VEC v)) (bg2-set! b '(VEC w))
    (subst (list '= p (list 'LIST a b)))
    (list a b)))

;;; every variable typed in VEC v x VEC w that occurs in the goal is split
(define (bg2-split-goal-pairs!)
  (for-each (lambda (h)
              (if (and (bg2-open?) (dk-head-is? h 'IN) (symbol? (cadr h)) (equal? (caddr h) bg2-HV)
                       (dk-contains? (dk-goal) (cadr h)))
                  (bg2-split-pair! (cadr h))))
            (dk-asms)))

;;; ---- rewriting the HSUM operations at literal pairs ---------------------------------------
(define bg2-ops (list (bg2-sacc 'VADD) (bg2-sacc 'VNEG) (bg2-sacc 'ACT) (bg2-sacc 'IP)
                      (list 'ADD bg2-R) (list 'MUL bg2-R)))
(define (bg2-app? e) (and (pair? e) (member (car e) bg2-ops) #t))
(define (bg2-find e)
  (cond ((not (pair? e)) #f)
        (#t (or (let loop ((l (if (bg2-app? e) (cdr e) e)))
                  (cond ((not (pair? l)) #f)
                        ((bg2-find (car l)) => (lambda (x) x))
                        (#t (loop (cdr l)))))
                (and (bg2-app? e) e)))))
(define (bg2-lit? e) (dk-head-is? e 'LIST))
(define (bg2-typ-pair! p)            ; p = (LIST a b): a in VEC v, b in VEC w, both sets
  (bg2-type! (cadr p) '(VEC v)) (bg2-type! (caddr p) '(VEC w))
  (bg2-set! (cadr p) '(VEC v)) (bg2-set! (caddr p) '(VEC w)))
(define (bg2-rw1! a)
  (let ((op (car (car a))))
    (cond ((eq? op 'VADD) (bg2-typ-pair! (cadr a)) (bg2-typ-pair! (caddr a))
                          (subst (dk-cite! 'hsum-vadd-pair 'v 'w (cadr (cadr a)) (caddr (cadr a))
                                           (cadr (caddr a)) (caddr (caddr a)))))
          ((eq? op 'VNEG) (bg2-typ-pair! (cadr a))
                          (subst (dk-cite! 'hsum-vneg-pair 'v 'w (cadr (cadr a)) (caddr (cadr a)))))
          ((eq? op 'ACT)  (bg2-ct! (cadr a)) (bg2-typ-pair! (caddr a))
                          (subst (dk-cite! 'hsum-act-pair 'v 'w (cadr a) (cadr (caddr a)) (caddr (caddr a)))))
          ((eq? op 'IP)   (bg2-typ-pair! (cadr a)) (bg2-typ-pair! (caddr a))
                          (subst (dk-cite! 'hsum-ip-pair 'v 'w (cadr (cadr a)) (caddr (cadr a))
                                           (cadr (caddr a)) (caddr (caddr a)))))
          ((memq op '(ADD MUL))
           (bg2-ct! (cadr a)) (bg2-ct! (caddr a))
           (subst (dk-cite! (if (eq? op 'ADD) 'sip-cc-ring-add-value 'sip-cc-ring-mul-value) (cadr a) (caddr a))))
          (#t (error "bg2-rw1!" (expression->string a))))))
(define (bg2-rw!)
  (let loop ((fuel 80))
    (if (<= fuel 0) (error "bg2-rw!: out of fuel"))
    (let ((a (and (bg2-open?) (bg2-find (dk-goal)))))
      (if a (begin (bg2-rw1! a) (loop (- fuel 1)))))))

;;; ---- closing the componentwise goals ----------------------------------------------------
(define (bg2-space-of e)               ; the space of a vector term: v or w
  (cond ((and (pair? e) (pair? (car e)) (memq (car (car e)) '(VADD VNEG ACT))) (cadr (car e)))
        ((and (pair? e) (eq? (car e) 'VZERO)) (cadr e))
        ((dk-asm? (list 'IN e '(VEC v))) 'v)
        ((dk-asm? (list 'IN e '(VEC w))) 'w)
        (#t (error "bg2-space-of: no space for" (expression->string e)))))
;;; expand the goal in both spaces (inner products of constructed vectors opened, conjugates
;;; pushed in), then crs
(define (bg2-expand-both!)
  (fluid-let ((bg2-v 'v)) (bg2-expand!))
  (fluid-let ((bg2-v 'w)) (bg2-expand!))
  (fluid-let ((bg2-v 'v)) (bg2-type-ips! (dk-goal)))
  (fluid-let ((bg2-v 'w)) (bg2-type-ips! (dk-goal))))
(define (bg2-scalar-close!)
  (bg2-expand-both!)
  (if (bg2-open?) (crs)))
;;; [p, q] = [r, s]: p = r in v, q = s in w, then the pair
(define (bg2-pair-eq! l r)
  (let ((p (cadr l)) (q (caddr l)) (rr (cadr r)) (ss (caddr r)))
    (fluid-let ((bg2-v 'v)) (bg2-vt! p) (bg2-vt! rr) (bg2-vec-eq! p rr))
    (fluid-let ((bg2-v 'w)) (bg2-vt! q) (bg2-vt! ss) (bg2-vec-eq! q ss))
    (bg2-set! rr '(VEC v)) (bg2-set! ss '(VEC w))
    (dk-close-if! (lambda () (bg2-orient-subst! p rr))
                  (lambda () (dk-close-if! (lambda () (bg2-orient-subst! q ss))
                                           (lambda () (rfl)))))))
;;; rewrite x into y (or y into x when y contains x); nothing when equal
(define (bg2-orient-subst! x y)
  (cond ((equal? x y) #t)
        ((dk-contains? y x) (subst (list '= y x)))
        (#t (subst (list '= x y)))))

;;; the definite law at a pair [a, b]:  (<a,a> + <b,b> = 0)  iff  ([a, b] = [0, 0])
(define (bg2-definite! g)
  (let* ((l (cadr g)) (sum (cadr l)) (qa (cadr sum)) (qb (caddr sum))
         (pr (cadr (caddr g))) (a (cadr pr)) (b (caddr pr)))
    (fluid-let ((bg2-v 'v)) (bg2-q-facts! a))
    (fluid-let ((bg2-v 'w)) (bg2-q-facts! b))
    (dk-cite! 'cips-vzero-in 'v) (dk-cite! 'cips-vzero-in 'w)
    (bg2-set! '(VZERO v) '(VEC v)) (bg2-set! '(VZERO w) '(VEC w))
    (dk-iff! (lambda (gl) (not (dk-contains? (if (dk-head-is? gl 'IMPLIES) (caddr gl) gl) 'IP)))
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
        (dk-have! (list '= qa 0)
          (lambda ()
            (dk-have! (list '<= qa 0) (lambda () (dk-ineq! (list 'IN qa 'RR) (list 'IN qb 'RR) (list '<= 0 qb) l)))
            (dk-have! '(IN 0 RR) (lambda () (arith)))
            (dk-have! (list 'AND (list 'IN qa 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! dk-ass!)))
            (dk-have! (list 'AND (list '<= qa 0) (list '<= 0 qa)) (lambda () (dk-conj-close! dk-ass!)))
            (dk-cite! 'rr-leq-antisymmetric qa 0)
            (dk-close-if-asm!)))
        (dk-have! (list '= qb 0)
          (lambda ()
            (dk-have! (list '<= qb 0) (lambda () (dk-ineq! (list 'IN qa 'RR) (list 'IN qb 'RR) (list '<= 0 qa) l)))
            (dk-have! '(IN 0 RR) (lambda () (arith)))
            (dk-have! (list 'AND (list 'IN qb 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! dk-ass!)))
            (dk-have! (list 'AND (list '<= qb 0) (list '<= 0 qb)) (lambda () (dk-conj-close! dk-ass!)))
            (dk-cite! 'rr-leq-antisymmetric qb 0)
            (dk-close-if-asm!)))
        (dk-cite! 'cips-ip-zero-vector 'v a)
        (dk-cite! 'cips-ip-zero-vector 'w b)
        (dk-close-if! (lambda () (subst (list '= a '(VZERO v))))
                      (lambda () (dk-close-if! (lambda () (subst (list '= b '(VZERO w)))) (lambda () (rfl))))))
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
        (dk-split! (dk-cite! 'node-pair-injective a b '(VZERO v) '(VZERO w)))
        (subst (list '= a '(VZERO v)))
        (subst (list '= b '(VZERO w)))
        (subst (dk-cite! 'cips-ip-zero-left 'v '(VZERO v)))
        (subst (dk-cite! 'cips-ip-zero-left 'w '(VZERO w)))
        (dk-close-if! (lambda () #t) (lambda () (arith)))))))

;;; close one law of HSUM, stated with v's and w's operations on the components
(define (bg2-close!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((dk-head-is? g 'IFF) (bg2-definite! g))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'RR))      ; <a,a> + <b,b> in RR
           (let* ((s (cadr g)) (x (cadr s)) (y (caddr s)))
             (fluid-let ((bg2-v 'v)) (bg2-q-facts! (cadr x)))
             (fluid-let ((bg2-v 'w)) (bg2-q-facts! (cadr y)))
             (dk-cite! 'rr-add-in-rr x y)
             (dk-close-if-asm!)))
          ((dk-head-is? g '<=)                                ; 0 <= <a,a> + <b,b>
           (let* ((s (caddr g)) (x (cadr s)) (y (caddr s)))
             (fluid-let ((bg2-v 'v)) (bg2-q-facts! (cadr x)))
             (fluid-let ((bg2-v 'w)) (bg2-q-facts! (cadr y)))
             (dk-ineq! (list 'IN x 'RR) (list 'IN y 'RR) (list '<= 0 x) (list '<= 0 y))))
          ((dk-head-is? g 'IN) (bg2-type! (cadr g) (caddr g)) (dk-close-if-asm!))
          ((and (dk-head-is? g '=) (bg2-lit? (cadr g)) (bg2-lit? (caddr g)))
           (bg2-pair-eq! (cadr g) (caddr g)))
          ((dk-head-is? g '=) (bg2-scalar-close!))
          (#t (error "bg2-close!: unexpected goal" (expression->string g))))))

(define (bg2-peel!)
  (let loop ()
    (if (and (bg2-open?) (memq (dk-head (dk-goal)) '(FORALL IMPLIES))) (begin (di) (loop)))))
(define (bg2-atom-law!)
  (bg2-split-goal-pairs!)
  (bg2-rw!)
  (if (bg2-open?) (bg2-close!)))
(define (bg2-law!)
  (bg2-peel!)
  (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! bg2-atom-law!) (bg2-atom-law!)))

(define bg2-fun-acc
  '((VADD . (hsum-vadd-acc . hsum-vadd-type)) (VNEG . (hsum-vneg-acc . hsum-vneg-type))
    (ACT . (hsum-act-acc . hsum-act-type)) (IP . (hsum-ip-acc . hsum-ip-type))))
(define (bg2-conjunct!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((dk-head-is? g 'IS-RING) (dk-cite! 'commutative-ring-is-ring bg2-R) (dk-close-if-asm!))
          ((and (dk-head-is? g 'IN) (bg2-lit? (cadr g)) (equal? (caddr g) bg2-HV))
           (dk-cite! 'cips-vzero-in 'v) (dk-cite! 'cips-vzero-in 'w)
           (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) (cadr (cadr g)) (caddr (cadr g)))
           (dk-close-if-asm!))
          ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'FUN) (pair? (cadr g))
                (assq (car (cadr g)) bg2-fun-acc))
           (let ((e (cdr (assq (car (cadr g)) bg2-fun-acc))))
             (dk-cite! (cdr e) 'v 'w)
             (subst (dk-cite! (car e) 'v 'w))
             (dk-close-if-asm!)))
          ((memq (dk-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES)) (mac (dk-head g)) (bg2-law!))
          ((dk-head-is? g 'FORALL) (bg2-law!))
          (#t (error "bg2-conjunct!: unexpected conjunct" (expression->string g))))))

;;; ---- THE THEOREM: H (+) K is a complex inner product space -------------------------------
(sp (make-wff (forall-guarded '(v w) bg2-C2 (list 'IS-COMPLEX-INNER-PRODUCT-SPACE bg2-S))))
(dk-peel!)
(bg2-base!)
(dk-have! (list '= (list 'LENGTH bg2-S) 7)
  (lambda () (mac 'HSUM) (len-r) (if (and (bg2-open?) (equal? (dk-goal) '(= 7 7))) (arith))))
;;; the four operations typed BEFORE the unfold: a typing in context certifies the accessor term
(for-each (lambda (acc)
            (let* ((e (cdr (assq acc bg2-fun-acc)))
                   (ty (dk-cite! (cdr e) 'v 'w))
                   (x (bg2-sacc acc)))
              (dk-have! (list 'IN x (caddr ty)) (lambda () (subst (dk-cite! (car e) 'v 'w)) (ass)))))
          '(VADD VNEG ACT IP))
(mac 'IS-COMPLEX-INNER-PRODUCT-SPACE)
(bg2-try "readoffs" (lambda ()
  (subst (dk-cite! 'hsum-scal-acc 'v 'w))
  (subst (dk-cite! 'hsum-vec-acc 'v 'w))
  (subst (dk-cite! 'hsum-vzero-acc 'v 'w))
  (subst (dk-cite! 'sip-cc-ring-carr))
  (subst (dk-cite! 'sip-cc-ring-one))))
(dk-conj-close! (lambda () (let ((g (dk-goal))) (bg2-try (expression->string g) bg2-conjunct!))))
(if (bg2-open?)
    (begin (display "\n;; BG2 OPEN after conjuncts:\n")
           (for-each (lambda (l) (display "   ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves))))
(bg2-qed! 'hsum-is-cips)

;;; ======== b-complete.scm
;;; ---- PART B: H (+) K is complete when H and K are: hsum-is-hilbert ---------------------------
;;; The metric of H (+) K at pairs: d((a,b),(c,d)) = sqrt(|a-c|^2 + |b-d|^2), so each component
;;; distance is <= the pair distance, and the pair distance is <= the sum of the component
;;; distances (sqrt(x + y) <= sqrt x + sqrt y).  A Cauchy sequence of pairs then has Cauchy
;;; components (ms-cauchy-of-dominated); their limits pair to the limit (ms-converges-of-dominated-sum).

(define (bg2-M u) (list 'IP-METRIC-SPACE u))
(define (bg2-dist u x y) (list (list 'DIST (bg2-M u)) x y))
(define (bg2-subu u a b) (list (list 'VADD u) a (list (list 'VNEG u) b)))
(define (bg2-qu u a b) (list (list 'IP u) (bg2-subu u a b) (bg2-subu u a b)))

;;; sqrt(x + y) <= sqrt(x) + sqrt(y) for x, y >= 0
(sp (make-wff (forall-guarded '(x_ y_) '((IN x_ RR) (IN y_ RR) (<= 0 x_) (<= 0 y_))
  '(<= (SQRT (+ x_ y_)) (+ (SQRT x_) (SQRT y_))))))
(dk-peel!)
(bg2-sqrt! 'x_)
(bg2-sqrt! 'y_)
(let* ((sx '(SQRT x_)) (sy '(SQRT y_)) (s (list '+ sx sy)) (ss (list '* s s)))
  (dk-cite! 'rr-add-in-rr 'x_ 'y_)
  (dk-cite! 'rr-add-in-rr sx sy)
  (dk-cite! 'rr-mul-in-rr s s)
  (dk-cite! 'rr-mul-in-rr sx sy)
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN sx 'RR) (list 'IN sy 'RR) (list '<= 0 sx) (list '<= 0 sy))))
  (dk-have! (list '<= 0 (list '* sx sy))
    (lambda () (dk-cite! 'cvx-mul-nonneg sx sy) (dk-close-if-asm!)))
  (dk-have! (list '= ss (list '+ (list '+ (list '* sx sx) (list '* sy sy)) (list '* 2 (list '* sx sy))))
    (lambda () (crs)))
  (dk-have! (list '<= (list '+ 'x_ 'y_) ss)
    (lambda ()
      (subst (list '= ss (list '+ (list '+ (list '* sx sx) (list '* sy sy)) (list '* 2 (list '* sx sy)))))
      (subst (list '= (list '* sx sx) 'x_))
      (subst (list '= (list '* sy sy) 'y_))
      (dk-ineq! '(IN x_ RR) '(IN y_ RR) (list 'IN (list '* sx sy) 'RR) (list '<= 0 (list '* sx sy)))))
  (dk-have! (list '<= 0 (list '+ 'x_ 'y_)) (lambda () (dk-ineq! '(IN x_ RR) '(IN y_ RR) '(<= 0 x_) '(<= 0 y_))))
  (bg2-have-and! (list 'IN (list '+ 'x_ 'y_) 'RR) (list '<= 0 (list '+ 'x_ 'y_)))
  (bg2-have-and! (list 'IN ss 'RR) (list '<= (list '+ 'x_ 'y_) ss))
  (dk-cite! 'sqrt-mono (list '+ 'x_ 'y_) ss)
  (dk-have! (list '<= 0 ss) (lambda () (dk-ineq! (list 'IN ss 'RR) (list '<= (list '+ 'x_ 'y_) ss) (list '<= 0 (list '+ 'x_ 'y_)))))
  (bg2-have-and! (list 'IN ss 'RR) (list '<= 0 ss))
  (bg2-have-and! (list 'IN s 'RR) (list '<= 0 s))
  (dk-have! (list '= ss ss) (lambda () (rfl)))
  (dk-cite! 'sqrt-char ss s)
  (subst (list '= (list '+ sx sy) (list 'SQRT ss)))
  (dk-close-if-asm!))
(bg2-qed! 'rr-sqrt-add-le)

;;; ---- the pair metric ------------------------------------------------------------------------
;;; the strict equation VEC(HSUM v w) = VEC v x VEC w (BA-G1 F3: it certifies the accessor term)
(define (bg2-svec-eq!)
  (let ((g (list '= (list 'VEC bg2-S) bg2-HV)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (dk-cite! 'hsum-vec-acc 'v 'w)) (rfl))))
    g))
;;; land (IN P (VEC S)) for a literal pair P = [a, b]
(define (bg2-in-vecs! p)
  (bg2-typ-pair! p)
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC w) (cadr p) (caddr p))
  (bg2-svec-eq!)
  (let ((g (list 'IN p (list 'VEC bg2-S))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (list 'VEC bg2-S) bg2-HV)) (ass))))
    g))
;;; rewrite in the goal every distance of S at literal pairs and of v, w at their vectors
;;; into sqrt of inner products, then the HSUM operations at pairs
(define (bg2-dist-app? e)
  (and (pair? e) (= (length e) 3) (pair? (car e)) (eq? (car (car e)) 'DIST)
       (dk-head-is? (cadr (car e)) 'IP-METRIC-SPACE)))
(define (bg2-find-dist e)
  (cond ((bg2-dist-app? e) e)
        ((pair? e) (let loop ((l e)) (cond ((not (pair? l)) #f) ((bg2-find-dist (car l)) => (lambda (x) x)) (#t (loop (cdr l))))))
        (#t #f)))
(define (bg2-open-dists!)
  (let loop ((fuel 10))
    (let ((d (and (bg2-open?) (bg2-find-dist (dk-goal)))))
      (if (and d (> fuel 0))
          (let ((u (cadr (cadr (car d)))) (x (cadr d)) (y (caddr d)))
            (if (equal? u bg2-S)
                (begin (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE bg2-S))) (dk-cite! 'hsum-is-cips 'v 'w))
                       (bg2-in-vecs! x) (bg2-in-vecs! y))
                (fluid-let ((bg2-v u)) (bg2-vt! x) (bg2-vt! y)))
            (subst (dk-cite! 'ip-metric-space-dist u x y))
            (loop (- fuel 1))))))
  (bg2-rw!))
;;; Q(x - y) typed in RR, nonnegative, for x, y of space u
(define (bg2-qd-facts! u x y)
  (fluid-let ((bg2-v u)) (bg2-q-facts! (bg2-subu u x y))))
;;; the pair variable split, its projections in the goal renamed too
(define (bg2-split-pair-nth! p)
  (dk-split! (dk-cite! 'cartesian-nth p '(VEC v) '(VEC w)))
  (let* ((pe (dk-cite! 'cartesian-pair-eq p '(VEC v) '(VEC w)))
         (a (dk-name! (list 'NTH 1 p) '(VEC v)))
         (b (dk-name! (list 'NTH 2 p) '(VEC w)))
         (pe1 (dk-rewrite-h! pe (list 'NTH 1 p) a))
         (pe2 (dk-rewrite-h! pe1 (list 'NTH 2 p) b)))
    (bg2-set! a '(VEC v)) (bg2-set! b '(VEC w))
    (if (dk-contains? (dk-goal) (list 'NTH 1 p)) (subst (list '= (list 'NTH 1 p) a)))
    (if (dk-contains? (dk-goal) (list 'NTH 2 p)) (subst (list '= (list 'NTH 2 p) b)))
    (subst (list '= p (list 'LIST a b)))
    (list a b)))
;;; with x in RR, 0 <= x and y in RR, x <= y: sqrt(x) <= sqrt(y)
(define (bg2-sqrt-mono! x y)
  (bg2-have-and! (list 'IN x 'RR) (list '<= 0 x))
  (bg2-have-and! (list 'IN y 'RR) (list '<= x y))
  (dk-cite! 'sqrt-mono x y))

(define bg2-pq-guards (list (list 'IN 'p_ bg2-HV) (list 'IN 'q_ bg2-HV)))
;;; d_v(p1, q1) <= d_S(p, q)  and  d_w(p2, q2) <= d_S(p, q)
(define (bg2-ge-comp! name u k)
  (sp (make-wff (forall-guarded '(v w p_ q_) (append bg2-C2 bg2-pq-guards)
    (list '<= (bg2-dist u (list 'NTH k 'p_) (list 'NTH k 'q_)) (bg2-dist bg2-S 'p_ 'q_)))))
  (dk-peel!)
  (bg2-base!)
  (let* ((ab (bg2-split-pair-nth! 'p_)) (cd (bg2-split-pair-nth! 'q_))
         (a (car ab)) (b (cadr ab)) (c (car cd)) (d (cadr cd)))
    (bg2-open-dists!)
    (bg2-qd-facts! 'v a c) (bg2-qd-facts! 'w b d)
    (let* ((x (bg2-qu 'v a c)) (y (bg2-qu 'w b d)) (xy (list '+ x y)))
      (dk-cite! 'rr-add-in-rr x y)
      (dk-have! (list '<= (if (= k 1) x y) xy) (lambda () (dk-ineq! (list 'IN x 'RR) (list 'IN y 'RR) (list '<= 0 x) (list '<= 0 y))))
      (bg2-sqrt-mono! (if (= k 1) x y) xy)
      (dk-close-if-asm!)))
  (bg2-qed! name))
(bg2-ge-comp! 'hsum-dist-ge-1 'v 1)
(bg2-ge-comp! 'hsum-dist-ge-2 'w 2)

;;; d_S(p, [c, d]) <= d_v(p1, c) + d_w(p2, d)
(sp (make-wff (forall-guarded '(v w p_ c_ d_) (append bg2-C2 (list (list 'IN 'p_ bg2-HV) '(IN c_ (VEC v)) '(IN d_ (VEC w))))
  (list '<= (bg2-dist bg2-S 'p_ '(LIST c_ d_))
            (list '+ (bg2-dist 'v '(NTH 1 p_) 'c_) (bg2-dist 'w '(NTH 2 p_) 'd_))))))
(dk-peel!)
(bg2-base!)
(let* ((ab (bg2-split-pair-nth! 'p_)) (a (car ab)) (b (cadr ab)))
  (bg2-open-dists!)
  (bg2-qd-facts! 'v a 'c_) (bg2-qd-facts! 'w b 'd_)
  (let ((x (bg2-qu 'v a 'c_)) (y (bg2-qu 'w b 'd_)))
    (dk-cite! 'rr-sqrt-add-le x y)
    (dk-close-if-asm!)))
(bg2-qed! 'hsum-dist-le-sum)

;;; ---- THE THEOREM: H (+) K is a Hilbert space when H and K are ---------------------------
;;; (IN X C') from its twin (IN X C) with PTS(M_u) and VEC(u) exchanged
(define (bg2-swap u form)
  (let ((pts (list 'PTS (bg2-M u))) (vec (list 'VEC u)))
    (let walk ((e form)) (cond ((equal? e vec) pts) ((equal? e pts) vec) ((pair? e) (map walk e)) (#t e)))))
(define (bg2-swap! u form)
  (if (not (dk-asm? form))
      (let ((twin (bg2-swap u form)))
        (if (not (dk-asm? twin)) (error "bg2-swap!: twin not in context" (expression->string twin)))
        (dk-have! form
          (lambda ()
            (if (dk-contains? form (list 'PTS (bg2-M u)))
                (subst (list '= (list 'PTS (bg2-M u)) (list 'VEC u)))
                (subst (list '= (list 'VEC u) (list 'PTS (bg2-M u)))))
            (ass)))))
  form)
(define (bg2-ms! u)
  (dk-cite! 'ip-metric-space-is-metric-space u)
  (dk-cite! 'ip-metric-space-pts u))
;;; the component sequence k of f: g(n) == NTH k (f n), g in FUN(NN, VEC u)
(define (bg2-comp-seq! f k u)
  (dk-abstract! 'NN (list 'VEC u) (lambda (n) (list 'NTH k (list f n)))
    (lambda (n)
      (dk-cite! 'fun-apply-type-c f 'NN bg2-HV n)
      (dk-split! (dk-cite! 'cartesian-nth (list f n) '(VEC v) '(VEC w)))
      (dk-close-if-asm!))))

(sp (make-wff (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
  (list 'IS-HILBERT-SPACE bg2-S))))
(dk-peel!)
(bg2-iff-fwd! 'is-hilbert-space 'v)
(bg2-iff-fwd! 'is-hilbert-space 'w)
(bg2-base!)
(dk-cite! 'hsum-is-cips 'v 'w)
(bg2-ms! 'v) (bg2-ms! 'w) (bg2-ms! bg2-S)
(bg2-svec-eq!)
(let* ((ms (bg2-M bg2-S)) (mv (bg2-M 'v)) (mw (bg2-M 'w)))
  (bg2-iff-fwd! 'is-complete mv)
  (bg2-iff-fwd! 'is-complete mw)
  (let ((cmpv (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CAUCHY-SEQ) (dk-contains? x mv))) "completeness of v"))
        (cmpw (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CAUCHY-SEQ) (dk-contains? x mw))) "completeness of w")))
    (dk-have! (list 'FORALL 'bgf_ (list 'IMPLIES (list 'IS-CAUCHY-SEQ ms 'bgf_) (list 'CONVERGES ms 'bgf_)))
      (lambda ()
        (let* ((lk (dk-peel!))
               (f (caddr (find-first (dk-head? 'IS-CAUCHY-SEQ) lk)))
               (ft (dk-cite! 'cauchy-seq-is-fun ms f))
               (ft2 (dk-rewrite-h! ft (list 'PTS ms) (list 'VEC bg2-S)))
               (ft3 (dk-rewrite-h! ft2 (list 'VEC bg2-S) bg2-HV))
               (g1v (bg2-comp-seq! f 1 'v)) (g1 (car g1v)) (ve1 (cdr g1v))
               (g2v (bg2-comp-seq! f 2 'w)) (g2 (car g2v)) (ve2 (cdr g2v)))
          (bg2-swap! 'v (list 'IN g1 (list 'FUN 'NN (list 'PTS mv))))
          (bg2-swap! 'w (list 'IN g2 (list 'FUN 'NN (list 'PTS mw))))
          ;; the components are dominated by the pair distance, hence Cauchy, hence convergent
          (for-each
            (lambda (g ve u mu k thm cmp)
              (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                          (list '<= (list (list 'DIST mu) (list g 'm) (list g 'n_)) (list (list 'DIST ms) (list f 'm) (list f 'n_)))))))
                (lambda ()
                  (let* ((lk2 (dk-peel!))
                         (ks (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk2))))
                    (for-each (lambda (j) (dk-cite! 'fun-apply-type-c f 'NN bg2-HV j)
                                          (subst (dk-apply! ve j)))
                              ks)
                    (let ((rhs (caddr (dk-goal))))
                      (dk-cite! thm 'v 'w (cadr rhs) (caddr rhs)))
                    (dk-close-if-asm!))))
              (dk-cite! 'ms-cauchy-of-dominated ms mu f g)
              (dk-apply! cmp g))
            (list g1 g2) (list ve1 ve2) '(v w) (list mv mw) '(1 2) '(hsum-dist-ge-1 hsum-dist-ge-2) (list cmpv cmpw))
          (let* ((c1 (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES mv g1))))))
                 (l1 (dk-skolem! c1))
                 (c2 (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES mw g2))))))
                 (l2 (dk-skolem! c2))
                 (l (list 'LIST l1 l2)))
            (bg2-iff-fwd! 'converges-to mv g1 l1)
            (bg2-iff-fwd! 'converges-to mw g2 l2)
            (bg2-swap! 'v (list 'IN l1 '(VEC v)))
            (bg2-swap! 'w (list 'IN l2 '(VEC w)))
            (bg2-set! l1 '(VEC v)) (bg2-set! l2 '(VEC w))
            (bg2-in-vecs! l)
            (dk-have! (list 'IN l (list 'PTS ms)) (lambda () (subst (list '= (list 'PTS ms) (list 'VEC bg2-S))) (ass)))
            (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                        (list '<= (list (list 'DIST ms) (list f 'n_) l)
                              (list '+ (list (list 'DIST mv) (list g1 'n_) l1) (list (list 'DIST mw) (list g2 'n_) l2)))))
              (lambda ()
                (let ((j (dk-di-var!)))
                  (dk-cite! 'fun-apply-type-c f 'NN bg2-HV j)
                  (subst (dk-apply! ve1 j))
                  (subst (dk-apply! ve2 j))
                  (dk-cite! 'hsum-dist-le-sum 'v 'w (list f j) l1 l2)
                  (dk-close-if-asm!))))
            (dk-cite! 'ms-converges-of-dominated-sum ms mv mw f g1 g2 l l1 l2)
            (mac 'converges)
            (ew l)
            (dk-close-if-asm!)))))
    (bg2-iff-bwd! 'is-complete ms)
    (bg2-iff-bwd! 'is-hilbert-space bg2-S)
    (dk-close-if-asm!)))
(bg2-qed! 'hsum-is-hilbert)

;;; ======== c-graphs.scm
;;; ---- PART C: Proposition 3.4 without the extra hypothesis; 3.4 (2), (3); Corollary 3.5 ---------
(set! bg2-v 'v)
(define bg2-HL '((IS-HILBERT-SPACE v) (IS-LINEAR-GRAPH v gg)))
(define bg2-SUBG '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET gg (CARTESIAN (VEC v) (VEC v)))))
(define (bg2-adj g) (list 'GRAPH-ADJOINT 'v g))
(define (bg2-inv g) (list 'GRAPH-INVERSE 'v g))
(define (bg2-dom g) (list 'GRAPH-DOM 'v g))
(define (bg2-ran g) (list 'GRAPH-RAN 'v g))
(define bg2-Mv '(IP-METRIC-SPACE v))
(define bg2-Z '(VZERO v))

;;; the common facts of a subset gg of H x H: sets, the strict VEC equation, the adjoint's typings
(define (bg2-subg-facts! g)
  (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'hsum-is-set 'v 'v)
  (dk-cite! 'hsum-is-cips 'v 'v)
  (bg2-hsum-vec-eq!)
  (bg2-cart-set!)
  (dk-cite! 'cips-vzero-in 'v)
  (bg2-set! bg2-Z '(VEC v)))

;;; ---- 3.4 (1): the closure of a linear graph is G**, H a Hilbert space ----------------------
(sp (make-wff (forall-guarded '(v gg) bg2-HL (list '= '(GRAPH-CLOSURE v gg) (bg2-adj (bg2-adj 'gg))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'hsum-is-hilbert 'v 'v)
(dk-cite! 'graph-closure-is-double-adjoint 'v 'gg)
(dk-close-if-asm!)
(bg2-qed! 'graph-closure-double-adjoint)

;;; ---- G* is linear and closed (it is a perp in H (+) H) -------------------------------------
(define (bg2-adj-perp-fact! name pred perp-thm body)
  (sp (make-wff (forall-guarded '(v gg) bg2-SUBG (list pred 'v (bg2-adj 'gg)))))
  (dk-peel!)
  (bg2-subg-facts! 'gg)
  (dk-cite! 'graph-j-subset 'v 'gg)
  (dk-cite! 'graph-j-is-set 'v 'gg)
  (dk-cite! 'graph-adjoint-is-set 'v 'gg)
  (dk-cite! 'hsum-perp-is-set 'v (bg2-j 'gg))
  (dk-have! (list 'SUBSET (bg2-j 'gg) '(VEC (HSUM v v)))
    (lambda () (subst (list '= '(VEC (HSUM v v)) bg2-HH)) (ass)))
  (dk-cite! perp-thm bg2-H (bg2-j 'gg))
  (let ((e (dk-cite! 'graph-adjoint-perp-j 'v 'gg)))
    (dk-have! body (lambda () (subst e) (ass))))
  (bg2-iff-bwd! (if (eq? pred 'IS-LINEAR-GRAPH) 'is-linear-graph 'is-closed-graph) 'v (bg2-adj 'gg))
  (bg2-done-ass!)
  (bg2-qed! name))
(bg2-adj-perp-fact! 'graph-adjoint-linear 'IS-LINEAR-GRAPH 'perp-is-submodule
  (list 'IS-SUBMODULE bg2-H (bg2-adj 'gg)))
(bg2-adj-perp-fact! 'graph-adjoint-closed 'IS-CLOSED-GRAPH 'perp-is-closed
  (list 'IS-CLOSED (list 'IP-METRIC-SPACE bg2-H) (bg2-adj 'gg)))

;;; ---- small graph tools ----------------------------------------------------------------------
(define (bg2-concl gl) (if (dk-head-is? gl 'IMPLIES) (caddr gl) gl))
(define (bg2-intro!) (if (and (bg2-open?) (dk-head-is? (dk-goal) 'IMPLIES)) (di)))
;;; [0, 0] in a linear graph g
(define (bg2-zero-pair! g)
  (let ((goal (list 'IN (bg2-pr bg2-Z bg2-Z) g)))
    (if (not (dk-asm? goal))
        (let ((r (dk-cite! 'submodule-vzero-in bg2-H g)))
          (dk-cite! 'hsum-vzero-acc 'v 'v)
          (dk-rewrite-h! r '(VZERO (HSUM v v)) (bg2-pr bg2-Z bg2-Z))))
    goal))
;;; [-a, -b] in a linear graph g, from [a, b] in g
(define (bg2-lin-neg-in! g a b)
  (bg2-vt! (bg2-neg a)) (bg2-vt! (bg2-neg b))
  (let* ((r (dk-cite! 'submodule-vneg-closed bg2-H g (bg2-pr a b)))
         (eq (dk-cite! 'hsum-vneg-pair 'v 'v a b)))
    (dk-rewrite-h! r (cadr eq) (caddr eq))))
;;; k in dom g from [k, d] in g
(define (bg2-dom-in! g k d)
  (let ((goal (list 'IN k (bg2-dom g))))
    (if (not (dk-asm? goal))
        (begin
          (bg2-vt! k) (bg2-vt! d)
          (dk-have! goal
            (lambda ()
              (subst (dk-cite! 'graph-dom-unfold 'v g))
              (in-sep! (lambda () (ass)) (lambda () (ew d) (dk-conj-close! dk-ass!)))))))
    goal))
(define (bg2-ran-in! g d k)
  (let ((goal (list 'IN k (bg2-ran g))))
    (if (not (dk-asm? goal))
        (begin
          (bg2-vt! k) (bg2-vt! d)
          (dk-have! goal
            (lambda ()
              (subst (dk-cite! 'graph-ran-unfold 'v g))
              (in-sep! (lambda () (ass)) (lambda () (ew d) (dk-conj-close! dk-ass!)))))))
    goal))
;;; k in dom g (or ran g) in context: a partner d with [k, d] in g (or [d, k] in g); returns d
(define (bg2-partner-of! which g k)
  (let* ((fun (if (eq? which 'dom) (bg2-dom g) (bg2-ran g)))
         (eqn (dk-cite! (if (eq? which 'dom) 'graph-dom-unfold 'graph-ran-unfold) 'v g))
         (m (dk-rewrite-h! (list 'IN k fun) fun (caddr eqn)))
         (ls (dk-landed (lambda () (sep-me m))))
         (ex (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls))))
    (let ((d (dk-skolem! ex)))
      (bg2-set! d '(VEC v))
      d)))
;;; with x + (-y) = 0 in context, land x = y
(define (bg2-eq-of-diff-zero! x y)
  (bg2-vt! x) (bg2-vt! y)
  (dk-have! (list '= (bg2-qd x y) 0)
    (lambda ()
      (subst (list '= (bg2-sub x y) bg2-Z))
      (dk-cite! 'cips-ip-zero-left 'v bg2-Z)
      (dk-close-if-asm!)))
  (dk-cite! 'cips-eq-of-dist-sq-zero 'v x y))
(define (bg2-conj0!) (dk-have! '(= (conjugate 0) 0) (lambda () (arith))))

;;; ---- a linear graph is functional iff [0, y] in G forces y = 0 ------------------------------
(define (bg2-zero-fiber g)
  (list 'FORALL 'bgy_ (list 'IMPLIES '(IN bgy_ (VEC v))
    (list 'IMPLIES (list 'IN (list 'LIST bg2-Z 'bgy_) g) (list '= 'bgy_ bg2-Z)))))
(sp (make-wff (forall-guarded '(v gg) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-LINEAR-GRAPH v gg))
  (list 'IFF '(IS-FUNCTIONAL-GRAPH v gg) (bg2-zero-fiber 'gg)))))
(dk-peel!)
(bg2-lin-facts-of! 'gg)
(dk-cite! 'cips-vzero-in 'v)
(bg2-set! bg2-Z '(VEC v))
(bg2-zero-pair! 'gg)
(let ((fi (dk-cite! 'is-functional-graph 'v 'gg)))
  (dk-iff! (lambda (gl) (dk-head-is? (bg2-concl gl) 'FORALL))
    (lambda ()
      (bg2-intro!)
      (let ((rf (bg2-iff->! fi)))
        (let* ((lk (dk-peel!))
               (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC v)))) lk))))
          (bg2-set! y '(VEC v))
          (dk-apply! (dk-ctx-form rf) bg2-Z y bg2-Z)
          (bg2-done-ass!))))
    (lambda ()
      (bg2-intro!)
      (let ((h0 (dk-ctx-form (bg2-zero-fiber 'gg))))
        (dk-have! (caddr fi)
          (lambda ()
            (let* ((lk (dk-peel!))
                   (ms (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'LIST))) lk))
                   (x (cadr (cadr (car ms)))) (y (cadr (dk-goal))) (z (caddr (dk-goal))))
              (for-each (lambda (t) (bg2-vt! t) (bg2-set! t '(VEC v))) (list x y z))
              (bg2-lin-neg-in! 'gg x z)
              (let* ((nx (bg2-neg x)) (nz (bg2-neg z))
                     (r (bg2-lin-add-in! 'gg x y nx nz)))
                (bg2-vt! (bg2-add x nx)) (bg2-vt! (bg2-add y nz))
                (bg2-vec-eq! (bg2-add x nx) bg2-Z)
                (dk-rewrite-h! r (bg2-add x nx) bg2-Z)
                (bg2-set! (bg2-add y nz) '(VEC v))
                (dk-apply! h0 (bg2-add y nz))
                (bg2-eq-of-diff-zero! y z)
                (bg2-done-ass!)))))
        (bg2-iff<-! fi)
        (bg2-done-ass!)))))
(bg2-qed! 'linear-graph-functional-iff)

;;; ---- [0, y] in G* iff y is orthogonal to dom G ---------------------------------------------
(sp (make-wff (forall-guarded '(v gg y_) (append bg2-SUBG '((IN y_ (VEC v))))
  (list 'IFF (list 'IN (list 'LIST bg2-Z 'y_) (bg2-adj 'gg)) (list 'IN 'y_ (list 'PERP 'v (bg2-dom 'gg)))))))
(dk-peel!)
(bg2-subg-facts! 'gg)
(bg2-set! 'y_ '(VEC v))
(let* ((i1 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg bg2-Z 'y_))
      (i2 (dk-cite! 'perp-membership 'v (bg2-dom 'gg) 'y_)))
  (bg2-conj0!)
  (dk-iff! (lambda (gl) (dk-head-is? (caddr (bg2-concl gl)) 'PERP))
    (lambda ()
      (bg2-intro!)
      (let ((a (bg2-iff->! i1)))
        (dk-have! (caddr i2)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((lk (dk-peel!)) (k (cadr (car lk))))
                      (let ((d (bg2-partner-of! 'dom 'gg k)))
                        (bg2-set! k '(VEC v))
                        (dk-apply! (dk-ctx-form a) k d)
                        (subst (dk-cite! 'cips-ip-conj-sym 'v k 'y_))
                        (subst (list '= (bg2-ip k 'y_) (bg2-ip d bg2-Z)))
                        (subst (dk-cite! 'cips-ip-zero-right 'v d))
                        (bg2-done-ass!))))))))
        (bg2-iff<-! i2)
        (bg2-done-ass!)))
    (lambda ()
      (bg2-intro!)
      (let ((b (bg2-iff->! i2)))
        (dk-split! b)
        (let ((bf (caddr b)))
          (dk-have! (caddr i1)
            (lambda ()
              (let* ((cd (bg2-peel-new! 'gg)) (c (car cd)) (d (cadr cd)))
                (bg2-dom-in! 'gg c d)
                (dk-apply! (dk-ctx-form bf) c)
                (subst (dk-cite! 'cips-ip-zero-right 'v d))
                (subst (dk-cite! 'cips-ip-conj-sym 'v 'y_ c))
                (subst (list '= (bg2-ip 'y_ c) 0))
                (bg2-done-ass!))))
          (bg2-iff<-! i1)
          (bg2-done-ass!))))))
(bg2-qed! 'graph-adjoint-zero-pair-iff)

;;; ---- a subspace of a Hilbert space is dense iff its perp is {0} -----------------------------
(define bg2-P0 '(FORALL hpz_ (IMPLIES (IN hpz_ (PERP v kk)) (= hpz_ (VZERO v)))))
(sp (make-wff (forall-guarded '(v kk) '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk))
  (list 'IFF (list 'IS-DENSE bg2-Mv 'kk) bg2-P0))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(bg2-ms! 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'closure-in-carrier bg2-Mv 'kk)
(let* ((cl (list 'CLOSURE bg2-Mv 'kk)) (pts (list 'PTS bg2-Mv))
       (hd (dk-cite! 'hilbert-dense-iff-perp-zero 'v 'kk))
       (id (dk-cite! 'is-dense bg2-Mv 'kk)))
  (dk-iff! (lambda (gl) (dk-head-is? (bg2-concl gl) 'FORALL))
    (lambda ()
      (bg2-intro!)
      (dk-split-all! (list (bg2-iff->! id)))
      (dk-have! (list 'FORALL 'bgx_ (list 'IFF (list 'IN 'bgx_ cl) '(IN bgx_ (VEC v))))
        (lambda ()
          (dk-peel!)
          (let ((x (cadr (cadr (dk-goal)))))
            (dk-iff! (lambda (gl) (equal? (bg2-concl gl) (list 'IN x '(VEC v))))
              (lambda () (bg2-intro!)
                (dk-cite! 'subset-mem-fwd cl pts x)
                (bg2-swap! 'v (list 'IN x '(VEC v))) (bg2-done-ass!))
              (lambda () (bg2-intro!)
                (bg2-swap! 'v (list 'IN x pts))
                (dk-cite! 'subset-mem-fwd pts cl x) (bg2-done-ass!))))))
      (dk-cite! 'class-extensionality cl '(VEC v))
      (bg2-iff->! hd)
      (bg2-done-ass!))
    (lambda ()
      (bg2-intro!)
      (bg2-iff<-! hd)
      (dk-have! (caddr id)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-asm? g) (ass))
                      ((equal? (caddr g) cl)
                       (subst (list '= cl '(VEC v))) (subst (list '= pts '(VEC v)))
                       (dk-cite! 'subset-refl '(VEC v)) (bg2-done-ass!))
                      (#t (subst (list '= pts '(VEC v))) (bg2-done-ass!))))))))
      (bg2-iff<-! id)
      (bg2-done-ass!))))
(bg2-qed! 'hilbert-dense-iff-perp-trivial)

;;; ---- the domain (and range) of a linear graph is a subspace ---------------------------------
(define (bg2-scal-to-cc! r)
  (if (not (dk-asm? (list 'IN r 'CC)))
      (begin (dk-cite! 'cips-scal-carrier 'v)
             (dk-rewrite-h! (list 'IN r '(CARR (SCAL v))) '(CARR (SCAL v)) 'CC))))
(define (bg2-sub-conjunct! which)
  (let* ((in! (if (eq? which 'dom) bg2-dom-in! (lambda (g k d) (bg2-ran-in! g d k))))
         (fun (if (eq? which 'dom) (bg2-dom 'gg) (bg2-ran 'gg)))
         ;; a pair with K in the slot WHICH and D in the other
         (pr (lambda (k d) (if (eq? which 'dom) (bg2-pr k d) (bg2-pr d k)))))
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def) (bg2-refl-leaves!)
               (let* ((lk (dk-peel!)) (k (cadr (car lk))))
                 (bg2-partner-of! which 'gg k)
                 (bg2-done-ass!)))
              ((dk-head-is? g 'IN)
               (bg2-zero-pair! 'gg) (in! 'gg bg2-Z bg2-Z) (bg2-done-ass!))
              ((dk-contains? g '(VADD v))
               (let* ((lk (dk-peel!)) (ks (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) fun))) lk)))
                      (x (car ks)) (y (cadr ks))
                      (dx (bg2-partner-of! which 'gg x)) (dy (bg2-partner-of! which 'gg y)))
                 (bg2-set! x '(VEC v)) (bg2-set! y '(VEC v))
                 (if (eq? which 'dom) (bg2-lin-add-in! 'gg x dx y dy) (bg2-lin-add-in! 'gg dx x dy y))
                 (in! 'gg (bg2-add x y) (bg2-add dx dy))
                 (bg2-done-ass!)))
              ((dk-contains? g '(VNEG v))
               (let* ((lk (dk-peel!)) (x (cadr (car lk))) (dx (bg2-partner-of! which 'gg x)))
                 (bg2-set! x '(VEC v))
                 (if (eq? which 'dom) (bg2-lin-neg-in! 'gg x dx) (bg2-lin-neg-in! 'gg dx x))
                 (in! 'gg (bg2-neg x) (bg2-neg dx))
                 (bg2-done-ass!)))
              ((dk-contains? g '(ACT v))
               (let* ((lk (dk-peel!))
                      (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL v))))) lk)))
                      (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) fun))) lk))))
                 (bg2-scal-to-cc! r)
                 (let ((dx (bg2-partner-of! which 'gg x)))
                   (bg2-set! x '(VEC v))
                   (bg2-vt! (bg2-act r x)) (bg2-vt! (bg2-act r dx))
                   (if (eq? which 'dom) (bg2-lin-act-in! 'gg r x dx) (bg2-lin-act-in! 'gg r dx x))
                   (in! 'gg (bg2-act r x) (bg2-act r dx))
                   (bg2-done-ass!))))
              (#t (error "bg2-sub-conjunct!: unexpected" (expression->string g))))))))
(define (bg2-dom-ran-sub! name which)
  (let ((fun (if (eq? which 'dom) (bg2-dom 'gg) (bg2-ran 'gg))))
    (sp (make-wff (forall-guarded '(v gg) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-LINEAR-GRAPH v gg))
      (list 'IS-SUBMODULE 'v fun))))
    (dk-peel!)
    (bg2-lin-facts-of! 'gg)
    (dk-cite! 'cips-vzero-in 'v)
    (bg2-set! bg2-Z '(VEC v))
    (let ((iff (dk-cite! 'is-submodule 'v fun)))
      (dk-have! (caddr iff) (lambda () (dk-conj-close! (bg2-sub-conjunct! which))))
      (bg2-iff<-! iff))
    (bg2-done-ass!)
    (bg2-qed! name)))
(bg2-dom-ran-sub! 'graph-dom-submodule 'dom)
(bg2-dom-ran-sub! 'graph-ran-submodule 'ran)

;;; ---- Proposition 3.4 (2): G* is functional iff G has dense domain --------------------------
(define (bg2-chain-iff! f a b d i1 iab i3)
  ;; i1: F iff A, iab: A iff B, i3: D iff B; goal F iff D
  (dk-iff! (lambda (gl) (alpha-equiv? (bg2-concl gl) d))
    (lambda () (bg2-intro!) (bg2-iff->! i1) (bg2-iff->! iab) (bg2-iff<-! i3) (bg2-done-ass!))
    (lambda () (bg2-intro!) (bg2-iff->! i3) (bg2-iff<-! iab) (bg2-iff<-! i1) (bg2-done-ass!))))
(sp (make-wff (forall-guarded '(v gg) bg2-HL
  (list 'IFF (list 'IS-FUNCTIONAL-GRAPH 'v (bg2-adj 'gg)) (list 'IS-DENSE bg2-Mv (bg2-dom 'gg))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(bg2-lin-facts-of! 'gg)
(dk-cite! 'cips-vzero-in 'v)
(bg2-set! bg2-Z '(VEC v))
(dk-cite! 'graph-adjoint-linear 'v 'gg)
(dk-cite! 'graph-dom-submodule 'v 'gg)
(dk-cite! 'perp-subset 'v (bg2-dom 'gg))
(let* ((i1 (dk-cite! 'linear-graph-functional-iff 'v (bg2-adj 'gg)))
       (i3 (dk-cite! 'hilbert-dense-iff-perp-trivial 'v (bg2-dom 'gg)))
       (a (caddr i1)) (b (caddr i3))
       (iab (list 'IFF a b)))
  (dk-have! iab
    (lambda ()
      (dk-iff! (lambda (gl) (alpha-equiv? (bg2-concl gl) b))
        (lambda ()
          (bg2-intro!)
          (let* ((lk (dk-peel!)) (z (cadr (car lk))))
            (dk-cite! 'subset-mem-fwd (list 'PERP 'v (bg2-dom 'gg)) '(VEC v) z)
            (bg2-set! z '(VEC v))
            (bg2-iff<-! (dk-cite! 'graph-adjoint-zero-pair-iff 'v 'gg z))
            (dk-apply! (dk-ctx-form a) z)
            (bg2-done-ass!)))
        (lambda ()
          (bg2-intro!)
          (let* ((lk (dk-peel!))
                 (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC v)))) lk))))
            (bg2-set! y '(VEC v))
            (bg2-iff->! (dk-cite! 'graph-adjoint-zero-pair-iff 'v 'gg y))
            (dk-apply! (dk-ctx-form b) y)
            (bg2-done-ass!))))))
  (bg2-chain-iff! (cadr i1) a b (cadr i3) i1 iab i3))
(bg2-qed! 'graph-adjoint-functional-iff-dense)

;;; ---- Proposition 3.4 (3): G is closable iff G* has dense domain ----------------------------
(sp (make-wff (forall-guarded '(v gg) bg2-HL
  (list 'IFF '(IS-CLOSABLE-GRAPH v gg) (list 'IS-DENSE bg2-Mv (bg2-dom (bg2-adj 'gg)))))))
