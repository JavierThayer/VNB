;;; ======== e-cayley.scm
;;; ---- F4: the Cayley transform of a linear graph is linear -----------------------------------
;;; [u1, u2] in C(G)  iff  [x(u1, u2), y(u1, u2)] in G  (cayley-pair-iff, BA-G1); the inverse
;;; formulas x, y are linear in (u1, u2), so the closure laws of G transfer to C(G).
(define bg2-CGg '(CAYLEY-GRAPH v gg))
;;; [a, b] in C(G) in context: land [x(a, b), y(a, b)] in G and return that pair
(define (bg2-cy-in! a b)
  (bg2-pre-type! a b)
  (bg2-iff->! (dk-cite! 'cayley-pair-iff 'v 'gg a b))
  (list (bg2-cx a b) (bg2-cyy a b)))
;;; [x, y] in G in context, x = x(s1, s2) and y = y(s1, s2) as vectors: land [s1, s2] in C(G)
(define (bg2-cy-close! s1 s2 x y)
  (bg2-vt! s1) (bg2-vt! s2) (bg2-set! s1 '(VEC v)) (bg2-set! s2 '(VEC v))
  (bg2-pre-type! s1 s2)
  (let* ((cx (bg2-cx s1 s2)) (cy (bg2-cyy s1 s2))
         (h0 (list 'IN (bg2-pr x y) 'gg)))
    (bg2-vec-eq! cx x)
    (bg2-vec-eq! cy y)
    (let ((tgt (list 'IN (bg2-pr cx cy) 'gg)))
      (if (not (dk-asm? tgt))
          (dk-have! tgt
            (lambda ()
              (if (not (equal? cx x)) (subst (list '= cx x)))
              (if (not (equal? cy y)) (subst (list '= cy y)))
              (bg2-done-ass!)))))
    (bg2-iff<-! (dk-cite! 'cayley-pair-iff 'v 'gg s1 s2))))
(define (bg2-cy-elt! lk)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) bg2-CGg))) lk)))
(define (bg2-cy-conjunct!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((dk-head-is? g 'SUBSET)
           (subst (list '= '(VEC (HSUM v v)) bg2-HH)) (bg2-done-ass!))
          ((dk-contains? g '(VADD (HSUM v v)))
           (let* ((lk (dk-peel!)) (ps (bg2-cy-elt! lk))
                  (ab (bg2-split-in! (car ps) bg2-CGg)) (cd (bg2-split-in! (cadr ps) bg2-CGg))
                  (a (car ab)) (b (cadr ab)) (c (car cd)) (d (cadr cd)))
             (subst (dk-cite! 'hsum-vadd-pair 'v 'v a b c d))
             (let* ((x1 (bg2-cy-in! a b)) (x2 (bg2-cy-in! c d)))
               (bg2-lin-add-in! 'gg (car x1) (cadr x1) (car x2) (cadr x2))
               (bg2-cy-close! (bg2-add a c) (bg2-add b d)
                              (bg2-add (car x1) (car x2)) (bg2-add (cadr x1) (cadr x2))))
             (bg2-done-ass!)))
          ((dk-contains? g '(VNEG (HSUM v v)))
           (let* ((lk (dk-peel!)) (ps (bg2-cy-elt! lk))
                  (ab (bg2-split-in! (car ps) bg2-CGg)) (a (car ab)) (b (cadr ab)))
             (subst (dk-cite! 'hsum-vneg-pair 'v 'v a b))
             (let ((x1 (bg2-cy-in! a b)))
               (bg2-lin-neg-in! 'gg (car x1) (cadr x1))
               (bg2-cy-close! (bg2-neg a) (bg2-neg b) (bg2-neg (car x1)) (bg2-neg (cadr x1))))
             (bg2-done-ass!)))
          ((dk-contains? g '(ACT (HSUM v v)))
           (let* ((lk (dk-peel!))
                  (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL (HSUM v v)))))) lk)))
                  (ps (bg2-cy-elt! lk))
                  (ab (bg2-split-in! (car ps) bg2-CGg)) (a (car ab)) (b (cadr ab)))
             (let* ((e1 (dk-cite! 'hsum-scal-acc 'v 'v))
                    (e2 (dk-cite! 'sip-cc-ring-carr))
                    (h1 (dk-rewrite-h! (list 'IN r '(CARR (SCAL (HSUM v v)))) (cadr e1) (caddr e1))))
               (dk-rewrite-h! h1 (cadr e2) (caddr e2)))
             (subst (dk-cite! 'hsum-act-pair 'v 'v r a b))
             (let ((x1 (bg2-cy-in! a b)))
               (bg2-vt! (bg2-act r (car x1))) (bg2-vt! (bg2-act r (cadr x1)))
               (bg2-lin-act-in! 'gg r (car x1) (cadr x1))
               (bg2-cy-close! (bg2-act r a) (bg2-act r b) (bg2-act r (car x1)) (bg2-act r (cadr x1))))
             (bg2-done-ass!)))
          ((dk-head-is? g 'IN)
           (subst (dk-cite! 'hsum-vzero-acc 'v 'v))
           (bg2-zero-pair! 'gg)
           (bg2-cy-close! bg2-Z bg2-Z bg2-Z bg2-Z)
           (bg2-done-ass!))
          (#t (error "bg2-cy-conjunct!: unexpected" (expression->string g))))))
(sp (make-wff (forall-guarded '(v gg) (append bg2-CV '((IS-LINEAR-GRAPH v gg)))
  (list 'IS-LINEAR-GRAPH 'v bg2-CGg))))
(dk-peel!)
(bg2-lin-facts-of! 'gg)
(dk-cite! 'hsum-is-cips 'v 'v)
(dk-cite! 'cips-vzero-in 'v)
(bg2-set! bg2-Z '(VEC v))
(dk-cite! 'cayley-graph-subset 'v 'gg)
(mac 'is-linear-graph)
(let ((iff (dk-cite! 'is-submodule '(HSUM v v) bg2-CGg)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! bg2-cy-conjunct!)))
  (bg2-iff<-! iff))
(bg2-done-ass!)
(bg2-qed! 'cayley-graph-linear)

;;; ======== f-converse.scm
;;; ---- toward the converse of 3.12: G self-adjoint => C(G) unitary ---------------------------
(define (bg2-fin!)
  (cond ((not (bg2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        (#t (if (dk-contains? (dk-goal) '(conjugate 0)) (subst '(= (conjugate 0) 0)))
            (if (bg2-open?) (dk-close-if! (lambda () #t) (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))

;;; [y, 0] in G* iff y is orthogonal to ran G
(sp (make-wff (forall-guarded '(v gg y_) (append bg2-SUBG '((IN y_ (VEC v))))
  (list 'IFF (list 'IN (list 'LIST 'y_ bg2-Z) (bg2-adj 'gg)) (list 'IN 'y_ (list 'PERP 'v (bg2-ran 'gg)))))))
(dk-peel!)
(bg2-subg-facts! 'gg)
(bg2-set! 'y_ '(VEC v))
(let* ((i1 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg 'y_ bg2-Z))
      (i2 (dk-cite! 'perp-membership 'v (bg2-ran 'gg) 'y_)))
  (bg2-conj0!)
  (dk-iff! (lambda (gl) (dk-head-is? (caddr (bg2-concl gl)) 'PERP))
    (lambda ()
      (bg2-intro!)
      (let ((a (bg2-iff->! i1)))
        (dk-have! (caddr i2)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((lk (dk-peel!)) (k (cadr (car lk))))
                      (let ((d (bg2-partner-of! 'ran 'gg k)))
                        (bg2-set! k '(VEC v))
                        (dk-apply! (dk-ctx-form a) d k)
                        (subst (dk-cite! 'cips-ip-conj-sym 'v k 'y_))
                        (subst (list '= (bg2-ip k 'y_) (bg2-ip d bg2-Z)))
                        (subst (dk-cite! 'cips-ip-zero-right 'v d))
                        (bg2-fin!))))))))
        (bg2-iff<-! i2)
        (bg2-done-ass!)))
    (lambda ()
      (bg2-intro!)
      (let ((b (bg2-iff->! i2)))
        (dk-split! b)
        (let ((bf (caddr b)))
          (dk-have! (caddr i1)
            (lambda ()
              (let* ((cd (bg2-peel-new! 'gg)) (c (car cd)) (d (cadr cd)))
                (bg2-ran-in! 'gg c d)
                (dk-apply! (dk-ctx-form bf) d)
                (subst (dk-cite! 'cips-ip-zero-right 'v c))
                (subst (dk-cite! 'cips-ip-conj-sym 'v 'y_ d))
                (subst (list '= (bg2-ip 'y_ d) 0))
                (bg2-fin!))))
          (bg2-iff<-! i1)
          (bg2-done-ass!))))))
(bg2-qed! 'graph-adjoint-zero-pair-ran-iff)

;;; G self-adjoint: C(G)* = C(G)^-1
(define bg2-SA (append bg2-SUBG '((IS-SELF-ADJOINT-GRAPH v gg))))
(define bg2-CGa (list 'GRAPH-ADJOINT 'v bg2-CGg))
(define bg2-CGi (list 'GRAPH-INVERSE 'v bg2-CGg))
(define (bg2-sa-eq!)
  (let ((e (list '= (bg2-adj 'gg) 'gg)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (mac-h 'is-self-adjoint-graph '(IS-SELF-ADJOINT-GRAPH v gg)) (ass))))
    e))
(sp (make-wff (forall-guarded '(v gg) bg2-SA (list '= bg2-CGa bg2-CGi))))
(dk-peel!)
(bg2-subg-facts! 'gg)
(dk-cite! 'cayley-graph-subset 'v 'gg)
(dk-cite! 'graph-adjoint-subset 'v bg2-CGg)
(dk-cite! 'graph-adjoint-is-set 'v bg2-CGg)
(bg2-sa-eq!)
(let* ((e1 (dk-cite! 'cayley-of-adjoint 'v 'gg))
       (e2 (dk-rewrite-h! e1 (bg2-adj 'gg) 'gg))
       (e3 (dk-cite! 'graph-inverse-involutive 'v bg2-CGa))
       (e4 (dk-congr! e2 (lambda (x) (list 'GRAPH-INVERSE 'v x)))))
  (subst (list '= bg2-CGi (list 'GRAPH-INVERSE 'v (caddr e2))))
  (subst e3)
  (bg2-fin!))
(bg2-qed! 'cayley-adjoint-of-self-adjoint)

;;; G self-adjoint, H Hilbert: C(G) has dense domain and dense range
(define bg2-HSA (append '((IS-HILBERT-SPACE v)) (cdr bg2-SUBG) '((IS-SELF-ADJOINT-GRAPH v gg))))
(define (bg2-sa-base!)
  (dk-peel!)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (bg2-subg-facts! 'gg)
  (dk-cite! 'cayley-graph-subset 'v 'gg)
  (dk-cite! 'graph-adjoint-subset 'v bg2-CGg)
  (bg2-sa-eq!)
  (let ((l0 (dk-cite! 'graph-adjoint-linear 'v 'gg)))
    (dk-rewrite-h! l0 (bg2-adj 'gg) 'gg))
  (dk-cite! 'cayley-graph-linear 'v 'gg)
  (dk-have! '(IS-SYMMETRIC-GRAPH v gg)
    (lambda () (mac 'is-symmetric-graph) (subst (bg2-sa-eq!)) (dk-cite! 'subset-refl 'gg) (bg2-fin!)))
  (dk-cite! 'cayley-isometric-of-symmetric 'v 'gg)
  (dk-cite! 'cayley-adjoint-of-self-adjoint 'v 'gg)
  (let ((iso (bg2-iso-q bg2-CGg)))
    (dk-have! iso (lambda () (mac-h 'is-isometric-graph (list 'IS-ISOMETRIC-GRAPH 'v bg2-CGg)) (ass)))
    iso))
;;; with <y|y> = <0|0> (either way) in context: y = 0
(define (bg2-zero-of-q! y)
  (let ((g (list '= y bg2-Z)))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'cips-ip-zero-right 'v bg2-Z)
          (dk-have! (list '= (bg2-q y) 0)
            (lambda ()
              (subst (list '= (bg2-q y) (bg2-q bg2-Z)))
              (subst (list '= (bg2-q bg2-Z) 0))
              (bg2-fin!)))
          (dk-cite! 'cips-ip-zero-vector 'v y)))
    g))
(define (bg2-sa-dense! name which)
  (let ((fun (if (eq? which 'dom) (bg2-dom bg2-CGg) (bg2-ran bg2-CGg))))
    (sp (make-wff (forall-guarded '(v gg) bg2-HSA (list 'IS-DENSE bg2-Mv fun))))
    (let ((iso (bg2-sa-base!)))
      (dk-cite! (if (eq? which 'dom) 'graph-dom-submodule 'graph-ran-submodule) 'v bg2-CGg)
      (dk-cite! 'perp-subset 'v fun)
      (let ((iff (dk-cite! 'hilbert-dense-iff-perp-trivial 'v fun)))
        (dk-have! (caddr iff)
          (lambda ()
            (let* ((lk (dk-peel!)) (y (cadr (car lk))))
              (dk-cite! 'subset-mem-fwd (list 'PERP 'v fun) '(VEC v) y)
              (bg2-set! y '(VEC v))
              (let* ((zp (bg2-iff<-! (dk-cite! (if (eq? which 'dom) 'graph-adjoint-zero-pair-iff
                                                    'graph-adjoint-zero-pair-ran-iff) 'v bg2-CGg y)))
                     (zi (dk-rewrite-h! zp bg2-CGa bg2-CGi)))
                (if (eq? which 'dom)
                    (begin (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v bg2-CGg bg2-Z y))
                           (bg2-qeq! iso y bg2-Z))
                    (begin (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v bg2-CGg y bg2-Z))
                           (bg2-qeq! iso bg2-Z y)))
                (bg2-zero-of-q! y)
                (bg2-done-ass!)))))
        (bg2-iff<-! iff))
      (bg2-done-ass!)
      (bg2-qed! name))))
(bg2-sa-dense! 'cayley-dom-dense-of-self-adjoint 'dom)
(bg2-sa-dense! 'cayley-ran-dense-of-self-adjoint 'ran)

;;; ======== g-onto.scm
;;; ---- the converse of 3.12: G self-adjoint => C(G) unitary -----------------------------------
;;; dom C(G) = ran C(G) = H.  With G = G* closed, project xi = [0, x] onto G in H (+) H:
;;; xi - [c, d] = [b1, b2] is orthogonal to G, so [-b2, b1] lies in J(G^perp) = (J G)^perp = G* = G,
;;; and u = [c, d] + alpha [-b2, b1] (alpha = i for the domain, -i for the range) is a pair of G
;;; whose Cayley image has x in the slot wanted.  No sequence argument is needed.
(define (bg2-onto! name which)
  (let ((fun (if (eq? which 'dom) (bg2-dom bg2-CGg) (bg2-ran bg2-CGg)))
        (alpha (if (eq? which 'dom) +i '(- +i))))
    (sp (make-wff (forall-guarded '(v gg) bg2-HSA (list '= fun '(VEC v)))))
    (bg2-sa-base!)
    (bg2-lin-facts-of! 'gg)
    (dk-cite! 'hsum-is-hilbert 'v 'v)
    (let ((c0 (dk-cite! 'graph-adjoint-closed 'v 'gg)))
      (dk-rewrite-h! c0 (bg2-adj 'gg) 'gg))
    (dk-have! (list 'IS-CLOSED (list 'IP-METRIC-SPACE bg2-H) 'gg)
      (lambda () (mac-h 'is-closed-graph '(IS-CLOSED-GRAPH v gg)) (ass)))
    (dk-cite! 'hsum-perp-subset 'v 'gg)
    (dk-cite! (if (eq? which 'dom) 'graph-dom-submodule 'graph-ran-submodule) 'v bg2-CGg)
    (dk-cite! 'submodule-subset 'v fun)
    (let* ((jp (dk-cite! 'graph-j-of-perp 'v 'gg))
          (pj (dk-cite! 'graph-adjoint-perp-j 'v 'gg)))
      (dk-have! (list 'FORALL 'bgx_ (list 'IFF (list 'IN 'bgx_ fun) '(IN bgx_ (VEC v))))
        (lambda ()
          (dk-peel!)
          (let ((x (cadr (cadr (dk-goal)))))
            (dk-iff! (lambda (gl) (equal? (bg2-concl gl) (list 'IN x '(VEC v))))
              (lambda ()
                (bg2-intro!)
                (dk-cite! 'subset-mem-fwd fun '(VEC v) x)
                (bg2-done-ass!))
              (lambda ()
                (bg2-intro!)
                (bg2-set! x '(VEC v))
                (let* ((xi (bg2-pr bg2-Z x))
                       (m0 (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) bg2-Z x))
                       (m1 (dk-rewrite-h! (list 'IN xi bg2-HH) bg2-HH '(VEC (HSUM v v))))
                       (ex (dk-cite! 'hilbert-projection-point bg2-H 'gg xi))
                       (a (dk-skolem! ex))
                       (pm0 (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'PERP)
                                                         (dk-contains? f a)))
                                        (dk-asms)))
                       (cd (bg2-split-in! a 'gg)) (c (car cd)) (d (cadr cd))
                       (pm1 (dk-rewrite-h! pm0 a (bg2-pr c d)))
                       (tn (begin (bg2-vt! (bg2-neg c)) (bg2-vt! (bg2-neg d))))
                       (en (dk-cite! 'hsum-vneg-pair 'v 'v c d))
                       (pm2 (dk-rewrite-h! pm1 (cadr en) (caddr en)))
                       (ea (dk-cite! 'hsum-vadd-pair 'v 'v bg2-Z x (bg2-neg c) (bg2-neg d)))
                       (pm3 (dk-rewrite-h! pm2 (cadr ea) (caddr ea)))
                       (b1 (bg2-add bg2-Z (bg2-neg c))) (b2 (bg2-add x (bg2-neg d)))
                       (nb2 (bg2-neg b2)))
                  (bg2-vt! b1) (bg2-vt! b2) (bg2-vt! nb2) (bg2-vt! (bg2-neg nb2))
                  (bg2-set! b1 '(VEC v)) (bg2-set! nb2 '(VEC v))
                  (bg2-vec-eq! (bg2-neg nb2) b2)
                  (let* ((pm4 (let ((f4 (list 'IN (bg2-pr b1 (bg2-neg nb2)) (list 'PERP bg2-H 'gg))))
                                (dk-have! f4 (lambda () (subst (list '= (bg2-neg nb2) b2)) (ass)))
                                f4))
                         (j1 (bg2-iff<-! (dk-cite! 'graph-j-pair-iff 'v (list 'PERP bg2-H 'gg) nb2 b1)))
                         (j2 (dk-rewrite-h! j1 (cadr jp) (caddr jp)))
                         (j3 (dk-rewrite-h! j2 (caddr pj) (cadr pj)))
                         (j4 (dk-rewrite-h! j3 (bg2-adj 'gg) 'gg)))
                    (bg2-vt! (bg2-act alpha nb2)) (bg2-vt! (bg2-act alpha b1))
                    (bg2-lin-act-in! 'gg alpha nb2 b1)
                    (let ((u1 (bg2-add c (bg2-act alpha nb2))) (u2 (bg2-add d (bg2-act alpha b1))))
                      (bg2-lin-add-in! 'gg c d (bg2-act alpha nb2) (bg2-act alpha b1))
                      (bg2-vt! u1) (bg2-vt! u2) (bg2-set! u1 '(VEC v)) (bg2-set! u2 '(VEC v))
                      (let* ((ys (bg2-cy-type! u1 u2)) (y1 (car ys)) (y2 (cadr ys))
                             (cm (dk-cite! 'cayley-pair-in 'v 'gg u1 u2)))
                        (if (eq? which 'dom)
                            (begin (bg2-vec-eq! y1 x)
                                   (dk-rewrite-h! cm y1 x)
                                   (bg2-dom-in! bg2-CGg x y2))
                            (begin (bg2-vec-eq! y2 x)
                                   (dk-rewrite-h! cm y2 x)
                                   (bg2-ran-in! bg2-CGg y1 x)))
                        (bg2-done-ass!)))))))))))
    (dk-cite! 'class-extensionality fun '(VEC v))
    (bg2-done-ass!)
    (bg2-qed! name)))
(bg2-onto! 'cayley-dom-of-self-adjoint 'dom)
(bg2-onto! 'cayley-ran-of-self-adjoint 'ran)

;;; Proposition 3.12, the converse half, and the equivalence
(sp (make-wff (forall-guarded '(v gg) bg2-HSA (list 'IS-UNITARY-GRAPH 'v bg2-CGg))))
(bg2-sa-base!)
(dk-cite! 'cayley-dom-of-self-adjoint 'v 'gg)
(dk-cite! 'cayley-ran-of-self-adjoint 'v 'gg)
(mac 'is-unitary-graph)
(dk-conj-close! (lambda () (bg2-done-ass!)))
(bg2-qed! 'cayley-unitary-of-self-adjoint)

(sp (make-wff (forall-guarded '(v gg) (append '((IS-HILBERT-SPACE v)) (cdr bg2-SUBG))
  (list 'IFF '(IS-SELF-ADJOINT-GRAPH v gg) (list 'IS-UNITARY-GRAPH 'v bg2-CGg)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-iff! (lambda (gl) (dk-head-is? (bg2-concl gl) 'IS-UNITARY-GRAPH))
  (lambda () (bg2-intro!) (dk-cite! 'cayley-unitary-of-self-adjoint 'v 'gg) (bg2-done-ass!))
  (lambda () (bg2-intro!) (dk-cite! 'self-adjoint-of-cayley-unitary 'v 'gg) (bg2-done-ass!)))
(bg2-qed! 'self-adjoint-iff-cayley-unitary)
