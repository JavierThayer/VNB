(define (bg2-mem-iff! name vars guards elt setterm unfold rhs fwd! bwd!)
  (sp (make-wff (forall-guarded vars guards (list 'IFF (list 'IN elt setterm) rhs))))
  (dk-peel!)
  (bg2-sets!)
  (if (procedure? unfold) (unfold) (mac unfold))
  (let* ((g (dk-goal)) (mem (cadr g)))
    (dk-iff! (lambda (gl) (alpha-equiv? gl rhs))
      (lambda ()
        (let* ((ls (dk-landed (lambda () (sep-me mem))))
               (ls2 (bg2-nth-hs! (filter (lambda (h) (not (and (dk-head-is? h 'IN) (equal? (cadr h) elt)))) ls))))
          (fwd! (car ls2))))
      (lambda ()
        (in-sep! (lambda () (ass)) (lambda () (bg2-nth-goal!) (if (not (proof-done? *ps*)) (bwd!)))))))
  (bg2-qed! name))
