;;; ======== d-inverse.scm
;;; ---- PART D: the inverse graph; Corollary 3.5 -----------------------------------------------
;;; a pair variable p of H x H: components named, p = [a, b] landed and substituted in the goal;
;;; each MEMBERSHIP hypothesis (IN p S) is rewritten to (IN [a, b] S).  Returns (a b).
(define (bg2-split-vv! p)
  (dk-split! (dk-cite! 'cartesian-nth p '(VEC v) '(VEC v)))
  (let* ((pe (dk-cite! 'cartesian-pair-eq p '(VEC v) '(VEC v)))
         (a (dk-name! (list 'NTH 1 p) '(VEC v)))
         (b (dk-name! (list 'NTH 2 p) '(VEC v)))
         (pe1 (dk-rewrite-h! pe (list 'NTH 1 p) a))
         (pe2 (dk-rewrite-h! pe1 (list 'NTH 2 p) b)))
    (bg2-set! a '(VEC v)) (bg2-set! b '(VEC v))
    (for-each (lambda (h)
                (if (and (dk-head-is? h 'IN) (eq? (cadr h) p) (not (equal? (caddr h) bg2-HH)))
                    (dk-rewrite-h! h p (bg2-pr a b))))
              (dk-asms))
    (if (dk-contains? (dk-goal) p) (subst (list '= p (bg2-pr a b))))
    (list a b)))
;;; a variable typed in S (a subset of H x H, SUBSET S HH in context): split it
(define (bg2-split-in! p s)
  (dk-cite! 'subset-mem-fwd s bg2-HH p)
  (bg2-split-vv! p))

;;; dom(G^-1) = ran G
(sp (make-wff (forall-guarded '(v gg) bg2-SUBG (list '= (bg2-dom (bg2-inv 'gg)) (bg2-ran 'gg)))))
(dk-peel!)
(bg2-subg-facts! 'gg)
(dk-cite! 'graph-inverse-subset 'v 'gg)
(dk-have! (list 'FORALL 'bgx_ (list 'IFF (list 'IN 'bgx_ (bg2-dom (bg2-inv 'gg))) (list 'IN 'bgx_ (bg2-ran 'gg))))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (dk-iff! (lambda (gl) (equal? (bg2-concl gl) (list 'IN x (bg2-ran 'gg))))
        (lambda ()
          (bg2-intro!)
          (let ((d (bg2-partner-of! 'dom (bg2-inv 'gg) x)))
            (dk-cite! 'subset-mem-fwd (bg2-dom (bg2-inv 'gg)) '(VEC v) x)
            (bg2-set! x '(VEC v))
            (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg x d))
            (bg2-ran-in! 'gg d x)
            (bg2-done-ass!)))
        (lambda ()
          (bg2-intro!)
          (let ((d (bg2-partner-of! 'ran 'gg x)))
            (dk-cite! 'subset-mem-fwd (bg2-ran 'gg) '(VEC v) x)
            (bg2-set! x '(VEC v))
            (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg x d))
            (bg2-dom-in! (bg2-inv 'gg) x d)
            (bg2-done-ass!)))))))
(dk-cite! 'class-extensionality (bg2-dom (bg2-inv 'gg)) (bg2-ran 'gg))
(bg2-done-ass!)
(bg2-qed! 'graph-dom-of-inverse)

;;; (G^-1)* = (G*)^-1
(sp (make-wff (forall-guarded '(v gg) bg2-SUBG (list '= (bg2-adj (bg2-inv 'gg)) (bg2-inv (bg2-adj 'gg))))))
(dk-peel!)
(bg2-subg-facts! 'gg)
(dk-cite! 'graph-inverse-subset 'v 'gg)
(dk-cite! 'graph-adjoint-subset 'v 'gg)
(dk-cite! 'graph-adjoint-subset 'v (bg2-inv 'gg))
(dk-cite! 'graph-inverse-subset 'v (bg2-adj 'gg))
(dk-cite! 'graph-inverse-is-set 'v 'gg)
(dk-cite! 'graph-adjoint-is-set 'v 'gg)
(dk-cite! 'graph-adjoint-is-set 'v (bg2-inv 'gg))
(dk-cite! 'graph-inverse-is-set 'v (bg2-adj 'gg))
(bg2-by-ext! (bg2-adj (bg2-inv 'gg)) (bg2-inv (bg2-adj 'gg))
  (lambda (a b)
    (let* ((i1 (dk-cite! 'graph-adjoint-pair-iff 'v (bg2-inv 'gg) a b))
          (i2 (dk-cite! 'graph-inverse-pair-iff 'v (bg2-adj 'gg) a b))
          (i3 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg b a)))
      (dk-iff! (lambda (gl) (equal? (bg2-concl gl) (list 'IN (bg2-pr a b) (bg2-inv (bg2-adj 'gg)))))
        (lambda ()
          (bg2-intro!)
          (let ((a1 (bg2-iff->! i1)))
            (dk-have! (caddr i3)
              (lambda ()
                (let* ((cd (bg2-peel-new! 'gg)) (c (car cd)) (d (cadr cd)))
                  (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg d c))
                  (dk-apply! (dk-ctx-form a1) d c)
                  (subst (list '= (bg2-ip c a) (bg2-ip d b)))
                  (bg2-type-ips! (dk-goal))
                  (dk-close-if! (lambda () #t) (lambda () (rfl))))))
            (bg2-iff<-! i3) (bg2-iff<-! i2) (bg2-done-ass!)))
        (lambda ()
          (bg2-intro!)
          (bg2-iff->! i2)
          (let ((a3 (bg2-iff->! i3)))
            (dk-have! (caddr i1)
              (lambda ()
                (let* ((cd (bg2-peel-new! (bg2-inv 'gg))) (c (car cd)) (d (cadr cd)))
                  (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg c d))
                  (dk-apply! (dk-ctx-form a3) d c)
                  (subst (list '= (bg2-ip c b) (bg2-ip d a)))
                  (bg2-type-ips! (dk-goal))
                  (dk-close-if! (lambda () #t) (lambda () (rfl))))))
            (bg2-iff<-! i1) (bg2-done-ass!))))))
  )
(bg2-qed! 'graph-adjoint-of-inverse)

;;; G linear => G^-1 linear
(define (bg2-hsum-scal-cc! r)
  (if (not (dk-asm? (list 'IN r 'CC)))
      (let ((h1 (dk-rewrite-h! (list 'IN r '(CARR (SCAL (HSUM v v)))) '(SCAL (HSUM v v)) bg2-R)))
        (dk-rewrite-h! h1 (list 'CARR bg2-R) 'CC))))
(sp (make-wff (forall-guarded '(v gg) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-LINEAR-GRAPH v gg))
  (list 'IS-LINEAR-GRAPH 'v (bg2-inv 'gg)))))
(dk-peel!)
(bg2-lin-facts-of! 'gg)
(dk-cite! 'cips-vzero-in 'v)
(bg2-set! bg2-Z '(VEC v))
(bg2-zero-pair! 'gg)
(dk-cite! 'graph-inverse-subset 'v 'gg)
(dk-cite! 'graph-inverse-is-set 'v 'gg)
(dk-cite! 'hsum-scal-acc 'v 'v)
(dk-cite! 'sip-cc-ring-carr)
(dk-cite! 'hsum-vzero-acc 'v 'v)
(let* ((ig (bg2-inv 'gg))
       (iff (dk-cite! 'is-submodule bg2-H ig)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g 'SUBSET) (subst (list '= '(VEC (HSUM v v)) bg2-HH)) (bg2-done-ass!))
                  ((dk-head-is? g 'IN)
                   (subst (list '= '(VZERO (HSUM v v)) (bg2-pr bg2-Z bg2-Z)))
                   (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg bg2-Z bg2-Z))
                   (bg2-done-ass!))
                  ((dk-contains? g '(VADD (HSUM v v)))
                   (let* ((lk (dk-peel!)) (ps (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ig))) lk)))
                          (ab (bg2-split-in! (car ps) ig)) (ce (bg2-split-in! (cadr ps) ig))
                          (a (car ab)) (b (cadr ab)) (c (car ce)) (e (cadr ce)))
                     (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg a b))
                     (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg c e))
                     (bg2-lin-add-in! 'gg b a e c)
                     (subst (dk-cite! 'hsum-vadd-pair 'v 'v a b c e))
                     (bg2-vt! (bg2-add a c)) (bg2-vt! (bg2-add b e))
                     (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg (bg2-add a c) (bg2-add b e)))
                     (bg2-done-ass!)))
                  ((dk-contains? g '(VNEG (HSUM v v)))
                   (let* ((lk (dk-peel!)) (p (cadr (car lk)))
                          (ab (bg2-split-in! p ig)) (a (car ab)) (b (cadr ab)))
                     (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg a b))
                     (bg2-lin-neg-in! 'gg b a)
                     (subst (dk-cite! 'hsum-vneg-pair 'v 'v a b))
                     (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg (bg2-neg a) (bg2-neg b)))
                     (bg2-done-ass!)))
                  ((dk-contains? g '(ACT (HSUM v v)))
                   (let* ((lk (dk-peel!))
                          (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (not (equal? (caddr f) ig)))) lk)))
                          (p (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ig))) lk))))
                     (bg2-hsum-scal-cc! r)
                     (let* ((ab (bg2-split-in! p ig)) (a (car ab)) (b (cadr ab)))
                       (bg2-iff->! (dk-cite! 'graph-inverse-pair-iff 'v 'gg a b))
                       (bg2-vt! (bg2-act r a)) (bg2-vt! (bg2-act r b))
                       (bg2-lin-act-in! 'gg r b a)
                       (subst (dk-cite! 'hsum-act-pair 'v 'v r a b))
                       (bg2-iff<-! (dk-cite! 'graph-inverse-pair-iff 'v 'gg (bg2-act r a) (bg2-act r b)))
                       (bg2-done-ass!))))
                  (#t (error "graph-inverse-linear: unexpected" (expression->string g)))))))))
  (bg2-iff<-! iff)
  (bg2-iff-bwd! 'is-linear-graph 'v ig)
  (bg2-done-ass!))
(bg2-qed! 'graph-inverse-linear)

