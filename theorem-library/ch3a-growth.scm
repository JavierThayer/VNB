;;; ch3a-growth.scm -- entire functions of polynomial growth are polynomials (Proposition 3.53 of the
;;; complex analysis notes) (CH3-A, 2026-10-26).  Destination: theorem-library/ch3a-growth.scm,
;;; library complex-analysis.
;;;
;;;   entire-polynomial-growth   f entire, |f(z)| <= A |z|^m + B for all z  ==>  f(z) = sum_{j <= m} c(j) z^j
;;;                              for some c in FUN(NN, CC): a polynomial function of degree at most m
;;;
;;; Proof: induction on m.  m = 0 is Liouville.  For m + 1: q(z) = (f(z) - f(0))/z is entire
;;; (holomorphic-difference-quotient, holomorphic-removable-point); |q| is bounded on the closed unit
;;; disc by its maximum K there (cc-compact-modulus-max), and |q(z)| <= A |z|^m + B + |f(0)| for |z| > 1,
;;; so q has growth of degree m, is a polynomial of degree <= m, and f = f(0) + z q is one of degree
;;; <= m + 1 (cc-ps-cons).  This replaces the notes' coefficient estimate (Proposition 3.47) by
;;; Liouville plus induction; the coefficients are those of the POLY-2 vocabulary (CF-CONS).
;;; Load window: after theorem-library/ch3a-schwarz (cc-compact-modulus-max,
;;; holomorphic-removable-point) and the POLY-2 file poly-fn-laws (cf-cons-in-fun, cc-ps-cons,
;;; cc-subring-cc).  Helper prefix cgw-.
;;; ======================================================================
(define (cgw-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (cgw-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (cgw-mag! t) (cgw-cc! t) (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))
(define (cgw-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (cgw-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (cgw-H c z) n))
(define (cgw-bound f aa bb m)
  (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
    (list '<= (list 'magnitude (list f 'z)) (list '+ (list '* aa (list 'power '(magnitude z) m)) bb)))))
(define (cgw-poly f m)
  (list 'FORSOME 'cf (list 'AND '(IN cf (FUN NN CC))
    (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (list f 'z) (cgw-PS 'cf 'z (list 'succ m))))))))
;; w in CC: dist(0, w) = |w|, typed
(define (cgw-d0! w)
  (cgw-mag! w)
  (fact 'cc-zero-in)
  (if (not (dk-asm? (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude w))))
      (begin
        (dk-have! (list '= (list '- 0 w) (list '- w)) (lambda () (crs)))
        (dk-cite! 'cc-ms-dist 0 w)
        (dk-cite! 'cc-magnitude-neg w)
        (dk-have! (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude w))
          (lambda ()
            (subst (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude (list '- 0 w))))
            (subst (list '= (list '- 0 w) (list '- w)))
            (ass)))
        (dk-have! (list 'IN (list '(DIST CC-MS) 0 w) 'RR)
          (lambda () (subst (list '= (list '(DIST CC-MS) 0 w) (list 'magnitude w))) (ass))))))
(define (cgw-and! a b) (if (not (dk-asm? (list 'AND a b))) (dk-have! (list 'AND a b) (lambda () (dk-conj-close!)))))
;; 0 <= x*y from 0 <= x, 0 <= y (product typed)
(define (cgw-nonneg-prod! x y)
  (cgw-rr! (list '* x y)) (cgw-rr! (list '* 0 y))
  (dk-cite! 'rr-mul-le-right 0 x y)
  (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
  (dk-have! (list '<= 0 (list '* x y)) (lambda () (dk-ineq! (list '<= (list '* 0 y) (list '* x y)) (list '= (list '* 0 y) 0)))))


;; read f, aa, bb off a landed bound (FORALL z (IMPLIES (IN z CC) (<= (magnitude (f z)) (+ (* aa P) bb))))
(define (cgw-parts bnd)
  (let* ((le (caddr (caddr bnd)))
         (f (car (cadr (cadr le))))
         (rhs (caddr le)))
    (list f (cadr (cadr rhs)) (caddr rhs))))

;; m = 0 (focus on the base leaf): Liouville
(define (cgw-base!)
  (let* ((landed (dk-peel!))
         (bnd (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude) (not (dk-contains? fm 'HOLOMORPHIC-ON)))) landed)))
         (pr (cgw-parts bnd))
         (f (car pr)) (aa (cadr pr)) (bb (caddr pr))
         (c0 '(VNB-LAMBDA cgwj_ NN 0))
         (cf (list 'CF-CONS (list f 0) c0)))
    (fact 'rr-one-in)
    (cgw-rr! (list '+ aa bb))
    (let ((hi (dk-cite! 'holomorphic-on 'CC f)))
      (dk-have! (caddr hi) (lambda () (dk-close-if! (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON 'CC f))) prop)))
      (dk-split-all! (list (caddr hi))))
    (dk-have! (list 'FORALL 'ciey_ (list 'IMPLIES '(IN ciey_ CC) (list '<= (list 'magnitude (list f 'ciey_)) (list '+ aa bb))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-apply! bnd z)
          (cgw-mag! z)
          (fact 'fun-apply-type-c f 'CC 'CC z)
          (cgw-mag! (list f z))
          (fact 'rr-subset-cc (list 'magnitude z))
          (dk-cite! 'power-zero (list 'magnitude z))
          (dk-rewrite-h! (list '<= (list 'magnitude (list f z)) (list '+ (list '* aa (list 'power (list 'magnitude z) 0)) bb))
                         (list 'power (list 'magnitude z) 0) 1)
          (dk-ineq! (list '<= (list 'magnitude (list f z)) (list '+ (list '* aa 1) bb))))))
    (let ((const (dk-cite! 'liouville f (list '+ aa bb))))
      (fact 'fun-apply-type-c f 'CC 'CC 0)
      (dk-have! (list 'IN c0 '(FUN NN CC))
        (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (ass))))))
      (dk-cite! 'cf-cons-in-fun 'CC (list f 0) c0)
      (ew cf)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((z (dk-di-var!)))
                (dk-apply! const z)
                (dk-cite! 'cc-ps-cons 0 (list f 0) c0 z)
                (dk-cite! 'cc-series-partial-sum-zero (cgw-H c0 z))
                (subst (list '= (cgw-PS cf z '(succ 0)) (list '+ (list f 0) (list '* z (cgw-PS c0 z 0)))))
                (subst (list '= (cgw-PS c0 z 0) 0))
                (subst (list '= (list f z) (list f 0)))
                (crs))))))))

;; the step (focus on the step leaf)
(define (cgw-step!)
  (let* ((landed (dk-peel!))
         (m (dk-landed-var landed 'NN))
         (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'HOLOMORPHIC-ON))) landed)))
         (bnd (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude) (not (dk-contains? fm 'HOLOMORPHIC-ON)))) landed)))
         (pr (cgw-parts bnd))
         (f (car pr)) (aa (cadr pr)) (bb (caddr pr))
         (sm (list 'succ m))
         (f0 (list f 0)))
    (fact 'nn-succ-closed m)
    (fact 'rr-one-in)
    (let ((hi (dk-cite! 'holomorphic-on 'CC f)))
      (dk-have! (caddr hi) (lambda () (dk-close-if! (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON 'CC f))) prop)))
      (dk-split-all! (list (caddr hi))))
    (fact 'fun-apply-type-c f 'CC 'CC 0)
    (cgw-mag! f0)
    (fact 'cc-magnitude-nonneg f0)
    ;; bb >= |f(0)|: the bound at 0, 0^(m+1) = 0
    (dk-apply! bnd 0)
    (fact 'cc-magnitude-zero)
    (dk-cite! 'power-zero-base m)
    (let ((b0 (dk-pick (lambda (fm) (and (dk-head-is? fm '<=) (equal? (cadr fm) (list 'magnitude f0)))) "bound at 0")))
      (let* ((b1 (dk-rewrite-h! b0 '(magnitude 0) 0))
             (b2 (dk-rewrite-h! b1 (list 'power 0 sm) 0)))
        (dk-have! (list '<= (list 'magnitude f0) bb) (lambda () (dk-ineq! b2)))))
    ;; the quotient q
    (let* ((q (dk-skolem! (dk-cite! 'holomorphic-difference-quotient 'CC f 0)))
           (_ (dk-split-all!))
           (rel (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm f0) (dk-contains? fm q))) "the quotient relation"))
           (_h (dk-cite! 'holomorphic-removable-point 'CC q 0))
           (kk '(CLOSED-BALL CC-MS 0 1))
           (_k (dk-cite! 'cc-closed-ball-compact 0 1))
           (_s (dk-cite! 'closed-ball-in-carrier 'CC-MS 0 1)))
      (dk-have! (list 'SUBSET kk 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
      (dk-have! '(SUBSET CC CC) (lambda () (let ((z (subset-by-element!))) (ass))))
      (cgw-d0! 0)
      (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
      (dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
      (dk-cite! 'closed-ball-center-in 'CC-MS 0 1)
      (let* ((p (dk-skolem! (dk-cite! 'cc-compact-modulus-max 'CC q kk 0)))
             (_2 (dk-split-all!))
             (mx (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list 'magnitude (list q p))))) "the maximum"))
             (kq (list 'magnitude (list q p)))
             (absa (list 'abs aa))
             (bb2 (list '+ (list '+ (list '+ bb (list 'magnitude f0)) kq) absa)))
        (fact 'subset-mem-fwd kk 'CC p)
        (fact 'fun-apply-type-c q 'CC 'CC p)
        (cgw-mag! (list q p))
        (fact 'cc-magnitude-nonneg (list q p))
        (fact 'rr-abs-closed aa) (fact 'rr-abs-nonneg aa)
        (cgw-rr! bb2)
        ;; the growth bound for q
        (dk-have! (cgw-bound q aa bb2 m)
          (lambda ()
            (let* ((z (dk-di-var!))
                   (mz (list 'magnitude z))
                   (qz (list q z))
                   (mq (list 'magnitude qz))
                   (pm (list 'power mz m)))
              (fact 'fun-apply-type-c q 'CC 'CC z)
              (cgw-mag! qz) (cgw-mag! z)
              (fact 'cc-magnitude-nonneg z)
              (cgw-rr! pm)
              (dk-cite! 'rr-power-nonneg m mz)
              (cgw-rr! (list '* aa pm))
              (use-em (list '<= mz 1)
                (lambda ()
                  ;; |z| <= 1: |q(z)| <= K, and aa |z|^m >= -|aa|
                  (let ((ci (dk-cite! 'closed-ball-membership 'CC-MS 0 1 z)))
                    (cgw-d0! z)
                    (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                    (dk-have! (list '<= (list '(DIST CC-MS) 0 z) 1) (lambda () (dk-ineq! (list '= (list '(DIST CC-MS) 0 z) mz) (list '<= mz 1))))
                    (dk-have! (list 'IN z kk) (lambda () (dk-only! ci (list 'IN z '(PTS CC-MS)) (list '<= (list '(DIST CC-MS) 0 z) 1)) (prop))))
                  (dk-apply! mx z)
                  (cgw-and! (list '<= 0 mz) (list '<= mz 1))
                  (dk-cite! 'rr-power-le-one m mz)
                  (let* ((s1 (list '+ aa absa)) (s2 (list '- 1 pm)))
                    (cgw-rr! s1) (cgw-rr! s2)
                    (dk-have! (list '<= absa absa) (lambda () (dk-ineq!)))
                    (let ((bi (dk-cite! 'rr-abs-bound aa absa)))
                      (dk-have! (caddr bi) (lambda () (dk-only! bi (list '<= absa absa)) (prop)))
                      (dk-split-all! (list (caddr bi))))
                    (dk-have! (list '<= 0 s1) (lambda () (dk-ineq! (list '<= (list '- absa) aa))))
                    (dk-have! (list '<= 0 s2) (lambda () (dk-ineq! (list '<= pm 1))))
                    (cgw-nonneg-prod! s1 pm)
                    (cgw-nonneg-prod! absa s2)
                    (cgw-rr! (list '* absa pm))
                    (dk-have! (list '= (list '+ (list '* aa pm) absa) (list '+ (list '* s1 pm) (list '* absa s2))) (lambda () (crs)))
                    (dk-ineq! (list '<= mq kq)
                              (list '= (list '+ (list '* aa pm) absa) (list '+ (list '* s1 pm) (list '* absa s2)))
                              (list '<= 0 (list '* s1 pm)) (list '<= 0 (list '* absa s2))
                              (list '<= (list 'magnitude f0) bb) (list '<= 0 (list 'magnitude f0)))))
                (lambda ()
                  ;; |z| > 1: |q(z)| |z| = |f(z) - f(0)| <= aa |z|^(m+1) + bb + |f(0)|
                  (dk-cite! 'rr-not-le-lt mz 1)
                  (dk-apply! bnd z)
                  (dk-apply! rel z)
                  (fact 'fun-apply-type-c f 'CC 'CC z)
                  (let* ((fz (list f z))
                         (e (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list '- fz f0)))) "f(z) - f(0) = q(z) z")))
                    (dk-have! (list '= (list '- z 0) z) (lambda () (crs)))
                    (dk-rewrite-h! e (list '- z 0) z)
                    (cgw-mag! (list '- fz f0)) (cgw-mag! fz)
                    (dk-cite! 'cc-magnitude-sub-triangle fz f0)
                    (cgw-and! (list 'IN qz 'CC) (list 'IN z 'CC))
                    (dk-cite! 'cc-magnitude-mul qz z)
                    (dk-have! (list '= (list 'magnitude (list '- fz f0)) (list '* mq mz))
                      (lambda () (subst (list '= (list '- fz f0) (list '* qz z))) (ass)))
                    (fact 'rr-subset-cc mz)
                    (cgw-and! (list 'IN mz 'CC) (list 'IN m 'NN))
                    (dk-cite! 'power-succ mz m)
                    (dk-rewrite-h! (list '<= (list 'magnitude fz) (list '+ (list '* aa (list 'power mz sm)) bb)) (list 'power mz sm) (list '* mz pm))
                    (let* ((w (list '+ bb (list 'magnitude f0)))
                           (lhs (list '- mq (list '* aa pm))))
                      (cgw-rr! w) (cgw-rr! lhs)
                      (cgw-rr! (list '* mq mz)) (cgw-rr! (list '* aa (list '* mz pm))) (cgw-rr! (list '* lhs mz)) (cgw-rr! (list '* w mz)) (cgw-rr! (list '* w 1))
                      (dk-have! (list '= (list '* lhs mz) (list '- (list '* mq mz) (list '* aa (list '* mz pm)))) (lambda () (crs)))
                      (dk-have! (list '<= 0 w) (lambda () (dk-ineq! (list '<= (list 'magnitude f0) 'bb) (list '<= 0 (list 'magnitude f0)))))
                      (dk-have! (list '<= 1 mz) (lambda () (dk-ineq! (list '< 1 mz))))
                      (cgw-and! (list '<= 0 w) (list '<= 1 mz))
                      (dk-cite! 'rr-le-scale-nonneg w 1 mz)
                      (dk-have! (list '= (list '* w 1) w) (lambda () (crs)))
                      (dk-have! (list '<= (list '* lhs mz) (list '* w mz))
                        (lambda () (dk-ineq! (list '= (list '* lhs mz) (list '- (list '* mq mz) (list '* aa (list '* mz pm))))
                                             (list '= (list 'magnitude (list '- fz f0)) (list '* mq mz))
                                             (list '<= (list 'magnitude (list '- fz f0)) (list '+ (list 'magnitude fz) (list 'magnitude f0)))
                                             (list '<= (list 'magnitude fz) (list '+ (list '* aa (list '* mz pm)) bb))
                                             (list '<= (list '* w 1) (list '* w mz)) (list '= (list '* w 1) w))))
                      (dk-have! (list '< 0 mz) (lambda () (dk-ineq! (list '< 1 mz))))
                      (dk-cite! 'rr-mul-le-cancel-pos lhs mz w)
                      (dk-ineq! (list '<= lhs w) (list '<= 0 kq) (list '<= 0 absa)))))))))
        ;; the induction hypothesis for q
        (let* ((d (dk-skolem! (dk-apply! ih q aa bb2)))
               (_3 (dk-split-all!))
               (qd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-SERIES-PARTIAL-SUM) (dk-contains? fm d))) "q = sum d(j) z^j"))
               (cf (list 'CF-CONS f0 d)))
          (dk-cite! 'cf-cons-in-fun 'CC f0 d)
          (ew cf)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (let* ((z (dk-di-var!))
                         (qz (list q z)))
                    (fact 'fun-apply-type-c q 'CC 'CC z)
                    (fact 'fun-apply-type-c f 'CC 'CC z)
                    (dk-apply! qd z)
                    (dk-apply! rel z)
                    (dk-cite! 'cc-ps-cons sm f0 d z)
                    (subst (list '= (cgw-PS cf z (list 'succ sm)) (list '+ f0 (list '* z (cgw-PS d z sm)))))
                    (subst (list '= (cgw-PS d z sm) qz))
                    (dk-have! (list '= (list '+ f0 (list '* z qz)) (list '+ f0 (list '* qz (list '- z 0)))) (lambda () (crs)))
                    (subst (list '= (list '+ f0 (list '* z qz)) (list '+ f0 (list '* qz (list '- z 0)))))
                    (subst (list '= (list '* qz (list '- z 0)) (list '- (list f z) f0)))
                    (crs))))))))))

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
  (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON CC f)
    (list 'FORALL 'aa (list 'IMPLIES '(IN aa RR) (list 'FORALL 'bb (list 'IMPLIES '(IN bb RR)
      (list 'IMPLIES (cgw-bound 'f 'aa 'bb 'm) (cgw-poly 'f 'm))))))))))))
(fact 'cc-zero-in)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(fact 'cc-subring-cc)
(fact 'nn-zero-in)
(ni)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let* ((g (dk-goal))
          (body (and (dk-head-is? g 'FORALL) (caddr g)))
          (step? (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
     (if step? (cgw-step!) (cgw-base!))))
 (dk-open-leaves))
(qed 'entire-polynomial-growth)
(topic! 'entire-polynomial-growth 'analysis)
