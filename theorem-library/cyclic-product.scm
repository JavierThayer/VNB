(define (nt4-pseq-typ! q n)
  ;; IS-PRIME-SEQ ZZ-RING q n in context: land the pointwise ZZ typing of q on INTERVAL(1, n)
  (nt4-open! 'is-prime-seq (list 'ZZ-RING q n) (list 'IS-PRIME-SEQ 'ZZ-RING q n))
  (dk-have! (nt4-ptq q n)
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-apply! (dk-ctx-form (list 'FORALL 'gqi_ (list 'IMPLIES (list 'IN 'gqi_ (list 'INTERVAL 1 n)) (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q 'gqi_))))) i)
        (dk-project! (list 'IN (list q i) '(CARR ZZ-RING)) 'is-prime-element (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q i)))
        (dk-rewrite-h! (list 'IN (list q i) '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
        (ass)))))
(define (nt5-mult d n) (list 'SEP 'ntk_ (list 'INTERVAL 1 n) (list 'ZZ-DIVIDES d 'ntk_)))
(define (nt5-noprime k n) (list 'FORALL 'ntq_ (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ n) (list 'NOT (list 'ZZ-DIVIDES 'ntq_ k))))))
(define (z2-op a b) (list '(OPR g) a b))
(define (z2-inv a) (list '(INV g) a))
(define z2-e '(IDEN g))
(define (z2-pw n) (list 'GPOW 'g 'x n))
(define (z2-z k) (list 'GROUP-ZPOW 'g 'x k))
(define (z2-gx body) (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'FORALL 'x (list 'IMPLIES '(IN x (CARR g)) body)))))
(define (z2-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (z2-cl! a b) (if (not (dk-asm? (list 'IN (z2-op a b) '(CARR g)))) (dk-cite! 'group-carrier-closed-opr 'g a b)))
(define (z2-invt! a) (if (not (dk-asm? (list 'IN (z2-inv a) '(CARR g)))) (fact 'group-inv-in 'g a)))
(define (z2-pwt! n) (if (not (dk-asm? (list 'IN (z2-pw n) '(CARR g)))) (dk-cite! 'gpow-type n 'g 'x)))
(define (z2-open! name args hyp)
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (z2-close! name args rhs!)
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (z2-ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
(define (z2-absurd! . prems) (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems))) (z2-ap-absurd!))
(define z2-za '(RING-ADDITIVE-AG ZZ-RING))
(define (z2-za!)
  (fact 'zz-is-commutative-ring)
  (dk-cite! 'commutative-ring-is-ring 'ZZ-RING)
  (dk-cite! 'ring-additive-ag-is-abelian-group 'ZZ-RING)
  (dk-cite! 'abelian-group-is-group z2-za)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
  (dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
  (dk-cite! 'ras-carr 'ZZ-RING) (dk-cite! 'ras-op 'ZZ-RING) (dk-cite! 'ras-id 'ZZ-RING) (dk-cite! 'ras-inv 'ZZ-RING)
  (dk-have! (list '= (list 'CARR z2-za) 'ZZ) (lambda () (subst (list '= (list 'CARR z2-za) '(CARR ZZ-RING))) (subst '(== (CARR ZZ-RING) ZZ)) (fact 'zz-is-set) (z2-rfl!)))
  (dk-have! (list '= (list 'IDEN z2-za) 0) (lambda () (subst (list '= (list 'IDEN z2-za) '(ZERO ZZ-RING))) (subst '(== (ZERO ZZ-RING) 0)) (z2-rfl!)))
  (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-zero-in) (fact 'nn-one-in))
(define (z2-in-za! u) (dk-have! (list 'IN u (list 'CARR z2-za)) (lambda () (subst (list '= (list 'CARR z2-za) 'ZZ)) (ass))))
(define (z2-in-zz! u) (dk-have! (list 'IN u 'ZZ) (lambda () (subst (list '= 'ZZ (list 'CARR z2-za))) (ass))))
(define z2-hom-opr '(FORALL x1_ (IMPLIES (IN x1_ (CARR (RING-ADDITIVE-AG ZZ-RING))) (FORALL x2_ (IMPLIES (IN x2_ (CARR (RING-ADDITIVE-AG ZZ-RING)))
                      (= (q ((OPR (RING-ADDITIVE-AG ZZ-RING)) x1_ x2_)) ((OPR g) (q x1_) (q x2_))))))))
(define (z2-subst-q tree q) (subst-free 'q q tree))
(define z2-pi '(VNB-LAMBDA zpk_ ZZ (GROUP-ZPOW g x zpk_)))
(define (z3-absurd-nn! . prems) (dk-have! '(< 0 0) (lambda () (apply dk-nn! prems))) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
(define (z3-val! lam x val)
  (dk-have! (list '= (list lam x) val) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))
(define (z3-per x d) (list 'FORSOME 'gpd_ (list 'AND '(IN gpd_ NN) (list 'AND '(<= 1 gpd_) (list '= (list 'GPOW 'g x 'gpd_) '(IDEN g))))))
(define (z3-div-intro! c)
  ;; goal (ZZ-DIVIDES d x), d, x, c in ZZ, (= x (* d c)) in context
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))
(define (z3-ord-parts! d)
  ;; IS-ELEMENT-ORDER(g, x, d) in context: land its conjuncts
  (z2-open! 'is-element-order (list 'g 'x d) (list 'IS-ELEMENT-ORDER 'g 'x d)))
(define (z3-min x d) (list 'FORALL 'eod_ (list 'IMPLIES '(IN eod_ NN) (list 'IMPLIES '(<= 1 eod_) (list 'IMPLIES (list '= (list 'GPOW 'g x 'eod_) '(IDEN g)) (list '<= d 'eod_))))))
(define (z3-dv! d x) ;; (ZZ-DIVIDES d x) in context: return the witness c, x = d c
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-project! (list 'IN x 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-skolem! (dk-project! (list 'FORSOME 'c_ (list 'AND '(IN c_ ZZ) (list '= x (list '* d 'c_)))) 'zz-divides (list 'ZZ-DIVIDES d x))))

;;; ==================================================================== from grp6.scm
;;; (54) ALGEBRAIC-NUMBERS ch. 1, Prop. 1.39 for two groups: if x1 generates the finite group G1 and x2 generates
;;; the finite group G2, then (x1, x2) generates G1 x G2 iff card G1 and card G2 are relatively prime.
;;; Uses the order kit (grp3), the product (grp4, grp5), and from the number theory: zz-coprime-bezout (nt2-bez-open!),
;;; zz-coprime-iff-no-common-prime, galois's zz-divides-small and prime-nat-gt-one.  Helper prefix z6-.
(define (z6-z g x k) (list 'GROUP-ZPOW g x k))
;;; x generates the finite group g: land IS-ELEMENT-ORDER(g, x, card g) and its parts
(define (z6-ord! g x)
  (let ((n (list 'CARD (list 'CARR g))))
    (z2-open! 'is-generator (list g x) (list 'IS-GENERATOR g x))
    (let ((d (dk-skolem! (dk-apply! (dk-cite! 'element-order-exists) g x) #t)))
      (dk-apply! (dk-cite! 'generator-order-card) g x d)
      (dk-rewrite-h! (list 'IS-ELEMENT-ORDER g x d) d n)
      (z2-open! 'is-element-order (list g x n) (list 'IS-ELEMENT-ORDER g x n)))))
(define (z6-two! p)
  (dk-type! (list '- p 1) 'ZZ) (dk-type! (list '- p 1) 'RR)
  (dk-have! (list '< 0 (list '- p 1)) (lambda () (dk-ineq! (list '< 1 p))))
  (dk-apply! (dk-cite! 'zz-discrete) (list '- p 1))
  (dk-have! (list '<= 2 p) (lambda () (dk-ineq! (list '<= 1 (list '- p 1))))))
;;; n = q c with 0 < q and 1 <= n, all in ZZ: 1 <= c
(define (z6-cofactor-pos! q c n)
  (fact 'zz-in-rr c) (fact 'rr-zero-in)
  (dk-have! (list '<= 1 c)
    (lambda ()
      (dk-have! (list 'AND (list 'IN c 'RR) '(IN 0 RR)))
      (fact 'rr-leq-total c 0)
      (ma-or-split! (list 'OR (list '<= c 0) (list '<= 0 c))
        (list (lambda ()
                (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
                (dk-apply! (dk-cite! 'rr-mul-le-right c 0 q))
                (dk-type! (list '* c q) 'RR) (dk-type! (list '* 0 q) 'RR)
                (dk-have! (list '= (list '* c q) n) (lambda () (subst (list '= n (list '* q c))) (crs)))
                (dk-have! (list '= (list '* 0 q) 0) (lambda () (crs)))
                (z2-absurd! (list '<= (list '* c q) (list '* 0 q)) (list '= (list '* c q) n) (list '= (list '* 0 q) 0) (list '<= 1 n)
                            (list 'IN (list '* c q) 'RR) (list 'IN (list '* 0 q) 'RR)))
              (lambda ()
                (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 c))
                  (list (lambda () (dk-apply! (dk-cite! 'zz-discrete) c) (ass))
                        (lambda ()
                          (dk-have! (list '= n 0) (lambda () (subst (list '= n (list '* q c))) (subst (list '= c 0)) (crs)))
                          (z2-absurd! (list '= n 0) (list '<= 1 n)))))))))))

(define z6-p '(GROUP-PROD ga gb))
(define z6-u '(LIST xa xb))
(define z6-n1 '(CARD (CARR ga)))
(define z6-n2 '(CARD (CARR gb)))
(sp (make-wff (list 'FORALL 'ga (list 'IMPLIES '(IS-GROUP ga) (list 'FORALL 'gb (list 'IMPLIES '(IS-GROUP gb)
  (list 'IMPLIES (list 'IN z6-n1 'NN) (list 'IMPLIES (list 'IN z6-n2 'NN)
    (list 'FORALL 'xa (list 'IMPLIES '(IS-GENERATOR ga xa) (list 'FORALL 'xb (list 'IMPLIES '(IS-GENERATOR gb xb)
      (list 'IFF (list 'IS-GENERATOR z6-p z6-u) (list 'ZZ-COPRIME z6-n1 z6-n2))))))))))))))
(dk-peel!)
(z6-ord! 'ga 'xa)
(z6-ord! 'gb 'xb)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'rr-zero-in)
(dk-type! z6-n1 'ZZ) (dk-type! z6-n2 'ZZ) (fact 'nn-in-rr z6-n1) (fact 'nn-in-rr z6-n2)
(dk-apply! (dk-cite! 'group-prod-is-group 'ga) 'gb)
(dk-apply! (dk-cite! 'group-prod-carr 'ga) 'gb)
(fact 'group-carr-set 'ga) (fact 'group-carr-set 'gb)
(dk-have! (list 'AND '(IN (CARR ga) SET) (list 'IN z6-n1 'NN)))
(dk-have! (list 'AND '(IN (CARR gb) SET) (list 'IN z6-n2 'NN)))
(dk-apply! (dk-cite! 'card-cartesian '(CARR ga)) '(CARR gb))
(let* ((cp (list 'CARR z6-p)) (nn12 (list '* z6-n1 z6-n2)))
  (dk-have! (list '= (list 'CARD cp) nn12) (lambda () (subst (list '== cp '(CARTESIAN (CARR ga) (CARR gb)))) (ass)))
  (dk-have! (list 'AND (list 'IN z6-n1 'NN) (list 'IN z6-n2 'NN))) (fact 'nn-mul-closed z6-n1 z6-n2)
  (dk-have! (list 'IN (list 'CARD cp) 'NN) (lambda () (subst (list '= (list 'CARD cp) nn12)) (ass)))
  (dk-iff! (lambda (g) (dk-head-is? g 'ZZ-COPRIME))
    ;; a generator of the product: the cards are relatively prime
    (lambda ()
      (z2-open! 'is-generator (list z6-p z6-u) (list 'IS-GENERATOR z6-p z6-u))
      (let ((dp (dk-skolem! (dk-apply! (dk-cite! 'element-order-exists) z6-p z6-u) #t)))
        (dk-apply! (dk-cite! 'generator-order-card) z6-p z6-u dp)
        (dk-rewrite-h! (dk-rewrite-h! (list 'IS-ELEMENT-ORDER z6-p z6-u dp) dp (list 'CARD cp)) (list 'CARD cp) nn12))
      (dk-have! (list 'NOT (list '= z6-n2 0)) (lambda () (di) (z2-absurd! (list '= z6-n2 0) (list '<= 1 z6-n2))))
      (let ((iff (dk-cite! 'zz-coprime-iff-no-common-prime z6-n1 z6-n2)))
        (dk-have! (caddr iff)
          (lambda ()
            (di)
            (let ((q (cadr (cadr (dk-goal)))))
              (di) (di) (di)
              (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) q)))
              (dk-type! q 'ZZ) (fact 'nn-in-rr q)
              (z6-two! q)
              (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
              (let* ((c1 (z3-dv! q z6-n1)) (c2 (z3-dv! q z6-n2)) (l (list '* z6-n1 c2)))
                (z6-cofactor-pos! q c1 z6-n1) (z6-cofactor-pos! q c2 z6-n2)
                (dk-type! l 'ZZ) (dk-type! nn12 'ZZ) (dk-type! l 'RR) (dk-type! nn12 'RR)
                (dk-have! (list '= l (list '* z6-n2 c1)) (lambda () (subst (list '= z6-n1 (list '* q c1))) (subst (list '= z6-n2 (list '* q c2))) (crs)))
                ;; (x1, x2)^L = e
                (dk-apply! (dk-cite! 'zpow-multiple-period c2) 'ga 'xa z6-n1)
                (dk-apply! (dk-cite! 'zpow-multiple-period c1) 'gb 'xb z6-n2)
                (dk-apply! (dk-cite! 'zpow-prod l) 'ga 'gb 'xa 'xb)
                (dk-apply! (dk-cite! 'group-prod-iden 'ga) 'gb)
                (dk-have! (list '= (z6-z z6-p z6-u l) (list 'IDEN z6-p))
                  (lambda ()
                    (subst (list '= (z6-z z6-p z6-u l) (list 'LIST (z6-z 'ga 'xa l) (z6-z 'gb 'xb l))))
                    (subst (list '= (z6-z 'ga 'xa l) '(IDEN ga)))
                    (subst (list '= l (list '* z6-n2 c1)))
                    (subst (list '= (z6-z 'gb 'xb (list '* z6-n2 c1)) '(IDEN gb)))
                    (subst (list '== (list 'IDEN z6-p) '(LIST (IDEN ga) (IDEN gb))))
                    (fact 'group-identity-in 'ga) (fact 'group-identity-in 'gb)
                    (dk-cite! 'pair-in-cartesian '(CARR ga) '(CARR gb) '(IDEN ga) '(IDEN gb))
                    (rfl)))
                (ma-iff-parts! (dk-cite! 'element-order-divides l z6-p z6-u nn12))
                ;; but 0 < L < card G1 card G2
                (dk-have! (list '<= 0 c2) (lambda () (dk-ineq! (list '<= 1 c2))))
                (dk-apply! (dk-cite! 'rr-mul-le-right 1 z6-n1 c2))
                (dk-type! (list '* 1 c2) 'RR)
                (dk-have! (list '< 0 l) (lambda () (dk-ineq! (list '<= (list '* 1 c2) l) (list '<= 1 c2) (list 'IN (list '* 1 c2) 'RR) (list 'IN l 'RR))))
                (dk-have! (list '<= 0 l) (lambda () (dk-ineq! (list '< 0 l))))
                (dk-apply! (dk-cite! 'rr-mul-le-right 2 q l))
                (dk-type! (list '* q l) 'RR) (dk-type! (list '* 2 l) 'RR)
                (dk-have! (list '= nn12 (list '* q l)) (lambda () (subst (list '= z6-n2 (list '* q c2))) (crs)))
                (dk-have! (list '< l nn12) (lambda () (dk-ineq! (list '<= (list '* 2 l) (list '* q l)) (list '= nn12 (list '* q l)) (list '< 0 l)
                                                                (list 'IN (list '* q l) 'RR) (list 'IN (list '* 2 l) 'RR) (list 'IN nn12 'RR) (list 'IN l 'RR))))
                (dk-have! (list '< 0 nn12) (lambda () (dk-ineq! (list '< l nn12) (list '< 0 l))))
                (dk-apply! (dk-cite! 'zz-divides-small) nn12 l)
                (ma-prop-with! (list (list 'ZZ-DIVIDES nn12 l) (list 'NOT (list 'ZZ-DIVIDES nn12 l))))))))
        (ma-iff-back! iff)))
    ;; relatively prime: (x1, x2) generates the product
    (lambda ()
      (z2-close! 'is-generator (list z6-p z6-u)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (begin (subst (list '== cp '(CARTESIAN (CARR ga) (CARR gb))))
                         (dk-cite! 'pair-in-cartesian '(CARR ga) '(CARR gb) 'xa 'xb) (ass))
                  (let* ((y (begin (dk-peel!) (cadr (caddr (caddr (dk-goal))))))
                         (y1 (list 'NTH 1 y)) (y2 (list 'NTH 2 y)))
                    (dk-have! (list 'IN y '(CARTESIAN (CARR ga) (CARR gb))) (lambda () (subst (list '== '(CARTESIAN (CARR ga) (CARR gb)) cp)) (ass)))
                    (dk-split! (dk-cite! 'cartesian-nth y '(CARR ga) '(CARR gb)))
                    (dk-cite! 'cartesian-pair-eq y '(CARR ga) '(CARR gb))
                    (let* ((a (dk-skolem! (dk-apply! (dk-ctx-form '(FORALL geny_ (IMPLIES (IN geny_ (CARR ga)) (FORSOME genk_ (AND (IN genk_ ZZ) (= geny_ (GROUP-ZPOW ga xa genk_))))))) y1) #t))
                           (b (dk-skolem! (dk-apply! (dk-ctx-form '(FORALL geny_ (IMPLIES (IN geny_ (CARR gb)) (FORSOME genk_ (AND (IN genk_ ZZ) (= geny_ (GROUP-ZPOW gb xb genk_))))))) y2) #t))
                           (xy (nt2-bez-open! z6-n1 z6-n2)) (xs (car xy)) (ys (cadr xy))
                           (ba (list '- b a)) (c (list '* xs ba)) (c2 (list '* (list '- 0 ys) ba))
                           (k (list '+ a (list '* z6-n1 c))))
                      (for-each (lambda (t) (dk-type! t 'ZZ)) (list ba c c2 (list '* z6-n1 c) (list '* z6-n2 c2) k))
                      ;; x1^k = y1
                      (dk-apply! (dk-cite! 'zpow-multiple-period c) 'ga 'xa z6-n1)
                      (dk-cite! 'zpow-add a (list '* z6-n1 c) 'ga 'xa)
                      (dk-cite! 'zpow-type a 'ga 'xa)
                      (dk-apply! (dk-cite! 'group-op-right-id) 'ga (z6-z 'ga 'xa a))
                      (dk-have! (list '= (z6-z 'ga 'xa k) y1)
                        (lambda () (subst (list '= (z6-z 'ga 'xa k) (list '(OPR ga) (z6-z 'ga 'xa a) (z6-z 'ga 'xa (list '* z6-n1 c)))))
                                   (subst (list '= (z6-z 'ga 'xa (list '* z6-n1 c)) '(IDEN ga)))
                                   (subst (list '= (list '(OPR ga) (z6-z 'ga 'xa a) '(IDEN ga)) (z6-z 'ga 'xa a)))
                                   (subst (list '= y1 (z6-z 'ga 'xa a))) (rfl)))
                      ;; x2^k = y2, through k = b + n2 c2 (Bezout)
                      (dk-have! (list '= k (list '+ b (list '* z6-n2 c2)))
                        (lambda ()
                          (let ((bz (list '+ (list '* xs z6-n1) (list '* ys z6-n2))))
                            (dk-have! (list '= k (list '+ (list '+ b (list '* z6-n2 c2)) (list '* ba (list '- bz 1)))) (lambda () (crs)))
                            (let ((h (dk-rewrite-h! (list '= k (list '+ (list '+ b (list '* z6-n2 c2)) (list '* ba (list '- bz 1)))) bz 1)))
                              (subst (list '= k (list '+ (list '+ b (list '* z6-n2 c2)) (list '* ba '(- 1 1)))))
                              (crs)))))
                      (dk-apply! (dk-cite! 'zpow-multiple-period c2) 'gb 'xb z6-n2)
                      (dk-cite! 'zpow-add b (list '* z6-n2 c2) 'gb 'xb)
                      (dk-cite! 'zpow-type b 'gb 'xb)
                      (dk-apply! (dk-cite! 'group-op-right-id) 'gb (z6-z 'gb 'xb b))
                      (dk-have! (list '= (z6-z 'gb 'xb k) y2)
                        (lambda () (subst (list '= k (list '+ b (list '* z6-n2 c2))))
                                   (subst (list '= (z6-z 'gb 'xb (list '+ b (list '* z6-n2 c2))) (list '(OPR gb) (z6-z 'gb 'xb b) (z6-z 'gb 'xb (list '* z6-n2 c2)))))
                                   (subst (list '= (z6-z 'gb 'xb (list '* z6-n2 c2)) '(IDEN gb)))
                                   (subst (list '= (list '(OPR gb) (z6-z 'gb 'xb b) '(IDEN gb)) (z6-z 'gb 'xb b)))
                                   (subst (list '= y2 (z6-z 'gb 'xb b))) (rfl)))
                      (dk-apply! (dk-cite! 'zpow-prod k) 'ga 'gb 'xa 'xb)
                      (ew k)
                      (dk-conj-close!
                        (lambda ()
                          (if (not (dk-ass!))
                              (begin
                                (subst (list '= (z6-z z6-p z6-u k) (list 'LIST (z6-z 'ga 'xa k) (z6-z 'gb 'xb k))))
                                (subst (list '= (z6-z 'ga 'xa k) y1))
                                (subst (list '= (z6-z 'gb 'xb k) y2))
                                (ass)))))))))))))))
(qed 'cyclic-product-generator)


;;; ==================================================================== from grp7.scm
;;; (55) ALGEBRAIC-NUMBERS ch. 1, Prop. 1.38 (in the group form of 1.40): a cyclic group of order n has exactly phi(n)
;;; generators; x^k generates iff k is prime to n.  Helper prefix z7- (and z2-, z3-, nt2-, nt3- helpers).
(define (z7-z g x k) (list 'GROUP-ZPOW g x k))

;;; x^1 = x
(sp (make-wff (z2-gx (list '= (z2-z 1) 'x))))
(dk-peel!)
(fact 'nn-one-in) (fact 'nn-zero-in) (fact 'group-identity-in 'g)
(dk-apply! (dk-cite! 'zpow-nat 1) 'g 'x)
(fact 'nn-succ-plus-one 0)
(dk-have! '(= 1 (succ 0)) (lambda () (subst '(= (succ 0) (+ 0 1))) (crs)))
(dk-cite! 'gpow-succ 'g 'x 0)
(dk-cite! 'gpow-zero 'g 'x)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'x)))
(subst (list '= (z2-z 1) (z2-pw 1)))
(subst '(= 1 (succ 0)))
(subst (list '= (z2-pw '(succ 0)) (z2-op 'x (z2-pw 0))))
(subst (list '= (z2-pw 0) z2-e))
(subst (list '= (z2-op 'x z2-e) 'x))
(z2-rfl!)
(qed 'zpow-one)

;;; (x^k)^m = x^(k m)
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ)
  (z2-gx (list '= (z7-z 'g (z2-z 'k) 'm) (z2-z '(* k m))))))))))
(let* ((ind (dk-use-induction-fixed! '(g x))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, x fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (let ((y (z2-z 'k)))
    (fact 'nn-zero-in) (fact 'group-identity-in 'g)
    (dk-cite! 'zpow-type 'k 'g 'x)
    (dk-apply! (dk-cite! 'zpow-nat 0) 'g y) (dk-cite! 'gpow-zero 'g y)
    (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x) (dk-cite! 'gpow-zero 'g 'x)
    (dk-have! '(= (* k 0) 0) (lambda () (crs)))
    (subst '(= (* k 0) 0))
    (subst (list '= (z7-z 'g y 0) (list 'GPOW 'g y 0)))
    (subst (list '= (list 'GPOW 'g y 0) z2-e))
    (subst (list '= (z2-z 0) (z2-pw 0)))
    (subst (list '= (z2-pw 0) z2-e))
    (z2-rfl!))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((y (z2-z 'k)) (kv (list '* 'k v)))
    (fact 'nn-succ-plus-one v) (dk-type! v 'ZZ) (dk-type! kv 'ZZ)
    (dk-cite! 'zpow-type 'k 'g 'x)
    (dk-apply! (dk-ctx-form ih) 'k)   ; W1G-B: g, x fixed
    (dk-cite! 'zpow-succ v 'g y)
    (dk-cite! 'zpow-add kv 'k 'g 'x)
    (subst (list '= (list 'succ v) (list '+ v 1)))
    (subst (list '= (z7-z 'g y (list '+ v 1)) (z2-op (z7-z 'g y v) y)))
    (subst (list '= (z7-z 'g y v) (z2-z kv)))
    (dk-have! (list '= (list '* 'k (list '+ v 1)) (list '+ kv 'k)) (lambda () (crs)))
    (subst (list '= (list '* 'k (list '+ v 1)) (list '+ kv 'k)))
    (subst (list '= (z2-z (list '+ kv 'k)) (z2-op (z2-z kv) (z2-z 'k))))
    (z2-rfl!)))
(qed 'zpow-zpow-nat)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m ZZ) (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ)
  (z2-gx (list '= (z7-z 'g (z2-z 'k) 'm) (z2-z '(* k m))))))))))
(dk-peel!)
(fact 'zz-in-rr 'm) (fact 'rr-zero-in)
(dk-have! '(AND (IN m RR) (IN 0 RR)))
(fact 'rr-leq-total 'm 0)
(ma-or-split! '(OR (<= m 0) (<= 0 m))
  (list (lambda ()
          (let ((y (z2-z 'k)) (n '(- 0 m)))
            (dk-type! n 'ZZ) (dk-type! n 'RR)
            (dk-have! (list '<= 0 n) (lambda () (dk-ineq! '(<= m 0))))
            (dk-apply! (dk-cite! 'zz-nonneg-in-nn) n)
            (dk-cite! 'zpow-type 'k 'g 'x)
            (dk-apply! (dk-cite! 'zpow-zpow-nat n) 'k 'g 'x)
            (dk-cite! 'zpow-inv n 'g y)
            (dk-type! (list '* 'k n) 'ZZ)
            (dk-cite! 'zpow-inv (list '* 'k n) 'g 'x)
            (dk-have! (list '= 'm (list '- 0 n)) (lambda () (crs)))
            (dk-have! (list '= '(* k m) (list '- 0 (list '* 'k n))) (lambda () (crs)))
            (subst (list '= '(* k m) (list '- 0 (list '* 'k n))))
            (subst (list '= (z2-z (list '- 0 (list '* 'k n))) (z2-inv (z2-z (list '* 'k n)))))
            (dk-rewrite-h! (list '= (z7-z 'g y (list '- 0 n)) (z2-inv (z7-z 'g y n))) (list '- 0 n) 'm)
            (subst (list '= (z7-z 'g y 'm) (z2-inv (z7-z 'g y n))))
            (subst (list '= (z7-z 'g y n) (z2-z (list '* 'k n))))
            (z2-rfl!)))
        (lambda ()
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'm)
          (dk-apply! (dk-cite! 'zpow-zpow-nat 'm) 'k 'g 'x)
          (ass))))
(qed 'zpow-zpow)

(define (z7-bez-close! km1 c)
  ;; goal (= (+ (* m k) (* (- 0 c) n)) 1) with km1 = n c, km1 = k m - 1 in context
  (let* ((g (dk-goal)) (lhs (cadr g)))
    (dk-have! (list '= km1 (list '* 'n c)) (lambda () (ass)))
    (dk-have! (list '= lhs (list '+ (list '- km1 (list '* 'n c)) 1)) (lambda () (crs)))
    (subst (list '= lhs (list '+ (list '- km1 (list '* 'n c)) 1)))
    (subst (list '= km1 (list '* 'n c)))
    (crs)))
;;; x generates g with order n: x^k generates iff k is prime to n
(define (z7-gen-stmt body) (z2-gx (list 'FORALL 'n (list 'IMPLIES '(IS-ELEMENT-ORDER g x n) (list 'IMPLIES '(IS-GENERATOR g x) body)))))
(sp (make-wff (z7-gen-stmt (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (list 'IFF (list 'IS-GENERATOR 'g (z2-z 'k)) '(ZZ-COPRIME k n)))))))
(dk-peel!)
(z3-ord-parts! 'n)
(z2-open! 'is-generator '(g x) '(IS-GENERATOR g x))
(dk-type! 'n 'ZZ) (fact 'zz-one-in) (fact 'zz-zero-in) (fact 'group-identity-in 'g)
(dk-cite! 'zpow-type 'k 'g 'x)
(let ((y (z2-z 'k)))
  (dk-iff! (lambda (gl) (dk-head-is? gl 'ZZ-COPRIME))
    ;; a generator: x = y^m = x^(k m), so x^(k m - 1) = e and n | k m - 1
    (lambda ()
      (z2-open! 'is-generator (list 'g y) (list 'IS-GENERATOR 'g y))
      (let* ((m (dk-skolem! (dk-apply! (dk-ctx-form (list 'FORALL 'geny_ (list 'IMPLIES '(IN geny_ (CARR g)) (list 'FORSOME 'genk_ (list 'AND '(IN genk_ ZZ) (list '= 'geny_ (z7-z 'g y 'genk_))))))) 'x) #t))
             (km (list '* 'k m)) (km1 (list '- km 1)))
        (dk-type! km 'ZZ) (dk-type! km1 'ZZ)
        (dk-apply! (dk-cite! 'zpow-zpow m) 'k 'g 'x)
        (dk-cite! 'zpow-succ km1 'g 'x)
        (dk-cite! 'zpow-type km1 'g 'x)
        (dk-have! (list '= (list '+ km1 1) km) (lambda () (crs)))
        (let ((h (dk-rewrite-h! (list '= (z2-z (list '+ km1 1)) (z2-op (z2-z km1) 'x)) (list '+ km1 1) km)))
          (dk-have! (list '= 'x (z2-op (z2-z km1) 'x))
            (lambda () (subst (list '= (z2-op (z2-z km1) 'x) (z2-z km))) (subst (list '= (z2-z km) (z7-z 'g y m))) (ass)))
          (dk-apply! (dk-cite! 'group-right-cancel) 'g 'x (z2-z km1) 'x)
          (fact 'group-op-right-inv 'g 'x)
          (let ((h2 (dk-rewrite-h! (list '= (z2-op 'x (z2-inv 'x)) (z2-z km1)) (z2-op 'x (z2-inv 'x)) z2-e)))
            (dk-have! (list '= (z2-z km1) z2-e) (lambda () (subst (list '= (z2-z km1) z2-e)) (z2-rfl!)))
            (ma-iff-parts! (dk-cite! 'element-order-divides km1 'g 'x 'n))
            (let ((c (z3-dv! 'n km1)))
              (dk-type! (list '- 0 c) 'ZZ)
              (let ((iff (dk-cite! 'zz-coprime-bezout 'k 'n)))
                (dk-have! (caddr iff)
                  (lambda ()
                    (ew m)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((dk-head-is? (dk-goal) 'FORSOME) (ew (list '- 0 c)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (z7-bez-close! km1 c))))))
                              (#t (z7-bez-close! km1 c)))))))
                (ma-iff-back! iff)))))))
    ;; prime to n: by Bezout every x^a is a power of y
    (lambda ()
      (let* ((xy (nt2-bez-open! 'k 'n)) (xs (car xy)) (ys (cadr xy)) (bz (list '+ (list '* xs 'k) (list '* ys 'n))))
        (z2-close! 'is-generator (list 'g y)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((w (begin (dk-peel!) (cadr (caddr (caddr (dk-goal))))))
                           (a (dk-skolem! (dk-apply! (dk-ctx-form '(FORALL geny_ (IMPLIES (IN geny_ (CARR g)) (FORSOME genk_ (AND (IN genk_ ZZ) (= geny_ (GROUP-ZPOW g x genk_))))))) w) #t))
                           (m (list '* a xs)) (km (list '* 'k m)) (nb (list '* a ys)) (nnb (list '* 'n nb)))
                      (for-each (lambda (t) (dk-type! t 'ZZ)) (list m km nb nnb))
                      (dk-have! (list '= a (list '+ km nnb))
                        (lambda ()
                          (dk-have! (list '= (list '+ km nnb) (list '* a bz)) (lambda () (crs)))
                          (dk-rewrite-h! (list '= (list '+ km nnb) (list '* a bz)) bz 1)
                          (subst (list '= (list '+ km nnb) (list '* a 1)))
                          (crs)))
                      (dk-apply! (dk-cite! 'zpow-multiple-period nb) 'g 'x 'n)
                      (dk-cite! 'zpow-add km nnb 'g 'x)
                      (dk-cite! 'zpow-type km 'g 'x)
                      (dk-apply! (dk-cite! 'group-op-right-id) 'g (z2-z km))
                      (dk-apply! (dk-cite! 'zpow-zpow m) 'k 'g 'x)
                      (ew m)
                      (dk-conj-close!
                        (lambda ()
                          (if (not (dk-ass!))
                              (begin
                                (subst (list '= (z7-z 'g y m) (z2-z km)))
                                (subst (list '= w (z2-z a)))
                                (dk-rewrite-h! (list '= (z2-z (list '+ km nnb)) (z2-op (z2-z km) (z2-z nnb))) (list '+ km nnb) a)
                                (subst (list '= (z2-z a) (z2-op (z2-z km) (z2-z nnb))))
                                (subst (list '= (z2-z nnb) z2-e))
                                (subst (list '= (z2-op (z2-z km) z2-e) (z2-z km)))
                                (z2-rfl!)))))))))))))))
(qed 'generator-power-iff)

;;; R1: for x of order d, every power x^k is x^r with 1 <= r <= d
(define (z7-res k d) (list 'FORSOME 'gpr_ (list 'AND '(IN gpr_ NN) (list 'AND '(<= 1 gpr_) (list 'AND (list '<= 'gpr_ d) (list '= (z2-z k) '(GPOW g x gpr_)))))))
(sp (make-wff (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d) (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z7-res 'k 'd))))))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-type! 'd 'ZZ) (fact 'nn-in-rr 'd) (fact 'group-identity-in 'g) (fact 'nn-zero-in) (fact 'zz-zero-in) (fact 'rr-zero-in)
(let* ((k 'k) (ak (list 'abs k)) (kk (list '+ k (list '* 'd ak))))
  (fact 'zz-in-rr k) (fact 'rr-abs-closed k) (fact 'rr-abs-nonneg k) (fact 'rr-le-abs k) (dk-apply! (dk-cite! 'rr-neg-abs-le) k)
  (dk-have! (list 'IN ak 'ZZ) (lambda () (dk-have! (list 'IN ak 'NN) (lambda () (dk-apply! (dk-cite! 'zz-abs-in-nn) k) (ass))) (fact 'nn-subset-zz ak) (ass)))
  (dk-type! (list '* 'd ak) 'ZZ) (dk-type! kk 'ZZ) (dk-type! kk 'RR) (dk-type! (list '* 'd ak) 'RR)
  (dk-apply! (dk-cite! 'rr-mul-le-right 1 'd ak))
  (dk-type! (list '* 1 ak) 'RR)
  (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '<= (list '* 1 ak) (list '* 'd ak)) (list '<= (list '- ak) k) (list 'IN (list '* 1 ak) 'RR) (list 'IN (list '* 'd ak) 'RR) (list 'IN ak 'RR))))
  (dk-apply! (dk-cite! 'zz-nonneg-in-nn) kk)
  (dk-apply! (dk-cite! 'zpow-multiple-period ak) 'g 'x 'd)
  (dk-cite! 'zpow-add k (list '* 'd ak) 'g 'x)
  (dk-cite! 'zpow-type k 'g 'x)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g (z2-z k))))
  (dk-have! '(NOT (= d 0)) (lambda () (di) (z2-absurd! '(= d 0) '(<= 1 d))))
  (let* ((q (dk-skolem! (dk-apply! (dk-cite! 'nn-division kk) 'd) #t))
         (r (dk-skolem! (dk-ctx-form (list 'FORSOME 'r_ (list 'AND '(IN r_ NN) (list 'AND (list '= kk (list '+ (list '* q 'd) 'r_)) (list '<= '(succ r_) 'd))))) #t)))
    (dk-type! q 'ZZ) (dk-type! r 'ZZ) (fact 'nn-in-rr r)
    (dk-type! (list '* 'd q) 'ZZ)
    (dk-apply! (dk-cite! 'zpow-multiple-period q) 'g 'x 'd)
    (dk-cite! 'zpow-add (list '* 'd q) r 'g 'x)
    (dk-apply! (dk-cite! 'zpow-nat r) 'g 'x)
    (z2-pwt! r) (fact 'group-left-id 'g (z2-pw r))
    (dk-have! (list '= (z2-z k) (z2-pw r))
      (lambda ()
        (dk-have! (list '= kk (list '+ (list '* 'd q) r)) (lambda () (subst (list '= kk (list '+ (list '* q 'd) r))) (crs)))
        (dk-have! (list '= (z2-z k) (z2-z kk))
          (lambda () (subst (list '= (z2-z kk) (z2-op (z2-z k) (z2-z (list '* 'd ak))))) (subst (list '= (z2-z (list '* 'd ak)) z2-e))
                     (subst (list '= (z2-op (z2-z k) z2-e) (z2-z k))) (z2-rfl!)))
        (subst (list '= (z2-z k) (z2-z kk)))
        (subst (list '= kk (list '+ (list '* 'd q) r)))
        (subst (list '= (z2-z (list '+ (list '* 'd q) r)) (z2-op (z2-z (list '* 'd q)) (z2-z r))))
        (subst (list '= (z2-z (list '* 'd q)) z2-e))
        (subst (list '= (z2-z r) (z2-pw r)))
        (subst (list '= (z2-op z2-e (z2-pw r)) (z2-pw r)))
        (z2-rfl!)))
    (dk-have! (list '<= 0 r) (lambda () (dk-nn!)))
    (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 r))
      (list (lambda ()
              (dk-apply! (dk-cite! 'zz-discrete) r)
              (dk-have! (list '<= r 'd) (lambda () (dk-nn! (list '<= (list 'succ r) 'd))))
              (ew r) (dk-conj-close! (lambda () (ass))))
            (lambda ()
              (dk-have! '(<= d d) (lambda () (dk-ineq!)))
              (z2-pwt! 'd)
              (dk-cite! 'gpow-zero 'g 'x)
              (dk-have! (list '= (z2-z k) (z2-pw 'd))
                (lambda () (subst (list '= (z2-z k) (z2-pw r))) (subst (list '= r 0)) (subst (list '= (z2-pw 0) z2-e)) (subst (list '= (z2-pw 'd) z2-e)) (z2-rfl!)))
              (ew 'd) (dk-conj-close! (lambda () (ass))))))))
(qed 'zpow-residue)

;;; R2: for x of order d, x^1, ..., x^d are distinct
(sp (make-wff (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d)
  (forall-guarded '(a b) '((IN a NN) (IN b NN) (<= 1 a) (<= a d) (<= 1 b) (<= b d) (= (GPOW g x a) (GPOW g x b))) '(= a b)))))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-type! 'a 'ZZ) (dk-type! 'b 'ZZ) (fact 'nn-in-rr 'a) (fact 'nn-in-rr 'b) (fact 'nn-in-rr 'd) (fact 'rr-zero-in) (fact 'zz-zero-in)
(let ((side! (lambda (lo hi)
               (dk-apply! (dk-cite! 'gpow-difference-period lo) hi 'g 'x)
               (dk-type! (list '- hi lo) 'ZZ) (dk-type! (list '- hi lo) 'RR)
               (dk-have! (list '<= 0 (list '- hi lo)) (lambda () (dk-ineq! (list '<= lo hi))))
               (dk-apply! (dk-cite! 'zz-nonneg-in-nn) (list '- hi lo))
               (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 (list '- hi lo)))
                 (list (lambda ()
                         (dk-apply! (dk-cite! 'zz-discrete) (list '- hi lo))
                         (dk-apply! (dk-ctx-form (z3-min 'x 'd)) (list '- hi lo))
                         (z2-absurd! (list '<= 'd (list '- hi lo)) (list '<= 1 lo) (list '<= hi 'd)))
                       (lambda () (dk-ineq! (list '= 0 (list '- hi lo)))))))))
  (dk-have! '(AND (IN a RR) (IN b RR)))
  (fact 'rr-leq-total 'a 'b)
  (ma-or-split! '(OR (<= a b) (<= b a))
    (list (lambda ()
            (dk-have! '(<= b a) (lambda () (side! 'a 'b)))
            (dk-have! '(AND (<= a b) (<= b a))) (fact 'rr-leq-antisymmetric 'a 'b) (dk-ass!))
          (lambda ()
            (z2-pwt! 'a) (z2-pwt! 'b)
            (dk-have! (list '= (z2-pw 'b) (z2-pw 'a)) (lambda () (subst (list '= (z2-pw 'b) (z2-pw 'a))) (z2-rfl!)))
            (dk-have! '(<= a b) (lambda () (side! 'b 'a)))
            (dk-have! '(AND (<= a b) (<= b a))) (fact 'rr-leq-antisymmetric 'a 'b) (dk-ass!)))))
(qed 'gpow-injective-below-order)

;;; PROP. 1.38 (group form, = 1.40 with 1.19): a finite cyclic group of order n has exactly phi(n) generators
(define z7-gs '(SEP gny_ (CARR g) (IS-GENERATOR g gny_)))
(sp (make-wff (z2-gx (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'IMPLIES '(IS-GENERATOR g x)
  (list '= (list 'CARD z7-gs) '(EULER-PHI (CARD (CARR g)))))))))
(dk-peel!)
(let* ((n '(CARD (CARR g))) (dd (nt3-phiset n)) (iv (list 'INTERVAL 1 n))
       (phi (list 'VNB-LAMBDA 'gck_ dd '(GPOW g x gck_))) (im (list 'IMAGE phi dd))
       (genall '(FORALL geny_ (IMPLIES (IN geny_ (CARR g)) (FORSOME genk_ (AND (IN genk_ ZZ) (= geny_ (GROUP-ZPOW g x genk_))))))))
  (z2-open! 'is-generator '(g x) '(IS-GENERATOR g x))
  (let ((d (dk-skolem! (dk-apply! (dk-cite! 'element-order-exists) 'g 'x) #t)))
    (dk-apply! (dk-cite! 'generator-order-card) 'g 'x d)
    (dk-rewrite-h! (list 'IS-ELEMENT-ORDER 'g 'x d) d n))
  (z3-ord-parts! n)
  (fact 'group-carr-set 'g) (fact 'group-identity-in 'g) (dk-type! n 'ZZ)
  (fact 'interval-in-set 1 n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
  (nt3-fin! dd iv)
  (let ((in-d! (lambda (k) (ma-sep-parts! (list 'IN k dd)) (ma-iff-parts! (dk-cite! 'interval-membership 1 n k))))
        (gen-iff (lambda (k) (dk-apply! (dk-cite! 'generator-power-iff) 'g 'x n k))))
    (dk-have! (list 'IN phi (list 'FUN dd '(CARR g)))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (in-d! k) (z2-pwt! k) (ass))) (lambda () (dk-ass!)))))
    (let ((inj (dk-cite! 'injection-membership-iff dd '(CARR g) phi)))
      (dk-have! (caddr (caddr inj))
        (lambda ()
          (let* ((ab (begin (dk-peel!) (dk-goal))) (a (cadr ab)) (b (caddr ab)))
            (in-d! a) (in-d! b)
            (z2-pwt! a) (z2-pwt! b) (z3-val! phi a (z2-pw a)) (z3-val! phi b (z2-pw b))
            (dk-have! (list '= (z2-pw a) (z2-pw b))
              (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list phi a) (list phi b)) (list phi a) (z2-pw a)) (list phi b) (z2-pw b)))) (ass))))
            (dk-apply! (dk-cite! 'gpow-injective-below-order) 'g 'x n a b)
            (ass))))
      (ma-iff-back! inj))
    (fact 'image-set phi dd)
    (dk-apply! (dk-cite! 'image-subset-codomain dd '(CARR g) phi))
    (ma-ext2! im z7-gs
      (lambda (w)
        (dk-apply! (dk-ctx-form (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w im) '(IN w (CARR g))))) w)
        (let* ((iff (dk-cite! 'image-membership-iff phi dd w))
               (fs (caddr (caddr iff))))
          (ma-iff-parts! iff)
          (let ((k (dk-skolem! (dk-ctx-form fs) #t)))
            (in-d! k)
            (z2-pwt! k) (z3-val! phi k (z2-pw k))
            (dk-type! k 'ZZ)
            (dk-apply! (dk-cite! 'zpow-nat k) 'g 'x)
            (ma-iff-back! (gen-iff k))
            (dk-have! (list '= (z2-pw k) w) (lambda () (subst (list '= (z2-pw k) (list phi k))) (ass)))
            (dk-rewrite-h! (dk-rewrite-h! (list 'IS-GENERATOR 'g (z2-z k)) (z2-z k) (z2-pw k)) (z2-pw k) w)
            (in-sep! dk-ass! (lambda () (ass))))))
      (lambda (w)
        (ma-sep-parts! (list 'IN w z7-gs))
        (let* ((a (dk-skolem! (dk-apply! (dk-ctx-form genall) w) #t))
               (r (dk-skolem! (dk-apply! (dk-cite! 'zpow-residue) 'g 'x n a) #t)))
          (dk-type! r 'ZZ)
          (dk-apply! (dk-cite! 'zpow-nat r) 'g 'x)
          (z2-pwt! r)
          (dk-have! (list '= w (z2-z r))
            (lambda () (subst (list '= w (z2-z a))) (subst (list '= (z2-z a) (z2-pw r))) (subst (list '= (z2-z r) (z2-pw r))) (z2-rfl!)))
          (dk-rewrite-h! (list 'IS-GENERATOR 'g w) w (z2-z r))
          (ma-iff-parts! (gen-iff r))
          (ma-iff-back! (dk-cite! 'interval-membership 1 n r))
          (dk-have! (list 'IN r dd) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
          (z3-val! phi r (z2-pw r))
          (fact 'membership-implies-sethood w '(CARR g))
          (let* ((iff (dk-cite! 'image-membership-iff phi dd w)) (fs (caddr (caddr iff))))
            (dk-have! fs (lambda () (ew r) (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                                     (begin (subst (list '= (list phi r) (z2-pw r))) (subst (list '= w (z2-z r)))
                                                                            (subst (list '= (z2-z r) (z2-pw r))) (z2-rfl!)))))))
            (ma-iff-back! iff))))))
  ;; card GS = card IMAGE = card D = phi(n)
  (dk-have! (list 'AND (list 'IN phi (list 'INJECTION dd '(CARR g))) (list 'AND (list 'IN dd 'SET) (list 'IN (list 'CARD dd) 'NN)))
    (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'card-image-injection dd '(CARR g) phi)
  (mac 'EULER-PHI)
  (subst (list '= z7-gs im))
  (subst (list '= (list 'CARD im) (list 'CARD dd)))
  (z2-rfl!))
(qed 'generator-count)

