;;; theorem-library/cyclic-product.scm -- PROPS. 1.38 and 1.39 (two groups) (ALGEBRAIC-NUMBERS notes, ch. 1; ALGNUM, 2026-10-27).
;;;   cyclic-product-generator   1.39 for two groups: (x1, x2) generates G1 x G2 iff card G1, card G2 are prime to
;;;                              each other (x1, x2 generators of the finite groups G1, G2)
;;;   zpow-one, zpow-zpow(-nat)  x^1 = x, (x^k)^m = x^(k m)
;;;   generator-power-iff        x of order n generates: x^k generates iff k is prime to n
;;;   zpow-residue, gpow-injective-below-order   x^k = x^r with 1 <= r <= ord(x); x^1, ..., x^ord(x) distinct
;;;   generator-count            1.38 (in the group form of 1.40): a finite cyclic group of order n has phi(n) generators
;;; LOAD WINDOW.  lo: group-zpow, zz-number-theory, zz-primes, the galois chain, la-z5-card.  hi: none.  Library: algebra.

;;; (0) the ma- kit (file-local copy of scratchpad/ma/final/kit-body.scm)
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

(define (ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
;;; helpers repeated from the earlier ALGNUM files (file-local there)
(define (nt-nn! . xs) (for-each (lambda (x) (fact 'nn-in-rr x)) xs))
(define (nt-qr a b) (list 'FORSOME 'ntn_ (list 'AND '(IN ntn_ NN) (list 'FORSOME 'ntr_ (list 'AND '(IN ntr_ NN) (list 'AND (list '= b (list '+ (list '* a 'ntn_) 'ntr_)) (list '< 'ntr_ a)))))))
(define (nt2-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt2-pw n k)
  ;; pairwise coprime below k
  (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
    (list 'FORALL 'crj_ (list 'IMPLIES '(IN crj_ NN) (list 'IMPLIES (list '< 'crj_ k)
      (list 'IMPLIES '(NOT (= cri_ crj_)) (list 'ZZ-COPRIME (list n 'cri_) (list n 'crj_))))))))))
(define (nt2-solv n k)
  ;; every system x = a_i (mod n_i), i < k, has a solution
  (list 'FORALL 'cra_ (list 'IMPLIES '(IN cra_ (FUN NN ZZ))
    (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ)
      (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
        (list 'ZZ-DIVIDES (list n 'cri_) '(- crx_ (cra_ cri_)))))))))))
(define (nt2-bez a b) (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ) (list 'FORSOME 'cry_ (list 'AND '(IN cry_ ZZ) (list '= (list '+ (list '* 'crx_ a) (list '* 'cry_ b)) 1))))))
(define (nt2-gcd-parts a b g)
  (list (list 'ZZ-DIVIDES g a) (list 'ZZ-DIVIDES g b)
        (forall-guarded '(e_) (list '(IN e_ ZZ) (list 'ZZ-DIVIDES 'e_ a) (list 'ZZ-DIVIDES 'e_ b)) (list 'ZZ-DIVIDES 'e_ g))))
(define (nt2-div-intro! d x c)
  ;; goal (ZZ-DIVIDES d x), d, x, c in ZZ, (= x (* d c)) provable by crs after the caller's substitutions: c the witness
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))
(define (nt2-eq-last! i v)
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (dk-have! (list '= i v)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
        (list (lambda () (ma-prop-with! (list (list '< i v) (list 'NOT (list '< i v)))))
              (lambda () (ass))
              (lambda ()
                (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
                (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
                (ap-absurd!)))))))
(define (nt2-split-last! i v lt! eq!)
  ;; i < succ v: run LT! with (< i v), or EQ! with (= i v) in context
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
    (list lt! eq!
          (lambda ()
            (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
            (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
            (ap-absurd!)))))
(define (nt2-below-absurd! i) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< i 0)))) (ap-absurd!))
(define (nt2-divall n k m) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-DIVIDES (list n 'cri_) m)))))
(define (nt2-copall n k q) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-COPRIME (list n 'cri_) q)))))
(define (nt2-strong k)
  (list 'FORSOME 'crm_ (list 'AND '(IN crm_ ZZ)
    (list 'AND (nt2-divall 'n k 'crm_)
      (list 'AND (list 'FORALL 'crq_ (list 'IMPLIES '(IN crq_ ZZ) (list 'IMPLIES (nt2-copall 'n k 'crq_) '(ZZ-COPRIME crm_ crq_))))
                 (nt2-solv 'n k))))))
(define (nt2-bez-open! a b)
  ;; ZZ-COPRIME a b in context: land x a + y b = 1, return (x y)
  (car (ma-iff-parts! (dk-cite! 'zz-coprime-bezout a b)))
  (let* ((x (dk-skolem! (dk-ctx-form (nt2-bez a b))))
         (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x))) (dk-asms)))))
    (list x y)))
(define nt2-inv-set (lambda (t) (list 'SEP 'crv_ 'ZZ (list 'FORSOME 'crw_ (list 'AND '(IN crw_ ZZ) (list '= (list '+ (list '* 'crv_ (list 'c t)) (list '* 'crw_ (list 'n t))) 1))))))
(define (ie-rfl0!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt3-rr! . xs) (for-each (lambda (x) (dk-type! x 'RR)) xs))
(define (nt3-dv! d x) ;; (ZZ-DIVIDES d x) in context: return the witness c, x = d c
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-project! (list 'IN x 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-skolem! (dk-project! (list 'FORSOME 'c_ (list 'AND '(IN c_ ZZ) (list '= x (list '* d 'c_)))) 'zz-divides (list 'ZZ-DIVIDES d x))))
(define (nt3-eq-from-diff! a b)
  ;; (= (- a b) 0) in context, a, b typed: land (= a b)
  (dk-have! (list '= a b)
    (lambda ()
      (let ((id (list '= a (list '+ b (list '- a b)))))
        (dk-have! id (lambda () (crs)))
        (subst id)
        (subst (list '= (list '- a b) 0))
        (crs)))))
(define (nt3-sset k m) (list 'SEP 'zrr_ (list 'INTERVAL 1 m) (list 'ZZ-DIVIDES m (list '- k 'zrr_))))
(define (nt3-phiset k) (list 'SEP 'ephk_ (list 'INTERVAL 1 k) (list 'ZZ-COPRIME 'ephk_ k)))
(define (nt3-fin! s sup)
  (ma-sep-subset! s)
  (fact 'subclass-of-set-is-set s sup)
  (dk-have! (list 'AND (list 'IN sup 'SET) (list 'IN (list 'CARD sup) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn sup)))
    (dk-have! (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s sup z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))))
    (dk-apply! cs s)))
(define (nt2-div-intro-h! d x c)
  ;; land (ZZ-DIVIDES d x) from (= x (* d c)), d, x, c in ZZ
  (dk-have! (list 'ZZ-DIVIDES d x) (lambda () (nt2-div-intro! d x c))))
(define (nt3-lc! d x y s t target)
  ;; d | x, d | y, s, t in ZZ, s x + t y = target by crs: land d | target
  (dk-apply! (dk-cite! 'zz-divides-lincomb) d x y s t)
  (let ((lc (list '+ (list '* s x) (list '* t y))))
    (dk-have! (list '= lc target) (lambda () (crs)))
    (dk-rewrite-h! (list 'ZZ-DIVIDES d lc) lc target)))
(define (nt4-open! name args hyp)
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (nt4-close! name args rhs!)
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (nt4-zzr!)
  ;; the read-offs of ZZ-RING
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
  (dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
  (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
  (fact 'zz-zero-in) (fact 'zz-one-in))
(define (nt4-abs-nn! x)
  ;; x in ZZ: land (IN (abs x) NN), (IN (abs x) ZZ)
  (dk-type! x 'RR)
  (dk-apply! (dk-cite! 'rr-abs-nonneg) x)
  (dk-have! (list 'IN (list 'abs x) 'ZZ)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-abs-cases) x)
        (list (lambda () (dk-split-all!) (subst (list '= (list 'abs x) x)) (ass))
              (lambda () (dk-split-all!) (subst (list '= (list 'abs x) (list '- x))) (dk-type! (list '- x) 'ZZ) (ass))))))
  (dk-apply! (dk-cite! 'zz-nonneg-in-nn) (list 'abs x)))
(define (nt4-mul! a b) (dk-apply! (dk-cite! 'zz-ring-mul-is-mul) a b) (list '= (list (list 'MUL 'ZZ-RING) a b) (list '* a b)))
(define nt4-unit-body (lambda (x) (list 'AND (list 'IN x '(CARR ZZ-RING)) (list 'FORSOME 'guv_ (list 'AND '(IN guv_ (CARR ZZ-RING)) (list '= (list '(MUL ZZ-RING) x 'guv_) '(ONE ZZ-RING)))))))
(define (nt4-irr p) (list 'FORALL 'gpa_ (list 'IMPLIES '(IN gpa_ (CARR ZZ-RING)) (list 'FORALL 'gpb_ (list 'IMPLIES '(IN gpb_ (CARR ZZ-RING))
  (list 'IMPLIES (list '= p '((MUL ZZ-RING) gpa_ gpb_)) '(OR (IS-UNIT ZZ-RING gpa_) (IS-UNIT ZZ-RING gpb_))))))))
(define (nt4-int0!)
  ;; land (= (INTERVAL 1 0) EMPTY-SET)
  (fact 'nn-zero-in) (fact 'interval-in-set 1 0)
  (dk-apply! (dk-cite! 'interval-card) 0)
  (dk-apply! (dk-cite! 'card-zero-is-empty) '(INTERVAL 1 0)))
(define (nt4-in-carr! t) (dk-have! (list 'IN t '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass))))
(define (nt4-ptw f n typ!)
  ;; land (FORALL z_ (IMPLIES (IN z_ (INTERVAL 1 n)) (IN (f z_) (CARR ZZ-RING)))) with TYP! landing (IN (f z) ZZ)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'INTERVAL 1 n)) (list 'IN (list f 'z_) '(CARR ZZ-RING))))
    (lambda () (let ((z (dk-di-var!))) (typ! z) (subst '(== (CARR ZZ-RING) ZZ)) (ass)))))
(define (nt4-prod-type! f n)
  ;; the pointwise typing over INTERVAL(1, n) in context: land (IN (PROD-RING ZZ-RING f (INTERVAL 1 n)) ZZ)
  (fact 'interval-in-set 1 n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
  (dk-apply! (dk-cite! 'prod-ring-type-ptwise 'ZZ-RING) (list 'INTERVAL 1 n) f)
  (dk-rewrite-h! (list 'IN (list 'PROD-RING 'ZZ-RING f (list 'INTERVAL 1 n)) '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ))
(define (nt4-restrict! q v)
  ;; (FORALL ntq_ (IMPLIES (IN ntq_ (INTERVAL 1 (succ v))) (IN (q ntq_) ZZ))) in context: land the same over INTERVAL(1, v)
  (dk-have! (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 v)) (list 'IN (list q 'ntq_) 'ZZ)))
    (lambda ()
      (let ((i (dk-di-var!)))
        (fact 'interval-elt-in-nn 1 v i) (fact 'interval-lo 1 v i) (fact 'interval-hi 1 v i)
        (dk-have! (list '<= i (list 'succ v)) (lambda () (dk-nn! (list '<= i v))))
        (dk-apply! (dk-cite! 'interval-mem-intro 1 (list 'succ v) i))
        (dk-apply! (dk-ctx-form (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 (list 'succ v))) (list 'IN (list q 'ntq_) 'ZZ)))) i)
        (ass)))))
(define (nt4-top! v)
  ;; land (IN (succ v) (INTERVAL 1 (succ v)))
  (fact 'nn-succ-closed v)
  (dk-have! (list '<= 1 (list 'succ v)) (lambda () (dk-nn!)))
  (dk-have! (list '<= (list 'succ v) (list 'succ v)) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'interval-mem-intro 1 (list 'succ v) (list 'succ v))))
(define (nt4-absl q) (list 'VNB-LAMBDA 'nti_ 'NN (list 'abs (list q 'nti_))))
(define (nt4-ptq q n) (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 n)) (list 'IN (list q 'ntq_) 'ZZ))))
(define (nt4-dvd p a n) (list 'FORSOME 'nti_ (list 'AND (list 'IN 'nti_ (list 'INTERVAL 1 n)) (list 'ZZ-DIVIDES p (list a 'nti_)))))
(define (nt4-ufd!)
  (nt4-zzr!)
  (dk-cite! 'zz-is-commutative-ring)
  (dk-cite! 'zz-is-euclidean-domain)
  (dk-apply! (dk-cite! 'euclidean-domain-is-ufd) 'ZZ-RING)
