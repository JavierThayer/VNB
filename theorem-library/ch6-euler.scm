        (let* ((a1 (list '- (list '* z h))) (a2 (list '- (list '* z (c6g-u n)))) (a3 (list '- (list '* z (list '+ h (c6g-u n))))))
          (for-each (lambda (r) (c6-rr! r) (fact 'rr-subset-cc r) (c6f-cc-and-closed! 'cc-mul-closed z r) (c6-cc! (list '- (list '* z r))))
                    (list h (c6g-u n) (list '+ h (c6g-u n))))
