            (lambda () (let* ((hv (dk-name! h 'RR)) (uv (dk-name! (c6g-u n) 'RR))) (subst (list '= h hv)) (subst (list '= (c6g-u n) uv)) (crs))))
          (subst (list '= a3 (list '+ a1 a2)))
