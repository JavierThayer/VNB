;;; ---------------------------------------------------------------- the value of a product function is the limit of its partial products
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-gamma.scm, ch6/ch6-mult.scm, ch6/ch6-prod.scm, ch6/ch6-weier.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6-pow2! x)                           ; (= (power x 2) (* x x)), x in CC
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-two-is-succ-succ-zero) (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
            (c6-and! (list 'IN x 'CC) '(IN (succ 0) NN)) (subst (dk-fact! 'power-succ x '(succ 0)))
            (c6-and! (list 'IN x 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ x 0))
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (c6-csps f n) (list 'CC-SERIES-PARTIAL-SUM f n))
(define (c6-csps-typ! f n) (dk-cite! 'cc-series-partial-sum-in-cc n f) (c6-csps f n))
(define (c6-csps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-csps-typ! f n) (fact 'fun-apply-type-c f 'NN 'CC n)
  (dk-cite! 'cc-series-partial-sum-succ f n))
(define (c6-mulf f g) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list f 'c6k_) (list g 'c6k_))))
(define (c6-mulf-typ! f g)
  (c6-lam-typ! (c6-mulf f g) 'CC (lambda (k) (fact 'fun-apply-type-c f 'NN 'CC k) (fact 'fun-apply-type-c g 'NN 'CC k) (c6-cc! (list '* (list f k) (list g k))))))
(define (c6-ppseq f) (list 'VNB-LAMBDA 'c6n_ 'NN (list 'PPROD f 'c6n_)))
(define (c6-famty u f) (list 'IN f (list 'FUN 'NN (list 'FUN u 'CC))))
(define (c6-fv! f u k y)                        ; f in FUN(NN, FUN(u, CC)), k in NN, y in u: f_k in FUN(u, CC), f_k(y) in CC
  (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (fact 'fun-apply-type-c (list f k) u 'CC y))
(define (c6-opx f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list (list f 'c6k_) x))))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-coef w) (list 'VNB-LAMBDA 'clhk_ 'NN (list '* (list 'RECIP-STAR 'clhk_) (list 'power w 'clhk_))))
(define (c6w-qs w m) (list 'CC-SERIES-PARTIAL-SUM (c6w-coef w) m))
(define (c6w-e n w) (list '* (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n)))))
(define (c6w-exp-typ! q) (if (not (dk-asm? (list 'IN (list 'CC-EXP q) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges q)))))
(define (c6w-e-typ! n w)
  (let ((q (c6w-qs w (list 'succ n))))
    (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w))
    (c6w-exp-typ! q) (fact 'cc-one-in) (c6-cc! (list '- 1 w))
    (if (not (dk-asm? (list 'IN (c6w-e n w) 'CC))) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP q)))))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-pow-typ! w m)                       ; w in CC, m in NN: w^m in CC
  (c6-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (c6w-coef-typ! w)                         ; w in CC: k -> RECIP-STAR(k) w^k in FUN(NN, CC)
  (c6-lam-typ! (c6w-coef w) 'CC (lambda (k) (c6-nn! k) (fact 'recip-star-in-rr k) (fact 'rr-subset-cc (list 'RECIP-STAR k))
                                    (c6w-pow-typ! w k) (c6f-cc-and-closed! 'cc-mul-closed (list 'RECIP-STAR k) (list 'power w k)))))
(define (c6w-el c n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (c6w-e n (list '* 'c6x_ c)) 1)))
(define (c6w-induct-on! v base step)             ; after (ni) on the variable V: the step leaf is the one whose goal mentions V
  (let* ((ls (dk-open-leaves)) (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) v)) ls))
         (b (find-first (lambda (l) (not (eq? l st))) ls)))
    (if (not (and b st)) (error "c6w-induct-on!: leaves not found"))
    (dk-focus! b) (base) (dk-focus! st) (step)))
(define (c6w-fam a mu) (list 'VNB-LAMBDA 'c6k_ 'NN (c6w-el (list 'recip (list a 'c6k_)) (list mu 'c6k_))))
(define (c6m-cc-open!)
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (let ((oi (c6-cite! 'cc-ms-open-iff 'CC))) (dk-have! (list 'IS-OPEN c6-nfm 'CC) (lambda () (keep oi '(IS-OPEN CC-MS CC)) (prop))))
  (dk-have! '(SUBSET CC CC) (lambda () (let ((iff (dk-cite! 'subset-def 'CC 'CC)))
                                         (dk-have! (caddr iff) (lambda () (dk-di-var!) (dk-ass!)))
                                         (keep iff (caddr iff)) (prop)))))
(define c6g-hr '(VNB-LAMBDA egj_ NN (recip (succ egj_))))
(define c6g-es (list 'VNB-LAMBDA 'egn_ 'NN (list '- (list 'SERIES-PARTIAL-SUM c6g-hr '(succ egn_)) '(LOG (succ egn_)))))
(define (c6g-nn! n) (fact 'nn-succ-closed n) (c6-nn! n) (c6-nn! (list 'succ n)))
(define (c6g-pos! t)                              ; t = succ(..) in NN: 0 < t, t /= 0, recip t in RR, > 0
  (let ((pred (cadr t)))
    (c6g-nn! pred) (fact 'nn-zero-le pred) (fact 'nn-succ-plus-one pred) (c6-nn! pred)
    (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '<= 0 pred) (list '= t (list '+ pred 1)))))
    (c6-cite! 'rr-pos-ne-zero t) (c6-and! (list 'IN t 'RR) (list 'NOT (list '= t 0))) (fact 'rr-recip-closed t) (c6-cite! 'rr-recip-pos t)
    (fact 'rr-recip-inverse t) (fact 'log-in-rr t)))
(define (c6g-hr-typ!) (c6-lam-typ! c6g-hr 'RR (lambda (k) (c6g-pos! (list 'succ k)))))
(define (c6g-sps-succ! f n)                       ; f in FUN(NN, RR) in context: S(f, succ n) == S(f, n) + f(n)
  (c6-nn! n) (fact 'series-partial-sum-in-rr n f) (fact 'fun-apply-type-c f 'NN 'RR n)
  (dk-cite! 'series-partial-sum-succ f n))
(define (c6g-val! f n)                           ; f(n) = <its beta-reduct>, landed; returns the equation
  (fact 'fun-apply-type-c f 'NN 'RR n)
  (let* ((body (caddr (cdr f))) (val (subst-free (cadr f) n body)) (e (list '= (list f n) val)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (c6f-rfl-close!))))
    e))
(define (c6g-one!)                               ; succ 0 = 1, LOG 1 = 0, recip 1 = 1 in context
  (fact 'nn-zero-in) (c6g-pos! '(succ 0)) (fact 'nn-succ-plus-one 0) (fact 'rr-one-in)
  (dk-have! '(= (succ 0) 1) (lambda () (dk-ineq! '(= (succ 0) (+ 0 1)))))
  (fact 'log-one) (fact 'rr-recip-inverse 1) (fact 'rr-recip-closed 1)
  (dk-have! '(= (recip 1) 1) (lambda () (dk-ineq! '(= (* 1 (recip 1)) 1)))))
(define (c6g-u n) (list 'recip (list 'succ n)))
(define c6g-a '(VNB-LAMBDA c6gk_ NN (- (succ c6gk_))))
(define c6g-mu '(VNB-LAMBDA c6gk_ NN 1))
(define (c6g-a-typ!)
  (c6-lam-typ! c6g-a 'CC (lambda (k) (c6g-pos! (list 'succ k)) (c6-rr! (list '- (list 'succ k))) (fact 'rr-subset-cc (list '- (list 'succ k))))))
(define (c6g-mu-typ!) (c6-lam-typ! c6g-mu 'NN (lambda (k) (fact 'nn-one-in))))
(define (c6g-gp p) (list 'VNB-LAMBDA 'egz_ 'CC (list '* (list '* 'egz_ '(CC-EXP (* EULER-GAMMA egz_))) (list p 'egz_))))
(define c6g-fam (c6w-fam c6g-a c6g-mu))
(define c6g-p (list 'PROD-FUN 'CC c6g-fam))
;;; ---- end of copied helpers ----

(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ c6u_)
      (list 'CONVERGES-TO 'CC-MS (c6-ppseq (c6-opx 'c6f_ 'c6x_)) '((PROD-FUN c6u_ c6f_) c6x_)))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (x (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (eq? (caddr q) u))) new)))
       (ox (c6-opx f x)) (pv (list 'PROD-VALUE ox)))
  (let ((p611 (c6-cite! 'prop-6-11 u f)))
    (dk-split-all! (list (dk-apply! p611 x))))
  (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
  (let ((sp0 (c6-cite! 'prod-value-spec ox)))
    (dk-split-all! (list sp0))
    (c6-cite! 'prod-partial-converges ox pv)
    (mac 'PROD-FUN)
    (dk-lam-b!)
    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
(qed 'prod-fun-partial-limit)

;;; ---------------------------------------------------------------- the genus-1 factor at a_k = -(k + 1)
;;; Q_1(w) = w
(sp (make-wff (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list '= (c6w-qs 'c6z_ '(succ 1)) 'c6z_)))))
(let* ((w (dk-di-var!)) (cf (c6w-coef w)))
  (c6w-cc-setup!) (fact 'nn-one-in) (c6w-coef-typ! w)
  (subst (c6-csps-succ! cf 1))
  (dk-have! (list '= (c6-csps cf 1) (list cf 0))
    (lambda ()
      (fact 'nn-zero-in) (fact 'nn-succ-plus-one 0) (c6-nn! 0) (fact 'nn-succ-closed 0) (c6-nn! '(succ 0))
      (dk-have! '(= 1 (succ 0)) (lambda () (dk-ineq! '(= (succ 0) (+ 0 1)))))
      (subst '(= 1 (succ 0)))
      (subst (c6-csps-succ! cf 0))
      (subst (dk-cite! 'cc-series-partial-sum-zero cf))
      (fact 'fun-apply-type-c cf 'NN 'CC 0)
      (crs)))
  (subst (list '= (c6-csps cf 1) (list cf 0)))
  (fact 'recip-star-in-rr 0) (fact 'recip-star-in-rr 1)
  (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
  (c6-cite! 'recip-star-value 1) (fact 'rr-recip-one)
  (dk-lam-b!)
  (subst (dk-fact! 'recip-star-zero))
  (c6-and! (list 'IN w 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ w 0))
  (subst (dk-fact! 'power-zero w))
  (subst (list '= '(RECIP-STAR 1) '(recip 1))) (subst '(= (recip 1) 1))
  (crs))
(qed 'weier-q-one)

;;; 1 + f_k(z) = (1 + z/(k+1)) e^{-z/(k+1)} for the family of RECIP-GAMMA
(define (c6e-q z k) (list '+ 1 (list '* z (c6g-u k))))
(define (c6e-ex z k) (list 'CC-EXP (list '- (list '* z (c6g-u k)))))
(sp (make-wff (list 'FORALL 'egk_ (list 'IMPLIES '(IN egk_ NN) (list 'FORALL 'egz_ (list 'IMPLIES '(IN egz_ CC)
  (list '= (list '+ 1 (list (list c6g-fam 'egk_) 'egz_)) (list '* (c6e-q 'egz_ 'egk_) (c6e-ex 'egz_ 'egk_)))))))))
(let* ((new (c6-steps!)) (k (c6-var new 'NN)) (z (c6-var new 'CC)) (s (list 'succ k)) (ns (list '- s))
       (u (c6g-u k)) (vv (list '- u)) (w (list '* z (list 'recip ns))))
  (c6w-cc-setup!) (c6g-pos! s) (c6-rr! ns) (c6-rr! vv) (fact 'rr-subset-cc ns) (fact 'rr-subset-cc u) (fact 'rr-subset-cc vv)
  (dk-have! (list 'NOT (list '= ns 0)) (lambda () (di) (dk-absurd! (list '= ns 0) (list '< 0 s))))
  (c6-and! (list 'IN ns 'RR) (list 'NOT (list '= ns 0))) (fact 'rr-recip-closed ns) (fact 'rr-subset-cc (list 'recip ns))
  ;; recip(-s) = -recip(s)
  (let ((rn (list '= (list 'recip ns) vv)))
    (dk-have! rn
      (lambda ()
        (let ((uu (dk-name! u 'RR)))
          (dk-have! (list '= 1 (list '* ns (list '- uu)))
            (lambda () (let ((e (dk-rewrite-h! (list '= (list '* s u) 1) u uu)))
                         (dk-have! (list '= (list '* ns (list '- uu)) (list '* s uu)) (lambda () (crs)))
                         (c6-rr! (list '* s uu)) (c6-rr! (list '* ns (list '- uu)))
                         (dk-ineq! e (list '= (list '* ns (list '- uu)) (list '* s uu))))))
          (c6-rr! (list '- uu))
          (let ((sv (c6-cite! 'rr-recip-solve ns 1 (list '- uu))))
            (subst (list '= u uu))
            (c6-rr! (list '* (list 'recip ns) 1))
            (dk-ineq! sv)))))
    (c6g-mu-typ!) (c6g-a-typ!)
    (fact 'nn-one-in)
    (c6f-cc-and-closed! 'cc-mul-closed z (list 'recip ns))
    (c6w-e-typ! 1 w)
    (dk-lam-b!)
    (subst (c6-cite! 'weier-q-one w))
    (subst rn)
    (let ((ww (list '* z vv)))
      (c6f-cc-and-closed! 'cc-mul-closed z vv)
      (dk-have! (list '= ww (list '- (list '* z u))) (lambda () (crs)))
      (subst (list '= ww (list '- (list '* z u))))
      (c6f-cc-and-closed! 'cc-mul-closed z u) (c6-cc! (list '- (list '* z u)))
      (c6w-exp-typ! (list '- (list '* z u)))
      (let ((ev (dk-name! (list 'CC-EXP (list '- (list '* z u))) 'CC)))
        (subst (list '= (list 'CC-EXP (list '- (list '* z u))) ev))
        (let ((uu (dk-name! u 'RR)))
          (subst (list '= u uu))
          (crs))))))
(qed 'gamma-factor-value)

;;; prod_{k<m} e^{-z/(k+1)} = e^{-z H_m}
(define (c6e-ee z) (list 'VNB-LAMBDA 'eek_ 'NN (c6e-ex z 'eek_)))
(sp (make-wff (list 'FORALL 'egm_ (list 'IMPLIES '(IN egm_ NN) (list 'FORALL 'egz_ (list 'IMPLIES '(IN egz_ CC)
  (list '= (list 'PPROD (c6e-ee 'egz_) 'egm_) (list 'CC-EXP (list '- (list '* 'egz_ (list 'SERIES-PARTIAL-SUM c6g-hr 'egm_)))))))))))
(define (c6e-ee-typ! z)
  (c6-lam-typ! (c6e-ee z) 'CC (lambda (k) (c6g-pos! (list 'succ k)) (fact 'rr-subset-cc (c6g-u k))
                                 (c6f-cc-and-closed! 'cc-mul-closed z (c6g-u k)) (c6-cc! (list '- (list '* z (c6g-u k))))
                                 (c6w-exp-typ! (list '- (list '* z (c6g-u k)))))))
(ni)
(c6w-induct-on! 'egm_
  (lambda ()
    (let* ((new (c6-steps!)) (z (c6-var new 'CC)))
      (c6w-cc-setup!) (c6g-hr-typ!) (c6e-ee-typ! z)
      (subst (dk-cite! 'pprod-zero (c6e-ee z)))
      (subst (dk-cite! 'series-partial-sum-zero c6g-hr))
      (fact 'rr-subset-cc 0)
      (dk-have! (list '= (list '- (list '* z 0)) 0) (lambda () (crs)))
      (subst (list '= (list '- (list '* z 0)) 0))
      (subst (dk-fact! 'cc-exp-zero))
      (c6f-rfl-close!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (z (c6-var new 'CC)) (sn (list 'succ n))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
           (ee (c6e-ee z)) (h (list 'SERIES-PARTIAL-SUM c6g-hr n)))
      (c6w-cc-setup!) (c6g-hr-typ!) (c6e-ee-typ! z) (fact 'nn-succ-closed n) (c6g-pos! sn)
      (let ((ihe (dk-apply! ih z)))
