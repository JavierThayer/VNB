;;; ---------------------------------------------------------------- r_k -> 0 real ==> e^{z r_k} -> 1
(define (c6e-rr-near! cv r)                    ; (CONVERGES-TO RR-MS r 0) in context: the eps-universal
  (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO cv))))
  (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'DIST) (dk-contains? q r))) (dk-asms)))
(sp (make-wff '(FORALL egz_ (IMPLIES (IN egz_ CC) (FORALL egr_ (IMPLIES (IN egr_ (FUN NN RR))
  (IMPLIES (CONVERGES-TO RR-MS egr_ 0) (CONVERGES-TO CC-MS (VNB-LAMBDA egk_ NN (CC-EXP (* egz_ (egr_ egk_)))) 1))))))))
(let* ((new (c6-steps!)) (z (c6-var new 'CC)) (r (c6-var new '(FUN NN RR)))
       (cv (find-first (lambda (q) (dk-head-is? q 'CONVERGES-TO)) new))
       (sq (list 'VNB-LAMBDA 'egk_ 'NN (list 'CC-EXP (list '* z (list r 'egk_)))))
       (al (list 'magnitude z)) (gam (list '+ al 1)) (rg (list 'recip gam)))
  (c6-pts!) (c6w-cc-setup!) (fact 'rr-is-metric-space)
  (c6-lam-typ! sq 'CC (lambda (k) (fact 'fun-apply-type-c r 'NN 'RR k) (fact 'rr-subset-cc (list r k))
                         (c6f-cc-and-closed! 'cc-mul-closed z (list r k)) (c6w-exp-typ! (list '* z (list r k)))))
  (c6-mag! z) (c6-rr! gam) (dk-have! (list '< 0 gam) (lambda () (dk-ineq! (list '<= 0 al))))
  (c6-cite! 'rr-pos-ne-zero gam) (c6-and! (list 'IN gam 'RR) (list 'NOT (list '= gam 0)))
  (fact 'rr-recip-closed gam) (c6-cite! 'rr-recip-pos gam) (fact 'rr-recip-inverse gam)
  (let ((fa (c6e-rr-near! cv r)))
    (mac 'CONVERGES-TO)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-asm? (dk-goal)) (dk-ass!))
          ((dk-head-is? (dk-goal) 'IN) (subst '(== (PTS CC-MS) CC)) (dk-ass!))
          (#t
           (let* ((ne (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) ne)))
                  (body!
                    (lambda (ep)                ; 0 < ep <= 1, ep <= eps in context
                      (let ((d (list '* ep (list '* 1/2 rg))))
                        (c6-rr! (list '* 1/2 rg)) (c6-rr! d)
                        (dk-have! (list '< 0 (list '* 1/2 rg)) (lambda () (dk-ineq! (list '< 0 rg))))
                        (c6-cite! 'rr-mul-pos ep (list '* 1/2 rg)) (c6-cite! 'rr-pos-rr-of-lt d)
                        (let* ((nv (c6-sk! (dk-apply! fa d)))
                               (bu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 'DIST))) (dk-asms))))
                          (c6-nn! nv)
                          (ew nv)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal)) (dk-ass!)
                                (let* ((nk (c6-steps!)) (n (find-first (lambda (v) (not (eq? v nv))) (c6-vars nk 'NN)))
                                       (rn (list r n)) (w (list '* z rn)) (ew0 (list 'CC-EXP w))
                                       (mw (list 'magnitude w)) (ar (list 'abs rn)))
                                  (fact 'fun-apply-type-c r 'NN 'RR n) (fact 'rr-subset-cc rn)
                                  (c6f-cc-and-closed! 'cc-mul-closed z rn) (c6w-exp-typ! w) (c6-mag! w)
                                  (let* ((d0 (begin (dk-cite! 'rr-ms-dist rn 0) (dk-apply! bu n)))
                                         (d1 (dk-rewrite-h! d0 (list (list 'DIST 'RR-MS) rn 0) (list 'abs (list '- rn 0))))
                                         (mm (c6-cite! 'cc-magnitude-mul z rn))
                                         (ma (c6-cite! 'rr-magnitude-is-abs rn)))
                                    (c6-rr! ar) (c6-rr! (list 'abs (list '- rn 0)))
                                    (fact 'rr-abs-nonneg rn)
                                    (c6-rr! (list '- rn 0)) (dk-have! (list '= (list '- rn 0) rn) (lambda () (dk-ineq!)))
                                    (dk-rewrite-h! d1 (list '- rn 0) rn)
                                    ;; |w| <= |z| d <= gam d = ep / 2
                                    (let* ((k1 (c6-cite! 'rr-mul-le-right ar d al))
                                           (k2 (begin (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '< 0 d))))
                                                      (dk-have! (list '<= al gam) (lambda () (dk-ineq!)))
                                                      (c6-cite! 'rr-mul-le-right al gam d)))
                                           (e1 (list '= (list '* gam d) (list '* ep 1/2))))
                                      (dk-have! e1 (lambda () (let* ((gv (dk-name! rg 'RR)))
                                                                (subst (list '= rg gv))
                                                                (let ((ii (dk-rewrite-h! (list '= (list '* gam rg) 1) rg gv)))
                                                                  (dk-have! (list '= (list '* gam (list '* ep (list '* 1/2 gv))) (list '* (list '* ep 1/2) (list '* gam gv)))
                                                                    (lambda () (crs)))
                                                                  (subst (list '= (list '* gam (list '* ep (list '* 1/2 gv))) (list '* (list '* ep 1/2) (list '* gam gv))))
                                                                  (subst (list '= (list '* gam gv) 1))
                                                                  (crs)))))
                                      (c6-rr! (list '* ar al)) (c6-rr! (list '* d al)) (c6-rr! (list '* al d)) (c6-rr! (list '* gam d))
                                      (dk-have! (list '= (list '* d al) (list '* al d)) (lambda () (crs)))
                                      (dk-have! (list '<= mw (list '* ep 1/2))
                                        (lambda () (let ((mm2 (dk-rewrite-h! mm (list 'magnitude rn) ar)))
                                                      (c6-rr! (list '* al ar))
                                                      (dk-have! (list '= (list '* al ar) (list '* ar al)) (lambda () (crs)))
                                                      (c6-ineq*! k1 k2 e1 mm2 (list '= (list '* d al) (list '* al d)) (list '= (list '* al ar) (list '* ar al))))))
                                      (dk-have! (list '<= mw 1) (lambda () (dk-ineq! (list '<= mw (list '* ep 1/2)) (list '<= ep 1))))
                                      (let* ((near (c6-cite! 'cc-exp-near-one w))
                                             (p2 (list '= (list 'power mw 2) (list '* mw mw))))
                                        (fact 'rr-subset-cc mw)
                                        (dk-have! p2 (lambda () (c6-pow2! mw) (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
                                        (let* ((sq2 (c6-cite! 'rr-mul-le-right mw 1 mw))
                                               (a1 (list '- (list '- ew0 1) w)) (a2 (list '- ew0 1)))
                                          (c6-cc! a1) (c6-cc! a2) (c6-mag! a1) (c6-mag! a2)
                                          (c6-and! (list 'IN a1 'CC) (list 'IN w 'CC))
                                          (c6-cc! (list '+ a1 w))
                                          (dk-have! (list '= (list '+ a1 w) a2) (lambda () (crs)))
                                          (let ((tri (dk-rewrite-h! (dk-fact! 'cc-magnitude-triangle a1 w) (list '+ a1 w) a2)))
                                            (fact 'fun-apply-type-c sq 'NN 'CC n)
                                            (subst (dk-cite! 'cc-ms-dist (list sq n) 1))
                                            (dk-lam-b!)
                                            (c6-ineq*! tri (dk-rewrite-h! near (list 'power mw 2) (list '* mw mw)) sq2
                                                       (list '<= mw (list '* ep 1/2)) (list '<= ep eps))))))))))))))))
             (fact 'rr-pos-rr-in-rr eps) (fact 'rr-lt-of-pos-rr eps)
             (use-em (list '<= eps 1)
               (lambda () (dk-have! (list '<= eps eps) (lambda () (dk-ineq!))) (body! eps))
               (lambda () (dk-have! '(< 0 1) (lambda () (dk-ineq!))) (fact 'rr-one-in)
                          (dk-have! (list '<= 1 eps) (lambda () (c6-cite! 'rr-le-total 1 eps) (keep (list 'OR (list '<= 1 eps) (list '<= eps 1)) (list 'NOT (list '<= eps 1))) (prop)))
                          (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
                          (body! 1))))))))))
(qed 'exp-real-null)

;;; ---------------------------------------------------------------- D_m = gamma + log(m + 1) - H_m -> 0
(define c6e-d '(VNB-LAMBDA egd_ NN (- (+ EULER-GAMMA (LOG (succ egd_))) (SERIES-PARTIAL-SUM (VNB-LAMBDA egj_ NN (recip (succ egj_))) egd_))))
(sp (make-wff (list 'CONVERGES-TO 'RR-MS c6e-d 0)))
(let* ((cst '(VNB-LAMBDA n NN EULER-GAMMA))
       (ff (list 'VNB-LAMBDA 'egf_ 'NN (list '- 'EULER-GAMMA (list '- (list 'SERIES-PARTIAL-SUM c6g-hr '(succ egf_)) '(LOG (succ egf_))))))
       (rn '(VNB-LAMBDA k NN (recip (+ k 1)))))
  (fact 'euler-gamma-in-rr) (fact 'rr-zero-in) (fact 'rr-one-in) (c6g-hr-typ!)
  (c6-lam-typ! cst 'RR (lambda (k) (dk-ass!)))
  (c6-lam-typ! c6g-es 'RR (lambda (k) (c6g-pos! (list 'succ k)) (fact 'series-partial-sum-in-rr (list 'succ k) c6g-hr)
                             (c6-rr! (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ k)) (list 'LOG (list 'succ k))))))
  (c6-lam-typ! ff 'RR (lambda (k) (c6g-pos! (list 'succ k)) (fact 'series-partial-sum-in-rr (list 'succ k) c6g-hr)
                         (c6-rr! (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ k)) (list 'LOG (list 'succ k))))
                         (c6-rr! (list '- 'EULER-GAMMA (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ k)) (list 'LOG (list 'succ k)))))))
  (c6-lam-typ! rn 'RR (lambda (k) (c6-nn! k) (c6-rr! (list '+ k 1)) (fact 'nn-succ-plus-one k) (c6g-pos! (list 'succ k))
                         (subst (list '= (list '+ k 1) (list 'succ k))) (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
  (c6-lam-typ! c6e-d 'RR (lambda (k) (c6g-pos! (list 'succ k)) (fact 'series-partial-sum-in-rr k c6g-hr)
                            (c6-rr! (list '+ 'EULER-GAMMA (list 'LOG (list 'succ k))))
                            (c6-rr! (list '- (list '+ 'EULER-GAMMA (list 'LOG (list 'succ k))) (list 'SERIES-PARTIAL-SUM c6g-hr k)))))
  (c6-cite! 'euler-gamma-limit)
  (c6-cite! 'rr-const-converges-to 'EULER-GAMMA)
  (c6-cite! 'rr-recip-succ-converges-to-zero)
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list ff 'j_) (list '- (list cst 'j_) (list c6g-es 'j_)))))
    (lambda () (let ((j (dk-di-var!)))
                 (c6g-pos! (list 'succ j)) (fact 'series-partial-sum-in-rr (list 'succ j) c6g-hr)
                 (c6-rr! (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ j)) (list 'LOG (list 'succ j))))
                 (c6-rr! (list '- 'EULER-GAMMA (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ j)) (list 'LOG (list 'succ j)))))
                 (dk-lam-b!) (c6f-rfl-close!))))
  (let ((l1 (c6-cite! 'rr-limit-sub cst c6g-es ff 'EULER-GAMMA 'EULER-GAMMA)))
    (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list c6e-d 'j_) (list '+ (list ff 'j_) (list rn 'j_)))))
      (lambda () (let* ((j (dk-di-var!)) (sj (list 'succ j)))
                   (c6-nn! j) (c6g-pos! sj) (fact 'nn-succ-plus-one j) (c6-rr! (list '+ j 1))
                   (fact 'series-partial-sum-in-rr j c6g-hr) (fact 'series-partial-sum-in-rr sj c6g-hr)
                   (let* ((ss (c6g-sps-succ! c6g-hr j)) (v (c6g-val! c6g-hr j)))
                     (dk-lam-b!)
                     (subst (list '= (list '+ j 1) sj))
                     (subst ss) (subst v)
                     (dk-ineq!)))))
    (c6-rr! '(- EULER-GAMMA EULER-GAMMA))
    (let ((l2 (c6-cite! 'rr-limit-add ff rn c6e-d '(- EULER-GAMMA EULER-GAMMA) 0)))
      (dk-have! '(= (+ (- EULER-GAMMA EULER-GAMMA) 0) 0) (lambda () (dk-ineq!)))
      (dk-rewrite-h! l2 '(+ (- EULER-GAMMA EULER-GAMMA) 0) 0)
      (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
(qed 'euler-d-null)

;;; ---------------------------------------------------------------- EULER'S LIMIT (183), for 1/Gamma:
;;; RECIP-GAMMA(z) = lim_m z prod_{k<m} (1 + z/(k+1)) e^{-z log(m+1)}
(define (c6e-qq z) (list 'VNB-LAMBDA 'egq_ 'NN (c6e-q z 'egq_)))
(define (c6e-eul z) (list 'VNB-LAMBDA 'egm_ 'NN (list '* (list '* z (list 'PPROD (c6e-qq z) 'egm_)) (list 'CC-EXP (list '- (list '* z '(LOG (succ egm_))))))))
(define (c6e-fam-typ!)                           ; the RECIP-GAMMA family in FUN(NN, FUN(CC, CC))
  (let* ((a c6g-a) (mu c6g-mu) (anz (c6-cite! 'gamma-zeros-nonzero))
         (ak! (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! anz k)
                          (c6-and! (list 'IN (list a k) 'CC) (list 'NOT (list '= (list a k) 0))) (fact 'cc-recip-closed (list a k)))))
    (c6-lam-typ! c6g-fam '(FUN CC CC)
      (lambda (k) (ak! k)
        (c6f-typ-on! (c6w-el (list 'recip (list a k)) (list mu k)) 'CC
          (lambda (x) (let ((xc (list '* x (list 'recip (list a k)))))
                        (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k))) (c6w-e-typ! (list mu k) xc)
                        (c6-cc! (list '- (c6w-e (list mu k) xc) 1))))))))
  (list 'IN c6g-fam '(FUN NN (FUN CC CC))))
(define (c6e-cc-neg-mul! z r)                    ; r real typed: -(z r) in CC
  (c6-rr! r) (fact 'rr-subset-cc r) (c6f-cc-and-closed! 'cc-mul-closed z r) (c6-cc! (list '- (list '* z r))) (list '- (list '* z r)))

(sp (make-wff (list 'FORALL 'egz_ (list 'IMPLIES '(IN egz_ CC) (list 'CONVERGES-TO 'CC-MS (c6e-eul 'egz_) '(RECIP-GAMMA egz_))))))
(let* ((z (dk-di-var!)) (qq (c6e-qq z)) (ee (c6e-ee z)) (eg (list 'CC-EXP (list '* 'EULER-GAMMA z))) (cz (list '* z eg)))
  (c6w-cc-setup!) (c6m-cc-open!) (fact 'nn-is-set) (c6g-one!)
  (fact 'euler-gamma-in-rr) (fact 'rr-subset-cc 'EULER-GAMMA) (c6f-cc-and-closed! 'cc-mul-closed 'EULER-GAMMA z) (c6w-exp-typ! (list '* 'EULER-GAMMA z))
  (c6f-cc-and-closed! 'cc-mul-closed z eg)
  (c6g-a-typ!) (c6g-mu-typ!)
  (fact 'gamma-zeros-nonzero) (fact 'gamma-zeros-grow) (fact 'gamma-zeros-h167)
  (c6e-fam-typ!)
  (dk-split-all! (list (c6-cite! 'theorem-6-20 c6g-a c6g-mu)))
  (dk-cite! 'holomorphic-on-in-fun 'CC c6g-p)
  (let* ((pf (dk-name! c6g-fam '(FUN NN (FUN CC CC))))
         (pnc (dk-rewrite-h! (list 'PROD-NORMAL-ON-COMPACTA 'CC c6g-fam) c6g-fam pf))
         (pin (dk-rewrite-h! (list 'IN c6g-p '(FUN CC CC)) c6g-fam pf))
         (phol (dk-rewrite-h! (list 'HOLOMORPHIC-ON 'CC c6g-p) c6g-fam pf))
         (h (c6-opx pf z)) (pg (list (list 'PROD-FUN 'CC pf) z)))
    (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (fact 'carrier-is-open 'CC-MS) (dk-ass!)))
    (c6-lam-typ! h 'CC (lambda (k) (c6-fv! pf 'CC k z) (c6-cc! (list '+ 1 (list (list pf k) z)))))
    (c6-lam-typ! qq 'CC (lambda (k) (c6g-pos! (list 'succ k)) (fact 'rr-subset-cc (c6g-u k))
                           (c6f-cc-and-closed! 'cc-mul-closed z (c6g-u k)) (c6-cc! (c6e-q z k))))
    (c6e-ee-typ! z)
    (c6-mulf-typ! qq ee)
    ;; h = qq . ee as functions
    (dk-fun-ext! h (c6-mulf qq ee) 'NN 'CC #f #f
      (lambda (v)
        (let ((fv (dk-rewrite-h! (c6-cite! 'gamma-factor-value v z) c6g-fam pf)))
          (c6g-pos! (list 'succ v)) (c6-fv! pf 'CC v z)
          (fact 'rr-subset-cc (c6g-u v)) (c6f-cc-and-closed! 'cc-mul-closed z (c6g-u v)) (c6-cc! (c6e-q z v))
          (c6e-cc-neg-mul! z (c6g-u v)) (c6w-exp-typ! (list '- (list '* z (c6g-u v))))
          (c6f-cc-and-closed! 'cc-mul-closed (c6e-q z v) (c6e-ex z v))
          (dk-lam-b!)
          (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
    (let* ((lim1 (c6-cite! 'prod-fun-partial-limit 'CC pf z))
           (aa (list 'VNB-LAMBDA 'egm_ 'NN (list '* cz (list 'PPROD h 'egm_))))
           (bb (list 'VNB-LAMBDA 'egk_ 'NN (list 'CC-EXP (list '* z (list c6e-d 'egk_)))))
           (ps (c6-ppseq h)))
      (c6-lam-typ! ps 'CC (lambda (k) (dk-cite! 'pprod-in-cc k h)))
      (c6-lam-typ! aa 'CC (lambda (k) (dk-cite! 'pprod-in-cc k h) (c6f-cc-and-closed! 'cc-mul-closed cz (list 'PPROD h k))))
      (fact 'fun-apply-type-c (list 'PROD-FUN 'CC pf) 'CC 'CC z)
      ;; A -> cz PG
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list aa 'cpdj_) (list '+ (list '* cz (list ps 'cpdj_)) (list '* 0 (list ps 'cpdj_))))))
        (lambda () (let ((j (dk-di-var!))) (dk-cite! 'pprod-in-cc j h) (dk-lam-b!) (crs))))
      (let* ((la (c6-cite! 'cc-limit-lincomb ps ps aa pg pg cz 0))
             (lv (cadddr la))
             (dn (c6-cite! 'euler-d-null)))
        (c6g-hr-typ!)
        (c6-lam-typ! c6e-d 'RR (lambda (k) (c6g-pos! (list 'succ k)) (fact 'series-partial-sum-in-rr k c6g-hr)
                                  (c6-rr! (list '+ 'EULER-GAMMA (list 'LOG (list 'succ k))))
                                  (c6-rr! (list '- (list '+ 'EULER-GAMMA (list 'LOG (list 'succ k))) (list 'SERIES-PARTIAL-SUM c6g-hr k)))))
        (c6-cite! 'exp-real-null z c6e-d)
        (c6-lam-typ! bb 'CC (lambda (k) (fact 'fun-apply-type-c c6e-d 'NN 'RR k) (fact 'rr-subset-cc (list c6e-d k))
                               (c6f-cc-and-closed! 'cc-mul-closed z (list c6e-d k)) (c6w-exp-typ! (list '* z (list c6e-d k)))))
        (dk-have! (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'NOT (list '= (list bb 'c6i_) 0))))
          (lambda () (let ((i (dk-di-var!)))
                       (fact 'fun-apply-type-c c6e-d 'NN 'RR i) (fact 'rr-subset-cc (list c6e-d i))
                       (c6f-cc-and-closed! 'cc-mul-closed z (list c6e-d i))
                       (c6-cite! 'cc-exp-nonzero (list '* z (list c6e-d i)))
                       (fact 'fun-apply-type-c bb 'NN 'CC i)
                       (dk-lam-b-h! (list 'NOT (list '= (list 'CC-EXP (list '* z (list c6e-d i))) 0)))
                       (dk-lam-b!)
                       (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
        (c6-cc! lv)
        (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
        (let* ((qt (c6-cite! 'cc-limit-quotient aa bb lv 1))
               (qs (caddr qt)) (lq (cadddr qt))
               (eul (c6e-eul z)))
          (c6-lam-typ! qs 'CC (lambda (k) (fact 'fun-apply-type-c aa 'NN 'CC k) (fact 'fun-apply-type-c bb 'NN 'CC k)
                                 (dk-apply! (dk-ctx-form (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'NOT (list '= (list bb 'c6i_) 0))))) k)
                                 (c6-and! (list 'IN (list bb k) 'CC) (list 'NOT (list '= (list bb k) 0))) (fact 'cc-recip-closed (list bb k))
                                 (c6f-cc-and-closed! 'cc-mul-closed (list aa k) (list 'recip (list bb k)))))
          (c6-lam-typ! eul 'CC (lambda (k) (c6-lam-typ! qq 'CC (lambda (j) #t)) (dk-cite! 'pprod-in-cc k qq) (c6g-pos! (list 'succ k))
                                  (c6f-cc-and-closed! 'cc-mul-closed z (list 'PPROD qq k))
                                  (c6e-cc-neg-mul! z (list 'LOG (list 'succ k))) (c6w-exp-typ! (list '- (list '* z (list 'LOG (list 'succ k)))))
                                  (c6f-cc-and-closed! 'cc-mul-closed (list '* z (list 'PPROD qq k)) (list 'CC-EXP (list '- (list '* z (list 'LOG (list 'succ k))))))))
          ;; eul(m) = A(m) / B(m)
          (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list eul 'cpdj_) (list '+ (list '* 1 (list qs 'cpdj_)) (list '* 0 (list qs 'cpdj_))))))
            (lambda ()
              (let* ((m (dk-di-var!)) (sm (list 'succ m)) (lm (list 'LOG sm)) (hm (list 'SERIES-PARTIAL-SUM c6g-hr m))
                     (dm (list c6e-d m)) (xq (list 'PPROD qq m)) (xe (list 'PPROD ee m)) (ph (list 'PPROD h m))
                     (dv (list '- (list '+ 'EULER-GAMMA lm) hm))
                     (ep (list 'CC-EXP (list '- (list '* z lm)))) (eb (list 'CC-EXP (list '* z dv)))
                     (eh (list 'CC-EXP (list '- (list '* z hm)))))
                (c6g-pos! sm) (fact 'series-partial-sum-in-rr m c6g-hr) (fact 'fun-apply-type-c c6e-d 'NN 'RR m)
                (dk-cite! 'pprod-in-cc m qq) (dk-cite! 'pprod-in-cc m ee) (dk-cite! 'pprod-in-cc m h)
                (c6e-cc-neg-mul! z lm) (c6e-cc-neg-mul! z hm)
                (c6-rr! (list '+ 'EULER-GAMMA lm)) (c6-rr! dv) (fact 'rr-subset-cc dv) (c6f-cc-and-closed! 'cc-mul-closed z dv)
                (c6w-exp-typ! (list '- (list '* z lm))) (c6w-exp-typ! (list '- (list '* z hm))) (c6w-exp-typ! (list '* z dv))
                (c6-cite! 'cc-exp-nonzero (list '* z dv))
                (c6-and! (list 'IN eb 'CC) (list 'NOT (list '= eb 0))) (fact 'cc-recip-closed eb) (fact 'cc-recip-inverse eb)
                (fact 'fun-apply-type-c qs 'NN 'CC m)
                (dk-lam-b!)
                ;; the exponent identity: gamma z - z H = -(z L) + z D
                (let* ((x1 (list '* 'EULER-GAMMA z)) (x2 (list '- (list '* z hm))) (y1 (list '- (list '* z lm))) (y2 (list '* z dv)))
                  (c6-cc! (list '+ x1 x2)) (c6-cc! (list '+ y1 y2))
                  (dk-have! (list '= (list '+ x1 x2) (list '+ y1 y2))
                    (lambda ()
                               (let* ((hv (dk-name! hm 'RR)) (lv2 (dk-name! lm 'RR)))
                                 (subst (list '= hm hv)) (subst (list '= lm lv2)) (crs))))
                  (let ((ee1 (c6-cite! 'cc-exp-add x1 x2)) (ee2 (c6-cite! 'cc-exp-add y1 y2)))
                    (dk-have! (list '= (list '* eg eh) (list '* ep eb))
                      (lambda () (subst (list '= (list '* eg eh) (list 'CC-EXP (list '+ x1 x2))))
                                 (subst (list '= (list '+ x1 x2) (list '+ y1 y2)))
                                 (subst ee2) (c6f-rfl-close!)))))
                ;; PPROD(h, m) = PPROD(qq, m) e^{-z H_m}
                (let ((pm (c6-cite! 'pps-mul m qq ee)) (px (c6-cite! 'pprod-exp-harmonic m z)))
                  (subst (list '= h (c6-mulf qq ee)))
                  (subst pm) (subst px))
                (let* ((rb (dk-name! (list 'recip eb) 'CC)) (inv (dk-rewrite-h! (list '= (list '* eb (list 'recip eb)) 1) (list 'recip eb) rb))
                       (xv (dk-name! xq 'CC)) (gv (dk-name! eg 'CC)) (hv (dk-name! eh 'CC)) (pv (dk-name! ep 'CC)) (bv (dk-name! eb 'CC)))
                  (subst (list '= (list 'recip eb) rb)) (subst (list '= xq xv)) (subst (list '= eg gv)) (subst (list '= eh hv)) (subst (list '= ep pv)) (subst (list '= eb bv))
                  (let* ((i2 (dk-rewrite-h! inv eb bv))
                         (k3 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (list '= (list '* eg eh) (list '* ep eb))) eg gv) eh hv) ep pv) eb bv))
                         (gl (dk-goal)) (r0 (caddr gl)))
                    ;; rhs = z X (G H) R  -> z X (P B) R -> z X P (B R) -> z X P
                    (dk-have! (list '= r0 (list '* (list '* (list '* z xv) (list '* gv hv)) rb)) (lambda () (crs)))
                    (subst (list '= r0 (list '* (list '* (list '* z xv) (list '* gv hv)) rb)))
                    (subst k3)
                    (dk-have! (list '= (list '* (list '* (list '* z xv) (list '* pv bv)) rb) (list '* (list '* (list '* z xv) pv) (list '* bv rb))) (lambda () (crs)))
                    (subst (list '= (list '* (list '* (list '* z xv) (list '* pv bv)) rb) (list '* (list '* (list '* z xv) pv) (list '* bv rb))))
                    (subst i2)
                    (crs))))))
          (c6-and! '(IN 1 CC) '(NOT (= 1 0))) (fact 'cc-recip-closed 1) (c6f-cc-and-closed! 'cc-mul-closed lv '(recip 1))
          (let* ((fin (c6-cite! 'cc-limit-lincomb qs qs eul lq lq 1 0)) (lf (cadddr fin))
                 (rgz (list 'RECIP-GAMMA z)))
            (fact 'recip-gamma-def)
            (subst (dk-cite! 'apply-congruence-1 'RECIP-GAMMA (c6g-gp c6g-p) z))
            (subst (list '= c6g-fam pf))
            (c6-cite! 'gamma-g-holomorphic (list 'PROD-FUN 'CC pf))
            (dk-lam-b!)
            (dk-have! (list '= lf (list '* (list '* z eg) pg))
              (lambda ()
                (let* ((gv (dk-name! pg 'CC)) (ev (dk-name! eg 'CC)))
                  (subst (list '= pg gv)) (subst (list '= eg ev))
                  (subst '(= (recip 1) 1))
                  (crs))))
            (dk-rewrite-h! fin lf (list '* (list '* z eg) pg))
            (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))))
(qed 'euler-limit-183)
  
