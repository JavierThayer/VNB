(sp (make-wff (sdl-cs-pre `(IMPLIES (IN (CARD ,(sdl-cs 'rs 'rb)) NN)
  (FORALL g (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (IN (g x) CC)))
  (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL y (IMPLIES (IN y (CARR kf)) (= (g ((ADD kf) x y)) (* (g x) (g y)))))))
  (IMPLIES (FORALL y (IMPLIES (IN y (CARR kf)) (IMPLIES (<= ((FNRM kf) y) rs) (= (g y) 1))))
  (FORALL f (IMPLIES (IN f (FUN ,(sdl-cs 'rs 'rb) CC))
  (IMPLIES (FORALL C (IMPLIES (IN C ,(sdl-cs 'rs 'rb)) (= (f C) (g (CHOICE C)))))
  (FORALL h (IMPLIES (IN h (CARR kf)) (IMPLIES (<= ((FNRM kf) h) rb) (IMPLIES (NOT (= (g h) 1))
    (= (FINSUM ,sdl-ag f ,(sdl-cs 'rs 'rb)) 0))))))))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-metric-space-is-metric-space 'kf)
(sdl-ring!)
(let* ((cs (sdl-cs 'rs 'rb))
