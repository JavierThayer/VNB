  (dk-cite! 'nf-norm-neg 'kf 'h)
  (dk-have! `(<= ,(sdl-N nh) rb) (lambda () (subst `(= ,(sdl-N nh) ,(sdl-N 'h))) (dk-ass!)))
  (dk-have! `(= ((NEG kf) ,nh) h) (lambda () (sdl-crs! '(h))))
  (dk-have! `(IN ,sigma (FUN ,cs ,cs))
    (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-cite! 'sdl-shift-in 'kf 'rs 'rb z 'h) (dk-ass!)))
                             (lambda () (dk-ass!)))))
  (dk-have! `(IN ,psi (FUN ,cs ,cs))
    (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-cite! 'sdl-shift-in 'kf 'rs 'rb z nh) (dk-ass!)))
                             (lambda () (dk-ass!)))))
  (dk-have! `(FORALL sdu_ (IMPLIES (IN sdu_ ,cs) (= (,psi (,sigma sdu_)) sdu_)))
    (lambda () (let ((u (dk-di-var!)))
                 (dk-cite! 'sdl-shift-in 'kf 'rs 'rb u 'h)
                 (dk-lam-b!)
                 (dk-cite! 'sdl-shift-back 'kf 'rs 'rb u 'h)
                 (sdl-close!))))
  (dk-have! `(FORALL sdv_ (IMPLIES (IN sdv_ ,cs) (= (,sigma (,psi sdv_)) sdv_)))
    (lambda () (let ((v (dk-di-var!)))
                 (dk-cite! 'sdl-shift-in 'kf 'rs 'rb v nh)
                 (dk-lam-b!)
                 (let ((e (dk-cite! 'sdl-shift-back 'kf 'rs 'rb v nh)))
                   (dk-rewrite-h! e `((NEG kf) ,nh) 'h))
                 (sdl-close!))))
  (dk-have! `(FORALL sdv_ (IMPLIES (IN sdv_ ,cs) (IN (f sdv_) (CARR ,sdl-ag))))
    (lambda () (let ((v (dk-di-var!)))
