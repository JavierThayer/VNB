;;; 9. Proposition 5.13, and the dualizing character of a local field.

(define (sdl-phi-sub f lam)
  (cond ((eq? f 'phi) lam) ((pair? f) (map (lambda (u) (sdl-phi-sub u lam)) f)) (#t f)))
(define sdl-LAMw '(VNB-LAMBDA chx_ (CARR kf) (w (ONE kf) chx_)))
(define sdl-Z '(NV-INTEGERS kf))
(define sdl-pol `(BICHAR-POLAR kf w ,sdl-Z))

;; a unipolar w gives phi = w(1, .) with (U1), (U2)
(sp (make-wff (sdl-chain '((sdl/all kf) (sdl/all uw) (IS-LOCAL-UNIFORMIZER kf uw) (sdl/all w) (IS-UNIPOLAR kf w))
  (sdl-phi-sub `(AND (IS-ADD-CHARACTER kf phi) (AND ,sdl-U1 ,sdl-U2)) sdl-LAMw))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-cite! 'nf-norm-one 'kf)
(fact 'rr-one-in)
(let* ((lam sdl-LAMw) (Z sdl-Z) (pol sdl-pol)
       (bb (dk-project! '(IS-BILINEAR-BICHARACTER kf w) 'is-unipolar '(IS-UNIPOLAR kf w)))
       (pe (dk-project! `(= ,pol ,Z) 'is-unipolar '(IS-UNIPOLAR kf w)))
       (bc (dk-project! '(IS-BICHARACTER kf w) 'is-bilinear-bicharacter bb))
       (bil (dk-project! '(FORALL cha_ (IMPLIES (IN cha_ (CARR kf)) (FORALL chx_ (IMPLIES (IN chx_ (CARR kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kf))
                             (= (w ((MUL kf) cha_ chx_) chy_) (w chx_ ((MUL kf) cha_ chy_)))))))))
                         'is-bilinear-bicharacter bb))
       (cl2 (dk-project! '(FORALL chy_ (IMPLIES (IN chy_ (CARR kf)) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (w chy_ chx_)))))
                         'is-bicharacter bc)))
  (dk-apply! cl2 '(ONE kf))
  (dk-have! `(<= ,(sdl-N '(ONE kf)) 1) (lambda () (subst `(= ,(sdl-N '(ONE kf)) 1)) (dk-ineq!)))
  (sdl-iff-bwd! (dk-cite! 'c5-integers-mem 'kf '(ONE kf)))
  ;; w(h, x) = phi(h x)
  (define (wsym! h x)
    (let ((hx (sdl-mul h x)) (h1 (sdl-mul h '(ONE kf))))
      (sdl-k! hx) (sdl-k! h1)
      (let* ((e (dk-apply! bil h '(ONE kf) x))
             (e1 (begin (dk-have! `(= ,h1 ,h) (lambda () (sdl-crs! (list h)))) (dk-rewrite-h! e h1 h))))
        (dk-have! `(= (,lam ,hx) (w ,h ,x)) (lambda () (dk-lam-b!) (subst `(= (w (ONE kf) ,hx) (w ,h ,x))) (sdl-close!))))))
  (dk-have! (sdl-phi-sub sdl-U1 lam)
    (lambda ()
      (dk-peel!)
      (let ((m (cadr (cadr (dk-goal)))))
        (sdl-iff-bwd! (dk-cite! 'c5-integers-mem 'kf m))
        (dk-have! `(IN ,m ,pol) (lambda () (subst `(= ,pol ,Z)) (dk-ass!)))
        (sdl-iff-fwd! (dk-cite! 'c5-polar-mem 'kf 'w Z m))
        (dk-apply! `(FORALL x (IMPLIES (IN x ,Z) (= (w ,m x) 1))) '(ONE kf))
        (let* ((m1 (sdl-mul m '(ONE kf)))
               (e (begin (sdl-k! m1) (dk-apply! bil m '(ONE kf) '(ONE kf)))))
          (dk-have! `(= ,m1 ,m) (lambda () (sdl-crs! (list m))))
          (dk-rewrite-h! e m1 m)
          (dk-lam-b!)
          (subst `(= (w (ONE kf) ,m) (w ,m (ONE kf))))
          (dk-ass!)))))
  (dk-have! (sdl-phi-sub sdl-U2 lam)
    (lambda ()
      (dk-peel!)
      (let* ((G (dk-goal)) (A3 (caddr (caddr (caddr G)))) (h (cadr (cadr (cadr (cadr A3))))))
        (use-em G
          (lambda () (dk-ass!))
          (lambda ()
            (dk-have! `(IN ,h ,pol)
              (lambda ()
                (sdl-iff-bwd! (dk-cite! 'c5-polar-mem 'kf 'w Z h)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin
                              (dk-peel!)
                              (let ((x (caddr (cadr (dk-goal)))))
                                (sdl-iff-fwd! (dk-cite! 'c5-integers-mem 'kf x))
                                (use-em `(= (w ,h ,x) 1)
                                  (lambda () (dk-ass!))
                                  (lambda ()
                                    (wsym! h x)
                                    (sdl-not1! `(,lam ,(sdl-mul h x)) `(w ,h ,x))
                                    (dk-have! G (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
                                    (ai `(NOT ,G)))))))))))
                (sdl-close!)))
            (dk-have! `(IN ,h ,Z) (lambda () (subst `(= ,Z ,pol)) (dk-ass!)))
            (sdl-iff-fwd! (dk-cite! 'c5-integers-mem 'kf h))
            (sdl-nrm! h)
            (dk-cite! 'rr-lt-not-le 1 (sdl-N h))
            (ai `(NOT (<= ,(sdl-N h) 1))))))))
  (dk-conj-close! (lambda () (dk-ass!))))
(sdl-dump!)
(qed 'sdl-unipolar-phi)

;; PROPOSITION 5.13.  K local, chi non-trivial: Psi_chi : K -> K^ is surjective.
(sp (make-wff '(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw)
  (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi)
    (FORALL tau (IMPLIES (IS-ADD-CHARACTER kf tau)
      (FORSOME sda_ (AND (IN sda_ (CARR kf)) (= tau (DUALITY-MAP kf chi sda_)))))))))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-cite! 'nf-zero-in-carr 'kf)
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(let* ((x0 (dk-skolem! (dk-project! '(FORSOME chx_ (AND (IN chx_ (CARR kf)) (NOT (= (chi chx_) 1))))
                                    'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))))
       (w (dk-skolem! (dk-cite! 'ccr-6-18-unipolar 'kf 'uw 'chi)))
       (lam (let sub ((f sdl-LAMw)) (cond ((eq? f 'w) w) ((pair? f) (map sub f)) (#t f))))
       (up (dk-cite! 'sdl-unipolar-phi 'kf 'uw w)))
  (dk-split! up)
  (let* ((a (dk-skolem! (dk-cite! 'sdl-core 'kf 'uw lam 'tau)))
         (coreT (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a) (dk-contains? f 'tau))) "tau = phi(a .)"))
         (a1 (dk-skolem! (dk-cite! 'sdl-core 'kf 'uw lam 'chi)))
         (coreC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a1) (dk-contains? f 'chi))) "chi = phi(a1 .)")))
    (dk-have! `(NOT (= ,a1 (ZERO kf)))
      (lambda ()
        (di)
        (let ((e (dk-apply! coreC x0)) (t (sdl-mul a1 x0)))
          (sdl-k! t)
          (dk-cite! 'ch-zero 'kf lam)
          (dk-have! `(= ,(sdl-mul '(ZERO kf) x0) (ZERO kf)) (lambda () (sdl-crs! (list x0))))
          (dk-have! `(= (chi ,x0) 1)
            (lambda ()
              (subst e)
              (subst `(= ,a1 (ZERO kf)))
              (subst `(= ,(sdl-mul '(ZERO kf) x0) (ZERO kf)))
              (dk-ass!)))
          (ai `(NOT (= (chi ,x0) 1))))))
    (let* ((a1i (dk-skolem! (dk-cite! 'nf-inverse 'kf a1)))
           (b (sdl-mul a1i a))
           (dm `(DUALITY-MAP kf chi ,b)))
      (sdl-k! b)
      (dk-cite! 'ccr-5-12-character 'kf 'chi b)
      (sdl-hom! 'tau) (sdl-hom! dm)
      (ew b)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (dk-fun-ext! 'tau dm '(CARR kf) 'UNIT-CIRCLE #f #f
                (lambda (v)
                  (let ((bv (sdl-mul b v)) (av (sdl-mul a v)))
                    (sdl-k! bv) (sdl-k! av)
                    (subst (dk-cite! 'ch-psi-value 'kf 'chi b v))
                    (let ((e1 (dk-apply! coreT v)) (e2 #f))
                      (set! e2 (dk-apply! coreC bv))
                      (subst e1) (subst e2)
                      (dk-have! `(= ,(sdl-mul a1 bv) ,av)
                        (lambda ()
                          (dk-have! `(= ,(sdl-mul a1 bv) ,(sdl-mul (sdl-mul a1 a1i) av)) (lambda () (sdl-crs! (list a1 a1i a v))))
                          (subst `(= ,(sdl-mul a1 bv) ,(sdl-mul (sdl-mul a1 a1i) av)))
                          (subst `(= ,(sdl-mul a1 a1i) (ONE kf)))
                          (sdl-crs! (list av))))
                      (subst `(= ,(sdl-mul a1 bv) ,av))
                      (sdl-close!)))))))))))
(sdl-dump!)
(qed 'ccr-5-13)

;; Remark 6.4 for a local field: a non-trivial character is dualizing.
(sp (make-wff '(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw)
  (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi) (IS-DUALIZING-CHARACTER kf chi))))))))
(dk-peel!)
(sdl-iff-bwd! (dk-cite! 'is-dualizing-character 'kf 'chi)
