;;; -----------------------------------------------------------------------
;;; 3. The sum of ones over a finite set is its cardinal.

(sp (make-wff `(FORALL sn (IMPLIES (IN sn NN) (FORALL f (FORALL ss (IMPLIES (IN ss SET) (IMPLIES (= (CARD ss) sn)
  (IMPLIES (FORALL z (IMPLIES (IN z ss) (= (f z) 1))) (= (FINSUM ,sdl-ag f ss) sn))))))))))
(define sdl-cases (dk-ni-fixed!))
(define (sdl-x-elt! S n)               ; CARD S = succ n in context: an element of S, skolemised
  (dk-have! (list 'FORSOME 'sdgx_ (list 'IN 'sdgx_ S))
    (lambda ()
      (use-em (list 'FORSOME 'sdgx_ (list 'IN 'sdgx_ S))
        (lambda () (ass))
        (lambda ()
          (let ((ce (dk-cite! 'class-extensionality S 'EMPTY-SET)))
            (dk-have! (cadr ce) (lambda () (let ((y (begin (di) (cadr (cadr (dk-goal))))))
                                             (fact 'empty-set-has-no-members y)
                                             (dk-have! (list 'NOT (list 'IN y S)) (lambda () (di) (dk-have! (list 'FORSOME 'sdgx_ (list 'IN 'sdgx_ S)) (lambda () (ew y) (ass))) (ai (list 'NOT (list 'FORSOME 'sdgx_ (list 'IN 'sdgx_ S))))))
                                             (prop))))
            (dk-landed-1 (lambda () (detach! ce)))
            (dk-cite! 'card-empty)
            (dk-have! (list '= (list 'succ n) 0)
              (lambda () (subst (list '= (list 'succ n) (list 'CARD S))) (subst (list '= S 'EMPTY-SET)) (ass)))
            (dk-cite! 'nn-succ-closed n) (dk-cite! 'nn-in-rr (list 'succ n))
            (dk-have! (list '< 0 (list 'succ n)) (lambda () (dk-nn!)))
            (dk-absurd! (list '< 0 (list 'succ n)) (list '= (list 'succ n) 0) (list 'IN (list 'succ n) 'RR)))))))
  (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'sdgx_))) "an element")))
(dk-focus! (cdr (assq 'step sdl-cases)))
(sdl-ring!)
(let* ((n (dk-di-var!))
       (ih (cadr (dk-goal))))
  (di)
  (let* ((landed (dk-peel!))
         (S (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'SET))) landed)))
         (fh (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
    (dk-cite! 'nn-succ-closed n)
    (let* ((x (sdl-x-elt! S n))
           (px (list 'PAIR x x))
           (S1 (list 'DIFFERENCE S px))
           (U1 (list 'UNION S1 px)))
      (dk-cite! 'membership-implies-sethood x S)
      (sdl-and! (list 'IN x 'SET) (list 'IN x 'SET))
      (dk-cite! 'pairing x x)
      (dk-cite! 'difference-set S px)
      (dk-cite! 'remove-restore S x)
      (let* ((dm (dk-cite! 'difference-membership S px x)) (pm (dk-cite! 'pairing-membership x x x)))
        (dk-have! (list '= x x) (lambda () (rfl)))
        (dk-have! (list 'NOT (list 'IN x S1)) (lambda () (prop))))
      (sdl-and! (list 'IN x 'SET) (list 'NOT (list 'IN x S1)))
      (dk-have! (list '= (list 'CARD U1) (list 'succ n))
        (lambda () (subst (list '= U1 S)) (dk-ass!)))
      (dk-cite! 'card-insert-converse S1 x n)
      (dk-have! (list 'IN (list 'CARD S1) 'NN) (lambda () (subst (list '= (list 'CARD S1) n)) (dk-ass!)))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z S1) (list '= '(f z) 1)))
        (lambda () (let ((z (dk-di-var!)))
                     (let ((dz (dk-cite! 'difference-membership S px z)))
                       (dk-have! (list 'IN z S) (lambda () (prop))))
                     (dk-apply! fh z)
                     (dk-ass!))))
      (dk-apply! ih S1)
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ U1) (list 'IN '(f z_) (list 'CARR sdl-ag))))
        (lambda () (let ((z (dk-di-var!)))
                     (dk-rewrite-h! (list 'IN z U1) U1 S)
                     (dk-apply! fh z)
                     (subst (list '= (list 'CARR sdl-ag) 'CC))
                     (subst (list '= (list 'f z) 1))
                     (dk-ass!))))
      (let ((ins (dk-cite! 'finsum-insert-ptwise sdl-ag S1 x 'f)))
        (dk-apply! fh x)
        (dk-cite! 'nn-in-rr n) (dk-cite! 'rr-subset-cc n)
        (subst (list '= S U1))
        (subst ins)
        (subst (dk-cite! 'ras-op sdl-r))
        (subst (list '= (list 'FINSUM sdl-ag 'f S1) n))
        (subst (list '= (list 'f x) 1))
        (subst (sdl-op-eq! 'ADD n 1))
        (subst (dk-cite! 'nn-succ-plus-one n))
        (sdl-close!)))))
(dk-focus! (cdr (assq 'base sdl-cases)))
(sdl-ring!)
(let* ((landed (dk-peel!))
       (S (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'SET))) landed))))
  (dk-cite! 'card-zero-is-empty S)
  (subst (list '= S 'EMPTY-SET))
  (subst (dk-cite! 'finsum-empty sdl-ag 'f))
  (subst (dk-cite! 'ras-id sdl-r))
  (subst (dk-cite! 'cc-scalar-ring-zero))
  (sdl-close!))
(sdl-dump!)
(qed 'sdl-sum-one)

;;; -----------------------------------------------------------------------
;;; 4. K local: the set of cosets CS(rs, rb) is finite (B(rb) is compact, hence totally bounded).

(sp (make-wff `(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw) (FORALL rs (IMPLIES (IN rs RR) (IMPLIES (< 0 rs)
  (FORALL rb (IMPLIES (IN rb RR) (IMPLIES (<= rs rb) (IN (CARD ,(sdl-cs 'rs 'rb)) NN))))))))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-metric-space-is-metric-space 'kf)
(dk-cite! 'nf-metric-carrier 'kf)
(dk-cite! 'nf-zero-in-carr 'kf)
(dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf))
(dk-have! '(< 0 rb) (lambda () (dk-ineq! '(< 0 rs) '(<= rs rb))))
(dk-have! '(<= 0 rs) (lambda () (dk-ineq! '(< 0 rs))))
(dk-have! '(NOT (= 0 rs)) (lambda () (di) (dk-absurd! '(< 0 rs) '(= 0 rs))))
(let* ((cs (sdl-cs 'rs 'rb))
       (b0 (sdl-B '(ZERO kf) 'rb))
       (lam `(VNB-LAMBDA sdx_ ,b0 ,(sdl-B 'sdx_ 'rs)))
       (sub `(SUBSPACE-MS ,sdl-ms ,b0)))
  (dk-cite! 'c5-lu-ball-compact 'kf 'uw 'rb)
  (dk-cite! 'closed-ball-in-carrier sdl-ms '(ZERO kf) 'rb)
  (dk-rewrite-h! `(SUBSET ,b0 (PTS ,sdl-ms)) `(PTS ,sdl-ms) '(CARR kf))
  (dk-cite! 'subclass-of-set-is-set b0 '(CARR kf))
  (dk-cite! 'subspace-pts sdl-ms b0)
  (dk-cite! 'image-set lam b0)
  (let* ((tb (dk-cite! 'compact-implies-totally-bounded sub))
         (cl (dk-project! `(FORALL r (IMPLIES (AND (IN r RR) (AND (<= 0 r) (NOT (= 0 r))))
                             (FORSOME F (AND (IN (CARD F) NN) (IS-R-NET ,sub F (PTS ,sub) r)))))
                          'totally-bounded tb)))
    (sdl-and! '(IN rs RR) '(<= 0 rs) '(NOT (= 0 rs)))
    (let* ((F (dk-skolem! (dk-apply! cl 'rs)))
           (net `(IS-R-NET ,sub ,F (PTS ,sub) rs))
           (fsub (dk-project! `(SUBSET ,F (PTS ,sub)) 'is-r-net net))
           (fcov (dk-project! `(FORALL p (IMPLIES (IN p (PTS ,sub)) (FORSOME c (AND (IN c ,F)
                                  (AND (<= ((DIST ,sub) c p) rs) (NOT (= ((DIST ,sub) c p) rs)))))))
                              'is-r-net net))
           (im `(IMAGE ,lam ,F)))
      (dk-rewrite-h! fsub `(PTS ,sub) b0)
      (dk-cite! 'subclass-of-set-is-set F b0)
      (dk-cite! 'card-image-finite lam F)
      (dk-cite! 'image-set lam F)
      (sdl-and! `(IN ,im SET) `(IN (CARD ,im) NN))
      (dk-have! `(FORALL z (IMPLIES (IN z ,cs) (IN z ,im)))
        (lambda ()
          (let* ((cc (dk-di-var!))
                 (c `(CHOICE ,cc)))
            (sdl-rep! cc)
            (dk-have! `(IN ,c ,b0) (lambda () (sdl-iff-bwd! (dk-cite! 'sdl-ball0-iff 'kf 'rb c)) (dk-ass!)))
            (dk-have! `(IN ,c (PTS ,sub)) (lambda () (subst `(== (PTS ,sub) ,b0)) (dk-ass!)))
            (let* ((q (dk-skolem! (dk-apply! fcov c))))
              (dk-cite! 'subset-mem-fwd F b0 q)
              (sdl-iff-fwd! (dk-cite! 'sdl-ball0-iff 'kf 'rb q))
              (let* ((e1 (dk-cite! 'subspace-dist sdl-ms b0 q c))
                     (e2 (dk-cite! 'nf-metric-distance 'kf q c))
                     (h (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'DIST) (dk-contains? f q))) "the net distance"))
                     (h2 (dk-rewrite-h! h `((DIST ,sub) ,q ,c) `((DIST ,sdl-ms) ,q ,c)))
                     (h3 (dk-rewrite-h! h2 `((DIST ,sdl-ms) ,q ,c) (sdl-N (sdl-sub q c)))))
                (dk-cite! 'sdl-ball-eq 'kf q c 'rs)
                (dk-cite! 'closed-ball-is-set sdl-ms q 'rs)
                (sdl-iff-bwd! (dk-cite! 'image-membership-iff lam F cc)
                  (lambda ()
                    (dk-conj-close! (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN)
                          (begin (dk-cite! 'membership-implies-sethood cc cs) (dk-ass!))
                          (begin (ew q)
