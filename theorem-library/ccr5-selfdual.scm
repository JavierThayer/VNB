       (gtriv '(FORALL y (IMPLIES (IN y (CARR kf)) (IMPLIES (<= ((FNRM kf) y) rs) (= (g y) 1)))))
       (link `(FORALL C (IMPLIES (IN C ,cs) (= (f C) (g (CHOICE C))))))
       (nh '((NEG kf) h))
