  (dk-cite! 'cc-zero-in) (dk-cite! 'cc-one-in))
;; (= ((OP r) x y) (op x y)) for op MUL / ADD, x, y typed in CC
(define (sdl-op-eq! op x y)
  (let* ((thm (if (eq? op 'MUL) 'cc-scalar-ring-mul 'cc-scalar-ring-add))
         (cop (if (eq? op 'MUL) '* '+))
         (eq (list '= (list (list op sdl-r) x y) (list cop x y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! thm))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))

