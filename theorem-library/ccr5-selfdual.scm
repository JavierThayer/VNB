;;; 10. The self-dual corollaries, unconditional for a local field (one citation each).

(define (sdl-loc body)
  (sdl-chain '((sdl/all kf) (sdl/all uw) (IS-LOCAL-UNIFORMIZER kf uw) (sdl/all chi) (IS-NONTRIVIAL-CHARACTER kf chi)) body))
(define (sdl-rel wq a) `(FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                          (= (w x eta) (,wq ((MUL kf) ,a x) eta)))))))
(define (sdl-cor! thm . args)
  (dk-peel!)
  (dk-cite! 'c5-lu-nv-field 'kf 'uw)
  (dk-cite! 'nv-field-normed 'kf)
  (dk-cite! 'ccr-5-13-dualizing 'kf 'uw 'chi)
  (apply dk-cite! thm args)
  (sdl-close!))

;; Lemma 6.3, converse: every bilinear bicharacter is (x, y) |-> chi(a x y)
(sp (make-wff (sdl-loc '(FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
    (FORSOME c5a (AND (IN c5a (CARR kf))
      (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
        (= (w x eta) ((BICHAR-OF kf chi c5a) x eta)))))))))))))
(sdl-cor! 'ccr-6-3-converse 'kf 'chi 'w)
(qed 'ccr-6-3-converse-local)

;; Corollary 6.6: a non-trivial bilinear bicharacter is faithful
(sp (make-wff (sdl-loc '(FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
    (IMPLIES (FORSOME c5x (AND (IN c5x (CARR kf)) (FORSOME c5y (AND (IN c5y (CARR kf)) (NOT (= (w c5x c5y) 1))))))
      (IS-FAITHFUL-BICHARACTER kf w)))))))
(sdl-cor! 'ccr-6-6 'kf 'chi 'w)
(qed 'ccr-6-6-local)

;; Proposition 6.20: w(x, y) = w_K(a x, y) for a unique a, w_K = BICHAR-OF(chi, c)
(sp (make-wff (sdl-loc '(FORALL c (IMPLIES (IN c (CARR kf)) (IMPLIES (NOT (= c (ZERO kf)))
    (FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
      (AND (FORSOME c5a (AND (IN c5a (CARR kf))
             (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
               (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5a x) eta))))))))
           (FORALL c5a (IMPLIES (IN c5a (CARR kf)) (FORALL c5b (IMPLIES (IN c5b (CARR kf))
             (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                        (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5a x) eta))))))
               (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                          (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5b x) eta))))))
                 (= c5a c5b))))))))))))))))
