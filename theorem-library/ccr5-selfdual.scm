  ;; the hypothesis of Lemma 5.15
  (dk-have! `(FORALL c5k (IMPLIES (IN c5k NN) (FORALL eta (IMPLIES (IN eta (CARR kf)) (IMPLIES (<= ((FNRM kf) eta) 1)
               (= (phi ((MUL kf) (,asq c5k) eta)) (phi ((MUL kf) (,asq 0) eta))))))))
    (lambda ()
