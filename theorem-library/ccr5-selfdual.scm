;; Proposition 6.18 (given a non-trivial character): K has a faithful unipolar bicharacter
(sp (make-wff (sdl-loc '(FORSOME sdw_ (AND (IS-UNIPOLAR kf sdw_) (IS-FAITHFUL-BICHARACTER kf sdw_))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-cite! 'nf-norm-one 'kf)
(let* ((w (dk-skolem! (dk-cite! 'ccr-6-18-unipolar 'kf 'uw 'chi)))
       (lam (let sub ((f sdl-LAMw)) (cond ((eq? f 'w) w) ((pair? f) (map sub f)) (#t f)))))
  (dk-split! (dk-cite! 'sdl-unipolar-phi 'kf 'uw w))
  (let ((r (dk-cite! 'c5-lu-norm 'kf 'uw))) (if (dk-head-is? r 'AND) (dk-split! r)))
  (dk-cite! 'c5-lu-nonzero 'kf 'uw)
  (sdl-nrm! 'uw)
  (fact 'rr-one-in)
  (let* ((uwi (dk-skolem! (dk-cite! 'nf-inverse 'kf 'uw)))
         (h1 (sdl-mul uwi '(ONE kf))))
    (sdl-nrm! uwi)
    (sdl-k! h1)
    (dk-have! `(<= ,(sdl-N 'uw) 1) (lambda () (dk-ineq! `(< ,(sdl-N 'uw) 1))))
    (dk-cite! 'sdl-inv-ge1 'kf 'uw uwi)
    (dk-have! `(= ((MUL kf) ,uwi uw) (ONE kf)) (lambda () (subst `(= (ONE kf) ((MUL kf) uw ,uwi))) (sdl-crs! (list 'uw uwi))))
    (dk-have! `(< 0 ,(sdl-N uwi)) (lambda () (dk-ineq! `(<= 1 ,(sdl-N uwi)))))
    (dk-have! `(< ,(sdl-N 'uw) ,(sdl-N '(ONE kf))) (lambda () (subst `(= ,(sdl-N '(ONE kf)) 1)) (dk-ass!)))
    (dk-cite! 'sdl-scale-gt 'kf uwi 'uw '(ONE kf))
    (let* ((u2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f w))) "U2"))
           (x1 (dk-skolem! (dk-apply! u2 h1)))
           (y1 (sdl-mul h1 x1)))
      (sdl-k! y1)
      (dk-have! `(NOT (= (,w (ONE kf) ,y1) 1))
        (lambda () (di)
                   (dk-have! `(= (,lam ,y1) 1) (lambda () (dk-lam-b!) (dk-ass!)))
                   (ai `(NOT (= (,lam ,y1) 1)))))
      (dk-have! `(FORSOME c5x (AND (IN c5x (CARR kf)) (FORSOME c5y (AND (IN c5y (CARR kf)) (NOT (= (,w c5x c5y) 1))))))
        (lambda () (ew '(ONE kf)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew y1) (dk-conj-close! (lambda () (dk-ass!)))))))))
      (dk-project! `(IS-BILINEAR-BICHARACTER kf ,w) 'is-unipolar `(IS-UNIPOLAR kf ,w))
      (dk-cite! 'ccr-6-6-local 'kf 'uw 'chi w)
      (ew w)
      (dk-conj-close! (lambda () (dk-ass!))))))
(sdl-dump!)
(qed 'ccr-6-18)

;;; -----------------------------------------------------------------------
;;; 11. Corollary 6.22, forward half: xi_l -> xi metrically gives w(xi_l, eta) -> w(xi, eta).

(sp (make-wff (sdl-chain '((sdl/all kf) (sdl/all uw) (IS-LOCAL-UNIFORMIZER kf uw) (sdl/all w) (IS-UNIPOLAR kf w)
                           (sdl/in sq (FUN NN (CARR kf))) (sdl/in xi (CARR kf)) (CONVERGES-TO (NF-METRIC-SPACE kf) sq xi)
                           (sdl/in eta (CARR kf)))
  '(CONVERGES-TO CC-MS (VNB-LAMBDA sdn_ NN (w (sq sdn_) eta)) (w xi eta)))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-metric-space-is-metric-space 'kf)
(dk-cite! 'cc-is-metric-space)
(dk-cite! 'cc-ms@pts)
(fact 'rr-zero-in)
(let* ((bb (dk-project! '(IS-BILINEAR-BICHARACTER kf w) 'is-unipolar '(IS-UNIPOLAR kf w)))
       (bc (dk-project! '(IS-BICHARACTER kf w) 'is-bilinear-bicharacter bb))
       (cl1 (dk-project! '(FORALL chy_ (IMPLIES (IN chy_ (CARR kf)) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (w chx_ chy_)))))
                         'is-bicharacter bc))
       (tau '(VNB-LAMBDA chx_ (CARR kf) (w chx_ eta)))
       (h '(VNB-LAMBDA sdn_ NN (w (sq sdn_) eta))))
  (dk-apply! cl1 'eta)
  (sdl-hom! tau)
  (let* ((r0 (dk-skolem! (dk-cite! 'ccr-6-17-ball 'kf tau)))
         (T0 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r0))) "tau trivial on B(r0)")))
    (dk-cite! 'rr-pos-rr-in-rr r0)
    (sdl-iff-fwd! (dk-cite! 'converges-to sdl-ms 'sq 'xi))
    (let ((conv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'sq))) "convergence")))
      (sdl-val! tau 'xi)
      (dk-lam-b-h! `(IN (,tau xi) CC))
      (dk-have! '(IN (w xi eta) (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
      (sdl-iff-bwd! (dk-cite! 'converges-to 'CC-MS h '(w xi eta))
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (cond
                ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'IN)
                 (subst '(== (PTS CC-MS) CC))
                 (dk-lam-type!
                   (lambda ()
                     (let ((n (dk-di-var!)))
                       (sdl-and! '(IN sq (FUN NN (CARR kf))) `(IN ,n NN))
                       (dk-cite! 'fun-apply-type 'sq 'NN '(CARR kf) n)
                       (sdl-val! tau `(sq ,n))
                       (dk-lam-b-h! `(IN (,tau (sq ,n)) CC))
                       (sdl-close!)))
                   (lambda () (fact 'nn-is-set) (sdl-close!))))
                (#t
                 (dk-peel!)
                 (let* ((n0 (dk-skolem! (dk-apply! conv r0)))
                        (tb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n0) (dk-contains? f 'DIST))) "the tail bound")))
                   (ew n0)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-ass!))
                           (begin
                             (dk-peel!)
                             (let* ((g (dk-goal)) (n (cadr (cadr (cadr g)))) (sn `(sq ,n)) (d (sdl-sub sn 'xi)))
                               (sdl-and! '(IN sq (FUN NN (CARR kf))) `(IN ,n NN))
                               (dk-cite! 'fun-apply-type 'sq 'NN '(CARR kf) n)
                               (sdl-k! d)
                               (let* ((b1 (dk-apply! tb n))
                                      (e1 (dk-cite! 'nf-metric-distance 'kf sn 'xi))
                                      (b2 (dk-rewrite-h! b1 `((DIST ,sdl-ms) ,sn xi) (sdl-N d))))
                                 (dk-apply! T0 d)
                                 (dk-have! `(= ,sn ,(sdl-add 'xi d)) (lambda () (sdl-crs! (list sn 'xi))))
                                 (sdl-val! tau sn) (sdl-val! tau d)
                                 (dk-have! `(= (,tau ,sn) (,tau xi))
                                   (lambda ()
                                     (subst `(= ,sn ,(sdl-add 'xi d)))
                                     (subst (dk-apply! (sdl-homf tau) 'xi d))
                                     (subst `(= (,tau ,d) 1))
                                     (sdl-crs-cc! (list `(,tau xi)))))
                                 (dk-lam-b-h! `(= (,tau ,sn) (,tau xi)))
                                 (dk-lam-b!)
                                 (subst `(= (w ,sn eta) (w xi eta)))
                                 (subst (dk-cite! 'metric-self-zero 'CC-MS '(w xi eta)))
                                 (let ((e (caddr (dk-goal))))
                                   (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
                                   (dk-ineq! `(< 0 ,e))))))))))))))))
      (sdl-close!))))
(sdl-dump!)
(qed 'ccr-6-22-forward)
