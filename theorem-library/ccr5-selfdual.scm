;;; -----------------------------------------------------------------------
;;; 5. Norm estimates for u v = 1, and orthogonality with a constant factor.

;; u v = 1, |p| <= |u|, |q| <= |v|  =>  |p q| <= 1
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL u (IMPLIES (IN u (CARR kf)) (FORALL v (IMPLIES (IN v (CARR kf))
  (IMPLIES (= ((MUL kf) u v) (ONE kf)) (FORALL p (IMPLIES (IN p (CARR kf)) (FORALL q (IMPLIES (IN q (CARR kf))
    (IMPLIES (<= ((FNRM kf) p) ((FNRM kf) u)) (IMPLIES (<= ((FNRM kf) q) ((FNRM kf) v))
      (<= ((FNRM kf) ((MUL kf) p q)) 1))))))))))))))))
(dk-peel!)
(for-each sdl-nrm! '(u v p q))
(let* ((e1 (dk-cite! 'nf-norm-mult 'kf 'u 'v))
      (e2 (dk-cite! 'nf-norm-mult 'kf 'p 'q)))
  (dk-cite! 'nf-norm-one 'kf)
  (let* ((e3 (dk-rewrite-h! e1 '((MUL kf) u v) '(ONE kf)))
         (e4 (dk-rewrite-h! e3 '((FNRM kf) (ONE kf)) 1)))
    (dk-cite! 'rr-prod-le-gen (sdl-N 'p) (sdl-N 'q) (sdl-N 'u) (sdl-N 'v))
    (subst e2)
    (subst `(= 1 ,(caddr e4)))
    (dk-ass!)))
