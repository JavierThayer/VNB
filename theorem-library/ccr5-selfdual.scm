;; Corollary 6.23: two unipolar bicharacters differ by a unique unit
(sp (make-wff (sdl-loc `(FORALL w (IMPLIES (IS-UNIPOLAR kf w) (FORALL wq (IMPLIES (IS-UNIPOLAR kf wq)
    (AND (FORSOME c5a (AND (IN c5a (CARR kf)) (AND (= ((FNRM kf) c5a) 1) ,(sdl-rel 'wq 'c5a))))
         (FORALL c5a (IMPLIES (IN c5a (CARR kf)) (FORALL c5b (IMPLIES (IN c5b (CARR kf))
