                                              (sdl-close!)))))))))))
                (dk-ass!))))))
      (dk-cite! 'closed-ball-is-set sdl-ms '(ZERO kf) 'rb)
      (sdl-and! `(IN ,cs SET) `(FORALL z (IMPLIES (IN z ,cs) (IN z ,im))))
      (dk-cite! 'card-subset-nn im cs)
      (dk-ass!))))
