      (let* ((g (dk-goal)) (k (cadr (cadr (cadr (cadr g))))) (eta (caddr (cadr (cadr g)))))
        (sdl-pf! k) (sdl-pf! 0)
        (let ((ek (sdl-L-val! k)) (e0 #f))
          (set! e0 (sdl-L-val! 0))
          (subst ek) (subst e0)
          (let ((ak (caddr ek)) (a0 (caddr e0)))
            (sdl-nrm! eta)
            (dk-have! `(<= ,(sdl-N eta) ,(sdl-N (sdl-pw uwi k))) (lambda () (dk-ineq! `(<= ,(sdl-N eta) 1) `(<= 1 ,(sdl-N (sdl-pw uwi k))))))
            (dk-have! `(<= ,(sdl-N eta) ,(sdl-N (sdl-pw uwi 0))) (lambda () (dk-ineq! `(<= ,(sdl-N eta) 1) `(<= 1 ,(sdl-N (sdl-pw uwi 0))))))
            (let* ((t1 (dk-apply! (sdl-agree 'tau ak (sdl-N (sdl-pw uwi k))) eta))
                   (t2 (dk-apply! (sdl-agree 'tau a0 (sdl-N (sdl-pw uwi 0))) eta)))
              (subst `(= ,(caddr t1) ,(cadr t1)))
              (subst `(= ,(caddr t2) ,(cadr t2)))
              (sdl-val! 'tau eta)
              (sdl-close!)))))))
  (let* ((lim (dk-cite! 'ccr-5-15 'kf 'uw 'phi asq))
         (ps (dk-skolem! lim))
         (l (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'CONVERGES-TO))) "the limit")))
         (seq `(SUBSEQ ,asq ,ps)))
    (sdl-iff-fwd! (dk-cite! 'converges-to sdl-ms seq l))
    (sdl-iff-fwd! (dk-cite! 'strictly-mono-nn ps))
    (let ((conv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'SUBSEQ))) "convergence"))
          (FA `(FORALL x (IMPLIES (IN x (CARR kf)) (= (tau x) (phi ((MUL kf) ,l x)))))))
      (dk-have! FA
        (lambda ()
          (dk-peel!)
          (let ((x (cadr (cadr (dk-goal)))))
            (use-em `(= ,x (ZERO kf))
              (lambda ()
                (subst `(= ,x (ZERO kf)))
                (dk-have! `(= ,(sdl-mul l '(ZERO kf)) (ZERO kf)) (lambda () (sdl-crs! (list l))))
                (subst `(= ,(sdl-mul l '(ZERO kf)) (ZERO kf)))
                (subst (dk-cite! 'ch-zero 'kf 'tau))
                (subst (dk-cite! 'ch-zero 'kf 'phi))
                (sdl-close!))
              (lambda ()
                (let ((nx (sdl-nrm! x)))
                  (dk-have! `(NOT (= ,nx 0))
                    (lambda () (di) (sdl-iff-fwd! (dk-cite! 'nf-norm-zero-iff 'kf x)) (ai `(NOT (= ,x (ZERO kf))))))
                  (sdl-lt-of-ne! nx)
                  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                  (let* ((K0 (dk-skolem! (dk-cite! 'rr-power-decay-scaled (sdl-N 'uw) nx 1)))
                         (c1 (sdl-pw 'uw K0)) (ci1 (sdl-pw uwi K0))
                         (pw0 `(POWER ,(sdl-N 'uw) ,K0)))
                    (sdl-pf! K0)
                    (let ((em (dk-cite! 'nf-norm-mult 'kf c1 x)))
                      (sdl-nrm! (sdl-mul c1 x))
                      (dk-have! `(<= ,(sdl-N (sdl-mul c1 x)) 1)
                        (lambda () (subst em) (subst `(= ,(sdl-N c1) ,pw0))
                                   (sdl-and! `(IN ,pw0 RR) `(IN ,nx RR)) (dk-cite! 'rr-mul-closed pw0 nx)
                                   (dk-ineq! `(< (* ,pw0 ,nx) 1) `(IN (* ,pw0 ,nx) RR)))))
                    (sdl-nrm! (sdl-mul ci1 (sdl-mul c1 x)))
                    (dk-cite! 'sdl-le-mul1 'kf ci1 (sdl-mul c1 x))
                    (dk-have! `(= ,(sdl-mul ci1 (sdl-mul c1 x)) ,x)
                      (lambda ()
                        (dk-have! `(= ,(sdl-mul ci1 (sdl-mul c1 x)) ,(sdl-mul (sdl-mul c1 ci1) x)) (lambda () (sdl-crs! (list ci1 c1 x))))
                        (subst `(= ,(sdl-mul ci1 (sdl-mul c1 x)) ,(sdl-mul (sdl-mul c1 ci1) x)))
                        (subst `(= ,(sdl-mul c1 ci1) (ONE kf)))
                        (sdl-crs! (list x))))
                    (dk-rewrite-h! `(<= ,(sdl-N (sdl-mul ci1 (sdl-mul c1 x))) ,(sdl-N ci1)) (sdl-mul ci1 (sdl-mul c1 x)) x)
                    (sdl-pos! (sdl-N c1))
                    (let* ((ne (dk-skolem! (dk-apply! conv (sdl-N c1))))
                           (cb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ne) (dk-contains? f 'DIST))) "the tail bound"))
                           (n1 `(+ ,K0 ,ne))
                           (m `(,ps ,n1)))
                      (sdl-and! `(IN ,K0 NN) `(IN ,ne NN))
                      (dk-cite! 'nn-add-closed K0 ne)
                      (dk-cite! 'nn-le-add-left K0 ne)
                      (let ((db (dk-apply! cb n1)))
                        (sdl-and! `(IN ,ps (FUN NN NN)) `(IN ,n1 NN))
                        (dk-cite! 'fun-apply-type ps 'NN 'NN n1)
                        (dk-cite! 'strictly-mono-ge-id ps n1)
                        (dk-cite! 'nn-le-add-right ne K0)
                        (dk-have! `(<= ,K0 ,m) (lambda () (dk-nn!)))
                        (dk-cite! 'subseq-apply asq ps n1)
                        (let* ((db2 (dk-rewrite-h! db `(,seq ,n1) `(,asq ,m)))
                               (ev (sdl-L-val! m))
                               (am (caddr ev))
                               (db3 (dk-rewrite-h! db2 `(,asq ,m) am)))
                          (dk-cite! 'nf-metric-distance 'kf am l)
                          (let* ((db4 (dk-rewrite-h! db3 `((DIST ,sdl-ms) ,am ,l) (sdl-N (sdl-sub am l))))
                                 (d (sdl-sub l am)))
                            (sdl-k! d) (sdl-k! (sdl-sub am l))
                            (dk-cite! 'nf-norm-sub-sym 'kf am l)
                            (dk-rewrite-h! db4 (sdl-N (sdl-sub am l)) (sdl-N d))
                            (dk-cite! 'sdl-prod1 'kf c1 ci1 d x)
                            (sdl-k! (sdl-mul d x))
                            (dk-apply! sdl-U1 (sdl-mul d x))
                            (sdl-pf! m)
                            (dk-cite! 'rr-power-mono-le m K0 (sdl-N uwi))
                            (dk-have! `(<= ,nx ,(sdl-N (sdl-pw uwi m)))
                              (lambda () (dk-ineq! `(<= ,nx ,(sdl-N ci1)) `(= ,(sdl-N ci1) (POWER ,(sdl-N uwi) ,K0))
                                                   `(<= (POWER ,(sdl-N uwi) ,K0) (POWER ,(sdl-N uwi) ,m))
                                                   `(= ,(sdl-N (sdl-pw uwi m)) (POWER ,(sdl-N uwi) ,m)))))
                            (let ((ag (dk-apply! (sdl-agree 'tau am (sdl-N (sdl-pw uwi m))) x))
                                  (amx (sdl-mul am x)) (dx (sdl-mul d x)))
                              (sdl-k! amx)
                              (dk-have! `(= ,(sdl-mul l x) ,(sdl-add amx dx)) (lambda () (sdl-crs! (list l am x))))
                              (subst `(= ,(sdl-mul l x) ,(sdl-add amx dx)))
                              (subst (dk-apply! (sdl-homf 'phi) amx dx))
                              (subst `(= (phi ,dx) 1))
                              (subst ag)
                              (sdl-crs-cc! (list `(phi ,amx)))))))))))))))
      (ew l)
      (dk-conj-close! (lambda () (dk-ass!))))))
(sdl-dump!)
(qed 'sdl-core)

