                             (lambda () (dk-ass!)))))
  (dk-have! `(FORALL sdv_ (IMPLIES (IN sdv_ ,cs) (= (,f0 sdv_) (g (CHOICE sdv_)))))
    (lambda () (let ((z (dk-di-var!))) (sdl-rep! z) (dk-apply! gtype `(CHOICE ,z)) (dk-lam-b!) (sdl-close!))))
