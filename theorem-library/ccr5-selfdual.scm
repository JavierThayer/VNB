;;; -----------------------------------------------------------------------
;;; 6. THE DOUBLE SUM (Remark 5.14, finite form).  phi a character with
;;;    (U1) |m| <= 1 => phi(m) = 1 and (U2) |h| > 1 => phi(h x) /= 1 for some |x| <= 1;
;;;    tau a character trivial on B(|c|), c ci = 1, bg bgi = 1, |c| <= 1 <= |bg|:
;;;    tau = phi(p .) on B(|bg|) for some p.

;; nested statement builder: (sdl/all v) | (sdl/in v C) | hypothesis
(define (sdl-chain items concl)
  (if (null? items) concl
      (let ((it (car items)) (rest (sdl-chain (cdr items) concl)))
        (cond ((and (pair? it) (eq? (car it) 'sdl/all)) `(FORALL ,(cadr it) ,rest))
              ((and (pair? it) (eq? (car it) 'sdl/in)) `(FORALL ,(cadr it) (IMPLIES (IN ,(cadr it) ,(caddr it)) ,rest)))
              (#t `(IMPLIES ,it ,rest))))))
(define sdl-U1 '(FORALL m (IMPLIES (IN m (CARR kf)) (IMPLIES (<= ((FNRM kf) m) 1) (= (phi m) 1)))))
(define sdl-U2 '(FORALL h (IMPLIES (IN h (CARR kf)) (IMPLIES (< 1 ((FNRM kf) h))
                  (FORSOME x (AND (IN x (CARR kf)) (AND (<= ((FNRM kf) x) 1) (NOT (= (phi ((MUL kf) h x)) 1)))))))))
(define (sdl-agree tau p r)
  `(FORALL q (IMPLIES (IN q (CARR kf)) (IMPLIES (<= ((FNRM kf) q) ,r) (= (,tau q) (phi ((MUL kf) ,p q)))))))
(define sdl-taut '(FORALL y (IMPLIES (IN y (CARR kf)) (IMPLIES (<= ((FNRM kf) y) ((FNRM kf) c)) (= (tau y) 1)))))
(define (sdl-hom! chi)
  (dk-project! `(IN ,chi (FUN (CARR kf) UNIT-CIRCLE)) 'is-add-character `(IS-ADD-CHARACTER kf ,chi))
  (dk-project! `(FORALL chx_ (IMPLIES (IN chx_ (CARR kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kf))
                   (= (,chi ((ADD kf) chx_ chy_)) (* (,chi chx_) (,chi chy_)))))))
               'is-add-character `(IS-ADD-CHARACTER kf ,chi)))
(define (sdl-homf chi) `(FORALL chx_ (IMPLIES (IN chx_ (CARR kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kf))
                   (= (,chi ((ADD kf) chx_ chy_)) (* (,chi chx_) (,chi chy_))))))))
(define (sdl-val! chi x)          ; x typed in (CARR kf): land chi(x) in CC
  (sdl-k! x)
  (if (not (dk-asm? `(IN (,chi ,x) CC)))
      (begin
        (sdl-and! `(IN ,chi (FUN (CARR kf) UNIT-CIRCLE)) `(IN ,x (CARR kf)))
        (dk-cite! 'fun-apply-type chi '(CARR kf) 'UNIT-CIRCLE x)
        (sdl-iff-fwd! (dk-cite! 'unit-circle-membership `(,chi ,x)))))
  `(,chi ,x))
(define (sdl-ccmul! a b)
  (if (not (dk-asm? `(IN (* ,a ,b) CC)))
      (begin (sdl-and! `(IN ,a CC) `(IN ,b CC)) (dk-cite! 'cc-mul-closed a b)))
  `(* ,a ,b))
(define (sdl-rep2! c rs rb)
  (let ((r (dk-cite! 'sdl-cs-rep 'kf rs rb c)))
    (if (dk-head-is? r 'AND) (dk-split! r))))
;; (= A B), (NOT (= B 1)) in context: land (NOT (= A 1))
(define (sdl-not1! A B)
  (dk-have! `(NOT (= ,A 1))
    (lambda () (di) (dk-have! `(= ,B 1) (lambda () (subst `(= ,B ,A)) (dk-ass!))) (ai `(NOT (= ,B 1))))))
;; |t| <= 1 => phi(-t) = 1, t typed
(define (sdl-u1neg! t)
  (let ((nt (sdl-neg t)))
    (sdl-k! nt)
    (dk-cite! 'nf-norm-neg 'kf t)
    (dk-have! `(<= ,(sdl-N nt) 1) (lambda () (subst `(= ,(sdl-N nt) ,(sdl-N t))) (dk-ass!)))
    (dk-apply! sdl-U1 nt)))

(sp (make-wff (sdl-chain
  `((sdl/all kf) (sdl/all uw) (IS-LOCAL-UNIFORMIZER kf uw)
    (sdl/all phi) (IS-ADD-CHARACTER kf phi) ,sdl-U1 ,sdl-U2
    (sdl/all tau) (IS-ADD-CHARACTER kf tau)
    (sdl/in c (CARR kf)) (sdl/in ci (CARR kf)) (= ((MUL kf) c ci) (ONE kf))
    (< 0 ((FNRM kf) c)) (<= ((FNRM kf) c) 1) (<= 1 ((FNRM kf) ci)) ,sdl-taut
    (sdl/in bg (CARR kf)) (sdl/in bgi (CARR kf)) (= ((MUL kf) bg bgi) (ONE kf))
    (< 0 ((FNRM kf) bgi)) (<= ((FNRM kf) bgi) 1) (<= 1 ((FNRM kf) bg)))
  `(FORSOME p (AND (IN p (CARR kf)) ,(sdl-agree 'tau 'p '((FNRM kf) bg)))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nf-metric-space-is-metric-space 'kf)
(sdl-ring!)
(sdl-hom! 'phi) (sdl-hom! 'tau)
(for-each sdl-nrm! '(c ci bg bgi))
(fact 'rr-one-in) (fact 'rr-zero-in)
(define sdl-M-qs (sdl-N 'c))
(define sdl-M-qb (sdl-N 'bg))
(define sdl-M-ps (sdl-N 'bgi))
(define sdl-M-pb (sdl-N 'ci))
(define sdl-M-CQ (sdl-cs sdl-M-qs sdl-M-qb))
(define sdl-M-CP (sdl-cs sdl-M-ps sdl-M-pb))
(define sdl-M-C0 (sdl-B '(ZERO kf) sdl-M-qs))
(define sdl-M-D0 (sdl-B '(ZERO kf) sdl-M-ps))
(define sdl-M-cart `(CARTESIAN ,sdl-M-CQ ,sdl-M-CP))
(let ((qs sdl-M-qs) (qb sdl-M-qb) (ps sdl-M-ps) (pb sdl-M-pb))
  (dk-have! `(<= ,qs ,qb) (lambda () (dk-ineq! `(<= ,qs 1) `(<= 1 ,qb))))
  (dk-have! `(<= ,ps ,pb) (lambda () (dk-ineq! `(<= ,ps 1) `(<= 1 ,pb))))
  (dk-have! `(< 0 ,pb) (lambda () (dk-ineq! `(<= 1 ,pb))))
  (dk-cite! 'sdl-cs-finite 'kf 'uw qs qb)
  (dk-cite! 'sdl-cs-finite 'kf 'uw ps pb)
  (for-each (lambda (rs rb)
              (let ((b0 (sdl-B '(ZERO kf) rb)))
                (dk-cite! 'closed-ball-is-set sdl-ms '(ZERO kf) rb)
                (dk-cite! 'image-set `(VNB-LAMBDA sdx_ ,b0 ,(sdl-B 'sdx_ rs)) b0)))
            (list qs ps) (list qb pb))
  (dk-have! '(= ((MUL kf) ci c) (ONE kf)) (lambda () (subst '(= (ONE kf) ((MUL kf) c ci))) (sdl-crs! '(c ci))))
  (dk-have! '(= ((MUL kf) bgi bg) (ONE kf)) (lambda () (subst '(= (ONE kf) ((MUL kf) bg bgi))) (sdl-crs! '(bg bgi))))
  (dk-cite! 'nf-zero-in-carr 'kf)
  (dk-cite! 'nf-norm-of-zero 'kf)
  (dk-have! `(<= ,(sdl-N '(ZERO kf)) ,qb) (lambda () (subst `(= ,(sdl-N '(ZERO kf)) 0)) (dk-ineq! `(<= 1 ,qb))))
  (dk-have! `(<= ,(sdl-N '(ZERO kf)) ,pb) (lambda () (subst `(= ,(sdl-N '(ZERO kf)) 0)) (dk-ineq! `(<= 1 ,pb))))
  (dk-cite! 'sdl-cs-in 'kf qs qb '(ZERO kf))
  (dk-cite! 'sdl-cs-in 'kf ps pb '(ZERO kf))
  (dk-have! `(IN ,sdl-M-cart SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!))))))
(define (sdl-Fb z)
  `(* (tau (CHOICE (NTH 1 ,z))) (phi ((NEG kf) ((MUL kf) (CHOICE (NTH 2 ,z)) (CHOICE (NTH 1 ,z)))))))
;; a, b in K: land tau(a) phi(-(b a)) in CC
(define (sdl-Fty! a b)
  (let ((t (sdl-neg (sdl-mul b a))))
    (sdl-k! t) (sdl-val! 'tau a) (sdl-val! 'phi t)
    (sdl-ccmul! `(tau ,a) `(phi ,t))))
(define sdl-M-ab
  (dk-abstract! sdl-M-cart 'CC sdl-Fb
    (lambda (z)
      (let ((c (dk-cite! 'cartesian-nth z sdl-M-CQ sdl-M-CP)))
        (if (dk-head-is? c 'AND) (dk-split! c)))
      (sdl-rep2! `(NTH 1 ,z) sdl-M-qs sdl-M-qb)
      (sdl-rep2! `(NTH 2 ,z) sdl-M-ps sdl-M-pb)
      (sdl-Fty! `(CHOICE (NTH 1 ,z)) `(CHOICE (NTH 2 ,z)))
      (dk-ass!))))
(define sdl-M-F (car sdl-M-ab))
(define sdl-M-ve (cdr sdl-M-ab))
(dk-rewrite-h! `(IN ,sdl-M-F (FUN ,sdl-M-cart CC)) 'CC `(CARR ,sdl-ag))
(define sdl-M-EF (dk-cite! 'finsum-fubini-c sdl-ag sdl-M-CQ sdl-M-CP sdl-M-F))
(define sdl-M-SA (cadr sdl-M-EF))
(define sdl-M-SB (caddr sdl-M-EF))
(define sdl-M-LA (caddr sdl-M-SA))
(define sdl-M-LB (caddr sdl-M-SB))
(define (sdl-M-ffv! a b)              ; a in CQ, b in CP: F([a, b]) == tau(rA) phi(-(rB rA)), NTHs reduced
  (dk-cite! 'pair-in-cartesian sdl-M-CQ sdl-M-CP a b)
  (dk-nth-h! (dk-apply! sdl-M-ve `(LIST ,a ,b))))
(define (sdl-M-fty! a b)              ; land F([a, b]) in CC
  (dk-cite! 'pair-in-cartesian sdl-M-CQ sdl-M-CP a b)
  (sdl-and! `(IN ,sdl-M-F (FUN ,sdl-M-cart CC)) `(IN (LIST ,a ,b) ,sdl-M-cart))
  (dk-cite! 'fun-apply-type sdl-M-F sdl-M-cart 'CC `(LIST ,a ,b)))
(define (sdl-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (caar t) 'VNB-LAMBDA))
           (let loop ((l t)) (and (pair? l) (or (sdl-redex? (car l)) (loop (cdr l))))))))
(define (sdl-lamb!) (if (sdl-redex? (dk-goal)) (dk-lam-b!)))
(define (sdl-crs-cc! atoms)         ; a CC identity whose atoms are typed CC terms: name them, crs
  (for-each (lambda (u) (if (pair? u) (begin (if (pair? (cdr u)) (sdl-val! (car u) (cadr u)))
                                             (let ((w (dk-name! u 'CC))) (subst `(= ,u ,w))))))
            atoms)
  (crs))
(define (sdl-M-repq! qc) (sdl-rep2! qc sdl-M-qs sdl-M-qb))
(define (sdl-M-repp! dq) (sdl-rep2! dq sdl-M-ps sdl-M-pb))
;; the g-hypotheses of sdl-orth for G, trivial radius RS
(define (sdl-gtype g) `(FORALL x (IMPLIES (IN x (CARR kf)) (IN (,g x) CC))))
(define (sdl-ghom g) `(FORALL x (IMPLIES (IN x (CARR kf)) (FORALL y (IMPLIES (IN y (CARR kf)) (= (,g ((ADD kf) x y)) (* (,g x) (,g y))))))))
(define (sdl-gtriv g rs) `(FORALL y (IMPLIES (IN y (CARR kf)) (IMPLIES (<= ((FNRM kf) y) ,rs) (= (,g y) 1)))))
(define (sdl-hom-vars) (let ((g (dk-goal))) (list (cadr (cadr (cadr g))) (caddr (cadr (cadr g))))))
(define sdl-M-EX
  `(FORSOME sdd_ (AND (IN sdd_ ,sdl-M-CP) ,(sdl-agree 'tau '(CHOICE sdd_) sdl-M-qb))))
(use-em sdl-M-EX
  (lambda ()
    (let ((dq (dk-skolem! sdl-M-EX)))
      (sdl-M-repp! dq)
      (ew `(CHOICE ,dq))
      (dk-conj-close! (lambda () (dk-ass!)))))
  (lambda ()
    (let ((qs sdl-M-qs) (qb sdl-M-qb) (ps sdl-M-ps) (pb sdl-M-pb)
          (CQ sdl-M-CQ) (CP sdl-M-CP) (C0 sdl-M-C0) (D0 sdl-M-D0)
          (LA sdl-M-LA) (LB sdl-M-LB) (Ff sdl-M-F))
      ;; LA typed
      (dk-have! `(IN ,LA (FUN ,CQ (CARR ,sdl-r)))
        (lambda ()
          (subst `(== (CARR ,sdl-r) CC))
          (dk-lam-type!
            (lambda ()
              (let* ((qc (dk-di-var!))
                     (fs (cadr (dk-goal)))
                     (f (caddr fs)))
                (dk-have! `(FORALL sdz_ (IMPLIES (IN sdz_ ,CP) (IN (,f sdz_) (CARR ,sdl-ag))))
                  (lambda () (let ((dq (dk-di-var!)))
                               (dk-lam-b!)
                               (subst `(= (CARR ,sdl-ag) CC))
                               (sdl-M-fty! qc dq)
                               (dk-ass!))))
                (dk-cite! 'finsum-type-ptwise sdl-ag CP f)
                (dk-rewrite-h! `(IN ,fs (CARR ,sdl-ag)) `(CARR ,sdl-ag) 'CC)
                (dk-ass!)))
            (lambda () (dk-ass!)))))
      ;; LA vanishes off C0 (orthogonality in the p-variable)
      (dk-have! `(FORALL sdj_ (IMPLIES (IN sdj_ ,CQ) (IMPLIES (NOT (= sdj_ ,C0)) (= (,LA sdj_) (ZERO ,sdl-r)))))
        (lambda ()
          (dk-peel!)
          (let* ((qc (cadr (cadr (dk-goal))))
                 (rc `(CHOICE ,qc)))
            (sdl-M-repq! qc)
            (dk-lam-b!)
            (dk-cite! 'cc-scalar-ring-zero)
            (subst `(= (ZERO ,sdl-r) 0))
            (let ((FC (caddr (cadr (dk-goal)))))
              (use-em `(<= ,(sdl-N rc) ,qs)
                (lambda ()
                  (let ((dz (sdl-add rc (sdl-neg '(ZERO kf)))))
                    (dk-have! `(= ,dz ,rc) (lambda () (sdl-crs! (list rc))))
                    (dk-have! `(<= ,(sdl-N dz) ,qs) (lambda () (subst `(= ,dz ,rc)) (dk-ass!)))
                    (dk-have! `(<= 0 ,qs) (lambda () (dk-ineq! `(< 0 ,qs))))
                    (dk-cite! 'sdl-ball-eq 'kf rc '(ZERO kf) qs)
                    (dk-have! `(= ,qc ,C0) (lambda () (subst `(= ,C0 ,(sdl-B rc qs))) (dk-ass!)))
                    (ai `(NOT (= ,qc ,C0)))))
                (lambda ()
                  (sdl-nrm! rc)
                  (dk-cite! 'rr-not-le-lt (sdl-N rc) qs)
                  (dk-cite! 'sdl-scale-gt 'kf 'ci 'c rc)
                  (sdl-k! (sdl-mul 'ci rc))
                  (let* ((x (dk-skolem! (dk-apply! sdl-U2 (sdl-mul 'ci rc))))
                         (h (sdl-neg (sdl-mul 'ci x)))
                         (gP `(VNB-LAMBDA sdgx_ (CARR kf) (phi ((NEG kf) ((MUL kf) sdgx_ ,rc)))))
                         (tgt (sdl-mul (sdl-mul 'ci rc) x)))
                    (sdl-k! h) (sdl-k! tgt)
                    (dk-cite! 'nf-norm-neg 'kf (sdl-mul 'ci x))
                    (dk-cite! 'sdl-le-mul1 'kf 'ci x)
                    (dk-have! `(<= ,(sdl-N h) ,pb) (lambda () (subst `(= ,(sdl-N h) ,(sdl-N (sdl-mul 'ci x)))) (dk-ass!)))
                    (sdl-val! 'phi tgt)
                    (dk-have! `(= (,gP ,h) (phi ,tgt))
                      (lambda ()
                        (sdl-k! (sdl-neg (sdl-mul h rc)))
                        (dk-lam-b!)
                        (dk-have! `(= ,(sdl-neg (sdl-mul h rc)) ,tgt) (lambda () (sdl-crs! (list 'ci x rc))))
                        (subst `(= ,(sdl-neg (sdl-mul h rc)) ,tgt))
                        (sdl-close!)))
                    (sdl-not1! `(,gP ,h) `(phi ,tgt))
                    (dk-have! (sdl-gtype gP)
