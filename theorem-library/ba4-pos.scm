(define (g4p-sb x y) (g4p-ad x (list '(VNEG a) y)))
(define (g4p-rw! from to) (subst (list '= from to)))
(define (g4p-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))
(define (g4p-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
        r)))
;;; the UBA view of a, for the norm laws
(define g4p-V '(UIBA-AS-UBA a))
(define g4p-accs '(SCAL VEC VADD VZERO VNEG ACT VNRM VMUL VONE))
(define (g4p-uu acc) (string->symbol (string-append "bcs-uu-" (string-downcase (symbol->string acc)))))
(define (g4p-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4p-occurs? x (car t)) (g4p-occurs? x (cdr t))))))
(define (g4p-readback! f)
  (let loop ((accs g4p-accs) (g f))
    (if (null? accs) g
        (let ((t (list (car accs) g4p-V)))
          (if (g4p-occurs? t g)
              (begin (dk-cite! (g4p-uu (car accs)) 'a)
                     (loop (cdr accs) (dk-rewrite-h! g t (list (car accs) 'a))))
              (loop (cdr accs) g))))))
(define (g4p-goal-onto-a!)
  (for-each (lambda (acc)
              (let ((t (list acc g4p-V)))
                (if (g4p-occurs? t (dk-goal))
                    (begin (dk-cite! (g4p-uu acc) 'a) (subst (list '= t (list acc 'a)))))))
            g4p-accs))
(define (g4p-onV f)
  (let walk ((e f))
    (cond ((and (pair? e) (memq (car e) g4p-accs) (= (length e) 2) (eq? (cadr e) 'a)) (list (car e) g4p-V))
          ((pair? e) (map walk e))
          (#t e))))
(define (g4p-via-a! claim)
  (if (not (dk-asm? claim)) (dk-have! claim (lambda () (g4p-goal-onto-a!) (dk-ass!)))) claim)
;;; a UBA law at the view, at vector arguments of a; its instance read back onto a
(define (g4p-vlaw! name . args)
  (dk-cite! 'bcs-uiba-is-uba 'a)
  (for-each (lambda (t) (if (not (number? t)) (g4p-via-a! (list 'IN t (list 'VEC g4p-V))))) args)
  (g4p-readback! (apply dk-cite! name g4p-V args)))
;;; ||t|| in RR, 0 <= ||t||
(define (g4p-nt! t)
  (g4p-vt! t)
  (g4p-vlaw! 'bae-vnrm-type t)
  (g4p-vlaw! 'bal-uba-vnrm-nonneg t)
  (g4p-nr t))
;;; t in RR, 0 < t: name recip(t) as rn; lands rn in RR, 0 < rn, t * rn = 1; returns rn
(define (g4p-recip! t)
  (dk-have! (list 'NOT (list '= t 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0))))
  (dk-have! (list 'AND (list 'IN t 'RR) (list 'NOT (list '= t 0))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-recip-closed t)
  (dk-cite! 'rr-recip-inverse t)
  (dk-cite! 'rr-recip-pos t)
  (let* ((r (list 'recip t)) (rn (dk-name! r)))
    (dk-rewrite-h! (list '= (list '* t r) 1) r rn)
    (dk-rewrite-h! (list '< 0 r) r rn)
    rn))

;;; ---- pos-lf-unit
(sp (g4p-st (list 'AND (list 'IN (list 'f g4p-o) 'RR) (list '<= 0 (list 'f g4p-o)))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((oo (g4p-q g4p-o g4p-o)) (pp (g4p-posat! g4p-o)))
  (g4p-alg! (list '= oo g4p-o))
  (dk-rewrite-h! (car pp) oo g4p-o)
  (dk-rewrite-h! (cadr pp) oo g4p-o)
  (dk-conj-close! (lambda () (dk-ass!))))
(g4p-qed! 'pos-lf-unit)

;;; ---- pos-lf-ball (85)
(sp (g4p-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES (list '< (g4p-nr 'x) 1)
  (list '<= (list 'f (g4p-q 'x 'x)) (list 'f g4p-o)))))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((xs (g4p-sr 'x)) (y (g4p-q 'x 'x)) (nx (g4p-nr 'x)) (fo (list 'f g4p-o)) (fy (list 'f y)))
  (g4p-vt! xs) (g4p-vt! y)
  (dk-split! (dk-cite! 'pos-lf-unit 'a 'f))
  (g4p-posat! 'x)
  (g4p-nt! 'x) (g4p-nt! xs) (g4p-nt! y)
  (dk-cite! 'bcs-uiba-star-norm 'a 'x)
  (let* ((sm (g4p-vlaw! 'bal-uba-vnrm-submult xs 'x))
         (sm2 (dk-rewrite-h! sm (g4p-nr xs) nx)))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! (list '<= nx 1) (lambda () (dk-ineq! (list '< nx 1) (list 'IN nx 'RR))))
    (dk-cite! 'rr-mul-le-right nx 1 nx)
    (dk-have! (list '= (list '* 1 nx) nx) (lambda () (crs)))
    (dk-have! (list '<= (g4p-nr y) nx) (lambda () (dk-le-chain! (g4p-nr y) (list '* nx nx) (list '* 1 nx) nx)))
    (dk-have! (list '< (g4p-nr y) 1) (lambda () (dk-ineq! (list '<= (g4p-nr y) nx) (list '< nx 1) (list 'IN nx 'RR) (list 'IN (g4p-nr y) 'RR)))))
  (g4p-alg! (list '= (g4p-sr y) y))
  (let* ((ex (dk-cite! 'uiba-one-minus-sa-square 'a y))
         (b (dk-skolem! ex #t))
         (oy (g4p-sb g4p-o y))
         (lin (g4p-ad g4p-o (g4p-ac -1 y)))
         (bb (g4p-q b b))
         (pb (cadr (g4p-posat! b)))
         (h1 (dk-rewrite-h! pb (g4p-sr b) b))
         (h2 (dk-rewrite-h! h1 (g4p-mu b b) oy)))
    (g4p-vt! oy) (g4p-vt! lin)
    (g4p-alg! (list '= oy lin))
    (let* ((h3 (dk-rewrite-h! h2 oy lin))
           (h4 (g4p-lin-h! h3 lin)))
      (dk-ineq! h4 (list 'IN fo 'RR) (list 'IN fy 'RR)))))
(g4p-qed! 'pos-lf-ball)

;;; ---- pos-lf-ball-bound
(sp (g4p-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES (list '< (g4p-nr 'x) 1)
  (list '<= (list 'MAGNITUDE (list 'f 'x)) (list 'f g4p-o)))))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((y (g4p-q 'x 'x)) (fx (list 'f 'x)) (fo (list 'f g4p-o)) (fy (list 'f y)) (m (list 'MAGNITUDE fx)))
  (g4p-vt! y) (g4p-cv! 'x)
  (dk-split! (dk-cite! 'pos-lf-unit 'a 'f))
  (g4p-posat! 'x)
  (dk-cite! 'pos-lf-ball 'a 'f 'x)
  (dk-cite! 'cc-magnitude-closed fx) (dk-cite! 'cc-magnitude-nonneg fx)
  (let* ((sc (dk-cite! 'pos-lf-schwarz-one 'a 'f 'x))
         (sq (dk-cite! 'cc-magnitude-sq-conjugate fx))
         (sc2 (dk-rewrite-h! sc (caddr sq) (cadr sq))))
    (dk-cite! 'rr-mul-le-right fy fo fo)
    (dk-have! (list '= (list '* fo fy) (list '* fy fo)) (lambda () (crs)))
    (dk-have! (list '<= (list '* m m) (list '* fo fo))
      (lambda () (dk-le-chain! (list '* m m) (list '* fo fy) (list '* fy fo) (list '* fo fo))))
    (g4p-cite*! 'rr-square-le-imp-le m fo)
    (dk-ass!)))
(g4p-qed! 'pos-lf-ball-bound)

;;; ---- pos-lf-bounded
(sp (g4p-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list '<= (list 'MAGNITUDE (list 'f 'x)) (list '* (list 'f g4p-o) (g4p-nr 'x)))))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((fx (list 'f 'x)) (fo (list 'f g4p-o)) (m (list 'MAGNITUDE fx)) (nx (g4p-nr 'x)) (pn (list '* fo nx)))
  (g4p-cv! 'x)
  (dk-split! (dk-cite! 'pos-lf-unit 'a 'f))
  (g4p-nt! 'x)
  (dk-cite! 'cc-magnitude-closed fx) (dk-cite! 'cc-magnitude-nonneg fx)
  (dk-have! (list 'IN pn 'RR) (lambda () (in-rr)))
  (let ((ch (dk-cite! 'rr-le-of-le-add-all-pos m pn)))
    (detach-with! ch
      (lambda ()
        (let* ((d (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (di)
          (dk-cite! 'rr-pos-rr-in-rr d) (dk-cite! 'rr-lt-of-pos-rr d)
          (let* ((p1 (list '+ fo 1)))
            (dk-have! (list 'IN p1 'RR) (lambda () (in-rr)))
            (dk-have! (list '< 0 p1) (lambda () (dk-ineq! (list '<= 0 fo) (list 'IN fo 'RR))))
            (let* ((rq (g4p-recip! p1))
                   (e (list '* d rq)))
              (dk-have! (list 'IN e 'RR) (lambda () (in-rr)))
              (dk-cite! 'rr-mul-pos d rq)
              (let* ((t (list '+ nx e)))
                (dk-have! (list 'IN t 'RR) (lambda () (in-rr)))
                (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '<= 0 nx) (list '< 0 e) (list 'IN nx 'RR) (list 'IN e 'RR))))
                (let* ((rt (g4p-recip! t))
                       (xp (g4p-ac rt 'x))
                       (fxp (list 'f xp)))
                  (g4p-vt! xp) (dk-cc-type! rt)
                  ;; ||x'|| = rt ||x|| < 1
                  (dk-cite! 'bcs-uiba-scal-carr 'a)
                  (dk-have! (list 'IN rt (list 'CARR (list 'SCAL g4p-V))) (lambda () (g4p-goal-onto-a!) (subst '(= (CARR (SCAL a)) CC)) (dk-ass!)))
                  (g4p-nt! xp)
                  (let* ((hm (begin (g4p-via-a! (list 'IN 'x (list 'VEC g4p-V))) (g4p-readback! (dk-cite! 'bal-uba-vnrm-homog g4p-V rt 'x)))))
                    (dk-have! (list '<= 0 rt) (lambda () (dk-ineq! (list '< 0 rt) (list 'IN rt 'RR))))
                    (dk-cite! 'rr-magnitude-is-abs rt)
                    (dk-cite! 'rr-abs-of-nonneg rt)
                    (let* ((hm2 (dk-rewrite-h! hm (list 'MAGNITUDE rt) (list 'ABS rt)))
                           (hm3 (dk-rewrite-h! hm2 (list 'ABS rt) rt))
                           (iff (dk-cite! 'rr-mul-lt-cancel-iff nx t rt)))
                      (dk-have! (list '< nx t) (lambda () (dk-ineq! (list '< 0 e) (list 'IN nx 'RR) (list 'IN e 'RR) (list 'IN t 'RR))))
                      (dk-have! (list '< (list '* nx rt) (list '* t rt)) (lambda () (dk-only! iff (list '< nx t)) (prop)))
                      (dk-have! (list '= (list '* rt nx) (list '* nx rt)) (lambda () (crs)))
                      (dk-have! (list 'IN (list '* nx rt) 'RR) (lambda () (in-rr)))
                      (dk-have! (list 'IN (list '* rt nx) 'RR) (lambda () (in-rr)))
                      (dk-have! (list '< (g4p-nr xp) 1)
                        (lambda () (dk-ineq! hm3 (dk-rewrite-h! (list '< (list '* nx rt) (list '* t rt)) (list '* t rt) 1)
                                             (list '= (list '* rt nx) (list '* nx rt)) (list 'IN (g4p-nr xp) 'RR)
                                             (list 'IN (list '* nx rt) 'RR) (list 'IN (list '* rt nx) 'RR))))))
                  ;; |f(x')| = rt m <= fo, so m <= fo t
                  (let* ((bb (dk-cite! 'pos-lf-ball-bound 'a 'f xp))
                         (eqf (dk-apply! g4p-lm rt 'x))
                         (bb2 (dk-rewrite-h! bb fxp (caddr eqf))))
                    (dk-cc-type! fx)
                    (dk-have! (list 'AND (list 'IN rt 'CC) (list 'IN fx 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                    (let* ((mm (dk-cite! 'cc-magnitude-mul rt fx))
                           (bb3 (dk-rewrite-h! bb2 (cadr mm) (caddr mm)))
                           (bb4 (dk-rewrite-h! (dk-rewrite-h! bb3 (list 'MAGNITUDE rt) (list 'ABS rt)) (list 'ABS rt) rt))
                           (rm (list '* rt m)))
                      (dk-have! (list 'IN rm 'RR) (lambda () (in-rr)))
                      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
                      (dk-cite! 'rr-mul-le-right rm fo t)
                      (dk-have! (list '= (list '* rm t) (list '* m (list '* t rt))) (lambda () (crs)))
                      (let* ((k1 (dk-rewrite-h! (list '<= (list '* rm t) (list '* fo t)) (list '* rm t) (list '* m (list '* t rt))))
                             (k2 (dk-rewrite-h! k1 (list '* t rt) 1)))
                        (dk-have! (list '= (list '* m 1) m) (lambda () (crs)))
                        ;; fo e <= d
                        (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
                        (dk-have! (list '<= fo p1) (lambda () (dk-ineq! (list 'IN fo 'RR))))
                        (dk-cite! 'rr-mul-le-right fo p1 e)
                        (dk-have! (list '= (list '* p1 e) (list '* d (list '* p1 rq))) (lambda () (crs)))
                        (let* ((q1 (dk-rewrite-h! (list '<= (list '* fo e) (list '* p1 e)) (list '* p1 e) (list '* d (list '* p1 rq))))
                               (q2 (dk-rewrite-h! q1 (list '* p1 rq) 1)))
                          (dk-have! (list '= (list '* d 1) d) (lambda () (crs)))
                          (dk-have! (list '= (list '* fo t) (list '+ pn (list '* fo e))) (lambda () (crs)))
                          (dk-have! (list 'IN (list '* fo e) 'RR) (lambda () (in-rr)))
                          (dk-have! (list 'IN (list '* fo t) 'RR) (lambda () (in-rr)))
                          (dk-ineq! k2 (list '= (list '* m 1) m) q2 (list '= (list '* d 1) d)
                                    (list '= (list '* fo t) (list '+ pn (list '* fo e)))
                                    (list 'IN m 'RR) (list 'IN pn 'RR) (list 'IN d 'RR) (list 'IN (list '* fo e) 'RR)
                                    (list 'IN (list '* fo t) 'RR)))))))))))))
    (dk-ass!)))
(g4p-qed! 'pos-lf-bounded)

;;; ---- pos-lf-norm: Proposition 4.7.  The norm part follows character-norm-one (ba-characters.scm).
;;; S = { |phi(y)| : ||y|| <= 1 }; w in S in context: land y, y in VEC a, ||y|| <= 1, |phi(y)| = w; return y
(define (g4p-out-S! S w)
  (let* ((L (cadr S)) (B (caddr S))
         (iff (dk-cite! 'image-membership-iff L B w))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (keep iff (list 'IN w S)) (prop)))
    (dk-split-all! (list rhs))
    (let* ((y (dk-skolem! (caddr rhs) #t))
           (cy (list g4p-f y)) (m (list 'MAGNITUDE cy)))
      (dk-project! (list 'IN y '(VEC a)) (lambda () (sep-me (list 'IN y B))))
      (dk-project! (subst-free (cadr B) y (cadddr B)) (lambda () (sep-me (list 'IN y B))))
      (g4p-cv! y)
      (dk-cite! 'cc-magnitude-closed cy)
      (dk-have! (list '= (list L y) m)
        (lambda () (if (not (dk-lam-b!)) (rfl))))
      (dk-rewrite-h! (list '= (list L y) w) (list L y) m)
      y)))
(define (g4p-pos-star! t)
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR-POS-STAR) (lambda () (keep iff (list 'IN t 'RR) (list '<= 0 t)) (prop)))))
(define (g4p-guarded-ass! l) (if (not (sequent-node-grounded? l)) (dk-ass!)))

(sp (g4p-st (list 'AND '(IN f (CDUAL-VEC a)) (list '= '(CDUAL-NORM a f) (list 'f g4p-o)))))
(dk-peel!)
(g4p-setup! 'f)
(dk-split! (dk-cite! 'pos-lf-unit 'a 'f))
(let ((fo (list 'f g4p-o)))
  ;; phi is in the dual
  (dk-have! '(IN f (CDUAL-VEC a))
    (lambda ()
      (mac 'CDUAL-VEC)
      (for-each (lambda (lf)
                  (if (not (sequent-node-grounded? lf))
                      (begin
                        (dk-focus! lf)
                        (let ((g (dk-goal)))
                          (cond ((dk-asm? g) (dk-ass!))
                                ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET))
                                 (dk-cite! 'membership-implies-sethood 'f '(FUN (VEC a) CC)) (dk-ass!))
                                (#t
                                 (dk-conj-close!
                                   (lambda ()
                                     (let ((g2 (dk-goal)))
                                       (cond ((dk-asm? g2) (dk-ass!))
                                             ((dk-head-is? g2 'FORSOME)
                                              (ew fo)
                                              (dk-conj-close!
                                                (lambda ()
                                                  (if (dk-head-is? (dk-goal) 'FORALL)
                                                      (let ((x (dk-di-var!)))
                                                        (dk-cite! 'pos-lf-bounded 'a 'f x)
                                                        (dk-ass!))
                                                      (dk-ass!)))))
                                             (#t (dk-ass!))))))))))))
                (dk-opened (lambda () (sep-mi))))))
  ;; ||phi|| = phi(1)
  (dk-have! (list '= '(CDUAL-NORM a f) fo)
    (lambda ()
      (mac 'CDUAL-NORM)
      (let* ((S (cadr (cadr (dk-goal)))) (L (cadr S)) (B (caddr S)) (es (list 'ESUP S)))
        (g4p-pos-star! fo)
        (dk-have! (list 'SUBSET S 'RR-POS-STAR)
          (lambda ()
            (let ((iff (dk-cite! 'subset-def S 'RR-POS-STAR)))
              (dk-have! (caddr iff)
                (lambda ()
                  (dk-peel!)
                  (let* ((w (cadr (dk-goal))) (l (proof-state-focus *ps*))
                         (y (g4p-out-S! S w)) (m (list 'MAGNITUDE (list 'f y))))
                    (dk-cite! 'cc-magnitude-nonneg (list 'f y))
                    (g4p-pos-star! m)
                    (dk-rewrite-h! (list 'IN m 'RR-POS-STAR) m w)
                    (g4p-guarded-ass! l))))
              (keep iff (caddr iff))
              (prop))))
        (dk-have! (list 'FORALL 'g4w_ (list 'IMPLIES (list 'IN 'g4w_ S) (list '<= 'g4w_ fo)))
          (lambda ()
            (dk-peel!)
            (let* ((w (cadr (dk-goal))) (l (proof-state-focus *ps*))
                   (y (g4p-out-S! S w)) (m (list 'MAGNITUDE (list 'f y))) (ny (g4p-nr y)))
              (g4p-nt! y)
              (dk-cite! 'pos-lf-bounded 'a 'f y)
              (dk-have! '(IN 1 RR) (lambda () (arith)))
              (dk-cite! 'rr-mul-le-right ny 1 fo)
              (dk-have! (list '= (list '* fo ny) (list '* ny fo)) (lambda () (crs)))
              (dk-have! (list '= (list '* 1 fo) fo) (lambda () (crs)))
              (dk-have! (list '<= m fo)
                (lambda () (dk-le-chain! m (list '* fo ny) (list '* ny fo) (list '* 1 fo) fo)))
              (dk-rewrite-h! (list '<= m fo) m w)
              (g4p-guarded-ass! l))))
        (dk-have! (list 'IN fo S)
          (lambda ()
            (let* ((iff (dk-cite! 'image-membership-iff L B fo))
                   (m1 (list 'MAGNITUDE fo)))
              (dk-cite! 'membership-implies-sethood fo 'RR)
              (g4p-vt! g4p-o)
              (g4p-vlaw! 'bal-uba-vone-norm)
              (g4p-cv! g4p-o)
              (dk-cite! 'rr-magnitude-is-abs fo)
              (dk-cite! 'rr-abs-of-nonneg fo)
              (dk-have! (list 'IN g4p-o B)
                (lambda ()
                  (for-each (lambda (lf)
                              (if (not (sequent-node-grounded? lf))
                                  (begin (dk-focus! lf)
                                         (cond ((dk-asm? (dk-goal)) (dk-ass!))
                                               ((and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                                                (dk-cite! 'membership-implies-sethood g4p-o '(VEC a)) (dk-ass!))
                                               (#t (g4p-rw! (g4p-nr g4p-o) 1) (arith))))))
                            (dk-opened (lambda () (sep-mi))))))
              (dk-have! (list '= (list L g4p-o) fo)
                (lambda ()
                  (let ((lf (proof-state-focus *ps*)))
                    (dk-lam-b!)
                    (if (not (sequent-node-grounded? lf))
                        (begin (g4p-rw! m1 (list 'ABS fo)) (g4p-rw! (list 'ABS fo) fo) (g4p-close-eq!))))))
              (dk-have! (caddr iff)
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (eq? (dk-head (dk-goal)) 'FORSOME)
                          (begin (ew g4p-o) (dk-conj-close! (lambda () (dk-ass!))))
                          (dk-ass!))))))
              (keep iff (caddr iff))
              (prop))))
        (dk-cite! 'esup-in S)
        (dk-cite! 'esup-upper S fo)
        (g4p-cite*! 'esup-least S fo)
        (g4p-cite*! 'rr-pos-star-le-antisymm es fo)
        (dk-ass!))))
  (dk-conj-close! (lambda () (dk-ass!))))
(g4p-qed! 'pos-lf-norm)

;;; =============================================================================================
;;; COROLLARY 4.10: |phi(y* x y)| <= ||x|| phi(y* y), by Proposition 4.7 for psi(x) = phi(y* x y)
(define (g4p-sand y x) (g4p-mu (g4p-mu (g4p-sr y) x) y))      ; y* x y
(define (g4p-psi y) (list 'VNB-LAMBDA 'g4u_ '(VEC a) (list 'f (g4p-sand y 'g4u_))))
;;; psi(t) = f(y* t y), t typed: land and return the equation
(define (g4p-psi-at! y t)
  (let ((cl (list '= (list (g4p-psi y) t) (list 'f (g4p-sand y t)))))
    (g4p-vt! t) (g4p-vt! (g4p-sand y t)) (g4p-cv! (g4p-sand y t))
    (if (not (dk-asm? cl))
        (dk-have! cl (lambda () (let ((l (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? l)) (g4p-close-eq!))))))
    cl))

(sp (g4p-st '(FORALL y (IMPLIES (IN y (VEC a)) (IS-POSITIVE-LF a (VNB-LAMBDA g4u_ (VEC a) (f ((VMUL a) ((VMUL a) ((VSTAR a) y) g4u_) y))))))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((psi (g4p-psi 'y))
       (ft (list 'IN psi '(FUN (VEC a) CC))))
  (dk-have! ft
    (lambda ()
      (dk-lam-type! (lambda ()
        (let* ((u (dk-di-var!)) (claim (dk-goal)))
          (g4p-vt! (g4p-sand 'y u)) (g4p-cv! (g4p-sand 'y u))
          (if (equal? (dk-goal) claim) (dk-ass!))))
        (lambda () (dk-cite! 'fun-domain-in-set '(VEC a) 'CC 'f) (dk-ass!)))))
  (let* ((iff (dk-cite! 'IS-POSITIVE-LF 'a psi))
         (liff (dk-cite! 'IS-CC-LINEAR-ON 'a psi)))
    (dk-have! (caddr liff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (dk-ass!))
                    (#t
                     (dk-peel!)
                     (let* ((g2 (dk-goal)) (lhs (cadr g2)) (arg (cadr lhs)))
                       (if (equal? (car arg) '(VADD a))
                           (let* ((u (cadr arg)) (w (caddr arg)) (su (g4p-sand 'y u)) (sw (g4p-sand 'y w)))
                             (g4p-psi-at! 'y arg) (g4p-psi-at! 'y u) (g4p-psi-at! 'y w)
                             (g4p-rw! (list psi arg) (list 'f (g4p-sand 'y arg)))
                             (g4p-rw! (list psi u) (list 'f su))
                             (g4p-rw! (list psi w) (list 'f sw))
                             (g4p-alg! (list '= (g4p-sand 'y arg) (g4p-ad su sw)))
                             (g4p-rw! (g4p-sand 'y arg) (g4p-ad su sw))
                             (g4p-vt! su) (g4p-vt! sw)
                             (subst (dk-apply! g4p-la su sw))
                             (g4p-close-eq!))
                           (let* ((c (cadr arg)) (u (caddr arg)) (su (g4p-sand 'y u)))
                             (g4p-psi-at! 'y arg) (g4p-psi-at! 'y u)
                             (g4p-rw! (list psi arg) (list 'f (g4p-sand 'y arg)))
                             (g4p-rw! (list psi u) (list 'f su))
                             (g4p-alg! (list '= (g4p-sand 'y arg) (g4p-ac c su)))
                             (g4p-rw! (g4p-sand 'y arg) (g4p-ac c su))
                             (g4p-vt! su)
                             (subst (dk-apply! g4p-lm c su))
                             (g4p-close-eq!)))))))))))
    (let ((lin (list 'IS-CC-LINEAR-ON 'a psi))
          (pos (caddr (caddr iff))))
      (dk-have! lin (lambda () (keep liff (caddr liff)) (prop)))
      (dk-have! pos
        (lambda ()
          (let* ((x (dk-di-var!)) (xs (g4p-sr x)) (xx (g4p-q x x)) (yxx (g4p-sand 'y xx))
                 (xy (g4p-mu x 'y)) (q (g4p-q xy xy)))
            (g4p-psi-at! 'y xx)
            (g4p-rw! (list psi xx) (list 'f yxx))
            (g4p-vt! xy) (g4p-vt! q)
            (g4p-alg! (list '= yxx q))
            (g4p-rw! yxx q)
            (g4p-posat! xy)
            (dk-conj-close! (lambda () (dk-ass!))))))
      (keep iff lin pos)
      (prop))))
(g4p-qed! 'pos-lf-sandwich)

(sp (g4p-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list '<= (list 'MAGNITUDE (list 'f (g4p-sand 'y 'x))) (list '* (g4p-nr 'x) (list 'f (g4p-q 'y 'y))))))))))
(dk-peel!)
(g4p-setup! 'f)
(let* ((psi (g4p-psi 'y)) (yy (g4p-q 'y 'y)) (y1y (g4p-sand 'y g4p-o)) (nx (g4p-nr 'x)))
  (dk-cite! 'pos-lf-sandwich 'a 'f 'y)
  (let* ((h (dk-cite! 'pos-lf-bounded 'a psi 'x))
         (e1 (g4p-psi-at! 'y 'x))
         (e2 (g4p-psi-at! 'y g4p-o))
         (h1 (dk-rewrite-h! h (list psi 'x) (list 'f (g4p-sand 'y 'x))))
         (h2 (dk-rewrite-h! h1 (list psi g4p-o) (list 'f y1y))))
    (g4p-vt! yy)
    (g4p-alg! (list '= y1y yy))
    (let ((h3 (dk-rewrite-h! h2 y1y yy)))
      (g4p-posat! 'y) (g4p-nt! 'x)
      (dk-have! (list '= (list '* (list 'f yy) nx) (list '* nx (list 'f yy))) (lambda () (crs)))
      (dk-rewrite-h! h3 (list '* (list 'f yy) nx) (list '* nx (list 'f yy)))
      (dk-ass!))))
(g4p-qed! 'pos-lf-sandwich-bound)

