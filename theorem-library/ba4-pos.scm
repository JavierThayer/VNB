;;; two norm facts of an involutive Banach algebra, read through the UBA view (used by ba4-rep)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (AND (IN ((VNRM a) x) RR) (<= 0 ((VNRM a) x)))))))))
(dk-peel!)
(g4p-nt! 'x)
(dk-conj-close! (lambda () (dk-ass!)))
(g4p-qed! 'uiba-vnrm-real)

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (<= ((VNRM a) ((VMUL a) ((VSTAR a) x) x)) (* ((VNRM a) x) ((VNRM a) x)))))))))
(dk-peel!)
(let* ((xs (g4p-sr 'x)) (nx (g4p-nr 'x)))
  (g4p-vt! xs) (g4p-nt! 'x) (g4p-nt! xs)
  (dk-cite! 'bcs-uiba-star-norm 'a 'x)
  (dk-rewrite-h! (g4p-vlaw! 'bal-uba-vnrm-submult xs 'x) (g4p-nr xs) nx)
  (dk-ass!))
(g4p-qed! 'uiba-star-mul-le)
