;;; ba4-pos.scm -- POSITIVE FUNCTIONALS: BanachAlgebras.pdf Lemma 4.4, Corollary 4.6.
;;; Agent BA-1111-B, 2026-11-11.  Destination: theorem-library/ba4-pos.scm.  Library: operator-algebras.
;;; Load window: after structure-library/ba-rep-vocab (this wave), theorem-library/kal-laws (the law set
;;; kal-uiba of dk-alg-norm!), theorem-library/ba-laws (bas-*), cc-real-imag (cc-self-conj-nonneg).
;;;
;;; a is a unital involutive Banach algebra, phi a positive linear functional, B(x, y) = phi(y* x).
;;;   pos-lf-conj-sym      phi(x* y) = conj phi(y* x)                 (the content of Lemma 4.4)
;;;   pos-lf-sesquilinear  Lemma 4.4: B is additive and homogeneous in x, conjugate symmetric, B(x,x) >= 0
;;;   pos-lf-hermitian     phi(x*) = conj phi(x)                      (after Corollary 4.6)
;;;   pos-lf-expand-two    phi((r x + s y)* (r x + s y)) expanded
;;;   pos-lf-schwarz       Corollary 4.6 (83): |phi(y* x)|^2 <= phi(y* y) phi(x* x)
;;;   pos-lf-schwarz-one   Corollary 4.6 (84): |phi(x)|^2 <= phi(1) phi(x* x)
;;; |z|^2 is written z conj(z), as cips-schwarz does.
;;;
;;; THE ROUTE for conjugate symmetry (the notes' polarization, reduced to two vectors): phi of
;;; (x + y)*(x + y) and of (x + i y)*(x + i y) is real; by linearity p = w + u and q = i (w - u) are
;;; real up to the real diagonal terms, where u = phi(y* x), w = phi(x* y); then w = conj(u) is a
;;; scalar identity (dk-cc-norm!).  The *-algebra expansions are dk-alg-norm! over kal-uiba.
;;; SCHWARZ without definiteness, as sip-schwarz: the test vector c x - b y when c = phi(y* y) > 0, and
;;; conj(b) x - (a + 1) y when c = 0, where b = phi(y* x), a = phi(x* x).

(define (g4p-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba4-pos: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba4-pos: unfinished" name))))

(define (g4p-st body)
  (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
    (list 'FORALL 'f (list 'IMPLIES '(IS-POSITIVE-LF a f) body))))))
(define (g4p-ad x y) (list '(VADD a) x y))
(define (g4p-ac c x) (list '(ACT a) c x))
(define (g4p-mu x y) (list '(VMUL a) x y))
(define (g4p-sr x) (list '(VSTAR a) x))
(define (g4p-q x y) (g4p-mu (g4p-sr x) y))          ; x* y
(define (g4p-vt! t) (dk-alg-type! 'kal-uiba 'a t))
(define (g4p-alg! claim) (dk-alg-have! 'kal-uiba 'a claim))

;;; open IS-POSITIVE-LF(a, f): returns (FUN-typing la lm pos)
(define (g4p-open! f)
  (let* ((hyp (list 'IS-POSITIVE-LF 'a f))
         (iff (dk-cite! 'IS-POSITIVE-LF 'a f))
         (body (caddr iff))
         (lin (dk-project! (cadr body) 'IS-POSITIVE-LF hyp))
         (pos (dk-project! (caddr body) 'IS-POSITIVE-LF hyp))
         (ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a f)))
         (ft (dk-project! (cadr ld) 'IS-CC-LINEAR-ON lin))
         (la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON lin))
         (lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON lin)))
    (list ft la lm pos)))

(define g4p-la #f) (define g4p-lm #f) (define g4p-pos #f) (define g4p-f 'f)
(define (g4p-setup! f)
  (let ((o (g4p-open! f)))
    (set! g4p-f f) (set! g4p-la (cadr o)) (set! g4p-lm (caddr o)) (set! g4p-pos (cadddr o))))

;;; (IN (f t) CC) for t typed in (VEC a)
(define (g4p-cv! t) (dk-cite! 'fun-apply-type-c g4p-f '(VEC a) 'CC t))

;;; phi at x* x: (IN (f x*x) RR) and (<= 0 ...); returns the AND's two parts landed
(define (g4p-posat! x)
  (g4p-vt! x)
  (let ((c (dk-apply! g4p-pos x)))
    (dk-split! c)
    (list (cadr c) (caddr c))))

;;; THE LINEAR EXPANSION, on a hypothesis: H mentions (f E); E is a VADD / ACT tree over atoms.
;;; Rewrites (f E) into the linear combination of f at the atoms; returns the new hypothesis.
(define (g4p-lin-h! h e)
  (let ((fe (list g4p-f e)))
    (cond ((and (pair? e) (equal? (car e) '(VADD a)))
           (let* ((e1 (cadr e)) (e2 (caddr e)))
             (g4p-vt! e1) (g4p-vt! e2)
             (let* ((eq (dk-apply! g4p-la e1 e2))
                    (h1 (dk-rewrite-h! h fe (caddr eq)))
                    (h2 (g4p-lin-h! h1 e1)))
               (g4p-lin-h! h2 e2))))
          ((and (pair? e) (equal? (car e) '(ACT a)))
           (let* ((c (cadr e)) (e1 (caddr e)))
             (g4p-vt! e1) (dk-cc-type! c)
             (let* ((eq (dk-apply! g4p-lm c e1))
                    (h1 (dk-rewrite-h! h fe (caddr eq))))
               (g4p-lin-h! h1 e1))))
          (#t (g4p-vt! e) (g4p-cv! e) h))))

;;; the same on the GOAL
(define (g4p-lin-g! e)
  (cond ((and (pair? e) (equal? (car e) '(VADD a)))
         (let* ((e1 (cadr e)) (e2 (caddr e)))
           (g4p-vt! e1) (g4p-vt! e2)
           (subst (dk-apply! g4p-la e1 e2))
           (g4p-lin-g! e1) (g4p-lin-g! e2)))
        ((and (pair? e) (equal? (car e) '(ACT a)))
         (let* ((c (cadr e)) (e1 (caddr e)))
           (g4p-vt! e1) (dk-cc-type! c)
           (subst (dk-apply! g4p-lm c e1))
           (g4p-lin-g! e1)))
        (#t (g4p-vt! e) (g4p-cv! e))))

