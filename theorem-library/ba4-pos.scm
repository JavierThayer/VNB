;;; the test vector r x + s y at scalars r s: lands 0 <= VAL[r, s]
(define (g4p-test! r s)
  (let* ((w (list '(VADD a) (list '(ACT a) r 'x) (list '(ACT a) s 'y)))
         (ww (g4p-q w w)))
    (dk-cc-type! r) (dk-cc-type! s)
    (g4p-vt! w)
    (let* ((ex (dk-cite! 'pos-lf-expand-two 'a 'f 'x 'y r s))
           (pp (g4p-posat! w)))
      (dk-rewrite-h! (cadr pp) (cadr ex) (caddr ex)))))
(define (g4p-cs-pos!)
  ;; c > 0: r = c, s = -b; the value is c (c a - m)
  (let* ((mb (list '- g4p-b))
         (nn (g4p-test! g4p-c0 mb))
         (val (caddr nn))
         (d (list '- (list '* g4p-c0 g4p-a0) g4p-m))
         (ig (dk-cite! 'rr-sub-in-rr (list '* g4p-c0 g4p-a0) g4p-m))
         (eq2 (have-f! (list '= val (list '* d g4p-c0))
                       (lambda () (dk-cite! 'cc-conjugate-fixes-rr g4p-c0) (dk-cc-norm!))))
         (n2 (dk-rewrite-h! nn val (list '* d g4p-c0))))
    (dk-have! (list '<= (list '* 0 g4p-c0) (list '* d g4p-c0))
      (lambda ()
        (fact 'rr-zero-mul g4p-c0)
        (subst (list '= (list '* 0 g4p-c0) 0))
        (ass)))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-cite! 'rr-mul-le-cancel-pos 0 g4p-c0 d)
    (dk-ineq! (list '<= 0 d) (list 'IN d 'RR)
              (list 'IN g4p-m 'RR) (list 'IN (list '* g4p-c0 g4p-a0) 'RR))))
(define (g4p-cs-zero!)
  ;; c = 0: r = conj(b), s = -(a + 1); the value is -(m (a + 2))
  (let* ((c0 (have-f! (list '= g4p-c0 0)
                      (lambda () (dk-ineq! (list '<= g4p-c0 0) (list '<= 0 g4p-c0) (list 'IN g4p-c0 'RR)))))
         (cb (list 'CONJUGATE g4p-b))
         (ig0 (dk-cite! 'cc-conjugate-closed g4p-b))
         (ma (list '- (list '+ g4p-a0 1)))
         (ig (dk-real! ma))
         (ig1 (dk-cite! 'rr-subset-cc ma))
         (nn (g4p-test! cb ma))
         (val (caddr nn))
         (k (list '+ g4p-a0 2))
         (ig3 (dk-real! k))
         (pp (list '* g4p-m k))
         (ig4a (dk-have! (list 'AND (list 'IN g4p-m 'RR) (list 'IN k 'RR)) (lambda () (dk-conj-close! dk-ass!))))
         (ig4 (dk-cite! 'rr-mul-closed g4p-m k))
         (eq2 (have-f! (list '= val (list '- pp))
                (lambda () (subst (list '= g4p-c0 0))
                           (dk-cite! 'cc-conjugate-fixes-rr ma) (dk-cc-norm!))))
         (n3 (dk-rewrite-h! nn val (list '- pp)))
         (p (dk-name! pp))
         (n4 (dk-rewrite-h! n3 pp p)))
    (dk-have! (list '<= pp (list '* 0 k))
      (lambda ()
        (fact 'rr-zero-mul k)
        (subst (list '= (list '* 0 k) 0))
        (subst (list '= pp p))
        (dk-ineq! n4 (list 'IN p 'RR))))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! (list '< 0 k) (lambda () (dk-ineq! (list '<= 0 g4p-a0) (list 'IN g4p-a0 'RR))))
    (dk-cite! 'rr-mul-le-cancel-pos g4p-m k 0)
    (subst (list '= g4p-c0 0))
    (fact 'rr-zero-mul g4p-a0)
    (subst (list '= (list '* 0 g4p-a0) 0))
    (ass)))
(use-em (list '<= g4p-c0 0)
  (lambda () (g4p-cs-zero!))
  (lambda () (dk-cite! 'rr-not-le-lt g4p-c0 0) (g4p-cs-pos!)))
