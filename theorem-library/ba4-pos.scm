;;;   pos-lf-ball-bound   ||x|| < 1 => |phi(x)| <= phi(1)
;;;   pos-lf-bounded      |phi(x)| <= phi(1) ||x||
;;;   pos-lf-norm         Proposition 4.7: phi in A*, CDUAL-NORM(a, phi) = phi(1)

(define g4p-o '(VONE a))
