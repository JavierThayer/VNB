;;; hilbert-projection.scm -- HILBERT SPACES: the parallelogram law, K-perp,
;;; the orthogonal projection theorem (Prop. 2.19), the Riesz representation
;;; theorem (Thm. 2.22) and the density criterion (Cor. 2.21).  All PROVEN modulo 0.
;;; Agent HILBERT-1, 2026-10-10 (scratchpad/triage/HILBERT-1.md).  Vocabulary:
;;; structure-library/hilbert-space.scm.  Source: Thayer, "Analise Funcional e
;;; Teoria Espectral" (reference `thayer-spectral'), sections 1.1, 1.6, 2.3, 2.4.
;;;
;;;   (0) plumbing      ip-metric-space-{unfold,is-metric-space,pts,dist}, perp-{unfold,
;;;                     membership,orth,subset}, hilbert-space-{is-cips,complete},
;;;                     cips-ip-neg-right (<x,-y> = -<x,y>), ip-normed-ag-opr, -inv, cc-zero-of-self-conj-zero,
;;;                     cc-magnitude-sqrt-self-conj, cips-eq-of-dist-sq-zero
;;;   (1) (1.1)         cips-parallelogram(-ip), cips-pythagoras
;;;   (2)               ip-orth-closure: orthogonality to A passes to the closure of A
;;;   (3) Def. 2.18     perp-is-submodule, perp-is-closed (closure-subset-closed)
;;;   (4) Prop. 2.19(i) cips-dist-sq-inf, cips-midpoint-estimate (2.6),
;;;                     hilbert-closest-point, cips-variational,
;;;                     hilbert-projection-exists, hilbert-projection-point,
;;;                     hilbert-decomposition-unique
;;;   (5) 2.19(ii)-(iii) orthogonal-projection-{apply,type,exists,unique,additive,
;;;                     homogeneous,norm-le,fixes,idempotent}
;;;   (6) Thm. 2.22     cc-linear-functional-{laws,zero-neg,kernel-membership,
;;;                     kernel-submodule,kernel-closed}, cips-ip-separates,
;;;                     cips-ip-magnitude-le, cips-ip-bound-least,
;;;                     riesz-representation-{of-kernel,exists,unique}, riesz-representation
;;;   (7) Cor. 2.21     ip-closure-{elim,intro,submodule}, hilbert-dense-iff-perp-zero
;;;
;;; THE TECHNIQUE: EXPANSION.  Every identity between inner products and every
;;; vector identity is proved by ONE device, `hpr-expand!': each inner product
;;; with a constructed argument (a sum, a negation, a scalar multiple, zero) is
;;; opened by its law -- cips-ip-add-left/-right, -neg-left / cips-ip-neg-right,
;;; -homog-left / -conj-homog-right, -zero-left/-right -- and every conjugate is
;;; pushed inwards (cc-conjugate-mul/-add/-neg/-involution/-fixes-rr, and
;;; conj<a,b> = <b,a>), until the goal is a polynomial in inner products of
;;; ATOMS, which `crs' decides over CC.  A vector identity A = B is then
;;; <A - B, A - B> = 0 expanded, closed by cips-eq-of-dist-sq-zero (the metric
;;; separates points), so no proof here rearranges a vector sum by the group
;;; laws.  The same is done for a linear functional (`hpr-f-expand!').  A
;;; subterm that must NOT be opened (the K-perp part z and 1/<z,z> in Riesz) is
;;; NAMED first with dk-name!.
;;;
;;; ROUTES.  (4) follows the book: alpha^2 = inf ||phi - xi||^2 is minus the SUP
;;; of the negated set (rr-sup-*); the minimizing sequence is a function symbol
;;; (dk-abstract!) whose value at n is CHOICE of the n-th approximation set; it is
;;; Cauchy by (2.6) with phi, psi and their midpoint in K; completeness and
;;; closedness give the limit L in K; ||L - xi||^2 <= alpha^2 + d for every d > 0
;;; because the tail lies in a closed ball (closed-set-limit-in-tail), and the
;;; book's "continuity of the norm" is not needed.  The variational step takes
;;; lambda = -s <w, e> with a real s, s ||e||^2 <= 1 (rr-scale-eps), instead of
;;; normalising ||e|| = 1: no division.  Uniqueness: u = a1 - a2 is in K and
;;; <u, u> = <a1+b1, u> - <b1, u> - <a2+b2, u> + <b2, u> = 0.  (5) P_K is a
;;; PROPERTY of a map (IS-ORTHOGONAL-PROJECTION), shown to exist (CHOICE at every
;;; vector) and to be unique (function extensionality); linearity, the norm bound
;;; and idempotence come from the uniqueness of the decomposition.  (6) Riesz:
;;; the kernel is PREIMAGE(f, closed ball {0} of CC-MS), closed by
;;; continuous-implies-closed-preimage; for f /= 0 the K-perp part z of an x0 with
;;; f(x0) /= 0 gives eta = (conj f(z) / <z,z>) z, because f(z) x - f(x) z is in K.
;;; ||f|| = ||eta|| is stated as "||eta|| bounds |f(x)| / ||x|| and is the least
;;; such constant" (the body of DUAL-NORM): there is no operator norm on a complex
;;; inner product space in the tree.  (7) the closure of a subspace is a subspace,
;;; by squared distances; the hard direction projects onto the closure.
;;;
;;; LOAD WINDOW.  After theorem-library/primitive-uniform-limit (rr-mul-le-cancel-pos,
;;; the latest file cited), with structure-library/hilbert-space just before it.
;;; Nothing cites these names, so nothing bounds it above.  Riesz is in this file,
;;; not in a hilbert-riesz.scm, because it drives the same expansion helpers, and a
;;; helper two files need belongs in driver-kit.scm (see the report).

;;; ====================================================================
;;; File-local driver (the `hpr-' prefix).
;;; ====================================================================

;;; The inner product space every helper below talks about: the eigenvariable
;;; the proof's peel minted for it, set by each proof.
(define hpr-v 'v)
(define (hpr-ip a b) (list (list 'IP hpr-v) a b))
(define (hpr-sub a b) (list (list 'VADD hpr-v) a (list (list 'VNEG hpr-v) b)))
(define (hpr-add a b) (list (list 'VADD hpr-v) a b))
(define (hpr-act c a) (list (list 'ACT hpr-v) c a))
(define (hpr-q a) (hpr-ip a a))

(define (hpr-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) hpr-v)))
(define (hpr-zero? e) (equal? e (list 'VZERO hpr-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (hpr-vt! e)
  (let ((goal (list 'IN e (list 'VEC hpr-v))))
    (cond ((and (dk-asm? goal) (not (or (hpr-op? e 'VADD) (hpr-op? e 'VNEG) (hpr-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((hpr-op? e 'VADD) (hpr-vt! (cadr e)) (hpr-vt! (caddr e)))
                 ((hpr-op? e 'VNEG) (hpr-vt! (cadr e)))
                 ((hpr-op? e 'ACT)  (hpr-ct! (cadr e)) (hpr-vt! (caddr e))))
           goal)
          ((hpr-op? e 'VADD) (hpr-vt! (cadr e)) (hpr-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type hpr-v (cadr e) (caddr e)) goal)
          ((hpr-op? e 'VNEG) (hpr-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type hpr-v (cadr e)) goal)
          ((hpr-op? e 'ACT)  (hpr-ct! (cadr e)) (hpr-vt! (caddr e))
                             (dk-cite! 'cips-act-type hpr-v (cadr e) (caddr e)) goal)
          ((hpr-zero? e) (dk-cite! 'cips-vzero-in hpr-v) goal)
          (#t (error "hpr-vt!: no typing for the vector" (expression->string e))))))

;;; land (IN c CC) for a scalar term
(define (hpr-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((hpr-op? c 'IP) (hpr-vt! (cadr c)) (hpr-vt! (caddr c))
                           (dk-cite! 'cips-ip-type hpr-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (hpr-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (hpr-ct! (cadr c)) (hpr-ct! (caddr c))
           (hpr-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (hpr-ct! (cadr c)) (hpr-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (hpr-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (hpr-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (hpr-op? e 'IP) (= (length e) 3)
              (or (hpr-compound? (cadr e)) (hpr-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((hpr-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (hpr-compound? e)
  (or (hpr-op? e 'VADD) (hpr-op? e 'VNEG) (hpr-op? e 'ACT) (hpr-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (hpr-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (hpr-vt! a) (hpr-vt! b)
    (cond ((hpr-op? a 'VADD) (dk-cite! 'cips-ip-add-left hpr-v (cadr a) (caddr a) b))
          ((hpr-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left hpr-v (cadr a) b))
          ((hpr-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left hpr-v (cadr a) (caddr a) b))
          ((hpr-zero? a)     (dk-cite! 'cips-ip-zero-left hpr-v b))
          ((hpr-op? b 'VADD) (dk-cite! 'cips-ip-add-right hpr-v a (cadr b) (caddr b)))
          ((hpr-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right hpr-v a (cadr b)))
          ((hpr-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right hpr-v (cadr b) a (caddr b)))
          ((hpr-zero? b)     (dk-cite! 'cips-ip-zero-right hpr-v a))
          (#t (error "hpr-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (hpr-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (hpr-op? x 'IP) (= (length x) 3))))))
(define (hpr-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((hpr-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((hpr-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (hpr-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "hpr-expand!: out of fuel"))
    (let ((r (hpr-find-redex (dk-goal))))
      (if r
          (let ((eq (hpr-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (hpr-find-real-conj (dk-goal))))
            (if c
                (begin
                  (hpr-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (hpr-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((hpr-op? x 'IP)
           (hpr-vt! (cadr x)) (hpr-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym hpr-v (cadr x) (caddr x))
           (subst (list '= c (hpr-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (hpr-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (hpr-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (hpr-ct! (cadr x)) (hpr-ct! (caddr x))
           (hpr-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (hpr-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (hpr-q-facts! u)
  (hpr-vt! u)
  (dk-cite! 'cips-ip-self-real hpr-v u)
  (dk-cite! 'cips-ip-self-nonneg hpr-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (hpr-norm-sq! u)
  (hpr-vt! u)
  (subst (dk-cite! 'ip-norm-unfold hpr-v u))
  (hpr-q-facts! u)
  (hpr-sqrt! (hpr-q u))
  (subst (dk-cite! 'sqrt-sq (hpr-q u))))
(define (hpr-nsq u) (list '* (list 'IP-NORM hpr-v u) (list 'IP-NORM hpr-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (hpr-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (hpr-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (hpr-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (hpr-and (cdr fs)))))
(define (hpr-have-and! . fs)
  (let ((c (hpr-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (hpr-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((hpr-op? e 'IP) (hpr-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (hpr-ct! e))
        (#t (for-each hpr-type-ips! e))))

