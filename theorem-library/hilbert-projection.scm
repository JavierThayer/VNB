(sp (make-wff (forall-guarded '(v kk pk x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IS-ORTHOGONAL-PROJECTION v kk pk)
     (IN x_ (VEC v)))
