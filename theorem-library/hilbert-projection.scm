;;; a set that contains its closure is closed
(sp (make-wff (forall-guarded '(s aa)
   '((IS-METRIC-SPACE s) (SUBSET aa (PTS s)) (SUBSET (CLOSURE s aa) aa))
   '(IS-CLOSED s aa))))
(dk-peel!)
(dk-cite! 'closure-is-closed 's 'aa)
(dk-cite! 'closure-contains 's 'aa)
(dk-have! '(FORALL hcx_ (IFF (IN hcx_ (CLOSURE s aa)) (IN hcx_ aa)))
  (lambda ()
    (dk-peel!)
    (let ((xv (cadr (cadr (dk-goal)))))
      (dk-iff! (lambda (g) (equal? g (list 'IN xv 'aa)))
               (lambda () (dk-cite! 'subset-mem-fwd '(CLOSURE s aa) 'aa xv) (ass))
               (lambda () (dk-cite! 'subset-mem-fwd 'aa '(CLOSURE s aa) xv) (ass))))))
(dk-cite! 'class-extensionality '(CLOSURE s aa) 'aa)
(subst '(= aa (CLOSURE s aa)))
(ass)
(qed 'closure-subset-closed)
(topic! 'closure-subset-closed 'analysis)

;;; z in PERP(v, ks), built from vectors in PERP: the membership, by expansion.
;;; ATOMS are the vectors of z known to be in PERP.
(define (hpr-perp-in! ks z atoms)
  (let ((goal (list 'IN z (list 'PERP hpr-v ks))))
    (if (not (dk-asm? goal))
        (begin
          (for-each (lambda (a) (dk-cite! 'perp-subset hpr-v ks)
                            (dk-cite! 'subset-mem-fwd (list 'PERP hpr-v ks) (list 'VEC hpr-v) a))
                    atoms)
          (hpr-vt! z)
          (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ ks)
                                         (list '= (hpr-ip z 'prk_) 0)))
            (lambda ()
              (dk-peel!)
              (let ((k (caddr (cadr (dk-goal)))))
                (dk-cite! 'subset-mem-fwd ks (list 'VEC hpr-v) k)
                (let ((eqs (map (lambda (a) (dk-cite! 'perp-orth hpr-v ks a k)) atoms)))
                  (hpr-expand!)
                  (for-each (lambda (e) (subst e)) eqs)
                  (hpr-type-ips! (dk-goal))
                  (crs)))))
          (hpr-iff-bwd! 'perp-membership hpr-v ks z)))
    (if (equal? (dk-goal) goal) (ass))
    goal))

(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v ks)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET ks (VEC v)))
   '(IS-SUBMODULE v (PERP v ks)))))
(dk-peel!)
(let ((pp '(PERP v ks)))
  (dk-cite! 'perp-subset 'v 'ks)
  (dk-cite! 'cips-scal-carrier 'v)
  (dk-have! (list 'IN '(VZERO v) pp) (lambda () (hpr-perp-in! 'ks '(VZERO v) '())))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp)
              (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ pp) (list 'IN '((VADD v) x_ y_) pp)))))
    (lambda () (dk-peel!) (hpr-perp-in! 'ks '((VADD v) x_ y_) '(x_ y_))))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp) (list 'IN '((VNEG v) x_) pp)))
    (lambda () (dk-peel!) (hpr-perp-in! 'ks '((VNEG v) x_) '(x_))))
  (dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ (CARR (SCAL v)))
              (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pp) (list 'IN '((ACT v) r_ x_) pp)))))
    (lambda ()
      (dk-peel!)
      (dk-rewrite-h! '(IN r_ (CARR (SCAL v))) '(CARR (SCAL v)) 'CC)
      (hpr-perp-in! 'ks '((ACT v) r_ x_) '(x_))))
  (mac 'is-submodule)
  (dk-conj-close! dk-ass!))
(qed 'perp-is-submodule)
(topic! 'perp-is-submodule 'algebra)

(sp (make-wff (forall-guarded '(v ks)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET ks (VEC v)))
   '(IS-CLOSED (IP-METRIC-SPACE v) (PERP v ks)))))
(dk-peel!)
(let ((pp '(PERP v ks)) (ms '(IP-METRIC-SPACE v)))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-rewrite-h! (dk-cite! 'perp-subset 'v 'ks) '(VEC v) (list 'PTS ms))
  (dk-have! (list 'SUBSET (list 'CLOSURE ms pp) pp)
    (lambda ()
      (mac 'subset-def)
      (let ((xv (dk-di-var!)))
        (dk-cite! 'closure-in-carrier ms pp)
        (dk-cite! 'subset-mem-fwd (list 'CLOSURE ms pp) (list 'PTS ms) xv)
        (dk-rewrite-h! (list 'IN xv (list 'PTS ms)) (list 'PTS ms) '(VEC v))
        (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ ks) (list '= (hpr-ip xv 'prk_) 0)))
          (lambda ()
            (dk-peel!)
            (let ((k (caddr (cadr (dk-goal)))))
              (dk-cite! 'subset-mem-fwd 'ks '(VEC v) k)
              (dk-have! (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ pp) (list '= (hpr-ip 'y_ k) 0)))
                (lambda () (dk-peel!) (dk-cite! 'perp-orth 'v 'ks 'y_ k) (ass)))
              (dk-cite! 'ip-orth-closure 'v pp k xv)
              (ass))))
        (hpr-iff-bwd! 'perp-membership 'v 'ks xv)
        (ass))))
  (dk-cite! 'closure-subset-closed ms pp)
  (ass))
(qed 'perp-is-closed)
(topic! 'perp-is-closed 'analysis)

;;; ====================================================================
;;; (4) THE PROJECTION THEOREM, Prop. 2.19 (i)
;;; ====================================================================
;;; The book's route, with the squared distance <phi - xi, phi - xi> throughout
;;; (no square root until the metric is met):
;;;   (a) alpha^2 = inf{ ||phi - xi||^2 : phi in K }, as minus the SUP of the
;;;       negated set (the tree's real completeness is rr-sup-*);
;;;   (b) the estimate (2.6), by the parallelogram law at the midpoint;
;;;   (c) a minimizing sequence, Cauchy by (2.6), convergent by completeness,
;;;       with its limit in K by closedness;
;;;   (d) the limit attains alpha (one closed ball per epsilon);
;;;   (e) the variational argument: xi - xi1 is orthogonal to K.

(define (hpr-qd p xi) (hpr-q (hpr-sub p xi)))

;;; (a) the infimum of the squared distance from xi to K
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk xi)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IN xi (VEC v)))
   (list 'FORSOME 'aa
     (hpr-and
       (list '(IN aa RR)
             '(<= 0 aa)
             (list 'FORALL 'hdp_ (list 'IMPLIES '(IN hdp_ kk) (list '<= 'aa (hpr-qd 'hdp_ 'xi))))
             (list 'FORALL 'hdn_ (list 'IMPLIES '(IN hdn_ NN)
                (list 'FORSOME 'hdq_ (list 'AND '(IN hdq_ kk)
                   (list '<= (hpr-qd 'hdq_ 'xi) '(+ aa (recip (+ hdn_ 1))))))))))))))
(dk-peel!)
(dk-cite! 'submodule-subset 'v 'kk)
(let* ((ss (list 'SEP 'hrs_ 'RR
                 (list 'FORSOME 'hrp_ (list 'AND '(IN hrp_ kk) (list '= 'hrs_ (list '- (hpr-qd 'hrp_ 'xi)))))))
       (in-kk! (lambda (p) (dk-cite! 'subset-mem-fwd 'kk '(VEC v) p)))
       (neg-in-ss! (lambda (p)             ; p in kk: land -Q(p - xi) in ss
                     (in-kk! p)
                     (hpr-q-facts! (hpr-sub p 'xi))
                     (dk-cite! 'rr-neg-closed (hpr-qd p 'xi))
                     (dk-have! (list 'IN (list '- (hpr-qd p 'xi)) ss)
                       (lambda ()
                         (in-sep! (lambda () (ass))
                                  (lambda () (witness! p (lambda () (dk-conj-close!
                                     (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (rfl))))))))))))
       (open-ss! (lambda (w)               ; w in ss: land p in kk, w = -Q(p - xi); return p
                   (sep-me (list 'IN w ss))
                   (let ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (memq w (free-vars f))))
                                      "the separation's existential")))
                     (dk-skolem! ex)))))
  (dk-have! (list 'SUBSET ss 'RR)
    (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (sep-me (list 'IN zv ss)) (dk-split-all!) (ass))))
  (dk-cite! 'submodule-vzero-in 'v 'kk)
  (neg-in-ss! '(VZERO v))
  (dk-have! (list 'FORSOME 'hrx_ (list 'IN 'hrx_ ss))
    (lambda () (witness! (list '- (hpr-qd '(VZERO v) 'xi)) (lambda () (ass)))))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! (list 'FORALL 'hrx_ (list 'IMPLIES (list 'IN 'hrx_ ss) '(<= hrx_ 0)))
    (lambda ()
      (dk-peel!)
      (let* ((w (cadr (dk-goal)))
             (p (open-ss! w)))
        (in-kk! p)
        (hpr-q-facts! (hpr-sub p 'xi))
        (dk-ineq! (list '= w (list '- (hpr-qd p 'xi))) (list '<= 0 (hpr-qd p 'xi))))))
  (dk-have! (list 'RR-UPPER-BOUND ss 0) (lambda () (hpr-iff-bwd! 'rr-upper-bound ss 0) (ass)))
  (dk-have! (list 'FORSOME 'hrb_ (list 'RR-UPPER-BOUND ss 'hrb_)) (lambda () (witness! 0 (lambda () (ass)))))
  (hpr-iff-bwd! 'rr-bounded-above ss)
  (let* ((sg (list 'SUP ss))
         (aa (list '- sg)))
    (dk-cite! 'rr-sup-in ss)
    (dk-cite! 'rr-sup-least ss 0)
    (dk-have! (list '<= 0 aa) (lambda () (dk-ineq! (list '<= sg 0))))
    (dk-cite! 'rr-sup-upper ss)
    (let ((ub (caddr (hpr-iff-fwd! 'rr-upper-bound ss sg))))
      (dk-cite! 'rr-neg-closed sg)
      (dk-have! (list 'FORALL 'hdp_ (list 'IMPLIES '(IN hdp_ kk) (list '<= aa (hpr-qd 'hdp_ 'xi))))
        (lambda ()
          (dk-peel!)
          (let ((p (cadr (cadr (caddr (dk-goal))))))
            (neg-in-ss! p)
            (let ((le (dk-apply! ub (list '- (hpr-qd p 'xi)))))
              (dk-ineq! le)))))
      (dk-have! (list 'FORALL 'hdn_ (list 'IMPLIES '(IN hdn_ NN)
                  (list 'FORSOME 'hdq_ (list 'AND '(IN hdq_ kk)
                     (list '<= (hpr-qd 'hdq_ 'xi) (list '+ aa '(recip (+ hdn_ 1))))))))
        (lambda ()
          (dk-peel!)
          (let* ((nv (car (filter (lambda (x) (dk-asm? (list 'IN x 'NN))) (free-vars (dk-goal)))))
                 (d (list 'recip (list '+ nv 1))))
            (dk-cite! 'nn-recip-succ-pos nv)
            (dk-cite! 'rr-pos-rr-in-rr d)
            (dk-cite! 'rr-lt-of-pos-rr d)
            (let* ((ex (dk-cite! 'rr-sup-approx ss d))
                   (w (dk-skolem! ex))
                   (p (open-ss! w)))
              (in-kk! p)
              (hpr-q-facts! (hpr-sub p 'xi))
              (witness! p
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN) (ass)
                          (dk-ineq! (list '< (list '- sg d) w)
                                    (list '= w (list '- (hpr-qd p 'xi)))))))))))))
      (witness! aa (lambda () (dk-conj-close! dk-ass!))))))
(qed 'cips-dist-sq-inf)
(topic! 'cips-dist-sq-inf 'analysis)

;;; (b) the book's (2.6): for phi, psi in K,
;;;     ||phi - psi||^2 <= 2 (||phi - xi||^2 + ||psi - xi||^2) - 4 alpha^2,
;;; for any lower bound alpha^2 of the squared distance (the midpoint is in K).
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk xi aa)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-SUBMODULE v kk) '(IN xi (VEC v)) '(IN aa RR)
         (list 'FORALL 'hdp_ (list 'IMPLIES '(IN hdp_ kk) (list '<= 'aa (hpr-qd 'hdp_ 'xi)))))
   (forall-guarded '(p1_ p2_) '((IN p1_ kk) (IN p2_ kk))
     (list '<= (hpr-qd 'p1_ 'p2_)
           (list '- (list '+ (list '* 2 (hpr-qd 'p1_ 'xi)) (list '* 2 (hpr-qd 'p2_ 'xi)))
                    '(* 4 aa)))))))
(dk-peel!)
(let* ((lb (dk-pick (dk-head? 'FORALL) "the lower bound"))
       (sum (hpr-add 'p1_ 'p2_))
       (mid (hpr-act 1/2 sum)))
  (dk-cite! 'submodule-subset 'v 'kk)
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) 'p1_)
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) 'p2_)
  (dk-cite! 'cips-scal-carrier 'v)
  (dk-have! '(IN 1/2 CC) (lambda () (arith)))
  (dk-rewrite-h! '(IN 1/2 CC) 'CC '(CARR (SCAL v)))
  (dk-cite! 'submodule-vadd-closed 'v 'kk 'p1_ 'p2_)
  (dk-cite! 'submodule-act-closed 'v 'kk 1/2 sum)
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) mid)
  (let ((le (dk-apply! lb mid)))
    (for-each (lambda (u) (hpr-q-facts! u))
              (list (hpr-sub 'p1_ 'p2_) (hpr-sub 'p1_ 'xi) (hpr-sub 'p2_ 'xi) (hpr-sub mid 'xi)))
    (let ((id (list '= (hpr-qd 'p1_ 'p2_)
                    (list '- (list '+ (list '* 2 (hpr-qd 'p1_ 'xi)) (list '* 2 (hpr-qd 'p2_ 'xi)))
                             (list '* 4 (hpr-qd mid 'xi))))))
      (dk-have! id (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
      (dk-ineq! id le))))
(qed 'cips-midpoint-estimate)
(topic! 'cips-midpoint-estimate 'inequalities)

;;; x = y from <x - y, x - y> = 0: the metric of v separates points.  Every
;;; vector identity below is proved through this door -- expand <A-B, A-B> to a
;;; polynomial in inner products of atoms, `crs' says it is 0 -- so no proof in
;;; this file rearranges a vector sum by the group laws.
(sp (make-wff (forall-guarded '(v x_ y_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IN x_ (VEC v)) '(IN y_ (VEC v))
         (list '= (hpr-qd 'x_ 'y_) 0))
   '(= x_ y_))))
(dk-peel!)
(let ((ms '(IP-METRIC-SPACE v)))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-rewrite-h! '(IN x_ (VEC v)) '(VEC v) (list 'PTS ms))
  (dk-rewrite-h! '(IN y_ (VEC v)) '(VEC v) (list 'PTS ms))
  (dk-have! (list '= (list (list 'DIST ms) 'x_ 'y_) 0)
    (lambda ()
      (subst (dk-cite! 'ip-metric-space-dist 'v 'x_ 'y_))
      (subst (list '= (hpr-qd 'x_ 'y_) 0))
      (dk-have! '(IN 0 RR) (lambda () (arith)))
      (dk-have! '(<= 0 0) (lambda () (arith)))
      (dk-have! '(= (* 0 0) 0) (lambda () (arith)))
      (hpr-have-and! '(IN 0 RR) '(<= 0 0))
      (dk-cite! 'sqrt-char 0 0)
      (ass)))
  (dk-cite! 'metric-zero-eq ms 'x_ 'y_)
  (ass))
(qed 'cips-eq-of-dist-sq-zero)
(topic! 'cips-eq-of-dist-sq-zero 'algebra)

;;; the vector identity A = B, by expansion (both sides typed vectors)
(define (hpr-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (hpr-vt! a) (hpr-vt! b)
          (dk-have! (list '= (hpr-qd a b) 0)
            (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero hpr-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (hpr-q-eq! a b)
  (let ((goal (list '= (hpr-q a) (hpr-q b))))
    (if (not (dk-asm? goal))
        (begin (hpr-vt! a) (hpr-vt! b)
               (dk-have! goal (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))))
    goal))

;;; (c)-(d) THE CLOSEST POINT.  The minimizing sequence is a function symbol
;;; (dk-abstract!) whose value at n is CHOICE of the n-th approximation set.
(define hpr-cp-aa #f)                 ; alpha^2, skolemised
(define hpr-cp-apx #f)                ; forall n. exists phi in K with the n-bound
(define (hpr-cp-set n)
  (list 'SEP 'hcz_ 'kk (list '<= (hpr-qd 'hcz_ 'xi) (list '+ hpr-cp-aa (list 'recip (list '+ n 1))))))

;;; with n in NN: land (IN (CHOICE S_n) S_n) and the two facts it carries
(define (hpr-cp-choice! n)
  (let* ((ss (hpr-cp-set n))
         (ch (list 'CHOICE ss))
         (mem (list 'IN ch ss)))
    (if (not (dk-asm? mem))
        (let* ((ex (dk-apply! hpr-cp-apx n))
               (q (dk-skolem! ex)))
          (choose-mem! ss q (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (sep-me mem)
    (dk-split-all!)
    ch))

;;; the Cauchy estimate at m, n >= N:  d(g m, g n) <= eps
(define (hpr-cp-cauchy-pair! ms g ee eps e4 small m n)
  (let* ((gm (list g m)) (gn (list g n))
         (pw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hcn_)))
                      "the pointwise bound")))
    (dk-split! (dk-apply! pw m))
    (dk-split! (dk-apply! pw n))
    (for-each (lambda (k) (dk-cite! 'subset-mem-fwd 'kk '(VEC v) k)) (list gm gn))
    (let ((est (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'p1_)))
                                   "the (2.6) estimate")
                          gm gn))
          (rm (list 'recip (list '+ m 1)))
          (rn (list 'recip (list '+ n 1))))
      (for-each (lambda (k) (dk-cite! 'nn-recip-succ-pos k)
                            (dk-cite! 'rr-pos-rr-in-rr (list 'recip (list '+ k 1))))
                (list m n))
      (let ((bm (dk-apply! small m)) (bn (dk-apply! small n)))
        (for-each hpr-q-facts! (list (hpr-sub gm gn) (hpr-sub gm 'xi) (hpr-sub gn 'xi)))
        (let* ((q (hpr-qd gm gn)) (s (list 'SQRT q)))
          (dk-have! (list '<= q ee)
            (lambda () (dk-ineq! est bm bn (list '= e4 (list '* 1/4 ee))
                                 (list '<= (hpr-qd gm 'xi) (list '+ hpr-cp-aa rm))
                                 (list '<= (hpr-qd gn 'xi) (list '+ hpr-cp-aa rn)))))
          (hpr-sqrt! q)
          (hpr-have-and! (list 'IN q 'RR) (list '<= 0 q))
          (hpr-have-and! (list 'IN ee 'RR) (list '<= q ee))
          (dk-cite! 'sqrt-mono q ee)
          (subst (dk-cite! 'ip-metric-space-dist 'v gm gn))
          (dk-ineq! (list '<= s (list 'SQRT ee)) (list '= (list 'SQRT ee) eps)))))))

;;; the tail of g lies in the closed ball about xi of radius SQRT(aa + d)
(define (hpr-cp-tail-in-ball! ms g d r small n)
  (let* ((gn (list g n))
         (pw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hcn_)))
                      "the pointwise bound"))
         (rn (list 'recip (list '+ n 1))))
    (dk-split! (dk-apply! pw n))
    (dk-cite! 'subset-mem-fwd 'kk '(VEC v) gn)
    (dk-cite! 'nn-recip-succ-pos n)
    (dk-cite! 'rr-pos-rr-in-rr rn)
    (let ((bn (dk-apply! small n))
          (q (hpr-qd 'xi gn)))
      (hpr-q-facts! (hpr-sub 'xi gn))
      (hpr-q-facts! (hpr-sub gn 'xi))
      (hpr-q-eq! (hpr-sub 'xi gn) (hpr-sub gn 'xi))
      (dk-have! (list '<= q (list '+ hpr-cp-aa d))
        (lambda () (dk-ineq! bn (list '= q (hpr-qd gn 'xi))
                             (list '<= (hpr-qd gn 'xi) (list '+ hpr-cp-aa rn)))))
      (hpr-have-and! (list 'IN q 'RR) (list '<= 0 q))
      (hpr-have-and! (list 'IN (list '+ hpr-cp-aa d) 'RR) (list '<= q (list '+ hpr-cp-aa d)))
      (dk-cite! 'sqrt-mono q (list '+ hpr-cp-aa d))
      (dk-cite! 'ip-metric-space-pts 'v)
      (dk-have! (list 'IN gn (list 'PTS ms))
        (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
      (dk-have! (list '<= (list (list 'DIST ms) 'xi gn) r)
        (lambda () (subst (dk-cite! 'ip-metric-space-dist 'v 'xi gn)) (ass)))
      (hpr-iff-bwd! 'closed-ball-membership ms 'xi r gn)
      (ass))))

(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk xi)
   '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (IP-METRIC-SPACE v) kk) (IN xi (VEC v)))
   (list 'FORSOME 'hcp_
     (list 'AND '(IN hcp_ kk)
       (list 'FORALL 'hdp_ (list 'IMPLIES '(IN hdp_ kk)
                                 (list '<= (hpr-qd 'hcp_ 'xi) (hpr-qd 'hdp_ 'xi)))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'hilbert-space-complete 'v)
(define hpr-ms '(IP-METRIC-SPACE v))
(dk-cite! 'ip-metric-space-is-metric-space 'v)
(dk-cite! 'ip-metric-space-pts 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(let* ((ex (dk-cite! 'cips-dist-sq-inf 'v 'kk 'xi))
       (aa (dk-skolem! ex)))
  (set! hpr-cp-aa aa)
  (set! hpr-cp-apx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hdn_)))
                            "the approximation universal"))
  (dk-cite! 'cips-midpoint-estimate 'v 'kk 'xi aa))
(define hpr-cp-g
  (car (dk-abstract! 'NN 'kk (lambda (n) (list 'CHOICE (hpr-cp-set n)))
                     (lambda (n) (hpr-cp-choice! n) (ass)))))
(define hpr-cp-ve (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f hpr-cp-g)
                                            (dk-contains? f 'CHOICE)))
                           "the value equation"))
;; pointwise: g(n) in K and ||g(n) - xi||^2 <= aa + 1/(n+1)
(dk-have! (list 'FORALL 'hcn_ (list 'IMPLIES '(IN hcn_ NN)
            (list 'AND (list 'IN (list hpr-cp-g 'hcn_) 'kk)
                       (list '<= (hpr-qd (list hpr-cp-g 'hcn_) 'xi)
                             (list '+ hpr-cp-aa '(recip (+ hcn_ 1)))))))
  (lambda ()
    (dk-peel!)
    (let* ((n (car (filter (lambda (x) (dk-asm? (list 'IN x 'NN))) (free-vars (dk-goal)))))
           (ch (hpr-cp-choice! n)))
      (subst (dk-apply! hpr-cp-ve n))
      (dk-conj-close! dk-ass!))))
;; g is a sequence of points of the metric space
(dk-rewrite-h! '(SUBSET kk (VEC v)) '(VEC v) (list 'PTS hpr-ms))
(dk-cite! 'fun-codomain-superset hpr-cp-g 'NN 'kk (list 'PTS hpr-ms))
;; g is Cauchy
(dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
            (list 'FORSOME 'hnn_ (list 'AND '(IN hnn_ NN)
              (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
                (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                  (list 'IMPLIES '(AND (<= hnn_ m) (<= hnn_ n_))
                    (list '<= (list (list 'DIST hpr-ms) (list hpr-cp-g 'm) (list hpr-cp-g 'n_)) 'eps))))))))))
  (lambda ()
    (dk-peel!)
    (let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps"))))
      (dk-cite! 'rr-pos-rr-in-rr eps)
      (dk-cite! 'rr-lt-of-pos-rr eps)
      (dk-cite! 'rr-mul-pos eps eps)
      (dk-have! (list 'IN (list '* eps eps) 'RR) (lambda () (type-term)))
      (let* ((ee (dk-name! (list '* eps eps)))
             (e4 (list '* 1/4 ee)))
        (dk-rewrite-h! (list '< 0 (list '* eps eps)) (list '* eps eps) ee)
        (dk-have! (list 'IN e4 'RR) (lambda () (type-term)))
        (dk-have! (list '< 0 e4) (lambda () (dk-ineq! (list '< 0 ee))))
        (dk-cite! 'rr-pos-rr-of-lt e4)
        (dk-have! (list '= e4 (list '* 1/4 ee)) (lambda () (rfl)))
        (dk-have! (list '<= 0 ee) (lambda () (dk-ineq! (list '< 0 ee))))
        (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
        (dk-have! (list '= (list '* eps eps) ee)
          (lambda () (subst (list '= ee (list '* eps eps))) (rfl)))
        (hpr-have-and! (list 'IN ee 'RR) (list '<= 0 ee))
        (hpr-have-and! (list 'IN eps 'RR) (list '<= 0 eps))
        (dk-cite! 'sqrt-char ee eps)
        (hpr-sqrt! ee)
        (let* ((ex (dk-cite! 'recip-succ-small e4))
               (nn0 (dk-skolem! ex))
               (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq nn0 (free-vars f))))
                               "the recip bound")))
          (witness! nn0
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'IN) (ass)
                      (begin
                        (dk-peel!)
                        (dk-split-all!)
                        (let* ((g (dk-goal))
                               (m (cadr (cadr (cadr g)))) (n (cadr (caddr (cadr g)))))
                          (hpr-cp-cauchy-pair! hpr-ms hpr-cp-g ee eps e4 small m n)))))))))))))
(hpr-iff-bwd! 'is-cauchy-seq hpr-ms hpr-cp-g)
;; complete: g converges to some L, and L is in K
(define hpr-cp-l
  (let* ((cv (dk-apply! (dk-cite! 'complete-cauchy-converges hpr-ms) hpr-cp-g))
         (ex (hpr-iff-fwd! 'converges hpr-ms hpr-cp-g)))
    (dk-skolem! ex)))
(dk-cite! 'closed-limit-in hpr-ms 'kk hpr-cp-g hpr-cp-l)
(dk-rewrite-h! '(SUBSET kk (PTS (IP-METRIC-SPACE v))) (list 'PTS hpr-ms) '(VEC v))
(dk-cite! 'subset-mem-fwd 'kk '(VEC v) hpr-cp-l)
(dk-have! (list 'IN 'xi (list 'PTS hpr-ms))
  (lambda () (subst (list '== (list 'PTS hpr-ms) '(VEC v))) (ass)))
;; (d) ||L - xi||^2 <= aa + d for every d > 0, by one closed ball
(hpr-q-facts! (hpr-sub hpr-cp-l 'xi))
(hpr-q-facts! (hpr-sub 'xi hpr-cp-l))
(hpr-q-eq! (hpr-sub 'xi hpr-cp-l) (hpr-sub hpr-cp-l 'xi))
(dk-have! (list 'FORALL 'hcd_ (list 'IMPLIES '(POS-RR hcd_)
            (list '<= (hpr-qd hpr-cp-l 'xi) (list '+ hpr-cp-aa 'hcd_))))
  (lambda ()
    (dk-peel!)
    (let* ((d (cadr (dk-pick (dk-head? 'POS-RR) "d")))
           (ad (list '+ hpr-cp-aa d))
           (r (list 'SQRT ad))
           (cb (list 'CLOSED-BALL hpr-ms 'xi r)))
      (dk-cite! 'rr-pos-rr-in-rr d)
      (dk-cite! 'rr-lt-of-pos-rr d)
      (dk-have! (list 'IN ad 'RR) (lambda () (type-term)))
      (dk-have! (list '<= 0 ad) (lambda () (dk-ineq! (list '<= 0 hpr-cp-aa) (list '< 0 d))))
      (hpr-sqrt! ad)
      (dk-cite! 'closed-ball-is-closed hpr-ms 'xi r)
      (let* ((ex (dk-cite! 'recip-succ-small d))
             (nn0 (dk-skolem! ex))
             (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq nn0 (free-vars f))))
                             "the recip bound")))
        (dk-have! (list 'FORALL 'hct_ (list 'IMPLIES '(IN hct_ NN)
                    (list 'IMPLIES (list '<= nn0 'hct_) (list 'IN (list hpr-cp-g 'hct_) cb))))
          (lambda ()
            (dk-peel!)
            (let ((n (cadr (cadr (dk-goal)))))
              (hpr-cp-tail-in-ball! hpr-ms hpr-cp-g d r small n))))
        (dk-cite! 'closed-set-limit-in-tail hpr-ms cb hpr-cp-g hpr-cp-l nn0)
        (hpr-iff-fwd! 'closed-ball-membership hpr-ms 'xi r hpr-cp-l)
        (let* ((q (hpr-qd 'xi hpr-cp-l))
               (s (list 'SQRT q))
               (de (dk-cite! 'ip-metric-space-dist 'v 'xi hpr-cp-l)))
          (hpr-sqrt! q)
          (dk-rewrite-h! (list '<= (cadr de) r) (cadr de) s)
          (dk-cite! 'rr-mul-le-right s r s)
          (dk-cite! 'rr-mul-le-right s r r)
          (dk-have! (list '= (list '* r s) (list '* s r)) (lambda () (crs)))
          (dk-have! (list '<= q ad)
            (lambda () (dk-le-chain! q (list '* s s) (list '* r s) (list '* s r) (list '* r r) ad)))
          (dk-ineq! (list '<= q ad) (list '= q (hpr-qd hpr-cp-l 'xi))))))))
(dk-cite! 'rr-le-of-le-add-all-pos (hpr-qd hpr-cp-l 'xi) hpr-cp-aa)
(witness! hpr-cp-l
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN) (ass)
            (begin
              (dk-peel!)
              (let* ((p (cadr (cadr (caddr (dk-goal)))))
                     (lb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hdp_)
                                                   (not (dk-contains? f 'p1_))))
                                  "the lower bound")))
                (dk-cite! 'subset-mem-fwd 'kk '(VEC v) p)
                (hpr-q-facts! (hpr-sub p 'xi))
                (dk-ineq! (dk-apply! lb p) (list '<= (hpr-qd hpr-cp-l 'xi) hpr-cp-aa)))))))))
(qed 'hilbert-closest-point)
(topic! 'hilbert-closest-point 'analysis)


;;; (e) THE VARIATIONAL ARGUMENT: if w is no longer than any w + t.e, then
;;; <w, e> = 0.  The book takes t = <w, e> / ||e||^2 after normalising e; here
;;; t = -s <w, e> with a real s > 0 small enough that s ||e||^2 <= 1
;;; (rr-scale-eps), which needs no division:
;;;   ||w + t e||^2 = ||w||^2 - 2 s |c|^2 + s^2 |c|^2 ||e||^2 <= ||w||^2 - s |c|^2.
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v w_ e_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IN w_ (VEC v)) '(IN e_ (VEC v))
         (list 'FORALL 'hvt_ (list 'IMPLIES '(IN hvt_ CC)
                 (list '<= (hpr-q 'w_) (hpr-q (hpr-add 'w_ (hpr-act 'hvt_ 'e_)))))))
   '(= ((IP v) w_ e_) 0))))
(dk-peel!)
(let* ((hyp (dk-pick (dk-head? 'FORALL) "the minimality hypothesis"))
       (c (hpr-ip 'w_ 'e_))
       (cj (list 'conjugate c))
       (aw (hpr-q 'e_)))
  (hpr-ct! c)
  (hpr-ct! cj)
  (dk-split! (dk-cite! 'cc-self-conj-nonneg c))
  (hpr-q-facts! 'w_)
  (hpr-q-facts! 'e_)
  (let* ((m0 (dk-name! (list '* c cj))))
    (dk-rewrite-h! (list '<= 0 (list '* c cj)) (list '* c cj) m0)
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(< 0 1) (lambda () (arith)))
    (dk-cite! 'rr-pos-rr-of-lt 1)
    (let* ((ex (dk-cite! 'rr-scale-eps aw 1))
           (s (dk-skolem! ex))
           (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq s (free-vars f))))
                           "the rr-scale-eps universal")))
      (dk-cite! 'rr-pos-rr-in-rr s)
      (dk-cite! 'rr-lt-of-pos-rr s)
      (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
      (dk-have! (list '<= s s) (lambda () (dk-ineq!)))
      (let* ((as1 (dk-apply! small s))
             (ns (list '- s))
             (tt (list '* ns c)))
        (dk-cite! 'rr-neg-closed s)
        (hpr-ct! ns)
        (hpr-have-and! (list 'IN ns 'CC) (list 'IN c 'CC))
        (dk-cite! 'cc-mul-closed ns c)
        (let* ((inst (dk-apply! hyp tt))
               (big (hpr-q (hpr-add 'w_ (hpr-act tt 'e_))))
               (rhs (list '+ (hpr-q 'w_)
                          (list '- (list '* (list '* s aw) (list '* s (list '* c cj)))
                                   (list '* 2 (list '* s (list '* c cj)))))))
          (hpr-q-facts! (hpr-add 'w_ (hpr-act tt 'e_)))
          (dk-have! (list '= big rhs)
            (lambda ()
              (hpr-expand!)
              (hpr-type-ips! (dk-goal))
              (crs)))
          (let* ((e1 (dk-rewrite-h! (list '= big rhs) (list '* c cj) m0))
                 (p1 (list '* s m0))
                 (b1 (list '* s aw)))
            (dk-have! (list 'IN p1 'RR) (lambda () (type-term)))
            (dk-have! (list 'IN b1 'RR) (lambda () (type-term)))
            (let* ((n1 (dk-name! p1))
                   (n2 (dk-name! b1))
                   (e2 (dk-rewrite-h! (dk-rewrite-h! e1 p1 n1) b1 n2)))
              ;; 0 <= n1 and n2 <= 1
              (dk-cite! 'rr-mul-le-right 0 s m0)
              (dk-have! (list '= (list '* 0 m0) 0) (lambda () (crs)))
              (dk-have! (list '= (list '* aw s) b1) (lambda () (crs)))
              (dk-have! (list '<= 0 n1)
                (lambda () (dk-ineq! (list '<= (list '* 0 m0) p1) (list '= (list '* 0 m0) 0)
                                     (list '= n1 p1))))
              (dk-rewrite-h! (dk-rewrite-h! as1 (list '* aw s) b1) b1 n2)
              (dk-cite! 'rr-mul-le-right n2 1 n1)
              (dk-have! (list '= (list '* 1 n1) n1) (lambda () (crs)))
              (dk-have! (list 'IN (list '* n2 n1) 'RR) (lambda () (type-term)))
              (let ((n3 (dk-name! (list '* n2 n1))))
                (dk-have! (list '<= n1 0)
                  (lambda ()
                    (dk-ineq! inst (dk-rewrite-h! e2 (list '* n2 n1) n3)
                              (dk-rewrite-h! (list '<= (list '* n2 n1) (list '* 1 n1)) (list '* n2 n1) n3)
                              (list '= (list '* 1 n1) n1))))
                ;; s m0 <= 0 with s > 0: m0 <= 0
                (dk-have! (list '= (list '* m0 s) p1) (lambda () (crs)))
                (dk-have! (list '= (list '* 0 s) 0) (lambda () (crs)))
                (dk-have! (list '<= (list '* m0 s) (list '* 0 s))
                  (lambda ()
                    (subst (list '= (list '* m0 s) p1))
                    (subst (list '= (list '* 0 s) 0))
                    (subst (list '= p1 n1))
                    (ass)))
                (dk-cite! 'rr-mul-le-cancel-pos m0 s 0)
                (dk-have! (list '= (list '* c cj) 0)
                  (lambda () (subst (list '= (list '* c cj) m0))
                             (dk-ineq! (list '<= m0 0) (list '<= 0 m0))))
                (dk-cite! 'cc-zero-of-self-conj-zero c)
                (ass)))))))))
(qed 'cips-variational)
(topic! 'cips-variational 'inequalities)

;;; Prop. 2.19 (i), EXISTENCE: xi = xi1 + xi2 with xi1 in K, xi2 in K-perp.
;;; xi1 is the closest point; xi2 = xi - xi1 is orthogonal to K by the
;;; variational argument applied at w = xi1 - xi along each phi in K.
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk xi)
   '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (IP-METRIC-SPACE v) kk) (IN xi (VEC v)))
   '(FORSOME hpa_ (AND (IN hpa_ kk)
      (FORSOME hpb_ (AND (IN hpb_ (PERP v kk)) (= xi ((VADD v) hpa_ hpb_)))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'cips-scal-carrier 'v)
(let* ((ex (dk-cite! 'hilbert-closest-point 'v 'kk 'xi))
       (p (dk-skolem! ex))
       (best (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq p (free-vars f))))
                      "the minimality universal"))
       (b (hpr-sub 'xi p))
       (w (hpr-sub p 'xi)))
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) p)
  (hpr-vt! b)
  (hpr-vt! w)
  (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ kk) (list '= (hpr-ip b 'prk_) 0)))
    (lambda ()
      (dk-peel!)
      (let ((k (caddr (cadr (dk-goal)))))
        (dk-cite! 'subset-mem-fwd 'kk '(VEC v) k)
        ;; for every t in CC, ||w|| <= ||w + t k||: p + t k is in K
        (dk-have! (list 'FORALL 'hvt_ (list 'IMPLIES '(IN hvt_ CC)
                    (list '<= (hpr-q w) (hpr-q (hpr-add w (hpr-act 'hvt_ k))))))
          (lambda ()
            (dk-peel!)
            (let* ((tv (cadr (caddr (cadr (caddr (dk-goal))))))
                   (pt (hpr-add p (hpr-act tv k))))
              (dk-have! (list 'IN tv '(CARR (SCAL v)))
                (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))
              (dk-cite! 'submodule-act-closed 'v 'kk tv k)
              (dk-cite! 'submodule-vadd-closed 'v 'kk p (hpr-act tv k))
              (dk-cite! 'subset-mem-fwd 'kk '(VEC v) pt)
              (let ((le (dk-apply! best pt)))
                (hpr-q-eq! (hpr-add w (hpr-act tv k)) (hpr-sub pt 'xi))
                (hpr-q-facts! (hpr-add w (hpr-act tv k)))
                (hpr-q-facts! (hpr-sub pt 'xi))
                (hpr-q-facts! w)
                (dk-ineq! le (list '= (hpr-q (hpr-add w (hpr-act tv k))) (hpr-q (hpr-sub pt 'xi))))))))
        (dk-cite! 'cips-variational 'v w k)
        (dk-have! (list '= (hpr-ip b k) (list '- (hpr-ip w k)))
          (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
        (subst (list '= (hpr-ip b k) (list '- (hpr-ip w k))))
        (subst (list '= (hpr-ip w k) 0))
        (arith))))
  (hpr-iff-bwd! 'perp-membership 'v 'kk b)
  (hpr-vec-eq! 'xi (hpr-add p b))
  (witness! p
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN) (ass)
              (witness! b (lambda () (dk-conj-close! dk-ass!)))))))))
(qed 'hilbert-projection-exists)
(topic! 'hilbert-projection-exists 'analysis)
(alias! 'hilbert-projection-exists "the orthogonal projection theorem, existence")

;;; Prop. 2.19 (i), UNIQUENESS: from a1 + b1 = a2 + b2 with a's in K and b's in
;;; K-perp, a1 = a2 and b1 = b2 -- because u = a1 - a2 is in K and
;;; <u, u> = <a1 + b1, u> - <b1, u> - <a2 + b2, u> + <b2, u> = 0.
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk a1_ a2_ b1_ b2_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk)
     (IN a1_ kk) (IN a2_ kk) (IN b1_ (PERP v kk)) (IN b2_ (PERP v kk))
     (= ((VADD v) a1_ b1_) ((VADD v) a2_ b2_)))
   '(AND (= a1_ a2_) (= b1_ b2_)))))
(dk-peel!)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'perp-subset 'v 'kk)
(for-each (lambda (x) (dk-cite! 'subset-mem-fwd 'kk '(VEC v) x)) '(a1_ a2_))
(for-each (lambda (x) (dk-cite! 'subset-mem-fwd '(PERP v kk) '(VEC v) x)) '(b1_ b2_))
(let* ((u (hpr-sub 'a1_ 'a2_))
       (s1 (hpr-add 'a1_ 'b1_)) (s2 (hpr-add 'a2_ 'b2_))
       (e12 '(= ((VADD v) a1_ b1_) ((VADD v) a2_ b2_))))
  (dk-cite! 'submodule-vneg-closed 'v 'kk 'a2_)
  (dk-cite! 'submodule-vadd-closed 'v 'kk 'a1_ '((VNEG v) a2_))
  (hpr-vt! u)
  (hpr-ct! (hpr-ip s1 u))
  (hpr-ct! (hpr-ip s2 u))
  (let ((o1 (dk-cite! 'perp-orth 'v 'kk 'b1_ u))
        (o2 (dk-cite! 'perp-orth 'v 'kk 'b2_ u))
        (cg (dk-congr! e12 (lambda (x) (hpr-ip x u)))))
    (dk-have! (list '= (hpr-q u) 0)
      (lambda ()
        (let ((j (list '= (hpr-q u)
                       (list '- (list '- (hpr-ip s1 u) (hpr-ip 'b1_ u))
                                (list '- (hpr-ip s2 u) (hpr-ip 'b2_ u))))))
          (dk-have! j (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
          (subst j)
          (subst cg)
          (subst o1)
          (subst o2)
          (crs))))
    (dk-cite! 'cips-eq-of-dist-sq-zero 'v 'a1_ 'a2_)
    ;; then b1 = b2: <b1 - b2, b1 - b2> = <s1 - s2, s1 - s2> after a1 = a2
    (dk-have! (list '= (hpr-qd 'b1_ 'b2_) 0)
      (lambda ()
        (hpr-q-eq! (hpr-sub 'b1_ 'b2_) (hpr-sub s1 (hpr-add 'a1_ 'b2_)))
        (subst (list '= (hpr-qd 'b1_ 'b2_) (hpr-qd s1 (hpr-add 'a1_ 'b2_))))
        (subst e12)
        (subst '(= a2_ a1_))
        (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
    (dk-cite! 'cips-eq-of-dist-sq-zero 'v 'b1_ 'b2_)
    (dk-conj-close! dk-ass!)))
(qed 'hilbert-decomposition-unique)
(topic! 'hilbert-decomposition-unique 'analysis)
(alias! 'hilbert-decomposition-unique "the orthogonal projection theorem, uniqueness")

;;; the book's form of existence, read as a point: some a in K has xi - a in K-perp
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk xi)
   '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (IP-METRIC-SPACE v) kk) (IN xi (VEC v)))
   (list 'FORSOME 'hpa_ (list 'AND '(IN hpa_ kk) (list 'IN (hpr-sub 'xi 'hpa_) '(PERP v kk)))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'perp-subset 'v 'kk)
(let* ((ex (dk-cite! 'hilbert-projection-exists 'v 'kk 'xi))
       (a (dk-skolem! ex))
       (ex2 (dk-pick (dk-head? 'FORSOME) "the second existential"))
       (b (dk-skolem! ex2)))
  (dk-cite! 'subset-mem-fwd 'kk '(VEC v) a)
  (dk-cite! 'subset-mem-fwd '(PERP v kk) '(VEC v) b)
  (hpr-vt! (hpr-sub 'xi a))
  (dk-have! (list '= (hpr-qd (hpr-sub 'xi a) b) 0)
    (lambda () (subst (list '= 'xi (hpr-add a b))) (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
  (dk-cite! 'cips-eq-of-dist-sq-zero 'v (hpr-sub 'xi a) b)
  (dk-have! (list 'IN (hpr-sub 'xi a) '(PERP v kk))
    (lambda () (subst (list '= (hpr-sub 'xi a) b)) (ass)))
  (witness! a (lambda () (dk-conj-close! dk-ass!))))
(qed 'hilbert-projection-point)
(topic! 'hilbert-projection-point 'analysis)

;;; ====================================================================
;;; (5) THE ORTHOGONAL PROJECTION P_K, Prop. 2.19 (ii)-(iii)
;;; ====================================================================

(sp (make-wff (forall-guarded '(v kk pk x_)
   '((IS-ORTHOGONAL-PROJECTION v kk pk) (IN x_ (VEC v)))
   (list 'AND '(IN (pk x_) kk) (list 'IN (hpr-sub 'x_ '(pk x_)) '(PERP v kk))))))
(dk-peel!)
(let ((all (list 'FORALL 'opz_ (list 'IMPLIES '(IN opz_ (VEC v))
             (list 'AND '(IN (pk opz_) kk) (list 'IN (hpr-sub 'opz_ '(pk opz_)) '(PERP v kk)))))))
  (dk-have! all (lambda () (mac-h 'is-orthogonal-projection '(IS-ORTHOGONAL-PROJECTION v kk pk))
                           (dk-split-all!) (ass)))
  (dk-apply! all 'x_)
  (ass))
(qed 'orthogonal-projection-apply)
(topic! 'orthogonal-projection-apply 'plumbing)

(sp (make-wff (forall-guarded '(v kk pk)
   '((IS-ORTHOGONAL-PROJECTION v kk pk))
   '(IN pk (FUN (VEC v) (VEC v))))))
(dk-peel!)
(mac-h 'is-orthogonal-projection '(IS-ORTHOGONAL-PROJECTION v kk pk))
(dk-split-all!)
(ass)
(qed 'orthogonal-projection-type)
(topic! 'orthogonal-projection-type 'plumbing)

;;; land pk(x) in K, x - pk(x) in K-perp, and both in VEC
(define (hpr-pk! pk x)
  (let ((px (list pk x)))
    (if (not (dk-asm? (list 'IN px 'kk)))
        (begin
          (dk-split! (dk-cite! 'orthogonal-projection-apply hpr-v 'kk pk x))
          (dk-cite! 'subset-mem-fwd 'kk (list 'VEC hpr-v) px)
          (dk-cite! 'subset-mem-fwd (list 'PERP hpr-v 'kk) (list 'VEC hpr-v) (hpr-sub x px))))
    px))

;;; the common opening of the P_K proofs
(define (hpr-pk-open!)
  (dk-cite! 'submodule-subset 'v 'kk)
  (dk-cite! 'perp-subset 'v 'kk)
  (dk-cite! 'perp-is-submodule 'v 'kk)
  (dk-cite! 'cips-scal-carrier 'v))

;;; existence: a CHOICE at every vector (dk-abstract!)
(set! hpr-v 'v)
(define (hpr-op-set z)
  (list 'SEP 'hoa_ 'kk (list 'IN (hpr-sub z 'hoa_) '(PERP v kk))))
(sp (make-wff (forall-guarded '(v kk)
   '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (IP-METRIC-SPACE v) kk))
   '(FORSOME hpk_ (IS-ORTHOGONAL-PROJECTION v kk hpk_)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'ip-metric-space-is-metric-space 'v)
(dk-cite! 'ip-metric-space-pts 'v)
(dk-rewrite-h! (dk-cite! 'ms-pts-is-set '(IP-METRIC-SPACE v)) '(PTS (IP-METRIC-SPACE v)) '(VEC v))
(define (hpr-op-choice! z)
  (let* ((ss (hpr-op-set z)) (mem (list 'IN (list 'CHOICE ss) ss)))
    (if (not (dk-asm? mem))
        (let* ((ex (dk-cite! 'hilbert-projection-point 'v 'kk z))
               (a (dk-skolem! ex)))
          (choose-mem! ss a (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (sep-me mem)
    (dk-split-all!)
    (list 'CHOICE ss)))
(let* ((gv (dk-abstract! '(VEC v) '(VEC v) (lambda (z) (list 'CHOICE (hpr-op-set z)))
                         (lambda (z) (let ((c (hpr-op-choice! z)))
                                       (dk-cite! 'subset-mem-fwd 'kk '(VEC v) c) (ass)))))
       (g (car gv))
       (ve (cdr gv)))
  (dk-have! (list 'FORALL 'opz_ (list 'IMPLIES '(IN opz_ (VEC v))
              (list 'AND (list 'IN (list g 'opz_) 'kk)
                         (list 'IN (hpr-sub 'opz_ (list g 'opz_)) '(PERP v kk)))))
    (lambda ()
      (dk-peel!)
      (let ((z (cadr (cadr (cadr (dk-goal))))))
        (hpr-op-choice! z)
        (subst (dk-apply! ve z))
        (dk-conj-close! dk-ass!))))
  (witness! g (lambda () (hpr-iff-bwd! 'is-orthogonal-projection 'v 'kk g) (ass))))
(qed 'orthogonal-projection-exists)
(topic! 'orthogonal-projection-exists 'analysis)

;;; uniqueness: two maps with the property agree
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk pk qk)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk)
     (IS-ORTHOGONAL-PROJECTION v kk pk) (IS-ORTHOGONAL-PROJECTION v kk qk))
   '(= pk qk))))
(dk-peel!)
(hpr-pk-open!)
(dk-cite! 'orthogonal-projection-type 'v 'kk 'pk)
(dk-cite! 'orthogonal-projection-type 'v 'kk 'qk)
(dk-have! '(FORALL hox_ (IMPLIES (IN hox_ (VEC v)) (= (pk hox_) (qk hox_))))
  (lambda ()
    (dk-peel!)
    (let* ((x (cadr (cadr (dk-goal))))
           (px (hpr-pk! 'pk x)) (qx (hpr-pk! 'qk x)))
      (hpr-vec-eq! (hpr-add px (hpr-sub x px)) (hpr-add qx (hpr-sub x qx)))
      (dk-split! (dk-cite! 'hilbert-decomposition-unique 'v 'kk px qx (hpr-sub x px) (hpr-sub x qx)))
      (ass))))
(hpr-iff-fwd! 'fun-codomain-iff '(VEC v) '(VEC v) 'pk)
(hpr-iff-fwd! 'fun-codomain-iff '(VEC v) '(VEC v) 'qk)
(dk-cite! 'fun-domain-extensionality '(VEC v) 'pk 'qk)
(ass)
(qed 'orthogonal-projection-unique)
(topic! 'orthogonal-projection-unique 'analysis)

;;; (ii) P_K is linear: additive ...
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk pk x_ y_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IS-ORTHOGONAL-PROJECTION v kk pk)
     (IN x_ (VEC v)) (IN y_ (VEC v)))
   '(= (pk ((VADD v) x_ y_)) ((VADD v) (pk x_) (pk y_))))))
(dk-peel!)
(hpr-pk-open!)
(let* ((s (hpr-add 'x_ 'y_))
       (ps (begin (hpr-vt! s) (hpr-pk! 'pk s)))
       (px (hpr-pk! 'pk 'x_)) (py (hpr-pk! 'pk 'y_))
       (a2 (hpr-add px py))
       (b2 (hpr-add (hpr-sub 'x_ px) (hpr-sub 'y_ py))))
  (dk-cite! 'submodule-vadd-closed 'v 'kk px py)
  (dk-cite! 'submodule-vadd-closed 'v '(PERP v kk) (hpr-sub 'x_ px) (hpr-sub 'y_ py))
  (hpr-vec-eq! (hpr-add ps (hpr-sub s ps)) (hpr-add a2 b2))
  (dk-split! (dk-cite! 'hilbert-decomposition-unique 'v 'kk ps a2 (hpr-sub s ps) b2))
  (ass))
(qed 'orthogonal-projection-additive)
(topic! 'orthogonal-projection-additive 'analysis)

;;; ... and homogeneous
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk pk c_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IS-ORTHOGONAL-PROJECTION v kk pk)
     (IN c_ CC) (IN x_ (VEC v)))
   '(= (pk ((ACT v) c_ x_)) ((ACT v) c_ (pk x_))))))
(dk-peel!)
(hpr-pk-open!)
(dk-have! '(IN c_ (CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))
(let* ((s (hpr-act 'c_ 'x_))
       (ps (begin (hpr-vt! s) (hpr-pk! 'pk s)))
       (px (hpr-pk! 'pk 'x_))
       (a2 (hpr-act 'c_ px))
       (b2 (hpr-act 'c_ (hpr-sub 'x_ px))))
  (dk-cite! 'submodule-act-closed 'v 'kk 'c_ px)
  (dk-cite! 'submodule-act-closed 'v '(PERP v kk) 'c_ (hpr-sub 'x_ px))
  (hpr-vec-eq! (hpr-add ps (hpr-sub s ps)) (hpr-add a2 b2))
  (dk-split! (dk-cite! 'hilbert-decomposition-unique 'v 'kk ps a2 (hpr-sub s ps) b2))
  (ass))
(qed 'orthogonal-projection-homogeneous)
(topic! 'orthogonal-projection-homogeneous 'analysis)

;;; (ii) ||P_K xi|| <= ||xi||, by Pythagoras
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk pk x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IS-ORTHOGONAL-PROJECTION v kk pk)
     (IN x_ (VEC v)))
   '(<= (IP-NORM v (pk x_)) (IP-NORM v x_)))))
(dk-peel!)
(hpr-pk-open!)
(let* ((px (hpr-pk! 'pk 'x_))
       (r (hpr-sub 'x_ px))
       (o (dk-cite! 'perp-orth 'v 'kk r px))
       (q1 (hpr-q px)) (q0 (hpr-q 'x_)))
  (hpr-q-facts! px) (hpr-q-facts! r) (hpr-q-facts! 'x_)
  (hpr-ct! (hpr-ip r px))
  (dk-have! (list '= q0 (list '+ (list '+ q1 (hpr-q r)) (list '+ (hpr-ip px r) (hpr-ip r px))))
    (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
  (dk-have! (list '= (hpr-ip px r) 0)
    (lambda () (subst (dk-cite! 'cips-ip-conj-sym 'v r px)) (subst o) (dk-have! '(IN 0 RR) (lambda () (arith)))
               (subst (dk-cite! 'cc-conjugate-fixes-rr 0)) (rfl)))
  (dk-have! (list '= q0 (list '+ q1 (hpr-q r)))
    (lambda ()
      (subst (list '= q0 (list '+ (list '+ q1 (hpr-q r)) (list '+ (hpr-ip px r) (hpr-ip r px)))))
      (subst (list '= (hpr-ip px r) 0))
      (subst o)
      (crs)))
  (dk-have! (list '<= q1 q0)
    (lambda () (dk-ineq! (list '= q0 (list '+ q1 (hpr-q r))) (list '<= 0 (hpr-q r)))))
  (hpr-have-and! (list 'IN q1 'RR) (list '<= 0 q1))
  (hpr-have-and! (list 'IN q0 'RR) (list '<= q1 q0))
  (dk-cite! 'sqrt-mono q1 q0)
  (subst (dk-cite! 'ip-norm-unfold 'v px))
  (subst (dk-cite! 'ip-norm-unfold 'v 'x_))
  (ass))
(qed 'orthogonal-projection-norm-le)
(topic! 'orthogonal-projection-norm-le 'inequalities)

;;; (iii) P_K fixes K, hence P_K o P_K = P_K
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk pk y_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IS-ORTHOGONAL-PROJECTION v kk pk)
