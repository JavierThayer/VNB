;;; ====================================================================
;;; (6) RIESZ, Thm. 2.22
;;; ====================================================================
;;; Every continuous linear functional f on a Hilbert space is x |-> <x, eta>
;;; for one eta, and ||f|| = ||eta|| in the form "||eta|| bounds |f(x)|/||x||
;;; and is the least such bound" (the body of DUAL-NORM; there is no operator
;;; norm on a complex inner product space in the tree).  The route is the
;;; projection theorem: the kernel K of f is a closed subspace; if f /= 0, the
;;; K-perp part z of some x0 with f(x0) /= 0 has f(z) /= 0, and
;;; eta = (conj f(z) / <z,z>) z works because f(z) x - f(x) z is in K.

;;; linear functional plumbing
(sp (make-wff '(FORALL v (FORALL f (IMPLIES (IS-CC-LINEAR-FUNCTIONAL v f)
   (AND (IN f (FUN (VEC v) CC))
   (AND (FORALL hlx_ (IMPLIES (IN hlx_ (VEC v))
          (FORALL hly_ (IMPLIES (IN hly_ (VEC v))
            (= (f ((VADD v) hlx_ hly_)) (+ (f hlx_) (f hly_)))))))
        (FORALL hlc_ (IMPLIES (IN hlc_ CC)
          (FORALL hlx_ (IMPLIES (IN hlx_ (VEC v))
            (= (f ((ACT v) hlc_ hlx_)) (* hlc_ (f hlx_))))))))))))))
(dk-peel!)
(mac-h 'is-cc-linear-functional '(IS-CC-LINEAR-FUNCTIONAL v f))
(dk-split-all!)
(dk-conj-close! dk-ass!)
(qed 'cc-linear-functional-laws)
(topic! 'cc-linear-functional-laws 'plumbing)

(define hpr-f 'f)
;;; land the three laws of the functional in context (once)
(define (hpr-lf-open!)
  (if (not (dk-asm? (list 'IN hpr-f (list 'FUN (list 'VEC hpr-v) 'CC))))
      (dk-split-all! (list (dk-cite! 'cc-linear-functional-laws hpr-v hpr-f)))))
(define (hpr-lf-law head)              ; the law as the laws theorem lands it
  (let* ((v hpr-v) (f hpr-f)
         (law (if (eq? head 'VADD)
                  `(FORALL hlx_ (IMPLIES (IN hlx_ (VEC ,v))
                     (FORALL hly_ (IMPLIES (IN hly_ (VEC ,v))
                       (= (,f ((VADD ,v) hlx_ hly_)) (+ (,f hlx_) (,f hly_)))))))
                  `(FORALL hlc_ (IMPLIES (IN hlc_ CC)
                     (FORALL hlx_ (IMPLIES (IN hlx_ (VEC ,v))
                       (= (,f ((ACT ,v) hlc_ hlx_)) (* hlc_ (,f hlx_))))))))))
    (if (not (dk-asm? law)) (error "hpr-lf-law: the law is not in context" head))
    law))
;;; land (IN (f x) CC)
(define (hpr-fx! x)
  (let ((g (list 'IN (list hpr-f x) 'CC)))
    (if (not (dk-asm? g))
        (begin (hpr-vt! x)
               (dk-cite! 'fun-apply-type-c hpr-f (list 'VEC hpr-v) 'CC x)))
    g))

(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v f)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-CC-LINEAR-FUNCTIONAL v f))
   (list 'AND '(= (f (VZERO v)) 0)
         (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC v))
                 '(= (f ((VNEG v) x_)) (- (f x_)))))))))
(dk-peel!)
(hpr-lf-open!)
(let ((hom (hpr-lf-law 'ACT)))
  (hpr-vec-eq! '(VZERO v) (hpr-act 0 '(VZERO v)))
  (hpr-fx! '(VZERO v))
  (dk-have! '(= (f (VZERO v)) 0)
    (lambda ()
      (subst (list '= '(VZERO v) (hpr-act 0 '(VZERO v))))
      (dk-have! '(IN 0 CC) (lambda () (arith)))
      (subst (dk-apply! hom 0 '(VZERO v)))
      (crs)))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC v)) '(= (f ((VNEG v) x_)) (- (f x_)))))
    (lambda ()
      (dk-peel!)
      (hpr-vec-eq! '((VNEG v) x_) (hpr-act -1 'x_))
      (hpr-fx! 'x_)
      (subst (list '= '((VNEG v) x_) (hpr-act -1 'x_)))
      (dk-have! '(IN -1 CC) (lambda () (arith)))
      (subst (dk-apply! hom -1 'x_))
      (crs)))
  (dk-conj-close! dk-ass!))
(qed 'cc-linear-functional-zero-neg)
(topic! 'cc-linear-functional-zero-neg 'algebra)

;;; the law f(-x) = -f(x), landed once
(define (hpr-lf-neg-law)
  (let ((pick (lambda ()
                (let ((law `(FORALL x_ (IMPLIES (IN x_ (VEC ,hpr-v))
                              (= (,hpr-f ((VNEG ,hpr-v) x_)) (- (,hpr-f x_)))))))
                  (if (dk-asm? law) (list law) '())))))
    (if (null? (pick))
        (dk-split-all! (list (dk-cite! 'cc-linear-functional-zero-neg hpr-v hpr-f))))
    (car (pick))))

;;; EXPAND f in the goal: f(a + b), f(c.a), f(-a) opened by the laws
(define (hpr-f-redex e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) hpr-f) (= (length e) 2)
              (or (hpr-op? (cadr e) 'VADD) (hpr-op? (cadr e) 'ACT) (hpr-op? (cadr e) 'VNEG)))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((hpr-f-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (hpr-f-expand!)
  (let loop ((fuel 50))
    (if (<= fuel 0) (error "hpr-f-expand!: out of fuel"))
    (let ((r (hpr-f-redex (dk-goal))))
      (if r
          (let* ((a (cadr r))
                 (f hpr-f)
                 (want (cond ((hpr-op? a 'VADD) (list '= r (list '+ (list f (cadr a)) (list f (caddr a)))))
                             ((hpr-op? a 'ACT) (list '= r (list '* (cadr a) (list f (caddr a)))))
                             (#t (list '= r (list '- (list f (cadr a))))))))
            (hpr-vt! a)
            (if (not (dk-asm? want))     ; an instance landed earlier is reused
                (cond ((hpr-op? a 'VADD) (dk-apply! (hpr-lf-law 'VADD) (cadr a) (caddr a)))
                      ((hpr-op? a 'ACT) (dk-apply! (hpr-lf-law 'ACT) (cadr a) (caddr a)))
                      (#t (dk-apply! (hpr-lf-neg-law) (cadr a)))))
            (subst want)
            (loop (- fuel 1)))))))

;;; the kernel, as the preimage of the closed ball {0} of CC-MS
(define hpr-ker '(PREIMAGE (IP-METRIC-SPACE v) f (CLOSED-BALL CC-MS 0 0)))

(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v f x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-CC-LINEAR-FUNCTIONAL v f) (IN x_ (VEC v)))
   (list 'IFF (list 'IN 'x_ hpr-ker) '(= (f x_) 0)))))
(dk-peel!)
(hpr-lf-open!)
(hpr-fx! 'x_)
(dk-cite! 'ip-metric-space-pts 'v)
(dk-have! '(IN 0 CC) (lambda () (arith)))
(let ((cb '(CLOSED-BALL CC-MS 0 0))
      (ms '(IP-METRIC-SPACE v)))
  (dk-iff! (lambda (g) (dk-head-is? g '=))
    (lambda ()
      (hpr-iff-fwd! 'preimage-membership ms 'f cb 'x_)
      (hpr-iff-fwd! 'closed-ball-membership 'CC-MS 0 0 '(f x_))
      (let* ((d (dk-cite! 'cc-ms-dist 0 '(f x_)))
             (h (dk-rewrite-h! (list '<= (cadr d) 0) (cadr d) (caddr d)))
             (df '(- 0 (f x_))))
        (hpr-ct! df)
        (dk-cite! 'cc-magnitude-nonneg df)
        (dk-cite! 'cc-magnitude-closed df)
        (dk-have! (list '= (list 'magnitude df) 0) (lambda () (dk-ineq! h (list '<= 0 (list 'magnitude df)))))
        (hpr-iff-fwd! 'cc-magnitude-zero-iff df)
        (dk-have! (list '= '(f x_) (list '- 0 df)) (lambda () (crs)))
        (subst (list '= '(f x_) (list '- 0 df)))
        (subst (list '= df 0))
        (arith)))
    (lambda ()
      (dk-have! (list 'IN 'x_ (list 'PTS ms)) (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
      (dk-cite! 'cc-ms@pts)
      (dk-have! '(IN (f x_) (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
      (dk-have! '(<= ((DIST CC-MS) 0 (f x_)) 0)
        (lambda ()
          (subst (dk-cite! 'cc-ms-dist 0 '(f x_)))
          (subst '(= (f x_) 0))
          (dk-have! '(= (- 0 0) 0) (lambda () (arith)))
          (subst '(= (- 0 0) 0))
          (dk-have! '(IN 0 CC) (lambda () (arith)))
          (dk-have! '(= 0 0) (lambda () (arith)))
          (subst (hpr-iff-bwd! 'cc-magnitude-zero-iff 0))
          (arith)))
      (hpr-iff-bwd! 'closed-ball-membership 'CC-MS 0 0 '(f x_))
      (hpr-iff-bwd! 'preimage-membership ms 'f cb 'x_)
      (ass))))
(qed 'cc-linear-functional-kernel-membership)
(topic! 'cc-linear-functional-kernel-membership 'plumbing)

;;; x in VEC with f(x) = 0: land x in the kernel; and conversely
(define hpr-kmem #f)      ; when set: the in-context universal x in K <=> f(x) = 0
(define (hpr-kmem-iff! x)
  (let* ((inst (list 'IFF (list 'IN x 'kk) (list '= (list hpr-f x) 0))))
    (if (not (dk-asm? inst)) (begin (hpr-vt! x) (dk-apply! hpr-kmem x)))
    inst))
(define (hpr-ker-in! x)
  (if hpr-kmem
      (let ((iff (hpr-kmem-iff! x)))
        (ai iff)
        (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
        (cadr iff))
      (hpr-iff-bwd! 'cc-linear-functional-kernel-membership hpr-v hpr-f x)))
(define (hpr-ker-out! x)
  (if hpr-kmem
      (let ((iff (hpr-kmem-iff! x)))
        (ai iff)
        (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
        (caddr iff))
      (hpr-iff-fwd! 'cc-linear-functional-kernel-membership hpr-v hpr-f x)))

;;; the kernel of a linear functional is a subspace ...
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v f)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-CC-LINEAR-FUNCTIONAL v f))
   (list 'IS-SUBMODULE 'v hpr-ker))))
(dk-peel!)
(hpr-lf-open!)
(dk-cite! 'cips-scal-carrier 'v)
(dk-cite! 'ip-metric-space-pts 'v)
(let ((kk hpr-ker) (ms '(IP-METRIC-SPACE v)))
  ;; VZERO in the kernel FIRST: that membership certifies the kernel term at which
  ;; subset-def is instantiated (repair 3)
  (dk-cite! 'cc-linear-functional-zero-neg 'v 'f)
  (dk-cite! 'cips-vzero-in 'v)
  (dk-split-all!)
  (hpr-ker-in! '(VZERO v))
  (dk-have! (list 'SUBSET kk '(VEC v))
    (lambda ()
      (mac 'subset-def)
      (let ((xv (dk-di-var!)))
        (hpr-iff-fwd! 'preimage-membership ms 'f '(CLOSED-BALL CC-MS 0 0) xv)
        (dk-rewrite-h! (list 'IN xv (list 'PTS ms)) (list 'PTS ms) '(VEC v))
        (ass))))
  (let ((close-by-f! (lambda (z)
                       (hpr-vt! z)
                       (dk-have! (list '= (list 'f z) 0)
                         (lambda ()
                           (hpr-f-expand!)
                           (for-each (lambda (a) (if (dk-asm? (list 'IN a kk)) (subst (hpr-ker-out! a))))
                                     (filter symbol? (free-vars (dk-goal))))
                           (hpr-type-ips! (dk-goal))
                           (crs)))
                       (hpr-ker-in! z)
                       (if (equal? (dk-goal) (list 'IN z kk)) (ass)))))
    (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ kk)
                (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ kk) (list 'IN '((VADD v) x_ y_) kk)))))
      (lambda ()
        (dk-peel!)
        (for-each (lambda (a) (dk-cite! 'subset-mem-fwd kk '(VEC v) a) (hpr-fx! a)) '(x_ y_))
        (close-by-f! '((VADD v) x_ y_))))
    (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ kk) (list 'IN '((VNEG v) x_) kk)))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'subset-mem-fwd kk '(VEC v) 'x_) (hpr-fx! 'x_)
        (close-by-f! '((VNEG v) x_))))
    (dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ (CARR (SCAL v)))
                (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ kk) (list 'IN '((ACT v) r_ x_) kk)))))
      (lambda ()
        (dk-peel!)
        (dk-rewrite-h! '(IN r_ (CARR (SCAL v))) '(CARR (SCAL v)) 'CC)
        (dk-cite! 'subset-mem-fwd kk '(VEC v) 'x_) (hpr-fx! 'x_)
        (close-by-f! '((ACT v) r_ x_))))
    (mac 'is-submodule)
    (dk-conj-close! dk-ass!)))
(qed 'cc-linear-functional-kernel-submodule)
(topic! 'cc-linear-functional-kernel-submodule 'algebra)

;;; ... and closed when f is continuous
(sp (make-wff (forall-guarded '(v f)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-CONTINUOUS (IP-METRIC-SPACE v) CC-MS f))
   (list 'IS-CLOSED '(IP-METRIC-SPACE v) hpr-ker))))
(dk-peel!)
(dk-cite! 'cc-is-metric-space)
(dk-cite! 'cc-ms@pts)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (arith)))
(dk-cite! 'closed-ball-is-closed 'CC-MS 0 0)
(let ((all (dk-cite! 'continuous-implies-closed-preimage '(IP-METRIC-SPACE v) 'CC-MS 'f)))
  (dk-apply! all '(CLOSED-BALL CC-MS 0 0))
  (ass))
