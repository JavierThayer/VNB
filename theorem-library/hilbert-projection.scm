;;; a vector is determined by its inner products: <x, e1> = <x, e2> for all x
;;; gives e1 = e2 (test at x = e1 - e2)
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v e1_ e2_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN e1_ (VEC v)) (IN e2_ (VEC v))
     (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= ((IP v) hrx_ e1_) ((IP v) hrx_ e2_)))))
   '(= e1_ e2_))))
(dk-peel!)
(let* ((hyp (dk-pick (dk-head? 'FORALL) "the hypothesis"))
       (d (hpr-sub 'e1_ 'e2_)))
  (hpr-vt! d)
  (let ((eq (dk-apply! hyp d)))
    (hpr-ct! (hpr-ip d 'e1_)) (hpr-ct! (hpr-ip d 'e2_))
    (dk-have! (list '= (hpr-q d) 0)
      (lambda ()
        (dk-have! (list '= (hpr-q d) (list '- (hpr-ip d 'e1_) (hpr-ip d 'e2_)))
          (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
        (subst (list '= (hpr-q d) (list '- (hpr-ip d 'e1_) (hpr-ip d 'e2_))))
        (subst eq)
        (crs)))
    (dk-cite! 'cips-eq-of-dist-sq-zero 'v 'e1_ 'e2_)
    (ass)))
(qed 'cips-ip-separates)
(topic! 'cips-ip-separates 'algebra)

;;; |<x, e>| <= ||x|| ||e||  (Schwarz, in the magnitude form)
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v x_ e_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)) (IN e_ (VEC v)))
   '(<= (magnitude ((IP v) x_ e_)) (* (IP-NORM v x_) (IP-NORM v e_))))))
(dk-peel!)
(let* ((c (hpr-ip 'x_ 'e_))
       (m (list 'magnitude c))
       (mm (list '* m m))
       (qx (hpr-q 'x_)) (qe (hpr-q 'e_))
       (pp (list '* qx qe)))
  (hpr-ct! c)
  (hpr-q-facts! 'x_) (hpr-q-facts! 'e_)
  (dk-cite! 'cc-magnitude-closed c)
  (dk-cite! 'cc-magnitude-nonneg c)
  (dk-split! (dk-cite! 'cc-self-conj-nonneg c))
  (hpr-sqrt! (list '* c (list 'conjugate c)))
  (dk-cite! 'cc-magnitude-sqrt-self-conj c)
  (dk-have! (list '= mm (list '* c (list 'conjugate c)))
    (lambda () (subst (list '= m (list 'SQRT (list '* c (list 'conjugate c))))) (ass)))
  (let* ((sch (dk-cite! 'cips-schwarz 'v 'x_ 'e_))
         (sch2 (dk-rewrite-h! sch (list '* c (list 'conjugate c)) mm)))
    (dk-cite! 'rr-sq-nonneg m)
    (dk-have! (list 'IN mm 'RR) (lambda () (type-term)))
    (dk-have! (list 'IN pp 'RR) (lambda () (type-term)))
    (hpr-have-and! (list 'IN mm 'RR) (list '<= 0 mm))
    (hpr-have-and! (list 'IN pp 'RR) sch2)
    (let* ((mono (dk-cite! 'sqrt-mono mm pp))
           (e1 (dk-cite! 'sqrt-of-sq m))
           (e2 (dk-cite! 'rr-abs-of-nonneg m)))
      (hpr-have-and! (list 'IN qx 'RR) (list '<= 0 qx))
      (hpr-have-and! (list 'IN qe 'RR) (list '<= 0 qe))
      (let ((e3 (dk-cite! 'sqrt-mul qx qe)))
        (subst (dk-cite! 'ip-norm-unfold 'v 'x_))
        (subst (dk-cite! 'ip-norm-unfold 'v 'e_))
        (let* ((h1 (dk-rewrite-h! mono (list 'SQRT mm) (list 'abs m)))
               (h2 (dk-rewrite-h! h1 (list 'abs m) m))
               (h3 (dk-rewrite-h! h2 (list 'SQRT pp) (caddr e3))))
          (ass))))))
(qed 'cips-ip-magnitude-le)
(topic! 'cips-ip-magnitude-le 'inequalities)

;;; ... and ||e|| is the least such constant
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v e_ c_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN e_ (VEC v)) (IN c_ RR) (<= 0 c_)
     (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v))
        (<= (magnitude ((IP v) hrx_ e_)) (* c_ (IP-NORM v hrx_))))))
   '(<= (IP-NORM v e_) c_))))
(dk-peel!)
(let* ((hyp (dk-pick (dk-head? 'FORALL) "the bound"))
       (qe (hpr-q 'e_))
       (n (list 'SQRT qe)))
  (hpr-q-facts! 'e_)
  (hpr-sqrt! qe)
  (dk-cite! 'ip-norm-unfold 'v 'e_)
  (dk-cite! 'rr-magnitude-is-abs qe)
  (dk-cite! 'rr-abs-of-nonneg qe)
  (let* ((b (dk-apply! hyp 'e_))
         (b1 (dk-rewrite-h! b (list 'IP-NORM 'v 'e_) n)))
    (let ((b3 (dk-rewrite-h! (dk-rewrite-h! b1 (list 'magnitude qe) (list 'abs qe)) (list 'abs qe) qe)))
      (subst (dk-cite! 'ip-norm-unfold 'v 'e_))
      (dk-have! '(IN 0 RR) (lambda () (arith)))
      (let ((orf (dk-cite! 'rr-le-cases 0 n)))
        (use-cases (list (cadr orf) (caddr orf))
          (lambda ()
            (dk-have! (list '<= (list '* n n) (list '* 'c_ n))
              (lambda () (subst (list '= (list '* n n) qe)) (ass)))
            (dk-cite! 'rr-mul-le-cancel-pos n n 'c_)
            (ass))
          (lambda () (dk-ineq! (list '= 0 n) '(<= 0 c_))))))))
(qed 'cips-ip-bound-least)
(topic! 'cips-ip-bound-least 'inequalities)

;;; `fact' stopped detaching at a guard the context holds (IS-SUBMODULE of the
;;; PREIMAGE kernel, met in the Riesz proof); detach the rest by hand
(define (hpr-detach-all! f)
  (if (and (pair? f) (eq? (car f) 'IMPLIES) (dk-asm? (cadr f)))
      (begin (detach! f) (hpr-detach-all! (caddr f)))
      f))

;;; THE REPRESENTATION: f(x) = <x, eta> for all x
(set! hpr-v 'v)
(set! hpr-f 'f)
(define (hpr-rz-zero-case!)              ; f vanishes: eta = 0
  (let ((all (dk-pick (dk-head? 'FORALL) "f = 0")))
    (witness! '(VZERO v)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN) (ass)
                (begin
                  (dk-peel!)
                  (let ((x (cadr (cadr (dk-goal)))))
                    (subst (dk-apply! all x))
                    (subst (dk-cite! 'cips-ip-zero-right 'v x))
                    (arith))))))))))

;;; f(x) = <x, eta> at one x, given z in K-perp with f(z) /= 0 and r0 = 1/<z,z>
(define (hpr-rz-point! kk z fz r0 eta x)
  (let* ((fx (list 'f x))
         (qz (hpr-q z))
         (y (hpr-add (hpr-act fz x) (list '(VNEG v) (hpr-act fx z))))
         (xz (hpr-ip x z)))
    (hpr-fx! x)
    (hpr-vt! y)
    (dk-have! (list '= (list 'f y) 0)
      (lambda () (hpr-f-expand!) (hpr-type-ips! (dk-goal)) (crs)))
    (hpr-ker-in! y)
    (let ((o (dk-cite! 'perp-orth 'v kk z y)))
      (dk-have! (list '= (hpr-ip y z) 0)
        (lambda ()
          (subst (dk-cite! 'cips-ip-conj-sym 'v z y))
          (subst o)
          (dk-have! '(IN 0 RR) (lambda () (arith)))
          (subst (dk-cite! 'cc-conjugate-fixes-rr 0))
          (rfl))))
    (hpr-ct! xz) (hpr-ct! qz) (hpr-ct! (hpr-ip y z))
    (let ((e3 (list '= (hpr-ip y z) (list '- (list '* fz xz) (list '* fx qz)))))
      (dk-have! e3 (lambda () (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
      ;; f(x) <z,z> = f(z) <x,z>
      (let ((e4 (list '= (list '* fx qz) (list '* fz xz))))
        (dk-have! e4
          (lambda ()
            (let ((id (list '= (list '* fx qz)
                            (list '- (list '* fz xz) (list '- (list '* fz xz) (list '* fx qz))))))
              (dk-have! id (lambda () (crs)))
              (subst id)
              (subst (list '= (list '- (list '* fz xz) (list '* fx qz)) (hpr-ip y z)))
              (subst (list '= (hpr-ip y z) 0))
              (crs))))
        ;; f(x) = f(x) <z,z> r0
        (let ((e5 (list '= fx (list '* (list '* fx qz) r0))))
          (dk-have! (list '= (list '* (list '* fx qz) r0) (list '* fx (list '* qz r0)))
            (lambda () (crs)))
          (dk-have! e5
            (lambda ()
              (subst (list '= (list '* (list '* fx qz) r0) (list '* fx (list '* qz r0))))
              (subst (list '= (list '* qz r0) 1))
              (crs)))
          (hpr-expand!)
          (hpr-type-ips! (dk-goal))
          (subst e5)
          (subst e4)
          (crs))))))

(define hpr-rz-concl
  '(FORSOME hre_ (AND (IN hre_ (VEC v))
      (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= (f hrx_) ((IP v) hrx_ hre_)))))))
(sp (make-wff (forall-guarded '(v f kk)
   (list '(IS-HILBERT-SPACE v) '(IS-CC-LINEAR-FUNCTIONAL v f) '(IS-SUBMODULE v kk)
         '(IS-CLOSED (IP-METRIC-SPACE v) kk)
         '(FORALL hkx_ (IMPLIES (IN hkx_ (VEC v)) (IFF (IN hkx_ kk) (= (f hkx_) 0)))))
   hpr-rz-concl)))
(dk-peel!)
(set! hpr-kmem (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IFF))) "the kernel"))
(dk-cite! 'hilbert-space-is-cips 'v)
(hpr-lf-open!)
(dk-cite! 'cips-vzero-in 'v)
(let ((kk 'kk))
  (dk-cite! 'submodule-subset 'v kk)
  (dk-cite! 'perp-subset 'v kk)
  (use-em '(FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= (f hrx_) 0)))
    hpr-rz-zero-case!
    (lambda ()
      (let* ((ex (push-not-h (dk-pick (dk-head? 'NOT) "f /= 0")))
             (x0 (dk-skolem! (if (dk-head-is? ex 'FORSOME) ex
                                 (dk-pick (dk-head? 'FORSOME) "the witness of f /= 0"))))
             (ex2 (dk-cite! 'hilbert-projection-point 'v kk x0))
             (a (dk-skolem! ex2))
             (z0 (hpr-sub x0 a)))
        (dk-cite! 'subset-mem-fwd kk '(VEC v) a)
        (dk-cite! 'subset-mem-fwd (list 'PERP 'v kk) '(VEC v) z0)
        (hpr-fx! x0) (hpr-fx! a) (hpr-fx! z0)
        ;; NAME the K-perp part, so that no expansion opens it
        (let* ((z (dk-name! z0 '(VEC v)))
               (fz (list 'f z))
               (qz (hpr-q z)))
          (dk-rewrite-h! (list 'IN z0 (list 'PERP 'v kk)) z0 z)
          (hpr-fx! z)
          (let ((fa (hpr-ker-out! a)))
            (dk-have! (list '= fz (list 'f x0))
              (lambda () (subst (list '= z z0)) (hpr-f-expand!) (subst fa) (hpr-type-ips! (dk-goal)) (crs))))
          (dk-have! (list 'NOT (list '= fz 0))
            (lambda ()
              (di)
              (dk-rewrite-h! (list '= fz 0) fz (list 'f x0))
              (ai (list 'NOT (list '= (list 'f x0) 0)))))
          (hpr-q-facts! z)
          (dk-cite! 'cc-linear-functional-zero-neg 'v 'f)
          (dk-split-all!)
          (dk-have! (list 'NOT (list '= qz 0))
            (lambda ()
              (di)
              (dk-cite! 'cips-ip-zero-vector 'v z)
              (let ((h (dk-rewrite-h! (list 'NOT (list '= fz 0)) z '(VZERO v))))
                (ai h))))
          (hpr-have-and! (list 'IN qz 'RR) (list 'NOT (list '= qz 0)))
          (dk-cite! 'rr-recip-closed qz)
          (dk-cite! 'rr-recip-inverse qz)
          ;; and NAME 1/<z,z>
          (let* ((r0 (dk-name! (list 'recip qz))))
            (dk-rewrite-h! (list '= (list '* qz (list 'recip qz)) 1) (list 'recip qz) r0)
            (hpr-ct! r0)
            (let* ((c (list '* (list 'conjugate fz) r0))
                   (eta (hpr-act c z)))
              (hpr-ct! c)
              (hpr-vt! eta)
              (witness! eta
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN) (ass)
                          (begin
                            (dk-peel!)
                            (hpr-rz-point! kk z fz r0 eta (cadr (cadr (dk-goal)))))))))))))))))
(qed 'riesz-representation-of-kernel)
(topic! 'riesz-representation-of-kernel 'analysis)
(set! hpr-kmem #f)

(sp (make-wff (forall-guarded '(v f)
   '((IS-HILBERT-SPACE v) (IS-CC-LINEAR-FUNCTIONAL v f) (IS-CONTINUOUS (IP-METRIC-SPACE v) CC-MS f))
   hpr-rz-concl)))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cc-linear-functional-kernel-submodule 'v 'f)
(dk-cite! 'cc-linear-functional-kernel-closed 'v 'f)
(dk-have! (list 'FORALL 'hkx_ (list 'IMPLIES '(IN hkx_ (VEC v))
            (list 'IFF (list 'IN 'hkx_ hpr-ker) '(= (f hkx_) 0))))
  (lambda () (dk-peel!) (dk-cite! 'cc-linear-functional-kernel-membership 'v 'f (cadr (cadr (dk-goal)))) (ass)))
(dk-cite! 'riesz-representation-of-kernel 'v 'f hpr-ker)
(ass)
(qed 'riesz-representation-exists)
(topic! 'riesz-representation-exists 'analysis)
(alias! 'riesz-representation-exists "the Riesz representation theorem")

;;; Thm. 2.22 in full: the representing vector, the bound |f(x)| <= ||x|| ||eta||,
;;; and ||eta|| the least such constant (i.e. ||f|| = ||eta||)
(set! hpr-v 'v)
(define hpr-rz-full
  '(FORSOME hre_ (AND (IN hre_ (VEC v))
     (AND (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= (f hrx_) ((IP v) hrx_ hre_))))
     (AND (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v))
            (<= (magnitude (f hrx_)) (* (IP-NORM v hrx_) (IP-NORM v hre_)))))
          (FORALL hrc_ (IMPLIES (IN hrc_ RR) (IMPLIES (<= 0 hrc_)
            (IMPLIES (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v))
                       (<= (magnitude (f hrx_)) (* hrc_ (IP-NORM v hrx_)))))
                     (<= (IP-NORM v hre_) hrc_))))))))))
(sp (make-wff (forall-guarded '(v f)
   '((IS-HILBERT-SPACE v) (IS-CC-LINEAR-FUNCTIONAL v f) (IS-CONTINUOUS (IP-METRIC-SPACE v) CC-MS f))
   hpr-rz-full)))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(let* ((ex (dk-cite! 'riesz-representation-exists 'v 'f))
       (eta (dk-skolem! ex))
       (rep (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq eta (free-vars f))))
                     "the representation")))
  (witness! eta
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-head-is? g 'IN) (ass))
              ((dk-asm? g) (ass))
              ((dk-contains? g 'hrc_)
               (dk-peel!)
               (let* ((cv (car (filter (lambda (x) (dk-asm? (list 'IN x 'RR)))
                                       (free-vars (dk-goal)))))
                      (hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq cv (free-vars f))))
                                   "the bound hypothesis")))
                 (dk-have! (list 'FORALL 'hrx_ (list 'IMPLIES '(IN hrx_ (VEC v))
                             (list '<= (list 'magnitude (list '(IP v) 'hrx_ eta))
                                   (list '* cv '(IP-NORM v hrx_)))))
                   (lambda ()
                     (dk-peel!)
                     (let ((x (cadr (cadr (cadr (dk-goal))))))
                       (let ((b (dk-apply! hb x))
                             (e (dk-apply! rep x)))
                         (dk-rewrite-h! b (list 'f x) (caddr e))
                         (ass)))))
                 (dk-cite! 'cips-ip-bound-least 'v eta cv)
                 (ass)))
              (#t
               (dk-peel!)
               (let ((x (cadr (cadr (cadr (dk-goal))))))
                 (subst (dk-apply! rep x))
                 (dk-cite! 'cips-ip-magnitude-le 'v x eta)
                 (ass))))))))))
(qed 'riesz-representation)
(topic! 'riesz-representation 'analysis)
(alias! 'riesz-representation "the Riesz representation theorem")

;;; ... and the representing vector is unique
(sp (make-wff (forall-guarded '(v f e1_ e2_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN e1_ (VEC v)) (IN e2_ (VEC v))
     (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= (f hrx_) ((IP v) hrx_ e1_))))
     (FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= (f hrx_) ((IP v) hrx_ e2_)))))
   '(= e1_ e2_))))
(dk-peel!)
(let ((r1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'e1_))) "rep 1"))
      (r2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'e2_))) "rep 2")))
  (dk-have! '(FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= ((IP v) hrx_ e1_) ((IP v) hrx_ e2_))))
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (dk-goal)))))
        (dk-apply! r1 x)
        (dk-apply! r2 x)
        (subst (list '= (list '(IP v) x 'e1_) (list 'f x)))
        (ass))))
  (dk-cite! 'cips-ip-separates 'v 'e1_ 'e2_)
  (ass))
(qed 'riesz-representation-unique)
(topic! 'riesz-representation-unique 'analysis)

;;; ====================================================================
;;; (7) DENSITY, Cor. 2.21: a subspace K is dense iff K-perp = {0}
;;; ====================================================================
;;; The book: if K is dense, K-perp = (closure K)-perp = H-perp = {0}; if
;;; K-perp = {0}, H = (closure K)-perp + closure K = closure K.  The second half
;;; needs the closure of a subspace to be a subspace, proved here with squared
;;; distances: x is in the closure of A iff A has points y with <x-y, x-y> <= e
;;; for every e > 0 (ip-closure-elim / ip-closure-intro).

(set! hpr-v 'v)
;;; elim: x in closure(A), e > 0  ==>  some y in A has ||x - y||^2 <= e
(sp (make-wff (forall-guarded '(v aa x_ e_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IN x_ (CLOSURE (IP-METRIC-SPACE v) aa)) '(POS-RR e_))
   (list 'FORSOME 'hcy_ (list 'AND '(IN hcy_ aa) (list '<= (hpr-qd 'x_ 'hcy_) 'e_))))))
(dk-peel!)
(let* ((ms '(IP-METRIC-SPACE v))
       (near (caddr (begin (dk-cite! 'ip-metric-space-is-metric-space 'v)
                           (hpr-iff-fwd! 'closure-membership ms 'aa 'x_))))
       (r (list 'SQRT 'e_)))
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-rewrite-h! (list 'IN 'x_ (list 'PTS ms)) (list 'PTS ms) '(VEC v))
  (dk-cite! 'rr-pos-rr-in-rr 'e_)
  (dk-cite! 'rr-lt-of-pos-rr 'e_)
  (dk-have! '(<= 0 e_) (lambda () (dk-ineq! '(< 0 e_))))
  (hpr-sqrt! 'e_)
  (dk-have! (list 'NOT (list '= 0 r))
    (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '= (list '* r r) 'e_) r 0) '(< 0 e_))))
  (hpr-have-and! (list 'IN r 'RR) (list '<= 0 r) (list 'NOT (list '= 0 r)))
  (let ((ball (list 'BALL ms 'x_ r)))
    (dk-cite! 'ball-is-open ms 'x_ r)
    (dk-cite! 'ball-center-in ms 'x_ r)
    (hpr-have-and! (list 'IS-OPEN ms ball) (list 'IN 'x_ ball))
    (let* ((y (dk-skolem! (dk-apply! near ball))))
      (hpr-iff-fwd! 'ball-membership ms 'x_ r y)
      (dk-rewrite-h! (list 'IN y (list 'PTS ms)) (list 'PTS ms) '(VEC v))
      (let* ((q (hpr-qd 'x_ y)) (s (list 'SQRT q))
             (de (dk-cite! 'ip-metric-space-dist 'v 'x_ y)))
        (hpr-q-facts! (hpr-sub 'x_ y))
        (hpr-sqrt! q)
        (dk-rewrite-h! (list '<= (cadr de) r) (cadr de) s)
        (dk-cite! 'rr-mul-le-right s r s)
        (dk-cite! 'rr-mul-le-right s r r)
        (dk-have! (list '= (list '* r s) (list '* s r)) (lambda () (crs)))
        (dk-have! (list '<= q 'e_)
          (lambda () (dk-le-chain! q (list '* s s) (list '* r s) (list '* s r) (list '* r r) 'e_)))
        (witness! y (lambda () (dk-conj-close! dk-ass!)))))))
(qed 'ip-closure-elim)
(topic! 'ip-closure-elim 'analysis)

;;; intro: x in VEC, and A has points y with ||x - y||^2 <= e for every e > 0
;;; ==>  x in closure(A)
(sp (make-wff (forall-guarded '(v aa x_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(SUBSET aa (VEC v)) '(IN x_ (VEC v))
         (list 'FORALL 'hce_ (list 'IMPLIES '(POS-RR hce_)
           (list 'FORSOME 'hcy_ (list 'AND '(IN hcy_ aa) (list '<= (hpr-qd 'x_ 'hcy_) 'hce_))))))
   '(IN x_ (CLOSURE (IP-METRIC-SPACE v) aa)))))
(dk-peel!)
(let* ((ms '(IP-METRIC-SPACE v))
       (hyp (dk-pick (dk-head? 'FORALL) "the approximation hypothesis")))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-have! (list 'IN 'x_ (list 'PTS ms)) (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
  (dk-have! (list 'FORALL 'u (list 'IMPLIES (list 'AND (list 'IS-OPEN ms 'u) '(IN x_ u))
              '(FORSOME y (AND (IN y u) (IN y aa)))))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((u (caddr (cadr (caddr (dk-goal)))))
             (op (hpr-iff-fwd! 'is-open ms u))
             (all (caddr (caddr op)))
             (ex (dk-apply! all 'x_))
             (r (dk-skolem! ex))
             (sub (list 'SUBSET (list 'BALL ms 'x_ r) u)))
        (dk-cite! 'rr-pos-rr-in-rr r)
        (dk-cite! 'rr-lt-of-pos-rr r)
        (let* ((h (list '* 1/2 r))
               (e (list '* h h)))
          (dk-have! (list 'IN h 'RR) (lambda () (type-term)))
          (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 r))))
          (dk-cite! 'rr-mul-pos h h)
          (dk-have! (list 'IN e 'RR) (lambda () (type-term)))
          (dk-cite! 'rr-pos-rr-of-lt e)
          (let* ((y (dk-skolem! (dk-apply! hyp e)))
                 (q (hpr-qd 'x_ y)))
            (dk-cite! 'subset-mem-fwd 'aa '(VEC v) y)
            (hpr-q-facts! (hpr-sub 'x_ y))
            (dk-have! (list 'IN y (list 'PTS ms)) (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
            (hpr-have-and! (list 'IN q 'RR) (list '<= 0 q))
            (hpr-have-and! (list 'IN e 'RR) (list '<= q e))
            (dk-cite! 'sqrt-mono q e)
            (dk-have! (list '<= 0 h) (lambda () (dk-ineq! (list '< 0 h))))
            (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
            (hpr-have-and! (list 'IN e 'RR) (list '<= 0 e))
            (hpr-have-and! (list 'IN h 'RR) (list '<= 0 h))
            (dk-have! (list '= (list '* h h) e) (lambda () (rfl)))
            (dk-cite! 'sqrt-char e h)
            (hpr-sqrt! q)
            (let ((de (dk-cite! 'ip-metric-space-dist 'v 'x_ y)))
              (dk-have! (list '<= (cadr de) h)
                (lambda ()
                  (subst de)
                  (dk-rewrite-h! (list '<= (list 'SQRT q) (list 'SQRT e)) (list 'SQRT e) h)
                  (ass)))
              (dk-have! (list '< h r) (lambda () (dk-ineq! (list '< 0 r))))
              (dk-have! (list 'IN (cadr de) 'RR) (lambda () (subst de) (ass)))
              (hpr-have-and! (list 'IN y (list 'PTS ms)) (list 'IN h 'RR) (list 'IN r 'RR)
                             (list '<= (cadr de) h) (list '< h r))
              (dk-cite! 'ball-mem-from-le ms 'x_ y h r)
              (dk-cite! 'subset-mem-fwd (list 'BALL ms 'x_ r) u y)
              (witness! y (lambda () (dk-conj-close! dk-ass!)))))))))
  (hpr-iff-bwd! 'closure-membership ms 'aa 'x_)
  (ass))
(qed 'ip-closure-intro)
(topic! 'ip-closure-intro 'analysis)

;;; the closure of a subspace is a subspace
(set! hpr-v 'v)
(define hpr-cl '(CLOSURE (IP-METRIC-SPACE v) kk))
;;; prove (IN z hpr-cl) by ip-closure-intro; APPROX! gets the POS-RR e and must
;;; land (FORSOME hcy_ (AND (IN hcy_ kk) (<= Qd(z, hcy_) e)))
(define (hpr-cl-in! z approx!)
  (hpr-vt! z)
  (dk-have! (list 'FORALL 'hce_ (list 'IMPLIES '(POS-RR hce_)
              (list 'FORSOME 'hcy_ (list 'AND '(IN hcy_ kk) (list '<= (hpr-qd z 'hcy_) 'hce_)))))
    (lambda ()
      (dk-peel!)
      (let ((e (cadr (dk-pick (dk-head? 'POS-RR) "e"))))
        (dk-cite! 'rr-pos-rr-in-rr e)
        (dk-cite! 'rr-lt-of-pos-rr e)
        (approx! e))))
  (dk-cite! 'ip-closure-intro 'v 'kk z)
  (if (equal? (dk-goal) (list 'IN z hpr-cl)) (ass)))
;;; x in the closure, d > 0 (POS-RR in context): a point of kk within d, and its facts
(define (hpr-cl-near! x d)
  (let ((y (dk-skolem! (dk-cite! 'ip-closure-elim 'v 'kk x d))))
    (dk-cite! 'subset-mem-fwd 'kk '(VEC v) y)
    (hpr-q-facts! (hpr-sub x y))
    y))

(sp (make-wff (forall-guarded '(v kk)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk))
   (list 'IS-SUBMODULE 'v hpr-cl))))
(dk-peel!)
(let* ((ms '(IP-METRIC-SPACE v)) (cl hpr-cl))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-cite! 'submodule-subset 'v 'kk)
  (dk-cite! 'cips-scal-carrier 'v)
  (dk-rewrite-h! (dk-cite! 'closure-in-carrier ms 'kk) (list 'PTS ms) '(VEC v))
  (dk-have! (list 'SUBSET 'kk (list 'PTS ms)) (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
  (dk-cite! 'closure-contains ms 'kk)
  (dk-cite! 'submodule-vzero-in 'v 'kk)
  (dk-cite! 'subset-mem-fwd 'kk cl '(VZERO v))
  (let ((vt! (lambda (x) (dk-cite! 'subset-mem-fwd cl '(VEC v) x))))
    (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ cl)
                (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ cl) (list 'IN '((VADD v) x_ y_) cl)))))
      (lambda ()
        (dk-peel!)
        (vt! 'x_) (vt! 'y_)
        (hpr-cl-in! '((VADD v) x_ y_)
          (lambda (e)
            (let ((e4 (list '* 1/4 e)))
              (dk-have! (list 'IN e4 'RR) (lambda () (type-term)))
              (dk-have! (list '< 0 e4) (lambda () (dk-ineq! (list '< 0 e))))
              (dk-cite! 'rr-pos-rr-of-lt e4)
              (let* ((x1 (hpr-cl-near! 'x_ e4))
                     (y1 (hpr-cl-near! 'y_ e4))
                     (a (hpr-sub 'x_ x1)) (b (hpr-sub 'y_ y1))
                     (s (hpr-add x1 y1)))
                (dk-cite! 'submodule-vadd-closed 'v 'kk x1 y1)
                (hpr-q-eq! (hpr-sub '((VADD v) x_ y_) s) (hpr-add a b))
                (dk-cite! 'cips-parallelogram-ip 'v a b)
                (hpr-q-facts! (hpr-add a b)) (hpr-q-facts! (hpr-sub a b))
                (hpr-q-facts! (hpr-sub '((VADD v) x_ y_) s))
                (witness! s
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN) (ass)
                            (dk-ineq! (list '= (hpr-q (hpr-sub '((VADD v) x_ y_) s)) (hpr-q (hpr-add a b)))
                                      (list '= (list '+ (hpr-q (hpr-add a b)) (hpr-q (hpr-sub a b)))
                                            (list '+ (list '* 2 (hpr-q a)) (list '* 2 (hpr-q b))))
                                      (list '<= 0 (hpr-q (hpr-sub a b)))
                                      (list '<= (hpr-q a) e4) (list '<= (hpr-q b) e4)))))))))))))
    (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ cl) (list 'IN '((VNEG v) x_) cl)))
      (lambda ()
        (dk-peel!)
        (vt! 'x_)
        (hpr-cl-in! '((VNEG v) x_)
          (lambda (e)
            (let* ((x1 (hpr-cl-near! 'x_ e))
                   (n1 (list '(VNEG v) x1)))
              (dk-cite! 'submodule-vneg-closed 'v 'kk x1)
              (hpr-q-eq! (hpr-sub '((VNEG v) x_) n1) (hpr-sub 'x_ x1))
              (witness! n1
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN) (ass)
                          (begin (subst (list '= (hpr-q (hpr-sub '((VNEG v) x_) n1)) (hpr-q (hpr-sub 'x_ x1))))
                                 (ass))))))))))))
    (dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ (CARR (SCAL v)))
                (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ cl) (list 'IN '((ACT v) r_ x_) cl)))))
      (lambda ()
        (dk-peel!)
        (dk-rewrite-h! '(IN r_ (CARR (SCAL v))) '(CARR (SCAL v)) 'CC)
        (vt! 'x_)
        (hpr-ct! '(conjugate r_))
        (dk-split! (dk-cite! 'cc-self-conj-nonneg 'r_))
        (let ((m0 (dk-name! '(* r_ (conjugate r_)))))
          (dk-rewrite-h! '(<= 0 (* r_ (conjugate r_))) '(* r_ (conjugate r_)) m0)
          (hpr-cl-in! '((ACT v) r_ x_)
            (lambda (e)
              (let* ((dl (dk-skolem! (dk-cite! 'rr-scale-eps m0 e)))
                     (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq dl (free-vars f))))
                                     "the rr-scale-eps universal"))
                     (x1 (hpr-cl-near! 'x_ dl))
                     (t1 (hpr-qd 'x_ x1))
                     (a1 (list '(ACT v) 'r_ x1))
                     (qq (hpr-qd '((ACT v) r_ x_) a1)))
                (dk-cite! 'submodule-act-closed 'v 'kk 'r_ x1)
                (dk-have! (list '= qq (list '* m0 t1))
                  (lambda () (subst (list '= m0 '(* r_ (conjugate r_))))
                             (hpr-expand!) (hpr-type-ips! (dk-goal)) (crs)))
                (dk-cite! 'cips-ip-self-nonneg 'v (hpr-sub 'x_ x1))
                (let ((sm (dk-apply! small t1)))
                  (dk-rewrite-h! sm (list '* m0 t1) qq)
                  (witness! a1 (lambda () (dk-conj-close! dk-ass!))))))))))
    (mac 'is-submodule)
    (dk-conj-close! dk-ass!)))
(qed 'ip-closure-submodule)
(topic! 'ip-closure-submodule 'algebra)

;;; Cor. 2.21
(set! hpr-v 'v)
(sp (make-wff (forall-guarded '(v kk)
   '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk))
   (list 'IFF (list '= hpr-cl '(VEC v))
              '(FORALL hpz_ (IMPLIES (IN hpz_ (PERP v kk)) (= hpz_ (VZERO v))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(let* ((ms '(IP-METRIC-SPACE v)) (cl hpr-cl))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-cite! 'submodule-subset 'v 'kk)
  (dk-cite! 'perp-subset 'v 'kk)
  (dk-have! (list 'SUBSET 'kk (list 'PTS ms)) (lambda () (subst (list '== (list 'PTS ms) '(VEC v))) (ass)))
  (dk-cite! 'closure-contains ms 'kk)
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    ;; dense ==> K-perp = 0
    (lambda ()
      (dk-peel!)
      (let* ((e (cadr (dk-goal))))
        (dk-cite! 'subset-mem-fwd '(PERP v kk) '(VEC v) e)
        (dk-have! (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ kk) (list '= (hpr-ip 'y_ e) 0)))
          (lambda ()
            (dk-peel!)
            (dk-cite! 'subset-mem-fwd 'kk '(VEC v) 'y_)
            (subst (dk-cite! 'cips-ip-conj-sym 'v e 'y_))
            (subst (dk-cite! 'perp-orth 'v 'kk e 'y_))
            (dk-have! '(IN 0 RR) (lambda () (arith)))
            (subst (dk-cite! 'cc-conjugate-fixes-rr 0))
            (rfl)))
        (dk-have! (list 'IN e cl) (lambda () (subst (list '= cl '(VEC v))) (ass)))
        (dk-cite! 'ip-orth-closure 'v 'kk e e)
        (dk-cite! 'cips-ip-zero-vector 'v e)
        (ass)))
    ;; K-perp = 0 ==> dense: project onto the closure
    (lambda ()
      (let ((zero (dk-pick (dk-head? 'FORALL) "K-perp = 0")))
        (dk-cite! 'closure-is-closed ms 'kk)
        (dk-cite! 'ip-closure-submodule 'v 'kk)
        (dk-cite! 'submodule-subset 'v cl)
        (dk-have! (list 'FORALL 'hcx_ (list 'IFF (list 'IN 'hcx_ cl) '(IN hcx_ (VEC v))))
          (lambda ()
            (dk-peel!)
            (let ((xi (cadr (cadr (dk-goal)))))
              (dk-iff! (lambda (g) (equal? g (list 'IN xi '(VEC v))))
                (lambda () (dk-cite! 'subset-mem-fwd cl '(VEC v) xi) (ass))
                (lambda ()
                  (let* ((p (dk-skolem! (dk-cite! 'hilbert-projection-point 'v cl xi)))
                         (b (hpr-sub xi p)))
                    (dk-cite! 'subset-mem-fwd cl '(VEC v) p)
                    (dk-cite! 'perp-subset 'v cl)
                    (dk-cite! 'subset-mem-fwd (list 'PERP 'v cl) '(VEC v) b)
                    (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ kk) (list '= (hpr-ip b 'prk_) 0)))
                      (lambda ()
                        (dk-peel!)
                        (let ((k (caddr (cadr (dk-goal)))))
                          (dk-cite! 'subset-mem-fwd 'kk cl k)
                          (dk-cite! 'perp-orth 'v cl b k)
                          (ass))))
                    (hpr-iff-bwd! 'perp-membership 'v 'kk b)
                    (let ((bz (dk-apply! zero b)))
                      (dk-have! (list '= (hpr-qd xi p) 0)
                        (lambda () (subst bz) (hpr-expand!) (crs)))
                      (dk-cite! 'cips-eq-of-dist-sq-zero 'v xi p)
                      (subst (list '= xi p))
                      (ass))))))))
        (dk-cite! 'class-extensionality cl '(VEC v))
        (ass)))))
(qed 'hilbert-dense-iff-perp-zero)
(topic! 'hilbert-dense-iff-perp-zero 'analysis)
(alias! 'hilbert-dense-iff-perp-zero "a subspace is dense iff its orthogonal complement is zero")

;;; ====================================================================
(gloss! 'hilbert-projection-exists
  "Projection theorem, existence (Thayer, Prop. 2.19 (i)): in a Hilbert space, for a closed
   subspace K every vector xi is xi1 + xi2 with xi1 in K and xi2 in K-perp.")
(gloss! 'hilbert-decomposition-unique
  "Projection theorem, uniqueness (Thayer, Prop. 2.19 (i)): the decomposition xi = xi1 + xi2
   with xi1 in the subspace K and xi2 in K-perp is unique.")
(gloss! 'hilbert-closest-point
  "In a Hilbert space a closed subspace K contains a point nearest to any given vector.")
(gloss! 'riesz-representation
  "Riesz representation theorem (Thayer, Thm. 2.22): a continuous linear functional f on a
   Hilbert space is x |-> <x, eta> for a vector eta, |f(x)| <= ||x|| ||eta||, and ||eta|| is
   the least such constant, i.e. ||f|| = ||eta||.")
(gloss! 'hilbert-dense-iff-perp-zero
  "Thayer, Cor. 2.21: a subspace of a Hilbert space is dense iff its orthogonal complement is {0}.")
(gloss! 'cips-parallelogram
  "The parallelogram law ||x+y||^2 + ||x-y||^2 = 2||x||^2 + 2||y||^2 (Thayer, (1.1)).")
