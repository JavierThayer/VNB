;;; ====================================================================
;;; (2) ORTHOGONALITY PASSES TO THE CLOSURE -- the one limit argument
;;; ====================================================================
;;; If <y, w> = 0 for every y in aa, then <x, w> = 0 for every x in the closure of
;;; aa.  With c = <x, w>: for every r > 0 some y in aa has d(x, y) <= r, and
;;; <x - y, w> = c, so Schwarz gives c conj(c) <= <x-y, x-y> <w, w> <= r^2 <w, w>.
;;; rr-scale-eps picks r^2 = dd with <w,w> dd <= c conj(c) / 2, whence
;;; c conj(c) <= 0.  No division, no limit: one ball.  This is the lemma behind
;;; "PERP is closed", Cor. 2.21 and the closedness half of Riesz.

(set! hpr-v 'v)

;;; the case 0 < c conj(c), closed by refuting it: proves (<= mm 0)
(define hpr-oc-near #f)                 ; the closure universal, as it landed
(define hpr-oc-mm #f)                   ; c conj(c) itself; `mm' below is its NAME
(define (hpr-oc-pos-case! ms hyp c mm aw)
  (let* ((eps (list '* 1/2 mm)))
    (dk-have! (list 'IN eps 'RR) (lambda () (type-term)))
    (dk-have! (list '< 0 eps) (lambda () (dk-ineq! (list '< 0 mm))))
    (dk-cite! 'rr-pos-rr-of-lt eps)
    (let* ((ex (dk-cite! 'rr-scale-eps aw eps))
           (dd (dk-skolem! ex))
           (small (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq dd (free-vars f))))
                           "the rr-scale-eps universal"))
           (r (list 'SQRT dd)))
      (dk-cite! 'rr-pos-rr-in-rr dd)
      (dk-cite! 'rr-lt-of-pos-rr dd)
      (dk-have! (list '<= 0 dd) (lambda () (dk-ineq! (list '< 0 dd))))
      (hpr-sqrt! dd)
      (dk-have! (list 'NOT (list '= 0 r))
        (lambda ()
          (di)
          (let ((h (dk-rewrite-h! (list '= (list '* r r) dd) r 0)))
            (dk-absurd! h (list '< 0 dd)))))
      (hpr-have-and! (list 'IN r 'RR) (list '<= 0 r) (list 'NOT (list '= 0 r)))
      (let ((ball (list 'BALL ms 'x_ r)))
        (dk-cite! 'ball-is-open ms 'x_ r)
        (dk-cite! 'ball-center-in ms 'x_ r)
        (hpr-have-and! (list 'IS-OPEN ms ball) (list 'IN 'x_ ball))
        (let* ((near hpr-oc-near)
               (ex2 (dk-apply! near ball))
               (y (dk-skolem! ex2)))
          (hpr-iff-fwd! 'ball-membership ms 'x_ r y)
          (dk-rewrite-h! (list 'IN y (list 'PTS ms)) (list 'PTS ms) '(VEC v))
          (hpr-oc-estimate! ms hyp c mm aw eps dd small r y))))))

(define (hpr-oc-estimate! ms hyp c mm aw eps dd small r y)
  (let* ((xy (hpr-sub 'x_ y))
         (q (hpr-q xy))
         (s (list 'SQRT q))
         (de (dk-cite! 'ip-metric-space-dist 'v 'x_ y)))
    (hpr-q-facts! xy)
    (hpr-sqrt! q)
    (dk-rewrite-h! (list '<= (cadr de) r) (cadr de) s)
    (dk-cite! 'rr-mul-le-right s r s)
    (dk-cite! 'rr-mul-le-right s r r)
    (dk-have! (list '= (list '* r s) (list '* s r)) (lambda () (crs)))
    (dk-have! (list '<= q dd)
      (lambda ()
        (dk-le-chain! q (list '* s s) (list '* r s) (list '* s r) (list '* r r) dd)))
    (let ((yw (dk-apply! hyp y))
          (p (hpr-ip xy 'w_)))
      (dk-have! (list '= p c)
        (lambda ()
          (hpr-expand!)
          (subst yw)
          (hpr-type-ips! (dk-goal))
          (crs)))
      (let* ((sch (dk-cite! 'cips-schwarz 'v xy 'w_))
             (sch2 (dk-rewrite-h! sch p c)))
        (dk-cite! 'rr-mul-le-right q dd aw)
        (dk-have! (list '<= dd dd) (lambda () (dk-ineq!)))
        (let* ((sm (dk-apply! small dd))
               (qa (list '* q aw)) (da (list '* dd aw)) (ad (list '* aw dd))
               (h1 (dk-rewrite-h! sch2 hpr-oc-mm mm))
               (h2 (list '<= qa da)))
          (dk-have! (list '= da ad) (lambda () (crs)))
          ;; ineq drops a product of two atoms here: NAME the three products
          (for-each (lambda (t) (dk-have! (list 'IN t 'RR) (lambda () (type-term))))
                    (list qa da ad))
          (let* ((nqa (dk-name! qa)) (nda (dk-name! da)) (nad (dk-name! ad)))
            (dk-ineq! (dk-rewrite-h! h1 qa nqa)
                      (dk-rewrite-h! (dk-rewrite-h! h2 qa nqa) da nda)
                      (dk-rewrite-h! (dk-rewrite-h! (list '= da ad) da nda) ad nad)
                      (dk-rewrite-h! sm ad nad)
                      (list '< 0 mm))))))))

(sp (make-wff (forall-guarded '(v aa w_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN w_ (VEC v))
     (IN x_ (CLOSURE (IP-METRIC-SPACE v) aa))
     (FORALL y_ (IMPLIES (IN y_ aa) (= ((IP v) y_ w_) 0))))
   '(= ((IP v) x_ w_) 0))))
(dk-peel!)
(let* ((ms '(IP-METRIC-SPACE v))
       (hyp (dk-pick (dk-head? 'FORALL) "the orthogonality hypothesis"))
       (c (hpr-ip 'x_ 'w_))
       (mm (list '* c (list 'conjugate c)))
       (aw (hpr-q 'w_)))
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (set! hpr-oc-near (caddr (hpr-iff-fwd! 'closure-membership ms 'aa 'x_)))
  (dk-cite! 'ip-metric-space-pts 'v)
  (dk-rewrite-h! (list 'IN 'x_ (list 'PTS ms)) (list 'PTS ms) '(VEC v))
  (hpr-ct! c)
  (dk-split! (dk-cite! 'cc-self-conj-nonneg c))
  (set! hpr-oc-mm mm)
  (set! mm (dk-name! mm))                ; ineq cannot read c conj(c): name it
  (dk-rewrite-h! (list '<= 0 hpr-oc-mm) hpr-oc-mm mm)
  (hpr-q-facts! 'w_)
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! (list '<= mm 0)
    (lambda ()
      (let ((orf (dk-cite! 'rr-le-cases 0 mm)))
        (use-cases (list (cadr orf) (caddr orf))
          (lambda () (hpr-oc-pos-case! ms hyp c mm aw))
          (lambda () (dk-ineq! (list '= 0 mm)))))))
  (dk-have! (list '= mm 0) (lambda () (dk-ineq! (list '<= mm 0) (list '<= 0 mm))))
  (dk-have! (list '= hpr-oc-mm 0) (lambda () (subst (list '= hpr-oc-mm mm)) (ass)))
  (dk-cite! 'cc-zero-of-self-conj-zero c)
  (ass))
(qed 'ip-orth-closure)
(topic! 'ip-orth-closure 'analysis)

