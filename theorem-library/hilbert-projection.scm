     (FORALL x_ (IMPLIES (IN x_ (VEC v))
     (FORALL y_ (IMPLIES (IN y_ (VEC v))
       (= (+ ((IP v) ((VADD v) x_ y_) ((VADD v) x_ y_))
             ((IP v) ((VADD v) x_ ((VNEG v) y_)) ((VADD v) x_ ((VNEG v) y_))))
          (+ (* 2 ((IP v) x_ x_)) (* 2 ((IP v) y_ y_))))))))))))
