           (+ (+ ((IP v) x_ y_) ((IP v) x_ ((VNEG v) y_))) (- ((IP v) x_ y_))))
       (lambda () (crs)))
(subst '(= ((IP v) x_ ((VNEG v) y_))
           (+ (+ ((IP v) x_ y_) ((IP v) x_ ((VNEG v) y_))) (- ((IP v) x_ y_)))))
(subst '(= (+ ((IP v) x_ y_) ((IP v) x_ ((VNEG v) y_))) 0))
(crs)
(qed 'cips-ip-neg-right)
(topic! 'cips-ip-neg-right 'algebra)

