;;; cc-top-continuity.scm -- COMPLEX-VALUED CONTINUOUS MAPS ON A TOPOLOGICAL SPACE.
;;; For a topological space s, a map into the complex plane METRIC-TOP(CC-MS) is continuous iff it is
;;; continuous at every point in the eps-neighbourhood sense (cc-hom-local, cc-hom-of-local); constants,
;;; sums and products of continuous maps are continuous (cc-hom-const, cc-hom-add, cc-hom-mul, with the
;;; product estimate cc-magnitude-prod-bound); the set where two continuous maps agree is closed
;;; (cc-hom-equalizer-closed); and a point where they differ has an open neighbourhood missing every point
;;; of a set on which they agree (cc-hom-separate).
;;; Agent BA-1F, wave 2026-11-09.  Destination: theorem-library/cc-top-continuity.scm.  Library: analysis.
;;; All proofs modulo 0.  Helper prefix: ctc-.
;;; LOAD WINDOW: after theorem-library/cc-product.scm (BA-1D: cc-metric-top-pts) and the top-space files
;;; (top-open-of-local, is-hom-top-space-def, metric-top-opens-iff, ball-is-open, ball-mem-from-le,
;;; metric-self-zero, cc-ms-dist, cc-magnitude-triangle, cc-magnitude-mul).

(define (ctc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cc-top-continuity: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display "      asm: ") (display (expression->string h)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cc-top-continuity: unfinished" name))))

(define (ctc-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (ctc-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))
(define (ctc-mac-fix! n)
  (let loop ((k 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (mac n)))
      (if (and (< k 6) (not (equal? g (dk-goal)))) (loop (+ k 1))))))
(define (ctc-var landed cls)          ; the v of the first landed (IN v CLS)
  (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if h (cadr h) (error "ctc-var: no landed typing in" cls))))

(define ctc-MT '(METRIC-TOP CC-MS))
(define (ctc-hom f) (list 'IS-HOM-TOP-SPACE 's ctc-MT f))
(define (ctc-local f)
  (list 'FORALL 'cp_ (list 'IMPLIES '(IN cp_ (PTS s)) (list 'FORALL 'ce_ (list 'IMPLIES '(IN ce_ RR) (list 'IMPLIES '(< 0 ce_)
    (list 'FORSOME 'ctw_ (list 'AND '(IN ctw_ (OPENS s)) (list 'AND '(IN cp_ ctw_)
      (list 'FORALL 'ctq_ (list 'IMPLIES '(IN ctq_ ctw_)
        (list 'AND '(IN ctq_ (PTS s)) (list '< (list 'magnitude (list '- (list f 'cp_) (list f 'ctq_))) 'ce_)))))))))))))

(define (ctc-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE ctc-MT)))
      (begin (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS)
             (dk-cite! 'cc-metric-top-pts) (dk-cite! 'cc-ms@pts))))
(define (ctc-top! s)                  ; IS-TOP-SPACE s in context: (IN (PTS s) SET), PTS s open
  (if (not (dk-asm? (list 'IN (list 'PTS s) 'SET)))
      (begin
        (dk-project! (list 'IN (list 'PTS s) (list 'OPENS s)) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-cite! 'membership-implies-sethood (list 'PTS s) (list 'OPENS s)))))
;;; (IS-HOM s MT f) in context: land IS-TOP-SPACE s and (IN f (FUN (PTS s) CC))
(define (ctc-pre! f)
  (ctc-mt!)
  (let ((hom (ctc-hom f)) (ft (list 'IN f (list 'FUN '(PTS s) 'CC))))
    (if (not (dk-asm? '(IS-TOP-SPACE s))) (dk-project! '(IS-TOP-SPACE s) 'is-hom-top-space-def hom))
    (if (not (dk-asm? ft))
        (let ((f0 (dk-project! (list 'IN f (list 'FUN '(PTS s) (list 'PTS ctc-MT))) 'is-hom-top-space-def hom)))
          (dk-rewrite-h! f0 (list 'PTS ctc-MT) 'CC)))
    (ctc-top! 's)
    ft))
(define (ctc-app! f p)                ; (IN f (FUN (PTS s) CC)), (IN p (PTS s)): land (IN (f p) CC)
  (let ((g (list 'IN (list f p) 'CC)))
    (if (not (dk-asm? g)) (dk-cite! 'fun-apply-type-c f '(PTS s) 'CC p))
    g))
(define (ctc-inter-open! u v)
  (let ((il (dk-project! '(FORALL u (IMPLIES (IN u (OPENS s)) (FORALL v (IMPLIES (IN v (OPENS s)) (IN (INTERSECTION u v) (OPENS s))))))
                         'is-top-space '(IS-TOP-SPACE s))))
    (dk-apply! il u v)))
(define (ctc-inter-in! h u v)
  (let ((im (dk-cite! 'intersection-membership u v h)) (c (list 'AND (list 'IN h u) (list 'IN h v))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    (dk-have! (cadr im) (lambda () (if (dk-only! im c) (prop))))))
(define (ctc-inter-out! h u v)
  (let ((im (dk-cite! 'intersection-membership u v h)))
    (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN h (list 'INTERSECTION u v))) (prop))))
    (dk-split! (caddr im))))
;;; f continuous, p in PTS s, e > 0 typed: the neighbourhood of cc-hom-local; returns (w . the q-universal)
(define (ctc-nbhd! f p e)
  (let* ((ex (dk-cite! 'cc-hom-local 's f p e))
         (w (dk-skolem! ex #t)))
    (dk-split-all!)
    (cons w (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w))) "the nbhd universal"))))
;;; the q-universal of a nbhd, at q in w: lands (IN q (PTS s)) and the estimate
(define (ctc-at! hq q) (dk-split-all! (list (dk-apply! hq q))))

;;; (IN (- a b) CC) and (IN (magnitude (- a b)) RR) for a, b in CC
(define (ctc-diff! a b)
  (let ((d (list '- a b)))
    (if (not (dk-asm? (list 'IN d 'CC))) (ctc-cite2! 'cc-sub-in-cc a b))
    (dk-cite! 'cc-magnitude-closed d)
    (list 'magnitude d)))
;;; ---- (1) a continuous map is continuous at each point ---------------------------------------------
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'IMPLIES (ctc-hom 'fa) (ctc-local 'fa))))))
(let* ((l (dk-peel!)) (p (ctc-var l '(PTS s))) (e (ctc-var l 'RR)))
  (ctc-pre! 'fa)
  (let* ((hom (ctc-hom 'fa))
         (pre (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS ctc-MT))
                                                  (list 'IN (list 'PREIMAGE 's 'fa 'u) '(OPENS s))))
                           'is-hom-top-space-def hom))
         (fp (list 'fa p)) (bl (list 'BALL 'CC-MS fp e)) (w (list 'PREIMAGE 's 'fa bl))
         (d0 (list '(DIST CC-MS) fp fp)))
    (ctc-app! 'fa p)
    (dk-have! (list 'IN fp '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-ass!)))
    (dk-pos-parts! e)
    (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) fp e)
    (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'CC-MS) bl)))
      (dk-have! (list 'IN bl (list 'OPENS ctc-MT)) (lambda () (if (dk-only! oi (list 'IS-OPEN 'CC-MS bl)) (prop)))))
    (dk-apply! pre bl)
    (dk-apply! (dk-cite! 'metric-self-zero 'CC-MS) fp)
    (dk-real! 0)
    (dk-have! (list '<= d0 0) (lambda () (subst (list '= d0 0)) (dk-ineq!)))
    (ctc-cite2! 'ball-mem-from-le 'CC-MS fp fp 0 e)
    (let ((pm (dk-cite! 'preimage-membership 's 'fa bl p)))
      (dk-have! (list 'IN p w) (lambda () (if (dk-only! pm (list 'IN p '(PTS s)) (list 'IN fp bl)) (prop)))))
    (ew w)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-ass!) #t)
          (#t
           (let* ((q (ctc-var (dk-peel!) w)) (fq (list 'fa q))
                  (pmq (dk-cite! 'preimage-membership 's 'fa bl q)))
             (dk-have! (caddr pmq) (lambda () (if (dk-only! pmq (list 'IN q w)) (prop))))
             (dk-split! (caddr pmq))
             (let ((bm (dk-cite! 'ball-membership 'CC-MS fp e fq)))
               (dk-have! (caddr bm) (lambda () (if (dk-only! bm (list 'IN fq bl)) (prop))))
               (dk-split-all! (list (caddr bm))))
             (ctc-app! 'fa q)
             (dk-cite! 'cc-ms-dist fp fq)
             (ctc-diff! fp fq)
             (let ((mg (list 'magnitude (list '- fp fq))) (ds (list '(DIST CC-MS) fp fq)))
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-ass!) #t)
                         (#t (mac '<)
                             (dk-conj-close! (lambda () (subst (list '= mg ds)) (dk-ass!)))))))))))))))
(ctc-qed! 'cc-hom-local)

;;; ---- (2) continuity at each point gives continuity ------------------------------------------------
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IN fa (FUN (PTS s) CC))
  (list 'IMPLIES (ctc-local 'fa) (ctc-hom 'fa))))))))
(dk-peel!)
(ctc-mt!)
(ctc-top! 's)
(let ((loc (dk-ctx-form (ctc-local 'fa))))
  (mac 'is-hom-top-space-def)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IN)
         (subst (list '== (list 'PTS ctc-MT) 'CC)) (dk-ass!))
        (#t
         (let* ((u (ctc-var (dk-peel!) (list 'OPENS ctc-MT))) (pre (list 'PREIMAGE 's 'fa u)))
           (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'CC-MS) u)))
             (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (if (dk-only! oi (list 'IN u (list 'OPENS ctc-MT))) (prop)))))
           (let* ((ball-cl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u)
                                          (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL CC-MS y r) u)))))
                                        'IS-OPEN (list 'IS-OPEN 'CC-MS u)))
                  (ch (dk-cite! 'top-open-of-local 's pre))
                  (ch2 (detach-with! ch
                         (lambda ()
                           (mac 'subset-def)
                           (let* ((z (ctc-var (dk-peel!) pre)) (pm (dk-cite! 'preimage-membership 's 'fa u z)))
                             (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN z pre)) (prop))))
                             (dk-split! (caddr pm))
                             (dk-ass!)))))
                  (ch3 (detach-with! ch2
                         (lambda ()
                           (let* ((a0 (ctc-var (dk-peel!) pre)) (pm (dk-cite! 'preimage-membership 's 'fa u a0))
                                  (fa0 (list 'fa a0)))
                             (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN a0 pre)) (prop))))
                             (dk-split! (caddr pm))
                             (ctc-app! 'fa a0)
                             (let* ((r (dk-skolem! (dk-apply! ball-cl fa0) #t)) (bl (list 'BALL 'CC-MS fa0 r)))
                               (dk-split-all!)
                               (dk-cite! 'rr-pos-rr-in-rr r)
                               (dk-cite! 'rr-lt-of-pos-rr r)
                               (let* ((w (dk-skolem! (dk-apply! loc a0 r) #t))
                                      (hq (begin (dk-split-all!)
                                                 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w))) "the nbhd universal"))))
                                 (ew w)
                                 (dk-conj-close!
                                   (lambda ()
                                     (cond
                                       ((dk-ass!) #t)
                                       (#t
                                        (mac 'subset-def)
                                        (let* ((q (ctc-var (dk-peel!) w)) (fq (list 'fa q))
                                               (mg (list 'magnitude (list '- fa0 fq))) (ds (list '(DIST CC-MS) fa0 fq)))
                                          (ctc-at! hq q)
                                          (ctc-app! 'fa q)
                                          (dk-have! (list 'IN fq '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-ass!)))
                                          (dk-have! (list 'IN fa0 '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-ass!)))
                                          (dk-cite! 'cc-ms-dist fa0 fq)
                                          (dk-cite! 'cc-magnitude-closed (list '- fa0 fq))
                                          (dk-have! (list 'IN (list '- fa0 fq) 'CC) (lambda () (ctc-cite2! 'cc-sub-in-cc fa0 fq) (dk-ass!)))
                                          (dk-cite! 'cc-magnitude-closed (list '- fa0 fq))
                                          (dk-have! (list '<= ds mg) (lambda () (subst (list '= ds mg)) (dk-ineq! (list 'IN mg 'RR))))
                                          (ctc-cite2! 'ball-mem-from-le 'CC-MS fa0 fq mg r)
                                          (dk-cite! 'subset-mem-fwd bl u fq)
                                          (let ((pmq (dk-cite! 'preimage-membership 's 'fa u q)))
                                            (if (dk-only! pmq (list 'IN q '(PTS s)) (list 'IN fq u)) (prop)))))))))))))))
             (dk-ass!))))))))
(ctc-qed! 'cc-hom-of-local)

;;; v in PTS s typed: (= (h v) BODY[v]) for a lambda h over (PTS s)
(define (ctc-beta! h v val)
  (let ((e (list '= (list h v) val)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))

;;; ---- (3) a constant map is continuous ------------------------------------------------------------
(define ctc-cst '(VNB-LAMBDA ctv_ (PTS s) cc_))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'cc_ (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IN cc_ CC)
  (ctc-hom ctc-cst)))))))
(dk-peel!)
(ctc-mt!)
(ctc-top! 's)
(dk-have! (list 'IN ctc-cst '(FUN (PTS s) CC))
  (lambda () (dk-lam-type! (lambda () (dk-di-var!) (dk-ass!)) (lambda () (dk-ass!)))))
(dk-have! (ctc-local ctc-cst)
  (lambda ()
    (let* ((l (dk-peel!)) (p (ctc-var l '(PTS s))) (e (ctc-var l 'RR)))
      (ctc-beta! ctc-cst p 'cc_)
      (ew '(PTS s))
      (dk-conj-close!
        (lambda ()
          (cond
            ((dk-ass!) #t)
            (#t
             (let ((q (ctc-var (dk-peel!) '(PTS s))))
               (ctc-beta! ctc-cst q 'cc_)
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-ass!) #t)
                         (#t (subst (list '= (list ctc-cst p) 'cc_)) (subst (list '= (list ctc-cst q) 'cc_))
                             (dk-have! '(= (- cc_ cc_) 0) (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                             (subst '(= (- cc_ cc_) 0))
                             (dk-cite! 'cc-magnitude-zero)
                             (subst '(= (magnitude 0) 0))
                             (dk-ass!)))))))))))))
(dk-cite! 'cc-hom-of-local 's ctc-cst)
(dk-ass!)
(ctc-qed! 'cc-hom-const)

;;; ---- (4) the sum of two continuous maps is continuous ----------------------------------------------
(define (ctc-sum f g) (list 'VNB-LAMBDA 'ctv_ '(PTS s) (list '+ (list f 'ctv_) (list g 'ctv_))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'FORALL 'fb (list 'IMPLIES (ctc-hom 'fa) (list 'IMPLIES (ctc-hom 'fb)
  (ctc-hom (ctc-sum 'fa 'fb)))))))))
(dk-peel!)
(ctc-pre! 'fa) (ctc-pre! 'fb)
(let ((hm (ctc-sum 'fa 'fb)))
  (dk-have! (list 'IN hm '(FUN (PTS s) CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (ctc-app! 'fa v) (ctc-app! 'fb v)
                                             (ctc-cite2! 'cc-add-closed (list 'fa v) (list 'fb v)) (dk-ass!)))
                             (lambda () (dk-ass!)))))
  (dk-have! (ctc-local hm)
    (lambda ()
      (let* ((l (dk-peel!)) (p (ctc-var l '(PTS s))) (e (ctc-var l 'RR)) (e2 (list '* 1/2 e)))
        (dk-real! e2)
        (ctc-lin! (list '< 0 e2) (list '< 0 e))
        (let* ((n1 (ctc-nbhd! 'fa p e2)) (n2 (ctc-nbhd! 'fb p e2)) (w1 (car n1)) (w2 (car n2))
               (w (list 'INTERSECTION w1 w2)) (a (list 'fa p)) (b (list 'fb p)))
          (ctc-inter-open! w1 w2)
          (ctc-inter-in! p w1 w2)
          (ctc-app! 'fa p) (ctc-app! 'fb p)
          (ctc-beta! hm p (list '+ a b))
          (ew w)
          (dk-conj-close!
            (lambda ()
              (cond
                ((dk-ass!) #t)
                (#t
                 (let* ((q (ctc-var (dk-peel!) w)) (c (list 'fa q)) (d (list 'fb q)))
                   (ctc-inter-out! q w1 w2)
                   (ctc-at! (cdr n1) q) (ctc-at! (cdr n2) q)
                   (ctc-app! 'fa q) (ctc-app! 'fb q)
                   (ctc-beta! hm q (list '+ c d))
                   (dk-conj-close!
                     (lambda ()
                       (cond
                         ((dk-ass!) #t)
                         (#t
                          (let* ((dd (list '- (list '+ a b) (list '+ c d))) (s1 (list '- a c)) (s2 (list '- b d))
                                 (m1 (ctc-diff! a c)) (m2 (ctc-diff! b d)))
                            (subst (list '= (list hm p) (list '+ a b)))
                            (subst (list '= (list hm q) (list '+ c d)))
                            (dk-have! (list '= dd (list '+ s1 s2)) (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                            (subst (list '= dd (list '+ s1 s2)))
                            (ctc-cite2! 'cc-magnitude-triangle s1 s2)
                            (ctc-cite2! 'cc-add-closed s1 s2)
                            (dk-cite! 'cc-magnitude-closed (list '+ s1 s2))
                            (dk-ineq! (list '<= (list 'magnitude (list '+ s1 s2)) (list '+ m1 m2))
                                      (list '< m1 e2) (list '< m2 e2)
                                      (list 'IN m1 'RR) (list 'IN m2 'RR) (list 'IN (list 'magnitude (list '+ s1 s2)) 'RR)
                                      (list 'IN e 'RR))))))))))))))))
  (dk-cite! 'cc-hom-of-local 's hm)
  (dk-ass!))
(ctc-qed! 'cc-hom-add)

;;; ---- (5) the set where two continuous maps agree is closed --------------------------------------------
(define (ctc-eq-set f g) (list 'SEP 'ctp_ '(PTS s) (list '= (list f 'ctp_) (list g 'ctp_))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'FORALL 'fb (list 'IMPLIES (ctc-hom 'fa) (list 'IMPLIES (ctc-hom 'fb)
  (list 'IS-TOP-CLOSED 's (ctc-eq-set 'fa 'fb)))))))))
(dk-peel!)
(ctc-pre! 'fa) (ctc-pre! 'fb)
(let* ((es (ctc-eq-set 'fa 'fb)) (co (list 'COMPLEMENT-IN '(PTS s) es)))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (mac 'subset-def)
         (let ((z (ctc-var (dk-peel!) es)))
           (sep-me (list 'IN z es))
           (dk-ass!)))
        (#t
         (let* ((ch (dk-cite! 'top-open-of-local 's co))
                (ch2 (detach-with! ch
                       (lambda ()
                         (mac 'subset-def)
                         (let* ((z (ctc-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership '(PTS s) es z)))
                           (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN z co)) (prop))))
                           (dk-split! (caddr cm))
                           (dk-ass!)))))
                (ch3 (detach-with! ch2
                       (lambda ()
                         (let* ((p (ctc-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership '(PTS s) es p))
                                (a (list 'fa p)) (b (list 'fb p)))
                           (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN p co)) (prop))))
                           (dk-split! (caddr cm))
                           (ctc-app! 'fa p) (ctc-app! 'fb p)
                           (dk-have! (list 'NOT (list '= a b))
                             (lambda () (di)
                               (dk-have! (list 'IN p es) (lambda () (in-sep! (lambda () (dk-ass!)))))
                               (ai (list 'NOT (list 'IN p es)))))
                           (let* ((md (ctc-diff! a b)) (e (list '* 1/2 md)))
                             (dk-cite! 'cc-magnitude-nonneg (list '- a b))
                             (dk-have! (list 'NOT (list '= md 0))
                               (lambda ()
                                 (di)
                                 (let ((zi (dk-cite! 'cc-magnitude-zero-iff (list '- a b))))
                                   (dk-have! (list '= (list '- a b) 0) (lambda () (if (dk-only! zi (list '= md 0)) (prop))))
                                   (dk-have! (list '= a b)
                                     (lambda ()
                                       (dk-have! (list '= a (list '+ (list '- a b) b)) (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                                       (subst (list '= a (list '+ (list '- a b) b)))
                                       (subst (list '= (list '- a b) 0))
                                       (dk-have! (list '= (list '+ 0 b) b) (lambda () (crs)))
                                       (dk-ass!)))
                                   (ai (list 'NOT (list '= a b))))))
                             (dk-have! (list '< 0 md)
                               (lambda ()
                                 (mac '<)
                                 (dk-conj-close!
                                   (lambda ()
                                     (cond ((dk-ass!) #t)
                                           (#t (di)
                                               (dk-have! (list '= md 0) (lambda () (subst (list '= md 0)) (rfl)))
                                               (ai (list 'NOT (list '= md 0)))))))))
                             (dk-real! e)
                             (ctc-lin! (list '< 0 e) (list '< 0 md))
                             (let* ((n1 (ctc-nbhd! 'fa p e)) (n2 (ctc-nbhd! 'fb p e)) (w1 (car n1)) (w2 (car n2))
                                    (w (list 'INTERSECTION w1 w2)))
                               (ctc-inter-open! w1 w2)
                               (ctc-inter-in! p w1 w2)
                               (ew w)
                               (dk-conj-close!
                                 (lambda ()
                                   (cond
                                     ((dk-ass!) #t)
                                     (#t
                                      (mac 'subset-def)
                                      (let* ((q (ctc-var (dk-peel!) w)) (c (list 'fa q)) (d (list 'fb q)))
                                        (ctc-inter-out! q w1 w2)
                                        (ctc-at! (cdr n1) q) (ctc-at! (cdr n2) q)
                                        (ctc-app! 'fa q) (ctc-app! 'fb q)
                                        (dk-have! (list 'NOT (list 'IN q es))
                                          (lambda ()
                                            (di)
                                            (sep-me (list 'IN q es))
                                            ;; c = d: |a - b| <= |a - c| + |c - b| = |a - c| + |b - d| < 2e = |a - b|
                                            (let* ((s1 (list '- a c)) (s2 (list '- d b)) (m1 (ctc-diff! a c)) (m3 (ctc-diff! b d))
                                                   (m2 (ctc-diff! d b)))
                                              (dk-have! (list '= (list '- a b) (list '+ s1 s2))
                                                (lambda () (subst (list '= c d)) (ctc-mac-fix! 'binary-minus-def) (crs)))
                                              (ctc-cite2! 'cc-magnitude-triangle s1 s2)
                                              (dk-have! (list '= m2 m3)
                                                (lambda ()
                                                  (dk-have! (list '= s2 (list '- (list '- b d)))
                                                    (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                                                  (subst (list '= s2 (list '- (list '- b d))))
                                                  (dk-cite! 'cc-magnitude-neg (list '- b d))
                                                  (dk-ass!)))
                                              (let ((h (dk-rewrite-h! (list '<= (list 'magnitude (list '+ s1 s2)) (list '+ m1 m2))
                                                                       (list '+ s1 s2) (list '- a b))))
                                                (dk-absurd! h (list '< m1 e) (list '< m3 e) (list '= m2 m3)
                                                            (list 'IN m1 'RR) (list 'IN m2 'RR) (list 'IN m3 'RR) (list 'IN md 'RR))))))
                                        (let ((cmq (dk-cite! 'complement-in-membership '(PTS s) es q)))
                                          (if (dk-only! cmq (list 'IN q '(PTS s)) (list 'NOT (list 'IN q es))) (prop)))))))))))))))
           (dk-ass!)))))))
(ctc-qed! 'cc-hom-equalizer-closed)

;;; ---- (6) the product estimate in CC, by citation (the twin of nf-norm-prod-bound) ----------------------
(define (ctc-mg x) (list 'magnitude x))
(sp (make-wff (forall-guarded '(cbu_ cbv_ cbp_ cbq_) '((IN cbu_ CC) (IN cbv_ CC) (IN cbp_ CC) (IN cbq_ CC))
  (forall-guarded '(cbm_ cbk_ cbt_ cbe_) '((IN cbm_ RR) (IN cbk_ RR) (IN cbt_ RR) (IN cbe_ RR))
    '(IMPLIES (<= (magnitude cbu_) cbm_) (IMPLIES (<= (magnitude cbq_) cbk_)
      (IMPLIES (<= (magnitude (- cbu_ cbp_)) cbt_) (IMPLIES (<= (magnitude (- cbv_ cbq_)) cbt_)
        (IMPLIES (<= (* (+ cbm_ cbk_) cbt_) cbe_)
          (<= (magnitude (- (* cbu_ cbv_) (* cbp_ cbq_))) cbe_))))))))))
(dk-peel!)
(let* ((u 'cbu_) (v 'cbv_) (p 'cbp_) (q 'cbq_) (m 'cbm_) (k 'cbk_) (t 'cbt_) (e3 'cbe_)
       (dup (list '- u p)) (dvq (list '- v q))
       (a1 (list '* u dvq)) (a2 (list '* q dup))
       (n1 (list '* (ctc-mg u) (ctc-mg dvq))) (n2 (list '* (ctc-mg q) (ctc-mg dup)))
       (uv (list '* u v)) (pq (list '* p q))
       (lhs (list '- uv pq)) (lhsn (ctc-mg lhs))
       (bnd1 (list '+ n1 n2))
       (bnd2 (list '+ (list '* m t) (list '* k t)))
       (bnd3 (list '* (list '+ m k) t)))
  (ctc-diff! u p) (ctc-diff! v q)
  (ctc-cite2! 'cc-mul-closed u dvq) (ctc-cite2! 'cc-mul-closed q dup)
  (ctc-cite2! 'cc-mul-closed u v) (ctc-cite2! 'cc-mul-closed p q)
  (ctc-diff! uv pq)
  (for-each (lambda (z) (dk-cite! 'cc-magnitude-closed z) (dk-cite! 'cc-magnitude-nonneg z)) (list u q dup dvq))
  (dk-cite! 'cc-magnitude-closed a1) (dk-cite! 'cc-magnitude-closed a2)
  (dk-have! (list '= lhs (list '+ a1 a2)) (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
  (ctc-cite2! 'cc-add-closed a1 a2)
  (ctc-cite2! 'cc-magnitude-triangle a1 a2)
  (ctc-cite2! 'cc-magnitude-mul u dvq)
  (ctc-cite2! 'cc-magnitude-mul q dup)
  (dk-have! (list '<= lhsn bnd1)
    (lambda ()
      (subst (list '= lhs (list '+ a1 a2)))
      (subst (list '= n1 (ctc-mg a1)))
      (subst (list '= n2 (ctc-mg a2)))
      (dk-ass!)))
  (ctc-cite2! 'rr-prod-le-prod (ctc-mg u) m (ctc-mg dvq) t)
  (ctc-cite2! 'rr-prod-le-prod (ctc-mg q) k (ctc-mg dup) t)
  (dk-le-add! n1 (list '* m t) n2 (list '* k t))
  (dk-have! (list '= bnd2 bnd3) (lambda () (crs)))
  (dk-le-chain! lhsn bnd1 bnd2 bnd3 e3))
(ctc-qed! 'cc-magnitude-prod-bound)

;;; ---- (7) the product of two continuous maps is continuous -------------------------------------------
(define (ctc-prod f g) (list 'VNB-LAMBDA 'ctv_ '(PTS s) (list '* (list f 'ctv_) (list g 'ctv_))))
(define (ctc-lt-le! a b)               ; (< a b) in context, both typed: land (<= a b)
  (let ((g (list '<= a b)))
    (if (not (dk-asm? g)) (ctc-lin! g (list '< a b) (list 'IN a 'RR) (list 'IN b 'RR)))
    g))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'FORALL 'fb (list 'IMPLIES (ctc-hom 'fa) (list 'IMPLIES (ctc-hom 'fb)
  (ctc-hom (ctc-prod 'fa 'fb)))))))))
(dk-peel!)
(ctc-pre! 'fa) (ctc-pre! 'fb)
(let ((hm (ctc-prod 'fa 'fb)))
  (dk-have! (list 'IN hm '(FUN (PTS s) CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (ctc-app! 'fa v) (ctc-app! 'fb v)
                                             (ctc-cite2! 'cc-mul-closed (list 'fa v) (list 'fb v)) (dk-ass!)))
                             (lambda () (dk-ass!)))))
  (dk-have! (ctc-local hm)
    (lambda ()
      (let* ((l (dk-peel!)) (p (ctc-var l '(PTS s))) (e (ctc-var l 'RR)) (e2 (list '* 1/2 e))
             (a (list 'fa p)) (b (list 'fb p))
             (mm (ctc-mg a)) (kk (list '+ (ctc-mg b) 1)) (cc (list '+ mm kk)))
        (ctc-app! 'fa p) (ctc-app! 'fb p)
        (dk-cite! 'cc-magnitude-closed a) (dk-cite! 'cc-magnitude-closed b)
        (dk-cite! 'cc-magnitude-nonneg a) (dk-cite! 'cc-magnitude-nonneg b)
        (dk-real! 0) (dk-real! 1) (dk-real! kk) (dk-real! cc) (dk-real! e2)
        (ctc-lin! (list '< 0 e2) (list '< 0 e))
        (ctc-lin! (list '<= 0 cc) (list '<= 0 mm) (list '<= 0 (ctc-mg b)) (list 'IN mm 'RR) (list 'IN (ctc-mg b) 'RR))
        (ctc-lin! '(< 0 1))
        (dk-cite! 'rr-pos-rr-of-lt e2)
        (let* ((d0 (dk-skolem! (ctc-cite2! 'rr-scale-eps cc e2) #t)))
          (dk-cite! 'rr-pos-rr-in-rr d0)
          (dk-cite! 'rr-lt-of-pos-rr d0)
          (ctc-lt-le! 0 d0)
          (ctc-cite2! 'rr-leq-reflexive d0)
          (let ((sc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h d0) (dk-contains? h cc)))
                             "the rr-scale-eps universal")))
            (dk-apply! sc d0))
          (let* ((n1 (ctc-nbhd! 'fa p d0)) (n2 (ctc-nbhd! 'fb p d0)) (n3 (ctc-nbhd! 'fb p 1))
                 (w1 (car n1)) (w2 (car n2)) (w3 (car n3))
                 (w23 (list 'INTERSECTION w2 w3)) (w (list 'INTERSECTION w1 w23)))
            (ctc-inter-open! w2 w3) (ctc-inter-open! w1 w23)
            (ctc-inter-in! p w2 w3) (ctc-inter-in! p w1 w23)
            (ctc-beta! hm p (list '* a b))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (cond
                  ((dk-ass!) #t)
                  (#t
                   (let* ((q (ctc-var (dk-peel!) w)) (c (list 'fa q)) (d (list 'fb q)))
                     (ctc-inter-out! q w1 w23) (ctc-inter-out! q w2 w3)
                     (ctc-at! (cdr n1) q) (ctc-at! (cdr n2) q) (ctc-at! (cdr n3) q)
                     (ctc-app! 'fa q) (ctc-app! 'fb q)
                     (ctc-beta! hm q (list '* c d))
                     (dk-conj-close!
                       (lambda ()
                         (cond
                           ((dk-ass!) #t)
                           (#t
                            (let* ((m1 (ctc-diff! a c)) (m2 (ctc-diff! b d)) (m3 (ctc-diff! d b))
                                   (pr (list '- (list '* a b) (list '* c d))))
                              (subst (list '= (list hm p) (list '* a b)))
                              (subst (list '= (list hm q) (list '* c d)))
                              (dk-cite! 'cc-magnitude-closed d)
                              (ctc-lt-le! m1 d0) (ctc-lt-le! m2 d0)
                              ;; |d| <= |b| + 1: d = (d - b) + b, |d - b| = |b - d| < 1
                              (dk-have! (list '= m3 m2)
                                (lambda ()
                                  (dk-have! (list '= (list '- d b) (list '- (list '- b d)))
                                    (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                                  (subst (list '= (list '- d b) (list '- (list '- b d))))
                                  (dk-cite! 'cc-magnitude-neg (list '- b d))
                                  (dk-ass!)))
                              (ctc-cite2! 'cc-magnitude-triangle (list '- d b) b)
                              (dk-have! (list '= (list '+ (list '- d b) b) d) (lambda () (ctc-mac-fix! 'binary-minus-def) (crs)))
                              (let ((h (dk-rewrite-h! (list '<= (ctc-mg (list '+ (list '- d b) b)) (list '+ m3 (ctc-mg b)))
                                                      (list '+ (list '- d b) b) d)))
                                h)
                              (dk-have! (list '<= (ctc-mg d) kk)
                                (lambda ()
                                  (dk-ineq! (list '<= (ctc-mg d) (list '+ m3 (ctc-mg b))) (list '= m3 m2) (list '< m2 1)
                                            (list 'IN (ctc-mg d) 'RR) (list 'IN m3 'RR) (list 'IN m2 'RR) (list 'IN (ctc-mg b) 'RR))))
                              (ctc-cite2! 'rr-leq-reflexive mm)
                              (ctc-cite2! 'cc-magnitude-prod-bound a b c d mm kk d0 e2)
                              (ctc-cite2! 'cc-mul-closed a b) (ctc-cite2! 'cc-mul-closed c d)
                              (ctc-diff! (list '* a b) (list '* c d))
                              (dk-ineq! (list '<= (ctc-mg pr) e2) (list '< 0 e) (list 'IN (ctc-mg pr) 'RR) (list 'IN e 'RR)))))))))))))))))
  (dk-cite! 'cc-hom-of-local 's hm)
  (dk-ass!))
(ctc-qed! 'cc-hom-mul)

;;; ---- (8) a point where two continuous maps differ has a neighbourhood missing every point where they agree --
(define ctc-agree '(FORALL ctc_ (IMPLIES (IN ctc_ ch) (= (fa ctc_) (fb ctc_)))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'fa (list 'FORALL 'fb (list 'FORALL 'ch (list 'FORALL 'p
  (list 'IMPLIES (ctc-hom 'fa) (list 'IMPLIES (ctc-hom 'fb) (list 'IMPLIES ctc-agree (list 'IMPLIES '(IN p (PTS s))
    (list 'IMPLIES '(NOT (= (fa p) (fb p)))
      '(FORSOME ctw_ (AND (IN ctw_ (OPENS s)) (AND (IN p ctw_) (SUBSET ctw_ (COMPLEMENT-IN (PTS s) ch)))))))))))))))))
(dk-peel!)
(ctc-pre! 'fa) (ctc-pre! 'fb)
(let* ((es (ctc-eq-set 'fa 'fb)) (co (list 'COMPLEMENT-IN '(PTS s) es)) (cch '(COMPLEMENT-IN (PTS s) ch)))
  (dk-cite! 'cc-hom-equalizer-closed 's 'fa 'fb)
  (dk-project! (list 'IN co '(OPENS s)) 'is-top-closed (list 'IS-TOP-CLOSED 's es))
  (dk-have! (list 'NOT (list 'IN 'p es))
    (lambda () (di) (sep-me (list 'IN 'p es)) (ai '(NOT (= (fa p) (fb p))))))
  (let ((cm (dk-cite! 'complement-in-membership '(PTS s) es 'p)))
    (dk-have! (list 'IN 'p co)
      (lambda () (dk-have! (caddr cm) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                 (if (dk-only! cm (caddr cm)) (prop)))))
  (ew co)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        (#t
         (mac 'subset-def)
         (let* ((z (ctc-var (dk-peel!) co))
                (cz (dk-cite! 'complement-in-membership '(PTS s) es z))
                (cy (dk-cite! 'complement-in-membership '(PTS s) 'ch z)))
           (dk-have! (caddr cz) (lambda () (if (dk-only! cz (list 'IN z co)) (prop))))
           (dk-split! (caddr cz))
           (dk-have! (list 'NOT (list 'IN z 'ch))
             (lambda ()
               (di)
               (dk-apply! (dk-ctx-form ctc-agree) z)
               (dk-have! (list 'IN z es) (lambda () (in-sep! (lambda () (dk-ass!)))))
               (ai (list 'NOT (list 'IN z es)))))
           (dk-have! (caddr cy) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
           (if (dk-only! cy (caddr cy)) (prop))))))))
(ctc-qed! 'cc-hom-separate)

