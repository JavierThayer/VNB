;;; l2c-c.scm -- PRODUCT FUNCTIONS ON X x Y (TH3-L2, 2026-11-09).  Helper prefix: l2c-.
;;;
;;; For [0, +inf]-valued measurable a on X and b on Y, the function (x, y) |-> a(x) b(y) on
;;; X x Y: it is measurable for the product sigma-algebra (each factor is a pullback along a
;;; coordinate projection, whose tails are measurable rectangles), its inner integral is
;;; x |-> a(x) int b, and (sigma-finite measures, tonelli-product of l2c-b.scm)
;;;     int_{X x Y} a(x) b(y) d(mu x nu)(x, y) = int a dmu * int b dnu.
;;; This is the computation behind the norm and the inner product of e_i(x) f_j(y) in
;;; L^2(X x Y) (th-main Prop 3.40, the basis f_ij).
;;;
;;; LOAD WINDOW: after l2c-b (tonelli-product, measurable-fn-in-fun).  Library: measure.

(define (l2c-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2c-c: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2c-c: unfinished" name))))

(define (l2c-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (l2c-and! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (l2c-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (l2c-open?) (not (proof-done? *ps*)))
(define (l2c-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
;;; the conjuncts of a predicate's defining iff, landed (hypothesis kept); top level only
(define (l2c-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (l2c-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))

(define l2c-xy '(CARTESIAN xs ys))
(define l2c-ps '(PRODUCT-SIGMA xs cA ys cB))
(define l2c-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define (l2c-xsi f) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu f))
(define (l2c-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define (l2c-ix f) (list 'INTEGRAL 'xs 'cA 'mu f))
(define (l2c-iy f) (list 'INTEGRAL 'ys 'cB 'nu f))
(define (l2c-ir f) (list 'INTEGRAL l2c-xy l2c-ps l2c-rho f))
(define l2c-f1 (list 'VNB-LAMBDA 'tw_ l2c-xy '(a (NTH 1 tw_))))
(define l2c-f2 (list 'VNB-LAMBDA 'tw_ l2c-xy '(b (NTH 2 tw_))))
(define l2c-tn (list 'VNB-LAMBDA 'tw_ l2c-xy '(etimes (a (NTH 1 tw_)) (b (NTH 2 tw_)))))

(define (l2c-xy-set!)
  (fact 'sigma-algebra-ambient-set 'xs 'cA)
  (fact 'sigma-algebra-ambient-set 'ys 'cB)
  (dk-have! (list 'IN l2c-xy 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!))))
;;; class extensionality, each direction driven
(define (l2c-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'tz_ (list 'IFF (list 'IN 'tz_ lhs) (list 'IN 'tz_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))

;;; ==========================================================================================
;;; (1) the tails of a measurable function, as a citable theorem
;;; ==========================================================================================
(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (IMPLIES (IS-MEASURABLE-FN omega cA f)
   (FORALL alpha_ (IMPLIES (IN alpha_ RR) (IN (SEP x_ omega (< alpha_ (f x_))) cA)))))))))
(let* ((ld (dk-peel!))
       (al (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
       (ps (l2c-parts! 'is-measurable-fn '(omega cA f))))
  (dk-apply! (caddr ps) al))
(if (l2c-open?) (ass))
(l2c-qed! 'measurable-fn-tail)

;;; ==========================================================================================
;;; (2) a measurable function of ONE coordinate is measurable on the product
;;; ==========================================================================================
;;; I = 1: F(w) = a(NTH 1 w), a on (xs, cA); I = 2: F(w) = b(NTH 2 w), b on (ys, cB).
;;; the tail set of F at al is the rectangle R (A x Y or X x A, A the tail set of the factor)
(define (l2c-tail-fwd! i S A R)
  (lambda (z)
    (sep-me (list 'IN z S))
    (dk-split-all! (list (dk-cite! 'cartesian-nth z 'xs 'ys)))
    (dk-cite! 'cartesian-pair-eq z 'xs 'ys)
    (let ((n1 (list 'NTH 1 z)) (n2 (list 'NTH 2 z)))
      (dk-have! (list 'IN (list 'NTH i z) A) (lambda () (in-sep! (lambda () (ass)))))
      (dk-cite! 'pair-in-cartesian (cadr R) (caddr R) n1 n2)
      (l2c-then-ass! (lambda () (dk-rewrite-h! (list 'IN (list 'LIST n1 n2) R) (list 'LIST n1 n2) z))))))
(define (l2c-tail-bwd! i S A R)
  (lambda (z)
    (dk-split-all! (list (dk-cite! 'cartesian-nth z (cadr R) (caddr R))))
    (dk-cite! 'cartesian-pair-eq z (cadr R) (caddr R))
    (let ((n1 (list 'NTH 1 z)) (n2 (list 'NTH 2 z)))
      (sep-me (list 'IN (list 'NTH i z) A))
      (dk-cite! 'pair-in-cartesian 'xs 'ys n1 n2)
      (dk-rewrite-h! (list 'IN (list 'LIST n1 n2) l2c-xy) (list 'LIST n1 n2) z)
      (in-sep! (lambda () (ass))))))
(define (l2c-tail-close! i fn om sg)
  (let* ((ld (dk-peel!))
         (al (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
    (l2c-lb!)
    (let* ((S (cadr (dk-goal)))
           (A (list 'SEP 'x_ om (list '< al (list fn 'x_))))
           (R (if (= i 1) (list 'CARTESIAN A 'ys) (list 'CARTESIAN 'xs A))))
      (dk-cite! 'measurable-fn-tail om sg fn al)
      (l2c-ext2! S R (l2c-tail-fwd! i S A R) (l2c-tail-bwd! i S A R))
      (subst (list '= S R))
      (if (= i 1) (fact 'sigma-algebra-whole-in 'ys 'cB) (fact 'sigma-algebra-whole-in 'xs 'cA))
      (l2c-then-ass! (lambda () (fact 'rectangle-in-product-sigma 'xs 'cA 'ys 'cB (cadr R) (caddr R)))))))
(define (l2c-pull-type! i fn om)
  (dk-lam-type!
    (lambda ()
      (let ((w (dk-di-var!)))
        (l2c-then-ass!
          (lambda ()
            (dk-split-all! (list (dk-cite! 'cartesian-nth w 'xs 'ys)))
            (fact 'fun-apply-type-c fn om 'RR-POS-STAR (list 'NTH i w))))))
    (lambda () (ass))))
;;; I = 1: F(w) = a(NTH 1 w), a on (xs, cA); I = 2: F(w) = b(NTH 2 w), b on (ys, cB).
(define (l2c-pull! i)
  (let ((fn (if (= i 1) 'a 'b))
        (om (if (= i 1) 'xs 'ys))
        (sg (if (= i 1) 'cA 'cB)))
    (dk-peel!)
    (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
    (l2c-xy-set!)
    (dk-cite! 'measurable-fn-in-fun om sg fn)
    (mac 'IS-MEASURABLE-FN)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((dk-head-is? g 'IN) (l2c-pull-type! i fn om))
                (#t (l2c-tail-close! i fn om sg))))))))

(sp (make-wff (forall-guarded '(xs cA ys cB a) '((IS-SIGMA-ALGEBRA xs cA) (IS-SIGMA-ALGEBRA ys cB) (IS-MEASURABLE-FN xs cA a))
   (list 'IS-MEASURABLE-FN l2c-xy l2c-ps l2c-f1))))
(l2c-pull! 1)
(l2c-qed! 'measurable-fn-pullback-first)

(sp (make-wff (forall-guarded '(xs cA ys cB b) '((IS-SIGMA-ALGEBRA xs cA) (IS-SIGMA-ALGEBRA ys cB) (IS-MEASURABLE-FN ys cB b))
   (list 'IS-MEASURABLE-FN l2c-xy l2c-ps l2c-f2))))
(l2c-pull! 2)
(l2c-qed! 'measurable-fn-pullback-second)

;;; ==========================================================================================
;;; (3) the product function a(x) b(y)
;;; ==========================================================================================
(define l2c-hyp2 '((IS-SIGMA-ALGEBRA xs cA) (IS-SIGMA-ALGEBRA ys cB) (IS-MEASURABLE-FN xs cA a) (IS-MEASURABLE-FN ys cB b)))
;;; w in XY: the components typed and the values typed
(define (l2c-at! w)
  (dk-split-all! (list (dk-cite! 'cartesian-nth w 'xs 'ys)))
  (fact 'fun-apply-type-c 'a 'xs 'RR-POS-STAR (list 'NTH 1 w))
  (fact 'fun-apply-type-c 'b 'ys 'RR-POS-STAR (list 'NTH 2 w))
  (l2c-and! (list 'IN (list 'a (list 'NTH 1 w)) 'RR-POS-STAR) (list 'IN (list 'b (list 'NTH 2 w)) 'RR-POS-STAR))
  (fact 'etimes-closed (list 'a (list 'NTH 1 w)) (list 'b (list 'NTH 2 w))))

(sp (make-wff (forall-guarded '(xs cA ys cB a b) l2c-hyp2 (list 'IS-MEASURABLE-FN l2c-xy l2c-ps l2c-tn))))
(dk-peel!)
(l2c-xy-set!)
(dk-cite! 'measurable-fn-in-fun 'xs 'cA 'a)
(dk-cite! 'measurable-fn-in-fun 'ys 'cB 'b)
(dk-cite! 'measurable-fn-pullback-first 'xs 'cA 'ys 'cB 'a)
(dk-cite! 'measurable-fn-pullback-second 'xs 'cA 'ys 'cB 'b)
(let ((ch (dk-cite! 'measurable-fn-etimes-of-values l2c-xy l2c-ps l2c-f1 l2c-f2 l2c-tn)))
  (dk-chain! ch
    (lambda (ante)
      (if (dk-head-is? ante 'IN)
          (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (l2c-then-ass! (lambda () (l2c-at! w))))) (lambda () (ass))))
          (lambda () (let ((w (dk-di-var!))) (l2c-at! w) (l2c-lb!) (if (l2c-open?) (rfl))))))))
(if (l2c-open?) (ass))
(l2c-qed! 'measurable-fn-tensor)

;;; c * b on ys, c in [0, +inf]: a member of FUN(ys, RR-POS-STAR)
(define (l2c-scale-type! om f c)
  (let ((want (list 'IN (list 'PTWISE-SCALE om c f) (list 'FUN om 'RR-POS-STAR))))
    (if (not (dk-asm? want))
        (dk-have! want
          (lambda ()
            (mac 'PTWISE-SCALE)
            (dk-lam-type!
              (lambda ()
                (let ((z (dk-di-var!)))
                  (l2c-then-ass!
                    (lambda ()
                      (fact 'fun-apply-type-c f om 'RR-POS-STAR z)
                      (l2c-and! (list 'IN c 'RR-POS-STAR) (list 'IN (list f z) 'RR-POS-STAR))
                      (fact 'etimes-closed c (list f z))))))
              (lambda () (ass))))))
    want))

;;; the inner integral of a(x) b(y) is a(x) int b
(sp (make-wff (forall-guarded '(xs cA ys cB nu a b x) (append l2c-hyp2 '((IS-MEASURE ys cB nu) (IN x xs)))
   (list '= (list (l2c-xsi l2c-tn) 'x) (list 'etimes '(a x) (l2c-iy 'b))))))
(dk-peel!)
(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(fact 'sigma-algebra-ambient-set 'xs 'cA)
(fact 'sigma-algebra-ambient-set 'ys 'cB)
(dk-cite! 'measurable-fn-in-fun 'xs 'cA 'a)
(dk-cite! 'measurable-fn-in-fun 'ys 'cB 'b)
(dk-cite! 'measurable-fn-tensor 'xs 'cA 'ys 'cB 'a 'b)
(fact 'fun-apply-type-c 'a 'xs 'RR-POS-STAR 'x)
(let* ((fs (l2c-fxs l2c-tn 'x))
       (sc (list 'PTWISE-SCALE 'ys '(a x) 'b)))
  (fact 'fn-x-section-measurable 'xs 'cA 'ys 'cB l2c-tn 'x)
  (dk-cite! 'measurable-fn-in-fun 'ys 'cB fs)
  (l2c-scale-type! 'ys 'b '(a x))
  (dk-have! (list 'FORALL 'icy_ (list 'IMPLIES '(IN icy_ ys) (list '= (list fs 'icy_) (list sc 'icy_))))
    (lambda ()
      (let* ((z (dk-di-var!)) (p (list 'LIST 'x z)))
        (fact 'pair-in-cartesian 'xs 'ys 'x z)
        (fact 'membership-implies-sethood 'x 'xs)
        (fact 'membership-implies-sethood z 'ys)
        (fact 'fun-apply-type-c 'b 'ys 'RR-POS-STAR z)
        (subst (dk-cite! 'fn-x-section-apply 'ys l2c-tn 'x z))
        (l2c-lb!)
        (nth-r)
        (subst (dk-cite! 'ptwise-scale-value 'ys '(a x) 'b z))
        (l2c-and! '(IN (a x) RR-POS-STAR) (list 'IN (list 'b z) 'RR-POS-STAR))
        (fact 'etimes-closed '(a x) (list 'b z))
        (if (l2c-open?) (rfl)))))
  (fact 'integral-congruence-ptwise 'ys 'cB 'nu fs sc)
  (fact 'integral-homogeneous-star 'ys 'cB 'nu 'b '(a x))
  (subst (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu l2c-tn 'x))
  (subst (list '= (l2c-iy fs) (l2c-iy sc)))
  (subst (list '= (l2c-iy sc) (list 'etimes '(a x) (l2c-iy 'b))))
  (fact 'integral-in 'ys 'cB 'nu 'b)
  (l2c-and! '(IN (a x) RR-POS-STAR) (list 'IN (l2c-iy 'b) 'RR-POS-STAR))
  (fact 'etimes-closed '(a x) (l2c-iy 'b))
  (if (l2c-open?) (rfl)))
(l2c-qed! 'xsi-tensor)

;;; int_{X x Y} a(x) b(y) = int a * int b
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu a b)
   '((IS-MEASURE xs cA mu) (IS-MEASURE ys cB nu) (IS-SIGMA-FINITE xs cA mu) (IS-SIGMA-FINITE ys cB nu)
     (IS-MEASURABLE-FN xs cA a) (IS-MEASURABLE-FN ys cB b))
   (list '= (l2c-ir l2c-tn) (list 'etimes (l2c-ix 'a) (l2c-iy 'b))))))
(dk-peel!)
(l2c-parts! 'is-measure '(xs cA mu))
(l2c-parts! 'is-measure '(ys cB nu))
(fact 'sigma-algebra-ambient-set 'xs 'cA)
(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(dk-cite! 'measurable-fn-in-fun 'xs 'cA 'a)
(dk-cite! 'measurable-fn-tensor 'xs 'cA 'ys 'cB 'a 'b)
(fact 'integral-in 'ys 'cB 'nu 'b)
(fact 'integral-in 'xs 'cA 'mu 'a)
(let ((sc (list 'PTWISE-SCALE 'xs (l2c-iy 'b) 'a)))
  (fact 'x-section-integral-type 'xs 'cA 'ys 'cB 'nu l2c-tn)
  (l2c-scale-type! 'xs 'a (l2c-iy 'b))
  (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ xs) (list '= (list (l2c-xsi l2c-tn) 'icx_) (list sc 'icx_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (fact 'fun-apply-type-c 'a 'xs 'RR-POS-STAR x)
        (subst (dk-cite! 'xsi-tensor 'xs 'cA 'ys 'cB 'nu 'a 'b x))
        (subst (dk-cite! 'ptwise-scale-value 'xs (l2c-iy 'b) 'a x))
        (l2c-and! (list 'IN (list 'a x) 'RR-POS-STAR) (list 'IN (l2c-iy 'b) 'RR-POS-STAR))
        (subst (dk-cite! 'etimes-comm (list 'a x) (l2c-iy 'b)))
        (fact 'etimes-closed (l2c-iy 'b) (list 'a x))
        (if (l2c-open?) (rfl)))))
  (fact 'integral-congruence-ptwise 'xs 'cA 'mu (l2c-xsi l2c-tn) sc)
  (fact 'integral-homogeneous-star 'xs 'cA 'mu 'a (l2c-iy 'b))
  (subst (dk-cite! 'tonelli-product 'xs 'cA 'mu 'ys 'cB 'nu l2c-tn))
  (subst (list '= (l2c-ix (l2c-xsi l2c-tn)) (l2c-ix sc)))
  (subst (list '= (l2c-ix sc) (list 'etimes (l2c-iy 'b) (l2c-ix 'a))))
  (l2c-and! (list 'IN (l2c-iy 'b) 'RR-POS-STAR) (list 'IN (l2c-ix 'a) 'RR-POS-STAR))
  (subst (dk-cite! 'etimes-comm (l2c-iy 'b) (l2c-ix 'a)))
  (fact 'etimes-closed (l2c-ix 'a) (l2c-iy 'b))
  (if (l2c-open?) (rfl)))
(l2c-qed! 'tonelli-tensor)
(alias! 'tonelli-tensor "the integral of a(x) b(y) against the product measure is the product of the integrals")
