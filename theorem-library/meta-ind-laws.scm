      (lambda ()
        (dk-cite! 'enc-pred1-unfold n 's)
        (dk-rewrite-h! `(IN ,ps CLF) ps `(EAPP 10 ,l))
        (dk-have! '(IN 2 NN) (lambda () (arith)))
        (dk-have! '(<= 1 2) (lambda () (arith)))
