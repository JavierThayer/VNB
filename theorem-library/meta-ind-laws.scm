  (let* ((i1 (mi-open2! bb 0 's))
         (g1 (mi+ 'g axu)) (g2 (mi+ g1 i1)) (g3 (mi+ g2 `(ENC-IMP ,ps ,e) `(ENC-IMP ,e ,ps))))
