;;; meta-ind-laws.scm -- K2 PHASE 4: the admissibility of the kernel's set-formation rules and of the three
;;; induction rules over the core, the typing machinery an instance at a compound term needs, and (section
;;; J) the one phase-5 derivation that needs the OPEN calculator (docs/meta-k2-admissibility-2026-10-08.md,
;;; section 6, phases 4 and 5; reports scratchpad/triage/META-4-REPORT.md, META-5-REPORT.md).
;;; The relations are structure-library/meta-ind.scm's and meta-def.scm's; the core is meta-core.scm's.
;;; Agents META-4 (sections A-E, H) and META-5 (sections I, F, G, K, J), 2026-10-12.  Every theorem here
;;; is (qed ...); helper procedures are local (prefix mi-).
;;; Load window: after theorem-library/meta-cr-laws.scm (der-iff-r / der-iff-l, open-app2, open-fun-unfold,
;;; mr-fresh), structure-library/meta-ind.scm and structure-library/meta-def.scm;
;;; dk-meta-derive! is in driver-kit.scm.  Library: meta.

;;; -----------------------------------------------------------------------
;;; A. HELPERS AND THE HYPOTHESIS LISTS.

(define (mi+ g . fs) (fold-left (lambda (g f) `(CTX-ADD ,g ,f)) g fs))

;; HYPS-IN of a literal two-list, eliminated (the list's definedness an antecedent: since round 3 the
;; definition's macete at (LIST s1 s2) owes it).
(sp (make-wff '(FORALL s1 (FORALL s2 (FORALL mizS_ (IMPLIES (= (LIST s1 s2) (LIST s1 s2))
   (IMPLIES (HYPS-IN (LIST s1 s2) mizS_) (AND (IN s1 mizS_) (IN s2 mizS_)))))))))
(dk-peel!)
(let ((u (dk-landed-1 (lambda () (mac-h 'hyps-in '(HYPS-IN (LIST s1 s2) mizS_))))))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (dk-have! '(IN 2 NN) (lambda () (arith)))
  (dk-have! '(<= 1 1) (lambda () (arith)))
  (dk-have! '(<= 1 2) (lambda () (arith)))
  (dk-have! '(<= 1 (LENGTH (LIST s1 s2))) (lambda () (len-r) (arith)))
  (dk-have! '(<= 2 (LENGTH (LIST s1 s2))) (lambda () (len-r) (arith)))
  (dk-nth-h! (dk-apply! u 1))
  (dk-nth-h! (dk-apply! u 2))
  (dk-conj-close! (lambda () (ass))))
(qed 'hyps-in-2-elim)

;; Unpack REL(tt, hs, c) (its body (AND (IN c SEQ-SET) (FORSOME ...))): return the witnesses.  c and hs
;; are rewritten away; each hypothesis sequent's derivability and SEQ-SET membership land, and the
;; conclusion's SEQ-SET membership.  N is the number of hypotheses (0, 1 or 2).
(define (mi-rel-open! rel n)
  (let* ((r (dk-meta-iff-r! (dk-meta-iff! rel 'tt 'hs 'c)))
         (parts (dk-split! r))
         (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
         (ceq (dk-meta-eq-of 'c)) (heq (dk-meta-eq-of 'hs)))
    (subst ceq)
    (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
    (if (> n 0)
        (let* ((lst (caddr heq))
               (h2 (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs lst))
               (ss (cdr lst)))
          (dk-have! `(= ,lst ,lst) (lambda () (rfl)))
          (case n
            ((1) (dk-cite! 'hyps-in-1-elim (car ss) '(DERIVABLE tt)))
            ((2) (dk-split! (dk-cite! 'hyps-in-2-elim (car ss) (cadr ss) '(DERIVABLE tt)))))
          (for-each (lambda (s) (dk-cite! 'der-in-seq 'tt s)) ss)))
    vs))

;;; -----------------------------------------------------------------------
;;; B. SET FORMATION.

;; sep-sethood and big-union-sethood: the kernel relation is the core relation (meta-ind.scm s.1).
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-SEP-SETHOOD tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-sep-sethood 1)) (g (car vs)) (a (cadr vs)) (p (caddr vs)))
  (dk-derive! 'tt `(sep-sethood (,g ==> (ENC-IN (ENC-SEP ,a ,p) ENC-SETC)) (given (,g ==> (ENC-IN ,a ENC-SETC)))))
  (ass))
(qed 'adm-sep-sethood)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-BIG-UNION-SETHOOD tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-big-union-sethood 2)) (g (car vs)) (a (cadr vs)) (b (caddr vs)))
  (dk-derive! 'tt `(big-union-sethood (,g ==> (ENC-IN (ENC-BU ,a ,b) ENC-SETC))
                     (given (,g ==> (ENC-IN ,a ENC-SETC)))
                     (given (,g ==> (ENC-ALL (ENC-IMP (ENC-IN (EBVAR 0) ,a) (ENC-IN ,b ENC-SETC)))))))
  (ass))
(qed 'adm-big-union-sethood)

;; sep-mem-intro / comp-mem-intro: and-intro, then the schema read right to left (der-iff-l).
(define (mi-mem-intro! rel schema dom)   ; dom: the domain term from the witnesses
  (lambda ()
    (dk-peel!)
    (let* ((vs (mi-rel-open! rel 2))
           (g (car vs)) (cls ((car dom) vs)) (p ((cadr dom) vs)) (y ((caddr dom) vs))
           (uu `(ENC-IN ,y ,cls)) (ia `(ENC-IN ,y ,((cadddr dom) vs))) (op `(EXPR-OPEN ,p 0 ,y))
           (rr `(ENC-AND ,ia ,op)) (ff `(ENC-IFF ,uu ,rr)))
      (dk-meta-derive! 'tt
        `(lemma (,g ==> ,uu) der-iff-l (,g ,uu ,rr)
           (,schema (,g ==> ,ff))
           (and-intro (,g ==> ,rr) (given (,g ==> ,ia)) (given (,g ==> ,op)))))
      (ass))))

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-SEP-MEM-INTRO tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
((mi-mem-intro! 'rel-sep-mem-intro 'sep-mem
   (list (lambda (vs) `(ENC-SEP ,(cadr vs) ,(caddr vs))) caddr cadddr cadr)))
(qed 'adm-sep-mem-intro)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-COMP-MEM-INTRO tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
((mi-mem-intro! 'rel-comp-mem-intro 'comp-mem
   (list (lambda (vs) `(ENC-COMP ,(cadr vs))) cadr caddr (lambda (vs) 'ENC-SETC))))
(qed 'adm-comp-mem-intro)

;; The unfold equations of the three binder terms of set formation.
(sp (make-wff '(FORALL mia_ (FORALL mip_ (== (ENC-SEP mia_ mip_) (EBIND 22 1 (LIST mia_) mip_))))))
(dk-peel!) (mac 'enc-sep) (qrfl)
(qed 'enc-sep-unfold)
(sp (make-wff '(FORALL mip_ (== (ENC-COMP mip_) (EBIND 23 1 (LIST) mip_)))))
(dk-peel!) (mac 'enc-comp) (qrfl)
(qed 'enc-comp-unfold)
(sp (make-wff '(FORALL mia_ (FORALL mip_ (== (ENC-BU mia_ mip_) (EBIND 24 1 (LIST mia_) mip_))))))
(dk-peel!) (mac 'enc-bu) (qrfl)
(qed 'enc-bu-unfold)

;; (IN t SET) for a term built from sets: a numeral, a literal list of sets, a term typed in a class in
;; context, an encoded constructor (unfolded in a lane).
(define mi-unfolds
  '((ENC-IN . enc-in-unfold) (ENC-EQ . enc-eq-unfold) (ENC-AND . enc-and-unfold) (ENC-IMP . enc-imp-unfold)
    (ENC-OR . enc-or-unfold) (ENC-IFF . enc-iff-unfold) (ENC-NOT . enc-not-unfold) (ENC-ALL . enc-all-unfold)
    (ENC-EX . enc-ex-unfold) (ENC-SEP . enc-sep-unfold) (ENC-COMP . enc-comp-unfold) (ENC-BU . enc-bu-unfold)))
(define (mi-set! t)
  (cond
    ((dk-asm? `(IN ,t SET)) #t)
    ((and (number? t) (exact-nonnegative-integer? t)) (dk-meta-num-set! t))
    ((find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) t) (not (eq? (caddr f) 'SET)))) (dk-asms))
     => (lambda (f) (fact 'membership-implies-sethood t (caddr f))))
    ((and (pair? t) (eq? (car t) 'LIST))
     (for-each mi-set! (cdr t))
     (dk-have! `(IN ,t (TUPLES SET)) (lambda () (dk-close-all! (lambda () (ti)))))
     (fact 'membership-implies-sethood t '(TUPLES SET)))
    ((and (pair? t) (memq (car t) '(EAPP EBIND EFVAR EBVAR ECONST)))
     (dk-have! `(IN ,t SET) (lambda () (mac (car t)) (mi-set! (cadr (dk-goal))) (ass))))
    ((eq? t 'ENC-SETC)
     (dk-have! `(IN ,t SET) (lambda () (subst (dk-cite! 'enc-setc-def)) (mi-set! (cadr (dk-goal))) (ass))))
    ((and (pair? t) (assq (car t) mi-unfolds))
     (let ((eqn (apply dk-cite! (cdr (assq (car t) mi-unfolds)) (cdr t))))
       (mi-set! (caddr eqn))
       (dk-have! `(IN ,t SET) (lambda () (subst eqn) (ass)))))
    (#t (error "mi-set!: cannot show this term is a set" (expression->string t)))))

;; (IN f G) for G a CTX-ADD chain in which f is added, every added formula a set; then f in CLF by
;; ctx-mem when (IN G CTX-SET) is in context.
(define (mi-in-ctx! f g)
  (cond
    ((dk-asm? `(IN ,f ,g)) #t)
    ((and (pair? g) (eq? (car g) 'CTX-ADD) (equal? (caddr g) f))
     (mi-set! f) (dk-cite! 'ctx-add-has (cadr g) f))
    ((and (pair? g) (eq? (car g) 'CTX-ADD))
     (mi-in-ctx! f (cadr g)) (mi-set! (caddr g)) (dk-cite! 'ctx-add-keeps (cadr g) (caddr g) f))
    (#t (error "mi-in-ctx!: not an added member" (expression->string f)))))
(define (mi-ctx-clf! f g) (mi-in-ctx! f g) (dk-cite! 'ctx-mem g f))

;; From (IN (ENC-IN y B) CLF), B = (ENC-SEP a p) | (ENC-COMP p) | (ENC-BU a p): land y and B in CLT
;; and in EXPR-SET, the body p in EXPR-SET, and the outside argument a (if any) in SET.
(define (mi-binder-parts! y b)
  (dk-split! (dk-cite! 'clf-in-elim y b))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff y)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff b)))
  (let* ((eqn (apply dk-cite! (cdr (assq (car b) mi-unfolds)) (cdr b)))
         (eb (caddr eqn)) (h (cadr eb)) (oa (cadddr eb)) (p (car (cddddr eb))))
    (dk-rewrite-h! `(IN ,b EXPR-SET) b eb)
    (dk-cite! 'ebind-body-expr h 1 oa p)
    (if (pair? (cdr oa))
        (let* ((lit `(LIST 4 ,h 1 ,oa ,p)))
          (dk-have! `(== ,eb ,lit) (lambda () (mac 'EBIND) (qrfl)))
          (dk-rewrite-h! `(IN ,eb EXPR-SET) eb lit)
          (dk-have! '(IN 4 NN) (lambda () (arith)))
          (dk-have! '(IN 1 NN) (lambda () (arith)))
          (dk-have! `(AND (<= 1 4) (<= 4 (LENGTH ,lit))) (lambda () (len-r) (dk-conj-close! (lambda () (arith)))))
          (dk-nth-h! (dk-cite! 'tuple-members-are-sets lit 'EXPR-SET 4))
          (dk-have! `(AND (<= 1 1) (<= 1 (LENGTH ,oa))) (lambda () (len-r) (dk-conj-close! (lambda () (arith)))))
          (dk-nth-h! (dk-cite! 'tuple-members-are-sets oa 'SET 1))))
    p))

;; sep-mem-elim / comp-mem-elim: the membership read through the schema (der-iff-r), cut in, split by
;; and-elim, and the hypothesis weakened from the context without the membership.  The two added
;; formulas are sentences because they are members of the hypothesis context (sets: their parts are
;; expressions, the outside argument a component of an expression).
(define (mi-mem-elim! rel schema dom)
  (lambda ()
    (dk-peel!)
    (let* ((vs (mi-rel-open! rel 1))
           (g (car vs)) (f (cadr vs)) (cls ((car dom) vs)) (p ((cadr dom) vs)) (y ((caddr dom) vs))
           (uu `(ENC-IN ,y ,cls)) (ia `(ENC-IN ,y ,((cadddr dom) vs))) (op `(EXPR-OPEN ,p 0 ,y))
           (rr `(ENC-AND ,ia ,op)) (ff `(ENC-IFF ,uu ,rr))
           (dg `(DIFFERENCE ,g (PAIR ,uu ,uu))) (gd (mi+ dg ia op)) (g1 (mi+ g rr)))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff gd f)))
      (dk-cite! 'ctx-mem g uu)
      (mi-binder-parts! y cls)
      (dk-have! '(IN 0 NN) (lambda () (arith)))
      (fact 'open-in-expr y 0 p)
      (mi-ctx-clf! ia gd)
      (mi-ctx-clf! op gd)
      (dk-cite! 'ctx-diff-sub g `(PAIR ,uu ,uu))
      (dk-meta-derive! 'tt
        `(cut (,g ==> ,f)
           (lemma (,g ==> ,rr) der-iff-r (,g ,uu ,rr)
             (,schema (,g ==> ,ff))
             (assumption (,g ==> ,uu)))
           (and-elim (,g1 ==> ,f)
             (weakening (,(mi+ g1 ia op) ==> ,f) (given (,gd ==> ,f))))))
      (ass))))

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-SEP-MEM-ELIM tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
((mi-mem-elim! 'rel-sep-mem-elim 'sep-mem
   (list (lambda (vs) `(ENC-SEP ,(caddr vs) ,(cadddr vs))) cadddr (lambda (vs) (car (cddddr vs))) caddr)))
(qed 'adm-sep-mem-elim)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-COMP-MEM-ELIM tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
((mi-mem-elim! 'rel-comp-mem-elim 'comp-mem
   (list (lambda (vs) `(ENC-COMP ,(caddr vs))) caddr cadddr (lambda (vs) 'ENC-SETC))))
(qed 'adm-comp-mem-elim)
;;; -----------------------------------------------------------------------
;;; C. THE TYPING OF INSTANCES: an instance of a sentence's universal at a closed term is a sentence.
;;; Phases 1-3 never needed it: their instances were at names, or their typings were carried by the
;;; relations.  The inductions and big-union-mem need it at a compound term (a comprehension, a
;;; witness).  Three lemmas by expression induction (the phase-1 device, as lcd-open):
;;;   wks-single:   a term's kind set is exactly {1};
;;;   lcd-mono:     a closing depth stays a closing depth above;
;;;   lcd-open-closes: opening the index k at a term closed at k closes the depth k + 1 down to k.

(define mi-ofl '(VNB-LAMBDA (LIST mxw_ mxj_) (CARTESIAN EXPR-SET NN) (EXPR-OPEN mxw_ mxj_ u)))  ; OPEN-FUN(u)
(define (mi-rw-h! f eqn) (dk-rewrite-h! f (cadr eqn) (caddr eqn)))
(define (mi-entries-of mm)
  (define (concl f) (if (dk-head-is? f 'IMPLIES) (concl (caddr f)) f))
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL)
                            (let ((c (concl (caddr f))))
                              (and (dk-head-is? c '=) (dk-head-is? (cadr c) 'NTH)
                                   (equal? (cadr (cadr c)) (cadr f))
                                   (equal? (caddr (cadr c)) mm)))))
           "the map's entries"))
;; w in MAKE-SET(l) in context: land an index i with its range and (= (NTH i l) w); return i.
(define (mi-makeset-index! w l)
  (fact 'make-set-membership w l)
  (let ((iff (iff-for `(IN ,w (MAKE-SET ,l)))))
    (dk-have! (caddr iff) (lambda () (dk-meta-keep-prop! iff `(IN ,w (MAKE-SET ,l)))))
    (dk-split-all!)
    (let ((i (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f l))) "the index"))))
      (dk-split-all!)
      i)))

;; The expression-induction frame shared by the three: CLS the class, CASE! per constructor.
;; (CASE! tag x landed) is run on the condition leaf of x in CLS (after in-sep!'s domain leaf),
;; with LANDED the hypotheses the constructor's induction hypothesis landed.
(define (mi-expr-ind! cls case!)
  (let ((hs (dk-meta-ind-hyps cls)))
    (for-each
      (lambda (k tag in-law)
        (dk-have! (list-ref hs k)
          (lambda ()
            (let* ((landed (dk-peel!)) (x (cadr (dk-goal))))
              (apply fact in-law (cdr x))
              (in-sep! (lambda () (ass)) (lambda () (case! tag x landed)))))))
      '(0 1 2 3 4) '(fvar bvar const app bind)
      '(efvar-in-expr ebvar-in-expr econst-in-expr eapp-in-expr ebind-in-expr))
    (dk-cite! 'expr-induction cls)))

;; The child's class condition: (IN c CLS) in context (or the IH at the index i, rewritten to c).
(define (mi-ih-open! c cls)
  (sep-me `(IN ,c ,cls)))

;;; C.1 A term's kind set is {1}.
(define mi-ws-cls '(SEP miwz_ EXPR-SET (IMPLIES (IN 1 (EXPR-WKS miwz_)) (= (EXPR-WKS miwz_) (PAIR 1 1)))))
;; (= S (PAIR 1 1)) for S = (SEP k NN (AND (= k R) C)) with (IN 1 S) in context.
;; the instance of pairing-membership at 1, 1: (FORALL x (IFF (IN x (PAIR 1 1)) (OR (= x 1) (= x 1))))
(define (mi-pair11!)
  (let* ((u '(FORALL x (IFF (IN x (PAIR 1 1)) (OR (= x 1) (= x 1)))))
         (imp `(IMPLIES (AND (IN 1 SET) (IN 1 SET)) ,u)))
    (if (not (dk-asm? u))
        (begin
          (dk-meta-num-set! 1)
          (dk-have! '(AND (IN 1 SET) (IN 1 SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
          (fact 'pairing-membership 1 1)
          (if (not (dk-asm? u)) (detach! imp))))
    u))
(define (mi-sep-single! s)
  (dk-meta-num-set! 1)
  (let ((univ `(FORALL miwx_ (IFF (IN miwx_ ,s) (IN miwx_ (PAIR 1 1))))))
    (dk-have! univ
      (lambda ()
        (dk-peel!)
        (let ((x (cadr (cadr (dk-goal)))))
          (dk-iff! (lambda (g) (equal? (caddr g) '(PAIR 1 1)))
            (lambda ()
              (sep-me `(IN ,x ,s))
              (dk-split-all!)
              (sep-me `(IN 1 ,s))
              (dk-split-all!)
              (let* ((e1 (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) x))) "x = R"))
                     (e2 (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) 1))) "1 = R"))
                     (iff (dk-apply! (mi-pair11!) x)))
                (dk-have! `(= ,x 1) (lambda () (subst e1) (subst `(= ,(caddr e2) 1)) (rfl)))
                (dk-have! `(OR (= ,x 1) (= ,x 1)) (lambda () (oi-l) (ass)))
                (dk-meta-iff-l! iff)
                (ass)))
            (lambda ()
              (let ((o (dk-meta-iff-r! (dk-apply! (mi-pair11!) x))))
                (dk-meta-or-each! o (lambda (d) (subst d) (ass)))))))))
    (fact 'class-extensionality s '(PAIR 1 1))
    `(= ,s (PAIR 1 1))))

(sp (make-wff '(FORALL e (IMPLIES (IN e EXPR-SET) (IMPLIES (IN 1 (EXPR-WKS e)) (= (EXPR-WKS e) (PAIR 1 1)))))))
(dk-peel!)
(dk-apply! (mi-expr-ind! mi-ws-cls
  (lambda (tag x landed)
    (di)
    (case tag
      ((fvar bvar const)
       (subst (dk-cite! (cdr (assq tag '((fvar . wks-efvar) (bvar . wks-ebvar) (const . wks-econst)))) (cadr x)))
       (dk-meta-num-set! 1)
       (rfl))
      ((app bind)
       (let* ((eqn (apply dk-cite! (if (eq? tag 'app) 'wks-eapp 'wks-ebind) (cdr x))) (s (caddr eqn)))
         (mi-rw-h! `(IN 1 (EXPR-WKS ,x)) eqn)
         (subst eqn)
         (mi-sep-single! s)
         (ass)))))) 'e)
(sep-me `(IN e ,mi-ws-cls))
(detach! '(IMPLIES (IN 1 (EXPR-WKS e)) (= (EXPR-WKS e) (PAIR 1 1))))
(ass)
(qed 'wks-single)


;;; C.2 lcd-mono.
(define mi-mono-cls
  '(SEP mimz_ EXPR-SET (FORALL mid1_ (FORALL mid2_ (IMPLIES (IN mid1_ NN) (IMPLIES (IN mid2_ NN) (IMPLIES (<= mid1_ mid2_)
     (IMPLIES (IN mid1_ (EXPR-LCD mimz_)) (IN mid2_ (EXPR-LCD mimz_))))))))))
;; the IH universal of a list l among LANDED (expr-induction's children hypothesis)
(define (mi-comps-of landed l)
  (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l)))) landed))
;; on a goal (FORALL w (IMPLIES (IN w (MAKE-SET l)) (IN d (EXPR-LCD w)))): for each entry, ENTRY! i w
;; is run with (= (NTH i l) w) and the index range in context.
(define (mi-ms-each! l entry!)
  (dk-peel!)
  (let* ((g (dk-goal)) (w (cadr (caddr g)))
         (i (mi-makeset-index! w l)))
    (entry! i w)))

(sp (make-wff '(FORALL e (IMPLIES (IN e EXPR-SET) (FORALL d (FORALL d2 (IMPLIES (IN d NN) (IMPLIES (IN d2 NN) (IMPLIES (<= d d2)
   (IMPLIES (IN d (EXPR-LCD e)) (IN d2 (EXPR-LCD e))))))))))))
(dk-peel!)
(let* ((ge (dk-goal)) (e0 (cadr (caddr ge))) (d20 (cadr ge))
       (d0 (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(EXPR-LCD ,e0)))) "d in LCD e"))))
  (dk-apply! (mi-expr-ind! mi-mono-cls
    (lambda (tag x landed)
      (dk-peel!)
      (let* ((g (dk-goal)) (d2 (cadr g))
             (dm (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(EXPR-LCD ,x)))) "the depth hypothesis"))
             (d (cadr dm)))
        (case tag
          ((fvar const)
           (subst (dk-cite! (if (eq? tag 'fvar) 'lcd-efvar 'lcd-econst) (cadr x)))
           (ass))
          ((bvar)
           (let* ((j (cadr x)) (eqn (dk-cite! 'lcd-ebvar j)))
             (sep-me (mi-rw-h! dm eqn))
             (subst eqn)
             (in-sep! (lambda () (ass)) (lambda () (dk-nn! `(< ,j ,d) `(<= ,d ,d2))))))
          ((app)
           (let* ((h (cadr x)) (l (caddr x)) (eqn (dk-cite! 'lcd-eapp h l)) (comps (mi-comps-of landed l)))
             (sep-me (mi-rw-h! dm eqn))
             (let ((du (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l)) (dk-contains? f d))) "du")))
               (subst eqn)
               (in-sep! (lambda () (ass))
                 (lambda ()
                   (mi-ms-each! l
                     (lambda (i w)
                       (dk-rewrite-h! (dk-apply! comps i) `(NTH ,i ,l) w)
                       (dk-apply! du w)
                       (sep-me `(IN ,w ,mi-mono-cls))
                       (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-LCD ,w)) (dk-contains? f 'mid1_))) "cond") d d2)
                       (ass))))))))
          ((bind)
           (let* ((h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
                  (eqn (dk-cite! 'lcd-ebind h nb a b)) (comps (mi-comps-of landed a)))
             (sep-me (mi-rw-h! dm eqn))
             (dk-split-all!)
             (let ((du (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,a)) (dk-contains? f d))) "du")))
               (subst eqn)
               (in-sep! (lambda () (ass))
                 (lambda ()
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'FORALL)
                           (mi-ms-each! a
                             (lambda (i w)
                               (dk-rewrite-h! (dk-apply! comps i) `(NTH ,i ,a) w)
                               (dk-apply! du w)
                               (sep-me `(IN ,w ,mi-mono-cls))
                               (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-LCD ,w)) (dk-contains? f 'mid1_))) "cond") d d2)
                               (ass)))
                           (begin
                             (dk-meta-and! `(IN ,d NN) `(IN ,nb NN))
                             (fact 'nn-add-closed d nb)
                             (dk-meta-and! `(IN ,d2 NN) `(IN ,nb NN))
                             (fact 'nn-add-closed d2 nb)
                             (dk-have! `(<= (+ ,d ,nb) (+ ,d2 ,nb)) (lambda () (dk-nn! `(<= ,d ,d2))))
                             (sep-me `(IN ,b ,mi-mono-cls))
                             (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-LCD ,b)) (dk-contains? f 'mid1_))) "cond") `(+ ,d ,nb) `(+ ,d2 ,nb))
                             (ass)))))))))))))) e0)
  (sep-me `(IN ,e0 ,mi-mono-cls))
  (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-LCD ,e0)) (dk-contains? f 'mid1_))) "cond") d0 d20)
  (ass))
(qed 'lcd-mono)

;;; C.3 lcd-open-closes: k + 1 a closing depth of e, k one of u => k a closing depth of OPEN(e, k, u).
(define mi-oc-cls
  '(SEP mioz_ EXPR-SET (FORALL mioi_ (IMPLIES (IN mioi_ NN) (IMPLIES (IN (+ mioi_ 1) (EXPR-LCD mioz_))
     (IMPLIES (IN mioi_ (EXPR-LCD u)) (IN mioi_ (EXPR-LCD (EXPR-OPEN mioz_ mioi_ u)))))))))
(define (mi-oc-cond c) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-OPEN ,c mioi_ u)))) "the class condition"))
;; the list case, shared by APP (list l) and BIND (outside list a): goal
;; (FORALL w (IMPLIES (IN w (MAKE-SET mm)) (IN ix (EXPR-LCD w)))), mm = MAPLK(ofl, l, ix) typed;
;; DU: (FORALL w (IMPLIES (IN w (MAKE-SET l)) (IN (+ ix 1) (EXPR-LCD w)))); COMPS: the children's IH.
(define (mi-oc-list! l mm ix du comps)
  (mi-ms-each! mm
    (lambda (i w)
      (if (not (dk-asm? `(<= ,i (LENGTH ,l))))
          (dk-have! `(<= ,i (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) (LENGTH ,mm))) (ass))))
      (let* ((ent (dk-apply! (mi-entries-of mm) i)) (c `(NTH ,i ,l)) (fc `((OPEN-FUN u) ,c ,ix)))
        (dk-meta-nth-in! 'EXPR-SET i l)
        (subst `(= ,w (NTH ,i ,mm)))
        (subst ent)
        (dk-have! `(= ,fc (EXPR-OPEN ,c ,ix u))
          (lambda () (subst (dk-cite! 'open-fun-unfold 'u)) (dk-lam-b!) (fact 'open-in-expr 'u ix c) (rfl)))
        (subst `(= ,fc (EXPR-OPEN ,c ,ix u)))
        (dk-have! `(IN ,c (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! i l 'EXPR-SET)))
        (dk-apply! du c)
        (dk-apply! comps i)
        (sep-me `(IN ,c ,mi-oc-cls))
        (dk-apply! (mi-oc-cond c) ix)
        (ass)))))
(define (mi-oc-maplk! l ix)
  (dk-meta-maplk! '(OPEN-FUN u) l ix 'EXPR-SET 'EXPR-SET
    (lambda (i)
      (subst (dk-cite! 'open-fun-unfold 'u)) (dk-lam-b!) (fact 'open-in-expr 'u ix `(NTH ,i ,l)) (ass))))

(sp (make-wff '(FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET) (FORALL ix (IMPLIES (IN ix NN)
   (IMPLIES (IN (+ ix 1) (EXPR-LCD e)) (IMPLIES (IN ix (EXPR-LCD u)) (IN ix (EXPR-LCD (EXPR-OPEN e ix u)))))))))))))
(dk-peel!)
(let* ((ge (dk-goal)) (o0 (cadr (caddr ge))) (e0 (cadr o0)) (ix0 (caddr o0)))
  (dk-apply! (mi-expr-ind! mi-oc-cls
    (lambda (tag x landed)
      (dk-peel!)
      (let* ((g (dk-goal)) (ix (cadr g))
             (dm (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(EXPR-LCD ,x)))) "the depth hypothesis")))
        (case tag
          ((fvar const)
           (subst (dk-cite! (if (eq? tag 'fvar) 'open-efvar 'open-econst) 'u ix (cadr x)))
           (subst (dk-cite! (if (eq? tag 'fvar) 'lcd-efvar 'lcd-econst) (cadr x)))
           (ass))
          ((bvar)
           (let ((j (cadr x)))
             (use-em `(= ,j ,ix)
               (lambda ()
                 (subst `(= ,j ,ix))
                 (subst (dk-cite! 'open-ebvar-hit 'u ix))
                 (ass))
               (lambda ()
                 (let ((eqn (dk-cite! 'lcd-ebvar j)))
                   (sep-me (mi-rw-h! dm eqn))
                   (subst (dk-cite! 'open-ebvar-miss 'u ix j))
                   (subst eqn)
                   (in-sep! (lambda () (ass))
                     (lambda ()
                       (dk-have! '(IN 1 NN) (lambda () (arith)))
                       (dk-meta-and! `(IN ,ix NN) '(IN 1 NN))
                       (fact 'nn-add-closed ix 1)
                       (dk-cite! 'nn-lt-succ-le j `(+ ,ix 1))
                       (dk-have! `(<= ,j ,ix) (lambda () (dk-nn! `(<= (succ ,j) (+ ,ix 1)))))
                       (dk-have! `(NOT (= ,ix ,j))
                         (lambda () (di) (dk-have! `(= ,j ,ix) (lambda () (subst `(= ,ix ,j)) (rfl))) (ai `(NOT (= ,j ,ix)))))
                       (dk-cite! 'nn-le-ne-succ j ix)
                       (dk-nn! `(<= (succ ,j) ,ix)))))))))
          ((app)
           (let* ((h (cadr x)) (l (caddr x)) (eqn (dk-cite! 'lcd-eapp h l)) (comps (mi-comps-of landed l)))
             (sep-me (mi-rw-h! dm eqn))
             (let ((du (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l)) (dk-contains? f `(+ ,ix 1)))) "du")))
               (subst (dk-cite! 'open-eapp 'u ix h l))
               (let ((mm (mi-oc-maplk! l ix)))
                 (subst (dk-cite! 'lcd-eapp h mm))
                 (in-sep! (lambda () (ass)) (lambda () (mi-oc-list! l mm ix du comps)))))))
          ((bind)
           (let* ((h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
                  (eqn (dk-cite! 'lcd-ebind h nb a b)) (comps (mi-comps-of landed a)))
             (sep-me (mi-rw-h! dm eqn))
             (dk-split-all!)
             (let ((du (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,a)) (dk-contains? f `(+ ,ix 1)))) "du"))
                   (ixn `(+ ,ix ,nb)))
               (subst (dk-cite! 'open-ebind 'u ix h nb a b))
               (dk-meta-and! `(IN ,ix NN) `(IN ,nb NN))
               (fact 'nn-add-closed ix nb)
               (fact 'open-in-expr 'u ixn b)
               (let* ((mm (mi-oc-maplk! a ix)) (ob `(EXPR-OPEN ,b ,ixn u)))
                 (subst (dk-cite! 'lcd-ebind h nb mm ob))
                 (in-sep! (lambda () (ass))
                   (lambda ()
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'FORALL)
                             (mi-oc-list! a mm ix du comps)
                             (let ((hb (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(EXPR-LCD ,b)))) "the body depth")))
                               (dk-have! `(= ,(cadr hb) (+ ,ixn 1)) (lambda () (dk-nn!)))
                               (dk-rewrite-h! hb (cadr hb) `(+ ,ixn 1))
                               (dk-have! `(<= ,ix ,ixn) (lambda () (dk-nn!)))
                               (dk-cite! 'lcd-mono 'u ix ixn)
                               (sep-me `(IN ,b ,mi-oc-cls))
                               (dk-apply! (mi-oc-cond b) ixn)
                               (ass))))))))))))))) e0)
  (sep-me `(IN ,e0 ,mi-oc-cls))
  (dk-apply! (mi-oc-cond e0) ix0)
  (ass))
(qed 'lcd-open-closes)
;;; -----------------------------------------------------------------------
;;; D. A TYPING PLANNER FOR CONCRETE ENCODED EXPRESSIONS, and the OPEN calculator.
;;; mi-expr!  e      lands (IN e EXPR-SET)
;;; mi-wks!   k e    lands (IN k (EXPR-WKS e))       k = 1 (term) or 2 (formula)
;;; mi-lcd!   d e    lands (IN d (EXPR-LCD e))       d a numeral
;;; mi-cl!    e cls  lands (IN e CLF) / (IN e CLT)
;;; by recursion on the encoded constructors (unfolded to EAPP / EBIND through their unfold laws), with
;;; the leaves typed from the context (an (IN leaf CLF/CLT), an (IN leaf EXPR-SET) with a kind and a
;;; closing depth, or an EXPR-OPEN of a typed body at a typed term: wks-open, lcd-open-closes).

(sp (make-wff '(FORALL mip_ (== (ENC-SUCC mip_) (EAPP 30 (LIST mip_))))))
(dk-peel!) (mac 'enc-succ) (qrfl)
(qed 'enc-succ-unfold)
(sp (make-wff '(FORALL mip_ (== (ENC-SUCCO mip_) (EAPP 31 (LIST mip_))))))
(dk-peel!) (mac 'enc-succo) (qrfl)
(qed 'enc-succo-unfold)
(sp (make-wff '(FORALL mip_ (FORALL miq_ (== (ENC-ORDLT mip_ miq_) (EAPP 10 (LIST (ECONST 7) mip_ miq_)))))))
(dk-peel!) (mac 'enc-ordlt) (qrfl)
(qed 'enc-ordlt-unfold)
(sp (make-wff '(FORALL mip_ (== (ENC-LIMIT mip_) (EAPP 10 (LIST (ECONST 9) mip_))))))
(dk-peel!) (mac 'enc-limit) (qrfl)
(qed 'enc-limit-unfold)
(sp (make-wff '(FORALL mik_ (IMPLIES (IN mik_ NN) (= (ENC-NUM mik_) (ECONST (* 2 mik_)))))))
(dk-peel!) (mac 'enc-num) (fact 'nn-mul-closed 2 'mik_) (rfl)
(qed 'enc-num-unfold)

(define mi-unfold-laws
  (append mi-unfolds
    '((ENC-QEQ . enc-qeq-unfold) (ENC-UNION . enc-union-unfold) (ENC-INTER . enc-inter-unfold)
      (ENC-TUPLES . enc-tuples-unfold) (ENC-LIST . enc-list-unfold) (ENC-SUCC . enc-succ-unfold)
      (ENC-SUCCO . enc-succo-unfold) (ENC-ORDLT . enc-ordlt-unfold) (ENC-LIMIT . enc-limit-unfold))))
(define mi-const-laws
  '((ENC-TRUTH . enc-truth-def) (ENC-FALSITY . enc-falsity-def) (ENC-SETC . enc-setc-def)
    (ENC-NNC . enc-nnc-def) (ENC-ORDC . enc-ordc-def)
    (AX-TFI . ax-tfi-def) (AX-NN-IND . ax-nn-ind-def) (AX-MEM-SET . ax-mem-set-def)
    (AX-ZERO-NN . ax-zero-nn-def) (AX-SUCC-NN . ax-succ-nn-def)))
;; the unfold equation of an encoded constructor term, landed; #f for anything else
(define (mi-arg-def! a)
  (cond ((number? a) #t) ((and (pair? a) (eq? (car a) 'LIST)) (mi-tuple-expr! a)) (#t (mi-expr! a))))
(define (mi-unfold-eq e)
  (if (and (pair? e) (assq (car e) mi-unfold-laws)) (for-each mi-arg-def! (cdr e)))
  (mi-unfold-eq0 e))
(define (mi-unfold-eq0 e)
  (cond ((and (pair? e) (assq (car e) mi-unfold-laws))
         (apply dk-cite! (cdr (assq (car e) mi-unfold-laws)) (cdr e)))
        ((and (symbol? e) (assq e mi-const-laws)) (dk-cite! (cdr (assq e mi-const-laws))))
        ((and (pair? e) (eq? (car e) 'ENC-NUM))
         (mi-nn! (cadr e))
         (let ((eqn (dk-cite! 'enc-num-unfold (cadr e))))
           (if (number? (cadr e))
               (let ((v (* 2 (cadr e))))
                 (dk-have! `(= ,(cadr (caddr eqn)) ,v) (lambda () (arith)))
                 (dk-have! `(= ,e (ECONST ,v)) (lambda () (subst eqn) (subst `(= ,(cadr (caddr eqn)) ,v)) (rfl)))
                 `(= ,e (ECONST ,v)))
               eqn)))
        (#t #f)))
(define (mi-nn! n) (if (not (dk-asm? `(IN ,n NN))) (dk-have! `(IN ,n NN) (lambda () (arith)))))

;; (= (FN h) VAL) for a head-table functoid at a numeral head.
(define (mi-hd! fn h val true?)
  (let ((claim `(= (,fn ,h) ,val)))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (mac fn)
            (dk-if-branch! true? (cadr (dk-goal)) (lambda () (arith)) (lambda () (rfl))))))
    claim))
(define (mi-hd-val fn h)
  (case fn
    ((HD-RES) (if (<= h 10) 2 1)) ((HD-ARGK) (if (<= h 6) 2 1))
    ((HD-BRES) (if (<= h 21) 2 1)) ((HD-BODY) (if (or (= h 24) (= h 26)) 1 2))))
(define (mi-hd-true? fn h)
  (case fn
    ((HD-RES) (<= h 10)) ((HD-ARGK) (<= h 6)) ((HD-BRES) (<= h 21)) ((HD-BODY) (or (= h 24) (= h 26)))))
(define (mi-hd-eq! fn h) (mi-hd! fn h (mi-hd-val fn h) (mi-hd-true? fn h)))

;; i an index (i in NN, 1 <= i, i <= n in context, n a numeral): K! is run once per j in 1..n with
;; (= i j) in context.
(define (mi-idx-cases! i n k!)
  (let loop ((j 1))
    (if (= j n)
        (begin (dk-have! `(= ,i ,n) (lambda () (dk-nn! `(<= ,n ,i) `(<= ,i ,n)))) (k! n))
        (use-em `(= ,i ,j)
          (lambda () (k! j))
          (lambda ()
            (mi-nn! j)
            (dk-cite! 'nn-le-ne-succ j i)
            (dk-have! `(<= ,(+ j 1) ,i) (lambda () (dk-nn! `(<= (succ ,j) ,i))))
            (loop (+ j 1)))))))
;; on a goal (FORALL w (IMPLIES (IN w (MAKE-SET l)) P[w])), l a literal list: HANDLER e is run per
;; entry e of l on a leaf whose goal is P[e].
(define (mi-ms-cases! l handler)
  (dk-peel!)
  (let* ((g (dk-goal)) (wv (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(MAKE-SET ,l)))) (dk-asms)))
         (w (cadr wv)) (n (- (length l) 1)))
    (cond
      ((= n 0) (error "mi-ms-cases!: the empty list (use mi-ms-empty!)"))
      ((= n 1)
       (let ((e1 (cadr l)))
         (dk-cite! 'ms1-cases e1 w)
         (subst `(= ,w ,e1))
         (handler e1)))
      ((= n 2)
       (let ((o (dk-cite! 'ms2-cases (cadr l) (caddr l) w)))
         (dk-meta-or-each! o (lambda (d) (subst d) (handler (caddr d))))))
      (#t
        (let ((i (mi-makeset-index! w l)))
          (dk-have! `(= (LENGTH ,l) ,n) (lambda () (len-r) (rfl)))
          (dk-rewrite-h! `(<= ,i (LENGTH ,l)) `(LENGTH ,l) n)
          (mi-idx-cases! i n
            (lambda (j)
              (let* ((h1 (dk-rewrite-h! `(= (NTH ,i ,l) ,w) i j))
                     (h2 (dk-nth-h! h1))
                     (ej (cadr h2)))
                (subst `(= ,w ,ej))
                (handler ej)))))))))
;; a vacuous universal over the elements of the empty list
(define (mi-ms-empty!)
  (dk-peel!)
  (let ((wv (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(MAKE-SET (LIST))))) (dk-asms))))
    (if (not (dk-asm? '(= (MAKE-SET (LIST)) EMPTY-SET))) (fact 'make-set-empty))
    (dk-rewrite-h! wv '(MAKE-SET (LIST)) 'EMPTY-SET)
    (fact 'empty-set-has-no-members (cadr wv))
    (ai `(NOT (IN ,(cadr wv) EMPTY-SET)))))

;; finish a lane whose goal the last step landed (detach! lands it on a new node and moves there)
(define (mi-lane-close!)
  (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
;; Run THUNK, then cut the context back by ONE `keep' to what it held before plus the formulas KEEP
;; (the typing planner lands dozens of intermediate facts; the rule checkers compare contexts as sets,
;; so every later step would pay for them).
(define (mi-scoped! thunk keep-fs)
  (let ((base (dk-asms)))
    (thunk)
    (let* ((now (dk-asms))
           (keepers (filter (lambda (f) (member f now)) (append base (filter (lambda (f) (not (member f base))) keep-fs)))))
      (if (< (length keepers) (length now)) (apply keep keepers)))))

;; leaf facts from a CLF / CLT membership in context
(define (mi-cl-facts! e)
  (let ((cls (cond ((dk-asm? `(IN ,e CLF)) 'CLF) ((dk-asm? `(IN ,e CLT)) 'CLT) (#t #f))))
    (and cls
         (let ((k (if (eq? cls 'CLF) 2 1)))
           (if (not (and (dk-asm? `(IN ,e EXPR-SET)) (dk-asm? `(IN ,k (EXPR-WKS ,e))) (dk-asm? `(IN 0 (EXPR-LCD ,e)))))
               (begin
                 (dk-split! (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e)))
                 (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'wf-fml 'wf-term) e))
                 (dk-meta-iff-r! (dk-meta-iff! 'expr-lc e))))
           k))))

(define (mi-unfold-eq-able? e)
  (or (and (pair? e) (or (assq (car e) mi-unfold-laws) (eq? (car e) 'ENC-NUM))) (and (symbol? e) (assq e mi-const-laws))))
;; transfer a membership (IN x (F e)) through the unfold equation of e: THUNK lands it for the unfolded
(define (mi-via-unfold! fact-of e thunk)
  (let* ((eqn (mi-unfold-eq e)) (u (caddr eqn)))
    (thunk u)
    (dk-have! (fact-of e) (lambda () (subst eqn) (ass)))))

(define (mi-expr! e)
  (cond
    ((dk-asm? `(IN ,e EXPR-SET)) #t)
    ((mi-cl-facts! e) #t)
    ((and (pair? e) (eq? (car e) 'EXPR-OPEN))
     (mi-expr! (cadr e)) (mi-expr! (cadddr e)) (mi-nn! (caddr e))
     (fact 'open-in-expr (cadddr e) (caddr e) (cadr e)))
    ((mi-unfold-eq-able? e) (mi-via-unfold! (lambda (x) `(IN ,x EXPR-SET)) e mi-expr!))
    ((and (pair? e) (eq? (car e) 'EAPP))
     (mi-nn! (cadr e)) (mi-tuple-expr! (caddr e)) (fact 'eapp-in-expr (cadr e) (caddr e)))
    ((and (pair? e) (eq? (car e) 'EBIND))
     (mi-nn! (cadr e)) (mi-nn! (caddr e)) (mi-tuple-expr! (cadddr e)) (mi-expr! (car (cddddr e)))
     (apply fact 'ebind-in-expr (cdr e)))
    ((and (pair? e) (memq (car e) '(EBVAR EFVAR ECONST)))
     (mi-nn! (cadr e))
     (fact (cdr (assq (car e) '((EBVAR . ebvar-in-expr) (EFVAR . efvar-in-expr) (ECONST . econst-in-expr)))) (cadr e)))
    (#t (error "mi-expr!: cannot type as an expression" (expression->string e)))))
(define (mi-tuple-expr! l)
  (if (not (dk-asm? `(IN ,l (TUPLES EXPR-SET))))
      (begin
        (for-each mi-expr! (cdr l))
        (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti))))))))

(define (mi-wks! k e)
  (cond
    ((dk-asm? `(IN ,k (EXPR-WKS ,e))) #t)
    ((mi-cl-facts! e) (if (not (dk-asm? `(IN ,k (EXPR-WKS ,e)))) (error "mi-wks!: the leaf has the other kind" (expression->string e) k)))
    ((and (pair? e) (eq? (car e) 'EXPR-OPEN))
     (let ((b (cadr e)) (j (caddr e)) (u (cadddr e)))
       (mi-expr! e) (mi-expr! u) (mi-expr! b) (mi-wks! 1 u) (mi-wks! k b)
       (dk-cite! 'wks-single u)
       (let ((eqn (dk-cite! 'wks-open u b j)))
         (dk-have! `(IN ,k (EXPR-WKS ,e)) (lambda () (subst eqn) (ass))))))
    ((mi-unfold-eq-able? e) (mi-expr! e) (mi-via-unfold! (lambda (x) `(IN ,k (EXPR-WKS ,x))) e (lambda (u) (mi-wks! k u))))
    ((and (pair? e) (memq (car e) '(EBVAR EFVAR ECONST)))
     (mi-nn! (cadr e))
     (let ((eqn (dk-cite! (cdr (assq (car e) '((EBVAR . wks-ebvar) (EFVAR . wks-efvar) (ECONST . wks-econst)))) (cadr e))))
       (dk-have! `(IN 1 (EXPR-WKS ,e))
         (lambda () (subst eqn) (let ((iff (dk-apply! (mi-pair11!) 1)))
                                  (dk-have! '(OR (= 1 1) (= 1 1)) (lambda () (oi-l) (rfl)))
                                  (dk-meta-iff-l! iff) (ass))))))
    ((and (pair? e) (eq? (car e) 'EAPP))
     (let* ((h (cadr e)) (l (caddr e)) (argk (mi-hd-val 'HD-ARGK h)))
       (mi-expr! e) (mi-nn! h) (mi-tuple-expr! l)
       (for-each (lambda (a) (mi-wks! argk a)) (cdr l))
       (let ((eqn (dk-cite! 'wks-eapp h l)))
         (dk-have! `(IN ,k (EXPR-WKS ,e))
           (lambda ()
             (subst eqn)
             (mi-nn! k)
             (in-sep! (lambda () (ass))
               (lambda ()
                 (mi-hd-eq! 'HD-RES h) (mi-hd-eq! 'HD-ARGK h)
                 (dk-conj-close!
                   (lambda ()
                     (let ((g (dk-goal)))
                       (cond
                         ((dk-head-is? g '=) (subst (mi-hd-eq! 'HD-RES h)) (rfl))
                         ((dk-head-is? g 'APP-AR-OK) (mi-ar! h (- (length l) 1)))
                         (#t (if (null? (cdr l)) (mi-ms-empty!)
                                 (mi-ms-cases! l (lambda (a) (subst (mi-hd-eq! 'HD-ARGK h)) (ass))))))))))))))))
    ((and (pair? e) (eq? (car e) 'EBIND))
     (let* ((h (cadr e)) (nb (caddr e)) (oa (cadddr e)) (b (car (cddddr e))) (bk (mi-hd-val 'HD-BODY h)))
       (mi-expr! e) (mi-nn! h) (mi-nn! nb) (mi-tuple-expr! oa)
       (for-each (lambda (a) (mi-wks! 1 a)) (cdr oa))
       (mi-wks! bk b)
       (let ((eqn (dk-cite! 'wks-ebind h nb oa b)))
         (dk-have! `(IN ,k (EXPR-WKS ,e))
           (lambda ()
             (subst eqn)
             (mi-nn! k)
             (in-sep! (lambda () (ass))
               (lambda ()
                 (mi-hd-eq! 'HD-BRES h) (mi-hd-eq! 'HD-BODY h)
                 (dk-conj-close!
                   (lambda ()
                     (let ((g (dk-goal)))
                       (cond
                         ((dk-head-is? g '=) (subst (mi-hd-eq! 'HD-BRES h)) (rfl))
                         ((dk-head-is? g 'BIND-SIG) (mi-sig! h nb (- (length oa) 1)))
                         ((dk-head-is? g 'FORALL) (if (null? (cdr oa)) (mi-ms-empty!) (mi-ms-cases! oa (lambda (a) (ass)))))
                         (#t (subst (mi-hd-eq! 'HD-BODY h)) (ass)))))))))))))
    (#t (error "mi-wks!: cannot compute the kind" (expression->string e) k))))

;; A ground formula over numerals (=, <=, <, AND, OR, NOT), decided in Scheme and driven: the true
;; disjunct is picked, conjunctions split, atoms closed by arith.
(define (mi-geval f)
  (cond ((number? f) f)
        ((not (pair? f)) (error "mi-geval: not ground" f))
        ((eq? (car f) '=) (= (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) '<=) (<= (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) '<) (< (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) '+) (+ (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) '*) (* (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) 'AND) (and (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) 'OR) (or (mi-geval (cadr f)) (mi-geval (caddr f))))
        ((eq? (car f) 'NOT) (not (mi-geval (cadr f))))
        (#t (error "mi-geval: not ground" f))))
(define (mi-ground!)
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'AND) (dk-conj-close! mi-ground!))
          ((dk-head-is? g 'OR) (if (mi-geval (cadr g)) (begin (oi-l) (mi-ground!)) (begin (oi-r) (mi-ground!))))
          (#t (arith)))))
(define (mi-ar! h n) (if (dk-contains? (dk-goal) 'LENGTH) (len-r)) (mac 'APP-AR-OK) (mi-ground!))
(define (mi-sig! h nb n) (if (dk-contains? (dk-goal) 'LENGTH) (len-r)) (mac 'BIND-SIG) (mi-ground!))

;; the numeral value of (+ a b) for numerals, with the equation landed; else the term
(define (mi-plus a b)
  (if (and (number? a) (number? b))
      (let ((v (+ a b)))
        (if (not (dk-asm? `(= (+ ,a ,b) ,v))) (dk-have! `(= (+ ,a ,b) ,v) (lambda () (arith))))
        v)
      `(+ ,a ,b)))

(define (mi-lcd! d e)
  (define (known-depth)
    (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-LCD) (equal? (cadr (caddr f)) e)
                                 (number? (cadr f)) (number? d) (<= (cadr f) d)))
                (dk-asms)))
  (cond
    ((dk-asm? `(IN ,d (EXPR-LCD ,e))) #t)
    ((known-depth) => (lambda (f) (mi-expr! e) (mi-nn! d) (mi-nn! (cadr f))
                         (dk-have! `(<= ,(cadr f) ,d) (lambda () (arith)))
                         (dk-cite! 'lcd-mono e (cadr f) d)))
    ((mi-cl-facts! e) (mi-lcd! d e))
    ((and (pair? e) (eq? (car e) 'EXPR-OPEN) (number? (caddr e)) (number? d) (>= d (caddr e)))
     (let* ((b (cadr e)) (j (caddr e)) (u (cadddr e)) (j1 (+ j 1)))
       (mi-expr! b) (mi-expr! u) (mi-nn! j)
       (mi-lcd! j1 b) (mi-lcd! j u)
       (mi-plus j 1)
       (dk-have! `(IN (+ ,j 1) (EXPR-LCD ,b)) (lambda () (subst `(= (+ ,j 1) ,j1)) (ass)))
       (dk-cite! 'lcd-open-closes u b j)
       (if (> d j) (mi-lcd! d e))))
    ((mi-unfold-eq-able? e) (mi-expr! e) (mi-via-unfold! (lambda (x) `(IN ,d (EXPR-LCD ,x))) e (lambda (u) (mi-lcd! d u))))
    ((and (pair? e) (memq (car e) '(EFVAR ECONST)))
     (mi-nn! (cadr e)) (mi-nn! d)
     (let ((eqn (dk-cite! (if (eq? (car e) 'EFVAR) 'lcd-efvar 'lcd-econst) (cadr e))))
       (dk-have! `(IN ,d (EXPR-LCD ,e)) (lambda () (subst eqn) (ass)))))
    ((and (pair? e) (eq? (car e) 'EBVAR))
     (mi-nn! (cadr e)) (mi-nn! d)
     (let ((eqn (dk-cite! 'lcd-ebvar (cadr e))))
       (dk-have! `(IN ,d (EXPR-LCD ,e)) (lambda () (subst eqn) (in-sep! (lambda () (ass)) (lambda () (arith)))))))
    ((and (pair? e) (eq? (car e) 'EAPP))
     (let ((h (cadr e)) (l (caddr e)))
       (mi-expr! e) (mi-nn! h) (mi-nn! d) (mi-tuple-expr! l)
       (for-each (lambda (a) (mi-lcd! d a)) (cdr l))
       (let ((eqn (dk-cite! 'lcd-eapp h l)))
         (dk-have! `(IN ,d (EXPR-LCD ,e))
           (lambda ()
             (subst eqn)
             (in-sep! (lambda () (ass))
               (lambda () (if (null? (cdr l)) (mi-ms-empty!) (mi-ms-cases! l (lambda (a) (ass)))))))))))
    ((and (pair? e) (eq? (car e) 'EBIND))
     (let* ((h (cadr e)) (nb (caddr e)) (oa (cadddr e)) (b (car (cddddr e))) (dn (mi-plus d nb)))
       (mi-expr! e) (mi-nn! h) (mi-nn! nb) (mi-nn! d) (mi-tuple-expr! oa)
       (for-each (lambda (a) (mi-lcd! d a)) (cdr oa))
       (mi-lcd! dn b)
       (let ((eqn (dk-cite! 'lcd-ebind h nb oa b)))
         (dk-have! `(IN ,d (EXPR-LCD ,e))
           (lambda ()
             (subst eqn)
             (in-sep! (lambda () (ass))
               (lambda ()
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) 'FORALL)
                         (if (null? (cdr oa)) (mi-ms-empty!) (mi-ms-cases! oa (lambda (a) (ass))))
                         (begin (if (number? dn) (subst `(= (+ ,d ,nb) ,dn))) (ass))))))))))))
    (#t (error "mi-lcd!: cannot compute a closing depth" (expression->string e) d))))

(define (mi-cl! e cls)
  (if (not (dk-asm? `(IN ,e ,cls)))
      (dk-have! `(IN ,e ,cls) (lambda () (mi-cl0! e cls) (mi-lane-close!))))
  `(IN ,e ,cls))
(define (mi-cl0! e cls)
  (if (not (dk-asm? `(IN ,e ,cls)))
      (let ((k (if (eq? cls 'CLF) 2 1)))
        (mi-expr! e) (mi-wks! k e) (mi-lcd! 0 e)
        (dk-meta-iff-l! (dk-meta-iff! (if (eq? cls 'CLF) 'wf-fml 'wf-term) e))
        (dk-meta-iff-l! (dk-meta-iff! 'expr-lc e))
        (dk-meta-and! `(IN ,e EXPR-SET) (if (eq? cls 'CLF) `(WF-FML ,e) `(WF-TERM ,e)) `(EXPR-LC ,e))
        (dk-meta-iff-l! (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e))))
  `(IN ,e ,cls))

;;; Inversion: from the three facts of a compound (EXPR-SET, a kind, a closing depth -- as landed by
;;; mi-cl-facts! for a CLF / CLT member), the facts of a part.
;; the body (and the outside arguments) of an encoded binder B with (IN B EXPR-SET), (IN k (EXPR-WKS B)),
;; (IN d (EXPR-LCD B)) in context: lands (IN b EXPR-SET), (IN bodyk (EXPR-WKS b)), (IN d+1 (EXPR-LCD b)).
(define (mi-inv-body! bt k d)
  (let* ((eqn (mi-unfold-eq0 bt)) (eb (caddr eqn))
         (h (cadr eb)) (nb (caddr eb)) (oa (cadddr eb)) (b (car (cddddr eb))) (bk (mi-hd-val 'HD-BODY h)))
    (mi-rw-h! `(IN ,bt EXPR-SET) eqn)
    (mi-rw-h! `(IN ,k (EXPR-WKS ,bt)) eqn)
    (mi-rw-h! `(IN ,d (EXPR-LCD ,bt)) eqn)
    (dk-cite! 'ebind-body-expr h nb oa b)
    (if (null? (cdr oa)) (mi-tuple-expr! oa) (dk-cite! 'ebind-args-expr h nb oa b))
    (mi-nn! h) (mi-nn! nb)
    (let ((w (mi-rw-h! `(IN ,k (EXPR-WKS ,eb)) (dk-cite! 'wks-ebind h nb oa b))))
      (sep-me w) (dk-split-all!)
      (mi-hd-eq! 'HD-BODY h)
      (dk-rewrite-h! `(IN (HD-BODY ,h) (EXPR-WKS ,b)) `(HD-BODY ,h) bk))
    (let ((w (mi-rw-h! `(IN ,d (EXPR-LCD ,eb)) (dk-cite! 'lcd-ebind h nb oa b))))
      (sep-me w) (dk-split-all!)
      (let ((v (mi-plus d nb)))
        (if (number? v) (dk-rewrite-h! `(IN (+ ,d ,nb) (EXPR-LCD ,b)) `(+ ,d ,nb) v))))
    ;; the outside arguments: kind 1, depth d
    (let loop ((as (cdr oa)) (i 1))
      (if (pair? as)
          (let ((c (car as)))
            (mi-nn! i)
            (dk-have! `(<= 1 ,i) (lambda () (arith)))
            (dk-have! `(<= ,i (LENGTH ,oa)) (lambda () (len-r) (arith)))
            (dk-have! `(IN (NTH ,i ,oa) (MAKE-SET ,oa)) (lambda () (dk-meta-in-makeset! i oa 'EXPR-SET)))
            (dk-nth-h! `(IN (NTH ,i ,oa) (MAKE-SET ,oa)))
            (for-each (lambda (u) (dk-apply! u c))
                      (filter (lambda (f) (and (dk-head-is? f 'FORALL) (dk-head-is? (caddr f) 'IMPLIES)
                                               (equal? (cadr (caddr f)) `(IN ,(cadr f) (MAKE-SET ,oa)))))
                              (dk-asms)))
            (loop (cdr as) (+ i 1)))))
    b))
;; the I-th argument (1-based) of an encoded application A (ENC-H args, unfolded to EAPP h l) with the
;; three facts of A in context: lands the argument's three facts (kind HD-ARGK(h), depth d).
(define (mi-inv-arg! at i k d)
  (let* ((eqn (mi-unfold-eq0 at)) (ea (caddr eqn)) (h (cadr ea)) (l (caddr ea)) (c (list-ref l i)))
    (mi-rw-h! `(IN ,at EXPR-SET) eqn)
    (mi-rw-h! `(IN ,k (EXPR-WKS ,at)) eqn)
    (mi-rw-h! `(IN ,d (EXPR-LCD ,at)) eqn)
    (dk-split! (dk-cite! 'eapp-expr-inv h l))
    (mi-nn! i)
    (dk-have! `(<= 1 ,i) (lambda () (arith)))
    (dk-have! `(<= ,i (LENGTH ,l)) (lambda () (len-r) (arith)))
    (dk-meta-nth-in! 'EXPR-SET i l)
    (dk-nth-h! `(IN (NTH ,i ,l) EXPR-SET))
    (dk-have! `(IN (NTH ,i ,l) (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! i l 'EXPR-SET)))
    (dk-nth-h! `(IN (NTH ,i ,l) (MAKE-SET ,l)))
    (let ((w (mi-rw-h! `(IN ,k (EXPR-WKS ,ea)) (dk-cite! 'wks-eapp h l))))
      (sep-me w) (dk-split-all!)
      (let ((u (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l)) (dk-contains? f 'HD-ARGK))) "the argument kinds")))
        (dk-apply! u c)
        (dk-rewrite-h! `(IN (HD-ARGK ,h) (EXPR-WKS ,c)) `(HD-ARGK ,h) (caddr (mi-hd-eq! 'HD-ARGK h)))))
    (let ((w (mi-rw-h! `(IN ,d (EXPR-LCD ,ea)) (dk-cite! 'lcd-eapp h l))))
      (sep-me w)
      (let ((u (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l)) (dk-contains? f 'EXPR-LCD))) "the argument depths")))
        (dk-apply! u c)))
    c))

;; the outside arguments of a binder node are expressions
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN (EBIND h nb a b) (EXPR-STAGE n)) (IN a (TUPLES EXPR-SET)))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (let* ((landed (dk-peel!))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-STAGE))) landed))
         (x (cadr mem)))
    (dk-meta-or-each! (dk-cite! 'expr-stage-zero-cases x)
      (lambda (d) (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x)))))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "no IH")))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-STAGE))) landed))
         (x (cadr mem)) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
         (n (cadr (cadr (caddr mem)))))
    (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases n x)
      (lambda (d)
        (cond
          ((dk-head-is? d 'IN) (dk-apply! ih h nb a b) (ass))
          ((eq? (dk-meta-disjunct-kind d) 'EBIND)
           (let* ((vs (dk-meta-unpack! d)) (a2 (caddr vs)))
             (dk-split! (dk-cite! 'ebind-injective h nb a b (car vs) (cadr vs) a2 (cadddr vs)))
             (dk-meta-lift-to-expr! a2 n)
             (subst `(= ,a ,a2))
             (ass)))
          (#t (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x))))))))
(qed 'ebind-args-stage)
(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b (IMPLIES (IN (EBIND h nb a b) EXPR-SET) (IN a (TUPLES EXPR-SET)))))))))
(dk-peel!)
(let ((n (dk-meta-set-open! '(EBIND h nb a b))))
  (dk-apply! (dk-cite! 'ebind-args-stage n) 'h 'nb 'a 'b)
  (ass))
(qed 'ebind-args-expr)

;;; D.2 A planner test: the comprehension of the body of a universal sentence is a closed term.
(sp (make-wff '(FORALL q (FORALL p (IMPLIES (IN (ENC-ALL (ENC-IMP q p)) CLF) (IN (ENC-COMP p) CLT))))))
(dk-peel!)
(mi-cl-facts! '(ENC-ALL (ENC-IMP q p)))
(mi-inv-body! '(ENC-ALL (ENC-IMP q p)) 2 0)
(mi-inv-arg! '(ENC-IMP q p) 2 2 1)
(mi-cl! '(ENC-COMP p) 'CLT)
(ass)
(qed 'comp-of-body-clt)
;;; D.3 The OPEN calculator.  open-app1 / open-app3 (open-app2 is META-3's), MAPLK of the empty list,
;;; and mi-open!: the value of (EXPR-OPEN e k u) for a concrete encoded e, k a numeral.

(define (mi-open-app-stmt n)
  (let* ((vs (list-head '(oa1 oa2 oa3) n))
         (body `(= (EXPR-OPEN (EAPP h (LIST ,@vs)) k u) (EAPP h (LIST ,@(map (lambda (a) `(EXPR-OPEN ,a k u)) vs)))))
         (imps (fold-right (lambda (a b) `(IMPLIES (IN ,a EXPR-SET) ,b)) body vs))
         (imps2 `(IMPLIES (IN u EXPR-SET) (IMPLIES (IN k NN) (IMPLIES (IN h NN) ,imps)))))
    (fold-right (lambda (v b) `(FORALL ,v ,b)) imps2 (append '(u k h) vs))))
(define (mi-open-app-proof! n)
  (dk-peel!)
  (let* ((vs (list-head '(oa1 oa2 oa3) n))
         (l `(LIST ,@vs)) (r `(LIST ,@(map (lambda (a) `(EXPR-OPEN ,a k u)) vs))))
    (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (for-each (lambda (a) (fact 'open-in-expr 'u 'k a)) vs)
    (dk-have! `(IN ,r (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'eapp-in-expr 'h r)
    (subst (dk-cite! 'open-eapp 'u 'k 'h l))
    (let* ((mm (dk-meta-maplk! '(OPEN-FUN u) l 'k 'EXPR-SET 'EXPR-SET
                 (lambda (i) (subst (dk-cite! 'open-fun-unfold 'u)) (dk-lam-b!) (fact 'open-in-expr 'u 'k `(NTH ,i ,l)) (ass))))
           (ents (mi-entries-of mm)))
      (dk-have! `(= (LENGTH ,l) ,n) (lambda () (len-r) (rfl)))
      (dk-have! `(= (LENGTH ,mm) (LENGTH ,r)) (lambda () (subst `(= (LENGTH ,mm) (LENGTH ,l))) (len-r) (rfl)))
      (dk-have! `(FORALL miok_ (IMPLIES (AND (IN miok_ NN) (AND (<= 1 miok_) (<= miok_ (LENGTH ,mm))))
                                        (= (NTH miok_ ,mm) (NTH miok_ ,r))))
        (lambda ()
          (dk-peel!)
          (dk-split-all!)
          (let* ((i (cadr (cadr (dk-goal)))))
            (dk-have! `(<= ,i ,n) (lambda () (subst `(= ,n (LENGTH ,l))) (subst `(= (LENGTH ,l) (LENGTH ,mm))) (ass)))
            (dk-have! `(<= ,i (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) ,n)) (ass)))
            (subst (dk-apply! ents i))
            (mi-idx-cases! i n
              (lambda (j)
                (subst `(= ,i ,j))
                (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
                (let ((c (list-ref l j)))
                  (subst (dk-cite! 'open-fun-unfold 'u)) (dk-lam-b!) (fact 'open-in-expr 'u 'k c) (rfl)))))))
      (dk-cite! 'tuple-extensionality 'EXPR-SET mm r)
      (subst `(= ,mm ,r))
      (rfl))))
(sp (make-wff (mi-open-app-stmt 1))) (mi-open-app-proof! 1) (qed 'open-app1)
(sp (make-wff (mi-open-app-stmt 3))) (mi-open-app-proof! 3) (qed 'open-app3)

(sp (make-wff '(FORALL u (FORALL k (IMPLIES (IN u EXPR-SET) (IMPLIES (IN k NN) (= (MAPLK (OPEN-FUN u) (LIST) k) (LIST))))))))
(dk-peel!)
(let* ((l '(LIST)) (mm `(MAPLK (OPEN-FUN u) ,l k))
       (vac (lambda (i)
              (fact 'length-of-empty)
              (dk-rewrite-h! `(<= ,i (LENGTH (LIST))) '(LENGTH (LIST)) 0)
              (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,i) `(<= ,i 0))))
              (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
              (ai '(NOT (<= 1 0))))))
  (dk-have! '(IN (LENGTH (LIST)) NN) (lambda () (fact 'length-of-empty) (subst '(= (LENGTH (LIST)) 0)) (arith)))
  (dk-have! `(FORALL miq_ (IMPLIES (IN miq_ NN) (IMPLIES (<= 1 miq_) (IMPLIES (<= miq_ (LENGTH (LIST)))
                (IN ((OPEN-FUN u) (NTH miq_ (LIST)) k) EXPR-SET)))))
    (lambda () (let ((landed (dk-peel!))) (vac (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))))
  (dk-split-all! (list (dk-cite! 'maplk-prop 'EXPR-SET '(OPEN-FUN u) l 'k)))
  (dk-have! `(IN (LIST) (TUPLES EXPR-SET)) (lambda () (ti)))
  (dk-have! `(FORALL miok_ (IMPLIES (AND (IN miok_ NN) (AND (<= 1 miok_) (<= miok_ (LENGTH ,mm))))
                                    (= (NTH miok_ ,mm) (NTH miok_ (LIST)))))
    (lambda ()
      (dk-peel!) (dk-split-all!)
      (let ((i (cadr (cadr (dk-goal)))))
        (dk-rewrite-h! `(<= ,i (LENGTH ,mm)) `(LENGTH ,mm) '(LENGTH (LIST)))
        (vac i))))
  (dk-cite! 'tuple-extensionality 'EXPR-SET mm l)
  (ass))
(qed 'maplk-nil)

;; The least closing depth of a concrete encoded e, read in Scheme from its shape and the context
;; (#f when unknown).
(define (mi-ctx-depth e)
  (if (or (dk-asm? `(IN ,e CLF)) (dk-asm? `(IN ,e CLT)))
      0
      (let ((ds (filter-map (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-LCD)
                                             (equal? (cadr (caddr f)) e) (number? (cadr f)) (cadr f)))
                            (dk-asms))))
        (and (pair? ds) (apply min ds)))))
(define (mi-dmax . ds) (and (every (lambda (d) d) ds) (apply max 0 ds)))
(define mi-binder-heads '((ENC-ALL . 0) (ENC-EX . 0) (ENC-COMP . 0) (ENC-IOTA . 0) (ENC-SEP . 1) (ENC-BU . 1) (ENC-LAM . 1)))
(define (mi-sdepth e)
  (let ((c (and (pair? e) (mi-ctx-depth e))) (s (mi-sdepth0 e)))
    (cond ((and c s) (min c s)) (c c) (#t s))))
(define (mi-sdepth0 e)
  (cond
    ((number? e) 0)
    ((symbol? e) (if (assq e mi-const-laws) 0 (mi-ctx-depth e)))
    ((not (pair? e)) #f)
    ((eq? (car e) 'EBVAR) (and (number? (cadr e)) (+ (cadr e) 1)))
    ((memq (car e) '(EFVAR ECONST ENC-NUM)) 0)
    ((eq? (car e) 'EXPR-OPEN)
     (let ((db (mi-sdepth (cadr e))) (j (caddr e)) (du (mi-sdepth (cadddr e))))
       (and db du (number? j) (<= db (+ j 1)) (<= du j) j)))
    ((eq? (car e) 'EAPP) (apply mi-dmax (map mi-sdepth (cdr (caddr e)))))
    ((eq? (car e) 'EBIND)
     (let ((db (mi-sdepth (car (cddddr e)))))
       (apply mi-dmax (and db (max 0 (- db (caddr e)))) (map mi-sdepth (cdr (cadddr e))))))
    ((assq (car e) mi-binder-heads)
     (let ((db (mi-sdepth (car (last-pair e)))))
       (apply mi-dmax (and db (max 0 (- db 1))) (map mi-sdepth (list-head (cdr e) (cdr (assq (car e) mi-binder-heads)))))))
    ((memq (car e) '(ENC-UNION ENC-INTER ENC-CART ENC-LIST))
     (let ((l (cadr e))) (and (pair? l) (eq? (car l) 'LIST) (apply mi-dmax (map mi-sdepth (cdr l))))))
    ((assq (car e) mi-unfold-laws) (apply mi-dmax (map mi-sdepth (cdr e))))
    (#t #f)))

;; (= (EXPR-OPEN e k u) v) landed (strict or quasi), v returned; v = (EXPR-OPEN e k u) when nothing
;; applies (no equation).  u must be an expression in context, closed (a CLT member or LCD 0).
(define mi-app-heads '((1 . open-app1) (2 . open-app2) (3 . open-app3)))
;; the value alone, computed in Scheme by the same rules
(define (mi-open-val e k u)
  (let ((d (mi-sdepth e)))
    (cond
      ((and d (<= d k)) e)
      ((and (pair? e) (eq? (car e) 'EBVAR) (equal? (cadr e) k)) u)
      ((and (pair? e) (assq (car e) mi-binder-heads) (= 0 (cdr (assq (car e) mi-binder-heads))))
       (list (car e) (mi-open-val (cadr e) (+ k 1) u)))
      ((and (pair? e) (assq (car e) mi-unfold-laws) (not (assq (car e) mi-binder-heads)))
       (cons (car e) (map (lambda (p) (mi-open-val p k u)) (cdr e))))
      (#t `(EXPR-OPEN ,e ,k ,u)))))
;; (= (EXPR-OPEN e k u) v) proved in a lane, v returned (no equation when nothing changes)
(define (mi-open! e k u)
  (let ((v (mi-open-val e k u)) (orig `(EXPR-OPEN ,e ,k ,u)))
    (cond ((equal? v orig) orig)
          ((dk-asm? `(= ,orig ,v)) v)
          (#t (dk-have! `(= ,orig ,v)
                (lambda ()
                  (mi-open0! e k u)
                  (if (and (pair? (dk-open-leaves)) (equal? (dk-goal) `(= ,orig ,v)))
                      (if (dk-asm? `(= ,orig ,v)) (ass) (begin (mi-expr! v) (subst `(= ,orig ,v)) (rfl))))))
              v))))
(define (mi-open0! e k u)
  (let ((d (mi-sdepth e)) (orig `(EXPR-OPEN ,e ,k ,u)))
    (mi-nn! k) (mi-expr! u)
    (cond
      ((and d (<= d k))
       (mi-expr! e) (mi-lcd! d e) (mi-nn! d)
       (dk-have! `(<= ,d ,k) (lambda () (arith)))
       (dk-cite! 'lcd-open u e k d)
       e)
      ((and (pair? e) (eq? (car e) 'EBVAR) (equal? (cadr e) k))
       (dk-cite! 'open-ebvar-hit u k) u)
      ((and (pair? e) (assq (car e) mi-binder-heads) (= 0 (cdr (assq (car e) mi-binder-heads))))
       (let* ((b (cadr e)) (eqn (mi-unfold-eq e)) (eb (caddr eqn)) (h (cadr eb)) (k1 (mi-plus k 1)))
         (mi-expr! e) (mi-expr! b) (mi-nn! h) (mi-nn! 1) (mi-tuple-expr! '(LIST))
         (let* ((e1 (dk-cite! 'open-ebind u k h 1 '(LIST) b))
                (e2 (dk-cite! 'maplk-nil u k))
                (vb (mi-open! b k1 u))
                (v `(,(car e) ,vb)))
           (mi-expr! v)
           (let ((ev (mi-unfold-eq v)))
             (dk-have! `(= ,orig ,v)
               (lambda ()
                 (subst eqn) (subst e1) (subst e2) (subst `(= (+ ,k 1) ,k1))
                 (if (not (equal? vb `(EXPR-OPEN ,b ,k1 ,u))) (subst `(= (EXPR-OPEN ,b ,k1 ,u) ,vb)))
                 (subst ev)
                 (rfl))))
           v)))
      ((and (pair? e) (assq (car e) mi-unfold-laws) (not (assq (car e) mi-binder-heads)))
       (let* ((eqn (mi-unfold-eq e)) (ea (caddr eqn)) (h (cadr ea)) (l (caddr ea)) (args (cdr l))
              (law (cdr (assq (length args) mi-app-heads))))
         (mi-expr! e) (mi-nn! h) (for-each mi-expr! args)
         (let* ((e1 (apply dk-cite! law u k h args))
                (vs (map (lambda (a) (mi-open! a k u)) args))
                (vl (map (lambda (a v) (if (equal? v `(EXPR-OPEN ,a ,k ,u)) v v)) args vs))
                ;; the opened node, refolded: the encoded head over the opened arguments that are its own
                (v (mi-refold e args vs)))
           (mi-expr! v)
           (let ((ev (mi-unfold-eq v)))
             (dk-have! `(= ,orig ,v)
               (lambda ()
                 (subst eqn) (subst e1)
                 (for-each (lambda (a w) (if (not (equal? w `(EXPR-OPEN ,a ,k ,u))) (subst `(= (EXPR-OPEN ,a ,k ,u) ,w)))) args vs)
                 (subst ev)
                 (rfl))))
           v)))
      (#t orig))))
;; the encoded term e = (ENC-H x ..), whose unfolded argument list is ARGS, with the opened arguments VS:
;; the ENC-H term over the parameters of e that are arguments, replaced by their opened values
(define (mi-refold e args vs)
  (cons (car e) (map (lambda (p) (let loop ((as args) (ws vs)) (cond ((null? as) p) ((equal? (car as) p) (car ws)) (#t (loop (cdr as) (cdr ws)))))) (cdr e))))

;;; -----------------------------------------------------------------------
;;; E. DERIVED RULES FOR THE INDUCTIONS: comprehension membership in and out, sethood of a name.

(define (mi-der g f) `(IN (LIST ,g ,f) (DERIVABLE tt)))
;; every formula of a dk-derive! tree (goals and the formulas the contexts add), typed CLF by the planner
(define (mi-tree-forms t)
  (if (and (pair? t) (pair? (cdr t)) (list? (cadr t)) (= (length (cadr t)) 3) (eq? (cadr (cadr t)) '==>))
      (let* ((seq (cadr t)) (g (car seq)) (f (caddr seq))
             (adds (let loop ((g g) (acc '())) (if (and (pair? g) (eq? (car g) 'CTX-ADD)) (loop (cadr g) (cons (caddr g) acc)) acc))))
        (append (cons f adds)
                (append-map mi-tree-forms (filter (lambda (k) (and (pair? k) (not (and (= (length k) 3) (eq? (cadr k) ':=))))) (cddr t)))))
      '()))
(define (mi-type-tree! t)
  (for-each (lambda (f) (if (not (dk-asm? `(IN ,f CLF))) (mi-cl! f 'CLF))) (delete-duplicates (mi-tree-forms t))))
(define (mi-derive! t) (mi-type-tree! t) (dk-meta-derive! 'tt t))
;; a context in CTX-SET, through the dk-derive! planner
(define (mi-ctx! g)
  (if (not (dk-asm? `(IN ,g CTX-SET)))
      (let ((p (dk-meta--plan-wf g 'CTX-SET '())))
        (if (not p) (error "mi-ctx!: cannot type the context" (expression->string g)))
        (p))))
;; a name fresh for the context g and the expression f: lands its typing and freshness, returns it
(define (mi-fresh! g f)
  (mi-ctx! g) (mi-expr! f)
  (dk-skolem! (dk-cite! 'fresh-name-exists g f) #t))
;; [g, f1] derivable from [g, f2] derivable and the equation EQN (left side occurring in f1 / g)
(define (mi-conv! g f1 eqn)
  (let ((goal (mi-der g f1)))
    (if (not (dk-asm? goal)) (dk-have! goal (lambda () (subst eqn) (ass))))
    goal))
;; the side fact the core reflexivity reads: (OR (= t (EFVAR n)) (= t (ECONST n)))
(define (mi-refl-fact! t)
  (cond ((and (pair? t) (eq? (car t) 'EFVAR))
         (dk-have! `(OR (= ,t (EFVAR ,(cadr t))) (= ,t (ECONST ,(cadr t)))) (lambda () (oi-l) (rfl))))
        ((and (pair? t) (eq? (car t) 'ECONST))
         (dk-have! `(OR (= ,t (EFVAR ,(cadr t))) (= ,t (ECONST ,(cadr t)))) (lambda () (oi-r) (rfl))))
        (#t (error "mi-refl-fact!: not a name or a constant" t))))
(define (mi-refl-node g t) `(reflexivity (,g ==> (ENC-EQ ,t ,t)) (n := ,(cadr t))))

(sp (make-wff '(FORALL tt (FORALL h (FORALL q (FORALL t (IMPLIES (IN (LIST h (ENC-IN t (ENC-COMP q))) (DERIVABLE tt))
   (IN (LIST h (EXPR-OPEN q 0 t)) (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((uu '(ENC-IN t (ENC-COMP q))) (oq '(EXPR-OPEN q 0 t)) (ia '(ENC-IN t ENC-SETC))
       (rr `(ENC-AND ,ia ,oq)) (ff `(ENC-IFF ,uu ,rr)) (h1 (mi+ 'h rr)))
  (dk-cite! 'der-in-seq 'tt `(LIST h ,uu))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h uu)))
  (dk-split! (dk-cite! 'clf-in-elim 't '(ENC-COMP q)))
  (mi-cl-facts! 't) (mi-cl-facts! '(ENC-COMP q))
  (mi-inv-body! '(ENC-COMP q) 1 0)
  (mi-derive! `(cut (h ==> ,oq)
                 (lemma (h ==> ,rr) der-iff-r (h ,uu ,rr) (comp-mem (h ==> ,ff)) (given (h ==> ,uu)))
                 (and-elim (,h1 ==> ,oq) (assumption (,(mi+ h1 ia oq) ==> ,oq)))))
  (ass))
(qed 'der-comp-out)

(sp (make-wff '(FORALL tt (FORALL h (FORALL q (FORALL t (IMPLIES (IN (ENC-COMP q) CLT)
   (IMPLIES (IN (LIST h (ENC-IN t ENC-SETC)) (DERIVABLE tt)) (IMPLIES (IN (LIST h (EXPR-OPEN q 0 t)) (DERIVABLE tt))
     (IN (LIST h (ENC-IN t (ENC-COMP q))) (DERIVABLE tt)))))))))))
(dk-peel!)
(let* ((uu '(ENC-IN t (ENC-COMP q))) (oq '(EXPR-OPEN q 0 t)) (ia '(ENC-IN t ENC-SETC))
       (rr `(ENC-AND ,ia ,oq)) (ff `(ENC-IFF ,uu ,rr)))
  (dk-cite! 'der-in-seq 'tt `(LIST h ,ia))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h ia)))
  (dk-split! (dk-cite! 'clf-in-elim 't 'ENC-SETC))
  (dk-cite! 'der-in-seq 'tt `(LIST h ,oq))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h oq)))
  (mi-derive! `(lemma (h ==> ,uu) der-iff-l (h ,uu ,rr) (comp-mem (h ==> ,ff))
                 (and-intro (h ==> ,rr) (given (h ==> ,ia)) (given (h ==> ,oq)))))
  (ass))
(qed 'der-comp-in)

;; a name in a constant is a set (membership-implies-sethood, encoded, a member of T)
(define mi-axm-u '(ENC-ALL (ENC-ALL (ENC-IMP (ENC-IN (EBVAR 1) (EBVAR 0)) (ENC-IN (EBVAR 1) ENC-SETC)))))
(sp (make-wff '(FORALL tt (FORALL h (FORALL n (FORALL m (IMPLIES (IN AX-MEM-SET tt) (IMPLIES (IN n NN) (IMPLIES (IN m NN)
   (IMPLIES (IN (LIST h (ENC-IN (EFVAR n) (ECONST m))) (DERIVABLE tt)) (IN (LIST h (ENC-IN (EFVAR n) ENC-SETC)) (DERIVABLE tt))))))))))))
(dk-peel!)
(let* ((x '(EFVAR n)) (cc '(ECONST m)) (goal `(ENC-IN ,x ENC-SETC)) (axb (cadr mi-axm-u))
       (h1 (mi+ 'h mi-axm-u)))
  (dk-cite! 'der-in-seq 'tt `(LIST h (ENC-IN ,x ,cc)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h `(ENC-IN ,x ,cc))))
  (dk-split! (dk-cite! 'clf-in-elim x cc))
  (mi-cl-facts! x) (mi-cl-facts! cc)
  (dk-cite! 'ax-mem-set-def)
  (dk-have! `(IN ,mi-axm-u tt) (lambda () (subst `(= ,mi-axm-u AX-MEM-SET)) (ass)))
  (mi-cl! mi-axm-u 'CLF) (mi-cl-facts! mi-axm-u)
  (let* ((o1 (mi-open! axb 0 x)) (o1b (cadr o1)) (h2 (mi+ h1 o1))
         (o2 (mi-open! o1b 0 cc)) (h3 (mi+ h2 o2)))
    (mi-refl-fact! x) (mi-refl-fact! cc)
    (mi-derive! `(backchain (,h3 ==> ,goal) (weakening (,h3 ==> (ENC-IN ,x ,cc)) (given (h ==> (ENC-IN ,x ,cc))))))
    (mi-conv! (mi+ h2 `(EXPR-OPEN ,o1b 0 ,cc)) goal `(= (EXPR-OPEN ,o1b 0 ,cc) ,o2))
    (mi-derive! `(forall-elim (,h2 ==> ,goal) (given (,(mi+ h2 `(EXPR-OPEN ,o1b 0 ,cc)) ==> ,goal)) ,(mi-refl-node h2 cc)))
    (mi-conv! (mi+ h1 `(EXPR-OPEN ,axb 0 ,x)) goal `(= (EXPR-OPEN ,axb 0 ,x) ,o1))
    (mi-derive! `(cut (h ==> ,goal) (theorem-assumption (h ==> ,mi-axm-u))
                   (forall-elim (,h1 ==> ,goal) (given (,(mi+ h1 `(EXPR-OPEN ,axb 0 ,x)) ==> ,goal)) ,(mi-refl-node h1 x))))
    (ass)))
(qed 'der-name-set)
;;; G. big-union-mem-intro: the witness w is defined because it is a member of A (DEF-IN-CLOSED).
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (DEF-IN-CLOSED tt) (IMPLIES (REL-BIG-UNION-MEM-INTRO tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt))))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-big-union-mem-intro 2))
       (g (car vs)) (a (cadr vs)) (b (caddr vs)) (x (cadddr vs)) (w (car (cddddr vs)))
       (bu `(ENC-BU ,a ,b)) (uu `(ENC-IN ,x ,bu))
       (eb `(ENC-AND (ENC-IN (EBVAR 0) ,a) (ENC-IN ,x ,b))) (exf `(ENC-EX ,eb)) (ff `(ENC-IFF ,uu ,exf))
       (h1 `(ENC-IN ,w ,a)) (h2 `(ENC-IN ,x (EXPR-OPEN ,b 0 ,w))) (ow `(ENC-AND ,h1 ,h2)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g uu)))
  (dk-split! (dk-cite! 'clf-in-elim x bu))
  (mi-cl-facts! x) (mi-cl-facts! bu)
  (mi-inv-body! bu 1 0)
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g h1)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g h2)))
  (dk-split! (dk-cite! 'clf-in-elim w a))
  (mi-cl-facts! w)
  (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'def-in-closed 'tt)) g w a)
  (let ((v (mi-open! eb 0 w)))
    (if (not (equal? v ow)) (error "bu-mem-intro: the opened body is not the hypotheses' conjunction" v))
    (mi-derive! `(and-intro (,g ==> ,ow) (given (,g ==> ,h1)) (given (,g ==> ,h2))))
    (mi-conv! g `(EXPR-OPEN ,eb 0 ,w) `(= (EXPR-OPEN ,eb 0 ,w) ,ow))
    (mi-derive! `(lemma (,g ==> ,uu) der-iff-l (,g ,uu ,exf)
                   (big-union-mem (,g ==> ,ff))
                   (forsome-intro (,g ==> ,exf) (given (,g ==> (EXPR-OPEN ,eb 0 ,w))) (given (,g ==> (ENC-EQ ,w ,w))))))
    (ass)))
(qed 'adm-big-union-mem-intro)
;;; -----------------------------------------------------------------------
;;; I. FAST TYPING OF THE FORMULAS OF A DERIVATION (agent META-5, 2026-10-12).
;;; The planner of section D proves a sentence's typing from the leaves up, at about 190 s for a formula
;;; of the size of AX-TFI (META-4 report 7.1).  A derivation from T needs only three sources of
;;; sentences, each typed by ONE citation: a member of T (T SUBSET CLF, a hypothesis of the theorem), an
;;; instance of a universal sentence at a closed term (clf-open-inst below), and a component of a
;;; sentence (the elimination laws clf-imp-elim, clf-and-elim, ... of meta-core-laws.scm).

;; An instance of a universal sentence at a closed term is a sentence.
(sp (make-wff '(FORALL b (FORALL t (IMPLIES (IN (ENC-ALL b) CLF) (IMPLIES (IN t CLT) (IN (EXPR-OPEN b 0 t) CLF)))))))
(dk-peel!)
(mi-cl-facts! '(ENC-ALL b))
(mi-inv-body! '(ENC-ALL b) 2 0)
(mi-cl-facts! 't)
(mi-cl0! '(EXPR-OPEN b 0 t) 'CLF)
(ass)
(qed 'clf-open-inst)
(sp (make-wff '(FORALL b (FORALL t (IMPLIES (IN (ENC-EX b) CLF) (IMPLIES (IN t CLT) (IN (EXPR-OPEN b 0 t) CLF)))))))
(dk-peel!)
(mi-cl-facts! '(ENC-EX b))
(mi-inv-body! '(ENC-EX b) 2 0)
(mi-cl-facts! 't)
(mi-cl0! '(EXPR-OPEN b 0 t) 'CLF)
(ass)
(qed 'clf-open-inst-ex)

;; The planner of the fast typing.  (mi-tcl-route f visit) is PURE: it returns a route by which
;; (IN f CLF) is one citation from facts in context or from sentences with a route, or #f.
;;   (have)              in context
;;   (subset X)          (IN f X) and (SUBSET X CLF) in context
;;   (inst b t)          f = (EXPR-OPEN b 0 t): (ENC-ALL b) has a route, t a closed term
;;   (eqv e)             (= e f) or (= f e) in context, e = (EXPR-OPEN b 0 t) with a route
;;   (elim u path)       f a component of a sentence u with a route, along PATH (elimination heads)
;;   (intro)             f an ENC-EQ / ENC-IN of closed terms, or a connective over sentences with routes
(define mi-elim-laws
  '((ENC-IMP . clf-imp-elim) (ENC-AND . clf-and-elim) (ENC-OR . clf-or-elim) (ENC-IFF . clf-iff-elim)
    (ENC-NOT . clf-not-elim)))
(define mi-intro-laws
  '((ENC-IMP . clf-imp-intro) (ENC-AND . clf-and-intro) (ENC-OR . clf-or-intro) (ENC-IFF . clf-iff-intro)
    (ENC-NOT . clf-not-intro) (ENC-EQ . clf-eq-intro) (ENC-IN . clf-in-intro)))
(define (mi-open-form? e) (and (pair? e) (eq? (car e) 'EXPR-OPEN) (equal? (caddr e) 0)))
;; the path of argument indices (0-based) from u down to f through elimination heads, or #f
(define (mi-elim-path u f)
  (cond ((equal? u f) '())
        ((and (pair? u) (assq (car u) mi-elim-laws))
         (let loop ((as (cdr u)) (i 0))
           (and (pair? as)
                (let ((p (mi-elim-path (car as) f)))
                  (if p (cons i p) (loop (cdr as) (+ i 1)))))))
        (#t #f)))
;; a closed term cheaply: in context, a free name, or one of the named encoded constants
(define (mi-clt-cheap? t)
  (or (dk-asm? `(IN ,t CLT))
      (and (pair? t) (memq (car t) '(EFVAR ENC-NUM)))
      (and (symbol? t) (assq t mi-const-laws))))
(define (mi-tcl-candidates)
  (filter-map (lambda (f)
                (cond ((and (dk-head-is? f 'IN) (eq? (caddr f) 'CLF)) (cadr f))
                      ((and (dk-head-is? f '=) (mi-open-form? (cadr f))) (caddr f))
                      ((and (dk-head-is? f 'IN) (symbol? (caddr f)) (dk-asm? `(SUBSET ,(caddr f) CLF))) (cadr f))
                      (#t #f)))
              (dk-asms)))
(define (mi-tcl-route f visit)
  (cond
    ((dk-asm? `(IN ,f CLF)) '(have))
    ((memq f '(ENC-FALSITY ENC-TRUTH)) '(atom))
    ((member f visit) #f)
    (#t
     (let ((visit (cons f visit)))
       (or
         (let ((m (find-first (lambda (a) (and (dk-head-is? a 'IN) (equal? (cadr a) f) (symbol? (caddr a))
                                               (dk-asm? `(SUBSET ,(caddr a) CLF))))
                              (dk-asms))))
           (and m `(subset ,(caddr m))))
         (and (mi-open-form? f) (mi-tcl-route `(ENC-ALL ,(cadr f)) visit)
              `(inst ,(cadr f) ,(cadddr f)))
         (and (mi-open-form? f) (mi-tcl-route `(ENC-EX ,(cadr f)) visit)
              `(inst-ex ,(cadr f) ,(cadddr f)))
         (let ((eqn (find-first (lambda (a) (and (dk-head-is? a '=)
                                                 (or (and (equal? (caddr a) f) (mi-open-form? (cadr a)))
                                                     (and (equal? (cadr a) f) (mi-open-form? (caddr a))))))
                                (dk-asms))))
           (and eqn
                (let ((e (if (equal? (caddr eqn) f) (cadr eqn) (caddr eqn))))
                  (and (mi-tcl-route e visit) `(eqv ,e)))))
         (let loop ((us (mi-tcl-candidates)))
           (and (pair? us)
                (let ((p (and (not (equal? (car us) f)) (mi-elim-path (car us) f))))
                  (if (and p (pair? p) (mi-tcl-route (car us) visit))
                      `(elim ,(car us) ,p)
                      (loop (cdr us))))))
         (and (pair? f) (assq (car f) mi-intro-laws)
              (if (memq (car f) '(ENC-EQ ENC-IN))
                  (and (mi-clt-cheap? (cadr f)) (mi-clt-cheap? (caddr f)) '(intro))
                  (and (every (lambda (a) (mi-tcl-route a visit)) (cdr f)) '(intro)))))))))

;; (IN t CLT) in context: a free name by clt-efvar, anything else by the planner (timed)
(define (mi-tclt! t)
  (cond ((dk-asm? `(IN ,t CLT)) #t)
        ((and (pair? t) (eq? (car t) 'EFVAR))
         (mi-nn! (cadr t))
         (dk-have! `(IN ,t CLT) (lambda () (fact 'clt-efvar (cadr t)) (ass))))
        (#t (let ((t0 (runtime)))
              (mi-cl! t 'CLT)
              (display ";; MI-TCLT-PLANNER ") (display (round (- (runtime) t0))) (display " ") (display (expression->string t)) (newline)))))

;; (IN f CLF) landed in the main context by its route; prerequisites first, each in its own lane, so
;; that only the memberships reach the main context.  Without a route: the planner, timed and reported.
(define mi-tcl-slow '())
(define mi-tcl-trace #f)
(define (mi-tcl! f)
  (let ((r (mi-tcl-route f '())))
    (if mi-tcl-trace (begin (display ";; MI-ROUTE ") (write (if r (car r) r)) (display " ") (display (expression->string f)) (newline)))
    (cond
      ((not r)
       (let ((t0 (runtime)))
         (dk-have! `(IN ,f CLF)
           (lambda ()
             (let ((ks (filter mi-typing-fact? (dk-asms))))
               (if (< (length ks) (length (dk-asms))) (apply keep ks)))
             (mi-cl0! f 'CLF)
             (mi-lane-close!)))
         (set! mi-tcl-slow (cons (list (round (- (runtime) t0)) f) mi-tcl-slow))
         (display ";; MI-TCL-PLANNER ") (display (round (- (runtime) t0))) (display " s ") (display (expression->string f)) (newline)))
      ((eq? (car r) 'have) #t)
      ((eq? (car r) 'atom)
       (dk-have! `(IN ,f CLF) (lambda () (fact (if (eq? f 'ENC-FALSITY) 'clf-falsity 'clf-truth)) (ass))))
      ((eq? (car r) 'subset)
       (dk-have! `(IN ,f CLF) (lambda () (dk-cite! 'subset-mem-fwd (cadr r) 'CLF f) (ass))))
      ((eq? (car r) 'inst)
       (let ((b (cadr r)) (t (caddr r)))
         (mi-tcl! `(ENC-ALL ,b))
         (mi-tclt! t)
         (dk-have! `(IN ,f CLF) (lambda () (dk-cite! 'clf-open-inst b t) (ass)))))
      ((eq? (car r) 'inst-ex)
       (let ((b (cadr r)) (t (caddr r)))
         (mi-tcl! `(ENC-EX ,b))
         (mi-tclt! t)
         (dk-have! `(IN ,f CLF) (lambda () (dk-cite! 'clf-open-inst-ex b t) (ass)))))
      ((eq? (car r) 'eqv)
       (let ((e (cadr r)))
         (mi-tcl! e)
         (dk-have! `(IN ,f CLF) (lambda () (subst `(= ,f ,e)) (ass)))))
      ((eq? (car r) 'elim)
       (let ((u (cadr r)) (path (caddr r)))
         (mi-tcl! u)
         (let walk ((u u) (path path))
           (if (pair? path)
               (let ((c (list-ref (cdr u) (car path))) (law (cdr (assq (car u) mi-elim-laws))))
                 (if (not (dk-asm? `(IN ,c CLF)))
                     (dk-have! `(IN ,c CLF)
                       (lambda ()
                         (let ((res (apply dk-cite! law (cdr u))))
                           (if (dk-head-is? res 'AND) (dk-split! res)))
                         (ass))))
                 (walk c (cdr path)))))))
      ((eq? (car r) 'intro)
       (if (memq (car f) '(ENC-EQ ENC-IN))
           (begin (mi-tclt! (cadr f)) (mi-tclt! (caddr f)))
           (for-each mi-tcl! (cdr f)))
       (dk-have! `(IN ,f CLF) (lambda () (apply dk-cite! (cdr (assq (car f) mi-intro-laws)) (cdr f)) (ass)))))
    `(IN ,f CLF)))

;; mi-derive! with the fast typing
(define (mi-type-tree2! t)
  (for-each (lambda (f) (if (not (dk-asm? `(IN ,f CLF))) (mi-tcl! f))) (delete-duplicates (mi-tree-forms t))))
(define (mi-derive2! t) (mi-type-tree2! t) (dk-meta-derive! 'tt t))

;; the formulas a context term adds, outermost last
(define (mi-ctx-adds g)
  (let loop ((g g) (acc '())) (if (and (pair? g) (eq? (car g) 'CTX-ADD)) (loop (cadr g) (cons (caddr g) acc)) acc)))
;; a context in CTX-SET, its added formulas typed by mi-tcl!, the planner run in a lane
(define (mi-ctx2! g)
  (for-each (lambda (f) (if (not (dk-asm? `(IN ,f CLF))) (mi-tcl! f))) (mi-ctx-adds g))
  (if (not (dk-asm? `(IN ,g CTX-SET)))
      (dk-have! `(IN ,g CTX-SET) (lambda () (mi-ctx! g) (mi-lane-close!)))))
;; mi-fresh! with the context and the expression typed in lanes
(define (mi-fresh2! g f)
  (mi-ctx2! g)
  (if (not (dk-asm? `(IN ,f EXPR-SET)))
      (dk-have! `(IN ,f EXPR-SET) (lambda () (mi-expr! f) (mi-lane-close!))))
  (dk-skolem! (dk-cite! 'fresh-name-exists g f) #t))

;; mi-open! in a lane whose context is first cut (one `keep') to the typing facts the calculator reads:
;; memberships in EXPR-SET / CLF / CLT / NN / a kind or closing-depth set, and the OPEN equations.  The
;; rule checkers compare contexts as sets, so the calculator's hundreds of steps pay for every formula
;; of the derivation's context otherwise (78 s against 9 s for one opening, measured).
(define (mi-typing-fact? f)
  (or (and (dk-head-is? f 'IN)
           (or (memq (caddr f) '(EXPR-SET CLF CLT NN))
               (and (pair? (caddr f)) (memq (car (caddr f)) '(EXPR-LCD EXPR-WKS TUPLES)))))
      (and (dk-head-is? f '=) (mi-open-form? (cadr f)))
      (and (dk-head-is? f '=) (number? (caddr f)))))
(define (mi-open2! e k u)
  (let ((v (mi-open-val e k u)) (orig `(EXPR-OPEN ,e ,k ,u)))
    (cond ((equal? v orig) orig)
          ((dk-asm? `(= ,orig ,v)) v)
          (#t (dk-have! `(= ,orig ,v)
                (lambda ()
                  (let ((ks (filter mi-typing-fact? (dk-asms))))
                    (if (< (length ks) (length (dk-asms))) (apply keep ks)))
                  (mi-open! e k u)
                  (mi-lane-close!)))
              v))))

;; [g, f1] from a given [g', f2] by the equations EQNS (subst), recorded as a derivability.
(define (mi-conv-n! g f1 eqns)
  (let ((goal (mi-der g f1)))
    (if (not (dk-asm? goal)) (dk-have! goal (lambda () (for-each (lambda (e) (subst e)) eqns) (ass))))
    goal))
(define (mi-unfold-const! c)              ; (IN unfolded tt) from (IN c tt): returns the unfolded form
  (let* ((eqn (dk-cite! (cdr (assq c mi-const-laws)))) (u (caddr eqn)))
    (dk-have! `(IN ,u tt) (lambda () (subst `(= ,u ,c)) (ass)))
    u))


;; Cut the main context (one `keep') to what a derivation reads: derivabilities, sentence / term / context /
;; sequent typings, memberships in T and in NN, the freshness facts, the OPEN equations, the hypotheses on T,
;; the expression facts of NAMES (the OPEN calculator reads a variable's closing depth off them), and the
;; formulas EXTRA.  Dropped: the instantiation chains of citations, the expression / kind / depth facts of
;; compound terms, the planner's intermediate facts.  The rule checkers compare contexts as sets, so every
;; step pays for every formula of the context (a limit-case derivation took 274 s at 375 formulas).
(define (mi-keep? f)
  (cond ((dk-head-is? f 'IN)
         (let ((x (cadr f)) (c (caddr f)))
           (or (memq c '(CLF CLT CTX-SET SEQ-SET NN SET tt))
               (and (pair? c) (eq? (car c) 'DERIVABLE))
               (and (symbol? x) (eq? c 'EXPR-SET))
               (and (pair? c) (memq (car c) '(EXPR-LCD EXPR-WKS)) (symbol? (cadr c))))))
        ((dk-head-is? f 'NOT) (and (dk-head-is? (cadr f) 'IN)))
        ((dk-head-is? f '=) (or (mi-open-form? (cadr f)) (number? (caddr f)) (and (symbol? (cadr f)) (symbol? (caddr f)))))
        ((dk-head-is? f 'OR) #t)
        ((memq (dk-head f) '(SUBSET DEF-COMP-CLOSED DEF-IN-CLOSED ADM-DEF-STRICT-IN-L ADM-DEF-STRICT-IN-R ADM-DEF-COMP EXPR-LC)) #t)
        (#t #f)))
(define (mi-prune! . extra)
  (let* ((now (dk-asms))
         (ks (filter (lambda (f) (or (mi-keep? f) (member f extra))) now)))
    (if (< (length ks) (length now))
        (begin (display ";; MI-PRUNE ") (display (length now)) (display " -> ") (display (length ks)) (newline)
               (apply keep ks)))))
;;; -----------------------------------------------------------------------
;;; F. THE INDUCTION RULES (structure-library/meta-ind.scm, section 2).

;;; F.1 transfinite-induction.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-TFI tt) (IMPLIES (IN AX-MEM-SET tt) (IMPLIES (DEF-COMP-CLOSED tt)
   (IMPLIES (REL-TRANSFINITE-INDUCTION tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-transfinite-induction 1)) (g (car vs)) (p (cadr vs))
       (gb `(ENC-IMP (ENC-IN (EBVAR 0) ENC-ORDC) ,p)) (gg `(ENC-ALL ,gb))
       (hb `(ENC-IMP (ENC-AND (ENC-IN (EBVAR 0) ENC-ORDC) (ENC-ALL (ENC-IMP (ENC-ORDLT (EBVAR 0) (EBVAR 1)) ,p))) ,p))
       (hf `(ENC-ALL ,hb)) (cc `(ENC-COMP ,p)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g gg)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g hf)))
  ;; the body p: an expression, a formula, closed at depth 1; its comprehension a closed term
  (mi-cl-facts! gg) (mi-inv-body! gg 2 0) (mi-inv-arg! gb 2 2 1)
  (dk-cite! 'comp-of-body-clt '(ENC-IN (EBVAR 0) ENC-ORDC) p)
  ;; the definedness of the comprehension (DEF-COMP-CLOSED), the encoded axioms in T
  (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'def-comp-closed 'tt)) g p)
  (let* ((axu (mi-unfold-const! 'AX-TFI)) (axb (cadr axu))
         (ic (mi-open2! axb 0 cc)) (prem (cadr ic)) (conc (caddr ic))
         (g1 (mi+ g axu)) (g2 (mi+ g1 ic)) (g3 (mi+ g2 conc))
         (orbc (lambda (x) `(ENC-IN ,x ENC-ORDC))) (inc (lambda (x) `(ENC-IN ,x ,cc))))
    (dk-cite! 'ax-mem-set-def)
    (mi-unfold-const! 'AX-MEM-SET)
    (for-each mi-tcl! (list axu ic prem conc))
    (mi-prune!)
    ;; D3: [g3, G]: a fresh z, the conclusion's instance at z, comprehension out.
    (let* ((z (mi-fresh2! g3 gb)) (ez `(EFVAR ,z))
           (gz (mi-open2! gb 0 ez)) (pz (caddr gz))
           (g4 (mi+ g3 (orbc ez)))
           (concb (cadr conc)) (cz (mi-open2! concb 0 ez)) (g5 (mi+ g4 cz)))
      (mi-refl-fact! ez)
      (mi-derive2! `(lemma (,g5 ==> ,pz) der-comp-out (,g5 ,p ,ez)
                     (backchain (,g5 ==> ,(inc ez)) (assumption (,g5 ==> ,(orbc ez))))))
      (mi-conv! (mi+ g4 `(EXPR-OPEN ,concb 0 ,ez)) pz `(= (EXPR-OPEN ,concb 0 ,ez) ,cz))
      (mi-derive2! `(forall-elim (,g4 ==> ,pz) (given (,(mi+ g4 `(EXPR-OPEN ,concb 0 ,ez)) ==> ,pz)) ,(mi-refl-node g4 ez)))
      (mi-derive2! `(implies-intro (,g3 ==> ,gz) (given (,g4 ==> ,pz))))
      (mi-conv! g3 `(EXPR-OPEN ,gb 0 ,ez) `(= (EXPR-OPEN ,gb 0 ,ez) ,gz))
      (mi-derive2! `(forall-intro (,g3 ==> ,gg) (given (,g3 ==> (EXPR-OPEN ,gb 0 ,ez))))))
    ;; D2: [g2, PREM]: a fresh z', the premise's instance at z', comprehension in.
    (let* ((premb (cadr prem)) (z (mi-fresh2! g2 premb)) (ez `(EFVAR ,z))
           (pz (mi-open2! premb 0 ez)) (aa (cadr pz)) (ihc (caddr aa))
           (g6a (mi+ g2 aa)) (g6 (mi+ g6a (orbc ez) ihc))
           (g7 (mi+ g6 hf)) (hz (mi-open2! hb 0 ez)) (ihp (caddr (cadr hz))) (pz2 (caddr hz))
           (g8 (mi+ g7 hz)))
      (mi-refl-fact! ez)
      ;; the induction hypothesis transported: [g8, IHp] from IHc, at a fresh w
      (let* ((ihpb (cadr ihp)) (w (mi-fresh2! g8 ihpb)) (ew `(EFVAR ,w))
             (ihpw (mi-open2! ihpb 0 ew)) (pw (caddr ihpw)) (g9 (mi+ g8 (cadr ihpw)))
             (ihcb (cadr ihc)) (ihcw (mi-open2! ihcb 0 ew)) (g10 (mi+ g9 ihcw)))
        (mi-refl-fact! ew)
        (mi-derive2! `(lemma (,g10 ==> ,pw) der-comp-out (,g10 ,p ,ew)
                       (backchain (,g10 ==> ,(inc ew)) (assumption (,g10 ==> ,(cadr ihpw))))))
        (mi-conv! (mi+ g9 `(EXPR-OPEN ,ihcb 0 ,ew)) pw `(= (EXPR-OPEN ,ihcb 0 ,ew) ,ihcw))
        (mi-derive2! `(forall-elim (,g9 ==> ,pw) (given (,(mi+ g9 `(EXPR-OPEN ,ihcb 0 ,ew)) ==> ,pw)) ,(mi-refl-node g9 ew)))
        (mi-derive2! `(implies-intro (,g8 ==> ,ihpw) (given (,g9 ==> ,pw))))
        (mi-conv! g8 `(EXPR-OPEN ,ihpb 0 ,ew) `(= (EXPR-OPEN ,ihpb 0 ,ew) ,ihpw))
        (mi-derive2! `(forall-intro (,g8 ==> ,ihp) (given (,g8 ==> (EXPR-OPEN ,ihpb 0 ,ew))))))
      ;; [g8, p(z')] by the hypothesis H at z'; [g6, p(z')] by cutting H in
      (mi-derive2! `(backchain (,g8 ==> ,pz2)
                     (and-intro (,g8 ==> ,(cadr hz)) (assumption (,g8 ==> ,(orbc ez))) (given (,g8 ==> ,ihp)))))
      (mi-conv! (mi+ g7 `(EXPR-OPEN ,hb 0 ,ez)) pz2 `(= (EXPR-OPEN ,hb 0 ,ez) ,hz))
      (mi-derive2! `(cut (,g6 ==> ,pz2) (weakening (,g6 ==> ,hf) (given (,g ==> ,hf)))
                     (forall-elim (,g7 ==> ,pz2) (given (,(mi+ g7 `(EXPR-OPEN ,hb 0 ,ez)) ==> ,pz2)) ,(mi-refl-node g7 ez))))
      ;; z' in SET (membership-implies-sethood), then z' in the comprehension
      (dk-have! '(IN 5 NN) (lambda () (arith)))
      (dk-cite! 'enc-ordc-def)
      (mi-derive2! `(assumption (,g6 ==> ,(orbc ez))))
      (mi-conv-n! g6 `(ENC-IN ,ez (ECONST 5)) (list '(= (ECONST 5) ENC-ORDC)))
      (dk-cite! 'der-name-set 'tt g6 z 5)
      (dk-cite! 'der-comp-in 'tt g6 p ez)
      (mi-derive2! `(and-elim (,g6a ==> ,(inc ez)) (given (,g6 ==> ,(inc ez)))))
      (mi-derive2! `(implies-intro (,g2 ==> ,pz) (given (,g6a ==> ,(inc ez)))))
      (mi-conv! g2 `(EXPR-OPEN ,premb 0 ,ez) `(= (EXPR-OPEN ,premb 0 ,ez) ,pz))
      (mi-derive2! `(forall-intro (,g2 ==> ,prem) (given (,g2 ==> (EXPR-OPEN ,premb 0 ,ez))))))
    ;; D1 and the root: the axiom's instance at the comprehension
    (mi-derive2! `(cut (,g2 ==> ,gg) (backchain (,g2 ==> ,conc) (given (,g2 ==> ,prem))) (given (,g3 ==> ,gg))))
    (mi-conv! (mi+ g1 `(EXPR-OPEN ,axb 0 ,cc)) gg `(= (EXPR-OPEN ,axb 0 ,cc) ,ic))
    (mi-derive2! `(cut (,g ==> ,gg) (theorem-assumption (,g ==> ,axu))
                   (forall-elim (,g1 ==> ,gg) (given (,(mi+ g1 `(EXPR-OPEN ,axb 0 ,cc)) ==> ,gg))
                     (weakening (,g1 ==> (ENC-EQ ,cc ,cc)) (given (,g ==> (ENC-EQ ,cc ,cc)))))))
    (ass)))
(qed 'adm-transfinite-induction)
;;; F.2 nn-induction.  Its step substitutes succ of the bound variable, so the REL states the step
;;; cofinitely (meta-ind.scm s.2); the derivation instantiates the step hypothesis at a fresh name z
;;; outside the exception set.  It needs, beside the axiom, the encoded nn-zero-in and nn-succ-closed
;;; (members of T), DEF-COMP-CLOSED (the comprehension) and DEF-IN-CLOSED (succ z, a member of NN,
;;; is defined: the instance of membership-implies-sethood at succ z owes it).

;; sethood of any defined closed term in a constant class
(sp (make-wff '(FORALL tt (FORALL h (FORALL x (FORALL m (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-MEM-SET tt) (IMPLIES (IN m NN)
   (IMPLIES (IN (LIST h (ENC-IN x (ECONST m))) (DERIVABLE tt)) (IMPLIES (IN (LIST h (ENC-EQ x x)) (DERIVABLE tt))
     (IN (LIST h (ENC-IN x ENC-SETC)) (DERIVABLE tt)))))))))))))
(dk-peel!)
(let* ((x 'x) (cc '(ECONST m)) (goal `(ENC-IN ,x ENC-SETC)) (axb (cadr mi-axm-u)) (h1 (mi+ 'h mi-axm-u)))
  (dk-cite! 'der-in-seq 'tt `(LIST h (ENC-IN ,x ,cc)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h `(ENC-IN ,x ,cc))))
  (dk-split! (dk-cite! 'clf-in-elim x cc))
  (mi-cl-facts! x) (mi-cl-facts! cc)
  (dk-cite! 'ax-mem-set-def)
  (dk-have! `(IN ,mi-axm-u tt) (lambda () (subst `(= ,mi-axm-u AX-MEM-SET)) (ass)))
  (mi-tcl! mi-axm-u) (mi-cl-facts! mi-axm-u)
  (let* ((o1 (mi-open2! axb 0 x)) (o1b (cadr o1)) (h2 (mi+ h1 o1))
         (o2 (mi-open2! o1b 0 cc)) (h3 (mi+ h2 o2)))
    (mi-refl-fact! cc)
    (mi-derive2! `(backchain (,h3 ==> ,goal) (weakening (,h3 ==> (ENC-IN ,x ,cc)) (given (h ==> (ENC-IN ,x ,cc))))))
    (mi-conv! (mi+ h2 `(EXPR-OPEN ,o1b 0 ,cc)) goal `(= (EXPR-OPEN ,o1b 0 ,cc) ,o2))
    (mi-derive2! `(forall-elim (,h2 ==> ,goal) (given (,(mi+ h2 `(EXPR-OPEN ,o1b 0 ,cc)) ==> ,goal)) ,(mi-refl-node h2 cc)))
    (mi-conv! (mi+ h1 `(EXPR-OPEN ,axb 0 ,x)) goal `(= (EXPR-OPEN ,axb 0 ,x) ,o1))
    (mi-derive2! `(cut (h ==> ,goal) (theorem-assumption (h ==> ,mi-axm-u))
                   (forall-elim (,h1 ==> ,goal) (given (,(mi+ h1 `(EXPR-OPEN ,axb 0 ,x)) ==> ,goal))
                     (weakening (,h1 ==> (ENC-EQ ,x ,x)) (given (h ==> (ENC-EQ ,x ,x)))))))
    (ass)))
(qed 'der-mem-set)

;; [h, t in ECONST k] from [h, t in C] for C a named constant class (NNC / ORDC), by its unfold equation
(define (mi-to-econst! h t c)
  (let* ((eqn (mi-unfold-eq c)) (ec (caddr eqn)))
    (mi-conv-n! h `(ENC-IN ,t ,ec) (list `(= ,ec ,c)))
    (cadr ec)))

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-NN-IND tt) (IMPLIES (IN AX-MEM-SET tt)
   (IMPLIES (IN AX-ZERO-NN tt) (IMPLIES (IN AX-SUCC-NN tt) (IMPLIES (DEF-COMP-CLOSED tt) (IMPLIES (DEF-IN-CLOSED tt)
   (IMPLIES (REL-NN-INDUCTION tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt))))))))))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-nn-induction 2)) (g (car vs)) (p (cadr vs)) (s (caddr vs)) (fs (cadddr vs))
       (nnc (lambda (x) `(ENC-IN ,x ENC-NNC)))
       (gb `(ENC-IMP ,(nnc '(EBVAR 0)) ,p)) (gg `(ENC-ALL ,gb)) (cc `(ENC-COMP ,p))
       (num0 '(ENC-NUM 0)) (p0 `(EXPR-OPEN ,p 0 ,num0)) (sa `(ENC-ALL ,s))
       (us (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f fs) (dk-contains? f 'EXPR-OPEN))) "the cofinite step")))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g gg)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g sa)))
  (mi-cl-facts! gg) (mi-inv-body! gg 2 0) (mi-inv-arg! gb 2 2 1)
  (dk-cite! 'comp-of-body-clt (nnc '(EBVAR 0)) p)
  (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'def-comp-closed 'tt)) g p)
  (let ((defin (dk-meta-iff-r! (dk-meta-iff! 'def-in-closed 'tt))))
  (let* ((axu (mi-unfold-const! 'AX-NN-IND)) (axb (cadr axu))
         (azu (mi-unfold-const! 'AX-ZERO-NN)) (asu (mi-unfold-const! 'AX-SUCC-NN)) (asb (cadr asu))
         (ic (mi-open2! axb 0 cc)) (pa (cadr ic)) (conc (caddr ic)) (stepc (caddr pa))
         (g1 (mi+ g axu)) (g2 (mi+ g1 ic)) (g3 (mi+ g2 conc))
         (inc (lambda (x) `(ENC-IN ,x ,cc))))
    (dk-cite! 'ax-mem-set-def)
    (mi-unfold-const! 'AX-MEM-SET)
    (for-each mi-tcl! (list axu ic pa conc stepc azu asu))
    (mi-prune! us defin)
    ;; D3: [g3, G]
    (let* ((z (mi-fresh2! g3 gb)) (ez `(EFVAR ,z))
           (gz (mi-open2! gb 0 ez)) (pz (caddr gz)) (g4 (mi+ g3 (nnc ez)))
           (concb (cadr conc)) (cz (mi-open2! concb 0 ez)) (g5 (mi+ g4 cz)))
      (mi-refl-fact! ez)
      (mi-derive2! `(lemma (,g5 ==> ,pz) der-comp-out (,g5 ,p ,ez)
                     (backchain (,g5 ==> ,(inc ez)) (assumption (,g5 ==> ,(nnc ez))))))
      (mi-conv! (mi+ g4 `(EXPR-OPEN ,concb 0 ,ez)) pz `(= (EXPR-OPEN ,concb 0 ,ez) ,cz))
      (mi-derive2! `(forall-elim (,g4 ==> ,pz) (given (,(mi+ g4 `(EXPR-OPEN ,concb 0 ,ez)) ==> ,pz)) ,(mi-refl-node g4 ez)))
      (mi-derive2! `(implies-intro (,g3 ==> ,gz) (given (,g4 ==> ,pz))))
      (mi-conv! g3 `(EXPR-OPEN ,gb 0 ,ez) `(= (EXPR-OPEN ,gb 0 ,ez) ,gz))
      (mi-derive2! `(forall-intro (,g3 ==> ,gg) (given (,g3 ==> (EXPR-OPEN ,gb 0 ,ez))))))
    ;; BASE: [g2, 0 in C]
    (let ((e0 (mi-unfold-eq num0)))
      (dk-have! `(OR (= ,num0 (EFVAR 0)) (= ,num0 (ECONST 0))) (lambda () (oi-r) (subst e0) (rfl))))
    (mi-derive2! `(weakening (,g2 ==> ,azu) (theorem-assumption (,g ==> ,azu))))
    (let ((m (mi-to-econst! g2 num0 'ENC-NNC)))
      (mi-derive2! `(reflexivity (,g2 ==> (ENC-EQ ,num0 ,num0)) (n := 0)))
      (dk-cite! 'der-mem-set 'tt g2 num0 m))
    (mi-derive2! `(weakening (,g2 ==> ,p0) (given (,g ==> ,p0))))
    (dk-cite! 'der-comp-in 'tt g2 p num0)
    ;; STEP: [g2, STEPc] at a fresh z outside the exception set
    (mi-prune! us defin)
    (let* ((stepb (cadr stepc))
           (z (begin (mi-ctx2! g2) (mi-expr! stepb) (dk-skolem! (dk-cite! 'mr-fresh fs g2 stepb) #t)))
           (ez `(EFVAR ,z)) (sz (mi-open2! stepb 0 ez)) (aa (cadr sz)) (ssz `(ENC-SUCC ,ez))
           (g6a (mi+ g2 aa)) (g6 (mi+ g6a (nnc ez) (inc ez)))
