;;; -----------------------------------------------------------------------
;;; N2. THE CARTESIAN RULES (agent METACORE, 2026-10-29; the K2 ledger's rows 28 and 29).  The core states the
;;; membership of an n-ary product through NTH and LENGTH (CR-CARTESIAN-MEM): x in CARTESIAN(a1 .. an) iff x is a
;;; tuple of sets, of length n, whose i-th entry is in a_i (the left fold ENC-CARTL).  For a literal list
;;; x = [e1 .. en] the i-th entry is e_i by CR-NTH-EQ, whose premise -- the list denotes -- is the strictness of
;;; the membership (elim) or of the tuples membership (intro).  The fold is reached by an induction on the count,
;;; as the n-ary laws of meta-core-laws.scm section J.2.  cartesian-intro needs the members of the factors to be
;;; SETS (the core's tuples-mem reads them): the encoded axiom membership-implies-sethood, AX-MEM-SET, in T.

;; the unfoldings of the three term constructors the rules name (enc-nth-unfold moved here from
;; meta-def-laws.scm, which cites it)
(sp (make-wff '(FORALL mdp7_ (FORALL mdq7_ (== (ENC-NTH mdp7_ mdq7_) (EAPP 15 (LIST mdp7_ mdq7_)))))))
(dk-peel!) (mac 'ENC-NTH) (qrfl)
(qed 'enc-nth-unfold)
(sp (make-wff '(FORALL mip_ (== (ENC-LENGTH mip_) (EAPP 16 (LIST mip_))))))
(dk-peel!) (mac 'ENC-LENGTH) (qrfl)
(qed 'enc-length-unfold)
(set! mi-unfold-laws (append mi-unfold-laws '((ENC-NTH . enc-nth-unfold) (ENC-CART . enc-cart-unfold) (ENC-LENGTH . enc-length-unfold))))

;; the entry atom of the fold at the index I: NTH(I, x) in l_I
(define (mi-cart-atom i x l) `(ENC-IN (ENC-NTH (ENC-NUM ,i) ,x) (NTH ,i ,l)))
;; with x in CLT, l typed, the MAKE-SET universal U, I in NN, 1 <= I <= |l| in context: the atom a sentence
(define (mi-cart-atom-clf! i x l u)
  (let ((e `(NTH ,i ,l)) (nt `(ENC-NTH (ENC-NUM ,i) ,x)))
    (dk-have! `(IN ,e (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! i l 'EXPR-SET)))
    (dk-apply! u e)
    (mi-cl-facts! x)
    (dk-have! '(IN 2 NN) (lambda () (arith)))
    (if (not (dk-asm? `(IN (* 2 ,i) NN)))
        (begin (dk-have! `(AND (IN 2 NN) (IN ,i NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
               (fact 'nn-mul-closed 2 i)))
    (mi-cl! nt 'CLT)
    (dk-cite! 'clf-in-intro nt e)
    (mi-cart-atom i x l)))
(define mi-msu '(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))
(define (mi-msu-of landed)
  (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAKE-SET)
                                   (not (dk-contains? f 'DERIVABLE)) (not (dk-contains? f 'ENC-CARTL))))
                  landed)
      (error "mi-msu-of: no MAKE-SET universal landed")))

;; the fold is a sentence
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL x (FORALL l (IMPLIES (IN x CLT) (IMPLIES (IN l (TUPLES EXPR-SET))
   (IMPLIES ,mi-msu (IMPLIES (<= n (LENGTH l)) (IN (ENC-CARTL x l n) CLF)))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (let ((o (cadr (dk-goal))))
    (subst (dk-cite! 'enc-cartl-zero (cadr o) (caddr o)))
    (fact 'clf-truth) (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-CARTL))) landed))
         (u (mi-msu-of landed))
         (o (cadr (dk-goal))) (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn)))
    (subst (dk-cite! 'enc-cartl-succ x l n))
    (fact 'length-in-nn 'EXPR-SET l)
    (fact 'nn-succ-closed n)
    (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-apply! ih x l)
    (let ((at (mi-cart-atom-clf! sn x l u)))
      (dk-cite! 'clf-and-intro `(ENC-CARTL ,x ,l ,n) at)
      (ass))))
(qed 'enc-cartl-clf)

;; W1G-A (2026-11-06) / W1N (2026-11-07): the fixed-parameter inductions below use the kit's
;; dk-meta-ni-cases-fixed! (driver-kit.scm); the file-local twin mi-meta-ni-cases-fixed! was removed.
;; ELIM: [g, CARTL(x, l, n)] derivable => [g, NTH(k, x) in l_k] derivable, 1 <= k <= n <= |l|
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL x (FORALL l (FORALL k
   (IMPLIES (IN (LIST g (ENC-CARTL x l n)) (DERIVABLE tt)) (IMPLIES (IN g CTX-SET)
   (IMPLIES (IN x CLT) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES ,mi-msu
   (IMPLIES (IN k NN) (IMPLIES (<= 1 k) (IMPLIES (<= k n) (IMPLIES (<= n (LENGTH l))
     (IN (LIST g ,(mi-cart-atom 'k 'x 'l)) (DERIVABLE tt))))))))))))))))))))
(let ((cs (dk-meta-ni-cases-fixed! '(tt g x l k))))   ; W1G-A: tt g x l k fixed
  (dk-focus! (car cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))   ; W1G-A: the fixed hypotheses are in context
         (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
    (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,k) `(<= ,k 0))))
    (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
    (ai '(NOT (<= 1 0))))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))   ; W1G-A: the fixed hypotheses are in context
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'ENC-CARTL))) landed))   ; W1G-A: the IH is an implication
         (u (mi-msu-of landed))
         (dh (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'DERIVABLE))) landed))
         (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed)))
         (tt (cadr (caddr dh))) (g (cadr (cadr dh))) (o (caddr (cadr dh)))
         (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (aa `(ENC-CARTL ,x ,l ,n)) (e (mi-cart-atom sn x l)) (ae `(ENC-AND ,aa ,e))
         (g1 `(CTX-ADD ,g ,ae)) (g3 `(CTX-ADD (CTX-ADD ,g1 ,aa) ,e)))
    (dk-cite! 'enc-cartl-succ x l n)
    (dk-rewrite-h! dh o ae)
    (fact 'length-in-nn 'EXPR-SET l)
    (fact 'nn-succ-closed n)
    (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! 'enc-cartl-clf n) x l)
    (mi-cart-atom-clf! sn x l u)
    (dk-derive! tt `(cut (,g ==> ,aa) (given (,g ==> ,ae)) (and-elim (,g1 ==> ,aa) (assumption (,g3 ==> ,aa)))))
    (dk-derive! tt `(cut (,g ==> ,e) (given (,g ==> ,ae)) (and-elim (,g1 ==> ,e) (assumption (,g3 ==> ,e)))))
    (use-em `(= ,sn ,k)
      (lambda () (subst `(= ,k ,sn)) (ass))
      (lambda ()
        (dk-cite! 'nn-le-ne-succ k sn)
        (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,sn))))
        (let w1g-dl ((w1g-f ih)) (if (dk-head-is? w1g-f 'IMPLIES) (w1g-dl (dk-landed-1 (lambda () (detach! w1g-f)))) w1g-f))   ; W1G-A: tt g x l k fixed
        (ass)))))
(qed 'enc-cartl-elim-der)

;; INTRO: every entry derivable => [g, CARTL(x, l, n)] derivable
(define (mi-cart-all bound)
  `(FORALL mczk_ (IMPLIES (IN mczk_ NN) (IMPLIES (<= 1 mczk_) (IMPLIES (<= mczk_ ,bound)
      (IN (LIST g ,(mi-cart-atom 'mczk_ 'x 'l)) (DERIVABLE tt)))))))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL tt (FORALL g (FORALL x (FORALL l
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN x CLT) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES ,mi-msu
   (IMPLIES ,(mi-cart-all 'n) (IMPLIES (<= n (LENGTH l)) (IN (LIST g (ENC-CARTL x l n)) (DERIVABLE tt))))))))))))))))
(let ((cs (dk-meta-ni-cases-fixed! '(tt g x l))))   ; W1G-A: tt g x l fixed
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr sq)) (o (caddr sq)))
    (subst (dk-cite! 'enc-cartl-zero (cadr o) (caddr o)))
    (dk-derive! tt `(truth-intro (,g ==> ENC-TRUTH)))
    (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))   ; W1G-A: the fixed hypotheses are in context
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'ENC-CARTL))) landed))   ; W1G-A: the IH is an implication
         (u (mi-msu-of landed))
         (hk (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DERIVABLE) (not (dk-contains? f 'ENC-CARTL)))) landed))
         (gl (dk-goal)) (sq (cadr gl)) (tt (cadr (caddr gl))) (g (cadr sq)) (o (caddr sq))
         (x (cadr o)) (l (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (aa `(ENC-CARTL ,x ,l ,n)) (e (mi-cart-atom sn x l)))
    (subst (dk-cite! 'enc-cartl-succ x l n))
    (fact 'length-in-nn 'EXPR-SET l)
    (fact 'nn-succ-closed n)
    (dk-have! `(<= ,n (LENGTH ,l)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,l)))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-have! `(<= ,sn ,sn) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! 'enc-cartl-clf n) x l)
    (mi-cart-atom-clf! sn x l u)
    ;; the hypothesis restricted to n
    (let ((hn (let walk ((f hk))
                (cond ((and (pair? f) (eq? (car f) '<=) (equal? (caddr f) sn) (symbol? (cadr f))) `(<= ,(cadr f) ,n))
                      ((pair? f) (map walk f))
                      (#t f)))))
      (dk-have! hn
        (lambda ()
          (let* ((ld (dk-peel!))
                 (kk (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) ld))))
            (dk-have! `(<= ,kk ,sn) (lambda () (dk-nn! `(<= ,kk ,n))))
            (dk-apply! hk kk)
            (ass)))))
    (let w1g-dl ((w1g-f ih)) (if (dk-head-is? w1g-f 'IMPLIES) (w1g-dl (dk-landed-1 (lambda () (detach! w1g-f)))) w1g-f))   ; W1G-A: tt g x l fixed
    (dk-apply! hk sn)
    (dk-derive! tt `(and-intro (,g ==> (ENC-AND ,aa ,e)) (given (,g ==> ,aa)) (given (,g ==> ,e))))
    (ass)))
(qed 'enc-cartl-der)

;; [g, A and B] => [g, B], [g, A]
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST g (ENC-AND a b)) (DERIVABLE tt))
   (AND (IN (LIST g a) (DERIVABLE tt)) (IN (LIST g b) (DERIVABLE tt))))))))))
(dk-peel!)
(let* ((ab '(ENC-AND a b)) (g1 (mi+ 'g ab)) (g3 (mi+ g1 'a 'b)))
  (dk-cite! 'der-in-seq 'tt `(LIST g ,ab))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g ab)))
  (dk-split! (dk-cite! 'clf-and-elim 'a 'b))
  (dk-derive! 'tt `(cut (g ==> a) (given (g ==> ,ab)) (and-elim (,g1 ==> a) (assumption (,g3 ==> a)))))
  (dk-derive! 'tt `(cut (g ==> b) (given (g ==> ,ab)) (and-elim (,g1 ==> b) (assumption (,g3 ==> b)))))
  (dk-conj-close! (lambda () (ass))))
(qed 'der-and-parts)

;; [h, x in SET] from [h, x in y], x and y closed terms: the encoded membership-implies-sethood (AX-MEM-SET, a
;; member of T) instantiated at x and at y; each instance owes the term's definedness, the strictness of the
;; membership on either side.
(sp (make-wff '(FORALL tt (FORALL h (FORALL x (FORALL y (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-MEM-SET tt)
   (IMPLIES (IN (LIST h (ENC-IN x y)) (DERIVABLE tt)) (IN (LIST h (ENC-IN x ENC-SETC)) (DERIVABLE tt)))))))))))
(dk-peel!)
(let* ((goal '(ENC-IN x ENC-SETC)) (xy '(ENC-IN x y)) (axb (cadr mi-axm-u)) (h1 (mi+ 'h mi-axm-u)))
  (dk-cite! 'der-in-seq 'tt `(LIST h ,xy))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'h xy)))
  (dk-split! (dk-cite! 'clf-in-elim 'x 'y))
  (mi-cl-facts! 'x) (mi-cl-facts! 'y)
  (dk-cite! 'clf-eq-intro 'x 'x)
  (dk-cite! 'clf-eq-intro 'y 'y)
  (mi-derive2! `(def-strict-in-l (h ==> (ENC-EQ x x)) (given (h ==> ,xy))))
  (mi-derive2! `(def-strict-in-r (h ==> (ENC-EQ y y)) (given (h ==> ,xy))))
  (dk-cite! 'ax-mem-set-def)
  (dk-have! `(IN ,mi-axm-u tt) (lambda () (subst `(= ,mi-axm-u AX-MEM-SET)) (ass)))
  (mi-tcl! mi-axm-u) (mi-cl-facts! mi-axm-u)
  (let* ((o1 (mi-open2! axb 0 'x)) (o1b (cadr o1)) (h2 (mi+ h1 o1))
         (o2 (mi-open2! o1b 0 'y)) (h3 (mi+ h2 o2)))
    (mi-derive2! `(backchain (,h3 ==> ,goal) (weakening (,h3 ==> ,xy) (given (h ==> ,xy)))))
    (mi-conv! (mi+ h2 `(EXPR-OPEN ,o1b 0 y)) goal `(= (EXPR-OPEN ,o1b 0 y) ,o2))
    (mi-derive2! `(forall-elim (,h2 ==> ,goal) (given (,(mi+ h2 `(EXPR-OPEN ,o1b 0 y)) ==> ,goal))
                    (weakening (,h2 ==> (ENC-EQ y y)) (given (h ==> (ENC-EQ y y))))))
    (mi-conv! (mi+ h1 `(EXPR-OPEN ,axb 0 x)) goal `(= (EXPR-OPEN ,axb 0 x) ,o1))
    (mi-derive2! `(cut (h ==> ,goal) (theorem-assumption (h ==> ,mi-axm-u))
                   (forall-elim (,h1 ==> ,goal) (given (,(mi+ h1 `(EXPR-OPEN ,axb 0 x)) ==> ,goal))
                     (weakening (,h1 ==> (ENC-EQ x x)) (given (h ==> (ENC-EQ x x)))))))
    (mi-lane-close!)))
(qed 'der-mem-set-gen)

;; the entry atom of [e] at k, from the entry's membership: NTH(k, [e]) == e_k (CR-NTH-EQ, [e] denoting), then
;; der-atom-l at the head 7; DIR 'fwd: [g, e_k in c] => [g, NTH(k, [e]) in c]; 'bwd: the converse.
(define (mi-cart-nth-eq! g e k)          ; [g, NTH(k, [e]) == e_k], the typings in context
  (let* ((x `(ENC-LIST ,e)) (nt `(ENC-NTH (ENC-NUM ,k) ,x)) (ek `(NTH ,k ,e)))
    (mi-cl! nt 'CLT)
    (dk-cite! 'clf-qeq-intro nt ek)
    (mi-derive2! `(nth-eq (,g ==> (ENC-QEQ ,nt ,ek)) (given (,g ==> (ENC-EQ ,x ,x)))))
    (mi-der g `(ENC-QEQ ,nt ,ek))))
(define (mi-cart-move! g s t c)          ; [g, s == t], [g, t in c] in context: [g, s in c]; s, t, c in CLT
  (let* ((uf (dk-cite! 'enc-in-unfold t c)) (us (dk-cite! 'enc-in-unfold s c)))
    (dk-have! '(IN 7 NN) (lambda () (arith)))
    (dk-cite! 'clf-in-intro s c)
    (dk-rewrite-h! `(IN (ENC-IN ,s ,c) CLF) `(ENC-IN ,s ,c) (caddr us))
    (dk-rewrite-h! (mi-der g `(ENC-IN ,t ,c)) `(ENC-IN ,t ,c) (caddr uf))
    (dk-cite! 'der-atom-l 'tt g 7 s t c)
    (dk-rewrite-h! (mi-der g (caddr us)) (caddr us) `(ENC-IN ,s ,c))))
;; the entry e_k of l typed in CLT from the MAKE-SET universal of l
(define (mi-entry-clt! k l)
  (let ((u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l)) (dk-contains? f 'CLT)
                                        (not (dk-contains? f 'DERIVABLE))))
                       (dk-asms))))
    (dk-have! `(IN (NTH ,k ,l) (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! k l 'EXPR-SET)))
    (dk-apply! u `(NTH ,k ,l))))
(define (mi-num-nn! k)                   ; (* 2 k) in NN, k in NN in context
  (dk-have! '(IN 2 NN) (lambda () (arith)))
  (if (not (dk-asm? `(IN (* 2 ,k) NN)))
      (begin (dk-have! `(AND (IN 2 NN) (IN ,k NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
             (fact 'nn-mul-closed 2 k))))

;; THE PREPARATION shared by the two: [e] in CARTESIAN(a) a sentence; the lists, their entries, their lengths;
;; the core's right side RHS of cartesian-mem a sentence.
(define (mi-cart-prep! e a)
  (let* ((x `(ENC-LIST ,e)) (ca `(ENC-CART ,a)) (n `(LENGTH ,a))
         (tp `(ENC-IN ,x (ENC-TUPLES ENC-SETC))) (le `(ENC-EQ (ENC-LENGTH ,x) (ENC-NUM ,n))) (cl `(ENC-CARTL ,x ,a ,n)))
    (dk-split! (dk-cite! 'clf-in-elim x ca))
    (dk-split! (dk-cite! 'clt-list-elim e))
    (dk-split! (dk-cite! 'clt-cart-elim a))
    (fact 'length-in-nn 'EXPR-SET a)
    (fact 'length-in-nn 'EXPR-SET e)
    (dk-have! `(<= ,n ,n) (lambda () (dk-nn!)))
    (mi-num-nn! n)
    (dk-apply! (dk-cite! 'enc-cartl-clf n) x a)
    (mi-cl-facts! x)
    (mi-cl! tp 'CLF) (mi-cl! le 'CLF)
    (dk-cite! 'clf-and-intro le cl)
    (dk-cite! 'clf-and-intro tp `(ENC-AND ,le ,cl))
    (dk-cite! 'clf-iff-intro `(ENC-IN ,x ,ca) `(ENC-AND ,tp (ENC-AND ,le ,cl)))
    (list x ca n tp le cl `(ENC-AND ,tp (ENC-AND ,le ,cl)))))

;; ROW 29, cartesian-elim: from [g + (e_k in a_k), f], [g, f]; ([e] in CARTESIAN(a)) in g.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-CARTESIAN-ELIM tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'rel-cartesian-elim 1))
       (g (car vs)) (f (cadr vs)) (e (caddr vs)) (a (cadddr vs)) (k (list-ref vs 4))
       (x `(ENC-LIST ,e)) (ca `(ENC-CART ,a)) (uu `(ENC-IN ,x ,ca)) (n `(LENGTH ,a))
       (ek `(NTH ,k ,e)) (ak `(NTH ,k ,a)) (nt `(ENC-NTH (ENC-NUM ,k) ,x)) (goal-at `(ENC-IN ,ek ,ak)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-cite! 'ctx-mem g uu)
  (let* ((pp (mi-cart-prep! e a)) (tp (list-ref pp 3)) (le (list-ref pp 4)) (cl (list-ref pp 5)) (rhs (list-ref pp 6)))
    (dk-have! `(<= ,k ,n) (lambda () (subst `(= ,n (LENGTH ,e))) (ass)))
    (dk-have! `(<= 1 ,n) (lambda () (dk-nn! `(<= 1 ,k) `(<= ,k ,n))))
    (mi-derive2! `(lemma (,g ==> ,rhs) der-iff-r (,g ,uu ,rhs) (cartesian-mem (,g ==> (ENC-IFF ,uu ,rhs))) (assumption (,g ==> ,uu))))
    (dk-split! (dk-cite! 'der-and-parts 'tt g tp `(ENC-AND ,le ,cl)))
    (dk-split! (dk-cite! 'der-and-parts 'tt g le cl))
    ;; the k-th entry of the fold
    (dk-apply! (dk-cite! 'enc-cartl-elim-der n) 'tt g x a k)
    ;; [e] denotes, the strictness of the membership; NTH(k, [e]) == e_k; the membership moved to e_k
    (dk-cite! 'clf-eq-intro x x)
    (mi-derive2! `(def-strict-in-l (,g ==> (ENC-EQ ,x ,x)) (assumption (,g ==> ,uu))))
    (mi-entry-clt! k e) (mi-entry-clt! k a)
    (mi-num-nn! k)
    (mi-cart-nth-eq! g e k)
    (dk-cite! 'der-qeq-sym 'tt g nt ek)
    (mi-cart-move! g ek nt ak)
    (dk-cite! 'clf-in-intro ek ak)
    (mi-derive2! `(cut (,g ==> ,f) (given (,g ==> ,goal-at)) (given (,(mi+ g goal-at) ==> ,f))))
    (mi-lane-close!)))
(qed 'adm-cartesian-elim)

;; the per-entry hypotheses of a relation with one hypothesis per list entry, landed as one universal of
;; derivabilities (meta-core-laws.scm's mc-rel-open-n!, copied: the helper of one file)
(define (mi-rel-open-n! rel)
  (let* ((r (dk-meta-iff-r! (dk-meta-iff! rel 'tt 'hs 'c)))
         (parts (dk-split! r))
         (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
         (ceq (dk-meta-eq-of 'c)))
    (subst ceq)
    (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
    (let* ((urel (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'NTH) (dk-contains? f 'hs)))
                                 (dk-asms))
                     (error "mi-rel-open-n!: no per-entry universal")))
           (lenl (caddr (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '(LENGTH hs)))) (dk-asms))))
           (claim (let walk ((f urel))
                    (cond ((and (pair? f) (eq? (car f) '=) (dk-head-is? (cadr f) 'NTH) (equal? (caddr (cadr f)) 'hs))
                           `(IN ,(caddr f) (DERIVABLE tt)))
                          ((pair? f) (map walk f))
                          (#t f))))
           (hu (dk-cite! 'hyps-in-all 'hs '(DERIVABLE tt))))          ; W1: HYPS-IN is bounded since VIAGAP
      (dk-have! claim
        (lambda ()
          (let* ((landed (dk-peel!))
                 (k (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
            (dk-have! `(<= ,k (LENGTH hs)) (lambda () (subst `(= (LENGTH hs) ,lenl)) (ass)))
            (let* ((m (dk-apply! hu k)) (eq (dk-apply! urel k)))
              (dk-rewrite-h! m (cadr eq) (caddr eq))
              (ass)))))
      (cons vs claim))))

;; ROW 28, cartesian-intro: from [g, e_i in a_i] for every i, [g, [e] in CARTESIAN(a)]; AX-MEM-SET in T.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-MEM-SET tt)
   (IMPLIES (REL-CARTESIAN-INTRO tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))
(dk-peel!)
(let* ((o (mi-rel-open-n! 'rel-cartesian-intro)) (vs (car o)) (hk (cdr o))
       (g (car vs)) (e (cadr vs)) (a (caddr vs))
       (x `(ENC-LIST ,e)) (ca `(ENC-CART ,a)) (uu `(ENC-IN ,x ,ca)) (n `(LENGTH ,a)) (ne `(LENGTH ,e)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g uu)))
  (let* ((pp (mi-cart-prep! e a)) (tp (list-ref pp 3)) (le (list-ref pp 4)) (cl (list-ref pp 5)) (rhs (list-ref pp 6))
         (ande `(ENC-ANDE ,e ENC-SETC ,ne)) (tf `(ENC-IFF ,tp ,ande)))
    (dk-have! `(<= ,ne ,ne) (lambda () (dk-nn!)))
    ;; 1. every entry a set
    (mi-cl! 'ENC-SETC 'CLT)
    (dk-have! `(FORALL mczk_ (IMPLIES (IN mczk_ NN) (IMPLIES (<= 1 mczk_) (IMPLIES (<= mczk_ ,ne)
                 (IN (LIST ,g (ENC-IN (NTH mczk_ ,e) ENC-SETC)) (DERIVABLE tt))))))
      (lambda ()
        (let* ((landed (dk-peel!))
               (i (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
          (dk-apply! hk i)
          (dk-cite! 'der-mem-set-gen 'tt g `(NTH ,i ,e) `(NTH ,i ,a))
          (mi-lane-close!))))
    ;; 2. the tuple of sets
    (dk-cite! 'enc-ande-clf ne e 'ENC-SETC)
    (dk-cite! 'enc-ande-der ne 'tt g e 'ENC-SETC)
    (dk-cite! 'clf-iff-intro tp ande)
    ;; K1FIX (2026-11-19): tuples-mem's premise SET = SET: reflexivity at ECONST(1), the code of SET
    (let ((ec '(ECONST 1)))
      (mi-cl! ec 'CLT)
      (dk-cite! 'clf-eq-intro ec ec)
      (mi-refl-fact! ec)
      (mi-derive2! `(reflexivity (,g ==> (ENC-EQ ,ec ,ec)) (n := 1)))
      (dk-cite! 'enc-setc-def)
      (dk-rewrite-h! (mi-der g `(ENC-EQ ,ec ,ec)) ec 'ENC-SETC)
      (dk-cite! 'clf-eq-intro 'ENC-SETC 'ENC-SETC))
    (mi-derive2! `(lemma (,g ==> ,tp) der-iff-l (,g ,tp ,ande) (tuples-mem (,g ==> ,tf) (given (,g ==> (ENC-EQ ENC-SETC ENC-SETC))))
                         (given (,g ==> ,ande))))
    ;; 3. the list denotes
    (dk-cite! 'clf-eq-intro x x)
    (mi-derive2! `(def-strict-in-l (,g ==> (ENC-EQ ,x ,x)) (given (,g ==> ,tp))))
    ;; 4. its length: LENGTH([e]) == NUM(|e|), NUM(|e|) = NUM(|e|) by reflexivity at ECONST(2 |e|), the strict
    ;;    equation by der-atom-l at the head 8, |e| = |a|
    (let* ((len `(ENC-LENGTH ,x)) (num `(ENC-NUM ,ne)) (m `(* 2 ,ne)) (ec `(ECONST ,m)))
      (mi-num-nn! ne)
      (mi-cl! len 'CLT) (mi-cl! num 'CLT)
      (dk-cite! 'clf-qeq-intro len num)
      (mi-derive2! `(length-eq (,g ==> (ENC-QEQ ,len ,num)) (given (,g ==> (ENC-EQ ,x ,x)))))
      (let ((ue (dk-cite! 'enc-num-unfold ne)))
        (mi-cl! ec 'CLT)
        (dk-cite! 'clf-eq-intro ec ec)
        (mi-refl-fact! ec)
        (mi-derive2! `(reflexivity (,g ==> (ENC-EQ ,ec ,ec)) (n := ,m)))
        (let* ((d1 (dk-rewrite-h! (mi-der g `(ENC-EQ ,ec ,ec)) ec num))
               (u8 (dk-cite! 'enc-eq-unfold num num)) (u9 (dk-cite! 'enc-eq-unfold len num)))
          (dk-have! '(IN 8 NN) (lambda () (arith)))
          (dk-cite! 'clf-eq-intro len num)
          (dk-rewrite-h! `(IN (ENC-EQ ,len ,num) CLF) `(ENC-EQ ,len ,num) (caddr u9))
          (dk-rewrite-h! d1 `(ENC-EQ ,num ,num) (caddr u8))
          (dk-cite! 'der-atom-l 'tt g 8 len num num)
          (let ((d2 (dk-rewrite-h! (mi-der g (caddr u9)) (caddr u9) `(ENC-EQ ,len ,num))))
            (dk-rewrite-h! d2 ne n)))))
    ;; 5. the fold of the entry memberships (the instantiation chains of the tuple step dropped first: dk-apply!
    ;;    reuses a chain in context whose prefix matches, and the chain of enc-ande-clf matched the per-entry
    ;;    hypothesis)
    (apply keep (filter (lambda (z) (not (dk-contains? z 'ENC-ANDE))) (dk-asms)))
    (dk-have! `(FORALL mczk_ (IMPLIES (IN mczk_ NN) (IMPLIES (<= 1 mczk_) (IMPLIES (<= mczk_ ,n)
                 (IN (LIST ,g ,(mi-cart-atom 'mczk_ x a)) (DERIVABLE tt))))))
      (lambda ()
        (let* ((landed (dk-peel!))
               (i (caddr (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) 1))) landed))))
          (dk-have! `(<= ,i ,ne) (lambda () (subst `(= ,ne ,n)) (ass)))
          (dk-apply! hk i)
          (mi-entry-clt! i e) (mi-entry-clt! i a)
          (mi-num-nn! i)
          (mi-cart-nth-eq! g e i)
          (mi-cart-move! g `(ENC-NTH (ENC-NUM ,i) ,x) `(NTH ,i ,e) `(NTH ,i ,a))
          (mi-lane-close!))))
    (dk-apply! (dk-cite! 'enc-cartl-der n) 'tt g x a)
    ;; 6. the right side, and the membership
    (mi-derive2! `(and-intro (,g ==> ,rhs) (given (,g ==> ,tp))
                    (and-intro (,g ==> (ENC-AND ,le ,cl)) (given (,g ==> ,le)) (given (,g ==> ,cl)))))
    (mi-derive2! `(lemma (,g ==> ,uu) der-iff-l (,g ,uu ,rhs) (cartesian-mem (,g ==> (ENC-IFF ,uu ,rhs))) (given (,g ==> ,rhs))))
    (mi-lane-close!)))
(qed 'adm-cartesian-intro)

;;; -----------------------------------------------------------------------
;;; N3. ROW 57, CARTESIAN-DECOMPOSE, OVER THE CORE (agent W2E, 2026-11-11; the user's decision of that day on the
;;; W2B report s.8 (1); the plan of the W2B report s.4 (a)-(f)).  The kernel's cartesian-decompose rewrites
;;; x in CARTESIAN(a_1 .. a_n) to the chain ENC-CCH(x, a, n, n) (structure-library/meta-ind.scm, J-CART):
;;; n existentials over the locally nameless innermost equation x = [IDX-LIST(n)].  The chain is read through
;;; CCHS(x, a, n, l, k), the same chain with ANY innermost list l (cchs-idx), whose opening at a depth d opens l at
;;; d + k (cchs-open).  Both directions induct on k over every list of the right shape: the entries after n - k are
;;; still indices, the first n - k already instances.
;;;   FORWARD (cchs-fwd): from x in CARTESIAN(a), the projections NTH(i, x) as witnesses (n forsome-intros, each
;;;     with its definedness premise from the strictness of the membership); the base is tuple eta (CR-TUPLE-ETA).
;;;   BACKWARD (cchs-bwd): n forsome-elims at fresh names, then cartesian-intro for the literal list of the names
;;;     (adm-cartesian-intro, AX-MEM-SET in T) and the substitution of x for the list (der-atom-l).
;;; The derived rule is der-cartesian-decompose.  Helper procedures are this file's (prefix m57-).

;; (- n k) is in NN for k <= n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= k n) (IN (- n k) NN))))))))
(dk-peel!)
(let ((d (dk-skolem! (dk-cite! 'nn-le-gap 'n 'k) #t)))
  (dk-have! `(= (- n k) ,d) (lambda () (dk-nn! `(= n (+ k ,d)))))
  (subst `(= (- n k) ,d))
  (ass))
(qed 'idx-minus-in-nn)

;;; (a) IDX-LIST(n) DENOTES: the list of the indices n - 1, .., 0 (tuple-tabulation for existence,
;;; tuple-extensionality for uniqueness, as mapl-prop of meta-syntax-laws.scm).

;; (= A B) by tuple-extensionality over SET (meta-syntax-laws.scm's mx-tuple-ext!, copied: the helper of one file)
(define (m57-tuple-ext! a b len entry!)
  (let ((claim `(= ,a ,b)))
    (dk-have! claim
      (lambda ()
        (dk-have! `(= (LENGTH ,a) (LENGTH ,b))
          (lambda ()
            (if (not (equal? `(LENGTH ,a) len)) (subst `(= (LENGTH ,a) ,len)))
            (if (not (equal? `(LENGTH ,b) len)) (subst `(= (LENGTH ,b) ,len)))
            (rfl)))
        (dk-have! `(FORALL m57k2_ (IMPLIES (AND (IN m57k2_ NN) (AND (<= 1 m57k2_) (<= m57k2_ (LENGTH ,a))))
                                           (= (NTH m57k2_ ,a) (NTH m57k2_ ,b))))
          (lambda ()
            (dk-peel!)
            (dk-split-all!)
            (let ((k (cadr (cadr (dk-goal)))))
              (if (not (dk-asm? `(<= ,k ,len)))
                  (dk-have! `(<= ,k ,len) (lambda () (subst `(= ,len (LENGTH ,a))) (ass))))
              (entry! k))))
        (fact 'tuple-extensionality 'SET a b)
        (ass)))
    claim))
(define (m57-ent-univ lst len)
  `(FORALL m57i_ (IMPLIES (IN m57i_ NN) (IMPLIES (<= 1 m57i_) (IMPLIES (<= m57i_ ,len)
      (= (NTH m57i_ ,lst) (EBVAR (- n m57i_))))))))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
   (AND (IN (IDX-LIST n) (TUPLES EXPR-SET))
        (AND (= (LENGTH (IDX-LIST n)) n)
             (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i n)
               (= (NTH i (IDX-LIST n)) (EBVAR (- n i)))))))))))))
(dk-peel!)
(let* ((tabf '(VNB-LAMBDA m57t_ NN (EBVAR (- n m57t_))))
       (len 'n)
       (val-type! (lambda (i) (fact 'idx-minus-in-nn 'n i) (fact 'ebvar-in-expr `(- n ,i))))
       (tabh `(FORALL i_ (IMPLIES (AND (IN i_ NN) (AND (<= 1 i_) (<= i_ ,len))) (IN (,tabf i_) EXPR-SET)))))
  (dk-have! tabh
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let ((i (cadr (cadr (dk-goal)))))
        (val-type! i)
        (if (not (dk-lam-b!)) (ass)))))
  (fact 'tuple-tabulation len 'EXPR-SET tabf)
  (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'm57t_))) "the tabulation"))
         (ll (dk-skolem! ex)))
    (dk-split-all!)
    (let* ((tu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ll) (dk-contains? f 'm57t_)))
                        "the tabulated entries"))
           (ent-l (m57-ent-univ ll len))
           (incl (dk-meta-incl! 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))))
      (dk-have! ent-l
        (lambda ()
          (dk-peel!)
          (let ((i (cadr (cadr (dk-goal)))))
            (dk-meta-and! `(IN ,i NN) `(<= 1 ,i) `(<= ,i ,len))
            (dk-apply! tu i)
            (subst `(= (NTH ,i ,ll) (,tabf ,i)))
            (val-type! i)
            (if (not (dk-lam-b!)) (rfl)))))
      (dk-apply! (dk-cite! 'tuples-mono 'EXPR-SET 'SET) ll)
      (mac 'IDX-LIST)
      (let* ((io (let find ((e (dk-goal)))
                   (cond ((and (pair? e) (eq? (car e) 'IOTA)) e)
                         ((pair? e) (or (find (car e)) (find (cdr e))))
                         (#t #f))))
             (same! (lambda (other ent-other)
                      (m57-tuple-ext! ll other len
                        (lambda (k)
                          (dk-apply! ent-l k)
                          (dk-apply! ent-other k)
                          (val-type! k)
                          (subst `(= (NTH ,k ,ll) (EBVAR (- n ,k))))
                          (subst `(= (NTH ,k ,other) (EBVAR (- n ,k))))
                          (rfl))))))
        (dk-each-leaf! (lambda () (iota-d io))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (begin
                  (ew ll)
                  (dk-each-leaf! (lambda () (di))
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'FORALL)
                          (let* ((landed (dk-peel!))
                                 (y (caddr (dk-goal))))
                            (dk-split-all!)
                            (let ((ent-y (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH mii_ ,y))))
                                                  "the entries of the second list")))
                              (same! y ent-y)))
                          (dk-conj-close! (lambda () (ass)))))))
                (let* ((ent-io (begin
                                 (dk-split-all!)
                                 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH mii_ ,io))))
                                          "the entries of the description"))))
                  (same! io ent-io)
                  (subst `(= ,io ,ll))
                  (dk-conj-close! (lambda () (ass)))))))))))
(qed 'idx-list-prop)

;; the two leaves of a fixed-parameter induction (dk-ni-fixed!), base first.  (dk-meta-ni-cases-fixed! tells them
;; apart by the step's shape, which a base case with a guarded NN universal in front also has.)
(define (m57-ni-cases! hoist)
  (let ((r (dk-ni-fixed! hoist))) (list (cdr (assq 'base r)) (cdr (assq 'step r)))))

;;; (b) THE PARAMETRISED CHAIN.  ENC-CCH is CCHS at the innermost list IDX-LIST(n).
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL x (FORALL a (FORALL n (IMPLIES (IN n NN)
   (== (ENC-CCH x a n k) (CCHS x a n (IDX-LIST n) k))))))))))
(let ((cs (m57-ni-cases! '(x a n))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((o (cadr (dk-goal))) (x (cadr o)) (a (caddr o)) (n (cadddr o)))
    (dk-split! (dk-cite! 'idx-list-prop n))
    (subst (dk-cite! 'enc-cch-zero x a n))
    (subst (dk-cite! 'cchs-zero x a n `(IDX-LIST ,n)))
    (qrfl))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f '==) (dk-contains? f 'ENC-CCH))) landed))
         (o (cadr (dk-goal))) (x (cadr o)) (a (caddr o)) (n (cadddr o)) (sk (car (cddddr o))) (k (cadr sk)))
    (dk-split! (dk-cite! 'idx-list-prop n))
    (subst (dk-cite! 'enc-cch-succ x a n k))
    (subst (dk-cite! 'cchs-succ x a n `(IDX-LIST ,n) k))
    (subst ih)
    (qrfl)))
(qed 'cchs-idx)

;; the typing of encoded expressions built from the chain's constructors (lists given by name are typed in context)
(define (m57-expr! e)
  (cond ((dk-asm? `(IN ,e EXPR-SET)) #t)
        ((mi-cl-facts! e) #t)
        ((and (pair? e) (memq (car e) '(ENC-EQ ENC-IN ENC-AND ENC-LIST ENC-EX ENC-CART)))
         (let* ((eqn (mi-unfold-eq0 e)) (u (caddr eqn)))
           (m57-expr! u)
           (dk-have! `(IN ,e EXPR-SET) (lambda () (subst eqn) (ass)))))
        ((and (pair? e) (eq? (car e) 'EAPP))
         (mi-nn! (cadr e)) (m57-tuple! (caddr e)) (fact 'eapp-in-expr (cadr e) (caddr e)))
        ((and (pair? e) (eq? (car e) 'EBIND))
         (mi-nn! (cadr e)) (mi-nn! (caddr e)) (m57-tuple! (cadddr e)) (m57-expr! (car (cddddr e)))
         (apply fact 'ebind-in-expr (cdr e)))
        (#t (mi-expr! e))))
(define (m57-tuple! l)
  (cond ((dk-asm? `(IN ,l (TUPLES EXPR-SET))) #t)
        ((and (pair? l) (eq? (car l) 'LIST))
         (for-each m57-expr! (cdr l))
         (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti))))))
        (#t (error "m57-tuple!: cannot type the list" (expression->string l)))))
;; the entry a_(n - k) of the chain's level k + 1, with succ k <= n <= |a| in context: its index typed and in
;; range, the entry a closed term (the MAKE-SET universal of a in context); returns the entry
(define (m57-level-entry! n k a)
  (let ((i `(- ,n ,k)))
    (if (not (dk-asm? `(<= ,k ,n))) (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,n)))))
    (fact 'idx-minus-in-nn n k)
    (dk-have! `(<= 1 ,i) (lambda () (dk-nn! `(<= (succ ,k) ,n))))
    (dk-have! `(<= ,i ,n) (lambda () (dk-nn!)))
    (dk-meta-len-nn! a 'EXPR-SET)
    (dk-have! `(<= ,i (LENGTH ,a)) (lambda () (dk-nn! `(<= ,n (LENGTH ,a)))))
    (mi-entry-clt! i a)
    (mi-cl-facts! `(NTH ,i ,a))
    `(NTH ,i ,a)))

;; (IN (+ p q) NN), p and q in NN in context
(define (m57-add-nn! p q)
  (if (not (dk-asm? `(IN (+ ,p ,q) NN)))
      (begin
        (dk-have! `(AND (IN ,p NN) (IN ,q NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'nn-add-closed p q))))

(define m57-msa '(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET a)) (IN mczu_ CLT))))

;; the chain is an expression
(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL x (FORALL a (FORALL n (FORALL l
   (IMPLIES (IN x CLT) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN) (IMPLIES (<= n (LENGTH a))
   (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (<= k n) (IN (CCHS x a n l k) EXPR-SET))))))))))))))))
(let ((cs (m57-ni-cases! '(x a n l))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((o (cadr (dk-goal))) (x (cadr o)) (a (caddr o)) (n (cadddr o)) (l (car (cddddr o))))
    (subst (dk-cite! 'cchs-zero x a n l))
    (dk-close-if! (lambda () (m57-expr! `(ENC-EQ ,x (ENC-LIST ,l)))) (lambda () (ass))))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'CCHS))) landed))
         (o (cadr (dk-goal))) (x (cadr o)) (a (caddr o)) (n (cadddr o)) (l (car (cddddr o)))
         (sk (cadr (cddddr o))) (k (cadr sk)))
    (subst (dk-cite! 'cchs-succ x a n l k))
    (let ((e (m57-level-entry! n k a)))
      (let w1 ((f ih)) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))
      (dk-close-if! (lambda () (m57-expr! `(ENC-EX (ENC-AND (ENC-IN (EBVAR 0) ,e) (CCHS ,x ,a ,n ,l ,k))))) (lambda () (ass))))))
(qed 'cchs-expr)

;; the list map of OPEN-FUN, read off: its entries are the opened entries
(sp (make-wff '(FORALL u (FORALL l (FORALL ix (IMPLIES (IN u EXPR-SET) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (IN ix NN)
   (AND (IN (MAPLK (OPEN-FUN u) l ix) (TUPLES EXPR-SET))
        (AND (= (LENGTH (MAPLK (OPEN-FUN u) l ix)) (LENGTH l))
             (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l))
               (= (NTH i (MAPLK (OPEN-FUN u) l ix)) (EXPR-OPEN (NTH i l) ix u))))))))))))))))
(dk-peel!)
(let* ((mm '(MAPLK (OPEN-FUN u) l ix))
       (val! (lambda (i)       ; i typed in range: NTH(i, l) and its opening are expressions
               (dk-meta-nth-in! 'EXPR-SET i 'l)
               (fact 'open-in-expr 'u 'ix `(NTH ,i l))))
       (beta! (lambda ()       ; the goal's (OPEN-FUN u) applied, unfolded and contracted
                (subst (dk-cite! 'open-fun-unfold 'u))
                (dk-lam-b!))))   ; returns whether the leaf it started on is grounded
  (dk-meta-len-nn! 'l 'EXPR-SET)
  (dk-have! '(FORALL m57q_ (IMPLIES (IN m57q_ NN) (IMPLIES (<= 1 m57q_) (IMPLIES (<= m57q_ (LENGTH l))
               (IN ((OPEN-FUN u) (NTH m57q_ l) ix) EXPR-SET)))))
    (lambda ()
      (let* ((ld (dk-peel!)) (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld))))
        (val! i)
        (if (not (beta!)) (ass)))))
  (dk-split-all! (list (dk-cite! 'maplk-prop 'EXPR-SET '(OPEN-FUN u) 'l 'ix)))
  (let ((ents (mi-entries-of mm)))
    (dk-have! '(FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l))
                 (= (NTH i (MAPLK (OPEN-FUN u) l ix)) (EXPR-OPEN (NTH i l) ix u))))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld))))
          (val! i)
          (subst (dk-apply! ents i))
          (if (not (beta!)) (rfl)))))
    (dk-conj-close! (lambda () (ass)))))
(qed 'maplk-open)

;; THE OPENED BODY at the depth 0: OPEN(AND(EBVAR 0 in A, C), 0, t) = AND(t in A, OPEN(C, 0, t)), A a closed term
(sp (make-wff '(FORALL t (FORALL aa (FORALL c (IMPLIES (IN t EXPR-SET) (IMPLIES (IN aa CLT) (IMPLIES (IN c EXPR-SET)
   (== (EXPR-OPEN (ENC-AND (ENC-IN (EBVAR 0) aa) c) 0 t) (ENC-AND (ENC-IN t aa) (EXPR-OPEN c 0 t)))))))))))
(dk-peel!)
(let* ((p '(ENC-IN (EBVAR 0) aa)) (oc '(EXPR-OPEN c 0 t)))
  (mi-cl-facts! 'aa)
  (mi-nn! 0) (mi-nn! 3) (mi-nn! 7)
  (m57-expr! p)
  (fact 'open-in-expr 't 0 'c)
  (subst (dk-cite! 'enc-and-unfold p 'c))
  (subst (dk-cite! 'open-app2 't 0 3 p 'c))
  (subst (dk-cite! 'enc-in-unfold '(EBVAR 0) 'aa))
  (subst (dk-cite! 'open-app2 't 0 7 '(EBVAR 0) 'aa))
  (subst (dk-cite! 'open-ebvar-hit 't 0))
  (subst (dk-cite! 'lc-open 't 'aa 0))
  (subst (dk-cite! 'enc-in-unfold 't 'aa))
  (subst (dk-cite! 'enc-and-unfold '(EAPP 7 (LIST t aa)) oc))
  (qrfl))
(qed 'cchs-open-body)

;;; (c) THE OPEN LAW.  For x and the entries of a closed: OPEN(CCHS(l, k), d, u) == CCHS(MAPLK(OPEN-FUN u, l, d + k), k),
;;; by induction on k through open-app2, open-ebind, maplk-nil, open-ebvar-miss and lc-open.
(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL x (FORALL a (FORALL n (FORALL l (FORALL u
   (IMPLIES (IN x CLT) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN) (IMPLIES (<= n (LENGTH a))
   (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (IN u EXPR-SET)
   (FORALL d (IMPLIES (IN d NN) (IMPLIES (<= k n)
     (== (EXPR-OPEN (CCHS x a n l k) d u) (CCHS x a n (MAPLK (OPEN-FUN u) l (+ d k)) k)))))))))))))))))))))
(let ((cs (m57-ni-cases! '(x a n l u))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((gl (dk-goal)) (lhs (cadr gl)) (ch (cadr lhs)) (d (caddr lhs)) (u (cadddr lhs))
         (x (cadr ch)) (a (caddr ch)) (n (cadddr ch)) (l (car (cddddr ch)))
         (rl `(MAPLK (OPEN-FUN ,u) ,l ,d))
         (el `(ENC-LIST ,l)))
    (mi-cl-facts! x)
    (mi-nn! 8) (mi-nn! 17)
    (m57-expr! el)
    (dk-have! `(= (+ ,d 0) ,d) (lambda () (dk-nn!)))
    (subst `(= (+ ,d 0) ,d))
    (dk-split-all! (list (dk-cite! 'maplk-open u l d)))
    (subst (dk-cite! 'cchs-zero x a n l))
    (subst (dk-cite! 'cchs-zero x a n rl))
    (subst (dk-cite! 'enc-eq-unfold x el))
    (subst (dk-cite! 'open-app2 u d 8 x el))
    (subst (dk-cite! 'lc-open u x d))
    (subst (dk-cite! 'enc-list-unfold l))
    (subst (dk-cite! 'open-eapp u d 17 l))
    (subst (dk-cite! 'enc-eq-unfold x `(ENC-LIST (MAPLK (OPEN-FUN ,u) ,l ,d))))
    (subst (dk-cite! 'enc-list-unfold `(MAPLK (OPEN-FUN ,u) ,l ,d)))
    (qrfl))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CCHS) (dk-contains? f 'EXPR-OPEN))) landed))
         (gl (dk-goal)) (lhs (cadr gl)) (ch (cadr lhs)) (d (caddr lhs)) (u (cadddr lhs))
         (x (cadr ch)) (a (caddr ch)) (n (cadddr ch)) (l (car (cddddr ch))) (sk (cadr (cddddr ch))) (k (cadr sk))
         (rl (car (cddddr (caddr gl))))
         (d1 `(+ ,d 1)))
    (if (not ih) (error "cchs-open: no induction hypothesis"))
    (let* ((e (m57-level-entry! n k a))
           (c `(CCHS ,x ,a ,n ,l ,k))
           (p `(ENC-IN (EBVAR 0) ,e))
           (bd `(ENC-AND ,p ,c)))
      (mi-nn! 0) (mi-nn! 1) (mi-nn! 3) (mi-nn! 7) (mi-nn! 21)
      (m57-add-nn! d 1)
      (fact 'nn-succ-closed k)
      (m57-add-nn! d `(succ ,k))
      (dk-split-all! (list (dk-cite! 'maplk-open u l `(+ ,d (succ ,k)))))
      (dk-cite! 'cchs-expr k x a n l)
      (m57-expr! bd)
      (dk-have! '(IN (LIST) (TUPLES EXPR-SET)) (lambda () (ti)))
      (subst (dk-cite! 'cchs-succ x a n l k))
      (subst (dk-cite! 'cchs-succ x a n rl k))
      (subst (dk-cite! 'enc-ex-unfold bd))
      (subst (dk-cite! 'open-ebind u d 21 1 '(LIST) bd))
      (subst (dk-cite! 'maplk-nil u d))
      (subst (dk-cite! 'enc-and-unfold p c))
      (subst (dk-cite! 'open-app2 u d1 3 p c))
      (subst (dk-cite! 'enc-in-unfold '(EBVAR 0) e))
      (subst (dk-cite! 'open-app2 u d1 7 '(EBVAR 0) e))
      (dk-have! `(NOT (= 0 ,d1)) (lambda () (dk-nn!)))
      (subst (dk-cite! 'open-ebvar-miss u d1 0))
      (subst (dk-cite! 'lc-open u e d1))
      (subst (dk-apply! ih d1))
      (dk-have! `(= (+ ,d1 ,k) (+ ,d (succ ,k))) (lambda () (dk-nn!)))
      (subst `(= (+ ,d1 ,k) (+ ,d (succ ,k))))
      (let ((c2 `(CCHS ,x ,a ,n (MAPLK (OPEN-FUN ,u) ,l (+ ,d (succ ,k))) ,k))
            (pu `(EAPP 7 (LIST (EBVAR 0) ,e))))
        (dk-cite! 'cchs-expr k x a n `(MAPLK (OPEN-FUN ,u) ,l (+ ,d (succ ,k))))
        (m57-expr! `(ENC-AND ,pu ,c2))
        (subst (dk-cite! 'enc-ex-unfold `(ENC-AND ,pu ,c2)))
        (subst (dk-cite! 'enc-and-unfold pu c2))
        (qrfl)))))
(qed 'cchs-open)

;;; The shape of an innermost list at the level k (the chain's last k binders still open): the entries j with
;;; j + k <= n are instances (the projections of x, forward; members of the factors, backward), the entries with
;;; n < j + k the indices n - j.
(define (m57-c1 x n l k)
  `(FORALL m57j_ (IMPLIES (IN m57j_ NN) (IMPLIES (<= 1 m57j_) (IMPLIES (<= m57j_ ,n) (IMPLIES (<= (+ m57j_ ,k) ,n)
      (= (NTH m57j_ ,l) (ENC-NTH (ENC-NUM m57j_) ,x))))))))
(define (m57-c2 n l k)
  `(FORALL m57j_ (IMPLIES (IN m57j_ NN) (IMPLIES (<= 1 m57j_) (IMPLIES (<= m57j_ ,n) (IMPLIES (< ,n (+ m57j_ ,k))
      (= (NTH m57j_ ,l) (EBVAR (- ,n m57j_)))))))))
(define (m57-h5 g x a n)
  `(FORALL m57j_ (IMPLIES (IN m57j_ NN) (IMPLIES (<= 1 m57j_) (IMPLIES (<= m57j_ ,n)
      (IN (LIST ,g (ENC-IN (ENC-NTH (ENC-NUM m57j_) ,x) (NTH m57j_ ,a))) (DERIVABLE tt)))))))
(define (m57-bm h a n l k)
  `(FORALL m57j_ (IMPLIES (IN m57j_ NN) (IMPLIES (<= 1 m57j_) (IMPLIES (<= m57j_ ,n) (IMPLIES (<= (+ m57j_ ,k) ,n)
      (IN (LIST ,h (ENC-IN (NTH m57j_ ,l) (NTH m57j_ ,a))) (DERIVABLE tt))))))))

;; a universal landed earlier, picked by its shape
(define (m57-univ-of fs pred what)
  (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (pred f))) fs) (error "m57: no universal" what)))
;; the index j of a peeled entry universal: the variable of the landed (IN j NN)
(define (m57-peeled-index ld)
  (cadr (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (symbol? (cadr f)))) ld)
            (error "m57: no index landed"))))
;; [g, f] derivable in context: its context and formula typed, f's components too when f is a membership
(define (m57-seq-facts! g f)
  (dk-cite! 'der-in-seq 'tt `(LIST ,g ,f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (if (dk-head-is? f 'ENC-IN) (dk-split! (dk-cite! 'clf-in-elim (cadr f) (caddr f)))))
;; with (<= (+ j k) n) in context: (<= (+ j (succ k)) n) or (= (+ j k) n), as the two branches
(define (m57-split-level! j k n before! at!)
  (use-em `(= (+ ,j ,k) ,n)
    (lambda () (at!))
    (lambda ()
      (dk-have! `(AND (IN ,j NN) (IN ,k NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (fact 'nn-add-closed j k)
      (dk-have! `(NOT (= ,n (+ ,j ,k)))
        (lambda ()
          (di)
          (dk-have! `(= (+ ,j ,k) ,n) (lambda () (dk-nn! `(= ,n (+ ,j ,k)))))
          (ai `(NOT (= (+ ,j ,k) ,n)))))
      (dk-cite! 'nn-le-ne-succ `(+ ,j ,k) n)
      (dk-have! `(<= (+ ,j (succ ,k)) ,n) (lambda () (dk-nn! `(<= (succ (+ ,j ,k)) ,n))))
      (before!))))

;;; (d) THE FORWARD DIRECTION.  From [g, x in CARTESIAN(a)] (and its componentwise memberships, h5), the chain at
;;; the level k for every innermost list of the level's shape: by induction on k, the level k + 1 by forsome-intro
;;; at the projection NTH(n - k, x) (its definedness by the strictness of its membership), the level 0 by tuple eta.
(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL tt (FORALL g (FORALL x (FORALL a (FORALL n
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN x CLT) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN)
   (IMPLIES (= (LENGTH a) n) (IMPLIES (<= 1 n) (IMPLIES (IN (LIST g (ENC-IN x (ENC-CART a))) (DERIVABLE tt))
   (IMPLIES ,(m57-h5 'g 'x 'a 'n)
   (FORALL l (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES (= (LENGTH l) n) (IMPLIES (<= k n)
   (IMPLIES ,(m57-c1 'x 'n 'l 'k) (IMPLIES ,(m57-c2 'n 'l 'k) (IMPLIES (IN (CCHS x a n l k) CLF)
     (IN (LIST g (CCHS x a n l k)) (DERIVABLE tt)))))))))))))))))))))))))))
(let ((cs (m57-ni-cases! '(tt g x a n))))
  ;; the level 0: tuple eta
  (dk-focus! (car cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (gl (dk-goal)) (sq (cadr gl)) (g (cadr sq)) (ch (caddr sq))
         (x (cadr ch)) (a (caddr ch)) (n (cadddr ch)) (l (car (cddddr ch)))
         (c1 (m57-univ-of landed (lambda (f) (and (dk-contains? f 'ENC-NTH) (dk-contains? f `(NTH m57j_ ,l)))) "c1"))
         (eqf `(ENC-EQ ,x (ENC-LIST ,l)))
         (mem `(ENC-IN ,x (ENC-CART ,a))))
    (subst (dk-cite! 'cchs-zero x a n l))
    (dk-rewrite-h! `(IN (CCHS ,x ,a ,n ,l 0) CLF) `(CCHS ,x ,a ,n ,l 0) eqf)
    (dk-have! `(<= 1 (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,a) ,n)) (ass)))
    (dk-have! `(= (LENGTH ,l) (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,a) ,n)) (ass)))
    (dk-have! `(FORALL mci_ (IMPLIES (IN mci_ NN) (IMPLIES (<= 1 mci_) (IMPLIES (<= mci_ (LENGTH ,a))
                 (= (NTH mci_ ,l) (ENC-NTH (ENC-NUM mci_) ,x))))))
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-have! `(<= ,j ,n) (lambda () (subst `(= ,n (LENGTH ,a))) (ass)))
          (dk-have! `(<= (+ ,j 0) ,n) (lambda () (dk-nn! `(<= ,j ,n))))
          (dk-apply! c1 j)
          (mi-lane-close!))))
    (m57-seq-facts! g mem)
    (mi-derive2! `(tuple-eta (,g ==> ,eqf) (given (,g ==> ,mem))))
    (mi-lane-close!))
  ;; the level k + 1: forsome-intro at the projection
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (gl (dk-goal)) (sq (cadr gl)) (g (cadr sq)) (ch (caddr sq))
         (x (cadr ch)) (a (caddr ch)) (n (cadddr ch)) (l (car (cddddr ch))) (sk (cadr (cddddr ch))) (k (cadr sk))
         (ih (m57-univ-of landed (lambda (f) (and (dk-contains? f 'CCHS) (dk-contains? f 'DERIVABLE))) "the induction hypothesis"))
         (h5 (m57-univ-of landed (lambda (f) (and (dk-contains? f 'DERIVABLE) (dk-contains? f 'ENC-NTH) (not (dk-contains? f 'CCHS)))) "h5"))
         (c1 (m57-univ-of landed (lambda (f) (and (dk-contains? f 'ENC-NTH) (dk-contains? f `(NTH m57j_ ,l)) (not (dk-contains? f 'DERIVABLE)))) "c1"))
         (c2 (m57-univ-of landed (lambda (f) (and (dk-contains? f 'EBVAR) (dk-contains? f `(NTH m57j_ ,l)))) "c2"))
         (i `(- ,n ,k))
         (e `(NTH ,i ,a))
         (t `(ENC-NTH (ENC-NUM ,i) ,x))
         (c `(CCHS ,x ,a ,n ,l ,k))
         (bd `(ENC-AND (ENC-IN (EBVAR 0) ,e) ,c))
         (exb `(ENC-EX ,bd))
         (p1 `(ENC-IN ,t ,e))
         (l2 `(MAPLK (OPEN-FUN ,t) ,l ,k))
         (cc2 `(CCHS ,x ,a ,n ,l2 ,k)))
    (subst (dk-cite! 'cchs-succ x a n l k))
    (dk-rewrite-h! `(IN (CCHS ,x ,a ,n ,l (succ ,k)) CLF) `(CCHS ,x ,a ,n ,l (succ ,k)) exb)
    (dk-have! `(<= ,n (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,a) ,n)) (dk-nn!)))
    (m57-level-entry! n k a)
    ;; the projection: its membership, its typing, its definedness
    (dk-apply! h5 i)
    (m57-seq-facts! g p1)
    (mi-cl-facts! t)
    (dk-cite! 'clf-eq-intro t t)
    (mi-derive2! `(def-strict-in-l (,g ==> (ENC-EQ ,t ,t)) (given (,g ==> ,p1))))
    ;; the open law at the depth 0 and the opened body
    (dk-cite! 'cchs-expr k x a n l)
    (mi-nn! 0)
    (let* ((eo0 (dk-cite! 'cchs-open k x a n l t 0))
           (eoc (begin (dk-have! `(= (+ 0 ,k) ,k) (lambda () (dk-nn!))) (dk-rewrite-h! eo0 `(+ 0 ,k) k)))
           (eob (dk-cite! 'cchs-open-body t e c))
           (ob `(EXPR-OPEN ,bd 0 ,t)))
      ;; the instance is a sentence, so is the next level's chain
      (dk-cite! 'clf-open-inst-ex bd t)
      (let* ((f1 (dk-rewrite-h! `(IN ,ob CLF) ob (caddr eob)))
             (f2 (dk-rewrite-h! f1 `(EXPR-OPEN ,c 0 ,t) cc2)))
        (dk-split! (dk-cite! 'clf-and-elim p1 cc2)))
      ;; the next level's list
      (dk-split-all! (list (dk-cite! 'maplk-open t l k)))
      (let ((ents (mi-entries-of l2)))
        (dk-have! `(= (LENGTH ,l2) ,n) (lambda () (subst `(= (LENGTH ,l2) (LENGTH ,l))) (ass)))
        ;; its instances: the old ones (closed, unchanged), and the projection at n - k (the index k opened)
        (dk-have! (m57-c1 x n l2 k)
          (lambda ()
            (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)) (pj `(ENC-NTH (ENC-NUM ,j) ,x)))
              (dk-have! `(<= ,j (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) ,n)) (ass)))
              (subst (dk-apply! ents j))
              (m57-split-level! j k n
                (lambda ()
                  (subst (dk-apply! c1 j))
                  (dk-apply! h5 j)
                  (m57-seq-facts! g `(ENC-IN ,pj (NTH ,j ,a)))
                  (mi-cl-facts! pj)
                  (subst (dk-cite! 'lc-open t pj k))
                  (rfl))
                (lambda ()
                  (dk-have! `(< ,n (+ ,j (succ ,k))) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                  (subst (dk-apply! c2 j))
                  (dk-have! `(= (- ,n ,j) ,k) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                  (subst `(= (- ,n ,j) ,k))
                  (subst (dk-cite! 'open-ebvar-hit t k))
                  (dk-have! `(= ,j ,i) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                  (subst `(= ,j ,i))
                  (rfl))))))
        ;; its indices: unchanged (an index n - j < k is not the index k)
        (dk-have! (m57-c2 n l2 k)
          (lambda ()
            (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)) (lt (find-first (lambda (f) (dk-head-is? f '<)) ld)))
              (dk-have! `(<= ,j (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) ,n)) (ass)))
              (subst (dk-apply! ents j))
              (dk-have! `(< ,n (+ ,j (succ ,k))) (lambda () (dk-nn! lt)))
              (subst (dk-apply! c2 j))
              (fact 'idx-minus-in-nn n j)
              (dk-have! `(NOT (= (- ,n ,j) ,k)) (lambda () (dk-nn! lt)))
              (subst (dk-cite! 'open-ebvar-miss t k `(- ,n ,j)))
              (fact 'ebvar-in-expr `(- ,n ,j))
              (rfl))))
        ;; the induction hypothesis at the next list, then and-intro and forsome-intro
        (let ((d (let w1 ((f (dk-apply! ih l2))) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))))
          (if (not (equal? d (mi-der g cc2))) (error "cchs-fwd: the induction hypothesis did not detach" (expression->string d))))
        (mi-derive2! `(and-intro (,g ==> (ENC-AND ,p1 ,cc2)) (given (,g ==> ,p1)) (given (,g ==> ,cc2))))
        (dk-have! (mi-der g ob) (lambda () (subst eob) (subst eoc) (ass)))
        (mi-derive2! `(forsome-intro (,g ==> ,exb) (given (,g ==> ,ob)) (given (,g ==> (ENC-EQ ,t ,t)))))
        (mi-lane-close!)))))
(qed 'cchs-fwd)


;; (IN (ENC-EQ p q) CLF) in context, p and q expressions: land (IN p CLT) and (IN q CLT) (clf-rel2 through the
;; unfolding; meta-def-laws.scm's clf-eq-elim loads after this file)
(define (m57-eq-clt! p q)
  (m57-expr! p) (m57-expr! q) (mi-nn! 8)
  (let ((u (dk-cite! 'enc-eq-unfold p q)))
    (dk-rewrite-h! `(IN (ENC-EQ ,p ,q) CLF) `(ENC-EQ ,p ,q) (caddr u))
    (dk-have! '(<= 7 8) (lambda () (arith)))
    (dk-have! '(<= 8 9) (lambda () (arith)))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clf-rel2 8 p q)))))
;; statement builders: nested implications and universals
(define (m57-imps hs c) (if (null? hs) c `(IMPLIES ,(car hs) ,(m57-imps (cdr hs) c))))
(define (m57-alls vs b) (if (null? vs) b `(FORALL ,(car vs) ,(m57-alls (cdr vs) b))))
;; the indices of the next level's list L2 = MAPLK(OPEN-FUN t, L, k) are unchanged: an index n - j < k is not k
;; (C2 the old list's index universal at the level k + 1, ENTS the entries of L2)
(define (m57-c2-next! n l l2 k t c2 ents)
  (dk-have! (m57-c2 n l2 k)
    (lambda ()
      (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)) (lt (find-first (lambda (f) (dk-head-is? f '<)) ld)))
        (dk-have! `(<= ,j (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) ,n)) (ass)))
        (subst (dk-apply! ents j))
        (dk-have! `(< ,n (+ ,j (succ ,k))) (lambda () (dk-nn! lt)))
        (subst (dk-apply! c2 j))
        (fact 'idx-minus-in-nn n j)
        (dk-have! `(NOT (= (- ,n ,j) ,k)) (lambda () (dk-nn! lt)))
        (subst (dk-cite! 'open-ebvar-miss t k `(- ,n ,j)))
        (fact 'ebvar-in-expr `(- ,n ,j))
        (rfl)))))

;;; (e) THE BACKWARD DIRECTION.  From [h, chain at the level k] for an innermost list of the level's shape (its
;;; instances members of the factors, derivably in h), [h, x in CARTESIAN(a)]: by induction on k, for every h and
;;; every list.  The level k + 1 by forsome-elim at a name y fresh for h + EX(..) and the goal, the opened body split
;;; by and-elim, the induction hypothesis at the extended context and the list opened at y; the level 0 by
;;; cartesian-intro for the innermost list (adm-cartesian-intro) and the substitution of x for it (der-atom-l).
(sp (make-wff `(FORALL k (IMPLIES (IN k NN)
   ,(m57-alls '(tt x a n)
      (m57-imps (list '(SUBSET tt CLF) '(IN AX-MEM-SET tt) '(IN x CLT) '(IN a (TUPLES EXPR-SET)) m57-msa '(IN n NN)
                      '(= (LENGTH a) n) '(<= 1 n) '(IN (ENC-IN x (ENC-CART a)) CLF))
        `(FORALL h (IMPLIES (IN h CTX-SET) (FORALL l
           ,(m57-imps (list '(IN l (TUPLES EXPR-SET)) '(= (LENGTH l) n) '(<= k n) (m57-c2 'n 'l 'k) (m57-bm 'h 'a 'n 'l 'k)
                            '(IN (LIST h (CCHS x a n l k)) (DERIVABLE tt)))
              '(IN (LIST h (ENC-IN x (ENC-CART a))) (DERIVABLE tt))))))))))))
(let ((cs (m57-ni-cases! '(tt x a n))))
  ;; the level 0: cartesian-intro for the list l, then x = [l]
  (dk-focus! (car cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (gl (dk-goal)) (sq (cadr gl)) (h (cadr sq)) (mem (caddr sq)) (x (cadr mem)) (ca (caddr mem)) (a (cadr ca))
         (dch (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'CCHS) (dk-contains? f 'DERIVABLE))) landed)
                  (error "cchs-bwd: no chain derivability")))
         (ch (caddr (cadr dch))) (n (cadddr ch)) (l (car (cddddr ch)))
         (bm (m57-univ-of landed (lambda (f) (and (dk-contains? f 'DERIVABLE) (dk-contains? f `(NTH m57j_ ,l)))) "bm"))
         (el `(ENC-LIST ,l)) (eqf `(ENC-EQ ,x ,el)) (lm `(ENC-IN ,el ,ca)) (c `(LIST ,h ,lm))
         (mj (lambda (j) `(ENC-IN (NTH ,j ,l) (NTH ,j ,a))))
         (bm0 `(FORALL m57j_ (IMPLIES (IN m57j_ NN) (IMPLIES (<= 1 m57j_) (IMPLIES (<= m57j_ ,n)
                 (IN (LIST ,h ,(mj 'm57j_)) (DERIVABLE tt))))))))
    (dk-cite! 'cchs-zero x a n l)
    (dk-rewrite-h! dch `(CCHS ,x ,a ,n ,l 0) eqf)
    (dk-have! bm0
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-have! `(<= (+ ,j 0) ,n) (lambda () (dk-nn! `(<= ,j ,n))))
          (dk-apply! bm j)
          (mi-lane-close!))))
    ;; the premises of cartesian-intro, tabulated: hs with entries [h, l_i in a_i]
    (let* ((tabf `(VNB-LAMBDA m57q_ NN (LIST ,h ,(mj 'm57q_))))
           (seq! (lambda (i)       ; i typed in range: [h, l_i in a_i] derivable, a sequent
                   (dk-apply! bm0 i)
                   (dk-cite! 'der-in-seq 'tt `(LIST ,h ,(mj i)))))
           (tabh `(FORALL i_ (IMPLIES (AND (IN i_ NN) (AND (<= 1 i_) (<= i_ ,n))) (IN (,tabf i_) SEQ-SET)))))
      (dk-have! tabh
        (lambda ()
          (dk-peel!)
          (dk-split-all!)
          (let ((i (cadr (cadr (dk-goal)))))
            (seq! i)
            (if (not (dk-lam-b!)) (ass)))))
      (fact 'tuple-tabulation n 'SEQ-SET tabf)
      (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'm57q_))) "the tabulation"))
             (hs (dk-skolem! ex)))
        (dk-split-all!)
        (let* ((tu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f hs) (dk-contains? f 'm57q_)))
                            "the tabulated premises"))
               (ent! (lambda (i)      ; i typed, 1 <= i <= n in context: (= (NTH i hs) [h, l_i in a_i])
                       (dk-meta-and! `(IN ,i NN) `(<= 1 ,i) `(<= ,i ,n))
                       (dk-apply! tu i)
                       (dk-have! `(= (NTH ,i ,hs) (LIST ,h ,(mj i)))
                         (lambda ()
                           (subst `(= (NTH ,i ,hs) (,tabf ,i)))
                           (seq! i)
                           (if (not (dk-lam-b!)) (rfl)))))))
          (dk-have! `(= (LENGTH ,l) (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,l) ,n)) (subst `(= (LENGTH ,a) ,n)) (rfl)))
          (dk-have! `(= (LENGTH ,hs) (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,hs) ,n)) (subst `(= (LENGTH ,l) ,n)) (rfl)))
          (dk-have! `(<= 1 (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,a) ,n)) (ass)))
          (dk-have! `(FORALL mii_ (IMPLIES (IN mii_ NN) (IMPLIES (<= 1 mii_) (IMPLIES (<= mii_ (LENGTH ,l))
                       (= (NTH mii_ ,hs) (LIST ,h (ENC-IN (NTH mii_ ,l) (NTH mii_ ,a))))))))
            (lambda ()
              (let* ((ld (dk-peel!)) (i (m57-peeled-index ld)))
                (dk-have! `(<= ,i ,n) (lambda () (subst `(= ,n (LENGTH ,l))) (ass)))
                (ent! i)
                (mi-lane-close!))))
          ;; the conclusion of cartesian-intro is a sequent
          (m57-seq-facts! h eqf)
          (m57-eq-clt! x el)
          (dk-split! (dk-cite! 'clf-in-elim x ca))
          (dk-cite! 'clf-in-intro el ca)
          (dk-meta-seq! h lm)
          (dk-have! `(REL-CARTESIAN-INTRO tt ,hs ,c)
            (lambda ()
              (mac 'rel-cartesian-intro)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-head-is? (dk-goal) 'FORSOME) (dk-meta-ex-fill! (list h l a)))
                        ((dk-asm? (dk-goal)) (ass))
                        (#t (rfl)))))))
          (dk-have! `(HYPS-IN ,hs (DERIVABLE tt))
            (lambda ()
              (mac 'hyps-in)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let* ((ld (dk-peel!)) (i (m57-peeled-index ld)))
                        (dk-have! `(<= ,i ,n) (lambda () (subst `(= ,n (LENGTH ,hs))) (ass)))
                        (ent! i)
                        (subst `(= (NTH ,i ,hs) (LIST ,h ,(mj i))))
                        (dk-apply! bm0 i)
                        (mi-lane-close!))
                      (begin (fact 'membership-implies-sethood hs '(TUPLES SEQ-SET)) (ass)))))))
          (dk-cite! 'adm-cartesian-intro 'tt hs c)
          ;; x == [l], and the membership moved to x
          (mi-cl-facts! x)
          (dk-cite! 'der-eq-qeq 'tt h x el)
          (mi-cart-move! h x el ca)
          (mi-lane-close!)))))
  ;; the level k + 1: forsome-elim at a fresh name
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (gl (dk-goal)) (sq (cadr gl)) (h (cadr sq)) (g0 (caddr sq)) (x (cadr g0)) (a (cadr (caddr g0)))
         (dch (or (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'CCHS) (dk-contains? f 'DERIVABLE)
                                               (not (dk-head-is? f 'FORALL)) (equal? (cadr (cadr f)) h)))
                              landed)
                  (error "cchs-bwd: no chain derivability")))
         (ch (caddr (cadr dch))) (n (cadddr ch)) (l (car (cddddr ch))) (sk (cadr (cddddr ch))) (k (cadr sk))
         (ih (m57-univ-of landed (lambda (f) (and (dk-contains? f 'CCHS) (dk-contains? f 'DERIVABLE))) "the induction hypothesis"))
         (bm (m57-univ-of landed (lambda (f) (and (dk-contains? f 'DERIVABLE) (dk-contains? f `(NTH m57j_ ,l)) (not (dk-contains? f 'CCHS)))) "bm"))
         (c2 (m57-univ-of landed (lambda (f) (and (dk-contains? f 'EBVAR) (dk-contains? f `(NTH m57j_ ,l)))) "c2"))
         (i `(- ,n ,k)) (e `(NTH ,i ,a)) (c `(CCHS ,x ,a ,n ,l ,k))
         (bd `(ENC-AND (ENC-IN (EBVAR 0) ,e) ,c)) (exb `(ENC-EX ,bd))
         (h1 `(CTX-ADD ,h ,exb)))
    (dk-cite! 'cchs-succ x a n l k)
    (dk-rewrite-h! dch `(CCHS ,x ,a ,n ,l (succ ,k)) exb)
    (dk-have! `(<= ,n (LENGTH ,a)) (lambda () (subst `(= (LENGTH ,a) ,n)) (dk-nn!)))
    (m57-level-entry! n k a)
    (m57-seq-facts! h exb)
    (dk-cite! 'ctx-add-ctx h exb)
    (mi-cl-facts! g0)
    (let* ((y (mi-fresh! h1 g0))
           (ey `(EFVAR ,y))
           (p1 `(ENC-IN ,ey ,e))
           (l2 `(MAPLK (OPEN-FUN ,ey) ,l ,k))
           (cc2 `(CCHS ,x ,a ,n ,l2 ,k))
           (ow `(ENC-AND ,p1 ,cc2))
           (ob `(EXPR-OPEN ,bd 0 ,ey))
           (h2 `(CTX-ADD ,h1 ,ow))
           (h3 `(CTX-ADD (CTX-ADD ,h2 ,p1) ,cc2)))
      (dk-cite! 'clt-efvar y)
      (mi-cl-facts! ey)
      (dk-cite! 'cchs-expr k x a n l)
      (mi-nn! 0)
      (let* ((eo0 (dk-cite! 'cchs-open k x a n l ey 0))
             (eoc (begin (dk-have! `(= (+ 0 ,k) ,k) (lambda () (dk-nn!))) (dk-rewrite-h! eo0 `(+ 0 ,k) k)))
             (eob (dk-cite! 'cchs-open-body ey e c)))
        ;; the opened body is a sentence, and so are its two parts
        (dk-cite! 'clf-open-inst-ex bd ey)
        (let* ((f1 (dk-rewrite-h! `(IN ,ob CLF) ob (caddr eob)))
               (f2 (dk-rewrite-h! f1 `(EXPR-OPEN ,c 0 ,ey) cc2)))
          (dk-split! (dk-cite! 'clf-and-elim p1 cc2)))
        (dk-cite! 'ctx-add-ctx h1 ow)
        (dk-cite! 'ctx-add-ctx h2 p1)
        (dk-cite! 'ctx-add-ctx `(CTX-ADD ,h2 ,p1) cc2)
        ;; the next level's list: its indices unchanged, its new instance the name y at n - k
        (dk-split-all! (list (dk-cite! 'maplk-open ey l k)))
        (let ((ents (mi-entries-of l2)))
          (dk-have! `(= (LENGTH ,l2) ,n) (lambda () (subst `(= (LENGTH ,l2) (LENGTH ,l))) (ass)))
          (m57-c2-next! n l l2 k ey c2 ents)
          (dk-have! (m57-bm h3 a n l2 k)
            (lambda ()
              (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)) (ej `(EXPR-OPEN (NTH ,j ,l) ,k ,ey)))
                (dk-have! `(<= ,j (LENGTH ,l)) (lambda () (subst `(= (LENGTH ,l) ,n)) (ass)))
                (dk-apply! ents j)
                (m57-split-level! j k n
                  (lambda ()          ; an old instance: a closed term, unchanged; its membership weakened from h
                    (let ((mjf `(ENC-IN (NTH ,j ,l) (NTH ,j ,a))))
                      (dk-apply! bm j)
                      (m57-seq-facts! h mjf)
                      (mi-cl-facts! `(NTH ,j ,l))
                      (dk-cite! 'lc-open ey `(NTH ,j ,l) k)
                      (subst `(= (NTH ,j ,l2) ,ej))
                      (subst `(= ,ej (NTH ,j ,l)))
                      (mi-derive2! `(weakening (,h3 ==> ,mjf) (given (,h ==> ,mjf))))
                      (mi-lane-close!)))
                  (lambda ()          ; the entry n - k: the index k opened at y; its membership an assumption
                    (dk-have! `(< ,n (+ ,j (succ ,k))) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                    (let ((cj (dk-apply! c2 j)))
                      (dk-have! `(= (- ,n ,j) ,k) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                      (dk-have! `(= ,j ,i) (lambda () (dk-nn! `(= (+ ,j ,k) ,n))))
                      (subst `(= (NTH ,j ,l2) ,ej))
                      (subst cj)
                      (subst `(= (- ,n ,j) ,k))
                      (subst (dk-cite! 'open-ebvar-hit ey k))
                      (subst `(= ,j ,i))
                      (mi-derive2! `(assumption (,h3 ==> ,p1)))
                      (mi-lane-close!)))))))
          ;; the induction hypothesis at h3 and the next list
          (mi-derive2! `(assumption (,h3 ==> ,cc2)))
          (let ((dd (let w1 ((f (dk-apply! ih h3 l2))) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))))
            (if (not (equal? dd (mi-der h3 g0))) (error "cchs-bwd: the induction hypothesis did not detach" (expression->string dd))))
          ;; and-elim, forsome-elim at y, cut
          (mi-derive2! `(and-elim (,h2 ==> ,g0) (given (,h3 ==> ,g0))))
          (dk-have! (mi-der `(CTX-ADD ,h1 ,ob) g0) (lambda () (subst eob) (subst eoc) (ass)))
          (mi-derive2! `(forsome-elim (,h1 ==> ,g0) (given ((CTX-ADD ,h1 ,ob) ==> ,g0)) (y := ,y)))
          (mi-derive2! `(cut (,h ==> ,g0) (given (,h ==> ,exb)) (given (,h1 ==> ,g0))))
          (mi-lane-close!))))))
(qed 'cchs-bwd)

;;; (f) THE DERIVED RULE: every local instance of cartesian-decompose is derivable, both sides sentences, T a set of
;;; sentences containing AX-MEM-SET (for cartesian-intro, as row 28).  The chain at the level n with the innermost
;;; list IDX-LIST(n) is ENC-CCH (cchs-idx); its instance shape is vacuous at that level, its index shape is
;;; idx-list-prop.
(define m57-cch '(ENC-CCH x a (LENGTH a) (LENGTH a)))
(sp (make-wff `(FORALL tt (FORALL g (FORALL x (FORALL a
   ,(m57-imps (list '(SUBSET tt CLF) '(IN AX-MEM-SET tt) '(IN g CTX-SET) '(<= 1 (LENGTH a))
                    '(IN (ENC-IN x (ENC-CART a)) CLF) `(IN ,m57-cch CLF))
      `(IN (LIST g (ENC-IFF (ENC-IN x (ENC-CART a)) ,m57-cch)) (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((mem '(ENC-IN x (ENC-CART a))) (cch m57-cch) (n '(LENGTH a)) (idx `(IDX-LIST ,n))
       (chn `(CCHS x a ,n ,idx ,n))
       (ga `(CTX-ADD g ,mem)) (gb `(CTX-ADD g ,cch))
       (tp '(ENC-IN x (ENC-TUPLES ENC-SETC))) (le `(ENC-EQ (ENC-LENGTH x) (ENC-NUM ,n))) (cl `(ENC-CARTL x a ,n))
       (rhs `(ENC-AND ,tp (ENC-AND ,le ,cl))))
  (dk-split! (dk-cite! 'clf-in-elim 'x '(ENC-CART a)))
  (dk-split! (dk-cite! 'clt-cart-elim 'a))
  (mi-cl-facts! 'x)
  (dk-meta-len-nn! 'a 'EXPR-SET)
  (dk-have! `(= ,n ,n) (lambda () (rfl)))
  (dk-have! `(<= ,n ,n) (lambda () (dk-nn!)))
  (dk-split! (dk-cite! 'idx-list-prop n))
  (let ((idx-ents (m57-univ-of (dk-asms) (lambda (f) (dk-contains? f `(NTH ,(cadr f) ,idx))) "the entries of IDX-LIST")))
    (dk-cite! 'cchs-idx n 'x 'a n)
    (dk-rewrite-h! `(IN ,cch CLF) cch chn)
    (dk-cite! 'ctx-add-ctx 'g mem)
    (dk-cite! 'ctx-add-ctx 'g cch)
    ;; the shapes of IDX-LIST(n) at the level n
    (dk-have! (m57-c1 'x n idx n)
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,j) `(<= (+ ,j ,n) ,n))))
          (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
          (ai '(NOT (<= 1 0))))))
    (dk-have! (m57-c2 n idx n)
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-apply! idx-ents j)
          (mi-lane-close!))))
    ;; FORWARD: the membership's components, then cchs-fwd at the level n
    (mi-num-nn! n)
    (mi-tcl! tp) (mi-tcl! le)
    (dk-apply! (dk-cite! 'enc-cartl-clf n) 'x 'a)
    (dk-cite! 'clf-and-intro le cl)
    (dk-cite! 'clf-and-intro tp `(ENC-AND ,le ,cl))
    (dk-cite! 'clf-iff-intro mem rhs)
    (mi-derive2! `(lemma (,ga ==> ,rhs) der-iff-r (,ga ,mem ,rhs) (cartesian-mem (,ga ==> (ENC-IFF ,mem ,rhs)))
                    (assumption (,ga ==> ,mem))))
    (dk-split! (dk-cite! 'der-and-parts 'tt ga tp `(ENC-AND ,le ,cl)))
    (dk-split! (dk-cite! 'der-and-parts 'tt ga le cl))
    (dk-have! (m57-h5 ga 'x 'a n)
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-apply! (dk-cite! 'enc-cartl-elim-der n) 'tt ga 'x 'a j)
          (mi-lane-close!))))
    (dk-cite! 'cchs-fwd n 'tt ga 'x 'a n idx)
    (let ((d1 (mi-der ga chn)))
      (if (not (dk-asm? d1)) (error "der-cartesian-decompose: cchs-fwd did not land" (expression->string d1)))
      (dk-rewrite-h! d1 chn cch))
    ;; BACKWARD: the chain assumed, then cchs-bwd at the level n
    (mi-derive2! `(assumption (,gb ==> ,cch)))
    (dk-have! (mi-der gb chn) (lambda () (subst `(= ,chn ,cch)) (ass)))   ; not dk-rewrite-h!: gb holds cch too
    (dk-have! (m57-bm gb 'a n idx n)
      (lambda ()
        (let* ((ld (dk-peel!)) (j (m57-peeled-index ld)))
          (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,j) `(<= (+ ,j ,n) ,n))))
          (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
          (ai '(NOT (<= 1 0))))))
    (let ((r (dk-cite! 'cchs-bwd n 'tt 'x 'a n gb idx)))
      (if (not (dk-asm? (mi-der gb mem))) (error "der-cartesian-decompose: cchs-bwd did not land" (expression->string r))))
    ;; the equivalence
    (dk-cite! 'clf-iff-intro mem cch)
    (mi-derive2! `(iff-intro (g ==> (ENC-IFF ,mem ,cch)) (given (,ga ==> ,cch)) (given (,gb ==> ,mem))))
    (mi-lane-close!)))
(qed 'der-cartesian-decompose)

;;; THE LOCAL REDEXES are inside EQV(T) (agent W2E, 2026-11-12, after the CLF guard of J-CART, the user's decision D6):
;;; the tuple unpacked, its two sides sentences by the guard, the equivalence by der-cartesian-decompose.
(sp (make-wff '(FORALL tt (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-MEM-SET tt) (SUBSET (J-CART tt) (EQV tt)))))))
(dk-peel!)
(mac 'J-CART)
(mac 'subset-def)
(dk-peel!)
(let* ((mm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))
       (y (cadr mm))
       (landed (dk-landed (lambda () (sep-me mm))))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
       (vs (dk-meta-unpack! ex))
       (g (car vs)) (z (cadr vs)) (a (caddr vs))
       (uu `(ENC-IN ,z (ENC-CART ,a))) (ch `(ENC-CCH ,z ,a (LENGTH ,a) (LENGTH ,a))) (lit `(LIST 2 ,g ,uu ,ch)))
  (dk-split-all!)
  (if (not (dk-asm? `(= ,y ,lit))) (error "j-cart-sub: the redex tuple is not" (expression->string lit)))
  (dk-rewrite-h! `(IN ,y RW-UNIV) y lit)
  (dk-cite! 'rw-univ-ctx 2 g uu ch)
  (dk-cite! 'der-cartesian-decompose 'tt g z a)
  (subst `(= ,y ,lit))
  (dk-cite! 'eqv-f-intro 'tt g uu ch)
  (ass))
(qed 'j-cart-sub)

