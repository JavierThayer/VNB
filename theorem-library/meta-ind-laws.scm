;; (NOT (IN y (EXPR-FV e))) from the freshness fact (NOT (IN y (UNION (CTX-FV g) (EXPR-FV e)))) in context
(define (mi-not-fv! y e)
  (let ((goal `(NOT (IN ,y (EXPR-FV ,e)))))
    (if (not (dk-asm? goal))
        (let* ((fr (find-first (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'IN) (equal? (cadr (cadr f)) y)
                                                (dk-head-is? (caddr (cadr f)) 'UNION) (equal? (caddr (caddr (cadr f))) `(EXPR-FV ,e))))
                               (dk-asms)))
               (u (caddr (cadr fr))))
          (dk-have! goal
            (lambda ()
              (di)
              (let ((iff (dk-meta-iff! 'union-membership (cadr u) (caddr u) y)))
                (dk-have! (caddr iff) (lambda () (oi-r) (ass)))
                (dk-meta-iff-l! iff)
                (ai `(NOT (IN ,y ,u))))))))
    goal))
;; (= (EXPR-SUBST (EXPR-OPEN e 0 (EFVAR y)) y t) (EXPR-OPEN e 0 t)), t a closed term, y fresh for e
(define (mi-son-eq! y e t)
  (mi-not-fv! y e)
  (mi-tclt! t)
  (if (not (and (dk-asm? `(IN ,t EXPR-SET)) (dk-asm? `(EXPR-LC ,t))))
      (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clt-iff t)))))
  (dk-cite! 'subst-open-name y e t))
;; eq-subst at the formula OPEN(e, 0, _): [G, OPEN(e, 0, s)] from [G, OPEN(e, 0, t)] (derivable, as the
;; value mi-open2! gives), (s = t) in G, y a name fresh for e.  Returns the value of OPEN(e, 0, s).
(define (mi-eqsub! G e y s t)
