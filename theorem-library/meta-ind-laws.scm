          ;; (structure-library/meta-core.scm 4.9), stated through EBIND; IOTA by IOTA-CR, through ENC-IOTA.
          (let ((ff (if cmp? `(ENC-QEQ ,e1 ,e2) `(ENC-QEQ ,ca ,cb))))
