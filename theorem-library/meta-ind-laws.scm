;;; -----------------------------------------------------------------------
;;; THE LENGTH CLAUSE OF THE DEFINEDNESS CERTIFICATE, its direct case, DERIVED (agent BRIDGE, 2026-11-19).
;;; DEF-LEN-TUPLES (structure-library/meta-def.scm, section 4a): from [g, t in TUPLES(A)], [g, LENGTH(t) = LENGTH(t)],
;;; over T holding the encoded length-in-nn (AX-LEN-NN), as adm-def-app: the instance at A owes A = A (strictness of
;;; IN on the right, then of the constructor TUPLES in its argument, CR-DEF-STRICT-ARG at the head 14), the instance at
;;; t owes t = t (strictness of IN on the left), then backchain and the strictness of IN once more.
(set! mi-const-laws (append mi-const-laws '((AX-LEN-NN . ax-len-nn-def))))
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-LEN-NN tt)
   (IMPLIES (ADM-DEF-STRICT-IN-L tt) (IMPLIES (ADM-DEF-STRICT-IN-R tt)
   (IMPLIES (DEF-LEN-TUPLES tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'def-len-tuples 1)) (g (car vs)) (w (cadr vs)) (a (caddr vs))
       (ta `(ENC-TUPLES ,a)) (h1 `(ENC-IN ,w ,ta))
       (ln `(ENC-LENGTH ,w)) (e `(ENC-EQ ,ln ,ln))
       (ea `(EAPP 14 (LIST ,a))) (nt `(NTH 1 (LIST ,a)))
       (adml (dk-meta-iff-r! (dk-meta-iff! 'adm-def-strict-in-l 'tt)))
       (admr (dk-meta-iff-r! (dk-meta-iff! 'adm-def-strict-in-r 'tt))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g h1)))
  (dk-split! (dk-cite! 'clf-in-elim w ta))
  (dk-cite! 'clt-tuples-elim a)
  ;; the definedness premises: t, TUPLES(A), then A
  (mi-strict! adml 'DEF-STRICT-IN-L g w ta)
  (mi-strict! admr 'DEF-STRICT-IN-R g w ta)
  (let ((u (dk-cite! 'enc-tuples-unfold a)))
    (dk-rewrite-h! (mi-der g `(ENC-EQ ,ta ,ta)) ta ea)
    (dk-have! '(STRICT-HEAD 14) (lambda () (mac 'STRICT-HEAD) (oi-r) (oi-l) (dk-conj-close! (lambda () (arith)))))
    (dk-have! '(IN 1 NN) (lambda () (arith)))
    (dk-have! '(<= 1 1) (lambda () (arith)))
    (dk-have! `(= ,nt ,a) (lambda () (nth-r) (rfl)))
    (dk-have! `(= (LENGTH (LIST ,a)) 1) (lambda () (len-r) (rfl)))
    (dk-have! `(<= 1 (LENGTH (LIST ,a))) (lambda () (subst `(= (LENGTH (LIST ,a)) 1)) (arith)))
    (dk-have! `(IN ,nt CLT) (lambda () (subst `(= ,nt ,a)) (ass)))
    (dk-cite! 'clf-eq-intro nt nt)
    (dk-cite! 'clf-eq-intro ea ea)
    (dk-meta-derive! 'tt `(def-strict-arg (,g ==> (ENC-EQ ,nt ,nt)) (given (,g ==> (ENC-EQ ,ea ,ea)))))
    (dk-rewrite-h! (mi-der g `(ENC-EQ ,nt ,nt)) nt a))
  (let* ((axu (mi-unfold-const! 'AX-LEN-NN)) (b1 (cadr axu))
         (i1 (mi-open2! b1 0 a)) (b2 (cadr i1))
         (i2 (mi-open2! b2 0 w)) (h1x (cadr i2)) (hl (caddr i2))
         (g1 (mi+ g axu)) (g2 (mi+ g1 i1)) (g3 (mi+ g2 i2)))
    (if (not (equal? h1x h1)) (error "adm-def-len-tuples: the instance's antecedent is not the premise" (expression->string h1x)))
    (for-each mi-tcl! (list axu i1 i2))
    (mi-derive2! `(def-strict-in-l (,g3 ==> ,e)
                    (backchain (,g3 ==> ,hl) (weakening (,g3 ==> ,h1) (given (,g ==> ,h1))))))
    (mi-conv! (mi+ g2 `(EXPR-OPEN ,b2 0 ,w)) e `(= (EXPR-OPEN ,b2 0 ,w) ,i2))
    (mi-derive2! `(forall-elim (,g2 ==> ,e) (given (,(mi+ g2 `(EXPR-OPEN ,b2 0 ,w)) ==> ,e))
                    (weakening (,g2 ==> (ENC-EQ ,w ,w)) (given (,g ==> (ENC-EQ ,w ,w))))))
    (mi-conv! (mi+ g1 `(EXPR-OPEN ,b1 0 ,a)) e `(= (EXPR-OPEN ,b1 0 ,a) ,i1))
    (mi-derive2! `(cut (,g ==> ,e) (theorem-assumption (,g ==> ,axu))
                    (forall-elim (,g1 ==> ,e) (given (,(mi+ g1 `(EXPR-OPEN ,b1 0 ,a)) ==> ,e))
                      (weakening (,g1 ==> (ENC-EQ ,a ,a)) (given (,g ==> (ENC-EQ ,a ,a)))))))
    (mi-lane-close!)))
(qed 'adm-def-len-tuples)

;;; -----------------------------------------------------------------------
;; K1FIX (2026-11-19): clt-eapp-arg, MOVED here from meta-def-laws.scm (5.1), which loads after this file: the
;; lambda-type proofs of section O cite it, and a cold load in load order found it missing.
;; an argument of an application that is a closed term is a closed term (a term head is >= 11, and its
;; arguments are terms: HD-ARGK; a head <= 6 makes a formula, HD-RES, which is no term)
(sp (make-wff '(FORALL h (FORALL l (FORALL i (IMPLIES (IN (EAPP h l) CLT) (IMPLIES (IN i NN) (IMPLIES (<= 1 i)
   (IMPLIES (<= i (LENGTH l)) (IN (NTH i l) CLT))))))))))
(dk-peel!)
(dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clt-iff '(EAPP h l)))))
(dk-split! (dk-cite! 'eapp-expr-inv 'h 'l))
(dk-meta-iff-r! (dk-meta-iff! 'wf-term '(EAPP h l)))
(dk-have! '(IN 1 NN) (lambda () (arith)))
(let* ((kparts (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'wks-eapp-iff 'h 'l 1)))))
       (u1 (find-first (lambda (f) (dk-head-is? f 'FORALL)) kparts))
       (u2 (dk-meta-iff-r! (dk-meta-iff! 'lc-eapp-iff 'h 'l)))
       (w '(NTH i l)))
  (dk-meta-nth-in! 'EXPR-SET 'i 'l)
  (dk-have! `(IN ,w (MAKE-SET l)) (lambda () (dk-meta-in-makeset! 'i 'l 'EXPR-SET)))
  (dk-apply! u1 w)
  (dk-apply! u2 w)
  (use-em '(<= h 6)
    (lambda ()
      (dk-have! '(= (HD-RES h) 2)
        (lambda () (mac 'HD-RES) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (dk-nn! '(<= h 6))) (lambda () (rfl)))))
      (dk-have! '(= 1 2) (lambda () (subst '(= 2 (HD-RES h))) (ass)))
      (dk-have! '(NOT (= 1 2)) (lambda () (arith)))
      (ai '(NOT (= 1 2))))
    (lambda ()
      (dk-have! '(= (HD-ARGK h) 1)
        (lambda () (mac 'HD-ARGK) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (ass)) (lambda () (rfl)))))
      (dk-rewrite-h! `(IN (HD-ARGK h) (EXPR-WKS ,w)) '(HD-ARGK h) 1)
      (dk-meta-iff-l! (dk-meta-iff! 'wf-term w))
      (let ((iff (dk-meta-iff! 'clt-iff w)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
        (dk-meta-iff-l! iff)
        (ass)))))
(qed 'clt-eapp-arg)

;;; O. LAMBDA-TYPE AT A BINDER LIST (agent POSN, 2026-11-19; structure-library/meta-ind.scm, section 6; the K2
;;; ledger's row 52).  The kernel's lambda-type at a binder list of each fixed length n = 1 .. 4, over the literal
;;; product, through the one-binder core rule CR-LAMBDA-TYPE at the translator's body c: for a fresh name z,
;;; z in CARTESIAN(A1 .. An) gives NTH(k, z) in A_k (cartesian-mem, enc-cartl-elim-der); the n guarded universals of
;;; the typing hypothesis instantiated at the projections (forall-elim, each instance's definedness the strictness of
;;; the membership just derived; backchain) give b opened at the projections in B, which is c opened at z; then
;;; implies-intro, forall-intro at z, and CR-LAMBDA-TYPE with the sethood hypothesis.

(sp (make-wff '(FORALL mpofp_ (FORALL mpofq_ (== (ENC-FUN mpofp_ mpofq_) (EAPP 19 (LIST mpofp_ mpofq_)))))))
(dk-peel!) (mac 'ENC-FUN) (qrfl)
(qed 'enc-fun-unfold)
(sp (make-wff '(FORALL mpofp_ (FORALL mpofq_ (== (ENC-LAM mpofp_ mpofq_) (EBIND 26 1 (LIST mpofp_) mpofq_))))))
(dk-peel!) (mac 'ENC-LAM) (qrfl)
(qed 'enc-lam-unfold)
(set! mi-unfold-laws (append mi-unfold-laws '((ENC-FUN . enc-fun-unfold) (ENC-LAM . enc-lam-unfold))))

;; (IN (EXPR-OPEN body 0 u) CLF) by the planner's instance route, moved to the opened value V
(define (mpo-tcl-open! body u v)
  (let ((f `(EXPR-OPEN ,body 0 ,u)))
    (if (not (dk-asm? `(IN ,v CLF)))
        (begin
          (if (not (dk-asm? `(IN ,f CLF))) (mi-tcl! f))
          (dk-rewrite-h! `(IN ,f CLF) f v)))
    `(IN ,v CLF)))

;; THE INSTANTIATION CHAIN.  [gc, cur] derivable, cur = ALL(IMP(v in a_k, rest)) .. ; the projections' memberships
;; [g4, m_k] derivable.  Lands [gc, F] for F the innermost formula opened at the projections, and returns F.
(define (mpo-inst-chain! g4 gc cur ns ms)
  (let* ((body (cadr cur)) (nk (car ns)) (mk (car ms))
         (ob (mi-open2! body 0 nk)) (rest (caddr ob))
         (ga (mi+ gc cur)) (gb (mi+ ga ob)))
    (if (not (equal? (cadr ob) mk))
        (error "mpo-inst-chain!: the opened guard is not the projection's membership" (expression->string ob)))
    (mpo-tcl-open! body nk ob)
    (dk-split! (dk-cite! 'clf-imp-elim mk rest))
    (mi-derive2! `(backchain (,gb ==> ,rest) (weakening (,gb ==> ,mk) (given (,g4 ==> ,mk)))))
    (let ((f (if (null? (cdr ns)) rest (mpo-inst-chain! g4 gb rest (cdr ns) (cdr ms)))))
      (mi-conv! (mi+ ga `(EXPR-OPEN ,body 0 ,nk)) f `(= (EXPR-OPEN ,body 0 ,nk) ,ob))
      (mi-derive2! `(forall-elim (,ga ==> ,f) (given (,(mi+ ga `(EXPR-OPEN ,body 0 ,nk)) ==> ,f))
                     (def-strict-in-l (,ga ==> (ENC-EQ ,nk ,nk)) (weakening (,ga ==> ,mk) (given (,g4 ==> ,mk))))))
      (mi-derive2! `(cut (,gc ==> ,f) (given (,gc ==> ,cur)) (given (,ga ==> ,f))))
      f)))

(define (mpo-lambda-type! n rel)
  (sp (make-wff `(FORALL tt (FORALL hs (FORALL c (IMPLIES (,rel tt hs c)
     (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
  (dk-peel!)
  (let* ((vs (mi-rel-open! rel 3))      ; K1FIX: the third hypothesis, the codomain's definedness
         (g (car vs)) (as (list-head (cdr vs) n))
         (b (list-ref vs (+ n 1))) (d (list-ref vs (+ n 2))) (e (list-ref vs (+ n 3)))
         (l `(LIST ,@as)) (ca `(ENC-CART ,l)) (nl `(LENGTH ,l))
         (inner `(ENC-IN ,b ,d))
         (chain (fold-right (lambda (a acc) `(ENC-ALL (ENC-IMP (ENC-IN (EBVAR 0) ,a) ,acc))) inner as))
         (sh `(ENC-IN ,ca ENC-SETC))
         (tb `(ENC-IMP (ENC-IN (EBVAR 0) ,ca) (ENC-IN ,e ,d))) (ty `(ENC-ALL ,tb))
         (lam `(ENC-LAM ,ca ,e)) (fn `(ENC-FUN ,ca ,d)) (goal `(ENC-IN ,lam ,fn))
         (cnd (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'EXPR-OPEN) (not (dk-contains? f 'DERIVABLE))))
                          (dk-asms))))
    (if (not cnd) (error "mpo-lambda-type!: no translator condition in context"))
    ;; the sentences: the two hypotheses and the conclusion; the product, its factors, the codomain; the bodies
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g chain)))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g sh)))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g goal)))
    (dk-split! (dk-cite! 'clf-in-elim ca 'ENC-SETC))
    (dk-split! (dk-cite! 'clt-cart-elim l))
    (dk-split! (dk-cite! 'clf-in-elim lam fn))
    (let ((u (dk-cite! 'enc-fun-unfold ca d)) (l2 `(LIST ,ca ,d)))
      (dk-rewrite-h! `(IN ,fn CLT) fn (caddr u))
      (dk-have! '(IN 19 NN) (lambda () (arith)))
      (dk-have! '(IN 2 NN) (lambda () (arith)))
      (dk-have! '(<= 1 2) (lambda () (arith)))
      (dk-have! `(<= 2 (LENGTH ,l2)) (lambda () (len-r) (arith)))
      (dk-cite! 'clt-eapp-arg 19 l2 2)
      (dk-nth-h! `(IN (NTH 2 ,l2) CLT)))
    (for-each (lambda (k)
                (dk-have! `(IN ,k NN) (lambda () (arith)))
                (mi-num-nn! k)
                (dk-have! `(<= 1 ,k) (lambda () (arith)))
                (dk-have! `(<= ,k ,nl) (lambda () (len-r) (arith)))
                (mi-entry-clt! k l)
                (dk-nth-h! `(IN (NTH ,k ,l) CLT)))
              (iota n 1))
    (mi-cl-facts! lam) (mi-inv-body! lam 1 0)
    (mi-cl-facts! chain)
    (let loop ((cur chain) (dp 0))
      (if (dk-head-is? cur 'ENC-ALL)
          (let ((bd (cadr cur)))
            (mi-inv-body! cur 2 dp)
            (mi-inv-arg! bd 2 2 (+ dp 1))
            (loop (caddr bd) (+ dp 1)))
          (mi-inv-arg! cur 1 2 dp)))
    (mi-tcl! ty)
    ;; [g, ty]: a fresh name z, z in the product, its projections in the factors
    (let* ((z (mi-fresh2! g tb)) (ez `(EFVAR ,z))
           (ns (map (lambda (k) `(ENC-NTH (ENC-NUM ,k) ,ez)) (iota n 1)))
           (ms (map (lambda (nk a) `(ENC-IN ,nk ,a)) ns as))
           (tz (mi-open2! tb 0 ez)) (eo `(EXPR-OPEN ,e 0 ,ez))
           (yin `(ENC-IN ,ez ,ca)) (g4 (mi+ g yin))
           (tp `(ENC-IN ,ez (ENC-TUPLES ENC-SETC))) (le `(ENC-EQ (ENC-LENGTH ,ez) (ENC-NUM ,nl)))
           (cl `(ENC-CARTL ,ez ,l ,nl)) (rhs `(ENC-AND ,tp (ENC-AND ,le ,cl))))
      (if (not (equal? tz `(ENC-IMP ,yin (ENC-IN ,eo ,d))))
          (error "mpo-lambda-type!: the opened typing is not the expected one" (expression->string tz)))
      (dk-cite! 'clt-efvar z)
      (mi-cl-facts! ez)
      (mi-ctx2! g4)
      (fact 'length-in-nn 'EXPR-SET l)
      (dk-have! `(<= ,nl ,nl) (lambda () (dk-nn!)))
      (dk-have! `(<= 1 ,nl) (lambda () (len-r) (arith)))
      (mi-num-nn! nl)
      (dk-apply! (dk-cite! 'enc-cartl-clf nl) ez l)
      (mi-cl! tp 'CLF) (mi-cl! le 'CLF)
      (dk-cite! 'clf-and-intro le cl)
      (dk-cite! 'clf-and-intro tp `(ENC-AND ,le ,cl))
      (dk-cite! 'clf-iff-intro yin rhs)
      (mi-derive2! `(lemma (,g4 ==> ,rhs) der-iff-r (,g4 ,yin ,rhs) (cartesian-mem (,g4 ==> (ENC-IFF ,yin ,rhs))) (assumption (,g4 ==> ,yin))))
      (dk-split! (dk-cite! 'der-and-parts 'tt g4 tp `(ENC-AND ,le ,cl)))
      (dk-split! (dk-cite! 'der-and-parts 'tt g4 le cl))
      (for-each (lambda (k)
                  (dk-apply! (dk-cite! 'enc-cartl-elim-der nl) 'tt g4 ez l k)
                  (dk-nth-h! `(IN (LIST ,g4 ,(mi-cart-atom k ez l)) (DERIVABLE tt)))
                  (if (dk-asm? `(IN ,(mi-cart-atom k ez l) CLF)) (dk-nth-h! `(IN ,(mi-cart-atom k ez l) CLF))))
                (iota n 1))
      ;; the chain instantiated at the projections
      (mi-derive2! `(weakening (,g4 ==> ,chain) (given (,g ==> ,chain))))
      (let* ((f (mpo-inst-chain! g4 g4 chain ns ms)))
        (dk-apply! cnd z)
        (let ((bo (caddr (find-first (lambda (q) (and (dk-head-is? q '=) (equal? (cadr q) eo))) (dk-asms)))))
          (if (not (equal? f `(ENC-IN ,bo ,d)))
              (error "mpo-lambda-type!: the instantiated body is not the translator's" (expression->string f)))
          (mi-conv! g4 `(ENC-IN ,eo ,d) `(= ,eo ,bo))))
      (mpo-tcl-open! tb ez tz)
      (mi-derive2! `(implies-intro (,g ==> ,tz) (given (,g4 ==> (ENC-IN ,eo ,d)))))
      (mi-conv! g `(EXPR-OPEN ,tb 0 ,ez) `(= (EXPR-OPEN ,tb 0 ,ez) ,tz))
      (mi-derive2! `(forall-intro (,g ==> ,ty) (given (,g ==> (EXPR-OPEN ,tb 0 ,ez))))))
    ;; the root: the core lambda-type at the translator's body
    (mi-derive2! `(lambda-type (,g ==> ,goal) (given (,g ==> ,ty)) (given (,g ==> ,sh)) (given (,g ==> (ENC-EQ ,d ,d)))))
    (mi-lane-close!)))
(mpo-lambda-type! 1 'REL-LAMBDA-TYPE-1)
(qed 'adm-lambda-type-1)
(mpo-lambda-type! 2 'REL-LAMBDA-TYPE-2)
(qed 'adm-lambda-type-2)
(mpo-lambda-type! 3 'REL-LAMBDA-TYPE-3)
(qed 'adm-lambda-type-3)
(mpo-lambda-type! 4 'REL-LAMBDA-TYPE-4)
(qed 'adm-lambda-type-4)

;;; O2. THE VARIABLE LENGTH (structure-library/meta-ind.scm, section 6, LTCH and LTOP): the chain is an expression
;;; (ltch-expr), so is the opened body (ltop-expr); the open law of the chain (ltch-open, as cchs-open); modus ponens in
;;; one context (der-imp-mp); the instantiation of the chain at the projections by induction on the number of guards
;;; left (ltch-inst); and the kernel figure at every length (adm-lambda-type-n).

(define (mpo-expr! e)                      ; m57-expr! with the universal and the implication
  (cond ((dk-asm? `(IN ,e EXPR-SET)) #t)
        ((and (pair? e) (memq (car e) '(ENC-ALL ENC-IMP)))
         (let* ((eqn (mi-unfold-eq0 e)) (u (caddr eqn)))
           (mpo-expr! u)
           (dk-have! `(IN ,e EXPR-SET) (lambda () (subst eqn) (ass)))))
        ((and (pair? e) (eq? (car e) 'EAPP))
         (mi-nn! (cadr e)) (for-each mpo-expr! (cdr (caddr e)))
         (dk-have! `(IN ,(caddr e) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
         (fact 'eapp-in-expr (cadr e) (caddr e)))
        ((and (pair? e) (eq? (car e) 'EBIND))
         (mi-nn! (cadr e)) (mi-nn! (caddr e)) (m57-tuple! (cadddr e)) (mpo-expr! (car (cddddr e)))
         (apply fact 'ebind-in-expr (cdr e)))
        (#t (m57-expr! e))))

(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL a (FORALL b (FORALL d (FORALL n
   (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN) (IMPLIES (<= n (LENGTH a))
   (IMPLIES (IN b EXPR-SET) (IMPLIES (IN d CLT) (IMPLIES (<= k n) (IN (LTCH a b d n k) EXPR-SET))))))))))))))))
(let ((cs (m57-ni-cases! '(a b d n))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((o (cadr (dk-goal))) (a (cadr o)) (b (caddr o)) (d (cadddr o)) (n (car (cddddr o))))
    (subst (dk-cite! 'ltch-zero a b d n))
    (mi-cl-facts! d)
    (dk-close-if! (lambda () (mpo-expr! `(ENC-IN ,b ,d))) (lambda () (ass))))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'LTCH))) landed))
         (o (cadr (dk-goal))) (a (cadr o)) (b (caddr o)) (d (cadddr o)) (n (car (cddddr o)))
         (sk (cadr (cddddr o))) (k (cadr sk)))
    (subst (dk-cite! 'ltch-succ a b d n k))
    (let ((e (m57-level-entry! n k a)))
      (let w1 ((f ih)) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))
      (dk-close-if! (lambda () (mpo-expr! `(ENC-ALL (ENC-IMP (ENC-IN (EBVAR 0) ,e) (LTCH ,a ,b ,d ,n ,k))))) (lambda () (ass))))))
(qed 'ltch-expr)

(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL b (FORALL z (FORALL n
   (IMPLIES (IN b EXPR-SET) (IMPLIES (IN z NN) (IMPLIES (IN n NN) (IMPLIES (<= k n) (IN (LTOP b z n k) EXPR-SET))))))))))))
(let ((cs (m57-ni-cases! '(b z n))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((o (cadr (dk-goal))) (b (cadr o)) (z (caddr o)) (n (cadddr o)))
    (subst (dk-cite! 'ltop-zero b z n))
    (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'LTOP))) landed))
         (o (cadr (dk-goal))) (b (cadr o)) (z (caddr o)) (n (cadddr o)) (sk (car (cddddr o))) (k (cadr sk))
         (ix `(- ,n (succ ,k))) (u `(ENC-NTH (ENC-NUM (succ ,k)) (EFVAR ,z))))
    (subst (dk-cite! 'ltop-succ b z n k))
    (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,n))))
    (let w1 ((f ih)) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))
    (fact 'nn-succ-closed k)
    (fact 'idx-minus-in-nn n `(succ ,k))
    (mi-num-nn! `(succ ,k))
    (mi-expr! u)
    (fact 'open-in-expr u ix `(LTOP ,b ,z ,n ,k))
    (ass)))
(qed 'ltop-expr)

;;; THE OPEN LAW.  For d and the entries of a closed: OPEN(LTCH(a, b, d, n, k), j, u) == LTCH(a, OPEN(b, j + k, u), d, n, k).
(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL a (FORALL b (FORALL d (FORALL n (FORALL u
   (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN) (IMPLIES (<= n (LENGTH a))
   (IMPLIES (IN b EXPR-SET) (IMPLIES (IN d CLT) (IMPLIES (IN u EXPR-SET)
   (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= k n)
     (== (EXPR-OPEN (LTCH a b d n k) j u) (LTCH a (EXPR-OPEN b (+ j k) u) d n k)))))))))))))))))))))
(let ((cs (m57-ni-cases! '(a b d n u))))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((gl (dk-goal)) (lhs (cadr gl)) (ch (cadr lhs)) (j (caddr lhs)) (u (cadddr lhs))
         (a (cadr ch)) (b (caddr ch)) (d (cadddr ch)) (n (car (cddddr ch)))
         (ob `(EXPR-OPEN ,b ,j ,u)))
    (mi-cl-facts! d)
    (mi-nn! 7)
    (dk-have! `(= (+ ,j 0) ,j) (lambda () (dk-nn!)))
    (subst `(= (+ ,j 0) ,j))
    (fact 'open-in-expr u j b)
    (subst (dk-cite! 'ltch-zero a b d n))
    (subst (dk-cite! 'ltch-zero a ob d n))
    (subst (dk-cite! 'enc-in-unfold b d))
    (subst (dk-cite! 'open-app2 u j 7 b d))
    (subst (dk-cite! 'lc-open u d j))
    (subst (dk-cite! 'enc-in-unfold ob d))
    (qrfl))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTCH) (dk-contains? f 'EXPR-OPEN))) landed))
         (gl (dk-goal)) (lhs (cadr gl)) (ch (cadr lhs)) (j (caddr lhs)) (u (cadddr lhs))
         (a (cadr ch)) (b (caddr ch)) (d (cadddr ch)) (n (car (cddddr ch))) (sk (cadr (cddddr ch))) (k (cadr sk))
         (j1 `(+ ,j 1)) (jk `(+ ,j (succ ,k))) (obk `(EXPR-OPEN ,b ,jk ,u)))
    (if (not ih) (error "ltch-open: no induction hypothesis"))
    (let* ((e (m57-level-entry! n k a))
           (c `(LTCH ,a ,b ,d ,n ,k))
           (p `(ENC-IN (EBVAR 0) ,e))
           (bd `(ENC-IMP ,p ,c)))
      (mi-cl-facts! d)
      (mi-nn! 0) (mi-nn! 1) (mi-nn! 5) (mi-nn! 7) (mi-nn! 20)
      (m57-add-nn! j 1)
      (fact 'nn-succ-closed k)
      (m57-add-nn! j `(succ ,k))
      (dk-cite! 'ltch-expr k a b d n)
      (mpo-expr! bd)
      (dk-have! '(IN (LIST) (TUPLES EXPR-SET)) (lambda () (ti)))
      (fact 'open-in-expr u jk b)
      (subst (dk-cite! 'ltch-succ a b d n k))
      (subst (dk-cite! 'ltch-succ a obk d n k))
      (subst (dk-cite! 'enc-all-unfold bd))
      (subst (dk-cite! 'open-ebind u j 20 1 '(LIST) bd))
      (subst (dk-cite! 'maplk-nil u j))
      (subst (dk-cite! 'enc-imp-unfold p c))
      (subst (dk-cite! 'open-app2 u j1 5 p c))
      (subst (dk-cite! 'enc-in-unfold '(EBVAR 0) e))
      (subst (dk-cite! 'open-app2 u j1 7 '(EBVAR 0) e))
      (dk-have! `(NOT (= 0 ,j1)) (lambda () (dk-nn!)))
      (subst (dk-cite! 'open-ebvar-miss u j1 0))
      (subst (dk-cite! 'lc-open u e j1))
      (subst (dk-apply! ih j1))
      (dk-have! `(= (+ ,j1 ,k) ,jk) (lambda () (dk-nn!)))
      (subst `(= (+ ,j1 ,k) ,jk))
      (fact 'open-in-expr u jk b)
      (let ((c2 `(LTCH ,a ,obk ,d ,n ,k))
            (pu `(EAPP 7 (LIST (EBVAR 0) ,e))))
        (dk-cite! 'ltch-expr k a obk d n)
        (mpo-expr! `(ENC-IMP ,pu ,c2))
        (subst (dk-cite! 'enc-all-unfold `(ENC-IMP ,pu ,c2)))
        (subst (dk-cite! 'enc-imp-unfold pu c2))
        (qrfl)))))
(qed 'ltch-open)

;; modus ponens in one context
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL c (IMPLIES (IN (LIST g (ENC-IMP a c)) (DERIVABLE tt))
   (IMPLIES (IN (LIST g a) (DERIVABLE tt)) (IN (LIST g c) (DERIVABLE tt))))))))))
(dk-peel!)
(let* ((imp '(ENC-IMP a c)) (gi `(CTX-ADD g ,imp)))
  (dk-cite! 'der-in-seq 'tt `(LIST g ,imp))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g imp)))
  (dk-split! (dk-cite! 'clf-imp-elim 'a 'c))
  (mi-derive2! `(cut (g ==> c) (given (g ==> ,imp))
                  (backchain (,gi ==> c) (weakening (,gi ==> a) (given (g ==> a))))))
  (mi-lane-close!))
(qed 'der-imp-mp)

;;; THE INSTANTIATION.  [g, LTCH(a, bb, d, n, k)] with bb the body opened at the first n - k projections of z, and each
;;; projection NTH(i, z) in a_i derivable in g: [g, (LTOP(b, z, n, n) in d)] derivable.  By induction on k: each step
;;; instantiates the outer universal at the projection n - k (der-forall-inst, its definedness the strictness of the
;;; membership), opens it (ltch-open), and detaches the guard (der-imp-mp).
(define mpo-proj
  '(FORALL mpoi_ (IMPLIES (IN mpoi_ NN) (IMPLIES (<= 1 mpoi_) (IMPLIES (<= mpoi_ n)
     (IN (LIST g (ENC-IN (ENC-NTH (ENC-NUM mpoi_) (EFVAR z)) (NTH mpoi_ a))) (DERIVABLE tt)))))))
(sp (make-wff `(FORALL k (IMPLIES (IN k NN) (FORALL tt (FORALL g (FORALL a (FORALL b (FORALL d (FORALL n (FORALL z
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES ,m57-msa (IMPLIES (IN n NN) (IMPLIES (<= n (LENGTH a))
   (IMPLIES (IN b EXPR-SET) (IMPLIES (IN d CLT) (IMPLIES (IN z NN) (IMPLIES ,mpo-proj
   (IMPLIES (<= k n) (FORALL bb (IMPLIES (IN bb EXPR-SET) (IMPLIES (= bb (LTOP b z n (- n k)))
   (IMPLIES (IN (LIST g (LTCH a bb d n k)) (DERIVABLE tt)) (IN (LIST g (ENC-IN (LTOP b z n n) d)) (DERIVABLE tt)))))))))))))))))))))))))))
(let ((cs (m57-ni-cases! '(tt g a b d n z))))
  (dk-focus! (car cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (der (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'DERIVABLE) (dk-contains? f 'LTCH))) landed))
         (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (caddr f) 'LTOP))) landed))
         (bb (cadr eqn)) (lt (caddr eqn)) (b (cadr lt)) (z (caddr lt)) (n (cadddr lt))
         (sq (cadr der)) (g (cadr sq)) (ch (caddr sq)) (a (cadr ch)) (d (cadddr ch)))
    (dk-rewrite-h! der ch (caddr (dk-cite! 'ltch-zero a bb d n)))
    (dk-have! `(= (- ,n 0) ,n) (lambda () (dk-nn!)))
    (let ((e2 (dk-rewrite-h! eqn `(- ,n 0) n)))
      (dk-rewrite-h! `(IN (LIST ,g (ENC-IN ,bb ,d)) (DERIVABLE ,(cadr (caddr der)))) bb (caddr e2)))
    (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (append (dk-peel!) (dk-asms)))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'LTCH) (dk-contains? f 'DERIVABLE))) landed))
         (der (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'DERIVABLE) (dk-contains? f 'LTCH))) landed))
         (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (caddr f) 'LTOP))) landed))
         (proj (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-NTH) (dk-contains? f 'DERIVABLE))) landed))
         (tt (cadr (caddr der))) (sq (cadr der)) (g (cadr sq)) (ch (caddr sq))
         (a (cadr ch)) (bb (caddr ch)) (d (cadddr ch)) (n (car (cddddr ch))) (sk (cadr (cddddr ch))) (k (cadr sk))
         (lt (caddr eqn)) (b (cadr lt)) (z (caddr lt))
         (i `(- ,n ,k)) (nk `(ENC-NTH (ENC-NUM ,i) (EFVAR ,z))) (mk `(ENC-IN ,nk (NTH ,i ,a))))
    (if (not (and ih der eqn proj)) (error "ltch-inst: the step's hypotheses are not all landed"))
    (let* ((e (m57-level-entry! n k a))
           (c `(LTCH ,a ,bb ,d ,n ,k)) (p `(ENC-IN (EBVAR 0) ,e)) (bd `(ENC-IMP ,p ,c))
           (ob `(EXPR-OPEN ,bb ,k ,nk)) (c2 `(LTCH ,a ,ob ,d ,n ,k)))
      (mi-cl-facts! d)
      ;; the projection n - k, its definedness
      (dk-apply! proj i)
      (dk-cite! 'der-in-seq tt `(LIST ,g ,mk))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g mk)))
      (dk-split! (dk-cite! 'clf-in-elim nk e))
      (dk-cite! 'clf-eq-intro nk nk)
      (dk-meta-derive! tt `(def-strict-in-l (,g ==> (ENC-EQ ,nk ,nk)) (given (,g ==> ,mk))))
      ;; the universal instantiated and opened
      (fact 'nn-succ-closed k)
      (dk-have! `(<= ,k ,n) (lambda () (dk-nn! `(<= (succ ,k) ,n))))
      (fact 'idx-minus-in-nn n `(succ ,k))
      (dk-have! `(<= (- ,n (succ ,k)) ,n) (lambda () (dk-nn!)))
      (dk-cite! 'ltop-expr `(- ,n (succ ,k)) b z n)
      (let ((bbe (dk-rewrite-h! `(IN (LTOP ,b ,z ,n (- ,n (succ ,k))) EXPR-SET) (caddr eqn) bb)))
        (dk-rewrite-h! der `(LTCH ,a ,bb ,d ,n (succ ,k)) (caddr (dk-cite! 'ltch-succ a bb d n k)))
        ;; K1FIX (2026-11-19): der-forall-inst inlined -- it is proven in meta-def-laws.scm, which loads after this
        ;; file (a cold load in load order did not have it)
        (let* ((al `(ENC-ALL ,bd)) (o `(EXPR-OPEN ,bd 0 ,nk)) (g1 (mi+ g al)))
          (dk-cite! 'der-in-seq tt `(LIST ,g ,al))
          (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g al)))
          (dk-cite! 'clf-open-inst bd nk)
          (dk-meta-derive! tt `(cut (,g ==> ,o) (given (,g ==> ,al))
                                 (forall-elim (,g1 ==> ,o) (assumption (,(mi+ g1 o) ==> ,o))
                                   (weakening (,g1 ==> (ENC-EQ ,nk ,nk)) (given (,g ==> (ENC-EQ ,nk ,nk))))))))
        (mi-num-nn! i)
        (mi-expr! nk)
        (dk-cite! 'ltch-expr k a bb d n)
        (mpo-expr! p)
        (dk-have! `(== (EXPR-OPEN ,bd 0 ,nk) (ENC-IMP ,mk ,c2))
          (lambda ()
            (mi-nn! 0) (mi-nn! 5) (mi-nn! 7)
            (dk-have! `(= (+ 0 ,k) ,k) (lambda () (dk-nn!)))
            (subst (dk-cite! 'enc-imp-unfold p c))
            (subst (dk-cite! 'open-app2 nk 0 5 p c))
            (subst (dk-cite! 'enc-in-unfold '(EBVAR 0) e))
            (subst (dk-cite! 'open-app2 nk 0 7 '(EBVAR 0) e))
            (subst (dk-cite! 'open-ebvar-hit nk 0))
            (subst (dk-cite! 'lc-open nk e 0))
            (subst (dk-apply! (dk-cite! 'ltch-open k a bb d n nk) 0))
            (subst `(= (+ 0 ,k) ,k))
            (fact 'open-in-expr nk k bb)
            (dk-cite! 'ltch-expr k a ob d n)
            (subst (dk-cite! 'enc-in-unfold nk e))
            (subst (dk-cite! 'enc-imp-unfold `(EAPP 7 (LIST ,nk ,e)) c2))
            (qrfl))))
      (dk-rewrite-h! `(IN (LIST ,g (EXPR-OPEN ,bd 0 ,nk)) (DERIVABLE ,tt)) `(EXPR-OPEN ,bd 0 ,nk) `(ENC-IMP ,mk ,c2))
      (dk-cite! 'der-imp-mp tt g mk c2)
      ;; the opened body is the body opened at one more projection
      (let* ((m `(- ,n (succ ,k))) (ls (dk-cite! 'ltop-succ b z n m)))
        (dk-have! `(= (succ ,m) ,i) (lambda () (dk-nn!)))
        (let* ((l2 (dk-rewrite-h! ls `(succ ,m) i)))
          (dk-have! `(= (- ,n ,i) ,k) (lambda () (dk-nn!)))
          (let ((l3 (dk-rewrite-h! l2 `(- ,n ,i) k)))
            (dk-have! `(= ,ob (LTOP ,b ,z ,n ,i))
              (lambda () (subst `(= ,bb ,(caddr eqn))) (subst l3)
                (fact 'open-in-expr nk k `(LTOP ,b ,z ,n ,m))
                (rfl))))))
      ;; the induction hypothesis at the opened body
      (let w1 ((f ih)) (if (dk-head-is? f 'IMPLIES) (w1 (dk-landed-1 (lambda () (detach! f)))) f))
      (let ((u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTCH) (dk-contains? f 'DERIVABLE)
                                            (not (equal? f proj))))
                           (dk-asms))))
        (fact 'open-in-expr nk k bb)
        (dk-apply! u ob)
        (ass)))))
(qed 'ltch-inst)

;; THE KERNEL FIGURE AT EVERY LENGTH.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-LAMBDA-TYPE-N tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (mi-rel-open! 'REL-LAMBDA-TYPE-N 3))      ; K1FIX: the third hypothesis, the codomain's definedness
       (g (car vs)) (l (cadr vs)) (b (caddr vs)) (d (cadddr vs)) (e (list-ref vs 4))
       (ca `(ENC-CART ,l)) (nl `(LENGTH ,l))
       (chain `(LTCH ,l ,b ,d ,nl ,nl))
       (sh `(ENC-IN ,ca ENC-SETC))
       (tb `(ENC-IMP (ENC-IN (EBVAR 0) ,ca) (ENC-IN ,e ,d))) (ty `(ENC-ALL ,tb))
       (lam `(ENC-LAM ,ca ,e)) (fn `(ENC-FUN ,ca ,d)) (goal `(ENC-IN ,lam ,fn))
       (cnd (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTOP) (not (dk-contains? f 'DERIVABLE))))
                        (dk-asms))))
  (if (not cnd) (error "adm-lambda-type-n: no translator condition in context"))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g chain)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g sh)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g goal)))
  (dk-split! (dk-cite! 'clf-in-elim ca 'ENC-SETC))
  (dk-split! (dk-cite! 'clt-cart-elim l))
  (dk-split! (dk-cite! 'clf-in-elim lam fn))
  (let ((u (dk-cite! 'enc-fun-unfold ca d)) (l2 `(LIST ,ca ,d)))
    (dk-rewrite-h! `(IN ,fn CLT) fn (caddr u))
    (dk-have! '(IN 19 NN) (lambda () (arith)))
    (dk-have! '(IN 2 NN) (lambda () (arith)))
    (dk-have! '(<= 1 2) (lambda () (arith)))
    (dk-have! `(<= 2 (LENGTH ,l2)) (lambda () (len-r) (arith)))
    (dk-cite! 'clt-eapp-arg 19 l2 2)
    (dk-nth-h! `(IN (NTH 2 ,l2) CLT)))
  (mi-cl-facts! d)
  (mi-cl-facts! lam) (mi-inv-body! lam 1 0)
  (mi-tcl! ty)
  (fact 'length-in-nn 'EXPR-SET l)
  (dk-have! `(<= ,nl ,nl) (lambda () (dk-nn!)))
  (mi-num-nn! nl)
  (let* ((z (mi-fresh2! g tb)) (ez `(EFVAR ,z))
         (tz (mi-open2! tb 0 ez)) (eo `(EXPR-OPEN ,e 0 ,ez))
         (yin `(ENC-IN ,ez ,ca)) (g4 (mi+ g yin))
         (tp `(ENC-IN ,ez (ENC-TUPLES ENC-SETC))) (le `(ENC-EQ (ENC-LENGTH ,ez) (ENC-NUM ,nl)))
         (cl `(ENC-CARTL ,ez ,l ,nl)) (rhs `(ENC-AND ,tp (ENC-AND ,le ,cl))))
    (if (not (equal? tz `(ENC-IMP ,yin (ENC-IN ,eo ,d))))
        (error "adm-lambda-type-n: the opened typing is not the expected one" (expression->string tz)))
    (dk-cite! 'clt-efvar z)
    (mi-cl-facts! ez)
    (mi-ctx2! g4)
    (dk-apply! (dk-cite! 'enc-cartl-clf nl) ez l)
    (mi-cl! tp 'CLF) (mi-cl! le 'CLF)
    (dk-cite! 'clf-and-intro le cl)
    (dk-cite! 'clf-and-intro tp `(ENC-AND ,le ,cl))
    (dk-cite! 'clf-iff-intro yin rhs)
    (mi-derive2! `(lemma (,g4 ==> ,rhs) der-iff-r (,g4 ,yin ,rhs) (cartesian-mem (,g4 ==> (ENC-IFF ,yin ,rhs))) (assumption (,g4 ==> ,yin))))
    (dk-split! (dk-cite! 'der-and-parts 'tt g4 tp `(ENC-AND ,le ,cl)))
    (dk-split! (dk-cite! 'der-and-parts 'tt g4 le cl))
    ;; every projection in its factor, as the universal ltch-inst reads
    (dk-have! `(FORALL mpoi_ (IMPLIES (IN mpoi_ NN) (IMPLIES (<= 1 mpoi_) (IMPLIES (<= mpoi_ ,nl)
                 (IN (LIST ,g4 (ENC-IN (ENC-NTH (ENC-NUM mpoi_) ,ez) (NTH mpoi_ ,l))) (DERIVABLE tt))))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld))))
          (dk-apply! (dk-cite! 'enc-cartl-elim-der nl) 'tt g4 ez l i)
          (ass))))
    ;; the chain in g4, instantiated
    (mi-derive2! `(weakening (,g4 ==> ,chain) (given (,g ==> ,chain))))
    (dk-cite! 'clt-efvar z)
    (dk-have! `(= (- ,nl ,nl) 0) (lambda () (dk-nn!)))
    (dk-have! `(= ,b (LTOP ,b ,z ,nl (- ,nl ,nl)))
      (lambda () (subst `(= (- ,nl ,nl) 0)) (subst (dk-cite! 'ltop-zero b z nl)) (rfl)))
    (dk-apply! (dk-cite! 'ltch-inst nl) 'tt g4 l b d nl z)
    (let ((u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTCH) (dk-contains? f 'DERIVABLE)))
                         (dk-asms))))
      (dk-apply! u b))
    (dk-apply! cnd z)
    (mi-conv! g4 `(ENC-IN ,eo ,d) `(= ,eo (LTOP ,b ,z ,nl ,nl)))
    (mpo-tcl-open! tb ez tz)
    (mi-derive2! `(implies-intro (,g ==> ,tz) (given (,g4 ==> (ENC-IN ,eo ,d)))))
    (mi-conv! g `(EXPR-OPEN ,tb 0 ,ez) `(= (EXPR-OPEN ,tb 0 ,ez) ,tz))
    (mi-derive2! `(forall-intro (,g ==> ,ty) (given (,g ==> (EXPR-OPEN ,tb 0 ,ez))))))
  (mi-derive2! `(lambda-type (,g ==> ,goal) (given (,g ==> ,ty)) (given (,g ==> ,sh)) (given (,g ==> (ENC-EQ ,d ,d)))))
  (mi-lane-close!))
(qed 'adm-lambda-type-n)
