;; [G, f] from an instance of the universal U = (ENC-ALL b) at the name t: SRC is (theorem) (U a member
;; of T), (assumption) (U in G) or (given g0) ([g0, U] derivable, g0 a sub-context of G); THUNK, called with
;; the context C = G + U + v (v the instance, as mi-open2! computes it or as an equation in context gives
;; it), derives [C, f].
(define (mi-inst! G U t f src thunk)
  (let* ((b (cadr U)) (o `(EXPR-OPEN ,b 0 ,t))
         (v0 (mi-open2! b 0 t))
         (v (if (equal? v0 o)
                (let ((e (find-first (lambda (x) (and (dk-head-is? x '=) (equal? (cadr x) o))) (dk-asms))))
                  (if e (caddr e) o))
                v0))
         (GU (mi+ G U)) (C (mi+ GU v)) (GUo (mi+ GU o)))
    (mi-tcl! v)
    (mi-refl-fact! t)
    (thunk C)
    (if (not (equal? v o)) (mi-conv! GUo f `(= ,o ,v)))
    (mi-derive2! `(cut (,G ==> ,f)
                    ,(case (car src)
                       ((theorem) `(theorem-assumption (,G ==> ,U)))
                       ((assumption) `(assumption (,G ==> ,U)))
                       (else `(weakening (,G ==> ,U) (given (,(cadr src) ==> ,U)))))
                    (forall-elim (,GU ==> ,f) (given (,GUo ==> ,f)) ,(mi-refl-node GU t))))
    (mi-der G f)))

