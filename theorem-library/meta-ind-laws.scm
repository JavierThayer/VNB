           (z (begin (mi-ctx2! g2) (mi-expr! stepb) (dk-skolem! (dk-cite! 'mr-fresh fs g2 stepb) #t)))
           (ez `(EFVAR ,z)) (sz (mi-open2! stepb 0 ez)) (aa (cadr sz)) (ssz `(ENC-SUCC ,ez))
           (g6a (mi+ g2 aa)) (g6 (mi+ g6a (nnc ez) (inc ez)))
           (pz `(EXPR-OPEN ,p 0 ,ez)) (psz `(EXPR-OPEN ,p 0 ,ssz))
           (szv (caddr (dk-apply! us z))) (imp2 (caddr szv))
           (g7 (mi+ g6 sa)) (g8 (mi+ g7 szv)) (g8b (mi+ g8 imp2)))
      (mi-refl-fact! ez)
      ;; p(succ z) from the step hypothesis at z and z in C
      (mi-derive2! `(cut (,g8 ==> ,psz)
                     (backchain (,g8 ==> ,imp2) (assumption (,g8 ==> ,(nnc ez))))
                     (backchain (,g8b ==> ,psz)
                       (lemma (,g8b ==> ,pz) der-comp-out (,g8b ,p ,ez) (assumption (,g8b ==> ,(inc ez)))))))
      (mi-conv! (mi+ g7 `(EXPR-OPEN ,s 0 ,ez)) psz `(= (EXPR-OPEN ,s 0 ,ez) ,szv))
