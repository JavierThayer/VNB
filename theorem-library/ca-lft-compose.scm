;;; ca-lft-compose.scm -- homogeneous coordinates and the composition of linear fractional
;;; transformations (complex-analysis.pdf Prop. 1.18, the computation in its proof).
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;;
;;;   cc-mul-zero-left       x y = 0 and y /= 0 give x = 0
;;;   cc-div-mul-back        (u / v) v = u                       (v /= 0)
;;;   cc-div-cancel          (x w) / (y w) = x / y               (y, w /= 0)
;;;   lin-nondegenerate      ad - bc /= 0 and (u, v) /= 0 give (au + bv, cu + dv) /= 0
;;;   lft-homog              L(phi(u, v)) = phi(au + bv, cu + dv): THE PROOF OF PROP. 1.18, "S respects ~"
;;;                          read through the identification (9)
;;;   homog-point-cover      every point of C u {oo} has homogeneous coordinates
;;;   lft-det-mul            the determinant of the product of the coefficient matrices
;;;   lft-compose            L(a,b,c,d) o L(a2,b2,c2,d2) = L of the product matrix
;;;   lft-scalar-identity    LFT(r, 0, 0, r) is the identity of C u {oo}
;;;
;;; Helper prefix clc-.

(define (clc-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))

(define (clc-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))

(define (clc-vars landed)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) landed)))

(define (clc-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (clc-conj (cdr fs)))))

(define (clc-cite-and! thm fs . terms)
  (let ((c (clc-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))

(define (clc-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))

(define (clc-recip! y)                  ; land (IN (recip y) CC), y typed and /= 0 in context
  (if (not (dk-asm? (list 'IN (list 'recip y) 'CC)))
      (clc-cite-and! 'cc-recip-closed (list (list 'IN y 'CC) (list 'NOT (list '= y 0))) y)))

(define (clc-div! x y)
  (clc-type! x) (clc-type! y)
  (if (not (dk-asm? (list 'IN (list '* x (list 'recip y)) 'CC)))
      (dk-cite! 'cc-div-closed x y)))

;;; rewrite the goal by an equation proved on a lane: S -> T
(define (clc-rewrite! s t prove)
  (if (not (equal? s t))
      (begin
        (dk-have! (list '= s t) prove)
        (subst (list '= s t)))))

(define (clc-crs-rewrite! s t) (clc-rewrite! s t (lambda () (crs))))

;;; ---------------------------------------------------------------------------

(sp (make-wff "forall([x in cc, y in cc], x * y = 0 implies not(y = 0) implies x = 0)"))
(let ((vs (clc-vars (dk-peel!))))
  (dk-cite! 'cc-mul-nonzero (car vs) (cadr vs))
  (prop))
(qed 'cc-mul-zero-left)

(sp (make-wff "forall([u in cc, v in cc], not(v = 0) implies (u / v) * v = u)"))
(let ((vs (clc-vars (dk-peel!))))
  (let ((u (car vs)) (v (cadr vs)))
    (clc-recip! v)
    (clc-cite-and! 'cc-recip-inverse (list (list 'IN v 'CC) (list 'NOT (list '= v 0))) v)
    (let ((r (dk-name! (list 'recip v) 'CC)))
      (subst (list '= (list 'recip v) r))
      (dk-rewrite-h! (list '= (list '* v (list 'recip v)) 1) (list 'recip v) r)
      (clc-crs-rewrite! (list '* (list '* u r) v) (list '* u (list '* v r)))
      (subst (list '= (list '* v r) 1))
      (crs))))
(qed 'cc-div-mul-back)

(sp (make-wff "forall([x in cc, y in cc, w in cc], not(y = 0) implies not(w = 0) implies (x * w) / (y * w) = x / y)"))
(let ((vs (clc-vars (dk-peel!))))
  (let ((x (car vs)) (y (cadr vs)) (w (caddr vs)))
    (clc-recip! y) (clc-recip! w)
    (dk-cite! 'cc-recip-mul y w)
    (subst (list '= (list 'recip (list '* y w)) (list '* (list 'recip y) (list 'recip w))))
    (clc-cite-and! 'cc-recip-inverse (list (list 'IN w 'CC) (list 'NOT (list '= w 0))) w)
    (let* ((ry (dk-name! (list 'recip y) 'CC))
           (rw (dk-name! (list 'recip w) 'CC)))
      (subst (list '= (list 'recip y) ry))
      (subst (list '= (list 'recip w) rw))
      (dk-rewrite-h! (list '= (list '* w (list 'recip w)) 1) (list 'recip w) rw)
      (clc-crs-rewrite! (list '* (list '* x w) (list '* ry rw)) (list '* (list '* x ry) (list '* w rw)))
      (subst (list '= (list '* w rw) 1))
      (crs))))
(qed 'cc-div-cancel)


;;; (au + bv, cu + dv) = (0, 0) forces (u, v) = (0, 0) when ad - bc /= 0.
(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc, u in cc, v in cc], not(a * d - b * c = 0) implies not(u = 0 and v = 0) implies not(a * u + b * v = 0 and c * u + d * v = 0))"))
(let ((vs (clc-vars (dk-peel!))))
  (let* ((a (list-ref vs 0)) (b (list-ref vs 1)) (c (list-ref vs 2)) (d (list-ref vs 3))
         (u (list-ref vs 4)) (v (list-ref vs 5))
         (det (list '- (list '* a d) (list '* b c)))
         (pp  (list '+ (list '* a u) (list '* b v)))
         (qq  (list '+ (list '* c u) (list '* d v))))
    (di)
    (dk-split-all!)
    (clc-type! det)
    (dk-have! (list '= (list '* u det) 0)
      (lambda ()
        (clc-crs-rewrite! (list '* u det) (list '- (list '* d pp) (list '* b qq)))
        (subst (list '= pp 0)) (subst (list '= qq 0)) (crs)))
    (dk-have! (list '= (list '* v det) 0)
      (lambda ()
        (clc-crs-rewrite! (list '* v det) (list '- (list '* a qq) (list '* c pp)))
        (subst (list '= pp 0)) (subst (list '= qq 0)) (crs)))
    (let* ((zu (dk-cite! 'cc-mul-zero-left u det))
           (zv (dk-cite! 'cc-mul-zero-left v det)))
      (dk-only! zu zv (list 'NOT (list 'AND (list '= u 0) (list '= v 0))))
      (prop))))
(qed 'lin-nondegenerate)

;;; ---------------------------------------------------------------------------
;;; THE PROOF OF PROP. 1.18: L(phi(u, v)) = phi(S(u, v)).  Cases on v = 0 (u/v = oo) and on the
;;; vanishing of the denominator; in the finite case z = u/v is NAMED n, with n v = u, so that
;;; au + bv = (an + b) v and cu + dv = (cn + d) v.

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc, u in cc, v in cc], not(a * d - b * c = 0) implies not(u = 0 and v = 0) implies (lft(a, b, c, d))(homog-point(u, v)) = homog-point(a * u + b * v, c * u + d * v))"))
(let ((vs (clc-vars (dk-peel!))))
  (let* ((a (list-ref vs 0)) (b (list-ref vs 1)) (c (list-ref vs 2)) (d (list-ref vs 3))
         (u (list-ref vs 4)) (v (list-ref vs 5))
         (pp  (list '+ (list '* a u) (list '* b v)))
         (qq  (list '+ (list '* c u) (list '* d v)))
         (nd  (list 'NOT (list 'AND (list '= u 0) (list '= v 0)))))
    (clc-type! pp) (clc-type! qq)
    (use-em (list '= v 0)
      (lambda ()
        (dk-have! (list 'NOT (list '= u 0)) (lambda () (dk-only! (list '= v 0) nd) (prop)))
        (subst (list '= v 0))
        (subst (dk-cite! 'homog-point-at-inf u))
        (clc-crs-rewrite! (list '+ (list '* a u) (list '* b 0)) (list '* a u))
        (clc-crs-rewrite! (list '+ (list '* c u) (list '* d 0)) (list '* c u))
        (clc-type! (list '* a u)) (clc-type! (list '* c u))
        (use-em (list '= c 0)
          (lambda ()
            (subst (dk-cite! 'lft-at-inf-pole a b c d))
            (clc-rewrite! (list '* c u) 0 (lambda () (subst (list '= c 0)) (crs)))
            (subst (dk-cite! 'homog-point-at-inf (list '* a u)))
            (clc-finish!))
          (lambda ()
            (subst (dk-cite! 'lft-at-inf a b c d))
            (dk-cite! 'cc-mul-nonzero c u)
            (subst (dk-cite! 'homog-point-finite (list '* a u) (list '* c u)))
            (subst (dk-cite! 'cc-div-cancel a c u))
            (clc-finish!))))
      (lambda ()
        (clc-div! u v)
        (subst (dk-cite! 'homog-point-finite u v))
        (let ((n (dk-name! (list '* u (list 'recip v)) 'CC)))
          (subst (list '= (list '* u (list 'recip v)) n))
          (dk-rewrite-h! (dk-cite! 'cc-div-mul-back u v) (list '* u (list 'recip v)) n)
          (let ((pn (list '+ (list '* a n) b))
                (qn (list '+ (list '* c n) d)))
            (clc-type! pn) (clc-type! qn)
            (dk-have! (list '= pp (list '* pn v)) (lambda () (subst (list '= u (list '* n v))) (crs)))
            (dk-have! (list '= qq (list '* qn v)) (lambda () (subst (list '= u (list '* n v))) (crs)))
            (use-em (list '= qq 0)
              (lambda ()
                (dk-have! (list '= qn 0)
                  (lambda ()
                    (dk-rewrite-h! (list '= qq 0) qq (list '* qn v))
                    (dk-cite! 'cc-mul-zero-left qn v)
                    (clc-finish-ass!)))
                (subst (dk-cite! 'lft-at-pole a b c d n))
                (subst (list '= qq 0))
                (subst (dk-cite! 'homog-point-at-inf pp))
                (clc-finish!))
              (lambda ()
                (dk-have! (list 'NOT (list '= qn 0))
                  (lambda ()
                    (di)
                    (dk-have! (list '= qq 0)
                      (lambda () (subst (list '= qq (list '* qn v))) (subst (list '= qn 0)) (crs)))
                    (dk-only! (list '= qq 0) (list 'NOT (list '= qq 0)))
                    (prop)))
                (subst (dk-cite! 'lft-at-finite a b c d n))
                (subst (dk-cite! 'homog-point-finite pp qq))
                (subst (list '= pp (list '* pn v)))
                (subst (list '= qq (list '* qn v)))
                (subst (dk-cite! 'cc-div-cancel pn qn v))
                (clc-finish!)))))))))
(qed 'lft-homog)

;;; Every point of C u {oo} is phi(u, v) for some (u, v) /= (0, 0): z = phi(z, 1), oo = phi(1, 0).
(sp (make-wff "forall([w in cc-hat], forsome([u in cc], forsome([v in cc], not(u = 0 and v = 0) and w = homog-point(u, v))))"))
(let ((w (dk-di-var!)))
  (fact 'cc-one-in) (fact 'cc-zero-in)
  (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
  (let ((m (dk-cite! 'cc-hat-membership w)))
    (dk-have! (caddr m) (lambda () (dk-only! m (list 'IN w 'CC-HAT)) (prop))))
  (use-cases (list (list 'IN w 'CC) (list '= w 'CC-INF))
    (lambda ()
      (ew w)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-head-is? g 'FORSOME)
                   (ew 1)
                   (dk-conj-close!
                     (lambda ()
                       (let ((g2 (dk-goal)))
                         (cond ((dk-head-is? g2 'NOT) (dk-only! '(NOT (= 1 0))) (prop))
                               ((dk-head-is? g2 '=)
                                (subst (dk-cite! 'homog-point-finite w 1))
                                (subst (dk-cite! 'rr-recip-one))
                                (crs))
                               (#t (clc-finish-ass!)))))))
                  (#t (clc-finish-ass!)))))))
    (lambda ()
      (ew 1)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-head-is? g 'FORSOME)
                   (ew 0)
                   (dk-conj-close!
                     (lambda ()
                       (let ((g2 (dk-goal)))
                         (cond ((dk-head-is? g2 'NOT) (dk-only! '(NOT (= 1 0))) (prop))
                               ((dk-head-is? g2 '=)
                                (subst (dk-cite! 'homog-point-at-inf 1))
                                (clc-finish-ass!))
                               (#t (clc-finish-ass!)))))))
                  (#t (clc-finish-ass!)))))))))
(qed 'homog-point-cover)

;;; det of the product matrix [[a,b],[c,d]] [[a2,b2],[c2,d2]].
(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc, a2 in cc, b2 in cc, c2 in cc, d2 in cc], not(a * d - b * c = 0) implies not(a2 * d2 - b2 * c2 = 0) implies not((a * a2 + b * c2) * (c * b2 + d * d2) - (a * b2 + b * d2) * (c * a2 + d * c2) = 0))"))
(let ((vs (clc-vars (dk-peel!))))
  (let* ((a (list-ref vs 0)) (b (list-ref vs 1)) (c (list-ref vs 2)) (d (list-ref vs 3))
         (a2 (list-ref vs 4)) (b2 (list-ref vs 5)) (c2 (list-ref vs 6)) (d2 (list-ref vs 7))
         (d1 (list '- (list '* a d) (list '* b c)))
         (dd2 (list '- (list '* a2 d2) (list '* b2 c2)))
         (g (dk-goal)))
    (clc-type! d1) (clc-type! dd2)
    (clc-rewrite! (cadr (cadr g)) (list '* d1 dd2) (lambda () (crs)))
    (dk-cite! 'cc-mul-nonzero d1 dd2)
    (clc-finish-ass!)))
(qed 'lft-det-mul)

;;; COMPOSITION: L(a,b,c,d) o L(a2,b2,c2,d2) = L of the product matrix.  The notes: "preserves
;;; composition is immediate from its characterization as a map on the quotient space" -- here, on
;;; homogeneous coordinates: both sides send phi(u, v) to phi of the product applied to (u, v).
(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc, a2 in cc, b2 in cc, c2 in cc, d2 in cc], not(a * d - b * c = 0) implies not(a2 * d2 - b2 * c2 = 0) implies compose(lft(a, b, c, d), lft(a2, b2, c2, d2)) = lft(a * a2 + b * c2, a * b2 + b * d2, c * a2 + d * c2, c * b2 + d * d2))"))
(let ((vs (clc-vars (dk-peel!))))
  (let* ((a (list-ref vs 0)) (b (list-ref vs 1)) (c (list-ref vs 2)) (d (list-ref vs 3))
         (a2 (list-ref vs 4)) (b2 (list-ref vs 5)) (c2 (list-ref vs 6)) (d2 (list-ref vs 7))
         (l1 (list 'LFT a b c d))
         (l2 (list 'LFT a2 b2 c2 d2))
         (g  (dk-goal))
         (l3 (caddr g))
         (fh '(FUN CC-HAT CC-HAT)))
    (for-each clc-type! (cdr l3))
    (dk-cite! 'lft-det-mul a b c d a2 b2 c2 d2)
    (fact 'cc-hat-in-set)
    (dk-cite! 'lft-in-fun a b c d)
    (dk-cite! 'lft-in-fun a2 b2 c2 d2)
    (apply dk-cite! 'lft-in-fun (cdr l3))
    (clc-cite-and! 'compose-type (list (list 'IN l2 fh) (list 'IN l1 fh)) 'CC-HAT 'CC-HAT 'CC-HAT l1 l2)
    (dk-fun-ext! (cadr g) l3 'CC-HAT 'CC-HAT #f #f
      (lambda (z)
        (subst (clc-cite-and! 'compose-apply (list (list 'IN l2 fh) (list 'IN l1 fh))
                              'CC-HAT 'CC-HAT 'CC-HAT l1 l2 z))
        (let* ((u (dk-skolem! (dk-cite! 'homog-point-cover z)))
               (ex (or (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (memq u (free-vars f)))) (dk-asms))
                       (error "lft-compose: no inner existential")))
               (v (dk-skolem! ex))
               (h (list 'HOMOG-POINT u v)))
          (subst (list '= z h))
          (let ((p2 (list '+ (list '* a2 u) (list '* b2 v)))
                (q2 (list '+ (list '* c2 u) (list '* d2 v))))
            (clc-type! p2) (clc-type! q2)
            (subst (dk-cite! 'lft-homog a2 b2 c2 d2 u v))
            (dk-cite! 'lin-nondegenerate a2 b2 c2 d2 u v)
            (subst (dk-cite! 'lft-homog a b c d p2 q2))
            (subst (apply dk-cite! 'lft-homog (append (cdr l3) (list u v))))
            (let* ((g2 (dk-goal))
                   (x1 (cadr (cadr g2))) (y1 (caddr (cadr g2)))
                   (x3 (cadr (caddr g2))) (y3 (caddr (caddr g2))))
              (clc-type! x3) (clc-type! y3)
              (clc-crs-rewrite! x1 x3)
              (clc-crs-rewrite! y1 y3)
              (dk-cite! 'homog-point-in-cc-hat x3 y3)
              (clc-finish!))))))))
(qed 'lft-compose)

;;; LFT(r, 0, 0, r) is the identity of C u {oo}.
(sp (make-wff "forall([r in cc], not(r = 0) implies lft(r, 0, 0, r) = id-fun(cc-hat))"))
(let ((r (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
  (fact 'cc-zero-in) (fact 'cc-one-in)
  (dk-have! '(= 0 0) (lambda () (rfl)))
  (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
  (dk-cite! 'lft-in-fun r 0 0 r)
  (fact 'cc-hat-in-set)
  (dk-cite! 'id-fun-type 'CC-HAT)
  (dk-fun-ext! (list 'LFT r 0 0 r) '(ID-FUN CC-HAT) 'CC-HAT 'CC-HAT #f #f
    (lambda (z)
      (subst (dk-cite! 'id-fun-apply 'CC-HAT z))
      (let ((m (dk-cite! 'cc-hat-membership z)))
        (dk-have! (caddr m) (lambda () (dk-only! m (list 'IN z 'CC-HAT)) (prop))))
      (use-cases (list (list 'IN z 'CC) (list '= z 'CC-INF))
        (lambda ()
          (dk-have! (list 'NOT (list '= (list '+ (list '* 0 z) r) 0))
            (lambda () (clc-crs-rewrite! (list '+ (list '* 0 z) r) r) (clc-finish-ass!)))
          (subst (dk-cite! 'lft-at-finite r 0 0 r z))
          (clc-crs-rewrite! (list '+ (list '* r z) 0) (list '* z r))
          (clc-crs-rewrite! (list '+ (list '* 0 z) r) (list '* 1 r))
          (subst (dk-cite! 'cc-div-cancel z 1 r))
          (subst (dk-cite! 'rr-recip-one))
          (crs))
        (lambda ()
          (subst (list '= z 'CC-INF))
          (subst (dk-cite! 'lft-at-inf-pole r 0 0 r))
          (clc-finish!))))))
(qed 'lft-scalar-identity)
