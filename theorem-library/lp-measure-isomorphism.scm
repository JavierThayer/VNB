                    (dk-have! (list '<= 'POS-INF (list 'abs (list 'f z)))
                      (lambda () (subst '(= POS-INF M)) (dk-have! (list '<= 'M (list 'abs (list 'f z))) (lambda () (mac-h '< (dk-ctx-form (list '< 'M (list 'abs (list 'f z))))) (dk-split-all!) (dk-ass!))) (dk-ass!)))
                    (pbc) (ai (list 'NOT (list '<= 'POS-INF (list 'abs (list 'f z))))))
        (lambda (z) (dk-cite! 'empty-set-has-no-members z) (pbc) (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
      (subst (list '= (mdi-Y 'M) 'EMPTY-SET))
      (dk-ass!))))
