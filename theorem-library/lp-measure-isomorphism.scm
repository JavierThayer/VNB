(define (mdi-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MDI OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mdi-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mdi-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mdi-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mdi-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mdi-mark! . xs)
  (let ((port (open-output-file "/tmp/mdi-trace.txt" #t)))
    (for-each (lambda (x) (write-string (if (string? x) x (expression->string x)) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mdi-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mdi-has-lam? (car l)) (loop (cdr l))))))))
(define (mdi-beta!) (if (mdi-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mdi-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (mdi-tree-sub x y s)) t)) (#t t)))

