(define (mdi-set-eq! a b fwd! bwd!)    ; (= a b) by extensionality: FWD! z proves z in b from z in a, BWD! the converse
  (dk-have! (list 'FORALL 'mdiz_ (list 'IFF (list 'IN 'mdiz_ a) (list 'IN 'mdiz_ b)))
    (lambda () (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                 (dk-iff! (lambda (g) (equal? g (list 'IN z b))) (lambda () (fwd! z)) (lambda () (bwd! z))))))
  (dk-cite! 'class-extensionality a b))
(define (mdi-Y M) (list 'SEP 'lix_ 'omega2 (list '< M '(abs (f lix_)))))
(define (mdi-X M) (list 'SEP 'lix_ 'omega (list '< M (list 'abs (list mdi-fT 'lix_)))))
(define (mdi-pre B) (list 'SEP 'pwx_ 'omega (list 'IN '(tt pwx_) B)))
;; the level sets of |f| are measurable, also at +inf
(sp (make-wff (mdi-alls '(omega2 cb nu f M) (mdi-imps '((IS-MEASURE omega2 cb nu) (IS-REAL-MEASURABLE-FN omega2 cb f) (IN M RR-POS-STAR))
   (list 'IN (mdi-Y 'M) 'cb)))))
