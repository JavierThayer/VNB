(define mdi-iso '(IS-MEASURE-ISOMORPHISM omega ca mu omega2 cb nu tt))
(define (mdi-comp h) (list 'VNB-LAMBDA 'pwz_ 'omega (list h '(tt pwz_))))
(define mdi-lin '(VNB-LAMBDA mdy_ omega2 (+ (f mdy_) (* c (g mdy_)))))
(define mdi-conc
  (list 'AND
    (list 'FORALL 'f (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega2 cb f)
      (list 'AND (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (mdi-comp 'f))
        (list 'AND (list 'FORALL 'p (list 'IMPLIES '(IN p RR) (list 'IMPLIES '(<= 1 p) (list '= (list 'LP-NORM 'omega 'ca 'mu 'p (mdi-comp 'f)) '(LP-NORM omega2 cb nu p f)))))
                   (list '= (list 'LINF-NORM 'omega 'ca 'mu (mdi-comp 'f)) '(LINF-NORM omega2 cb nu f))))))
    (list 'AND
      (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN omega2 RR)) (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN omega2 RR)) (list 'FORALL 'c (list 'IMPLIES '(IN c RR)
        (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list (mdi-comp mdi-lin) 'x) (list '+ (list (mdi-comp 'f) 'x) (list '* 'c (list (mdi-comp 'g) 'x))))))))))))
      (list 'FORALL 'g (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega ca g)
        (list 'FORSOME 'f (list 'AND '(IS-REAL-MEASURABLE-FN omega2 cb f) '(FORALL x (IMPLIES (IN x omega) (= (g x) (f (tt x))))))))))))
(sp (make-wff (mdi-alls '(omega ca mu omega2 cb nu tt) (mdi-imps (list '(IS-MEASURE omega ca mu) '(IS-MEASURE omega2 cb nu) mdi-iso) mdi-conc))))
(dk-peel!)
(dk-project! '(IS-MEASURABLE-MAP omega ca omega2 cb tt) 'is-measure-isomorphism mdi-iso)
(dk-project! '(FORALL mib_ (IMPLIES (IN mib_ cb) (= (nu mib_) (mu (SEP mix_ omega (IN (tt mix_) mib_)))))) 'is-measure-isomorphism mdi-iso)
(dk-have! mdi-pres (lambda () (dk-ass!)))
(dk-project! '(IN tt (FUN omega omega2)) 'is-measurable-map '(IS-MEASURABLE-MAP omega ca omega2 cb tt))
(let* ((ex (dk-project! '(FORSOME mis_ (AND (IS-MEASURABLE-MAP omega2 cb omega ca mis_) (AND (FORALL mix_ (IMPLIES (IN mix_ omega) (= (mis_ (tt mix_)) mix_))) (FORALL miy_ (IMPLIES (IN miy_ omega2) (= (tt (mis_ miy_)) miy_))))))
                        'is-measure-isomorphism mdi-iso))
       (ss (dk-skolem! ex #t)))
  (dk-project! (list 'IN ss '(FUN omega2 omega)) 'is-measurable-map (list 'IS-MEASURABLE-MAP 'omega2 'cb 'omega 'ca ss))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((and (dk-head-is? g 'FORALL) (dk-contains? g 'LINF-NORM))
           ;; isometry for every p and for p = inf
           (let* ((ld (dk-peel!)) (f (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-REAL-MEASURABLE-FN)) ld))))
             (dk-conj-close!
               (lambda ()
                 (let ((g2 (dk-goal)))
                   (cond ((dk-head-is? g2 'IS-REAL-MEASURABLE-FN) (dk-cite! 'pfw-comp-real-measurable 'omega 'ca 'omega2 'cb 'tt f) (dk-ass!))
                         ((dk-head-is? g2 'FORALL)
                          (let* ((ld (dk-peel!)) (p (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'RR))) ld))))
                            (dk-have! (list '< 0 p) (lambda () (dk-ineq! (list 'IN p 'RR) (list '<= 1 p))))
                            (mdi-split! (dk-cite! 'comp-measure-preserving-lp-norm 'omega 'ca 'mu 'omega2 'cb 'nu 'tt f p))
                            (dk-ass!)))
                         (#t (dk-cite! 'comp-measure-preserving-linf-norm 'omega 'ca 'mu 'omega2 'cb 'nu 'tt f) (dk-ass!))))))))
          ((and (dk-head-is? g 'FORALL) (dk-contains? g 'FORSOME))
           ;; onto: g = (g o S) o T
           (let* ((ld (dk-peel!)) (gg (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-REAL-MEASURABLE-FN)) ld))) (fg (list 'VNB-LAMBDA 'pwz_ 'omega2 (list gg (list ss 'pwz_)))))
             (dk-cite! 'pfw-comp-real-measurable 'omega2 'cb 'omega 'ca ss gg)
             (dk-project! (list 'IN gg '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca gg))
             (ew fg)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let* ((x (dk-di-var!)) (tx (list 'tt x)))
                       (dk-cite! 'fun-apply-type-c 'tt 'omega 'omega2 x)
                       (dk-cite! 'fun-apply-type-c ss 'omega2 'omega tx)
                       (dk-cite! 'fun-apply-type-c gg 'omega 'RR (list ss tx))
                       (dk-cite! 'fun-apply-type-c gg 'omega 'RR x)
                       (dk-apply! (dk-ctx-form (list 'FORALL 'mix_ (list 'IMPLIES '(IN mix_ omega) (list '= (list ss '(tt mix_)) 'mix_)))) x)
                       (mdi-beta!)
                       (subst (list '= (list ss tx) x))
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))
          (#t
           ;; linearity
           (let* ((ld (dk-peel!)) (gl (dk-goal)) (x (cadr (cadr gl))))
             (let* ((ff (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(FUN omega2 RR)))) ld)))
                    (gs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(FUN omega2 RR)))) ld)))
                    (cc (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'RR))) ld)))
                    (tx (list 'tt x)))
               (dk-cite! 'fun-apply-type-c 'tt 'omega 'omega2 x)
               (for-each (lambda (h) (dk-cite! 'fun-apply-type-c h 'omega2 'RR tx)) gs)
               (dk-type! (list '* cc (list (cadr gs) tx)))
               (dk-type! (list '+ (list (car gs) tx) (list '* cc (list (cadr gs) tx))))
               (mdi-beta!)
               (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))))
