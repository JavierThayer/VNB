  (dk-have! (caddr mi) (lambda () (if (dk-only! mi '(IN M RR-POS-STAR)) (prop))))
  (use-em '(IN M RR)
    (lambda ()
      (mdi-split! (dk-cite! 'integral-abs-fn 'omega2 'cb 'nu 'f))
      (let* ((cl (dk-project! '(FORALL alpha_ (IMPLIES (IN alpha_ RR) (IN (SEP x_ omega2 (< alpha_ ((ABS-FN omega2 f) x_))) cb)))
                              'is-measurable-fn '(IS-MEASURABLE-FN omega2 cb (ABS-FN omega2 f))))
             (lv (list 'SEP 'x_ 'omega2 '(< M ((ABS-FN omega2 f) x_)))))
        (dk-apply! cl 'M)
        (mdi-set-eq! lv (mdi-Y 'M)
          (lambda (z) (sep-me (dk-ctx-form (list 'IN z lv))) (dk-split-all!)
                      (dk-cite! 'abs-fn-value 'omega2 'f z)
                      (in-sep! (lambda () (dk-ass!)) (lambda () (subst (list '== (list 'abs (list 'f z)) (list '(ABS-FN omega2 f) z))) (dk-ass!))))
          (lambda (z) (sep-me (dk-ctx-form (list 'IN z (mdi-Y 'M)))) (dk-split-all!)
                      (dk-cite! 'abs-fn-value 'omega2 'f z)
                      (in-sep! (lambda () (dk-ass!)) (lambda () (subst (list '== (list '(ABS-FN omega2 f) z) (list 'abs (list 'f z)))) (dk-ass!)))))
        (subst (list '= (mdi-Y 'M) lv))
        (dk-ass!)))
    (lambda ()
      (dk-have! '(= M POS-INF) (lambda () (if (dk-only! (caddr mi) '(NOT (IN M RR))) (prop))))
      (dk-cite! 'sigma-algebra-empty-in 'omega2 'cb)
      (mdi-set-eq! (mdi-Y 'M) 'EMPTY-SET
        (lambda (z) (sep-me (dk-ctx-form (list 'IN z (mdi-Y 'M)))) (dk-split-all!)
                    (dk-cite! 'fun-apply-type-c 'f 'omega2 'RR z) (dk-cite! 'rr-abs-closed (list 'f z))
