;;; basw3-urysohn.scm -- URYSOHN'S LEMMA for a compact Hausdorff space, and Remark 1.27 of the notes:
;;; the characters of C(X) are exactly the point evaluations, and distinct points give distinct ones.
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1, Remark 1.27.  Agent BA-SW3, wave 2026-11-09.
;;; Destination: theorem-library/basw3-urysohn.scm.  Library: operator-algebras (BA-SW2's library;
;;; the Urysohn part, parts 1-5, can move to analysis together with BA-SW2's topology lemmas
;;; top-compact-hausdorff-shrink and its chain, which it cites).  All proofs modulo 0.
;;; LOAD WINDOW: after theorem-library/basw2-cx (top-compact-hausdorff-shrink, the CCONT read-offs and
;;; value laws), BA-SW's basw-top (bsw-rcont-intro, bsw-rcont-elim, bsw-compact-induction) and
;;; structure-library/basw3-vocab.  No file cites this one.
;;; Helper prefix: bu3-.
;;;
;;; THE URYSOHN CONSTRUCTION (basw3-vocab.scm): CU pairs [C, U], halves chosen by global CHOICE,
;;; approximants A_0 = [x not in U], A_{n+1}(c) = (A_n(L c) + A_n(R c))/2, the function sup_n A_n.
;;; Monotone in n (ury-apx-mono), bounded by [0, 1], 0 on C, 1 off U, the midpoint law for the limit
;;; (ury-lim-mid), and the oscillation bound |LIM(c)(y) - LIM(c)(x)| <= (3/4)^n near x (ury-lim-osc),
;;; whence continuity.  No dyadic rationals, no finite-choice lemma.
;;;
;;; REMARK 1.27: ccont-character-is-point-eval (every character chi of C(t), t compact, is the
;;; evaluation at a point: if no point x has ker(chi) inside {g : g(x) = 0}, the bumps c |g|^2 of
;;; ccont-character-bump cover t, compactness sums finitely many into h >= 1 in ker(chi), and h * (1/h) = 1
;;; gives chi(1) = 0); point-eval-character (every evaluation is a character); point-eval-injective
;;; (t compact Hausdorff, by Urysohn on two points).

;;; ---- helpers (prefix bu3-) -----------------------------------------------------------------------
(define (bu3-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (bu3-ass!) (if (and (bu3-open?) (dk-asm? (dk-goal))) (ass)))
(define (bu3-rfl!) (if (bu3-open?) (rfl)))
(define (bu3-close-ctx!) (dk-conj-close! (lambda () (bu3-ass!))))
(define (bu3-dump! tag)
  (display "\n*** DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (if (< (string-length (expression->string a)) 400) (begin (display "      asm: ") (display (expression->string a)) (newline))))
                        (dk-asms-of l)))
            (dk-open-leaves)))
(define (bu3-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** basw3: ") (display name) (display " did NOT close.\n")
        (bu3-dump! name)
        (error "basw3: unfinished" name))))
(define (bu3-rhs! iff)                ; the right side of an IFF instance whose left side is in context, split
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
(define (bu3-lhs! iff thunk)          ; the left side of an IFF instance from its right side, built by THUNK
  (dk-have! (caddr iff) thunk)
  (dk-have! (cadr iff) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(define (bu3-split-cite! . args)      ; cite, split the conjunction that landed
  (let ((r (apply dk-cite! args)))
    (if (dk-head-is? r 'AND) (dk-split-all! (list r)))
    r))
(define (bu3-sub! thunk) (mac 'subset-def) (let ((z (dk-di-var!))) (thunk z)))
(define (bu3-top!)                    ; IS-COMPACT-T t in context: open IS-TOP-SPACE t
  (if (not (dk-asm? '(IS-TOP-SPACE t))) (bu3-rhs! (dk-cite! 'is-compact-t 't)))
  (if (not (dk-asm? '(IN (PTS t) SET))) (bu3-rhs! (dk-cite! 'is-top-space 't))))
(define (bu3-in-power! w)             ; (SUBSET w (PTS t)), (IN (PTS t) SET) in context: land w in POWER(PTS t)
  (if (not (dk-asm? (list 'IN w '(POWER (PTS t)))))
      (begin
        (if (not (dk-asm? (list 'IN w 'SET))) (dk-cite! 'subclass-of-set-is-set w '(PTS t)))
        (let ((imp (dk-cite! 'power-mem-intro '(PTS t) w)))
          (if (dk-head-is? imp 'IMPLIES)
              (begin
                (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd w '(PTS t) z) (bu3-ass!))))
                (detach! imp)))))))
(define (bu3-closed-sub! k)           ; IS-TOP-CLOSED t k in context: land k subset PTS t
  (if (not (dk-asm? (list 'SUBSET k '(PTS t)))) (bu3-rhs! (dk-cite! 'is-top-closed 't k))))
(define (bu3-sep-set! sp0)            ; land (IN sp0 SET) for a SEP over OPENS t or POWER(PTS t)
  (if (not (dk-asm? '(IN (OPENS t) SET))) (dk-cite! 'membership-implies-sethood '(OPENS t) '(POWER (POWER (PTS t)))))
  (if (not (dk-asm? '(IN (POWER (PTS t)) SET))) (dk-cite! 'power-set '(PTS t)))
  (if (not (dk-asm? (list 'IN sp0 'SET))) (dk-have! (list 'IN sp0 'SET) (lambda () (sep-set) (bu3-ass!)))))
(define (bu3-set! x cls) (if (not (dk-asm? (list 'IN x 'SET))) (dk-cite! 'membership-implies-sethood x cls)))

;;; ---- the CU pairs ---------------------------------------------------------------------------------
(define bu3-cu-sep '(SEP ucw_ (CARTESIAN (POWER (PTS t)) (OPENS t))
        (AND (IS-TOP-CLOSED t (NTH 1 ucw_)) (SUBSET (NTH 1 ucw_) (NTH 2 ucw_)))))
(sp (make-wff (list 'FORALL 't (list '== '(CU-PAIRS t) bu3-cu-sep))))
(di) (mac 'CU-PAIRS) (qrfl)
(bu3-qed! 'ury-cu-unfold)

(sp (make-wff '(FORALL t (IMPLIES (IS-TOP-SPACE t) (IN (CU-PAIRS t) SET)))))
(dk-peel!)
(bu3-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'power-set '(PTS t))
(dk-cite! 'membership-implies-sethood '(OPENS t) '(POWER (POWER (PTS t))))
(mac 'CU-PAIRS)
(sep-set)
(bu3-lhs! (dk-cite! 'cartesian-set-iff '(POWER (PTS t)) '(OPENS t)) (lambda () (bu3-close-ctx!)))
(bu3-ass!)
(bu3-qed! 'ury-cu-set)

(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IN c (CU-PAIRS t))
  (AND (IS-TOP-CLOSED t (NTH 1 c)) (AND (IN (NTH 2 c) (OPENS t)) (AND (SUBSET (NTH 1 c) (NTH 2 c))
       (= c (LIST (NTH 1 c) (NTH 2 c)))))))))))
(dk-peel!)
(dk-cite! 'ury-cu-unfold 't)
(let ((m (dk-rewrite-h! '(IN c (CU-PAIRS t)) '(CU-PAIRS t) bu3-cu-sep)))
  (sep-me m)
  (dk-split-all!)
  (bu3-split-cite! 'cartesian-nth 'c '(POWER (PTS t)) '(OPENS t))
  (dk-cite! 'cartesian-pair-eq 'c '(POWER (PTS t)) '(OPENS t))
  (bu3-close-ctx!))
(bu3-qed! 'ury-cu-parts)

(sp (make-wff '(FORALL t (FORALL a (FORALL u (IMPLIES (IS-TOP-SPACE t) (IMPLIES (IS-TOP-CLOSED t a)
   (IMPLIES (IN u (OPENS t)) (IMPLIES (SUBSET a u) (IN (LIST a u) (CU-PAIRS t)))))))))))
(dk-peel!)
(bu3-rhs! (dk-cite! 'is-top-space 't))
(bu3-closed-sub! 'a)
(bu3-in-power! 'a)
(bu3-set! 'u '(OPENS t))
(mac 'CU-PAIRS)
(in-sep! (lambda () (dk-cite! 'pair-in-cartesian '(POWER (PTS t)) '(OPENS t) 'a 'u) (bu3-ass!))
         (lambda () (nth-r) (bu3-close-ctx!)))
(bu3-qed! 'ury-cu-intro)

;;; ---- the chosen middles ---------------------------------------------------------------------------
(define (bu3-parts! c)                ; c in CU-PAIRS t: land its parts
  (if (not (dk-asm? (list 'SUBSET (list 'NTH 1 c) (list 'NTH 2 c))))
      (bu3-split-cite! 'ury-cu-parts 't c)))
(define bu3-vsep '(SEP uvv_ (OPENS t)
     (FORSOME uvk_ (AND (IN uvk_ (POWER (PTS t))) (AND (IS-TOP-CLOSED t uvk_)
       (AND (SUBSET (NTH 1 c) uvv_) (AND (SUBSET uvv_ uvk_) (SUBSET uvk_ (NTH 2 c)))))))))
(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (AND (IN (URY-V t c) (OPENS t))
       (FORSOME uvk_ (AND (IN uvk_ (POWER (PTS t))) (AND (IS-TOP-CLOSED t uvk_)
         (AND (SUBSET (NTH 1 c) (URY-V t c)) (AND (SUBSET (URY-V t c) uvk_) (SUBSET uvk_ (NTH 2 c)))))))))))))))
(dk-peel!)
(bu3-top!)
(bu3-parts! 'c)
(mac 'URY-V)
(bu3-sep-set! bu3-vsep)
(let ((imp (dk-cite! 'choice-axiom bu3-vsep)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((v (dk-skolem! (dk-cite! 'top-compact-hausdorff-shrink 't '(NTH 1 c) '(NTH 2 c))))
             (k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h v))) "the closed middle"))))
        (dk-split-all!)
        (bu3-closed-sub! k)
        (bu3-in-power! k)
        (ew v)
        (in-sep! (lambda () (bu3-ass!))
                 (lambda () (ew k) (bu3-close-ctx!))))))
  (let ((m (dk-landed-1 (lambda () (detach! imp)))))
    (sep-me m)
    (bu3-close-ctx!)))
(bu3-qed! 'ury-v-spec)

(define bu3-ksep '(SEP uvk_ (POWER (PTS t))
     (AND (IS-TOP-CLOSED t uvk_) (AND (SUBSET (URY-V t c) uvk_) (SUBSET uvk_ (NTH 2 c))))))
(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (AND (IN (URY-K t c) (POWER (PTS t))) (AND (IS-TOP-CLOSED t (URY-K t c))
       (AND (SUBSET (URY-V t c) (URY-K t c)) (SUBSET (URY-K t c) (NTH 2 c))))))))))))
(dk-peel!)
(bu3-top!)
(bu3-parts! 'c)
(bu3-split-cite! 'ury-v-spec 't 'c)
(define bu3-k0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h '(URY-V t c)))) "the closed middle")))
(dk-split-all!)
(mac 'URY-K)
(bu3-sep-set! bu3-ksep)
(let ((imp (dk-cite! 'choice-axiom bu3-ksep)))
  (dk-have! (cadr imp)
    (lambda ()
      (ew bu3-k0)
      (bu3-closed-sub! bu3-k0)
      (bu3-in-power! bu3-k0)
      (in-sep! (lambda () (bu3-ass!)) (lambda () (bu3-close-ctx!)))))
  (let ((m (dk-landed-1 (lambda () (detach! imp)))))
    (sep-me m)
    (dk-split-all!)
    (bu3-close-ctx!)))
(bu3-qed! 'ury-k-spec)

(define (bu3-mid! c)                  ; land the specs of the middles of c
  (if (not (dk-asm? (list 'IN (list 'URY-K 't c) '(POWER (PTS t)))))
      (begin (bu3-split-cite! 'ury-v-spec 't c)
             (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h (list 'URY-V 't c)))) "the closed middle"))
             (dk-split-all!)
             (bu3-split-cite! 'ury-k-spec 't c))))

(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (IN (URY-L t c) (CU-PAIRS t)))))))))
(dk-peel!)
(bu3-top!) (bu3-parts! 'c) (bu3-mid! 'c)
(mac 'URY-L)
(dk-cite! 'ury-cu-intro 't '(NTH 1 c) '(URY-V t c))
(bu3-ass!)
(bu3-qed! 'ury-l-in)

(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (IN (URY-R t c) (CU-PAIRS t)))))))))
(dk-peel!)
(bu3-top!) (bu3-parts! 'c) (bu3-mid! 'c)
(mac 'URY-R)
(dk-cite! 'ury-cu-intro 't '(URY-K t c) '(NTH 2 c))
(bu3-ass!)
(bu3-qed! 'ury-r-in)

;;; the projections of the halves
(sp (make-wff '(FORALL t (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (AND (= (NTH 1 (URY-L t c)) (NTH 1 c)) (AND (= (NTH 2 (URY-L t c)) (URY-V t c))
  (AND (= (NTH 1 (URY-R t c)) (URY-K t c)) (= (NTH 2 (URY-R t c)) (NTH 2 c))))))))))))
(dk-peel!)
(bu3-top!) (bu3-parts! 'c) (bu3-mid! 'c)
(bu3-closed-sub! '(NTH 1 c))
(bu3-in-power! '(NTH 1 c))
(bu3-set! '(NTH 2 c) '(OPENS t))
(bu3-set! '(URY-V t c) '(OPENS t))
(bu3-set! '(URY-K t c) '(POWER (PTS t)))
(mac 'URY-L) (mac 'URY-R)
(nth-r)
(dk-conj-close! (lambda () (bu3-rfl!)))
(bu3-qed! 'ury-lr-nth)

;;; ---- the approximants -----------------------------------------------------------------------------
(define bu3-lam0 '(VNB-LAMBDA uac_ (CU-PAIRS t) (IF (IN x (NTH 2 uac_)) 0 1)))
(define (bu3-lams n) (list 'VNB-LAMBDA 'uac_ '(CU-PAIRS t)
  (list '* 1/2 (list '+ (list (list 'URY-APX 't 'x n) '(URY-L t uac_)) (list (list 'URY-APX 't 'x n) '(URY-R t uac_))))))
(define (bu3-apx n c) (list (list 'URY-APX 't 'x n) c))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL t (FORALL x (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t)
  (IN (URY-APX t x n) (FUN (CU-PAIRS t) RR))))))))))
(let* ((ind (dk-use-induction-fixed! '(t x))) (n (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (bu3-top!)
  (dk-cite! 'ury-cu-set 't)
  (dk-cite! 'ury-apx-zero 't 'x)
  (subst (list '= '(URY-APX t x 0) bu3-lam0))
  (dk-lam-type!
    (lambda ()
      (let* ((c (dk-di-var!)) (ift (list 'IF (list 'IN 'x (list 'NTH 2 c)) 0 1)))
        (dk-case-if! ift (lambda (tr v) (if tr (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)) (bu3-ass!)))))
    (lambda () (bu3-ass!)))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (bu3-top!)
  (dk-cite! 'ury-cu-set 't)
  (dk-cite! 'ury-apx-succ 't 'x n)
  (subst (list '= (list 'URY-APX 't 'x (list 'succ n)) (bu3-lams n)))
  (dk-lam-type!
    (lambda ()
      (let* ((c (dk-di-var!)) (L (list 'URY-L 't c)) (R (list 'URY-R 't c)))
        (dk-cite! 'ury-l-in 't c) (dk-cite! 'ury-r-in 't c)
        (dk-cite! 'fun-apply-type-c (list 'URY-APX 't 'x n) '(CU-PAIRS t) 'RR L)
        (dk-cite! 'fun-apply-type-c (list 'URY-APX 't 'x n) '(CU-PAIRS t) 'RR R)
        (in-rr)))
    (lambda () (bu3-ass!))))
(bu3-qed! 'ury-apx-type)

(define (bu3-ty! n c)                 ; land A_n(c) in RR (c in CU in context)
  (let ((a (bu3-apx n c)))
    (if (and (eqv? n 0) (not (dk-asm? '(IN 0 NN)))) (dk-cite! 'nn-zero-in))
    (if (not (dk-asm? (list 'IN a 'RR)))
        (begin
          (dk-cite! 'ury-apx-type n 't 'x)
          (dk-cite! 'fun-apply-type-c (list 'URY-APX 't 'x n) '(CU-PAIRS t) 'RR c)))))

(define (bu3-zero-val! tr)
  (dk-peel!)
  (bu3-top!)
  (dk-cite! 'ury-cu-set 't)
  (dk-cite! 'ury-apx-zero 't 'x)
  (subst (list '= '(URY-APX t x 0) bu3-lam0))
  (let ((ift '(IF (IN x (NTH 2 c)) 0 1)))
    (dk-have! (list 'IN ift 'SET)
      (lambda ()
        (dk-if-branch! tr ift #f
          (lambda () (if tr (begin (dk-cite! 'rr-zero-in) (dk-cite! 'membership-implies-sethood 0 'RR))
                             (begin (dk-cite! 'rr-one-in) (dk-cite! 'membership-implies-sethood 1 'RR)))
                     (bu3-ass!)))))
    (dk-lam-b!)
    (if (bu3-open?) (dk-if-branch! tr ift #f (lambda () (bu3-rfl!))))))
(sp (make-wff '(FORALL t (FORALL x (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (IMPLIES (IN x (NTH 2 c)) (= ((URY-APX t x 0) c) 0))))))))))
(bu3-zero-val! #t)
(bu3-qed! 'ury-apx-zero-in)
(sp (make-wff '(FORALL t (FORALL x (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (IMPLIES (NOT (IN x (NTH 2 c))) (= ((URY-APX t x 0) c) 1))))))))))
(bu3-zero-val! #f)
(bu3-qed! 'ury-apx-zero-out)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL t (FORALL x (FORALL c (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (IMPLIES (IN c (CU-PAIRS t))
  (= ((URY-APX t x (succ n)) c) (* 1/2 (+ ((URY-APX t x n) (URY-L t c)) ((URY-APX t x n) (URY-R t c)))))))))))))))
(dk-peel!)
(bu3-top!)
(dk-cite! 'ury-cu-set 't)
(dk-cite! 'ury-l-in 't 'c) (dk-cite! 'ury-r-in 't 'c)
(bu3-ty! 'n '(URY-L t c)) (bu3-ty! 'n '(URY-R t c))
(define bu3-sv '(* 1/2 (+ ((URY-APX t x n) (URY-L t c)) ((URY-APX t x n) (URY-R t c)))))
(dk-real! bu3-sv)
(dk-cite! 'membership-implies-sethood bu3-sv 'RR)
(dk-cite! 'ury-apx-succ 't 'x 'n)
(subst (list '= '(URY-APX t x (succ n)) (bu3-lams 'n)))
(dk-lam-b!)
(bu3-rfl!)
(bu3-qed! 'ury-apx-succ-val)

;;; ---- the approximants: bounds, values on C and off U, monotonicity -------------------------------
;;; ineq with the context's real atoms as premises: typings in RR, <=, <, and the equations between
;;; real terms (an equation of sets or lists would poison the call)
(define (bu3-real-prem? f)
  (and (pair? f)
       (not (dk-contains? f 'FORALL)) (not (dk-contains? f 'FORSOME)) (not (dk-contains? f 'IMPLIES))
       (or (and (eq? (car f) 'IN) (eq? (caddr f) 'RR))
           (memq (car f) '(<= <))
           (and (eq? (car f) '=) (not (dk-contains? f 'NTH)) (not (dk-contains? f 'LIST))
                (not (dk-contains? f 'CU-PAIRS)) (not (dk-contains? f 'OPENS))
                (or (dk-contains? f 'URY-APX) (dk-contains? f 'URY-LIM) (dk-contains? f 'abs) (dk-contains? f 'POWER))))))
(define (bu3-atoms f)                 ; the approximant and limit terms of F
  (cond ((not (pair? f)) '())
        ((and (pair? (car f)) (eq? (caar f) 'URY-APX)) (list f))
        ((eq? (car f) 'URY-LIM) (list f))
        (#t (apply append (map bu3-atoms f)))))
(define (bu3-ineq!)                   ; premises whose atoms are all typed in RR
  (let* ((as (dk-asms))
         (typed (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) as)))
         (ok? (lambda (f) (or (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))
                              (every (lambda (a) (member a typed)) (bu3-atoms f))))))
    (apply dk-ineq! (filter (lambda (f) (and (bu3-real-prem? f) (ok? f) (not (dk-contains? f 'abs)))) as))))
(define (bu3-fact! . args)            ; dk-cite!, then detach conjunctive antecedents from context
  (let loop ((r (apply dk-cite! args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-head-is? (cadr r) 'AND))
        (begin (dk-have! (cadr r) (lambda () (bu3-close-ctx!)))
               (loop (dk-landed-1 (lambda () (detach! r)))))
        (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
            (loop (dk-landed-1 (lambda () (detach! r))))
            r))))
(define (bu3-L c) (list 'URY-L 't c))
(define (bu3-R c) (list 'URY-R 't c))
(define (bu3-halves! c)               ; c in CU in context: land L c, R c in CU and the projections
  (if (not (dk-asm? (list 'IN (bu3-R c) '(CU-PAIRS t))))
      (begin
        (dk-cite! 'ury-l-in 't c) (dk-cite! 'ury-r-in 't c)
        (bu3-split-cite! 'ury-lr-nth 't c)
        (bu3-mid! c))))
(define (bu3-sv! n c)                 ; land A_(succ n)(c) = 1/2 (A_n(L c) + A_n(R c)) with the typings
  (bu3-halves! c)
  (bu3-ty! n (bu3-L c)) (bu3-ty! n (bu3-R c))
  (dk-cite! 'nn-succ-closed n)
  (bu3-ty! (list 'succ n) c)
  (dk-cite! 'ury-apx-succ-val n 't 'x c))
(define (bu3-ind-stmt body)           ; forall n in NN. forall t x. compact => hausdorff => forall c in CU. BODY
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 't (list 'FORALL 'x (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
    (list 'FORALL 'c (list 'IMPLIES '(IN c (CU-PAIRS t)) body)))))))))
(define (bu3-induct! base! step!)     ; drive the induction of a bu3-ind-stmt; STEP! gets (n ih c)
  (let* ((ind (dk-use-induction-fixed! '(t x))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
    (dk-focus! (cdr (assq 'base ind)))
    (let* ((pe (dk-peel!)) (c (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(CU-PAIRS t)))) "the pair"))))
      (bu3-top!) (bu3-parts! c) (bu3-ty! 0 c)
      (base! c))
    (dk-focus! (cdr (assq 'step ind)))
    (let* ((pe (dk-peel!)) (c (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(CU-PAIRS t)))) "the pair"))))
      (bu3-top!) (bu3-parts! c)
      (step! n ih c))))
(define (bu3-ih! ih c)                ; the IH at c, split when it is a conjunction
  (let ((r (dk-apply! ih c))) (if (dk-head-is? r 'AND) (dk-split-all! (list r))) r))

;;; 0 <= A_n(c) <= 1
(sp (make-wff (bu3-ind-stmt (list 'AND (list '<= 0 (bu3-apx 'n 'c)) (list '<= (bu3-apx 'n 'c) 1)))))
(bu3-induct!
  (lambda (c)
    (use-em (list 'IN 'x (list 'NTH 2 c))
      (lambda () (dk-cite! 'ury-apx-zero-in 't 'x c) (dk-conj-close! (lambda () (bu3-ineq!))))
      (lambda () (dk-cite! 'ury-apx-zero-out 't 'x c) (dk-conj-close! (lambda () (bu3-ineq!))))))
  (lambda (n ih c)
    (bu3-sv! n c)
    (bu3-ih! ih (bu3-L c)) (bu3-ih! ih (bu3-R c))
    (dk-conj-close! (lambda () (bu3-ineq!)))))
(bu3-qed! 'ury-apx-bounds)
(define (bu3-bnd! n c) (bu3-ty! n c) (if (not (dk-asm? (list '<= 0 (bu3-apx n c)))) (bu3-split-cite! 'ury-apx-bounds n 't 'x c)))

;;; x in C => A_n(c) = 0
(sp (make-wff (bu3-ind-stmt (list 'IMPLIES '(IN x (NTH 1 c)) (list '= (bu3-apx 'n 'c) 0)))))
(bu3-induct!
  (lambda (c)
    (dk-cite! 'subset-mem-fwd (list 'NTH 1 c) (list 'NTH 2 c) 'x)
    (dk-cite! 'ury-apx-zero-in 't 'x c)
    (bu3-ass!))
  (lambda (n ih c)
    (bu3-sv! n c)
    (let* ((L (bu3-L c)) (R (bu3-R c)))
      (dk-rewrite-h! (list 'IN 'x (list 'NTH 1 c)) (list 'NTH 1 c) (list 'NTH 1 L))
      (dk-cite! 'subset-mem-fwd (list 'NTH 1 c) '(URY-V t c) 'x)
      (dk-cite! 'subset-mem-fwd '(URY-V t c) '(URY-K t c) 'x)
      (dk-rewrite-h! '(IN x (URY-K t c)) '(URY-K t c) (list 'NTH 1 R))
      (dk-apply! ih L) (dk-apply! ih R)
      (bu3-ineq!))))
(bu3-qed! 'ury-apx-on-c)

;;; x not in U => A_n(c) = 1
(sp (make-wff (bu3-ind-stmt (list 'IMPLIES '(NOT (IN x (NTH 2 c))) (list '= (bu3-apx 'n 'c) 1)))))
(bu3-induct!
  (lambda (c)
    (dk-cite! 'ury-apx-zero-out 't 'x c)
    (bu3-ass!))
  (lambda (n ih c)
    (bu3-sv! n c)
    (let* ((L (bu3-L c)) (R (bu3-R c)))
      (dk-rewrite-h! (list 'NOT (list 'IN 'x (list 'NTH 2 c))) (list 'NTH 2 c) (list 'NTH 2 R))
      (dk-have! '(NOT (IN x (URY-V t c)))
        (lambda ()
          (di)
          (dk-cite! 'subset-mem-fwd '(URY-V t c) '(URY-K t c) 'x)
          (dk-cite! 'subset-mem-fwd '(URY-K t c) (list 'NTH 2 c) 'x)
          (if (dk-only! (list 'IN 'x (list 'NTH 2 c)) (list 'NOT (list 'IN 'x (list 'NTH 2 c)))) (prop))))
      (dk-rewrite-h! '(NOT (IN x (URY-V t c))) '(URY-V t c) (list 'NTH 2 L))
      (dk-apply! ih L) (dk-apply! ih R)
      (bu3-ineq!))))
(bu3-qed! 'ury-apx-off-u)
(define (bu3-onc! n c) (bu3-ty! n c) (dk-cite! 'ury-apx-on-c n 't 'x c))
(define (bu3-offu! n c) (bu3-ty! n c) (dk-cite! 'ury-apx-off-u n 't 'x c))

;;; U(c1) subset C(c2) => A_k(c2) <= A_m(c1), any m, k
(sp (make-wff '(FORALL t (FORALL x (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t)
  (FORALL c1 (IMPLIES (IN c1 (CU-PAIRS t)) (FORALL c2 (IMPLIES (IN c2 (CU-PAIRS t)) (IMPLIES (SUBSET (NTH 2 c1) (NTH 1 c2))
    (FORALL m (IMPLIES (IN m NN) (FORALL k (IMPLIES (IN k NN) (<= ((URY-APX t x k) c2) ((URY-APX t x m) c1)))))))))))))))))
(dk-peel!)
(bu3-top!)
(bu3-parts! 'c1) (bu3-parts! 'c2)
(bu3-bnd! 'm 'c1) (bu3-bnd! 'k 'c2)
(use-em '(IN x (NTH 2 c1))
  (lambda ()
    (dk-cite! 'subset-mem-fwd '(NTH 2 c1) '(NTH 1 c2) 'x)
    (bu3-onc! 'k 'c2)
    (bu3-ineq!))
  (lambda ()
    (bu3-offu! 'm 'c1)
    (bu3-ineq!)))
(bu3-qed! 'ury-apx-le-of-sub)
(define (bu3-los! c1 c2 m k) (dk-cite! 'ury-apx-le-of-sub 't 'x c1 c2 m k))

;;; A_n(R c) <= A_n(c) <= A_n(L c)
(define (bu3-sub-rw! f eqs)           ; F in context; rewrite by each (FROM . TO) in turn; return the result
  (fold-left (lambda (acc p) (dk-rewrite-h! acc (car p) (cdr p))) f eqs))
(sp (make-wff (bu3-ind-stmt (list 'AND (list '<= (bu3-apx 'n '(URY-R t c)) (bu3-apx 'n 'c))
                                       (list '<= (bu3-apx 'n 'c) (bu3-apx 'n '(URY-L t c)))))))
(bu3-induct!
  (lambda (c)
    (bu3-halves! c)
    (let ((L (bu3-L c)) (R (bu3-R c)))
      (bu3-bnd! 0 L) (bu3-bnd! 0 R)
      (use-em (list 'IN 'x (list 'NTH 2 c))
        (lambda ()
          (dk-cite! 'ury-apx-zero-in 't 'x c)
          (dk-rewrite-h! (list 'IN 'x (list 'NTH 2 c)) (list 'NTH 2 c) (list 'NTH 2 R))
          (dk-cite! 'ury-apx-zero-in 't 'x R)
          (dk-conj-close! (lambda () (bu3-ineq!))))
        (lambda ()
          (dk-cite! 'ury-apx-zero-out 't 'x c)
          (dk-rewrite-h! (list 'NOT (list 'IN 'x (list 'NTH 2 c))) (list 'NTH 2 c) (list 'NTH 2 R))
          (dk-cite! 'ury-apx-zero-out 't 'x R)
          (dk-have! '(NOT (IN x (URY-V t c)))
            (lambda ()
              (di)
              (dk-cite! 'subset-mem-fwd '(URY-V t c) '(URY-K t c) 'x)
              (dk-cite! 'subset-mem-fwd '(URY-K t c) (list 'NTH 2 c) 'x)
              (if (dk-only! (list 'IN 'x (list 'NTH 2 c)) (list 'NOT (list 'IN 'x (list 'NTH 2 c)))) (prop))))
          (dk-rewrite-h! '(NOT (IN x (URY-V t c))) '(URY-V t c) (list 'NTH 2 L))
          (dk-cite! 'ury-apx-zero-out 't 'x L)
          (dk-conj-close! (lambda () (bu3-ineq!)))))))
  (lambda (n ih c)
    (bu3-sv! n c)
    (let* ((L (bu3-L c)) (R (bu3-R c)) (LR (bu3-L R)) (RL (bu3-R L)))
      (bu3-sv! n R) (bu3-sv! n L)
      (bu3-ih! ih R) (bu3-ih! ih L)
      ;; V(c) subset K(c), read as U(L c) subset C(L R c) and as U(R L c) subset C(R c)
      (bu3-sub-rw! '(SUBSET (URY-V t c) (URY-K t c))
                   (list (cons '(URY-K t c) (list 'NTH 1 R)) (cons (list 'NTH 1 R) (list 'NTH 1 LR))
                         (cons '(URY-V t c) (list 'NTH 2 L))))
      (bu3-sub-rw! '(SUBSET (URY-V t c) (URY-K t c))
                   (list (cons '(URY-K t c) (list 'NTH 1 R)) (cons '(URY-V t c) (list 'NTH 2 L))
                         (cons (list 'NTH 2 L) (list 'NTH 2 RL))))
      (bu3-los! L LR n n)
      (bu3-los! RL R n n)
      (dk-conj-close! (lambda () (bu3-ineq!))))))
(bu3-qed! 'ury-apx-mid)

;;; A_n(c) <= A_(succ n)(c)
(sp (make-wff (bu3-ind-stmt (list '<= (bu3-apx 'n 'c) (bu3-apx '(succ n) 'c)))))
(bu3-induct!
  (lambda (c)
    (bu3-sv! 0 c)
    (let ((L (bu3-L c)) (R (bu3-R c)))
      (bu3-bnd! 0 L) (bu3-bnd! 0 R) (bu3-bnd! 0 c)
      (use-em (list 'IN 'x (list 'NTH 2 c))
        (lambda () (dk-cite! 'ury-apx-zero-in 't 'x c) (bu3-ineq!))
        (lambda ()
          (dk-cite! 'ury-apx-zero-out 't 'x c)
          (dk-rewrite-h! (list 'NOT (list 'IN 'x (list 'NTH 2 c))) (list 'NTH 2 c) (list 'NTH 2 R))
          (dk-cite! 'ury-apx-zero-out 't 'x R)
          (bu3-split-cite! 'ury-apx-mid 0 't 'x c)
          (bu3-ineq!)))))
  (lambda (n ih c)
    (bu3-sv! n c)
    (bu3-sv! (list 'succ n) c)
    (dk-apply! ih (bu3-L c)) (dk-apply! ih (bu3-R c))
    (bu3-ineq!)))
(bu3-qed! 'ury-apx-mono)

;;; A_k(c) <= A_(k + d)(c)
(sp (make-wff '(FORALL d (IMPLIES (IN d NN) (FORALL t (FORALL x (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t)
   (FORALL c (IMPLIES (IN c (CU-PAIRS t)) (FORALL k (IMPLIES (IN k NN) (<= ((URY-APX t x k) c) ((URY-APX t x (+ k d)) c))))))))))))))
(let* ((ind (dk-use-induction-fixed! '(t x))) (d (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (bu3-top!)
  (dk-cite! 'nn-add-zero 'k)
  (bu3-ty! 'k 'c)
  (subst '(= (+ k 0) k))
  (dk-cite! 'rr-leq-reflexive (bu3-apx 'k 'c))
  (bu3-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (bu3-top!)
  (let ((kd (list '+ 'k d)))
    (dk-cite! 'nn-add-succ 'k d)
    (dk-have! (list 'AND '(IN k NN) (list 'IN d 'NN)) (lambda () (bu3-close-ctx!)))
    (bu3-fact! 'nn-add-closed 'k d)
    (subst (list '= (list '+ 'k (list 'succ d)) (list 'succ kd)))
    (dk-apply! ih 'c 'k)
    (dk-cite! 'ury-apx-mono kd 't 'x 'c)
    (bu3-ty! kd 'c) (bu3-ty! 'k 'c)
    (dk-cite! 'nn-succ-closed kd) (bu3-ty! (list 'succ kd) 'c)
    (bu3-ineq!)))
(bu3-qed! 'ury-apx-mono-add)

;;; ---- the limit: sup_n A_n(c)(x) ------------------------------------------------------------------
(define (bu3-S c) (list 'SEP 'ulr_ 'RR (list 'FORSOME 'uln_ (list 'AND '(IN uln_ NN) (list '= 'ulr_ (list (list 'URY-APX 't 'x 'uln_) c))))))
(define (bu3-lim c) (list 'URY-LIM 't c 'x))
(define bu3-rps 'RR-POS-STAR)

(sp (make-wff (list 'FORALL 't (list 'FORALL 'c (list 'FORALL 'x (list '== (bu3-lim 'c) (list 'ESUP (bu3-S 'c))))))))
(di) (mac 'URY-LIM) (qrfl)
(bu3-qed! 'ury-lim-unfold)

(define (bu3-lim-stmt body)           ; forall t x. compact => hausdorff => forall c in CU. BODY
  (list 'FORALL 't (list 'FORALL 'x (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
    (list 'FORALL 'c (list 'IMPLIES '(IN c (CU-PAIRS t)) body)))))))
(define (bu3-open-s! z c)             ; (IN z S(c)) in context: land z in RR, n in NN, z = A_n(c); return n
  (sep-me (list 'IN z (bu3-S c)))
  (let ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h z))) "the index"))))
    (dk-split-all!)
    n))

(sp (make-wff (bu3-lim-stmt (list 'SUBSET (bu3-S 'c) bu3-rps))))
(dk-peel!)
(bu3-top!)
(mac 'subset-def)
(let* ((z (dk-di-var!)) (n (bu3-open-s! z 'c)))
  (bu3-bnd! n 'c)
  (dk-have! (list '<= 0 z) (lambda () (bu3-ineq!)))
  (dk-cite! 'rmc-rps-of-nonneg z)
  (bu3-ass!))
(bu3-qed! 'ury-lim-sub)

(define (bu3-lim-pre! c)              ; land LIM(c) == ESUP S(c) and S(c) subset RR-POS-STAR
  (if (not (dk-asm? (list 'SUBSET (bu3-S c) bu3-rps)))
      (begin (dk-cite! 'ury-lim-unfold 't c 'x)
             (dk-cite! 'ury-lim-sub 't 'x c))))

(sp (make-wff (bu3-lim-stmt (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (bu3-apx 'n 'c) (bu3-lim 'c)))))))
(dk-peel!)
(bu3-top!)
(bu3-lim-pre! 'c)
(bu3-ty! 'n 'c)
(subst (list '= (bu3-lim 'c) (list 'ESUP (bu3-S 'c))))
(dk-have! (list 'IN (bu3-apx 'n 'c) (bu3-S 'c))
  (lambda () (in-sep! (lambda () (bu3-ass!)) (lambda () (ew 'n) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-rfl!))))))))
(dk-cite! 'esup-upper (bu3-S 'c) (bu3-apx 'n 'c))
(bu3-ass!)
(bu3-qed! 'ury-lim-upper)

(sp (make-wff (bu3-lim-stmt (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
  (list 'IMPLIES (list 'FORALL 'ulq_ (list 'IMPLIES '(IN ulq_ NN) (list '<= (bu3-apx 'ulq_ 'c) 'b)))
    (list '<= (bu3-lim 'c) 'b)))))))
(dk-peel!)
(bu3-top!)
(bu3-lim-pre! 'c)
(define bu3-hb (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'b) (dk-contains? h 'URY-APX))) "the bound"))
(bu3-bnd! 0 'c)
(dk-apply! bu3-hb 0)
(dk-have! '(<= 0 b) (lambda () (bu3-ineq!)))
(dk-cite! 'rmc-rps-of-nonneg 'b)
(subst (list '= (bu3-lim 'c) (list 'ESUP (bu3-S 'c))))
(let ((r (dk-cite! 'esup-least (bu3-S 'c) 'b)))
  (dk-have! (caddr (cadr r))
    (lambda ()
      (let* ((z (dk-di-var!)) (n (bu3-open-s! z 'c)))
        (bu3-ty! n 'c)
        (dk-apply! bu3-hb n)
        (bu3-ineq!))))
  (dk-have! (cadr r) (lambda () (bu3-close-ctx!)))
  (detach! r)
  (bu3-ass!))
(bu3-qed! 'ury-lim-least)

(define (bu3-least! c b thunk)        ; land LIM(c) <= b; THUNK proves A_q(c) <= b for the index q it is given
  (let* ((v (find-first (lambda (w) (not (dk-contains? b w))) '(ulq_ ulp_ ulo_)))
         (h (list 'FORALL v (list 'IMPLIES (list 'IN v 'NN) (list '<= (bu3-apx v c) b)))))
    (dk-real! b)
    (dk-have! h (lambda () (let ((q (dk-di-var!))) (bu3-ty! q c) (thunk q))))
    (dk-cite! 'ury-lim-least 't 'x c b)))
(define (bu3-upper! n c) (bu3-ty! n c) (dk-cite! 'ury-lim-upper 't 'x c n))

(sp (make-wff (bu3-lim-stmt (list 'AND (list 'IN (bu3-lim 'c) 'RR) (list 'AND (list '<= 0 (bu3-lim 'c)) (list '<= (bu3-lim 'c) 1))))))
(dk-peel!)
(bu3-top!)
(bu3-lim-pre! 'c)
(dk-cite! 'rr-one-in)
(bu3-least! 'c 1 (lambda (q) (bu3-bnd! q 'c) (bu3-ineq!)))
(bu3-bnd! 0 'c)
(bu3-upper! 0 'c)
(dk-cite! 'esup-in (bu3-S 'c))
(dk-rewrite-h! (list 'IN (list 'ESUP (bu3-S 'c)) bu3-rps) (list 'ESUP (bu3-S 'c)) (bu3-lim 'c))
(bu3-fact! 'rr-pos-star-le-real-in-rr (bu3-lim 'c) 1)
(dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-ineq!))))
(bu3-qed! 'ury-lim-real)
(define (bu3-lreal! c) (if (not (dk-asm? (list 'IN (bu3-lim c) 'RR))) (bu3-split-cite! 'ury-lim-real 't 'x c)))

(sp (make-wff (bu3-lim-stmt (list 'IMPLIES '(IN x (NTH 1 c)) (list '= (bu3-lim 'c) 0)))))
(dk-peel!)
(bu3-top!)
(dk-cite! 'rr-zero-in)
(bu3-least! 'c 0 (lambda (q) (bu3-onc! q 'c) (bu3-ineq!)))
(bu3-lreal! 'c)
(bu3-ineq!)
(bu3-qed! 'ury-lim-on-c)

(sp (make-wff (bu3-lim-stmt (list 'IMPLIES '(NOT (IN x (NTH 2 c))) (list '= (bu3-lim 'c) 1)))))
(dk-peel!)
(bu3-top!)
(bu3-offu! 0 'c)
(bu3-upper! 0 'c)
(bu3-lreal! 'c)
(bu3-ineq!)
(bu3-qed! 'ury-lim-off-u)

;;; LIM(c) = (LIM(L c) + LIM(R c)) / 2
(sp (make-wff (bu3-lim-stmt (list '= (bu3-lim 'c) (list '* 1/2 (list '+ (bu3-lim '(URY-L t c)) (bu3-lim '(URY-R t c))))))))
(dk-peel!)
(bu3-top!)
(bu3-halves! 'c)
(define bu3-cL (bu3-L 'c))
(define bu3-cR (bu3-R 'c))
(bu3-lreal! 'c) (bu3-lreal! bu3-cL) (bu3-lreal! bu3-cR)
;; LIM(c) <= the midpoint: A_q(c) <= A_(succ q)(c) = (A_q(L) + A_q(R))/2
(bu3-least! 'c (list '* 1/2 (list '+ (bu3-lim bu3-cL) (bu3-lim bu3-cR)))
  (lambda (q)
    (dk-cite! 'ury-apx-mono q 't 'x 'c)
    (bu3-sv! q 'c)
    (bu3-upper! q bu3-cL) (bu3-upper! q bu3-cR)
    (bu3-ineq!)))
;; A_k2(R) <= 2 LIM(c) - LIM(L), every k2
(define bu3-b2 (list '- (list '* 2 (bu3-lim 'c)) (bu3-lim bu3-cL)))
(bu3-least! bu3-cR bu3-b2
  (lambda (k2)
    (bu3-least! bu3-cL (list '- (list '* 2 (bu3-lim 'c)) (bu3-apx k2 bu3-cR))
      (lambda (k1)
        (let ((s (list '+ k1 k2)))
          (dk-have! (list 'AND (list 'IN k1 'NN) (list 'IN k2 'NN)) (lambda () (bu3-close-ctx!)))
          (bu3-fact! 'nn-add-closed k1 k2)
          (bu3-fact! 'nn-add-closed k2 k1)
          (bu3-fact! 'nn-add-comm k2 k1)
          (dk-cite! 'ury-apx-mono-add k2 't 'x bu3-cL k1)
          (dk-cite! 'ury-apx-mono-add k1 't 'x bu3-cR k2)
          (dk-rewrite-h! (list '<= (bu3-apx k2 bu3-cR) (bu3-apx (list '+ k2 k1) bu3-cR)) (list '+ k2 k1) s)
          (bu3-ty! s bu3-cL) (bu3-ty! s bu3-cR)
          (bu3-sv! s 'c)
          (bu3-upper! (list 'succ s) 'c)
          (bu3-ineq!))))
    (bu3-ineq!)))
(bu3-ineq!)
(bu3-qed! 'ury-lim-mid)

;;; ---- the oscillation of the limit: |LIM(c)(y) - LIM(c)(x)| <= (3/4)^n near x ----------------------
;;; the intersection clause of IS-TOP-SPACE as a citable theorem (BA-SW2 finding F7)
(sp (make-wff '(FORALL t (IMPLIES (IS-TOP-SPACE t) (FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t))
   (IN (INTERSECTION u v) (OPENS t))))))))))
(dk-peel!)
(bu3-rhs! (dk-cite! 'is-top-space 't))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION))) "the intersection clause") 'u 'v)
(bu3-ass!)
(bu3-qed! 'top-open-inter2)

(define (bu3-inter-in! p u v)
  (if (not (dk-asm? (list 'IN p (list 'INTERSECTION u v))))
      (bu3-lhs! (dk-cite! 'intersection-membership u v p) (lambda () (bu3-close-ctx!)))))
(define (bu3-inter-out! q u v) (bu3-rhs! (dk-cite! 'intersection-membership u v q)))
(define (bu3-pw n) (list 'POWER 3/4 n))
(define (bu3-atoms2 f)                ; approximant, limit and power atoms of F
  (cond ((not (pair? f)) '())
        ((and (pair? (car f)) (eq? (caar f) 'URY-APX)) (list f))
        ((memq (car f) '(URY-LIM POWER)) (list f))
        (#t (apply append (map bu3-atoms2 f)))))
(define (bu3-ineq-on! keys)           ; ineq from KEYS plus the RR typings of their atoms and the goal's
  (let* ((atoms (apply append (map bu3-atoms2 (cons (dk-goal) keys))))
         (tys (filter dk-asm? (map (lambda (a) (list 'IN a 'RR)) atoms)))
         (prems (let loop ((l (append keys tys)) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (#t (loop (cdr l) (cons (car l) acc)))))))
    (apply dk-ineq! prems)))
(define (bu3-abs-ineq! keys)          ; goal |X| <= C; an |Y| <= D among KEYS is used through its two parts
  (let* ((keys2 (apply append
                  (map (lambda (h)
                         (if (and (dk-head-is? h '<=) (dk-head-is? (cadr h) 'abs))
                             (let ((y (cadr (cadr h))) (d (caddr h)))
                               (dk-real! y) (dk-real! d)
                               (if (not (dk-asm? (list '<= y d))) (bu3-split-cite! 'rr-abs-le-parts y d))
                               (list (list '<= (list '- d) y) (list '<= y d)))
                             (list h)))
                       keys)))
         (g (dk-goal)) (x (cadr (cadr g))) (c (caddr g)))
    (dk-real! x) (dk-real! c)
    (let ((imp (dk-cite! 'rr-abs-le-of-parts x c)))
      (dk-have! (cadr imp) (lambda () (bu3-ineq-on! keys2)))
      (let ((i2 (dk-landed-1 (lambda () (detach! imp)))))
        (dk-have! (cadr i2) (lambda () (bu3-ineq-on! keys2)))
        (detach! i2)
        (bu3-ass!)))))
(define bu3-psucc #f)
(define (bu3-limp c z) (list 'URY-LIM 't c z))
(define (bu3-osc-body c)
  (list 'FORSOME 'uow_ (list 'AND '(IN uow_ (OPENS t)) (list 'AND '(IN x uow_)
    (list 'FORALL 'uoy_ (list 'IMPLIES '(IN uoy_ uow_)
      (list '<= (list 'abs (list '- (bu3-limp c 'uoy_) (bu3-limp c 'x))) (bu3-pw 'n))))))))
(define (bu3-lr-at! c z)              ; land LIM(c)(z) in RR, 0 <=, <= 1 (z any point)
  (if (not (dk-asm? (list 'IN (bu3-limp c z) 'RR))) (bu3-split-cite! 'ury-lim-real 't z c)))
(define (bu3-mid-at! c z)             ; land the midpoint equation of LIM(c) at z
  (bu3-lr-at! c z) (bu3-lr-at! (bu3-L c) z) (bu3-lr-at! (bu3-R c) z)
  (dk-cite! 'ury-lim-mid 't z c))
(define (bu3-pow! n)                  ; land (3/4)^n in RR, 0 <= (3/4)^n, and the succ law
  (dk-real! 3/4)
  (if (not (dk-asm? (list 'IN (bu3-pw n) 'RR)))
      (begin
        (dk-cite! 'power-real-closed 3/4 n)
        (dk-have! '(<= 0 3/4) (lambda () (bu3-ineq!)))
        (dk-cite! 'rr-power-nonneg n 3/4))))
(define (bu3-pow-succ! n)
  (bu3-pow! n)
  (dk-cite! 'nn-succ-closed n)
  (bu3-pow! (list 'succ n))
  (dk-cite! 'rr-subset-cc 3/4)
  (dk-have! (list 'AND '(IN 3/4 CC) (list 'IN n 'NN)) (lambda () (bu3-close-ctx!)))
  (bu3-fact! 'power-succ 3/4 n))
(define (bu3-ex-w! w closer)          ; goal (bu3-osc-body c): witness w; CLOSER gets the point y
  (ew w)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (bu3-ass!))
              ((dk-head-is? g 'FORALL) (let ((y (dk-di-var!))) (closer y)))
              (#t (error "bu3-ex-w!: unexpected goal" (expression->string g))))))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 't (list 'FORALL 'x (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
  (list 'IMPLIES '(IN x (PTS t)) (list 'FORALL 'c (list 'IMPLIES '(IN c (CU-PAIRS t)) (bu3-osc-body 'c))))))))))))
(let* ((ind (dk-use-induction-fixed! '(t x))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: the whole space, the values lie in [0, 1]
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (bu3-top!)
  (dk-cite! 'nn-zero-in)
  (bu3-pow! 0)
  (dk-cite! 'rr-subset-cc 3/4)
  (dk-cite! 'power-zero 3/4)
  (bu3-ex-w! '(PTS t)
    (lambda (y)
      (bu3-lr-at! 'c y) (bu3-lr-at! 'c 'x)
      (bu3-abs-ineq! (list (list '<= 0 (bu3-limp 'c y)) (list '<= (bu3-limp 'c y) 1)
                           (list '<= 0 (bu3-limp 'c 'x)) (list '<= (bu3-limp 'c 'x) 1)
                           (list '= (bu3-pw 0) 1)))))
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (bu3-top!)
  (bu3-parts! 'c)
  (bu3-halves! 'c)
  (set! bu3-psucc (bu3-pow-succ! n))
  (let* ((L (bu3-L 'c)) (R (bu3-R 'c)))
    (use-em '(IN x (URY-V t c))
      ;; x in V: near x, inside V, LIM(R) = 0 and LIM(c) = LIM(L)/2
      (lambda ()
        (let* ((w1 (dk-skolem! (dk-apply! ih L)))
               (b1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w1))) "the bound near x")))
          (dk-cite! 'top-open-inter2 't w1 '(URY-V t c))
          (bu3-inter-in! 'x w1 '(URY-V t c))
          (bu3-ex-w! (list 'INTERSECTION w1 '(URY-V t c))
            (lambda (y)
              (bu3-inter-out! y w1 '(URY-V t c))
              (let ((bd (dk-apply! b1 y))
                    (eqs (apply append (map
                      (lambda (z)
                        (dk-cite! 'subset-mem-fwd '(URY-V t c) '(URY-K t c) z)
                        (dk-rewrite-h! (list 'IN z '(URY-K t c)) '(URY-K t c) (list 'NTH 1 R))
                        (list (bu3-mid-at! 'c z) (dk-cite! 'ury-lim-on-c 't z R)))
                      (list y 'x)))))
                (bu3-abs-ineq! (append (list bd bu3-psucc (list '<= 0 (bu3-pw n))) eqs)))))))
      ;; x not in V: off the closed K(L c), LIM(L L c) = 1, and the bounds at R L c and R c combine
      (lambda ()
        (let* ((LL (bu3-L L)) (RL (bu3-R L)) (K1 '(URY-K t (URY-L t c))) (V1 '(URY-V t (URY-L t c)))
               (O (list 'COMPLEMENT-IN '(PTS t) K1)))
          (bu3-halves! L)
          (bu3-rhs! (dk-cite! 'is-top-closed 't K1))
          (dk-rewrite-h! (list 'SUBSET K1 (list 'NTH 2 L)) (list 'NTH 2 L) '(URY-V t c))
          (dk-cite! 'ury-r-in 't L)
          (let* ((w2 (dk-skolem! (dk-apply! ih RL)))
                 (b2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w2))) "the bound at R L c"))
                 (w3 (dk-skolem! (dk-apply! ih R)))
                 (b3 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w3))) "the bound at R c"))
                 (W1 (list 'INTERSECTION O w2))
                 (W (list 'INTERSECTION W1 w3))
                 (off! (lambda (z)          ; z not in K1 in context: LIM(c)(z) through the halves
                         (dk-have! (list 'NOT (list 'IN z V1))
                           (lambda () (di) (dk-cite! 'subset-mem-fwd V1 K1 z)
                                      (if (dk-only! (list 'IN z K1) (list 'NOT (list 'IN z K1))) (prop))))
                         (dk-rewrite-h! (list 'NOT (list 'IN z V1)) V1 (list 'NTH 2 LL))
                         (bu3-lr-at! LL z)
                         (list (dk-cite! 'ury-lim-off-u 't z LL)
                               (bu3-mid-at! 'c z)
                               (bu3-mid-at! L z)))))
            (dk-have! (list 'NOT (list 'IN 'x K1))
              (lambda () (di) (dk-cite! 'subset-mem-fwd K1 '(URY-V t c) 'x)
                         (if (dk-only! '(IN x (URY-V t c)) '(NOT (IN x (URY-V t c)))) (prop))))
            (bu3-lhs! (dk-cite! 'complement-in-membership '(PTS t) K1 'x) (lambda () (bu3-close-ctx!)))
            (dk-cite! 'top-open-inter2 't O w2)
            (dk-cite! 'top-open-inter2 't W1 w3)
            (bu3-inter-in! 'x O w2)
            (bu3-inter-in! 'x W1 w3)
            (bu3-ex-w! W
              (lambda (y)
                (bu3-inter-out! y W1 w3)
                (bu3-inter-out! y O w2)
                (bu3-rhs! (dk-cite! 'complement-in-membership '(PTS t) K1 y))
                (let* ((bd2 (dk-apply! b2 y)) (bd3 (dk-apply! b3 y))
                       (ey (off! y)) (ex (off! 'x)))
                  (bu3-abs-ineq! (append (list bd2 bd3 bu3-psucc (list '<= 0 (bu3-pw n))) ey ex)))))))))))
(bu3-qed! 'ury-lim-osc)

;;; ---- URYSOHN'S LEMMA for a compact Hausdorff space ------------------------------------------------
;;; The function is x |-> URY-LIM(t, [a, X - b], x); continuity by the oscillation lemma at succ(cap),
;;; where cap is the threshold with (3/4)^cap <= eps.
(define bu3-U '(COMPLEMENT-IN (PTS t) b))
(define bu3-c0 (list 'LIST 'a bu3-U))
(define bu3-f (list 'VNB-LAMBDA 'ufx_ '(PTS t) (list 'URY-LIM 't bu3-c0 'ufx_)))
(define (bu3-abs-lt! keys)            ; goal |X| < C; an |Y| <= D among KEYS is used through its two parts
  (let* ((keys2 (apply append
                  (map (lambda (h)
                         (if (and (dk-head-is? h '<=) (dk-head-is? (cadr h) 'abs))
                             (let ((y (cadr (cadr h))) (d (caddr h)))
                               (dk-real! y) (dk-real! d)
                               (if (not (dk-asm? (list '<= y d))) (bu3-split-cite! 'rr-abs-le-parts y d))
                               (list (list '<= (list '- d) y) (list '<= y d)))
                             (list h)))
                       keys)))
         (g (dk-goal)) (x (cadr (cadr g))) (c (caddr g)))
    (dk-real! x) (dk-real! c)
    (let ((imp (dk-cite! 'rr-abs-lt-of-parts x c)))
      (dk-have! (list '< (list '- c) x) (lambda () (bu3-ineq-on! keys2)))
      (dk-have! (list '< x c) (lambda () (bu3-ineq-on! keys2)))
      (dk-apply! imp)
      (bu3-ass!))))

(sp (make-wff '(FORALL t (FORALL a (FORALL b (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t)
  (IMPLIES (IS-TOP-CLOSED t a) (IMPLIES (IS-TOP-CLOSED t b)
    (IMPLIES (FORALL unx_ (IMPLIES (IN unx_ a) (NOT (IN unx_ b))))
      (FORSOME uf_ (AND (IN uf_ (RCONT t))
        (AND (FORALL uyz_ (IMPLIES (IN uyz_ (PTS t)) (AND (<= 0 (uf_ uyz_)) (<= (uf_ uyz_) 1))))
          (AND (FORALL uyz_ (IMPLIES (IN uyz_ a) (= (uf_ uyz_) 0)))
               (FORALL uyz_ (IMPLIES (IN uyz_ b) (= (uf_ uyz_) 1)))))))))))))))))
(dk-peel!)
(bu3-top!)
(define bu3-dj (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'unx_))) "the disjointness"))
(bu3-closed-sub! 'a)
(bu3-closed-sub! 'b)
;; a subset U = X - b, so c0 = [a, U] is a CU pair
(dk-have! (list 'SUBSET 'a bu3-U)
  (lambda ()
    (bu3-sub! (lambda (z)
      (dk-cite! 'subset-mem-fwd 'a '(PTS t) z)
      (dk-apply! bu3-dj z)
      (bu3-lhs! (dk-cite! 'complement-in-membership '(PTS t) 'b z) (lambda () (bu3-close-ctx!)))
      (bu3-ass!)))))
(dk-cite! 'ury-cu-intro 't 'a bu3-U)
(define (bu3-guard g) (caddr (cadr (caddr g))))   ; FORALL v (IMPLIES (IN v X) _): X
(define (bu3-fv! z)                   ; z in PTS t: land LIM(c0)(z) in RR, its bounds
  (bu3-lr-at! bu3-c0 z))
;; the function is in FUN(PTS t, RR)
(dk-have! (list 'IN bu3-f '(FUN (PTS t) RR))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (bu3-fv! z) (bu3-ass!))) (lambda () (bu3-ass!)))))
(ew bu3-f)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (bu3-ass!))
        ;; continuity
        ((dk-head-is? g 'IN)
         (let ((imp (dk-cite! 'bsw-rcont-intro 't bu3-f)))
           (dk-have! (cadr imp)
             (lambda ()
               (let* ((pe (dk-peel!))
                      (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
                      (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe)))))
                 (dk-cite! 'rr-pos-rr-in-rr e)
                 (dk-cite! 'rr-lt-of-pos-rr e)
                 (dk-real! 3/4)
                 (dk-have! '(<= 0 3/4) (lambda () (dk-ineq! '(IN 3/4 RR))))
                 (dk-have! '(< 3/4 1) (lambda () (dk-ineq! '(IN 3/4 RR))))
                 (dk-have! '(AND (<= 0 3/4) (< 3/4 1)) (lambda () (bu3-close-ctx!)))
                 (let* ((cap (dk-skolem! (dk-cite! 'power-small-threshold 3/4 e)))
                        (thr (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cap) (dk-contains? h e))) "the threshold"))
                        (n (list 'succ cap)))
                   (dk-cite! 'nn-le-refl cap)
                   (let* ((t0 (dk-apply! thr cap))
                          (ps (bu3-pow-succ! cap))
                          (w (dk-skolem! (dk-cite! 'ury-lim-osc n 't p bu3-c0)))
                          (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w))) "the oscillation bound")))
                     (dk-cite! 'top-open-subset 't w)
                     (ew w)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'FORALL)
                             (let ((q (dk-di-var!)))
                               (dk-cite! 'subset-mem-fwd w '(PTS t) q)
                               (let ((bd (dk-apply! cl q)))
                                 (bu3-fv! p) (bu3-fv! q)
                                 (dk-lam-b!)
                                 (bu3-abs-lt! (list bd ps t0 (list '<= 0 (bu3-pw cap)) (list '< 0 e) (list 'IN e 'RR)))))
                             (bu3-ass!)))))))))
           (dk-landed-1 (lambda () (detach! imp)))
           (bu3-ass!)))
        ;; the bounds on PTS t
        ((and (dk-head-is? g 'FORALL) (equal? (bu3-guard g) '(PTS t)))
         (let ((z (dk-di-var!)))
           (bu3-fv! z)
           (dk-lam-b!)
           (bu3-close-ctx!)))
        ;; zero on a
        ((and (dk-head-is? g 'FORALL) (eq? (bu3-guard g) 'a))
         (let ((z (dk-di-var!)))
           (dk-cite! 'subset-mem-fwd 'a '(PTS t) z)
           (bu3-fv! z)
           (dk-have! (list 'IN z (list 'NTH 1 bu3-c0)) (lambda () (nth-r) (bu3-ass!)))
           (dk-cite! 'ury-lim-on-c 't z bu3-c0)
           (dk-lam-b!)
           (bu3-ass!)))
        ;; one on b
        ((dk-head-is? g 'FORALL)
         (let ((z (dk-di-var!)))
           (dk-cite! 'subset-mem-fwd 'b '(PTS t) z)
           (bu3-fv! z)
           (dk-have! (list 'NOT (list 'IN z bu3-U))
             (lambda () (di) (bu3-rhs! (dk-cite! 'complement-in-membership '(PTS t) 'b z))
                        (if (dk-only! (list 'IN z 'b) (list 'NOT (list 'IN z 'b))) (prop))))
           (dk-have! (list 'NOT (list 'IN z (list 'NTH 2 bu3-c0))) (lambda () (nth-r) (bu3-ass!)))
           (dk-cite! 'ury-lim-off-u 't z bu3-c0)
           (dk-lam-b!)
           (bu3-ass!)))
        (#t (error "urysohn: unexpected goal" (expression->string g)))))))
(bu3-qed! 'urysohn-compact-hausdorff)

;;; ---- Remark 1.27: the characters of C(t) ----------------------------------------------------------
(define bu3-A '(CCONT-ALGEBRA t))
(define bu3-chsep
  '(SEP bac_ (FUN (VEC a) CC)
     (AND (IS-CC-LINEAR-ON a bac_)
     (AND (FORALL bax_ (IMPLIES (IN bax_ (VEC a)) (FORALL bay_ (IMPLIES (IN bay_ (VEC a))
            (= (bac_ ((VMUL a) bax_ bay_)) (* (bac_ bax_) (bac_ bay_)))))))
          (= (bac_ (VONE a)) 1)))))
(define (bu3-sub-a e) (cond ((eq? e 'a) bu3-A) ((pair? e) (map bu3-sub-a e)) (#t e)))
(sp (make-wff (list 'FORALL 't (list '== (list 'CHARACTERS bu3-A) (bu3-sub-a bu3-chsep)))))
(di) (mac 'CHARACTERS) (qrfl)
(bu3-qed! 'ccx-characters-unfold)

(define bu3-accs '(VEC VADD ACT VMUL VONE))
(define (bu3-alg-typings!)            ; the components of CCONT-ALGEBRA(t) typed: the tuple is certified defined
  (for-each (lambda (n) (dk-cite! n 't))
            '(ccont-is-set ccont-vadd-type ccont-vmul-type ccont-vneg-type ccont-vstar-type ccont-act-type
              ccont-vzero-type ccont-vone-type ccont-vnrm-type))
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
(define (bu3-readoffs!) (for-each (lambda (acc) (dk-cite! (symbol-append 'ccont-algebra- acc) 't)) bu3-accs))
(define bu3-accvals '((VEC (CCONT t)) (VADD (CCONT-VADD t)) (ACT (CCONT-ACT t)) (VMUL (CCONT-VMUL t)) (VONE (CCONT-VONE t))))
(define (bu3-acc-subst! dir)          ; dir 'down: accessors of A -> values; 'up: values -> accessors
  (for-each (lambda (p)
              (let ((from (list (car p) bu3-A)) (to (cadr p)))
                (if (eq? dir 'down)
                    (if (dk-contains? (dk-goal) from) (subst (list '= from to)))
                    (if (dk-contains? (dk-goal) to) (subst (list '= to from))))))
            bu3-accvals))
(define (bu3-chlaws ch)               ; the laws of a character CH of C(t), concretely
  (list 'AND (list 'IN ch '(FUN (CCONT t) CC))
   (list 'AND (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (CCONT t)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (CCONT t))
                (list '= (list ch '((CCONT-VADD t) bax_ bay_)) (list '+ (list ch 'bax_) (list ch 'bay_)))))))
   (list 'AND (list 'FORALL 'baz_ (list 'IMPLIES '(IN baz_ CC) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (CCONT t))
                (list '= (list ch '((CCONT-ACT t) baz_ bax_)) (list '* 'baz_ (list ch 'bax_)))))))
   (list 'AND (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (CCONT t)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (CCONT t))
                (list '= (list ch '((CCONT-VMUL t) bax_ bay_)) (list '* (list ch 'bax_) (list ch 'bay_)))))))
              (list '= (list ch '(CCONT-VONE t)) 1))))))

;;; a character of C(t), read concretely
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'uch_ (list 'IMPLIES (list 'IN 'uch_ (list 'CHARACTERS bu3-A))
  (bu3-chlaws 'uch_)))))))
(dk-peel!)
(bu3-top!)
(let* ((sepA (caddr (dk-cite! 'ccx-characters-unfold 't)))
       (m1 (dk-rewrite-h! (list 'IN 'uch_ (list 'CHARACTERS bu3-A)) (list 'CHARACTERS bu3-A) sepA)))
  (sep-me m1)
  (dk-split-all!)
  (bu3-rhs! (dk-cite! 'is-cc-linear-on bu3-A 'uch_))
  (bu3-readoffs!)
  (bu3-acc-subst! 'up)
  (bu3-close-ctx!))
(bu3-qed! 'ccont-character-laws)

;;; the evaluation at a point, at an argument
(sp (make-wff '(FORALL t (FORALL x (IMPLIES (IN x (PTS t)) (FORALL f (IMPLIES (IN f (CCONT t))
   (= ((POINT-EVAL t x) f) (f x)))))))))
(dk-peel!)
(bu3-split-cite! 'ccont-parts 't 'f)
(dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC 'x)
(mac 'POINT-EVAL)
(dk-lam-b!)
(bu3-rfl!)
(bu3-qed! 'point-eval-val)

;;; typing in CCONT(t) of the terms built from the operations (IS-TOP-SPACE t in context)
(define (bu3-cty! e)
  (cond ((dk-asm? (list 'IN e '(CCONT t))) #t)
        ((equal? e '(CCONT-VONE t)) (dk-cite! 'ccont-vone-type 't))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL)))
         (bu3-cty! (cadr e)) (bu3-cty! (caddr e))
         (dk-cite! (if (eq? (caar e) 'CCONT-VADD) 'ccont-vadd-in 'ccont-vmul-in) 't (cadr e) (caddr e)))
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-ACT))
         (bu3-cty! (caddr e))
         (dk-cite! 'ccont-act-in 't (cadr e) (caddr e)))
        (#t (error "bu3-cty!: untyped" (expression->string e)))))
(define (bu3-cval! f z)               ; f in CCONT t: land f z in CC
  (if (not (dk-asm? (list 'IN f '(FUN (PTS t) CC)))) (bu3-split-cite! 'ccont-parts 't f))
  (if (not (dk-asm? (list 'IN (list f z) 'CC))) (dk-cite! 'fun-apply-type-c f '(PTS t) 'CC z)))
(define (bu3-cev! e z)                ; rewrite (e z) in the goal by its value
  (cond ((equal? e '(CCONT-VONE t)) (subst (dk-cite! 'ccont-vone-val 't z)))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL CCONT-ACT)))
         (bu3-cty! e)
         (subst (dk-cite! (cdr (assq (caar e) '((CCONT-VADD . ccont-vadd-val) (CCONT-VMUL . ccont-vmul-val) (CCONT-ACT . ccont-act-val))))
                          't (cadr e) (caddr e) z))
         (if (not (eq? (caar e) 'CCONT-ACT)) (bu3-cev! (cadr e) z))
         (bu3-cev! (caddr e) z))
        (#t (bu3-cval! e z))))

(define bu3-ev '(POINT-EVAL t x))
(define (bu3-ev-terms g)              ; the arguments T of (ev T) in G
  (cond ((not (pair? g)) '())
        ((and (equal? (car g) bu3-ev) (= (length g) 2)) (list (cadr g)))
        (#t (apply append (map bu3-ev-terms g)))))
(define (bu3-ev-law!)                 ; a law of ev: peel, rewrite every ev(T) to T(x), evaluate, close
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (let ((ts (bu3-ev-terms (dk-goal))))
    (for-each (lambda (e) (bu3-cty! e) (subst (dk-cite! 'point-eval-val 't 'x e))) ts)
    (for-each (lambda (e) (bu3-cev! e 'x)) ts)
    (if (bu3-open?) (crs))))

(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t))
  (list 'IN bu3-ev (list 'CHARACTERS bu3-A))))))))
(dk-peel!)
(bu3-top!)
(bu3-alg-typings!)
(bu3-readoffs!)
(dk-have! (list 'IN bu3-ev '(FUN (CCONT t) CC))
  (lambda ()
    (mac 'POINT-EVAL)
    (dk-lam-type! (lambda () (let ((f (dk-di-var!))) (bu3-cval! f 'x) (bu3-ass!))) (lambda () (bu3-ass!)))))
(let ((sepA (caddr (dk-cite! 'ccx-characters-unfold 't))))
  (subst (list '= (list 'CHARACTERS bu3-A) sepA))
  (bu3-acc-subst! 'down)
  (in-sep! (lambda () (bu3-ass!))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (bu3-ass!))
                  ((dk-head-is? g 'IS-CC-LINEAR-ON)
                   (mac 'is-cc-linear-on)
                   (bu3-acc-subst! 'down)
                   (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-ev-law!)))))
                  (#t (bu3-ev-law!)))))))))
(bu3-qed! 'point-eval-character)

;;; a character that kills only functions vanishing at x is the evaluation at x
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'uch_ (list 'IMPLIES (list 'IN 'uch_ (list 'CHARACTERS bu3-A))
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t))
    (list 'IMPLIES '(FORALL ukg_ (IMPLIES (IN ukg_ (CCONT t)) (IMPLIES (= (uch_ ukg_) 0) (= (ukg_ x) 0))))
      '(FORALL f (IMPLIES (IN f (CCONT t)) (= (uch_ f) (f x)))))))))))))
(dk-peel!)
(bu3-top!)
(define bu3-kh (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ukg_))) "the kernel hypothesis"))
(bu3-split-cite! 'ccont-character-laws 't 'uch_)
(define bu3-chi-add (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CCONT-VADD))) "additivity"))
(define bu3-chi-act (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CCONT-ACT))) "homogeneity"))
(let ((f (cadr (cadr (dk-goal)))))
  (let* ((c (list 'uch_ f)) (nc (list '- c)) (one '(CCONT-VONE t))
         (a (list '(CCONT-ACT t) nc one)) (g (list '(CCONT-VADD t) f a)))
    (dk-cite! 'fun-apply-type-c 'uch_ '(CCONT t) 'CC f)
    (dk-type! nc 'CC)
    (bu3-cty! g)
    (let* ((e1 (dk-apply! bu3-chi-add f a))
           (e2 (dk-apply! bu3-chi-act nc one)))
      (dk-cite! 'fun-apply-type-c 'uch_ '(CCONT t) 'CC a)
      (dk-cite! 'fun-apply-type-c 'uch_ '(CCONT t) 'CC one)
      (dk-have! (list '= (list 'uch_ g) 0)
        (lambda () (subst e1) (subst e2) (subst (list '= (list 'uch_ one) 1)) (crs)))
      (let* ((z0 (dk-apply! bu3-kh g))
             (_1 (bu3-cval! f 'x))
             (v1 (dk-cite! 'ccont-vadd-val 't f a 'x))
             (v2 (dk-cite! 'ccont-act-val 't nc one 'x))
             (v3 (dk-cite! 'ccont-vone-val 't 'x))
             (z1 (dk-rewrite-h! z0 (list g 'x) (caddr v1)))
             (z2 (dk-rewrite-h! z1 (list a 'x) (caddr v2)))
             (z3 (dk-rewrite-h! z2 (list one 'x) 1))
             (s (cadr z3))
             (k (list '= c (list '- (list f 'x) s))))
        (dk-have! k (lambda () (crs)))
        (let ((k2 (dk-rewrite-h! k s 0)))
          (subst k2)
          (crs))))))
(bu3-qed! 'ccont-character-eval-of-kernel)

;;; ---- Remark 1.27, surjectivity: every character of C(t) is an evaluation (t compact) -------------
;;; If no point x had ker(chi) inside {g : g(x) = 0}, each x would have g with chi(g) = 0, g(x) /= 0;
;;; c |g|^2 is then >= 1 near x, still in ker(chi); compactness sums finitely many into an h >= 1
;;; with chi(h) = 0, and h * (1/h) = 1 gives chi(1) = 0.

;;; |1/a - 1/b| <= |a - b| for a, b >= 1
(sp (make-wff '(FORALL a (IMPLIES (IN a RR) (FORALL b (IMPLIES (IN b RR) (IMPLIES (<= 1 a) (IMPLIES (<= 1 b)
   (<= (abs (- (recip a) (recip b))) (abs (- a b)))))))))))
(dk-peel!)
(define (bu3-rcp! x)                  ; 1 <= x in context: recip x typed, x recip x = 1, 0 < recip x <= 1
  (let ((r (list 'recip x)))
    (dk-have! (list '< 0 x) (lambda () (dk-ineq! (list '<= 1 x) (list 'IN x 'RR))))
    (dk-cite! 'rr-pos-ne-zero x)
    (dk-have! (list 'AND (list 'IN x 'RR) (list 'NOT (list '= x 0))) (lambda () (bu3-close-ctx!)))
    (dk-cite! 'rr-recip-closed x)
    (dk-cite! 'rr-recip-inverse x)
    (dk-cite! 'rr-recip-pos x)
    (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-recip-one)
    (dk-rewrite-h! (dk-cite! 'rr-recip-antitone 1 x) '(recip 1) 1)
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
    r))
(let* ((ra (bu3-rcp! 'a)) (rb (bu3-rcp! 'b))
       (s (list '* ra rb)) (d '(- b a)) (C '(abs (- a b))))
  (dk-real! s) (dk-real! d) (dk-real! '(- a b)) (dk-cite! 'rr-abs-closed '(- a b))
  (dk-have! (list 'AND (list '<= 0 ra) (list '<= 0 rb)) (lambda () (bu3-close-ctx!)))
  (bu3-fact! 'rr-leq-mul-nonneg ra rb)
  (dk-cite! 'rr-mul-le-right ra 1 rb)
  (dk-real! (list '* 1 rb))
  (dk-have! (list '<= s 1) (lambda () (dk-ineq! (list '<= s (list '* 1 rb)) (list '<= rb 1) (list 'IN s 'RR) (list 'IN rb 'RR) (list 'IN (list '* 1 rb) 'RR))))
  ;; ra - rb = s (b - a)
  (let* ((i1 (list '= (list '* s d) (list '- (list '* ra (list '* 'b rb)) (list '* rb (list '* 'a ra))))))
    (dk-have! i1 (lambda () (dk-crs-opaque!)))
    (let* ((i2 (dk-rewrite-h! i1 (list '* 'b rb) 1))
           (i3 (dk-rewrite-h! i2 (list '* 'a ra) 1))
           (j (list '= (list '- ra rb) (list '* s d))))
      (dk-have! j (lambda () (subst i3) (dk-crs-opaque!)))
      (subst j)
      (dk-have! (list 'AND (list 'IN s 'RR) (list 'IN d 'RR)) (lambda () (bu3-close-ctx!)))
      (subst (dk-cite! 'rr-abs-mult s d))
      (subst (dk-cite! 'rr-abs-of-nonneg s))
      (subst (dk-cite! 'rr-abs-sub-sym 'b 'a))
      (dk-cite! 'rr-abs-nonneg '(- a b))
      (dk-cite! 'rr-mul-le-right s 1 C)
      (dk-real! (list '* s C)) (dk-real! (list '* 1 C))
      (dk-ineq! (list '<= (list '* s C) (list '* 1 C)) (list 'IN C 'RR) (list 'IN (list '* s C) 'RR) (list 'IN (list '* 1 C) 'RR)))))
(bu3-qed! 'rr-recip-lipschitz-ge-one)

;;; ---- the statements and the opener ----
(define (bu3-chst body)
  (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'uch_ (list 'IMPLIES (list 'IN 'uch_ (list 'CHARACTERS bu3-A)) body)))))
(define bu3-chi-mul #f) (define bu3-chi-add2 #f) (define bu3-chi-act2 #f)
(define (bu3-chopen!)
  (dk-peel!)
  (bu3-top!)
  (bu3-split-cite! 'ccont-character-laws 't 'uch_)
  (set! bu3-chi-add2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CCONT-VADD))) "additivity"))
  (set! bu3-chi-act2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CCONT-ACT))) "homogeneity"))
  (set! bu3-chi-mul (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CCONT-VMUL))) "multiplicativity")))
(define (bu3-chv! f) (if (not (dk-asm? (list 'IN (list 'uch_ f) 'CC))) (dk-cite! 'fun-apply-type-c 'uch_ '(CCONT t) 'CC f)))
;;; the class of the compactness argument: subsets W of PTS t on which some h in ker(chi), real and
;;; nonnegative, is >= 1
(define (bu3-Pb W)
  (list 'FORSOME 'uhh_ (list 'AND '(IN uhh_ (CCONT t)) (list 'AND '(= (uch_ uhh_) 0)
    (list 'AND '(FORALL uhz_ (IMPLIES (IN uhz_ (PTS t)) (AND (IN (uhh_ uhz_) RR) (<= 0 (uhh_ uhz_)))))
               (list 'FORALL 'uhz_ (list 'IMPLIES (list 'IN 'uhz_ W) '(<= 1 (uhh_ uhz_)))))))))
(define bu3-P (list 'SEP 'ubw_ '(POWER (PTS t)) (bu3-Pb 'ubw_)))
(define (bu3-P-in! W h val! one!)     ; goal (IN W P), h in ker(chi) in context; VAL! z / ONE! z close the two clauses
  (bu3-in-power! W)
  (in-sep! (lambda () (bu3-ass!))
    (lambda ()
      (ew h)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (bu3-ass!))
                  ((and (dk-head-is? g 'FORALL) (equal? (bu3-guard g) '(PTS t))) (let ((z (dk-di-var!))) (val! z)))
                  ((dk-head-is? g 'FORALL) (let ((z (dk-di-var!))) (one! z)))
                  (#t (error "bu3-P-in!: unexpected goal" (expression->string g))))))))))
(define (bu3-guard g) (caddr (cadr (caddr g))))

;;; the operations, with the conjugate
(define (bu3-cty2! e)
  (cond ((dk-asm? (list 'IN e '(CCONT t))) #t)
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-VSTAR))
         (bu3-cty2! (cadr e)) (dk-cite! 'ccont-vstar-in 't (cadr e)))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL)))
         (bu3-cty2! (cadr e)) (bu3-cty2! (caddr e))
         (dk-cite! (if (eq? (caar e) 'CCONT-VADD) 'ccont-vadd-in 'ccont-vmul-in) 't (cadr e) (caddr e)))
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-ACT))
         (bu3-cty2! (caddr e)) (dk-cite! 'ccont-act-in 't (cadr e) (caddr e)))
        (#t (bu3-cty! e))))
(define (bu3-cev2! e z)               ; rewrite (e z) in the goal by its value
  (cond ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-VSTAR))
         (bu3-cty2! e) (bu3-cval! (cadr e) z)
         (subst (dk-cite! 'ccont-vstar-val 't (cadr e) z)) (bu3-cev2! (cadr e) z))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL CCONT-ACT)))
         (bu3-cty2! e)
         (subst (dk-cite! (cdr (assq (caar e) '((CCONT-VADD . ccont-vadd-val) (CCONT-VMUL . ccont-vmul-val) (CCONT-ACT . ccont-act-val))))
                          't (cadr e) (caddr e) z))
         (if (not (eq? (caar e) 'CCONT-ACT)) (bu3-cev2! (cadr e) z))
         (bu3-cev2! (caddr e) z))
        (#t (bu3-cev! e z))))

;;; ---- the bump: near a point where g in ker(chi) does not vanish, c |g|^2 >= 1 ----
(sp (make-wff (bu3-chst (list 'FORALL 'g (list 'IMPLIES '(IN g (CCONT t)) (list 'IMPLIES '(= (uch_ g) 0)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'IMPLIES '(NOT (= (g p) 0))
    (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u bu3-P)))))))))))))
(bu3-chopen!)
(bu3-cval! 'g 'p)
(let* ((w '(g p)) (m (list 'magnitude w)) (e (list '* 1/2 m)))
  (dk-cite! 'cc-magnitude-closed w) (dk-cite! 'cc-magnitude-nonneg w)
  (let ((iff (dk-cite! 'cc-magnitude-zero-iff w)))
    (dk-have! (list 'NOT (list '= m 0)) (lambda () (if (dk-only! iff '(NOT (= (g p) 0))) (prop)))))
  (dk-cite! 'neq-sym m 0)
  (dk-have! (list 'AND (list '<= 0 m) (list 'NOT (list '= 0 m))) (lambda () (bu3-close-ctx!)))
  (bu3-fact! 'rr-le-ne-lt 0 m)
  (dk-real! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< 0 m) (list 'IN m 'RR))))
  (dk-cite! 'rr-pos-rr-of-lt e)
  (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'g) 'p e)))
         (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the clause near p"))
         (b (list '* e e)) (c (list 'recip b))
         (gs '((CCONT-VSTAR t) g)) (gg (list '(CCONT-VMUL t) 'g gs)) (h (list '(CCONT-ACT t) c gg)))
    (dk-cite! 'top-open-subset 't u)
    (dk-real! b)
    (dk-cite! 'rr-mul-pos e e)
    (dk-cite! 'rr-pos-ne-zero b)
    (dk-have! (list 'AND (list 'IN b 'RR) (list 'NOT (list '= b 0))) (lambda () (bu3-close-ctx!)))
    (dk-cite! 'rr-recip-closed b)
    (dk-cite! 'rr-recip-inverse b)
    (dk-cite! 'rr-recip-pos b)
    (dk-cite! 'rr-subset-cc c)
    (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c) (list 'IN c 'RR))))
    (dk-real! (list '* c b)) (dk-real! (list '* b c))
    (dk-have! (list '= (list '* c b) (list '* b c)) (lambda () (dk-crs-opaque!)))
    (bu3-cty2! h)
    (bu3-chv! 'g) (bu3-chv! gs) (bu3-chv! gg)
    (let ((e1 (dk-apply! bu3-chi-act2 c gg)) (e2 (dk-apply! bu3-chi-mul 'g gs)))
      (dk-have! (list '= (list 'uch_ h) 0)
        (lambda () (subst e1) (subst e2) (subst '(= (uch_ g) 0)) (dk-crs-opaque!))))
    (let* ((M! (lambda (z)            ; z in PTS t: h z = c (|g z| |g z|), real, >= 0; returns (|g z|, the product)
                 (bu3-cval! 'g z)
                 (let* ((gz (list 'g z)) (mgz (list 'magnitude gz)) (Q (list '* mgz mgz)) (hval (list '* c Q)))
                   (dk-cite! 'cc-magnitude-closed gz) (dk-cite! 'cc-magnitude-nonneg gz)
                   (dk-real! Q) (dk-real! hval)
                   (dk-have! (list 'AND (list '<= 0 mgz) (list '<= 0 mgz)) (lambda () (bu3-close-ctx!)))
                   (bu3-fact! 'rr-leq-mul-nonneg mgz mgz)
                   (dk-have! (list 'AND (list '<= 0 c) (list '<= 0 Q)) (lambda () (bu3-close-ctx!)))
                   (bu3-fact! 'rr-leq-mul-nonneg c Q)
                   (dk-have! (list '= (list h z) hval)
                     (lambda () (bu3-cev2! h z) (subst (dk-cite! 'cc-magnitude-sq-conjugate gz))
                             (dk-type! (list '* c (list '* gz (list 'conjugate gz))) 'CC) (bu3-rfl!)))
                   (list mgz Q hval)))))
      (bu3-in-power! u)
      (ew u)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (bu3-ass!)
            (bu3-P-in! u h
              (lambda (z) (let ((r (M! z))) (subst (list '= (list h z) (caddr r))) (bu3-close-ctx!)))
              (lambda (z)
                (dk-cite! 'subset-mem-fwd u '(PTS t) z)
                (let* ((r (M! z)) (mgz (car r)) (Q (cadr r)) (hval (caddr r))
                       (gz (list 'g z)) (dd (list '- '(g p) gz)) (D (list 'magnitude dd))
                       (bz (dk-apply! cl z)))
                  (dk-type! dd 'CC)
                  (dk-cite! 'cc-magnitude-closed dd)
                  (dk-have! (list 'AND (list 'IN dd 'CC) (list 'IN gz 'CC)) (lambda () (bu3-close-ctx!)))
                  (let* ((tr (bu3-fact! 'cc-magnitude-triangle dd gz))
                         (eqn (list '= (list '+ dd gz) '(g p))))
                    (dk-have! eqn (lambda () (crs)))
                    (let ((tr2 (dk-rewrite-h! tr (list '+ dd gz) '(g p))))
                      (dk-have! (list '<= e mgz) (lambda () (dk-ineq! tr2 bz (list 'IN m 'RR) (list 'IN D 'RR) (list 'IN mgz 'RR))))
                      (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
                      (dk-have! (list 'AND (list '<= 0 e) (list '<= e mgz)) (lambda () (bu3-close-ctx!)))
                      (bu3-fact! 'rr-le-scale-nonneg e e mgz)
                      (dk-cite! 'rr-mul-le-right e mgz mgz)
                      (dk-real! (list '* e mgz))
                      (dk-have! (list '<= b Q) (lambda () (dk-ineq! (list '<= b (list '* e mgz)) (list '<= (list '* e mgz) Q)
                                                                    (list 'IN b 'RR) (list 'IN (list '* e mgz) 'RR) (list 'IN Q 'RR))))
                      (dk-have! (list 'AND (list '<= 0 c) (list '<= b Q)) (lambda () (bu3-close-ctx!)))
                      (bu3-fact! 'rr-le-scale-nonneg c b Q)
                      (subst (list '= (list h z) hval))
                      (dk-ineq! (list '<= (list '* c b) hval) (list '= (list '* c b) (list '* b c)) (list '= (list '* b c) 1)
                                (list 'IN (list '* c b) 'RR) (list 'IN (list '* b c) 'RR) (list 'IN hval 'RR)))))))))))))
(bu3-qed! 'ccont-character-bump)

;;; ---- a function >= 1 is not in the kernel of a character: it is invertible -------------------------
(sp (make-wff (bu3-chst (list 'FORALL 'h (list 'IMPLIES '(IN h (CCONT t))
  (list 'IMPLIES '(FORALL ulz_ (IMPLIES (IN ulz_ (PTS t)) (AND (IN (h ulz_) RR) (<= 1 (h ulz_)))))
    '(NOT (= (uch_ h) 0))))))))
(bu3-chopen!)
(define bu3-hv (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'ulz_))) "the values of h"))
(define (bu3-hv! z)                   ; z in PTS t: h z real, >= 1, its reciprocal typed, h z recip(h z) = 1
  (if (not (dk-asm? (list '<= 1 (list 'h z))))
      (begin (dk-split-all! (list (dk-apply! bu3-hv z)))
             (bu3-rcp! (list 'h z)))))
(define bu3-k '(VNB-LAMBDA ukz_ (PTS t) (recip (h ukz_))))
(dk-have! (list 'IN bu3-k '(FUN (PTS t) CC))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (bu3-hv! z) (dk-cite! 'rr-subset-cc (list 'recip (list 'h z))) (bu3-ass!)))
                  (lambda () (bu3-ass!)))))
(bu3-split-cite! 'ccont-parts 't 'h)
(let ((imp (dk-cite! 'ccont-intro 't bu3-k)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (dk-peel!))
             (p (cadr (car (filter (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) '(PTS t)))) pe))))
             (e (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pe))))
             (u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'h) p e)))
             (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the clause near p")))
        (dk-cite! 'rr-pos-rr-in-rr e)
        (dk-cite! 'top-open-subset 't u)
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (bu3-hv! p) (bu3-hv! q)
                  (let* ((bd (dk-apply! cl q))
                         (hp (list 'h p)) (hq (list 'h q))
                         (d1 (list '- hp hq)) (d2 (list '- (list 'recip hp) (list 'recip hq))))
                    (dk-lam-b!)
                    (dk-real! d1) (dk-real! d2)
                    (subst (dk-cite! 'rr-magnitude-is-abs d2))
                    (dk-cite! 'rr-magnitude-is-abs d1)
                    (let* ((bd2 (dk-rewrite-h! bd (list 'magnitude d1) (list 'abs d1)))
                           (lip (dk-cite! 'rr-recip-lipschitz-ge-one hp hq)))
                      (dk-cite! 'rr-abs-closed d1) (dk-cite! 'rr-abs-closed d2)
                      (dk-ineq! lip bd2 (list 'IN (list 'abs d1) 'RR) (list 'IN (list 'abs d2) 'RR) (list 'IN e 'RR)))))
                (bu3-ass!)))))))
  (dk-landed-1 (lambda () (detach! imp))))
;; h k = 1
(define bu3-hk (list '(CCONT-VMUL t) 'h bu3-k))
(bu3-cty2! bu3-hk)
(dk-cite! 'ccont-vone-type 't)
(dk-fun-ext! bu3-hk '(CCONT-VONE t) '(PTS t) 'CC
  (lambda () (bu3-split-cite! 'ccont-parts 't bu3-hk) (bu3-ass!))
  (lambda () (bu3-split-cite! 'ccont-parts 't '(CCONT-VONE t)) (bu3-ass!))
  (lambda (z)
    (bu3-hv! z)
    (bu3-cev2! bu3-hk z)
    (bu3-cev2! '(CCONT-VONE t) z)
    (dk-lam-b!)
    (bu3-ass!)))
(if (dk-head-is? (dk-goal) 'NOT) (di))
(bu3-chv! 'h) (bu3-chv! bu3-k)
(let* ((m1 (dk-apply! bu3-chi-mul 'h bu3-k))
       (r1 (dk-rewrite-h! m1 bu3-hk '(CCONT-VONE t)))
       (r2 (dk-rewrite-h! r1 '(uch_ (CCONT-VONE t)) 1))
       (r3 (dk-rewrite-h! r2 '(uch_ h) 0))
       (z0 (list '* 0 (list 'uch_ bu3-k))))
  (dk-have! (list '= z0 0) (lambda () (crs)))
  (let ((r4 (dk-rewrite-h! r3 z0 0)))
    (dk-absurd! r4)))
(bu3-qed! 'ccont-character-no-unit)

;;; ---- compactness: if every point has a g in ker(chi) not vanishing there, PTS t is in the class ----
(define bu3-H '(FORALL ucx_ (IMPLIES (IN ucx_ (PTS t)) (FORSOME ucg_ (AND (IN ucg_ (CCONT t)) (AND (= (uch_ ucg_) 0) (NOT (= (ucg_ ucx_) 0))))))))
(define (bu3-other-case! z a b)
  (if (not (dk-asm? (list 'IN z b))) (dk-have! (list 'IN z b) (lambda () (if (dk-only! (list 'OR (list 'IN z a) (list 'IN z b)) (list 'NOT (list 'IN z a))) (prop))))))
(define (bu3-empty-absurd! z)
  (let ((n (dk-cite! 'empty-set-has-no-members z)))
    (if (dk-only! n (list 'IN z 'EMPTY-SET)) (prop))))
(define (bu3-open-P! a)               ; (IN a P) in context: land a in POWER, the witness h, its two clauses; return (h vals ones)
  (dk-project! (list 'IN a '(POWER (PTS t))) (lambda () (sep-me (list 'IN a bu3-P))))
  (sep-me (list 'IN a bu3-P)) (dk-split-all!)
  (let* ((h (dk-skolem! (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (eq? (cadr x) 'uhh_) (dk-contains? x a))) "the witness")))
         (_ (dk-split-all!))
         (vals (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x h) (equal? (bu3-guard x) '(PTS t))
                                         (dk-head-is? (caddr (caddr x)) 'AND))) "values"))
         (ones (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x h) (equal? (bu3-guard x) a)
                                         (dk-head-is? (caddr (caddr x)) '<=))) "ones")))
    (list h vals ones)))

(sp (make-wff (bu3-chst (list 'IMPLIES bu3-H (list 'IN '(PTS t) bu3-P)))))
(bu3-chopen!)
(define bu3-Hh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'ucx_))) "the hypothesis"))
(dk-cite! 'power-set '(PTS t))
(let ((imp (dk-cite! 'bsw-compact-induction 't bu3-P)))
  ;; the empty set
  (dk-have! (list 'IN 'EMPTY-SET bu3-P)
    (lambda ()
      (let ((h0 '((CCONT-ACT t) 0 (CCONT-VONE t))))
        (dk-type! 0 'CC)
        (bu3-cty2! h0)
        (bu3-chv! '(CCONT-VONE t))
        (let ((e (dk-apply! bu3-chi-act2 0 '(CCONT-VONE t))))
          (dk-have! (list '= (list 'uch_ h0) 0) (lambda () (subst e) (subst '(= (uch_ (CCONT-VONE t)) 1)) (crs))))
        (dk-cite! 'empty-set-is-set)
        (dk-have! '(SUBSET EMPTY-SET (PTS t)) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bu3-empty-absurd! z))))
        (bu3-P-in! 'EMPTY-SET h0
          (lambda (z) (bu3-cev2! h0 z) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (dk-type! '(* 0 1) 'RR) (dk-ineq!)))))
          (lambda (z) (bu3-empty-absurd! z))))))
  ;; binary unions
  (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka bu3-P) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb bu3-P) (list 'IN '(UNION ka kb) bu3-P)))))
    (lambda ()
      (let* ((pe (dk-peel!)) (g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g))) (un (list 'UNION a b))
             (A1 (bu3-open-P! a)) (B1 (bu3-open-P! b))
             (h1 (car A1)) (h2 (car B1)) (h (list '(CCONT-VADD t) h1 h2))
             (mem! (lambda (z)          ; z in UNION a b: land z in PTS t
                     (bu3-rhs! (dk-cite! 'union-membership a b z))
                     (if (not (dk-asm? (list 'IN z '(PTS t))))
                         (dk-have! (list 'IN z '(PTS t))
                           (lambda () (use-em (list 'IN z a) (lambda () (dk-cite! 'power-mem-in '(PTS t) a z) (bu3-ass!))
                                                             (lambda () (bu3-other-case! z a b) (dk-cite! 'power-mem-in '(PTS t) b z) (bu3-ass!))))))))
             (vals! (lambda (z)         ; z in PTS t: the values of h1, h2 real, nonneg
                      (dk-split-all! (list (dk-apply! (cadr A1) z)))
                      (dk-split-all! (list (dk-apply! (cadr B1) z))))))
        (dk-have! (list 'SUBSET un '(PTS t)) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (mem! z) (bu3-ass!))))
        (bu3-cty2! h)
        (let ((e (dk-apply! bu3-chi-add2 h1 h2)))
          (dk-have! (list '= (list 'uch_ h) 0) (lambda () (subst e) (subst (list '= (list 'uch_ h1) 0)) (subst (list '= (list 'uch_ h2) 0)) (crs))))
        (bu3-P-in! un h
          (lambda (z)
            (vals! z)
            (bu3-cev2! h z)
            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!)
                                           (if (dk-head-is? (dk-goal) 'IN) (dk-real! (cadr (dk-goal)))
                                               (dk-ineq! (list '<= 0 (list h1 z)) (list '<= 0 (list h2 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR)))))))
          (lambda (z)
            (mem! z) (vals! z)
            (bu3-cev2! h z)
            (use-em (list 'IN z a)
              (lambda () (let ((l (dk-apply! (caddr A1) z)))
                           (dk-ineq! l (list '<= 0 (list h2 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR))))
              (lambda () (bu3-other-case! z a b)
                         (let ((l (dk-apply! (caddr B1) z)))
                           (dk-ineq! l (list '<= 0 (list h1 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR))))))))))
  ;; the local step: the bump
  (dk-have! (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u bu3-P))))))
    (lambda ()
      (let* ((p (dk-di-var!))
             (g (dk-skolem! (dk-apply! bu3-Hh p))))
        (dk-split-all!)
        (dk-cite! 'ccont-character-bump 't 'uch_ g p)
        (bu3-ass!))))
  (dk-apply! imp)
  (bu3-ass!))
(bu3-qed! 'ccont-character-cover)

;;; ---- the point: some x has ker(chi) inside {g : g(x) = 0} ----
(define bu3-G '(FORSOME x (AND (IN x (PTS t)) (FORALL ukg_ (IMPLIES (IN ukg_ (CCONT t)) (IMPLIES (= (uch_ ukg_) 0) (= (ukg_ x) 0)))))))
(sp (make-wff (bu3-chst bu3-G)))
(dk-peel!)
(bu3-top!)
(use-em bu3-G
  (lambda () (bu3-ass!))
  (lambda ()
    (dk-have! bu3-H
      (lambda ()
        (let* ((x (dk-di-var!))
               (F (list 'FORSOME 'ucg_ (list 'AND '(IN ucg_ (CCONT t)) (list 'AND '(= (uch_ ucg_) 0) (list 'NOT (list '= (list 'ucg_ x) 0))))))
               (Kx (list 'FORALL 'ukg_ (list 'IMPLIES '(IN ukg_ (CCONT t)) (list 'IMPLIES '(= (uch_ ukg_) 0) (list '= (list 'ukg_ x) 0))))))
          (use-em F
            (lambda () (bu3-ass!))
            (lambda ()
              (dk-have! Kx
                (lambda ()
                  (let ((g (dk-di-var!)))
                    (di)
                    (use-em (list '= (list g x) 0)
                      (lambda () (bu3-ass!))
                      (lambda ()
                        (dk-have! F (lambda () (ew g) (bu3-close-ctx!)))
                        (if (dk-only! F (list 'NOT F)) (prop)))))))
              (dk-have! bu3-G (lambda () (ew x) (bu3-close-ctx!)))
              (if (dk-only! bu3-G (list 'NOT bu3-G)) (prop)))))))
    (dk-cite! 'ccont-character-cover 't 'uch_)
    (let* ((W (bu3-open-P! '(PTS t))) (h (car W)) (vals (cadr W)) (ones (caddr W))
           (ge1 (list 'FORALL 'ulz_ (list 'IMPLIES '(IN ulz_ (PTS t)) (list 'AND (list 'IN (list h 'ulz_) 'RR) (list '<= 1 (list h 'ulz_)))))))
      (dk-have! ge1 (lambda () (let ((z (dk-di-var!))) (dk-split-all! (list (dk-apply! vals z))) (dk-apply! ones z) (bu3-close-ctx!))))
      (let ((nz (dk-cite! 'ccont-character-no-unit 't 'uch_ h)))
        (if (dk-only! nz (list '= (list 'uch_ h) 0)) (prop))))))
(bu3-qed! 'ccont-character-kernel-point)

;;; ---- REMARK 1.27 (surjectivity of h): every character of C(t) is the evaluation at a point ----
(sp (make-wff (bu3-chst '(FORSOME x (AND (IN x (PTS t)) (= uch_ (POINT-EVAL t x)))))))
(dk-peel!)
(bu3-top!)
(bu3-split-cite! 'ccont-character-laws 't 'uch_)
(let* ((x (dk-skolem! (dk-cite! 'ccont-character-kernel-point 't 'uch_)))
       (_ (dk-split-all!))
       (kf (dk-cite! 'ccont-character-eval-of-kernel 't 'uch_ x))
       (ev (list 'POINT-EVAL 't x)))
  (dk-have! (list 'IN ev '(FUN (CCONT t) CC))
    (lambda ()
      (mac 'POINT-EVAL)
      (dk-cite! 'ccont-is-set 't)
      (dk-lam-type! (lambda () (let ((f (dk-di-var!))) (bu3-cval! f x) (bu3-ass!))) (lambda () (bu3-ass!)))))
  (ew x)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (bu3-ass!)
          (dk-fun-ext! 'uch_ ev '(CCONT t) 'CC #f #f
            (lambda (f)
              (subst (dk-cite! 'point-eval-val 't x f))
              (dk-apply! kf f)
              (bu3-ass!)))))))
(bu3-qed! 'ccont-character-is-point-eval)

;;; ---- Remark 1.27 (injectivity of h): distinct points have distinct evaluations, by Urysohn -------
;;; a point is closed in a Hausdorff space
(sp (make-wff '(FORALL t (IMPLIES (IS-HAUSDORFF t) (FORALL x (IMPLIES (IN x (PTS t)) (IS-TOP-CLOSED t (SINGLETON x))))))))
(dk-peel!)
(bu3-rhs! (dk-cite! 'is-hausdorff 't))
(bu3-rhs! (dk-cite! 'is-top-space 't))
(define bu3-hs (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'a) (dk-contains? h '(OPENS t)) (dk-contains? h 'EMPTY-SET))) "the separation clause"))
(bu3-set! 'x '(PTS t))
(define bu3-Sx '(SINGLETON x))
(define bu3-Cx (list 'COMPLEMENT-IN '(PTS t) bu3-Sx))
(define (bu3-in-sx! z)                ; z in {x} in context: land z = x
  (bu3-rhs! (dk-cite! 'singleton-membership 'x z)))
(dk-have! (list 'SUBSET bu3-Sx '(PTS t))
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bu3-in-sx! z) (subst (list '= z 'x)) (bu3-ass!))))
(dk-have! (list 'SUBSET bu3-Cx '(PTS t))
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bu3-rhs! (dk-cite! 'complement-in-membership '(PTS t) bu3-Sx z)) (bu3-ass!))))
(let ((imp (dk-cite! 'top-open-of-local 't bu3-Cx)))
  (dk-have! (cadr imp)
    (lambda ()
      (let ((a (dk-di-var!)))
        (bu3-rhs! (dk-cite! 'complement-in-membership '(PTS t) bu3-Sx a))
        (dk-have! (list 'NOT (list '== a 'x))
          (lambda ()
            (di)
            (dk-have! (list 'IN a bu3-Sx)
              (lambda () (subst (list '= a 'x))
                         (bu3-lhs! (dk-cite! 'singleton-membership 'x 'x) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-rfl!)))))) (bu3-ass!)))
            (if (dk-only! (list 'IN a bu3-Sx) (list 'NOT (list 'IN a bu3-Sx))) (prop))))
        (let* ((ex (dk-apply! bu3-hs a 'x))
               (u (dk-skolem! ex))
               (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u))) "the second open"))
               (v (dk-skolem! ex2)))
          (dk-split-all!)
          (ew u)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-asm? g) (bu3-ass!))
                      ((dk-head-is? g 'SUBSET)
                       (mac 'subset-def)
                       (let ((z (dk-di-var!)))
                         (dk-cite! 'top-open-subset 't u)
                         (dk-cite! 'subset-mem-fwd u '(PTS t) z)
                         (bu3-lhs! (dk-cite! 'complement-in-membership '(PTS t) bu3-Sx z)
                           (lambda ()
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal)) (bu3-ass!)
                                   (begin
                                     (di)
                                     (bu3-in-sx! z)
                                     (dk-rewrite-h! (list 'IN z u) z 'x)
                                     (bu3-inter-in! 'x u v)
                                     (let ((m (dk-rewrite-h! (list 'IN 'x (list 'INTERSECTION u v)) (list 'INTERSECTION u v) 'EMPTY-SET)))
                                       (bu3-empty-absurd! 'x))))))))
                         (bu3-ass!)))
                      (#t (error "singleton-closed: unexpected" (expression->string g)))))))))))
  (dk-landed-1 (lambda () (detach! imp))))
(bu3-lhs! (dk-cite! 'is-top-closed 't bu3-Sx) (lambda () (bu3-close-ctx!)))
(bu3-ass!)
(bu3-qed! 'top-hausdorff-singleton-closed)

(sp (make-wff '(FORALL t (IMPLIES (IS-COMPACT-T t) (IMPLIES (IS-HAUSDORFF t) (FORALL x (IMPLIES (IN x (PTS t)) (FORALL y (IMPLIES (IN y (PTS t))
   (IMPLIES (NOT (= x y)) (NOT (= (POINT-EVAL t x) (POINT-EVAL t y)))))))))))))
(dk-peel!)
(bu3-top!)
(if (dk-head-is? (dk-goal) 'NOT) (di))
(bu3-set! 'x '(PTS t)) (bu3-set! 'y '(PTS t))
(dk-cite! 'top-hausdorff-singleton-closed 't 'x)
(dk-cite! 'top-hausdorff-singleton-closed 't 'y)
(dk-have! '(FORALL unx_ (IMPLIES (IN unx_ (SINGLETON x)) (NOT (IN unx_ (SINGLETON y)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (di)
      (bu3-rhs! (dk-cite! 'singleton-membership 'x z))
      (bu3-rhs! (dk-cite! 'singleton-membership 'y z))
      (dk-rewrite-h! (list '= z 'y) z 'x)
      (if (dk-only! '(= x y) '(NOT (= x y))) (prop)))))
(let* ((f (dk-skolem! (dk-cite! 'urysohn-compact-hausdorff 't '(SINGLETON x) '(SINGLETON y))))
       (_ (dk-split-all!))
       (z0 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h f) (dk-contains? h '(SINGLETON x)))) "zero on x"))
       (z1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h f) (dk-contains? h '(SINGLETON y)))) "one on y"))
       (k (list 'VNB-LAMBDA 'ukk_ '(PTS t) (list f 'ukk_))))
  (bu3-split-cite! 'bsw-rcont-parts 't f)
  (dk-have! (list 'IN k '(FUN (PTS t) CC))
    (lambda ()
      (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR z) (dk-cite! 'rr-subset-cc (list f z)) (bu3-ass!)))
                    (lambda () (bu3-ass!)))))
  (let ((imp (dk-cite! 'ccont-intro 't k)))
    (dk-have! (cadr imp)
      (lambda ()
        (let* ((pe (dk-peel!))
               (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
               (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe))))
               (u (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't f) p e)))
               (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the clause near p")))
          (dk-cite! 'top-open-subset 't u)
          (ew u)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let ((q (dk-di-var!)))
                    (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                    (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR p)
                    (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR q)
                    (dk-apply! cl q)
                    (dk-lam-b!)
                    (let ((d (list '- (list f p) (list f q))))
                      (dk-real! d)
                      (subst (dk-cite! 'rr-magnitude-is-abs d))
                      (bu3-ass!)))
                  (bu3-ass!)))))))
    (dk-landed-1 (lambda () (detach! imp))))
  ;; the two values
  (let* ((kx (list k 'x)) (ky (list k 'y)) (fx (list f 'x)) (fy (list f 'y)))
    (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR 'x)
    (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR 'y)
    (dk-have! (list '= kx fx) (lambda () (dk-lam-b!) (bu3-rfl!)))
    (dk-have! (list '= ky fy) (lambda () (dk-lam-b!) (bu3-rfl!)))
    (dk-have! '(IN x (SINGLETON x)) (lambda () (bu3-lhs! (dk-cite! 'singleton-membership 'x 'x) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-rfl!)))))) (bu3-ass!)))
    (dk-have! '(IN y (SINGLETON y)) (lambda () (bu3-lhs! (dk-cite! 'singleton-membership 'y 'y) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bu3-ass!) (bu3-rfl!)))))) (bu3-ass!)))
    (let* ((v0 (dk-apply! z0 'x)) (v1 (dk-apply! z1 'y))
           (e1 (dk-cite! 'point-eval-val 't 'x k))
           (e1b (dk-rewrite-h! e1 '(POINT-EVAL t x) '(POINT-EVAL t y)))
           (e2 (dk-cite! 'point-eval-val 't 'y k))
           (e3 (dk-rewrite-h! e2 (list '(POINT-EVAL t y) k) kx))
           (e4 (dk-rewrite-h! e3 kx fx))
           (e5 (dk-rewrite-h! e4 ky fy))
           (e6 (dk-rewrite-h! e5 fx 0))
           (e7 (dk-rewrite-h! e6 fy 1)))
      (dk-absurd! e7))))
(bu3-qed! 'point-eval-injective)

