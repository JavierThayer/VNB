;;; ch3e-wext.scm -- CH3-E: Proposition 3.32, the other half: the winding number of a positively
;;; oriented triangle about a point outside its hull is 0.  Loaded after ch3e-wind.scm (same
;;; environment).  Helper prefix ax-.
;;;   phi(w) = Im((q - w) conj(p - w)) is affine; on the half-plane
;;;   H = {w : 0 < Re(conj(i (q - p)) (w - (p + u)/2))} = {w : phi(w) > phi(u)/2}       (cross-half-plane)
;;;   a hull on which phi >= 0, with phi(u) < 0, lies in H and u does not: Goursat on H.  (triangle-outside-side)
;;;   if all three phi are >= 0 at u, u is in the hull (barycentric weights phi/K).     (cross-barycentric)

;;; ---------------------------------------------------------------------------
(sp (make-wff (forall-guarded '(aop_ aoq_ aou_ aow_) '((IN aop_ CC) (IN aoq_ CC) (IN aou_ CC) (IN aow_ CC))
  (list '= (list 'real-part (list '* (aw-mu 'aoq_ 'aop_) '(- aow_ (* 1/2 (+ aop_ aou_)))))
           (list '- (ao-cr '(- aoq_ aow_) '(- aop_ aow_)) (list '* 1/2 (ao-cr '(- aoq_ aou_) '(- aop_ aou_))))))))
(dk-peel!)
(let* ((p 'aop_) (q 'aoq_) (u 'aou_) (w 'aow_)
       (D (list '- q p)) (Vv (list '* '+i D))
       (Z (list '- w (list '* 1/2 (list '+ p u))))
       (env (map ao-base! (list p q u w)))
       (DXY (ao-coords! D env))
       (ZXY (ao-coords! Z env))
       (R1 (ao-cross! (list '- q w) (list '- p w) env))
       (R2 (ao-cross! (list '- q u) (list '- p u) env)))
  (fact 'cc-i-in) (an-cc! Vv) (fact 'real-part-in-rr Vv) (fact 'imag-part-in-rr Vv)
  (dk-cite! 'cc-re-i-mul D) (dk-cite! 'cc-im-i-mul D)
  (let ((dot (dk-cite! 'cc-dot-coords Vv Z)))
    (subst dot)
    (subst (list '= (list 'real-part Vv) (list '- (list 'imag-part D))))
    (subst (list '= (list 'imag-part Vv) (list 'real-part D)))
    (subst (list '= (list 'imag-part D) (cdr DXY))) (subst (list '= (list 'real-part D) (car DXY)))
    (subst (list '= (list 'real-part Z) (car ZXY))) (subst (list '= (list 'imag-part Z) (cdr ZXY)))
    (subst (list '= (ao-cr (list '- q w) (list '- p w)) R1))
    (subst (list '= (ao-cr (list '- q u) (list '- p u)) R2))
    (crs)))
(qed 'cross-half-plane)

;;; ---------------------------------------------------------------------------
;;; the three cross products at z add to K, and K z = g2 a + g3 b + g1 c
(define (ax-g q p z) (ao-cr (list '- q z) (list '- p z)))
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_ aoz_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC) (IN aoz_ CC))
  (list 'AND (list '= (list '+ (list '+ (ax-g 'aob_ 'aoa_ 'aoz_) (ax-g 'aoc_ 'aob_ 'aoz_)) (ax-g 'aoa_ 'aoc_ 'aoz_)) (ax-g 'aob_ 'aoa_ 'aoc_))
        (list '= (list '* (ax-g 'aob_ 'aoa_ 'aoc_) 'aoz_)
                 (list '+ (list '+ (list '* (ax-g 'aoc_ 'aob_ 'aoz_) 'aoa_) (list '* (ax-g 'aoa_ 'aoc_ 'aoz_) 'aob_)) (list '* (ax-g 'aob_ 'aoa_ 'aoz_) 'aoc_)))))))
(dk-peel!)
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (z 'aoz_)
       (env (map ao-base! (list a b c z)))
       (pairs (list (list b a z) (list c b z) (list a c z) (list b a c)))
       (Rs (map (lambda (t) (ao-cross! (list '- (car t) (caddr t)) (list '- (cadr t) (caddr t)) env)) pairs)))
  (define (subst-all!)
    (for-each (lambda (t R) (let ((g (ax-g (car t) (cadr t) (caddr t)))) (if (dk-contains? (dk-goal) g) (subst (list '= g R))))) pairs Rs))
  (dk-conj-close!
    (lambda ()
      (subst-all!)
      (for-each (lambda (bse) (if (dk-contains? (dk-goal) (car bse))
                                  (subst (list '= (car bse) (list '+ (cadr bse) (list '* '+i (cddr bse)))))))
                env)
      (crs))))
(qed 'cross-barycentric)

;;; ---------------------------------------------------------------------------
;;; one side with phi >= 0 on the hull and phi(u) < 0: the triangle integral of 1/(w - u) is 0
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_ aou_ aop_ aoq_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC) (IN aou_ CC) (IN aop_ CC) (IN aoq_ CC))
  (list 'IMPLIES (list 'FORALL 'aoz_ (list 'IMPLIES '(IN aoz_ (CONV3 aoa_ aob_ aoc_)) (list '<= 0 (ax-g 'aoq_ 'aop_ 'aoz_))))
  (list 'IMPLIES (list '< (ax-g 'aoq_ 'aop_ 'aou_) 0)
    (list '= (list 'TRI-INT (aw-fu 'aou_) 'aoa_ 'aob_ 'aoc_) 0))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (u 'aou_) (p 'aop_) (q 'aoq_)
       (T3 (list 'CONV3 a b c))
       (m (aw-mu q p)) (u0 (list '* 1/2 (list '+ p u)))
       (H (aw-H m u0))
       (fu (aw-fu u)) (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u)))
       (fH (list 'VNB-LAMBDA 'aotw_ H (list 'recip (list '- 'aotw_ u))))
       (phiu (ax-g q p u))
       (hull (an-pick "the hull sign" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'CONV3))))))
  (fact 'cc-i-in) (an-cc! (list '* '+i (list '- q p))) (fact 'cc-conjugate-closed (list '* '+i (list '- q p)))
  (an-cc! u0)
  (an-cc! (list '- q u)) (an-cc! (list '- p u)) (fact 'cc-conjugate-closed (list '- p u))
  (an-cc! (list '* (list '- q u) (list 'conjugate (list '- p u)))) (fact 'imag-part-in-rr (list '* (list '- q u) (list 'conjugate (list '- p u))))
  (dk-cite! 'cc-half-plane-open m u0)
  ;; membership in H through phi
  (define (phi-of! w)                         ; w in CC: lands Re(m (w - u0)) = phi(w) - phi(u)/2, typings
    (let* ((X (list '* m (list '- w u0))) (g (ax-g q p w)))
      (an-cc! (list '- q w)) (an-cc! (list '- p w)) (fact 'cc-conjugate-closed (list '- p w))
      (an-cc! (list '* (list '- q w) (list 'conjugate (list '- p w)))) (fact 'imag-part-in-rr (list '* (list '- q w) (list 'conjugate (list '- p w))))
      (an-cc! X) (fact 'real-part-in-rr X)
      (dk-cite! 'cross-half-plane p q u w)
      X))
  (define (in-H! w)                           ; w in H in context: w in CC, 0 < phi(w) - phi(u)/2
    (let ((mm (list 'IN w H)))
      (dk-project! (list 'IN w 'CC) (lambda () (sep-me (dk-ctx-form mm))))
      (let ((X (phi-of! w)))
        (dk-project! (list '< 0 (list 'real-part X)) (lambda () (sep-me (dk-ctx-form mm))))
        X)))
  (define (not-u! w)                          ; w in H: NOT (= (- w u) 0)
    (let ((X (in-H! w)))
      (dk-have! (list 'NOT (list '= (list '- w u) 0))
        (lambda () (di)
                   (dk-fact! 'cc-sub-zero-eq w u)
                   (let* ((e (list '= (list 'real-part X) (list '- (ax-g q p w) (list '* 1/2 phiu))))
                          (e2 (dk-rewrite-h! e w u))
                          (e3 (dk-rewrite-h! (list '< 0 (list 'real-part X)) w u)))
                     (an-cc! (list '* m (list '- u u0))) (fact 'real-part-in-rr (list '* m (list '- u u0)))
                     (dk-absurd! e2 e3 (list '< phiu 0)))))))
  (dk-have! (list 'FORALL 'aoty_ (list 'IMPLIES (list 'IN 'aoty_ H) (list 'NOT (list '= (list '- 'aoty_ u) 0))))
    (lambda () (let ((w (dk-di-var!))) (not-u! w) (dk-ass!))))
  (dk-have! (list 'HOLOMORPHIC-ON H fH) (lambda () (dk-holomorphic! H fH)))
  (fact 'holomorphic-on-in-fun H fH) (fact 'holomorphic-on-continuous H fH)
  ;; the hull lies in H
  (dk-have! (list 'SUBSET T3 H)
    (lambda ()
      (let* ((z (subset-by-element!)))
        (dk-project! (list 'IN z 'CC) (lambda () (mac-h 'conv3-member-iff (dk-ctx-form (list 'IN z T3))) (dk-split-all!)))
        (dk-apply! hull z)
        (let ((X (phi-of! z)))
          (dk-have! (list '< 0 (list 'real-part X))
            (lambda () (dk-ineq! (list '= (list 'real-part X) (list '- (ax-g q p z) (list '* 1/2 phiu)))
                                 (list '<= 0 (ax-g q p z)) (list '< phiu 0))))
          (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
  (dk-split-all! (list (dk-cite! 'conv3-vertices-in a b c)))
  (for-each (lambda (v) (dk-fact! 'subset-mem-fwd T3 H v)) (list a b c))
  (let ((gt (dk-cite! 'goursat-triangle H fH a b c)))
    ;; H misses u, so H subset CC \ {u}; the sides lie in both
    (dk-cite! 'winding-integrand-holomorphic u)
    (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
    (dk-have! (list 'SUBSET Pu 'CC)
      (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                   (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
    (dk-have! (list 'SUBSET H Pu)
      (lambda () (let* ((z (subset-by-element!)))
                   (not-u! z)
                   (dk-have! (list 'NOT (list '= z u))
                     (lambda () (di) (dk-have! (list '= (list '- z u) 0) (lambda () (subst (list '= z u)) (crs)))
                                (ai (list 'NOT (list '= (list '- z u) 0)))))
                   (mac 'cc-punctured-membership) (dk-conj-close! (lambda () (dk-ass!))))))
    (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 a b c)))
    (let ((segs (list (list a b) (list b c) (list c a))))
      (for-each (lambda (pq)
                  (let ((st (list 'TRACE (list 'SEG-PATH (car pq) (cadr pq)) 0 1)))
                    (fact 'subset-trans st T3 H) (fact 'subset-trans st H Pu)))
                segs)
      (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ H) (list '== (list fH 'aotz_) (list fu 'aotz_))))
        (lambda () (let ((z (dk-di-var!))) (dk-fact! 'subset-mem-fwd H Pu z) (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
      (for-each (lambda (pq)
                  (let ((st (list 'TRACE (list 'SEG-PATH (car pq) (cadr pq)) 0 1)))
                    (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ st) (list '== (list fH 'aotz_) (list fu 'aotz_))))
                      (lambda () (let ((z (dk-di-var!))) (dk-fact! 'subset-mem-fwd st H z)
                                   (dk-apply! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ H) (list '== (list fH 'aotz_) (list fu 'aotz_)))) z)
                                   (dk-ass!))))
                    (dk-cite! 'seg-int-congruence Pu fu H fH (car pq) (cadr pq))))
                segs)
      (dk-have! (list '= (list 'TRI-INT fu a b c) (list 'TRI-INT fH a b c))
        (lambda () (mac 'TRI-INT)
                   (for-each (lambda (pq) (subst (list '= (list 'SEG-INT fu (car pq) (cadr pq)) (list 'SEG-INT fH (car pq) (cadr pq))))) segs)
                   (if (not (proof-done? *ps*)) (rfl))))
      (subst (list '= (list 'TRI-INT fu a b c) (list 'TRI-INT fH a b c)))
      (dk-ass!))))
(qed 'triangle-outside-side)
;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.32, second half: about a point outside the hull the winding number is 0
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
  (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
  (list 'IMPLIES (list 'FORSOME 'aov_ (list 'IN 'aov_ ao-int))
  (list 'FORALL 'aou_ (list 'IMPLIES '(IN aou_ CC) (list 'IMPLIES '(NOT (IN aou_ (CONV3 aoa_ aob_ aoc_)))
    (list '= aw-tri-wind 0))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (u 'aou_)
       (T3 (list 'CONV3 a b c))
       (fu (aw-fu u)) (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u)))
       (v (dk-skolem! (an-pick "an interior point" (lambda (x) (and (ao-op? x 'FORSOME 3) (eq? (cadr x) 'aov_)))) #t))
       (pairs (list (list b a) (list c b) (list a c)))
       (ks (map (lambda (qp) (let ((q (car qp)) (p (cadr qp)) (r (car (filter (lambda (x) (not (memq x qp))) (list a b c)))))
                               (ax-g q p r)))
                pairs))
       (W (dk-cite! 'conv3-cross-weights a b c)))
  ;; the angles at v
  (mac-h 'POSITIVELY-ORIENTED '(POSITIVELY-ORIENTED aoa_ aob_ aoc_))
  (dk-split-all! (list (dk-apply! (an-pick "the orientation" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'ANGLE)))) v)))
  (fact 'rr-zero-in)
  ;; each k > 0, and each phi >= 0 on the hull
  (for-each
    (lambda (qp k)
      (let* ((q (car qp)) (p (cadr qp))
             (Hi (list 'FORALL 'aoz_ (list 'IMPLIES (list 'IN 'aoz_ T3) (ao-wt-claim 'aot_ (ax-g q p 'aoz_) k)))))
        (an-cc! (cadr k)) (fact 'imag-part-in-rr (cadr k))
        (dk-have! Hi (lambda ()
                       (let* ((z (cadr (find-first (lambda (x) (and (ao-op? x 'IN 3) (equal? (caddr x) T3)))
                                                   (dk-landed (lambda () (di))))))
                              (cj (dk-apply! W z)))
                         (dk-split-all! (list cj))
                         (ass))))
        (let* ((Uf (dk-cite! 'interior-angle-sign p q k T3))
               (iff (dk-apply! Uf v)))
          (dk-have! (list '< 0 k) (lambda () (if (dk-only! iff (cadr iff)) (prop)))))
        (dk-have! (list '<= 0 k) (lambda () (dk-ineq! (list '< 0 k))))
        (dk-have! (list 'FORALL 'aoz_ (list 'IMPLIES (list 'IN 'aoz_ T3) (list '<= 0 (ax-g q p 'aoz_))))
          (lambda ()
            (let* ((z (dk-di-var!))
                   (t (dk-skolem! (dk-apply! Hi z) #t))
                   (g (ax-g q p z)))
              (dk-split-all!)
              (an-and! (list 'IN t 'RR) (list 'IN k 'RR)) (an-and! (list '<= 0 t) (list '<= 0 k))
              (fact 'rr-leq-mul-nonneg t k)
              (dk-rewrite-h! (list '<= 0 (list '* t k)) (list '* t k) g)
              (dk-ass!))))))
    pairs ks)
  ;; the barycentric identities at u
  (dk-split-all! (list (dk-cite! 'cross-barycentric a b c u)))
  (for-each (lambda (qp) (let ((q (car qp)) (p (cadr qp)))
                           (an-cc! (list '- q u)) (an-cc! (list '- p u)) (fact 'cc-conjugate-closed (list '- p u))
                           (an-cc! (list '* (list '- q u) (list 'conjugate (list '- p u))))
                           (fact 'imag-part-in-rr (list '* (list '- q u) (list 'conjugate (list '- p u))))))
            pairs)
  ;; the sides miss u: they lie in the hull
  (dk-cite! 'winding-integrand-holomorphic u)
  (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
  (dk-have! (list 'SUBSET Pu 'CC)
    (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                 (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
  (dk-have! (list 'SUBSET T3 Pu)
    (lambda () (let* ((z (subset-by-element!)))
                 (dk-project! (list 'IN z 'CC) (lambda () (mac-h 'conv3-member-iff (dk-ctx-form (list 'IN z T3))) (dk-split-all!)))
                 (dk-have! (list 'NOT (list '= z u))
                   (lambda () (di) (dk-rewrite-h! (list 'IN z T3) z u) (ai (list 'NOT (list 'IN u T3)))))
                 (mac 'cc-punctured-membership) (dk-conj-close! (lambda () (dk-ass!))))))
  (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 a b c)))
  (for-each (lambda (pq) (fact 'subset-trans (list 'TRACE (list 'SEG-PATH (car pq) (cadr pq)) 0 1) T3 Pu))
            (list (list a b) (list b c) (list c a)))
  (dk-cite! 'tri-int-is-line-int Pu fu a b c)
  (define (finish!)                           ; TRI-INT(fu) = 0 in context: close the winding goal
    (let ((Z2 '(* (* 2 PI) +i)))
      (mac 'WINDING)
      (subst (list '= (list 'LINE-INT fu '(TRI-ROAD aoa_ aob_ aoc_) '(TRI-ROAD-DERIV aoa_ aob_ aoc_) 0 3) (list 'TRI-INT fu a b c)))
      (subst (list '= (list 'TRI-INT fu a b c) 0))
      (dk-split-all! (list (dk-cite! 'pi-pos)))
      (fact 'cc-i-in) (an-rr! '(* 2 PI)) (fact 'rr-subset-cc '(* 2 PI)) (an-cc! Z2)
      (dk-have! '(NOT (= (* 2 PI) 0)) (lambda () (di) (dk-absurd! '(= (* 2 PI) 0) '(< 0 PI))))
      (dk-have! '(NOT (= +i 0)) (lambda () (arith)))
      (dk-fact! 'cc-mul-nonzero '(* 2 PI) '+i)
      (an-and! (list 'IN Z2 'CC) (list 'NOT (list '= Z2 0)))
      (fact 'cc-recip-closed Z2)
      (let ((r (dk-name! (list 'recip Z2) 'CC)))
        (subst (list '= (list 'recip Z2) r))
        (crs))))
  (define (side! qp)
    (dk-cite! 'triangle-outside-side a b c u (cadr qp) (car qp))
    (finish!))
  (let* ((g1 (ax-g b a u)) (g2 (ax-g c b u)) (g3 (ax-g a c u)) (K (car ks)))
    (define (neg! g) (dk-fact! 'rr-not-le-lt 0 g))
    (use-em (list '<= 0 g1)
      (lambda ()
        (use-em (list '<= 0 g2)
          (lambda ()
            (use-em (list '<= 0 g3)
              (lambda ()
                ;; all three >= 0: u is in the hull
                (dk-have! (list 'NOT (list '= K 0)) (lambda () (di) (dk-absurd! (list '= K 0) (list '< 0 K))))
                (an-and! (list 'IN K 'RR) (list 'NOT (list '= K 0)))
                (fact 'rr-recip-closed K) (fact 'rr-recip-inverse K) (fact 'rr-recip-pos K)
                (let* ((rho (dk-name! (list 'recip K) 'RR))
                       (inv (dk-rewrite-h! (list '= (list '* K (list 'recip K)) 1) (list 'recip K) rho)))
                  (dk-rewrite-h! (list '< 0 (list 'recip K)) (list 'recip K) rho)
                  (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list '< 0 rho))))
                  (let* ((ws (map (lambda (g)
                                    (an-rr! (list '* g rho))
                                    (an-and! (list 'IN g 'RR) (list 'IN rho 'RR)) (an-and! (list '<= 0 g) (list '<= 0 rho))
                                    (fact 'rr-leq-mul-nonneg g rho)
                                    (let ((x (dk-name! (list '* g rho) 'RR)))
                                      (dk-rewrite-h! (list '<= 0 (list '* g rho)) (list '* g rho) x)
                                      (fact 'rr-subset-cc x)
                                      x))
                                  (list g2 g3 g1)))
                         (wl (car ws)) (wm (cadr ws)) (wn (caddr ws)))
                    (dk-have! (list '= (list '+ (list '+ wl wm) wn) 1)
                      (lambda ()
                        (subst (list '= wl (list '* g2 rho))) (subst (list '= wm (list '* g3 rho))) (subst (list '= wn (list '* g1 rho)))
                        (dk-have! (list '= (list '+ (list '+ (list '* g2 rho) (list '* g3 rho)) (list '* g1 rho)) (list '* (list '+ (list '+ g1 g2) g3) rho)) (lambda () (crs)))
                        (subst (list '= (list '+ (list '+ (list '* g2 rho) (list '* g3 rho)) (list '* g1 rho)) (list '* (list '+ (list '+ g1 g2) g3) rho)))
                        (subst (list '= (list '+ (list '+ g1 g2) g3) K))
                        (subst inv) (if (not (proof-done? *ps*)) (rfl))))
                    (for-each (lambda (x)
                                (dk-have! (list 'IN x '(CCINT 0 1))
                                  (lambda () (mac 'ccint-membership)
                                             (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                                                            (apply dk-ineq! (cons (list '= (list '+ (list '+ wl wm) wn) 1)
                                                                                                  (map (lambda (y) (list '<= 0 y)) ws)))))))))
                              ws)
                    (dk-have! (list '= u (list '+ (list '+ (list '* wl a) (list '* wm b)) (list '* wn c)))
                      (lambda ()
                        (subst (list '= wl (list '* g2 rho))) (subst (list '= wm (list '* g3 rho))) (subst (list '= wn (list '* g1 rho)))
                        (let ((S (list '+ (list '+ (list '* g2 a) (list '* g3 b)) (list '* g1 c))))
                          (dk-have! (list '= (list '+ (list '+ (list '* (list '* g2 rho) a) (list '* (list '* g3 rho) b)) (list '* (list '* g1 rho) c)) (list '* rho S))
                            (lambda () (fact 'rr-subset-cc rho) (crs)))
                          (subst (list '= (list '+ (list '+ (list '* (list '* g2 rho) a) (list '* (list '* g3 rho) b)) (list '* (list '* g1 rho) c)) (list '* rho S)))
                          (subst (list '= S (list '* K u)))
                          (dk-have! (list '= (list '* rho (list '* K u)) (list '* (list '* K rho) u)) (lambda () (fact 'rr-subset-cc rho) (crs)))
                          (subst (list '= (list '* rho (list '* K u)) (list '* (list '* K rho) u)))
                          (subst inv)
                          (crs))))
                    (dk-fact! 'conv3-intro a b c wl wm wn u)
                    (ai (list 'NOT (list 'IN u T3))))))
              (lambda () (neg! g3) (side! (list a c)))))
          (lambda () (neg! g2) (side! (list c b)))))
      (lambda () (neg! g1) (side! (list b a))))))
(qed 'triangle-winding-exterior)

  
