;;; triangle-winding.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3e/ch3e-wind.scm, scratchpad/ch3e/ch3e-wext.scm.
;;; Library: complex-analysis.

;;; ch3e-wind.scm -- CH3-E: Proposition 3.32 (the winding number of a positively oriented
;;; triangle about an interior point is 1), by the logarithm segment by segment.
;;; Loaded after ch3e-angle.scm and ch3e-orient.scm (same environment).  Helper prefix aw-.
;;;
;;;   H(mu, u) = {w in CC : 0 < Re(mu (w - u))} is open                      (cc-half-plane-open)
;;;   on the segment p -> q seen from u with Im((q - u) conj(p - u)) > 0, mu = conj(i (p - q)):
;;;     Re(mu (w - u)) = Im((q - u) conj(p - u)) on the whole line, so the segment lies in H,
;;;     and SEG-INT(1/(w - u), p, q) = Log(mu (q - u)) - Log(mu (p - u))       (seg-int-log)
;;;   the three differences D have exp(D) (p - u) = q - u and 0 < Im D < pi; their sum is 2 pi i.
;;; Library: complex-analysis.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch3e/ch3e-angle.scm, ch3e/ch3e-orient.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (an-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "an-pick: nothing matching" what) (car l))))
(define (an-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (an-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (an-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define an-r2i '(recip (* 2 +i)))
(define (an-r2i! )                             ; recip(2 i) typed, named; returns the name and (= (* (* 2 +i) n) 1)
  (fact 'cc-i-in)
  (an-cc! '(* 2 +i))
  (dk-have! '(NOT (= (* 2 +i) 0)) (lambda () (arith)))
  (an-and! '(IN (* 2 +i) CC) '(NOT (= (* 2 +i) 0)))
  (fact 'cc-recip-closed '(* 2 +i))
  (fact 'cc-recip-inverse '(* 2 +i))
  (let ((v (dk-name! an-r2i 'CC)))
    (dk-rewrite-h! (list '= '(* (* 2 +i) (recip (* 2 +i))) 1) an-r2i v)
    v))
(define (an-r2! )
  (dk-have! '(IN 2 RR)) (dk-have! '(NOT (= 2 0)) (lambda () (arith)))
  (an-and! '(IN 2 RR) '(NOT (= 2 0)))
  (fact 'rr-recip-closed 2) (fact 'rr-recip-inverse 2) (fact 'rr-subset-cc '(recip 2))
  (let ((v (dk-name! '(recip 2) 'CC)))
    (dk-rewrite-h! '(= (* 2 (recip 2)) 1) '(recip 2) v)
    v))
(define (an-name-recips!)
  (if (dk-contains? (dk-goal) an-r2i) (let ((v (an-r2i!))) (subst (list '= an-r2i v))))
  (if (dk-contains? (dk-goal) '(recip 2)) (let ((v (an-r2!))) (subst (list '= '(recip 2) v)))))
(define (an-lt-of-le-ne! a b)    ; a <= b and NOT (b = a) in context => a < b
  (if (not (dk-asm? (list 'NOT (list '= a b))))
      (dk-have! (list 'NOT (list '= a b))
        (lambda () (di) (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl))) (ai (list 'NOT (list '= b a))))))
  (an-rr! a) (an-rr! b)
  (let ((ch (dk-cite! 'rr-le-ne-lt a b)))
    (if (and (pair? ch) (eq? (car ch) 'IMPLIES))
        (detach-with! ch (lambda () (dk-conj-close! (lambda () (ass))))))))
(define (ao-cr z w) (list 'imag-part (list '* z (list 'conjugate w))))
(define (ao-base! z)
  (an-cc! z)
  (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
  (let* ((dec (dk-cite! 'cc-re-im-decompose z))
         (x (dk-name! (list 'real-part z) 'RR))
         (d1 (dk-rewrite-h! dec (list 'real-part z) x))
         (y (dk-name! (list 'imag-part z) 'RR)))
    (dk-rewrite-h! d1 (list 'imag-part z) y)
    (cons z (cons x y))))
(define (ao-eval e env)                       ; -> (X . Y); (* c e) has c real
  (let ((hit (assoc e env)))
    (cond (hit (cdr hit))
          ((eqv? e 0) (cons 0 0))
          ((and (pair? e) (eq? (car e) '+))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '+ (car a) (car b)) (list '+ (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-) (= (length e) 3))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '- (car a) (car b)) (list '- (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-))
           (let ((a (ao-eval (cadr e) env))) (cons (list '- (car a)) (list '- (cdr a)))))
          ((and (pair? e) (eq? (car e) '*))
           (let ((a (ao-eval (caddr e) env))) (cons (list '* (cadr e) (car a)) (list '* (cadr e) (cdr a)))))
          (#t (error "ao-eval: no coordinates for" e)))))
(define (ao-coords! e env)                    ; lands Re e = X, Im e = Y; returns (X . Y)
  (let* ((xy (ao-eval e env)) (X (car xy)) (Y (cdr xy)))
    (an-cc! e) (an-rr! X) (an-rr! Y)
    (let ((eq (list '= e (list '+ X (list '* Y '+i)))))
      (if (not (dk-asm? eq))
          (dk-have! eq (lambda ()
                         (for-each (lambda (b) (if (dk-contains? (cadr (dk-goal)) (car b))
                                                   (subst (list '= (car b) (list '+ (cadr b) (list '* '+i (cddr b)))))))
                                   env)
                         (crs))))
      (if (not (and (dk-asm? (list '= (list 'real-part e) X)) (dk-asm? (list '= (list 'imag-part e) Y))))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of e X Y))))
      xy)))
(define (ao-cross! z w env)                   ; lands cr(z, w) = Yz Xw - Xz Yw; returns the RHS
  (let* ((a (ao-coords! z env)) (b (ao-coords! w env))
         (rhs (list '- (list '* (cdr a) (car b)) (list '* (car a) (cdr b))))
         (eq (list '= (ao-cr z w) rhs)))
    (if (not (dk-asm? eq))
        (let ((t1 (dk-cite! 'cc-cross-coords z w)))
          (dk-have! eq (lambda ()
                         (subst t1)
                         (subst (list '= (list 'imag-part z) (cdr a))) (subst (list '= (list 'real-part w) (car b)))
                         (subst (list '= (list 'real-part z) (car a))) (subst (list '= (list 'imag-part w) (cdr b)))
                         (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (crs)))))))
    rhs))
(define (ao-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ao-unit! v)
  (let ((mem (list 'IN v '(CCINT 0 1))))
    (fact 'ccint-elt-in-rr 0 1 v)
    (if (not (and (dk-asm? (list '<= 0 v)) (dk-asm? (list '<= v 1))))
        (let ((cj (list 'AND (list '<= 0 v) (list '<= v 1))))
          (dk-have! cj (lambda () (mac-h 'ccint-membership mem) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
          (dk-split! cj)))))
(define (ao-wt-claim t lhs k)
  (list 'FORSOME t (list 'AND (list 'IN t 'RR) (list 'AND (list '<= 0 t) (list '= lhs (list '* t k))))))
(define ao-int '(INTERIOR CC-MS (CONV3 aoa_ aob_ aoc_)))
;;; ---- end of copied helpers ----

(define (aw-H mu u) (list 'SEP 'aohw_ 'CC (list '< 0 (list 'real-part (list '* mu (list '- 'aohw_ u))))))
(define aw-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))

;;; ---------------------------------------------------------------------------
;;; an open half-plane
(sp (make-wff (forall-guarded '(aomu_ aouu_) '((IN aomu_ CC) (IN aouu_ CC))
  (list 'IS-OPEN aw-nfm (aw-H 'aomu_ 'aouu_)))))
(dk-peel!)
(fact 'nf-cc-is-metric-space)
(fact 'cc-is-metric-space)
(let* ((mu 'aomu_) (uu 'aouu_) (H (aw-H mu uu))
       (iff (dk-cite! 'cc-ms-open-iff H)))
  (define (open-mem! y)                       ; y in H in context: land y in CC, 0 < Re(mu (y - uu))
    (let ((m (list 'IN y H)))
      (dk-project! (list 'IN y 'CC) (lambda () (sep-me (dk-ctx-form m))))
      (dk-project! (list '< 0 (list 'real-part (list '* mu (list '- y uu)))) (lambda () (sep-me (dk-ctx-form m))))))
  (dk-have! (list 'IS-OPEN 'CC-MS H)
    (lambda ()
      (mac 'IS-OPEN)
      (dk-conj-close!
        (lambda ()
          (let* ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'SUBSET)
               (let* ((x (subset-by-element!)))
                 (open-mem! x)
                 (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
                 (subst '(= (PTS CC-MS) CC))
                 (dk-ass!)))
              (#t
               (let* ((y (dk-di-var!))
                      (X (list '* mu (list '- y uu))) (d (list 'real-part X))
                      (M (list 'magnitude mu)))
                 (open-mem! y)
                 (an-cc! X) (fact 'real-part-in-rr X)
                 (fact 'cc-magnitude-closed mu) (fact 'cc-magnitude-nonneg mu)
                 (an-rr! (list '+ M 1))
                 (dk-have! (list '< 0 (list '+ M 1)) (lambda () (dk-ineq! (list '<= 0 M))))
                 (dk-have! (list 'NOT (list '= (list '+ M 1) 0)) (lambda () (di) (dk-absurd! (list '= (list '+ M 1) 0) (list '< 0 (list '+ M 1)))))
                 (an-and! (list 'IN (list '+ M 1) 'RR) (list 'NOT (list '= (list '+ M 1) 0)))
                 (fact 'rr-recip-closed (list '+ M 1)) (fact 'rr-recip-inverse (list '+ M 1)) (fact 'rr-recip-pos (list '+ M 1))
                 (let* ((rc (list 'recip (list '+ M 1)))
                        (rho (dk-name! rc 'RR)))
                   (dk-rewrite-h! (list '= (list '* (list '+ M 1) rc) 1) rc rho)
                   (dk-rewrite-h! (list '< 0 rc) rc rho)
                   (an-rr! (list '* d rho))
                   (fact 'rr-mul-pos d rho)
                   (let ((r (dk-name! (list '* d rho) 'RR)))
                     (dk-rewrite-h! (list '< 0 (list '* d rho)) (list '* d rho) r)
                     ;; M r = d - r: M d rho = d (1 - rho)
                     (an-rr! (list '* M r))
                     (dk-have! (list '= (list '* M r) (list '- d r))
                       (lambda ()
                         (let ((aww-hq (list '= (list '* M (list '* d rho)) (list '- (list '* d (list '* (list '+ M 1) rho)) (list '* d rho)))))
                           (dk-have! aww-hq (lambda () (crs)))
                           (let ((h2 (dk-rewrite-h! aww-hq (list '* (list '+ M 1) rho) 1)))
                             (subst (list '= r (list '* d rho)))
                             (subst h2) (crs)))))
                     (dk-cite! 'rr-pos-rr-of-lt r)
                     (ew r)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal))
                             (dk-ass!)
                             (let* ((w (subset-by-element!))
                                    (Xw (list '* mu (list '- w uu))) (E (list '* mu (list '- w y))))
                               (let ((bi (dk-cite! 'cc-ms-ball-membership y r w)))
                                 (dk-have! (list 'AND (list 'IN w 'CC) (list '< (list 'magnitude (list '- w y)) r))
                                   (lambda () (ai bi) (detach! (list 'IMPLIES (list 'IN w (list 'BALL 'CC-MS y r)) (caddr bi))) (ass)))
                                 (dk-split-all! (list (list 'AND (list 'IN w 'CC) (list '< (list 'magnitude (list '- w y)) r)))))
                               (an-cc! (list '- w y)) (an-cc! E) (an-cc! Xw)
                               (fact 'real-part-in-rr E) (fact 'real-part-in-rr Xw)
                               (dk-have! (list '= Xw (list '+ E X)) (lambda () (crs)))
                               (dk-cite! 'cc-re-add E X)
                               (dk-have! (list '= (list 'real-part Xw) (list '+ (list 'real-part E) d))
                                 (lambda () (subst (list '= Xw (list '+ E X))) (ass)))
                               (an-and! (list 'IN mu 'CC) (list 'IN (list '- w y) 'CC))
                               (fact 'cc-magnitude-mul mu (list '- w y))
                               (fact 'cc-magnitude-closed (list '- w y)) (fact 'cc-magnitude-nonneg (list '- w y))
                               (fact 'cc-abs-re-le-magnitude E)
                               (an-rr! (list 'abs (list 'real-part E)))
                               (an-rr! (list 'magnitude E))
                               (dk-have! (list '<= (list 'abs (list 'real-part E)) (list '* M (list 'magnitude (list '- w y))))
                                 (lambda () (dk-rewrite-h! (list '<= (list 'abs (list 'real-part E)) (list 'magnitude E)) (list 'magnitude E) (list '* M (list 'magnitude (list '- w y)))) (ass)))
                               (an-rr! (list '* M (list 'magnitude (list '- w y))))
                               (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list 'real-part E) (list '* M (list 'magnitude (list '- w y))))))
                               ;; M |w - y| <= M r
                               (dk-have! (list '<= (list 'magnitude (list '- w y)) r) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- w y)) r))))
                               (an-and! (list '<= 0 M) (list '<= (list 'magnitude (list '- w y)) r))
                               (let ((le (dk-cite! 'rr-le-scale-nonneg M (list 'magnitude (list '- w y)) r)))
                                 (if (and (pair? le) (eq? (car le) 'IMPLIES))
                                     (detach-with! le (lambda () (dk-conj-close! (lambda () (ass)))))))
                               (dk-have! (list '< 0 (list 'real-part Xw))
                                 (lambda () (dk-ineq! (list '= (list 'real-part Xw) (list '+ (list 'real-part E) d))
                                                      (list '<= (list '- (list '* M (list 'magnitude (list '- w y)))) (list 'real-part E))
                                                      (list '<= (list '* M (list 'magnitude (list '- w y)))  (list '* M r))
                                                      (list '= (list '* M r) (list '- d r))
                                                      (list '< 0 r))))
                               (dk-have! (list 'IN w H) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                               (dk-ass!)))))))))))))))
  (if (dk-only! iff (list 'IS-OPEN 'CC-MS H)) (prop)))
(qed 'cc-half-plane-open)
;;; ---------------------------------------------------------------------------
;;; Re(conj z w) in coordinates
(sp (make-wff (forall-guarded '(aoz_ aow_) '((IN aoz_ CC) (IN aow_ CC))
  '(= (real-part (* (conjugate aoz_) aow_)) (+ (* (real-part aoz_) (real-part aow_)) (* (imag-part aoz_) (imag-part aow_)))))))
(dk-peel!)
(fact 'cc-conjugate-closed 'aoz_)
(fact 'cc-conjugate-involution 'aoz_)
(for-each (lambda (t) (fact 'real-part-in-rr t) (fact 'imag-part-in-rr t)) '(aoz_ aow_ (conjugate aoz_)))
(fact 'cc-re-conj 'aoz_)
(dk-cite! 'cc-re-mul '(conjugate aoz_) 'aow_)
(dk-have! '(= (imag-part (conjugate aoz_)) (- (imag-part aoz_)))
  (lambda () (mac 'imag-part-def) (subst '(= (conjugate (conjugate aoz_)) aoz_)) (an-name-recips!) (crs)))
(subst '(= (real-part (* (conjugate aoz_) aow_)) (- (* (real-part (conjugate aoz_)) (real-part aow_)) (* (imag-part (conjugate aoz_)) (imag-part aow_)))))
(subst '(= (imag-part (conjugate aoz_)) (- (imag-part aoz_))))
(subst '(= (real-part (conjugate aoz_)) (real-part aoz_)))
(crs)
(qed 'cc-dot-coords)

;;; ---------------------------------------------------------------------------
;;; on the line through p and q, Re(conj(i (p - q)) (w - u)) is the cross product of q - u and p - u
(define (aw-mu p q) (list 'conjugate (list '* '+i (list '- p q))))
(sp (make-wff (forall-guarded '(aop_ aoq_ aou_ aos_) '((IN aop_ CC) (IN aoq_ CC) (IN aou_ CC) (IN aos_ RR))
  (list '= (list 'real-part (list '* (aw-mu 'aop_ 'aoq_) '(- (+ aop_ (* aos_ (- aoq_ aop_))) aou_)))
           (ao-cr '(- aoq_ aou_) '(- aop_ aou_))))))
(dk-peel!)
(let* ((p 'aop_) (q 'aoq_) (u 'aou_) (s 'aos_)
       (D (list '- p q)) (V (list '* '+i D))
       (Z (list '- (list '+ p (list '* s (list '- q p))) u))
       (env (map ao-base! (list p q u)))
       (DXY (ao-coords! D env))
       (ZXY (ao-coords! Z env))
       (R (ao-cross! (list '- q u) (list '- p u) env)))
  (fact 'cc-i-in) (an-cc! V) (fact 'real-part-in-rr V) (fact 'imag-part-in-rr V)
  (dk-cite! 'cc-re-i-mul D) (dk-cite! 'cc-im-i-mul D)
  (let ((dot (dk-cite! 'cc-dot-coords V Z)))
    (subst dot)
    (subst (list '= (list 'real-part V) (list '- (list 'imag-part D))))
    (subst (list '= (list 'imag-part V) (list 'real-part D)))
    (subst (list '= (list 'imag-part D) (cdr DXY))) (subst (list '= (list 'real-part D) (car DXY)))
    (subst (list '= (list 'real-part Z) (car ZXY))) (subst (list '= (list 'imag-part Z) (cdr ZXY)))
    (subst (list '= (ao-cr (list '- q u) (list '- p u)) R))
    (crs)))
(qed 'cc-line-dot-cross)

;;; ---------------------------------------------------------------------------
;;; the integral of 1/(w - u) along a segment seen from u under an angle < pi
(define (aw-fu u) (list 'VNB-LAMBDA 'wnw_ (list 'DIFFERENCE 'CC (list 'SINGLETON u)) (list 'recip (list '- 'wnw_ u))))
(define aw-slit '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(sp (make-wff (forall-guarded '(aop_ aoq_ aou_) '((IN aop_ CC) (IN aoq_ CC) (IN aou_ CC))
  (list 'IMPLIES (list '< 0 (ao-cr '(- aoq_ aou_) '(- aop_ aou_)))
    (list '= (list 'SEG-INT (aw-fu 'aou_) 'aop_ 'aoq_)
             (list '- (list 'CC-LOG (list '* (aw-mu 'aop_ 'aoq_) '(- aoq_ aou_)))
                      (list 'CC-LOG (list '* (aw-mu 'aop_ 'aoq_) '(- aop_ aou_)))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (u 'aou_)
       (mu (aw-mu p q)) (H (aw-H mu u)) (fu (aw-fu u))
       (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u)))
       (k (ao-cr (list '- q u) (list '- p u)))
       (F (list 'VNB-LAMBDA 'aohx_ H (list 'CC-LOG (list '* mu (list '- 'aohx_ u)))))
       (df (list 'VNB-LAMBDA 'aohx_ H (list '* (list 'recip (list '* mu (list '- 'aohx_ u))) mu)))
       (SP (list 'SEG-PATH p q)) (SD (list 'SEG-DERIV p q))
       (TR (list 'TRACE SP 0 1)))
  (fact 'cc-i-in) (an-cc! (list '* '+i (list '- p q))) (fact 'cc-conjugate-closed (list '* '+i (list '- p q)))
  (an-cc! (list '- q u)) (an-cc! (list '- p u)) (fact 'cc-conjugate-closed (list '- p u))
  (an-cc! (list '* (list '- q u) (list 'conjugate (list '- p u)))) (fact 'imag-part-in-rr (list '* (list '- q u) (list 'conjugate (list '- p u))))
  (fact 'rr-zero-in) (fact 'rr-subset-cc 0) (dk-cite! 'cc-re-of-real 0)
  (dk-cite! 'cc-half-plane-open mu u)
  (define (in-H! y)                           ; y in H in context: y in CC, 0 < Re(mu (y - u)), typings
    (let ((m (list 'IN y H)) (X (list '* mu (list '- y u))))
      (dk-project! (list 'IN y 'CC) (lambda () (sep-me (dk-ctx-form m))))
      (dk-project! (list '< 0 (list 'real-part X)) (lambda () (sep-me (dk-ctx-form m))))
      (an-cc! X) (fact 'real-part-in-rr X) (fact 'imag-part-in-rr X)
      X))
  (define (guard! body)                       ; forall y in H. body(y)
    (list 'FORALL 'aohy_ (list 'IMPLIES (list 'IN 'aohy_ H) (body 'aohy_))))
  (dk-have! (guard! (lambda (y) (list 'IN (list '* mu (list '- y u)) aw-slit)))
    (lambda ()
      (let* ((y (dk-di-var!)) (X (in-H! y)))
        (in-sep! (lambda () (dk-ass!))
                 (lambda () (di) (dk-split-all!)
                            (dk-absurd! (list '< 0 (list 'real-part X)) (list '<= (list 'real-part X) 0)))))))
  (dk-have! (guard! (lambda (y) (let ((X (list '* mu (list '- y u))))
                                  (list 'NOT (list 'AND (list '= (list 'imag-part X) 0) (list '<= (list 'real-part X) 0))))))
    (lambda ()
      (let* ((y (dk-di-var!)) (X (in-H! y)))
        (di) (dk-split-all!)
        (dk-absurd! (list '< 0 (list 'real-part X)) (list '<= (list 'real-part X) 0)))))
  (dk-have! (guard! (lambda (y) (list 'NOT (list '= (list '* mu (list '- y u)) 0))))
    (lambda ()
      (let* ((y (dk-di-var!)) (X (in-H! y)))
        (di)
        (dk-have! (list '= (list 'real-part X) 0) (lambda () (subst (list '= X 0)) (ass)))
        (dk-absurd! (list '< 0 (list 'real-part X)) (list '= (list 'real-part X) 0)))))
  (dk-have! (guard! (lambda (y) (list 'NOT (list '= (list '- y u) 0))))
    (lambda ()
      (let* ((y (dk-di-var!)) (X (in-H! y)))
        (di)
        (dk-have! (list '= X 0) (lambda () (subst (list '= (list '- y u) 0)) (crs)))
        (dk-have! (list '= (list 'real-part X) 0) (lambda () (subst (list '= X 0)) (ass)))
        (dk-absurd! (list '< 0 (list 'real-part X)) (list '= (list 'real-part X) 0)))))
  (dk-have! (list 'HOLOMORPHIC-ON H F) (lambda () (dk-holomorphic! H F)))
  (dk-have! (list 'FORALL 'aohz_ (list 'IMPLIES (list 'IN 'aohz_ H) (list 'IS-DIFF-ON 'CC-NORMED-FIELD H F 'aohz_ (list df 'aohz_))))
    (lambda ()
      (let* ((z (dk-di-var!)))
        (in-H! z)
        (dk-lam-b!)
        (dk-diff!))))
  (dk-have! (guard! (lambda (y) (list 'IN (list '* (list 'recip (list '* mu (list '- y u))) mu) 'CC)))
    (lambda ()
      (let* ((x (dk-di-var!)) (aww-xh (in-H! x)))
        (if (not (dk-asm? (list 'NOT (list '= aww-xh 0))))
            (dk-have! (list 'NOT (list '= aww-xh 0))
              (lambda () (di)
                         (dk-have! (list '= (list 'real-part aww-xh) 0) (lambda () (subst (list '= aww-xh 0)) (ass)))
                         (dk-absurd! (list '< 0 (list 'real-part aww-xh)) (list '= (list 'real-part aww-xh) 0)))))
        (an-and! (list 'IN aww-xh 'CC) (list 'NOT (list '= aww-xh 0)))
        (fact 'cc-recip-closed aww-xh)
        (an-cc! (list '* (list 'recip aww-xh) mu)))))
  (dk-have! (list 'IN df (list 'FUN H 'CC))
    (lambda () (dk-lam-type! (lambda () (ass)) (lambda () (fact 'cc-is-set) (sep-set) (dk-ass!)))))
  ;; the trace lies in H
  (fact 'seg-path-is-road p q)
  (dk-have! (list 'SUBSET TR H)
    (lambda ()
      (let* ((z (subset-by-element!))
             (t (dk-skolem! (dk-cite! 'seg-trace-elim p q z) #t)))
        (dk-split-all!)
        (ao-unit! t)
        (let ((ze (list '= z (list '+ p (list '* t (list '- q p))))))
          (dk-cite! 'cc-line-dot-cross p q u t)
          (dk-have! (list 'IN z 'CC) (lambda () (subst ze) (type-term)))
          (dk-have! (list '< 0 (list 'real-part (list '* mu (list '- z u))))
            (lambda () (subst ze)
                       (subst (list '= (list 'real-part (list '* mu (list '- (list '+ p (list '* t (list '- q p))) u))) k))
                       (dk-ass!)))
          (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
  ;; the endpoints lie in H; mu /= 0
  (define (endpt! s0 v)                       ; v = p + s0 (q - p)
    (fact 'rr-one-in) (an-rr! s0)
    (let* ((le (dk-cite! 'cc-line-dot-cross p q u s0))
           (comb (list '+ p (list '* s0 (list '- q p)))))
      (dk-have! (list '= comb v) (lambda () (crs)))
      (let ((le2 (dk-rewrite-h! le comb v)))
        (dk-have! (list '< 0 (list 'real-part (list '* mu (list '- v u)))) (lambda () (subst le2) (dk-ass!)))
        (dk-have! (list 'IN v H) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))
  (endpt! 1 q) (endpt! 0 p)
  (in-H! q) (in-H! p)
  (let ((Xq (list '* mu (list '- q u))))
    (dk-have! (list 'NOT (list '= mu 0))
      (lambda () (di)
                 (dk-have! (list '= Xq 0) (lambda () (subst (list '= mu 0)) (crs)))
                 (dk-have! (list '= (list 'real-part Xq) 0) (lambda () (subst (list '= Xq 0)) (ass)))
                 (dk-absurd! (list '< 0 (list 'real-part Xq)) (list '= (list 'real-part Xq) 0)))))
  ;; the fundamental theorem on the segment
  (define (unit-in! t)
    (dk-have! (list 'IN t '(CCINT 0 1))
      (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))))
  (unit-in! 1) (unit-in! 0)
  (dk-cite! 'seg-path-apply p q 1) (dk-cite! 'seg-path-apply p q 0)
  (let ((lod (dk-cite! 'line-int-of-derivative H F df SP SD 0 1)))
    (define (endval! s0 v)                    ; F(SP s0) = CC-LOG(mu (v - u))
      (let* ((X (list '* mu (list '- v u))) (comb (list '+ p (list '* s0 (list '- q p)))))
        (dk-apply! (guard! (lambda (y) (let ((aww-yh (list '* mu (list '- y u))))
                                          (list 'NOT (list 'AND (list '= (list 'imag-part aww-yh) 0) (list '<= (list 'real-part aww-yh) 0)))))) v)
        (dk-split-all! (list (dk-cite! 'cc-log-in-slit X)))
        (dk-have! (list '= (list F (list SP s0)) (list 'CC-LOG X))
          (lambda () (subst (list '= (list SP s0) comb)) (subst (list '= comb v)) (dk-lam-b!)
                     (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
    (endval! 1 q) (endval! 0 p)
    ;; the integrands agree on the trace
    (let* ((hol (dk-cite! 'winding-integrand-holomorphic u)))
      (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
      (dk-have! (list 'SUBSET Pu 'CC)
        (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                     (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
      (define (nz! z)                         ; z in H: NOT (= (- z u) 0)
        (let ((X (in-H! z)))
          (if (not (dk-asm? (list 'NOT (list '= (list '- z u) 0))))
              (dk-have! (list 'NOT (list '= (list '- z u) 0))
                (lambda () (di)
                           (dk-have! (list '= X 0) (lambda () (subst (list '= (list '- z u) 0)) (crs)))
                           (dk-have! (list '= (list 'real-part X) 0) (lambda () (subst (list '= X 0)) (ass)))
                           (dk-absurd! (list '< 0 (list 'real-part X)) (list '= (list 'real-part X) 0)))))))
      (dk-have! (list 'SUBSET H Pu)
        (lambda () (let* ((z (subset-by-element!)))
                     (nz! z)
                     (dk-have! (list 'NOT (list '= z u))
                       (lambda () (di) (dk-have! (list '= (list '- z u) 0) (lambda () (subst (list '= z u)) (crs)))
                                  (ai (list 'NOT (list '= (list '- z u) 0)))))
                     (mac 'cc-punctured-membership) (dk-conj-close! (lambda () (dk-ass!))))))
      (fact 'subset-trans TR H Pu)
      (dk-have! (list 'FORALL 'aohz_ (list 'IMPLIES (list 'IN 'aohz_ TR) (list '== (list df 'aohz_) (list fu 'aohz_))))
        (lambda ()
          (let* ((z (dk-di-var!)) (Zd (list '- z u)) (X (list '* mu Zd)))
            (dk-fact! 'subset-mem-fwd TR H z)
            (dk-fact! 'subset-mem-fwd H Pu z)
            (nz! z)
            (dk-lam-b!)
            (an-cc! Zd)
            (fact 'cc-recip-mul mu Zd)
            (an-and! (list 'IN mu 'CC) (list 'NOT (list '= mu 0))) (an-and! (list 'IN Zd 'CC) (list 'NOT (list '= Zd 0)))
            (fact 'cc-recip-inverse mu) (fact 'cc-recip-closed mu) (fact 'cc-recip-closed Zd)
            (let* ((rm (dk-name! (list 'recip mu) 'CC)) (rz (dk-name! (list 'recip Zd) 'CC)))
              (subst (list '= (list 'recip X) (list '* (list 'recip mu) (list 'recip Zd))))
              (subst (list '= (list 'recip mu) rm)) (subst (list '= (list 'recip Zd) rz))
              (let ((inv (dk-rewrite-h! (list '= (list '* mu (list 'recip mu)) 1) (list 'recip mu) rm)))
                (dk-have! (list '= (list '* (list '* rm rz) mu) (list '* rz (list '* mu rm))) (lambda () (crs)))
                (subst (list '= (list '* (list '* rm rz) mu) (list '* rz (list '* mu rm))))
                (subst inv)
                (dk-have! (list '= (list '* rz 1) rz) (lambda () (crs)))
                (subst (list '= (list '* rz 1) rz))
                (if (not (proof-done? *ps*)) (qrfl)))))))
      (let ((cong (dk-cite! 'seg-int-congruence Pu fu H df p q)))
        (subst (list '= (list 'SEG-INT fu p q) (list 'SEG-INT df p q)))
        (subst (dk-cite! 'seg-int-unfold df p q))
        (subst lod)
        (subst (list '= (list F (list SP 1)) (list 'CC-LOG (list '* mu (list '- q u)))))
        (subst (list '= (list F (list SP 0)) (list 'CC-LOG (list '* mu (list '- p u)))))
        (an-cc! (list '- (list 'CC-LOG (list '* mu (list '- q u))) (list 'CC-LOG (list '* mu (list '- p u)))))
        (if (not (proof-done? *ps*)) (rfl))))))
(qed 'seg-int-log)

;;; ---------------------------------------------------------------------------
;;; the step D = Log(mu (q - u)) - Log(mu (p - u)): exp(D) (p - u) = q - u, and 0 < Im D < pi
(define (aw-D p q u) (list '- (list 'CC-LOG (list '* (aw-mu p q) (list '- q u))) (list 'CC-LOG (list '* (aw-mu p q) (list '- p u)))))
(sp (make-wff (forall-guarded '(aop_ aoq_ aou_) '((IN aop_ CC) (IN aoq_ CC) (IN aou_ CC))
  (list 'IMPLIES (list '< 0 (ao-cr '(- aoq_ aou_) '(- aop_ aou_)))
    (list 'AND (list '= (list '* (list 'CC-EXP (aw-D 'aop_ 'aoq_ 'aou_)) '(- aop_ aou_)) '(- aoq_ aou_))
      (list 'AND (list '< 0 (list 'imag-part (aw-D 'aop_ 'aoq_ 'aou_))) (list '< (list 'imag-part (aw-D 'aop_ 'aoq_ 'aou_)) 'PI)))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (u 'aou_) (mu (aw-mu p q))
       (A (list '- p u)) (B (list '- q u))
       (W1 (list '* mu A)) (W2 (list '* mu B))
       (L1 (list 'CC-LOG W1)) (L2 (list 'CC-LOG W2)) (D (aw-D p q u))
       (k (ao-cr B A)))
  (fact 'cc-i-in) (an-cc! (list '* '+i (list '- p q))) (fact 'cc-conjugate-closed (list '* '+i (list '- p q)))
  (an-cc! A) (an-cc! B) (an-cc! W1) (an-cc! W2)
  (fact 'cc-conjugate-closed A) (an-cc! (list '* B (list 'conjugate A))) (fact 'imag-part-in-rr (list '* B (list 'conjugate A)))
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'rr-subset-cc 0) (dk-cite! 'cc-re-of-real 0)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  ;; Re(mu A) = Re(mu B) = k > 0
  (for-each (lambda (s0 v)
              (let* ((le (dk-cite! 'cc-line-dot-cross p q u s0))
                     (comb (list '+ p (list '* s0 (list '- q p)))))
                (dk-have! (list '= comb v) (lambda () (crs)))
                (dk-rewrite-h! le comb v)))
            (list 1 0) (list q p))
  (for-each (lambda (W)
              (fact 'real-part-in-rr W) (fact 'imag-part-in-rr W)
              (dk-have! (list '< 0 (list 'real-part W)) (lambda () (dk-ineq! (list '= (list 'real-part W) k) (list '< 0 k))))
              (dk-have! (list 'NOT (list 'AND (list '= (list 'imag-part W) 0) (list '<= (list 'real-part W) 0)))
                (lambda () (di) (dk-split-all!) (dk-absurd! (list '< 0 (list 'real-part W)) (list '<= (list 'real-part W) 0))))
              (dk-split-all! (list (dk-cite! 'cc-log-spec W)))
              (dk-split-all! (list (dk-cite! 'cc-log-right-half W)))
              (fact 'imag-part-in-rr (list 'CC-LOG W)) (fact 'real-part-in-rr (list 'CC-LOG W)))
            (list W1 W2))
  ;; mu /= 0
  (dk-have! (list 'NOT (list '= mu 0))
    (lambda () (di)
               (dk-have! (list '= W2 0) (lambda () (subst (list '= mu 0)) (crs)))
               (dk-have! (list '= (list 'real-part W2) 0) (lambda () (subst (list '= W2 0)) (ass)))
               (dk-absurd! (list '< 0 (list 'real-part W2)) (list '= (list 'real-part W2) 0))))
  (an-cc! D)
  (define (aw-exp-cc! z) (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges z)))))
  (let* ((mn (dk-name! mu 'CC)) (dv (dk-name! D 'CC)))
    (fact 'cc-conjugate-closed mn)
    (define (crs-mu!) (if (dk-contains? (dk-goal) mu) (subst (list '= mu mn))) (crs))
    (subst (list '= D dv))
    (aw-exp-cc! dv) (aw-exp-cc! L1) (aw-exp-cc! L2)
    (fact 'imag-part-in-rr dv)
    (let ((e (dk-cite! 'cc-exp-add dv L1)))
      (dk-have! (list '= (list '+ dv L1) L2)
        (lambda () (subst (list '= dv D))
                   (let* ((lg1 (dk-name! L1 'CC)) (lg2 (dk-name! L2 'CC)))
                     (subst (list '= L1 lg1)) (subst (list '= L2 lg2)) (crs))))
      (let* ((e1 (dk-rewrite-h! e (list '+ dv L1) L2))
             (e2 (dk-rewrite-h! e1 (list 'CC-EXP L1) W1))
             (e3 (dk-rewrite-h! e2 (list 'CC-EXP L2) W2)))
        (let ((x (list '- (list '* (list 'CC-EXP dv) A) B)))
          (an-cc! x)
          (dk-have! (list '= (list '* x mu) (list '- (list '* (list 'CC-EXP dv) W1) W2)) (lambda () (crs-mu!)))
          (dk-have! (list '= (list '* x mu) 0)
            (lambda () (subst (list '= (list '* x mu) (list '- (list '* (list 'CC-EXP dv) W1) W2)))
                       (subst (list '= W2 (list '* (list 'CC-EXP dv) W1)))
                       (crs-mu!)))
          (dk-fact! 'cc-mul-zero-left x mu)
          (an-cc! (list '* (list 'CC-EXP dv) A))
          (dk-fact! 'cc-sub-zero-eq (list '* (list 'CC-EXP dv) A) B))))
    (let* ((M (list 'magnitude mu)) (M2 (list '* M M)) (cW1 (list 'conjugate W1)) (Pr (list '* W2 cW1)))
      (fact 'cc-magnitude-closed mu) (fact 'cc-magnitude-nonneg mu)
      (fact 'cc-conjugate-closed mu) (fact 'cc-conjugate-closed W1)
      (an-and! (list 'IN mu 'CC) (list 'IN A 'CC)) (fact 'cc-conjugate-mul mu A)
      (dk-cite! 'cc-magnitude-sq-conjugate mu)
      (an-rr! M2) (an-cc! Pr) (fact 'imag-part-in-rr Pr)
      (dk-have! (list '= Pr (list '* M2 (list '* B (list 'conjugate A))))
        (lambda () (subst (list '= cW1 (list '* (list 'conjugate mu) (list 'conjugate A))))
                   (subst (list '= M2 (list '* mu (list 'conjugate mu))))
                   (crs-mu!)))
      (dk-cite! 'cc-im-real-mul M2 (list '* B (list 'conjugate A)))
      (let ((iff (dk-cite! 'cc-magnitude-zero-iff mu)))
        (dk-have! (list 'NOT (list '= M 0))
          (lambda () (di) (ai iff) (detach! (list 'IMPLIES (list '= M 0) (list '= mu 0))) (ai (list 'NOT (list '= mu 0)))))
        (an-lt-of-le-ne! 0 M))
      (fact 'rr-mul-pos M M)
      (fact 'rr-mul-pos M2 k)
      (an-rr! (list '* M2 k))
      (dk-have! (list '< 0 (list 'imag-part Pr))
        (lambda () (subst (list '= Pr (list '* M2 (list '* B (list 'conjugate A)))))
                   (subst (list '= (list 'imag-part (list '* M2 (list '* B (list 'conjugate A)))) (list '* M2 k)))
                   (dk-ass!)))
      (let* ((V (list '+ L2 (list 'conjugate L1))) (th (list 'imag-part dv)))
        (fact 'cc-conjugate-closed L1) (an-cc! V) (aw-exp-cc! V) (aw-exp-cc! (list 'conjugate L1))
        (dk-cite! 'cc-exp-conj L1) (dk-cite! 'cc-exp-add L2 (list 'conjugate L1))
        (let* ((f1 (list '= (list 'CC-EXP V) (list '* (list 'CC-EXP L2) (list 'CC-EXP (list 'conjugate L1)))))
               (f2 (dk-rewrite-h! f1 (list 'CC-EXP (list 'conjugate L1)) (list 'conjugate (list 'CC-EXP L1))))
               (f3 (dk-rewrite-h! f2 (list 'CC-EXP L1) W1))
               (f4 (dk-rewrite-h! f3 (list 'CC-EXP L2) W2)))
          #t)
        (fact 'imag-part-in-rr V) (fact 'real-part-in-rr V)
        (dk-cite! 'cc-im-add L2 (list 'conjugate L1))
        (dk-cite! 'cc-im-sub L2 L1)
        (fact 'cc-conjugate-involution L1)
        (dk-have! (list '= (list 'imag-part (list 'conjugate L1)) (list '- (list 'imag-part L1)))
          (lambda () (mac 'imag-part-def) (subst (list '= (list 'conjugate (list 'conjugate L1)) L1)) (an-name-recips!)
                     (let* ((cl (dk-name! (list 'conjugate L1) 'CC)) (lg1 (dk-name! L1 'CC)))
                       (subst (list '= (list 'conjugate L1) cl)) (subst (list '= L1 lg1)) (crs))))
        (dk-have! (list '= th (list '- (list 'imag-part L2) (list 'imag-part L1)))
          (lambda () (subst (list '= dv D)) (ass)))
        (dk-have! (list '= (list 'imag-part V) th)
          (lambda () (subst (list '= (list 'imag-part V) (list '+ (list 'imag-part L2) (list 'imag-part (list 'conjugate L1)))))
                     (subst (list '= (list 'imag-part (list 'conjugate L1)) (list '- (list 'imag-part L1))))
                     (subst (list '= th (list '- (list 'imag-part L2) (list 'imag-part L1))))
                     (let* ((i1 (dk-name! (list 'imag-part L1) 'RR)) (i2 (dk-name! (list 'imag-part L2) 'RR)))
                       (subst (list '= (list 'imag-part L1) i1)) (subst (list '= (list 'imag-part L2) i2)) (crs))))
        (dk-split-all! (list (dk-cite! 'exp-polar-re-im V)))
        (dk-split-all! (list (dk-cite! 'cc-exp-real (list 'real-part V))))
        (dk-split-all! (list (dk-cite! 'cc-cos-sin-real th)))
        (let* ((E (list 'CC-EXP (list 'real-part V))) (sth (list 'CC-SIN th)))
          (dk-have! (list '< 0 (list '* E sth))
            (lambda () (let* ((pv (list '= Pr (list 'CC-EXP V)))
                              (h0 (dk-rewrite-h! (list '< 0 (list 'imag-part Pr)) Pr (list 'CC-EXP V)))
                              (h (dk-rewrite-h! h0 (list 'imag-part (list 'CC-EXP V)) (list '* E (list 'CC-SIN (list 'imag-part V))))))
                         (dk-rewrite-h! h (list 'imag-part V) th)
                         (dk-ass!))))
        (dk-have! (list '< 0 sth)
          (lambda () (use-em (list '< 0 sth) (lambda () (ass))
                       (lambda () (an-rr! sth)
                                  (dk-have! (list '<= sth 0) (lambda () (use-em (list '<= sth 0) (lambda () (ass))
                                                                       (lambda () (dk-fact! 'rr-not-le-lt sth 0) (ai (list 'NOT (list '< 0 sth)))))))
                                  (an-rr! (list '- sth))
                                  (dk-have! (list '<= 0 (list '- sth)) (lambda () (dk-ineq! (list '<= sth 0))))
                                  (an-and! (list 'IN E 'RR) (list 'IN (list '- sth) 'RR))
                                  (dk-have! (list '<= 0 E) (lambda () (dk-ineq! (list '< 0 E))))
                                  (an-and! (list '<= 0 E) (list '<= 0 (list '- sth)))
                                  (fact 'rr-leq-mul-nonneg E (list '- sth))
                                  (an-rr! (list '* E (list '- sth)))
                                  (dk-have! (list '= (list '* E (list '- sth)) (list '- (list '* E sth))) (lambda () (crs)))
                                  (let* ((n1 (dk-name! (list '* E (list '- sth)) 'RR))
                                         (h1 (dk-rewrite-h! (list '<= 0 (list '* E (list '- sth))) (list '* E (list '- sth)) n1))
                                         (h2 (dk-rewrite-h! (list '= (list '* E (list '- sth)) (list '- (list '* E sth))) (list '* E (list '- sth)) n1)))
                                    (an-rr! (list '* E sth))
                                    (let* ((es (dk-name! (list '* E sth) 'RR))
                                           (h3 (dk-rewrite-h! h2 (list '* E sth) es))
                                           (h4 (dk-rewrite-h! (list '< 0 (list '* E sth)) (list '* E sth) es)))
                                      (dk-absurd! h1 h3 h4)))))))
        ;; -pi < Im D < pi from the half-plane bounds; Im D > 0 since sin(t) <= 0 on (-pi, 0]
        (dk-have! (list '< th 'PI)
          (lambda () (dk-ineq! (list '= th (list '- (list 'imag-part L2) (list 'imag-part L1)))
                               (list '< (list 'imag-part L2) (list '* 1/2 'PI)) (list '< (list '- (list '* 1/2 'PI)) (list 'imag-part L1)))))
        (dk-have! (list '< (list '- 'PI) th)
          (lambda () (dk-ineq! (list '= th (list '- (list 'imag-part L2) (list 'imag-part L1)))
                               (list '< (list 'imag-part L1) (list '* 1/2 'PI)) (list '< (list '- (list '* 1/2 'PI)) (list 'imag-part L2)))))
        (dk-have! (list '< 0 th)
          (lambda ()
            (use-em (list '< 0 th) (lambda () (ass))
              (lambda ()
                (use-em (list '<= th 0)
                  (lambda ()
                    (use-em (list '= th 0)
                      (lambda ()
                        (fact 'rr-subset-cc 0) (dk-cite! 'cc-sin-odd 0) (dk-split-all! (list (dk-cite! 'cc-cos-sin-real 0)))
                        (dk-have! '(= (- 0) 0) (lambda () (arith)))
                        (let ((h (dk-rewrite-h! '(= (CC-SIN (- 0)) (- (CC-SIN 0))) '(- 0) 0)))
                          (dk-have! (list '= sth '(CC-SIN 0)) (lambda () (subst (list '= th 0)) (rfl)))
                          (dk-absurd! (list '< 0 sth) (list '= sth '(CC-SIN 0)) h)))
                      (lambda ()
                        (an-lt-of-le-ne! th 0)
                        (an-rr! (list '- th))
                        (dk-have! (list '< 0 (list '- th)) (lambda () (dk-ineq! (list '< th 0))))
                        (dk-have! (list '< (list '- th) 'PI) (lambda () (dk-ineq! (list '< (list '- 'PI) th))))
                        (fact 'cc-sin-pos-half (list '- th))
                        (fact 'rr-subset-cc th)
                        (dk-cite! 'cc-sin-odd th)
                        (dk-split-all! (list (dk-cite! 'cc-cos-sin-real (list '- th))))
                        (dk-absurd! (list '< 0 (list 'CC-SIN (list '- th))) (list '= (list 'CC-SIN (list '- th)) (list '- sth)) (list '< 0 sth)))))
                  (lambda () (dk-fact! 'rr-not-le-lt th 0) (ai (list 'NOT (list '< 0 th))))))))))
      (dk-conj-close! (lambda () (dk-ass!)))))))
(qed 'seg-log-step)

;;; ---------------------------------------------------------------------------
;;; such a segment misses u
(sp (make-wff (forall-guarded '(aop_ aoq_ aou_) '((IN aop_ CC) (IN aoq_ CC) (IN aou_ CC))
  (list 'IMPLIES (list '< 0 (ao-cr '(- aoq_ aou_) '(- aop_ aou_)))
    '(SUBSET (TRACE (SEG-PATH aop_ aoq_) 0 1) (DIFFERENCE CC (SINGLETON aou_)))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (u 'aou_) (mu (aw-mu p q)) (k (ao-cr (list '- q u) (list '- p u))))
  (fact 'cc-i-in) (an-cc! (list '* '+i (list '- p q))) (fact 'cc-conjugate-closed (list '* '+i (list '- p q)))
  (fact 'rr-zero-in) (fact 'rr-subset-cc 0) (dk-cite! 'cc-re-of-real 0)
  (an-cc! (list '- q u)) (an-cc! (list '- p u)) (fact 'cc-conjugate-closed (list '- p u))
  (an-cc! (list '* (list '- q u) (list 'conjugate (list '- p u)))) (fact 'imag-part-in-rr (list '* (list '- q u) (list 'conjugate (list '- p u))))
  (let* ((z (subset-by-element!))
         (t (dk-skolem! (dk-cite! 'seg-trace-elim p q z) #t)))
    (dk-split-all!)
    (ao-unit! t)
    (let* ((ze (list '= z (list '+ p (list '* t (list '- q p)))))
           (X (list '* mu (list '- z u))))
      (dk-cite! 'cc-line-dot-cross p q u t)
      (dk-have! (list 'IN z 'CC) (lambda () (subst ze) (type-term)))
      (an-cc! X) (fact 'real-part-in-rr X)
      (dk-have! (list '< 0 (list 'real-part X))
        (lambda () (subst ze)
                   (subst (list '= (list 'real-part (list '* mu (list '- (list '+ p (list '* t (list '- q p))) u))) k))
                   (dk-ass!)))
      (dk-have! (list 'NOT (list '= z u))
        (lambda () (di)
                   (dk-have! (list '= X 0) (lambda () (subst (list '= z u)) (crs)))
                   (dk-have! (list '= (list 'real-part X) 0) (lambda () (subst (list '= X 0)) (ass)))
                   (dk-absurd! (list '< 0 (list 'real-part X)) (list '= (list 'real-part X) 0))))
      (mac 'cc-punctured-membership) (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'seg-trace-punctured)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.32 (interior case): the winding number of a positively oriented triangle about a
;;; point of the interior of its hull is 1.
(define (aw-pos-factor! kk x)                  ; 0 < kk, 0 < kk * x, x in RR  ==>  0 < x
  (if (not (dk-asm? (list '< 0 x)))
      (dk-have! (list '< 0 x)
        (lambda ()
          (use-em (list '< 0 x) (lambda () (ass))
            (lambda ()
              (dk-have! (list '<= x 0) (lambda () (use-em (list '<= x 0) (lambda () (ass))
                                                    (lambda () (dk-fact! 'rr-not-le-lt x 0) (ai (list 'NOT (list '< 0 x))))))) 
              (an-rr! (list '- x))
              (dk-have! (list '<= 0 (list '- x)) (lambda () (dk-ineq! (list '<= x 0))))
              (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk))))
              (an-and! (list 'IN kk 'RR) (list 'IN (list '- x) 'RR))
              (an-and! (list '<= 0 kk) (list '<= 0 (list '- x)))
              (fact 'rr-leq-mul-nonneg kk (list '- x))
              (an-rr! (list '* kk (list '- x))) (an-rr! (list '* kk x))
              (dk-have! (list '= (list '* kk (list '- x)) (list '- (list '* kk x))) (lambda () (crs)))
              (let* ((n1 (dk-name! (list '* kk (list '- x)) 'RR))
                     (h1 (dk-rewrite-h! (list '<= 0 (list '* kk (list '- x))) (list '* kk (list '- x)) n1))
                     (h2 (dk-rewrite-h! (list '= (list '* kk (list '- x)) (list '- (list '* kk x))) (list '* kk (list '- x)) n1))
                     (kx (dk-name! (list '* kk x) 'RR))
                     (h3 (dk-rewrite-h! h2 (list '* kk x) kx))
                     (h4 (dk-rewrite-h! (list '< 0 (list '* kk x)) (list '* kk x) kx)))
                (dk-absurd! h1 h3 h4))))))))
;;; the three cross products at an interior point of a positively oriented triangle are positive
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
  (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
  (list 'FORALL 'aou_ (list 'IMPLIES (list 'IN 'aou_ ao-int) (list 'AND (list '< 0 (ao-cr '(- aob_ aou_) '(- aoa_ aou_))) (list 'AND (list '< 0 (ao-cr '(- aoc_ aou_) '(- aob_ aou_))) (list '< 0 (ao-cr '(- aoa_ aou_) '(- aoc_ aou_))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_)
       (u (cadr (an-pick "the interior point" (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) ao-int))))))
       (T3 (list 'CONV3 a b c))
       (pairs (list (list b a) (list c b) (list a c)))     ; (q p)
       (ks (map (lambda (qp) (let ((q (car qp)) (p (cadr qp)) (r (car (filter (lambda (x) (not (memq x qp))) (list a b c)))))
                               (ao-cr (list '- q r) (list '- p r))))
                pairs))
       (W (dk-cite! 'conv3-cross-weights a b c))
       (fu (aw-fu u)) (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u))))
  ;; u in CC
  (dk-split-all! (dk-landed* (lambda () (mac-h 'interior-membership (list 'IN u ao-int)))))
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-have! (list 'IN u 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
  (dk-have! (list 'IN u ao-int) (lambda () (mac 'interior-membership) (dk-conj-close! (lambda () (dk-ass!)))))
  ;; the three angles at u
  (mac-h 'POSITIVELY-ORIENTED '(POSITIVELY-ORIENTED aoa_ aob_ aoc_))
  (dk-split-all! (list (dk-apply! (an-pick "the orientation" (lambda (f) (and (ao-op? f 'FORALL 3) (dk-contains? f 'ANGLE)))) u)))
  ;; each cross product is positive
  (for-each
    (lambda (qp k)
      (let* ((q (car qp)) (p (cadr qp))
             (Hi (list 'FORALL 'aoz_ (list 'IMPLIES (list 'IN 'aoz_ T3) (ao-wt-claim 'aot_ (ao-cr (list '- q 'aoz_) (list '- p 'aoz_)) k))))
             (cr (ao-cr (list '- q u) (list '- p u))))
        (an-cc! (cadr k)) (fact 'imag-part-in-rr (cadr k))
        (dk-have! Hi (lambda ()
                       (let* ((z (cadr (find-first (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) T3)))
                                                   (dk-landed (lambda () (di))))))
                              (cj (dk-apply! W z)))
                         (dk-split-all! (list cj))
                         (ass))))
        (let* ((Uf (dk-cite! 'interior-angle-sign p q k T3))
               (iff (dk-apply! Uf u)))
          (dk-have! (list '< 0 k) (lambda () (if (dk-only! iff (cadr iff)) (prop)))))
        (dk-cite! 'interior-cross-sign p q k T3 u)
        (an-cc! (list '- q u)) (an-cc! (list '- p u)) (fact 'cc-conjugate-closed (list '- p u))
        (an-cc! (cadr cr)) (fact 'imag-part-in-rr (cadr cr))
        (aw-pos-factor! k cr)))
    pairs ks)
  (dk-conj-close! (lambda () (dk-ass!))))
(qed 'triangle-crosses-positive)

;;; around such a triangle, the integral of 1/(w - u) is 2 pi i
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
  (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
  (list 'FORALL 'aou_ (list 'IMPLIES (list 'IN 'aou_ ao-int) (list '= (list 'TRI-INT (aw-fu 'aou_) 'aoa_ 'aob_ 'aoc_) '(* (* 2 PI) +i)))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_)
       (u (cadr (an-pick "the interior point" (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) ao-int))))))
       (fu (aw-fu u)) (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u))))
  (dk-have! (list 'IN u ao-int) (lambda () (dk-ass!)))
  (let ((pre (dk-cite! 'triangle-crosses-positive a b c)))
    (dk-split-all! (list (dk-apply! pre u))))
  (dk-have! (list 'IN u 'CC)
    (lambda () (dk-split-all! (dk-landed* (lambda () (mac-h 'interior-membership (list 'IN u ao-int)))))
               (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
               (subst '(= CC (PTS CC-MS))) (dk-ass!)))
  ;; the integrand on the punctured plane
  (dk-cite! 'winding-integrand-holomorphic u)
  (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
  (dk-have! (list 'SUBSET Pu 'CC)
    (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                 (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'rr-subset-cc 0) (fact 'rr-subset-cc 1)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  ;; the three segments: SEG-INT = d, exp(d) (p - u) = q - u, 0 < Im d < pi
  (let* ((segs (list (list a b) (list b c) (list c a)))
         (ds
          (map (lambda (pq)
                 (let* ((p (car pq)) (q (cadr pq)) (D (aw-D p q u)) (si (list 'SEG-INT fu p q)))
                   (dk-cite! 'seg-trace-punctured p q u)
                   (dk-cite! 'seg-int-log p q u)
                   (dk-split-all! (list (dk-cite! 'seg-log-step p q u)))
                   (dk-cite! 'seg-int-in-cc Pu fu p q)
                   (dk-rewrite-h! (list 'IN si 'CC) si D)
                   (let ((dv (dk-name! D 'CC)))
                     (for-each (lambda (f) (dk-rewrite-h! f D dv))
                               (list (list '= si D)
                                     (list '= (list '* (list 'CC-EXP D) (list '- p u)) (list '- q u))
                                     (list '< 0 (list 'imag-part D)) (list '< (list 'imag-part D) 'PI)))
                     (fact 'imag-part-in-rr dv)
                     (dk-split-all! (list (dk-cite! 'cc-exp-converges dv)))
                     dv)))
               segs))
         (d1 (car ds)) (d2 (cadr ds)) (d3 (caddr ds))
         (S (list '+ (list '+ d1 d2) d3))
         (Am (list '- a u)) (Bm (list '- b u)) (Cm (list '- c u)))
    (dk-have! (list '= (list 'TRI-INT fu a b c) S)
      (lambda () (mac 'TRI-INT)
                 (for-each (lambda (pq dv) (subst (list '= (list 'SEG-INT fu (car pq) (cadr pq)) dv))) segs ds)
                 (if (not (proof-done? *ps*)) (rfl))))
    (an-cc! S) (an-cc! (list '+ d1 d2))
    (dk-split-all! (list (dk-cite! 'cc-exp-converges S))) (dk-split-all! (list (dk-cite! 'cc-exp-converges (list '+ d1 d2))))
    (dk-cite! 'cc-exp-add (list '+ d1 d2) d3) (dk-cite! 'cc-exp-add d1 d2)
    (an-cc! Am) (an-cc! Bm) (an-cc! Cm)
    (dk-have! (list '= (list '* (list 'CC-EXP S) Am) Am)
      (lambda ()
        (subst (list '= (list 'CC-EXP S) (list '* (list 'CC-EXP (list '+ d1 d2)) (list 'CC-EXP d3))))
        (subst (list '= (list 'CC-EXP (list '+ d1 d2)) (list '* (list 'CC-EXP d1) (list 'CC-EXP d2))))
        (let* ((e1 (dk-name! (list 'CC-EXP d1) 'CC)) (e2 (dk-name! (list 'CC-EXP d2) 'CC)) (e3 (dk-name! (list 'CC-EXP d3) 'CC))
               (s1 (dk-rewrite-h! (list '= (list '* (list 'CC-EXP d1) Am) Bm) (list 'CC-EXP d1) e1))
               (s2 (dk-rewrite-h! (list '= (list '* (list 'CC-EXP d2) Bm) Cm) (list 'CC-EXP d2) e2))
               (s3 (dk-rewrite-h! (list '= (list '* (list 'CC-EXP d3) Cm) Am) (list 'CC-EXP d3) e3)))
          (subst (list '= (list 'CC-EXP d1) e1)) (subst (list '= (list 'CC-EXP d2) e2)) (subst (list '= (list 'CC-EXP d3) e3))
          (dk-have! (list '= (list '* (list '* (list '* e1 e2) e3) Am) (list '* e3 (list '* e2 (list '* e1 Am)))) (lambda () (crs)))
          (subst (list '= (list '* (list '* (list '* e1 e2) e3) Am) (list '* e3 (list '* e2 (list '* e1 Am)))))
          (subst s1) (subst s2) (subst s3)
          (if (not (proof-done? *ps*)) (rfl)))))
    ;; a - u /= 0, so exp(S) = 1
    (let ((cr1 (ao-cr Bm Am)))
      (fact 'cc-conjugate-fixes-rr 0) (dk-cite! 'cc-im-zero)
      (dk-have! (list 'NOT (list '= Am 0))
        (lambda () (di)
                   (let* ((h (dk-rewrite-h! (list '< 0 cr1) Am 0))
                          (h2 (dk-rewrite-h! h '(conjugate 0) 0)))
                     (dk-have! (list '= (list '* Bm 0) 0) (lambda () (crs)))
                     (let* ((h3 (dk-rewrite-h! h2 (list '* Bm 0) 0))
                            (h4 (dk-rewrite-h! h3 '(imag-part 0) 0)))
                       (dk-absurd! h4))))))
    (let ((x (list '- (list 'CC-EXP S) 1)))
      (an-cc! x)
      (dk-have! (list '= (list '* x Am) 0)
        (lambda () (dk-have! (list '= (list '* x Am) (list '- (list '* (list 'CC-EXP S) Am) Am)) (lambda () (crs)))
                   (subst (list '= (list '* x Am) (list '- (list '* (list 'CC-EXP S) Am) Am)))
                   (subst (list '= (list '* (list 'CC-EXP S) Am) Am)) (crs)))
      (dk-fact! 'cc-mul-zero-left x Am)
      (dk-fact! 'cc-sub-zero-eq (list 'CC-EXP S) 1))
    ;; S = n 2 pi i with n in ZZ, and 0 < Im S < 3 pi forces n = 1
    (let* ((iff (dk-cite! 'cc-exp-one-iff S))
           (ex (begin (ai iff) (dk-landed-1 (lambda () (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))
           (n (dk-skolem! ex #t))
           (Z2 '(* (* 2 PI) +i))
           (IS (list 'imag-part S)))
      (dk-split-all!)
      (fact 'zz-in-rr n)
      (fact 'cc-i-in) (an-rr! '(* 2 PI)) (fact 'rr-subset-cc '(* 2 PI)) (an-cc! Z2)
      (dk-split-all! (list (dk-cite! 'rb3-re-im-i)))
      (dk-cite! 'cc-im-real-mul n Z2) (dk-cite! 'cc-im-real-mul '(* 2 PI) '+i)
      (dk-cite! 'cc-im-add (list '+ d1 d2) d3) (dk-cite! 'cc-im-add d1 d2)
      (fact 'imag-part-in-rr S) (fact 'imag-part-in-rr (list '+ d1 d2))
      (an-rr! (list '* n 'PI))
      (let* ((t (dk-name! (list '* n 'PI) 'RR))
             (Seq (an-pick "S = n 2 pi i" (lambda (f) (and (ao-op? f '= 3) (equal? (cadr f) S) (dk-contains? f n))))))
        (dk-have! (list '= IS (list '* 2 t))
          (lambda () (subst Seq)
                     (subst (list '= (list 'imag-part (list '* n Z2)) (list '* n (list 'imag-part Z2))))
                     (subst (list '= (list 'imag-part Z2) (list '* '(* 2 PI) '(imag-part +i))))
                     (subst '(= (imag-part +i) 1))
                     (subst (list '= t (list '* n 'PI)))
                     (crs)))
        (dk-have! (list '= IS (list '+ (list '+ (list 'imag-part d1) (list 'imag-part d2)) (list 'imag-part d3)))
          (lambda () (subst (list '= IS (list '+ (list 'imag-part (list '+ d1 d2)) (list 'imag-part d3))))
                     (subst (list '= (list 'imag-part (list '+ d1 d2)) (list '+ (list 'imag-part d1) (list 'imag-part d2))))
                     (if (not (proof-done? *ps*)) (rfl))))
        (define (sum-prems)
          (append (list (list '= IS (list '* 2 t)) (list '= IS (list '+ (list '+ (list 'imag-part d1) (list 'imag-part d2)) (list 'imag-part d3))))
                  (apply append (map (lambda (dv) (list (list '< 0 (list 'imag-part dv)) (list '< (list 'imag-part dv) 'PI))) ds))))
        (dk-have! (list '< 0 t) (lambda () (apply dk-ineq! (sum-prems))))
        (dk-have! (list '< (list '* 2 t) (list '* 3 'PI)) (lambda () (apply dk-ineq! (sum-prems))))
        ;; 0 < n
        (define (prod-nonneg! x)                ; 0 <= x  ==>  0 <= x PI, named; returns the name
          (an-rr! x)
          (dk-have! '(<= 0 PI) (lambda () (dk-ineq! '(< 0 PI))))
          (an-and! (list 'IN x 'RR) '(IN PI RR)) (an-and! (list '<= 0 x) '(<= 0 PI))
          (fact 'rr-leq-mul-nonneg x 'PI)
          (an-rr! (list '* x 'PI))
          (let ((v (dk-name! (list '* x 'PI) 'RR)))
            (dk-rewrite-h! (list '<= 0 (list '* x 'PI)) (list '* x 'PI) v)
            v))
        (dk-have! (list '< 0 n)
          (lambda ()
            (use-em (list '< 0 n) (lambda () (ass))
              (lambda ()
                (dk-have! (list '<= n 0) (lambda () (use-em (list '<= n 0) (lambda () (ass))
                                                      (lambda () (dk-fact! 'rr-not-le-lt n 0) (ai (list 'NOT (list '< 0 n)))))))
                (dk-have! (list '<= 0 (list '- n)) (lambda () (dk-ineq! (list '<= n 0))))
                (let ((v (prod-nonneg! (list '- n))))
                  (dk-have! (list '= v (list '- t)) (lambda () (subst (list '= v (list '* (list '- n) 'PI))) (subst (list '= t (list '* n 'PI))) (crs)))
                  (dk-absurd! (list '<= 0 v) (list '= v (list '- t)) (list '< 0 t)))))))
        (dk-have! (list '< n 2)
          (lambda ()
            (use-em (list '< n 2) (lambda () (ass))
              (lambda ()
                (dk-have! (list '<= 2 n) (lambda () (use-em (list '<= 2 n) (lambda () (ass))
                                                      (lambda () (dk-fact! 'rr-not-le-lt 2 n) (ai (list 'NOT (list '< n 2)))))))
                (dk-have! (list '<= 0 (list '- n 2)) (lambda () (dk-ineq! (list '<= 2 n))))
                (let ((v (prod-nonneg! (list '- n 2))))
                  (dk-have! (list '= v (list '- t (list '* 2 'PI))) (lambda () (subst (list '= v (list '* (list '- n 2) 'PI))) (subst (list '= t (list '* n 'PI))) (crs)))
                  (dk-absurd! (list '<= 0 v) (list '= v (list '- t (list '* 2 'PI))) (list '< (list '* 2 t) (list '* 3 'PI)) '(< 0 PI)))))))
        (dk-have! '(IN 0 ZZ) (lambda () (type-term))) (dk-have! '(IN 2 ZZ) (lambda () (type-term)))
        (dk-fact! 'zz-lt-succ-le 0 n) (dk-fact! 'zz-lt-succ-le n 2)
        (dk-have! (list 'AND (list '<= n 1) (list '<= 1 n))
          (lambda () (dk-conj-close! (lambda () (dk-ineq! (list '<= (list '+ 0 1) n) (list '<= (list '+ n 1) 2))))))
        (an-and! (list 'IN n 'RR) '(IN 1 RR))
        (dk-fact! 'rr-leq-antisymmetric n 1)
        (subst (list '= (list 'TRI-INT fu a b c) S))
        (subst Seq)
        (subst (list '= n 1))
        (let ((zv (dk-name! Z2 'CC)))
          (subst (list '= Z2 zv))
          (crs))))))
(qed 'triangle-tri-int-interior)

;;; PROPOSITION 3.32 (interior case): the winding number of a positively oriented triangle about a
;;; point of the interior of its hull is 1.
(define aw-tri-wind '(WINDING (TRI-ROAD aoa_ aob_ aoc_) (TRI-ROAD-DERIV aoa_ aob_ aoc_) 0 3 aou_))
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
  (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
  (list 'FORALL 'aou_ (list 'IMPLIES (list 'IN 'aou_ ao-int) (list '= aw-tri-wind 1))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_)
       (u (cadr (an-pick "the interior point" (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) ao-int))))))
       (fu (aw-fu u)) (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u))))
  (dk-have! (list 'IN u ao-int) (lambda () (dk-ass!)))
  (let ((pre (dk-cite! 'triangle-crosses-positive a b c)))
    (dk-split-all! (list (dk-apply! pre u))))
  (dk-have! (list 'IN u 'CC)
    (lambda () (dk-split-all! (dk-landed* (lambda () (mac-h 'interior-membership (list 'IN u ao-int)))))
               (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
               (subst '(= CC (PTS CC-MS))) (dk-ass!)))
  (dk-cite! 'winding-integrand-holomorphic u)
  (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
  (dk-have! (list 'SUBSET Pu 'CC)
    (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                 (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
  (for-each (lambda (pq) (dk-cite! 'seg-trace-punctured (car pq) (cadr pq) u)) (list (list a b) (list b c) (list c a)))
  (dk-cite! 'tri-int-is-line-int Pu fu a b c)
  (dk-cite! 'triangle-tri-int-interior a b c u)
  (let ((Z2 '(* (* 2 PI) +i)))
    (dk-split-all! (list (dk-cite! 'pi-pos)))
    (fact 'cc-i-in) (an-rr! '(* 2 PI)) (fact 'rr-subset-cc '(* 2 PI)) (an-cc! Z2)
    (dk-have! '(NOT (= (* 2 PI) 0)) (lambda () (di) (dk-absurd! '(= (* 2 PI) 0) '(< 0 PI))))
    (dk-have! '(NOT (= +i 0)) (lambda () (arith)))
    (dk-fact! 'cc-mul-nonzero '(* 2 PI) '+i)
    (an-and! (list 'IN Z2 'CC) (list 'NOT (list '= Z2 0)))
    (fact 'cc-recip-inverse Z2) (fact 'cc-recip-closed Z2)
    (mac 'WINDING)
    (subst (list '= (list 'LINE-INT fu '(TRI-ROAD aoa_ aob_ aoc_) '(TRI-ROAD-DERIV aoa_ aob_ aoc_) 0 3) (list 'TRI-INT fu a b c)))
    (subst (list '= (list 'TRI-INT fu a b c) Z2))
    (let* ((r (dk-name! (list 'recip Z2) 'CC))
           (inv (dk-rewrite-h! (list '= (list '* Z2 (list 'recip Z2)) 1) (list 'recip Z2) r))
           (zv (dk-name! Z2 'CC))
           (inv2 (dk-rewrite-h! inv Z2 zv)))
      (subst (list '= (list 'recip Z2) r))
      (subst (list '= Z2 zv))
      (dk-have! (list '= (list '* r zv) (list '* zv r)) (lambda () (crs)))
      (subst (list '= (list '* r zv) (list '* zv r)))
      (subst inv2)
      (if (not (proof-done? *ps*)) (rfl)))))
(qed 'triangle-winding-interior)

  

;;; ==================================================================
;;; MERGED 2026-10-30 (wave-2 integration): ch3e/ch3e-wext.scm, appended to this file.
