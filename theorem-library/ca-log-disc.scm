;;; ca-log-disc.scm -- Remark/Lemma 2.22 of the complex analysis notes on the WHOLE unit disc (CA-MONTEL,
;;; 2026-10-26).
;;;
;;;   cml-log-from-deriv        on B(1, r), r <= 1: a g with g' = 1/w and g(1) = 0 IS the principal log
;;;   log0-is-log-on-unit-ball  log w = sum c(k) (w - 1)^k on B(1, 1)  (the series (39) is log there)
;;;   cc-log-one-plus-disc      log(1 + z) = sum (-1)^(k+1) z^k / k   for |z| < 1
;;;   cc-log-one-minus-disc     log(1 - z) = - sum z^k / k            for |z| < 1
;;;
;;; The route is the notes' differentiation argument, with the derivative of log known on the whole
;;; slit plane (cc-log-deriv): h = log - g has derivative 0 on B(1, r), so it is constant there
;;; (alg-zero-deriv-ball), and h(1) = 0.  No identity theorem and no connectedness is needed: a ball
;;; is the set alg-zero-deriv-ball already handles.  For |w - 1| < 1 the ball B(1, r) with
;;; r = (1 + |w - 1|)/2 contains w, and cps-log-deriv-at-one gives the series' derivative there.
;;;
;;; Library: complex-analysis.  Load window: after theorem-library/cc-log-holomorphic (cc-log-deriv,
;;; cc-log-one-minus) and analytic-log-laws (alg-zero-deriv-ball, cps-log-deriv-at-one); nothing cites it.
(define cml-B '(BALL CC-MS 1 cmlr_))
(define cml-slit '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(define (cml-guard t) (list 'NOT (list 'AND (list '= (list 'imag-part t) 0) (list '<= (list 'real-part t) 0))))
(define (cml-close-open!)
  (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (cml-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (cml-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (cml-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))

;; y in B(1, R): land (IN y CC) and (< (magnitude (- 1 y)) R)
(define (cml-ball-pt! y R)
  (let* ((b (list 'BALL 'CC-MS 1 R))
         (iff (dk-cite! 'ball-membership 'CC-MS 1 R y))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN y b))) prop)))
    (dk-split-all! (list rhs))
    (dk-have! (list 'IN y 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
    (fact 'cc-ms-dist 1 y)
    (let ((d (list '(DIST CC-MS) 1 y)) (m (list 'magnitude (list '- 1 y))))
      (cml-cc! (list '- 1 y))
      (cml-rr! m)
      (dk-rewrite-h! (list '<= d R) d m)
      (dk-rewrite-h! (list 'NOT (list '= d R)) d m)
      (dk-have! (list '< m R) (lambda () (mac '<) (dk-conj-close! (lambda () (ass))))))))

;; y in B(1, r), r <= 1: 0 < real-part(y), the slit guard, the slit membership, y /= 0
(define (cml-slit-pt! y)
  (cml-ball-pt! y 'cmlr_)
  (let* ((m (list 'magnitude (list '- 1 y)))
         (ry (list 'real-part y))
         (dd (list '- 1 ry)))
    (dk-cite! 'cc-re-dist-le 1 y)
    (dk-cite! 'cc-re-of-real 1)
    (cml-rr! ry)
    (dk-rewrite-h! (list '<= (list 'abs (list '- '(real-part 1) ry)) m) '(real-part 1) 1)
    (cml-rr! dd)
    (dk-split-all! (list (dk-cite! 'rr-abs-le-parts dd m)))
    (dk-have! (list '< 0 ry)
      (lambda () (dk-ineq! (list '<= dd m) (list '< m 'cmlr_) '(<= cmlr_ 1))))
    (dk-have! (cml-guard y)
      (lambda ()
        (di)
        (dk-split-all!)
        (dk-absurd! (list '<= ry 0) (list '< 0 ry))))
    (dk-have! (list 'IN y cml-slit)
      (lambda () (dk-close-all! (lambda () (sep-mi)))))
    (dk-have! (list 'NOT (list '= y 0))
      (lambda ()
        (di)
        (dk-rewrite-h! (list '< 0 ry) y 0)
        (dk-cite! 'cc-re-of-real 0)
        (cml-rr! '(real-part 0))
        (dk-absurd! (list '< 0 '(real-part 0)) '(= (real-part 0) 0))))
    'ok))

;;; ----------------------------------------------------------------------
;;; the uniqueness: on B(1, r), r <= 1, g' = 1/w and g(1) = 0 make g the principal logarithm
;;; ----------------------------------------------------------------------
(define cml-H '(VNB-LAMBDA cmlx_ (BALL CC-MS 1 cmlr_) (- (CC-LOG cmlx_) (cmlg_ cmlx_))))
(define (cml-forall-B body-of) (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ cml-B) (body-of 'dkdoy_))))
(sp (make-wff (list 'FORALL 'cmlr_ (list 'IMPLIES '(IN cmlr_ RR) (list 'IMPLIES '(< 0 cmlr_) (list 'IMPLIES '(<= cmlr_ 1)
  (list 'FORALL 'cmlg_ (list 'IMPLIES (list 'IN 'cmlg_ (list 'FUN cml-B 'CC))
    (list 'IMPLIES (list 'FORALL 'cmlw_ (list 'IMPLIES (list 'IN 'cmlw_ cml-B)
                     (list 'IS-DIFF-ON 'CC-NORMED-FIELD cml-B 'cmlg_ 'cmlw_ '(recip cmlw_))))
      (list 'IMPLIES '(= (cmlg_ 1) 0)
        (list 'FORALL 'cmlz_ (list 'IMPLIES (list 'IN 'cmlz_ cml-B)
          '(= (CC-LOG cmlz_) (cmlg_ cmlz_))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(fact 'cc-is-normed-field)
(fact 'cc-one-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'rr-zero-in)
(cml-pts-cc!)
(fact 'cc-nf-carr)
(dk-have! '(IN 1 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(dk-have! '(<= 0 cmlr_) (lambda () (dk-ineq! '(< 0 cmlr_))))
(dk-have! '(NOT (= 0 cmlr_)) (lambda () (di) (dk-absurd! '(= 0 cmlr_) '(< 0 cmlr_))))
(dk-have! '(AND (IN cmlr_ RR) (AND (<= 0 cmlr_) (NOT (= 0 cmlr_)))) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'ball-is-open 'CC-MS 1 'cmlr_)
(fact 'ball-is-set 'CC-MS 1 'cmlr_)
(dk-cite! 'ball-center-in 'CC-MS 1 'cmlr_)
(dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) cml-B) (lambda () (mac 'cc-ms-open-iff) (ass)))
;; the slit facts on the ball, in the form dk-diff! asks for (proved once as a conjunction, so that no
;; claim of cml-slit-pt! is the lane's own goal: dk-have! of the goal closes it and the focus drifts)
(define (cml-slit-conj y)
  (list 'AND (list 'IN y 'CC) (list 'AND (list 'IN y cml-slit) (list 'AND (cml-guard y) (list 'NOT (list '= y 0))))))
(define cml-all-slit
  (begin
    (dk-have! (cml-forall-B cml-slit-conj)
      (lambda () (let ((y (dk-di-var!))) (cml-slit-pt! y) (dk-conj-close! (lambda () (ass))))))
    (cml-forall-B cml-slit-conj)))
(define (cml-from-slit! part)
  (dk-have! (cml-forall-B part)
    (lambda ()
      (let ((y (dk-di-var!)))
        (dk-split-all! (list (dk-apply! cml-all-slit y)))
        (ass)))))
(cml-from-slit! (lambda (y) (list 'IN y cml-slit)))
(cml-from-slit! cml-guard)
(cml-from-slit! (lambda (y) (list 'NOT (list '= y 0))))
(define cml-dg (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DIFF-ON))) "g'"))
(dk-have! (cml-forall-B (lambda (w) (list 'IS-DIFF-ON 'CC-NORMED-FIELD cml-B cml-H w 0)))
  (lambda ()
    (let ((w (dk-di-var!)))
      (dk-apply! cml-dg w)
      (cml-ball-pt! w 'cmlr_)
      (dk-diff!))))
;; H is a function on the ball, constant there, and H(1) = 0
(define (cml-log-typ! x)                   ; x in B: (IN (CC-LOG x) CC), (IN (cmlg_ x) CC)
  (dk-split-all! (list (dk-apply! cml-all-slit x)))
  (dk-split-all! (list (dk-cite! 'cc-log-in-slit x)))
  (fact 'fun-apply-type-c 'cmlg_ cml-B 'CC x))
(dk-have! (list 'IN cml-H (list 'FUN cml-B 'CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (cml-log-typ! x)
          (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
          (cml-close-open!))))))
(define cml-hz (dk-apply! (dk-cite! 'alg-zero-deriv-ball 1 'cmlr_ cml-H) 'cmlz_))
(cml-log-typ! 'cmlz_)
(cml-log-typ! 1)
(dk-lam-b-h! cml-hz)
(define cml-A '(CC-LOG cmlz_))
(define cml-gz '(cmlg_ cmlz_))
(define cml-eq (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list '- cml-A cml-gz)))) "h(z) = h(1)"))
(fact 'cc-log-one)
(dk-rewrite-h! cml-eq '(CC-LOG 1) 0)
(dk-rewrite-h! (list '= (list '- cml-A cml-gz) '(- 0 (cmlg_ 1))) '(cmlg_ 1) 0)
(cml-cc! (list '- cml-A cml-gz))
(cml-cc! (list '+ (list '- cml-A cml-gz) cml-gz))
(dk-have! (list '= cml-A (list '+ (list '- cml-A cml-gz) cml-gz)) (lambda () (crs)))
(subst (list '= cml-A (list '+ (list '- cml-A cml-gz) cml-gz)))
(subst (list '= (list '- cml-A cml-gz) '(- 0 0)))
(crs)
(qed 'cc-log-of-deriv-on-ball)
(topic! 'cc-log-of-deriv-on-ball 'analysis)

;;; ----------------------------------------------------------------------
;;; the series (39) is the principal log on all of B(1, 1)
;;; ----------------------------------------------------------------------
(define cml-lv0 '(= (algc_ 0) 0))
(define cml-lv1 '(FORALL algj_ (IMPLIES (IN algj_ NN) (= (algc_ (succ algj_)) (* (power -1 algj_) (recip (succ algj_)))))))
(define (cml-log-hyps concl)
  (list 'FORALL 'algc_ (list 'IMPLIES '(IN algc_ (FUN NN CC)) (list 'IMPLIES cml-lv0 (list 'IMPLIES cml-lv1 concl)))))
(define (cml-psum g z) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list g 'cpsk_) (list 'power z 'cpsk_))))
(define (cml-chain! ch)            ; detach an implication chain, conjunctive antecedents on a lane
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

(sp (make-wff (cml-log-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES '(IN algz_ (BALL CC-MS 1 1))
    (list '= '(CC-LOG algz_) (list 'CC-SERIES-LIMIT (cml-psum 'algc_ '(- algz_ 1)))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(fact 'cc-is-normed-field)
(fact 'cc-one-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
(cml-pts-cc!)
(dk-have! '(IN 1 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(cml-ball-pt! 'algz_ 1)
(define cml-m '(magnitude (- 1 algz_)))
(fact 'cc-magnitude-nonneg '(- 1 algz_))
(cml-rr! (list '* 1/2 (list '+ 1 cml-m)))
(define cml-v (dk-name! (list '* 1/2 (list '+ 1 cml-m))))
(define cml-ve (list '= cml-v (list '* 1/2 (list '+ 1 cml-m))))
(dk-have! (list '< 0 cml-v) (lambda () (dk-ineq! cml-ve (list '<= 0 cml-m))))
(dk-have! (list '< cml-v 1) (lambda () (dk-ineq! cml-ve (list '< cml-m 1))))
(dk-have! (list '<= cml-v 1) (lambda () (dk-ineq! (list '< cml-v 1))))
(dk-have! (list '<= 0 cml-v) (lambda () (dk-ineq! (list '< 0 cml-v))))
(dk-have! (list '< cml-m cml-v) (lambda () (dk-ineq! cml-ve (list '< cml-m 1))))
(define cml-Bv (list 'BALL 'CC-MS 1 cml-v))
;; z in B(1, v)
(fact 'cc-ms-dist 1 'algz_)
(dk-have! (list '<= (list '(DIST CC-MS) 1 'algz_) cml-m)
  (lambda () (subst (list '== (list '(DIST CC-MS) 1 'algz_) cml-m)) (dk-ineq!)))
(dk-have! '(IN algz_ (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(cml-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 1 'algz_ cml-m cml-v))
;; G, the series about 1 on B(1, v): typed, derivative 1/w, G(1) = 0
(cml-chain! (dk-fact! 'cps-log-radius 'algc_ cml-v))
(define cml-hol (cml-chain! (dk-fact! 'cps-translate-holomorphic 'algc_ 1 cml-v)))
(define cml-sG (caddr cml-hol))
(define cml-Gt (dk-cite! 'holomorphic-on-in-fun cml-Bv cml-sG))
(cml-chain! (dk-fact! 'cps-log-deriv-at-one 'algc_ cml-v))
(dk-have! (list 'NOT (list '= 0 cml-v)) (lambda () (di) (dk-absurd! (list '= 0 cml-v) (list '< 0 cml-v))))
(cml-chain! (dk-fact! 'ball-center-in 'CC-MS 1 cml-v))
(dk-have! (list '= (list cml-sG 1) 0)
  (lambda ()
    (dk-lam-b!)
    (dk-have! '(= (- 1 1) 0) (lambda () (arith)))
    (subst '(= (- 1 1) 0))
    (dk-split-all! (list (dk-cite! 'cps-sum-at-zero 'algc_)))
    (subst (list '= (list 'CC-SERIES-LIMIT (cml-psum 'algc_ 0)) '(algc_ 0)))
    (subst cml-lv0)
    (rfl)))
(define cml-fin (dk-apply! (cml-chain! (dk-fact! 'cc-log-of-deriv-on-ball cml-v cml-sG)) 'algz_))
(dk-lam-b-h! cml-fin)
(ass)
(qed 'log0-is-log-on-unit-ball)
(topic! 'log0-is-log-on-unit-ball 'analysis)

;;; ----------------------------------------------------------------------
;;; REMARK 2.22 on the unit disc: log(1 + z) = sum_{k>=1} (-1)^(k+1) z^k / k for |z| < 1
;;; (cc-log-one-plus's driver, with log0-is-log-on-unit-ball for log0-is-log-on-ball)
;;; ----------------------------------------------------------------------
(sp (make-wff (cml-log-hyps
  (list 'FORALL 'algz_ (list 'IMPLIES '(IN algz_ CC) (list 'IMPLIES '(< (magnitude algz_) 1)
    (list '= '(CC-LOG (+ 1 algz_)) (list 'CC-SERIES-LIMIT (cml-psum 'algc_ 'algz_)))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(fact 'cc-is-normed-field)
(fact 'cc-one-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'rr-zero-in)
(cml-pts-cc!)
(define cml-op-v '(+ 1 algz_))
(cml-cc! cml-op-v)
(dk-have! '(IN 1 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(dk-have! (list 'IN cml-op-v '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(cml-rr! '(magnitude algz_))
(fact 'cc-ms-dist 1 cml-op-v)
(cml-cc! (list '- 1 cml-op-v))
(cml-cc! '(- algz_))
(dk-have! (list '<= (list '(DIST CC-MS) 1 cml-op-v) '(magnitude algz_))
  (lambda ()
    (subst (list '== (list '(DIST CC-MS) 1 cml-op-v) (list 'magnitude (list '- 1 cml-op-v))))
    (dk-have! (list '= (list '- 1 cml-op-v) '(- algz_)) (lambda () (crs)))
    (subst (list '= (list '- 1 cml-op-v) '(- algz_)))
    (subst (dk-fact! 'cc-magnitude-neg 'algz_))
    (dk-ineq!)))
(cml-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 1 cml-op-v '(magnitude algz_) 1))
(dk-apply! (cml-chain! (dk-fact! 'log0-is-log-on-unit-ball 'algc_)) cml-op-v)
(cml-cc! (list '- cml-op-v 1))
(dk-have! (list '= (list '- cml-op-v 1) 'algz_) (lambda () (crs)))
(dk-congr! (list '= (list '- cml-op-v 1) 'algz_) (lambda (u) (list 'CC-SERIES-LIMIT (cml-psum 'algc_ u))) '==)
(subst (list '= (list 'CC-SERIES-LIMIT (cml-psum 'algc_ 'algz_)) (list 'CC-SERIES-LIMIT (cml-psum 'algc_ (list '- cml-op-v 1)))))
(ass)
(qed 'cc-log-one-plus-disc)
(topic! 'cc-log-one-plus-disc 'analysis)

;;; ----------------------------------------------------------------------
;;; REMARK 2.22, the first identity, on the unit disc: log(1 - z) = - sum_{k>=1} z^k / k for |z| < 1.
;;; cc-log-one-minus's driver (cc-log-holomorphic.scm) with cc-log-one-plus-disc for cc-log-one-plus;
;;; the helpers it calls are copied from that file, prefix clh- renamed cmo-.
;;; ----------------------------------------------------------------------
(define (cmo-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cmo-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (cmo-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((eqv? t 1) (fact 'nn-one-in) typ)
          ((and (exact-nonnegative-integer? t)) (dk-have! typ (lambda () (arith))) typ)
          ((cmo-op? t 'succ 2) (cmo-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          ((or (cmo-op? t '+ 3) (cmo-op? t '* 3))
           (cmo-nn-typ! (cadr t)) (cmo-nn-typ! (caddr t))
           (cmo-and! (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN))
           (fact (if (eq? (car t) '+) 'nn-add-closed 'nn-mul-closed) (cadr t) (caddr t)) typ)
          (#t (error "cmo-nn-typ!: cannot type" (expression->string t))))))
(define (cmo-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((and (number? t) (exact-rational? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (pair? t) (cmo-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((cmo-op? t 'FACTORIAL 2)
           (cmo-nn-typ! (cadr t))
           (dk-split-all! (list (dk-fact! 'factorial-real-pos (cadr t)))) typ)
          ((or (cmo-op? t 'succ 2) (and (cmo-op? t '+ 3) (dk-asm? (list 'IN (cadr t) 'NN))
                                         (dk-asm? (list 'IN (caddr t) 'NN))))
           (cmo-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((and (cmo-op? t 'recip 2) (cmo-op? (cadr t) 'FACTORIAL 2))
           (cmo-nn-typ! (cadr (cadr t))) (fact 'recip-factorial-in-rr (cadr (cadr t))) typ)
          ((cmo-op? t 'recip 2)
           (cmo-rr-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cmo-rr-typ!: recip of a term not known nonzero" (expression->string t)))
           (cmo-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t)) typ)
          ((cmo-op? t '* 3) (cmo-rr-typ! (cadr t)) (cmo-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cmo-op? t '+ 3) (cmo-rr-typ! (cadr t)) (cmo-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((cmo-op? t '- 3) (cmo-rr-typ! (cadr t)) (cmo-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((cmo-op? t '- 2) (cmo-rr-typ! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((cmo-op? t 'real-part 2) (cmo-cc-typ! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((cmo-op? t 'imag-part 2) (cmo-cc-typ! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((cmo-op? t 'power 3) (cmo-rr-typ! (cadr t)) (cmo-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((cmo-op? t 'magnitude 2) (cmo-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cmo-op? t 'abs 2) (cmo-rr-typ! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((cmo-op? t 'LOG 2) (cmo-rr-typ! (cadr t)) (fact 'log-in-rr (cadr t)) typ)
          ((cmo-op? t 'R-EXP 2) (cmo-rr-typ! (cadr t)) (fact 'r-exp-in-rr (cadr t)) typ)
          ((cmo-op? t 'RECIP-STAR 2) (cmo-rr-typ! (cadr t)) (fact 'recip-star-in-rr (cadr t)) typ)
          ((cmo-op? t 'CC-EXP 2) (cmo-exp-rr! (cadr t)) typ)
          ((or (cmo-op? t 'CC-COS 2) (cmo-op? t 'CC-SIN 2))
           (cmo-rr-typ! (cadr t)) (dk-split-all! (list (dk-cite! 'cc-cos-sin-real (cadr t)))) typ)
          ((eq? t 'PI) (cmo-pi-typ!) typ)
          (#t (error "cmo-rr-typ!: cannot type" (expression->string t))))))
(define (cmo-real? t)
  (or (and (number? t) (exact-rational? t))
      (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
      (cmo-op? t 'succ 2) (cmo-op? t 'FACTORIAL 2) (cmo-op? t 'magnitude 2) (cmo-op? t 'abs 2) (cmo-op? t 'real-part 2) (cmo-op? t 'imag-part 2)
      (and (cmo-op? t 'recip 2) (cmo-op? (cadr t) 'FACTORIAL 2))
      (and (memq (dk-head t) '(* + -)) (= (length t) 3) (cmo-real? (cadr t)) (cmo-real? (caddr t)))
      (and (cmo-op? t 'power 3) (cmo-real? (cadr t)))))
(define (cmo-ground? t)
  (or (number? t)
      (and (pair? t) (memq (car t) '(+ - * recip)) (every cmo-ground? (cdr t)))))
(define (cmo-fun-dom f)
  (let ((hit (find-first (lambda (a) (and (cmo-op? a 'IN 3) (equal? (cadr a) f)
                                          (cmo-op? (caddr a) 'FUN 3) (eq? (caddr (caddr a)) 'CC)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
(define (cmo-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((and (pair? t) (cmo-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (number? t) (exact-rational? t)) (cmo-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((cmo-real? t) (cmo-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
           (cmo-nn-typ! (cadr t)) (fact 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) typ)
          ((and (pair? t) (= (length t) 2) (cmo-fun-dom (car t)))
           (let ((dom (cmo-fun-dom (car t))))
             (if (eq? dom 'NN) (cmo-nn-typ! (cadr t)))
             (if (eq? dom 'CC) (cmo-cc-typ! (cadr t)))
             (fact 'fun-apply-type-c (car t) dom 'CC (cadr t)) typ))
          ((cmo-op? t 'CC-EXP 2) (cmo-exp-typ! (cadr t)) typ)
          ((cmo-op? t 'CC-COS 2) (cmo-cos-typ! (cadr t)) typ)
          ((cmo-op? t 'CC-SIN 2) (cmo-sin-typ! (cadr t)) typ)
          ((and (cmo-op? t 'CC-SERIES-PARTIAL-SUM 3) (dk-asm? (list 'IN (cadr t) '(FUN NN CC))))
           (cmo-nn-typ! (caddr t)) (fact 'cc-series-partial-sum-in-cc (caddr t) (cadr t)) typ)
          ((and (cmo-op? t 'CC-SERIES-LIMIT 2) (dk-asm? (list 'CC-SERIES-CONVERGES (cadr t))))
           (fact 'cc-series-limit-in-cc (cadr t)) typ)
          ((cmo-op? t '* 3) (cmo-cc-typ! (cadr t)) (cmo-cc-typ! (caddr t))
           (cmo-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cmo-op? t '+ 3) (cmo-cc-typ! (cadr t)) (cmo-cc-typ! (caddr t))
           (cmo-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cmo-op? t '- 3) (cmo-cc-typ! (cadr t)) (cmo-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cmo-op? t '- 2) (cmo-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((cmo-op? t 'conjugate 2) (cmo-cc-typ! (cadr t)) (fact 'cc-conjugate-closed (cadr t)) typ)
          ((cmo-op? t 'power 3) (cmo-cc-typ! (cadr t)) (cmo-nn-typ! (caddr t))
           (cmo-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cmo-op? t 'recip 2)
           (cmo-cc-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cmo-cc-typ!: recip of a term not known nonzero" (expression->string t)))
           (cmo-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "cmo-cc-typ!: cannot type" (expression->string t))))))
(define (cmo-lam-typ! lam dom cod typer)
  (let ((typ (list 'IN lam (list 'FUN dom cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (typer j)
                  (if (not (sequent-node-grounded? leaf)) (ass))))))))
    typ))
(define (cmo-beta! closer)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (closer))))
(define (cmo-ring-id! vars body terms)
  (let ((gen (let build ((vs vars))
               (if (null? vs) body
                   (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) (build (cdr vs))))))))
    (if (not (dk-asm? gen)) (dk-have! gen (lambda () (dk-peel!) (crs))))
    (for-each cmo-cc-typ! terms)
    (apply dk-apply! (dk-ctx-form gen) terms)))
(define (cmo-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (cmo-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))
(define (cmo-exp-typ! z)
  (cmo-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC)))
      (dk-split-all! (list (dk-fact! 'cc-exp-converges z)))))
(define (cmo-cos-typ! z)
  (cmo-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-COS z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-cos-converges z)))))
(define (cmo-sin-typ! z)
  (cmo-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-SIN z) 'CC))) (dk-split-all! (list (dk-fact! 'cc-sin-converges z)))))
(define (cmo-exp-rr! t)                 ; (IN (CC-EXP t) RR) and (IN (CC-EXP t) CC), t typed in RR
  (cmo-rr-typ! t) (fact 'rr-subset-cc t)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP t) 'RR))) (fact 'cc-exp-real-valued t))
  (cmo-exp-typ! t))
(define (cmo-pi-typ!)
  (if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
  (fact 'rr-subset-cc 'PI))
(define (cmo-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (cmo-ms-setup!)
  (fact 'cc-is-metric-space)
  (fact 'cc-is-normed-field)
  (fact 'cc-zero-in)
  (cmo-pts-cc!))
(define (cmo-rad-facts! rad)
  (if (not (dk-asm? (list '<= 0 rad))) (dk-have! (list '<= 0 rad) (lambda () (dk-ineq! (list '< 0 rad)))))
  (if (not (dk-asm? (list 'NOT (list '= 0 rad))))
      (dk-have! (list 'NOT (list '= 0 rad)) (lambda () (di) (cmo-absurd! (list '= 0 rad) (list '< 0 rad))))))
(define (cmo-succ-nz! j)                 ; (NOT (= (succ j) 0)), j in NN
  (let ((f (list 'NOT (list '= (list 'succ j) 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (cmo-rr-typ! (list 'succ j))
            (fact 'nn-one-le-succ j)
            (fact 'rr-zero-in)
            (di)
            (cmo-absurd! (list '= (list 'succ j) 0) (list '<= 1 (list 'succ j))))))
    f))
(define cmo-lv1 '(FORALL algj_ (IMPLIES (IN algj_ NN) (= (algc_ (succ algj_)) (* (power -1 algj_) (recip (succ algj_)))))))
(define cmo-coef-ve #f)
(define (cmo-log-coefs!)
  (let* ((body (lambda (v) (list '* (list '- (list 'power -1 v)) (list 'RECIP-STAR v))))
         (ab (dk-abstract! 'NN 'CC body
               (lambda (v)
                 (cmo-rr-typ! (list 'RECIP-STAR v))
                 (fact 'rr-subset-cc (list 'RECIP-STAR v))
                 (cmo-cc-typ! (body v))
                 (ass))))
         (c (car ab)) (ve (cdr ab)))
    (set! cmo-coef-ve ve)
    (cmo-cc-typ! -1)
    (dk-have! (list '= (list c 0) 0)
      (lambda ()
        (fact 'nn-zero-in)
        (cmo-cc-typ! '(- (power -1 0)))
        (subst (dk-apply! ve 0))
        (subst (dk-fact! 'recip-star-zero))
        (subst (cmo-ring-id! '(clhu_) '(= (* clhu_ 0) 0) (list '(- (power -1 0)))))
        (rfl)))
    (dk-have! (subst-free 'algc_ c cmo-lv1)
      (lambda ()
        (let* ((j (dk-di-var!)) (sj (list 'succ j)) (a (list 'power -1 j)) (rj (list 'recip sj)))
          (cmo-nn-typ! sj)
          (cmo-succ-nz! j)
          (cmo-rr-typ! sj) (cmo-rr-typ! rj) (fact 'rr-subset-cc rj)
          (cmo-cc-typ! a)
          (cmo-and! (list 'IN -1 'CC) (list 'IN j 'NN))
          (subst (dk-apply! ve sj))
          (subst (dk-fact! 'power-succ -1 j))
          (subst (cmo-chain! (dk-fact! 'recip-star-value sj)))
          (subst (cmo-ring-id! '(clhu_ clhv_) '(= (* (- (* -1 clhu_)) clhv_) (* clhu_ clhv_)) (list a rj)))
          (rfl))))
    c))
(define cmo-om-f '(VNB-LAMBDA clhk_ NN (* (RECIP-STAR clhk_) (power clhz_ clhk_))))

(define cmo-om-f '(VNB-LAMBDA clhk_ NN (* (RECIP-STAR clhk_) (power clhz_ clhk_))))
(sp (make-wff (list 'FORALL 'clhz_ (list 'IMPLIES '(IN clhz_ CC) (list 'IMPLIES '(< (magnitude clhz_) 1)
    (list '= '(CC-LOG (- 1 clhz_)) (list '- (list 'CC-SERIES-LIMIT cmo-om-f))))))))
(dk-peel!)
(cmo-ms-setup!)
(fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
(define cmo-om-c (cmo-log-coefs!))
(define cmo-om-ve cmo-coef-ve)
(let* ((z 'clhz_) (mz '(- clhz_)) (c cmo-om-c) (ve cmo-om-ve)
       (h0 (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list c 'cpsk_) (list 'power mz 'cpsk_))))
       (f cmo-om-f) (L0 (list 'CC-SERIES-LIMIT h0)) (Lf (list 'CC-SERIES-LIMIT f))
       (t '(magnitude clhz_)) (mt (list 'magnitude mz)))
  (cmo-cc-typ! mz) (cmo-cc-typ! -1)
  (cmo-rr-typ! t) (cmo-rr-typ! mt)
  (fact 'cc-magnitude-neg z)
  (fact 'cc-magnitude-nonneg mz)
  (dk-have! (list '< mt 1) (lambda () (dk-ineq! (list '= mt t) (list '< t 1))))
  (cmo-chain! (dk-apply! (cmo-chain! (dk-fact! 'cc-log-one-plus-disc c)) mz))
  ;; the series at -z converges (its point lies in the closed ball of radius |z| < 1)
  (cmo-chain! (dk-fact! 'cps-log-radius c mt))
  (fact 'cc-ms-dist 0 mz)
  (cmo-cc-typ! (list '- 0 mz))
  (dk-have! (list 'IN mz (list 'CLOSED-BALL 'CC-MS 0 mt))
    (lambda ()
      (mac 'closed-ball-membership)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (subst '(== (PTS CC-MS) CC)) (ass))
              (begin
                (subst (list '== (list '(DIST CC-MS) 0 mz) (list 'magnitude (list '- 0 mz))))
                (dk-have! (list '= (list '- 0 mz) (list '- mz)) (lambda () (crs)))
                (subst (list '= (list '- 0 mz) (list '- mz)))
                (subst (dk-fact! 'cc-magnitude-neg mz))
                (dk-ineq!)))))))
  (dk-apply! (cmo-chain! (dk-fact! 'cps-converges-closed-ball c mt)) mz)
  (cmo-lam-typ! h0 'NN 'CC (lambda (k) (cmo-cc-typ! (list '* (list c k) (list 'power mz k)))))
  (cmo-lam-typ! f 'NN 'CC
    (lambda (k)
      (cmo-rr-typ! (list 'RECIP-STAR k)) (fact 'rr-subset-cc (list 'RECIP-STAR k))
      (cmo-cc-typ! (list '* (list 'RECIP-STAR k) (list 'power z k)))))
  (fact 'cc-series-limit-in-cc h0)
  ;; the terms: z^k/k = -1 . c(k) (-z)^k + 0 . c(k) (-z)^k
  (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
              (list '= (list f 'cpdj_) (list '+ (list '* -1 (list h0 'cpdj_)) (list '* 0 (list h0 'cpdj_))))))
    (lambda ()
      (let* ((j (dk-di-var!)) (P (list 'power -1 j)) (Zj (list 'power z j)) (RS (list 'RECIP-STAR j))
             (mzj (list 'power mz j)) (m1z (list '* -1 z)))
        (cmo-rr-typ! RS) (fact 'rr-subset-cc RS)
        (cmo-cc-typ! P) (cmo-cc-typ! Zj) (cmo-cc-typ! mzj) (cmo-cc-typ! m1z)
        (cmo-cc-typ! (list 'power m1z j)) (cmo-cc-typ! (list '* -1 -1)) (cmo-cc-typ! (list 'power (list '* -1 -1) j))
        (cmo-cc-typ! (list 'power 1 j)) (cmo-cc-typ! (list '* P P))
        (dk-have! (list '= mz m1z) (lambda () (crs)))
        (dk-congr! (list '= mz m1z) (lambda (u) (list 'power u j)))
        (fact 'cc-power-mul-base j -1 z)
        (fact 'cc-power-mul-base j -1 -1)
        (dk-have! '(= (* -1 -1) 1) (lambda () (arith)))
        (dk-congr! '(= (* -1 -1) 1) (lambda (u) (list 'power u j)))
        (fact 'rr-power-one j)
        (dk-have! (list '= (list '* P P) 1)
          (lambda ()
            (subst (list '= (list '* P P) (list 'power (list '* -1 -1) j)))
            (subst (list '= (list 'power (list '* -1 -1) j) (list 'power 1 j)))
            (subst (list '= (list 'power 1 j) 1))
            (rfl)))
        (cmo-beta!
          (lambda ()
            (subst (dk-apply! ve j))
            (subst (list '= mzj (list 'power m1z j)))
            (subst (list '= (list 'power m1z j) (list '* P Zj)))
            (subst (cmo-ring-id! '(clhu_ clhv_ clhq_)
                     '(= (+ (* -1 (* (* (- clhu_) clhv_) (* clhu_ clhq_))) (* 0 (* (* (- clhu_) clhv_) (* clhu_ clhq_))))
                         (* (* clhu_ clhu_) (* clhv_ clhq_)))
                     (list P RS Zj)))
            (subst (list '= (list '* P P) 1))
            (crs))))))
  (dk-split-all! (list (cmo-chain! (dk-fact! 'cc-series-limit-linear h0 h0 f -1 0))))
  (cmo-cc-typ! '(+ 1 (- clhz_)))
  (dk-have! (list '= '(- 1 clhz_) '(+ 1 (- clhz_))) (lambda () (crs)))
  (dk-congr! (list '= '(- 1 clhz_) '(+ 1 (- clhz_))) (lambda (u) (list 'CC-LOG u)))
  (subst (list '= '(CC-LOG (- 1 clhz_)) '(CC-LOG (+ 1 (- clhz_)))))
  (subst (list '= '(CC-LOG (+ 1 (- clhz_))) L0))
  (subst (list '= Lf (list '+ (list '* -1 L0) (list '* 0 L0))))
  (crs))
(qed 'cc-log-one-minus-disc)
(topic! 'cc-log-one-minus-disc 'analysis)

