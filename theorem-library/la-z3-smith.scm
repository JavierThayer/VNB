(define LZ3-UAV '(MATMUL ZZ-RING (MATMUL ZZ-RING U A) V))
(sp (make-wff (forall-guarded '(m n A) '((IN m NN) (IN n NN) (IN A (MAT m n ZZ)))
  (list 'FORSOME 'U (list 'AND '(IN U (ELEM-GEN ZZ-RING m))
    (list 'FORSOME 'V (list 'AND '(IN V (ELEM-GEN ZZ-RING n))
      (lz3-and (lz3-nf LZ3-UAV 'm 'n)))))))))
(dk-peel!)
