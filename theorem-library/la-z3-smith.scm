              (lambda ()
                (if (dk-contains? (dk-goal) prod) (subst (list '= prod d)))
                (ass))))
          (ass)))))
(lz3-done! 'integer-normal-form-elementary)
(topic! 'integer-normal-form-elementary 'algebra)
(gloss! 'integer-normal-form-elementary "Linear algebra 3.37: for an integer matrix A there are products U, V of elementary matrices with U A V diagonal, its diagonal entries non-negative and each dividing the next.")

(sp (make-wff (forall-guarded '(m n A) '((IN m NN) (IN n NN) (IN A (MAT m n ZZ)))
  (list 'FORSOME 'D (lz3-and (append (list '(IN D (MAT m n ZZ)) '(ELEM-EQUIV ZZ-RING m n A D)) (lz3-nf 'D 'm 'n)))))))
