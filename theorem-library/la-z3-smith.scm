;;; =====================================================================
;;; (9) A spanning sequence of a submodule can be lengthened by zeros.
;;; =====================================================================
(define (lz3-pad-body j)
  (forall-guarded '(md sm k w)
    (list '(IS-MODULE md) '(IS-SUBMODULE md sm) '(IN k NN) '(IN w (MAT k 1 (VEC md))) '(SPANS md k w sm)
          (list '<= 'k j))
