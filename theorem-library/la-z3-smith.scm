;;; la-z3-smith.scm -- linear algebra 3.36 (existence) and 3.37 in general: every
;;; integer matrix is equivalent, by integral elementary operations, to a diagonal
;;; matrix with non-negative diagonal entries forming a divisibility chain
;;; (LA-Z3, 2026-10-24).  Prefix lz3-.
;;;
;;; PLAN (the notes' proof of 3.36, induction on the number of rows).
;;;  (1) smith-pivot-cross-minimal: clear-pivot-cross, keeping the class minimality of
;;;      the pivot (classmin-transport once more after the column is cleared).
;;;  (2) smith-pivot-divides-block: a class-minimal pivot b of a matrix in border form
;;;      divides every entry w of the block.  Otherwise w = q b + r with r /= 0 of
;;;      smaller gauge; adding row i+1 to row 1 and then -q times column 1 to column
;;;      j+1 puts r at (1, j+1) of an equivalent matrix, against the minimality.
;;;  (3) smith-equiv-divisor: a common divisor of the entries survives MAT-EQUIV over a
;;;      euclidean ring (the order-1 subdeterminants, sdet-divisor-equiv, 3.31's lemma).
;;;  (4) border-scale-row: H[sc, 1] BORDER(b, E) = BORDER(sc b, E) (the sign fix).
;;;  (5) border-normal-form: BORDER(b, E) is in normal form when E is, b >= 0 and b
;;;      divides the entries of E.
;;;  (6) integer-normal-form-mat-equiv: the induction (smith-diagonalization's skeleton).
;;;  (7) 3.37 / 3.36: invertible integer matrices are products of elementary matrices
;;;      (euclidean-invertible-iff-elem-gen), so MAT-EQUIV is ELEM-EQUIV.
;;;
;;;  (8) elem-equiv-trans; integer-normal-form (3.36: existence and uniqueness, the
;;;      uniqueness by la-z2-diag's diagonal-normal-form-unique).
;;;  (9) spans-pad-zero; principal-sequence-exists (3.44) and -exists-unique (3.44 + 3.48).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z2-principal (load.scm 2186: principal-sequence-unique, and
;;; la-z2-diag's diagonal-normal-form-unique; la-z2-vocab's IS-PRINCIPAL-SEQUENCE).  The
;;; other citations are earlier: la-z-elem (euclidean-invertible-iff-elem-gen, 2173),
;;; la-z-gcd (sdet-divisor-equiv), la-z-sdet, rake-asm-b4 (rb4-, 2179), spans-transport
;;; -proof (2177), submodule-fg-proof, smith-diagonalization-proof, clear-pivot-cross
;;; machinery.  Nothing in the tree cites the file.

(define (lz3-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z3-smith: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

;;; ---------------------------------------------------------------------
;;; Helpers (la-z-elem's lze- kit, ring R).
;;; ---------------------------------------------------------------------
(define (lz3-iv n) (list 'INTERVAL 1 n))
(define (lz3-contra! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
(define (lz3-skolem-all! ex)
  (let loop ((ex ex) (acc '()))
    (let* ((v #f)
           (landed (dk-landed (lambda () (set! v (dk-skolem! ex)))))
           (nxt (find-first (dk-head? 'FORSOME) landed)))
      (if nxt (loop nxt (append acc (list v))) (append acc (list v))))))
(define (lz3-split-on! w)
  (let loop ()
    (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
      (if cj (begin (dk-split! cj) (loop))))))
(define (lz3-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lz3-cite! thm . args) (lz3-detach-all! (apply dk-cite! thm args)))
(define (lz3-open! name . args)
  (let* ((hyp (cons name args))
         (ignore (apply fact name args))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let loop ((todo (list (dk-ctx-form rhs))) (acc '()))
      (cond ((null? todo) (reverse acc))
            ((dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo)) acc))
            (#t (loop (cdr todo) (cons (car todo) acc)))))))
(define (lz3-iv-facts! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (lz3-mat-of X ring)
  (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) X)
                                        (pair? (caddr f)) (eq? (car (caddr f)) 'MAT)
                                        (equal? (cadddr (caddr f)) (list 'CARR ring))))
                       (dk-asms))))
    (if (not f) (error "lz3-mat-of: matrix not typed" (expression->string X)))
    (caddr f)))
(define (lz3-nn! e)
  (cond ((dk-asm? (list 'IN e 'NN)) #t)
        ((and (pair? e) (eq? (car e) 'succ)) (lz3-nn! (cadr e)) (fact 'nn-succ-closed (cadr e)))
        ((number? e) (dk-have! (list 'IN e 'NN) (lambda () (arith))))
        ((and (pair? e) (eq? (car e) 'NN-MINUS))
         (lz3-nn! (cadr e)) (lz3-nn! (caddr e)) (fact 'nn-minus-in-nn (cadr e) (caddr e)))
        ((symbol? e)
         (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (cadr f) e)
                                               (pair? (caddr f)) (eq? (car (caddr f)) 'INTERVAL)))
                              (dk-asms))))
           (if (not f) (error "lz3-nn!: untyped" e))
           (fact 'interval-elt-in-nn (cadr (caddr f)) (caddr (caddr f)) e)))
        (#t (error "lz3-nn!: cannot type" (expression->string e))))
  (if (not (dk-asm? (list 'IN e 'NN))) (error "lz3-nn!: did not land" (expression->string e))))
;; land (IN T (CARR RING)) for T built of ENTRY, ADD, MUL, NEG, ONE, ZERO
(define (lz3-carr! t ring)
  (let ((C (list 'CARR ring)))
    (cond ((dk-asm? (list 'IN t C)) #t)
          ((and (pair? t) (eq? (car t) 'ENTRY))
           (let ((M (lz3-mat-of (cadr t) ring)))
             (fact 'entry-in-carrier (cadr M) (caddr M) C (cadr t) (caddr t) (cadddr t))))
          ((equal? t (list 'ONE ring)) (fact 'ring-one-in ring))
          ((equal? t (list 'ZERO ring)) (fact 'ring-zero-in ring))
          ((and (pair? t) (equal? (car t) (list 'NEG ring)))
           (lz3-carr! (cadr t) ring) (fact 'ring-neg-in-carr ring (cadr t)))
          ((and (pair? t) (equal? (car t) (list 'ADD ring)))
           (lz3-carr! (cadr t) ring) (lz3-carr! (caddr t) ring)
           (fact 'ring-add-closed ring (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) (list 'MUL ring)))
           (lz3-carr! (cadr t) ring) (lz3-carr! (caddr t) ring)
           (fact 'ring-carrier-closed-mul ring (cadr t) (caddr t)))
          (#t (error "lz3-carr!: cannot type" (expression->string t))))
    (if (not (dk-asm? (list 'IN t C))) (error "lz3-carr!: did not land" (expression->string t)))))
(define (lz3-close! ring)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (lz3-carr! (cadr g) ring) (rfl))
          (#t (error "lz3-close!: cannot close" (expression->string g))))))
;; the IF resolver of la-z-elem (conditions decided by the context or syntactically)
(define (lz3-find-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)) (or (lz3-find-if (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((lz3-find-if (car l)))
                    (#t (loop (cdr l))))))))
(define (lz3-nsym! a b)
  (di)
  (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl)))
  (ai (list 'NOT (list '= b a))))
(define (lz3-if-branch! true? ift close-cond k)
  (let* ((c (cadr ift))
         (val (if true? (caddr ift) (cadddr ift)))
         (want (if true? c (list 'NOT c)))
         (opened (dk-opened (lambda () (if true? (if-true ift) (if-false ift)))))
         (conds (filter (lambda (l) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal-of l) want))))) opened))
         (mains (filter (lambda (l) (not (memq l conds))) opened)))
    (if (pair? conds)
        (begin (dk-focus! (car conds)) (if close-cond (close-cond) (ass))
               (if (not (sequent-node-grounded? (car conds)))
                   (error "lz3-if-branch!: condition not established" (expression->string want)))))
    (if (pair? mains)
        (begin (dk-focus! (car mains)) (subst (list '= ift val)) (k)))))
(define (lz3-if-all! closer)
  (let ((ift (lz3-find-if (dk-goal))))
    (if (not ift)
        (closer)
        (let* ((c (cadr ift)) (k (lambda () (lz3-if-all! closer))))
          (cond ((dk-asm? c) (lz3-if-branch! #t ift #f k))
                ((dk-asm? (list 'NOT c)) (lz3-if-branch! #f ift #f k))
                ((and (eq? (car c) '=) (equal? (cadr c) (caddr c))) (lz3-if-branch! #t ift (lambda () (rfl)) k))
                ((and (eq? (car c) '=) (dk-asm? (list 'NOT (list '= (caddr c) (cadr c)))))
                 (lz3-if-branch! #f ift (lambda () (lz3-nsym! (cadr c) (caddr c))) k))
                ((and (eq? (car c) '=) (dk-asm? (list '= (caddr c) (cadr c))))
                 (lz3-if-branch! #t ift (lambda () (subst (list '= (cadr c) (caddr c))) (rfl)) k))
                (#t (error "lz3-if-all!: undecided condition" (expression->string c))))))))
;; an equation (= LHS RHS) proved by rewriting LHS with EQS (in order) and resolving IFs
(define (lz3-euc-setup! ring)
  (fact 'euclidean-ring-is-integral-domain ring)
  (fact 'integral-domain-is-commutative-ring ring)
  (fact 'commutative-ring-is-ring ring)
  (fact 'ring-zero-in ring)
  (fact 'ring-one-in ring))
(define (lz3-gauge ring x) (list (list 'GAUGE ring) x))
(define (lz3-gauge-nn! ring x)
  (if (not (dk-asm? (list 'IN (list 'GAUGE ring) (list 'FUN (list 'CARR ring) 'NN))))
      (dk-split! (dk-fact! 'gauge-is-degree ring)))
  (lz3-carr! x ring)
  (if (not (dk-asm? (list 'IN (lz3-gauge ring x) 'NN)))
      (fact 'fun-apply-type-c (list 'GAUGE ring) (list 'CARR ring) 'NN x)))
(define (lz3-absurd! prems)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (dk-have! '(<= 1 0) (lambda () (apply dk-nn! prems)))
  (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
  (ai '(NOT (<= 1 0))))
(define (lz3-ne! a b . prems)
  (let ((f (list 'NOT (list '= a b))))
    (if (not (dk-asm? f))
        (begin (lz3-nn! a) (lz3-nn! b)
               (dk-have! f (lambda () (apply dk-nn! prems)))))))

;;; the class minimality of the pivot of X, over the (succ p, succ q) class (ring RG)
(define (lz3-pcm rg X)
  (list 'FORALL 'C (list 'IMPLIES (list 'MAT-EQUIV rg '(succ p) '(succ q) X 'C)
    (list 'FORALL 'ii (list 'FORALL 'jj
      (list 'IMPLIES (list 'IN 'ii (list 'INTERVAL 1 '(succ p)))
        (list 'IMPLIES (list 'IN 'jj (list 'INTERVAL 1 '(succ q)))
          (list 'IMPLIES (list 'NOT (list '= '(ENTRY C ii jj) (list 'ZERO rg)))
            (list '<= (list (list 'GAUGE rg) (list 'ENTRY X 1 1))
                      (list (list 'GAUGE rg) (list 'ENTRY 'C 'ii 'jj)))))))))))

