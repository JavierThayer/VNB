(define (lz3-cc-goal) (dk-goal))
(define (lz3-cc-foc-goal! pred)
  (let ((s (any-pred (lambda (s) (pred (wff-formula (sequent-node-assertion s)))) (proof-leaves))))
    (and s (dk-focus! s) s)))
(define (lz3-cc-find pred) (find-first pred (dk-asms)))
(define (lz3-H? h) (lambda (g) (and (pair? g) (eq? (car g) h))))
(define (lz3-cc-di*) (let lp () (let* ((g (dk-goal)) (h (and (pair? g) (car g))))
                       (when (memq h '(FORALL IMPLIES)) (di) (lp)))))
(define (lz3-impl* gs concl) (fold-right (lambda (g acc) (list 'IMPLIES g acc)) concl gs))
(define (lz3-fa* vs body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vs))
(define (lz3-meq-4th-is? subj z) (and (pair? z) (eq? (car z) 'MAT-EQUIV) (equal? (list-ref z 4) subj)))
(define (lz3-meq-body-of? subj z)
  (and (pair? z) (eq? (car z) 'FORSOME)
       (let ((b (caddr z))) (and (pair? b) (eq? (car b) 'AND)
         (let ((me (cadr b))) (lz3-meq-4th-is? subj me))))))
(define LZ3-SP '(succ p))
(define LZ3-SQ '(succ q))
(define (lz3-meq X Y) (list 'MAT-EQUIV 'A LZ3-SP LZ3-SQ X Y))
(define (lz3-pcmA X) (lz3-pcm 'A X))
(define LZ3-NZE
  (list 'FORSOME 'i0 (list 'FORSOME 'j0
    (list 'AND (list 'IN 'i0 (list 'INTERVAL 1 LZ3-SP))
      (list 'AND (list 'IN 'j0 (list 'INTERVAL 1 LZ3-SQ))
        (list 'NOT (list '= '(ENTRY M i0 j0) '(ZERO A))))))))

(sp (make-wff
  (list 'FORALL 'A
    (list 'IMPLIES '(IS-EUCLIDEAN-RING A)
      (lz3-fa* '(p q M)
        (lz3-impl*
          (list '(IN p NN) '(IN q NN) (list 'IN 'M (list 'MAT LZ3-SP LZ3-SQ '(CARR A))) LZ3-NZE)
          (list 'FORSOME 'C2
            (list 'AND (lz3-meq 'M 'C2)
              (list 'AND
                (list '= 'C2 (list 'BORDER 'A '(ENTRY C2 1 1) '(SUBMAT C2 p q) 'p 'q))
                (list 'AND '(NOT (= (ENTRY C2 1 1) (ZERO A)))
                  (lz3-pcmA 'C2)))))))))))
(lz3-cc-di*)
(fact 'euclidean-ring-is-integral-domain 'A)
(fact 'integral-domain-is-commutative-ring 'A)
(fact 'commutative-ring-is-ring 'A)
(fact 'one-in-interval 'p) (fact 'one-in-interval 'q)
(fact 'nn-succ-closed 'p) (fact 'nn-succ-closed 'q)
(fact 'class-min-pivot 'A LZ3-SP LZ3-SQ 'M)
(define LZ3-CMP-BODY (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORSOME) (eq? (cadr z) 'B)))))
(ai LZ3-CMP-BODY) (ai 1) (ai 1)
(define LZ3-MEQMB (lz3-cc-find (lambda (z) (lz3-meq-4th-is? 'M z))))
(define LZ3-B (list-ref LZ3-MEQMB 5))
(define LZ3-CONJ3 (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORALL) (eq? (cadr z) 'C)
               (let ((b (caddr z))) (and (pair? b) (eq? (car b) 'IMPLIES)
                 (equal? (list-ref (cadr b) 4) 'M)))))))
(cut (lz3-pcmA LZ3-B))
(lz3-cc-di*)
(let* ((ecij (cadr (caddr (dk-goal))))
       (cx (cadr ecij)) (iix (caddr ecij)) (jjx (cadddr ecij)))
  (fact 'mat-equiv-trans 'A LZ3-SP LZ3-SQ 'M LZ3-B cx)
  (inst+ LZ3-CONJ3 cx)
  (let ((fi (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORALL) (eq? (cadr z) 'i)
              (let ((b (caddr z))) (and (pair? b) (eq? (car b) 'FORALL) (eq? (cadr b) 'j))))))))
    (inst+ fi iix))
  (let ((fj (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORALL) (eq? (cadr z) 'j))))))
    (inst+ fj jjx))
  (ass))
(lz3-cc-foc-goal! (lz3-H? 'FORSOME))
(fact 'mat-equiv-target-is-mat 'A LZ3-SP LZ3-SQ 'M LZ3-B)
(fact 'clear-first-row 'A LZ3-SP LZ3-SQ LZ3-B)
(quietly (lambda () (detach! (lz3-pcmA LZ3-B))))
(define LZ3-CFR-BODY (lz3-cc-find (lambda (z) (lz3-meq-body-of? LZ3-B z))))
(ai LZ3-CFR-BODY) (ai 1) (ai 1)
(define LZ3-C1 (list-ref (lz3-cc-find (lambda (z) (lz3-meq-4th-is? LZ3-B z))) 5))
(fact 'classmin-transport 'A LZ3-SP LZ3-SQ LZ3-B LZ3-C1)
(quietly (lambda () (detach! (lz3-pcmA LZ3-B))))
(fact 'mat-equiv-target-is-mat 'A LZ3-SP LZ3-SQ LZ3-B LZ3-C1)
