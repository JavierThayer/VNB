(define LZ3-C2 (list-ref (lz3-cc-find (lambda (z) (lz3-meq-4th-is? LZ3-C1 z))) 5))
(fact 'mat-equiv-trans 'A LZ3-SP LZ3-SQ 'M LZ3-B LZ3-C1)
(fact 'mat-equiv-trans 'A LZ3-SP LZ3-SQ 'M LZ3-C1 LZ3-C2)
(fact 'mat-equiv-target-is-mat 'A LZ3-SP LZ3-SQ LZ3-C1 LZ3-C2)
;; NEW: the class minimality carried from C1 to C2
(fact 'classmin-transport 'A LZ3-SP LZ3-SQ LZ3-C1 LZ3-C2)
(quietly (lambda () (detach! (lz3-pcmA LZ3-C1))))
