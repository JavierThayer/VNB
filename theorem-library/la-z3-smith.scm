            (lz3-bnf-block! cj 'p)
            (lz3-bnf-block! cj 'q)
            (let ((cj1 (list 'NN-MINUS cj 1)))
              (dk-have! (list '<= ci1 cj1)
                (lambda () (dk-nn! (list '<= ci cj) (list '= (list 'succ ci1) ci) (list '= (list 'succ cj1) cj))))
              (subst (dk-cite! 'border-entry-block2 'ZZ-RING 'b 'E 'p 'q ci ci))
              (subst (dk-cite! 'border-entry-block2 'ZZ-RING 'b 'E 'p 'q cj cj))
              (dk-apply! (lz3-chain 'E 'p 'q) ci1 cj1)
              (ass))))))))
(dk-conj-close! (lambda () (ass)))
(lz3-done! 'border-normal-form)
(topic! 'border-normal-form 'algebra)
(gloss! 'border-normal-form "A matrix in border form [[b, 0], [0, E]] over Z is in the normal form of 3.36 when E is, b >= 0, and b divides every entry of E.")

;;; =====================================================================
;;; (6) integer-normal-form-mat-equiv: induction on the number of rows.
;;; =====================================================================
(define (lz3-inner k)
  (list 'FORALL 'n (list 'FORALL 'P
    (list 'IMPLIES '(IN n NN)
      (list 'IMPLIES (list 'IN 'P (list 'MAT k 'n '(CARR ZZ-RING)))
        (list 'FORSOME 'D
          (lz3-and (cons (list 'MAT-EQUIV 'ZZ-RING k 'n 'P 'D) (lz3-nf 'D k 'n)))))))))
(define (lz3-zmul-eq! a b)                 ; (= ((MUL ZZ-RING) a b) (* a b)), a, b in ZZ
  (let ((eq (list '= (list '(MUL ZZ-RING) a b) (list '* a b))))
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (slot 'MUL)
                       (if (not (dk-lam-b!))
                           (begin (if (not (dk-asm? (list 'IN (list '* a b) 'ZZ)))
                                      (dk-have! (list 'IN (list '* a b) 'ZZ) dk-typ-close!))
                                  (rfl))))))
    eq))
(define (lz3-zcarr! t)                     ; (IN t ZZ) from (IN t (CARR ZZ-RING))
  (if (not (dk-asm? (list 'IN t 'ZZ)))
      (dk-rewrite-h! (list 'IN t '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)))
;; a goal whose peel lands (IN x (INTERVAL 1 bnd)) with bnd empty: FALSITY from PREMS
(define (lz3-vacuous! bnd prems-of)
  (let* ((ld (dk-peel!))
         (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'INTERVAL 1 bnd)))) ld))))
    (lz3-iv-facts! x 1 bnd)
    (lz3-absurd! (append (list (list '<= 1 x) (list '<= x bnd)) (prems-of x)))))

;; split every conjunction of F (in context) to its leaves
(define (lz3-split-all! f)
  (if (dk-head-is? f 'AND)
      (for-each lz3-split-all! (dk-split! f))))
;; open ZZ-DIVIDES(D, X) in context: the cofactor c, with (IN c ZZ), (= X (* D c))
(define (lz3-zzdiv-open! d x)
  (let* ((hyp (list 'ZZ-DIVIDES d x))
         (iff (dk-cite! 'zz-divides d x))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let* ((parts (dk-split! (dk-ctx-form rhs)))
           (more (append-map (lambda (f) (if (dk-head-is? f 'AND) (dk-split! f) (list f))) parts))
           (ex (find-first (dk-head? 'FORSOME) more)))
      (dk-skolem! ex #t))))
(define (lz3-ivars ld bnd)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) (list 'INTERVAL 1 bnd)))) ld)))

;; the zero matrix case: every entry of P vanishes (else NZE holds)
(define (lz3-step-zero! sk sq P nze)
  (let ((pz! (lambda (x y)
               (let ((e (list 'ENTRY P x y)))
                 (dk-have! (list '= e '(ZERO ZZ-RING))
                   (lambda ()
                     (use-em (list '= e '(ZERO ZZ-RING))
                       (lambda () (ass))
                       (lambda ()
                         (dk-have! nze (lambda () (ew x) (ew y) (dk-conj-close! (lambda () (ass)))))
                         (lz3-contra! (list 'NOT nze))))))))))
    (ew P)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g 'MAT-EQUIV) (fact 'mat-equiv-refl 'ZZ-RING sk sq P) (ass))
                ((dk-head-is? g 'IS-DIAGONAL)
                 (mac 'IS-DIAGONAL)
                 (let* ((ld (dk-peel!))
                        (x (car (lz3-ivars ld sk))) (y (car (lz3-ivars ld sq))))
                   (pz! x y)))
                ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'i_))
                 (let* ((ld (dk-peel!)) (x (car (lz3-ivars ld sk))))
                   (pz! x x)
                   (subst (list '= (list 'ENTRY P x x) '(ZERO ZZ-RING)))
                   (subst '(= (ZERO ZZ-RING) 0))
                   (arith)))
                (#t
                 (let* ((ld (dk-peel!))
                        (le (find-first (dk-head? '<=) ld))
                        (ci (cadr le)) (cj (caddr le)))
                   (pz! ci ci) (pz! cj cj)
                   (subst (list '= (list 'ENTRY P ci ci) '(ZERO ZZ-RING)))
                   (subst (list '= (list 'ENTRY P cj cj) '(ZERO ZZ-RING)))
                   (subst '(= (ZERO ZZ-RING) 0))
                   (dk-have! '(= 0 (* 0 0)) (lambda () (arith)))
                   (lz3-zdiv-intro! 0 0 0)))))))))

;; the nonzero case: the minimal pivot, the block, the induction hypothesis, the sign
(define (lz3-step-nonzero! k qv P)
  (let* ((sk (list 'succ k)) (sq (list 'succ qv))
         (c2 (lz3-skolem-split! (dk-cite! 'smith-pivot-cross-minimal 'ZZ-RING k qv P)))
         (b (list 'ENTRY c2 1 1)) (w (list 'SUBMAT c2 k qv)))
    (fact 'mat-equiv-target-is-mat 'ZZ-RING sk sq P c2)
    (fact 'one-in-interval k) (fact 'one-in-interval qv)
    (lz3-carr! b 'ZZ-RING)
    (fact 'submat-type 'ZZ-RING k qv c2)
    (dk-cite! 'smith-pivot-divides-block 'ZZ-RING k qv c2)
    (let ((e (lz3-skolem-split! (dk-apply! LZ3-IH qv w))))
      (fact 'mat-equiv-target-is-mat 'ZZ-RING k qv w e)
      (let ((dve (dk-cite! 'smith-equiv-divisor 'ZZ-RING k qv w e b))
            (b1 (list 'BORDER 'ZZ-RING b e k qv)))
        (fact 'bordering 'ZZ-RING k qv b w c2 e)
        (fact 'border-type 'ZZ-RING b e k qv)
        (fact 'mat-equiv-trans 'ZZ-RING sk sq P c2 b1)
        (lz3-zcarr! b)
        (dk-rewrite-h! (list 'IN e (list 'MAT k qv '(CARR ZZ-RING))) '(CARR ZZ-RING) 'ZZ)
        (dk-have! (lz3-zdiv-all b e k qv)
          (lambda ()
            (let* ((ld (dk-peel!))
                   (x (car (lz3-ivars ld k))) (y (car (lz3-ivars ld qv)))
                   (yv (lz3-skolem-split! (dk-apply! dve x y))))
              (dk-cite! 'lzg-ring-to-zz b (list 'ENTRY e x y) yv)
              (ass))))
        (use-em (list '<= 0 b)
          (lambda ()
            (lz3-split-all! (dk-cite! 'border-normal-form k qv b e))
            (ew b1)
            (dk-conj-close! (lambda () (ass))))
          (lambda ()
            (let* ((nb (list '* -1 b))
                   (hm (list 'ELEM-H 'ZZ-RING sk -1 1))
                   (b2r (list '(MUL ZZ-RING) -1 b))
                   (b3 (list 'BORDER 'ZZ-RING nb e k qv)))
              (fact 'zz-in-rr b)
              (dk-have! '(IN 0 RR) (lambda () (arith)))
              (fact 'rr-not-le-lt 0 b)
              (dk-have! '(IN -1 ZZ) (lambda () (arith)))
              (dk-rewrite-h! '(IN -1 ZZ) 'ZZ '(CARR ZZ-RING))
              (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
              (let ((m11 (lz3-zmul-eq! -1 -1)))
                (dk-have! '(= ((MUL ZZ-RING) -1 -1) (ONE ZZ-RING))
                  (lambda () (subst m11) (subst '(= (ONE ZZ-RING) 1)) (arith))))
              (fact 'elem-h-type 'ZZ-RING sk -1 1)
              (fact 'elem-h-inverse 'ZZ-RING sk -1 -1 1)
              (fact 'inverse-is-invertible 'ZZ-RING sk hm hm)
              (fact 'mat-equiv-left-mult 'ZZ-RING sk sq b1 hm)
              (let* ((scale (dk-cite! 'border-scale-row 'ZZ-RING k qv b -1 e))
                     (meq2 (dk-rewrite-h! (list 'MAT-EQUIV 'ZZ-RING sk sq b1 (list 'MATMUL 'ZZ-RING hm b1))
                                          (list 'MATMUL 'ZZ-RING hm b1) (list 'BORDER 'ZZ-RING b2r e k qv)))
                     (eqb (lz3-zmul-eq! -1 b))
                     (meq3 (dk-rewrite-h! meq2 b2r nb)))
                (dk-have! (list 'IN nb 'ZZ) dk-typ-close!)
                (dk-rewrite-h! (list 'IN nb 'ZZ) 'ZZ '(CARR ZZ-RING))
                (fact 'border-type 'ZZ-RING nb e k qv)
                (fact 'mat-equiv-trans 'ZZ-RING sk sq P b1 b3)
                (dk-have! (list '<= 0 nb) (lambda () (dk-ineq! (list '< b 0))))
                (dk-have! (lz3-zdiv-all nb e k qv)
                  (lambda ()
                    (let* ((ld (dk-peel!))
                           (x (car (lz3-ivars ld k))) (y (car (lz3-ivars ld qv)))
                           (exy (list 'ENTRY e x y)))
                      (dk-apply! (lz3-zdiv-all b e k qv) x y)
                      (fact 'entry-in-carrier k qv 'ZZ e x y)
                      (let* ((cv (lz3-zzdiv-open! b exy))
                             (nc (list '* -1 cv)))
                        (dk-have! (list 'IN nc 'ZZ) dk-typ-close!)
                        (dk-have! (list '= exy (list '* nb nc))
                          (lambda () (subst (list '= exy (list '* b cv))) (crs)))
                        (lz3-zdiv-intro! nb exy nc)))))
                (lz3-split-all! (dk-cite! 'border-normal-form k qv nb e))
                (ew b3)
                (dk-conj-close! (lambda () (ass)))))))))))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (lz3-inner 'k)))))
(lz3-zsetup!)
(fact 'nn-one-in)
(dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
(dk-have! '(IN 0 ZZ) (lambda () (arith)))
(define LZ3-IND (use-induction))
;; ---- base: no rows ----
(dk-focus! (cdr (assq 'base LZ3-IND)))
(let* ((ld (dk-peel!))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld)))
       (P (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'MAT))) ld))))
  (ew P)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'MAT-EQUIV) (fact 'mat-equiv-refl 'ZZ-RING 0 n P) (ass))
              ((dk-head-is? g 'IS-DIAGONAL) (mac 'IS-DIAGONAL) (lz3-vacuous! 0 (lambda (x) '())))
              (#t (lz3-vacuous! 0 (lambda (x) '()))))))))
;; ---- step ----
(dk-focus! (cdr (assq 'step LZ3-IND)))
(define LZ3-K (cdr (assq 'var LZ3-IND)))
(define LZ3-IH (cdr (assq 'ih LZ3-IND)))
(define LZ3-SK (list 'succ LZ3-K))
(let* ((ld (dk-peel!))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (eq? (cadr f) LZ3-K)))) ld)))
       (P (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'MAT))) ld)))
       (k LZ3-K) (sk LZ3-SK))
  (fact 'nn-succ-closed k)
  (use-em (list '<= 1 n)
    (lambda ()
      (let* ((qv (lz3-skolem-split! (dk-cite! 'nn-pos-is-succ n)))
             (sq (list 'succ qv))
             (neq (list '= n sq)))
        (fact 'nn-succ-closed qv)
        (subst neq)
        (dk-rewrite-h! (list 'IN P (list 'MAT sk n '(CARR ZZ-RING))) n sq)
        (let ((nze (list 'FORSOME 'i0 (list 'FORSOME 'j0
                     (list 'AND (list 'IN 'i0 (list 'INTERVAL 1 sk))
                       (list 'AND (list 'IN 'j0 (list 'INTERVAL 1 sq))
                         (list 'NOT (list '= (list 'ENTRY P 'i0 'j0) '(ZERO ZZ-RING)))))))))
          (use-em nze
            (lambda () (lz3-step-nonzero! k qv P))
            (lambda () (lz3-step-zero! sk sq P nze))))))
    (lambda ()
      ;; no columns
      (let ((sn (list '<= (list 'succ n) 1)))
        (fact 'nn-not-le-succ-le 1 n)
        (ew P)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-head-is? g 'MAT-EQUIV) (fact 'mat-equiv-refl 'ZZ-RING sk n P) (ass))
                    ((dk-head-is? g 'IS-DIAGONAL) (mac 'IS-DIAGONAL) (lz3-vacuous! n (lambda (x) (list sn))))
                    ((dk-head-is? g 'FORALL)
                     (if (eq? (cadr g) 'i_)
                         (let* ((ld (dk-peel!))
                                (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'INTERVAL 1 n)))) ld))))
                           (lz3-iv-facts! x 1 n)
                           (lz3-absurd! (list (list '<= 1 x) (list '<= x n) sn)))
                         (let* ((ld (dk-peel!))
                                (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'INTERVAL 1 n)))) ld))))
                           (lz3-iv-facts! x 1 n)
                           (lz3-absurd! (list (list '<= 1 x) (list '<= x n) sn)))))
                    (#t (error "lz3 step: unexpected conjunct" (expression->string g)))))))))))
(lz3-done! 'integer-normal-form-mat-equiv)
(topic! 'integer-normal-form-mat-equiv 'algebra)
(gloss! 'integer-normal-form-mat-equiv "Every integer matrix is equivalent, by invertible integer matrices, to a diagonal matrix with non-negative diagonal entries each dividing the next.")

