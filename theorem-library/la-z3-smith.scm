(define LZ3-PAD (use-induction))
(dk-focus! (cdr (assq 'base LZ3-PAD)))
(dk-peel!)
(fact 'nn-zero-le 'k)
(dk-have! '(IN 0 NN) (lambda () (arith)))
(dk-cite! 'nn-le-antisym 'k 0)
(dk-rewrite-h! '(IN w (MAT k 1 (VEC md))) 'k 0)
(dk-rewrite-h! '(SPANS md k w sm) 'k 0)
(ew 'w)
(dk-conj-close! (lambda () (ass)))
(dk-focus! (cdr (assq 'step LZ3-PAD)))
(let* ((jv (cdr (assq 'var LZ3-PAD)))
       (ih (cdr (assq 'ih LZ3-PAD)))
       (sj (list 'succ jv)))
  (dk-peel!)
  (fact 'nn-succ-closed jv)
  (use-em (list '<= 'k jv)
    (lambda ()
      (let* ((w2 (lz3-skolem-split! (dk-apply! ih 'md 'sm 'k 'w)))
             (vz '(VZERO md))
             (w3 (list 'SNOC-COL w2 jv vz))
             (sub (lz3-open! 'IS-SUBMODULE 'md 'sm))
             (sp2 (lz3-open! 'SPANS 'md jv w2 'sm)))
        (fact 'module-vzero-in 'md)
        (fact 'module-scalar-ring 'md)
        (fact 'ring-zero-in '(SCAL md))
        (fact 'snoc-col-type '(VEC md) jv w2 vz)
        (ew w3)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (ass)
                (begin
                  (mac 'SPANS)
                  (dk-conj-close!
                    (lambda ()
                      (let* ((ld (dk-peel!))
                             (x (cadr (car ld))))
                        (if (equal? (caddr (car ld)) (list 'INTERVAL 1 sj))
                            ;; an entry of the padded sequence lies in sm
                            (begin
                              (lz3-iv-facts! x 1 sj)
                              (use-em (list '<= x jv)
                                (lambda ()
                                  (fact 'interval-mem-intro 1 jv x)
                                  (subst (dk-cite! 'entry-of-snoc-col w2 jv vz x '(VEC md)))
                                  (dk-apply! (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'LINCOMB)))) sp2) x)
                                  (ass))
                                (lambda ()
                                  (let ((d (dk-cite! 'nn-le-succ-cases jv x)))
                                    (use-cases d
                                      (lambda () (lz3-contra! (list 'NOT (list '<= x jv))))
                                      (lambda ()
                                        (subst (list '= x sj))
                                        (subst (dk-cite! 'snoc-col-last w2 jv vz '(VEC md)))
                                        (ass)))))))
                            ;; an element of sm is a combination of the padded sequence
                            (let* ((lc (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LINCOMB))) sp2))
                                   (c0 (lz3-skolem-split! (dk-apply! lc x)))
                                   (c1 (list 'SNOC-ROW c0 jv '(ZERO (SCAL md))))
                                   (l0 (list 'LINCOMB 'md jv c0 w2)))
                              (fact 'snoc-row-type '(CARR (SCAL md)) jv c0 '(ZERO (SCAL md)))
                              (fact 'lincomb-type 'md jv c0 w2)
                              (ew c1)
                              (dk-conj-close!
                                (lambda ()
                                  (if (dk-head-is? (dk-goal) 'IN)
                                      (ass)
                                      (begin
                                        (subst (dk-cite! 'lincomb-snoc 'md jv c0 w2 '(ZERO (SCAL md)) vz))
                                        (subst (dk-cite! 'module-act-zero-vec 'md '(ZERO (SCAL md))))
                                        (subst (dk-cite! 'abelian-group-right-id-module-vector-ag 'md l0))
                                        (ass))))))))))))))))
    (lambda ()
      (let ((d (dk-cite! 'nn-le-succ-cases jv 'k)))
        (use-cases d
          (lambda () (lz3-contra! (list 'NOT (list '<= 'k jv))))
          (lambda ()
            (dk-rewrite-h! '(IN w (MAT k 1 (VEC md))) 'k sj)
