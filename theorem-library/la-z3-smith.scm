(topic! 'smith-pivot-cross-minimal 'algebra)
(gloss! 'smith-pivot-cross-minimal "Over a euclidean ring a matrix with a nonzero entry is equivalent to a matrix in border form whose nonzero (1,1) entry has minimal gauge over the whole equivalence class.")

;;; =====================================================================
;;; (2) smith-pivot-divides-block.
;;; =====================================================================
(define (lz3-in-iv! x a b . prems)
  (if (not (dk-asm? (list 'IN x (list 'INTERVAL a b))))
      (dk-have! (list 'IN x (list 'INTERVAL a b))
        (lambda ()
          (lz3-nn! x)
          (dk-have! (list '<= a x) (lambda () (apply dk-nn! prems)))
          (dk-have! (list '<= x b) (lambda () (apply dk-nn! prems)))
          (fact 'interval-mem-intro a b x)
          (ass)))))
;; i in [1,p] => succ i in [1, succ p], succ i /= 1
(define (lz3-succ-iv! i p)
  (lz3-iv-facts! i 1 p)
  (lz3-nn! (list 'succ i))
  (lz3-nn! p)
  (lz3-in-iv! (list 'succ i) 1 (list 'succ p) (list '<= i p))
  (lz3-ne! (list 'succ i) 1 (list '<= 1 i))
  (lz3-ne! 1 (list 'succ i) (list '<= 1 i)))
(define LZ3-W '(SUBMAT bm p q))
(define LZ3-PDB-HYPS
  (list '(IN p NN) '(IN q NN) '(IN bm (MAT (succ p) (succ q) (CARR R)))
        (list '= 'bm (list 'BORDER 'R '(ENTRY bm 1 1) LZ3-W 'p 'q))
        '(NOT (= (ENTRY bm 1 1) (ZERO R)))
        (lz3-pcm 'R 'bm)))
(define (lz3-divides-form rg c x)       ; x = c y for some y in CARR rg
