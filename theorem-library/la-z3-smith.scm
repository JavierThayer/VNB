                   (let* ((ld (dk-peel!))
                          (x (cadr (car ld))))
                     (dk-apply! (lz3-nonneg dz 'n 'n) x)
                     (subst dseq)
                     (ass)))
                  (#t (error "lz3 3.44: unexpected conjunct" (expression->string g))))))))))
(lz3-done! 'principal-sequence-exists)
(topic! 'principal-sequence-exists 'algebra)
(gloss! 'principal-sequence-exists "Linear algebra 3.44: a submodule F of a free Z-module E of rank n has a principal sequence: free generators e_1, ..., e_n of E and non-negative integers b_1 | b_2 | ... | b_n with b_1 e_1, ..., b_n e_n generating F.")

(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(n u sm) '((IN n NN) (IN u (MAT n 1 (VEC md))) (GENERATES md n u) (REL-FREE md n u) (IS-SUBMODULE md sm))
    '(FORSOME es (FORSOME dm (AND (IS-PRINCIPAL-SEQUENCE md n sm es dm)
       (FORALL es2 (FORALL dm2 (IMPLIES (IS-PRINCIPAL-SEQUENCE md n sm es2 dm2) (= dm dm2)))))))))))
(dk-peel!)
(let* ((es (lz3-skolem-split! (dk-cite! 'principal-sequence-exists 'md 'n 'u 'sm)))
       (dm (lz3-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f es))) (dk-asms)))))
  (ew es) (ew dm)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((ld (dk-peel!))
                 (ps (find-first (dk-head? 'IS-PRINCIPAL-SEQUENCE) ld)))
            (dk-cite! 'principal-sequence-unique 'md 'n 'sm es (list-ref ps 4) dm (list-ref ps 5))
