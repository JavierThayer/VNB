            (ew 'w)
            (dk-conj-close! (lambda () (ass)))))))))
(lz3-done! 'spans-pad-zero)
(topic! 'spans-pad-zero 'algebra)
(gloss! 'spans-pad-zero "A submodule spanned by k elements is spanned by j elements for every j >= k (pad with zeros).")

;;; =====================================================================
;;; (10) 3.44: an adapted basis.  F is spanned by n elements ys (submodule-fg, padded);
;;; ys = cm . u; U cm V = D in normal form (3.37); es = V^-1 . u is a free generating
;;; sequence and D . es = U . ys spans F.
;;; =====================================================================
(define LZ3-S '(SCAL md))
(define (lz3-up! f)                     ; F over ZZ-RING => F over (SCAL md), by rewriting the GOAL
  (let ((g (dk--replace f 'ZZ-RING LZ3-S)))
    (dk-have! g (lambda () (subst (list '= LZ3-S 'ZZ-RING)) (ass)))
    g))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(n u sm) '((IN n NN) (IN u (MAT n 1 (VEC md))) (GENERATES md n u) (REL-FREE md n u) (IS-SUBMODULE md sm))
    '(FORSOME es (FORSOME dm (IS-PRINCIPAL-SEQUENCE md n sm es dm)))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(lz3-zsetup!)
(dk-have! '(IS-EUCLIDEAN-RING (SCAL md)) (lambda () (subst '(= (SCAL md) ZZ-RING)) (ass)))
(dk-have! '(AND (IS-MODULE md) (IS-EUCLIDEAN-RING (SCAL md))) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-have-prop! '(IMPLIES (= n 0) (= n 0)))
(let* ((kv (lz3-skolem-split! (dk-cite! 'submodule-fg 'md 'n 'u 'sm)))
       (wv (lz3-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f kv))) (dk-asms))))
       (ys (lz3-skolem-split! (dk-cite! 'spans-pad-zero 'n 'md 'sm kv wv)))
       (cm (lz3-skolem-split! (lz3-cite! 'generates-coeff-matrix 'md 'n 'n 'u ys)))
       (cmz (dk-rewrite-h! (dk-rewrite-h! (list 'IN cm (list 'MAT 'n 'n (list 'CARR LZ3-S))) LZ3-S 'ZZ-RING) '(CARR ZZ-RING) 'ZZ))
       (um (lz3-skolem-split! (dk-cite! 'integer-normal-form-elementary 'n 'n cm)))
       (vm (lz3-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f um))) (dk-asms))))
       (vi (lz3-skolem-split! (dk-cite! 'elem-gen-inverse 'ZZ-RING 'n vm)))
       (dz (lz3-mm 'ZZ-RING (lz3-mm 'ZZ-RING um cm) vm))
       (xs (lz3-mm LZ3-S um cm))
       (ds (lz3-mm LZ3-S xs vm))
       (es (list 'MATACT 'md vi 'u)))
  (for-each (lambda (x) (fact 'elem-gen-mat 'ZZ-RING 'n x)) (list um vm vi))
  (for-each (lambda (x) (lz3-up! (list 'IN x '(MAT n n (CARR ZZ-RING))))) (list um vm vi))
  (fact 'elem-gen-invertible 'ZZ-RING 'n um)
  (fact 'elem-gen-invertible 'ZZ-RING 'n vi)
  (lz3-up! (list 'IS-INVERTIBLE-MAT 'ZZ-RING 'n um))
  (lz3-up! (list 'IS-INVERTIBLE-MAT 'ZZ-RING 'n vi))
  (dk-rewrite-h! cmz 'ZZ '(CARR ZZ-RING))
  (dk-have! (list 'IN dz '(MAT n n (CARR ZZ-RING))) dk-typ-close!)
  (dk-rewrite-h! (list 'IN dz '(MAT n n (CARR ZZ-RING))) '(CARR ZZ-RING) 'ZZ)
  (dk-have! (list 'IN xs (list 'MAT 'n 'n (list 'CARR LZ3-S))) dk-typ-close!)
  (dk-have! (list 'IN ds (list 'MAT 'n 'n (list 'CARR LZ3-S))) dk-typ-close!)
  (let ((dseq (list '= ds dz)))
    (dk-have! dseq (lambda () (subst (list '= LZ3-S 'ZZ-RING)) (rfl)))
    (lz3-cite! 'matact-type 'md 'n 'n 1 vi 'u)
    (fact 'generates-transport 'md 'n 'u vi)
    (fact 'free-transport 'md 'n 'u vi)
    (let* ((e1 (lz3-cite! 'matact-assoc 'md 'n 'n 'n 1 ds vi 'u))
           (e2 (lz3-assoc! LZ3-S 'n 'n 'n 'n xs vm vi))
           (e3 (lz3-up! (list '= (lz3-mm 'ZZ-RING vm vi) '(IDENTMAT ZZ-RING n))))
           (e4 (dk-cite! 'identmat-right-identity LZ3-S 'n 'n xs))
           (e5 (lz3-cite! 'matact-assoc 'md 'n 'n 'n 1 um cm 'u))
           (sp0 (fact 'spans-transport 'md 'n ys um 'sm))
           (spd (list 'SPANS 'md 'n (list 'MATACT 'md ds es) 'sm)))
      (dk-have! spd
        (lambda ()
          (subst (list '= (list 'MATACT 'md ds es) (list 'MATACT 'md (lz3-mm LZ3-S ds vi) 'u)))
          (subst (list '= (lz3-mm LZ3-S ds vi) (lz3-mm LZ3-S xs (lz3-mm LZ3-S vm vi))))
          (subst (list '= (lz3-mm LZ3-S vm vi) (list 'IDENTMAT LZ3-S 'n)))
          (subst (list '= (lz3-mm LZ3-S xs (list 'IDENTMAT LZ3-S 'n)) xs))
          (subst (list '= (list 'MATACT 'md xs 'u) (list 'MATACT 'md um (list 'MATACT 'md cm 'u))))
          (subst (list '= (list 'MATACT 'md cm 'u) ys))
