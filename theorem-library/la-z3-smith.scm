(lz3-cc-foc-goal! (lz3-H? 'FORSOME))
(define LZ3-ROWPRES (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORALL)
   (let ((cc (caddr z))) (and (pair? cc) (eq? (car cc) 'IMPLIES)
     (let ((k (caddr cc))) (and (pair? k) (eq? (car k) '=)
       (equal? (cadr k) (list 'ENTRY LZ3-C2 1 (cadr z)))))))))))
(define LZ3-C1ROW (lz3-cc-find (lambda (z) (and (pair? z) (eq? (car z) 'FORALL)
   (let ((cc (caddr z))) (and (pair? cc) (eq? (car cc) 'IMPLIES)
