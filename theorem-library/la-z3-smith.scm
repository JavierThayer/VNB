      (dk-rewrite-h! (list 'IN dz '(MAT n n ZZ)) dz ds)
      (dk-rewrite-h! (list 'IS-DIAGONAL 'ZZ-RING 'n 'n dz) dz ds)
      (ew es) (ew ds)
      (mac 'IS-PRINCIPAL-SEQUENCE)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'FORALL))
