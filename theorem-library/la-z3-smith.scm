(define LZ3-ROWH2 (list 'FORALL 'jr (lz3-impl* (list (list 'IN 'jr (list 'INTERVAL 1 LZ3-SQ)) '(NOT (= jr 1)))
                    (list '= (list 'ENTRY LZ3-C2 1 'jr) '(ZERO A)))))
