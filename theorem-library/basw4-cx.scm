;;; ================================================================================================
;;; part2: the compactness argument of Remark 1.27 for an IDEAL-LIKE subset of C(t)
;;; ================================================================================================
;;; Five closure hypotheses on a subset bmi of C(t): what a two-sided ideal of CCONT-ALGEBRA(t) gives
;;; once the accessors are read off (ccont-ideal-laws), and what the kernel of a character satisfies.
(define (bm4-H1 i) (list 'SUBSET i '(CCONT t)))
(define (bm4-H2 i) (list 'IN '(CCONT-VZERO t) i))
(define (bm4-H3 i) (list 'FORALL 'bmf_ (list 'IMPLIES (list 'IN 'bmf_ i) (list 'FORALL 'bmg_ (list 'IMPLIES (list 'IN 'bmg_ i)
                     (list 'IN '((CCONT-VADD t) bmf_ bmg_) i))))))
(define (bm4-H4 i) (list 'FORALL 'bmz_ (list 'IMPLIES '(IN bmz_ CC) (list 'FORALL 'bmf_ (list 'IMPLIES (list 'IN 'bmf_ i)
                     (list 'IN '((CCONT-ACT t) bmz_ bmf_) i))))))
(define (bm4-H5 i) (list 'FORALL 'bmg_ (list 'IMPLIES '(IN bmg_ (CCONT t)) (list 'FORALL 'bmf_ (list 'IMPLIES (list 'IN 'bmf_ i)
                     (list 'IN '((CCONT-VMUL t) bmf_ bmg_) i))))))
(define (bm4-hyps i) (list (bm4-H1 i) (bm4-H2 i) (bm4-H3 i) (bm4-H4 i) (bm4-H5 i)))
(define (bm4-ist body)                ; forall t compact, forall bmi with the five hypotheses: BODY
  (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'bmi
    (let wrap ((hs (bm4-hyps 'bmi))) (if (null? hs) body (list 'IMPLIES (car hs) (wrap (cdr hs)))))))))

;;; helpers copied from basw3-urysohn (file-local there)
(define (bm4-close-ctx!) (dk-conj-close! (lambda () (bm4-ass!))))
(define (bm4-rhs! iff)
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
(define (bm4-split-cite! . args)
  (let ((r (apply dk-cite! args)))
    (if (dk-head-is? r 'AND) (dk-split-all! (list r)))
    r))
(define (bm4-fact! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-head-is? (cadr r) 'AND))
        (begin (dk-have! (cadr r) (lambda () (bm4-close-ctx!)))
               (loop (dk-landed-1 (lambda () (detach! r)))))
        (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
            (loop (dk-landed-1 (lambda () (detach! r))))
            r))))
(define (bm4-top!)
  (if (not (dk-asm? '(IS-TOP-SPACE t))) (bm4-rhs! (dk-cite! 'is-compact-t 't)))
  (if (not (dk-asm? '(IN (PTS t) SET))) (bm4-rhs! (dk-cite! 'is-top-space 't))))
(define (bm4-in-power! w)
  (if (not (dk-asm? (list 'IN w '(POWER (PTS t)))))
      (begin
        (if (not (dk-asm? (list 'IN w 'SET))) (dk-cite! 'subclass-of-set-is-set w '(PTS t)))
        (let ((imp (dk-cite! 'power-mem-intro '(PTS t) w)))
          (if (dk-head-is? imp 'IMPLIES)
              (begin
                (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd w '(PTS t) z) (bm4-ass!))))
                (detach! imp)))))))
(define (bm4-rcp! x)                  ; 1 <= x in context: recip x typed, x recip x = 1, 0 < recip x <= 1
  (let ((r (list 'recip x)))
    (dk-have! (list '< 0 x) (lambda () (dk-ineq! (list '<= 1 x) (list 'IN x 'RR))))
    (dk-cite! 'rr-pos-ne-zero x)
    (dk-have! (list 'AND (list 'IN x 'RR) (list 'NOT (list '= x 0))) (lambda () (bm4-close-ctx!)))
    (dk-cite! 'rr-recip-closed x)
    (dk-cite! 'rr-recip-inverse x)
    (dk-cite! 'rr-recip-pos x)
    (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-recip-one)
    (dk-rewrite-h! (dk-cite! 'rr-recip-antitone 1 x) '(recip 1) 1)
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))))
(define (bm4-cty! e)                  ; type a term built from the operations in CCONT(t)
  (cond ((dk-asm? (list 'IN e '(CCONT t))) #t)
        ((equal? e '(CCONT-VONE t)) (dk-cite! 'ccont-vone-type 't))
        ((equal? e '(CCONT-VZERO t)) (dk-cite! 'ccont-vzero-type 't))
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-VSTAR))
         (bm4-cty! (cadr e)) (dk-cite! 'ccont-vstar-in 't (cadr e)))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL)))
         (bm4-cty! (cadr e)) (bm4-cty! (caddr e))
         (dk-cite! (if (eq? (caar e) 'CCONT-VADD) 'ccont-vadd-in 'ccont-vmul-in) 't (cadr e) (caddr e)))
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-ACT))
         (bm4-cty! (caddr e)) (dk-cite! 'ccont-act-in 't (cadr e) (caddr e)))
        (#t (error "bm4-cty!: untyped" (expression->string e)))))
(define (bm4-cval! f z)               ; f in CCONT t: land f z in CC
  (if (not (dk-asm? (list 'IN f '(FUN (PTS t) CC)))) (bm4-split-cite! 'ccont-parts 't f))
  (if (not (dk-asm? (list 'IN (list f z) 'CC))) (dk-cite! 'fun-apply-type-c f '(PTS t) 'CC z)))
(define (bm4-cev! e z)                ; rewrite (e z) in the goal by its value, bottom-up
  (cond ((equal? e '(CCONT-VONE t)) (subst (dk-cite! 'ccont-vone-val 't z)))
        ((equal? e '(CCONT-VZERO t)) (subst (dk-cite! 'ccont-vzero-val 't z)))
        ((and (pair? e) (pair? (car e)) (eq? (caar e) 'CCONT-VSTAR))
         (bm4-cty! e) (bm4-cval! (cadr e) z)
         (subst (dk-cite! 'ccont-vstar-val 't (cadr e) z)) (bm4-cev! (cadr e) z))
        ((and (pair? e) (pair? (car e)) (memq (caar e) '(CCONT-VADD CCONT-VMUL CCONT-ACT)))
         (bm4-cty! e)
         (subst (dk-cite! (cdr (assq (caar e) '((CCONT-VADD . ccont-vadd-val) (CCONT-VMUL . ccont-vmul-val) (CCONT-ACT . ccont-act-val))))
                          't (cadr e) (caddr e) z))
         (if (not (eq? (caar e) 'CCONT-ACT)) (bm4-cev! (cadr e) z))
         (bm4-cev! (caddr e) z))
        (#t (bm4-cval! e z))))
(define (bm4-other-case! z a b)
  (if (not (dk-asm? (list 'IN z b))) (dk-have! (list 'IN z b) (lambda () (if (dk-only! (list 'OR (list 'IN z a) (list 'IN z b)) (list 'NOT (list 'IN z a))) (prop))))))
(define (bm4-empty-absurd! z)
  (let ((n (dk-cite! 'empty-set-has-no-members z)))
    (if (dk-only! n (list 'IN z 'EMPTY-SET)) (prop))))

;;; the opener: peel, the top space, the three closure laws picked by their operation
(define bm4-iH3 #f) (define bm4-iH4 #f) (define bm4-iH5 #f)
(define (bm4-iopen!)
  (dk-peel!)
  (bm4-top!)
  (set! bm4-iH3 (dk-ctx-form (bm4-H3 'bmi)))
  (set! bm4-iH4 (dk-ctx-form (bm4-H4 'bmi)))
  (set! bm4-iH5 (dk-ctx-form (bm4-H5 'bmi)))
  (if (not (and bm4-iH3 bm4-iH4 bm4-iH5)) (error "bm4-iopen!: a closure hypothesis is missing")))
(define (bm4-in-c! f)                 ; f in bmi: land f in CCONT t
  (if (not (dk-asm? (list 'IN f '(CCONT t)))) (dk-cite! 'subset-mem-fwd 'bmi '(CCONT t) f)))

;;; the class of the compactness argument: subsets W of PTS t on which some h in bmi, real and
;;; nonnegative, is >= 1
(define (bm4-Pb W)
  (list 'FORSOME 'uhh_ (list 'AND '(IN uhh_ (CCONT t)) (list 'AND '(IN uhh_ bmi)
    (list 'AND '(FORALL uhz_ (IMPLIES (IN uhz_ (PTS t)) (AND (IN (uhh_ uhz_) RR) (<= 0 (uhh_ uhz_)))))
               (list 'FORALL 'uhz_ (list 'IMPLIES (list 'IN 'uhz_ W) '(<= 1 (uhh_ uhz_)))))))))
(define bm4-P (list 'SEP 'ubw_ '(POWER (PTS t)) (bm4-Pb 'ubw_)))
(define (bm4-guard g) (caddr (cadr (caddr g))))
(define (bm4-P-in! W h val! one!)     ; goal (IN W P), h in bmi and in CCONT t in context
  (bm4-in-power! W)
  (in-sep! (lambda () (bm4-ass!))
    (lambda ()
      (ew h)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (bm4-ass!))
                  ((and (dk-head-is? g 'FORALL) (equal? (bm4-guard g) '(PTS t))) (let ((z (dk-di-var!))) (val! z)))
                  ((dk-head-is? g 'FORALL) (let ((z (dk-di-var!))) (one! z)))
                  (#t (error "bm4-P-in!: unexpected goal" (expression->string g))))))))))
(define (bm4-open-P! a)               ; (IN a P) in context: land a in POWER, the witness h, its clauses; return (h vals ones)
  (dk-project! (list 'IN a '(POWER (PTS t))) (lambda () (sep-me (list 'IN a bm4-P))))
  (sep-me (list 'IN a bm4-P)) (dk-split-all!)
  (let* ((h (dk-skolem! (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (eq? (cadr x) 'uhh_) (dk-contains? x a))) "the witness")))
         (_ (dk-split-all!))
         (vals (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x h) (equal? (bm4-guard x) '(PTS t))
                                         (dk-head-is? (caddr (caddr x)) 'AND))) "values"))
         (ones (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x h) (equal? (bm4-guard x) a)
                                         (dk-head-is? (caddr (caddr x)) '<=))) "ones")))
    (list h vals ones)))

;;; ---- the bump: near a point where g in bmi does not vanish, c |g|^2 in bmi is >= 1 ----
(sp (make-wff (bm4-ist (list 'FORALL 'g (list 'IMPLIES '(IN g bmi)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'IMPLIES '(NOT (= (g p) 0))
    (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u bm4-P))))))))))))
(bm4-iopen!)
(bm4-in-c! 'g)
(bm4-cval! 'g 'p)
(let* ((w '(g p)) (m (list 'magnitude w)) (e (list '* 1/2 m)))
  (dk-cite! 'cc-magnitude-closed w) (dk-cite! 'cc-magnitude-nonneg w)
  (let ((iff (dk-cite! 'cc-magnitude-zero-iff w)))
    (dk-have! (list 'NOT (list '= m 0)) (lambda () (if (dk-only! iff '(NOT (= (g p) 0))) (prop)))))
  (dk-cite! 'neq-sym m 0)
  (dk-have! (list 'AND (list '<= 0 m) (list 'NOT (list '= 0 m))) (lambda () (bm4-close-ctx!)))
  (bm4-fact! 'rr-le-ne-lt 0 m)
  (dk-real! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< 0 m) (list 'IN m 'RR))))
  (dk-cite! 'rr-pos-rr-of-lt e)
  (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'g) 'p e)))
         (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the clause near p"))
         (b (list '* e e)) (c (list 'recip b))
         (gs '((CCONT-VSTAR t) g)) (gg (list '(CCONT-VMUL t) 'g gs)) (h (list '(CCONT-ACT t) c gg)))
    (dk-cite! 'top-open-subset 't u)
    (dk-real! b)
    (dk-cite! 'rr-mul-pos e e)
    (dk-cite! 'rr-pos-ne-zero b)
    (dk-have! (list 'AND (list 'IN b 'RR) (list 'NOT (list '= b 0))) (lambda () (bm4-close-ctx!)))
    (dk-cite! 'rr-recip-closed b)
    (dk-cite! 'rr-recip-inverse b)
    (dk-cite! 'rr-recip-pos b)
    (dk-cite! 'rr-subset-cc c)
    (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c) (list 'IN c 'RR))))
    (dk-real! (list '* c b)) (dk-real! (list '* b c))
    (dk-have! (list '= (list '* c b) (list '* b c)) (lambda () (dk-crs-opaque!)))
    (bm4-cty! h)
    ;; h in bmi: g g* by the right multiplication, then the scalar
    (dk-apply! bm4-iH5 gs 'g)
    (dk-apply! bm4-iH4 c gg)
    (let* ((M! (lambda (z)            ; z in PTS t: h z = c (|g z| |g z|), real, >= 0
                 (bm4-cval! 'g z)
                 (let* ((gz (list 'g z)) (mgz (list 'magnitude gz)) (Q (list '* mgz mgz)) (hval (list '* c Q)))
                   (dk-cite! 'cc-magnitude-closed gz) (dk-cite! 'cc-magnitude-nonneg gz)
                   (dk-real! Q) (dk-real! hval)
                   (dk-have! (list 'AND (list '<= 0 mgz) (list '<= 0 mgz)) (lambda () (bm4-close-ctx!)))
                   (bm4-fact! 'rr-leq-mul-nonneg mgz mgz)
                   (dk-have! (list 'AND (list '<= 0 c) (list '<= 0 Q)) (lambda () (bm4-close-ctx!)))
                   (bm4-fact! 'rr-leq-mul-nonneg c Q)
                   (dk-have! (list '= (list h z) hval)
                     (lambda () (bm4-cev! h z) (subst (dk-cite! 'cc-magnitude-sq-conjugate gz))
                             (dk-type! (list '* c (list '* gz (list 'conjugate gz))) 'CC) (if (bm4-open?) (rfl))))
                   (list mgz Q hval)))))
      (bm4-in-power! u)
      (ew u)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (bm4-ass!)
            (bm4-P-in! u h
              (lambda (z) (let ((r (M! z))) (subst (list '= (list h z) (caddr r))) (bm4-close-ctx!)))
              (lambda (z)
                (dk-cite! 'subset-mem-fwd u '(PTS t) z)
                (let* ((r (M! z)) (mgz (car r)) (Q (cadr r)) (hval (caddr r))
                       (gz (list 'g z)) (dd (list '- '(g p) gz)) (D (list 'magnitude dd))
                       (bz (dk-apply! cl z)))
                  (dk-type! dd 'CC)
                  (dk-cite! 'cc-magnitude-closed dd)
                  (dk-have! (list 'AND (list 'IN dd 'CC) (list 'IN gz 'CC)) (lambda () (bm4-close-ctx!)))
                  (let* ((tr (bm4-fact! 'cc-magnitude-triangle dd gz))
                         (eqn (list '= (list '+ dd gz) '(g p))))
                    (dk-have! eqn (lambda () (crs)))
                    (let ((tr2 (dk-rewrite-h! tr (list '+ dd gz) '(g p))))
                      (dk-have! (list '<= e mgz) (lambda () (dk-ineq! tr2 bz (list 'IN m 'RR) (list 'IN D 'RR) (list 'IN mgz 'RR))))
                      (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
                      (dk-have! (list 'AND (list '<= 0 e) (list '<= e mgz)) (lambda () (bm4-close-ctx!)))
                      (bm4-fact! 'rr-le-scale-nonneg e e mgz)
                      (dk-cite! 'rr-mul-le-right e mgz mgz)
                      (dk-real! (list '* e mgz))
                      (dk-have! (list '<= b Q) (lambda () (dk-ineq! (list '<= b (list '* e mgz)) (list '<= (list '* e mgz) Q)
                                                                    (list 'IN b 'RR) (list 'IN (list '* e mgz) 'RR) (list 'IN Q 'RR))))
                      (dk-have! (list 'AND (list '<= 0 c) (list '<= b Q)) (lambda () (bm4-close-ctx!)))
                      (bm4-fact! 'rr-le-scale-nonneg c b Q)
                      (subst (list '= (list h z) hval))
                      (dk-ineq! (list '<= (list '* c b) hval) (list '= (list '* c b) (list '* b c)) (list '= (list '* b c) 1)
                                (list 'IN (list '* c b) 'RR) (list 'IN (list '* b c) 'RR) (list 'IN hval 'RR)))))))))))))
(bm4-qed! 'ccont-ideal-bump)

;;; ---- a function >= 1 in bmi puts 1 in bmi: h (1/h) = 1 ----
(define bm4-hv #f)
(define (bm4-hv! z)
  (if (not (dk-asm? (list '<= 1 (list 'h z))))
      (begin (dk-split-all! (list (dk-apply! bm4-hv z)))
             (bm4-rcp! (list 'h z)))))
(define bm4-k '(VNB-LAMBDA ukz_ (PTS t) (recip (h ukz_))))
(define bm4-hk (list '(CCONT-VMUL t) 'h bm4-k))
(sp (make-wff (bm4-ist (list 'FORALL 'h (list 'IMPLIES '(IN h bmi)
  (list 'IMPLIES '(FORALL ulz_ (IMPLIES (IN ulz_ (PTS t)) (AND (IN (h ulz_) RR) (<= 1 (h ulz_)))))
    '(IN (CCONT-VONE t) bmi)))))))
(bm4-iopen!)
(bm4-in-c! 'h)
(set! bm4-hv (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'ulz_))) "the values of h"))
(dk-have! (list 'IN bm4-k '(FUN (PTS t) CC))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (bm4-hv! z) (dk-cite! 'rr-subset-cc (list 'recip (list 'h z))) (bm4-ass!)))
                  (lambda () (bm4-ass!)))))
(bm4-split-cite! 'ccont-parts 't 'h)
(let ((imp (dk-cite! 'ccont-intro 't bm4-k)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (dk-peel!))
             (p (cadr (car (filter (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) '(PTS t)))) pe))))
             (e (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pe))))
             (u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'h) p e)))
             (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the clause near p")))
        (dk-cite! 'rr-pos-rr-in-rr e)
        (dk-cite! 'top-open-subset 't u)
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (bm4-hv! p) (bm4-hv! q)
                  (let* ((bd (dk-apply! cl q))
                         (hp (list 'h p)) (hq (list 'h q))
                         (d1 (list '- hp hq)) (d2 (list '- (list 'recip hp) (list 'recip hq))))
                    (dk-lam-b!)
                    (dk-real! d1) (dk-real! d2)
                    (subst (dk-cite! 'rr-magnitude-is-abs d2))
                    (dk-cite! 'rr-magnitude-is-abs d1)
                    (let* ((bd2 (dk-rewrite-h! bd (list 'magnitude d1) (list 'abs d1)))
                           (lip (dk-cite! 'rr-recip-lipschitz-ge-one hp hq)))
                      (dk-cite! 'rr-abs-closed d1) (dk-cite! 'rr-abs-closed d2)
                      (dk-ineq! lip bd2 (list 'IN (list 'abs d1) 'RR) (list 'IN (list 'abs d2) 'RR) (list 'IN e 'RR)))))
                (bm4-ass!)))))))
  (dk-landed-1 (lambda () (detach! imp))))
(bm4-cty! bm4-hk)
(dk-cite! 'ccont-vone-type 't)
(dk-fun-ext! bm4-hk '(CCONT-VONE t) '(PTS t) 'CC
  (lambda () (bm4-split-cite! 'ccont-parts 't bm4-hk) (bm4-ass!))
  (lambda () (bm4-split-cite! 'ccont-parts 't '(CCONT-VONE t)) (bm4-ass!))
  (lambda (z)
    (bm4-hv! z)
    (bm4-cev! bm4-hk z)
    (bm4-cev! '(CCONT-VONE t) z)
    (dk-lam-b!)
    (bm4-ass!)))
(dk-apply! bm4-iH5 bm4-k 'h)
(subst (list '= '(CCONT-VONE t) bm4-hk))
(bm4-ass!)
(bm4-qed! 'ccont-ideal-one)

;;; ---- compactness: if every point has a g in bmi not vanishing there, PTS t is in the class ----
(define bm4-H '(FORALL ucx_ (IMPLIES (IN ucx_ (PTS t)) (FORSOME ucg_ (AND (IN ucg_ bmi) (NOT (= (ucg_ ucx_) 0)))))))
(define bm4-Hh #f)
(sp (make-wff (bm4-ist (list 'IMPLIES bm4-H (list 'IN '(PTS t) bm4-P)))))
(bm4-iopen!)
(set! bm4-Hh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'ucx_))) "the hypothesis"))
(dk-cite! 'power-set '(PTS t))
(let ((imp (dk-cite! 'bsw-compact-induction 't bm4-P)))
  ;; the empty set: the zero function
  (dk-have! (list 'IN 'EMPTY-SET bm4-P)
    (lambda ()
      (let ((h0 '(CCONT-VZERO t)))
        (bm4-cty! h0)
        (dk-cite! 'empty-set-is-set)
        (dk-have! '(SUBSET EMPTY-SET (PTS t)) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bm4-empty-absurd! z))))
        (bm4-P-in! 'EMPTY-SET h0
          (lambda (z) (bm4-cev! h0 z) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (dk-type! 0 'RR) (dk-ineq!)))))
          (lambda (z) (bm4-empty-absurd! z))))))
  ;; binary unions: the sum
  (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka bm4-P) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb bm4-P) (list 'IN '(UNION ka kb) bm4-P)))))
    (lambda ()
      (let* ((pe (dk-peel!)) (g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g))) (un (list 'UNION a b))
             (A1 (bm4-open-P! a)) (B1 (bm4-open-P! b))
             (h1 (car A1)) (h2 (car B1)) (h (list '(CCONT-VADD t) h1 h2))
             (mem! (lambda (z)
                     (bm4-rhs! (dk-cite! 'union-membership a b z))
                     (if (not (dk-asm? (list 'IN z '(PTS t))))
                         (dk-have! (list 'IN z '(PTS t))
                           (lambda () (use-em (list 'IN z a) (lambda () (dk-cite! 'power-mem-in '(PTS t) a z) (bm4-ass!))
                                                             (lambda () (bm4-other-case! z a b) (dk-cite! 'power-mem-in '(PTS t) b z) (bm4-ass!))))))))
             (vals! (lambda (z)
                      (dk-split-all! (list (dk-apply! (cadr A1) z)))
                      (dk-split-all! (list (dk-apply! (cadr B1) z))))))
        (dk-have! (list 'SUBSET un '(PTS t)) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (mem! z) (bm4-ass!))))
        (bm4-cty! h)
        (dk-apply! bm4-iH3 h1 h2)
        (bm4-P-in! un h
          (lambda (z)
            (vals! z)
            (bm4-cev! h z)
            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bm4-ass!)
                                           (if (dk-head-is? (dk-goal) 'IN) (dk-real! (cadr (dk-goal)))
                                               (dk-ineq! (list '<= 0 (list h1 z)) (list '<= 0 (list h2 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR)))))))
          (lambda (z)
            (mem! z) (vals! z)
            (bm4-cev! h z)
            (use-em (list 'IN z a)
              (lambda () (let ((l (dk-apply! (caddr A1) z)))
                           (dk-ineq! l (list '<= 0 (list h2 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR))))
              (lambda () (bm4-other-case! z a b)
                         (let ((l (dk-apply! (caddr B1) z)))
                           (dk-ineq! l (list '<= 0 (list h1 z)) (list 'IN (list h1 z) 'RR) (list 'IN (list h2 z) 'RR))))))))))
  ;; the local step: the bump
  (dk-have! (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u bm4-P))))))
    (lambda ()
      (let* ((p (dk-di-var!))
             (g (dk-skolem! (dk-apply! bm4-Hh p))))
        (dk-split-all!)
        (dk-cite! 'ccont-ideal-bump 't 'bmi g p)
        (bm4-ass!))))
  (dk-apply! imp)
  (bm4-ass!))
(bm4-qed! 'ccont-ideal-cover)

;;; ---- a subset with the five closure laws and without 1 has a common zero ----
(define bm4-G '(FORSOME x (AND (IN x (PTS t)) (FORALL ukg_ (IMPLIES (IN ukg_ bmi) (= (ukg_ x) 0))))))
(sp (make-wff (bm4-ist (list 'IMPLIES '(NOT (IN (CCONT-VONE t) bmi)) bm4-G))))
(bm4-iopen!)
(use-em bm4-G
  (lambda () (bm4-ass!))
  (lambda ()
    (dk-have! bm4-H
      (lambda ()
        (let* ((x (dk-di-var!))
               (F (list 'FORSOME 'ucg_ (list 'AND '(IN ucg_ bmi) (list 'NOT (list '= (list 'ucg_ x) 0)))))
               (Kx (list 'FORALL 'ukg_ (list 'IMPLIES '(IN ukg_ bmi) (list '= (list 'ukg_ x) 0)))))
          (use-em F
            (lambda () (bm4-ass!))
            (lambda ()
              (dk-have! Kx
                (lambda ()
                  (let ((g (dk-di-var!)))
                    (use-em (list '= (list g x) 0)
                      (lambda () (bm4-ass!))
                      (lambda ()
                        (dk-have! F (lambda () (ew g) (bm4-close-ctx!)))
                        (if (dk-only! F (list 'NOT F)) (prop)))))))
              (dk-have! bm4-G (lambda () (ew x) (bm4-close-ctx!)))
              (if (dk-only! bm4-G (list 'NOT bm4-G)) (prop)))))))
    (dk-cite! 'ccont-ideal-cover 't 'bmi)
    (let* ((W (bm4-open-P! '(PTS t))) (h (car W)) (vals (cadr W)) (ones (caddr W))
           (ge1 (list 'FORALL 'ulz_ (list 'IMPLIES '(IN ulz_ (PTS t)) (list 'AND (list 'IN (list h 'ulz_) 'RR) (list '<= 1 (list h 'ulz_)))))))
      (dk-have! ge1 (lambda () (let ((z (dk-di-var!))) (dk-split-all! (list (dk-apply! vals z))) (dk-apply! ones z) (bm4-close-ctx!))))
      (let ((one (dk-cite! 'ccont-ideal-one 't 'bmi h)))
        (if (dk-only! one '(NOT (IN (CCONT-VONE t) bmi))) (prop))))))
(bm4-qed! 'ccont-ideal-common-zero)

;;; ---- with 1, the subset is all of C(t) ----
(define (bm4-class-ext! a b fwd bwd)  ; land (= a b) by class-extensionality; FWD z: goal (IN z b) from (IN z a); BWD z the converse
  (dk-have! (list 'FORALL 'bmx_ (list 'IFF (list 'IN 'bmx_ a) (list 'IN 'bmx_ b)))
    (lambda ()
      (di)
      (let ((z (cadr (cadr (dk-goal)))))
        (dk-iff! (lambda (g) (equal? g (list 'IN z b)))     ; di lands the antecedent: the leaves are the two memberships
                 (lambda () (fwd z))
                 (lambda () (bwd z))))))
  (dk-cite! 'class-extensionality a b))
(sp (make-wff (bm4-ist (list 'IMPLIES '(IN (CCONT-VONE t) bmi) '(= bmi (CCONT t))))))
(bm4-iopen!)
(bm4-class-ext! 'bmi '(CCONT t)
  (lambda (z) (bm4-in-c! z) (bm4-ass!))
  (lambda (z)
    (dk-cite! 'ccont-vone-type 't)
    (let* ((m (dk-apply! bm4-iH5 z '(CCONT-VONE t)))
           (u (dk-cite! 'ccont-vmul-unit-left 't z)))
      (dk-rewrite-h! m (list '(CCONT-VMUL t) '(CCONT-VONE t) z) z)
      (bm4-ass!))))
(bm4-ass!)
(bm4-qed! 'ccont-ideal-unit-all)
;;; ================================================================================================
;;; part3: the ideals of CCONT-ALGEBRA(t); M_x = {f : f(x) = 0}; the maximal ideals (Remark 1.27)
;;; ================================================================================================
(define (bm4-alg-typings!)            ; the components of CCONT-ALGEBRA(t) typed: the tuple is certified defined
  (for-each (lambda (n) (dk-cite! n 't))
            '(ccont-is-set ccont-vadd-type ccont-vmul-type ccont-vneg-type ccont-vstar-type ccont-act-type
              ccont-vzero-type ccont-vone-type ccont-vnrm-type))
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
(define bm4-accvals '((VEC (CCONT t)) (VZERO (CCONT-VZERO t)) (VADD (CCONT-VADD t)) (ACT (CCONT-ACT t)) (VMUL (CCONT-VMUL t))))
(define (bm4-readoffs!) (for-each (lambda (p) (dk-cite! (symbol-append 'ccont-algebra- (car p)) 't)) bm4-accvals))
(define (bm4-acc-subst! dir)          ; 'down: accessors of A -> values; 'up: values -> accessors
  (for-each (lambda (p)
              (let ((from (list (car p) bm4-A)) (to (cadr p)))
                (if (eq? dir 'down)
                    (if (dk-contains? (dk-goal) from) (subst (list '= from to)))
                    (if (dk-contains? (dk-goal) to) (subst (list '= to from))))))
            bm4-accvals))
(define (bm4-mx x) (list 'SEP 'bmh_ '(CCONT t) (list '= (list 'bmh_ x) 0)))

;;; a two-sided ideal of C(t), read concretely
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'bmi (list 'IMPLIES (list 'IS-TWO-SIDED-IDEAL bm4-A 'bmi)
  (let conj ((hs (bm4-hyps 'bmi))) (if (null? (cdr hs)) (car hs) (list 'AND (car hs) (conj (cdr hs)))))))))))
(dk-peel!)
(bm4-top!)
(bm4-alg-typings!)
(bm4-rhs! (dk-cite! 'is-two-sided-ideal bm4-A 'bmi))
(bm4-rhs! (dk-cite! 'is-right-ideal bm4-A 'bmi))
(bm4-rhs! (dk-cite! 'is-alg-subspace bm4-A 'bmi))
(bm4-readoffs!)
(dk-conj-close! (lambda () (bm4-acc-subst! 'up) (bm4-ass!)))
(bm4-qed! 'ccont-ideal-laws)

;;; M_x is a two-sided ideal
(define (bm4-mx-open! x)              ; open every (IN v M_x) in context: v in CCONT t, v x = 0
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (equal? (caddr h) (bm4-mx x)) (not (dk-asm? (list '= (list (cadr h) x) 0))))
                  (begin (sep-me h) (dk-split-all!))))
            (dk-asms)))
(define (bm4-mx-in! T x)              ; goal (IN T M_x), the members of M_x in context opened: by values
  (in-sep! (lambda () (bm4-cty! T) (bm4-ass!))
    (lambda ()
      (bm4-cev! T x)
      (for-each (lambda (h) (if (and (dk-head-is? h '=) (equal? (caddr h) 0) (pair? (cadr h)) (equal? (cdr (cadr h)) (list x))
                                     (dk-contains? (dk-goal) (cadr h)))
                                (subst h)))
                (dk-asms))
      (if (bm4-open?) (crs)))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t))
  (list 'IS-TWO-SIDED-IDEAL bm4-A (bm4-mx 'x))))))))
(dk-peel!)
(bm4-top!)
(bm4-alg-typings!)
(bm4-readoffs!)
(mac 'is-two-sided-ideal)
(mac 'is-left-ideal)
(mac 'is-right-ideal)
(mac 'is-alg-subspace)
(bm4-acc-subst! 'down)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (bm4-ass!))
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((z (dk-di-var!))) (bm4-mx-open! 'x) (bm4-ass!)))
            ((dk-head-is? g 'IN) (bm4-mx-in! (cadr g) 'x))
            ((dk-head-is? g 'FORALL)
             (dk-peel!)
             (bm4-mx-open! 'x)
             (bm4-mx-in! (cadr (dk-goal)) 'x))
            (#t (error "M_x ideal: unexpected goal" (expression->string g)))))))
(bm4-qed! 'ccont-point-ideal-two-sided)

;;; M_x is proper
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t))
  (list 'NOT (list '= (bm4-mx 'x) '(CCONT t)))))))))
(dk-peel!)
(bm4-top!)
(di)
(dk-cite! 'ccont-vone-type 't)
(dk-have! (list 'IN '(CCONT-VONE t) (bm4-mx 'x)) (lambda () (subst (list '= (bm4-mx 'x) '(CCONT t))) (bm4-ass!)))
(bm4-mx-open! 'x)
(dk-cite! 'ccont-vone-val 't 'x)
(dk-absurd! (dk-rewrite-h! '(= ((CCONT-VONE t) x) 0) '((CCONT-VONE t) x) 1))
(bm4-qed! 'ccont-point-ideal-proper)
;;; ---- M_x is a maximal ideal ----
(define bm4-mxs (bm4-mx 'x))
;;; An ideal J containing M_x and some f with f(x) /= 0: g = f - f(x) 1 is in M_x, so in J;
;;; k = (1/f(x)) (f + (-1) g) is in J and k = 1, so J = C(t).
(define bm4-U '(FORALL bma_ (IMPLIES (IN bma_ CC) (FORALL bmb_ (IMPLIES (IN bmb_ CC) (FORALL bmc_ (IMPLIES (IN bmc_ CC)
  (= (* bmc_ (+ bma_ (* (- 1) (+ bma_ (* (- bmb_) 1))))) (* bmb_ bmc_)))))))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t))
  (list 'IS-MAXIMAL-IDEAL bm4-A (bm4-mx 'x))))))))
(dk-peel!)
(bm4-top!)
(bm4-alg-typings!)
(bm4-readoffs!)
(mac 'is-maximal-ideal)
(bm4-acc-subst! 'down)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (bm4-ass!))
            ((dk-head-is? g 'IS-TWO-SIDED-IDEAL) (dk-cite! 'ccont-point-ideal-two-sided 't 'x) (bm4-ass!))
            ((dk-head-is? g 'NOT) (dk-cite! 'ccont-point-ideal-proper 't 'x) (bm4-ass!))
            (#t
             (let* ((pe (dk-peel!))
                    (J (caddr (car (filter (lambda (h) (dk-head-is? h 'IS-TWO-SIDED-IDEAL)) pe))))
                    (_l (bm4-split-cite! 'ccont-ideal-laws 't J))
                    (JH3 (dk-ctx-form (bm4-H3 J))) (JH4 (dk-ctx-form (bm4-H4 J)))
                    (one '(CCONT-VONE t)))
               (dk-have! bm4-U (lambda () (dk-peel!) (crs)))
               (bm4-class-ext! J bm4-mxs
                 (lambda (z)
                   (dk-cite! 'subset-mem-fwd J '(CCONT t) z)
                   (bm4-cval! z 'x)
                   (use-em (list '= (list z 'x) 0)
                     (lambda () (in-sep! (lambda () (bm4-ass!)) (lambda () (bm4-ass!))))
                     (lambda ()
                       (let* ((c (list z 'x)) (nc (list '- c))
                              (gg (list '(CCONT-VADD t) z (list '(CCONT-ACT t) nc one)))
                              (m1 (list '(CCONT-ACT t) '(- 1) gg))
                              (k1 (list '(CCONT-VADD t) z m1))
                              (r (list 'recip c))
                              (k (list '(CCONT-ACT t) r k1)))
                         (dk-type! nc 'CC)
                         (bm4-cty! gg)
                         (dk-have! (list 'IN gg bm4-mxs) (lambda () (bm4-mx-in! gg 'x)))
                         (dk-cite! 'subset-mem-fwd bm4-mxs J gg)
                         (dk-type! '(- 1) 'CC)
                         (dk-apply! JH4 '(- 1) gg)
                         (dk-apply! JH3 z m1)
                         (dk-have! (list 'AND (list 'IN c 'CC) (list 'NOT (list '= c 0))) (lambda () (bm4-close-ctx!)))
                         (bm4-fact! 'cc-recip-closed c)
                         (bm4-fact! 'cc-recip-inverse c)
                         (dk-apply! JH4 r k1)
                         (bm4-cty! k)
                         (dk-fun-ext! k one '(PTS t) 'CC
                           (lambda () (bm4-split-cite! 'ccont-parts 't k) (bm4-ass!))
                           (lambda () (bm4-split-cite! 'ccont-parts 't one) (bm4-ass!))
                           (lambda (w)
                             (bm4-cev! k w)
                             (if (dk-contains? (dk-goal) (list one w)) (bm4-cev! one w))
                             (subst (dk-apply! (dk-ctx-form bm4-U) (list z w) c r))
                             (bm4-ass!)))
                         (dk-rewrite-h! (list 'IN k J) k one)
                         (let ((e (dk-cite! 'ccont-ideal-unit-all 't J)))
                           (if (dk-only! e (list 'NOT (list '= J '(CCONT t)))) (prop)))))))
                 (lambda (z) (dk-cite! 'subset-mem-fwd bm4-mxs J z) (bm4-ass!)))
               (bm4-ass!)))))))
(bm4-qed! 'ccont-point-ideal-maximal)

;;; ---- every maximal ideal of C(t) is some M_x ----
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'bmi (list 'IMPLIES (list 'IS-MAXIMAL-IDEAL bm4-A 'bmi)
  (list 'FORSOME 'x (list 'AND '(IN x (PTS t)) (list '= 'bmi (bm4-mx 'x))))))))))
(dk-peel!)
(bm4-top!)
(bm4-alg-typings!)
(bm4-readoffs!)
(bm4-rhs! (dk-cite! 'is-maximal-ideal bm4-A 'bmi))
(let* ((np (dk-rewrite-h! (list 'NOT (list '= 'bmi (list 'VEC bm4-A))) (list 'VEC bm4-A) '(CCONT t)))
       (maxc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-TWO-SIDED-IDEAL))) "maximality"))
       (maxc2 (dk-rewrite-h! maxc (list 'VEC bm4-A) '(CCONT t))))
  (bm4-split-cite! 'ccont-ideal-laws 't 'bmi)
  (dk-have! '(NOT (IN (CCONT-VONE t) bmi))
    (lambda () (di) (let ((e (dk-cite! 'ccont-ideal-unit-all 't 'bmi))) (if (dk-only! e np) (prop)))))
  (let* ((x (dk-skolem! (dk-cite! 'ccont-ideal-common-zero 't 'bmi)))
         (_ (dk-split-all!))
         (Kx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ukg_) (dk-contains? h x))) "the common zero"))
         (mxw (bm4-mx x)))
    (dk-have! (list 'SUBSET 'bmi mxw)
      (lambda () (mac 'subset-def)
                 (let ((z (dk-di-var!)))
                   (in-sep! (lambda () (bm4-in-c! z) (bm4-ass!)) (lambda () (dk-apply! Kx z) (bm4-ass!))))))
    (dk-cite! 'ccont-point-ideal-two-sided 't x)
    (dk-cite! 'ccont-point-ideal-proper 't x)
    (dk-apply! maxc2 mxw)
    (ew x)
    (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (bm4-ass!) (begin (subst (list '= 'bmi mxw)) (if (bm4-open?) (rfl))))))))
(bm4-qed! 'ccont-maximal-ideal-is-point)

;;; ---- REMARK 1.27: the maximal ideals of C(t), t compact, are exactly the M_x ----
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'bmi
  (list 'IFF (list 'IS-MAXIMAL-IDEAL bm4-A 'bmi) (list 'FORSOME 'x (list 'AND '(IN x (PTS t)) (list '= 'bmi (bm4-mx 'x))))))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda () (dk-cite! 'ccont-maximal-ideal-is-point 't 'bmi) (bm4-ass!))
  (lambda ()
    (let* ((w (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'bmi))) "the point")))
           (_ (dk-split-all!)))
      (subst (list '= 'bmi (bm4-mx w)))
      (dk-cite! 'ccont-point-ideal-maximal 't w)
      (bm4-ass!))))
(bm4-qed! 'ccont-maximal-ideals)

;;; ---- t Hausdorff: distinct points give distinct maximal ideals ----
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS t)) (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS t))
    (list 'IMPLIES '(NOT (= x y)) (list 'NOT (list '= (bm4-mx 'x) (bm4-mx 'y)))))))))))))
(dk-peel!)
(bm4-top!)
(di)
(dk-cite! 'ccont-is-set 't)
(let* ((ne (dk-cite! 'point-eval-injective 't 'x 'y))
       (evx '(POINT-EVAL t x)) (evy '(POINT-EVAL t y))
       (ty! (lambda (p ev)
              (dk-have! (list 'IN ev '(FUN (CCONT t) CC))
                (lambda () (mac 'POINT-EVAL)
                           (dk-lam-type! (lambda () (let ((f (dk-di-var!))) (bm4-cval! f p) (bm4-ass!))) (lambda () (bm4-ass!))))))))
  (ty! 'x evx) (ty! 'y evy)
  (dk-fun-ext! evx evy '(CCONT t) 'CC #f #f
    (lambda (f)
      (subst (dk-cite! 'point-eval-val 't 'x f))
      (subst (dk-cite! 'point-eval-val 't 'y f))
      (bm4-cval! f 'x) (bm4-cval! f 'y)
      (let* ((c (list f 'x)) (one '(CCONT-VONE t))
             (gg (list '(CCONT-VADD t) f (list '(CCONT-ACT t) (list '- c) one)))
             (V (list '+ (list f 'y) (list '* (list '- c) 1))))
        (dk-type! (list '- c) 'CC)
        (bm4-cty! gg)
        (dk-have! (list 'IN gg (bm4-mx 'x)) (lambda () (bm4-mx-in! gg 'x)))
        (dk-rewrite-h! (list 'IN gg (bm4-mx 'x)) (bm4-mx 'x) (bm4-mx 'y))
        (bm4-mx-open! 'y)
        (dk-have! (list '= (list gg 'y) V) (lambda () (bm4-cev! gg 'y) (if (bm4-open?) (rfl))))
        (let* ((e0 (dk-rewrite-h! (list '= (list gg 'y) 0) (list gg 'y) V))
               (e1 (dk-have! (list '= c (list '- (list f 'y) V)) (lambda () (crs))))
               (e2 (dk-rewrite-h! (list '= c (list '- (list f 'y) V)) V 0)))
          (dk-have! (list '= (list '- (list f 'y) 0) (list f 'y)) (lambda () (crs)))
          (subst (list '= c (list '- (list f 'y) 0)))
          (bm4-ass!)))))
  (if (dk-only! (list '= evx evy) ne) (prop)))
(bm4-qed! 'ccont-point-ideal-injective)
