(define (bm4-nth-loop!)
  (let loop ((k 0)) (if (and (< k 40) (bm4-open?) (dk-contains? (dk-goal) 'NTH))
                        (let ((g (dk-goal))) (quietly (lambda () (nth-r))) (if (not (equal? g (dk-goal))) (loop (+ k 1)))))))
(define (bm4-slots!)                  ; slot and nth-r to a fixpoint (view and source share accessor names)
  (let loop ((k 0))
    (if (and (< k 6) (bm4-open?))
