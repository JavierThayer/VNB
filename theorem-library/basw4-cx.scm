          (for-each (lambda (a) (if (and (bm4-open?) (dk-contains? (dk-goal) a)) (quietly (lambda () (slot a))))) bm4-accs)
          (bm4-nth-loop!)
          (if (and (bm4-open?) (not (equal? g (dk-goal)))) (loop (+ k 1)))))))

