                (dk-cite! 'subspace-dist 's (list 'E k) (list hk xk) (car (list (list hk (list y k)))))
                (dk-rewrite-h! (list '<= (list (list 'DIST subk) (list hk xk) (list hk (list y k))) eps)
                               (list (list 'DIST subk) (list hk xk) (list hk (list y k)))
                               (list '(DIST s) (list hk xk) (list hk (list y k))))))))))
