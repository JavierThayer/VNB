         (_1 (dk-split-all!))
         (dclH (mr-find 'dclH (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl) (dk-contains? f hk))) (dk-asms)))
         (prj (list 'PRODUCT-PROJ mlv-T k))
         (_2 (dk-cite! 'product-projection-continuous mlv-T mli-w0 k))
