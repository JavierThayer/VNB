              (subst (list '= vx vy))
              (rfl)))
          (let ((hj (mr-find 'ij (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list mlv-H k)) (dk-contains? f (list 'PTS (list mlv-T k)))
                                                   (not (dk-contains? f 'mzx_)) (not (dk-contains? f 'IS-CONTINUOUS-AT)) (not (dk-contains? f 'FUN)) (dk-contains? f '=)))
                              (dk-asms))))
            (let ((i1 (dk-apply! hj (list x k)))) (dk-apply! i1 (list y k))))
          (mr-close-open!)))
      (mr-close-open!))))
;; the image
(dk-have! (list '= (list 'IMAGE (mli-hI) (list 'PTS mli-TZ)) mli-I)
  (lambda ()
    (subst (list '= (list 'PTS mli-TZ) (mli-Z)))
    (mr-ext2! (list 'IMAGE (mli-hI) (mli-Z)) mli-I
      (lambda (p)
        (let* ((ps (mr-iff-parts! (dk-cite! 'image-membership-iff (mli-hI) (mli-Z) p)))
               (z (dk-skolem! (cadr ps))))
          (dk-split-all!)
          (let ((vz (mli-hval! z)))
            (subst (list '= p (list (mli-hI) z)))
            (subst (list '= (list (mli-hI) z) vz))
            (mr-close-open!))))
      (lambda (p)
        (let* ((z (dk-skolem! (dk-apply! mli-B p)))
               (_0 (dk-split-all!))
               (vz (mli-hval! z)))
          (dk-cite! 'subset-mem-fwd mli-I '(PTS s) p)
          (dk-cite! 'membership-implies-sethood p '(PTS s))
          (mac 'image-membership-iff)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (begin (ew z)
                         (dk-conj-close!
                           (lambda () (if (dk-asm? (dk-goal)) (ass)
                                          (begin (subst (list '= (list (mli-hI) z) vz)) (mr-close-open!))))))))))))
    (mr-close-open!)))
(let ((iff (dk-cite! 'is-lusin 's mli-I)))
  (dk-have! (caddr iff)
    (lambda ()
      (ew mli-TZ)
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew (mli-hI))
                (mr-and-close! (lambda () (mr-close-open!)))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'lusin-countable-intersection)
(topic! 'lusin-countable-intersection 'analysis)

;;; ======================================================================
;;; COROLLARY 5.21: the nonempty Borel subsets of a Polish space are Lusin
;;; ======================================================================
(define mlb-B '(SEP lb_ (POWER (PTS s)) (IMPLIES (FORSOME mlx_ (IN mlx_ lb_)) (IS-LUSIN s lb_))))
(define (mlb-inter g) (list 'SEP 'mbq_ '(PTS s) (list 'FORALL 'mbn_ (list 'IMPLIES '(IN mbn_ NN) (list 'IN 'mbq_ (list g 'mbn_))))))
(define (mlb-disj g) (list 'FORALL 'mbi_ (list 'IMPLIES '(IN mbi_ NN) (list 'FORALL 'mbj_ (list 'IMPLIES '(IN mbj_ NN)
  (list 'FORALL 'mbx_ (list 'IMPLIES (list 'IN 'mbx_ (list g 'mbi_)) (list 'IMPLIES (list 'IN 'mbx_ (list g 'mbj_)) '(= mbi_ mbj_)))))))))
(define (mlb-power! a)               ; a subset PTS s in context: a in POWER(PTS s)
  (let ((g0 (list 'IN a '(POWER (PTS s)))))
    (if (not (dk-asm? g0))
        (begin
          (dk-cite! 'ms-pts-is-set 's)
          (dk-cite! 'subclass-of-set-is-set a '(PTS s))
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ a) '(IN z_ (PTS s))))
            (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd a '(PTS s) z) (mr-close-open!))))
          (dk-cite! 'power-mem-intro '(PTS s) a)))
    g0))
(define (mlb-gk! g k)                ; g in FUN(NN, B), k in NN: g(k) in POWER(PTS s); returns the implication
  (dk-cite! 'fun-apply-type-c g 'NN mlb-B k)
  (mr-sep-parts! (list 'IN (list g k) mlb-B)))
(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (FORALL b (IMPLIES (IN b (BOREL-SETS s)) (IMPLIES (FORSOME x (IN x b)) (IS-LUSIN s b))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-complete 's))
(dk-cite! 'ms-pts-is-set 's)
(fact 'nn-is-set)
(dk-have! (list 'SUBSET mlb-B '(POWER (PTS s)))
  (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w mlb-B)) (mr-close-open!))))
;; countable intersections
(dk-have! (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'FUN 'NN mlb-B)) (list 'IN (mlb-inter 'g) mlb-B)))
  (lambda ()
    (let* ((g (dk-di-var!)) (I (mlb-inter g)))
      (dk-cite! 'fun-codomain-superset g 'NN mlb-B '(POWER (PTS s)))
      (dk-have! (list 'SUBSET I '(PTS s)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w I)) (mr-close-open!))))
      (mlb-power! I)
      (in-sep!
        (lambda ()
          (di)
          (let* ((x (dk-skolem! (list 'FORSOME 'mlx_ (list 'IN 'mlx_ I))))
                 (xk (mr-sep-parts! (list 'IN x I))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-LUSIN 's (list g 'k))))
              (lambda ()
                (let* ((k (dk-di-var!)) (imp (mlb-gk! g k)))
                  (dk-apply! xk k)
                  (dk-have! (list 'FORSOME 'mlx_ (list 'IN 'mlx_ (list g k))) (lambda () (ew x) (mr-close-open!)))
                  (mr-chain! imp)
                  (mr-close-open!))))
            (dk-have! (list 'FORSOME 'x (list 'IN 'x I)) (lambda () (ew x) (mr-close-open!)))
            (mr-chain! (dk-cite! 'lusin-countable-intersection 's g))
            (mr-close-open!)))))))
;; countable disjoint unions
(dk-have! (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'FUN 'NN mlb-B)) (list 'IMPLIES (mlb-disj 'g) (list 'IN '(BIG-UNION n_ NN (g n_)) mlb-B))))
  (lambda ()
    (let* ((lg (dk-peel!))
           (g (cadr (mr-find 'gg (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'FUN 'NN mlb-B)))) lg)))
           (U (list 'BIG-UNION 'n_ 'NN (list g 'n_))))
      (dk-cite! 'fun-codomain-superset g 'NN mlb-B '(POWER (PTS s)))
      (dk-have! (list 'SUBSET U '(PTS s))
        (lambda () (mac 'subset-def)
          (let* ((w (dk-di-var!)) (ka (mr-bu-open! w U)) (k (car ka)))
            (dk-cite! 'fun-apply-type-c g 'NN '(POWER (PTS s)) k)
            (dk-cite! 'power-mem-in '(PTS s) (list g k) w)
            (mr-close-open!))))
      (mlb-power! U)
      (in-sep!
        (lambda ()
          (di)
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list 'FORSOME 'mlx_ (list 'IN 'mlx_ (list g 'k))) (list 'IS-LUSIN 's (list g 'k)))))
            (lambda () (let ((k (dk-di-var!))) (mlb-gk! g k) (mr-close-open!))))
          (mr-chain! (dk-cite! 'lusin-disjoint-union 's g))
          (mr-close-open!))))))
;; open sets
(dk-have! '(FORALL u (IMPLIES (IS-OPEN s u) (IN u (SEP lb_ (POWER (PTS s)) (IMPLIES (FORSOME mlx_ (IN mlx_ lb_)) (IS-LUSIN s lb_))))))
  (lambda ()
    (let* ((lu (dk-peel!)) (u (caddr (car lu))))
      (mr-iff-parts! (dk-cite! 'is-open 's u))
      (mlb-power! u)
      (in-sep! (lambda () (di) (dk-cite! 'is-polish 's) (mr-chain! (dk-cite! 'lusin-open 's u)) (mr-close-open!))))))
(mr-chain! (dk-cite! 'borel-from-inter-disjoint-union 's mlb-B))
(dk-cite! 'subset-mem-fwd '(BOREL-SETS s) mlb-B 'b)
(mr-chain! (mr-sep-parts! (list 'IN 'b mlb-B)))
(mr-close-open!)
(qed 'borel-polish-lusin)
(topic! 'borel-polish-lusin 'analysis)
