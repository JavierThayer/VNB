;;; mb67-lusin2.scm -- construction of measures, chapter 5 section 1.5 (M-B67, 2026-10-26): Lusin sets are closed under
;;; countable disjoint unions and countable intersections (Proposition 5.20); the Borel subsets of a Polish space are
;;; Lusin (Corollary 5.21).
;;;   lusin-disjoint-union      5.20, unions (members Lusin or empty; the union nonempty)
;;;   lusin-countable-intersection   5.20, intersections (nonempty)
;;;   borel-polish-lusin        5.21 (nonempty Borel sets)
;;; Library: measure.  Helper prefixes mr- (copied) and mlv-.
;;; Load window: after mb67-sum (SUM-MS), mb67-prod (product-polish), mb67-lusin (borel-from-inter-disjoint-union,
;;; lusin-open), mb4-polish-open (coarser-metric-separable), riesz-markov-model (rmm-nn-choice).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define (mlv-near sp A T)            ; the continuity hypothesis of coarser-metric-separable for T = SUBSPACE-MS(sp, A)
  (list 'FORALL 'gx_ (list 'IMPLIES (list 'IN 'gx_ A) (list 'FORALL 'ge_ (list 'IMPLIES '(POS-RR ge_) (list 'FORSOME 'gd_ (list 'AND '(POS-RR gd_)
    (list 'FORALL 'gy_ (list 'IMPLIES (list 'IN 'gy_ A) (list 'IMPLIES (list '<= (list (list 'DIST sp) 'gx_ 'gy_) 'gd_) (list '< (list (list 'DIST T) 'gx_ 'gy_) 'ge_)))))))))))
(define (mlv-near! sp A T)           ; A subset PTS sp, IS-METRIC-SPACE sp, A a set
  (dk-have! (mlv-near sp A T)
    (lambda ()
      (let* ((lx (dk-peel!))
             (x (cadr (mr-find 'vnx (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) A))) lx)))
             (e (cadr (mr-find 'vne (lambda (f) (dk-head-is? f 'POS-RR)) lx)))
             (d (dk-halve! e)))
        (ew d)
        (mr-and-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let* ((ly (dk-peel!))
                       (y (cadr (mr-find 'vny (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) A))) ly)))
                       (dxy (list (list 'DIST sp) x y)))
                  (dk-cite! 'subset-mem-fwd A (list 'PTS sp) x)
                  (dk-cite! 'subset-mem-fwd A (list 'PTS sp) y)
                  (dk-cite! 'metric-dist-real sp x y)
                  (dk-cite! 'subspace-dist sp A x y)
                  (subst (list '= (list (list 'DIST T) x y) dxy))
                  (dk-cite! 'rr-pos-rr-in-rr e)
                  (dk-ineq! (list '<= dxy d) (list '= (list '+ d d) e) (list '< 0 d) (list 'IN dxy 'RR) (list 'IN d 'RR) (list 'IN e 'RR))))))))))
(define (mlv-polish-sub! sp A)       ; sp Polish (complete, separable in context), A closed and nonempty: SUBSPACE-MS(sp, A) complete, separable
  (let ((T (list 'SUBSPACE-MS sp A)))
    (dk-cite! 'ms-pts-is-set sp)
    (dk-cite! 'subclass-of-set-is-set A (list 'PTS sp))
    (dk-cite! 'subspace-complete sp A)
    (dk-cite! 'subspace-is-metric-space sp A)
    (dk-cite! 'subspace-pts sp A)
    (mlv-near! sp A T)
    (mr-chain! (dk-cite! 'coarser-metric-separable sp A T))
    T))

;;; ======================================================================
;;; PROPOSITION 5.20: countable disjoint unions
;;; ======================================================================
(define mlv-ne (lambda (e) (list 'FORSOME 'mlx_ (list 'IN 'mlx_ e))))
(define (mlv-inj t h) (list 'FORALL 'lzx_ (list 'IMPLIES (list 'IN 'lzx_ (list 'PTS t)) (list 'FORALL 'lzy_ (list 'IMPLIES (list 'IN 'lzy_ (list 'PTS t))
  (list 'IMPLIES (list '= (list h 'lzx_) (list h 'lzy_)) '(= lzx_ lzy_)))))))
(define (mlv-wit t h e) (list 'AND (list 'IS-CONTINUOUS t (list 'SUBSPACE-MS 's e) h) (list 'AND (list '= (list 'IMAGE h (list 'PTS t)) e) (mlv-inj t h))))
(define mlv-hypL '(FORALL k (IMPLIES (IN k NN) (IMPLIES (FORSOME mlx_ (IN mlx_ (E k))) (IS-LUSIN s (E k))))))
(define mlv-disj '(FORALL mbi_ (IMPLIES (IN mbi_ NN) (FORALL mbj_ (IMPLIES (IN mbj_ NN)
  (FORALL mbx_ (IMPLIES (IN mbx_ (E mbi_)) (IMPLIES (IN mbx_ (E mbj_)) (= mbi_ mbj_)))))))))
(define mlv-U '(BIG-UNION n_ NN (E n_)))
(define mlv-fam1 (list 'VNB-LAMBDA 'mlk_ 'NN (list 'SEP 'mlt_ 'METRIC-SPACE
  (list 'AND '(IS-COMPLETE mlt_) (list 'AND '(IS-SEPARABLE mlt_)
    (list 'IMPLIES (mlv-ne '(E mlk_)) (list 'FORSOME 'mlh_ (list 'AND '(IN mlh_ SET) (mlv-wit 'mlt_ 'mlh_ '(E mlk_))))))))))
;;; NBGSEP (2026-10-28): in FAM1 the map mlh_ is bounded by mlh_ in SET (implied: it is a member of a
;;; FUN class), so the separation is predicative (NBG).  WIT-CLOSE! closes the guarded existential from
;;; the IS-LUSIN witness in context (T a skolemised space, K the index).
(define (mlv-wit-close! t0 k)
  (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0) (dk-contains? f 'IS-CONTINUOUS)))
                      "the Lusin map"))
         (h0 (dk-skolem! ex)))
    (vnb-guard (lambda () (dk-split-all!)))
    (mr-iff-parts! (dk-cite! 'is-continuous t0 (list 'SUBSPACE-MS 's (list 'E k)) h0))
    (dk-cite! 'membership-implies-sethood h0 (list 'FUN (list 'PTS t0) (list 'PTS (list 'SUBSPACE-MS 's (list 'E k)))))
    (ew h0)
    (mr-and-close! (lambda () (mr-close-open!)))))
(define mlv-T #f) (define mlv-Tin #f) (define mlv-H #f) (define mlv-Hin #f)
(define (mlv-fam2) (list 'VNB-LAMBDA 'mlk_ 'NN (list 'SEP 'mlh_ 'SET (list 'IMPLIES (mlv-ne '(E mlk_)) (mlv-wit (list mlv-T 'mlk_) 'mlh_ '(E mlk_))))))
(define (mlv-T! k)                   ; T(k) a complete separable metric space; returns the implication to a witness
  (let ((tk (list mlv-T k)))
    (if (not (dk-asm? (list 'IS-COMPLETE tk)))
        (begin
          (dk-cite! 'fun-apply-type-c mlv-T 'NN 'METRIC-SPACE k)
          (dk-apply! mlv-Tin k)
          (dk-split-all! (list (mr-sep-parts! (list 'IN tk (subst-free 'mlk_ k (cadddr mlv-fam1))))))
          (mr-iff-parts! (dk-cite! 'metric-space-class tk))))
    tk))
(define (mlv-H! k)                   ; E(k) nonempty in context: the witness facts for (T k, H k)
  (let ((tk (mlv-T! k)) (hk (list mlv-H k)))
    (if (not (dk-asm? (list 'IS-CONTINUOUS tk (list 'SUBSPACE-MS 's (list 'E k)) hk)))
        (begin
          (dk-cite! 'fun-apply-type-c mlv-H 'NN 'SET k)
          (dk-apply! mlv-Hin k)
          (let ((imp (mr-sep-parts! (list 'IN hk (subst-free 'mlk_ k (cadddr (mlv-fam2)))))))
            (dk-split-all! (list (mr-chain! imp))))
          (dk-cite! 'fun-apply-type-c 'E 'NN '(POWER (PTS s)) k)
          (dk-cite! 'ms-pts-is-set 's)
          (dk-have! (list 'SUBSET (list 'E k) '(PTS s)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS s) (list 'E k) w) (mr-close-open!))))
          (dk-cite! 'subclass-of-set-is-set (list 'E k) '(PTS s))
          (dk-cite! 'subspace-pts 's (list 'E k))
          (let ((cp (mr-iff-parts! (dk-cite! 'is-continuous tk (list 'SUBSPACE-MS 's (list 'E k)) hk))))
            (dk-rewrite-h! (list 'IN hk (list 'FUN (list 'PTS tk) (list 'PTS (list 'SUBSPACE-MS 's (list 'E k))))) (list 'PTS (list 'SUBSPACE-MS 's (list 'E k))) (list 'E k)))))
    hk))

(define (mlv-choose! wbody cls ne)     ; wbody: a class term in the free symbol mlk_, a SEP over cls; ne: the proven
  ;; universal (FORALL k (IMPLIES (IN k NN) (FORSOME y (IN y W(k))))).  Returns Fz with Fz in FUN(NN, cls) and
  ;; (FORALL k (IMPLIES (IN k NN) (IN (Fz k) W(k)))) landed.
  (let* ((W (lambda (k) (subst-free 'mlk_ k wbody)))
         (L (list 'VNB-LAMBDA 'mlk_ 'NN (list 'CHOICE wbody)))
         (pick! (lambda (k)
                  (dk-apply! ne k)
                  (mr-chain! (dk-cite! 'choice-axiom (W k)))
                  (mr-sep-parts! (list 'IN (list 'CHOICE (W k)) (W k))))))
    (dk-have! (list 'IN L (list 'FUN 'NN cls))
      (lambda ()
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass)
                                   (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                     (pick! k)
                                     (mr-close-open!))))))
                  (dk-opened (lambda () (lam-t))))))
    (let ((ex (list 'FORSOME 'mlf_ (list 'AND (list 'IN 'mlf_ (list 'FUN 'NN cls))
                (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN '(mlf_ k) (W 'k))))))))
      (dk-have! ex
        (lambda ()
          (ew L)
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (let ((k (dk-di-var!)))
                    (pick! k)
                    (dk-lam-b!)
                    (mr-close-open!)))))))
      (let ((Fz (dk-skolem! ex)))
        (dk-split-all!)
        Fz))))

(define (mlv-witnesses!)             ; mlv-hypL in context: choose T(k) and H(k) (sets mlv-T, mlv-Tin, mlv-H, mlv-Hin)
;; choose the parametrising spaces
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'IN 'y (subst-free 'mlk_ 'k (cadddr mlv-fam1))))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (use-em (mlv-ne (list 'E k))
        (lambda ()
          (dk-apply! mlv-hypL k)
          (let* ((lp (mr-iff-parts! (dk-cite! 'is-lusin 's (list 'E k))))
                 (t0 (dk-skolem! (car lp))))
            (dk-split-all!)
            (mr-iff-parts! (dk-cite! 'is-complete t0))
            (mr-iff-back! (dk-cite! 'metric-space-class t0))
            (ew t0)
            (in-sep! (lambda () (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (di) (mlv-wit-close! t0 k)))))))))
        (lambda ()
          (mr-iff-back! (dk-cite! 'metric-space-class 'BAIRE-MS))
          (ew 'BAIRE-MS)
          (in-sep! (lambda () (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                          (begin (di) (ai (list 'NOT (mlv-ne (list 'E k)))))))))))))))
(set! mlv-T (mlv-choose! (cadddr mlv-fam1) 'METRIC-SPACE (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'IN 'y (subst-free 'mlk_ 'k (cadddr mlv-fam1)))))))))
(set! mlv-Tin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mlv-T) (dk-contains? f 'mlt_))) "T choice"))
;; choose the parametrising maps
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'IN 'y (subst-free 'mlk_ 'k (cadddr (mlv-fam2)))))))
  (lambda ()
    (let* ((k (dk-di-var!)) (tk (mlv-T! k)))
      (use-em (mlv-ne (list 'E k))
        (lambda ()
          (let* ((imp (mr-find 'timp (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f tk) (dk-contains? f 'mlh_))) (dk-asms)))
                 (ex (mr-chain! imp))
                 (h0 (dk-skolem! ex)))
            (vnb-guard (lambda () (dk-split-all!)))
            (let ((cp (mr-iff-parts! (dk-cite! 'is-continuous tk (list 'SUBSPACE-MS 's (list 'E k)) h0))))
              (dk-cite! 'membership-implies-sethood h0 (list 'FUN (list 'PTS tk) (list 'PTS (list 'SUBSPACE-MS 's (list 'E k))))))
            (ew h0)
            (in-sep! (lambda () (di) (mr-and-close! (lambda () (mr-close-open!)))))))
        (lambda ()
          (ew '(PTS s))
          (in-sep! (lambda () (di) (ai (list 'NOT (mlv-ne (list 'E k)))))))))))
(set! mlv-H (mlv-choose! (cadddr (mlv-fam2)) 'SET (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'IN 'y (subst-free 'mlk_ 'k (cadddr (mlv-fam2))))))))))
(set! mlv-Hin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mlv-H) (dk-contains? f 'mlh_))) "H choice"))
  #t)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'E (list 'IMPLIES '(IN E (FUN NN (POWER (PTS s))))
  (list 'IMPLIES mlv-hypL (list 'IMPLIES mlv-disj (list 'IMPLIES (mlv-ne mlv-U) (list 'IS-LUSIN 's mlv-U))))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'baire-ms-complete) (dk-cite! 'baire-ms-separable) (dk-cite! 'baire-ms-is-metric-space)
(mlv-witnesses!)
;; the disjoint sum of the T(k), and its closed part Zs over the nonempty E(k)
(define (mlv-ST) (list 'SUM-MS mlv-T))
(define (mlv-SP) (list 'SUM-PTS mlv-T))
(define (mlv-Zs) (list 'SEP 'mzq_ (mlv-SP) (mlv-ne '(E (NTH 1 mzq_)))))
(define (mlv-dS a b) (list (list 'DIST (mlv-ST)) a b))
(dk-have! (list 'IS-MS-SEQUENCE mlv-T)
  (lambda ()
    (let ((iff (dk-cite! 'is-ms-sequence mlv-T)))
      (dk-have! (caddr iff) (lambda () (let ((k (dk-di-var!))) (mlv-T! k) (mr-close-open!))))
      (mr-iff-back! iff)
      (mr-close-open!))))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IS-POLISH (list mlv-T 'n))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (mlv-T! k)
      (let ((iff (dk-cite! 'is-polish (list mlv-T k))))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
        (mr-iff-back! iff))
      (mr-close-open!))))
(dk-cite! 'sum-ms-polish mlv-T)
(mr-iff-parts! (dk-cite! 'is-polish (mlv-ST)))
(dk-cite! 'sum-ms-is-metric-space mlv-T)
(dk-cite! 'sum-ms-pts mlv-T)
(dk-cite! 'sum-pts-is-set mlv-T)
(define (mlv-zs-parts! p)            ; p in Zs: p in SP, p = [k, v], k in NN, v in PTS(T k), E(k) nonempty; returns (k v)
  (let ((k (list 'NTH 1 p)) (v (list 'NTH 2 p)))
    (if (not (dk-asm? (list 'IN k 'NN)))
        (begin
          (mr-sep-parts! (list 'IN p (mlv-Zs)))
          (dk-split-all! (list (dk-cite! 'sum-pts-parts mlv-T p)))
          (mlv-T! k)))
    (list k v)))
(dk-have! (list 'SUBSET (mlv-Zs) (mlv-SP))
  (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w (mlv-Zs))) (mr-close-open!))))
(dk-have! (list 'SUBSET (mlv-Zs) (list 'PTS (mlv-ST)))
  (lambda () (subst (list '= (list 'PTS (mlv-ST)) (mlv-SP))) (mr-close-open!)))
(dk-cite! 'subclass-of-set-is-set (mlv-Zs) (mlv-SP))
;; Zs is closed
(define mlv-C #f)
(dk-have! (list 'IS-CLOSED (mlv-ST) (mlv-Zs))
  (lambda ()
    (let ((iff (dk-cite! 'is-closed (mlv-ST) (mlv-Zs))) (C (list 'COMPLEMENT-IN (list 'PTS (mlv-ST)) (mlv-Zs))))
      (dk-cite! 'complement-in-subset (mlv-Zs) (list 'PTS (mlv-ST)))
      (dk-have! (list 'IS-OPEN (mlv-ST) C)
        (lambda ()
          (let ((iff2 (dk-cite! 'is-open (mlv-ST) C)))
            (dk-have! (caddr iff2)
