         (r (dk-skolem! (dk-apply! (list-ref pparts 4) dl)))
         (_4 (dk-split-all!))
         (dclP (mr-find 'dclP (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f prj))) (dk-asms)))
         (pv! (lambda (z)              ; ((PRODUCT-PROJ T k) z) = z(k), z in PC
                (let ((eqn (list '= (list prj z) (list z k))))
                  (if (not (dk-asm? eqn))
                      (begin
                        (dk-cite! 'product-carrier-coord mlv-T z k)
                        (dk-have! eqn (lambda () (mac 'PRODUCT-PROJ) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))))
    (pv! x)
    (cons r
          (lambda (y)
