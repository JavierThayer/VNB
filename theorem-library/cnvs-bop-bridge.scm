;;; cnvs2-bop.scm -- THE BOUNDED OPERATORS OF BA-BH ARE THOSE OF CNVS (agent CNVS2, 2026-11-10).
;;; All PROVEN modulo 0.  Destination: theorem-library/cnvs-bop-bridge.scm.
;;; Library: operator-algebras (it states with BA-BH's BOUNDED-OPS / OPNORM / BOP-NORMED-AG).
;;;
;;; For complex inner-product spaces v, w, write CV = CIPS-CNVS(v), CW = CIPS-CNVS(w) (cnvs-vocab):
;;;   bops-cnvs-bops-eq      L(v, w) = CNVS-BOUNDED-OPS(CV, CW)               (membership both ways)
;;;   opnorm-body-cnvs-iff   the two SEP conditions of OPNORM and CNVS-OPNORM agree at each real e
;;;   opnorm-cnvs-opnorm     OPNORM(v, w, t) == CNVS-OPNORM(CV, CW, t), t in FUN(VEC v, VEC w)
;;;                          (THE SEP CONGRUENCE: the conditions differ by IP-NORM against
;;;                          VNRM(CV) UNDER the binder, where no rewrite reaches; cn2b-sep-eq!)
;;;   bop-vadd-cnvs, bop-zero-cnvs, bop-vinv-cnvs   the operations, by unfolding (==)
;;;   bop-vnrm-cnvs          BOP-VNRM(v, w) = CBOP-VNRM(CV, CW)               (function extensionality)
;;;   bop-normed-ag-cnvs     BOP-NORMED-AG(v, w) == CBOP-NORMED-AG(CV, CW)    THE TUPLE EQUATION
;;;   bop-complete-via-cnvs  BA-BH2's bop-complete, same statement, as an instance of cbop-complete
;;;                          (a DECLARED ALTERNATIVE proof: route "via the CNVS bounded operators").
;;;
;;; Helper prefix: cn2b-.  Binders: cn2e_ (extensionality), cn2t_.
;;; LOAD WINDOW: after theorem-library/cnvs-c (cips-cnvs-*, hilbert-cnvs-is-cbs), cnvs-d (cbop-*,
;;; cnvs-opnorm-in-rr, cbops-is-set, cbop-vnrm-value, cbop-complete), ba-bh (bop-fun, bop-add,
;;; bop-act, bop-bound-exists, bop-intro, opnorm-in-rr) and ba-bh2 (bounded-ops-is-set,
;;; bop-vnrm-value).  Nothing cites it.  Library: operator-algebras.

(define (cn2b-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cnvs2-bop: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cnvs2-bop: unfinished" name))))

;;; the SEP congruence device of cnvs2-sep.scm (file-local copy: one file per environment)
(define (cn2b-sep-eq! s1 s2 iff!)
  (if (not (and (dk-head-is? s1 'SEP) (dk-head-is? s2 'SEP) (equal? (caddr s1) (caddr s2))))
      (error "cn2b-sep-eq!: not two SEPs over one domain" (expression->string s1) (expression->string s2)))
  (let ((ext (list 'FORALL 'cn2e_ (list 'IFF (list 'IN 'cn2e_ s1) (list 'IN 'cn2e_ s2)))))
    (dk-have! ext
      (lambda ()
        (let ((e (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (define (dir! from fwd?)
            (sep-me (list 'IN e from))
            (let* ((iff (iff! e))
                   (a   (if fwd? (cadr iff) (caddr iff)))
                   (b   (if fwd? (caddr iff) (cadr iff))))
              (in-sep! (lambda () (ass))
                       (lambda ()
                         (ai iff)
                         (detach! (list 'IMPLIES a b))
                         (ass)))))
          (dk-iff! (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) s2)))
                   (lambda () (dir! s1 #t))
                   (lambda () (dir! s2 #f))))))
    (fact 'class-extensionality s1 s2)
    (list '= s1 s2)))

(define cn2b-CV '(CIPS-CNVS v))
(define cn2b-CW '(CIPS-CNVS w))
(define cn2b-BO '(BOUNDED-OPS v w))
(define cn2b-CBO '(CNVS-BOUNDED-OPS (CIPS-CNVS v) (CIPS-CNVS w)))
(define cn2b-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w)))

;;; subst EQ (A -> B) in the goal when the goal contains A
(define (cn2b-rw! a b)
  (if (dk-contains? (dk-goal) a) (subst (list '= a b))))
;;; the read-offs VEC / VADD / VZERO / VNEG of CV, CW, landed as == equations
(define (cn2b-setup!)                   ; IS-CNVS(CV), IS-CNVS(CW): certifies CV, CW DEFINED
  (dk-cite! 'cips-cnvs-is-cnvs 'v)
  (dk-cite! 'cips-cnvs-is-cnvs 'w))
(define (cn2b-readoffs! . accs)
  (cn2b-setup!)
  (for-each (lambda (acc)
              (dk-cite! (symbol-append 'cips-cnvs- acc) 'v)
              (dk-cite! (symbol-append 'cips-cnvs- acc) 'w))
            accs))
(define (cn2b-to-plain!)                ; rewrite the CV / CW read-offs to v / w in the goal
  (for-each (lambda (acc)
              (cn2b-rw! (list acc cn2b-CV) (list acc 'v))
              (cn2b-rw! (list acc cn2b-CW) (list acc 'w)))
            '(VEC VADD VZERO VNEG)))
(define (cn2b-to-cnvs!)                 ; the other way
  (for-each (lambda (acc)
              (cn2b-rw! (list acc 'v) (list acc cn2b-CV))
              (cn2b-rw! (list acc 'w) (list acc cn2b-CW)))
            '(VEC VADD)))
(define (cn2b-tx! t x)                  ; (IN (t x) (VEC w))
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) x))
(define (cn2b-in-cv! x)                 ; (IN x (VEC CV)) from (IN x (VEC v))
  (let ((f (list 'IN x (list 'VEC cn2b-CV))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '= (list 'VEC cn2b-CV) '(VEC v))) (ass))))
    f))

;;; ==========================================================================================
;;; L(v, w) = CNVS-BOUNDED-OPS(CV, CW)
;;; ==========================================================================================
;;; forward: t in L(v, w) -> t in CNVS-BOUNDED-OPS(CV, CW)
(define (cn2b-fwd! t)
  (dk-cite! 'bop-fun 'v 'w t)
  (let* ((m   (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w t)))
         (bnd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq m (free-vars h))
                                        (dk-contains? h 'IP-NORM)))
                       "the IP-NORM bound")))
    (dk-have! (list 'IS-CNVS-LINEAR-OP cn2b-CV cn2b-CW t)
      (lambda ()
        (mac 'IS-CNVS-LINEAR-OP)
        (cn2b-to-plain!)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-contains? (dk-goal) (list 'CACT cn2b-CV))
                   (dk-peel!)
                   (let* ((ap (cadr (cadr (dk-goal)))) (c (cadr ap)) (x (caddr ap)))
                     (cn2b-tx! t x)
                     (subst (dk-cite! 'cips-cnvs-cact 'v c x))
                     (subst (dk-cite! 'cips-cnvs-cact 'w c (list t x)))
                     (dk-cite! 'bop-act 'v 'w t c x)
                     (ass)))
                  (#t
                   (dk-peel!)
                   (let* ((ap (cadr (cadr (dk-goal)))) (x (cadr ap)) (y (caddr ap)))
                     (dk-cite! 'bop-add 'v 'w t x y)
                     (ass))))))))
    (dk-have! (list 'FORALL 'cbx_ (list 'IMPLIES (list 'IN 'cbx_ (list 'VEC cn2b-CV))
                (list '<= (list (list 'VNRM cn2b-CW) (list t 'cbx_))
                          (list '* m (list (list 'VNRM cn2b-CV) 'cbx_)))))
      (lambda ()
        (cn2b-to-plain!)
        (dk-peel!)
        (let ((x (cadr (caddr (caddr (dk-goal))))))
          (cn2b-tx! t x)
          (subst (dk-cite! 'cips-cnvs-vnrm-value 'w (list t x)))
          (subst (dk-cite! 'cips-cnvs-vnrm-value 'v x))
          (dk-apply! bnd x)
          (ass))))
    (dk-cite! 'cbop-intro cn2b-CV cn2b-CW t m)
    (ass)))

;;; backward: t in CNVS-BOUNDED-OPS(CV, CW) -> t in L(v, w)
(define (cn2b-bwd! t)
  (dk-cite! 'cbop-fun cn2b-CV cn2b-CW t)
  (dk-have! (list 'IN t '(FUN (VEC v) (VEC w)))
    (lambda () (cn2b-to-cnvs!) (ass)))
  (let* ((m   (dk-skolem! (dk-cite! 'cbop-bound-exists cn2b-CV cn2b-CW t)))
         (bnd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq m (free-vars h))
                                        (dk-contains? h 'VNRM)))
                       "the VNRM bound")))
    (dk-have! (list 'IS-LINEAR-OP 'v 'w t)
      (lambda ()
        (mac 'IS-LINEAR-OP)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-contains? (dk-goal) '(ACT v))
                   (dk-peel!)
                   (let* ((ap (cadr (cadr (dk-goal)))) (c (cadr ap)) (x (caddr ap)))
                     (cn2b-tx! t x)
                     (let ((e1 (dk-cite! 'cips-cnvs-cact 'v c x))
                           (e2 (dk-cite! 'cips-cnvs-cact 'w c (list t x))))
                       (subst (list '= (caddr e1) (cadr e1)))
                       (subst (list '= (caddr e2) (cadr e2))))
                     (cn2b-in-cv! x)
                     (dk-cite! 'cbop-act cn2b-CV cn2b-CW t c x)
                     (ass)))
                  (#t
                   (dk-peel!)
                   (let* ((ap (cadr (cadr (dk-goal)))) (x (cadr ap)) (y (caddr ap)))
                     (subst (list '= '(VADD v) (list 'VADD cn2b-CV)))
                     (subst (list '= '(VADD w) (list 'VADD cn2b-CW)))
                     (cn2b-in-cv! x) (cn2b-in-cv! y)
                     (dk-cite! 'cbop-add cn2b-CV cn2b-CW t x y)
                     (ass))))))))
    (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
                (list '<= (list 'IP-NORM 'w (list t 'box_)) (list '* m '(IP-NORM v box_)))))
      (lambda ()
        (dk-peel!)
        (let ((x (caddr (caddr (caddr (dk-goal))))))
          (cn2b-tx! t x)
          (let ((e1 (dk-cite! 'cips-cnvs-vnrm-value 'w (list t x)))
                (e2 (dk-cite! 'cips-cnvs-vnrm-value 'v x)))
            (subst (list '= (caddr e1) (cadr e1)))
            (subst (list '= (caddr e2) (cadr e2))))
          (cn2b-in-cv! x)
          (dk-apply! bnd x)
          (ass))))
    (dk-cite! 'bop-intro 'v 'w t m)
    (ass)))

(sp (make-wff (forall-guarded '(v w) cn2b-C2 (list '= cn2b-BO cn2b-CBO))))
(dk-peel!)
(cn2b-readoffs! 'vec 'vadd)
(dk-have! (list 'FORALL 'cn2t_ (list 'IFF (list 'IN 'cn2t_ cn2b-BO) (list 'IN 'cn2t_ cn2b-CBO)))
  (lambda ()
    (let ((t (dk-di-var! (lambda (g) (cadr (cadr g))))))
      (dk-iff! (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) cn2b-CBO)))
               (lambda () (cn2b-fwd! t))
               (lambda () (cn2b-bwd! t))))))
(fact 'class-extensionality cn2b-BO cn2b-CBO)
(ass)
(cn2b-qed! 'bops-cnvs-bops-eq)

;;; ==========================================================================================
;;; THE OPERATOR NORMS
;;; ==========================================================================================
(define (cn2b-P e)
  (list 'OR (list '= e 0)
        (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v))
          (list 'AND '(NOT (= (IP-NORM v box_) 0))
                (list '= e '(* (IP-NORM w (t_ box_)) (recip (IP-NORM v box_)))))))))
(define (cn2b-Q e)
  (list 'OR (list '= e 0)
        (list 'FORSOME 'cbx_ (list 'AND '(IN cbx_ (VEC v))
          (list 'AND (list 'NOT (list '= (list (list 'VNRM cn2b-CV) 'cbx_) 0))
                (list '= e (list '* (list (list 'VNRM cn2b-CW) '(t_ cbx_))
                                    (list 'recip (list (list 'VNRM cn2b-CV) 'cbx_)))))))))

;;; the case e = 0: or-intro left, then close the leaf if hash-consing has not
(define (cn2b-oil!)
  (let ((leaf (proof-state-focus *ps*)))
    (oi-l)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; one direction: the existential case, rewriting the GOAL by the norm values at the witness
(define (cn2b-wit! fwd?)
  (let* ((ex (dk-pick (lambda (h) (dk-head-is? h 'FORSOME)) "the existential disjunct"))
         (x  (dk-skolem! ex)))
    (oi-r)
    (ew x)
    (cn2b-tx! 't_ x)
    (let ((es (list (dk-cite! 'cips-cnvs-vnrm-value 'v x)
                    (dk-cite! 'cips-cnvs-vnrm-value 'w (list 't_ x)))))
      (dk-conj-close!
        (lambda ()
          (for-each (lambda (e)
                      (if fwd? (cn2b-rw! (cadr e) (caddr e)) (cn2b-rw! (caddr e) (cadr e))))
                    es)
          (ass))))))

(sp (make-wff (forall-guarded '(v w t_ e_) (append cn2b-C2 '((IN t_ (FUN (VEC v) (VEC w)))))
   (list 'IFF (cn2b-P 'e_) (cn2b-Q 'e_)))))
(dk-peel!)
(cn2b-setup!)
(dk-iff! (lambda (g) (dk-contains? g 'VNRM))
  (lambda ()
    (use-cases (cn2b-P 'e_) cn2b-oil! (lambda () (cn2b-wit! #t))))
  (lambda ()
    (use-cases (cn2b-Q 'e_) cn2b-oil! (lambda () (cn2b-wit! #f)))))
(cn2b-qed! 'opnorm-body-cnvs-iff)

(sp (make-wff (forall-guarded '(v w t_) (append cn2b-C2 '((IN t_ (FUN (VEC v) (VEC w)))))
   (list '== '(OPNORM v w t_) (list 'CNVS-OPNORM cn2b-CV cn2b-CW 't_)))))
(dk-peel!)
(cn2b-setup!)
(dk-cite! 'cips-cnvs-vec 'v)
(mac 'OPNORM)
(mac 'CNVS-OPNORM)
(cn2b-rw! (list 'VEC cn2b-CV) '(VEC v))
(let* ((g (dk-goal)) (s1 (cadr (cadr g))) (s2 (cadr (caddr g))))
  (cn2b-sep-eq! s1 s2 (lambda (e) (dk-cite! 'opnorm-body-cnvs-iff 'v 'w 't_ e)))
  (subst (list '= s2 s1)))
(qrfl)
(cn2b-qed! 'opnorm-cnvs-opnorm)

;;; ==========================================================================================
;;; THE OPERATIONS
;;; ==========================================================================================
;;; The four pointwise constructions, unfolded as THEOREMS.  The def-functoid macetes of BOP-SUM /
;;; BOP-NEG (and CBOP-*) cannot fire inside BOP-VADD / BOP-VINV: the rewriter refuses to descend
;;; under a VNB-LAMBDA whose bound variable is spelled like one of the macete's schema variables
;;; (macetes.scm, rewrite-subexpressions), and the vocabulary binds the lambda with the functoid's
;;; own parameter names (bot_, bos_; cbt_, cbs_).  A theorem's macete has its own variables.
(define (cn2b-unfold! name stmt fname)
  (sp (make-wff stmt))
  (dk-peel!)
  (mac fname)
  (qrfl)
  (cn2b-qed! name))
(cn2b-unfold! 'bop-sum-unfold
  '(FORALL ua_ (FORALL ub_ (FORALL us_ (FORALL ut_ (== (BOP-SUM ua_ ub_ us_ ut_)
     (VNB-LAMBDA box_ (VEC ua_) ((VADD ub_) (us_ box_) (ut_ box_))))))))
  'BOP-SUM)
(cn2b-unfold! 'cbop-sum-unfold
  '(FORALL ua_ (FORALL ub_ (FORALL us_ (FORALL ut_ (== (CBOP-SUM ua_ ub_ us_ ut_)
     (VNB-LAMBDA cbx_ (VEC ua_) ((VADD ub_) (us_ cbx_) (ut_ cbx_))))))))
  'CBOP-SUM)
(cn2b-unfold! 'bop-neg-unfold
  '(FORALL ua_ (FORALL ub_ (FORALL ut_ (== (BOP-NEG ua_ ub_ ut_)
     (VNB-LAMBDA box_ (VEC ua_) ((VNEG ub_) (ut_ box_)))))))
  'BOP-NEG)
(cn2b-unfold! 'cbop-neg-unfold
  '(FORALL ua_ (FORALL ub_ (FORALL ut_ (== (CBOP-NEG ua_ ub_ ut_)
     (VNB-LAMBDA cbx_ (VEC ua_) ((VNEG ub_) (ut_ cbx_)))))))
  'CBOP-NEG)

(sp (make-wff (forall-guarded '(v w) cn2b-C2 (list '== '(BOP-ZERO v w) (list 'CBOP-ZERO cn2b-CV cn2b-CW)))))
(dk-peel!)
(cn2b-readoffs! 'vec 'vzero)
(mac 'BOP-ZERO) (mac 'CBOP-ZERO)
(cn2b-to-plain!)
(qrfl)
(cn2b-qed! 'bop-zero-cnvs)

(sp (make-wff (forall-guarded '(v w) cn2b-C2 (list '== '(BOP-VINV v w) (list 'CBOP-VINV cn2b-CV cn2b-CW)))))
(dk-peel!)
(dk-cite! 'bops-cnvs-bops-eq 'v 'w)
(cn2b-readoffs! 'vec 'vneg)
(mac 'BOP-VINV) (mac 'CBOP-VINV) (mac 'bop-neg-unfold) (mac 'cbop-neg-unfold)
(cn2b-rw! cn2b-CBO cn2b-BO)
(cn2b-to-plain!)
(qrfl)
(cn2b-qed! 'bop-vinv-cnvs)

(sp (make-wff (forall-guarded '(v w) cn2b-C2 (list '== '(BOP-VADD v w) (list 'CBOP-VADD cn2b-CV cn2b-CW)))))
(dk-peel!)
(dk-cite! 'bops-cnvs-bops-eq 'v 'w)
(cn2b-readoffs! 'vec 'vadd)
(mac 'BOP-VADD) (mac 'CBOP-VADD) (mac 'bop-sum-unfold) (mac 'cbop-sum-unfold)
(cn2b-rw! cn2b-CBO cn2b-BO)
(cn2b-to-plain!)
(qrfl)
(cn2b-qed! 'bop-vadd-cnvs)

;;; the norm: function extensionality over L(v, w)
(sp (make-wff (forall-guarded '(v w) cn2b-C2 (list '= '(BOP-VNRM v w) (list 'CBOP-VNRM cn2b-CV cn2b-CW)))))
(dk-peel!)
(dk-cite! 'bops-cnvs-bops-eq 'v 'w)
(dk-cite! 'cips-cnvs-is-cnvs 'v)
(dk-cite! 'cips-cnvs-is-cnvs 'w)
(dk-cite! 'bounded-ops-is-set 'v 'w)
(dk-cite! 'cbops-is-set cn2b-CV cn2b-CW)
(dk-fun-ext! '(BOP-VNRM v w) (list 'CBOP-VNRM cn2b-CV cn2b-CW) cn2b-BO 'RR
  (lambda ()
    (mac 'BOP-VNRM)
    (dk-lam-type!
      (lambda ()
        (dk-peel!)
        (dk-cite! 'opnorm-in-rr 'v 'w (cadddr (cadr (dk-goal))))
        (ass))))
  (lambda ()
    (subst (list '= cn2b-BO cn2b-CBO))
    (mac 'CBOP-VNRM)
    (dk-lam-type!
      (lambda ()
        (dk-peel!)
        (dk-cite! 'cnvs-opnorm-in-rr cn2b-CV cn2b-CW (cadddr (cadr (dk-goal))))
        (ass))))
  (lambda (t)
    (subst (dk-cite! 'bop-vnrm-value 'v 'w t))
    (dk-have! (list 'IN t cn2b-CBO) (lambda () (subst (list '= cn2b-CBO cn2b-BO)) (ass)))
    (subst (dk-cite! 'cbop-vnrm-value cn2b-CV cn2b-CW t))
    (dk-cite! 'bop-fun 'v 'w t)
    (dk-cite! 'cnvs-opnorm-in-rr cn2b-CV cn2b-CW t)
    (dk-cite! 'opnorm-cnvs-opnorm 'v 'w t)
    (subst (list '= (list 'OPNORM 'v 'w t) (list 'CNVS-OPNORM cn2b-CV cn2b-CW t)))
    (if (not (proof-done? *ps*)) (rfl))))
(if (not (proof-done? *ps*)) (ass))
(cn2b-qed! 'bop-vnrm-cnvs)

;;; ==========================================================================================
;;; THE TUPLE EQUATION, and bop-complete as an instance of cbop-complete
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(v w) cn2b-C2
   (list '== '(BOP-NORMED-AG v w) (list 'CBOP-NORMED-AG cn2b-CV cn2b-CW)))))
(dk-peel!)
(cn2b-setup!)
(for-each (lambda (n) (dk-cite! n 'v 'w))
          '(bops-cnvs-bops-eq bop-vadd-cnvs bop-zero-cnvs bop-vinv-cnvs bop-vnrm-cnvs))
(mac 'BOP-NORMED-AG)
(mac 'CBOP-NORMED-AG)
(cn2b-rw! cn2b-CBO cn2b-BO)
(for-each (lambda (pr) (cn2b-rw! (list (cadr pr) cn2b-CV cn2b-CW) (list (car pr) 'v 'w)))
          '((BOP-VADD CBOP-VADD) (BOP-ZERO CBOP-ZERO) (BOP-VINV CBOP-VINV) (BOP-VNRM CBOP-VNRM)))
(qrfl)
(cn2b-qed! 'bop-normed-ag-cnvs)

;;; BA-BH2's bop-complete (the same statement), from cnvs-d's cbop-complete
(sp (make-wff (forall-guarded '(v w) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-HILBERT-SPACE w))
   '(IS-COMPLETE (NAG-METRIC-SPACE (BOP-NORMED-AG v w))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'w)
(dk-cite! 'cips-cnvs-is-cnvs 'v)
(dk-cite! 'hilbert-cnvs-is-cbs 'w)
(dk-cite! 'cbop-complete cn2b-CV cn2b-CW)
(dk-cite! 'bop-normed-ag-cnvs 'v 'w)
(subst (list '= '(BOP-NORMED-AG v w) (list 'CBOP-NORMED-AG cn2b-CV cn2b-CW)))
(ass)
(cn2b-qed! 'bop-complete-via-cnvs)
