;;; 2. Proposition 1.46 (ii) <=> (iii) <=> (iv) <=> (v), and (vi) => (v).

(define c9n-same
  '((IS-NV-FIELD K1) (IS-NV-FIELD K2) (== (CARR K2) (CARR K1)) (= (ADD K2) (ADD K1)) (= (NEG K2) (NEG K1))
    (= (MUL K2) (MUL K1)) (= (ZERO K2) (ZERO K1)) (= (ONE K2) (ONE K1))))
(define (c9n-curry hs body) (if (null? hs) body `(IMPLIES ,(car hs) ,(c9n-curry (cdr hs) body))))
;; (P REL) : for all a in K, REL(|a|_1) iff REL(|a|_2), REL one of "1 <", "< 1", "1 <=", "<= 1"
(define (c9n-p rel)
  (let ((r (lambda (t) (case rel ((gt) `(< 1 ,t)) ((lt) `(< ,t 1)) ((ge) `(<= 1 ,t)) ((le) `(<= ,t 1))))))
    `(FORALL cva (IMPLIES (IN cva (CARR K1)) (IFF ,(r (c9n-n 'K1 'cva)) ,(r (c9n-n 'K2 'cva)))))))

;; the setup: both fields normed, the shared element typing, K2's operations rewritten to K1's
(define (c9n-same-setup!)
  (dk-cite! 'nv-field-normed 'K1) (dk-cite! 'nv-field-normed 'K2)
  (fact 'rr-one-in) (fact 'rr-zero-in))
;; X in CARR K1: land X in CARR K2 and both norms typed
(define (c9n-both! x)
  (dk-have! `(IN ,x (CARR K2)) (lambda () (subst '(== (CARR K2) (CARR K1))) (dk-close-if-asm!)))
  (for-each (lambda (k) (dk-cite! 'nf-norm-in-rr k x) (dk-cite! 'nf-norm-nonneg k x)) '(K1 K2)))

;; HYP-REL's universal in context, goal (P GOAL-REL) with {hyp, goal} = {gt, lt}: by inverses
(define (c9n-flip! hyp-rel)
  (let* ((hp (c9n-p hyp-rel))
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (c9n-both! a)
    (use-em `(= ,a (ZERO K1))
      (lambda ()
        (dk-cite! 'nf-norm-of-zero 'K1) (dk-cite! 'nf-norm-of-zero 'K2)
        (subst `(= ,a (ZERO K1)))
        (subst '(= (ZERO K1) (ZERO K2)))
        (subst `(= ((FNRM K2) (ZERO K2)) 0))
        (subst '(= (ZERO K2) (ZERO K1)))
        (subst `(= ((FNRM K1) (ZERO K1)) 0))
        (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (dk-have! '(NOT (< 1 0)) (lambda () (di) (dk-absurd! '(< 1 0))))
        (prop))
      (lambda ()
        (let* ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K1 a))))
               (e1 `(= ((MUL K1) ,a ,b) (ONE K1))))
          (c9n-both! b)
          (dk-have! `(= ((MUL K2) ,a ,b) (ONE K2))
            (lambda () (subst '(= (MUL K2) (MUL K1))) (subst '(= (ONE K2) (ONE K1))) (dk-close-if-asm!)))
          (let* ((i1 (dk-chain-ass! (dk-cite! 'nf-inverse-norm-lt-one-iff 'K1 a b)))
                 (i2 (dk-chain-ass! (dk-cite! 'nf-inverse-norm-lt-one-iff 'K2 a b)))
                 ;; and with the roles of a and b exchanged (b a = 1)
                 (i34 (map (lambda (k)
                             (dk-cite! 'nv-field-normed k)
                             (dk-have! `(= ((MUL ,k) ,b ,a) (ONE ,k))
                               (lambda () (subst `(= (ONE ,k) ((MUL ,k) ,a ,b))) (c9n-crs-at! k (list a b))))
                             (dk-chain-ass! (dk-cite! 'nf-inverse-norm-lt-one-iff k b a)))
                           '(K1 K2)))
                 (h (dk-chain-ass! (dk-apply! hp b))))
            (apply dk-only! i1 i2 h i34)
            (prop)))))))


(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9n-curry c9n-same `(IFF ,(c9n-p 'gt) ,(c9n-p 'lt)))))))
(dk-peel!)
(c9n-same-setup!)
(dk-iff! (lambda (g) (equal? g (c9n-p 'lt)))
  (lambda () (c9n-flip! 'gt))
  (lambda () (c9n-flip! 'lt)))
(qed 'ccr-1-46-ii-iii)

;; (iii) <=> (iv) and (ii) <=> (v): the contrapositives
(define (c9n-neg! hyp-rel)
  (let* ((hp (c9n-p hyp-rel))
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (c9n-both! a)
    (let* ((h (dk-chain-ass! (dk-apply! hp a)))
           (fs (apply append (map (lambda (k)
                (let ((t (c9n-n k a)))
                  (dk-have-and! `(IN 1 RR) `(IN ,t RR))
                  (dk-cite! 'rr-leq-total 1 t)
                  (dk-have! `(IFF (< ,t 1) (NOT (<= 1 ,t)))
                    (lambda () (dk-iff! (lambda (g) (dk-head-is? g 'NOT))
                                 (lambda () (di) (dk-absurd! `(< ,t 1) `(<= 1 ,t)))
                                 (lambda () (dk-chain-ass! (dk-cite! 'rr-not-le-lt 1 t)) (dk-close-if-asm!)))))
                  (dk-have! `(IFF (< 1 ,t) (NOT (<= ,t 1)))
                    (lambda () (dk-iff! (lambda (g) (dk-head-is? g 'NOT))
                                 (lambda () (di) (dk-absurd! `(< 1 ,t) `(<= ,t 1)))
                                 (lambda () (dk-chain-ass! (dk-cite! 'rr-not-le-lt t 1)) (dk-close-if-asm!)))))
                  (list `(IFF (< ,t 1) (NOT (<= 1 ,t))) `(IFF (< 1 ,t) (NOT (<= ,t 1))))))
              '(K1 K2)))))
      (apply dk-only! h fs)
      (prop))))

(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9n-curry c9n-same `(IFF ,(c9n-p 'lt) ,(c9n-p 'ge)))))))
(dk-peel!)
(c9n-same-setup!)
(dk-iff! (lambda (g) (equal? g (c9n-p 'ge)))
  (lambda () (c9n-neg! 'lt))
  (lambda () (c9n-neg! 'ge)))
(qed 'ccr-1-46-iii-iv)

(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9n-curry c9n-same `(IFF ,(c9n-p 'gt) ,(c9n-p 'le)))))))
(dk-peel!)
(c9n-same-setup!)
(dk-iff! (lambda (g) (equal? g (c9n-p 'le)))
  (lambda () (c9n-neg! 'gt))
  (lambda () (c9n-neg! 'le)))
(qed 'ccr-1-46-ii-v)

;; (vi) => (v): |x|_1 = |x|_2 ^ alpha with alpha > 0
(define c9n-vi
  '(FORSOME cnal (AND (IN cnal RR) (AND (< 0 cnal)
     (FORALL cva (IMPLIES (IN cva (CARR K1)) (= ((FNRM K1) cva) (RPOW-STAR ((FNRM K2) cva) cnal))))))))

(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9n-curry c9n-same `(IMPLIES ,c9n-vi ,(c9n-p 'le)))))))
(dk-peel!)
(c9n-same-setup!)
(let* ((al (dk-skolem! c9n-vi))
       (pw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RPOW-STAR))) "the power law"))
       (a (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) '(CARR K1))))
                            (dk-asms))))
       (t (c9n-n 'K2 a))
       (u (c9n-n 'K1 a))
       (p1 `(RPOW-STAR 1 ,al)))
  (c9n-both! a)
  (dk-chain-ass! (dk-apply! pw a))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-chain-ass! (dk-cite! 'rpow-star-value 1 al))
  (fact 'log-one) (fact 'r-exp-zero)
  (dk-cite! 'rr-mul-zero al)
  (dk-have! `(= ,p1 1)
    (lambda () (subst `(= ,p1 (R-EXP (* ,al (LOG 1)))))
               (subst '(= (LOG 1) 0))
               (subst `(= (* ,al 0) 0))
               (dk-close-if-asm!)))
  (use-em `(= 0 ,t)
    (lambda ()
      (dk-chain-ass! (dk-cite! 'rpow-star-zero-base al))
      (dk-have! `(= ,u 0) (lambda () (subst `(= ,u (RPOW-STAR ,t ,al))) (subst `(= ,t 0)) (dk-close-if-asm!)))
      (dk-have! `(<= ,u 1) (lambda () (dk-ineq! `(= ,u 0))))
      (dk-have! `(<= ,t 1) (lambda () (dk-ineq! `(= 0 ,t))))
      (prop))
    (lambda ()
      (dk-have-and! `(<= 0 ,t) `(NOT (= 0 ,t)))
      (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 0 t))
      (dk-chain-ass! (dk-cite! 'rpow-star-in-rr t al))
      (dk-chain-ass! (dk-cite! 'rpow-star-in-rr 1 al))
      (dk-iff! (lambda (g) (equal? g `(<= ,t 1)))
        ;; |a|_1 <= 1 gives |a|_2 <= 1
        (lambda ()
          (pbc)
          (dk-chain-ass! (dk-cite! 'rr-not-le-lt t 1))
          (dk-chain-ass! (dk-cite! 'rpow-star-mono-base 1 t al))
          (dk-absurd! `(< ,p1 (RPOW-STAR ,t ,al)) `(= ,p1 1) `(= ,u (RPOW-STAR ,t ,al)) `(<= ,u 1)))
        ;; |a|_2 <= 1 gives |a|_1 <= 1
        (lambda ()
          (use-em `(= ,t 1)
            (lambda ()
              (dk-have! `(= ,u 1) (lambda () (subst `(= ,u (RPOW-STAR ,t ,al))) (subst `(= ,t 1)) (dk-close-if-asm!)))
              (dk-ineq! `(= ,u 1)))
            (lambda ()
              (dk-have-and! `(<= ,t 1) `(NOT (= ,t 1)))
              (dk-chain-ass! (dk-cite! 'rr-le-ne-lt t 1))
              (dk-chain-ass! (dk-cite! 'rpow-star-mono-base t 1 al))
              (dk-ineq! `(< (RPOW-STAR ,t ,al) ,p1) `(= ,p1 1) `(= ,u (RPOW-STAR ,t ,al))))))))))
(qed 'ccr-1-46-vi-v)

;;; -----------------------------------------------------------------------
;;; 3. Proposition 2.13, the converse: A compact, K = F(A), A = Z(K) give A a PID.
;;;
;;; The notes take the closure of an ideal and the maximum of |.| on it.  Here the maximum is taken once, on
;;; M(A), which is CLOSED in A (it is the open ball B(0, 1) of the ultrametric subspace A, closed by
;;; ultra-ball-closed), hence compact: compact-continuous-max gives uw in M(A) of largest absolute value.  When
;;; M(A) has a nonzero element, uw /= 0, every x in M(A) has |x| <= |uw|, so x = l uw (A = Z(K)), M(A) =
;;; (uw), and nv-uniformizer-pid (Corollary 2.14's route, ccr2-nv) finishes.  When M(A) = {0}, every ideal is
;;; (0) or contains 1 (nv-compact-proper-in-maximal), i.e. is (0) or (1).

;; X in A: X in CARR K, |X| real, nonnegative, at most 1
(define (c9n-type! x)
  (dk-cite! 'nv-domain-sub 'K 'A x)
  (dk-cite! 'nv-domain-norm 'K 'A x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))

;; an ideal I with an element g dividing every element is (g)
(sp (make-wff '(FORALL K (FORALL A (FORALL I (FORALL g (IMPLIES (IS-NV-DOMAIN K A) (IMPLIES (IS-NV-IDEAL K A I) (IMPLIES (IN g I)
  (IMPLIES (FORALL cvx (IMPLIES (IN cvx I) (FORSOME cvl (AND (IN cvl A) (= cvx ((MUL K) cvl g))))))
    (= I (NV-PRINCIPAL K A g))))))))))))
(dk-peel!)
(let ((law (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cvl))) "the divisibility law"))
      (pp '(NV-PRINCIPAL K A g)))
  (dk-cite! 'nv-ideal-sub 'K 'A 'I 'g)
  (dk-class-ext! 'I pp
    (lambda (w)
      (dk-cite! 'nv-ideal-sub 'K 'A 'I w)
      (let ((l (dk-skolem! (dk-chain-ass! (dk-apply! law w)))))
        (subst (dk-cite! 'nv-principal-unfold 'K 'A 'g))
        (in-sep! (lambda () (dk-ass!))
                 (lambda () (ew l) (dk-conj-close! (lambda () (dk-ass!)))))))
    (lambda (w)
      (let* ((h (dk-rewrite-h! `(IN ,w ,pp) pp (caddr (dk-cite! 'nv-principal-unfold 'K 'A 'g))))
             (parts (dk-landed (lambda () (sep-me h))))
             (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
             (m (dk-skolem! ex)))
        (dk-chain-ass! (dk-cite! 'nv-ideal-mul 'K 'A 'I m 'g))
        (subst `(= ,w ((MUL K) ,m g)))
        (dk-close-if-asm!))))
  (dk-close-if-asm!))
(qed 'nv-ideal-principal-of)

;; |.| attains its maximum on M(A), A a compact NV domain
(define c9n-s0 '(NF-METRIC-SPACE K))
(define c9n-s1 `(SUBSPACE-MS ,c9n-s0 A))
(define c9n-m '(NV-MAXIMAL K A))
(define c9n-s2 `(SUBSPACE-MS ,c9n-s1 ,c9n-m))
(define c9n-f `(VNB-LAMBDA c9v_ ,c9n-m ((FNRM K) c9v_)))

(define (c9n-in-m! w)                    ; W in PTS s2: W in M(A), in A, typed
  (dk-have! `(IN ,w ,c9n-m) (lambda () (subst `(== ,c9n-m (PTS ,c9n-s2))) (dk-close-if-asm!)))
  (dk-cite! 'nv-maximal-sub 'K 'A w)
  (c9n-type! w))
;; W in A: d(0, W) = |W| in the metric of K
(define (c9n-d0! w)
  (let* ((e1 (dk-cite! 'nf-metric-distance 'K '(ZERO K) w))
         (e2 (dk-have! `(= ((ADD K) (ZERO K) ((NEG K) ,w)) ((NEG K) ,w))
               (lambda () (dk-cite! 'nf-neg-in-carr 'K w) (c9n-crs! (list w)))))
         (e3 (dk-cite! 'nf-norm-neg 'K w)))
    (dk-have! `(IN ,w (PTS ,c9n-s0)) (lambda () (subst `(== (PTS ,c9n-s0) (CARR K))) (dk-close-if-asm!)))
    (dk-have! `(IN (ZERO K) (PTS ,c9n-s0)) (lambda () (subst `(== (PTS ,c9n-s0) (CARR K))) (dk-close-if-asm!)))
    (dk-cite! 'metric-dist-real c9n-s0 '(ZERO K) w)
    (dk-have! `(= ((DIST ,c9n-s0) (ZERO K) ,w) ((FNRM K) ,w))
      (lambda ()
        (subst e1)
        (subst `(= ((ADD K) (ZERO K) ((NEG K) ,w)) ((NEG K) ,w)))
        (subst e3)
        (rfl)))))

(sp (make-wff `(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A)
  (FORSOME uw (AND (IN uw ,c9n-m) (FORALL cvx (IMPLIES (IN cvx ,c9n-m) (<= ((FNRM K) cvx) ((FNRM K) uw)))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-field 'K 'A)
(dk-cite! 'nv-compact-compact 'K 'A)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'nv-domain-subset-pts 'K 'A)
(dk-cite! 'subspace-is-metric-space c9n-s0 'A)
(dk-cite! 'ms-pts-is-set c9n-s0)
(dk-have! '(IN A SET) (lambda () (dk-sethood! 'A)))
(dk-cite! 'subspace-pts c9n-s0 'A)
(dk-cite! 'nf-zero-in-carr 'K)
(dk-cite! 'nv-domain-zero 'K 'A)
(fact 'rr-one-in) (fact 'rr-zero-in)
;; M(A) a subset (and a subset) of A
(dk-have! `(SUBSET ,c9n-m A)
  (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'nv-maximal-sub 'K 'A w) (dk-close-if-asm!))))
(dk-have-and! `(SUBSET ,c9n-m A) '(IN A SET))
(dk-chain-ass! (dk-cite! 'subclass-of-set-is-set c9n-m 'A))
(dk-have! `(SUBSET ,c9n-m (PTS ,c9n-s1)) (lambda () (subst `(== (PTS ,c9n-s1) A)) (dk-close-if-asm!)))
;; M(A) is the ball B(0, 1) of the ultrametric space A, hence closed in A
(dk-cite! 'nv-field-ultrametric 'K)
(dk-chain-ass! (dk-cite! 'subspace-ultrametric c9n-s0 'A))
(dk-have! `(IN (ZERO K) (PTS ,c9n-s1)) (lambda () (subst `(== (PTS ,c9n-s1) A)) (dk-close-if-asm!)))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-chain-ass! (dk-cite! 'ultra-ball-closed c9n-s1 '(ZERO K) 1))
(let ((bl `(BALL ,c9n-s1 (ZERO K) 1)))
  (dk-have! `(= ,c9n-m ,bl)
    (lambda ()
      (dk-class-ext! c9n-m bl
        (lambda (w)
          (dk-cite! 'nv-maximal-sub 'K 'A w)
          (dk-cite! 'nv-maximal-norm 'K 'A w)
          (c9n-type! w)
          (c9n-d0! w)
          (let* ((bm (dk-cite! 'ball-membership c9n-s0 '(ZERO K) 1 w))
                (sbm (dk-cite! 'subspace-ball-membership c9n-s0 'A '(ZERO K) 1 w)))
            (dk-have! (caddr bm)
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (cond ((dk-ass!) #t)
                          ((dk-head-is? (dk-goal) 'NOT)
                           (di) (dk-absurd! `(= ((DIST ,c9n-s0) (ZERO K) ,w) 1) `(= ((DIST ,c9n-s0) (ZERO K) ,w) ((FNRM K) ,w))
                                            `(< ((FNRM K) ,w) 1)))
                          (#t (dk-ineq! `(= ((DIST ,c9n-s0) (ZERO K) ,w) ((FNRM K) ,w)) `(< ((FNRM K) ,w) 1))))))))
            (dk-iff-bwd! bm)
            (dk-have-and! `(IN ,w (BALL ,c9n-s0 (ZERO K) 1)) `(IN ,w A))
            (dk-iff-bwd! sbm)
            (dk-close-if-asm!)))
        (lambda (w)
          (dk-iff-fwd! (dk-cite! 'subspace-ball-membership c9n-s0 'A '(ZERO K) 1 w))
          (dk-iff-fwd! (dk-cite! 'ball-membership c9n-s0 '(ZERO K) 1 w))
          (c9n-type! w)
          (c9n-d0! w)
          (subst (dk-cite! 'nv-maximal-unfold 'K 'A))
          (in-sep! (lambda () (dk-ass!))
            (lambda ()
              (let ((dw `((DIST ,c9n-s0) (ZERO K) ,w)))
                (dk-cite! 'metric-dist-real c9n-s0 '(ZERO K) w)
                (dk-cite! 'rr-le-ne-lt dw 1)
                (dk-have-and! `(<= ,dw 1) `(NOT (= ,dw 1)))
                (dk-chain-ass! (dk-cite! 'rr-le-ne-lt dw 1))
                (dk-ineq! `(< ,dw 1) `(= ,dw ((FNRM K) ,w))))))))
      (dk-close-if-asm!)))
  (dk-have! `(IS-CLOSED ,c9n-s1 ,c9n-m) (lambda () (subst `(= ,c9n-m ,bl)) (dk-close-if-asm!))))
(dk-chain-ass! (dk-cite! 'closed-subset-of-compact-is-compact c9n-s1 c9n-m))
(dk-chain-ass! (dk-cite! 'subspace-is-metric-space c9n-s1 c9n-m))
(dk-cite! 'subspace-pts c9n-s1 c9n-m)
;; the absolute value is continuous on M(A)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(fact 'rr-is-metric-space)
(dk-have! `(IN ,c9n-f (FUN (PTS ,c9n-s2) (PTS RR-MS)))
  (lambda ()
    (subst `(== (PTS ,c9n-s2) ,c9n-m)) (subst '(== (PTS RR-MS) RR))
    (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (dk-cite! 'nv-maximal-sub 'K 'A w) (c9n-type! w) (dk-close-if-asm!))))))
(let ((ci (dk-cite! 'is-continuous c9n-s2 'RR-MS c9n-f)))
  (dk-have! (caddr ci)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((a (dk-di-var!))
                     (cf (dk-cite! 'is-continuous-at c9n-s2 'RR-MS c9n-f a)))
                (c9n-in-m! a)
                (dk-have! (caddr cf)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let* ((ls (dk-peel!))
                                   (eps (dk-landed-eps ls)))
                              (dk-cite! 'rr-pos-rr-in-rr eps)
                              (ew eps)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-ass!))
                                      (let* ((ls2 (dk-peel!))
                                             (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(PTS ,c9n-s2)))) ls2)))
                                             (h0 (find-first (lambda (f) (dk-head-is? f '<=)) ls2)))
                                        (c9n-in-m! b)
                                        (let* ((_1 (dk-chain-ass! (dk-cite! 'subspace-dist c9n-s1 c9n-m a b)))
                                               (h1 (dk-rewrite-h! h0 `((DIST ,c9n-s2) ,a ,b) `((DIST ,c9n-s1) ,a ,b)))
                                               (_2 (dk-chain-ass! (dk-cite! 'subspace-dist c9n-s0 'A a b)))
                                               (h2 (dk-rewrite-h! h1 `((DIST ,c9n-s1) ,a ,b) `((DIST ,c9n-s0) ,a ,b)))
                                               (_3 (dk-cite! 'nf-metric-distance 'K a b))
                                               (dab `((ADD K) ,a ((NEG K) ,b)))
                                               (dba `((ADD K) ,b ((NEG K) ,a)))
                                               (h3 (dk-rewrite-h! h2 `((DIST ,c9n-s0) ,a ,b) `((FNRM K) ,dab)))
                                               (na `((FNRM K) ,a)) (nb `((FNRM K) ,b)))
                                          (dk-cite! 'nf-neg-in-carr 'K b) (dk-cite! 'nf-neg-in-carr 'K a)
                                          (dk-cite! 'nf-add-in-carr 'K a `((NEG K) ,b))
                                          (dk-cite! 'nf-add-in-carr 'K b `((NEG K) ,a))
                                          (dk-cite! 'nf-norm-in-rr 'K dab) (dk-cite! 'nf-norm-in-rr 'K dba)
                                          (dk-cite! 'nf-norm-sub-sym 'K a b)
                                          (let* ((s1 (dk-cite! 'nf-norm-subadd 'K dab b))
                                                 (s2 (dk-cite! 'nf-norm-subadd 'K dba a))
                                                 (q1 (dk-have! `(= ((ADD K) ,dab ,b) ,a) (lambda () (c9n-crs! (list a b)))))
                                                 (q2 (dk-have! `(= ((ADD K) ,dba ,a) ,b) (lambda () (c9n-crs! (list a b)))))
                                                 (t1 (dk-rewrite-h! s1 `((ADD K) ,dab ,b) a))
                                                 (t2 (dk-rewrite-h! s2 `((ADD K) ,dba ,a) b)))
                                            (dk-lam-b!)
                                            (dk-cite! 'rr-ms-dist na nb)
                                            (subst `(== ((DIST RR-MS) ,na ,nb) (ABS (- ,na ,nb))))
                                            (let ((x `(- ,na ,nb)))
                                              (dk-type! x 'RR)
                                              (dk-have! `(<= (- ,eps) ,x)
                                                (lambda () (dk-ineq! t2 `(= ((FNRM K) ,dab) ((FNRM K) ,dba)) h3)))
                                              (dk-have! `(<= ,x ,eps)
                                                (lambda () (dk-ineq! t1 h3)))
                                              (dk-chain-ass! (dk-cite! 'rr-abs-le-of-parts x eps))
                                              (dk-close-if-asm!))))))))))))))
                (dk-iff-bwd! cf)
                (dk-close-if-asm!)))))))
  (dk-iff-bwd! ci))
;; the maximum
(dk-have! `(IN (ZERO K) (PTS ,c9n-s2))
  (lambda () (dk-cite! 'nv-maximal-zero 'K 'A) (subst `(== (PTS ,c9n-s2) ,c9n-m)) (dk-close-if-asm!)))
(let* ((uw (dk-skolem! (dk-chain-ass! (dk-cite! 'compact-continuous-max c9n-s2 c9n-f '(ZERO K)))))
       (law (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(,c9n-f ,uw)))) "the maximum law")))
  (c9n-in-m! uw)
  (ew uw)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((x (dk-di-var!)))
            (dk-have! `(IN ,x (PTS ,c9n-s2)) (lambda () (subst `(== (PTS ,c9n-s2) ,c9n-m)) (dk-close-if-asm!)))
            (c9n-in-m! x)
            (let ((h (dk-chain-ass! (dk-apply! law x))))
              (dk-have! `(IMPLIES ,h (<= ((FNRM K) ,x) ((FNRM K) ,uw)))
                (lambda () (dk-lam-b!) (di) (dk-close-if-asm!)))
              (dk-chain-ass! `(IMPLIES ,h (<= ((FNRM K) ,x) ((FNRM K) ,uw))))
              (dk-close-if-asm!)))))))
(qed 'nv-compact-maximal-max)

;; the divisibility law of A = Z(K) (nv-integers-iff-divisibility), landed in context
(define (c9n-div-law!)
  (let ((iff (dk-chain-ass! (dk-cite! 'nv-integers-iff-divisibility 'K 'A))))
    (dk-iff-fwd! iff)
    (caddr iff)))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (IMPLIES (IS-FRACTIONS-OF K A)
  (IMPLIES (= A (NV-INTEGERS K)) (IS-NV-PID K A))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-field 'K 'A)
(dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K)
(dk-cite! 'nv-domain-zero 'K 'A) (dk-cite! 'nv-domain-one 'K 'A)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((dlaw (c9n-div-law!))
       (nz `(FORSOME cwz_ (AND (IN cwz_ ,c9n-m) (NOT (= cwz_ (ZERO K)))))))
  (use-em nz
    ;; M(A) /= {0}: a uniformizer
    (lambda ()
      (let* ((z (dk-skolem! nz))
             (uw (dk-skolem! (dk-cite! 'nv-compact-maximal-max 'K 'A)))
             (mx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `((FNRM K) ,uw)))) "the maximum")))
        (dk-cite! 'nv-maximal-sub 'K 'A z) (dk-cite! 'nv-maximal-sub 'K 'A uw)
        (c9n-type! z) (c9n-type! uw)
        (dk-chain-ass! (dk-apply! mx z))
        ;; uw /= 0
        (dk-have! `(NOT (= ,uw (ZERO K)))
          (lambda ()
            (di)
            (dk-cite! 'nf-norm-of-zero 'K)
            (dk-have! `(= ((FNRM K) ,uw) 0) (lambda () (subst `(= ,uw (ZERO K))) (dk-close-if-asm!)))
            (dk-have! `(= ((FNRM K) ,z) 0) (lambda () (dk-ineq! `(<= ((FNRM K) ,z) ((FNRM K) ,uw)) `(= ((FNRM K) ,uw) 0) `(<= 0 ((FNRM K) ,z)))))
            (dk-iff-fwd! (dk-cite! 'nf-norm-zero-iff 'K z))
            (ai `(NOT (= ,z (ZERO K))))))
        ;; M(A) = (uw)
        (dk-cite! 'nv-maximal-ideal 'K 'A)
        (dk-have! `(FORALL cvx (IMPLIES (IN cvx ,c9n-m) (FORSOME cvl (AND (IN cvl A) (= cvx ((MUL K) cvl ,uw))))))
          (lambda ()
            (let ((x (dk-di-var!)))
              (dk-cite! 'nv-maximal-sub 'K 'A x)
              (c9n-type! x)
              (dk-chain-ass! (dk-apply! mx x))
              (dk-chain-ass! (dk-apply! dlaw x uw))
              (dk-close-if-asm!))))
        (dk-chain-ass! (dk-cite! 'nv-ideal-principal-of 'K 'A c9n-m uw))
        (dk-chain-ass! (dk-cite! 'nv-uniformizer-pid 'K 'A uw))
        (dk-close-if-asm!)))
    ;; M(A) = {0}: every ideal is (0) or (1)
    (lambda ()
      (mac 'is-nv-pid)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (ih (find-first (lambda (f) (dk-head-is? f 'IS-NV-IDEAL)) landed))
                     (iv (cadddr ih)))
                (dk-cite! 'nv-ideal-zero 'K 'A iv)
                (use-em `(IN (ONE K) ,iv)
                  (lambda ()
                    (dk-have! `(FORALL cvx (IMPLIES (IN cvx ,iv) (FORSOME cvl (AND (IN cvl A) (= cvx ((MUL K) cvl (ONE K)))))))
                      (lambda ()
                        (let ((x (dk-di-var!)))
                          (dk-cite! 'nv-ideal-sub 'K 'A iv x)
                          (c9n-type! x)
                          (ew x)
                          (dk-conj-close! (lambda () (if (not (dk-ass!)) (c9n-crs! (list x))))))))
                    (dk-chain-ass! (dk-cite! 'nv-ideal-principal-of 'K 'A iv '(ONE K)))
                    (ew '(ONE K))
                    (dk-conj-close! (lambda () (dk-ass!))))
                  (lambda ()
                    (let ((pm (dk-chain-ass! (dk-cite! 'nv-compact-proper-in-maximal 'K 'A iv))))
                      (dk-have! `(FORALL cvx (IMPLIES (IN cvx ,iv) (FORSOME cvl (AND (IN cvl A) (= cvx ((MUL K) cvl (ZERO K)))))))
                        (lambda ()
                          (let ((x (dk-di-var!)))
                            (dk-cite! 'nv-ideal-sub 'K 'A iv x)
                            (c9n-type! x)
                            (dk-chain-ass! (dk-apply! pm x))
                            (dk-have! `(= ,x (ZERO K))
                              (lambda ()
                                (pbc)
                                (dk-have! nz (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
                                (ai `(NOT ,nz))))
                            (ew '(ZERO K))
                            (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,x (ZERO K))) (c9n-crs! '()))))))))
                      (dk-chain-ass! (dk-cite! 'nv-ideal-principal-of 'K 'A iv '(ZERO K)))
                      (ew '(ZERO K))
                      (dk-conj-close! (lambda () (dk-ass!)))))))))))))
(qed 'ccr-2-13-converse)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (IMPLIES (IS-FRACTIONS-OF K A)
  (IFF (= A (NV-INTEGERS K)) (IS-NV-PID K A))))))))
