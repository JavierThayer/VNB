;; a ring identity in K over the variables VS (each in CARR K): `crs' through the commutative-ring view
(define (c9n-crs-at! k vs)
  (let ((view `(NORMED-FIELD-AS-COMMUTATIVE-RING ,k)))
    (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring k)
    (for-each (lambda (r) (dk-cite! r k))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (u)
                (dk-have! `(IN ,u (CARR ,view)) (lambda () (subst `(= (CARR ,view) (CARR ,k))) (dk-ass!))))
              vs)
    (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op ,k)) (subst `(= (,op ,k) (,op ,view)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))
(define (c9n-crs! vs) (c9n-crs-at! 'K vs))

(define (c9n-n k x) `((FNRM ,k) ,x))

