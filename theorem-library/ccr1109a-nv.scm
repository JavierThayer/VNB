;;; 1. A real lemma: for u, w >= 0 with u w = 1, u < 1 iff 1 < w.

(sp (make-wff '(FORALL cnu (IMPLIES (IN cnu RR) (FORALL cnw (IMPLIES (IN cnw RR)
  (IMPLIES (<= 0 cnu) (IMPLIES (<= 0 cnw) (IMPLIES (= (* cnu cnw) 1) (IFF (< cnu 1) (< 1 cnw)))))))))))
(dk-peel!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-rr-mul! 'cnu 'cnw)
(dk-iff! (lambda (g) (equal? g '(< 1 cnw)))
  (lambda ()
    (pbc)
    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 1 'cnw))
    (dk-have-and! '(IN cnu RR) '(IN cnw RR))
    (dk-chain-ass! (dk-cite! 'rr-prod-lt-one-left 'cnu 'cnw))
    (dk-absurd! '(< (* cnu cnw) 1) '(= (* cnu cnw) 1)))
  (lambda ()
    (pbc)
    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'cnu 1))
    (dk-have! '(<= 0 cnw) (lambda () (dk-ass!)))
    (dk-chain-ass! (dk-cite! 'rr-mul-le-right 1 'cnu 'cnw))
    (dk-rr-mul! 1 'cnw)
    (dk-have! '(= (* 1 cnw) cnw) (lambda () (crs)))
    (dk-absurd! '(<= (* 1 cnw) (* cnu cnw)) '(= (* 1 cnw) cnw) '(= (* cnu cnw) 1) '(< 1 cnw))))
(qed 'rr-recip-pair-lt-one-iff)

