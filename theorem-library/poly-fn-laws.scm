;;; poly-fn-laws.scm -- laws of polynomial functions (CA-MONTEL "POLY", 2026-10-26).  Vocabulary:
;;; poly-fn-vocab.scm.  Library: analysis.  Helper prefix pfl-.
(define (pfl-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (pfl-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (pfl-H c z) n))
(define (pfl-only-prop! . fs) (dk-close-if! (lambda () (apply dk-only! fs)) prop))
(define (pfl-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (pfl-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (pfl-nn! t) (if (not (dk-asm? (list 'IN t 'NN))) (dk-type! t 'NN)))
(define (pfl-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
;; (IN (H c z) (FUN NN CC)) with c in FUN(NN, CC) and z in CC in context
(define (pfl-H-typ! c z)
  (let ((g (list 'IN (pfl-H c z) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'fun-apply-type-c c 'NN 'CC j)
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfl-close-open!)))))))
    g))
;; (= ((H c z) j) (* (c j) (power z j))), j in NN
(define (pfl-H-at! c z j)
  (let ((e (list '= (list (pfl-H c z) j) (list '* (list c j) (list 'power z j)))))
    (if (not (dk-asm? e))
        (begin
          (fact 'fun-apply-type-c c 'NN 'CC j)
          (pfl-cc! (list '* (list c j) (list 'power z j)))
          (dk-have! e (lambda () (dk-close-if! (lambda () (dk-lam-b!)) rfl)))))
    e))
;; PS(H, n) in CC
(define (pfl-PS-typ! c z n)
  (pfl-H-typ! c z) (pfl-nn! n)
  (let ((g (list 'IN (pfl-PS c z n) 'CC)))
    (if (not (dk-asm? g)) (dk-cite! 'cc-series-partial-sum-in-cc n (pfl-H c z)))
    g))
;; PS(H, succ n) == PS(H, n) + H(n)  then  H(n) = c(n) z^n
(define (pfl-PS-succ! c z n)
  (pfl-PS-typ! c z n)
  (fact 'fun-apply-type-c (pfl-H c z) 'NN 'CC n)
  (let ((s (pfl-chain! (dk-fact! 'cc-series-partial-sum-succ (pfl-H c z) n))))
    (pfl-H-at! c z n)
    s))

;;; ----------------------------------------------------------------------
;;; CF-CONS: values and typing
;;; ----------------------------------------------------------------------
(define pfl-cons-body '(+ (* pfb_ (power 0 pfk_)) (* (- 1 (power 0 pfk_)) (pfc_ (NN-MINUS pfk_ 1)))))
(sp (make-wff (list 'FORALL 'pfb_ (list 'FORALL 'pfc_ (list '== '(CF-CONS pfb_ pfc_) (list 'VNB-LAMBDA 'pfk_ 'NN pfl-cons-body))))))
(di) (mac 'CF-CONS) (qrfl)
(qed 'cf-cons-unfold)
(topic! 'cf-cons-unfold 'analysis)

;; 0^0 = 1 and 0^(succ j) = 0
;;; CUT 2026-10-27 (integration): `cc-power-zero-succ' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `power-zero-base', which is cited below in its place (proven-duplicate audit).

;; the values: CF-CONS(b, c)(0) = b, CF-CONS(b, c)(succ j) = c(j)
(define (pfl-cons-setup! k)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
  (pfl-nn! k)
  (fact 'nn-minus-in-nn k 1)
  (fact 'fun-apply-type-c 'pfc_ 'NN 'CC (list 'NN-MINUS k 1))
  (pfl-cc! (list 'power 0 k))
  (pfl-cc! (list '+ (list '* 'pfb_ (list 'power 0 k)) (list '* (list '- 1 (list 'power 0 k)) (list 'pfc_ (list 'NN-MINUS k 1)))))
  (subst (dk-cite! 'cf-cons-unfold 'pfb_ 'pfc_))
  (dk-close-if! (lambda () (dk-lam-b!)) (lambda () #t)))
(sp (make-wff '(FORALL pfb_ (IMPLIES (IN pfb_ CC) (FORALL pfc_ (IMPLIES (IN pfc_ (FUN NN CC)) (= ((CF-CONS pfb_ pfc_) 0) pfb_)))))))
(dk-peel!)
(fact 'nn-zero-in)
(pfl-cons-setup! 0)
(subst (dk-cite! 'power-zero 0))
(crs)
(qed 'cf-cons-zero)
(topic! 'cf-cons-zero 'analysis)

(sp (make-wff '(FORALL pfb_ (IMPLIES (IN pfb_ CC) (FORALL pfc_ (IMPLIES (IN pfc_ (FUN NN CC))
  (FORALL pfj_ (IMPLIES (IN pfj_ NN) (= ((CF-CONS pfb_ pfc_) (succ pfj_)) (pfc_ pfj_))))))))))
(dk-peel!)
(fact 'nn-succ-closed 'pfj_)
(pfl-cons-setup! '(succ pfj_))
(subst (dk-cite! 'power-zero-base 'pfj_))
(subst (dk-cite! 'nn-minus-succ-1 'pfj_))
(fact 'fun-apply-type-c 'pfc_ 'NN 'CC 'pfj_)
(crs)
(qed 'cf-cons-succ)
(topic! 'cf-cons-succ 'analysis)

;;; the subring facts, landed from IS-CC-SUBRING(kc)
(define (pfl-sub-parts! kc)
  (let ((h (list 'IS-CC-SUBRING kc)))
    (dk-project! (list 'SUBSET kc 'CC) 'IS-CC-SUBRING h)
    (dk-project! (list 'IN 0 kc) 'IS-CC-SUBRING h)
    (dk-project! (list 'IN 1 kc) 'IS-CC-SUBRING h)
    (dk-project! (pfl-sub-add kc) 'IS-CC-SUBRING h)
    (dk-project! (pfl-sub-mul kc) 'IS-CC-SUBRING h)))
(define (pfl-sub-add kc) (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kc) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kc) (list 'IN '(+ psu_ psv_) kc))))))
(define (pfl-sub-mul kc) (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kc) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kc) (list 'IN '(* psu_ psv_) kc))))))
(define (pfl-K+! kc u v) (if (not (dk-asm? (list 'IN (list '+ u v) kc))) (dk-apply! (pfl-sub-add kc) u v)))
(define (pfl-K*! kc u v) (if (not (dk-asm? (list 'IN (list '* u v) kc))) (dk-apply! (pfl-sub-mul kc) u v)))
(define (pfl-KCC! kc t) (if (not (dk-asm? (list 'IN t 'CC))) (fact 'subset-mem-fwd kc 'CC t)))
;; (IN (CF-CONS b c) (FUN NN CC)) from b in CC, c in FUN(NN, CC)
(define (pfl-cons-cc! b c)
  (let ((g (list 'IN (list 'CF-CONS b c) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (subst (dk-cite! 'cf-cons-unfold b c))
            (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
            (dk-lam-type!
              (lambda ()
                (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'nn-minus-in-nn k 1)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'NN-MINUS k 1))
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfl-close-open!)))))))
    g))

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL pfb_ (IMPLIES (IN pfb_ kk) (FORALL pfc_ (IMPLIES (IN pfc_ (FUN NN kk))
  (IN (CF-CONS pfb_ pfc_) (FUN NN kk))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(pfl-KCC! 'kk 'pfb_)
(fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC)
(pfl-cons-cc! 'pfb_ 'pfc_)
(let* ((fcons '(CF-CONS pfb_ pfc_))
       (i1 (dk-cite! 'fun-codomain-iff 'NN 'CC fcons))
       (i2 (dk-cite! 'fun-codomain-iff 'NN 'kk fcons)))
  (dk-have! (list 'IN fcons '(FUN NN)) (lambda () (pfl-only-prop! i1 (list 'IN fcons '(FUN NN CC)))))
  (dk-have! (caddr i2)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((x (dk-di-var!)))
                (use-cases (dk-cite! 'nn-zero-or-succ x)
                  (lambda ()
                    (subst (list '= x 0))
                    (fact 'nn-zero-in)
                    (subst (dk-cite! 'cf-cons-zero 'pfb_ 'pfc_))
                    (ass))
                  (lambda ()
                    (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f x))) "x = succ q")))
                           (_0 (dk-split-all!)))
                      (subst (list '= x (list 'succ q)))
                      (subst (dk-cite! 'cf-cons-succ 'pfb_ 'pfc_ q))
                      (fact 'fun-apply-type-c 'pfc_ 'NN 'kk q)
                      (pfl-close-open!))))))))))
  (pfl-only-prop! i2 (caddr i2)))
(qed 'cf-cons-in-fun)
(topic! 'cf-cons-in-fun 'analysis)

;;; ----------------------------------------------------------------------
;;; THE CONS LAW: sum_{j < n+1} CF-CONS(b, c)(j) z^j = b + z sum_{j < n} c(j) z^j
;;; ----------------------------------------------------------------------
(define pfl-cons '(CF-CONS pfb_ pfc_))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfb_ (list 'IMPLIES '(IN pfb_ CC) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC)
    (list '= (pfl-PS pfl-cons 'pfz_ '(succ n)) (list '+ 'pfb_ (list '* 'pfz_ (pfl-PS 'pfc_ 'pfz_ 'n))))))))))))))
(let* ((ind (use-induction))
       (v (cdr (assq 'var ind)))
       (ih (cdr (assq 'ih ind))))
  ;; base: PS(cons, 1) = PS(cons, 0) + cons(0) z^0 = b; PS(c, 0) = 0
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in) (fact 'cc-zero-in) (fact 'cc-one-in)
  (pfl-cons-cc! 'pfb_ 'pfc_)
  (let ((s (pfl-PS-succ! pfl-cons 'pfz_ 0)))
    (subst s)
    (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H pfl-cons 'pfz_)))
    (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H 'pfc_ 'pfz_)))
    (subst (pfl-H-at! pfl-cons 'pfz_ 0))
    (subst (dk-cite! 'cf-cons-zero 'pfb_ 'pfc_))
    (subst (dk-cite! 'power-zero 'pfz_))
    (crs))
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((lk (dk-peel!)) (sv (list 'succ v)))
    (fact 'nn-succ-closed v)
    (fact 'cc-zero-in) (fact 'cc-one-in)
    (pfl-cons-cc! 'pfb_ 'pfc_)
    (let ((ihi (dk-apply! ih 'pfb_ 'pfc_ 'pfz_)))
      (subst (pfl-PS-succ! pfl-cons 'pfz_ sv))
      (subst ihi)
      (subst (pfl-H-at! pfl-cons 'pfz_ sv))
      (subst (dk-cite! 'cf-cons-succ 'pfb_ 'pfc_ v))
      (subst (pfl-PS-succ! 'pfc_ 'pfz_ v))
      (subst (pfl-H-at! 'pfc_ 'pfz_ v))
      (fact 'fun-apply-type-c 'pfc_ 'NN 'CC v)
      (pfl-cc! (list 'power 'pfz_ v))
      (subst (pfl-chain! (dk-fact! 'power-succ 'pfz_ v)))
      (crs))))
(qed 'cc-ps-cons)
(topic! 'cc-ps-cons 'analysis)

;;; ----------------------------------------------------------------------
;;; STABILITY: coefficients vanishing from n on, the partial sums stop changing at n
;;; ----------------------------------------------------------------------
(define (pfl-vanish c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'IMPLIES (pfl-vanish 'pfc_ 'n) (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC)
    (list '= (pfl-PS 'pfc_ 'pfz_ '(+ n m)) (pfl-PS 'pfc_ 'pfz_ 'n)))))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (subst (dk-cite! 'nn-add-zero 'n))
  (pfl-PS-typ! 'pfc_ 'pfz_ 'n)
  (rfl)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((nv (list '+ 'n v)))
    (pfl-nn! nv)
    (subst (dk-cite! 'nn-add-succ 'n v))
    (subst (pfl-PS-succ! 'pfc_ 'pfz_ nv))
    (subst (dk-apply! ih 'n 'pfc_ 'pfz_))
    (subst (pfl-H-at! 'pfc_ 'pfz_ nv))
    (dk-cite! 'nn-le-add-right v 'n)
    (subst (dk-apply! (pfl-vanish 'pfc_ 'n) nv))
    (pfl-cc! (list 'power 'pfz_ nv))
    (pfl-PS-typ! 'pfc_ 'pfz_ 'n)
    (crs)))
(qed 'cc-ps-stable)
(topic! 'cc-ps-stable 'analysis)

;;; the partial sums of K-coefficients at points of kc lie in kc
(sp (make-wff '(FORALL pfi_ (IMPLIES (IN pfi_ NN) (FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL pfz_ (IMPLIES (IN pfz_ kk) (IN (power pfz_ pfi_) kk)))))))))
(let* ((ind (use-induction)) (w (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfl-sub-parts! 'kk)
  (pfl-KCC! 'kk 'pfz_)
  (subst (dk-cite! 'power-zero 'pfz_))
  (ass)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfl-sub-parts! 'kk)
  (pfl-KCC! 'kk 'pfz_)
  (dk-apply! ih 'kk 'pfz_)
  (pfl-cc! (list 'power 'pfz_ w))
  (subst (pfl-chain! (dk-fact! 'power-succ 'pfz_ w)))
  (pfl-K*! 'kk 'pfz_ (list 'power 'pfz_ w))
  (pfl-close-open!))
(qed 'cc-subring-power)
(topic! 'cc-subring-power 'analysis)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk)
  (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN kk)) (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ kk)
    (list 'IN (pfl-PS 'pfc_ 'pfz_ 'n) 'kk)))))))))))
(define (pfl-pow-in! kc z k)                 ; z^k in kc, z in kc, k in NN
  (if (not (dk-asm? (list 'IN (list 'power z k) kc))) (dk-cite! 'cc-subring-power k kc z)))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfl-sub-parts! 'kk)
  (fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC)
  (pfl-KCC! 'kk 'pfz_)
  (pfl-H-typ! 'pfc_ 'pfz_)
  (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H 'pfc_ 'pfz_)))
  (ass)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfl-sub-parts! 'kk)
  (fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC)
  (pfl-KCC! 'kk 'pfz_)
  (dk-apply! ih 'kk 'pfc_ 'pfz_)
  (subst (pfl-PS-succ! 'pfc_ 'pfz_ v))
  (subst (pfl-H-at! 'pfc_ 'pfz_ v))
  (fact 'fun-apply-type-c 'pfc_ 'NN 'kk v)
  (pfl-pow-in! 'kk 'pfz_ v)
  (pfl-K*! 'kk (list 'pfc_ v) (list 'power 'pfz_ v))
  (pfl-K+! 'kk (pfl-PS 'pfc_ 'pfz_ v) (list '* (list 'pfc_ v) (list 'power 'pfz_ v)))
  (pfl-close-open!))
(qed 'cc-ps-in-subring)
(topic! 'cc-ps-in-subring 'analysis)

;;; LINEAR COMBINATIONS of coefficient sequences, proved here so that this file needs nothing from
;;; cc-power-series-deriv: e(j) = al c(j) + be d(j) for all j gives PS(e) = al PS(c) + be PS(d)
(define (pfl-lcomb e c d al be) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list e 'pfk_) (list '+ (list '* al (list c 'pfk_)) (list '* be (list d 'pfk_)))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC)) (list 'FORALL 'pfd_ (list 'IMPLIES '(IN pfd_ (FUN NN CC))
  (list 'FORALL 'pfe_ (list 'IMPLIES '(IN pfe_ (FUN NN CC)) (list 'FORALL 'pfal_ (list 'IMPLIES '(IN pfal_ CC) (list 'FORALL 'pfbe_ (list 'IMPLIES '(IN pfbe_ CC)
    (list 'IMPLIES (pfl-lcomb 'pfe_ 'pfc_ 'pfd_ 'pfal_ 'pfbe_) (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC)
      (list '= (pfl-PS 'pfe_ 'pfz_ 'n) (list '+ (list '* 'pfal_ (pfl-PS 'pfc_ 'pfz_ 'n)) (list '* 'pfbe_ (pfl-PS 'pfd_ 'pfz_ 'n)))))))))))))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (for-each (lambda (c) (pfl-H-typ! c 'pfz_)) '(pfc_ pfd_ pfe_))
  (for-each (lambda (c) (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H c 'pfz_)))) '(pfe_ pfc_ pfd_))
  (crs)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (for-each (lambda (c) (pfl-PS-typ! c 'pfz_ v) (fact 'fun-apply-type-c c 'NN 'CC v)) '(pfc_ pfd_ pfe_))
  (pfl-cc! (list 'power 'pfz_ v))
  (let ((ihi (dk-apply! ih 'pfc_ 'pfd_ 'pfe_ 'pfal_ 'pfbe_ 'pfz_)))
    (for-each (lambda (c) (subst (pfl-PS-succ! c 'pfz_ v)) (subst (pfl-H-at! c 'pfz_ v))) '(pfe_ pfc_ pfd_))
    (subst ihi)
    (subst (dk-apply! (pfl-lcomb 'pfe_ 'pfc_ 'pfd_ 'pfal_ 'pfbe_) v))
    (crs)))
(qed 'cc-ps-lincomb)
(topic! 'cc-ps-lincomb 'analysis)

;;; ======================================================================
;;; POLYNOMIAL FUNCTIONS: opening the predicate, introducing it
;;; ======================================================================
(define (pfl-poly-rhs kc a f) (caddr (dk-cite! 'is-poly-fn-on kc a f)))
;; from (IS-POLY-FN-ON kc a f) in context: land a subset kc, f in FUN(a, kc), and skolem n, c with
;; n in NN, c in FUN(NN, kc), the vanishing and the value universal; return (n c)
(define (pfl-poly-open! kc a f)
  (let* ((h (list 'IS-POLY-FN-ON kc a f))
         (iff (dk-cite! 'is-poly-fn-on kc a f))
         (rhs (caddr iff)))
    (dk-project! (list 'SUBSET a kc) (lambda () (dk-only! iff h)))
    (dk-project! (list 'IN f (list 'FUN a kc)) (lambda () (dk-only! iff h)))
    (let* ((ex (caddr (caddr rhs))))
      (dk-project! ex (lambda () (dk-only! iff h)))
      (let* ((n (dk-skolem! ex))
             (_0 (dk-split-all!))
             (ex2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm n) (dk-contains? fm f))) "the coefficients"))
             (c (dk-skolem! ex2))
             (_1 (dk-split-all!)))
        (list n c)))))
;; the value universal of an opened polynomial
(define (pfl-val f a c n)
  (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list f 'pfz_) (pfl-PS c 'pfz_ n)))))
;; prove (IS-POLY-FN-ON kc a g): a subset kc, g in FUN(a, kc), n in NN, c in FUN(NN, kc), the vanishing in
;; context; VAL! gets the eigenvariable z (with (IN z a)) and closes (= (g z) PS(c, z, n))
(define (pfl-poly-intro! kc a g n c val!)
  (let* ((iff (dk-cite! 'is-poly-fn-on kc a g)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew n)
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'FORSOME)
                              (ew c)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-asm? (dk-goal)) (ass))
                                        (#t (let ((z (dk-di-var!))) (val! z) (pfl-close-open!)))))))
                             (#t (error "pfl-poly-intro!: unexpected goal" (expression->string (dk-goal))))))))
                  (#t (error "pfl-poly-intro!: unexpected goal" (expression->string (dk-goal)))))))))
    (pfl-only-prop! iff rhs)))
;; g = (VNB-LAMBDA x a body) in FUN(a, kc): TYPER! gets x (with (IN x a), x in kc and in CC landed) and lands
;; (IN body[x] kc)
(define (pfl-lam-kc! g a kc typer!)
  (let ((goal (list 'IN g (list 'FUN a kc))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'subset-mem-fwd a kc x)
                  (pfl-KCC! kc x)
                  (if (not (sequent-node-grounded? leaf)) (typer! x))
                  (pfl-close-open!)))))))
    goal))
;; set facts: kc and a are sets (kc subset CC, a subset kc)
(define (pfl-sets! kc a)
  (fact 'cc-is-set)
  (if (not (dk-asm? (list 'IN kc 'SET))) (fact 'subclass-of-set-is-set kc 'CC))
  (if (not (dk-asm? (list 'IN a 'SET))) (fact 'subclass-of-set-is-set a kc)))
;; beta the focus goal, then CLOSE! unless that grounded it
(define (pfl-beta! close!)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (close!))))

;;; ----------------------------------------------------------------------
;;; extensionality: a function equal on A to a polynomial function is one
;;; ----------------------------------------------------------------------
(sp (make-wff '(FORALL kk (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (FORALL g (IMPLIES (IN g (FUN a kk)) (IMPLIES (FORALL pfz_ (IMPLIES (IN pfz_ a) (= (g pfz_) (f pfz_))))
    (IS-POLY-FN-ON kk a g))))))))))
(dk-peel!)
(let* ((nc (pfl-poly-open! 'kk 'a 'f)) (n (car nc)) (c (cadr nc)))
  (pfl-poly-intro! 'kk 'a 'g n c
    (lambda (z)
      (subst (dk-apply! '(FORALL pfz_ (IMPLIES (IN pfz_ a) (= (g pfz_) (f pfz_)))) z))
      (dk-apply! (pfl-val 'f 'a c n) z))))
(qed 'poly-fn-ext)
(topic! 'poly-fn-ext 'analysis)

;;; a coefficient index k >= succ n is succ q with n <= q (or the case is absurd): runs (K q) on the succ
;;; branch, the goal unchanged except k replaced by succ q
(define (pfl-succ-case! k n kq!)
  (use-cases (dk-cite! 'nn-zero-or-succ k)
    (lambda ()
      (dk-rewrite-h! (list '<= (list 'succ n) k) k 0)
      (pfl-nn! (list 'succ n))
      (fact 'nn-le-zero-is-zero (list 'succ n))
      (fact 'nn-succ-nonzero n)
      (pfl-only-prop! (list '= (list 'succ n) 0) (list 'NOT (list '= (list 'succ n) 0))))
    (lambda ()
      (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
             (_0 (dk-split-all!)))
        (dk-rewrite-h! (list '<= (list 'succ n) k) k (list 'succ q))
        (subst (list '= k (list 'succ q)))
        (pfl-chain! (dk-fact! 'nn-succ-le-cancel n q))
        (kq! q)))))
(define pfl-Z '(VNB-LAMBDA pfk_ NN 0))
(define (pfl-Z-typ! kc)
  (for-each (lambda (cls)
              (let ((g (list 'IN pfl-Z (list 'FUN 'NN cls))))
                (if (not (dk-asm? g))
                    (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (pfl-close-open!)))))))))
            (list kc 'CC)))

;;; constants
(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (IMPLIES (SUBSET a kk) (FORALL pfb_ (IMPLIES (IN pfb_ kk)
  (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a pfb_))))))))))
(dk-peel!)
