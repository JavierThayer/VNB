  (pfl-lam-kc! '(VNB-LAMBDA pfx_ a (* pfx_ (f pfx_))) 'a 'kk
    (lambda (x) (fact 'fun-apply-type-c 'f 'a 'kk x) (pfl-K*! 'kk x (list 'f x))))
  (pfl-poly-intro! 'kk 'a '(VNB-LAMBDA pfx_ a (* pfx_ (f pfx_))) (list 'succ n) cc1
    (lambda (z)
      (fact 'subset-mem-fwd 'a 'kk z) (pfl-KCC! 'kk z)
      (fact 'fun-apply-type-c 'f 'a 'kk z) (pfl-KCC! 'kk (list 'f z))
      (dk-close-if! (lambda () (dk-lam-b!)) (lambda () #t))
      (subst (dk-apply! (pfl-val 'f 'a c n) z))
      (subst (dk-cite! 'cc-ps-cons n 0 c z))
      (pfl-PS-typ! c z n)
      (crs))))
(qed 'poly-fn-mulz)
(topic! 'poly-fn-mulz 'analysis)

;;; alpha f + beta g
(define pfl-lin-g '(VNB-LAMBDA pfx_ a (+ (* pfal_ (f pfx_)) (* pfbe_ (g pfx_)))))
(sp (make-wff (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk) (list 'FORALL 'a (list 'FORALL 'f (list 'IMPLIES '(IS-POLY-FN-ON kk a f)
  (list 'FORALL 'g (list 'IMPLIES '(IS-POLY-FN-ON kk a g) (list 'FORALL 'pfal_ (list 'IMPLIES '(IN pfal_ kk) (list 'FORALL 'pfbe_ (list 'IMPLIES '(IN pfbe_ kk)
    (list 'IS-POLY-FN-ON 'kk 'a pfl-lin-g))))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(pfl-KCC! 'kk 'pfal_) (pfl-KCC! 'kk 'pfbe_)
(let* ((nc (pfl-poly-open! 'kk 'a 'f)) (n (car nc)) (c (cadr nc))
       (md (pfl-poly-open! 'kk 'a 'g)) (m (car md)) (d (cadr md))
       (e (list 'VNB-LAMBDA 'pfk_ 'NN (list '+ (list '* 'pfal_ (list c 'pfk_)) (list '* 'pfbe_ (list d 'pfk_)))))
       (nm (list '+ n m)))
  (pfl-sets! 'kk 'a)
  (fact 'fun-codomain-superset c 'NN 'kk 'CC)
  (fact 'fun-codomain-superset d 'NN 'kk 'CC)
  (pfl-nn! nm) (pfl-nn! (list '+ m n))
  (dk-have! (list '= nm (list '+ m n)) (lambda () (pfl-chain! (dk-fact! 'nn-add-comm n m)) (pfl-close-open!)))
  (for-each (lambda (cls)
              (dk-have! (list 'IN e (list 'FUN 'NN cls))
                (lambda ()
                  (dk-lam-type!
                    (lambda ()
                      (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (fact 'fun-apply-type-c c 'NN 'kk k) (fact 'fun-apply-type-c d 'NN 'kk k)
                        (pfl-K*! 'kk 'pfal_ (list c k)) (pfl-K*! 'kk 'pfbe_ (list d k))
                        (pfl-K+! 'kk (list '* 'pfal_ (list c k)) (list '* 'pfbe_ (list d k)))
                        (if (and (eq? cls 'CC) (not (sequent-node-grounded? leaf)))
                            (pfl-KCC! 'kk (cadr (dk-goal))))
                        (pfl-close-open!)))))))
            (list 'kk 'CC))
  (dk-have! (pfl-vanish e nm)
    (lambda ()
      (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (dk-cite! 'nn-le-add-right m n)
        (dk-cite! 'nn-le-add-right n m)
        (dk-have! (list '<= n k) (lambda () (pfl-chain! (dk-fact! 'nn-le-trans-guarded n nm k)) (pfl-close-open!)))
        (dk-have! (list '<= m k)
          (lambda ()
            (dk-rewrite-h! (list '<= nm k) nm (list '+ m n))
            (pfl-chain! (dk-fact! 'nn-le-trans-guarded m (list '+ m n) k))
            (pfl-close-open!)))
        (dk-apply! (pfl-vanish c n) k)
        (dk-apply! (pfl-vanish d m) k)
        (fact 'fun-apply-type-c c 'NN 'CC k) (fact 'fun-apply-type-c d 'NN 'CC k)
        (pfl-beta!
          (lambda ()
            (subst (list '= (list c k) 0))
            (subst (list '= (list d k) 0))
            (crs))))))
  (pfl-lam-kc! pfl-lin-g 'a 'kk
    (lambda (x)
      (fact 'fun-apply-type-c 'f 'a 'kk x) (fact 'fun-apply-type-c 'g 'a 'kk x)
      (pfl-K*! 'kk 'pfal_ (list 'f x)) (pfl-K*! 'kk 'pfbe_ (list 'g x))
      (pfl-K+! 'kk (list '* 'pfal_ (list 'f x)) (list '* 'pfbe_ (list 'g x)))))
  (pfl-poly-intro! 'kk 'a pfl-lin-g nm e
    (lambda (z)
      (fact 'subset-mem-fwd 'a 'kk z) (pfl-KCC! 'kk z)
      (fact 'fun-apply-type-c 'f 'a 'kk z) (fact 'fun-apply-type-c 'g 'a 'kk z)
      (pfl-KCC! 'kk (list 'f z)) (pfl-KCC! 'kk (list 'g z))
      (let ((gz (list '+ (list '* 'pfal_ (list 'f z)) (list '* 'pfbe_ (list 'g z)))))
        (pfl-cc! gz)
        (dk-have! (list '= (list pfl-lin-g z) gz) (lambda () (pfl-beta! rfl)))
        (subst (list '= (list pfl-lin-g z) gz)))
      (subst (dk-apply! (pfl-val 'f 'a c n) z))
      (subst (dk-apply! (pfl-val 'g 'a d m) z))
      (pfl-H-typ! c z) (pfl-H-typ! d z) (pfl-H-typ! e z)
      ;; PS(e) = alpha PS(c) + beta PS(d) at n + m
      (dk-have! (pfl-lcomb e c d 'pfal_ 'pfbe_)
        (lambda ()
          (let ((k (dk-di-var!)))
            (fact 'fun-apply-type-c c 'NN 'CC k) (fact 'fun-apply-type-c d 'NN 'CC k)
            (pfl-cc! (list '+ (list '* 'pfal_ (list c k)) (list '* 'pfbe_ (list d k))))
            (pfl-beta! rfl))))
      (subst (pfl-chain! (dk-fact! 'cc-ps-lincomb nm c d e 'pfal_ 'pfbe_ z)))
      (subst (pfl-chain! (dk-fact! 'cc-ps-stable m n c z)))
      (dk-have! (list '= (pfl-PS d z nm) (pfl-PS d z m))
        (lambda ()
          (subst (list '= nm (list '+ m n)))
          (pfl-chain! (dk-fact! 'cc-ps-stable n m d z))
          (pfl-close-open!)))
      (subst (list '= (pfl-PS d z nm) (pfl-PS d z m)))
      (pfl-PS-typ! c z n) (pfl-PS-typ! d z m)
      (rfl))))
(qed 'poly-fn-lin)
(topic! 'poly-fn-lin 'analysis)

;;; poly(kc, a, SRC) in context (SRC typed or not), TGT = (VNB-LAMBDA x a body): land poly(kc, a, TGT);
;;; TYPER! types TGT's body at a point (as in pfl-lam-kc!), EQ! closes (= (TGT z) (SRC z)) for z in a
(define (pfl-ext! kc a src tgt typer! eq!)
  (pfl-lam-kc! tgt a kc typer!)
  (let ((pw (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list tgt 'pfz_) (list src 'pfz_))))))
    (dk-have! pw (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd a kc z) (pfl-KCC! kc z) (eq! z) (pfl-close-open!))))
    (dk-cite! 'poly-fn-ext kc a src tgt)))
;; (= (LAM z) (LAM' z)) by beta on both sides and CLOSE! (crs by default)
(define (pfl-beta-eq! close!)
  (dk-close-if! (lambda () (dk-lam-b!)) close!))

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (FORALL g (IMPLIES (IS-POLY-FN-ON kk a g) (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a (+ (f pfx_) (g pfx_)))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(pfl-poly-open! 'kk 'a 'f) (pfl-poly-open! 'kk 'a 'g)
(pfl-sets! 'kk 'a)
(dk-cite! 'poly-fn-lin 'kk 'a 'f 'g 1 1)
(pfl-ext! 'kk 'a (list 'VNB-LAMBDA 'pfx_ 'a '(+ (* 1 (f pfx_)) (* 1 (g pfx_)))) '(VNB-LAMBDA pfx_ a (+ (f pfx_) (g pfx_)))
  (lambda (x) (fact 'fun-apply-type-c 'f 'a 'kk x) (fact 'fun-apply-type-c 'g 'a 'kk x) (pfl-K+! 'kk (list 'f x) (list 'g x)))
  (lambda (z) (fact 'fun-apply-type-c 'f 'a 'kk z) (fact 'fun-apply-type-c 'g 'a 'kk z) (pfl-KCC! 'kk (list 'f z)) (pfl-KCC! 'kk (list 'g z))
          (pfl-beta-eq! crs)))
(pfl-close-open!)
(qed 'poly-fn-add)
(topic! 'poly-fn-add 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (FORALL pfal_ (IMPLIES (IN pfal_ kk) (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a (* pfal_ (f pfx_)))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(pfl-poly-open! 'kk 'a 'f)
(pfl-sets! 'kk 'a)
(dk-cite! 'poly-fn-lin 'kk 'a 'f 'f 'pfal_ 0)
(pfl-ext! 'kk 'a (list 'VNB-LAMBDA 'pfx_ 'a '(+ (* pfal_ (f pfx_)) (* 0 (f pfx_)))) '(VNB-LAMBDA pfx_ a (* pfal_ (f pfx_)))
  (lambda (x) (fact 'fun-apply-type-c 'f 'a 'kk x) (pfl-K*! 'kk 'pfal_ (list 'f x)))
  (lambda (z) (fact 'fun-apply-type-c 'f 'a 'kk z) (pfl-KCC! 'kk (list 'f z)) (pfl-KCC! 'kk 'pfal_)
          (pfl-beta-eq! crs)))
(pfl-close-open!)
(qed 'poly-fn-scale)
(topic! 'poly-fn-scale 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (IMPLIES (SUBSET a kk) (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a pfx_))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(pfl-sets! 'kk 'a)
(define pfl-one '(VNB-LAMBDA pfx_ a 1))
(dk-cite! 'poly-fn-const 'kk 'a 1)
(dk-cite! 'poly-fn-mulz 'kk 'a pfl-one)
(pfl-ext! 'kk 'a (list 'VNB-LAMBDA 'pfx_ 'a (list '* 'pfx_ (list pfl-one 'pfx_))) '(VNB-LAMBDA pfx_ a pfx_)
  (lambda (x) #t)
  (lambda (z)
    (dk-have! (list '= (list pfl-one z) 1) (lambda () (pfl-beta! rfl)))
    (fact 'cc-one-in)
    (pfl-cc! (list '* z 1))
    (dk-have! (list '= (list (list 'VNB-LAMBDA 'pfx_ 'a (list '* 'pfx_ (list pfl-one 'pfx_))) z) (list '* z 1))
      (lambda () (pfl-beta! rfl)))
    (subst (list '= (list (list 'VNB-LAMBDA 'pfx_ 'a (list '* 'pfx_ (list pfl-one 'pfx_))) z) (list '* z 1)))
    (pfl-beta-eq! crs)))
(pfl-close-open!)
(qed 'poly-fn-id)
(topic! 'poly-fn-id 'analysis)

;;; congruence: pointwise-equal coefficients give equal partial sums
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC)) (list 'FORALL 'pfd_ (list 'IMPLIES '(IN pfd_ (FUN NN CC))
  (list 'IMPLIES '(FORALL pfk_ (IMPLIES (IN pfk_ NN) (= (pfc_ pfk_) (pfd_ pfk_))))
    (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC) (list '= (pfl-PS 'pfc_ 'pfz_ 'n) (pfl-PS 'pfd_ 'pfz_ 'n)))))))))))))
(dk-peel!)
(fact 'cc-one-in) (fact 'cc-zero-in)
(pfl-H-typ! 'pfc_ 'pfz_) (pfl-H-typ! 'pfd_ 'pfz_)
(dk-have! (pfl-lcomb 'pfc_ 'pfd_ 'pfd_ 1 0)
  (lambda ()
    (let ((k (dk-di-var!)))
      (fact 'fun-apply-type-c 'pfc_ 'NN 'CC k) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC k)
      (subst (dk-apply! '(FORALL pfk_ (IMPLIES (IN pfk_ NN) (= (pfc_ pfk_) (pfd_ pfk_)))) k))
      (crs))))
(subst (pfl-chain! (dk-fact! 'cc-ps-lincomb 'n 'pfd_ 'pfd_ 'pfc_ 1 0 'pfz_)))
(pfl-PS-typ! 'pfd_ 'pfz_ 'n)
(crs)
(qed 'cc-ps-congr)
(topic! 'cc-ps-congr 'analysis)

;;; the tail of a coefficient sequence as a fresh symbol t: t in FUN(NN, kc), t in FUN(NN, CC),
;;; t(k) = c(succ k).  A symbol, not the lambda: beta reduces under every binder, so a lambda tail would be
;;; rewritten inside the partial sums and no equation written with it would match afterwards.
(define (pfl-tail-val t c) (list 'FORALL 'pftk_ (list 'IMPLIES '(IN pftk_ NN) (list '= (list t 'pftk_) (list c '(succ pftk_))))))
(define (pfl-tail-sym! kc c)
  (let* ((lam (list 'VNB-LAMBDA 'pftk_ 'NN (list c '(succ pftk_))))
         (ex (list 'FORSOME 'pftt_ (list 'AND (list 'IN 'pftt_ (list 'FUN 'NN kc))
                (list 'AND (list 'IN 'pftt_ '(FUN NN CC)) (pfl-tail-val 'pftt_ c))))))
    (dk-have! ex
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (let ((cls (caddr (caddr (dk-goal)))))
                  (dk-lam-type!
                    (lambda ()
                      (let* ((k (dk-di-var!)))
                        (fact 'nn-succ-closed k)
                        (fact 'fun-apply-type-c c 'NN cls (list 'succ k))
                        (pfl-close-open!)))))
                (let ((k (dk-di-var!)))
                  (fact 'nn-succ-closed k)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
                  (pfl-beta! rfl)))))))
    (let ((t (dk-skolem! ex)))
      (dk-split-all!)
      t)))
;; the split of the partial sum at z: (= PS(c, z, succ v) (+ (c 0) (* z PS(t, z, v))))
(define (pfl-split! kc c t v z)
  (let* ((c0 (list c 0))
         (e (list '= (pfl-PS c z (list 'succ v)) (list '+ c0 (list '* z (pfl-PS t z v))))))
    (if (not (dk-asm? e))
        (begin
          (fact 'nn-zero-in)
          (fact 'fun-apply-type-c c 'NN 'CC 0)
          (pfl-cons-cc! c0 t)
          (fact 'nn-succ-closed v)
          (dk-have! (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c 'pfk_) (list (list 'CF-CONS c0 t) 'pfk_))))
            (lambda ()
              (let ((k (dk-di-var!)))
                (use-cases (dk-cite! 'nn-zero-or-succ k)
                  (lambda () (subst (list '= k 0)) (subst (dk-cite! 'cf-cons-zero c0 t)) (rfl))
                  (lambda ()
                    (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
                           (_0 (dk-split-all!)))
                      (subst (list '= k (list 'succ q)))
                      (subst (dk-cite! 'cf-cons-succ c0 t q))
                      (fact 'nn-succ-closed q)
                      (fact 'fun-apply-type-c c 'NN 'CC (list 'succ q))
                      (subst (dk-apply! (pfl-tail-val t c) q))
                      (rfl)))))))
          (dk-have! e
            (lambda ()
              (subst (pfl-chain! (dk-fact! 'cc-ps-congr (list 'succ v) c (list 'CF-CONS c0 t) z)))
              (subst (dk-cite! 'cc-ps-cons v c0 t z))
              (rfl)))))
    e))
;; the tail vanishes from v on when c vanishes from succ v on
(define (pfl-tail-vanish! c t v)
  (dk-have! (pfl-vanish t v)
    (lambda ()
      (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (fact 'nn-succ-closed k)
        (pfl-chain! (dk-fact! 'nn-succ-mono v k))
        (dk-apply! (pfl-vanish c (list 'succ v)) (list 'succ k))
        (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
        (subst (dk-apply! (pfl-tail-val t c) k))
        (subst (list '= (list c (list 'succ k)) 0))
        (rfl)))))

;;; ----------------------------------------------------------------------
;;; PRODUCTS, by induction on the length of the first polynomial
;;; ----------------------------------------------------------------------
(define (pfl-prodfn c n) (list 'VNB-LAMBDA 'pfx_ 'a (list '* (pfl-PS c 'pfx_ n) '(g pfx_))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk) (list 'FORALL 'a (list 'IMPLIES '(SUBSET a kk)
  (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN kk)) (list 'IMPLIES (pfl-vanish 'pfc_ 'n)
    (list 'FORALL 'g (list 'IMPLIES '(IS-POLY-FN-ON kk a g) (list 'IS-POLY-FN-ON 'kk 'a (pfl-prodfn 'pfc_ 'n)))))))))))))))
(define (pfl-prod-common!)
  (pfl-sub-parts! 'kk)
  (pfl-sets! 'kk 'a)
  (pfl-poly-open! 'kk 'a 'g)
  (fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC))
(define (pfl-prod-typer! n)
  (lambda (x)
    (fact 'fun-apply-type-c 'g 'a 'kk x)
    (dk-cite! 'cc-ps-in-subring n 'kk 'pfc_ x)
    (pfl-K*! 'kk (pfl-PS 'pfc_ x n) (list 'g x))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: the zero function
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfl-prod-common!)
  (fact 'nn-zero-in)
  (dk-cite! 'poly-fn-const 'kk 'a 0)
  (pfl-ext! 'kk 'a '(VNB-LAMBDA pfx_ a 0) (pfl-prodfn 'pfc_ 0) (pfl-prod-typer! 0)
    (lambda (z)
      (fact 'fun-apply-type-c 'g 'a 'kk z) (pfl-KCC! 'kk (list 'g z))
      (pfl-H-typ! 'pfc_ z)
      (pfl-PS-typ! 'pfc_ z 0)
      (pfl-cc! (list '* (pfl-PS 'pfc_ z 0) (list 'g z)))
      (dk-have! (list '= (list (pfl-prodfn 'pfc_ 0) z) (list '* (pfl-PS 'pfc_ z 0) (list 'g z))) (lambda () (pfl-beta! rfl)))
      (subst (list '= (list (pfl-prodfn 'pfc_ 0) z) (list '* (pfl-PS 'pfc_ z 0) (list 'g z))))
      (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H 'pfc_ z)))
      (pfl-beta-eq! crs)))
  (pfl-close-open!)
  ;; step: PS(c, succ v) g = c(0) g + x (PS(tail, v) g)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfl-prod-common!)
  (fact 'nn-succ-closed v)
  (fact 'nn-zero-in)
  (let* ((t (pfl-tail-sym! 'kk 'pfc_)) (c0 '(pfc_ 0))
         (q (pfl-prodfn t v))
         (xq (list 'VNB-LAMBDA 'pfx_ 'a (list '* 'pfx_ (list q 'pfx_))))
         (cg (list 'VNB-LAMBDA 'pfx_ 'a (list '* c0 '(g pfx_))))
         (sum (list 'VNB-LAMBDA 'pfx_ 'a (list '+ (list cg 'pfx_) (list xq 'pfx_)))))
    (pfl-tail-vanish! 'pfc_ t v)
    (fact 'fun-apply-type-c 'pfc_ 'NN 'kk 0)
    (dk-apply! ih 'kk 'a t 'g)
    (dk-cite! 'poly-fn-mulz 'kk 'a q)
    (dk-cite! 'poly-fn-scale 'kk 'a 'g c0)
    (dk-cite! 'poly-fn-add 'kk 'a cg xq)
    (pfl-ext! 'kk 'a sum (pfl-prodfn 'pfc_ (list 'succ v)) (pfl-prod-typer! (list 'succ v))
      (lambda (z)
        (fact 'fun-apply-type-c 'g 'a 'kk z) (pfl-KCC! 'kk (list 'g z))
        (pfl-KCC! 'kk c0)
        (pfl-PS-typ! t z v)
        (pfl-PS-typ! 'pfc_ z (list 'succ v))
        (let ((sp1 (pfl-split! 'kk 'pfc_ t v z))
              (lhs (list '* (pfl-PS 'pfc_ z (list 'succ v)) (list 'g z)))
              (rhs (list '+ (list '* c0 (list 'g z)) (list '* z (list '* (pfl-PS t z v) (list 'g z))))))
          (pfl-cc! lhs) (pfl-cc! (list '* (pfl-PS t z v) (list 'g z))) (pfl-cc! rhs)
          (dk-have! (list '= (list (pfl-prodfn 'pfc_ (list 'succ v)) z) lhs) (lambda () (pfl-beta! rfl)))
          (dk-have! (list '= (list sum z) rhs) (lambda () (pfl-beta! rfl)))
          (subst (list '= (list (pfl-prodfn 'pfc_ (list 'succ v)) z) lhs))
          (subst (list '= (list sum z) rhs))
          (subst sp1)
          (crs))))
    (pfl-close-open!)))
(qed 'poly-fn-mul-ps)
(topic! 'poly-fn-mul-ps 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (FORALL g (IMPLIES (IS-POLY-FN-ON kk a g) (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_)))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(let* ((nc (pfl-poly-open! 'kk 'a 'f)) (n (car nc)) (c (cadr nc)))
  (pfl-sets! 'kk 'a)
  (pfl-poly-open! 'kk 'a 'g)
  (fact 'fun-codomain-superset c 'NN 'kk 'CC)
  (dk-cite! 'poly-fn-mul-ps n 'kk 'a c 'g)
  (pfl-ext! 'kk 'a (list 'VNB-LAMBDA 'pfx_ 'a (list '* (pfl-PS c 'pfx_ n) '(g pfx_))) '(VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_)))
    (lambda (x) (fact 'fun-apply-type-c 'f 'a 'kk x) (fact 'fun-apply-type-c 'g 'a 'kk x) (pfl-K*! 'kk (list 'f x) (list 'g x)))
    (lambda (z)
      (fact 'fun-apply-type-c 'f 'a 'kk z) (fact 'fun-apply-type-c 'g 'a 'kk z)
      (pfl-KCC! 'kk (list 'f z)) (pfl-KCC! 'kk (list 'g z))
      (pfl-PS-typ! c z n)
      (let ((l1 (list '* (list 'f z) (list 'g z))) (r1 (list '* (pfl-PS c z n) (list 'g z))))
        (pfl-cc! l1) (pfl-cc! r1)
        (dk-have! (list '= (list '(VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_))) z) l1) (lambda () (pfl-beta! rfl)))
        (dk-have! (list '= (list (list 'VNB-LAMBDA 'pfx_ 'a (list '* (pfl-PS c 'pfx_ n) '(g pfx_))) z) r1) (lambda () (pfl-beta! rfl)))
        (subst (list '= (list '(VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_))) z) l1))
        (subst (list '= (list (list 'VNB-LAMBDA 'pfx_ 'a (list '* (pfl-PS c 'pfx_ n) '(g pfx_))) z) r1))
        (subst (dk-apply! (pfl-val 'f 'a c n) z))
        (rfl)))))
(pfl-close-open!)
(qed 'poly-fn-mul)
(topic! 'poly-fn-mul 'analysis)

;;; ----------------------------------------------------------------------
;;; COMPOSITION WITH AN AFFINE MAP x |-> alpha x + beta
;;; ----------------------------------------------------------------------
(define pfl-L '(+ (* pfal_ pfx_) pfbe_))
(define (pfl-Lat x) (list '+ (list '* 'pfal_ x) 'pfbe_))
(define (pfl-affps c n) (list 'VNB-LAMBDA 'pfx_ 'a (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power pfl-L 'pfj_))) n)))
(define (pfl-aff-pt! x)                 ; x in a: alpha x + beta in kk and CC
  (fact 'subset-mem-fwd 'a 'kk x) (pfl-KCC! 'kk x)
  (pfl-K*! 'kk 'pfal_ x) (pfl-K+! 'kk (list '* 'pfal_ x) 'pfbe_) (pfl-KCC! 'kk (pfl-Lat x)))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk) (list 'FORALL 'a (list 'IMPLIES '(SUBSET a kk)
  (list 'FORALL 'pfal_ (list 'IMPLIES '(IN pfal_ kk) (list 'FORALL 'pfbe_ (list 'IMPLIES '(IN pfbe_ kk)
    (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN kk)) (list 'IMPLIES (pfl-vanish 'pfc_ 'n)
      (list 'IS-POLY-FN-ON 'kk 'a (pfl-affps 'pfc_ 'n)))))))))))))))))
(define (pfl-aff-common!)
  (pfl-sub-parts! 'kk)
  (pfl-sets! 'kk 'a)
  (pfl-KCC! 'kk 'pfal_) (pfl-KCC! 'kk 'pfbe_)
  (fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC))
(define (pfl-aff-typer! n)
  (lambda (x) (pfl-aff-pt! x) (dk-cite! 'cc-ps-in-subring n 'kk 'pfc_ (pfl-Lat x))))
(define (pfl-aff-val! fn z expect)       ; (= (fn z) expect) by beta, after typing expect
  (pfl-cc! expect)
  (dk-have! (list '= (list fn z) expect) (lambda () (pfl-beta! rfl)))
  (subst (list '= (list fn z) expect)))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfl-aff-common!)
  (fact 'nn-zero-in)
  (dk-cite! 'poly-fn-const 'kk 'a 0)
  (pfl-ext! 'kk 'a '(VNB-LAMBDA pfx_ a 0) (pfl-affps 'pfc_ 0) (pfl-aff-typer! 0)
    (lambda (z)
      (pfl-aff-pt! z)
      (pfl-PS-typ! 'pfc_ (pfl-Lat z) 0)
      (pfl-aff-val! (pfl-affps 'pfc_ 0) z (pfl-PS 'pfc_ (pfl-Lat z) 0))
      (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H 'pfc_ (pfl-Lat z))))
      (pfl-beta-eq! crs)))
  (pfl-close-open!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfl-aff-common!)
  (fact 'nn-succ-closed v)
  (fact 'nn-zero-in) (fact 'cc-one-in)
  (let* ((t (pfl-tail-sym! 'kk 'pfc_)) (c0 '(pfc_ 0))
         (q (pfl-affps t v))
         (idf '(VNB-LAMBDA pfx_ a pfx_))
         (onef '(VNB-LAMBDA pfx_ a 1))
         (lin (list 'VNB-LAMBDA 'pfx_ 'a (list '+ (list '* 'pfal_ (list idf 'pfx_)) (list '* 'pfbe_ (list onef 'pfx_)))))
         (lf (list 'VNB-LAMBDA 'pfx_ 'a pfl-L))
         (prod (list 'VNB-LAMBDA 'pfx_ 'a (list '* (list lf 'pfx_) (list q 'pfx_))))
         (cst (list 'VNB-LAMBDA 'pfx_ 'a c0))
         (sum (list 'VNB-LAMBDA 'pfx_ 'a (list '+ (list cst 'pfx_) (list prod 'pfx_)))))
    (pfl-tail-vanish! 'pfc_ t v)
    (fact 'fun-apply-type-c 'pfc_ 'NN 'kk 0)
    (dk-apply! ih 'kk 'a 'pfal_ 'pfbe_ t)
    (dk-cite! 'poly-fn-id 'kk 'a)
    (dk-cite! 'poly-fn-const 'kk 'a 1)
    (dk-cite! 'poly-fn-lin 'kk 'a idf onef 'pfal_ 'pfbe_)
    (pfl-ext! 'kk 'a lin lf (lambda (x) (pfl-aff-pt! x))
      (lambda (z)
        (pfl-aff-pt! z)
        (pfl-aff-val! lf z (pfl-Lat z))
        (pfl-beta-eq! crs)))
    (dk-cite! 'poly-fn-mul 'kk 'a lf q)
    (dk-cite! 'poly-fn-const 'kk 'a c0)
    (dk-cite! 'poly-fn-add 'kk 'a cst prod)
    (pfl-ext! 'kk 'a sum (pfl-affps 'pfc_ (list 'succ v)) (pfl-aff-typer! (list 'succ v))
      (lambda (z)
        (pfl-aff-pt! z)
        (let* ((w (pfl-Lat z)))
          (pfl-KCC! 'kk c0)
          (pfl-PS-typ! t w v)
          (pfl-PS-typ! 'pfc_ w (list 'succ v))
          (pfl-split! 'kk 'pfc_ t v w)
          (pfl-aff-val! (pfl-affps 'pfc_ (list 'succ v)) z (pfl-PS 'pfc_ w (list 'succ v)))
          (pfl-aff-val! sum z (list '+ c0 (list '* w (pfl-PS t w v))))
          (subst (pfl-split! 'kk 'pfc_ t v w))
          (rfl))))
    (pfl-close-open!)))
(qed 'poly-fn-affine-ps)
(topic! 'poly-fn-affine-ps 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL pfbb_ (FORALL f (IMPLIES (IS-POLY-FN-ON kk pfbb_ f)
  (FORALL a (IMPLIES (SUBSET a kk) (FORALL pfal_ (IMPLIES (IN pfal_ kk) (FORALL pfbe_ (IMPLIES (IN pfbe_ kk)
    (IMPLIES (FORALL pfx_ (IMPLIES (IN pfx_ a) (IN (+ (* pfal_ pfx_) pfbe_) pfbb_)))
      (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a (f (+ (* pfal_ pfx_) pfbe_))))))))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(let* ((nc (pfl-poly-open! 'kk 'pfbb_ 'f)) (n (car nc)) (c (cadr nc))
       (inb '(FORALL pfx_ (IMPLIES (IN pfx_ a) (IN (+ (* pfal_ pfx_) pfbe_) pfbb_)))))
  (pfl-sets! 'kk 'a)
  (fact 'fun-codomain-superset c 'NN 'kk 'CC)
  (pfl-KCC! 'kk 'pfal_) (pfl-KCC! 'kk 'pfbe_)
  (dk-cite! 'poly-fn-affine-ps n 'kk 'a 'pfal_ 'pfbe_ c)
  (pfl-ext! 'kk 'a (list 'VNB-LAMBDA 'pfx_ 'a (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power pfl-L 'pfj_))) n))
                   '(VNB-LAMBDA pfx_ a (f (+ (* pfal_ pfx_) pfbe_)))
    (lambda (x) (dk-apply! inb x) (fact 'fun-apply-type-c 'f 'pfbb_ 'kk (pfl-Lat x)))
    (lambda (z)
      (pfl-aff-pt! z)
      (dk-apply! inb z)
      (fact 'fun-apply-type-c 'f 'pfbb_ 'kk (pfl-Lat z)) (pfl-KCC! 'kk (list 'f (pfl-Lat z)))
      (pfl-PS-typ! c (pfl-Lat z) n)
      (pfl-aff-val! '(VNB-LAMBDA pfx_ a (f (+ (* pfal_ pfx_) pfbe_))) z (list 'f (pfl-Lat z)))
      (pfl-aff-val! (list 'VNB-LAMBDA 'pfx_ 'a (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power pfl-L 'pfj_))) n)) z
                    (pfl-PS c (pfl-Lat z) n))
      (subst (dk-apply! (pfl-val 'f 'pfbb_ c n) (pfl-Lat z)))
      (rfl))))
(pfl-close-open!)
(qed 'poly-fn-affine)
(topic! 'poly-fn-affine 'analysis)

;;; ----------------------------------------------------------------------
;;; COMPOSITION of two polynomial functions (POLY-2)
;;; ----------------------------------------------------------------------
(define (pfl-compps c n) (list 'VNB-LAMBDA 'pfx_ 'a (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power '(g pfx_) 'pfj_))) n)))
(define (pfl-comp-pt! x)                 ; x in a: g(x) in kk and CC
  (fact 'subset-mem-fwd 'a 'kk x) (pfl-KCC! 'kk x)
  (fact 'fun-apply-type-c 'g 'a 'kk x) (pfl-KCC! 'kk (list 'g x)))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk) (list 'FORALL 'a (list 'FORALL 'g (list 'IMPLIES '(IS-POLY-FN-ON kk a g)
  (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN kk)) (list 'IMPLIES (pfl-vanish 'pfc_ 'n)
    (list 'IS-POLY-FN-ON 'kk 'a (pfl-compps 'pfc_ 'n))))))))))))))
(define (pfl-comp-common!)
  (pfl-sub-parts! 'kk)
  (pfl-poly-open! 'kk 'a 'g)
  (pfl-sets! 'kk 'a)
  (fact 'fun-codomain-superset 'pfc_ 'NN 'kk 'CC))
(define (pfl-comp-typer! n)
  (lambda (x) (pfl-comp-pt! x) (dk-cite! 'cc-ps-in-subring n 'kk 'pfc_ (list 'g x))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfl-comp-common!)
  (fact 'nn-zero-in)
  (dk-cite! 'poly-fn-const 'kk 'a 0)
  (pfl-ext! 'kk 'a '(VNB-LAMBDA pfx_ a 0) (pfl-compps 'pfc_ 0) (pfl-comp-typer! 0)
    (lambda (z)
      (pfl-comp-pt! z)
      (pfl-PS-typ! 'pfc_ (list 'g z) 0)
      (pfl-aff-val! (pfl-compps 'pfc_ 0) z (pfl-PS 'pfc_ (list 'g z) 0))
      (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H 'pfc_ (list 'g z))))
      (pfl-beta-eq! crs)))
  (pfl-close-open!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfl-comp-common!)
  (fact 'nn-succ-closed v)
  (fact 'nn-zero-in)
  (let* ((t (pfl-tail-sym! 'kk 'pfc_)) (c0 '(pfc_ 0))
         (q (pfl-compps t v))
         (prod (list 'VNB-LAMBDA 'pfx_ 'a (list '* '(g pfx_) (list q 'pfx_))))
         (cst (list 'VNB-LAMBDA 'pfx_ 'a c0))
         (sum (list 'VNB-LAMBDA 'pfx_ 'a (list '+ (list cst 'pfx_) (list prod 'pfx_)))))
    (pfl-tail-vanish! 'pfc_ t v)
    (fact 'fun-apply-type-c 'pfc_ 'NN 'kk 0)
    (dk-apply! ih 'kk 'a 'g t)
    (dk-cite! 'poly-fn-mul 'kk 'a 'g q)
    (dk-cite! 'poly-fn-const 'kk 'a c0)
    (dk-cite! 'poly-fn-add 'kk 'a cst prod)
    (pfl-ext! 'kk 'a sum (pfl-compps 'pfc_ (list 'succ v)) (pfl-comp-typer! (list 'succ v))
      (lambda (z)
        (pfl-comp-pt! z)
        (let* ((w (list 'g z)))
          (pfl-KCC! 'kk c0)
          (pfl-PS-typ! t w v)
          (pfl-PS-typ! 'pfc_ w (list 'succ v))
          (pfl-split! 'kk 'pfc_ t v w)
          (pfl-aff-val! (pfl-compps 'pfc_ (list 'succ v)) z (pfl-PS 'pfc_ w (list 'succ v)))
          (pfl-aff-val! sum z (list '+ c0 (list '* w (pfl-PS t w v))))
          (subst (pfl-split! 'kk 'pfc_ t v w))
          (rfl))))
    (pfl-close-open!)))
(qed 'poly-fn-comp-ps)
(topic! 'poly-fn-comp-ps 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL pfbb_ (FORALL f (IMPLIES (IS-POLY-FN-ON kk pfbb_ f)
  (FORALL a (FORALL g (IMPLIES (IS-POLY-FN-ON kk a g) (IMPLIES (FORALL pfx_ (IMPLIES (IN pfx_ a) (IN (g pfx_) pfbb_)))
