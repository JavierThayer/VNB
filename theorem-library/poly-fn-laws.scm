(define pfl-cC (list 'CF-CONS 'pfb_ pfl-Z))
(dk-cite! 'cf-cons-in-fun 'kk 'pfb_ pfl-Z)
(pfl-cons-cc! 'pfb_ pfl-Z)
(fact 'nn-succ-closed 0)
(dk-have! (pfl-vanish pfl-cC '(succ 0))
  (lambda ()
    (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
      (pfl-succ-case! k 0
        (lambda (q)
          (subst (dk-cite! 'cf-cons-succ 'pfb_ pfl-Z q))
          (pfl-beta! rfl))))))
(pfl-lam-kc! '(VNB-LAMBDA pfx_ a pfb_) 'a 'kk (lambda (x) #t))
(pfl-poly-intro! 'kk 'a '(VNB-LAMBDA pfx_ a pfb_) '(succ 0) pfl-cC
  (lambda (z)
    (fact 'subset-mem-fwd 'a 'kk z) (pfl-KCC! 'kk z)
    (dk-close-if! (lambda () (dk-lam-b!)) (lambda () #t))
    (subst (dk-cite! 'cc-ps-cons 0 'pfb_ pfl-Z z))
    (subst (dk-cite! 'cc-series-partial-sum-zero (pfl-H pfl-Z z)))
    (crs)))
(qed 'poly-fn-const)
(topic! 'poly-fn-const 'analysis)

;;; z f(z)
(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (IS-POLY-FN-ON kk a (VNB-LAMBDA pfx_ a (* pfx_ (f pfx_)))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(let* ((nc (pfl-poly-open! 'kk 'a 'f)) (n (car nc)) (c (cadr nc))
       (cc1 (list 'CF-CONS 0 c)))
  (pfl-sets! 'kk 'a)
  (fact 'cc-zero-in)
  (fact 'fun-codomain-superset c 'NN 'kk 'CC)
