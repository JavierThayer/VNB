      (rfl))))
(pfl-close-open!)
(qed 'poly-fn-comp)
(topic! 'poly-fn-comp 'analysis)

;;; ----------------------------------------------------------------------
;;; RR and CC are subrings of CC; restriction to a subset
;;; ----------------------------------------------------------------------
(define (pfl-subring! kc add-thm mul-thm in-thm)
  (let* ((iff (dk-cite! 'is-cc-subring kc)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (ass))
                    ((dk-head-is? g 'SUBSET) (let ((x (subset-by-element!))) (if in-thm (fact in-thm x)) (pfl-close-open!)))
                    (#t
                     (let* ((lk (dk-peel!))
                            (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) kc))) lk)))
                            (u (car vs)) (w (cadr vs)))
                       (if (dk-head-is? (cadr (dk-goal)) '+)
                           (pfl-chain! (dk-fact! add-thm (cadr (cadr (dk-goal))) (caddr (cadr (dk-goal)))))
                           (pfl-chain! (dk-fact! mul-thm (cadr (cadr (dk-goal))) (caddr (cadr (dk-goal))))))
                       (pfl-close-open!)))))))))
    (pfl-only-prop! iff rhs)))
(sp (make-wff '(IS-CC-SUBRING RR)))
(fact 'rr-zero-in) (fact 'rr-one-in)
(pfl-subring! 'RR 'rr-add-in-rr 'rr-mul-in-rr 'rr-subset-cc)
(qed 'cc-subring-rr)
(topic! 'cc-subring-rr 'analysis)

(sp (make-wff '(IS-CC-SUBRING CC)))
(fact 'cc-zero-in) (fact 'cc-one-in)
(dk-have! '(SUBSET CC CC) (lambda () (let ((x (subset-by-element!))) (pfl-close-open!))))
(pfl-subring! 'CC 'cc-add-closed 'cc-mul-closed #f)
(qed 'cc-subring-cc)
(topic! 'cc-subring-cc 'analysis)

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (FORALL a (FORALL f (IMPLIES (IS-POLY-FN-ON kk a f)
  (FORALL pfaa_ (IMPLIES (SUBSET pfaa_ a) (IS-POLY-FN-ON kk pfaa_ (VNB-LAMBDA pfx_ pfaa_ (f pfx_))))))))))))
(dk-peel!)
(pfl-sub-parts! 'kk)
(let* ((nc (pfl-poly-open! 'kk 'a 'f)) (n (car nc)) (c (cadr nc)) (g '(VNB-LAMBDA pfx_ pfaa_ (f pfx_))))
  (fact 'subset-trans 'pfaa_ 'a 'kk)
  (pfl-sets! 'kk 'a)
  (fact 'subclass-of-set-is-set 'pfaa_ 'a)
  (dk-have! (list 'IN g '(FUN pfaa_ kk))
    (lambda ()
      (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'subset-mem-fwd 'pfaa_ 'a x) (fact 'fun-apply-type-c 'f 'a 'kk x) (pfl-close-open!))))))
  (pfl-poly-intro! 'kk 'pfaa_ g n c
    (lambda (z)
      (fact 'subset-mem-fwd 'pfaa_ 'a z)
      (fact 'fun-apply-type-c 'f 'a 'kk z)
      (dk-have! (list '= (list g z) (list 'f z)) (lambda () (pfl-beta! rfl)))
      (subst (list '= (list g z) (list 'f z)))
      (dk-apply! (pfl-val 'f 'a c n) z))))
(qed 'poly-fn-restrict)
(topic! 'poly-fn-restrict 'analysis)

