(dk-peel!)
(pfl-sub-parts! 'kk)
(let* ((nc (pfl-poly-open! 'kk 'pfbb_ 'f)) (n (car nc)) (c (cadr nc))
       (inb '(FORALL pfx_ (IMPLIES (IN pfx_ a) (IN (g pfx_) pfbb_))))
       (src (list 'VNB-LAMBDA 'pfx_ 'a (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power '(g pfx_) 'pfj_))) n)))
