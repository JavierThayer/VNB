;;; tb-tvs.scm -- topological-vector-space.pdf Prop 1.4: the topology of a separating family of seminorms
;;; is a vector space topology (Hausdorff; addition and scalar multiplication continuous).
;;; Agent TB-01, 2026-10-26.  DESTINATION: theorem-library/tvs-seminorm-tvs.scm (after tvs-seminorm-top).
;;; Library: analysis.  Helper prefix: tbv-.

(define (tbv-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define tbv-fam '(IS-SEMINORM-FAMILY-ON fld m ix pf))
(define (tbv-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (tbv-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (tbv-sub a b) (list '(VADD m) a (list '(VNEG m) b)))
(define (tbv-p i v) (list (list 'pf i) v))
(define (tbv-oball ff x r) (list 'SN-OBALL 'm 'pf ff x r))
(define (tbv-ball ff x r) (list 'SN-BALL 'm 'pf ff x r))
(define (tbv-fam! c)
  (if (not (dk-asm? c))
      (dk-have! c (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form tbv-fam)) (dk-split-all!) (ass)))))
(define (tbv-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))
(define tbv-snall '(FORALL sni_ (IMPLIES (IN sni_ ix) (IS-SEMINORM fld m (pf sni_)))))
(define (tbv-fam-parts!)
  (tbv-fam! '(IS-NORMED-FIELD fld))
  (tbv-fam! '(IS-MODULE m))
  (tbv-fam! '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING fld)))
  (tbv-fam! '(IN ix SET))
  (tbv-fam! '(IN pf (FUN ix (FUN (VEC m) RR))))
  (tbv-fam! tbv-snall)
  (dk-cite! 'frm-module-vec-set 'm))
(define (tbv-vec! v)
  (let ((ty (list 'IN v '(VEC m))))
    (if (not (dk-asm? ty))
        (cond ((and (pair? v) (equal? (car v) '(VADD m)))
               (tbv-vec! (cadr v)) (tbv-vec! (caddr v))
               (dk-cite! 'module-vadd-type 'm (cadr v) (caddr v)))
              ((and (pair? v) (equal? (car v) '(VNEG m)))
               (tbv-vec! (cadr v))
               (dk-cite! 'module-vneg-type 'm (cadr v)))
              ((and (pair? v) (equal? (car v) '(ACT m)))
               (tbv-vec! (caddr v))
               (dk-cite! 'module-act-type 'm (cadr v) (caddr v)))
              ((equal? v '(VZERO m)) (dk-cite! 'module-vzero-in 'm))
              (#t (error "tbv-vec!: cannot type" (expression->string v)))))
    ty))
;;; i in ix in context: the seminorm p_i, and the value p_i(v) typed
(define (tbv-sn! i)
  (let ((c (list 'IS-SEMINORM 'fld 'm (list 'pf i))))
    (if (not (dk-asm? c)) (inst*! tbv-snall i))
    c))
(define (tbv-pval! i v)
  (let ((ty (list 'IN (tbv-p i v) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (tbv-vec! v)
          (if (not (dk-asm? (list 'IN (list 'pf i) '(FUN (VEC m) RR))))
              (dk-cite! 'fun-apply-type-c 'pf 'ix '(FUN (VEC m) RR) i))
          (dk-cite! 'fun-apply-type-c (list 'pf i) '(VEC m) 'RR v)))
    ty))
;;; p_i(a - c) <= p_i(a - b) + p_i(b - c), landed with the three values typed
(define (tbv-tri! i a b c)
  (tbv-sn! i)
  (tbv-pval! i (tbv-sub a b)) (tbv-pval! i (tbv-sub b c)) (tbv-pval! i (tbv-sub a c))
  (dk-cite! 'frm-sn-subadd 'fld 'm (list 'pf i) (tbv-sub a b) (tbv-sub b c))
  (dk-cite! 'frm-v-sub-chain 'm a b c)
  (dk-rewrite-h! (list '<= (tbv-p i (list '(VADD m) (tbv-sub a b) (tbv-sub b c)))
                       (list '+ (tbv-p i (tbv-sub a b)) (tbv-p i (tbv-sub b c))))
                 (list '(VADD m) (tbv-sub a b) (tbv-sub b c)) (tbv-sub a c)))
;;; p_i(a - b) = p_i(b - a)
(define (tbv-sym! i a b)
  (tbv-sn! i)
  (tbv-pval! i (tbv-sub a b))
  (tbv-pval! i (tbv-sub b a))
  (dk-cite! 'frm-sn-neg 'fld 'm (list 'pf i) (tbv-sub a b))
  (dk-cite! 'frm-v-sub-anti 'm a b)
  (dk-rewrite-h! (list '= (tbv-p i (list '(VNEG m) (tbv-sub a b))) (tbv-p i (tbv-sub a b)))
                 (list '(VNEG m) (tbv-sub a b)) (tbv-sub b a)))
;;; the membership iff of a ball / open ball at W, its right-hand side landed when W is a member
(define (tbv-rhs-of! thm ff x r w ballterm)
  (let* ((i (dk-cite! thm 'm 'pf ff x r w)) (rhs (caddr i)))
    (if (and (dk-asm? (list 'IN w ballterm)) (not (dk-asm? rhs)) (not (dk-asm? (caddr rhs))))
        (begin (dk-have! rhs (lambda () (if (dk-only! i (list 'IN w ballterm)) (prop))))
               (dk-split! rhs)))
    i))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL m (FORALL pf (FORALL ff (FORALL x (FORALL r
  (== (SN-OBALL m pf ff x r)
      (SEP snoy_ (VEC m)
        (FORSOME snoe_ (AND (IN snoe_ RR) (AND (POS-RR snoe_)
          (FORALL sni_ (IMPLIES (IN sni_ ff)
            (<= (+ ((pf sni_) ((VADD m) snoy_ ((VNEG m) x))) snoe_) r)))))))))))))))
(dk-peel!)
(mac 'SN-OBALL)
(qrfl)
(tbv-qed! 'sn-oball-unfold)

(sp (make-wff (tbv-alls '(m pf ff x r y)
  '(IFF (IN y (SN-OBALL m pf ff x r))
        (AND (IN y (VEC m))
             (FORSOME snoe_ (AND (POS-RR snoe_)
               (FORALL sni_ (IMPLIES (IN sni_ ff)
                 (<= (+ ((pf sni_) ((VADD m) y ((VNEG m) x))) snoe_) r))))))))))
(dk-peel!)
(let ((y (cadr (cadr (dk-goal)))))
  (subst (list '== '(SN-OBALL m pf ff x r) (caddr (dk-cite! 'sn-oball-unfold 'm 'pf 'ff 'x 'r))))
  (dk-iff! (lambda (g) (or (dk-head-is? g 'AND)
                           (and (dk-head-is? g 'IMPLIES) (dk-head-is? (caddr (cadr g)) 'SEP))))
    ;; NBGSEP: the SEP's margin carries `snoe_ in RR'; the membership statement keeps the
    ;; old shape (POS-RR implies the guard), so each direction moves the guard across.
    (lambda ()
      (dk-peel!)
      (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) y) (dk-head-is? (caddr f) 'SEP)))
                       "the SEP membership"))
      (dk-split-all!)
      (let ((e (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the margin") #t)))
        (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew e) (dk-conj-close! dk-ass!)))))))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let ((e (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the margin") #t)))
        (dk-cite! 'rr-pos-rr-in-rr e)
        (in-sep! (lambda () (ass)) (lambda () (ew e) (dk-conj-close! dk-ass!)))))))
(tbv-qed! 'sn-oball-membership)

;;; ---------------------------------------------------------------------------
;;; the open basic neighbourhoods are open
(sp (make-wff (tbv-alls '(fld m ix pf ff x r)
  (tbv-imps (list tbv-fam '(IN ff SET) '(IN (CARD ff) NN) '(SUBSET ff ix) '(IN x (VEC m)) '(IN r RR))
    '(IS-SN-OPEN m ix pf (SN-OBALL m pf ff x r))))))
(dk-peel!)
(tbv-fam-parts!)
(let ((ob (tbv-oball 'ff 'x 'r)))
  (mac 'is-sn-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let* ((w (dk-di-var!)) (i (dk-cite! 'sn-oball-membership 'm 'pf 'ff 'x 'r w)))
              (if (dk-only! i (list 'IN w ob)) (prop))))
          (let* ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
            (tbv-rhs-of! 'sn-oball-membership 'ff 'x 'r z ob)
            (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z))) "the margin"))
                   (e (dk-skolem! ex #t))
                   (zall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f z) (dk-contains? f e)))
                                  "the bounds at z"))
                   (h (list '* 1/2 e)))
              (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
              (dk-have! (list 'IN h 'RR) (lambda () (type-term)))
              (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
              (dk-cite! 'rr-pos-rr-of-lt h)
              (ew 'ff)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew h)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (mac 'subset-def)
                                  (let* ((w (dk-di-var!)))
                                    (tbv-rhs-of! 'sn-ball-membership 'ff z h w (tbv-ball 'ff z h))
                                    (let* ((wall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w)))
                                                          "the bounds at w"))
                                           (i2 (dk-cite! 'sn-oball-membership 'm 'pf 'ff 'x 'r w))
                                           (rhs (caddr i2)))
                                      (dk-have! rhs
                                        (lambda ()
                                          (dk-conj-close!
                                            (lambda ()
                                              (if (not (dk-ass!))
                                                  (begin
                                                    (ew h)
                                                    (dk-conj-close!
                                                      (lambda ()
                                                        (if (not (dk-ass!))
                                                            (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN))
                                                                                            (dk-peel!))))))
                                                              (dk-cite! 'subset-mem-fwd 'ff 'ix i)
                                                              (inst*! zall i)
                                                              (inst*! wall i)
                                                              (tbv-tri! i w z 'x)
                                                              (dk-ineq! (list 'IN (tbv-p i (tbv-sub w z)) 'RR)
                                                                        (list 'IN (tbv-p i (tbv-sub z 'x)) 'RR)
                                                                        (list 'IN (tbv-p i (tbv-sub w 'x)) 'RR)
                                                                        (list 'IN e 'RR) '(IN r RR)
                                                                        (list '<= (tbv-p i (tbv-sub w 'x))
                                                                              (list '+ (tbv-p i (tbv-sub w z)) (tbv-p i (tbv-sub z 'x))))
                                                                        (list '<= (tbv-p i (tbv-sub w z)) h)
                                                                        (list '<= (list '+ (tbv-p i (tbv-sub z 'x)) e) 'r))))))))))))
                                      (if (dk-only! i2 rhs) (prop))))))))))))))))))
(tbv-qed! 'sn-oball-open)

;;; the centre is in its open basic neighbourhood
(sp (make-wff (tbv-alls '(fld m ix pf ff x r)
  (tbv-imps (list tbv-fam '(SUBSET ff ix) '(IN x (VEC m)) '(POS-RR r))
    '(IN x (SN-OBALL m pf ff x r))))))
(dk-peel!)
(tbv-fam-parts!)
(let* ((i2 (dk-cite! 'sn-oball-membership 'm 'pf 'ff 'x 'r 'x))
       (rhs (caddr i2)))
  (dk-cite! 'rr-pos-rr-in-rr 'r)
  (dk-cite! 'frm-v-right-inv 'm 'x)
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin
                (ew 'r)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                          (dk-cite! 'subset-mem-fwd 'ff 'ix i)
                          (tbv-sn! i)
                          (dk-cite! 'frm-sn-zero 'fld 'm (list 'pf i))
                          (subst (list '= (tbv-sub 'x 'x) '(VZERO m)))
                          (subst (list '= (tbv-p i '(VZERO m)) 0))
                          (dk-ineq! '(IN r RR))))))))))))
  (if (dk-only! i2 rhs) (prop)))
(tbv-qed! 'sn-oball-center)

;;; an open basic neighbourhood lies in the basic neighbourhood of the same radius
(sp (make-wff (tbv-alls '(fld m ix pf ff x r)
  (tbv-imps (list tbv-fam '(SUBSET ff ix) '(IN x (VEC m)) '(IN r RR))
    '(SUBSET (SN-OBALL m pf ff x r) (SN-BALL m pf ff x r))))))
(dk-peel!)
(tbv-fam-parts!)
(mac 'subset-def)
(let* ((w (dk-di-var!)))
  (tbv-rhs-of! 'sn-oball-membership 'ff 'x 'r w (tbv-oball 'ff 'x 'r))
  (let* ((e (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f w))) "margin") #t))
         (wall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w))) "bounds"))
         (i2 (dk-cite! 'sn-ball-membership 'm 'pf 'ff 'x 'r w))
         (rhs (caddr i2)))
    (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                  (dk-cite! 'subset-mem-fwd 'ff 'ix i)
                  (inst*! wall i)
                  (tbv-pval! i (tbv-sub w 'x))
                  (dk-ineq! (list 'IN (tbv-p i (tbv-sub w 'x)) 'RR) (list 'IN e 'RR) '(IN r RR) (list '< 0 e)
                            (list '<= (list '+ (tbv-p i (tbv-sub w 'x)) e) 'r))))))))
    (if (dk-only! i2 rhs) (prop))))
(tbv-qed! 'sn-oball-in-ball)

;;; ---------------------------------------------------------------------------
;;; reading the topology: its open sets are the IS-SN-OPEN subsets
(define tbv-top '(SEMINORM-TOP m ix pf))
(define tbv-opens '(SEP snu_ (POWER (VEC m)) (IS-SN-OPEN m ix pf snu_)))
(define (tbv-readoffs!)
  (dk-cite! 'sntop-pts 'm 'ix 'pf)
  (dk-cite! 'sntop-opens 'm 'ix 'pf))

;;; an open basic neighbourhood is in OPENS(SEMINORM-TOP)
(sp (make-wff (tbv-alls '(fld m ix pf ff x r)
  (tbv-imps (list tbv-fam '(IN ff SET) '(IN (CARD ff) NN) '(SUBSET ff ix) '(IN x (VEC m)) '(IN r RR))
    '(IN (SN-OBALL m pf ff x r) (OPENS (SEMINORM-TOP m ix pf)))))))
(dk-peel!)
(tbv-fam-parts!)
(tbv-readoffs!)
(let ((ob (tbv-oball 'ff 'x 'r)))
  (dk-cite! 'sn-oball-open 'fld 'm 'ix 'pf 'ff 'x 'r)
  (subst (list '== (list 'OPENS tbv-top) tbv-opens))
  (dk-have! (list 'SUBSET ob '(VEC m))
    (lambda ()
      (mac 'subset-def)
      (let* ((w (dk-di-var!)) (i (dk-cite! 'sn-oball-membership 'm 'pf 'ff 'x 'r w)))
        (if (dk-only! i (list 'IN w ob)) (prop)))))
  (dk-cite! 'subclass-of-set-is-set ob '(VEC m))
  (let ((s (caddr (dk-cite! 'subset-def ob '(VEC m)))))
    (dk-have! s (lambda () (mac-h 'subset-def (list 'SUBSET ob '(VEC m))) (ass))))
  (dk-cite! 'power-mem-intro '(VEC m) ob)
  (in-sep! (lambda () (ass)) (lambda () (ass))))
(tbv-qed! 'sntop-oball-open)

;;; an open set of SEMINORM-TOP contains a basic neighbourhood of each of its points
(sp (make-wff (tbv-alls '(fld m ix pf u x)
  (tbv-imps (list tbv-fam '(IN u (OPENS (SEMINORM-TOP m ix pf))) '(IN x u))
    '(FORSOME snf_ (AND (IN snf_ SET) (AND (IN (CARD snf_) NN) (AND (SUBSET snf_ ix)
       (FORSOME sne_ (AND (POS-RR sne_) (SUBSET (SN-BALL m pf snf_ x sne_) u)))))))))))
(dk-peel!)
(tbv-fam-parts!)
(tbv-readoffs!)
(dk-rewrite-h! (list 'IN 'u (list 'OPENS tbv-top)) (list 'OPENS tbv-top) tbv-opens)
(dk-have! '(IS-SN-OPEN m ix pf u) (lambda () (sep-me (dk-ctx-form (list 'IN 'u tbv-opens))) (dk-split-all!) (ass)))
(let* ((iff (dk-cite! 'is-sn-open 'm 'ix 'pf 'u)) (rhs (caddr iff)))
  (dk-have! (caddr rhs) (lambda () (mac-h 'IS-SN-OPEN '(IS-SN-OPEN m ix pf u)) (dk-split-all!) (ass)))
  (inst*! (caddr rhs) 'x)
  (dk-ass!))
(tbv-qed! 'sntop-open-basic)

;;; ---------------------------------------------------------------------------
;;; the one-index family {i}: a finite subset of ix
(define (tbv-single! i)
  (let ((pp (list 'PAIR i i)))
    (dk-cite! 'membership-implies-sethood i 'ix)
    (tbv-and! (list 'IN i 'SET) (list 'IN i 'SET))
    (dk-cite! 'pairing i i)
    (dk-cite! 'card-singleton i)
    (fact 'nn-zero-in)
    (dk-cite! 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pp) 'NN) (lambda () (subst (list '= (list 'CARD pp) '(succ 0))) (ass)))
    (dk-have! (list 'SUBSET pp 'ix)
      (lambda ()
        (mac 'subset-def)
        (let ((w (dk-di-var!)))
          (dk-cite! 'pair-self-eq i w)
          (subst (list '= w i))
          (ass))))
    (dk-cite! 'pair-self-member i)
    pp))
(define (tbv-qe-of-eq! a b)
  (dk-have! (list '== a b) (lambda () (subst (list '= a b)) (qrfl))))

;;; Prop 1.4, first half: the topology is Hausdorff
(sp (make-wff (tbv-alls '(fld m ix pf) (tbv-imps (list tbv-fam) '(IS-HAUSDORFF (SEMINORM-TOP m ix pf))))))
(dk-peel!)
(tbv-fam-parts!)
(tbv-readoffs!)
(dk-cite! 'sntop-is-top-space 'fld 'm 'ix 'pf)
(mac 'is-hausdorff)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (subst (list '== (list 'PTS tbv-top) '(VEC m)))
          (let* ((ld (dk-peel!))
                 (ne (car (filter (lambda (f) (dk-head-is? f 'NOT)) ld)))
                 (a (cadr (cadr ne))) (b (caddr (cadr ne)))
                 (ab (tbv-sub a b))
                 (sepc (tbv-fam! '(FORALL snx_ (IMPLIES (IN snx_ (VEC m))
                                    (IMPLIES (FORALL sni_ (IMPLIES (IN sni_ ix) (= ((pf sni_) snx_) 0)))
                                             (= snx_ (VZERO m)))))))
                 (allz (list 'FORALL 'sni_ (list 'IMPLIES '(IN sni_ ix) (list '= (list '(pf sni_) ab) 0)))))
            (tbv-vec! ab)
            (use-em allz
              (lambda ()
                (inst*! '(FORALL snx_ (IMPLIES (IN snx_ (VEC m))
                           (IMPLIES (FORALL sni_ (IMPLIES (IN sni_ ix) (= ((pf sni_) snx_) 0)))
                                    (= snx_ (VZERO m))))) ab)
                (dk-cite! 'frm-v-sub-zero-eq 'm a b)
                (tbv-qe-of-eq! a b)
                (ai ne))
              (lambda ()
                (let* ((pushed (dk-landed-1 (lambda () (push-not-h (list 'NOT allz)))))
                       (i (dk-skolem! pushed #t))
                       (d (tbv-p i ab))
                       (r (list '* 1/2 d)))
                  (tbv-pval! i ab)
                  (tbv-sn! i)
                  (dk-cite! 'frm-sn-nonneg 'fld 'm (list 'pf i) ab)
                  (dk-have! (list '< 0 d)
                    (lambda ()
                      (dk-have! (list 'NOT (list '= 0 d))
                        (lambda () (di) (dk-have! (list '= d 0) (lambda () (subst (list '= 0 d)) (rfl)))
                                   (ai (list 'NOT (list '= d 0)))))
                      (tbv-and! (list '<= 0 d) (list 'NOT (list '= 0 d)))
                      (fact 'rr-zero-in)
                      (dk-cite! 'rr-le-ne-lt 0 d)
                      (dk-ass!)))
                  (dk-have! (list 'IN r 'RR) (lambda () (type-term)))
                  (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
                  (dk-cite! 'rr-pos-rr-of-lt r)
                  (let* ((pp (tbv-single! i))
                         (u (tbv-oball pp a r)) (v (tbv-oball pp b r)) (ii (list 'INTERSECTION u v)))
                    (dk-cite! 'sntop-oball-open 'fld 'm 'ix 'pf pp a r)
                    (dk-cite! 'sntop-oball-open 'fld 'm 'ix 'pf pp b r)
                    (dk-cite! 'sn-oball-center 'fld 'm 'ix 'pf pp a r)
                    (dk-cite! 'sn-oball-center 'fld 'm 'ix 'pf pp b r)
                    (dk-have! (list '= ii 'EMPTY-SET)
                      (lambda ()
                        (dk-have! (list 'FORALL 'hx_ (list 'IFF (list 'IN 'hx_ ii) '(IN hx_ EMPTY-SET)))
                          (lambda ()
                            (let ((w (begin (di) (cadr (cadr (dk-goal))))))
                              (dk-iff! (lambda (g) (or (equal? g (list 'IN w 'EMPTY-SET))
                                                       (and (dk-head-is? g 'IMPLIES) (equal? (caddr g) (list 'IN w 'EMPTY-SET)))))
                                (lambda ()
                                  (dk-peel!)
                                  (let ((im (dk-cite! 'intersection-membership u v w)))
                                    (dk-have! (list 'IN w u) (lambda () (if (dk-only! im (list 'IN w ii)) (prop))))
                                    (dk-have! (list 'IN w v) (lambda () (if (dk-only! im (list 'IN w ii)) (prop)))))
                                  (tbv-rhs-of! 'sn-oball-membership pp a r w u)
                                  (let* ((e1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a))) "m1") #t))
                                         (b1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e1))) "b1")))
                                    (tbv-rhs-of! 'sn-oball-membership pp b r w v)
                                    (let* ((e2 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f b))) "m2") #t))
                                           (b2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e2))) "b2")))
                                      (inst*! b1 i) (inst*! b2 i)
                                      (dk-cite! 'rr-pos-rr-in-rr e1) (dk-cite! 'rr-lt-of-pos-rr e1)
                                      (dk-cite! 'rr-pos-rr-in-rr e2) (dk-cite! 'rr-lt-of-pos-rr e2)
                                      (tbv-tri! i a w b)
                                      (pbc)
                                      (dk-absurd! (list '<= d (list '+ (tbv-p i (tbv-sub a w)) (tbv-p i (tbv-sub w b))))
                                                  (tbv-sym! i a w)
                                                  (list '<= (list '+ (tbv-p i (tbv-sub w a)) e1) r)
                                                  (list '<= (list '+ (tbv-p i (tbv-sub w b)) e2) r)
                                                  (list '< 0 e1) (list '< 0 e2)
                                                  (list 'IN d 'RR) (list 'IN e1 'RR) (list 'IN e2 'RR)
                                                  (list 'IN (tbv-p i (tbv-sub a w)) 'RR)
                                                  (list 'IN (tbv-p i (tbv-sub w a)) 'RR)
                                                  (list 'IN (tbv-p i (tbv-sub w b)) 'RR)))))
                                (lambda ()
                                  (dk-peel!)
                                  (dk-cite! 'empty-set-has-no-members w)
                                  (ai (list 'NOT (list 'IN w 'EMPTY-SET))))))))
                        (dk-cite! 'class-extensionality ii 'EMPTY-SET)
                        (dk-ass!)))
                    (subst (list '== (list 'OPENS tbv-top) tbv-opens))
                    (dk-rewrite-h! (list 'IN u (list 'OPENS tbv-top)) (list 'OPENS tbv-top) tbv-opens)
                    (dk-rewrite-h! (list 'IN v (list 'OPENS tbv-top)) (list 'OPENS tbv-top) tbv-opens)
                    (ew u) (ew v)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin (subst (list '= ii 'EMPTY-SET)) (qrfl))))))))))))))
(tbv-qed! 'sntop-hausdorff)

;;; ---------------------------------------------------------------------------
;;; Prop 1.4: addition is continuous (the notes: x' in x + V_{eps/2}, y' in y + V_{eps/2})
(define tbv-op '(OPENS (SEMINORM-TOP m ix pf)))
;;; from (IN u OPENS) and (IN z u): skolemise the basic neighbourhood; return (ff . eps)
(define (tbv-basic-at! u z)
  (let* ((ex (dk-cite! 'sntop-open-basic 'fld 'm 'ix 'pf u z))
         (ff (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff) (dk-contains? f z))) "radius"))
         (e (dk-skolem! ex2 #t)))
    (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
    (cons ff e)))
;;; land (IN a (VEC m)), the margin e of a in the open ball, and its bound at i; return e
(define (tbv-margin! ff c r a i)
  (tbv-rhs-of! 'sn-oball-membership ff c r a (tbv-oball ff c r))
  (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a) (dk-contains? f c))) "the margin"))
         (e (dk-skolem! ex #t))
         (bd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) "the bound")))
    (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
    (inst*! bd i)
    e))

(define tbv-add-stmt
  (tbv-alls '(fld m ix pf)
    (tbv-imps (list tbv-fam)
      (forall-guarded '(tvx_ tvy_ tvu_)
        (list '(IN tvx_ (VEC m)) '(IN tvy_ (VEC m)) (list 'IN 'tvu_ tbv-op) '(IN ((VADD m) tvx_ tvy_) tvu_))
        (list 'FORSOME 'tvv_
          (list 'AND (list 'IN 'tvv_ tbv-op)
            (list 'AND '(IN tvx_ tvv_)
              (list 'FORSOME 'tvw_
                (list 'AND (list 'IN 'tvw_ tbv-op)
                  (list 'AND '(IN tvy_ tvw_)
                    '(FORALL tva_ (IMPLIES (IN tva_ tvv_)
                       (FORALL tvb_ (IMPLIES (IN tvb_ tvw_) (IN ((VADD m) tva_ tvb_) tvu_)))))))))))))))
(sp (make-wff tbv-add-stmt))
(dk-peel!)
(tbv-fam-parts!)
(let* ((ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m)) (symbol? (cadr f)))) (dk-asms)))
       (uh (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) tbv-op))) "the open set"))
       (u (cadr uh))
       (sh (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) u) (pair? (cadr f)))) "the sum in u"))
       (x (cadr (cadr sh))) (y (caddr (cadr sh)))
       (xy (cadr sh))
       (pr (tbv-basic-at! u xy)) (ff (car pr)) (eps (cdr pr))
       (h (list '* 1/2 eps))
       (vv (tbv-oball ff x h)) (ww (tbv-oball ff y h)))
  (dk-have! (list 'IN h 'RR) (lambda () (type-term)))
  (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR))))
  (dk-cite! 'rr-pos-rr-of-lt h)
  (dk-cite! 'sntop-oball-open 'fld 'm 'ix 'pf ff x h)
  (dk-cite! 'sntop-oball-open 'fld 'm 'ix 'pf ff y h)
  (dk-cite! 'sn-oball-center 'fld 'm 'ix 'pf ff x h)
  (dk-cite! 'sn-oball-center 'fld 'm 'ix 'pf ff y h)
  (ew vv)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew ww)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((ld (dk-peel!))
                           (a (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) vv))) ld))))
                           (b (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ww))) ld))))
                           (ab (list '(VADD m) a b))
                           (ra (tbv-rhs-of! 'sn-oball-membership ff x h a vv))
                           (rb (tbv-rhs-of! 'sn-oball-membership ff y h b ww))
                           (tab (tbv-vec! ab))
                           (bl (tbv-ball ff xy eps))
                           (i2 (dk-cite! 'sn-ball-membership 'm 'pf ff xy eps ab))
                           (rhs (caddr i2)))
                      (dk-have! rhs
                        (lambda ()
                          (dk-conj-close!
                            (lambda ()
                              (cond ((dk-ass!) #t)
                                    ((dk-head-is? (dk-goal) 'IN) (tbv-vec! ab) (dk-ass!))
                                    (#t
                                     (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                       (dk-cite! 'subset-mem-fwd ff 'ix i)
                                       (let* ((e1 (tbv-margin! ff x h a i))
                                              (e2 (tbv-margin! ff y h b i))
                                              (s1 (tbv-sub a x)) (s2 (tbv-sub b y))
                                              (sab (tbv-sub ab xy)))
                                         (tbv-sn! i)
                                         (tbv-pval! i s1) (tbv-pval! i s2) (tbv-pval! i sab)
                                         (dk-cite! 'frm-sn-subadd 'fld 'm (list 'pf i) s1 s2)
                                         (dk-cite! 'frm-v-sub-add 'm a b x y)
                                         (dk-rewrite-h! (list '<= (tbv-p i (list '(VADD m) s1 s2))
                                                              (list '+ (tbv-p i s1) (tbv-p i s2)))
                                                        (list '(VADD m) s1 s2) sab)
                                         (dk-ineq! (list 'IN (tbv-p i s1) 'RR) (list 'IN (tbv-p i s2) 'RR)
                                                   (list 'IN (tbv-p i sab) 'RR) (list 'IN eps 'RR)
                                                   (list 'IN e1 'RR) (list 'IN e2 'RR) (list '< 0 e1) (list '< 0 e2)
                                                   (list '<= (tbv-p i sab) (list '+ (tbv-p i s1) (tbv-p i s2)))
                                                   (list '<= (list '+ (tbv-p i s1) e1) h)
                                                   (list '<= (list '+ (tbv-p i s2) e2) h))))))))))
                      (dk-have! (list 'IN ab bl) (lambda () (if (dk-only! i2 rhs) (prop))))
                      (dk-cite! 'subset-mem-fwd bl u ab)
                      (dk-ass!))))))))))
(tbv-qed! 'sntop-add-continuous)

;;; ---------------------------------------------------------------------------
;;; finitely many seminorms are bounded at a point (finite-set-induction; the bound grows by
;;; p_new(x) at each step, so no comparison of reals is needed)
(define (tbv-bound-prop s)
  (list 'IMPLIES (list 'SUBSET s 'ix)
    (list 'FORSOME 'bm_ (list 'AND '(IN bm_ RR) (list 'AND '(<= 0 bm_)
      (list 'FORALL 'sni_ (list 'IMPLIES (list 'IN 'sni_ s) '(<= ((pf sni_) x) bm_))))))))
(define tbv-bcls (list 'COMP 'fbs_ (tbv-bound-prop 'fbs_)))
(define tbv-bstep
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ tbv-bcls)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) tbv-bcls))))))

(sp (make-wff (tbv-alls '(fld m ix pf x)
  (tbv-imps (list tbv-fam '(IN x (VEC m)))
    (list 'FORALL 'ff (tbv-imps '((IN ff SET) (IN (CARD ff) NN)) (tbv-bound-prop 'ff)))))))
(dk-peel!)
(tbv-fam-parts!)
;; base
(dk-have! (list 'IN 'EMPTY-SET tbv-bcls)
  (lambda ()
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (if (equal? (dk-goal) '(IN EMPTY-SET SET))
            (begin (fact 'empty-set-is-set) (ass))
            (begin
              (dk-peel!)
              (fact 'rr-zero-in)
              (ew 0)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-ass!) #t)
                        ((dk-head-is? (dk-goal) '<=) (dk-ineq!))
                        (#t (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                              (fact 'empty-set-has-no-members i)
                              (ai (list 'NOT (list 'IN i 'EMPTY-SET)))))))))))
      (dk-opened (lambda () (comp-mi))))))
;; step
(dk-have! tbv-bstep
  (lambda ()
    (let* ((landed (dk-peel!))
           (uu (cadr (dk-goal)))
           (sv (cadr uu))
           (xv (cadr (caddr uu))))
      (dk-split-all! landed)
      (tbv-and! (list 'IN xv 'SET) (list 'IN xv 'SET))
      (fact 'pairing xv xv)
      (tbv-and! (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET))
      (fact 'union-set-closure sv (list 'PAIR xv xv))
      (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv tbv-bcls)))))
             (ih (car (filter (lambda (f) (dk-head-is? f 'IMPLIES)) ls))))
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) (list 'IN uu 'SET))
                (ass)
                (begin
                  (dk-peel!)
                  ;; s subset ix and the new index in ix
                  (dk-have! (list 'SUBSET sv 'ix)
                    (lambda ()
                      (mac 'subset-def)
                      (let ((w (dk-di-var!)))
                        (dk-cite! 'union-membership sv (list 'PAIR xv xv) w)
                        (dk-cite! 'subset-mem-fwd uu 'ix w)
                        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                  (dk-cite! 'pair-self-member xv)
                  (dk-cite! 'union-membership sv (list 'PAIR xv xv) xv)
                  (dk-have! (list 'IN xv uu)
                    (lambda () (if (dk-only! (list 'IN xv (list 'PAIR xv xv))
                                             (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (equal? (cadr f) (list 'IN xv uu))))
                                                      "union iff"))
                                   (prop))))
                  (dk-cite! 'subset-mem-fwd uu 'ix xv)
                  (detach! ih)
                  (let* ((mv (dk-skolem! (caddr ih) #t))
                         (ball (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mv))) "the old bound"))
                         (px (tbv-p xv 'x))
                         (m2 (list '+ mv px)))
                    (tbv-pval! xv 'x)
                    (tbv-sn! xv)
                    (dk-cite! 'frm-sn-nonneg 'fld 'm (list 'pf xv) 'x)
                    (dk-have! (list 'IN m2 'RR) (lambda () (type-term)))
                    (ew m2)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((dk-head-is? (dk-goal) '<=)
                               (dk-ineq! (list '<= 0 mv) (list '<= 0 px) (list 'IN mv 'RR) (list 'IN px 'RR)))
                              (#t
                               (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                 (dk-cite! 'union-membership sv (list 'PAIR xv xv) i)
                                 (dk-cite! 'subset-mem-fwd uu 'ix i)
                                 (tbv-pval! i 'x)
                                 (use-em (list 'IN i sv)
                                   (lambda ()
                                     (inst*! ball i)
                                     (dk-ineq! (list '<= (tbv-p i 'x) mv) (list '<= 0 px)
                                               (list 'IN mv 'RR) (list 'IN px 'RR) (list 'IN (tbv-p i 'x) 'RR)))
                                   (lambda ()
                                     (dk-have! (list 'IN i (list 'PAIR xv xv))
                                       (lambda () (if (dk-only! (list 'IN i uu) (list 'NOT (list 'IN i sv))
                                                                (dk-pick (lambda (f) (and (dk-head-is? f 'IFF)
                                                                                          (equal? (cadr f) (list 'IN i uu))))
                                                                         "union iff i"))
                                                      (prop))))
                                     (dk-cite! 'pair-self-eq xv i)
                                     (subst (list '= i xv))
                                     (dk-ineq! (list '<= 0 mv) (list 'IN mv 'RR) (list 'IN px 'RR)))))))))))))
          (dk-opened (lambda () (comp-mi))))))))
(tbv-and! (list 'IN 'EMPTY-SET tbv-bcls) tbv-bstep)
(let* ((ind (dk-fact! 'finite-set-induction tbv-bcls)))
  (let* ((fv (cadr (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'CARD))) "the finite set")))))
    (tbv-and! (list 'IN fv 'SET) (list 'IN (list 'CARD fv) 'NN))
    (let* ((inc (dk-apply! ind fv))
           (pc (car (filter (lambda (f) (dk-head-is? f 'IMPLIES)) (dk-landed (lambda () (comp-me inc)))))))
      (detach! pc)
      (dk-ass!))))
(tbv-qed! 'sn-finite-bound)

;;; ---------------------------------------------------------------------------
;;; Prop 1.4: scalar multiplication is continuous, by (6):
;;;   p(s a - r x) <= |s| p(a - x) + |s - r| p(x)
(define tbv-nfv '(NORMED-FIELD-AS-COMMUTATIVE-RING fld))
;;; (IN v (CARR fld)) from (IN v (CARR (SCAL m)))
(define (tbv-in-fld! v)
  (let ((ty (list 'IN v '(CARR fld))))
    (if (not (dk-asm? ty))
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN v '(CARR (SCAL m))) '(SCAL m) tbv-nfv)
                       (list 'CARR tbv-nfv) '(CARR fld)))
    ty))
(define tbv-scal-stmt
  (tbv-alls '(fld m ix pf)
    (tbv-imps (list tbv-fam)
      (forall-guarded '(tvr_ tvx_ tvu_)
        (list '(IN tvr_ (CARR (SCAL m))) '(IN tvx_ (VEC m)) (list 'IN 'tvu_ tbv-op) '(IN ((ACT m) tvr_ tvx_) tvu_))
        (list 'FORSOME 'tvd_
          (list 'AND '(POS-RR tvd_)
            (list 'FORSOME 'tvw_
              (list 'AND (list 'IN 'tvw_ tbv-op)
                (list 'AND '(IN tvx_ tvw_)
                  '(FORALL tvs_ (IMPLIES (IN tvs_ (CARR (SCAL m)))
                     (IMPLIES (< ((FNRM fld) ((ADD (SCAL m)) tvs_ ((NEG (SCAL m)) tvr_))) tvd_)
                       (FORALL tva_ (IMPLIES (IN tva_ tvw_) (IN ((ACT m) tvs_ tva_) tvu_)))))))))))))))

(sp (make-wff tbv-scal-stmt))
(dk-peel!)
(tbv-fam-parts!)
(dk-cite! 'normed-field-ring-view-carr 'fld)
(dk-cite! 'normed-field-ring-view-add 'fld)
(dk-cite! 'normed-field-ring-view-neg 'fld)
(dk-cite! 'module-scalar-ring 'm)
(let* ((rh (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL m))))) "the scalar"))
       (r (cadr rh))
       (uh (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) tbv-op))) "the open set"))
       (u (cadr uh))
       (sh (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) u) (pair? (cadr f)))) "the product in u"))
       (rx (cadr sh))
       (x (caddr rx))
       (pr (tbv-basic-at! u rx)) (ff (car pr)) (eps (cdr pr))
       (fbd (dk-cite! 'sn-finite-bound 'fld 'm 'ix 'pf x))
       (fbi (dk-apply! fbd ff))
       (mv (dk-skolem! (if (dk-head-is? fbi 'IMPLIES) (dk-apply! fbi) fbi) #t))
       (mall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mv))) "the bound M"))
       (nr (list '(FNRM fld) r))
       (cc (list '+ nr 1))
       (h (list '* 1/2 eps)))
  (tbv-in-fld! r)
  (dk-cite! 'nf-norm-in-rr 'fld r)
  (dk-cite! 'nf-norm-nonneg 'fld r)
  (dk-have! (list 'IN cc 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 cc) (lambda () (dk-ineq! (list '<= 0 nr) (list 'IN nr 'RR))))
  (dk-have! (list 'IN h 'RR) (lambda () (type-term)))
  (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR))))
  (dk-cite! 'rr-pos-rr-of-lt h)
  (let* ((d1 (dk-skolem! (dk-cite! 'rr-scale-eps cc h) #t))
         (s1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "scale 1"))
         (d2 (dk-skolem! (dk-cite! 'rr-scale-eps mv h) #t))
         (s2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d2))) "scale 2"))
         (dl (list 'min 1 d2))
         (ww (tbv-oball ff x d1)))
    (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1)
    (dk-cite! 'rr-pos-rr-in-rr d2) (dk-cite! 'rr-lt-of-pos-rr d2)
    (fact 'rr-one-in) (fact 'rr-zero-in)
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-min-closed 1 d2)
    (dk-cite! 'rr-min-le-left 1 d2)
    (dk-cite! 'rr-min-le-right 1 d2)
    (dk-cite! 'rr-lt-min 0 1 d2)
    (dk-cite! 'rr-pos-rr-of-lt dl)
    (dk-cite! 'sntop-oball-open 'fld 'm 'ix 'pf ff x d1)
    (dk-cite! 'sn-oball-center 'fld 'm 'ix 'pf ff x d1)
    (ew dl)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (ew ww)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld (dk-peel!))
                             (s (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL m))))) ld))))
                             (a (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ww))) ld))))
                             (srm (list '(ADD (SCAL m)) s (list '(NEG (SCAL m)) r)))
                             (bb (list '(FNRM fld) srm))
                             (bf (list '(FNRM fld) (list '(ADD fld) s (list '(NEG fld) r))))
                             (ns (list '(FNRM fld) s))
                             (sa (list '(ACT m) s a))
                             (ra (tbv-rhs-of! 'sn-oball-membership ff x d1 a ww))
                             (tsa (tbv-vec! sa))
                             (bl (tbv-ball ff rx eps))
                             (i2 (dk-cite! 'sn-ball-membership 'm 'pf ff rx eps sa))
                             (rhs (caddr i2)))
                        ;; the scalar facts, once for all i
                        (tbv-in-fld! s)
                        (dk-cite! 'ring-neg-in-carr '(SCAL m) r)
                        (tbv-and! '(IS-RING (SCAL m)) (list 'IN s '(CARR (SCAL m))) (list 'IN (list '(NEG (SCAL m)) r) '(CARR (SCAL m))))
                        (dk-cite! 'ring-carrier-closed-add '(SCAL m) s (list '(NEG (SCAL m)) r))
                        (dk-cite! 'nf-norm-in-rr 'fld s)
                        (dk-cite! 'nf-norm-nonneg 'fld s)
                        (let* ((t1 (dk-rewrite-h! (list 'IN srm '(CARR (SCAL m))) '(SCAL m) tbv-nfv))
                               (t2 (dk-rewrite-h! t1 (list 'CARR tbv-nfv) '(CARR fld)))
                               (t3 (dk-rewrite-h! t2 (list 'ADD tbv-nfv) '(ADD fld)))
                               (t4 (dk-rewrite-h! t3 (list 'NEG tbv-nfv) '(NEG fld))))
                          (dk-cite! 'nf-norm-in-rr 'fld (cadr t4))
                          (dk-cite! 'nf-norm-nonneg 'fld (cadr t4)))
                        (dk-have! (list '= bb bf)
                          (lambda () (subst (list '= '(SCAL m) tbv-nfv))
                                     (subst (list '== (list 'ADD tbv-nfv) '(ADD fld)))
                                     (subst (list '== (list 'NEG tbv-nfv) '(NEG fld)))
                                     (rfl)))
                        (dk-rewrite-h! (list 'IN bf 'RR) bf bb)
                        (dk-rewrite-h! (list '<= 0 bf) bf bb)
                        (dk-cite! 'nf-norm-le-add 'fld s r)
                        (dk-have! (list '<= ns cc)
                          (lambda () (dk-ineq! (list '<= ns (list '+ bf nr)) (list '= bb bf) (list '< bb dl)
                                               (list '<= dl 1) (list 'IN bb 'RR) (list 'IN bf 'RR) (list 'IN ns 'RR)
                                               (list 'IN nr 'RR) (list 'IN dl 'RR))))
                        (dk-have! (list '<= bb d2)
                          (lambda () (dk-ineq! (list '< bb dl) (list '<= dl d2) (list 'IN bb 'RR) (list 'IN dl 'RR) (list 'IN d2 'RR))))
                        (dk-have! rhs
                          (lambda ()
                            (dk-conj-close!
                              (lambda ()
                                (if (not (dk-ass!))
                                    (let* ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                                           (p (list 'pf i))
                                           (ax (tbv-sub a x))
                                           (uu (list '(ACT m) s ax))
                                           (vv (list '(ACT m) srm x))
                                           (dd (tbv-sub sa rx)))
                                      (dk-cite! 'subset-mem-fwd ff 'ix i)
                                      (let* ((e1 (tbv-margin! ff x d1 a i))
                                             (pax (tbv-p i ax)) (px (tbv-p i x)))
                                        (tbv-sn! i)
                                        (tbv-pval! i ax) (tbv-pval! i x) (tbv-pval! i uu) (tbv-pval! i vv) (tbv-pval! i dd)
                                        (inst*! mall i)
                                        (dk-cite! 'frm-sn-nonneg 'fld 'm p ax)
                                        (dk-cite! 'frm-sn-nonneg 'fld 'm p x)
                                        (dk-cite! 'frm-sn-subadd 'fld 'm p uu vv)
                                        (dk-cite! 'frm-act-diff 'm s r a x)
                                        (let* ((sub (dk-rewrite-h! (list '<= (tbv-p i (list '(VADD m) uu vv)) (list '+ (tbv-p i uu) (tbv-p i vv)))
                                                                   (list '(VADD m) uu vv) dd))
                                               (h1 (dk-cite! 'frm-sn-homog 'fld 'm p s ax))
                                               (h2 (dk-cite! 'frm-sn-homog 'fld 'm p srm x)))
                                          (dk-have! (list '<= pax d1)
                                            (lambda () (dk-ineq! (list '<= (list '+ pax e1) d1) (list '< 0 e1)
                                                                 (list 'IN pax 'RR) (list 'IN e1 'RR) (list 'IN d1 'RR))))
                                          (dk-cite! 'rr-mul-le-right ns cc pax)
                                          (inst*! s1 pax)
                                          (tbv-and! (list 'IN bb 'RR) (list 'IN px 'RR))
                                          (dk-cite! 'rr-mul-comm bb px)
                                          (dk-cite! 'rr-mul-le-right px mv bb)
                                          (inst*! s2 bb)
                                          (for-each dk-real! (list (list '* ns pax) (list '* cc pax) (list '* bb px)
                                                                   (list '* px bb) (list '* mv bb)))
                                          (let* ((n1 (dk-name! (list '* ns pax)))
                                                 (n2 (dk-name! (list '* cc pax)))
                                                 (n3 (dk-name! (list '* bb px)))
                                                 (n4 (dk-name! (list '* px bb)))
                                                 (n5 (dk-name! (list '* mv bb)))
                                                 (rw (lambda (f)
                                                       (fold-left (lambda (f pr) (if (dk-contains? f (car pr))
                                                                                     (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                  f (list (cons (list '* ns pax) n1) (cons (list '* cc pax) n2)
                                                                          (cons (list '* bb px) n3) (cons (list '* px bb) n4)
                                                                          (cons (list '* mv bb) n5))))))
                                            (apply dk-ineq!
                                                   (append (list sub (list 'IN (tbv-p i dd) 'RR) (list 'IN (tbv-p i uu) 'RR)
                                                                 (list 'IN (tbv-p i vv) 'RR) (list 'IN eps 'RR))
                                                           (map (lambda (f) (rw f))
                                                                (list h1 h2
                                                                      (list '<= (list '* ns pax) (list '* cc pax))
                                                                      (list '<= (list '* cc pax) h)
                                                                      (list '= (list '* bb px) (list '* px bb))
                                                                      (list '<= (list '* px bb) (list '* mv bb))
                                                                      (list '<= (list '* mv bb) h)))
                                                           (list (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN n3 'RR)
                                                                 (list 'IN n4 'RR) (list 'IN n5 'RR)))))))))))))
                        (dk-have! (list 'IN sa bl) (lambda () (if (dk-only! i2 rhs) (prop))))
                        (dk-cite! 'subset-mem-fwd bl u sa)
                        (dk-ass!)))))))))))
(tbv-qed! 'sntop-scal-continuous)

