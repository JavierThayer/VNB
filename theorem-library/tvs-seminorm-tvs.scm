;;; PROP 1.4: the topology defined by a separating family of seminorms is a vector space topology
(sp (make-wff (tbv-alls '(fld m ix pf) (tbv-imps (list tbv-fam) '(IS-TVS fld m (SEMINORM-TOP m ix pf))))))
(dk-peel!)
(tbv-fam-parts!)
(dk-cite! 'sntop-hausdorff 'fld 'm 'ix 'pf)
(dk-cite! 'sntop-pts 'm 'ix 'pf)
(dk-cite! 'sntop-add-continuous 'fld 'm 'ix 'pf)
(dk-cite! 'sntop-scal-continuous 'fld 'm 'ix 'pf)
(mac 'is-tvs)
(dk-conj-close! dk-ass!)
(tbv-qed! 'seminorm-top-is-tvs)
