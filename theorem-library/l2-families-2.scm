;;; b3-l2.scm -- TOWARDS l2(I) AS A COMPLEX HILBERT SPACE: the real nonnegative ESUM order laws,
;;; the closure of L2-FAMILIES under the pointwise operations, and the inner product of l2(I) as
;;; an unordered sum.  Agent BA-ONB3, 2026-11-09.  Prefix b3l-.  Nothing asserted.
;;; DESTINATION: theorem-library/l2-families-2.scm.  Library: analysis.
;;; LOAD WINDOW [sums-to-algebra + 1, end) and after complete-transfer: cites
;;; rps-finsum-eq-cc-finsum, esum-sums-to-cc (sums-to-algebra), cc-nag-complete (complete-transfer),
;;; cc-family-sum-value (l2-families), absolute-summable-implies-summable (rake-asm-b2), the ESUM
;;; laws (rake-esum-defined), the RR-POS-STAR finite-sum laws.
(define (b3l-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; b3l: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))
        (error "b3l: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (b3l-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (b3l-close!) (cond ((not (b3l-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (b3l-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))))
(define (b3l-and3! a b c) (dk-have! (list 'AND a (list 'AND b c)) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))))
(define b3l-RM 'RR-POS-STAR-ADD-MONOID)
(define (b3l-P f w) (list 'FINSUM b3l-RM f w))
(define (b3l-fin s D) (list 'AND (list 'IN s 'SET) (list 'AND (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s D))))

;;; A REAL NONNEGATIVE FAMILY. f in FUN(dd, RR) and forall z in dd. 0 <= f z in context: lands
;;; DOM f = dd, f in FUN(DOM f, RR), the nonnegativity over DOM f, f in FUN(DOM f, RR-POS-STAR)
;;; and f in FUN(dd, RR-POS-STAR).  Returns the procedure typing f z in RR-POS-STAR for z in dd.
(define (b3l-nn-hyp f dd)
  (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (equal? (caddr (caddr a)) (list '<= 0 (list f (cadr a))))
                            (equal? (caddr (cadr (caddr a))) dd)))
           "the nonnegativity"))
(define (b3l-rps-pt! f dd z)          ; z in dd in context
  (let ((fz (list f z)))
    (if (not (dk-asm? (list 'IN fz 'RR-POS-STAR)))
        (begin
          (if (not (dk-asm? (list 'IN fz 'RR))) (fact 'fun-apply-type-c f dd 'RR z))
          (if (not (dk-asm? (list '<= 0 fz))) (dk-apply! (b3l-nn-hyp f dd) z))
          (let ((iff (dk-cite! 'rr-pos-star-membership fz)))
            (dk-have! (list 'IN fz 'RR-POS-STAR)
              (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN fz 'RR) (list '<= 0 fz))) prop))))))))
(define (b3l-family! f dd)
  (fact 'fun-domain-in-set dd 'RR f)
  (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd 'RR)))
  (b3l-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
  (fact 'dom-of-fun dd f)
  (dk-split-all! (list (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd))))
  (let ((De (list '= (list 'DOM f) dd)) (D (list 'DOM f)))
    (dk-have! (list 'IN f (list 'FUN D 'RR)) (lambda () (subst De) (ass)))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ D) (list '<= 0 (list f 'z_))))
      (lambda () (subst De) (ass)))
    (dk-have! (list 'IN f (list 'FUN dd 'RR-POS-STAR))
      (lambda ()
        (mac 'fun-codomain-iff)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((kv (dk-di-var!))) (dk-close-if! (lambda () (b3l-rps-pt! f dd kv)) (lambda () (ass))))
                (ass))))))
    (dk-have! (list 'IN f (list 'FUN D 'RR-POS-STAR)) (lambda () (subst De) (ass)))))
;; s a finite subset of dd in context: P(f, s) in RR, 0 <= P(f, s), the pointwise RR-POS-STAR typing over s
(define (b3l-partial! f dd s)
  (dk-have! (list 'SUBSET s (list 'DOM f)) (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))
  (dk-split-all! (list (dk-cite! 'rps-finsum-eq-cc-finsum f s)))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list 'IN (list f 'z_) 'RR-POS-STAR)))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd s dd z)
                 (dk-close-if! (lambda () (b3l-rps-pt! f dd z)) (lambda () (ass)))))))
;; the bound universal esum-least / esum-bounded-implies-finite want: forall finite s <= DOM f. P(f, s) <= b
(define (b3l-bound-univ f b) (list 'FORALL 'b3s_ (list 'IMPLIES (b3l-fin 'b3s_ (list 'DOM f)) (list '<= (b3l-P f 'b3s_) b))))
;; PROVE (b3l-bound-univ f b), given PARTIAL! of the eigenvariable s proving P(f, s) <= b with s finite <= dd
(define (b3l-bound! f dd b partial!)
  (dk-have! (b3l-bound-univ f b)
    (lambda ()
      (dk-peel!)
      (let ((s (cadddr (cadr (dk-goal)))))
        (dk-split-all!)
        (dk-rewrite-h! (list 'SUBSET s (list 'DOM f)) (list 'DOM f) dd)
        (partial! s)))))
;; from the bound universal with b real: ESUM f in RR and ESUM f <= b
(define (b3l-esum-from-bound! f b)
  (let ((E (list 'ESUM f)))
    (dk-have! (list 'FORSOME 'b3m_ (list 'AND '(IN b3m_ RR) (b3l-bound-univ f 'b3m_)))
      (lambda () (ew b) (dk-conj-close! (lambda () (ass)))))
    (fact 'esum-bounded-implies-finite f)
    (let ((iff (dk-cite! 'rr-pos-star-membership b)))
      (dk-have! (list 'IN b 'RR-POS-STAR)
        (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN b 'RR) (list '<= 0 b))) prop))))
    (b3l-and! (list 'IN b 'RR-POS-STAR) (b3l-bound-univ f b))
    (fact 'esum-least f b)
    E))

;; f in FUN(DOM f, RR-POS-STAR) in context: 0 <= ESUM f (the empty partial sum is 0)
(define (b3l-esum-nonneg! f)
  (let ((D (list 'DOM f)))
    (dk-have! (list '<= 0 (list 'ESUM f))
      (lambda ()
        (dk-have! (b3l-fin 'EMPTY-SET D)
          (lambda () (dk-conj-close! (lambda () (cond ((dk-head-is? (dk-goal) 'SUBSET) (fact 'empty-subset-any D) (ass))
                                                      ((equal? (dk-goal) '(IN EMPTY-SET SET)) (fact 'empty-set-is-set) (b3l-close!))
                                                      (#t (fact 'card-empty) (fact 'nn-zero-in)
                                                          (subst '(= (CARD EMPTY-SET) 0)) (b3l-close!)))))))
        (fact 'esum-upper f 'EMPTY-SET)
        (fact 'finsum-empty b3l-RM f)
        (dk-have! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0) (lambda () (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID))) (qrfl)))
        (subst (list '= 0 (list 'IDEN b3l-RM)))
        (subst (list '= (list 'IDEN b3l-RM) (b3l-P f 'EMPTY-SET)))
        (ass)))))

;;; ===========================================================================
;;; esum-real-le-ptwise: 0 <= f <= g pointwise, real, ESUM g finite => ESUM f finite, <= ESUM g.
(sp (make-wff
  '(FORALL dd (FORALL f (FORALL g (IMPLIES (IN f (FUN dd RR)) (IMPLIES (IN g (FUN dd RR))
     (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (<= 0 (f z_))))
       (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (<= (f z_) (g z_))))
         (IMPLIES (IN (ESUM g) RR) (AND (IN (ESUM f) RR) (<= (ESUM f) (ESUM g)))))))))))))
(dk-peel!)
(define b3l-le (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (equal? (caddr (caddr a)) (list '<= (list 'f (cadr a)) (list 'g (cadr a)))))) "f <= g"))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ dd) (<= 0 (g z_))))
  (lambda () (let ((z (cadr (car (dk-peel!)))))
               (fact 'fun-apply-type-c 'f 'dd 'RR z) (fact 'fun-apply-type-c 'g 'dd 'RR z)
               (dk-apply! (b3l-nn-hyp 'f 'dd) z) (dk-apply! b3l-le z)
               (dk-ineq! (list '<= 0 (list 'f z)) (list '<= (list 'f z) (list 'g z)) (list 'IN (list 'f z) 'RR) (list 'IN (list 'g z) 'RR)))))
(b3l-family! 'f 'dd)
(b3l-family! 'g 'dd)
(b3l-bound! 'f 'dd '(ESUM g)
  (lambda (s)
    (b3l-partial! 'f 'dd s)
    (b3l-partial! 'g 'dd s)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list '<= '(f z_) '(g z_))))
      (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd s 'dd z) (dk-apply! b3l-le z) (b3l-close!))))
    (fact 'rps-finsum-le-ptwise s 'f 'g)
    (b3l-and3! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s '(DOM g)))
    (dk-have! (list 'SUBSET s '(DOM g)) (lambda () (subst '(= (DOM g) dd)) (ass)))
    (b3l-and3! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s '(DOM g)))
    (fact 'esum-upper 'g s)
    (dk-ineq! (list '<= (b3l-P 'f s) (b3l-P 'g s)) (list '<= (b3l-P 'g s) '(ESUM g))
              (list 'IN (b3l-P 'f s) 'RR) (list 'IN (b3l-P 'g s) 'RR) '(IN (ESUM g) RR))))
(b3l-esum-nonneg! 'g)
(b3l-esum-from-bound! 'f '(ESUM g))
(dk-conj-close! (lambda () (ass)))
(b3l-done! 'esum-real-le-ptwise)
;;; ===========================================================================
;;; esum-real-add-le: 0 <= h <= f + g pointwise, all real, ESUM f and ESUM g finite =>
;;; ESUM h finite and ESUM h <= ESUM f + ESUM g.  A partial sum of h is bounded by the partial sum of
;;; the pointwise sum (rps-finsum-le-ptwise), which splits (finsum-cm-add-ptwise) into two partial
;;; sums, each below its ESUM (esum-upper).
(define (b3l-nn z f) (list 'FORALL z (list 'IMPLIES (list 'IN z 'dd) (list '<= 0 (list f z)))))
(sp (make-wff
  (list 'FORALL 'dd (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
   (list 'IMPLIES '(IN f (FUN dd RR)) (list 'IMPLIES '(IN g (FUN dd RR)) (list 'IMPLIES '(IN h (FUN dd RR))
   (list 'IMPLIES (b3l-nn 'z_ 'f) (list 'IMPLIES (b3l-nn 'z_ 'g) (list 'IMPLIES (b3l-nn 'z_ 'h)
   (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ dd) (<= (h z_) (+ (f z_) (g z_)))))
   (list 'IMPLIES '(IN (ESUM f) RR) (list 'IMPLIES '(IN (ESUM g) RR)
     '(AND (IN (ESUM h) RR) (<= (ESUM h) (+ (ESUM f) (ESUM g)))))))))))))))))))
(dk-peel!)
(define b3l-hle (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '+))) "h <= f + g"))
(b3l-family! 'f 'dd)
(b3l-family! 'g 'dd)
(b3l-family! 'h 'dd)
(b3l-esum-nonneg! 'f)
(b3l-esum-nonneg! 'g)
(fact 'rr-pos-star-is-comm-monoid)
(fact 'rr-pos-star-add-monoid@carr)
(fact 'rr-pos-star-add-monoid@opr)
(define b3l-EF '(+ (ESUM f) (ESUM g)))
(b3l-and! '(IN (ESUM f) RR) '(IN (ESUM g) RR))
(fact 'rr-add-closed '(ESUM f) '(ESUM g))
(dk-have! (list '<= 0 b3l-EF) (lambda () (dk-ineq! '(<= 0 (ESUM f)) '(<= 0 (ESUM g)) '(IN (ESUM f) RR) '(IN (ESUM g) RR))))
(define b3l-L '(VNB-LAMBDA b3k_ dd (+ (f b3k_) (g b3k_))))
(define (b3l-ptw! s body-of closer!)      ; forall z_ in s. body, z_ in dd landed, by CLOSER!
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (body-of 'z_)))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd s 'dd z) (closer! z)))))
(define (b3l-pt-facts! z)                 ; f z, g z, h z typed; L z = f z + g z
  (for-each (lambda (q) (b3l-rps-pt! q 'dd z)) '(f g h))
  (dk-have! (list '= (list b3l-L z) (list '+ (list 'f z) (list 'g z)))
    (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
(b3l-bound! 'h 'dd b3l-EF
  (lambda (s)
    (for-each (lambda (q) (b3l-partial! q 'dd s)) '(f g h))
    (let ((Pf (b3l-P 'f s)) (Pg (b3l-P 'g s)) (Ph (b3l-P 'h s)) (PL (b3l-P b3l-L s)))
      (b3l-ptw! s (lambda (z) (list 'IN (list b3l-L z) 'RR-POS-STAR))
        (lambda (z) (b3l-pt-facts! z)
          (subst (list '= (list b3l-L z) (list '+ (list 'f z) (list 'g z))))
          (b3l-and! (list 'IN (list 'f z) 'RR) (list 'IN (list 'g z) 'RR))
          (fact 'rr-add-closed (list 'f z) (list 'g z))
          (let ((iff (dk-cite! 'rr-pos-star-membership (list '+ (list 'f z) (list 'g z)))))
            (dk-have! (list '<= 0 (list '+ (list 'f z) (list 'g z)))
              (lambda () (dk-ineq! (list '<= 0 (list 'f z)) (list '<= 0 (list 'g z)) (list 'IN (list 'f z) 'RR) (list 'IN (list 'g z) 'RR))))
            (dk-close-if! (lambda () (dk-only! iff (list 'IN (list '+ (list 'f z) (list 'g z)) 'RR) (list '<= 0 (list '+ (list 'f z) (list 'g z))))) prop))))
      (for-each (lambda (q)
                  (b3l-ptw! s (lambda (z) (list 'IN (list q z) '(CARR RR-POS-STAR-ADD-MONOID)))
                    (lambda (z) (b3l-rps-pt! q 'dd z) (subst '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR)) (ass))))
                '(f g))
      (b3l-ptw! s (lambda (z) (list '= (list b3l-L z) (list (list 'OPR b3l-RM) (list 'f z) (list 'g z))))
        (lambda (z) (b3l-pt-facts! z)
          (subst (list '= (list b3l-L z) (list '+ (list 'f z) (list 'g z))))
          (subst '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
          (fact 'eplus-real-defined (list 'f z) (list 'g z))
          (fact 'binplus-apply (list 'f z) (list 'g z))
          (subst (list '= (list 'eplus (list 'f z) (list 'g z)) (list 'binplus (list 'f z) (list 'g z))))
          (subst (list '== (list 'binplus (list 'f z) (list 'g z)) (list '+ (list 'f z) (list 'g z))))
          (b3l-close!)))
      (b3l-ptw! s (lambda (z) (list '<= (list 'h z) (list b3l-L z)))
        (lambda (z) (b3l-pt-facts! z) (dk-apply! b3l-hle z)
          (subst (list '= (list b3l-L z) (list '+ (list 'f z) (list 'g z)))) (b3l-close!)))
      (fact 'finsum-cm-add-ptwise b3l-RM s 'f 'g b3l-L)
      (fact 'rps-finsum-le-ptwise s 'h b3l-L)
      (fact 'eplus-real-defined Pf Pg)
      (fact 'binplus-apply Pf Pg)
      (b3l-and! (list 'IN Pf 'RR) (list 'IN Pg 'RR))
      (fact 'rr-add-closed Pf Pg)
      (dk-have! (list '= PL (list '+ Pf Pg))
        (lambda ()
          (subst (list '= PL (list (list 'OPR b3l-RM) Pf Pg)))
          (subst '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
          (subst (list '= (list 'eplus Pf Pg) (list 'binplus Pf Pg)))
          (subst (list '== (list 'binplus Pf Pg) (list '+ Pf Pg)))
          (b3l-close!)))
      (dk-have! (list 'IN PL 'RR) (lambda () (subst (list '= PL (list '+ Pf Pg))) (ass)))
      (for-each (lambda (q) (b3l-and3! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s (list 'DOM q)))
                            (fact 'esum-upper q s)) '(f g))
      (dk-ineq! (list '<= Ph PL) (list '= PL (list '+ Pf Pg)) (list '<= Pf '(ESUM f)) (list '<= Pg '(ESUM g))
                (list 'IN Ph 'RR) (list 'IN PL 'RR) (list 'IN Pf 'RR) (list 'IN Pg 'RR) '(IN (ESUM f) RR) '(IN (ESUM g) RR)))))
(b3l-esum-from-bound! 'h b3l-EF)
(dk-conj-close! (lambda () (ass)))
(b3l-done! 'esum-real-add-le)

;;; ===========================================================================
;;; l2(I): membership, and closure under the pointwise sum.
(define (b3l-Q c) (list 'VNB-LAMBDA 'l2k_ 'ix (list '* (list 'MAGNITUDE (list c 'l2k_)) (list 'MAGNITUDE (list c 'l2k_)))))
(define b3l-hooks '())
(define b3l-T '(VNB-LAMBDA b3a_ ix (+ (a b3a_) (b b3a_))))
(define b3l-S '(VNB-LAMBDA b3a_ ix (* c (a b3a_))))
(define b3l-PP '(VNB-LAMBDA l2k_ ix (* (a l2k_) (conjugate (b l2k_)))))
(define (b3l-sq t) (list '* (list 'MAGNITUDE t) (list 'MAGNITUDE t)))
(sp (make-wff '(FORALL ix (== (L2-FAMILIES ix)
  (SEP l2c_ (FUN ix CC) (IN (ESUM (VNB-LAMBDA l2k_ ix (* (MAGNITUDE (l2c_ l2k_)) (MAGNITUDE (l2c_ l2k_))))) RR))))))
(di)
(mac 'L2-FAMILIES)
(qrfl)
(b3l-done! 'l2-families-unfold)

(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'c (list 'IMPLIES '(IN c (L2-FAMILIES ix))
    (list 'AND '(IN c (FUN ix CC)) (list 'IN (list 'ESUM (b3l-Q 'c)) 'RR)))))))
(dk-peel!)
(let* ((m (dk-landed-1 (lambda () (mac-h 'l2-families-unfold '(IN c (L2-FAMILIES ix)))))))
  (dk-landed (lambda () (sep-me m))))
(dk-conj-close! (lambda () (ass)))
(b3l-done! 'l2-families-elim)

(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'c (list 'IMPLIES '(IN c (FUN ix CC))
    (list 'IMPLIES (list 'IN (list 'ESUM (b3l-Q 'c)) 'RR) '(IN c (L2-FAMILIES ix))))))))
(dk-peel!)
(mac 'L2-FAMILIES)
(in-sep! (lambda () (ass)) (lambda () (ass)))
(b3l-done! 'l2-families-intro)

;; z in ix, c in FUN(ix, CC) in context: c z in CC, |c z| in RR, 0 <= |c z|, |c z|^2 in RR, 0 <= |c z|^2
(define (b3l-cc-pt! c z)
  (let* ((cz (list c z)) (m (list 'MAGNITUDE cz)))
    (if (not (dk-asm? (list 'IN cz 'CC))) (fact 'fun-apply-type-c c 'ix 'CC z))
    (if (equal? c b3l-T) (b3l-Tpt! z))
    (if (equal? c b3l-S) (b3l-Spt! z))
    (if (equal? c b3l-PP) (b3l-Ppt! z))
    (let ((h (assoc c b3l-hooks))) (if h ((cdr h) z)))
    (b3l-mag! cz)))
(define (b3l-mag! t)                     ; t in CC in context
  (let ((m (list 'MAGNITUDE t)))
    (if (not (dk-asm? (list 'IN (b3l-sq t) 'RR)))
        (begin
          (fact 'cc-magnitude-closed t)
          (fact 'cc-magnitude-nonneg t)
          (b3l-and! (list 'IN m 'RR) (list 'IN m 'RR))
          (fact 'rr-mul-closed m m)
          (fact 'rr-sq-nonneg m)))))
;; the value of (Q c) at z, landed
(define (b3l-Qval! c z)
  (b3l-cc-pt! c z)
  (dk-have! (list '= (list (b3l-Q c) z) (b3l-sq (list c z))) (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
;; (Q c) in FUN(ix, RR), nonnegative
(define (b3l-Qfam! c)
  (dk-have! (list 'IN (b3l-Q c) '(FUN ix RR))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-cc-pt! c k) (b3l-close!))) (lambda () (ass)))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= 0 (list (b3l-Q c) 'z_))))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (b3l-Qval! c z) (subst (list '= (list (b3l-Q c) z) (b3l-sq (list c z)))) (ass)))))
;; the doubled square family D c = |c|^2 + |c|^2, typed, nonnegative, ESUM finite
(define (b3l-D c) (let ((v (list c 'b3d_))) (list 'VNB-LAMBDA 'b3d_ 'ix (list '+ (b3l-sq v) (b3l-sq v)))))
(define (b3l-Dval! c z)
  (b3l-cc-pt! c z)
  (dk-have! (list '= (list (b3l-D c) z) (list '+ (b3l-sq (list c z)) (b3l-sq (list c z)))) (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
(define (b3l-Dfam! c)
  (let ((D (b3l-D c)))
    (dk-have! (list 'IN D '(FUN ix RR))
      (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (p (b3l-sq (list c k))))
                                              (b3l-cc-pt! c k) (b3l-and! (list 'IN p 'RR) (list 'IN p 'RR)) (fact 'rr-add-closed p p) (b3l-close!)))
                               (lambda () (ass)))))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= 0 (list D 'z_))))
      (lambda () (let* ((z (cadr (car (dk-peel!)))) (p (b3l-sq (list c z))))
                   (b3l-Dval! c z) (subst (list '= (list D z) (list '+ p p)))
                   (dk-ineq! (list '<= 0 p) (list 'IN p 'RR)))))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list D 'z_) (list '+ (list (b3l-Q c) 'z_) (list (b3l-Q c) 'z_)))))
      (lambda () (let* ((z (cadr (car (dk-peel!)))) (p (b3l-sq (list c z))))
                   (b3l-Dval! c z) (b3l-Qval! c z)
                   (subst (list '= (list D z) (list '+ p p))) (subst (list '= (list (b3l-Q c) z) p))
                   (dk-ineq! (list 'IN p 'RR)))))
    (dk-split-all! (list (dk-cite! 'esum-real-add-le 'ix (b3l-Q c) (b3l-Q c) D)))))

(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix))
    (list 'IN b3l-T '(L2-FAMILIES ix)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'a)))
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'b)))
(fact 'fun-domain-in-set 'ix 'CC 'a)
(define (b3l-Tpt! z)                    ; T z = a z + b z, typed in CC
  (b3l-cc-pt! 'a z) (b3l-cc-pt! 'b z)
  (b3l-and! (list 'IN (list 'a z) 'CC) (list 'IN (list 'b z) 'CC))
  (fact 'cc-add-closed (list 'a z) (list 'b z))
  (b3l-mag! (list '+ (list 'a z) (list 'b z)))
  (dk-have! (list '= (list b3l-T z) (list '+ (list 'a z) (list 'b z))) (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
(dk-have! (list 'IN b3l-T '(FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-Tpt! k) (b3l-close!))) (lambda () (ass)))))
(b3l-Qfam! 'a)
(b3l-Qfam! 'b)
(b3l-Qfam! b3l-T)
(b3l-Dfam! 'a)
(b3l-Dfam! 'b)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list (b3l-Q b3l-T) 'z_) (list '+ (list (b3l-D 'a) 'z_) (list (b3l-D 'b) 'z_)))))
  (lambda () (let* ((z (cadr (car (dk-peel!)))) (s (list '+ (list 'a z) (list 'b z))) (pa (b3l-sq (list 'a z))) (pb (b3l-sq (list 'b z))))
               (b3l-Tpt! z) (b3l-Dval! 'a z) (b3l-Dval! 'b z)
               (b3l-mag! s)
               (dk-have! (list '= (list (b3l-Q b3l-T) z) (b3l-sq s)) (lambda () (dk-close-if! dk-lam-b! b3l-close!)))
               (fact 'cc-magnitude-sq-add-le (list 'a z) (list 'b z))
               (subst (list '= (list (b3l-Q b3l-T) z) (b3l-sq s)))
               (subst (list '= (list (b3l-D 'a) z) (list '+ pa pa)))
               (subst (list '= (list (b3l-D 'b) z) (list '+ pb pb)))
               (b3l-close!))))
(dk-split-all! (list (dk-cite! 'esum-real-add-le 'ix (b3l-D 'a) (b3l-D 'b) (b3l-Q b3l-T))))
(fact 'l2-families-intro 'ix b3l-T)
(b3l-close!)
(b3l-done! 'l2-families-add-closed)

;;; closure under the scalar action: c in CC, a in l2(I) => (c a_k)_k in l2(I).
;;; |c a_k|^2 = |c|^2 |a_k|^2 pointwise, and esum-scale-ptwise carries the scalar out of the ESUM.
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'c (list 'FORALL 'a (list 'IMPLIES '(IN c CC) (list 'IMPLIES '(IN a (L2-FAMILIES ix))
    (list 'IN b3l-S '(L2-FAMILIES ix)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'a)))
(fact 'fun-domain-in-set 'ix 'CC 'a)
(b3l-mag! 'c)
(define b3l-k (b3l-sq 'c))
(define (b3l-Spt! z)                    ; S z = c * a z, typed in CC
  (b3l-cc-pt! 'a z)
  (b3l-and! '(IN c CC) (list 'IN (list 'a z) 'CC))
  (fact 'cc-mul-closed 'c (list 'a z))
  (b3l-mag! (list '* 'c (list 'a z)))
  (dk-have! (list '= (list b3l-S z) (list '* 'c (list 'a z))) (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
(dk-have! (list 'IN b3l-S '(FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-Spt! k) (b3l-close!))) (lambda () (ass)))))
(b3l-Qfam! 'a)
(b3l-Qfam! b3l-S)
(b3l-family! (b3l-Q 'a) 'ix)
(b3l-family! (b3l-Q b3l-S) 'ix)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '= (list (b3l-Q b3l-S) 'z_) (list 'etimes b3l-k (list (b3l-Q 'a) 'z_)))))
  (lambda () (let* ((z (cadr (car (dk-peel!)))) (az (list 'a z)) (p (b3l-sq az)) (ma (list 'MAGNITUDE az)) (mc '(MAGNITUDE c)))
               (b3l-Spt! z) (b3l-Qval! 'a z)
               (dk-have! (list '= (list (b3l-Q b3l-S) z) (b3l-sq (list '* 'c az))) (lambda () (dk-close-if! dk-lam-b! b3l-close!)))
               (subst (list '= (list (b3l-Q b3l-S) z) (b3l-sq (list '* 'c az))))
               (subst (list '= (list (b3l-Q 'a) z) p))
               (fact 'etimes-real-defined b3l-k p)
               (fact 'bintimes-apply b3l-k p)
               (subst (list '= (list 'etimes b3l-k p) (list 'bintimes b3l-k p)))
               (subst (list '== (list 'bintimes b3l-k p) (list '* b3l-k p)))
               (b3l-and! '(IN c CC) (list 'IN az 'CC))
               (subst (dk-cite! 'cc-magnitude-mul 'c az))
               (crs))))
(fact 'rr-pos-star-is-comm-monoid)
(b3l-esum-nonneg! (b3l-Q 'a))
(define b3l-sc (dk-cite! 'esum-scale-ptwise b3l-k 'ix (b3l-Q 'a) (b3l-Q b3l-S)))
(fact 'etimes-real-in b3l-k (list 'ESUM (b3l-Q 'a)))
(dk-split-all!)
(dk-have! (list 'IN (list 'ESUM (b3l-Q b3l-S)) 'RR) (lambda () (subst b3l-sc) (ass)))
(fact 'l2-families-intro 'ix b3l-S)
(b3l-close!)
(b3l-done! 'l2-families-act-closed)

;;; ===========================================================================
;;; the inner-product family of two members of l2(I) is summable in CC, and sums to its
;;; CC-FAMILY-SUM: |a_k conj(b_k)| = |a_k| |b_k| <= 2|a_k|^2 + 2|b_k|^2, so the family is absolutely
;;; summable (esum-real-add-le), and CC is complete (cc-nag-complete, absolute-summable-implies-summable).
;; x, y in RR, nonnegative, x*x and y*y typed: x*y <= (x*x + x*x) + (y*y + y*y), landed
(define (b3l-xy! x y)
  (let* ((d (list '+ x (list '- y))) (dd (list '* d d)) (xx (list '* x x)) (yy (list '* y y)) (xy (list '* x y))
         (goal (list '<= xy (list '+ (list '+ xx xx) (list '+ yy yy)))))
    (dk-have! goal
      (lambda ()
        (fact 'rr-neg-closed y)
        (b3l-and! (list 'IN x 'RR) (list 'IN (list '- y) 'RR))
        (fact 'rr-add-closed x (list '- y))
        (b3l-and! (list 'IN d 'RR) (list 'IN d 'RR))
        (fact 'rr-mul-closed d d)
        (fact 'rr-sq-nonneg d)
        (b3l-and! (list 'IN x 'RR) (list 'IN y 'RR))
        (fact 'rr-mul-closed x y)
        (let ((v (dk-name! dd)))
          (dk-have! (list '<= 0 v) (lambda () (subst (list '= v dd)) (ass)))
          (dk-have! (list '= v (list '+ (list '+ xx (list '* -2 xy)) yy)) (lambda () (subst (list '= v dd)) (crs)))
          (dk-ineq! (list '<= 0 v) (list '= v (list '+ (list '+ xx (list '* -2 xy)) yy)) (list '<= 0 xx) (list '<= 0 yy)
                    (list 'IN v 'RR) (list 'IN xx 'RR) (list 'IN yy 'RR) (list 'IN xy 'RR)))))))
(define (b3l-Ppt! z)                    ; P z = a z * conj(b z), typed in CC
  (b3l-cc-pt! 'a z) (b3l-cc-pt! 'b z)
  (fact 'cc-conjugate-closed (list 'b z))
  (b3l-and! (list 'IN (list 'a z) 'CC) (list 'IN (list 'conjugate (list 'b z)) 'CC))
  (fact 'cc-mul-closed (list 'a z) (list 'conjugate (list 'b z)))
  (b3l-mag! (list '* (list 'a z) (list 'conjugate (list 'b z))))
  (dk-have! (list '= (list b3l-PP z) (list '* (list 'a z) (list 'conjugate (list 'b z)))) (lambda () (dk-close-if! dk-lam-b! b3l-close!))))
(define (b3l-beta-close!) (dk-close-if! dk-lam-b! b3l-close!))
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix))
    (list 'AND (list 'IN (list 'CC-FAMILY-SUM b3l-PP) 'CC) (list 'SUMS-TO 'CC-NAG b3l-PP (list 'CC-FAMILY-SUM b3l-PP))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'a)))
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'b)))
(fact 'fun-domain-in-set 'ix 'CC 'a)
(fact 'cc-nag-is-normed-ag)
(fact 'cc-nag-complete)
(fact 'cc-nag@carr)
(fact 'cc-nag@nrm)
(dk-have! (list 'IN b3l-PP '(FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-Ppt! k) (b3l-close!))) (lambda () (ass)))))
(dk-project! (list 'IN b3l-PP '(FUN ix)) 'fun-codomain-iff (list 'IN b3l-PP '(FUN ix CC)))
(b3l-and! (list 'IN b3l-PP '(FUN ix)) '(IN ix SET))
(fact 'dom-of-fun 'ix b3l-PP)
(dk-split-all! (list (list 'AND (list 'IN (list 'DOM b3l-PP) 'SET) (list '= (list 'DOM b3l-PP) 'ix))))
(define b3l-DP (list 'DOM b3l-PP))
(dk-have! (list 'IN b3l-PP (list 'FUN b3l-DP 'CC)) (lambda () (subst (list '= b3l-DP 'ix)) (ass)))
(dk-have! (list 'IN b3l-PP (list 'FUN b3l-DP '(CARR CC-NAG))) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
(b3l-Qfam! 'a)
(b3l-Qfam! 'b)
(b3l-Dfam! 'a)
(b3l-Dfam! 'b)
(dk-have! '(IS-ABSOLUTELY-SUMMABLE CC-NAG (VNB-LAMBDA l2k_ ix (* (a l2k_) (conjugate (b l2k_)))))
  (lambda ()
    (mac 'is-absolutely-summable)
    (subst (list '= b3l-DP 'ix))
    (subst '(== (NRM CC-NAG) (VNB-LAMBDA x_ CC (magnitude x_))))
    (let* ((N (cadr (cadr (dk-goal))))
           (Nval! (lambda (z) (b3l-Ppt! z)
                    (let ((pz (list '* (list 'a z) (list 'conjugate (list 'b z)))))
                      (dk-have! (list '= (list N z) (list 'MAGNITUDE pz)) b3l-beta-close!)
                      (subst (list '= (list N z) (list 'MAGNITUDE pz)))))))
      (dk-have! (list 'IN N '(FUN ix RR))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-Ppt! k) (dk-close-if! dk-lam-b! b3l-close!))) (lambda () (ass)))))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= 0 (list N 'z_))))
        (lambda () (let ((z (cadr (car (dk-peel!))))) (dk-close-if! (lambda () (Nval! z)) b3l-close!))))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list N 'z_) (list '+ (list (b3l-D 'a) 'z_) (list (b3l-D 'b) 'z_)))))
        (lambda () (let* ((z (cadr (car (dk-peel!)))) (az (list 'a z)) (bz (list 'b z))
                          (x (list 'MAGNITUDE az)) (y (list 'MAGNITUDE bz))
                          (pa (b3l-sq az)) (pb (b3l-sq bz)))
                     (Nval! z) (b3l-Dval! 'a z) (b3l-Dval! 'b z)
                     (subst (list '= (list (b3l-D 'a) z) (list '+ pa pa)))
                     (subst (list '= (list (b3l-D 'b) z) (list '+ pb pb)))
                     (b3l-and! (list 'IN az 'CC) (list 'IN (list 'conjugate bz) 'CC))
                     (subst (dk-cite! 'cc-magnitude-mul az (list 'conjugate bz)))
                     (subst (dk-cite! 'cc-magnitude-conjugate bz))
                     (dk-close-if! (lambda () (b3l-xy! x y)) b3l-close!)
                     )))
      (dk-split-all! (list (dk-cite! 'esum-real-add-le 'ix (b3l-D 'a) (b3l-D 'b) N)))
      (b3l-close!))))
(b3l-and! '(IS-NORMED-AG CC-NAG) '(IS-COMPLETE (NAG-METRIC-SPACE CC-NAG)))
(b3l-and! (list 'IN b3l-PP (list 'FUN b3l-DP '(CARR CC-NAG))) (list 'IS-ABSOLUTELY-SUMMABLE 'CC-NAG b3l-PP))
(define b3l-sm (dk-cite! 'absolute-summable-implies-summable 'CC-NAG b3l-PP))
(define b3l-r (dk-skolem! (dk-landed-1 (lambda () (mac-h 'is-summable b3l-sm))) #t))
(fact 'cc-nag@carr)
(dk-have! (list 'IN b3l-r 'CC) (lambda () (subst '(== CC (CARR CC-NAG))) (ass)))
(define b3l-cfs (dk-cite! 'cc-family-sum-value b3l-PP b3l-r))
(subst b3l-cfs)
(dk-conj-close! (lambda () (ass)))
(b3l-done! 'l2-ip-family-sums)

;;; the value of the inner product of l2(I)
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix))
    (list '= '((L2-IP ix) a b) (list 'CC-FAMILY-SUM b3l-PP)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'l2-ip-family-sums 'ix 'a 'b)))
(mac 'L2-IP)
(dk-lam-b!)
(b3l-close!)
(b3l-done! 'l2-ip-apply)

;;; ===========================================================================
;;; THE INNER-PRODUCT LAWS OF l2(I), first argument additive and homogeneous, conjugate symmetry:
;;; each is a law of unordered sums in CC (sums-to-add, cc-sums-to-scale, cc-sums-to-conjugate)
;;; carried to the families by function extensionality and read off by cc-family-sum-value.
(define (b3l-IPF x y) (list 'VNB-LAMBDA 'l2k_ 'ix (list '* (list x 'l2k_) (list 'conjugate (list y 'l2k_)))))
(define b3l-opl '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
;; typing in CC of a term built from typed atoms by + * - conjugate and applications (x k)
(define (b3l-cct! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (b3l-cct! (cadr t)) (b3l-cct! (caddr t))
         (b3l-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2)) (b3l-cct! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((and (pair? t) (eq? (car t) 'conjugate)) (b3l-cct! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) 'magnitude)) (b3l-cct! (cadr t)) (b3l-mag! (cadr t)) (fact 'rr-subset-cc t))
        ((and (pair? t) (= (length t) 2)) (b3l-cc-pt! (car t) (cadr t)))
        (#t (error "b3l-cct!: cannot type" t))))
;; the value of P_xy at z, typed
(define (b3l-Pv! x y z)
  (let ((v (list '* (list x z) (list 'conjugate (list y z)))))
    (b3l-cc-pt! x z) (b3l-cc-pt! y z) (b3l-cct! v)
    (dk-have! (list '= (list (b3l-IPF x y) z) v) (lambda () (dk-close-if! dk-lam-b! b3l-close!)))
    v))
;; the goal's (OPR CC-NAG) unfolded and every redex reduced
(define (b3l-norm!)
  (if (and (b3l-open?) (dk-contains? (dk-goal) '(OPR CC-NAG))) (subst (list '== '(OPR CC-NAG) b3l-opl)))
  (if (and (b3l-open?) (dk-contains? (dk-goal) 'VNB-LAMBDA)) (dk-lam-b!)))
;; P_xy as a family: typed over ix and over its DOM, its sum, and the value of the inner product.
;; Returns the sum CC-FAMILY-SUM(P_xy).
(define (b3l-ipfam! x y)
  (let* ((P (b3l-IPF x y)) (DP (list 'DOM P)) (C (list 'CC-FAMILY-SUM P)))
    (dk-have! (list 'IN P '(FUN ix CC))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (b3l-Pv! x y k) (b3l-close!))) (lambda () (ass)))))
    (dk-project! (list 'IN P '(FUN ix)) 'fun-codomain-iff (list 'IN P '(FUN ix CC)))
    (b3l-and! (list 'IN P '(FUN ix)) '(IN ix SET))
    (fact 'dom-of-fun 'ix P)
    (dk-split-all! (list (list 'AND (list 'IN DP 'SET) (list '= DP 'ix))))
    (dk-have! (list 'IN P (list 'FUN DP 'CC)) (lambda () (subst (list '= DP 'ix)) (ass)))
    (dk-have! (list 'IN P (list 'FUN DP '(CARR CC-NAG))) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
    (dk-split-all! (list (dk-cite! 'l2-ip-family-sums 'ix x y)))
    (dk-cite! 'l2-ip-apply 'ix x y)
    (dk-have! (list 'IN C '(CARR CC-NAG)) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
    C))
;; RES = (SUMS-TO CC-NAG L1 v1) landed, L1 over (DOM P_..) = ix; P the target family (typed);
;; PT! z lands the typings the pointwise identity L1 z = P z needs.  Lands and returns (SUMS-TO CC-NAG P v1).
(define b3l-pre-crs! (lambda (z) #t))
(define b3l-last-ext #f)
(define (b3l-transfer! res P pt!)
  (let* ((L1 (caddr res)) (D1 (caddr L1))
         (res2 (if (equal? D1 'ix) res (dk-rewrite-h! res D1 'ix)))
         (L2 (caddr res2)))
    (dk-fun-ext! L2 P 'ix 'CC
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (pt! k) (b3l-norm!) (if (b3l-open?) (b3l-cct! (cadr (dk-goal)))) (b3l-close!)))
                               (lambda () (ass))))
      #f
      (lambda (z) (pt! z) (b3l-norm!) (if (b3l-open?) (b3l-pre-crs! z)) (if (b3l-open?) (crs))))
    (set! b3l-last-ext (cons L2 P))
    (dk-rewrite-h! res2 L2 P)))
(define (b3l-l2-ctx! . names)
  (for-each (lambda (n) (dk-split-all! (list (dk-cite! 'l2-families-elim 'ix n)))) names)
  (fact 'fun-domain-in-set 'ix 'CC (car names))
  (fact 'cc-nag-is-normed-ag)
  (fact 'cc-nag@carr)
  (fact 'cc-nag@opr))

;;; <a + b, c> = <a, c> + <b, c>
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'c
    (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix)) (list 'IMPLIES '(IN c (L2-FAMILIES ix))
      '(= ((L2-IP ix) ((L2F-VADD ix) a b) c) (+ ((L2-IP ix) a c) ((L2-IP ix) b c))))))))))))
(dk-peel!)
(b3l-l2-ctx! 'a 'b 'c)
(fact 'l2-families-add-closed 'ix 'a 'b)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix b3l-T)))
(mac 'L2F-VADD)
(dk-lam-b!)
(define b3l-Tg (cadr (cadr (dk-goal))))
(dk-have! (list 'IN b3l-Tg '(L2-FAMILIES ix)) (lambda () (ass)))
(set! b3l-hooks
  (list (cons b3l-Tg
          (lambda (z) (b3l-cc-pt! 'a z) (b3l-cc-pt! 'b z) (b3l-cct! (list '+ (list 'a z) (list 'b z)))
            (dk-have! (list '= (list b3l-Tg z) (list '+ (list 'a z) (list 'b z))) (lambda () (dk-close-if! dk-lam-b! b3l-close!)))))))
(define b3l-r1 (b3l-ipfam! 'a 'c))
(define b3l-r2 (b3l-ipfam! 'b 'c))
(define b3l-r3 (b3l-ipfam! b3l-Tg 'c))
(for-each (lambda (x) (subst (list '= (list '(L2-IP ix) x 'c) (list 'CC-FAMILY-SUM (b3l-IPF x 'c))))) (list 'a 'b b3l-Tg))
(dk-have! (list 'IN (b3l-IPF 'b 'c) (list 'FUN (list 'DOM (b3l-IPF 'a 'c)) '(CARR CC-NAG)))
  (lambda () (subst (list '= (list 'DOM (b3l-IPF 'a 'c)) 'ix)) (subst '(== (CARR CC-NAG) CC)) (ass)))
(define b3l-add (dk-cite! 'sums-to-add 'CC-NAG (b3l-IPF 'a 'c) (b3l-IPF 'b 'c) b3l-r1 b3l-r2))
(define b3l-add2 (b3l-transfer! b3l-add (b3l-IPF b3l-Tg 'c)
                   (lambda (z) (b3l-Pv! 'a 'c z) (b3l-Pv! 'b 'c z) (b3l-Pv! b3l-Tg 'c z))))
(define (b3l-read-value! res v)          ; RES = (SUMS-TO CC-NAG P v1): land and return CFS(P) = v
  (let* ((P (caddr res)) (v1 (cadddr res)))
    (b3l-cct! v)
    (let ((res2 (if (equal? v1 v) res
                    (begin (dk-have! (list '= v1 v)
                             (lambda ()
                               (if (and b3l-last-ext (dk-contains? (dk-goal) (cdr b3l-last-ext)))
                                   (subst (list '= (cdr b3l-last-ext) (car b3l-last-ext))))
                               (if (and (b3l-open?) (not (equal? (cadr (dk-goal)) (caddr (dk-goal))))) (b3l-norm!))
                               (b3l-close!)))
                           (dk-rewrite-h! res v1 v)))))
      (dk-cite! 'cc-family-sum-value P v))))
(subst (b3l-read-value! b3l-add2 (list '+ b3l-r1 b3l-r2)))
(b3l-close!)
(b3l-done! 'l2-ip-add-left)

;;; <c a, b> = c <a, b>
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'c (list 'FORALL 'a (list 'FORALL 'b
    (list 'IMPLIES '(IN c CC) (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix))
      '(= ((L2-IP ix) ((L2F-ACT ix) c a) b) (* c ((L2-IP ix) a b))))))))))))
(dk-peel!)
(b3l-l2-ctx! 'a 'b)
(fact 'l2-families-act-closed 'ix 'c 'a)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix b3l-S)))
(mac 'L2F-ACT)
(dk-lam-b!)
(define b3l-Sg (cadr (cadr (dk-goal))))
(dk-have! (list 'IN b3l-Sg '(L2-FAMILIES ix)) (lambda () (ass)))
(set! b3l-hooks
  (list (cons b3l-Sg
          (lambda (z) (b3l-cc-pt! 'a z) (b3l-cct! (list '* 'c (list 'a z)))
            (dk-have! (list '= (list b3l-Sg z) (list '* 'c (list 'a z))) (lambda () (dk-close-if! dk-lam-b! b3l-close!)))))))
(define b3l-r1 (b3l-ipfam! 'a 'b))
(b3l-ipfam! b3l-Sg 'b)
(for-each (lambda (x) (subst (list '= (list '(L2-IP ix) x 'b) (list 'CC-FAMILY-SUM (b3l-IPF x 'b))))) (list 'a b3l-Sg))
(define b3l-sc2 (b3l-transfer! (dk-cite! 'cc-sums-to-scale 'c (b3l-IPF 'a 'b) b3l-r1) (b3l-IPF b3l-Sg 'b)
                  (lambda (z) (b3l-Pv! 'a 'b z) (b3l-Pv! b3l-Sg 'b z))))
(subst (b3l-read-value! b3l-sc2 (list '* 'c b3l-r1)))
(b3l-close!)
(b3l-done! 'l2-ip-act-left)

;;; <b, a> = conj <a, b>
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'b
    (list 'IMPLIES '(IN a (L2-FAMILIES ix)) (list 'IMPLIES '(IN b (L2-FAMILIES ix))
      '(= ((L2-IP ix) b a) (conjugate ((L2-IP ix) a b))))))))))
(dk-peel!)
(b3l-l2-ctx! 'a 'b)
(set! b3l-hooks '())
(define b3l-r1 (b3l-ipfam! 'a 'b))
(b3l-ipfam! 'b 'a)
(subst (list '= '((L2-IP ix) a b) (list 'CC-FAMILY-SUM (b3l-IPF 'a 'b))))
(subst (list '= '((L2-IP ix) b a) (list 'CC-FAMILY-SUM (b3l-IPF 'b 'a))))
(set! b3l-pre-crs!
  (lambda (z) (let ((az (list 'a z)) (bz (list 'b z)))
                (b3l-and! (list 'IN az 'CC) (list 'IN (list 'conjugate bz) 'CC))
                (subst (dk-cite! 'cc-conjugate-mul az (list 'conjugate bz)))
                (subst (dk-cite! 'cc-conjugate-involution bz)))))
(define b3l-cj2 (b3l-transfer! (dk-cite! 'cc-sums-to-conjugate (b3l-IPF 'a 'b) b3l-r1) (b3l-IPF 'b 'a)
                  (lambda (z) (b3l-Pv! 'a 'b z) (b3l-Pv! 'b 'a z))))
(set! b3l-pre-crs! (lambda (z) #t))
(subst (b3l-read-value! b3l-cj2 (list 'conjugate b3l-r1)))
(b3l-close!)
(b3l-done! 'l2-ip-conj-sym)

;;; the diagonal: <a, a> = ESUM |a_k|^2, a nonnegative real
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'IMPLIES '(IN a (L2-FAMILIES ix))
    (list 'AND (list '= '((L2-IP ix) a a) (list 'ESUM (b3l-Q 'a)))
      '(AND (IN ((L2-IP ix) a a) RR) (<= 0 ((L2-IP ix) a a)))))))))
(dk-peel!)
(b3l-l2-ctx! 'a)
(set! b3l-hooks '())
(define b3l-E (list 'ESUM (b3l-Q 'a)))
(b3l-Qfam! 'a)
(b3l-family! (b3l-Q 'a) 'ix)
(b3l-esum-nonneg! (b3l-Q 'a))
(fact 'rr-subset-cc b3l-E)
(define b3l-r1 (b3l-ipfam! 'a 'a))
(subst (list '= '((L2-IP ix) a a) (list 'CC-FAMILY-SUM (b3l-IPF 'a 'a))))
(set! b3l-pre-crs! (lambda (z) (subst (dk-cite! 'cc-magnitude-sq-conjugate (list 'a z)))))
(define b3l-dg (b3l-transfer! (dk-cite! 'esum-sums-to-cc (b3l-Q 'a)) (b3l-IPF 'a 'a) (lambda (z) (b3l-Pv! 'a 'a z))))
(set! b3l-pre-crs! (lambda (z) #t))
(subst (b3l-read-value! b3l-dg b3l-E))
(dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass)) (#t (b3l-close!)))))
(b3l-done! 'l2-ip-self)

;;; the diagonal vanishes exactly at the zero family: <a, a> = 0 iff a = L2-VZERO(ix)
;; Fm in FUN(DOM Fm, RR-POS-STAR), DOM Fm = ix, k in ix: one term is below the sum, Fm k <= ESUM Fm, landed
(define (b3l-term-le! Fm k)
  (let* ((pk (list 'PAIR k k)) (DF (list 'DOM Fm)) (Fpk (b3l-P Fm pk)))
    (fact 'membership-implies-sethood k 'ix)
    (b3l-and! (list 'IN k 'SET) (list 'IN k 'SET))
    (fact 'pairing k k)
    (fact 'card-singleton k)
    (fact 'nn-zero-in)
    (fact 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pk) 'NN) (lambda () (subst (list '= (list 'CARD pk) '(succ 0))) (ass)))
    (dk-have! (list 'SUBSET pk DF)
      (lambda ()
        (mac 'subset-def)
        (let ((x (cadr (car (dk-peel!)))))
          (dk-cite! 'pairing-membership k k x)
          (dk-have! (list '= x k) (lambda () (prop)))
          (subst (list '= DF 'ix))
          (subst (list '= x k))
          (ass))))
    (b3l-and3! (list 'IN pk 'SET) (list 'IN (list 'CARD pk) 'NN) (list 'SUBSET pk DF))
    (fact 'esum-upper Fm pk)
    (fact 'rr-pos-star-is-comm-monoid)
    (fact 'rr-pos-star-add-monoid@carr)
    (b3l-rps-pt! Fm 'ix k)
    (dk-have! (list 'IN (list Fm k) '(CARR RR-POS-STAR-ADD-MONOID)) (lambda () (subst '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR)) (ass)))
    (fact 'finsum-cm-singleton-ptwise b3l-RM k Fm)
    (dk-have! (list '<= (list Fm k) (list 'ESUM Fm)) (lambda () (subst (list '= (list Fm k) Fpk)) (ass)))))
(define b3l-Z '(VNB-LAMBDA l2k_ ix 0))
(sp (make-wff
  (list 'FORALL 'ix (list 'FORALL 'a (list 'IMPLIES '(IN a (L2-FAMILIES ix))
    '(IFF (= ((L2-IP ix) a a) 0) (= a (L2F-VZERO ix))))))))
(dk-peel!)
(b3l-l2-ctx! 'a)
(set! b3l-hooks '())
(define b3l-Qa (b3l-Q 'a))
(define b3l-E (list 'ESUM b3l-Qa))
(b3l-Qfam! 'a)
(b3l-family! b3l-Qa 'ix)
(b3l-esum-nonneg! b3l-Qa)
(dk-split-all! (list (dk-cite! 'l2-ip-self 'ix 'a)))
(mac 'L2F-VZERO)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(fact 'rr-subset-cc 0)
(dk-have! (list 'IN b3l-Z '(FUN ix CC)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
(dk-iff! (lambda (g) (equal? (cadr g) 'a))
  (lambda ()                            ; <a, a> = 0 => a = 0
    (dk-have! (list '= b3l-E 0) (lambda () (subst (list '= b3l-E '((L2-IP ix) a a))) (ass)))
    (dk-fun-ext! 'a b3l-Z 'ix 'CC #f #f
      (lambda (k)
        (let* ((ak (list 'a k)) (m (list 'MAGNITUDE ak)) (p (b3l-sq ak)))
          (b3l-Qval! 'a k)
          (b3l-term-le! b3l-Qa k)
          (dk-have! (list '<= p 0)
            (lambda () (dk-ineq! (list '<= (list b3l-Qa k) b3l-E) (list '= b3l-E 0) (list '= (list b3l-Qa k) p)
                                 (list 'IN p 'RR) (list 'IN b3l-E 'RR))))
          (b3l-and! (list 'IN p 'RR) '(IN 0 RR))
          (b3l-and! (list '<= p 0) (list '<= 0 p))
          (fact 'rr-leq-antisymmetric p 0)
          (fact 'rr-square-zero m)
          (let ((iff (dk-cite! 'cc-magnitude-zero-iff ak)))
            (dk-have! (list '= ak 0) (lambda () (dk-close-if! (lambda () (dk-only! iff (list '= m 0))) prop))))
          (dk-close-if! dk-lam-b! b3l-close!)))))
  (lambda ()                            ; a = 0 => <a, a> = 0
    (subst (list '= '((L2-IP ix) a a) b3l-E))
    (fact 'rr-pos-star-add-monoid@iden)
    (fact 'rr-pos-star-is-comm-monoid)
    (b3l-bound! b3l-Qa 'ix 0
      (lambda (s)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list '= (list b3l-Qa 'z_) '(IDEN RR-POS-STAR-ADD-MONOID))))
          (lambda () (let* ((z (cadr (car (dk-peel!)))) (az (list 'a z)))
                       (fact 'subset-mem-fwd s 'ix z)
                       (b3l-Qval! 'a z)
                       (dk-have! (list '= az 0) (lambda () (subst (list '= 'a b3l-Z)) (dk-close-if! dk-lam-b! b3l-close!)))
                       (subst (list '= (list b3l-Qa z) (b3l-sq az)))
                       (subst (list '= az 0))
                       (fact 'cc-magnitude-zero)
                       (subst '(= (MAGNITUDE 0) 0))
                       (subst '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
                       (arith))))
        (fact 'finsum-cm-all-iden-ptwise b3l-RM s b3l-Qa)
        (subst (list '= (b3l-P b3l-Qa s) '(IDEN RR-POS-STAR-ADD-MONOID)))
        (subst '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
        (fact 'rr-leq-reflexive 0)
        (ass)))
    (fact 'rr-leq-reflexive 0)
    (b3l-esum-from-bound! b3l-Qa 0)
    (b3l-and! (list 'IN b3l-E 'RR) '(IN 0 RR))
    (b3l-and! (list '<= b3l-E 0) (list '<= 0 b3l-E))
    (fact 'rr-leq-antisymmetric b3l-E 0)
    (ass)))
(b3l-done! 'l2-ip-self-zero)
