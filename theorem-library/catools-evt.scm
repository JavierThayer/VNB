;;; catools-evt.scm -- the extreme value theorem on a compact metric space (CA-TOOLS, 2026-10-26).
;;; Destination: theorem-library/catools-evt.scm, library analysis.
;;;
;;;   continuous-real-near           f continuous from s to RR: f(b) is within eps of f(x) when d(b, x) < del
;;;   compact-continuous-max         s compact, inhabited, f : s -> RR continuous ==> f attains its maximum
;;;   neg-continuous-real            -f is continuous when f is
;;;   compact-continuous-min         ... and its minimum
;;; Proof of the maximum: f is bounded above (a sequence with f(x_n) > n has a cluster point, where
;;; continuity bounds f); M = sup f(s) (rr-sup-*, primitive); a sequence with f(t_k) > M - 1/(k+1)
;;; (rmm-nn-choice) has a cluster point p, and continuity at p gives f(p) >= M.
;;; Load window: after theorem-library/riesz-markov-model (load.scm 3048, rmm-nn-choice) and
;;; rake-compact-equivalences (2607, compact-iff-cluster-point).  Helper prefix evt-.
;;; ======================================================================
(define (evt-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (evt-and! a b) (if (not (dk-asm? (list 'AND a b))) (dk-have! (list 'AND a b) (lambda () (dk-conj-close!)))))
(define evt-seq-family '())
(define (evt-choose-seq! A Pf witness-of)
  (let* ((lfam (list 'VNB-LAMBDA 'evtk_ 'NN (list 'SEP 'evtw_ A (Pf 'evtk_ 'evtw_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list lfam 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let* ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (for-each (lambda (lv)
                                (if (memq lv (dk-open-leaves))
                                    (begin (dk-focus! lv) (ass))))
                              (dk-opened (lambda () (sep-mi))))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A lfam))))
      (set! evt-seq-family (cons (cons g lfam) evt-seq-family))
      g)))
(define (evt-seq-at! g k)
  (let* ((lfam (cdr (assq g evt-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list lfam 'k))))))
         (h  (dk-apply! (or cl (error "evt-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
(define (evt-pos! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (let ((pi (dk-cite! 'pos-rr c)))
        (dk-have! (caddr pi)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        ((dk-head-is? g '<=) (dk-ineq! (list '< 0 c)))
                        (#t (di) (dk-absurd! (list '= 0 c) (list '< 0 c)))))))))
        (dk-have! (list 'POS-RR c) (lambda () (prop))))))

;;; ======================================================================
;;; (1) continuity into RR, read with absolute values
;;; ======================================================================
(sp (make-wff '(FORALL s (FORALL f (IMPLIES (IS-CONTINUOUS s RR-MS f)
  (FORALL xc (IMPLIES (IN xc (PTS s)) (FORALL eps (IMPLIES (POS-RR eps)
    (FORSOME del (AND (POS-RR del)
      (FORALL b (IMPLIES (IN b (PTS s)) (IMPLIES (< ((DIST s) b xc) del)
        (AND (<= (f b) (+ (f xc) eps)) (<= (f xc) (+ (f b) eps)))))))))))))))))
(dk-peel!)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(let ((ci (dk-cite! 'is-continuous 's 'RR-MS 'f)))
  (dk-have! (caddr ci) (lambda () (prop)))
  (dk-split-all! (list (caddr ci))))
(dk-rewrite-h! '(IN f (FUN (PTS s) (PTS RR-MS))) '(PTS RR-MS) 'RR)
(define evt-1-ca (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT))) "pointwise") 'xc))
(let ((ci (dk-cite! 'is-continuous-at 's 'RR-MS 'f 'xc)))
  (dk-have! (caddr ci) (lambda () (prop)))
  (dk-split-all! (list (caddr ci))))
(fact 'rr-pos-rr-in-rr 'eps)
(fact 'fun-apply-type-c 'f '(PTS s) 'RR 'xc)
(let* ((cl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'delta))) "the delta clause"))
       (del (dk-skolem! (dk-apply! cl 'eps)))
       (_ (dk-split-all!))
       (dcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del))) "the clause at del")))
  (fact 'rr-pos-rr-in-rr del)
  (ew del)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((landed (dk-peel!))
                 (b (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(PTS s)))) landed))))
                 (fb (list 'f b)))
            (fact 'fun-apply-type-c 'f '(PTS s) 'RR b)
            (dk-cite! 'metric-dist-real 's b 'xc)
            (dk-cite! 'metric-dist-real 's 'xc b)
            (dk-cite! 'metric-sym 's 'xc b)
            (dk-have! (list '<= (list '(DIST s) 'xc b) del)
              (lambda () (dk-ineq! (list '= (list '(DIST s) 'xc b) (list '(DIST s) b 'xc)) (list '< (list '(DIST s) b 'xc) del))))
            (dk-apply! dcl b)
            (dk-cite! 'rr-ms-dist '(f xc) fb)
            (dk-rewrite-h! (list '<= (list '(DIST RR-MS) '(f xc) fb) 'eps) (list '(DIST RR-MS) '(f xc) fb) (list 'abs (list '- '(f xc) fb)))
            (evt-rr! (list '- '(f xc) fb))
            (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- '(f xc) fb) 'eps)))
            (dk-conj-close! (lambda () (dk-ineq! (list '<= (list '- 'eps) (list '- '(f xc) fb)) (list '<= (list '- '(f xc) fb) 'eps)))))))))
(qed 'continuous-real-near)
(topic! 'continuous-real-near 'analysis)

;;; ======================================================================
;;; (2) the maximum
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (FORALL f (IMPLIES (IS-CONTINUOUS s RR-MS f)
  (FORALL p0 (IMPLIES (IN p0 (PTS s))
    (FORSOME p (AND (IN p (PTS s)) (FORALL xz (IMPLIES (IN xz (PTS s)) (<= (f xz) (f p))))))))))))))
(dk-peel!)
(let ((ci (dk-cite! 'is-compact 's)))
  (dk-have! (caddr ci) (lambda () (prop)))
  (dk-split-all! (list (caddr ci))))
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(let ((ci (dk-cite! 'is-continuous 's 'RR-MS 'f)))
  (dk-have! (caddr ci) (lambda () (dk-close-if! (lambda () (dk-only! ci '(IS-CONTINUOUS s RR-MS f))) prop)))
  (dk-split-all! (list (caddr ci))))
(dk-rewrite-h! '(IN f (FUN (PTS s) (PTS RR-MS))) '(PTS RR-MS) 'RR)
(fact 'nn-zero-in)
(fact 'rr-one-in)
(define (evt-pt! z) (if (not (dk-asm? (list 'IN (list 'f z) 'RR))) (fact 'fun-apply-type-c 'f '(PTS s) 'RR z)))
(define evt-call
  (let* ((ciff (dk-cite! 'compact-iff-cluster-point 's)) (call (caddr ciff)))
    (dk-have! call (lambda () (prop)))
    call))
(define (evt-cluster! sq)
  (let ((x (dk-skolem! (dk-apply! evt-call sq))))
    (let ((ci (dk-cite! 'cluster-point 's sq x)))
      (dk-have! (caddr ci) (lambda () (dk-close-if! (lambda () (dk-only! ci (list 'CLUSTER-POINT 's sq x))) prop)))
      (dk-split-all! (list (caddr ci))))
    (evt-pt! x)
    x))
(define (evt-cluster-clause sq)
  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(DIST s)) (dk-contains? fm sq))) "the cluster clause"))
(define (evt-near! x eps)
  (let ((del (dk-skolem! (dk-cite! 'continuous-real-near 's 'f x eps))))
    (dk-split-all!)
    (fact 'rr-pos-rr-in-rr del)
    del))
(define (evt-near-clause del)
  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm 'AND))) "the continuity clause"))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(evt-pos! 1)

;; (A) f is bounded above
(define evt-bnd '(FORSOME bb (AND (IN bb RR) (FORALL xz (IMPLIES (IN xz (PTS s)) (<= (f xz) bb))))))
(dk-have! evt-bnd (lambda () (use-em evt-bnd
  (lambda () (ass))
  (lambda ()
    (let* ((sq (evt-choose-seq! '(PTS s)
                 (lambda (k w) (list '< k (list 'f w)))
                 (lambda (k)
                   (fact 'nn-in-rr k)
                   (let ((nf (list 'NOT (list 'FORALL 'evtz_ (list 'IMPLIES '(IN evtz_ (PTS s)) (list '<= '(f evtz_) k))))))
                     (dk-have! nf
                       (lambda ()
                         (di)
                         (dk-have! evt-bnd (lambda () (ew k) (dk-conj-close!)))
                         (ai (dk-ctx-form (list 'NOT evt-bnd)))))
                     (let* ((ex (car (dk-landed (lambda () (push-not-h nf)))))
                            (w (dk-skolem! ex)))
                       (dk-split-all!)
                       (evt-pt! w)
                       (dk-cite! 'rr-not-le-lt (list 'f w) k)
                       w)))))
           (x (evt-cluster! sq))
           (fx (list 'f x))
           (del (evt-near! x 1))
           (cl (evt-near-clause del))
           (_ (fact 'rr-add-in-rr fx 1))
           (nn_ (dk-skolem! (dk-cite! 'nn-unbounded-in-rr (list '+ fx 1))))
           (_2 (dk-split-all!))
           (j (dk-skolem! (dk-apply! (evt-cluster-clause sq) del nn_)))
           (_3 (dk-split-all!))
           (sj (list sq j)))
      (fact 'fun-apply-type-c sq 'NN '(PTS s) j)
      (evt-pt! sj)
      (dk-split-all! (list (dk-apply! cl sj)))
      (evt-seq-at! sq j)
      (fact 'nn-in-rr nn_) (fact 'nn-in-rr j)
      (pbc)
      (dk-absurd! (list '< j (list 'f sj)) (list '<= (list 'f sj) (list '+ fx 1)) (list '< (list '+ fx 1) nn_) (list '<= nn_ j)))))))
(define evt-bb (dk-skolem! evt-bnd))
(dk-split-all!)

;; (B) M = sup f(s)
(define evt-img '(SEP evtv_ RR (FORSOME evtz_ (AND (IN evtz_ (PTS s)) (= evtv_ (f evtz_))))))
(define evt-M (list 'SUP evt-img))
(define (evt-in-img! z)
  (evt-pt! z)
  (dk-have! (list 'IN (list 'f z) evt-img)
    (lambda ()
      (for-each (lambda (lv)
                  (if (memq lv (dk-open-leaves))
                      (begin (dk-focus! lv)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (ew z) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))
                (dk-opened (lambda () (sep-mi)))))))
(dk-have! (list 'SUBSET evt-img 'RR) (lambda () (let ((x (subset-by-element!))) (sep-me (list 'IN x evt-img)) (ass))))
(evt-in-img! 'p0)
(dk-have! (list 'FORSOME 'evtx_ (list 'IN 'evtx_ evt-img)) (lambda () (ew '(f p0)) (ass)))
(let ((ui (dk-cite! 'rr-upper-bound evt-img evt-bb)))
  (dk-have! (caddr ui)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((x (dk-di-var!)))
                (sep-me (list 'IN x evt-img))
                (let ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the point"))))
                  (dk-split-all!)
                  (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm evt-bb))) "the bound") z)
                  (subst (list '= x (list 'f z)))
                  (ass))))))))
  (dk-have! (list 'RR-UPPER-BOUND evt-img evt-bb) (lambda () (prop))))
(let ((bi (dk-cite! 'rr-bounded-above evt-img)))
  (dk-have! (caddr bi) (lambda () (ew evt-bb) (ass)))
  (dk-have! (list 'RR-BOUNDED-ABOVE evt-img) (lambda () (prop))))
(dk-cite! 'rr-sup-in evt-img)
(dk-cite! 'rr-sup-upper evt-img)
(let ((ui (dk-cite! 'rr-upper-bound evt-img evt-M)))
  (dk-have! (caddr ui) (lambda () (prop)))
  (dk-split-all! (list (caddr ui))))
(define evt-ub (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUP) (dk-contains? fm 'evtv_))) "M bounds the image"))
(define (evt-le-M! z) (evt-in-img! z) (dk-apply! evt-ub (list 'f z)))

;; (C) a maximizing sequence
(define evt-t
  (evt-choose-seq! '(PTS s)
    (lambda (k w) (list '< (list '- evt-M (list 'recip (list '+ k 1))) (list 'f w)))
    (lambda (k)
      (let* ((r (list 'recip (list '+ k 1)))
             (a (list '- evt-M r))
             (ex (list 'FORSOME 'evty_ (list 'AND '(IN evty_ (PTS s)) (list '< a '(f evty_))))))
        (dk-cite! 'nn-recip-succ-pos k) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
        (fact 'rr-sub-in-rr evt-M r)
        (dk-have! ex
          (lambda ()
            (use-em ex
              (lambda () (ass))
              (lambda ()
                (let ((ui (dk-cite! 'rr-upper-bound evt-img a)))
                  (dk-have! (caddr ui)
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (ass)
                              (let ((x (dk-di-var!)))
                                (sep-me (list 'IN x evt-img))
                                (let ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the point"))))
                                  (dk-split-all!)
                                  (evt-pt! z)
                                  (subst (list '= x (list 'f z)))
                                  (use-em (list '<= (list 'f z) a)
                                    (lambda () (ass))
                                    (lambda ()
                                      (dk-cite! 'rr-not-le-lt (list 'f z) a)
                                      (dk-have! ex (lambda () (ew z) (dk-conj-close!)))
                                      (dk-only! ex (list 'NOT ex))
                                      (prop))))))))))
                  (dk-have! (list 'RR-UPPER-BOUND evt-img a) (lambda () (prop))))
                (dk-cite! 'rr-sup-least evt-img)
                (let ((lst (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'RR-UPPER-BOUND) (dk-contains? fm 'SUP))) "sup least")))
                  (dk-apply! lst a))
                (pbc)
                (dk-absurd! (list '<= evt-M a) (list '< 0 r))))))
        (let ((w (dk-skolem! ex)))
          (dk-split-all!)
          w)))))

;; (D) a cluster point p of t attains M
(define evt-p (evt-cluster! evt-t))
(define evt-fp (list 'f evt-p))
(evt-le-M! evt-p)
(dk-have! (list '<= evt-M evt-fp)
  (lambda ()
    (use-em (list '<= evt-M evt-fp)
      (lambda () (ass))
      (lambda ()
        (dk-cite! 'rr-not-le-lt evt-M evt-fp)
        (let* ((d (list '- evt-M evt-fp))
               (_0 (fact 'rr-sub-in-rr evt-M evt-fp))
               (_1 (dk-have! (list '< 0 d) (lambda () (dk-ineq! (list '< evt-fp evt-M)))))
               (_2 (evt-pos! d))
               (h (dk-halve! d))
               (del (evt-near! evt-p h))
               (cl (evt-near-clause del))
               (n0 (dk-skolem! (dk-cite! 'nn-recip-succ-small h)))
               (_3 (dk-split-all!))
               (j (dk-skolem! (dk-apply! (evt-cluster-clause evt-t) del n0)))
               (_4 (dk-split-all!))
               (tj (list evt-t j))
               (rj (list 'recip (list '+ j 1)))
               (r0 (list 'recip (list '+ n0 1))))
          (fact 'fun-apply-type-c evt-t 'NN '(PTS s) j)
          (evt-pt! tj)
          (dk-split-all! (list (dk-apply! cl tj)))
          (evt-seq-at! evt-t j)
          (dk-cite! 'nn-recip-succ-pos j) (fact 'rr-pos-rr-in-rr rj)
          (dk-cite! 'nn-recip-succ-pos n0) (fact 'rr-pos-rr-in-rr r0)
          (dk-cite! 'nn-recip-succ-antitone n0 j)
          (pbc)
          (dk-absurd! (list '< (list '- evt-M rj) (list 'f tj))
                      (list '<= (list 'f tj) (list '+ evt-fp h))
                      (list '= (list '+ h h) d)
                      (list '<= rj r0)
                      (list '< r0 h)))))))
(ew evt-p)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (let ((z (dk-di-var!)))
          (evt-le-M! z)
          (dk-ineq! (list '<= (list 'f z) evt-M) (list '<= evt-M evt-fp))))))
(qed 'compact-continuous-max)
(topic! 'compact-continuous-max 'analysis)

;;; ======================================================================
;;; (3) -f is continuous; the minimum
;;; ======================================================================
(define evt-neg '(VNB-LAMBDA evtn_ (PTS s) (- (f evtn_))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'f (list 'IMPLIES '(IS-CONTINUOUS s RR-MS f)
  (list 'IS-CONTINUOUS 's 'RR-MS evt-neg))))))
(dk-peel!)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(fact 'rr-is-metric-space)
(let ((ci (dk-cite! 'is-continuous 's 'RR-MS 'f)))
  (dk-have! (caddr ci) (lambda () (dk-close-if! (lambda () (dk-only! ci '(IS-CONTINUOUS s RR-MS f))) prop)))
  (dk-split-all! (list (caddr ci))))
(dk-rewrite-h! '(IN f (FUN (PTS s) (PTS RR-MS))) '(PTS RR-MS) 'RR)
(dk-have! '(IN (PTS s) SET) (lambda () (dk-sethood! '(PTS s))))
(define evt-3-pw (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT))) "pointwise"))
(let ((ci (dk-cite! 'is-continuous 's 'RR-MS evt-neg)))
  (dk-have! (caddr ci)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((dk-head-is? g 'IN)
               (subst '(== (PTS RR-MS) RR))
               (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'fun-apply-type-c 'f '(PTS s) 'RR x) (dk-type! (list '- (list 'f x)) 'RR)))))
              (#t
               (let* ((a (dk-di-var!)))
                 (dk-apply! evt-3-pw a)
                 (let ((cf (dk-cite! 'is-continuous-at 's 'RR-MS 'f a)))
                   (dk-have! (caddr cf) (lambda () (prop)))
                   (dk-split-all! (list (caddr cf))))
                 (dk-have! (list 'IN evt-neg (list 'FUN '(PTS s) '(PTS RR-MS)))
                   (lambda () (subst '(== (PTS RR-MS) RR))
                     (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'fun-apply-type-c 'f '(PTS s) 'RR x) (dk-type! (list '- (list 'f x)) 'RR))))))
                 (let* ((fcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'delta) (dk-contains? fm (list 'f a)))) "f's clause"))
                        (cg (dk-cite! 'is-continuous-at 's 'RR-MS evt-neg a)))
                   (dk-have! (caddr cg)
                     (lambda ()
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal))
                               (ass)
                               (let* ((ls (dk-peel!))
                                      (eps (dk-landed-eps ls))
                                      (del (dk-skolem! (dk-apply! fcl eps)))
                                      (_ (dk-split-all!))
                                      (dcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del))) "clause at delta")))
                                 (ew del)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal))
                                         (ass)
                                         (let* ((ls2 (dk-peel!))
                                                (b (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(PTS s)))) ls2))))
                                                (fa (list 'f a)) (fb (list 'f b)))
                                           (fact 'fun-apply-type-c 'f '(PTS s) 'RR a)
                                           (fact 'fun-apply-type-c 'f '(PTS s) 'RR b)
                                           (fact 'rr-pos-rr-in-rr eps)
                                           (dk-apply! dcl b)
                                           (dk-cite! 'rr-ms-dist fa fb)
                                           (dk-rewrite-h! (list '<= (list '(DIST RR-MS) fa fb) eps) (list '(DIST RR-MS) fa fb) (list 'abs (list '- fa fb)))
                                           (dk-type! (list '- fa fb) 'RR)
                                           (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- fa fb) eps)))
                                           (dk-lam-b!)
                                           (dk-type! (list '- fa) 'RR) (dk-type! (list '- fb) 'RR)
                                           (dk-cite! 'rr-ms-dist (list '- fa) (list '- fb))
                                           (subst (list '= (list '(DIST RR-MS) (list '- fa) (list '- fb)) (list 'abs (list '- (list '- fa) (list '- fb)))))
                                           (let ((x (list '- (list '- fa) (list '- fb))))
                                             (dk-type! x 'RR)
                                             (dk-have! (list '<= (list '- eps) x) (lambda () (dk-ineq! (list '<= (list '- fa fb) eps))))
                                             (dk-have! (list '<= x eps) (lambda () (dk-ineq! (list '<= (list '- eps) (list '- fa fb)))))
                                             (dk-cite! 'rr-abs-le-of-parts x eps)
                                             (ass))))))))))))
