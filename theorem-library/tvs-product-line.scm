;;; prod.scm -- THE PRODUCT TOPOLOGICAL VECTOR SPACE E x R, and topological-vector-space.pdf Prop 2.35
;;; (the strict epigraph of a continuous convex functional is open and convex).
;;; Agent TVS-NEXT (worker-08), 2026-10-26.
;;; DESTINATION: theorem-library/tvs-product-line.scm.  Library: analysis.  Helper prefix: ptv-.
;;; Needs: prod-vocab.scm (structure-library/tvs-product-line.scm), the TB-01 vocabulary (IS-TVS),
;;; tvs-minkowski (rmod-act-*), seminorm-extension (rmod-vadd-*), tvs-kernel-closed (rr-abs-open-ball,
;;; tvs-scal-cont-rr, top-open-of-local).
;;;
;;; (A) PROD-RMOD(m) is a module when m is a real module: the values of the three operations on pairs,
;;;     the read-offs, and each conjunct of IS-MODULE componentwise (the laws of m in the first
;;;     coordinate, ring arithmetic by crs in the second).
;;; (B) PROD-TOP(t) is a topology (boxes), Hausdorff when t is, and a box around an open set is open.
;;; (C) E x R is a topological vector space when E is (prod-is-tvs).
;;; (D) Prop 2.35.

(define (ptv-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; PTV OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (ptv-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (ptv-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (ptv-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define (ptv-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((dk-head-is? t 'abs) (ptv-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (ptv-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (ptv-real! (cadr t)) (ptv-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((dk-head-is? t 'recip) (ptv-real! (cadr t))
           (ptv-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (dk-cite! 'rr-recip-closed (cadr t)) ty)
          ((dk-head-is? t 'min) (ptv-real! (cadr t)) (ptv-real! (caddr t)) (dk-cite! 'rr-min-closed (cadr t) (caddr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (ptv-real! (cadr t)) (ptv-real! (caddr t))
           (ptv-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-real! t) ty))))
(define (ptv-vtype! t)
  (let ((ty (list 'IN t '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((equal? t '(VZERO m)) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (ptv-real! (cadr t)) (ptv-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (ptv-vtype! (cadr t)) (ptv-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VNEG m)))
           (ptv-vtype! (cadr t)) (dk-cite! 'module-vneg-type 'm (cadr t)) ty)
          (#t (error "ptv-vtype!: no typing for" (expression->string t))))))

(define ptv-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define ptv-rmod (list '(IS-MODULE m) (list '= '(SCAL m) ptv-ring)))
(define ptv-C '(CARTESIAN (VEC m) RR))
(define (ptv-n1 x) (list 'NTH 1 x))
(define (ptv-n2 x) (list 'NTH 2 x))
(define (ptv-stmt vars typs body)
  (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES (list '= '(SCAL m) ptv-ring) (forall-guarded vars typs body)))))
(define (ptv-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) ptv-ring)) (mac 'rr-scalar-ring-carr) (ass))))
    ty))
(define (ptv-sets!)
  (if (not (dk-asm? (list 'IN ptv-C 'SET)))
      (begin
        (dk-cite! 'frm-module-vec-set 'm)
        (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
        (dk-have! (list 'IN ptv-C 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))))
;; x in C: components typed, and x = [x1, x2]
(define (ptv-open! x)
  (if (not (and (dk-asm? (list 'IN (ptv-n1 x) '(VEC m))) (dk-asm? (list 'IN (ptv-n2 x) 'RR))))
      (dk-split-all! (list (dk-cite! 'cartesian-nth x '(VEC m) 'RR))))
  (dk-cite! 'cartesian-pair-eq x '(VEC m) 'RR))
;; p = (LIST a b), a vector, b real: (IN p C)
(define (ptv-pair-in! p)
  (ptv-vtype! (cadr p)) (ptv-real! (caddr p))
  (dk-cite! 'pair-in-cartesian '(VEC m) 'RR (cadr p) (caddr p)))

;;; ---------------------------------------------------------------------------
;;; (A1) values of the operations on pairs
(define (ptv-value! name stmt fn)
  (sp (make-wff stmt))
  (dk-peel!)
  (ptv-sets!)
  (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) ptv-C)) (ptv-open! (cadr f)))) (dk-asms))
  (let ((r (caddr (dk-goal)))) (ptv-pair-in! r))
  (if (dk-asm? '(IN rx_ RR)) (ptv-carr! 'rx_))
  (mac fn)
  (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))
  (ptv-qed! name))
(ptv-value! 'pv-vadd-value
  (ptv-stmt '(px_ qx_) (list (list 'IN 'px_ ptv-C) (list 'IN 'qx_ ptv-C))
    (list '= '((PV-VADD m) px_ qx_)
          (list 'LIST (list '(VADD m) (ptv-n1 'px_) (ptv-n1 'qx_)) (list '+ (ptv-n2 'px_) (ptv-n2 'qx_)))))
  'PV-VADD)
(ptv-value! 'pv-vneg-value
  (ptv-stmt '(px_) (list (list 'IN 'px_ ptv-C))
    (list '= '((PV-VNEG m) px_) (list 'LIST (list '(VNEG m) (ptv-n1 'px_)) (list '- (ptv-n2 'px_)))))
  'PV-VNEG)
(ptv-value! 'pv-act-value
  (ptv-stmt '(rx_ px_) (list '(IN rx_ RR) (list 'IN 'px_ ptv-C))
    (list '= '((PV-ACT m) rx_ px_) (list 'LIST (list '(ACT m) 'rx_ (ptv-n1 'px_)) (list '* 'rx_ (ptv-n2 'px_)))))
  'PV-ACT)

;;; ---------------------------------------------------------------------------
;;; (A2) read-offs of PROD-RMOD(m)
(define ptv-readoffs
  (list (list 'SCAL '(SCAL m)) (list 'VEC ptv-C) (list 'VADD '(PV-VADD m)) (list 'VZERO '(LIST (VZERO m) 0))
        (list 'VNEG '(PV-VNEG m)) (list 'ACT '(PV-ACT m))))
(define (ptv-ro-name acc) (symbol-append 'prod-rmod- (string->symbol (string-downcase (symbol->string acc)))))
(define (ptv-hdr!)
  (di) (di) (di)
  (ptv-sets!)
  (dk-cite! 'module-vzero-in 'm)
  (dk-project! '(IS-RING (SCAL m)) 'is-module '(IS-MODULE m)))
(for-each
  (lambda (p)
    (let ((acc (car p)) (val (cadr p)))
      (sp (make-wff (ptv-stmt '() '() (list '== (list acc '(PROD-RMOD m)) val))))
      (ptv-hdr!)
      (slot acc)
      (mac 'PROD-RMOD)
      (nth-r)
      (if (and (not (proof-done? *ps*)) (dk-contains? (dk-goal) acc)) (slot acc))
      (if (not (proof-done? *ps*)) (qrfl))
      (if (not (proof-done? *ps*)) (begin (dk-focus! (car (dk-open-leaves))) (rfl)))
      (ptv-qed! (ptv-ro-name acc))))
  ptv-readoffs)
(define (ptv-subst-readoffs!)
  (for-each (lambda (p)
              (let ((e (dk-cite! (ptv-ro-name (car p)) 'm)))
                (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            ptv-readoffs))

;;; ---------------------------------------------------------------------------
;;; (A3) the three operations are functions
(define (ptv-carr-rr!)
  (let ((e (list '= '(CARR (SCAL m)) 'RR)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (subst (list '= '(SCAL m) ptv-ring)) (mac 'rr-scalar-ring-carr) (rfl))))
    e))
(define (ptv-fun! name fn dom)
  (sp (make-wff (ptv-stmt '() '() (list 'IN (list fn 'm) (list 'FUN dom ptv-C)))))
  (dk-peel!)
  (ptv-sets!)
  (ptv-carr-rr!)
  (dk-have! (list 'IN dom 'SET)
    (lambda () (if (dk--occurs? '(CARR (SCAL m)) (dk-goal)) (subst (ptv-carr-rr!)))
               (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (mac fn)
  (dk-lam-type!
    (lambda ()
      (let* ((lk (dk-peel!))
             (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ptv-C))) lk)))
             (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL m))))) lk))))
        (for-each (lambda (r) (dk-rewrite-h! (list 'IN r '(CARR (SCAL m))) '(CARR (SCAL m)) 'RR)) rs)
        (for-each ptv-open! xs)
        (ptv-pair-in! (cadr (dk-goal)))
        (ass)))
    (lambda () (ass)))
  (ptv-qed! name))
(ptv-fun! 'pv-vadd-fun 'PV-VADD (list 'CARTESIAN ptv-C ptv-C))
(ptv-fun! 'pv-vneg-fun 'PV-VNEG ptv-C)
(ptv-fun! 'pv-act-fun 'PV-ACT (list 'CARTESIAN '(CARR (SCAL m)) ptv-C))

;;; ---------------------------------------------------------------------------
;;; (A4) the module laws, componentwise
(define (ptv-scalar-eq! op r s)        ; (= (OP (SCAL m)) r s) == r + s / r * s, landed; returns it
  (let* ((rhs (list (if (eq? op 'ADD) '+ '*) r s))
         (lhs (list (list op '(SCAL m)) r s))
         (e (list '= lhs rhs)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda ()
                      (subst (list '= '(SCAL m) ptv-ring))
                      (mac (if (eq? op 'ADD) 'rr-scalar-ring-add 'rr-scalar-ring-mul))
                      (dk-lam-b!)
                      (ptv-real! rhs)
                      (rfl))))
    e))
(define (ptv-ops) '((PV-VADD m) (PV-VNEG m) (PV-ACT m) (ADD (SCAL m)) (MUL (SCAL m))))
(define (ptv-app-of? pred e) (let walk ((e e)) (and (pair? e) (list? e) (or (pred e) (any-pred walk e)))))
(define (ptv-redex e)                  ; an innermost application of one of the operations
  (if (not (and (pair? e) (list? e)))
      #f
      (or (let loop ((xs e)) (cond ((null? xs) #f) ((ptv-redex (car xs))) (#t (loop (cdr xs)))))
          (and (member (car e) (ptv-ops)) e))))
(define (ptv-has-nth-list?)
  (ptv-app-of? (lambda (x) (and (eq? (car x) 'NTH) (pair? (caddr x)) (eq? (car (caddr x)) 'LIST))) (dk-goal)))
(define (ptv-arg-in! a) (if (and (pair? a) (eq? (car a) 'LIST)) (ptv-pair-in! a)))
(define (ptv-norm!)
  (let loop ((fuel 40))
    (if (ptv-has-nth-list?) (nth-r))
    (if (dk--occurs? '(ONE (SCAL m)) (dk-goal))
        (begin
          (if (not (dk-asm? '(= (ONE (SCAL m)) 1)))
              (dk-have! '(= (ONE (SCAL m)) 1) (lambda () (subst (list '= '(SCAL m) ptv-ring)) (mac 'rr-scalar-ring-one) (arith))))
          (subst '(= (ONE (SCAL m)) 1))))
    (let ((rx (ptv-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let ((h (car rx)))
            (cond ((equal? h '(PV-VADD m)) (ptv-arg-in! (cadr rx)) (ptv-arg-in! (caddr rx))
                                           (subst (dk-cite! 'pv-vadd-value 'm (cadr rx) (caddr rx))))
                  ((equal? h '(PV-VNEG m)) (ptv-arg-in! (cadr rx)) (subst (dk-cite! 'pv-vneg-value 'm (cadr rx))))
                  ((equal? h '(PV-ACT m)) (ptv-real! (cadr rx)) (ptv-arg-in! (caddr rx))
                                          (subst (dk-cite! 'pv-act-value 'm (cadr rx) (caddr rx))))
                  ((equal? h '(ADD (SCAL m))) (subst (ptv-scalar-eq! 'ADD (cadr rx) (caddr rx))))
                  (#t (subst (ptv-scalar-eq! 'MUL (cadr rx) (caddr rx)))))
            (loop (- fuel 1)))))))
;; the first coordinate: (= A B) of vectors by one law of m at the head of A, then rfl
(define (ptv-vclose!)
  (let* ((g (dk-goal)) (a (cadr g)) (vadd? (lambda (t) (and (pair? t) (equal? (car t) '(VADD m)))))
         (act? (lambda (t) (and (pair? t) (equal? (car t) '(ACT m))))))
    (ptv-vtype! a) (ptv-vtype! (caddr g))
    (cond ((and (vadd? a) (vadd? (cadr a)) (not (equal? (caddr g) (list '(VADD m) (caddr a) (cadr a)))))
           (subst (dk-cite! 'rmod-vadd-assoc 'm (cadr (cadr a)) (caddr (cadr a)) (caddr a))))
          ((and (vadd? a) (equal? (caddr a) '(VZERO m))) (subst (dk-cite! 'rmod-vzero-right 'm (cadr a))))
          ((and (vadd? a) (equal? (cadr a) '(VZERO m))) (subst (dk-cite! 'rmod-vzero-left 'm (caddr a))))
          ((and (vadd? a) (equal? (caddr a) (list '(VNEG m) (cadr a))))
           (subst (dk-cite! 'rmod-vadd-comm 'm (cadr a) (caddr a)))
           (subst (dk-cite! 'rmod-vneg-left 'm (cadr a))))
          ((and (vadd? a) (equal? (cadr a) (list '(VNEG m) (caddr a)))) (subst (dk-cite! 'rmod-vneg-left 'm (caddr a))))
          ((vadd? a) (subst (dk-cite! 'rmod-vadd-comm 'm (cadr a) (caddr a))))
          ((and (act? a) (vadd? (caddr a))) (subst (dk-cite! 'rmod-act-distrib 'm (cadr a) (cadr (caddr a)) (caddr (caddr a)))))
          ((and (act? a) (dk-head-is? (cadr a) '+)) (subst (dk-cite! 'rmod-act-add 'm (cadr (cadr a)) (caddr (cadr a)) (caddr a))))
          ((and (act? a) (dk-head-is? (cadr a) '*)) (subst (dk-cite! 'rmod-act-mul 'm (cadr (cadr a)) (caddr (cadr a)) (caddr a))))
          ((and (act? a) (equal? (cadr a) 1)) (subst (dk-cite! 'rmod-act-one 'm (caddr a))))
          (#t (error "ptv-vclose!: no law for" (expression->string g))))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
        (begin (ptv-vtype! (caddr (dk-goal))) (rfl)))))
;; close (= (LIST A1 A2) (LIST B1 B2)) componentwise
(define (ptv-pair-close!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g))
         (a1 (cadr l)) (a2 (caddr l)) (b1 (cadr r)) (b2 (caddr r)))
    (if (not (equal? a1 b1))
        (begin (dk-have! (list '= a1 b1) ptv-vclose!) (subst (list '= a1 b1))))
    (if (not (equal? a2 b2))
        (begin (ptv-real! a2) (ptv-real! b2) (dk-have! (list '= a2 b2) (lambda () (crs))) (subst (list '= a2 b2))))
    (ptv-pair-in! r)
    (rfl)))
;; a law leaf: peel the variables, open them, normalise, close componentwise (a conjunction leaf: each)
(define (ptv-leaf!)
  (let* ((lk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!) '()))
         (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ptv-C))) lk)))
         (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL m))))) lk))))
    (ptv-carr-rr!)
    (for-each (lambda (r) (dk-rewrite-h! (list 'IN r '(CARR (SCAL m))) '(CARR (SCAL m)) 'RR)) rs)
    (for-each ptv-open! xs)
    (let ((one! (lambda ()
                  (for-each (lambda (x) (subst (list '= x (list 'LIST (ptv-n1 x) (ptv-n2 x))))) (filter (lambda (x) (dk--occurs? x (dk-goal))) xs))
                  (ptv-norm!)
                  (ptv-pair-close!))))
      (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! one!) (one!)))))
(define ptv-M '(PROD-RMOD m))
(define ptv-MV '(VEC (PROD-RMOD m)))
(define ptv-MC '(CARR (SCAL (PROD-RMOD m))))
(define (ptv-MO op) (list op ptv-M))
(define (ptv-law! name body pred)
  (sp (make-wff (ptv-stmt '() '() body)))
  (ptv-hdr!)
  (ptv-subst-readoffs!)
  (if pred (mac pred))
  (ptv-leaf!)
  (ptv-qed! name))
(ptv-law! 'prod-rmod-assoc (list 'is-associative (ptv-MO 'VADD) ptv-MV) 'is-associative)
(ptv-law! 'prod-rmod-comm (list 'is-commutative (ptv-MO 'VADD) ptv-MV) 'is-commutative)
(ptv-law! 'prod-rmod-identity (list 'is-identity (ptv-MO 'VADD) (ptv-MO 'VZERO) ptv-MV) 'is-identity)
(ptv-law! 'prod-rmod-inverses (list 'has-inverses (ptv-MO 'VADD) (ptv-MO 'VZERO) (ptv-MO 'VNEG) ptv-MV) 'has-inverses)
(ptv-law! 'prod-rmod-act-distrib-vec
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ ptv-MC)
    (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ ptv-MV) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ ptv-MV)
      (list '= (list (ptv-MO 'ACT) 'r_ (list (ptv-MO 'VADD) 'x_ 'y_))
               (list (ptv-MO 'VADD) (list (ptv-MO 'ACT) 'r_ 'x_) (list (ptv-MO 'ACT) 'r_ 'y_)))))))))
  #f)
(ptv-law! 'prod-rmod-act-distrib-scalar
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ ptv-MC)
    (list 'FORALL 's_ (list 'IMPLIES (list 'IN 's_ ptv-MC) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ ptv-MV)
      (list '= (list (ptv-MO 'ACT) (list (list 'ADD (list 'SCAL ptv-M)) 'r_ 's_) 'x_)
               (list (ptv-MO 'VADD) (list (ptv-MO 'ACT) 'r_ 'x_) (list (ptv-MO 'ACT) 's_ 'x_)))))))))
  #f)
(ptv-law! 'prod-rmod-act-mul-compat
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ ptv-MC)
    (list 'FORALL 's_ (list 'IMPLIES (list 'IN 's_ ptv-MC) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ ptv-MV)
      (list '= (list (ptv-MO 'ACT) (list (list 'MUL (list 'SCAL ptv-M)) 'r_ 's_) 'x_)
               (list (ptv-MO 'ACT) 'r_ (list (ptv-MO 'ACT) 's_ 'x_)))))))))
  #f)
(ptv-law! 'prod-rmod-act-unital
  (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ ptv-MV)
     (list '= (list (ptv-MO 'ACT) (list 'ONE (list 'SCAL ptv-M)) 'x_) 'x_)))
  #f)

;;; THE MODULE E x R.
(sp (make-wff (ptv-stmt '() '() (list 'IS-MODULE ptv-M))))
(ptv-hdr!)
(for-each (lambda (n) (fact n 'm))
  '(prod-rmod-assoc prod-rmod-comm prod-rmod-identity prod-rmod-inverses
    prod-rmod-act-distrib-vec prod-rmod-act-distrib-scalar prod-rmod-act-mul-compat prod-rmod-act-unital
    pv-vadd-fun pv-vneg-fun pv-act-fun))
(mac 'IS-MODULE)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (ptv-subst-readoffs!)
          (cond ((dk-ass!) #t)
                ((dk-contains? (dk-goal) 'LENGTH) (mac 'PROD-RMOD) (len-r) (if (not (proof-done? *ps*)) (arith)))
                ((dk-contains? (dk-goal) 'VZERO) (ptv-pair-in! (cadr (dk-goal))) (ass))
                (#t (error "prod-rmod-is-module: unexpected conjunct" (expression->string (dk-goal)))))))))
(ptv-qed! 'prod-rmod-is-module)

;;; ===========================================================================
;;; (B) THE PRODUCT TOPOLOGY
;;; ===========================================================================
(define ptv-P '(CARTESIAN (PTS t) RR))
(define (ptv-box v c e) (list 'PT-BOX 't v c e))
(define (ptv-dist z c) (list 'abs (list '- (ptv-n2 z) c)))
(define (ptv-box-rhs z v c e)
  (list 'AND (list 'IN z ptv-P) (list 'AND (list 'IN (ptv-n1 z) v) (list '< (ptv-dist z c) e))))
(define (ptv-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (ptv-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
;; the facts of IS-TOP-SPACE(t) the proofs use, and PTS(t), P sets
(define (ptv-top!)
  (if (not (dk-asm? '(IN (PTS t) (OPENS t))))
      (begin
        (dk-project! '(IN (PTS t) (OPENS t)) 'is-top-space '(IS-TOP-SPACE t))
        (dk-project! '(IN EMPTY-SET (OPENS t)) 'is-top-space '(IS-TOP-SPACE t))
        (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t)) (IN (INTERSECTION u v) (OPENS t))))))
                     'is-top-space '(IS-TOP-SPACE t))
        (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
        (dk-cite! 'membership-implies-sethood '(PTS t) '(OPENS t))
        (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
        (dk-have! (list 'IN ptv-P 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))))
(define (ptv-open-pt! w a1)            ; a1 in w, w in OPENS t  =>  a1 in PTS t
  (let ((ty (list 'IN a1 '(PTS t))))
    (if (not (dk-asm? ty))
        (begin (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) w)
