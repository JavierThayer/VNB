  (let* ((h (list 'IS-PT-OPEN 't u))
         (iff (dk-cite! 'is-pt-open 't u))
         (rhs (caddr iff)))
    (dk-have! (cadr rhs) (lambda () (mac-h 'IS-PT-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (dk-have! (caddr rhs) (lambda () (mac-h 'IS-PT-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (caddr rhs)))
;;; from the universal part at X in u: skolemise (V . e)
