         (let* ((ld (dk-peel!))
                (fv (cadr (car (filter (lambda (f) (dk-head-is? f 'SUBSET)) ld)))))
           (dk-have! (list 'FORALL 'tow_ (list 'IMPLIES (list 'IN 'tow_ fv) '(IS-PT-OPEN t tow_)))
             (lambda ()
               (let ((w (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                 (dk-cite! 'subset-mem-fwd fv ptv-opens w)
                 (ptv-open-of-mem! w)
                 (dk-ass!))))
           (dk-cite! 'pt-open-union 't fv)
           (ptv-into-opens! (list 'BIG-UNION 'u fv 'u))))))))
(ptv-qed! 'prod-top-is-top-space)

