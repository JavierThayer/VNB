        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))))
(sp (make-wff (ptv-alls '(t fam)
  (ptv-imps '((IS-TOP-SPACE t) (FORALL tow_ (IMPLIES (IN tow_ fam) (IS-PT-OPEN t tow_))))
    '(IS-PT-OPEN t (BIG-UNION u fam u))))))
(dk-peel!)
(ptv-top!)
(let ((hall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-PT-OPEN))) "the opens"))
      (bu '(BIG-UNION u fam u)))
  (mac 'is-pt-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let* ((w (dk-di-var!))
                   (landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
              (inst*! hall e)
              (ptv-open-parts! e)
              (dk-cite! 'subset-mem-fwd e ptv-P w)
              (dk-ass!)))
          (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                 (landed (dk-landed (lambda () (bu-me (list 'IN x bu)))))
                 (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
            (inst*! hall e)
            (let* ((ae (ptv-open-parts! e))
                   (pr (ptv-basic! ae x)) (v (car pr)) (eps (cdr pr)))
              (ptv-subset! e bu (lambda (w) (ptv-bu-in-imp! w e bu)))
              (dk-cite! 'subset-trans (ptv-box v (ptv-n2 x) eps) e bu)
              (ew v)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (ew eps) (dk-conj-close! dk-ass!)))))))))))
