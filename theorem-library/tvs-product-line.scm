;;; (B3) Hausdorff
;; (= (INTERSECTION u v) EMPTY-SET), given ABSURD! that derives FALSITY from (IN w u), (IN w v)
(define (ptv-empty-inter! u v absurd!)
  (let ((ii (list 'INTERSECTION u v)))
    (dk-have! (list '= ii 'EMPTY-SET)
      (lambda ()
        (dk-have! (list 'FORALL 'hx_ (list 'IFF (list 'IN 'hx_ ii) '(IN hx_ EMPTY-SET)))
          (lambda ()
            (let ((w (begin (di) (cadr (cadr (dk-goal))))))
              (dk-iff! (lambda (g) (or (equal? g (list 'IN w 'EMPTY-SET))
                                       (and (dk-head-is? g 'IMPLIES) (equal? (caddr g) (list 'IN w 'EMPTY-SET)))))
                (lambda ()
                  (dk-peel!)
                  (let ((im (dk-cite! 'intersection-membership u v w)))
                    (dk-have! (list 'IN w u) (lambda () (if (dk-only! im (list 'IN w ii)) (prop))))
                    (dk-have! (list 'IN w v) (lambda () (if (dk-only! im (list 'IN w ii)) (prop)))))
                  (pbc)
                  (absurd! w))
                (lambda ()
                  (dk-peel!)
                  (dk-cite! 'empty-set-has-no-members w)
                  (ai (list 'NOT (list 'IN w 'EMPTY-SET))))))))
        (dk-cite! 'class-extensionality ii 'EMPTY-SET)
        (dk-ass!)))))
(define (ptv-zero-dist! a2)            ; |a2 - a2| = 0 < r style facts: lands (= (abs (- a2 a2)) 0)
  (let ((e (list '= (list 'abs (list '- a2 a2)) 0)))
    (if (not (dk-asm? e))
        (begin
          (ptv-real! (list '- a2 a2))
          (ptv-eq! (list '- a2 a2) 0)
          (dk-cite! 'rr-abs-zero-value)
          (dk-have! e (lambda () (subst (list '= (list '- a2 a2) 0)) (ass)))))
    e))
(sp (make-wff (ptv-alls '(t) (ptv-imps '((IS-HAUSDORFF t)) (list 'IS-HAUSDORFF ptv-top)))))
(dk-peel!)
(dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
(ptv-top!)
(let ((hs (dk-project! (forall-guarded '(a b) (list '(IN a (PTS t)) '(IN b (PTS t)) '(NOT (== a b)))
                         (list 'FORSOME 'u (list 'FORSOME 'v (conjuncts->and (list '(IN u (OPENS t)) '(IN v (OPENS t)) '(IN a u) '(IN b v)
                                                                                 '(== (INTERSECTION u v) EMPTY-SET))))))
                       'is-hausdorff '(IS-HAUSDORFF t))))
  (dk-cite! 'prod-top-is-top-space 't)
  (dk-cite! 'prod-top-pts 't)
  (dk-cite! 'prod-top-opens 't)
  (ptv-pos1!)
  (mac 'is-hausdorff)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (subst (list '== (list 'PTS ptv-top) ptv-P))
            (let* ((ld (dk-peel!))
                   (ne (car (filter (lambda (f) (dk-head-is? f 'NOT)) ld)))
                   (a (cadr (cadr ne))) (b (caddr (cadr ne)))
                   (a1 (ptv-n1 a)) (a2 (ptv-n2 a)) (b1 (ptv-n1 b)) (b2 (ptv-n2 b))
                   (finish! (lambda (u v)          ; u, v open in the product, a in u, b in v, u meet v = 0 in context
                              (ew u) (ew v)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-ass!))
                                      (begin (subst (list '= (list 'INTERSECTION u v) 'EMPTY-SET)) (qrfl))))))))
              (ptv-p-open! a) (ptv-p-open! b)
              (use-em (list '= a1 b1)
                (lambda ()
                  ;; the second coordinates differ
                  (dk-have! (list 'NOT (list '= a2 b2))
                    (lambda ()
                      (di)
                      (dk-cite! 'cartesian-pair-eq a '(PTS t) 'RR)
                      (dk-cite! 'cartesian-pair-eq b '(PTS t) 'RR)
                      (dk-have! (list '= a b)
                        (lambda () (subst (list '= a (list 'LIST a1 a2))) (subst (list '= b (list 'LIST b1 b2)))
                                   (subst (list '= a1 b1)) (subst (list '= a2 b2))
                                   (dk-cite! 'pair-in-cartesian '(PTS t) 'RR b1 b2) (rfl)))
                      (dk-have! (list '== a b) (lambda () (subst (list '= a b)) (qrfl)))
                      (ai ne)))
                  (let* ((dab (list '- a2 b2)) (d (list 'abs dab)) (r (list '* 1/2 d)))
                    (ptv-real! d) (ptv-real! r)
                    (dk-cite! 'rr-abs-nonneg dab)
                    (let ((iff (dk-cite! 'rr-abs-zero dab)))
                      (dk-have! (list 'NOT (list '= dab 0))
                        (lambda () (di) (dk-have! (list '= a2 b2) (lambda () (dk-ineq! (list '= dab 0) (list 'IN a2 'RR) (list 'IN b2 'RR))))
                                   (ai (list 'NOT (list '= a2 b2)))))
                      (dk-have! (list 'NOT (list '= d 0)) (lambda () (dk-only! iff (list 'NOT (list '= dab 0))) (prop))))
                    (dk-cite! 'dual-rr-pos-of-nonneg-nonzero d)
                    (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
                    (dk-cite! 'rr-pos-rr-of-lt r)
                    (let ((u (ptv-box '(PTS t) a2 r)) (v (ptv-box '(PTS t) b2 r)))
                      (dk-cite! 'pt-box-open 't '(PTS t) a2 r)
                      (dk-cite! 'pt-box-open 't '(PTS t) b2 r)
                      (ptv-zero-dist! a2) (ptv-zero-dist! b2)
                      (ptv-real! (ptv-dist a a2)) (ptv-real! (ptv-dist b b2))
                      (dk-have! (list '< (ptv-dist a a2) r) (lambda () (dk-ineq! (list '= (ptv-dist a a2) 0) (list '< 0 r) (list 'IN r 'RR))))
                      (dk-have! (list '< (ptv-dist b b2) r) (lambda () (dk-ineq! (list '= (ptv-dist b b2) 0) (list '< 0 r) (list 'IN r 'RR))))
                      (dk-have! (list 'IN a u) (lambda () (ptv-box-intro! a '(PTS t) a2 r)))
                      (dk-have! (list 'IN b v) (lambda () (ptv-box-intro! b '(PTS t) b2 r)))
                      (ptv-empty-inter! u v
                        (lambda (w)
                          (ptv-box-elim! w '(PTS t) a2 r)
                          (ptv-box-elim! w '(PTS t) b2 r)
                          (ptv-p-open! w)
                          (let* ((w2 (ptv-n2 w))
                                 (tri (ptv-tri! a2 w2 b2)))
                            (ptv-real! (list '- w2 a2)) (ptv-real! (list '- a2 w2))
                            (dk-cite! 'rr-abs-sub-sym a2 w2)
                            (ptv-real! (ptv-dist w a2)) (ptv-real! (ptv-dist w b2)) (ptv-real! (list 'abs (list '- a2 w2)))
                            (dk-absurd! tri (list '= (list 'abs (list '- a2 w2)) (list 'abs (list '- w2 a2)))
                                        (list '< (ptv-dist w a2) r) (list '< (ptv-dist w b2) r)
                                        (list 'IN d 'RR) (list 'IN r 'RR)
                                        (list 'IN (ptv-dist w a2) 'RR) (list 'IN (ptv-dist w b2) 'RR)
                                        (list 'IN (list 'abs (list '- a2 w2)) 'RR)))))
                      (finish! u v))))
                (lambda ()
                  ;; the first coordinates differ: separate them in t
                  (dk-have! (list 'NOT (list '== a1 b1))
                    (lambda () (di) (dk-have! (list '= a1 b1) (lambda () (subst (list '== a1 b1)) (rfl))) (ai (list 'NOT (list '= a1 b1)))))
                  (let* ((u0 (dk-skolem! (dk-apply! hs a1 b1) 'top))
                         (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u0))) "the second open set"))
                         (v0 (dk-skolem! ex #t))
                         (u (ptv-box u0 a2 1)) (v (ptv-box v0 b2 1)))
                    (dk-cite! 'pt-box-open 't u0 a2 1)
                    (dk-cite! 'pt-box-open 't v0 b2 1)
                    (fact 'rr-one-in)
                    (ptv-zero-dist! a2) (ptv-zero-dist! b2)
                    (ptv-real! (ptv-dist a a2)) (ptv-real! (ptv-dist b b2))
                    (dk-have! (list '< (ptv-dist a a2) 1) (lambda () (dk-ineq! (list '= (ptv-dist a a2) 0))))
                    (dk-have! (list '< (ptv-dist b b2) 1) (lambda () (dk-ineq! (list '= (ptv-dist b b2) 0))))
                    (dk-have! (list 'IN a u) (lambda () (ptv-box-intro! a u0 a2 1)))
                    (dk-have! (list 'IN b v) (lambda () (ptv-box-intro! b v0 b2 1)))
                    (ptv-empty-inter! u v
                      (lambda (w)
                        (ptv-box-elim! w u0 a2 1)
                        (ptv-box-elim! w v0 b2 1)
                        (let ((w1 (ptv-n1 w)))
                          (dk-have! (list 'IN w1 (list 'INTERSECTION u0 v0))
                            (lambda () (let ((im (dk-cite! 'intersection-membership u0 v0 w1)))
                                         (if (dk-only! im (list 'IN w1 u0) (list 'IN w1 v0)) (prop)))))
                          (dk-rewrite-h! (list 'IN w1 (list 'INTERSECTION u0 v0)) (list 'INTERSECTION u0 v0) 'EMPTY-SET)
                          (dk-cite! 'empty-set-has-no-members w1)
                          (ai (list 'NOT (list 'IN w1 'EMPTY-SET))))))
                    (finish! u v))))))))))
(ptv-qed! 'prod-top-hausdorff)

;;; ===========================================================================
;;; (C) E x R IS A TOPOLOGICAL VECTOR SPACE
