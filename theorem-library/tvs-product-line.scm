;;; (B2) a box around an open set is open
;; |z2 - c| <= |z2 - w2| + |w2 - c|, landed; returns it
(define (ptv-tri! z2 w2 c)
  (let* ((d1 (list '- z2 w2)) (d2 (list '- w2 c)) (d (list '- z2 c))
         (concl (list '<= (list 'abs d) (list '+ (list 'abs d1) (list 'abs d2)))))
    (if (not (dk-asm? concl))
        (begin
          (ptv-real! d1) (ptv-real! d2) (ptv-real! d) (ptv-real! (list 'abs d))
          (ptv-real! (list 'abs d1)) (ptv-real! (list 'abs d2))
          (let* ((tri (dk-cite! 'rr-abs-triangle-c d1 d2))
                 (e (ptv-eq! (list '+ d1 d2) d)))
            (dk-rewrite-h! tri (list '+ d1 d2) d))))
    concl))
(sp (make-wff (ptv-alls '(t v c e)
  (ptv-imps '((IS-TOP-SPACE t) (IN v (OPENS t)) (IN c RR) (POS-RR e))
    (list 'IN (ptv-box 'v 'c 'e) (list 'OPENS ptv-top))))))
(dk-peel!)
(ptv-top!)
(dk-cite! 'rr-pos-rr-in-rr 'e) (dk-cite! 'rr-lt-of-pos-rr 'e)
(dk-cite! 'prod-top-opens 't)
(subst (list '== (list 'OPENS ptv-top) ptv-opens))
(let ((bx (ptv-box 'v 'c 'e)))
  (dk-have! (list 'IS-PT-OPEN 't bx)
    (lambda ()
      (mac 'is-pt-open)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'SUBSET)
              (begin (mac 'subset-def) (let ((w (dk-di-var!))) (ptv-box-elim! w 'v 'c 'e) (ass)))
              (let* ((w (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                (ptv-box-elim! w 'v 'c 'e)
                (ptv-p-open! w)
                (let* ((dw (ptv-dist w 'c)) (e2 (list '- 'e dw)))
                  (ptv-real! dw) (ptv-real! e2)
                  (dk-have! (list '< 0 e2) (lambda () (dk-ineq! (list '< dw 'e) (list 'IN dw 'RR) '(IN e RR))))
                  (dk-cite! 'rr-pos-rr-of-lt e2)
                  (ew 'v)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (ew e2)
                            (dk-conj-close!
                              (lambda ()
                                (if (not (dk-ass!))
                                    (begin
                                      (mac 'subset-def)
                                      (let ((z (dk-di-var!)))
                                        (ptv-box-elim! z 'v (ptv-n2 w) e2)
                                        (ptv-p-open! z)
                                        (let ((tri (ptv-tri! (ptv-n2 z) (ptv-n2 w) 'c)))
                                          (dk-have! (list '< (ptv-dist z 'c) 'e)
                                            (lambda () (dk-ineq! tri (list '< (ptv-dist z (ptv-n2 w)) e2)
                                                                 (list 'IN (ptv-dist z 'c) 'RR) (list 'IN (ptv-dist z (ptv-n2 w)) 'RR)
                                                                 (list 'IN dw 'RR) '(IN e RR))))
                                          (ptv-box-intro! z 'v 'c 'e))))))))))))))))))
  (dk-have! (list 'SUBSET bx ptv-P) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (ptv-box-elim! w 'v 'c 'e) (ass))))
  (ptv-into-opens! bx))
(ptv-qed! 'pt-box-open)

