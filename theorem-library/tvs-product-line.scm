;;; binary intersection
(sp (make-wff (ptv-alls '(t u v)
  (ptv-imps '((IS-TOP-SPACE t) (IS-PT-OPEN t u) (IS-PT-OPEN t v)) '(IS-PT-OPEN t (INTERSECTION u v))))))
(dk-peel!)
(ptv-top!)
(let ((au (ptv-open-parts! 'u))
      (av (ptv-open-parts! 'v)))
  (mac 'is-pt-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let ((w (dk-di-var!)))
              (dk-cite! 'intersection-membership 'u 'v w)
              (dk-cite! 'subset-mem-fwd 'u ptv-P w)
              (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))
          (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                 (im (dk-cite! 'intersection-membership 'u 'v x)))
            (dk-have! (list 'IN x 'u) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (dk-have! (list 'IN x 'v) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (dk-cite! 'subset-mem-fwd 'u ptv-P x)
            (ptv-p-open! x)
            (let* ((p1 (ptv-basic! au x)) (v1 (car p1)) (e1 (cdr p1))
                   (p2 (ptv-basic! av x)) (v2 (car p2)) (e2 (cdr p2))
                   (vv (list 'INTERSECTION v1 v2))
                   (mn (list 'min e1 e2))
                   (c (ptv-n2 x)))
              (dk-apply! (dk-ctx-form '(FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t)) (IN (INTERSECTION u v) (OPENS t)))))))
                         v1 v2)
              (dk-cite! 'intersection-membership v1 v2 (ptv-n1 x))
              (dk-have! (list 'IN (ptv-n1 x) vv) (lambda () (if (dk-only! (dk-ctx-form (list 'IFF (list 'IN (ptv-n1 x) vv) (list 'AND (list 'IN (ptv-n1 x) v1) (list 'IN (ptv-n1 x) v2))))
                                                                         (list 'IN (ptv-n1 x) v1) (list 'IN (ptv-n1 x) v2)) (prop))))
              (dk-cite! 'rr-min-closed e1 e2)
              (dk-cite! 'rr-min-le-left e1 e2)
              (dk-cite! 'rr-min-le-right e1 e2)
              (fact 'rr-zero-in)
              (dk-cite! 'rr-lt-min 0 e1 e2)
              (dk-cite! 'rr-pos-rr-of-lt mn)
              (dk-have! (list 'SUBSET vv v1) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'intersection-membership v1 v2 w)
                                                                            (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
              (dk-have! (list 'SUBSET vv v2) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'intersection-membership v1 v2 w)
                                                                            (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
              (dk-cite! 'pt-box-mono 't vv v1 c mn e1)
              (dk-cite! 'pt-box-mono 't vv v2 c mn e2)
              (dk-cite! 'subset-trans (ptv-box vv c mn) (ptv-box v1 c e1) 'u)
              (dk-cite! 'subset-trans (ptv-box vv c mn) (ptv-box v2 c e2) 'v)
              (ew vv)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew mn)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (mac 'subset-def)
                                  (let ((w (dk-di-var!)))
                                    (dk-cite! 'subset-mem-fwd (ptv-box vv c mn) 'u w)
                                    (dk-cite! 'subset-mem-fwd (ptv-box vv c mn) 'v w)
                                    (dk-cite! 'intersection-membership 'u 'v w)
                                    (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
                                        (prop)))))))))))))))))
(ptv-qed! 'pt-open-inter)

;;; arbitrary unions
(define (ptv-bu-in-imp! w e bu)
