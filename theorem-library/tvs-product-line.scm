                                                (let* ((z (dk-di-var!)) (z1 (ptv-n1 z)) (z2 (ptv-n2 z)))
                                                  (ptv-box-elim! z vv w2 h)
                                                  (ptv-p-open! z)
                                                  (ptv-p2c! z)
                                                  (ptv-p2v! z1)
                                                  (let* ((pz (ptv-pval! z1))
                                                         (im2 (dk-cite! 'preimage-membership 't 'p hl z1)))
                                                    (dk-have! (list 'IN pz hl) (lambda () (if (dk-only! im2 (list 'IN z1 vv)) (prop))))
                                                    (sep-me (list 'IN pz hl)) (dk-split-all!)
                                                    (ptv-real! (list '- z2 w2))
                                                    (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts (list '- z2 w2) h)))
                                                    (dk-have! (list '< pz z2)
                                                      (lambda () (dk-ineq! (list '< pz c) (list '< (list '- h) (list '- z2 w2))
                                                                           (list 'IN pz 'RR) (list 'IN pw 'RR) (list 'IN z2 'RR) (list 'IN w2 'RR))))
                                                    (ptv-ep-intro! z))))))))))))))))))
            (subst (list '== (list 'OPENS ptv-top) ptv-opens))
            (ptv-into-opens! ptv-EP))
          ;; CONVEX
          (begin
            (mac 'is-convex-subset)
            (ptv-subst-readoffs!)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'SUBSET)
                    (begin (mac 'subset-def) (let ((z (dk-di-var!))) (ptv-ep-elim! z) (ass)))
                    (let* ((lk (dk-peel!))
                           (ab (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ptv-EP))) lk)))
                           (a (car ab)) (b (cadr ab))
                           (th (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk)))
                           (s (list '- 1 th))
                           (a1 (ptv-n1 a)) (a2 (ptv-n2 a)) (b1 (ptv-n1 b)) (b2 (ptv-n2 b)))
                      (ptv-ep-elim! a) (ptv-ep-elim! b)
                      (ptv-open! a) (ptv-open! b)
                      (ptv-real! s)
                      (ptv-norm!)
                      (let* ((g (dk-goal)) (z (cadr g)) (x (cadr z)) (y (caddr z))
                             (x2 (list '(VADD m) (list '(ACT m) th b1) (list '(ACT m) s a1))))
                        (ptv-pair-in! z)
                        (subst (list '== ptv-EP ptv-EPB))
                        (in-sep! (lambda () (ass))
                          (lambda ()
                            (nth-r)
                            (ptv-vtype! x) (ptv-vtype! x2)
                            (subst (dk-cite! 'rmod-vadd-comm 'm (cadr x) (caddr x)))
                            (let* ((ci (dk-apply! cvx b1 a1 th))
                                   (pa (ptv-pval! a1)) (pb (ptv-pval! b1)) (px (ptv-pval! x2))
                                   (st (dk-cite! 'rr-convex-comb-strict th a2 b2 pa pb))
                                   (ll (list '+ (list '* th pb) (list '* s pa)))
                                   (rr (list '+ (list '* th b2) (list '* s a2))))
                              (ptv-real! ll) (ptv-real! rr) (ptv-real! y)
                              (subst (ptv-eq! y rr))
                              (let* ((nl (dk-name! ll)) (nr (dk-name! rr)))
                                (dk-rewrite-h! (dk-ctx-form (list '<= px ll)) ll nl)
                                (dk-rewrite-h! (dk-ctx-form (list '< ll rr)) ll nl)
                                (dk-rewrite-h! (dk-ctx-form (list '< nl rr)) rr nr)
                                (subst (list '= rr nr))
                                (dk-ineq! (list '<= px nl) (list '< nl nr) (list 'IN px 'RR) (list 'IN nl 'RR) (list 'IN nr 'RR))))))))))))))))
(ptv-qed! 'strict-epigraph-open-convex)
