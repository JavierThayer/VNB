;;; the two slots of PROD-TOP
(define ptv-opens (list 'SEP 'ptu_ (list 'POWER ptv-P) '(IS-PT-OPEN t ptu_)))
(define ptv-top '(PROD-TOP t))
(define (ptv-slot! name acc val)
  (dk-sp-qed! (make-wff (ptv-alls '(t) (ptv-imps '((IS-TOP-SPACE t)) (list '== (list acc ptv-top) val))))
    (lambda ()
      (dk-peel!)
      (ptv-top!)
      (dk-cite! 'power-set ptv-P)
      (mac 'PROD-TOP)
      (slot acc)
      (nth-r)
      (if (and (not (proof-done? *ps*)) (dk-contains? (dk-goal) acc)) (slot acc))
      (if (not (proof-done? *ps*)) (qrfl)))
    name)
  (topic! name 'analysis))
(ptv-slot! 'prod-top-pts 'PTS ptv-P)
(ptv-slot! 'prod-top-opens 'OPENS ptv-opens)

(define (ptv-pow-of-open! x)
  (if (not (dk-asm? (list 'IN x (list 'POWER ptv-P))))
      (begin
        (ptv-open-parts! x)
        (dk-cite! 'subclass-of-set-is-set x ptv-P)
        (let ((s (caddr (dk-cite! 'subset-def x ptv-P))))
          (dk-have! s (lambda () (mac-h 'subset-def (list 'SUBSET x ptv-P)) (ass))))
        (dk-cite! 'power-mem-intro ptv-P x))))
(define (ptv-open-of-mem! w)
  (let ((c (list 'IS-PT-OPEN 't w)))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN w ptv-opens))) (dk-split-all!) (ass))))))
(define (ptv-into-opens! x)
  (ptv-pow-of-open! x)
  (in-sep! (lambda () (ass)) (lambda () (ass))))

(sp (make-wff (ptv-alls '(t) (ptv-imps '((IS-TOP-SPACE t)) (list 'IS-TOP-SPACE ptv-top)))))
(dk-peel!)
(ptv-top!)
(dk-cite! 'prod-top-pts 't)
(dk-cite! 'prod-top-opens 't)
(dk-cite! 'power-set ptv-P)
(dk-have! (list 'IN ptv-opens 'SET) (lambda () (sep-set) (ass)))
(dk-cite! 'empty-set-is-set)
(dk-cite! 'pt-open-empty 't)
(dk-cite! 'pt-open-whole 't)
(mac 'is-top-space)
(subst (list '== (list 'PTS ptv-top) ptv-P))
(subst (list '== (list 'OPENS ptv-top) ptv-opens))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g0 '=) (mac 'PROD-TOP) (len-r) (arith))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) ptv-opens))
         (mac 'power-set-membership)
         (dk-conj-close!
           (lambda ()
             (if (not (dk-ass!))
                 (let ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (sep-me (dk-ctx-form (list 'IN z ptv-opens)))
                   (dk-split-all!)
                   (ass))))))
        ((and (dk-head-is? g0 'IN) (memq (cadr g0) '(EMPTY-SET)))
         (fact 'empty-subset-any ptv-P)
         (ptv-into-opens! 'EMPTY-SET))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) ptv-P))
         (ptv-into-opens! ptv-P))
        ((dk-contains? g0 'INTERSECTION)
         (let* ((ld (dk-peel!))
                (uv (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld)))
                (u (car uv)) (v (cadr uv)))
           (ptv-open-of-mem! u)
           (ptv-open-of-mem! v)
           (dk-cite! 'pt-open-inter 't u v)
