(define ptv-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define ptv-addc0
  (forall-guarded '(tvx_ tvy_ tvu_)
    '((IN tvx_ (VEC m)) (IN tvy_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((VADD m) tvx_ tvy_) tvu_))
    '(FORSOME tvv_ (AND (IN tvv_ (OPENS t)) (AND (IN tvx_ tvv_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvy_ tvw_)
         (FORALL tva_ (IMPLIES (IN tva_ tvv_) (FORALL tvb_ (IMPLIES (IN tvb_ tvw_)
           (IN ((VADD m) tva_ tvb_) tvu_)))))))))))))
(define ptv-scalc0
  (forall-guarded '(tvr_ tvx_ tvu_)
    '((IN tvr_ (CARR (SCAL m))) (IN tvx_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((ACT m) tvr_ tvx_) tvu_))
    '(FORSOME tvd_ (AND (POS-RR tvd_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvx_ tvw_)
         (FORALL tvs_ (IMPLIES (IN tvs_ (CARR (SCAL m)))
           (IMPLIES (< ((FNRM RR-NORMED-FIELD) ((ADD (SCAL m)) tvs_ ((NEG (SCAL m)) tvr_))) tvd_)
             (FORALL tva_ (IMPLIES (IN tva_ tvw_) (IN ((ACT m) tvs_ tva_) tvu_)))))))))))))
(define (ptv-tsub e)
  (cond ((equal? e '(VEC m)) ptv-C)
        ((equal? e '(OPENS t)) (list 'OPENS ptv-top))
        ((equal? e '(VADD m)) '(PV-VADD m))
        ((equal? e '(ACT m)) '(PV-ACT m))
        ((pair? e) (map ptv-tsub e))
        (#t e)))
(define (ptv-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs ptv-tvs)
        (dk-project! (list '= '(SCAL m) ptv-ring) 'is-tvs ptv-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs ptv-tvs)
        (dk-project! ptv-addc0 'is-tvs ptv-tvs)
        (dk-project! ptv-scalc0 'is-tvs ptv-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs ptv-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (ptv-top!)
        (ptv-sets!)
        (dk-cite! 'prod-top-opens 't))))
;; x in C (vectors) => x in P (points), and back
(define (ptv-c2p! x)
  (let ((ty (list 'IN x ptv-P)))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst '(== (PTS t) (VEC m))) (ass))))
    ty))
(define (ptv-p2c! x)
  (let ((ty (list 'IN x ptv-C)))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst '(== (VEC m) (PTS t))) (ass))))
    ty))
(define (ptv-v2p! a)                   ; a in VEC m => a in PTS t
  (let ((ty (list 'IN a '(PTS t))))
    (if (not (dk-asm? ty)) (dk-have! ty (lambda () (subst '(== (PTS t) (VEC m))) (ass))))
    ty))
(define (ptv-p2v! a)
  (let ((ty (list 'IN a '(VEC m))))
    (if (not (dk-asm? ty)) (dk-have! ty (lambda () (subst '(== (VEC m) (PTS t))) (ass))))
    ty))
;; u in OPENS(PROD-TOP t): its universal part
(define (ptv-open-all! u)
  (dk-have! (list 'IS-PT-OPEN 't u)
    (lambda ()
      (let ((h (dk-rewrite-h! (list 'IN u (list 'OPENS ptv-top)) (list 'OPENS ptv-top) ptv-opens)))
        (sep-me h) (dk-split-all!) (ass))))
  (ptv-open-parts! u))
;; goal (IN (LIST A B) (PT-BOX t v c e)); (IN A v), (IN A (PTS t)), (IN B RR), (< (abs (- B c)) e) in context
(define (ptv-in-box-list! a b v c e)
  (let ((z (list 'LIST a b)))
    (dk-cite! 'pair-in-cartesian '(PTS t) 'RR a b)
    (dk-have! (list 'IN (list 'NTH 1 z) v) (lambda () (nth-r) (ass)))
    (dk-have! (list '< (list 'abs (list '- (list 'NTH 2 z) c)) e) (lambda () (nth-r) (ass)))
    (ptv-box-intro! z v c e)))
;; the half of a positive real: lands (POS-RR h), (< 0 h), (IN h RR) for h = 1/2 e
(define (ptv-half! e)
  (let ((h (list '* 1/2 e)))
    (ptv-real! h)
    (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
    (dk-cite! 'rr-pos-rr-of-lt h)
    h))
;; with (IN s u) and an equation (= s s') in context: the basic box of u at s'
(define (ptv-basic-at! u s s2)
  (let* ((all (ptv-open-all! u))
         (h (if (equal? s s2) (list 'IN s u) (dk-rewrite-h! (list 'IN s u) s s2)))
         (pr (ptv-basic! all s2)))
    pr))

(sp (make-wff (ptv-alls '(m t) (ptv-imps (list ptv-tvs) (ptv-tsub ptv-addc0)))))
(dk-peel!)
(ptv-tvs-parts!)
(let* ((ld (filter (lambda (f) (dk-head-is? f 'IN)) (dk-asms)))
       (x (cadr (find-first (lambda (f) (and (equal? (caddr f) ptv-C) (not (eq? (cadr f) 'tvy_)))) ld)))
       (y (cadr (find-first (lambda (f) (and (equal? (caddr f) ptv-C) (not (equal? (cadr f) x)))) ld)))
       (u (cadr (find-first (lambda (f) (equal? (caddr f) (list 'OPENS ptv-top))) ld)))
       (x1 (ptv-n1 x)) (x2 (ptv-n2 x)) (y1 (ptv-n1 y)) (y2 (ptv-n2 y))
       (s (list '(PV-VADD m) x y))
       (s1 (list '(VADD m) x1 y1)) (s2 (list '+ x2 y2))
       (sl (list 'LIST s1 s2)))
  (ptv-open! x) (ptv-open! y)
  (dk-cite! 'pv-vadd-value 'm x y)
  (let* ((pr (ptv-basic-at! u s sl)) (v0 (car pr)) (e (cdr pr)))
    (dk-nth-h! (list 'IN (list 'NTH 1 sl) v0))
    (dk-nth-h! (list 'SUBSET (ptv-box v0 (list 'NTH 2 sl) e) u))
    (ptv-vtype! s1)
    (let* ((ex (dk-apply! ptv-addc0 x1 y1 v0))
           (v1 (dk-skolem! ex #t))
           (w1 (let ((ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_))) (dk-asms))))
                 (if ex2 (dk-skolem! ex2 #t)
                     (cadr (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) y1) (symbol? (caddr f)) (not (eq? (caddr f) v1))
                                                          (dk-asm? (list 'IN (caddr f) '(OPENS t)))))
                                          "W"))))))
           (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v1) (dk-contains? f w1) (dk-contains? f v0))) "the sum clause"))
           (h (ptv-half! e))
           (bv (ptv-box v1 x2 h)) (bw (ptv-box w1 y2 h)))
      (dk-cite! 'pt-box-open 't v1 x2 h)
      (dk-cite! 'pt-box-open 't w1 y2 h)
      (ptv-c2p! x) (ptv-c2p! y)
      (ptv-zero-dist! x2) (ptv-zero-dist! y2)
      (ptv-real! (ptv-dist x x2)) (ptv-real! (ptv-dist y y2))
      (dk-have! (list '< (ptv-dist x x2) h) (lambda () (dk-ineq! (list '= (ptv-dist x x2) 0) (list '< 0 h) (list 'IN h 'RR))))
      (dk-have! (list '< (ptv-dist y y2) h) (lambda () (dk-ineq! (list '= (ptv-dist y y2) 0) (list '< 0 h) (list 'IN h 'RR))))
      (dk-have! (list 'IN x bv) (lambda () (ptv-box-intro! x v1 x2 h)))
      (dk-have! (list 'IN y bw) (lambda () (ptv-box-intro! y w1 y2 h)))
      (ew bv)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin
                (ew bw)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((lk (dk-peel!))
                               (a (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) bv))) lk)))
                               (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) bw))) lk)))
                               (a1 (ptv-n1 a)) (a2 (ptv-n2 a)) (b1 (ptv-n1 b)) (b2 (ptv-n2 b))
                               (t1 (list '(VADD m) a1 b1)) (t2 (list '+ a2 b2)))
                          (ptv-box-elim! a v1 x2 h)
                          (ptv-box-elim! b w1 y2 h)
                          (ptv-p2c! a) (ptv-p2c! b)
                          (ptv-open! a) (ptv-open! b)
                          (dk-apply! cl a1 b1)
                          (ptv-open-pt! v0 t1)
                          (ptv-real! t2)
                          (let* ((d (list '- t2 s2)) (da (list '- a2 x2)) (db (list '- b2 y2)))
                            (ptv-real! d) (ptv-real! da) (ptv-real! db)
                            (ptv-real! (list 'abs da)) (ptv-real! (list 'abs db)) (ptv-real! (list 'abs d))
                            (let* ((tri (dk-cite! 'rr-abs-triangle-c da db))
                                   (eq (ptv-eq! (list '+ da db) d))
                                   (tri2 (dk-rewrite-h! tri (list '+ da db) d)))
                              (dk-have! (list '< (list 'abs d) e)
                                (lambda () (dk-ineq! tri2 (list '< (ptv-dist a x2) h) (list '< (ptv-dist b y2) h)
                                                     (list 'IN (list 'abs d) 'RR) (list 'IN (list 'abs da) 'RR) (list 'IN (list 'abs db) 'RR)
                                                     (list 'IN e 'RR))))))
                          (dk-have! (list 'IN (list 'LIST t1 t2) (ptv-box v0 s2 e)) (lambda () (ptv-in-box-list! t1 t2 v0 s2 e)))
                          (dk-cite! 'pv-vadd-value 'm a b)
                          (subst (list '= (list '(PV-VADD m) a b) (list 'LIST t1 t2)))
                          (dk-cite! 'subset-mem-fwd (ptv-box v0 s2 e) u (list 'LIST t1 t2))
                          (ass))))))))))))
(ptv-qed! 'prod-add-continuous)

;;; continuity of the scalar action
(define (ptv-recip! c)                 ; c real, nonzero in context: lands (= (* c v) 1), v = recip(c) named
  (ptv-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (dk-cite! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-inverse c)
  (let ((v (dk-name! (list 'recip c))))
    (dk-have! (list '= (list '* c v) 1) (lambda () (subst (list '= v (list 'recip c))) (ass)))
    v))
(define (ptv-nz-of-pos! c)
  (let ((f (list 'NOT (list '= c 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-rewrite-h! (dk-ctx-form (list '< 0 c)) c 0)
                               (dk-cite! 'rr-zero-in) (dk-cite! 'rr-lt-irrefl 0) (ai '(NOT (< 0 0))))))
    f))
(define (ptv-find-open-nbhd! pt not-this)  ; the W with (IN pt W), (IN W (OPENS t)), W /= NOT-THIS
  (let ((ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f pt))) (dk-asms))))
    (if ex2 (dk-skolem! ex2 #t)
        (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) pt) (symbol? (caddr f)) (not (eq? (caddr f) not-this))
                                         (dk-asm? (list 'IN (caddr f) '(OPENS t)))))
                        "the open neighbourhood")))))

(sp (make-wff (ptv-alls '(m t) (ptv-imps (list ptv-tvs) (ptv-tsub ptv-scalc0)))))
(dk-peel!)
(ptv-tvs-parts!)
(ptv-carr-rr!)
(let* ((ld (filter (lambda (f) (dk-head-is? f 'IN)) (dk-asms)))
       (r (cadr (find-first (lambda (f) (equal? (caddr f) '(CARR (SCAL m)))) ld)))
       (x (cadr (find-first (lambda (f) (equal? (caddr f) ptv-C)) ld)))
       (u (cadr (find-first (lambda (f) (equal? (caddr f) (list 'OPENS ptv-top))) ld)))
       (x1 (ptv-n1 x)) (x2 (ptv-n2 x))
       (s (list '(PV-ACT m) r x))
       (s1 (list '(ACT m) r x1)) (s2 (list '* r x2))
       (sl (list 'LIST s1 s2)))
  (dk-rewrite-h! (list 'IN r '(CARR (SCAL m))) '(CARR (SCAL m)) 'RR)
  (ptv-open! x)
  (dk-cite! 'pv-act-value 'm r x)
  (let* ((pr (ptv-basic-at! u s sl)) (v0 (car pr)) (e (cdr pr)))
    (dk-nth-h! (list 'IN (list 'NTH 1 sl) v0))
    (dk-nth-h! (list 'SUBSET (ptv-box v0 (list 'NTH 2 sl) e) u))
    (ptv-vtype! s1)
    (let* ((ex (dk-cite! 'tvs-scal-cont-rr 'm 't r x1 v0))
           (d1 (dk-skolem! ex #t))
           (w1 (ptv-find-open-nbhd! x1 v0))
           (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w1) (dk-contains? f v0) (dk-contains? f d1))) "the scaling clause"))
           (h (ptv-half! e))
           (ar (list 'abs r)) (ax (list 'abs x2))
