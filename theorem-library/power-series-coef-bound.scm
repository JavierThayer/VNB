;;; Library: complex-analysis.

;;; ch3e-coef.scm -- CH3-E: Proposition 3.47 of complex-analysis.pdf, for a GIVEN power series.
;;;
;;;   power-series-coefficient-bound   (3.47) the coefficients c_n of a power series sum c_k (z - a)^k
;;;                                    convergent beyond the circle |z - a| = r satisfy
;;;                                    |c_n| <= M r^(-n) for every bound M of the sum on that circle
;;;
;;; The tree had the estimate for the coefficients a_k = (1/2 pi i) int f(w)/(w - c)^(k+1) dw of a
;;; holomorphic f (cauchy-estimate-derivative, through the derivatives).  The bridge: the sum G of the
;;; given series is holomorphic on a ball B(a, s), r < s < radius (cps-translate-holomorphic); its
;;; k-th derivative at a is k! c_k (taylor-coefficients-at) and at most k! M r^-k (cauchy-estimate-
;;; derivative); divide by k!.  The radius comparisons are made on the extended line through
;;; esup-upper and rr-pos-star-membership.
;;; Library: complex-analysis.  Helper prefix: pc-.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (pc-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "pc-pick: nothing matching" what) (car l))))
(define (pc-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (pc-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (pc-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (pc-psum y) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(pcq_ cpsk_) (list 'power (list '- y 'a) 'cpsk_))))
(define (pc-ball s) (list 'BALL 'CC-MS 'a s))

(sp (make-wff (forall-guarded '(pcq_ a r M)
  (list '(IN pcq_ (FUN NN CC)) '(IN a CC) '(IN r RR) '(< 0 r) '(< r (CPS-RADIUS pcq_)) '(IN M RR)
        (list 'FORALL 'y (list 'IMPLIES '(IN y CC) (list 'IMPLIES '(= (magnitude (- y a)) r)
          (list '<= (list 'magnitude (list 'CC-SERIES-LIMIT (pc-psum 'y))) 'M)))))
  '(FORALL k (IMPLIES (IN k NN) (<= (magnitude (pcq_ k)) (* M (power (recip r) k))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(dk-have! '(IN 0 RR)) (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
(let* ((bnd (pc-pick 'bnd (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CC-SERIES-LIMIT)))))
       (t (dk-skolem! (dk-fact! 'cps-radius-approx 'pcq_ 'r) #t))
       (_s (dk-split-all!))
       (conv (pc-pick 'conv (lambda (f) (and (dk-head-is? f 'SERIES-CONVERGES) (dk-contains? f t)))))
       (Sset (list 'SEP 'cpsr_ 'RR (list 'AND '(<= 0 cpsr_)
            (list 'SERIES-CONVERGES '(VNB-LAMBDA cpsk_ NN (* (magnitude (pcq_ cpsk_)) (power cpsr_ cpsk_)))))))
       (Esp (list 'ESUP Sset)))
  ;; t is in S, S is a set of nonnegative reals, so t <= ESUP(S) = CPS-RADIUS
  (dk-have! (list '<= 0 t) (lambda () (dk-ineq! '(<= 0 r) (list '< 'r t))))
  (dk-have! (list 'SUBSET Sset 'RR-POS-STAR)
    (lambda ()
      (let ((x (subset-by-element!)))
        (sep-me (list 'IN x Sset)) (dk-split-all!)
        (let ((iff (dk-cite! 'rr-pos-star-membership x)))
          (if (dk-only! iff (list 'IN x 'RR) (list '<= 0 x)) (prop))))))
  (dk-have! (list 'IN t Sset) (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
  (fact 'esup-upper Sset t)
  (fact 'esup-in Sset)
  (dk-cite! 'cps-radius-unfold 'pcq_)
  (define (below-radius! x)                    ; x in RR, 0 <= x, x < t: (< x (CPS-RADIUS pcq_))
    (let ((g (list '< x '(CPS-RADIUS pcq_))))
      (if (not (dk-asm? g))
          (dk-have! g
            (lambda ()
              (subst (list '== '(CPS-RADIUS pcq_) Esp))
              (let ((iff (dk-cite! 'rr-pos-star-membership Esp)))
                (dk-have! (list 'OR (list 'AND (list 'IN Esp 'RR) (list '<= 0 Esp)) (list '= Esp 'POS-INF))
                  (lambda () (if (dk-only! iff (list 'IN Esp 'RR-POS-STAR)) (prop))))
                (use-cases (list (list 'AND (list 'IN Esp 'RR) (list '<= 0 Esp)) (list '= Esp 'POS-INF))
                  (lambda () (dk-split-all!) (dk-ineq! (list '< x t) (list '<= t Esp)))
                  (lambda ()
                    (subst (list '= Esp 'POS-INF))
                    (mac '<)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) '<=)
                            (begin
                              (dk-have! (list 'IN x 'RR-POS-STAR)
                                (lambda () (let ((i2 (dk-cite! 'rr-pos-star-membership x)))
                                             (dk-have! (list 'AND (list 'IN x 'RR) (list '<= 0 x)))
                                             (if (dk-only! i2 (list 'AND (list 'IN x 'RR) (list '<= 0 x))) (prop)))))
                              (fact 'rr-pos-star-below-pos-inf x)
                              (ass))
                            (begin
                              (di)
                              (fact 'pos-inf-not-in-rr)
                              (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF x)) (ass)))
                              (ai '(NOT (IN POS-INF RR)))))))))))))
      g))
  ;; s = r + (t - r)/2, rho = r/2
  (let* ((d (list '- t 'r))
         (_d (begin (pc-rr! d) (dk-have! (list '< 0 d) (lambda () (dk-ineq! (list '< 'r t)))) (fact 'rr-pos-rr-of-lt d)))
         (h (dk-halve! d))
         (eqh (pc-pick 'eqh (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h) (dk-contains? f t)))))
         (_h (dk-pos-parts! h))
         (s (list '+ 'r h))
         (_r (fact 'rr-pos-rr-of-lt 'r))
         (rho (dk-halve! 'r))
         (eqr (pc-pick 'eqr (lambda (f) (and (dk-head-is? f '=) (dk-contains? f rho) (dk-contains? f 'r) (not (dk-contains? f h))))))
         (_p (dk-pos-parts! rho))
         (Bs (pc-ball s)) (Br (pc-ball rho))
         (Gsum (list 'VNB-LAMBDA 'algz_ Bs (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(pcq_ cpsk_) '(power (- algz_ a) cpsk_)))))))
    (pc-rr! s)
    (dk-have! (list '< 'r s) (lambda () (dk-ineq! (list '< 0 h))))
    (dk-have! (list '< s t) (lambda () (dk-ineq! eqh (list '< 0 h))))
    (dk-have! (list '< 0 s) (lambda () (dk-ineq! '(< 0 r) (list '< 0 h))))
    (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
    (dk-have! (list '< rho 'r) (lambda () (dk-ineq! eqr (list '< 0 rho))))
    (dk-have! (list '< rho t) (lambda () (dk-ineq! (list '< rho 'r) (list '< 'r t))))
    (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list '< 0 rho))))
    (below-radius! s) (below-radius! rho)
    ;; G, the sum on B(a, s), is holomorphic there
    (dk-fact! 'cps-translate-holomorphic 'pcq_ 'a s)
    (dk-cite! 'holomorphic-on-in-fun Bs Gsum)
    (define (in-ball! z q)                     ; z in CC, |z - a| < q: z in B(a, q)
      (let ((g (list 'IN z (pc-ball q))))
        (if (not (dk-asm? g))
            (let ((bi (dk-cite! 'cc-ms-ball-membership 'a q z)))
              (dk-have! g (lambda () (if (dk-only! bi (list 'IN z 'CC) (list '< (list 'magnitude (list '- z 'a)) q)) (prop))))))
        g))
    (define (ball-parts! z q)                  ; z in B(a, q): z in CC, |z - a| < q
      (let ((bi (dk-cite! 'cc-ms-ball-membership 'a q z)))
        (dk-have! (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z 'a)) q))
          (lambda () (if (dk-only! bi (list 'IN z (pc-ball q))) (prop))))
        (dk-split-all! (list (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z 'a)) q))))))
    (define (gval! z)                          ; z in B(a, s): (= (G z) (CC-SERIES-LIMIT (psum z)))
      (let* ((L (list 'CC-SERIES-LIMIT (pc-psum z))) (e (list '= (list Gsum z) L)) (qe (list '== (list Gsum z) L)))
        (fact 'fun-apply-type-c Gsum Bs 'CC z)
        (if (not (dk-asm? qe)) (dk-have! qe (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
        (if (not (dk-asm? (list 'IN L 'CC))) (dk-rewrite-h! (list 'IN (list Gsum z) 'CC) (list Gsum z) L))
        (if (not (dk-asm? e)) (dk-have! e (lambda () (subst qe) (if (not (proof-done? *ps*)) (rfl)))))
        e))
    (dk-have! (list 'SUBSET Bs Bs) (lambda () (let ((z (subset-by-element!))) (ass))))
    ;; the bound on the circle: every point of its trace is at distance r from a
    (let* ((Tcirc '(TRACE (CIRCLE-PATH a r) 0 (* 2 PI))))
      (dk-split-all! (list (dk-cite! 'pi-pos)))
      (pc-rr! '(* 2 PI))
      (dk-cite! 'circle-is-road 'a 'r)
      (fact 'is-road-is-path '(CIRCLE-PATH a r) '(CIRCLE-DERIV a r) 0 '(* 2 PI))
      (fact 'is-path-in-fun '(CIRCLE-PATH a r) 0 '(* 2 PI))
      (dk-cite! 'trace-subset-cc '(CIRCLE-PATH a r) 0 '(* 2 PI))
      (dk-have! (list 'FORALL 'ciey_ (list 'IMPLIES (list 'IN 'ciey_ Tcirc) (list '<= (list 'magnitude (list Gsum 'ciey_)) 'M)))
        (lambda ()
          (let ((y (dk-di-var!)))
            (fact 'subset-mem-fwd Tcirc 'CC y)
            (inst*! (dk-cite! 'circle-trace-magnitude 'a 'r) y)
            (pc-cc! (list '- y 'a)) (fact 'cc-magnitude-closed (list '- y 'a))
            (dk-have! (list '< (list 'magnitude (list '- y 'a)) s)
              (lambda () (dk-ineq! (list '= (list 'magnitude (list '- y 'a)) 'r) (list '< 'r s))))
            (in-ball! y s)
            (subst (gval! y))
            (inst*! bnd y)
            (ass))))
      ;; the estimate on the derivatives, and the derivatives as k! c_k
      (let* ((est (dk-fact! 'cauchy-estimate-derivative Bs Gsum 'a s 'r rho 'M))
             (_sb (dk-have! (list 'SUBSET Br Bs)
                    (lambda () (let ((z (subset-by-element!)))
                                 (ball-parts! z rho)
                                 (pc-cc! (list '- z 'a))
                                 (fact 'cc-magnitude-closed (list '- z 'a))
                                 (dk-have! (list '< (list 'magnitude (list '- z 'a)) s)
                                   (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z 'a)) rho) (list '< rho 'r) (list '< 'r s))))
                                 (in-ball! z s)))))
             (_re (dk-have! (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ Br)
                                   (list '= (list Gsum 'algz_) (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(pcq_ cpsk_) '(power (- algz_ a) cpsk_)))))))
                    (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd Br Bs z) (gval! z) (ass)))))
             (tc (dk-fact! 'taylor-coefficients-at Gsum Bs 'pcq_ 'a rho)))
        (let* ((_pk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)))
               (k (cadr (pc-pick 'kk (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (symbol? (cadr f)) (not (memq (cadr f) '(pcq_))))))))
               (Fk (list 'FACTORIAL k)) (Xc (list 'magnitude (list 'pcq_ k))) (Bd (list '* 'M (list 'power (list 'recip 'r) k)))
               (N (list (list 'NTH-DERIV-ON 'CC-NORMED-FIELD Br (list 'RESTRICT Gsum Br) k) 'a)))
          (inst*! est k) (inst*! tc k)
          (dk-split-all! (list (dk-cite! 'factorial-real-pos k)))
          (fact 'rr-subset-cc Fk)
          (fact 'fun-apply-type-c 'pcq_ 'NN 'CC k)
          (pc-and! (list 'IN Fk 'CC) (list 'IN (list 'pcq_ k) 'CC))
          (fact 'cc-magnitude-mul Fk (list 'pcq_ k))
          (fact 'rr-magnitude-is-abs Fk)
          (dk-have! (list '<= 0 Fk) (lambda () (dk-ineq! (list '< 0 Fk))))
          (fact 'rr-abs-of-nonneg Fk)
          (fact 'cc-magnitude-closed (list 'pcq_ k))
          (fact 'rr-pos-ne-zero 'r)
          (pc-and! '(IN r RR) '(NOT (= r 0)))
          (fact 'rr-recip-closed 'r)
          (fact 'power-real-closed '(recip r) k)
          (pc-and! '(IN M RR) (list 'IN (list 'power '(recip r) k) 'RR))
          (fact 'rr-mul-closed 'M (list 'power '(recip r) k))
          (pc-rr! Bd) (pc-rr! (list '* Fk Xc)) (pc-rr! (list '* Fk Bd))
          (dk-have! (list '<= (list '* Fk Xc) (list '* Fk Bd))
            (lambda ()
              (dk-rewrite-h! (list '<= (list 'magnitude N) (list '* Fk Bd)) N (list '* Fk (list 'pcq_ k)))
              (dk-rewrite-h! (list '<= (list 'magnitude (list '* Fk (list 'pcq_ k))) (list '* Fk Bd))
                             (list 'magnitude (list '* Fk (list 'pcq_ k))) (list '* (list 'magnitude Fk) Xc))
              (dk-rewrite-h! (list '<= (list '* (list 'magnitude Fk) Xc) (list '* Fk Bd)) (list 'magnitude Fk) (list 'abs Fk))
              (dk-rewrite-h! (list '<= (list '* (list 'abs Fk) Xc) (list '* Fk Bd)) (list 'abs Fk) Fk)
              (ass)))
          ;; divide by k!
          (fact 'rr-pos-ne-zero Fk)
          (pc-and! (list 'IN Fk 'RR) (list 'NOT (list '= Fk 0)))
          (fact 'rr-recip-closed Fk) (fact 'rr-recip-inverse Fk) (fact 'rr-recip-pos Fk)
          (let ((rf (dk-name! (list 'recip Fk))))
            (dk-rewrite-h! (list '= (list '* Fk (list 'recip Fk)) 1) (list 'recip Fk) rf)
            (dk-rewrite-h! (list '< 0 (list 'recip Fk)) (list 'recip Fk) rf)
            (dk-have! (list '<= 0 rf) (lambda () (dk-ineq! (list '< 0 rf))))
            (pc-and! (list '<= 0 rf) (list '<= (list '* Fk Xc) (list '* Fk Bd)))
            (fact 'rr-le-scale-nonneg rf (list '* Fk Xc) (list '* Fk Bd))
            (pc-rr! (list '* rf (list '* Fk Xc))) (pc-rr! (list '* rf (list '* Fk Bd)))
            (dk-have! (list '= (list '* rf (list '* Fk Xc)) Xc)
              (lambda () (dk-have! (list '= (list '* rf (list '* Fk Xc)) (list '* (list '* Fk rf) Xc)) (lambda () (crs)))
                         (subst (list '= (list '* rf (list '* Fk Xc)) (list '* (list '* Fk rf) Xc)))
                         (subst (list '= (list '* Fk rf) 1)) (crs)))
            (dk-have! (list '= (list '* rf (list '* Fk Bd)) Bd)
              (lambda () (dk-have! (list '= (list '* rf (list '* Fk Bd)) (list '* (list '* Fk rf) Bd)) (lambda () (crs)))
                         (subst (list '= (list '* rf (list '* Fk Bd)) (list '* (list '* Fk rf) Bd)))
                         (subst (list '= (list '* Fk rf) 1)) (crs)))
            (dk-ineq! (list '<= (list '* rf (list '* Fk Xc)) (list '* rf (list '* Fk Bd)))
                      (list '= (list '* rf (list '* Fk Xc)) Xc) (list '= (list '* rf (list '* Fk Bd)) Bd))))))))
(qed 'power-series-coefficient-bound)

  
