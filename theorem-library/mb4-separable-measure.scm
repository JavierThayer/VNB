;;; mb4-separable-measure.scm -- construction of measures, Corollary 7.6 (M-B4, 2026-10-26): under the
;;; assumptions of Proposition 7.1 with r0 = +inf (every ball has finite positive measure, and for each radius
;;; the measures of the balls of that radius are uniformly comparable), X is separable.
;;;
;;; The notes' proof goes through Corollary 7.3 (closed balls are compact, by RELATIVE COMPACTNESS, i.e. through
;;; CLOSURE, which this wave may not unfold).  This file proves 7.6 directly by the packing half of the proof of
;;; Proposition 7.1, with no closure and no compactness:
;;;   ball-packing-bounded      an infinite sequence in a ball B(z0, R), pairwise more than 2h apart, whose
;;;                             h-balls all have measure >= a > 0, forces mu(B(z0, R + 2h)) = +inf (the balls
;;;                             B(x_k, h) are disjoint Borel sets inside B(z0, R + 2h); countable additivity
;;;                             and the tail of a convergent ESUM)
;;;   ball-greedy-net           (the greedy construction, by dc-on-nn-pred on the sets already covered) a ball
;;;                             B(z0, R) is covered by countably many delta-balls when the packing bound holds
;;;   measure-ball-separable    (Cor 7.6)
;;; Library: measure.  Helper prefix msm-.
;;;
;;; Load window: after mb4-sigma-finite (nothing cited from it), theorem-library/push-forward (pfw-open-borel),
;;; the measure laws (measure-monotone, measure-finite-subset), esum-nn-tail-small, esum-nn-term-le,
;;; dc-on-nn-pred and rmm-nn-choice.
(define (msm-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (msm-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (msm-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (msm-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (msm-map (lambda (c) (msm-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
(define (msm-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (msm-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (msm-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (msm-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; (IN (ESUM f) RR-POS-STAR) for f in FUN(NN, RR-POS-STAR)  (cth-dom!, caratheodory.scm)
(define (msm-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)) (lambda () (dk-conj-close! dk-ass!)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))
;;; (NOT (= a b)) from a strict inequality in context
(define (msm-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
;;; y in BALL(s, c, r) from d(c, y) < r (c, y in PTS s, r typed)
(define (msm-in-ball! c y r)
  (let ((d (list '(DIST s) c y)))
    (dk-cite! 'metric-dist-real 's c y)
    (dk-have! (list '<= d r) (lambda () (dk-ineq! (list '< d r))))
    (msm-ne! d r (list '< d r))
    (dk-have! (list 'IN y (list 'BALL 's c r))
      (lambda () (mac 'ball-membership) (dk-conj-close! (lambda () (ass)))))))
;;; the parts of y in BALL(s, c, r): y in PTS s, d(c, y) < r
(define (msm-ball-parts! c y r)
  (let* ((d (list '(DIST s) c y))
         (ps (msm-iff-parts! (dk-cite! 'ball-membership 's c r y))))
    (dk-cite! 'metric-dist-real 's c y)
    (if (not (dk-asm? (list '< d r)))
        (begin
          (dk-cite! 'rr-le-ne-lt d r)
          (if (not (dk-asm? (list '< d r)))
              (begin
                (dk-have! (list 'AND (list '<= d r) (list 'NOT (list '= d r))) (lambda () (dk-conj-close! dk-ass!)))
                (msm-chain! (dk-fact! 'rr-le-ne-lt d r))))))
    (list '< d r)))

