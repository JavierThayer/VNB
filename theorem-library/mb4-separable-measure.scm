;; disjointness, in the shape the additivity clause asks
(define msm-dis (subst-free 'f_ msm-b (cadr (caddr (caddr msm-add)))))
(dk-have! msm-dis
  (lambda ()
    (let* ((lk (dk-peel!))
           (nf (find-first (lambda (f) (dk-head-is? f 'NOT)) lk))
           (i (cadr (cadr nf))) (j (caddr (cadr nf)))
           (bi (msm-b! i)) (bj (msm-b! j)))
      (dk-cite! 'nn-in-rr i) (dk-cite! 'nn-in-rr j)
      (msm-ext2! (list 'INTERSECTION bi bj) 'EMPTY-SET
        (lambda (w)
          (let* ((ps (msm-iff-parts! (dk-cite! 'intersection-membership bi bj w)))
                 (wi (dk-rewrite-h! (list 'IN w bi) bi (list 'BALL 's (list 'xs i) 'h)))
                 (wj (dk-rewrite-h! (list 'IN w bj) bj (list 'BALL 's (list 'xs j) 'h))))
            (msm-xs! i) (msm-xs! j)
            (msm-ball-parts! (list 'xs i) w 'h)
            (msm-ball-parts! (list 'xs j) w 'h)
            (dk-cite! 'metric-triangle 's (list 'xs i) w (list 'xs j))
            (dk-cite! 'metric-sym 's (list 'xs j) w)
            (dk-cite! 'metric-sym 's (list 'xs i) (list 'xs j))
            (dk-cite! 'metric-dist-real 's w (list 'xs j))
            (dk-cite! 'metric-dist-real 's (list 'xs i) (list 'xs j))
            (dk-cite! 'metric-dist-real 's (list 'xs j) (list 'xs i))
            (pbc)
            (let ((dij (list '(DIST s) (list 'xs i) (list 'xs j))) (dji (list '(DIST s) (list 'xs j) (list 'xs i)))
                  (prem (list (list '<= (list '(DIST s) (list 'xs i) (list 'xs j)) (list '+ (list '(DIST s) (list 'xs i) w) (list '(DIST s) w (list 'xs j))))
                              (list '< (list '(DIST s) (list 'xs i) w) 'h) (list '< (list '(DIST s) (list 'xs j) w) 'h)
                              (list '= (list '(DIST s) (list 'xs j) w) (list '(DIST s) w (list 'xs j))))))
              (use-cases (dk-cite! 'rr-lt-trichotomy i j)
                (lambda () (dk-apply! msm-sep i j) (apply dk-absurd! (cons (list '< '(+ h h) dij) prem)))
                (lambda () (ai nf))
                (lambda () (dk-apply! msm-sep j i) (apply dk-absurd! (append (list (list '< '(+ h h) dji) (list '= dij dji)) prem)))))))
        (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
      (msm-close-open!))))
