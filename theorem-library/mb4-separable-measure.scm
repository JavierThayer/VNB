                    (lambda () (dk-cite! 'power-mem-in '(PTS s) u z) (msm-close-open!))
                    (lambda () (mac-h 'ball-membership (list 'IN z bl)) (dk-split-all!) (msm-close-open!))))))
            (dk-cite! 'power-mem-intro '(PTS s) y)
            (msm-close-open!))))
    y))
(define (msg-pick! k u p far?)
  (let ((y (msg-uin! u p)))
    (ew y)
    (for-each
     (lambda (j)
       (dk-focus! j)
       (if (dk-asm? (dk-goal))
           (ass)
           (begin
             (dk-lam-b!)
             (in-sep!
               (lambda ()
                 (ew p)
                 (dk-conj-close!
                   (lambda ()
                     (let ((g0 (dk-goal)))
                       (cond ((dk-asm? g0) (ass))
                             ((dk-head-is? g0 '=) (rfl))
                             (far? (di) (dk-conj-close! (lambda () (ass))))
                             (#t (di) (ai (list 'NOT (msg-far u)))))))))))))
