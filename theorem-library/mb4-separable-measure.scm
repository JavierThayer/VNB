(define (msg-uin! u p)                 ; u in P, p in PTS s:  u U B(p, dl) in P
  (let* ((bl (list 'BALL 's p 'dl)) (y (list 'UNION u bl)))
    (if (not (dk-asm? (list 'IN y msg-P)))
        (dk-have! (list 'IN y msg-P)
