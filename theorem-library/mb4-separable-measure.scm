(define (msm-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "msm-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define msg-P '(POWER (PTS s)))
(define msg-B0 '(BALL s z0 rad))
(define (msg-far u) (list 'FORSOME 'mgq_ (list 'AND (list 'IN 'mgq_ msg-B0) (list 'NOT (list 'IN 'mgq_ u)))))
(define (msg-rel u p) (list 'IMPLIES (msg-far u) (list 'AND (list 'IN p msg-B0) (list 'NOT (list 'IN p u)))))
(define msg-nxt (list 'VNB-LAMBDA '(LIST mgk_ mgu_) (list 'CARTESIAN 'NN msg-P)
  (list 'SEP 'mgt_ msg-P (list 'FORSOME 'mgp_ (list 'AND '(IN mgp_ (PTS s))
    (list 'AND (list '= 'mgt_ (list 'UNION 'mgu_ '(BALL s mgp_ dl))) (msg-rel 'mgu_ 'mgp_)))))))
(define msg-low '(FORALL x (IMPLIES (IN x (PTS s)) (<= a (mu (BALL s x h))))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE (PTS s) (BOREL-SETS s) mu)
  (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 (PTS s)) (list 'FORALL 'rad (list 'IMPLIES '(IN rad RR)
    (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list 'FORALL 'h (list 'IMPLIES '(POS-RR h) (list 'IMPLIES '(< (+ h h) dl)
      (list 'IMPLIES '(IN (mu (BALL s z0 (+ rad dl))) RR)
        (list 'FORALL 'a (list 'IMPLIES '(POS-RR a) (list 'IMPLIES msg-low
          '(FORSOME f (AND (IN f (FUN NN (PTS s)))
             (FORALL p (IMPLIES (IN p (BALL s z0 rad)) (FORSOME i (AND (IN i NN) (IN p (BALL s (f i) dl)))))))))))))))))))))))))))
