  (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 (PTS s)) (list 'FORALL 'rad (list 'IMPLIES '(IN rad RR) (list 'FORALL 'h (list 'IMPLIES '(POS-RR h)
    (list 'FORALL 'xs (list 'IMPLIES '(IN xs (FUN NN (PTS s))) (list 'IMPLIES msm-inball (list 'IMPLIES msm-sep
