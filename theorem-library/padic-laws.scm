(dk-peel!)
(dk-cite! 'rr-pos-rr-in-rr 'r) (dk-cite! 'rr-lt-of-pos-rr 'r)
(dk-have! '(IN 2 RR) (lambda () (arith)))
(let ((n (dk-skolem! (dk-cite! 'rr-archimedean-multiple 'r 2))))
  (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-zero-le n)
  (dk-cite! 'nn-succ-le-power-two n)
  (pz-two! n)
  (fact 'rr-one-in)
  (pz-and! `(IN ,n RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed n 1)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'rr-mul-le-right `(+ ,n 1) `(power 2 ,n) 'r)
  (cw-rr-mul! `(+ ,n 1) 'r) (cw-rr-mul! `(power 2 ,n) 'r) (cw-rr-mul! 'r `(power 2 ,n)) (cw-rr-mul! n 'r)
  (dk-have! `(= (* (+ ,n 1) r) (+ (* ,n r) r)) (lambda () (crs)))
  (dk-have! `(= (* (power 2 ,n) r) (* r (power 2 ,n))) (lambda () (crs)))
  (pz-witness! (list n)
    (lambda ()
      (dk-ineq! `(<= 2 (* ,n r)) '(< 0 r) `(= (* (+ ,n 1) r) (+ (* ,n r) r)) `(<= (* (+ ,n 1) r) (* (power 2 ,n) r))
                `(= (* (power 2 ,n) r) (* r (power 2 ,n)))))))
(qed 'pc-power-two-beats)

;; Z(Q) is a subset of QQ, and a set
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (AND (SUBSET (NV-INTEGERS (QQ-PADIC p)) QQ) (IN (NV-INTEGERS (QQ-PADIC p)) SET))))))
(dk-peel!)
