                             (oi (find-first (lambda (f) (and (dk-head-is? f 'ZZ-ORD-IS) (equal? (cadddr f) (caddr (caddr g))))) landed))
                             (oj (find-first (lambda (f) (and (dk-head-is? f 'ZZ-ORD-IS) (equal? (cadddr f) (caddr (caddr (cadr g)))))) landed))
                             (ca (caddr oi)) (cb (caddr oj)) (i (cadddr oi)) (j (cadddr oj)))
