                (dk-have! `(= (* x (* ,pj ,b1)) (* ,pj ,a2))
                  (lambda () (subst `(= (* ,pj ,b1) ,b)) (subst `(= (* ,pj ,a2) ,a)) (dk-ass!)))
                (dk-have! `(= (* (* x ,b1) ,pj) (* ,a2 ,pj))
                  (lambda ()
                    (dk-have! `(= (* (* x ,b1) ,pj) (* x (* ,pj ,b1))) (lambda () (crs)))
                    (dk-have! `(= (* ,a2 ,pj) (* ,pj ,a2)) (lambda () (crs)))
                    (subst `(= (* (* x ,b1) ,pj) (* x (* ,pj ,b1))))
                    (subst `(= (* ,a2 ,pj) (* ,pj ,a2)))
                    (dk-ass!)))
                (dk-have! `(< 0 ,pj) (lambda () (dk-ineq! `(<= 1 ,pj))))
                (dk-cite! 'pz-rr-cancel-pos `(* x ,b1) a2 pj)
                (pz-witness! (list b1) (lambda () (subst `(= (* x ,b1) ,a2)) (dk-ass!))))))))))
