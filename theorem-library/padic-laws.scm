                                (dk-have! '(IN 2 RR) (lambda () (arith)))
                                (dk-have! `(<= 0 ,w) (lambda () (dk-ineq! `(<= 1 ,w))))
                                (dk-cite! 'rr-mul-le-right 2 u w)
