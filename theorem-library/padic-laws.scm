;; goal a nest of FORSOMEs and ANDs: witness them from WS in order, closing the rest with CLOSER
(define (pz-witness! ws closer)
  (let loop ((ws ws))
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'FORSOME) (ew (car ws)) (loop (cdr ws)))
            ((dk-head-is? g 'AND)
             (let ((rest ws))
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-head-is? (dk-goal) 'FORSOME) (loop rest))
                         ((dk-ass!) #t)
                         (#t (closer)))))))
            ((dk-ass!) #t)
            (#t (closer))))))

