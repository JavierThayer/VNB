;; an integer in [0, P) lies in Z(Q)
(define (pc-in-z! c)
  (let ((eq (dk-cite! 'pc-nv-integers-eq 'p)))
    (dk-cite! 'nn-subset-zz c) (pz-num! c)
    (dk-cite! 'pc-abs-int 'p c)
    (dk-have! `(IN ,c (NV-INTEGERS (QQ-PADIC p)))
      (lambda ()
        (subst eq)
        (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))

;; Corollary 1.21
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p)
  (TOTALLY-BOUNDED (SUBSPACE-MS (NF-METRIC-SPACE (QQ-PADIC p)) (NV-INTEGERS (QQ-PADIC p))))))))
(dk-peel!)
(pz-prime! 'p)
(let* ((kf '(QQ-PADIC p)) (ms `(NF-METRIC-SPACE ,kf)) (zs `(NV-INTEGERS ,kf)) (ss `(SUBSPACE-MS ,ms ,zs)))
  (dk-cite! 'pc-nv-integers-eq 'p)
  (dk-split! (dk-cite! 'pc-z-subset-set 'p))
  (dk-cite! 'qq-padic-is-normed-field 'p)
  (dk-cite! 'nf-metric-space-is-metric-space kf)
  (dk-cite! 'nf-metric-carrier kf)
  (dk-cite! 'pq-carr 'p)
  (dk-have! `(SUBSET ,zs (PTS ,ms)) (lambda () (subst `(== (PTS ,ms) (CARR ,kf))) (subst `(= (CARR ,kf) QQ)) (dk-ass!)))
  (dk-cite! 'subspace-is-metric-space ms zs)
  (dk-cite! 'subspace-pts ms zs)
  (mac 'TOTALLY-BOUNDED)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (dk-ass!)
          (begin
            (dk-peel!)
            (dk-split-all!)
            (let* ((g (dk-goal)) (isr (caddr (caddr g))) (r (list-ref isr 4)))
              (dk-have! `(POS-RR ,r) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))
              (let* ((k (dk-skolem! (dk-cite! 'pc-power-two-beats r)))
                     (pk (pz-pow! 'p k)) (ap `((PADIC-ABS p) ,pk)) (tk `(power 2 ,k)))
                (dk-have! `(<= 0 ,pk) (lambda () (dk-ineq! `(<= 1 ,pk))))
                (dk-cite! 'zz-nonneg-in-nn pk)
                (dk-cite! 'zz-subset-qq pk) (pz-abs-typed! pk)
                (dk-cite! 'pc-abs-power-two 'p k)
                (dk-cite! 'pc-abs-power 'p k)
                (pz-abs-typed! 'p)
                (dk-cite! 'power-real-closed '((PADIC-ABS p) p) k)
                (pz-two! k)
                (cw-rr-mul! r tk) (cw-rr-mul! ap tk)
                (dk-have! `(NOT (<= ,r ,ap))
                  (lambda ()
                    (di)
                    (dk-have! `(<= 0 ,tk) (lambda () (dk-ineq! `(< 0 ,tk))))
                    (dk-cite! 'rr-mul-le-right r ap tk)
                    (dk-absurd! `(<= (* ,r ,tk) (* ,ap ,tk)) `(= (* ,ap ,tk) 1) `(< 1 (* ,r ,tk)))))
                (dk-cite! 'rr-not-le-lt r ap)
                (dk-cite! 'ord-segment-is-set pk)
                (ew `(ORD-SEGMENT ,pk))
                (dk-conj-close!
                  (lambda ()
                    (cond
                      ((dk-head-is? (dk-goal) 'IN)
                       (dk-cite! 'card-segment pk)
                       (subst `(= (CARD (ORD-SEGMENT ,pk)) ,pk))
                       (dk-ass!))
                      (#t
                       (subst `(== (PTS ,ss) ,zs))
                       (mac 'IS-R-NET)
                       (dk-conj-close!
                         (lambda ()
                           (cond
                             ((dk-head-is? (dk-goal) 'SUBSET)
                              (mac 'subset-def)
                              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                     (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'ORD-SEGMENT))) landed))
                                     (c (cadr m)))
                                (dk-cite! 'ord-segment-nn-subset pk c)
                                (pc-in-z! c)
                                (dk-ass!)))
                             (#t
                              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                     (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'NV-INTEGERS))) landed))
                                     (x (cadr m)))
                                (pc-int-open! x)
                                (let ((th (dk-skolem! (dk-cite! 'ccr-1-19 'p x k))))
                                  (dk-cite! 'zz-nonneg-in-nn th)
                                  (dk-have! `(IN ,th (ORD-SEGMENT ,pk)) (lambda () (mac 'seg-mem-lt) (dk-ass!)))
                                  (pc-in-z! th)
                                  (pz-num! th)
                                  (dk-cite! 'qq-neg-closed th)
                                  (pz-and! `(IN ,x QQ) `(IN (- ,th) QQ)) (dk-cite! 'qq-add-closed x `(- ,th))
                                  (pz-abs-typed! `(+ ,x (- ,th)))
                                  (dk-have! `(= (- ,x ,th) (+ ,x (- ,th))) (lambda () (mac 'binary-minus-def) (rfl)))
                                  (dk-rewrite-h! `(<= ((PADIC-ABS p) (- ,x ,th)) (power ((PADIC-ABS p) p) ,k)) `(- ,x ,th) `(+ ,x (- ,th)))
                                  (let ((dx `((PADIC-ABS p) (+ ,x (- ,th)))))
                                    (dk-have! `(< ,dx ,r)
                                      (lambda () (dk-ineq! `(<= ,dx (power ((PADIC-ABS p) p) ,k)) `(= ,ap (power ((PADIC-ABS p) p) ,k)) `(< ,ap ,r))))
                                    (dk-have! `(IN ,th (PTS ,ms)) (lambda () (subst `(== (PTS ,ms) (CARR ,kf))) (subst `(= (CARR ,kf) QQ)) (dk-ass!)))
                                    (dk-have! `(IN ,x (PTS ,ms)) (lambda () (subst `(== (PTS ,ms) (CARR ,kf))) (subst `(= (CARR ,kf) QQ)) (dk-ass!)))
                                    (let* ((e1 (dk-cite! 'subspace-dist ms zs th x))
                                          (e2 (dk-cite! 'metric-sym ms th x))
                                          (e3 (dk-cite! 'pc-dist 'p x th)))
                                      (ew th)
                                      (dk-conj-close!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal))
                                              (dk-ass!)
                                              (begin
                                                (subst e1) (subst e2) (subst e3)
                                                (if (dk-head-is? (dk-goal) 'NOT)
                                                    (begin (di) (dk-absurd! `(= ,dx ,r) `(< ,dx ,r)))
                                                    (dk-ineq! `(< ,dx ,r))))))))))))))))))))))))))
(qed 'ccr-1-21)

;;; -----------------------------------------------------------------------
;;; D. Proposition 1.24: a non-trivial non-archimedean valuation on QQ is |x| = r^ord_p(x).
;;; "vf is a valuation on Q" is IS-NV-FIELD(QQ-NV(vf)).

(define (qn-read-off! name acc val)
  (sp (make-wff `(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (= (,acc (QQ-NV vf)) ,val)))))
  (dk-peel!)
  (fact 'qq-is-set)
  (slot acc)
  (mac 'QQ-NV)
  (nth-r)
  (pq-read-back! acc)
  (rfl)
  (qed name))
(qn-read-off! 'qn-carr 'CARR 'QQ)
(qn-read-off! 'qn-add 'ADD '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_)))
(qn-read-off! 'qn-mul 'MUL '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (* x_ y_)))
(qn-read-off! 'qn-neg 'NEG '(VNB-LAMBDA x_ QQ (- x_)))
(qn-read-off! 'qn-zero 'ZERO 0)
(qn-read-off! 'qn-fnrm 'FNRM 'vf)

(define qn-k '(QQ-NV vf))
(define qn-accs '((CARR . qn-carr) (ADD . qn-add) (MUL . qn-mul) (NEG . qn-neg) (ZERO . qn-zero) (FNRM . qn-fnrm)))
(define qn-vals '((CARR . QQ) (ADD . (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_)))
                  (MUL . (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (* x_ y_))) (NEG . (VNB-LAMBDA x_ QQ (- x_)))
                  (ZERO . 0) (FNRM . vf)))
(define (qn-val acc) (cdr (assq acc qn-vals)))
;; the read-offs and IS-NORMED-FIELD(QQ-NV vf), from IS-NV-FIELD(QQ-NV vf) in context
(define (qn-setup!)
  (fact 'qq-is-set)
  (for-each (lambda (a) (if (not (dk-asm? `(= (,(car a) ,qn-k) ,(qn-val (car a)))))
                            (dk-cite! (cdr a) 'vf)))
            qn-accs)
  (if (not (dk-asm? `(IS-NORMED-FIELD ,qn-k)))
      (dk-project! `(IS-NORMED-FIELD ,qn-k) 'is-nv-field `(IS-NV-FIELD ,qn-k))))
(define (qn-in-carr! x)
  (if (not (dk-asm? `(IN ,x (CARR ,qn-k))))
      (dk-have! `(IN ,x (CARR ,qn-k)) (lambda () (subst `(= (CARR ,qn-k) QQ)) (dk-ass!)))))
;; F in context, in accessor language: land its surface form (accessors read off, beta done)
(define (qn-surface! f)
  (let loop ((f f) (as qn-accs))
    (cond
      ((pair? as)
       (let ((from `(,(car (car as)) ,qn-k)))
         (if (dk-contains? f from)
             (loop (dk-rewrite-h! f from (qn-val (car (car as)))) (cdr as))
             (loop f (cdr as)))))
      ((dk-contains? f 'VNB-LAMBDA)
       (let* ((landed (dk-landed (lambda () (dk-lam-b-h! f))))
              (g (find-first (lambda (h) (not (dk-contains? h 'VNB-LAMBDA))) landed)))
         (or g (error "qn-surface!: beta left a redex" landed))))
      (#t f))))

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (IN (vf x) RR))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x)
(qn-surface! (dk-cite! 'nf-norm-in-rr qn-k 'x))
(dk-ass!)
(qed 'qn-in-rr)

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (<= 0 (vf x)))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x)
(qn-surface! (dk-cite! 'nf-norm-nonneg qn-k 'x))
(dk-ass!)
(qed 'qn-nonneg)

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (IFF (= (vf x) 0) (= x 0)))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x)
(qn-surface! (dk-cite! 'nf-norm-zero-iff qn-k 'x))
(dk-ass!)
(qed 'qn-zero-iff)

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (= (vf (* x y)) (* (vf x) (vf y))))))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x) (qn-in-carr! 'y)
(qn-surface! (dk-cite! 'nf-norm-mult qn-k 'x 'y))
(dk-ass!)
(qed 'qn-mul-law)

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (= (vf (- x)) (vf x)))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x)
(qn-surface! (dk-cite! 'nf-norm-neg qn-k 'x))
(dk-ass!)
(qed 'qn-neg-law)

(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (<= (vf (+ x y)) (MAX (vf x) (vf y))))))))))))
(dk-peel!)
(qn-setup!) (qn-in-carr! 'x) (qn-in-carr! 'y)
(let ((u (dk-project! `(FORALL cwx_ (IMPLIES (IN cwx_ (CARR ,qn-k)) (FORALL cwy_ (IMPLIES (IN cwy_ (CARR ,qn-k))
             (<= ((FNRM ,qn-k) ((ADD ,qn-k) cwx_ cwy_)) (MAX ((FNRM ,qn-k) cwx_) ((FNRM ,qn-k) cwy_)))))))
                      'is-nv-field `(IS-NV-FIELD ,qn-k))))
  (qn-surface! (dk-apply! u 'x 'y))
  (dk-ass!))
(qed 'qn-ultra)

(define (qo! thm . args) (apply dk-cite! thm 'vf args))
(define (qo-iff-bwd! iff) (ai iff) (detach! `(IMPLIES ,(caddr iff) ,(cadr iff))) (dk-split-all!))
;; X in ZZ: land X in QQ, RR and (vf X) in RR
(define (qo-int! x) (pz-num! x) (qo! 'qn-in-rr x))

;; |1| = 1
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (= (vf 1) 1))))))
(dk-peel!)
(fact 'qq-one-in) (fact 'rr-one-in)
(qo! 'qn-in-rr 1)
(let ((h (qo! 'qn-mul-law 1 1)))
  (dk-have! '(= (* 1 1) 1) (lambda () (arith)))
  (dk-rewrite-h! h '(* 1 1) 1))
(dk-have! '(NOT (= (vf 1) 0)) (lambda () (di) (pz-iff-fwd! (qo! 'qn-zero-iff 1)) (dk-absurd! '(= 1 0))))
(cw-rr-mul! '(vf 1) '(vf 1)) (cw-rr-mul! '(vf 1) 1)
(dk-have! '(= (* (vf 1) 1) (vf 1)) (lambda () (crs)))
(dk-have! '(= (* (vf 1) (vf 1)) (* (vf 1) 1)) (lambda () (dk-ineq! '(= (vf 1) (* (vf 1) (vf 1))) '(= (* (vf 1) 1) (vf 1)))))
(dk-cite! 'rr-cancel-mul-left '(vf 1) '(vf 1) 1)
(dk-ass!)
(qed 'qo-one)

;; |n| <= 1 on NN, by the ultrametric inequality
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (<= (vf n) 1))))))))
(let* ((bs (pz-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (fact 'qq-zero-in)
  (dk-have! '(= 0 0) (lambda () (arith)))
  (qo-iff-bwd! (qo! 'qn-zero-iff 0))
  (qo! 'qn-in-rr 0)
  (dk-ineq! '(= (vf 0) 0))
  (dk-focus! step)
  (dk-peel!)
  (let* ((n (pc-succ-var (dk-goal)))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-NV-FIELD))) "the IH")))
    (dk-apply! ih 'vf)
    (subst (dk-cite! 'nn-succ-plus-one n))
    (dk-cite! 'nn-subset-zz n) (qo-int! n)
    (fact 'qq-one-in) (fact 'rr-one-in)
    (qo! 'qn-in-rr 1)
    (qo! 'qo-one)
    (pz-and! `(IN ,n QQ) '(IN 1 QQ)) (dk-cite! 'qq-add-closed n 1)
    (qo! 'qn-in-rr `(+ ,n 1))
    (qo! 'qn-ultra n 1)
    (dk-have! '(<= (vf 1) 1) (lambda () (dk-ineq! '(= (vf 1) 1))))
    (dk-cite! 'rr-max-le `(vf ,n) '(vf 1) 1)
    (dk-cite! 'rr-max-closed `(vf ,n) '(vf 1))
    (dk-ineq! `(<= (vf (+ ,n 1)) (MAX (vf ,n) (vf 1))) `(<= (MAX (vf ,n) (vf 1)) 1))))
(qed 'qo-le-one-nn)

;; |m| <= 1 on ZZ
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL m (IMPLIES (IN m ZZ) (<= (vf m) 1))))))))
(dk-peel!)
(let ((am '(abs m)))
  (dk-cite! 'zz-abs-in-nn 'm)
  (dk-cite! 'qo-le-one-nn am 'vf)
  (dk-cite! 'nn-subset-zz am) (qo-int! am)
  (cw-or-each! (dk-cite! 'zz-abs-cases 'm)
    (lambda (o)
      (subst o)
      (if (dk-contains? (dk-goal) '-)
          (subst (qo! 'qn-neg-law am)))
      (dk-ass!))))
(qed 'qo-le-one)

;; if no positive integer has |n| < 1, every nonzero integer has |m| = 1
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf))
  (IMPLIES (NOT (FORSOME n (AND (IN n NN) (AND (< 0 n) (< (vf n) 1)))))
    (FORALL m (IMPLIES (IN m ZZ) (IMPLIES (NOT (= m 0)) (= (vf m) 1))))))))))
(dk-peel!)
(let ((am '(abs m)) (ex '(FORSOME n (AND (IN n NN) (AND (< 0 n) (< (vf n) 1))))))
  (dk-cite! 'zz-abs-in-nn 'm)
  (dk-cite! 'nn-in-rr am) (dk-cite! 'nn-zero-le am)
  (pz-num! 'm)
  (dk-cite! 'qo-le-one-nn am 'vf)
  (dk-cite! 'nn-subset-zz am) (qo-int! am)
  (dk-have! `(NOT (= 0 ,am))
    (lambda ()
      (di)
      (cw-or-each! (dk-cite! 'zz-abs-cases 'm)
        (lambda (o)
          (dk-have! '(= m 0) (lambda () (dk-ineq! o `(= 0 ,am))))
          (ai '(NOT (= m 0)))))))
  (pz-and! `(<= 0 ,am) `(NOT (= 0 ,am))) (dk-cite! 'rr-le-ne-lt 0 am)
  (dk-have! `(NOT (< (vf ,am) 1))
    (lambda ()
      (di)
      (dk-have! ex (lambda () (pz-witness! (list am) (lambda () (dk-ass!)))))
      (ai `(NOT ,ex))))
  (fact 'rr-one-in)
  (dk-have! `(= (vf ,am) 1)
    (lambda ()
      (pbc)
      (pz-and! `(<= (vf ,am) 1) `(NOT (= (vf ,am) 1)))
      (dk-cite! 'rr-le-ne-lt `(vf ,am) 1)
      (ai `(NOT (< (vf ,am) 1)))))
  (cw-or-each! (dk-cite! 'zz-abs-cases 'm)
    (lambda (o)
      (subst o)
      (if (dk-contains? (dk-goal) '-)
          (subst (qo! 'qn-neg-law am)))
      (dk-ass!))))
(qed 'qo-all-units)

;; a non-trivial valuation has a positive integer of absolute value < 1
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (IMPLIES (IS-NONTRIVIAL-NV (QQ-NV vf))
  (FORSOME n (AND (IN n NN) (AND (< 0 n) (< (vf n) 1))))))))))
(dk-peel!)
(qn-setup!)
(pbc)
(let* ((ex (dk-skolem! (dk-project! `(FORSOME cpa_ (AND (IN cpa_ (CARR ,qn-k)) (AND (NOT (= ((FNRM ,qn-k) cpa_) 0)) (NOT (= ((FNRM ,qn-k) cpa_) 1)))))
