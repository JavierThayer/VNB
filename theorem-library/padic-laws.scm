;;; padic-laws.scm -- THE p-ADIC ABSOLUTE VALUE ON QQ AND CCR.pdf 1.19-1.21, 1.24, and Remark 5.21 (the p-adic
;;; character of Q; that section cites ch-cc-cancel, so theorem-library/ccr4-chars must load first).  Vocabulary:
;;; structure-library/padic-vocab.scm.  Agent PADIC, wave MAP-1026, 2026-10-26.  Destination:
;;; theorem-library/padic-laws.scm.  Library: analysis.  Helper prefixes pz-, pq-, pc-, qn-, qo-.

(define (pz-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
;; T in ZZ in context: land T in QQ, RR, CC
(define (pz-num! t)
  (dk-cite! 'zz-subset-qq t) (dk-cite! 'qq-subset-rr t) (dk-cite! 'rr-subset-cc t))
(define (pz-nn! t) (dk-cite! 'nn-subset-zz t) (pz-num! t))
(define (pz-iff-fwd! iff) (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
(define (pz-nn-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-nn! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))
(define (pz-ni-leaves)
  (let ((leaves (dk-opened (lambda () (ni)))))
    (list (find-first (lambda (l) (not (dk-contains? (dk-goal-of l) 'succ))) leaves)
          (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) leaves))))
(define (cw-rr-mul! p q)
  (dk-have! `(AND (IN ,p RR) (IN ,q RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-mul-closed p q))
(define (cw-or-each! o handler)
  (if (not (dk-head-is? o 'OR))
      (handler o)
      (dk-each-leaf! (lambda () (ai o))
        (lambda ()
          (cond ((dk-asm? (cadr o)) (handler (cadr o)))
                ((and (pair? (caddr o)) (eq? (car (caddr o)) 'OR)) (cw-or-each! (caddr o) handler))
                (#t (handler (caddr o))))))))
(define (pz-zz-mul! a b) (pz-and! `(IN ,a ZZ) `(IN ,b ZZ)) (dk-cite! 'zz-mul-closed a b))
(define (pz-zz-add! a b) (pz-and! `(IN ,a ZZ) `(IN ,b ZZ)) (dk-cite! 'zz-add-closed a b))

;;; -----------------------------------------------------------------------
;;; 1. Integer powers.

(sp (make-wff '(FORALL cn (IMPLIES (IN cn NN) (FORALL p (IMPLIES (IN p ZZ) (IN (power p cn) ZZ)))))))
(let* ((bs (pz-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (pz-num! 'p)
  (subst (dk-cite! 'power-zero 'p))
  (fact 'zz-one-in)
  (dk-ass!)
  (dk-focus! step)
  (dk-peel!)
  (let* ((ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'power))) "the IH"))
         (n (cadr (caddr (cadr (dk-goal))))))
    (pz-num! 'p)
    (pz-and! '(IN p CC) `(IN ,n NN))
    (subst (dk-cite! 'power-succ 'p n))
    (dk-apply! ih 'p)
    (pz-zz-mul! 'p `(power p ,n))
    (dk-ass!)))
(qed 'pz-power-in-zz-ind)

(sp (make-wff '(FORALL p (IMPLIES (IN p ZZ) (FORALL cn (IMPLIES (IN cn NN) (IN (power p cn) ZZ)))))))
(dk-peel!)
(dk-cite! 'pz-power-in-zz-ind (caddr (cadr (dk-goal))) 'p)
(dk-ass!)
(qed 'pz-power-in-zz)

(sp (make-wff '(FORALL cn (IMPLIES (IN cn NN) (FORALL p (IMPLIES (IN p ZZ) (IMPLIES (<= 2 p) (<= (+ cn 1) (power p cn)))))))))
(let* ((bs (pz-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (pz-num! 'p)
  (subst (dk-cite! 'power-zero 'p))
  (arith)
  (dk-focus! step)
  (dk-peel!)
  (let* ((ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'power))) "the IH"))
         (n (cadr (caddr (caddr (dk-goal)))))
         (pp `(power p ,n)))
    (pz-num! 'p)
    (dk-cite! 'nn-in-rr n)
    (dk-cite! 'pz-power-in-zz 'p n)
    (pz-num! pp)
    (pz-and! '(IN p CC) `(IN ,n NN))
    (subst (dk-cite! 'power-succ 'p n))
    (dk-apply! ih 'p)
    (dk-cite! 'nn-zero-le n)
    (dk-have! `(<= 0 ,pp) (lambda () (dk-ineq! `(<= (+ ,n 1) ,pp) `(<= 0 ,n))))
    (dk-have! '(IN 2 RR) (lambda () (arith)))
    (dk-cite! 'rr-mul-le-right 2 'p pp)
    (cw-rr-mul! 2 pp) (cw-rr-mul! 'p pp)
    (dk-have! `(= (* 2 ,pp) (+ ,pp ,pp)) (lambda () (crs)))
    (dk-cite! 'nn-succ-plus-one n)
    (dk-cite! 'nn-succ-closed n)
    (dk-cite! 'nn-in-rr `(succ ,n))
    (dk-ineq! `(<= (* 2 ,pp) (* p ,pp)) `(= (* 2 ,pp) (+ ,pp ,pp)) `(<= (+ ,n 1) ,pp) `(= (succ ,n) (+ ,n 1)) `(<= 0 ,n))))
(qed 'pz-power-ge-ind)

(sp (make-wff '(FORALL p (IMPLIES (IN p ZZ) (IMPLIES (<= 2 p) (FORALL cn (IMPLIES (IN cn NN) (<= (+ cn 1) (power p cn)))))))))
(dk-peel!)
(dk-cite! 'pz-power-ge-ind (cadr (cadr (dk-goal))) 'p)
(dk-ass!)
(qed 'pz-power-ge)

;;; -----------------------------------------------------------------------
;;; 2. Divisibility.

;; (ZZ-DIVIDES D N) in context: land D, N in ZZ and a witness c with N = D c; return c
(define (pz-dvd-open! d n)
  (let ((iff (dk-cite! 'zz-divides d n)))
    (pz-iff-fwd! iff)
    (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f n) (dk-contains? f d))) "the cofactor"))))
;; the goal (ZZ-DIVIDES D N), D, N, C in ZZ in context; EQ! proves N = D C
(define (pz-dvd-close! c eq!)
  (mac 'zz-divides)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'FORSOME) (ew c) (dk-conj-close! (lambda () (if (not (dk-ass!)) (eq!)))))
            (#t (error "pz-dvd-close!: open" (dk-goal)))))))

(sp (make-wff '(FORALL d (FORALL n (IMPLIES (ZZ-DIVIDES d n) (FORALL c (IMPLIES (IN c ZZ) (ZZ-DIVIDES d (* c n)))))))))
(dk-peel!)
(let ((k (pz-dvd-open! 'd 'n)))
  (pz-zz-mul! 'c k) (pz-zz-mul! 'c 'n)
  (pz-dvd-close! `(* c ,k) (lambda () (subst `(= n (* d ,k))) (crs))))
(qed 'pz-dvd-mul)

(sp (make-wff '(FORALL d (FORALL a (FORALL b (IMPLIES (ZZ-DIVIDES d a) (IMPLIES (ZZ-DIVIDES d b) (ZZ-DIVIDES d (+ a b)))))))))
(dk-peel!)
(let* ((k (pz-dvd-open! 'd 'a)) (l (pz-dvd-open! 'd 'b)))
  (pz-zz-add! k l) (pz-zz-add! 'a 'b)
  (pz-dvd-close! `(+ ,k ,l) (lambda () (subst `(= a (* d ,k))) (subst `(= b (* d ,l))) (crs))))
(qed 'pz-dvd-add)

;;; CUT 2026-10-27 (integration): `pz-dvd-trans' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `zz-divides-trans', which is cited below in its place (proven-duplicate audit).

(sp (make-wff '(FORALL d (IMPLIES (IN d ZZ) (ZZ-DIVIDES d d)))))
(dk-peel!)
(fact 'zz-one-in)
(pz-dvd-close! 1 (lambda () (crs)))
(qed 'pz-dvd-refl)

(sp (make-wff '(FORALL d (IMPLIES (IN d ZZ) (ZZ-DIVIDES d 0)))))
(dk-peel!)
(fact 'zz-zero-in)
(pz-dvd-close! 0 (lambda () (crs)))
(qed 'pz-dvd-zero)

(sp (make-wff '(FORALL d (FORALL n (IMPLIES (ZZ-DIVIDES d n) (ZZ-DIVIDES d (- n)))))))
(dk-peel!)
(let ((k (pz-dvd-open! 'd 'n)))
  (dk-cite! 'zz-neg-closed k) (dk-cite! 'zz-neg-closed 'n)
  (pz-dvd-close! `(- ,k) (lambda () (subst `(= n (* d ,k))) (crs))))
(qed 'pz-dvd-neg)

;; p^k divides p^j for k <= j
(sp (make-wff '(FORALL p (IMPLIES (IN p ZZ) (FORALL k (IMPLIES (IN k NN) (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= k j)
  (ZZ-DIVIDES (power p k) (power p j)))))))))))
(dk-peel!)
(let ((d (dk-skolem! (dk-cite! 'nn-le-gap 'j 'k))))
  (pz-num! 'p)
  (for-each (lambda (e) (dk-cite! 'pz-power-in-zz 'p e)) (list 'k 'j d))
  (dk-cite! 'cc-power-add d 'k 'p)
  (pz-dvd-close! `(power p ,d) (lambda () (subst `(= j (+ k ,d))) (dk-ass!))))
(qed 'pz-power-dvd)

;; d | n, n /= 0 give |d| <= |n|
(sp (make-wff '(FORALL d (FORALL n (IMPLIES (ZZ-DIVIDES d n) (IMPLIES (NOT (= n 0)) (<= (abs d) (abs n))))))))
(dk-peel!)
(let ((c (pz-dvd-open! 'd 'n)))
  (pz-num! 'd) (pz-num! c) (pz-num! 'n)
  (fact 'rr-one-in) (fact 'zz-zero-in)
  (dk-have! `(NOT (= ,c 0))
    (lambda () (di) (dk-have! '(= n 0) (lambda () (subst `(= n (* d ,c))) (subst `(= ,c 0)) (crs))) (ai '(NOT (= n 0)))))
  (dk-cite! 'zz-abs-in-nn c)
  (dk-cite! 'rr-abs-closed 'd) (dk-cite! 'rr-abs-closed c) (dk-cite! 'rr-abs-nonneg 'd)
  (dk-have! `(NOT (= (abs ,c) 0))
    (lambda ()
      (di)
      (cw-or-each! (dk-cite! 'zz-abs-cases c)
        (lambda (o)
          (dk-have! `(= ,c 0) (lambda () (subst o) (subst `(= (abs ,c) 0)) (crs)))
          (ai `(NOT (= ,c 0)))))))
  (let ((q (dk-skolem! (dk-cite! 'nn-nonzero-is-succ `(abs ,c)))))
    (dk-have! `(<= 1 (abs ,c)) (lambda () (dk-nn! `(= (abs ,c) (succ ,q))))))
  (pz-and! '(IN d RR) `(IN ,c RR))
  (dk-cite! 'rr-abs-mult 'd c)
  (dk-cite! 'rr-mul-le-right 1 `(abs ,c) '(abs d))
  (dk-cite! 'rr-one-mul '(abs d))
  (cw-rr-mul! '(abs d) `(abs ,c)) (cw-rr-mul! `(abs ,c) '(abs d)) (cw-rr-mul! 1 '(abs d))
  (dk-have! `(= (* (abs ,c) (abs d)) (* (abs d) (abs ,c))) (lambda () (crs)))
  (subst `(= n (* d ,c)))
  (cw-rr-mul! 'd c)
  (dk-cite! 'rr-abs-closed `(* d ,c))
  (dk-ineq! `(= (abs (* d ,c)) (* (abs d) (abs ,c))) `(<= (* 1 (abs d)) (* (abs ,c) (abs d))) `(= (* 1 (abs d)) (abs d))
            `(= (* (abs ,c) (abs d)) (* (abs d) (abs ,c)))))
(qed 'pz-dvd-bound)

;;; -----------------------------------------------------------------------
;;; 3. Euclid's lemma.

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a ZZ) (FORALL b (IMPLIES (IN b ZZ)
  (IMPLIES (ZZ-DIVIDES p (* a b)) (OR (ZZ-DIVIDES p a) (ZZ-DIVIDES p b)))))))))))
(dk-peel!)
(dk-project! '(IN p ZZ) 'zz-prime '(ZZ-PRIME p))
(let ((u (dk-project! '(FORALL cpd_ (IMPLIES (IN cpd_ ZZ) (IMPLIES (ZZ-DIVIDES cpd_ p)
                          (OR (= cpd_ 1) (OR (= cpd_ (- 1)) (OR (= cpd_ p) (= cpd_ (- p))))))))
                      'zz-prime '(ZZ-PRIME p))))
  (pz-zz-mul! 'a 'b)
  (use-em '(ZZ-DIVIDES p a)
    (lambda () (oi-l) (dk-ass!))
    (lambda ()
      (oi-r)
      (let* ((d (dk-skolem! (dk-cite! 'zz-bezout 'p 'a)))
             (bm (pz-iff-fwd! (dk-cite! 'zz-bezout-set-membership 'p 'a d)))
             (x (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f d) (dk-contains? f '+))) "the bezout x")))
             (y (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f d) (dk-contains? f '+))) "the bezout y")))
             (s `(+ (* ,x p) (* ,y a))))
        (pz-zz-mul! x 'b) (pz-zz-mul! y '(* a b))
        (cw-or-each! (dk-apply! u d)
          (lambda (o)
            (let ((dv (caddr o)))
              (if (or (eqv? dv 1) (equal? dv '(- 1)))
                  ;; d = 1 or -1: b = +-(x b p + y a b)
                  (let* ((sg (if (eqv? dv 1) 1 '(- 1)))
                         (t `(* ,sg (+ (* (* ,x b) p) (* ,y (* a b))))))
                    (dk-cite! 'pz-dvd-refl 'p)
                    (dk-cite! 'pz-dvd-mul 'p 'p `(* ,x b))
                    (dk-cite! 'pz-dvd-mul 'p '(* a b) y)
                    (dk-cite! 'pz-dvd-add 'p `(* (* ,x b) p) `(* ,y (* a b)))
                    (if (equal? sg '(- 1))
                        (begin (dk-cite! 'pz-dvd-neg 'p `(+ (* (* ,x b) p) (* ,y (* a b))))
                               (dk-have! `(ZZ-DIVIDES p ,t)
                                 (lambda () (dk-have! `(= ,t (- (+ (* (* ,x b) p) (* ,y (* a b))))) (lambda () (crs)))
                                            (subst `(= ,t (- (+ (* (* ,x b) p) (* ,y (* a b)))))) (dk-ass!))))
                        (dk-have! `(ZZ-DIVIDES p ,t)
                          (lambda () (dk-have! `(= ,t (+ (* (* ,x b) p) (* ,y (* a b)))) (lambda () (crs)))
                                     (subst `(= ,t (+ (* (* ,x b) p) (* ,y (* a b))))) (dk-ass!))))
                    (dk-have! `(= b ,t)
                      (lambda ()
                        (dk-have! `(= ,t (* (* ,sg ,s) b)) (lambda () (crs)))
                        (subst `(= ,t (* (* ,sg ,s) b)))
                        (subst `(= ,s ,d))
                        (subst `(= ,d ,dv))
                        (crs)))
                    (subst `(= b ,t))
                    (dk-ass!))
                  ;; d = p or -p: p divides a
                  (let ((c (pz-dvd-open! d 'a)))
                    (pbc)
                    (dk-have! '(ZZ-DIVIDES p a)
                      (lambda ()
                        (dk-cite! 'zz-neg-closed c)
                        (pz-dvd-close! (if (equal? dv 'p) c `(- ,c))
                          (lambda () (subst `(= a (* ,d ,c))) (subst `(= ,d ,dv)) (crs)))))
                    (ai '(NOT (ZZ-DIVIDES p a))))))))))))
(qed 'pz-euclid)

;;; -----------------------------------------------------------------------
;;; 4. The order ord_p.

;; ZZ-PRIME P in context: land P in ZZ, 2 <= P, and its RR / CC typings
(define (pz-prime! p)
  (dk-project! `(IN ,p ZZ) 'zz-prime `(ZZ-PRIME ,p))
  (dk-project! `(< 1 ,p) 'zz-prime `(ZZ-PRIME ,p))
  (pz-num! p)
  (fact 'zz-one-in)
  (dk-cite! 'zz-lt-succ-le 1 p)
  (dk-have! `(<= 2 ,p) (lambda () (dk-ineq! `(<= (+ 1 1) ,p)))))
;; P^K for K in NN: typed in ZZ, RR, CC, and 1 <= P^K (2 <= P in context)
(define (pz-pow! p k)
  (let ((pk `(power ,p ,k)))
    (dk-cite! 'pz-power-in-zz p k)
    (pz-num! pk)
    (dk-cite! 'pz-power-ge p k)
    (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-zero-le k)
    (dk-have! `(<= 1 ,pk) (lambda () (dk-ineq! `(<= (+ ,k 1) ,pk) `(<= 0 ,k))))
    pk))

;; integer cancellation
(sp (make-wff '(FORALL cq (IMPLIES (IN cq ZZ) (FORALL x (IMPLIES (IN x ZZ) (FORALL y (IMPLIES (IN y ZZ)
  (IMPLIES (NOT (= cq 0)) (IMPLIES (= (* cq x) (* cq y)) (= x y)))))))))))
(dk-peel!)
(dk-cite! 'zz-neg-closed 'y)
(pz-zz-add! 'x '(- y))
(dk-have! '(= (* (+ x (- y)) cq) 0)
  (lambda ()
    (dk-have! '(= (* (+ x (- y)) cq) (+ (* cq x) (- (* cq y)))) (lambda () (crs)))
    (subst '(= (* (+ x (- y)) cq) (+ (* cq x) (- (* cq y)))))
    (subst '(= (* cq x) (* cq y)))
    (crs)))
(dk-cite! 'zz-mul-cancel-zero '(+ x (- y)) 'cq)
(pz-num! 'x) (pz-num! 'y)
(dk-ineq! '(= (+ x (- y)) 0))
(qed 'pz-zz-cancel)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL n (IMPLIES (IN n ZZ) (IMPLIES (NOT (= n 0))
  (FORSOME k (AND (IN k NN) (ZZ-ORD-IS p n k))))))))))
(dk-peel!)
(pz-prime! 'p)
(pz-num! 'n)
(let* ((tset '(SEP cwt_ NN (NOT (ZZ-DIVIDES (power p cwt_) n))))
       (k0 '(abs n)))
  (dk-cite! 'zz-abs-in-nn 'n)
  (dk-have! `(IN ,k0 ,tset)
    (lambda ()
      (in-sep! (lambda () (dk-ass!))
        (lambda ()
          (di)
          (let ((pk (pz-pow! 'p k0)))
            (dk-cite! 'pz-dvd-bound pk 'n)
            (dk-have! `(<= 0 ,pk) (lambda () (dk-ineq! `(<= 1 ,pk))))
            (dk-cite! 'rr-abs-of-nonneg pk)
            (dk-cite! 'nn-in-rr k0)
            (dk-absurd! `(<= (abs ,pk) (abs n)) `(= (abs ,pk) ,pk) `(<= (+ ,k0 1) ,pk)))))))
  (dk-have! `(SUBSET ,tset NN) (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,tset)) (dk-ass!))))
  (dk-have! `(FORSOME cwn (IN cwn ,tset)) (lambda () (ew k0) (dk-ass!)))
  (pz-and! `(SUBSET ,tset NN) `(FORSOME cwn (IN cwn ,tset)))
  (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tset)))
         (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset) (dk-contains? f '<=))) "the least law")))
    (dk-have! `(IN ,m NN) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
    (dk-have! `(NOT (ZZ-DIVIDES (power p ,m) n)) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
    (dk-have! `(NOT (= ,m 0))
      (lambda ()
        (di)
        (dk-have! `(ZZ-DIVIDES (power p ,m) n)
          (lambda () (subst `(= ,m 0)) (subst (dk-cite! 'power-zero 'p)) (dk-cite! 'lzx-one-divides 'n) (dk-ass!)))
        (ai `(NOT (ZZ-DIVIDES (power p ,m) n)))))
    (let ((j (dk-skolem! (dk-cite! 'nn-nonzero-is-succ m))))
      (dk-have! `(ZZ-DIVIDES (power p ,j) n)
        (lambda ()
          (pbc)
          (dk-have! `(IN ,j ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-apply! least j)
          (dk-cite! 'nn-succ-closed j)
          (pz-nn-absurd! `(<= ,m ,j) `(= ,m (succ ,j)))))
      (ew j)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin
                (mac 'zz-ord-is)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin (subst `(= (succ ,j) ,m)) (dk-ass!))))))))))))
(qed 'pz-ord-exists)

(define (pz-ord-open! p n k)
  (dk-project! `(ZZ-DIVIDES (power ,p ,k) ,n) 'zz-ord-is `(ZZ-ORD-IS ,p ,n ,k))
  (dk-project! `(NOT (ZZ-DIVIDES (power ,p (succ ,k)) ,n)) 'zz-ord-is `(ZZ-ORD-IS ,p ,n ,k)))
;; NOT (A <= B) for A, B in NN (typed in RR): land B < A
(define (pz-not-le! a b)
  (pz-and! `(IN ,a RR) `(IN ,b RR))
  (dk-have! `(< ,b ,a)
    (lambda ()
      (cw-or-each! (dk-cite! 'rr-leq-total a b)
        (lambda (o)
          (if (equal? o `(<= ,a ,b))
              (begin (pbc) (ai `(NOT (<= ,a ,b))))
              (begin
                (dk-have! `(NOT (= ,b ,a)) (lambda () (di) (dk-have! `(<= ,a ,b) (lambda () (dk-ineq! `(= ,b ,a)))) (ai `(NOT (<= ,a ,b)))))
                (pz-and! `(<= ,b ,a) `(NOT (= ,b ,a)))
                (dk-cite! 'rr-le-ne-lt b a)
                (dk-ass!))))))))
;; ORD(p, n, k) in context and p^(succ k) | n derivable from p^m | n with succ k <= m: FALSITY
(define (pz-ord-too-high! p n k m)
  (dk-cite! 'nn-succ-closed k)
  (dk-cite! 'pz-power-dvd p `(succ ,k) m)
  (dk-cite! 'zz-divides-trans `(power ,p (succ ,k)) `(power ,p ,m) n)
  (ai `(NOT (ZZ-DIVIDES (power ,p (succ ,k)) ,n))))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL n (FORALL i (IMPLIES (IN i NN) (FORALL j (IMPLIES (IN j NN)
  (IMPLIES (ZZ-ORD-IS p n i) (IMPLIES (ZZ-ORD-IS p n j) (= i j))))))))))))
(dk-peel!)
(pz-prime! 'p)
(pz-ord-open! 'p 'n 'i)
(pz-ord-open! 'p 'n 'j)
(dk-cite! 'nn-in-rr 'i) (dk-cite! 'nn-in-rr 'j)
(pz-and! '(IN i RR) '(IN j RR))
(pbc)
