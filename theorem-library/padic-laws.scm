;; Proposition 1.19
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (NV-INTEGERS (QQ-PADIC p))) (FORALL k (IMPLIES (IN k NN)
  (FORSOME th (AND (IN th ZZ) (AND (<= 0 th) (AND (< th (power p k))
    (<= ((PADIC-ABS p) (- x th)) (power ((PADIC-ABS p) p) k))))))))))))))
(dk-peel!)
(pz-prime! 'p)
