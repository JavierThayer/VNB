;; Proposition 1.24
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (IMPLIES (IS-NONTRIVIAL-NV (QQ-NV vf))
  (FORSOME p (AND (ZZ-PRIME p) (FORSOME r (AND (IN r RR) (AND (< 0 r) (AND (< r 1)
    (FORALL x (IMPLIES (IN x QQ) (IMPLIES (NOT (= x 0))
      (FORALL ca (IMPLIES (IN ca ZZ) (FORALL cb (IMPLIES (IN cb ZZ) (IMPLIES (NOT (= cb 0)) (IMPLIES (= (* x cb) ca)
        (FORALL i (IMPLIES (IN i NN) (FORALL j (IMPLIES (IN j NN) (IMPLIES (ZZ-ORD-IS p ca i) (IMPLIES (ZZ-ORD-IS p cb j)
          (= (* (vf x) (power r j)) (power r i)))))))))))))))))))))))))))))
(dk-peel!)
(let* ((n0 (dk-skolem! (dk-cite! 'qo-small-exists 'vf)))
       (tset '(SEP qcn_ NN (AND (< 0 qcn_) (< (vf qcn_) 1)))))
