(dk-have! '(IN y (CARR (QQ-PADIC p))) (lambda () (subst '(= (CARR (QQ-PADIC p)) QQ)) (dk-ass!)))
(let ((h (dk-cite! 'nf-metric-distance '(QQ-PADIC p) 'x 'y)))
