;; build PADIC-REL(P, X, V) from a representation
(sp (make-wff '(FORALL p (FORALL x (IMPLIES (IN x QQ) (IMPLIES (NOT (= x 0)) (FORALL a (IMPLIES (IN a ZZ) (FORALL b (IMPLIES (IN b ZZ)
  (IMPLIES (NOT (= b 0)) (IMPLIES (= (* x b) a) (FORALL i (IMPLIES (IN i NN) (FORALL j (IMPLIES (IN j NN)
    (IMPLIES (ZZ-ORD-IS p a i) (IMPLIES (ZZ-ORD-IS p b j) (FORALL v (IMPLIES (IN v RR) (IMPLIES (= (* v (power 2 i)) (power 2 j))
      (PADIC-REL p x v))))))))))))))))))))))
(dk-peel!)
(mac 'padic-rel)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin (oi-r) (pz-witness! '(a b i j) (lambda () (error "rel-intro: open" (dk-goal))))))))
(qed 'pz-rel-intro)

;; 2^a <= 2^b for a <= b
(sp (make-wff '(FORALL ca (IMPLIES (IN ca NN) (FORALL cb (IMPLIES (IN cb NN) (IMPLIES (<= ca cb) (<= (power 2 ca) (power 2 cb)))))))))
(dk-peel!)
(let ((d (dk-skolem! (dk-cite! 'nn-le-gap 'cb 'ca))))
  (pz-two! 'ca) (pz-two! d) (pz-two! 'cb)
  (dk-have! '(IN 2 CC) (lambda () (dk-cite! 'rr-subset-cc 2) (dk-ass!)))
  (dk-cite! 'cc-power-add d 'ca 2)
  (subst `(= cb (+ ca ,d)))
  (subst `(= (power 2 (+ ca ,d)) (* (power 2 ca) (power 2 ,d))))
  (dk-cite! 'nn-succ-le-power-two d)
  (dk-cite! 'nn-in-rr d) (dk-cite! 'nn-zero-le d)
  (dk-have! `(<= 1 (power 2 ,d)) (lambda () (dk-ineq! `(<= (+ ,d 1) (power 2 ,d)) `(<= 0 ,d))))
  (fact 'rr-one-in)
  (dk-have! '(<= 0 (power 2 ca)) (lambda () (dk-ineq! '(< 0 (power 2 ca)))))
  (dk-cite! 'rr-mul-le-right 1 `(power 2 ,d) '(power 2 ca))
  (dk-cite! 'rr-one-mul '(power 2 ca))
  (cw-rr-mul! 1 '(power 2 ca)) (cw-rr-mul! `(power 2 ,d) '(power 2 ca)) (cw-rr-mul! '(power 2 ca) `(power 2 ,d))
  (dk-have! `(= (* (power 2 ,d) (power 2 ca)) (* (power 2 ca) (power 2 ,d))) (lambda () (crs)))
  (dk-ineq! `(<= (* 1 (power 2 ca)) (* (power 2 ,d) (power 2 ca))) '(= (* 1 (power 2 ca)) (power 2 ca))
            `(= (* (power 2 ,d) (power 2 ca)) (* (power 2 ca) (power 2 ,d)))))
(qed 'pz-two-mono)

;; the value is nonnegative, and positive off 0
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL v (IMPLIES (PADIC-REL p x v)
  (AND (<= 0 v) (IMPLIES (NOT (= x 0)) (< 0 v)))))))))))
(dk-peel!)
(dk-cite! 'qq-subset-rr 'x)
(fact 'rr-zero-in)
(let ((o (pz-rel-or 'p 'x 'v)))
  (cw-or-each! o
    (lambda (c)
      (if (dk-head-is? (cadr c) '=)
          (begin (dk-split! c) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (pbc) (ai '(NOT (= x 0)))) (dk-ineq! '(= v 0))))))
          (let* ((r (pz-rel-frac! c 'v)) (i (caddr r)) (j (cadddr r)) (pi_ (pz-two! i)) (pj (pz-two! j)))
            (dk-have! `(<= 0 ,pi_) (lambda () (dk-ineq! `(< 0 ,pi_))))
            (cw-rr-mul! 'v pi_) (cw-rr-mul! 0 pi_)
            (dk-have! `(= (* 0 ,pi_) 0) (lambda () (crs)))
            (dk-have! '(<= 0 v)
              (lambda ()
                (pz-and! '(IN v RR) '(IN 0 RR))
                (cw-or-each! (dk-cite! 'rr-leq-total 'v 0)
                  (lambda (o)
                    (if (equal? o '(<= v 0))
                        (begin
                          (pbc)
                          (dk-cite! 'rr-mul-le-right 'v 0 pi_)
                          (dk-absurd! `(<= (* v ,pi_) (* 0 ,pi_)) `(= (* 0 ,pi_) 0) `(= (* v ,pi_) ,pj) `(< 0 ,pj)))
                        (dk-ass!))))))
            (dk-have! '(NOT (= 0 v))
              (lambda ()
                (di)
                (let ((h (dk-rewrite-h! `(= (* v ,pi_) ,pj) 'v 0)))
                  (dk-absurd! h `(= (* 0 ,pi_) 0) `(< 0 ,pj)))))
            (dk-have! '(< 0 v)
              (lambda ()
                (pz-and! '(<= 0 v) '(NOT (= 0 v)))
                (dk-cite! 'rr-le-ne-lt 0 'v)
                (dk-ass!)))
            (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (dk-ass!)) (dk-ineq! '(< 0 v))))))))))
(qed 'pz-rel-pos)

;; the zero case of the relation
(sp (make-wff '(FORALL p (PADIC-REL p 0 0))))
(dk-peel!)
(mac 'padic-rel)
(dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'OR) (begin (oi-l) (dk-conj-close! (lambda () (rfl)))) (arith))))
(qed 'pz-rel-zero)

(define (pz-nnadd! a b) (pz-and! `(IN ,a NN) `(IN ,b NN)) (dk-cite! 'nn-add-closed a b) `(+ ,a ,b))
(define (pz-nonzero-mul! a b)
  (dk-have! `(NOT (= (* ,a ,b) 0))
    (lambda ()
      (di)
      (cw-or-each! (dk-cite! 'rr-no-zero-divisors a b)
        (lambda (o) (ai `(NOT ,o)))))))
;; 2^(m+n) = 2^m * 2^n, with the typings
(define (pz-two-add! m n)
  (pz-nnadd! m n)
  (pz-two! m) (pz-two! n) (pz-two! `(+ ,m ,n))
  (dk-have! '(IN 2 CC) (lambda () (dk-cite! 'rr-subset-cc 2) (dk-ass!)))
  (dk-cite! 'cc-power-add n m 2))

;; any representation of a nonzero z computes its value
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL z (IMPLIES (IN z QQ) (FORALL u (IMPLIES (PADIC-REL p z u) (IMPLIES (NOT (= z 0))
  (FORALL cn (IMPLIES (IN cn ZZ) (FORALL cd (IMPLIES (IN cd ZZ) (IMPLIES (NOT (= cd 0)) (IMPLIES (= (* z cd) cn)
    (FORALL s (IMPLIES (IN s NN) (FORALL tt (IMPLIES (IN tt NN) (IMPLIES (ZZ-ORD-IS p cn s) (IMPLIES (ZZ-ORD-IS p cd tt)
      (= (* u (power 2 s)) (power 2 tt)))))))))))))))))))))))
(dk-peel!)
(dk-cite! 'qq-subset-rr 'z)
(let ((o (pz-rel-or 'p 'z 'u)))
  (cw-or-each! o
    (lambda (c)
      (if (dk-head-is? (cadr c) '=)
          (begin (pbc) (dk-split! c) (ai '(NOT (= z 0))))
          (let* ((r (pz-rel-frac! c 'u)) (e (car r)) (f (cadr r)) (s2 (caddr r)) (t2 (cadddr r)))
            (for-each pz-num! (list e f 'cn 'cd))
            (pz-zz-mul! 'cn f) (pz-zz-mul! e 'cd)
            (dk-have! `(= (* cn ,f) (* ,e cd))
              (lambda () (subst '(= cn (* z cd))) (subst `(= ,e (* z ,f))) (crs)))
            (dk-cite! 'pz-ord-mult 'p 'cn f 's t2)
            (dk-cite! 'pz-ord-mult 'p e 'cd s2 'tt)
            (pz-nnadd! 's t2) (pz-nnadd! s2 'tt)
            (dk-rewrite-h! `(ZZ-ORD-IS p (* ,e cd) (+ ,s2 tt)) `(* ,e cd) `(* cn ,f))
            (dk-cite! 'pz-ord-unique 'p `(* cn ,f) `(+ s ,t2) `(+ ,s2 tt))
            (pz-two-add! 's t2) (pz-two-add! s2 'tt)
            (let ((ps '(power 2 s)) (pt '(power 2 tt)) (ps2 `(power 2 ,s2)) (pt2 `(power 2 ,t2)))
              (cw-rr-mul! ps pt2) (cw-rr-mul! ps2 pt)
              (cw-rr-mul! 'u ps) (cw-rr-mul! 'u ps2) (cw-rr-mul! pt pt2) (cw-rr-mul! pt2 pt)
              (cw-rr-mul! 'u `(* ,ps ,pt2)) (cw-rr-mul! 'u `(* ,ps2 ,pt))
              (cw-rr-mul! `(* u ,ps) pt2) (cw-rr-mul! `(* u ,ps2) pt)
              (dk-have! `(= (* u (* ,ps ,pt2)) (* u (* ,ps2 ,pt)))
                (lambda ()
                  (subst `(= (* ,ps ,pt2) (power 2 (+ s ,t2))))
                  (subst `(= (* ,ps2 ,pt) (power 2 (+ ,s2 tt))))
                  (subst `(= (+ s ,t2) (+ ,s2 tt)))
                  (rfl)))
              (dk-have! `(= (* u (* ,ps ,pt2)) (* (* u ,ps) ,pt2)) (lambda () (crs)))
              (dk-have! `(= (* u (* ,ps2 ,pt)) (* (* u ,ps2) ,pt)) (lambda () (crs)))
              (dk-have! `(= (* (* u ,ps) ,pt2) (* ,pt ,pt2))
                (lambda ()
                  (subst `(= (* (* u ,ps) ,pt2) (* u (* ,ps ,pt2))))
                  (subst `(= (* u (* ,ps ,pt2)) (* u (* ,ps2 ,pt))))
                  (subst `(= (* u (* ,ps2 ,pt)) (* (* u ,ps2) ,pt)))
                  (subst `(= (* u ,ps2) ,pt2))
                  (crs)))
              (dk-cite! 'pz-rr-cancel-pos `(* u ,ps) pt pt2)
              (dk-ass!)))))))
(qed 'pz-rel-rep)

;; the numeric heart of the ultrametric inequality
(sp (make-wff '(FORALL i (IMPLIES (IN i NN) (FORALL j (IMPLIES (IN j NN) (FORALL el (IMPLIES (IN el NN) (FORALL s (IMPLIES (IN s NN)
  (FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR)
    (IMPLIES (<= 0 v) (IMPLIES (<= (+ i el) s) (IMPLIES (= (* u (power 2 s)) (power 2 (+ j el)))
      (IMPLIES (= (* v (power 2 i)) (power 2 j)) (<= u v)))))))))))))))))))
(dk-peel!)
(pz-two-add! 'i 'el) (pz-two-add! 'j 'el) (pz-two! 's)
(dk-cite! 'pz-two-mono '(+ i el) 's)
(let ((ps '(power 2 s)) (pil '(power 2 (+ i el))) (pj '(power 2 j)) (pl '(power 2 el)) (pi_ '(power 2 i)))
  (dk-cite! 'rr-mul-le-right pil ps 'v)
  (cw-rr-mul! pil 'v) (cw-rr-mul! ps 'v) (cw-rr-mul! 'v ps) (cw-rr-mul! 'u ps) (cw-rr-mul! pj pl)
  (dk-have! `(= (* ,pil v) (* ,pj ,pl))
    (lambda () (subst `(= ,pil (* ,pi_ ,pl))) (subst `(= ,pj (* v ,pi_))) (crs)))
  (dk-have! `(= (* u ,ps) (* ,pj ,pl))
    (lambda () (subst `(= (* u ,ps) (power 2 (+ j el)))) (dk-ass!)))
  (dk-have! `(= (* ,ps v) (* v ,ps)) (lambda () (crs)))
  (dk-have! `(<= (* u ,ps) (* v ,ps))
    (lambda () (dk-ineq! `(= (* u ,ps) (* ,pj ,pl)) `(= (* ,pil v) (* ,pj ,pl)) `(<= (* ,pil v) (* ,ps v)) `(= (* ,ps v) (* v ,ps)))))
  (dk-cite! 'rr-mul-le-cancel-pos 'u ps 'v)
  (dk-ass!))
(qed 'pz-ultra-num)

;; multiplicativity of the relation
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ) (FORALL v (FORALL w
  (IMPLIES (PADIC-REL p x v) (IMPLIES (PADIC-REL p y w) (PADIC-REL p (* x y) (* v w))))))))))))))
(dk-peel!)
(pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-mul-closed 'x 'y)
(dk-cite! 'qq-subset-rr 'x) (dk-cite! 'qq-subset-rr 'y) (dk-cite! 'qq-subset-rr '(* x y))
(let* ((ov (pz-rel-or 'p 'x 'v)) (ow (pz-rel-or 'p 'y 'w)))
  (cw-rr-mul! 'v 'w)
  (cw-or-each! ov
    (lambda (cv)
      (cw-or-each! ow
        (lambda (cw)
          (let ((zv (dk-head-is? (cadr cv) '=)) (zw (dk-head-is? (cadr cw) '=)))
            (cond
              ((or zv zw)
               (let ((cz (if zv cv cw)))
                 (dk-split! cz)
                 (dk-have! '(= (* x y) 0) (lambda () (subst (cadr cz)) (crs)))
                 (dk-have! '(= (* v w) 0) (lambda () (subst (caddr cz)) (crs)))
                 (subst '(= (* x y) 0)) (subst '(= (* v w) 0))
                 (dk-cite! 'pz-rel-zero 'p)
                 (dk-ass!)))
              (#t
               (let* ((r1 (pz-rel-frac! cv 'v)) (r2 (pz-rel-frac! cw 'w))
                      (a (car r1)) (b (cadr r1)) (i (caddr r1)) (j (cadddr r1))
                      (c (car r2)) (d (cadr r2)) (k (caddr r2)) (l (cadddr r2)))
                 (for-each pz-num! (list a b c d))
                 (pz-nonzero-mul! 'x 'y)
                 (pz-zz-mul! a c) (pz-zz-mul! b d)
                 (pz-nonzero-mul! b d)
                 (dk-have! `(= (* (* x y) (* ,b ,d)) (* ,a ,c))
                   (lambda () (subst `(= ,a (* x ,b))) (subst `(= ,c (* y ,d))) (crs)))
                 (dk-cite! 'pz-ord-mult 'p a c i k)
                 (dk-cite! 'pz-ord-mult 'p b d j l)
                 (pz-two-add! i k) (pz-two-add! j l)
                 (dk-have! `(= (* (* v w) (power 2 (+ ,i ,k))) (power 2 (+ ,j ,l)))
                   (lambda ()
                     (subst `(= (power 2 (+ ,i ,k)) (* (power 2 ,i) (power 2 ,k))))
                     (subst `(= (power 2 (+ ,j ,l)) (* (power 2 ,j) (power 2 ,l))))
                     (subst `(= (power 2 ,j) (* v (power 2 ,i))))
                     (subst `(= (power 2 ,l) (* w (power 2 ,k))))
                     (crs)))
                 (dk-cite! 'pz-rel-intro 'p '(* x y) `(* ,a ,c) `(* ,b ,d) `(+ ,i ,k) `(+ ,j ,l) '(* v w))
                 (dk-ass!))))))))))
(qed 'pz-rel-mul)

;; the ultrametric inequality for the relation
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ) (FORALL v (FORALL w (FORALL u
  (IMPLIES (PADIC-REL p x v) (IMPLIES (PADIC-REL p y w) (IMPLIES (PADIC-REL p (+ x y) u) (<= u (MAX v w))))))))))))))))
(dk-peel!)
(pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-add-closed 'x 'y)
(dk-cite! 'qq-subset-rr 'x) (dk-cite! 'qq-subset-rr 'y) (dk-cite! 'qq-subset-rr '(+ x y))
(let* ((ov (pz-rel-or 'p 'x 'v)) (ow (pz-rel-or 'p 'y 'w)) (ou (pz-rel-or 'p '(+ x y) 'u)))
  (dk-split! (dk-cite! 'pz-rel-pos 'p 'x 'v))
  (dk-split! (dk-cite! 'pz-rel-pos 'p 'y 'w))
  (dk-split! (dk-cite! 'pz-rel-pos 'p '(+ x y) 'u))
  (dk-cite! 'rr-max-closed 'v 'w) (dk-cite! 'rr-le-max-left 'v 'w) (dk-cite! 'rr-le-max-right 'v 'w)
  (cw-or-each! ov
    (lambda (cv)
      (cw-or-each! ow
        (lambda (cw)
          (let ((zv (dk-head-is? (cadr cv) '=)) (zw (dk-head-is? (cadr cw) '=)))
            (cond
              ((or zv zw)
               (let* ((cz (if zv cv cw)) (other (if zv 'y 'x)) (oval (if zv 'w 'v)))
                 (dk-split! cz)
                 (dk-have! `(= (+ x y) ,other) (lambda () (subst (cadr cz)) (crs)))
                 (dk-rewrite-h! '(PADIC-REL p (+ x y) u) '(+ x y) other)
                 (dk-cite! 'pz-rel-unique 'p other 'u oval)
                 (dk-ineq! `(= u ,oval) `(<= ,oval (MAX v w)))))
              (#t
               (let* ((r1 (pz-rel-frac! cv 'v)) (r2 (pz-rel-frac! cw 'w))
                      (a (car r1)) (b (cadr r1)) (i (caddr r1)) (j (cadddr r1))
                      (c (car r2)) (d (cadr r2)) (k (caddr r2)) (l (cadddr r2)))
                 (cw-or-each! ou
                   (lambda (cu)
                     (dk-split! cu)
                     (if (dk-asm? '(= u 0))
                         (dk-ineq! '(= u 0) '(<= 0 v) '(<= v (MAX v w)))
                         (let ((nn `(+ (* ,a ,d) (* ,c ,b))) (dd `(* ,b ,d)))
                           (for-each pz-num! (list a b c d))
                           (pz-zz-mul! a d) (pz-zz-mul! c b) (pz-zz-add! `(* ,a ,d) `(* ,c ,b)) (pz-zz-mul! b d)
                           (pz-nonzero-mul! b d)
                           (pz-num! dd)
                           (pz-nonzero-mul! '(+ x y) dd)
                           (dk-have! `(= (* (+ x y) ,dd) ,nn)
                             (lambda () (subst `(= ,a (* x ,b))) (subst `(= ,c (* y ,d))) (crs)))
                           (dk-rewrite-h! `(NOT (= (* (+ x y) ,dd) 0)) `(* (+ x y) ,dd) nn)
                           (let ((s (dk-skolem! (dk-cite! 'pz-ord-exists 'p nn))))
                             (dk-cite! 'pz-ord-mult 'p a d i l)
                             (dk-cite! 'pz-ord-mult 'p c b k j)
                             (dk-cite! 'pz-ord-mult 'p b d j l)
                             (pz-nnadd! i l) (pz-nnadd! k j) (pz-nnadd! j l) (pz-nnadd! l j)
                             (dk-cite! 'pz-rel-rep 'p '(+ x y) 'u nn dd s `(+ ,j ,l))
                             (for-each (lambda (t) (dk-cite! 'nn-in-rr t)) (list `(+ ,i ,l) `(+ ,k ,j)))
                             (cw-or-each! (dk-cite! 'rr-le-total `(+ ,i ,l) `(+ ,k ,j))
                               (lambda (o)
                                 (if (equal? o `(<= (+ ,i ,l) (+ ,k ,j)))
                                     (begin
                                       (dk-cite! 'nn-le-refl `(+ ,i ,l))
                                       (dk-cite! 'pz-ord-sum 'p `(* ,a ,d) `(* ,c ,b) `(+ ,i ,l) `(+ ,k ,j) s `(+ ,i ,l))
                                       (dk-cite! 'pz-ultra-num i j l s 'u 'v)
                                       (dk-ineq! '(<= u v) '(<= v (MAX v w))))
                                     (begin
                                       (dk-cite! 'nn-le-refl `(+ ,k ,j))
                                       (dk-cite! 'pz-ord-sum 'p `(* ,a ,d) `(* ,c ,b) `(+ ,i ,l) `(+ ,k ,j) s `(+ ,k ,j))
                                       (pz-and! `(IN ,j NN) `(IN ,l NN))
                                       (dk-cite! 'nn-add-comm j l)
                                       (dk-rewrite-h! `(= (* u (power 2 ,s)) (power 2 (+ ,j ,l))) `(+ ,j ,l) `(+ ,l ,j))
                                       (dk-cite! 'pz-ultra-num k l j s 'u 'w)
                                       (dk-ineq! '(<= u w) '(<= w (MAX v w)))))))))))))))))))))
(qed 'pz-rel-ultra)

;;; -----------------------------------------------------------------------
;;; 7. The laws of |.|_p on QQ.

(define (pz-abs-typed! x)
  (dk-cite! 'pz-abs-type 'p)
  (pz-and! '(IN (PADIC-ABS p) (FUN QQ RR)) `(IN ,x QQ))
  (dk-cite! 'fun-apply-type '(PADIC-ABS p) 'QQ 'RR x))
(define (pz-abs-rel! x)
  (pz-abs-typed! x)
  (dk-cite! 'pz-abs-rel 'p x))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (PADIC-REL p x ((PADIC-ABS p) x))))))))
(dk-peel!)
(pz-abs-typed! 'x)
(let ((v (dk-skolem! (dk-cite! 'pz-rel-exists 'p 'x))))
  (dk-cite! 'pz-abs-value 'p 'x v)
  (subst `(= ((PADIC-ABS p) x) ,v))
  (dk-ass!))
(qed 'pz-abs-rel)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (<= 0 ((PADIC-ABS p) x))))))))
(dk-peel!)
(pz-abs-rel! 'x)
(dk-split! (dk-cite! 'pz-rel-pos 'p 'x '((PADIC-ABS p) x)))
(dk-ass!)
(qed 'pz-abs-nonneg)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (IFF (= ((PADIC-ABS p) x) 0) (= x 0))))))))
(dk-peel!)
(pz-abs-rel! 'x)
(dk-split! (dk-cite! 'pz-rel-pos 'p 'x '((PADIC-ABS p) x)))
(fact 'qq-zero-in)
(dk-iff! (lambda (g) (equal? g '(= x 0)))
  (lambda ()
    (pbc)
    (detach! '(IMPLIES (NOT (= x 0)) (< 0 ((PADIC-ABS p) x))))
    (dk-absurd! '(< 0 ((PADIC-ABS p) x)) '(= ((PADIC-ABS p) x) 0)))
  (lambda ()
    (dk-cite! 'pz-rel-zero 'p)
    (dk-cite! 'pz-abs-value 'p 0 0)
    (subst '(= x 0))
    (dk-ass!)))
(qed 'pz-abs-zero)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (= ((PADIC-ABS p) (* x y)) (* ((PADIC-ABS p) x) ((PADIC-ABS p) y)))))))))))
(dk-peel!)
(pz-abs-rel! 'x) (pz-abs-rel! 'y)
(pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-mul-closed 'x 'y)
(dk-cite! 'pz-rel-mul 'p 'x 'y '((PADIC-ABS p) x) '((PADIC-ABS p) y))
(cw-rr-mul! '((PADIC-ABS p) x) '((PADIC-ABS p) y))
(dk-cite! 'pz-abs-value 'p '(* x y) '(* ((PADIC-ABS p) x) ((PADIC-ABS p) y)))
(dk-ass!)
(qed 'pz-abs-mul)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (<= ((PADIC-ABS p) (+ x y)) (MAX ((PADIC-ABS p) x) ((PADIC-ABS p) y)))))))))))
(dk-peel!)
(pz-abs-rel! 'x) (pz-abs-rel! 'y)
(pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-add-closed 'x 'y)
(pz-abs-rel! '(+ x y))
(dk-cite! 'pz-rel-ultra 'p 'x 'y '((PADIC-ABS p) x) '((PADIC-ABS p) y) '((PADIC-ABS p) (+ x y)))
(dk-ass!)
(qed 'pz-abs-ultra)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (<= ((PADIC-ABS p) (+ x y)) (+ ((PADIC-ABS p) x) ((PADIC-ABS p) y)))))))))))
(dk-peel!)
(pz-abs-typed! 'x) (pz-abs-typed! 'y)
(pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-add-closed 'x 'y)
(pz-abs-typed! '(+ x y))
(let ((ax '((PADIC-ABS p) x)) (ay '((PADIC-ABS p) y)) (as '((PADIC-ABS p) (+ x y))))
  (dk-cite! 'pz-abs-ultra 'p 'x 'y)
  (dk-cite! 'pz-abs-nonneg 'p 'x) (dk-cite! 'pz-abs-nonneg 'p 'y)
  (dk-cite! 'rr-max-closed ax ay)
  (dk-have! `(<= ,ax (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ay))))
  (dk-have! `(<= ,ay (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ax))))
  (pz-and! `(IN ,ax RR) `(IN ,ay RR)) (dk-cite! 'rr-add-closed ax ay)
  (dk-cite! 'rr-max-le ax ay `(+ ,ax ,ay))
  (dk-ineq! `(<= ,as (MAX ,ax ,ay)) `(<= (MAX ,ax ,ay) (+ ,ax ,ay))))
(qed 'pz-abs-triangle)

;;; -----------------------------------------------------------------------
;;; 8. QQ-PADIC(p) is a normed field, non-archimedean.

;; the slot read-offs (rake-mat-ring-readoffs.scm's lane)
(define (pq-nth-residues e)
  (let ((found '()))
    (let walk ((t e))
      (if (pair? t)
          (begin
            (if (and (eq? (car t) 'NTH) (= (length t) 3)
                     (not (and (pair? (caddr t)) (eq? (car (caddr t)) 'LIST))))
                (if (not (member t found)) (set! found (cons t found))))
            (for-each walk (cdr t))
            (if (pair? (car t)) (walk (car t))))))
    (reverse found)))
(define (pq-read-back! acc)
  (for-each (lambda (r)
              (let ((src (list acc (caddr r))))
                (have! (list '== r src) (lambda () (slot acc) (qrfl)))
                (subst (list '== r src))))
            (pq-nth-residues (dk-goal))))
(define (pq-read-off! name acc val)
  (sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (= (,acc (QQ-PADIC p)) ,val)))))
  (dk-peel!)
  (fact 'qq-is-set)
  (dk-cite! 'pz-abs-type 'p)
  (slot acc)
  (mac 'QQ-PADIC)
  (nth-r)
  (pq-read-back! acc)
  (rfl)
  (qed name))

(pq-read-off! 'pq-carr 'CARR 'QQ)
(pq-read-off! 'pq-add 'ADD '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_)))
(pq-read-off! 'pq-mul 'MUL '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (* x_ y_)))
(pq-read-off! 'pq-neg 'NEG '(VNB-LAMBDA x_ QQ (- x_)))
(pq-read-off! 'pq-zero 'ZERO 0)
(pq-read-off! 'pq-one 'ONE 1)
(pq-read-off! 'pq-fnrm 'FNRM '(PADIC-ABS p))

;; the conjunct closers (rr-is-normed-field.scm's, at QQ with |.|_p)
(define pq-closure '((+ . qq-add-closed) (* . qq-mul-closed) (- . qq-neg-closed)))
(define (pq-open)
  (filter (lambda (s) (null? (sequent-node-in-arrows s))) (proof-open-goals *ps*)))
(define (pq-peel!)
  (let lp ((n 20))
    (let ((before (dk-goal)))
      (when (and (> n 0) (memq (dk-head before) '(FORALL IMPLIES)))
        (di)
        (if (not (equal? (dk-goal) before)) (lp (- n 1)))))))
(define (pq-beta!)
  (let lp ((n 12))
    (let ((before (dk-goal)))
      (quietly (lambda () (lam-b)))
      (when (and (> n 0) (not (equal? (dk-goal) before))) (lp (- n 1))))))
(define (pq-close-lambda-typing! g)
  (let* ((lam (cadr g)) (binder (cadr lam)) (body (cadddr lam))
         (thm (cdr (assq (car body) pq-closure)))
         (tupled? (and (pair? binder) (eq? (car binder) 'LIST)))
         (opened (dk-opened (lambda () (lam-t)))))
    (define (pick head)
      (let ((hit (filter (lambda (n) (dk-head-is? (dk-goal-of n) head)) opened)))
        (and (pair? hit) (dk-focus! (car hit)))))
    (if (null? opened) (error "pq: lam-t opened nothing on" g))
    (when (pick 'FORALL)
      (di)
      (let* ((g2 (dk-goal)) (term (cadr g2)) (args (cdr term)))
        (if (pair? (cdr args))
            (begin (dk-have! (list 'AND (list 'IN (car args) 'QQ) (list 'IN (cadr args) 'QQ)))
                   (fact thm (car args) (cadr args)))
            (fact thm (car args))))
      (ass))
    (when (pick 'IN)
      (fact 'qq-is-set)
      (when tupled?
        (dk-have! '(AND (IN QQ SET) (IN QQ SET)))
        (mac 'cartesian-set-iff))
      (ass))))
(define (pq-close-atom!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'CARTESIAN))
       (for-each (lambda (n) (dk-focus! n) (pq-close-atom!)) (dk-opened (lambda () (ci)))))
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g '<=) (eqv? (cadr g) 0))
       (dk-cite! 'pz-abs-nonneg 'p (cadr (caddr g))) (dk-ass!))
      ((dk-head-is? g 'IFF)
       (dk-cite! 'pz-abs-zero 'p (cadr (cadr (cadr g)))) (dk-ass!))
      ((and (dk-head-is? g '<=) (dk-contains? g 'PADIC-ABS))
       (let* ((arg (cadr (cadr g))))
         (dk-cite! 'pz-abs-triangle 'p (cadr arg) (caddr arg)))
       (dk-ass!))
      ((and (dk-head-is? g '=) (dk-contains? g 'PADIC-ABS))
       (let* ((arg (cadr (cadr g))))
         (dk-cite! 'pz-abs-mul 'p (cadr arg) (caddr arg)))
       (dk-ass!))
      ((memq (dk-head g) '(= <=))
       (dk-saturate-slot-ops! 'QQ pq-closure)
       (crs))
      (#t (error "pq: unexpected atom" g)))))
(define (pq-close-body! fuel)
  (if (<= fuel 0) (error "pq: body split did not terminate"))
  (pq-peel!)
  (dk-saturate-slot-ops! 'QQ pq-closure)
  (let ((g (dk-goal)))
    (cond
      ((dk-head-is? g 'AND)
       (for-each (lambda (k) (dk-focus! k) (pq-close-body! (- fuel 1))) (dk-opened (lambda () (di)))))
      ((memq (dk-head g) '(FORALL IMPLIES)) (error "pq: peel stalled on" g))
      (#t (pq-beta!) (dk-saturate-slot-ops! 'QQ pq-closure) (pq-close-atom!)))))
(define (pq-close-inverse-law!)
  (let* ((landed (dk-landed (lambda () (pq-peel!))))
         (nz (find-first (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=) (eqv? (caddr (cadr f)) 0))) landed)))
    (if (not nz) (error "pq: the inverse law landed no a /= 0" landed))
    (let* ((a (cadr (cadr nz))) (ra (list 'recip a)))
      (dk-cite! 'qq-subset-rr a)
      (pz-and! `(IN ,a QQ) `(NOT (= ,a 0))) (dk-cite! 'qq-recip-closed a)
      (pz-and! `(IN ,a RR) `(NOT (= ,a 0))) (dk-cite! 'rr-recip-inverse a)
      (dk-cite! 'qq-recip-nonzero a)
      (ew ra)
      (let lp ()
        (dk-saturate-slot-ops! 'QQ pq-closure)
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g 'AND)
                 (for-each (lambda (k) (dk-focus! k) (lp)) (dk-opened (lambda () (di)))))
                ((dk-asm? g) (ass))
                (#t (pq-beta!) (if (not (dk-asm? (dk-goal))) (error "pq: inverse atom" (dk-goal))) (ass))))))))
(define (pq-close-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'QQ-PADIC) (len-r) (arith))
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g 'IN) (number? (cadr g)))
       (fact (if (eqv? (cadr g) 0) 'qq-zero-in 'qq-one-in)) (ass))
      ((equal? g '(IN QQ SET)) (fact 'qq-is-set) (ass))
      ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'VNB-LAMBDA)) (pq-close-lambda-typing! g))
      ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses is-distributive))
       (mac (dk-head g)) (pq-close-body! 20))
      ((dk-head-is? g 'is-norm)
       (mac 'is-norm)
       (for-each (lambda (k)
                   (dk-focus! k)
                   (if (dk-asm? (dk-goal)) (ass) (pq-close-body! 20)))
                 (dk-opened (lambda () (di)))))
      ((equal? g '(NOT (= 0 1))) (arith))
      ((dk-head-is? g 'FORALL) (pq-close-inverse-law!))
      (#t (error "pq: unexpected conjunct" g)))))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-NORMED-FIELD (QQ-PADIC p))))))
(dk-peel!)
(fact 'qq-is-set)
(dk-cite! 'pz-abs-type 'p)
(mac 'IS-NORMED-FIELD)
(dk-isx-set!)   ; W1J-B: the conjunct t in SET, from the typings
(for-each (lambda (r) (mac r)) '(pq-carr pq-add pq-mul pq-neg pq-zero pq-one pq-fnrm))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (pq-open))))
    (when andl
      (if (= fuel 0) (error "pq: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(let sweep ((fuel 40))
  (let* ((open (pq-open)) (n (length open)))
    (when (pair? open)
      (if (= fuel 0) (error "pq: sweep out of fuel"))
      (dk-focus! (car open))
      (let ((g (dk-goal)))
        (pq-close-leaf!)
        (if (>= (length (pq-open)) n) (error "pq: this conjunct did not close" g)))
      (sweep (- fuel 1)))))
(qed 'qq-padic-is-normed-field)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-NV-FIELD (QQ-PADIC p))))))
(dk-peel!)
(dk-cite! 'qq-padic-is-normed-field 'p)
(fact 'qq-is-set)
(dk-cite! 'pz-abs-type 'p)
(mac 'IS-NV-FIELD)
(for-each (lambda (r) (mac r)) '(pq-carr pq-add pq-fnrm))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (dk-ass!)
        (begin
          (pq-peel!)
          (dk-saturate-slot-ops! 'QQ pq-closure)
          (pq-beta!)
          (let* ((g (dk-goal)) (arg (cadr (cadr g))))
            (dk-cite! 'pz-abs-ultra 'p (cadr arg) (caddr arg))
            (dk-ass!))))))
(qed 'qq-padic-is-nv-field)

;;; =======================================================================
;;; CCR.pdf section 1.2: Proposition 1.19, Corollary 1.21, Proposition 1.24 (helpers pc-, qn-, qo-).

;;; -----------------------------------------------------------------------
;;; A. Bezout against a prime and its powers; |n|_p <= 1 on ZZ; |p^k|_p = |p|_p^k.

(define (pc-succ-var g)
  (let walk ((t g))
    (cond ((and (pair? t) (eq? (car t) 'succ) (symbol? (cadr t))) (cadr t))
          ((pair? t) (or (walk (car t)) (walk (cdr t))))
          (#t #f))))

;; p does not divide b: m p + n b = 1 for some integers m, n
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL cb (IMPLIES (IN cb ZZ) (IMPLIES (NOT (ZZ-DIVIDES p cb))
  (FORSOME cm (AND (IN cm ZZ) (FORSOME cn (AND (IN cn ZZ) (= (+ (* cm p) (* cn cb)) 1))))))))))))
(dk-peel!)
(pz-prime! 'p)
(let ((u (dk-project! '(FORALL cpd_ (IMPLIES (IN cpd_ ZZ) (IMPLIES (ZZ-DIVIDES cpd_ p)
                          (OR (= cpd_ 1) (OR (= cpd_ (- 1)) (OR (= cpd_ p) (= cpd_ (- p))))))))
                      'zz-prime '(ZZ-PRIME p))))
  (let* ((d (dk-skolem! (dk-cite! 'zz-bezout 'p 'cb)))
         (bm (pz-iff-fwd! (dk-cite! 'zz-bezout-set-membership 'p 'cb d)))
         (x (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f d) (dk-contains? f '+))) "the bezout x")))
         (y (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f d) (dk-contains? f '+))) "the bezout y")))
         (s `(+ (* ,x p) (* ,y cb))))
    (cw-or-each! (dk-apply! u d)
      (lambda (o)
        (let ((dv (caddr o)))
          (cond
            ((eqv? dv 1)
             (pz-witness! (list x y) (lambda () (subst `(= ,s ,d)) (subst `(= ,d 1)) (arith))))
            ((equal? dv '(- 1))
             (dk-cite! 'zz-neg-closed x) (dk-cite! 'zz-neg-closed y)
             (pz-witness! (list `(- ,x) `(- ,y))
               (lambda ()
                 (dk-have! `(= (+ (* (- ,x) p) (* (- ,y) cb)) (- ,s)) (lambda () (crs)))
                 (subst `(= (+ (* (- ,x) p) (* (- ,y) cb)) (- ,s)))
                 (subst `(= ,s ,d)) (subst `(= ,d (- 1))) (arith))))
            (#t
             (pbc)
             (let ((c (pz-dvd-open! d 'cb)))
               (dk-have! '(ZZ-DIVIDES p cb)
                 (lambda ()
                   (dk-cite! 'zz-neg-closed c)
                   (pz-dvd-close! (if (equal? dv 'p) c `(- ,c))
                     (lambda () (subst `(= cb (* ,d ,c))) (subst `(= ,d ,dv)) (crs)))))
               (ai '(NOT (ZZ-DIVIDES p cb)))))))))))
(qed 'pc-bezout-prime)

;; ... and against every power of p
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL p (IMPLIES (IN p ZZ) (FORALL cb (IMPLIES (IN cb ZZ)
  (IMPLIES (FORSOME cm (AND (IN cm ZZ) (FORSOME cn (AND (IN cn ZZ) (= (+ (* cm p) (* cn cb)) 1)))))
    (FORSOME cm (AND (IN cm ZZ) (FORSOME cn (AND (IN cn ZZ) (= (+ (* cm (power p k)) (* cn cb)) 1))))))))))))))
(let* ((bs (pz-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (pz-num! 'p) (pz-num! 'cb)
  (fact 'zz-one-in) (fact 'zz-zero-in)
  (dk-cite! 'power-zero 'p)
  (pz-witness! '(1 0) (lambda () (subst '(= (power p 0) 1)) (crs)))
  (dk-focus! step)
  (dk-peel!)
  (let* ((n (pc-succ-var (dk-goal)))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'power))) "the IH"))
         (h1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (not (dk-contains? f 'power)))) "the bezout hypothesis")))
    (pz-num! 'p) (pz-num! 'cb)
    (dk-apply! ih 'p 'cb)
    (let* ((m1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'power))) "IH m")))
           (n1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'power))) "IH n")))
           (m0 (dk-skolem! h1))
           (n0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (not (dk-contains? f 'power)))) "hyp n")))
           (pk `(power p ,n)))
      (dk-cite! 'pz-power-in-zz 'p n)
      (pz-and! '(IN p CC) `(IN ,n NN))
      (dk-cite! 'power-succ 'p n)
      (pz-zz-mul! m1 m0)
      (pz-zz-mul! m1 pk) (pz-zz-mul! `(* ,m1 ,pk) n0)
      (pz-zz-mul! n1 m0) (pz-zz-mul! `(* ,n1 ,m0) 'p)
      (pz-zz-mul! n1 n0) (pz-zz-mul! `(* ,n1 ,n0) 'cb)
      (pz-zz-add! `(* (* ,m1 ,pk) ,n0) `(* (* ,n1 ,m0) p))
      (pz-zz-add! `(+ (* (* ,m1 ,pk) ,n0) (* (* ,n1 ,m0) p)) `(* (* ,n1 ,n0) cb))
      (let ((nn `(+ (+ (* (* ,m1 ,pk) ,n0) (* (* ,n1 ,m0) p)) (* (* ,n1 ,n0) cb)))
            (lhs `(+ (* (* ,m1 ,m0) (* p ,pk)) (* (+ (+ (* (* ,m1 ,pk) ,n0) (* (* ,n1 ,m0) p)) (* (* ,n1 ,n0) cb)) cb))))
        (pz-witness! (list `(* ,m1 ,m0) nn)
          (lambda ()
            (subst `(= (power p (succ ,n)) (* p ,pk)))
            (dk-have! `(= ,lhs (* (+ (* ,m1 ,pk) (* ,n1 cb)) (+ (* ,m0 p) (* ,n0 cb)))) (lambda () (crs)))
            (subst `(= ,lhs (* (+ (* ,m1 ,pk) (* ,n1 cb)) (+ (* ,m0 p) (* ,n0 cb)))))
            (subst `(= (+ (* ,m1 ,pk) (* ,n1 cb)) 1))
            (subst `(= (+ (* ,m0 p) (* ,n0 cb)) 1))
            (arith)))))))
(qed 'pc-bezout-power-ind)

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL cb (IMPLIES (IN cb ZZ) (IMPLIES (NOT (ZZ-DIVIDES p cb))
  (FORALL k (IMPLIES (IN k NN)
    (FORSOME cm (AND (IN cm ZZ) (FORSOME cn (AND (IN cn ZZ) (= (+ (* cm (power p k)) (* cn cb)) 1))))))))))))))
(dk-peel!)
(pz-prime! 'p)
(dk-cite! 'pc-bezout-prime 'p 'cb)
(dk-cite! 'pc-bezout-power-ind 'k 'p 'cb)
(dk-ass!)
(qed 'pc-bezout-power)

;; |1|_p = 1
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (= ((PADIC-ABS p) 1) 1)))))
(dk-peel!)
(fact 'qq-one-in) (fact 'zz-one-in) (fact 'nn-zero-in) (fact 'rr-one-in)
(dk-cite! 'pz-ord-one 'p)
(dk-have! '(NOT (= 1 0)) (lambda () (arith)))
(dk-have! '(= (* 1 1) 1) (lambda () (crs)))
(dk-have! '(= (* 1 (power 2 0)) (power 2 0)) (lambda () (crs)))
(dk-cite! 'pz-rel-intro 'p 1 1 1 0 0 1)
(dk-cite! 'pz-abs-value 'p 1 1)
(dk-ass!)
(qed 'pc-abs-one)

;; |n|_p <= 1 for every integer n
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL cn (IMPLIES (IN cn ZZ) (<= ((PADIC-ABS p) cn) 1)))))))
(dk-peel!)
(pz-num! 'cn)
(pz-abs-rel! 'cn)
(let ((v '((PADIC-ABS p) cn)))
  (dk-cite! 'pz-abs-nonneg 'p 'cn)
  (cw-or-each! (pz-rel-or 'p 'cn v)
    (lambda (c)
      (dk-split! c)
      (if (dk-asm? `(= ,v 0))
          (dk-ineq! `(= ,v 0))
          (let ((i (dk-skolem! (dk-cite! 'pz-ord-exists 'p 'cn))))
            (dk-cite! 'pz-ord-one 'p)
            (fact 'zz-one-in) (fact 'nn-zero-in)
            (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
            (dk-have! '(= (* cn 1) cn) (lambda () (crs)))
            (dk-cite! 'pz-rel-rep 'p 'cn v 'cn 1 i 0)
            (pz-two! i) (pz-two! 0)
            (dk-have! '(IN 2 CC) (lambda () (dk-cite! 'rr-subset-cc 2) (dk-ass!)))
            (dk-cite! 'power-zero 2)
            (dk-cite! 'nn-zero-le i)
            (dk-cite! 'pz-two-mono 0 i)
            (dk-cite! 'rr-mul-le-right '(power 2 0) `(power 2 ,i) v)
            (cw-rr-mul! '(power 2 0) v) (cw-rr-mul! `(power 2 ,i) v) (cw-rr-mul! v `(power 2 ,i))
            (dk-have! `(= (* (power 2 0) ,v) ,v) (lambda () (subst '(= (power 2 0) 1)) (crs)))
            (dk-have! `(= (* (power 2 ,i) ,v) (* ,v (power 2 ,i))) (lambda () (crs)))
            (dk-ineq! `(<= (* (power 2 0) ,v) (* (power 2 ,i) ,v)) `(= (* (power 2 0) ,v) ,v)
                      `(= (* (power 2 ,i) ,v) (* ,v (power 2 ,i))) `(= (* ,v (power 2 ,i)) (power 2 0)) '(= (power 2 0) 1)))))))
(qed 'pc-abs-int)

;; |p^k|_p = |p|_p^k
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL p (IMPLIES (ZZ-PRIME p) (= ((PADIC-ABS p) (power p k)) (power ((PADIC-ABS p) p) k))))))))
(let* ((bs (pz-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (pz-prime! 'p)
  (pz-abs-typed! 'p)
  (dk-cite! 'rr-subset-cc '((PADIC-ABS p) p))
  (dk-cite! 'power-zero 'p)
  (dk-cite! 'power-zero '((PADIC-ABS p) p))
  (subst '(= (power p 0) 1))
  (subst '(= (power ((PADIC-ABS p) p) 0) 1))
  (dk-cite! 'pc-abs-one 'p)
  (dk-ass!)
  (dk-focus! step)
  (dk-peel!)
  (let* ((n (pc-succ-var (dk-goal)))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'power))) "the IH"))
         (pk `(power p ,n)) (ap '((PADIC-ABS p) p)))
    (pz-prime! 'p)
    (dk-apply! ih 'p)
    (pz-abs-typed! 'p)
    (dk-cite! 'rr-subset-cc ap)
    (pz-and! '(IN p CC) `(IN ,n NN)) (dk-cite! 'power-succ 'p n)
    (pz-and! `(IN ,ap CC) `(IN ,n NN)) (dk-cite! 'power-succ ap n)
    (dk-cite! 'pz-power-in-zz 'p n) (pz-num! pk)
    (dk-cite! 'zz-subset-qq 'p)
