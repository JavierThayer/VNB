                          (begin (oi-r) (oi-l) (dk-ineq! o `(= ,a 1)))
                          (begin (oi-l) (dk-ineq! o `(= ,a 1)))))))
                (lambda ()
                  (use-em `(= ,b 1)
                    (lambda ()
                      (fact 'rr-one-in)
                      (let ((h (dk-rewrite-h! `(= (* ,a ,b) p) b 1)))
                        (cw-rr-mul! a 1)
                        (dk-have! `(= (* ,a 1) ,a) (lambda () (crs)))
                        (dk-have! `(= ,a p) (lambda () (dk-ineq! h `(= (* ,a 1) ,a))))
                        (cw-or-each! cases
                          (lambda (o)
