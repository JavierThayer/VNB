    (dk-cite! 'power-real-closed '((PADIC-ABS p) p) k)
    (pz-two! k)
    (cw-rr-mul! 'eps tk) (cw-rr-mul! ap tk)
    (dk-have! `(NOT (<= eps ,ap))
      (lambda ()
        (di)
        (dk-have! `(<= 0 ,tk) (lambda () (dk-ineq! `(< 0 ,tk))))
        (dk-cite! 'rr-mul-le-right 'eps ap tk)
        (dk-absurd! `(<= (* eps ,tk) (* ,ap ,tk)) `(= (* ,ap ,tk) 1) `(< 1 (* eps ,tk)))))
    (dk-cite! 'rr-not-le-lt 'eps ap)
    (let ((th (dk-skolem! (dk-cite! 'ccr-1-19 'p 'x k))))
      (pz-num! th)
      (dk-cite! 'qq-neg-closed th)
      (pz-and! '(IN x QQ) `(IN (- ,th) QQ)) (dk-cite! 'qq-add-closed 'x `(- ,th))
      (pz-abs-typed! `(+ x (- ,th)))
      (dk-have! `(= (- x ,th) (+ x (- ,th))) (lambda () (mac 'binary-minus-def) (rfl)))
      (dk-rewrite-h! `(<= ((PADIC-ABS p) (- x ,th)) (power ((PADIC-ABS p) p) ,k)) `(- x ,th) `(+ x (- ,th)))
      (let ((dx `((PADIC-ABS p) (+ x (- ,th)))))
        (dk-have! `(IN ,th (PTS ,ms)) (lambda () (subst `(== (PTS ,ms) (CARR ,kf))) (subst `(= (CARR ,kf) QQ)) (dk-ass!)))
        (dk-have! '(IN x (PTS (NF-METRIC-SPACE (QQ-PADIC p)))) (lambda () (subst `(== (PTS ,ms) (CARR ,kf))) (subst `(= (CARR ,kf) QQ)) (dk-ass!)))
        (let* ((e2 (dk-cite! 'metric-sym ms th 'x))
               (e3 (dk-cite! 'pc-dist 'p 'x th)))
          (pz-witness! (list th)
            (lambda ()
              (subst e2) (subst e3)
              (dk-ineq! `(<= ,dx (power ((PADIC-ABS p) p) ,k)) `(= ,ap (power ((PADIC-ABS p) p) ,k)) `(< ,ap eps)))))))))
(qed 'ccr-1-20)

;;; =======================================================================
;;; Remark 5.21 (with Lemma 5.17, Definition 5.18 and Proposition 5.20 on Q): the p-adic character of Q.
;;; e(r) = exp(2 pi i r); tpi = 2 pi i.  Cites ch-cc-cancel (ccr4-chars), which must load first.

(define (dk-have-f claim thunk) (dk-have! claim thunk) claim)
(define pc-tpi '(* (* 2 pi) +i))
(define (pc-e r) `(cc-exp (* ,pc-tpi ,r)))
;; 2 pi i in CC and /= 0
(define (pc-tpi! )
  (if (not (dk-asm? `(IN ,pc-tpi CC)))
      (begin
        (if (not (dk-asm? '(< 0 pi))) (dk-split! (dk-cite! 'pi-pos)))
        (dk-have! '(IN 2 RR) (lambda () (arith)))
        (cw-rr-mul! 2 'pi)
        (dk-cite! 'rr-subset-cc '(* 2 pi))
        (fact 'cc-i-in)
        (pz-and! '(IN (* 2 pi) CC) '(IN +i CC)) (dk-cite! 'cc-mul-closed '(* 2 pi) +i)
        (dk-cite! 'cc-magnitude-mul '(* 2 pi) +i)
        (fact 'cc-magnitude-i)
        (dk-cite! 'rr-magnitude-is-abs '(* 2 pi))
        (dk-have! '(<= 0 (* 2 pi)) (lambda () (dk-ineq! '(< 0 pi))))
        (dk-cite! 'rr-abs-of-nonneg '(* 2 pi))
        (dk-cite! 'cc-magnitude-closed pc-tpi)
        (dk-have! `(NOT (= ,pc-tpi 0))
          (lambda ()
            (di)
            (let ((h (dk-rewrite-h! `(= (magnitude ,pc-tpi) (* (magnitude (* 2 pi)) (magnitude +i))) pc-tpi 0)))
              (fact 'cc-zero-in) (dk-cite! 'cc-magnitude-closed 0) (fact 'cc-magnitude-zero)
              (dk-cite! 'cc-magnitude-closed '(* 2 pi))
              (dk-cite! 'cc-magnitude-closed +i)
              (cw-rr-mul! '(magnitude (* 2 pi)) '(magnitude +i))
              (dk-have! '(= (* (magnitude (* 2 pi)) (magnitude +i)) (magnitude (* 2 pi)))
                (lambda () (subst '(= (magnitude +i) 1)) (crs)))
              (dk-absurd! h '(= (magnitude 0) 0) '(= (* (magnitude (* 2 pi)) (magnitude +i)) (magnitude (* 2 pi)))
                          '(= (magnitude (* 2 pi)) (abs (* 2 pi))) '(= (abs (* 2 pi)) (* 2 pi)) '(< 0 pi))))))))
;; R in RR: land tpi R in CC, e(R) in CC
(define (pc-e-typed! r)
  (pc-tpi!)
  (dk-cite! 'rr-subset-cc r)
  (pz-and! `(IN ,pc-tpi CC) `(IN ,r CC)) (dk-cite! 'cc-mul-closed pc-tpi r)
  (dk-split! (dk-cite! 'cc-exp-converges `(* ,pc-tpi ,r))))

;; e(k) = 1 on ZZ
(sp (make-wff '(FORALL ke (IMPLIES (IN ke ZZ) (= (cc-exp (* (* (* 2 pi) +i) ke)) 1)))))
(dk-peel!)
(pz-num! 'ke)
(pc-e-typed! 'ke)
(let ((iff (dk-cite! 'cc-exp-one-iff `(* ,pc-tpi ke))))
  (ai iff)
  (dk-have! (caddr iff)
    (lambda () (ew 'ke) (dk-conj-close! (lambda () (if (not (dk-ass!)) (crs))))))
  (detach! `(IMPLIES ,(caddr iff) ,(cadr iff)))
  (dk-ass!))
(qed 'pc-e-int)

;; e(r + s) = e(r) e(s)
(sp (make-wff '(FORALL cr (IMPLIES (IN cr RR) (FORALL cs (IMPLIES (IN cs RR)
  (= (cc-exp (* (* (* 2 pi) +i) (+ cr cs))) (* (cc-exp (* (* (* 2 pi) +i) cr)) (cc-exp (* (* (* 2 pi) +i) cs))))))))))
(dk-peel!)
(pc-e-typed! 'cr) (pc-e-typed! 'cs)
(pz-and! '(IN cr RR) '(IN cs RR)) (dk-cite! 'rr-add-closed 'cr 'cs)
(pc-e-typed! '(+ cr cs))
(dk-have! `(= (* ,pc-tpi (+ cr cs)) (+ (* ,pc-tpi cr) (* ,pc-tpi cs))) (lambda () (crs)))
(subst `(= (* ,pc-tpi (+ cr cs)) (+ (* ,pc-tpi cr) (* ,pc-tpi cs))))
(dk-cite! 'cc-exp-add `(* ,pc-tpi cr) `(* ,pc-tpi cs))
(dk-ass!)
(qed 'pc-e-add)

;; e(r) = 1 forces r in ZZ
(sp (make-wff '(FORALL cr (IMPLIES (IN cr RR) (IMPLIES (= (cc-exp (* (* (* 2 pi) +i) cr)) 1) (IN cr ZZ))))))
(dk-peel!)
(pc-e-typed! 'cr)
(pz-iff-fwd! (dk-cite! 'cc-exp-one-iff `(* ,pc-tpi cr)))
(let ((k (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'pi))) "the multiple"))))
  (pz-num! k)
  (dk-have! `(= (* ,pc-tpi cr) (* ,pc-tpi ,k))
    (lambda () (subst `(= (* ,pc-tpi cr) (* ,k ,pc-tpi))) (crs)))
  (dk-cite! 'ch-cc-cancel pc-tpi 'cr k)
  (subst `(= cr ,k))
  (dk-ass!))
(qed 'pc-e-one-int)

;; e(r) lies on the unit circle
(sp (make-wff '(FORALL cr (IMPLIES (IN cr RR) (IN (cc-exp (* (* (* 2 pi) +i) cr)) UNIT-CIRCLE)))))
(dk-peel!)
(pc-e-typed! 'cr)
(if (not (dk-asm? '(< 0 pi))) (dk-split! (dk-cite! 'pi-pos)))
(dk-have! '(IN 2 RR) (lambda () (arith)))
(cw-rr-mul! 2 'pi) (cw-rr-mul! '(* 2 pi) 'cr)
(dk-cite! 'cc-exp-magnitude-imaginary '(* (* 2 pi) cr))
(dk-have! `(= (* ,pc-tpi cr) (* +i (* (* 2 pi) cr))) (lambda () (crs)))
(mac 'unit-circle-membership)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin (subst `(= (* ,pc-tpi cr) (* +i (* (* 2 pi) cr)))) (dk-ass!)))))
(qed 'pc-e-unit)

;; |-w|_p = |w|_p
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL w (IMPLIES (IN w QQ) (= ((PADIC-ABS p) (- w)) ((PADIC-ABS p) w))))))))
(dk-peel!)
(fact 'zz-one-in) (dk-cite! 'zz-neg-closed 1) (pz-num! '(- 1))
(dk-cite! 'qq-neg-closed 'w)
(pz-abs-typed! '(- 1)) (pz-abs-typed! 'w) (pz-abs-typed! '(- w))
(let ((t1 '((PADIC-ABS p) (- 1))))
  (fact 'qq-one-in) (fact 'rr-one-in)
  (dk-cite! 'pc-abs-one 'p)
  (pz-abs-typed! 1)
  (let ((h (dk-cite! 'pz-abs-mul 'p '(- 1) '(- 1))))
    (dk-have! '(= (* (- 1) (- 1)) 1) (lambda () (arith)))
    (dk-rewrite-h! h '(* (- 1) (- 1)) 1))
  (dk-cite! 'pc-abs-int 'p '(- 1))
  (dk-cite! 'pz-abs-nonneg 'p '(- 1))
  (dk-cite! 'rr-mul-le-right t1 1 t1)
  (cw-rr-mul! t1 t1) (cw-rr-mul! 1 t1)
  (dk-have! `(= (* 1 ,t1) ,t1) (lambda () (crs)))
  (dk-have! `(= ,t1 1) (lambda () (dk-ineq! `(<= (* ,t1 ,t1) (* 1 ,t1)) `(= (* 1 ,t1) ,t1) `(= ((PADIC-ABS p) 1) (* ,t1 ,t1)) '(= ((PADIC-ABS p) 1) 1) `(<= ,t1 1))))
  (dk-cite! 'pz-abs-mul 'p '(- 1) 'w)
  (dk-have! '(= (- w) (* (- 1) w)) (lambda () (crs)))
  (subst '(= (- w) (* (- 1) w)))
  (subst `(= ((PADIC-ABS p) (* (- 1) w)) (* ,t1 ((PADIC-ABS p) w))))
  (subst `(= ,t1 1))
  (cw-rr-mul! 1 '((PADIC-ABS p) w))
  (crs))
(qed 'pc-abs-neg)

;; an integer prime to p has |m|_p = 1
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL cm (IMPLIES (IN cm ZZ) (IMPLIES (NOT (ZZ-DIVIDES p cm)) (= ((PADIC-ABS p) cm) 1))))))))
(dk-peel!)
(pz-prime! 'p)
(pz-num! 'cm)
(dk-have! '(NOT (= cm 0)) (lambda () (di) (dk-cite! 'pz-dvd-zero 'p) (ai (dk-rewrite-h! '(NOT (ZZ-DIVIDES p cm)) 'cm 0))))
(fact 'nn-zero-in) (fact 'zz-one-in)
(pz-pow! 'p 0)
(dk-cite! 'power-zero 'p)
(dk-have! '(ZZ-ORD-IS p cm 0)
  (lambda ()
    (mac 'zz-ord-is)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'ZZ-DIVIDES)
            (begin (subst '(= (power p 0) 1)) (pz-dvd-close! 'cm (lambda () (crs))))
            (begin
              (dk-cite! 'nn-succ-closed 0)
              (pz-and! '(IN p CC) '(IN 0 NN)) (dk-cite! 'power-succ 'p 0)
              (subst '(= (power p (succ 0)) (* p (power p 0))))
              (subst '(= (power p 0) 1))
              (dk-have! '(= (* p 1) p) (lambda () (crs)))
              (subst '(= (* p 1) p))
              (dk-ass!)))))))
(dk-cite! 'zz-subset-qq 'cm)
(pz-abs-rel! 'cm)
(dk-cite! 'pz-ord-one 'p)
(dk-have! '(NOT (= 1 0)) (lambda () (arith)))
(dk-have! '(= (* cm 1) cm) (lambda () (crs)))
(let ((h (dk-cite! 'pz-rel-rep 'p 'cm '((PADIC-ABS p) cm) 'cm 1 0 0)))
  (dk-have! '(IN 2 CC) (lambda () (dk-cite! 'rr-subset-cc 2) (dk-ass!)))
  (dk-cite! 'power-zero 2)
  (pz-two! 0)
  (cw-rr-mul! '((PADIC-ABS p) cm) '(power 2 0))
  (dk-have! '(= (* ((PADIC-ABS p) cm) (power 2 0)) ((PADIC-ABS p) cm)) (lambda () (subst '(= (power 2 0) 1)) (crs)))
  (dk-ineq! h '(= (* ((PADIC-ABS p) cm) (power 2 0)) ((PADIC-ABS p) cm)) '(= (power 2 0) 1)))
(qed 'pc-abs-unit)

;; Lemma 5.17's integrality step: |y|_p <= 1 and y p^m in ZZ give y in ZZ
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL y (IMPLIES (IN y QQ) (IMPLIES (<= ((PADIC-ABS p) y) 1)
  (FORALL cm (IMPLIES (IN cm NN) (IMPLIES (IN (* y (power p cm)) ZZ) (IN y ZZ)))))))))))
(dk-peel!)
(pz-prime! 'p)
(dk-cite! 'qq-subset-rr 'y)
(let* ((b1 (dk-skolem! (dk-cite! 'pc-int-denominator 'p 'y)))
       (pk (pz-pow! 'p 'cm))
       (u (dk-skolem! (dk-cite! 'pc-bezout-power 'p b1 'cm)))
       (v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f b1) (dk-contains? f 'power))) "bezout v")))
       (e `(= (+ (* ,u ,pk) (* ,v ,b1)) 1))
       (yp `(* y ,pk)) (yb `(* y ,b1))
       (rhs `(+ (* ,u ,yp) (* ,v ,yb))))
  (pz-num! b1) (pz-num! u) (pz-num! v)
  (let* ((h (dk-have-f `(= (* y (+ (* ,u ,pk) (* ,v ,b1))) ,rhs) (lambda () (crs))))
         (h2 (dk-rewrite-h! h `(+ (* ,u ,pk) (* ,v ,b1)) 1)))
    (dk-have! '(= (* y 1) y) (lambda () (crs)))
    (let ((h3 (dk-rewrite-h! h2 '(* y 1) 'y)))
      (subst h3)
      (pz-zz-mul! u yp) (pz-zz-mul! v yb)
      (pz-zz-add! `(* ,u ,yp) `(* ,v ,yb))
      (dk-ass!))))
(qed 'pc-frac-int)

;; (PADIC-FRAC-REP P X R) as the goal, its pieces in context (R in QQ, R P^M = Z with Z in ZZ, M in NN, the bound)
(define (pc-rep-close! z m)
  (mac 'padic-frac-rep)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'FORSOME) (pz-witness! (list z m) (lambda () (error "pc-rep-close!: open" (dk-goal)))))
            (#t (error "pc-rep-close!: open" (dk-goal)))))))
;; (PADIC-FRAC-REP P X R) in context: land R in QQ, the bound, R P^M = Z; return (Z M)
(define (pc-rep-open! p x r)
  (let ((h `(PADIC-FRAC-REP ,p ,x ,r)))
    (dk-project! `(IN ,r QQ) 'padic-frac-rep h)
    (dk-project! `(<= ((PADIC-ABS ,p) (+ ,x (- ,r))) 1) 'padic-frac-rep h)
    (let* ((z (dk-skolem! (dk-project! `(FORSOME cpz_ (AND (IN cpz_ ZZ) (FORSOME cpm_ (AND (IN cpm_ NN) (= (* ,r (power ,p cpm_)) cpz_)))))
                                       'padic-frac-rep h)))
           (m (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z) (dk-contains? f r))) "the exponent"))))
      (list z m))))

;; Lemma 5.17 on Q: every x has a p-adic fractional part
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORSOME cr (PADIC-FRAC-REP p x cr))))))))
(dk-peel!)
(pz-prime! 'p)
(dk-cite! 'qq-subset-rr 'x)
(let* ((a (dk-skolem! (dk-cite! 'qq-is-fraction 'x)))
       (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'recip))) "the denominator"))))
  (pz-num! a) (pz-num! b)
  (dk-cite! 'rr-recip-cancel-right a b)
  (dk-have! `(= (* x ,b) ,a) (lambda () (subst `(= x (* ,a (recip ,b)))) (subst `(= (* (* ,a (recip ,b)) ,b) ,a)) (rfl)))
  (let* ((j (dk-skolem! (dk-cite! 'pz-ord-exists 'p b)))
         (pj (begin (pz-ord-open! 'p b j) (pz-pow! 'p j)))
         (b1 (pz-dvd-open! pj b)))
    (pz-num! b1)
    (dk-have! `(NOT (ZZ-DIVIDES p ,b1))
      (lambda ()
        (di)
        (let ((c2 (pz-dvd-open! 'p b1)))
          (dk-cite! 'nn-succ-closed j)
          (dk-cite! 'pz-power-in-zz 'p `(succ ,j))
          (pz-and! '(IN p CC) `(IN ,j NN)) (dk-cite! 'power-succ 'p j)
          (dk-have! `(ZZ-DIVIDES (power p (succ ,j)) ,b)
            (lambda ()
              (pz-dvd-close! c2
                (lambda () (subst `(= ,b (* ,pj ,b1))) (subst `(= ,b1 (* p ,c2))) (subst `(= (power p (succ ,j)) (* p ,pj))) (crs)))))
          (ai `(NOT (ZZ-DIVIDES (power p (succ ,j)) ,b))))))
    (let* ((u (dk-skolem! (dk-cite! 'pc-bezout-power 'p b1 j)))
           (v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f b1) (dk-contains? f 'power))) "bezout v"))))
      (pz-num! u) (pz-num! v)
      (pz-zz-mul! a v) (pz-zz-mul! a u) (pz-num! `(* ,a ,v)) (pz-num! `(* ,a ,u))
      (dk-have! `(NOT (= ,pj 0)) (lambda () (di) (dk-absurd! `(= ,pj 0) `(<= 1 ,pj))))
      (dk-cite! 'zz-subset-qq pj)
      (pz-and! `(IN ,pj QQ) `(NOT (= ,pj 0))) (dk-cite! 'qq-recip-closed pj)
      (pz-and! `(IN (* ,a ,v) QQ) `(IN (recip ,pj) QQ)) (dk-cite! 'qq-mul-closed `(* ,a ,v) `(recip ,pj))
      (dk-cite! 'rr-recip-cancel-right `(* ,a ,v) pj)
      (let* ((rr `(* (* ,a ,v) (recip ,pj)))
             (rn (dk-name! rr 'QQ))
             (e1 (dk-rewrite-h! `(= (* ,a ,v) (* ,rr ,pj)) rr rn))
             (w `(+ x (- ,rn))))
        (dk-cite! 'qq-subset-rr rn)
        (dk-cite! 'qq-neg-closed rn)
        (pz-and! '(IN x QQ) `(IN (- ,rn) QQ)) (dk-cite! 'qq-add-closed 'x `(- ,rn))
        (dk-cite! 'qq-subset-rr w)
        (cw-rr-mul! w b1) (cw-rr-mul! `(* ,w ,b1) pj) (cw-rr-mul! `(* ,a ,u) pj) (cw-rr-mul! `(* ,a ,v) b1) (fact 'rr-one-in) (cw-rr-mul! a 1)
        (let* ((h1 (dk-have-f `(= (* (* ,w ,b1) ,pj) (+ (* x (* ,pj ,b1)) (- (* (* ,rn ,pj) ,b1)))) (lambda () (crs))))
               (h1b (dk-rewrite-h! h1 `(* ,pj ,b1) b))
               (h1c (dk-rewrite-h! h1b `(* ,rn ,pj) `(* ,a ,v)))
               (h1d (dk-rewrite-h! h1c `(* x ,b) a))
               (h2 (dk-have-f `(= (* ,a (+ (* ,u ,pj) (* ,v ,b1))) (+ (* (* ,a ,u) ,pj) (* (* ,a ,v) ,b1))) (lambda () (crs))))
               (h2b (dk-rewrite-h! h2 `(+ (* ,u ,pj) (* ,v ,b1)) 1)))
          (dk-have! `(= (* ,a 1) ,a) (lambda () (crs)))
          (dk-have! `(= (* (* ,w ,b1) ,pj) (* (* ,a ,u) ,pj)) (lambda () (dk-ineq! h1d h2b `(= (* ,a 1) ,a))))
          (dk-have! `(< 0 ,pj) (lambda () (dk-ineq! `(<= 1 ,pj))))
          (dk-cite! 'pz-rr-cancel-pos `(* ,w ,b1) `(* ,a ,u) pj)
          (dk-cite! 'zz-subset-qq b1)
          (pz-abs-typed! w) (pz-abs-typed! b1) (pz-abs-typed! `(* ,a ,u))
          (dk-cite! 'pc-abs-unit 'p b1)
          (dk-cite! 'pc-abs-int 'p `(* ,a ,u))
          (let* ((m1 (dk-cite! 'pz-abs-mul 'p w b1))
                 (m2 (dk-rewrite-h! m1 `(* ,w ,b1) `(* ,a ,u)))
                 (m3 (dk-rewrite-h! m2 `((PADIC-ABS p) ,b1) 1)))
            (cw-rr-mul! `((PADIC-ABS p) ,w) 1)
            (dk-have! `(= (* ((PADIC-ABS p) ,w) 1) ((PADIC-ABS p) ,w)) (lambda () (crs)))
            (dk-have! `(<= ((PADIC-ABS p) ,w) 1)
              (lambda () (dk-ineq! m3 `(= (* ((PADIC-ABS p) ,w) 1) ((PADIC-ABS p) ,w)) `(<= ((PADIC-ABS p) (* ,a ,u)) 1))))
            (dk-have! `(= (* ,rn (power p ,j)) (* ,a ,v)) (lambda () (subst `(= (* ,rn (power p ,j)) (* ,a ,v))) (rfl)))
            (ew rn)
            (pc-rep-close! `(* ,a ,v) j)))))))
(qed 'pc-rep-exists)

;; Z, M of a rep with typings: Z in ZZ (QQ, RR, CC), P^M typed
(define (pc-rep-typed! p x r)
  (let* ((zm (pc-rep-open! p x r)) (z (car zm)) (m (cadr zm)))
    (pz-num! z) (pz-pow! p m)
    (dk-cite! 'qq-subset-rr r) (dk-cite! 'rr-subset-cc r)
    zm))
;; |A + B|_p <= 1 from |A|_p <= 1 and |B|_p <= 1 (A, B in QQ)
(define (pc-ultra-1! a b)
  (pz-abs-typed! a) (pz-abs-typed! b)
  (pz-and! `(IN ,a QQ) `(IN ,b QQ)) (dk-cite! 'qq-add-closed a b)
  (pz-abs-typed! `(+ ,a ,b))
  (dk-cite! 'pz-abs-ultra 'p a b)
  (fact 'rr-one-in)
  (dk-cite! 'rr-max-le `((PADIC-ABS p) ,a) `((PADIC-ABS p) ,b) 1)
  (dk-cite! 'rr-max-closed `((PADIC-ABS p) ,a) `((PADIC-ABS p) ,b))
  (dk-have! `(<= ((PADIC-ABS p) (+ ,a ,b)) 1)
    (lambda () (dk-ineq! `(<= ((PADIC-ABS p) (+ ,a ,b)) (MAX ((PADIC-ABS p) ,a) ((PADIC-ABS p) ,b)))
                         `(<= (MAX ((PADIC-ABS p) ,a) ((PADIC-ABS p) ,b)) 1)))))
(define (pc-qq-sub! a b)
  (dk-cite! 'qq-neg-closed b) (pz-and! `(IN ,a QQ) `(IN (- ,b) QQ)) (dk-cite! 'qq-add-closed a `(- ,b)))
;; (r + s) p^(m + m') = z p^m' + z' p^m, landed; returns the exponent (+ m m')
(define (pc-rep-sum-eq! r zm s zm2 sgn)
  (let* ((z (car zm)) (m (cadr zm)) (z2 (car zm2)) (m2 (cadr zm2))
         (pm `(power p ,m)) (pm2 `(power p ,m2)) (mm `(+ ,m ,m2))
         (comb (if (eq? sgn '+) `(+ ,r ,s) `(+ ,r (- ,s))))
         (rhs (if (eq? sgn '+) `(+ (* ,z ,pm2) (* ,z2 ,pm)) `(+ (* ,z ,pm2) (- (* ,z2 ,pm))))))
    (pz-nnadd! m m2)
    (pz-and! '(IN p CC) '(IN p CC))
    (dk-cite! 'cc-power-add m2 m 'p)
    (let* ((h (dk-have-f `(= (* ,comb (* ,pm ,pm2)) ,(if (eq? sgn '+) `(+ (* (* ,r ,pm) ,pm2) (* (* ,s ,pm2) ,pm))
                                                                       `(+ (* (* ,r ,pm) ,pm2) (- (* (* ,s ,pm2) ,pm)))))
                         (lambda () (crs))))
           (h2 (dk-rewrite-h! h `(* ,r ,pm) z))
           (h3 (dk-rewrite-h! h2 `(* ,s ,pm2) z2))
           (h4 (dk-rewrite-h! h3 `(* ,pm ,pm2) `(power p ,mm))))
      (pz-zz-mul! z pm2) (pz-zz-mul! z2 pm)
      (if (eq? sgn '+)
          (pz-zz-add! `(* ,z ,pm2) `(* ,z2 ,pm))
          (begin (dk-cite! 'zz-neg-closed `(* ,z2 ,pm)) (pz-zz-add! `(* ,z ,pm2) `(- (* ,z2 ,pm)))))
      (list h4 rhs mm))))

;; reps add
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ) (FORALL cr (FORALL cs
  (IMPLIES (PADIC-FRAC-REP p x cr) (IMPLIES (PADIC-FRAC-REP p y cs) (PADIC-FRAC-REP p (+ x y) (+ cr cs))))))))))))))
(dk-peel!)
(pz-prime! 'p)
(let* ((zm (pc-rep-typed! 'p 'x 'cr)) (zm2 (pc-rep-typed! 'p 'y 'cs))
       (res (pc-rep-sum-eq! 'cr zm 'cs zm2 '+)))
  (pz-and! '(IN cr QQ) '(IN cs QQ)) (dk-cite! 'qq-add-closed 'cr 'cs)
  (pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-add-closed 'x 'y)
  (pc-qq-sub! 'x 'cr) (pc-qq-sub! 'y 'cs)
  (pc-ultra-1! '(+ x (- cr)) '(+ y (- cs)))
  (pc-qq-sub! '(+ x y) '(+ cr cs))
  (dk-have! '(= (+ (+ x y) (- (+ cr cs))) (+ (+ x (- cr)) (+ y (- cs)))) (lambda () (crs)))
  (dk-have! '(<= ((PADIC-ABS p) (+ (+ x y) (- (+ cr cs)))) 1)
    (lambda () (subst '(= (+ (+ x y) (- (+ cr cs))) (+ (+ x (- cr)) (+ y (- cs))))) (dk-ass!)))
  (pc-rep-close! (cadr res) (caddr res)))
(qed 'pc-rep-add)

;; a rep of y is a rep of every x with |x - y|_p <= 1
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ) (FORALL cr
  (IMPLIES (PADIC-FRAC-REP p y cr) (IMPLIES (<= ((PADIC-ABS p) (+ x (- y))) 1) (PADIC-FRAC-REP p x cr))))))))))))
(dk-peel!)
(pz-prime! 'p)
(let ((zm (pc-rep-typed! 'p 'y 'cr)))
  (pc-qq-sub! 'x 'y) (pc-qq-sub! 'y 'cr) (pc-qq-sub! 'x 'cr)
  (pc-ultra-1! '(+ x (- y)) '(+ y (- cr)))
  (dk-have! '(= (+ x (- cr)) (+ (+ x (- y)) (+ y (- cr)))) (lambda () (crs)))
  (dk-have! '(<= ((PADIC-ABS p) (+ x (- cr))) 1)
    (lambda () (subst '(= (+ x (- cr)) (+ (+ x (- y)) (+ y (- cr))))) (dk-ass!)))
  (pc-rep-close! (car zm) (cadr zm)))
(qed 'pc-rep-shift)

;; two reps of x differ by an integer
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL cr (FORALL cs
  (IMPLIES (PADIC-FRAC-REP p x cr) (IMPLIES (PADIC-FRAC-REP p x cs) (IN (+ cr (- cs)) ZZ)))))))))))
(dk-peel!)
(pz-prime! 'p)
(let* ((zm (pc-rep-typed! 'p 'x 'cr)) (zm2 (pc-rep-typed! 'p 'x 'cs))
       (res (pc-rep-sum-eq! 'cr zm 'cs zm2 '-)))
  (pc-qq-sub! 'x 'cr) (pc-qq-sub! 'x 'cs) (pc-qq-sub! 'cr 'cs)
  (dk-cite! 'qq-neg-closed '(+ x (- cr)))
  (dk-cite! 'pc-abs-neg 'p '(+ x (- cr)))
  (pz-abs-typed! '(+ x (- cr))) (pz-abs-typed! '(- (+ x (- cr))))
  (dk-have! '(<= ((PADIC-ABS p) (- (+ x (- cr)))) 1)
    (lambda () (dk-ineq! '(= ((PADIC-ABS p) (- (+ x (- cr)))) ((PADIC-ABS p) (+ x (- cr)))) '(<= ((PADIC-ABS p) (+ x (- cr))) 1))))
  (pc-ultra-1! '(+ x (- cs)) '(- (+ x (- cr))))
  (dk-have! '(= (+ cr (- cs)) (+ (+ x (- cs)) (- (+ x (- cr))))) (lambda () (crs)))
  (dk-have! '(<= ((PADIC-ABS p) (+ cr (- cs))) 1)
    (lambda () (subst '(= (+ cr (- cs)) (+ (+ x (- cs)) (- (+ x (- cr)))))) (dk-ass!)))
  (dk-have! `(IN (* (+ cr (- cs)) (power p ,(caddr res))) ZZ) (lambda () (subst (car res)) (dk-ass!)))
  (dk-cite! 'pc-frac-int 'p '(+ cr (- cs)) (caddr res))
  (dk-ass!))
(qed 'pc-rep-diff-int)

;; two reps of x give the same e
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL cr (FORALL cs
  (IMPLIES (PADIC-FRAC-REP p x cr) (IMPLIES (PADIC-FRAC-REP p x cs)
    (= (cc-exp (* (* (* 2 pi) +i) cr)) (cc-exp (* (* (* 2 pi) +i) cs)))))))))))))
(dk-peel!)
(pz-prime! 'p)
(dk-cite! 'pc-rep-diff-int 'p 'x 'cr 'cs)
(pc-rep-typed! 'p 'x 'cr) (pc-rep-typed! 'p 'x 'cs)
(let ((k '(+ cr (- cs))))
  (pz-num! k)
  (dk-cite! 'pc-e-int k)
  (dk-cite! 'pc-e-add 'cs k)
  (pc-e-typed! 'cs)
  (dk-have! `(= cr (+ cs ,k)) (lambda () (crs)))
  (subst `(= cr (+ cs ,k)))
  (subst `(= ,(pc-e `(+ cs ,k)) (* ,(pc-e 'cs) ,(pc-e k))))
  (subst `(= ,(pc-e k) 1))
  (crs))
(qed 'pc-e-rep-unique)

;; NBGSEP: the description carries cpw_ in CC and cpr_ in QQ (as PADIC-CHAR does)
(define (pc-io x) `(IOTA cpw_ (AND (IN cpw_ CC) (FORSOME cpr_ (AND (IN cpr_ QQ) (AND (PADIC-FRAC-REP p ,x cpr_) (= cpw_ (cc-exp (* (* (* 2 pi) +i) cpr_)))))))))

;; the description in PADIC-CHAR is proper
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ)
  (FORSOME pcr_ (AND (PADIC-FRAC-REP p x pcr_) (= ,(pc-io 'x) (cc-exp (* (* (* 2 pi) +i) pcr_)))))))))))
(dk-peel!)
(let* ((io (pc-io 'x))
       (r0 (dk-skolem! (dk-cite! 'pc-rep-exists 'p 'x))))
  (dk-project! `(IN ,r0 QQ) 'padic-frac-rep `(PADIC-FRAC-REP p x ,r0))
  (dk-cite! 'qq-subset-rr r0)
  (pc-e-typed! r0)
  (let ((ls (dk-opened (lambda () (iota-d io)))))
    (for-each
      (lambda (l)
        (if (not (sequent-node-grounded? l))
            (begin
              (dk-focus! l)
              (if (and (dk-head-is? (dk-goal) 'FORSOME) (dk-contains? (dk-goal) 'FORALL))
                  (begin
                    (ew (pc-e r0))
                    (dk-conj-close!
                      (lambda ()
                        (cond
                          ((dk-ass!) #t)
                          ((dk-head-is? (dk-goal) 'FORSOME)
                           (ew r0) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                          (#t
                           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                  (parts (append landed (dk-split-all! landed)))
                                  (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
                                  (r1 (dk-skolem! ex)))
                             (dk-cite! 'pc-e-rep-unique 'p 'x r0 r1)
                             (subst (find-first (lambda (f) (and (dk-head-is? f '=) (dk-contains? f r1) (not (dk-contains? f r0)))) (dk-asms)))
                             (dk-ass!)))))))
                  ;; the main leaf: the defining property (AND (IN io CC) (FORSOME cpr_ ...)) is in context
                  (if (not (dk-ass!))
                      (begin
                        (dk-split-all!)
                        (let ((r2 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f io))) "the defining property") #t)))
                          (ew r2)
                          (dk-conj-close! (lambda () (dk-ass!))))))))))
      ls)))
(qed 'pc-char-iota)

;; the value of the character at x, through any p-adic fractional part
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL cr (IMPLIES (PADIC-FRAC-REP p x cr)
  (= ((PADIC-CHAR p) x) (cc-exp (* (* (* 2 pi) +i) cr)))))))))))
(dk-peel!)
(fact 'qq-is-set)
(let ((r1 (dk-skolem! (dk-cite! 'pc-char-iota 'p 'x))))
  (dk-cite! 'pc-e-rep-unique 'p 'x r1 'cr)
  (mac 'PADIC-CHAR)
  (dk-lam-b!)
  (subst `(= ,(pc-io 'x) ,(pc-e r1)))
  (dk-ass!))
(qed 'pc-char-value)

;; the character is additive
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (= ((PADIC-CHAR p) (+ x y)) (* ((PADIC-CHAR p) x) ((PADIC-CHAR p) y)))))))))))
(dk-peel!)
(let* ((r (dk-skolem! (dk-cite! 'pc-rep-exists 'p 'x))) (s (dk-skolem! (dk-cite! 'pc-rep-exists 'p 'y))))
  (pz-and! '(IN x QQ) '(IN y QQ)) (dk-cite! 'qq-add-closed 'x 'y)
  (dk-cite! 'pc-rep-add 'p 'x 'y r s)
  (subst (dk-cite! 'pc-char-value 'p 'x r))
  (subst (dk-cite! 'pc-char-value 'p 'y s))
  (subst (dk-cite! 'pc-char-value 'p '(+ x y) `(+ ,r ,s)))
  (dk-project! `(IN ,r QQ) 'padic-frac-rep `(PADIC-FRAC-REP p x ,r))
  (dk-project! `(IN ,s QQ) 'padic-frac-rep `(PADIC-FRAC-REP p y ,s))
  (dk-cite! 'qq-subset-rr r) (dk-cite! 'qq-subset-rr s)
  (dk-cite! 'pc-e-add r s)
  (dk-ass!))
(qed 'pc-char-add)

;; locally constant: |x - y|_p <= 1 gives equal values
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (IMPLIES (<= ((PADIC-ABS p) (+ x (- y))) 1) (= ((PADIC-CHAR p) x) ((PADIC-CHAR p) y)))))))))))
(dk-peel!)
(let ((r (dk-skolem! (dk-cite! 'pc-rep-exists 'p 'y))))
  (dk-cite! 'pc-rep-shift 'p 'x 'y r)
  (subst (dk-cite! 'pc-char-value 'p 'x r))
  (subst (dk-cite! 'pc-char-value 'p 'y r))
  (dk-project! `(IN ,r QQ) 'padic-frac-rep `(PADIC-FRAC-REP p y ,r))
  (dk-cite! 'qq-subset-rr r)
  (pc-e-typed! r)
  (rfl))
(qed 'pc-char-local)

;; Proposition 5.20 on Q: the kernel of the character is Z(Q)
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ)
  (IFF (= ((PADIC-CHAR p) x) 1) (<= ((PADIC-ABS p) x) 1))))))))
(dk-peel!)
(pz-prime! 'p)
(fact 'zz-zero-in) (fact 'qq-zero-in) (fact 'nn-zero-in)
(dk-iff! (lambda (g) (dk-head-is? g '<=))
  (lambda ()
    (let* ((r (dk-skolem! (dk-cite! 'pc-rep-exists 'p 'x)))
           (zm (pc-rep-typed! 'p 'x r)))
      (dk-cite! 'pc-char-value 'p 'x r)
      (let ((h (dk-rewrite-h! '(= ((PADIC-CHAR p) x) 1) '((PADIC-CHAR p) x) (pc-e r))))
        (dk-cite! 'pc-e-one-int r)
        (pz-num! r)
        (dk-cite! 'pc-abs-int 'p r)
        (pc-qq-sub! 'x r)
        (pc-ultra-1! `(+ x (- ,r)) r)
        (dk-have! `(= x (+ (+ x (- ,r)) ,r)) (lambda () (crs)))
        (subst `(= x (+ (+ x (- ,r)) ,r)))
        (dk-ass!))))
  (lambda ()
    (pz-pow! 'p 0)
    (dk-have! '(= (* 0 (power p 0)) 0) (lambda () (crs)))
    (pc-qq-sub! 'x 0)
    (dk-have! '(<= ((PADIC-ABS p) (+ x (- 0))) 1) (lambda () (dk-have! '(= (+ x (- 0)) x) (lambda () (crs))) (subst '(= (+ x (- 0)) x)) (dk-ass!)))
    (dk-have! '(PADIC-FRAC-REP p x 0) (lambda () (pc-rep-close! 0 0)))
    (subst (dk-cite! 'pc-char-value 'p 'x 0))
    (dk-cite! 'pc-e-int 0)
    (dk-ass!)))
(qed 'pc-char-kernel)

;; the character takes values on the unit circle (and in CC)
(define (pc-char-type-proof! cls)
  (sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IN (PADIC-CHAR p) (FUN QQ ,cls))))))
  (dk-peel!)
  (fact 'qq-is-set)
  (mac 'PADIC-CHAR)
  (for-each (lambda (l)
              (dk-focus! l)
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((landed (dk-landed (lambda () (dk-peel!))))
                         (x (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed)))
                         (r1 (dk-skolem! (dk-cite! 'pc-char-iota 'p x))))
                    (dk-project! `(IN ,r1 QQ) 'padic-frac-rep `(PADIC-FRAC-REP p ,x ,r1))
                    (dk-cite! 'qq-subset-rr r1)
                    (pc-e-typed! r1)
                    (dk-cite! 'pc-e-unit r1)
                    (subst `(= ,(pc-io x) ,(pc-e r1)))
                    (dk-ass!))
                  (dk-ass!)))
            (dk-opened (lambda () (lam-t)))))
(pc-char-type-proof! 'UNIT-CIRCLE)
(qed 'pc-char-type)
(pc-char-type-proof! 'CC)
(qed 'pc-char-type-cc)

;; Proposition 5.20 / Remark 5.21 on Q: lambda is a character of the additive group of Q for |.|_p
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-ADD-CHARACTER (QQ-PADIC p) (PADIC-CHAR p))))))
(dk-peel!)
(pz-prime! 'p)
(let* ((kf '(QQ-PADIC p)) (ms `(NF-METRIC-SPACE ,kf)) (lam '(PADIC-CHAR p)))
  (dk-cite! 'pq-carr 'p) (dk-cite! 'pq-add 'p)
  (dk-cite! 'qq-padic-is-normed-field 'p)
  (dk-cite! 'nf-metric-space-is-metric-space kf)
  (dk-cite! 'nf-metric-carrier kf)
  (fact 'cc-is-metric-space)
  (dk-cite! 'pc-char-type 'p) (dk-cite! 'pc-char-type-cc 'p)
  (fact 'qq-is-set)
  (mac 'IS-ADD-CHARACTER)
  (subst `(= (CARR ,kf) QQ))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-asm? (dk-goal)) (dk-ass!))
        ((dk-head-is? (dk-goal) 'FORALL)
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (ins (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) landed)))
                (x (car ins)) (y (cadr ins)))
           (subst `(= (ADD ,kf) (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_))))
           (dk-lam-b!)
           (dk-cite! 'pc-char-add 'p x y)
           (dk-ass!)))
        (#t
         (mac 'IS-CONTINUOUS)
         (subst `(== (PTS ,ms) (CARR ,kf)))
         (subst `(= (CARR ,kf) QQ))
         (slot 'PTS)
         (dk-conj-close!
           (lambda ()
             (cond
               ((dk-asm? (dk-goal)) (dk-ass!))
               (#t
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (a (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed))))
                  (mac 'IS-CONTINUOUS-AT)
                  (subst `(== (PTS ,ms) (CARR ,kf)))
                  (subst `(= (CARR ,kf) QQ))
                  (slot 'PTS)
                  (dk-conj-close!
                    (lambda ()
                      (cond
                        ((dk-asm? (dk-goal)) (dk-ass!))
                        (#t
                         (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                                (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed2))))
                           (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
                           (dk-have! '(POS-RR 1) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (arith)))))
                           (ew 1)
                           (dk-conj-close!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (dk-ass!)
                                   (let* ((landed3 (dk-landed (lambda () (dk-peel!))))
                                          (b (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed3)))
                                          (hd (find-first (lambda (h) (dk-head-is? h '<=)) landed3))
                                          (lb `(,lam ,b)))
                                     (dk-cite! 'pc-dist 'p a b)
                                     (let ((h2 (dk-rewrite-h! hd `((DIST ,ms) ,a ,b) `((PADIC-ABS p) (+ ,a (- ,b))))))
                                       (dk-cite! 'pc-char-local 'p a b)
                                       (subst `(= (,lam ,a) ,lb))
                                       (pz-and! `(IN ,lam (FUN QQ CC)) `(IN ,b QQ))
                                       (dk-cite! 'fun-apply-type lam 'QQ 'CC b)
                                       (subst (dk-cite! 'cc-ms-dist lb lb))
                                       (dk-have! `(= (- ,lb ,lb) 0) (lambda () (mac 'binary-minus-def) (crs)))
                                       (subst `(= (- ,lb ,lb) 0))
                                       (fact 'cc-magnitude-zero)
                                       (subst '(= (magnitude 0) 0))
                                       (dk-ineq! `(< 0 ,ep))))))))))))))))))))))
(qed 'ccr-5-20-character)

;; Remark 5.21 and Proposition 5.20: lambda(x) = 1 exactly on Z(Q)
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ)
  (IFF (= ((PADIC-CHAR p) x) 1) (IN x (NV-INTEGERS (QQ-PADIC p))))))))))
(dk-peel!)
(let ((eq (dk-cite! 'pc-nv-integers-eq 'p)))
  (subst eq)
  (let ((k (dk-cite! 'pc-char-kernel 'p 'x)))
    (dk-iff! (lambda (g) (dk-head-is? g 'IN))
      (lambda () (pz-iff-fwd! k) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))
      (lambda ()
        (sep-me (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-contains? h 'SEP))) (dk-asms)))
        (ai k) (detach! `(IMPLIES ,(caddr k) ,(cadr k)))
        (dk-ass!)))))
(qed 'ccr-5-21)
