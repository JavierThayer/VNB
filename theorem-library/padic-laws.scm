(let ((v '((PADIC-ABS p) x)))
  (dk-cite! 'pz-abs-nonneg 'p 'x)
  (cw-or-each! (pz-rel-or 'p 'x v)
    (lambda (c)
      (if (dk-head-is? (cadr c) '=)
          (begin
            (dk-split! c)
