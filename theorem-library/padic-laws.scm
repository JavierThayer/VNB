            (pz-num! a) (pz-num! b)
            (pz-two! i) (pz-two! j)
            (dk-have! `(<= (power 2 ,j) (power 2 ,i))
              (lambda ()
                (dk-have! `(<= 0 (power 2 ,i)) (lambda () (dk-ineq! `(< 0 (power 2 ,i)))))
                (dk-cite! 'rr-mul-le-right v 1 `(power 2 ,i))
                (fact 'rr-one-in)
                (cw-rr-mul! v `(power 2 ,i)) (cw-rr-mul! 1 `(power 2 ,i))
