                        (dk-cite! 'rr-abs-of-neg r)
                        (dk-have! `(<= 0 (+ ,r ,pk)) (lambda () (dk-ineq! o `(= (succ (abs ,r)) (+ (abs ,r) 1)) `(= (abs ,r) (- ,r)) `(= (abs ,pk) ,pk))))
                        (dk-have! `(< (+ ,r ,pk) ,pk) (lambda () (dk-ineq! o2)))
                        (pz-zz-add! r pk)
