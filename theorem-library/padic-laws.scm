(dk-cite! 'pz-abs-type 'p)
(fact 'qq-is-set)
(dk-cite! 'qq-neg-closed 'y)
(mac 'pq-fnrm) (mac 'pq-add) (mac 'pq-neg)
(dk-lam-b!)
(pz-and! '(IN x QQ) '(IN (- y) QQ)) (dk-cite! 'qq-add-closed 'x '(- y))
(pz-abs-typed! '(+ x (- y)))
(rfl)
