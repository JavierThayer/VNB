;; |p^k| = |p|^k
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf))
