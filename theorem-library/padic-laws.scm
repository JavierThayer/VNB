       (t0 (dk-skolem! (dk-cite! 'pc-approx-raw 'p 'x 'k)))
       (dv (begin (pz-pow! 'p 'k) (pz-num! t0)
                  (dk-have! `(NOT (= ,pk 0)) (lambda () (di) (dk-absurd! `(= ,pk 0) `(<= 1 ,pk))))
                  (dk-cite! 'zz-division t0 pk)))
       (q (dk-skolem! dv))
       (r (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0))) "the remainder"))))
  (pz-num! q) (pz-num! r)
  (dk-have! `(<= 0 ,pk) (lambda () (dk-ineq! `(<= 1 ,pk))))
  (dk-cite! 'rr-abs-of-nonneg pk)
  (dk-cite! 'pc-abs-power 'p 'k)
  (dk-cite! 'zz-subset-qq pk)
  (pz-abs-typed! pk)
  (dk-cite! 'zz-subset-qq t0)
  (dk-cite! 'qq-neg-closed t0)
  (pz-and! '(IN x QQ) `(IN (- ,t0) QQ)) (dk-cite! 'qq-add-closed 'x `(- ,t0))
  (pz-abs-typed! `(+ x (- ,t0)))
  ;; the approximant theta = r or r + p^k, with t0 - theta = c p^k
  (let ((finish!
          (lambda (th c)
            (pz-num! th) (pz-num! c)
            (pz-zz-mul! c pk)
            (dk-cite! 'zz-subset-qq `(* ,c ,pk))
            (dk-cite! 'pc-abs-int-mul 'p c pk)
            (dk-cite! 'pz-abs-ultra 'p `(+ x (- ,t0)) `(* ,c ,pk))
            (pz-abs-typed! `(* ,c ,pk))
            (pz-and! `(IN (+ x (- ,t0)) QQ) `(IN (* ,c ,pk) QQ)) (dk-cite! 'qq-add-closed `(+ x (- ,t0)) `(* ,c ,pk))
            (pz-abs-typed! `(+ (+ x (- ,t0)) (* ,c ,pk)))
            (dk-cite! 'rr-max-le `((PADIC-ABS p) (+ x (- ,t0))) `((PADIC-ABS p) (* ,c ,pk)) `((PADIC-ABS p) ,pk))
            (dk-have! `(= (- x ,th) (+ (+ x (- ,t0)) (* ,c ,pk)))
              (lambda ()
                (mac 'binary-minus-def)
                (subst `(= ,t0 (+ (* ,q ,pk) ,r)))
                (crs)))
            (pz-witness! (list th)
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-contains? g 'PADIC-ABS)
                         (subst `(= (- x ,th) (+ (+ x (- ,t0)) (* ,c ,pk))))
                         (subst `(= (power ((PADIC-ABS p) p) k) ((PADIC-ABS p) ,pk)))
                         (dk-cite! 'rr-max-closed `((PADIC-ABS p) (+ x (- ,t0))) `((PADIC-ABS p) (* ,c ,pk)))
                         (dk-ineq! `(<= ((PADIC-ABS p) (+ (+ x (- ,t0)) (* ,c ,pk))) (MAX ((PADIC-ABS p) (+ x (- ,t0))) ((PADIC-ABS p) (* ,c ,pk))))
                                   `(<= (MAX ((PADIC-ABS p) (+ x (- ,t0))) ((PADIC-ABS p) (* ,c ,pk))) ((PADIC-ABS p) ,pk))))
                        (#t (error "pc-1.19: open" g)))))))))
    (cw-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f r))) "the remainder clause")
      (lambda (o)
        (if (equal? o `(= ,r 0))
            (begin
              (dk-have! `(<= 0 ,r) (lambda () (dk-ineq! o)))
              (dk-have! `(< ,r ,pk) (lambda () (dk-ineq! o `(<= 1 ,pk))))
              (finish! r q))
            (let ((tri (dk-cite! 'zz-trichotomy r)))
              (dk-cite! 'zz-abs-in-nn r) (dk-cite! 'nn-in-rr `(abs ,r))
              (dk-cite! 'nn-succ-plus-one `(abs ,r))
              (dk-cite! 'nn-succ-closed `(abs ,r)) (dk-cite! 'nn-in-rr `(succ (abs ,r)))
              (dk-cite! 'rr-abs-closed pk) (dk-cite! 'rr-abs-closed r)
              (cw-or-each! tri
                (lambda (o2)
