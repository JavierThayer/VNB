  (dk-cite! 'rr-mul-le-right 2 `(power 2 ,d) '(power 2 i))
  (cw-rr-mul! 2 '(power 2 i)) (cw-rr-mul! `(power 2 ,d) '(power 2 i)) (cw-rr-mul! '(power 2 i) `(power 2 ,d))
  (dk-have! `(= (* (power 2 ,d) (power 2 i)) (* (power 2 i) (power 2 ,d))) (lambda () (crs)))
  (dk-have! `(= (power 2 j) (power 2 (+ i ,d))) (lambda () (subst `(= j (+ i ,d))) (rfl)))
