        (sep-me mm)
        (dk-ass!))))
  (dk-have! `(FORSOME qn_ (IN qn_ ,tset))
    (lambda () (ew n0) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
  (pz-and! `(SUBSET ,tset NN) `(FORSOME qn_ (IN qn_ ,tset)))
  (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tset)))
         (lm (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m) (dk-contains? f 'SEP))) "the least-element law")))
    (dk-have! `(IN ,m NN) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
    (dk-have! `(< 0 ,m) (lambda () (sep-me `(IN ,m ,tset)) (dk-split-all!) (dk-ass!)))
    (dk-have! `(< (vf ,m) 1) (lambda () (sep-me `(IN ,m ,tset)) (dk-split-all!) (dk-ass!)))
    (dk-have! `(FORALL ke (IMPLIES (IN ke NN) (IMPLIES (< 0 ke) (IMPLIES (< (vf ke) 1) (<= ,m ke)))))
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (kk (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) landed))))
          (dk-have! `(IN ,kk ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
          (dk-apply! lm kk)
          (dk-ass!))))
    (dk-cite! 'nn-subset-zz m) (qo-int! m)
    (fact 'qq-one-in) (fact 'rr-one-in)
    (qo! 'qn-in-rr 1)
    (qo! 'qo-one)
    (dk-have! `(NOT (= 1 ,m))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! `(< (vf ,m) 1) m 1)))
          (dk-absurd! h '(= (vf 1) 1)))))
    (fact 'zz-zero-in)
    (dk-cite! 'zz-lt-succ-le 0 m)
    (dk-have! `(<= 1 ,m) (lambda () (dk-ineq! `(<= (+ 0 1) ,m))))
    (pz-and! `(<= 1 ,m) `(NOT (= 1 ,m))) (dk-cite! 'rr-le-ne-lt 1 m)
    (dk-cite! 'qo-prime 'vf m)
    (qo! 'qn-nonneg m)
    (dk-have! `(NOT (= 0 (vf ,m)))
      (lambda ()
        (di)
        (dk-have! `(= (vf ,m) 0) (lambda () (dk-ineq! `(= 0 (vf ,m)))))
        (pz-iff-fwd! (qo! 'qn-zero-iff m))
        (dk-absurd! `(= ,m 0) `(< 0 ,m))))
    (pz-and! `(<= 0 (vf ,m)) `(NOT (= 0 (vf ,m)))) (dk-cite! 'rr-le-ne-lt 0 `(vf ,m))
    (ew m)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (dk-ass!)
            (begin
              (ew `(vf ,m))
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (dk-ass!)
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (g (dk-goal))
