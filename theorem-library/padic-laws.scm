(dk-have! '(SUBSET (NV-INTEGERS (QQ-PADIC p)) QQ)
  (lambda ()
    (mac 'subset-def)
    (let* ((landed (dk-landed (lambda () (dk-peel!))))
           (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'NV-INTEGERS))) landed)))
      (if (not m) (error "pc-z-subset: no membership landed" landed (dk-goal)))
      (pc-int-open! (cadr m))
      (dk-ass!))))
(fact 'qq-is-set)
(dk-cite! 'subclass-of-set-is-set '(NV-INTEGERS (QQ-PADIC p)) 'QQ)
(dk-conj-close! (lambda () (dk-ass!)))
(qed 'pc-z-subset-set)

;; the distance of the metric of |.|_p
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (= ((DIST (NF-METRIC-SPACE (QQ-PADIC p))) x y) ((PADIC-ABS p) (+ x (- y))))))))))))
(dk-peel!)
