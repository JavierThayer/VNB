                 (dv (find-first (lambda (f) (dk-head-is? f 'ZZ-DIVIDES)) landed))
                 (d (cadr dv))
                 (c (pz-dvd-open! d 'p))
                 (a `(abs ,d)) (b `(abs ,c)))
