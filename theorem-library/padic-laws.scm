;; PADIC-REL(P, X, V) in context: land V in RR and return the OR (zero case / fraction case)
(define (pz-rel-or p x v)
  (dk-project! `(IN ,v RR) 'padic-rel `(PADIC-REL ,p ,x ,v))
  (let ((o `(OR (AND (= ,x 0) (= ,v 0))
                (AND (NOT (= ,x 0))
                     (FORSOME cpa_ (AND (IN cpa_ ZZ) (FORSOME cpb_ (AND (IN cpb_ ZZ) (AND (NOT (= cpb_ 0)) (AND (= (* ,x cpb_) cpa_)
                       (FORSOME cpi_ (AND (IN cpi_ NN) (FORSOME cpj_ (AND (IN cpj_ NN)
                         (AND (ZZ-ORD-IS ,p cpa_ cpi_) (AND (ZZ-ORD-IS ,p cpb_ cpj_)
                           (= (* ,v (power 2 cpi_)) (power 2 cpj_))))))))))))))))))
    (dk-project! o 'padic-rel `(PADIC-REL ,p ,x ,v))
    o))
;; the fraction case (AND (NOT (= X 0)) (FORSOME ...)) as context formula F: land everything, return (a b i j)
(define (pz-rel-frac! f v)
  (dk-split! f)
  (let* ((pick (lambda () (dk-skolem! (dk-pick (lambda (g) (and (dk-head-is? g 'FORSOME) (dk-contains? g v) (dk-contains? g 'power))) "the representation")))))
    (let* ((a (pick)) (b (pick)) (i (pick)) (j (pick)))
      (list a b i j))))

