(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL p (IMPLIES (ZZ-PRIME p) (IMPLIES (< (vf p) 1)
