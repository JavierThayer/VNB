;; A in NN, A /= 0 in context: land 1 <= A
(define (qo-pos1! a)
  (dk-cite! 'nn-in-rr a) (dk-cite! 'nn-zero-le a) (dk-cite! 'nn-subset-zz a)
  (dk-have! `(NOT (= 0 ,a)) (lambda () (di) (dk-have! `(= ,a 0) (lambda () (dk-ineq! `(= 0 ,a)))) (ai `(NOT (= ,a 0)))))
  (pz-and! `(<= 0 ,a) `(NOT (= 0 ,a))) (dk-cite! 'rr-le-ne-lt 0 a)
  (fact 'zz-zero-in)
  (dk-cite! 'zz-lt-succ-le 0 a)
  (dk-have! `(<= 1 ,a) (lambda () (dk-ineq! `(<= (+ 0 1) ,a)))))
;; (<= (vf A) 1) and NOT (< (vf A) 1) in context: land (= (vf A) 1)
(define (qo-eq-one! a)
  (fact 'rr-one-in)
  (dk-have! `(= (vf ,a) 1)
    (lambda ()
      (pbc)
      (pz-and! `(<= (vf ,a) 1) `(NOT (= (vf ,a) 1)))
      (dk-cite! 'rr-le-ne-lt `(vf ,a) 1)
      (ai `(NOT (< (vf ,a) 1))))))

;; the least positive integer of absolute value < 1 is prime
(sp (make-wff '(FORALL vf (IMPLIES (IN vf (FUN QQ RR)) (IMPLIES (IS-NV-FIELD (QQ-NV vf)) (FORALL p (IMPLIES (IN p NN) (IMPLIES (< 1 p) (IMPLIES (< (vf p) 1)
  (IMPLIES (FORALL ke (IMPLIES (IN ke NN) (IMPLIES (< 0 ke) (IMPLIES (< (vf ke) 1) (<= p ke)))))
    (ZZ-PRIME p)))))))))))
(dk-peel!)
(let ((mn (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(<= p ke)))) "the minimality")))
  (dk-cite! 'nn-subset-zz 'p) (qo-int! 'p)
