            (dk-cite! 'zz-abs-in-nn d) (dk-cite! 'zz-abs-in-nn c)
            (dk-cite! 'nn-in-rr a) (dk-cite! 'nn-in-rr b)
            (dk-cite! 'nn-subset-zz a) (dk-cite! 'nn-subset-zz b)
            (qo-int! a) (qo-int! b)
            (dk-have! '(<= 0 p) (lambda () (dk-ineq! '(< 1 p))))
            (dk-cite! 'rr-abs-of-nonneg 'p)
            (pz-and! `(IN ,d RR) `(IN ,c RR)) (dk-cite! 'rr-abs-mult d c)
            (cw-rr-mul! a b)
            (dk-have! `(= (* ,a ,b) p)
              (lambda () (subst `(= (* ,a ,b) (abs (* ,d ,c)))) (subst `(= (* ,d ,c) p)) (dk-ass!)))
            (dk-have! `(NOT (= ,a 0)) (lambda () (di) (dk-have! `(= (* ,a ,b) 0) (lambda () (subst `(= ,a 0)) (crs)))
                                        (dk-absurd! `(= (* ,a ,b) p) `(= (* ,a ,b) 0) '(< 1 p))))
            (dk-have! `(NOT (= ,b 0)) (lambda () (di) (dk-have! `(= (* ,a ,b) 0) (lambda () (subst `(= ,b 0)) (crs)))
                                        (dk-absurd! `(= (* ,a ,b) p) `(= (* ,a ,b) 0) '(< 1 p))))
            (qo-pos1! a) (qo-pos1! b)
            (let ((cases (dk-cite! 'zz-abs-cases d)))
              (use-em `(= ,a 1)
                (lambda ()
