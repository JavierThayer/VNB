                      (let ((small!
                              (lambda (u w)
                                (dk-have! `(NOT (= 1 ,u)) (lambda () (di) (dk-have! `(= ,u 1) (lambda () (dk-ineq! `(= 1 ,u)))) (ai `(NOT (= ,u 1)))))
