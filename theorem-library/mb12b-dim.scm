;;; mb12b-dim.scm -- construction-of-measures Proposition 7.38 (existence and uniqueness of
;;; the self-similar dimension lambda: sum over w in X of a_w^(-lambda) = 1).  Agent ISOM
;;; (brief M-B1B2, follow-up), 2026-10-26.  Helper prefix: mdm-.  Library: analysis.
;;;
;;;   rpow-exp-continuous    s |-> b^s is a function on the line, continuous everywhere (b > 0)
;;;   rpow-exp-strict        s1 < s2  ==>  b^s1 < b^s2   (b > 1)
;;;   rpow-exp-facts         b^s is a positive real; b^0 = 1   (b > 0)
;;;   rpow-exp-base-le       1 < m <= b, s <= 0  ==>  b^s <= m^s
;;;   self-similar-dimension (7.38, the existence and uniqueness half)
;;; Powers are RPOW-STAR.

(define (mdm-head g) (and (pair? g) (car g)))
(define (mdm-ass0!) (if (dk-asm? (dk-goal)) (ass)))
(define (mdm-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (mdm-R b s) (list 'RPOW-STAR b s))
(define (mdm-E b s) (list 'r-exp (list '* s (list 'log b))))
;; b^s = r-exp(s log b), with every typing, for b > 0 and s real in context
(define (mdm-val! b s)
  (dk-cite! 'rpow-star-value b s)
  (dk-cite! 'log-in-rr b)
  (dk-cite! 'rr-mul-in-rr s (list 'log b))
  (dk-cite! 'r-exp-in-rr (list '* s (list 'log b)))
  (dk-cite! 'r-exp-pos (list '* s (list 'log b)))
  (dk-have! (list 'IN (mdm-R b s) 'RR) (lambda () (subst (list '= (mdm-R b s) (mdm-E b s))) (ass)))
  (dk-have! (list '< 0 (mdm-R b s)) (lambda () (subst (list '= (mdm-R b s) (mdm-E b s))) (ass))))

(define mdm-lam '(VNB-LAMBDA rs_ RR (RPOW-STAR b rs_)))

;;; ---- b^s: real, positive, and b^0 = 1 ----
(sp (make-wff '(FORALL b (IMPLIES (IN b RR) (IMPLIES (< 0 b) (FORALL s (IMPLIES (IN s RR)
   (AND (IN (RPOW-STAR b s) RR) (< 0 (RPOW-STAR b s))))))))))
(dk-peel!)
(mdm-val! 'b 's)
(dk-conj-close! (lambda () (ass)))
(qed 'rpow-exp-facts)
(topic! 'rpow-exp-facts 'plumbing)

;;; CUT 2026-10-27 (integration): `rpow-exp-zero' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `rpow-star-zero', which is cited below in its place (proven-duplicate audit).

;;; ---- continuity in the exponent ----
(sp (make-wff (list 'FORALL 'b (list 'IMPLIES '(IN b RR) (list 'IMPLIES '(< 0 b)
   (list 'AND (list 'IN mdm-lam '(FUN RR RR))
         (list 'FORALL 'x (list 'IMPLIES '(IN x RR) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS mdm-lam 'x)))))))))
(dk-peel!)
(fact 'rr-is-set)
(fact 'log-in-rr 'b)
(fact 'rr-zero-in)
(dk-have! (list 'IN mdm-lam '(FUN RR RR))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (ass)
                    (let ((v (cadr (car (dk-peel!)))))
                      (dk-split-all! (list (dk-cite! 'rpow-exp-facts 'b v)))
                      (ass))))
              (dk-opened (lambda () (lam-t))))))
(define mdm-A '(VNB-LAMBDA ax_ RR (+ 0 (* (log b) ax_))))
(define mdm-Ex '(VNB-LAMBDA y_ RR (r-exp y_)))
(dk-have! (list 'IN mdm-A '(FUN RR RR))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (ass)
                    (let ((v (cadr (car (dk-peel!)))))
                      (dk-cite! 'rr-mul-in-rr '(log b) v)
                      (dk-cite! 'rr-add-in-rr 0 (list '* '(log b) v))
                      (ass))))
              (dk-opened (lambda () (lam-t))))))
(fact 'r-exp-lam-in-fun)
(mdm-and! (list 'IN mdm-A '(FUN RR RR)) (list 'IN mdm-Ex '(FUN RR RR)))
(fact 'compose-apply 'RR 'RR 'RR mdm-Ex mdm-A)
(define mdm-capp (dk-pick (lambda (h) (and (eq? (mdm-head h) 'FORALL) (dk-contains? h 'COMPOSE))) "compose-apply"))
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'FORALL)
       (let ((x (cadr (car (dk-peel!)))))
         (mdm-and! '(IN 0 RR) (list 'AND '(IN (log b) RR) (list 'IN x 'RR)))
         (fact 'affine-continuous-at 0 '(log b) x)
         (dk-cite! 'fun-apply-type-c mdm-A 'RR 'RR x)
         (dk-cite! 'r-exp-continuous-at (list mdm-A x))
         (dk-cite! 'compose-continuous-at mdm-Ex mdm-A x)
         (dk-have! (list 'FORALL 'px_ (list 'IMPLIES '(IN px_ RR) (list '= (list mdm-lam 'px_) (list (list 'COMPOSE mdm-Ex mdm-A) 'px_))))
           (lambda ()
             (let ((z (cadr (car (dk-peel!)))))
               (dk-cite! 'fun-apply-type-c mdm-A 'RR 'RR z)
               (dk-cite! 'rr-mul-in-rr '(log b) z)
               (dk-cite! 'rr-add-in-rr 0 (list '* '(log b) z))
               (dk-apply! mdm-capp z)
               (subst (list '= (list (list 'COMPOSE mdm-Ex mdm-A) z) (list mdm-Ex (list mdm-A z))))
               (dk-lam-b!)
               (mdm-val! 'b z)
               (subst (list '= (mdm-R 'b z) (mdm-E 'b z)))
               (dk-have! (list '= (list '+ 0 (list '* '(log b) z)) (list '* z '(log b))) (lambda () (crs)))
               (subst (list '= (list '+ 0 (list '* '(log b) z)) (list '* z '(log b))))
               (rfl))))
         (dk-cite! 'cont-transfer-ptwise-eq mdm-lam (list 'COMPOSE mdm-Ex mdm-A) x)
         (ass))
       (ass))))
(qed 'rpow-exp-continuous)
(topic! 'rpow-exp-continuous 'analysis)

;;; ---- strictly increasing in the exponent when b > 1 ----
(sp (make-wff '(FORALL b (IMPLIES (IN b RR) (IMPLIES (< 1 b) (FORALL s1 (IMPLIES (IN s1 RR) (FORALL s2 (IMPLIES (IN s2 RR)
   (IMPLIES (< s1 s2) (< (RPOW-STAR b s1) (RPOW-STAR b s2))))))))))))
(dk-peel!)
(dk-have! '(< 0 b) (lambda () (dk-ineq! '(< 1 b) '(IN b RR))))
(mdm-val! 'b 's1)
(mdm-val! 'b 's2)
(fact 'log-pos-above-one 'b)
(dk-cite! 'rr-sub-in-rr 's2 's1)
(dk-have! '(< 0 (- s2 s1)) (lambda () (dk-ineq! '(< s1 s2) '(IN s1 RR) '(IN s2 RR))))
(dk-cite! 'rr-mul-pos '(log b) '(- s2 s1))
(dk-cite! 'rr-mul-in-rr '(log b) '(- s2 s1))
(dk-have! '(= (* (log b) (- s2 s1)) (- (* s2 (log b)) (* s1 (log b)))) (lambda () (crs)))
(dk-have! '(< (* s1 (log b)) (* s2 (log b)))
  (lambda () (dk-ineq! '(< 0 (* (log b) (- s2 s1))) '(= (* (log b) (- s2 s1)) (- (* s2 (log b)) (* s1 (log b))))
                       '(IN (* s1 (log b)) RR) '(IN (* s2 (log b)) RR))))
(dk-cite! 'r-exp-strictly-increasing '(* s1 (log b)) '(* s2 (log b)))
(subst (list '= (mdm-R 'b 's1) (mdm-E 'b 's1)))
(subst (list '= (mdm-R 'b 's2) (mdm-E 'b 's2)))
(ass)
(qed 'rpow-exp-strict)
(topic! 'rpow-exp-strict 'analysis)

;;; ---- a larger base gives a smaller power at a nonpositive exponent ----
(sp (make-wff '(FORALL m (IMPLIES (IN m RR) (IMPLIES (< 1 m) (FORALL b (IMPLIES (IN b RR) (IMPLIES (<= m b)
   (FORALL s (IMPLIES (IN s RR) (IMPLIES (<= s 0) (<= (RPOW-STAR b s) (RPOW-STAR m s)))))))))))))
(dk-peel!)
(dk-have! '(< 0 m) (lambda () (dk-ineq! '(< 1 m) '(IN m RR))))
(dk-have! '(< 0 b) (lambda () (dk-ineq! '(< 1 m) '(<= m b) '(IN b RR) '(IN m RR))))
(mdm-val! 'b 's)
(mdm-val! 'm 's)
(fact 'log-in-rr 'm)
(dk-have! '(<= (log m) (log b))
  (lambda ()
    (use-em '(= m b)
      (lambda () (subst '(= m b)) (dk-cite! 'rr-leq-reflexive '(log b)) (mdm-ass0!))
      (lambda ()
        (mdm-and! '(<= m b) '(NOT (= m b)))
        (dk-cite! 'rr-le-ne-lt 'm 'b)
        (dk-cite! 'log-strictly-increasing 'm 'b)
        (dk-ineq! '(< (log m) (log b)) '(IN (log m) RR) '(IN (log b) RR))))))
(dk-cite! 'rr-sub-in-rr '(log b) '(log m))
(dk-cite! 'rr-sub-in-rr 0 's)
(mdm-and! '(IN (- 0 s) RR) '(IN (- (log b) (log m)) RR))
(dk-have! '(<= 0 (- 0 s)) (lambda () (dk-ineq! '(<= s 0) '(IN s RR))))
(dk-have! '(<= 0 (- (log b) (log m))) (lambda () (dk-ineq! '(<= (log m) (log b)) '(IN (log b) RR) '(IN (log m) RR))))
(mdm-and! '(<= 0 (- 0 s)) '(<= 0 (- (log b) (log m))))
(fact 'rr-leq-mul-nonneg '(- 0 s) '(- (log b) (log m)))
(dk-cite! 'rr-mul-in-rr '(- 0 s) '(- (log b) (log m)))
(dk-have! '(= (* (- 0 s) (- (log b) (log m))) (- (* s (log m)) (* s (log b)))) (lambda () (crs)))
(dk-have! '(<= (* s (log b)) (* s (log m)))
  (lambda () (dk-ineq! '(<= 0 (* (- 0 s) (- (log b) (log m)))) '(= (* (- 0 s) (- (log b) (log m))) (- (* s (log m)) (* s (log b))))
                       '(IN (* s (log b)) RR) '(IN (* s (log m)) RR))))
(dk-cite! 'r-exp-mono '(* s (log b)) '(* s (log m)))
(subst (list '= (mdm-R 'b 's) (mdm-E 'b 's)))
(subst (list '= (mdm-R 'm 's) (mdm-E 'm 's)))
(ass)
(qed 'rpow-exp-base-le)
(topic! 'rpow-exp-base-le 'analysis)

;;; =====================================================================
;;; Proposition 7.38 (existence and uniqueness of lambda)
;;; =====================================================================
(define mdm-ag '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD))
(define (mdm-T s) (list 'VNB-LAMBDA 'w 'X (list 'RPOW-STAR '(a w) s)))
(define (mdm-F s) (list 'FINSUM mdm-ag (mdm-T s) 'X))
(define mdm-Flam (list 'VNB-LAMBDA 't 'RR (mdm-F 't)))
(define mdm-N '(CARD X))
(define mdm-stmt
  (list 'FORALL 'X (list 'IMPLIES '(IN X SET) (list 'IMPLIES '(IN (CARD X) NN) (list 'IMPLIES '(<= 2 (CARD X))
    (list 'FORALL 'a (list 'IMPLIES '(IN a (FUN X RR)) (list 'IMPLIES '(FORALL w (IMPLIES (IN w X) (< 1 (a w))))
      (list 'FORSOME 'l (list 'AND '(IN l RR) (list 'AND '(< 0 l) (list 'AND (list '= (mdm-F '(- l)) 1)
        (list 'FORALL 'l2 (list 'IMPLIES '(IN l2 RR) (list 'IMPLIES '(< 0 l2)
          (list 'IMPLIES (list '= (mdm-F '(- l2)) 1) '(= l2 l)))))))))))))))))

(sp (make-wff mdm-stmt))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(fact 'nn-in-rr mdm-N)
(define mdm-wt (dk-pick (lambda (h) (and (eq? (mdm-head h) 'FORALL) (dk-contains? h '<))) "the weights"))
(define (mdm-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (mdm-aw! w)
  (if (not (dk-asm? (list '< 0 (list 'a w))))
      (begin
        (dk-cite! 'fun-apply-type-c 'a 'X 'RR w)
        (dk-apply! mdm-wt w)
        (dk-have! (list '< 0 (list 'a w)) (lambda () (dk-ineq! (list '< 1 (list 'a w)) (list 'IN (list 'a w) 'RR)))))))
;; T(s) in FUN(X, RR) and F(s) real, for s real in context
(define (mdm-typed! s)
  (if (not (dk-asm? (list 'IN (mdm-F s) 'RR)))
      (begin
        (dk-have! (list 'IN (mdm-T s) '(FUN X RR))
          (lambda ()
            (for-each (lambda (leaf) (dk-focus! leaf)
                        (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                            (mdm-ass!)
                            (let ((w (cadr (car (dk-peel!)))))
                              (mdm-aw! w)
                              (dk-split-all! (list (dk-cite! 'rpow-exp-facts (list 'a w) s)))
                              (mdm-ass!))))
                      (dk-opened (lambda () (lam-t))))))
        (dk-cite! 'finsum-rr-in-rr 'X (mdm-T s)))))
(define (mdm-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

;; X has a member (CARD X >= 2)
(dk-have! '(FORSOME k (IN k X))
  (lambda ()
    (use-em '(FORSOME k (IN k X))
      (lambda () (mdm-ass!))
      (lambda ()
        (dk-have! '(SUBSET X EMPTY-SET)
          (lambda () (mac 'subset-def)
                     (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                       (dk-have! '(FORSOME k (IN k X)) (lambda () (ew z) (mdm-ass!)))
                       (ai '(NOT (FORSOME k (IN k X)))))))
        (fact 'empty-set-is-set)
        (fact 'card-empty)
        (dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (from-context!)))
        (dk-cite! 'card-subset-mono 'EMPTY-SET 'X)
        (dk-have! (list '<= mdm-N 0) (lambda () (subst '(= 0 (CARD EMPTY-SET))) (mdm-ass!)))
        (mdm-absurd! '(<= 2 (CARD X)) (list '<= mdm-N 0) (list 'IN mdm-N 'RR))))))

;; F is strictly increasing
(define mdm-strict
  (list 'FORALL 'u (list 'IMPLIES '(IN u RR) (list 'FORALL 'v (list 'IMPLIES '(IN v RR)
    (list 'IMPLIES '(< u v) (list '< (mdm-F 'u) (mdm-F 'v))))))))
(dk-have! mdm-strict
  (lambda ()
    (let* ((pl (dk-peel!))
           (lt (car (filter (lambda (q) (dk-head-is? q '<)) pl)))
           (u (cadr lt)) (v (caddr lt)))
      (mdm-typed! u) (mdm-typed! v)
      (dk-have! (list 'FORALL 'w (list 'IMPLIES '(IN w X) (list '< (list (mdm-T u) 'w) (list (mdm-T v) 'w))))
        (lambda ()
          (let ((w (cadr (car (dk-peel!)))))
            (mdm-aw! w)
            (dk-lam-b!)
            (dk-cite! 'rpow-exp-strict (list 'a w) u v)
            (mdm-ass!))))
      (dk-cite! 'finsum-rr-lt-termwise 'X (mdm-T u) (mdm-T v))
      (mdm-ass!))))

;; F is a function on the line, continuous everywhere
(define mdm-H '(VNB-LAMBDA w X (VNB-LAMBDA rs_ RR (RPOW-STAR (a w) rs_))))
(define mdm-G (list 'VNB-LAMBDA 't 'RR (mdm-T 't)))
(fact 'rr-is-set)
(dk-have! (list 'IN mdm-Flam '(FUN RR RR))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (mdm-ass!)
                    (let ((v (cadr (car (dk-peel!))))) (mdm-typed! v) (mdm-ass!))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN mdm-H '(FUN X (FUN RR RR)))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (mdm-ass!)
                    (let ((w (cadr (car (dk-peel!)))))
                      (mdm-aw! w)
                      (dk-split-all! (list (dk-cite! 'rpow-exp-continuous (list 'a w))))
                      (mdm-ass!))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN mdm-G '(FUN RR (FUN X RR)))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (mdm-ass!)
                    (let ((v (cadr (car (dk-peel!))))) (mdm-typed! v) (mdm-ass!))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'FORALL 'cx_ (list 'IMPLIES '(IN cx_ RR) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS mdm-Flam 'cx_)))
  (lambda ()
    (let ((x0 (cadr (car (dk-peel!)))))
      (dk-have! (list 'FORALL 'w (list 'IMPLIES '(IN w X) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (list mdm-H 'w) x0)))
        (lambda ()
          (let ((w (cadr (car (dk-peel!)))))
            (mdm-aw! w)
            (dk-lam-b!)
            (dk-split-all! (list (dk-cite! 'rpow-exp-continuous (list 'a w))))
            (dk-apply! (dk-pick (lambda (h) (and (eq? (mdm-head h) 'FORALL) (dk-contains? h 'IS-CONTINUOUS-AT) (dk-contains? h (list 'a w)))) "continuity") x0)
            (mdm-ass!))))
      (dk-have! (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list 'FORALL 'w (list 'IMPLIES '(IN w X)
                  (list '= (list (list mdm-G 't) 'w) (list (list mdm-H 'w) 't))))))
        (lambda ()
          (let* ((pl (dk-peel!))
                 (tv (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl))))
                 (w (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'X))) pl)))))
            (mdm-aw! w)
            (mdm-typed! tv)
            (dk-split-all! (list (dk-cite! 'rpow-exp-facts (list 'a w) tv)))
            (dk-lam-b!)
            (rfl))))
      (let* ((fg (list 'VNB-LAMBDA 't 'RR (list 'FINSUM mdm-ag (list mdm-G 't) 'X))))
        (dk-cite! 'finsum-rr-continuous-at 'X mdm-H mdm-G x0)
        (dk-have! (list 'FORALL 'pz_ (list 'IMPLIES '(IN pz_ RR) (list '= (list mdm-Flam 'pz_) (list fg 'pz_))))
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (mdm-typed! z)
              (dk-lam-b!)
              (rfl))))
        (dk-cite! 'cont-transfer-ptwise-eq mdm-Flam fg x0)
        (mdm-ass!)))))
(define mdm-cont (dk-pick (lambda (h) (and (eq? (mdm-head h) 'FORALL) (eq? (cadr h) 'cx_))) "continuity of F"))

;; F(0) = CARD X
(mdm-typed! 0)
(dk-have! (list '= (mdm-F 0) mdm-N)
  (lambda ()
    (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z X) (list '= (list (mdm-T 0) 'z) 1)))
      (lambda ()
        (let ((w (cadr (car (dk-peel!)))))
          (mdm-aw! w)
          (dk-lam-b!)
          (dk-cite! 'rpow-star-zero (list 'a w))
          (mdm-ass!))))
    (dk-cite! 'finsum-rr-const 'X 1 (mdm-T 0))
    (dk-ineq! (list '= (mdm-F 0) (list '* 1 mdm-N)) (list 'IN mdm-N 'RR) (list 'IN (mdm-F 0) 'RR))))

;; an exponent s0 <= 0 with F(s0) < 1
(define mdm-m (dk-skolem! (dk-cite! 'finite-lower-bound-gt 'X 1 'a)))
(define mdm-mcl (dk-pick (lambda (h) (and (eq? (mdm-head h) 'FORALL) (dk-contains? h mdm-m))) "the lower bound"))
(define mdm-Lm (list 'log mdm-m))
(fact 'log-in-rr mdm-m)
(fact 'log-pos-above-one mdm-m)
(dk-have! (list 'NOT (list '= mdm-Lm 0))
  (lambda () (di) (mdm-absurd! (list '= mdm-Lm 0) (list '< 0 mdm-Lm) (list 'IN mdm-Lm 'RR))))
(mdm-and! (list 'IN mdm-Lm 'RR) (list 'NOT (list '= mdm-Lm 0)))
(fact 'rr-recip-closed mdm-Lm)
(fact 'rr-recip-inverse mdm-Lm)
(dk-cite! 'rr-recip-pos mdm-Lm)
(define mdm-v (dk-name! (list 'recip mdm-Lm) 'RR))
(dk-have! (list '= (list '* mdm-Lm mdm-v) 1) (lambda () (subst (list '= mdm-v (list 'recip mdm-Lm))) (mdm-ass!)))
(dk-have! (list '< 0 mdm-v) (lambda () (subst (list '= mdm-v (list 'recip mdm-Lm))) (mdm-ass!)))
(define mdm-nN (list '- 0 mdm-N))
(dk-cite! 'rr-sub-in-rr 0 mdm-N)
(define mdm-s0 (list '* mdm-nN mdm-v))
(dk-cite! 'rr-mul-in-rr mdm-nN mdm-v)
(dk-cite! 'rr-mul-in-rr mdm-N mdm-v)
(dk-have! (list '= (list '* mdm-s0 mdm-Lm) mdm-nN)
  (lambda ()
    (dk-have! (list '= (list '* mdm-s0 mdm-Lm) (list '* mdm-nN (list '* mdm-Lm mdm-v))) (lambda () (crs)))
    (subst (list '= (list '* mdm-s0 mdm-Lm) (list '* mdm-nN (list '* mdm-Lm mdm-v))))
    (subst (list '= (list '* mdm-Lm mdm-v) 1))
    (crs)))
(dk-have! (list '<= mdm-s0 0)
  (lambda ()
    (mdm-and! (list 'IN mdm-N 'RR) (list 'IN mdm-v 'RR))
    (dk-have! (list '<= 0 mdm-N) (lambda () (dk-ineq! '(<= 2 (CARD X)) (list 'IN mdm-N 'RR))))
    (dk-have! (list '<= 0 mdm-v) (lambda () (dk-ineq! (list '< 0 mdm-v) (list 'IN mdm-v 'RR))))
    (mdm-and! (list '<= 0 mdm-N) (list '<= 0 mdm-v))
    (fact 'rr-leq-mul-nonneg mdm-N mdm-v)
    (dk-have! (list '= mdm-s0 (list '- 0 (list '* mdm-N mdm-v))) (lambda () (crs)))
    (dk-ineq! (list '= mdm-s0 (list '- 0 (list '* mdm-N mdm-v))) (list '<= 0 (list '* mdm-N mdm-v))
              (list 'IN mdm-s0 'RR) (list 'IN (list '* mdm-N mdm-v) 'RR))))
;; q = m^s0 = r-exp(-N), E = r-exp(N), q E = 1, E >= 1 + N
(dk-have! (list '< 0 mdm-m) (lambda () (dk-ineq! (list '< 1 mdm-m) (list 'IN mdm-m 'RR))))
(mdm-val! mdm-m mdm-s0)
(define mdm-q (list 'r-exp mdm-nN))
