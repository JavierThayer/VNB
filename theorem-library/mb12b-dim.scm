      (mdm-ass!))))
(dk-have! (list 'AND (list '<= (list mdm-Flam mdm-s0) 1) (list '<= 1 (list mdm-Flam 0)))
  (lambda ()
    (dk-conj-close!
     (lambda ()
       (dk-lam-b!)
       (if (dk-contains? (dk-goal) mdm-s0)
           (dk-ineq! (list '< (mdm-F mdm-s0) 1) (list 'IN (mdm-F mdm-s0) 'RR))
           (dk-ineq! (list '= (mdm-F 0) mdm-N) '(<= 2 (CARD X)) (list 'IN mdm-N 'RR) (list 'IN (mdm-F 0) 'RR)))))))
(define mdm-p (dk-skolem! (dk-cite! 'ivt mdm-Flam mdm-s0 0 1)))
(define mdm-Fp (list mdm-Flam mdm-p))
(dk-lam-b-h! (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) mdm-Fp))) "F(p) = 1"))
(mdm-typed! mdm-p)
(let ((iff (dk-cite! 'ccint-membership mdm-s0 0 mdm-p)))
  (dk-have! (list '<= mdm-p 0) (lambda () (if (dk-only! iff (list 'IN mdm-p (list 'CCINT mdm-s0 0))) (prop)))))
(dk-have! (list 'NOT (list '= mdm-p 0))
  (lambda ()
    (di)
    (dk-have! (list '= (mdm-F 0) 1) (lambda () (subst (list '= 0 mdm-p)) (mdm-ass!)))
    (mdm-absurd! (list '= (mdm-F 0) 1) (list '= (mdm-F 0) mdm-N) '(<= 2 (CARD X)) (list 'IN mdm-N 'RR) (list 'IN (mdm-F 0) 'RR))))
(mdm-and! (list '<= mdm-p 0) (list 'NOT (list '= mdm-p 0)))
(dk-cite! 'rr-le-ne-lt mdm-p 0)

;; lambda = -p
(define mdm-l (list '- mdm-p))
(dk-cite! 'rr-neg-closed mdm-p)
(ew mdm-l)
(dk-have! (list '= (list '- mdm-l) mdm-p) (lambda () (crs)))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((dk-head-is? g 'IN) (mdm-ass!))
      ((dk-head-is? g '<) (dk-ineq! (list '< mdm-p 0) (list 'IN mdm-p 'RR)))
      ((dk-head-is? g '=) (subst (list '= (list '- mdm-l) mdm-p)) (mdm-ass!))
      (#t
       ;; uniqueness
       (let* ((pl (dk-peel!))
              (l2 (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl))))
              (s2 (list '- l2)))
         (dk-cite! 'rr-neg-closed l2)
         (mdm-typed! s2)
         (dk-cite! 'rr-lt-trichotomy s2 mdm-p)
         (let ((tri (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h s2))) "trichotomy")))
           (dk-have! (list '= s2 mdm-p)
             (lambda ()
               (use-em (list '< s2 mdm-p)
                 (lambda () (dk-apply! mdm-strict s2 mdm-p)
                            (mdm-absurd! (list '< (mdm-F s2) (mdm-F mdm-p)) (list '= (mdm-F s2) 1) (list '= (mdm-F mdm-p) 1)
                                         (list 'IN (mdm-F s2) 'RR) (list 'IN (mdm-F mdm-p) 'RR)))
                 (lambda ()
                   (use-em (list '< mdm-p s2)
                     (lambda () (dk-apply! mdm-strict mdm-p s2)
                                (mdm-absurd! (list '< (mdm-F mdm-p) (mdm-F s2)) (list '= (mdm-F s2) 1) (list '= (mdm-F mdm-p) 1)
                                             (list 'IN (mdm-F s2) 'RR) (list 'IN (mdm-F mdm-p) 'RR)))
                     (lambda () (if (dk-only! tri (list 'NOT (list '< s2 mdm-p)) (list 'NOT (list '< mdm-p s2))) (prop)))))))))
         (dk-ineq! (list '= s2 mdm-p) (list 'IN mdm-p 'RR) (list 'IN l2 'RR))))))))
