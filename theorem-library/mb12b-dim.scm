                       (list 'IN (mdm-F mdm-s0) 'RR) (list 'IN mdm-FC 'RR) (list 'IN (list '* mdm-q mdm-N) 'RR))))

;; the intermediate value theorem on [s0, 0]
(dk-have! (list 'FORALL 'iy_ (list 'IMPLIES (list 'IN 'iy_ (list 'CCINT mdm-s0 0)) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS mdm-Flam 'iy_)))
  (lambda ()
    (let ((y (cadr (car (dk-peel!)))))
      (dk-cite! 'ccint-elt-in-rr mdm-s0 0 y)
