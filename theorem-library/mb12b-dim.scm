(dk-cite! 'rr-mul-in-rr mdm-q (list '- mdm-big mdm-N))
(dk-cite! 'rr-mul-in-rr mdm-q mdm-big)
(dk-cite! 'rr-mul-in-rr mdm-q mdm-N)
(dk-have! (list '= (list '* mdm-q (list '- mdm-big mdm-N)) (list '- (list '* mdm-q mdm-big) (list '* mdm-q mdm-N))) (lambda () (crs)))
(dk-have! (list '< (list '* mdm-q mdm-N) 1)
  (lambda () (dk-ineq! (list '< 0 (list '* mdm-q (list '- mdm-big mdm-N)))
                       (list '= (list '* mdm-q (list '- mdm-big mdm-N)) (list '- (list '* mdm-q mdm-big) (list '* mdm-q mdm-N)))
                       (list '= (list '* mdm-q mdm-big) 1)
                       (list 'IN (list '* mdm-q (list '- mdm-big mdm-N)) 'RR) (list 'IN (list '* mdm-q mdm-big) 'RR)
                       (list 'IN (list '* mdm-q mdm-N) 'RR))))
;; F(s0) <= sum of the constant q = q N < 1
(mdm-typed! mdm-s0)
(define mdm-C (list 'VNB-LAMBDA 'w 'X mdm-q))
(dk-have! (list 'IN mdm-C '(FUN X RR))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (mdm-ass!)
                    (begin (dk-peel!) (mdm-ass!))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z X) (list '= (list mdm-C 'z) mdm-q)))
  (lambda () (dk-peel!) (dk-lam-b!) (rfl)))
