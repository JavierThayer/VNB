;;; sub-riesz.scm -- agent BA-1117-TRACE (round 2), 2026-11-17.
;;; Finding F-5.1 of BA-1111-C2-REPORT.md: a bounded CC-linear functional on a submodule M of a Hilbert
;;; space H is <m | Y> on M for some Y in H.  Proof: extend it by the complex Hahn-Banach theorem
;;; (hahn-banach-seminorm, at the seminorm x |-> ||x|| c) to a bounded functional on H, which is
;;; continuous (cc-functional-continuous-of-bound) and so <. | Y> (riesz-representation-exists).
;;; DESTINATION: theorem-library/sub-riesz.scm.  Library: operator-algebras.  Helper prefix: srz-.
;;; Nothing asserted.
(define (srz-have! f th) (dk-have! f (dk-lane th)))
(define (srz-ctx f) (or (dk-ctx-form f) (error "srz-ctx: not in context" (expression->string f))))
(define (srz-iff-fwd! iff from)
  (let ((b (caddr iff))) (if (not (dk-asm? b)) (dk-have! b (lambda () (if (dk-only! iff from) (prop))))) b))
(define (srz-done! name)
  (if (not (proof-done? *ps*))
      (begin (display ";; srz: OPEN LEAVES before qed ") (display name) (newline)
             (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves))))
  (qed name) (topic! name 'analysis))
(define (srz-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (srz-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (srz-chain! ch provers)
  (let loop ((r ch) (ps provers))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (cadr r))
            (loop (let ((new (dk-landed* (lambda () (detach! (or (dk-ctx-form r) r))))))
                    (if (pair? new) (dk--deepest-of new) (srz-ctx (caddr r))))
                  ps)
            (begin (if (null? ps) (error "srz-chain!: no prover left for" (expression->string (cadr r))))
                   (loop (detach-with! (or (dk-ctx-form r) r) (car ps)) (cdr ps))))
        r)))
(define (srz-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define srz-CM '(COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE v))
(define srz-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define srz-P '(VNB-LAMBDA wsx_ (VEC v) (* (IP-NORM v wsx_) c)))
(define (srz-ipn! x)
  (if (not (dk-asm? (list '<= 0 (list 'IP-NORM 'v x))))
      (begin (dk-apply! (dk-cite! 'cips-ipn-in-rr 'v) x) (dk-apply! (dk-cite! 'cips-ipn-nonneg 'v) x))))
(define (srz-views!)                     ; the module view's accessors and the scalar ring
  (for-each (lambda (n) (dk-cite! n 'v))
            '(cips-module-view-act cips-module-view-scal cips-module-view-vadd cips-module-view-vec
              cips-module-view-vneg cips-module-view-vzero cips-scal-pin complex-inner-product-space-as-module-is-module
              cips-vec-set))
  (dk-cite! 'cc-scalar-ring-carr) (dk-cite! 'cc-scalar-ring-add) (dk-cite! 'cc-scalar-ring-mul)
  (dk-cite! 'cc-nf-fnrm) (dk-cite! 'cc-is-normed-field) (dk-cite! 'cc-is-set))
(define (srz-norm! g)                    ; rewrite the view and the ring in the goal
  (for-each (lambda (e) (if (dk-contains? (dk-goal) (cadr e)) (subst e)))
            (list (list '== (list 'VEC srz-CM) '(VEC v)) (list '== (list 'VADD srz-CM) '(VADD v))
                  (list '== (list 'ACT srz-CM) '(ACT v)) (list '== (list 'VNEG srz-CM) '(VNEG v))
                  (list '== (list 'VZERO srz-CM) '(VZERO v)) (list '== (list 'SCAL srz-CM) '(SCAL v))))
  (if (and g (dk-contains? (dk-goal) '(SCAL v))) (subst (list '= '(SCAL v) srz-R)))
  (if (and g (dk-contains? (dk-goal) (list 'CARR srz-R))) (subst (list '== (list 'CARR srz-R) 'CC))))

(define srz-hyps
  (list '(IS-HILBERT-SPACE v) '(IS-SUBMODULE v ss) '(IN f (FUN ss CC))
        '(FORALL wsa_ (IMPLIES (IN wsa_ ss) (FORALL wsb_ (IMPLIES (IN wsb_ ss) (= (f ((VADD v) wsa_ wsb_)) (+ (f wsa_) (f wsb_)))))))
        '(FORALL wsk_ (IMPLIES (IN wsk_ CC) (FORALL wsa_ (IMPLIES (IN wsa_ ss) (= (f ((ACT v) wsk_ wsa_)) (* wsk_ (f wsa_)))))))
        '(IN c RR) '(<= 0 c)
        '(FORALL wsa_ (IMPLIES (IN wsa_ ss) (<= (magnitude (f wsa_)) (* c (IP-NORM v wsa_)))))))
(sp (make-wff (srz-alls '(v ss f c)
  (srz-imps srz-hyps '(FORSOME wsy_ (AND (IN wsy_ (VEC v)) (FORALL wsa_ (IMPLIES (IN wsa_ ss) (= (f wsa_) ((IP v) wsa_ wsy_))))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(srz-views!)
(dk-have! '(SUBSET ss (VEC v)) (lambda () (mac-h 'is-submodule (srz-ctx '(IS-SUBMODULE v ss))) (dk-split-all!) (dk-ass!)))
;; the seminorm x |-> ||x|| c
(dk-have! (list 'IS-SEMINORM 'CC-NORMED-FIELD srz-CM srz-P)
  (lambda ()
    (mac 'is-seminorm)
    (dk-conj-close!
      (lambda ()
        (srz-norm! #t)
        (cond
          ((srz-grounded?) #t)
          ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) '=) (rfl))
          ((and (dk-head-is? (dk-goal) 'IN) (pair? (caddr (dk-goal))) (eq? (car (caddr (dk-goal))) 'FUN))
           (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (srz-ipn! x) (dk-real! (list '* (list 'IP-NORM 'v x) 'c)) (dk-ass!)))
                         (lambda () (dk-ass!))))
          (#t
           (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC v)))) ld)))
                  (ks (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'CC))) ld))))
             (cond
               ((and (= (length xs) 1) (null? ks))        ; 0 <= p(x)
                (let ((x (car xs)))
                  (srz-ipn! x) (dk-lam-b!)
                  (dk-real! 0)
                  (dk-cite! 'rr-mul-le-right 0 (list 'IP-NORM 'v x) 'c)
                  (dk-real! (list '* (list 'IP-NORM 'v x) 'c))
                  (dk-ineq! (list '<= '(* 0 c) (list '* (list 'IP-NORM 'v x) 'c)) (list 'IN (list '* (list 'IP-NORM 'v x) 'c) 'RR) '(IN c RR))))
               ((= (length xs) 2)                          ; the triangle inequality
                (let* ((x (car xs)) (y (cadr xs)) (xy (list '(VADD v) x y))
                       (a (list 'IP-NORM 'v x)) (b (list 'IP-NORM 'v y)) (ab (list 'IP-NORM 'v xy)))
                  (dk-apply! (dk-cite! 'cips-vadd-type 'v) x y)
                  (srz-ipn! x) (srz-ipn! y) (srz-ipn! xy)
                  (dk-lam-b!)
                  (dk-cite! 'cips-minkowski 'v x y)
                  (dk-real! (list '+ a b))
                  (dk-cite! 'rr-mul-le-right ab (list '+ a b) 'c)
                  (dk-have! (list '= (list '* (list '+ a b) 'c) (list '+ (list '* a 'c) (list '* b 'c))) (lambda () (crs)))
                  (let ((h (dk-rewrite-h! (list '<= (list '* ab 'c) (list '* (list '+ a b) 'c)) (list '* (list '+ a b) 'c) (list '+ (list '* a 'c) (list '* b 'c)))))
                    (dk-ass!))))
               (#t                                          ; homogeneity
                (let* ((k (car ks)) (x (car xs)) (kx (list '(ACT v) k x)))
                  (dk-apply! (dk-cite! 'cips-act-type 'v) k x)
                  (srz-ipn! x) (srz-ipn! kx)
                  (dk-cite! 'cc-magnitude-closed k)
                  (subst (list '== '(FNRM CC-NORMED-FIELD) '(VNB-LAMBDA x_ CC (magnitude x_))))
                  (dk-lam-b!)
                  (dk-apply! (dk-cite! 'cips-ipn-homog 'v) k x)
                  (subst (list '= (list 'IP-NORM 'v kx) (list '* (list 'magnitude k) (list 'IP-NORM 'v x))))
                  (crs)))))))))))
;; f is CC-linear on the submodule, for the module view
(dk-have! (list 'IS-SUBMODULE srz-CM 'ss)
  (lambda () (mac 'is-submodule) (srz-norm! #f) (mac-h 'is-submodule (srz-ctx '(IS-SUBMODULE v ss))) (dk-split-all!)
             (dk-conj-close! (lambda () (srz-norm! #f) (dk-ass!)))))
(dk-have! (list 'IS-K-LINEAR-ON srz-CM 'ss 'f)
  (lambda ()
    (mac 'is-k-linear-on)
    (dk-conj-close!
      (lambda ()
        (srz-norm! #t)
        (if (not (dk-ass!))
            (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ss))) ld)))
                   (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'CC))) ld))))
              (srz-norm! #t)
              (for-each (lambda (x) (dk-cite! 'fun-apply-type-c 'f 'ss 'CC x)) xs)
              (if (null? ks)
                  (let ((x (car xs)) (y (cadr xs)))
                    (subst (list '== (list 'ADD srz-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_))))
                    (dk-lam-b!)
                    (if (not (srz-grounded?)) (begin (dk-apply! (srz-ctx (list-ref srz-hyps 3)) x y) (dk-ass!))))
                  (let ((k (car ks)) (x (car xs)))
                    (subst (list '== (list 'MUL srz-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_))))
                    (dk-lam-b!)
                    (if (not (srz-grounded?)) (begin (dk-apply! (srz-ctx (list-ref srz-hyps 4)) k x) (dk-ass!)))))))))))
(dk-have! (list 'FORALL 'wsz_ (list 'IMPLIES '(IN wsz_ ss) (list '<= '((FNRM CC-NORMED-FIELD) (f wsz_)) (list srz-P 'wsz_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (fx (list 'f x)))
      (dk-cite! 'subset-mem-fwd 'ss '(VEC v) x)
      (dk-cite! 'fun-apply-type-c 'f 'ss 'CC x)
      (srz-ipn! x)
      (subst (list '== '(FNRM CC-NORMED-FIELD) '(VNB-LAMBDA x_ CC (magnitude x_))))
      (dk-lam-b!)
      (dk-apply! (srz-ctx (list-ref srz-hyps 7)) x)
      (dk-have! (list '= (list '* 'c (list 'IP-NORM 'v x)) (list '* (list 'IP-NORM 'v x) 'c)) (lambda () (crs)))
      (subst (list '= (list '* (list 'IP-NORM 'v x) 'c) (list '* 'c (list 'IP-NORM 'v x))))
      (dk-ass!))))
(dk-have! '(OR (= CC-NORMED-FIELD RR-NORMED-FIELD) (= CC-NORMED-FIELD CC-NORMED-FIELD))
  (lambda () (dk-have! '(= CC-NORMED-FIELD CC-NORMED-FIELD) (lambda () (rfl))) (prop)))
(dk-have! (list '= (list 'SCAL srz-CM) srz-R) (lambda () (srz-norm! #t) (if (not (srz-grounded?)) (rfl))))
(define srz-hb (srz-chain! (dk-cite! 'hahn-banach-seminorm srz-CM srz-P 'ss 'f 'CC-NORMED-FIELD) '()))
(define srz-ff (dk-skolem! srz-hb #t))
(dk-split-all! (filter (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h srz-ff))) (dk-asms)))
;; the extension, read for v
(define srz-klin (list 'IS-K-LINEAR srz-CM srz-ff))
(dk-have! (list 'IN srz-ff '(FUN (VEC v) CC))
  (lambda () (mac-h 'is-k-linear (srz-ctx srz-klin)) (dk-split-all!)
             (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) srz-ff))) (dk-asms))))
               (let* ((h1 (dk-rewrite-h! h (list 'VEC srz-CM) '(VEC v)))
                      (h2 (dk-rewrite-h! h1 (list 'SCAL srz-CM) '(SCAL v)))
                      (h3 (dk-rewrite-h! h2 '(SCAL v) srz-R))
                      (h4 (dk-rewrite-h! h3 (list 'CARR srz-R) 'CC)))
                 (dk-ass!)))))
(dk-have! (list 'IS-CC-LINEAR-FUNCTIONAL 'v srz-ff)
  (lambda ()
    (mac 'is-cc-linear-functional)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))) ld)))
                   (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'CC))) ld))))
              (for-each (lambda (x) (dk-cite! 'fun-apply-type-c srz-ff '(VEC v) 'CC x)) xs)
              (mac-h 'is-k-linear (srz-ctx srz-klin))
              (dk-split-all!)
              (let* ((cl (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (if (null? ks) 'VADD 'ACT)) (dk-contains? h srz-ff))) (dk-asms))))
                (if (null? ks)
                    (begin
                      (let* ((x (car xs)) (y (cadr xs)))
                        (dk-have! (list 'IN x (list 'VEC srz-CM)) (lambda () (srz-norm! #t) (dk-ass!)))
                        (dk-have! (list 'IN y (list 'VEC srz-CM)) (lambda () (srz-norm! #t) (dk-ass!)))
                        (dk-apply! cl x y)
                        (let* ((e (find-first (lambda (h) (and (dk-head-is? h '=) (dk-contains? h x) (dk-contains? h y) (dk-contains? h srz-ff))) (dk-asms)))
                               (e1 (dk-rewrite-h! e (list 'VADD srz-CM) '(VADD v)))
                               (e2 (dk-rewrite-h! e1 (list 'SCAL srz-CM) '(SCAL v)))
                               (e3 (dk-rewrite-h! e2 '(SCAL v) srz-R))
                               (e4 (dk-rewrite-h! e3 (list 'ADD srz-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))))
                          (dk-lam-b-h! e4)
                          (dk-ass!))))
                    (let* ((k (car ks)) (x (car xs)))
                      (dk-have! (list 'IN x (list 'VEC srz-CM)) (lambda () (srz-norm! #t) (dk-ass!)))
                      (dk-have! (list 'IN k (list 'CARR (list 'SCAL srz-CM))) (lambda () (srz-norm! #t) (dk-ass!)))
                      (dk-apply! cl k x)
                      (let* ((e (find-first (lambda (h) (and (dk-head-is? h '=) (dk-contains? h x) (dk-contains? h k) (dk-contains? h srz-ff))) (dk-asms)))
                             (e1 (dk-rewrite-h! e (list 'ACT srz-CM) '(ACT v)))
                             (e2 (dk-rewrite-h! e1 (list 'SCAL srz-CM) '(SCAL v)))
                             (e3 (dk-rewrite-h! e2 '(SCAL v) srz-R))
                             (e4 (dk-rewrite-h! e3 (list 'MUL srz-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))))
                        (dk-lam-b-h! e4)
                        (dk-ass!)))))))))))
(define srz-bnd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srz-ff) (dk-contains? h 'FNRM))) "the extension's bound"))
(dk-have! (list 'FORALL 'wsz_ (list 'IMPLIES '(IN wsz_ (VEC v)) (list '<= (list 'magnitude (list srz-ff 'wsz_)) '(* c (IP-NORM v wsz_)))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-have! (list 'IN x (list 'VEC srz-CM)) (lambda () (srz-norm! #t) (dk-ass!)))
      (dk-cite! 'fun-apply-type-c srz-ff '(VEC v) 'CC x)
      (srz-ipn! x)
      (dk-apply! srz-bnd x)
      (let* ((e (find-first (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h x) (dk-contains? h 'FNRM))) (dk-asms)))
             (e1 (dk-rewrite-h! e '(FNRM CC-NORMED-FIELD) '(VNB-LAMBDA x_ CC (magnitude x_)))))
        (dk-lam-b-h! e1))
      (dk-have! (list '= (list '* 'c (list 'IP-NORM 'v x)) (list '* (list 'IP-NORM 'v x) 'c)) (lambda () (crs)))
      (subst (list '= (list '* 'c (list 'IP-NORM 'v x)) (list '* (list 'IP-NORM 'v x) 'c)))
      (dk-ass!))))
(dk-cite! 'cc-functional-continuous-of-bound 'v srz-ff 'c)
(define srz-y (dk-skolem! (dk-cite! 'riesz-representation-exists 'v srz-ff) #t))
(define srz-rep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srz-y) (dk-contains? h srz-ff))) "Riesz"))
(ew srz-y)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let ((x (dk-di-var!)))
          (dk-cite! 'subset-mem-fwd 'ss '(VEC v) x)
          (dk-apply! srz-rep x)
          (mac-h 'extends-on (srz-ctx (list 'EXTENDS-ON 'ss srz-ff 'f)))
          (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srz-ff) (dk-contains? h 'f) (not (dk-contains? h 'FNRM)) (not (dk-contains? h srz-y)) (not (dk-contains? h 'VADD)) (not (dk-contains? h 'ACT)))) "extends") x)
          (subst (list '= (list 'f x) (list srz-ff x)))
          (dk-ass!)))))
(srz-done! 'submodule-functional-riesz)
