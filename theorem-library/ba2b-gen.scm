;;; Library: operator-algebras.

;;; ba2b-gen.scm -- the C*-subalgebra generated by an element (CSTAR-GEN, ba2b-gen-vocab): it contains the
;;; element, it lies in the algebra, and it is the least norm-closed unital *-subalgebra containing it.
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 3 (the object of Proposition 1.31).
;;; Agent BA-2B, wave 2026-11-10.  Destination: theorem-library/ba2b-gen.scm.  Library: operator-algebras.
;;; All proofs modulo 0.  Helper prefix b2n-.
;;; LOAD WINDOW: after ba2b-gen-vocab, BA-2's ba2-cstar (bcp-star-fun, bcp-u-bae-act-type) and the UIBA ring
;;; view laws (ring-*-uba-as-ring-uiba-as-uba).

(define (b2n-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba2b-gen: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba2b-gen: unfinished" name))))
(define (b2n-fam a x)
  (list 'SEP 'b2vs_ (list 'POWER (list 'VEC a))
        (list 'AND (list 'IS-CLOSED-STAR-SUBALGEBRA-SET a 'b2vs_) (list 'IN x 'b2vs_))))

;;; the whole algebra is a norm-closed unital *-subalgebra
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (IS-CLOSED-STAR-SUBALGEBRA-SET a (VEC a))))))
(dk-peel!)
(mac 'is-closed-star-subalgebra-set)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond ((dk-head-is? g0 'SUBSET) (dk-cite! 'subset-refl '(VEC a)) (dk-ass!))
            (#t
             (if (dk-head-is? g0 'FORALL) (dk-peel!))
             (let* ((g (dk-goal)) (t (cadr g))
                    (h (if (pair? t) (if (pair? (car t)) (car (car t)) (car t)) t)))
               (cond ((not (pair? t)) (dk-ass!))
                     ((eq? h 'VADD) (dk-cite! 'ring-add-closed-uba-as-ring-uiba-as-uba 'a (cadr t) (caddr t)) (dk-ass!))
                     ((eq? h 'VMUL) (dk-cite! 'ring-carrier-closed-mul-uba-as-ring-uiba-as-uba 'a (cadr t) (caddr t)) (dk-ass!))
                     ((eq? h 'ACT) (dk-cite! 'bcp-u-bae-act-type 'a (cadr t) (caddr t)) (dk-ass!))
                     ((eq? h 'VONE) (dk-cite! 'ring-one-in-uba-as-ring-uiba-as-uba 'a) (dk-ass!))
                     ((eq? h 'VSTAR)
                      (dk-cite! 'bcp-star-fun 'a)
                      (dk-cite! 'fun-apply-type-c '(VSTAR a) '(VEC a) '(VEC a) (cadr t))
                      (dk-ass!))
                     (#t (error "b2n: unexpected clause" g)))))))))
(b2n-qed! 'b2n-vec-closed-star)

;;; a norm-closed unital *-subalgebra S containing x is a member of the family
(define (b2n-in-fam! a x S)
  (dk-cite! 'frm-module-vec-set-uba-as-module-uiba-as-uba a)
  (dk-have! (list 'IN S (b2n-fam a x))
    (lambda ()
      (in-sep!
        (lambda ()
          (mac 'power-set-membership)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (begin (dk-peel!)
                         (let ((z (cadr (dk-goal))))
                           (dk-cite! 'subset-mem-fwd S (list 'VEC a) z)
                           (dk-ass!)))
                  (begin (dk-cite! 'subclass-of-set-is-set S (list 'VEC a)) (dk-ass!))))))
        (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (IN x (CSTAR-GEN a x))))))))
(dk-peel!)
(dk-cite! 'b2n-vec-closed-star 'a)
(dk-project! '(SUBSET (VEC a) (VEC a)) 'is-closed-star-subalgebra-set '(IS-CLOSED-STAR-SUBALGEBRA-SET a (VEC a)))
(b2n-in-fam! 'a 'x '(VEC a))
(mac 'CSTAR-GEN)
(mac 'intersection-of-membership)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin (ew '(VEC a)) (dk-ass!))
        (begin
          (dk-peel!)
          (let* ((S (caddr (dk-goal)))
                 (m (dk-pick (lambda (h) (equal? h (list 'IN S (b2n-fam 'a 'x)))) "S in the family")))
            (dk-project! (list 'IN 'x S) (lambda () (sep-me m)))
            (dk-ass!))))))
(b2n-qed! 'cstar-gen-contains)

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (FORALL s
  (IMPLIES (IS-CLOSED-STAR-SUBALGEBRA-SET a s) (IMPLIES (IN x s) (SUBSET (CSTAR-GEN a x) s)))))))))
(dk-peel!)
(dk-project! '(SUBSET s (VEC a)) 'is-closed-star-subalgebra-set '(IS-CLOSED-STAR-SUBALGEBRA-SET a s))
(b2n-in-fam! 'a 'x 's)
(mac 'CSTAR-GEN)
(dk-cite! 'intersection-of-subset-member (b2n-fam 'a 'x) 's)
(dk-ass!)
(b2n-qed! 'cstar-gen-least)

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (SUBSET (CSTAR-GEN a x) (VEC a))))))))
(dk-peel!)
(dk-cite! 'b2n-vec-closed-star 'a)
(dk-cite! 'cstar-gen-least 'a 'x '(VEC a))
(dk-ass!)
(b2n-qed! 'cstar-gen-subset)
