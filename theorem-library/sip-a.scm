  (FORALL r_ (IMPLIES (IN r_ RR) (FORALL a_ (IMPLIES (IN a_ (VEC v))
    (= ((ACT (SIP-QUOTIENT v)) r_ (CLASS (SIP-SETOID v) a_))
       (CLASS (SIP-SETOID v) ((ACT v) r_ a_)))))))))))
