(sipq-setup!)
(sipq-clq! 'a_)
(fact 'sipq-act 'v)
(subst '(= (ACT (SIP-QUOTIENT v)) (SIP-QACT v)))
(mac 'SIP-QACT)
(dk-lam-b!)
(fact 'sipq-scale-computes 'v 'r_ 'a_)
