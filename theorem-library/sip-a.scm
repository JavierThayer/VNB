  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipa-qed! 'sipq-act-fun)

;;; ==========================================================================================
;;; THE QUOTIENT IS A PRE-HILBERT SPACE.  One lemma per conjunct of the definition at
;;; s := SIP-QUOTIENT(v), each stated as that conjunct; the capstone unfolds the definition
;;; and finds each in context.
;;;
;;; THE DRIVE OF A LAW.  Peel the law's binders; LIFT each quotient variable u to a
;;; representative (quotient-rep: u = [a], a in VEC(v)) and each quotient scalar to RR;
;;; NORMALISE the goal by the computation equations, innermost first, until no operation of
;;; the quotient is left; the goal is then the law in v under CLASS (or, for the form laws,
;;; the law in v itself), and one citation closes it.
;;; ==========================================================================================
(sipa-project! 'sip-scal-ring '(IS-RING (SCAL v)))

;;; ---- the six conjuncts that are typings or pins ------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (= (LENGTH (SIP-QUOTIENT v)) 7)))))
(di) (di)
(mac 'SIP-QUOTIENT)
(len-r)
(if (not (proof-done? *ps*)) (arith))
(sipa-qed! 'sipq-length)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-RING (SCAL (SIP-QUOTIENT v)))))))
(di) (di)
(fact 'sipq-scal 'v)
(subst '(= (SCAL (SIP-QUOTIENT v)) (SCAL v)))
(fact 'sip-scal-ring 'v)
(ass)
(sipa-qed! 'sipq-scal-ring)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (= (SCAL (SIP-QUOTIENT v)) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))))))
(di) (di)
(fact 'sipq-scal 'v)
(subst '(= (SCAL (SIP-QUOTIENT v)) (SCAL v)))
(fact 'sip-scal-pin 'v)
(ass)
(sipa-qed! 'sipq-scal-pin)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (= (CARR (SCAL (SIP-QUOTIENT v))) RR)))))
(di) (di)
(fact 'sipq-scal 'v)
(subst '(= (SCAL (SIP-QUOTIENT v)) (SCAL v)))
(fact 'sip-scal-carr 'v)
(ass)
(sipa-qed! 'sipq-scal-carr)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IN (VEC (SIP-QUOTIENT v)) SET)))))
(di) (di)
(sipq-setup!)
(fact 'sipq-vec 'v)
(subst (list '= '(VEC (SIP-QUOTIENT v)) sipq-Q))
(fact 'quotient-is-set sipq-S)
(ass)
(sipa-qed! 'sipq-vec-set)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IN (VZERO (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v)))))))
(di) (di)
(sipq-setup!)
(fact 'sipq-vec 'v)
(fact 'sipq-vzero 'v)
(subst (list '= '(VEC (SIP-QUOTIENT v)) sipq-Q))
(subst (list '= '(VZERO (SIP-QUOTIENT v)) (sipq-cl '(VZERO v))))
(sipq-clq! '(VZERO v))
(ass)
(sipa-qed! 'sipq-vzero-in)

(define sipq-readoff-names '(sipq-scal sipq-vec sipq-vadd sipq-vzero sipq-vneg sipq-act sipq-rip))
(define (sipq-law-open!)
  (di) (di)
  (sipa-pin!)
  (fact 'sip-scal-carr 'v)
  (fact 'sip-scal-ring 'v)
  (sipq-setup!)
  (for-each (lambda (n) (fact n 'v)) sipq-readoff-names)
  ;; the accessors of the quotient TYPED in context, so that every term the unfoldings
  ;; below match is certified defined (META-10: a macete owes t = t otherwise)
  (for-each (lambda (n) (fact n 'v))
            '(sipq-scal-ring sipq-vec-set sipq-vzero-in sipq-vadd-fun sipq-vneg-fun sipq-act-fun sipq-rip-fun)))

(define (sipq-lift-var! u)
  (dk-have! (list 'IN u sipq-Q) (lambda () (subst (list '= sipq-Q (list 'VEC sipq-QS))) (ass)))
  (let* ((ex (dk-cite! 'quotient-rep sipq-S u))
         (a  (dk-skolem! ex)))
    (dk-have! (list 'IN a '(VEC v)) (lambda () (subst '(= (VEC v) (PTS (SIP-SETOID v)))) (ass)))
    (subst (list '= u (sipq-cl a)))
    a))
(define (sipq-lift-scalar! r)
  (dk-have! (list 'IN r '(CARR (SCAL v))) (lambda () (subst (list '= '(SCAL v) (list 'SCAL sipq-QS))) (ass)))
  (dk-have! (list 'IN r 'RR) (lambda () (subst '(= RR (CARR (SCAL v)))) (ass)))
  r)

;;; type a scalar term of SCAL(v) in RR (and in CARR(SCAL v))
(define (sipq-scalar-rr! t)
  (let ((in-c (list 'IN t '(CARR (SCAL v)))) (in-r (list 'IN t 'RR)))
    (cond ((dk-asm? in-r) #t)
          ((and (pair? t) (equal? (car t) '(ADD (SCAL v))))
           (sipq-scalar-rr! (cadr t)) (sipq-scalar-rr! (caddr t))
           (dk-cite! 'ring-add-closed '(SCAL v) (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) '(MUL (SCAL v))))
           (sipq-scalar-rr! (cadr t)) (sipq-scalar-rr! (caddr t))
           (dk-cite! 'ring-carrier-closed-mul '(SCAL v) (cadr t) (caddr t)))
          ((equal? t '(ONE (SCAL v)))
           (dk-cite! 'ring-one-in '(SCAL v)))
          (#t (error "sipq-scalar-rr!: cannot type" (expression->string t))))
    (if (not (dk-asm? in-c))
        (dk-have! in-c (lambda () (subst '(= (CARR (SCAL v)) RR)) (ass))))
    (dk-have! in-r (lambda () (subst '(= RR (CARR (SCAL v)))) (ass)))))

;;; the innermost quotient operation applied to classes, or #f
(define (sipq-class? e) (and (pair? e) (eq? (car e) 'CLASS) (equal? (cadr e) sipq-S)))
(define (sipq-redex e)
  (if (not (pair? e))
      #f
      (or (let loop ((xs e)) (cond ((not (pair? xs)) #f) ((sipq-redex (car xs))) (#t (loop (cdr xs)))))
          (let ((h (car e)))
            (cond ((and (equal? h (list 'VADD sipq-QS)) (= (length e) 3) (sipq-class? (cadr e)) (sipq-class? (caddr e))) e)
                  ((and (equal? h (list 'RIP sipq-QS)) (= (length e) 3) (sipq-class? (cadr e)) (sipq-class? (caddr e))) e)
                  ((and (equal? h (list 'VNEG sipq-QS)) (= (length e) 2) (sipq-class? (cadr e))) e)
                  ((and (equal? h (list 'ACT sipq-QS)) (= (length e) 3) (sipq-class? (caddr e))) e)
                  (#t #f))))))
(define (sipq-norm!)
  (if (sipq-has-head? 'SCAL (dk-goal)) (vnb-guard (lambda () (subst (list '= (list 'SCAL sipq-QS) '(SCAL v))))))
  (if (dk--occurs? (list 'VZERO sipq-QS) (dk-goal)) (subst (list '= (list 'VZERO sipq-QS) (sipq-cl '(VZERO v)))))
  (let loop ((fuel 40))
    (let ((rx (sipq-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let* ((h (car (car rx)))
                 (eqn (case h
                        ((VADD) (sipa-vt (caddr (cadr rx))) (sipa-vt (caddr (caddr rx)))
                                (dk-cite! 'sipq-vadd-computes 'v (caddr (cadr rx)) (caddr (caddr rx))))
                        ((RIP)  (sipa-vt (caddr (cadr rx))) (sipa-vt (caddr (caddr rx)))
                                (dk-cite! 'sipq-rip-computes 'v (caddr (cadr rx)) (caddr (caddr rx))))
                        ((VNEG) (sipa-vt (caddr (cadr rx)))
                                (dk-cite! 'sipq-vneg-computes 'v (caddr (cadr rx))))
                        ((ACT)  (sipq-scalar-rr! (cadr rx)) (sipa-vt (caddr (caddr rx)))
                                (dk-cite! 'sipq-act-computes 'v (cadr rx) (caddr (caddr rx))))
                        (else (error "sipq-norm!: unexpected redex" rx)))))
            (subst eqn)
            (loop (- fuel 1)))))))

;;; close (= [T1] [T2]) by a chain of context equations from T1 to T2 (either orientation),
;;; at most three links, then rfl
(define (sipq-close-class-eq!)
  (let* ((leaf (proof-state-focus *ps*))
         (g (dk-goal)) (t1 (caddr (cadr g))) (t2 (caddr (caddr g)))
         (eqs (filter (lambda (f) (dk-head-is? f '=)) (dk-asms)))
         (nbrs (lambda (t) (append (map caddr (filter (lambda (f) (equal? (cadr f) t)) eqs))
                                   (map cadr (filter (lambda (f) (equal? (caddr f) t)) eqs))))))
    (let ((path (let search ((t t1) (d 0) (seen (list t1)))
                  (cond ((equal? t t2) '())
                        ((> d 2) #f)
                        (#t (let try ((ns (nbrs t)))
                              (cond ((null? ns) #f)
                                    ((member (car ns) seen) (try (cdr ns)))
                                    (#t (let ((p (search (car ns) (+ d 1) (cons (car ns) seen))))
                                          (if p (cons (cons t (car ns)) p) (try (cdr ns))))))))))))
      (if (not path) (error "sipq-close-class-eq!: no chain from" (expression->string t1) 'to (expression->string t2)))
      (for-each (lambda (st) (if (not (sequent-node-grounded? leaf)) (subst (list '= (car st) (cdr st))))) path)
      ;; the rewritten sequent may be one a sibling already proved (hash-consing): then the
      ;; leaf is grounded and there is nothing left to close
      (if (not (sequent-node-grounded? leaf)) (rfl)))))

;;; a left-to-right map (MIT's `map' does not promise an order, and these have effects)
(define (sipq-map! f xs)
  (let loop ((xs xs) (acc '()))
    (if (null? xs) (reverse acc) (loop (cdr xs) (cons (f (car xs)) acc)))))
(define (sipq-perms xs)
  (if (null? xs) '(())
      (append-map (lambda (x) (map (lambda (p) (cons x p)) (sipq-perms (delete x xs)))) xs)))
;;; the drive of one law leaf; CLOSER gets the representatives and scalars in binder order
(define (sipq-law-leaf! closer)
  (let* ((lk (reverse (dk-peel!)))
         (us (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC sipq-QS)))) lk)))
         (ks (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR (list 'SCAL sipq-QS))))) lk)))
         (as (sipq-map! sipq-lift-var! us))
         (rs (sipq-map! sipq-lift-scalar! ks)))
    (sipq-norm!)
    ;; a two-sided law (is-identity, has-inverses) is a conjunction under the binder
    (dk-conj-close!
      (lambda ()
        (let ((leaf (proof-state-focus *ps*)))
          (closer as rs)
          (if (not (sequent-node-grounded? leaf))
              (error "sipq-law-leaf!: the closer left the leaf open" (expression->string (dk-goal)))))))))

(define (sipq-law! name conj unfold closer)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) conj))))
  (sipq-law-open!)
  (if unfold (mac unfold))
  (dk-conj-close! (lambda () (sipq-law-leaf! closer)))
  (sipa-qed! name))

;;; Cite each (lemma . args) at every ordering of the representatives and of the scalars
;;; (the binder order is not trusted), then close the class equation by a chain.
(define (sipq-cite-close! lemmas)
  (lambda (as rs)
    (for-each (lambda (l)
                (for-each (lambda (pa)
                            (for-each (lambda (pr) (apply dk-cite! (car l) 'v ((cdr l) pa pr)))
                                      (sipq-perms rs)))
                          (sipq-perms as)))
              lemmas)
    (sipq-close-class-eq!)))
(define (sipq-cite-ass! lemma args)          ; the form laws: one citation is the goal
  (lambda (as rs)
    (let loop ((ps (sipq-perms as)))
      (cond ((sequent-node-grounded? (proof-state-focus *ps*)) #t)
            ((dk-asm? (dk-goal)) (ass))
            ((null? ps) (error "sipq-cite-ass!: no ordering of the representatives gives the goal" lemma))
            (#t (apply dk-cite! lemma 'v (args (car ps) rs)) (loop (cdr ps)))))))

(sipq-law! 'sipq-assoc '(is-associative (VADD (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v))) 'is-associative
  (sipq-cite-close! (list (cons 'hbs-vadd-assoc-sip-as-module (lambda (as rs) as)))))
(sipq-law! 'sipq-comm '(is-commutative (VADD (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v))) 'is-commutative
  (sipq-cite-close! (list (cons 'hbs-vadd-comm-sip-as-module (lambda (as rs) as)))))
(sipq-law! 'sipq-identity '(is-identity (VADD (SIP-QUOTIENT v)) (VZERO (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v))) 'is-identity
  (sipq-cite-close! (list (cons 'hbs-vzero-l-sip-as-module (lambda (as rs) as))
                          (cons 'hbs-vzero-r-sip-as-module (lambda (as rs) as)))))
(sipq-law! 'sipq-inverses '(has-inverses (VADD (SIP-QUOTIENT v)) (VZERO (SIP-QUOTIENT v)) (VNEG (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v))) 'has-inverses
  (lambda (as rs)
    (let ((a (car as)))
      (sipa-vt (list '(VNEG v) a))
      (dk-cite! 'frm-v-right-inv-sip-as-module 'v a)
      (dk-cite! 'hbs-vadd-comm-sip-as-module 'v (list '(VNEG v) a) a)
      (sipq-close-class-eq!))))
(sipq-law! 'sipq-act-distrib-vec
  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL (SIP-QUOTIENT v))))
    (FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v))) (FORALL y_ (IMPLIES (IN y_ (VEC (SIP-QUOTIENT v)))
      (= ((ACT (SIP-QUOTIENT v)) r_ ((VADD (SIP-QUOTIENT v)) x_ y_))
         ((VADD (SIP-QUOTIENT v)) ((ACT (SIP-QUOTIENT v)) r_ x_) ((ACT (SIP-QUOTIENT v)) r_ y_)))))))))
  #f
  (sipq-cite-close! (list (cons 'module-act-distrib-vec-sip-as-module (lambda (as rs) (append rs as))))))
(sipq-law! 'sipq-act-distrib-scalar
  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL (SIP-QUOTIENT v))))
    (FORALL s_ (IMPLIES (IN s_ (CARR (SCAL (SIP-QUOTIENT v)))) (FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v)))
      (= ((ACT (SIP-QUOTIENT v)) ((ADD (SCAL (SIP-QUOTIENT v))) r_ s_) x_)
         ((VADD (SIP-QUOTIENT v)) ((ACT (SIP-QUOTIENT v)) r_ x_) ((ACT (SIP-QUOTIENT v)) s_ x_)))))))))
  #f
  (sipq-cite-close! (list (cons 'module-act-distrib-scalar-sip-as-module (lambda (as rs) (append rs as))))))
(sipq-law! 'sipq-act-mul-compat
  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL (SIP-QUOTIENT v))))
    (FORALL s_ (IMPLIES (IN s_ (CARR (SCAL (SIP-QUOTIENT v)))) (FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v)))
      (= ((ACT (SIP-QUOTIENT v)) ((MUL (SCAL (SIP-QUOTIENT v))) r_ s_) x_)
         ((ACT (SIP-QUOTIENT v)) r_ ((ACT (SIP-QUOTIENT v)) s_ x_)))))))))
  #f
  (sipq-cite-close! (list (cons 'module-act-mul-compat-sip-as-module (lambda (as rs) (append rs as))))))
(sipq-law! 'sipq-act-unital
  '(FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v)))
     (= ((ACT (SIP-QUOTIENT v)) (ONE (SCAL (SIP-QUOTIENT v))) x_) x_)))
  #f
  (sipq-cite-close! (list (cons 'module-act-unital-sip-as-module (lambda (as rs) as)))))
(sipq-law! 'sipq-rip-sym
  '(FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v))) (FORALL y_ (IMPLIES (IN y_ (VEC (SIP-QUOTIENT v)))
     (= ((RIP (SIP-QUOTIENT v)) x_ y_) ((RIP (SIP-QUOTIENT v)) y_ x_))))))
  #f (sipq-cite-ass! 'sip-rip-sym (lambda (as rs) as)))
(sipq-law! 'sipq-rip-add-left
  '(FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v))) (FORALL y_ (IMPLIES (IN y_ (VEC (SIP-QUOTIENT v)))
    (FORALL z_ (IMPLIES (IN z_ (VEC (SIP-QUOTIENT v)))
     (= ((RIP (SIP-QUOTIENT v)) ((VADD (SIP-QUOTIENT v)) x_ y_) z_)
        (+ ((RIP (SIP-QUOTIENT v)) x_ z_) ((RIP (SIP-QUOTIENT v)) y_ z_)))))))))
  #f (sipq-cite-ass! 'sip-rip-add-left (lambda (as rs) as)))
(sipq-law! 'sipq-rip-homog-left
  '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v)))
    (FORALL y_ (IMPLIES (IN y_ (VEC (SIP-QUOTIENT v)))
     (= ((RIP (SIP-QUOTIENT v)) ((ACT (SIP-QUOTIENT v)) a_ x_) y_)
        (* a_ ((RIP (SIP-QUOTIENT v)) x_ y_)))))))))
  #f
  (lambda (as rs)
    (let ((a (cadr (cadr (cadr (dk-goal))))))   ; (= ((RIP v) ((ACT v) a x) y) ...): the scalar
      ((sipq-cite-ass! 'sip-rip-homog-left (lambda (pa pr) (cons a pa))) as rs))))
(sipq-law! 'sipq-rip-self-nonneg
  '(FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v))) (<= 0 ((RIP (SIP-QUOTIENT v)) x_ x_))))
  #f (sipq-cite-ass! 'sip-rip-self-nonneg (lambda (as rs) as)))

;;; ---- definiteness on the quotient: <[a],[a]> = <a,a> = 0 => a ~ 0 => [a] = [0] ------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC (SIP-QUOTIENT v)))
    (IMPLIES (= ((RIP (SIP-QUOTIENT v)) x_ x_) 0) (= x_ (VZERO (SIP-QUOTIENT v))))))))))
(sipq-law-open!)
(let* ((lk (dk-peel!))
       (u  (cadr (or (any-pred (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC sipq-QS)))) lk)
                     (error "sipq-definite: no typing landed"))))
       (h  (or (any-pred (lambda (f) (dk-head-is? f '=)) lk) (error "sipq-definite: no hypothesis landed")))
       (a  (sipq-lift-var! u))
       (h1 (dk-rewrite-h! h u (sipq-cl a)))
       (e  (dk-cite! 'sipq-rip-computes 'v a a))
       (h2 (dk-rewrite-h! h1 (list (list 'RIP sipq-QS) (sipq-cl a) (sipq-cl a)) (list '(RIP v) a a))))
  (sipq-norm!)
  (sipa-vt (sipa-d a '(VZERO v)))
  (dk-cite! 'frm-v-sub-zero-sip-as-module 'v a)
  (dk-have! (sipa-nul (sipa-d a '(VZERO v)))
    (lambda () (subst (list '= (sipa-d a '(VZERO v)) a)) (ass)))
  (sipq-class-eq!))
(sipa-qed! 'sipq-definite)

;;; ==========================================================================================
;;; STOP POINT A: THE QUOTIENT OF A SEMI-INNER-PRODUCT SPACE BY ITS NULL VECTORS IS A
;;; (REAL) PRE-HILBERT SPACE.
;;; ==========================================================================================
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-PRE-HILBERT-SPACE (SIP-QUOTIENT v))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'v))
  '(sipq-length sipq-scal-ring sipq-vec-set sipq-vadd-fun sipq-vzero-in sipq-vneg-fun sipq-act-fun sipq-rip-fun
    sipq-assoc sipq-comm sipq-identity sipq-inverses sipq-scal-pin sipq-scal-carr
    sipq-act-distrib-vec sipq-act-distrib-scalar sipq-act-mul-compat sipq-act-unital
    sipq-rip-sym sipq-rip-add-left sipq-rip-homog-left sipq-rip-self-nonneg sipq-definite))
(mac 'is-pre-hilbert-space-def)
(mac 'IS-SEMI-INNER-PRODUCT-SPACE)
(dk-conj-close! (lambda () (ass)))
(sipa-qed! 'sip-quotient-is-pre-hilbert)
(alias! 'sip-quotient-is-pre-hilbert "the quotient by the null vectors is a pre-Hilbert space")

;;; ---- the two halves of a pre-Hilbert space -----------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v) (IS-SEMI-INNER-PRODUCT-SPACE v)))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-pre-hilbert-space-def '(IS-PRE-HILBERT-SPACE v))))))
(ass)
(sipa-qed! 'phs-is-sip)

(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IMPLIES (= ((RIP v) x_ x_) 0) (= x_ (VZERO v)))))))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-pre-hilbert-space-def '(IS-PRE-HILBERT-SPACE v))))))
(ass)
(sipa-qed! 'phs-definite)

;;; ---- (-q).x = -(q.x) for a real q (wanted by the complex structure, sip-b.scm) -----------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL q_ (IMPLIES (IN q_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((ACT v) (- q_) x_) ((VNEG v) ((ACT v) q_ x_)))))))))))
(dk-peel!)
(sipa-pin!)
(dk-real! '(- q_))
(define sipa-nqx '((ACT v) (- q_) x_))
(define sipa-qx '((ACT v) q_ x_))
(sipa-vt sipa-nqx) (sipa-vt sipa-qx) (sipa-vt (list '(VNEG v) sipa-qx))
(fact 'hbs-act-add-sip-as-module 'v '(- q_) 'q_ 'x_)
(dk-have! '(= (+ (- q_) q_) 0) (lambda () (crs)))
(fact 'hbs-act-zero-sip-as-module 'v 'x_)
(fact 'frm-v-neg-neg-sip-as-module 'v sipa-qx)
(dk-have! (list '= (list '(VADD v) sipa-nqx (list '(VNEG v) (list '(VNEG v) sipa-qx))) '(VZERO v))
  (lambda ()
    (subst (list '= (list '(VNEG v) (list '(VNEG v) sipa-qx)) sipa-qx))
    (subst (list '= (list '(VADD v) sipa-nqx sipa-qx) '((ACT v) (+ (- q_) q_) x_)))
    (subst '(= (+ (- q_) q_) 0))
    (ass)))
(fact 'frm-v-sub-zero-eq-sip-as-module 'v sipa-nqx (list '(VNEG v) sipa-qx))
(ass)
(sipa-qed! 'sip-act-neg-scalar)

;;; ---- the remaining projections (the typings and the group laws), cited by the bridges ------
(sipa-project! 'sip-vadd-fun '(IN (VADD v) (FUN (CARTESIAN (VEC v) (VEC v)) (VEC v))))
(sipa-project! 'sip-vzero-in '(IN (VZERO v) (VEC v)))
(sipa-project! 'sip-vneg-fun '(IN (VNEG v) (FUN (VEC v) (VEC v))))
(sipa-project! 'sip-act-fun '(IN (ACT v) (FUN (CARTESIAN (CARR (SCAL v)) (VEC v)) (VEC v))))
(sipa-project! 'sip-vadd-assoc-prop '(is-associative (VADD v) (VEC v)))
(sipa-project! 'sip-vadd-comm-prop '(is-commutative (VADD v) (VEC v)))
(sipa-project! 'sip-vadd-identity-prop '(is-identity (VADD v) (VZERO v) (VEC v)))
(sipa-project! 'sip-vadd-inverses-prop '(has-inverses (VADD v) (VZERO v) (VNEG v) (VEC v)))

;;; ---- the quotient tuple, unfolded (cited where the tuple must be compared literally) -------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (== (SIP-QUOTIENT v)
      (LIST (SCAL v) (QUOTIENT (SIP-SETOID v)) (SIP-QVADD v) (CLASS (SIP-SETOID v) (VZERO v))
            (SIP-QVNEG v) (SIP-QACT v) (SIP-QRIP v)))))))
(di) (di)
(mac 'SIP-QUOTIENT)
(qrfl)
(sipa-qed! 'sipq-unfold)
