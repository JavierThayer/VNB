(sipa-qed! 'sipq-rip-computes)

;;; ---- the scale map is a function on the quotient; the action computes ------------------
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v)
  (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'IN '(SIP-QSCALE v r_) (list 'FUN sipq-Q sipq-Q))))))))
