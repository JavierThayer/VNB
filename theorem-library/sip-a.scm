;;; sip-a.scm -- SEMI-INNER-PRODUCT SPACES: the laws, Cauchy-Schwarz for a semidefinite
;;; form, the null vectors, the setoid, and the quotient pre-Hilbert space.
;;; (SIP-1, 2026-10-18; STOP POINT A of scratchpad/triage/SIP-1.md.)  All PROVEN modulo 0.
;;;
;;; Source: the user's notes topological-vector-space.pdf, Ch. 1 s.3, Definition 1.17
;;; (a real pre-Hilbert space) and Proposition 1.18 (Cauchy-Schwarz), with the
;;; definiteness condition (3) dropped as the design decided (structure-library/sip-vocab.scm).
;;;
;;; THE PROOF OF CAUCHY-SCHWARZ FOR A SEMIDEFINITE FORM.  The notes' proof divides by
;;; <eta,eta>, which may now vanish for a nonzero eta.  The proof here divides by nothing.
;;; Write a = <x,x>, b = <x,y>, c = <y,y>, and expand
;;;     <al x + be y, al x + be y> = al^2 a + 2 al be b + be^2 c >= 0   (sip-expand-two).
;;; If c > 0, take (al, be) = (c, -b): the form is c (ac - b^2) >= 0, and c cancels.
;;; If c = 0, take (al, be) = (b, -(a + 1)): the form is -(a + 2) b^2 >= 0, so b^2 <= 0 = ac.
;;; The cancellation is rr-mul-le-cancel-pos in both cases.
;;;
;;; Helper prefix: sipa-.
;;;
;;; LOAD WINDOW [theorem-library/primitive-uniform-limit (rr-mul-le-cancel-pos), end): after
;;; structure-library/sip-vocab (whose view specializer must already have run after
;;; theorem-library/frechet-metric), before structure-library/sip-complex-vocab.  Nothing in the
;;; tree cites this file.  Library: analysis.

(define (sipa-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** sip-a: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "sip-a: unfinished" name))))

;;; A PROJECTION of IS-SEMI-INNER-PRODUCT-SPACE: the statement is
;;;   forall v. IS-SEMI-INNER-PRODUCT-SPACE(v) => <a conjunct of the definition at v>
;;; proved by unfolding the definition in the hypothesis and finding the conjunct.
(define (sipa-project! name conj)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) conj))))
  (di)
  (di)
  (let ((u (dk-landed-1 (lambda () (mac-h 'IS-SEMI-INNER-PRODUCT-SPACE '(IS-SEMI-INNER-PRODUCT-SPACE v))))))
    (dk-split-all! (list u)))
  (ass)
  (sipa-qed! name))

(sipa-project! 'sip-scal-pin '(= (SCAL v) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))
(sipa-project! 'sip-scal-carr '(= (CARR (SCAL v)) RR))
(sipa-project! 'sip-vec-set '(IN (VEC v) SET))
(sipa-project! 'sip-rip-fun '(IN (RIP v) (FUN (CARTESIAN (VEC v) (VEC v)) RR)))
(sipa-project! 'sip-rip-sym
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= ((RIP v) x_ y_) ((RIP v) y_ x_)))))))
(sipa-project! 'sip-rip-add-left
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (FORALL z_ (IMPLIES (IN z_ (VEC v))
     (= ((RIP v) ((VADD v) x_ y_) z_) (+ ((RIP v) x_ z_) ((RIP v) y_ z_))))))))))
(sipa-project! 'sip-rip-homog-left
  '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= ((RIP v) ((ACT v) a_ x_) y_) (* a_ ((RIP v) x_ y_))))))))))
(sipa-project! 'sip-rip-self-nonneg
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (<= 0 ((RIP v) x_ x_)))))

;;; ---- the form takes values in RR at two vectors ------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (IN ((RIP v) x_ y_) RR)))))))))
(dk-peel!)
(fact 'sip-rip-fun 'v)
(fact 'pair-in-cartesian '(VEC v) '(VEC v) 'x_ 'y_)
(fact 'fun-apply-type-c '(RIP v) '(CARTESIAN (VEC v) (VEC v)) 'RR '(LIST x_ y_))
(fact 'apply-tupling-2 '(RIP v) 'x_ 'y_)
(subst '(= ((RIP v) x_ y_) ((RIP v) (LIST x_ y_))))
(ass)
(sipa-qed! 'sip-rip-type)

;;; ---- the shared preamble of the algebraic laws: the scalar pin, so the hbs-*
;;; ---- companions (real scalars) detach.
(define (sipa-pin!)
  (fact 'sip-scal-pin 'v))

;;; (sipa-vt X) -- type the vector expression X (built from vector variables typed in
;;; context with VADD, VNEG, VZERO and ACT at a real scalar typed in context) by citation,
;;; bottom-up.  Returns X.
(define (sipa-vt x)
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module 'v) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (sipa-vt (cadr x)) (sipa-vt (caddr x))
           (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (sipa-vt (cadr x))
           (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT v)))
           (sipa-vt (caddr x))
           (dk-cite! 'hbs-act-in-sip-as-module 'v (cadr x) (caddr x)) x)
          (#t (error "sipa-vt: cannot type" (expression->string x))))))

;;; (sipa-ft X Y) -- type <X, Y> in RR.
(define (sipa-ft x y)
  (sipa-vt x) (sipa-vt y)
  (dk-cite! 'sip-rip-type 'v x y))

;;; ---- the form in the second argument --------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (FORALL z_ (IMPLIES (IN z_ (VEC v))
    (= ((RIP v) x_ ((VADD v) y_ z_)) (+ ((RIP v) x_ y_) ((RIP v) x_ z_)))))))))))))
(dk-peel!)
(sipa-pin!)
(sipa-vt '((VADD v) y_ z_))
(fact 'sip-rip-sym 'v 'x_ '((VADD v) y_ z_))
(fact 'sip-rip-add-left 'v 'y_ 'z_ 'x_)
(fact 'sip-rip-sym 'v 'x_ 'y_)
(fact 'sip-rip-sym 'v 'x_ 'z_)
(subst '(= ((RIP v) x_ ((VADD v) y_ z_)) ((RIP v) ((VADD v) y_ z_) x_)))
(subst '(= ((RIP v) ((VADD v) y_ z_) x_) (+ ((RIP v) y_ x_) ((RIP v) z_ x_))))
(subst '(= ((RIP v) x_ y_) ((RIP v) y_ x_)))
(subst '(= ((RIP v) x_ z_) ((RIP v) z_ x_)))
(sipa-ft 'y_ 'x_)
(sipa-ft 'z_ 'x_)
(crs)
(sipa-qed! 'sip-rip-add-right)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((RIP v) x_ ((ACT v) a_ y_)) (* a_ ((RIP v) x_ y_)))))))))))))
(dk-peel!)
(sipa-pin!)
(sipa-vt '((ACT v) a_ y_))
(fact 'sip-rip-sym 'v 'x_ '((ACT v) a_ y_))
(fact 'sip-rip-homog-left 'v 'a_ 'y_ 'x_)
(fact 'sip-rip-sym 'v 'x_ 'y_)
(subst '(= ((RIP v) x_ ((ACT v) a_ y_)) ((RIP v) ((ACT v) a_ y_) x_)))
(subst '(= ((RIP v) ((ACT v) a_ y_) x_) (* a_ ((RIP v) y_ x_))))
(subst '(= ((RIP v) x_ y_) ((RIP v) y_ x_)))
(sipa-ft 'y_ 'x_)
(crs)
(sipa-qed! 'sip-rip-homog-right)

;;; ---- <0, y> = 0 and <-x, y> = -<x, y> ----------------------------------------------
;;; <0,y> = <0+0,y> = <0,y> + <0,y>, a linear consequence.
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL y_ (IMPLIES (IN y_ (VEC v)) (= ((RIP v) (VZERO v) y_) 0)))))))
(dk-peel!)
(sipa-vt '(VZERO v))
(fact 'hbs-vzero-l-sip-as-module 'v '(VZERO v))
(fact 'sip-rip-add-left 'v '(VZERO v) '(VZERO v) 'y_)
(sipa-ft '(VZERO v) 'y_)
(let ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '((RIP v) ((VADD v) (VZERO v) (VZERO v)) y_))))
                  "the additivity instance")))
  (dk-rewrite-h! e '((VADD v) (VZERO v) (VZERO v)) '(VZERO v)))
(dk-ineq! '(IN ((RIP v) (VZERO v) y_) RR)
          '(= ((RIP v) (VZERO v) y_) (+ ((RIP v) (VZERO v) y_) ((RIP v) (VZERO v) y_))))
(sipa-qed! 'sip-rip-zero-left)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((RIP v) x_ (VZERO v)) 0)))))))
(dk-peel!)
(sipa-vt '(VZERO v))
(fact 'sip-rip-sym 'v 'x_ '(VZERO v))
(fact 'sip-rip-zero-left 'v 'x_)
(subst '(= ((RIP v) x_ (VZERO v)) ((RIP v) (VZERO v) x_)))
(ass)
(sipa-qed! 'sip-rip-zero-right)

;;; <-x,y> + <x,y> = <-x + x, y> = <0, y> = 0
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((RIP v) ((VNEG v) x_) y_) (- ((RIP v) x_ y_)))))))))))
(dk-peel!)
(sipa-vt '((VNEG v) x_))
(fact 'sip-rip-add-left 'v '((VNEG v) x_) 'x_ 'y_)
(fact 'frm-v-right-inv-sip-as-module 'v 'x_)
(fact 'hbs-vadd-comm-sip-as-module 'v '((VNEG v) x_) 'x_)
(fact 'sip-rip-zero-left 'v 'y_)
(sipa-ft '((VNEG v) x_) 'y_)
(sipa-ft 'x_ 'y_)
(let* ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '((RIP v) ((VADD v) ((VNEG v) x_) x_) y_))))
                   "the additivity instance"))
       (e2 (dk-rewrite-h! e '((VADD v) ((VNEG v) x_) x_) '((VADD v) x_ ((VNEG v) x_))))
       (e3 (dk-rewrite-h! e2 '((VADD v) x_ ((VNEG v) x_)) '(VZERO v)))
       (e4 (dk-rewrite-h! e3 '((RIP v) (VZERO v) y_) 0)))
  (dk-ineq! '(IN ((RIP v) ((VNEG v) x_) y_) RR) '(IN ((RIP v) x_ y_) RR) e4))
(sipa-qed! 'sip-rip-neg-left)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((RIP v) x_ ((VNEG v) y_)) (- ((RIP v) x_ y_)))))))))))
(dk-peel!)
(sipa-vt '((VNEG v) y_))
(fact 'sip-rip-sym 'v 'x_ '((VNEG v) y_))
(fact 'sip-rip-neg-left 'v 'y_ 'x_)
(fact 'sip-rip-sym 'v 'x_ 'y_)
(subst '(= ((RIP v) x_ ((VNEG v) y_)) ((RIP v) ((VNEG v) y_) x_)))
(subst '(= ((RIP v) ((VNEG v) y_) x_) (- ((RIP v) y_ x_))))
(subst '(= ((RIP v) x_ y_) ((RIP v) y_ x_)))
(sipa-ft 'y_ 'x_)
(crs)
(sipa-qed! 'sip-rip-neg-right)

;;; ---- THE EXPANSION ---------------------------------------------------------------------
;;;   <al x + be y, al x + be y> = al al <x,x> + 2 al be <x,y> + be be <y,y>
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
  (FORALL a_ (IMPLIES (IN a_ RR) (FORALL b_ (IMPLIES (IN b_ RR)
    (= ((RIP v) ((VADD v) ((ACT v) a_ x_) ((ACT v) b_ y_)) ((VADD v) ((ACT v) a_ x_) ((ACT v) b_ y_)))
       (+ (+ (* (* a_ a_) ((RIP v) x_ x_)) (* (* 2 (* a_ b_)) ((RIP v) x_ y_)))
          (* (* b_ b_) ((RIP v) y_ y_))))))))))))))))
(dk-peel!)
(sipa-pin!)
(define sipa-ax '((ACT v) a_ x_))
(define sipa-by '((ACT v) b_ y_))
(define sipa-w (list '(VADD v) sipa-ax sipa-by))
(sipa-vt sipa-w)
(fact 'sip-rip-add-left 'v sipa-ax sipa-by sipa-w)
(fact 'sip-rip-homog-left 'v 'a_ 'x_ sipa-w)
(fact 'sip-rip-homog-left 'v 'b_ 'y_ sipa-w)
(fact 'sip-rip-add-right 'v 'x_ sipa-ax sipa-by)
(fact 'sip-rip-add-right 'v 'y_ sipa-ax sipa-by)
(fact 'sip-rip-homog-right 'v 'a_ 'x_ 'x_)
(fact 'sip-rip-homog-right 'v 'b_ 'x_ 'y_)
(fact 'sip-rip-homog-right 'v 'a_ 'y_ 'x_)
(fact 'sip-rip-homog-right 'v 'b_ 'y_ 'y_)
(fact 'sip-rip-sym 'v 'y_ 'x_)
(subst (list '= (list '(RIP v) sipa-w sipa-w) (list '+ (list '(RIP v) sipa-ax sipa-w) (list '(RIP v) sipa-by sipa-w))))
(subst (list '= (list '(RIP v) sipa-ax sipa-w) (list '* 'a_ (list '(RIP v) 'x_ sipa-w))))
(subst (list '= (list '(RIP v) sipa-by sipa-w) (list '* 'b_ (list '(RIP v) 'y_ sipa-w))))
(subst (list '= (list '(RIP v) 'x_ sipa-w) (list '+ (list '(RIP v) 'x_ sipa-ax) (list '(RIP v) 'x_ sipa-by))))
(subst (list '= (list '(RIP v) 'y_ sipa-w) (list '+ (list '(RIP v) 'y_ sipa-ax) (list '(RIP v) 'y_ sipa-by))))
(subst (list '= (list '(RIP v) 'x_ sipa-ax) '(* a_ ((RIP v) x_ x_))))
(subst (list '= (list '(RIP v) 'x_ sipa-by) '(* b_ ((RIP v) x_ y_))))
(subst (list '= (list '(RIP v) 'y_ sipa-ax) '(* a_ ((RIP v) y_ x_))))
(subst (list '= (list '(RIP v) 'y_ sipa-by) '(* b_ ((RIP v) y_ y_))))
(subst '(= ((RIP v) y_ x_) ((RIP v) x_ y_)))
(sipa-ft 'x_ 'x_)
(sipa-ft 'x_ 'y_)
(sipa-ft 'y_ 'y_)
(crs)
(sipa-qed! 'sip-expand-two)

;;; ---- CAUCHY-SCHWARZ (Proposition 1.18) for a positive semidefinite form ---------------
;;;   <x,y> <x,y>  <=  <x,x> <y,y>
(define sipa-fa '((RIP v) x_ x_))
(define sipa-fb '((RIP v) x_ y_))
(define sipa-fc '((RIP v) y_ y_))
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (<= (* ((RIP v) x_ y_) ((RIP v) x_ y_)) (* ((RIP v) x_ x_) ((RIP v) y_ y_)))))))))))
(dk-peel!)
(sipa-pin!)
(sipa-ft 'x_ 'x_)
(sipa-ft 'x_ 'y_)
(sipa-ft 'y_ 'y_)
(fact 'sip-rip-self-nonneg 'v 'x_)
(fact 'sip-rip-self-nonneg 'v 'y_)
(dk-real! (list '* sipa-fb sipa-fb))
(dk-real! (list '* sipa-fa sipa-fc))
(define (sipa-cs-pos!)
    ;; c > 0: the form at c x - b y is c (ac - b^2)
    (let* ((mb (list '- sipa-fb))
           (ig (dk-real! mb))
           (w  (list '(VADD v) (list '(ACT v) sipa-fc 'x_) (list '(ACT v) mb 'y_)))
           (ex (dk-cite! 'sip-expand-two 'v 'x_ 'y_ sipa-fc mb))
           (ig2 (sipa-vt w))
           (nn (dk-cite! 'sip-rip-self-nonneg 'v w))
           (d  (list '- (list '* sipa-fa sipa-fc) (list '* sipa-fb sipa-fb)))
           (ig3 (dk-real! d))
           (val (caddr ex))
           (eq2 (have-f! (list '= val (list '* d sipa-fc)) (lambda () (crs))))
           (n1 (dk-rewrite-h! nn (list '(RIP v) w w) val))
           (n2 (dk-rewrite-h! n1 val (list '* d sipa-fc))))
      (dk-have! (list '<= (list '* 0 sipa-fc) (list '* d sipa-fc))
             (lambda ()
               (fact 'rr-zero-mul sipa-fc)
               (subst (list '= (list '* 0 sipa-fc) 0))
               (ass)))
      (dk-have! '(IN 0 RR) (lambda () (arith)))
      (dk-cite! 'rr-mul-le-cancel-pos 0 sipa-fc d)
      (dk-ineq! (list '<= 0 d) (list 'IN d 'RR)
                (list 'IN (list '* sipa-fb sipa-fb) 'RR) (list 'IN (list '* sipa-fa sipa-fc) 'RR))))
(define (sipa-cs-zero!)
    ;; c = 0: the form at b x - (a+1) y is -(a+2) b^2
    (let* ((c0 (have-f! (list '= sipa-fc 0)
                        (lambda () (dk-ineq! (list '<= sipa-fc 0) (list '<= 0 sipa-fc)
                                             (list 'IN sipa-fc 'RR)))))
           (ma (list '- (list '+ sipa-fa 1)))
           (ig (dk-real! ma))
           (w  (list '(VADD v) (list '(ACT v) sipa-fb 'x_) (list '(ACT v) ma 'y_)))
           (ex (dk-cite! 'sip-expand-two 'v 'x_ 'y_ sipa-fb ma))
           (ig2 (sipa-vt w))
           (nn (dk-cite! 'sip-rip-self-nonneg 'v w))
           (val (caddr ex))
           (n1 (dk-rewrite-h! nn (list '(RIP v) w w) val))
           (n2 (dk-rewrite-h! n1 sipa-fc 0))
           (val0 (caddr n2))
           (k  (list '+ sipa-fa 2))
           (ig3 (dk-real! k))
           (pp (list '* (list '* sipa-fb sipa-fb) k))
           (ig4 (dk-real! pp))
           (eq2 (have-f! (list '= val0 (list '- pp)) (lambda () (crs))))
           (n3 (dk-rewrite-h! n2 val0 (list '- pp)))
           (p  (dk-name! pp))
           (n4 (dk-rewrite-h! n3 pp p)))
      (dk-have! (list '<= pp (list '* 0 k))
             (lambda ()
               (fact 'rr-zero-mul k)
               (subst (list '= (list '* 0 k) 0))
               (subst (list '= pp p))
               (dk-ineq! n4 (list 'IN p 'RR))))
      (dk-have! '(IN 0 RR) (lambda () (arith)))
      (dk-have! (list '< 0 k) (lambda () (dk-ineq! (list '<= 0 sipa-fa) (list 'IN sipa-fa 'RR))))
      (dk-cite! 'rr-mul-le-cancel-pos (list '* sipa-fb sipa-fb) k 0)
      (subst (list '= sipa-fc 0))
      (fact 'rr-mul-zero sipa-fa)
      (subst (list '= (list '* sipa-fa 0) 0))
      (ass)))
(use-em (list '<= sipa-fc 0)
  (lambda () (sipa-cs-zero!))
  (lambda () (dk-cite! 'rr-not-le-lt sipa-fc 0) (sipa-cs-pos!)))
(sipa-qed! 'sip-schwarz)
(alias! 'sip-schwarz "the Cauchy-Schwarz inequality for a semidefinite form")

;;; ---- a null vector is orthogonal to everything ------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IMPLIES (= ((RIP v) x_ x_) 0)
    (FORALL y_ (IMPLIES (IN y_ (VEC v)) (= ((RIP v) x_ y_) 0))))))))))
(dk-peel!)
(sipa-ft 'x_ 'y_)
(sipa-ft 'y_ 'y_)
(let* ((s0 (dk-cite! 'sip-schwarz 'v 'x_ 'y_))
       (s1 (dk-rewrite-h! s0 sipa-fa 0))
       (z1 (dk-cite! 'rr-zero-mul sipa-fc))
       (s2 (dk-rewrite-h! s1 (list '* 0 sipa-fc) 0))
       (ig (dk-have! '(IN 0 RR) (lambda () (arith))))
       (z2 (dk-cite! 'rr-mul-zero 0))
       (mb (list '- sipa-fb))
       (ig2 (dk-real! mb)))
  (dk-have! (list '<= (list '* sipa-fb sipa-fb) (list '* 0 0))
         (lambda () (subst (list '= (list '* 0 0) 0)) (ass)))
  (dk-have! (list '<= (list '* mb mb) (list '* 0 0))
         (lambda ()
           (subst (list '= (list '* 0 0) 0))
           (dk-have! (list '= (list '* mb mb) (list '* sipa-fb sipa-fb)) (lambda () (crs)))
           (subst (list '= (list '* mb mb) (list '* sipa-fb sipa-fb)))
           (ass)))
  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-le-of-sq-le sipa-fb 0)
  (dk-cite! 'rr-le-of-sq-le mb 0)
  (dk-ineq! (list '<= sipa-fb 0) (list '<= mb 0) (list 'IN sipa-fb 'RR)))
(sipa-qed! 'sip-null-orth)

;;; ---- the null vectors are closed under the operations ------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (IMPLIES (= ((RIP v) x_ x_) 0) (IMPLIES (= ((RIP v) y_ y_) 0)
      (= ((RIP v) ((VADD v) x_ y_) ((VADD v) x_ y_)) 0)))))))))))
(dk-peel!)
(define sipa-xy '((VADD v) x_ y_))
(sipa-vt sipa-xy)
(fact 'sip-rip-add-left 'v 'x_ 'y_ sipa-xy)
(fact 'sip-null-orth 'v 'x_ sipa-xy)
(fact 'sip-null-orth 'v 'y_ sipa-xy)
(subst (list '= (list '(RIP v) sipa-xy sipa-xy) (list '+ (list '(RIP v) 'x_ sipa-xy) (list '(RIP v) 'y_ sipa-xy))))
(subst (list '= (list '(RIP v) 'x_ sipa-xy) 0))
(subst (list '= (list '(RIP v) 'y_ sipa-xy) 0))
(arith)
(sipa-qed! 'sip-null-vadd)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (IMPLIES (= ((RIP v) x_ x_) 0)
      (= ((RIP v) ((VNEG v) x_) ((VNEG v) x_)) 0))))))))
(dk-peel!)
(sipa-vt '((VNEG v) x_))
(fact 'sip-rip-neg-left 'v 'x_ '((VNEG v) x_))
(fact 'sip-null-orth 'v 'x_ '((VNEG v) x_))
(subst '(= ((RIP v) ((VNEG v) x_) ((VNEG v) x_)) (- ((RIP v) x_ ((VNEG v) x_)))))
(subst '(= ((RIP v) x_ ((VNEG v) x_)) 0))
(arith)
(sipa-qed! 'sip-null-vneg)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (IMPLIES (= ((RIP v) x_ x_) 0)
      (= ((RIP v) ((ACT v) a_ x_) ((ACT v) a_ x_)) 0))))))))))
(dk-peel!)
(sipa-pin!)
(sipa-vt '((ACT v) a_ x_))
(fact 'sip-rip-homog-left 'v 'a_ 'x_ '((ACT v) a_ x_))
(fact 'sip-null-orth 'v 'x_ '((ACT v) a_ x_))
(subst '(= ((RIP v) ((ACT v) a_ x_) ((ACT v) a_ x_)) (* a_ ((RIP v) x_ ((ACT v) a_ x_)))))
(subst '(= ((RIP v) x_ ((ACT v) a_ x_)) 0))
(fact 'rr-mul-zero 'a_)
(ass)
(sipa-qed! 'sip-null-act)

;;; ---- the null vectors: membership, and the subspace -------------------------------------
(sp (make-wff '(FORALL v (== (SIP-NULL v) (SEP sqn_ (VEC v) (= ((RIP v) sqn_ sqn_) 0))))))
(di)
(mac 'SIP-NULL)
(qrfl)
(sipa-qed! 'sip-null-unfold)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IMPLIES (= ((RIP v) x_ x_) 0) (IN x_ (SIP-NULL v)))))))))
(dk-peel!)
(mac 'SIP-NULL)
(in-sep! (lambda () (ass)) (lambda () (ass)))
(sipa-qed! 'sip-null-in)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (SIP-NULL v)) (AND (IN x_ (VEC v)) (= ((RIP v) x_ x_) 0))))))))
(dk-peel!)
(let ((h (dk-landed-1 (lambda () (mac-h 'sip-null-unfold '(IN x_ (SIP-NULL v)))))))
  (sep-me h))
(dk-conj-close! (lambda () (ass)))
(sipa-qed! 'sip-null-out)

;;; THE NULL VECTORS FORM A SUBSPACE.
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-SUBSPACE v (SIP-NULL v))))))
(dk-peel!)
(sipa-pin!)
(fact 'sip-scal-carr 'v)
(mac 'IS-SUBSPACE)
(mac 'IS-SUBMODULE)
(define (sipa-null-open! x)        ; x in SIP-NULL(v) in context: land its two projections
  (dk-split-all! (list (dk-cite! 'sip-null-out 'v x))))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'SUBSET)
         (let ((x (subset-by-element!)))
           (sipa-null-open! x)
           (ass)))
        ((equal? g '(IN (VZERO v) (SIP-NULL v)))
         (sipa-vt '(VZERO v))
         (fact 'sip-rip-zero-left 'v '(VZERO v))
         (fact 'sip-null-in 'v '(VZERO v))
         (ass))
        (#t
         (let* ((lk (dk-peel!))
                (ns (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(SIP-NULL v)))) lk)))
                (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL v))))) lk))))
           (for-each sipa-null-open! ns)
           (for-each (lambda (r) (dk-have! (list 'IN r 'RR) (lambda () (subst '(= RR (CARR (SCAL v)))) (ass)))) rs)
           (let ((t (cadr (dk-goal))))
             (sipa-vt t)
             (cond ((= (length ns) 2) (dk-cite! 'sip-null-vadd 'v (car ns) (cadr ns)))
                   ((pair? rs)        (dk-cite! 'sip-null-act 'v (car rs) (car ns)))
                   (#t                (dk-cite! 'sip-null-vneg 'v (car ns))))
             (fact 'sip-null-in 'v t)
             (ass))))))))
(sipa-qed! 'sip-null-subspace)
(alias! 'sip-null-subspace "the null vectors of a semi-inner-product space form a subspace")

;;; ==========================================================================================
;;; THE SETOID: x ~ y iff <x - y, x - y> = 0.
;;; ==========================================================================================
(define (sipa-d a b) (list '(VADD v) a (list '(VNEG v) b)))         ; a - b
(define (sipa-nul t) (list '= (list '(RIP v) t t) 0))                ; <t,t> = 0

(sp (make-wff '(FORALL v (== (SIP-REL v)
  (SEP sqp_ (CARTESIAN (VEC v) (VEC v))
     (= ((RIP v) ((VADD v) (NTH 1 sqp_) ((VNEG v) (NTH 2 sqp_)))
                 ((VADD v) (NTH 1 sqp_) ((VNEG v) (NTH 2 sqp_))))
        0))))))
(di)
(mac 'SIP-REL)
(qrfl)
(sipa-qed! 'sip-rel-unfold)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (IMPLIES (IN a_ (VEC v)) (FORALL b_ (IMPLIES (IN b_ (VEC v))
    (IMPLIES (= ((RIP v) ((VADD v) a_ ((VNEG v) b_)) ((VADD v) a_ ((VNEG v) b_))) 0)
      (IN (LIST a_ b_) (SIP-REL v)))))))))))
(dk-peel!)
(mac 'SIP-REL)
(in-sep! (lambda () (fact 'pair-in-cartesian '(VEC v) '(VEC v) 'a_ 'b_) (ass))
         (lambda () (nth-r) (ass)))
(sipa-qed! 'sip-rel-in)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (FORALL b_
    (IMPLIES (IN (LIST a_ b_) (SIP-REL v))
      (= ((RIP v) ((VADD v) a_ ((VNEG v) b_)) ((VADD v) a_ ((VNEG v) b_))) 0))))))))
(dk-peel!)
(let* ((h  (dk-landed-1 (lambda () (mac-h 'sip-rel-unfold '(IN (LIST a_ b_) (SIP-REL v))))))
       (ls (dk-landed (lambda () (sep-me h))))
       (c  (or (any-pred (lambda (f) (dk-head-is? f '=)) ls) (error "sip-rel-out: no condition landed"))))
  (dk-nth-h! c))
(ass)
(sipa-qed! 'sip-rel-out)

;;; REL is an equivalence relation on the vectors.
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (is-equivalence (SIP-REL v) (VEC v))))))
(dk-peel!)
(fact 'sip-vec-set 'v)
(mac 'is-equivalence)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
          ;; the typing: a separation of VEC x VEC lies in its power set
          (begin
            (mac 'SIP-REL)
            (mac 'power-set-membership)
            (dk-conj-close!
              (lambda ()
                (let ((g2 (dk-goal)))
                  (if (and (dk-head-is? g2 'IN) (eq? (caddr g2) 'SET))
                      (begin (sep-set)
                             (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                 (begin (mac 'cartesian-set-iff)
                                        (dk-conj-close! (lambda () (ass))))))
                      (let* ((lk (dk-peel!))
                             (h (or (any-pred (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f))
                                                               (eq? (car (caddr f)) 'SEP))) lk)
                                    (error "sip-rel-is-equivalence: no SEP membership"))))
                        (sep-me h)
                        (ass)))))))
          (let* ((lk (dk-peel!))
                 (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC v)))) lk))))
            (cond
              ((= (length vs) 1)                    ; reflexivity: u - u = 0
               (let ((u (car vs)))
                 (sipa-vt (sipa-d u u))
                 (fact 'frm-v-right-inv-sip-as-module 'v u)
                 (sipa-vt '(VZERO v))
                 (fact 'sip-rip-zero-left 'v '(VZERO v))
                 (dk-have! (sipa-nul (sipa-d u u))
                   (lambda () (subst (list '= (sipa-d u u) '(VZERO v))) (ass)))
                 (fact 'sip-rel-in 'v u u)
                 (ass)))
              ((= (length vs) 2)                    ; symmetry: v - u = -(u - v)
               (let ((u (car vs)) (w (cadr vs)))
                 (fact 'sip-rel-out 'v u w)
                 (sipa-vt (sipa-d u w))
                 (fact 'sip-null-vneg 'v (sipa-d u w))
                 (fact 'frm-v-sub-anti-sip-as-module 'v u w)
                 (dk-have! (sipa-nul (sipa-d w u))
                   (lambda () (subst (list '= (sipa-d w u) (list '(VNEG v) (sipa-d u w)))) (ass)))
                 (fact 'sip-rel-in 'v w u)
                 (ass)))
              (#t                                   ; transitivity: (u - v) + (v - w) = u - w
               (let ((u (car vs)) (m (cadr vs)) (w (caddr vs)))
                 (dk-split-all!)
                 (fact 'sip-rel-out 'v u m)
                 (fact 'sip-rel-out 'v m w)
                 (sipa-vt (sipa-d u m))
                 (sipa-vt (sipa-d m w))
                 (fact 'sip-null-vadd 'v (sipa-d u m) (sipa-d m w))
                 (fact 'frm-v-sub-chain-sip-as-module 'v u m w)
                 (dk-have! (sipa-nul (sipa-d u w))
                   (lambda () (subst (list '= (sipa-d u w) (list '(VADD v) (sipa-d u m) (sipa-d m w)))) (ass)))
                 (fact 'sip-rel-in 'v u w)
                 (ass)))))))))
(sipa-qed! 'sip-rel-is-equivalence)

;;; SIP-SETOID(v) = [VEC(v), SIP-REL(v)] is a setoid.
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-SETOID (SIP-SETOID v))))))
(dk-peel!)
(fact 'sip-vec-set 'v)
(fact 'sip-rel-is-equivalence 'v)
(mac 'IS-SETOID)
(slot 'pts)
(slot 'rel)
(mac 'SIP-SETOID)
(nth-r)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
             (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
            ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
             (let ((h (dk-pick (lambda (f) (dk-head-is? f 'is-equivalence)) "the equivalence")))
               (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-EQUIVALENCE h)))))
               (ass)))
            (#t (error "sip-setoid-is-setoid: unexpected conjunct" (expression->string g)))))))
(sipa-qed! 'sip-setoid-is-setoid)

;;; the read-offs of the setoid pair, guarded (list doctrine: the pair denotes only when
;;; its components are sets, which IS-SEMI-INNER-PRODUCT-SPACE certifies)
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (== (PTS (SIP-SETOID v)) (VEC v))))))
(di) (di)
(slot 'PTS)
(mac 'SIP-SETOID)
(nth-r)
(qrfl)
(sipa-qed! 'sip-setoid-pts)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (== (REL (SIP-SETOID v)) (SIP-REL v))))))
(di) (di)
(slot 'REL)
(mac 'SIP-SETOID)
(nth-r)
(qrfl)
(sipa-qed! 'sip-setoid-rel)

;;; the congruence, out of and into RELATED
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (FORALL b_ (IMPLIES (RELATED (SIP-SETOID v) a_ b_)
    (= ((RIP v) ((VADD v) a_ ((VNEG v) b_)) ((VADD v) a_ ((VNEG v) b_))) 0))))))))
(dk-peel!)
(mac-h 'rko2-related-unfold '(RELATED (SIP-SETOID v) a_ b_))
(mac-h 'sip-setoid-rel '(IN (LIST a_ b_) (REL (SIP-SETOID v))))
(fact 'sip-rel-out 'v 'a_ 'b_)
(ass)
(sipa-qed! 'sip-related-out)

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (IMPLIES (IN a_ (VEC v)) (FORALL b_ (IMPLIES (IN b_ (VEC v))
    (IMPLIES (= ((RIP v) ((VADD v) a_ ((VNEG v) b_)) ((VADD v) a_ ((VNEG v) b_))) 0)
      (RELATED (SIP-SETOID v) a_ b_))))))))))
(dk-peel!)
(mac 'RELATED)
(mac 'sip-setoid-rel)
(fact 'sip-rel-in 'v 'a_ 'b_)
(ass)
(sipa-qed! 'sip-related-in)

;;; equal classes exactly when the difference is null
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL a_ (IMPLIES (IN a_ (VEC v)) (FORALL b_ (IMPLIES (IN b_ (VEC v))
    (IFF (= (CLASS (SIP-SETOID v) a_) (CLASS (SIP-SETOID v) b_))
         (= ((RIP v) ((VADD v) a_ ((VNEG v) b_)) ((VADD v) a_ ((VNEG v) b_))) 0))))))))))
(dk-peel!)
(fact 'sip-setoid-is-setoid 'v)
(dk-have! '(IN a_ (PTS (SIP-SETOID v))) (lambda () (mac 'sip-setoid-pts) (ass)))
(dk-have! '(IN b_ (PTS (SIP-SETOID v))) (lambda () (mac 'sip-setoid-pts) (ass)))
(fact 'class-eq-iff '(SIP-SETOID v) 'a_ 'b_)
(fact 'sip-related-out 'v 'a_ 'b_)
(fact 'sip-related-in 'v 'a_ 'b_)
(let ((iff (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (dk-head-is? (caddr f) 'RELATED))) "the class-eq iff"))
      (o (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (cadr f) 'RELATED))) "related-out"))
      (i (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'RELATED))) "related-in")))
  (dk-only! iff o i)
  (prop))
(sipa-qed! 'sip-class-eq-iff)

;;; ==========================================================================================
;;; THE QUOTIENT.  S = SIP-SETOID(v), Q = QUOTIENT(S), QS = SIP-QUOTIENT(v).
;;; ==========================================================================================
(define sipq-S '(SIP-SETOID v))
(define sipq-Q '(QUOTIENT (SIP-SETOID v)))
(define sipq-QS '(SIP-QUOTIENT v))
(define (sipq-cl t) (list 'CLASS sipq-S t))
(define sipq-lva '(VNB-LAMBDA (LIST sqa_ sqb_) (CARTESIAN (VEC v) (VEC v))
                    (CLASS (SIP-SETOID v) ((VADD v) sqa_ sqb_))))
(define sipq-lvn '(VNB-LAMBDA sqa_ (VEC v) (CLASS (SIP-SETOID v) ((VNEG v) sqa_))))
(define (sipq-lsc r) (list 'VNB-LAMBDA 'sqa_ '(VEC v) (list 'CLASS sipq-S (list '(ACT v) r 'sqa_))))
(define sipq-lrp '(VNB-LAMBDA (LIST sqa_ sqb_) (CARTESIAN (VEC v) (VEC v)) ((RIP v) sqa_ sqb_)))

;;; ---- the read-offs of the quotient tuple ----------------------------------------------
(define (sipq-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (sipq-has-head? h (car e)) (sipq-has-head? h (cdr e)))))
(define (sipq-read-off! name acc val)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v)
                  (list '== (list acc sipq-QS) val)))))
  (di) (di)
  (slot acc)
  (mac 'SIP-QUOTIENT)
  (nth-r)
  ;; the same accessor may occur in VAL: `slot' rewrote it too, so rewrite the
  ;; recovered left side the same way (CLAUDE.md, "Structures and views")
  (if (and (not (proof-done? *ps*)) (sipq-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (sipa-qed! name))
(sipq-read-off! 'sipq-scal 'SCAL '(SCAL v))
(sipq-read-off! 'sipq-vec 'VEC sipq-Q)
(sipq-read-off! 'sipq-vadd 'VADD '(SIP-QVADD v))
(sipq-read-off! 'sipq-vzero 'VZERO (sipq-cl '(VZERO v)))
(sipq-read-off! 'sipq-vneg 'VNEG '(SIP-QVNEG v))
(sipq-read-off! 'sipq-act 'ACT '(SIP-QACT v))
(sipq-read-off! 'sipq-rip 'RIP '(SIP-QRIP v))

;;; ---- common preamble: the setoid, its carrier in VEC form --------------------------------
(define (sipq-setup!)
  (fact 'sip-setoid-is-setoid 'v)
  (fact 'sip-setoid-pts 'v)
  (fact 'sip-vec-set 'v))
;;; land (IN T (PTS S)) from (IN T (VEC v))
(define (sipq-pts! t)
  (sipa-vt t)
  (dk-have! (list 'IN t '(PTS (SIP-SETOID v))) (lambda () (subst '(= (PTS (SIP-SETOID v)) (VEC v))) (ass))))
;;; land (IN [T] Q)
(define (sipq-clq! t)
  (sipq-pts! t)
  (dk-cite! 'class-in-quotient sipq-S t))

;;; ---- each map is a function into the quotient (or RR) ---------------------------------
(define (sipq-lam-typer!)
  (let* ((lk (dk-peel!))
         (g (dk-goal))
         (body (cadr g)))
    (if (dk-head-is? body 'CLASS)
        (sipq-clq! (caddr body))
        (sipa-ft (cadr body) (caddr body)))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
(define (sipq-lam-fun! name lam dom rng)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v)
                  (list 'IN lam (list 'FUN dom rng))))))
  (dk-peel!)
  (sipq-setup!)
  (subst '(= (PTS (SIP-SETOID v)) (VEC v)))
  (dk-lam-type! sipq-lam-typer!)
  (sipa-qed! name))
(sipq-lam-fun! 'sipq-lva-fun sipq-lva '(CARTESIAN (PTS (SIP-SETOID v)) (PTS (SIP-SETOID v))) sipq-Q)
(sipq-lam-fun! 'sipq-lvn-fun sipq-lvn '(PTS (SIP-SETOID v)) sipq-Q)
(sipq-lam-fun! 'sipq-lrp-fun sipq-lrp '(CARTESIAN (PTS (SIP-SETOID v)) (PTS (SIP-SETOID v))) 'RR)
;;; the scale map, for each real r
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v)
  (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR)
    (list 'IN (sipq-lsc 'r_) (list 'FUN '(PTS (SIP-SETOID v)) sipq-Q))))))))
(dk-peel!)
(sipa-pin!)
(sipq-setup!)
(subst '(= (PTS (SIP-SETOID v)) (VEC v)))
(dk-lam-type! sipq-lam-typer!)
(sipa-qed! 'sipq-lsc-fun)

;;; ---- the form respects the congruence in its first argument ---------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL u_ (IMPLIES (IN u_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (IMPLIES (= ((RIP v) ((VADD v) x_ ((VNEG v) u_)) ((VADD v) x_ ((VNEG v) u_))) 0)
      (= ((RIP v) x_ y_) ((RIP v) u_ y_)))))))))))))
(dk-peel!)
(sipa-vt (sipa-d 'x_ 'u_))
(fact 'sip-null-orth 'v (sipa-d 'x_ 'u_) 'y_)
(fact 'sip-rip-add-left 'v 'x_ '((VNEG v) u_) 'y_)
(fact 'sip-rip-neg-left 'v 'u_ 'y_)
(sipa-ft 'x_ 'y_)
(sipa-ft 'u_ 'y_)
(sipa-ft '((VNEG v) u_) 'y_)
(sipa-ft (sipa-d 'x_ 'u_) 'y_)
(dk-ineq! (list '= (list '(RIP v) (sipa-d 'x_ 'u_) 'y_) 0)
          (list 'IN (list '(RIP v) (sipa-d 'x_ 'u_) 'y_) 'RR)
          (list '= (list '(RIP v) (sipa-d 'x_ 'u_) 'y_) '(+ ((RIP v) x_ y_) ((RIP v) ((VNEG v) u_) y_)))
          '(= ((RIP v) ((VNEG v) u_) y_) (- ((RIP v) u_ y_)))
          '(IN ((RIP v) x_ y_) RR) '(IN ((RIP v) u_ y_) RR) '(IN ((RIP v) ((VNEG v) u_) y_) RR))
(sipa-qed! 'sip-rip-respects-left)

;;; ---- the four maps respect the congruence -------------------------------------------------
;;; goal (= [T1] [T2]) with <T1 - T2, T1 - T2> = 0 in context
(define (sipq-class-eq!)
  (let* ((g (dk-goal)) (t1 (caddr (cadr g))) (t2 (caddr (caddr g))))
    (sipa-vt t1) (sipa-vt t2)
    (let ((iff (dk-cite! 'sip-class-eq-iff 'v t1 t2))
          (nul (sipa-nul (sipa-d t1 t2))))
      (dk-only! iff nul)
      (prop))))
;;; peel a RESPECTS / RESPECTS2 goal (unfolded), open the RELATED hypotheses into null
;;; differences, and return the eigenvariables READ OFF THE GOAL (= (f x y) (f u w)) as
;;; (x y u w), or (= (f x) (f u)) as (x u): x ~ u and y ~ w.
(define (sipq-respects-open! unfold)
  (mac unfold)
  (subst '(= (PTS (SIP-SETOID v)) (VEC v)))
  (let ((lk (dk-peel!)))
    (dk-split-all! lk)
    (for-each (lambda (f) (if (and (dk-head-is? f 'RELATED))
                              (fact 'sip-related-out 'v (caddr f) (cadddr f))))
              (dk-asms))
    (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
      (if (= (length l) 3)
          (list (cadr l) (caddr l) (cadr r) (caddr r))
          (list (cadr l) (cadr r))))))

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list 'RESPECTS2 sipq-S sipq-lva)))))
(dk-peel!)
(sipq-setup!)
(let* ((vs (sipq-respects-open! 'respects2-unfold))
       (x (car vs)) (y (cadr vs)) (u (caddr vs)) (w (cadddr vs)))
  (dk-lam-b!)
  (sipa-vt (sipa-d x u)) (sipa-vt (sipa-d y w))
  (fact 'sip-null-vadd 'v (sipa-d x u) (sipa-d y w))
  (fact 'frm-v-sub-add-sip-as-module 'v x y u w)
  (sipa-vt (list '(VADD v) x y)) (sipa-vt (list '(VADD v) u w))
  (dk-have! (sipa-nul (sipa-d (list '(VADD v) x y) (list '(VADD v) u w)))
    (lambda () (subst (list '= (sipa-d (list '(VADD v) x y) (list '(VADD v) u w))
                            (list '(VADD v) (sipa-d x u) (sipa-d y w))))
               (ass)))
  (sipq-class-eq!))
(sipa-qed! 'sipq-lva-respects)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list 'RESPECTS sipq-S sipq-lvn)))))
(dk-peel!)
(sipq-setup!)
(let* ((vs (sipq-respects-open! 'respects-unfold))
       (x (car vs)) (u (cadr vs))
       (nx (list '(VNEG v) x)) (nu (list '(VNEG v) u)))
  (dk-lam-b!)
  (sipa-vt (sipa-d x u))
  (sipa-vt nu)
  (fact 'sip-null-vneg 'v (sipa-d x u))
  (fact 'frm-v-neg-add-sip-as-module 'v x nu)
  (sipa-vt nx)
  (dk-have! (sipa-nul (sipa-d nx nu))
    (lambda () (subst (list '= (sipa-d nx nu) (list '(VNEG v) (sipa-d x u)))) (ass)))
  (sipq-class-eq!))
(sipa-qed! 'sipq-lvn-respects)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v)
  (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'RESPECTS sipq-S (sipq-lsc 'r_))))))))
(dk-peel!)
(sipa-pin!)
(sipq-setup!)
(fact 'sip-scal-carr 'v)
(dk-have! '(IN r_ (CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) RR)) (ass)))
(let* ((vs (sipq-respects-open! 'respects-unfold))
       (x (car vs)) (u (cadr vs))
       (rx (list '(ACT v) 'r_ x)) (ru (list '(ACT v) 'r_ u)))
  (dk-lam-b!)
  (sipa-vt (sipa-d x u))
  (fact 'sip-null-act 'v 'r_ (sipa-d x u))
  (fact 'frm-act-sub-vec-sip-as-module 'v 'r_ x u)
