(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (IN (ACT (SIP-QUOTIENT v)) (FUN (CARTESIAN (CARR (SCAL (SIP-QUOTIENT v))) (VEC (SIP-QUOTIENT v))) (VEC (SIP-QUOTIENT v))))))))
(dk-peel!)
