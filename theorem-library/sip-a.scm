  (for-each (lambda (acc val) (if (sipq-has-head? acc (dk-goal)) (subst (list '= (list acc sipq-QS) val))))
            '(SCAL VEC VADD VZERO VNEG ACT RIP)
            (list '(SCAL v) sipq-Q '(SIP-QVADD v) (sipq-cl '(VZERO v)) '(SIP-QVNEG v) '(SIP-QACT v) '(SIP-QRIP v))))

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (IN (VADD (SIP-QUOTIENT v)) (FUN (CARTESIAN (VEC (SIP-QUOTIENT v)) (VEC (SIP-QUOTIENT v))) (VEC (SIP-QUOTIENT v))))))))
