(fact 'sipq-lsc-respects 'v 'r_)
(dk-have! (list 'AND (list 'IN (sipq-lsc 'r_) (list 'FUN '(PTS (SIP-SETOID v)) sipq-Q)) (list 'RESPECTS sipq-S (sipq-lsc 'r_))))
