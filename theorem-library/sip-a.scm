  (dk-have! (sipa-nul (sipa-d rx ru))
    (lambda () (subst (list '= (sipa-d rx ru) (list '(ACT v) 'r_ (sipa-d x u)))) (ass)))
  (sipq-class-eq!))
(sipa-qed! 'sipq-lsc-respects)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list 'RESPECTS2 sipq-S sipq-lrp)))))
(dk-peel!)
(sipq-setup!)
(let* ((vs (sipq-respects-open! 'respects2-unfold))
       (x (car vs)) (y (cadr vs)) (u (caddr vs)) (w (cadddr vs)))
  (dk-lam-b!)
  (fact 'sip-rip-respects-left 'v x u y)
  (fact 'sip-rip-respects-left 'v y w u)
  (fact 'sip-rip-sym 'v u y)
  (fact 'sip-rip-sym 'v u w)
  (for-each (lambda (p) (sipa-ft (car p) (cdr p)))
            (list (cons x y) (cons u y) (cons y u) (cons w u) (cons u w)))
  (dk-ineq! (list '= (list '(RIP v) x y) (list '(RIP v) u y))
            (list '= (list '(RIP v) y u) (list '(RIP v) w u))
            (list '= (list '(RIP v) u y) (list '(RIP v) y u))
            (list '= (list '(RIP v) u w) (list '(RIP v) w u))
            (list 'IN (list '(RIP v) x y) 'RR) (list 'IN (list '(RIP v) u y) 'RR)
            (list 'IN (list '(RIP v) y u) 'RR) (list 'IN (list '(RIP v) w u) 'RR)
            (list 'IN (list '(RIP v) u w) 'RR)))
(sipa-qed! 'sipq-lrp-respects)

;;; ---- the operations COMPUTE on classes ---------------------------------------------------
