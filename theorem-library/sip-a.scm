(fact 'sip-scal-carr 'v)
(subst '(= (CARR (SCAL v)) RR))
(mac 'SIP-QACT)
(fact 'quotient-is-set sipq-S)
(fact 'rr-is-set)
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (app (cadr g)) (r (caddr (car app))) (c (cadr app)))
      (fact 'sipq-scale-fun 'v r)
      (fact 'fun-apply-type-c (car app) sipq-Q sipq-Q c)
