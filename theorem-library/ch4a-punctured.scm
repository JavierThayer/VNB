;;; Library: complex-analysis.

;;; ch4a-punctured.scm -- Corollary 4.6 (CH4-A, 2026-10-29): f holomorphic on the punctured disc A(a, 0, R)
;;; and Laurent series.
;;;   laurent-punctured-expansion (only if): f holomorphic on A(a, 0, R), 0 < rho < R: for 0 < |z - a| < R,
;;;       f(z) = LAURENT-SUM(LAURENT-COEFS(f, a, rho), a, z)   (one series, read on any circle in the disc).
;;;   laurent-punctured-holomorphic (if): f(z) = LAURENT-SUM(c, a, z) on A(a, 0, R), the two radius
;;;       conditions of 4.1 holding for every 0 < rm < rp < R: f is holomorphic on A(a, 0, R).
;;; Library: complex-analysis.  Load window: after ch4a-laurent (annulus-unfold, laurent-holomorphic) and
;;; ch4a-expansion (laurent-expansion).  Prefix lp-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define lp-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define lp-A '(ANNULUS a 0 R))
(define (lp-in-A! x)                 ; x in CC, 0 < |x - a| < R in context: x in A(a, 0, R)
  (let ((m (list 'magnitude (list '- x 'a))))
    (dk-cite! 'annulus-unfold 'a 0 'R)
    (dk-have! (list 'IN x lp-A)
      (lambda ()
        (subst (list '== lp-A (list 'SEP 'anlz_ 'CC (list 'AND '(< 0 (magnitude (- anlz_ a))) '(< (magnitude (- anlz_ a)) R)))))
        (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))))

;;; (1) only if
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'R (list 'IMPLIES '(IN R RR)
  (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho) (list 'IMPLIES '(< rho R)
    (list 'IMPLIES (list 'HOLOMORPHIC-ON lp-A 'f)
      (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES '(< 0 (magnitude (- z a))) (list 'IMPLIES '(< (magnitude (- z a)) R)
        '(= (f z) (LAURENT-SUM (LAURENT-COEFS f a rho) a z))))))))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(dk-cite! 'holomorphic-on-open lp-A 'f)
(dk-cite! 'cc-sub-in-cc 'z 'a)
(fact 'cc-magnitude-closed '(- z a))
(define lp-m '(magnitude (- z a)))
(define (lp-case! r1 r2 hyp)
  (for-each (lambda (t) (dk-type! t 'RR)) (list r1 r2))
  (let ((prem (list hyp '(IN rho RR) '(IN R RR) (list 'IN lp-m 'RR) '(< 0 rho) '(< rho R) (list '< 0 lp-m) (list '< lp-m 'R))))
    (define (ok! claim extra) (dk-have! claim (lambda () (apply dk-ineq! (append prem extra)))))
    (ok! (list '< 0 r1) (list (list 'IN r1 'RR)))
    (ok! (list '< r1 'rho) (list (list 'IN r1 'RR)))
    (ok! (list '< 'rho r2) (list (list 'IN r2 'RR)))
    (ok! (list '< r1 lp-m) (list (list 'IN r1 'RR)))
    (ok! (list '< lp-m r2) (list (list 'IN r2 'RR)))
    (ok! (list '< r2 'R) (list (list 'IN r2 'RR))))
  (dk-have! (list 'FORALL 'lxb_ (list 'IMPLIES '(IN lxb_ CC) (list 'IMPLIES (list '<= r1 '(magnitude (- lxb_ a)))
              (list 'IMPLIES (list '<= '(magnitude (- lxb_ a)) r2) (list 'IN 'lxb_ lp-A)))))
    (lambda ()
      (let* ((x (dk-di-var!)))
        (di) (di)
        (let ((mx (list 'magnitude (list '- x 'a))))
          (dk-cite! 'cc-sub-in-cc x 'a) (fact 'cc-magnitude-closed (list '- x 'a))
          (dk-have! (list '< 0 mx) (lambda () (dk-ineq! (list 'IN mx 'RR) (list 'IN r1 'RR) (list '< 0 r1) (list '<= r1 mx))))
          (dk-have! (list '< mx 'R) (lambda () (dk-ineq! (list 'IN mx 'RR) (list 'IN r2 'RR) '(IN R RR) (list '< r2 'R) (list '<= mx r2))))
          (lp-in-A! x)))))
  (dk-cite! 'laurent-expansion lp-A 'f 'a r1 r2 'rho 'z)
  (if (pair? (dk-open-leaves)) (ass)))
(use-em (list '<= 'rho lp-m)
  (lambda () (lp-case! '(* 1/2 rho) (list '* 1/2 (list '+ lp-m 'R)) (list '<= 'rho lp-m)))
  (lambda () (fact 'rr-not-le-lt 'rho lp-m) (lp-case! (list '* 1/2 lp-m) '(* 1/2 (+ rho R)) (list '< lp-m 'rho))))
(qed 'laurent-punctured-expansion)

;;; (2) if
(define (lp-ann-parts! y p q)        ; y in ANNULUS(a, p, q) in context: land y in CC, p < |y - a|, |y - a| < q
  (let ((U (list 'ANNULUS 'a p q)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list 'AND (list '< p (list 'magnitude (list '- y 'a))) (list '< (list 'magnitude (list '- y 'a)) q)))
      (lambda ()
        (let* ((eq (dk-cite! 'annulus-unfold 'a p q))
               (h (dk-rewrite-h! (list 'IN y U) U (caddr eq))))
          (sep-me h) (dk-split-all!) (dk-conj-close! (lambda () (ass))))))
    (dk-split-all!)))
(define (lp-in-ann! x p q)           ; x in CC, p < |x - a| < q in context: x in ANNULUS(a, p, q)
  (let ((U (list 'ANNULUS 'a p q)))
    (dk-have! (list 'IN x U)
      (lambda ()
        (subst (list '== U (caddr (dk-cite! 'annulus-unfold 'a p q))))
        (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))))
(define lp-cp '(VNB-LAMBDA lak_ NN (c lak_)))
(define lp-cn '(VNB-LAMBDA lak_ NN (c (- (+ lak_ 1)))))
(sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c (FUN ZZ CC)) (list 'FORALL 'a (list 'IMPLIES '(IN a CC)
  (list 'FORALL 'R (list 'IMPLIES '(IN R RR) (list 'IMPLIES '(< 0 R)
    (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f (list 'FUN lp-A 'CC))
      (list 'IMPLIES (list 'FORALL 'lpx_ (list 'IMPLIES (list 'IN 'lpx_ lp-A) '(= (f lpx_) (LAURENT-SUM c a lpx_))))
        (list 'IMPLIES (list 'FORALL 'lprp_ (list 'IMPLIES '(IN lprp_ RR) (list 'IMPLIES '(< lprp_ R) (list '< 'lprp_ (list 'CPS-RADIUS lp-cp)))))
          (list 'IMPLIES (list 'FORALL 'lprm_ (list 'IMPLIES '(IN lprm_ RR) (list 'IMPLIES '(< 0 lprm_) (list '< '(recip lprm_) (list 'CPS-RADIUS lp-cn)))))
            (list 'HOLOMORPHIC-ON lp-A 'f)))))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'cc-is-metric-space)
(dk-cite! 'annulus-open 'a 0 'R)
(let ((iff (dk-cite! 'cc-ms-open-iff lp-A)))
  (dk-have! (list 'IS-OPEN lp-nfm lp-A) (lambda () (dk-only! iff (list 'IS-OPEN 'CC-MS lp-A)) (prop))))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IS-OPEN) (ass))
        ((dk-head-is? g 'IN) (ass))
        (#t
         (let* ((y (dk-di-var!)))
           (lp-ann-parts! y 0 'R)
           (let* ((m (list 'magnitude (list '- y 'a)))
                  (rm (list '* 1/2 m)) (rp (list '* 1/2 (list '+ m 'R)))
                  (W (list 'ANNULUS 'a rm rp))
                  (lpp-gfun (list 'VNB-LAMBDA 'lax_ W '(LAURENT-SUM c a lax_))))
             (fact 'cc-sub-in-cc y 'a) (fact 'cc-magnitude-closed (list '- y 'a))
             (dk-type! rm 'RR) (dk-type! rp 'RR)
             (let ((prem (list '(IN R RR) (list 'IN m 'RR) (list 'IN rm 'RR) (list 'IN rp 'RR) (list '< 0 m) (list '< m 'R))))
               (for-each (lambda (cl) (dk-have! cl (lambda () (apply dk-ineq! prem))))
                         (list (list '< 0 rm) (list '< rm rp) (list '< rp 'R) (list '< rm m) (list '< m rp))))
             (dk-apply! (dk-ctx-form (list 'FORALL 'lprp_ (list 'IMPLIES '(IN lprp_ RR) (list 'IMPLIES '(< lprp_ R) (list '< 'lprp_ (list 'CPS-RADIUS lp-cp)))))) rp)
             (dk-apply! (dk-ctx-form (list 'FORALL 'lprm_ (list 'IMPLIES '(IN lprm_ RR) (list 'IMPLIES '(< 0 lprm_) (list '< '(recip lprm_) (list 'CPS-RADIUS lp-cn)))))) rm)
             (dk-cite! 'laurent-holomorphic 'c 'a rm rp)
             (lp-in-ann! y rm rp)
             (let ((L (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff W lpp-gfun) y))))
               (dk-have! (list 'SUBSET W lp-A)
                 (lambda ()
                   (let* ((x (subset-by-element!)) (leaf (proof-state-focus *ps*)) (mx (list 'magnitude (list '- x 'a))))
                     (lp-ann-parts! x rm rp)
                     (fact 'cc-sub-in-cc x 'a) (fact 'cc-magnitude-closed (list '- x 'a))
                     (dk-have! (list '< 0 mx) (lambda () (dk-ineq! (list 'IN mx 'RR) (list 'IN rm 'RR) (list '< 0 rm) (list '< rm mx))))
                     (dk-have! (list '< mx 'R) (lambda () (dk-ineq! (list 'IN mx 'RR) (list 'IN rp 'RR) '(IN R RR) (list '< rp 'R) (list '< mx rp))))
                     (lp-in-ann! x 0 'R)
                     (if (not (sequent-node-grounded? leaf)) (ass)))))
               (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ W) (list '= '(f cexx_) (list lpp-gfun 'cexx_))))
                 (lambda ()
                   (let* ((x (dk-di-var!)))
                     (fact 'subset-mem-fwd W lp-A x)
                     (dk-apply! (dk-ctx-form (list 'FORALL 'lpx_ (list 'IMPLIES (list 'IN 'lpx_ lp-A) '(= (f lpx_) (LAURENT-SUM c a lpx_))))) x)
                     (fact 'fun-apply-type-c 'f lp-A 'CC x)
                     (dk-lam-b!)
                     (if (pair? (dk-open-leaves)) (ass)))))
               (dk-cite! 'cc-diff-on-local lp-A 'f W lpp-gfun y L)
               (ew L)
               (ass)))))))))
(qed 'laurent-punctured-holomorphic)

;;; (3) COROLLARY 4.6 AS ONE STATEMENT: f in fun(A(a, 0, R), cc) is holomorphic iff it is the sum of a Laurent series
;;; about a whose two radii conditions hold on every sub-annulus.
(define lp-rad+ (list 'FORALL 'lprp_ (list 'IMPLIES '(IN lprp_ RR) (list 'IMPLIES '(< lprp_ R) (list '< 'lprp_ (list 'CPS-RADIUS lp-cp))))))
(define lp-rad- (list 'FORALL 'lprm_ (list 'IMPLIES '(IN lprm_ RR) (list 'IMPLIES '(< 0 lprm_) (list '< '(recip lprm_) (list 'CPS-RADIUS lp-cn))))))
(define lp-eqs (list 'FORALL 'lpx_ (list 'IMPLIES (list 'IN 'lpx_ lp-A) '(= (f lpx_) (LAURENT-SUM c a lpx_)))))
(define lp-rhs (list 'FORSOME 'c (list 'AND '(IN c (FUN ZZ CC)) (list 'AND lp-rad+ (list 'AND lp-rad- lp-eqs)))))
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'R (list 'IMPLIES '(IN R RR) (list 'IMPLIES '(< 0 R)
  (list 'IMPLIES (list 'IN 'f (list 'FUN lp-A 'CC))
    (list 'IFF (list 'HOLOMORPHIC-ON lp-A 'f) lp-rhs))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(dk-iff! (dk-head? 'FORSOME)
  ;; holomorphic ==> the Laurent series of f, read on the circle of radius R/2
  (lambda ()
    (let* ((rho '(* 1/2 R)) (LC (list 'LAURENT-COEFS 'f 'a rho)))
      (dk-type! rho 'RR)
      (dk-have! (list '< 0 rho) (lambda () (dk-ineq! '(< 0 R) (list 'IN rho 'RR))))
      (dk-have! (list '< rho 'R) (lambda () (dk-ineq! '(< 0 R) (list 'IN rho 'RR))))
      (dk-cite! 'holomorphic-on-open lp-A 'f)
      ;; the punctured disc lies in A
      (dk-have! '(FORALL lxb_ (IMPLIES (IN lxb_ CC) (IMPLIES (< 0 (magnitude (- lxb_ a))) (IMPLIES (< (magnitude (- lxb_ a)) R) (IN lxb_ (ANNULUS a 0 R))))))
        (lambda () (let* ((x (dk-di-var!))) (di) (di) (lp-in-A! x))))
      ;; the circle of radius rho lies in A
      (dk-cite! 'circle-is-road 'a rho)
      (fact 'is-road-is-path (list 'CIRCLE-PATH 'a rho) (list 'CIRCLE-DERIV 'a rho) 0 '(* 2 PI))
      (fact 'is-path-in-fun (list 'CIRCLE-PATH 'a rho) 0 '(* 2 PI))
      (dk-cite! 'trace-subset-cc (list 'CIRCLE-PATH 'a rho) 0 '(* 2 PI))
      (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list '< 0 rho))))
      (dk-have! (list 'SUBSET (list 'TRACE (list 'CIRCLE-PATH 'a rho) 0 '(* 2 PI)) lp-A)
        (lambda ()
          (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)) (m (list 'magnitude (list '- y 'a))))
            (fact 'subset-mem-fwd (list 'TRACE (list 'CIRCLE-PATH 'a rho) 0 '(* 2 PI)) 'CC y)
            (dk-cite! 'circle-trace-magnitude 'a rho y)
            (fact 'cc-sub-in-cc y 'a) (fact 'cc-magnitude-closed (list '- y 'a))
            (dk-have! (list '< 0 m) (lambda () (dk-ineq! (list '= m rho) (list '< 0 rho) (list 'IN rho 'RR))))
            (dk-have! (list '< m 'R) (lambda () (dk-ineq! (list '= m rho) (list '< rho 'R) (list 'IN rho 'RR) '(IN R RR))))
            (lp-in-A! y)
            (if (not (sequent-node-grounded? leaf)) (ass)))))
      (dk-cite! 'laurent-coefs-in-fun lp-A 'f 'a rho)
      (dk-split-all! (list (dk-cite! 'laurent-coefs-radii lp-A 'f 'a 'R rho)))
      (dk-cite! 'laurent-punctured-expansion 'f 'a 'R rho)
      (ew LC)
      (dk-conj-close!
        (lambda ()
          (if (and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'LAURENT-SUM))
              (let* ((x (dk-di-var!)))
                (lp-ann-parts! x 0 'R)
                (dk-apply! (dk-ctx-form '(FORALL z (IMPLIES (IN z CC) (IMPLIES (< 0 (magnitude (- z a))) (IMPLIES (< (magnitude (- z a)) R)
                                           (= (f z) (LAURENT-SUM (LAURENT-COEFS f a (* 1/2 R)) a z))))))) x)
                (if (pair? (dk-open-leaves)) (ass)))
              (ass))))))
  ;; a Laurent series with those radii ==> holomorphic (4.1 on the sub-annuli)
  (lambda ()
    (let* ((cv (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the series"))))
      (dk-split-all!)
      (dk-cite! 'laurent-punctured-holomorphic cv 'a 'R 'f)
      (if (pair? (dk-open-leaves)) (ass)))))
(qed 'laurent-punctured-iff)
