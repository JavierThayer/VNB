;;; triangle-orientation.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3e/ch3e-angle.scm (proofs), scratchpad/ch3e/ch3e-orient.scm.
;;; Library: complex-analysis.

;;; ch3e-angle.scm -- CH3-E: the ANGLE of complex-analysis.pdf 1.4 (Remark 1.13) and positive
;;; orientation of a triangle (1.4.2), with Lemma 1.14.
;;;
;;; VOCABULARY (defined here, the notes' definitions):
;;;   ANGLE(a, b)   the angle from b to a, in [0, 2 pi): for a = r e^(i theta), b = s e^(i tau) with
;;;                 theta, tau in [0, 2 pi) it is theta - tau, or 2 pi + (theta - tau) when negative.
;;;                 Written as pi + Im(L) for the logarithm L of -(a conj b) in the strip
;;;                 -pi <= Im < pi (cc-exp-surjective-strip / cc-exp-injective-strip): since
;;;                 a conj b = r s e^(i (theta - tau)), the argument of a conj b in [0, 2 pi) is the
;;;                 notes' angle, and arg(w) = pi + arg_(-pi, pi](-w).
;;;   POSITIVELY-ORIENTED(a, b, c)   for every u in int conv{a, b, c} the three angles
;;;                 ANGLE(b - u, a - u), ANGLE(c - u, b - u), ANGLE(a - u, c - u) are < pi.
;;;
;;; Library: complex-analysis.  Helper prefix: an-.







(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (an-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "an-pick: nothing matching" what) (car l))))
(define (an-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (an-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (an-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define an-r2i '(recip (* 2 +i)))
(define (an-r2i! )                             ; recip(2 i) typed, named; returns the name and (= (* (* 2 +i) n) 1)
  (fact 'cc-i-in)
  (an-cc! '(* 2 +i))
  (dk-have! '(NOT (= (* 2 +i) 0)) (lambda () (arith)))
  (an-and! '(IN (* 2 +i) CC) '(NOT (= (* 2 +i) 0)))
  (fact 'cc-recip-closed '(* 2 +i))
  (fact 'cc-recip-inverse '(* 2 +i))
  (let ((v (dk-name! an-r2i 'CC)))
    (dk-rewrite-h! (list '= '(* (* 2 +i) (recip (* 2 +i))) 1) an-r2i v)
    v))

;;; name recip(2 i) and recip(2) in the goal, so that `crs' can work (it declines recip)
(define (an-r2! )
  (dk-have! '(IN 2 RR)) (dk-have! '(NOT (= 2 0)) (lambda () (arith)))
  (an-and! '(IN 2 RR) '(NOT (= 2 0)))
  (fact 'rr-recip-closed 2) (fact 'rr-recip-inverse 2) (fact 'rr-subset-cc '(recip 2))
  (let ((v (dk-name! '(recip 2) 'CC)))
    (dk-rewrite-h! '(= (* 2 (recip 2)) 1) '(recip 2) v)
    v))
(define (an-name-recips!)
  (if (dk-contains? (dk-goal) an-r2i) (let ((v (an-r2i!))) (subst (list '= an-r2i v))))
  (if (dk-contains? (dk-goal) '(recip 2)) (let ((v (an-r2!))) (subst (list '= '(recip 2) v)))))

;;; ---------------------------------------------------------------------------
;;; Im and Re of a real multiple: Im(c w) = c Im(w), Re(c w) = c Re(w)  (c real)
(sp (make-wff (forall-guarded '(anc_ anw_) '((IN anc_ RR) (IN anw_ CC))
  '(AND (= (imag-part (* anc_ anw_)) (* anc_ (imag-part anw_))) (= (real-part (* anc_ anw_)) (* anc_ (real-part anw_)))))))
(dk-peel!)
(fact 'rr-subset-cc 'anc_)
(an-and! '(IN anc_ CC) '(IN anw_ CC))
(fact 'cc-conjugate-mul 'anc_ 'anw_)
(fact 'cc-conjugate-fixes-rr 'anc_)
(fact 'cc-conjugate-closed 'anw_)
(an-cc! '(* anc_ anw_))
(fact 'imag-part-in-rr '(* anc_ anw_)) (fact 'imag-part-in-rr 'anw_)
(fact 'real-part-in-rr '(* anc_ anw_)) (fact 'real-part-in-rr 'anw_)
(dk-conj-close!
  (lambda ()
    (mac (if (eq? (car (cadr (dk-goal))) 'imag-part) 'imag-part-def 'real-part-def))
    (subst '(= (conjugate (* anc_ anw_)) (* (conjugate anc_) (conjugate anw_))))
    (subst '(= (conjugate anc_) anc_))
    (an-name-recips!)
    (crs)))
(qed 'real-scale-re-im)

;;; ---------------------------------------------------------------------------
;;; exp(L) in polar form: Im exp(L) = e^(Re L) sin(Im L), Re exp(L) = e^(Re L) cos(Im L)
(sp (make-wff '(FORALL anl_ (IMPLIES (IN anl_ CC)
  (AND (= (imag-part (CC-EXP anl_)) (* (CC-EXP (real-part anl_)) (CC-SIN (imag-part anl_))))
       (= (real-part (CC-EXP anl_)) (* (CC-EXP (real-part anl_)) (CC-COS (imag-part anl_)))))))))
(dk-peel!)
(let* ((L 'anl_) (x '(real-part anl_)) (y '(imag-part anl_)) (iy (list '* '+i y))
       (ex (list 'CC-EXP x)) (ey (list 'CC-EXP iy)))
  (fact 'real-part-in-rr L) (fact 'imag-part-in-rr L)
  (fact 'cc-i-in) (fact 'rr-subset-cc x) (fact 'rr-subset-cc y)
  (an-cc! iy)
  (fact 'cc-re-im-decompose L)
  (dk-split-all! (list (dk-cite! 'cc-exp-real x)))
  (dk-split-all! (list (dk-cite! 'cc-exp-converges iy)))
  (fact 'cc-exp-add x iy)
  (dk-rewrite-h! (list '= (list 'CC-EXP (list '+ x iy)) (list '* ex ey)) (list '+ x iy) L)
  (dk-split-all! (list (dk-cite! 'real-scale-re-im ex ey)))
  (fact 'cc-sin-real-part y) (fact 'cc-cos-real-part y)
  (dk-split-all! (list (dk-cite! 'cc-cos-sin-real y)))
  (fact 'imag-part-in-rr ey) (fact 'real-part-in-rr ey)
  (dk-conj-close!
    (lambda ()
      (subst (list '= (list 'CC-EXP L) (list '* ex ey)))
      (if (eq? (car (cadr (dk-goal))) 'imag-part)
          (begin (subst (list '= (list 'imag-part (list '* ex ey)) (list '* ex (list 'imag-part ey))))
                 (subst (list '= (list 'imag-part ey) (list 'CC-SIN y))))
          (begin (subst (list '= (list 'real-part (list '* ex ey)) (list '* ex (list 'real-part ey))))
                 (subst (list '= (list 'real-part ey) (list 'CC-COS y)))))
      (an-rr! (list '* ex (list 'CC-SIN y))) (an-rr! (list '* ex (list 'CC-COS y)))
      (if (not (proof-done? *ps*)) (rfl)))))
(qed 'exp-polar-re-im)

;;; ---------------------------------------------------------------------------
(define (an-lt-of-le-ne! a b)    ; a <= b and NOT (b = a) in context => a < b
  (if (not (dk-asm? (list 'NOT (list '= a b))))
      (dk-have! (list 'NOT (list '= a b))
        (lambda () (di) (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl))) (ai (list 'NOT (list '= b a))))))
  (an-rr! a) (an-rr! b)
  (let ((ch (dk-cite! 'rr-le-ne-lt a b)))
    (if (and (pair? ch) (eq? (car ch) 'IMPLIES))
        (detach-with! ch (lambda () (dk-conj-close! (lambda () (ass))))))))
;;; THE ANGLE TEST: for z, w /= 0, ANGLE(z, w) < pi iff Im(z conj w) > 0, or z conj w is a positive real
(define (an-cross z w) (list 'imag-part (list '* z (list 'conjugate w))))
(define (an-dot z w) (list 'real-part (list '* z (list 'conjugate w))))
(sp (make-wff (forall-guarded '(anz_ anv_) '((IN anz_ CC) (IN anv_ CC) (NOT (= anz_ 0)) (NOT (= anv_ 0)))
  (list 'IFF '(< (ANGLE anz_ anv_) PI)
        (list 'OR (list '< 0 (an-cross 'anz_ 'anv_))
                  (list 'AND (list '= (an-cross 'anz_ 'anv_) 0) (list '< 0 (an-dot 'anz_ 'anv_))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'pi-pos)))
(fact 'rr-zero-in)
(let* ((cv '(conjugate anv_)) (p (list '* 'anz_ cv)) (q (list '- p))
       (S (list 'SEP 'angz_ 'CC (list 'AND '(<= (- PI) (imag-part angz_)) (list 'AND '(< (imag-part angz_) PI) (list '= '(CC-EXP angz_) q))))))
  (fact 'cc-conjugate-closed 'anv_)
  (dk-have! (list 'NOT (list '= cv 0))
    (lambda () (di)
      (fact 'cc-conjugate-involution 'anv_)
      (dk-have! '(IN 0 RR)) (fact 'cc-conjugate-fixes-rr 0)
      (dk-have! '(= anv_ 0) (lambda () (subst (list '= 'anv_ (list 'conjugate cv))) (subst (list '= cv 0)) (subst '(= (conjugate 0) 0)) (rfl)))
      (ai '(NOT (= anv_ 0)))))
  (an-cc! p) (an-cc! q)
  (dk-fact! 'cc-mul-nonzero 'anz_ cv)
  (dk-have! (list 'NOT (list '= q 0))
    (lambda () (di) (dk-have! (list '= p 0) (lambda () (dk-have! (list '= p (list '- q)) (lambda () (crs))) (subst (list '= p (list '- q))) (subst (list '= q 0)) (crs)))
               (ai (list 'NOT (list '= p 0)))))
  ;; the logarithm L of -p in the strip; ANGLE = pi + Im L
  (let* ((z0 (dk-skolem! (dk-fact! 'cc-exp-surjective-strip q) #t)))
    (dk-split-all!)
    (choose-mem! S z0 (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
    (let* ((Lc (list 'CHOICE S)))
      (dk-have! (list 'IN Lc 'CC) (lambda () (sep-me (list 'IN Lc S)) (if (not (proof-done? *ps*)) (ass))))
      (dk-have! (list 'AND (list '<= '(- PI) (list 'imag-part Lc)) (list 'AND (list '< (list 'imag-part Lc) 'PI) (list '= (list 'CC-EXP Lc) q)))
        (lambda () (sep-me (list 'IN Lc S)) (if (not (proof-done? *ps*)) (ass))))
      (let ((L (dk-name! Lc 'CC)))
        (dk-split-all! (list (dk-rewrite-h! (list 'AND (list '<= '(- PI) (list 'imag-part Lc)) (list 'AND (list '< (list 'imag-part Lc) 'PI) (list '= (list 'CC-EXP Lc) q))) Lc L)))
        (mac 'ANGLE)
        (subst (list '= Lc L))
        (let* ((x (list 'real-part L)) (y (list 'imag-part L)) (E (list 'CC-EXP x))
               (sy (list 'CC-SIN y)) (cy (list 'CC-COS y)) (Ip (an-cross 'anz_ 'anv_)) (Rp (an-dot 'anz_ 'anv_)))
          (fact 'real-part-in-rr L) (fact 'imag-part-in-rr L)
          (dk-split-all! (list (dk-cite! 'cc-exp-real x)))
          (dk-split-all! (list (dk-cite! 'cc-cos-sin-real y)))
          (dk-split-all! (list (dk-cite! 'exp-polar-re-im L)))
          (fact 'rr-subset-cc y)
          ;; Im p = -(E sin y), Re p = -(E cos y)
          (dk-have! '(IN (- 1) RR) (lambda () (type-term)))
          (dk-have! (list '= p (list '* '(- 1) q)) (lambda () (crs)))
          (dk-split-all! (list (dk-cite! 'real-scale-re-im '(- 1) q)))
          (fact 'imag-part-in-rr q) (fact 'real-part-in-rr q)
          (an-rr! (list '* E sy)) (an-rr! (list '* E cy))
          (dk-have! (list '= Ip (list '- (list '* E sy)))
            (lambda () (subst (list '= p (list '* '(- 1) q))) (subst (list '= (list 'imag-part (list '* '(- 1) q)) (list '* '(- 1) (list 'imag-part q))))
                       (subst (list '= q (list 'CC-EXP L))) (subst (list '= (list 'imag-part (list 'CC-EXP L)) (list '* E sy))) (crs)))
          (dk-have! (list '= Rp (list '- (list '* E cy)))
            (lambda () (subst (list '= p (list '* '(- 1) q))) (subst (list '= (list 'real-part (list '* '(- 1) q)) (list '* '(- 1) (list 'real-part q))))
                       (subst (list '= q (list 'CC-EXP L))) (subst (list '= (list 'real-part (list 'CC-EXP L)) (list '* E cy))) (crs)))
          (fact 'imag-part-in-rr p) (fact 'real-part-in-rr p)
          (an-rr! (list '+ 'PI y))
          (define (sides! lhs? ip-pos? ip-zero? rp-pos?)   ; land the truth values and close by prop
            (let ((A (list '< (list '+ 'PI y) 'PI)) (B (list '< 0 Ip)) (C (list '= Ip 0)) (D (list '< 0 Rp)))
              (let ((lits (list (if lhs? A (list 'NOT A)) (if ip-pos? B (list 'NOT B)))))
                (if (dk-only! (car lits) (cadr lits)
                              (if (eq? ip-zero? 'skip) (car lits) (if ip-zero? C (list 'NOT C)))
                              (if (eq? rp-pos? 'skip) (car lits) (if rp-pos? D (list 'NOT D))))
                    (prop)))))
          (define (not-lt! a b prems)              ; (NOT (< a b)) from linear premises giving b <= a
            (let ((g (list 'NOT (list '< a b))))
              (if (not (dk-asm? g)) (dk-have! g (lambda () (di) (apply dk-absurd! (cons (list '< a b) prems)))))))
          (define (not-eq! a b prems)
            (let ((g (list 'NOT (list '= a b))))
              (if (not (dk-asm? g)) (dk-have! g (lambda () (di) (apply dk-absurd! (cons (list '= a b) prems)))))))
          (fact 'rr-leq-total y 0)
          (dk-have! (list 'AND (list 'IN y 'RR) '(IN 0 RR)))
          (fact 'rr-leq-total y 0)
          (use-em (list '< y 0)
            ;; y < 0: the angle is < pi
            (lambda ()
              (dk-have! (list '< (list '+ 'PI y) 'PI) (lambda () (dk-ineq! (list '< y 0))))
              (use-em (list '= y '(- PI))
                (lambda ()
                  ;; y = -pi: sin y = 0, cos y = -1, so Im p = 0 and Re p = E > 0
                  (fact 'rr-subset-cc 'PI)
                  (dk-cite! 'cc-sin-odd 'PI) (dk-cite! 'cc-cos-even 'PI) (dk-split-all! (list (dk-cite! 'cc-cos-sin-pi)))
                  (dk-have! (list '= sy 0) (lambda () (subst (list '= y '(- PI))) (subst '(= (CC-SIN (- PI)) (- (CC-SIN PI)))) (subst '(= (CC-SIN PI) 0)) (crs)))
                  (dk-have! (list '= cy -1) (lambda () (subst (list '= y '(- PI))) (subst '(= (CC-COS (- PI)) (CC-COS PI))) (ass)))
                  (dk-have! (list '= Ip 0) (lambda () (subst (list '= Ip (list '- (list '* E sy)))) (subst (list '= sy 0)) (crs)))
                  (dk-have! (list '= (list '* E cy) (list '- E)) (lambda () (subst (list '= cy -1)) (crs)))
                  (dk-have! (list '< 0 Rp) (lambda () (dk-ineq! (list '= Rp (list '- (list '* E cy))) (list '= (list '* E cy) (list '- E)) (list '< 0 E))))
                  (sides! #t #f #t #t))
                (lambda ()
                  ;; -pi < y < 0: sin y < 0, so Im p > 0
                  (an-lt-of-le-ne! '(- PI) y)
                  (dk-have! (list '< 0 (list '- y)) (lambda () (dk-ineq! (list '< y 0))))
                  (dk-have! (list '< (list '- y) 'PI) (lambda () (dk-ineq! (list '< '(- PI) y))))
                  (an-rr! (list '- y))
                  (fact 'cc-sin-pos-half (list '- y))
                  (dk-cite! 'cc-sin-odd y)
                  (dk-split-all! (list (dk-cite! 'cc-cos-sin-real (list '- y))))
                  (dk-have! (list '< sy 0) (lambda () (dk-ineq! (list '= (list 'CC-SIN (list '- y)) (list '- sy)) (list '< 0 (list 'CC-SIN (list '- y))))))
                  (dk-have! (list '< 0 (list '- sy)) (lambda () (dk-ineq! (list '< sy 0))))
                  (an-rr! (list '- sy))
                  (fact 'rr-mul-pos E (list '- sy))
                  (an-rr! (list '* E (list '- sy)))
                  (dk-have! (list '= (list '* E (list '- sy)) (list '- (list '* E sy))) (lambda () (crs)))
                  (dk-have! (list '< 0 Ip) (lambda () (dk-ineq! (list '= Ip (list '- (list '* E sy))) (list '< 0 (list '* E (list '- sy)))
                                                                (list '= (list '* E (list '- sy)) (list '- (list '* E sy))))))
                  (sides! #t #t 'skip 'skip))))
            ;; y >= 0: the angle is >= pi, and neither disjunct holds
            (lambda ()
              (use-em (list '= y 0)
                (lambda ()
                  (fact 'cc-cos-zero) (fact 'rr-subset-cc 0) (fact 'cc-exp-zero)
                  (dk-cite! 'cc-sin-real-part 0)
                  (dk-have! '(= (* +i 0) 0) (lambda () (crs)))
                  (dk-have! '(IN 1 RR)) (fact 'rr-imag-part-zero 1)
                  (dk-have! (list '= sy 0) (lambda () (subst (list '= y 0)) (subst '(= (CC-SIN 0) (imag-part (CC-EXP (* +i 0)))))
                                                       (subst '(= (* +i 0) 0)) (subst '(= (CC-EXP 0) 1)) (ass)))
                  (dk-have! (list '= cy 1) (lambda () (subst (list '= y 0)) (ass)))
                  (dk-have! (list '= Ip 0) (lambda () (subst (list '= Ip (list '- (list '* E sy)))) (subst (list '= sy 0)) (crs)))
                  (dk-have! (list '= (list '* E cy) E) (lambda () (subst (list '= cy 1)) (crs)))
                  (dk-have! (list '< Rp 0) (lambda () (dk-ineq! (list '= Rp (list '- (list '* E cy))) (list '= (list '* E cy) E) (list '< 0 E))))
                  (not-lt! (list '+ 'PI y) 'PI (list (list '= y 0)))
                  (not-lt! 0 Ip (list (list '= Ip 0)))
                  (not-lt! 0 Rp (list (list '< Rp 0)))
                  (sides! #f #f #t #f))
                (lambda ()
                  (dk-have! (list '< 0 y)
                    (lambda () (use-cases (list (list '<= y 0) (list '<= 0 y))
                                 (lambda () (an-lt-of-le-ne! y 0) (ai (list 'NOT (list '< y 0))))
                                 (lambda () (an-lt-of-le-ne! 0 y) (if (dk-asm? (dk-goal)) (ass))))))
                  (not-lt! (list '+ 'PI y) 'PI (list (list '< 0 y)))
                  (fact 'cc-sin-pos-half y)
                  (fact 'rr-mul-pos E sy)
                  (dk-have! (list '< Ip 0) (lambda () (dk-ineq! (list '= Ip (list '- (list '* E sy))) (list '< 0 (list '* E sy)))))
                  (not-lt! 0 Ip (list (list '< Ip 0)))
                  (not-eq! Ip 0 (list (list '< Ip 0)))
                  (sides! #f #f #f 'skip))))))))))
(qed 'angle-lt-pi-iff)

  

