;;; ch3e-orient.scm -- CH3-E: orientation of a triangle by the cross product Im(z conj w).
;;; Loaded after ch3e-angle.scm (same environment, helper prefix ao-).
;;;
;;;   cr(z, w) = Im(z conj w) = Im z Re w - Re z Im w           (cc-cross-coords)
;;;   for z in conv{a, b, c} with weights l, m, n:
;;;     cr(b - z, a - z) = n cr(b - c, a - c), and its two cyclic shifts   (conv3-cross-weights)
;;;   at an interior point u of a set T on which cr(q - z, p - z) = t k with t >= 0, p /= q:
;;;     0 < k cr(q - u, p - u)                                             (interior-cross-sign)
;;; Library: complex-analysis.

(define (ao-cr z w) (list 'imag-part (list '* z (list 'conjugate w))))

;;; ---------------------------------------------------------------------------
;;; Im(z conj w) in coordinates: cc-cross-coords (in the band, goursat-exceptional)

;;; ---------------------------------------------------------------------------
;;; coordinate machinery.  ENV: alist  base-term -> (x . y), names of Re and Im, with
;;; (= base (+ x (* +i y))) in context.
(define (ao-base! z)
  (an-cc! z)
  (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
  (let* ((dec (dk-cite! 'cc-re-im-decompose z))
         (x (dk-name! (list 'real-part z) 'RR))
         (d1 (dk-rewrite-h! dec (list 'real-part z) x))
         (y (dk-name! (list 'imag-part z) 'RR)))
    (dk-rewrite-h! d1 (list 'imag-part z) y)
    (cons z (cons x y))))
(define (ao-eval e env)                       ; -> (X . Y); (* c e) has c real
  (let ((hit (assoc e env)))
    (cond (hit (cdr hit))
          ((eqv? e 0) (cons 0 0))
          ((and (pair? e) (eq? (car e) '+))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '+ (car a) (car b)) (list '+ (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-) (= (length e) 3))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '- (car a) (car b)) (list '- (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-))
           (let ((a (ao-eval (cadr e) env))) (cons (list '- (car a)) (list '- (cdr a)))))
          ((and (pair? e) (eq? (car e) '*))
           (let ((a (ao-eval (caddr e) env))) (cons (list '* (cadr e) (car a)) (list '* (cadr e) (cdr a)))))
          (#t (error "ao-eval: no coordinates for" e)))))
(define (ao-coords! e env)                    ; lands Re e = X, Im e = Y; returns (X . Y)
  (let* ((xy (ao-eval e env)) (X (car xy)) (Y (cdr xy)))
    (an-cc! e) (an-rr! X) (an-rr! Y)
    (let ((eq (list '= e (list '+ X (list '* Y '+i)))))
      (if (not (dk-asm? eq))
          (dk-have! eq (lambda ()
                         (for-each (lambda (b) (if (dk-contains? (cadr (dk-goal)) (car b))
                                                   (subst (list '= (car b) (list '+ (cadr b) (list '* '+i (cddr b)))))))
                                   env)
                         (crs))))
      (if (not (and (dk-asm? (list '= (list 'real-part e) X)) (dk-asm? (list '= (list 'imag-part e) Y))))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of e X Y))))
      xy)))
(define (ao-cross! z w env)                   ; lands cr(z, w) = Yz Xw - Xz Yw; returns the RHS
  (let* ((a (ao-coords! z env)) (b (ao-coords! w env))
         (rhs (list '- (list '* (cdr a) (car b)) (list '* (car a) (cdr b))))
         (eq (list '= (ao-cr z w) rhs)))
    (if (not (dk-asm? eq))
        (let ((t1 (dk-cite! 'cc-cross-coords z w)))
          (dk-have! eq (lambda ()
                         (subst t1)
                         (subst (list '= (list 'imag-part z) (cdr a))) (subst (list '= (list 'real-part w) (car b)))
                         (subst (list '= (list 'real-part z) (car a))) (subst (list '= (list 'imag-part w) (cdr b)))
                         (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (crs)))))))
    rhs))

;;; land the coefficients of z in CONV3(a, b, c): (l m n), each in RR with 0 <= . <= 1
(define (ao-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ao-unit! v)
  (let ((mem (list 'IN v '(CCINT 0 1))))
    (fact 'ccint-elt-in-rr 0 1 v)
    (if (not (and (dk-asm? (list '<= 0 v)) (dk-asm? (list '<= v 1))))
        (let ((cj (list 'AND (list '<= 0 v) (list '<= v 1))))
          (dk-have! cj (lambda () (mac-h 'ccint-membership mem) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
          (dk-split! cj)))))
(define (ao-conv3-open! mem)
  (let* ((new (dk-landed* (lambda () (mac-h 'conv3-member-iff mem))))
         (parts (dk-split-all! new))
         (ex1 (find-first (dk-head? 'FORSOME) (append parts new)))
         (l (dk-skolem! ex1))
         (m (dk-skolem! (dk-pick (lambda (f) (and (ao-op? f 'FORSOME 3) (dk-contains? f l))) "the second coefficient")))
         (n (dk-skolem! (dk-pick (lambda (f) (and (ao-op? f 'FORSOME 3) (dk-contains? f m))) "the third coefficient"))))
    (dk-split-all!)
    (for-each ao-unit! (list l m n))
    (list l m n)))

;;; ---------------------------------------------------------------------------
;;; the cross product against a point of the hull, in the barycentric weights
(define (ao-wt-claim t lhs k)
  (list 'FORSOME t (list 'AND (list 'IN t 'RR) (list 'AND (list '<= 0 t) (list '= lhs (list '* t k))))))
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'FORALL 'aoz_ (list 'IMPLIES '(IN aoz_ (CONV3 aoa_ aob_ aoc_))
    (list 'AND (ao-wt-claim 'aot_ (ao-cr '(- aob_ aoz_) '(- aoa_ aoz_)) (ao-cr '(- aob_ aoc_) '(- aoa_ aoc_)))
    (list 'AND (ao-wt-claim 'aot_ (ao-cr '(- aoc_ aoz_) '(- aob_ aoz_)) (ao-cr '(- aoc_ aoa_) '(- aob_ aoa_)))
               (ao-wt-claim 'aot_ (ao-cr '(- aoa_ aoz_) '(- aoc_ aoz_)) (ao-cr '(- aoa_ aob_) '(- aoc_ aob_))))))))))
(dk-peel!)
(let* ((lmn (ao-conv3-open! '(IN aoz_ (CONV3 aoa_ aob_ aoc_))))
       (l (car lmn)) (m (cadr lmn)) (n (caddr lmn))
       (zeq (an-pick "z = combination" (lambda (f) (and (ao-op? f '= 3) (eq? (cadr f) 'aoz_)))))
       (sum (an-pick "l + m + n = 1" (lambda (f) (and (ao-op? f '= 3) (equal? (caddr f) 1) (dk-contains? f l))))))
  (dk-have! (list '= l (list '- 1 (list '+ m n)))
    (lambda () (let ((h (list '= l (list '- (cadr sum) (list '+ m n)))))
                 (dk-have! h (lambda () (crs)))
                 (dk-rewrite-h! h (cadr sum) 1)
                 (ass))))
  (subst zeq)
  (let ((env (map ao-base! '(aoa_ aob_ aoc_)))
        (leq (list '= l (list '- 1 (list '+ m n)))))
    (dk-conj-close!
      (lambda ()
        (let* ((g (dk-goal)) (lhs (cadr (caddr (caddr (caddr g)))))
               (v (cadr (cadr (cadr lhs))))
               (w (cond ((eq? v 'aob_) n) ((eq? v 'aoc_) l) (#t m))))
          (ew w)
          (dk-conj-close!
            (lambda ()
              (let ((g2 (dk-goal)))
                (if (and (pair? g2) (eq? (car g2) '=))
                    (let* ((lh (cadr g2)) (k (caddr (caddr g2)))
                           (r1 (ao-cross! (cadr (cadr lh)) (cadr (caddr (cadr lh))) env))
                           (r2 (ao-cross! (cadr (cadr k)) (cadr (caddr (cadr k))) env)))
                      (subst (list '= lh r1)) (subst (list '= k r2))
                      (if (dk-contains? (dk-goal) l) (subst leq))
                      (crs))
                    (ass))))))))))
(qed 'conv3-cross-weights)

;;; ---------------------------------------------------------------------------
;;; Im(i z) = Re z
;;; MOVED 2026-11-10 (integration): the proof of `cc-im-i-mul' is now in
;;; theorem-library/cc-im-i-mul.scm (library analysis).

;;; ---------------------------------------------------------------------------
;;; at an interior point the cross product has the sign the hull forces
(define (ao-and-fact! name a b . args)        ; cite NAME at ARGS after landing (AND a b)
  (an-and! a b) (apply fact name args))
(sp (make-wff (forall-guarded '(aop_ aoq_ aok_) '((IN aop_ CC) (IN aoq_ CC) (IN aok_ RR))
  (list 'FORALL 'aoss_ (list 'FORALL 'aou_
   (list 'IMPLIES '(NOT (= aop_ aoq_))
   (list 'IMPLIES '(IN aou_ (INTERIOR CC-MS aoss_))
   (list 'IMPLIES (list 'FORALL 'aoz_ (list 'IMPLIES '(IN aoz_ aoss_) (ao-wt-claim 'aot_ (ao-cr '(- aoq_ aoz_) '(- aop_ aoz_)) 'aok_)))
     (list '< 0 (list '* 'aok_ (ao-cr '(- aoq_ aou_) '(- aop_ aou_))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (k 'aok_) (u 'aou_) (SS 'aoss_)
       (H (an-pick "the hull hypothesis" (lambda (f) (and (ao-op? f 'FORALL 3) (dk-contains? f 'aot_)))))
       (mem (list 'IN u (list 'INTERIOR 'CC-MS SS))))
  ;; u has an open neighbourhood O inside SS, and a ball B(u, r) inside O
  (let* ((new (dk-landed* (lambda () (mac-h 'interior-membership mem)))))
    (dk-split-all! new))
  (let* ((O (dk-skolem! (an-pick "the neighbourhood" (lambda (f) (and (ao-op? f 'FORSOME 3) (dk-contains? f 'IS-OPEN)))) #t)))
    (dk-split-all!)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN u 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
    (dk-split-all! (list (car (dk-landed* (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS O)))))))
    (dk-split-all!)
    (let* ((ex (dk-apply! (an-pick "openness" (lambda (f) (and (ao-op? f 'FORALL 3) (dk-contains? f 'BALL)))) u))
           (r (dk-skolem! ex #t)))
      (dk-split-all!)
      (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
      (let* ((D1 (list '- p q)) (D2 (list '- q p)) (M (list 'magnitude D1)))
        (an-cc! D1) (an-cc! D2)
        ;; p /= q gives M > 0
        (dk-have! (list 'NOT (list '= D1 0))
          (lambda () (di) (dk-fact! 'cc-sub-zero-eq p q) (ai (list 'NOT (list '= p q)))))
        (fact 'cc-magnitude-closed D1) (fact 'cc-magnitude-nonneg D1)
        (let ((iff (dk-cite! 'cc-magnitude-zero-iff D1)))
          (dk-have! (list 'NOT (list '= M 0))
            (lambda () (di) (ai iff) (detach! (list 'IMPLIES (list '= M 0) (list '= D1 0))) (ai (list 'NOT (list '= D1 0))))))
        (an-lt-of-le-ne! 0 M)
        ;; rho = recip(2 M), s = r rho, s M = r / 2
        (an-rr! (list '* 2 M))
        (dk-have! (list '< 0 (list '* 2 M)) (lambda () (dk-ineq! (list '< 0 M))))
        (dk-have! (list 'NOT (list '= (list '* 2 M) 0)) (lambda () (di) (dk-absurd! (list '= (list '* 2 M) 0) (list '< 0 (list '* 2 M)))))
        (an-and! (list 'IN (list '* 2 M) 'RR) (list 'NOT (list '= (list '* 2 M) 0)))
        (fact 'rr-recip-closed (list '* 2 M)) (fact 'rr-recip-inverse (list '* 2 M)) (fact 'rr-recip-pos (list '* 2 M))
        (let* ((rc (list 'recip (list '* 2 M)))
               (rho (dk-name! rc 'RR)))
          (dk-rewrite-h! (list '= (list '* (list '* 2 M) rc) 1) rc rho)
          (dk-rewrite-h! (list '< 0 rc) rc rho)
          (an-rr! (list '* r rho))
          (fact 'rr-mul-pos r rho)
          (let* ((s (dk-name! (list '* r rho) 'RR)))
            (dk-rewrite-h! (list '< 0 (list '* r rho)) (list '* r rho) s)
            (dk-have! (list '= (list '* s M) (list '* 1/2 r))
              (lambda ()
                (let* ((aoo-hq (list '= (list '* (list '* r rho) M) (list '* (list '* 1/2 r) (list '* (list '* 2 M) rho)))))
                  (dk-have! aoo-hq (lambda () (crs)))
                  (let ((h2 (dk-rewrite-h! aoo-hq (list '* (list '* 2 M) rho) 1)))
                    (subst (list '= s (list '* r rho)))
                    (subst h2)
                    (crs)))))
            (fact 'rr-subset-cc s)
            (fact 'rr-magnitude-is-abs s)
            (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
            (fact 'rr-abs-of-nonneg s)
            (dk-cite! 'cc-magnitude-sub-sym q p)
            (fact 'cc-i-in) (fact 'cc-magnitude-i)
            ;; the two points v = u + s (i D), D = p - q and q - p, lie in SS
            (define (point! D)
              (let* ((iD (list '* '+i D)))
                (an-cc! iD)
                (let* ((w (dk-name! iD 'CC)) (v (list '+ u (list '* s w))))
                  (an-cc! v)
                  (an-and! '(IN +i CC) (list 'IN D 'CC))
                  (fact 'cc-magnitude-mul '+i D)
                  (dk-have! (list '< (list 'magnitude (list '- v u)) r)
                    (lambda ()
                      (an-and! (list 'IN s 'CC) (list 'IN w 'CC))
                      (fact 'cc-magnitude-mul s w)
                      (dk-have! (list '= (list '- v u) (list '* s w)) (lambda () (crs)))
                      (subst (list '= (list '- v u) (list '* s w)))
                      (subst (list '= (list 'magnitude (list '* s w)) (list '* (list 'magnitude s) (list 'magnitude w))))
                      (subst (list '= (list 'magnitude s) (list 'abs s))) (subst (list '= (list 'abs s) s))
                      (subst (list '= w iD))
                      (subst (list '= (list 'magnitude iD) (list '* '(magnitude +i) (list 'magnitude D))))
                      (subst '(= (magnitude +i) 1))
                      (if (not (equal? D D1)) (subst (list '= (list 'magnitude D) M)))
                      (dk-have! (list '= (list '* s (list '* 1 M)) (list '* s M)) (lambda () (crs)))
                      (subst (list '= (list '* s (list '* 1 M)) (list '* s M)))
                      (subst (list '= (list '* s M) (list '* 1/2 r))) (dk-ineq! (list '< 0 r))))
                  (dk-have! (list 'IN v (list 'BALL 'CC-MS u r))
                    (lambda () (mac 'cc-ms-ball-membership) (dk-conj-close! (lambda () (ass)))))
                  (dk-fact! 'subset-mem-fwd (list 'BALL 'CC-MS u r) O v)
                  (dk-fact! 'subset-mem-fwd O SS v)
                  (let* ((ex (dk-apply! H v)) (t (dk-skolem! ex #t)))
                    (dk-split-all!)
                    (list w v t)))))
            (let* ((P1 (point! D1)) (P2 (point! D2))
                   (w1 (car P1)) (v1 (cadr P1)) (t1 (caddr P1))
                   (w2 (car P2)) (v2 (cadr P2)) (t2 (caddr P2))
                   (G0 (ao-cr (list '- q u) (list '- p u)))
                   (SN (list '* s (list '* M M))))
              (an-cc! (list '* (list '- q u) (list 'conjugate (list '- p u))))
              (fact 'imag-part-in-rr (list '* (list '- q u) (list 'conjugate (list '- p u))))
              (an-rr! (list '* M M))
              (fact 'rr-mul-pos M M)
              (an-rr! SN)
              (fact 'rr-mul-pos s (list '* M M))
              (define snv (dk-name! SN 'RR))
              (dk-rewrite-h! (list '< 0 SN) SN snv)
              ;; coordinates
              (let* ((envb (map ao-base! (list p q u)))
                     (DX (ao-coords! D1 envb)) (DY (ao-coords! D2 envb))
                     (msq (dk-cite! 'cc-magnitude-sq D1)))
                (define (wcoords! w D Dxy)
                  (let* ((b (ao-base! w)) (wx (cadr b)) (wy (cddr b)))
                    (dk-cite! 'cc-re-i-mul D) (dk-cite! 'cc-im-i-mul D)
                    (dk-have! (list '= wx (list '- (cdr Dxy)))
                      (lambda () (subst (list '= wx (list 'real-part w))) (subst (list '= w (list '* '+i D)))
                                 (subst (list '= (list 'real-part (list '* '+i D)) (list '- (list 'imag-part D))))
                                 (subst (list '= (list 'imag-part D) (cdr Dxy))) (crs)))
                    (dk-have! (list '= wy (car Dxy))
                      (lambda () (subst (list '= wy (list 'imag-part w))) (subst (list '= w (list '* '+i D)))
                                 (subst (list '= (list 'imag-part (list '* '+i D)) (list 'real-part D)))
                                 (subst (list '= (list 'real-part D) (car Dxy))) (crs)))
                    b))
                (let* ((b1 (wcoords! w1 D1 DX)) (b2 (wcoords! w2 D2 DY))
                       (env (append envb (list b1 b2)))
                       (R0 (ao-cross! (list '- q u) (list '- p u) env)))
                  (define (step-eq! v b sign)       ; cr(q - v, p - v) = G0 -/+ SN
                    (let* ((Rv (ao-cross! (list '- q v) (list '- p v) env))
                           (rhs (list sign G0 snv)))
                      (dk-have! (list '= (ao-cr (list '- q v) (list '- p v)) rhs)
                        (lambda ()
                          (subst (list '= snv SN))
                          (subst (list '= (ao-cr (list '- q v) (list '- p v)) Rv))
                          (subst (list '= G0 R0))
                          (subst (list '= (list '* M M) (caddr msq)))
                          (subst (list '= (list 'real-part D1) (car DX))) (subst (list '= (list 'imag-part D1) (cdr DX)))
                          (subst (list '= (cadr b) (list '- (cdr (if (eq? sign '-) DX DY)))))
                          (subst (list '= (cddr b) (car (if (eq? sign '-) DX DY))))
                          (crs)))
                      rhs))
                  (let* ((E1 (step-eq! v1 b1 '-)) (E2 (step-eq! v2 b2 '+))
                         (h1 (an-pick "hull at v1" (lambda (f) (and (ao-op? f '= 3) (equal? (caddr f) (list '* t1 k))))))
                         (h2 (an-pick "hull at v2" (lambda (f) (and (ao-op? f '= 3) (equal? (caddr f) (list '* t2 k)))))))
                    (dk-rewrite-h! h1 (cadr h1) E1)
                    (dk-rewrite-h! h2 (cadr h2) E2)
                    (let ((F1 (list '= E1 (list '* t1 k))) (F2 (list '= E2 (list '* t2 k)))
                          (kG (list '* k G0)))
                      (an-rr! kG)
                      (fact 'rr-sq-nonneg k)
                      (an-rr! (list '* k k))
                      (define kk (dk-name! (list '* k k) 'RR))
                      (dk-rewrite-h! (list '<= 0 (list '* k k)) (list '* k k) kk)
                      (an-rr! (list '* k snv))
                      (define ksn (dk-name! (list '* k snv) 'RR))
                      (define (via! F t sgn)       ; k G0 = t kk +/- ksn
                        (let ((rhs (list sgn (list '* t kk) ksn)))
                          (dk-have! (list '= kG rhs)
                            (lambda ()
                              (let ((c (list '= kG (list sgn (list '* k (cadr F)) (list '* k snv)))))
                                (dk-have! c (lambda () (crs)))
                                (let ((h2 (dk-rewrite-h! c (cadr F) (caddr F))))
                                  (subst h2) (subst (list '= ksn (list '* k snv))) (subst (list '= kk (list '* k k))) (crs)))))
                          rhs))
                      (for-each (lambda (t)
                                  (an-and! (list 'IN t 'RR) (list 'IN kk 'RR))
                                  (an-and! (list '<= 0 t) (list '<= 0 kk))
                                  (fact 'rr-leq-mul-nonneg t kk)
                                  (an-rr! (list '* t kk)))
                                (list t1 t2))
                      (use-em (list '= k 0)
                        (lambda ()
                          (dk-have! (list '= (list '* t1 k) 0) (lambda () (subst (list '= k 0)) (crs)))
                          (dk-have! (list '= (list '* t2 k) 0) (lambda () (subst (list '= k 0)) (crs)))
(let* ((z1 (dk-rewrite-h! F1 (list '* t1 k) 0)) (z2 (dk-rewrite-h! F2 (list '* t2 k) 0)))
                            (dk-absurd! z1 z2 (list '< 0 snv))))
                        (lambda ()
                          (fact 'rr-le-total k 0)
                          (use-cases (list (list '<= k 0) (list '<= 0 k))
                            (lambda ()
                              (an-lt-of-le-ne! k 0)
                              (an-rr! (list '- k))
                              (dk-have! (list '< 0 (list '- k)) (lambda () (dk-ineq! (list '< k 0))))
                              (fact 'rr-mul-pos (list '- k) snv)
                              (dk-have! (list '= (list '* (list '- k) snv) (list '- ksn)) (lambda () (subst (list '= ksn (list '* k snv))) (crs)))
                              (dk-rewrite-h! (list '< 0 (list '* (list '- k) snv)) (list '* (list '- k) snv) (list '- ksn))
                              (let ((e (via! F2 t2 '-)))
                                (dk-ineq! (list '= kG e) (list '<= 0 (list '* t2 kk)) (list '< 0 (list '- ksn)))))
                            (lambda ()
                              (an-lt-of-le-ne! 0 k)
                              (fact 'rr-mul-pos k snv)
                              (dk-rewrite-h! (list '< 0 (list '* k snv)) (list '* k snv) ksn)
                              (let ((e (via! F1 t1 '+)))
                                (dk-ineq! (list '= kG e) (list '<= 0 (list '* t1 kk)) (list '< 0 ksn))))))))))))))))))
(qed 'interior-cross-sign)

;;; ---------------------------------------------------------------------------
;;; the angle at an interior point: ANGLE(q - u, p - u) < pi iff k > 0
(define (ao-not-lt! a b prems)
  (let ((g (list 'NOT (list '< a b))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (di) (apply dk-absurd! (cons (list '< a b) prems)))))))
(define (ao-sign! x)                          ; x in RR, NOT (= x 0) in context: lands x < 0 or 0 < x, by cases
  (fact 'rr-le-total x 0))
(sp (make-wff (forall-guarded '(aop_ aoq_ aok_) '((IN aop_ CC) (IN aoq_ CC) (IN aok_ RR))
  (list 'FORALL 'aoss_
   (list 'IMPLIES (list 'FORALL 'aoz_ (list 'IMPLIES '(IN aoz_ aoss_) (ao-wt-claim 'aot_ (ao-cr '(- aoq_ aoz_) '(- aop_ aoz_)) 'aok_)))
   (list 'IMPLIES '(NOT (= aop_ aoq_))
   (list 'FORALL 'aou_ (list 'IMPLIES '(IN aou_ (INTERIOR CC-MS aoss_))
     '(IFF (< (ANGLE (- aoq_ aou_) (- aop_ aou_)) PI) (< 0 aok_))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (k 'aok_) (u 'aou_) (SS 'aoss_)
       (zu (list '- q u)) (wu (list '- p u))
       (X (list '* zu (list 'conjugate wu))) (C (list 'imag-part X))
       (kc (list '* k C)))
  (dk-cite! 'interior-cross-sign p q k SS u)
  (dk-split-all! (dk-landed* (lambda () (mac-h 'interior-membership (list 'IN u (list 'INTERIOR 'CC-MS SS))))))
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-have! (list 'IN u 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
  (an-cc! zu) (an-cc! wu) (fact 'cc-conjugate-closed wu) (an-cc! X)
  (fact 'imag-part-in-rr X)
  (an-rr! kc)
  ;; C /= 0, hence q - u /= 0 and p - u /= 0
  (dk-have! (list 'NOT (list '= C 0))
    (lambda () (di) (dk-have! (list '= kc 0) (lambda () (subst (list '= C 0)) (crs)))
               (dk-absurd! (list '= kc 0) (list '< 0 kc))))
  (fact 'rr-zero-in) (fact 'rr-subset-cc 0)
  (fact 'cc-conjugate-fixes-rr 0)
  (dk-cite! 'cc-im-zero)
  (dk-have! (list 'NOT (list '= zu 0))
    (lambda () (di) (dk-have! (list '= C 0) (lambda () (subst (list '= zu 0)) (dk-have! (list '= (list '* 0 (list 'conjugate wu)) 0) (lambda () (crs)))
                                                 (subst (list '= (list '* 0 (list 'conjugate wu)) 0)) (ass)))
               (ai (list 'NOT (list '= C 0)))))
  (dk-have! (list 'NOT (list '= wu 0))
    (lambda () (di) (dk-have! (list '= C 0) (lambda () (subst (list '= wu 0)) (subst '(= (conjugate 0) 0))
                                                 (dk-have! (list '= (list '* zu 0) 0) (lambda () (crs)))
                                                 (subst (list '= (list '* zu 0) 0)) (ass)))
               (ai (list 'NOT (list '= C 0)))))
  (dk-split-all! (list (dk-cite! 'angle-lt-pi-iff zu wu)))
  (let ((A (list '< (list 'ANGLE zu wu) 'PI)) (iff (an-pick "the angle test" (lambda (f) (ao-op? f 'IFF 3)))))
    (define (close-pos!)                        ; 0 < k and 0 < C
      (if (dk-only! iff (list '< 0 C) (list '< 0 k)) (prop)))
    (define (close-neg!)                        ; k < 0 and C < 0
      (ao-not-lt! 0 C (list (list '< C 0)))
      (ao-not-lt! 0 k (list (list '< k 0)))
      (if (dk-only! iff (list 'NOT (list '< 0 C)) (list 'NOT (list '= C 0)) (list 'NOT (list '< 0 k))) (prop)))
    (define (neg-of! aoo-xp)                         ; lands 0 < -x from x < 0
      (an-rr! (list '- aoo-xp))
      (dk-have! (list '< 0 (list '- aoo-xp)) (lambda () (dk-ineq! (list '< aoo-xp 0)))))
    (define (clash! aoo-ap b)                        ; 0 < a * b, with a * b = -(k C): absurd
      (fact 'rr-mul-pos aoo-ap b)
      (an-rr! (list '* aoo-ap b))
      (dk-have! (list '= (list '* aoo-ap b) (list '- kc)) (lambda () (crs)))
      (dk-absurd! (list '< 0 (list '* aoo-ap b)) (list '= (list '* aoo-ap b) (list '- kc)) (list '< 0 kc)))
    (dk-have! (list 'NOT (list '= k 0))
      (lambda () (di) (dk-have! (list '= kc 0) (lambda () (subst (list '= k 0)) (crs)))
                 (dk-absurd! (list '= kc 0) (list '< 0 kc))))
    (fact 'rr-le-total C 0)
    (use-cases (list (list '<= C 0) (list '<= 0 C))
      (lambda ()
        (an-lt-of-le-ne! C 0)
        (fact 'rr-le-total k 0)
        (use-cases (list (list '<= k 0) (list '<= 0 k))
          (lambda () (an-lt-of-le-ne! k 0) (close-neg!))
          (lambda () (an-lt-of-le-ne! 0 k) (neg-of! C) (clash! k (list '- C)))))
      (lambda ()
        (an-lt-of-le-ne! 0 C)
        (fact 'rr-le-total k 0)
        (use-cases (list (list '<= k 0) (list '<= 0 k))
          (lambda () (an-lt-of-le-ne! k 0) (neg-of! k) (clash! (list '- k) C))
          (lambda () (an-lt-of-le-ne! 0 k) (close-pos!)))))))
(qed 'interior-angle-sign)

;;; ---------------------------------------------------------------------------
;;; LEMMA 1.14: the triangle a b c is positively oriented iff the three angles are < pi at ONE
;;; interior point.  Guards: the vertices are distinct (the notes' triangular path) and the
;;; interior is nonempty (a degenerate triangle is vacuously positively oriented).
(define ao-int '(INTERIOR CC-MS (CONV3 aoa_ aob_ aoc_)))
(define (ao-angles u)
  (list (list '< (list 'ANGLE (list '- 'aob_ u) (list '- 'aoa_ u)) 'PI)
        (list '< (list 'ANGLE (list '- 'aoc_ u) (list '- 'aob_ u)) 'PI)
        (list '< (list 'ANGLE (list '- 'aoa_ u) (list '- 'aoc_ u)) 'PI)))
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC))
  (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
  (list 'IMPLIES (list 'FORSOME 'aov_ (list 'IN 'aov_ ao-int))
    (list 'IFF '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
      (list 'FORSOME 'aou_ (list 'AND (list 'IN 'aou_ ao-int)
        (let ((l (ao-angles 'aou_))) (list 'AND (car l) (list 'AND (cadr l) (caddr l))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (T3 (list 'CONV3 a b c))
       (pairs (list (list b a) (list c b) (list a c)))    ; (q p): the angle ANGLE(q - u, p - u)
       (ks (map (lambda (qp) (let ((q (car qp)) (p (cadr qp)) (r (car (filter (lambda (x) (not (memq x qp))) (list a b c)))))
                               (ao-cr (list '- q r) (list '- p r))))
                pairs))
       (W (dk-cite! 'conv3-cross-weights a b c))
       (US
        (map (lambda (qp k)
               (let* ((q (car qp)) (p (cadr qp))
                      (Hi (list 'FORALL 'aoz_ (list 'IMPLIES (list 'IN 'aoz_ T3) (ao-wt-claim 'aot_ (ao-cr (list '- q 'aoz_) (list '- p 'aoz_)) k)))))
                 (an-cc! (cadr k)) (fact 'imag-part-in-rr (cadr k))
                 (dk-have! Hi (lambda ()
                                (let* ((z (cadr (find-first (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) T3)))
                                                            (dk-landed (lambda () (di))))))
                                       (cj (dk-apply! W z)))
                                  (dk-split-all! (list cj))
                                  (ass))))
                 (dk-cite! 'interior-angle-sign p q k T3)))
             pairs ks)))
  ;; at a given interior point, each angle < pi iff its k > 0
  (define (at! u)
    (for-each (lambda (uf) (dk-apply! uf u)) US))
  (define (iffs-at u) (map (lambda (aoo-aset k) (list 'IFF aoo-aset (list '< 0 k))) (ao-angles u) ks))
  (let ((I1 (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_) (caddr (dk-goal))))
        (I2 (list 'IMPLIES (caddr (dk-goal)) '(POSITIVELY-ORIENTED aoa_ aob_ aoc_))))
    (dk-have! I1
      (lambda ()
        (di)
        (let* ((v (dk-skolem! (an-pick "nonempty" (lambda (f) (and (ao-op? f 'FORSOME 3) (eq? (cadr f) 'aov_)))))))
          (mac-h 'POSITIVELY-ORIENTED '(POSITIVELY-ORIENTED aoa_ aob_ aoc_))
          (dk-split-all! (list (dk-apply! (an-pick "the orientation" (lambda (f) (ao-op? f 'FORALL 3))) v)))
          (ew v)
          (dk-conj-close! (lambda () (ass))))))
    (dk-have! I2
      (lambda ()
        (di)
        (let* ((u0 (dk-skolem! (an-pick "the point" (lambda (f) (and (ao-op? f 'FORSOME 3) (eq? (cadr f) 'aou_)))) #t)))
          (dk-split-all!)
          (at! u0)
          (for-each (lambda (iff k)
                      (let ((pos (list '< 0 k)))
                        (dk-have! pos (lambda () (if (dk-only! iff (cadr iff)) (prop))))))
                    (iffs-at u0) ks)
          (mac 'POSITIVELY-ORIENTED)
          (let* ((new (dk-landed (lambda () (di))))
                 (mem (find-first (lambda (f) (and (ao-op? f 'IN 3) (equal? (caddr f) ao-int))) new))
                 (u (cadr mem)))
            (at! u)
            (let ((iffs (iffs-at u)))
              (dk-conj-close!
                (lambda ()
                  (let ((iff (find-first (lambda (f) (equal? (cadr f) (dk-goal))) iffs)))
                    (if (not iff) (error "positively-oriented-iff: no angle test for" (dk-goal)))
                    (if (dk-only! iff (caddr iff)) (prop))))))))))
    (if (dk-only! I1 I2) (prop))))
(qed 'positively-oriented-iff)
