  (fact 'eapp-in-expr 'h r)
  (subst (dk-cite! 'open-eapp 'u 'k 'h l))
  (let* ((fu (dk-cite! 'open-fun-unfold 'u))
         (lam (caddr fu)))
    (subst fu)
    (let* ((l2 (dk-meta-maplk! lam l 'k 'EXPR-SET 'EXPR-SET
                 (lambda (i) (dk-lam-b!) (fact 'open-in-expr 'u 'k `(NTH ,i ,l)) (ass))))
           (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l2)))) (dk-asms)))
           (len `(= (LENGTH ,l2) (LENGTH ,l)))
           (hyp `(FORALL mrk_ (IMPLIES (AND (IN mrk_ NN) (AND (<= 1 mrk_) (<= mrk_ (LENGTH ,l2))))
                                       (= (NTH mrk_ ,l2) (NTH mrk_ ,r))))))
      (dk-have! `(= (LENGTH ,l2) (LENGTH ,r)) (lambda () (subst len) (len-r) (rfl)))
      (dk-have! `(= (LENGTH ,l) 2) (lambda () (len-r) (rfl)))
      (dk-have! hyp
        (lambda ()
          (dk-peel!)
          (let* ((i (cadr (cadr (dk-goal))))
