       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
       (vs (dk-meta-unpack! ex))
       (g (car vs)) (c (cadr vs)) (a (caddr vs)) (b (cadddr vs)) (e (car (cddddr vs)))
       (o (find-first (lambda (f) (dk-head-is? f 'OR)) (dk-asms))))
  (dk-meta-or-each! o
    (lambda (d)
