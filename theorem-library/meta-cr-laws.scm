(sp (make-wff (mr-st '(u k h a b) '(IN u EXPR-SET) '(IN k NN) '(IN h NN) '(IN a EXPR-SET) '(IN b EXPR-SET)
                '(= (EXPR-OPEN (EAPP h (LIST a b)) k u) (EAPP h (LIST (EXPR-OPEN a k u) (EXPR-OPEN b k u)))))))
(dk-peel!)
(let* ((l '(LIST a b)) (oa '(EXPR-OPEN a k u)) (ob '(EXPR-OPEN b k u)) (r `(LIST ,oa ,ob)))
  (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
