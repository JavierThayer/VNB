  (dk-cite! 'ctx-add-has g b)
  (dk-cite! 'ctx-sub-cons `(DIFFERENCE ,g (PAIR ,a ,a)) gb b)
  (mr-clf! gb 'CTX-SET)
  (dk-meta-seq! gb f)
  (dk-cite! 'derivable-weakening-c 'tt gb f gd)
  (dk-cite! 'derivable-cut-c 'tt g f b)
