        (dk-cite! (if (= kk 1) 'eqv-t-intro 'eqv-f-intro) 'tt g `(EXPR-OPEN ,a 0 ,e) `(EXPR-OPEN ,b 0 ,e))
        (ass)))))
(qed 'j-mac-sub)

;; THE ADMISSIBILITY THEOREMS, at one position.
(define (mr-adm! rel j jsub generic)
  (sp (make-wff `(FORALL tt (FORALL hs (FORALL c (IMPLIES (,rel tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
  (dk-peel!)
