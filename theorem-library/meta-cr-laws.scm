;;; meta-cr-laws.scm -- CONTEXTUAL REWRITING (CR) as an admissibility theorem over the encoded core,
;;; and the admissibility of the rewriting rules at one position (structure-library/meta-cr.scm).
;;; (docs/meta-k2-admissibility-2026-10-08.md, section 6, phase 3.)
;;; Agent META-3, 2026-10-09.  Builds on theorem-library/meta-syntax-laws.scm and meta-core-laws.scm,
;;; which it does not edit; the shared helpers (dk-meta-*, dk-derive!) are in driver-kit.scm, section
;;; META, and dk-meta-derive! in scratchpad/meta3/driver-kit-meta3.scm (to be spliced there).  The
;;; helpers defined below are local to this file (prefix mr-).
;;; Sections: A the universe, EQV, REWR; B the derivation templates and the clause driver; C-E, G, H
;;; the clause laws of stages 1 (connectives, atoms), 2 (quantifiers), 3 (IF), 4 (term heads), 5
;;; (binder domains); F the CR theorems cr-closed-k / cr-k / cr-goal-k (k = 1 .. 5, each after its
;;; stage); I the rewriting rules (nth-reduce, length-reduce, lambda-beta, lambda-beta-hyp, macete,
;;; macete-hyp) at one position.  The body clauses of stages 6 and 7 have no law: see
;;; scratchpad/triage/META-3-REPORT.md, section 3.
;;; Every theorem below bills `modulo 0'.

;;; -----------------------------------------------------------------------
;;; A. The universe of rewrite tuples is a set; the unfold equations; EQV opened and closed.

(define (mr-set! t)                      ; (IN t SET) for NN, the meta classes and binary/4-ary CARTESIAN of them
  (let ((goal `(IN ,t SET)))
    (cond
      ((dk-asm? goal) goal)
      ((eq? t 'NN) (fact 'nn-is-set) goal)
      ((eq? t 'EXPR-SET) (fact 'expr-set-is-set) goal)
      ((eq? t 'CLF) (fact 'clf-is-set) goal)
      ((eq? t 'CTX-SET)
       (dk-have! '(IN CTX-SET SET) (lambda () (subst (dk-cite! 'ctx-def)) (fact 'clf-is-set) (fact 'power-set 'CLF) (sep-set) (ass)))
       goal)
      ((and (pair? t) (eq? (car t) 'CARTESIAN) (= (length t) 3))
       (mr-set! (cadr t)) (mr-set! (caddr t))
       (let ((iff (dk-meta-iff! 'cartesian-set-iff (cadr t) (caddr t))))
         (dk-meta-and! `(IN ,(cadr t) SET) `(IN ,(caddr t) SET))
         (dk-meta-iff-l! iff))
       goal)
      (#t (error "mr-set!: no route" t)))))

(define mr-phi4
  '(VNB-LAMBDA mrq_ (CARTESIAN mra1_ (CARTESIAN mra2_ (CARTESIAN mra3_ mra4_)))
     (LIST (NTH 1 mrq_) (NTH 1 (NTH 2 mrq_)) (NTH 1 (NTH 2 (NTH 2 mrq_))) (NTH 2 (NTH 2 (NTH 2 mrq_))))))

(sp (make-wff '(FORALL mra1_ (FORALL mra2_ (FORALL mra3_ (FORALL mra4_
   (IMPLIES (IN mra1_ SET) (IMPLIES (IN mra2_ SET) (IMPLIES (IN mra3_ SET) (IMPLIES (IN mra4_ SET)
     (IN (CARTESIAN mra1_ mra2_ mra3_ mra4_) SET)))))))))))
(dk-peel!)
(let* ((p34 '(CARTESIAN mra3_ mra4_))
       (p234 `(CARTESIAN mra2_ ,p34))
       (ww `(CARTESIAN mra1_ ,p234))
       (img `(IMAGE ,mr-phi4 ,ww))
       (sub `(SUBSET (CARTESIAN mra1_ mra2_ mra3_ mra4_) ,img)))
  (mr-set! ww)
  (fact 'image-set mr-phi4 ww)
  (dk-have! sub
    (lambda ()
      (mac 'subset-def)
      (di)
      (let* ((x (cadr (dk-goal)))
             (vs (dk-meta-unpack! (dk-meta-cart-open! `(IN ,x (CARTESIAN mra1_ mra2_ mra3_ mra4_)))))
             (a1 (car vs)) (a2 (cadr vs)) (a3 (caddr vs)) (a4 (cadddr vs))
             (q34 `(LIST ,a3 ,a4)) (q234 `(LIST ,a2 ,q34))
             (pr `(LIST ,a1 ,q234)))
        (dk-image-goal!)
        (ew pr)
        (fact 'pair-in-cartesian 'mra3_ 'mra4_ a3 a4)
        (fact 'pair-in-cartesian 'mra2_ p34 a2 q34)
        (fact 'pair-in-cartesian 'mra1_ p234 a1 q234)
        (dk-each-leaf! (lambda () (di))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (ass)
                (begin
                  (dk-lam-b!)
                  (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
                  (subst (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) x))) (dk-asms)))
                  (rfl))))))))
  (fact 'subclass-of-set-is-set '(CARTESIAN mra1_ mra2_ mra3_ mra4_) img)
  (ass))
(qed 'cartesian4-set)

(sp (make-wff '(IN RW-UNIV SET)))
(subst (dk-cite! 'rw-univ-def))
(for-each mr-set! '(NN CTX-SET EXPR-SET))
(fact 'cartesian4-set 'NN 'CTX-SET 'EXPR-SET 'EXPR-SET)
(ass)
(qed 'rw-univ-is-set)

;; The functoids EQV and REWR as citable equations (mac-h cannot unfold a functoid by its name).
(sp (make-wff '(FORALL mrt_ (== (EQV mrt_) (SEP mrx_ RW-UNIV (EQV-OK mrt_ mrx_))))))
(di) (mac 'eqv) (qrfl)
(qed 'eqv-unfold)
(sp (make-wff '(FORALL mrt_ (FORALL mrk_ (== (REWR mrt_ mrk_)
   (SEP mrx_ RW-UNIV (FORALL mrs_ (IMPLIES (IN mrs_ (POWER RW-UNIV)) (IMPLIES (RW-CLOSED mrt_ mrk_ mrs_) (IN mrx_ mrs_))))))))))
(di) (mac 'rewr) (qrfl)
(qed 'rewr-unfold)

;; EQV is a subset of the universe and a set: a member of POWER(RW-UNIV).
(sp (make-wff '(FORALL tt (IN (EQV tt) (POWER RW-UNIV)))))
(di)
(let ((s '(EQV tt)))
  (fact 'rw-univ-is-set)
  (dk-have! `(IN ,s SET) (lambda () (subst (dk-cite! 'eqv-unfold 'tt)) (sep-set) (ass)))
  (let ((iff (dk-meta-iff! 'power-set-membership 'RW-UNIV s)))
    (dk-have! `(FORALL mrz_ (IMPLIES (IN mrz_ ,s) (IN mrz_ RW-UNIV)))
      (lambda ()
        (dk-peel!)
        (let ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) s))) (dk-asms))))
          (sep-me (dk-rewrite-h! m s (caddr (dk-cite! 'eqv-unfold 'tt))))
          (ass))))
    (dk-meta-and! `(IN ,s SET) `(FORALL mrz_ (IMPLIES (IN mrz_ ,s) (IN mrz_ RW-UNIV))))
    (dk-meta-iff-l! iff)
    (ass)))
(qed 'eqv-in-power)

;; REWR is below every closed member of POWER(RW-UNIV).
(sp (make-wff '(FORALL tt (FORALL k (FORALL mrzS_ (IMPLIES (IN mrzS_ (POWER RW-UNIV)) (IMPLIES (RW-CLOSED tt k mrzS_)
   (FORALL x (IMPLIES (IN x (REWR tt k)) (IN x mrzS_))))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'REWR))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(REWR tt k) (caddr (dk-cite! 'rewr-unfold 'tt 'k)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mrzS_)
  (ass))
(qed 'rewr-least)

;; The two kinds of member of EQV, opened and introduced.
(define (mr-eqv-open-law! kk cls rel)
  (sp (make-wff `(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST ,kk g a b) (EQV tt))
     (AND (IN a ,cls) (AND (IN b ,cls) (IN (LIST g (,rel a b)) (DERIVABLE tt)))))))))))
  (dk-peel!)
  (let* ((m `(IN (LIST ,kk g a b) (EQV tt)))
         (m2 (dk-rewrite-h! m '(EQV tt) (caddr (dk-cite! 'eqv-unfold 'tt))))
         (landed (dk-landed (lambda () (sep-me m2))))
         (ok (find-first (lambda (f) (dk-head-is? f 'EQV-OK)) landed))
         (ex (dk-landed-1 (lambda () (mac-h 'eqv-ok ok))))
         (vs (dk-meta-unpack! ex))
         (o (find-first (lambda (f) (dk-head-is? f 'OR)) (dk-asms))))
    (dk-meta-or-each! o
      (lambda (d)
        (let* ((parts (dk-split! d))
               (eqn (find-first (lambda (f) (dk-head-is? f '=)) parts))
               (l1 (cadr eqn)) (l2 (caddr eqn)))
          (if (not (equal? (cadr l1) (cadr l2)))
              (dk-meta-tag-absurd! l1 l2)
              (begin
                (dk-have! `(= g ,(caddr l2)) (lambda () (dk-meta-component! l1 l2 2)))
                (dk-have! `(= a ,(cadddr l2)) (lambda () (dk-meta-component! l1 l2 3)))
                (dk-have! `(= b ,(car (cddddr l2))) (lambda () (dk-meta-component! l1 l2 4)))
                (subst `(= g ,(caddr l2))) (subst `(= a ,(cadddr l2))) (subst `(= b ,(car (cddddr l2))))
                (dk-conj-close! (lambda () (ass))))))))))

(mr-eqv-open-law! 2 'CLF 'ENC-IFF)
(qed 'eqv-f-open)
(mr-eqv-open-law! 1 'CLT 'ENC-QEQ)
(qed 'eqv-t-open)

(define (mr-eqv-intro-law! kk cls rel)
  (sp (make-wff `(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN a ,cls) (IMPLIES (IN b ,cls)
     (IMPLIES (IN (LIST g (,rel a b)) (DERIVABLE tt)) (IN (LIST ,kk g a b) (EQV tt)))))))))))
  (dk-peel!)
  (dk-cite! 'der-in-seq 'tt `(LIST g (,rel a b)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g `(,rel a b))))
  (for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) v)))) '(a b))
  (subst (dk-cite! 'eqv-unfold 'tt))
  (in-sep!
    (lambda ()
      (subst (dk-cite! 'rw-univ-def))
      (dk-have! `(IN ,kk NN) (lambda () (arith)))
      (dk-meta-close-in!))
    (lambda ()
      (mac 'eqv-ok)
      (ew 'g) (ew 'a) (ew 'b)
      (if (= kk 2) (oi-l) (oi-r))
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass)))))))

(mr-eqv-intro-law! 2 'CLF 'ENC-IFF)
(qed 'eqv-f-intro)
(mr-eqv-intro-law! 1 'CLT 'ENC-QEQ)
(qed 'eqv-t-intro)

;; The context of a rewrite tuple is a context.
(sp (make-wff '(FORALL kk (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST kk g a b) RW-UNIV) (IN g CTX-SET))))))))
(dk-peel!)
(let* ((m '(IN (LIST kk g a b) RW-UNIV))
       (m2 (dk-rewrite-h! m 'RW-UNIV (caddr (dk-cite! 'rw-univ-def))))
       (vs (dk-meta-unpack! (dk-meta-cart-open! m2)))
       (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '(LIST kk g a b)))) (dk-asms))))
  (dk-have! `(= g ,(cadr vs)) (lambda () (dk-meta-component! (cadr eqn) (caddr eqn) 2)))
  (subst `(= g ,(cadr vs)))
  (ass))
(qed 'rw-univ-ctx)

;;; -----------------------------------------------------------------------
;;; B. Derivation templates (dk-derive! trees) and the generic driver of a clause's EQV law.
;;; A tree node is (RULE (G ==> F) ...) (driver-kit.scm, section META, dk-derive!).

(define (mr-seqf t) (caddr (cadr t)))                     ; the formula a tree concludes
(define (mr-asm g f) `(assumption (,g ==> ,f)))
(define (mr-given g f) `(given (,g ==> ,f)))
(define (mr-wk g t) `(weakening (,g ==> ,(mr-seqf t)) ,t))
(define (mr+ g . fs) (fold-left (lambda (g f) `(CTX-ADD ,g ,f)) g fs))
;; (g ==> b) from trees for (g ==> a IFF b) and (g ==> a); (g ==> a) from (g ==> a IFF b) and (g ==> b):
;; the four-node expansions (mr-iffr0 / mr-iffl0), which prove the two derived rules der-iff-r /
;; der-iff-l below, and the lemma nodes every later tree uses (dk-meta-derive!, driver-kit-meta3.scm).
(define (mr-iffr0 g a b t-iff t-a)
  (let* ((i `(ENC-IFF ,a ,b)) (g1 (mr+ g i)) (g3 (mr+ g1 `(ENC-IMP ,a ,b) `(ENC-IMP ,b ,a))))
    `(cut (,g ==> ,b) ,t-iff (iff-elim (,g1 ==> ,b) (backchain (,g3 ==> ,b) ,(mr-wk g3 t-a))))))
(define (mr-iffl0 g a b t-iff t-b)
  (let* ((i `(ENC-IFF ,a ,b)) (g1 (mr+ g i)) (g3 (mr+ g1 `(ENC-IMP ,a ,b) `(ENC-IMP ,b ,a))))
    `(cut (,g ==> ,a) ,t-iff (iff-elim (,g1 ==> ,a) (backchain (,g3 ==> ,a) ,(mr-wk g3 t-b))))))

(define (mr-clf! e cls)                   ; type E in CLS (CLF / CLT) by the dk-derive! planner
  (if (not (dk-asm? `(IN ,e ,cls)))
      (let ((p (dk-meta--plan-wf e cls '())))
        (if (not p) (error "mr-clf!: cannot type" (expression->string e) cls))
        (p))))

(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST g (ENC-IFF a b)) (DERIVABLE tt))
   (IMPLIES (IN (LIST g a) (DERIVABLE tt)) (IN (LIST g b) (DERIVABLE tt))))))))))
(dk-peel!)
(dk-cite! 'der-in-seq 'tt '(LIST g (ENC-IFF a b)))
(dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g '(ENC-IFF a b))))
(dk-derive! 'tt (mr-iffr0 'g 'a 'b (mr-given 'g '(ENC-IFF a b)) (mr-given 'g 'a)))
(ass)
(qed 'der-iff-r)
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (IMPLIES (IN (LIST g (ENC-IFF a b)) (DERIVABLE tt))
   (IMPLIES (IN (LIST g b) (DERIVABLE tt)) (IN (LIST g a) (DERIVABLE tt))))))))))
(dk-peel!)
(dk-cite! 'der-in-seq 'tt '(LIST g (ENC-IFF a b)))
(dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g '(ENC-IFF a b))))
(dk-derive! 'tt (mr-iffl0 'g 'a 'b (mr-given 'g '(ENC-IFF a b)) (mr-given 'g 'b)))
(ass)
(qed 'der-iff-l)
(define (mr-iffr g a b t-iff t-a) `(lemma (,g ==> ,b) der-iff-r (,g ,a ,b) ,t-iff ,t-a))
(define (mr-iffl g a b t-iff t-b) `(lemma (,g ==> ,a) der-iff-l (,g ,a ,b) ,t-iff ,t-b))

;; THE GENERIC DRIVER.  The goal: (FORALL jj (FORALL tt (FORALL x (IMPLIES (NAME jj (EQV tt) x)
;;   (IMPLIES (IN x RW-UNIV) (IN x (EQV tt))))))), jj the justification set (unused by every clause
;;   but TOP).  SPEC maps the clause's witnesses (in the order of
;; its FORSOME chain) to (LIT PREMS PROVE): LIT the conclusion tuple (LIST kk g e f), PREMS the
;; premise tuples (kk g a b) in EQV, PROVE a dk-derive! tree for the conclusion's derivability or a
;; thunk that lands it.  A clause with a cofinite premise passes PREMS = '() and opens it in PROVE.
(define (mr-open-prem! p)                 ; (kk g a b) in EQV in context: land the typings and the derivability
  (let ((kk (car p)) (g (cadr p)) (a (caddr p)) (b (cadddr p)))
    (dk-split! (dk-cite! (if (= kk 2) 'eqv-f-open 'eqv-t-open) 'tt g a b))
    (dk-cite! 'der-in-seq 'tt `(LIST ,g (,(if (= kk 2) 'ENC-IFF 'ENC-QEQ) ,a ,b)))))
(define (mr-eqv-clause! name spec)
  (sp (make-wff `(FORALL jj (FORALL tt (FORALL x (IMPLIES (,name jj (EQV tt) x) (IMPLIES (IN x RW-UNIV) (IN x (EQV tt)))))))))
  (dk-peel!)
  (let* ((h `(,name jj (EQV tt) x))
         (ex (dk-landed-1 (lambda () (mac-h name h))))
         (vs (dk-meta-unpack! ex))
         (body (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f 'x))) (dk-asms))))
    (if body (dk-split! body))
    (call-with-values (lambda () (spec vs))
      (lambda (lit prems prove)
        (let* ((kk (cadr lit)) (g (caddr lit)) (e (cadddr lit)) (f (car (cddddr lit)))
               (cls (if (= kk 2) 'CLF 'CLT)) (rel (if (= kk 2) 'ENC-IFF 'ENC-QEQ)))
          (if (not (dk-asm? `(= x ,lit))) (error "mr-eqv-clause!: the conclusion tuple is not" (expression->string lit)))
          (if (not (dk-asm? `(IN ,g CTX-SET)))
              (begin (dk-rewrite-h! '(IN x RW-UNIV) 'x lit)
                     (dk-cite! 'rw-univ-ctx kk g e f)))
          (for-each (lambda (p)
                      (if (not (dk-asm? `(IN (LIST ,@p) (EQV tt))))
                          (error "mr-eqv-clause!: premise not in context" (expression->string `(LIST ,@p))))
                      (mr-open-prem! p))
                    prems)
          (if (procedure? prove) (prove) (dk-meta-derive! 'tt prove))
          (if (not (dk-asm? `(IN (LIST ,g (,rel ,e ,f)) (DERIVABLE tt))))
              (error "mr-eqv-clause!: the derivability did not land" name))
          (mr-clf! e cls) (mr-clf! f cls)
          (subst `(= x ,lit))
          (dk-cite! (if (= kk 2) 'eqv-f-intro 'eqv-t-intro) 'tt g e f)
          (ass))))))

;;; -----------------------------------------------------------------------
;;; C. STAGE 1 (the brief's (a)): TOP, the connectives (and, below, the atoms).

(sp (make-wff '(FORALL jj (FORALL tt (FORALL x (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (RW-TOP jj (EQV tt) x)
   (IMPLIES (IN x RW-UNIV) (IN x (EQV tt))))))))))
(dk-peel!)
(mac-h 'rw-top '(RW-TOP jj (EQV tt) x))
(dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'subset-def 'jj '(EQV tt))) 'x)
(ass)
(qed 'eqv-top)

(mr-eqv-clause! 'RW-NOT
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs))
           (P (mr-given g `(ENC-IFF ,a ,b)))
           (na `(ENC-NOT ,a)) (nb `(ENC-NOT ,b))
           (g1 (mr+ g na)) (g11 (mr+ g1 b)) (g2 (mr+ g nb)) (g22 (mr+ g2 a)))
      (values `(LIST 2 ,g ,na ,nb) (list (list 2 g a b))
        `(iff-intro (,g ==> (ENC-IFF ,na ,nb))
           (not-intro (,g1 ==> ,nb)
             (cut (,g11 ==> ENC-FALSITY) ,(mr-iffl g11 a b (mr-wk g11 P) (mr-asm g11 b))
               (not-elim (,(mr+ g11 a) ==> ENC-FALSITY) (a := ,a))))
           (not-intro (,g2 ==> ,na)
             (cut (,g22 ==> ENC-FALSITY) ,(mr-iffr g22 a b (mr-wk g22 P) (mr-asm g22 a))
               (not-elim (,(mr+ g22 b) ==> ENC-FALSITY) (a := ,b)))))))))
(qed 'eqv-not)

;; AND-L / AND-R: (x op c) against (y op c), c the side kept, P the premise in the context extended by c.
(define (mr-and-dir g x y c left? P conv)  ; (g + (x&c) ==> y&c); CONV: g3 -> tree (g3 ==> y) from x in g3
  (let* ((xc (if left? `(ENC-AND ,x ,c) `(ENC-AND ,c ,x))) (yc (if left? `(ENC-AND ,y ,c) `(ENC-AND ,c ,y)))
         (g1 (mr+ g xc)) (g3 (if left? (mr+ g1 x c) (mr+ g1 c x))))
    `(and-elim (,g1 ==> ,yc)
       (and-intro (,g3 ==> ,yc) ,@(if left? (list (conv g3) (mr-asm g3 c)) (list (mr-asm g3 c) (conv g3)))))))
(define (mr-and-spec left?)
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given (mr+ g c) `(ENC-IFF ,a ,b)))
           (ac (if left? `(ENC-AND ,a ,c) `(ENC-AND ,c ,a))) (bc (if left? `(ENC-AND ,b ,c) `(ENC-AND ,c ,b))))
      (values `(LIST 2 ,g ,ac ,bc) (list (list 2 (mr+ g c) a b))
        `(iff-intro (,g ==> (ENC-IFF ,ac ,bc))
           ,(mr-and-dir g a b c left? P (lambda (g3) (mr-iffr g3 a b (mr-wk g3 P) (mr-asm g3 a))))
           ,(mr-and-dir g b a c left? P (lambda (g3) (mr-iffl g3 a b (mr-wk g3 P) (mr-asm g3 b)))))))))
(mr-eqv-clause! 'RW-AND-L (mr-and-spec #t))
(qed 'eqv-and-l)
(mr-eqv-clause! 'RW-AND-R (mr-and-spec #f))
(qed 'eqv-and-r)

;; OR-L / OR-R: from x (or c) get y (or c) under not-c, by contradiction.
(define (mr-or-dir g x y c left? conv)    ; (g + (x|c) ==> y|c); CONV: hn -> tree (hn ==> y), x and not-c in hn
  (let* ((xc (if left? `(ENC-OR ,x ,c) `(ENC-OR ,c ,x))) (yc (if left? `(ENC-OR ,y ,c) `(ENC-OR ,c ,y)))
         (g1 (mr+ g xc)) (g1x (mr+ g1 x)) (g1c (mr+ g1 c))
         (nyc `(ENC-NOT ,yc)) (hh (mr+ g1x nyc)) (hhc (mr+ hh c)) (nc `(ENC-NOT ,c)) (hn (mr+ hh nc))
         (c-side (lambda (gg) `(,(if left? 'or-intro-right 'or-intro-left) (,gg ==> ,yc) ,(mr-asm gg c))))
         (y-side (lambda (gg t) `(,(if left? 'or-intro-left 'or-intro-right) (,gg ==> ,yc) ,t)))
         (t-notc `(not-intro (,hh ==> ,nc)
                    (cut (,hhc ==> ENC-FALSITY) ,(c-side hhc) (not-elim (,(mr+ hhc yc) ==> ENC-FALSITY) (a := ,yc)))))
         (t-fhn `(cut (,hn ==> ENC-FALSITY) ,(y-side hn (conv hn)) (not-elim (,(mr+ hn yc) ==> ENC-FALSITY) (a := ,yc)))))
    `(or-elim (,g1 ==> ,yc)
       ,@(let ((xb `(contradiction (,g1x ==> ,yc) (cut (,hh ==> ENC-FALSITY) ,t-notc ,t-fhn))) (cb (c-side g1c)))
           (if left? (list xb cb) (list cb xb))))))
(define (mr-or-spec left?)
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given (mr+ g `(ENC-NOT ,c)) `(ENC-IFF ,a ,b)))
           (ac (if left? `(ENC-OR ,a ,c) `(ENC-OR ,c ,a))) (bc (if left? `(ENC-OR ,b ,c) `(ENC-OR ,c ,b))))
      (values `(LIST 2 ,g ,ac ,bc) (list (list 2 (mr+ g `(ENC-NOT ,c)) a b))
        `(iff-intro (,g ==> (ENC-IFF ,ac ,bc))
           ,(mr-or-dir g a b c left? (lambda (hn) (mr-iffr hn a b (mr-wk hn P) (mr-asm hn a))))
           ,(mr-or-dir g b a c left? (lambda (hn) (mr-iffl hn a b (mr-wk hn P) (mr-asm hn b)))))))))
(mr-eqv-clause! 'RW-OR-L (mr-or-spec #t))
(qed 'eqv-or-l)
(mr-eqv-clause! 'RW-OR-R (mr-or-spec #f))
(qed 'eqv-or-r)

(mr-eqv-clause! 'RW-IMP-L
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given g `(ENC-IFF ,a ,b)))
           (ac `(ENC-IMP ,a ,c)) (bc `(ENC-IMP ,b ,c))
           (g1 (mr+ g ac)) (g1b (mr+ g1 b)) (g2 (mr+ g bc)) (g2a (mr+ g2 a)))
      (values `(LIST 2 ,g ,ac ,bc) (list (list 2 g a b))
        `(iff-intro (,g ==> (ENC-IFF ,ac ,bc))
           (implies-intro (,g1 ==> ,bc) (backchain (,g1b ==> ,c) ,(mr-iffl g1b a b (mr-wk g1b P) (mr-asm g1b b))))
           (implies-intro (,g2 ==> ,ac) (backchain (,g2a ==> ,c) ,(mr-iffr g2a a b (mr-wk g2a P) (mr-asm g2a a)))))))))
(qed 'eqv-imp-l)

(mr-eqv-clause! 'RW-IMP-R
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given (mr+ g c) `(ENC-IFF ,a ,b)))
           (ca `(ENC-IMP ,c ,a)) (cb `(ENC-IMP ,c ,b))
           (g1c (mr+ g ca c)) (g2c (mr+ g cb c)))
      (values `(LIST 2 ,g ,ca ,cb) (list (list 2 (mr+ g c) a b))
        `(iff-intro (,g ==> (ENC-IFF ,ca ,cb))
           (implies-intro (,(mr+ g ca) ==> ,cb)
             ,(mr-iffr g1c a b (mr-wk g1c P) `(backchain (,g1c ==> ,a) ,(mr-asm g1c c))))
           (implies-intro (,(mr+ g cb) ==> ,ca)
             ,(mr-iffl g2c a b (mr-wk g2c P) `(backchain (,g2c ==> ,b) ,(mr-asm g2c c)))))))))
(qed 'eqv-imp-r)

(mr-eqv-clause! 'RW-IFF-L
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given g `(ENC-IFF ,a ,b)))
           (ac `(ENC-IFF ,a ,c)) (bc `(ENC-IFF ,b ,c))
           (g1 (mr+ g ac)) (g1b (mr+ g1 b)) (g1c (mr+ g1 c))
           (g2 (mr+ g bc)) (g2a (mr+ g2 a)) (g2c (mr+ g2 c)))
      (values `(LIST 2 ,g ,ac ,bc) (list (list 2 g a b))
        `(iff-intro (,g ==> (ENC-IFF ,ac ,bc))
           (iff-intro (,g1 ==> ,bc)
             ,(mr-iffr g1b a c (mr-asm g1b ac) (mr-iffl g1b a b (mr-wk g1b P) (mr-asm g1b b)))
             ,(mr-iffr g1c a b (mr-wk g1c P) (mr-iffl g1c a c (mr-asm g1c ac) (mr-asm g1c c))))
           (iff-intro (,g2 ==> ,ac)
             ,(mr-iffr g2a b c (mr-asm g2a bc) (mr-iffr g2a a b (mr-wk g2a P) (mr-asm g2a a)))
             ,(mr-iffl g2c a b (mr-wk g2c P) (mr-iffl g2c b c (mr-asm g2c bc) (mr-asm g2c c)))))))))
(qed 'eqv-iff-l)

(mr-eqv-clause! 'RW-IFF-R
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs))
           (P (mr-given g `(ENC-IFF ,a ,b)))
           (ca `(ENC-IFF ,c ,a)) (cb `(ENC-IFF ,c ,b))
           (g1 (mr+ g ca)) (g1c (mr+ g1 c)) (g1b (mr+ g1 b))
           (g2 (mr+ g cb)) (g2c (mr+ g2 c)) (g2a (mr+ g2 a)))
      (values `(LIST 2 ,g ,ca ,cb) (list (list 2 g a b))
        `(iff-intro (,g ==> (ENC-IFF ,ca ,cb))
           (iff-intro (,g1 ==> ,cb)
             ,(mr-iffr g1c a b (mr-wk g1c P) (mr-iffr g1c c a (mr-asm g1c ca) (mr-asm g1c c)))
             ,(mr-iffl g1b c a (mr-asm g1b ca) (mr-iffl g1b a b (mr-wk g1b P) (mr-asm g1b b))))
           (iff-intro (,g2 ==> ,ca)
             ,(mr-iffl g2c a b (mr-wk g2c P) (mr-iffr g2c c b (mr-asm g2c cb) (mr-asm g2c c)))
             ,(mr-iffl g2a c b (mr-asm g2a cb) (mr-iffr g2a a b (mr-wk g2a P) (mr-asm g2a a)))))))))
(qed 'eqv-iff-r)


;;; Stage 1, the atoms: a term child of IN / = / == rewritten.  The core's one equality rule is
;;; eq-subst, which rewrites P[z := t] to P[z := s] for a name z with s == t in the context; the hole
;;; is a FRESH name z put in the argument position (the formula P is the atom with EFVAR z there).

;; SUBST of an application over a literal 2-list, entrywise.
(sp (make-wff '(FORALL m (FORALL u (FORALL h (FORALL a (FORALL b (IMPLIES (IN u EXPR-SET) (IMPLIES (IN h NN)
   (IMPLIES (IN a EXPR-SET) (IMPLIES (IN b EXPR-SET)
     (= (EXPR-SUBST (EAPP h (LIST a b)) m u) (EAPP h (LIST (EXPR-SUBST a m u) (EXPR-SUBST b m u)))))))))))))))
(dk-peel!)
(let* ((l '(LIST a b)) (sa '(EXPR-SUBST a m u)) (sb '(EXPR-SUBST b m u)) (r `(LIST ,sa ,sb)))
  (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (fact 'subst-in-expr 'm 'u 'a)
  (fact 'subst-in-expr 'm 'u 'b)
  (dk-have! `(IN ,r (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (fact 'eapp-in-expr 'h r)
  (subst (dk-cite! 'subst-eapp 'm 'u 'h l))
  (let* ((fu (dk-cite! 'subst-fun-unfold 'm 'u))
         (lam (caddr fu)))
    (subst fu)
    (let* ((l2 (dk-meta-mapl! lam l 'EXPR-SET 'EXPR-SET
                 (lambda (i) (dk-lam-b!) (fact 'subst-in-expr 'm 'u `(NTH ,i ,l)) (ass))))
           (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l2)))) (dk-asms)))
           (len `(= (LENGTH ,l2) (LENGTH ,l)))
           (hyp `(FORALL mrk_ (IMPLIES (AND (IN mrk_ NN) (AND (<= 1 mrk_) (<= mrk_ (LENGTH ,l2))))
                                       (= (NTH mrk_ ,l2) (NTH mrk_ ,r))))))
      (dk-have! `(= (LENGTH ,l2) (LENGTH ,r)) (lambda () (subst len) (len-r) (rfl)))
      (dk-have! `(= (LENGTH ,l) 2) (lambda () (len-r) (rfl)))
      (dk-have! hyp
        (lambda ()
          (dk-peel!)
          (let* ((k (cadr (cadr (dk-goal))))
                 (rng (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f k))) (dk-asms))))
            (if rng (dk-split! rng))
            (let* ((h1 (dk-rewrite-h! `(<= ,k (LENGTH ,l2)) `(LENGTH ,l2) `(LENGTH ,l)))
                   (h2 (dk-rewrite-h! h1 `(LENGTH ,l) 2)))
              (subst (dk-apply! ents k))
              (dk-meta-or-each! (dk-cite! 'ms-index-2 k)
                (lambda (d)
                  (subst d)
                  (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
                  (dk-lam-b!)
                  (rfl)))))))
      (dk-cite! 'tuple-extensionality 'EXPR-SET l2 r)
      (subst `(= ,l2 ,r))
      (rfl))))
(qed 'subst-app2)

(define (mr-hole-law! left?)
  (let* ((l (if left? '(LIST (EFVAR z) c) '(LIST c (EFVAR z)))) (r (if left? '(LIST s c) '(LIST c s))))
    (sp (make-wff `(FORALL z (FORALL s (FORALL c (FORALL h (IMPLIES (IN z NN) (IMPLIES (IN s EXPR-SET) (IMPLIES (IN c EXPR-SET)
       (IMPLIES (IN h NN) (IMPLIES (NOT (IN z (EXPR-FV c)))
         (= (EXPR-SUBST (EAPP h ,l) z s) (EAPP h ,r)))))))))))))
    (dk-peel!)
    (fact 'efvar-in-expr 'z)
    (dk-have! `(IN ,r (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'eapp-in-expr 'h r)
    (subst (apply dk-cite! 'subst-app2 'z 's 'h (cdr l)))
    (subst (dk-cite! 'subst-efvar-hit 'z 's))
    (subst (dk-cite! 'subst-fresh 'z 's 'c))
    (rfl)))
(mr-hole-law! #t)
(qed 'subst-hole-l)
(mr-hole-law! #f)
(qed 'subst-hole-r)

;; [g2, f] from [g, f] in context, g a sub-context of g2 (the dk-derive! planner proves SUBSET).
(define (mr-weak! g2 g f)
  (let ((goal `(IN (LIST ,g2 ,f) (DERIVABLE tt))))
    (if (not (dk-asm? goal))
        (let ((p (dk-meta--plan-sub g g2 '())))
          (if (not p) (error "mr-weak!: cannot show the inclusion" (expression->string g) (expression->string g2)))
          (p)
          (mr-clf! g2 'CTX-SET)
          (mr-clf! f 'CLF)
          (dk-meta-seq! g2 f)
          (dk-cite! 'derivable-weakening-c 'tt g2 f g)))
    goal))

;; THE ATOM LEMMA, both sides: from s == t and the atom at t, the atom at s.
(define (mr-atom-law! left?)
  (let* ((at (lambda (x) (if left? `(EAPP h (LIST ,x c)) `(EAPP h (LIST c ,x)))))
         (fs (at 's)) (ft (at 't)))
    (sp (make-wff `(FORALL tt (FORALL g (FORALL h (FORALL s (FORALL t (FORALL c
       (IMPLIES (IN h NN) (IMPLIES (IN s CLT) (IMPLIES (IN t CLT) (IMPLIES (IN c CLT) (IMPLIES (IN ,fs CLF)
       (IMPLIES (IN (LIST g (ENC-QEQ s t)) (DERIVABLE tt)) (IMPLIES (IN (LIST g ,ft) (DERIVABLE tt))
         (IN (LIST g ,fs) (DERIVABLE tt)))))))))))))))))
    (dk-peel!)
    (let ((q '(ENC-QEQ s t)))
      (dk-cite! 'der-in-seq 'tt `(LIST g ,q))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g q)))
      (dk-cite! 'der-in-seq 'tt `(LIST g ,ft))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g ft)))
      (for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) '(s t c))
      (let* ((z (dk-skolem! (dk-cite! 'fresh-name-exists 'g 'c) #t))
             (zfresh `(NOT (IN ,z (UNION (CTX-FV g) (EXPR-FV c)))))
             (p (at `(EFVAR ,z)))
             (g1 `(CTX-ADD g ,q)))
        (dk-have! `(NOT (IN ,z (EXPR-FV c)))
          (lambda ()
            (di)
            (let ((iff (dk-meta-iff! 'union-membership '(CTX-FV g) '(EXPR-FV c) z)))
              (dk-meta-keep-prop! iff `(IN ,z (EXPR-FV c)) zfresh))))
        (fact 'efvar-in-expr z)
        (dk-have! `(IN ,(caddr p) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
        (fact 'eapp-in-expr 'h (caddr p))
        (let ((es (dk-cite! (if left? 'subst-hole-l 'subst-hole-r) z 's 'c 'h))
              (et (dk-cite! (if left? 'subst-hole-l 'subst-hole-r) z 't 'c 'h)))
          (mr-weak! g1 'g ft)
          (dk-have! `(IN (LIST ,g1 (EXPR-SUBST ,p ,z t)) (DERIVABLE tt)) (lambda () (subst et) (ass)))
          (dk-have! `(IN (EXPR-SUBST ,p ,z s) CLF) (lambda () (subst es) (ass)))
          (dk-meta-set-of! q 'CLF)
          (dk-have! `(OR (IN (ENC-EQ s t) ,g1) (IN ,q ,g1))
            (lambda () (oi-r) (dk-cite! 'ctx-add-has 'g q) (ass)))
          (dk-derive! 'tt `(eq-subst (,g1 ==> (EXPR-SUBST ,p ,z s)) (given (,g1 ==> (EXPR-SUBST ,p ,z t)))))
          (dk-have! `(IN (LIST ,g1 ,fs) (DERIVABLE tt))
            (lambda () (subst `(= ,fs (EXPR-SUBST ,p ,z s))) (ass)))
          (dk-meta-seq! 'g fs)
          (dk-cite! 'derivable-cut-c 'tt 'g fs q)
          (ass))))))
(mr-atom-law! #t)
(qed 'der-atom-l)
(mr-atom-law! #f)
(qed 'der-atom-r)

;; == is symmetric: der-atom-r at h = 9 (ENC-QEQ is EAPP 9), from s == t and t == t.
(sp (make-wff '(FORALL tt (FORALL g (FORALL s (FORALL t (IMPLIES (IN s CLT) (IMPLIES (IN t CLT)
   (IMPLIES (IN (LIST g (ENC-QEQ s t)) (DERIVABLE tt)) (IN (LIST g (ENC-QEQ t s)) (DERIVABLE tt)))))))))))
(dk-peel!)
(let ((u1 (dk-cite! 'enc-qeq-unfold 't 's)) (u2 (dk-cite! 'enc-qeq-unfold 't 't)))
  (dk-cite! 'der-in-seq 'tt '(LIST g (ENC-QEQ s t)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g '(ENC-QEQ s t))))
  (dk-have! '(IN 9 NN) (lambda () (arith)))
  (dk-have! '(<= 7 9) (lambda () (arith)))
  (dk-have! '(<= 9 9) (lambda () (arith)))
  (for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) '(s t))
  (let ((iff (dk-meta-iff! 'clf-rel2 9 't 't)))
    (dk-meta-and! '(IN t CLT) '(IN t CLT))
    (dk-meta-iff-l! iff))
  (let ((iff (dk-meta-iff! 'clf-rel2 9 't 's)))
    (dk-meta-and! '(IN t CLT) '(IN s CLT))
    (dk-meta-iff-l! iff))
  (dk-have! '(IN (ENC-QEQ t t) CLF) (lambda () (subst u2) (ass)))
  (dk-meta-seq! 'g '(ENC-QEQ t t))
  (dk-derive! 'tt '(quasi-reflexivity (g ==> (ENC-QEQ t t))))
  (dk-have! '(IN (LIST g (EAPP 9 (LIST t t))) (DERIVABLE tt)) (lambda () (subst `(= (EAPP 9 (LIST t t)) (ENC-QEQ t t))) (ass)))
  (dk-cite! 'der-atom-r 'tt 'g 9 's 't 't)
  (subst u1)
  (ass))
(qed 'der-qeq-sym)

(define (mr-rel-spec left?)
  (lambda (vs)
    (let* ((g (car vs)) (h (cadr vs)) (a (caddr vs)) (b (cadddr vs)) (c (car (cddddr vs)))
           (at (lambda (x) (if left? `(EAPP ,h (LIST ,x ,c)) `(EAPP ,h (LIST ,c ,x)))))
           (fa (at a)) (fb (at b)) (law (if left? 'der-atom-l 'der-atom-r)))
      (values `(LIST 2 ,g ,fa ,fb) (list (list 1 g a b))
        (lambda ()
          (for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) (list a b c))
          (for-each (lambda (x)
                      (let ((iff (apply dk-meta-iff! 'clf-rel2 h (cdr (caddr (at x))))))
                        (dk-meta-and! `(IN ,(cadr (caddr (at x))) CLT) `(IN ,(caddr (caddr (at x))) CLT))
                        (dk-meta-iff-l! iff)))
                    (list a b))
          (let ((g1 `(CTX-ADD ,g ,fa)) (g2 `(CTX-ADD ,g ,fb)) (q `(ENC-QEQ ,a ,b)))
            (mr-clf! g1 'CTX-SET) (mr-clf! g2 'CTX-SET)
            (mr-weak! g1 g q)
            (dk-cite! 'der-qeq-sym 'tt g1 a b)
            (dk-meta-seq! g1 fa) (dk-meta-set-of! fa 'CLF) (dk-cite! 'ctx-add-has g fa)
            (dk-cite! 'derivable-assumption-c 'tt g1 fa)
            (dk-cite! law 'tt g1 h b a c)
            (mr-weak! g2 g q)
            (dk-meta-seq! g2 fb) (dk-meta-set-of! fb 'CLF) (dk-cite! 'ctx-add-has g fb)
            (dk-cite! 'derivable-assumption-c 'tt g2 fb)
            (dk-cite! law 'tt g2 h a b c)
            (dk-derive! 'tt `(iff-intro (,g ==> (ENC-IFF ,fa ,fb)) (given (,g1 ==> ,fb)) (given (,g2 ==> ,fa))))))))))
(mr-eqv-clause! 'RW-REL-L (mr-rel-spec #t))
(qed 'eqv-rel-l)
(mr-eqv-clause! 'RW-REL-R (mr-rel-spec #f))
(qed 'eqv-rel-r)


;;; -----------------------------------------------------------------------
;;; D. STAGE 2 (the brief's (b)): FORALL / FORSOME, by cofinite quantification.

(sp (make-wff '(FORALL mrp_ (== (ENC-ALL mrp_) (EBIND 20 1 (LIST) mrp_)))))
(di) (mac 'enc-all) (qrfl)
(qed 'enc-all-unfold)
(sp (make-wff '(FORALL mrp_ (== (ENC-EX mrp_) (EBIND 21 1 (LIST) mrp_)))))
(di) (mac 'enc-ex) (qrfl)
(qed 'enc-ex-unfold)

;; A free variable is a closed term.
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IN (EFVAR n) CLT)))))
(dk-peel!)
(fact 'efvar-in-expr 'n)
(dk-have! '(WF-TERM (EFVAR n))
  (lambda () (mac 'wf-term) (subst (dk-cite! 'wks-efvar 'n)) (dk-meta-num-set! 1) (fact 'pair-self-member 1) (ass)))
(dk-have! '(EXPR-LC (EFVAR n))
  (lambda () (mac 'expr-lc) (subst (dk-cite! 'lcd-efvar 'n)) (fact 'nn-zero-in) (ass)))
(let ((iff (dk-meta-iff! 'clt-iff '(EFVAR n))))
  (dk-meta-and! '(IN (EFVAR n) EXPR-SET) '(WF-TERM (EFVAR n)) '(EXPR-LC (EFVAR n)))
  (dk-meta-iff-l! iff)
  (ass))
(qed 'clt-efvar)

;; An equation between closed terms is a sentence.
(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN x CLT) (IMPLIES (IN y CLT) (IN (ENC-EQ x y) CLF)))))))
(dk-peel!)
(for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) '(x y))
(dk-have! '(IN 8 NN) (lambda () (arith)))
(dk-have! '(<= 7 8) (lambda () (arith)))
(dk-have! '(<= 8 9) (lambda () (arith)))
(subst (dk-cite! 'enc-eq-unfold 'x 'y))
(let ((iff (dk-meta-iff! 'clf-rel2 8 'x 'y)))
  (dk-meta-and! '(IN x CLT) '(IN y CLT))
  (dk-meta-iff-l! iff)
  (ass))
(qed 'clf-eq-intro)

;; Inversion: the body of a binder node that is an expression is an expression.
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN (EBIND h nb a b) (EXPR-STAGE n)) (IN b EXPR-SET))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (let* ((landed (dk-peel!))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-STAGE))) landed))
         (x (cadr mem)))
    (dk-meta-or-each! (dk-cite! 'expr-stage-zero-cases x)
      (lambda (d) (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x)))))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "no IH")))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'EXPR-STAGE))) landed))
         (x (cadr mem)) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
         (n (cadr (cadr (caddr mem)))))
    (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases n x)
      (lambda (d)
        (cond
          ((dk-head-is? d 'IN) (dk-apply! ih h nb a b) (ass))
          ((eq? (dk-meta-disjunct-kind d) 'EBIND)
           (let* ((vs (dk-meta-unpack! d)) (b2 (cadddr vs)))
             (dk-split! (dk-cite! 'ebind-injective h nb a b (car vs) (cadr vs) (caddr vs) b2))
             (fact 'expr-set-intro n b2)
             (subst `(= ,b ,b2))
             (ass)))
          (#t (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x))))))))
(qed 'ebind-stage-inv)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b (IMPLIES (IN (EBIND h nb a b) EXPR-SET) (IN b EXPR-SET))))))))
(dk-peel!)
(let ((n (dk-meta-set-open! '(EBIND h nb a b))))
  (dk-apply! (dk-cite! 'ebind-stage-inv n) 'h 'nb 'a 'b)
  (ass))
(qed 'ebind-body-expr)

;; THE EIGENVARIABLE LEMMA WITH AN EXCEPTION SET: a name outside a finite set of names, fresh for a
;; context and an expression.
(sp (make-wff '(FORALL mrfs_ (FORALL g (FORALL f (IMPLIES (IN mrfs_ SET) (IMPLIES (SUBSET mrfs_ NN) (IMPLIES (IN (CARD mrfs_) NN)
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN f EXPR-SET)
     (FORSOME mrn_ (AND (IN mrn_ NN) (AND (NOT (IN mrn_ mrfs_)) (NOT (IN mrn_ (UNION (CTX-FV g) (EXPR-FV f)))))))))))))))))
(dk-peel!)
(let* ((a '(CTX-FV g)) (b '(EXPR-FV f)) (u0 `(UNION ,a ,b)) (u `(UNION mrfs_ ,u0)))
  (dk-split-all! (list (dk-cite! 'ctx-fv-finite 'g)))
  (dk-split-all! (list (dk-cite! 'fv-finite 'f)))
  (dk-meta-and! `(IN ,a SET) `(IN ,b SET))
  (fact 'union-set-closure a b)
  (fact 'card-union-nn a b)
  (dk-meta-and! '(IN mrfs_ SET) `(IN ,u0 SET))
  (fact 'union-set-closure 'mrfs_ u0)
  (fact 'card-union-nn 'mrfs_ u0)
  (dk-have! `(SUBSET ,u NN)
    (lambda ()
      (mac 'subset-def) (dk-peel!)
      (let ((z (cadr (dk-goal))))
        (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership 'mrfs_ u0 z))
          (lambda (d)
            (if (equal? (caddr d) 'mrfs_)
                (begin (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'subset-def 'mrfs_ 'NN)) z) (ass))
                (dk-meta-or-each! (dk-meta-iff-r! (dk-meta-iff! 'union-membership a b z))
                  (lambda (d2)
                    (dk-apply! (dk-meta-iff-r! (dk-meta-iff! 'subset-def (caddr d2) 'NN)) z)
                    (ass)))))))))
  (let ((nv (dk-skolem! (dk-cite! 'nn-finite-subset-bounded u))))
    (dk-have! `(<= ,nv ,nv) (lambda () (dk-nn!)))
    (let ((bound (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u))) (dk-asms))))
      (dk-apply! bound nv))
    (dk-have! `(NOT (IN ,nv mrfs_))
      (lambda () (di) (dk-meta-keep-prop! (dk-meta-iff! 'union-membership 'mrfs_ u0 nv) `(IN ,nv mrfs_) `(NOT (IN ,nv ,u)))))
    (dk-have! `(NOT (IN ,nv ,u0))
      (lambda () (di) (dk-meta-keep-prop! (dk-meta-iff! 'union-membership 'mrfs_ u0 nv) `(IN ,nv ,u0) `(NOT (IN ,nv ,u)))))
    (ew nv)
    (dk-conj-close! (lambda () (ass)))))
(qed 'mr-fresh)

;; One direction of the quantifier clause: [g + Q(x), Q(y)] derivable, Q = ENC-ALL / ENC-EX, from the
;; cofinite universal U of the clause (the tuples [2, g, a_z, b_z]); FWD? says x = a, y = b.
(define (mr-quant-dir! q g a b fs u fwd?)
  (let* ((x (if fwd? a b)) (y (if fwd? b a))
         (qx `(,q ,x)) (qy `(,q ,y)) (g1 `(CTX-ADD ,g ,qx)))
    (mr-clf! g1 'CTX-SET)
    (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clf-iff qy))))
    (let* ((fv-of (if (eq? q 'ENC-ALL)
                      (begin
                        (dk-cite! (if (eq? q 'ENC-ALL) 'enc-all-unfold 'enc-ex-unfold) y)
                        (dk-rewrite-h! `(IN ,qy EXPR-SET) qy `(EBIND ,(if (eq? q 'ENC-ALL) 20 21) 1 (LIST) ,y))
                        (dk-cite! 'ebind-body-expr (if (eq? q 'ENC-ALL) 20 21) 1 '(LIST) y)
                        y)
                      qy))
           (z (dk-skolem! (dk-cite! 'mr-fresh fs g1 fv-of) #t))
           (az `(EXPR-OPEN ,a 0 (EFVAR ,z))) (bz `(EXPR-OPEN ,b 0 (EFVAR ,z)))
           (xz (if fwd? az bz)) (yz (if fwd? bz az))
           (P (mr-given g `(ENC-IFF ,az ,bz)))
           (conv (lambda (gg t) (if fwd? (mr-iffr gg az bz (mr-wk gg P) t) (mr-iffl gg az bz (mr-wk gg P) t))))
           (ez `(EFVAR ,z)) (refl (lambda (gg) `(reflexivity (,gg ==> (ENC-EQ ,ez ,ez)) (n := ,z)))))
      (dk-apply! u z)
      (mr-open-prem! (list 2 g az bz))
      (dk-cite! 'clt-efvar z)
      (dk-cite! 'clf-eq-intro ez ez)
      (dk-have! `(OR (= ,ez ,ez) (= ,ez (ECONST ,z))) (lambda () (oi-l) (rfl)))
      (if (eq? q 'ENC-ALL)
          (dk-meta-derive! 'tt
            `(forall-intro (,g1 ==> ,qy)
               ,(conv g1 `(forall-elim (,g1 ==> ,xz) ,(mr-asm (mr+ g1 xz) xz) ,(refl g1)))))
          (let ((g1z (mr+ g1 xz)))
            (dk-meta-derive! 'tt
              `(forsome-elim (,g1 ==> ,qy)
                 (forsome-intro (,g1z ==> ,qy) ,(conv g1z (mr-asm g1z xz)) ,(refl g1z))))))
      `(IN (LIST ,g1 ,qy) (DERIVABLE tt)))))

(define (mr-quant-spec q)
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (fs (cadddr vs))
           (qa `(,q ,a)) (qb `(,q ,b)))
      (values `(LIST 2 ,g ,qa ,qb) '()
        (lambda ()
          (let ((u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f fs) (dk-contains? f 'EQV))) (dk-asms))))
            (if (not u) (error "mr-quant-spec: no cofinite universal"))
            (mr-quant-dir! q g a b fs u #t)
            (mr-quant-dir! q g a b fs u #f)
            (dk-derive! 'tt `(iff-intro (,g ==> (ENC-IFF ,qa ,qb))
                               (given (,(mr+ g qa) ==> ,qb)) (given (,(mr+ g qb) ==> ,qa))))))))))
(mr-eqv-clause! 'RW-ALL (mr-quant-spec 'ENC-ALL))
(qed 'eqv-all)
(mr-eqv-clause! 'RW-EX (mr-quant-spec 'ENC-EX))
(qed 'eqv-ex)

;;; -----------------------------------------------------------------------
;;; E. STAGE 3 (the brief's (f)): IF (head 27, a binder of no variable).  No hole is needed: the core's if-true /
;;; if-false hand over IF(p, a, b) == a (resp. == b) under p (resp. not p), so each clause is a case
;;; split on the condition (by contradiction) and a chain of quasi-equations.

(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN x CLT) (IMPLIES (IN y CLT) (IN (ENC-QEQ x y) CLF)))))))
(dk-peel!)
(for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) '(x y))
(dk-have! '(IN 9 NN) (lambda () (arith)))
(dk-have! '(<= 7 9) (lambda () (arith)))
(dk-have! '(<= 9 9) (lambda () (arith)))
(subst (dk-cite! 'enc-qeq-unfold 'x 'y))
(let ((iff (dk-meta-iff! 'clf-rel2 9 'x 'y)))
  (dk-meta-and! '(IN x CLT) '(IN y CLT))
  (dk-meta-iff-l! iff)
  (ass))
(qed 'clf-qeq-intro)

;; Two terms quasi-equal to a third are quasi-equal: der-atom-r at h = 9.
(sp (make-wff '(FORALL tt (FORALL g (FORALL x (FORALL y (FORALL c (IMPLIES (IN x CLT) (IMPLIES (IN y CLT) (IMPLIES (IN c CLT)
   (IMPLIES (IN (LIST g (ENC-QEQ x c)) (DERIVABLE tt)) (IMPLIES (IN (LIST g (ENC-QEQ y c)) (DERIVABLE tt))
     (IN (LIST g (ENC-QEQ x y)) (DERIVABLE tt))))))))))))))
(dk-peel!)
(let ((u1 (dk-cite! 'enc-qeq-unfold 'x 'c)) (u2 (dk-cite! 'enc-qeq-unfold 'x 'y)))
  (dk-have! '(IN 9 NN) (lambda () (arith)))
  (dk-cite! 'clf-qeq-intro 'x 'y)
  (dk-have! '(IN (EAPP 9 (LIST x y)) CLF) (lambda () (subst `(= (EAPP 9 (LIST x y)) (ENC-QEQ x y))) (ass)))
  (dk-have! '(IN (LIST g (EAPP 9 (LIST x c))) (DERIVABLE tt)) (lambda () (subst `(= (EAPP 9 (LIST x c)) (ENC-QEQ x c))) (ass)))
  (dk-cite! 'der-atom-r 'tt 'g 9 'y 'c 'x)
  (subst u2)
  (ass))
(qed 'der-qeq-join)

;; (contradiction (g ==> Q) ...): POS derives (h + c ==> F), NEG (h + not-c ==> F), h = g + not-Q.
(define (mr-if-cases g q c pos neg)
  (let* ((nq `(ENC-NOT ,q)) (h (mr+ g nq)) (nc `(ENC-NOT ,c)))
    `(contradiction (,g ==> ,q)
       (cut (,h ==> ENC-FALSITY) (not-intro (,h ==> ,nc) ,(pos (mr+ h c))) ,(neg (mr+ h nc))))))
;; under a context k holding the quasi-equation tree TQ for Q and not-Q: FALSITY
(define (mr-absurd-q k q tq)
  `(cut (,k ==> ENC-FALSITY) ,tq (not-elim (,(mr+ k q) ==> ENC-FALSITY) (a := ,q))))
(define (mr-join k x y c tx ty) `(lemma (,k ==> (ENC-QEQ ,x ,y)) der-qeq-join (,k ,x ,y ,c) ,tx ,ty))

(define (mr-if-type! . qs) (for-each (lambda (q) (apply dk-cite! 'clf-qeq-intro (cdr q))) qs))

;; IF-COND: the condition rewritten; ptree: (g ==> p IFF p2).
(mr-eqv-clause! 'RW-IF-COND
  (lambda (vs)
    (let* ((g (car vs)) (p (cadr vs)) (p2 (caddr vs)) (c (cadddr vs)) (d (car (cddddr vs)))
           (i1 `(ENC-IF ,p ,c ,d)) (i2 `(ENC-IF ,p2 ,c ,d)) (q `(ENC-QEQ ,i1 ,i2))
           (ptree (mr-given g `(ENC-IFF ,p ,p2))))
      (values `(LIST 1 ,g ,i1 ,i2) (list (list 2 g p p2))
        (lambda ()
          (mr-if-type! q `(ENC-QEQ ,i1 ,c) `(ENC-QEQ ,i2 ,c) `(ENC-QEQ ,i1 ,d) `(ENC-QEQ ,i2 ,d))
          (dk-meta-derive! 'tt
            (mr-if-cases g q p
              (lambda (hp)
                (let* ((k1 (mr+ hp `(ENC-QEQ ,i1 ,c))) (k2 (mr+ k1 `(ENC-QEQ ,i2 ,c))))
                  `(if-true (,hp ==> ENC-FALSITY) ,(mr-asm hp p)
                     (if-true (,k1 ==> ENC-FALSITY) ,(mr-iffr k1 p p2 (mr-wk k1 ptree) (mr-asm k1 p))
                       ,(mr-absurd-q k2 q (mr-join k2 i1 i2 c (mr-asm k2 `(ENC-QEQ ,i1 ,c)) (mr-asm k2 `(ENC-QEQ ,i2 ,c))))))))
              (lambda (hn)
                (let* ((np `(ENC-NOT ,p)) (np2 `(ENC-NOT ,p2))
                       (k1 (mr+ hn `(ENC-QEQ ,i1 ,d))) (k2 (mr+ k1 `(ENC-QEQ ,i2 ,d))) (k1p (mr+ k1 p2)))
                  `(if-false (,hn ==> ENC-FALSITY) ,(mr-asm hn np)
                     (if-false (,k1 ==> ENC-FALSITY)
                       (not-intro (,k1 ==> ,np2)
                         (cut (,k1p ==> ENC-FALSITY) ,(mr-iffl k1p p p2 (mr-wk k1p ptree) (mr-asm k1p p2))
                           (not-elim (,(mr+ k1p p) ==> ENC-FALSITY) (a := ,p))))
                       ,(mr-absurd-q k2 q (mr-join k2 i1 i2 d (mr-asm k2 `(ENC-QEQ ,i1 ,d)) (mr-asm k2 `(ENC-QEQ ,i2 ,d)))))))))))))))
(qed 'eqv-if-cond)

;; IF-THEN / IF-ELSE: a branch rewritten; ptree: (g ==> a == b).
(define (mr-if-branch-spec then?)
  (lambda (vs)
    (let* ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs)) (d (car (cddddr vs)))
           (i1 (if then? `(ENC-IF ,c ,a ,d) `(ENC-IF ,c ,d ,a))) (i2 (if then? `(ENC-IF ,c ,b ,d) `(ENC-IF ,c ,d ,b)))
           (q `(ENC-QEQ ,i1 ,i2)) (ptree (mr-given g `(ENC-QEQ ,a ,b))))
      (values `(LIST 1 ,g ,i1 ,i2) (list (list 1 g a b))
        (lambda ()
          (mr-if-type! q `(ENC-QEQ ,i1 ,a) `(ENC-QEQ ,i2 ,b) `(ENC-QEQ ,i2 ,a) `(ENC-QEQ ,i1 ,d) `(ENC-QEQ ,i2 ,d))
          ;; the rewritten branch: I1 == a, I2 == b, a == b  =>  I2 == a  =>  I1 == I2
          (define (moved k)
            (let* ((k1 (mr+ k `(ENC-QEQ ,i1 ,a))) (k2 (mr+ k1 `(ENC-QEQ ,i2 ,b))))
              (list k1 k2
                (mr-absurd-q k2 q
                  (mr-join k2 i1 i2 a (mr-asm k2 `(ENC-QEQ ,i1 ,a))
                    (mr-join k2 i2 a b (mr-asm k2 `(ENC-QEQ ,i2 ,b)) (mr-wk k2 ptree)))))))
          ;; the other branch: I1 == d, I2 == d  =>  I1 == I2
          (define (kept k)
            (let* ((k1 (mr+ k `(ENC-QEQ ,i1 ,d))) (k2 (mr+ k1 `(ENC-QEQ ,i2 ,d))))
              (list k1 k2
                (mr-absurd-q k2 q (mr-join k2 i1 i2 d (mr-asm k2 `(ENC-QEQ ,i1 ,d)) (mr-asm k2 `(ENC-QEQ ,i2 ,d)))))))
          (dk-meta-derive! 'tt
            (mr-if-cases g q c
              (lambda (hp)
                (let ((m (if then? (moved hp) (kept hp))))
                  `(if-true (,hp ==> ENC-FALSITY) ,(mr-asm hp c)
                     (if-true (,(car m) ==> ENC-FALSITY) ,(mr-asm (car m) c) ,(caddr m)))))
              (lambda (hn)
                (let ((m (if then? (kept hn) (moved hn))) (nc `(ENC-NOT ,c)))
                  `(if-false (,hn ==> ENC-FALSITY) ,(mr-asm hn nc)
                     (if-false (,(car m) ==> ENC-FALSITY) ,(mr-asm (car m) nc) ,(caddr m))))))))))))
(mr-eqv-clause! 'RW-IF-THEN (mr-if-branch-spec #t))
(qed 'eqv-if-then)
(mr-eqv-clause! 'RW-IF-ELSE (mr-if-branch-spec #f))
(qed 'eqv-if-else)

;;; -----------------------------------------------------------------------
;;; F. CR AT STAGE K: for J inside EQV(T), EQV(T) is closed under the clauses of stage <= K, hence
;;; REWR(J, K) is inside EQV(T), hence (the brief's form) [g, G'] derivable implies [g, G] derivable.

(define mr-clause-laws
  '((RW-TOP . eqv-top) (RW-NOT . eqv-not) (RW-AND-L . eqv-and-l) (RW-AND-R . eqv-and-r)
    (RW-OR-L . eqv-or-l) (RW-OR-R . eqv-or-r) (RW-IMP-L . eqv-imp-l) (RW-IMP-R . eqv-imp-r)
    (RW-IFF-L . eqv-iff-l) (RW-IFF-R . eqv-iff-r) (RW-REL-L . eqv-rel-l) (RW-REL-R . eqv-rel-r)
    (RW-ALL . eqv-all) (RW-EX . eqv-ex)
    (RW-IF-COND . eqv-if-cond) (RW-IF-THEN . eqv-if-then) (RW-IF-ELSE . eqv-if-else)
    (RW-PRED . eqv-pred) (RW-TAPP . eqv-tapp) (RW-BIND-DOM . eqv-bind-dom)))

(define (mr-cr-closed! k)
  (sp (make-wff `(FORALL tt (FORALL jj (IMPLIES (SUBSET jj (EQV tt)) (RW-CLOSED jj ,k (EQV tt)))))))
  (dk-peel!)
  (mac 'rw-closed)
  (dk-peel!)
  (let* ((r (find-first (lambda (f) (dk-head-is? f 'RW-RULE)) (dk-asms)))
         (o (dk-landed-1 (lambda () (mac-h 'rw-rule r)))))
    (dk-meta-or-each! o
      (lambda (d)
        (let* ((parts (dk-split! d))
               (le (find-first (lambda (f) (dk-head-is? f '<=)) parts))
               (cl (find-first (lambda (f) (not (dk-head-is? f '<=))) parts))
               (law (assq (car cl) mr-clause-laws)))
          (if (> (cadr le) k)
              (begin (dk-have! `(NOT ,le) (lambda () (arith))) (ai `(NOT ,le)))
              (begin
                (if (not law) (error "mr-cr-closed!: no EQV law for the clause" (car cl)))
                (dk-cite! (cdr law) 'jj 'tt (cadddr cl))
                (ass))))))))

(mr-cr-closed! 1)
(qed 'cr-closed-1)
(mr-cr-closed! 2)
(qed 'cr-closed-2)
(mr-cr-closed! 3)
(qed 'cr-closed-3)

(define (mr-cr-law! k closed)
  (sp (make-wff `(FORALL tt (FORALL jj (FORALL x (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (IN x (REWR jj ,k)) (IN x (EQV tt)))))))))
  (dk-peel!)
  (dk-cite! closed 'tt 'jj)
  (fact 'eqv-in-power 'tt)
  (dk-apply! (dk-cite! 'rewr-least 'jj k '(EQV tt)) 'x)
  (ass))
(mr-cr-law! 1 'cr-closed-1)
(qed 'cr-1)
(mr-cr-law! 2 'cr-closed-2)
(qed 'cr-2)
(mr-cr-law! 3 'cr-closed-3)
(qed 'cr-3)



;; THE BRIEF'S FORM OF CR: a one-position rewrite of the goal, justified in the local context,
;; reduces the goal to the rewritten goal.
(define (mr-cr-goal-law! k crk)
  (sp (make-wff `(FORALL tt (FORALL jj (FORALL g (FORALL fo (FORALL fo2 (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (IN (LIST 2 g fo fo2) (REWR jj ,k))
     (IMPLIES (IN (LIST g fo2) (DERIVABLE tt)) (IN (LIST g fo) (DERIVABLE tt))))))))))))
  (dk-peel!)
  (dk-cite! crk 'tt 'jj '(LIST 2 g fo fo2))
  (dk-split! (dk-cite! 'eqv-f-open 'tt 'g 'fo 'fo2))
  (dk-cite! 'der-iff-l 'tt 'g 'fo 'fo2)
  (ass))
(mr-cr-goal-law! 1 'cr-1)
(qed 'cr-goal-1)
(mr-cr-goal-law! 2 'cr-2)
(qed 'cr-goal-2)
(mr-cr-goal-law! 3 'cr-3)
(qed 'cr-goal-3)


;;; -----------------------------------------------------------------------
;;; G. STAGE 4 (the brief's (c)): an argument of a predicate (head 10) or of a term constant (head
;;; >= 11) rewritten.  The hole is a list lz equal to l off the index i and carrying a fresh FVAR z at
;;; i (tuple-tabulation of an IF); eq-subst then moves between l and l2 through SUBST(EAPP h lz, z, -).

;; Statement builders: (mr-st VARS HYP ... CONCL) is FORALL VARS. HYP => ... => CONCL.
(define (mr-st vars . fs)
  (let ((body (fold-right (lambda (a b) `(IMPLIES ,a ,b)) (car (last-pair fs)) (except-last-pair! (list-copy fs)))))
    (fold-right (lambda (v b) `(FORALL ,v ,b)) body vars)))
(define (mr-range i n) (list `(IN ,i NN) `(<= 1 ,i) `(<= ,i ,n)))
;; "l2 agrees with l off i", the shape the stage-4 clauses state
(define (mr-agree l2 l i)
  `(FORALL mrj_ (IMPLIES (IN mrj_ NN) (IMPLIES (<= 1 mrj_) (IMPLIES (<= mrj_ (LENGTH ,l))
     (IMPLIES (NOT (= mrj_ ,i)) (= (NTH mrj_ ,l2) (NTH mrj_ ,l))))))))

;; A name free in an argument is free in the application.
(sp (make-wff (apply mr-st '(h l k z) '(IN h NN) '(IN l (TUPLES EXPR-SET))
                (append (mr-range 'k '(LENGTH l))
                        (list '(IN z (EXPR-FV (NTH k l))) '(IN z (EXPR-FV (EAPP h l))))))))
(dk-peel!)
(subst (dk-cite! 'fv-eapp 'h 'l))
(dk-each-leaf! (lambda () (bu-mi '(NTH k l)))
  (lambda ()
    (if (dk-head-is? (caddr (dk-goal)) 'MAKE-SET)
        (dk-meta-in-makeset! 'k 'l 'EXPR-SET)
        (ass))))
(qed 'fv-entry)

;; THE HOLE LIST: l with a fresh name at the index i.
(define mr-holef '(VNB-LAMBDA mrjj_ NN (IF (= mrjj_ i) (EFVAR z) (NTH mrjj_ l))))
(sp (make-wff (apply mr-st '(z l i) '(IN z NN) '(IN l (TUPLES EXPR-SET))
                (append (mr-range 'i '(LENGTH l))
                        (list `(FORSOME mrlz_ (AND (IN mrlz_ (TUPLES EXPR-SET)) (AND (= (LENGTH mrlz_) (LENGTH l))
                                 (AND (= (NTH i mrlz_) (EFVAR z)) ,(mr-agree 'mrlz_ 'l 'i))))))))))
(dk-peel!)
(fact 'efvar-in-expr 'z)
(dk-cite! 'length-in-nn 'EXPR-SET 'l)
(define (mr-hl-rng! j)
  (dk-have! `(AND (IN ,j NN) (AND (<= 1 ,j) (<= ,j (LENGTH l)))) (lambda () (dk-conj-close! (lambda () (ass))))))
(let* ((f mr-holef)
       (hyp `(FORALL i_ (IMPLIES (AND (IN i_ NN) (AND (<= 1 i_) (<= i_ (LENGTH l)))) (IN (,f i_) EXPR-SET)))))
  (dk-have! hyp
    (lambda ()
      (dk-peel!)
      (let* ((j (cadr (cadr (dk-goal))))
             (rng (find-first (lambda (x) (and (dk-head-is? x 'AND) (dk-contains? x j))) (dk-asms))))
        (if rng (dk-split! rng))
        (dk-lam-b!)
        (dk-case-if! `(IF (= ,j i) (EFVAR z) (NTH ,j l))
          (lambda (b v) (if b (ass) (begin (dk-meta-nth-in! 'EXPR-SET j 'l) (ass))))))))
  (let* ((ex (dk-cite! 'tuple-tabulation '(LENGTH l) 'EXPR-SET f))
         (lz (dk-skolem! ex))
         (ents (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x `(NTH i_ ,lz)))) (dk-asms))))
    (if (not ents) (error "hole-list: no entry universal"))
    (ew lz)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (equal? (cadr g) `(NTH i ,lz)))
             (mr-hl-rng! 'i)
             (subst (dk-apply! ents 'i))
             (dk-lam-b!)
             (dk-if-branch! #t '(IF (= i i) (EFVAR z) (NTH i l)) (lambda () (rfl)) (lambda () (rfl))))
            ((dk-head-is? g 'FORALL)
             (dk-peel!)
             (let ((j (cadr (cadr (dk-goal)))))
               (mr-hl-rng! j)
               (subst (dk-apply! ents j))
               (dk-lam-b!)
               (dk-meta-nth-in! 'EXPR-SET j 'l)
               (dk-if-branch! #f `(IF (= ,j i) (EFVAR z) (NTH ,j l)) (lambda () (ass)) (lambda () (rfl)))))
            (#t (error "hole-list: unexpected conjunct" (expression->string g)))))))))
(qed 'hole-list)

;; SUBST through the hole: SUBST(EAPP h lz, z, NTH i l2) = EAPP h l2, for any l2 agreeing with l off i.
(sp (make-wff (apply mr-st '(z h l lz l2 i)
                (append (list '(IN z NN) '(IN h NN) '(IN l (TUPLES EXPR-SET)) '(IN lz (TUPLES EXPR-SET)) '(IN l2 (TUPLES EXPR-SET))
                              '(= (LENGTH lz) (LENGTH l)) '(= (LENGTH l2) (LENGTH l)))
                        (mr-range 'i '(LENGTH l))
                        (list '(= (NTH i lz) (EFVAR z)) (mr-agree 'lz 'l 'i) (mr-agree 'l2 'l 'i)
                              '(NOT (IN z (EXPR-FV (EAPP h l))))
                              '(= (EXPR-SUBST (EAPP h lz) z (NTH i l2)) (EAPP h l2)))))))
(define (mr-shl-entry! k lzag l2ag w)    ; the goal (= (EXPR-SUBST (NTH k lz) z w) (NTH k l2)), k in range
  (use-em `(= ,k i)
    (lambda ()
      (subst `(= ,k i))
      (subst '(= (NTH i lz) (EFVAR z)))
      (subst (dk-cite! 'subst-efvar-hit 'z w))
      (rfl))
    (lambda ()
      (let ((e1 (dk-apply! lzag k)) (e2 (dk-apply! l2ag k)))
        (subst e1)
        (subst e2)
        (dk-meta-nth-in! 'EXPR-SET k 'l)
        (dk-have! `(NOT (IN z (EXPR-FV (NTH ,k l))))
          (lambda () (di) (dk-cite! 'fv-entry 'h 'l k 'z) (ai '(NOT (IN z (EXPR-FV (EAPP h l)))))))
        (subst (dk-cite! 'subst-fresh 'z w `(NTH ,k l)))
        (rfl)))))
(let* ((landed (dk-peel!))
       (lzag (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x '(NTH mrj_ lz)))) landed))
       (l2ag (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x '(NTH mrj_ l2)))) landed))
       (w '(NTH i l2)))
  (dk-have! '(<= i (LENGTH l2)) (lambda () (subst '(= (LENGTH l2) (LENGTH l))) (ass)))
  (dk-meta-nth-in! 'EXPR-SET 'i 'l2)
  (fact 'eapp-in-expr 'h 'l2)
  (dk-cite! 'length-in-nn 'EXPR-SET 'l)
  (subst (dk-cite! 'subst-eapp 'z w 'h 'lz))
  (let* ((fu (dk-cite! 'subst-fun-unfold 'z w))
         (lam (caddr fu)))
    (subst fu)
    (let* ((l3 (dk-meta-mapl! lam 'lz 'EXPR-SET 'EXPR-SET
                 (lambda (k) (dk-lam-b!) (fact 'subst-in-expr 'z w `(NTH ,k lz)) (ass))))
           (ents (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x `(NTH ,(cadr x) ,l3)))) (dk-asms)))
           (hyp `(FORALL mrk_ (IMPLIES (AND (IN mrk_ NN) (AND (<= 1 mrk_) (<= mrk_ (LENGTH ,l3))))
                                       (= (NTH mrk_ ,l3) (NTH mrk_ l2))))))
      (dk-have! `(= (LENGTH ,l3) (LENGTH l2))
        (lambda ()
          (subst `(= (LENGTH ,l3) (LENGTH lz)))
          (subst '(= (LENGTH lz) (LENGTH l)))
          (subst '(= (LENGTH l2) (LENGTH l)))
          (rfl)))
      (dk-have! hyp
        (lambda ()
          (dk-peel!)
          (let* ((k (cadr (cadr (dk-goal))))
                 (rng (find-first (lambda (x) (and (dk-head-is? x 'AND) (dk-contains? x k))) (dk-asms))))
            (if rng (dk-split! rng))
            (let* ((h1 (dk-rewrite-h! `(<= ,k (LENGTH ,l3)) `(LENGTH ,l3) '(LENGTH lz)))
                   (h2 (dk-rewrite-h! h1 '(LENGTH lz) '(LENGTH l))))
              (subst (dk-apply! ents k))
              (dk-meta-nth-in! 'EXPR-SET k 'lz)
              (dk-lam-b!)
              (mr-shl-entry! k lzag l2ag w)))))
      (dk-cite! 'tuple-extensionality 'EXPR-SET l3 'l2)
      (subst `(= ,l3 l2))
      (rfl))))
(qed 'subst-hole-list)

;; Agreement off i is symmetric (bounds moved along the length equation).
(sp (make-wff (mr-st '(l l2 i) '(= (LENGTH l2) (LENGTH l)) (mr-agree 'l2 'l 'i) (mr-agree 'l 'l2 'i))))
(let* ((landed (dk-peel!))
       (ag (find-first (lambda (x) (dk-head-is? x 'FORALL)) landed)))
  (dk-peel!)
  (let* ((j (cadr (cadr (dk-goal)))))
    (dk-rewrite-h! `(<= ,j (LENGTH l2)) '(LENGTH l2) '(LENGTH l))
    (subst (dk-apply! ag j))
    (rfl)))
(qed 'agree-sym)

;; THE LIST-HOLE STEP: from (NTH i l2) == (NTH i l) and [g, EAPP h l], [g, EAPP h l2]; and the
;; quasi-equation of the two applications from (NTH i l) == (NTH i l2).
(define mr-lh-common
  (append (list '(IN h NN) '(IN l (TUPLES EXPR-SET)) '(IN l2 (TUPLES EXPR-SET)) '(= (LENGTH l2) (LENGTH l)))
          (mr-range 'i '(LENGTH l))
          (list (mr-agree 'l2 'l 'i))))
;; the common opening: s1 = NTH i l, s2 = NTH i l2 in CLT, a fresh z off FV(EAPP h l) and g, the hole lz,
;; and the two SUBST equations; returns (z lz) and leaves e1: SUBST(EAPP h lz, z, s1) = EAPP h l and
;; e2: SUBST(EAPP h lz, z, s2) = EAPP h l2 in context.
(define (mr-lh-open! q)                   ; q: the quasi-equation (in context, derivable) naming s1, s2
  (dk-cite! 'der-in-seq 'tt `(LIST g ,q))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g q)))
  (dk-meta-nth-in! 'EXPR-SET 'i 'l)
  (dk-have! '(<= i (LENGTH l2)) (lambda () (subst '(= (LENGTH l2) (LENGTH l))) (ass)))
  (dk-meta-nth-in! 'EXPR-SET 'i 'l2)
  (fact 'eapp-in-expr 'h 'l)
  (fact 'eapp-in-expr 'h 'l2)
  (let* ((z (dk-skolem! (dk-cite! 'fresh-name-exists 'g '(EAPP h l)) #t))
         (zfresh `(NOT (IN ,z (UNION (CTX-FV g) (EXPR-FV (EAPP h l)))))))
    (dk-have! `(NOT (IN ,z (EXPR-FV (EAPP h l))))
      (lambda () (di) (dk-meta-keep-prop! (dk-meta-iff! 'union-membership '(CTX-FV g) '(EXPR-FV (EAPP h l)) z)
                                          `(IN ,z (EXPR-FV (EAPP h l))) zfresh)))
    (let* ((lz (dk-skolem! (dk-cite! 'hole-list z 'l 'i) #t)))
      (fact 'eapp-in-expr 'h lz)
      (dk-have! (mr-agree 'l 'l 'i)
        (lambda () (dk-peel!) (let ((j (cadr (cadr (dk-goal))))) (dk-meta-nth-in! 'EXPR-SET j 'l) (rfl))))
      (dk-have! '(= (LENGTH l) (LENGTH l)) (lambda () (dk-cite! 'length-in-nn 'EXPR-SET 'l) (rfl)))
      (dk-cite! 'subst-hole-list z 'h 'l lz 'l 'i)
      (dk-cite! 'subst-hole-list z 'h 'l lz 'l2 'i)
      (list z lz))))

;; (IN (ENC-QEQ x y) CLF) in context: land x, y in CLT (x, y in EXPR-SET in context).
(define (mr-qeq-parts! q)
  (let ((x (cadr q)) (y (caddr q)))
    (dk-have! '(IN 9 NN) (lambda () (arith)))
    (dk-have! '(<= 7 9) (lambda () (arith)))
    (dk-have! '(<= 9 9) (lambda () (arith)))
    (dk-cite! 'enc-qeq-unfold x y)
    (let ((m (dk-rewrite-h! `(IN ,q CLF) q `(EAPP 9 (LIST ,x ,y)))))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clf-rel2 9 x y))))))

;; [g, EAPP h l] and (NTH i l2) == (NTH i l)  =>  [g, EAPP h l2].
(sp (make-wff (apply mr-st '(tt g h l l2 i)
                (append mr-lh-common
                        (list '(IN (EAPP h l) CLF) '(IN (EAPP h l2) CLF)
                              '(IN (LIST g (ENC-QEQ (NTH i l2) (NTH i l))) (DERIVABLE tt))
                              '(IN (LIST g (EAPP h l)) (DERIVABLE tt))
                              '(IN (LIST g (EAPP h l2)) (DERIVABLE tt)))))))
(dk-peel!)
(let* ((q '(ENC-QEQ (NTH i l2) (NTH i l)))
       (zl (mr-lh-open! q)) (z (car zl)) (lz (cadr zl))
       (p `(EAPP h ,lz)) (s1 '(NTH i l)) (s2 '(NTH i l2))
       (g1 `(CTX-ADD g ,q)))
  (mr-clf! g1 'CTX-SET)
  (mr-weak! g1 'g '(EAPP h l))
  (dk-have! `(IN (LIST ,g1 (EXPR-SUBST ,p ,z ,s1)) (DERIVABLE tt)) (lambda () (subst `(= (EXPR-SUBST ,p ,z ,s1) (EAPP h l))) (ass)))
  (dk-have! `(IN (EXPR-SUBST ,p ,z ,s2) CLF) (lambda () (subst `(= (EXPR-SUBST ,p ,z ,s2) (EAPP h l2))) (ass)))
  (dk-meta-set-of! q 'CLF)
  (dk-have! `(OR (IN (ENC-EQ ,s2 ,s1) ,g1) (IN ,q ,g1)) (lambda () (oi-r) (dk-cite! 'ctx-add-has 'g q) (ass)))
  (fact 'efvar-in-expr z)
  (dk-derive! 'tt `(eq-subst (,g1 ==> (EXPR-SUBST ,p ,z ,s2)) (given (,g1 ==> (EXPR-SUBST ,p ,z ,s1)))))
  (dk-have! `(IN (LIST ,g1 (EAPP h l2)) (DERIVABLE tt)) (lambda () (subst `(= (EAPP h l2) (EXPR-SUBST ,p ,z ,s2))) (ass)))
  (dk-meta-seq! 'g '(EAPP h l2))
  (dk-cite! 'derivable-cut-c 'tt 'g '(EAPP h l2) q)
  (ass))
(qed 'der-list-hole)

;; (NTH i l) == (NTH i l2)  =>  (EAPP h l) == (EAPP h l2): the hole one level down, in a quasi-equation
;; whose left side is the fixed (EAPP h l).
(sp (make-wff (apply mr-st '(tt g h l l2 i)
                (append mr-lh-common
                        (list '(IN (EAPP h l) CLT) '(IN (EAPP h l2) CLT)
                              '(IN (LIST g (ENC-QEQ (NTH i l) (NTH i l2))) (DERIVABLE tt))
                              '(IN (LIST g (ENC-QEQ (EAPP h l) (EAPP h l2))) (DERIVABLE tt)))))))
(dk-peel!)
(let* ((q0 '(ENC-QEQ (NTH i l) (NTH i l2)))
       (zl (mr-lh-open! q0)) (z (car zl)) (lz (cadr zl))
       (e1 '(EAPP h l)) (e2 '(EAPP h l2)) (ez `(EAPP h ,lz))
       (p `(EAPP 9 (LIST ,e1 ,ez))) (s1 '(NTH i l)) (s2 '(NTH i l2))
       (q `(ENC-QEQ ,s2 ,s1)) (g1 `(CTX-ADD g ,q)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff e1)))
  (dk-have! '(IN 9 NN) (lambda () (arith)))
  (dk-have! `(IN (LIST ,e1 ,ez) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (fact 'eapp-in-expr 9 `(LIST ,e1 ,ez))
  (fact 'efvar-in-expr z)
  ;; SUBST(p, z, s) = (EAPP 9 (LIST e1 SUBST(ez, z, s)))
  (for-each (lambda (s target)
              (dk-have! `(= (EXPR-SUBST ,p ,z ,s) (EAPP 9 (LIST ,e1 ,target)))
                (lambda ()
                  (subst (dk-cite! 'subst-app2 z s 9 e1 ez))
                  (subst (dk-cite! 'subst-fresh z s e1))
                  (subst `(= (EXPR-SUBST ,ez ,z ,s) ,target))
                  (dk-have! `(IN (LIST ,e1 ,target) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
                  (fact 'eapp-in-expr 9 `(LIST ,e1 ,target))
                  (rfl))))
            (list s1 s2) (list e1 e2))
  (mr-qeq-parts! q0)
  (dk-cite! 'der-qeq-sym 'tt 'g s1 s2)
  (dk-cite! 'der-in-seq 'tt `(LIST g ,q))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g q)))
  (dk-cite! 'clf-qeq-intro e1 e1)
  (dk-cite! 'clf-qeq-intro e1 e2)
  (let ((u11 (dk-cite! 'enc-qeq-unfold e1 e1)) (u12 (dk-cite! 'enc-qeq-unfold e1 e2)))
    (mr-clf! g1 'CTX-SET)
    (dk-meta-seq! g1 `(ENC-QEQ ,e1 ,e1))
    (dk-derive! 'tt `(quasi-reflexivity (,g1 ==> (ENC-QEQ ,e1 ,e1))))
    (dk-have! `(IN (LIST ,g1 (EXPR-SUBST ,p ,z ,s1)) (DERIVABLE tt))
      (lambda () (subst `(= (EXPR-SUBST ,p ,z ,s1) (EAPP 9 (LIST ,e1 ,e1)))) (subst `(= (EAPP 9 (LIST ,e1 ,e1)) (ENC-QEQ ,e1 ,e1))) (ass)))
    (dk-have! `(IN (EXPR-SUBST ,p ,z ,s2) CLF)
      (lambda () (subst `(= (EXPR-SUBST ,p ,z ,s2) (EAPP 9 (LIST ,e1 ,e2)))) (subst `(= (EAPP 9 (LIST ,e1 ,e2)) (ENC-QEQ ,e1 ,e2))) (ass)))
    (dk-meta-set-of! q 'CLF)
    (dk-have! `(OR (IN (ENC-EQ ,s2 ,s1) ,g1) (IN ,q ,g1)) (lambda () (oi-r) (dk-cite! 'ctx-add-has 'g q) (ass)))
    (dk-derive! 'tt `(eq-subst (,g1 ==> (EXPR-SUBST ,p ,z ,s2)) (given (,g1 ==> (EXPR-SUBST ,p ,z ,s1)))))
    (dk-have! `(IN (LIST ,g1 (ENC-QEQ ,e1 ,e2)) (DERIVABLE tt))
      (lambda () (subst u12) (subst `(= (EAPP 9 (LIST ,e1 ,e2)) (EXPR-SUBST ,p ,z ,s2))) (ass)))
    (dk-meta-seq! 'g `(ENC-QEQ ,e1 ,e2))
    (dk-cite! 'derivable-cut-c 'tt 'g `(ENC-QEQ ,e1 ,e2) q)
    (ass)))
(qed 'der-tapp)

;; The clauses.  Witnesses of RW-PRED / RW-TAPP: g h a b i (a, b the two lists).
(mr-eqv-clause! 'RW-TAPP
  (lambda (vs)
    (let ((g (car vs)) (h (cadr vs)) (a (caddr vs)) (b (cadddr vs)) (i (car (cddddr vs))))
      (values `(LIST 1 ,g (EAPP ,h ,a) (EAPP ,h ,b)) (list (list 1 g `(NTH ,i ,a) `(NTH ,i ,b)))
        (lambda () (dk-cite! 'der-tapp 'tt g h a b i))))))
(qed 'eqv-tapp)

(mr-eqv-clause! 'RW-PRED
  (lambda (vs)
    (let* ((g (car vs)) (h (cadr vs)) (a (caddr vs)) (b (cadddr vs)) (i (car (cddddr vs)))
           (fa `(EAPP ,h ,a)) (fb `(EAPP ,h ,b)) (sa `(NTH ,i ,a)) (sb `(NTH ,i ,b))
           (g1 `(CTX-ADD ,g ,fa)) (g2 `(CTX-ADD ,g ,fb)))
      (values `(LIST 2 ,g ,fa ,fb) (list (list 1 g sa sb))
        (lambda ()
          (mr-clf! g1 'CTX-SET) (mr-clf! g2 'CTX-SET)
          ;; from fa to fb: (NTH i b) == (NTH i a) in g1
          (mr-weak! g1 g `(ENC-QEQ ,sa ,sb))
          (dk-cite! 'der-qeq-sym 'tt g1 sa sb)
          (dk-meta-seq! g1 fa) (dk-meta-set-of! fa 'CLF) (dk-cite! 'ctx-add-has g fa)
          (dk-cite! 'derivable-assumption-c 'tt g1 fa)
          (dk-cite! 'der-list-hole 'tt g1 h a b i)
          ;; from fb to fa: the lists exchanged, the agreement and the length turned round
          (dk-cite! 'agree-sym a b i)
          (dk-have! `(= (LENGTH ,a) (LENGTH ,b)) (lambda () (subst `(= (LENGTH ,b) (LENGTH ,a))) (dk-cite! 'length-in-nn 'EXPR-SET a) (rfl)))
          (dk-have! `(<= ,i (LENGTH ,b)) (lambda () (subst `(= (LENGTH ,b) (LENGTH ,a))) (ass)))
          (mr-weak! g2 g `(ENC-QEQ ,sa ,sb))
          (dk-meta-seq! g2 fb) (dk-meta-set-of! fb 'CLF) (dk-cite! 'ctx-add-has g fb)
          (dk-cite! 'derivable-assumption-c 'tt g2 fb)
          (dk-cite! 'der-list-hole 'tt g2 h b a i)
          (dk-meta-derive! 'tt `(iff-intro (,g ==> (ENC-IFF ,fa ,fb)) (given (,g1 ==> ,fb)) (given (,g2 ==> ,fa)))))))))
(qed 'eqv-pred)

(mr-cr-closed! 4)
(qed 'cr-closed-4)
(mr-cr-law! 4 'cr-closed-4)
(qed 'cr-4)
(mr-cr-goal-law! 4 'cr-4)
(qed 'cr-goal-4)


