;; THE LOCAL STEP of a macete: theorem-assumption, forall-elim at the (denoting) instance, backchain
;; on the condition.  Witnesses of J-MAC: g c a b e.
(define (mr-mac-case! g c a b e kk)
  (let* ((rel (if (= kk 1) 'ENC-QEQ 'ENC-IFF)) (hd (if (= kk 1) 9 6))
         (q `(,rel ,a ,b)) (bb `(ENC-IMP ,c ,q)) (m `(ENC-ALL ,bb))
         (c1 `(EXPR-OPEN ,c 0 ,e)) (a1 `(EXPR-OPEN ,a 0 ,e)) (b1 `(EXPR-OPEN ,b 0 ,e))
         (q1 `(,rel ,a1 ,b1)) (i1 `(ENC-IMP ,c1 ,q1)) (bo `(EXPR-OPEN ,bb 0 ,e))
         (g1 `(CTX-ADD ,g ,m)) (gi `(CTX-ADD ,g1 ,i1)) (go `(CTX-ADD ,g1 ,bo)))
    ;; the pieces are expressions, read off the sentence m
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clf-iff m)))
    (dk-cite! 'enc-all-unfold bb)
    (dk-rewrite-h! `(IN ,m EXPR-SET) m `(EBIND 20 1 (LIST) ,bb))
    (dk-cite! 'ebind-body-expr 20 1 '(LIST) bb)
    (let* ((u5 (dk-cite! 'enc-imp-unfold c q)) (uq (dk-cite! (if (= kk 1) 'enc-qeq-unfold 'enc-iff-unfold) a b)))
      (dk-rewrite-h! `(IN ,bb EXPR-SET) bb `(EAPP 5 (LIST ,c ,q)))
      (dk-split! (dk-cite! 'eapp-expr-inv 5 `(LIST ,c ,q)))
      (te `(IN (LIST ,c ,q) (TUPLES EXPR-SET)) 1)
      (te `(IN (LIST ,c ,q) (TUPLES EXPR-SET)) 2)
      (dk-rewrite-h! `(IN ,q EXPR-SET) q `(EAPP ,hd (LIST ,a ,b)))
      (dk-split! (dk-cite! 'eapp-expr-inv hd `(LIST ,a ,b)))
      (te `(IN (LIST ,a ,b) (TUPLES EXPR-SET)) 1)
      (te `(IN (LIST ,a ,b) (TUPLES EXPR-SET)) 2)
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff e)))
      (dk-have! '(IN 0 NN) (lambda () (arith)))
      (dk-have! '(IN 5 NN) (lambda () (arith)))
      (dk-have! `(IN ,hd NN) (lambda () (arith)))
      ;; the opened body, computed
      (dk-cite! (if (= kk 1) 'enc-qeq-unfold 'enc-iff-unfold) a1 b1)
      (dk-cite! 'enc-imp-unfold c1 q1)
      (dk-have! `(= ,bo ,i1)
        (lambda ()
          (subst u5)
          (subst (dk-cite! 'open-app2 e 0 5 c q))
          (subst uq)
          (subst (dk-cite! 'open-app2 e 0 hd a b))
          (subst `(= (EAPP ,hd (LIST ,a1 ,b1)) ,q1))
          (subst `(= (EAPP 5 (LIST ,c1 ,q1)) ,i1))
          (fact 'open-in-expr e 0 c) (fact 'open-in-expr e 0 a) (fact 'open-in-expr e 0 b)
          (dk-have! `(IN (LIST ,a1 ,b1) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
          (fact 'eapp-in-expr hd `(LIST ,a1 ,b1))
          (dk-have! `(IN ,q1 EXPR-SET) (lambda () (subst `(= ,q1 (EAPP ,hd (LIST ,a1 ,b1)))) (ass)))
          (dk-have! `(IN (LIST ,c1 ,q1) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
          (fact 'eapp-in-expr 5 `(LIST ,c1 ,q1))
          (dk-have! `(IN ,i1 EXPR-SET) (lambda () (subst `(= ,i1 (EAPP 5 (LIST ,c1 ,q1)))) (ass)))
          (rfl)))
      ;; the typings the derivation's contexts need
      (dk-cite! 'der-in-seq 'tt `(LIST ,g ,c1))
      (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g c1)))
      (if (= kk 1) (dk-cite! 'clf-qeq-intro a1 b1)
          (dk-cite! 'clf-iff-intro a1 b1))
      (dk-cite! 'clf-imp-intro c1 q1)
      (dk-have! `(IN ,bo CLF) (lambda () (subst `(= ,bo ,i1)) (ass)))
      (dk-cite! 'der-in-seq 'tt `(LIST ,g (ENC-EQ ,e ,e)))
      (dk-cite! 'clf-eq-intro e e)
      (mr-clf! g1 'CTX-SET) (mr-clf! gi 'CTX-SET) (mr-clf! go 'CTX-SET)
      ;; [g1 + i1, q1] by backchain on the weakened condition, then the same sequent spelled with bo
      (dk-meta-derive! 'tt `(backchain (,gi ==> ,q1) (weakening (,gi ==> ,c1) (given (,g ==> ,c1)))))
      (dk-have! `(IN (LIST ,go ,q1) (DERIVABLE tt)) (lambda () (subst `(= ,bo ,i1)) (ass)))
      (dk-meta-derive! 'tt
        `(cut (,g ==> ,q1) (theorem-assumption (,g ==> ,m))
           (forall-elim (,g1 ==> ,q1) (given (,go ==> ,q1))
             (weakening (,g1 ==> (ENC-EQ ,e ,e)) (given (,g ==> (ENC-EQ ,e ,e))))))))))

(sp (make-wff '(FORALL tt (SUBSET (J-MAC tt) (EQV tt)))))
