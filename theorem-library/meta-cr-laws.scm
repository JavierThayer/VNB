       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
       (vs (dk-meta-unpack! ex)) (g (car vs)) (a (cadr vs)) (b (caddr vs)))
  (subst `(= c (LIST ,g ,a)))
  (let ((h1 (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs `(LIST (LIST ,g ,b)))))
    (dk-have! `(= (LIST (LIST ,g ,b)) (LIST (LIST ,g ,b))) (lambda () (rfl)))
    (dk-cite! 'hyps-in-1-elim `(LIST ,g ,b) '(DERIVABLE tt))
    (dk-cite! 'cr-goal-5 'tt 'jj g a b)
    (ass)))
