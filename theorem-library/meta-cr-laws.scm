       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
       (vs (dk-meta-unpack! ex)) (g (car vs)) (f (cadr vs)) (a (caddr vs)) (b (cadddr vs))
       (gd `(CTX-ADD (DIFFERENCE ,g (PAIR ,a ,a)) ,b)) (gb `(CTX-ADD ,g ,b)))
  (dk-rewrite-h! '(IN c SEQ-SET) 'c `(LIST ,g ,f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (subst `(= c (LIST ,g ,f)))
  (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs `(LIST (LIST ,gd ,f)))
  (dk-have! `(= (LIST (LIST ,gd ,f)) (LIST (LIST ,gd ,f))) (lambda () (rfl)))
