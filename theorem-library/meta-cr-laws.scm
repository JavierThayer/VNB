;;; H. STAGE 5 (half of the brief's (d)): the DOMAIN of SEP / BIG-UNION / VNB-LAMBDA rewritten.  The
;;; domain sits outside the binder, so the hole device of stage 4 applies: a fresh FVAR in the outside
;;; list, the body untouched (the name is fresh for it).  The BODY clauses (stages 6 and 7) are not
;;; derivable over the core as it stands: report, section 3.

;; SUBST of a binder node over a literal 1-list.
(sp (make-wff (mr-st '(m u h nb a b) '(IN u EXPR-SET) '(IN h NN) '(IN nb NN) '(IN a EXPR-SET) '(IN b EXPR-SET)
                '(= (EXPR-SUBST (EBIND h nb (LIST a) b) m u) (EBIND h nb (LIST (EXPR-SUBST a m u)) (EXPR-SUBST b m u))))))
(dk-peel!)
(let* ((l '(LIST a)) (sa '(EXPR-SUBST a m u)) (r `(LIST ,sa)) (sb '(EXPR-SUBST b m u)))
  (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (fact 'subst-in-expr 'm 'u 'a)
  (fact 'subst-in-expr 'm 'u 'b)
  (dk-have! `(IN ,r (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (fact 'ebind-in-expr 'h 'nb r sb)
  (subst (dk-cite! 'subst-ebind 'm 'u 'h 'nb l 'b))
  (let* ((fu (dk-cite! 'subst-fun-unfold 'm 'u))
         (lam (caddr fu)))
    (subst fu)
    (let* ((l2 (dk-meta-mapl! lam l 'EXPR-SET 'EXPR-SET
                 (lambda (i) (dk-lam-b!) (fact 'subst-in-expr 'm 'u `(NTH ,i ,l)) (ass))))
           (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH ,(cadr f) ,l2)))) (dk-asms)))
           (len `(= (LENGTH ,l2) (LENGTH ,l)))
           (hyp `(FORALL mrk_ (IMPLIES (AND (IN mrk_ NN) (AND (<= 1 mrk_) (<= mrk_ (LENGTH ,l2))))
                                       (= (NTH mrk_ ,l2) (NTH mrk_ ,r))))))
      (dk-have! `(= (LENGTH ,l2) (LENGTH ,r)) (lambda () (subst len) (len-r) (rfl)))
      (dk-have! `(= (LENGTH ,l) 1) (lambda () (len-r) (rfl)))
      (dk-have! hyp
        (lambda ()
          (dk-peel!)
          (let* ((k (cadr (cadr (dk-goal))))
                 (rng (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f k))) (dk-asms))))
            (if rng (dk-split! rng))
            (let* ((h1 (dk-rewrite-h! `(<= ,k (LENGTH ,l2)) `(LENGTH ,l2) `(LENGTH ,l)))
                   (h2 (dk-rewrite-h! h1 `(LENGTH ,l) 1)))
              (subst (dk-apply! ents k))
              (fact 'nn-one-in)
              (dk-cite! 'nn-le-antisym k 1)
              (subst `(= ,k 1))
              (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
              (dk-lam-b!)
              (rfl)))))
      (dk-cite! 'tuple-extensionality 'EXPR-SET l2 r)
      (subst `(= ,l2 ,r))
      (rfl))))
(qed 'subst-bind1)

;; A name free in the body is free in the binder node.
(sp (make-wff (mr-st '(h nb a b z) '(IN h NN) '(IN nb NN) '(IN a (TUPLES EXPR-SET)) '(IN b EXPR-SET)
                '(IN z (EXPR-FV b)) '(IN z (EXPR-FV (EBIND h nb a b))))))
(dk-peel!)
(subst (dk-cite! 'fv-ebind 'h 'nb 'a 'b))
(let ((iff (dk-meta-iff! 'union-membership '(BIG-UNION mxw_ (MAKE-SET a) (EXPR-FV mxw_)) '(EXPR-FV b) 'z)))
  (dk-have! (caddr iff) (lambda () (oi-r) (ass)))
  (dk-meta-iff-l! iff)
  (ass))
(qed 'fv-bind-body)

;; (a == b)  =>  BIND(h, 1, [a], c) == BIND(h, 1, [b], c).
(sp (make-wff (mr-st '(tt g h a b c) '(IN h NN) '(IN a CLT) '(IN b CLT)
                '(IN (EBIND h 1 (LIST a) c) CLT) '(IN (EBIND h 1 (LIST b) c) CLT)
                '(IN (LIST g (ENC-QEQ a b)) (DERIVABLE tt))
                '(IN (LIST g (ENC-QEQ (EBIND h 1 (LIST a) c) (EBIND h 1 (LIST b) c))) (DERIVABLE tt)))))
(dk-peel!)
(let* ((e1 '(EBIND h 1 (LIST a) c)) (e2 '(EBIND h 1 (LIST b) c)) (q0 '(ENC-QEQ a b)))
  (dk-cite! 'der-in-seq 'tt `(LIST g ,q0))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g q0)))
  (for-each (lambda (v) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clt-iff v)))) (list 'a 'b e1 e2))
  (fact 'nn-one-in)
  (dk-cite! 'ebind-body-expr 'h 1 '(LIST a) 'c)
  (let* ((z (dk-skolem! (dk-cite! 'fresh-name-exists 'g e1) #t))
         (zfresh `(NOT (IN ,z (UNION (CTX-FV g) (EXPR-FV ,e1)))))
         (ez `(EBIND h 1 (LIST (EFVAR ,z)) c))
         (p `(EAPP 9 (LIST ,e1 ,ez)))
         (q `(ENC-QEQ b a)) (g1 `(CTX-ADD g ,q)))
    (dk-have! `(NOT (IN ,z (EXPR-FV ,e1)))
      (lambda () (di) (dk-meta-keep-prop! (dk-meta-iff! 'union-membership '(CTX-FV g) `(EXPR-FV ,e1) z)
                                          `(IN ,z (EXPR-FV ,e1)) zfresh)))
    (dk-have! '(IN (LIST a) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (dk-have! `(NOT (IN ,z (EXPR-FV c)))
      (lambda () (di) (dk-cite! 'fv-bind-body 'h 1 '(LIST a) 'c z) (ai `(NOT (IN ,z (EXPR-FV ,e1))))))
    (fact 'efvar-in-expr z)
    (dk-have! `(IN (LIST (EFVAR ,z)) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'ebind-in-expr 'h 1 `(LIST (EFVAR ,z)) 'c)
    (dk-have! '(IN 9 NN) (lambda () (arith)))
    (dk-have! `(IN (LIST ,e1 ,ez) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'eapp-in-expr 9 `(LIST ,e1 ,ez))
    (for-each (lambda (s target)
                (dk-have! `(= (EXPR-SUBST ,p ,z ,s) (EAPP 9 (LIST ,e1 ,target)))
                  (lambda ()
                    (subst (dk-cite! 'subst-app2 z s 9 e1 ez))
                    (subst (dk-cite! 'subst-fresh z s e1))
                    (subst (dk-cite! 'subst-bind1 z s 'h 1 `(EFVAR ,z) 'c))
                    (subst (dk-cite! 'subst-efvar-hit z s))
                    (subst (dk-cite! 'subst-fresh z s 'c))
                    (dk-have! `(IN (LIST ,e1 ,target) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
                    (fact 'eapp-in-expr 9 `(LIST ,e1 ,target))
                    (rfl))))
              (list 'a 'b) (list e1 e2))
