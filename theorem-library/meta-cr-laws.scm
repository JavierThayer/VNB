(sp (make-wff '(FORALL tt (FORALL jj (FORALL hs (FORALL c (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (REL-REWRITE-HYP-1 jj hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))
(dk-peel!)
