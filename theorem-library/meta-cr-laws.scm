;; THE LOCAL STEP of each reduction rule is a core schema: nth-eq, length-eq, lambda-beta-eq.
(define (mr-jsub! jname core lhs-of rhs-of side-of)
  ;; goal (SUBSET (JNAME tt) (EQV tt)); the J condition's witnesses vs; the derivation of the
  ;; quasi-equation by the core rule CORE from the given side sequent
  (sp (make-wff `(FORALL tt (SUBSET (,jname tt) (EQV tt)))))
  (di)
  (mac jname)
  (mac 'subset-def)
  (dk-peel!)
  (let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))
         (x (cadr m))
         (landed (dk-landed (lambda () (sep-me m))))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
         (vs (dk-meta-unpack! ex))
         (lhs (lhs-of vs)) (rhs (rhs-of vs)) (g (car vs)) (side (side-of vs))
         (q `(ENC-QEQ ,lhs ,rhs)))
    (dk-cite! 'der-in-seq 'tt `(LIST ,g ,side))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g side)))
    (dk-cite! 'clf-qeq-intro lhs rhs)
    (dk-derive! 'tt `(,core (,g ==> ,q) (given (,g ==> ,side))))
    (subst `(= ,x (LIST 1 ,g ,lhs ,rhs)))
    (dk-cite! 'eqv-t-intro 'tt g lhs rhs)
    (ass)))

(mr-jsub! 'J-NTH 'nth-eq
