;;; sip-c.scm -- EQUALITY ALMOST EVERYWHERE, REAL AND COMPLEX L^2 (SIP-1, 2026-10-18; STOP POINT C
;;; of scratchpad/triage/SIP-1.md).  All PROVEN modulo 0.
;;; Vocabulary: structure-library/sip-l2-vocab.scm.
;;;
;;;   * AE-SETOID(omega, cA, mu, S) is a setoid (ae-setoid-is-setoid); null sets are closed under
;;;     binary union (ae-null-union).
;;;   * Missing measure lemmas, proven here: the product of two real measurable functions is
;;;     measurable (real-measurable-mul), domination by an integrable function gives
;;;     integrability (integrable-dominated), constants are real measurable, and integrability,
;;;     the integral and measurability transfer along pointwise equality.
;;;   * Real L^2 (square-integrable real measurable functions, <f,g> = integral of f g) is a
;;;     SEMI-INNER-PRODUCT-SPACE (l2-space-is-sip); <f-g, f-g> = 0 iff f = g almost everywhere
;;;     (l2-null-iff-ae); so its null relation IS equality a.e. and its null-vector quotient IS
;;;     its AE quotient (l2-null-rel-is-ae-rel, l2-setoid-is-ae-setoid, l2-quotient-is-ae-quotient),
;;;     a pre-Hilbert space (l2-quotient-is-pre-hilbert).
;;;   * Complex L^2 = COMPLEXIFY(real L^2): a complex semi-inner-product space whose quotient is a
;;;     complex pre-Hilbert space and, by (37)-(38), a COMPLEX-INNER-PRODUCT-SPACE.
;;;
;;; Helper prefix: sipl-.
;;;
;;; LOAD WINDOW: after structure-library/sip-l2-vocab, theorem-library/sip-b and
;;; theorem-library/product-measure (cartesian-membership-nth, the latest citation); nothing in the
;;; tree cites this file.  Library: measure.

(define (sipl-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** sip-c: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "sip-c: unfinished" name))))

;;; the parts of IS-MEASURE that are needed, each read on a lane (the hypothesis survives)
(define (sipl-measure-parts!)
  (let ((h '(IS-MEASURE omega cA mu)))
    (dk-have! '(IS-SIGMA-ALGEBRA omega cA) (lambda () (mac-h 'IS-MEASURE h) (dk-split-all!) (ass)))
    (dk-have! '(IN mu (FUN cA RR-POS-STAR)) (lambda () (mac-h 'IS-MEASURE h) (dk-split-all!) (ass)))
    (dk-have! '(= (mu EMPTY-SET) 0) (lambda () (mac-h 'IS-MEASURE h) (dk-split-all!) (ass)))))

;;; the empty set is null
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-NULL-SET omega cA mu EMPTY-SET)))))))
(dk-peel!)
(sipl-measure-parts!)
(fact 'sigma-algebra-empty-in 'omega 'cA)
(fact 'empty-subset-any 'EMPTY-SET)
(mac 'IS-NULL-SET)
(ew 'EMPTY-SET)
(dk-conj-close! (lambda () (ass)))
(sipl-qed! 'ae-null-empty)

;;; a union of two null sets is null
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL na_ (FORALL nb_ (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-NULL-SET omega cA mu na_) (IMPLIES (IS-NULL-SET omega cA mu nb_)
    (IS-NULL-SET omega cA mu (UNION na_ nb_))))))))))))
(dk-peel!)
(sipl-measure-parts!)
(let* ((a1 (dk-skolem! (dk-landed-1 (lambda () (mac-h 'IS-NULL-SET '(IS-NULL-SET omega cA mu na_))))))
       (a2 (dk-skolem! (dk-landed-1 (lambda () (mac-h 'IS-NULL-SET '(IS-NULL-SET omega cA mu nb_))))))
       (u (list 'UNION a1 a2))
       (d (list 'COMPLEMENT-IN a2 a1)))
  (fact 'sigma-algebra-binary-union 'omega 'cA a1 a2)
  (fact 'sigma-algebra-difference-closed 'omega 'cA a2 a1)
  ;; the two subsets as universals
  (let ((s1 (dk-cite! 'subset-def 'na_ a1)) (s2 (dk-cite! 'subset-def 'nb_ a2)))
    (dk-have! (list 'FORALL 'sw_ (list 'IMPLIES '(IN sw_ na_) (list 'IN 'sw_ a1)))
      (lambda () (let ((h (dk-pick (lambda (f) (equal? f (list 'SUBSET 'na_ a1))) "the subset")))
                   (mac-h 'subset-def h) (ass))))
    (dk-have! (list 'FORALL 'sw_ (list 'IMPLIES '(IN sw_ nb_) (list 'IN 'sw_ a2)))
      (lambda () (let ((h (dk-pick (lambda (f) (equal? f (list 'SUBSET 'nb_ a2))) "the subset")))
                   (mac-h 'subset-def h) (ass)))))
  (mac 'IS-NULL-SET)
  (ew u)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def)
           (let* ((w (dk-di-var!)))
             (dk-cite! 'union-membership 'na_ 'nb_ w)
             (dk-cite! 'union-membership a1 a2 w)
             (let ((i1 (inst*! (list 'FORALL 'sw_ (list 'IMPLIES '(IN sw_ na_) (list 'IN 'sw_ a1))) w))
                   (i2 (inst*! (list 'FORALL 'sw_ (list 'IMPLIES '(IN sw_ nb_) (list 'IN 'sw_ a2))) w)))
               (let ((fs (filter (lambda (f) (and (dk-contains? f w) (not (dk-head-is? f 'IN)))) (dk-asms))))
                 (apply dk-only! (cons (list 'IN w '(UNION na_ nb_)) fs))
                 (prop)))))
          (#t
           ;; mu(a1 u a2) = mu(a1 u (a2 \ a1)) = mu(a1) + mu(a2 \ a1) = 0 + 0
           (fact 'union-as-disjoint a1 a2)
           (subst (list '= u (list 'UNION a1 d)))
           (dk-have! (list '= (list 'INTERSECTION a1 d) 'EMPTY-SET)
             (lambda ()
               (dk-have! (list 'FORALL 'sw_ (list 'IFF (list 'IN 'sw_ (list 'INTERSECTION a1 d)) '(IN sw_ EMPTY-SET)))
                 (lambda ()
                   (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
                     (dk-cite! 'intersection-membership a1 d w)
                     (dk-cite! 'complement-in-membership a2 a1 w)
                     (dk-cite! 'empty-set-has-no-members w)
                     (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
                     (prop))))
               (fact 'class-extensionality (list 'INTERSECTION a1 d) 'EMPTY-SET)
               (ass)))
           (fact 'measure-finitely-additive 'omega 'cA 'mu a1 d)
           (dk-have! (list 'SUBSET d a2)
             (lambda ()
               (mac 'subset-def)
               (let ((w (dk-di-var!)))
                 (dk-cite! 'complement-in-membership a2 a1 w)
                 (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
                 (prop))))
           (dk-have! (list 'IN (list 'mu a2) 'RR) (lambda () (subst (list '= (list 'mu a2) 0)) (arith)))
           (fact 'measure-finite-subset 'omega 'cA 'mu d a2)
           (fact 'measure-monotone 'omega 'cA 'mu d a2)
           (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR d)
           (fact 'rr-pos-star-nonneg (list 'mu d))
           (dk-have! (list '= (list 'mu d) 0)
             (lambda () (dk-ineq! (list '<= (list 'mu d) (list 'mu a2)) (list '= (list 'mu a2) 0)
                                  (list '<= 0 (list 'mu d)) (list 'IN (list 'mu d) 'RR) (list 'IN (list 'mu a2) 'RR))))
           (subst (list '= (list 'mu (list 'UNION a1 d)) (list 'eplus (list 'mu a1) (list 'mu d))))
           (subst (list '= (list 'mu a1) 0))
           (subst (list '= (list 'mu d) 0))
           (fact 'zero-in-rr-pos-star)
           (fact 'eplus-zero-left 0)
           (ass)))))))
(sipl-qed! 'ae-null-union)

;;; ---- the relation, in and out ----------------------------------------------------------
(define sipl-ae '(AE-REL omega cA mu sf))
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL sf (== (AE-REL omega cA mu sf)
  (SEP aep_ (CARTESIAN sf sf)
     (FORSOME aen_ (AND (IS-NULL-SET omega cA mu aen_)
       (FORALL aex_ (IMPLIES (IN aex_ omega)
         (IMPLIES (NOT (IN aex_ aen_)) (= ((NTH 1 aep_) aex_) ((NTH 2 aep_) aex_)))))))))))))))
(dk-peel!)
(mac 'AE-REL)
(qrfl)
(sipl-qed! 'ae-rel-unfold)

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL sf (FORALL af_ (IMPLIES (IN af_ sf) (FORALL ag_ (IMPLIES (IN ag_ sf)
  (FORALL ns_ (IMPLIES (IS-NULL-SET omega cA mu ns_)
    (IMPLIES (FORALL ax_ (IMPLIES (IN ax_ omega) (IMPLIES (NOT (IN ax_ ns_)) (= (af_ ax_) (ag_ ax_)))))
      (IN (LIST af_ ag_) (AE-REL omega cA mu sf)))))))))))))))
(dk-peel!)
(mac 'AE-REL)
(in-sep! (lambda () (fact 'pair-in-cartesian 'sf 'sf 'af_ 'ag_) (ass))
         (lambda () (nth-r) (ew 'ns_) (dk-conj-close! (lambda () (ass)))))
(sipl-qed! 'ae-rel-in)

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL sf (FORALL af_ (FORALL ag_
  (IMPLIES (IN (LIST af_ ag_) (AE-REL omega cA mu sf))
    (FORSOME aen_ (AND (IS-NULL-SET omega cA mu aen_)
      (FORALL aex_ (IMPLIES (IN aex_ omega) (IMPLIES (NOT (IN aex_ aen_)) (= (af_ aex_) (ag_ aex_))))))))))))))))
(dk-peel!)
(let* ((h  (dk-landed-1 (lambda () (mac-h 'ae-rel-unfold '(IN (LIST af_ ag_) (AE-REL omega cA mu sf))))))
       (ls (dk-landed (lambda () (sep-me h))))
       (c  (or (any-pred (lambda (f) (dk-head-is? f 'FORSOME)) ls) (error "ae-rel-out: no condition"))))
  (dk-nth-h! c))
(ass)
(sipl-qed! 'ae-rel-out)

;;; ---- equality almost everywhere is an equivalence on a set of real functions on omega --------
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL sf (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IN sf SET) (IMPLIES (SUBSET sf (FUN omega RR))
    (is-equivalence (AE-REL omega cA mu sf) sf))))))))))
(dk-peel!)
(fact 'ae-null-empty 'omega 'cA 'mu)
(define (sipl-typed! u)                 ; u in sf  =>  u in FUN(omega, RR)
  (dk-have! (list 'IN u '(FUN omega RR))
    (lambda () (let ((h (dk-cite! 'subset-def 'sf '(FUN omega RR))))
                 (dk-have! '(FORALL tsw_ (IMPLIES (IN tsw_ sf) (IN tsw_ (FUN omega RR))))
                   (lambda () (mac-h 'subset-def '(SUBSET sf (FUN omega RR))) (ass)))
                 (inst*! '(FORALL tsw_ (IMPLIES (IN tsw_ sf) (IN tsw_ (FUN omega RR)))) u)
                 (ass)))))
(define (sipl-open-rel! u w)            ; u ~ w in context: land its null set and its universal
  (let* ((ex (dk-cite! 'ae-rel-out 'omega 'cA 'mu 'sf u w))
         (n  (dk-skolem! ex)))
    n))
(mac 'is-equivalence)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
          (begin
            (mac 'AE-REL)
            (mac 'power-set-membership)
            (dk-conj-close!
              (lambda ()
                (let ((g2 (dk-goal)))
                  (if (and (dk-head-is? g2 'IN) (eq? (caddr g2) 'SET))
                      (begin (sep-set)
                             (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                 (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))
                      (let* ((lk (dk-peel!))
                             (h (any-pred (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'SEP))) lk)))
                        (sep-me h)
                        (ass)))))))
          (let* ((lk (dk-peel!))
                 (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'sf))) lk))))
            (for-each sipl-typed! vs)
            (cond
              ((= (length vs) 1)            ; reflexivity, off the empty set
               (let ((u (car vs)))
                 (dk-have! (list 'FORALL 'ax_ (list 'IMPLIES '(IN ax_ omega) (list 'IMPLIES '(NOT (IN ax_ EMPTY-SET)) (list '= (list u 'ax_) (list u 'ax_)))))
                   (lambda () (let ((lk2 (dk-peel!)))
                                (fact 'fun-apply-type-c u 'omega 'RR (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) lk2))))
                                (rfl))))
                 (fact 'ae-rel-in 'omega 'cA 'mu 'sf u u 'EMPTY-SET)
                 (ass)))
              ((= (length vs) 2)            ; symmetry, off the same null set
               (let* ((u (car vs)) (w (cadr vs))
                      (rel (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list 'LIST u w)))) "the relation"))
                      (n (sipl-open-rel! u w))
                      (al (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n))) "the agreement")))
                 (dk-have! (list 'FORALL 'ax_ (list 'IMPLIES '(IN ax_ omega) (list 'IMPLIES (list 'NOT (list 'IN 'ax_ n)) (list '= (list w 'ax_) (list u 'ax_)))))
                   (lambda ()
                     (let* ((lk2 (dk-peel!)) (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'omega))) lk2)))))
                       (inst*! al x)
                       (fact 'fun-apply-type-c u 'omega 'RR x)
                       (subst (list '= (list w x) (list u x)))
                       (rfl))))
                 (fact 'ae-rel-in 'omega 'cA 'mu 'sf w u n)
                 (ass)))
              (#t                            ; transitivity, off the union
               (dk-split-all!)
               (let* ((u (car vs)) (m (cadr vs)) (w (caddr vs))
                      (n1 (sipl-open-rel! u m))
                      (a1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n1))) "the first agreement"))
                      (n2 (sipl-open-rel! m w))
                      (a2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n2))) "the second agreement"))
                      (n (list 'UNION n1 n2)))
                 (fact 'ae-null-union 'omega 'cA 'mu n1 n2)
                 (dk-have! (list 'FORALL 'ax_ (list 'IMPLIES '(IN ax_ omega) (list 'IMPLIES (list 'NOT (list 'IN 'ax_ n)) (list '= (list u 'ax_) (list w 'ax_)))))
                   (lambda ()
                     (let* ((lk2 (dk-peel!)) (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'omega))) lk2))))
                            (out (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (equal? (cadr f) (list 'IN x n)))) "off the union")))
                       (dk-cite! 'union-membership n1 n2 x)
                       (dk-have! (list 'NOT (list 'IN x n1)) (lambda () (if (dk-only! out (dk-pick (lambda (f) (dk-head-is? f 'IFF)) "union")) (prop))))
                       (dk-have! (list 'NOT (list 'IN x n2)) (lambda () (if (dk-only! out (dk-pick (lambda (f) (dk-head-is? f 'IFF)) "union")) (prop))))
                       (inst*! a1 x)
                       (inst*! a2 x)
                       (fact 'fun-apply-type-c w 'omega 'RR x)
                       (subst (list '= (list u x) (list m x)))
                       (subst (list '= (list m x) (list w x)))
                       (rfl))))
                 (fact 'ae-rel-in 'omega 'cA 'mu 'sf u w n)
                 (ass)))))))))
(sipl-qed! 'ae-rel-is-equivalence)

;;; AE-SETOID(omega, cA, mu, sf) is a setoid.
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL sf (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IN sf SET) (IMPLIES (SUBSET sf (FUN omega RR))
    (IS-SETOID (AE-SETOID omega cA mu sf)))))))))))
(dk-peel!)
(fact 'ae-rel-is-equivalence 'omega 'cA 'mu 'sf)
(mac 'IS-SETOID)
(slot 'pts)
(slot 'rel)
(mac 'AE-SETOID)
(nth-r)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
             (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
            ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
             (let ((h (dk-pick (lambda (f) (dk-head-is? f 'is-equivalence)) "the equivalence")))
               (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-EQUIVALENCE h)))))
               (ass)))
            (#t (error "ae-setoid-is-setoid: unexpected conjunct" (expression->string g)))))))
(sipl-qed! 'ae-setoid-is-setoid)
(alias! 'ae-setoid-is-setoid "equality almost everywhere is a setoid")

;;; ==========================================================================================
;;; THE PRODUCT OF TWO REAL MEASURABLE FUNCTIONS IS MEASURABLE (absent from the tree; the
;;; real L^2 form needs it).  The parts of the product are sums of products of parts:
;;;   (fg)^+ = f^+ g^+ + f^- g^-        (fg)^- = f^+ g^- + f^- g^+
;;; pointwise, each a nonnegative extended function measurable by measurable-fn-etimes and
;;; measurable-fn-eplus.  The pointwise identities need no case analysis: by part-values-at,
;;; f^+ = (|f| + f)/2 and f^- = (|f| - f)/2, and |fg| = |f||g| (rr-abs-mult), so both are
;;; ring identities.
;;; ==========================================================================================
(define sipl-P '(VNB-LAMBDA sx_ omega (* (f sx_) (g sx_))))
(define (sipl-pp h) (list 'POS-PART 'omega h))
(define (sipl-np h) (list 'NEG-PART 'omega h))
(define (sipl-et a b) (list 'PTWISE-ETIMES 'omega a b))
(define (sipl-ep a b) (list 'PTWISE-EPLUS 'omega a b))
;;; at the point v: the two parts of H (in FUN(omega, RR)) as linear expressions in H(v), |H(v)|
(define (sipl-parts-at! h hv v)
  (dk-split-all! (list (dk-cite! 'part-values-at 'omega h v)))
  (let ((pv (list (sipl-pp h) v)) (nv (list (sipl-np h) v)))
    (dk-cite! 'rr-abs-closed hv)
    (dk-have! (list '= pv (list '* 1/2 (list '+ (list 'abs hv) hv)))
      (lambda () (dk-ineq! (list '= hv (list '- pv nv)) (list '= (list 'abs hv) (list '+ pv nv))
                           (list 'IN pv 'RR) (list 'IN nv 'RR) (list 'IN hv 'RR) (list 'IN (list 'abs hv) 'RR))))
    (dk-have! (list '= nv (list '* 1/2 (list '- (list 'abs hv) hv)))
      (lambda () (dk-ineq! (list '= hv (list '- pv nv)) (list '= (list 'abs hv) (list '+ pv nv))
                           (list 'IN pv 'RR) (list 'IN nv 'RR) (list 'IN hv 'RR) (list 'IN (list 'abs hv) 'RR))))))
;;; the value of a product/sum of two nonnegative real parts, rewritten to real arithmetic
(define (sipl-et-value! a b v)          ; (PTWISE-ETIMES a b)(v) = a(v) * b(v), a(v), b(v) nonneg reals
  (let ((av (list a v)) (bv (list b v)))
    (dk-cite! 'rmc-rps-of-nonneg av) (dk-cite! 'rmc-rps-of-nonneg bv)
    (dk-cite! 'ptwise-etimes-value 'omega a b v)
    (dk-cite! 'etimes-real-defined av bv)
    (dk-cite! 'bintimes-apply av bv)
    (subst (list '= (list (sipl-et a b) v) (list 'etimes av bv)))
    (subst (list '= (list 'etimes av bv) (list 'bintimes av bv)))
    (subst (list '= (list 'bintimes av bv) (list '* av bv)))))

(define (sipl-mul-nonneg! a b)          ; 0 <= a*b from 0 <= a, 0 <= b (reals) in context
  (dk-have! (list '<= 0 (list '* a b))
    (lambda ()
      (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! (list 'AND (list '<= 0 a) (list '<= 0 b)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (fact 'rr-leq-mul-nonneg a b)
      (ass))))
(define (sipl-mul-part! pos?)
  ;; goal: (IS-MEASURABLE-FN omega cA (POS-PART omega P)) or NEG-PART
  (let* ((pf (sipl-pp 'f)) (nf (sipl-np 'f)) (pg (sipl-pp 'g)) (ng (sipl-np 'g))
         (lhs (if pos? (sipl-pp sipl-P) (sipl-np sipl-P)))
         (ta (if pos? (sipl-et pf pg) (sipl-et pf ng)))
         (tb (if pos? (sipl-et nf ng) (sipl-et nf pg)))
         (rhs (sipl-ep ta tb)))
    (for-each (lambda (h) (fact 'pos-part-fun 'omega h) (fact 'neg-part-fun 'omega h)) '(f g))
    (dk-fun-ext! lhs rhs 'omega 'RR-POS-STAR
      (lambda () (fact (if pos? 'pos-part-fun 'neg-part-fun) 'omega sipl-P) (ass))
      (lambda ()
        (mac 'PTWISE-EPLUS)
        (dk-lam-type!
          (lambda ()
            (let* ((lk (dk-peel!)) (x (cadr (car lk))))
              (for-each (lambda (h) (dk-cite! 'fun-apply-type-c h 'omega 'RR-POS-STAR x)) (list pf nf pg ng))
              (for-each (lambda (pr)
                          (let ((a (car pr)) (b (cdr pr)))
                            (dk-cite! 'ptwise-etimes-value 'omega a b x)
                            (dk-have! (list 'AND (list 'IN (list a x) 'RR-POS-STAR) (list 'IN (list b x) 'RR-POS-STAR))
                                      (lambda () (dk-conj-close! (lambda () (ass)))))
                            (dk-cite! 'etimes-closed (list a x) (list b x))
                            (dk-have! (list 'IN (list (sipl-et a b) x) 'RR-POS-STAR)
                              (lambda () (subst (list '= (list (sipl-et a b) x) (list 'etimes (list a x) (list b x)))) (ass)))))
                        (if pos? (list (cons pf pg) (cons nf ng)) (list (cons pf ng) (cons nf pg))))
              (dk-have! (list 'AND (list 'IN (list ta x) 'RR-POS-STAR) (list 'IN (list tb x) 'RR-POS-STAR))
                        (lambda () (dk-conj-close! (lambda () (ass)))))
              (fact 'eplus-closed (list ta x) (list tb x))
              (ass)))))
      (lambda (v)
        (let* ((fv (list 'f v)) (gv (list 'g v)) (pvv (list sipl-P v)))
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR v)
          (dk-cite! 'fun-apply-type-c 'g 'omega 'RR v)
          (dk-real! (list '* fv gv))
          (dk-have! (list '= pvv (list '* fv gv)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
          (dk-cite! 'fun-apply-type-c sipl-P 'omega 'RR v)
          (sipl-parts-at! 'f fv v)
          (sipl-parts-at! 'g gv v)
          (sipl-parts-at! sipl-P pvv v)
          (dk-have! (list 'AND (list 'IN fv 'RR) (list 'IN gv 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-cite! 'rr-abs-mult fv gv)
          ;; the right side: eplus of two etimes of nonnegative reals.  Each product's value
          ;; first, on a lane, so its typing in [0, +inf] is in hand for ptwise-eplus-value.
          (for-each (lambda (h) (dk-cite! 'fun-apply-type-c h 'omega 'RR-POS-STAR v)) (list pf nf pg ng))
          (let ((tav (list ta v)) (tbv (list tb v)))
            (for-each
              (lambda (t)
                (let* ((a (cadr (cdr t))) (b (caddr (cdr t))) (av (list a v)) (bv (list b v))
                       (prod (list '* av bv)))
                  (dk-real! prod)
                  (dk-have! (list '= (list t v) prod) (lambda () (sipl-et-value! a b v) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                  (sipl-mul-nonneg! av bv)
                  (dk-have! (list 'IN (list t v) 'RR-POS-STAR)
                    (lambda () (subst (list '= (list t v) prod)) (dk-cite! 'rmc-rps-of-nonneg prod) (ass)))))
              (list ta tb))
            (dk-cite! 'ptwise-eplus-value 'omega ta tb v)
            (subst (list '= (list rhs v) (list 'eplus tav tbv)))
            (let* ((pa (list '* (list (cadr (cdr ta)) v) (list (caddr (cdr ta)) v)))
                   (pb (list '* (list (cadr (cdr tb)) v) (list (caddr (cdr tb)) v))))
              (subst (list '= tav pa))
              (subst (list '= tbv pb))
              (sipl-mul-nonneg! (cadr pa) (caddr pa))
              (sipl-mul-nonneg! (cadr pb) (caddr pb))
              (dk-cite! 'eplus-real-defined pa pb)
              (dk-cite! 'binplus-apply pa pb)
              (subst (list '= (list 'eplus pa pb) (list 'binplus pa pb)))
              (subst (list '= (list 'binplus pa pb) (list '+ pa pb)))))
          ;; everything to |f(v)|, f(v), |g(v)|, g(v)
          (for-each (lambda (pv) (subst (list '= (list pv v) (caddr (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list pv v)))) "a part value")))))
                    (list pf nf pg ng (if pos? (sipl-pp sipl-P) (sipl-np sipl-P))))
          (subst (list '= pvv (list '* fv gv)))
          (subst (list '= (list 'abs (list '* fv gv)) (list '* (list 'abs fv) (list 'abs gv))))
          (crs))))
    (subst (list '= lhs rhs))
    (fact 'measurable-fn-etimes 'omega 'cA (cadr (cdr ta)) (caddr (cdr ta)))
    (fact 'measurable-fn-etimes 'omega 'cA (cadr (cdr tb)) (caddr (cdr tb)))
    (fact 'measurable-fn-eplus 'omega 'cA ta tb)
    (ass)))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'f (list 'FORALL 'g
  (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega cA f) (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega cA g)
    (list 'IS-REAL-MEASURABLE-FN 'omega 'cA sipl-P)))))))))
(dk-peel!)
(for-each (lambda (h)
            (let ((hy (list 'IS-REAL-MEASURABLE-FN 'omega 'cA h)))
              (for-each (lambda (c) (dk-have! c (lambda () (mac-h 'IS-REAL-MEASURABLE-FN hy) (dk-split-all!) (ass))))
                        (list (list 'IN h '(FUN omega RR))
                              (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-pp h))
                              (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-np h))))))
          '(f g))
(fact 'fun-domain-in-set 'omega 'RR 'f)
(dk-have! (list 'IN sipl-P '(FUN omega RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((lk (dk-peel!)) (x (cadr (car lk))) (leaf (proof-state-focus *ps*)))
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
          (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
          (dk-real! (list '* (list 'f x) (list 'g x)))     ; may close the leaf in place
          (if (not (sequent-node-grounded? leaf)) (ass)))))))
(mac 'IS-REAL-MEASURABLE-FN)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((equal? g (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-pp sipl-P))) (sipl-mul-part! #t))
            ((equal? g (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-np sipl-P))) (sipl-mul-part! #f))
            (#t (error "real-measurable-mul: unexpected conjunct" (expression->string g)))))))
(sipl-qed! 'real-measurable-mul)
(alias! 'real-measurable-mul "the product of two real measurable functions is measurable")

;;; ==========================================================================================
;;; REAL L^2.  Each statement is guarded by IS-MEASURE(omega, cA, mu).
;;; ==========================================================================================
(define sipl-L2 '(L2-SET omega cA mu))
(define (sipl-has-redex?)                 ; a lambda applied somewhere in the goal
  (let walk ((e (dk-goal)))
    (and (pair? e) (list? e) (or (and (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) (any-pred walk e)))))
(define (sipl-beta-all! leaf)             ; beta to a fixpoint while the leaf is open and a redex remains
  (let loop ((n 8))
    (if (and (> n 0) (not (sequent-node-grounded? leaf)) (sipl-has-redex?))
        (begin (dk-lam-b!) (loop (- n 1))))))
(define (sipl-beta-rfl!)                  ; beta the goal, then rfl if it is still open
  (let ((lf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? lf)) (rfl))))
(define (sipl-sq h) (list 'VNB-LAMBDA 'lx_ 'omega (list '* (list h 'lx_) (list h 'lx_))))
(define (sipl-prod h k) (list 'VNB-LAMBDA 'lx_ 'omega (list '* (list h 'lx_) (list k 'lx_))))
(define (sipl-proj! hyp-head hyp claims)  ; read CLAIMS off the predicate HYP on lanes
  (for-each (lambda (c) (dk-have! c (lambda () (mac-h hyp-head hyp) (dk-split-all!) (ass)))) claims))
(define (sipl-integrable-parts! h)        ; IS-INTEGRABLE(h) in context: its three conjuncts
  (sipl-proj! 'IS-INTEGRABLE (list 'IS-INTEGRABLE 'omega 'cA 'mu h)
    (list (list 'IS-REAL-MEASURABLE-FN 'omega 'cA h)
          (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (sipl-pp h)) 'RR)
          (list 'IN (list 'INTEGRAL 'omega 'cA 'mu (sipl-np h)) 'RR))))
(define (sipl-measurable-parts! h)        ; IS-REAL-MEASURABLE-FN(h) in context: its conjuncts
  (sipl-proj! 'IS-REAL-MEASURABLE-FN (list 'IS-REAL-MEASURABLE-FN 'omega 'cA h)
    (list (list 'IN h '(FUN omega RR))
          (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-pp h))
          (list 'IS-MEASURABLE-FN 'omega 'cA (sipl-np h)))))

;;; DOMINATION: a real measurable function dominated in absolute value by an integrable one is
;;; integrable.
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL h (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-INTEGRABLE omega cA mu h) (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f)
    (IMPLIES (FORALL dx_ (IMPLIES (IN dx_ omega) (<= (abs (f dx_)) (abs (h dx_)))))
      (IS-INTEGRABLE omega cA mu f))))))))))))
(dk-peel!)
(sipl-integrable-parts! 'h)
(sipl-measurable-parts! 'h)
(sipl-measurable-parts! 'f)
(dk-split-all! (list (dk-cite! 'integral-abs-fn 'omega 'cA 'mu 'f)))
(dk-split-all! (list (dk-cite! 'integral-abs-fn 'omega 'cA 'mu 'h)))
(let* ((af '(ABS-FN omega f)) (ah '(ABS-FN omega h))
       (iaf (list 'INTEGRAL 'omega 'cA 'mu af)) (iah (list 'INTEGRAL 'omega 'cA 'mu ah))
       (ih (dk-cite! 'integrable-iff-abs-finite 'omega 'cA 'mu 'h))
       (if_ (dk-cite! 'integrable-iff-abs-finite 'omega 'cA 'mu 'f))
       (dom (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'abs))) "the domination")))
  (dk-have! (list 'IN iah 'RR) (lambda () (if (dk-only! ih '(IS-INTEGRABLE omega cA mu h)) (prop))))
  (dk-have! (list 'PTWISE-LE 'omega af ah)
    (lambda ()
      (mac 'PTWISE-LE)
      (let* ((lk (dk-peel!)) (x (cadr (car lk))))
        (dk-cite! 'abs-fn-value 'omega 'f x)
        (dk-cite! 'abs-fn-value 'omega 'h x)
        (subst (list '= (list af x) (list 'abs (list 'f x))))
        (subst (list '= (list ah x) (list 'abs (list 'h x))))
        (inst*! dom x)
        (ass))))
  (fact 'integral-monotone 'omega 'cA 'mu af ah)
  (fact 'integral-in 'omega 'cA 'mu af)
  (dk-have! (list 'AND (list 'IN iaf 'RR-POS-STAR) (list 'IN iah 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'rr-pos-star-le-real-in-rr iaf iah)
  (dk-only! if_ (list 'IN iaf 'RR))
  (prop))
(sipl-qed! 'integrable-dominated)

;;; equal functions: integrability and the integral transfer
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL h
  (IMPLIES (IN f (FUN omega RR)) (IMPLIES (IN h (FUN omega RR))
    (IMPLIES (FORALL ex_ (IMPLIES (IN ex_ omega) (= (f ex_) (h ex_))))
      (IMPLIES (IS-INTEGRABLE omega cA mu f)
        (AND (IS-INTEGRABLE omega cA mu h) (= (RINTEGRAL omega cA mu h) (RINTEGRAL omega cA mu f))))))))))))))
(dk-peel!)
(let ((pw (dk-pick (lambda (f) (dk-head-is? f 'FORALL)) "the pointwise equality")))
  (dk-fun-ext! 'f 'h 'omega 'RR #f #f
    (lambda (v) (inst*! pw v) (ass))))
(subst '(= h f))
(sipl-integrable-parts! 'f)
(dk-have! '(IN (RINTEGRAL omega cA mu f) RR)
  (lambda () (mac 'rintegral-unfold) (type-term)))
(dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))
(sipl-qed! 'integrable-ptwise-eq)

;;; ---- membership of L^2 ----------------------------------------------------------------------
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (== (L2-SET omega cA mu)
  (SEP lf_ (FUN omega RR)
     (AND (IS-REAL-MEASURABLE-FN omega cA lf_)
          (IS-INTEGRABLE omega cA mu (VNB-LAMBDA lx_ omega (* (lf_ lx_) (lf_ lx_))))))))))))
(dk-peel!)
(mac 'L2-SET)
(qrfl)
(sipl-qed! 'l2-unfold)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'f
  (list 'IMPLIES '(IN f (FUN omega RR)) (list 'IMPLIES '(IS-REAL-MEASURABLE-FN omega cA f)
    (list 'IMPLIES (list 'IS-INTEGRABLE 'omega 'cA 'mu (sipl-sq 'f)) (list 'IN 'f sipl-L2))))))))))
(dk-peel!)
(mac 'L2-SET)
(in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass)))))
(sipl-qed! 'l2-in)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'f
  (list 'IMPLIES (list 'IN 'f sipl-L2)
    (list 'AND '(IN f (FUN omega RR)) (list 'AND '(IS-REAL-MEASURABLE-FN omega cA f)
                                            (list 'IS-INTEGRABLE 'omega 'cA 'mu (sipl-sq 'f)))))))))))
(dk-peel!)
(let ((h (dk-landed-1 (lambda () (mac-h 'l2-unfold (list 'IN 'f sipl-L2))))))
  (sep-me h))
(dk-split-all!)
(dk-conj-close! (lambda () (ass)))
(sipl-qed! 'l2-out)
(define (sipl-l2-open! f)               ; f in L2 in context: land its three properties
  (dk-split-all! (list (dk-cite! 'l2-out 'omega 'cA 'mu f))))

;;; real measurability transfers along pointwise equality
(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (FORALL h
  (IMPLIES (IN f (FUN omega RR)) (IMPLIES (IN h (FUN omega RR))
    (IMPLIES (FORALL ex_ (IMPLIES (IN ex_ omega) (= (f ex_) (h ex_))))
      (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f) (IS-REAL-MEASURABLE-FN omega cA h)))))))))))
(dk-peel!)
(let ((pw (dk-pick (lambda (f) (dk-head-is? f 'FORALL)) "the pointwise equality")))
  (dk-fun-ext! 'f 'h 'omega 'RR #f #f (lambda (v) (inst*! pw v) (ass))))
(subst '(= h f))
(ass)
(sipl-qed! 'real-measurable-ptwise-eq)

;;; t <= |t| and -t <= |t|, landed (t in RR in context)
(define (sipl-abs-bounds! t)
  (dk-cite! 'rr-abs-closed t)
  (dk-cite! 'rr-le-abs t)
  (dk-real! (list '- t))
  (dk-cite! 'rr-le-abs (list '- t))
  (dk-cite! 'rr-abs-neg t)
  (dk-have! (list '<= (list '- t) (list 'abs t))
    (lambda () (subst (list '= (list 'abs t) (list 'abs (list '- t)))) (ass))))
;;; constant functions
(sp (make-wff '(FORALL omega (FORALL cA (FORALL kc_ (IMPLIES (IS-SIGMA-ALGEBRA omega cA) (IMPLIES (IN kc_ RR)
  (IS-REAL-MEASURABLE-FN omega cA (VNB-LAMBDA cx_ omega kc_)))))))))
(dk-peel!)
(define sipl-kf '(VNB-LAMBDA cx_ omega kc_))
(dk-have! '(IN omega SET) (lambda () (mac-h 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega cA)) (dk-split-all!) (ass)))
(dk-have! (list 'IN sipl-kf '(FUN omega RR)) (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass)))))
(mac 'IS-REAL-MEASURABLE-FN)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (dk-asm? g) (ass)
          (let* ((part (caddr (cdr g)))      ; (POS-PART omega kf) or (NEG-PART omega kf)
                 (pos? (eq? (car part) 'POS-PART))
                 (val (if pos? '(* 1/2 (+ (abs kc_) kc_)) '(* 1/2 (- (abs kc_) kc_)))))
            (dk-cite! 'rr-abs-closed 'kc_)
            (dk-real! val)
            (sipl-abs-bounds! 'kc_)
            (dk-have! (list '<= 0 val) (lambda () (dk-ineq! '(IN kc_ RR) '(IN (abs kc_) RR) '(<= kc_ (abs kc_)) '(<= (- kc_) (abs kc_)))))
            (dk-cite! 'rmc-rps-of-nonneg val)
            (fact (if pos? 'pos-part-fun 'neg-part-fun) 'omega sipl-kf)
            (dk-fun-ext! part (list 'VNB-LAMBDA 'cx_ 'omega val) 'omega 'RR-POS-STAR #f
              (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass))))
              (lambda (v)
                (let ((leaf (proof-state-focus *ps*)))
                  (dk-split-all! (list (dk-cite! 'part-values-at 'omega sipl-kf v)))
                  (let ((kv (list sipl-kf v)))
                    (dk-have! (list '= kv 'kc_) (lambda () (let ((lf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? lf)) (rfl)))))
                    (dk-lam-b!)
                    (if (not (sequent-node-grounded? leaf))
                        (let ((pv (list (sipl-pp sipl-kf) v)) (nv (list (sipl-np sipl-kf) v)))
                          (dk-cite! 'fun-apply-type-c sipl-kf 'omega 'RR v)
                          (dk-cite! 'rr-abs-closed kv)
                          (dk-have! (list '= (list 'abs kv) '(abs kc_))
                            (lambda () (subst (list '= kv 'kc_)) (rfl)))
                          (dk-ineq! (list '= kv (list '- pv nv)) (list '= (list 'abs kv) (list '+ pv nv)) (list '= kv 'kc_)
                                    (list '= (list 'abs kv) '(abs kc_)) (list 'IN kv 'RR) (list 'IN (list 'abs kv) 'RR)
                                    (list 'IN pv 'RR) (list 'IN nv 'RR) '(IN kc_ RR) '(IN (abs kc_) RR))))))))
            (subst (list '= part (list 'VNB-LAMBDA 'cx_ 'omega val)))
            (fact 'measurable-fn-const 'omega 'cA val)
            (ass))))))
(sipl-qed! 'real-measurable-const)

;;; ---- the zero function is integrable -----------------------------------------------------------
(define sipl-z '(VNB-LAMBDA cx_ omega 0))
(define (sipl-measure-set!)              ; omega in SET, the sigma-algebra, from IS-MEASURE
  (sipl-measure-parts!)
  (dk-have! '(IN omega SET) (lambda () (mac-h 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega cA)) (dk-split-all!) (ass))))
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-INTEGRABLE omega cA mu (VNB-LAMBDA cx_ omega 0))))))))
(dk-peel!)
(sipl-measure-set!)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(fact 'real-measurable-const 'omega 'cA 0)
(dk-have! (list 'IN sipl-z '(FUN omega RR)) (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass)))))
(fact 'integral-zero-fn 'omega 'cA 'mu)
(fact 'zero-in-rr-pos-star)
(mac 'IS-INTEGRABLE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (dk-asm? g) (ass)
          (let* ((part (list-ref (cadr g) 4)))     ; (IN (INTEGRAL omega cA mu PART) RR)
            (fact (if (eq? (car part) 'POS-PART) 'pos-part-fun 'neg-part-fun) 'omega sipl-z)
            (dk-fun-ext! part sipl-z 'omega 'RR-POS-STAR #f
              (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass))))
              (lambda (v)
                (let ((leaf (proof-state-focus *ps*)) (zv (list sipl-z v)))
                  (dk-split-all! (list (dk-cite! 'part-values-at 'omega sipl-z v)))
                  (dk-cite! 'fun-apply-type-c sipl-z 'omega 'RR v)
                  (dk-have! (list '= zv 0) (lambda () (sipl-beta-rfl!)))
                  (dk-have! (list '= (list 'abs zv) 0) (lambda () (subst (list '= zv 0)) (fact 'rr-abs-of-nonneg 0) (ass)))
                  (dk-lam-b!)
                  (if (not (sequent-node-grounded? leaf))
                      (let ((pv (list (sipl-pp sipl-z) v)) (nv (list (sipl-np sipl-z) v)))
                        (dk-ineq! (list '= zv (list '- pv nv)) (list '= (list 'abs zv) (list '+ pv nv)) (list '= zv 0)
                                  (list '= (list 'abs zv) 0) (list '<= 0 pv) (list '<= 0 nv)
                                  (list 'IN pv 'RR) (list 'IN nv 'RR) (list 'IN zv 'RR)))))))
            (subst (list '= part sipl-z))
            (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu sipl-z) 0))
            (arith))))))
(sipl-qed! 'integrable-zero)

;;; ---- 2|ab| <= a^2 + b^2 and (a+b)^2 <= 2a^2 + 2b^2, at reals a, b in context ---------------
(define (sipl-sqtype! a) (dk-real! (list '* a a)) (dk-cite! 'rr-sq-nonneg a))
(define (sipl-amgm! a b)                ; lands (<= (abs (* a b)) (abs (+ (* a a) (* b b))))
  (let* ((aa (list '* a a)) (bb (list '* b b)) (ab (list '* a b)) (s (list '+ aa bb))
         (ua (list 'abs a)) (ub (list 'abs b)))
    (sipl-sqtype! a) (sipl-sqtype! b)
    (dk-real! ab) (dk-real! s)
    (dk-cite! 'rr-abs-closed a) (dk-cite! 'rr-abs-closed b)
    (dk-cite! 'rr-abs-nonneg a) (dk-cite! 'rr-abs-nonneg b)
    (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-cite! 'rr-abs-mult a b)
    (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '<= 0 aa) (list '<= 0 bb) (list 'IN aa 'RR) (list 'IN bb 'RR))))
    (dk-cite! 'rr-abs-of-nonneg s)
    (sipl-mul-nonneg! ua ub)
    (let* ((uab (list '* ua ub)) (d (list '- ua ub)) (dd (list '* d d)))
      (dk-real! uab) (dk-real! d) (dk-real! dd)
      (dk-cite! 'rr-sq-nonneg d)
      (dk-real! (list '* ua ua)) (dk-real! (list '* ub ub))
      (dk-have! (list '= dd (list '+ (list '- (list '* ua ua) (list '* 2 uab)) (list '* ub ub))) (lambda () (crs)))
      (for-each (lambda (x)
                  (let ((ux (list 'abs x)) (xx (list '* x x)))
                    (dk-have! (list 'AND (list 'IN x 'RR) (list 'IN x 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
                    (dk-cite! 'rr-abs-mult x x)
                    (dk-cite! 'rr-abs-of-nonneg xx)
                    (dk-have! (list '= (list '* ux ux) xx)
                      (lambda () (subst (list '= (list '* ux ux) (list 'abs xx))) (subst (list '= (list 'abs xx) xx)) (rfl)))))
                (list a b))
      (dk-have! (list '<= (list 'abs ab) (list 'abs s))
        (lambda ()
          (subst (list '= (list 'abs ab) uab))
          (subst (list '= (list 'abs s) s))
          (dk-ineq! (list '<= 0 dd) (list '<= 0 uab) (list '= dd (list '+ (list '- (list '* ua ua) (list '* 2 uab)) (list '* ub ub)))
                    (list '= (list '* ua ua) aa) (list '= (list '* ub ub) bb)
                    (list 'IN dd 'RR) (list 'IN uab 'RR) (list 'IN (list '* ua ua) 'RR) (list 'IN (list '* ub ub) 'RR)
                    (list 'IN aa 'RR) (list 'IN bb 'RR)))))))
(define (sipl-sumsq! a b)               ; lands (<= (abs (* (+ a b) (+ a b))) (abs (+ (* 2 (* a a)) (* 2 (* b b)))))
  (let* ((aa (list '* a a)) (bb (list '* b b)) (ab (list '* a b)) (p (list '+ a b)) (pp (list '* p p))
         (m (list '- a b)) (mm (list '* m m)) (h (list '+ (list '* 2 aa) (list '* 2 bb))))
    (sipl-sqtype! a) (sipl-sqtype! b) (dk-real! ab) (dk-real! p) (dk-real! m) (sipl-sqtype! p) (sipl-sqtype! m) (dk-real! h)
    (dk-have! (list '= pp (list '+ (list '+ aa (list '* 2 ab)) bb)) (lambda () (crs)))
    (dk-have! (list '= mm (list '+ (list '- aa (list '* 2 ab)) bb)) (lambda () (crs)))
    (dk-have! (list '<= 0 h) (lambda () (dk-ineq! (list '<= 0 aa) (list '<= 0 bb) (list 'IN aa 'RR) (list 'IN bb 'RR))))
    (dk-cite! 'rr-abs-of-nonneg pp)
    (dk-cite! 'rr-abs-of-nonneg h)
    (dk-have! (list '<= (list 'abs pp) (list 'abs h))
      (lambda ()
        (subst (list '= (list 'abs pp) pp))
        (subst (list '= (list 'abs h) h))
        (dk-ineq! (list '= pp (list '+ (list '+ aa (list '* 2 ab)) bb)) (list '= mm (list '+ (list '- aa (list '* 2 ab)) bb))
                  (list '<= 0 mm) (list 'IN pp 'RR) (list 'IN mm 'RR) (list 'IN aa 'RR) (list 'IN bb 'RR) (list 'IN ab 'RR))))))

;;; ---- a lambda on omega with a real body: its FUN typing, its value at a point -------------
(define (sipl-fun-type! lam)             ; (IN LAM (FUN omega RR)), beta under the peel then in-rr
  (dk-have! (list 'IN lam '(FUN omega RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((lk (dk-peel!)) (x (cadr (car lk))) (leaf (proof-state-focus *ps*)))
            (for-each (lambda (h) (if (dk-asm? (list 'IN h '(FUN omega RR))) (dk-cite! 'fun-apply-type-c h 'omega 'RR x)))
                      '(f g))
            (sipl-beta-all! leaf)                    ; beta what can be reduced, then type the body
            (if (not (sequent-node-grounded? leaf)) (in-rr))))))))
(define (sipl-integrable-transfer! from to)   ; IS-INTEGRABLE(FROM) in context => IS-INTEGRABLE(TO)
  (sipl-fun-type! from) (sipl-fun-type! to)
  (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list from 'ex_) (list to 'ex_))))
    (lambda ()
      (let* ((lk (dk-peel!)) (x (cadr (car lk))))
        (for-each (lambda (h) (if (dk-asm? (list 'IN h '(FUN omega RR))) (dk-cite! 'fun-apply-type-c h 'omega 'RR x))) '(f g))
        (let ((leaf (proof-state-focus *ps*)))
          (sipl-beta-all! leaf)
          (if (not (sequent-node-grounded? leaf))
              (let ((g (dk-goal))) (dk-real! (cadr g)) (dk-real! (caddr g)) (crs)))))))
  (dk-split-all! (list (dk-cite! 'integrable-ptwise-eq 'omega 'cA 'mu from to))))

;;; the product of two members of L^2 is integrable: |fg| <= f^2 + g^2
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'f (list 'FORALL 'g
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IMPLIES (list 'IN 'f sipl-L2) (list 'IMPLIES (list 'IN 'g sipl-L2)
    (list 'IS-INTEGRABLE 'omega 'cA 'mu (sipl-prod 'f 'g))))))))))))
(dk-peel!)
(sipl-measure-set!)
(sipl-l2-open! 'f)
(sipl-l2-open! 'g)
(fact 'real-measurable-mul 'omega 'cA 'f 'g)
(let* ((sf (sipl-sq 'f)) (sg (sipl-sq 'g))
       (h '(VNB-LAMBDA lx_ omega (+ (* (f lx_) (f lx_)) (* (g lx_) (g lx_)))))
       (sum (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list sf 'sx_) (list sg 'sx_)))))
  (dk-split-all! (list (dk-cite! 'rintegral-add 'omega 'cA 'mu sf sg)))
  (sipl-integrable-transfer! sum h)
  (sipl-fun-type! (sipl-prod 'f 'g))
  (dk-have! (list 'FORALL 'dx_ (list 'IMPLIES '(IN dx_ omega) (list '<= (list 'abs (list (sipl-prod 'f 'g) 'dx_)) (list 'abs (list h 'dx_)))))
    (lambda ()
      (let* ((lk (dk-peel!)) (x (cadr (car lk))) (a (list 'f x)) (b (list 'g x)))
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
        (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
        (sipl-amgm! a b)
        (let ((leaf (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? leaf)) (ass))))))
  (fact 'integrable-dominated 'omega 'cA 'mu (sipl-prod 'f 'g) h)
  (ass))
(sipl-qed! 'l2-prod-integrable)

;;; ---- L^2 is closed under the operations ----------------------------------------------------
(define sipl-fpg '(VNB-LAMBDA lx_ omega (+ (f lx_) (g lx_))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'f (list 'FORALL 'g
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IMPLIES (list 'IN 'f sipl-L2) (list 'IMPLIES (list 'IN 'g sipl-L2)
    (list 'IN sipl-fpg sipl-L2)))))))))))
(dk-peel!)
(sipl-measure-set!)
(sipl-l2-open! 'f)
(sipl-l2-open! 'g)
(sipl-fun-type! sipl-fpg)
(fact 'real-measurable-add 'omega 'cA 'f 'g)
(fact 'real-measurable-mul 'omega 'cA sipl-fpg sipl-fpg)
(let* ((sf (sipl-sq 'f)) (sg (sipl-sq 'g))
       (sf2 (list 'VNB-LAMBDA 'sx_ 'omega (list '* 2 (list sf 'sx_))))
       (sg2 (list 'VNB-LAMBDA 'sx_ 'omega (list '* 2 (list sg 'sx_))))
       (sum (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list sf2 'sx_) (list sg2 'sx_))))
       (h '(VNB-LAMBDA lx_ omega (+ (* 2 (* (f lx_) (f lx_))) (* 2 (* (g lx_) (g lx_))))))
       (k (sipl-sq sipl-fpg)))
  (dk-have! '(IN 2 RR) (lambda () (arith)))
  (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'cA 'mu sf 2)))
  (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'cA 'mu sg 2)))
  (dk-split-all! (list (dk-cite! 'rintegral-add 'omega 'cA 'mu sf2 sg2)))
  (sipl-integrable-transfer! sum h)
  (sipl-fun-type! k)
  (dk-have! (list 'FORALL 'dx_ (list 'IMPLIES '(IN dx_ omega) (list '<= (list 'abs (list k 'dx_)) (list 'abs (list h 'dx_)))))
    (lambda ()
      (let* ((lk (dk-peel!)) (x (cadr (car lk))) (a (list 'f x)) (b (list 'g x)))
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
        (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
        (sipl-sumsq! a b)
        (let ((leaf (proof-state-focus *ps*)))
          (sipl-beta-all! leaf)
          (if (not (sequent-node-grounded? leaf)) (ass))))))
  (fact 'integrable-dominated 'omega 'cA 'mu k h)
  (fact 'l2-in 'omega 'cA 'mu sipl-fpg)
  (ass))
(sipl-qed! 'l2-add-closed)

(define sipl-rf '(VNB-LAMBDA lx_ omega (* lr_ (f lx_))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'lr_ (list 'FORALL 'f
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IMPLIES '(IN lr_ RR) (list 'IMPLIES (list 'IN 'f sipl-L2)
    (list 'IN sipl-rf sipl-L2)))))))))))
(dk-peel!)
(sipl-measure-set!)
(sipl-l2-open! 'f)
(sipl-fun-type! sipl-rf)
(fact 'real-measurable-const 'omega 'cA 'lr_)
(let* ((kf '(VNB-LAMBDA cx_ omega lr_))
       (mk (list 'VNB-LAMBDA 'sx_ 'omega (list '* (list kf 'sx_) '(f sx_))))
       (sf (sipl-sq 'f))
       (rr2 '(* lr_ lr_))
       (sc (list 'VNB-LAMBDA 'sx_ 'omega (list '* rr2 (list sf 'sx_))))
       (k (sipl-sq sipl-rf)))
  (fact 'real-measurable-mul 'omega 'cA kf 'f)
  (sipl-fun-type! kf)
  (sipl-fun-type! mk)
  ;; measurability of r f, read across from (const r) f
  (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list mk 'ex_) (list sipl-rf 'ex_))))
    (lambda ()
      (let* ((lk (dk-peel!)) (x (cadr (car lk))) (leaf (proof-state-focus *ps*)))
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
        (sipl-beta-all! leaf)
        (if (not (sequent-node-grounded? leaf)) (begin (dk-real! (cadr (dk-goal))) (rfl))))))
  (fact 'real-measurable-ptwise-eq 'omega 'cA mk sipl-rf)
  ;; the square: (r f)^2 = r^2 f^2
  (dk-real! rr2)
  (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'cA 'mu sf rr2)))
  (sipl-integrable-transfer! sc k)
  (fact 'l2-in 'omega 'cA 'mu sipl-rf)
  (ass))
(sipl-qed! 'l2-scale-closed)

(define sipl-nf '(VNB-LAMBDA lx_ omega (- (f lx_))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'FORALL 'f
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IMPLIES (list 'IN 'f sipl-L2) (list 'IN sipl-nf sipl-L2)))))))))
(dk-peel!)
(sipl-measure-set!)
(sipl-l2-open! 'f)
(dk-have! '(IN -1 RR) (lambda () (arith)))
(let ((m1 '(VNB-LAMBDA lx_ omega (* -1 (f lx_)))))
  (fact 'l2-scale-closed 'omega 'cA 'mu -1 'f)
  (sipl-fun-type! m1) (sipl-fun-type! sipl-nf)
  (dk-fun-ext! m1 sipl-nf 'omega 'RR #f #f
    (lambda (v)
      (let ((leaf (proof-state-focus *ps*)))
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR v)
        (dk-lam-b!)
        (if (not (sequent-node-grounded? leaf)) (crs)))))
  (subst (list '= sipl-nf m1))
  (ass))
(sipl-qed! 'l2-neg-closed)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IN '(VNB-LAMBDA lx_ omega 0) sipl-L2)))))))
(dk-peel!)
(sipl-measure-set!)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(fact 'real-measurable-const 'omega 'cA 0)
(fact 'integrable-zero 'omega 'cA 'mu)
(let ((z '(VNB-LAMBDA cx_ omega 0)))
  (sipl-fun-type! z)
  (sipl-integrable-transfer! z (sipl-sq z))
  (fact 'l2-in 'omega 'cA 'mu z)
  (ass))
(sipl-qed! 'l2-zero-in)

;;; the L^2 set is a set
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu
  (list 'IMPLIES '(IS-MEASURE omega cA mu) (list 'IN sipl-L2 'SET)))))))
(dk-peel!)
(sipl-measure-set!)
(fact 'rr-is-set)
(mac 'L2-SET)
(sep-set)
(if (not (proof-done? *ps*)) (begin (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipl-qed! 'l2-set-is-set)

;;; ==========================================================================================
;;; REAL L^2 IS A SEMI-INNER-PRODUCT SPACE.
;;; ==========================================================================================
(define sipl-VA '(L2-VADD omega cA mu))
(define sipl-VN '(L2-VNEG omega cA mu))
(define sipl-AC '(L2-ACT omega cA mu))
(define sipl-RP '(L2-RIP omega cA mu))
(define sipl-V0 '(L2-VZERO omega))

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL f (IMPLIES (IN f (FUN omega RR))
  (IMPLIES (IS-INTEGRABLE omega cA mu f) (IN (RINTEGRAL omega cA mu f) RR)))))))))
(dk-peel!)
(sipl-integrable-parts! 'f)
(mac 'rintegral-unfold)
(type-term)
(sipl-qed! 'rintegral-in-rr)

;;; the values of the operations on members of L^2
(define (sipl-value! name stmt-tail fn-name)
  (sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu) stmt-tail))))))
  (dk-peel!)
  (sipl-measure-set!)
  (let ((g (dk-goal)))
    (for-each (lambda (h) (if (dk-asm? (list 'IN h sipl-L2)) (sipl-l2-open! h))) '(f g))
    (if (pair? (caddr g)) (if (eq? (car (caddr g)) 'VNB-LAMBDA) (sipl-fun-type! (caddr g))))
    (if (eq? fn-name 'L2-RIP)
        (begin (fact 'l2-prod-integrable 'omega 'cA 'mu 'f 'g)
               (sipl-fun-type! (sipl-prod 'f 'g))
               (fact 'rintegral-in-rr 'omega 'cA 'mu (sipl-prod 'f 'g))))
    (mac fn-name)
    (sipl-beta-rfl!))
  (sipl-qed! name))
(sipl-value! 'l2-vadd-value
  (forall-guarded '(f g) (list (list 'IN 'f sipl-L2) (list 'IN 'g sipl-L2))
    (list '= (list sipl-VA 'f 'g) sipl-fpg))
  'L2-VADD)
(sipl-value! 'l2-vneg-value
  (forall-guarded '(f) (list (list 'IN 'f sipl-L2))
    (list '= (list sipl-VN 'f) sipl-nf))
  'L2-VNEG)
(sipl-value! 'l2-act-value
  (forall-guarded '(lr_ f) (list '(IN lr_ RR) (list 'IN 'f sipl-L2))
    (list '= (list sipl-AC 'lr_ 'f) sipl-rf))
  'L2-ACT)
(sipl-value! 'l2-rip-value
  (forall-guarded '(f g) (list (list 'IN 'f sipl-L2) (list 'IN 'g sipl-L2))
    (list '= (list sipl-RP 'f 'g) (list 'RINTEGRAL 'omega 'cA 'mu (sipl-prod 'f 'g))))
  'L2-RIP)

;;; ---- read-offs of the L^2 tuple ------------------------------------------------------------
(define sipl-LS '(L2-SPACE omega cA mu))
(define sipl-rr-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define sipl-ls-vals
  (list (list 'SCAL sipl-rr-ring) (list 'VEC sipl-L2) (list 'VADD sipl-VA) (list 'VZERO sipl-V0)
        (list 'VNEG sipl-VN) (list 'ACT sipl-AC) (list 'RIP sipl-RP)))
(for-each
  (lambda (p)
    (sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
                    (list '== (list (car p) sipl-LS) (cadr p))))))))
    (di) (di)
    ;; the tuple's entries certified SETS: `nth-r' owes the definedness of the list
    ;; (the list doctrine of 2026-10-01), and the owed leaf is closed by `rfl' from these
    (sipl-measure-set!)
    (fact 'l2-set-is-set 'omega 'cA 'mu)
    (fact 'rr-is-normed-field)
    (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
    (slot (car p))
    (mac 'L2-SPACE)
    (nth-r)
    (if (not (proof-done? *ps*)) (qrfl))
    (if (not (proof-done? *ps*))
        (begin (dk-focus! (car (dk-open-leaves))) (rfl)))
    (sipl-qed! (symbol-append 'l2-space- (car p))))
  sipl-ls-vals)

;;; ---- the drive of a conjunct ----------------------------------------------------------------
(define (sipl-ls-open!)
  (di) (di)
  (sipl-measure-set!)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (fact 'commutative-ring-is-ring sipl-rr-ring)
  (for-each (lambda (p) (let ((e (dk-cite! (symbol-append 'l2-space- (car p)) 'omega 'cA 'mu)))
                          (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            sipl-ls-vals)
  (for-each (lambda (m) (if (dk--occurs? (list (car m) sipl-rr-ring) (dk-goal)) (mac (cadr m))))
            '((CARR rr-scalar-ring-carr) (ONE rr-scalar-ring-one)))
  (if (dk--occurs? sipl-V0 (dk-goal)) (mac 'L2-VZERO)))
(define (sipl-l2-var! f)                ; f in L2 in context: its FUN typing
  (dk-split-all! (list (dk-cite! 'l2-out 'omega 'cA 'mu f))))
(define (sipl-app-of? pred e)
  (let walk ((e e)) (and (pair? e) (list? e) (or (pred e) (any-pred walk e)))))
(define (sipl-in? x lst) (cond ((null? lst) #f) ((equal? x (car lst)) #t) (#t (sipl-in? x (cdr lst)))))
(define (sipl-l2-ops) (list sipl-VA sipl-VN sipl-AC sipl-RP (list 'ADD sipl-rr-ring) (list 'MUL sipl-rr-ring)))
(define (sipl-l2-redex e)               ; innermost application of an L^2 operation to settled arguments
  (if (not (and (pair? e) (list? e)))
      #f
      (or (let loop ((xs e)) (cond ((null? xs) #f) ((sipl-l2-redex (car xs))) (#t (loop (cdr xs)))))
          (and (sipl-in? (car e) (sipl-l2-ops))
               (not (any-pred (lambda (a) (sipl-app-of? (lambda (x) (and (pair? x) (sipl-in? (car x) (sipl-l2-ops)))) a))
                              (cdr e)))
               e))))
(define (sipl-l2-norm!)
  (let loop ((fuel 20))
    (let ((rx (sipl-l2-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let* ((h (car rx))
                 (eqn (cond ((equal? h sipl-VA) (dk-cite! 'l2-add-closed 'omega 'cA 'mu (cadr rx) (caddr rx))
                                                (dk-cite! 'l2-vadd-value 'omega 'cA 'mu (cadr rx) (caddr rx)))
                            ((equal? h sipl-VN) (dk-cite! 'l2-neg-closed 'omega 'cA 'mu (cadr rx))
                                                (dk-cite! 'l2-vneg-value 'omega 'cA 'mu (cadr rx)))
                            ((equal? h sipl-AC) (dk-real! (cadr rx))
                                                (dk-cite! 'l2-scale-closed 'omega 'cA 'mu (cadr rx) (caddr rx))
                                                (dk-cite! 'l2-act-value 'omega 'cA 'mu (cadr rx) (caddr rx)))
                            ((equal? h sipl-RP) (dk-cite! 'l2-rip-value 'omega 'cA 'mu (cadr rx) (caddr rx)))
                            ((equal? h (list 'ADD sipl-rr-ring)) (dk-cite! 'sip-rr-ring-add-value (cadr rx) (caddr rx)))
                            (#t (dk-cite! 'sip-rr-ring-mul-value (cadr rx) (caddr rx))))))
            (subst eqn)
            (loop (- fuel 1)))))))
;;; (= LAM1 LAM2) for two lambdas on omega: extensionality, beta, ring arithmetic
(define (sipl-l2-ext!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (sipl-fun-type! l) (sipl-fun-type! r)
    (dk-fun-ext! l r 'omega 'RR #f #f
      (lambda (v)
        (let ((leaf (proof-state-focus *ps*)))
          (for-each (lambda (f) (if (and (symbol? f) (dk-asm? (list 'IN f '(FUN omega RR)))) (dk-cite! 'fun-apply-type-c f 'omega 'RR v)))
                    (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN omega RR)))) (dk-asms))))
          (sipl-beta-all! leaf)
          (if (not (sequent-node-grounded? leaf))
              (let ((g2 (dk-goal))) (dk-real! (cadr g2)) (dk-real! (caddr g2)) (crs))))))))
(define (sipl-ls-law! name str closer)
  (sp str)
  (sipl-ls-open!)
  (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(is-associative is-commutative is-identity has-inverses)))
      (mac (car (dk-goal))))
  (dk-conj-close!
    (lambda ()
      (let* ((lk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!) '())))
        (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) sipl-L2)) (sipl-l2-var! (cadr f)))) lk)
        (if (any-pred (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipl-L2))) lk) (fact 'l2-zero-in 'omega 'cA 'mu))
        (sipl-l2-norm!)
        (dk-conj-close! (lambda () (closer lk))))))     ; a two-sided law is a conjunction under the binder
  (sipl-qed! name))
(define (sipl-ls-stmt body) (string-append "forall([omega, ca, mu], is-measure(omega, ca, mu) implies " body ")"))
(define (sipl-ext-closer lk) (if (dk-asm? (dk-goal)) (ass) (sipl-l2-ext!)))

(sipl-ls-law! 'l2-space-length (sipl-ls-stmt "length(l2-space(omega, ca, mu)) = 7")
  (lambda (lk) (mac 'L2-SPACE) (len-r) (if (not (proof-done? *ps*)) (arith))))
(sipl-ls-law! 'l2-space-scal-ring (sipl-ls-stmt "is-ring(scal(l2-space(omega, ca, mu)))") (lambda (lk) (ass)))
(sipl-ls-law! 'l2-space-vec-set (sipl-ls-stmt "vec(l2-space(omega, ca, mu)) in set")
  (lambda (lk) (fact 'l2-set-is-set 'omega 'cA 'mu) (ass)))
(sipl-ls-law! 'l2-space-assoc (sipl-ls-stmt "is-associative(vadd(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu)))") sipl-ext-closer)
(sipl-ls-law! 'l2-space-comm (sipl-ls-stmt "is-commutative(vadd(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu)))") sipl-ext-closer)
(define (sipl-lam-closed-typer! closed-lemma)   ; pointwise typing leaf of an L^2 operation's lambda
  (lambda ()
    (let* ((lk (dk-peel!))
           (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipl-L2))) lk)))
           (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
      (apply fact closed-lemma 'omega 'cA 'mu (append rs vs))
      (ass))))
(define (sipl-cart-set!) (lambda () (fact 'l2-set-is-set 'omega 'cA 'mu) (fact 'rr-is-set) (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipl-ls-law! 'l2-space-vadd-fun
  (sipl-ls-stmt "vadd(l2-space(omega, ca, mu)) in fun(cartesian(vec(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu))), vec(l2-space(omega, ca, mu)))")
  (lambda (lk) (mac 'L2-VADD) (dk-lam-type! (sipl-lam-closed-typer! 'l2-add-closed) (sipl-cart-set!))))
(sipl-ls-law! 'l2-space-vzero-in (sipl-ls-stmt "vzero(l2-space(omega, ca, mu)) in vec(l2-space(omega, ca, mu))")
  (lambda (lk) (fact 'l2-zero-in 'omega 'cA 'mu) (ass)))
(sipl-ls-law! 'l2-space-vneg-fun
  (sipl-ls-stmt "vneg(l2-space(omega, ca, mu)) in fun(vec(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu)))")
  (lambda (lk) (mac 'L2-VNEG) (fact 'l2-set-is-set 'omega 'cA 'mu) (dk-lam-type! (sipl-lam-closed-typer! 'l2-neg-closed))))
(sipl-ls-law! 'l2-space-act-fun
  (sipl-ls-stmt "act(l2-space(omega, ca, mu)) in fun(cartesian(carr(scal(l2-space(omega, ca, mu))), vec(l2-space(omega, ca, mu))), vec(l2-space(omega, ca, mu)))")
  (lambda (lk) (mac 'L2-ACT) (dk-lam-type! (sipl-lam-closed-typer! 'l2-scale-closed) (sipl-cart-set!))))
(sipl-ls-law! 'l2-space-rip-fun
  (sipl-ls-stmt "rip(l2-space(omega, ca, mu)) in fun(cartesian(vec(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu))), rr)")
  (lambda (lk)
    (mac 'L2-RIP)
    (dk-lam-type!
      (lambda ()
        (let* ((lk (dk-peel!))
               (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipl-L2))) lk))))
          (for-each sipl-l2-var! vs)
          (let ((p (cadddr (cdr (cadr (dk-goal))))))     ; (IN (RINTEGRAL omega cA mu P) RR)
            (apply fact 'l2-prod-integrable 'omega 'cA 'mu vs)
            (sipl-fun-type! p)
            (fact 'rintegral-in-rr 'omega 'cA 'mu p)
            (ass))))
      (sipl-cart-set!))))
(sipl-ls-law! 'l2-space-identity (sipl-ls-stmt "is-identity(vadd(l2-space(omega, ca, mu)), vzero(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu)))") sipl-ext-closer)
(sipl-ls-law! 'l2-space-inverses (sipl-ls-stmt "has-inverses(vadd(l2-space(omega, ca, mu)), vzero(l2-space(omega, ca, mu)), vneg(l2-space(omega, ca, mu)), vec(l2-space(omega, ca, mu)))") sipl-ext-closer)
(sipl-ls-law! 'l2-space-scal-pin (sipl-ls-stmt "scal(l2-space(omega, ca, mu)) = normed-field-as-commutative-ring(rr-normed-field)") (lambda (lk) (rfl)))
(sipl-ls-law! 'l2-space-scal-carr (sipl-ls-stmt "carr(scal(l2-space(omega, ca, mu))) = rr") (lambda (lk) (rfl)))
(sipl-ls-law! 'l2-space-act-vadd
  (sipl-ls-stmt "forall([r_ in carr(scal(l2-space(omega, ca, mu))), x_ in vec(l2-space(omega, ca, mu)), y_ in vec(l2-space(omega, ca, mu))],
     act(l2-space(omega, ca, mu))(r_, vadd(l2-space(omega, ca, mu))(x_, y_)) = vadd(l2-space(omega, ca, mu))(act(l2-space(omega, ca, mu))(r_, x_), act(l2-space(omega, ca, mu))(r_, y_)))")
  sipl-ext-closer)
(sipl-ls-law! 'l2-space-act-add
  (sipl-ls-stmt "forall([r_ in carr(scal(l2-space(omega, ca, mu))), s_ in carr(scal(l2-space(omega, ca, mu))), x_ in vec(l2-space(omega, ca, mu))],
     act(l2-space(omega, ca, mu))(add(scal(l2-space(omega, ca, mu)))(r_, s_), x_) = vadd(l2-space(omega, ca, mu))(act(l2-space(omega, ca, mu))(r_, x_), act(l2-space(omega, ca, mu))(s_, x_)))")
  sipl-ext-closer)
(sipl-ls-law! 'l2-space-act-mul
  (sipl-ls-stmt "forall([r_ in carr(scal(l2-space(omega, ca, mu))), s_ in carr(scal(l2-space(omega, ca, mu))), x_ in vec(l2-space(omega, ca, mu))],
     act(l2-space(omega, ca, mu))(mul(scal(l2-space(omega, ca, mu)))(r_, s_), x_) = act(l2-space(omega, ca, mu))(r_, act(l2-space(omega, ca, mu))(s_, x_)))")
  sipl-ext-closer)
(sipl-ls-law! 'l2-space-act-one
  (sipl-ls-stmt "forall([x_ in vec(l2-space(omega, ca, mu))], act(l2-space(omega, ca, mu))(one(scal(l2-space(omega, ca, mu))), x_) = x_)")
  sipl-ext-closer)

;;; ---- the form laws ------------------------------------------------------------------------
(define (sipl-rint p) (list 'RINTEGRAL 'omega 'cA 'mu p))
(define (sipl-vars lk) (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipl-L2))) lk)))
(define (sipl-eq-fn! l r)               ; land (= L R) for two lambdas on omega by extensionality
  (dk-have! (list '= l r) (lambda () (sipl-l2-ext!))))
(sipl-ls-law! 'l2-space-rip-sym
  (sipl-ls-stmt "forall([x_ in vec(l2-space(omega, ca, mu)), y_ in vec(l2-space(omega, ca, mu))], rip(l2-space(omega, ca, mu))(x_, y_) = rip(l2-space(omega, ca, mu))(y_, x_))")
  (lambda (lk)
    (let* ((g (dk-goal)) (pl (list-ref (cadr g) 4)) (pr (list-ref (caddr g) 4)))
      (sipl-eq-fn! pl pr)
      (subst (list '= pl pr))
      (apply fact 'l2-prod-integrable 'omega 'cA 'mu (reverse (sipl-vars lk)))
      (apply fact 'l2-prod-integrable 'omega 'cA 'mu (sipl-vars lk))
      (sipl-fun-type! pr)
      (fact 'rintegral-in-rr 'omega 'cA 'mu pr)
      (rfl))))
(sipl-ls-law! 'l2-space-rip-add-left
  (sipl-ls-stmt "forall([x_ in vec(l2-space(omega, ca, mu)), y_ in vec(l2-space(omega, ca, mu)), z_ in vec(l2-space(omega, ca, mu))],
     rip(l2-space(omega, ca, mu))(vadd(l2-space(omega, ca, mu))(x_, y_), z_) = rip(l2-space(omega, ca, mu))(x_, z_) + rip(l2-space(omega, ca, mu))(y_, z_))")
  (lambda (lk)
    (let* ((g (dk-goal)) (pl (list-ref (cadr g) 4))
           (pxz (list-ref (cadr (caddr g)) 4)) (pyz (list-ref (caddr (caddr g)) 4))
           (sum (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list pxz 'sx_) (list pyz 'sx_)))))
      ;; the two products are integrable: read their factors off the lambdas
      (for-each (lambda (p)
                  (let* ((body (cadddr p)) (a (car (cadr body))) (b (car (caddr body))))
                    (fact 'l2-prod-integrable 'omega 'cA 'mu a b)))
                (list pxz pyz))
      (dk-split-all! (list (dk-cite! 'rintegral-add 'omega 'cA 'mu pxz pyz)))
      (sipl-eq-fn! pl sum)
      (subst (list '= pl sum))
      (ass))))
(sipl-ls-law! 'l2-space-rip-homog-left
  (sipl-ls-stmt "forall([a_ in rr, x_ in vec(l2-space(omega, ca, mu)), y_ in vec(l2-space(omega, ca, mu))],
     rip(l2-space(omega, ca, mu))(act(l2-space(omega, ca, mu))(a_, x_), y_) = a_ * rip(l2-space(omega, ca, mu))(x_, y_))")
  (lambda (lk)
    (let* ((g (dk-goal)) (pl (list-ref (cadr g) 4)) (a (cadr (caddr g))) (pxy (list-ref (caddr (caddr g)) 4))
           (body (cadddr pxy))
           (sc (list 'VNB-LAMBDA 'sx_ 'omega (list '* a (list pxy 'sx_)))))
      (fact 'l2-prod-integrable 'omega 'cA 'mu (car (cadr body)) (car (caddr body)))
      (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'cA 'mu pxy a)))
      (sipl-eq-fn! pl sc)
      (subst (list '= pl sc))
      (ass))))
(sipl-ls-law! 'l2-space-rip-self-nonneg
  (sipl-ls-stmt "forall([x_ in vec(l2-space(omega, ca, mu))], 0 <= rip(l2-space(omega, ca, mu))(x_, x_))")
  (lambda (lk)
    (let* ((g (dk-goal)) (pxx (list-ref (caddr g) 4)) (x (car (sipl-vars lk))))
      (fact 'l2-prod-integrable 'omega 'cA 'mu x x)
      (sipl-fun-type! pxx)
      (dk-have! (list 'FORALL 'nx_ (list 'IMPLIES '(IN nx_ omega) (list '<= 0 (list pxx 'nx_))))
        (lambda ()
          (let* ((lk2 (dk-peel!)) (v (cadr (car lk2))) (leaf (proof-state-focus *ps*)))
            (dk-cite! 'fun-apply-type-c x 'omega 'RR v)
            (dk-cite! 'rr-sq-nonneg (list x v))
            (sipl-beta-all! leaf)
            (if (not (sequent-node-grounded? leaf)) (ass)))))
      (dk-split-all! (list (dk-cite! 'rintegral-of-nonneg 'omega 'cA 'mu pxx)))
      (fact 'integral-in 'omega 'cA 'mu pxx)
      (fact 'rr-pos-star-nonneg (list 'INTEGRAL 'omega 'cA 'mu pxx))
      (subst (list '= (sipl-rint pxx) (list 'INTEGRAL 'omega 'cA 'mu pxx)))
      (ass))))

;;; REAL L^2 IS A SEMI-INNER-PRODUCT SPACE
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-SEMI-INNER-PRODUCT-SPACE (L2-SPACE omega cA mu))))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'omega 'cA 'mu))
  '(l2-space-length l2-space-scal-ring l2-space-vec-set l2-space-vadd-fun l2-space-vzero-in l2-space-vneg-fun
    l2-space-act-fun l2-space-rip-fun l2-space-assoc l2-space-comm l2-space-identity l2-space-inverses
    l2-space-scal-pin l2-space-scal-carr l2-space-act-vadd l2-space-act-add l2-space-act-mul l2-space-act-one
    l2-space-rip-sym l2-space-rip-add-left l2-space-rip-homog-left l2-space-rip-self-nonneg))
(mac 'IS-SEMI-INNER-PRODUCT-SPACE)
(dk-conj-close! (lambda () (ass)))
(sipl-qed! 'l2-space-is-sip)
(alias! 'l2-space-is-sip "real L^2 is a semi-inner-product space")

;;; ==========================================================================================
;;; THE AGREEMENT: in real L^2, <f - g, f - g> = 0 exactly when f = g almost everywhere.
;;; So the null-vector relation of L^2 IS equality almost everywhere, and the two quotients
;;; coincide.
;;; ==========================================================================================
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (= (RINTEGRAL omega cA mu (VNB-LAMBDA cx_ omega 0)) 0)))))))
(dk-peel!)
(sipl-measure-set!)
(fact 'integrable-zero 'omega 'cA 'mu)
(sipl-fun-type! '(VNB-LAMBDA cx_ omega 0))
(dk-have! '(FORALL nx_ (IMPLIES (IN nx_ omega) (<= 0 ((VNB-LAMBDA cx_ omega 0) nx_))))
  (lambda () (let* ((lk (dk-peel!)) (leaf (proof-state-focus *ps*)))
               (sipl-beta-all! leaf)
               (if (not (sequent-node-grounded? leaf)) (arith)))))
(dk-split-all! (list (dk-cite! 'rintegral-of-nonneg 'omega 'cA 'mu '(VNB-LAMBDA cx_ omega 0))))
(fact 'integral-zero-fn 'omega 'cA 'mu)
(subst '(= (RINTEGRAL omega cA mu (VNB-LAMBDA cx_ omega 0)) (INTEGRAL omega cA mu (VNB-LAMBDA cx_ omega 0))))
(ass)
(sipl-qed! 'rintegral-zero-fn)

(define sipl-diff '((VADD (L2-SPACE omega cA mu)) f ((VNEG (L2-SPACE omega cA mu)) g)))
(define (sipl-pt-eqs! d p x)          ; the value of D and of P at a point, as equations
    (let ((dx (list d x)) (px (list p x)))
      (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
      (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
      (dk-cite! 'fun-apply-type-c d 'omega 'RR x)
      (dk-cite! 'fun-apply-type-c p 'omega 'RR x)
      (dk-real! (list '- (list 'g x)))
      (dk-real! (list '+ (list 'f x) (list '- (list 'g x))))
      (dk-real! (list '* dx dx))
      (dk-have! (list '= dx (list '+ (list 'f x) (list '- (list 'g x))))
        (lambda () (let ((leaf (proof-state-focus *ps*))) (sipl-beta-all! leaf) (if (not (sequent-node-grounded? leaf)) (rfl)))))
      (dk-have! (list '= px (list '* dx dx))
        (lambda () (let ((leaf (proof-state-focus *ps*)))
                     (dk-lam-b!)
                     (if (not (sequent-node-grounded? leaf)) (rfl)))))))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
  (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f sipl-L2) (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g sipl-L2)
    (list 'IFF (list '= (list '(RIP (L2-SPACE omega cA mu)) sipl-diff sipl-diff) 0)
          '(FORSOME aen_ (AND (IS-NULL-SET omega cA mu aen_)
             (FORALL aex_ (IMPLIES (IN aex_ omega) (IMPLIES (NOT (IN aex_ aen_)) (= (f aex_) (g aex_))))))))))))))))))
(sipl-ls-open!)
(dk-peel!)
(sipl-l2-var! 'f) (sipl-l2-var! 'g)
(fact 'l2-zero-in 'omega 'cA 'mu)
(sipl-l2-norm!)
(let* ((g0 (dk-goal))
       (p (list-ref (cadr (cadr g0)) 4))          ; (IFF (= (RINTEGRAL omega cA mu P) 0) ...)
       (d (car (cadr (cadddr p))))                 ; P = (VNB-LAMBDA lx_ omega (* (D lx_) (D lx_)))
       (n (list 'SEP 'x_ 'omega (list '< 0 (list p 'x_))))
       (ip (list 'INTEGRAL 'omega 'cA 'mu p)))
  (fact 'l2-prod-integrable 'omega 'cA 'mu d d)
  (sipl-fun-type! d)
  (sipl-fun-type! p)
  (sipl-integrable-parts! p)
  (dk-have! (list 'FORALL 'nx_ (list 'IMPLIES '(IN nx_ omega) (list '<= 0 (list p 'nx_))))
    (lambda ()
      (let* ((lk2 (dk-peel!)) (v (cadr (car lk2))) (leaf (proof-state-focus *ps*)))
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR v)
        (dk-cite! 'fun-apply-type-c 'g 'omega 'RR v)
        (sipl-beta-all! leaf)
        (if (not (sequent-node-grounded? leaf))
            (let ((t (cadr (caddr (dk-goal))))) (dk-real! t) (dk-cite! 'rr-sq-nonneg t) (ass))))))
  (dk-split-all! (list (dk-cite! 'rintegral-of-nonneg 'omega 'cA 'mu p)))
  (dk-iff!
    (lambda (gl) (dk-head-is? gl 'FORSOME))
    (lambda ()
      ;; the integral vanishes, so the set where the square is positive is null
      (dk-have! (list '= ip 0) (lambda () (subst (list '= ip (sipl-rint p))) (ass)))
      (fact 'integral-zero-null 'omega 'cA 'mu p)
      (let ((tails (list 'FORALL 'alpha_ (list 'IMPLIES '(IN alpha_ RR) (list 'IN (list 'SEP 'x_ 'omega (list '< 'alpha_ (list p 'x_))) 'cA)))))
        (dk-have! tails (lambda () (mac-h 'IS-MEASURABLE-FN (list 'IS-MEASURABLE-FN 'omega 'cA p)) (dk-split-all!) (ass)))
        (dk-have! '(IN 0 RR) (lambda () (arith)))
        (inst*! tails 0))
      (ew n)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond
              ((dk-head-is? gl 'IS-NULL-SET)
               (mac 'IS-NULL-SET)
               (ew n)
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'SUBSET)
                       (begin (mac 'subset-def) (dk-peel!) (ass))
                       (ass)))))
              (#t
               (let* ((lk3 (dk-peel!))
                      (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'omega))) lk3))))
                      (notn (car (filter (lambda (f) (dk-head-is? f 'NOT)) lk3)))
                      (px (list p x)) (dx (list d x)))
                 (sipl-pt-eqs! d p x)
                 (dk-have! '(IN 0 RR) (lambda () (arith)))
                 (inst*! (list 'FORALL 'nx_ (list 'IMPLIES '(IN nx_ omega) (list '<= 0 (list p 'nx_)))) x)
                 (dk-have! (list 'AND '(IN 0 RR) (list 'IN px 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
                 (let ((cs (dk-cite! 'rr-le-cases 0 px)))
                   (use-cases (list (list '< 0 px) (list '= 0 px))
                     (lambda ()
                       (dk-have! (list 'IN x n) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
                       (ai notn))
                     (lambda ()
                       (dk-have! (list '= (list '* dx dx) 0) (lambda () (subst (list '= (list '* dx dx) px)) (subst (list '= px 0)) (rfl)))
                       (let ((nz (dk-cite! 'rr-no-zero-divisors dx dx)))
                         (dk-have! (list '= dx 0) (lambda () (if (dk-only! nz (list '= (list '* dx dx) 0)) (prop)))))
                       (dk-ineq! (list '= dx 0) (list '= dx (list '+ (list 'f x) (list '- (list 'g x))))
                                 (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR) (list 'IN dx 'RR))))))))))))
    (lambda ()
      ;; equal off a null set: the square vanishes off it, and so does its integral
      (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the null set"))
             (ns (dk-skolem! ex))
             (ag (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ns))) "the agreement"))
             (z '(VNB-LAMBDA cx_ omega 0)))
        (fact 'integrable-zero 'omega 'cA 'mu)
        (sipl-fun-type! z)
        (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list 'IMPLIES (list 'NOT (list 'IN 'ex_ ns)) (list '= (list z 'ex_) (list p 'ex_)))))
          (lambda ()
            (let* ((lk3 (dk-peel!))
                   (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'omega))) lk3))))
                   (dx (list d x)) (px (list p x)))
              (sipl-pt-eqs! d p x)
              (inst*! ag x)
              (dk-have! (list '= (list z x) 0) (lambda () (sipl-beta-rfl!)))
              (subst (list '= (list z x) 0))
              (subst (list '= px (list '* dx dx)))
              (subst (list '= dx (list '+ (list 'f x) (list '- (list 'g x)))))
              (subst (list '= (list 'f x) (list 'g x)))
              (crs))))
        (dk-split-all! (list (dk-cite! 'rintegral-ae-eq 'omega 'cA 'mu z p ns)))
        (fact 'rintegral-zero-fn 'omega 'cA 'mu)
        (subst (list '= (sipl-rint p) (sipl-rint z)))
        (ass)))))
(sipl-qed! 'l2-null-iff-ae)
(alias! 'l2-null-iff-ae "in L^2, <f - g, f - g> = 0 exactly when f = g almost everywhere")

;;; ---- the null-vector relation of L^2 is equality almost everywhere ----------------------------
(define sipl-sr '(SIP-REL (L2-SPACE omega cA mu)))
(define sipl-ar '(AE-REL omega cA mu (L2-SET omega cA mu)))
(define (sipl-pair-open! w cart)        ; w in CART(A, A): land w = [w1, w2] and the two memberships
  (let ((iff (dk-cite! 'cartesian-membership-nth (cadr cart) (caddr cart) w)))
    (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IN w cart)) (prop))))
    (dk-split-all! (list (caddr iff)))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
  (list '= sipl-sr sipl-ar)))))))
(dk-peel!)
(sipl-measure-set!)
(fact 'l2-space-is-sip 'omega 'cA 'mu)
(fact 'l2-space-VEC 'omega 'cA 'mu)
(dk-have! (list 'FORALL 'rw_ (list 'IFF (list 'IN 'rw_ sipl-sr) (list 'IN 'rw_ sipl-ar)))
  (lambda ()
    (let ((w (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
      (let ((a (list 'NTH 1 w)) (b (list 'NTH 2 w)))
        (dk-iff!
          (lambda (gl) (equal? gl (list 'IN w sipl-ar)))
          (lambda ()
            (let* ((h (dk-landed-1 (lambda () (mac-h 'sip-rel-unfold (list 'IN w sipl-sr)))))
                   (ls (dk-landed (lambda () (sep-me h))))
                   (cond0 (any-pred (lambda (f) (dk-head-is? f '=)) ls)))
              (sipl-pair-open! w '(CARTESIAN (VEC (L2-SPACE omega cA mu)) (VEC (L2-SPACE omega cA mu))))
              (for-each (lambda (t) (dk-have! (list 'IN t sipl-L2) (lambda () (subst (list '= sipl-L2 '(VEC (L2-SPACE omega cA mu)))) (ass))))
                        (list a b))
              (let* ((iff (dk-cite! 'l2-null-iff-ae 'omega 'cA 'mu a b))
                     (ex (caddr iff)))
                (dk-have! ex (lambda () (if (dk-only! iff cond0) (prop))))
                (let* ((ns (dk-skolem! ex)))
                  (fact 'ae-rel-in 'omega 'cA 'mu sipl-L2 a b ns)
                  (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list 'LIST a b)) (equal? (caddr f) sipl-ar))) "the pair")))
                    (dk-rewrite-h! m (list 'LIST a b) w)
                    (ass))))))
          (lambda ()
            (let* ((h (dk-landed-1 (lambda () (mac-h 'ae-rel-unfold (list 'IN w sipl-ar)))))
                   (ls (dk-landed (lambda () (sep-me h))))
                   (cond0 (any-pred (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
              (sipl-pair-open! w (list 'CARTESIAN sipl-L2 sipl-L2))
              (for-each (lambda (t) (dk-have! (list 'IN t '(VEC (L2-SPACE omega cA mu))) (lambda () (subst (list '= '(VEC (L2-SPACE omega cA mu)) sipl-L2)) (ass))))
                        (list a b))
              (let* ((iff (dk-cite! 'l2-null-iff-ae 'omega 'cA 'mu a b))
                     (nul (cadr iff)))
                (dk-have! nul (lambda () (if (dk-only! iff cond0) (prop))))
                (fact 'sip-rel-in (list 'L2-SPACE 'omega 'cA 'mu) a b)
                (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list 'LIST a b)) (equal? (caddr f) sipl-sr))) "the pair")))
                  (dk-rewrite-h! m (list 'LIST a b) w)
                  (ass)))))))))
  )
(fact 'class-extensionality sipl-sr sipl-ar)
(ass)
(sipl-qed! 'l2-null-rel-is-ae-rel)

;;; ---- so the null-vector quotient of L^2 IS its quotient by equality almost everywhere ------
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
  (list 'SUBSET sipl-L2 '(FUN omega RR))))))))
(dk-peel!)
(mac 'subset-def)
(let ((f (dk-di-var!)))
  (sipl-l2-var! f)
  (ass))
(sipl-qed! 'l2-set-subset-fun)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
  (list '= '(SIP-SETOID (L2-SPACE omega cA mu)) (list 'AE-SETOID 'omega 'cA 'mu sipl-L2))))))))
(dk-peel!)
(sipl-measure-set!)
(fact 'l2-set-is-set 'omega 'cA 'mu)
(fact 'l2-set-subset-fun 'omega 'cA 'mu)
(fact 'l2-space-is-sip 'omega 'cA 'mu)
(fact 'l2-space-VEC 'omega 'cA 'mu)
(fact 'l2-null-rel-is-ae-rel 'omega 'cA 'mu)
(fact 'ae-setoid-is-setoid 'omega 'cA 'mu sipl-L2)
(fact 'sip-setoid-is-setoid '(L2-SPACE omega cA mu))
(mac 'SIP-SETOID)
(subst (list '= '(VEC (L2-SPACE omega cA mu)) sipl-L2))
(subst (list '= sipl-sr sipl-ar))
(mac 'AE-SETOID)
(if (not (proof-done? *ps*)) (rfl))
(sipl-qed! 'l2-setoid-is-ae-setoid)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu)
  (list '= '(QUOTIENT (SIP-SETOID (L2-SPACE omega cA mu))) (list 'QUOTIENT (list 'AE-SETOID 'omega 'cA 'mu sipl-L2)))))))))
(dk-peel!)
(sipl-measure-set!)
(fact 'l2-set-is-set 'omega 'cA 'mu)
(fact 'l2-set-subset-fun 'omega 'cA 'mu)
(fact 'ae-setoid-is-setoid 'omega 'cA 'mu sipl-L2)
(fact 'quotient-is-set (list 'AE-SETOID 'omega 'cA 'mu sipl-L2))
(fact 'l2-setoid-is-ae-setoid 'omega 'cA 'mu)
(subst (list '= '(SIP-SETOID (L2-SPACE omega cA mu)) (list 'AE-SETOID 'omega 'cA 'mu sipl-L2)))
(if (not (proof-done? *ps*)) (rfl))
(sipl-qed! 'l2-quotient-is-ae-quotient)
(alias! 'l2-quotient-is-ae-quotient "the null-vector quotient of L^2 is its quotient by equality almost everywhere")

;;; and that quotient is a (real) pre-Hilbert space: Definition 1.17 for L^2
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-PRE-HILBERT-SPACE (SIP-QUOTIENT (L2-SPACE omega cA mu)))))))))
(dk-peel!)
(fact 'l2-space-is-sip 'omega 'cA 'mu)
(fact 'sip-quotient-is-pre-hilbert '(L2-SPACE omega cA mu))
(ass)
(sipl-qed! 'l2-quotient-is-pre-hilbert)

;;; ==========================================================================================
;;; COMPLEX L^2: the complexification of real L^2.  By sip-b.scm it is a complex
;;; semi-inner-product space; its quotient by the null vectors is a complex pre-Hilbert space,
;;; and with (37)-(38) a COMPLEX-INNER-PRODUCT-SPACE.
;;; ==========================================================================================
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE (CL2-SPACE omega cA mu))))))))
(dk-peel!)
(fact 'l2-space-is-sip 'omega 'cA 'mu)
(fact 'complexify-is-csip '(L2-SPACE omega cA mu))
(mac 'CL2-SPACE)
(ass)
(sipl-qed! 'cl2-space-is-csip)
(alias! 'cl2-space-is-csip "complex L^2 is a complex semi-inner-product space")

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-COMPLEX-PRE-HILBERT-SPACE (CSIP-QUOTIENT (CL2-SPACE omega cA mu)))))))))
(dk-peel!)
(fact 'cl2-space-is-csip 'omega 'cA 'mu)
(fact 'csip-quotient-is-cphs '(CL2-SPACE omega cA mu))
(ass)
(sipl-qed! 'cl2-quotient-is-cphs)

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
  (IS-COMPLEX-INNER-PRODUCT-SPACE (CSIP-CIPS (CSIP-QUOTIENT (CL2-SPACE omega cA mu))))))))))
(dk-peel!)
(fact 'cl2-quotient-is-cphs 'omega 'cA 'mu)
(fact 'cphs-is-complex-inner-product-space '(CSIP-QUOTIENT (CL2-SPACE omega cA mu)))
(ass)
(sipl-qed! 'cl2-quotient-is-cips)
(alias! 'cl2-quotient-is-cips "complex L^2 modulo null functions is a complex inner product space")
