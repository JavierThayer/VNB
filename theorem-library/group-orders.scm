;;; THE PARTITION BY ORDERS: card G = sum_{d | card G} #{y : ord(y) = d}
(define (z8-os d) (list 'SEP 'oy_ '(CARR g) (list 'IS-ELEMENT-ORDER 'g 'oy_ d)))
(sp (make-wff (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'IMPLIES '(IN (CARD (CARR g)) NN)
  (list '= '(CARD (CARR g)) (list 'FINSUM ie-ag (list 'VNB-LAMBDA 'od_ (n10-div '(CARD (CARR g))) (list 'CARD (z8-os 'od_))) (n10-div '(CARD (CARR g))))))))))
(dk-peel!)
(ie-ring!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in) (fact 'group-carr-set 'g) (fact 'group-identity-in 'g)
(let* ((n '(CARD (CARR g))) (dv (n10-div n)) (iv (list 'INTERVAL 1 n))
       (aa (list 'VNB-LAMBDA 'oa_ dv (z8-os 'oa_)))
       (sb (lambda (f) (subst-free* (list (cons 'af aa) (cons 'ii dv)) f)))
       (fin (sb n10-fin)) (disj (sb n10-disj))
       (bu (list 'BIG-UNION 'fu_ dv (list aa 'fu_)))
       (f1 (list 'VNB-LAMBDA 'fc_ dv (list 'CARD (list aa 'fc_))))
       (f2 (list 'VNB-LAMBDA 'od_ dv (list 'CARD (z8-os 'od_))))
       (div-open! (lambda (i) (ma-sep-parts! (list 'IN i dv)) (ma-iff-parts! (dk-cite! 'interval-membership 1 n i)) (dk-type! i 'ZZ)))
       (aval! (lambda (i) (dk-have! (list '= (list aa i) (z8-os i)) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))
  (dk-type! n 'ZZ)
  ;; 1 <= n: the identity is an element
  (dk-have! (list '<= 1 n)
    (lambda () (dk-have! (list 'SUBSET '(PAIR (IDEN g) (IDEN g)) '(CARR g))
                 (lambda () (mac 'subset-def) (let ((r (dk-di-var!))) (fact 'membership-implies-sethood '(IDEN g) '(CARR g)) (ma-singleton-eq! r '(IDEN g)) (subst (list '= r '(IDEN g))) (ass))))
               (dk-have! '(AND (IN (CARR g) SET) (IN (CARD (CARR g)) NN)))
               (dk-apply! (dk-cite! 'card-subset-mono '(CARR g)) '(PAIR (IDEN g) (IDEN g)))
               (fact 'membership-implies-sethood '(IDEN g) '(CARR g))
               (fact 'card-singleton '(IDEN g)) (fact 'nn-zero-in)
               (dk-rewrite-h! (list '<= '(CARD (PAIR (IDEN g) (IDEN g))) n) '(CARD (PAIR (IDEN g) (IDEN g))) '(succ 0))
               (dk-nn! (list '<= '(succ 0) n))))
  (fact 'interval-in-set 1 n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
  (nt3-fin! dv iv)
  (dk-have! fin
    (lambda ()
      (let ((i (dk-di-var!)))
        (aval! i)
        (nt3-fin! (z8-os i) '(CARR g))
        (subst (list '= (list aa i) (z8-os i)))
        (dk-conj-close! (lambda () (ass))))))
  (dk-have! disj
    (lambda ()
      (let* ((ijw (begin (dk-peel!) (dk-goal))) (i (cadr ijw)) (j (caddr ijw))
             (w (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list aa i)))) (dk-asms)))))
        (aval! i) (aval! j)
        (dk-rewrite-h! (list 'IN w (list aa i)) (list aa i) (z8-os i))
        (dk-rewrite-h! (list 'IN w (list aa j)) (list aa j) (z8-os j))
        (ma-sep-parts! (list 'IN w (z8-os i)))
        (ma-sep-parts! (list 'IN w (z8-os j)))
        (dk-apply! (dk-cite! 'element-order-unique) 'g w i j)
        (ass))))
  (dk-apply! (dk-cite! 'card-disjoint-family dv) aa)
  (ma-ext2! bu '(CARR g)
    (lambda (w) (let* ((ia (ma-bu-open! w bu)) (i (car ia))) (aval! i) (dk-rewrite-h! (list 'IN w (list aa i)) (list aa i) (z8-os i))
                  (ma-sep-parts! (list 'IN w (z8-os i))) (ass)))
    (lambda (y)
      (let ((d (dk-skolem! (dk-apply! (dk-cite! 'element-order-exists) 'g y) #t)))
        (dk-apply! (dk-cite! 'element-order-divides-card) 'g y d)
        (z2-open! 'is-element-order (list 'g y d) (list 'IS-ELEMENT-ORDER 'g y d))
        (dk-type! d 'ZZ)
        (dk-apply! (dk-cite! 'zz-divides-le-pos) d n)
        (ma-iff-back! (dk-cite! 'interval-membership 1 n d))
        (dk-have! (list 'IN d dv) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
        (aval! d)
        (dk-have! (list 'IN y (list aa d)) (lambda () (subst (list '= (list aa d) (z8-os d))) (in-sep! dk-ass! (lambda () (ass)))))
        (ma-bu-close! d))))
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dv) (list '= (list f1 'z) (list f2 'z))))
    (lambda () (let ((z (dk-di-var!))) (nt3-fin! (z8-os z) '(CARR g)) (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (n10-rfl!))))))
  (dk-apply! (dk-cite! 'finsum-congruence-q ie-ag) dv f1 f2)
  (subst (list '== (list 'FINSUM ie-ag f2 dv) (list 'FINSUM ie-ag f1 dv)))
  (subst (list '= (list 'FINSUM ie-ag f1 dv) (list 'CARD bu)))
  (subst (list '= bu '(CARR g)))
  (n10-rfl!))
(qed 'order-partition)


;;; ==================================================================== from grp9.scm
;;; (58) ALGEBRAIC-NUMBERS ch. 5, Lemma 5.44: a finite group in which x^d = e has at most d solutions for every d >= 1
;;; is cyclic.  The notes' route: #{ord = d} is 0 or phi(d), the orders partition G, and sum_{d | n} phi(d) = n.
;;; Helper prefix z9-.
;;; M4: termwise <= of real summands gives <= of the sums (the sums taken in C, as inclusion-exclusion)
(define (z9-sum f s) (list 'FINSUM ie-ag f s))
(define z9-hyp '(FORALL mi_ (IMPLIES (IN mi_ ii) (AND (IN (fa mi_) RR) (AND (IN (fb mi_) RR) (<= (fa mi_) (fb mi_)))))))
(define (z9-prop s) (list 'IMPLIES (n10-sub s) (list 'AND (list 'IN (z9-sum 'fa s) 'RR) (list 'AND (list 'IN (z9-sum 'fb s) 'RR) (list '<= (z9-sum 'fa s) (z9-sum 'fb s))))))
(sp (make-wff (list 'FORALL 'ii (list 'IMPLIES '(IN ii SET) (list 'IMPLIES '(IN (CARD ii) NN) (list 'FORALL 'fa (list 'FORALL 'fb (list 'IMPLIES z9-hyp
  (list 'AND (list 'IN (z9-sum 'fa 'ii) 'RR) (list 'AND (list 'IN (z9-sum 'fb 'ii) 'RR) (list '<= (z9-sum 'fa 'ii) (z9-sum 'fb 'ii))))))))))))
(dk-peel!)
(ie-ring!)
(fact 'empty-set-is-set) (fact 'rr-zero-in)
(dk-cite! 'ras-id ie-r) (dk-cite! 'ras-op ie-r)
(dk-have! (list '= (list 'ZERO ie-r) 0) (lambda () (mac 'cc-scalar-ring-zero) (n10-rfl!)))
(let ((res (ma-induct! 'ii z9-prop
             (lambda ()
               (di)
               (dk-cite! 'finsum-empty ie-ag 'fa) (dk-cite! 'finsum-empty ie-ag 'fb)
               (dk-conj-close!
                 (lambda ()
                   (subst (list '== (z9-sum 'fa 'EMPTY-SET) (list 'IDEN ie-ag)))
                   (subst (list '== (z9-sum 'fb 'EMPTY-SET) (list 'IDEN ie-ag)))
                   (subst (list '= (list 'IDEN ie-ag) (list 'ZERO ie-r)))
                   (subst (list '= (list 'ZERO ie-r) 0))
                   (if (not (dk-ass!)) (dk-ineq!)))))
             (lambda (sv xv u ih)
               (di)
               (let* ((pr (list 'PAIR xv xv)) (sa (z9-sum 'fa sv)) (sb (z9-sum 'fb sv)) (ax (list 'fa xv)) (bx (list 'fb xv)))
                 (ma-in-singleton! xv) (ma-in-union-right! xv sv pr)
                 (dk-have! (n10-sub sv) (lambda () (let ((z (dk-di-var!))) (ma-in-union-left! z sv pr) (dk-apply! (dk-ctx-form (n10-sub u)) z) (ass))))
                 (dk-split-all! (list (dk-apply! (dk-ctx-form ih))))
                 (dk-apply! (dk-ctx-form (n10-sub u)) xv)
                 (dk-split-all! (list (dk-apply! (dk-ctx-form z9-hyp) xv)))
                 (for-each (lambda (f)
                   (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list f 'z_) (list 'CARR ie-ag))))
                     (lambda () (let ((z (dk-di-var!))) (dk-apply! (dk-ctx-form (n10-sub u)) z) (dk-split-all! (list (dk-apply! (dk-ctx-form z9-hyp) z)))
                                  (subst (list '= (list 'CARR ie-ag) 'CC)) (fact 'rr-subset-cc (list f z)) (ass))))
                   (dk-apply! (dk-cite! 'finsum-insert-ptwise ie-ag) sv xv f))
                   '(fa fb))
                 (for-each (lambda (t) (fact 'rr-subset-cc t)) (list sa sb ax bx))
                 (ie-op-eq! 'ADD sa ax) (ie-op-eq! 'ADD sb bx)
                 (dk-type! (list '+ sa ax) 'RR) (dk-type! (list '+ sb bx) 'RR)
                 (let ((rw! (lambda (f s x)
                              (subst (list '= (z9-sum f u) (list (list 'OPR ie-ag) (z9-sum f sv) (list f xv))))
                              (subst (list '= (list 'OPR ie-ag) (list 'ADD ie-r)))
                              (subst (list '= (list (list 'ADD ie-r) (z9-sum f sv) (list f xv)) (list '+ (z9-sum f sv) (list f xv)))))))
                   (dk-conj-close!
                     (lambda ()
                       (let ((g (dk-goal)))
                         (if (dk-contains? g (z9-sum 'fa u)) (rw! 'fa sv xv))
                         (if (dk-contains? (dk-goal) (z9-sum 'fb u)) (rw! 'fb sv xv))
                         (if (not (dk-ass!))
                             (dk-ineq! (list '<= sa sb) (list '<= ax bx) (list 'IN sa 'RR) (list 'IN sb 'RR) (list 'IN ax 'RR) (list 'IN bx 'RR))))))))))))
  (dk-have! (n10-sub 'ii) (lambda () (let ((z (dk-di-var!))) (ass))))
  (dk-split-all! (list (dk-apply! (dk-ctx-form res))))
  (dk-conj-close! (lambda () (ass))))
(qed 'finsum-cc-le-termwise)

(define (z9-card-insert! s x)
  (let ((u (list 'UNION s (list 'PAIR x x))))
    (dk-apply! (dk-cite! 'card-insert-curried s) x)
    (dk-apply! (dk-cite! 'ord-succ-nn) (list 'CARD s))
    (fact 'nn-succ-closed (list 'CARD s))
    (dk-have! (list '= (list 'CARD u) (list 'succ (list 'CARD s)))
      (lambda () (subst (list '= (list 'CARD u) (list 'succ_ord (list 'CARD s)))) (subst (list '= (list 'succ_ord (list 'CARD s)) (list 'succ (list 'CARD s)))) (n10-rfl!)))))
;;; a subset A of a finite set B with card B <= card A is B
(sp (make-wff (forall-guarded '(sa sb) '((IN sb SET) (IN (CARD sb) NN) (SUBSET sa sb) (<= (CARD sb) (CARD sa))) '(= sa sb))))
(dk-peel!)
(fact 'subclass-of-set-is-set 'sa 'sb)
(dk-have! '(AND (IN sb SET) (IN (CARD sb) NN)))
(let ((sub (list 'FORALL 'scz_ (list 'IMPLIES '(IN scz_ sa) '(IN scz_ sb)))))
  (dk-have! sub (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd 'sa 'sb z) (ass))))
  (dk-have! (list 'AND '(IN sa SET) sub))
  (dk-apply! (dk-cite! 'card-subset-nn 'sb) 'sa)
  (ma-ext2! 'sa 'sb
    (lambda (w) (dk-apply! (dk-ctx-form sub) w) (ass))
    (lambda (w)
      (use-em (list 'IN w 'sa)
        (lambda () (ass))
        (lambda ()
          (let ((u (list 'UNION 'sa (list 'PAIR w w))))
            (fact 'membership-implies-sethood w 'sb)
            (z9-card-insert! 'sa w)
            (dk-have! (list 'SUBSET u 'sb)
              (lambda () (mac 'subset-def)
                         (let ((r (dk-di-var!)))
                           (ie-or-split! r 'sa (list 'PAIR w w)
                             (lambda () (dk-apply! (dk-ctx-form sub) r) (ass))
                             (lambda () (ma-singleton-eq! r w) (subst (list '= r w)) (ass))))))
            (dk-apply! (dk-cite! 'card-subset-mono 'sb) u)
            (dk-rewrite-h! (list '<= (list 'CARD u) '(CARD sb)) (list 'CARD u) '(succ (CARD sa)))
            (dk-have! '(< 0 0) (lambda () (dk-nn! '(<= (succ (CARD sa)) (CARD sb)) '(<= (CARD sb) (CARD sa)))))
            (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))))))
  (dk-ass!))
(qed 'subset-card-eq)

;;; M1: if x has order d and x^r (r >= 1) has order d too, then r is prime to d
(sp (make-wff (z2-gx (forall-guarded '(d r) (list '(IS-ELEMENT-ORDER g x d) '(IN r ZZ) '(<= 1 r) (list 'IS-ELEMENT-ORDER 'g (z2-z 'r) 'd)) '(ZZ-COPRIME r d)))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-type! 'd 'ZZ) (fact 'zz-in-rr 'd) (fact 'zz-in-rr 'r) (fact 'zz-zero-in) (fact 'zz-one-in)
(n10-nz! 'd '<=)
(let* ((y (z2-z 'r))
       (g0 (dk-skolem! (dk-apply! (dk-cite! 'zz-gcd-pos-exists) 'r 'd) #t)))
  (dk-type! g0 'ZZ) (fact 'zz-in-rr g0)
  (dk-cite! 'zpow-type 'r 'g 'x)
  (z2-open! 'is-element-order (list 'g y 'd) (list 'IS-ELEMENT-ORDER 'g y 'd))
  (z2-open! 'zz-is-gcd (list 'r 'd g0) (list 'ZZ-IS-GCD 'r 'd g0))
  (dk-have! (list '< 0 g0) (lambda () (dk-ineq! (list '<= 1 g0))))
  (let* ((r1 (z3-dv! g0 'r)) (d1 (z3-dv! g0 'd)))
    (z6-cofactor-pos! g0 d1 'd)
    (dk-have! (list '<= 0 d1) (lambda () (dk-ineq! (list '<= 1 d1))))
    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) d1)
    ;; y^d1 = x^(r d1) = x^(d r1) = e
    (dk-apply! (dk-cite! 'zpow-zpow d1) 'r 'g 'x)
    (dk-type! (list '* 'r d1) 'ZZ)
    (dk-apply! (dk-cite! 'zpow-multiple-period r1) 'g 'x 'd)
    (dk-have! (list '= (list '* 'r d1) (list '* 'd r1)) (lambda () (subst (list '= 'r (list '* g0 r1))) (subst (list '= 'd (list '* g0 d1))) (crs)))
    (dk-apply! (dk-cite! 'zpow-nat d1) 'g y)
    (dk-have! (list '= (list 'GPOW 'g y d1) z2-e)
      (lambda () (subst (list '= (list 'GPOW 'g y d1) (z7-z 'g y d1))) (subst (list '= (z7-z 'g y d1) (z2-z (list '* 'r d1))))
                 (subst (list '= (list '* 'r d1) (list '* 'd r1))) (ass)))
    ;; minimality: d <= d1, so g0 = 1
    (dk-apply! (dk-ctx-form (z3-min y 'd)) d1)
    (dk-have! (list '<= g0 1)
      (lambda ()
        (dk-type! (list '* g0 d1) 'RR) (dk-type! (list '* 1 d1) 'RR)
        (dk-have! (list '<= (list '* g0 d1) (list '* 1 d1)) (lambda () (dk-ineq! (list '<= 'd d1) (list '= 'd (list '* g0 d1)) (list 'IN (list '* g0 d1) 'RR) (list 'IN (list '* 1 d1) 'RR))))
        (dk-have! (list '< 0 d1) (lambda () (dk-ineq! (list '<= 1 d1))))
        (fact 'zz-in-rr d1) (fact 'rr-one-in)
        (dk-apply! (dk-cite! 'rr-mul-le-cancel-pos) g0 d1 1)
        (ass)))
    (dk-have! (list '= g0 1) (lambda () (dk-have! (list 'AND (list 'IN g0 'RR) '(IN 1 RR))) (dk-have! (list 'AND (list '<= g0 1) (list '<= 1 g0))) (fact 'rr-leq-antisymmetric g0 1) (ass)))
    (dk-rewrite-h! (list 'ZZ-IS-GCD 'r 'd g0) g0 1)
    (z2-close! 'zz-coprime '(r d) (lambda () (ass)))))
(qed 'order-of-power-coprime)

;;; the hypothesis of 5.44 and its sets
(define (z9-gd d) (list 'SEP 'hy_ '(CARR g) (list '= (list 'GPOW 'g 'hy_ d) '(IDEN g))))
(define z9-h '(FORALL hd_ (IMPLIES (IN hd_ NN) (IMPLIES (<= 1 hd_) (<= (CARD (SEP hy_ (CARR g) (= (GPOW g hy_ hd_) (IDEN g)))) hd_)))))
;;; M2: for x of order d, #{y : ord(y) = d} <= #{k in 1..d : k prime to d}
(sp (make-wff (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d) (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'IMPLIES z9-h
  (list '<= (list 'CARD (z8-os 'd)) (list 'CARD (nt3-phiset 'd))))))))))
(dk-peel!)
(z3-ord-parts! 'd)
(fact 'group-carr-set 'g) (fact 'group-identity-in 'g) (fact 'zz-zero-in) (dk-type! 'd 'ZZ)
(let* ((ps z8-ps) (gd (z9-gd 'd)) (os (z8-os 'd)) (ph (nt3-phiset 'd)) (iv '(INTERVAL 1 d))
       (phi (list 'VNB-LAMBDA 'z9k_ ph '(GPOW g x z9k_))) (im (list 'IMAGE phi ph))
       (ph-open! (lambda (k) (ma-sep-parts! (list 'IN k ph)) (ma-iff-parts! (dk-cite! 'interval-membership 1 'd k)))))
  (dk-split-all! (list (dk-apply! (dk-cite! 'powers-card) 'g 'x 'd)))
  (nt3-fin! gd '(CARR g)) (nt3-fin! os '(CARR g))
  (fact 'interval-in-set 1 'd) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'd))
  (nt3-fin! ph iv)
  ;; PS = G_d
  (dk-have! (list 'SUBSET ps gd)
    (lambda ()
      (mac 'subset-def)
      (let* ((y (dk-di-var!)) (k (z8-ps-open! y)))
        (dk-type! (list '* 'd k) 'ZZ)
        (dk-apply! (dk-cite! 'zpow-zpow 'd) k 'g 'x)
        (dk-apply! (dk-cite! 'zpow-multiple-period k) 'g 'x 'd)
        (dk-apply! (dk-cite! 'zpow-nat 'd) 'g y)
        (in-sep! dk-ass!
          (lambda ()
            (subst (list '= (list 'GPOW 'g y 'd) (z7-z 'g y 'd)))
            (subst (list '= y (z2-z k)))
            (subst (list '= (z7-z 'g (z2-z k) 'd) (z2-z (list '* k 'd))))
            (dk-have! (list '= (list '* k 'd) (list '* 'd k)) (lambda () (crs)))
            (subst (list '= (list '* k 'd) (list '* 'd k)))
            (ass))))))
  (dk-apply! (dk-ctx-form z9-h) 'd)
  (dk-have! (list '<= (list 'CARD gd) (list 'CARD ps)) (lambda () (subst (list '= (list 'CARD ps) 'd)) (ass)))
  (dk-apply! (dk-cite! 'subset-card-eq) ps gd)
  ;; the elements of order d are the x^r, r prime to d
  (dk-have! (list 'IN phi (list 'FUN ph '(CARR g)))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (ph-open! k) (z2-pwt! k) (ass))) (lambda () (dk-ass!)))))
  (let ((inj (dk-cite! 'injection-membership-iff ph '(CARR g) phi)))
    (dk-have! (caddr (caddr inj))
      (lambda ()
        (let* ((ab (begin (dk-peel!) (dk-goal))) (a (cadr ab)) (b (caddr ab)))
          (ph-open! a) (ph-open! b) (z2-pwt! a) (z2-pwt! b) (z3-val! phi a (z2-pw a)) (z3-val! phi b (z2-pw b))
          (dk-have! (list '= (z2-pw a) (z2-pw b))
            (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list phi a) (list phi b)) (list phi a) (z2-pw a)) (list phi b) (z2-pw b)))) (ass))))
          (dk-apply! (dk-cite! 'gpow-injective-below-order) 'g 'x 'd a b)
          (ass))))
    (ma-iff-back! inj))
  (fact 'image-set phi ph)
  (dk-have! (list 'SUBSET os im)
    (lambda ()
      (mac 'subset-def)
      (let ((y (dk-di-var!)))
        (ma-sep-parts! (list 'IN y os))
        (z2-open! 'is-element-order (list 'g y 'd) (list 'IS-ELEMENT-ORDER 'g y 'd))
        (dk-have! (list 'IN y gd) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
        (dk-rewrite-h! (list 'IN y gd) gd ps)
        (let* ((k (z8-ps-open! y))
               (r (dk-skolem! (dk-apply! (dk-cite! 'zpow-residue) 'g 'x 'd k) #t)))
          (dk-type! r 'ZZ)
          (dk-apply! (dk-cite! 'zpow-nat r) 'g 'x)
          (z2-pwt! r)
          (dk-have! (list '= y (z2-z r)) (lambda () (subst (list '= y (z2-z k))) (subst (list '= (z2-z k) (z2-pw r))) (subst (list '= (z2-z r) (z2-pw r))) (z2-rfl!)))
          (dk-rewrite-h! (list 'IS-ELEMENT-ORDER 'g y 'd) y (z2-z r))
          (dk-apply! (dk-cite! 'order-of-power-coprime) 'g 'x 'd r)
          (ma-iff-back! (dk-cite! 'interval-membership 1 'd r))
          (dk-have! (list 'IN r ph) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
          (z3-val! phi r (z2-pw r))
          (fact 'membership-implies-sethood y '(CARR g))
          (let* ((iff (dk-cite! 'image-membership-iff phi ph y)) (fs (caddr (caddr iff))))
            (dk-have! fs (lambda () (ew r) (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                                     (begin (subst (list '= (list phi r) (z2-pw r))) (subst (list '= y (z2-z r))) (subst (list '= (z2-z r) (z2-pw r))) (z2-rfl!)))))))
            (ma-iff-back! iff))))))
  (dk-have! (list 'AND (list 'IN phi (list 'INJECTION ph '(CARR g))) (list 'AND (list 'IN ph 'SET) (list 'IN (list 'CARD ph) 'NN))) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'card-image-injection ph '(CARR g) phi)
  (dk-have! (list 'IN (list 'CARD im) 'NN) (lambda () (subst (list '= (list 'CARD im) (list 'CARD ph))) (ass)))
  (dk-have! (list 'AND (list 'IN im 'SET) (list 'IN (list 'CARD im) 'NN)))
  (dk-apply! (dk-cite! 'card-subset-mono im) os)
  (subst (list '= (list 'CARD ph) (list 'CARD im)))
  (ass))
(qed 'order-count-le-at)

;;; M3: under the hypothesis, #{y : ord(y) = d} <= phi(d) for every d >= 1
(define (z9-os-empty! d)
  ;; no element of order d: (= (CARD OS(d)) 0)
  (let ((os (z8-os d)) (ex (list 'FORSOME 'ox_ (list 'IN 'ox_ (z8-os d)))))
    (ma-ext2! os 'EMPTY-SET
      (lambda (w) (dk-have! ex (lambda () (ew w) (ass))) (ma-prop-with! (list ex (list 'NOT ex))))
      (lambda (w) (fact 'empty-set-has-no-members w) (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
    (fact 'card-empty)
    (dk-have! (list '= (list 'CARD os) 0) (lambda () (subst (list '= os 'EMPTY-SET)) (ass)))))
(sp (make-wff (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'IMPLIES z9-h
  (list 'FORALL 'd (list 'IMPLIES '(IN d NN) (list 'IMPLIES '(<= 1 d) (list '<= (list 'CARD (z8-os 'd)) '(EULER-PHI d)))))))))))
(dk-peel!)
(fact 'group-carr-set 'g)
(let* ((os (z8-os 'd)) (ph (nt3-phiset 'd)) (ex (list 'FORSOME 'ox_ (list 'IN 'ox_ os))))
  (fact 'interval-in-set 1 'd) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'd))
  (nt3-fin! ph '(INTERVAL 1 d))
  (mac 'EULER-PHI)
  (use-em ex
    (lambda ()
      (let ((x (dk-skolem! (dk-ctx-form ex) #t)))
        (ma-sep-parts! (list 'IN x os))
        (dk-apply! (dk-cite! 'order-count-le-at) 'g x 'd)
        (ass)))
    (lambda ()
      (z9-os-empty! 'd)
      (subst (list '= (list 'CARD os) 0))
      (dk-nn!))))
(qed 'order-count-le)

;;; phi(n) >= 1: 1 is prime to n
(sp (make-wff (forall-guarded '(n) '((IN n NN) (<= 1 n)) (list '<= 1 (list 'CARD (nt3-phiset 'n))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in)
(dk-type! 'n 'ZZ) (fact 'nn-in-rr 'n)
(let* ((s (nt3-phiset 'n)) (iv '(INTERVAL 1 n)))
  (fact 'interval-in-set 1 'n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  (nt3-fin! s iv)
  (n10-nz! 'n '<=)
  (let ((iff (dk-cite! 'zz-coprime-iff-no-common-prime 1 'n)))
    (dk-have! (caddr iff)
      (lambda ()
        (di)
        (let ((q (cadr (cadr (dk-goal)))))
          (di) (di) (di)
          (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) q))) (dk-type! q 'ZZ) (fact 'nn-in-rr q)
          (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
          (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
          (dk-apply! (dk-cite! 'zz-divides-small) q 1)
          (ma-prop-with! (list (list 'ZZ-DIVIDES q 1) (list 'NOT (list 'ZZ-DIVIDES q 1)))))))
    (ma-iff-back! iff))
  (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
  (ma-iff-back! (dk-cite! 'interval-membership 1 'n 1))
  (dk-have! (list 'IN 1 s) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
  (fact 'membership-implies-sethood 1 'NN)
  (dk-have! (list 'SUBSET '(PAIR 1 1) s)
    (lambda () (mac 'subset-def) (let ((r (dk-di-var!))) (ma-singleton-eq! r 1) (subst (list '= r 1)) (ass))))
  (dk-apply! (dk-cite! 'card-subset-mono s) '(PAIR 1 1))
  (fact 'card-singleton 1)
  (fact 'nn-zero-in)
  (dk-rewrite-h! (list '<= '(CARD (PAIR 1 1)) (list 'CARD s)) '(CARD (PAIR 1 1)) '(succ 0))
  (dk-nn! (list '<= '(succ 0) (list 'CARD s))))
(qed 'phiset-card-pos)

;;; an element whose order is card G generates G
(sp (make-wff (z2-gx (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'IMPLIES '(IS-ELEMENT-ORDER g x (CARD (CARR g))) '(IS-GENERATOR g x))))))
(dk-peel!)
(let ((n '(CARD (CARR g))))
  (fact 'group-carr-set 'g)
  (dk-split-all! (list (dk-apply! (dk-cite! 'powers-card) 'g 'x n)))
  (dk-have! (list 'SUBSET z8-ps '(CARR g)) (lambda () (ma-sep-subset! z8-ps) (ass)))
  (dk-have! (list '<= n (list 'CARD z8-ps)) (lambda () (subst (list '= (list 'CARD z8-ps) n)) (fact 'nn-in-rr n) (dk-ineq!)))
  (dk-apply! (dk-cite! 'subset-card-eq) z8-ps '(CARR g))
  (z2-close! 'is-generator '(g x)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((y (begin (dk-peel!) (cadr (caddr (caddr (dk-goal)))))))
                (dk-have! (list 'IN y z8-ps) (lambda () (subst (list '= z8-ps '(CARR g))) (ass)))
                (let ((k (z8-ps-open! y)))
                  (ew k) (dk-conj-close! (lambda () (ass)))))))))))
(qed 'order-card-generator)

;;; LEMMA 5.44: a finite group in which x^d = e has at most d solutions, for every d >= 1, is cyclic.
;;; (The notes state it for finite Abelian groups; the proof uses no commutativity.)
(sp (make-wff (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'IMPLIES z9-h
  '(FORSOME cgx_ (IS-GENERATOR g cgx_))))))))
(dk-peel!)
(ie-ring!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in) (fact 'group-carr-set 'g) (fact 'group-identity-in 'g)
(let* ((n '(CARD (CARR g))) (dv (n10-div n)) (iv (list 'INTERVAL 1 n))
       (dv1 (list 'SEP 'od2_ dv (list 'NOT (list '= 'od2_ n))))
       (un (list 'UNION dv1 (list 'PAIR n n)))
       (fn (list 'VNB-LAMBDA 'od_ dv (list 'CARD (z8-os 'od_))))
       (fp (list 'VNB-LAMBDA 'gpd_ dv '(EULER-PHI gpd_)))
       (nn1 (list 'CARD (z8-os n))) (pn (list 'EULER-PHI n))
       (div-open! (lambda (i) (ma-sep-parts! (list 'IN i dv)) (ma-iff-parts! (dk-cite! 'interval-membership 1 n i)))))
  (dk-type! n 'ZZ)
  ;; 1 <= n
  (dk-have! (list '<= 1 n)
    (lambda () (dk-have! (list 'SUBSET '(PAIR (IDEN g) (IDEN g)) '(CARR g))
                 (lambda () (mac 'subset-def) (let ((r (dk-di-var!))) (fact 'membership-implies-sethood '(IDEN g) '(CARR g)) (ma-singleton-eq! r '(IDEN g)) (subst (list '= r '(IDEN g))) (ass))))
               (dk-have! '(AND (IN (CARR g) SET) (IN (CARD (CARR g)) NN)))
               (dk-apply! (dk-cite! 'card-subset-mono '(CARR g)) '(PAIR (IDEN g) (IDEN g)))
               (fact 'membership-implies-sethood '(IDEN g) '(CARR g))
               (fact 'card-singleton '(IDEN g)) (fact 'nn-zero-in)
               (dk-rewrite-h! (list '<= '(CARD (PAIR (IDEN g) (IDEN g))) n) '(CARD (PAIR (IDEN g) (IDEN g))) '(succ 0))
               (dk-nn! (list '<= '(succ 0) n))))
  (fact 'interval-in-set 1 n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
  (nt3-fin! dv iv) (nt3-fin! dv1 dv)
  ;; the two sums over the divisors of n
  (dk-apply! (dk-cite! 'order-partition) 'g)
  (dk-apply! (dk-cite! 'gauss-phi-sum) n)
  ;; n is a divisor; dv = dv1 u {n}, n not in dv1
  (fact 'nn-in-rr n)
  (dk-have! (list '<= n n) (lambda () (dk-ineq!)))
  (ma-iff-back! (dk-cite! 'interval-membership 1 n n))
  (dk-have! (list 'IN n dv) (lambda () (in-sep! dk-ass! (lambda () (dk-have! (list '= n (list '* n 1)) (lambda () (crs))) (z3-div-intro! 1)))))
  (fact 'membership-implies-sethood n 'NN)
  (dk-have! (list 'NOT (list 'IN n dv1)) (lambda () (di) (ma-sep-parts! (list 'IN n dv1)) (dk-have! (list '= n n) (lambda () (rfl))) (ma-prop-with! (list (list '= n n) (list 'NOT (list '= n n))))))
  (ma-ext2! dv un
    (lambda (w)
      (use-em (list '= w n)
        (lambda () (ma-in-singleton! n) (dk-have! (list 'IN w (list 'PAIR n n)) (lambda () (subst (list '= w n)) (ass))) (ma-in-union-right! w dv1 (list 'PAIR n n)) (ass))
        (lambda () (dk-have! (list 'IN w dv1) (lambda () (in-sep! dk-ass! (lambda () (ass))))) (ma-in-union-left! w dv1 (list 'PAIR n n)) (ass))))
    (lambda (w)
      (ie-or-split! w dv1 (list 'PAIR n n)
        (lambda () (ma-sep-parts! (list 'IN w dv1)) (ass))
        (lambda () (ma-singleton-eq! w n) (subst (list '= w n)) (ass)))))
  ;; N(n) and phi(n)
  (nt3-fin! (z8-os n) '(CARR g))
  (fact 'nn-in-rr nn1) (fact 'rr-subset-cc nn1)
  (let ((ph (nt3-phiset n)))
    (nt3-fin! ph iv)
    (dk-have! (list '= pn (list 'CARD ph)) (lambda () (mac 'EULER-PHI) (n10-rfl!)))
    (dk-have! (list 'IN pn 'NN) (lambda () (subst (list '= pn (list 'CARD ph))) (ass)))
    (dk-apply! (dk-cite! 'phiset-card-pos) n)
    (dk-rewrite-h! (list '<= 1 (list 'CARD ph)) (list 'CARD ph) pn)
    (fact 'nn-in-rr pn) (fact 'rr-subset-cc pn))
  (let ((val! (lambda (f i v) (dk-have! (list '= (list f i) v) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (n10-rfl!))))))))
    (val! fn n nn1) (val! fp n pn)
    ;; split both sums at n
    (for-each
      (lambda (f)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list f 'z_) (list 'CARR ie-ag))))
          (lambda ()
            (let ((z (dk-di-var!)))
              (dk-have! (list 'IN z dv) (lambda () (subst (list '= dv un)) (ass)))
              (div-open! z)
              (subst (list '= (list 'CARR ie-ag) 'CC))
              (if (eq? f fn)
                  (begin (nt3-fin! (z8-os z) '(CARR g)) (fact 'nn-in-rr (list 'CARD (z8-os z))) (fact 'rr-subset-cc (list 'CARD (z8-os z))))
                  (begin (fact 'interval-in-set 1 z) (dk-apply! (dk-cite! 'interval-card-in-nn 1 z)) (nt3-fin! (nt3-phiset z) (list 'INTERVAL 1 z))
                         (dk-have! (list 'IN (list 'EULER-PHI z) 'CC) (lambda () (mac 'EULER-PHI) (fact 'nn-in-rr (list 'CARD (nt3-phiset z))) (fact 'rr-subset-cc (list 'CARD (nt3-phiset z))) (ass)))))
              (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
        (dk-have! (list 'AND (list 'IN n 'SET) (list 'NOT (list 'IN n dv1))))
        (let ((h (dk-apply! (dk-cite! 'finsum-insert-ptwise ie-ag) dv1 n f)))
          (dk-rewrite-h! h un dv)))
      (list fn fp))
    ;; termwise on dv1 and M4
    (let ((hyp (list 'FORALL 'mi_ (list 'IMPLIES (list 'IN 'mi_ dv1) (list 'AND (list 'IN (list fn 'mi_) 'RR) (list 'AND (list 'IN (list fp 'mi_) 'RR) (list '<= (list fn 'mi_) (list fp 'mi_))))))))
      (dk-have! hyp
        (lambda ()
          (let ((i (dk-di-var!)))
            (ma-sep-parts! (list 'IN i dv1))
            (div-open! i)
            (nt3-fin! (z8-os i) '(CARR g)) (fact 'nn-in-rr (list 'CARD (z8-os i)))
            (fact 'interval-in-set 1 i) (dk-apply! (dk-cite! 'interval-card-in-nn 1 i)) (nt3-fin! (nt3-phiset i) (list 'INTERVAL 1 i))
            (dk-have! (list 'IN (list 'EULER-PHI i) 'RR) (lambda () (mac 'EULER-PHI) (fact 'nn-in-rr (list 'CARD (nt3-phiset i))) (ass)))
            (dk-apply! (dk-cite! 'order-count-le) 'g i)
            (val! fn i (list 'CARD (z8-os i))) (val! fp i (list 'EULER-PHI i))
            (subst (list '= (list fn i) (list 'CARD (z8-os i))))
            (subst (list '= (list fp i) (list 'EULER-PHI i)))
            (dk-conj-close! (lambda () (ass))))))
      (dk-split-all! (list (dk-apply! (dk-cite! 'finsum-cc-le-termwise dv1) fn fp))))
    (let* ((sn (list 'FINSUM ie-ag fn dv1)) (sp (list 'FINSUM ie-ag fp dv1)))
      (for-each (lambda (t) (fact 'rr-subset-cc t)) (list sn sp))
      (ie-op-eq! 'ADD sn nn1) (ie-op-eq! 'ADD sp pn)
      (dk-cite! 'ras-op ie-r)
      (let* ((h1 (dk-rewrite-h! (list '= n (list 'FINSUM ie-ag fn dv)) (list 'FINSUM ie-ag fn dv) (list (list 'OPR ie-ag) sn (list fn n))))
             (h1 (dk-rewrite-h! h1 (list fn n) nn1))
             (h1 (dk-rewrite-h! h1 (list 'OPR ie-ag) (list 'ADD ie-r)))
             (h1 (dk-rewrite-h! h1 (list (list 'ADD ie-r) sn nn1) (list '+ sn nn1)))
             (h2 (dk-rewrite-h! (list '= (list 'FINSUM ie-ag fp dv) n) (list 'FINSUM ie-ag fp dv) (list (list 'OPR ie-ag) sp (list fp n))))
             (h2 (dk-rewrite-h! h2 (list fp n) pn))
             (h2 (dk-rewrite-h! h2 (list 'OPR ie-ag) (list 'ADD ie-r)))
             (h2 (dk-rewrite-h! h2 (list (list 'ADD ie-r) sp pn) (list '+ sp pn))))
        #t)
      (dk-have! (list '<= 1 nn1) (lambda () (dk-ineq! (list '= n (list '+ sn nn1)) (list '= (list '+ sp pn) n) (list '<= sn sp) (list '<= 1 pn)
                                                     (list 'IN sn 'RR) (list 'IN sp 'RR) (list 'IN nn1 'RR) (list 'IN pn 'RR) (list 'IN n 'RR)))))
    ;; so some x has order n, and it generates g
    (let ((ex (list 'FORSOME 'ox_ (list 'IN 'ox_ (z8-os n)))))
      (use-em ex
        (lambda ()
          (let ((x (dk-skolem! (dk-ctx-form ex) #t)))
            (ma-sep-parts! (list 'IN x (z8-os n)))
            (dk-apply! (dk-cite! 'order-card-generator) 'g x)
            (ew x) (ass)))
        (lambda ()
          (z9-os-empty! n)
          (z2-absurd! (list '<= 1 nn1) (list '= nn1 0)))))))
(qed 'finite-group-cyclic-criterion)

