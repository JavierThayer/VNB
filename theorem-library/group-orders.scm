(define z6-n2 '(CARD (CARR gb)))
(define (z7-z g x k) (list 'GROUP-ZPOW g x k))
(define (z7-bez-close! km1 c)
  ;; goal (= (+ (* m k) (* (- 0 c) n)) 1) with km1 = n c, km1 = k m - 1 in context
  (let* ((g (dk-goal)) (lhs (cadr g)))
    (dk-have! (list '= km1 (list '* 'n c)) (lambda () (ass)))
    (dk-have! (list '= lhs (list '+ (list '- km1 (list '* 'n c)) 1)) (lambda () (crs)))
    (subst (list '= lhs (list '+ (list '- km1 (list '* 'n c)) 1)))
    (subst (list '= km1 (list '* 'n c)))
    (crs)))
(define (z7-gen-stmt body) (z2-gx (list 'FORALL 'n (list 'IMPLIES '(IS-ELEMENT-ORDER g x n) (list 'IMPLIES '(IS-GENERATOR g x) body)))))
(define (z7-res k d) (list 'FORSOME 'gpr_ (list 'AND '(IN gpr_ NN) (list 'AND '(<= 1 gpr_) (list 'AND (list '<= 'gpr_ d) (list '= (z2-z k) '(GPOW g x gpr_)))))))
(define z7-gs '(SEP gny_ (CARR g) (IS-GENERATOR g gny_)))

;;; ==================================================================== from n10.scm
;;; (56) ALGEBRAIC-NUMBERS: the card of a disjoint finite family, Gauss's identity sum_{d | n} phi(d) = n.
;;; Helper prefix n10-.
(define (n10-bu s) (list 'BIG-UNION 'fu_ s '(af fu_)))
(define n10-f '(VNB-LAMBDA fc_ ii (CARD (af fc_))))
(define (n10-sum s) (list 'FINSUM ie-ag n10-f s))
(define n10-fin '(FORALL fi_ (IMPLIES (IN fi_ ii) (AND (IN (af fi_) SET) (IN (CARD (af fi_)) NN)))))
(define n10-disj '(FORALL fa_ (IMPLIES (IN fa_ ii) (FORALL fb_ (IMPLIES (IN fb_ ii) (FORALL fw_ (IMPLIES (IN fw_ (af fa_)) (IMPLIES (IN fw_ (af fb_)) (= fa_ fb_)))))))))
(define (n10-sub s) (list 'FORALL 'fz_ (list 'IMPLIES (list 'IN 'fz_ s) '(IN fz_ ii))))
(define (n10-prop s) (list 'IMPLIES (n10-sub s) (list 'AND (list 'IN (n10-bu s) 'SET) (list 'AND (list 'IN (list 'CARD (n10-bu s)) 'NN) (list '= (list 'CARD (n10-bu s)) (n10-sum s))))))
(define (n10-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
;;; i in ii: the facts about af(i) and f(i)
(define (n10-at! i)
  (dk-split-all! (list (dk-apply! (dk-ctx-form n10-fin) i)))
  (fact 'nn-in-rr (list 'CARD (list 'af i))) (fact 'rr-subset-cc (list 'CARD (list 'af i)))
  (dk-have! (list '= (list n10-f i) (list 'CARD (list 'af i))) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))

(sp (make-wff (list 'FORALL 'ii (list 'IMPLIES '(IN ii SET) (list 'IMPLIES '(IN (CARD ii) NN) (list 'FORALL 'af (list 'IMPLIES n10-fin (list 'IMPLIES n10-disj
  (list '= (list 'CARD (n10-bu 'ii)) (n10-sum 'ii))))))))))
(dk-peel!)
(ie-ring!)
(fact 'empty-set-is-set) (fact 'card-empty)
(dk-cite! 'ras-id ie-r)
(dk-have! (list '= (list 'ZERO ie-r) 0) (lambda () (mac 'cc-scalar-ring-zero) (n10-rfl!)))
(let ((res (ma-induct! 'ii n10-prop
             (lambda ()
               (di)
               (let ((b0 (n10-bu 'EMPTY-SET)))
                 (ma-ext2! b0 'EMPTY-SET
                   (lambda (w) (let ((ia (ma-bu-open! w b0))) (fact 'empty-set-has-no-members (car ia)) (ma-prop-with! (list (list 'IN (car ia) 'EMPTY-SET) (list 'NOT (list 'IN (car ia) 'EMPTY-SET))))))
                   (lambda (w) (fact 'empty-set-has-no-members w) (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
                 (dk-cite! 'finsum-empty ie-ag n10-f)
                 (fact 'nn-zero-in)
                 (dk-conj-close!
                   (lambda ()
                     (subst (list '= b0 'EMPTY-SET))
                     (if (dk-contains? (dk-goal) '(CARD EMPTY-SET)) (subst '(= (CARD EMPTY-SET) 0)))
                     (if (not (dk-ass!))
                         (begin (subst (list '== (n10-sum 'EMPTY-SET) (list 'IDEN ie-ag)))
                                (subst (list '= (list 'IDEN ie-ag) (list 'ZERO ie-r)))
                                (subst (list '= (list 'ZERO ie-r) 0))
                                (n10-rfl!)))))))
             (lambda (sv xv u ih)
               (di)
               (let* ((pr (list 'PAIR xv xv)) (bs (n10-bu sv)) (bu (n10-bu u)) (ax (list 'af xv)) (cs (list 'CARD bs)) (ca (list 'CARD ax)))
                 (ma-in-singleton! xv) (ma-in-union-right! xv sv pr)
                 (dk-have! (n10-sub sv) (lambda () (let ((z (dk-di-var!))) (ma-in-union-left! z sv pr) (dk-apply! (dk-ctx-form (n10-sub u)) z) (ass))))
                 (dk-split-all! (list (dk-apply! (dk-ctx-form ih))))
                 (dk-apply! (dk-ctx-form (n10-sub u)) xv)
                 (n10-at! xv)
                 ;; BU(u) = BU(sv) u af(xv)
                 (ma-ext2! bu (list 'UNION bs ax)
                   (lambda (w)
                     (let* ((ia (ma-bu-open! w bu)) (i (car ia)))
                       (ie-or-split! i sv pr
                         (lambda () (dk-have! (list 'IN w bs) (lambda () (ma-bu-close! i))) (ma-in-union-left! w bs ax) (ass))
                         (lambda () (ma-singleton-eq! i xv) (dk-rewrite-h! (list 'IN w (list 'af i)) i xv) (ma-in-union-right! w bs ax) (ass)))))
                   (lambda (w)
                     (ie-or-split! w bs ax
                       (lambda () (let* ((ia (ma-bu-open! w bs)) (i (car ia))) (ma-in-union-left! i sv pr) (ma-bu-close! i)))
                       (lambda () (ma-bu-close! xv)))))
                 ;; disjoint
                 (ma-ext2! (list 'INTERSECTION bs ax) 'EMPTY-SET
                   (lambda (w)
                     (ma-iff-parts! (dk-cite! 'intersection-membership bs ax w))
                     (let* ((ia (ma-bu-open! w bs)) (i (car ia)))
                       (ma-in-union-left! i sv pr)
                       (dk-apply! (dk-ctx-form (n10-sub u)) i)
                       (dk-apply! (dk-ctx-form n10-disj) i xv w)
                       (dk-rewrite-h! (list 'IN i sv) i xv)
                       (ma-prop-with! (list (list 'IN xv sv) (list 'NOT (list 'IN xv sv))))))
                   (lambda (w) (fact 'empty-set-has-no-members w) (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
                 (dk-have! (list 'AND (list 'IN bs 'SET) (list 'IN cs 'NN)))
                 (dk-have! (list 'AND (list 'IN ax 'SET) (list 'AND (list 'IN ca 'NN) (list '= (list 'INTERSECTION bs ax) 'EMPTY-SET))))
                 (fact 'card-union-disjoint bs ax)
                 (dk-have! (list 'AND (list 'IN bs 'SET) (list 'IN ax 'SET))) (fact 'union-set-closure bs ax)
                 (dk-have! (list 'AND (list 'IN cs 'NN) (list 'IN ca 'NN))) (fact 'nn-add-closed cs ca)
                 ;; the sum over u
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list n10-f 'z_) (list 'CARR ie-ag))))
                   (lambda () (let ((z (dk-di-var!))) (dk-apply! (dk-ctx-form (n10-sub u)) z) (n10-at! z)
                                (subst (list '= (list 'CARR ie-ag) 'CC)) (subst (list '= (list n10-f z) (list 'CARD (list 'af z)))) (ass))))
                 (dk-apply! (dk-cite! 'finsum-insert-ptwise ie-ag) sv xv n10-f)
                 (fact 'nn-in-rr cs) (fact 'rr-subset-cc cs)
                 (dk-have! (list 'IN (n10-sum sv) 'CC) (lambda () (subst (list '= (n10-sum sv) cs)) (ass)))
                 (ie-op-eq! 'ADD (n10-sum sv) ca)
                 (dk-cite! 'ras-op ie-r)
                 (dk-conj-close!
                   (lambda ()
                     (subst (list '= bu (list 'UNION bs ax)))
                     (if (dk-contains? (dk-goal) (list 'CARD (list 'UNION bs ax))) (subst (list '= (list 'CARD (list 'UNION bs ax)) (list '+ cs ca))))
                     (if (not (dk-ass!))
                         (begin
                           (subst (list '= (n10-sum u) (list (list 'OPR ie-ag) (n10-sum sv) (list n10-f xv))))
                           (subst (list '= (list n10-f xv) ca))
                           (subst (list '= (list 'OPR ie-ag) (list 'ADD ie-r)))
                           (subst (list '= (list (list 'ADD ie-r) (n10-sum sv) ca) (list '+ (n10-sum sv) ca)))
                           (subst (list '= (n10-sum sv) cs))
                           (n10-rfl!))))))))))
  (dk-have! (n10-sub 'ii) (lambda () (let ((z (dk-di-var!))) (ass))))
  (dk-split-all! (list (dk-apply! (dk-ctx-form res))))
  (ass))
(qed 'card-disjoint-family)

;;; ---- gcd: a positive gcd exists, it is unique, and gcd(c j, c e) = c iff j, e are coprime ----
;;; c, a, b in RR, c /= 0, (= (* c a) (* c b)) in context: land (= a b)
(define (n10-cancel! c a b)
  (dk-have! (list '= a b)
    (lambda ()
      (dk-type! (list '- a b) 'RR)
      (dk-have! (list '= (list '* c (list '- a b)) 0)
        (lambda () (dk-have! (list '= (list '* c (list '- a b)) (list '- (list '* c a) (list '* c b))) (lambda () (crs)))
                   (subst (list '= (list '* c (list '- a b)) (list '- (list '* c a) (list '* c b))))
                   (subst (list '= (list '* c a) (list '* c b))) (crs)))
      (ma-or-split! (dk-apply! (dk-cite! 'rr-no-zero-divisors c (list '- a b)))
        (list (lambda () (ma-prop-with! (list (list '= c 0) (list 'NOT (list '= c 0)))))
              (lambda ()
                (dk-have! (list '= 0 (list '- a b)) (lambda () (subst (list '= (list '- a b) 0)) (rfl)))
                (dk-apply! (dk-cite! 'rr-diff-zero-eq a b))
                (ass)))))))
(define (n10-nz! x lo) (dk-have! (list 'NOT (list '= x 0)) (lambda () (di) (z2-absurd! (list '= x 0) (list lo 1 x)))))

;;; a positive gcd exists (b /= 0)
(sp (make-wff (forall-guarded '(a b) '((IN a ZZ) (IN b ZZ) (NOT (= b 0)))
  '(FORSOME gcg_ (AND (IN gcg_ NN) (AND (<= 1 gcg_) (ZZ-IS-GCD a b gcg_)))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'rr-zero-in)
(let* ((d (dk-skolem! (dk-apply! (dk-cite! 'zz-bezout) 'a 'b) #t)))
  (ma-iff-parts! (dk-cite! 'zz-bezout-set-membership 'a 'b d))
  (let* ((x (dk-skolem! (dk-ctx-form (list 'FORSOME 'x_ (list 'AND '(IN x_ ZZ) (list 'FORSOME 'y_ (list 'AND '(IN y_ ZZ) (list '= d '(+ (* x_ a) (* y_ b)))))))) #t))
         (y (dk-skolem! (dk-ctx-form (list 'FORSOME 'y_ (list 'AND '(IN y_ ZZ) (list '= d (list '+ (list '* x 'a) '(* y_ b)))))) #t))
         (alldiv (lambda (dd)
                   ;; every common divisor of a and b divides dd, where dd = d or (- d)
                   (dk-have! (forall-guarded '(e_) '((IN e_ ZZ) (ZZ-DIVIDES e_ a) (ZZ-DIVIDES e_ b)) (list 'ZZ-DIVIDES 'e_ dd))
                     (lambda ()
                       (let ((e (begin (dk-peel!) (cadr (dk-goal)))))
                         (dk-apply! (dk-cite! 'zz-divides-lincomb) e 'a 'b x y)
                         (dk-rewrite-h! (list 'ZZ-DIVIDES e (list '+ (list '* x 'a) (list '* y 'b))) (list '+ (list '* x 'a) (list '* y 'b)) d)
                         (if (equal? dd d) (ass)
                             (let ((c (z3-dv! e d)))
                               (dk-type! (list '- 0 c) 'ZZ) (dk-type! (list '- 0 d) 'ZZ)
                               (dk-have! (list '= (list '- 0 d) (list '* e (list '- 0 c))) (lambda () (subst (list '= d (list '* e c))) (crs)))
                               (z3-div-intro! (list '- 0 c))))))))))
    (dk-have! (list 'NOT (list '= d 0))
      (lambda () (di) (let ((c (z3-dv! d 'b))) (dk-have! '(= b 0) (lambda () (subst (list '= 'b (list '* d c))) (subst (list '= d 0)) (crs)))
                        (ma-prop-with! (list '(= b 0) '(NOT (= b 0)))))))
    (fact 'zz-in-rr d)
    (dk-have! (list 'AND (list 'IN d 'RR) '(IN 0 RR)))
    (fact 'rr-leq-total d 0)
    (let ((neg! (lambda (g)
                  ;; g = -d: g | a, g | b
                  (dk-have! (list 'ZZ-IS-GCD 'a 'b g)
                    (lambda ()
                      (mac 'zz-is-gcd)
                      (dk-conj-close!
                        (lambda ()
                          (let ((h (dk-goal)))
                            (cond ((dk-ass!) #t)
                                  ((dk-head-is? h 'ZZ-DIVIDES)
                                   (let* ((t (caddr h)) (c (z3-dv! d t)))
                                     (dk-type! (list '- 0 c) 'ZZ)
                                     (dk-have! (list '= t (list '* g (list '- 0 c))) (lambda () (subst (list '= t (list '* d c))) (crs)))
                                     (z3-div-intro! (list '- 0 c))))
                                  (#t (alldiv g)))))))))))
      (ma-or-split! (list 'OR (list '<= d 0) (list '<= 0 d))
        (list (lambda ()
                (let ((g (list '- 0 d)))
                  (dk-type! g 'ZZ) (dk-type! g 'RR)
                  (dk-have! (list '< 0 g) (lambda () (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases d 0))
                                                         (list (lambda () (dk-ineq! (list '< d 0))) (lambda () (ma-prop-with! (list (list '= d 0) (list 'NOT (list '= d 0)))))))))
                  (dk-apply! (dk-cite! 'zz-discrete) g)
                  (dk-have! (list '<= 0 g) (lambda () (dk-ineq! (list '< 0 g))))
                  (dk-apply! (dk-cite! 'zz-nonneg-in-nn) g)
                  (neg! g)
                  (ew g) (dk-conj-close! (lambda () (ass)))))
              (lambda ()
                (dk-have! (list '< 0 d) (lambda () (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 d))
                                                     (list (lambda () (ass)) (lambda () (dk-have! (list '= d 0) (lambda () (subst (list '= d 0)) (rfl)))
                                                                                         (ma-prop-with! (list (list '= d 0) (list 'NOT (list '= d 0)))))))))
                (dk-apply! (dk-cite! 'zz-discrete) d)
                (dk-apply! (dk-cite! 'zz-nonneg-in-nn) d)
                (dk-have! (list 'ZZ-IS-GCD 'a 'b d)
                  (lambda () (mac 'zz-is-gcd) (dk-conj-close! (lambda () (if (not (dk-ass!)) (alldiv d))))))
                (ew d) (dk-conj-close! (lambda () (ass)))))))))
(qed 'zz-gcd-pos-exists)

;;; a positive divisor of a positive integer is at most it
(sp (make-wff (forall-guarded '(g h) '((IN g ZZ) (IN h ZZ) (<= 1 g) (<= 1 h) (ZZ-DIVIDES g h)) '(<= g h))))
(dk-peel!)
(fact 'zz-in-rr 'g) (fact 'zz-in-rr 'h) (fact 'zz-zero-in)
(dk-have! '(< 0 g) (lambda () (dk-ineq! '(<= 1 g))))
(let ((c (z3-dv! 'g 'h)))
  (z6-cofactor-pos! 'g c 'h)
  (dk-have! '(<= 0 g) (lambda () (dk-ineq! '(<= 1 g))))
  (dk-apply! (dk-cite! 'rr-mul-le-right 1 c 'g))
  (dk-type! (list '* c 'g) 'RR) (dk-type! (list '* 1 'g) 'RR)
  (dk-have! (list '= (list '* c 'g) 'h) (lambda () (subst (list '= 'h (list '* 'g c))) (crs)))
  (dk-ineq! (list '<= (list '* 1 'g) (list '* c 'g)) (list '= (list '* c 'g) 'h) (list 'IN (list '* c 'g) 'RR) (list 'IN (list '* 1 'g) 'RR)))
(qed 'zz-divides-le-pos)

;;; the positive gcd is unique
(define (n10-gcd3 a b g) (forall-guarded '(e_) (list '(IN e_ ZZ) (list 'ZZ-DIVIDES 'e_ a) (list 'ZZ-DIVIDES 'e_ b)) (list 'ZZ-DIVIDES 'e_ g)))
(sp (make-wff (forall-guarded '(a b g h) '((IN g ZZ) (IN h ZZ) (<= 1 g) (<= 1 h) (ZZ-IS-GCD a b g) (ZZ-IS-GCD a b h)) '(= g h))))
(dk-peel!)
(z2-open! 'zz-is-gcd '(a b g) '(ZZ-IS-GCD a b g))
(z2-open! 'zz-is-gcd '(a b h) '(ZZ-IS-GCD a b h))
(dk-apply! (dk-ctx-form (n10-gcd3 'a 'b 'h)) 'g)
(dk-apply! (dk-ctx-form (n10-gcd3 'a 'b 'g)) 'h)
(dk-apply! (dk-cite! 'zz-divides-le-pos) 'g 'h)
(dk-apply! (dk-cite! 'zz-divides-le-pos) 'h 'g)
(fact 'zz-in-rr 'g) (fact 'zz-in-rr 'h)
(dk-have! '(AND (IN g RR) (IN h RR)))
(dk-have! '(AND (<= g h) (<= h g)))
(fact 'rr-leq-antisymmetric 'g 'h)
(ass)
(qed 'zz-gcd-pos-unique)

;;; gcd(c j, c e) = c iff j and e are coprime (c >= 1)
(sp (make-wff (forall-guarded '(c j e) '((IN c ZZ) (IN j ZZ) (IN e ZZ) (<= 1 c))
  '(IFF (ZZ-IS-GCD (* c j) (* c e) c) (ZZ-COPRIME j e)))))
(dk-peel!)
(fact 'zz-one-in) (fact 'zz-zero-in) (fact 'zz-in-rr 'c)
(dk-type! '(* c j) 'ZZ) (dk-type! '(* c e) 'ZZ)
(n10-nz! 'c '<=)
(dk-iff! (lambda (g) (dk-head-is? g 'ZZ-COPRIME))
  (lambda ()
    (z2-open! 'zz-is-gcd '((* c j) (* c e) c) '(ZZ-IS-GCD (* c j) (* c e) c))
    (z2-close! 'zz-coprime '(j e)
      (lambda ()
        (z2-close! 'zz-is-gcd '(j e 1)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((h (dk-goal)))
                  (cond ((dk-ass!) #t)
                        ((dk-head-is? h 'ZZ-DIVIDES)
                         (let ((t (caddr h)))
                           (dk-have! (list '= t (list '* 1 t)) (lambda () (crs)))
                           (z3-div-intro! t)))
                        (#t
                         (let* ((t (begin (dk-peel!) (cadr (dk-goal))))
                                (s1 (z3-dv! t 'j)) (s2 (z3-dv! t 'e)) (ct (list '* 'c t)))
                           (dk-type! ct 'ZZ)
                           (dk-have! (list 'ZZ-DIVIDES ct '(* c j)) (lambda () (dk-have! (list '= '(* c j) (list '* ct s1)) (lambda () (subst (list '= 'j (list '* t s1))) (crs))) (z3-div-intro! s1)))
                           (dk-have! (list 'ZZ-DIVIDES ct '(* c e)) (lambda () (dk-have! (list '= '(* c e) (list '* ct s2)) (lambda () (subst (list '= 'e (list '* t s2))) (crs))) (z3-div-intro! s2)))
                           (dk-apply! (dk-ctx-form (n10-gcd3 '(* c j) '(* c e) 'c)) ct)
                           (let ((w (z3-dv! ct 'c)))
                             (dk-type! (list '* t w) 'ZZ) (fact 'zz-in-rr (list '* t w)) (fact 'rr-one-in)
                             (dk-have! (list '= (list '* 'c (list '* t w)) (list '* 'c 1)) (lambda () (dk-have! (list '= (list '* 'c (list '* t w)) (list '* ct w)) (lambda () (crs)))
                                                                                                   (subst (list '= (list '* 'c (list '* t w)) (list '* ct w))) (subst (list '= (list '* ct w) 'c)) (crs)))
                             (n10-cancel! 'c (list '* t w) 1)
                             (dk-have! (list '= 1 (list '* t w)) (lambda () (subst (list '= (list '* t w) 1)) (rfl)))
                             (z3-div-intro! w)))))))))))))
  (lambda ()
    (let* ((uv (nt2-bez-open! 'j 'e)) (u (car uv)) (v (cadr uv)))
      (z2-close! 'zz-is-gcd '((* c j) (* c e) c)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((h (dk-goal)))
                (cond ((dk-ass!) #t)
                      ((dk-head-is? h 'ZZ-DIVIDES)
                       (let ((x (caddr h)))
                         (dk-have! (list '= x x) (lambda () (rfl)))
                         (z3-div-intro! (caddr x))))
                      (#t
                       (let ((t (begin (dk-peel!) (cadr (dk-goal)))))
                         (dk-apply! (dk-cite! 'zz-divides-lincomb) t '(* c j) '(* c e) u v)
                         (dk-have! (list '= (list '+ (list '* u '(* c j)) (list '* v '(* c e))) 'c)
                           (lambda () (dk-have! (list '= (list '+ (list '* u '(* c j)) (list '* v '(* c e))) (list '* 'c (list '+ (list '* u 'j) (list '* v 'e)))) (lambda () (crs)))
                                      (subst (list '= (list '+ (list '* u '(* c j)) (list '* v '(* c e))) (list '* 'c (list '+ (list '* u 'j) (list '* v 'e)))))
                                      (subst (list '= (list '+ (list '* u 'j) (list '* v 'e)) 1)) (crs)))
                         (dk-rewrite-h! (list 'ZZ-DIVIDES t (list '+ (list '* u '(* c j)) (list '* v '(* c e)))) (list '+ (list '* u '(* c j)) (list '* v '(* c e))) 'c)
                         (ass))))))))))))
(qed 'zz-gcd-scale)

;;; ---- Gauss's identity ----
(define (n10-div n) (list 'SEP 'gd_ (list 'INTERVAL 1 n) (list 'ZZ-DIVIDES 'gd_ n)))
(define (n10-as n d) (list 'SEP 'gk_ (list 'INTERVAL 1 n)
  (list 'FORSOME 'gg_ (list 'AND '(IN gg_ NN) (list 'AND '(<= 1 gg_) (list 'AND (list 'ZZ-IS-GCD 'gk_ n 'gg_) (list '= (list '* 'gg_ d) n)))))))
(define (n10-asw k n d) (list 'FORSOME 'gg_ (list 'AND '(IN gg_ NN) (list 'AND '(<= 1 gg_) (list 'AND (list 'ZZ-IS-GCD k n 'gg_) (list '= (list '* 'gg_ d) n))))))
;;; x in ZZ, 1 <= x <= m (m in NN) gives x in INTERVAL 1 m
(define (n10-in-iv! x m) (dk-have! (list 'IN x 'NN) (lambda () (dk-have! (list '<= 0 x) (lambda () (dk-ineq! (list '<= 1 x)))) (dk-apply! (dk-cite! 'zz-nonneg-in-nn) x) (ass)))
  (ma-iff-back! (dk-cite! 'interval-membership 1 m x)))
;;; an element of AS(n, d): land k in 1..n, its gcd g >= 1 and g d = n; returns g
(define (n10-as-open! k n d)
  (ma-sep-parts! (list 'IN k (n10-as n d)))
  (ma-iff-parts! (dk-cite! 'interval-membership 1 n k))
  (dk-skolem! (dk-ctx-form (n10-asw k n d)) #t))

;;; L1: card AS(n, d) = phi(d)
(sp (make-wff (forall-guarded '(n d) '((IN n NN) (IN d NN) (<= 1 n) (<= 1 d) (ZZ-DIVIDES d n)) (list '= (list 'CARD (n10-as 'n 'd)) '(EULER-PHI d)))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in)
(dk-type! 'n 'ZZ) (dk-type! 'd 'ZZ) (fact 'nn-in-rr 'n) (fact 'nn-in-rr 'd)
(dk-have! '(< 0 d) (lambda () (dk-ineq! '(<= 1 d))))
(n10-nz! 'd '<=)
(let* ((c (z3-dv! 'd 'n)) (ph (nt3-phiset 'd)) (as (n10-as 'n 'd)) (psi (list 'VNB-LAMBDA 'gj_ ph (list '* 'gj_ c))) (im (list 'IMAGE psi ph)))
  (z6-cofactor-pos! 'd c 'n)
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 1 c))))
  (dk-apply! (dk-cite! 'zz-nonneg-in-nn) c)
  (dk-have! (list '< 0 c) (lambda () (dk-ineq! (list '<= 1 c))))
  (n10-nz! c '<=)
  (dk-have! (list '= (list '* c 'd) 'n) (lambda () (subst (list '= 'n (list '* 'd c))) (crs)))
  (fact 'interval-in-set 1 'd) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'd))
  (fact 'interval-in-set 1 'n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  (nt3-fin! ph '(INTERVAL 1 d))
  (nt3-fin! as '(INTERVAL 1 n))
  (let ((ph-open! (lambda (j) (ma-sep-parts! (list 'IN j ph)) (ma-iff-parts! (dk-cite! 'interval-membership 1 'd j)) (dk-type! j 'ZZ) (fact 'nn-in-rr j)))
        (val! (lambda (j) (dk-have! (list '= (list psi j) (list '* j c)) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))
    ;; psi maps the numbers prime to d into AS
    (let ((into! (lambda (j)
                   (let ((jc (list '* j c)))
                     (dk-type! jc 'ZZ) (dk-type! jc 'RR)
                     (dk-have! (list '<= 0 j) (lambda () (dk-ineq! (list '<= 1 j))))
                     (dk-apply! (dk-cite! 'rr-mul-le-right 1 j c))
                     (dk-apply! (dk-cite! 'rr-mul-le-right j 'd c))
                     (dk-type! (list '* 1 c) 'RR) (dk-type! (list '* 'd c) 'RR)
                     (dk-have! (list '<= 1 jc) (lambda () (dk-ineq! (list '<= (list '* 1 c) jc) (list '<= 1 c) (list 'IN (list '* 1 c) 'RR) (list 'IN jc 'RR))))
                     (dk-have! (list '<= jc 'n) (lambda () (dk-ineq! (list '<= jc (list '* 'd c)) (list '= 'n (list '* 'd c)) (list 'IN jc 'RR) (list 'IN (list '* 'd c) 'RR))))
                     (n10-in-iv! jc 'n)
                     (ma-iff-back! (dk-cite! 'zz-gcd-scale c j 'd))
                     (dk-have! (list '= (list '* c j) jc) (lambda () (crs)))
                     (dk-have! (list 'ZZ-IS-GCD jc 'n c)
                       (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (list 'ZZ-IS-GCD (list '* c j) (list '* c 'd) c) (list '* c j) jc) (list '* c 'd) 'n))) (ass))))
                     (dk-have! (list 'IN jc as)
                       (lambda () (in-sep! dk-ass! (lambda () (ew c) (dk-conj-close! (lambda () (ass)))))))
                     jc))))
      (dk-have! (list 'IN psi (list 'FUN ph as))
        (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (ph-open! j) (into! j) (ass))) (lambda () (dk-ass!)))))
      (let ((inj (dk-cite! 'injection-membership-iff ph as psi)))
        (dk-have! (caddr (caddr inj))
          (lambda ()
            (let* ((ab (begin (dk-peel!) (dk-goal))) (a (cadr ab)) (b (caddr ab)))
              (ph-open! a) (ph-open! b) (val! a) (val! b)
              (dk-have! (list '= (list '* c a) (list '* c b))
                (lambda () (dk-have! (list '= (list '* c a) (list psi a)) (lambda () (subst (list '= (list psi a) (list '* a c))) (crs)))
                           (subst (list '= (list '* c a) (list psi a))) (subst (list '= (list psi a) (list psi b))) (subst (list '= (list psi b) (list '* b c))) (crs)))
              (fact 'zz-in-rr c)
              (n10-cancel! c a b))))
        (ma-iff-back! inj))
      (fact 'image-set psi ph)
      (dk-apply! (dk-cite! 'image-subset-codomain ph as psi))
      (ma-ext2! im as
        (lambda (w) (dk-apply! (dk-ctx-form (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w im) (list 'IN 'w as)))) w) (ass))
        (lambda (k)
          (let* ((g (n10-as-open! k 'n 'd)))
            (dk-type! k 'ZZ) (dk-type! g 'ZZ) (fact 'nn-in-rr k) (fact 'zz-in-rr g)
            ;; g = c
            (dk-have! (list '= (list '* 'd g) (list '* 'd c)) (lambda () (dk-have! (list '= (list '* 'd g) (list '* g 'd)) (lambda () (crs)))
                                                                   (subst (list '= (list '* 'd g) (list '* g 'd))) (subst (list '= (list '* g 'd) 'n)) (subst (list '= 'n (list '* 'd c))) (crs)))
            (fact 'zz-in-rr c)
            (n10-cancel! 'd g c)
            (z2-open! 'zz-is-gcd (list k 'n g) (list 'ZZ-IS-GCD k 'n g))
            (let ((j (z3-dv! g k)))
              (dk-type! j 'ZZ) (fact 'zz-in-rr j)
              (dk-have! (list '= k (list '* c j)) (lambda () (subst (list '= k (list '* g j))) (subst (list '= g c)) (crs)))
              (dk-have! (list 'ZZ-IS-GCD (list '* c j) (list '* c 'd) c)
                (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list 'ZZ-IS-GCD k 'n g) k (list '* c j)) 'n (list '* c 'd)) g c))) (ass))))
              (ma-iff-parts! (dk-cite! 'zz-gcd-scale c j 'd))
              (z6-cofactor-pos! c j k)
              (dk-have! (list '<= j 'd)
                (lambda ()
                  (dk-type! (list '* j c) 'RR) (dk-type! (list '* 'd c) 'RR)
                  (dk-have! (list '<= (list '* j c) (list '* 'd c)) (lambda () (dk-have! (list '= (list '* j c) k) (lambda () (subst (list '= k (list '* c j))) (crs)))
                                                                         (dk-ineq! (list '<= k 'n) (list '= (list '* j c) k) (list '= 'n (list '* 'd c)) (list 'IN (list '* j c) 'RR) (list 'IN (list '* 'd c) 'RR))))
                  (dk-apply! (dk-cite! 'rr-mul-le-cancel-pos) j c 'd)
                  (ass)))
              (n10-in-iv! j 'd)
              (dk-have! (list 'IN j ph) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
              (val! j)
              (fact 'membership-implies-sethood k 'NN)
              (let* ((iff (dk-cite! 'image-membership-iff psi ph k)) (fs (caddr (caddr iff))))
                (dk-have! fs (lambda () (ew j) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= (list psi j) (list '* j c))) (subst (list '= k (list '* c j))) (crs)))))))
                (ma-iff-back! iff)))))))
    (dk-have! (list 'AND (list 'IN psi (list 'INJECTION ph as)) (list 'AND (list 'IN ph 'SET) (list 'IN (list 'CARD ph) 'NN))) (lambda () (dk-conj-close! (lambda () (ass)))))
    (fact 'card-image-injection ph as psi)
    (mac 'EULER-PHI)
    (subst (list '= as im))
    (subst (list '= (list 'CARD im) (list 'CARD ph)))
    (n10-rfl!)))
(qed 'gauss-class-card)

;;; GAUSS: sum_{d | n} phi(d) = n
(sp (make-wff (forall-guarded '(n) '((IN n NN) (<= 1 n))
  (list '= (list 'FINSUM ie-ag (list 'VNB-LAMBDA 'gpd_ (n10-div 'n) '(EULER-PHI gpd_)) (n10-div 'n)) 'n))))
(dk-peel!)
(ie-ring!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in)
(dk-type! 'n 'ZZ) (fact 'nn-in-rr 'n)
(n10-nz! 'n '<=)
(let* ((dv (n10-div 'n)) (iv '(INTERVAL 1 n))
       (aa (list 'VNB-LAMBDA 'ga_ dv (n10-as 'n 'ga_)))
       (sb (lambda (f) (subst-free* (list (cons 'af aa) (cons 'ii dv)) f)))
       (fin (sb n10-fin)) (disj (sb n10-disj))
       (bu (list 'BIG-UNION 'fu_ dv (list aa 'fu_)))
       (f1 (list 'VNB-LAMBDA 'fc_ dv (list 'CARD (list aa 'fc_))))
       (f2 (list 'VNB-LAMBDA 'gpd_ dv '(EULER-PHI gpd_)))
       (div-open! (lambda (i) (ma-sep-parts! (list 'IN i dv)) (ma-iff-parts! (dk-cite! 'interval-membership 1 'n i)) (dk-type! i 'ZZ) (fact 'zz-in-rr i)))
       (aval! (lambda (i) (dk-have! (list '= (list aa i) (n10-as 'n i)) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))
  (fact 'interval-in-set 1 'n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  (nt3-fin! dv iv)
  (dk-have! fin
    (lambda ()
      (let ((i (dk-di-var!)))
        (div-open! i) (aval! i)
        (nt3-fin! (n10-as 'n i) iv)
        (subst (list '= (list aa i) (n10-as 'n i)))
        (dk-conj-close! (lambda () (ass))))))
  (dk-have! disj
    (lambda ()
      (let* ((ijw (begin (dk-peel!) (dk-goal))) (i (cadr ijw)) (j (caddr ijw))
             (w (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list aa i)))) (dk-asms)))))
        (div-open! i) (div-open! j) (aval! i) (aval! j)
        (dk-rewrite-h! (list 'IN w (list aa i)) (list aa i) (n10-as 'n i))
        (dk-rewrite-h! (list 'IN w (list aa j)) (list aa j) (n10-as 'n j))
        (let* ((g1 (n10-as-open! w 'n i)) (g2 (n10-as-open! w 'n j)))
          (dk-type! g1 'ZZ) (dk-type! g2 'ZZ) (fact 'zz-in-rr g1)
          (dk-apply! (dk-cite! 'zz-gcd-pos-unique) w 'n g1 g2)
          (dk-have! (list '= (list '* g1 i) (list '* g1 j)) (lambda () (subst (list '= (list '* g1 i) 'n)) (subst (list '= g1 g2)) (subst (list '= (list '* g2 j) 'n)) (rfl)))
          (n10-nz! g1 '<=)
          (n10-cancel! g1 i j)))))
  (dk-apply! (dk-cite! 'card-disjoint-family dv) aa)
  ;; the classes cover 1..n
  (ma-ext2! bu iv
    (lambda (w) (let* ((ia (ma-bu-open! w bu)) (i (car ia))) (div-open! i) (aval! i) (dk-rewrite-h! (list 'IN w (list aa i)) (list aa i) (n10-as 'n i))
                  (ma-sep-parts! (list 'IN w (n10-as 'n i))) (ass)))
    (lambda (k)
      (ma-iff-parts! (dk-cite! 'interval-membership 1 'n k))
      (dk-type! k 'ZZ)
      (let* ((g (dk-skolem! (dk-apply! (dk-cite! 'zz-gcd-pos-exists) k 'n) #t)))
        (dk-type! g 'ZZ) (fact 'zz-in-rr g)
        (z2-open! 'zz-is-gcd (list k 'n g) (list 'ZZ-IS-GCD k 'n g))
        (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '<= 1 g))))
        (let ((c (z3-dv! g 'n)))
          (z6-cofactor-pos! g c 'n)
          (dk-have! (list 'ZZ-DIVIDES c 'n) (lambda () (dk-have! (list '= 'n (list '* c g)) (lambda () (subst (list '= 'n (list '* g c))) (crs))) (z3-div-intro! g)))
          (dk-apply! (dk-cite! 'zz-divides-le-pos) c 'n)
          (n10-in-iv! c 'n)
          (dk-have! (list 'IN c dv) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
          (dk-have! (list '<= 0 g) (lambda () (dk-ineq! (list '<= 1 g))))
          (aval! c)
          (dk-have! (list 'IN k (list aa c))
            (lambda () (subst (list '= (list aa c) (n10-as 'n c)))
                       (in-sep! dk-ass! (lambda () (ew g) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= 'n (list '* g c))) (rfl)))))))))
          (ma-bu-close! c)))))
  ;; the summands: card A_d = phi(d)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dv) (list '= (list f1 'z) (list f2 'z))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (div-open! z)
        (dk-apply! (dk-cite! 'gauss-class-card) 'n z)
        (let ((leaf (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? leaf)) (ass))))))
  (dk-apply! (dk-cite! 'finsum-congruence-q ie-ag) dv f1 f2)
  (dk-apply! (dk-cite! 'interval-card) 'n)
  (subst (list '== (list 'FINSUM ie-ag f2 dv) (list 'FINSUM ie-ag f1 dv)))
  (subst (list '= (list 'FINSUM ie-ag f1 dv) (list 'CARD bu)))
  (subst (list '= bu iv))
  (subst (list '= (list 'CARD iv) 'n))
  (n10-rfl!))
(qed 'gauss-phi-sum)


;;; ==================================================================== from grp8.scm
;;; (57) ALGEBRAIC-NUMBERS: the subgroup of powers, ord(x) | card G (Lagrange), and the partition of a finite group by
;;; element orders: card G = sum_{d | n} #{x : ord(x) = d}.  Helper prefix z8-.
(define z8-ps '(SEP pwy_ (CARR g) (FORSOME pwk_ (AND (IN pwk_ ZZ) (= pwy_ (GROUP-ZPOW g x pwk_))))))
(define (z8-psw y) (list 'FORSOME 'pwk_ (list 'AND '(IN pwk_ ZZ) (list '= y '(GROUP-ZPOW g x pwk_)))))
;;; y = x^k (k in ZZ) gives y in PS
(define (z8-in-ps! y k)
  (dk-cite! 'zpow-type k 'g 'x)
  (dk-have! (list 'IN y z8-ps)
    (lambda () (in-sep! (lambda () (if (not (dk-ass!)) (begin (subst (list '= y (z2-z k))) (ass))))
                        (lambda () (ew k) (dk-conj-close! (lambda () (ass))))))))
;;; y in PS: return k with y = x^k
(define (z8-ps-open! y)
  (ma-sep-parts! (list 'IN y z8-ps))
  (dk-skolem! (dk-ctx-form (z8-psw y)) #t))

(sp (make-wff (z2-gx (list 'IS-SUBGROUP 'g z8-ps))))
(dk-peel!)
(fact 'group-identity-in 'g) (fact 'zz-zero-in) (fact 'nn-zero-in)
(z2-close! 'is-subgroup (list 'g z8-ps)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (let ((h (dk-goal)))
          (cond ((dk-ass!) #t)
                ((dk-head-is? h 'SUBSET) (ma-sep-subset! z8-ps) (ass))
                ((and (dk-head-is? h 'IN) (equal? (cadr h) '(IDEN g)))
                 (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x) (dk-cite! 'gpow-zero 'g 'x)
                 (dk-have! (list '= z2-e (z2-z 0)) (lambda () (subst (list '= (z2-z 0) (z2-pw 0))) (subst (list '= (z2-pw 0) z2-e)) (z2-rfl!)))
                 (z8-in-ps! z2-e 0))
                ((dk-contains? h '(INV g))
                 (let* ((a (begin (dk-peel!) (cadr (cadr (dk-goal))))) (ka (z8-ps-open! a)))
                   (dk-type! (list '- 0 ka) 'ZZ)
                   (dk-cite! 'zpow-inv ka 'g 'x)
                   (dk-have! (list '= (z2-inv a) (z2-z (list '- 0 ka))) (lambda () (subst (list '= a (z2-z ka))) (subst (list '= (z2-z (list '- 0 ka)) (z2-inv (z2-z ka)))) (z2-rfl!)))
                   (z8-in-ps! (z2-inv a) (list '- 0 ka))))
                (#t
                 (let* ((ab (begin (dk-peel!) (cadr (dk-goal)))) (a (cadr ab)) (b (caddr ab)) (ka (z8-ps-open! a)) (kb (z8-ps-open! b)))
                   (dk-type! (list '+ ka kb) 'ZZ)
                   (dk-cite! 'zpow-add ka kb 'g 'x)
                   (dk-cite! 'zpow-type ka 'g 'x) (dk-cite! 'zpow-type kb 'g 'x)
                   (dk-have! (list '= (z2-op a b) (z2-z (list '+ ka kb)))
                     (lambda () (subst (list '= a (z2-z ka))) (subst (list '= b (z2-z kb))) (subst (list '= (z2-z (list '+ ka kb)) (z2-op (z2-z ka) (z2-z kb)))) (z2-rfl!)))
                   (z8-in-ps! (z2-op a b) (list '+ ka kb))))))))))
(qed 'powers-subgroup)

;;; the powers of x of order d: d of them
(sp (make-wff (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d) (list 'AND (list 'IN z8-ps 'SET) (list '= (list 'CARD z8-ps) 'd)))))))
(dk-peel!)
(z3-ord-parts! 'd)
(fact 'group-carr-set 'g)
(fact 'subclass-of-set-is-set z8-ps '(CARR g))
(dk-have! (list 'IN z8-ps 'SET) (lambda () (ma-sep-subset! z8-ps) (fact 'subclass-of-set-is-set z8-ps '(CARR g)) (dk-ass!)))
(let* ((dd '(INTERVAL 1 d)) (phi (list 'VNB-LAMBDA 'pwj_ dd '(GPOW g x pwj_))) (im (list 'IMAGE phi dd))
       (iv-open! (lambda (k) (ma-iff-parts! (dk-cite! 'interval-membership 1 'd k)) (dk-type! k 'ZZ))))
  (fact 'interval-in-set 1 'd) (dk-apply! (dk-cite! 'interval-card) 'd) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'd))
  (dk-have! (list 'IN phi (list 'FUN dd z8-ps))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (iv-open! k) (z2-pwt! k) (dk-apply! (dk-cite! 'zpow-nat k) 'g 'x)
                                                (dk-have! (list '= (z2-pw k) (z2-z k)) (lambda () (subst (list '= (z2-z k) (z2-pw k))) (z2-rfl!)))
                                                (z8-in-ps! (z2-pw k) k) (ass)))
                             (lambda () (dk-ass!)))))
  (let ((inj (dk-cite! 'injection-membership-iff dd z8-ps phi)))
    (dk-have! (caddr (caddr inj))
      (lambda ()
        (let* ((ab (begin (dk-peel!) (dk-goal))) (a (cadr ab)) (b (caddr ab)))
          (iv-open! a) (iv-open! b) (z2-pwt! a) (z2-pwt! b) (z3-val! phi a (z2-pw a)) (z3-val! phi b (z2-pw b))
          (dk-have! (list '= (z2-pw a) (z2-pw b))
            (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list phi a) (list phi b)) (list phi a) (z2-pw a)) (list phi b) (z2-pw b)))) (ass))))
          (dk-apply! (dk-cite! 'gpow-injective-below-order) 'g 'x 'd a b)
          (ass))))
    (ma-iff-back! inj))
  (fact 'image-set phi dd)
  (dk-apply! (dk-cite! 'image-subset-codomain dd z8-ps phi))
  (ma-ext2! im z8-ps
    (lambda (w) (dk-apply! (dk-ctx-form (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w im) (list 'IN 'w z8-ps)))) w) (ass))
    (lambda (w)
      (let* ((k (z8-ps-open! w))
             (r (dk-skolem! (dk-apply! (dk-cite! 'zpow-residue) 'g 'x 'd k) #t)))
        (ma-iff-back! (dk-cite! 'interval-membership 1 'd r))
        (z2-pwt! r) (z3-val! phi r (z2-pw r))
        (fact 'membership-implies-sethood w '(CARR g))
        (let* ((iff (dk-cite! 'image-membership-iff phi dd w)) (fs (caddr (caddr iff))))
          (dk-have! fs (lambda () (ew r) (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                                   (begin (subst (list '= (list phi r) (z2-pw r))) (subst (list '= w (z2-z k))) (subst (list '= (z2-z k) (z2-pw r))) (z2-rfl!)))))))
          (ma-iff-back! iff)))))
  (dk-have! (list 'AND (list 'IN phi (list 'INJECTION dd z8-ps)) (list 'AND (list 'IN dd 'SET) (list 'IN (list 'CARD dd) 'NN))) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'card-image-injection dd z8-ps phi)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin (subst (list '= z8-ps im)) (subst (list '= (list 'CARD im) (list 'CARD dd))) (subst (list '= (list 'CARD dd) 'd)) (z2-rfl!))))))
(qed 'powers-card)

;;; ord(x) divides card G (Lagrange on the subgroup of powers)
(sp (make-wff (z2-gx (list 'IMPLIES '(IN (CARD (CARR g)) NN) (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d) '(ZZ-DIVIDES d (CARD (CARR g)))))))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-cite! 'powers-subgroup 'g 'x)
(dk-split-all! (list (dk-apply! (dk-cite! 'powers-card) 'g 'x 'd)))
(dk-apply! (dk-cite! 'lagrange) 'g z8-ps)
(let* ((q (list 'LEFT-COSETS 'g z8-ps)) (qs (gk-coss-sep 'g z8-ps)) (pw '(POWER (CARR g))) (n '(CARD (CARR g))))
  (fact 'group-carr-set 'g) (fact 'power-set '(CARR g))
  (dk-have! '(AND (IN (CARR g) SET) (IN (CARD (CARR g)) NN))) (fact 'card-power-nn '(CARR g))
  (nt3-fin! qs pw)
  (dk-cite! 'left-cosets-unfold 'g z8-ps)
  (dk-have! (list 'IN (list 'CARD q) 'NN) (lambda () (subst (list '== q qs)) (ass)))
  (dk-type! (list 'CARD q) 'ZZ) (dk-type! 'd 'ZZ) (dk-type! n 'ZZ)
  (dk-have! (list '= n (list '* 'd (list 'CARD q)))
    (lambda () (subst (list '= n (list '* (list 'CARD z8-ps) (list 'CARD q)))) (subst (list '= (list 'CARD z8-ps) 'd)) (z2-rfl!)))
  (z3-div-intro! (list 'CARD q)))
(qed 'element-order-divides-card)

;;; the order is unique
(sp (make-wff (z2-gx (forall-guarded '(d e) '((IS-ELEMENT-ORDER g x d) (IS-ELEMENT-ORDER g x e)) '(= d e)))))
(dk-peel!)
(z3-ord-parts! 'd) (z3-ord-parts! 'e)
(dk-apply! (dk-ctx-form (z3-min 'x 'd)) 'e)
(dk-apply! (dk-ctx-form (z3-min 'x 'e)) 'd)
(fact 'nn-in-rr 'd) (fact 'nn-in-rr 'e)
(dk-have! '(AND (IN d RR) (IN e RR)))
(dk-have! '(AND (<= d e) (<= e d)))
(fact 'rr-leq-antisymmetric 'd 'e)
(ass)
