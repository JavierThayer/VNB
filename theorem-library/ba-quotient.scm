;;; ba-quotient.scm -- BANACH ALGEBRAS: the quotient norm at the unit (Thayer, 1.11).
;;; For a left ideal I of a Banach algebra with unit that does not contain 1,
;;; dist(1, I) = inf { ||1 - y|| : y in I } = 1: every y in I has ||1 - y|| >= 1 (else
;;; 1 - (1 - y) = y is invertible by the Neumann series, and I contains 1:
;;; BA-1's left-ideal-near-one), and y = 0 attains ||1|| = 1.  Hence the quotient norm of
;;; the coset of 1 is 1, which is the "unital with ||1|| = 1" half of 1.11.
;;; Agent BA-1C, wave 2026-11-09.  Destination: theorem-library/ba-quotient.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: baq-.
;;; LOAD WINDOW: after structure-library/ba-quotient-vocab, theorem-library/ba-spectrum
;;; (left-ideal-near-one) and the files of einf-lower / rmc-rps-of-nonneg /
;;; rps-below-real-is-real (as ba-fekete).

(define (baq-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-quotient: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-quotient: unfinished" name))))
(define (baq-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (baq-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define baq-one '(VONE a))
(define baq-zero '(VZERO a))
(define (baq-ad x y) (list '(VADD a) x y))
(define (baq-ng x) (list '(VNEG a) x))
(define (baq-sb x y) (baq-ad x (baq-ng y)))
(define (baq-nr x) (list '(VNRM a) x))
(define (baq-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x baq-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x baq-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (baq-vt (cadr x)) (baq-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (baq-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          (#t (error "baq-vt: cannot type" (expression->string x))))))
;;; the norm of x, typed in RR, with 0 <= it
(define (baq-nt! x)
  (baq-vt x)
  (dk-cite! 'bae-vnrm-type 'a x)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a x)
  (baq-nr x))
;;; open IS-LEFT-IDEAL a ii: land i subset VEC a, 0 in ii, and the left-multiplication clause
(define (baq-ideal-open! ii)
  (let* ((lf (list 'IS-LEFT-IDEAL 'a ii))
         (body (caddr (dk-cite! 'IS-LEFT-IDEAL 'a ii)))
         (sub (dk-project! (cadr body) 'IS-LEFT-IDEAL lf))
         (sbody (caddr (dk-cite! 'IS-ALG-SUBSPACE 'a ii)))
         (ss (dk-project! (cadr sbody) 'IS-ALG-SUBSPACE sub))
         (z (dk-project! (cadr (caddr sbody)) 'IS-ALG-SUBSPACE sub)))
    (list ss z)))
;;; y in ii => y in VEC a
(define (baq-in-vec! ss y)
  (dk-have! (list 'IN y '(VEC a))
    (lambda ()
      (mac-h 'subset-def ss)
      (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(VEC a))
                                           (dk-contains? h 'ii)))
                          "the subset clause")
                 y)
      (dk-ass!))))
;;; the set ss = { ||x - y|| : y in ii } is a subset of RR-POS-STAR
(define (baq-ss-sub! ss sub x)
  (dk-have! (list 'SUBSET ss 'RR-POS-STAR)
    (lambda ()
      (mac 'subset-def)
      (let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
        (sep-me (list 'IN r ss))
        (let ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the witness"))))
          (dk-split-all!)
          (baq-in-vec! sub y)
          (let ((d (baq-nt! (baq-sb x y))))
            (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '= r d) (list '<= 0 d))))
            (dk-cite! 'rmc-rps-of-nonneg r)
            (dk-ass!)))))))

;;; ---- the unfold equation of QUOT-NORM, as a theorem (mac-h cannot name a functoid) -----
(sp (make-wff '(FORALL bqqa_ (FORALL bqqi_ (FORALL bqqx_ (== (QUOT-NORM bqqa_ bqqi_ bqqx_)
  (EINF (SEP bqqw_ RR (FORSOME bqqy_ (AND (IN bqqy_ bqqi_)
    (= bqqw_ ((VNRM bqqa_) ((VADD bqqa_) bqqx_ ((VNEG bqqa_) bqqy_))))))))))))))
(di)
(mac 'QUOT-NORM)
(qrfl)
(baq-qed! 'quot-norm-unfold)

;;; ---- every y in a left ideal without 1 has ||1 - y|| >= 1 ------------------------------
(sp (baq-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (IMPLIES (NOT (IN (VONE a) ii))
  (FORALL y (IMPLIES (IN y ii) (<= 1 ((VNRM a) ((VADD a) (VONE a) ((VNEG a) y)))))))))))
(dk-peel!)
(let* ((r (baq-ideal-open! 'ii)))
  (baq-in-vec! (car r) 'y)
  (let ((d (baq-nt! (baq-sb baq-one 'y))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (use-em (list '<= 1 d)
      (lambda () (dk-ass!))
      (lambda ()
        (dk-cite! 'rr-not-le-lt 1 d)
        (dk-cite! 'left-ideal-near-one 'a 'ii 'y)
        (keep (list 'IN baq-one 'ii) (list 'NOT (list 'IN baq-one 'ii)))
        (prop)))))
(baq-qed! 'ba-left-ideal-dist-one-ge)

;;; ---- the quotient norm is at most the norm ---------------------------------------------
(sp (baq-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL x (IMPLIES (IN x (VEC a))
  (<= (QUOT-NORM a ii x) ((VNRM a) x))))))))
(dk-peel!)
(mac 'QUOT-NORM)
(let* ((ss (cadr (cadr (dk-goal))))
       (r (baq-ideal-open! 'ii))
       (nx (baq-nt! 'x)))
  (baq-ss-sub! ss (car r) 'x)
  (dk-have! (list 'IN nx ss)
    (lambda ()
      (in-sep! (lambda () (dk-ass!))
               (lambda ()
                 (ew baq-zero)
                 (dk-conj-close!
                   (lambda ()
                     (if (not (dk-ass!))
                         (begin
                           (dk-cite! 'ring-neg-zero-uba-as-ring 'a)
                           (subst (list '= (baq-ng baq-zero) baq-zero))
                           (dk-cite! 'ring-add-right-id-uba-as-ring 'a 'x)
                           (subst (list '= (baq-ad 'x baq-zero) 'x))
                           (rfl)))))))))
  (dk-apply! (dk-cite! 'einf-lower ss) nx)
  (dk-ass!))
(baq-qed! 'quot-norm-le-norm)

;;; ---- dist(1, I) = 1 -----------------------------------------------------------------
(sp (baq-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (IMPLIES (NOT (IN (VONE a) ii))
  (= (QUOT-NORM a ii (VONE a)) 1))))))
(dk-peel!)
(baq-vt baq-one)
(let* ((le0 (dk-cite! 'quot-norm-le-norm 'a 'ii baq-one))
       (vn (dk-cite! 'bal-uba-vone-norm 'a))
       (le1 (dk-rewrite-h! le0 (baq-nr baq-one) 1)))
  (mac 'QUOT-NORM)
  (let* ((ss (cadr (cadr (dk-goal))))
         (lv (list 'EINF ss))
         (r (baq-ideal-open! 'ii)))
    (mac-h 'quot-norm-unfold le1)
    (baq-ss-sub! ss (car r) baq-one)
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rmc-rps-of-nonneg 1)
    (dk-cite! 'einf-in ss)
    (dk-cite! 'rps-below-real-is-real lv 1)
    (dk-have! (list 'FORALL 'bqz_ (list 'IMPLIES (list 'IN 'bqz_ ss) '(<= 1 bqz_)))
      (lambda ()
        (dk-peel!)
        (sep-me (list 'IN 'bqz_ ss))
        (let ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'bqz_))) "the witness"))))
          (dk-split-all!)
          (dk-cite! 'ba-left-ideal-dist-one-ge 'a 'ii y)
          (subst (list '= 'bqz_ (baq-nr (baq-sb baq-one y))))
          (dk-ass!))))
    (baq-cite2! 'einf-greatest ss 1)
    (baq-cite2! 'rr-leq-antisymmetric lv 1)
    (dk-ass!)))
(baq-qed! 'quot-norm-one)

