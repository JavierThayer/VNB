;;; isom-dense.scm -- three general facts on sequences of functions between metric
;;; spaces, the machinery of calculus.pdf Lemma 3.36 and Prop 3.37.  Agent ISOM,
;;; 2026-10-26.
;;;
;;;   equicont-dense-ptwise-limit       (Lemma 3.36, the convergence half)
;;;     t complete, fam equicontinuous from s to t, dq a dense sequence of s, and
;;;     fam(k)(dq(m)) convergent in t for every m  ==>  fam(k)(x) convergent in t
;;;     for every x in pts(s)
;;;
;;;   ptwise-limit-function
;;;     fam(k)(x) convergent for every x  ==>  some g with CONVERGES-PTWISE-TO
;;;     (g(x) is a CHOICE of a limit; the limit is unique, so nothing is chosen)
;;;
;;;   compact-diagonal-on-seq
;;;     t compact, fs a sequence of maps D -> pts(t), dq a sequence in D  ==>  a
;;;     subsequence along which fs(k)(dq(m)) converges for every m
;;;     (coordinatewise-diagonal-subseq on the constant product t^NN)
;;;
;;; WINDOW.  Citations: is-complete, is-cauchy-seq, converges, converges-to,
;;; is-dense-seq, IS-EQUICONTINUOUS (ascoli-arzela-statement), choice-axiom,
;;; coordinatewise-diagonal-subseq (rake-diagonal-subseq), product-carrier-coord,
;;; converges-to-transfer, subseq-apply, compact-implies-seq-compact,
;;; metric-* laws, the vocabulary (isom-vocab.scm).  lo = after isom-vocab.scm and
;;; rake-diagonal-subseq; hi = none.  Library: analysis.
;;;
;;; Helper prefix: idn-.

(define (idn-head g) (and (pair? g) (car g)))
(define (idn-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (prop)))
    (if (eq? (idn-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))
(define (idn-dt a b) (list '(DIST t) a b))

;;; =====================================================================
;;; equicont-dense-ptwise-limit
;;; =====================================================================
;;; SUBSEQ(f, phi) in FUN(NN, A) from f in FUN(NN, A) and phi strictly monotone, by
;;; unfolding (subseq-fun-typing, ca6-hurwitz.scm, sits in the complex-analysis library)
(define (idn-subseq-type! f phi A)
  (let ((claim (list 'IN (list 'SUBSEQ f phi) (list 'FUN 'NN A))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (if (not (dk-asm? (list 'IN phi '(FUN NN NN))))
                (dk-project! (list 'IN phi '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN phi)))
            (if (not (dk-asm? '(IN NN SET))) (fact 'nn-is-set))
            (mac 'SUBSEQ)
            (for-each
             (lambda (kn)
               (if (not (sequent-node-grounded? kn))
                   (begin
                     (dk-focus! kn)
                     (if (and (eq? (car (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                         (ass)
                         (let ((k (dk-di-var!)))
                           (fact 'fun-apply-type-c phi 'NN 'NN k)
                           (dk-close-if! (lambda () (fact 'fun-apply-type-c f 'NN A (list phi k))) ass))))))
             (dk-opened (lambda () (lam-t)))))))
    claim))

(sp (make-wff '(FORALL s (FORALL t (FORALL fam (FORALL dq
     (IMPLIES (IS-COMPLETE t)
       (IMPLIES (IS-EQUICONTINUOUS s t fam)
         (IMPLIES (IS-DENSE-SEQ s dq)
           (IMPLIES (FORALL m (IMPLIES (IN m NN)
                      (FORSOME y (AND (IN y (PTS t))
                        (CONVERGES-TO t (VNB-LAMBDA k NN ((fam k) (dq m))) y)))))
             (FORALL x (IMPLIES (IN x (PTS s))
               (FORSOME y (AND (IN y (PTS t))
                 (CONVERGES-TO t (VNB-LAMBDA k NN ((fam k) x)) y)))))))))))))))
(dk-peel!)
(define idn-x (cadr (car (filter (lambda (f) (and (eq? (idn-head f) 'IN) (equal? (caddr f) '(PTS s))))
                                 (dk-asms)))))
(idn-iff-rhs! (dk-cite! 'is-complete 't))
(idn-iff-rhs! (dk-cite! 'is-equicontinuous 's 't 'fam))
(idn-iff-rhs! (dk-cite! 'is-dense-seq 's 'dq))
(define idn-cpl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'IS-CAUCHY-SEQ))) "completeness"))
(define idn-eq (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'del))) "equicontinuity"))
(define idn-dn (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'dq)
                                         (dk-contains? h 'POS-RR) (not (dk-contains? h 'fam))))
                        "density"))
(define idn-H (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'CONVERGES-TO))) "the hypothesis"))
(define idn-Fx (list 'VNB-LAMBDA 'ick_ 'NN (list '(fam ick_) idn-x)))
(define (idn-fk! k)
  (let ((fk (list 'fam k)))
    (if (not (dk-asm? (list 'IN fk '(FUN (PTS s) (PTS t)))))
        (fact 'fun-apply-type-c 'fam 'NN '(FUN (PTS s) (PTS t)) k))
    fk))
(define (idn-pt! f x)
  (if (not (dk-asm? (list 'IN (list f x) '(PTS t))))
      (fact 'fun-apply-type-c f '(PTS s) '(PTS t) x))
  (list f x))
(define (idn-real! a b)
  (let ((r (list 'IN (idn-dt a b) 'RR)))
    (if (not (dk-asm? r)) (fact 'metric-dist-real 't a b))
    r))
(dk-have! (list 'IS-CAUCHY-SEQ 't idn-Fx)
  (lambda ()
    (mac 'is-cauchy-seq)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
          ((and (eq? (idn-head g) 'IN) (dk-contains? g 'VNB-LAMBDA))
           (for-each
            (lambda (kn)
              (if (not (sequent-node-grounded? kn))
                  (begin
                    (dk-focus! kn)
                    (if (and (eq? (idn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                        (dk-close-if! (lambda () (fact 'nn-is-set)) ass)
                        (let* ((k (dk-di-var!)) (fk (idn-fk! k)))
                          (dk-close-if! (lambda () (fact 'fun-apply-type-c fk '(PTS s) '(PTS t) idn-x)) ass))))))
            (dk-opened (lambda () (lam-t)))))
          ((eq? (idn-head g) 'FORALL)
           (let* ((pe (dk-peel!))
                  (eps (cadr (car (filter (lambda (f) (eq? (idn-head f) 'POS-RR)) pe))))
                  (h1 (dk-halve! eps))
                  (c (dk-halve! h1))
                  (del (dk-skolem! (dk-apply! idn-eq idn-x c)))
                  (ecl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h del))) "the delta clause"))
                  (m0 (dk-skolem! (dk-apply! idn-dn idn-x del)))
                  (q (list 'dq m0))
                  (_q (fact 'fun-apply-type-c 'dq 'NN '(PTS s) m0))
                  (y0 (dk-skolem! (dk-apply! idn-H m0)))
                  (cv (dk-pick (lambda (h) (and (eq? (idn-head h) 'CONVERGES-TO) (dk-contains? h y0))) "the convergence at dq(m0)")))
             (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to cv))))
             (let* ((ccl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h y0)
                                                   (dk-contains? h 'POS-RR)))
                                  "the convergence clause"))
                    (nN (dk-skolem! (dk-apply! ccl c)))
                    (ncl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h nN))) "the threshold clause")))
               (ew nN)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (idn-head (dk-goal)) 'FORALL))
                      (ass)
                      (begin
                        (dk-peel!)
                        (dk-split-all!)
                        (dk-lam-b!)
                        (let* ((gl (dk-goal))
                               (a (cadr (cadr gl))) (b (caddr (cadr gl)))
                               (m (cadr (car a))) (n (cadr (car b)))
                               (Fm (idn-fk! m)) (Fn (idn-fk! n))
                               (Fmx (idn-pt! Fm idn-x)) (Fnx (idn-pt! Fn idn-x))
                               (Fmq (idn-pt! Fm q)) (Fnq (idn-pt! Fn q)))
                          (dk-lam-b-h! (dk-apply! ncl m))
                          (dk-lam-b-h! (dk-apply! ncl n))
                          (dk-apply! ecl m q)
                          (dk-apply! ecl n q)
                          (fact 'metric-triangle 't Fmx Fmq Fnx)
                          (fact 'metric-triangle 't Fmq y0 Fnx)
                          (fact 'metric-triangle 't y0 Fnq Fnx)
                          (fact 'metric-sym 't y0 Fnq)
                          (fact 'metric-sym 't Fnq Fnx)
                          (fact 'rr-pos-rr-in-rr c)
                          (fact 'rr-pos-rr-in-rr h1)
                          (fact 'rr-pos-rr-in-rr eps)
                          (apply dk-ineq!
                                 (append
                                  (list (list '<= (idn-dt Fmx Fnx) (list '+ (idn-dt Fmx Fmq) (idn-dt Fmq Fnx)))
                                        (list '<= (idn-dt Fmq Fnx) (list '+ (idn-dt Fmq y0) (idn-dt y0 Fnx)))
                                        (list '<= (idn-dt y0 Fnx) (list '+ (idn-dt y0 Fnq) (idn-dt Fnq Fnx)))
                                        (list '= (idn-dt y0 Fnq) (idn-dt Fnq y0))
                                        (list '= (idn-dt Fnq Fnx) (idn-dt Fnx Fnq))
                                        (list '< (idn-dt Fmx Fmq) c) (list '< (idn-dt Fnx Fnq) c)
                                        (list '<= (idn-dt Fmq y0) c) (list '<= (idn-dt Fnq y0) c)
                                        (list '= (list '+ c c) h1) (list '= (list '+ h1 h1) eps)
                                        (list 'IN c 'RR) (list 'IN h1 'RR) (list 'IN eps 'RR))
                                  (map (lambda (pq) (idn-real! (car pq) (cadr pq)))
                                       (list (list Fmx Fnx) (list Fmx Fmq) (list Fmq Fnx) (list Fmq y0)
                                             (list y0 Fnx) (list y0 Fnq) (list Fnq Fnx) (list Fnq y0)
                                             (list Fnx Fnq)))))))))))))
          (#t (ass))))))))
(define idn-cvg (dk-apply! idn-cpl idn-Fx))
(define idn-l (dk-skolem! (car (dk-landed (lambda () (mac-h 'converges idn-cvg))))))
(define idn-lcv (dk-pick (lambda (h) (and (eq? (idn-head h) 'CONVERGES-TO) (dk-contains? h idn-l))) "the limit"))
(dk-project! (list 'IN idn-l '(PTS t)) 'converges-to idn-lcv)
(ew idn-l)
(dk-conj-close! (lambda () (ass)))
(qed 'equicont-dense-ptwise-limit)
(topic! 'equicont-dense-ptwise-limit 'analysis)
(alias! 'equicont-dense-ptwise-limit
        "an equicontinuous sequence into a complete space that converges on a dense sequence converges everywhere")

;;; =====================================================================
;;; ptwise-limit-function
;;; =====================================================================
(define (idn-S x) (list 'SEP 'ipy_ '(PTS t)
                        (list 'CONVERGES-TO 't (list 'VNB-LAMBDA 'ipk_ 'NN (list '(fam ipk_) x)) 'ipy_)))
(define (idn-CH x) (list 'CHOICE (idn-S x)))
(define idn-g (list 'VNB-LAMBDA 'ipx_ '(PTS s) (idn-CH 'ipx_)))
(define idn-P #f)
;;; x in pts(s): land CHOICE(S_x) in pts(t) and its convergence
(define (idn-ch! x)
  (if (not (dk-asm? (list 'IN (idn-CH x) '(PTS t))))
      (let* ((y0 (dk-skolem! (dk-apply! idn-P x))))
        (choose! (idn-S x) y0
          (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
        (dk-split-all!))))

(sp (make-wff '(FORALL s (FORALL t (FORALL fam
     (IMPLIES (IS-METRIC-SPACE s)
       (IMPLIES (IS-METRIC-SPACE t)
         (IMPLIES (IN fam (FUN NN (FUN (PTS s) (PTS t))))
           (IMPLIES (FORALL x (IMPLIES (IN x (PTS s))
                      (FORSOME y (AND (IN y (PTS t))
                        (CONVERGES-TO t (VNB-LAMBDA k NN ((fam k) x)) y)))))
             (FORSOME g (CONVERGES-PTWISE-TO s t fam g)))))))))))
(dk-peel!)
(set! idn-P (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'CONVERGES-TO))) "the hypothesis"))
(dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
(dk-project! '(IN (PTS t) SET) 'is-metric-space '(IS-METRIC-SPACE t))
(ew idn-g)
(mac 'converges-ptwise-to)
(dk-conj-close!
 (lambda ()
   (let ((gl (dk-goal)))
     (cond
      ((and (eq? (idn-head gl) 'IN) (dk-contains? gl 'CHOICE))
       (for-each
        (lambda (kn)
          (if (not (sequent-node-grounded? kn))
              (begin
                (dk-focus! kn)
                (if (and (eq? (idn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (ass)
                    (let ((x (dk-di-var!)))
                      (idn-ch! x)
                      (ass))))))
        (dk-opened (lambda () (lam-t)))))
      ((eq? (idn-head gl) 'FORALL)
       (let* ((pl (dk-peel!))
              (x (cadr (car (filter (lambda (f) (eq? (idn-head f) 'IN)) pl))))
              (e (cadr (car (filter (lambda (f) (eq? (idn-head f) 'POS-RR)) pl)))))
         (idn-ch! x)
         (dk-lam-b!)
         (let* ((cv (dk-pick (lambda (h) (and (eq? (idn-head h) 'CONVERGES-TO) (dk-contains? h (idn-CH x))))
                             "the convergence to the chosen limit")))
           (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to cv))))
           (let* ((ccl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                                 (dk-contains? h (idn-CH x))))
                                "the convergence clause"))
                  (n (dk-skolem! (dk-apply! ccl e)))
                  (ncl (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
             (ew n)
             (dk-conj-close!
              (lambda ()
                (if (not (eq? (idn-head (dk-goal)) 'FORALL))
                    (ass)
                    (let* ((pk (dk-peel!))
                           (k (cadr (car (filter (lambda (f) (and (eq? (idn-head f) 'IN) (eq? (caddr f) 'NN))) pk)))))
                      (dk-lam-b-h! (dk-apply! ncl k))
                      (ass)))))))))
      (#t (ass))))))
(qed 'ptwise-limit-function)
(topic! 'ptwise-limit-function 'analysis)
(alias! 'ptwise-limit-function "a sequence of functions convergent at every point has a pointwise limit function")

;;; =====================================================================
;;; compact-diagonal-on-seq
;;; =====================================================================
(define idn-ms '(VNB-LAMBDA icn_ NN t))
(define idn-seq '(VNB-LAMBDA ici_ NN (VNB-LAMBDA icj_ NN ((fs ici_) (dq icj_)))))
(define (idn-val! i j)          ; (fs i)(dq j) in pts(t)
  (let ((fi (list 'fs i)) (qj (list 'dq j)))
    (if (not (dk-asm? (list 'IN fi '(FUN dd (PTS t))))) (fact 'fun-apply-type-c 'fs 'NN '(FUN dd (PTS t)) i))
    (if (not (dk-asm? (list 'IN qj 'dd))) (fact 'fun-apply-type-c 'dq 'NN 'dd j))
    (if (not (dk-asm? (list 'IN (list fi qj) '(PTS t)))) (fact 'fun-apply-type-c fi 'dd '(PTS t) qj))
    (list fi qj)))
(define (idn-each-leaf! thunk-opener body)
  (for-each (lambda (kn)
              (if (not (sequent-node-grounded? kn))
                  (begin (dk-focus! kn) (body))))
            (dk-opened thunk-opener)))

(sp (make-wff '(FORALL t (FORALL dd (FORALL fs (FORALL dq
     (IMPLIES (IS-COMPACT t)
       (IMPLIES (IN fs (FUN NN (FUN dd (PTS t))))
         (IMPLIES (IN dq (FUN NN dd))
           (FORSOME delta (AND (STRICTLY-MONO-NN delta)
             (FORALL m (IMPLIES (IN m NN)
               (FORSOME y (AND (IN y (PTS t))
                 (CONVERGES-TO t (VNB-LAMBDA k NN (((SUBSEQ fs delta) k) (dq m))) y))))))))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE t) 'is-compact '(IS-COMPACT t))
(fact 'compact-implies-seq-compact 't)
(fact 'nn-is-set)
(dk-have! '(IN t METRIC-SPACE) (lambda () (fact 'metric-space-class 't) (prop)))
(fact 'membership-implies-sethood 't 'METRIC-SPACE)
(dk-have! (list 'IS-MS-SEQUENCE idn-ms)
  (lambda ()
    (mac 'is-ms-sequence)
    (dk-di-var!)
    (dk-lam-b!)
    (ass)))
(dk-have! (list 'FORALL 'icm_ (list 'IMPLIES '(IN icm_ NN) (list 'SEQ-COMPACT (list idn-ms 'icm_))))
  (lambda ()
    (dk-di-var!)
    (dk-lam-b!)
    (ass)))
(dk-have! (list 'IN idn-seq (list 'FUN 'NN (list 'PRODUCT-CARRIER idn-ms)))
  (lambda ()
    (idn-each-leaf! (lambda () (lam-t))
      (lambda ()
        (if (and (eq? (idn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
            (ass)
            (let ((i (dk-di-var!)))
              (mac 'PRODUCT-CARRIER)
              (idn-each-leaf! (lambda () (sep-mi))
                (lambda ()
                  (let ((gl (dk-goal)))
                    (cond
                     ((eq? (idn-head gl) 'FORALL)
                      (let ((n (dk-di-var!)))
                        (dk-lam-b!)
                        (idn-val! i n)
                        (ass)))
                     ((and (eq? (idn-head gl) 'IN) (dk-contains? gl 'BIG-UNION))
                      (idn-each-leaf! (lambda () (lam-t))
                        (lambda ()
                          (if (and (eq? (idn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                              (ass)
                              (let ((j (dk-di-var!)))
                                (idn-each-leaf! (lambda () (bu-mi j))
                                  (lambda ()
                                    (if (eq? (caddr (dk-goal)) 'NN)
                                        (ass)
                                        (begin (dk-lam-b!) (idn-val! i j) (ass))))))))))
                     (#t (ass))))))))))))
(define idn-ds (dk-apply! (dk-cite! 'coordinatewise-diagonal-subseq idn-ms) idn-seq))
(define idn-delta (dk-skolem! idn-ds))
(define idn-lim (dk-skolem! (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORSOME) (dk-contains? h 'PRODUCT-CARRIER)))
                                   "the limit point")))
(define idn-co (dk-pick (lambda (h) (and (eq? (idn-head h) 'FORALL) (dk-contains? h idn-lim)
                                         (dk-contains? h 'CONVERGES-TO)))
                        "the coordinatewise convergence"))
(dk-project! (list 'IN idn-delta '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN idn-delta))
(define idn-sfs (list 'SUBSEQ 'fs idn-delta))
(idn-subseq-type! 'fs idn-delta '(FUN dd (PTS t)))
(ew idn-delta)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (idn-head (dk-goal)) 'FORALL))
       (ass)
       (let* ((m (dk-di-var!))
              (Lm (list idn-lim m))
              (qm (list 'dq m))
              (Hs (list 'VNB-LAMBDA 'k 'NN (list (list idn-sfs 'k) qm)))
              (Lam (list 'VNB-LAMBDA 'k 'NN (list (list (list 'SUBSEQ idn-seq idn-delta) 'k) m))))
         (fact 'product-carrier-coord idn-ms idn-lim m)
         (dk-lam-b-h! (list 'IN Lm (list 'PTS (list idn-ms m))))
         (dk-lam-b-h! (dk-apply! idn-co m))
         (fact 'fun-apply-type-c 'dq 'NN 'dd m)
         (let ((cv (dk-pick (lambda (h) (and (eq? (idn-head h) 'CONVERGES-TO) (dk-contains? h Lm))) "the coordinate convergence")))
           (dk-project! (list 'IN (caddr cv) '(FUN NN (PTS t))) 'converges-to cv)
           ;; H is a sequence of points
           (dk-have! (list 'IN Hs '(FUN NN (PTS t)))
             (lambda ()
               (idn-each-leaf! (lambda () (lam-t))
                 (lambda ()
                   (if (and (eq? (idn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                       (ass)
                       (let* ((k (dk-di-var!)) (sk (list idn-sfs k)))
                         (fact 'fun-apply-type-c idn-sfs 'NN '(FUN dd (PTS t)) k)
                         (dk-close-if! (lambda () (fact 'fun-apply-type-c sk 'dd '(PTS t) qm)) ass)))))))
           ;; H and the coordinate sequence agree termwise
           (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list Hs 'j_) (list (caddr cv) 'j_))))
             (lambda ()
               (let* ((j (dk-di-var!)) (dj (list idn-delta j)))
                 (dk-lam-b!)
                 (fact 'subseq-apply 'fs idn-delta j)
                 (subst (list '== (list idn-sfs j) (list 'fs dj)))
                 (fact 'subseq-apply idn-seq idn-delta j)
                 (subst (list '== (list (list 'SUBSEQ idn-seq idn-delta) j) (list idn-seq dj)))
                 (fact 'fun-apply-type-c idn-delta 'NN 'NN j)
                 (dk-lam-b!)
                 (idn-val! dj m)
                 (rfl))))
           (let ((tr (dk-cite! 'converges-to-transfer 't)))
             (ew Lm)
             (dk-conj-close!
              (lambda ()
                (if (eq? (idn-head (dk-goal)) 'CONVERGES-TO)
                    (dk-close-if! (lambda () (inst*! tr (caddr cv) Hs Lm)) ass)
                    (ass))))))))))
(qed 'compact-diagonal-on-seq)
(topic! 'compact-diagonal-on-seq 'analysis)
(alias! 'compact-diagonal-on-seq
        "maps into a compact space have a subsequence converging at every point of a given sequence")
