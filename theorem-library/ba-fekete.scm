;;; ba-fekete.scm -- BANACH ALGEBRAS: Lemma 1.7 of Thayer's notes.  For x in a Banach algebra
;;; with unit, the sequence ||x^n||^(1/n) converges, and its limit is the spectral radius
;;; SPECTRAL-RADIUS(a, x) = inf_(n >= 1) ||x^n||^(1/n) (ba-vocab's definition).
;;; Agent BA-1C, wave 2026-11-09.  Destination: theorem-library/ba-fekete.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: baf-.
;;; The analysis is fekete-lemma (theorem-library/fekete.scm, library analysis); this file
;;; supplies ||x^(m+n)|| <= ||x^m|| ||x^n|| and reads SPECTRAL-RADIUS as the infimum.
;;; LOAD WINDOW: after theorem-library/fekete and theorem-library/ba-elem (BA-1).

(define (baf-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-fekete: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-fekete: unfinished" name))))

(define (baf-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (baf-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))
(define (baf-m x y) (list '(VMUL a) x y))
(define (baf-p x n) (list 'EL-POW 'a x n))
(define (baf-nr x) (list '(VNRM a) x))
(define baf-one '(VONE a))
(define (baf-pows! x v) (fact 'EL-POW-succ 'a x v)
  (subst (list '== (baf-p x (list 'succ v)) (baf-m x (baf-p x v)))))
(define (baf-ptype! n) (dk-cite! 'bae-el-pow-type n 'a 'x) (list 'IN (baf-p 'x n) '(VEC a)))

;;; ---- x^(m + n) = x^m x^n ---------------------------------------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL m (IMPLIES (IN m NN)
    (= (EL-POW a x (+ m n)) ((VMUL a) (EL-POW a x m) (EL-POW a x n)))))))))))))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (dk-cite! 'nn-add-zero 'm)
  (subst '(= (+ m 0) m))
  (fact 'EL-POW-zero 'a 'x) (subst (list '== (baf-p 'x 0) baf-one))
  (baf-ptype! 'm)
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a (baf-p 'x 'm))
  (subst (list '= (baf-m (baf-p 'x 'm) baf-one) (baf-p 'x 'm)))
  (rfl)
  (dk-focus! step)
  (dk-peel!)
  (let* ((pm (baf-p 'x 'm)) (pv (baf-p 'x v)) (mv (list '+ 'm v)) (pmv (baf-p 'x mv)))
    (dk-cite! 'nn-add-succ 'm v)
    (subst (list '= (list '+ 'm (list 'succ v)) (list 'succ mv)))
    (baf-cite2! 'nn-add-closed 'm v)
    (baf-pows! 'x mv)
    (baf-pows! 'x v)
    (dk-apply! ih 'x 'm)
    (subst (list '= pmv (baf-m pm pv)))
    (baf-ptype! 'm) (baf-ptype! v)
    ;; x (x^m x^v) = (x x^m) x^v = (x^m x) x^v = x^m (x x^v)
    (dk-cite! 'ring-mul-assoc-uba-as-ring 'a 'x pm pv)
    (dk-cite! 'bae-el-pow-comm 'm 'a 'x)
    (dk-cite! 'ring-mul-assoc-uba-as-ring 'a pm 'x pv)
    (subst (list '= (baf-m 'x (baf-m pm pv)) (baf-m (baf-m 'x pm) pv)))
    (subst (list '= (baf-m 'x pm) (baf-m pm 'x)))
    (subst (list '= (baf-m (baf-m pm 'x) pv) (baf-m pm (baf-m 'x pv))))
    (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a pm (baf-m 'x pv))
    (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a 'x pv)
    (rfl)))
(baf-qed! 'baf-el-pow-add)

;;; ---- ||x^(m + n)|| <= ||x^m|| ||x^n|| -------------------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (FORALL m (IMPLIES (IN m NN) (FORALL n (IMPLIES (IN n NN)
    (<= ((VNRM a) (EL-POW a x (+ m n))) (* ((VNRM a) (EL-POW a x m)) ((VNRM a) (EL-POW a x n))))))))))))))
(dk-peel!)
(dk-cite! 'baf-el-pow-add 'n 'a 'x 'm)
(subst (list '= (baf-p 'x '(+ m n)) (baf-m (baf-p 'x 'm) (baf-p 'x 'n))))
(baf-ptype! 'm) (baf-ptype! 'n)
(dk-cite! 'bal-uba-vnrm-submult 'a (baf-p 'x 'm) (baf-p 'x 'n))
(dk-ass!)
(baf-qed! 'baf-norm-pow-submult)

;;; ---- Lemma 1.7: ||x^n||^(1/n) converges to the spectral radius ----------------------------
(define baf-al '(VNB-LAMBDA bfk_ NN ((VNRM a) (EL-POW a x bfk_))))
(define baf-g '(VNB-LAMBDA bfn_ NN (RPOW-STAR ((VNRM a) (EL-POW a x (succ bfn_))) (RECIP-STAR (succ bfn_)))))
(define (baf-nrm j) (baf-nr (baf-p 'x j)))
(define (baf-rt j) (list 'RPOW-STAR (baf-nrm j) (list 'RECIP-STAR j)))
;;; land  ||x^j|| in RR, 0 <= ||x^j||, recip-star(j) typings, ||x^j||^(1/j) in RR and >= 0  (j >= 1 in context)
(define (baf-ntype! j)
  (baf-ptype! j)
  (dk-cite! 'bae-vnrm-type 'a (baf-p 'x j))
  (dk-cite! 'bal-uba-vnrm-nonneg 'a (baf-p 'x j))
  (list 'IN (baf-nrm j) 'RR))
(define (baf-rtype! j)
  (baf-ntype! j)
  (dk-cite! 'nn-in-rr j)
  (dk-cite! 'recip-star-nn-pos j)
  (dk-cite! 'recip-star-in-rr j)
  (baf-lin! (list '<= 0 (list 'RECIP-STAR j)) (list '< 0 (list 'RECIP-STAR j)))
  (dk-cite! 'rpow-star-nonneg-in-rr (baf-nrm j) (list 'RECIP-STAR j))
  (dk-cite! 'rpow-star-nonneg-nonneg (baf-nrm j) (list 'RECIP-STAR j))
  (list 'IN (baf-rt j) 'RR))
(define (baf-aval! j)
  (baf-ntype! j)
  (let ((eq (list '= (list baf-al j) (baf-nrm j))))
    (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
    eq))
(define baf-nonneg '(FORALL n_ (IMPLIES (IN n_ NN) (<= 0 (al n_)))))
(define baf-submult
  '(FORALL m_ (IMPLIES (IN m_ NN) (IMPLIES (<= 1 m_) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= 1 n_)
     (<= (al (+ m_ n_)) (* (al m_) (al n_))))))))))
(define (baf-sub-al f) (dk--replace f 'al baf-al))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'CONVERGES-TO 'RR-MS baf-g '(SPECTRAL-RADIUS a x))))))))
(dk-peel!)
(mac 'SPECTRAL-RADIUS)
(let* ((goal0 (dk-goal))
       (ss (cadr (cadddr goal0)))
       (lv (list 'EINF ss))
       (memb! (lambda (k)       ; land (IN ||x^k||^(1/k) ss), with k in NN and 1 <= k in context
                (baf-rtype! k)
                (dk-have! (list 'IN (baf-rt k) ss)
                  (lambda () (in-sep! (lambda () (dk-ass!))
                                      (lambda () (ew k) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
                (list 'IN (baf-rt k) ss))))
  ;; ss is a set of nonnegative reals
  (dk-have! (list 'SUBSET ss 'RR-POS-STAR)
    (lambda ()
      (mac 'subset-def)
      (let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
        (sep-me (list 'IN r ss))
        (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
          (dk-split-all!)
          (baf-rtype! k)
          (baf-lin! (list '<= 0 r) (list '= r (baf-rt k)) (list '<= 0 (baf-rt k)))
          (dk-cite! 'rmc-rps-of-nonneg r)
          (dk-ass!)))))
  ;; its infimum is a real: below the element at k = 1
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
  (memb! 1)
  (let ((elow (dk-cite! 'einf-lower ss)))
    (dk-apply! elow (baf-rt 1))
    (dk-cite! 'einf-in ss)
    (dk-cite! 'rps-below-real-is-real lv (baf-rt 1))
    (dk-cite! 'rr-pos-star-nonneg lv)
    ;; the hypotheses of fekete-lemma at al := ||x^k||, lv := inf ss, g := baf-g
    (dk-have! (list 'IN baf-al '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((j (cadr (dk-goal)))) (dk-peel!) (baf-ntype! j) (dk-ass!))))))
    (dk-have! (baf-sub-al baf-nonneg)
      (lambda () (let ((j (cadr (dk-goal)))) (dk-peel!) (subst (baf-aval! j)) (dk-ass!))))
    (dk-have! (baf-sub-al baf-submult)
      (lambda ()
        (let* ((g0 (dk-goal)) (mm (cadr g0)) (nn (cadr (caddr (caddr (caddr g0))))) (s (list '+ mm nn)))
          (dk-peel!)
          (baf-cite2! 'nn-add-closed mm nn)
          (subst (baf-aval! s)) (subst (baf-aval! mm)) (subst (baf-aval! nn))
          (dk-cite! 'baf-norm-pow-submult 'a 'x mm nn)
          (dk-ass!))))
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= 1 k)
                (list '<= lv (list 'RPOW-STAR (list baf-al 'k) '(RECIP-STAR k))))))
      (lambda ()
        (dk-peel!)
        (subst (baf-aval! 'k))
        (memb! 'k)
        (dk-apply! elow (baf-rt 'k))
        (dk-ass!)))
    (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
                (list 'FORSOME 'k (list 'AND '(IN k NN) (list 'AND '(<= 1 k)
                  (list '< (list 'RPOW-STAR (list baf-al 'k) '(RECIP-STAR k)) (list '+ lv 'eps)))))))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'rr-pos-rr-in-rr 'eps)
        (dk-cite! 'rr-lt-of-pos-rr 'eps)
        (let ((le (list '+ lv 'eps)))
          (dk-real! le)
          (baf-lin! (list '< lv le) '(< 0 eps))
          (baf-lin! (list '<= 0 le) '(< 0 eps) (list '<= 0 lv))
          (dk-cite! 'rmc-rps-of-nonneg le)
          (let* ((y (dk-skolem! (dk-cite! 'einf-lt-witness ss le) #t)))
            (sep-me (list 'IN y ss))
            (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the index"))))
              (dk-split-all!)
              (baf-rtype! k)
              (let ((eqk (baf-aval! k)))
                (ew k)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) '<)
                        (begin (subst eqk) (subst (list '= (baf-rt k) y)) (dk-ass!))
                        (dk-ass!))))))))))
    ;; the sequence g(n) = ||x^(n+1)||^(1/(n+1))
    (dk-have! (list 'IN baf-g '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((j (cadr (dk-goal))))
                                           (dk-peel!)
                                           (dk-cite! 'nn-succ-closed j)
                                           (dk-cite! 'nn-one-le-succ j)
                                           (baf-rtype! (list 'succ j))
                                           (dk-ass!))))))
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                (list '= (list baf-g 'n) (list 'RPOW-STAR (list baf-al '(succ n)) '(RECIP-STAR (succ n))))))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'nn-succ-closed 'n)
        (dk-cite! 'nn-one-le-succ 'n)
        (baf-rtype! '(succ n))
        (if (not (dk-lam-b!)) (rfl))))
    (dk-cite! 'fekete-lemma baf-al lv baf-g)
    (dk-ass!)))
(baf-qed! 'spectral-radius-limit)

(display "\n;; BAF qed failures: ")  
