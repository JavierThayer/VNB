;; ---------------------------------------------------------------------------
;; the union of two sigma-unions of cb is one
(sp (make-wff (dk-foralls '(omega ca cb rho a b) (dk-curry (list mfl-lm (mfl-su 'a) (mfl-su 'b)) (mfl-su '(UNION a b))))))
(dk-peel!)
(mfl-parts!)
(dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho 'a)
(dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho 'b)
(let* ((ift (lambda (k) (list 'IF (list '= k 0) 'a 'b)))
       (h (list 'VNB-LAMBDA 'mfuk_ 'NN (ift 'mfuk_)))
       (buh (list 'BIG-UNION 'n_ 'NN (list h 'n_))))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-have! (list 'IN h '(FUN NN ca))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-case-if! (ift k) (lambda (t v) (dk-ass!))))))))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mfl-su (list h 'k))))
    (lambda () (let ((k (dk-di-var!))) (dk-lam-b!) (dk-case-if! (ift k) (lambda (t v) (dk-ass!))))))
  (dk-cite! 'sigma-union-of-countable 'omega 'ca 'cb 'rho h)
  (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
  (dk-have! '(IN 0 NN) (lambda () (arith)))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (dk-class-ext! buh '(UNION a b)
    (lambda (w)
      (let* ((r (dk-bu-open! w buh)) (k (car r)))
        (dk-lam-b-h! (list 'IN w (list h k)))
        (use-em (list '= k 0)
          (lambda ()
            (dk-have! (list '= (ift k) 'a) (lambda () (dk-if-branch! #t (ift k) #f (lambda () (rfl)))))
            (dk-rewrite-h! (list 'IN w (ift k)) (ift k) 'a)
            (dk-have! (list 'OR (list 'IN w 'a) (list 'IN w 'b)) (lambda () (oi-l) (dk-ass!)))
            (dk-iff-bwd! (dk-cite! 'union-membership 'a 'b w))
            (dk-ass!))
          (lambda ()
            (dk-have! (list '= (ift k) 'b) (lambda () (dk-if-branch! #f (ift k) #f (lambda () (rfl)))))
            (dk-rewrite-h! (list 'IN w (ift k)) (ift k) 'b)
            (dk-have! (list 'OR (list 'IN w 'a) (list 'IN w 'b)) (lambda () (oi-r) (dk-ass!)))
            (dk-iff-bwd! (dk-cite! 'union-membership 'a 'b w))
            (dk-ass!)))))
    (lambda (w)
      (dk-iff-fwd! (dk-cite! 'union-membership 'a 'b w))
      (dk-or-each! (list 'OR (list 'IN w 'a) (list 'IN w 'b))
        (lambda (o)
          (let ((k (if (equal? o (list 'IN w 'a)) 0 1)))
            (dk-have! (list 'IN w (list h k))
              (lambda () (dk-lam-b!)
                         (if (eqv? k 0)
                             (dk-if-branch! #t (ift k) (lambda () (rfl)) (lambda () (dk-ass!)))
                             (dk-if-branch! #f (ift k) (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
            (dk-bu-close! k))))))
  (dk-rewrite-h! (mfl-su buh) buh '(UNION a b))
  (dk-ass!))
(mfl-qed! 'sigma-union-of-union)

;; ---------------------------------------------------------------------------
;; a set of finite measure under an extension nu of rho is essentially in B_sigma (the second half of 4.22's proof)
(define (mfl-wit e a) (list 'AND (mfl-su a) (list 'AND (list 'SUBSET a e) (mfl-ln (list 'DIFFERENCE e a)))))
;; x in RR-POS-STAR, x <= r with r in RR: x in RR
(define (mfl-real-le! x r)
  (if (not (dk-asm? (list 'IN x 'RR)))
      (begin
        (dk-iff-fwd! (dk-cite! 'rr-pos-star-membership x))
        (dk-have! (list 'IN x 'RR)
          (lambda ()
            (dk-or-each! (list 'OR (list 'AND (list 'IN x 'RR) (list '<= 0 x)) (list '= x 'POS-INF))
              (lambda (d)
                (if (dk-head-is? d 'AND)
                    (begin (dk-split-all! (list d)) (dk-ass!))
                    (begin (dk-rewrite-h! (list '<= x r) x 'POS-INF)
                           (ai (dk-cite! 'pos-inf-above-reals r)))))))))))
(sp (make-wff (dk-foralls '(omega ca cb rho nu es) (dk-curry
  (list mfl-lm '(IN EMPTY-SET cb) '(IS-MEASURE omega ca nu) mfl-ext-nu '(IN es ca) '(IN (nu es) RR))
  (list 'FORSOME 'a (mfl-wit 'es 'a))))))
(dk-peel!)
(mfl-parts!)
(mfl-pre!)
(let* ((nup (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca 'nu)))
       (sset (list 'SEP 'lsv_ 'RR-POS-STAR (list 'FORSOME 'lsa_ (list 'AND '(IN lsa_ ca) (list 'AND (mfl-su 'lsa_) (list 'AND '(SUBSET lsa_ es) '(= lsv_ (nu lsa_))))))))
       (sl (list 'ESUP sset))
       (nu-ty! (lambda (x) (if (not (dk-asm? (list 'IN (list 'nu x) 'RR-POS-STAR))) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-POS-STAR x))))
       (nu-real! (lambda (x)   ; x in ca, x subset es
                   (nu-ty! x)
                   (dk-cite! 'measure-monotone 'omega 'ca 'nu x 'es)
                   (mfl-real-le! (list 'nu x) '(nu es)))))
  (nu-ty! 'es)
  (dk-cite! 'sigma-union-of-member 'omega 'ca 'cb 'rho 'EMPTY-SET)
  (dk-have! (list 'SUBSET sset 'RR-POS-STAR)
    (lambda () (let ((w (subset-by-element!))) (dk-sep-parts! (list 'IN w sset)) (dk-ass!))))
  (dk-cite! 'esup-in sset)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sset) '(<= x (nu es))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-sep-parts! (list 'IN x sset))
        (let ((a (dk-skolem! (dk-ctx-form (list 'FORSOME 'lsa_ (list 'AND '(IN lsa_ ca) (list 'AND (mfl-su 'lsa_) (list 'AND '(SUBSET lsa_ es) (list '= x '(nu lsa_))))))))))
          (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
          (dk-cite! 'measure-monotone 'omega 'ca 'nu a 'es)
          (subst (list '= x (list 'nu a)))
          (dk-ass!)))))
  (dk-have-and! '(IN (nu es) RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sset) '(<= x (nu es)))))
  (dk-cite! 'esup-least sset '(nu es))
  (mfl-real-le! sl '(nu es))
  ;; for every n a sigma-union inside es with measure above sl - 1/(n+1)
  (let* ((fam (list 'VNB-LAMBDA 'lsn_ 'NN (list 'SEP 'lsa_ '(POWER omega)
                (list 'AND (mfl-su 'lsa_) (list 'AND '(SUBSET lsa_ es) (list '< (list '- sl '(RECIP (+ lsn_ 1))) '(nu lsa_)))))))
         (memb (lambda (n) (list 'SEP 'lsa_ '(POWER omega)
                (list 'AND (mfl-su 'lsa_) (list 'AND '(SUBSET lsa_ es) (list '< (list '- sl (list 'RECIP (list '+ n 1))) '(nu lsa_))))))))
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORSOME 'w (list 'AND '(IN w (POWER omega)) (list 'IN 'w (list fam 'n))))))
      (lambda ()
        (let* ((n (dk-di-var!)) (r (list 'RECIP (list '+ n 1))) (t (list '- sl r)))
          (dk-cite! 'nn-recip-succ-pos n)
          (dk-cite! 'rr-pos-rr-in-rr r) (dk-cite! 'rr-lt-of-pos-rr r)
          (dk-type! t 'RR)
          (let ((close-with!
                  (lambda (a)
                    (ew a)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-ass!) #t
                            (begin (dk-lam-b!)
                                   (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!))))))))))
            (dk-or-each! (dk-cite! 'rr-lt-trichotomy t 0)
              (lambda (d)
                (if (equal? d (list '< t 0))
                    (begin
                      (dk-have! '(SUBSET EMPTY-SET es) (lambda () (let ((w (subset-by-element!))) (ai (dk-cite! 'empty-set-has-no-members w)))))
                      (dk-have! '(SUBSET EMPTY-SET omega) (lambda () (let ((w (subset-by-element!))) (ai (dk-cite! 'empty-set-has-no-members w)))))
                      (mfl-pow! 'EMPTY-SET)
                      (dk-have! (list '< t '(nu EMPTY-SET)) (lambda () (subst '(= (nu EMPTY-SET) 0)) (dk-ass!)))
                      (close-with! 'EMPTY-SET))
                    (begin
                      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! d)))
                      (dk-have! (list 'OR (list 'AND (list 'IN t 'RR) (list '<= 0 t)) (list '= t 'POS-INF))
                        (lambda () (oi-l) (dk-conj-close! dk-ass!)))
                      (dk-iff-bwd! (dk-cite! 'rr-pos-star-membership t))
                      (dk-have! (list '< t sl) (lambda () (dk-ineq! (list '< 0 r))))
                      (let* ((y (dk-skolem! (dk-cite! 'esup-lt-witness sset t))))
                        (dk-sep-parts! (list 'IN y sset))
                        (let ((a (dk-skolem! (dk-ctx-form (list 'FORSOME 'lsa_ (list 'AND '(IN lsa_ ca) (list 'AND (mfl-su 'lsa_) (list 'AND '(SUBSET lsa_ es) (list '= y '(nu lsa_))))))))))
                          (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
                          (mfl-sub-omega! a) (mfl-pow! a)
                          (dk-rewrite-h! (list '< t y) y (list 'nu a))
                          (close-with! a)))))))))))
    (let* ((aa (dk-skolem! (dk-cite! 'rmm-nn-choice '(POWER omega) fam)))
           (all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f aa))) (dk-asms)))
           (val! (lambda (k)
                   (if (not (dk-asm? (list 'SUBSET (list aa k) 'es)))
                       (let ((hh (dk-apply! all k)))
                         (dk-lam-b-h! hh)
                         (dk-sep-parts! (list 'IN (list aa k) (memb k)))
                         (dk-split-all!)))))
           (ba (list 'BIG-UNION 'n_ 'NN (list aa 'n_)))
           (nn (list 'DIFFERENCE 'es ba)))
      (dk-project! (list 'IN aa '(FUN NN)) 'fun-codomain-iff (list 'IN aa '(FUN NN (POWER omega))))
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list 'IN (list aa 'x) 'ca)))
        (lambda () (let ((k (dk-di-var!))) (val! k) (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho (list aa k)) (dk-ass!))))
      (dk-have-and! (list 'IN aa '(FUN NN)) (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list 'IN (list aa 'x) 'ca))))
      (dk-iff-bwd! (dk-cite! 'fun-codomain-iff 'NN 'ca aa))
      (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mfl-su (list aa 'k))))
        (lambda () (let ((k (dk-di-var!))) (val! k) (dk-ass!))))
      (dk-cite! 'sigma-union-of-countable 'omega 'ca 'cb 'rho aa)
      (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho ba)
      (dk-have! (list 'SUBSET ba 'es)
        (lambda () (let* ((w (subset-by-element!)) (r (dk-bu-open! w ba)) (k (car r)))
                     (val! k) (dk-cite! 'subset-mem-fwd (list aa k) 'es w) (dk-ass!))))
      (nu-real! ba)
      ;; sl <= nu(ba)
      (dk-have! (list '<= sl (list 'nu ba))
        (lambda ()
          (dk-or-each! (dk-cite! 'rr-lt-trichotomy (list 'nu ba) sl)
            (lambda (d)
              (if (equal? d (list '< (list 'nu ba) sl))
                  (let* ((ep (list '- sl (list 'nu ba))))
                    (dk-type! ep 'RR)
                    (dk-have! (list '< 0 ep) (lambda () (dk-ineq! d)))
                    (dk-cite! 'rr-pos-rr-of-lt ep)
                    (let* ((m (dk-skolem! (dk-cite! 'nn-recip-succ-small ep)))
                           (am (list aa m)))
                      (val! m)
                      (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho am)
                      (dk-have! (list 'SUBSET am ba) (lambda () (let ((w (subset-by-element!))) (dk-bu-close! m))))
                      (dk-cite! 'measure-monotone 'omega 'ca 'nu am ba)
                      (nu-real! am)
                      (dk-cite! 'nn-recip-succ-pos m)
                      (dk-cite! 'rr-pos-rr-in-rr (list 'RECIP (list '+ m 1)))
                      (dk-absurd! (list '< (list '- sl (list 'RECIP (list '+ m 1))) (list 'nu am))
                                  (list '<= (list 'nu am) (list 'nu ba))
                                  (list '< (list 'RECIP (list '+ m 1)) ep))))
                  (dk-ineq! d))))))
      (mfl-diff-ca! 'es ba)
      (ew ba)
      (dk-conj-close!
        (lambda ()
          (if (dk-ass!) #t
              (mfl-ln-close! nn
                (lambda (b)
                  (let* ((c (list 'INTERSECTION b nn)) (u (list 'UNION ba c)))
                    (mfl-ca! b)
                    (mfl-inter-ca! b nn) (mfl-sub-inter! b nn 'left) (mfl-sub-inter! b nn 'right)
                    (mfl-cb! c b)
                    (mfl-sub-diff! 'es ba)
                    (dk-cite! 'subset-trans c nn 'es)
                    (dk-cite! 'sigma-union-of-member 'omega 'ca 'cb 'rho c)
                    (dk-cite! 'sigma-union-of-union 'omega 'ca 'cb 'rho ba c)
                    (mfl-ca! c)
                    (dk-cite! 'sigma-algebra-union-closed-2 'omega 'ca ba c)
                    (dk-have! (list 'SUBSET u 'es)
                      (lambda () (let ((w (subset-by-element!)))
                                   (dk-iff-fwd! (dk-cite! 'union-membership ba c w))
                                   (dk-or-each! (list 'OR (list 'IN w ba) (list 'IN w c))
                                     (lambda (o) (dk-cite! 'subset-mem-fwd (caddr o) 'es w) (dk-ass!))))))
                    (nu-ty! u)
                    (dk-have! (list 'IN (list 'nu u) sset)
                      (lambda () (in-sep! (lambda () (dk-ass!))
                                          (lambda () (ew u) (dk-conj-close! (lambda () (if (dk-ass!) #t (rfl))))))))
                    (dk-apply! (dk-cite! 'esup-upper sset) (list 'nu u))
                    (dk-class-ext! (list 'INTERSECTION ba c) 'EMPTY-SET
                      (lambda (w) (dk-iff-fwd! (dk-cite! 'intersection-membership ba c w))
                                  (dk-cite! 'subset-mem-fwd c nn w)
                                  (dk-iff-fwd! (dk-cite! 'difference-membership 'es ba w))
                                  (ai (list 'NOT (list 'IN w ba))))
                      (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
                    (let ((ad (dk-cite! 'measure-finitely-additive 'omega 'ca 'nu ba c)))
                      (nu-real! c) (nu-real! u)
                      (dk-cite! 'rr-pos-star-nonneg (list 'nu ba))
                      (dk-cite! 'rr-pos-star-nonneg (list 'nu c))
                      (dk-cite! 'eplus-real-defined (list 'nu ba) (list 'nu c))
                      (dk-cite! 'binplus-apply (list 'nu ba) (list 'nu c))
                      (let* ((a1 (dk-rewrite-h! ad (list 'EPLUS (list 'nu ba) (list 'nu c)) (list 'BINPLUS (list 'nu ba) (list 'nu c))))
                             (a2 (dk-rewrite-h! a1 (list 'BINPLUS (list 'nu ba) (list 'nu c)) (list '+ (list 'nu ba) (list 'nu c)))))
                        (dk-have! (list '<= (list 'nu c) 0)
                          (lambda () (dk-ineq! a2 (list '<= (list 'nu u) sl) (list '<= sl (list 'nu ba)))))
                        (mfl-zero-of-le! (list 'nu c))
                        (dk-apply! mfl-ext-nu c)
                        (subst (list '= (list 'rho c) (list 'nu c)))
                        (dk-ass!))))))))))))
(mfl-qed! 'essential-of-finite-extension)

;; ---------------------------------------------------------------------------
;; Prop 4.22: the minimum extension mu_min of rho
;; countable additivity of mu_min (used inside local-measure-min-extension)
(define (mfl-min-additive! mm v1 v2 choose!)
  (dk-peel!)
  (let* ((g0 (dk-goal))
         (buf (cadr (cadr g0)))
         (ff (car (cadddr buf)))
         (disj (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ff) (dk-contains? f 'INTERSECTION))) (dk-asms)))
         (fmm (list 'VNB-LAMBDA 'n_ 'NN (list mm (list ff 'n_))))
         (exb (list 'FORSOME 'k (list 'AND '(IN k NN) (list 'NOT (mfl-ess (list ff 'k)))))))
    (dk-cite! 'sigma-algebra-union-closed 'omega 'ca ff)
    (mfl-rps-fun! fmm (lambda (k) (dk-cite! 'fun-apply-type-c ff 'NN 'ca k) (dk-cite! 'fun-apply-type-c mm 'ca 'RR-POS-STAR (list ff k))))
    (mfl-esum-ty! fmm)
    (use-em exb
      (lambda ()
        (let* ((k0 (dk-skolem! (dk-ctx-form exb)))
               (fk (list ff k0)))
          (dk-cite! 'fun-apply-type-c ff 'NN 'ca k0)
          (dk-have! (list 'NOT (mfl-ess buf))
            (lambda ()
              (di)
              (let* ((a (dk-skolem! (dk-ctx-form (mfl-ess buf))))
                     (ai2 (list 'INTERSECTION a fk)))
                (dk-split-all!)
                (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
                (dk-cite! 'sigma-union-of-inter 'omega 'ca 'cb 'rho a fk)
                (mfl-sub-inter! a fk 'right)
                (mfl-inter-ca! a fk)
                (mfl-diff-ca! fk ai2)
                (mfl-diff-ca! buf a)
                (dk-have! (list 'SUBSET (list 'DIFFERENCE fk ai2) (list 'DIFFERENCE buf a))
                  (lambda ()
                    (let ((w (subset-by-element!)))
                      (dk-iff-fwd! (dk-cite! 'difference-membership fk ai2 w))
                      (dk-have! (list 'IN w buf) (lambda () (dk-bu-close! k0)))
                      (dk-have! (list 'NOT (list 'IN w a))
                        (lambda () (di)
                                   (dk-have-and! (list 'IN w a) (list 'IN w fk))
                                   (dk-iff-bwd! (dk-cite! 'intersection-membership a fk w))
                                   (ai (list 'NOT (list 'IN w ai2)))))
                      (dk-have-and! (list 'IN w buf) (list 'NOT (list 'IN w a)))
                      (dk-iff-bwd! (dk-cite! 'difference-membership buf a w))
                      (dk-ass!))))
                (dk-cite! 'locally-null-subset 'omega 'ca 'cb 'rho (list 'DIFFERENCE buf a) (list 'DIFFERENCE fk ai2))
                (dk-have! (mfl-ess fk) (lambda () (ew ai2) (dk-conj-close! dk-ass!)))
                (ai (list 'NOT (mfl-ess fk))))))
          (dk-apply! v2 buf)
          (dk-apply! v2 fk)
          (let ((tl (dk-cite! 'esum-nn-term-le fmm k0)))
            (dk-lam-b-h! tl)
            (dk-rewrite-h! (list '<= (list mm fk) (list 'ESUM fmm)) (list mm fk) 'POS-INF)
            (mfl-star! (list 'ESUM fmm))
            (dk-cite! 'rr-star-le-pos-inf-eq (list 'ESUM fmm))
            (subst (list '= (list mm buf) 'POS-INF))
            (subst (list '= (list 'ESUM fmm) 'POS-INF))
            (rfl))))
      (lambda ()
        (let* ((allw (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mfl-ess (list ff 'k)))))
               (fam (list 'VNB-LAMBDA 'lsn_ 'NN (list 'SEP 'mma_ 'ca (mfl-wit (list ff 'lsn_) 'mma_))))
               (memb (lambda (k) (list 'SEP 'mma_ 'ca (mfl-wit (list ff k) 'mma_)))))
          (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
          (dk-cite! 'membership-implies-sethood 'ca '(POWER (POWER omega)))
          (dk-have! allw
            (lambda ()
              (let ((k (dk-di-var!)))
                (use-em (mfl-ess (list ff k))
                  (lambda () (dk-ass!))
                  (lambda () (dk-have! exb (lambda () (ew k) (dk-conj-close! dk-ass!)))
                             (ai (list 'NOT exb)))))))
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'w (list 'AND '(IN w ca) (list 'IN 'w (list fam 'k))))))
            (lambda ()
              (let* ((k (dk-di-var!)))
                (dk-apply! allw k)
                (let ((a (dk-skolem! (dk-ctx-form (mfl-ess (list ff k))))))
                  (dk-split-all!)
                  (ew a)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-ass!) #t
                          (begin (dk-lam-b!)
                                 (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!)))))))))))
          (let* ((aa (dk-skolem! (dk-cite! 'rmm-nn-choice 'ca fam)))
                 (all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f aa))) (dk-asms)))
                 (val! (lambda (k)
                         (if (not (dk-asm? (list 'SUBSET (list aa k) (list ff k))))
                             (let ((hh (dk-apply! all k)))
                               (dk-lam-b-h! hh)
                               (dk-sep-parts! (list 'IN (list aa k) (memb k)))
                               (dk-split-all!)
                               (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho (list aa k))
                               (dk-cite! 'fun-apply-type-c ff 'NN 'ca k)))))
                 (ba (list 'BIG-UNION 'n_ 'NN (list aa 'n_)))
                 (nk (lambda (k) (list 'DIFFERENCE (list ff k) (list aa k))))
                 (ab (dk-abstract! 'NN 'ca nk (lambda (k) (val! k) (mfl-diff-ca! (list ff k) (list aa k)) (dk-ass!))))
                 (nf (car ab)) (nve (cdr ab))
                 (bunf (list 'BIG-UNION 'n_ 'NN (list nf 'n_)))
                 (fx (list 'VNB-LAMBDA 'n_ 'NN (list mfl-mx (list aa 'n_)))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mfl-su (list aa 'k))))
              (lambda () (let ((k (dk-di-var!))) (val! k) (dk-ass!))))
            (dk-cite! 'sigma-union-of-countable 'omega 'ca 'cb 'rho aa)
            (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho ba)
            (dk-have! (list 'SUBSET ba buf)
              (lambda () (let* ((w (subset-by-element!)) (r (dk-bu-open! w ba)) (k (car r)))
                           (val! k) (dk-cite! 'subset-mem-fwd (list aa k) (list ff k) w) (dk-bu-close! k))))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (mfl-ln (list nf 'k))))
              (lambda () (let ((k (dk-di-var!)))
                           (val! k) (dk-apply! nve k)
                           (subst (list '= (list nf k) (nk k)))
                           (dk-ass!))))
            (dk-cite! 'locally-null-union 'omega 'ca 'cb 'rho nf)
            (mfl-diff-ca! buf ba)
            (dk-have! (list 'SUBSET (list 'DIFFERENCE buf ba) bunf)
              (lambda ()
                (let ((w (subset-by-element!)))
                  (dk-iff-fwd! (dk-cite! 'difference-membership buf ba w))
                  (let* ((r (dk-bu-open! w buf)) (k (car r)))
                    (val! k)
                    (dk-have! (list 'NOT (list 'IN w (list aa k)))
                      (lambda () (di) (dk-have! (list 'IN w ba) (lambda () (dk-bu-close! k))) (ai (list 'NOT (list 'IN w ba)))))
                    (dk-have-and! (list 'IN w (list ff k)) (list 'NOT (list 'IN w (list aa k))))
                    (dk-iff-bwd! (dk-cite! 'difference-membership (list ff k) (list aa k) w))
                    (dk-apply! nve k)
                    (dk-have! (list 'IN w (list nf k)) (lambda () (subst (list '= (list nf k) (nk k))) (dk-ass!)))
                    (dk-bu-close! k)))))
            (dk-cite! 'locally-null-subset 'omega 'ca 'cb 'rho bunf (list 'DIFFERENCE buf ba))
            (dk-apply! v1 buf ba)
            (dk-split-all! (list (dk-cite! 'local-measure-max-extension 'omega 'ca 'cb 'rho)))
            (let ((mxp (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca mfl-mx))))
              (dk-have! (list 'FORALL 'i_ (list 'FORALL 'j_ (list 'IMPLIES '(IN i_ NN) (list 'IMPLIES '(IN j_ NN)
                          (list 'IMPLIES '(NOT (= i_ j_)) (list '= (list 'INTERSECTION (list aa 'i_) (list aa 'j_)) 'EMPTY-SET))))))
                (lambda ()
                  (dk-peel!)
                  (let* ((g1 (dk-goal)) (i (cadr (cadr (cadr g1)))) (j (cadr (caddr (cadr g1)))))
                    (val! i) (val! j)
                    (dk-apply! disj i j)
                    (dk-class-ext! (list 'INTERSECTION (list aa i) (list aa j)) 'EMPTY-SET
                      (lambda (w)
                        (dk-iff-fwd! (dk-cite! 'intersection-membership (list aa i) (list aa j) w))
                        (dk-cite! 'subset-mem-fwd (list aa i) (list ff i) w)
                        (dk-cite! 'subset-mem-fwd (list aa j) (list ff j) w)
                        (dk-have-and! (list 'IN w (list ff i)) (list 'IN w (list ff j)))
                        (dk-iff-bwd! (dk-cite! 'intersection-membership (list ff i) (list ff j) w))
                        (dk-rewrite-h! (list 'IN w (list 'INTERSECTION (list ff i) (list ff j))) (list 'INTERSECTION (list ff i) (list ff j)) 'EMPTY-SET)
                        (ai (dk-cite! 'empty-set-has-no-members w)))
                      (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
                    (dk-ass!))))
              (dk-apply! (list-ref mxp 3) aa)
              (dk-cite! 'restrict-apply mfl-mio 'ca ba)
              (mfl-rps-fun! fx (lambda (k) (val! k) (dk-cite! 'fun-apply-type-c mfl-mx 'ca 'RR-POS-STAR (list aa k))))
              (for-each
                (lambda (pr)
                  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list (car pr) 'k) (list (cdr pr) 'k))))
                    (lambda ()
                      (let ((k (dk-di-var!)))
                        (dk-lam-b!)
                        (val! k)
                        (dk-cite! 'restrict-apply mfl-mio 'ca (list aa k))
                        (subst (list '= (list mfl-mx (list aa k)) (list mfl-mio (list aa k))))
                        (dk-apply! v1 (list ff k) (list aa k))
                        (subst (list '= (list mm (list ff k)) (list mfl-mio (list aa k))))
                        (mfl-mio-ty! (list aa k))
                        (mfl-star! (list mfl-mio (list aa k)))
                        (dk-cite! 'rr-star-leq-reflexive (list mfl-mio (list aa k)))
                        (dk-ass!))))
                  (dk-cite! 'esum-nn-le-termwise (car pr) (cdr pr)))
                (list (cons fx fmm) (cons fmm fx)))
              (mfl-esum-ty! fx)
              (mfl-antisym! (list 'ESUM fx) (list 'ESUM fmm))
              (subst (list '= (list mm buf) (list mfl-mio ba)))
              (subst (list '= (list mfl-mio ba) (list mfl-mx ba)))
              (subst (list '= (list mfl-mx ba) (list 'ESUM fx)))
              (dk-ass!))))))))

(define (mfl-ess e) (list 'FORSOME 'mma_ (list 'AND '(IN mma_ ca) (mfl-wit e 'mma_))))
(define (mfl-mm-ift e)
  (list 'IF (mfl-ess e)
        (list mfl-mio (list 'CHOICE (list 'SEP 'mma_ 'ca (mfl-wit e 'mma_))))
        'POS-INF))
(define mfl-mm (list 'VNB-LAMBDA 'mme_ 'ca (mfl-mm-ift 'mme_)))
(define (mfl-min-stmt m)
  (list 'AND (list 'IS-MEASURE 'omega 'ca m)
   (list 'AND (list 'FORALL 'lxe_ (list 'IMPLIES '(IN lxe_ cb) (list '= (list m 'lxe_) '(rho lxe_))))
    (list 'AND (list 'FORALL 'nu (dk-curry (list '(IS-MEASURE omega ca nu) mfl-ext-nu)
                                    (list 'FORALL 'es (list 'IMPLIES '(IN es ca) (list '<= (list m 'es) '(nu es))))))
     (list 'AND (list 'FORALL 'es (list 'IMPLIES '(IN es ca)
                       (list 'FORALL 'a (dk-curry (list (mfl-su 'a) '(SUBSET a es) (mfl-ln '(DIFFERENCE es a)))
                                          (list '= (list m 'es) (list mfl-mio 'a))))))
                (list 'FORALL 'es (list 'IMPLIES '(IN es ca)
                       (list 'IMPLIES (list 'NOT (mfl-ess 'es)) (list '= (list m 'es) 'POS-INF)))))))))
(sp (make-wff (dk-foralls '(omega ca cb rho) (dk-curry (list mfl-lm '(IN EMPTY-SET cb))
  (list 'FORSOME 'mm (mfl-min-stmt 'mm))))))
(dk-peel!)
(mfl-parts!)
(mfl-pre!)
(dk-cite! 'method-i-outer-type 'omega 'cb 'rho)
(dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
(dk-cite! 'membership-implies-sethood 'ca '(POWER (POWER omega)))
(let* ((wset (lambda (e) (list 'SEP 'mma_ 'ca (mfl-wit e 'mma_))))
       (choose! (lambda (e)   ; (mfl-ess e) in context: lands the chosen witness's properties
                  (let* ((a (dk-skolem! (dk-ctx-form (mfl-ess e))))
                         (c (list 'CHOICE (wset e))))
                    (dk-split-all!)
                    (dk-have! (list 'FORSOME 'stz_ (list 'IN 'stz_ (wset e)))
                      (lambda () (ew a) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!)))))
                    (dk-cite! 'choice-axiom (wset e))
                    (dk-sep-parts! (list 'IN c (wset e)))
                    (dk-split-all!)
                    (cons a c))))
       (ptw (list 'FORALL 'mme_ (list 'IMPLIES '(IN mme_ ca) (list 'IN (mfl-mm-ift 'mme_) 'RR-POS-STAR))))
       (gclaim (list 'FORSOME 'gm_ (list 'AND '(IN gm_ (FUN ca RR-POS-STAR))
                 (list 'FORALL 'mme_ (list 'IMPLIES '(IN mme_ ca) (list '= '(gm_ mme_) (mfl-mm-ift 'mme_))))))))
  (dk-cite! 'pos-inf-in-rr-pos-star)
  ;; the pointwise typing of the body (it licenses the beta step that names the function)
  (dk-have! ptw
    (lambda ()
      (let ((e (dk-di-var!)))
        (dk-case-if! (mfl-mm-ift e)
          (lambda (t v)
            (if t
                (let* ((pr (choose! e)) (c (cdr pr)))
                  (mfl-sub-omega! c) (mfl-pow! c)
                  (dk-cite! 'fun-apply-type-c mfl-mio '(POWER omega) 'RR-POS-STAR c)
                  (dk-ass!))
                (dk-ass!)))))))
  ;; name the function: mm(E) = IF(E essentially in B_sigma, mu*(chosen witness), +inf)
  (dk-have! gclaim
    (lambda ()
      (ew mfl-mm)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (dk-lam-type! (lambda () (let ((e (dk-di-var!))) (dk-apply! ptw e) (dk-ass!))))
              (let ((e (dk-di-var!)))
                (dk-apply! ptw e)
                (if (not (dk-lam-b!)) (rfl))))))))
  (let* ((mm (dk-skolem! (dk-ctx-form gclaim)))
         (mve (list 'FORALL 'mme_ (list 'IMPLIES '(IN mme_ ca) (list '= (list mm 'mme_) (mfl-mm-ift 'mme_)))))
         (v1 (list 'FORALL 'es (list 'IMPLIES '(IN es ca)
                (list 'FORALL 'a (dk-curry (list (mfl-su 'a) '(SUBSET a es) (mfl-ln '(DIFFERENCE es a)))
                                   (list '= (list mm 'es) (list mfl-mio 'a)))))))
         (v2 (list 'FORALL 'es (list 'IMPLIES '(IN es ca)
                (list 'IMPLIES (list 'NOT (mfl-ess 'es)) (list '= (list mm 'es) 'POS-INF))))))
  ;; the values
  (dk-have! v1
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (e (cadr (cadr g0))) (a (cadr (caddr g0))))
        (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
        (dk-have! (mfl-ess e) (lambda () (ew a) (dk-conj-close! dk-ass!)))
        (dk-apply! mve e)
        (subst (list '= (list mm e) (mfl-mm-ift e)))
        (dk-if-branch! #t (mfl-mm-ift e) #f
          (lambda ()
            (let* ((pr (choose! e)) (c (cdr pr)))
              (dk-cite! 'essential-witness-agree 'omega 'ca 'cb 'rho e c a)
              (dk-ass!)))))))
  (dk-have! v2
    (lambda ()
      (dk-peel!)
      (let ((e (cadr (cadr (dk-goal)))))
        (dk-apply! mve e)
        (subst (list '= (list mm e) (mfl-mm-ift e)))
        (dk-if-branch! #f (mfl-mm-ift e) #f (lambda () (rfl))))))
  (ew mm)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ;; the extension property
          ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'lxe_))
           (let ((e (dk-di-var!)))
             (mfl-ca! e)
             (dk-cite! 'subset-refl e)
             (dk-cite! 'sigma-union-of-member 'omega 'ca 'cb 'rho e)
             (mfl-diff-ca! e e)
             (dk-have! (list 'SUBSET (list 'DIFFERENCE e e) 'EMPTY-SET)
               (lambda () (let ((w (subset-by-element!)))
                            (dk-iff-fwd! (dk-cite! 'difference-membership e e w))
                            (ai (list 'NOT (list 'IN w e))))))
             (dk-cite! 'locally-null-empty 'omega 'ca 'cb 'rho)
             (dk-cite! 'locally-null-subset 'omega 'ca 'cb 'rho 'EMPTY-SET (list 'DIFFERENCE e e))
             (dk-apply! v1 e e)
             (dk-cite! 'local-measure-outer-extends 'omega 'ca 'cb 'rho e)
             (subst (list '= (list mm e) (list mfl-mio e)))
             (dk-ass!)))
          ;; minimality
          ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'nu))
           (dk-peel!)
           (let* ((g1 (dk-goal)) (nu (car (caddr g1))) (e (cadr (caddr g1))))
             (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca nu))
             (dk-cite! 'fun-apply-type-c nu 'ca 'RR-POS-STAR e)
             (use-em (mfl-ess e)
               (lambda ()
                 (let* ((a (dk-skolem! (dk-ctx-form (mfl-ess e)))))
                   (dk-split-all!)
                   (dk-apply! v1 e a)
                   (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
                   (let* ((gseq (mfl-su-open! a)))
                     (dk-split-all! (list (dk-cite! 'local-measure-max-extension 'omega 'ca 'cb 'rho)))
                     (let ((agr (dk-cite! 'local-measure-extensions-agree 'omega 'ca 'cb 'rho mfl-mx nu gseq)))
                       (dk-rewrite-h! agr (mfl-bus gseq) a)
                       (dk-cite! 'restrict-apply mfl-mio 'ca a)
                       (dk-cite! 'measure-monotone 'omega 'ca nu a e)
                       (subst (list '= (list mm e) (list mfl-mio a)))
                       (subst (list '= (list mfl-mio a) (list mfl-mx a)))
                       (subst (list '= (list mfl-mx a) (list nu a)))
                       (dk-ass!)))))
               (lambda ()
                 (dk-apply! v2 e)
                 (subst (list '= (list mm e) 'POS-INF))
                 (dk-iff-fwd! (dk-cite! 'rr-pos-star-membership (list nu e)))
                 (dk-or-each! (list 'OR (list 'AND (list 'IN (list nu e) 'RR) (list '<= 0 (list nu e))) (list '= (list nu e) 'POS-INF))
                   (lambda (d)
                     (if (dk-head-is? d 'AND)
                         (begin
                           (dk-split-all! (list d))
                           (dk-cite! 'essential-of-finite-extension 'omega 'ca 'cb 'rho nu e)
                           (dk-have! (mfl-ess e)
                             (lambda () (let ((a (dk-skolem! (dk-ctx-form (list 'FORSOME 'a (mfl-wit e 'a))))))
                                          (dk-split-all!)
                                          (dk-cite! 'sigma-union-of-in-sigma 'omega 'ca 'cb 'rho a)
                                          (ew a) (dk-conj-close! dk-ass!))))
                           (ai (list 'NOT (mfl-ess e))))
                         (begin
                           (subst d)
                           (mfl-star! 'POS-INF)
                           (dk-cite! 'rr-star-leq-reflexive 'POS-INF)
                           (dk-ass!)))))))))
          ;; the values
          ((alpha-equiv? g v1) (dk-ass!))
          ((alpha-equiv? g v2) (dk-ass!))
          ;; countable additivity
          (#t
           (let* ((iff (dk-cite! 'is-measure 'omega 'ca mm)))
             (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
             (dk-cite! 'subset-refl 'EMPTY-SET)
             (dk-cite! 'sigma-union-of-member 'omega 'ca 'cb 'rho 'EMPTY-SET)
             (mfl-diff-ca! 'EMPTY-SET 'EMPTY-SET) (mfl-sub-diff! 'EMPTY-SET 'EMPTY-SET)
             (dk-cite! 'locally-null-empty 'omega 'ca 'cb 'rho)
             (dk-cite! 'locally-null-subset 'omega 'ca 'cb 'rho 'EMPTY-SET '(DIFFERENCE EMPTY-SET EMPTY-SET))
             (dk-apply! v1 'EMPTY-SET 'EMPTY-SET)
             (dk-cite! 'method-i-outer-is-outer-measure 'omega 'cb 'rho)
             (dk-iff-parts! (dk-cite! 'is-outer-measure 'omega mfl-mio))
             (dk-have! (list '= (list mm 'EMPTY-SET) 0)
               (lambda () (subst (list '= (list mm 'EMPTY-SET) (list mfl-mio 'EMPTY-SET))) (dk-ass!)))
             (let ((add-goal (let loop ((r (caddr iff))) (if (dk-head-is? r 'AND) (loop (caddr r)) r))))
               (dk-have! add-goal (lambda () (mfl-min-additive! mm v1 v2 choose!)))
               (dk-have-and! '(IS-SIGMA-ALGEBRA omega ca) (list 'IN mm '(FUN ca RR-POS-STAR)) (list '= (list mm 'EMPTY-SET) 0) add-goal)
               (dk-iff-bwd! iff)
               (dk-ass!))))))))))
(mfl-qed! 'local-measure-min-extension)
