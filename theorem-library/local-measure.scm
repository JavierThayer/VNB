;; Prop 4.17: two extensions of rho to ca agree on countable unions of members of cb
(define mfl-ext-mu '(FORALL lxe_ (IMPLIES (IN lxe_ cb) (= (mu lxe_) (rho lxe_)))))
(define (mfl-dj k) (list 'COMPLEMENT-IN (list 'g k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) '(g uj_))))
(sp (make-wff (dk-foralls '(omega ca cb rho mu nu g) (dk-curry
  (list mfl-lm '(IS-MEASURE omega ca mu) '(IS-MEASURE omega ca nu) mfl-ext-mu mfl-ext-nu '(IN g (FUN NN cb)))
  '(= (mu (BIG-UNION sun_ NN (g sun_))) (nu (BIG-UNION sun_ NN (g sun_))))))))
(dk-peel!)
(mfl-parts!)
(let* ((mup (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca 'mu)))
       (nup (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca 'nu)))
       (dummy (dk-cite! 'fun-codomain-superset 'g 'NN 'cb 'ca))
       (ab (dk-abstract! 'NN 'cb mfl-dj
             (lambda (k)
               (dk-cite! 'disjointed-seq-in-sigma 'omega 'ca 'g k)
               (dk-cite! 'complement-in-subset (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) '(g uj_)) (list 'g k))
               (dk-cite! 'fun-apply-type-c 'g 'NN 'cb k)
               (mfl-cb! (mfl-dj k) (list 'g k))
               (dk-ass!))))
       (df (car ab)) (dve (cdr ab))
       (bug '(BIG-UNION sun_ NN (g sun_)))
       (bud (list 'BIG-UNION 'n_ 'NN (list df 'n_)))
       (fmu (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list df 'n_))))
       (fnu (list 'VNB-LAMBDA 'n_ 'NN (list 'nu (list df 'n_)))))
  (dk-cite! 'fun-codomain-superset df 'NN 'cb 'ca)
  ;; the union is unchanged
  (dk-class-ext! bug bud
    (lambda (w)
      (let* ((r (dk-bu-open! w bug)) (k (car r))
             (m (dk-skolem! (dk-cite! 'disjointed-seq-cover 'omega 'ca 'g w k))))
        (dk-apply! dve m)
        (dk-have! (list 'IN w (list df m)) (lambda () (subst (list '= (list df m) (mfl-dj m))) (dk-ass!)))
        (dk-bu-close! m)))
    (lambda (w)
      (let* ((r (dk-bu-open! w bud)) (k (car r)))
        (dk-apply! dve k)
        (dk-rewrite-h! (list 'IN w (list df k)) (list df k) (mfl-dj k))
        (dk-iff-fwd! (dk-cite! 'complement-in-membership (list 'g k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) '(g uj_)) w))
        (dk-bu-close! k))))
  ;; the pieces are pairwise disjoint
  (dk-have! (list 'FORALL 'i_ (list 'FORALL 'j_ (list 'IMPLIES '(IN i_ NN) (list 'IMPLIES '(IN j_ NN)
              (list 'IMPLIES '(NOT (= i_ j_)) (list '= (list 'INTERSECTION (list df 'i_) (list df 'j_)) 'EMPTY-SET))))))
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (i (cadr (cadr (cadr g0)))) (j (cadr (caddr (cadr g0)))))
        (dk-class-ext! (list 'INTERSECTION (list df i) (list df j)) 'EMPTY-SET
          (lambda (w)
            (dk-iff-fwd! (dk-cite! 'intersection-membership (list df i) (list df j) w))
            (dk-apply! dve i) (dk-apply! dve j)
            (dk-rewrite-h! (list 'IN w (list df i)) (list df i) (mfl-dj i))
            (dk-rewrite-h! (list 'IN w (list df j)) (list df j) (mfl-dj j))
            (dk-cite! 'disjointed-seq-unique 'omega 'ca 'g w i j)
            (ai (list 'NOT (list '= i j))))
          (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
        (dk-ass!))))
  (dk-apply! (list-ref mup 3) df)
  (dk-apply! (list-ref nup 3) df)
  (mfl-rps-fun! fmu (lambda (k) (dk-cite! 'fun-apply-type-c df 'NN 'ca k) (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR (list df k))))
  (mfl-rps-fun! fnu (lambda (k) (dk-cite! 'fun-apply-type-c df 'NN 'ca k) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-POS-STAR (list df k))))
  (for-each
    (lambda (pr)
      (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list (car pr) 'k) (list (cdr pr) 'k))))
        (lambda ()
          (let ((k (dk-di-var!)))
            (dk-lam-b!)
            (dk-cite! 'fun-apply-type-c df 'NN 'cb k)
            (dk-apply! mfl-ext-mu (list df k))
            (dk-apply! mfl-ext-nu (list df k))
            (subst (list '= (list 'mu (list df k)) (list 'rho (list df k))))
            (subst (list '= (list 'nu (list df k)) (list 'rho (list df k))))
            (mfl-ty! (list df k)) (mfl-star! (list 'rho (list df k)))
            (dk-cite! 'rr-star-leq-reflexive (list 'rho (list df k)))
            (dk-ass!))))
      (dk-cite! 'esum-nn-le-termwise (car pr) (cdr pr)))
    (list (cons fmu fnu) (cons fnu fmu)))
  (mfl-esum-ty! fmu) (mfl-esum-ty! fnu)
  (mfl-antisym! (list 'ESUM fmu) (list 'ESUM fnu))
  (subst (list '= bug bud))
  (subst (list '= (list 'mu bud) (list 'ESUM fmu)))
  (subst (list '= (list 'nu bud) (list 'ESUM fnu)))
  (dk-ass!))
