(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mfl-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFL OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define mfl-meas-all #f)
(define mfl-her-all #f)
(define (mfl-parts!)
  (let* ((p (dk-iff-parts! (dk-cite! 'is-local-measure 'omega 'ca 'cb 'rho)))
         (h (dk-iff-parts! (dk-cite! 'is-hereditary 'ca 'cb))))
    (set! mfl-meas-all (list-ref p 3))
    (set! mfl-her-all (list-ref h 1))
    (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)))
(define (mfl-rs e) (list 'RESTRICT-SIGMA 'ca e))
(define (mfl-me e) (list 'RESTRICT 'rho (mfl-rs e)))
(define (mfl-meas! e) (dk-apply! mfl-meas-all e))
(define (mfl-ca! a) (if (not (dk-asm? (list 'IN a 'ca))) (dk-cite! 'subset-mem-fwd 'cb 'ca a)))
(define (mfl-cb! a e) (if (not (dk-asm? (list 'IN a 'cb))) (dk-apply! mfl-her-all e a)))
(define (mfl-rs! e a)
  (if (not (dk-asm? (list 'IN a (mfl-rs e))))
      (dk-have! (list 'IN a (mfl-rs e))
        (lambda () (mac 'RESTRICT-SIGMA) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
(define (mfl-rv! e a) (dk-cite! 'restrict-apply 'rho (mfl-rs e) a))
(define (mfl-ty! a) (if (not (dk-asm? (list 'IN (list 'rho a) 'RR-POS-STAR))) (dk-cite! 'fun-apply-type-c 'rho 'cb 'RR-POS-STAR a)))
(define (mfl-sub-inter! a b side)
  (let ((goal (list 'SUBSET (list 'INTERSECTION a b) (if (eq? side 'left) a b))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda () (let ((w (subset-by-element!)))
                       (dk-iff-fwd! (dk-cite! 'intersection-membership a b w))
                       (dk-ass!)))))))
(define (mfl-sub-diff! a b)
  (let ((goal (list 'SUBSET (list 'DIFFERENCE a b) a)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda () (let ((w (subset-by-element!)))
                       (dk-iff-fwd! (dk-cite! 'difference-membership a b w))
                       (dk-ass!)))))))
;; (IN x ca) for x = a n b, a \ b with a, b in ca
(define (mfl-inter-ca! a b) (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca a b))
(define (mfl-diff-ca! a b)
  (if (not (dk-asm? (list 'IN (list 'DIFFERENCE a b) 'ca)))
      (let ((u (dk-cite! 'difference-unfold a b)))
        (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca a b)
        (dk-have! (list 'IN (list 'DIFFERENCE a b) 'ca) (lambda () (subst (list '= (list 'DIFFERENCE a b) (caddr u))) (dk-ass!))))))
;; f in FUN(NN, RR-POS-STAR) in context: land (IN (ESUM f) RR-POS-STAR)
(define (mfl-esum-ty! f)
  (if (not (dk-asm? (list 'IN (list 'ESUM f) 'RR-POS-STAR)))
      (begin
        (fact 'nn-is-set)
        (dk-project! (list 'IN f '(FUN NN)) 'fun-codomain-iff (list 'IN f '(FUN NN RR-POS-STAR)))
        (dk-have! (list 'AND (list 'IN f '(FUN NN)) '(IN NN SET)) (lambda () (dk-conj-close! dk-ass!)))
        (dk-split-all! (list (dk-cite! 'dom-of-fun 'NN f)))
        (dk-have! (list 'IN f (list 'FUN (list 'DOM f) 'RR-POS-STAR)) (lambda () (subst (list '= (list 'DOM f) 'NN)) (dk-ass!)))
        (dk-cite! 'esum-in f))))
;; x subset omega in context: land (IN x (POWER omega))
(define (mfl-pow! x)
  (if (not (dk-asm? (list 'IN x '(POWER omega))))
      (begin
        (dk-cite! 'subclass-of-set-is-set x 'omega)
        (dk-iff-fwd! (dk-cite! 'subset-def x 'omega))
        (dk-have-and! (list 'IN x 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z x) '(IN z omega))))
        (dk-iff-bwd! (dk-cite! 'power-set-membership 'omega x)))))
;; a in ca: land (SUBSET a omega)
(define (mfl-sub-omega! a)
  (if (not (dk-asm? (list 'SUBSET a 'omega)))
      (begin
        (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
        (dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
        (dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) a)
        (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega a))
        (dk-iff-bwd! (dk-cite! 'subset-def a 'omega)))))

(define mfl-lm '(IS-LOCAL-MEASURE omega ca cb rho))

;; ---------------------------------------------------------------------------
;; rho is monotone on cb
(sp (make-wff (dk-foralls '(omega ca cb rho a e) (dk-curry (list mfl-lm '(IN e cb) '(IN a cb) '(SUBSET a e))
  '(<= (rho a) (rho e))))))
(dk-peel!)
(mfl-parts!)
(mfl-ca! 'a) (mfl-ca! 'e)
(dk-cite! 'subset-refl 'e)
(mfl-rs! 'e 'a) (mfl-rs! 'e 'e)
(mfl-meas! 'e)
(let ((f1 (dk-cite! 'measure-monotone 'e (mfl-rs 'e) (mfl-me 'e) 'a 'e)))
  (mfl-rv! 'e 'a) (mfl-rv! 'e 'e)
  (let* ((f2 (dk-rewrite-h! f1 (list (mfl-me 'e) 'a) '(rho a))))
    (dk-rewrite-h! f2 (list (mfl-me 'e) 'e) '(rho e))
    (dk-ass!)))
(mfl-qed! 'local-measure-monotone)

;; ---------------------------------------------------------------------------
;; e in cb covered by a sequence in cb: rho(e) <= sum rho(aa k)
(define mfl-cover-bu '(BIG-UNION cvn_ NN (aa cvn_)))
(define mfl-fa '(VNB-LAMBDA cvk_ NN (rho (aa cvk_))))
(define (mfl-rps-fun! f typer)
  (dk-have! (list 'IN f '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (typer k) (dk-ass!)))))))
(define (mfl-star! t)
  (if (not (dk-asm? (list 'IN t 'RR-STAR)))
      (begin (fact 'rr-pos-star-subset-rr-star) (dk-cite! 'subset-mem-fwd 'RR-POS-STAR 'RR-STAR t))))
;; a <= b <= c, all three in RR-POS-STAR in context
(define (mfl-trans! a b c)
  (mfl-star! a) (mfl-star! b) (mfl-star! c)
  (dk-have-and! (list 'IN a 'RR-STAR) (list 'IN b 'RR-STAR) (list 'IN c 'RR-STAR))
  (dk-have-and! (list '<= a b) (list '<= b c))
  (dk-cite! 'rr-star-leq-transitive a b c))
(define (mfl-antisym! a b)
  (mfl-star! a) (mfl-star! b)
  (dk-have-and! (list 'IN a 'RR-STAR) (list 'IN b 'RR-STAR))
  (dk-have-and! (list '<= a b) (list '<= b a))
  (dk-cite! 'rr-star-leq-antisymmetric a b))
(sp (make-wff (dk-foralls '(omega ca cb rho e aa) (dk-curry (list mfl-lm '(IN e cb) '(IN aa (FUN NN cb)) (list 'SUBSET 'e mfl-cover-bu))
  (list '<= '(rho e) (list 'ESUM mfl-fa))))))
(dk-peel!)
(mfl-parts!)
(mfl-ca! 'e)
(mfl-meas! 'e)
(let* ((rs (mfl-rs 'e)) (me (mfl-me 'e))
       (mparts (dk-iff-parts! (dk-cite! 'is-measure 'e rs me)))
       (ib (lambda (k) (list 'INTERSECTION (list 'aa k) 'e)))
       (ab (dk-abstract! 'NN rs ib
             (lambda (k)
               (dk-cite! 'fun-apply-type-c 'aa 'NN 'cb k)
               (mfl-ca! (list 'aa k))
               (mfl-inter-ca! (list 'aa k) 'e)
               (mfl-sub-inter! (list 'aa k) 'e 'right)
               (mfl-rs! 'e (ib k))
               (dk-ass!))))
       (bf (car ab)) (bve (cdr ab))
       (bub (list 'BIG-UNION 'n_ 'NN (list bf 'n_)))
       (fb (list 'VNB-LAMBDA 'n_ 'NN (list me (list bf 'n_)))))
  (let ((sub (dk-cite! 'measure-countably-subadditive 'e rs me bf)))
    (dk-class-ext! bub 'e
      (lambda (w)
        (let* ((r (dk-bu-open! w bub)) (k (car r)))
          (dk-apply! bve k)
          (dk-rewrite-h! (list 'IN w (list bf k)) (list bf k) (ib k))
          (dk-iff-fwd! (dk-cite! 'intersection-membership (list 'aa k) 'e w))
          (dk-ass!)))
      (lambda (w)
        (dk-cite! 'subset-mem-fwd 'e mfl-cover-bu w)
        (let* ((r (dk-bu-open! w mfl-cover-bu)) (k (car r)))
          (dk-apply! bve k)
          (dk-have! (list 'IN w (list bf k))
            (lambda ()
              (subst (list '= (list bf k) (ib k)))
              (dk-have-and! (list 'IN w (list 'aa k)) (list 'IN w 'e))
              (dk-iff-bwd! (dk-cite! 'intersection-membership (list 'aa k) 'e w))
              (dk-ass!)))
          (dk-bu-close! k))))
    (dk-cite! 'subset-refl 'e)
    (mfl-rs! 'e 'e)
    (mfl-rv! 'e 'e)
    (let* ((sub1 (dk-rewrite-h! sub bub 'e))
           (sub2 (dk-rewrite-h! sub1 (list me 'e) '(rho e))))
      (mfl-rps-fun! fb (lambda (k) (dk-cite! 'fun-apply-type-c bf 'NN rs k)
                                   (dk-cite! 'fun-apply-type-c me rs 'RR-POS-STAR (list bf k))))
      (mfl-rps-fun! mfl-fa (lambda (k) (dk-cite! 'fun-apply-type-c 'aa 'NN 'cb k) (mfl-ty! (list 'aa k))))
      (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list fb 'k) (list mfl-fa 'k))))
        (lambda ()
          (let* ((k (dk-di-var!)) (ak (list 'aa k)) (ik (ib k)))
            (dk-lam-b!)
            (dk-apply! bve k)
            (subst (list '= (list bf k) ik))
            (dk-cite! 'fun-apply-type-c 'aa 'NN 'cb k)
            (mfl-ca! ak)
            (mfl-inter-ca! ak 'e)
            (mfl-sub-inter! ak 'e 'right)
            (mfl-sub-inter! ak 'e 'left)
            (mfl-rs! 'e ik)
            (mfl-rv! 'e ik)
            (subst (list '= (list me ik) (list 'rho ik)))
            (mfl-cb! ik ak)
            (dk-cite! 'local-measure-monotone 'omega 'ca 'cb 'rho ik ak)
            (dk-ass!))))
      (dk-cite! 'esum-nn-le-termwise fb mfl-fa)
      (mfl-ty! 'e) (mfl-esum-ty! fb) (mfl-esum-ty! mfl-fa)
      (mfl-trans! '(rho e) (list 'ESUM fb) (list 'ESUM mfl-fa))
      (dk-ass!))))
(mfl-qed! 'local-measure-cover-le)

;; ---------------------------------------------------------------------------
;; with the empty set in cb, rho is a pre-measure on cb
(sp (make-wff (dk-foralls '(omega ca cb rho) (dk-curry (list mfl-lm '(IN EMPTY-SET cb))
  '(IS-PREMEASURE omega cb rho)))))
(dk-peel!)
(mfl-parts!)
(dk-have! '(SUBSET cb (POWER omega))
  (lambda () (let ((w (subset-by-element!))) (mfl-ca! w) (mfl-sub-omega! w) (mfl-pow! w) (dk-ass!))))
(mfl-meas! 'EMPTY-SET)
(dk-iff-parts! (dk-cite! 'is-measure 'EMPTY-SET (mfl-rs 'EMPTY-SET) (mfl-me 'EMPTY-SET)))
(dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
(dk-cite! 'subset-refl 'EMPTY-SET)
(mfl-rs! 'EMPTY-SET 'EMPTY-SET)
(mfl-rv! 'EMPTY-SET 'EMPTY-SET)
(dk-rewrite-h! (list '= (list (mfl-me 'EMPTY-SET) 'EMPTY-SET) 0) (list (mfl-me 'EMPTY-SET) 'EMPTY-SET) '(rho EMPTY-SET))
(dk-have-and! '(IN omega SET) '(SUBSET cb (POWER omega)) '(IN EMPTY-SET cb) '(IN rho (FUN cb RR-POS-STAR)) '(= (rho EMPTY-SET) 0))
(dk-iff-bwd! (dk-cite! 'is-premeasure 'omega 'cb 'rho))
(dk-ass!)
(mfl-qed! 'local-measure-premeasure)

(define mfl-mio '(METHOD-I-OUTER omega cb rho))
(define (mfl-cs x) (list 'COVER-SUMS 'omega 'cb 'rho x))
(define (mfl-ein x) (list 'EINF (mfl-cs x)))
(define (mfl-pre!)
  (dk-cite! 'local-measure-premeasure 'omega 'ca 'cb 'rho)
  (dk-iff-parts! (dk-cite! 'is-premeasure 'omega 'cb 'rho)))
;; open a cover sum v of x: returns the sequence; (= v (ESUM ...)) and the cover land
(define (mfl-cover-open! x v)
  (let ((sq (dk-skolem! (dk-cite! 'cover-sums-elim 'omega 'cb 'rho x v))))
    (dk-split-all!)
    sq))

;; ---------------------------------------------------------------------------
;; Prop 4.16 (1): the method I outer measure of rho extends rho
(sp (make-wff (dk-foralls '(omega ca cb rho e) (dk-curry (list mfl-lm '(IN EMPTY-SET cb) '(IN e cb))
  (list '= (list mfl-mio 'e) '(rho e))))))
(dk-peel!)
(mfl-parts!)
(mfl-pre!)
(dk-cite! 'subset-mem-fwd 'cb '(POWER omega) 'e)
(dk-cite! 'method-i-outer-value 'omega 'cb 'rho 'e)
(dk-cite! 'subset-refl 'e)
(dk-cite! 'method-i-outer-le-single 'omega 'cb 'rho 'e 'e)
(dk-cite! 'cover-sums-subset 'omega 'cb 'rho 'e)
(mfl-ty! 'e)
(dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ (mfl-cs 'e)) '(<= (rho e) cpsx_)))
  (lambda ()
    (let* ((v (dk-di-var!))
           (sq (mfl-cover-open! 'e v))
           (es (list 'ESUM (list 'VNB-LAMBDA 'cvk_ 'NN (list 'rho (list sq 'cvk_))))))
      (dk-cite! 'local-measure-cover-le 'omega 'ca 'cb 'rho 'e sq)
      (subst (list '= v es))
      (dk-ass!))))
(dk-cite! 'einf-greatest (mfl-cs 'e) '(rho e))
(dk-cite! 'einf-in (mfl-cs 'e))
(mfl-antisym! (mfl-ein 'e) '(rho e))
(subst (list '= (list mfl-mio 'e) (mfl-ein 'e)))
(dk-ass!)
(mfl-qed! 'local-measure-outer-extends)

;; ---------------------------------------------------------------------------
;; Prop 4.16 (2): every member of ca is Caratheodory measurable for the method I outer measure
(define (mfl-sub-omega-of! x a)   ; (SUBSET x a), (SUBSET a omega) in context
  (if (not (dk-asm? (list 'SUBSET x 'omega))) (dk-cite! 'subset-trans x a 'omega)))
(sp (make-wff (dk-foralls '(omega ca cb rho es) (dk-curry (list mfl-lm '(IN EMPTY-SET cb) '(IN es ca))
  (list 'IS-CARATHEODORY-MEASURABLE 'omega mfl-mio 'es)))))
(dk-peel!)
(mfl-parts!)
(mfl-pre!)
(dk-cite! 'method-i-outer-is-outer-measure 'omega 'cb 'rho)
(mfl-sub-omega! 'es)
(dk-have! (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ (POWER omega))
            (list '<= (list 'EPLUS (list mfl-mio '(INTERSECTION a_ es)) (list mfl-mio '(DIFFERENCE a_ es))) (list mfl-mio 'a_))))
  (lambda ()
    (let* ((a (dk-di-var!)) (ia (list 'INTERSECTION a 'es)) (da (list 'DIFFERENCE a 'es))
           (lhs (list 'EPLUS (mfl-ein ia) (mfl-ein da))))
      (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega a))
      (dk-iff-bwd! (dk-cite! 'subset-def a 'omega))
      (mfl-sub-inter! a 'es 'left) (mfl-sub-diff! a 'es)
      (mfl-sub-omega-of! ia a) (mfl-sub-omega-of! da a)
      (mfl-pow! ia) (mfl-pow! da)
      (for-each (lambda (x) (dk-cite! 'method-i-outer-value 'omega 'cb 'rho x)
                            (dk-cite! 'cover-sums-subset 'omega 'cb 'rho x)
                            (dk-cite! 'einf-in (mfl-cs x)))
                (list a ia da))
      (dk-have-and! (list 'IN (mfl-ein ia) 'RR-POS-STAR) (list 'IN (mfl-ein da) 'RR-POS-STAR))
      (dk-cite! 'eplus-closed (mfl-ein ia) (mfl-ein da))
      (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ (mfl-cs a)) (list '<= lhs 'cpsx_)))
        (lambda ()
          (let* ((v (dk-di-var!))
                 (sq (mfl-cover-open! a v))
                 (bus (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)))
                 (ik (lambda (k) (list 'INTERSECTION (list sq k) 'es)))
                 (dk_ (lambda (k) (list 'DIFFERENCE (list sq k) 'es)))
                 (abp (dk-abstract! 'NN 'cb ik
                        (lambda (k) (dk-cite! 'fun-apply-type-c sq 'NN 'cb k) (mfl-ca! (list sq k))
                                    (mfl-inter-ca! (list sq k) 'es) (mfl-sub-inter! (list sq k) 'es 'left)
                                    (mfl-cb! (ik k) (list sq k)) (dk-ass!))))
                 (pf (car abp)) (pve (cdr abp))
                 (abq (dk-abstract! 'NN 'cb dk_
                        (lambda (k) (dk-cite! 'fun-apply-type-c sq 'NN 'cb k) (mfl-ca! (list sq k))
                                    (mfl-diff-ca! (list sq k) 'es) (mfl-sub-diff! (list sq k) 'es)
                                    (mfl-cb! (dk_ k) (list sq k)) (dk-ass!))))
                 (qf (car abq)) (qve (cdr abq))
                 (fp (list 'VNB-LAMBDA 'cvk_ 'NN (list 'rho (list pf 'cvk_))))
                 (fq (list 'VNB-LAMBDA 'cvk_ 'NN (list 'rho (list qf 'cvk_))))
                 (fa (list 'VNB-LAMBDA 'cvk_ 'NN (list 'rho (list sq 'cvk_)))))
            ;; the pieces cover a n es and a \ es
            (dk-have! (list 'SUBSET ia (list 'BIG-UNION 'cvn_ 'NN (list pf 'cvn_)))
              (lambda ()
                (let ((w (subset-by-element!)))
                  (dk-iff-fwd! (dk-cite! 'intersection-membership a 'es w))
                  (dk-cite! 'subset-mem-fwd a bus w)
                  (let* ((r (dk-bu-open! w bus)) (k (car r)))
                    (dk-apply! pve k)
                    (dk-have! (list 'IN w (list pf k))
                      (lambda () (subst (list '= (list pf k) (ik k)))
                                 (dk-have-and! (list 'IN w (list sq k)) (list 'IN w 'es))
                                 (dk-iff-bwd! (dk-cite! 'intersection-membership (list sq k) 'es w))
                                 (dk-ass!)))
                    (dk-bu-close! k)))))
            (dk-have! (list 'SUBSET da (list 'BIG-UNION 'cvn_ 'NN (list qf 'cvn_)))
              (lambda ()
                (let ((w (subset-by-element!)))
                  (dk-iff-fwd! (dk-cite! 'difference-membership a 'es w))
                  (dk-cite! 'subset-mem-fwd a bus w)
                  (let* ((r (dk-bu-open! w bus)) (k (car r)))
                    (dk-apply! qve k)
                    (dk-have! (list 'IN w (list qf k))
                      (lambda () (subst (list '= (list qf k) (dk_ k)))
                                 (dk-have-and! (list 'IN w (list sq k)) (list 'NOT (list 'IN w 'es)))
                                 (dk-iff-bwd! (dk-cite! 'difference-membership (list sq k) 'es w))
                                 (dk-ass!)))
                    (dk-bu-close! k)))))
            (dk-cite! 'cover-sums-intro 'omega 'cb 'rho ia pf)
            (dk-cite! 'cover-sums-intro 'omega 'cb 'rho da qf)
            (dk-apply! (dk-cite! 'einf-lower (mfl-cs ia)) (list 'ESUM fp))
            (dk-apply! (dk-cite! 'einf-lower (mfl-cs da)) (list 'ESUM fq))
            (mfl-rps-fun! fp (lambda (k) (dk-cite! 'fun-apply-type-c pf 'NN 'cb k) (mfl-ty! (list pf k))))
            (mfl-rps-fun! fq (lambda (k) (dk-cite! 'fun-apply-type-c qf 'NN 'cb k) (mfl-ty! (list qf k))))
            (mfl-rps-fun! fa (lambda (k) (dk-cite! 'fun-apply-type-c sq 'NN 'cb k) (mfl-ty! (list sq k))))
            ;; termwise: rho(s n es) + rho(s \ es) <= rho(s)
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list 'EPLUS (list fp 'k) (list fq 'k)) (list fa 'k))))
              (lambda ()
                (let* ((k (dk-di-var!)) (sk (list sq k)) (i (ik k)) (d (dk_ k))
                       (rs (mfl-rs sk)) (me (mfl-me sk)))
                  (dk-lam-b!)
                  (dk-apply! pve k) (dk-apply! qve k)
                  (subst (list '= (list pf k) i))
                  (subst (list '= (list qf k) d))
                  (dk-cite! 'fun-apply-type-c sq 'NN 'cb k)
                  (mfl-ca! sk)
                  (mfl-inter-ca! sk 'es) (mfl-diff-ca! sk 'es)
                  (mfl-sub-inter! sk 'es 'left) (mfl-sub-diff! sk 'es)
                  (dk-cite! 'subset-refl sk)
                  (mfl-rs! sk i) (mfl-rs! sk d) (mfl-rs! sk sk)
                  (mfl-meas! sk)
                  (dk-class-ext! (list 'INTERSECTION i d) 'EMPTY-SET
                    (lambda (w)
                      (dk-iff-fwd! (dk-cite! 'intersection-membership i d w))
                      (dk-iff-fwd! (dk-cite! 'intersection-membership sk 'es w))
                      (dk-iff-fwd! (dk-cite! 'difference-membership sk 'es w))
                      (ai (list 'NOT (list 'IN w 'es))))
                    (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
                  (dk-class-ext! (list 'UNION i d) sk
                    (lambda (w)
                      (dk-iff-fwd! (dk-cite! 'union-membership i d w))
                      (dk-or-each! (list 'OR (list 'IN w i) (list 'IN w d))
                        (lambda (o)
                          (if (equal? o (list 'IN w i))
                              (dk-iff-fwd! (dk-cite! 'intersection-membership sk 'es w))
                              (dk-iff-fwd! (dk-cite! 'difference-membership sk 'es w)))
                          (dk-ass!))))
                    (lambda (w)
                      (use-em (list 'IN w 'es)
                        (lambda ()
                          (dk-have-and! (list 'IN w sk) (list 'IN w 'es))
                          (dk-iff-bwd! (dk-cite! 'intersection-membership sk 'es w))
                          (dk-have! (list 'OR (list 'IN w i) (list 'IN w d)) (lambda () (oi-l) (dk-ass!)))
                          (dk-iff-bwd! (dk-cite! 'union-membership i d w))
                          (dk-ass!))
                        (lambda ()
                          (dk-have-and! (list 'IN w sk) (list 'NOT (list 'IN w 'es)))
                          (dk-iff-bwd! (dk-cite! 'difference-membership sk 'es w))
                          (dk-have! (list 'OR (list 'IN w i) (list 'IN w d)) (lambda () (oi-r) (dk-ass!)))
                          (dk-iff-bwd! (dk-cite! 'union-membership i d w))
                          (dk-ass!)))))
                  (let* ((add (dk-cite! 'measure-finitely-additive sk rs me i d))
                         (add1 (dk-rewrite-h! add (list 'UNION i d) sk)))
                    (mfl-rv! sk sk) (mfl-rv! sk i) (mfl-rv! sk d)
                    (let* ((add2 (dk-rewrite-h! add1 (list me sk) (list 'rho sk)))
                           (add3 (dk-rewrite-h! add2 (list me i) (list 'rho i)))
                           (add4 (dk-rewrite-h! add3 (list me d) (list 'rho d))))
                      (subst (list '= (list 'EPLUS (list 'rho i) (list 'rho d)) (list 'rho sk)))
                      (mfl-ty! sk) (mfl-star! (list 'rho sk))
                      (dk-cite! 'rr-star-leq-reflexive (list 'rho sk))
                      (dk-ass!))))))
            (dk-cite! 'esum-nn-superadditive fp fq fa)
            (mfl-esum-ty! fp) (mfl-esum-ty! fq)
            (dk-have-and! (list 'IN (mfl-ein ia) 'RR-POS-STAR) (list 'IN (mfl-ein da) 'RR-POS-STAR)
                          (list 'IN (list 'ESUM fp) 'RR-POS-STAR) (list 'IN (list 'ESUM fq) 'RR-POS-STAR))
            (dk-have-and! (list '<= (mfl-ein ia) (list 'ESUM fp)) (list '<= (mfl-ein da) (list 'ESUM fq)))
            (dk-cite! 'eplus-mono (mfl-ein ia) (mfl-ein da) (list 'ESUM fp) (list 'ESUM fq))
            (dk-have-and! (list 'IN (list 'ESUM fp) 'RR-POS-STAR) (list 'IN (list 'ESUM fq) 'RR-POS-STAR))
            (dk-cite! 'eplus-closed (list 'ESUM fp) (list 'ESUM fq))
            (mfl-esum-ty! fa)
            (mfl-trans! lhs (list 'EPLUS (list 'ESUM fp) (list 'ESUM fq)) (list 'ESUM fa))
            (subst (list '= v (list 'ESUM fa)))
            (dk-ass!))))
      (dk-cite! 'einf-greatest (mfl-cs a) lhs)
      (subst (list '= (list mfl-mio a) (mfl-ein a)))
      (subst (list '= (list mfl-mio ia) (mfl-ein ia)))
      (subst (list '= (list mfl-mio da) (mfl-ein da)))
      (dk-ass!))))
(dk-cite! 'caratheodory-superadditive-suffices 'omega mfl-mio 'es)
