(qed 'rn-partials-estimate-trunc)

;;; (3) PROPOSITION 2.29.  f on the open set U of E = R^n (sup norm), with partial derivatives
;;; d_(e_i) f(x) = p(i)(x) defined and continuous at every x in U: for every eps > 0 there is
;;; a delta > 0 with
;;;     |f(a + eta) - f(a) - sum_(i=1..n) eta_i d_(e_i) f(a)| <= ||eta|| eps
;;; whenever ||eta|| <= delta.
(define c29-E2 '(NVS-METRIC-SPACE (RN n)))
(sp (make-wff (forall-guarded '(n u f p a)
  (list '(IN n NN)
        (list 'IS-OPEN c29-E2 'u)
        '(IN f (FUN u RR))
        '(IN a u)
        '(FORALL i (IMPLIES (IN i (INTERVAL 1 n)) (FORALL x (IMPLIES (IN x u)
            (HAS-DIR-DERIV (RN n) f x (RN-UNIT n i) ((p i) x))))))
        (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'x (list 'IMPLIES '(IN x u)
            (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS c29-E2 'u) 'RR-MS '(p i) 'x))))))
  '(FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME delta (AND (POS-RR delta)
       (FORALL eta (IMPLIES (IN eta (VEC (RN n))) (IMPLIES (<= ((VNRM (RN n)) eta) delta)
         (<= (abs (- (- (f ((VADD (RN n)) a eta)) (f a))
                     (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                             (VNB-LAMBDA i (INTERVAL 1 n) (* (eta i) ((p i) a))) (INTERVAL 1 n))))
             (* ((VNRM (RN n)) eta) eps))))))))))))
;;; the typing of the left side: f(a + eta), f(a) and the sum are reals
(define c29f-hC #f)
(define (c29f-type-x! nrm)
  (let* ((E c29-E2) (SUB (list 'SUBSPACE-MS c29-E2 'u)) (V '(FUN (INTERVAL 1 n) RR))
         (pt '((VADD (RN n)) a eta)))
    (dk-cite! 'rn-is-normed-vector-space 'n)
    (dk-cite! 'nvs-metric-is-ms '(RN n))
    (dk-cite! 'nvs-ms-pts '(RN n))
    (fact 'r7q-rr-pts)
    (dk-project! (list 'SUBSET 'u (list 'PTS E)) (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN E 'u))))
    (dk-cite! 'subset-mem-fwd 'u (list 'PTS E) 'a)
    (dk-have! '(IN a (VEC (RN n))) (lambda () (subst (list '= '(VEC (RN n)) (list 'PTS E))) (ass)))
    (dk-have! (list 'IN 'a V) (lambda () (subst (list '= V '(VEC (RN n)))) (ass)))
    (dk-cite! 'nvs-vadd-in-vec '(RN n) 'a 'eta)
    (dk-have! (list 'IN pt (list 'PTS E)) (lambda () (subst (list '= (list 'PTS E) '(VEC (RN n)))) (ass)))
    (dk-cite! 'metric-dist-real E 'a pt)
    (let ((de (dk-cite! 'nvs-dist-shift '(RN n) 'a 'eta)))
      (dk-cite! 'rr-pos-rr-in-rr c29-r)
      (dk-have! (list '< nrm c29-r) (lambda () (dk-ineq! (list '<= nrm c29-dl) (list '< c29-dl c29-r))))
      (dk-have! (list 'AND (list 'IN pt (list 'PTS E)) (list 'AND (list 'IN nrm 'RR) (list 'AND (list 'IN c29-r 'RR)
                  (list 'AND (list '<= (list (list 'DIST E) 'a pt) nrm) (list '< nrm c29-r)))))
        (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '<=) (dk-ineq! de) (ass))))))
      (dk-cite! 'ball-mem-from-le E 'a pt nrm c29-r)
      (dk-cite! 'subset-mem-fwd (list 'BALL E 'a c29-r) 'u pt)
      (c29-and! '(IN f (FUN u RR)) (list 'IN pt 'u))
      (dk-cite! 'fun-apply-type 'f 'u 'RR pt)
      (c29-and! '(IN f (FUN u RR)) '(IN a u))
      (dk-cite! 'fun-apply-type 'f 'u 'RR 'a))
    ;; the sum
    (fact 'interval-in-set 1 'n)
    (dk-cite! 'interval-card-in-nn 1 'n)
    (let ((Fi '(VNB-LAMBDA i (INTERVAL 1 n) (* (eta i) ((p i) a)))))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 n)) (list 'IN (list Fi 'z_) 'RR)))
        (lambda ()
          (let* ((z (dk-di-var!)))
            (dk-lam-b!)
            (c29-and! (list 'IN 'eta V) (list 'IN z '(INTERVAL 1 n)))
            (dk-cite! 'fun-apply-type 'eta '(INTERVAL 1 n) 'RR z)
            (let* ((ct (dk-apply! c29f-hC z 'a))
                   (ft (dk-project! (list 'IN (list 'p z) (list 'FUN (list 'PTS SUB) '(PTS RR-MS)))
                                    (lambda () (mac-h 'IS-CONTINUOUS-AT ct))))
                   (ss (begin (dk-have! (list 'IN V 'SET) (lambda () (fact 'rr-is-set) (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
                              (dk-have! (list 'SUBSET 'u V) (lambda () (subst (list '= V '(VEC (RN n)))) (subst (list '= '(VEC (RN n)) (list 'PTS E))) (ass)))
                              (dk-cite! 'subclass-of-set-is-set 'u V)
                              (dk-cite! 'subspace-pts E 'u)))
                   (f1 (dk-rewrite-h! ft (list 'PTS SUB) 'u))
                   (f2 (dk-rewrite-h! f1 '(PTS RR-MS) 'RR)))
              (c29-and! f2 '(IN a u))
              (dk-cite! 'fun-apply-type (list 'p z) 'u 'RR 'a)
              (c29-and! (list 'IN (list 'eta z) 'RR) (list 'IN (list (list 'p z) 'a) 'RR))
              (dk-cite! 'rr-mul-closed (list 'eta z) (list (list 'p z) 'a))
              (ass)))))
      (dk-cite! 'rb1-fs-real '(INTERVAL 1 n) Fi))))

(dk-peel!)
(set! c29f-hC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "conts"))
(define c29-open-ball
  (dk-project! (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL c29-E2 'y 'r) 'u)))))
               (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN c29-E2 'u)))))
(define c29-r (dk-skolem! (dk-apply! c29-open-ball 'a) #t))
(dk-peel!)                                          ; eps, POS-RR eps
(dk-cite! 'nn-in-rr 'n)
(dk-cite! 'nn-zero-le 'n)
(define c29-c (dk-skolem! (dk-cite! 'rr-small-factor-real 'eps 'n) #t))
(dk-cite! 'rr-pos-rr-in-rr c29-c)
(dk-have! (list '= (list '* 'n c29-c) (list '* c29-c 'n)) (lambda () (crs)))
(dk-type! (list '* c29-c 'n))
(dk-have! (list '<= (list '* 'n c29-c) 'eps) (lambda () (subst (list '= (list '* 'n c29-c) (list '* c29-c 'n))) (ass)))
(fact 'nn-le-refl 'n)
(define c29-dl (dk-skolem! (dk-cite! 'rn-partials-estimate-trunc 'n 'n 'u 'f 'p 'a c29-c c29-r) #t))
(define c29-cb2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c29-dl))) "the bound"))
(ew c29-dl)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'POS-RR) (ass)
      (begin
        (dk-peel!)
        (fact 'rn-vec 'n)
        (let* ((nrm '((VNRM (RN n)) eta))
               (inV (dk-rewrite-h! '(IN eta (VEC (RN n))) '(VEC (RN n)) '(FUN (INTERVAL 1 n) RR)))
               (b0 (dk-apply! c29-cb2 'eta))
               (tf (dk-cite! 'rn-trunc-full 'n 'eta))
               (b1 (dk-rewrite-h! b0 '(RN-TRUNC n eta n) 'eta))
               (xex (cadr (cadr (dk-goal))))
               (bsm (list '* 'n (list '* c29-c nrm)))
               (bigb (list '* nrm 'eps)))
          (dk-have! (list '<= (list 'abs xex) bsm) (lambda () (ass)))
          (dk-split! (dk-cite! 'rn-norm-typing 'n 'eta))
          (dk-cite! 'nn-in-rr 'n)
          (dk-cite! 'rr-pos-rr-in-rr 'eps)
          (dk-cite! 'rr-pos-rr-in-rr c29-c)
          (dk-cite! 'rr-pos-rr-in-rr c29-dl)
          (c29f-type-x! nrm)
          (dk-type! (list '* 'n c29-c))
          (dk-cite! 'rr-mul-le-right (list '* 'n c29-c) 'eps nrm)
          (let ((P1 (list '* (list '* 'n c29-c) nrm)) (P2 (list '* 'eps nrm)))
            (for-each dk-type! (list bsm bigb P1 P2))
            (dk-have! (list '= bsm P1) (lambda () (crs)))
            (dk-have! (list '= P2 bigb) (lambda () (crs)))
            (dk-cite! 'rr-abs-closed xex)
            (let* ((vb (dk-name! bsm)) (v1 (dk-name! P1)) (v2 (dk-name! P2)) (vbig (dk-name! bigb))
                   (h1 (dk-rewrite-h! (list '<= (list 'abs xex) bsm) bsm vb))
                   (h2 (dk-rewrite-h! (dk-rewrite-h! (list '<= P1 P2) P1 v1) P2 v2))
                   (e1 (dk-rewrite-h! (dk-rewrite-h! (list '= bsm P1) bsm vb) P1 v1))
                   (e2 (dk-rewrite-h! (dk-rewrite-h! (list '= P2 bigb) P2 v2) bigb vbig)))
              (subst (list '= bigb vbig))
              (dk-ineq! h1 h2 e1 e2))))))))
