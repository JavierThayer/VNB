;;; calc2-prop229.scm -- calculus.pdf Prop. 2.29: continuous partial derivatives give the
;;; first-order estimate on E = R^n with the sup norm.  CALC-2, 2026-10-19.  Prefix c29-.

(define (c29-open) (dk-open-leaves))
(define (c29-dump tag)
  (display ";; C29 ") (display tag) (display " goal: ") (display (dk-goal)) (newline)
  (for-each (lambda (a) (display ";; C29   asm: ") (display a) (newline)) (dk-asms))
  (for-each (lambda (l) (display ";; C29   open: ") (display (dk-goal-of l)) (newline)) (c29-open)))
(define (c29-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))

;;; (1) for e > 0 and N >= 0 there is c > 0 with c N <= e
(sp (make-wff (forall-guarded '(fe_ fn_) '((POS-RR fe_) (IN fn_ RR) (<= 0 fn_))
   '(FORSOME fc_ (AND (POS-RR fc_) (<= (* fc_ fn_) fe_))))))
(dk-peel!)
(dk-cite! 'rr-pos-rr-in-rr 'fe_)
(dk-cite! 'rr-lt-of-pos-rr 'fe_)
(define c29r-N '(+ fn_ 1))
(dk-type! c29r-N)
(dk-have! (list '< 0 c29r-N) (lambda () (dk-ineq! '(<= 0 fn_))))
(dk-have! (list 'NOT (list '= c29r-N 0)) (lambda () (di) (dk-absurd! (list '< 0 c29r-N) (list '= c29r-N 0))))
(c29-and! (list 'IN c29r-N 'RR) (list 'NOT (list '= c29r-N 0)))
(dk-cite! 'rr-recip-closed c29r-N)
(dk-cite! 'rr-recip-pos c29r-N)
(define c29r-c (list '* 'fe_ (list 'recip c29r-N)))
(c29-and! '(IN fe_ RR) (list 'IN (list 'recip c29r-N) 'RR))
(dk-cite! 'rr-mul-closed 'fe_ (list 'recip c29r-N))
(dk-cite! 'rr-mul-pos 'fe_ (list 'recip c29r-N))
(define c29r-eq0 (dk-cite! 'rr-recip-cancel-right 'fe_ c29r-N))
(define c29r-cv (dk-name! c29r-c))
(define c29r-eq1 (dk-rewrite-h! c29r-eq0 c29r-c c29r-cv))
(dk-have! (list '= (list '* c29r-cv c29r-N) (list '+ (list '* c29r-cv 'fn_) c29r-cv)) (lambda () (crs)))
(define c29r-eq2 (dk-rewrite-h! c29r-eq1 (list '* c29r-cv c29r-N) (list '+ (list '* c29r-cv 'fn_) c29r-cv)))
(dk-have! (list '< 0 c29r-cv) (lambda () (subst (list '= c29r-cv c29r-c)) (ass)))
(dk-type! (list '* c29r-cv 'fn_))
(ew c29r-cv)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'POS-RR)
        (begin (dk-cite! 'rr-pos-rr-of-lt c29r-cv) (ass))
        (dk-ineq! c29r-eq2 (list '< 0 c29r-cv)))))
(qed 'rr-small-factor-real)

;;; (2) THE INDUCTION OF THE PROOF: along eta_k = RN-TRUNC(n, eta, k), for k <= n,
;;;   |f(a + eta_k) - f(a) - sum_{i <= k} eta_i d_(e_i) f(a)| <= k (c ||eta||)
;;; for ||eta|| below some delta < r.  The induction variable is outermost.
(define c29-V '(FUN (INTERVAL 1 n) RR))
(define c29-E '(NVS-METRIC-SPACE (RN n)))
(define c29-SUB (list 'SUBSPACE-MS c29-E 'qu_))
(define c29-F '(VNB-LAMBDA cfi_ (INTERVAL 1 n) (* (qe_ cfi_) ((qp_ cfi_) qa_))))
(define (c29-S k) (list 'FINSUM '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) c29-F (list 'INTERVAL 1 k)))
(define c29-Neta '((VNRM (RN n)) qe_))
(define (c29-bound-body k)
  (list '<= (list 'abs (list '- (list '- (list 'qf_ (list '(VADD (RN n)) 'qa_ (list 'RN-TRUNC 'n 'qe_ k))) '(qf_ qa_))
                             (c29-S k)))
            (list '* k (list '* 'qc_ c29-Neta))))
(define (c29-S-of k)
  (list 'FORSOME 'qd_ (list 'AND '(POS-RR qd_) (list 'AND '(< qd_ qr_)
    (list 'FORALL 'qe_ (list 'IMPLIES (list 'IN 'qe_ c29-V)
      (list 'IMPLIES (list '<= c29-Neta 'qd_) (c29-bound-body k))))))))
(define c29-hyps
  (list '(IN n NN)
        (list 'IS-OPEN c29-E 'qu_)
        '(IN qf_ (FUN qu_ RR))
        '(IN qa_ qu_)
        '(FORALL i (IMPLIES (IN i (INTERVAL 1 n)) (FORALL x (IMPLIES (IN x qu_)
            (HAS-DIR-DERIV (RN n) qf_ x (RN-UNIT n i) ((qp_ i) x))))))
        (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'x (list 'IMPLIES '(IN x qu_)
            (list 'IS-CONTINUOUS-AT c29-SUB 'RR-MS '(qp_ i) 'x)))))
        '(POS-RR qc_) '(POS-RR qr_)
        (list 'SUBSET (list 'BALL c29-E 'qa_ 'qr_) 'qu_)
        '(<= k n)))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (forall-guarded '(n qu_ qf_ qp_ qa_ qc_ qr_) c29-hyps (c29-S-of 'k))))))
(ni)
(define (c29-step? l) (dk-contains? (dk-goal-of l) 'succ))
;;; the facts both cases need, landed after the peel
(define c29-hD #f) (define c29-hC #f)
(define (c29-common!)
  (set! c29-hD (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DIR-DERIV) (not (dk-contains? f 'qd_)))) "derivs"))
  (set! c29-hC (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT) (not (dk-contains? f 'qd_)))) "conts"))
  (dk-cite! 'rn-is-normed-vector-space 'n)
  (dk-cite! 'nvs-metric-is-ms '(RN n))
  (dk-cite! 'nvs-ms-pts '(RN n))
  (dk-cite! 'rn-vec 'n)
  (dk-project! (list 'SUBSET 'qu_ (list 'PTS c29-E)) (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN c29-E 'qu_))))
  (dk-cite! 'subset-mem-fwd 'qu_ (list 'PTS c29-E) 'qa_)
  (dk-have! (list 'IN 'qa_ c29-V)
    (lambda () (subst (list '= c29-V '(VEC (RN n)))) (subst (list '= '(VEC (RN n)) (list 'PTS c29-E))) (ass)))
  (c29-and! '(IN qf_ (FUN qu_ RR)) '(IN qa_ qu_))
  (dk-cite! 'fun-apply-type 'qf_ 'qu_ 'RR 'qa_)
  (dk-cite! 'rr-pos-rr-in-rr 'qc_) (dk-cite! 'rr-lt-of-pos-rr 'qc_)
  (dk-cite! 'rr-pos-rr-in-rr 'qr_) (dk-cite! 'rr-lt-of-pos-rr 'qr_))

;;; base
(dk-focus! (find-first (lambda (l) (not (c29-step? l))) (c29-open)))
(dk-peel!)
(c29-common!)
(define c29-d0 (dk-halve! 'qr_))
(ew c29-d0)
(define (c29-zero-close!)        ; goal (<= (abs E) (* 0 Q)) with E = 0 by crs
  (let* ((g (dk-goal)) (e (cadr (cadr g))) (rhs (caddr g)))
    (dk-have! (list '= e 0) (lambda () (crs)))
    (subst (list '= e 0))
    (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0))
    (dk-have! (list '= rhs 0) (lambda () (crs)))
    (subst (list '= rhs 0))
    (dk-cite! 'rr-leq-reflexive 0)
    (ass)))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'POS-RR) (ass))
            ((dk-head-is? g '<) (dk-ineq! (list '= (list '+ c29-d0 c29-d0) 'qr_) (list '< 0 c29-d0)))
            (#t
             (dk-peel!)
             (dk-split! (dk-cite! 'rn-norm-typing 'n 'qe_))
             (subst (dk-cite! 'rn-trunc-zero 'n 'qe_))
             (subst (dk-cite! 'rn-vzero-right 'n 'qa_))
             (fact 'interval-1-0-empty)
             (subst '(= (INTERVAL 1 0) EMPTY-SET))
             (subst (dk-cite! 'rb1-fs-empty c29-F))
             (c29-zero-close!))))))
;;; ---- step helpers --------------------------------------------------------------------
(define c29-w #f) (define c29-dk #f) (define c29-dc #f) (define c29-cb #f)
(define (c29-vec! x)                    ; (IN x (VEC (RN n))) from (IN x V)
  (dk-have! (list 'IN x '(VEC (RN n))) (lambda () (subst (list '= '(VEC (RN n)) c29-V)) (ass))))
(define (c29-pts! x)                    ; (IN x (PTS E)) from (IN x V)
  (dk-have! (list 'IN x (list 'PTS c29-E))
    (lambda () (subst (list '= (list 'PTS c29-E) '(VEC (RN n)))) (subst (list '= '(VEC (RN n)) c29-V)) (ass))))
(define (c29-sets!)                     ; qu_ in SET and qu_ subset V
  (fact 'rr-is-set)
  (fact 'interval-in-set 1 'n)
  (dk-have! (list 'IN c29-V 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'SUBSET 'qu_ c29-V)
    (lambda () (subst (list '= c29-V '(VEC (RN n)))) (subst (list '= '(VEC (RN n)) (list 'PTS c29-E))) (ass)))
  (dk-cite! 'subclass-of-set-is-set 'qu_ c29-V)
  (fact 'r7q-rr-pts)
  (dk-cite! 'subspace-pts c29-E 'qu_))
;;; (IN ((qp_ i) z) RR) for i in I, z in qu_
(define (c29-p-type! i z)
  (let* ((ct (dk-apply! c29-hC i z))
         (ft (dk-project! (list 'IN (list 'qp_ i) (list 'FUN (list 'PTS c29-SUB) '(PTS RR-MS)))
                          (lambda () (mac-h 'IS-CONTINUOUS-AT ct))))
         (f1 (dk-rewrite-h! ft (list 'PTS c29-SUB) 'qu_))
         (f2 (dk-rewrite-h! f1 '(PTS RR-MS) 'RR)))
    (c29-and! f2 (list 'IN z 'qu_))
    (dk-cite! 'fun-apply-type (list 'qp_ i) 'qu_ 'RR z)))
;;; a point a + W with ||W|| <= N is in qu_ (N <= w <= dk < qr_); lands its typings and the
;;; distance bound (<= dist_E(a, a + W) N); returns the point
(define (c29-in-U! w-term nbound)
  (let* ((pt (list '(VADD (RN n)) 'qa_ w-term)))
    (c29-vec! 'qa_)
    (c29-vec! w-term)
    (dk-cite! 'rn-vadd-in-vec 'n 'qa_ w-term)
    (c29-pts! pt)
    (dk-split! (dk-cite! 'rn-norm-typing 'n w-term))
    (let ((de (dk-cite! 'nvs-dist-shift '(RN n) 'qa_ w-term)))
      (dk-cite! 'metric-dist-real c29-E 'qa_ pt)
      (dk-have! (list '<= (list (list 'DIST c29-E) 'qa_ pt) c29-Neta) (lambda () (dk-ineq! de nbound)))
      (dk-have! (list '< c29-Neta 'qr_)
        (lambda () (dk-ineq! (list '<= c29-Neta c29-w) (list '<= c29-w c29-dk) (list '< c29-dk 'qr_))))
      (dk-have! (list 'AND (list 'IN pt (list 'PTS c29-E)) (list 'AND (list 'IN c29-Neta 'RR) (list 'AND '(IN qr_ RR)
                  (list 'AND (list '<= (list (list 'DIST c29-E) 'qa_ pt) c29-Neta) (list '< c29-Neta 'qr_)))))
        (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-cite! 'ball-mem-from-le c29-E 'qa_ pt c29-Neta 'qr_)
      (dk-cite! 'subset-mem-fwd (list 'BALL c29-E 'qa_ 'qr_) 'qu_ pt)
      (c29-and! '(IN qf_ (FUN qu_ RR)) (list 'IN pt 'qu_))
      (dk-cite! 'fun-apply-type 'qf_ 'qu_ 'RR pt)
      pt)))

;;; ---- the step -------------------------------------------------------------------------
(dk-focus! (find-first c29-step? (c29-open)))
(dk-di-var!)
(dk-peel!)
(define c29-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'qd_))) "the IH"))
(c29-common!)
(c29-sets!)
(dk-have! '(<= k n) (lambda () (dk-nn! '(<= (succ k) n))))
(dk-cite! 'nn-in-rr 'k)
(define c29-ihd (dk-skolem! (dk-apply! c29-ih 'n 'qu_ 'qf_ 'qp_ 'qa_ 'qc_ 'qr_) #t))
(set! c29-dk c29-ihd)
(define c29-ihb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'qe_) (dk-contains? f c29-ihd))) "the IH bound"))
(dk-cite! 'rr-pos-rr-in-rr c29-dk) (dk-cite! 'rr-lt-of-pos-rr c29-dk)
;;; succ k is an index
(dk-cite! 'nn-succ-closed 'k)
(dk-have! '(<= 1 (succ k)) (lambda () (dk-nn!)))
(dk-cite! 'interval-mem-intro 1 'n '(succ k))
;;; continuity of the (k+1)-st partial at a, at tolerance qc_
(define c29-ct (dk-apply! c29-hC '(succ k) 'qa_))
(define c29-eps-clause
  (dk-project! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'delta (list 'AND '(POS-RR delta)
                 (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b (list 'PTS c29-SUB))
                   (list 'IMPLIES (list '<= (list (list 'DIST c29-SUB) 'qa_ 'b) 'delta)
                     (list '<= (list '(DIST RR-MS) '((qp_ (succ k)) qa_) '((qp_ (succ k)) b)) 'eps))))))))
               (lambda () (mac-h 'IS-CONTINUOUS-AT c29-ct))))
(set! c29-dc (dk-skolem! (dk-apply! c29-eps-clause 'qc_) #t))
(set! c29-cb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c29-dc))) "the continuity clause"))
(dk-cite! 'rr-pos-rr-in-rr c29-dc) (dk-cite! 'rr-lt-of-pos-rr c29-dc)
(set! c29-w (dk-skolem! (dk-cite! 'rr-min-pos c29-dk c29-dc) #t))
(define c29-T '(RN-TRUNC n qe_ k))
(define c29-eu '(RN-UNIT n (succ k)))
(define c29-lam '(qe_ (succ k)))
(define c29-L '((qp_ (succ k)) qa_))
(define c29-b (list '(VADD (RN n)) 'qa_ c29-T))
(define c29-Tsk '(RN-TRUNC n qe_ (succ k)))
(define c29-A0 '(qf_ qa_))
(define c29-A1 (list 'qf_ c29-b))
(define c29-A2 (list 'qf_ (list '(VADD (RN n)) 'qa_ c29-Tsk)))
(define (c29-act t) (list '(ACT (RN n)) t c29-eu))
(define (c29-Wt t) (list '(VADD (RN n)) c29-T (c29-act t)))
(define (c29-rr! t) (dk-type! t))

;;; the arithmetic of the step: the triangle inequality with the products named
(define (c29-finish! b1 b2)
  (let* ((Q   (list '* 'qc_ c29-Neta))
         (kQ  (list '* 'k Q))
         (cl  (list '* 'qc_ (list 'abs c29-lam)))
         (lL  (list '* c29-lam c29-L))
         (Sk  (c29-S 'k)))
    (for-each c29-rr! (list Q kQ cl lL))
    (dk-have! '(<= 0 qc_) (lambda () (dk-ineq! '(< 0 qc_))))
    (dk-cite! 'rr-mul-le-right (list 'abs c29-lam) c29-Neta 'qc_)
    (dk-have! (list '<= cl Q)
      (lambda ()
        (dk-have! (list '= cl (list '* (list 'abs c29-lam) 'qc_)) (lambda () (crs)))
        (dk-have! (list '= Q (list '* c29-Neta 'qc_)) (lambda () (crs)))
        (subst (list '= cl (list '* (list 'abs c29-lam) 'qc_)))
        (subst (list '= Q (list '* c29-Neta 'qc_)))
        (ass)))
    (dk-cite! 'nn-succ-plus-one 'k)
    (dk-have! (list '= (list '* '(succ k) Q) (list '+ kQ Q))
      (lambda () (subst '(= (succ k) (+ k 1))) (crs)))
    (subst (list '= (list '* '(succ k) Q) (list '+ kQ Q)))
    (let* ((vk (dk-name! kQ)) (vq (dk-name! Q)) (vc (dk-name! cl)) (vl (dk-name! lL))
           (b1a (dk-rewrite-h! b1 kQ vk))
           (b2a (dk-rewrite-h! (dk-rewrite-h! b2 lL vl) cl vc))
           (cq  (dk-rewrite-h! (dk-rewrite-h! (list '<= cl Q) cl vc) Q vq)))
      (subst (list '= kQ vk))
      (subst (list '= Q vq))
      (subst (list '= lL vl))
      (let* ((X1 (list '- (list '- c29-A1 c29-A0) Sk))
             (X2 (list '- (list '- c29-A2 c29-A1) vl))
             (X  (list '- (list '- c29-A2 c29-A0) (list '+ Sk vl)))
             (bd (list '+ vk vq)))
        (for-each c29-rr! (list X1 X2 X bd))
        (dk-split-all! (list (dk-cite! 'rr-abs-le-parts X1 vk)))
        (dk-split-all! (list (dk-cite! 'rr-abs-le-parts X2 vc)))
        (dk-have! (list '<= (list '- bd) X)
          (lambda () (dk-ineq! (list '<= (list '- vk) X1) (list '<= (list '- vc) X2) cq)))
        (dk-have! (list '<= X bd)
          (lambda () (dk-ineq! (list '<= X1 vk) (list '<= X2 vc) cq)))
        (dk-cite! 'rr-abs-le-of-parts X bd)
        (ass)))))

;;; the summand function F is a real function on INTERVAL(1, n)
(define (c29-F-type!)
  (dk-have! (list 'IN c29-F (list 'FUN '(INTERVAL 1 n) 'RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((i (dk-di-var!)))
            (c29-and! '(IN qe_ (FUN (INTERVAL 1 n) RR)) (list 'IN i '(INTERVAL 1 n)))
            (dk-cite! 'fun-apply-type 'qe_ '(INTERVAL 1 n) 'RR i)
            (c29-p-type! i 'qa_)
            (c29-and! (list 'IN (list 'qe_ i) 'RR) (list 'IN (list (list 'qp_ i) 'qa_) 'RR))
            (dk-cite! 'rr-mul-closed (list 'qe_ i) (list (list 'qp_ i) 'qa_))
            (ass)))
        (lambda () (ass))))))
;;; (FORALL z_ (IMPLIES (IN z_ S) (IN (F z_) RR))) for S a sub-interval, via WIDEN!
(define (c29-F-ptwise! S widen!)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ S) (list 'IN (list c29-F 'z_) 'RR)))
    (lambda ()
      (let ((z (dk-di-var!)))
        (widen! z)
        (c29-and! (list 'IN c29-F (list 'FUN '(INTERVAL 1 n) 'RR)) (list 'IN z '(INTERVAL 1 n)))
        (dk-cite! 'fun-apply-type c29-F '(INTERVAL 1 n) 'RR z)
        (ass)))))

(define (c29-eta-body!)
  (dk-peel!)
  (dk-split! (dk-cite! 'rn-norm-typing 'n 'qe_))
  (dk-have! (list '<= c29-Neta c29-dk) (lambda () (dk-ineq! (list '<= c29-Neta c29-w) (list '<= c29-w c29-dk))))
  (let* ((b1 (dk-apply! c29-ihb 'qe_)))
    (c29-and! '(IN qe_ (FUN (INTERVAL 1 n) RR)) '(IN (succ k) (INTERVAL 1 n)))
    (dk-cite! 'fun-apply-type 'qe_ '(INTERVAL 1 n) 'RR '(succ k))
    (dk-cite! 'rn-norm-ge-coord 'n 'qe_ '(succ k))
    (dk-cite! 'rr-abs-closed c29-lam)
    (dk-cite! 'rn-trunc-in-vec 'n 'qe_ 'k)
    (dk-cite! 'rn-unit-in-vec 'n '(succ k))
    (c29-vec! c29-T) (c29-vec! c29-eu)
    ;; b = a + T_k is in qu_
    (dk-cite! 'rr-zero-in)
    (dk-have! (list '<= '(abs 0) (list 'abs c29-lam))
      (lambda () (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0)) (dk-cite! 'rr-abs-nonneg c29-lam) (ass)))
    (let* ((nb0 (dk-cite! 'rn-trunc-step-norm 'n 'qe_ 'k 0))
           (z0  (dk-cite! 'nvs-act-zero '(RN n) c29-eu c29-T))
           (nbT (dk-rewrite-h! nb0 (c29-Wt 0) c29-T)))
      (c29-in-U! c29-T nbT))
    (c29-p-type! '(succ k) 'qa_)
    ;; the hypothesis of the one-direction step, for |t| <= |lambda|
    (dk-have! (list 'FORALL 'tt_ (list 'IMPLIES '(IN tt_ RR) (list 'IMPLIES (list '<= '(abs tt_) (list 'abs c29-lam))
                (list 'FORSOME 'dd_ (list 'AND (list 'HAS-DIR-DERIV '(RN n) 'qf_ (list '(VADD (RN n)) c29-b (c29-act 'tt_)) c29-eu 'dd_)
                                             (list '<= (list 'abs (list '- 'dd_ c29-L)) 'qc_))))))
      (lambda ()
        (let* ((tt (dk-di-var!)))
          (dk-peel!)
          (dk-cite! 'rn-act-in-vec 'n tt c29-eu)
          (dk-cite! 'rn-vadd-in-vec 'n c29-T (c29-act tt))
          (let* ((nb (dk-cite! 'rn-trunc-step-norm 'n 'qe_ 'k tt))
                 (zp (c29-in-U! (c29-Wt tt) nb))
                 (z  (list '(VADD (RN n)) c29-b (c29-act tt)))
                 (asc (dk-cite! 'rn-vadd-assoc 'n 'qa_ c29-T (c29-act tt)))
                 (inU (dk-rewrite-h! (list 'IN zp 'qu_) zp z))
                 (inP (dk-rewrite-h! (list 'IN zp (list 'PTS c29-E)) zp z))
                 (dle (dk-rewrite-h! (list '<= (list (list 'DIST c29-E) 'qa_ zp) c29-Neta) zp z))
                 (D (list (list 'qp_ '(succ k)) z)))
            (c29-p-type! '(succ k) z)
            (dk-apply! c29-hD '(succ k) z)
            (dk-have! (list 'IN z (list 'PTS c29-SUB)) (lambda () (subst (list '= (list 'PTS c29-SUB) 'qu_)) (ass)))
            (dk-cite! 'metric-dist-real c29-E 'qa_ z)
            (let ((dsub (dk-cite! 'subspace-dist c29-E 'qu_ 'qa_ z)))
              (dk-have! (list '<= (cadr dsub) c29-dc)
                (lambda () (subst (list '= (cadr dsub) (caddr dsub)))
                  (dk-ineq! dle (list '<= c29-Neta c29-w) (list '<= c29-w c29-dc)))))
            (let* ((cr (dk-apply! c29-cb z))
                   (rd (dk-cite! 'rr-ms-dist c29-L D))
                   (cr1 (dk-rewrite-h! cr (cadr rd) (caddr rd)))
                   (sy (dk-cite! 'rr-abs-sub-sym c29-L D))
