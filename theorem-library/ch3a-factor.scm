;;; ch3a-factor.scm -- complete factorization of a complex polynomial (Proposition 3.51 of the
;;; complex analysis notes) (CH3-A, 2026-10-26).  Destination: theorem-library/ch3a-factor.scm,
;;; library complex-analysis.
;;;
;;;   cc-partial-prod-congr      products of two sequences agreeing below n agree
;;;   cc-poly-factorization      P(z) = sum_{j <= n} c(j) z^j with c(n) /= 0 (degree n)
;;;                              ==> P(z) = c(n) (z - a(0)) ... (z - a(n-1)) for some a
;;; Proof: induction on n; a root a0 of P (fundamental-theorem-of-algebra), the division
;;; P(z) = P(a0) + (z - a0) Q(z) (POLY-2's cc-ps-divide), Q of degree n - 1 with the same leading
;;; coefficient; the roots of Q, then a0, give the roots of P.
;;; The notes take P monic (leading coefficient 1); the statement here carries c(n).
;;; Load window: after the POLY-2 file poly-fn-roots (cc-ps-divide) and structure-library/ch3a-vocab
;;; (CC-PARTIAL-PROD); fundamental-theorem-of-algebra (cauchy-estimates) loads earlier.
;;; Helper prefix cft-.
;;; ======================================================================
(define (cft-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (cft-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (cft-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (cft-H c z) n))
(define (cft-G z a) (list 'VNB-LAMBDA 'cfi_ 'NN (list '- z (list a 'cfi_))))
(define (cft-vanish c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))

;;; ======================================================================
;;; (1) congruence of finite products
;;; ======================================================================
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL g (FORALL h
  (IMPLIES (FORALL i (IMPLIES (IN i NN) (IMPLIES (< i n) (= (g i) (h i)))))
    (== (CC-PARTIAL-PROD g n) (CC-PARTIAL-PROD h n)))))))))
(dk-ni-fixed!)   ; W1B: g, h fixed; the induction on n is predicative
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let* ((gl (dk-goal))
          (body (and (dk-head-is? gl 'FORALL) (caddr gl)))
          (step? (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
     (if (not step?)
         (let* ((landed (dk-peel!))
                (eq (dk-goal))
                (g (cadr (cadr eq))) (h (cadr (caddr eq))))
           (subst (dk-cite! 'cc-partial-prod-zero g))
           (subst (dk-cite! 'cc-partial-prod-zero h))
           (qrfl))
         (let* ((landed (dk-peel!))
                (k (dk-landed-var landed 'NN))
                (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'IMPLIES) (dk-contains? fm 'CC-PARTIAL-PROD))) landed)))   ; W1B: the IH at the fixed g, h
                (hyp (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (not (dk-contains? fm 'CC-PARTIAL-PROD)))) landed)))
                (eq (dk-goal))
                (g (cadr (cadr eq))) (h (cadr (caddr eq))))
           (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES (list '< 'i k) (list '= (list g 'i) (list h 'i)))))
             (lambda ()
               (let* ((ls (dk-peel!))
                      (i (dk-landed-var ls 'NN)))
                 (fact 'nn-succ-closed k)
                 (dk-have! (list '< i (list 'succ k)) (lambda () (dk-nn! (list '< i k))))
                 (dk-apply! hyp i)
                 (ass))))
           (detach! ih)                              ; W1B: was (dk-apply! ih g h)
           (fact 'nn-succ-closed k)
           (dk-have! (list '< k (list 'succ k)) (lambda () (dk-nn!)))
           (dk-apply! hyp k)
           (subst (dk-cite! 'cc-partial-prod-succ g k))
           (subst (dk-cite! 'cc-partial-prod-succ h k))
           (subst (list '== (list 'CC-PARTIAL-PROD g k) (list 'CC-PARTIAL-PROD h k)))
           (subst (list '= (list g k) (list h k)))
           (qrfl)))))
 (dk-open-leaves))
(qed 'cc-partial-prod-congr)
(topic! 'cc-partial-prod-congr 'analysis)

;;; products of complex numbers are complex
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL g
  (IMPLIES (FORALL i (IMPLIES (IN i NN) (IN (g i) CC))) (IN (CC-PARTIAL-PROD g n) CC)))))))
(dk-ni-fixed!)   ; W1B: g and its typing fixed
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let* ((gl (dk-goal))
          (body (and (dk-head-is? gl 'FORALL) (caddr gl)))
          (step? (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
     (if (not step?)
         (let* ((landed (dk-peel!))
                (g (cadr (cadr (dk-goal)))))
           (subst (dk-cite! 'cc-partial-prod-zero g))
           (fact 'cc-one-in)
           (ass))
         (let* ((landed (dk-peel!))
                (k (dk-landed-var landed 'NN))
                (ih (car (filter (lambda (fm) (dk-contains? fm 'CC-PARTIAL-PROD)) landed)))   ; W1B: the IH itself
                (hyp (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (not (dk-contains? fm 'CC-PARTIAL-PROD)))) (dk-asms))))
                (g (cadr (cadr (dk-goal)))))
           (dk-apply! hyp k)
           (subst (dk-cite! 'cc-partial-prod-succ g k))
           (dk-type! (list '* (list 'CC-PARTIAL-PROD g k) (list g k)) 'CC)))))
 (dk-open-leaves))
(qed 'cc-partial-prod-in-cc)
(topic! 'cc-partial-prod-in-cc 'analysis)

;;; ======================================================================
;;; (2) PROPOSITION 3.51: complete factorization
;;; ======================================================================
(define (cft-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))

(define (cft-base!)
  (let* ((landed (dk-peel!))
         (c (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(FUN NN CC)))) landed))))
         (a '(VNB-LAMBDA cfk_ NN 0)))
    (fact 'cc-zero-in)
    (dk-have! (list 'IN a '(FUN NN CC)) (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (ass))))))
    (ew a)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (let* ((z (dk-di-var!))
                   (h (cft-H c z))
                   (g (cft-G z a)))
              (fact 'nn-zero-in)
              (fact 'fun-apply-type-c c 'NN 'CC 0)
              (dk-cite! 'power-zero z)
              (let ((e0 (dk-cite! 'cc-series-partial-sum-zero h)))
                (dk-have! (list 'IN (list 'CC-SERIES-PARTIAL-SUM h 0) 'CC) (lambda () (subst e0) (ass))))
              (dk-have! (list 'IN (list h 0) 'CC)
                (lambda () (dk-lam-b!) (dk-type! (list '* (list c 0) (list 'power z 0)) 'CC)))
              (subst (dk-cite! 'cc-series-partial-sum-succ h 0))
              (subst (list '== (list 'CC-SERIES-PARTIAL-SUM h 0) 0))
              (subst (dk-cite! 'cc-partial-prod-zero g))
              (dk-lam-b!)
              (subst (list '= (list 'power z 0) 1))
              (crs)))))))

(define (cft-step!)
  (let* ((landed (dk-peel!))
         (m (dk-landed-var landed 'NN))
         (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-PARTIAL-PROD))) landed)))
         (c (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(FUN NN CC)))) landed))))
         (s1 (list 'succ m))
         (ss (list 'succ s1)))
    (fact 'nn-succ-closed m)
    (fact 'nn-succ-closed s1)
    (fact 'cc-zero-in)
    (let* ((a0 (dk-skolem! (dk-cite! 'fundamental-theorem-of-algebra c m)))
           (_1 (dk-split-all!))
           (_2 (dk-have! (list '= (cft-PS c a0 ss) 0) (lambda () (ass))))
           (d (dk-skolem! (dk-cite! 'cc-ps-divide s1 c a0)))
           (_3 (dk-split-all!))
           (rel (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list c '(succ pfk_))))) "the coefficient relation"))
           (vd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list d 'pfk_)) (not (dk-contains? fm c)))) "d vanishes"))
           (ident (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'pfz_) (dk-contains? fm d))) "the division identity")))
      (fact 'fun-apply-type-c d 'NN 'CC m)
      (fact 'fun-apply-type-c d 'NN 'CC s1)
      (fact 'fun-apply-type-c c 'NN 'CC s1)
      (dk-have! (list '<= s1 s1) (lambda () (dk-nn!)))
      (dk-apply! vd s1)
      (let* ((r0 (dk-apply! rel m))
             (r1 (dk-rewrite-h! r0 (list d s1) 0)))
        (dk-have! (list '= (list d m) (list c s1))
          (lambda () (subst (list '= (list c s1) (list '- (list d m) (list '* a0 0)))) (crs))))
      (dk-have! (list 'NOT (list '= (list d m) 0))
        (lambda () (di) (dk-rewrite-h! (list '= (list d m) 0) (list d m) (list c s1)) (dk-only! (list '= (list c s1) 0) (list 'NOT (list '= (list c s1) 0))) (prop)))
      (let* ((b (dk-skolem! (dk-apply! ih d)))
             (_4 (dk-split-all!))
             (fac (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-PARTIAL-PROD) (dk-contains? fm b))) "the factorization of d"))
             (lam (list 'VNB-LAMBDA 'cfj_ 'NN (list 'IF (list '< 'cfj_ m) (list b 'cfj_) a0)))
             (ex (list 'FORSOME 'cfa_ (list 'AND '(IN cfa_ (FUN NN CC))
                   (list 'AND (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES (list '< 'i m) (list '= '(cfa_ i) (list b 'i)))))
                              (list '= (list 'cfa_ m) a0))))))
        (fact 'nn-in-rr m)
        (dk-have! ex
          (lambda ()
            (ew lam)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((dk-asm? g) (ass))
                    ((dk-head-is? g 'IN)
                     (dk-lam-type!
                       (lambda ()
                         (let* ((i (dk-di-var!))
                                (ift (cadr (dk-goal))))
                           (fact 'fun-apply-type-c b 'NN 'CC i)
                           (dk-case-if! ift (lambda (tv v) (ass)))))))
                    ((dk-head-is? g 'FORALL)
                     (let* ((ls (dk-peel!))
                            (i (dk-landed-var ls 'NN)))
                       (fact 'fun-apply-type-c b 'NN 'CC i)
                       (dk-lam-b!)
                       (dk-if-branch! #t (cadr (dk-goal)) #f (lambda () (rfl)))))
                    (#t
                     (dk-lam-b!)
                     (dk-if-branch! #f (cadr (dk-goal))
                       (lambda () (di) (dk-absurd! (list '< m m)))
                       (lambda () (rfl))))))))))
        (let* ((a2 (dk-skolem! ex))
               (_5 (dk-split-all!))
               (agree (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm a2) (dk-contains? fm b))) "a2 agrees with b")))
          (ew a2)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (let* ((z (dk-di-var!))
                         (gp (cft-G z a2))
                         (g (cft-G z b)))
                    (fact 'fun-apply-type-c a2 'NN 'CC m)
                    (let ((ch (dk-cite! 'cc-partial-prod-congr m gp g)))
                      (if (dk-head-is? ch 'IMPLIES)
                          (dk-chain! ch
                            (lambda (ante)
                              (lambda ()
                                (let* ((ls (dk-peel!))
                                       (i (dk-landed-var ls 'NN)))
                                  (fact 'fun-apply-type-c a2 'NN 'CC i)
                                  (fact 'fun-apply-type-c b 'NN 'CC i)
                                  (dk-lam-b!)
                                  (dk-apply! agree i)
                                  (subst (list '= (list a2 i) (list b i)))
                                  (rfl)))))))
                    (dk-cite! 'cc-partial-prod-succ gp m)
                    (dk-apply! ident z)
                    (dk-apply! fac z)
                    (subst (list '= (cft-PS c z ss) (list '+ (cft-PS c a0 ss) (list '* (list '- z a0) (cft-PS d z s1)))))
                    (subst (list '= (cft-PS c a0 ss) 0))
                    (subst (list '= (cft-PS d z s1) (list '* (list d m) (list 'CC-PARTIAL-PROD g m))))
                    (subst (list '== (list 'CC-PARTIAL-PROD gp s1) (list '* (list 'CC-PARTIAL-PROD gp m) (list gp m))))
                    (subst (list '== (list 'CC-PARTIAL-PROD gp m) (list 'CC-PARTIAL-PROD g m)))
                    (dk-lam-b!)
                    (subst (list '= (list a2 m) a0))
                    (subst (list '= (list d m) (list c s1)))
                    (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN (list g 'i) 'CC)))
                      (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c b 'NN 'CC i) (dk-lam-b!) (dk-type! (list '- z (list b i)) 'CC))))
                    (dk-cite! 'cc-partial-prod-in-cc m g)
                    (let ((pv (dk-name! (list 'CC-PARTIAL-PROD g m) 'CC)))
                      (subst (list '= (list 'CC-PARTIAL-PROD g m) pv))
                      (crs)))))))))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'c (list 'IMPLIES '(IN c (FUN NN CC))
    (list 'IMPLIES (cft-vanish 'c '(succ n))
      (list 'IMPLIES '(NOT (= (c n) 0))
        (list 'FORSOME 'ra (list 'AND '(IN ra (FUN NN CC))
          (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
            (list '= (cft-PS 'c 'z '(succ n)) (list '* '(c n) (list 'CC-PARTIAL-PROD (cft-G 'z 'ra) 'n)))))))))))))))
(ni)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (cft-step-goal? (dk-goal)) (cft-step!) (cft-base!)))
 (dk-open-leaves))
(qed 'cc-poly-factorization)
(topic! 'cc-poly-factorization 'analysis)
