;;; Proposition 5.1, necessity.
(define avr-BO '(BOUNDED-OPS v v))
(define (avr-chain! ch provers)
  (let loop ((r ch) (ps provers))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (cadr r))
            (loop (let ((new (dk-landed* (lambda () (detach! (or (dk-ctx-form r) r))))))
                    (if (pair? new) (dk--deepest-of new) (avr-ctx (caddr r))))
                  ps)
            (begin (if (null? ps) (error "avr-chain!: no prover left for" (expression->string (cadr r))))
                   (loop (detach-with! (or (dk-ctx-form r) r) (car ps)) (cdr ps))))
        r)))
(define (avr-pick pred what) (dk-pick pred what))
(define (avr-det! r) (if (dk-head-is? r 'IMPLIES) (detach! r)))
(define (avr-iff-fwd! iff from)
  (let ((b (caddr iff))) (if (not (dk-asm? b)) (dk-have! b (lambda () (if (dk-only! iff from) (prop))))) b))
(define (avr-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (dk-cite! 'fun-apply-type-c f a b x)))

;;; a strongly continuous functional is additive and homogeneous on L(H)
(define avr-SDadd '(FORALL avs_ (IMPLIES (IN avs_ (BOUNDED-OPS v v)) (FORALL avu_ (IMPLIES (IN avu_ (BOUNDED-OPS v v))
                      (= (phi_ (BOP-SUM v v avs_ avu_)) (+ (phi_ avs_) (phi_ avu_))))))))
(define avr-SDscl '(FORALL avc_ (IMPLIES (IN avc_ CC) (FORALL avs_ (IMPLIES (IN avs_ (BOUNDED-OPS v v))
                      (= (phi_ (BOP-SCALE v v avc_ avs_)) (* avc_ (phi_ avs_))))))))
(sp (make-wff (forall-guarded '(v phi_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN phi_ (STRONG-DUAL v)))
   (list 'AND '(IN phi_ (FUN (BOUNDED-OPS v v) CC)) (list 'AND avr-SDadd avr-SDscl)))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'cc-is-set)
(dk-cite! 'strong-dual-unfold-sot 'v)
(sep-me (dk-rewrite-h! '(IN phi_ (STRONG-DUAL v)) '(STRONG-DUAL v)
          '(SEP otf_ (FUN (BOUNDED-OPS v v) CC)
             (AND (IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE otf_) (IS-HOM-TOP-SPACE (SOT v) CC-SN-TOP otf_)))))
(dk-split-all!)
(mac-h 'is-linear-map (avr-ctx '(IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE phi_)))
(dk-split-all!)
(for-each (lambda (n) (dk-cite! n 'v)) '(bh-module-vec bh-module-vadd bh-module-act bh-module-scal))
(for-each dk-cite! '(cc-sn-module-vadd cc-sn-module-act cc-sn-module-vec cc-scalar-ring-add cc-scalar-ring-mul cc-scalar-ring-carr))
(define avr-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define avr-lin-add (avr-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'phi_) (dk-contains? h 'VADD))) "additive"))
(define avr-lin-act (avr-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'phi_) (dk-contains? h 'ACT))) "homogeneous"))
(dk-conj-close!
  (lambda ()
    (cond
      ((avr-done?) #t)
      ((dk-ass!) #t)
      (#t
       (let* ((ld (dk-peel!))
              (ops (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) avr-BO))) ld)))
              (cs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'CC))) ld))))
         (for-each (lambda (a) (avr-ap! 'phi_ avr-BO 'CC a)
                               (dk-have! (list 'IN a '(VEC (BH-MODULE v))) (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!))))
                   ops)
         (if (null? cs)
             (let* ((a (car ops)) (b (cadr ops))
                    (vv (dk-cite! 'bh-vadd-value 'v a b))
                    (e (dk-apply! avr-lin-add a b))
                    (e1 (dk-rewrite-h! e '(VADD (BH-MODULE v)) '(BH-VADD v)))
                    (e2 (dk-rewrite-h! e1 (list '(BH-VADD v) a b) (list 'BOP-SUM 'v 'v a b)))
                    (e3 (dk-rewrite-h! e2 '(VADD CC-SN-MODULE) (list 'ADD avr-R)))
                    (e4 (dk-rewrite-h! e3 (list 'ADD avr-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))))
               (dk-lam-b-h! e4)
               (dk-ass!))
             (let* ((c (car cs)) (a (car ops)))
               (dk-have! (list 'IN c '(CARR (SCAL (BH-MODULE v))))
                 (lambda () (subst (list '== '(SCAL (BH-MODULE v)) avr-R)) (subst (list '== (list 'CARR avr-R) 'CC)) (dk-ass!)))
               (dk-cite! 'bh-act-value 'v c a)
               (let* ((e (dk-apply! avr-lin-act c a))
                      (e1 (dk-rewrite-h! e '(ACT (BH-MODULE v)) '(BH-ACT v)))
                      (e2 (dk-rewrite-h! e1 (list '(BH-ACT v) c a) (list 'BOP-SCALE 'v 'v c a)))
                      (e3 (dk-rewrite-h! e2 '(ACT CC-SN-MODULE) (list 'MUL avr-R)))
                      (e4 (dk-rewrite-h! e3 (list 'MUL avr-R) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))))
                 (dk-lam-b-h! e4)
                 (dk-ass!)))))))))
(avr-done! 'strong-dual-linear)

;;; the representation: a strongly continuous phi is sum_(k < n) <T a_k | b_k>
(define avr-concl
  (list 'FORSOME 'avn_ (list 'AND '(IN avn_ NN)
   (list 'FORSOME 'ava_ (list 'AND '(IN ava_ (FUN NN (VEC v)))
    (list 'FORSOME 'avb_ (list 'AND '(IN avb_ (FUN NN (VEC v)))
     (list 'FORALL 'avt_ (list 'IMPLIES '(IN avt_ (BOUNDED-OPS v v))
       (list '= '(phi_ avt_) (list 'FINSUM avr-AG (avr-summand 'avn_ 'ava_ 'avb_) '(ORD-SEGMENT avn_))))))))))))
(sp (make-wff (forall-guarded '(v phi_) '((IS-HILBERT-SPACE v) (IN phi_ (STRONG-DUAL v))) avr-concl)))
