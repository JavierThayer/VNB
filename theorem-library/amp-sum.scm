  (if (not (dk-asm? (list 'IN avr-SD 'SET)))
      (let ((fi (dk-cite! 'fun-set-iff '(BOUNDED-OPS v v) 'CC)))
        (dk-have! '(AND (IN (BOUNDED-OPS v v) SET) (IN CC SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (dk-have! '(IN (FUN (BOUNDED-OPS v v) CC) SET) (lambda () (if (dk-only! fi '(AND (IN (BOUNDED-OPS v v) SET) (IN CC SET))) (prop))))
        (dk-have! (list 'IN avr-SD 'SET) (lambda () (subst (list '== avr-SD (avr-sd-sep 'STRONG-DUAL '(SOT v)))) (sep-set) (if (not (avr-done?)) (dk-ass!)))))))
(define (avr-bo! x)                      ; x in VEC(BH-MODULE v) <-> x in L(v)
  (if (not (dk-asm? (list 'IN x '(BOUNDED-OPS v v))))
      (dk-rewrite-h! (list 'IN x '(VEC (BH-MODULE v))) '(VEC (BH-MODULE v)) '(BOUNDED-OPS v v)))
  (if (not (dk-asm? (list 'IN x '(VEC (BH-MODULE v)))))
      (dk-have! (list 'IN x '(VEC (BH-MODULE v))) (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!)))))
;; the seminorm of the pairing at f is T |-> |f(T)|
(sp (make-wff (forall-guarded '(v f_ t_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN f_ (STRONG-DUAL v)) (IN t_ (BOUNDED-OPS v v)))
   (list '= (avr-wpf-at 'f_ 't_) '(magnitude (f_ t_))))))
(dk-peel!)
(avr-mb-setup!)
(avr-bo! 't_)
(dk-split-all! (list (dk-cite! 'strong-dual-linear 'v 'f_)))
(avr-ap! 'f_ '(BOUNDED-OPS v v) 'CC 't_)
(dk-cite! 'cc-magnitude-closed '(f_ t_))
(mac 'WEAK-PAIRING-PF)
(dk-lam-b!)
(if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
(if (not (avr-done?)) (rfl))
(avr-done! 'weak-pairing-pf-apply)

;; the pairing seminorms form a separating family (Remark 5.3)
(sp (make-wff (forall-guarded '(v) '((IS-COMPLEX-INNER-PRODUCT-SPACE v))
   (list 'IS-SEMINORM-FAMILY-ON 'CC-NORMED-FIELD avr-MB avr-SD avr-WPF))))
(dk-peel!)
(avr-mb-setup!)
(define avr-R2 '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (avr-scal-eq!) (subst (list '== '(SCAL (BH-MODULE v)) avr-R2)) (if (not (avr-done?)) (rfl)))
(define (avr-semi-close! f)              ; IS-SEMINORM of x |-> |f x| (f in the strong dual)
  (dk-split-all! (list (dk-cite! 'strong-dual-linear 'v f)))
  (let ((addp (avr-ctx (avr-replace avr-SDadd 'phi_ f))) (sclp (avr-ctx (avr-replace avr-SDscl 'phi_ f))))
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((avr-done?) #t)
            ((dk-ass!) #t)
            ((dk-head-is? g '=) (avr-scal-eq!))
            ((dk-head-is? g 'IN)
             (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (avr-bo! x) (avr-ap! f '(BOUNDED-OPS v v) 'CC x)
                                         (dk-cite! 'cc-magnitude-closed (list f x)) (dk-ass!)))
                           (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!))))
            (#t
             (let* ((ld (dk-peel!))
                    (xs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC (BH-MODULE v))))) ld)))
                    (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (not (equal? (caddr h) '(VEC (BH-MODULE v)))))) ld))))
               (for-each (lambda (x) (avr-bo! x) (avr-ap! f '(BOUNDED-OPS v v) 'CC x) (dk-cite! 'cc-magnitude-closed (list f x))) xs)
               (cond
                 ((and (= (length xs) 1) (null? ks))
                  (dk-lam-b!) (dk-cite! 'cc-magnitude-nonneg (list f (car xs))) (if (not (avr-done?)) (dk-ass!)))
                 ((= (length xs) 2)
                  (let* ((x (car xs)) (y (cadr xs)) (s (list 'BOP-SUM 'v 'v x y)))
                    (subst '(== (VADD (BH-MODULE v)) (BH-VADD v)))
                    (subst (dk-cite! 'bh-vadd-value 'v x y))
                    (dk-cite! 'bop-sum-bounded 'v 'v x y)
                    (dk-have! (list 'IN s '(VEC (BH-MODULE v))) (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!)))
                    (avr-ap! f '(BOUNDED-OPS v v) 'CC s)
                    (dk-lam-b!) (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                    (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                    (subst (dk-apply! addp x y))
                    (dk-have! (list 'AND (list 'IN (list f x) 'CC) (list 'IN (list f y) 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                    (avr-chain! (dk-cite! 'cc-magnitude-triangle (list f x) (list f y)) '())
                    (if (not (avr-done?)) (dk-ass!))))
                 (#t
                  (let* ((c (car ks)) (x (car xs)) (s (list 'BOP-SCALE 'v 'v c x)))
                    (dk-have! (list 'IN c 'CC)
                      (lambda () (let* ((h (avr-ctx (list 'IN c '(CARR (SCAL (BH-MODULE v))))))
                                        (h1 (dk-rewrite-h! h '(SCAL (BH-MODULE v)) avr-R2)))
                                   (dk-rewrite-h! h1 (list 'CARR avr-R2) 'CC) (if (not (avr-done?)) (dk-ass!)))))
                    (subst '(== (ACT (BH-MODULE v)) (BH-ACT v)))
                    (subst (dk-cite! 'bh-act-value 'v c x))
                    (dk-cite! 'bop-scale-bounded 'v 'v c x)
                    (dk-have! (list 'IN s '(VEC (BH-MODULE v))) (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!)))
                    (avr-ap! f '(BOUNDED-OPS v v) 'CC s)
                    (subst '(== (FNRM CC-NORMED-FIELD) (VNB-LAMBDA x_ CC (magnitude x_))))
                    (dk-lam-b!) (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                    (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                    (subst (dk-apply! sclp c x))
                    (dk-have! (list 'AND (list 'IN c 'CC) (list 'IN (list f x) 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                    (subst (avr-chain! (dk-cite! 'cc-magnitude-mul c (list f x)) '()))
                    (if (not (avr-done?)) (rfl)))))))))))))
(define (avr-replace e old new)
  (cond ((equal? e old) new) ((pair? e) (map (lambda (x) (avr-replace x old new)) e)) (#t e)))
(mac 'is-seminorm-family-on)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((avr-done?) #t)
        ((dk-ass!) #t)
        ((dk-head-is? g '=) (avr-scal-eq!))
        ((dk-head-is? g 'IN)                       ; the family is typed
         (mac 'WEAK-PAIRING-PF)
         (dk-lam-type!
           (lambda ()
             (let ((f (dk-di-var!)))
               (dk-split-all! (list (dk-cite! 'strong-dual-linear 'v f)))
               (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (avr-bo! x) (avr-ap! f '(BOUNDED-OPS v v) 'CC x)
                                           (dk-cite! 'cc-magnitude-closed (list f x)) (dk-ass!)))
                             (lambda () (subst '(== (VEC (BH-MODULE v)) (BOUNDED-OPS v v))) (dk-ass!)))))
           (lambda () (dk-ass!))))
        (#t
         (let* ((ld (dk-peel!))
                (f (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) avr-SD))) ld))
                (x (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC (BH-MODULE v))))) ld)))
           (cond
             (f                                    ; each one is a seminorm
              (mac 'WEAK-PAIRING-PF) (dk-lam-b!)
              (mac 'is-seminorm)
              (avr-semi-close! (cadr f)))
             (#t                                   ; separation, by the vector functionals
              (let* ((t (cadr x))
                     (hall (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld)))
                (avr-bo! t)
                (subst '(== (VZERO (BH-MODULE v)) (BOP-ZERO v v)))
                (dk-have! (list 'FORALL 'otp_ (list 'IMPLIES (list 'IN 'otp_ avr-VV) (list '= (list (list '(WOT-PF v) 'otp_) t) 0)))
                  (lambda ()
                    (let* ((p (dk-di-var!)))
                      (dk-split! (dk-cite! 'cartesian-nth p '(VEC v) '(VEC v)))
                      (let* ((p1 (list 'NTH 1 p)) (p2 (list 'NTH 2 p)) (vf (list 'VEC-FUNCTIONAL 'v p1 p2)))
                        (subst (dk-cite! 'wot-pf-apply 'v p t))
                        (dk-cite! 'vec-functional-in-strong-dual 'v p1 p2)
                        (let* ((h (dk-apply! hall vf))
                               (h1 (dk-rewrite-h! h (avr-wpf-at vf t) (caddr (dk-cite! 'weak-pairing-pf-apply 'v vf t)))))
                          (dk-rewrite-h! h1 (list vf t) (caddr (dk-cite! 'vec-functional-apply 'v p1 p2 t)))
                          (if (not (avr-done?)) (dk-ass!)))))))
                (dk-cite! 'wot-separating 'v t)
                (if (not (avr-done?)) (dk-ass!)))))))))))
(avr-done! 'weak-pairing-seminorm-family)

;; w<L(H), L.(H)> -> WOT: each p_(xi,eta) is the pairing seminorm of the vector functional
(define avr-ID '(ID-FUN (BOUNDED-OPS v v)))
(sp (make-wff (forall-guarded '(v) '((IS-COMPLEX-INNER-PRODUCT-SPACE v)) (list 'IS-HOM-TOP-SPACE avr-WPT '(WOT v) avr-ID))))
(dk-peel!)
(avr-mb-setup!)
(dk-cite! 'weak-pairing-seminorm-family 'v)
(dk-cite! 'wot-seminorm-family 'v)
(dk-cite! 'bh-id-linear 'v)
(dk-cite! 'rr-one-in) (dk-cite! 'rr-zero-in)
(define avr-sb (dk-cite! 'sn-cont-of-single-bound 'CC-NORMED-FIELD avr-MB avr-SD avr-WPF avr-MB avr-VV '(WOT-PF v) avr-ID))
(mac 'WEAK-PAIRING-TOP) (mac 'WOT)
(let ((imp (avr-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'IS-HOM-TOP-SPACE) (dk-head-is? (cadr f) 'FORALL))) "the bound")))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((p (dk-di-var!)))
        (dk-split! (dk-cite! 'cartesian-nth p '(VEC v) '(VEC v)))
        (let* ((p1 (list 'NTH 1 p)) (p2 (list 'NTH 2 p)) (vf (list 'VEC-FUNCTIONAL 'v p1 p2)))
          (dk-cite! 'vec-functional-in-strong-dual 'v p1 p2)
          (ew vf) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
          (ew 1)
          (dk-conj-close!
            (lambda ()
              (cond
                ((avr-done?) #t)
                ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) '<=) (dk-ineq! '(IN 1 RR)))
                (#t
                 (let ((x (dk-di-var!)))
                   (avr-bo! x)
                   (subst (dk-cite! 'id-fun-apply '(BOUNDED-OPS v v) x))
                   (subst (dk-cite! 'wot-pf-apply 'v p x))
                   (subst (dk-cite! 'weak-pairing-pf-apply 'v vf x))
                   (subst (dk-cite! 'vec-functional-apply 'v p1 p2 x))
                   (dk-cite! 'bop-fun 'v 'v x)
                   (avr-ap! x '(VEC v) '(VEC v) p1)
                   (dk-apply! (dk-cite! 'cips-ip-type 'v) (list x p1) p2)
                   (dk-cite! 'cc-magnitude-closed (list '(IP v) (list x p1) p2))
                   (dk-ineq! (list 'IN (list 'magnitude (list '(IP v) (list x p1) p2)) 'RR) '(IN 1 RR)))))))))))
  (avr-det! imp)
  (if (not (avr-done?)) (dk-ass!)))
(avr-done! 'weak-pairing-to-wot-continuous)

;; WOT -> w<L(H), L.(H)>: a strongly continuous phi is weakly continuous (5.7), so weak-dual-bound
(sp (make-wff (forall-guarded '(v) '((IS-HILBERT-SPACE v)) (list 'IS-HOM-TOP-SPACE '(WOT v) avr-WPT avr-ID))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(avr-mb-setup!)
(dk-cite! 'weak-pairing-seminorm-family 'v)
(dk-cite! 'wot-seminorm-family 'v)
(dk-cite! 'bh-id-linear 'v)
(dk-cite! 'id-fun-type '(BOUNDED-OPS v v))
(mac 'WEAK-PAIRING-TOP) (mac 'WOT)
(define avr-iff2 (avr-chain! (dk-cite! 'sn-cont-iff-bound-cc avr-MB avr-VV '(WOT-PF v) avr-MB avr-SD avr-WPF avr-ID) '()))
(dk-have! (caddr avr-iff2)
  (lambda ()
    (let* ((j (dk-di-var!)))
      (dk-cite! 'strong-dual-subset-weak-dual 'v j)
      (let* ((ff (dk-skolem! (dk-cite! 'weak-dual-bound 'v j) #t)))
        (dk-split-all!)
        (let* ((cb (dk-skolem! (avr-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h ff))) "constant") #t)))
          (dk-split-all!)
          (let ((body (avr-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cb) (dk-contains? h j))) "the bound")))
            (ew ff)
            (letrec ((cl (lambda ()
                           (cond
                             ((avr-done?) #t)
                             ((dk-ass!) #t)
                             ((dk-head-is? (dk-goal) 'FORSOME) (ew cb) (dk-conj-close! cl))
                             (#t
                              (let* ((ld (dk-peel!))
                                     (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC (BH-MODULE v))))) ld)))
                                     (tt (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
                                     (hall (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld)))
                                (avr-bo! x)
                                (subst (dk-cite! 'id-fun-apply '(BOUNDED-OPS v v) x))
                                (subst (dk-cite! 'weak-pairing-pf-apply 'v j x))
                                (dk-have! (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff)
                                            (list '<= (list 'magnitude (list '(IP v) (list x '(NTH 1 sbi_)) '(NTH 2 sbi_))) tt)))
                                  (lambda ()
                                    (let ((i (dk-di-var!)))
                                      (dk-cite! 'subset-mem-fwd ff avr-VV i)
                                      (let ((h (dk-apply! hall i)))
                                        (dk-rewrite-h! h (list (list '(WOT-PF v) i) x) (caddr (dk-cite! 'wot-pf-apply 'v i x)))
                                        (if (not (avr-done?)) (dk-ass!))))))
                                (avr-chain! (dk-apply! body x tt) '())
                                (if (not (avr-done?)) (dk-ass!))))))))
              (dk-conj-close! cl))))))))
(dk-have! (cadr avr-iff2) (lambda () (if (dk-only! avr-iff2 (caddr avr-iff2)) (prop))))
(if (not (avr-done?)) (dk-ass!))
(avr-done! 'wot-to-weak-pairing-continuous)

;; Proposition 5.6: the identity is a homeomorphism between WOT(v) and w<L(H), L.(H)>
(sp (make-wff (forall-guarded '(v) '((IS-HILBERT-SPACE v))
   (list 'AND (list 'IS-HOM-TOP-SPACE '(WOT v) avr-WPT avr-ID) (list 'IS-HOM-TOP-SPACE avr-WPT '(WOT v) avr-ID)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'wot-to-weak-pairing-continuous 'v)
(dk-cite! 'weak-pairing-to-wot-continuous 'v)
(dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
(avr-done! 'wot-is-strong-dual-pairing)
