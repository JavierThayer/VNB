;;; the companion of amp-vector-exists: the same amplification and vector, and the invariant
(define (avr-gex2 g)
  (list 'FORSOME 'cqw_ (list 'AND '(IN cqw_ SET)
    (list 'FORSOME 'cqf_ (list 'AND '(IN cqf_ SET)
      (list 'AND '(IS-AMPLIFICATION v s cqw_ cqf_)
        (list 'AND (avr-rep 'cqw_ 'cqf_)
          (list 'FORSOME 'cqx_ (list 'AND '(IN cqx_ (VEC cqw_)) (avr-gbound 'cqw_ 'cqf_ 'cqx_ g))))))))))
(define (avr-gex2-close! ww ff xx)
  (define (closer)
    (let ((g (dk-goal)))
      (cond ((avr-done?) #t)
            ((dk-head-is? g 'FORSOME)
             (ew (case (cadr g) ((cqw_) ww) ((cqf_) ff) ((cqx_) xx) (else (error "avr-gex2-close!: binder" (cadr g)))))
             (dk-conj-close! closer))
            ((dk-ass!) #t)
            (#t (error "avr-gex2-close!: stuck at" (expression->string g))))))
  (closer))
(define avr-cls (list 'COMP 'cqg_ (list 'IMPLIES '(SUBSET cqg_ (VEC v)) (avr-gex2 'cqg_))))
(sp (make-wff (forall-guarded '(v s gg_)
   (append avr-Hsub '((IN gg_ SET) (IN (CARD gg_) NN) (SUBSET gg_ (VEC v))))
   (avr-gex2 'gg_))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'empty-set-is-set)
;; base
(dk-have! (list 'IN 'EMPTY-SET avr-cls)
  (lambda ()
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (if (equal? (dk-goal) '(IN EMPTY-SET SET))
            (dk-ass!)
            (begin
              (di)
              (dk-cite! 'is-complex-inner-product-space-is-set 'v)
              (let ((ty (dk-cite! 'id-rep-type 'v)))
                (dk-cite! 'membership-implies-sethood '(ID-REP v) (caddr ty)))
              (dk-cite! 'amplification-base 'v 's)
              (dk-cite! 'amp-rep-base 'v)
              (dk-cite! 'cips-vzero-in 'v)
              (dk-have! (avr-gbound 'v '(ID-REP v) '(VZERO v) 'EMPTY-SET)
                (lambda ()
                  (let* ((pl (dk-peel!))
                         (m (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'EMPTY-SET))) pl)))
                         (ne (dk-cite! 'empty-set-has-no-members (cadr m))))
                    (let ((leaf (proof-state-focus *ps*)))
                      (dk-only! m ne)
                      (if (not (sequent-node-grounded? leaf)) (prop))))))
              (avr-gex2-close! 'v '(ID-REP v) '(VZERO v)))))
      (dk-opened (lambda () (comp-mi))))))
;; step
(define avr-stp
  (list 'FORALL 'cqu_
    (list 'IMPLIES (list 'AND '(IN cqu_ SET) (list 'AND '(IN (CARD cqu_) NN) (list 'IN 'cqu_ avr-cls)))
      (list 'FORALL 'cqz_
        (list 'IMPLIES '(AND (IN cqz_ SET) (NOT (IN cqz_ cqu_)))
              (list 'IN '(UNION cqu_ (PAIR cqz_ cqz_)) avr-cls))))))
(dk-have! avr-stp
  (lambda ()
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (t1 (cadr gl))
           (u  (cadr t1))
           (z  (cadr (caddr t1)))
           (pr (list 'PAIR z z))
           (ih (dk-landed-find (lambda () (comp-me (list 'IN u avr-cls))) (dk-head? 'IMPLIES))))
      (avr-and! (list 'IN z 'SET) (list 'IN z 'SET))
      (dk-cite! 'pairing z z)
      (avr-and! (list 'IN u 'SET) (list 'IN pr 'SET))
      (dk-cite! 'union-set-closure u pr)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) (list 'IN t1 'SET))
             (dk-ass!)
             (begin
               (di)
               (dk-have! (list 'SUBSET u '(VEC v))
                 (lambda ()
                   (mac 'subset-def)
                   (let* ((y (dk-di-var!))
                          (um (dk-cite! 'union-membership u pr y)))
                     (avr-prop! (list 'IN y t1) um (list 'IN y u))
                     (dk-cite! 'subset-mem-fwd t1 '(VEC v) y)
                     (if (not (avr-done?)) (dk-ass!)))))
               (let ((pm (dk-apply! (dk-cite! 'pairing-membership z z) z)))
                 (dk-have! (list '= z z) (lambda () (rfl)))
                 (avr-prop! (list 'IN z pr) pm (list '= z z)))
               (let ((um (dk-cite! 'union-membership u pr z)))
                 (avr-prop! (list 'IN z t1) um (list 'IN z pr)))
               (dk-cite! 'subset-mem-fwd t1 '(VEC v) z)
               (detach! ih)
               (let* ((ex (caddr ih))
                      (w (dk-skolem! ex #t))
                      (exf (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqf_) (dk-contains? h w))) "f"))
                      (f (dk-skolem! exf #t)))
                 (dk-split-all!)
                 (let* ((exx (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqx_) (dk-contains? h f))) "X"))
                        (x (dk-skolem! exx #t))
                        (amp (list 'IS-AMPLIFICATION 'v 's w f)))
                   (dk-split-all!)
                   (dk-project! (list 'IS-HILBERT-SPACE w) 'is-amplification amp)
                   (dk-project! (list 'IS-STAR-REP 'v w f) 'is-amplification amp)
                   (dk-project! (list 'IN f (list 'FUN '(BOUNDED-OPS v v) (list 'BOUNDED-OPS w w))) 'is-star-rep (list 'IS-STAR-REP 'v w f))
                   (dk-cite! 'hilbert-space-is-cips w)
                   (dk-split-all! (list (dk-cite! 'amp-vector-step-explicit 'v 's w f x u z)))
                   (dk-cite! 'amp-rep-step w 'v f)
                   (dk-cite! 'hsum-is-set w 'v)
                   (let ((ty (dk-cite! 'amp-step-type w 'v f)))
                     (dk-cite! 'membership-implies-sethood (list 'AMP-STEP 'v w f) (caddr ty)))
                   (avr-gex2-close! (list 'HSUM w 'v) (list 'AMP-STEP 'v w f) (list 'LIST x z)))))))
       (dk-opened (lambda () (comp-mi)))))))
(dk-have! (list 'AND (list 'IN 'EMPTY-SET avr-cls) avr-stp)
          (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(let ((ind (dk-fact! 'finite-set-induction avr-cls)))
  (avr-and! '(IN gg_ SET) '(IN (CARD gg_) NN))
  (let* ((inw (dk-apply! ind 'gg_))
         (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
    (detach! body)
    (if (not (avr-done?)) (dk-ass!))))
(avr-done! 'amp-vector-exists-sum)

