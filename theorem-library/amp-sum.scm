;;; amp-sum.scm -- agent BA-1117-TRACE (round 3), 2026-11-17.
;;; A companion of amp-vector-exists (theorem-library/ba-amp.scm, unchanged) that exposes what the
;;; iterated Hilbert sum H (+) ... (+) H with f(T) = T (+) ... (+) T gives: for all X, Y in w,
;;; <f(T) X | Y>_w = sum_(k < n) <T a_k | b_k> for some n in NN and sequences a, b in H.  Then the
;;; necessity of Proposition 5.1 (strong-dual-finite-sum).
;;; The amplification is still built one summand at a time (C2's finite-set induction); the n-term
;;; sum is carried as an invariant (amp-rep-base, amp-rep-step), so no H^n vocabulary is needed.
;;; DESTINATION: theorem-library/amp-sum.scm, after theorem-library/ba-amp.scm and sub-riesz.scm.
;;; Library: operator-algebras.  Helper prefix avr- (the ba-amp helpers am-*, copied and renamed).
;;; Nothing asserted.
(define (avr-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (avr-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** amp-sum: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define avr-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define avr-HS '(HSUM w v))
(define avr-HV '(CARTESIAN (VEC w) (VEC v)))
(define (avr-vadd u a b) (list (list 'VADD u) a b))
(define (avr-vneg u a) (list (list 'VNEG u) a))
(define (avr-act u c a) (list (list 'ACT u) c a))
(define (avr-nrm u a) (list 'IP-NORM u a))
(define (avr-pr a b) (list 'LIST a b))

;;; the space a vector class belongs to: (VEC u) -> u
(define (avr-space-of c) (and (dk-head-is? c 'VEC) (cadr c)))
(define (avr-hsum? u) (dk-head-is? u 'HSUM))
(define (avr-cart-of u) (list 'CARTESIAN (list 'VEC (cadr u)) (list 'VEC (caddr u))))

;;; (= (VEC (HSUM a b)) (CARTESIAN (VEC a) (VEC b))) in context
(define (avr-hsum-eq! u)
  (let ((g (list '= (list 'VEC u) (avr-cart-of u))))
    (if (not (dk-asm? g)) (dk-cite! 'hsum-vec-eq (cadr u) (caddr u)))
    g))
(define (avr-cips! u)
  (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE u)))
      (if (avr-hsum? u)
          (begin (avr-cips! (cadr u)) (avr-cips! (caddr u)) (dk-cite! 'hsum-is-cips (cadr u) (caddr u)))
          (error "avr-cips!: no CIPS for" (expression->string u)))))

;;; the class of an operator term f: (FUN A B) or (BOUNDED-OPS a b), landing its typing
(define (avr-class-of f)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) f)
                                     (or (dk-head-is? (caddr h) 'FUN) (dk-head-is? (caddr h) 'BOUNDED-OPS))))
                    (dk-asms))))
    (cond ((pair? (filter (lambda (h) (dk-head-is? (caddr h) 'FUN)) hs))
           (caddr (car (filter (lambda (h) (dk-head-is? (caddr h) 'FUN)) hs))))
          ((pair? hs)
           (let ((c (caddr (car hs))))
             (dk-cite! 'bop-fun (cadr c) (caddr c) f)
             (list 'FUN (list 'VEC (cadr c)) (list 'VEC (caddr c)))))
          ((and (pair? f) (not (symbol? (car f))) )
           ;; an applied representation (phi t): phi in FUN(X, Y)
           (let* ((g (car f)) (gc (avr-class-of g)))
             (if (and (dk-head-is? gc 'FUN) (= (length f) 2))
                 (begin (avr-type! (cadr f) (cadr gc))
                        (dk-cite! 'fun-apply-type-c g (cadr gc) (caddr gc) (cadr f))
                        (avr-class-of f))
                 (error "avr-class-of: no class for" (expression->string f)))))
          ((and (pair? f) (symbol? (car f)) (= (length f) 2) (not (memq (car f) '(VADD VNEG ACT IP))))
           (let ((gc (avr-class-of (car f))))
             (if (dk-head-is? gc 'FUN)
                 (begin (avr-type! (cadr f) (cadr gc))
                        (dk-cite! 'fun-apply-type-c (car f) (cadr gc) (caddr gc) (cadr f))
                        (avr-class-of f))
                 (error "avr-class-of: no class for" (expression->string f)))))
          (#t (error "avr-class-of: no class for" (expression->string f))))))

;;; land (IN t c)
(define (avr-type! t c)
  (cond
    ((dk-asm? (list 'IN t c)) #t)
    ((and (dk-head-is? c 'VEC) (avr-hsum? (cadr c)))
     (let ((eq (avr-hsum-eq! (cadr c))))
       (avr-type! t (caddr eq))
       (dk-have! (list 'IN t c) (lambda () (subst eq) (if (not (avr-done?)) (dk-ass!))))))
    ((and (dk-head-is? c 'CARTESIAN) (dk-head-is? t 'LIST))
     (avr-type! (cadr t) (cadr c)) (avr-type! (caddr t) (caddr c))
     (dk-cite! 'pair-in-cartesian (cadr c) (caddr c) (cadr t) (caddr t)))
    ((and (dk-head-is? c 'CARTESIAN) (= (length c) 3) (dk-head-is? (cadr c) 'VEC) (dk-head-is? (caddr c) 'VEC)
          (pair? (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) t)
                                           (equal? (caddr h) (list 'VEC (list 'HSUM (cadr (cadr c)) (cadr (caddr c)))))))
                         (dk-asms))))
     (let ((eq (avr-hsum-eq! (list 'HSUM (cadr (cadr c)) (cadr (caddr c))))))
       (dk-have! (list 'IN t c) (lambda () (subst (list '= (caddr eq) (cadr eq))) (if (not (avr-done?)) (dk-ass!))))))
    ((and (dk-head-is? t 'VZERO) (equal? c (list 'VEC (cadr t))))
     (avr-cips! (cadr t)) (dk-cite! 'cips-vzero-in (cadr t)))
    ((and (pair? t) (dk-head-is? (car t) 'VADD) (equal? c (list 'VEC (cadr (car t)))))
     (avr-cips! (cadr (car t))) (avr-type! (cadr t) c) (avr-type! (caddr t) c)
     (dk-cite! 'cips-vadd-type (cadr (car t)) (cadr t) (caddr t)))
    ((and (pair? t) (dk-head-is? (car t) 'VNEG) (equal? c (list 'VEC (cadr (car t)))))
     (avr-cips! (cadr (car t))) (avr-type! (cadr t) c)
     (dk-cite! 'cips-vneg-type (cadr (car t)) (cadr t)))
    ((and (pair? t) (dk-head-is? (car t) 'ACT) (equal? c (list 'VEC (cadr (car t)))))
     (avr-cips! (cadr (car t))) (avr-type! (caddr t) c)
     (dk-cite! 'cips-act-type (cadr (car t)) (cadr t) (caddr t)))
    ((and (pair? t) (= (length t) 2))
     (let ((fc (avr-class-of (car t))))
       (avr-type! (cadr t) (cadr fc))
       (dk-cite! 'fun-apply-type-c (car t) (cadr fc) (caddr fc) (cadr t))
       (if (not (equal? (caddr fc) c))
           (avr-type! t c))))
    (#t (error "avr-type!: no route" (expression->string (list 'IN t c))))))

;;; NTH reduction on the goal, landing set typings of the vectors involved
(define (avr-sets! e)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (pair? (caddr h)) (dk-contains? e (cadr h))
                       (not (eq? (caddr h) 'SET)) (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (avr-nth!)
  (let loop ((k 0))
    (if (and (< k 40) (not (avr-done?)) (dk-contains? (dk-goal) 'NTH)
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (avr-sets! (dk-goal)) (nth-r) (loop (+ k 1))))))
(define (avr-rfl!)
  (if (not (avr-done?))
      (begin (avr-sets! (dk-goal)) (rfl))))

;;; ineq over products: name each product P of PRODS (typed in RR by dk-real!), rewrite the HYPS and the
;;; goal with the names, then dk-ineq! on the rewritten hyps plus the RR typings in TYPS
(define (avr-ineq! prods hyps typs)
  (for-each dk-real! prods)
  (let loop ((ps prods) (hs hyps))
    (if (null? ps)
        (let ((names (map (lambda (p) (cadr (avr-ctx-form-name p))) prods)))
          (apply dk-ineq! (append hs (map (lambda (n) (list 'IN n 'RR)) names) typs)))
        (let* ((p (car ps)) (n (dk-name! p)))
          (if (dk-contains? (dk-goal) p) (subst (list '= p n)))
          (loop (cdr ps) (map (lambda (h) (if (dk-contains? h p) (dk-rewrite-h! h p n) h)) hs))))))
(define (avr-ctx-form-name p)
  (car (filter (lambda (h) (and (dk-head-is? h '=) (symbol? (cadr h)) (equal? (caddr h) p))) (dk-asms))))

(define (avr-pairify! p u)
  (let ((cart (avr-cart-of u)))
    (avr-type! p cart)
    (dk-split! (dk-cite! 'cartesian-nth p (cadr cart) (caddr cart)))
    (let ((e (dk-cite! 'cartesian-pair-eq p (cadr cart) (caddr cart))))
      (subst e)
      (list (list 'NTH 1 p) (list 'NTH 2 p)))))

(define avr-BOv '(BOUNDED-OPS v v))
(define (avr-ft! a)                    ; f a in L(w), as a function too
  (avr-type! (list 'f_ a) '(BOUNDED-OPS w w))
  (dk-cite! 'bop-fun 'w 'w (list 'f_ a)))
(define avr-Hsub (list '(IS-HILBERT-SPACE v) (list 'SUBSET 's avr-BOv)))
(define (avr-dif u x y) (avr-vadd u x (avr-vneg u y)))
(define (avr-gbound w f x g)
  (list 'FORALL 'cqa_ (list 'IMPLIES (list 'IN 'cqa_ avr-BOv)
    (list 'FORALL 'cqb_ (list 'IMPLIES (list 'IN 'cqb_ avr-BOv)
      (list 'FORALL 'cqy_ (list 'IMPLIES (list 'IN 'cqy_ g)
        (list '<= (avr-nrm 'v (avr-dif 'v '(cqa_ cqy_) '(cqb_ cqy_)))
                  (avr-nrm w (avr-dif w (list (list f 'cqa_) x) (list (list f 'cqb_) x)))))))))))
(define (avr-gex g)
  (list 'FORSOME 'cqw_ (list 'AND '(IN cqw_ SET)
    (list 'FORSOME 'cqf_ (list 'AND '(IN cqf_ SET)
      (list 'AND '(IS-AMPLIFICATION v s cqw_ cqf_)
        (list 'FORSOME 'cqx_ (list 'AND '(IN cqx_ (VEC cqw_)) (avr-gbound 'cqw_ 'cqf_ 'cqx_ g)))))))))
(define (avr-and! p q)
  (let ((c (list 'AND p q)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!)))))))
    c))
(define (avr-prop! claim . keep)
  (if (not (dk-asm? claim))
      (dk-have! claim (lambda () (let ((leaf (proof-state-focus *ps*)))
                                   (apply dk-only! keep)
                                   (if (not (sequent-node-grounded? leaf)) (prop))))))
  claim)
;;; close a goal (avr-gex g) instantiated: witnesses by binder, BOUND! for the bound clause
(define (avr-gex-close! ww ff xx bound!)
  (define (closer)
    (let ((g (dk-goal)))
      (cond ((avr-done?) #t)
            ((dk-head-is? g 'FORSOME)
             (ew (case (cadr g) ((cqw_) ww) ((cqf_) ff) ((cqx_) xx) (else (error "avr-gex-close!: binder" (cadr g)))))
             (dk-conj-close! closer))
            ((dk-ass!) #t)
            ((dk-head-is? g 'FORALL) (bound!))
            (#t (error "avr-gex-close!: stuck at" (expression->string g))))))
  (closer))

(define (avr-vec-sets!)
  (dk-cite! 'cips-vec-set 'w) (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'cips-vzero-in 'w) (dk-cite! 'cips-vzero-in 'v)
  (avr-cips! avr-HS))
(define avr-AG '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG))
;;; a constant c with (= c LAM) and (IN c (FUN NN (VEC v))); TYPER proves the lambda's typing
(define (avr-name! lam typer)
  (dk-have! (list 'IN lam '(FUN NN (VEC v))) typer)
  (dk-have! (list 'FORSOME 'avc_ (list 'AND '(IN avc_ (FUN NN (VEC v))) (list '= 'avc_ lam)))
    (lambda () (ew lam) (dk-conj-close! (lambda () (cond ((avr-done?) #t) ((dk-ass!) #t) (#t (rfl)))))))
  (let ((c (dk-skolem! (dk-ctx-form (list 'FORSOME 'avc_ (list 'AND '(IN avc_ (FUN NN (VEC v))) (list '= 'avc_ lam)))) #t)))
    (dk-split-all!)
    c))
(define (avr-done! name) (avr-qed! name))
(define (avr-ctx f) (or (dk-ctx-form f) (error "avr-ctx: not in context" (expression->string f))))
(define (avr-summand w a b) (list 'VNB-LAMBDA 'avi_ (list 'ORD-SEGMENT w) (list '(IP v) (list 'avt_ (list a 'avi_)) (list b 'avi_))))
;;; the invariant: <f(T) X | Y>_w is an n-term sum of vector functionals of v
(define (avr-rep w f)
  (list 'FORALL 'avp_ (list 'IMPLIES (list 'IN 'avp_ (list 'VEC w))
   (list 'FORALL 'avq_ (list 'IMPLIES (list 'IN 'avq_ (list 'VEC w))
    (list 'FORSOME 'avn_ (list 'AND '(IN avn_ NN)
     (list 'FORSOME 'ava_ (list 'AND '(IN ava_ (FUN NN (VEC v)))
      (list 'FORSOME 'avb_ (list 'AND '(IN avb_ (FUN NN (VEC v)))
       (list 'FORALL 'avt_ (list 'IMPLIES '(IN avt_ (BOUNDED-OPS v v))
         (list '= (list (list 'IP w) (list (list f 'avt_) 'avp_) 'avq_)
                  (list 'FINSUM avr-AG (avr-summand 'avn_ 'ava_ 'avb_) '(ORD-SEGMENT avn_))))))))))))))))
;;; the summand at a given T, n, a, b
(define (avr-g T n a b)
  (list 'VNB-LAMBDA 'avi_ (list 'ORD-SEGMENT n) (list '(IP v) (list T (list a 'avi_)) (list b 'avi_))))
;;; (IN g (FUN (ORD-SEGMENT m) CC)) for m in NN, a b in FUN(NN, VEC v), T in L(v)
(define (avr-seg! m)
  (if (not (dk-asm? (list 'IN (list 'ORD-SEGMENT m) 'SET)))
      (begin (dk-cite! 'nn-subset-ord m) (dk-cite! 'ord-segment-is-set m)
             (let ((c (dk-cite! 'card-segment m)))
               (dk-have! (list 'IN (list 'CARD (list 'ORD-SEGMENT m)) 'NN) (lambda () (subst c) (dk-ass!)))))))
(define (avr-g-type! T m a b)
  (avr-seg! m)
  (let ((g (avr-g T m a b)))
    (dk-cite! 'bop-fun 'v 'v T)
    (dk-have! (list 'IN g (list 'FUN (list 'ORD-SEGMENT m) 'CC))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((i (dk-di-var!)))
              (dk-cite! 'ord-segment-nn-subset m i)
              (dk-cite! 'fun-apply-type-c a 'NN '(VEC v) i)
              (dk-cite! 'fun-apply-type-c b 'NN '(VEC v) i)
              (dk-cite! 'fun-apply-type-c T '(VEC v) '(VEC v) (list a i))
              (dk-apply! (dk-cite! 'cips-ip-type 'v) (list T (list a i)) (list b i))
              (if (not (avr-done?)) (dk-ass!))))
          (lambda () (dk-ass!)))))
    g))
(define (avr-ag!) (dk-cite! 'cc-nag-ag-is-abelian-group) (dk-cite! 'cc-nag-ag-carr))
(define (avr-norm-carr! g) (if (dk-contains? (dk-goal) (list 'CARR avr-AG)) (subst (list '== (list 'CARR avr-AG) 'CC))))

;;; =============================================================================================
;;; the step with its witnesses explicit: (HSUM w v, AMP-STEP v w f, (x, z)) for G u {z}
(define avr-AMPs '(AMP-STEP v w f_))
(define avr-T1 '(UNION u_ (PAIR z_ z_)))
(sp (make-wff (forall-guarded '(v s w f_ x_ u_ z_)
   (append avr-Hsub (list '(IS-AMPLIFICATION v s w f_) '(IN x_ (VEC w)) '(IN z_ (VEC v)) '(SUBSET u_ (VEC v))
                         (avr-gbound 'w 'f_ 'x_ 'u_)))
   (list 'AND (list 'IS-AMPLIFICATION 'v 's avr-HS avr-AMPs)
         (list 'AND (list 'IN '(LIST x_ z_) (list 'VEC avr-HS)) (avr-gbound avr-HS avr-AMPs '(LIST x_ z_) avr-T1))))))
(dk-peel!)
(dk-cite! 'amplification-step 'v 's 'w 'f_)
(dk-project! '(IS-HILBERT-SPACE w) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-project! '(IS-STAR-REP v w f_) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-project! '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))) 'is-star-rep '(IS-STAR-REP v w f_))
(dk-cite! 'hilbert-space-is-cips 'w) (dk-cite! 'hilbert-space-is-cips 'v)
(avr-vec-sets!)
(dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
(avr-cips! avr-HS)
(dk-cite! 'hsum-is-set 'w 'v)
(let ((ty (dk-cite! 'amp-step-type 'w 'v 'f_)))
  (dk-cite! 'membership-implies-sethood avr-AMPs (caddr ty)))
(avr-type! '(LIST x_ z_) (list 'VEC avr-HS))
(define avr-bU (avr-gbound 'w 'f_ 'x_ 'u_))
(define avr-BOhs (list 'BOUNDED-OPS avr-HS avr-HS))
(define (avr-hs-norm-rr! a b)
  (let* ((X '(LIST x_ z_))
         (ya (list (list avr-AMPs a) X)) (yb (list (list avr-AMPs b) X))
         (vec (avr-dif avr-HS ya yb)))
    (for-each (lambda (o)
                (dk-cite! 'fun-apply-type-c avr-AMPs avr-BOv avr-BOhs o)
                (dk-cite! 'bop-fun avr-HS avr-HS (list avr-AMPs o))
                (dk-cite! 'fun-apply-type-c (list avr-AMPs o) (list 'VEC avr-HS) (list 'VEC avr-HS) X))
              (list a b))
    (dk-cite! 'cips-vneg-type avr-HS yb)
    (dk-cite! 'cips-vadd-type avr-HS ya (avr-vneg avr-HS yb))
    (dk-cite! 'ip-norm-in-rr avr-HS vec)))
(define (avr-step-bound!)
    (let* ((pl (dk-peel!))
           (ops (map cadr (filter (lambda (f) (equal? (caddr f) avr-BOv)) pl)))
           (a (car ops)) (b (cadr ops))
           (y (cadr (car (filter (lambda (f) (equal? (caddr f) avr-T1)) pl))))
           (D (avr-nrm avr-HS (avr-dif avr-HS (list (list avr-AMPs a) '(LIST x_ z_)) (list (list avr-AMPs b) '(LIST x_ z_))))))
      (dk-cite! 'membership-implies-sethood 'z_ '(VEC v))
      (avr-and! '(IN z_ SET) '(IN z_ SET))
      (let* ((um (dk-cite! 'union-membership 'u_ '(PAIR z_ z_) y)))
        (use-em (list 'IN y 'u_)
          (lambda ()
            (dk-cite! 'subset-mem-fwd 'u_ '(VEC v) y)
            (let* ((h1 (dk-apply! avr-bU a b y))
                   (h2 (dk-cite! 'amp-step-norm-ge-1 'w 'v 'f_ a b 'x_ 'z_))
                   (va (avr-dif 'v (list a y) (list b y)))
                   (vw (avr-dif 'w (list (list 'f_ a) 'x_) (list (list 'f_ b) 'x_))))
              (avr-ft! a) (avr-ft! b)
              (avr-type! va '(VEC v)) (avr-type! vw '(VEC w))
              (let* ((r1 (dk-cite! 'ip-norm-in-rr 'v va))
                     (r2 (dk-cite! 'ip-norm-in-rr 'w vw))
                     (r3 (avr-hs-norm-rr! a b)))
                (dk-ineq! h1 h2 r1 r2 (list 'IN D 'RR)))))
          (lambda ()
            (dk-cite! 'pairing 'z_ 'z_)
            (avr-prop! (list 'IN y '(PAIR z_ z_)) um (list 'IN y avr-T1) (list 'NOT (list 'IN y 'u_)))
            (let ((pm (dk-apply! (dk-cite! 'pairing-membership 'z_ 'z_) y)))
              (avr-prop! (list '= y 'z_) pm (list 'IN y '(PAIR z_ z_)))
              (subst (list '= y 'z_))
              (dk-cite! 'amp-step-norm-ge-2 'w 'v 'f_ a b 'x_ 'z_)
              (if (not (avr-done?)) (dk-ass!))))))))
(dk-conj-close!
  (lambda ()
    (cond ((avr-done?) #t)
          ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) 'FORALL) (avr-step-bound!))
          (#t (error "step: stuck at" (expression->string (dk-goal)))))))
(avr-done! 'amp-vector-step-explicit)

;;; =============================================================================================
;;; the invariant for the identity representation: <T X | Y> is a one-term sum
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (avr-rep 'v '(ID-REP v))))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(avr-ag!)
(dk-cite! 'nn-zero-in) (dk-cite! 'nn-is-set)
(dk-cite! 'nn-succ-closed 0)
(let* ((ld (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))) (dk-asms)))
       (X (cadr (find-first (lambda (h) (eq? (cadr h) 'avp_)) ld)))
       (Y (cadr (find-first (lambda (h) (eq? (cadr h) 'avq_)) ld)))
       (la (list 'VNB-LAMBDA 'avk_ 'NN X)) (lb (list 'VNB-LAMBDA 'avk_ 'NN Y))
       (A (avr-name! la (lambda () (dk-lam-type! (lambda () (dk-di-var!) (dk-ass!)) (lambda () (dk-ass!))))))
       (B (avr-name! lb (lambda () (dk-lam-type! (lambda () (dk-di-var!) (dk-ass!)) (lambda () (dk-ass!)))))))
  (ew '(SUCC 0)) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
  (ew A) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
  (ew B) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
  (let* ((T (dk-di-var!)) (g (avr-g T '(SUCC 0) A B)))
    (dk-cite! 'id-rep-apply 'v T)
    (subst (list '= (list '(ID-REP v) T) T))
    (dk-cite! 'bop-fun 'v 'v T)
    (dk-cite! 'fun-apply-type-c T '(VEC v) '(VEC v) X)
    (avr-g-type! T '(SUCC 0) A B)
    (dk-have! (list 'IN g (list 'FUN '(ORD-SEGMENT (SUCC 0)) (list 'CARR avr-AG))) (lambda () (avr-norm-carr! #t) (dk-ass!)))
    (subst (dk-cite! 'finsum-ord-peel avr-AG 0 g))
    (subst (dk-cite! 'ord-segment-zero))
    (subst (dk-cite! 'finsum-empty avr-AG g))
    (subst (dk-cite! 'cc-nag-ag-iden))
    (dk-have! (list '= (list g 0) (list '(IP v) (list T X) Y))
      (lambda ()
        (dk-cite! 'ord-segment-succ-top 0)
        (dk-lam-b!)
        (subst (list '= A la)) (dk-lam-b!)
        (subst (list '= B lb)) (dk-lam-b!)
        (if (not (avr-done?)) (rfl))))
    (subst (list '= (list g 0) (list '(IP v) (list T X) Y)))
    (dk-apply! (dk-cite! 'cips-ip-type 'v) (list T X) Y)
    (dk-cite! 'cc-zero-in)
    (subst (dk-cite! 'cc-nag-ag-opr 0 (list '(IP v) (list T X) Y)))
    (if (not (avr-done?)) (crs))))
(avr-done! 'amp-rep-base)

;;; the invariant passes to the step T |-> f(T) (+) T: <(f(T) (+) T)(x, z) | (y, u)> = <f(T)x | y> + <Tz | u>,
;;; and the sum gains the term k = n with a_n = z, b_n = u
(sp (make-wff (forall-guarded '(w v f_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
         '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))) (avr-rep 'w 'f_))
   (avr-rep avr-HS avr-AMPs))))
(dk-peel!)
(avr-vec-sets!)
(avr-ag!)
(dk-cite! 'nn-is-set)
(define avr-IH (avr-ctx (avr-rep 'w 'f_)))
(let* ((ld (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'VEC avr-HS)))) (dk-asms)))
       (P (cadr (find-first (lambda (h) (eq? (cadr h) 'avp_)) ld)))
       (Q (cadr (find-first (lambda (h) (eq? (cadr h) 'avq_)) ld)))
       (pp (avr-pairify! P avr-HS)) (qq (avr-pairify! Q avr-HS))
       (p1 (car pp)) (p2 (cadr pp)) (q1 (car qq)) (q2 (cadr qq)))
  (let* ((ex (dk-apply! avr-IH p1 q1))
         (n (dk-skolem! ex #t)))
    (dk-split-all!)
    (let* ((exa (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'ava_) (dk-contains? h n))) "a"))
           (A (dk-skolem! exa #t)))
      (dk-split-all!)
      (let* ((exb (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'avb_) (dk-contains? h A))) "b"))
             (B (dk-skolem! exb #t)))
        (dk-split-all!)
        (let* ((rep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h A) (dk-contains? h B) (dk-contains? h 'FINSUM))) "rep"))
               (n1 (list 'SUCC n))
               (la (list 'VNB-LAMBDA 'avk_ 'NN (list 'IF (list '= 'avk_ n) p2 (list A 'avk_))))
               (lb (list 'VNB-LAMBDA 'avk_ 'NN (list 'IF (list '= 'avk_ n) q2 (list B 'avk_))))
               (typer (lambda (z c)
                        (lambda ()
                          (dk-lam-type!
                            (lambda ()
                              (let* ((k (dk-di-var!)) (ift (list 'IF (list '= k n) z (list c k))))
                                (dk-cite! 'fun-apply-type-c c 'NN '(VEC v) k)
                                (dk-case-if! ift (lambda (tr val) (if (not (avr-done?)) (dk-ass!))))))
                            (lambda () (dk-ass!))))))
               (A2 (avr-name! la (typer p2 A)))
               (B2 (avr-name! lb (typer q2 B))))
          (dk-cite! 'nn-succ-closed n)
          (ew n1) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
          (ew A2) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
          (ew B2) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!))))
          (let* ((T (dk-di-var!))
                 (fT (list 'f_ T))
                 (g (avr-g T n A B)) (g2 (avr-g T n1 A2 B2))
                 (S (list 'FINSUM avr-AG g (list 'ORD-SEGMENT n)))
                 (t2 (list '(IP v) (list T p2) q2)))
            ;; the left side
            (subst (dk-cite! 'amp-step-apply 'w 'v 'f_ T))
            (avr-ft! T)
            (dk-cite! 'bop-fun 'v 'v T)
            (subst (dk-cite! 'hsum-diag-apply 'w 'v fT T p1 p2))
            (dk-cite! 'fun-apply-type-c fT '(VEC w) '(VEC w) p1)
            (dk-cite! 'fun-apply-type-c T '(VEC v) '(VEC v) p2)
            (subst (dk-cite! 'hsum-ip-pair 'w 'v (list fT p1) (list T p2) q1 q2))
            (let ((ih (dk-apply! rep T)))
              (subst ih)
              ;; the right side
              (avr-g-type! T n A B)
              (avr-g-type! T n1 A2 B2)
              (dk-have! (list 'IN g2 (list 'FUN (list 'ORD-SEGMENT n1) (list 'CARR avr-AG))) (lambda () (avr-norm-carr! #t) (dk-ass!)))
              (subst (dk-cite! 'finsum-ord-peel avr-AG n g2))
              (dk-cite! 'ord-segment-self n)
              (dk-have! (list 'FORALL 'avz_ (list 'IMPLIES (list 'IN 'avz_ (list 'ORD-SEGMENT n)) (list '= (list g2 'avz_) (list g 'avz_))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (dk-cite! 'ord-segment-succ-sub n z)
                    (dk-cite! 'ord-segment-nn-subset n z)
                    (dk-cite! 'fun-apply-type-c A 'NN '(VEC v) z)
                    (dk-cite! 'fun-apply-type-c B 'NN '(VEC v) z)
                    (dk-cite! 'fun-apply-type-c T '(VEC v) '(VEC v) (list A z))
                    (dk-apply! (dk-cite! 'cips-ip-type 'v) (list T (list A z)) (list B z))
                    (dk-have! (list 'NOT (list '= z n))
                      (lambda () (use-em (list '= z n)
                                   (lambda () (let ((h (dk-rewrite-h! (list 'IN z (list 'ORD-SEGMENT n)) z n)))
                                                (dk-only! h (list 'NOT h))
                                                (prop)))
                                   (lambda () (dk-ass!)))))
                    (dk-lam-b!)
                    (if (not (avr-done?))
                      (begin
                        (subst (list '= A2 la)) (subst (list '= B2 lb))
                        (dk-lam-b!)
                        (if (not (avr-done?))
                          (dk-if-branch! #f (list 'IF (list '= z n) p2 (list A z)) #f
                            (lambda ()
                              (dk-if-branch! #f (list 'IF (list '= z n) q2 (list B z)) #f
                                (lambda () (if (not (avr-done?)) (rfl))))))))))))
              (avr-seg! n)
              (subst (dk-cite! 'finsum-congruence-q avr-AG (list 'ORD-SEGMENT n) g2 g))
              (dk-have! (list '= (list g2 n) t2)
                (lambda ()
                  (dk-cite! 'ord-segment-succ-top n)
                  (dk-lam-b!)
                  (subst (list '= A2 la)) (subst (list '= B2 lb))
                  (dk-lam-b!)
                  (dk-have! (list '= n n) (lambda () (rfl)))
                  (dk-if-branch! #t (list 'IF (list '= n n) p2 (list A n)) #f
                    (lambda ()
                      (dk-if-branch! #t (list 'IF (list '= n n) q2 (list B n)) #f
                        (lambda () (if (not (avr-done?)) (rfl))))))))
              (subst (list '= (list g2 n) t2))
              (dk-apply! (dk-cite! 'cips-ip-type 'v) (list T p2) q2)
              (dk-apply! (dk-cite! 'cips-ip-type 'w) (list fT p1) q1)
              (dk-rewrite-h! (list 'IN (cadr ih) 'CC) (cadr ih) S)
              (subst (dk-cite! 'cc-nag-ag-opr S t2))
              (if (not (avr-done?)) (rfl)))))))))
(avr-done! 'amp-rep-step)

