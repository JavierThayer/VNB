;; the submodule M = {f(T) X : T in L(H)} of W
(define (avr-inM m) (list 'FORSOME 'avj_ (list 'AND (list 'IN 'avj_ avr-BO) (list '= m (list (list avr-fr 'avj_) avr-X)))))
(define avr-M (list 'SEP 'avm_ avr-VW (avr-inM 'avm_)))
(dk-have! (list 'IN avr-M 'SET) (lambda () (sep-set) (dk-ass!)))
;; m in M: an operator S with m = f(S) X
(define (avr-out! m)
  (let ((ex (avr-inM m)))
    (if (not (dk-asm? ex)) (sep-me (avr-ctx (list 'IN m avr-M))))
    (let ((S (dk-skolem! (avr-ctx ex) #t)))
      (dk-split-all!)
      (avr-fx! S)
      (if (not (dk-asm? (list 'IN m avr-M)))     ; sep-me consumed it: land it again
          (dk-have! (list 'IN m avr-M)
            (lambda () (in-sep! (lambda () (dk-ass!))
                                (lambda () (ew S) (dk-conj-close! (lambda () (if (not (avr-done?)) (dk-ass!)))))))))
      S)))
;; t in L(H): f(t) X in M
(define (avr-in! t)
  (let ((m (avr-fx! t)))
    (if (not (dk-asm? (list 'IN m avr-M)))
        (dk-have! (list 'IN m avr-M)
          (lambda () (in-sep! (lambda () (dk-ass!))
                              (lambda () (ew t) (dk-conj-close! (lambda () (cond ((avr-done?) #t) ((dk-ass!) #t) (#t (rfl)))))))))))
  (list 'IN (avr-fx! t) avr-M))
(dk-cite! 'cips-scal-pin avr-W)
(dk-cite! 'cc-scalar-ring-carr)
(dk-have! (list 'IS-SUBMODULE avr-W avr-M)
  (lambda ()
    (mac 'is-submodule)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((avr-done?) #t)
            ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def) (let ((x (dk-di-var!))) (sep-me (avr-ctx (list 'IN x avr-M))) (dk-ass!)))
            ((equal? g (list 'IN (list 'VZERO avr-W) avr-M))
             (avr-in! avr-Z) (dk-rewrite-h! (list 'IN (avr-fxt avr-Z) avr-M) (avr-fxt avr-Z) (list 'VZERO avr-W)) (dk-ass!))
            (#t
             (let* ((ld (dk-peel!))
                    (ms (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) avr-M))) ld)))
                    (cs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (not (equal? (caddr h) avr-M)))) ld)))
                    (Ss (map avr-out! ms)))
               (cond
                 ((= (length ms) 2)
                  (let* ((x (car ms)) (y (cadr ms)) (S (car Ss)) (T (cadr Ss)) (e (avr-fsum-x! S T)))
                    (avr-in! (list 'BOP-SUM 'v 'v S T))
                    (subst (list '= x (avr-fx! S))) (subst (list '= y (avr-fx! T)))
                    (dk-rewrite-h! (list 'IN (avr-fxt (list 'BOP-SUM 'v 'v S T)) avr-M) (avr-fxt (list 'BOP-SUM 'v 'v S T)) (caddr e))
                    (dk-ass!)))
                 ((null? cs)
                  (let* ((x (car ms)) (S (car Ss)) (e (avr-fscl-x! avr-M1 S))
                         (e3 (dk-apply! (dk-cite! 'cips-act-neg-one avr-W) (avr-fxt S))))
                    (avr-in! (list 'BOP-SCALE 'v 'v avr-M1 S))
                    (subst (list '= x (avr-fx! S)))
                    (let ((h (dk-rewrite-h! (list 'IN (avr-fxt (list 'BOP-SCALE 'v 'v avr-M1 S)) avr-M) (avr-fxt (list 'BOP-SCALE 'v 'v avr-M1 S)) (caddr e))))
                      (dk-rewrite-h! h (cadr e3) (caddr e3))
                      (dk-ass!))))
                 (#t
                  (let* ((r (car cs)) (x (car ms)) (S (car Ss)))
                    (dk-have! (list 'IN r 'CC)
                      (lambda () (let* ((h (avr-ctx (list 'IN r (list 'CARR (list 'SCAL avr-W)))))
                                        (h1 (dk-rewrite-h! h (list 'SCAL avr-W) '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))))
                                   (dk-rewrite-h! h1 '(CARR (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) 'CC)
                                   (if (not (avr-done?)) (dk-ass!)))))
                    (let ((e (avr-fscl-x! r S)))
                      (avr-in! (list 'BOP-SCALE 'v 'v r S))
                      (subst (list '= x (avr-fx! S)))
                      (dk-rewrite-h! (list 'IN (avr-fxt (list 'BOP-SCALE 'v 'v r S)) avr-M) (avr-fxt (list 'BOP-SCALE 'v 'v r S)) (caddr e))
                      (dk-ass!)))))))))))))
;; psi(f(T) X) := phi(T), by unique choice
(define (avr-qbody m z) (list 'FORSOME 'avo_ (list 'AND (list 'IN 'avo_ avr-BO)
                          (list 'AND (list '= m (list (list avr-fr 'avo_) avr-X)) (list '= '(phi_ avo_) z)))))
(define avr-Q (list 'VNB-LAMBDA 'avm_ avr-M (list 'SEP 'avz_ 'CC (avr-qbody 'avm_ 'avz_))))
;; z in Q(m), m in M: an operator S' with m = f(S') X and phi(S') = z
(define (avr-q-out! m z)
  (let* ((sf (list 'SEP 'avz_ 'CC (avr-qbody m 'avz_)))
         (e (list '= (list avr-Q m) sf)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (avr-done?)) (rfl)))))
    (let ((h (avr-ctx (list 'IN z (list avr-Q m)))))
      (sep-me (dk-rewrite-h! h (list avr-Q m) sf))
      (let ((S (dk-skolem! (avr-ctx (avr-qbody m z)) #t)))
        (dk-split-all!)
        (avr-fx! S)
        (avr-ap! 'phi_ avr-BO 'CC S)
        S))))
(define avr-uniq
  (list 'FORALL 'ucx (list 'IMPLIES (list 'IN 'ucx avr-M)
    (list 'FORSOME 'ucy (list 'AND '(IN ucy CC) (list 'AND (list 'IN 'ucy (list avr-Q 'ucx))
      (list 'FORALL 'ucz (list 'IMPLIES '(IN ucz CC) (list 'IMPLIES (list 'IN 'ucz (list avr-Q 'ucx)) '(= ucz ucy))))))))))
(dk-have! avr-uniq
  (lambda ()
    (let* ((m (dk-di-var!))
           (S (avr-out! m))
           (ps (list 'phi_ S)))
      (avr-ap! 'phi_ avr-BO 'CC S)
      (dk-have! (list 'IN ps (list avr-Q m))
        (lambda () (dk-lam-b!)
          (in-sep! (lambda () (dk-ass!))
                   (lambda () (ew S) (dk-conj-close! (lambda () (cond ((avr-done?) #t) ((dk-ass!) #t) (#t (rfl)))))))))
      (ew ps)
      (dk-conj-close!
        (lambda ()
          (if (and (not (avr-done?)) (not (dk-ass!)))
              (let* ((ld (dk-peel!))
                     (z (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'CC))) ld)))
                     (S2 (avr-q-out! m z))
                     (h1 (dk-rewrite-h! (list '= m (avr-fxt S)) m (avr-fxt S2))))
                (avr-det! (dk-apply! (avr-ctx avr-LU) S2 S))
                (let ((h2 (dk-rewrite-h! (list '= (list 'phi_ S2) z) (list 'phi_ S2) ps)))
                  (subst h2)
                  (if (not (avr-done?)) (rfl))))))))))
(define avr-uc (avr-chain! (dk-cite! 'uniq-choice-fun avr-M 'CC avr-Q) '()))
(define avr-psi (dk-skolem! avr-uc #t))
(define avr-psq (avr-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h avr-psi) (dk-contains? h 'VNB-LAMBDA))) "the choice"))
;; psi(f(T) X) = phi(T)
(define avr-PA (list 'FORALL 'avs_ (list 'IMPLIES (list 'IN 'avs_ avr-BO)
                 (list '= (list avr-psi (list (list avr-fr 'avs_) avr-X)) '(phi_ avs_)))))
(dk-have! avr-PA
  (lambda ()
    (let* ((T (dk-di-var!)) (m (avr-fx! T)) (pm (list avr-psi m)))
      (avr-in! T)
      (avr-ap! 'phi_ avr-BO 'CC T)
      (avr-ap! avr-psi avr-M 'CC m)
      (dk-apply! avr-psq m)
      (let ((S2 (avr-q-out! m pm)))
        (avr-det! (dk-apply! (avr-ctx avr-LU) T S2))
        (subst (list '= (list 'phi_ T) (list 'phi_ S2)))
        (subst (list '= (list 'phi_ S2) pm))
        (if (not (avr-done?)) (rfl))))))
;; psi is linear and bounded on M; Riesz on the submodule
(define (avr-psi-at! t)                  ; psi(f(t) X) = phi(t), f(t) X in M
  (avr-in! t) (avr-ap! 'phi_ avr-BO 'CC t)
  (dk-apply! (avr-ctx avr-PA) t))
(define (avr-ms ld) (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) avr-M))) ld)))
(define avr-sr-out
  (avr-chain! (dk-cite! 'submodule-functional-riesz avr-W avr-M avr-psi avr-C)
    (list
      (lambda ()                         ; additive
        (let* ((ld (dk-peel!)) (ms (avr-ms ld)) (x (car ms)) (y (cadr ms))
               (S (avr-out! x)) (T (avr-out! y)) (ST (avr-opsum! S T))
               (e (avr-fsum-x! S T)) (sx (avr-fx! S)) (tx (avr-fx! T)))
          (subst (list '= x sx)) (subst (list '= y tx))
          (subst (avr-psi-at! S)) (subst (avr-psi-at! T))
          (let* ((h (avr-psi-at! ST))
                 (h1 (dk-rewrite-h! h (avr-fx! ST) (caddr e)))
                 (ad (dk-apply! avr-ADDP S T)))
            (dk-rewrite-h! h1 (list 'phi_ ST) (caddr ad))
            (if (not (avr-done?)) (dk-ass!)))))
      (lambda ()                         ; homogeneous
        (let* ((ld (dk-peel!)) (x (car (avr-ms ld)))
               (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'CC))) ld)))
               (S (avr-out! x)) (kS (avr-opscl! k S))
               (e (avr-fscl-x! k S)) (sx (avr-fx! S)))
          (subst (list '= x sx))
          (subst (avr-psi-at! S))
          (let* ((h (avr-psi-at! kS))
                 (h1 (dk-rewrite-h! h (avr-fx! kS) (caddr e)))
                 (sc (dk-apply! avr-SCLP k S)))
            (dk-rewrite-h! h1 (list 'phi_ kS) (caddr sc))
            (if (not (avr-done?)) (dk-ass!)))))
      (lambda ()                         ; bounded
        (let* ((ld (dk-peel!)) (x (car (avr-ms ld))) (S (avr-out! x)) (sx (avr-fx! S)))
