;; f(S + T) X = f(S) X + f(T) X and f(c T) X = c f(T) X
(define (avr-fsum-x! s t)
  (let* ((st (avr-opsum! s t)) (fst (avr-fx! st)) (fs (avr-fx! s)) (ft (avr-fx! t)) (e (list '= fst (list (list 'VADD avr-W) fs ft))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda ()
                      (subst (dk-apply! avr-FSUM s t))
                      (subst (dk-cite! 'bop-sum-apply avr-W avr-W (list avr-fr s) (list avr-fr t) avr-X))
                      (if (not (avr-done?)) (rfl)))))
    e))
(define (avr-fscl-x! c t)
  (let* ((ct (avr-opscl! c t)) (fct (avr-fx! ct)) (ft (avr-fx! t)) (e (list '= fct (list (list 'ACT avr-W) c ft))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda ()
                      (subst (dk-apply! avr-FSCL c t))
                      (subst (dk-cite! 'bop-scale-apply avr-W avr-W c (list avr-fr t) avr-X))
                      (if (not (avr-done?)) (rfl)))))
    e))
