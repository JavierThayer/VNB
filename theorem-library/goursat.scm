(dk-cite! 'conv3-seg-trace 'goua_ 'goub_ 'gouc_ 'goub_ 'gouc_)
(dk-cite! 'conv3-seg-trace 'goua_ 'goub_ 'gouc_ 'gouc_ 'goua_)
(dk-conj-close! (lambda () (ass)))
