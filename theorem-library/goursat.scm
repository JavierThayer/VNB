;;; the four sub-triangles of the barycentric subdivision lie in the hull
(define (gou-mid x y) (list 'CC-MID x y))
(define gou-mab (gou-mid 'goua_ 'goub_))
(define gou-mbc (gou-mid 'goub_ 'gouc_))
(define gou-mac (gou-mid 'goua_ 'gouc_))
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'AND (list 'SUBSET (list 'CONV3 'goua_ gou-mab gou-mac) gou-C3)
   (list 'AND (list 'SUBSET (list 'CONV3 gou-mab 'goub_ gou-mbc) gou-C3)
    (list 'AND (list 'SUBSET (list 'CONV3 gou-mac gou-mbc 'gouc_) gou-C3)
               (list 'SUBSET (list 'CONV3 gou-mab gou-mbc gou-mac) gou-C3)))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'conv3-vertices-in 'goua_ 'goub_ 'gouc_)))
(dk-cite! 'conv3-mid-in 'goua_ 'goub_ 'gouc_ 'goua_ 'goub_)
(dk-cite! 'conv3-mid-in 'goua_ 'goub_ 'gouc_ 'goub_ 'gouc_)
(dk-cite! 'conv3-mid-in 'goua_ 'goub_ 'gouc_ 'goua_ 'gouc_)
(dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ 'goua_ gou-mab gou-mac)
(dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ gou-mab 'goub_ gou-mbc)
(dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ gou-mac gou-mbc 'gouc_)
(dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ gou-mab gou-mbc gou-mac)
(dk-conj-close! (lambda () (ass)))
(qed 'conv3-sub-triangle)

;;; ======================================================================
;;; (1) LEMMA 3.4: THE SEGMENT INTEGRAL SPLITS AT ANY POINT OF THE SEGMENT
;;; ======================================================================

;;; In a proof under H (u, f): given (= A P), (= (- B A) W) and
;;; (SUBSET (TRACE (SEG-PATH A B) 0 1) u) in context, land the road facts of
;;; SEG(P, W), its trace in u, and the bridge SEG-INT(f, A, B) == LINE-INT(f, SEG(P, W), ...).
;;; Returns (list SEG dSEG bridge-equation).
(define (gou-seg-in-u! a b p w)
  (gou-cc! p) (gou-cc! w)
  (let* ((r (dk-cite! 'segment-is-road p w)) (sg (list-ref r 1)) (dsg (list-ref r 2)))
    (fact 'is-road-is-path sg dsg 0 1)
    (fact 'is-path-in-fun sg 0 1)
    (fact 'is-road-dgam-in-fun sg dsg 0 1)
    (dk-cite! 'seg-trace-bridge a b p w)
    (dk-have! (list 'SUBSET (list 'TRACE sg 0 1) 'u)
      (lambda () (subst (list '= (list 'TRACE sg 0 1) (gou-segtr a b))) (ass)))
    (list sg dsg (dk-cite! 'seg-int-bridge 'f a b p w))))

;;; the plain bridge p = A, w = B - A
(define (gou-seg-std! a b)
  (let ((w (list '- b a)))
    (gou-cc! a) (gou-cc! w)
    (if (not (dk-asm? (list '= a a))) (dk-have! (list '= a a) (lambda () (rfl))))
    (if (not (dk-asm? (list '= w w))) (dk-have! (list '= w w) (lambda () (rfl))))
    (gou-seg-in-u! a b a w)))

(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_) 'CC
  (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u) '(IN (SEG-INT f goua_ goub_) CC))))))
(dk-peel!)
(let* ((sd (gou-seg-std! 'goua_ 'goub_)))
  (subst (caddr sd))
  (dk-cite! 'line-int-in-cc 'u 'f (car sd) (cadr sd) 0 1)
  (ass))
(qed 'seg-int-in-cc)

;;; the degenerate segment: SEG-INT(f, z, z) = 0
(sp (make-wff (gou-under-H '(FORALL gouz_ (IMPLIES (IN gouz_ u) (= (SEG-INT f gouz_ gouz_) 0))))))
(dk-peel!)
(fact 'subset-mem-fwd 'u 'CC 'gouz_)
(fact 'fun-apply-type-c 'f 'u 'CC 'gouz_)
(gou-cc! 0)
(dk-have! '(= (- gouz_ gouz_) 0) (lambda () (crs)))
(dk-have! '(= gouz_ gouz_) (lambda () (rfl)))
(define gou-dg-one
  '(FORALL gouy_ (IMPLIES (IN gouy_ (TRACE (SEG-PATH gouz_ gouz_) 0 1)) (= gouy_ gouz_))))
(dk-have! gou-dg-one
  (lambda ()
    (let* ((y (dk-di-var!))
           (tt (dk-skolem! (dk-cite! 'seg-trace-elim 'gouz_ 'gouz_ y)))
           (e (list '+ 'gouz_ (list '* tt '(- gouz_ gouz_)))))
      (fact 'ccint-elt-in-rr 0 1 tt)
      (gou-cc! e)
      (subst (list '= y e))
      (crs))))
(dk-have! (list 'SUBSET (gou-segtr 'gouz_ 'gouz_) 'u)
  (lambda ()
    (let ((y (subset-by-element!)))
      (dk-apply! (dk-ctx-form gou-dg-one) y)
      (subst (list '= y 'gouz_))
      (ass))))
(define gou-dg-sd (gou-seg-in-u! 'gouz_ 'gouz_ 'gouz_ 0))
(define gou-dg-li (list 'LINE-INT 'f (car gou-dg-sd) (cadr gou-dg-sd) 0 1))
(subst (caddr gou-dg-sd))
(define gou-dg-m '(magnitude (f gouz_)))
(gou-rr! gou-dg-m)
(define gou-dg-bd
  (dk-have! (list 'FORALL 'gouy_ (list 'IMPLIES (list 'IN 'gouy_ (list 'TRACE (car gou-dg-sd) 0 1))
              (list '<= '(magnitude (f gouy_)) gou-dg-m)))
    (lambda ()
      (let ((y (dk-di-var!)))
        (dk-have! (list 'IN y (gou-segtr 'gouz_ 'gouz_))
          (lambda () (subst (list '= (gou-segtr 'gouz_ 'gouz_) (list 'TRACE (car gou-dg-sd) 0 1))) (ass)))
        (dk-apply! (dk-ctx-form gou-dg-one) y)
        (subst (list '= y 'gouz_))
        (fact 'rr-leq-reflexive gou-dg-m)
        (ass)))))
(define gou-dg-le (dk-apply! (dk-cite! 'segment-int-abs-bound 'u 'f 'gouz_ 0) gou-dg-m))
(fact 'cc-magnitude-zero)
(dk-have! (list '= (list '* '(magnitude 0) gou-dg-m) 0)
  (lambda () (subst '(= (magnitude 0) 0)) (crs)))
(dk-cite! 'line-int-in-cc 'u 'f (car gou-dg-sd) (cadr gou-dg-sd) 0 1)
(gou-rr! (list 'magnitude gou-dg-li))
(fact 'cc-magnitude-nonneg gou-dg-li)
(gou-rr! (list '* '(magnitude 0) gou-dg-m))
(dk-have! (list '= (list 'magnitude gou-dg-li) 0)
  (lambda ()
    (dk-ineq! (list 'IN (list 'magnitude gou-dg-li) 'RR) (list 'IN (list '* '(magnitude 0) gou-dg-m) 'RR)
              gou-dg-le (list '= (list '* '(magnitude 0) gou-dg-m) 0)
              (list '<= 0 (list 'magnitude gou-dg-li)))))
(define gou-dg-iff (dk-cite! 'cc-magnitude-zero-iff gou-dg-li))
(dk-only! gou-dg-iff (list '= (list 'magnitude gou-dg-li) 0))
(prop)
(qed 'seg-int-degenerate)

;;; reversing a segment changes the sign
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_) 'CC
  (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u)
    '(= (SEG-INT f goub_ goua_) (* (- 1) (SEG-INT f goua_ goub_))))))))
(dk-peel!)
(define gou-rv-sd (gou-seg-std! 'goua_ 'goub_))
(define gou-rv-eq (dk-cite! 'segment-int-reverse 'u 'f 'goua_ '(- goub_ goua_)))
(define gou-rv-seg (list-ref (cadr gou-rv-eq) 2))                ; SEG(p, w) of the reversed segment
(define gou-rv-p (cadr (cadddr gou-rv-seg)))
(define gou-rv-w (caddr (caddr (cadddr gou-rv-seg))))
(gou-cc! gou-rv-p)
(gou-cc! gou-rv-w)
(dk-have! (list '= 'goub_ gou-rv-p) (lambda () (crs)))
(dk-have! (list '= '(- goua_ goub_) gou-rv-w) (lambda () (crs)))
(subst (dk-cite! 'seg-int-bridge 'f 'goub_ 'goua_ gou-rv-p gou-rv-w))
(subst (caddr gou-rv-sd))
(ass)
(qed 'seg-int-reverse-at)

;;; LEMMA 3.4: for c on the segment from a to b, int_<a,b> = int_<a,c> + int_<c,b>
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_) 'CC
  (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u)
    (list 'FORALL 'gouc_ (list 'IMPLIES (list 'IN 'gouc_ (gou-segtr 'goua_ 'goub_))
      '(= (SEG-INT f goua_ goub_) (+ (SEG-INT f goua_ gouc_) (SEG-INT f gouc_ goub_))))))))))
(dk-peel!)
(define gou-sp-t (dk-skolem! (dk-cite! 'seg-trace-elim 'goua_ 'goub_ 'gouc_)))
(define gou-sp-w '(- goub_ goua_))
(define gou-sp-c (list '+ 'goua_ (list '* gou-sp-t gou-sp-w)))
(gou-unit! gou-sp-t)
(gou-cc! gou-sp-c)
(fact 'subset-mem-fwd (gou-segtr 'goua_ 'goub_) 'u 'gouc_)
(dk-cite! 'seg-int-in-cc 'u 'f 'goua_ 'goub_)
;; the endpoints are on the segment, hence in u
(gou-in-unit! 0 '())
(gou-in-unit! 1 '())
(define (gou-sp-end! s v)
  (let ((e (list '+ 'goua_ (list '* s gou-sp-w))))
    (gou-cc! e)
    (dk-cite! 'seg-trace-intro 'goua_ 'goub_ s)
    (dk-have! (list '= e v) (lambda () (crs)))
    (dk-cite! 'in-transport-eq e v (gou-segtr 'goua_ 'goub_))
    (fact 'subset-mem-fwd (gou-segtr 'goua_ 'goub_) 'u v)))
(gou-sp-end! 0 'goua_)
(gou-sp-end! 1 'goub_)
(define (gou-sp-deg! s v)
  ;; t = s: c = v, and the degenerate piece vanishes
  (dk-have! (list '= 'gouc_ v)
    (lambda () (subst (list '= 'gouc_ gou-sp-c)) (subst (list '= gou-sp-t s)) (crs)))
  (subst (list '= 'gouc_ v))
  (subst (dk-cite! 'seg-int-degenerate 'u 'f v))
  (crs))
(use-em (list '= gou-sp-t 0)
  (lambda () (gou-sp-deg! 0 'goua_))
  (lambda ()
    (use-em (list '= gou-sp-t 1)
      (lambda () (gou-sp-deg! 1 'goub_))
      (lambda ()
        ;; 0 < t < 1: segment-int-split, bridged three times
        (fact 'neq-sym gou-sp-t 0)
        (gou-and! (list '<= 0 gou-sp-t) (list 'NOT (list '= 0 gou-sp-t)))
        (fact 'rr-le-ne-lt 0 gou-sp-t)
        (gou-and! (list '<= gou-sp-t 1) (list 'NOT (list '= gou-sp-t 1)))
        (fact 'rr-le-ne-lt gou-sp-t 1)
        (dk-have! (list 'IN gou-sp-t '(OOINT 0 1))
          (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (ass)))))
        (let* ((sd (gou-seg-std! 'goua_ 'goub_))
               (w1 (list '* gou-sp-t gou-sp-w))
               (w2 (list '* (list '- 1 gou-sp-t) gou-sp-w))
               (ev (dk-cite! 'segment-int-split 'u 'f 'goua_ gou-sp-w gou-sp-t)))
          (gou-cc! w1) (gou-cc! w2)
          (dk-have! (list '= '(- gouc_ goua_) w1)
            (lambda () (subst (list '= 'gouc_ gou-sp-c)) (crs)))
          (dk-have! (list '= '(- goub_ gouc_) w2)
            (lambda () (subst (list '= 'gouc_ gou-sp-c)) (crs)))
          (subst (dk-cite! 'seg-int-bridge 'f 'goua_ 'gouc_ 'goua_ w1))
          (subst (dk-cite! 'seg-int-bridge 'f 'gouc_ 'goub_ gou-sp-c w2))
          (subst (caddr sd))
          (ass))))))
(qed 'seg-int-split-at)

;;; ======================================================================
;;; (2) LEMMA 3.5: THE BARYCENTRIC SUBDIVISION SUM
;;; ======================================================================

;;; under H, with (SUBSET (CONV3 a b c) u) in context: the segment from X to Y (both in
;;; the hull, both typed) has its trace in u
(define (gou-tr-u! c3 x y)
  (let ((tr (gou-segtr x y)))
    (if (not (dk-asm? (list 'SUBSET tr 'u)))
        (begin
          (dk-cite! 'conv3-seg-trace (cadr c3) (caddr c3) (cadddr c3) x y)
          (fact 'subset-trans tr c3 'u)))
    (list 'SUBSET tr 'u)))

(define gou-T1 (list 'TRI-INT 'f 'goua_ gou-mab gou-mac))
(define gou-T2 (list 'TRI-INT 'f gou-mab 'goub_ gou-mbc))
(define gou-T3 (list 'TRI-INT 'f gou-mac gou-mbc 'gouc_))
(define gou-T4 (list 'TRI-INT 'f gou-mab gou-mbc gou-mac))
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'IMPLIES (list 'SUBSET gou-C3 'u)
    (list '= '(TRI-INT f goua_ goub_ gouc_)
          (list '+ (list '+ (list '+ gou-T1 gou-T2) gou-T3) gou-T4)))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'conv3-vertices-in 'goua_ 'goub_ 'gouc_)))
(for-each (lambda (m) (dk-cite! 'conv3-mid-in 'goua_ 'goub_ 'gouc_ (cadr m) (caddr m)) (gou-cc! m))
          (list gou-mab gou-mbc gou-mac))
(define (gou-sd-seg! x y) (gou-tr-u! gou-C3 x y) (dk-cite! 'seg-int-in-cc 'u 'f x y))
(for-each (lambda (xy) (gou-sd-seg! (car xy) (cadr xy)))
          (list (list 'goua_ 'goub_) (list 'goub_ 'gouc_) (list 'gouc_ 'goua_)
                (list 'goua_ gou-mab) (list gou-mab 'goub_) (list 'goub_ gou-mbc) (list gou-mbc 'gouc_)
                (list 'gouc_ gou-mac) (list gou-mac 'goua_)
                (list gou-mab gou-mac) (list gou-mac gou-mab) (list gou-mab gou-mbc)
                (list gou-mbc gou-mab) (list gou-mac gou-mbc) (list gou-mbc gou-mac)))
;; the midpoints on the three sides
(dk-split! (dk-cite! 'cc-mid-in-seg-trace 'goua_ 'goub_))
(dk-split! (dk-cite! 'cc-mid-in-seg-trace 'goub_ 'gouc_))
(dk-split! (dk-cite! 'cc-mid-in-seg-trace 'goua_ 'gouc_))
;; unfold the five triangle integrals
(for-each (lambda (tri) (subst (dk-cite! 'tri-int-unfold 'f (list-ref tri 2) (list-ref tri 3) (list-ref tri 4))))
          (list '(TRI-INT f goua_ goub_ gouc_) gou-T1 gou-T2 gou-T3 gou-T4))
;; Lemma 3.4 at the midpoint of each side
(subst (dk-cite! 'seg-int-split-at 'u 'f 'goua_ 'goub_ gou-mab))
(subst (dk-cite! 'seg-int-split-at 'u 'f 'goub_ 'gouc_ gou-mbc))
(subst (dk-cite! 'seg-int-split-at 'u 'f 'gouc_ 'goua_ gou-mac))
;; the inner edges are run both ways
(subst (dk-cite! 'seg-int-reverse-at 'u 'f gou-mab gou-mac))
(subst (dk-cite! 'seg-int-reverse-at 'u 'f gou-mab gou-mbc))
(subst (dk-cite! 'seg-int-reverse-at 'u 'f gou-mac gou-mbc))
(crs)
(qed 'tri-int-subdivision)

;;; ======================================================================
;;; (3) THE ESTIMATE ON A TRIANGLE, LINEARITY, AND THE AFFINE INTEGRAND
;;; ======================================================================

;;; |f| <= M on the hull  =>  |int_T f| <= (|b - a| + |c - b| + |a - c|) M
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'IMPLIES (list 'SUBSET gou-C3 'u)
    (list 'FORALL 'goum_ (list 'IMPLIES '(IN goum_ RR)
      (list 'IMPLIES (list 'FORALL 'gouz_ (list 'IMPLIES (list 'IN 'gouz_ gou-C3) '(<= (magnitude (f gouz_)) goum_)))
        '(<= (magnitude (TRI-INT f goua_ goub_ gouc_))
             (* (+ (+ (magnitude (- goub_ goua_)) (magnitude (- gouc_ goub_))) (magnitude (- goua_ gouc_)))
                goum_))))))))))
(dk-peel!)
(define gou-tb-bd (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'goum_))) "the bound on the hull"))
(dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 'goua_ 'goub_ 'gouc_)))
(subst (dk-cite! 'tri-int-unfold 'f 'goua_ 'goub_ 'gouc_))
;; one side: returns (list LI |LI|-bound)
(define (gou-tb-side! x y)
  (let* ((tr (gou-segtr x y))
         (w (list '- y x)))
    (fact 'subset-trans tr gou-C3 'u)
    (let* ((sd (gou-seg-std! x y))
           (sg (car sd))
           (li (list 'LINE-INT 'f sg (cadr sd) 0 1)))
      (dk-have! (list 'FORALL 'gouy_ (list 'IMPLIES (list 'IN 'gouy_ (list 'TRACE sg 0 1))
                  '(<= (magnitude (f gouy_)) goum_)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-have! (list 'IN z tr) (lambda () (subst (list '= tr (list 'TRACE sg 0 1))) (ass)))
            (fact 'subset-mem-fwd tr gou-C3 z)
            (dk-apply! gou-tb-bd z)
            (ass))))
      (let ((le (dk-apply! (dk-cite! 'segment-int-abs-bound 'u 'f x w) 'goum_)))
        (subst (caddr sd))
        (dk-cite! 'line-int-in-cc 'u 'f sg (cadr sd) 0 1)
        (gou-rr! (list 'magnitude li))
        (gou-rr! (list '* (list 'magnitude w) 'goum_))
        (list li le)))))
(define gou-tb-1 (gou-tb-side! 'goua_ 'goub_))
(define gou-tb-2 (gou-tb-side! 'goub_ 'gouc_))
(define gou-tb-3 (gou-tb-side! 'gouc_ 'goua_))
(let* ((l1 (car gou-tb-1)) (l2 (car gou-tb-2)) (l3 (car gou-tb-3))
       (l12 (list '+ l1 l2))
       (m (lambda (t) (list 'magnitude t)))
       (rhs (caddr (dk-goal)))
       (ex (list '+ (list '+ '(* (magnitude (- goub_ goua_)) goum_) '(* (magnitude (- gouc_ goub_)) goum_))
                 '(* (magnitude (- goua_ gouc_)) goum_))))
  (gou-cc! l12)
  (gou-cc! (list '+ l12 l3))
  (gou-and! (list 'IN l12 'CC) (list 'IN l3 'CC))
  (fact 'cc-magnitude-triangle l12 l3)
  (gou-and! (list 'IN l1 'CC) (list 'IN l2 'CC))
  (fact 'cc-magnitude-triangle l1 l2)
  (gou-rr! (m l12))
  (gou-rr! (m (list '+ l12 l3)))
  (dk-have! (list '= rhs ex) (lambda () (crs)))
  (subst (list '= rhs ex))
  (dk-ineq! (list 'IN (m (list '+ l12 l3)) 'RR) (list 'IN (m l12) 'RR)
            (list 'IN (m l1) 'RR) (list 'IN (m l2) 'RR) (list 'IN (m l3) 'RR)
            '(IN (* (magnitude (- goub_ goua_)) goum_) RR) '(IN (* (magnitude (- gouc_ goub_)) goum_) RR)
            '(IN (* (magnitude (- goua_ gouc_)) goum_) RR)
            (list '<= (m (list '+ l12 l3)) (list '+ (m l12) (m l3)))
            (list '<= (m l12) (list '+ (m l1) (m l2)))
            (cadr gou-tb-1) (cadr gou-tb-2) (cadr gou-tb-3)))
(qed 'tri-int-abs-bound)

;;; the triangle integral is additive in the integrand
(define gou-Hg
  '((IN g (FUN u CC))
    (FORALL rgy_ (IMPLIES (IN rgy_ u)
      (IS-CONTINUOUS-AT (SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) u)
                        (NF-METRIC-SPACE CC-NORMED-FIELD) g rgy_)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'g (gou-imps (append gou-H gou-Hg)
  (list 'FORALL 'gouh_ (list 'IMPLIES '(IN gouh_ (FUN u CC))
    (list 'IMPLIES '(FORALL gouz_ (IMPLIES (IN gouz_ u) (== (gouh_ gouz_) (+ (f gouz_) (g gouz_)))))
      (gou-all-in '(goua_ goub_ gouc_) 'CC (list 'IMPLIES (list 'SUBSET gou-C3 'u)
        '(= (TRI-INT gouh_ goua_ goub_ gouc_)
            (+ (TRI-INT f goua_ goub_ gouc_) (TRI-INT g goua_ goub_ gouc_))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 'goua_ 'goub_ 'gouc_)))
(for-each (lambda (fn) (subst (dk-cite! 'tri-int-unfold fn 'goua_ 'goub_ 'gouc_))) '(gouh_ f g))
(for-each
 (lambda (xy)
   (let* ((x (car xy)) (y (cadr xy)) (tr (gou-segtr x y)) (w (list '- y x)))
     (fact 'subset-trans tr gou-C3 'u)
     (let* ((sd (gou-seg-std! x y)) (sg (car sd)) (dsg (cadr sd)))
       (for-each (lambda (fn) (subst (dk-cite! 'seg-int-bridge fn x y x w))) '(gouh_ f g))
       (dk-cite! 'line-int-in-cc 'u 'f sg dsg 0 1)
       (dk-cite! 'line-int-in-cc 'u 'g sg dsg 0 1)
       (subst (dk-apply! (dk-cite! 'line-int-sum 'u 'f 'g sg dsg 0 1) 'gouh_)))))
 (list (list 'goua_ 'goub_) (list 'goub_ 'gouc_) (list 'gouc_ 'goua_)))
(crs)
(qed 'tri-int-sum)

;;; an open set of the complex plane is a subset of CC
(define gou-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN gou-nfm 'u) '(SUBSET u CC)))))
(dk-peel!)
(fact 'nf-metric-carrier 'CC-NORMED-FIELD)
(fact 'cc-nf-carr)
(dk-have! (list '== (list 'PTS gou-nfm) 'CC)
  (lambda () (subst (list '== (list 'PTS gou-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-have! (list 'SUBSET 'u (list 'PTS gou-nfm))
  (lambda () (mac-h 'is-open (list 'IS-OPEN gou-nfm 'u)) (dk-split-all!) (ass)))
(subst (list '== 'CC (list 'PTS gou-nfm)))
(ass)
(qed 'cc-open-subset-cc)

;;; the polynomial of (65) has a primitive on any open u: F(z) == p z + q (z - w)^2 / 2,
;;; F' = p + q (z - w).  (affine-has-primitive-cc of batch 29-B is the case u = CC; the
;;; proof is the same: cc-diff-on-quadratic with M = |q recip(2)|.)
(define gou-ap-val
  '(FORALL gouz_ (IMPLIES (IN gouz_ u)
     (== (gouf_ gouz_) (+ (* goup_ gouz_) (* (* gouq_ (* (- gouz_ gouw_) (- gouz_ gouw_))) (recip 2)))))))
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN gou-nfm 'u)
  (gou-all-in '(goup_ gouq_ gouw_) 'CC
  (list 'FORALL 'gouf_ (list 'IMPLIES '(IN gouf_ (FUN u CC))
    (list 'IMPLIES gou-ap-val
      (list 'AND '(HOLOMORPHIC-ON u gouf_)
        '(FORALL gouz_ (IMPLIES (IN gouz_ u)
           (IS-DIFF-ON CC-NORMED-FIELD u gouf_ gouz_ (+ goup_ (* gouq_ (- gouz_ gouw_)))))))))))))))
(dk-peel!)
(define gou-ap-vh (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm '==))) "F's values"))
(dk-cite! 'cc-open-subset-cc 'u)
(define gou-ap-h '(recip 2))
(gou-cc! gou-ap-h)
(define (gou-ap-expr z)
  (list '+ (list '* 'gouvp_ z) (list '* (list '* 'gouvq_ (list '* (list '- z 'gouvw_) (list '- z 'gouvw_))) 'gouvh_)))
(define gou-ap-gen
  (gou-all-in '(gouvp_ gouvq_ gouvw_ gouvh_ gouvx_ gouva_) 'CC
    (list '= (list '- (list '- (gou-ap-expr 'gouvx_) (gou-ap-expr 'gouva_))
                   (list '* '(- gouvx_ gouva_) '(+ gouvp_ (* gouvq_ (- gouva_ gouvw_)))))
             '(+ (* (* gouvq_ gouvh_) (* (- gouvx_ gouva_) (- gouvx_ gouva_)))
                 (* (* (* gouvq_ (- gouvx_ gouva_)) (- gouva_ gouvw_)) (- (* 2 gouvh_) 1))))))
(dk-have! gou-ap-gen (lambda () (dk-peel!) (crs)))
(define gou-ap-zero
  (gou-all-in '(gouvu_ gouvv_) 'CC '(= (+ gouvu_ (* gouvv_ (- 1 1))) gouvu_)))
(dk-have! gou-ap-zero (lambda () (dk-peel!) (crs)))
(gou-cc! 2)
(gou-and! '(IN 2 CC) '(NOT (= 2 0)))
(define gou-ap-two (dk-cite! 'cc-recip-inverse 2))
(define gou-ap-d
  '(FORALL gouz_ (IMPLIES (IN gouz_ u)
     (IS-DIFF-ON CC-NORMED-FIELD u gouf_ gouz_ (+ goup_ (* gouq_ (- gouz_ gouw_)))))))
(dk-have! gou-ap-d
  (lambda ()
    (let* ((a (dk-di-var!))
           (L (list '+ 'goup_ (list '* 'gouq_ (list '- a 'gouw_))))
           (M (list 'magnitude (list '* 'gouq_ gou-ap-h))))
      (fact 'subset-mem-fwd 'u 'CC a)
      (gou-cc! L)
      (gou-cc! (list '* 'gouq_ gou-ap-h))
      (gou-rr! M)
      (fact 'cc-magnitude-nonneg (list '* 'gouq_ gou-ap-h))
      (dk-have! (list 'FORALL 'cpdx_ (list 'IMPLIES '(IN cpdx_ u)
                  (list '<= (list 'magnitude (list '- (list '- '(gouf_ cpdx_) (list 'gouf_ a))
                                                   (list '* (list '- 'cpdx_ a) L)))
                        (list '* M (list '* (list 'magnitude (list '- 'cpdx_ a))
                                            (list 'magnitude (list '- 'cpdx_ a)))))))
        (lambda ()
          (let* ((x (dk-di-var!))
                 (d (list '- x a)))
            (fact 'subset-mem-fwd 'u 'CC x)
            (subst (dk-apply! gou-ap-vh x))
            (subst (dk-apply! gou-ap-vh a))
            (subst (dk-apply! (dk-ctx-form gou-ap-gen) 'goup_ 'gouq_ 'gouw_ gou-ap-h x a))
            (subst gou-ap-two)
            (let* ((uu (list '* (list '* 'gouq_ gou-ap-h) (list '* d d)))
                   (vv (list '* (list '* 'gouq_ d) (list '- a 'gouw_))))
              (gou-cc! uu) (gou-cc! vv)
              (subst (dk-apply! (dk-ctx-form gou-ap-zero) uu vv))
              (gou-cc! d)
              (gou-and! (list 'IN (list '* 'gouq_ gou-ap-h) 'CC) (list 'IN (list '* d d) 'CC))
              (subst (dk-cite! 'cc-magnitude-mul (list '* 'gouq_ gou-ap-h) (list '* d d)))
              (gou-and! (list 'IN d 'CC) (list 'IN d 'CC))
              (subst (dk-cite! 'cc-magnitude-mul d d))
              (let ((t (cadr (dk-goal))))
                (gou-rr! t)
                (dk-cite! 'rr-leq-reflexive t)
                (ass))))))
      (fact 'cc-diff-on-quadratic 'u 'gouf_ a L M)
      (ass))))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (begin
          (mac 'HOLOMORPHIC-ON)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-head-is? (dk-goal) 'FORALL))
                  (ass)
                  (let ((a (dk-di-var!)))
                    (dk-apply! (dk-ctx-form gou-ap-d) a)
                    (ew (list '+ 'goup_ (list '* 'gouq_ (list '- a 'gouw_))))
                    (ass)))))))))
(qed 'affine-primitive-on)

;;; the integral of an affine function around a triangle in an open u is 0
;;; (Cor 3.3 applied to z |-> p + q (z - w), one segment at a time: the triangle is
;;; not a road, so the three values F(b) - F(a), F(c) - F(b), F(a) - F(c) telescope)
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN gou-nfm 'u)
  (gou-all-in '(goup_ gouq_ gouw_) 'CC
   (list 'FORALL 'goug_ (list 'IMPLIES '(IN goug_ (FUN u CC))
     (list 'IMPLIES '(FORALL gouz_ (IMPLIES (IN gouz_ u) (== (goug_ gouz_) (+ goup_ (* gouq_ (- gouz_ gouw_))))))
       (gou-all-in '(goua_ goub_ gouc_) 'CC (list 'IMPLIES (list 'SUBSET gou-C3 'u)
          '(= (TRI-INT goug_ goua_ goub_ gouc_) 0)))))))))))
(dk-peel!)
(define gou-az-vh (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'goug_))) "g's values"))
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'cc-is-normed-field)
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'u)
(define (gou-az-val z)
  (list '+ (list '* 'goup_ z) (list '* (list '* 'gouq_ (list '* (list '- z 'gouw_) (list '- z 'gouw_))) '(recip 2))))
(define gou-az-F (list 'VNB-LAMBDA 'gouvz_ 'u (gou-az-val 'gouvz_)))
(gou-cc! '(recip 2))
(dk-have! (list 'IN gou-az-F '(FUN u CC))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd 'u 'CC z) (gou-cc! (gou-az-val z)) (ass))))))
(dk-have! (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== (list gou-az-F 'gouz_) (gou-az-val 'gouz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'subset-mem-fwd 'u 'CC z)
      (gou-cc! (gou-az-val z))
      (if (not (dk-lam-b!)) (qrfl)))))
(dk-split-all! (list (dk-cite! 'affine-primitive-on 'u 'goup_ 'gouq_ 'gouw_ gou-az-F)))
(define gou-az-dd (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'IS-DIFF-ON))) "F' = g"))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ u)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u gou-az-F 'hbz_ '(goug_ hbz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-apply! gou-az-dd z)
      (subst (dk-apply! gou-az-vh z))
      (ass))))
(dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 'goua_ 'goub_ 'gouc_)))
(dk-split-all! (list (dk-cite! 'conv3-vertices-in 'goua_ 'goub_ 'gouc_)))
(gou-in-unit! 0 '())
(gou-in-unit! 1 '())
(subst (dk-cite! 'tri-int-unfold 'goug_ 'goua_ 'goub_ 'gouc_))
(for-each
 (lambda (xy)
   (let* ((x (car xy)) (y (cadr xy)) (tr (gou-segtr x y)) (w (list '- y x)))
     (fact 'subset-trans tr gou-C3 'u)
     (fact 'subset-mem-fwd gou-C3 'u x)
     (fact 'fun-apply-type-c gou-az-F 'u 'CC x)
     (let* ((sd (gou-seg-std! x y)) (sg (car sd)) (dsg (cadr sd)))
       (subst (dk-cite! 'seg-int-bridge 'goug_ x y x w))
       (subst (dk-cite! 'line-int-of-derivative 'u gou-az-F 'goug_ sg dsg 0 1))
       (dk-have! (list '= (list sg 1) y)
         (lambda () (if (not (dk-lam-b!)) (let ((g (dk-goal))) (gou-cc! (cadr g)) (crs)))))
       (dk-have! (list '= (list sg 0) x)
         (lambda () (if (not (dk-lam-b!)) (let ((g (dk-goal))) (gou-cc! (cadr g)) (crs)))))
       (subst (list '= (list sg 1) y))
       (subst (list '= (list sg 0) x)))))
 (list (list 'goua_ 'goub_) (list 'goub_ 'gouc_) (list 'gouc_ 'goua_)))
(crs)
(qed 'tri-int-affine-zero)

;;; ======================================================================
;;; (4) THE COMMON POINT OF THE NESTED TRIANGLES, ON THE STANDARD TRIANGLE
;;;
;;; The decided route (docs/goursat-definitions-2026-09-25.md): an abstract vertex is
;;; xi in CC with 0 <= re xi, 0 <= im xi, re xi + im xi <= 1 (the standard triangle,
;;; STD below, a SEP over CC built in the driver), mapped to the plane by
;;;     V(xi) = re(xi) a + im(xi) b + (1 - re(xi) - im(xi)) c,
;;; which commutes with midpoints (bary-mid), is Lipschitz (bary-lip), sends STD into
;;; CONV3(a, b, c) (bary-in-conv3) and 1, i, 0 to a, b, c (bary-vertices).
;;; ======================================================================

;;; a holomorphic function satisfies the continuity hypothesis of the line-integral laws
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL rgy_ (IMPLIES (IN rgy_ u)
    (IS-CONTINUOUS-AT (SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) u)
                      (NF-METRIC-SPACE CC-NORMED-FIELD) f rgy_))))))))
(dk-peel!)
(let ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) 'rgy_))))
  (dk-cite! 'diff-on-implies-continuous 'CC-NORMED-FIELD 'u 'f 'rgy_ l)
  (ass))
(qed 'holomorphic-on-continuous)

;;; the coordinate conditions of the standard triangle
(define (gou-std-conds x)
  (list (list '<= 0 (list 'real-part x))
        (list '<= 0 (list 'imag-part x))
        (list '<= (list '+ (list 'real-part x) (list 'imag-part x)) 1)))
(define (gou-std x)
  (let ((c (gou-std-conds x))) (list 'AND (car c) (list 'AND (cadr c) (caddr c)))))
;;; V, for the vertices goua_, goub_, gouc_
(define (gou-V x)
  (list '+ (list '+ (list '* (list 'real-part x) 'goua_) (list '* (list 'imag-part x) 'goub_))
           (list '* (list '- (list '- 1 (list 'real-part x)) (list 'imag-part x)) 'gouc_)))

(sp (make-wff (gou-all-in '(goux_ gouy_) 'CC
  '(AND (= (real-part (CC-MID goux_ gouy_)) (* 1/2 (+ (real-part goux_) (real-part gouy_))))
        (= (imag-part (CC-MID goux_ gouy_)) (* 1/2 (+ (imag-part goux_) (imag-part gouy_))))))))
(dk-peel!)
(gou-half!)
(gou-rr! 1/2)
(gou-cc! '(+ goux_ gouy_))
(for-each gou-rr! '((real-part goux_) (real-part gouy_) (imag-part goux_) (imag-part gouy_)))
(subst (dk-cite! 'cc-mid-unfold 'goux_ 'gouy_))
(subst '(= (recip 2) 1/2))
(dk-have! '(= (* (+ goux_ gouy_) 1/2) (* 1/2 (+ goux_ gouy_))) (lambda () (crs)))
(subst '(= (* (+ goux_ gouy_) 1/2) (* 1/2 (+ goux_ gouy_))))
(subst (dk-cite! 'cc-re-real-mul 1/2 '(+ goux_ gouy_)))
(subst (dk-cite! 'cc-im-real-mul 1/2 '(+ goux_ gouy_)))
(subst (dk-cite! 'cc-re-add 'goux_ 'gouy_))
(subst (dk-cite! 'cc-im-add 'goux_ 'gouy_))
(dk-conj-close! (lambda () (crs)))
(qed 'cc-mid-coords)

;;; the standard triangle is closed under midpoints
(sp (make-wff (gou-all-in '(goux_ gouy_) 'CC
  (gou-imps (append (gou-std-conds 'goux_) (gou-std-conds 'gouy_)) (gou-std '(CC-MID goux_ gouy_))))))
(dk-peel!)
(dk-split! (dk-cite! 'cc-mid-coords 'goux_ 'gouy_))
(for-each gou-rr! '((real-part goux_) (real-part gouy_) (imag-part goux_) (imag-part gouy_)))
(subst '(= (real-part (CC-MID goux_ gouy_)) (* 1/2 (+ (real-part goux_) (real-part gouy_)))))
(subst '(= (imag-part (CC-MID goux_ gouy_)) (* 1/2 (+ (imag-part goux_) (imag-part gouy_)))))
(dk-conj-close!
  (lambda ()
    (apply dk-ineq! (append '((IN (real-part goux_) RR) (IN (real-part gouy_) RR)
                              (IN (imag-part goux_) RR) (IN (imag-part gouy_) RR))
                            (gou-std-conds 'goux_) (gou-std-conds 'gouy_)))))
(qed 'std-mid)

;;; two points of the standard triangle are at most 2 apart
(sp (make-wff (gou-all-in '(goux_ gouy_) 'CC
  (gou-imps (append (gou-std-conds 'goux_) (gou-std-conds 'gouy_)) '(<= (magnitude (- goux_ gouy_)) 2)))))
(dk-peel!)
(define gou-sd-pre (append '((IN (real-part goux_) RR) (IN (real-part gouy_) RR)
                             (IN (imag-part goux_) RR) (IN (imag-part gouy_) RR))
                           (gou-std-conds 'goux_) (gou-std-conds 'gouy_)))
(for-each gou-rr! '((real-part goux_) (real-part gouy_) (imag-part goux_) (imag-part gouy_)))
(define (gou-sd-abs! d)
  (gou-rr! d)
  (gou-rr! 1)
  (dk-have! (list '<= '(- 1) d) (lambda () (apply dk-ineq! (cons (list 'IN d 'RR) gou-sd-pre))))
  (dk-have! (list '<= d 1) (lambda () (apply dk-ineq! (cons (list 'IN d 'RR) gou-sd-pre))))
  (dk-cite! 'rr-abs-le-of-parts d 1)
  (fact 'rr-abs-closed d))
(gou-sd-abs! '(- (real-part goux_) (real-part gouy_)))
(gou-sd-abs! '(- (imag-part goux_) (imag-part gouy_)))
(dk-cite! 'cc-dist-le-coords 'goux_ 'gouy_)
(gou-rr! '(magnitude (- goux_ gouy_)))
(dk-ineq! '(IN (magnitude (- goux_ gouy_)) RR)
          '(IN (abs (- (real-part goux_) (real-part gouy_))) RR)
          '(IN (abs (- (imag-part goux_) (imag-part gouy_))) RR)
          '(<= (magnitude (- goux_ gouy_)) (+ (abs (- (real-part goux_) (real-part gouy_)))
                                              (abs (- (imag-part goux_) (imag-part gouy_)))))
          '(<= (abs (- (real-part goux_) (real-part gouy_))) 1)
          '(<= (abs (- (imag-part goux_) (imag-part gouy_))) 1))
(qed 'std-dist)

;;; the standard triangle is closed under limits of sequences
(define gou-sl-unit '(CCINT 0 1))
(sp (make-wff (list 'FORALL 'gous_ (list 'IMPLIES '(IN gous_ (FUN NN CC))
  (list 'FORALL 'gouw_ (list 'IMPLIES '(IN gouw_ CC)
    (list 'IMPLIES (list 'FORALL 'goun_ (list 'IMPLIES '(IN goun_ NN) (gou-std '(gous_ goun_))))
      (list 'IMPLIES '(CONVERGES-TO CC-MS gous_ gouw_) (gou-std 'gouw_)))))))))
(dk-peel!)
(define gou-sl-all (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'goun_))) "the conditions along s"))
(define gou-sl-g (list 'VNB-LAMBDA 'gnv_ 'NN '(real-part (gous_ gnv_))))
(define gou-sl-q (list 'VNB-LAMBDA 'gnv_ 'NN '(imag-part (gous_ gnv_))))
(define gou-sl-h (list 'VNB-LAMBDA 'gnv_ 'NN '(+ (real-part (gous_ gnv_)) (imag-part (gous_ gnv_)))))
(fact 'nn-is-set)
;; at an index n: the three conditions and the coordinates typed
(define (gou-sl-at! n)
  (fact 'fun-apply-type-c 'gous_ 'NN 'CC n)
  (dk-split-all! (list (dk-apply! gou-sl-all n)))
  (gou-rr! (list 'real-part (list 'gous_ n)))
  (gou-rr! (list 'imag-part (list 'gous_ n)))
  (gou-rr! (list '+ (list 'real-part (list 'gous_ n)) (list 'imag-part (list 'gous_ n)))))
(define (gou-sl-pre n)
  (append (list (list 'IN (list 'real-part (list 'gous_ n)) 'RR) (list 'IN (list 'imag-part (list 'gous_ n)) 'RR))
          (gou-std-conds (list 'gous_ n))))
(define (gou-sl-type! lam cls)
  (dk-have! (list 'IN lam (list 'FUN 'NN cls))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((n (dk-di-var!)))
            (gou-sl-at! n)
            (if (equal? cls 'RR)
                (ass)
                (begin (mac 'ccint-membership)
                       (dk-conj-close!
                         (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! (gou-sl-pre n)))))))))))))
(gou-sl-type! gou-sl-g 'RR)
(gou-sl-type! gou-sl-q 'RR)
(gou-sl-type! gou-sl-h 'RR)
(gou-sl-type! gou-sl-g gou-sl-unit)
(gou-sl-type! gou-sl-q gou-sl-unit)
(gou-sl-type! gou-sl-h gou-sl-unit)
;; the pointwise values
(define (gou-sl-val! lam rhs-of)
  (dk-have! (list 'FORALL 'goun_ (list 'IMPLIES '(IN goun_ NN) (list '= (rhs-of 'goun_) (list lam 'goun_))))
    (lambda ()
      (let ((n (dk-di-var!)))
        (gou-sl-at! n)
        (if (not (dk-lam-b!)) (rfl))))))
(gou-sl-val! gou-sl-g (lambda (n) (list 'real-part (list 'gous_ n))))
(gou-sl-val! gou-sl-q (lambda (n) (list 'imag-part (list 'gous_ n))))
(dk-have! (list 'FORALL 'goun_ (list 'IMPLIES '(IN goun_ NN)
            (list '= (list gou-sl-h 'goun_) (list '+ (list gou-sl-g 'goun_) (list gou-sl-q 'goun_)))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (gou-sl-at! n)
      (if (not (dk-lam-b!)) (rfl)))))
(dk-split-all! (list (dk-cite! 'cc-coords-of-converges 'gous_ gou-sl-g gou-sl-q 'gouw_)))
(for-each gou-rr! '((real-part gouw_) (imag-part gouw_)))
(dk-cite! 'rr-limit-add gou-sl-g gou-sl-q gou-sl-h '(real-part gouw_) '(imag-part gouw_))
(gou-rr! '(+ (real-part gouw_) (imag-part gouw_)))
(gou-rr! 0)
(gou-rr! 1)
(dk-cite! 'rr-limit-in-ccint 0 1 gou-sl-g '(real-part gouw_))
(dk-cite! 'rr-limit-in-ccint 0 1 gou-sl-q '(imag-part gouw_))
(dk-cite! 'rr-limit-in-ccint 0 1 gou-sl-h '(+ (real-part gouw_) (imag-part gouw_)))
(for-each gou-unit! '((real-part gouw_) (imag-part gouw_) (+ (real-part gouw_) (imag-part gouw_))))
(dk-conj-close! (lambda () (ass)))
(qed 'std-limit)

;;; V commutes with midpoints
(define (gou-coords-rr! x) (gou-rr! (list 'real-part x)) (gou-rr! (list 'imag-part x)))
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_ goux_ gouy_) 'CC
  (list '= (gou-V '(CC-MID goux_ gouy_)) (list 'CC-MID (gou-V 'goux_) (gou-V 'gouy_))))))
(dk-peel!)
(gou-half!)
(gou-rr! 1/2)
(gou-coords-rr! 'goux_)
(gou-coords-rr! 'gouy_)
(gou-cc! (gou-V 'goux_))
(gou-cc! (gou-V 'gouy_))
(dk-split! (dk-cite! 'cc-mid-coords 'goux_ 'gouy_))
(subst '(= (real-part (CC-MID goux_ gouy_)) (* 1/2 (+ (real-part goux_) (real-part gouy_)))))
(subst '(= (imag-part (CC-MID goux_ gouy_)) (* 1/2 (+ (imag-part goux_) (imag-part gouy_)))))
(subst (dk-cite! 'cc-mid-unfold (gou-V 'goux_) (gou-V 'gouy_)))
(subst '(= (recip 2) 1/2))
(crs)
(qed 'bary-mid)

;;; V maps the standard triangle into the hull
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_ goux_) 'CC
  (gou-imps (gou-std-conds 'goux_) (list 'IN (gou-V 'goux_) gou-C3)))))
(dk-peel!)
(gou-coords-rr! 'goux_)
(define gou-bc-n '(- (- 1 (real-part goux_)) (imag-part goux_)))
(gou-rr! gou-bc-n)
(define gou-bc-pre (append (list '(IN (real-part goux_) RR) '(IN (imag-part goux_) RR) (list 'IN gou-bc-n 'RR))
                           (gou-std-conds 'goux_)))
(for-each (lambda (v) (gou-in-unit! v gou-bc-pre)) (list '(real-part goux_) '(imag-part goux_) gou-bc-n))
(dk-have! (list '= (list '+ (list '+ '(real-part goux_) '(imag-part goux_)) gou-bc-n) 1) (lambda () (crs)))
(gou-cc! (gou-V 'goux_))
(dk-have! (list '= (gou-V 'goux_) (gou-V 'goux_)) (lambda () (rfl)))
(dk-cite! 'conv3-intro 'goua_ 'goub_ 'gouc_ '(real-part goux_) '(imag-part goux_) gou-bc-n (gou-V 'goux_))
(ass)
(qed 'bary-in-conv3)

;;; V at the vertices of the standard triangle
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'AND (list '= (gou-V 1) 'goua_) (list 'AND (list '= (gou-V '+i) 'goub_) (list '= (gou-V 0) 'gouc_))))))
(dk-peel!)
(fact 'cc-i-in)
(gou-cc! 1)
(gou-cc! 0)
(gou-rr! 0)
(gou-rr! 1)
(define (gou-bv-coords! z x y)
  (let ((e (list '+ x (list '* y '+i))))
    (gou-cc! e)
    (dk-have! (list '= z e) (lambda () (crs)))
    (dk-split! (dk-cite! 'cc-re-im-of z x y))))
(gou-bv-coords! 1 1 0)
(gou-bv-coords! '+i 0 1)
(gou-bv-coords! 0 0 0)
(dk-conj-close!
  (lambda ()
    (for-each (lambda (z)
                (if (dk-contains? (dk-goal) (list 'real-part z))
                    (let ((r (dk-pick (lambda (fm) (and (gou-op? fm '= 3) (equal? (cadr fm) (list 'real-part z)))) "re"))
                          (i (dk-pick (lambda (fm) (and (gou-op? fm '= 3) (equal? (cadr fm) (list 'imag-part z)))) "im")))
                      (subst r) (subst i))))
              '(1 +i 0))
    (crs)))
(qed 'bary-vertices)

;;; V is Lipschitz: |V x - V y| <= (|a - c| + |b - c|) |x - y|
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_ goux_ gouy_) 'CC
  (list '<= (list 'magnitude (list '- (gou-V 'goux_) (gou-V 'gouy_)))
            '(* (+ (magnitude (- goua_ gouc_)) (magnitude (- goub_ gouc_))) (magnitude (- goux_ gouy_)))))))
(dk-peel!)
(gou-coords-rr! 'goux_)
(gou-coords-rr! 'gouy_)
(let* ((r '(- (real-part goux_) (real-part gouy_)))
       (s '(- (imag-part goux_) (imag-part gouy_)))
       (ac '(- goua_ gouc_)) (bc '(- goub_ gouc_))
       (p1 (list '* r ac)) (p2 (list '* s bc))
       (d (list '- (gou-V 'goux_) (gou-V 'gouy_)))
       (m (lambda (t) (list 'magnitude t)))
       (mxy '(magnitude (- goux_ gouy_))))
  (gou-rr! r) (gou-rr! s)
  (gou-cc! p1) (gou-cc! p2) (gou-cc! d)
  (dk-have! (list '= d (list '+ p1 p2)) (lambda () (crs)))
  (subst (list '= d (list '+ p1 p2)))
  (gou-and! (list 'IN p1 'CC) (list 'IN p2 'CC))
  (fact 'cc-magnitude-triangle p1 p2)
  (gou-cc! r) (gou-cc! s) (gou-cc! ac) (gou-cc! bc)
  (gou-and! (list 'IN r 'CC) (list 'IN ac 'CC))
  (fact 'cc-magnitude-mul r ac)
  (gou-and! (list 'IN s 'CC) (list 'IN bc 'CC))
  (fact 'cc-magnitude-mul s bc)
  (fact 'rr-magnitude-is-abs r)
  (fact 'rr-magnitude-is-abs s)
  (dk-cite! 'cc-re-dist-le 'goux_ 'gouy_)
  (dk-cite! 'cc-im-dist-le 'goux_ 'gouy_)
  (for-each gou-rr! (list (m r) (m s) (m ac) (m bc) mxy (m (list '+ p1 p2)) (m p1) (m p2)
                          (list 'abs r) (list 'abs s)))
  (fact 'cc-magnitude-nonneg ac)
  (fact 'cc-magnitude-nonneg bc)
  ;; |r| <= |x - y| and |s| <= |x - y|, scaled
  (dk-have! (list '<= (m r) mxy) (lambda () (dk-ineq! (list '= (m r) (list 'abs r)) (list '<= (list 'abs r) mxy)
                                                     (list 'IN (m r) 'RR) (list 'IN (list 'abs r) 'RR) (list 'IN mxy 'RR))))
  (dk-have! (list '<= (m s) mxy) (lambda () (dk-ineq! (list '= (m s) (list 'abs s)) (list '<= (list 'abs s) mxy)
                                                     (list 'IN (m s) 'RR) (list 'IN (list 'abs s) 'RR) (list 'IN mxy 'RR))))
  (fact 'rr-mul-le-right (m r) mxy (m ac))
  (fact 'rr-mul-le-right (m s) mxy (m bc))
  (for-each gou-rr! (list (list '* (m r) (m ac)) (list '* mxy (m ac)) (list '* (m s) (m bc)) (list '* mxy (m bc))))
  (let ((rhs (caddr (dk-goal)))
        (ex (list '+ (list '* mxy (m ac)) (list '* mxy (m bc)))))
    (dk-have! (list '= rhs ex) (lambda () (crs)))
    (subst (list '= rhs ex)))
  (dk-ineq! (list 'IN (m (list '+ p1 p2)) 'RR) (list 'IN (m p1) 'RR) (list 'IN (m p2) 'RR)
            (list 'IN (list '* (m r) (m ac)) 'RR) (list 'IN (list '* mxy (m ac)) 'RR)
            (list 'IN (list '* (m s) (m bc)) 'RR) (list 'IN (list '* mxy (m bc)) 'RR)
            (list '<= (m (list '+ p1 p2)) (list '+ (m p1) (m p2)))
            (list '= (m p1) (list '* (m r) (m ac)))
            (list '= (m p2) (list '* (m s) (m bc)))
            (list '<= (list '* (m r) (m ac)) (list '* mxy (m ac)))
            (list '<= (list '* (m s) (m bc)) (list '* mxy (m bc)))))
(qed 'bary-lip)

;;; |1/2 d| = 1/2 |d|
(sp (make-wff (gou-all-in '(goux_) 'CC '(= (magnitude (* 1/2 goux_)) (* 1/2 (magnitude goux_))))))
(dk-peel!)
(gou-rr! 1/2)
(gou-cc! 1/2)
(gou-and! '(IN 1/2 CC) '(IN goux_ CC))
(subst (dk-cite! 'cc-magnitude-mul 1/2 'goux_))
(dk-have! '(<= 0 1/2) (lambda () (arith)))
(subst (dk-cite! 'rr-magnitude-is-abs 1/2))
(subst (dk-cite! 'rr-abs-of-nonneg 1/2))
(gou-rr! '(magnitude goux_))
(crs)
(qed 'half-magnitude)

;;; the abstract perimeter, and the four children of the barycentric subdivision:
;;; each child's perimeter is half the parent's, and its first vertex moves by at most
;;; the parent's perimeter
(define (gou-rho x y z)
  (list '+ (list '+ (list 'magnitude (list '- y x)) (list 'magnitude (list '- z y))) (list 'magnitude (list '- x z))))
(define gou-xyz-rho (gou-rho 'goux_ 'gouy_ 'gouz_))
(define gou-mxy '(CC-MID goux_ gouy_))
(define gou-myz '(CC-MID gouy_ gouz_))
(define gou-mxz '(CC-MID goux_ gouz_))
(define gou-parents '((- gouy_ goux_) (- gouz_ gouy_) (- goux_ gouz_)))
;;; (name child-vertices side-specs move-spec); a spec is (parent-index sign), sign + or -
(define gou-children
  (list (list 'tri-child-geom-1 (list 'goux_ gou-mxy gou-mxz) '((1 +) (2 +) (3 +)) 'zero)
        (list 'tri-child-geom-2 (list gou-mxy 'gouy_ gou-myz) '((1 +) (2 +) (3 +)) '(1 +))
        (list 'tri-child-geom-3 (list gou-mxz gou-myz 'gouz_) '((1 +) (2 +) (3 +)) '(3 -))
        (list 'tri-child-geom-4 (list gou-mxy gou-myz gou-mxz) '((3 -) (1 -) (2 -)) '(1 +))))
(define (gou-spec-term spec)
  (let ((p (list-ref gou-parents (- (car spec) 1))))
    (if (eq? (cadr spec) '+) p (list '- p))))
;;; rewrite D to (* 1/2 PT) in the goal, after proving the equation with the midpoints unfolded
(define (gou-half-eq! d pt)
  (gou-cc! d) (gou-cc! pt)
  (let ((e (list '= d (list '* 1/2 pt))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (for-each (lambda (m) (if (dk-contains? (dk-goal) m) (subst (dk-cite! 'cc-mid-unfold (cadr m) (caddr m)))))
                      (list gou-mxy gou-myz gou-mxz))
            (subst '(= (recip 2) 1/2))
            (crs))))
    e))
;;; |1/2 PT| = 1/2 |P| as landed equations; returns the chain of rewrites to apply in a goal
(define (gou-half-mag! spec)
  (let* ((pt (gou-spec-term spec)) (p (list-ref gou-parents (- (car spec) 1))))
    (dk-cite! 'half-magnitude pt)
    (if (eq? (cadr spec) '-) (dk-cite! 'cc-magnitude-neg p))
    (gou-rr! (list 'magnitude p))
    (fact 'cc-magnitude-nonneg p)
    (append (list (list '= (list 'magnitude (list '* 1/2 pt)) (list '* 1/2 (list 'magnitude pt))))
            (if (eq? (cadr spec) '-) (list (list '= (list 'magnitude pt) (list 'magnitude p))) '()))))
(for-each
 (lambda (ch)
   (let* ((name (car ch)) (vs (cadr ch)) (x1 (car vs)) (y1 (cadr vs)) (z1 (caddr vs))
          (sides (list (list '- y1 x1) (list '- z1 y1) (list '- x1 z1)))
          (mv (cadddr ch)))
     (sp (make-wff (gou-all-in '(goux_ gouy_ gouz_) 'CC
       (list 'AND (list '= (gou-rho x1 y1 z1) (list '* 1/2 gou-xyz-rho))
                  (list '<= (list 'magnitude (list '- x1 'goux_)) gou-xyz-rho)))))
     (dk-peel!)
     (gou-half!)
     (gou-rr! 1/2)
     (for-each gou-cc! (list gou-mxy gou-myz gou-mxz))
     (for-each (lambda (p) (gou-cc! p) (gou-rr! (list 'magnitude p)) (fact 'cc-magnitude-nonneg p)) gou-parents)
     (gou-rr! gou-xyz-rho)
     (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (if (eq? (gou-hd g) '=)
               ;; the perimeter
               (begin
                 (for-each (lambda (d spec) (subst (gou-half-eq! d (gou-spec-term spec)))) sides (caddr ch))
                 (for-each (lambda (spec) (for-each subst (gou-half-mag! spec))) (caddr ch))
                 (crs))
               ;; the move of the first vertex
               (if (eq? mv 'zero)
                   (begin
                     (dk-have! '(= (- goux_ goux_) 0) (lambda () (crs)))
                     (subst '(= (- goux_ goux_) 0))
                     (fact 'cc-magnitude-zero)
                     (subst '(= (magnitude 0) 0))
                     (apply dk-ineq! (append (list (list 'IN gou-xyz-rho 'RR))
                                             (map (lambda (p) (list '<= 0 (list 'magnitude p))) gou-parents)
                                             (map (lambda (p) (list 'IN (list 'magnitude p) 'RR)) gou-parents))))
                   (let ((d (list '- x1 'goux_)))
                     (subst (gou-half-eq! d (gou-spec-term mv)))
                     (for-each subst (gou-half-mag! mv))
                     (apply dk-ineq! (append (map (lambda (p) (list '<= 0 (list 'magnitude p))) gou-parents)
                                             (map (lambda (p) (list 'IN (list 'magnitude p) 'RR)) gou-parents)))))))))
     (qed name)))
 gou-children)

;;; the triangle integral is a complex number
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'IMPLIES (list 'SUBSET gou-C3 'u) '(IN (TRI-INT f goua_ goub_ gouc_) CC))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 'goua_ 'goub_ 'gouc_)))
(subst (dk-cite! 'tri-int-unfold 'f 'goua_ 'goub_ 'gouc_))
(for-each (lambda (xy)
            (fact 'subset-trans (gou-segtr (car xy) (cadr xy)) gou-C3 'u)
            (dk-cite! 'seg-int-in-cc 'u 'f (car xy) (cadr xy)))
          '((goua_ goub_) (goub_ gouc_) (gouc_ goua_)))
(gou-cc! '(+ (+ (SEG-INT f goua_ goub_) (SEG-INT f goub_ gouc_)) (SEG-INT f gouc_ goua_)))
(ass)
(qed 'tri-int-in-cc)

;;; ----------------------------------------------------------------------
;;; the nested triangles: a recursive choice (dc-on-nn-pred) on the standard
;;; triangle.  The state is a triple of abstract vertices, as nested pairs
;;; [x, [y, z]] in STD x (STD x STD); the next state is a child of the barycentric
;;; subdivision carrying at least a quarter of |J|, where J is the integral around
;;; the actual triangle V x, V y, V z.
;;; ----------------------------------------------------------------------
(define (gou-and* . fs) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (apply gou-and* (cdr fs)))))
(define (gou-R n) (list 'recip (list 'power 2 n)))
(define gou-S (list 'SEP 'gnq_ 'CC (gou-std 'gnq_)))
(define gou-X2 (list 'CARTESIAN gou-S gou-S))
(define gou-X3 (list 'CARTESIAN gou-S gou-X2))
(define (gou-tx t) (list 'NTH 1 t))
(define (gou-ty t) (list 'NTH 1 (list 'NTH 2 t)))
(define (gou-tz t) (list 'NTH 2 (list 'NTH 2 t)))
(define (gou-Jxyz x y z) (list 'magnitude (list 'TRI-INT 'f (gou-V x) (gou-V y) (gou-V z))))
(define (gou-J t) (gou-Jxyz (gou-tx t) (gou-ty t) (gou-tz t)))
(define (gou-rhoT t) (gou-rho (gou-tx t) (gou-ty t) (gou-tz t)))
(define gou-nxt
  (list 'VNB-LAMBDA '(LIST gnk_ gnt_) (list 'CARTESIAN 'NN gou-X3)
    (list 'SEP 'gny_ gou-X3
      (list 'AND (list '<= (gou-J 'gnt_) (list '* 4 (gou-J 'gny_)))
        (list 'AND (list '<= (gou-rhoT 'gny_) (list '* 1/2 (gou-rhoT 'gnt_)))
                   (list '<= (list 'magnitude (list '- (gou-tx 'gny_) (gou-tx 'gnt_))) (gou-rhoT 'gnt_)))))))
(define (gou-triple x y z) (list 'LIST x (list 'LIST y z)))

(define (gou-nth-r!)
  (let loop ((n 0))
    (if (and (< n 20)
             (let scan ((e (dk-goal)))
               (and (pair? e)
                    (or (and (eq? (car e) 'NTH) (pair? (cddr e)) (gou-op? (caddr e) 'LIST 3))
                        (any-pred scan e)))))
        (begin (nth-r) (loop (+ n 1))))))
;;; (IN x STD) in context: land x in CC and the three conditions
(define (gou-S-parts! x)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (dk-have! (list 'IN x 'CC) (lambda () (sep-me (dk-ctx-form (list 'IN x gou-S))) (ass))))
  (if (not (dk-asm? (car (gou-std-conds x))))
      (let ((sc (gou-std x)))
        (dk-have! sc (lambda () (sep-me (dk-ctx-form (list 'IN x gou-S))) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
        (dk-split-all! (list sc)))))
;;; x in CC and its conditions in context: land (IN x STD)
(define (gou-in-S! x)
  (if (not (dk-asm? (list 'IN x gou-S)))
      (dk-have! (list 'IN x gou-S)
        (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass)))))))))
;;; (IN t X3) in context: the three vertices in STD, in CC, with their conditions
(define (gou-T-parts! t)
  (if (not (dk-asm? (list 'IN (gou-tx t) gou-S)))
      (begin
        (dk-split! (dk-cite! 'cartesian-nth t gou-S gou-X2))
        (dk-split! (dk-cite! 'cartesian-nth (list 'NTH 2 t) gou-S gou-S))))
  (for-each gou-S-parts! (list (gou-tx t) (gou-ty t) (gou-tz t))))
(define (gou-triple-in! x y z)
  (fact 'pair-in-cartesian gou-S gou-S y z)
  (fact 'pair-in-cartesian gou-S gou-X2 x (list 'LIST y z)))
;;; re and im of a numeral point z = x + y i
(define (gou-coord-vals! z x y)
  (let ((e (list '+ x (list '* y '+i))))
    (gou-cc! e)
    (dk-have! (list '= z e) (lambda () (crs)))
    (dk-split! (dk-cite! 'cc-re-im-of z x y))))
;;; the facts about recip(2^n) at an index n in NN: 0 < 2^n, typings, and
;;; recip(2^(n+1)) = recip(2 * 2^n), recip(2^n) = 2 recip(2 * 2^n)
(define (gou-R-facts! n)
  (let* ((p (list 'power 2 n)) (q (list 'recip (list '* 2 p))))
    (gou-cc! 2)
    (fact 'power-two-pos n)
    (gou-rr! p)
    (gou-rr! (list '* 2 p))
    (if (not (dk-asm? (list '< 0 (list '* 2 p))))
        (dk-have! (list '< 0 (list '* 2 p)) (lambda () (dk-ineq! (list 'IN p 'RR) (list '< 0 p)))))
    (gou-rr! (gou-R n))
    (gou-rr! q)
    (fact 'rr-recip-pos p)
    (dk-cite! 'recip-power-two-halves n)
    q))

;;; the statement is named so the driver can refer to it
(define gou-nest-stmt (gou-under-H (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'IMPLIES (list 'SUBSET gou-C3 'u)
    (list 'FORSOME 'gouw_ (gou-and* '(IN gouw_ CC) (gou-std 'gouw_)
      (list 'FORALL 'goun_ (list 'IMPLIES '(IN goun_ NN)
        (list 'FORSOME 'goux_ (list 'FORSOME 'gouy_ (list 'FORSOME 'gouz_
          (gou-and* '(IN goux_ CC) '(IN gouy_ CC) '(IN gouz_ CC)
                    (gou-std 'goux_) (gou-std 'gouy_) (gou-std 'gouz_)
                    (list '<= gou-xyz-rho (list '* 6 (gou-R 'goun_)))
                    (list '<= '(magnitude (- goux_ gouw_)) (list '* 12 (gou-R 'goun_)))
                    (list '<= '(magnitude (TRI-INT f goua_ goub_ gouc_))
                          (list '* '(power 4 goun_) (gou-Jxyz 'goux_ 'gouy_ 'gouz_)))))))))))))))
(sp (make-wff gou-nest-stmt))
(dk-peel!)
(fact 'cc-is-set)
(fact 'nn-is-set)
(fact 'cc-i-in)
(gou-rr! 0) (gou-rr! 1) (gou-cc! 0) (gou-cc! 1)
;; the state space
(dk-have! (list 'SUBSET gou-S 'CC)
  (lambda () (let ((m (subset-by-element!))) (sep-me (list 'IN m gou-S)) (ass))))
(fact 'subclass-of-set-is-set gou-S 'CC)
(dk-have! (list 'IN gou-X2 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-have! (list 'IN gou-X3 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
;; the start: [1, [i, 0]], the standard triangle
(gou-coord-vals! 1 1 0)
(gou-coord-vals! '+i 0 1)
(gou-coord-vals! 0 0 0)
(for-each
 (lambda (z)
   (for-each (lambda (cnd)
               (dk-have! cnd
                 (lambda ()
                   (if (dk-contains? (dk-goal) (list 'real-part z))
                       (subst (dk-pick (lambda (fm) (and (gou-op? fm '= 3) (equal? (cadr fm) (list 'real-part z)))) "re")))
                   (if (dk-contains? (dk-goal) (list 'imag-part z))
                       (subst (dk-pick (lambda (fm) (and (gou-op? fm '= 3) (equal? (cadr fm) (list 'imag-part z)))) "im")))
                   (arith))))
             (gou-std-conds z))
   (gou-in-S! z))
 '(1 +i 0))
(define gou-T0 (gou-triple 1 '+i 0))
(gou-triple-in! 1 '+i 0)
;; the step is possible from every state
(define gou-C3-in-u (list 'SUBSET gou-C3 'u))
(define (gou-offer! k tt child i geq mids)
  (ew child)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (if (not (dk-lam-b!))
                (in-sep! (lambda () (ass))
                         (lambda ()
                           (gou-nth-r!)
                           (for-each (lambda (e) (if (dk-contains? (dk-goal) (cadr e)) (subst e))) mids)
                           (dk-conj-close!
                             (lambda ()
                               (let ((g (dk-goal)))
                                 (cond ((dk-asm? g) (ass))
                                       ((dk-contains? g '1/2)
                                        (subst geq)
                                        (gou-rr! (caddr geq))
                                        (fact 'rr-leq-reflexive (caddr geq))
                                        (ass))
                                       (#t (error "gou-offer!: unexpected leaf" (expression->string g)))))))))))))))
(define gou-step-claim
  (list 'FORALL 'gck_ (list 'IMPLIES '(IN gck_ NN)
    (list 'FORALL 'gcu_ (list 'IMPLIES (list 'IN 'gcu_ gou-X3)
      (list 'FORSOME 'gcy_ (list 'AND (list 'IN 'gcy_ gou-X3) (list 'IN 'gcy_ (list gou-nxt 'gck_ 'gcu_)))))))))
(dk-have! gou-step-claim
  (lambda ()
    (let* ((ls (dk-peel!))
           (k  (cadr (find-first (lambda (fm) (and (gou-op? fm 'IN 3) (eq? (caddr fm) 'NN))) ls)))
           (tt (cadr (find-first (lambda (fm) (and (gou-op? fm 'IN 3) (equal? (caddr fm) gou-X3))) ls)))
           (x (gou-tx tt)) (y (gou-ty tt)) (z (gou-tz tt))
           (A (gou-V x)) (B (gou-V y)) (C (gou-V z))
           (c3 (list 'CONV3 A B C))
           (mab (list 'CC-MID A B)) (mbc (list 'CC-MID B C)) (mac (list 'CC-MID A C))
           (t1 (list 'TRI-INT 'f A mab mac)) (t2 (list 'TRI-INT 'f mab B mbc))
           (t3 (list 'TRI-INT 'f mac mbc C)) (t4 (list 'TRI-INT 'f mab mbc mac))
           (s2 (list '+ t1 t2)) (s3 (list '+ s2 t3)) (s4 (list '+ s3 t4))
           (m (lambda (e) (list 'magnitude e)))
           (J (gou-J tt))
           (sum4 (list '+ (list '+ (list '+ (m t1) (m t2)) (m t3)) (m t4)))
           (mxy (list 'CC-MID x y)) (myz (list 'CC-MID y z)) (mxz (list 'CC-MID x z)))
      (gou-T-parts! tt)
      (for-each (lambda (p) (dk-cite! 'bary-in-conv3 'goua_ 'goub_ 'gouc_ p)) (list x y z))
      (for-each gou-cc! (list A B C mab mbc mac))
      (dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ A B C)
      (fact 'subset-trans c3 gou-C3 'u)
      (for-each (lambda (sub) (fact 'subset-trans (cadr sub) c3 'u))
                (dk-split-all! (list (dk-cite! 'conv3-sub-triangle A B C))))
      (let ((sub-eq (dk-cite! 'tri-int-subdivision 'u 'f A B C)))
        (dk-cite! 'tri-int-in-cc 'u 'f A B C)
        (for-each (lambda (tri) (dk-cite! 'tri-int-in-cc 'u 'f (list-ref tri 2) (list-ref tri 3) (list-ref tri 4))
                                (gou-rr! (m tri)) (fact 'cc-magnitude-nonneg tri))
                  (list t1 t2 t3 t4))
        (for-each gou-cc! (list s2 s3 s4))
        (for-each gou-rr! (list J (m s2) (m s3) (m s4)))
        (gou-and! (list 'IN t1 'CC) (list 'IN t2 'CC))
        (fact 'cc-magnitude-triangle t1 t2)
        (gou-and! (list 'IN s2 'CC) (list 'IN t3 'CC))
        (fact 'cc-magnitude-triangle s2 t3)
        (gou-and! (list 'IN s3 'CC) (list 'IN t4 'CC))
        (fact 'cc-magnitude-triangle s3 t4)
        (dk-have! (list '<= J sum4)
          (lambda ()
            (subst sub-eq)
            (dk-ineq! (list 'IN (m s4) 'RR) (list 'IN (m s3) 'RR) (list 'IN (m s2) 'RR)
                      (list 'IN (m t1) 'RR) (list 'IN (m t2) 'RR) (list 'IN (m t3) 'RR) (list 'IN (m t4) 'RR)
                      (list '<= (m s4) (list '+ (m s3) (m t4)))
                      (list '<= (m s3) (list '+ (m s2) (m t3)))
                      (list '<= (m s2) (list '+ (m t1) (m t2)))))))
      (let ((q4 (dk-cite! 'quarter-step J (m t1) (m t2) (m t3) (m t4)))
            (mids (list (dk-cite! 'bary-mid 'goua_ 'goub_ 'gouc_ x y)
                        (dk-cite! 'bary-mid 'goua_ 'goub_ 'gouc_ y z)
                        (dk-cite! 'bary-mid 'goua_ 'goub_ 'gouc_ x z))))
        ;; the midpoints are in STD, the children are states
        (for-each (lambda (pq)
                    (let ((mm (list 'CC-MID (car pq) (cadr pq))))
                      (dk-split-all! (list (dk-cite! 'std-mid (car pq) (cadr pq))))
                      (gou-cc! mm)
                      (gou-in-S! mm)))
                  (list (list x y) (list y z) (list x z)))
        (let* ((kids (list (list x mxy mxz) (list mxy y myz) (list mxz myz z) (list mxy myz mxz)))
               (geqs (map (lambda (nm)
                            (let ((pr (dk-cite! nm x y z)))
                              (dk-split! pr)
                              (cadr pr)))
                          '(tri-child-geom-1 tri-child-geom-2 tri-child-geom-3 tri-child-geom-4))))
          (for-each (lambda (kd) (gou-triple-in! (car kd) (cadr kd) (caddr kd))) kids)
          (fact 'pair-in-cartesian 'NN gou-X3 k tt)
          (gou-rr! (gou-rhoT tt))
          (use-cases q4
            (lambda () (gou-offer! k tt (apply gou-triple (list-ref kids 0)) 1 (list-ref geqs 0) mids))
            (lambda () (gou-offer! k tt (apply gou-triple (list-ref kids 1)) 2 (list-ref geqs 1) mids))
            (lambda () (gou-offer! k tt (apply gou-triple (list-ref kids 2)) 3 (list-ref geqs 2) mids))
            (lambda () (gou-offer! k tt (apply gou-triple (list-ref kids 3)) 4 (list-ref geqs 3) mids))))))))
;; the recursion
(define gou-F (dk-skolem! (dk-fact! 'dc-on-nn-pred gou-X3 gou-T0 gou-nxt)))
;; J of a state T in context is a real: its actual triangle lies in the hull, hence in u
(define (gou-J-typed! t)
  (let* ((x (gou-tx t)) (y (gou-ty t)) (z (gou-tz t))
         (A (gou-V x)) (B (gou-V y)) (C (gou-V z)) (c3 (list 'CONV3 A B C)))
    (gou-T-parts! t)
    (if (not (dk-asm? (list 'IN (gou-J t) 'RR)))
        (begin
          (for-each (lambda (p) (dk-cite! 'bary-in-conv3 'goua_ 'goub_ 'gouc_ p)) (list x y z))
          (for-each gou-cc! (list A B C))
          (dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ A B C)
          (fact 'subset-trans c3 gou-C3 'u)
          (dk-cite! 'tri-int-in-cc 'u 'f A B C)
          (gou-rr! (gou-J t))))))
(define gou-stp
  (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm gou-F) (dk-contains? fm 'succ)))
           "the per-stage step"))
(define gou-F0 (dk-pick (lambda (fm) (and (gou-op? fm '= 3) (equal? (cadr fm) (list gou-F 0)))) "F(0) = T0"))
(fact 'nn-zero-in)
;; stage K (typed NN): both states typed and opened, the three step conditions landed
(define (gou-stage! k)
  (let ((fk (list gou-F k)) (fk1 (list gou-F (list 'succ k))))
    (fact 'nn-succ-closed k)
    (fact 'fun-apply-type-c gou-F 'NN gou-X3 k)
    (fact 'fun-apply-type-c gou-F 'NN gou-X3 (list 'succ k))
    (gou-T-parts! fk)
    (gou-T-parts! fk1)
    (fact 'pair-in-cartesian 'NN gou-X3 k fk)
    (let* ((inst (dk-apply! gou-stp k))
           (red  (car (dk-landed (lambda () (lam-b-h inst))))))
      (dk-split-all! (dk-landed (lambda () (sep-me red)))))
    (for-each gou-rr! (list (gou-rhoT fk) (gou-rhoT fk1)))
    (gou-J-typed! fk)
    (gou-J-typed! fk1)))
;; the perimeter of any state is at most 6 (two points of STD are at most 2 apart)
(define (gou-rho6! t)
  (let ((x (gou-tx t)) (y (gou-ty t)) (z (gou-tz t)))
    (gou-T-parts! t)
    (for-each (lambda (pq) (dk-cite! 'std-dist (car pq) (cadr pq)) (gou-rr! (list 'magnitude (list '- (car pq) (cadr pq)))))
              (list (list y x) (list z y) (list x z)))
    (gou-rr! (gou-rhoT t))
    (dk-have! (list '<= (gou-rhoT t) 6)
      (lambda ()
        (dk-ineq! (list 'IN (list 'magnitude (list '- y x)) 'RR) (list 'IN (list 'magnitude (list '- z y)) 'RR)
                  (list 'IN (list 'magnitude (list '- x z)) 'RR)
                  (list '<= (list 'magnitude (list '- y x)) 2) (list '<= (list 'magnitude (list '- z y)) 2)
                  (list '<= (list 'magnitude (list '- x z)) 2))))))
;; (I-rho) rho(F n) <= 6 recip(2^n)
(define gou-Irho
  (list 'FORALL 'gnn_ (list 'IMPLIES '(IN gnn_ NN) (list '<= (gou-rhoT (list gou-F 'gnn_)) (list '* 6 (gou-R 'gnn_))))))
(dk-have! gou-Irho
  (lambda ()
    (let* ((br (use-induction)) (n (cdr (assq 'var br))) (ih (cdr (assq 'ih br))))
      (dk-focus! (cdr (assq 'base br)))
      (fact 'fun-apply-type-c gou-F 'NN gou-X3 0)
      (gou-rho6! (list gou-F 0))
      (gou-cc! 2)
      (subst (dk-cite! 'power-zero 2))
      (dk-have! '(= (recip 1) 1) (lambda () (arith)))
      (subst '(= (recip 1) 1))
      (dk-ineq! (list 'IN (gou-rhoT (list gou-F 0)) 'RR) (list '<= (gou-rhoT (list gou-F 0)) 6))
      (dk-focus! (cdr (assq 'step br)))
      (gou-stage! n)
      (let ((q (gou-R-facts! n)))
        (gou-and! '(IN 2 CC) (list 'IN n 'NN))
        (subst (dk-cite! 'power-succ 2 n))
        (dk-ineq! (list 'IN (gou-rhoT (list gou-F n)) 'RR) (list 'IN (gou-rhoT (list gou-F (list 'succ n))) 'RR)
                  (list 'IN (gou-R n) 'RR) (list 'IN q 'RR)
                  ih
                  (list '<= (gou-rhoT (list gou-F (list 'succ n))) (list '* 1/2 (gou-rhoT (list gou-F n))))
                  (list '= (gou-R n) (list '* 2 q)))))))
;; (I-J) |J(F 0)| <= 4^n |J(F n)|
(define gou-IJ
  (list 'FORALL 'gnn_ (list 'IMPLIES '(IN gnn_ NN)
    (list '<= (gou-J (list gou-F 0)) (list '* '(power 4 gnn_) (gou-J (list gou-F 'gnn_)))))))
(define gou-4assoc
  (gou-all-in '(gnp_ gnj_) 'RR '(= (* (* 4 gnp_) gnj_) (* gnp_ (* 4 gnj_)))))
(dk-have! gou-4assoc (lambda () (dk-peel!) (crs)))
(dk-have! gou-IJ
  (lambda ()
    (let* ((br (use-induction)) (n (cdr (assq 'var br))) (ih (cdr (assq 'ih br))))
      (dk-focus! (cdr (assq 'base br)))
      (fact 'fun-apply-type-c gou-F 'NN gou-X3 0)
      (gou-J-typed! (list gou-F 0))
      (gou-cc! 4)
      (subst (dk-cite! 'power-zero 4))
      (dk-ineq! (list 'IN (gou-J (list gou-F 0)) 'RR))
      (dk-focus! (cdr (assq 'step br)))
      (gou-stage! n)
      (let* ((p (list 'power 4 n))
             (jn (gou-J (list gou-F n))) (jn1 (gou-J (list gou-F (list 'succ n)))) (j0 (gou-J (list gou-F 0))))
        (gou-rr! 4)
        (dk-have! '(< 0 4) (lambda () (arith)))
        (fact 'rr-power-pos 4 n)
        (gou-rr! p)
        (dk-have! (list '<= 0 p) (lambda () (dk-ineq! (list 'IN p 'RR) (list '< 0 p))))
        (fact 'fun-apply-type-c gou-F 'NN gou-X3 0)
        (gou-J-typed! (list gou-F 0))
        (gou-rr! (list '* 4 jn1))
        (gou-and! (list '<= 0 p) (list '<= jn (list '* 4 jn1)))
        (fact 'rr-le-scale-nonneg p jn (list '* 4 jn1))
        (dk-apply! (dk-ctx-form gou-4assoc) p jn1)
        (gou-cc! 4)
        (gou-and! '(IN 4 CC) (list 'IN n 'NN))
        (subst (dk-cite! 'power-succ 4 n))
        (for-each gou-rr! (list (list '* p jn) (list '* p (list '* 4 jn1)) (list '* (list '* 4 p) jn1)))
        (dk-ineq! (list 'IN j0 'RR) (list 'IN (list '* p jn) 'RR) (list 'IN (list '* p (list '* 4 jn1)) 'RR)
                  (list 'IN (list '* (list '* 4 p) jn1) 'RR)
                  ih
                  (list '<= (list '* p jn) (list '* p (list '* 4 jn1)))
                  (list '= (list '* (list '* 4 p) jn1) (list '* p (list '* 4 jn1))))))))
;; the first-vertex sequence, and its telescoping bound
(define gou-sx (list 'VNB-LAMBDA 'gnm_ 'NN (list 'NTH 1 (list gou-F 'gnm_))))
(dk-have! (list 'IN gou-sx '(FUN NN CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((n (dk-di-var!)))
          (fact 'fun-apply-type-c gou-F 'NN gou-X3 n)
          (dk-split! (dk-cite! 'cartesian-nth (list gou-F n) gou-S gou-X2))
          (sep-me (dk-ctx-form (list 'IN (gou-tx (list gou-F n)) gou-S)))
          (dk-split-all!)
          (ass))))))
(dk-have! (list 'FORALL 'gnk_ (list 'IMPLIES '(IN gnk_ NN)
            (list '<= (list 'magnitude (list '- (list gou-sx '(succ gnk_)) (list gou-sx 'gnk_)))
                  (list '* 6 (gou-R 'gnk_)))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (gou-stage! k)
      (dk-apply! (dk-ctx-form gou-Irho) k)
      (gou-R-facts! k)
      (if (not (dk-lam-b!))
          (let ((d (list 'magnitude (list '- (gou-tx (list gou-F (list 'succ k))) (gou-tx (list gou-F k))))))
            (gou-rr! d)
            (dk-ineq! (list 'IN d 'RR) (list 'IN (gou-rhoT (list gou-F k)) 'RR) (list 'IN (gou-R k) 'RR)
                      (list '<= d (gou-rhoT (list gou-F k)))
                      (list '<= (gou-rhoT (list gou-F k)) (list '* 6 (gou-R k)))))))))
(gou-rr! 6)
(dk-have! '(<= 0 6) (lambda () (arith)))
(define gou-w (dk-skolem! (dk-cite! 'cc-telescoping-limit-bound gou-sx 6)))
(define gou-wb (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm gou-w) (dk-contains? fm 'magnitude)))
                        "the distance to the limit"))
;; the limit is in STD
(dk-have! (list 'FORALL 'gnm_ (list 'IMPLIES '(IN gnm_ NN) (gou-std (list gou-sx 'gnm_))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (fact 'fun-apply-type-c gou-F 'NN gou-X3 n)
      (gou-T-parts! (list gou-F n))
      (if (not (dk-lam-b!)) (dk-conj-close! (lambda () (ass)))))))
(dk-split-all! (list (dk-cite! 'std-limit gou-sx gou-w)))
;; J(F 0) is the integral around a, b, c
(dk-split-all! (list (dk-cite! 'bary-vertices 'goua_ 'goub_ 'gouc_)))
(dk-cite! 'tri-int-in-cc 'u 'f 'goua_ 'goub_ 'gouc_)
(gou-rr! '(magnitude (TRI-INT f goua_ goub_ gouc_)))
(dk-have! (list '= (gou-J (list gou-F 0)) '(magnitude (TRI-INT f goua_ goub_ gouc_)))
  (lambda ()
    (subst gou-F0)
    (gou-nth-r!)
    (subst (list '= (gou-V 1) 'goua_))
    (subst (list '= (gou-V '+i) 'goub_))
    (subst (list '= (gou-V 0) 'gouc_))
    (rfl)))
;; the conclusion
(ew gou-w)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (not (eq? (gou-hd g) 'FORALL))
          (ass)
          (let* ((n (dk-di-var!)) (fn (list gou-F n))
                 (x (gou-tx fn)) (y (gou-ty fn)) (z (gou-tz fn)))
            (fact 'fun-apply-type-c gou-F 'NN gou-X3 n)
            (gou-T-parts! fn)
            (dk-apply! (dk-ctx-form gou-Irho) n)
            (dk-apply! (dk-ctx-form gou-IJ) n)
            (dk-apply! gou-wb n)
            (gou-R-facts! n)
            (gou-J-typed! fn)
            (fact 'fun-apply-type-c gou-F 'NN gou-X3 0)
            (gou-J-typed! (list gou-F 0))
            (gou-rr! (list '* '(power 4 goun_) (gou-J fn)))
            (fact 'fun-apply-type-c gou-sx 'NN 'CC n)
            (dk-have! (list '= (list gou-sx n) x) (lambda () (if (not (dk-lam-b!)) (rfl))))
            (ew x) (ew y) (ew z)
            (dk-conj-close!
              (lambda ()
                (let ((g2 (dk-goal)))
                  (cond ((dk-asm? g2) (ass))
                        ((dk-contains? g2 gou-w)
                         (subst (list '= x (list gou-sx n)))
                         (let ((d (list 'magnitude (list '- (list gou-sx n) gou-w))))
                           (gou-rr! d)
                           (dk-ineq! (list 'IN d 'RR) (list 'IN (gou-R n) 'RR)
                                     (list '<= d (list '* (list '* 2 6) (gou-R n))))))
                        (#t
                         (let ((p4 (list '* (list 'power 4 n) (gou-J fn))))
                           (gou-rr! p4)
                           (dk-ineq! (list 'IN (gou-J (list gou-F 0)) 'RR) '(IN (magnitude (TRI-INT f goua_ goub_ gouc_)) RR)
                                     (list 'IN p4 'RR)
                                     (list '<= (gou-J (list gou-F 0)) p4)
                                     (list '= (gou-J (list gou-F 0)) '(magnitude (TRI-INT f goua_ goub_ gouc_)))))))))))))))
(qed 'goursat-nest)

