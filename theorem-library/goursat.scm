;;; (8) COROLLARY 3.9: ON A CONVEX OPEN SET THE INTEGRAL OVER A CLOSED ROAD IS 0
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (IS-CONVEX u) (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL pgam (FORALL dgam (FORALL a (FORALL b
    (IMPLIES (IS-ROAD pgam dgam a b) (IMPLIES (SUBSET (TRACE pgam a b) u)
      (IMPLIES (= (pgam b) (pgam a)) (= (LINE-INT f pgam dgam a b) 0))))))))))))))
(dk-peel!)
(gou-holo-setup!)
(fact 'is-road-is-path 'pgam 'dgam 'a 'b)
(fact 'is-path-in-fun 'pgam 'a 'b)
(dk-split-all! (list (dk-cite! 'is-path-endpoints 'pgam 'a 'b)))
(dk-have! '(IN a (CCINT a b))
  (lambda ()
    (mac 'ccint-membership)
    (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(IN a RR) '(IN b RR) '(< a b)))))))
(dk-cite! 'trace-value-in 'pgam 'a 'b 'a)
(fact 'subset-mem-fwd '(TRACE pgam a b) 'u '(pgam a))
(define gou-cc-g (dk-skolem! (dk-cite! 'cauchy-convex-primitive 'u 'f '(pgam a))))
(dk-cite! 'line-int-closed-road-of-derivative 'u gou-cc-g 'f 'pgam 'dgam 'a 'b)
(ass)
(qed 'cauchy-convex-closed)
