(dk-cite! 'holomorphic-sum 'u 'f gou-g2 gou-Rf)
(dk-cite! 'holomorphic-on-continuous 'u gou-Rf)
(dk-cite! 'holomorphic-on-continuous 'u gou-g)
;; f = R + g on u
(dk-have! (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u)
            (list '== '(f gouz_) (list '+ (list gou-Rf 'gouz_) (list gou-g 'gouz_)))))
  (lambda ()
    (let* ((z (dk-di-var!)) (fz (list 'f z)))
