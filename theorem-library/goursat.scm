;;; ----------------------------------------------------------------------
;;; Differentiability from a LOCAL quadratic bound: if |F(x) - F(a) - (x - a) L| <=
;;; M |x - a|^2 for x in S with |x - a| < r, then F is differentiable at a with
;;; derivative L.  The proof is cc-diff-on-quadratic's (cc-power-series-deriv.scm, the
;;; Caratheodory factor as an IF term), with delta also kept below r.
;;; ----------------------------------------------------------------------
(define gdl-cc-typ! gou-cc!)
(define gdl-rr-typ! gou-rr!)
(define gdl-head gou-hd)
(define (gdl-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (gdl-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
                      (dk-conj-close! (lambda () (ass))))))))

(define gdl-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define gdl-sub '(SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) gdls_))
(define (gdl-dq v) (list '* (list '- (list 'gdlf_ v) '(gdlf_ gdla_)) (list 'recip (list '- v 'gdla_))))
(define (gdl-ift v) (list 'IF (list '= v 'gdla_) 'gdll_ (gdl-dq v)))
(define gdl-phi (list 'VNB-LAMBDA 'gdlv_ 'gdls_ (gdl-ift 'gdlv_)))
(define (gdl-err x) (list '- (list '- (list 'gdlf_ x) '(gdlf_ gdla_)) (list '* (list '- x 'gdla_) 'gdll_)))
(define gdl-qb
  (list 'FORALL 'gdlx_ (list 'IMPLIES '(IN gdlx_ gdls_)
    (list 'IMPLIES '(< (magnitude (- gdlx_ gdla_)) gdlr_)
      (list '<= (list 'magnitude (gdl-err 'gdlx_))
                '(* gdlm_ (* (magnitude (- gdlx_ gdla_)) (magnitude (- gdlx_ gdla_)))))))))

;;; An IF term on the side the context decides: the kit's (dk-if-branch! TRUE? IFT #f K)
;;; (condition leaf by `ass', K on the rewritten main leaf).  (gdl-if! retired 2026-09-25.)

;;; t in RR, 0 < t  ==>  POS-RR(t)
(define (gdl-pos! t)
  (fact 'rr-lt-implies-le 0 t)
  (fact 'rr-pos-ne-zero t)
  (fact 'neq-sym t 0)
  (dk-have! (list 'POS-RR t) (lambda () (mac 'pos-rr) (from-context!))))

;;; v in U  ==>  v in CC, f(v) in CC
(define (gdl-qd-pt! v)
  (fact 'subset-mem-fwd 'gdls_ 'CC v)
  (fact 'fun-apply-type-c 'gdlf_ 'gdls_ 'CC v))

;;; NOT(v = a)  ==>  NOT(v - a = 0), recip(v - a) in CC, (v - a) recip(v - a) = 1
(define (gdl-qd-nz! v)
  (let ((d (list '- v 'gdla_)))
    (gdl-cc-typ! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= v 'gdla_)
          (lambda ()
            (dk-have! (list '= v (list '+ d 'gdla_)) (lambda () (crs)))
            (subst (list '= v (list '+ d 'gdla_)))
            (subst (list '= d 0))
            (crs)))
        (ai (list 'NOT (list '= v 'gdla_)))))
    (gdl-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
    (fact 'cc-recip-closed d)
    (fact 'cc-recip-inverse d)
    (gdl-cc-typ! (gdl-dq v))))

(sp (make-wff
  (list 'FORALL 'gdls_ (list 'IMPLIES (list 'IS-OPEN gdl-nfm 'gdls_)
    (list 'FORALL 'gdlf_ (list 'IMPLIES '(IN gdlf_ (FUN gdls_ CC))
      (list 'FORALL 'gdla_ (list 'IMPLIES '(IN gdla_ gdls_)
        (list 'FORALL 'gdll_ (list 'IMPLIES '(IN gdll_ CC)
          (list 'FORALL 'gdlm_ (list 'IMPLIES '(IN gdlm_ RR) (list 'IMPLIES '(<= 0 gdlm_)
            (list 'FORALL 'gdlr_ (list 'IMPLIES '(POS-RR gdlr_)
              (list 'IMPLIES gdl-qb '(IS-DIFF-ON CC-NORMED-FIELD gdls_ gdlf_ gdla_ gdll_)))))))))))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'gdlr_)
(fact 'rr-lt-of-pos-rr 'gdlr_)
(fact 'cc-is-normed-field)
(fact 'nf-cc-is-metric-space)
(fact 'nf-metric-carrier 'CC-NORMED-FIELD)
(fact 'cc-nf-carr)
(dk-have! (list '== (list 'PTS gdl-nfm) 'CC)
  (lambda () (subst (list '== (list 'PTS gdl-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-have! (list 'SUBSET 'gdls_ (list 'PTS gdl-nfm))
  (lambda () (mac-h 'is-open (list 'IS-OPEN gdl-nfm 'gdls_)) (dk-split-all!) (ass)))
(dk-have! '(SUBSET gdls_ CC) (lambda () (subst (list '== 'CC (list 'PTS gdl-nfm))) (ass)))
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'gdls_)
(fact 'subspace-is-metric-space gdl-nfm 'gdls_)
(fact 'subspace-pts gdl-nfm 'gdls_)
(gdl-pts-cc!)
(gdl-qd-pt! 'gdla_)
;; the factor is a function U -> CC
(define gdl-qd-pt
  (list 'FORALL 'gdlv_ (list 'IMPLIES '(IN gdlv_ gdls_) (list 'IN (gdl-ift 'gdlv_) 'CC))))
(dk-have! gdl-qd-pt
  (lambda ()
    (let ((v (dk-di-var!)))
      (gdl-qd-pt! v)
      (use-em (list '= v 'gdla_)
        (lambda () (dk-if-branch! #t (gdl-ift v) #f (lambda () (ass))))
        (lambda () (gdl-qd-nz! v) (dk-if-branch! #f (gdl-ift v) #f (lambda () (ass))))))))
(dk-have! (list 'IN gdl-phi '(FUN gdls_ CC))
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (let ((g (dk-goal)))
         (cond ((equal? g '(IN gdls_ SET)) (ass))
               ((eq? (gdl-head g) 'FORALL)
                (let ((v (dk-di-var!))) (inst+ gdl-qd-pt v) (ass)))
               (#t (error "gdl: unexpected lam-t leaf" (expression->string g))))))
     (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN gdl-phi '(FUN gdls_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! '(IN gdlf_ (FUN gdls_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! '(IN gdll_ (CARR CC-NORMED-FIELD))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
;; phi(a) = L
(define gdl-qd-pa (list '= (list gdl-phi 'gdla_) 'gdll_))
(dk-have! gdl-qd-pa
  (lambda ()
    (dk-lam-b!)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-contains? (dk-goal) (gdl-ift 'gdla_))
           (begin (subst (list '= (gdl-ift 'gdla_) 'gdll_)) (rfl))
           (rfl)))
     (dk-opened (lambda () (if-true (gdl-ift 'gdla_)))))))
;; continuity of phi at a
(fact 'cc-magnitude-closed 'gdll_)
(define gdl-qd-dl (list '* 'gdlm_ '(+ gdlm_ 1)))
(dk-have! (list 'IS-CONTINUOUS-AT gdl-sub gdl-nfm gdl-phi 'gdla_)
  (lambda ()
    (mac 'is-continuous-at)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
          ((eq? (gdl-head g) 'FORALL)
           (let* ((ep (dk-peel!))
                  (eps (cadr (car (filter (dk-head? 'POS-RR) ep))))
                  (m1 '(+ gdlm_ 1))
                  (del0 (list '* eps (list 'recip m1))))
             (fact 'rr-pos-rr-in-rr eps)
             (fact 'rr-lt-of-pos-rr eps)
             (gdl-rr-typ! m1)
             (dk-have! (list '< 0 m1) (lambda () (dk-ineq! '(<= 0 gdlm_))))
             (fact 'rr-pos-ne-zero m1)
             (gdl-and! (list 'IN m1 'RR) (list 'NOT (list '= m1 0)))
             (fact 'rr-recip-closed m1)
             (fact 'rr-recip-inverse m1)
             (fact 'rr-recip-pos m1)
             (fact 'rr-mul-in-rr eps (list 'recip m1))
             (fact 'rr-mul-pos eps (list 'recip m1))
             (gdl-pos! del0)
             (fact 'rr-lt-implies-le 0 del0)
             (dk-have! (list '= (list '* m1 del0) eps)
               (lambda ()
                 (dk-have! (list '= (list '* m1 del0) (list '* eps (list '* m1 (list 'recip m1)))) (lambda () (crs)))
                 (subst (list '= (list '* m1 del0) (list '* eps (list '* m1 (list 'recip m1)))))
                 (subst (list '= (list '* m1 (list 'recip m1)) 1))
                 (crs)))
             (let ((gdl-go! (lambda (del)
             (ew del)
             (dk-conj-close!
              (lambda ()
                (if (not (eq? (gdl-head (dk-goal)) 'FORALL))
                    (ass)
                    (let* ((lk (dk-peel!))
                           (b (cadr (car (filter (dk-head? 'IN) lk))))
                           (dab (list 'magnitude (list '- 'gdla_ b)))
                           (dba (list 'magnitude (list '- b 'gdla_))))
                      (dk-have! (list 'IN b 'gdls_) (lambda () (subst (list '== 'gdls_ (list 'PTS gdl-sub))) (ass)))
                      (gdl-qd-pt! b)
                      (inst+ gdl-qd-pt b)
                      ;; the hypothesis dist(a, b) <= delta, read as |b - a| <= delta
                      (fact 'subspace-dist gdl-nfm 'gdls_ 'gdla_ b)
                      (dk-have! (list 'IN 'gdla_ '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                      (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                      (fact 'nf-cc-agree-dist 'gdla_ b)
                      (fact 'cc-ms-dist 'gdla_ b)
                      (gdl-rr-typ! dab) (gdl-rr-typ! dba)
                      (fact 'cc-magnitude-sub-sym 'gdla_ b)
                      (dk-have! (list '<= dba del)
                        (lambda ()
                          (subst (list '= dba dab))
                          (subst (list '== dab (list '(DIST CC-MS) 'gdla_ b)))
                          (subst (list '== (list '(DIST CC-MS) 'gdla_ b) (list (list 'DIST gdl-nfm) 'gdla_ b)))
                          (subst (list '== (list (list 'DIST gdl-nfm) 'gdla_ b) (list (list 'DIST gdl-sub) 'gdla_ b)))
                          (ass)))
                      ;; the goal, read as |L - phi(b)| <= eps
                      (subst gdl-qd-pa)
                      (dk-lam-b!)
                      (let ((pb (gdl-ift b)))
                        (dk-have! (list 'IN 'gdll_ '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (dk-have! (list 'IN pb '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (fact 'nf-cc-agree-dist 'gdll_ pb)
                        (fact 'cc-ms-dist 'gdll_ pb)
                        (subst (list '== (list (list 'DIST gdl-nfm) 'gdll_ pb) (list '(DIST CC-MS) 'gdll_ pb)))
                        (subst (list '== (list '(DIST CC-MS) 'gdll_ pb) (list 'magnitude (list '- 'gdll_ pb))))
                        (use-em (list '= b 'gdla_)
                          (lambda ()
                            (dk-if-branch! #t pb #f (lambda ()
                                (dk-have! '(= (- gdll_ gdll_) 0) (lambda () (crs)))
                                (subst '(= (- gdll_ gdll_) 0))
                                (fact 'cc-magnitude-zero)
                                (subst '(= (magnitude 0) 0))
                                (dk-ineq! (list '< 0 eps)))))
                          (lambda ()
                            (gdl-qd-nz! b)
                            (dk-if-branch! #f pb #f (lambda ()
                                (let* ((q (gdl-dq b)) (lq (list '- 'gdll_ q)) (d (list '- b 'gdla_))
                                       (e (gdl-err b)) (mlq (list 'magnitude lq)))
                                  (for-each gdl-cc-typ! (list q lq e))
                                  (gdl-rr-typ! mlq)
                                  (gdl-rr-typ! (list 'magnitude e))
                                  ;; (L - Q)(b - a) = -(f(b) - f(a) - (b - a) L)
                                  (dk-have! (list '= (list '* lq d) (list '- e))
                                    (lambda ()
                                      (let ((ex (list '- (list '* 'gdll_ d)
                                                         (list '* (list '- (list 'gdlf_ b) '(gdlf_ gdla_))
                                                                  (list '* d (list 'recip d))))))
                                        (dk-have! (list '= (list '* lq d) ex) (lambda () (crs)))
                                        (subst (list '= (list '* lq d) ex))
                                        (subst (list '= (list '* d (list 'recip d)) 1))
                                        (crs))))
                                  (gdl-and! (list 'IN lq 'CC) (list 'IN d 'CC))
                                  (fact 'cc-magnitude-mul lq d)
                                  (fact 'cc-magnitude-neg e)
                                  (dk-have! (list '< dba 'gdlr_)
                                    (lambda () (dk-ineq! (list 'IN dba 'RR) (list 'IN del 'RR) '(IN gdlr_ RR)
                                                         (list '<= dba del) (list '< del 'gdlr_))))
                                  (dk-apply! (dk-ctx-form gdl-qb) b)
                                  (gdl-rr-typ! (list '* mlq dba))
                                  (gdl-rr-typ! (list '* 'gdlm_ dba))
                                  (gdl-rr-typ! (list '* (list '* 'gdlm_ dba) dba))
                                  (gdl-rr-typ! (list '* 'gdlm_ (list '* dba dba)))
                                  (dk-have! (list '= (list '* 'gdlm_ (list '* dba dba)) (list '* (list '* 'gdlm_ dba) dba))
                                            (lambda () (crs)))
                                  (dk-have! (list '<= (list '* mlq dba) (list '* (list '* 'gdlm_ dba) dba))
                                    (lambda ()
                                      (dk-have! (list '= (list '* mlq dba) (list 'magnitude e))
                                        (lambda ()
                                          (subst (list '= (list '* mlq dba) (list 'magnitude (list '* lq d))))
                                          (subst (list '= (list '* lq d) (list '- e)))
                                          (subst (list '= (list 'magnitude (list '- e)) (list 'magnitude e)))
                                          (rfl)))
                                      (dk-ineq! (list '= (list '* mlq dba) (list 'magnitude e))
                                                (list '<= (list 'magnitude e) (list '* 'gdlm_ (list '* dba dba)))
                                                (list '= (list '* 'gdlm_ (list '* dba dba)) (list '* (list '* 'gdlm_ dba) dba)))))
                                  ;; |b - a| > 0: cancel it
                                  (fact 'cc-magnitude-nonneg d)
                                  (fact 'cc-magnitude-zero-iff d)
                                  (dk-have! (list 'NOT (list '= dba 0))
                                    (lambda ()
                                      (dk-only! (list 'IFF (list '= dba 0) (list '= d 0)) (list 'NOT (list '= d 0)))
                                      (prop)))
                                  (fact 'neq-sym dba 0)
                                  (gdl-and! (list '<= 0 dba) (list 'NOT (list '= 0 dba)))
                                  (fact 'rr-le-ne-lt 0 dba)
                                  (fact 'rr-mul-le-cancel-pos mlq dba (list '* 'gdlm_ dba))
                                  ;; M |b - a| <= M delta <= (M + 1) delta = eps
                                  (gdl-and! '(<= 0 gdlm_) (list '<= dba del))
                                  (fact 'rr-le-scale-nonneg 'gdlm_ dba del)
                                  (gdl-rr-typ! (list '* 'gdlm_ del))
                                  (gdl-rr-typ! (list '* m1 del))
                                  (dk-have! (list '= (list '* m1 del) (list '+ (list '* 'gdlm_ del) del)) (lambda () (crs)))
                                  (dk-ineq! (list '<= mlq (list '* 'gdlm_ dba))
                                            (list '<= (list '* 'gdlm_ dba) (list '* 'gdlm_ del))
                                            (list '= (list '* m1 del) (list '+ (list '* 'gdlm_ del) del))
                                            (list '<= (list '* m1 del) eps)
                                            (list '<= 0 del)))))))))))))))
               (use-em (list '<= 'gdlr_ del0)
                 (lambda ()
                   (let ((del1 '(* 1/2 gdlr_)))
                     (gdl-rr-typ! del1)
                     (dk-have! (list '< 0 del1) (lambda () (dk-ineq! '(IN gdlr_ RR) '(< 0 gdlr_))))
                     (gdl-pos! del1)
                     (fact 'rr-lt-implies-le 0 del1)
                     (dk-have! (list '< del1 'gdlr_) (lambda () (dk-ineq! '(IN gdlr_ RR) '(< 0 gdlr_))))
                     (dk-have! (list '<= del1 del0)
                       (lambda () (dk-ineq! '(IN gdlr_ RR) (list 'IN del0 'RR) (list '<= 'gdlr_ del0) '(< 0 gdlr_))))
                     (fact 'rr-lt-implies-le 0 m1)
                     (gdl-and! (list '<= 0 m1) (list '<= del1 del0))
                     (fact 'rr-le-scale-nonneg m1 del1 del0)
                     (gdl-rr-typ! (list '* m1 del0))
                     (gdl-rr-typ! (list '* m1 del1))
                     (dk-have! (list '<= (list '* m1 del1) eps)
                       (lambda () (dk-ineq! (list '= (list '* m1 del0) eps) (list '<= (list '* m1 del1) (list '* m1 del0))
                                            (list 'IN (list '* m1 del0) 'RR) (list 'IN (list '* m1 del1) 'RR) (list 'IN eps 'RR))))
                     (gdl-go! del1)))
                 (lambda ()
                   (fact 'rr-not-le-lt 'gdlr_ del0)
                   (gdl-rr-typ! (list '* m1 del0))
                   (dk-have! (list '<= (list '* m1 del0) eps) (lambda () (dk-ineq! (list '= (list '* m1 del0) eps) (list 'IN (list '* m1 del0) 'RR) (list 'IN eps 'RR))))
                   (gdl-go! del0))))))
          ((eq? (gdl-head g) 'IN)
           (cond ((dk-asm? g) (ass))
                 ((equal? g (list 'IN 'gdla_ (list 'PTS gdl-sub)))
                  (subst (list '== (list 'PTS gdl-sub) 'gdls_)) (ass))
                 (#t (subst (list '== (list 'PTS gdl-sub) 'gdls_))
                     (subst (list '== (list 'PTS gdl-nfm) 'CC))
                     (ass))))
          (#t (ass))))))))
;; the definition
(mac 'IS-DIFF-ON)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((eq? (gdl-head g) 'FORSOME)
       (ew gdl-phi)
       (dk-conj-close!
        (lambda ()
          (if (not (eq? (gdl-head (dk-goal)) 'FORALL))
              (ass)
              (let* ((x (dk-di-var!)) (d (list '- x 'gdla_)) (px (gdl-ift x))
                     (fd (list '- (list 'gdlf_ x) '(gdlf_ gdla_))))
                (gdl-qd-pt! x)
                (inst+ gdl-qd-pt x)
                (dk-lam-b!)
                (gdl-cc-typ! d) (gdl-cc-typ! fd)
                (fact 'cc-nf-sub (list 'gdlf_ x) '(gdlf_ gdla_))
                (fact 'cc-nf-sub x 'gdla_)
                (subst (list '== (list '(ADD CC-NORMED-FIELD) (list 'gdlf_ x) '((NEG CC-NORMED-FIELD) (gdlf_ gdla_))) fd))
                (subst (list '== (list '(ADD CC-NORMED-FIELD) x '((NEG CC-NORMED-FIELD) gdla_)) d))
                (gdl-and! (list 'IN px 'CC) (list 'IN d 'CC))
                (fact 'cc-nf-mul-apply px d)
                (subst (list '== (list '(MUL CC-NORMED-FIELD) px d) (list '* px d)))
                (use-em (list '= x 'gdla_)
                  (lambda ()
                    (dk-if-branch! #t px #f (lambda ()
                        (subst (list '= x 'gdla_))
                        (crs))))
                  (lambda ()
                    (gdl-qd-nz! x)
                    (dk-if-branch! #f px #f (lambda ()
                        (let ((ex (list '* fd (list '* d (list 'recip d)))))
                          (dk-have! (list '= (list '* (gdl-dq x) d) ex) (lambda () (crs)))
                          (subst (list '= (list '* (gdl-dq x) d) ex))
                          (subst (list '= (list '* d (list 'recip d)) 1))
                          (crs)))))))))))
      (#t (ass))))))
(qed 'cc-diff-on-local-quadratic)

;;; ======================================================================
;;; (6) COROLLARY 3.7: ON A CONVEX OPEN SET, int_<a,c> = int_<a,b> + int_<b,c>
;;; ======================================================================
(define (gou-holo-setup!)
  (dk-cite! 'holomorphic-on-open 'u 'f)
  (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'holomorphic-on-in-fun 'u 'f)
  (dk-cite! 'holomorphic-on-continuous 'u 'f))
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (IS-CONVEX u) (IMPLIES (HOLOMORPHIC-ON u f)
   (FORALL goua_ (IMPLIES (IN goua_ u) (FORALL goub_ (IMPLIES (IN goub_ u) (FORALL gouc_ (IMPLIES (IN gouc_ u)
     (= (SEG-INT f goua_ gouc_) (+ (SEG-INT f goua_ goub_) (SEG-INT f goub_ gouc_)))))))))))))))
(dk-peel!)
(gou-holo-setup!)
(for-each (lambda (v) (fact 'subset-mem-fwd 'u 'CC v)) '(goua_ goub_ gouc_))
(dk-cite! 'conv3-in-convex 'u 'goua_ 'goub_ 'gouc_)
(define gou-cs-z (dk-cite! 'goursat-triangle 'u 'f 'goua_ 'goub_ 'gouc_))
(for-each (lambda (pq) (dk-cite! 'seg-trace-in-convex 'u (car pq) (cadr pq)) (dk-cite! 'seg-int-in-cc 'u 'f (car pq) (cadr pq)))
          '((goua_ goub_) (goub_ gouc_) (gouc_ goua_) (goua_ gouc_)))
(let* ((sab '(SEG-INT f goua_ goub_)) (sbc '(SEG-INT f goub_ gouc_)) (sca '(SEG-INT f gouc_ goua_))
       (sac '(SEG-INT f goua_ gouc_))
       (s3 (list '+ (list '+ sab sbc) sca))
       (rv (dk-cite! 'seg-int-reverse-at 'u 'f 'goua_ 'gouc_)))
  (dk-cite! 'tri-int-unfold 'f 'goua_ 'goub_ 'gouc_)
  (gou-cc! s3)
  (dk-have! (list '= s3 0) (lambda () (subst (list '= s3 '(TRI-INT f goua_ goub_ gouc_))) (ass)))
  (dk-have! (list '= (list '+ sab sbc) (list '- s3 sca)) (lambda () (crs)))
  (subst (list '= (list '+ sab sbc) (list '- s3 sca)))
  (subst (list '= s3 0))
  (subst rv)
  (crs))
(qed 'cauchy-convex-segments)

;;; ======================================================================
;;; (7) PROPOSITION 3.8: ON A CONVEX OPEN SET A HOLOMORPHIC f HAS A PRIMITIVE,
;;; g(b) = int_<a0, b> f
