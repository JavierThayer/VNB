;;; the segment integral is additive in the integrand
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'g (gou-imps (append gou-H gou-Hg)
  (list 'FORALL 'gouh_ (list 'IMPLIES '(IN gouh_ (FUN u CC))
    (list 'IMPLIES '(FORALL gouz_ (IMPLIES (IN gouz_ u) (== (gouh_ gouz_) (+ (f gouz_) (g gouz_)))))
      (gou-all-in '(goua_ goub_) 'CC (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u)
        '(= (SEG-INT gouh_ goua_ goub_) (+ (SEG-INT f goua_ goub_) (SEG-INT g goua_ goub_))))))))))))))
(dk-peel!)
(let* ((sd (gou-seg-std! 'goua_ 'goub_)) (sg (car sd)) (dsg (cadr sd)) (w '(- goub_ goua_)))
  (for-each (lambda (fn) (subst (dk-cite! 'seg-int-bridge fn 'goua_ 'goub_ 'goua_ w))) '(gouh_ f g))
  (dk-cite! 'line-int-in-cc 'u 'f sg dsg 0 1)
  (dk-cite! 'line-int-in-cc 'u 'g sg dsg 0 1)
  (subst (dk-apply! (dk-cite! 'line-int-sum 'u 'f 'g sg dsg 0 1) 'gouh_))
  (crs))
(qed 'seg-int-sum)

;;; (54) for SEG-INT: |f| <= M on the segment  =>  |int_<a,b> f| <= |b - a| M
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_) 'CC
  (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u)
    (list 'FORALL 'goum_ (list 'IMPLIES '(IN goum_ RR)
      (list 'IMPLIES (gou-bnd (gou-segtr 'goua_ 'goub_))
        '(<= (magnitude (SEG-INT f goua_ goub_)) (* (magnitude (- goub_ goua_)) goum_))))))))))
(dk-peel!)
(let ((r (gou-ts-side! 'goua_ 'goub_)))
  (ass))
(qed 'seg-int-abs-bound)

;;; the integral of a constant c along <a, b> is c (b - a)
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN gou-nfm 'u)
  (gou-all-in '(goup_ gouw_) 'CC
   (list 'FORALL 'goug_ (list 'IMPLIES '(IN goug_ (FUN u CC))
     (list 'IMPLIES '(FORALL gouz_ (IMPLIES (IN gouz_ u) (== (goug_ gouz_) (+ goup_ (* 0 (- gouz_ gouw_))))))
       (gou-all-in '(goua_ goub_) 'CC (list 'IMPLIES (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u)
          '(= (SEG-INT goug_ goua_ goub_) (* goup_ (- goub_ goua_)))))))))))))
(dk-peel!)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'cc-is-normed-field)
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'u)
(gou-cc! 0)
(define (gou-sc-val z)
  (list '+ (list '* 'goup_ z) (list '* (list '* 0 (list '* (list '- z 'gouw_) (list '- z 'gouw_))) '(recip 2))))
(define gou-sc-F (list 'VNB-LAMBDA 'gouvz_ 'u (gou-sc-val 'gouvz_)))
(gou-cc! '(recip 2))
(dk-have! (list 'IN gou-sc-F '(FUN u CC))
  (lambda ()
    (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd 'u 'CC z) (gou-cc! (gou-sc-val z)) (ass))))))
(dk-have! (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== (list gou-sc-F 'gouz_) (gou-sc-val 'gouz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'subset-mem-fwd 'u 'CC z)
      (gou-cc! (gou-sc-val z))
      (if (not (dk-lam-b!)) (qrfl)))))
(dk-split-all! (list (dk-cite! 'affine-primitive-on 'u 'goup_ 0 'gouw_ gou-sc-F)))
(define gou-sc-dd (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'IS-DIFF-ON))) "F' = g"))
(define gou-sc-vh (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'goug_))) "g's values"))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ u)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u gou-sc-F 'hbz_ '(goug_ hbz_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-apply! gou-sc-dd z)
      (subst (dk-apply! gou-sc-vh z))
      (ass))))
(gou-in-unit! 0 '())
(gou-in-unit! 1 '())
(fact 'subset-mem-fwd (gou-segtr 'goua_ 'goub_) 'u 'goua_)
(let* ((sd (gou-seg-std! 'goua_ 'goub_)) (sg (car sd)) (dsg (cadr sd)))
  (subst (dk-cite! 'seg-int-bridge 'goug_ 'goua_ 'goub_ 'goua_ '(- goub_ goua_)))
  (subst (dk-cite! 'line-int-of-derivative 'u gou-sc-F 'goug_ sg dsg 0 1))
  (dk-have! (list '= (list sg 1) 'goub_)
    (lambda () (if (not (dk-lam-b!)) (let ((g (dk-goal))) (gou-cc! (cadr g)) (crs)))))
  (dk-have! (list '= (list sg 0) 'goua_)
    (lambda () (if (not (dk-lam-b!)) (let ((g (dk-goal))) (gou-cc! (cadr g)) (crs)))))
  (subst (list '= (list sg 1) 'goub_))
  (subst (list '= (list sg 0) 'goua_))
  (dk-cite! 'seg-trace-intro 'goua_ 'goub_ 1)
  (dk-have! '(= (+ goua_ (* 1 (- goub_ goua_))) goub_) (lambda () (crs)))
  (dk-cite! 'in-transport-eq '(+ goua_ (* 1 (- goub_ goua_))) 'goub_ (gou-segtr 'goua_ 'goub_))
  (dk-cite! 'seg-trace-intro 'goua_ 'goub_ 0)
  (dk-have! '(= (+ goua_ (* 0 (- goub_ goua_))) goua_) (lambda () (crs)))
  (dk-cite! 'in-transport-eq '(+ goua_ (* 0 (- goub_ goua_))) 'goua_ (gou-segtr 'goua_ 'goub_))
  (for-each (lambda (v) (fact 'subset-mem-fwd (gou-segtr 'goua_ 'goub_) 'u v) (fact 'fun-apply-type-c gou-sc-F 'u 'CC v))
            '(goua_ goub_))
  (subst (dk-apply! (dk-ctx-form (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== (list gou-sc-F 'gouz_) (gou-sc-val 'gouz_))))) 'goua_))
  (subst (dk-apply! (dk-ctx-form (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== (list gou-sc-F 'gouz_) (gou-sc-val 'gouz_))))) 'goub_))
  (dk-crs-opaque!))
(qed 'seg-int-const)

;;; |h| <= K1 |x - z| on the segment from z to x, where h(y) = f(y) - f(z) and
;;; |f(y) - f(z) - L (y - z)| <= |y - z| for |y - z| < r (the remainder bound RB at eps = 1)
(define (gou-bnd-h h z x K1 dx r rb lz)
  (list 'FORALL 'gouz_ (list 'IMPLIES (list 'IN 'gouz_ (gou-segtr z x)) (list '<= (list 'magnitude (list h 'gouz_)) (list '* K1 dx)))))
(define (gou-pr-hbound! h z x K1 dx r rb lz)
  (let* ((y (dk-di-var!))
         (tt (dk-skolem! (dk-cite! 'seg-trace-elim z x y)))
         (fy (list 'f y)) (fz (list 'f z))
         (dy (list '- y z)) (mdy (list 'magnitude dy)) (mlz (list 'magnitude lz))
         (e1 (list '- fy (list '+ fz (list '* lz dy))))
         (e2 (list '* lz dy)))
    (gou-unit! tt)
    (fact 'subset-mem-fwd (gou-segtr z x) 'u y)
    (fact 'subset-mem-fwd 'u 'CC y)
    (fact 'fun-apply-type-c 'f 'u 'CC y)
    (gou-cc! (list '- x z)) (gou-cc! dy)
    (dk-have! (list '= dy (list '* tt (list '- x z)))
      (lambda () (subst (list '= y (list '+ z (list '* tt (list '- x z))))) (crs)))
    (gou-cc! (list '* tt (list '- x z)))
    (gou-and! (list 'IN tt 'CC) (list 'IN (list '- x z) 'CC))
    (fact 'cc-magnitude-mul tt (list '- x z))
    (fact 'rr-magnitude-is-abs tt)
    (dk-cite! 'rr-abs-of-nonneg tt)
    (for-each gou-rr! (list mdy dx mlz (list 'magnitude tt) (list '* tt dx)))
    (fact 'cc-magnitude-nonneg (list '- x z))
    (dk-have! (list '= mdy (list '* tt dx))
      (lambda ()
        (subst (list '= dy (list '* tt (list '- x z))))
        (subst (list '= (list 'magnitude (list '* tt (list '- x z))) (list '* (list 'magnitude tt) dx)))
        (subst (list '= (list 'magnitude tt) (list 'abs tt)))
        (subst (list '= (list 'abs tt) tt))
        (rfl)))
    (gou-and! (list '<= tt 1) (list '<= 0 dx))
    (fact 'rr-mul-le-right tt 1 dx)
    (dk-have! (list '<= mdy dx)
      (lambda () (dk-ineq! (list 'IN mdy 'RR) (list 'IN (list '* tt dx) 'RR) (list 'IN dx 'RR)
                           (list '= mdy (list '* tt dx)) (list '<= (list '* tt dx) (list '* 1 dx)))))
    (dk-have! (list '< mdy r)
      (lambda () (dk-ineq! (list 'IN mdy 'RR) (list 'IN dx 'RR) (list 'IN r 'RR) (list '<= mdy dx) (list '< dx r))))
    (dk-apply! rb y)
    (if (not (dk-lam-b!))
        (let* ((hy (cadr (cadr (dk-goal))))
               (sum (list '+ e1 e2)))
          (gou-cc! hy) (gou-cc! e1) (gou-cc! e2) (gou-cc! sum)
          (dk-have! (list '= hy sum) (lambda () (crs)))
          (subst (list '= hy sum))
          (gou-and! (list 'IN e1 'CC) (list 'IN e2 'CC))
          (fact 'cc-magnitude-triangle e1 e2)
          (gou-and! (list 'IN lz 'CC) (list 'IN dy 'CC))
          (fact 'cc-magnitude-mul lz dy)
          (fact 'cc-magnitude-nonneg lz)
          (gou-and! (list '<= 0 mlz) (list '<= mdy dx))
          (fact 'rr-le-scale-nonneg mlz mdy dx)
          (for-each gou-rr! (list (list 'magnitude e1) (list 'magnitude e2) (list 'magnitude sum)
                                  (list '* mlz mdy) (list '* mlz dx) (list '* 1 mdy) (list '* K1 dx)))
          (dk-have! (list '= (list '* K1 dx) (list '+ (list '* mlz dx) dx)) (lambda () (crs)))
          (dk-ineq! (list 'IN (list 'magnitude sum) 'RR) (list 'IN (list 'magnitude e1) 'RR) (list 'IN (list 'magnitude e2) 'RR)
                    (list 'IN (list '* mlz mdy) 'RR) (list 'IN (list '* mlz dx) 'RR) (list 'IN mdy 'RR) (list 'IN dx 'RR)
                    (list 'IN (list '* K1 dx) 'RR)
                    (list '<= (list 'magnitude sum) (list '+ (list 'magnitude e1) (list 'magnitude e2)))
                    (list '<= (list 'magnitude e1) (list '* 1 mdy))
                    (list '= (list 'magnitude e2) (list '* mlz mdy))
                    (list '<= (list '* mlz mdy) (list '* mlz dx))
                    (list '<= mdy dx)
                    (list '= (list '* K1 dx) (list '+ (list '* mlz dx) dx)))))))

;;; PROPOSITION 3.8 (holomorphic case), for a given base point a0 in u
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (IS-CONVEX u) (IMPLIES (HOLOMORPHIC-ON u f)
   (FORALL gouo_ (IMPLIES (IN gouo_ u)
     (FORSOME goug_ (AND (IN goug_ (FUN u CC)) (AND (HOLOMORPHIC-ON u goug_)
       (FORALL gouz_ (IMPLIES (IN gouz_ u) (IS-DIFF-ON CC-NORMED-FIELD u goug_ gouz_ (f gouz_)))))))))))))))
(dk-peel!)
(gou-holo-setup!)
(dk-cite! 'holomorphic-on-open-cc-ms 'u 'f)
(fact 'cc-is-normed-field)
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'u)
(fact 'subset-mem-fwd 'u 'CC 'gouo_)
(define gou-pr-G (list 'VNB-LAMBDA 'gpb_ 'u '(SEG-INT f gouo_ gpb_)))
(define (gou-pr-seg! b)   ;; b in u: b in CC, the segment from a0 to b in u, its integral in CC
  (fact 'subset-mem-fwd 'u 'CC b)
  (dk-cite! 'seg-trace-in-convex 'u 'gouo_ b)
  (dk-cite! 'seg-int-in-cc 'u 'f 'gouo_ b))
(dk-have! (list 'IN gou-pr-G '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let ((b (dk-di-var!))) (gou-pr-seg! b) (ass))))))
(define gou-pr-val
  (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== (list gou-pr-G 'gouz_) '(SEG-INT f gouo_ gouz_)))))
(dk-have! gou-pr-val
  (lambda () (let ((b (dk-di-var!))) (gou-pr-seg! b) (if (not (dk-lam-b!)) (qrfl)))))
;; the derivative at every point
(define gou-pr-d
  (list 'FORALL 'gpz_ (list 'IMPLIES '(IN gpz_ u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u gou-pr-G 'gpz_ '(f gpz_)))))
(dk-have! gou-pr-d
  (lambda ()
    (let* ((z (dk-di-var!))
           (fz (list 'f z))
           (lz (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) z)))
           (dz (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f z lz))
           (K1 (list '+ (list 'magnitude lz) 1))
           (k  (list 'VNB-LAMBDA 'gpv_ 'u (list '+ fz (list '* 0 (list '- 'gpv_ z)))))
           (kn (list 'VNB-LAMBDA 'gpv_ 'u (list '+ (list '- fz) (list '* 0 (list '- 'gpv_ z)))))
           (h  (list 'VNB-LAMBDA 'gpv_ 'u (list '+ '(f gpv_) (list '+ (list '- fz) (list '* 0 (list '- 'gpv_ z)))))))
      (gou-pr-seg! z)
      (fact 'fun-apply-type-c 'f 'u 'CC z)
      (fact 'cc-nf-carr)
      (dk-have! (list 'IN lz 'CC)
        (lambda () (mac-h 'is-diff-on (dk-ctx-form dz)) (dk-split-all!) (subst '(= CC (CARR CC-NORMED-FIELD))) (ass)))
      (gou-rr! 1)
      (dk-have! '(< 0 1) (lambda () (arith)))
      (dk-have! '(POS-RR 1) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith))))))
      (let* ((r (dk-skolem! (dk-apply! (dk-cite! 'caratheodory-remainder-small 'u 'f z lz) 1)))
             (rb (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm r))) "the remainder bound")))
        (fact 'rr-pos-rr-in-rr r)
        (gou-rr! K1)
        (fact 'cc-magnitude-nonneg lz)
        (dk-have! (list '<= 0 K1) (lambda () (dk-ineq! (list 'IN (list 'magnitude lz) 'RR) (list '<= 0 (list 'magnitude lz)))))
        ;; k, -k, h = f - f(z) as functions on u, holomorphic
        (gou-cc! (list '- fz))
        (for-each
         (lambda (lam)
           (dk-have! (list 'IN lam '(FUN u CC))
             (lambda ()
               (dk-lam-type!
                 (lambda ()
                   (let ((y (dk-di-var!)))
                     (fact 'subset-mem-fwd 'u 'CC y)
                     (fact 'fun-apply-type-c 'f 'u 'CC y)
                     (gou-cc! (subst-free 'gpv_ y (list-ref lam 3)))
                     (ass)))))))
         (list k kn h))
        (let ((vals (map (lambda (lam)
                           (let ((cl (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u)
                                       (list '== (list lam 'gouz_) (subst-free 'gpv_ 'gouz_ (list-ref lam 3)))))))
                             (dk-have! cl
                               (lambda ()
                                 (let ((y (dk-di-var!)))
                                   (fact 'subset-mem-fwd 'u 'CC y)
                                   (fact 'fun-apply-type-c 'f 'u 'CC y)
                                   (gou-cc! (subst-free 'gpv_ y (list-ref lam 3)))
                                   (if (not (dk-lam-b!)) (qrfl)))))
                             cl))
                         (list k kn h))))
          (dk-cite! 'affine-holomorphic 'u fz 0 z k)
          (dk-cite! 'affine-holomorphic 'u (list '- fz) 0 z kn)
          (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== (list h 'hbx_) (list '+ '(f hbx_) (list kn 'hbx_)))))
            (lambda ()
              (let ((y (dk-di-var!)))
                (fact 'subset-mem-fwd 'u 'CC y)
                (fact 'fun-apply-type-c 'f 'u 'CC y)
                (gou-cc! (subst-free 'gpv_ y (list-ref kn 3)))
                (gou-cc! (subst-free 'gpv_ y (list-ref h 3)))
                (if (not (dk-lam-b!)) (qrfl)))))
          (dk-cite! 'holomorphic-sum 'u 'f kn h)
          (dk-cite! 'holomorphic-on-continuous 'u h)
          (dk-cite! 'holomorphic-on-continuous 'u k)
          (dk-have! (list 'FORALL 'gouz_ (list 'IMPLIES '(IN gouz_ u) (list '== '(f gouz_) (list '+ (list h 'gouz_) (list k 'gouz_)))))
            (lambda ()
              (let* ((y (dk-di-var!)) (fy (list 'f y)))
                (fact 'subset-mem-fwd 'u 'CC y)
                (fact 'fun-apply-type-c 'f 'u 'CC y)
                (gou-cc! (subst-free 'gpv_ y (list-ref k 3)))
                (gou-cc! (subst-free 'gpv_ y (list-ref h 3)))
                (dk-lam-b!)
                (let ((rhs (caddr (dk-goal))))
                  (dk-have! (list '= rhs fy) (lambda () (crs)))
                  (subst (list '= rhs fy))
                  (qrfl)))))
          ;; the local quadratic estimate
          (let ((qb (list 'FORALL 'gdlx_ (list 'IMPLIES '(IN gdlx_ u)
                      (list 'IMPLIES (list '< (list 'magnitude (list '- 'gdlx_ z)) r)
                        (list '<= (list 'magnitude (list '- (list '- (list gou-pr-G 'gdlx_) (list gou-pr-G z)) (list '* (list '- 'gdlx_ z) fz)))
                              (list '* K1 (list '* (list 'magnitude (list '- 'gdlx_ z)) (list 'magnitude (list '- 'gdlx_ z))))))))))
            (dk-have! qb
              (lambda ()
                (let* ((ls (dk-peel!))
                       (x (cadr (find-first (lambda (fm) (and (gou-op? fm 'IN 3) (eq? (caddr fm) 'u))) ls)))
                       (dx (list 'magnitude (list '- x z)))
                       (szx (list 'SEG-INT 'f z x)))
                  (gou-pr-seg! x)
                  (dk-cite! 'seg-trace-in-convex 'u z x)
                  (dk-cite! 'seg-int-in-cc 'u 'f z x)
                  (subst (dk-apply! (dk-ctx-form gou-pr-val) x))
                  (subst (dk-apply! (dk-ctx-form gou-pr-val) z))
                  (subst (dk-cite! 'cauchy-convex-segments 'u 'f 'gouo_ z x))
                  (subst (dk-cite! 'seg-int-sum 'u h k 'f z x))
                  (subst (dk-cite! 'seg-int-const 'u fz z k z x))
                  (dk-cite! 'seg-int-in-cc 'u h z x)
                  (dk-cite! 'seg-int-in-cc 'u k z x)
                  (let* ((shx (list 'SEG-INT h z x))
                         (lhs (cadr (cadr (dk-goal)))))
                    (gou-cc! lhs)
                    (dk-have! (list '= lhs shx) (lambda () (crs)))
                    (subst (list '= lhs shx))
                    ;; |h| <= K1 |x - z| on the segment
                    (gou-rr! dx)
                    (gou-rr! (list '* K1 dx))
                    (dk-have! (gou-bnd-h h z x K1 dx r rb lz)
                      (lambda () (gou-pr-hbound! h z x K1 dx r rb lz)))
                    (dk-apply! (dk-cite! 'seg-int-abs-bound 'u h z x) (list '* K1 dx))
                    (let ((rhs (caddr (dk-goal))))
                      (dk-have! (list '= rhs (list '* dx (list '* K1 dx))) (lambda () (crs)))
                      (subst (list '= rhs (list '* dx (list '* K1 dx))))
                      (ass))))))
            (dk-cite! 'cc-diff-on-local-quadratic 'u gou-pr-G z fz K1 r)
            (ass)))))))
(ew gou-pr-G)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((dk-head-is? g 'HOLOMORPHIC-ON)
             (mac 'HOLOMORPHIC-ON)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-head-is? (dk-goal) 'FORALL))
                     (ass)
                     (let ((a (dk-di-var!)))
                       (dk-apply! (dk-ctx-form gou-pr-d) a)
                       (ew (list 'f a))
                       (ass))))))
            (#t (error "cauchy-convex-primitive: unexpected leaf" (expression->string g)))))))
(qed 'cauchy-convex-primitive)

