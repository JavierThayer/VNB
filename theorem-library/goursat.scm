(define gou-J0 '(magnitude (TRI-INT f goua_ goub_ gouc_)))
(dk-cite! 'tri-int-in-cc 'u 'f 'goua_ 'goub_ 'gouc_)
(gou-rr! gou-J0)
(fact 'cc-magnitude-nonneg '(TRI-INT f goua_ goub_ gouc_))
(define gou-DD gou-D)
(define gou-K (list '* 24 gou-DD))
(define gou-E (list '* (list '* 6 gou-DD) gou-K))
(for-each (lambda (pq) (gou-cc! (list '- (car pq) (cadr pq))) (fact 'cc-magnitude-nonneg (list '- (car pq) (cadr pq))))
          '((goua_ gouc_) (goub_ gouc_)))
(gou-rr! gou-DD)
(dk-have! (list '<= 0 gou-DD) (lambda () (dk-ineq! '(IN (magnitude (- goua_ gouc_)) RR) '(IN (magnitude (- goub_ gouc_)) RR)
                                                 '(<= 0 (magnitude (- goua_ gouc_))) '(<= 0 (magnitude (- goub_ gouc_))))))
(gou-rr! gou-K) (gou-rr! gou-E)
(dk-have! (list '<= 0 gou-K) (lambda () (dk-ineq! (list 'IN gou-DD 'RR) (list '<= 0 gou-DD))))
(gou-and! (list 'IN (list '* 6 gou-DD) 'RR) (list 'IN gou-K 'RR))
(dk-have! (list '<= 0 (list '* 6 gou-DD)) (lambda () (dk-ineq! (list 'IN gou-DD 'RR) (list '<= 0 gou-DD))))
(gou-and! (list '<= 0 (list '* 6 gou-DD)) (list '<= 0 gou-K))
(fact 'rr-leq-mul-nonneg (list '* 6 gou-DD) gou-K)
;; the identity 4^n ((D (6 R)) (e (K R))) = (E e) (4^n (R R)), with the power quantified
(define gou-gt-id
  (gou-all-in '(gnp_ gnr_ gnd_ gne_) 'RR
    (list '= (list '* 'gnp_ (list '* (list '* 'gnd_ '(* 6 gnr_)) (list '* 'gne_ (list '* (list '* 24 'gnd_) 'gnr_))))
             (list '* (list '* (list '* (list '* 6 'gnd_) (list '* 24 'gnd_)) 'gne_) (list '* 'gnp_ '(* gnr_ gnr_))))))
(dk-have! gou-gt-id (lambda () (dk-peel!) (crs)))
;; for every d > 0, |J0| <= 0 + d
(define gou-gt-all-d
  (list 'FORALL 'gnd_ (list 'IMPLIES '(POS-RR gnd_) (list '<= gou-J0 '(+ 0 gnd_)))))
(dk-have! gou-gt-all-d
  (lambda ()
    (let* ((d (cadr (car (filter (dk-head? 'POS-RR) (dk-peel!)))))
           (e1 (list '+ gou-E 1))
           (q (list 'recip e1))
           (eps (list '* d q)))
      (fact 'rr-pos-rr-in-rr d)
      (fact 'rr-lt-of-pos-rr d)
      (gou-rr! e1)
      (dk-have! (list '< 0 e1) (lambda () (dk-ineq! (list 'IN gou-E 'RR) (list '<= 0 gou-E))))
      (gou-rr! q)
      (fact 'rr-recip-pos e1)
      (fact 'rr-recip-inverse e1)
      (gou-rr! eps)
      (fact 'rr-mul-pos d q)
      (fact 'rr-lt-implies-le 0 eps)
      (fact 'rr-pos-ne-zero eps)
      (fact 'neq-sym eps 0)
      (dk-have! (list 'POS-RR eps) (lambda () (mac 'pos-rr) (from-context!)))
      ;; E eps <= d
      (gou-rr! (list '* gou-E eps))
      (dk-have! (list '= d (list '+ (list '* gou-E eps) eps))
        (lambda ()
          (let ((ex (list '* d (list '* e1 q))))
            (dk-have! (list '= (list '+ (list '* gou-E eps) eps) ex) (lambda () (dk-crs-opaque!)))
            (subst (list '= (list '+ (list '* gou-E eps) eps) ex))
            (subst (list '= (list '* e1 q) 1))
            (crs))))
      ;; r from the differentiability at a*, n from r
      (let* ((r (dk-skolem! (dk-apply! (dk-cite! 'caratheodory-remainder-small 'u 'f gou-as gou-L) eps)))
             (rb (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm r) (dk-contains? fm eps))) "the remainder bound"))
             (n (dk-skolem! (dk-cite! 'small-dyadic gou-K r)))
             (Rn (gou-R n))
             (ex3 (dk-apply! gou-gt-all n))
             (x (dk-skolem! ex3 #f))
             (y (dk-skolem! (dk-pick (lambda (fm) (and (gou-op? fm 'FORSOME 3) (dk-contains? fm x))) "y") #f))
             (z (dk-skolem! (dk-pick (lambda (fm) (and (gou-op? fm 'FORSOME 3) (dk-contains? fm y))) "z")))
             (rho (gou-rho x y z))
             (A (gou-V x)) (B (gou-V y)) (C (gou-V z))
             (c3 (list 'CONV3 A B C))
             (M (list '* eps (list '* gou-K Rn)))
             (mm (lambda (e) (list 'magnitude e)))
             (S (list '+ (list '+ (mm (list '- B A)) (mm (list '- C B))) (mm (list '- A C))))
             (Jn (list 'magnitude (list 'TRI-INT 'f A B C)))
             (JR (list 'magnitude (list 'TRI-INT gou-Rf A B C))))
        (fact 'rr-pos-rr-in-rr r)
        (gou-R-facts! n)
        (for-each (lambda (p) (dk-cite! 'bary-in-conv3 'goua_ 'goub_ 'gouc_ p)) (list x y z))
        (for-each gou-cc! (list A B C))
        (dk-cite! 'conv3-sub-hull 'goua_ 'goub_ 'gouc_ A B C)
        (fact 'subset-trans c3 gou-C3 'u)
        (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 A B C)))
        (for-each (lambda (pq) (fact 'subset-trans (gou-segtr (car pq) (cadr pq)) c3 'u))
                  (list (list A B) (list B C) (list C A)))
        ;; the abstract sides are at most rho
        (for-each (lambda (pq) (gou-cc! (list '- (car pq) (cadr pq))) (gou-rr! (mm (list '- (car pq) (cadr pq))))
                               (fact 'cc-magnitude-nonneg (list '- (car pq) (cadr pq))))
                  (list (list y x) (list z y) (list x z) (list x x) (list z x)))
        (dk-cite! 'cc-magnitude-sub-sym z x)
        (dk-have! (list '= (list '- x x) 0) (lambda () (crs)))
        (fact 'cc-magnitude-zero)
        (dk-have! (list '= (mm (list '- x x)) 0) (lambda () (subst (list '= (list '- x x) 0)) (ass)))
        (gou-rr! rho)
        (let ((pre (list (list 'IN (mm (list '- y x)) 'RR) (list 'IN (mm (list '- z y)) 'RR) (list 'IN (mm (list '- x z)) 'RR)
                         (list 'IN (mm (list '- z x)) 'RR) (list 'IN (mm (list '- x x)) 'RR)
                         (list '<= 0 (mm (list '- y x))) (list '<= 0 (mm (list '- z y))) (list '<= 0 (mm (list '- x z)))
                         (list '= (mm (list '- z x)) (mm (list '- x z))) (list '= (mm (list '- x x)) 0))))
          (for-each (lambda (d0) (dk-have! (list '<= (mm d0) rho) (lambda () (apply dk-ineq! pre))))
                    (list (list '- y x) (list '- z y) (list '- x z) (list '- z x) (list '- x x))))
        ;; the remainder is small on each side of the actual triangle
        (gou-rr! Rn)
        (gou-rr! (list '* gou-K Rn))
        (gou-rr! M)
        (dk-have! (list '<= 0 (list '* gou-K Rn))
          (lambda () (gou-and! (list 'IN gou-K 'RR) (list 'IN Rn 'RR))
                     (dk-have! (list '<= 0 Rn) (lambda () (dk-ineq! (list 'IN Rn 'RR) (list '< 0 Rn))))
                     (gou-and! (list '<= 0 gou-K) (list '<= 0 Rn))
                     (fact 'rr-leq-mul-nonneg gou-K Rn)
                     (ass)))
        (gou-and! (list 'IN eps 'RR) (list 'IN (list '* gou-K Rn) 'RR))
        (gou-and! (list '<= 0 eps) (list '<= 0 (list '* gou-K Rn)))
        (fact 'rr-leq-mul-nonneg eps (list '* gou-K Rn))
        (for-each
         (lambda (side)
           (let* ((p (car side)) (qq (cadr side)) (gvp (gou-V p)) (gvq (gou-V qq)) (tr (gou-segtr gvp gvq)))
             (dk-have! (list 'FORALL 'gouz_ (list 'IMPLIES (list 'IN 'gouz_ tr)
                         (list '<= (list 'magnitude (list gou-Rf 'gouz_)) M)))
               (lambda ()
                 (let* ((zz (dk-di-var!)) (fz (list 'f zz)) (dz (list '- zz gou-as)))
                   (fact 'subset-mem-fwd tr 'u zz)
                   (fact 'subset-mem-fwd 'u 'CC zz)
                   (fact 'fun-apply-type-c 'f 'u 'CC zz)
                   (dk-apply! (dk-cite! 'bary-side-near 'goua_ 'goub_ 'gouc_ p qq x gou-gt-w rho Rn) zz)
                   (gou-cc! dz)
                   (gou-rr! (mm dz))
                   (dk-have! (list '< (mm dz) r)
                     (lambda () (dk-ineq! (list 'IN (mm dz) 'RR) (list 'IN (list '* gou-K Rn) 'RR) (list 'IN gou-DD 'RR)
                                          (list 'IN Rn 'RR) (list 'IN r 'RR)
                                          (list '<= (mm dz) (list '* (list '* 24 gou-DD) Rn))
                                          (list '< (list '* gou-K Rn) r))))
                   (dk-apply! rb zz)
                   (dk-lam-b!)
                   (let* ((e1x (list '+ fz (gou-naff zz)))
                          (e2x (list '- fz (gou-aff zz))))
                     (gou-cc! e1x) (gou-cc! e2x)
                     (dk-have! (list '= e1x e2x) (lambda () (crs)))
                     (subst (list '= e1x e2x))
                     (gou-rr! (mm e2x))
                     (gou-and! (list '<= 0 eps) (list '<= (mm dz) (list '* gou-K Rn)))
                     (dk-have! (list '<= (mm dz) (list '* gou-K Rn))
                       (lambda () (dk-ineq! (list 'IN (mm dz) 'RR) (list 'IN gou-DD 'RR) (list 'IN Rn 'RR)
                                            (list '<= (mm dz) (list '* (list '* 24 gou-DD) Rn)))))
                     (fact 'rr-le-scale-nonneg eps (mm dz) (list '* gou-K Rn))
                     (gou-rr! (list '* eps (mm dz)))
                     (dk-ineq! (list 'IN (mm e2x) 'RR) (list 'IN (list '* eps (mm dz)) 'RR) (list 'IN M 'RR)
                               (list '<= (mm e2x) (list '* eps (mm dz)))
                               (list '<= (list '* eps (mm dz)) M))))))))
         (list (list x y) (list y z) (list z x)))
        ;; the estimate on triangle n
        (dk-cite! 'tri-int-in-cc 'u gou-Rf A B C)
        (dk-cite! 'tri-int-in-cc 'u gou-g A B C)
        (dk-cite! 'tri-int-in-cc 'u 'f A B C)
        (let* ((bd (dk-apply! (dk-cite! 'tri-int-abs-bound-sides 'u gou-Rf A B C) M))
               (se (dk-cite! 'tri-int-sum 'u gou-Rf gou-g 'f A B C))
               (az (dk-cite! 'tri-int-affine-zero 'u gou-fa gou-L gou-as gou-g A B C))
               (P4 (list 'power 4 n))
               (xprod (list '* (list '* gou-DD (list '* 6 Rn)) M))
               (trr (list 'TRI-INT gou-Rf A B C))
               (sides (list (list y x) (list z y) (list x z)))
               (dsum (list '+ (list '+ (list '* gou-DD (mm (list '- y x))) (list '* gou-DD (mm (list '- z y))))
                           (list '* gou-DD (mm (list '- x z))))))
          (gou-rr! Jn) (gou-rr! JR) (gou-rr! S)
          (dk-have! (list '= Jn JR)
            (lambda ()
              (subst se)
              (subst az)
              (dk-have! (list '= (list '+ trr 0) trr) (lambda () (crs)))
              (subst (list '= (list '+ trr 0) trr))
              (rfl)))
          ;; the actual perimeter is at most D rho <= D 6 R
          (dk-cite! 'bary-lip 'goua_ 'goub_ 'gouc_ y x)
          (dk-cite! 'bary-lip 'goua_ 'goub_ 'gouc_ z y)
          (dk-cite! 'bary-lip 'goua_ 'goub_ 'gouc_ x z)
          (for-each (lambda (pq) (gou-rr! (list '* gou-DD (mm (list '- (car pq) (cadr pq)))))
                                 (gou-rr! (mm (list '- (gou-V (car pq)) (gou-V (cadr pq))))))
                    sides)
          (gou-rr! (list '* gou-DD rho))
          (gou-rr! (list '* 6 Rn))
          (gou-rr! (list '* gou-DD (list '* 6 Rn)))
          (dk-have! (list '= (list '* gou-DD rho) dsum) (lambda () (crs)))
          (gou-and! (list '<= 0 gou-DD) (list '<= rho (list '* 6 Rn)))
          (fact 'rr-le-scale-nonneg gou-DD rho (list '* 6 Rn))
          (dk-have! (list '<= S (list '* gou-DD (list '* 6 Rn)))
            (lambda ()
              (apply dk-ineq!
                (append
                  (map (lambda (pq) (list 'IN (mm (list '- (gou-V (car pq)) (gou-V (cadr pq)))) 'RR)) sides)
                  (map (lambda (pq) (list 'IN (list '* gou-DD (mm (list '- (car pq) (cadr pq)))) 'RR)) sides)
                  (map (lambda (pq) (list '<= (mm (list '- (gou-V (car pq)) (gou-V (cadr pq))))
                                          (list '* gou-DD (mm (list '- (car pq) (cadr pq)))))) sides)
                  (list (list 'IN (list '* gou-DD rho) 'RR) (list 'IN (list '* gou-DD (list '* 6 Rn)) 'RR)
                        (list '= (list '* gou-DD rho) dsum)
                        (list '<= (list '* gou-DD rho) (list '* gou-DD (list '* 6 Rn))))))))
          (gou-and! (list '<= S (list '* gou-DD (list '* 6 Rn))) (list '<= 0 M))
          (dk-have! (list '<= 0 M) (lambda () (ass)))
          (fact 'rr-mul-le-right S (list '* gou-DD (list '* 6 Rn)) M)
          (gou-rr! (list '* S M))
          (gou-rr! xprod)
          (dk-have! (list '<= Jn xprod)
            (lambda () (dk-ineq! (list 'IN Jn 'RR) (list 'IN JR 'RR) (list 'IN (list '* S M) 'RR) (list 'IN xprod 'RR)
                                 (list '= Jn JR) bd (list '<= (list '* S M) xprod))))
          ;; times 4^n
          (gou-rr! 4)
          (dk-have! '(< 0 4) (lambda () (dk-ineq!)))
          (fact 'rr-power-pos 4 n)
          (gou-rr! P4)
          (dk-have! (list '<= 0 P4) (lambda () (dk-ineq! (list 'IN P4 'RR) (list '< 0 P4))))
          (gou-and! (list '<= 0 P4) (list '<= Jn xprod))
          (fact 'rr-le-scale-nonneg P4 Jn xprod)
          (gou-rr! (list '* P4 Jn))
          (gou-rr! (list '* P4 xprod))
          (gou-rr! (list '* gou-E eps))
          (dk-have! (list '= (list '* P4 xprod) (list '* gou-E eps))
            (lambda ()
              (subst (dk-apply! (dk-ctx-form gou-gt-id) P4 Rn gou-DD eps))
              (subst (dk-cite! 'four-power-halving n))
              (dk-have! '(FORALL gnx_ (IMPLIES (IN gnx_ RR) (= (* gnx_ 1) gnx_))) (lambda () (dk-peel!) (crs)))
              (subst (dk-apply! (dk-ctx-form '(FORALL gnx_ (IMPLIES (IN gnx_ RR) (= (* gnx_ 1) gnx_)))) (list '* gou-E eps)))
              (rfl)))
          (dk-ineq! (list 'IN gou-J0 'RR) (list 'IN (list '* P4 Jn) 'RR) (list 'IN (list '* P4 xprod) 'RR)
                    (list 'IN (list '* gou-E eps) 'RR) (list 'IN eps 'RR) (list 'IN d 'RR)
                    (list '<= gou-J0 (list '* P4 Jn))
                    (list '<= (list '* P4 Jn) (list '* P4 xprod))
                    (list '= (list '* P4 xprod) (list '* gou-E eps))
                    (list '= d (list '+ (list '* gou-E eps) eps))
                    (list '<= 0 eps)))))))
(gou-rr! 0)
(dk-cite! 'rr-le-of-le-add-all-pos gou-J0 0)
(dk-have! (list '= gou-J0 0) (lambda () (dk-ineq! (list 'IN gou-J0 'RR) (list '<= gou-J0 0) (list '<= 0 gou-J0))))
(define gou-gt-iff (dk-cite! 'cc-magnitude-zero-iff '(TRI-INT f goua_ goub_ gouc_)))
