;;; goursat.scm -- CAUCHY-GOURSAT FOR A TRIANGLE AND CAUCHY ON A CONVEX SET
;;; (complex-analysis.pdf ch. 3, s. 3.2: Lemma 3.4, Lemma 3.5, Prop 3.6, Cor 3.7,
;;; Prop 3.8, Cor 3.9, all for f holomorphic on the whole open set).  Batch 30, 2026-09-25.
;;;
;;; The objects are the user's decided definitions (docs/goursat-definitions-2026-09-25.md),
;;; installed in structure-library/segments-triangles.scm: SEG-PATH, SEG-DERIV, SEG-INT,
;;; TRI-INT, CONV3, IS-CONVEX, CC-MID.  The segment lemmas of batch 29-A
;;; (theorem-library/line-int-reparam.scm) are stated with segment-is-road's lambdas
;;; SEG(z0, w) = (s |-> z0 + s w, s |-> w) on [0, 1] (binder psx_); the bridge between the
;;; two spellings is `seg-path-bridge' / `seg-int-bridge' below.
;;;
;;; (0) unfolds and bridges; CONV3 and IS-CONVEX: conv3-member-iff, conv3-is-convex,
;;;     conv3-in-convex, conv3-sub-triangle, seg-trace-in-conv3, seg-trace-in-convex
;;; (1) Lemma 3.4          seg-int-split-at (with seg-int-degenerate, seg-int-reverse-at)
;;; (2) Lemma 3.5          tri-int-subdivision
;;; (3) the estimate       tri-int-abs-bound (-sides), tri-int-sum, tri-int-affine-zero
;;; (4) the common point   goursat-nest: a recursive choice (dc-on-nn-pred) of sub-triangles
;;;     on the STANDARD triangle, mapped by V(xi) = re(xi) a + im(xi) b + (1-re-im) c;
;;;     the first-vertex sequence telescopes (cc-telescoping-limit-bound) and its limit
;;;     stays in the standard triangle (std-limit), so V of it lies in CONV3(a, b, c)
;;; (5) Prop 3.6           goursat-triangle
;;; (6) Cor 3.7            cauchy-convex-segments
;;; (7) Prop 3.8           cauchy-convex-primitive (via cc-diff-on-local-quadratic)
;;; (8) Cor 3.9            cauchy-convex-closed
;;;
;;; NOTHING asserted, no definition beyond segments-triangles.scm.  Helper prefix gou-;
;;; binders gou*_, gn*_, gc*_, gp*_, gdl*_ (none used elsewhere in the tree).
;;; LOAD WINDOW: lo = theorem-library/line-int-reparam (segment-int-split, -reverse,
;;; -abs-bound; slot after line-int-laws, 3457) and theorem-library/goursat-bricks
;;; (quarter-step, four-power-halving, caratheodory-remainder-small,
;;; cc-telescoping-limit-bound, nn-succ-le-power-two; slot after line-int-fundamental,
;;; 3442); also cc-power-series-deriv (cc-diff-on-quadratic, used as a model only),
;;; dc-on-nn, diff-on-laws.  hi: none.  The definitions file loads after
;;; structure-library/path-integral.

;;; ======================================================================
;;; local helpers
;;; ======================================================================
(define (gou-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (gou-hd t) (and (pair? t) (car t)))
(define (gou-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))

(define (gou-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((gou-op? t '* 3) (gou-rr! (cadr t)) (gou-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((gou-op? t '+ 3) (gou-rr! (cadr t)) (gou-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((gou-op? t '- 3) (gou-rr! (cadr t)) (gou-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((gou-op? t '- 2) (gou-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((gou-op? t 'magnitude 2) (gou-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((gou-op? t 'real-part 2) (gou-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((gou-op? t 'abs 2) (gou-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((gou-op? t 'power 3) (gou-rr! (cadr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((gou-op? t 'recip 2)
           (gou-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (dk-have! (list 'NOT (list '= (cadr t) 0)) (lambda () (arith)))))
           (gou-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          ((gou-op? t 'imag-part 2) (gou-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          (#t (dk-real! t) typ))))

(define (gou-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((or (number? t) (dk-asm? (list 'IN t 'RR))
               (gou-op? t 'magnitude 2) (gou-op? t 'real-part 2) (gou-op? t 'imag-part 2))
           (gou-rr! t) (fact 'rr-subset-cc t) typ)
          ((gou-op? t '- 3) (gou-cc! (cadr t)) (gou-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((gou-op? t '- 2) (gou-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((gou-op? t '+ 3) (gou-cc! (cadr t)) (gou-cc! (caddr t))
           (gou-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((gou-op? t '* 3) (gou-cc! (cadr t)) (gou-cc! (caddr t))
           (gou-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((gou-op? t 'CC-MID 3)
           (let ((v (list '* (list '+ (cadr t) (caddr t)) '(recip 2))))
             (gou-cc! v)
             (dk-have! typ (lambda () (subst (dk-cite! 'cc-mid-unfold (cadr t) (caddr t))) (ass)))
             typ))
          ((gou-op? t 'recip 2) (gou-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (dk-have! (list 'NOT (list '= (cadr t) 0)) (lambda () (arith))))
           (gou-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "gou-cc!: cannot type" (expression->string t))))))

;;; the standing hypotheses of the line-integral laws (line-int-exists, verbatim)
(define gou-H
  '((SUBSET u CC)
    (IN f (FUN u CC))
    (FORALL rgy_ (IMPLIES (IN rgy_ u)
      (IS-CONTINUOUS-AT (SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) u)
                        (NF-METRIC-SPACE CC-NORMED-FIELD) f rgy_)))))
(define (gou-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (gou-imps (cdr hyps) body))))
(define (gou-all-in vars cls body)       ; forall v in cls. ... body
  (if (null? vars) body
      (list 'FORALL (car vars) (list 'IMPLIES (list 'IN (car vars) cls) (gou-all-in (cdr vars) cls body)))))
(define (gou-under-H body)
  (list 'FORALL 'u (list 'FORALL 'f (gou-imps gou-H body))))

;;; segment-is-road's spelling of the segment and its derivative
(define (gou-seg p w) (list 'VNB-LAMBDA 'psx_ '(CCINT 0 1) (list '+ p (list '* 'psx_ w))))
(define (gou-dseg w) (list 'VNB-LAMBDA 'psx_ '(CCINT 0 1) w))
(define (gou-segtr a b) (list 'TRACE (list 'SEG-PATH a b) 0 1))

;;; ======================================================================
;;; (0) THE UNFOLD THEOREMS AND THE BRIDGE TO segment-is-road's SPELLING
;;; ======================================================================

(sp (make-wff '(FORALL f (FORALL goua_ (FORALL goub_
  (== (SEG-INT f goua_ goub_) (LINE-INT f (SEG-PATH goua_ goub_) (SEG-DERIV goua_ goub_) 0 1)))))))
(dk-peel!)
(mac 'SEG-INT)
(qrfl)
(qed 'seg-int-unfold)

(sp (make-wff '(FORALL f (FORALL goua_ (FORALL goub_ (FORALL gouc_
  (== (TRI-INT f goua_ goub_ gouc_)
      (+ (+ (SEG-INT f goua_ goub_) (SEG-INT f goub_ gouc_)) (SEG-INT f gouc_ goua_)))))))))
(dk-peel!)
(mac 'TRI-INT)
(qrfl)
(qed 'tri-int-unfold)

(sp (make-wff '(FORALL goux_ (FORALL gouy_ (== (CC-MID goux_ gouy_) (* (+ goux_ gouy_) (recip 2)))))))
(dk-peel!)
(mac 'CC-MID)
(qrfl)
(qed 'cc-mid-unfold)

;;; SEG-PATH(a, b) is segment-is-road's lambda at z0 = p, w when a = p and b - a = w.
(sp (make-wff '(FORALL goua_ (FORALL goub_ (FORALL goup_ (FORALL gouw_
  (IMPLIES (= goua_ goup_) (IMPLIES (= (- goub_ goua_) gouw_)
    (== (SEG-PATH goua_ goub_) (VNB-LAMBDA psx_ (CCINT 0 1) (+ goup_ (* psx_ gouw_))))))))))))
(dk-peel!)
(mac 'SEG-PATH)
(subst '(= (- goub_ goua_) gouw_))
(subst '(= goua_ goup_))
(qrfl)
(qed 'seg-path-bridge)

(sp (make-wff '(FORALL goua_ (FORALL goub_ (FORALL gouw_
  (IMPLIES (= (- goub_ goua_) gouw_)
    (== (SEG-DERIV goua_ goub_) (VNB-LAMBDA psx_ (CCINT 0 1) gouw_))))))))
(dk-peel!)
(mac 'SEG-DERIV)
(subst '(= (- goub_ goua_) gouw_))
(qrfl)
(qed 'seg-deriv-bridge)

(sp (make-wff '(FORALL f (FORALL goua_ (FORALL goub_ (FORALL goup_ (FORALL gouw_
  (IMPLIES (= goua_ goup_) (IMPLIES (= (- goub_ goua_) gouw_)
    (== (SEG-INT f goua_ goub_)
        (LINE-INT f (VNB-LAMBDA psx_ (CCINT 0 1) (+ goup_ (* psx_ gouw_)))
                    (VNB-LAMBDA psx_ (CCINT 0 1) gouw_) 0 1)))))))))))
(dk-peel!)
(mac 'SEG-INT)
(define gou-b1 (dk-cite! 'seg-path-bridge 'goua_ 'goub_ 'goup_ 'gouw_))
(define gou-b2 (dk-cite! 'seg-deriv-bridge 'goua_ 'goub_ 'gouw_))
(subst gou-b1)
(subst gou-b2)
(qrfl)
(qed 'seg-int-bridge)

(sp (make-wff '(FORALL goua_ (FORALL goub_ (FORALL goup_ (FORALL gouw_
  (IMPLIES (= goua_ goup_) (IMPLIES (= (- goub_ goua_) gouw_)
    (== (TRACE (SEG-PATH goua_ goub_) 0 1)
        (TRACE (VNB-LAMBDA psx_ (CCINT 0 1) (+ goup_ (* psx_ gouw_))) 0 1))))))))))
(dk-peel!)
(subst (dk-cite! 'seg-path-bridge 'goua_ 'goub_ 'goup_ 'gouw_))
(qrfl)
(qed 'seg-trace-bridge)

;;; In a proof: for A, B typed in CC, land the bridges at p = A, w = B - A and the
;;; road facts of SEG(A, B - A).  Returns (list SEG dSEG) in segment-is-road's spelling.
(define (gou-seg-facts! a b)
  (let* ((w (list '- b a)))
    (gou-cc! w)
    (dk-have! (list '= a a) (lambda () (rfl)))
    (dk-have! (list '= w w) (lambda () (rfl)))
    (dk-cite! 'seg-path-bridge a b a w)
    (dk-cite! 'seg-deriv-bridge a b w)
    (let ((r (dk-cite! 'segment-is-road a w)))
      (fact 'is-road-is-path (list-ref r 1) (list-ref r 2) 0 1)
      (fact 'is-path-in-fun (list-ref r 1) 0 1)
      (fact 'is-road-dgam-in-fun (list-ref r 1) (list-ref r 2) 0 1)
      (list (list-ref r 1) (list-ref r 2)))))

(sp (make-wff (gou-all-in '(goua_ goub_) 'CC
  '(IS-ROAD (SEG-PATH goua_ goub_) (SEG-DERIV goua_ goub_) 0 1))))
(dk-peel!)
(gou-seg-facts! 'goua_ 'goub_)
(subst (dk-cite! 'seg-path-bridge 'goua_ 'goub_ 'goua_ '(- goub_ goua_)))
(subst (dk-cite! 'seg-deriv-bridge 'goua_ 'goub_ '(- goub_ goua_)))
(ass)
(qed 'seg-path-is-road)

;;; membership transported along an equation, for a set term that contains the point
;;; (a `subst' in the goal would rewrite the point inside the set term too)
(sp (make-wff '(FORALL goux_ (FORALL gouy_ (FORALL gous_
  (IMPLIES (IN goux_ gous_) (IMPLIES (= goux_ gouy_) (IN gouy_ gous_))))))))
(dk-peel!)
(subst '(= gouy_ goux_))
(ass)
(qed 'in-transport-eq)

;;; the value of the segment at a parameter
(sp (make-wff (gou-all-in '(goua_ goub_) 'CC
  '(FORALL gout_ (IMPLIES (IN gout_ (CCINT 0 1))
     (= ((SEG-PATH goua_ goub_) gout_) (+ goua_ (* gout_ (- goub_ goua_)))))))))
(dk-peel!)
(fact 'ccint-elt-in-rr 0 1 'gout_)
(gou-cc! '(+ goua_ (* gout_ (- goub_ goua_))))
(mac 'SEG-PATH)
(if (not (dk-lam-b!)) (rfl))
(qed 'seg-path-apply)

;;; a point of the segment is a + t (b - a) with t in [0, 1], and conversely
(sp (make-wff (gou-all-in '(goua_ goub_) 'CC
  '(FORALL gout_ (IMPLIES (IN gout_ (CCINT 0 1))
     (IN (+ goua_ (* gout_ (- goub_ goua_))) (TRACE (SEG-PATH goua_ goub_) 0 1)))))))
(dk-peel!)
(fact 'ccint-elt-in-rr 0 1 'gout_)
(gou-cc! '(+ goua_ (* gout_ (- goub_ goua_))))
(define gou-sti-v (dk-cite! 'seg-path-apply 'goua_ 'goub_ 'gout_))
(subst (dk-cite! 'trace-unfold '(SEG-PATH goua_ goub_) 0 1))
(mac 'image-membership-iff)
(ew 'gout_)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (begin (subst gou-sti-v) (rfl)))))
(qed 'seg-trace-intro)

(sp (make-wff (gou-all-in '(goua_ goub_) 'CC
  '(FORALL gouz_ (IMPLIES (IN gouz_ (TRACE (SEG-PATH goua_ goub_) 0 1))
     (FORSOME gout_ (AND (IN gout_ (CCINT 0 1)) (= gouz_ (+ goua_ (* gout_ (- goub_ goua_)))))))))))
(dk-peel!)
(define gou-ste-mem (dk-pick (lambda (f) (and (gou-op? f 'IN 3) (gou-op? (caddr f) 'TRACE 4))) "z in the trace"))
(define gou-ste-z (cadr gou-ste-mem))
(define gou-ste-img
  (dk-have! (list 'IN gou-ste-z '(IMAGE (SEG-PATH goua_ goub_) (CCINT 0 1)))
    (lambda ()
      (dk-cite! 'trace-unfold '(SEG-PATH goua_ goub_) 0 1)
      (subst '(= (IMAGE (SEG-PATH goua_ goub_) (CCINT 0 1)) (TRACE (SEG-PATH goua_ goub_) 0 1)))
      (ass))))
(mac-h 'image-membership-iff (list 'IN gou-ste-z '(IMAGE (SEG-PATH goua_ goub_) (CCINT 0 1))))
(define gou-ste-t (dk-skolem! (dk-pick (lambda (f) (and (gou-op? f 'FORSOME 3) (dk-contains? f gou-ste-z)))
                                       "the image existential")))
(define gou-ste-v (dk-cite! 'seg-path-apply 'goua_ 'goub_ gou-ste-t))
(ew gou-ste-t)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (begin (subst (list '= gou-ste-z (list '(SEG-PATH goua_ goub_) gou-ste-t)))
               (ass)))))
(qed 'seg-trace-elim)

;;; ----------------------------------------------------------------------
;;; CONV3 and IS-CONVEX
;;; ----------------------------------------------------------------------
(define gou-c3-body
  '(FORSOME goul_ (AND (IN goul_ (CCINT 0 1))
    (FORSOME goum_ (AND (IN goum_ (CCINT 0 1))
    (FORSOME goun_ (AND (IN goun_ (CCINT 0 1))
      (AND (= (+ (+ goul_ goum_) goun_) 1)
           (= gouz_ (+ (+ (* goul_ goua_) (* goum_ goub_)) (* goun_ gouc_)))))))))))
(sp (make-wff (list 'FORALL 'goua_ (list 'FORALL 'goub_ (list 'FORALL 'gouc_ (list 'FORALL 'gouz_
  (list 'IFF '(IN gouz_ (CONV3 goua_ goub_ gouc_))
             (list 'AND '(IN gouz_ CC) gou-c3-body))))))))
(dk-peel!)
(mac 'CONV3)
(for-each
 (lambda (k)
   (dk-focus! k)
   (if (eq? (gou-hd (dk-goal)) 'AND)
       (begin (sep-me (dk-pick (lambda (f) (and (gou-op? f 'IN 3) (eq? (gou-hd (caddr f)) 'SEP)))
                               "the SEP membership"))
              (dk-split-all!)
              (from-context!))
       (begin (dk-split-all!)
              (in-sep! from-context!))))
 (dk-opened (lambda () (di))))
(qed 'conv3-member-iff)

;;; exhibit the witnesses WS for a FORSOME chain, closing the rest from context
(define (gou-exhibit! ws)
  (ew (car ws))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((eq? (gou-hd g) 'FORSOME) (gou-exhibit! (cdr ws)))
              ((and (gou-op? g '= 3) (equal? (cadr g) (caddr g))) (rfl))
              (#t (from-context!)))))))

(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC (gou-all-in '(goul_ goum_ goun_) '(CCINT 0 1)
  '(FORALL gouz_ (IMPLIES (= (+ (+ goul_ goum_) goun_) 1)
     (IMPLIES (= gouz_ (+ (+ (* goul_ goua_) (* goum_ goub_)) (* goun_ gouc_)))
       (IN gouz_ (CONV3 goua_ goub_ gouc_)))))))))
(dk-peel!)
(for-each (lambda (v) (fact 'ccint-elt-in-rr 0 1 v)) '(goul_ goum_ goun_))
(gou-cc! '(+ (+ (* goul_ goua_) (* goum_ goub_)) (* goun_ gouc_)))
(mac 'conv3-member-iff)
(dk-conj-close!
  (lambda ()
    (cond ((eq? (gou-hd (dk-goal)) 'FORSOME) (gou-exhibit! '(goul_ goum_ goun_)))
          ((dk-asm? (dk-goal)) (ass))
          (#t (subst '(= gouz_ (+ (+ (* goul_ goua_) (* goum_ goub_)) (* goun_ gouc_)))) (ass)))))
(qed 'conv3-intro)

(sp (make-wff '(FORALL u (IMPLIES (IS-CONVEX u)
  (FORALL goux_ (IMPLIES (IN goux_ u) (FORALL gouy_ (IMPLIES (IN gouy_ u)
    (FORALL gout_ (IMPLIES (IN gout_ (CCINT 0 1))
      (IN (+ goux_ (* gout_ (- gouy_ goux_))) u)))))))))))
(dk-peel!)
(mac-h 'is-convex '(IS-CONVEX u))
(dk-apply! (dk-pick (dk-head? 'FORALL) "the convexity universal") 'goux_ 'gouy_ 'gout_)
(ass)
(qed 'is-convex-unfold)

;;; open (IN z (CONV3 a b c)) in context: return the coefficients (l m n), with
;;; (= (+ (+ l m) n) 1), (= z <combination>), l, m, n in [0,1] and in RR landed.
(define (gou-conv3-open! mem)
  (let* ((new (dk-landed* (lambda () (mac-h 'conv3-member-iff mem))))
         (parts (dk-split-all! new))
         (ex1 (find-first (dk-head? 'FORSOME) (append parts new)))
         (l (dk-skolem! ex1))
         (m (dk-skolem! (dk-pick (lambda (f) (and (gou-op? f 'FORSOME 3) (dk-contains? f l)))
                                 "the second coefficient")))
         (n (dk-skolem! (dk-pick (lambda (f) (and (gou-op? f 'FORSOME 3) (dk-contains? f m)))
                                 "the third coefficient"))))
    (for-each (lambda (v) (gou-unit! v)) (list l m n))
    (list l m n)))

;;; v in [0,1] in context: land v in RR, 0 <= v, v <= 1 (the membership survives)
(define (gou-unit! v)
  (let ((mem (list 'IN v '(CCINT 0 1))))
    (fact 'ccint-elt-in-rr 0 1 v)
    (let ((cj (list 'AND (list '<= 0 v) (list '<= v 1))))
      (if (not (and (dk-asm? (list '<= 0 v)) (dk-asm? (list '<= v 1))))
          (begin
            (dk-have! cj (lambda () (mac-h 'ccint-membership mem) (dk-split-all!)
                                    (dk-conj-close! (lambda () (ass)))))
            (dk-split! cj))))))

;;; land (IN v (CCINT 0 1)) from the named premises (formulas in context, typings included)
(define (gou-in-unit! v prems)
  (gou-rr! v)
  (dk-have! (list 'IN v '(CCINT 0 1))
    (lambda ()
      (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems)))))))

;;; 0 <= a, 0 <= b in context (typed)  ==>  0 <= a * b
(define (gou-nonneg-prod! a b)
  (let ((f (list '<= 0 (list '* a b))))
    (gou-rr! (list '* a b))
    (if (not (dk-asm? f))
        (begin
          (gou-and! (list 'IN a 'RR) (list 'IN b 'RR))
          (gou-and! (list '<= 0 a) (list '<= 0 b))
          (fact 'rr-leq-mul-nonneg a b)))
    f))

(define (gou-comb l m n a b c)
  (list '+ (list '+ (list '* l a) (list '* m b)) (list '* n c)))

;;; the hull is convex
(define gou-C3 '(CONV3 goua_ goub_ gouc_))
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC (list 'IS-CONVEX gou-C3))))
(dk-peel!)
(mac 'IS-CONVEX)
(dk-peel!)
(let* ((pt (cadr (dk-goal)))
       (x  (cadr pt))
       (tt (cadr (caddr pt)))
       (y  (cadr (caddr (caddr pt))))
       (c1 (gou-conv3-open! (list 'IN x gou-C3)))
       (c2 (gou-conv3-open! (list 'IN y gou-C3)))
       (s  (list '- 1 tt))
       (mk (lambda (u v) (list '+ (list '* s u) (list '* tt v))))
       (L (mk (car c1) (car c2)))
       (M (mk (cadr c1) (cadr c2)))
       (N (mk (caddr c1) (caddr c2)))
       (comb1 (gou-comb (car c1) (cadr c1) (caddr c1) 'goua_ 'goub_ 'gouc_))
       (comb2 (gou-comb (car c2) (cadr c2) (caddr c2) 'goua_ 'goub_ 'gouc_))
       (comb  (gou-comb L M N 'goua_ 'goub_ 'gouc_))
       (sum1 (list '+ (list '+ (car c1) (cadr c1)) (caddr c1)))
       (sum2 (list '+ (list '+ (car c2) (cadr c2)) (caddr c2)))
       (sumN (list '+ (list '+ L M) N)))
  (gou-unit! tt)
  (gou-rr! s)
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN tt 'RR) (list '<= tt 1))))
  (for-each (lambda (u) (gou-cc! u)) (list x y comb))
  ;; the point is the combination with coefficients L, M, N
  (dk-have! (list '= pt comb)
    (lambda ()
      (subst (list '= x comb1))
      (subst (list '= y comb2))
      (crs)))
  ;; the coefficients: nonnegative, summing to 1
  (for-each (lambda (u v)
              (gou-nonneg-prod! s u) (gou-nonneg-prod! tt v)
              (gou-rr! (mk u v))
              (dk-have! (list '<= 0 (mk u v))
                (lambda () (dk-ineq! (list 'IN (list '* s u) 'RR) (list 'IN (list '* tt v) 'RR)
                                     (list '<= 0 (list '* s u)) (list '<= 0 (list '* tt v))))))
            c1 c2)
  (dk-have! (list '= sumN (list '+ (list '* s sum1) (list '* tt sum2)))
    (lambda () (crs)))
  (dk-have! (list '= sumN 1)
    (lambda ()
      (subst (list '= sumN (list '+ (list '* s sum1) (list '* tt sum2))))
      (subst (list '= sum1 1))
      (subst (list '= sum2 1))
      (crs)))
  (let ((prems (list (list 'IN L 'RR) (list 'IN M 'RR) (list 'IN N 'RR)
                     (list '<= 0 L) (list '<= 0 M) (list '<= 0 N) (list '= sumN 1))))
    (for-each (lambda (v) (gou-in-unit! v prems)) (list L M N)))
  (dk-cite! 'conv3-intro 'goua_ 'goub_ 'gouc_ L M N pt)
  (ass))
(qed 'conv3-is-convex)

;;; a segment between two points of a convex set lies in it
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-CONVEX u) (gou-all-in '(goua_ goub_) 'CC
  '(IMPLIES (IN goua_ u) (IMPLIES (IN goub_ u) (SUBSET (TRACE (SEG-PATH goua_ goub_) 0 1) u))))))))
(dk-peel!)
(let* ((cv (dk-cite! 'is-convex-unfold 'u))
       (z  (subset-by-element!))
       (tt (dk-skolem! (dk-cite! 'seg-trace-elim 'goua_ 'goub_ z))))
  (subst (list '= z (list '+ 'goua_ (list '* tt '(- goub_ goua_)))))
  (dk-apply! cv 'goua_ 'goub_ tt)
  (ass))
(qed 'seg-trace-in-convex)

;;; a convex set holding the three vertices holds their hull
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-CONVEX u) (gou-all-in '(goua_ goub_ gouc_) 'CC
  '(IMPLIES (IN goua_ u) (IMPLIES (IN goub_ u) (IMPLIES (IN gouc_ u)
     (SUBSET (CONV3 goua_ goub_ gouc_) u)))))))))
(dk-peel!)
(define gou-ci-cv (dk-cite! 'is-convex-unfold 'u))
(let* ((z  (subset-by-element!))
       (cs (gou-conv3-open! (list 'IN z gou-C3)))
       (l (car cs)) (m (cadr cs)) (n (caddr cs))
       (comb (gou-comb l m n 'goua_ 'goub_ 'gouc_))
       (s (list '+ l m))
       (tys (list (list 'IN l 'RR) (list 'IN m 'RR) (list 'IN n 'RR))))
  (subst (list '= z comb))
  (gou-rr! s)
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN l 'RR) (list 'IN m 'RR) (list '<= 0 l) (list '<= 0 m))))
  (use-em (list '= s 0)
    (lambda ()
      ;; l = m = 0, n = 1: the point is c
      (let ((pr (append tys (list (list '<= 0 l) (list '<= 0 m) (list '= s 0) (list '= (list '+ s n) 1)))))
        (dk-have! (list '= l 0) (lambda () (apply dk-ineq! pr)))
        (dk-have! (list '= m 0) (lambda () (apply dk-ineq! pr)))
        (dk-have! (list '= n 1) (lambda () (apply dk-ineq! pr)))
        (gou-cc! comb)
        (dk-have! (list '= comb 'gouc_)
          (lambda () (subst (list '= l 0)) (subst (list '= m 0)) (subst (list '= n 1)) (crs)))
        (subst (list '= comb 'gouc_))
        (ass)))
    (lambda ()
      ;; s = l + m > 0: p = a + (m / s)(b - a) is on [a, b], and the point is c + s (p - c)
      (let* ((q  (list 'recip s))
             (sq (list '* s q))
             (tq (list '* m q))
             (p  (list '+ 'goua_ (list '* tq '(- goub_ goua_))))
             (r  (list '+ 'gouc_ (list '* s (list '- p 'gouc_)))))
        (fact 'neq-sym s 0)
        (gou-and! (list '<= 0 s) (list 'NOT (list '= 0 s)))
        (fact 'rr-le-ne-lt 0 s)
        (gou-and! (list 'IN s 'RR) (list 'NOT (list '= s 0)))
        (fact 'rr-recip-inverse s)
        (fact 'rr-recip-closed s)
        (fact 'rr-recip-pos s)
        (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list 'IN q 'RR) (list '< 0 q))))
        (gou-nonneg-prod! m q)
        (dk-have! (list '<= m s) (lambda () (apply dk-ineq! (append tys (list (list '<= 0 l))))))
        (gou-and! (list '<= m s) (list '<= 0 q))
        (fact 'rr-mul-le-right m s q)
        (gou-rr! sq)
        (gou-in-unit! tq (list (list 'IN tq 'RR) (list 'IN sq 'RR) (list '<= 0 tq)
                               (list '<= tq sq) (list '= sq 1)))
        (dk-apply! gou-ci-cv 'goua_ 'goub_ tq)
        (gou-in-unit! s (list (list 'IN s 'RR) (list 'IN n 'RR) (list '<= 0 s) (list '<= 0 n)
                              (list '= (list '+ s n) 1)))
        (gou-cc! p)
        (dk-apply! gou-ci-cv 'gouc_ p s)
        (dk-have! (list '= n (list '- 1 s)) (lambda () (apply dk-ineq! (append tys (list (list '= (list '+ s n) 1))))))
        (gou-cc! comb)
        (gou-cc! r)
        (dk-have! (list '= comb r)
          (lambda ()
            (let ((e1 (list '= r (list '+ (list '+ 'gouc_ (list '* s '(- goua_ gouc_)))
                                          (list '* sq (list '* m '(- goub_ goua_)))))))
              (dk-have! e1 (lambda () (dk-crs-opaque!)))
              (subst e1)
              (subst (list '= sq 1))
              (subst (list '= n (list '- 1 s)))
              (crs))))
        (subst (list '= comb r))
        (ass)))))
(qed 'conv3-in-convex)

;;; the vertices, the midpoints and the segments of the hull
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'AND (list 'IN 'goua_ gou-C3) (list 'AND (list 'IN 'goub_ gou-C3) (list 'IN 'gouc_ gou-C3))))))
(dk-peel!)
(gou-in-unit! 0 '())
(gou-in-unit! 1 '())
(dk-have! '(= (+ (+ 1 0) 0) 1) (lambda () (arith)))
(dk-have! '(= (+ (+ 0 1) 0) 1) (lambda () (arith)))
(dk-have! '(= (+ (+ 0 0) 1) 1) (lambda () (arith)))
(for-each
 (lambda (v cs)
   (let ((comb (gou-comb (car cs) (cadr cs) (caddr cs) 'goua_ 'goub_ 'gouc_)))
     (gou-cc! comb)
     (dk-have! (list '= v comb) (lambda () (crs)))
     (dk-cite! 'conv3-intro 'goua_ 'goub_ 'gouc_ (car cs) (cadr cs) (caddr cs) v)))
 '(goua_ goub_ gouc_) '((1 0 0) (0 1 0) (0 0 1)))
(dk-conj-close! (lambda () (ass)))
(qed 'conv3-vertices-in)

;;; in a proof: land (IN X CC) from (IN X (CONV3 ...)) without consuming it
(define (gou-c3-cc! x c3)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (dk-have! (list 'IN x 'CC)
        (lambda () (mac-h 'conv3-member-iff (list 'IN x c3)) (dk-split-all!) (ass)))))

(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC (gou-all-in '(goux_ gouy_) gou-C3
  (list 'SUBSET '(TRACE (SEG-PATH goux_ gouy_) 0 1) gou-C3)))))
(dk-peel!)
(gou-c3-cc! 'goux_ gou-C3)
(gou-c3-cc! 'gouy_ gou-C3)
(dk-cite! 'conv3-is-convex 'goua_ 'goub_ 'gouc_)
(dk-cite! 'seg-trace-in-convex gou-C3 'goux_ 'gouy_)
(ass)
(qed 'conv3-seg-trace)

(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC (gou-all-in '(goux_ gouy_ gouz_) gou-C3
  (list 'SUBSET '(CONV3 goux_ gouy_ gouz_) gou-C3)))))
(dk-peel!)
(gou-c3-cc! 'goux_ gou-C3)
(gou-c3-cc! 'gouy_ gou-C3)
(gou-c3-cc! 'gouz_ gou-C3)
(dk-cite! 'conv3-is-convex 'goua_ 'goub_ 'gouc_)
(dk-cite! 'conv3-in-convex gou-C3 'goux_ 'gouy_ 'gouz_)
(ass)
(qed 'conv3-sub-hull)

;;; the midpoint: CC-MID(x, y) = x + 1/2 (y - x) = y + 1/2 (x - y)
(define (gou-half!) (if (not (dk-asm? '(= (recip 2) 1/2))) (dk-have! '(= (recip 2) 1/2) (lambda () (arith)))))
(sp (make-wff (gou-all-in '(goux_ gouy_) 'CC
  '(AND (= (CC-MID goux_ gouy_) (+ goux_ (* 1/2 (- gouy_ goux_))))
        (= (CC-MID goux_ gouy_) (+ gouy_ (* 1/2 (- goux_ gouy_))))))))
(dk-peel!)
(gou-half!)
(gou-cc! '(+ goux_ (* 1/2 (- gouy_ goux_))))
(gou-cc! '(+ gouy_ (* 1/2 (- goux_ gouy_))))
(dk-conj-close!
  (lambda ()
    (subst (dk-cite! 'cc-mid-unfold 'goux_ 'gouy_))
    (subst '(= (recip 2) 1/2))
    (crs)))
(qed 'cc-mid-affine)

(sp (make-wff (gou-all-in '(goux_ gouy_) 'CC
  '(AND (IN (CC-MID goux_ gouy_) (TRACE (SEG-PATH goux_ gouy_) 0 1))
        (IN (CC-MID goux_ gouy_) (TRACE (SEG-PATH gouy_ goux_) 0 1))))))
(dk-peel!)
(dk-split! (dk-cite! 'cc-mid-affine 'goux_ 'gouy_))
(gou-in-unit! 1/2 '())
(dk-cite! 'seg-trace-intro 'goux_ 'gouy_ 1/2)
(dk-cite! 'seg-trace-intro 'gouy_ 'goux_ 1/2)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (dk-contains? g '(SEG-PATH goux_ gouy_))
          (subst '(= (CC-MID goux_ gouy_) (+ goux_ (* 1/2 (- gouy_ goux_)))))
          (subst '(= (CC-MID goux_ gouy_) (+ gouy_ (* 1/2 (- goux_ gouy_))))))
      (ass))))
(qed 'cc-mid-in-seg-trace)

(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC (gou-all-in '(goux_ gouy_) gou-C3
  (list 'IN '(CC-MID goux_ gouy_) gou-C3)))))
(dk-peel!)
(gou-c3-cc! 'goux_ gou-C3)
(gou-c3-cc! 'gouy_ gou-C3)
(dk-split! (dk-cite! 'cc-mid-in-seg-trace 'goux_ 'gouy_))
(dk-cite! 'conv3-seg-trace 'goua_ 'goub_ 'gouc_ 'goux_ 'gouy_)
(fact 'subset-mem-fwd '(TRACE (SEG-PATH goux_ gouy_) 0 1) gou-C3 '(CC-MID goux_ gouy_))
(ass)
(qed 'conv3-mid-in)

;;; the three sides lie in the hull
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_) 'CC
  (list 'AND (list 'SUBSET (gou-segtr 'goua_ 'goub_) gou-C3)
    (list 'AND (list 'SUBSET (gou-segtr 'goub_ 'gouc_) gou-C3)
               (list 'SUBSET (gou-segtr 'gouc_ 'goua_) gou-C3))))))
(dk-peel!)
