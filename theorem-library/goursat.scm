;;; an affine function z |-> p + q (z - w) on an open u is holomorphic
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN gou-nfm 'u)
  (gou-all-in '(goup_ gouq_ gouw_) 'CC
   (list 'FORALL 'goug_ (list 'IMPLIES '(IN goug_ (FUN u CC))
     (list 'IMPLIES '(FORALL gouz_ (IMPLIES (IN gouz_ u) (== (goug_ gouz_) (+ goup_ (* gouq_ (- gouz_ gouw_))))))
       '(HOLOMORPHIC-ON u goug_)))))))))
(dk-peel!)
(define gou-ah-vh (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm 'goug_))) "g's values"))
(dk-cite! 'cc-open-subset-cc 'u)
(gou-rr! 0)
(dk-have! '(<= 0 0) (lambda () (arith)))
(define gou-ah-d
  '(FORALL gouz_ (IMPLIES (IN gouz_ u) (IS-DIFF-ON CC-NORMED-FIELD u goug_ gouz_ gouq_))))
(dk-have! gou-ah-d
  (lambda ()
    (let ((a (dk-di-var!)))
      (fact 'subset-mem-fwd 'u 'CC a)
      (dk-have! (list 'FORALL 'cpdx_ (list 'IMPLIES '(IN cpdx_ u)
                  (list '<= (list 'magnitude (list '- (list '- '(goug_ cpdx_) (list 'goug_ a)) (list '* (list '- 'cpdx_ a) 'gouq_)))
                        (list '* 0 (list '* (list 'magnitude (list '- 'cpdx_ a)) (list 'magnitude (list '- 'cpdx_ a)))))))
        (lambda ()
          (let* ((x (dk-di-var!))
                 (mm (list '* (list 'magnitude (list '- x a)) (list 'magnitude (list '- x a))))
                 (e (list '- (list '- (list '+ 'goup_ (list '* 'gouq_ (list '- x 'gouw_)))
                                      (list '+ 'goup_ (list '* 'gouq_ (list '- a 'gouw_))))
                          (list '* (list '- x a) 'gouq_))))
            (fact 'subset-mem-fwd 'u 'CC x)
            (subst (dk-apply! gou-ah-vh x))
            (subst (dk-apply! gou-ah-vh a))
            (gou-cc! e)
            (dk-have! (list '= e 0) (lambda () (crs)))
            (subst (list '= e 0))
            (fact 'cc-magnitude-zero)
            (subst '(= (magnitude 0) 0))
            (gou-rr! mm)
            (dk-have! (list '= (list '* 0 mm) 0) (lambda () (crs)))
            (subst (list '= (list '* 0 mm) 0))
            (ass))))
      (fact 'cc-diff-on-quadratic 'u 'goug_ a 'gouq_ 0)
      (ass))))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (ass)
        (let ((a (dk-di-var!)))
          (dk-apply! (dk-ctx-form gou-ah-d) a)
          (ew 'gouq_)
          (ass)))))
(qed 'affine-holomorphic)

;;; for K >= 0 and r > 0 there is n with K recip(2^n) < r
(sp (make-wff '(FORALL goum_ (IMPLIES (IN goum_ RR) (IMPLIES (<= 0 goum_)
   (FORALL gour_ (IMPLIES (POS-RR gour_)
     (FORSOME goun_ (AND (IN goun_ NN) (< (* goum_ (recip (power 2 goun_))) gour_))))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'gour_)
(fact 'rr-lt-of-pos-rr 'gour_)
(define gou-sm-k1 '(+ goum_ 1))
(gou-rr! gou-sm-k1)
(dk-have! (list '< 0 gou-sm-k1) (lambda () (dk-ineq! '(IN goum_ RR) '(<= 0 goum_))))
(define gou-sm-q (list 'recip gou-sm-k1))
(gou-rr! gou-sm-q)
(fact 'rr-recip-pos gou-sm-k1)
(fact 'rr-recip-inverse gou-sm-k1)
(define gou-sm-del (list '* 'gour_ gou-sm-q))
(gou-rr! gou-sm-del)
(fact 'rr-mul-pos 'gour_ gou-sm-q)
(fact 'rr-lt-implies-le 0 gou-sm-del)
(fact 'rr-pos-ne-zero gou-sm-del)
(fact 'neq-sym gou-sm-del 0)
(dk-have! (list 'POS-RR gou-sm-del) (lambda () (mac 'pos-rr) (from-context!)))
(define gou-sm-n (dk-skolem! (dk-cite! 'nn-recip-succ-small gou-sm-del)))
(define gou-sm-n1 (list '+ gou-sm-n 1))
(fact 'nn-in-rr gou-sm-n)
(fact 'nn-zero-le gou-sm-n)
(gou-rr! gou-sm-n1)
(dk-have! (list '< 0 gou-sm-n1) (lambda () (dk-ineq! (list 'IN gou-sm-n 'RR) (list '<= 0 gou-sm-n))))
(dk-cite! 'nn-succ-le-power-two gou-sm-n)
(gou-rr! (list 'recip gou-sm-n1))
(gou-R-facts! gou-sm-n)
(define gou-sm-anti (dk-cite! 'rr-recip-antitone gou-sm-n1 (list 'power 2 gou-sm-n)))
(dk-have! (list '<= (gou-R gou-sm-n) gou-sm-del)
  (lambda () (dk-ineq! gou-sm-anti (list '< (list 'recip gou-sm-n1) gou-sm-del)
                       (list 'IN (gou-R gou-sm-n) 'RR) (list 'IN (list 'recip gou-sm-n1) 'RR) (list 'IN gou-sm-del 'RR))))
(gou-and! '(<= 0 goum_) (list '<= (gou-R gou-sm-n) gou-sm-del))
(fact 'rr-le-scale-nonneg 'goum_ (gou-R gou-sm-n) gou-sm-del)
(gou-rr! (list '* 'goum_ (gou-R gou-sm-n)))
(gou-rr! (list '* 'goum_ gou-sm-del))
(dk-have! (list '= 'gour_ (list '+ (list '* 'goum_ gou-sm-del) gou-sm-del))
  (lambda ()
    (let ((ex (list '* 'gour_ (list '* gou-sm-k1 gou-sm-q))))
      (dk-have! (list '= (list '+ (list '* 'goum_ gou-sm-del) gou-sm-del) ex) (lambda () (dk-crs-opaque!)))
      (subst (list '= (list '+ (list '* 'goum_ gou-sm-del) gou-sm-del) ex))
      (subst (list '= (list '* gou-sm-k1 gou-sm-q) 1))
      (crs))))
(ew gou-sm-n)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (dk-ineq! (list 'IN (list '* 'goum_ (gou-R gou-sm-n)) 'RR) (list 'IN (list '* 'goum_ gou-sm-del) 'RR)
                  (list 'IN gou-sm-del 'RR) '(IN gour_ RR)
                  (list '<= (list '* 'goum_ (gou-R gou-sm-n)) (list '* 'goum_ gou-sm-del))
                  (list '< 0 gou-sm-del)
                  (list '= 'gour_ (list '+ (list '* 'goum_ gou-sm-del) gou-sm-del))))))
(qed 'small-dyadic)

;;; a point of an actual side of the triangle n is near V(w)
(define gou-D '(+ (magnitude (- goua_ gouc_)) (magnitude (- goub_ gouc_))))
(sp (make-wff (gou-all-in '(goua_ goub_ gouc_ goup_ gouq_ goux_ gouw_) 'CC (gou-all-in '(gour_ goum_) 'RR
  (gou-imps (list '(<= (magnitude (- goup_ goux_)) gour_) '(<= (magnitude (- gouq_ goup_)) gour_)
                  '(<= gour_ (* 6 goum_)) '(<= (magnitude (- goux_ gouw_)) (* 12 goum_)))
    (list 'FORALL 'gouz_ (list 'IMPLIES (list 'IN 'gouz_ (list 'TRACE (list 'SEG-PATH (gou-V 'goup_) (gou-V 'gouq_)) 0 1))
      (list '<= (list 'magnitude (list '- 'gouz_ (gou-V 'gouw_))) (list '* (list '* 24 gou-D) 'goum_)))))))))
(dk-peel!)
(let* ((vp (gou-V 'goup_)) (vq (gou-V 'gouq_)) (vw (gou-V 'gouw_))
       (z 'gouz_)
       (m (lambda (e) (list 'magnitude e)))
       (d (list '- vq vp))
       (e1 (list '- vp vw))
       (pd (list '* gou-D 'goum_)))
  (for-each gou-cc! (list vp vq vw d e1))
  (let* ((tt (dk-skolem! (dk-cite! 'seg-trace-elim vp vq z)))
         (td (list '* tt d)))
    (gou-unit! tt)
    (gou-cc! td)
    (dk-have! (list '= (list '- z vw) (list '+ e1 td))
      (lambda () (subst (list '= z (list '+ vp (list '* tt d)))) (crs)))
    (subst (list '= (list '- z vw) (list '+ e1 td)))
    (gou-and! (list 'IN e1 'CC) (list 'IN td 'CC))
    (fact 'cc-magnitude-triangle e1 td)
    (gou-and! (list 'IN tt 'CC) (list 'IN d 'CC))
    (fact 'cc-magnitude-mul tt d)
    (fact 'rr-magnitude-is-abs tt)
    (dk-cite! 'rr-abs-of-nonneg tt)
    (for-each gou-rr! (list (m (list '+ e1 td)) (m e1) (m td) (m d) (m tt) (list '* tt (m d)) gou-D pd))
    (dk-have! (list '= (m td) (list '* tt (m d)))
      (lambda ()
        (subst (list '= (m td) (list '* (m tt) (m d))))
        (subst (list '= (m tt) (list 'abs tt)))
        (subst (list '= (list 'abs tt) tt))
        (rfl)))
    (fact 'cc-magnitude-nonneg d)
    (gou-and! (list '<= tt 1) (list '<= 0 (m d)))
    (fact 'rr-mul-le-right tt 1 (m d))
    ;; the Lipschitz bounds, and |p - w| <= |p - x| + |x - w|
    (dk-cite! 'bary-lip 'goua_ 'goub_ 'gouc_ 'gouq_ 'goup_)
    (dk-cite! 'bary-lip 'goua_ 'goub_ 'gouc_ 'goup_ 'gouw_)
    (gou-cc! '(- goup_ goux_)) (gou-cc! '(- goux_ gouw_))
    (dk-have! '(= (- goup_ gouw_) (+ (- goup_ goux_) (- goux_ gouw_))) (lambda () (crs)))
    (gou-and! '(IN (- goup_ goux_) CC) '(IN (- goux_ gouw_) CC))
    (fact 'cc-magnitude-triangle '(- goup_ goux_) '(- goux_ gouw_))
    (for-each gou-rr! (list '(magnitude (- gouq_ goup_)) '(magnitude (- goup_ gouw_)) '(magnitude (- goup_ goux_))
                            '(magnitude (- goux_ gouw_)) '(magnitude (+ (- goup_ goux_) (- goux_ gouw_)))))
    (dk-have! '(<= (magnitude (- goup_ gouw_)) (* 18 goum_))
      (lambda ()
        (subst '(= (- goup_ gouw_) (+ (- goup_ goux_) (- goux_ gouw_))))
        (dk-ineq! '(IN (magnitude (+ (- goup_ goux_) (- goux_ gouw_))) RR) '(IN (magnitude (- goup_ goux_)) RR)
                  '(IN (magnitude (- goux_ gouw_)) RR) '(IN gour_ RR) '(IN goum_ RR)
                  '(<= (magnitude (+ (- goup_ goux_) (- goux_ gouw_))) (+ (magnitude (- goup_ goux_)) (magnitude (- goux_ gouw_))))
                  '(<= (magnitude (- goup_ goux_)) gour_) '(<= gour_ (* 6 goum_)) '(<= (magnitude (- goux_ gouw_)) (* 12 goum_)))))
    (dk-have! '(<= (magnitude (- gouq_ goup_)) (* 6 goum_))
      (lambda () (dk-ineq! '(IN (magnitude (- gouq_ goup_)) RR) '(IN gour_ RR) '(IN goum_ RR)
                           '(<= (magnitude (- gouq_ goup_)) gour_) '(<= gour_ (* 6 goum_)))))
    ;; scale by D >= 0
    (for-each (lambda (pq) (fact 'cc-magnitude-nonneg (list '- (car pq) (cadr pq))))
              '((goua_ gouc_) (goub_ gouc_)))
    (dk-have! (list '<= 0 gou-D) (lambda () (dk-ineq! '(IN (magnitude (- goua_ gouc_)) RR) '(IN (magnitude (- goub_ gouc_)) RR)
                                                     '(<= 0 (magnitude (- goua_ gouc_))) '(<= 0 (magnitude (- goub_ gouc_))))))
    (for-each (lambda (xy)
                (gou-rr! (cadr xy))
                (gou-rr! (caddr xy))
                (gou-and! (list '<= 0 gou-D) xy)
                (fact 'rr-le-scale-nonneg gou-D (cadr xy) (caddr xy))
                (gou-rr! (list '* gou-D (cadr xy)))
                (gou-rr! (list '* gou-D (caddr xy))))
              (list '(<= (magnitude (- gouq_ goup_)) (* 6 goum_)) '(<= (magnitude (- goup_ gouw_)) (* 18 goum_))))
    (dk-have! (list '= (list '* gou-D '(* 6 goum_)) (list '* 6 pd)) (lambda () (crs)))
    (dk-have! (list '= (list '* gou-D '(* 18 goum_)) (list '* 18 pd)) (lambda () (crs)))
    (let ((rhs (caddr (dk-goal))))
      (dk-have! (list '= rhs (list '* 24 pd)) (lambda () (crs)))
      (subst (list '= rhs (list '* 24 pd))))
    (dk-ineq! (list 'IN (m (list '+ e1 td)) 'RR) (list 'IN (m e1) 'RR) (list 'IN (m td) 'RR) (list 'IN (m d) 'RR)
              (list 'IN (list '* tt (m d)) 'RR) (list 'IN pd 'RR)
              (list 'IN (list '* gou-D '(magnitude (- gouq_ goup_))) 'RR) (list 'IN (list '* gou-D '(magnitude (- goup_ gouw_))) 'RR)
              (list 'IN (list '* gou-D '(* 6 goum_)) 'RR) (list 'IN (list '* gou-D '(* 18 goum_)) 'RR)
              (list '<= (m (list '+ e1 td)) (list '+ (m e1) (m td)))
              (list '= (m td) (list '* tt (m d)))
              (list '<= (list '* tt (m d)) (list '* 1 (m d)))
              (list '<= (m d) (list '* gou-D '(magnitude (- gouq_ goup_))))
              (list '<= (m e1) (list '* gou-D '(magnitude (- goup_ gouw_))))
              (list '<= (list '* gou-D '(magnitude (- gouq_ goup_))) (list '* gou-D '(* 6 goum_)))
              (list '<= (list '* gou-D '(magnitude (- goup_ gouw_))) (list '* gou-D '(* 18 goum_)))
              (list '= (list '* gou-D '(* 6 goum_)) (list '* 6 pd))
              (list '= (list '* gou-D '(* 18 goum_)) (list '* 18 pd)))))
(qed 'bary-side-near)

;;; the estimate on a triangle with the bound given on the three sides only
(define (gou-bnd tr) (list 'FORALL 'gouz_ (list 'IMPLIES (list 'IN 'gouz_ tr) '(<= (magnitude (f gouz_)) goum_))))
(sp (make-wff (gou-under-H (gou-all-in '(goua_ goub_ gouc_) 'CC
  (gou-imps (list (list 'SUBSET (gou-segtr 'goua_ 'goub_) 'u) (list 'SUBSET (gou-segtr 'goub_ 'gouc_) 'u)
                  (list 'SUBSET (gou-segtr 'gouc_ 'goua_) 'u))
    (list 'FORALL 'goum_ (list 'IMPLIES '(IN goum_ RR)
      (gou-imps (list (gou-bnd (gou-segtr 'goua_ 'goub_)) (gou-bnd (gou-segtr 'goub_ 'gouc_)) (gou-bnd (gou-segtr 'gouc_ 'goua_)))
        '(<= (magnitude (TRI-INT f goua_ goub_ gouc_))
             (* (+ (+ (magnitude (- goub_ goua_)) (magnitude (- gouc_ goub_))) (magnitude (- goua_ gouc_)))
                goum_))))))))))
(dk-peel!)
(subst (dk-cite! 'tri-int-unfold 'f 'goua_ 'goub_ 'gouc_))
(define (gou-ts-side! x y)
  (let* ((tr (gou-segtr x y))
         (w (list '- y x))
         (bd (dk-pick (lambda (fm) (and (gou-op? fm 'FORALL 3) (dk-contains? fm tr) (dk-contains? fm 'goum_)))
                      "the bound on the side"))
         (sd (gou-seg-std! x y))
         (sg (car sd))
         (li (list 'LINE-INT 'f sg (cadr sd) 0 1)))
    (dk-have! (list 'FORALL 'gouy_ (list 'IMPLIES (list 'IN 'gouy_ (list 'TRACE sg 0 1))
                '(<= (magnitude (f gouy_)) goum_)))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-have! (list 'IN z tr) (lambda () (subst (list '= tr (list 'TRACE sg 0 1))) (ass)))
          (dk-apply! bd z)
          (ass))))
    (let ((le (dk-apply! (dk-cite! 'segment-int-abs-bound 'u 'f x w) 'goum_)))
      (subst (caddr sd))
      (dk-cite! 'line-int-in-cc 'u 'f sg (cadr sd) 0 1)
      (gou-rr! (list 'magnitude li))
      (gou-rr! (list '* (list 'magnitude w) 'goum_))
      (list li le))))
(define gou-ts-1 (gou-ts-side! 'goua_ 'goub_))
(define gou-ts-2 (gou-ts-side! 'goub_ 'gouc_))
(define gou-ts-3 (gou-ts-side! 'gouc_ 'goua_))
(let* ((l1 (car gou-ts-1)) (l2 (car gou-ts-2)) (l3 (car gou-ts-3))
       (l12 (list '+ l1 l2))
       (m (lambda (t) (list 'magnitude t)))
       (rhs (caddr (dk-goal)))
       (ex (list '+ (list '+ '(* (magnitude (- goub_ goua_)) goum_) '(* (magnitude (- gouc_ goub_)) goum_))
                 '(* (magnitude (- goua_ gouc_)) goum_))))
  (gou-cc! l12)
  (gou-cc! (list '+ l12 l3))
  (gou-and! (list 'IN l12 'CC) (list 'IN l3 'CC))
  (fact 'cc-magnitude-triangle l12 l3)
  (gou-and! (list 'IN l1 'CC) (list 'IN l2 'CC))
  (fact 'cc-magnitude-triangle l1 l2)
  (gou-rr! (m l12))
  (gou-rr! (m (list '+ l12 l3)))
  (dk-have! (list '= rhs ex) (lambda () (crs)))
  (subst (list '= rhs ex))
  (dk-ineq! (list 'IN (m (list '+ l12 l3)) 'RR) (list 'IN (m l12) 'RR)
            (list 'IN (m l1) 'RR) (list 'IN (m l2) 'RR) (list 'IN (m l3) 'RR)
            '(IN (* (magnitude (- goub_ goua_)) goum_) RR) '(IN (* (magnitude (- gouc_ goub_)) goum_) RR)
            '(IN (* (magnitude (- goua_ gouc_)) goum_) RR)
            (list '<= (m (list '+ l12 l3)) (list '+ (m l12) (m l3)))
            (list '<= (m l12) (list '+ (m l1) (m l2)))
            (cadr gou-ts-1) (cadr gou-ts-2) (cadr gou-ts-3)))
(qed 'tri-int-abs-bound-sides)

;;; PROP 3.6 (holomorphic case)
