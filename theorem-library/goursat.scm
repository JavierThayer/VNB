(define gou-fa (list 'f gou-as))
(fact 'fun-apply-type-c 'f 'u 'CC gou-as)
(define (gou-aff z) (list '+ gou-fa (list '* gou-L (list '- z gou-as))))
(define (gou-naff z) (list '+ (list '- gou-fa) (list '* (list '- gou-L) (list '- z gou-as))))
(define gou-g  (list 'VNB-LAMBDA 'gov_ 'u (gou-aff 'gov_)))
(define gou-g2 (list 'VNB-LAMBDA 'gov_ 'u (gou-naff 'gov_)))
