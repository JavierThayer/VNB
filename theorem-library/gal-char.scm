(define gf0-ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CHOOSE))) (dk-peel!)))
(let* ((g (dk-goal)) (m (cadr (cadr (cadr g)))) (k (caddr (cadr g))))
  (dk-cite! 'nn-succ-closed m)
  (dk-have! (list '< 0 k) (lambda () (dk-nn!)))
  (let ((k1 (gf0-pred! k)))
    (dk-cite! 'nn-succ-closed k1)
    (let ((h (dk-rewrite-h! (list '< (list 'succ m) k) k (list 'succ k1))))
      (dk-have! (list '< m k1) (lambda () (dk-nn! h)))
      (dk-have! (list '< m (list 'succ k1)) (lambda () (dk-nn! h))))
    (dk-apply! gf0-ih k1)
    (dk-apply! gf0-ih (list 'succ k1))
