;;; gal-char.scm -- primes in Z dividing binomial coefficients, the characteristic of a field and the
;;; Frobenius map (galois-theory notes, Lemma 1.12, Proposition 1.14) (GALOIS B8, 2026-10-26).
;;; Destination: theorem-library/gal-char.scm, library algebra.  Load window: after catools-gal-b1
;;; (two-element-ideal), the binomial and choose files, and the euclidean-ring files.
;;; Load window: after gal-char-vocab (IS-PRIME-NAT, HAS-CHARACTERISTIC), binomial-proof (binomial-theorem,
;;; comb-kk-*), bt-shims, injection (CHOOSE), zz-action / rake-zz-act (ZZ-ACT laws), views (raag-*).
;;; Theorems (16, all modulo 0): euclid-lemma-euclidean-ring, zz-ring-divides-iff, prime-nat-gt-one,
;;; prime-nat-euclid, zz-divides-small, prime-nat-not-divides-factorial, prime-divides-binomial (1.12),
;;; choose-above-zero, characteristic-kills, characteristic-multiple-zero, comb-kk-closed-form,
;;; choose-diagonal, sum-collapse-first, frobenius-additive (1.14), ring-power-nilpotent-zero,
;;; frobenius-injective (1.14).  Multiplicativity and 1 |-> 1 are the tree's ring-power-mult and
;;; ring-power-of-one.
;;; Helper prefixes gh1- / gh3- / gh4- (copied from catools-gal-b1 for the IS-EUCLIDEAN-RING form), gx-, gf-.
;;; ======================================================================
(define (gh1-op? t op) (and (pair? t) (equal? (car t) (list op 's))))
(define (gh1-in! t)
  (if (not (dk-asm? (list 'IN t '(CARR s))))
      (cond ((gh1-op? t 'MUL) (gh1-in! (cadr t)) (gh1-in! (caddr t)) (dk-cite! 'ring-carrier-closed-mul 's (cadr t) (caddr t)))
            ((gh1-op? t 'ADD) (gh1-in! (cadr t)) (gh1-in! (caddr t)) (dk-cite! 'ring-add-closed 's (cadr t) (caddr t)))
            ((gh1-op? t 'NEG) (gh1-in! (cadr t)) (dk-cite! 'ring-neg-in-carr 's (cadr t)))
            (#t (dk-type! t '(CARR s))))))
(define (gh1-mul a b) (list '(MUL s) a b))
(define (gh1-add a b) (list '(ADD s) a b))
(define (gh1-neg a) (list '(NEG s) a))
(define (gh1-ring!)
  (dk-cite! 'integral-domain-is-commutative-ring 's)
  (dk-cite! 'commutative-ring-is-ring 's)
  (dk-cite! 'ring-one-in 's)
  (dk-cite! 'ring-zero-in 's))
(define (gh3-idl p a)
  (list 'SEP 'gix_ '(CARR s)
        (list 'FORSOME 'giu_ (list 'AND '(IN giu_ (CARR s))
          (list 'FORSOME 'giv_ (list 'AND '(IN giv_ (CARR s))
            (list '= 'gix_ (gh1-add (gh1-mul 'giu_ p) (gh1-mul 'giv_ a)))))))))
(define (gh3-in! x idl u v eq!)
  (gh1-in! x)
  (for-each (lambda (lv)
              (if (memq lv (dk-open-leaves))
                  (begin (dk-focus! lv)
                         (if (dk-asm? (dk-goal))
                             (ass)
                             (begin (ew u) (dk-conj-close!
                                       (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                      (begin (ew v) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq!)))))))))))))
            (dk-opened (lambda () (sep-mi)))))
(define (gh3-out! x idl)
  (sep-me (list 'IN x idl))
  (let* ((u (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the u coefficient")))
         (_ (dk-split-all!))
         (v (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the v coefficient"))))
    (dk-split-all!)
    (cons u v)))

(sp (make-wff '(FORALL s (IMPLIES (IS-EUCLIDEAN-RING s) (FORALL p (IMPLIES (IS-PRIME-ELEMENT s p)
  (FORALL a (IMPLIES (IN a (CARR s)) (FORALL b (IMPLIES (IN b (CARR s))
    (IMPLIES (DIVIDES s p ((MUL s) a b)) (OR (DIVIDES s p a) (DIVIDES s p b)))))))))))))
(dk-peel!)
(dk-cite! 'euclidean-ring-is-integral-domain 's)
(gh1-ring!)
(let ((pi (dk-cite! 'is-prime-element 's 'p)))
  (dk-have! (caddr pi) (lambda () (dk-close-if! (lambda () (dk-only! pi '(IS-PRIME-ELEMENT s p))) prop)))
  (dk-split-all! (list (caddr pi))))
(define gh4-pr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-UNIT))) "p is prime"))
(gh1-in! '((MUL s) a b))
(define gh4-c
  (let ((di_ (dk-cite! 'divides 's 'p '((MUL s) a b))))
    (dk-have! (caddr di_) (lambda () (dk-close-if! (lambda () (dk-only! di_ '(DIVIDES s p ((MUL s) a b)))) prop)))
    (dk-split-all! (list (caddr di_)))
    (let ((c (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm '((MUL s) a b)))) "the cofactor"))))
      (dk-split-all!)
      c)))
(define gh4-I (gh3-idl 'p 'a))
(dk-cite! 'two-element-ideal 's 'p 'a)
(define gh4-g (dk-skolem! (dk-cite! 'euclidean-ideal-has-generator 's gh4-I)))
(dk-split-all!)
(define gh4-gen (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'PRINCIPAL-IDEAL))) "the generator clause"))
(define (gh4-mult! x)              ; x in I: return k with x = k g
  (dk-apply! gh4-gen x)
  (let ((pm (dk-cite! 'principal-ideal-membership 's gh4-g x)))
    (dk-have! (caddr pm) (lambda () (dk-close-if! (lambda () (dk-only! pm (list 'IN x (list 'PRINCIPAL-IDEAL 's gh4-g)))) prop)))
    (dk-split-all! (list (caddr pm)))
    (let ((k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x) (dk-contains? fm gh4-g))) "the multiplier"))))
      (dk-split-all!)
      k)))
(dk-have! (list 'IN 'p gh4-I) (lambda () (gh3-in! 'p gh4-I '(ONE s) '(ZERO s) (lambda () (crs)))))
(dk-have! (list 'IN 'a gh4-I) (lambda () (gh3-in! 'a gh4-I '(ZERO s) '(ONE s) (lambda () (crs)))))
(define gh4-k (gh4-mult! 'p))
(define gh4-m (gh4-mult! 'a))
(define gh4-uv (gh3-out! gh4-g gh4-I))
(dk-apply! gh4-pr gh4-k gh4-g)
(define (gh4-divides! x kk eq!)    ; close (DIVIDES s p x) with x = kk p
  (gh1-in! kk)
  (let ((di_ (dk-cite! 'divides 's 'p x)))
    (dk-have! (caddr di_)
      (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew kk) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq!))))))))))
    (dk-close-if! (lambda () (dk-only! di_ (caddr di_))) prop)))
(use-em (list 'IS-UNIT 's gh4-k)
  (lambda ()
    ;; k is a unit: g = z p, so p divides a = m g
    (let ((ui (dk-cite! 'is-unit 's gh4-k)))
      (dk-have! (caddr ui) (lambda () (dk-close-if! (lambda () (dk-only! ui (list 'IS-UNIT 's gh4-k))) prop)))
      (dk-split-all! (list (caddr ui))))
    (let* ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gh4-k) (dk-contains? fm '(ONE s)))) "the inverse of k")))
           (_ (dk-split-all!))
           (k gh4-k) (g gh4-g) (m gh4-m)
           (mz (gh1-mul m z)))
      (dk-have! (list 'DIVIDES 's 'p 'a)
        (lambda ()
          (gh4-divides! 'a mz
            (lambda ()
              (subst (list '= 'a (gh1-mul m g)))
              (subst (list '= 'p (gh1-mul k g)))
              (dk-have! (list '= (gh1-mul mz (gh1-mul k g)) (gh1-mul (gh1-mul m g) (gh1-mul k z))) (lambda () (crs)))
              (subst (list '= (gh1-mul mz (gh1-mul k g)) (gh1-mul (gh1-mul m g) (gh1-mul k z))))
              (subst (list '= (gh1-mul k z) '(ONE s)))
              (crs)))))
      (prop)))
  (lambda ()
    ;; g is a unit: 1 is in I, so p divides b
    (dk-have! (list 'IS-UNIT 's gh4-g) (lambda () (dk-only! (list 'OR (list 'IS-UNIT 's gh4-k) (list 'IS-UNIT 's gh4-g)) (list 'NOT (list 'IS-UNIT 's gh4-k))) (prop)))
    (let ((ui (dk-cite! 'is-unit 's gh4-g)))
      (dk-have! (caddr ui) (lambda () (dk-close-if! (lambda () (dk-only! ui (list 'IS-UNIT 's gh4-g))) prop)))
      (dk-split-all! (list (caddr ui))))
    (let* ((w (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gh4-g) (dk-contains? fm '(ONE s)))) "the inverse of g")))
           (_ (dk-split-all!))
           (g gh4-g) (u (car gh4-uv)) (v (cdr gh4-uv)) (c gh4-c)
           (kp (gh1-add (gh1-mul (gh1-mul u w) 'b) (gh1-mul (gh1-mul v w) c)))
           (x1 (gh1-add (gh1-mul (gh1-mul u w) (gh1-mul 'b 'p)) (gh1-mul (gh1-mul v w) (gh1-mul c 'p))))
           (x2 (gh1-add (gh1-mul (gh1-mul u w) (gh1-mul 'b 'p)) (gh1-mul (gh1-mul v w) (gh1-mul 'a 'b))))
           (gu (gh1-add (gh1-mul u 'p) (gh1-mul v 'a))))
      (dk-have! (list 'DIVIDES 's 'p 'b)
        (lambda ()
          (gh4-divides! 'b kp
            (lambda ()
              (dk-have! (list '= (gh1-mul kp 'p) x1) (lambda () (crs)))
              (subst (list '= (gh1-mul kp 'p) x1))
              (subst (list '= (gh1-mul c 'p) (gh1-mul 'a 'b)))
              (dk-have! (list '= x2 (gh1-mul (gh1-mul w 'b) gu)) (lambda () (crs)))
              (subst (list '= x2 (gh1-mul (gh1-mul w 'b) gu)))
              (subst (list '= gu g))
              (dk-have! (list '= (gh1-mul (gh1-mul w 'b) g) (gh1-mul 'b (gh1-mul g w))) (lambda () (crs)))
              (subst (list '= (gh1-mul (gh1-mul w 'b) g) (gh1-mul 'b (gh1-mul g w))))
              (subst (list '= (gh1-mul g w) '(ONE s)))
              (crs)))))
      (prop))))
(qed 'euclid-lemma-euclidean-ring)
(topic! 'euclid-lemma-euclidean-ring 'algebra)

;;; ====================================================================================================
;;; Prime naturals: divisibility in Z, and p | C(p, i) for 0 < i < p (galois-theory notes, 1.12).
;;; ====================================================================================================
(define (gc-case! p pos neg)
  (cond ((dk-asm? (list 'NOT p)) (neg))
        ((dk-asm? p) (pos))
        (#t (use-em p pos neg))))
(define (gx-open! name args hyp)       ; HYP = (NAME . ARGS) in context: land its definiens, split it
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (gx-close! name args rhs!)     ; close the goal (NAME . ARGS) by proving its definiens with RHS!
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (gx-ex-rhs! w eq!)             ; a definiens  A1 and ... and exists v (v in C and EQ)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew w)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq!)))))
              (#t (error "gx-ex-rhs!: unexpected conjunct" (expression->string (dk-goal)))))))))
(define (gx-skolem!)                   ; skolemize the one FORSOME in context and split it
  (let ((w (dk-skolem! (dk-pick (lambda (fm) (dk-head-is? fm 'FORSOME)) "the witness"))))
    (dk-split-all!)
    w))
(define (gx-zzr!)
  (if (not (dk-asm? '(== (CARR ZZ-RING) ZZ))) (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))))
(define (gx-in-zzr! t)                 ; t in ZZ in context  =>  t in CARR(ZZ-RING)
  (gx-zzr!)
  (if (not (dk-asm? (list 'IN t '(CARR ZZ-RING))))
      (dk-have! (list 'IN t '(CARR ZZ-RING)) (lambda () (subst '(= (CARR ZZ-RING) ZZ)) (ass)))))
(define (gx-not! claim prover)         ; the goal is CLAIM = (NOT P), or FALSITY with P in context
  (if (equal? (dk-goal) claim)
      (prover)
      (begin (dk-have! claim prover)
             (dk-close-if! (lambda () (dk-only! claim (cadr claim))) prop))))
(define (gx-rr! . ts) (for-each (lambda (t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-cite! 'zz-in-rr t))) ts))
(define (gx-zz! . ts) (for-each (lambda (t) (if (not (dk-asm? (list 'IN t 'ZZ))) (dk-cite! 'nn-subset-zz t))) ts))

;; G1: divisibility in the ring Z is divisibility of integers
(sp (make-wff '(FORALL p (IMPLIES (IN p ZZ) (FORALL x (IMPLIES (IN x ZZ)
  (IFF (DIVIDES ZZ-RING p x) (ZZ-DIVIDES p x))))))))
(dk-peel!)
(gx-zzr!)
(gx-rr! 'p 'x)
(dk-iff! (lambda (g) (dk-head-is? g 'ZZ-DIVIDES))
  (lambda ()
    (gx-open! 'DIVIDES '(ZZ-RING p x) '(DIVIDES ZZ-RING p x))
    (let ((k (gx-skolem!)))
      (dk-rewrite-h! (list 'IN k '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
      (gx-rr! k)
      (dk-cite! 'zz-ring-mul-is-mul k 'p)
      (dk-have! (list 'AND (list 'IN k 'RR) '(IN p RR)) (lambda () (dk-conj-close!)))
      (dk-cite! 'rr-mul-comm k 'p)
      (gx-close! 'ZZ-DIVIDES '(p x)
        (gx-ex-rhs! k (lambda ()
                        (subst (list '= 'x (list '(MUL ZZ-RING) k 'p)))
                        (subst (list '= (list '(MUL ZZ-RING) k 'p) (list '* k 'p)))
                        (subst (list '= (list '* k 'p) (list '* 'p k)))
                        (rfl))))))
  (lambda ()
    (gx-open! 'ZZ-DIVIDES '(p x) '(ZZ-DIVIDES p x))
    (let ((c (gx-skolem!)))
      (gx-rr! c)
      (gx-in-zzr! 'p) (gx-in-zzr! 'x) (gx-in-zzr! c)
      (dk-cite! 'zz-ring-mul-is-mul c 'p)
      (dk-have! (list 'AND (list 'IN c 'RR) '(IN p RR)) (lambda () (dk-conj-close!)))
      (dk-cite! 'rr-mul-comm c 'p)
      (gx-close! 'DIVIDES '(ZZ-RING p x)
        (gx-ex-rhs! c (lambda ()
                        (subst (list '= (list '(MUL ZZ-RING) c 'p) (list '* c 'p)))
                        (subst (list '= (list '* c 'p) (list '* 'p c)))
                        (ass)))))))
(qed 'zz-ring-divides-iff)
(topic! 'zz-ring-divides-iff 'algebra)

;; G2: a prime number is a natural number greater than 1
(sp (make-wff '(FORALL p (IMPLIES (IS-PRIME-NAT p) (AND (IN p NN) (< 1 p))))))
(dk-peel!)
(gx-open! 'IS-PRIME-NAT '(p) '(IS-PRIME-NAT p))
(gx-open! 'IS-PRIME-ELEMENT '(ZZ-RING p) '(IS-PRIME-ELEMENT ZZ-RING p))
(dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
(dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
(dk-rewrite-h! '(NOT (= p (ZERO ZZ-RING))) '(ZERO ZZ-RING) 0)
(dk-cite! 'nn-pos-of-nonzero 'p)
(gx-zz! 'p)
(dk-cite! 'zz-discrete 'p)
(dk-have! '(< 1 p)
  (lambda ()
    (pbc)
    (fact 'nn-one-in)
    (dk-cite! 'nn-not-lt-le 1 'p)
    (gx-rr! 'p)
    (fact 'rr-one-in)
    (dk-have! '(AND (IN p RR) (IN 1 RR)) (lambda () (dk-conj-close!)))
    (dk-have! '(AND (<= p 1) (<= 1 p)) (lambda () (dk-conj-close!)))
    (dk-cite! 'rr-leq-antisymmetric 'p 1)
    (fact 'zz-one-in)
    (gx-in-zzr! 1)
    (dk-cite! 'zz-ring-mul-is-mul 'p 1)
    (dk-cite! 'rr-one-mul 1)
    (dk-have! '(IS-UNIT ZZ-RING p)
      (lambda ()
        (gx-close! 'IS-UNIT '(ZZ-RING p)
          (gx-ex-rhs! 1 (lambda ()
                          (subst '(= ((MUL ZZ-RING) p 1) (* p 1)))
                          (subst '(= (ONE ZZ-RING) 1))
                          (subst '(= p 1))
                          (ass))))))
    (dk-only! '(IS-UNIT ZZ-RING p) '(NOT (IS-UNIT ZZ-RING p)))
    (prop)))
(dk-conj-close!)
(qed 'prime-nat-gt-one)
(topic! 'prime-nat-gt-one 'algebra)

;; G3: Euclid's lemma for prime numbers, in Z
(sp (make-wff '(FORALL p (IMPLIES (IS-PRIME-NAT p) (FORALL a (IMPLIES (IN a ZZ) (FORALL b (IMPLIES (IN b ZZ)
  (IMPLIES (ZZ-DIVIDES p (* a b)) (OR (ZZ-DIVIDES p a) (ZZ-DIVIDES p b)))))))))))
(dk-peel!)
(gx-open! 'IS-PRIME-NAT '(p) '(IS-PRIME-NAT p))
(gx-zz! 'p)
(gx-open! 'ZZ-DIVIDES '(p (* a b)) '(ZZ-DIVIDES p (* a b)))
(fact 'zz-is-euclidean-ring)
(gx-in-zzr! 'a) (gx-in-zzr! 'b)
(define gx3-ab
  (let ((iff (dk-cite! 'zz-ring-divides-iff 'p '(* a b))))
    (dk-have! '(DIVIDES ZZ-RING p (* a b)) (lambda () (dk-close-if! (lambda () (dk-only! iff '(ZZ-DIVIDES p (* a b)))) prop)))
    (dk-cite! 'zz-ring-mul-is-mul 'a 'b)
    (dk-rewrite-h! '(DIVIDES ZZ-RING p (* a b)) '(* a b) '((MUL ZZ-RING) a b))))
(define gx3-or (dk-cite! 'euclid-lemma-euclidean-ring 'ZZ-RING 'p 'a 'b))
(define gx3-ia (dk-cite! 'zz-ring-divides-iff 'p 'a))
(define gx3-ib (dk-cite! 'zz-ring-divides-iff 'p 'b))
(dk-only! gx3-or gx3-ia gx3-ib)
(prop)
(qed 'prime-nat-euclid)
(topic! 'prime-nat-euclid 'algebra)

;; G4: a positive integer smaller than p is not a multiple of p
(sp (make-wff '(FORALL p (IMPLIES (IN p ZZ) (FORALL m (IMPLIES (IN m ZZ)
  (IMPLIES (< 0 p) (IMPLIES (< 0 m) (IMPLIES (< m p) (NOT (ZZ-DIVIDES p m)))))))))))
(dk-peel!)
(di)
(gx-open! 'ZZ-DIVIDES '(p m) '(ZZ-DIVIDES p m))
(define gx4-c (gx-skolem!))
(gx-rr! 'p 'm gx4-c)
(fact 'rr-zero-in)
(dk-have! (list 'AND (list 'IN gx4-c 'RR) '(IN p RR)) (lambda () (dk-conj-close!)))
(dk-cite! 'rr-mul-comm gx4-c 'p)
(dk-have! '(<= 0 p) (lambda () (dk-ineq! '(< 0 p))))
(gc-case! (list '<= gx4-c 0)
  (lambda ()
    (dk-cite! 'rr-mul-le-right gx4-c 0 'p)
    (dk-cite! 'rr-zero-mul 'p)
    (let* ((cp (list '* gx4-c 'p)) (pc (list '* 'p gx4-c))
           (h1 (dk-rewrite-h! (list '<= cp '(* 0 p)) '(* 0 p) 0))
           (h2 (dk-rewrite-h! h1 cp pc))
           (h3 (dk-rewrite-h! h2 pc 'm)))
      (dk-absurd! h3 '(< 0 m))))
  (lambda ()
    (dk-cite! 'rr-not-le-lt gx4-c 0)
    (dk-cite! 'zz-discrete gx4-c)
    (fact 'rr-one-in)
    (dk-cite! 'rr-mul-le-right 1 gx4-c 'p)
    (dk-cite! 'rr-one-mul 'p)
    (let* ((cp (list '* gx4-c 'p)) (pc (list '* 'p gx4-c))
           (h1 (dk-rewrite-h! (list '<= '(* 1 p) cp) '(* 1 p) 'p))
           (h2 (dk-rewrite-h! h1 cp pc))
           (h3 (dk-rewrite-h! h2 pc 'm)))
      (dk-absurd! h3 '(< m p)))))
(qed 'zz-divides-small)
(topic! 'zz-divides-small 'algebra)

;; G5: p does not divide i! for i < p
(sp (make-wff '(FORALL i (IMPLIES (IN i NN) (FORALL p (IMPLIES (IS-PRIME-NAT p)
  (IMPLIES (< i p) (NOT (ZZ-DIVIDES p (FACTORIAL i))))))))))
(ni)
(define (gx5-prime! )                   ; p in NN, p in ZZ, 0 < p from (IS-PRIME-NAT p)
  (let ((g (dk-cite! 'prime-nat-gt-one 'p)))
    (dk-split-all! (list g))
    (gx-zz! 'p)
    (if (not (dk-asm? '(IN p RR))) (dk-cite! 'nn-in-rr 'p))
    (if (not (dk-asm? '(< 0 p))) (dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p)))))))
(define gx5-leaves (dk-open-leaves))
(dk-focus! (find-first (lambda (n) (dk-contains? (dk-goal-of n) '(FACTORIAL 0))) gx5-leaves))
(dk-peel!)
(gx5-prime!)
(fact 'factorial-zero)
(fact 'nn-one-is-succ-zero)
(fact 'zz-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'zz-divides-small 'p 1)
(gx-not! '(NOT (ZZ-DIVIDES p (FACTORIAL 0)))
  (lambda ()
    (subst '(= (FACTORIAL 0) (succ 0)))
    (subst '(= (succ 0) 1))
    (ass)))
(dk-focus! (find-first (lambda (n) (not (sequent-node-grounded? n))) gx5-leaves))
(define gx5-ih
  (let ((ls (dk-peel!)))
    (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FACTORIAL))) ls)))
