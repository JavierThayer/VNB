;; F4: a sum over 0..n whose terms vanish at 1..n is its 0-th term
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL r (IMPLIES (IS-COMMUTATIVE-RING r)
  (FORALL f (IMPLIES (IN f (FUN ZZ (CARR r)))
    (IMPLIES (FORALL gsi_ (IMPLIES (IN gsi_ ZZ) (IMPLIES (< 0 gsi_) (IMPLIES (<= gsi_ n) (= (f gsi_) (ZERO r))))))
      (= (SUM r f (succ n)) (f 0)))))))))))
