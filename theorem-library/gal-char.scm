    (subst (list '= (list 'CHOOSE (list 'succ m) (list 'succ k1)) (list '+ (list 'CHOOSE m k1) (list 'CHOOSE m (list 'succ k1)))))
    (subst (list '= (list 'CHOOSE m k1) 0))
    (subst (list '= (list 'CHOOSE m (list 'succ k1)) 0))
