                                  (dk-have! (list '<= (list 'succ (list 'succ k1)) '(succ nv_)) (lambda () (dk-nn! (list '<= (list 'succ k1) 'nv_))))
                                  (dk-have! (list '<= 1 (list 'succ (list 'succ k1))) (lambda () (dk-nn!)))
                                  (gc-int-in! (list 'succ (list 'succ k1)) '(succ nv_))
                                  (dk-apply! (gc-atyp-of 'av_ '(succ nv_)) (list 'succ (list 'succ k1)))
                                  (ass))
                                (ass)))))))))
            (dk-have! (list '= (list gc4-q k1) qv) (lambda () (mac 'MONIC-POLY) (dk-close-if! (lambda () (dk-lam-b!)) gc-rfl-or-ass!)))
            (subst (list '= (list gc4-q k1) qv))
            (gc4-lhs-typ! (list 'succ k1))
            (let ((lif (gc-monv 'av_ '(succ nv_) (list 'succ k1)))
                  (lif2 (list 'IF (list '< (list 'succ k1) '(succ nv_)) (list 'av_ (list 'succ (list 'succ k1))) '(ZERO fr)))
                  (qif2 (list 'IF (list '< k1 'nv_) (list 'av_ (list 'succ (list 'succ k1))) '(ZERO fr))))
              (use-em (list '= k1 'nv_)
                (lambda ()
                  (dk-if-branch! #t lif (lambda () (subst (list '= k1 'nv_)) (rfl))
                    (lambda () (dk-if-branch! #t qv #f (lambda () (crs))))))
                (lambda ()
                  (dk-if-branch! #f lif (lambda () (di) (dk-cite! 'nn-succ-inj k1 'nv_)
                                                   (dk-close-if! (lambda () (dk-only! (list '= k1 'nv_) (list 'NOT (list '= k1 'nv_)))) prop))
                    (lambda ()
