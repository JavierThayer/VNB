;;; gal-charpoly.scm -- the characteristic polynomial of a companion matrix (galois-theory notes,
;;; Proposition 1.37) (GALOIS B6, 2026-10-26).  Destination: theorem-library/gal-charpoly.scm, library
;;; linear-algebra.  Load window: after the determinant files (det-expand-row, det-1x1,
;;; det-upper-triangular, minor-entry), gal-poly (poly-add-at, poly-mul-single-coef) and gal-interp
;;; (poly-one-is-monomial); vocabulary gal-charpoly-vocab.
;;; The result holds over any commutative ring; the notes state it over a field.
;;; Helper prefix gc-.
;;; ======================================================================
(define gc-NM 'NN-ADD-MONOID)
(define (gc-monoid!)
  (if (not (dk-asm? '(IS-MONOID NN-ADD-MONOID)))
      (begin (fact 'nn-add-monoid-is-comm-monoid) (fact 'comm-monoid-is-monoid 'NN-ADD-MONOID))))
(define (gc-nm-carr!)
  (if (not (dk-asm? '(= (CARR NN-ADD-MONOID) NN)))
      (dk-have! '(= (CARR NN-ADD-MONOID) NN) (lambda () (slot 'CARR) (rfl)))))
(define (gc-fs! a f)
  (let ((want (list 'IN f (list 'FINSUPP a gc-NM))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (mac-h 'poly-carrier (list 'IN f (gc-cp a))) (ass))))))
(define (gc-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (slot 'CARR) (ass))))))
(define (gc-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (gc-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
(define (gc-split! f)
  (if (not (every dk-asm? (gc-conjs f))) (dk-split-all! (list f)))
  f)
(define (gc-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (gc-conjs (cadr f)) (gc-conjs (caddr f))) (list f)))
(define (gc-val! a f k)
  (let ((want (list 'IN (list f k) (list 'CARR a))))
    (if (not (dk-asm? want))
        (begin
          (gc-km! k)
          (gc-iff! 'finsupp-membership (list 'IN f (list 'FINSUPP a gc-NM)) a gc-NM f)
          (dk-cite! 'fun-apply-type-c f '(CARR NN-ADD-MONOID) (list 'CARR a) k)))))
(define (gc-int-mem! i hi)
  (gc-iff! 'interval-membership (list 'IN i (list 'INTERVAL 1 hi)) 1 hi i))
(define (gc-int-in! i hi)
  (if (not (dk-asm? (list 'IN i (list 'INTERVAL 1 hi))))
      (dk-have! (list 'IN i (list 'INTERVAL 1 hi))
        (lambda ()
          (dk-have! (list '<= 1 i) (lambda () (dk-nn!)))
          (dk-have! (list '<= i hi) (lambda () (dk-nn!)))
          (dk-cite! 'interval-mem-intro 1 hi i)
          (ass)))))
(define (gc-int-shrink! i n)
  (let ((sn (list 'succ n)))
    (gc-int-mem! i sn)
    (dk-have! (list 'NOT (list '= sn i))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
          (dk-have! (list '= i i) (lambda () (rfl)))
          (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
    (fact 'nn-le-ne-succ i sn)
    (gc-int-in! i n)))
(define (gc-lt-from-ne! n k)
  (fact 'nn-le-ne-succ n k)
  (dk-have! (list '< n k) (lambda () (dk-nn!))))
(define (gc-rfl-or-ass!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (gc-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
(define (gc-repl f a b) (cond ((eq? f a) b) ((pair? f) (cons (gc-repl (car f) a b) (gc-repl (cdr f) a b))) (#t f)))

(define (gc-cp a) (list 'CARR (list 'POLY a)))
;;; ---- the entries of the companion matrix and of x I - A ----
(define gc-I '(INTERVAL 1 nv_))
(define (gc-cg i j) (list 'IF (list '= j 'nv_) (list '(NEG fr) (list 'av_ i)) (list 'IF (list '= i (list 'succ j)) '(ONE fr) '(ZERO fr))))
(define gc-atyp '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 nv_)) (IN (av_ i_) (CARR fr)))))
(sp (make-wff (list 'FORALL 'fr (list 'IMPLIES '(IS-RING fr) (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN)
  (list 'FORALL 'av_ (list 'IMPLIES gc-atyp
    (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I)
      (list '= '(ENTRY (COMPANION fr av_ nv_) i_ j_) (gc-cg 'i_ 'j_))))))))))))))
(dk-peel!)
(dk-cite! 'ring-one-in 'fr) (dk-cite! 'ring-zero-in 'fr)
(define gc1-g (list 'VNB-LAMBDA '(LIST gci_ gcj_) (list 'CARTESIAN gc-I gc-I) (gc-cg 'gci_ 'gcj_)))
(define (gc1-val! i j)
  ;; g(i, j) reduces to the IF, which lies in CARR(fr)
  (dk-apply! gc-atyp i)
  (dk-cite! 'ring-neg-in-carr 'fr (list 'av_ i))
  (dk-have! (list 'IN (gc-cg i j) '(CARR fr))
    (lambda () (dk-case-if! (gc-cg i j) (lambda (tr v) (if tr (ass) (dk-case-if! (list 'IF (list '= i (list 'succ j)) '(ONE fr) '(ZERO fr)) (lambda (tr2 v2) (ass))))))))
  (dk-have! (list '= (list gc1-g i j) (gc-cg i j)) (lambda () (dk-close-if! (lambda () (lam-b)) gc-rfl-or-ass!))))
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I) (list 'IN (list gc1-g 'i_ 'j_) 'SET)))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gc-I))) ls)))
           (i (car ins)) (j (cadr ins)))
      (gc1-val! i j)
      (subst (list '= (list gc1-g i j) (gc-cg i j)))
      (dk-cite! 'membership-implies-sethood (gc-cg i j) '(CARR fr))
      (ass))))
(mac 'COMPANION)
(subst (dk-cite! 'entry-of-matof 'nv_ 'nv_ gc1-g 'i_ 'j_))
(gc1-val! 'i_ 'j_)
(dk-close-if! (lambda () #t) gc-rfl-or-ass!)
(qed 'companion-entry)
(topic! 'companion-entry 'algebra)

(sp (make-wff (list 'FORALL 'fr (list 'IMPLIES '(IS-RING fr) (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN)
  (list 'FORALL 'av_ (list 'IMPLIES gc-atyp '(IN (COMPANION fr av_ nv_) (MAT nv_ nv_ (CARR fr)))))))))))
(dk-peel!)
(dk-cite! 'ring-one-in 'fr) (dk-cite! 'ring-zero-in 'fr)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I) (list 'IN (list gc1-g 'i_ 'j_) '(CARR fr))))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gc-I))) ls)))
           (i (car ins)) (j (cadr ins)))
      (gc1-val! i j)
      (subst (list '= (list gc1-g i j) (gc-cg i j)))
      (ass))))
(mac 'COMPANION)
(dk-cite! 'matof-in-mat 'nv_ 'nv_ '(CARR fr) gc1-g)
(ass)
(qed 'companion-in-mat)
(topic! 'companion-in-mat 'algebra)

;; x I - A
(define gc-X '(MONOMIAL fr (ONE fr) 1))
(define gc-ZP '(ZERO (POLY fr)))
(define (gc-const c) (list 'MONOMIAL 'fr c 0))
(define (gc-mg i j) (list '(ADD (POLY fr)) (list 'IF (list '= i j) gc-X gc-ZP) (list '(NEG (POLY fr)) (gc-const (list 'ENTRY 'am_ i j)))))
(define gc2-g (list 'VNB-LAMBDA '(LIST gmi_ gmj_) (list 'CARTESIAN gc-I gc-I) (gc-mg 'gmi_ 'gmj_)))
(define (gc2-setup!)
  (dk-cite! 'ring-one-in 'fr) (dk-cite! 'ring-zero-in 'fr)
  (dk-cite! 'poly-is-ring 'fr)
  (dk-cite! 'ring-zero-in '(POLY fr))
  (fact 'nn-zero-in)
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (dk-cite! 'monomial-in-poly 'fr '(ONE fr) 1))
(define (gc2-val! i j)
  (dk-cite! 'entry-in-carrier 'nv_ 'nv_ '(CARR fr) 'am_ i j)
  (dk-cite! 'monomial-in-poly 'fr (list 'ENTRY 'am_ i j) 0)
  (dk-cite! 'ring-neg-in-carr '(POLY fr) (gc-const (list 'ENTRY 'am_ i j)))
  (dk-have! (list 'IN (list 'IF (list '= i j) gc-X gc-ZP) '(CARR (POLY fr)))
    (lambda () (dk-case-if! (list 'IF (list '= i j) gc-X gc-ZP) (lambda (tr v) (ass)))))
  (dk-cite! 'ring-add-closed '(POLY fr) (list 'IF (list '= i j) gc-X gc-ZP) (list '(NEG (POLY fr)) (gc-const (list 'ENTRY 'am_ i j))))
  (dk-have! (list '= (list gc2-g i j) (gc-mg i j)) (lambda () (dk-close-if! (lambda () (lam-b)) gc-rfl-or-ass!))))
(define gc-amtyp '(IN am_ (MAT nv_ nv_ (CARR fr))))
(sp (make-wff (list 'FORALL 'fr (list 'IMPLIES '(IS-RING fr) (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN)
  (list 'FORALL 'am_ (list 'IMPLIES gc-amtyp
    (list 'AND '(IN (CHAR-MAT fr am_ nv_) (MAT nv_ nv_ (CARR (POLY fr))))
      (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I)
        (list '= '(ENTRY (CHAR-MAT fr am_ nv_) i_ j_) (gc-mg 'i_ 'j_)))))))))))))))
(dk-peel!)
(gc2-setup!)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I) (list 'IN (list gc2-g 'i_ 'j_) '(CARR (POLY fr)))))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gc-I))) ls)))
           (i (car ins)) (j (cadr ins)))
      (gc2-val! i j)
      (subst (list '= (list gc2-g i j) (gc-mg i j)))
      (ass))))
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gc-I) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gc-I) (list 'IN (list gc2-g 'i_ 'j_) 'SET)))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gc-I))) ls)))
           (i (car ins)) (j (cadr ins)))
      (gc2-val! i j)
      (subst (list '= (list gc2-g i j) (gc-mg i j)))
      (dk-cite! 'membership-implies-sethood (gc-mg i j) '(CARR (POLY fr)))
      (ass))))
(mac 'CHAR-MAT)
(dk-cite! 'matof-in-mat 'nv_ 'nv_ '(CARR (POLY fr)) gc2-g)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
        (let* ((ls (dk-peel!))
               (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gc-I))) ls)))
               (i (car ins)) (j (cadr ins)))
          (subst (dk-cite! 'entry-of-matof 'nv_ 'nv_ gc2-g i j))
          (gc2-val! i j)
          (dk-close-if! (lambda () #t) gc-rfl-or-ass!)))))
(qed 'char-mat-entry)
(topic! 'char-mat-entry 'algebra)

;;; ---- polynomial facts used by the expansion ----
;; p, q in CARR(POLY fr) agree everywhere: p = q
(define (gc-poly-ext! p q prover)
  ;; PROVER: procedure of k (k in NN in context) proving (= (p k) (q k))
  (gc-fs! 'fr p) (gc-fs! 'fr q)
  (gc-monoid!) (gc-nm-carr!)
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (CARR NN-ADD-MONOID)) (list '= (list p 'x_) (list q 'x_))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (dk-have! (list 'IN k 'NN) (lambda () (dk-rewrite-h! (list 'IN k '(CARR NN-ADD-MONOID)) '(CARR NN-ADD-MONOID) 'NN) (ass)))
        (prover k))))
  (dk-cite! 'monalg-ext 'fr gc-NM p q))
(sp (make-wff '(FORALL fr (IMPLIES (IS-COMMUTATIVE-RING fr) (FORALL c_ (IMPLIES (IN c_ (CARR fr)) (FORALL e_ (IMPLIES (IN e_ NN)
  (= ((NEG (POLY fr)) (MONOMIAL fr c_ e_)) (MONOMIAL fr ((NEG fr) c_) e_))))))))))
(dk-peel!)
(dk-cite! 'commutative-ring-is-ring 'fr)
(dk-cite! 'poly-is-ring 'fr)
(dk-cite! 'ring-neg-in-carr 'fr 'c_)
(dk-cite! 'monomial-in-poly 'fr 'c_ 'e_)
(dk-cite! 'monomial-in-poly 'fr '((NEG fr) c_) 'e_)
(dk-cite! 'ring-neg-in-carr '(POLY fr) '(MONOMIAL fr c_ e_))
(gc-poly-ext! '((NEG (POLY fr)) (MONOMIAL fr c_ e_)) '(MONOMIAL fr ((NEG fr) c_) e_)
  (lambda (k)
    (subst (dk-cite! 'poly-neg-at 'fr '(MONOMIAL fr c_ e_) k))
    (use-em (list '= k 'e_)
      (lambda ()
        (subst (list '= k 'e_))
        (subst (dk-cite! 'monomial-at 'fr 'c_ 'e_))
        (subst (dk-cite! 'monomial-at 'fr '((NEG fr) c_) 'e_))
        (rfl))
      (lambda ()
        (subst (dk-cite! 'monomial-off 'fr 'c_ 'e_ k))
        (subst (dk-cite! 'monomial-off 'fr '((NEG fr) c_) 'e_ k))
        (dk-cite! 'ring-zero-in 'fr)
        (crs)))))
(ass)
(qed 'poly-neg-monomial)
(topic! 'poly-neg-monomial 'algebra)

(sp (make-wff '(FORALL fr (IMPLIES (IS-RING fr) (FORALL e_ (IMPLIES (IN e_ NN) (= (MONOMIAL fr (ZERO fr) e_) (ZERO (POLY fr)))))))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'fr)
(dk-cite! 'poly-is-ring 'fr)
(dk-cite! 'ring-zero-in '(POLY fr))
(dk-cite! 'monomial-in-poly 'fr '(ZERO fr) 'e_)
(gc-poly-ext! '(MONOMIAL fr (ZERO fr) e_) '(ZERO (POLY fr))
  (lambda (k)
    (subst (dk-cite! 'poly-zero-apply 'fr k))
    (use-em (list '= k 'e_)
      (lambda () (subst (list '= k 'e_)) (subst (dk-cite! 'monomial-at 'fr '(ZERO fr) 'e_)) (rfl))
      (lambda () (subst (dk-cite! 'monomial-off 'fr '(ZERO fr) 'e_ k)) (rfl)))))
(ass)
(qed 'poly-monomial-zero)
(topic! 'poly-monomial-zero 'algebra)

;; the monic polynomial is a polynomial
(define (gc-mon a n) (list 'MONIC-POLY 'fr a n))
(define (gc-monv a n k) (list 'IF (list '= k n) '(ONE fr) (list 'IF (list '< k n) (list a (list 'succ k)) '(ZERO fr))))
(define (gc-atyp-of a n) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) (list 'IN (list a 'i_) '(CARR fr)))))
;; MONIC(a, n)(k) = its IF, k in NN
(define (gc-mon-at! a n k)
  (dk-have! (list '= (list (gc-mon a n) k) (gc-monv a n k)) (lambda () (mac 'MONIC-POLY) (dk-close-if! (lambda () (lam-b)) gc-rfl-or-ass!))))
(sp (make-wff (list 'FORALL 'fr (list 'IMPLIES '(IS-RING fr) (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN)
  (list 'FORALL 'av_ (list 'IMPLIES gc-atyp (list 'IN (gc-mon 'av_ 'nv_) '(CARR (POLY fr)))))))))))
(dk-peel!)
(dk-cite! 'ring-one-in 'fr) (dk-cite! 'ring-zero-in 'fr)
(fact 'nn-succ-closed 'nv_)
(define (gc3-val-typ! k)
  ;; the value at k is in CARR(fr)
  (dk-have! (list 'IN (gc-monv 'av_ 'nv_ k) '(CARR fr))
    (lambda ()
      (dk-case-if! (gc-monv 'av_ 'nv_ k)
        (lambda (tr v)
          (if tr (ass)
              (dk-case-if! (list 'IF (list '< k 'nv_) (list 'av_ (list 'succ k)) '(ZERO fr))
                (lambda (tr2 v2)
                  (if tr2
                      (begin (fact 'nn-succ-closed k) (fact 'nn-lt-succ-le k 'nv_) (gc-int-in! (list 'succ k) 'nv_) (dk-apply! gc-atyp (list 'succ k)) (ass))
                      (ass))))))))))
(dk-have! (list 'IN (gc-mon 'av_ 'nv_) '(SQN (CARR fr)))
  (lambda ()
    (mac 'SQN) (mac 'MONIC-POLY)
    (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-close-if! (lambda () (gc3-val-typ! k)) gc-rfl-or-ass!))) (lambda () (dk-cite! 'nn-is-set) (ass)))))
(dk-have! (list 'FORSOME 'n_ (list 'AND '(IN n_ NN) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES '(<= n_ k_) (list '= (list (gc-mon 'av_ 'nv_) 'k_) '(ZERO fr)))))))
  (lambda ()
    (ew '(succ nv_))
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((ls (dk-peel!))
                   (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
              (gc3-val-typ! k)
              (gc-mon-at! 'av_ 'nv_ k)
              (subst (list '= (list (gc-mon 'av_ 'nv_) k) (gc-monv 'av_ 'nv_ k)))
              (dk-if-branch! #f (gc-monv 'av_ 'nv_ k) (lambda () (dk-nn!))
                (lambda () (dk-if-branch! #f (list 'IF (list '< k 'nv_) (list 'av_ (list 'succ k)) '(ZERO fr)) (lambda () (dk-nn!)) (lambda () (rfl)))))))))))
(dk-cite! 'poly-tail-zero-bwd 'fr (gc-mon 'av_ 'nv_))
(ass)
(qed 'monic-poly-in-poly)
(topic! 'monic-poly-in-poly 'algebra)

;; MONIC(a, n+1) = x MONIC(a', n) + a(1), with a'(i) = a(i+1)
(define gc-SH '(VNB-LAMBDA gsh_ NN (av_ (succ gsh_))))
(define gc-c1 '(MONOMIAL fr (av_ 1) 0))
(define gc4-q (gc-mon gc-SH 'nv_))
(define gc4-Xq (list '(MUL (POLY fr)) gc-X gc4-q))
(define gc4-R (list '(ADD (POLY fr)) gc4-Xq gc-c1))
(define gc4-L (gc-mon 'av_ '(succ nv_)))
(sp (make-wff (list 'FORALL 'fr (list 'IMPLIES '(IS-COMMUTATIVE-RING fr) (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN)
  (list 'FORALL 'av_ (list 'IMPLIES (gc-atyp-of 'av_ '(succ nv_)) (list '= gc4-L gc4-R)))))))))
(dk-peel!)
(dk-cite! 'commutative-ring-is-ring 'fr)
(gc2-setup!)
(fact 'nn-succ-closed 'nv_)
(gc-int-in! 1 '(succ nv_))
(dk-apply! (gc-atyp-of 'av_ '(succ nv_)) 1)
(dk-have! (gc-atyp-of gc-SH 'nv_)
  (lambda ()
    (let ((i (dk-di-var!)))
      (gc-int-mem! i 'nv_)
      (fact 'nn-succ-closed i)
      (dk-have! (list '<= (list 'succ i) '(succ nv_)) (lambda () (dk-nn! (list '<= i 'nv_))))
      (dk-have! (list '<= 1 (list 'succ i)) (lambda () (dk-nn! (list '<= 1 i))))
      (gc-int-in! (list 'succ i) '(succ nv_))
      (dk-apply! (gc-atyp-of 'av_ '(succ nv_)) (list 'succ i))
      (dk-close-if! (lambda () (lam-b)) gc-rfl-or-ass!))))
(dk-cite! 'monic-poly-in-poly 'fr 'nv_ gc-SH)
(dk-cite! 'monic-poly-in-poly 'fr '(succ nv_) 'av_)
(dk-cite! 'monomial-in-poly 'fr '(av_ 1) 0)
(dk-cite! 'ring-carrier-closed-mul '(POLY fr) gc-X gc4-q)
(dk-cite! 'ring-add-closed '(POLY fr) gc4-Xq gc-c1)
(define gc4-van '(FORALL i_ (IMPLIES (IN i_ NN) (IMPLIES (NOT (= i_ 1)) (= ((MONOMIAL fr (ONE fr) 1) i_) (ZERO fr))))))
(dk-have! gc4-van
  (lambda () (let* ((ls (dk-peel!)) (i (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
               (dk-cite! 'monomial-off 'fr '(ONE fr) 1 i) (ass))))
(define gc4-H (list 'MONALG-MUL 'fr 'NN-ADD-MONOID gc-X gc4-q))
(dk-cite! 'poly-mul-unfold 'fr gc-X gc4-q)
(define (gc4-lhs-typ! k)
  ;; LHS IF value typed, so that rfl / subst accept it
  (dk-have! (list 'IN (gc-monv 'av_ '(succ nv_) k) '(CARR fr))
    (lambda ()
      (dk-case-if! (gc-monv 'av_ '(succ nv_) k)
        (lambda (tr v)
          (if tr (ass)
              (dk-case-if! (list 'IF (list '< k '(succ nv_)) (list 'av_ (list 'succ k)) '(ZERO fr))
                (lambda (tr2 v2)
                  (if tr2
                      (begin (fact 'nn-succ-closed k) (fact 'nn-lt-succ-le k '(succ nv_)) (gc-int-in! (list 'succ k) '(succ nv_)) (dk-apply! (gc-atyp-of 'av_ '(succ nv_)) (list 'succ k)) (ass))
                      (ass))))))))))
(gc-poly-ext! gc4-L gc4-R
  (lambda (k)
    (subst (dk-cite! 'poly-add-at 'fr gc4-Xq gc-c1 k))
    (subst (list '= gc4-Xq gc4-H))
    (gc4-lhs-typ! k)
