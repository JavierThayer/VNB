;; close a POLY-ring identity: type every monomial subterm, then crs
(define (gc-monos t)
  (cond ((and (pair? t) (eq? (car t) 'MONOMIAL)) (list t))
        ((pair? t) (append (gc-monos (car t)) (gc-monos (cdr t))))
        (#t '())))
(define (gc-poly-close!)
  (if (and (dk-contains? (dk-goal) '(MONOMIAL fr (ZERO fr) 0)) (dk-asm? '(= (MONOMIAL fr (ZERO fr) 0) (ZERO (POLY fr)))))
      (subst '(= (MONOMIAL fr (ZERO fr) 0) (ZERO (POLY fr)))))
  (if (and (dk-contains? (dk-goal) '(MONOMIAL fr (ONE fr) 0)) (dk-asm? '(= (ONE (POLY fr)) (MONOMIAL fr (ONE fr) 0))))
      (subst '(= (MONOMIAL fr (ONE fr) 0) (ONE (POLY fr)))))
  (for-each (lambda (m)
              (if (not (dk-asm? (list 'IN m '(CARR (POLY fr)))))
                  (begin
                    (if (and (pair? (caddr m)) (equal? (car (caddr m)) '(NEG fr)) (not (dk-asm? (list 'IN (caddr m) '(CARR fr)))))
                        (dk-cite! 'ring-neg-in-carr 'fr (cadr (caddr m))))
                    (dk-cite! 'monomial-in-poly 'fr (caddr m) (cadddr m)))))
            (gc-monos (dk-goal)))
  (crs))
;; a case split that tolerates a decided proposition
(define (gc-case! p pos neg)
  (cond ((dk-asm? (list 'NOT p)) (neg))
        ((dk-asm? p) (pos))
        (#t (use-em p pos neg))))
;; the (1,1) minor of x I - C(a, n+1) is x I - C(a', n), a'(i) = a(i+1)
(define gc-Cs (list 'COMPANION 'fr gc-SH 'nv_))
