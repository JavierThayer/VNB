                                (lambda ()
                                  (dk-if-branch! #t qif2 #f
                                    (lambda ()
                                      (fact 'nn-succ-closed (list 'succ k1))
                                      (fact 'nn-lt-succ-le k1 'nv_)
                                      (dk-have! (list '<= (list 'succ (list 'succ k1)) '(succ nv_)) (lambda () (dk-nn! (list '<= (list 'succ k1) 'nv_))))
                                      (dk-have! (list '<= 1 (list 'succ (list 'succ k1))) (lambda () (dk-nn!)))
                                      (gc-int-in! (list 'succ (list 'succ k1)) '(succ nv_))
                                      (dk-apply! (gc-atyp-of 'av_ '(succ nv_)) (list 'succ (list 'succ k1)))
                                      (crs))))))
                            (lambda ()
