          (let* ((cf (dk-cite! 'poly-mul-single-coef 'fr gc-X gc4-q 1 k1))
                 (cf2 (dk-rewrite-h! cf (list '+ 1 k1) (list 'succ k1)))
                 (qv (list 'IF (list '= k1 'nv_) '(ONE fr) (list 'IF (list '< k1 'nv_) (list 'av_ (list 'succ (list 'succ k1))) '(ZERO fr)))))
            (subst cf2)
