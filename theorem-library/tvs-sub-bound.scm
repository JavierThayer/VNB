;;; ;;; THE SINGLE-SEMINORM BOUND
(define tsa-fam1 '(IS-SEMINORM-FAMILY-ON fld m1 ix1 pf1))
(define tsa-fam2 '(IS-SEMINORM-FAMILY-ON fld m2 ix2 pf2))

(define tsa-hom '(IS-HOM-TOP-SPACE (SEMINORM-TOP m1 ix1 pf1) (SEMINORM-TOP m2 ix2 pf2) tt))
(define tsa-sbh
  '(FORALL otj_ (IMPLIES (IN otj_ ix2)
     (FORSOME oti_ (AND (IN oti_ ix1)
       (FORSOME otc_ (AND (IN otc_ RR) (AND (<= 0 otc_)
         (FORALL otx_ (IMPLIES (IN otx_ (VEC m1))
           (<= ((pf2 otj_) (tt otx_)) (* otc_ ((pf1 oti_) otx_)))))))))))))

;;; {j} as a finite subset of ix (tbc-single!, tvs-continuity.scm)
(define (tsa-single! j ix)
  (let ((pp (list 'PAIR j j)))
    (dk-cite! 'membership-implies-sethood j ix)
    (dk-have! (list 'AND (list 'IN j 'SET) (list 'IN j 'SET)))
    (dk-cite! 'pairing j j)
    (dk-cite! 'card-singleton j)
    (dk-cite! 'nn-zero-in)
    (dk-cite! 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pp) 'NN) (lambda () (subst (list '= (list 'CARD pp) '(succ 0))) (ass)))
    (dk-have! (list 'SUBSET pp ix)
      (lambda ()
        (mac 'subset-def)
        (let ((w (dk-di-var!)))
          (dk-cite! 'pair-self-eq j w)
          (subst (list '= w j))
          (ass))))
    (dk-cite! 'pair-self-member j)
    pp))

(define (tsa-rename-h! f prs)
  (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f)) f prs))

(sp (make-wff (forall-guarded '(fld m1 ix1 pf1 m2 ix2 pf2 tt) (list tsa-fam1 tsa-fam2 tba-fun tba-sublaw tsa-sbh) tsa-hom)))
(dk-peel!)
(dk-have! '(IN pf1 (FUN ix1 (FUN (VEC m1) RR)))
  (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON tsa-fam1) (dk-split-all!) (ass)))
(dk-have! '(IN pf2 (FUN ix2 (FUN (VEC m2) RR)))
  (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON tsa-fam2) (dk-split-all!) (ass)))
(dk-cite! 'sn-cont-of-bound-sub 'fld 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt)
(let* ((imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (caddr f) tsa-hom) (dk-head-is? (cadr f) 'FORALL)))
                     "the bound implication"))
       (allb (cadr imp)))
  (dk-have! allb
    (lambda ()
      (let* ((j  (dk-di-var!))
             (hj (dk-apply! tsa-sbh j))
             (i  (dk-skolem! hj))
             (c  (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i))) "the constant")))
             (bd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c))) "the bound"))
             (pp (tsa-single! i 'ix1))
             (cb (list '+ c 1)))
        (dk-cite! 'rr-one-in)
        (dk-have! (list 'AND (list 'IN c 'RR) '(IN 1 RR)))
        (dk-cite! 'rr-add-closed c 1)
        (dk-have! (list '< 0 cb) (lambda () (dk-ineq! (list '<= 0 c) (list 'IN c 'RR))))
        (dk-cite! 'rr-pos-rr-of-lt cb)
        (dk-cite! 'fun-apply-type-c 'pf1 'ix1 '(FUN (VEC m1) RR) i)
        (dk-cite! 'fun-apply-type-c 'pf2 'ix2 '(FUN (VEC m2) RR) j)
        (ew pp)
        (dk-conj-close!
          (lambda ()
            (cond
              ((tsa-done?) #t)
              ((dk-asm? (dk-goal)) (ass))
              (#t
               (ew cb)
               (dk-conj-close!
                 (lambda ()
                   (cond
                     ((tsa-done?) #t)
                     ((dk-asm? (dk-goal)) (ass))
                     (#t
                      (dk-peel!)
                      (let* ((g (dk-goal)) (tx (cadr (cadr g))) (x (cadr tx)) (t (caddr (caddr g)))
                             (p (list (list 'pf1 i) x)) (q (list (list 'pf2 j) tx))
                             (hall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f pp) (dk-contains? f x)))
                                            "the hypothesis on {i}")))
                        (dk-apply! hall i)
                        (dk-apply! bd x)
                        (dk-cite! 'fun-apply-type-c (list 'pf1 i) '(VEC m1) 'RR x)
                        (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
                        (dk-cite! 'fun-apply-type-c (list 'pf2 j) '(VEC m2) 'RR tx)
                        (dk-cite! 'rr-mul-le-right p t c)
                        (dk-have! (list 'AND (list 'IN c 'RR) (list 'IN p 'RR)))
                        (dk-cite! 'rr-mul-comm c p)
                        (dk-have! (list '= (list '* cb t) (list '+ (list '* t c) t)) (lambda () (crs)))
                        (for-each dk-real! (list (list '* c p) (list '* p c) (list '* t c) (list '* cb t)))
                        (let* ((n1 (dk-name! (list '* c p)))
                               (n2 (dk-name! (list '* p c)))
                               (n3 (dk-name! (list '* t c)))
                               (n4 (dk-name! (list '* cb t)))
                               (prs (list (cons (list '* c p) n1) (cons (list '* p c) n2)
                                          (cons (list '* t c) n3) (cons (list '* cb t) n4))))
                          (subst (list '= (list '* cb t) n4))
                          (apply dk-ineq!
                                 (append (map (lambda (f) (tsa-rename-h! f prs))
                                              (list (list '<= q (list '* c p))
                                                    (list '= (list '* c p) (list '* p c))
                                                    (list '<= (list '* p c) (list '* t c))
                                                    (list '= (list '* cb t) (list '+ (list '* t c) t))))
                                         (list (list '<= 0 t) (list 'IN q 'RR) (list 'IN t 'RR)
                                               (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN n3 'RR) (list 'IN n4 'RR)))))))))))))))))
  (detach! imp)
  (if (not (tsa-done?)) (ass)))
(tsa-qed! 'sn-cont-of-single-bound-sub)

;;; =============================================================================================
;;; THE COMPLEX CASE OF Prop 1.12 (=>): continuity gives the seminorm bound over CC-NORMED-FIELD
;;; (BA-OT1-REPORT K1: the necessity half of every "phi is continuous iff" of Banach Algebras ch. 5).
;;; ---------------------------------------------------------------------------
;;; Prop 1.12, (=>), over the COMPLEX numbers (the port of sn-bound-of-cont; the rescaling factor 1 / q_j(Tx) is real): continuity gives the bound (the notes' homogeneity argument, by
;;; contradiction: if q_j(Tx) > t / eps, rescale x by 1 / q_j(Tx) into the basic neighbourhood)
(define tba-cfam1 '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD m1 ix1 pf1))
(define tba-cfam2 '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD m2 ix2 pf2))
(define tba-hom (list 'IS-HOM-TOP-SPACE tba-top1 tba-top2 'tt))
(define tba-ccv '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define tba-lin '(IS-LINEAR-MAP m1 m2 tt))
(define (tba-cfam-parts!)
  (for-each (lambda (pr)
              (let ((h (car pr)) (c (cdr pr)))
                (if (not (dk-asm? c))
                    (dk-have! c (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form h)) (dk-split-all!) (ass))))))
            (list (cons tba-cfam1 '(IS-MODULE m1)) (cons tba-cfam1 '(IN pf1 (FUN ix1 (FUN (VEC m1) RR))))
                  (cons tba-cfam1 '(IN ix1 SET)) (cons tba-cfam1 (list '= '(SCAL m1) tba-ccv))
                  (cons tba-cfam1 '(FORALL sni_ (IMPLIES (IN sni_ ix1) (IS-SEMINORM CC-NORMED-FIELD m1 (pf1 sni_)))))
                  (cons tba-cfam2 '(IS-MODULE m2)) (cons tba-cfam2 '(IN pf2 (FUN ix2 (FUN (VEC m2) RR))))
                  (cons tba-cfam2 '(IN ix2 SET)) (cons tba-cfam2 (list '= '(SCAL m2) tba-ccv))
                  (cons tba-cfam2 '(FORALL sni_ (IMPLIES (IN sni_ ix2) (IS-SEMINORM CC-NORMED-FIELD m2 (pf2 sni_)))))))
  (if (not (dk-asm? '(IN tt (FUN (VEC m1) (VEC m2)))))
      (dk-have! '(IN tt (FUN (VEC m1) (VEC m2)))
        (lambda () (mac-h 'IS-LINEAR-MAP (dk-ctx-form tba-lin)) (dk-split-all!) (ass))))
  (dk-cite! 'frm-module-vec-set 'm1)
  (dk-cite! 'frm-module-vec-set 'm2))
;;; (IN v (CARR (SCAL mi))) from (IN v RR)
(define (tba-scal-of-rr! v mi)
  (dk-cite! 'rr-subset-cc v)
  (let ((goal (list 'IN v (list 'CARR (list 'SCAL mi)))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (subst (list '= (list 'SCAL mi) tba-ccv))
            (subst (list '== (list 'CARR tba-ccv) '(CARR CC-NORMED-FIELD)))
            (subst '(== (CARR CC-NORMED-FIELD) CC))
            (dk-ass!))))
    goal))
(define (tba-single! j ix)
  (let ((pp (list 'PAIR j j)))
    (dk-cite! 'membership-implies-sethood j ix)
    (tba-and! (list 'IN j 'SET) (list 'IN j 'SET))
    (dk-cite! 'pairing j j)
    (dk-cite! 'card-singleton j)
    (fact 'nn-zero-in)
    (dk-cite! 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pp) 'NN) (lambda () (subst (list '= (list 'CARD pp) '(succ 0))) (ass)))
    (dk-have! (list 'SUBSET pp ix)
      (lambda ()
        (mac 'subset-def)
        (let ((w (dk-di-var!)))
          (dk-cite! 'pair-self-eq j w)
          (subst (list '= w j))
          (ass))))
    (dk-cite! 'pair-self-member j)
    pp))

(define tba-bnd-stmt
  (tba-alls '(m1 ix1 pf1 m2 ix2 pf2 tt)
    (tba-imps (list tba-cfam1 tba-cfam2 tba-lin tba-hom) tba-allb)))
(sp (make-wff tba-bnd-stmt))
(dk-peel!)
(tba-cfam-parts!)
(fact 'cc-is-normed-field)
(dk-cite! 'normed-field-ring-view-carr 'CC-NORMED-FIELD)
(fact 'cc-nf-carr)
(dk-cite! 'sntop-pts 'm1 'ix1 'pf1)
(let* ((j (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ix2) (symbol? (cadr f)))) "j")))
       (iff (dk-cite! 'is-hom-top-space-def tba-top1 tba-top2 'tt))
       (pre (caddr (caddr (caddr (caddr iff)))))
       (z1 '(VZERO m1)) (z2 '(VZERO m2))
       (pp (tba-single! j 'ix2))
       (ww (list 'SN-OBALL 'm2 'pf2 pp z2 1))
       (pw (list 'PREIMAGE tba-top1 'tt ww)))
  (dk-have! pre (lambda () (mac-h 'is-hom-top-space-def (dk-ctx-form tba-hom)) (dk-split-all!) (ass)))
  (dk-cite! 'module-vzero-in 'm1) (dk-cite! 'module-vzero-in 'm2)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (dk-cite! 'sntop-oball-open 'CC-NORMED-FIELD 'm2 'ix2 'pf2 pp z2 1)
  (dk-cite! 'sn-oball-center 'CC-NORMED-FIELD 'm2 'ix2 'pf2 pp z2 1)
  (inst*! pre ww)
  (dk-cite! 'frm-linear-zero 'm1 'm2 'tt)
  (dk-have! (list 'IN pw (list 'OPENS tba-top1)) (lambda () (dk-ass!)))
  (let ((pm (dk-rewrite-h! (dk-cite! 'preimage-membership tba-top1 'tt ww z1) (list 'PTS tba-top1) '(VEC m1))))
    (dk-have! (list 'IN (list 'tt z1) ww) (lambda () (subst (list '= (list 'tt z1) z2)) (dk-ass!)))
    (dk-have! (list 'IN z1 pw) (lambda () (if (dk-only! pm (list 'IN z1 '(VEC m1)) (list 'IN (list 'tt z1) ww)) (prop)))))
  (let* ((ex (dk-cite! 'sntop-open-basic 'CC-NORMED-FIELD 'm1 'ix1 'pf1 pw z1))
         (ff (dk-skolem! ex #t))
         (ep (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "radius") #t))
         (b1 (list 'SN-BALL 'm1 'pf1 ff z1 ep))
         (cc (list 'recip ep)))
    (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
    (dk-have! (list 'NOT (list '= ep 0)) (lambda () (di) (dk-absurd! (list '= ep 0) (list '< 0 ep) (list 'IN ep 'RR))))
    (tba-and! (list 'IN ep 'RR) (list 'NOT (list '= ep 0)))
    (dk-cite! 'rr-recip-closed ep)
    (dk-cite! 'rr-recip-pos ep)
    (dk-cite! 'rr-pos-rr-of-lt cc)
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (ew cc)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld (dk-peel!))
                             (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ld))))
                             (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                             (pall (car (filter (lambda (f) (dk-head-is? f 'FORALL)) ld)))
                             (q (list (list 'pf2 j) (list 'tt x)))
                             (ct (list '* cc t)))
                        (tba-qval! j x)
                        (dk-real! ct)
                        (use-em (list '<= q ct)
                          (lambda () (dk-ass!))
                          (lambda ()
                            (dk-cite! 'rr-not-le-lt q ct)
                            (tba-and! (list 'IN cc 'RR) (list 'IN t 'RR))
                            (dk-have! (list '<= 0 cc) (lambda () (dk-ineq! (list '< 0 cc) (list 'IN cc 'RR))))
                            (tba-and! (list '<= 0 cc) (list '<= 0 t))
                            (dk-cite! 'rr-leq-mul-nonneg cc t)
                            (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< ct q) (list '<= 0 ct) (list 'IN ct 'RR) (list 'IN q 'RR))))
                            (dk-cite! 'rr-mul-comm cc t)
                            (let* ((tc (list '* t cc))
                                   (lt1 (dk-rewrite-h! (list '< ct q) ct tc))
                                   (sw (dk-cite! 'rr-recip-swap-lt t q ep))
                                   (lam (list 'recip q)))
                              (dk-have! (list 'NOT (list '= q 0)) (lambda () (di) (dk-absurd! (list '= q 0) (list '< 0 q) (list 'IN q 'RR))))
                              (tba-and! (list 'IN q 'RR) (list 'NOT (list '= q 0)))
                              (dk-cite! 'rr-recip-closed q)
                              (dk-cite! 'rr-recip-pos q)
                              (dk-cite! 'rr-recip-inverse q)
                              (dk-have! (list '<= 0 lam) (lambda () (dk-ineq! (list '< 0 lam) (list 'IN lam 'RR))))
                              (dk-cite! 'rr-abs-of-nonneg lam)
                              (dk-cite! 'rr-subset-cc lam)
                              (dk-cite! 'cc-nf-fnrm-apply lam)
                              (dk-cite! 'rr-magnitude-is-abs lam)
                              (tba-scal-of-rr! lam 'm1)
                              (tba-scal-of-rr! lam 'm2)
                              (let* ((y (list '(ACT m1) lam x))
                                     (ty1 (dk-cite! 'module-act-type 'm1 lam x))
                                     (bi (dk-cite! 'sn-ball-membership 'm1 'pf1 ff z1 ep y))
                                     (br (caddr bi)))
                                (dk-cite! 'module-act-type 'm1 lam x)
                                (dk-cite! 'frm-v-sub-zero 'm1 y)
                                (dk-have! br
                                  (lambda ()
                                    (dk-conj-close!
                                      (lambda ()
                                        (if (not (dk-ass!))
                                            (let* ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                                                   (pi (list 'pf1 i))
                                                   (px (list pi x)) (py (list pi y)))
                                              (subst (list '= (list '(VADD m1) y (list '(VNEG m1) z1)) y))
                                              (dk-cite! 'subset-mem-fwd ff 'ix1 i)
                                              (inst*! (dk-ctx-form '(FORALL sni_ (IMPLIES (IN sni_ ix1) (IS-SEMINORM CC-NORMED-FIELD m1 (pf1 sni_))))) i)
                                              (dk-cite! 'fun-apply-type-c 'pf1 'ix1 '(FUN (VEC m1) RR) i)
                                              (dk-cite! 'fun-apply-type-c pi '(VEC m1) 'RR x)
                                              (dk-cite! 'fun-apply-type-c pi '(VEC m1) 'RR y)
                                              (inst*! pall i)
                                              (let* ((h (dk-cite! 'frm-sn-homog 'CC-NORMED-FIELD 'm1 pi lam x))
                                                     (h2 (dk-rewrite-h! (dk-rewrite-h! h (list '(FNRM CC-NORMED-FIELD) lam) (list 'magnitude lam)) (list 'magnitude lam) (list 'abs lam)))
                                                     (h3 (dk-rewrite-h! h2 (list 'abs lam) lam)))
                                                (dk-cite! 'rr-mul-le-right px t lam)
                                                (tba-and! (list 'IN lam 'RR) (list 'IN px 'RR))
                                                (dk-cite! 'rr-mul-comm lam px)
                                                (for-each dk-real! (list (list '* lam px) (list '* px lam) (list '* t lam)))
                                                (let* ((n1 (dk-name! (list '* lam px)))
                                                       (n2 (dk-name! (list '* px lam)))
                                                       (n3 (dk-name! (list '* t lam)))
                                                       (rw (lambda (f)
                                                             (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                        f (list (cons (list '* lam px) n1) (cons (list '* px lam) n2)
                                                                                (cons (list '* t lam) n3))))))
                                                  (apply dk-ineq!
                                                         (append (map rw (list h3 (list '= (list '* lam px) (list '* px lam))
                                                                               (list '<= (list '* px lam) (list '* t lam))
                                                                               (list '< (list '* t lam) ep)))
                                                                 (list (list 'IN py 'RR) (list 'IN ep 'RR)
                                                                       (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN n3 'RR))))))))))))
                                (dk-have! (list 'IN y b1) (lambda () (if (dk-only! bi br) (prop))))
                                (dk-cite! 'subset-mem-fwd b1 pw y)
                                (let* ((pm (dk-rewrite-h! (dk-cite! 'preimage-membership tba-top1 'tt ww y) (list 'PTS tba-top1) '(VEC m1)))
                                       (ty (list 'tt y)))
                                  (dk-have! (list 'IN ty ww) (lambda () (if (dk-only! pm (list 'IN y pw)) (prop))))
                                  (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) y)
                                  (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
                                  (let* ((oi (dk-cite! 'sn-oball-membership 'm2 'pf2 pp z2 1 ty))
                                         (orr (caddr oi)))
                                    (dk-have! orr (lambda () (if (dk-only! oi (list 'IN ty ww)) (prop))))
                                    (dk-split! orr)
                                    (let* ((e (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ty))) "margin") #t))
                                           (bd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) "bound at j")))
                                      (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
                                      (inst*! bd j)
                                      (dk-cite! 'frm-v-sub-zero 'm2 ty)
                                      (dk-cite! 'frm-linear-homog 'm1 'm2 'tt lam x)
                                      (inst*! (dk-ctx-form '(FORALL sni_ (IMPLIES (IN sni_ ix2) (IS-SEMINORM CC-NORMED-FIELD m2 (pf2 sni_))))) j)
                                      (let* ((qj (list 'pf2 j))
                                             (tx (list 'tt x))
                                             (h (dk-cite! 'frm-sn-homog 'CC-NORMED-FIELD 'm2 qj lam tx))
                                             (h2 (dk-rewrite-h! (dk-rewrite-h! h (list '(FNRM CC-NORMED-FIELD) lam) (list 'magnitude lam)) (list 'magnitude lam) (list 'abs lam)))
                                             (h3 (dk-rewrite-h! h2 (list 'abs lam) lam))
                                             (b0 (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f e))) "the bound"))
                                             (b1x (dk-rewrite-h! b0 (list '(VADD m2) ty (list '(VNEG m2) z2)) ty))
                                             (b2x (dk-rewrite-h! b1x ty (list '(ACT m2) lam tx))))
                                        (tba-and! (list 'IN q 'RR) (list 'IN lam 'RR))
                                        (dk-cite! 'rr-mul-comm q lam)
                                        (for-each dk-real! (list (list '* lam q) (list '* q lam)))
                                        (dk-cite! 'module-act-type 'm2 lam tx)
                                        (dk-cite! 'fun-apply-type-c qj '(VEC m2) 'RR (list '(ACT m2) lam tx))
                                        (let* ((n1 (dk-name! (list '* lam q)))
                                               (n2 (dk-name! (list '* q lam)))
                                               (rw (lambda (f)
                                                     (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                f (list (cons (list '* lam q) n1) (cons (list '* q lam) n2))))))
                                          (pbc)
                                          (apply dk-absurd!
                                                 (append (map rw (list h3 b2x (list '= (list '* q lam) (list '* lam q))
                                                                       (list '= (list '* q lam) 1)))
                                                         (list (list '< 0 e) (list 'IN e 'RR) (list 'IN n1 'RR) (list 'IN n2 'RR)
                                                               (list 'IN (list qj (list '(ACT m2) lam tx)) 'RR)))))))))))))))))))))))
(tba-qed! 'sn-bound-of-cont-cc)

