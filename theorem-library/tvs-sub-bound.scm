;;; the single-bound form
(define (tsa-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (tsa-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** tvs-single-bound: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l) (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))

