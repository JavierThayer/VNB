;;; PROP 1.12 over the complex numbers: continuous iff bounded by the seminorms
(define tba-iff-stmt
  (tba-alls '(m1 ix1 pf1 m2 ix2 pf2 tt)
    (tba-imps (list tba-cfam1 tba-cfam2 tba-lin) (list 'IFF tba-hom tba-allb))))
(sp (make-wff tba-iff-stmt))
(dk-peel!)
(dk-iff! (lambda (g) (or (dk-head-is? g 'FORALL) (and (dk-head-is? g 'IMPLIES) (dk-head-is? (cadr g) 'IS-HOM-TOP-SPACE))))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (dk-cite! 'sn-bound-of-cont-cc 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt)
    (dk-ass!))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (dk-cite! 'sn-cont-of-bound 'CC-NORMED-FIELD 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt)
    (dk-ass!)))
(tba-qed! 'sn-cont-iff-bound-cc)
