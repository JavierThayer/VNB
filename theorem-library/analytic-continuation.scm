  (dk-have! (list 'IN lam (list 'FUN d '(CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
(define acn-tp '(* 2 PI))
(define acn-I (list 'CCINT 0 acn-tp))
(define acn-C '(CIRCLE-PATH c r))
(define acn-Cd '(CIRCLE-DERIV c r))
(define acn-T (list 'TRACE acn-C 0 acn-tp))
