    (lambda ()
      (let* ((y (dk-di-var!)))
        (fact 'subset-mem-fwd acn-T 'u y)
        (dk-apply! (dk-ctx-form (acn-cont 'u 'f)) y)
        (dk-cite! 'subspace-restrict-continuous-at acn-nfm 'u acn-T acn-nfm 'f y)
        (ass))))
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ acn-T) '(<= r (magnitude (- aix_ c)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (m (list 'magnitude (list '- y 'c))))
