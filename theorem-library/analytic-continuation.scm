;;; analytic-continuation.scm -- PROPOSITION 2.12 (PRINCIPLE OF ANALYTIC CONTINUATION) AND
;;; COROLLARY 2.13 (FINITELY MANY ZEROS IN A CLOSED BALL) OF complex-analysis.pdf.
;;; Agent CA-AC, 2026-10-14.  Vocabulary: structure-library/ca-ac-vocab.scm
;;; (ZEROS-ACCUMULATE-AT, new; the user's to confirm).
;;;
;;; CONTENTS.
;;;  (1) zeros-accumulate-value          a continuous function vanishes at an accumulation point of its zeros
;;;  (2) cc-series-of-zeros              a series of zeros converges only to 0
;;;  (3) cc-power-nonzero                t /= 0 => t^n /= 0
;;;  (4) holomorphic-zero-factor         at an accumulation point a of the zeros of a holomorphic h on v:
;;;                                      for every n, h(x) = (x - a)^n q(x) with q holomorphic on v
;;;                                      (induction; holomorphic-difference-quotient, the removable
;;;                                      singularity by goursat-triangle-except + morera)
;;;  (5) holomorphic-zero-coefficients   in the disc setting of cauchy-estimates.scm every coefficient of
;;;                                      holomorphic-power-series-disc is 0 (the integrand is q on the
;;;                                      circle: line-int-domain-congruence; Cauchy: cauchy-disc)
;;;  (6) holomorphic-zeros-local         ... so f vanishes on a ball about that point
;;;  (7) holomorphic-identity-principle  2.12 for a HOLOMORPHIC f on a connected open u
;;;                                      (connected-locally-constant applied to w |-> IF(zeros accumulate at w, 0, 1))
;;;  (8) analytic-on-holomorphic         analytic at every point => holomorphic
;;;  (9) analytic-continuation           PROPOSITION 2.12, as the notes state it
;;; (10) analytic-zeros-finite-in-ball   COROLLARY 2.13 (cc-closed-ball-compact and compact-cover-by-balls
;;;                                      of weierstrass-convergence.scm)
;;;
;;; THE ROUTE AGAINST THE NOTES.  The notes' local step factors f = (z - a)^n g with g(a) = c_n /= 0;
;;; the tree has no shift of a power series, so (4)-(6) show instead that every power of (z - a)
;;; divides f, whence every Taylor coefficient vanishes.  The global step uses connectedness
;;; (connected-locally-constant) where the notes use polygonal paths.  Corollary 2.13 goes through
;;; a finite subcover where the notes' "only finitely many" would usually be argued with a sequence
;;; of distinct zeros (the tree has no "an infinite set carries an injective sequence").
;;;
;;; NOTHING asserted, no support, no stamp.  Helper prefix acn- (the cie- helpers of
;;; cauchy-estimates.scm copied as acn-: a helper is local to its file); theorem binders acn*_ and
;;; the binders of the cited theorems where an instance must match (u, f, c, cifs_, r, k, mcx_ ...).
;;; LOAD WINDOW: after theorem-library/weierstrass-convergence; also above cauchy-estimates,
;;; cauchy-integral-formula, morera, goursat-exceptional, metric-connected-laws, nth-deriv-laws.

(define acn-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (acn-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (acn-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS acn-nfm u) acn-nfm f 'rgy_))))
(define (acn-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (acn-imps (cdr hyps) body))))
(define (acn-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (acn-all (cdr vars) body))))
(define (acn-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (acn-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (acn-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((acn-op? t 'succ 2) (acn-nn! t) (fact 'nn-in-rr t) typ)
          ((acn-op? t '* 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '+ 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '- 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '- 2) (acn-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((acn-op? t 'magnitude 2) (acn-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((acn-op? t 'real-part 2) (acn-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((acn-op? t 'imag-part 2) (acn-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((acn-op? t 'abs 2) (acn-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((acn-op? t 'recip 2)
           (acn-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "acn-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (acn-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (acn-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((acn-op? t 'succ 2) (acn-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (acn-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (acn-op? t 'succ 2)
               (acn-op? t 'magnitude 2) (acn-op? t 'real-part 2) (acn-op? t 'imag-part 2))
           (acn-rr! t) (fact 'rr-subset-cc t) typ)
          ((acn-op? t '- 3) (acn-cc! (cadr t)) (acn-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((acn-op? t '- 2) (acn-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((acn-op? t '+ 3) (acn-cc! (cadr t)) (acn-cc! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((acn-op? t '* 3) (acn-cc! (cadr t)) (acn-cc! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((acn-op? t 'power 3) (acn-cc! (cadr t)) (acn-nn! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((acn-op? t 'CC-EXP 2) (acn-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((acn-op? t 'recip 2) (acn-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "acn-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (acn-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (acn-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (acn-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (acn-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (acn-only-prop! iff (list 'IN y (acn-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (acn-only-prop! iff (list 'IN y (acn-pz z))))))
      (lambda () (acn-sub-nz! y z)))))
(define (acn-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (acn-pz z))
      (lambda () (acn-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (acn-pz-setup! z)
  (let* ((d (acn-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN acn-nfm d) (lambda () (acn-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (acn-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (acn-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (acn-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (acn-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (acn-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (acn-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (acn-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (acn-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; 2 pi i: in CC and non-zero, its reciprocal in CC
(define acn-tpi '(* (* 2 PI) +i))
(define (acn-tpi!)
  (acn-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (acn-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (acn-cc! acn-tpi)
  (acn-cc! (list 'recip acn-tpi))
  (acn-and! (list 'IN acn-tpi 'CC) (list 'NOT (list '= acn-tpi 0)))
  (dk-cite! 'cc-recip-inverse acn-tpi))
;;; x in CC, c in CC, s in RR, |x - c| < s in context: land x in BALL(CC-MS, c, s)
(define (acn-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (acn-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (acn-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (acn-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (acn-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (acn-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (acn-rr! mag))
      (lambda () (acn-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (acn-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (acn-subst-sym (car e) from to) (acn-subst-sym (cdr e) from to)))
        (#t e)))
;;; a point x of the trace, the trace already known inside CC \ {c} (and CC \ {z} ...):
;;; land x in CC, x /= c, x - c /= 0 (the same for each z in ZS)
(define (acn-tpt! x . zs)
  (acn-steps
    (lambda () (fact 'subset-mem-fwd acn-T (acn-pz 'c) x))
    (lambda () (acn-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd acn-T (acn-pz z) x) (acn-pz-open! z x)) zs))))
(define (acn-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (acn-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (acn-rr! m)
    (acn-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (acn-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (acn-in-ball! a a r)))

(define (acn-R c) (list 'VNB-LAMBDA 'cifv_ (acn-pz c) (list 'recip (list '- 'cifv_ c))))
(define (acn-S c) (list 'VNB-LAMBDA 'cifv_ (acn-pz c) (list '- 'cifv_ c)))
(define (acn-P c n) (list 'VNB-LAMBDA 'cifv_ (acn-pz c) (list 'power (list 'recip (list '- 'cifv_ c)) n)))
(define (acn-sq-recip w c) (list '* (list 'recip (list '- w c)) (list 'recip (list '- w c))))
(define (acn-pd-goal j)
  (list 'FORALL 'cifc_ (list 'IMPLIES '(IN cifc_ CC)
    (list 'FORALL 'cifw_ (list 'IMPLIES (list 'IN 'cifw_ (acn-pz 'cifc_))
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD (acn-pz 'cifc_) (acn-P 'cifc_ (list 'succ j)) 'cifw_
            (list '* (list '- (list 'succ j)) (list 'power (list 'recip (list '- 'cifw_ 'cifc_)) (list 'succ (list 'succ j))))))))))
(define (acn-pow-succ! a n)
  (acn-cc! a) (acn-nn! n)
  (acn-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
