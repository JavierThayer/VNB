    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 acn-tp) '(< 0 PI))))))))
(define (acn-circle-basics!)
  (fact 'rr-zero-in)
  (acn-rr! acn-tp)
  (dk-have! (list '< 0 acn-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path acn-C acn-Cd 0 acn-tp)
  (fact 'is-path-in-fun acn-C 0 acn-tp)
  (dk-cite! 'trace-subset-cc acn-C 0 acn-tp))
(define (acn-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (acn-steps
      (lambda () (fact 'subset-mem-fwd acn-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (acn-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (acn-sub-nz! y 'c))
      (lambda () (acn-pz-in! 'c y)))))
(define (acn-circ-not-z! y)
  ;; y in the trace, |z - c| < r: y /= z, y in CC \ {z}
  (acn-steps
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'z))
        (lambda ()
          (di)
          (dk-have! '(= (magnitude (- z c)) r)
            (lambda () (subst (list '= 'z y)) (ass)))
          (acn-rr! '(magnitude (- z c)))
          (dk-absurd! '(IN (magnitude (- z c)) RR) '(IN r RR) '(= (magnitude (- z c)) r) '(< (magnitude (- z c)) r)))))
    (lambda () (acn-sub-nz! y 'z))
    (lambda () (acn-pz-in! 'z y))))
(define (acn-Hk g k)
  (list 'VNB-LAMBDA 'aiw_ acn-T (list '* (list g 'aiw_) (list 'power '(recip (- aiw_ c)) (list 'succ k)))))
(define (acn-LI f) (list 'LINE-INT f acn-C acn-Cd 0 acn-tp))
(define (acn-trace-in-pz! p)
  (dk-have! (list 'SUBSET acn-T (acn-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
