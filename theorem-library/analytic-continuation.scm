(define (acn-cf-w-pt! x)
  ;; x in W: x in u, x in CC, x /= z, x - z /= 0, x in CC \ {z}
  (let* ((dm (dk-cite! 'difference-membership 'u '(SINGLETON z) x))
        (sm (dk-cite! 'singleton-membership 'z x)))
    (acn-steps
      (lambda () (dk-have! (list 'IN x 'u) (lambda () (acn-only-prop! dm (list 'IN x acn-cf-w)))))
      (lambda () (fact 'subset-mem-fwd 'u 'CC x))
      (lambda () (fact 'membership-implies-sethood x 'CC))
      (lambda () (dk-have! (list 'NOT (list '= x 'z))
                   (lambda () (acn-only-prop! dm sm (list 'IN x acn-cf-w) (list 'IN x 'SET)))))
      (lambda () (acn-sub-nz! x 'z))
