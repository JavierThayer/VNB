    (list '* (list '* acn-kap (acn-LI (list 'VNB-LAMBDA 'aiw_ acn-T
                                            (list '* (list acn-rf 'aiw_) (list 'power '(recip (- aiw_ c)) '(succ aitk_))))))
             (list 'power (list '- z 'c) 'aitk_))))
