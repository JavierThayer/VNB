(define acn-cf-f1 (acn-f1 'z))
(define acn-cf-kt (list 'VNB-LAMBDA 'cifw_ acn-T '(recip (- cifw_ z))))
(define acn-cf-f2 (list 'VNB-LAMBDA 'cifw_ acn-T '(* (f z) (recip (- cifw_ z)))))
(define acn-cf-lk (acn-LI (acn-kern 'z)))
(define acn-rf (list 'RESTRICT 'f acn-T))
(define (acn-f1r z) (list 'VNB-LAMBDA 'aiw_ acn-T (list '* (list acn-rf 'aiw_) (list 'recip (list '- 'aiw_ z)))))
(define (acn-disc-setting!)
  (acn-center-in-ball! 'c 'cifs_)
  (acn-circle-basics!)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'trace-is-set acn-C 0 acn-tp)
  (fact 'subset-refl acn-T)
  (dk-cite! 'circle-path-closed 'c 'r)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS acn-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS acn-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-cite! 'holomorphic-on-in-fun 'u 'f)
  (dk-cite! 'holomorphic-on-open 'u 'f)
  (dk-cite! 'holomorphic-on-continuous 'u 'f)
  (dk-cite! 'cc-open-subset-cc 'u)
  (dk-have! (list 'SUBSET 'u (list 'PTS acn-nfm))
    (lambda () (subst (list '== (list 'PTS acn-nfm) 'CC)) (ass)))
  (dk-have! (list 'SUBSET acn-T '(BALL CC-MS c cifs_))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (acn-circ-pt! y)
        (dk-have! (list '< (list 'magnitude (list '- y 'c)) 'cifs_)
          (lambda () (dk-ineq! (list '= (list 'magnitude (list '- y 'c)) 'r) '(< r cifs_))))
