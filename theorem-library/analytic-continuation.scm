;;; (E0) |i| = 1
;;; ======================================================================
;;; local helpers (typers after weierstrass-convergence.scm's wcv-, copied)
;;; ======================================================================
(define (acn-need f what)
  (if (not (dk-asm? f)) (error (string-append "acn: missing " what) (expression->string f)))
  f)
(define (acn-sub v) (list 'SUBSPACE-MS acn-nfm v))
(define (acn-mg t) (list 'magnitude t))
(define (acn-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
;;; the metric facts on the subspace v of NFM (v open in NFM in context)
(define (acn-ms! v)
  (fact 'cc-open-subset-cc v)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS acn-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS acn-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS acn-nfm) '(CARR CC-NORMED-FIELD))) (ass))))
  (if (not (dk-asm? (list 'SUBSET v (list 'PTS acn-nfm))))
      (dk-have! (list 'SUBSET v (list 'PTS acn-nfm))
        (lambda () (subst (list '== (list 'PTS acn-nfm) 'CC)) (ass))))
  (if (not (dk-asm? (list 'IN v 'SET)))
      (dk-have! (list 'IN v 'SET)
        (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set v 'CC) (ass))))
  (fact 'subspace-is-metric-space acn-nfm v)
  (fact 'subspace-pts acn-nfm v)
  (fact 'cc-is-metric-space) (acn-pts-cc!))
;;; (IN p (PTS CC-MS)) from (IN p CC)
(define (acn-ptcc! p)
  (acn-cc! p)
  (if (not (dk-asm? (list 'IN p '(PTS CC-MS))))
      (dk-have! (list 'IN p '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))))

;;; ======================================================================
;;; (1) A CONTINUOUS FUNCTION VANISHES AT AN ACCUMULATION POINT OF ITS ZEROS
;;; ======================================================================
(sp (make-wff (list 'FORALL 'acnv_ (list 'IMPLIES (list 'IS-OPEN acn-nfm 'acnv_)
  (list 'FORALL 'acnh_ (list 'IMPLIES '(IN acnh_ (FUN acnv_ CC)) (list 'IMPLIES (acn-cont 'acnv_ 'acnh_)
    (list 'FORALL 'acna_ (list 'IMPLIES '(IN acna_ acnv_)
      (list 'IMPLIES '(ZEROS-ACCUMULATE-AT acnv_ acnh_ acna_) '(= (acnh_ acna_) 0)))))))))))
(dk-peel!)
(let* ((v 'acnv_) (h 'acnh_) (a 'acna_) (S (acn-sub v)) (ha (list h a)) (mha (acn-mg ha))
       (dN (lambda (p q) (list (list 'DIST acn-nfm) p q)))
       (dC (lambda (p q) (list '(DIST CC-MS) p q)))
       (dS (lambda (p q) (list (list 'DIST S) p q))))
  (acn-ms! v)
  (fact 'subset-mem-fwd v 'CC a)
  (fact 'fun-apply-type-c h v 'CC a)
  (acn-ptcc! a) (acn-ptcc! ha)
  (acn-rr! mha)
  (fact 'cc-magnitude-nonneg ha)
  (dk-have! (list 'FORALL 'acnd_ (list 'IMPLIES '(POS-RR acnd_) (list '<= mha '(+ 0 acnd_))))
    (lambda ()
      (let* ((d (cadr (car (filter (lambda (f) (acn-op? f 'POS-RR 2)) (dk-peel!)))))
             (cN (dk-apply! (dk-ctx-form (acn-cont v h)) a))
             (iff (dk-cite! 'is-continuous-at S acn-nfm h a))
             (edf (let loop ((r (caddr iff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
        (fact 'rr-pos-rr-in-rr d)
        (dk-have! edf (lambda () (if (dk-only! iff cN) (prop))))
        (let* ((dl (dk-skolem! (dk-apply! edf d)))
               (cb (dk-pick (lambda (fm) (and (acn-op? fm 'FORALL 3) (dk-contains? fm dl))) "the continuity clause"))
               (zi (dk-cite! 'zeros-accumulate-at v h a))
               (zb (caddr zi)))
          (dk-have! zb (lambda () (prop)))
          (let* ((x (dk-skolem! (dk-apply! (dk-ctx-form zb) dl)))
                 (hx (list h x))
                 (bi (dk-cite! 'ball-membership 'CC-MS a dl x)))
            (dk-have! (caddr bi) (lambda () (prop)))
            (dk-split! (caddr bi))
            (fact 'subset-mem-fwd v 'CC x)
            (fact 'fun-apply-type-c h v 'CC x)
            (acn-ptcc! x) (acn-ptcc! hx)
            (fact 'nf-cc-agree-dist a x)
            (fact 'subspace-dist acn-nfm v a x)
            (dk-have! (list '<= (dS a x) dl)
              (lambda () (subst (list '= (dS a x) (dN a x))) (subst (list '= (dN a x) (dC a x))) (ass)))
            (dk-have! (list 'IN x (list 'PTS S)) (lambda () (subst (list '== (list 'PTS S) v)) (ass)))
            (dk-apply! cb x)
            (fact 'nf-cc-agree-dist ha hx)
            (fact 'cc-ms-dist ha hx)
            (let ((e1 (list '<= (acn-mg (list '- ha hx)) d)))
              (dk-have! e1
                (lambda () (subst (list '= (acn-mg (list '- ha hx)) (dC ha hx))) (subst (list '= (dC ha hx) (dN ha hx))) (ass)))
              (dk-rewrite-h! e1 hx 0)
              (dk-have! (list '= (list '- ha 0) ha) (lambda () (crs)))
              (dk-rewrite-h! (list '<= (acn-mg (list '- ha 0)) d) (list '- ha 0) ha)
              (dk-ineq! (list '<= mha d))))))))
  (dk-cite! 'rr-le-of-le-add-all-pos mha 0)
  (acn-and! (list 'IN mha 'RR) '(IN 0 RR))
  (acn-and! (list '<= mha 0) (list '<= 0 mha))
  (dk-cite! 'rr-leq-antisymmetric mha 0)
  (let ((zi (dk-cite! 'cc-magnitude-zero-iff ha)))
    (prop)))
(qed 'zeros-accumulate-value)

;;; ======================================================================
;;; (2) A SERIES OF ZEROS CONVERGES ONLY TO 0
;;; ======================================================================
(sp (make-wff '(FORALL acnt_ (IMPLIES (IN acnt_ (FUN NN CC))
  (IMPLIES (FORALL acnk_ (IMPLIES (IN acnk_ NN) (= (acnt_ acnk_) 0)))
    (FORALL acnl_ (IMPLIES (CC-SERIES-CONVERGES-TO acnt_ acnl_) (= acnl_ 0))))))))
(dk-peel!)
(define acn-2-ps '(FORALL acnk_ (IMPLIES (IN acnk_ NN) (= (CC-SERIES-PARTIAL-SUM acnt_ acnk_) 0))))
(dk-have! acn-2-ps
  (lambda ()
    (let* ((ind (use-induction))
           (k (cdr (assq 'var ind))))
      ;; step: partial(t, succ k) = partial(t, k) + t(k) = 0 + 0
      (fact 'cc-series-partial-sum-in-cc k 'acnt_)
      (fact 'fun-apply-type-c 'acnt_ 'NN 'CC k)
      (dk-apply! (dk-ctx-form '(FORALL acnk_ (IMPLIES (IN acnk_ NN) (= (acnt_ acnk_) 0)))) k)
      (fact 'cc-series-partial-sum-succ 'acnt_ k)
      (subst (list '= (list 'CC-SERIES-PARTIAL-SUM 'acnt_ (list 'succ k))
                      (list '+ (list 'CC-SERIES-PARTIAL-SUM 'acnt_ k) (list 'acnt_ k))))
      (subst (list '= (list 'CC-SERIES-PARTIAL-SUM 'acnt_ k) 0))
      (subst (list '= (list 'acnt_ k) 0))
      (crs)
      ;; base: partial(t, 0) = 0
      (dk-focus! (cdr (assq 'base ind)))
      (fact 'cc-series-partial-sum-zero 'acnt_)
      (subst '(= (CC-SERIES-PARTIAL-SUM acnt_ 0) 0))
      (rfl))))
(let* ((ci (dk-cite! 'cc-series-converges-to 'acnt_ 'acnl_))
       (cv (caddr ci))
       (ps (caddr cv))
       (cz (list 'CONVERGES-TO 'CC-MS ps 0)))
  (dk-have! cv (lambda () (prop)))
  (fact 'cc-is-metric-space) (acn-pts-cc!)
  (let* ((cvi (dk-cite! 'converges-to 'CC-MS ps 'acnl_)))
    (dk-have! (caddr cvi) (lambda () (prop)))
    (dk-split! (caddr cvi)))
  (dk-rewrite-h! (list 'IN ps '(FUN NN (PTS CC-MS))) '(PTS CC-MS) 'CC)
  (dk-rewrite-h! '(IN acnl_ (PTS CC-MS)) '(PTS CC-MS) 'CC)
  (fact 'cc-zero-in)
  (dk-have! cz
    (lambda ()
      (mac 'converges-to)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
                  (#t
                   (dk-peel!)
                   (fact 'nn-zero-in)
                   (ew 0)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'IN)
                           (ass)
                           (let ((j (cadr (car (filter (lambda (f) (and (acn-op? f 'IN 3) (eq? (caddr f) 'NN))) (dk-peel!))))))
                             (dk-lam-b!)
                             (dk-apply! (dk-ctx-form acn-2-ps) j)
                             (subst (list '= (list 'CC-SERIES-PARTIAL-SUM 'acnt_ j) 0))
                             (fact 'cc-ms-dist 0 0)
                             (subst '(= ((DIST CC-MS) 0 0) (magnitude (- 0 0))))
                             (dk-have! '(= (- 0 0) 0) (lambda () (crs)))
                             (subst '(= (- 0 0) 0))
                             (fact 'cc-magnitude-zero)
                             (subst '(= (magnitude 0) 0))
                             (let ((e (cadr (dk-pick (lambda (f) (acn-op? f 'POS-RR 2)) "eps"))))
                               (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
                               (dk-ineq! (list '< 0 e))))))))))))))
  (dk-cite! 'cc-limit-unique ps 'acnl_ 0)
  (ass))
(qed 'cc-series-of-zeros)
;;; ======================================================================
;;; (3) A POWER OF A NON-ZERO COMPLEX NUMBER IS NON-ZERO
;;; ======================================================================
(sp (make-wff '(FORALL acnn_ (IMPLIES (IN acnn_ NN) (FORALL acnt_ (IMPLIES (IN acnt_ CC)
  (IMPLIES (NOT (= acnt_ 0)) (NOT (= (power acnt_ acnn_) 0)))))))))
(let* ((ind (use-induction))
       (n (cdr (assq 'var ind))))
  ;; step
  (let* ((t (cadr (car (filter (lambda (f) (and (acn-op? f 'IN 3) (eq? (caddr f) 'CC))) (dk-peel!)))))
         (ih (cdr (assq 'ih ind))))
    (dk-apply! ih t)
    (acn-cc! (list 'power t n))
    (subst (acn-pow-succ! t n))
    (dk-cite! 'cc-mul-nonzero t (list 'power t n))
    (ass))
  ;; base
  (dk-focus! (cdr (assq 'base ind)))
  (let ((t (cadr (car (filter (lambda (f) (and (acn-op? f 'IN 3) (eq? (caddr f) 'CC))) (dk-peel!))))))
    (subst (dk-cite! 'power-zero t))
    (arith)))
(qed 'cc-power-nonzero)

;;; ======================================================================
;;; (4) AT AN ACCUMULATION POINT OF ITS ZEROS A HOLOMORPHIC FUNCTION IS DIVISIBLE BY
;;; EVERY POWER OF (x - a): h(x) = (x - a)^n q(x) with q holomorphic on v
;;; (the induction variable outermost, for `ni')
;;; ======================================================================
(define (acn-fac-body n v h a q)
  (list 'FORALL 'acnx_ (list 'IMPLIES (list 'IN 'acnx_ v)
    (list '= (list h 'acnx_) (list '* (list 'power (list '- 'acnx_ a) n) (list q 'acnx_))))))
(define acn-fac-stmt
  (list 'FORALL 'acnn_ (list 'IMPLIES '(IN acnn_ NN)
    (list 'FORALL 'acnv_ (list 'FORALL 'acnh_ (list 'IMPLIES '(HOLOMORPHIC-ON acnv_ acnh_)
      (list 'FORALL 'acna_ (list 'IMPLIES '(IN acna_ acnv_) (list 'IMPLIES '(ZEROS-ACCUMULATE-AT acnv_ acnh_ acna_)
        (list 'FORSOME 'acnq_ (list 'AND '(HOLOMORPHIC-ON acnv_ acnq_)
          (acn-fac-body 'acnn_ 'acnv_ 'acnh_ 'acna_ 'acnq_))))))))))))
;;; x in v (v open in context): x in CC
(define (acn-pt! v x) (fact 'subset-mem-fwd v 'CC x) (acn-need (list 'IN x 'CC) "a point typing"))
;;; x /= a, both in CC: x - a /= 0
(define (acn-sub-ne! x a) (acn-sub-nz! x a))

(sp (make-wff acn-fac-stmt))
(let* ((ind (use-induction))
       (n (cdr (assq 'var ind)))
       (ih (cdr (assq 'ih ind))))
  ;; ---- step: from q with h = (x - a)^n q to dq with h = (x - a)^(n+1) dq
  (let* ((ls (dk-peel!))
         (hh (dk-pick (lambda (f) (acn-op? f 'HOLOMORPHIC-ON 3)) "the holomorphy"))
         (v (cadr hh)) (h (caddr hh))
         (a (cadr (car (filter (lambda (f) (and (acn-op? f 'IN 3) (eq? (caddr f) v))) ls))))
         (_0 (begin (dk-cite! 'holomorphic-on-open v h) (dk-cite! 'cc-open-subset-cc v) (acn-pt! v a)))
         (q (dk-skolem! (dk-apply! ih v h a) 'top))
         (fq (acn-need (acn-fac-body n v h a q) "the factorisation at n")))
    (dk-cite! 'holomorphic-on-in-fun v q)
    (dk-cite! 'holomorphic-on-continuous v q)
    ;; the zeros of q accumulate at a
    (let* ((zi (dk-cite! 'zeros-accumulate-at v q a))
           (zh (caddr (dk-cite! 'zeros-accumulate-at v h a))))
      (dk-have! zh (lambda () (prop)))
      (dk-have! (caddr zi)
        (lambda ()
          (let* ((r (cadr (car (filter (lambda (f) (acn-op? f 'POS-RR 2)) (dk-peel!)))))
                 (x (dk-skolem! (dk-apply! (dk-ctx-form zh) r)))
                 (hx (list h x)) (qx (list q x)) (p (list 'power (list '- x a) n)))
            (acn-pt! v x)
            (fact 'fun-apply-type-c q v 'CC x)
            (acn-sub-ne! x a)
            (acn-cc! (list '- x a))
            (dk-cite! 'cc-power-nonzero n (list '- x a))
            (acn-need (list 'NOT (list '= p 0)) "the power non-zero")
            (acn-cc! p)
            (dk-apply! fq x)
            (let* ((pz (list '= (list '* p qx) 0))
                   (_ (dk-have! pz (lambda () (subst (list '= (list '* p qx) hx)) (ass)))))
              (let ((imp (dk-cite! 'cc-mul-nonzero p qx)))
                (ew x)
                (dk-conj-close!
                  (lambda ()
