              (lambda () (dk-if-branch! #f (list 'IF (acn-Z z) 0 1) #f (lambda () (rfl)))))
            (dk-have! (list '= (list 'IF (acn-Z 'a) 0 1) 0)
              (lambda () (dk-if-branch! #t (list 'IF (acn-Z 'a) 0 1) #f (lambda () (rfl)))))
            (dk-rewrite-h! e2 (list 'IF (acn-Z z) 0 1) 1)
            (dk-rewrite-h! (list '= 1 (list 'IF (acn-Z 'a) 0 1)) (list 'IF (acn-Z 'a) 0 1) 0)
            (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
            (if (dk-only! '(= 1 0) '(NOT (= 1 0))) (prop))))))
    (let* ((r (dk-skolem! (dk-cite! 'holomorphic-zeros-local 'u 'f z)))
           (fz (dk-pick (lambda (fm) (and (acn-op? fm 'FORALL 3) (dk-contains? fm r) (dk-contains? fm 'f))) "f = 0 on the ball")))
      (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
      (acn-center-in-ball! z r)
      (dk-apply! fz z)
      (ass))))
(qed 'holomorphic-identity-principle)

;;; ======================================================================
;;; (8) AN ANALYTIC FUNCTION ON AN OPEN SET IS HOLOMORPHIC THERE
;;; ======================================================================
(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u) (FORALL f (IMPLIES (IN f (FUN u CC))
  (IMPLIES (FORALL acnb_ (IMPLIES (IN acnb_ u) (IS-ANALYTIC-AT f u acnb_))) (HOLOMORPHIC-ON u f))))))))
(dk-peel!)
(let ((hi (dk-cite! 'holomorphic-on-iff-cc-ms 'u 'f)))
  (let ((oi (dk-cite! 'cc-ms-open-iff 'u)))
    (dk-have! (list 'IS-OPEN acn-nfm 'u) (lambda () (prop))))
  (dk-cite! 'cc-open-subset-cc 'u)
  (fact 'cc-is-metric-space) (acn-pts-cc!)
  (dk-have! (caddr (caddr (caddr hi)))
    (lambda ()
      (let* ((a (dk-di-var!))
             (_ (dk-apply! (dk-ctx-form '(FORALL acnb_ (IMPLIES (IN acnb_ u) (IS-ANALYTIC-AT f u acnb_)))) a))
             (r (dk-skolem! (dk-cite! 'analytic-holomorphic-ball 'f 'u a)))
             (B (list 'BALL 'CC-MS a r)) (rf (list 'RESTRICT 'f B)))
        (acn-pt! 'u a)
        (acn-center-in-ball! a r)
        (fact 'rr-pos-rr-in-rr r)
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list '= 0 r) (list '< 0 r))))
        (acn-and! (list 'IN r 'RR) (acn-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
        (acn-ptcc! a)
        (dk-cite! 'ball-is-open 'CC-MS a r)
        (let ((bi (dk-cite! 'cc-ms-open-iff B)))
          (dk-have! (list 'IS-OPEN acn-nfm B) (lambda () (if (dk-only! bi (list 'IS-OPEN 'CC-MS B)) (prop)))))
        (let ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff B rf) a))))
          (dk-cite! 'diff-on-local 'u 'f B a l)
          (ew l)
          (ass)))))
  (prop))
(qed 'analytic-on-holomorphic)

;;; ======================================================================
;;; (9) PROPOSITION 2.12 (Principle of Analytic Continuation), as the notes state it
;;; ======================================================================
(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u) (IMPLIES (IS-CONNECTED CC-MS u)
  (FORALL f (IMPLIES (IN f (FUN u CC))
    (IMPLIES (FORALL acnb_ (IMPLIES (IN acnb_ u) (IS-ANALYTIC-AT f u acnb_)))
      (IMPLIES (FORSOME a (AND (IN a u) (ZEROS-ACCUMULATE-AT u f a)))
        (FORALL z (IMPLIES (IN z u) (= (f z) 0))))))))))))
(dk-peel!)
(dk-cite! 'analytic-on-holomorphic 'u 'f)
(let ((a (dk-skolem! (dk-pick (lambda (fm) (acn-op? fm 'FORSOME 3)) "the accumulation point"))))
  (let ((z (cadr (cadr (dk-goal)))))
    (dk-cite! 'holomorphic-identity-principle 'u 'f a z)
    (ass)))
(qed 'analytic-continuation)
;;; ======================================================================
;;; (10) COROLLARY 2.13: an analytic function on a connected open u, not identically 0,
;;; has only finitely many zeros in each closed ball inside u.  No point of the ball is
;;; an accumulation point of the zeros (else f = 0 on u, analytic-continuation), so each
;;; x of the ball has a radius h(x) (a CHOICE among those that serve) whose ball holds no
;;; zero but possibly x; finitely many of these balls cover the compact ball
;;; (compact-cover-by-balls, cc-closed-ball-compact), so the zeros lie among their
;;; finitely many centres.
;;; ======================================================================
(define acn-D '(CLOSED-BALL CC-MS acnc_ acnr_))
(define (acn-qsep x)
  (list 'SEP 'acnq_ 'RR (list 'AND '(< 0 acnq_)
    (list 'FORALL 'acnw_ (list 'IMPLIES '(IN acnw_ u) (list 'IMPLIES (list 'IN 'acnw_ (list 'BALL 'CC-MS x 'acnq_))
      (list 'IMPLIES '(= (f acnw_) 0) (list '= 'acnw_ x))))))))
(define acn-h (list 'VNB-LAMBDA 'acnt_ acn-D (list 'CHOICE (acn-qsep 'acnt_))))
;;; x in u (NOT Z(x) available through the universal in context): the chosen radius, its
;;; positivity and its clause landed; returns it
(define (acn-rad-of! x)
  (let* ((sv (acn-qsep x)) (c (list 'CHOICE sv)))
    (if (not (dk-asm? (list 'IN c sv)))
        (let* ((nz (dk-apply! (dk-ctx-form (list 'FORALL 'acnx_ (list 'IMPLIES '(IN acnx_ u) (list 'NOT (acn-Z 'acnx_))))) x))
               (zi (dk-cite! 'zeros-accumulate-at 'u 'f x))
               (nb (list 'NOT (caddr zi))))
          (dk-have! nb (lambda () (prop)))
          (push-not-h nb)
          (let* ((ex (dk-pick (lambda (fm) (and (acn-op? fm 'FORSOME 3) (dk-contains? fm 'BALL) (dk-contains? fm x) (not (dk-contains? fm 'acnq_)))) "the radius"))
                 (r0 (dk-skolem! ex 'top))
                 (nz0 (dk-pick (lambda (fm) (and (acn-op? fm 'NOT 2) (dk-contains? fm r0))) "no zero in the punctured ball")))
            (push-not-h nz0)
            (let ((nzf (dk-pick (lambda (fm) (and (acn-op? fm 'FORALL 3) (dk-contains? fm r0) (dk-contains? fm 'NOT))) "no zero, pushed")))
              (fact 'rr-pos-rr-in-rr r0) (fact 'rr-lt-of-pos-rr r0)
              (dk-have! (list 'IN r0 sv)
                (lambda ()
                  (in-sep!
                    (lambda ()
                      (acn-csub-and!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (ass)
                              (let* ((ls (dk-peel!))
                                     (w (cadr (car (filter (lambda (fm) (and (acn-op? fm 'IN 3) (eq? (caddr fm) 'u))) ls)))))
                                (dk-apply! nzf w)
                                (prop)))))))))
              (dk-have! (list 'FORSOME 'acnz_ (list 'IN 'acnz_ sv)) (lambda () (ew r0) (ass)))
              (dk-cite! 'choice-axiom sv)
              (sep-me (list 'IN c sv))
              (dk-split-all!)))))
    c))
(define (acn-csub-and! closer)
  (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'AND))
      (for-each (lambda (k) (dk-focus! k) (acn-csub-and! closer))
                (dk-opened (lambda () (di))))
      (closer)))

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u) (IMPLIES (IS-CONNECTED CC-MS u)
  (FORALL f (IMPLIES (IN f (FUN u CC))
    (IMPLIES (FORALL acnb_ (IMPLIES (IN acnb_ u) (IS-ANALYTIC-AT f u acnb_)))
      (IMPLIES (FORSOME acne_ (AND (IN acne_ u) (NOT (= (f acne_) 0))))
        (FORALL acnc_ (IMPLIES (IN acnc_ CC) (FORALL acnr_ (IMPLIES (IN acnr_ RR)
          (IMPLIES (SUBSET (CLOSED-BALL CC-MS acnc_ acnr_) u)
            (IN (CARD (SEP acnz_ (CLOSED-BALL CC-MS acnc_ acnr_) (= (f acnz_) 0))) NN)))))))))))))))
(dk-peel!)
(dk-cite! 'analytic-on-holomorphic 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'cc-is-metric-space) (acn-pts-cc!)
(let* ((e (dk-skolem! (dk-pick (lambda (fm) (and (acn-op? fm 'FORSOME 3) (dk-contains? fm 'acne_))) "the non-zero value")))
       (D acn-D))
  (dk-have! (list 'FORALL 'acnx_ (list 'IMPLIES '(IN acnx_ u) (list 'NOT (acn-Z 'acnx_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (di)
        (dk-cite! 'holomorphic-identity-principle 'u 'f x e)
        (if (dk-only! (list '= (list 'f e) 0) (list 'NOT (list '= (list 'f e) 0))) (prop)))))
  (dk-cite! 'cc-closed-ball-compact 'acnc_ 'acnr_)
  (fact 'subset-trans D 'u 'CC)
  (fact 'cc-is-set)
  (fact 'subclass-of-set-is-set D 'CC)
  ;; the radius function on the ball
  (dk-have! (list 'IN acn-h (list 'FUN D 'RR))
    (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'subset-mem-fwd D 'u x) (acn-rad-of! x) (ass))))))
  (dk-have! (list 'FORALL 'wcvx_ (list 'IMPLIES (list 'IN 'wcvx_ D) (list '< 0 (list acn-h 'wcvx_))))
    (lambda () (let ((x (dk-di-var!))) (fact 'subset-mem-fwd D 'u x) (acn-rad-of! x) (if (not (dk-lam-b!)) (ass)))))
  (let* ((P (dk-skolem! (dk-cite! 'compact-cover-by-balls D acn-h)))
         (cov (dk-pick (lambda (fm) (and (acn-op? fm 'FORALL 3) (dk-contains? fm P) (dk-contains? fm 'BALL))) "the finite cover"))
         (zset (list 'SEP 'acnz_ D '(= (f acnz_) 0))))
    (fact 'subclass-of-set-is-set P D)
    (dk-have! (list 'IN zset 'SET) (lambda () (sep-set) (ass)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z zset) (list 'IN 'z P)))
      (lambda ()
        (let* ((z (dk-di-var!)))
          (sep-me (list 'IN z zset))
          (dk-split-all!)
          (fact 'subset-mem-fwd D 'u z)
          (let* ((x (dk-skolem! (dk-apply! cov z) 'top)))
            (fact 'subset-mem-fwd P D x)
            (fact 'subset-mem-fwd D 'u x)
            (dk-lam-b-h! (list 'IN z (list 'BALL 'CC-MS x (list acn-h x))))
            (let ((c (acn-rad-of! x)))
              (dk-apply! (dk-pick (lambda (fm) (and (acn-op? fm 'FORALL 3) (dk-contains? fm c) (dk-contains? fm 'u) (not (dk-contains? fm 'SEP-NEVER))
                                                    (not (equal? fm (list 'FORALL 'acnx_ (list 'IMPLIES '(IN acnx_ u) (list 'NOT (acn-Z 'acnx_))))))))
                                  "the radius clause at x")
                         z)
              (subst (list '= z x))
              (ass))))))
    (acn-and! (list 'IN P 'SET) (list 'IN (list 'CARD P) 'NN))
    (acn-and! (list 'IN zset 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z zset) (list 'IN 'z P))))
    (dk-cite! 'card-subset-nn P zset)
    (ass)))
(qed 'analytic-zeros-finite-in-ball)
