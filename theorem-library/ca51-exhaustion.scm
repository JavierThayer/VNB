;;; ca51-exhaustion.scm -- Lemma 5.1 of the complex analysis notes: a separable locally compact
;;; metric space has an exhaustive sequence of compact sets (CA-51, 2026-10-26).
;;; Destination: theorem-library/ca51-exhaustion.scm, library analysis.
;;;
;;;   closed-ball-in-closed-ball  d(a, c) + r <= R ==> B'(c, r) subset B'(a, R)
;;;   nn-recip-succ-gap-pos                   1/(n+1) - 1/(n+2) > 0
;;;   lx5-least-radius                for a sequence dq of points of a locally compact s, a
;;;                                   g : NN -> NN with B'(dq(k), 1/(g(k)+1)) compact and g(k)
;;;                                   LEAST such (countable choice + nn-least-element)
;;;   lx5-pieces                      the sets K_n = U_{i <= n} B'(dq(i), 1/(g(i)+1) - 1/(n+1)):
;;;                                   a sequence of compact subsets, with their membership
;;;   locally-compact-separable-exhaustion   LEMMA 5.1
;;;
;;; THE CONSTRUCTION.  dq is the dense sequence of IS-SEPARABLE; rho_i = 1/(g(i)+1) is the
;;; largest radius of the form 1/(m+1) with B'(dq(i), 1/(m+1)) compact.  K_n is the union over
;;; i <= n of the closed balls B'(dq(i), rho_i - 1/(n+1)).
;;;   compact      a finite union (compact-finite-union) of closed subsets of the compact
;;;                balls B'(dq(i), rho_i) (closed-in-compact-subset);
;;;   interior     the radii grow by 1/(n+1) - 1/(n+2) from K_n to K_{n+1}, uniformly in i, so
;;;                the open ball of that radius about a point of K_n lies in K_{n+1};
;;;   covering     x has a compact B'(x, r); take 1/(m+1) < r/2 and dq(k) within 1/(m+1) of x:
;;;                B'(dq(k), 1/(m+1)) lies in B'(x, r), so it is compact, so rho_k >= 1/(m+1) >
;;;                d(dq(k), x), and x lies in K_n once 1/(n+1) <= rho_k - d(dq(k), x), n >= k;
;;;   exhaustive   a compact A not inside any K_n gives a_n in A \ K_n; a cluster point x of
;;;                (a_n) lies in some K_m, the ball of the uniform radius about x lies in K_{m+1},
;;;                and some a_j, j >= m+1, lies in that ball, hence in K_j: contradiction.
;;; The "interior" clause is stated in the UNIFORM form of IS-COMPACT-EXHAUSTION (ca51-vocab.scm),
;;; without the INTERIOR functoid.
;;;
;;; Library: analysis.  LOAD WINDOW: lo = after theorem-library/ca51-compact-laws (itself after
;;; riesz-markov-model, load.scm:3048) and after theorem-library/r-exp (load.scm:3347,
;;; rr-recip-recip-pos); the vocabulary structure-library/ca51-vocab before it.  Other citations
;;; load earlier (nn-least-element 1775, metric-closure-laws 1660, sequential-continuity 2647).
;;; hi = before ca51-cc.  Also here, general: compact-subset-of-subspace-iff,
;;; subspace-closed-ball-eq, open-subspace-locally-compact, dense-seq-separable,
;;; separable-of-full-subspace, closed-ball-in-closed-ball, nn-recip-succ-gap-pos.
;;; Helper prefix lx5-.
;;; ======================================================================
(define (lx5-set! t)
  (if (not (dk-asm? (list 'IN t 'SET)))
      (dk-have! (list 'IN t 'SET) (lambda () (dk-sethood! t)))))
(define (lx5-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (if (not (dk-asm? (list 'AND (list 'IN a 'NN) (list 'IN b 'NN))))
            (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close!))))
        (fact 'nn-add-closed a b))))
;; recip(m + 1) in RR and 0 < recip(m + 1), m in NN in context
(define (lx5-rad! m)
  (let ((r (list 'recip (list '+ m 1))))
    (if (not (dk-asm? (list 'IN r 'RR)))
        (begin
          (dk-cite! 'nn-recip-succ-pos m)
          (fact 'rr-pos-rr-in-rr r)
          (fact 'rr-lt-of-pos-rr r)))
    r))
;; d(a, b) in RR
(define (lx5-dist! s a b)
  (let ((d (list (list 'DIST s) a b)))
    (if (not (dk-asm? (list 'IN d 'RR))) (dk-cite! 'metric-dist-real s a b))
    d))
;; one beta step on the goal (the outer redex), closing the owed typings the context holds
(define (lx5-beta!)
  (let ((leaf0 (proof-state-focus *ps*)))
    (dk--close-owed-typings! (lambda () (lam-b)))
    (sequent-node-grounded? leaf0)))

;;; ======================================================================
;;; (1) closed balls inside closed balls; the gap 1/(n+1) - 1/(n+2)
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL ca (IMPLIES (IN ca (PTS s))
    (FORALL cb (IMPLIES (IN cb (PTS s))
      (FORALL ra (IMPLIES (IN ra RR)
        (FORALL rb (IMPLIES (IN rb RR)
          (IMPLIES (<= (+ ((DIST s) ca cb) rb) ra)
            (SUBSET (CLOSED-BALL s cb rb) (CLOSED-BALL s ca ra)))))))))))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (let ((m1 (dk-cite! 'closed-ball-membership 's 'cb 'rb z)))
    (dk-have! (caddr m1) (lambda () (prop)))
    (dk-split-all! (list (caddr m1))))
  (lx5-dist! 's 'ca 'cb) (lx5-dist! 's 'cb z) (lx5-dist! 's 'ca z)
  (dk-cite! 'metric-triangle 's 'ca 'cb z)
  (dk-have! (list '<= (list '(DIST s) 'ca z) 'ra)
    (lambda () (dk-ineq! (list '<= (list '(DIST s) 'ca z) (list '+ (list '(DIST s) 'ca 'cb) (list '(DIST s) 'cb z)))
                         (list '<= (list '(DIST s) 'cb z) 'rb)
                         (list '<= (list '+ (list '(DIST s) 'ca 'cb) 'rb) 'ra))))
  (dk-cite! 'closed-ball-membership 's 'ca 'ra z)
  (prop))
(qed 'closed-ball-in-closed-ball)
(topic! 'closed-ball-in-closed-ball 'topology)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (POS-RR (- (recip (+ n 1)) (recip (+ (+ n 1) 1))))))))
(dk-peel!)
(fact 'nn-one-in)
(lx5-nn-add! 'n 1)
(let* ((a '(+ n 1)) (b '(+ (+ n 1) 1)) (ra (lx5-rad! 'n)) (rb (lx5-rad! a)))
  (fact 'nn-in-rr 'n)
  (fact 'nn-zero-le 'n)
  (fact 'rr-one-in)
  (fact 'rr-add-in-rr 'n 1)
  (fact 'rr-add-in-rr a 1)
  (dk-have! (list '< 0 a) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! (list '< 0 b) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! (list '<= a b) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-recip-antitone a b)
  (dk-cite! 'rr-recip-recip-pos a)
  (dk-cite! 'rr-recip-recip-pos b)
  (dk-have! (list 'NOT (list '= rb ra))
    (lambda ()
      (di)
      (dk-have! (list '= b a)
        (lambda ()
          (subst (list '= b (list 'recip rb)))
          (subst (list '= rb ra))
          (ass)))
      (dk-absurd! (list '= b a))))
  (dk-have! (list 'AND (list '<= rb ra) (list 'NOT (list '= rb ra))) (lambda () (dk-conj-close!)))
  (fact 'rr-le-ne-lt rb ra)
  (let ((d (list '- ra rb)))
    (fact 'rr-sub-in-rr ra rb)
    (let ((pi (dk-cite! 'pos-rr d)))
      (dk-have! (caddr pi)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-asm? g) (ass))
                      ((dk-head-is? g '<=) (dk-ineq! (list '< rb ra)))
                      (#t (di) (dk-absurd! (list '= 0 d) (list '< rb ra)))))))))
      (prop))))
(qed 'nn-recip-succ-gap-pos)
(topic! 'nn-recip-succ-gap-pos 'plumbing)

;;; ======================================================================
;;; (2) the least compact radius at each point of a sequence (countable choice)
;;; ======================================================================
(define lx5-seq-family '())
(define (lx5-choose-seq! A Pf witness-of)
  (let* ((lfam (list 'VNB-LAMBDA 'lx5k_ 'NN (list 'SEP 'lx5w_ A (Pf 'lx5k_ 'lx5w_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list lfam 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let* ((wc (witness-of k)) (w (car wc)) (closer (cdr wc)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (for-each (lambda (lv)
                                (if (memq lv (dk-open-leaves))
                                    (begin (dk-focus! lv)
                                           (if (dk-asm? (dk-goal)) (ass) (closer)))))
                              (dk-opened (lambda () (sep-mi))))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A lfam))))
      (set! lx5-seq-family (cons (cons g lfam) lx5-seq-family))
      g)))
(define (lx5-seq-at! g k)
  (let* ((lfam (cdr (assq g lx5-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list lfam 'k))))))
         (h  (dk-apply! (or cl (error "lx5-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
(define (lx5-adm s dq k m)
  (list 'IS-COMPACT (list 'SUBSPACE-MS s (list 'CLOSED-BALL s (list dq k) (list 'recip (list '+ m 1))))))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-LOCALLY-COMPACT s)
  (list 'FORALL 'dq (list 'IMPLIES '(IN dq (FUN NN (PTS s)))
    (list 'FORSOME 'gr (list 'AND '(IN gr (FUN NN NN))
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
        (list 'AND (lx5-adm 's 'dq 'k '(gr k))
          (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
            (list 'IMPLIES (lx5-adm 's 'dq 'k 'j) '(<= (gr k) j)))))))))))))))
(dk-peel!)
(let ((li (dk-cite! 'is-locally-compact 's)))
  (dk-have! (caddr li) (lambda () (prop)))
  (dk-split-all! (list (caddr li))))
(define lx5-3-lc (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CLOSED-BALL))) "the local compactness clause"))
(fact 'nn-zero-in)
(let ((g (lx5-choose-seq! 'NN
           (lambda (k w)
             (list 'AND (lx5-adm 's 'dq k w)
                   (list 'FORALL 'lx5j_ (list 'IMPLIES '(IN lx5j_ NN)
                     (list 'IMPLIES (lx5-adm 's 'dq k 'lx5j_) (list '<= w 'lx5j_))))))
           (lambda (k)
             (fact 'fun-apply-type-c 'dq 'NN '(PTS s) k)
             (let* ((dk (list 'dq k))
                    (r (dk-skolem! (dk-apply! lx5-3-lc dk)))
                    (_ (dk-split-all!))
                    (_r (fact 'rr-pos-rr-in-rr r))
                    (m0 (dk-skolem! (dk-cite! 'nn-recip-succ-small r)))
                    (_s (dk-split-all!))
                    (rm (lx5-rad! m0))
                    (kc (list 'CLOSED-BALL 's dk r))
                    (ka (list 'CLOSED-BALL 's dk rm)))
               (dk-cite! 'closed-ball-in-carrier 's dk r)
               (dk-cite! 'closed-ball-is-closed 's dk rm)
               (dk-cite! 'metric-self-zero 's dk)
               (lx5-dist! 's dk dk)
               (dk-have! (list '<= (list '+ (list '(DIST s) dk dk) rm) r)
                 (lambda () (dk-ineq! (list '= (list '(DIST s) dk dk) 0) (list '< rm r))))
               (dk-cite! 'closed-ball-in-closed-ball 's dk dk r rm)
               (dk-cite! 'closed-in-compact-subset 's kc ka)
               ;; the least admissible index
               (let* ((tt (list 'SEP 'lx5m_ 'NN (lx5-adm 's 'dq k 'lx5m_))))
                 (dk-have! (list 'AND (list 'SUBSET tt 'NN) (list 'FORSOME 'lx5n_ (list 'IN 'lx5n_ tt)))
                   (lambda ()
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'SUBSET)
                             (let ((z (subset-by-element!)))
                               (sep-me (list 'IN z tt))
                               (ass))
                             (begin
                               (ew m0)
                               (for-each (lambda (lv)
                                           (if (memq lv (dk-open-leaves))
                                               (begin (dk-focus! lv) (ass))))
                                         (dk-opened (lambda () (sep-mi))))))))))
                 (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tt)))
                        (least (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'lx5m_) (dk-contains? fm m))) "the least clause")))
                   (sep-me (list 'IN m tt))
                   (cons m
                         (lambda ()
                           (dk-conj-close!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (ass)
                                   (let* ((landed (dk-peel!))
                                          (j (dk-landed-var landed 'NN)))
                                     (dk-have! (list 'IN j tt)
                                       (lambda ()
                                         (for-each (lambda (lv)
                                                     (if (memq lv (dk-open-leaves))
                                                         (begin (dk-focus! lv) (ass))))
                                                   (dk-opened (lambda () (sep-mi))))))
                                     (dk-apply! least j)
                                     (ass))))))))))))))
  (ew g)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let ((k (dk-di-var!)))
            (lx5-seq-at! g k)
            (dk-conj-close!))))))
(qed 'lx5-least-radius)
(topic! 'lx5-least-radius 'topology)

;;; ======================================================================
;;; (3) the pieces: K_n = U_{i <= n} B'(dq(i), 1/(g(i)+1) - 1/(n+1))
;;; ======================================================================
(define (lx5-rad i n) (list '- (list 'recip (list '+ (list 'gr i) 1)) (list 'recip (list '+ n 1))))
(define (lx5-fam n) (list 'VNB-LAMBDA 'lx5i_ 'NN (list 'CLOSED-BALL 's '(dq lx5i_) (lx5-rad 'lx5i_ n))))
(define lx5-K
  (list 'VNB-LAMBDA 'lx5n_ 'NN
        (list 'SEP 'ucy_ '(PTS s)
              (list 'FORSOME 'uci_ (list 'AND '(IN uci_ NN) (list 'AND '(<= uci_ lx5n_)
                                         (list 'IN 'ucy_ (list (lx5-fam 'lx5n_) 'uci_))))))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
  (list 'FORALL 'dq (list 'IMPLIES '(IN dq (FUN NN (PTS s)))
    (list 'FORALL 'gr (list 'IMPLIES '(IN gr (FUN NN NN))
      (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (lx5-adm 's 'dq 'k '(gr k))))
        (list 'FORSOME 'kx (list 'AND '(IN kx (FUN NN (POWER (PTS s))))
          (list 'AND '(FORALL n (IMPLIES (IN n NN) (IS-COMPACT (SUBSPACE-MS s (kx n)))))
            (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
              (list 'FORALL 'y (list 'IFF '(IN y (kx n))
                (list 'AND '(IN y (PTS s))
                  (list 'FORSOME 'i (list 'AND '(IN i NN) (list 'AND '(<= i n)
                    (list '<= '((DIST s) (dq i) y) (lx5-rad 'i 'n))))))))))))))))))))))
(dk-peel!)
(define lx5-4-adm (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-COMPACT))) "the admissibility clause"))
(lx5-set! '(PTS s))
;; i in NN, n in NN in context: the radius typed, rho_i and 1/(n+1) positive
(define (lx5-rad-typ! i n)
  (fact 'fun-apply-type-c 'gr 'NN 'NN i)
  (let* ((ri (lx5-rad! (list 'gr i)))
         (rn (lx5-rad! n))
         (rd (lx5-rad i n)))
    (if (not (dk-asm? (list 'IN rd 'RR))) (fact 'rr-sub-in-rr ri rn))
    rd))
;; y in B'(dq(i), rad): y in PTS(s) and d(dq(i), y) <= rad, by closed-ball-membership
(define (lx5-cb-iff! i rd y)
  (dk-cite! 'closed-ball-membership 's (list 'dq i) rd y))
(ew lx5-K)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ;; the typing: each K_n is a subset of PTS(s)
        ((dk-head-is? g 'IN)
         (dk-lam-type!
           (lambda ()
             (let* ((n (dk-di-var!))
                    (sepn (cadr (dk-goal))))
               (lx5-set! sepn)
               (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sepn) '(IN z_ (PTS s))))
                 (lambda ()
                   (let ((z (dk-di-var!)))
                     (sep-me (list 'IN z sepn))
                     (ass))))
               (dk-cite! 'power-mem-intro '(PTS s) sepn)
               (ass)))))
        ;; compactness: compact-finite-union over the closed balls
        ((dk-contains? g 'IS-COMPACT)
         (let ((n (dk-di-var!)))
           (lx5-beta!)
           (let ((ch (dk-cite! 'compact-finite-union n 's (lx5-fam n))))
             (dk-chain! ch
               (lambda (ante)
                 (lambda ()
                   (let ((i (dk-di-var!)))
                     (di)
                     (lx5-beta!)
                     (fact 'fun-apply-type-c 'dq 'NN '(PTS s) i)
                     (let* ((rd (lx5-rad-typ! i n))
                            (ri (list 'recip (list '+ (list 'gr i) 1)))
                            (di_ (list 'dq i)))
                       (dk-cite! 'closed-ball-in-carrier 's di_ rd)
                       (if (dk-head-is? (dk-goal) 'SUBSET)
                           (ass)
                           (let ((kc (list 'CLOSED-BALL 's di_ ri))
                                 (ka (list 'CLOSED-BALL 's di_ rd)))
                             (dk-cite! 'closed-ball-in-carrier 's di_ ri)
                             (dk-apply! lx5-4-adm i)
                             (dk-cite! 'closed-ball-is-closed 's di_ rd)
                             (dk-cite! 'metric-self-zero 's di_)
                             (lx5-dist! 's di_ di_)
                             (dk-have! (list '<= (list '+ (list '(DIST s) di_ di_) rd) ri)
                               (lambda () (dk-ineq! (list '= (list '(DIST s) di_ di_) 0)
                                                    (list '< 0 (list 'recip (list '+ n 1))))))
                             (dk-cite! 'closed-ball-in-closed-ball 's di_ di_ ri rd)
                             (dk-cite! 'closed-in-compact-subset 's kc ka)
                             (ass)))))))))
           (ass)))
        ;; membership
        (#t
         (let* ((landed (dk-peel!))
                (n (dk-landed-var landed 'NN))
                (y (cadr (cadr (dk-goal)))))
           (dk-iff! (dk-head? 'AND)
             (lambda ()
               (let ((mem (dk-pick (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (cadr fm) y) (dk-contains? fm 'VNB-LAMBDA))) "y in K_n")))
                 (dk-lam-b-h! mem))
               (let ((mem2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (cadr fm) y) (dk-head-is? (caddr fm) 'SEP))) "y in the union")))
                 (sep-me mem2))
               (let* ((i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm y))) "the piece of y"))))
                 (dk-split-all!)
                 (let ((memi (dk-pick (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (cadr fm) y) (dk-contains? fm 'VNB-LAMBDA))) "y in the piece")))
                   (dk-lam-b-h! memi))
                 (fact 'fun-apply-type-c 'dq 'NN '(PTS s) i)
                 (let ((rd (lx5-rad-typ! i n)))
                   (lx5-cb-iff! i rd y)
                   (dk-have! (list '<= (list '(DIST s) (list 'dq i) y) rd) (lambda () (prop)))
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (begin (ew i) (dk-conj-close!))))))))
             (lambda ()
               (dk-split-all!)
               (let ((i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm y))) "the index"))))
                 (dk-split-all!)
                 (fact 'fun-apply-type-c 'dq 'NN '(PTS s) i)
                 (let ((rd (lx5-rad-typ! i n)))
                   (lx5-beta!)
                   (for-each
                     (lambda (lv)
                       (if (memq lv (dk-open-leaves))
                           (begin
                             (dk-focus! lv)
                             (if (dk-asm? (dk-goal))
                                 (ass)
                                 (begin
                                   (ew i)
                                   (dk-conj-close!
                                     (lambda ()
                                       (if (dk-asm? (dk-goal))
                                           (ass)
                                           (begin
                                             (lx5-beta!)
                                             (lx5-cb-iff! i rd y)
                                             (prop))))))))))
                     (dk-opened (lambda () (sep-mi))))))))))))))
(qed 'lx5-pieces)
(topic! 'lx5-pieces 'topology)

;;; ======================================================================
;;; (4) LEMMA 5.1: a separable locally compact metric space has an exhaustive
;;;     sequence of compact sets
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-LOCALLY-COMPACT s) (IMPLIES (IS-SEPARABLE s)
  (FORSOME kx (IS-COMPACT-EXHAUSTION s kx)))))))
(dk-peel!)
(let ((li (dk-cite! 'is-locally-compact 's)))
  (dk-have! (caddr li) (lambda () (prop)))
  (dk-split-all! (list (caddr li))))
(define lx5-lc (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CLOSED-BALL))) "the local compactness clause"))
(let ((si (dk-cite! 'is-separable 's)))
  (dk-have! (caddr si) (lambda () (prop)))
  (dk-split-all! (list (caddr si))))
(define lx5-dq (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'FUN))) "the dense sequence")))
(define lx5-dense (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm lx5-dq))) "the density clause"))
(define lx5-gr (dk-skolem! (dk-cite! 'lx5-least-radius 's lx5-dq)))
(define lx5-lr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm lx5-gr))) "the least-radius clause"))
(define (lx5-adm-g k) (lx5-adm 's lx5-dq k (list lx5-gr k)))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (lx5-adm-g 'k)))
  (lambda ()
    (let ((k (dk-di-var!)))
      (dk-split-all! (list (dk-apply! lx5-lr k)))
      (ass))))
(define lx5-kx (dk-skolem! (dk-cite! 'lx5-pieces 's lx5-dq lx5-gr)))
(define lx5-mem (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IFF) (dk-contains? fm lx5-kx))) "the membership clause"))
(fact 'nn-one-in)
(fact 'nn-zero-in)
;; the radius of piece i at stage n, and its typing
(define (lx5-rho i) (list 'recip (list '+ (list lx5-gr i) 1)))
(define (lx5-radk i n) (list '- (lx5-rho i) (list 'recip (list '+ n 1))))
(define (lx5-radk-typ! i n)
  (fact 'fun-apply-type-c lx5-gr 'NN 'NN i)
  (lx5-rad! (list lx5-gr i))
  (lx5-rad! n)
  (let ((rd (lx5-radk i n)))
    (if (not (dk-asm? (list 'IN rd 'RR))) (fact 'rr-sub-in-rr (lx5-rho i) (list 'recip (list '+ n 1))))
    rd))
;; y in K_n in context: land y in PTS(s), and i in NN, i <= n, d(dq(i), y) <= rad(i, n); return i
(define (lx5-open-mem! n y)
  (let ((iff (dk-apply! lx5-mem n y)))
    (dk-have! (caddr iff) (lambda () (prop)))
    (dk-split-all! (list (caddr iff)))
    (let ((i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm y) (dk-contains? fm n))) "the piece"))))
      (dk-split-all!)
      (fact 'fun-apply-type-c lx5-dq 'NN '(PTS s) i)
      i)))
;; close (IN y K_n) from y in PTS(s) and d(dq(i), y) <= rad(i, n) proved by PROVE-LE
(define (lx5-close-mem! n y i prove-le)
  (let ((iff (dk-apply! lx5-mem n y)))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (ew i)
                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond ((dk-asm? g) (ass))
                              ((and (dk-head-is? g '<=) (memq (cadr g) (list i)) ) (dk-nn!))
                              ((dk-head-is? g '<=) (prove-le))
                              (#t (ass))))))))))))
    (prop)))

;;; monotonicity: K_a subset K_b for a <= b
(define lx5-mono
  (list 'FORALL 'lxa_ (list 'IMPLIES '(IN lxa_ NN) (list 'FORALL 'lxb_ (list 'IMPLIES '(IN lxb_ NN)
    (list 'IMPLIES '(<= lxa_ lxb_) (list 'SUBSET (list lx5-kx 'lxa_) (list lx5-kx 'lxb_))))))))
(dk-have! lx5-mono
  (lambda ()
    (let* ((landed (dk-peel!))
           (ab (car (filter (dk-head? '<=) landed)))
           (a (cadr ab)) (b (caddr ab))
           (y (subset-by-element!))
           (i (lx5-open-mem! a y))
           (ra (lx5-radk-typ! i a))
           (rb (lx5-radk-typ! i b)))
      (dk-cite! 'nn-recip-succ-antitone a b)
      (lx5-dist! 's (list lx5-dq i) y)
      (dk-have! (list '<= i b) (lambda () (dk-nn! (list '<= i a) ab)))
      (lx5-close-mem! b y i
        (lambda ()
          (dk-ineq! (list '<= (list (list 'DIST 's) (list lx5-dq i) y) ra)
                    (list '<= (list 'recip (list '+ b 1)) (list 'recip (list '+ a 1)))))))))

;;; the interior clause, uniform radius 1/(n+1) - 1/(n+2)
(define lx5-inter
  (list 'FORALL 'cen_ (list 'IMPLIES '(IN cen_ NN)
    (list 'FORSOME 'cer_ (list 'AND '(POS-RR cer_)
      (list 'FORALL 'cey_ (list 'IMPLIES (list 'IN 'cey_ (list lx5-kx 'cen_))
        (list 'SUBSET '(BALL s cey_ cer_) (list lx5-kx '(+ cen_ 1))))))))))
(dk-have! lx5-inter
  (lambda ()
    (let* ((n (dk-di-var!))
           (n1 (list '+ n 1))
           (e (list '- (list 'recip n1) (list 'recip (list '+ n1 1)))))
      (lx5-nn-add! n 1)
      (dk-cite! 'nn-recip-succ-gap-pos n)
      (fact 'rr-pos-rr-in-rr e)
      (ew e)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((y (dk-di-var!))
                     (i (lx5-open-mem! n y))
                     (z (subset-by-element!))
                     (bi (dk-cite! 'ball-membership 's y e z)))
                (dk-have! (caddr bi) (lambda () (prop)))
                (dk-split-all! (list (caddr bi)))
                (let* ((di_ (list lx5-dq i))
                       (rn (lx5-radk-typ! i n))
                       (rn1 (lx5-radk-typ! i n1)))
                  (lx5-dist! 's di_ y) (lx5-dist! 's y z) (lx5-dist! 's di_ z)
                  (dk-cite! 'metric-triangle 's di_ y z)
                  (dk-have! (list '<= i n1) (lambda () (dk-nn! (list '<= i n))))
                  (lx5-close-mem! n1 z i
                    (lambda ()
                      (dk-ineq! (list '<= (list '(DIST s) di_ z) (list '+ (list '(DIST s) di_ y) (list '(DIST s) y z)))
                                (list '<= (list '(DIST s) di_ y) rn)
                                (list '<= (list '(DIST s) y z) e))))))))))))

;;; the covering clause
(define lx5-cover
  (list 'FORALL 'cex_ (list 'IMPLIES '(IN cex_ (PTS s))
    (list 'FORSOME 'cen_ (list 'AND '(IN cen_ NN) (list 'IN 'cex_ (list lx5-kx 'cen_)))))))
(dk-have! lx5-cover
  (lambda ()
    (let* ((x (dk-di-var!))
           (rx (dk-skolem! (dk-apply! lx5-lc x)))
           (_1 (dk-split-all!))
           (h (dk-halve! rx))
           (m (dk-skolem! (dk-cite! 'nn-recip-succ-small h)))
           (_2 (dk-split-all!))
           (rm (lx5-rad! m))
           (k (dk-skolem! (dk-apply! lx5-dense x rm)))
           (_3 (dk-split-all!))
           (dk (list lx5-dq k))
           (kc (list 'CLOSED-BALL 's x rx))
           (ka (list 'CLOSED-BALL 's dk rm)))
      (fact 'rr-pos-rr-in-rr rx)
      (fact 'fun-apply-type-c lx5-dq 'NN '(PTS s) k)
      (lx5-dist! 's x dk)
      (lx5-dist! 's dk x)
      (dk-cite! 'metric-sym 's x dk)
      ;; B'(dq(k), 1/(m+1)) lies in B'(x, rx), so it is compact
      (dk-cite! 'closed-ball-in-carrier 's x rx)
      (dk-cite! 'closed-ball-is-closed 's dk rm)
      (dk-have! (list '<= (list '+ (list '(DIST s) x dk) rm) rx)
        (lambda () (dk-ineq! (list '< (list '(DIST s) x dk) rm) (list '< rm h) (list '= (list '+ h h) rx))))
      (dk-cite! 'closed-ball-in-closed-ball 's x dk rx rm)
      (dk-cite! 'closed-in-compact-subset 's kc ka)
      ;; so rho_k >= 1/(m+1) > d(dq(k), x)
      (dk-split-all! (list (dk-apply! lx5-lr k)))
      (let ((least (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list lx5-gr k)) (dk-contains? fm 'IMPLIES))) "the least clause at k")))
        (dk-apply! least m))
      (fact 'fun-apply-type-c lx5-gr 'NN 'NN k)
      (let* ((rho (lx5-rho k))
             (_4 (lx5-rad! (list lx5-gr k)))
             (_5 (dk-cite! 'nn-recip-succ-antitone (list lx5-gr k) m))
             (del (list '- rho (list '(DIST s) dk x))))
        (fact 'rr-sub-in-rr rho (list '(DIST s) dk x))
        (let ((pi (dk-cite! 'pos-rr del)))
          (dk-have! (caddr pi)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond ((dk-asm? g) (ass))
                          ((dk-head-is? g '<=)
                           (dk-ineq! (list '= (list '(DIST s) x dk) (list '(DIST s) dk x))
                                     (list '< (list '(DIST s) x dk) rm)
                                     (list '<= rm rho)))
                          (#t (di)
                              (dk-absurd! (list '= 0 del)
                                          (list '= (list '(DIST s) x dk) (list '(DIST s) dk x))
                                          (list '< (list '(DIST s) x dk) rm)
                                          (list '<= rm rho)))))))))
          (dk-have! (list 'POS-RR del) (lambda () (prop))))
        (let* ((n0 (dk-skolem! (dk-cite! 'nn-recip-succ-small del)))
               (_6 (dk-split-all!))
               (n (list '+ n0 k)))
          (lx5-nn-add! n0 k)
          (dk-have! (list '<= n0 n) (lambda () (dk-nn!)))
          (dk-cite! 'nn-recip-succ-antitone n0 n)
          (lx5-radk-typ! k n)
          (lx5-rad! n0)
          (dk-have! (list '<= k n) (lambda () (dk-nn!)))
          (ew n)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (lx5-close-mem! n x k
                    (lambda ()
                      (dk-ineq! (list '< (list 'recip (list '+ n0 1)) del)
                                (list '<= (list 'recip (list '+ n 1)) (list 'recip (list '+ n0 1))))))))))))))

;;; the exhaustion clause
(define lx5-exh
  (list 'FORALL 'cea_ (list 'IMPLIES '(SUBSET cea_ (PTS s))
    (list 'IMPLIES '(IS-COMPACT (SUBSPACE-MS s cea_))
      (list 'FORSOME 'cen_ (list 'AND '(IN cen_ NN) (list 'SUBSET 'cea_ (list lx5-kx 'cen_))))))))
(dk-have! lx5-exh
  (lambda ()
    (let* ((landed (dk-peel!))
           (a (cadr (car (filter (dk-head? 'SUBSET) landed))))
           (pp (dk-goal)))
      (use-em pp
        (lambda () (ass))
        (lambda ()
          (let* ((g (lx5-choose-seq! a
                      (lambda (k w) (list 'NOT (list 'IN w (list lx5-kx k))))
                      (lambda (k)
                        (fact 'fun-apply-type-c lx5-kx 'NN '(POWER (PTS s)) k)
                        (let ((nf (list 'NOT (list 'FORALL 'lx5x_ (list 'IMPLIES (list 'IN 'lx5x_ a) (list 'IN 'lx5x_ (list lx5-kx k)))))))
                          (dk-have! nf
                            (lambda ()
                              (di)
                              (dk-cite! 'subset-def a (list lx5-kx k))
                              (dk-have! (list 'SUBSET a (list lx5-kx k)) (lambda () (prop)))
                              (dk-have! pp (lambda () (ew k) (dk-conj-close!)))
                              (ai (or (dk-ctx-form (list 'NOT pp)) (error "lx5: no NOT P in context")))))
                          (let* ((ex (car (dk-landed (lambda () (push-not-h nf)))))
                                 (w (dk-skolem! ex)))
                            (dk-split-all!)
                            (cons w (lambda () (ass))))))))
                 (xc (dk-skolem! (dk-cite! 'lc5-compact-subset-cluster 's a g)))
                 (_1 (dk-split-all!)))
            (fact 'subset-mem-fwd a '(PTS s) xc)
            (let* ((m (dk-skolem! (dk-apply! lx5-cover xc)))
                   (_2 (dk-split-all!))
                   (m1 (list '+ m 1))
                   (e (dk-skolem! (dk-apply! lx5-inter m)))
                   (_3 (dk-split-all!))
                   (bsub (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'BALL) (dk-contains? fm e))) "the ball clause") xc))
                   (ci (dk-cite! 'cluster-point 's g xc)))
              (lx5-nn-add! m 1)
              (if (not (dk-asm? (list 'CLUSTER-POINT 's g xc)))
                  (error "lx5: no cluster point in context" (map expression->string (filter (dk-head? 'CLUSTER-POINT) (dk-asms)))))
              (dk-have! (caddr ci) (lambda () (dk-only! ci (list 'CLUSTER-POINT 's g xc)) (prop)))
              (dk-split-all! (list (caddr ci)))
              (let* ((clu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(DIST s)) (dk-contains? fm g))) "the cluster clause"))
                     (j (dk-skolem! (dk-apply! clu e m1)))
                     (_4 (dk-split-all!))
                     (gj (list g j)))
                (fact 'fun-apply-type-c g 'NN a j)
                (fact 'subset-mem-fwd a '(PTS s) gj)
                (fact 'rr-pos-rr-in-rr e)
                (lx5-dist! 's gj xc) (lx5-dist! 's xc gj)
                (dk-cite! 'metric-sym 's gj xc)
                (let ((bi (dk-cite! 'ball-membership 's xc e gj)))
                  (dk-have! (caddr bi)
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (let ((gl (dk-goal)))
                            (cond ((dk-asm? gl) (ass))
                                  ((dk-head-is? gl '<=)
                                   (dk-ineq! (list '= (list '(DIST s) gj xc) (list '(DIST s) xc gj))
                                             (list '< (list '(DIST s) gj xc) e)))
                                  (#t (di)
                                      (dk-absurd! (list '= (list '(DIST s) xc gj) e)
                                                  (list '= (list '(DIST s) gj xc) (list '(DIST s) xc gj))
                                                  (list '< (list '(DIST s) gj xc) e)))))))))
                  (dk-have! (list 'IN gj (list 'BALL 's xc e)) (lambda () (prop))))
                (fact 'subset-mem-fwd (list 'BALL 's xc e) (list lx5-kx m1) gj)
                (dk-apply! lx5-mono m1 j)
                (fact 'subset-mem-fwd (list lx5-kx m1) (list lx5-kx j) gj)
                (lx5-seq-at! g j)
                (dk-only! (list 'IN gj (list lx5-kx j)) (list 'NOT (list 'IN gj (list lx5-kx j))))
                (prop)))))))))

(let ((ci (dk-cite! 'is-compact-exhaustion 's lx5-kx)))
  (dk-have! (caddr ci) (lambda () (dk-conj-close! (lambda () (ass)))))
  (ew lx5-kx)
  (prop))
(qed 'locally-compact-separable-exhaustion)
(topic! 'locally-compact-separable-exhaustion 'topology)


;;; ======================================================================
;;; (5) subspaces: compactness of a subset is intrinsic; closed balls of a subspace;
;;;     an open subspace of a locally compact space is locally compact;
;;;     a dense sequence makes a space separable
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL uu (IMPLIES (SUBSET uu (PTS s))
    (FORALL ds (IMPLIES (SUBSET ds uu)
      (IFF (IS-COMPACT (SUBSPACE-MS (SUBSPACE-MS s uu) ds)) (IS-COMPACT (SUBSPACE-MS s ds)))))))))))
(dk-peel!)
(define lx5-6-sub '(SUBSPACE-MS s uu))
(lx5-set! 'uu)
(fact 'subspace-is-metric-space 's 'uu)
(dk-cite! 'subspace-pts 's 'uu)
(fact 'subset-trans 'ds 'uu '(PTS s))
(dk-have! (list 'SUBSET 'ds (list 'PTS lx5-6-sub)) (lambda () (subst (list '== (list 'PTS lx5-6-sub) 'uu)) (ass)))
(dk-iff! (lambda (g) (dk-contains? g '(SUBSPACE-MS (SUBSPACE-MS s uu) ds)))
  ;; compact in s ==> compact in the subspace
  (lambda ()
    (let ((ch (dk-cite! 'lc5-cluster-compact-subset lx5-6-sub 'ds)))
      (dk-chain! ch
        (lambda (ante)
          (lambda ()
            (let* ((f (dk-di-var!))
                   (xc (dk-skolem! (dk-cite! 'lc5-compact-subset-cluster 's 'ds f))))
              (dk-split-all!)
              (fact 'fun-codomain-superset f 'NN 'ds 'uu)
              (fact 'subset-mem-fwd 'ds 'uu xc)
              (dk-cite! 'lc5-cluster-to-subspace 's 'uu f xc)
              (ew xc)
              (dk-conj-close!)))))
      (ass)))
  ;; compact in the subspace ==> compact in s
  (lambda ()
    (let ((ch (dk-cite! 'lc5-cluster-compact-subset 's 'ds)))
      (dk-chain! ch
        (lambda (ante)
          (lambda ()
            (let* ((f (dk-di-var!))
                   (xc (dk-skolem! (dk-cite! 'lc5-compact-subset-cluster lx5-6-sub 'ds f))))
              (dk-split-all!)
              (dk-split-all! (list (dk-cite! 'lc5-cluster-from-subspace 's 'uu f xc)))
              (ew xc)
              (dk-conj-close!)))))
      (ass))))
(qed 'compact-subset-of-subspace-iff)
(topic! 'compact-subset-of-subspace-iff 'topology)

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL uu (IMPLIES (SUBSET uu (PTS s))
    (FORALL ca (IMPLIES (IN ca uu)
      (FORALL ra (IMPLIES (SUBSET (CLOSED-BALL s ca ra) uu)
        (= (CLOSED-BALL (SUBSPACE-MS s uu) ca ra) (CLOSED-BALL s ca ra))))))))))))
(dk-peel!)
(define lx5-7-sub '(SUBSPACE-MS s uu))
(lx5-set! 'uu)
(fact 'subspace-is-metric-space 's 'uu)
(dk-cite! 'subspace-pts 's 'uu)
(fact 'subset-mem-fwd 'uu '(PTS s) 'ca)
(let ((ch (dk-cite! 'class-extensionality '(CLOSED-BALL (SUBSPACE-MS s uu) ca ra) '(CLOSED-BALL s ca ra))))
  (dk-chain! ch
    (lambda (ante)
      (lambda ()
        (let ((x (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (let* ((m1 (dk-cite! 'closed-ball-membership lx5-7-sub 'ca 'ra x))
                (m2 (dk-cite! 'closed-ball-membership 's 'ca 'ra x)))
            (dk-iff! (lambda (g) (equal? g (list 'IN x '(CLOSED-BALL s ca ra))))
              (lambda ()
                (dk-have! (caddr m1) (lambda () (prop)))
                (dk-split-all! (list (caddr m1)))
                (dk-rewrite-h! (list 'IN x (list 'PTS lx5-7-sub)) (list 'PTS lx5-7-sub) 'uu)
                (fact 'subset-mem-fwd 'uu '(PTS s) x)
                (dk-cite! 'subspace-dist 's 'uu 'ca x)
                (dk-rewrite-h! (list '<= (list (list 'DIST lx5-7-sub) 'ca x) 'ra) (list (list 'DIST lx5-7-sub) 'ca x) (list '(DIST s) 'ca x))
                (dk-only! m2 (list 'IN x '(PTS s)) (list '<= (list '(DIST s) 'ca x) 'ra))
                (prop))
              (lambda ()
                (fact 'subset-mem-fwd '(CLOSED-BALL s ca ra) 'uu x)
                (dk-have! (caddr m2) (lambda () (prop)))
                (dk-split-all! (list (caddr m2)))
                (dk-have! (list 'IN x (list 'PTS lx5-7-sub)) (lambda () (subst (list '== (list 'PTS lx5-7-sub) 'uu)) (ass)))
                (dk-cite! 'subspace-dist 's 'uu 'ca x)
                (dk-have! (list '<= (list (list 'DIST lx5-7-sub) 'ca x) 'ra)
                  (lambda () (subst (list '= (list (list 'DIST lx5-7-sub) 'ca x) (list '(DIST s) 'ca x))) (ass)))
                (dk-only! m1 (list 'IN x (list 'PTS lx5-7-sub)) (list '<= (list (list 'DIST lx5-7-sub) 'ca x) 'ra))
                (prop)))))))))
  (ass)
(qed 'subspace-closed-ball-eq)
(topic! 'subspace-closed-ball-eq 'topology)

(sp (make-wff '(FORALL s (IMPLIES (IS-LOCALLY-COMPACT s)
  (FORALL uu (IMPLIES (IS-OPEN s uu) (IS-LOCALLY-COMPACT (SUBSPACE-MS s uu))))))))
(dk-peel!)
(let ((li (dk-cite! 'is-locally-compact 's)))
  (dk-have! (caddr li) (lambda () (prop)))
  (dk-split-all! (list (caddr li))))
(define lx5-8-lc (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CLOSED-BALL))) "the local compactness clause"))
(let ((oi (dk-cite! 'is-open 's 'uu)))
  (dk-have! (caddr oi) (lambda () (prop)))
  (dk-split-all! (list (caddr oi))))
(define lx5-8-op (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'BALL) (not (dk-contains? fm 'CLOSED-BALL)))) "the openness clause"))
(define lx5-8-sub '(SUBSPACE-MS s uu))
(lx5-set! 'uu)
(fact 'subspace-is-metric-space 's 'uu)
(dk-cite! 'subspace-pts 's 'uu)
(let ((li2 (dk-cite! 'is-locally-compact lx5-8-sub)))
  (dk-have! (caddr li2)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((a (dk-di-var!))
                     (_0 (dk-rewrite-h! (list 'IN a (list 'PTS lx5-8-sub)) (list 'PTS lx5-8-sub) 'uu))
                     (_1 (fact 'subset-mem-fwd 'uu '(PTS s) a))
                     (rr_ (dk-skolem! (dk-apply! lx5-8-lc a)))
                     (_2 (dk-split-all!))
                     (rho (dk-skolem! (dk-apply! lx5-8-op a)))
                     (_3 (dk-split-all!))
                     (m1 (dk-skolem! (dk-cite! 'nn-recip-succ-small rr_)))
                     (_4 (dk-split-all!))
                     (m2 (dk-skolem! (dk-cite! 'nn-recip-succ-small rho)))
                     (_5 (dk-split-all!))
                     (m (list '+ m1 m2))
                     (r (list 'recip (list '+ m 1))))
                (fact 'rr-pos-rr-in-rr rr_)
                (fact 'rr-pos-rr-in-rr rho)
                (lx5-nn-add! m1 m2)
                (lx5-rad! m) (lx5-rad! m1) (lx5-rad! m2)
                (dk-have! (list '<= m1 m) (lambda () (dk-nn!)))
                (dk-have! (list '<= m2 m) (lambda () (dk-nn!)))
                (dk-cite! 'nn-recip-succ-antitone m1 m)
                (dk-cite! 'nn-recip-succ-antitone m2 m)
                ;; B'(a, r) lies in B(a, rho), hence in uu
                (dk-have! (list '< r rho) (lambda () (dk-ineq! (list '<= r (list 'recip (list '+ m2 1))) (list '< (list 'recip (list '+ m2 1)) rho))))
                (dk-cite! 'closed-ball-in-ball 's a r rho)
                (fact 'subset-trans (list 'CLOSED-BALL 's a r) (list 'BALL 's a rho) 'uu)
                ;; B'(a, r) is compact: a closed subset of B'(a, R)
                (dk-cite! 'closed-ball-in-carrier 's a rr_)
                (dk-cite! 'closed-ball-is-closed 's a r)
                (dk-cite! 'metric-self-zero 's a)
                (lx5-dist! 's a a)
                (dk-have! (list '<= (list '+ (list '(DIST s) a a) r) rr_)
                  (lambda () (dk-ineq! (list '= (list '(DIST s) a a) 0) (list '<= r (list 'recip (list '+ m1 1))) (list '< (list 'recip (list '+ m1 1)) rr_))))
                (dk-cite! 'closed-ball-in-closed-ball 's a a rr_ r)
                (dk-cite! 'closed-in-compact-subset 's (list 'CLOSED-BALL 's a rr_) (list 'CLOSED-BALL 's a r))
                ;; ... and it is the closed ball of the subspace
                (dk-cite! 'subspace-closed-ball-eq 's 'uu a r)
                (dk-cite! 'closed-ball-in-carrier 's a r)
                (let ((ci (dk-cite! 'compact-subset-of-subspace-iff 's 'uu (list 'CLOSED-BALL 's a r))))
                  (dk-have! (cadr ci) (lambda () (prop))))
                (ew r)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (dk-close-if!
                          (lambda () (subst (list '= (list 'CLOSED-BALL lx5-8-sub a r) (list 'CLOSED-BALL 's a r))))
                          ass)))))))))))
  (prop)
(qed 'open-subspace-locally-compact)
(topic! 'open-subspace-locally-compact 'topology)

(sp (make-wff '(FORALL s (FORALL dsq (IMPLIES (IS-DENSE-SEQ s dsq) (IS-SEPARABLE s))))))
(dk-peel!)
(let ((di_ (dk-cite! 'is-dense-seq 's 'dsq)))
  (dk-have! (caddr di_) (lambda () (prop)))
  (dk-split-all! (list (caddr di_))))
(let ((si (dk-cite! 'is-separable 's)))
  (dk-have! (caddr si)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin (ew 'dsq) (dk-conj-close!)))))))
  (prop))
(qed 'dense-seq-separable)
(topic! 'dense-seq-separable 'topology)

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (IMPLIES (IS-SEPARABLE (SUBSPACE-MS s (PTS s))) (IS-SEPARABLE s))))))
(dk-peel!)
(define lx5-9-sub '(SUBSPACE-MS s (PTS s)))
(lx5-set! '(PTS s))
(dk-cite! 'subspace-pts 's '(PTS s))
(let ((si (dk-cite! 'is-separable lx5-9-sub)))
  (dk-have! (caddr si) (lambda () (prop)))
  (dk-split-all! (list (caddr si))))
(define lx5-9-dq (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'FUN))) "the dense sequence")))
(define lx5-9-cl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm lx5-9-dq))) "the density clause"))
(dk-rewrite-h! (list 'IN lx5-9-dq (list 'FUN 'NN (list 'PTS lx5-9-sub))) (list 'PTS lx5-9-sub) '(PTS s))
(let ((si (dk-cite! 'is-separable 's)))
  (dk-have! (caddr si)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew lx5-9-dq)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (let* ((landed (dk-peel!))
                               (x (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(PTS s)))) landed))))
                               (eps (dk-landed-eps landed)))
                          (dk-have! (list 'IN x (list 'PTS lx5-9-sub)) (lambda () (subst (list '== (list 'PTS lx5-9-sub) '(PTS s))) (ass)))
                          (let ((n (dk-skolem! (dk-apply! lx5-9-cl x eps))))
                            (dk-split-all!)
                            (fact 'fun-apply-type-c lx5-9-dq 'NN '(PTS s) n)
                            (dk-cite! 'subspace-dist 's '(PTS s) x (list lx5-9-dq n))
                            (ew n)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal))
                                    (ass)
                                    (begin
                                      (subst (list '= (list '(DIST s) x (list lx5-9-dq n)) (list (list 'DIST lx5-9-sub) x (list lx5-9-dq n))))
                                      (ass))))))))))))))))
  (prop))
(qed 'separable-of-full-subspace)
(topic! 'separable-of-full-subspace 'topology)
