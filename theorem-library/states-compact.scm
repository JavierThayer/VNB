(define (g4w-proj x) (list 'TPROJ g4w-VA g4w-CF x))
(define (g4w-proj-hom! x)              ; x typed: (IS-HOM-TOP-SPACE PR MT (P x))
  (let ((g (list 'IS-HOM-TOP-SPACE g4w-PR g4w-MT (g4w-proj x))))
    (if (not (dk-asm? g))
        (begin (g4w-vt! x)
               (dk-cite! 'tproj-continuous g4w-VA g4w-CF x)
               (g4w-cfy! x)
               (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE g4w-PR (list g4w-CF x) (g4w-proj x)) (list g4w-CF x) g4w-MT)))
    g))
(define (g4w-pval! x q)                ; q in PRP, x typed: (= ((P x) q) (q x)) and (q x) in CC
  (let ((e (list '= (list (g4w-proj x) q) (list q x))))
    (if (not (dk-asm? e)) (begin (g4w-vt! x) (dk-cite! 'tproj-value g4w-VA g4w-CF x q)))
    (if (not (dk-asm? (list 'IN (list q x) 'CC)))
        (begin
          (if (not (dk-asm? (list 'IN q '(FUN (VEC a) CC)))) (dk-cite! 'cc-product-fun g4w-VA q))
          (dk-cite! 'fun-apply-type-c q g4w-VA 'CC x)))
    e))
(define (g4w-pt! q)                    ; (IN q (FUN VA CC)) in context: q in PRP and in PTS PR
  (if (not (dk-asm? (list 'IN q g4w-PRP))) (dk-cite! 'fun-in-cc-product g4w-VA q))
  (if (not (dk-asm? (list 'IN q (list 'PTS g4w-PR))))
      (dk-have! (list 'IN q (list 'PTS g4w-PR)) (lambda () (subst (list '== (list 'PTS g4w-PR) g4w-PRP)) (dk-ass!)))))
(define (g4w-hom-map h)
  (if (and (pair? h) (eq? (car h) 'IS-HOM-TOP-SPACE)) (list-ref h 3) (error "g4w-hom-map: not a hom fact" h)))
(define (g4w-hom-fun! f)               ; (IS-HOM-TOP-SPACE PR MT f) in context: (IN f (FUN (PTS PR) CC))
  (let ((g (list 'IN f (list 'FUN (list 'PTS g4w-PR) 'CC))))
    (if (not (dk-asm? g))
        (let* ((iff (dk-cite! 'is-hom-top-space-def g4w-PR g4w-MT f))
               (ft (list 'IN f (list 'FUN (list 'PTS g4w-PR) (list 'PTS g4w-MT)))))
          (dk-have! ft (lambda () (if (dk-only! iff (list 'IS-HOM-TOP-SPACE g4w-PR g4w-MT f)) (prop))))
          (dk-rewrite-h! ft (list 'PTS g4w-MT) 'CC)))
    g))
(define (g4w-beta-val! e)
  (if (not (dk-asm? e))
      (dk-have! e (lambda ()
                    (dk-lam-b!)
                    (if (not (g4w-grounded?))
                        (begin
                          (for-each (lambda (h) (if (and (pair? h) (eq? (car h) '=) (pair? (cadr h)) (pair? (car (cadr h)))
                                                         (eq? (car (car (cadr h))) 'TPROJ) (dk-contains? (dk-goal) (cadr h)))
                                                    (subst h)))
                                    (dk-asms))
                          (if (not (g4w-grounded?)) (rfl)))))))
  e)

;;; the identities of a state
(define (g4w-sq x) (list '(VMUL a) (list '(VSTAR a) x) x))
(define (g4w-u1 f) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC a)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC a))
  (list '= (list f '((VADD a) bax_ bay_)) (list '+ (list f 'bax_) (list f 'bay_))))))))
(define (g4w-u2 f) (list 'FORALL 'baz_ (list 'IMPLIES '(IN baz_ CC) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC a))
  (list '= (list f '((ACT a) baz_ bax_)) (list '* 'baz_ (list f 'bax_))))))))
(define (g4w-u5 f) (list 'FORALL 'g4x_ (list 'IMPLIES '(IN g4x_ (VEC a))
  (list 'AND (list 'IN (list f (g4w-sq 'g4x_)) 'RR) (list '<= 0 (list f (g4w-sq 'g4x_)))))))
(define (g4w-u4 f) (list '= (list f '(VONE a)) 1))
(define (g4w-f1 f) (list 'FORSOME 'gsx_ (list 'FORSOME 'gsy_ (list 'AND '(IN gsx_ (VEC a)) (list 'AND '(IN gsy_ (VEC a))
  (list 'NOT (list '= (list f '((VADD a) gsx_ gsy_)) (list '+ (list f 'gsx_) (list f 'gsy_)))))))))
(define (g4w-f2 f) (list 'FORSOME 'gsz_ (list 'FORSOME 'gsx_ (list 'AND '(IN gsz_ CC) (list 'AND '(IN gsx_ (VEC a))
  (list 'NOT (list '= (list f '((ACT a) gsz_ gsx_)) (list '* 'gsz_ (list f 'gsx_)))))))))
(define (g4w-f5 f) (list 'FORSOME 'g4wx_ (list 'AND '(IN g4wx_ (VEC a))
  (list 'NOT (list 'AND (list 'IN (list f (g4w-sq 'g4wx_)) 'RR) (list '<= 0 (list f (g4w-sq 'g4wx_))))))))

(define (g4w-state0! c)                ; c in STATES: FUN typing, IS-POSITIVE-LF and c(1) = 1, landed
