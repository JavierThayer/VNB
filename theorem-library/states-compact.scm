(define (g4w-separate! p A B vals! cfact!)
  (let ((agree (list 'FORALL 'ctc_ (list 'IMPLIES (list 'IN 'ctc_ g4w-SIG) (list '= (list A 'ctc_) (list B 'ctc_))))))
    (dk-have! agree
      (lambda ()
        (let ((c (dk-di-var!)))
          (g4w-state! c) (g4w-pt! c)
          (let ((v (vals! c)))
            (subst (list '= (list A c) (car v)))
            (subst (list '= (list B c) (cdr v)))
            (cfact! c (car v) (cdr v))))))
    (let ((v (vals! p)))
      (dk-have! (list 'NOT (list '= (list A p) (list B p)))
        (lambda ()
          (di)
          (dk-have! (list '= (car v) (cdr v))
            (lambda () (subst (list '= (car v) (list A p))) (subst (list '= (cdr v) (list B p))) (dk-ass!)))
          (ai (list 'NOT (list '= (car v) (cdr v)))))))
    (dk-cite! 'cc-hom-separate g4w-PR A B g4w-SIG p)
    (dk-ass!)))
(define (g4w-skolem2! fail)
  (let* ((w1 (dk-skolem! (dk-ctx-form fail) #f))
         (in2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w1))) "the inner failure"))
         (w2 (dk-skolem! in2 #f)))
    (dk-split-all! (list (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h w1) (dk-contains? h w2))) "the failure body")))
    (list w1 w2)))
(define (g4w-skolem1! fail)
  (let ((w1 (dk-skolem! (dk-ctx-form fail) #f)))
    (dk-split-all! (list (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h w1) (dk-contains? h 'NOT))) "the failure body")))
    w1))
(define (g4w-prove-u2! fail)
  (dk-peel!)
  (let* ((g (dk-goal)) (inner (cadr (cadr g))) (x (cadr inner)) (y (caddr inner)))
    (use-em g
      (lambda () (dk-ass!))
      (lambda ()
        (dk-have! fail (lambda () (ew x) (ew y) (dk-conj-close! (lambda () (dk-ass!)))))
        (ai (list 'NOT fail))))))
(define (g4w-prove-u1! fail)
  (let* ((x (g4w-var (dk-peel!) g4w-VA)) (g (dk-goal)))
    (use-em g
      (lambda () (dk-ass!))
      (lambda ()
        (dk-have! fail (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
        (ai (list 'NOT fail))))))

;;; the local separation of p from STATES by an open set on which |f(p) - f(q)| < eps, f = P(v);
;;; REFUTE! q proves FALSITY from (IN q STATES) and the bound at q in context.
(define (g4w-local! p v eps refute!)
  (let* ((f (g4w-proj v)) (co (list 'COMPLEMENT-IN (list 'PTS g4w-PR) g4w-SIG)))
    (g4w-hom-fun! f)
    (let* ((ch (dk-cite! 'bsw-cc-elim g4w-PR f))
           (ex (dk-apply! ch p eps))
           (u (dk-skolem! ex #t))
           (bnd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h 'magnitude))) "the bound")))
      (ew u)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (begin
                (mac 'subset-def)
                (let* ((q (g4w-var (dk-peel!) u)))
                  (dk-apply! (dk-cite! 'top-open-subset g4w-PR) u)
                  (dk-cite! 'subset-mem-fwd u (list 'PTS g4w-PR) q)
                  (let ((bq (dk-apply! bnd q)) (cm (dk-cite! 'complement-in-membership (list 'PTS g4w-PR) g4w-SIG q)))
                    (dk-have! (list 'NOT (list 'IN q g4w-SIG))
                      (lambda () (di) (g4w-state! q) (g4w-pt! q) (g4w-pval! v q)
                                  (let* ((b1 (dk-rewrite-h! bq (list f q) (list q v)))
                                         (b2 (dk-rewrite-h! b1 (list f p) (list p v))))
                                    (dk-cite! 'cc-sub-in-cc (list p v) (list q v))
                                    (dk-cite! 'cc-magnitude-closed (list '- (list p v) (list q v)))
                                    (refute! q b2))))
                    (dk-have! (list 'AND (list 'IN q (list 'PTS g4w-PR)) (list 'NOT (list 'IN q g4w-SIG)))
                      (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                    (if (dk-only! cm (list 'AND (list 'IN q (list 'PTS g4w-PR)) (list 'NOT (list 'IN q g4w-SIG)))) (prop)))))))))))

;;; ---- Sigma(A) is closed in CC^A ------------------------------------------------------------------------
(sp (g4w-st (list 'IS-TOP-CLOSED g4w-PR g4w-SIG)))
(dk-peel!)
(g4w-setup!)
(dk-have! (list 'SUBSET g4w-SIG g4w-PRP)
  (lambda () (mac 'subset-def)
             (let ((c (g4w-var (dk-peel!) g4w-SIG))) (g4w-state! c) (dk-cite! 'fun-in-cc-product g4w-VA c) (dk-ass!))))
(mac 'is-top-closed)
(let ((co (list 'COMPLEMENT-IN (list 'PTS g4w-PR) g4w-SIG)))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET) (subst (list '== (list 'PTS g4w-PR) g4w-PRP)) (dk-ass!))
        (#t
         (let* ((ch (dk-cite! 'top-open-of-local g4w-PR co))
                (ch2 (detach-with! ch
                       (lambda ()
                         (mac 'subset-def)
                         (let* ((z (g4w-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership (list 'PTS g4w-PR) g4w-SIG z)))
                           (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN z co)) (prop))))
                           (dk-split! (caddr cm))
                           (dk-ass!))))))
           (detach-with! ch2
             (lambda ()
               (let* ((p (g4w-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership (list 'PTS g4w-PR) g4w-SIG p)))
                 (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN p co)) (prop))))
                 (dk-split! (caddr cm))
                 (dk-have! (list 'IN p g4w-PRP) (lambda () (subst (list '== g4w-PRP (list 'PTS g4w-PR))) (dk-ass!)))
                 (dk-cite! 'cc-product-fun g4w-VA p)
                 (let ((f1 (g4w-f1 p)) (f2 (g4w-f2 p)) (f5 (g4w-f5 p)))
                   (use-em f1
                     (lambda ()
                       (let* ((ws (g4w-skolem2! f1)) (x (car ws)) (y (cadr ws)) (xy (list '(VADD a) x y)))
                         (g4w-vt! xy)
                         (g4w-proj-hom! xy) (g4w-proj-hom! x) (g4w-proj-hom! y)
                         (let ((B (g4w-hom-map (dk-cite! 'cc-hom-add g4w-PR (g4w-proj x) (g4w-proj y)))))
                           (g4w-separate! p (g4w-proj xy) B
                             (lambda (q)
                               (g4w-pval! xy q) (g4w-pval! x q) (g4w-pval! y q)
                               (g4w-beta-val! (list '= (list B q) (list '+ (list q x) (list q y))))
                               (cons (list q xy) (list '+ (list q x) (list q y))))
                             (lambda (c ta tb) (dk-apply! (dk-ctx-form (g4w-u1 c)) x y) (dk-ass!))))))
                     (lambda ()
                       (dk-have! (g4w-u1 p) (lambda () (g4w-prove-u2! f1)))
                       (use-em f2
                         (lambda ()
                           (let* ((ws (g4w-skolem2! f2)) (z (car ws)) (x (cadr ws)) (zx (list '(ACT a) z x)))
                             (g4w-vt! zx)
                             (g4w-proj-hom! zx) (g4w-proj-hom! x)
                             (let* ((K (g4w-hom-map (dk-cite! 'cc-hom-const g4w-PR z)))
                                    (B (g4w-hom-map (dk-cite! 'cc-hom-mul g4w-PR K (g4w-proj x)))))
                               (g4w-separate! p (g4w-proj zx) B
                                 (lambda (q)
                                   (g4w-pval! zx q) (g4w-pval! x q)
                                   (g4w-beta-val! (list '= (list B q) (list '* z (list q x))))
                                   (cons (list q zx) (list '* z (list q x))))
                                 (lambda (c ta tb) (dk-apply! (dk-ctx-form (g4w-u2 c)) z x) (dk-ass!))))))
                         (lambda ()
                           (dk-have! (g4w-u2 p) (lambda () (g4w-prove-u2! f2)))
                           (use-em f5
                             ;; positivity fails at x: p(x* x) is not real, or is negative
                             (lambda ()
                               (let* ((x (g4w-skolem1! f5)) (v (g4w-sq x)) (pv (list p v)) (ipv (list 'IMAG-PART pv)))
                                 (g4w-vt! v) (g4w-proj-hom! v) (g4w-pval! v p)
                                 (dk-cite! 'imag-part-in-rr pv)
                                 (dk-real! 0)
                                 (use-em (list '= ipv 0)
                                   ;; p(x* x) is real and negative: eps = -p(x* x)
                                   (lambda ()
                                     (dk-cite! 'cc-real-of-im-zero pv)
                                     (dk-have! (list '< pv 0)
                                       (lambda ()
                                         (use-em (list '<= 0 pv)
                                           (lambda ()
                                             (dk-have! (list 'AND (list 'IN pv 'RR) (list '<= 0 pv)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                                             (ai (list 'NOT (list 'AND (list 'IN pv 'RR) (list '<= 0 pv)))))
                                           (lambda () (dk-cite! 'rr-not-le-lt 0 pv) (dk-ass!)))))
                                     (let ((eps (list '- 0 pv)))
                                       (dk-have! (list 'IN eps 'RR) (lambda () (dk-real! eps)))
                                       (dk-have! (list 'POS-RR eps)
                                         (lambda () (mac 'pos-rr)
                                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                             (if (dk-head-is? (dk-goal) 'NOT)
                                                 (begin (di) (dk-absurd! (list '< pv 0) (list '= 0 eps) (list 'IN pv 'RR) (list 'IN eps 'RR)))
                                                 (dk-ineq! (list '< pv 0) (list 'IN pv 'RR) (list 'IN eps 'RR))))))))
                                       (dk-cite! 'cc-re-of-real pv)
                                       (g4w-local! p v eps
                                         (lambda (q b)
                                           (let ((qv (list q v)))
                                             (dk-split! (dk-apply! (dk-ctx-form (g4w-u5 q)) x))
                                             (dk-cite! 'cc-re-of-real qv)
                                             (dk-cite! 'cc-re-dist-le pv qv)
                                             (dk-cite! 'real-part-in-rr pv) (dk-cite! 'real-part-in-rr qv)
                                             (let* ((t (list '- (list 'REAL-PART pv) (list 'REAL-PART qv))) (nt (list '- t)))
                                               (dk-real! t) (dk-real! nt)
                                               (dk-cite! 'rr-le-abs nt)
                                               (dk-cite! 'rr-abs-neg t)
                                               (dk-cite! 'rr-abs-closed t) (dk-cite! 'rr-abs-closed nt))
                                             (dk-absurd! (list '<= 0 qv) (list '< pv 0) (list 'IN pv 'RR) (list 'IN qv 'RR)
                                                         (list 'IN (list 'REAL-PART pv) 'RR) (list 'IN (list 'REAL-PART qv) 'RR)
                                                         (list '<= (list '- (list '- (list 'REAL-PART pv) (list 'REAL-PART qv)))
                                                               (list 'abs (list '- (list '- (list 'REAL-PART pv) (list 'REAL-PART qv)))))
                                                         (list '= (list 'abs (list '- (list '- (list 'REAL-PART pv) (list 'REAL-PART qv))))
                                                               (list 'abs (list '- (list 'REAL-PART pv) (list 'REAL-PART qv))))
                                                         (list 'IN (list 'abs (list '- (list 'REAL-PART pv) (list 'REAL-PART qv))) 'RR)
                                                         (list 'IN (list 'abs (list '- (list '- (list 'REAL-PART pv) (list 'REAL-PART qv)))) 'RR)
                                                         (list '= (list 'REAL-PART pv) pv) (list '= (list 'REAL-PART qv) qv)
                                                         (list '<= (list 'abs (list '- (list 'REAL-PART pv) (list 'REAL-PART qv)))
                                                               (list 'magnitude (list '- pv qv)))
                                                         (list 'IN (list 'magnitude (list '- pv qv)) 'RR)
                                                         b))))))
                                   ;; p(x* x) is not real: eps = |Im p(x* x)|
                                   (lambda ()
                                     (let ((eps (list 'abs ipv)))
                                       (dk-cite! 'rr-abs-closed ipv)
                                       (dk-cite! 'rr-abs-nonneg ipv)
                                       (dk-have! (list 'POS-RR eps)
                                         (lambda () (mac 'pos-rr)
                                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                             (if (dk-head-is? (dk-goal) 'NOT)
                                                 (begin (di)
                                                        (let ((iff (dk-cite! 'rr-abs-zero ipv)))
                                                          (dk-have! (list '= eps 0) (lambda () (dk-ineq! (list '= 0 eps) (list 'IN eps 'RR))))
                                                          (dk-have! (list '= ipv 0) (lambda () (if (dk-only! iff (list '= eps 0)) (prop))))
                                                          (ai (list 'NOT (list '= ipv 0)))))
                                                 (dk-ineq! (list '<= 0 eps) (list 'IN eps 'RR))))))))
                                       (g4w-local! p v eps
                                         (lambda (q b)
                                           (let ((qv (list q v)))
                                             (dk-split! (dk-apply! (dk-ctx-form (g4w-u5 q)) x))
                                             (dk-cite! 'cc-im-of-real qv)
                                             (let* ((d0 (dk-cite! 'cc-im-dist-le pv qv))
                                                    (d1 (dk-rewrite-h! d0 (list 'IMAG-PART qv) 0)))
                                               (dk-have! (list '= (list '- ipv 0) ipv) (lambda () (dk-ineq! (list 'IN ipv 'RR))))
                                               (dk-rewrite-h! d1 (list '- ipv 0) ipv))
                                             (dk-absurd! (list 'IN ipv 'RR) (list 'IN eps 'RR)
                                                         (list '<= eps (list 'magnitude (list '- pv qv)))
                                                         (list 'IN (list 'magnitude (list '- pv qv)) 'RR)
                                                         b)))))))))
                             (lambda ()
                               (dk-have! (g4w-u5 p) (lambda () (g4w-prove-u1! f5)))
                               (use-em (g4w-u4 p)
                                 ;; every identity holds: p is a state, against p not in STATES
                                 (lambda ()
                                   (dk-cite! 'states-unfold 'a)
                                   (dk-have! (list 'IS-CC-LINEAR-ON 'a p)
                                     (lambda () (mac 'is-cc-linear-on) (dk-conj-close! (lambda () (dk-ass!)))))
                                   (dk-have! (list 'IS-POSITIVE-LF 'a p)
                                     (lambda () (mac 'is-positive-lf) (dk-conj-close! (lambda () (dk-ass!)))))
                                   (dk-have! (list 'IN p g4w-SIG)
                                     (lambda () (subst (list '== g4w-SIG g4w-SIGSEP))
                                                (in-sep! (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
                                   (ai (list 'NOT (list 'IN p g4w-SIG))))
                                 ;; p(1) /= 1: P(1) against the constant 1
                                 (lambda ()
                                   (let ((one '(VONE a)))
                                     (g4w-vt! one)
                                     (g4w-proj-hom! one)
                                     (dk-real! 1)
                                     (if (not (dk-asm? '(IN 1 CC))) (dk-cite! 'cc-one-in))
                                     (let ((K (g4w-hom-map (dk-cite! 'cc-hom-const g4w-PR 1))))
                                       (g4w-separate! p (g4w-proj one) K
                                         (lambda (q)
                                           (g4w-pval! one q)
                                           (g4w-beta-val! (list '= (list K q) 1))
                                           (cons (list q one) 1))
                                         (lambda (c ta tb) (dk-ass!)))))))))))))))))
           (dk-ass!)))))))
(g4w-qed! 'states-closed-in-product)

;;; ---- the dual A* sits in CC^A --------------------------------------------------------------------------
(define g4w-CDSEP
  '(SEP baf_ (FUN (VEC a) CC)
     (AND (IS-CC-LINEAR-ON a baf_)
          (FORSOME bam_ (AND (IN bam_ RR) (FORALL bax_ (IMPLIES (IN bax_ (VEC a))
            (<= (magnitude (baf_ bax_)) (* bam_ ((VNRM a) bax_))))))))))
(sp (make-wff (list 'FORALL 'a (list '== '(CDUAL-VEC a) g4w-CDSEP))))
(di)
(mac 'CDUAL-VEC)
(if (not (proof-done? *ps*)) (qrfl))
(g4w-qed! 'cdual-vec-unfold)

(sp (make-wff '(FORALL a (FORALL g4wf_ (IMPLIES (IN g4wf_ (CDUAL-VEC a)) (IN g4wf_ (FUN (VEC a) CC)))))))
(let* ((l (dk-peel!)) (f (g4w-var l '(CDUAL-VEC a))))
  (dk-cite! 'cdual-vec-unfold 'a)
  (let ((m (dk-rewrite-h! (list 'IN f '(CDUAL-VEC a)) '(CDUAL-VEC a) g4w-CDSEP)))
    (dk-split-all! (dk-landed (lambda () (sep-me m)))))
  (dk-ass!))
(g4w-qed! 'cdual-vec-in-fun)

;;; ---- Corollary 4.9: Sigma(A) is weak* compact -----------------------------------------------------------
(define g4w-KB '(VNB-LAMBDA g4ww_ (VEC a) (CLOSED-BALL CC-MS 0 ((VNRM a) g4ww_))))
(define (g4w-kb-of y) (list 'CLOSED-BALL 'CC-MS 0 (list '(VNRM a) y)))
(define (g4w-kb-facts! y)
  (let ((bl (g4w-kb-of y)) (r (list '(VNRM a) y)))
    (if (not (dk-asm? (list 'IN r 'RR))) (dk-split! (dk-apply! (dk-cite! 'uiba-vnrm-real 'a) y)))
    (if (not (dk-asm? (list 'SUBSET bl '(PTS CC-MS))))
        (begin (dk-apply! (dk-cite! 'closed-ball-in-carrier 'CC-MS) 0 r)
               (dk-apply! (dk-cite! 'closed-ball-in-power 'CC-MS) 0 r)
               (dk-apply! (dk-cite! 'closed-ball-is-set 'CC-MS) 0 r)))
    (let ((e (list '= (list g4w-KB y) bl)))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
      e)))
(define g4w-hsub (list 'FORALL 'pcy_ (list 'IMPLIES (list 'IN 'pcy_ g4w-VA) (list 'IN (list g4w-KB 'pcy_) (list 'POWER (list 'PTS g4w-MT))))))
(define g4w-hcpt (list 'FORALL 'pcy_ (list 'IMPLIES (list 'IN 'pcy_ g4w-VA) (list 'IS-COMPACT-T (list 'SUBSPACE-TOP g4w-MT (list g4w-KB 'pcy_))))))
(define g4w-hconf (list 'FORALL 'pcy_ (list 'IMPLIES (list 'IN 'pcy_ g4w-VA)
                    (list 'FORALL 'pcg_ (list 'IMPLIES (list 'IN 'pcg_ g4w-SIG) (list 'IN '(pcg_ pcy_) (list g4w-KB 'pcy_)))))))
(sp (g4w-st (list 'IS-COMPACT-T (list 'SUBSPACE-TOP g4w-PR g4w-SIG))))
(dk-peel!)
(g4w-setup!)
(dk-cite! 'states-closed-in-product 'a)
(dk-have! (list 'SUBSET g4w-SIG g4w-PRP)
  (lambda () (mac 'subset-def)
             (let ((c (g4w-var (dk-peel!) g4w-SIG))) (g4w-state! c) (dk-cite! 'fun-in-cc-product g4w-VA c) (dk-ass!))))
(dk-real! 0)
(dk-cite! 'cc-zero-in)
(dk-have! g4w-hsub
  (lambda () (let ((y (g4w-var (dk-peel!) g4w-VA)))
               (subst (g4w-kb-facts! y))
               (subst (list '== (list 'PTS g4w-MT) 'CC))
               (subst '(== CC (PTS CC-MS)))
               (dk-ass!))))
(dk-have! g4w-hcpt
  (lambda () (let* ((y (g4w-var (dk-peel!) g4w-VA)) (bl (g4w-kb-of y)) (sm (list 'SUBSPACE-MS 'CC-MS bl)))
               (subst (g4w-kb-facts! y))
               (dk-cite! 'subspace-top-of-metric-top 'CC-MS bl)
               (subst (list '== (list 'SUBSPACE-TOP g4w-MT bl) (list 'METRIC-TOP sm)))
               (dk-apply! (dk-cite! 'subspace-is-metric-space 'CC-MS) bl)
               (dk-cite! 'cc-closed-ball-compact 0 (list '(VNRM a) y))
               (let ((iff (dk-cite! 'metric-top-compact sm)))
                 (if (dk-only! iff (list 'IS-COMPACT sm)) (prop))))))
(dk-have! g4w-hconf
  (lambda () (let* ((l (dk-peel!)) (y (g4w-var l g4w-VA)) (g (g4w-var l g4w-SIG)) (gy (list g y)) (r (list '(VNRM a) y)))
               (subst (g4w-kb-facts! y))
               (g4w-state0! g)
               (dk-cite! 'fun-apply-type-c g g4w-VA 'CC y)
               (dk-apply! (dk-cite! 'pos-lf-bounded 'a g) y)
               (let ((b0 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h 'magnitude) (dk-contains? h gy))) "the bound")))
                 (dk-rewrite-h! b0 (list g '(VONE a)) 1))
               (dk-have! (list '= (list '- gy 0) gy) (lambda () (mac 'binary-minus-def) (crs)))
               (dk-have! (list '= (list '* 1 r) r) (lambda () (dk-ineq! (list 'IN r 'RR))))
               (dk-have! (list '<= (list 'magnitude (list '- gy 0)) r)
                 (lambda () (subst (list '= (list '- gy 0) gy)) (subst (list '= r (list '* 1 r))) (dk-ass!)))
               (dk-cite! 'cc-closed-ball-mem-intro 0 r gy)
               (dk-ass!))))
(dk-cite! 'confined-closed-compact g4w-VA g4w-MT g4w-KB g4w-SIG)
(dk-ass!)
(g4w-qed! 'states-product-compact)

(sp (g4w-st '(IS-COMPACT-T (SUBSPACE-TOP (CDUAL-WEAK-STAR-TOP a) (STATES a)))))
(dk-peel!)
(g4w-setup!)
(dk-cite! 'states-product-compact 'a)
;; from the product to the dual: SUBSPACE-TOP(SUBSPACE-TOP(PR, A*), Sigma) = SUBSPACE-TOP(PR, Sigma)
(dk-have! (list 'SUBSET '(CDUAL-VEC a) (list 'PTS g4w-PR))
  (lambda () (mac 'subset-def)
             (let ((c (g4w-var (dk-peel!) '(CDUAL-VEC a))))
               (dk-cite! 'cdual-vec-in-fun 'a c) (g4w-pt! c) (dk-ass!))))
(dk-have! (list 'SUBSET g4w-SIG '(CDUAL-VEC a))
  (lambda () (mac 'subset-def)
             (let ((c (g4w-var (dk-peel!) g4w-SIG)))
               (dk-split! (dk-apply! (dk-cite! 'states-norm-one 'a) c)) (dk-ass!))))
(dk-cite! 'subspace-of-subspace g4w-PR '(CDUAL-VEC a) g4w-SIG)
(mac 'CDUAL-WEAK-STAR-TOP)
(subst (list '== (list 'SUBSPACE-TOP (list 'SUBSPACE-TOP g4w-PR '(CDUAL-VEC a)) g4w-SIG) (list 'SUBSPACE-TOP g4w-PR g4w-SIG)))
(dk-ass!)
(g4w-qed! 'states-weak-star-compact)
