;;; All proofs modulo 0.  Helper prefix: g4w-.
;;;
;;; The w<A*, A> topology is the topology of pointwise convergence on A*, i.e. the topology induced from
;;; the product CC^A, exactly as the Gelfand space is topologised (GELFAND-SPACE, ba-vocab;
;;; ba-gelfand-compact.scm).  The route is the one of Proposition 1.14, not the realification:
;;;   states-closed-in-product   Sigma(A) is closed in CC^A.  Linearity and phi(1) = 1 are agreement
;;;                              sets of continuous maps of the product (cc-hom-separate); positivity
;;;                              phi(x* x) in [0, oo) is local: a functional p with p(x* x) not real
;;;                              is separated from Sigma(A) by |Im p(x* x)|, one with p(x* x) < 0 by
;;;                              -p(x* x) (bsw-cc-elim, cc-im-dist-le, cc-re-dist-le).
;;;   states-weak-star-compact   Sigma(A) lies in the product of the discs |z| <= ||x|| (pos-lf-bounded,
;;;                              phi(1) = 1), so it is compact (confined-closed-compact: Tychonoff on
;;;                              the product of the discs) -- for CDUAL-WEAK-STAR-TOP, since
;;;                              Sigma(A) is inside CDUAL-VEC (states-norm-one, subspace-of-subspace).
;;; LOAD WINDOW: after theorem-library/ba-gelfand-compact (cc-hom-separate, fun-in-cc-product, ...),
;;; theorem-library/ba4-pos and ba4-states (pos-lf-bounded, states-unfold, states-norm-one), the bsw-
;;; files (bsw-cc-elim), and structure-library/ba-gns2-vocab (CDUAL-WEAK-STAR-TOP).

(define (g4w-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (for-each (lambda (l) (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 60 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "states-compact: unfinished" name))))
(define (g4w-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) body))))
(define (g4w-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (g4w-var landed cls)
  (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if h (cadr h) (error "g4w-var: no landed typing in" cls))))

