          (dk-real! 0)
          (dk-have! (list '<= 0 C) (lambda () (dk-ass!)))
          (dk-have! (list '<= C 0) (lambda () (dk-ineq! (list '<= C (bqn-nr '(VZERO a))) z0 (list 'IN C 'RR) (list 'IN (bqn-nr '(VZERO a)) 'RR))))
          (bqn-cite2! 'rr-leq-antisymmetric C 0)
          (dk-ass!))))))
