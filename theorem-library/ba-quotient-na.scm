;;; ---- definiteness: needs I CLOSED ---------------------------------------------------------
(define bqn-BAM '(BA-METRIC-SPACE a))
(define bqn-Z (list 'CLASS bqn-S '(VZERO a)))
(define (bqn-cl-eq-in! x y)        ; CLASS x = CLASS y in context: land x - y in ii
