    (let* ((bnd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'DIST) (dk-contains? h 'rad))) "the increment bound"))
           (gl (list 'VNB-LAMBDA 'bqk_ 'NN (list '+ '(rad bqk_) (bqn-pw 'bqk_))))
           (pl (list 'VNB-LAMBDA 'n 'NN (bqn-pw 'n)))
           (nxt (list 'VNB-LAMBDA '(LIST bqk_ bqu_) '(CARTESIAN NN (VEC a))
                  (list 'SEP 'bqy_ '(VEC a)
                    (list 'IMPLIES (list '= (bqn-cl 'bqu_) '(f bqk_))
                      (list 'AND (list '= (bqn-cl 'bqy_) '(f (succ bqk_)))
                                 (list '<= (bqn-nr (bqn-sb 'bqu_ 'bqy_)) (list '+ '(rad bqk_) (bqn-pw 'bqk_))))))))
           (fty (list 'IN 'f (list 'FUN 'NN bqn-QS))))
