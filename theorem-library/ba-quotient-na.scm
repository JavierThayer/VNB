;;; ---- the norm of a coset: the four facts every law uses ----------------------------------
(define (bqn-cn c) (list 'COSET-NORM 'a 'ii c))
(define (bqn-einf-of g)          ; the EINF subterm of a goal
  (let loop ((t g))
    (cond ((not (pair? t)) #f)
          ((eq? (car t) 'EINF) t)
          (#t (or (loop (car t)) (loop (cdr t)))))))
;;; u in c (c a coset in context): land u in VEC a and CLASS u = c
(define (bqn-member! c u)
  (let ((m (dk-cite! 'class-of-member bqn-S c u)))
    (if (dk-head-is? m 'AND) (dk-split! m))
    (dk-have! (list 'IN u '(VEC a)) (lambda () (subst (list '= '(VEC a) bqn-PTS)) (dk-ass!)))))
;;; the norm of x, typed in RR, with 0 <= it
(define (bqn-nt! x)
  (bqn-vt x)
  (dk-cite! 'bae-vnrm-type 'a x)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a x)
  (bqn-nr x))
(define (bqn-ss-sub! ss c)
  (dk-have! (list 'SUBSET ss 'RR-POS-STAR)
    (lambda ()
      (let ((r (subset-by-element!)))
        (sep-me (list 'IN r ss))
        (let ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the witness"))))
          (dk-split-all!)
          (bqn-member! c v)
          (let ((d (bqn-nt! v)))
            (dk-have! (list 'IN r 'RR) (lambda () (subst (list '= r d)) (dk-ass!)))
            (dk-have! (list '<= 0 r) (lambda () (subst (list '= r d)) (dk-ass!)))
            (dk-cite! 'rmc-rps-of-nonneg r)
            (dk-ass!)))))))
(define (bqn-in-ss! ss c u)      ; ||u|| in ss for u in c
  (let ((d (bqn-nt! u)))
    (dk-have! (list 'IN d ss)
      (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (ew u) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))
    d))
(define bqn-cn-st
  (lambda (body) (bqn-st2 (list 'FORALL 'c (list 'IMPLIES (list 'IN 'c bqn-QS) body)))))

;;; CN(c) <= ||u|| for u in c
(sp (bqn-cn-st '(FORALL u (IMPLIES (IN u c) (<= (COSET-NORM a ii c) ((VNRM a) u))))))
(dk-peel!)
(bqn-setup!)
(bqn-member! 'c 'u)
(mac 'COSET-NORM)
(let ((ss (cadr (bqn-einf-of (dk-goal)))))
  (bqn-ss-sub! ss 'c)
  (let ((d (bqn-in-ss! ss 'c 'u)))
    (dk-apply! (dk-cite! 'einf-lower ss) d)
    (dk-ass!)))
(bqn-qed! 'coset-norm-le)

;;; CN(c) is a nonnegative real
(sp (bqn-cn-st '(AND (IN (COSET-NORM a ii c) RR) (<= 0 (COSET-NORM a ii c)))))
(dk-peel!)
(bqn-setup!)
(let* ((x (dk-skolem! (dk-cite! 'quotient-rep bqn-S 'c))))
  (dk-split-all!)
  (dk-have! (list 'IN x '(VEC a)) (lambda () (subst (list '= '(VEC a) bqn-PTS)) (dk-ass!)))
  (dk-cite! 'class-self bqn-S x)
  (let ((cx (bqn-cl x)))
    (dk-rewrite-h! (list 'IN x cx) cx 'c))
  (mac 'COSET-NORM)
  (let* ((ss (cadr (bqn-einf-of (dk-goal))))
         (lv (list 'EINF ss)))
    (bqn-ss-sub! ss 'c)
    (let ((d (bqn-in-ss! ss 'c x)))
      (dk-cite! 'einf-lower ss d)
      (dk-cite! 'einf-in ss)
      (dk-cite! 'rps-below-real-is-real lv d)
      (dk-have! '(IN 0 RR) (lambda () (arith)))
      (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
      (dk-cite! 'rmc-rps-of-nonneg 0)
      (dk-have! (list 'FORALL 'bqz_ (list 'IMPLIES (list 'IN 'bqz_ ss) '(<= 0 bqz_)))
        (lambda ()
          (dk-peel!)
          (sep-me (list 'IN 'bqz_ ss))
          (let ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'bqz_))) "the witness"))))
            (dk-split-all!)
            (bqn-member! 'c v)
            (let ((d (bqn-nt! v)))
              (subst (list '= 'bqz_ d))
              (dk-ass!)))))
      (dk-cite! 'einf-greatest ss 0)
      (dk-conj-close! (lambda () (dk-ass!))))))
(bqn-qed! 'coset-norm-real)

;;; the SEP set whose infimum is CN(c), and the unfold of CN(c) onto it
(define (bqn-ss c) (list 'SEP 'bqnw_ 'RR (list 'FORSOME 'bqnu_ (list 'AND (list 'IN 'bqnu_ c) '(= bqnw_ ((VNRM a) bqnu_))))))
(define (bqn-cn-eq! c)
  (let ((e (list '== (bqn-cn c) (list 'EINF (bqn-ss c)))))
    (dk-have! e (lambda () (mac 'COSET-NORM) (qrfl)))
    e))
(define (bqn-cn-real! c)
  (let ((r (dk-cite! 'coset-norm-real 'a 'ii c)))
    (if (dk-head-is? r 'AND) (dk-split! r))
    (bqn-cn c)))
(define bqn-cn2-st
  (lambda (body) (bqn-cn-st (list 'FORALL 'd (list 'IMPLIES (list 'IN 'd bqn-QS) body)))))

;;; CN(c) is approximated from above by the norms of the members of c
(sp (bqn-cn-st '(FORALL eps (IMPLIES (POS-RR eps)
      (FORSOME u (AND (IN u c) (< ((VNRM a) u) (+ (COSET-NORM a ii c) eps))))))))
(dk-peel!)
(dk-peel!)
(bqn-setup!)
(dk-cite! 'rr-pos-rr-in-rr 'eps)
(dk-cite! 'rr-lt-of-pos-rr 'eps)
(bqn-cn-real! 'c)
(let* ((ss (bqn-ss 'c))
       (cn (bqn-cn 'c))
       (tgt (list '+ cn 'eps)))
  (bqn-ss-sub! ss 'c)
  (let ((e (bqn-cn-eq! 'c)))
    (dk-real! tgt)
    (dk-have! (list '<= 0 tgt) (lambda () (dk-ineq! (list '<= 0 cn) (list '< 0 'eps))))
    (dk-cite! 'rmc-rps-of-nonneg tgt)
    (dk-have! (list '< (list 'EINF ss) tgt)
      (lambda () (subst (list '= (list 'EINF ss) cn)) (dk-ineq! (list '< 0 'eps))))
    (let* ((w (dk-cite! 'einf-lt-witness ss tgt))
           (y (dk-skolem! w)))
      (dk-split-all!)
      (sep-me (list 'IN y ss))
      (let ((u (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the witness"))))
        (dk-split-all!)
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (dk-ass!)
                (begin (subst (list '= (bqn-nr u) y)) (dk-ass!)))))))))
(bqn-qed! 'coset-norm-approx)

;;; the scaled greatest lower bound: b <= t ||u|| for all u in c gives b <= t CN(c)  (t > 0, b >= 0)
(sp (bqn-cn-st '(FORALL tt (IMPLIES (IN tt RR) (IMPLIES (< 0 tt) (FORALL b (IMPLIES (IN b RR) (IMPLIES (<= 0 b)
      (IMPLIES (FORALL u (IMPLIES (IN u c) (<= b (* tt ((VNRM a) u)))))
        (<= b (* tt (COSET-NORM a ii c))))))))))))
(dk-peel!)
(let loop () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (loop))))
(bqn-setup!)
(bqn-cn-real! 'c)
(let* ((ss (bqn-ss 'c))
       (cn (bqn-cn 'c))
       (hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'tt) (dk-contains? h 'b))) "the bound")))
  (bqn-ss-sub! ss 'c)
  (dk-cite! 'rmc-rps-of-nonneg 'b)
  (dk-have! '(<= 0 tt) (lambda () (dk-ineq! '(< 0 tt))))
  (let ((e (bqn-cn-eq! 'c)))
    (dk-have! (list 'FORALL 'bqv_ (list 'IMPLIES (list 'IN 'bqv_ ss) (list '<= 'b (list 'ETIMES 'tt 'bqv_))))
      (lambda ()
        (dk-peel!)
        (sep-me (list 'IN 'bqv_ ss))
        (let ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'bqv_))) "the witness"))))
          (dk-split-all!)
          (bqn-member! 'c v)
          (let ((d (bqn-nt! v)))
            (dk-apply! hyp v)
            (dk-have! '(<= 0 bqv_) (lambda () (subst (list '= 'bqv_ d)) (dk-ass!)))
            (subst (dk-cite! 'etimes-real-defined 'tt 'bqv_))
            (subst (dk-cite! 'bintimes-apply 'tt 'bqv_))
            (subst (list '= 'bqv_ d))
            (dk-ass!)))))
    (let ((r (dk-cite! 'einf-etimes-bound ss 'tt 'b)))
      (dk-cite! 'etimes-real-defined 'tt (list 'EINF ss))
      (dk-cite! 'bintimes-apply 'tt (list 'EINF ss))
      (subst (list '= cn (list 'EINF ss)))
      (dk-have! (list 'IN (list 'EINF ss) 'RR) (lambda () (subst (list '= (list 'EINF ss) cn)) (dk-ass!)))
      (dk-have! (list '<= 0 (list 'EINF ss)) (lambda () (subst (list '= (list 'EINF ss) cn)) (dk-ass!)))
      (dk-cite! 'etimes-real-defined 'tt (list 'EINF ss))
      (subst (list '= (list '* 'tt (list 'EINF ss)) (list 'BINTIMES 'tt (list 'EINF ss))))
      (subst (list '= (list 'BINTIMES 'tt (list 'EINF ss)) (list 'ETIMES 'tt (list 'EINF ss))))
      (dk-ass!))))
(bqn-qed! 'coset-norm-scale-greatest)

;;; ---- representatives and the cosets of sums --------------------------------------------
(define bqn-QVADD (list 'VADD bqn-Q))
(define bqn-QACT (list 'ACT bqn-Q))
(define (bqn-vq c d) (list bqn-QVADD c d))
(define (bqn-aq z c) (list bqn-QACT z c))
;;; c in QS: name a representative x, landing x in VEC a, x in PTS S, (= c (CLASS x)) and x in c
(define (bqn-rep! c)
  (let ((x (dk-skolem! (dk-cite! 'quotient-rep bqn-S c))))
    (dk-split-all!)
    (dk-have! (list 'IN x '(VEC a)) (lambda () (subst (list '= '(VEC a) bqn-PTS)) (dk-ass!)))
    (dk-cite! 'class-self bqn-S x)
    (dk-rewrite-h! (list 'IN x (bqn-cl x)) (bqn-cl x) c)
    x))
;;; a fact about (CLASS w) carried onto the coset expression E, given (= (CLASS w) E') and the
;;; class equations of the parts: rewrite FROM := TO in order
(define (bqn-carry! f pairs)
  (if (null? pairs) f
      (bqn-carry! (dk-rewrite-h! f (caar pairs) (cadar pairs)) (cdr pairs))))
;;; u in c, v in d (with CLASS u = c, CLASS v = d in context): land u + v in c + d and c + d in QS
(define (bqn-sum-in! c d u v)
  (let* ((w (bqn-ad u v))
         (pairs (list (list (bqn-cl w) (bqn-vq (bqn-cl u) (bqn-cl v))) (list (bqn-cl u) c) (list (bqn-cl v) d))))
    (bqn-pts! w)
    (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii u v)
    (if (not (dk-asm? (list 'IN w (bqn-vq c d))))
        (bqn-carry! (dk-cite! 'class-self bqn-S w) pairs))
    (if (not (dk-asm? (list 'IN (bqn-vq c d) bqn-QS)))
        (bqn-carry! (dk-cite! 'class-in-quotient bqn-S w) pairs))
    w))
(define (bqn-pos-parts! e)
  (dk-cite! 'rr-pos-rr-in-rr e)
  (dk-cite! 'rr-lt-of-pos-rr e))
;;; the approximating member of c within e: returns u with u in c, CLASS u = c, ||u|| typed
(define (bqn-approx! c e)
  (let ((u (dk-skolem! (dk-cite! 'coset-norm-approx 'a 'ii c e))))
    (dk-split-all!)
    (bqn-member! c u)
    (bqn-nt! u)
    u))

;;; the triangle inequality of the quotient norm
(sp (bqn-cn2-st (list '<= (bqn-cn (bqn-vq 'c 'd)) (list '+ (bqn-cn 'c) (bqn-cn 'd)))))
(dk-peel!)
(bqn-setup!)
(bqn-cn-real! 'c) (bqn-cn-real! 'd)
(let* ((x (bqn-rep! 'c)) (y (bqn-rep! 'd)))
  (bqn-member! 'c x) (bqn-member! 'd y)
  (bqn-sum-in! 'c 'd x y))
(bqn-cn-real! (bqn-vq 'c 'd))
(let* ((lhs (bqn-cn (bqn-vq 'c 'd))) (rhs (list '+ (bqn-cn 'c) (bqn-cn 'd))))
  (dk-real! rhs)
  (dk-have! (list 'FORALL 'bqe_ (list 'IMPLIES '(POS-RR bqe_) (list '<= lhs (list '+ rhs 'bqe_))))
    (lambda ()
      (dk-peel!)
      (bqn-pos-parts! 'bqe_)
      (let* ((h (dk-halve! 'bqe_))
             (u (bqn-approx! 'c h))
             (v (bqn-approx! 'd h))
             (w (bqn-sum-in! 'c 'd u v)))
        (bqn-nt! w)
        (dk-cite! 'coset-norm-le 'a 'ii (bqn-vq 'c 'd) w)
        (dk-cite! 'bal-uba-vnrm-triangle 'a u v)
        (dk-ineq! (list '<= lhs (bqn-nr w)) (list '<= (bqn-nr w) (list '+ (bqn-nr u) (bqn-nr v)))
                  (list '< (bqn-nr u) (list '+ (bqn-cn 'c) h)) (list '< (bqn-nr v) (list '+ (bqn-cn 'd) h))
                  (list '= (list '+ h h) 'bqe_)
                  (list 'IN lhs 'RR) (list 'IN (bqn-nr w) 'RR) (list 'IN (bqn-nr u) 'RR) (list 'IN (bqn-nr v) 'RR)
                  (list 'IN (bqn-cn 'c) 'RR) (list 'IN (bqn-cn 'd) 'RR) (list 'IN h 'RR) '(IN bqe_ RR)))))
  (dk-cite! 'rr-le-of-le-add-all-pos lhs rhs)
  (dk-ass!))
(bqn-qed! 'coset-norm-triangle)

;;; ---- the cosets of products, and submultiplicativity -------------------------------------
(define bqn-QVMUL '(QNA-VMUL a ii))
(define (bqn-vp c d) (list bqn-QVMUL c d))
(define (bqn-prod-in! c d u v)
  (let* ((w (bqn-mu u v))
         (pairs (list (list (bqn-cl w) (bqn-vp (bqn-cl u) (bqn-cl v))) (list (bqn-cl u) c) (list (bqn-cl v) d))))
    (bqn-pts! w)
    (dk-cite! 'qna-vmul-computes 'a 'ii u v)
    (if (not (dk-asm? (list 'IN w (bqn-vp c d))))
        (bqn-carry! (dk-cite! 'class-self bqn-S w) pairs))
    (if (not (dk-asm? (list 'IN (bqn-vp c d) bqn-QS)))
        (bqn-carry! (dk-cite! 'class-in-quotient bqn-S w) pairs))
    w))
;;; t in RR, 0 <= t in context: split on 0 < t / 0 = t
(define (bqn-zero-or-pos! t body-pos body-zero)
  (use-em (list '< 0 t)
    body-pos
    (lambda ()
      (dk-real! 0)
      (dk-cite! 'rr-le-cases 0 t)
      (dk-have! (list '= 0 t) (lambda () (prop)))
      (body-zero))))
(define (bqn-comm! p q)       ; land p q = q p for typed reals
  (let ((e (list '= (list '* p q) (list '* q p))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    (dk-real! (list '* p q)) (dk-real! (list '* q p))
    e))

(sp (bqn-cn2-st (list '<= (bqn-cn (bqn-vp 'c 'd)) (list '* (bqn-cn 'c) (bqn-cn 'd)))))
(dk-peel!)
(bqn-setup!)
(bqn-cn-real! 'c) (bqn-cn-real! 'd)
(let* ((x (bqn-rep! 'c)) (y (bqn-rep! 'd)))
  (bqn-member! 'c x) (bqn-member! 'd y)
  (bqn-nt! x) (bqn-nt! y)
  (bqn-prod-in! 'c 'd x y)
  (bqn-cn-real! (bqn-vp 'c 'd))
  (let* ((B (bqn-cn (bqn-vp 'c 'd))) (C (bqn-cn 'c)) (D (bqn-cn 'd))
         (stepA (list 'FORALL 'bqv_ (list 'IMPLIES '(IN bqv_ d) (list '<= B (list '* C (bqn-nr 'bqv_)))))))
    (dk-have! stepA
      (lambda ()
        (dk-peel!)
        (bqn-member! 'd 'bqv_)
        (let ((N (bqn-nt! 'bqv_)))
          (bqn-zero-or-pos! N
            (lambda ()
              (dk-have! (list 'FORALL 'bqu_ (list 'IMPLIES '(IN bqu_ c) (list '<= B (list '* N (bqn-nr 'bqu_)))))
                (lambda ()
                  (dk-peel!)
                  (bqn-member! 'c 'bqu_)
                  (let* ((M (bqn-nt! 'bqu_)) (w (bqn-prod-in! 'c 'd 'bqu_ 'bqv_)))
                    (bqn-nt! w)
                    (dk-cite! 'coset-norm-le 'a 'ii (bqn-vp 'c 'd) w)
                    (dk-cite! 'bal-uba-vnrm-submult 'a 'bqu_ 'bqv_)
                    (let ((e (bqn-comm! M N)))
                      (dk-ineq! (list '<= B (bqn-nr w)) (list '<= (bqn-nr w) (list '* M N)) e
                                (list 'IN B 'RR) (list 'IN (bqn-nr w) 'RR) (list 'IN (list '* M N) 'RR) (list 'IN (list '* N M) 'RR))))))
              (dk-cite! 'coset-norm-scale-greatest 'a 'ii 'c N B)
              (let ((e (bqn-comm! N C)))
                (dk-ineq! (list '<= B (list '* N C)) e
                          (list 'IN B 'RR) (list 'IN (list '* N C) 'RR) (list 'IN (list '* C N) 'RR))))
            (lambda ()
              (let ((w (bqn-prod-in! 'c 'd x 'bqv_)))
                (bqn-nt! w)
                (dk-cite! 'coset-norm-le 'a 'ii (bqn-vp 'c 'd) w)
                (let ((h (dk-rewrite-h! (dk-cite! 'bal-uba-vnrm-submult 'a x 'bqv_) N 0)))
                  (subst (list '= N 0))
                  (dk-ineq! (list '<= B (bqn-nr w)) h
                            (list 'IN B 'RR) (list 'IN (bqn-nr w) 'RR) (list 'IN (bqn-nr x) 'RR) (list 'IN C 'RR)))))))))
    (bqn-zero-or-pos! C
      (lambda ()
        (dk-cite! 'coset-norm-scale-greatest 'a 'ii 'd C B)
        (dk-ass!))
      (lambda ()
        (let ((h (dk-rewrite-h! (dk-apply! stepA y) C 0)))
          (subst (list '= C 0))
          (dk-ineq! h (list 'IN B 'RR) (list 'IN (bqn-nr y) 'RR) (list 'IN D 'RR)))))))
(bqn-qed! 'coset-norm-submult)

;;; ---- scalar multiples of cosets, and homogeneity --------------------------------------------
(define (bqn-cite2! . args)        ; a citation whose antecedent is a conjunction of facts in context
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (begin (if (not (dk-asm? (caddr r)))
                   (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
               (loop (caddr r)))
        r)))
(define (bqn-scalar! z)            ; z in CC in context: land z in CARR(SCAL a)
  (dk-cite! 'bal-uba-scal-pin 'a)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a z))
(define (bqn-ac z x) (list '(ACT a) z x))
;;; u in c, CLASS u = c, z typed: land z u in z c, z c in QS; returns z u
(define (bqn-act-in! z c u)
  (let* ((w (bqn-ac z u))
         (pairs (list (list (bqn-cl w) (bqn-aq z (bqn-cl u))) (list (bqn-cl u) c))))
    (bqn-scalar! z)
    (bqn-pts! w)
    (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii z u)
    (if (not (dk-asm? (list 'IN w (bqn-aq z c))))
        (bqn-carry! (dk-cite! 'class-self bqn-S w) pairs))
    (if (not (dk-asm? (list 'IN (bqn-aq z c) bqn-QS)))
        (bqn-carry! (dk-cite! 'class-in-quotient bqn-S w) pairs))
    w))
(define (bqn-mag! z)
  (dk-cite! 'cc-magnitude-closed z)
  (dk-cite! 'cc-magnitude-nonneg z)
  (list 'magnitude z))

;;; CN(z c) <= |z| CN(c)
(sp (bqn-cn-st (list 'FORALL 'lam (list 'IMPLIES '(IN lam CC)
      (list '<= (bqn-cn (bqn-aq 'lam 'c)) (list '* '(magnitude lam) (bqn-cn 'c)))))))
(dk-peel!)
(bqn-setup!)
(bqn-cn-real! 'c)
(let* ((x (bqn-rep! 'c)))
  (bqn-member! 'c x)
  (bqn-nt! x)
  (bqn-act-in! 'lam 'c x)
  (bqn-cn-real! (bqn-aq 'lam 'c))
  (let* ((B (bqn-cn (bqn-aq 'lam 'c))) (C (bqn-cn 'c)) (m (bqn-mag! 'lam)))
    (bqn-zero-or-pos! m
      (lambda ()
        (dk-have! (list 'FORALL 'bqu_ (list 'IMPLIES '(IN bqu_ c) (list '<= B (list '* m (bqn-nr 'bqu_)))))
          (lambda ()
            (dk-peel!)
            (bqn-member! 'c 'bqu_)
            (let* ((nrm (bqn-nt! 'bqu_)) (w (bqn-act-in! 'lam 'c 'bqu_)))
              (bqn-nt! w)
              (dk-cite! 'coset-norm-le 'a 'ii (bqn-aq 'lam 'c) w)
              (dk-cite! 'bal-uba-vnrm-homog 'a 'lam 'bqu_)
              (dk-real! (list '* m nrm))
              (dk-ineq! (list '<= B (bqn-nr w)) (list '= (bqn-nr w) (list '* m nrm))
                        (list 'IN B 'RR) (list 'IN (bqn-nr w) 'RR) (list 'IN (list '* m nrm) 'RR)))))
        (dk-cite! 'coset-norm-scale-greatest 'a 'ii 'c m B)
        (dk-ass!))
      (lambda ()
        (let ((w (bqn-ac 'lam x)))
          (bqn-nt! w)
          (dk-cite! 'coset-norm-le 'a 'ii (bqn-aq 'lam 'c) w)
          (let ((h (dk-rewrite-h! (dk-cite! 'bal-uba-vnrm-homog 'a 'lam x) m 0)))
            (subst (list '= m 0))
            (dk-ineq! (list '<= B (bqn-nr w)) h
                      (list 'IN B 'RR) (list 'IN (bqn-nr w) 'RR) (list 'IN (bqn-nr x) 'RR) (list 'IN C 'RR))))))))
(bqn-qed! 'coset-norm-act-le)

;;; CN(z c) = |z| CN(c)
(sp (bqn-cn-st (list 'FORALL 'lam (list 'IMPLIES '(IN lam CC)
      (list '= (bqn-cn (bqn-aq 'lam 'c)) (list '* '(magnitude lam) (bqn-cn 'c)))))))
(dk-peel!)
(bqn-setup!)
(bqn-cn-real! 'c)
(let* ((x (bqn-rep! 'c)))
  (bqn-member! 'c x)
  (bqn-act-in! 'lam 'c x)
  (bqn-cn-real! (bqn-aq 'lam 'c))
  (let* ((B (bqn-cn (bqn-aq 'lam 'c))) (C (bqn-cn 'c)) (m (bqn-mag! 'lam)) (mC (list '* m C)))
    (dk-real! mC)
    (dk-cite! 'coset-norm-act-le 'a 'ii 'c 'lam)
    (bqn-zero-or-pos! m
      (lambda ()
        (dk-have! '(NOT (= lam 0))
          (lambda ()
            (di)
            (dk-cite! 'cc-magnitude-zero)
            (let* ((h1 (dk-rewrite-h! (list '< 0 m) 'lam 0))
                   (h2 (dk-rewrite-h! h1 '(magnitude 0) 0)))
              (dk-absurd! h2))))
        (let* ((mu '(recip lam)) (lx (bqn-ac 'lam x)))
          (bqn-cite2! 'cc-recip-closed 'lam)
          (bqn-cite2! 'cc-recip-inverse 'lam)
          (bqn-cite2! 'cc-mul-comm 'lam mu)
          (bqn-scalar! 'lam) (bqn-scalar! mu)
          (bqn-vt lx)
          (dk-cite! 'coset-norm-act-le 'a 'ii (bqn-aq 'lam 'c) mu)
          (let* ((eqc (list '= (bqn-aq mu (bqn-aq 'lam 'c)) 'c)))
            (dk-have! eqc
              (lambda ()
                (let ((e1 (dk-rewrite-h! (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii 'lam x) (bqn-cl x) 'c)))
                  (subst e1))
                (subst (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii mu lx))
                (dk-cite! 'rb3-c-act-mul-uba-as-module 'a mu 'lam x)
                (subst (list '= (bqn-ac mu lx) (bqn-ac (list '* mu 'lam) x)))
                (subst (list '= (list '* mu 'lam) (list '* 'lam mu)))
                (subst (list '= (list '* 'lam mu) 1))
                (subst (dk-cite! 'bas-act-one 'a x))
                (subst (list '= (bqn-cl x) 'c))
                (rfl)))
            (dk-cite! 'aif-magnitude-recip 'lam)
            (let* ((h0 (list '<= (bqn-cn (bqn-aq mu (bqn-aq 'lam 'c))) (list '* (list 'magnitude mu) B)))
                   (h1 (dk-rewrite-h! h0 (bqn-aq mu (bqn-aq 'lam 'c)) 'c)))
              (dk-rewrite-h! h1 (list 'magnitude mu) (list 'recip m)))))
        (let* ((rm (list 'recip m))
               (h2 (list '<= C (list '* rm B))))
          (dk-have! (list 'NOT (list '= m 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 m) m 0))))
          (bqn-cite2! 'rr-recip-closed m)
          (dk-real! (list '* rm B))
          (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '< 0 m))))
          (bqn-cite2! 'rr-mul-comm rm B)
          (bqn-cite2! 'rr-mul-comm C m)
          (dk-cite! 'rr-recip-cancel-right-rev B m)
          (let* ((h3 (dk-cite! 'rr-mul-le-right C (list '* rm B) m))
                 (h4 (dk-rewrite-h! h3 (list '* rm B) (list '* B rm) ))
                 (h5 (dk-rewrite-h! h4 (list '* (list '* B rm) m) B))
                 (h6 (dk-rewrite-h! h5 (list '* C m) mC)))
            (bqn-cite2! 'rr-leq-antisymmetric B mC)
            (dk-ass!))))
      (lambda ()
        (dk-have! (list '<= mC B)
          (lambda () (subst (list '= m 0)) (dk-ineq! (list '<= 0 B) (list 'IN B 'RR) (list 'IN C 'RR))))
        (bqn-cite2! 'rr-leq-antisymmetric B mC)
        (dk-ass!)))))
