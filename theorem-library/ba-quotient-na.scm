  (bqn-vt x) (bqn-vt y)
  (let ((iff (dk-cite! 'qmod-class-eq-iff-rev-uba-as-module 'a 'ii x y))
        (g (list '= (bqn-cl x) (bqn-cl y))))
    (dk-have! g (lambda () (keep iff (list 'IN (bqn-sb x y) 'ii)) (prop)))
    g))

(sp (bqn-st2 (list 'IMPLIES (list 'IS-CLOSED bqn-BAM 'ii)
      (list 'FORALL 'c (list 'IMPLIES (list 'IN 'c bqn-QS)
        (list 'IFF (list '= (bqn-cn 'c) 0) (list '= 'c bqn-Z)))))))
