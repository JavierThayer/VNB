;;; ---- A/I is complete (Corollary 1.11), by the criterion of complete-criterion.scm -----------------
;;; THE ROUTE.  Let f be a sequence in A/I with d(f k, f(k+1)) <= rad(k), rad summable.  Lift it: by
;;; dependent choice (dc-on-nn-pred) pick x_0 in f(0) and, from x_k in f(k), a point x_{k+1} of f(k+1)
;;; with ||x_k - x_{k+1}|| <= rad(k) + (1/2)^k (an almost-minimal member w of the coset f(k) - f(k+1),
;;; and x_{k+1} = x_k - w).  The lift has summable increments in the complete space A, so it
;;; converges to some L (summable-bound-converges), and d(f k, L + I) <= ||x_k - L|| -> 0.
(define bqn-MQ (list 'NAG-METRIC-SPACE (list 'CNA-AS-NORMED-AG bqn-NA)))
(define bqn-QVNEG (list 'VNEG bqn-Q))
(define (bqn-qdiff c d) (list bqn-QVADD c (list bqn-QVNEG d)))
(define (bqn-subst-if! e)
  (if (dk-contains? (dk-goal) (cadr e)) (subst e)))
;;; with (CLASS p) = cp and (CLASS q) = cq in context (or cp, cq literally those classes):
;;; land (= (cp - cq) (CLASS (p - q))), (IN (cp - cq) QS) and (IN (p - q) (cp - cq)); returns cp - cq
(define (bqn-diff-class! p q cp cq)
  (let* ((tq (bqn-qdiff cp cq)) (pq (bqn-sb p q)) (e (list '= tq (bqn-cl pq))))
    (bqn-vt pq)
    (bqn-pts! pq)
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (if (not (equal? cp (bqn-cl p))) (subst (list '= cp (bqn-cl p))))
            (if (not (equal? cq (bqn-cl q))) (subst (list '= cq (bqn-cl q))))
            (subst (dk-cite! 'qmod-vneg-computes-uba-as-module 'a 'ii q))
            (dk-cite! 'qmod-vadd-computes-uba-as-module 'a 'ii p (bqn-ng q))
            (dk-ass!))))
    (if (not (dk-asm? (list 'IN tq bqn-QS)))
        (dk-rewrite-h! (dk-cite! 'class-in-quotient bqn-S pq) (bqn-cl pq) tq))
    (if (not (dk-asm? (list 'IN pq tq)))
        (dk-rewrite-h! (dk-cite! 'class-self bqn-S pq) (bqn-cl pq) tq))
    tq))
;;; cu, cv in QS: land d_MQ(cu, cv) = CN(cu - cv) (cu - cv typed in QS); returns the CN term
(define (bqn-mq-dist! cu cv)
  (for-each (lambda (c)
              (if (not (dk-asm? (list 'IN c (list 'VEC bqn-NA))))
                  (dk-have! (list 'IN c (list 'VEC bqn-NA))
                    (lambda () (subst (list '= (list 'VEC bqn-NA) bqn-VQS)) (subst (list '= bqn-VQS bqn-QS)) (dk-ass!)))))
            (list cu cv))
  (let* ((e0 (dk-cite! 'nag-metric-distance-cna-as-normed-ag bqn-NA cu cv))
         (e1 (dk-rewrite-h! e0 (list 'VNRM bqn-NA) bqn-QVNRM))
         (e2 (dk-rewrite-h! e1 (list 'VADD bqn-NA) bqn-QVADD))
         (e3 (dk-rewrite-h! e2 (list 'VNEG bqn-NA) bqn-QVNEG))
         (tq (bqn-qdiff cu cv))
         (_ (if (not (dk-asm? (list 'IN tq bqn-QS)))
                (let* ((p (bqn-rep! cu)) (q (bqn-rep! cv))) (bqn-diff-class! p q cu cv))))
         (e4 (dk-cite! 'qna-vnrm-apply 'a 'ii tq))
         (e5 (dk-rewrite-h! e3 (bqn-v tq) (bqn-cn tq))))
    (bqn-cn-real! tq)
    (let ((ds (list (list 'DIST bqn-MQ) cu cv)))
      (if (not (dk-asm? (list 'IN ds 'RR)))
          (dk-have! (list 'IN ds 'RR) (lambda () (subst (list '= ds (bqn-cn tq))) (dk-ass!)))))
    (bqn-cn tq)))

