            (dk-project! '(IS-RING (SCAL a)) 'IS-UNITAL-BANACH-ALGEBRA '(IS-UNITAL-BANACH-ALGEBRA a))
            (dk-cite! 'ring-one-in '(SCAL a))
            (dk-cite! 'ring-neg-in-carr '(SCAL a) '(ONE (SCAL a)))
            (let* ((nm '((NEG (SCAL a)) (ONE (SCAL a))))
