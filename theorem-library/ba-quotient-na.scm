         (ss (dk-project! (cadr sbody) 'IS-ALG-SUBSPACE sub))
         (z (dk-project! (cadr (caddr sbody)) 'IS-ALG-SUBSPACE sub))
         (addcl (dk-project! (cadr (caddr (caddr sbody))) 'IS-ALG-SUBSPACE sub))
         (actcl (dk-project! (caddr (caddr (caddr sbody))) 'IS-ALG-SUBSPACE sub)))
    (list ss z addcl actcl left)))
(sp (bqn-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (IS-SUBMODULE (UBA-AS-MODULE a) ii)))))
(dk-peel!)
(let* ((r (bqn-ideal-open-full! 'ii))
