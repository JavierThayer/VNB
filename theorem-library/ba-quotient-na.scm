;;; ---- the read-offs of QUOTIENT-NA and QUOTIENT-BA ---------------------------------------------
(define (bqn-readoff2! name lhs rhs unfold)
  (sp (bqn-st2 (list '== lhs rhs)))
  (dk-peel!)
  (bqn-setup!)
  (dk-cite! 'uba-as-module-is-module 'a)
  (dk-cite! 'quotient-module-is-module-uba-as-module 'a 'ii)
  (dk-cite! 'qna-vnrm-fun 'a 'ii)
  (dk-cite! 'qna-vmul-fun 'a 'ii)
  (bqn-clq! '(VONE a))
  (mac unfold)
  (slot (car lhs))
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (nth-r)))
      (if (and (< n 9) (not (proof-done? *ps*)) (not (equal? g (dk-goal)))) (loop (+ n 1)))))
  (if (not (proof-done? *ps*))
      (begin (quietly (lambda () (slot (car lhs)))) (qrfl)))
  (for-each (lambda (l)
              (if (and (not (sequent-node-grounded? l))
                       (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                  (begin (dk-focus! l) (rfl))))
            (dk-open-leaves))
  (bqn-qed! name))
(define bqn-BA '(QUOTIENT-BA a ii))
(for-each
  (lambda (e)
    (bqn-readoff2! (symbol-append 'qna-ro- (car e)) (list (cadr e) bqn-NA) (caddr e) 'QUOTIENT-NA)
    (bqn-readoff2! (symbol-append 'qba-ro- (car e)) (list (cadr e) bqn-BA) (caddr e) 'QUOTIENT-BA))
  (list (list 'scal 'SCAL (list 'SCAL bqn-Q)) (list 'vec 'VEC (list 'VEC bqn-Q)) (list 'vadd 'VADD (list 'VADD bqn-Q))
        (list 'vzero 'VZERO (list 'VZERO bqn-Q)) (list 'vneg 'VNEG (list 'VNEG bqn-Q)) (list 'act 'ACT (list 'ACT bqn-Q))
        (list 'vnrm 'VNRM bqn-QVNRM) (list 'vmul 'VMUL bqn-QVMUL)))
(bqn-readoff2! 'qba-ro-vone (list 'VONE bqn-BA) (bqn-cl '(VONE a)) 'QUOTIENT-BA)

;;; ---- the laws of a normed algebra, in the shape of IS-COMPLEX-NORMED-ALGEBRA(QUOTIENT-NA) -----
(define bqn-VQS (list 'VEC bqn-Q))
(define bqn-CQ (list 'CARR (list 'SCAL bqn-Q)))
(define (bqn-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))
(define (bqn-sbcm-q!)              ; the read-offs of Q this section needs, in context
  (dk-cite! 'qmod-ro-vec-uba-as-module 'a 'ii)
  (dk-cite! 'qmod-ro-scal-uba-as-module 'a 'ii)
  (dk-cite! 'qmod-ro-vzero-uba-as-module 'a 'ii)
  (dk-cite! 'bal-uba-scal-carr 'a)
  (dk-cite! 'bal-uba-scal-pin 'a))
;;; peel; carry each coset typing to QS and each scalar typing to CC; returns the peeled names
(define (bqn-na-open! . names)
  (dk-peel!)
  (let loop () (if (memq (dk-head (dk-goal)) '(IMPLIES FORALL)) (begin (dk-peel!) (loop))))
  (bqn-setup!)
  (bqn-sbcm-q!)
  (for-each (lambda (v)
              (if (dk-asm? (list 'IN v bqn-VQS))
                  (dk-rewrite-h! (list 'IN v bqn-VQS) bqn-VQS bqn-QS))
              (if (dk-asm? (list 'IN v bqn-CQ))
                  (dk-rewrite-h! (dk-rewrite-h! (list 'IN v bqn-CQ) (list 'SCAL bqn-Q) '(SCAL a)) '(CARR (SCAL a)) 'CC)))
            (if (pair? names) names '(r_ x_ y_ z_))))
;;; type the coset expression T in QS (its coset variables have representatives in REPS)
(define (bqn-qs-type! t reps)
  (if (not (dk-asm? (list 'IN t bqn-QS)))
      (let ((tv (bqn-norm! t reps)))
        (bqn-pts! tv)
        (dk-rewrite-h! (dk-cite! 'class-in-quotient bqn-S tv) (bqn-cl tv) t))))
;;; rewrite every application (QNA-VNRM a ii)(T) of the goal to COSET-NORM(T)
(define (bqn-v-apps g)
  (cond ((not (pair? g)) '())
        ((and (equal? (car g) bqn-QVNRM) (pair? (cdr g)) (null? (cddr g))) (list (cadr g)))
        (#t (append (bqn-v-apps (car g)) (bqn-v-apps (cdr g))))))
(define (bqn-v-rewrite! reps)
  (for-each (lambda (t)
              (bqn-qs-type! t reps)
              (subst (dk-cite! 'qna-vnrm-apply 'a 'ii t)))
            (let dedup ((l (bqn-v-apps (dk-goal))) (acc '()))
              (cond ((null? l) (reverse acc)) ((member (car l) acc) (dedup (cdr l) acc)) (#t (dedup (cdr l) (cons (car l) acc)))))))
(define (bqn-na-law! name stmt cn-lemma args)
  (sp (bqn-st2 stmt))
  (bqn-na-open!)
  (let ((reps (bqn-reps! (filter (lambda (v) (dk-asm? (list 'IN v bqn-QS))) '(x_ y_ z_)))))
    (if (dk-contains? (dk-goal) (list 'VZERO bqn-Q)) (subst (list '= (list 'VZERO bqn-Q) bqn-Z)))
    (bqn-v-rewrite! reps)
    (let ((r (apply dk-cite! cn-lemma 'a 'ii args)))
      (if (and (dk-head-is? r 'AND) (not (dk-asm? (dk-goal)))) (dk-split! r)))
    (dk-ass!))
  (bqn-qed! name))

