  (dk-peel!)
  (mac unfold)
  (slot (car lhs))
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (nth-r)))
      (if (and (< n 6) (not (proof-done? *ps*)) (not (equal? g (dk-goal)))) (loop (+ n 1)))))
  (if (not (proof-done? *ps*))
      (begin (quietly (lambda () (slot (car lhs)))) (qrfl)))
  (bqn-qed! name))
(for-each (lambda (acc)
            (bqn-readoff! (symbol-append 'bqn-uam- (string->symbol (string-downcase (symbol->string acc))))
                          (list acc bqn-M) (list acc 'a) 'UBA-AS-MODULE))
          '(SCAL VEC VADD VZERO VNEG ACT))

