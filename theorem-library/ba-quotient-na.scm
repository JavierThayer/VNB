;;; ---- the algebra laws of the product on cosets ---------------------------------------------
;;; (bqn-norm! E reps) -- E a coset expression over the coset variables of REPS ((c . x) ...),
;;; built from bqn-QVADD, bqn-QACT, bqn-QVMUL; returns the vector term t of a with
;;; (= E (CLASS t)) landed (t typed in VEC a).
(define (bqn-norm! e reps)
  (cond ((assq e reps) => (lambda (p) (cdr p)))
        ((and (pair? e) (eq? (car e) 'CLASS) (equal? (cadr e) bqn-S)) (bqn-vt (caddr e)) (caddr e))
        ((and (pair? e) (member (car e) (list bqn-QVADD bqn-QVMUL)) #t)
         (let* ((t1 (bqn-norm! (cadr e) reps)) (t2 (bqn-norm! (caddr e) reps))
                (vad? (equal? (car e) bqn-QVADD))
                (t (if vad? (bqn-ad t1 t2) (bqn-mu t1 t2)))
                (want (list '= e (bqn-cl t))))
           (bqn-vt t)
           (if (not (dk-asm? want))
               (dk-have! want
                 (lambda ()
                   (bqn-norm-subst! (cadr e) t1 reps) (bqn-norm-subst! (caddr e) t2 reps)
                   (dk-cite! (if vad? 'qmod-vadd-computes-uba-as-module 'qna-vmul-computes) 'a 'ii t1 t2)
                   (dk-ass!))))
           t))
        ((and (pair? e) (equal? (car e) bqn-QACT))
         (let* ((z (cadr e)) (t1 (bqn-norm! (caddr e) reps))
                (t (bqn-ac z t1))
                (want (list '= e (bqn-cl t))))
           (bqn-scalar! z)
           (bqn-vt t)
           (if (not (dk-asm? want))
               (dk-have! want
                 (lambda ()
                   (bqn-norm-subst! (caddr e) t1 reps)
                   (dk-cite! 'qmod-act-computes-uba-as-module 'a 'ii z t1)
                   (dk-ass!))))
           t))
        (#t (error "bqn-norm!: not a coset expression" e))))
(define (bqn-norm-subst! e t reps)   ; rewrite E to (CLASS t) in the goal
  (if (not (equal? e (bqn-cl t)))
      (subst (list '= e (bqn-cl t)))))
;;; close (= L R) for coset expressions, given the a-law that equates their normal forms
(define (bqn-coset-law! L R reps law-cite!)
  (let* ((tl (bqn-norm! L reps)) (tr (bqn-norm! R reps)))
    (bqn-norm-subst! L tl reps)
    (bqn-norm-subst! R tr reps)
    (law-cite!)
    (subst (list '= tl tr))
    (bqn-pts! tr)
    (dk-cite! 'class-in-quotient bqn-S tr)
    (rfl)))
(define (bqn-reps! cs)               ; representatives of the coset variables CS
  (map (lambda (c) (let ((x (bqn-rep! c))) (cons c x))) cs))
(define (bqn-cos3-st body)
