(define (bqn-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-quotient-na: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-quotient-na: unfinished" name))))
(define (bqn-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define bqn-one '(VONE a))

;;; open IS-LEFT-IDEAL a ii: land ii subset VEC a, 0 in ii, and the left-multiplication clause
(define (bqn-ideal-open! ii)
  (let* ((lf (list 'IS-LEFT-IDEAL 'a ii))
         (body (caddr (dk-cite! 'IS-LEFT-IDEAL 'a ii)))
         (sub (dk-project! (cadr body) 'IS-LEFT-IDEAL lf))
         (left (dk-project! (caddr body) 'IS-LEFT-IDEAL lf))
         (sbody (caddr (dk-cite! 'IS-ALG-SUBSPACE 'a ii)))
         (ss (dk-project! (cadr sbody) 'IS-ALG-SUBSPACE sub))
         (z (dk-project! (cadr (caddr sbody)) 'IS-ALG-SUBSPACE sub)))
    (list ss z left)))
;;; y in ii => y in VEC a
(define (bqn-in-vec! ss y)
  (dk-have! (list 'IN y '(VEC a))
    (lambda ()
      (mac-h 'subset-def ss)
      (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(VEC a))
                                           (dk-contains? h 'ii)))
                          "the subset clause")
                 y)
      (dk-ass!))))

;;; ==== TARGET 3: for a left ideal of a unital algebra, 1 not in I iff I /= A ===============
(sp (bqn-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii)
  (IFF (NOT (IN (VONE a) ii)) (NOT (= ii (VEC a))))))))
(dk-peel!)
(dk-cite! 'bal-uba-vone-in 'a)
(let* ((r (bqn-ideal-open! 'ii))
       (ss (car r)) (left (caddr r)))
  (dk-iff! (lambda (g) (equal? g '(NOT (= ii (VEC a)))))
    (lambda ()
      (di)
      (let ((h (dk-rewrite-h! (list 'IN bqn-one '(VEC a)) '(VEC a) 'ii)))
        (keep h (list 'NOT h))
        (prop)))
    (lambda ()
      (di)
      (let ((ch (dk-cite! 'class-extensionality 'ii '(VEC a))))
        (detach-with! ch
          (lambda ()
            (di)
            (let ((x (cadr (cadr (dk-goal)))))
              (dk-iff! (lambda (g) (equal? g (list 'IN x '(VEC a))))
                (lambda () (bqn-in-vec! ss x))
                (lambda ()
                  (let* ((m (dk-apply! left x bqn-one))
                         (e (dk-cite! 'bal-uba-vone-right 'a x)))
                    (dk-rewrite-h! m (cadr e) x)
                    (dk-ass!))))))))
      (keep '(= ii (VEC a)) '(NOT (= ii (VEC a))))
      (prop))))
(bqn-qed! 'ba-ideal-proper-iff)

