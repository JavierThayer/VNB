(define (bqn-occurs? x t)
  (or (equal? x t) (and (pair? t) (or (bqn-occurs? x (car t)) (bqn-occurs? x (cdr t))))))

;;; type a vector expression of a
(define (bqn-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bqn-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x '(VZERO a)) (dk-cite! 'module-vzero-in-uba-as-module 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bqn-vt (cadr x)) (bqn-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bqn-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bqn-vt (cadr x)) (bqn-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bqn-vt (caddr x))
           (dk-cite! 'module-act-type-uba-as-module 'a (cadr x) (caddr x)) x)
          (#t (error "bqn-vt: cannot type" (expression->string x))))))

