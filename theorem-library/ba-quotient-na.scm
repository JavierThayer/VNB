  (bqn-member! 'c x)
  (dk-iff! (lambda (g) (equal? g (list '= 'c bqn-Z)))
    (lambda ()
      ;; CN(c) = 0 => c = 0 + I: x is in the closure of I, so in I
      (dk-have! (list 'IN x 'ii)
        (lambda ()
          (use-em (list 'IN x 'ii)
            (lambda () (dk-ass!))
            (lambda ()
              (let* ((cmpl (list 'COMPLEMENT-IN (list 'PTS bqn-BAM) 'ii))
                     (op (list 'IS-OPEN bqn-BAM cmpl))
                     (ballf (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y cmpl)
                              (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL bqn-BAM 'y 'r) cmpl)))))))
                (dk-project! op 'is-closed (list 'IS-CLOSED bqn-BAM 'ii))
                (dk-project! ballf 'is-open op)
                (dk-have! (list 'IN x (list 'PTS bqn-BAM)) (lambda () (subst (list '= (list 'PTS bqn-BAM) '(VEC a))) (dk-ass!)))
                (let ((cm (dk-cite! 'complement-in-membership-rev (list 'PTS bqn-BAM) 'ii x)))
                  (dk-have! (list 'IN x cmpl) (lambda () (keep cm (list 'IN x (list 'PTS bqn-BAM)) (list 'NOT (list 'IN x 'ii))) (prop))))
                (let* ((ex (dk-apply! ballf x))
                       (r (dk-skolem! ex)))
                  (dk-split-all!)
                  (bqn-pos-parts! r)
                  (let* ((u (bqn-approx! 'c r))
                         (y (bqn-sb x u))
                         (bl (list 'BALL bqn-BAM x r))
                         (ds (list (list 'DIST bqn-BAM) x y)))
                    (bqn-vt y)
                    (dk-have! (list '= (bqn-cl x) (bqn-cl u)) (lambda () (subst (list '= (bqn-cl x) 'c)) (subst (list '= (bqn-cl u) 'c)) (rfl)))
                    (bqn-cl-eq-in! x u)
                    (dk-cite! 'ban-dist 'a x y)
                    (dk-cite! 'ban-sub-sub 'a x u)
                    (let ((de (dk-have! (list '= ds (bqn-nr u))
                                 (lambda () (subst (list '= ds (bqn-nr (bqn-sb x y)))) (subst (list '= (bqn-sb x y) u)) (rfl)))))
                      (dk-have! (list 'IN ds 'RR) (lambda () (subst (list '= ds (bqn-nr u))) (dk-ass!)))
                      (dk-have! (list 'IN y (list 'PTS bqn-BAM)) (lambda () (subst (list '= (list 'PTS bqn-BAM) '(VEC a))) (dk-ass!)))
                      (dk-have! (list '<= ds r)
                        (lambda () (dk-ineq! (list '= ds (bqn-nr u)) (list '< (bqn-nr u) (list '+ C r)) (list '= C 0)
                                             (list 'IN ds 'RR) (list 'IN (bqn-nr u) 'RR) (list 'IN C 'RR) (list 'IN r 'RR))))
                      (dk-have! (list 'NOT (list '= ds r))
                        (lambda () (di)
                          (dk-absurd! (list '= ds r) (list '= ds (bqn-nr u)) (list '< (bqn-nr u) (list '+ C r)) (list '= C 0)
                                      (list 'IN ds 'RR) (list 'IN (bqn-nr u) 'RR) (list 'IN C 'RR) (list 'IN r 'RR))))
                      (let ((bm (dk-cite! 'ball-membership bqn-BAM x r y)))
                        (dk-have! (list 'IN y bl)
                          (lambda () (keep bm (list 'IN y (list 'PTS bqn-BAM)) (list '<= ds r) (list 'NOT (list '= ds r))) (prop))))
                      (let ((sf (list 'FORALL 'bqs_ (list 'IMPLIES (list 'IN 'bqs_ bl) (list 'IN 'bqs_ cmpl)))))
                        (dk-project! sf 'subset-def (list 'SUBSET bl cmpl))
                        (dk-apply! sf y))
                      (let ((cm2 (dk-cite! 'complement-in-membership (list 'PTS bqn-BAM) 'ii y)))
                        (keep cm2 (list 'IN y cmpl) (list 'IN y 'ii))
                        (prop))))))))))
      (dk-have! (list 'IN (bqn-sb x '(VZERO a)) 'ii)
        (lambda () (dk-cite! 'ring-add-right-id-uba-as-ring 'a x) (subst (list '= (bqn-ng '(VZERO a)) '(VZERO a))) (subst (list '= (bqn-ad x '(VZERO a)) x)) (dk-ass!)))
      (bqn-in-cl-eq! x '(VZERO a))
      (subst (list '= 'c (bqn-cl x)))
      (dk-ass!))
    (lambda ()
      ;; c = 0 + I => CN(c) = 0
      (bqn-pts! '(VZERO a))
      (let* ((m (dk-rewrite-h! (dk-cite! 'class-self bqn-S '(VZERO a)) bqn-Z 'c)))
        (bqn-nt! '(VZERO a))
        (dk-cite! 'coset-norm-le 'a 'ii 'c '(VZERO a))
