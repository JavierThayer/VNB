;;; bta-trace.scm -- BA-1111-A, 2026-11-11.  BanachAlgebras.pdf ch. 2 s.2-3: the Hilbert-Schmidt
;;; inner product as an inner product, HS norm of an operator diagonal in a basis (2.11), and the
;;; trace-class laws 2.13-2.23 on top of the TH3 development (th3-vocab: IS-TRACE-CLASS is
;;; Def. 2.13, T = A B with A, B Hilbert-Schmidt; OP-TRACE is sum <T e|e> over CANON-ONB).
;;;
;;;   trace-class-is-hs          Remark 2.14: a trace-class operator is Hilbert-Schmidt
;;;   trace-class-comp-left      Prop 2.18: S bounded, T trace class => S T trace class
;;;   trace-class-comp-right     Prop 2.18: T S trace class
;;;   op-trace-factor            Def 2.13 / Lemma 2.15: tr(A B) = <B | A*>_HS
;;;   op-trace-comm-bounded      Prop 2.20: tr(T S) = tr(S T)
;;;   trace-class-adjoint        Prop 2.23: T* trace class
;;;   op-trace-adjoint           Prop 2.23: tr(T*) = conj tr(T)
;;;   hs-ip-homog-left           Prop 2.7: <c S | T>_HS = c <S | T>_HS
;;;   hs-ip-self-nonneg          Prop 2.7: <T | T>_HS real and >= 0
;;;   hs-sum-zero-vanishes       sum ||T e_i||^2 = 0 => T x = 0 for every x
;;;   hs-ip-definite             Prop 2.7: <T | T>_HS = 0 => T = 0 (pointwise)
;;;   trace-pairing-nondeg-left  Prop 2.22: tr(S T) = 0 for all bounded S => T = 0
;;;   hs-sum-eigenbasis          T e_i = l_i e_i on an ONB => sum ||T e_i||^2 = sum |l_i|^2
;;;   hs-sum-compact-sa          Prop 2.11: T compact self-adjoint: some eigenbasis with (43)
;;;   rank-one-op-hs             a rank-one operator is Hilbert-Schmidt
;;;   trace-pairing-nondeg-right Prop 2.22: tr(S T) = 0 for all trace-class T => S = 0
;;;
;;; LOAD WINDOW: after theorem-library/hs-inner-product-3 (load.scm 4447: hs-ip-self,
;;; trace-class-comp, op-trace-scale), hilbert-schmidt (4293), th3-eigen-normalized /
;;; th3a4-spectral (sa-eigen-expansion), cc-sums-ptwise (4444), ba-bh (op-adjoint-*).
;;; Library: operator-algebras.  Helper prefix bta-.
;;; ---- helpers copied from hs-inner-product-3.scm (tb2- renamed bta-) ----
(define (bta-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (bta-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (bta-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (bta-close!)
  (cond ((not (bta-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (bta-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (bta-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (bta-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))))
(define (bta-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (bta-cc! (cadr t)) (bta-cc! (caddr t))
         (bta-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'conjugate))
         (bta-cc! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bta-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t))
        (#t (error "bta-cc!: cannot type in CC" (expression->string t)))))
(define (bta-nag!)
  (if (not (dk-asm? '(IS-NORMED-AG CC-NAG))) (fact 'cc-nag-is-normed-ag))
  (if (not (dk-asm? '(== (CARR CC-NAG) CC))) (fact 'cc-nag@carr)))
(define (bta-carr! form)          ; form mentions CC where CARR CC-NAG is wanted, given as the target
  (if (not (dk-asm? form))
      (dk-have! form (lambda () (subst '(= (CARR CC-NAG) CC)) (bta-close!)))))
(define (bta-pw dd h body-of)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ dd) (list '= (list h 'z_) (body-of 'z_)))))
(define (bta-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (bta-ns w y) (list '* (list 'IP-NORM w y) (list 'IP-NORM w y)))
(define (bta-lam-ns w ix e t) (list 'VNB-LAMBDA 'kqk_ ix (bta-ns w (list t (list e 'kqk_)))))
(define (bta-Q w ix e s t) (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP w) (list s (list e 'kqk_)) (list t (list e 'kqk_)))))
(define (bta-qsum w ix e s t) (list 'CC-FAMILY-SUM (bta-Q w ix e s t)))
(define (bta-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (if (not (dk-asm? onf)) (dk-project! onf 'is-orthonormal-basis onb))
    (if (not (dk-asm? (list 'IN e (list 'FUN ix (list 'VEC v)))))
        (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf))
    (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix (list 'VEC v) e))))
(define (bta-hs-bounded! v w t)
  (let ((bx (list 'IN t (list 'BOUNDED-OPS v w))))
    (if (not (dk-asm? bx))
        (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT v w t)))))
    (if (not (dk-asm? (list 'IN t (list 'FUN (list 'VEC v) (list 'VEC w))))) (fact 'bop-fun v w t))))
(define (bta-pt! v w ix e ts k)
  (bta-ap! e ix (list 'VEC v) k)
  (for-each (lambda (t) (bta-ap! t (list 'VEC v) (list 'VEC w) (list e k))) ts))
(define (bta-ns-type! w y)
  (let ((n (list 'IP-NORM w y)))
    (if (not (dk-asm? (list 'IN n 'RR))) (fact 'ip-norm-in-rr w y))
    (if (not (dk-asm? (list '<= 0 n))) (fact 'ip-norm-nonneg w y))
    (if (not (dk-asm? (list 'IN (bta-ns w y) 'RR)))
        (begin (bta-and! (list 'IN n 'RR) (list 'IN n 'RR)) (fact 'rr-mul-closed n n)))
    (if (not (dk-asm? (list '<= 0 (bta-ns w y)))) (fact 'rr-sq-nonneg n))))
(define (bta-nn-univ L ix) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ix) (list '<= 0 (list L 'z_)))))
(define (bta-ns-fam! v w ix e t)
  (let ((L (bta-lam-ns w ix e t)))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'RR))))
        (dk-have! (list 'IN L (list 'FUN ix 'RR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (bta-pt! v w ix e (list t) k)
                  (bta-ns-type! w (list t (list e k)))
                  (bta-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'CC))))
        (dk-have! (list 'IN L (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (bta-pt! v w ix e (list t) k)
                  (bta-ns-type! w (list t (list e k)))
                  (bta-cc! (bta-ns w (list t (list e k))))
                  (bta-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (bta-nn-univ L ix)))
        (dk-have! (bta-nn-univ L ix)
          (lambda ()
            (let ((k (dk-di-var!)))
              (bta-pt! v w ix e (list t) k)
              (bta-ns-type! w (list t (list e k)))
              (dk-lam-b!)
              (bta-close!)))))
    
    (if (and (dk-asm? (list 'IS-HILBERT-SCHMIDT v w t)) (not (dk-asm? (list 'IN (list 'ESUM L) 'RR))))
        (let* ((r (bta-cite! 'hs-sum-real-any-basis v w t ix e))
               (u (dk-cite! 'hs-sum-unfold v w ix e t)))
          (dk-rewrite-h! r (cadr u) (caddr u))))
    L))
(define (bta-ns-sums! L ix)
  (bta-dom! L ix 'RR)
  (let ((nn (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'DOM L)) (list '<= 0 (list L 'z_))))))
    (if (not (dk-asm? nn))
        (dk-have! nn (lambda () (subst (list '= (list 'DOM L) ix)) (bta-close!)))))
  (bta-cite! 'esum-sums-to-cc L))
(define (bta-fin!)
  (cond ((not (bta-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        (#t (dk-lam-b!) (bta-close!))))
(define (bta-vty! v w ops y)
  (for-each (lambda (op) (bta-ap! op (list 'VEC v) (list 'VEC w) y)) ops))
(define (bta-ipty! w a b)
  (if (not (dk-asm? (list 'IN (list (list 'IP w) a b) 'CC))) (fact 'cips-ip-type w a b)))
(define (bta-qfam-type! v w ix e s t)
  (let ((fam (bta-Q w ix e s t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (bta-ap! e ix (list 'VEC v) k)
                  (bta-vty! v w (list s t) (list e k))
                  (bta-ipty! w (list s (list e k)) (list t (list e k)))
                  (bta-fin!)))
              (lambda () (ass))))))
    fam))
(define (bta-one!)
  (if (not (dk-asm? '(IN 1 RR))) (dk-have! '(IN 1 RR) (lambda () (arith))))
  (bta-cc! 1))
(define (bta-qcc! v w s t ix e)
  (let ((qq (bta-qsum w ix e s t)))
    (if (not (dk-asm? (list 'IN qq 'CC)))
        (dk-split-all! (list (bta-cite! 'hs-ip-family-sums v w s t ix e))))
    (bta-cc! (list 'conjugate qq))
    qq))
(define (bta-cb-pt! v cl k)
  (let ((cb (caddr cl)))
    (bta-ap! cl cb (list 'VEC v) k)
    (if (not (dk-asm? (list '= (list cl k) k)))
        (dk-have! (list '= (list cl k) k) (lambda () (dk-lam-b!) (bta-close!))))
    (if (not (dk-asm? (list 'IN k (list 'VEC v))))
        (dk-rewrite-h! (list 'IN (list cl k) (list 'VEC v)) (list cl k) k))))
(define (bta-tr v ix e t)
  (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP v) (list t (list e 'kqk_)) (list e 'kqk_))))
(define (bta-tr-type! v ix e t)
  (let ((fam (bta-tr v ix e t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (bta-ap! e ix (list 'VEC v) k)
                  (bta-vty! v v (list t) (list e k))
                  (bta-ipty! v (list t (list e k)) (list e k))
                  (bta-fin!)))
              (lambda () (ass))))))
    fam))
(define (bta-canon! v)
  (let* ((cb (list 'CANON-ONB v)) (cl (list 'VNB-LAMBDA 'kqe_ cb 'kqe_)))
    (if (not (dk-asm? (list 'IS-ORTHONORMAL-BASIS v cb cl))) (fact 'canon-onb-is-onb v))
    (bta-onb! v cb cl)
    (cons cb cl)))
(define (bta-unique! fam dd r1 r2)
  (bta-nag!)
  (bta-dom! fam dd 'CC)
  (bta-carr! (list 'IN fam (list 'FUN (list 'DOM fam) '(CARR CC-NAG))))
  (bta-carr! (list 'IN r1 '(CARR CC-NAG)))
  (bta-carr! (list 'IN r2 '(CARR CC-NAG)))
  (bta-and! (list 'SUMS-TO 'CC-NAG fam r1) (list 'SUMS-TO 'CC-NAG fam r2))
  (bta-cite! 'sums-to-unique 'CC-NAG fam r1 r2))
;;; ---- end of copied helpers ----

;;; ---- local helpers ----
(define (bta-some-onb! v)
  (let* ((ex (bta-cite! 'onb-exists v))
         (ixv (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ixv))) "the ONB family"))
         (ev (dk-skolem! ex2 #t)))
    (bta-onb! v ixv ev)
    (cons ixv ev)))

;;; the existential half of IS-TRACE-CLASS(v, t), read off the definition
(define (bta-tc-ex t)
  (list 'FORSOME 'kqa_ (list 'AND '(IS-HILBERT-SCHMIDT v v kqa_)
     (list 'FORSOME 'kqb_ (list 'AND '(IS-HILBERT-SCHMIDT v v kqb_) (list '= t '(BOP-COMP v kqa_ kqb_)))))))
;;; IS-TRACE-CLASS(v, t) in context (kept): skolemise T = A B; returns (a . b) with
;;; IS-HILBERT-SCHMIDT of both, both bounded and in FUN, and (= t (BOP-COMP v a b)) landed
(define (bta-open-tc! t)
  (let ((tc (list 'IS-TRACE-CLASS 'v t))
        (bx (list 'IN t '(BOUNDED-OPS v v)))
        (ex (bta-tc-ex t)))
    (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class tc))
    (if (not (dk-asm? ex)) (dk-project! ex 'is-trace-class tc))
    (let* ((a (dk-skolem! (or (dk-ctx-form ex) ex) #t))
           (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q a)
                                          (dk-contains? q 'BOP-COMP)))
                         "the factor B"))
           (b (dk-skolem! ex2 #t)))
      (bta-hs-bounded! 'v 'v a)
      (bta-hs-bounded! 'v 'v b)
      (cons a b))))
(define (bta-comp x y) (list 'BOP-COMP 'v x y))
(define (bta-adj x) (list 'OP-ADJOINT 'v 'v x))
(define (bta-bdd! x)
  (if (not (dk-asm? (list 'IN x '(BOUNDED-OPS v v))))
      (error "bta-bdd!: not typed bounded" (expression->string x)))
  (if (not (dk-asm? (list 'IN x '(FUN (VEC v) (VEC v))))) (fact 'bop-fun 'v 'v x)))
(define (bta-comp-bdd! x y)
  (let ((c (bta-comp x y)))
    (if (not (dk-asm? (list 'IN c '(BOUNDED-OPS v v)))) (bta-cite! 'bop-comp-bounded 'v x y))
    (bta-bdd! c)
    c))
(define (bta-adj-bdd! x)
  (let ((c (bta-adj x)))
    (if (not (dk-asm? (list 'IN c '(BOUNDED-OPS v v)))) (bta-cite! 'op-adjoint-bounded 'v 'v x))
    (bta-bdd! c)
    c))

;;; ====================================================================
;;; trace-class-is-hs (Remark 2.14)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_))
      '(IS-HILBERT-SCHMIDT v v t_)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((ab (bta-open-tc! 't_)) (a (car ab)) (b (cdr ab)))
  (bta-cite! 'hs-comp-right 'v b a)
  (subst (list '= 't_ (bta-comp a b)))
  (bta-close!))
(bta-done! 'trace-class-is-hs)

;;; ====================================================================
;;; trace-class-comp-left / -right (Prop 2.18)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IN s_ (BOUNDED-OPS v v)) (IS-TRACE-CLASS v t_))
      '(IS-TRACE-CLASS v (BOP-COMP v s_ t_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((ab (bta-open-tc! 't_)) (a (car ab)) (b (cdr ab)))
  (bta-bdd! 's_)
  (bta-cite! 'hs-comp-left 'v 's_ a)
  (bta-comp-bdd! 's_ a)
  (let ((as (bta-cite! 'bop-comp-assoc 'v 's_ a b)))
    (subst (list '= 't_ (bta-comp a b)))
    (subst (list '= (bta-comp 's_ (bta-comp a b)) (bta-comp (bta-comp 's_ a) b)))
    (bta-cite! 'trace-class-comp 'v (bta-comp 's_ a) b)
    (bta-close!)))
(bta-done! 'trace-class-comp-left)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IN s_ (BOUNDED-OPS v v)) (IS-TRACE-CLASS v t_))
      '(IS-TRACE-CLASS v (BOP-COMP v t_ s_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((ab (bta-open-tc! 't_)) (a (car ab)) (b (cdr ab)))
  (bta-bdd! 's_)
  (bta-cite! 'hs-comp-right 'v 's_ b)
  (bta-comp-bdd! b 's_)
  (bta-cite! 'bop-comp-assoc 'v a b 's_)
  (subst (list '= 't_ (bta-comp a b)))
  (subst (list '= (bta-comp (bta-comp a b) 's_) (bta-comp a (bta-comp b 's_))))
  (bta-cite! 'trace-class-comp 'v a (bta-comp b 's_))
  (bta-close!))
(bta-done! 'trace-class-comp-right)

;;; ====================================================================
;;; op-trace-factor (Def 2.13 / Lemma 2.15): tr(A B) = <B | A*>_HS
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(a_ b_) '((IS-HILBERT-SCHMIDT v v a_) (IS-HILBERT-SCHMIDT v v b_))
      '(= (OP-TRACE v (BOP-COMP v a_ b_)) (HS-IP v v b_ (OP-ADJOINT v v a_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(bta-hs-bounded! 'v 'v 'a_)
(bta-hs-bounded! 'v 'v 'b_)
(bta-nag!)
(let* ((cc_ (bta-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (as (bta-adj-bdd! 'a_))
       (ab (bta-comp-bdd! 'a_ 'b_)))
  (bta-cite! 'hs-adjoint 'v 'v 'a_)
  (let* ((tf (bta-cite! 'trace-family-comp 'v 'a_ 'b_ cb cl))
         (parts (dk-split! tf))
         (eqn (car (filter (lambda (f) (dk-head-is? f '=)) parts)))
         (hi (bta-cite! 'hs-ip-any-basis 'v 'v 'b_ as cb cl))
         (qq (bta-qcc! 'v 'v 'b_ as cb cl)))
    (subst (bta-cite! 'op-trace-canon 'v ab))
    (subst eqn)
    (subst hi)
    (bta-close!)))
(bta-done! 'op-trace-factor)

;;; ====================================================================
;;; op-trace-comm-bounded (Prop 2.20): T trace class, S bounded: tr(T S) = tr(S T)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_ s_) '((IS-TRACE-CLASS v t_) (IN s_ (BOUNDED-OPS v v)))
      '(= (OP-TRACE v (BOP-COMP v t_ s_)) (OP-TRACE v (BOP-COMP v s_ t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((ab (bta-open-tc! 't_)) (a (car ab)) (b (cdr ab))
       (bs (bta-comp b 's_)) (sa (bta-comp 's_ a)))
  (bta-bdd! 's_)
  (bta-comp-bdd! a b)
  (bta-comp-bdd! b 's_)
  (bta-comp-bdd! 's_ a)
  (bta-cite! 'hs-comp-right 'v 's_ b)
  (bta-cite! 'hs-comp-left 'v 's_ a)
  (bta-cite! 'bop-comp-assoc 'v a b 's_)
  (bta-cite! 'bop-comp-assoc 'v b 's_ a)
  (bta-cite! 'bop-comp-assoc 'v 's_ a b)
  (let* ((c1 (bta-cite! 'op-trace-comm 'v a bs))
        (c2 (bta-cite! 'op-trace-comm 'v b sa)))
    (subst (list '= 't_ (bta-comp a b)))
    (subst (list '= (bta-comp (bta-comp a b) 's_) (bta-comp a bs)))
    (subst c1)
    (subst (list '= (bta-comp bs a) (bta-comp b sa)))
    (subst c2)
    (subst (list '= (bta-comp 's_ (bta-comp a b)) (bta-comp sa b)))
    (bta-close!)))
(bta-done! 'op-trace-comm-bounded)

;;; ====================================================================
;;; trace-class-adjoint / op-trace-adjoint (Prop 2.23)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_))
      '(IS-TRACE-CLASS v (OP-ADJOINT v v t_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((ab (bta-open-tc! 't_)) (a (car ab)) (b (cdr ab)))
  (bta-adj-bdd! a)
  (bta-adj-bdd! b)
  (bta-cite! 'hs-adjoint 'v 'v a)
  (bta-cite! 'hs-adjoint 'v 'v b)
  (bta-cite! 'op-adjoint-comp 'v a b)
  (subst (list '= 't_ (bta-comp a b)))
  (subst (list '= (bta-adj (bta-comp a b)) (bta-comp (bta-adj b) (bta-adj a))))
  (bta-cite! 'trace-class-comp 'v (bta-adj b) (bta-adj a))
  (bta-close!))
(bta-done! 'trace-class-adjoint)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_))
      '(= (OP-TRACE v (OP-ADJOINT v v t_)) (conjugate (OP-TRACE v t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(bta-nag!)
(bta-one!)
(let ((bx '(IN t_ (BOUNDED-OPS v v))))
  (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class '(IS-TRACE-CLASS v t_))))
(bta-bdd! 't_)
(let* ((as (bta-adj-bdd! 't_))
       (cc_ (bta-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (rt '(OP-TRACE v t_))
       (ra (list 'OP-TRACE 'v as)))
  (bta-cite! 'trace-class-adjoint 'v 't_)
  (dk-split-all! (list (bta-cite! 'op-trace-sums 'v 't_ cb cl)))
  (dk-split-all! (list (bta-cite! 'op-trace-sums 'v as cb cl)))
  (let* ((ft (bta-tr-type! 'v cb cl 't_))
         (fa (bta-tr-type! 'v cb cl as))
         (rc (list '* 1 (list 'conjugate rt))))
    (dk-have! (bta-pw cb fa (lambda (z) (list '* 1 (list 'conjugate (list ft z)))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (bta-cb-pt! 'v cl z)
          (bta-vty! 'v 'v (list 't_ as) z)
          (bta-vty! 'v 'v (list 't_ as) (list cl z))
          (dk-lam-b!)
          (let ((p (if (dk-contains? (dk-goal) (list cl z)) (list cl z) z)))
            (bta-ipty! 'v (list 't_ p) p)
            (bta-ipty! 'v p (list as p))
            (bta-ipty! 'v (list as p) p)
            (bta-cc! (list 'conjugate (list (list 'IP 'v) p (list as p))))
            (subst (bta-cite! 'cips-ip-conj-sym 'v p (list as p)))
            (subst (bta-cite! 'op-adjoint-ip 'v 'v 't_ p p))
            (crs)))))
    (bta-cite! 'cc-sums-to-cscale-ptwise cb 1 ft fa rt)
    (bta-cc! rc)
    (let ((un (bta-unique! fa cb ra rc)))
      (subst un)
      (crs))))
(bta-done! 'op-trace-adjoint)

;;; ====================================================================
;;; hs-ip-homog-left (Prop 2.7): <c S | T>_HS = c <S | T>_HS
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(c_ s_ t_) '((IN c_ CC) (IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      '(= (HS-IP v w (BOP-SCALE v w c_ s_) t_) (* c_ (HS-IP v w s_ t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(for-each (lambda (op) (bta-hs-bounded! 'v 'w op)) '(s_ t_))
(bta-cite! 'hs-scale 'v 'w 'c_ 's_)
(bta-hs-bounded! 'v 'w '(BOP-SCALE v w c_ s_))
(bta-nag!)
(let* ((pp '(BOP-SCALE v w c_ s_))
       (b (bta-some-onb! 'v)) (ixv (car b)) (ev (cdr b))
       (a1 (bta-cite! 'hs-ip-any-basis 'v 'w pp 't_ ixv ev))
       (a2 (bta-cite! 'hs-ip-any-basis 'v 'w 's_ 't_ ixv ev))
       (qp (bta-qcc! 'v 'w pp 't_ ixv ev))
       (qs (bta-qcc! 'v 'w 's_ 't_ ixv ev))
       (fp (bta-qfam-type! 'v 'w ixv ev pp 't_))
       (fs (bta-qfam-type! 'v 'w ixv ev 's_ 't_))
       (rr_ (list '* 'c_ qs)))
  (dk-have! (bta-pw ixv fp (lambda (z) (list '* 'c_ (list fs z))))
    (lambda ()
      (let* ((z (dk-di-var!)) (ez (list ev z)) (sz (list 's_ ez)) (tz (list 't_ ez)))
        (bta-ap! ev ixv '(VEC v) z)
        (bta-vty! 'v 'w (list 's_ 't_ pp) ez)
        (bta-ipty! 'w sz tz)
        (dk-lam-b!)
        (subst (bta-cite! 'bop-scale-apply 'v 'w 'c_ 's_ ez))
        (subst (bta-cite! 'cips-ip-homog-left 'w 'c_ sz tz))
        (crs))))
  (bta-cite! 'cc-sums-to-scale-ptwise ixv 'c_ fs fp qs)
  (bta-cc! rr_)
  (let ((un (bta-unique! fp ixv qp rr_)))
    (subst a1) (subst a2)
    (subst un)
    (bta-close!)
    (if (bta-open?) (crs))))
(bta-done! 'hs-ip-homog-left)

;;; ====================================================================
;;; hs-ip-self-nonneg (Prop 2.7): <T | T>_HS is a nonnegative real
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(t_) '((IS-HILBERT-SCHMIDT v w t_))
      '(AND (IN (HS-IP v w t_ t_) RR) (<= 0 (HS-IP v w t_ t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(bta-hs-bounded! 'v 'w 't_)
(let* ((cc_ (bta-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (hs (list 'HS-SUM 'v 'w cb cl 't_)))
  (bta-cite! 'hs-sum-real-any-basis 'v 'w 't_ cb cl)
  (bta-cite! 'hs-sum-in-rps 'v 'w 't_ cb cl)
  (bta-cite! 'rr-pos-star-nonneg hs)
  (subst (bta-cite! 'hs-ip-self 'v 'w 't_ cb cl))
  (dk-conj-close! bta-close!))
(bta-done! 'hs-ip-self-nonneg)

;;; ====================================================================
;;; hs-sum-zero-vanishes: sum ||T e_i||^2 = 0 => T x = 0 for every x
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(t_ ix e) '((IN t_ (BOUNDED-OPS v w)) (IS-ORTHONORMAL-BASIS v ix e)
                                 (= (HS-SUM v w ix e t_) 0))
      (forall-guarded '(x_) '((IN x_ (VEC v)))
        '(= (t_ x_) (VZERO w)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(if (not (dk-asm? '(IN t_ (FUN (VEC v) (VEC w))))) (fact 'bop-fun 'v 'w 't_))
(bta-ap! 't_ '(VEC v) '(VEC w) 'x_)
(if (not (dk-asm? '(IN 0 RR))) (dk-have! '(IN 0 RR) (lambda () (arith))))
(if (not (dk-asm? '(<= 0 0))) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))))
(let* ((fb (bta-some-onb! 'w)) (jx (car fb)) (f (cdr fb))
       (tx '(t_ x_))
       (nx2 (bta-ns 'v 'x_))
       (ip '((IP w) (t_ x_) (t_ x_)))
       (b0 (bta-cite! 'hs-vector-bound 'v 'w 't_ 'ix 'e jx f 'x_)))
  (bta-ns-type! 'v 'x_)
  (bta-ns-type! 'w tx)
  (let* ((b1 (dk-rewrite-h! b0 '(HS-SUM v w ix e t_) 0))
         (e1 (bta-cite! 'etimes-real-defined nx2 0))
         (b2 (dk-rewrite-h! b1 (list 'ETIMES nx2 0) (list 'BINTIMES nx2 0)))
         (e2 (dk-cite! 'bintimes-apply nx2 0))
         (b3 (dk-rewrite-h! b2 (list 'BINTIMES nx2 0) (list '* nx2 0)))
         (e3 (bta-cite! 'rr-mul-zero nx2))
         (b4 (dk-rewrite-h! b3 (list '* nx2 0) 0))
         (e4 (bta-cite! 'ip-norm-sq 'w tx))
         (b5 (dk-rewrite-h! b4 (bta-ns 'w tx) ip)))
    (bta-cite! 'cips-ip-self-real 'w tx)
    (bta-cite! 'cips-ip-self-nonneg 'w tx)
    (bta-and! (list 'IN ip 'RR) '(IN 0 RR))
    (bta-and! b5 (list '<= 0 ip))
    (let ((z (bta-cite! 'rr-leq-antisymmetric ip 0)))
      (bta-cite! 'cips-ip-zero-vector 'w tx)
      (bta-close!))))
(bta-done! 'hs-sum-zero-vanishes)

;;; ====================================================================
;;; hs-ip-definite (Prop 2.7): <T | T>_HS = 0 => T = 0 (pointwise)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(t_) '((IS-HILBERT-SCHMIDT v w t_) (= (HS-IP v w t_ t_) 0))
      (forall-guarded '(x_) '((IN x_ (VEC v)))
        '(= (t_ x_) (VZERO w)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(bta-hs-bounded! 'v 'w 't_)
(let* ((cc_ (bta-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (hs (list 'HS-SUM 'v 'w cb cl 't_))
       (e1 (bta-cite! 'hs-ip-self 'v 'w 't_ cb cl))
       (h0 (dk-rewrite-h! '(= (HS-IP v w t_ t_) 0) '(HS-IP v w t_ t_) hs)))
  (bta-cite! 'hs-sum-zero-vanishes 'v 'w 't_ cb cl 'x_)
  (bta-close!))
(bta-done! 'hs-ip-definite)

;;; ====================================================================
;;; trace-pairing-nondeg-left (Prop 2.22, the T side): T trace class with
;;; tr(S T) = 0 for every bounded S  =>  T = 0 (pointwise)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_)
                            (FORALL s_ (IMPLIES (IN s_ (BOUNDED-OPS v v))
                                         (= (OP-TRACE v (BOP-COMP v s_ t_)) 0))))
      (forall-guarded '(x_) '((IN x_ (VEC v)))
        '(= (t_ x_) (VZERO v)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let ((bx '(IN t_ (BOUNDED-OPS v v))))
  (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class '(IS-TRACE-CLASS v t_))))
(bta-bdd! 't_)
(bta-cite! 'trace-class-is-hs 'v 't_)
(let* ((as (bta-adj-bdd! 't_)))
  (bta-cite! 'hs-adjoint 'v 'v 't_)
  (let* ((z0 (inst*! (dk-ctx-form '(FORALL s_ (IMPLIES (IN s_ (BOUNDED-OPS v v))
                                           (= (OP-TRACE v (BOP-COMP v s_ t_)) 0))))
                       as))
         (z1 (bta-cite! 'op-trace-factor 'v as 't_))
         (z2 (bta-cite! 'op-adjoint-involutive 'v 'v 't_))
         (h1 (dk-rewrite-h! (list '= (list 'OP-TRACE 'v (bta-comp as 't_)) 0)
                            (list 'OP-TRACE 'v (bta-comp as 't_)) (list 'HS-IP 'v 'v 't_ (bta-adj as))))
         (h2 (dk-rewrite-h! h1 (bta-adj as) 't_)))
    (bta-cite! 'hs-ip-definite 'v 'v 't_ 'x_)
    (bta-close!)))
(bta-done! 'trace-pairing-nondeg-left)

;;; ====================================================================
;;; hs-sum-eigenbasis: T e_i = l_i e_i on an ONB  =>  sum ||T e_i||^2 = sum |l_i|^2
;;; ====================================================================
(define (bta-eig t ix e lm)
  (list 'FORALL 'bsk_ (list 'IMPLIES (list 'IN 'bsk_ ix)
    (list '= (list t (list e 'bsk_)) (list '(ACT v) (list lm 'bsk_) (list e 'bsk_))))))
(define (bta-msq ix lm)
  (list 'VNB-LAMBDA 'kqk_ ix (list '* (list 'MAGNITUDE (list lm 'kqk_)) (list 'MAGNITUDE (list lm 'kqk_)))))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_ ix e lm) (list '(IN t_ (BOUNDED-OPS v v)) '(IS-ORTHONORMAL-BASIS v ix e)
                                        '(IN lm (FUN ix CC)) (bta-eig 't_ 'ix 'e 'lm))
      (list '= '(HS-SUM v v ix e t_) (list 'ESUM (bta-msq 'ix 'lm)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(bta-bdd! 't_)
(bta-onb! 'v 'ix 'e)
(let* ((l1 (bta-ns-fam! 'v 'v 'ix 'e 't_))
       (l2 (bta-msq 'ix 'lm))
       (unit (begin
               (dk-project! '(FORALL oni_ (IMPLIES (IN oni_ ix) (= ((IP v) (e oni_) (e oni_)) 1)))
                            'is-orthonormal-family '(IS-ORTHONORMAL-FAMILY v ix e))
               (dk-ctx-form '(FORALL oni_ (IMPLIES (IN oni_ ix) (= ((IP v) (e oni_) (e oni_)) 1))))))
       (eig (dk-ctx-form (bta-eig 't_ 'ix 'e 'lm)))
       (hs '(HS-SUM v v ix e t_)))
  (bta-cite! 'hs-sum-in-rps 'v 'v 't_ 'ix 'e)
  (dk-cite! 'hs-sum-unfold 'v 'v 'ix 'e 't_)
  (dk-fun-ext! l1 l2 'ix 'RR
    (lambda () (ass))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((k (dk-di-var!)) (c (list 'lm k)) (m (list 'MAGNITUDE c)))
            (bta-ap! 'lm 'ix 'CC k)
            (fact 'cc-magnitude-closed c)
            (bta-and! (list 'IN m 'RR) (list 'IN m 'RR))
            (fact 'rr-mul-closed m m)
            (bta-fin!)))
        (lambda () (ass))))
    (lambda (z)
      (let* ((y (list 'e z)) (c (list 'lm z)) (ay (list '(ACT v) c y)))
        (bta-ap! 'e 'ix '(VEC v) z)
        (bta-ap! 'lm 'ix 'CC z)
        (bta-cc! (list 'conjugate c))
        (inst*! eig z)
        (inst*! unit z)
        (bta-ap! 't_ '(VEC v) '(VEC v) y)
        (if (not (dk-asm? (list 'IN ay '(VEC v)))) (bta-cite! 'cips-act-type 'v c y))
        (bta-ipty! 'v y y)
        (bta-ipty! 'v y ay)
        (bta-ipty! 'v ay ay)
        (dk-lam-b!)
        (subst (list '= (list 't_ y) ay))
        (subst (bta-cite! 'ip-norm-sq 'v ay))
        (subst (bta-cite! 'cips-ip-homog-left 'v c y ay))
        (subst (bta-cite! 'cips-ip-conj-homog-right 'v c y y))
        (subst (list '= (list '(IP v) y y) 1))
        (subst (bta-cite! 'cc-magnitude-sq-conjugate c))
        (crs))))
  (subst (list '= l2 l1))
  (subst (list '= (list 'ESUM l1) hs))
  (bta-close!))
(bta-done! 'hs-sum-eigenbasis)

;;; ====================================================================
;;; hs-sum-compact-sa (Prop 2.11): T compact self-adjoint: there is an ONB of
;;; eigenvectors, with eigenvalues l_i, and sum ||T e_i||^2 = sum |l_i|^2
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_))
      (list 'FORSOME 'bsi_ (list 'FORSOME 'bse_ (list 'FORSOME 'bsl_
        (list 'AND '(IS-ORTHONORMAL-BASIS v bsi_ bse_)
          (list 'AND '(IN bsl_ (FUN bsi_ CC))
            (list 'AND (bta-eig 't_ 'bsi_ 'bse_ 'bsl_)
              (list '= '(HS-SUM v v bsi_ bse_ t_) (list 'ESUM (bta-msq 'bsi_ 'bsl_)))))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let ((bx '(IN t_ (BOUNDED-OPS v v))))
  (if (not (dk-asm? bx)) (dk-project! bx 'is-compact-op '(IS-COMPACT-OP v v t_))))
(bta-bdd! 't_)
(let* ((ex (bta-cite! 'sa-eigen-expansion 'v 't_))
       (ixv (dk-skolem! ex #t))
       (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ixv))) "the eigenbasis"))
       (ev (dk-skolem! ex2 #t))
       (ex3 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ev))) "the eigenvalues"))
       (lv (dk-skolem! ex3 #t)))
  (dk-split-all!)
  (bta-onb! 'v ixv ev)
  (let ((both (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q lv) (dk-contains? q 'conjugate)))
                       "the eigen equations")))
    (dk-have! (bta-eig 't_ ixv ev lv)
      (lambda ()
        (let* ((k (dk-di-var!))
               (inst (inst*! both k)))
          (dk-split-all! (list inst))
          (bta-close!)))))
  (bta-cite! 'hs-sum-eigenbasis 'v 't_ ixv ev lv)
  (ew ixv) (ew ev) (ew lv)
  (dk-conj-close! bta-close!))
(bta-done! 'hs-sum-compact-sa)

;;; ====================================================================
;;; rank-one-op-hs: the rank-one operator y |-> <y | a> b is Hilbert-Schmidt
;;; (sum_k ||<e_k|a> b||^2 = ||b||^2 sum_k |<a|e_k>|^2 = ||b||^2 <a|a>, Parseval)
;;; ====================================================================
(define (bta-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-cite! 'rr-pos-star-membership x)))
            (dk-only! inst (list 'IN x 'RR) (list '<= 0 x))
            (prop))))))
(define (bta-ms z) (list '* (list 'MAGNITUDE z) (list 'MAGNITUDE z)))
(define (bta-ms-type! z)
  (let ((m (list 'MAGNITUDE z)))
    (if (not (dk-asm? (list 'IN m 'RR))) (fact 'cc-magnitude-closed z))
    (if (not (dk-asm? (list 'IN (bta-ms z) 'RR)))
        (begin (bta-and! (list 'IN m 'RR) (list 'IN m 'RR)) (fact 'rr-mul-closed m m)))
    (if (not (dk-asm? (list '<= 0 (bta-ms z)))) (fact 'rr-sq-nonneg m))))
(define (bta-hs-close! ixv ev)
  (let ((g (dk-goal)))
    (cond ((not (bta-open?)) #t)
          ((dk-head-is? g 'FORSOME)
           (ew (if (eq? (cadr g) 'kqi_) ixv ev))
           (bta-hs-close! ixv ev))
          ((dk-head-is? g 'AND) (dk-conj-close! (lambda () (bta-hs-close! ixv ev))))
          (#t (bta-close!)))))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(a_ b_) '((IN a_ (VEC v)) (IN b_ (VEC v)))
      '(IS-HILBERT-SCHMIDT v v (RANK-ONE-OP v v a_ b_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((r '(RANK-ONE-OP v v a_ b_))
       (ob (bta-some-onb! 'v)) (ixv (car ob)) (ev (cdr ob))
       (c (bta-ns 'v 'b_))
       (g (list 'VNB-LAMBDA 'onk_ ixv (bta-ms (list '(IP v) 'a_ (list ev 'onk_)))))
       (h (bta-lam-ns 'v ixv ev r))
       (aa '((IP v) a_ a_)))
  (bta-cite! 'rank-one-op-bounded 'v 'v 'a_ 'b_)
  (bta-bdd! r)
  (bta-ns-type! 'v 'b_)
  (bta-cite! 'cips-ip-self-real 'v 'a_)
  (bta-cite! 'cips-ip-self-nonneg 'v 'a_)
  (let ((pv (bta-cite! 'parseval-identity 'v ixv ev 'a_)))
    (dk-have! (list 'IN g (list 'FUN ixv 'RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((lf (proof-state-focus *ps*)) (k (dk-di-var!)) (q (list '(IP v) 'a_ (list ev k))))
              (bta-ap! ev ixv '(VEC v) k)
              (bta-ipty! 'v 'a_ (list ev k))
              (bta-ms-type! q)
              (bta-rps-of-real! (bta-ms q))
              (if (not (sequent-node-grounded? lf)) (bta-fin!))))
          (lambda () (ass)))))
    (dk-have! (list 'IN h (list 'FUN ixv 'RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((lf (proof-state-focus *ps*)) (k (dk-di-var!)) (y (list r (list ev k))))
              (bta-ap! ev ixv '(VEC v) k)
              (bta-ap! r '(VEC v) '(VEC v) (list ev k))
              (bta-ns-type! 'v y)
              (bta-rps-of-real! (bta-ns 'v y))
              (if (not (sequent-node-grounded? lf)) (bta-fin!))))
          (lambda () (ass)))))
    (dk-have! (bta-pw ixv h (lambda (z) (list 'ETIMES c (list g z))))
      (lambda ()
        (let* ((z (dk-di-var!)) (ez (list ev z)) (kk (list '(IP v) ez 'a_))
               (akb (list '(ACT v) kk 'b_)) (mk (bta-ms kk)))
          (bta-ap! ev ixv '(VEC v) z)
          (bta-ipty! 'v ez 'a_)
          (bta-ipty! 'v 'a_ ez)
          (bta-cite! 'cips-act-type 'v kk 'b_)
          (bta-ms-type! kk)
          (dk-lam-b!)
          (subst (bta-cite! 'rank-one-op-apply 'v 'v 'a_ 'b_ ez))
          (subst (bta-cite! 'ip-norm-act 'v kk 'b_))
          (subst (bta-cite! 'cips-ip-conj-sym 'v ez 'a_))
          (subst (bta-cite! 'cc-magnitude-conjugate kk))
          (subst (bta-cite! 'etimes-real-defined c mk))
          (subst (dk-cite! 'bintimes-apply c mk))
          (crs))))
    (let ((es (bta-cite! 'esum-scale-ptwise c ixv g h)))
      (bta-and! (list 'IN aa 'RR) (list '<= 0 aa))
      (dk-split-all! (list (bta-cite! 'etimes-real-in c aa)))
      (mac 'is-hilbert-schmidt)
      (dk-cite! 'hs-sum-unfold 'v 'v ixv ev r)
      (let ((hsr (list 'IN (list 'HS-SUM 'v 'v ixv ev r) 'RR)))
        (dk-have! hsr
          (lambda ()
            (subst (list '= (list 'HS-SUM 'v 'v ixv ev r) (list 'ESUM h)))
            (subst es)
            (subst pv)
            (bta-close!))))
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (bta-hs-close! ixv ev)
              (bta-close!)))))))
(bta-done! 'rank-one-op-hs)

;;; ====================================================================
;;; trace-pairing-nondeg-right (Prop 2.22, the S side): S bounded with
;;; tr(S T) = 0 for every trace-class T  =>  S = 0 (pointwise).
;;; For x in H, y = S x, T = R_(y,x) o R_(y,y) (R_(a,b) z = <z|a> b) is trace class and
;;; tr(S T) = <y|y>^2.
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IN s_ (BOUNDED-OPS v v))
                            (FORALL t_ (IMPLIES (IS-TRACE-CLASS v t_)
                                         (= (OP-TRACE v (BOP-COMP v s_ t_)) 0))))
      (forall-guarded '(x_) '((IN x_ (VEC v)))
        '(= (s_ x_) (VZERO v)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(bta-nag!)
(bta-bdd! 's_)
(bta-ap! 's_ '(VEC v) '(VEC v) 'x_)
(let* ((y '(s_ x_))
       (r1 (list 'RANK-ONE-OP 'v 'v y 'x_))
       (r2 (list 'RANK-ONE-OP 'v 'v y y))
       (tt (bta-comp r1 r2))
       (st (bta-comp 's_ tt))
       (c (list '(IP v) y y))
       (hyp (dk-ctx-form '(FORALL t_ (IMPLIES (IS-TRACE-CLASS v t_) (= (OP-TRACE v (BOP-COMP v s_ t_)) 0))))))
  (bta-cite! 'rank-one-op-bounded 'v 'v y 'x_)
  (bta-cite! 'rank-one-op-bounded 'v 'v y y)
  (bta-bdd! r1) (bta-bdd! r2)
  (bta-cite! 'rank-one-op-hs 'v y 'x_)
  (bta-cite! 'rank-one-op-hs 'v y y)
  (bta-comp-bdd! r1 r2)
  (bta-comp-bdd! 's_ tt)
  (bta-cite! 'trace-class-comp 'v r1 r2)
  (bta-cite! 'trace-class-comp-left 'v 's_ tt)
  (bta-ipty! 'v y y)
  (bta-cite! 'cips-ip-self-real 'v y)
  (bta-cite! 'cips-ip-self-nonneg 'v y)
  (let* ((h0 (inst*! hyp tt))
         (cc_ (bta-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
         (fam (bta-tr-type! 'v cb cl st))
         (ex (bta-cite! 'onb-inner-product-expansion 'v cb cl y y))
         (f (caddr ex))
         (rt (list 'OP-TRACE 'v st))
         (cc2 (list '* c c)))
    (dk-split-all! (list (bta-cite! 'op-trace-sums 'v st cb cl)))
    (dk-have! (list 'IN f (list 'FUN cb 'CC))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((lf (proof-state-focus *ps*)) (k (dk-di-var!)))
              (bta-ap! cl cb '(VEC v) k)
              (bta-ipty! 'v y (list cl k))
              (bta-ipty! 'v (list cl k) y)
              (bta-cc! (list '* (list '(IP v) y (list cl k)) (list '(IP v) (list cl k) y)))
              (if (not (sequent-node-grounded? lf)) (bta-fin!))))
          (lambda () (ass)))))
    (dk-have! (bta-pw cb fam (lambda (z) (list '* c (list f z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (bta-cb-pt! 'v cl z)
          (bta-ap! cl cb '(VEC v) z)
          (dk-lam-b!)
          (let* ((p (if (dk-contains? (dk-goal) (list cl z)) (list cl z) z))
                 (k1 (list '(IP v) p y))
                 (ay (list '(ACT v) k1 y))
                 (k2 (list '(IP v) ay y))
                 (ax (list '(ACT v) k2 'x_)))
            (bta-ipty! 'v p y)
            (bta-ipty! 'v y p)
            (bta-cite! 'cips-act-type 'v k1 y)
            (bta-ipty! 'v ay y)
            (bta-cite! 'cips-act-type 'v k2 'x_)
            (bta-vty! 'v 'v (list r2) p)
            (subst (bta-cite! 'bop-comp-apply 'v 's_ tt p))
            (subst (bta-cite! 'bop-comp-apply 'v r1 r2 p))
            (subst (bta-cite! 'rank-one-op-apply 'v 'v y y p))
            (subst (bta-cite! 'rank-one-op-apply 'v 'v y 'x_ ay))
            (subst (bta-cite! 'bop-act 'v 'v 's_ k2 'x_))
            (subst (bta-cite! 'cips-ip-homog-left 'v k2 y p))
            (subst (bta-cite! 'cips-ip-homog-left 'v k1 y y))
            (crs)))))
    (bta-cite! 'cc-sums-to-scale-ptwise cb c f fam c)
    (bta-cc! cc2)
    (let* ((un (bta-unique! fam cb rt cc2))
           (h1 (dk-rewrite-h! h0 rt cc2)))
      (if (not (dk-asm? '(IN 0 RR))) (dk-have! '(IN 0 RR) (lambda () (arith))))
      (if (not (dk-asm? '(<= 0 0))) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))))
      (bta-and! (list 'IN c 'RR) '(IN 0 RR))
      (bta-and! (list '<= 0 c) '(<= 0 0))
      (dk-have! (list '= cc2 '(* 0 0)) (lambda () (subst h1) (arith)))
      (bta-cite! 'sqrt-unique c 0)
      (bta-cite! 'cips-ip-zero-vector 'v y)
      (bta-close!))))
(bta-done! 'trace-pairing-nondeg-right)
