;;; la-z2-norm.scm -- linear algebra 3.45: |det A| of a change of basis between a
;;; submodule F and the module E does not depend on the bases (LA-Z2, 2026-10-23).
;;;
;;; Setting: a module md; E is VEC(md) with free generating sequences xs, xs2 of
;;; length n; F is a set sm with relation-free sequences ys, ys2 of length n spanning
;;; it; ys = am . xs and ys2 = am2 . xs2.  The notes' |det A| presupposes a SQUARE A,
;;; i.e. F of rank n (for rank F < n the notes' 3.52 reads N_E(F) = 0); the statement
;;; is for that case.
;;;
;;; PLAN.  xs2 = um . xs and ys2 = vm . ys with um, vm invertible (3.43 and its
;;; submodule form spans-rel-free-transitive, la-z2-action).  Then
;;;   (am2 um) . xs = am2 . xs2 = ys2 = vm . ys = (vm am) . xs,
;;; so am2 um = vm am (rel-free-matact-cancel), and det am2 det um = det vm det am
;;; (det-multiplicative).  det um, det vm are units (um um' = I), so
;;; det am2 = w det am with w = det vm det um' a unit (change-of-basis-det-unit, over a
;;; commutative scalar ring).  Over ZZ-RING the units are +/- 1 (zz-mul-eq-one), whence
;;; |det am2| = |det am| (norm-independent, the notes' 3.45).
;;;
;;; Destination theorem-library/; after la-z2-action.  Library: linear-algebra.
;;; Prefix lzn-.

(define (lzn-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z2-norm: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))
(define (lzn-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lzn-cite! thm . args) (lzn-detach-all! (apply dk-cite! thm args)))
(define (lzn-open! name . args)
  (let* ((hyp (cons name args))
         (ignore (apply fact name args))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let loop ((todo (list (dk-ctx-form rhs))) (acc '()))
      (cond ((null? todo) (reverse acc))
            ((dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo)) acc))
            (#t (loop (cdr todo) (cons (car todo) acc)))))))

;;; ---- a ring rearrangement: a b = c d and b e = 1 give a = (c e) d ----
(sp (make-wff (forall-guarded '(r) '((IS-COMMUTATIVE-RING r))
  (forall-guarded '(ra rb rc rd re)
    '((IN ra (CARR r)) (IN rb (CARR r)) (IN rc (CARR r)) (IN rd (CARR r)) (IN re (CARR r))
      (= ((MUL r) ra rb) ((MUL r) rc rd)) (= ((MUL r) rb re) (ONE r)))
    '(= ra ((MUL r) ((MUL r) rc re) rd))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'r)
(fact 'ring-one-in 'r)
(dk-have! '(= ra ((MUL r) ra ((MUL r) rb re)))
  (lambda () (subst '(= ((MUL r) rb re) (ONE r))) (crs)))
(subst '(= ra ((MUL r) ra ((MUL r) rb re))))
(dk-have! '(= ((MUL r) ra ((MUL r) rb re)) ((MUL r) ((MUL r) ra rb) re)) (lambda () (crs)))
(subst '(= ((MUL r) ra ((MUL r) rb re)) ((MUL r) ((MUL r) ra rb) re)))
(subst '(= ((MUL r) ra rb) ((MUL r) rc rd)))
(crs)
(lzn-done! 'lzn-ring-cancel-unit)
(topic! 'lzn-ring-cancel-unit 'plumbing)

;;; ---- the general theorem ----
(define LZN-S '(SCAL md))
(define LZN-CS '(CARR (SCAL md)))
(define (lzn-mm a b) (list 'MATMUL LZN-S a b))
(define (lzn-ma a b) (list 'MATACT 'md a b))
(define (lzn-det a) (list 'DET LZN-S 'n a))
(define (lzn-mul a b) (list '(MUL (SCAL md)) a b))
(define LZN-HYPS
  (list '(IN xs (MAT n 1 (VEC md))) '(IN xs2 (MAT n 1 (VEC md)))
        '(IN ys (MAT n 1 (VEC md))) '(IN ys2 (MAT n 1 (VEC md)))
        '(GENERATES md n xs) '(REL-FREE md n xs) '(GENERATES md n xs2) '(REL-FREE md n xs2)
        '(SPANS md n ys sm) '(REL-FREE md n ys) '(SPANS md n ys2 sm) '(REL-FREE md n ys2)))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (IS-COMMUTATIVE-RING (SCAL md)))
  (forall-guarded '(n xs xs2 ys ys2 sm am am2)
    (append LZN-HYPS
            (list (list 'IN 'am (list 'MAT 'n 'n LZN-CS)) (list 'IN 'am2 (list 'MAT 'n 'n LZN-CS))
                  '(= ys (MATACT md am xs)) '(= ys2 (MATACT md am2 xs2))))
    (list 'FORSOME 'cbw_
      (list 'AND (list 'IN 'cbw_ LZN-CS)
        (list 'AND (list 'FORSOME 'cbv_ (list 'AND (list 'IN 'cbv_ LZN-CS) (list '= (lzn-mul 'cbw_ 'cbv_) '(ONE (SCAL md)))))
                   (list '= (lzn-det 'am2) (lzn-mul 'cbw_ (lzn-det 'am))))))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(fact 'ring-one-in LZN-S)
(fact 'identmat-type LZN-S 'n)
;; xs2 = um . xs, ys2 = vm . ys
(define (lzn-skolem-inv! ex)
  (let ((w (dk-skolem! ex)))
    (dk-cite! 'invertible-mat-is-mat LZN-S 'n w)
    w))
(let* ((um (lzn-skolem-inv! (dk-cite! 'free-generating-action-transitive 'md 'n 'xs 'xs2)))
       (vm (lzn-skolem-inv! (dk-cite! 'spans-rel-free-transitive 'md 'n 'ys 'ys2 'sm)))
       (l (lzn-mm 'am2 um))
       (r (lzn-mm vm 'am)))
  (lzn-cite! 'matmul-type LZN-S 'n 'n 'n 'am2 um)
  (lzn-cite! 'matmul-type LZN-S 'n 'n 'n vm 'am)
  (let ((as1 (lzn-cite! 'matact-assoc 'md 'n 'n 'n 1 'am2 um 'xs))
        (as2 (lzn-cite! 'matact-assoc 'md 'n 'n 'n 1 vm 'am 'xs)))
    (fact 'mat-rows-in-nn 'n 1 '(VEC md) 'ys2)
    (dk-have! (list '= (lzn-ma l 'xs) (lzn-ma r 'xs))
      (lambda ()
        (subst as1)
        (subst (list '= (lzn-ma um 'xs) 'xs2))
        (subst (list '= (lzn-ma 'am2 'xs2) 'ys2))
        (subst as2)
        (subst (list '= (lzn-ma 'am 'xs) 'ys))
        (subst (list '= (lzn-ma vm 'ys) 'ys2))
        (rfl))))
  (dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'xs l r)
  ;; the inverses and the determinants
  (let* ((inv-of (lambda (w)
                   (let* ((parts (lzn-open! 'IS-INVERTIBLE-MAT LZN-S 'n w))
                          (ex (find-first (dk-head? 'FORSOME) parts)))
                     (dk-skolem! ex))))
         (um1 (inv-of um))
         (vm1 (inv-of vm))
         (du (lzn-det um)) (du1 (lzn-det um1)) (dv (lzn-det vm)) (dv1 (lzn-det vm1))
         (da (lzn-det 'am)) (da2 (lzn-det 'am2))
         (id '(IDENTMAT (SCAL md) n)))
    (for-each (lambda (w) (dk-cite! 'det-in-carrier LZN-S 'n w)) (list um um1 vm vm1 'am 'am2))
    (fact 'det-identity-ind LZN-S 'n)
    (define (unit! p q)                      ; (= (mul (det p) (det q)) one) from p q = I
      (let ((dm (dk-cite! 'det-multiplicative LZN-S 'n p q)))
        (dk-have! (list '= (lzn-mul (lzn-det p) (lzn-det q)) '(ONE (SCAL md)))
          (lambda ()
            (subst (list '= (lzn-mul (lzn-det p) (lzn-det q)) (lzn-det (lzn-mm p q))))
            (subst (list '= (lzn-mm p q) id))
            (subst (list '= (lzn-det id) '(ONE (SCAL md))))
            (rfl)))))
    (unit! um um1) (unit! um1 um) (unit! vm vm1)
    (dk-cite! 'det-multiplicative LZN-S 'n 'am2 um)
    (dk-cite! 'det-multiplicative LZN-S 'n vm 'am)
    (dk-have! (list '= (lzn-mul da2 du) (lzn-mul dv da))
      (lambda ()
        (subst (list '= (lzn-mul da2 du) (lzn-det l)))
        (subst (list '= l r))
        (subst (list '= (lzn-det r) (lzn-mul dv da)))
        (fact 'ring-carrier-closed-mul LZN-S dv da)
        (rfl)))
    (dk-cite! 'lzn-ring-cancel-unit LZN-S da2 du dv da du1)
    (let ((w (lzn-mul dv du1)) (w2 (lzn-mul dv1 du)))
      (fact 'ring-carrier-closed-mul LZN-S dv du1)
      (fact 'ring-carrier-closed-mul LZN-S dv1 du)
      (dk-cite! 'lze-unit-mul LZN-S dv du1 dv1 du)
      (ew w)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin (ew w2) (dk-conj-close! (lambda () (ass))))
              (ass)))))))
(lzn-done! 'change-of-basis-det-unit)
(topic! 'change-of-basis-det-unit 'algebra)
(gloss! 'change-of-basis-det-unit "Over a commutative scalar ring, the determinants of two changes of basis between a submodule and the module differ by a unit factor.")

;;; ---- Corollary 3.45 over the integers ----
(define (lzn-zmul-eq! a b)                 ; (= ((MUL ZZ-RING) a b) (* a b)), a, b in ZZ
  (let ((eq (list '= (list '(MUL ZZ-RING) a b) (list '* a b))))
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (slot 'MUL)
                       (if (not (dk-lam-b!))
                           (begin (if (not (dk-asm? (list 'IN (list '* a b) 'ZZ)))
                                      (dk-have! (list 'IN (list '* a b) 'ZZ) dk-typ-close!))
                                  (rfl))))))
    eq))
;; F mentions (SCAL md): land it with ZZ-RING, then with ZZ for (CARR ZZ-RING)
(define (lzn-to-zz! f)
  (let* ((f1 (dk-rewrite-h! f LZN-S 'ZZ-RING)))
    (if (dk-contains? f1 '(CARR ZZ-RING)) (dk-rewrite-h! f1 '(CARR ZZ-RING) 'ZZ) f1)))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(n xs xs2 ys ys2 sm am am2)
    (append LZN-HYPS
            (list '(IN am (MAT n n ZZ)) '(IN am2 (MAT n n ZZ))
                  '(= ys (MATACT md am xs)) '(= ys2 (MATACT md am2 xs2))))
    '(= (abs (DET ZZ-RING n am2)) (abs (DET ZZ-RING n am)))))))
(dk-peel!)
(fact 'zz-is-commutative-ring)
(fact 'zz-is-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
(dk-rewrite-h! '(IS-COMMUTATIVE-RING ZZ-RING) 'ZZ-RING LZN-S)
(define (lzn-mat-up! a)
  (let* ((f1 (dk-rewrite-h! (list 'IN a '(MAT n n ZZ)) 'ZZ '(CARR ZZ-RING))))
    (dk-rewrite-h! f1 'ZZ-RING LZN-S)
    f1))
(lzn-mat-up! 'am)
(lzn-mat-up! 'am2)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(dk-cite! 'det-in-carrier 'ZZ-RING 'n 'am)
(dk-cite! 'det-in-carrier 'ZZ-RING 'n 'am2)
(dk-rewrite-h! '(IN (DET ZZ-RING n am) (CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
(dk-rewrite-h! '(IN (DET ZZ-RING n am2) (CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
(let* ((ex (dk-cite! 'change-of-basis-det-unit 'md 'n 'xs 'xs2 'ys 'ys2 'sm 'am 'am2))
       (w (dk-skolem! ex))
       (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f w))) (dk-asms)))
       (w2 (dk-skolem! ex2))
       (da '(DET ZZ-RING n am)) (da2 '(DET ZZ-RING n am2)))
  (lzn-to-zz! (list 'IN w LZN-CS))
  (lzn-to-zz! (list 'IN w2 LZN-CS))
  (let* ((u1 (lzn-to-zz! (list '= (lzn-mul w w2) '(ONE (SCAL md)))))
         (ignore (lzn-zmul-eq! w w2))
         (u3 (dk-rewrite-h! u1 (list '(MUL ZZ-RING) w w2) (list '* w w2)))
         (u4 (dk-rewrite-h! u3 '(ONE ZZ-RING) 1))
         (d1 (lzn-to-zz! (list '= (lzn-det 'am2) (lzn-mul w (lzn-det 'am)))))
         (ignore2 (lzn-zmul-eq! w da))
         (d2 (dk-rewrite-h! d1 (list '(MUL ZZ-RING) w da) (list '* w da))))
    (fact 'zz-in-rr da)
    (fact 'zz-in-rr w)
    (fact 'rr-abs-closed da)
    (subst (list '= da2 (list '* w da)))
    (let ((cs (dk-cite! 'zz-mul-eq-one w w2)))
      (use-cases cs
        (lambda ()
          (subst (list '= w 1))
          (fact 'zz-one-mul da)
          (subst (list '= (list '* 1 da) da))
          (rfl))
        (lambda ()
          (subst (list '= w '(- 1)))
          (dk-have! (list '= (list '* '(- 1) da) (list '- da)) (lambda () (crs)))
          (subst (list '= (list '* '(- 1) da) (list '- da)))
          (fact 'rr-abs-neg da)
          (ass))))))
(lzn-done! 'norm-independent)
(topic! 'norm-independent 'algebra)
(gloss! 'norm-independent "Linear algebra 3.45: for a submodule F of a free module E over Z, both of rank n, the absolute value of the determinant of the matrix expressing a basis of F in a basis of E does not depend on the two bases.")
