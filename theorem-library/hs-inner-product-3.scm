;;; an ONB (ix, e) of v with e a VARIABLE (onb-exists, skolemised): returns (ix . e)
;;; ---- helper defines COPIED 2026-11-10 (integration) from th3-1109/b2/tb2-hip.scm, th3-1109/b2/tb2-hip2.scm, th3-1109/b2/tb2-sums.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (tb2-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (tb2-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb2-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (tb2-close!)
  (cond ((not (tb2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tb2-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tb2-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tb2-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))))
(define (tb2-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (tb2-cc! (cadr t)) (tb2-cc! (caddr t))
         (tb2-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'conjugate))
         (tb2-cc! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (tb2-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t))
        (#t (error "tb2-cc!: cannot type in CC" (expression->string t)))))
(define (tb2-nag!)
  (if (not (dk-asm? '(IS-NORMED-AG CC-NAG))) (fact 'cc-nag-is-normed-ag))
  (if (not (dk-asm? '(== (CARR CC-NAG) CC))) (fact 'cc-nag@carr)))
(define (tb2-carr! form)          ; form mentions CC where CARR CC-NAG is wanted, given as the target
  (if (not (dk-asm? form))
      (dk-have! form (lambda () (subst '(= (CARR CC-NAG) CC)) (tb2-close!)))))
(define (tb2-pw dd h body-of)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ dd) (list '= (list h 'z_) (body-of 'z_)))))
(define (tb2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (tb2-ns w y) (list '* (list 'IP-NORM w y) (list 'IP-NORM w y)))
(define (tb2-lam-ns w ix e t) (list 'VNB-LAMBDA 'kqk_ ix (tb2-ns w (list t (list e 'kqk_)))))
(define (tb2-Q w ix e s t) (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP w) (list s (list e 'kqk_)) (list t (list e 'kqk_)))))
(define (tb2-qsum w ix e s t) (list 'CC-FAMILY-SUM (tb2-Q w ix e s t)))
(define (tb2-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (if (not (dk-asm? onf)) (dk-project! onf 'is-orthonormal-basis onb))
    (if (not (dk-asm? (list 'IN e (list 'FUN ix (list 'VEC v)))))
        (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf))
    (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix (list 'VEC v) e))))
(define (tb2-hs-bounded! v w t)
  (let ((bx (list 'IN t (list 'BOUNDED-OPS v w))))
    (if (not (dk-asm? bx))
        (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT v w t)))))
    (if (not (dk-asm? (list 'IN t (list 'FUN (list 'VEC v) (list 'VEC w))))) (fact 'bop-fun v w t))))
(define (tb2-pt! v w ix e ts k)
  (tb2-ap! e ix (list 'VEC v) k)
  (for-each (lambda (t) (tb2-ap! t (list 'VEC v) (list 'VEC w) (list e k))) ts))
(define (tb2-ns-type! w y)
  (let ((n (list 'IP-NORM w y)))
    (if (not (dk-asm? (list 'IN n 'RR))) (fact 'ip-norm-in-rr w y))
    (if (not (dk-asm? (list '<= 0 n))) (fact 'ip-norm-nonneg w y))
    (if (not (dk-asm? (list 'IN (tb2-ns w y) 'RR)))
        (begin (tb2-and! (list 'IN n 'RR) (list 'IN n 'RR)) (fact 'rr-mul-closed n n)))
    (if (not (dk-asm? (list '<= 0 (tb2-ns w y)))) (fact 'rr-sq-nonneg n))))
(define (tb2-nn-univ L ix) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ix) (list '<= 0 (list L 'z_)))))
(define (tb2-ns-fam! v w ix e t)
  (let ((L (tb2-lam-ns w ix e t)))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'RR))))
        (dk-have! (list 'IN L (list 'FUN ix 'RR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-pt! v w ix e (list t) k)
                  (tb2-ns-type! w (list t (list e k)))
                  (tb2-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'CC))))
        (dk-have! (list 'IN L (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-pt! v w ix e (list t) k)
                  (tb2-ns-type! w (list t (list e k)))
                  (tb2-cc! (tb2-ns w (list t (list e k))))
                  (tb2-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (tb2-nn-univ L ix)))
        (dk-have! (tb2-nn-univ L ix)
          (lambda ()
            (let ((k (dk-di-var!)))
              (tb2-pt! v w ix e (list t) k)
              (tb2-ns-type! w (list t (list e k)))
              (dk-lam-b!)
              (tb2-close!)))))
    
    (if (and (dk-asm? (list 'IS-HILBERT-SCHMIDT v w t)) (not (dk-asm? (list 'IN (list 'ESUM L) 'RR))))
        (let* ((r (tb2-cite! 'hs-sum-real-any-basis v w t ix e))
               (u (dk-cite! 'hs-sum-unfold v w ix e t)))
          (dk-rewrite-h! r (cadr u) (caddr u))))
    L))
(define (tb2-ns-sums! L ix)
  (tb2-dom! L ix 'RR)
  (let ((nn (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'DOM L)) (list '<= 0 (list L 'z_))))))
    (if (not (dk-asm? nn))
        (dk-have! nn (lambda () (subst (list '= (list 'DOM L) ix)) (tb2-close!)))))
  (tb2-cite! 'esum-sums-to-cc L))
(define (tb2-fin!)
  (cond ((not (tb2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        (#t (dk-lam-b!) (tb2-close!))))
(define (tb2-vty! v w ops y)
  (for-each (lambda (op) (tb2-ap! op (list 'VEC v) (list 'VEC w) y)) ops))
(define (tb2-ipty! w a b)
  (if (not (dk-asm? (list 'IN (list (list 'IP w) a b) 'CC))) (fact 'cips-ip-type w a b)))
(define (tb2-qfam-type! v w ix e s t)
  (let ((fam (tb2-Q w ix e s t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-ap! e ix (list 'VEC v) k)
                  (tb2-vty! v w (list s t) (list e k))
                  (tb2-ipty! w (list s (list e k)) (list t (list e k)))
                  (tb2-fin!)))
              (lambda () (ass))))))
    fam))
(define (tb2-one!)
  (if (not (dk-asm? '(IN 1 RR))) (dk-have! '(IN 1 RR) (lambda () (arith))))
  (tb2-cc! 1))
(define (tb2-qcc! v w s t ix e)
  (let ((qq (tb2-qsum w ix e s t)))
    (if (not (dk-asm? (list 'IN qq 'CC)))
        (dk-split-all! (list (tb2-cite! 'hs-ip-family-sums v w s t ix e))))
    (tb2-cc! (list 'conjugate qq))
    qq))
(define (tb2-cb-pt! v cl k)
  (let ((cb (caddr cl)))
    (tb2-ap! cl cb (list 'VEC v) k)
    (if (not (dk-asm? (list '= (list cl k) k)))
        (dk-have! (list '= (list cl k) k) (lambda () (dk-lam-b!) (tb2-close!))))
    (if (not (dk-asm? (list 'IN k (list 'VEC v))))
        (dk-rewrite-h! (list 'IN (list cl k) (list 'VEC v)) (list cl k) k))))
(define (tb2-tr v ix e t)
  (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP v) (list t (list e 'kqk_)) (list e 'kqk_))))
(define (tb2-tr-type! v ix e t)
  (let ((fam (tb2-tr v ix e t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-ap! e ix (list 'VEC v) k)
                  (tb2-vty! v v (list t) (list e k))
                  (tb2-ipty! v (list t (list e k)) (list e k))
                  (tb2-fin!)))
              (lambda () (ass))))))
    fam))
(define (tb2-canon! v)
  (let* ((cb (list 'CANON-ONB v)) (cl (list 'VNB-LAMBDA 'kqe_ cb 'kqe_)))
    (if (not (dk-asm? (list 'IS-ORTHONORMAL-BASIS v cb cl))) (fact 'canon-onb-is-onb v))
    (tb2-onb! v cb cl)
    (cons cb cl)))
(define (tb2-unique! fam dd r1 r2)
  (tb2-nag!)
  (tb2-dom! fam dd 'CC)
  (tb2-carr! (list 'IN fam (list 'FUN (list 'DOM fam) '(CARR CC-NAG))))
  (tb2-carr! (list 'IN r1 '(CARR CC-NAG)))
  (tb2-carr! (list 'IN r2 '(CARR CC-NAG)))
  (tb2-and! (list 'SUMS-TO 'CC-NAG fam r1) (list 'SUMS-TO 'CC-NAG fam r2))
  (tb2-cite! 'sums-to-unique 'CC-NAG fam r1 r2))
;;; ---- end of copied helpers ----

(define (tb2-some-onb! v)
  (let* ((ex (tb2-cite! 'onb-exists v))
         (ixv (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ixv))) "the ONB family"))
         (ev (dk-skolem! ex2 #t)))
    (tb2-onb! v ixv ev)
    (cons ixv ev)))

;;; ====================================================================
;;; hs-ip-self
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(t_) '((IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        '(= (HS-IP v w t_ t_) (HS-SUM v w ix e t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tb2-onb! 'v 'ix 'e)
(tb2-hs-bounded! 'v 'w 't_)
(tb2-nag!)
(tb2-one!)
(let* ((ab (tb2-cite! 'hs-ip-any-basis 'v 'w 't_ 't_ 'ix 'e))
       (qq (tb2-qcc! 'v 'w 't_ 't_ 'ix 'e))
       (fam (tb2-qfam-type! 'v 'w 'ix 'e 't_ 't_))
       (ll (tb2-ns-fam! 'v 'w 'ix 'e 't_))
       (el (list 'ESUM ll))
       (vv (list '* 1 el)))
  (tb2-ns-sums! ll 'ix)
  (tb2-cc! el)
  (dk-have! (tb2-pw 'ix fam (lambda (z) (list '* 1 (list ll z))))
    (lambda ()
      (let* ((z (dk-di-var!)) (ez (list 'e z)) (tz (list 't_ ez)))
        (tb2-ap! 'e 'ix '(VEC v) z)
        (tb2-vty! 'v 'w '(t_) ez)
        (tb2-ns-type! 'w tz)
        (tb2-ipty! 'w tz tz)
        (dk-lam-b!)
        (subst (dk-cite! 'ip-norm-sq 'w tz))
        (crs))))
  (tb2-cite! 'cc-sums-to-scale-ptwise 'ix 1 ll fam el)
  (tb2-cc! vv)
  (let ((un (tb2-unique! fam 'ix qq vv)))
    (subst ab)
    (subst un)
    (subst (dk-cite! 'hs-sum-unfold 'v 'w 'ix 'e 't_))
    (crs)))
(tb2-done! 'hs-ip-self)

;;; ====================================================================
;;; hs-ip-add-left
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_ u_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_) (IS-HILBERT-SCHMIDT v w u_))
      '(= (HS-IP v w (BOP-SUM v w s_ t_) u_) (+ (HS-IP v w s_ u_) (HS-IP v w t_ u_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(for-each (lambda (op) (tb2-hs-bounded! 'v 'w op)) '(s_ t_ u_))
(fact 'hs-add 'v 'w 's_ 't_)
(tb2-hs-bounded! 'v 'w '(BOP-SUM v w s_ t_))
(tb2-nag!)
(let* ((pp '(BOP-SUM v w s_ t_))
       (b (tb2-some-onb! 'v)) (ixv (car b)) (ev (cdr b))
       (a1 (tb2-cite! 'hs-ip-any-basis 'v 'w pp 'u_ ixv ev))
       (a2 (tb2-cite! 'hs-ip-any-basis 'v 'w 's_ 'u_ ixv ev))
       (a3 (tb2-cite! 'hs-ip-any-basis 'v 'w 't_ 'u_ ixv ev))
       (qp (tb2-qcc! 'v 'w pp 'u_ ixv ev))
       (qs (tb2-qcc! 'v 'w 's_ 'u_ ixv ev))
       (qt (tb2-qcc! 'v 'w 't_ 'u_ ixv ev))
       (fp (tb2-qfam-type! 'v 'w ixv ev pp 'u_))
       (fs (tb2-qfam-type! 'v 'w ixv ev 's_ 'u_))
       (ft (tb2-qfam-type! 'v 'w ixv ev 't_ 'u_))
       (rr_ (list '+ qs qt)))
  (dk-have! (tb2-pw ixv fp (lambda (z) (list '+ (list fs z) (list ft z))))
    (lambda ()
      (let* ((z (dk-di-var!)) (ez (list ev z)) (sz (list 's_ ez)) (tz (list 't_ ez)) (uz (list 'u_ ez)))
        (tb2-ap! ev ixv '(VEC v) z)
        (tb2-vty! 'v 'w (list 's_ 't_ 'u_ pp) ez)
        (tb2-ipty! 'w sz uz)
        (tb2-ipty! 'w tz uz)
        (dk-lam-b!)
        (subst (tb2-cite! 'bop-sum-apply 'v 'w 's_ 't_ ez))
        (subst (tb2-cite! 'cips-ip-add-left 'w sz tz uz))
        (crs))))
  (tb2-cite! 'cc-sums-to-add-ptwise ixv fs ft fp qs qt)
  (tb2-cc! rr_)
  (let ((un (tb2-unique! fp ixv qp rr_)))
    (subst a1) (subst a2) (subst a3)
    (subst un)
    (tb2-close!)
    (if (tb2-open?) (crs))))
(tb2-done! 'hs-ip-add-left)

;;; ====================================================================
;;; trace-class-comp: the product of two Hilbert-Schmidt operators is trace class
;;; ====================================================================
(define (tb2-tc-close!)
  (let ((g (dk-goal)))
    (cond ((not (tb2-open?)) #t)
          ((dk-head-is? g 'FORSOME)
           (ew (if (eq? (cadr g) 'kqa_) 's_ 't_))
           (tb2-tc-close!))
          ((dk-head-is? g 'AND) (dk-conj-close! tb2-tc-close!))
          (#t (tb2-close!)))))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v v s_) (IS-HILBERT-SCHMIDT v v t_))
      '(IS-TRACE-CLASS v (BOP-COMP v s_ t_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tb2-hs-bounded! 'v 'v 's_)
(tb2-hs-bounded! 'v 'v 't_)
(tb2-cite! 'bop-comp-bounded 'v 's_ 't_)
(mac 'is-trace-class)
(tb2-tc-close!)
(tb2-done! 'trace-class-comp)

;;; ====================================================================
;;; op-trace-scale
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(c_ t_) '((IN c_ CC) (IS-TRACE-CLASS v t_))
      '(= (OP-TRACE v (BOP-SCALE v v c_ t_)) (* c_ (OP-TRACE v t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let ((bx '(IN t_ (BOUNDED-OPS v v))))
  (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class '(IS-TRACE-CLASS v t_))))
(tb2-cite! 'bop-fun 'v 'v 't_)
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (ct '(BOP-SCALE v v c_ t_))
       (rt '(OP-TRACE v t_))
       (rc (list '* 'c_ '(OP-TRACE v t_))))
  (dk-split-all! (list (tb2-cite! 'op-trace-sums 'v 't_ cb cl)))
  (tb2-cite! 'bop-scale-bounded 'v 'v 'c_ 't_)
  (tb2-cite! 'bop-fun 'v 'v ct)
  (let* ((fs (tb2-tr-type! 'v cb cl 't_))
         (fc (tb2-tr-type! 'v cb cl ct)))
    (dk-have! (tb2-pw cb fc (lambda (z) (list '* 'c_ (list fs z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (tb2-cb-pt! 'v cl z)
          (tb2-vty! 'v 'v (list 't_ ct) z)
          (tb2-vty! 'v 'v (list 't_ ct) (list cl z))
          (dk-lam-b!)
          (let ((p (if (dk-contains? (dk-goal) (list cl z)) (list cl z) z)))
            (tb2-ipty! 'v (list 't_ p) p)
            (subst (tb2-cite! 'bop-scale-apply 'v 'v 'c_ 't_ p))
            (subst (tb2-cite! 'cips-ip-homog-left 'v 'c_ (list 't_ p) p))
            (crs)))))
    (tb2-cite! 'cc-sums-to-scale-ptwise cb 'c_ fs fc rt)
    (tb2-cc! rc)
    (tb2-dom! fc cb 'CC)
    (subst (tb2-cite! 'op-trace-canon 'v ct))
    (subst (tb2-cite! 'cc-family-sum-value fc rc))
    (tb2-close!)))
(tb2-done! 'op-trace-scale)
