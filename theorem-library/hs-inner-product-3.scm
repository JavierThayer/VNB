;;; ====================================================================
;;; tb2-hip3.scm -- TH3-B2, 2026-11-09.  The Hilbert-Schmidt inner product as an inner product,
;;; and two further trace laws.
;;;
;;;   hs-ip-self          <T | T>_HS = sum_i ||T e_i||^2 (any ONB), i.e. ||T||_HS^2
;;;   hs-ip-add-left      <S + T | U>_HS = <S | U>_HS + <T | U>_HS
;;;   trace-class-comp    S, T Hilbert-Schmidt on H: S T is trace class
;;;   op-trace-scale      tr(c T) = c tr T for T trace class
;;;
;;; LOAD WINDOW: after tb2-hip2.scm (hs-ip-any-basis, op-trace-canon, op-trace-sums) and
;;; BA-ONB's onb-exists.  Library: operator-algebras.
