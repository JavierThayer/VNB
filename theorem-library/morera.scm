;;; THE UNCONDITIONAL THEOREMS (integration, 2026-10-04).  CA-3's
;;; `holomorphic-deriv-holomorphic' (theorem-library/cauchy-integral-formula.scm,
;;; loaded before this file) is the hypothesis HCIF of the two theorems above:
;;; one citation discharges it.
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN mrr-nfm 'u)
  (list 'FORALL 'f (mrr-imps (list '(IN f (FUN u CC)) (mrr-cont 'u 'f) (mrr-tz 'u 'f))
                             '(HOLOMORPHIC-ON u f)))))))
(fact 'holomorphic-deriv-holomorphic)
(fact 'morera-of-deriv-holomorphic)
(dk-ass!)
(qed 'morera)
(topic! 'morera 'analysis)
(alias! 'morera "Morera's theorem: a continuous function on an open set whose integral over every triangle in the set vanishes is holomorphic")

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN mrr-nfm 'u)
  (list 'FORALL 'fam (list 'IMPLIES mrr-famhol
    (list 'FORALL 'f (mrr-imps (list '(IN f (FUN u CC)) mrr-LU) '(HOLOMORPHIC-ON u f)))))))))
(fact 'holomorphic-deriv-holomorphic)
(fact 'holomorphic-uniform-limit-of-deriv-holomorphic)
(dk-ass!)
(qed 'holomorphic-uniform-limit)
(topic! 'holomorphic-uniform-limit 'analysis)
(alias! 'holomorphic-uniform-limit "a locally uniform limit of holomorphic functions on an open set is holomorphic")
