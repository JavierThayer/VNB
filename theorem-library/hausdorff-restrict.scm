;;; mh-restrict.scm -- restriction of Hausdorff measure to a subspace
;;; (construction-of-measures.pdf, 4.4, Prop 4.55).  Prefix mhr-.  Library: measure.
;;; Loads after mh-vocab.scm, mh-method2.scm, mh-hausdorff.scm.

;;; d <= d1 pointwise on a  ==>  DIAM_d(a) <= DIAM_d1(a)
;;; ---- helper defines COPIED 2026-10-27 (integration) from hausdorff-measure, method-ii: this file loads in its own environment
(define (mh2-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "mh2-pick: nothing matching" what) (car l))))
(define (mh2-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (mh2-diam-set m a)
  (list 'SEP 'mhw_ 'RR-POS-STAR (list 'FORSOME 'mhx_ (list 'AND (list 'IN 'mhx_ a)
        (list 'FORSOME 'mhy_ (list 'AND (list 'IN 'mhy_ a) (list '= 'mhw_ (list (list 'DIST m) 'mhx_ 'mhy_))))))))
(define (mh2-sep-sub! s)
  (dk-have! (list 'SUBSET s (caddr s))
    (lambda () (mac 'subset-def) (di)
               (sep-me (mh2-pick 'member (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) s)))))
               (ass))))
(define (mh2-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))
(define (mhh-rps! t)                       ; (IN t RR-POS-STAR) from (IN t RR), (<= 0 t)
  (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
      (dk-have! (list 'IN t 'RR-POS-STAR)
        (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))))
(define (mhh-and! . fs)
  (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l))))))
(define (mhh-have-and! . fs) (dk-have! (apply mhh-and! fs)))
(define (mhh-le-trans! x y z)
  (mhh-have-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (mhh-have-and! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))
(define (mhh-pre-parts! pp mm)
  (let ((h (list 'IS-PREMEASURE (list 'PTS mm) (list 'POWER (list 'PTS mm)) pp)))
    (for-each (lambda (c) (dk-project! c 'is-premeasure h))
              (list (list 'IN (list 'PTS mm) 'SET) (list 'IN pp (list 'FUN (list 'POWER (list 'PTS mm)) 'RR-POS-STAR))))))
(define (mhh-nndef!) (if (not (dk-asm? '(== NNREAL (SEP mhr_ RR (<= 0 mhr_))))) (fact 'nnreal-def)))
(define (mhh-nn-in! t)                       ; land (IN t NNREAL) from (IN t RR), (<= 0 t)
  (mhh-nndef!)
  (if (not (dk-asm? (list 'IN t 'NNREAL)))
      (dk-have! (list 'IN t 'NNREAL)
        (lambda () (subst '(== NNREAL (SEP mhr_ RR (<= 0 mhr_)))) (in-sep! (lambda () (ass)))))))
(define (mhh-nn-out! t)                      ; from (IN t NNREAL): (IN t RR), (<= 0 t)
  (mhh-nndef!)
  (let ((h (list 'IN t 'NNREAL)))
    (dk-project! (list 'IN t 'RR)
      (lambda () (dk-rewrite-h! h 'NNREAL '(SEP mhr_ RR (<= 0 mhr_))) (sep-me (list 'IN t '(SEP mhr_ RR (<= 0 mhr_))))))
    (dk-project! (list '<= 0 t)
      (lambda () (dk-rewrite-h! h 'NNREAL '(SEP mhr_ RR (<= 0 mhr_))) (sep-me (list 'IN t '(SEP mhr_ RR (<= 0 mhr_))))))))
(define (mhh-dbl-parts! f)                   ; IS-DOUBLING(f) in context: typing, f(0) = 0, monotone; returns monotone universal
  (let ((h (list 'IS-DOUBLING f)))
    (dk-project! (list 'IN f '(FUN NNREAL NNREAL)) 'is-doubling h)
    (dk-project! (list '= (list f 0) 0) 'is-doubling h)
    (dk-project! (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ NNREAL) (list 'FORALL 'mhq_ (list 'IMPLIES '(IN mhq_ NNREAL)
                   (list 'IMPLIES '(<= mhr_ mhq_) (list '<= (list f 'mhr_) (list f 'mhq_)))))))
                 'is-doubling h)))
(define (mhh-phi-at! f t)
  (mhh-nn-in! t)
  (fact 'fun-apply-type-c f 'NNREAL 'NNREAL t)
  (mhh-nn-out! (list f t)))
(define (mhh-diam-real! mm a)
  (let ((D (list 'DIAM mm a)))
    (fact 'diam-in mm a)
    (let ((iff (dk-cite! 'rr-pos-star-membership D)))
      (dk-have! (list 'IN D 'RR)
        (lambda () (if (dk-only! iff (list 'IN D 'RR-POS-STAR) (list 'NOT (list '= D 'POS-INF))) (prop))))
      (fact 'rr-pos-star-nonneg D))))
(define (mh2-cd m cls dl) (list 'SEP 'mha_ cls (list '<= (list 'DIAM m 'mha_) dl)))
;;; ---- end of copied helpers ----

(sp (make-wff (forall-guarded '(m m1 a)
  '((IS-METRIC-SPACE m) (IS-METRIC-SPACE m1) (SUBSET a (PTS m)) (SUBSET a (PTS m1))
    (FORALL x (IMPLIES (IN x a) (FORALL y (IMPLIES (IN y a) (<= ((DIST m) x y) ((DIST m1) x y)))))))
  '(<= (DIAM m a) (DIAM m1 a)))))
(dk-peel!)
(define mhr1-h (mh2-pick 'h (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'DIST)))))
(let* ((S (mh2-diam-set 'm 'a)) (b '(DIAM m1 a)))
  (mh2-sep-sub! S) (fact 'esup-in S) (fact 'diam-in 'm1 'a)
  (dk-have! (list '= '(DIAM m a) (list 'ESUP S)) (lambda () (mac 'DIAM) (rfl)))
  (subst (list '= '(DIAM m a) (list 'ESUP S)))
  (dk-have! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w S) (list '<= 'w b)))
    (lambda ()
      (let* ((pl (dk-peel!)) (w (cadr (car pl))))
        (sep-me (list 'IN w S))
        (let* ((x (dk-skolem! (mh2-pick 'x (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t))
               (y (dk-skolem! (mh2-pick 'y (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t))
               (d0 (list '(DIST m) x y)) (d1 (list '(DIST m1) x y)))
          (fact 'subset-mem-fwd 'a '(PTS m) x) (fact 'subset-mem-fwd 'a '(PTS m) y)
          (fact 'subset-mem-fwd 'a '(PTS m1) x) (fact 'subset-mem-fwd 'a '(PTS m1) y)
          (inst*! mhr1-h x y)
          (fact 'metric-dist-real 'm1 x y) (fact 'metric-pos 'm1 x y) (mhh-rps! d1)
          (fact 'metric-dist-real 'm x y) (fact 'metric-pos 'm x y) (mhh-rps! d0)
          (fact 'diam-dist-le 'm1 'a x y)
          (subst (mh2-pick 'weq (lambda (z) (and (dk-head-is? z '=) (equal? (cadr z) w)))))
          (mhh-le-trans! d0 d1 b)
          (ass)))))
  (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w S) (list '<= 'w b)))))
  (fact 'esup-least S b)
  (ass))
(qed 'diam-le-of-dist)

;;; a subset b  ==>  DIAM(a) <= DIAM(b)
(sp (make-wff (forall-guarded '(m a b)
  '((IS-METRIC-SPACE m) (SUBSET a b) (SUBSET b (PTS m)))
  '(<= (DIAM m a) (DIAM m b)))))
(dk-peel!)
(let* ((S (mh2-diam-set 'm 'a)) (bd '(DIAM m b)))
  (mh2-sep-sub! S) (fact 'esup-in S) (fact 'diam-in 'm 'b)
  (dk-have! (list '= '(DIAM m a) (list 'ESUP S)) (lambda () (mac 'DIAM) (rfl)))
  (subst (list '= '(DIAM m a) (list 'ESUP S)))
  (dk-have! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w S) (list '<= 'w bd)))
    (lambda ()
      (let* ((pl (dk-peel!)) (w (cadr (car pl))))
        (sep-me (list 'IN w S))
        (let* ((x (dk-skolem! (mh2-pick 'x (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t))
               (y (dk-skolem! (mh2-pick 'y (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t)))
          (fact 'subset-mem-fwd 'a 'b x) (fact 'subset-mem-fwd 'a 'b y)
          (fact 'diam-dist-le 'm 'b x y)
          (subst (mh2-pick 'weq (lambda (z) (and (dk-head-is? z '=) (equal? (cadr z) w)))))
          (ass)))))
  (dk-have! (list 'AND (list 'IN bd 'RR-POS-STAR) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w S) (list '<= 'w bd)))))
  (fact 'esup-least S bd)
  (ass))
(qed 'diam-mono)

;;; the diameter of a subset of Y is the same in the subspace Y
(define (mhr-sub-basics!)                      ; m, ys in context: ys in SET, subspace metric, PTS
  (fact 'ms-pts-is-set 'm)
  (fact 'subclass-of-set-is-set 'ys '(PTS m))
  (fact 'subspace-is-metric-space 'm 'ys)
  (fact 'subspace-pts 'm 'ys))
(define mhr-S '(SUBSPACE-MS m ys))
(sp (make-wff (forall-guarded '(m ys a)
  '((IS-METRIC-SPACE m) (SUBSET ys (PTS m)) (SUBSET a ys))
  '(= (DIAM (SUBSPACE-MS m ys) a) (DIAM m a)))))
(dk-peel!)
(mhr-sub-basics!)
(fact 'subset-trans 'a 'ys '(PTS m))
(dk-have! (list 'SUBSET 'a (list 'PTS mhr-S)) (lambda () (subst (list '= (list 'PTS mhr-S) 'ys)) (ass)))
(define (mhr3-dist-le! m0 m1)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x a) (list 'FORALL 'y (list 'IMPLIES '(IN y a)
              (list '<= (list (list 'DIST m0) 'x 'y) (list (list 'DIST m1) 'x 'y))))))
    (lambda ()
      (let* ((pl (dk-peel!)) (vs (map cadr (filter (lambda (z) (dk-head-is? z 'IN)) pl))) (x (car vs)) (y (cadr vs)))
        (fact 'subset-mem-fwd 'a 'ys x) (fact 'subset-mem-fwd 'a 'ys y)
        (fact 'subset-mem-fwd 'a '(PTS m) x) (fact 'subset-mem-fwd 'a '(PTS m) y)
        (subst (dk-cite! 'subspace-dist 'm 'ys x y))
        (fact 'metric-dist-real 'm x y)
        (fact 'rr-leq-reflexive (list '(DIST m) x y))
        (ass)))))
(mhr3-dist-le! mhr-S 'm)
(mhr3-dist-le! 'm mhr-S)
(fact 'diam-le-of-dist mhr-S 'm 'a)
(fact 'diam-le-of-dist 'm mhr-S 'a)
(fact 'diam-in mhr-S 'a) (fact 'diam-in 'm 'a)
(dk-have! (list 'AND (list 'IN (list 'DIAM mhr-S 'a) 'RR-POS-STAR) '(IN (DIAM m a) RR-POS-STAR)))
(dk-have! (list 'AND (list '<= (list 'DIAM mhr-S 'a) '(DIAM m a)) (list '<= '(DIAM m a) (list 'DIAM mhr-S 'a))))
(fact 'rr-pos-star-le-antisymm (list 'DIAM mhr-S 'a) '(DIAM m a))
(ass)
(qed 'subspace-diam)

;;; helpers
(define (mhr-pow! a big)                      ; (IN a (POWER big)) from (IN a SET), (SUBSET a big)
  (if (not (dk-asm? (list 'IN a (list 'POWER big))))
      (dk-have! (list 'IN a (list 'POWER big))
        (lambda () (mac 'power-set-membership)
          (for-each (lambda (leaf) (dk-focus! leaf)
                      (if (dk-asm? (dk-goal)) (ass)
                          (let* ((pl (dk-peel!)) (z (cadr (car pl)))) (fact 'subset-mem-fwd a big z) (ass))))
                    (mh2-split-goal!))))))
(define (mhr-real-below! t b)                 ; t in RR-POS-STAR, t <= b, b real  ==>  NOT t = POS-INF
  (dk-have! (list 'NOT (list '= t 'POS-INF))
    (lambda () (di)
      (dk-rewrite-h! (list '<= t b) t 'POS-INF)
      (fact 'pos-inf-above-reals b)
      (if (dk-only! (list '<= 'POS-INF b) (list 'NOT (list '<= 'POS-INF b))) (prop)))))

;;; PHI-PM is monotone in the set
(sp (make-wff (forall-guarded '(m phi a b)
  '((IS-METRIC-SPACE m) (IS-DOUBLING phi) (SUBSET a b) (IN b (POWER (PTS m))))
  '(<= ((PHI-PM m phi) a) ((PHI-PM m phi) b)))))
(dk-peel!)
(define mhr4-mono (mhh-dbl-parts! 'phi))
(dk-project! '(SUBSET b (PTS m)) (lambda () (mac-h 'power-set-membership '(IN b (POWER (PTS m)))) (dk-split-all!) (mac 'subset-def)))
(dk-project! '(IN b SET) 'power-set-membership '(IN b (POWER (PTS m))))
(fact 'subclass-of-set-is-set 'a 'b)
(fact 'subset-trans 'a 'b '(PTS m))
(mhr-pow! 'a '(PTS m))
(fact 'phi-pm-premeasure 'm 'phi)
(mhh-pre-parts! '(PHI-PM m phi) 'm)
(fact 'diam-in 'm 'a) (fact 'diam-in 'm 'b)
(fact 'diam-mono 'm 'a 'b)
(subst (dk-cite! 'phi-pm-value 'm 'phi 'b))
(use-em '(= (DIAM m b) POS-INF)
  (lambda ()
    (dk-if-branch! #t '(IF (= (DIAM m b) POS-INF) POS-INF (phi (DIAM m b))) #f (lambda () #t))
    (fact 'fun-apply-type-c '(PHI-PM m phi) '(POWER (PTS m)) 'RR-POS-STAR 'a)
    (fact 'rr-pos-star-below-pos-inf '((PHI-PM m phi) a))
    (ass))
  (lambda ()
    (dk-if-branch! #f '(IF (= (DIAM m b) POS-INF) POS-INF (phi (DIAM m b))) #f (lambda () #t))
    (mhh-diam-real! 'm 'b)
    (mhr-real-below! '(DIAM m a) '(DIAM m b))
    (mhh-diam-real! 'm 'a)
    (subst (dk-cite! 'phi-pm-value 'm 'phi 'a))
    (dk-if-branch! #f '(IF (= (DIAM m a) POS-INF) POS-INF (phi (DIAM m a))) #f (lambda () #t))
    (mhh-phi-at! 'phi '(DIAM m a)) (mhh-phi-at! 'phi '(DIAM m b))
    (inst*! mhr4-mono '(DIAM m a) '(DIAM m b))
    (ass)))
(qed 'phi-pm-mono)

;;; on a subset of Y, the subspace pre-measure is the ambient one
(sp (make-wff (forall-guarded '(m ys phi a)
  '((IS-METRIC-SPACE m) (SUBSET ys (PTS m)) (SUBSET a ys))
  '(== ((PHI-PM (SUBSPACE-MS m ys) phi) a) ((PHI-PM m phi) a)))))
(dk-peel!)
(mhr-sub-basics!)
(fact 'subclass-of-set-is-set 'a 'ys)
(fact 'subset-trans 'a 'ys '(PTS m))
(mhr-pow! 'a '(PTS m))
(mhr-pow! 'a 'ys)
(dk-have! (list 'IN 'a (list 'POWER (list 'PTS mhr-S))) (lambda () (subst (list '= (list 'PTS mhr-S) 'ys)) (ass)))
(subst (dk-cite! 'phi-pm-value mhr-S 'phi 'a))
(subst (dk-cite! 'phi-pm-value 'm 'phi 'a))
(subst (dk-cite! 'subspace-diam 'm 'ys 'a))
(qrfl)
(qed 'phi-pm-subspace)

;;; the method-II pieces for X and for the subspace S = Y
(define mhr-powX '(POWER (PTS m)))
(define mhr-powS (list 'POWER (list 'PTS mhr-S)))
(define mhr-pmX '(PHI-PM m phi))
(define mhr-pmS (list 'PHI-PM mhr-S 'phi))
(define (mhr-in-ps! a)                         ; (IN a PS)  ==>  (IN a SET), (SUBSET a ys), (IN a P)
  (dk-have! (list 'IN a '(POWER ys)) (lambda () (subst (list '= 'ys (list 'PTS mhr-S))) (ass)))
  (dk-project! (list 'IN a 'SET) 'power-set-membership (list 'IN a '(POWER ys)))
  (dk-project! (list 'SUBSET a 'ys) (lambda () (mac-h 'power-set-membership (list 'IN a '(POWER ys))) (dk-split-all!) (mac 'subset-def)))
  (fact 'subset-trans a 'ys '(PTS m))
  (mhr-pow! a '(PTS m)))
(define (mhr-setup!)                           ; common context of the two comparisons
  (mhr-sub-basics!)
  (fact 'subset-trans 'es 'ys '(PTS m))
  (fact 'subclass-of-set-is-set 'es 'ys)
  (mhr-pow! 'es '(PTS m))
  (mhr-pow! 'es 'ys)
  (dk-have! (list 'IN 'es mhr-powS) (lambda () (subst (list '= (list 'PTS mhr-S) 'ys)) (ass)))
  (fact 'nn-is-set)
  (fact 'phi-pm-premeasure 'm 'phi)
  (fact 'phi-pm-premeasure mhr-S 'phi)
  (mhh-pre-parts! mhr-pmX 'm)
  (fact 'method-ii-delta-premeasure 'm mhr-powX mhr-pmX 'd)
  (fact 'method-ii-delta-premeasure mhr-S mhr-powS mhr-pmS 'd)
  (let ((cdX (mh2-cd 'm mhr-powX 'd)) (cdS (mh2-cd mhr-S mhr-powS 'd)))
    (dk-project! (list 'IN (list 'RESTRICT mhr-pmX cdX) (list 'FUN cdX 'RR-POS-STAR)) 'is-premeasure
                 (list 'IS-PREMEASURE '(PTS m) cdX (list 'RESTRICT mhr-pmX cdX)))
    (dk-project! (list 'IN (list 'RESTRICT mhr-pmS cdS) (list 'FUN cdS 'RR-POS-STAR)) 'is-premeasure
                 (list 'IS-PREMEASURE (list 'PTS mhr-S) cdS (list 'RESTRICT mhr-pmS cdS)))
    (mh2-sep-sub! cdX) (mh2-sep-sub! cdS)))
(define (mhr-cd-parts! a cd mm)                ; a in cd  ==>  a in class, DIAM_mm(a) <= d
  (dk-project! (list 'IN a (caddr cd)) (lambda () (sep-me (list 'IN a cd))))
  (dk-project! (list '<= (list 'DIAM mm a) 'd) (lambda () (sep-me (list 'IN a cd)))))
(define mhr-hyps '((IS-METRIC-SPACE m) (IS-DOUBLING phi) (SUBSET ys (PTS m)) (IN d RR) (<= 0 d) (SUBSET es ys)))

;;; (a) mu*_X,d(E) <= mu*_Y,d(E): a cover from Y is a cover from X
(sp (make-wff (forall-guarded '(m ys phi d es) mhr-hyps
  (list '<= (list (list 'METHOD-II-DELTA 'm mhr-powX mhr-pmX 'd) 'es) (list (list 'METHOD-II-DELTA mhr-S mhr-powS mhr-pmS 'd) 'es)))))
(dk-peel!)
(mhr-setup!)
(let* ((cdX (mh2-cd 'm mhr-powX 'd)) (cdS (mh2-cd mhr-S mhr-powS 'd))
       (rX (list 'RESTRICT mhr-pmX cdX)) (rS (list 'RESTRICT mhr-pmS cdS))
       (csX (list 'COVER-SUMS '(PTS m) cdX rX 'es)) (csS (list 'COVER-SUMS (list 'PTS mhr-S) cdS rS 'es))
       (x (list 'EINF csX)))
  (subst (dk-cite! 'method-ii-delta-value 'm mhr-powX mhr-pmX 'd 'es))
  (subst (dk-cite! 'method-ii-delta-value mhr-S mhr-powS mhr-pmS 'd 'es))
  (dk-have! (list 'SUBSET cdS cdX)
    (lambda ()
      (mac 'subset-def)
      (let* ((pl (dk-peel!)) (a (cadr (car pl))))
        (mhr-cd-parts! a cdS mhr-S)
        (mhr-in-ps! a)
        (fact 'subspace-diam 'm 'ys a)
        (in-sep! (lambda () (subst (list '= (list 'DIAM 'm a) (list 'DIAM mhr-S a))) (ass))))))
  (fact 'cover-sums-subset '(PTS m) cdX rX 'es)
  (fact 'cover-sums-subset (list 'PTS mhr-S) cdS rS 'es)
  (fact 'einf-in csX) (fact 'einf-in csS)
  (fact 'einf-lower csX)
  (dk-have! (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v csS) (list '<= x 'v)))
    (lambda ()
      (let* ((pl (dk-peel!)) (v (cadr (car pl)))
             (ex (dk-cite! 'cover-sums-elim (list 'PTS mhr-S) cdS rS 'es v))
             (sq (dk-skolem! ex #t))
             (l0 (list 'VNB-LAMBDA 'cvk_ 'NN (list rS (list sq 'cvk_))))
             (l1 (list 'VNB-LAMBDA 'cvk_ 'NN (list rX (list sq 'cvk_)))))
        (fact 'fun-codomain-superset sq 'NN cdS cdX)
        (define (lam-typed! lam body!)
          (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (body! j) (ass))) (lambda () (ass))))))
        (define (r0-typed! j) (fact 'fun-apply-type-c sq 'NN cdS j) (fact 'fun-apply-type-c rS cdS 'RR-POS-STAR (list sq j)))
        (define (r1-typed! j) (fact 'fun-apply-type-c sq 'NN cdX j) (fact 'fun-apply-type-c rX cdX 'RR-POS-STAR (list sq j)))
        (lam-typed! l0 r0-typed!)
        (lam-typed! l1 r1-typed!)
        (dk-have! (list 'SUBSET 'es (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_))) (lambda () (ass)))
        (fact 'cover-sums-intro '(PTS m) cdX rX 'es sq)
        (inst+ (mh2-pick 'low (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z csX) (dk-contains? z 'EINF)))) (list 'ESUM l1))
        (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '<= (list l1 'j) (list l0 'j))))
          (lambda ()
            (let* ((j (dk-di-var!)) (a (list sq j)))
              (r0-typed! j) (r1-typed! j)
              (dk-lam-b!)
              (subst (dk-cite! 'restrict-apply mhr-pmX cdX a))
              (subst (dk-cite! 'restrict-apply mhr-pmS cdS a))
              (mhr-cd-parts! a cdS mhr-S)
              (mhr-in-ps! a)
              (subst (dk-cite! 'phi-pm-subspace 'm 'ys 'phi a))
              (fact 'fun-apply-type-c mhr-pmX mhr-powX 'RR-POS-STAR a)
              (fact 'rr-pos-star-le-refl (list mhr-pmX a))
              (ass))))
        (fact 'esum-nn-le-termwise l1 l0)
        (mh2-esum-type! l0) (mh2-esum-type! l1)
        (subst (list '= v (list 'ESUM l0)))
        (mhh-le-trans! x (list 'ESUM l1) (list 'ESUM l0))
        (ass))))
  (fact 'einf-greatest csS)
  (inst+ (mh2-pick 'gr (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cpsb_) (not (dk-contains? z 'cpss_))))) x)
  (ass))
(qed 'method-ii-delta-subspace-le)

;;; (b) mu*_Y,d(E) <= mu*_X,d(E): an X-cover A_i of E gives the Y-cover A_i n E
(define (mhr-sub-of-int! a b side)             ; (SUBSET (INTERSECTION a b) side), side = a or b
  (let ((I (list 'INTERSECTION a b)))
    (if (not (dk-asm? (list 'SUBSET I side)))
        (dk-have! (list 'SUBSET I side)
          (lambda () (mac 'subset-def)
            (let* ((pl (dk-peel!)) (z (cadr (car pl))) (iff (dk-cite! 'intersection-membership a b z)))
              (if (dk-only! iff (list 'IN z I)) (prop))))))))
(sp (make-wff (forall-guarded '(m ys phi d es) mhr-hyps
  (list '<= (list (list 'METHOD-II-DELTA mhr-S mhr-powS mhr-pmS 'd) 'es) (list (list 'METHOD-II-DELTA 'm mhr-powX mhr-pmX 'd) 'es)))))
(dk-peel!)
(mhr-setup!)
(mhh-rps! 'd)
(let* ((cdX (mh2-cd 'm mhr-powX 'd)) (cdS (mh2-cd mhr-S mhr-powS 'd))
       (rX (list 'RESTRICT mhr-pmX cdX)) (rS (list 'RESTRICT mhr-pmS cdS))
       (csX (list 'COVER-SUMS '(PTS m) cdX rX 'es)) (csS (list 'COVER-SUMS (list 'PTS mhr-S) cdS rS 'es))
       (x (list 'EINF csS)))
  (subst (dk-cite! 'method-ii-delta-value 'm mhr-powX mhr-pmX 'd 'es))
  (subst (dk-cite! 'method-ii-delta-value mhr-S mhr-powS mhr-pmS 'd 'es))
  (fact 'cover-sums-subset '(PTS m) cdX rX 'es)
  (fact 'cover-sums-subset (list 'PTS mhr-S) cdS rS 'es)
  (fact 'einf-in csX) (fact 'einf-in csS)
  (fact 'einf-lower csS)
  (dk-have! (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v csX) (list '<= x 'v)))
    (lambda ()
      (let* ((pl (dk-peel!)) (v (cadr (car pl)))
             (ex (dk-cite! 'cover-sums-elim '(PTS m) cdX rX 'es v))
             (sq (dk-skolem! ex #t))
             (sq2 (list 'VNB-LAMBDA 'mhrk_ 'NN (list 'INTERSECTION (list sq 'mhrk_) 'es)))
             (l0 (list 'VNB-LAMBDA 'cvk_ 'NN (list rS (list sq2 'cvk_))))
             (l1 (list 'VNB-LAMBDA 'cvk_ 'NN (list rX (list sq 'cvk_)))))
        (define (sq-typed! j)                  ; sq j in cdX, in P, its parts
          (fact 'fun-apply-type-c sq 'NN cdX j)
          (mhr-cd-parts! (list sq j) cdX 'm)
          (dk-project! (list 'SUBSET (list sq j) '(PTS m))
            (lambda () (mac-h 'power-set-membership (list 'IN (list sq j) mhr-powX)) (dk-split-all!) (mac 'subset-def)))
          (dk-project! (list 'IN (list sq j) 'SET) 'power-set-membership (list 'IN (list sq j) mhr-powX)))
        (define (int-in-cds! j)                 ; (IN (INTERSECTION (sq j) es) cdS)
          (let ((I (list 'INTERSECTION (list sq j) 'es)))
            (sq-typed! j)
            (dk-have! (list 'OR (list 'IN (list sq j) 'SET) '(IN es SET)) (lambda () (oi-l) (ass)))
            (fact 'intersection-set-closure (list sq j) 'es)
            (mhr-sub-of-int! (list sq j) 'es 'es)
            (mhr-sub-of-int! (list sq j) 'es (list sq j))
            (fact 'subset-trans I 'es 'ys)
            (mhr-pow! I 'ys)
            (dk-have! (list 'IN I mhr-powS) (lambda () (subst (list '= (list 'PTS mhr-S) 'ys)) (ass)))
            (fact 'subspace-diam 'm 'ys I)
            (fact 'diam-mono 'm I (list sq j))
            (fact 'diam-in 'm I) (fact 'diam-in 'm (list sq j))
            (mhh-le-trans! (list 'DIAM 'm I) (list 'DIAM 'm (list sq j)) 'd)
            (if (not (dk-asm? (list 'IN I cdS)))
                (dk-have! (list 'IN I cdS)
                  (lambda () (in-sep! (lambda () (subst (list '= (list 'DIAM mhr-S I) (list 'DIAM 'm I))) (ass))))))
            I))
        (define (lam-typed! lam body!)
          (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (body! j) (ass))) (lambda () (ass))))))
        (dk-have! (list 'IN sq2 (list 'FUN 'NN cdS))
          (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (lf (proof-state-focus *ps*)))
                                                (int-in-cds! j)
                                                (if (eq? lf (proof-state-focus *ps*)) (ass))))
                                   (lambda () (ass)))))
        (define (r0-typed! j)
          (fact 'fun-apply-type-c sq2 'NN cdS j)
          (fact 'fun-apply-type-c rS cdS 'RR-POS-STAR (list sq2 j)))
        (define (r1-typed! j) (fact 'fun-apply-type-c sq 'NN cdX j) (fact 'fun-apply-type-c rX cdX 'RR-POS-STAR (list sq j)))
        (lam-typed! l0 r0-typed!)
        (lam-typed! l1 r1-typed!)
        ;; E is covered by the traces
        (dk-have! (list 'SUBSET 'es (list 'BIG-UNION 'cvn_ 'NN (list sq2 'cvn_)))
          (lambda ()
            (mac 'subset-def)
            (let* ((pl2 (dk-peel!)) (z (cadr (car pl2))))
              (fact 'subset-mem-fwd 'es (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)) z)
              (let* ((nl (dk-landed (lambda () (bu-me (list 'IN z (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)))))))
                     (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) nl)))))
                (for-each (lambda (leaf)
                            (dk-focus! leaf)
                            (if (dk-asm? (dk-goal)) (ass)
                                (begin (dk-lam-b!)
                                       (if (not (sequent-node-grounded? leaf))
                                           (begin (mac 'intersection-membership)
                                                  (dk-close-all! (lambda () (mh2-split-goal!))))))))
                          (dk-opened (lambda () (bu-mi k))))))))
        (fact 'cover-sums-intro (list 'PTS mhr-S) cdS rS 'es sq2)
        (inst+ (mh2-pick 'low (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z csS) (dk-contains? z 'EINF)))) (list 'ESUM l0))
        ;; termwise rS(A_j n E) <= rX(A_j)
        (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '<= (list l0 'j) (list l1 'j))))
          (lambda ()
            (let* ((j (dk-di-var!)) (I (int-in-cds! j)))
              (r1-typed! j)
              (fact 'fun-apply-type-c rS cdS 'RR-POS-STAR I)
              (dk-lam-b!)
              (subst (dk-cite! 'restrict-apply mhr-pmS cdS I))
              (subst (dk-cite! 'restrict-apply mhr-pmX cdX (list sq j)))
              (subst (dk-cite! 'phi-pm-subspace 'm 'ys 'phi I))
              (fact 'phi-pm-mono 'm 'phi I (list sq j))
              (ass))))
        (fact 'esum-nn-le-termwise l0 l1)
        (mh2-esum-type! l0) (mh2-esum-type! l1)
        (subst (list '= v (list 'ESUM l1)))
        (mhh-le-trans! x (list 'ESUM l0) (list 'ESUM l1))
        (ass))))
  (fact 'einf-greatest csX)
  (inst+ (mh2-pick 'gr (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cpsb_) (not (dk-contains? z 'cpss_))))) x)
  (ass))
(qed 'method-ii-delta-subspace-ge)

;;; PROPOSITION 4.55: for E subset Y, H^phi of the subspace Y at E is H^phi_X(E)
(define (mhr-mi-in! mm cls p d)
  (fact 'method-ii-delta-outer mm cls p d)
  (dk-project! (list 'IN (list 'METHOD-II-DELTA mm cls p d) (list 'FUN cls 'RR-POS-STAR)) 'is-outer-measure
               (list 'IS-OUTER-MEASURE (list 'PTS mm) (list 'METHOD-II-DELTA mm cls p d)))
  (fact 'fun-apply-type-c (list 'METHOD-II-DELTA mm cls p d) cls 'RR-POS-STAR 'es))
(sp (make-wff (forall-guarded '(m ys phi es)
  '((IS-METRIC-SPACE m) (IS-DOUBLING phi) (SUBSET ys (PTS m)) (SUBSET es ys))
  '(= ((HAUSDORFF-PHI (SUBSPACE-MS m ys) phi) es) ((HAUSDORFF-PHI m phi) es)))))
(dk-peel!)
(mac 'HAUSDORFF-PHI)
(mhr-sub-basics!)
(fact 'subset-trans 'es 'ys '(PTS m))
(fact 'subclass-of-set-is-set 'es 'ys)
(mhr-pow! 'es '(PTS m))
(mhr-pow! 'es 'ys)
(dk-have! (list 'IN 'es mhr-powS) (lambda () (subst (list '= (list 'PTS mhr-S) 'ys)) (ass)))
(fact 'phi-pm-premeasure 'm 'phi)
(fact 'phi-pm-premeasure mhr-S 'phi)
(let* ((hx (list (list 'METHOD-II 'm mhr-powX mhr-pmX) 'es))
       (hs (list (list 'METHOD-II mhr-S mhr-powS mhr-pmS) 'es)))
  (define (bound! lhs-m lhs-cls lhs-p rhs-m rhs-cls rhs-p rhs-h cmp)
    (dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl)
                (list '<= (list (list 'METHOD-II-DELTA lhs-m lhs-cls lhs-p 'dl) 'es) rhs-h)))
      (lambda ()
        (let* ((pl (dk-peel!)) (d (cadr (car pl))))
          (dk-pos-parts! d)
          (mhr-mi-in! lhs-m lhs-cls lhs-p d) (mhr-mi-in! rhs-m rhs-cls rhs-p d)
          (fact cmp 'm 'ys 'phi d 'es)
          (fact 'method-ii-delta-le rhs-m rhs-cls rhs-p 'es d)
          (mhh-le-trans! (list (list 'METHOD-II-DELTA lhs-m lhs-cls lhs-p d) 'es)
                         (list (list 'METHOD-II-DELTA rhs-m rhs-cls rhs-p d) 'es) rhs-h)
          (ass)))))
  (fact 'method-ii-in 'm mhr-powX mhr-pmX 'es)
  (fact 'method-ii-in mhr-S mhr-powS mhr-pmS 'es)
  (bound! mhr-S mhr-powS mhr-pmS 'm mhr-powX mhr-pmX hx 'method-ii-delta-subspace-ge)
  (fact 'method-ii-least mhr-S mhr-powS mhr-pmS 'es hx)
  (bound! 'm mhr-powX mhr-pmX mhr-S mhr-powS mhr-pmS hs 'method-ii-delta-subspace-le)
  (fact 'method-ii-least 'm mhr-powX mhr-pmX 'es hs)
  (dk-have! (list 'AND (list 'IN hs 'RR-POS-STAR) (list 'IN hx 'RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= hs hx) (list '<= hx hs)))
  (fact 'rr-pos-star-le-antisymm hs hx)
  (ass))
(qed 'hausdorff-phi-subspace)

