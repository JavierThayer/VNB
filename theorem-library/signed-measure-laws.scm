                                                   (list 'SUBSET 'e (mfq-bu 'f)))
  (list 'FORSOME 'h_ (dk-and (list '(IN h_ (FUN NN ca)) (mfq-disj 'h_)
                                   '(FORALL k_ (IMPLIES (IN k_ NN) (SUBSET (h_ k_) (f k_))))
