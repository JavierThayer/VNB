;;; mf-fa.scm -- finite additivity of a signed measure; eventually-zero extended series.
;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/signed-measure-laws.scm.  Library: measure.
;;; Helper prefix: mfa-.  Load window: after mf-conv.scm, measure-laws.scm (rps-prefix-*), sigma-algebra laws.

