            (ai (dk-cite! 'ext-real-not-pos-inf '(- x)))))))
(mfn-qed! 'ext-neg-to-pos-inf)

(sp (make-wff '(FORALL x (IMPLIES (IN x RR-STAR) (IMPLIES (= (EXT-NEG x) NEG-INF) (= x POS-INF))))))
(dk-peel!)
(mfn-star-cases! 'x
  (lambda (c)
    (case c
      ((pos) (dk-ass!))
      ((neg) (fact 'ext-neg-neg-inf)
             (dk-rewrite-h! '(= (EXT-NEG x) NEG-INF) 'x 'NEG-INF)
             (dk-rewrite-h! '(= (EXT-NEG NEG-INF) NEG-INF) '(EXT-NEG NEG-INF) 'POS-INF)
             (ai (dk-cite! 'pos-inf-neq-neg-inf)))
      (else (dk-cite! 'ext-neg-real 'x) (dk-cite! 'rr-neg-closed 'x)
            (dk-rewrite-h! '(= (EXT-NEG x) NEG-INF) '(EXT-NEG x) '(- x))
            (ai (dk-cite! 'ext-real-not-neg-inf '(- x)))))))
(mfn-qed! 'ext-neg-to-neg-inf)

(sp (make-wff '(FORALL x (IMPLIES (IN x RR-STAR) (IMPLIES (IN (EXT-NEG x) RR) (IN x RR))))))
(dk-peel!)
(mfn-star-cases! 'x
  (lambda (c)
    (case c
      ((real) (dk-ass!))
      ((pos) (dk-rewrite-h! '(IN (EXT-NEG x) RR) 'x 'POS-INF)
             (fact 'ext-neg-pos-inf)
             (dk-rewrite-h! '(IN (EXT-NEG POS-INF) RR) '(EXT-NEG POS-INF) 'NEG-INF)
             (ai (dk-cite! 'neg-inf-not-in-rr)))
      (else (dk-rewrite-h! '(IN (EXT-NEG x) RR) 'x 'NEG-INF)
            (fact 'ext-neg-neg-inf)
            (dk-rewrite-h! '(IN (EXT-NEG NEG-INF) RR) '(EXT-NEG NEG-INF) 'POS-INF)
            (ai (dk-cite! 'pos-inf-not-in-rr))))))
(mfn-qed! 'ext-neg-real-back)

;; -(a + b) = (-a) + (-b), no +inf among a, b
(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR-STAR) (IN b RR-STAR) (NOT (= a POS-INF)) (NOT (= b POS-INF)))
  '(= (EXT-NEG (EXT-ADD a b)) (EXT-ADD (EXT-NEG a) (EXT-NEG b)))))))
(dk-peel!)
(fact 'ext-neg-neg-inf)
(dk-cite! 'ext-neg-in 'a) (dk-cite! 'ext-neg-in 'b)
(mfn-star-cases! 'a
  (lambda (ca_)
    (case ca_
      ((pos) (ai '(NOT (= a POS-INF))))
      ((neg) (subst '(= a NEG-INF))
             (subst (dk-cite! 'ext-add-neg-inf-left 'b))
             (subst '(= (EXT-NEG NEG-INF) POS-INF))
             (subst (dk-cite! 'ext-add-pos-inf-left '(EXT-NEG b)))
             (rfl))
      (else
       (mfn-star-cases! 'b
         (lambda (cb_)
           (case cb_
             ((pos) (ai '(NOT (= b POS-INF))))
             ((neg) (subst '(= b NEG-INF))
                    (subst (dk-cite! 'ext-add-neg-inf-right 'a))
                    (subst '(= (EXT-NEG NEG-INF) POS-INF))
                    (subst (dk-cite! 'ext-add-pos-inf-right '(EXT-NEG a)))
                    (rfl))
             (else
              (dk-have-and! '(IN a RR) '(IN b RR))
              (dk-cite! 'rr-add-closed 'a 'b)
              (subst (dk-cite! 'ext-add-real 'a 'b))
              (subst (dk-cite! 'ext-neg-real '(+ a b)))
              (subst (dk-cite! 'ext-neg-real 'a))
              (subst (dk-cite! 'ext-neg-real 'b))
              (dk-cite! 'rr-neg-closed 'a) (dk-cite! 'rr-neg-closed 'b)
              (subst (dk-cite! 'ext-add-real '(- a) '(- b)))
              (dk-ineq! '(IN a RR) '(IN b RR))))))))))
(mfn-qed! 'ext-neg-add-up)

;; the same with no -inf among a, b
(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR-STAR) (IN b RR-STAR) (NOT (= a NEG-INF)) (NOT (= b NEG-INF)))
  '(= (EXT-NEG (EXT-ADD a b)) (EXT-ADD (EXT-NEG a) (EXT-NEG b)))))))
(dk-peel!)
(fact 'ext-neg-pos-inf)
(dk-cite! 'ext-neg-in 'a) (dk-cite! 'ext-neg-in 'b)
(mfn-star-cases! 'a
  (lambda (ca_)
    (case ca_
      ((neg) (ai '(NOT (= a NEG-INF))))
      ((pos) (subst '(= a POS-INF))
             (subst (dk-cite! 'ext-add-pos-inf-left 'b))
             (subst '(= (EXT-NEG POS-INF) NEG-INF))
             (dk-have! '(NOT (= (EXT-NEG b) POS-INF))
               (lambda () (di) (dk-cite! 'ext-neg-to-pos-inf 'b) (ai '(NOT (= b NEG-INF)))))
             (subst (dk-cite! 'ext-add-neg-inf-left '(EXT-NEG b)))
             (rfl))
      (else
       (mfn-star-cases! 'b
         (lambda (cb_)
           (case cb_
             ((neg) (ai '(NOT (= b NEG-INF))))
             ((pos) (subst '(= b POS-INF))
                    (subst (dk-cite! 'ext-add-pos-inf-right 'a))
                    (subst '(= (EXT-NEG POS-INF) NEG-INF))
                    (dk-have! '(NOT (= (EXT-NEG a) POS-INF))
                      (lambda () (di) (dk-cite! 'ext-neg-to-pos-inf 'a) (ai '(NOT (= a NEG-INF)))))
                    (subst (dk-cite! 'ext-add-neg-inf-right '(EXT-NEG a)))
                    (rfl))
             (else
              (dk-have-and! '(IN a RR) '(IN b RR))
              (dk-cite! 'rr-add-closed 'a 'b)
              (subst (dk-cite! 'ext-add-real 'a 'b))
              (subst (dk-cite! 'ext-neg-real '(+ a b)))
              (subst (dk-cite! 'ext-neg-real 'a))
              (subst (dk-cite! 'ext-neg-real 'b))
              (dk-cite! 'rr-neg-closed 'a) (dk-cite! 'rr-neg-closed 'b)
              (subst (dk-cite! 'ext-add-real '(- a) '(- b)))
              (dk-ineq! '(IN a RR) '(IN b RR))))))))))
(mfn-qed! 'ext-neg-add-down)

;; ---------------------------------------------------------------------------
;; order flips under EXT-NEG
(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR-STAR) (IN b RR) (< a (- b))) '(< b (EXT-NEG a))))))
(dk-peel!)
(dk-cite! 'rr-neg-closed 'b)
(mfn-star-cases! 'a
  (lambda (c)
    (case c
      ((neg) (subst '(= a NEG-INF)) (subst (dk-cite! 'ext-neg-neg-inf)) (dk-cite! 'rr-lt-pos-inf 'b) (dk-ass!))
      ((pos) (dk-rewrite-h! '(< a (- b)) 'a 'POS-INF)
             (dk-iff-fwd! (dk-cite! '< 'POS-INF '(- b)))
             (ai (dk-cite! 'pos-inf-above-reals '(- b))))
      (else (subst (dk-cite! 'ext-neg-real 'a)) (dk-ineq! '(< a (- b)) '(IN a RR) '(IN b RR))))))
(mfn-qed! 'ext-neg-lt-flip)

(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR-STAR) (IN b RR) (< (- b) a)) '(< (EXT-NEG a) b)))))
(dk-peel!)
(dk-cite! 'rr-neg-closed 'b)
(mfn-star-cases! 'a
  (lambda (c)
    (case c
      ((pos) (subst '(= a POS-INF)) (subst (dk-cite! 'ext-neg-pos-inf))
             (mac '<)
             (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) '<=)
                     (begin (mfn-rstar! 'b) (dk-cite! 'neg-inf-lower-bound 'b) (dk-ass!))
                     (begin (dk-cite! 'ext-real-not-neg-inf 'b)
                            (di)
                            (dk-have! '(= b NEG-INF) (lambda () (subst '(= b NEG-INF)) (rfl)))
                            (ai '(NOT (= b NEG-INF))))))))
      ((neg) (dk-rewrite-h! '(< (- b) a) 'a 'NEG-INF)
             (dk-iff-fwd! (dk-cite! '< '(- b) 'NEG-INF))
             (ai (dk-cite! 'neg-inf-below-reals '(- b))))
      (else (subst (dk-cite! 'ext-neg-real 'a)) (dk-ineq! '(< (- b) a) '(IN a RR) '(IN b RR))))))
(mfn-qed! 'ext-neg-gt-flip)

;; partial sums: no +inf (resp. -inf) term gives no +inf (resp. -inf) partial sum
(define (mfn-some x n c)
  (list 'FORSOME 'k_ (list 'AND '(IN k_ NN) (list 'AND (list '< 'k_ n) (list '= (list x 'k_) c)))))
(define mfn-ptw '(FORALL k_ (IMPLIES (IN k_ NN) (IN (x k_) RR-STAR))))
(define (mfn-no c) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'NOT (list '= '(x k_) c)))))
(define (mfn-none! c)              ; NOT(some term below n equals c), from (mfn-no c)
  (let ((f (list 'NOT (mfn-some 'x 'n c))))
    (dk-have! f (lambda () (di)
                           (let ((k (dk-skolem! (dk-ctx-form (mfn-some 'x 'n c)))))
                             (dk-apply! (mfn-no c) k)
                             (ai (list 'NOT (list '= (list 'x k) c))))))
    f))
(define (mfn-sps-real!)            ; NOT A, NOT B in context: psum == SPS, SPS in RR
  (dk-cite! 'ext-psum-fin 'x 'n)
  (dk-cite! 'ext-psum-real-terms 'x 'n)
  (dk-cite! 'series-partial-sum-in-rr-below 'n 'x))

(sp (make-wff (dk-foralls '(x n) (dk-curry (list '(IN n NN) mfn-ptw (mfn-no 'POS-INF)) '(NOT (= (EXT-PARTIAL-SUM x n) POS-INF))))))
(dk-peel!)
(mfn-none! 'POS-INF)
(use-em (mfn-some 'x 'n 'NEG-INF)
  (lambda () (subst (dk-cite! 'ext-psum-neg 'x 'n)) (fact 'neg-inf-neq-pos-inf) (dk-ass!))
  (lambda () (mfn-sps-real!) (subst '(== (EXT-PARTIAL-SUM x n) (SERIES-PARTIAL-SUM x n)))
             (dk-cite! 'ext-real-not-pos-inf '(SERIES-PARTIAL-SUM x n)) (dk-ass!)))
(mfn-qed! 'ext-psum-not-pos-inf)

(sp (make-wff (dk-foralls '(x n) (dk-curry (list '(IN n NN) mfn-ptw (mfn-no 'NEG-INF)) '(NOT (= (EXT-PARTIAL-SUM x n) NEG-INF))))))
(dk-peel!)
(mfn-none! 'NEG-INF)
(use-em (mfn-some 'x 'n 'POS-INF)
  (lambda () (subst (dk-cite! 'ext-psum-pos 'x 'n)) (fact 'pos-inf-neq-neg-inf) (dk-ass!))
  (lambda () (mfn-sps-real!) (subst '(== (EXT-PARTIAL-SUM x n) (SERIES-PARTIAL-SUM x n)))
             (dk-cite! 'ext-real-not-neg-inf '(SERIES-PARTIAL-SUM x n)) (dk-ass!)))
(mfn-qed! 'ext-psum-not-neg-inf)

;; partial sums of the negated series
(define mfn-yeq '(FORALL k_ (IMPLIES (IN k_ NN) (= (y k_) (EXT-NEG (x k_))))))
(define (mfn-negate-proof! c add-law not-law)
  (let ((legs (dk-opened (lambda () (ni)))))
    (for-each
      (lambda (l)
        (dk-focus! l)
        (if (dk-contains? (dk-goal) '(EXT-PARTIAL-SUM y 0))
            (begin
              (dk-peel!)
              (subst (dk-cite! 'ext-psum-zero 'y))
              (subst (dk-cite! 'ext-psum-zero 'x))
              (subst (dk-cite! 'ext-neg-zero))
              (fact 'rr-zero-in)
              (rfl))
            (let* ((nv (dk-di-var!))
                   (ih (dk-landed-1 (lambda () (di)))))
              (dk-peel!)
              (fact 'nn-succ-closed nv)
              (dk-have! '(FORALL k_ (IMPLIES (IN k_ NN) (IN (y k_) RR-STAR)))
                (lambda () (let ((k (dk-di-var!)))
                             (dk-apply! mfn-ptw k)
                             (dk-cite! 'ext-neg-in (list 'x k))
                             (subst (dk-apply! mfn-yeq k))
                             (dk-ass!))))
              (let ((p (list 'EXT-PARTIAL-SUM 'x nv)) (xn (list 'x nv)))
                (subst (dk-cite! 'ext-psum-succ 'y nv))
                (subst (dk-apply! ih 'x 'y))
                (subst (dk-apply! mfn-yeq nv))
                (subst (dk-cite! 'ext-psum-succ 'x nv))
                (dk-cite! 'ext-psum-in 'x nv)
                (dk-apply! mfn-ptw nv)
                (dk-cite! not-law 'x nv)
                (dk-apply! (mfn-no c) nv)
                (subst (dk-cite! add-law p xn))
                (dk-cite! 'ext-neg-in p) (dk-cite! 'ext-neg-in xn)
                (dk-cite! 'ext-add-in (list 'EXT-NEG p) (list 'EXT-NEG xn))
                (rfl)))))
      legs)))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dk-foralls '(x y)
  (dk-curry (list mfn-ptw mfn-yeq (mfn-no 'POS-INF)) '(= (EXT-PARTIAL-SUM y n) (EXT-NEG (EXT-PARTIAL-SUM x n)))))))))
(mfn-negate-proof! 'POS-INF 'ext-neg-add-up 'ext-psum-not-pos-inf)
(mfn-qed! 'ext-psum-negate-up)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dk-foralls '(x y)
  (dk-curry (list mfn-ptw mfn-yeq (mfn-no 'NEG-INF)) '(= (EXT-PARTIAL-SUM y n) (EXT-NEG (EXT-PARTIAL-SUM x n)))))))))
(mfn-negate-proof! 'NEG-INF 'ext-neg-add-down 'ext-psum-not-neg-inf)
(mfn-qed! 'ext-psum-negate-down)

;; ---------------------------------------------------------------------------
;; the negated series converges to the negated limit
(define (mfn-from! ex)
  (let* ((m (dk-skolem! ex))
         (u (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m))) "the eventual universal")))
    (cons m u)))
(define (mfn-star-of-lt! lt)          ; (< a b) in context: land a, b in RR-STAR
  (let ((a (cadr lt)) (b (caddr lt)))
    (dk-iff-fwd! (dk-cite! '< a b))
    (dk-split-all! (list (dk-cite! 'rr-star-leq-domain a b)))))
(define mfn-peq '(FORALL n_ (IMPLIES (IN n_ NN) (= (EXT-PARTIAL-SUM y n_) (EXT-NEG (EXT-PARTIAL-SUM x n_))))))
(sp (make-wff (dk-foralls '(x y l) (dk-curry (list '(EXT-SERIES-CONVERGES-TO x l) mfn-peq) '(EXT-SERIES-CONVERGES-TO y (EXT-NEG l))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'ext-series-converges-to 'x 'l)))
       (ireal (cadr parts)) (ipos (caddr parts)) (ineg (cadddr parts)))
  (dk-cite! 'ext-neg-in 'l)
  (mac 'ext-series-converges-to)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ((equal? (cadr gl) '(IN (EXT-NEG l) RR))
           (di)
           (dk-cite! 'ext-neg-real-back 'l)
           (subst (dk-cite! 'ext-neg-real 'l))
           (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g)))))
                  (_ (di))
                  (p1 (mfn-from! (dk-apply! (dk-apply! ireal) eps))))
             (ew (car p1))
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let ((n (dk-di-var!)))
                       (di)
                       (dk-split-all! (list (dk-apply! (cdr p1) n)))
                       (let* ((px (list 'EXT-PARTIAL-SUM 'x n)))
                         (subst (dk-apply! mfn-peq n))
                         (subst (dk-cite! 'ext-neg-real px))
                         (dk-cite! 'rr-neg-closed px)
                         (dk-cite! 'rr-neg-closed 'l)
                         (dk-type! (list '- px 'l) 'RR)
                         (dk-cite! 'rr-pos-rr-in-rr eps)
                         (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts (list '- px 'l) eps)))
                         (let ((dd (list '- (list '- px) '(- l))))
                           (dk-type! dd 'RR)
                           (dk-have! (list '< (list '- eps) dd)
                             (lambda () (dk-ineq! (list '< (list '- px 'l) eps) (list 'IN px 'RR) '(IN l RR) (list 'IN eps 'RR))))
                           (dk-have! (list '< dd eps)
                             (lambda () (dk-ineq! (list '< (list '- eps) (list '- px 'l)) (list 'IN px 'RR) '(IN l RR) (list 'IN eps 'RR))))
                           (dk-cite! 'rr-abs-lt-of-parts dd eps)
                           (dk-conj-close! dk-ass!)))))))))
          ((equal? (cadr gl) '(= (EXT-NEG l) POS-INF))
           (di)
           (dk-cite! 'ext-neg-to-pos-inf 'l)
           (let* ((cb (dk-di-var!))
                  (_ (dk-cite! 'rr-neg-closed cb))
                  (p1 (mfn-from! (dk-apply! (dk-apply! ineg) (list '- cb)))))
             (ew (car p1))
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let ((n (dk-di-var!)))
                       (di)
                       (dk-apply! (cdr p1) n)
                       (subst (dk-apply! mfn-peq n))
                       (mfn-star-of-lt! (dk-ctx-form (dk-apply! (cdr p1) n)))
                       (dk-cite! 'ext-neg-lt-flip (list 'EXT-PARTIAL-SUM 'x n) cb)
                       (dk-ass!)))))))
          (#t
           (di)
           (dk-cite! 'ext-neg-to-neg-inf 'l)
           (let* ((cb (dk-di-var!))
                  (_ (dk-cite! 'rr-neg-closed cb))
                  (p1 (mfn-from! (dk-apply! (dk-apply! ipos) (list '- cb)))))
             (ew (car p1))
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let ((n (dk-di-var!)))
                       (di)
                       (dk-apply! (cdr p1) n)
                       (subst (dk-apply! mfn-peq n))
                       (mfn-star-of-lt! (dk-ctx-form (dk-apply! (cdr p1) n)))
                       (dk-cite! 'ext-neg-gt-flip (list 'EXT-PARTIAL-SUM 'x n) cb)
                       (dk-ass!))))))))))))
(mfn-qed! 'ext-series-negate)

;; ---------------------------------------------------------------------------
;; -nu
(define mfn-nn '(SIGNED-NEG ca nu))
(sp (make-wff (dk-foralls '(ca nu a) (dk-curry '((IN a ca)) '(== ((SIGNED-NEG ca nu) a) (EXT-NEG (nu a)))))))
(dk-peel!)
(mac 'SIGNED-NEG)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (qrfl))
(mfn-qed! 'signed-neg-value)

(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IN nu (FUN ca RR-STAR)))
  '(IN (SIGNED-NEG ca nu) (FUN ca RR-STAR))))))
(dk-peel!)
(mac 'SIGNED-NEG)
(dk-lam-type!
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR a)
      (dk-cite! 'ext-neg-in (list 'nu a))
      (dk-ass!)))
  (lambda ()
    (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
    (dk-cite! 'membership-implies-sethood 'ca '(POWER (POWER omega)))
    (dk-ass!)))
(mfn-qed! 'signed-neg-fun)

(define (mfn-ex c) (list 'FORSOME 'sma_ (list 'AND '(IN sma_ ca) (list '= '(nu sma_) c))))
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu)) '(IS-SIGNED-MEASURE omega ca (SIGNED-NEG ca nu))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (notboth (list-ref parts 3)) (cadd (list-ref parts 4)))
  (dk-cite! 'signed-neg-fun 'omega 'ca 'nu)
  (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
  (mac 'is-signed-measure)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? gl '=)
           (subst (dk-cite! 'signed-neg-value 'ca 'nu 'EMPTY-SET))
           (subst '(= (nu EMPTY-SET) 0))
           (subst (dk-cite! 'ext-neg-zero))
           (fact 'rr-zero-in)
           (rfl))
          ((dk-head-is? gl 'NOT)
           (di)
           (let* ((both (car (dk-split! (dk-pick (dk-head? 'AND) "the two existentials")))))
             (let* ((exs (filter (dk-head? 'FORSOME) (dk-asms)))
                    (ep (find-first (lambda (f) (dk-contains? f 'POS-INF)) exs))
                    (en (find-first (lambda (f) (dk-contains? f 'NEG-INF)) exs))
                    (a (dk-skolem! ep))
                    (b (dk-skolem! en)))
               (for-each (lambda (z) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR z)) (list a b))
               (dk-cite! 'signed-neg-value 'ca 'nu a)
               (dk-rewrite-h! (list '= (list mfn-nn a) 'POS-INF) (list mfn-nn a) (list 'EXT-NEG (list 'nu a)))
               (dk-cite! 'signed-neg-value 'ca 'nu b)
               (dk-rewrite-h! (list '= (list mfn-nn b) 'NEG-INF) (list mfn-nn b) (list 'EXT-NEG (list 'nu b)))
               (dk-cite! 'ext-neg-to-pos-inf (list 'nu a))
               (dk-cite! 'ext-neg-to-neg-inf (list 'nu b))
               (dk-have! (list 'AND (mfn-ex 'POS-INF) (list 'FORSOME 'smb_ (list 'AND '(IN smb_ ca) '(= (nu smb_) NEG-INF))))
                 (lambda ()
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-contains? (dk-goal) 'POS-INF)
                           (begin (ew b) (dk-conj-close! dk-ass!))
                           (begin (ew a) (dk-conj-close! dk-ass!)))))))
               (ai notboth))))
          (#t
           (let* ((fv (dk-di-var!)))
             (di)
             (let* ((x (list 'VNB-LAMBDA 'smn_ 'NN (list 'nu (list fv 'smn_))))
                    (y (list 'VNB-LAMBDA 'smn_ 'NN (list mfn-nn (list fv 'smn_))))
                    (bu (list 'BIG-UNION 'smn_ 'NN (list fv 'smn_)))
                    (ty! (lambda (k) (dk-cite! 'fun-apply-type-c fv 'NN 'ca k) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR (list fv k)))))
               (dk-apply! cadd fv)
               (dk-cite! 'sigma-algebra-union-closed 'omega 'ca fv)
