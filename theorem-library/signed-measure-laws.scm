(define (mfq-seg n) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT n) '(f uj_)))
;; open w in a segment union: return the index j (landed: j in seg n, j in NN, w in f j)
(define (mfq-seg-open! w n)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w (mfq-seg n))))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'ORD-SEGMENT n)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (if (not ein) (error "mfq-seg-open!: no index landed" landed))
    (dk-cite! 'ord-segment-nn-subset n (cadr ein))
    (cadr ein)))

