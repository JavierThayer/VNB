;; keep the named formulas and run prop -- only on the leaf the keep was written for (when keep
;; finds that sequent already proven it closes the leaf and the focus moves; prop must not follow it)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mfa-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (mfa-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFA OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define (mfa-star-cases! t k)
  (let ((iff (dk-cite! 'rr-star-membership t)))
    (dk-have! (caddr iff) (lambda () (mfa-keep-prop! iff (list 'IN t 'RR-STAR))))
    (dk-or-each! (dk-ctx-form (caddr iff))
      (lambda (d)
        (cond ((equal? d (list 'IN t 'RR)) (k 'real))
              ((equal? d (list '= t 'POS-INF)) (k 'pos))
              (#t (k 'neg)))))))

;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL x (FORALL y (IMPLIES (IN x RR-STAR) (IMPLIES (IN y RR-STAR) (IN (EXT-ADD x y) RR-STAR)))))))
(dk-peel!)
(fact 'pos-inf-in-rr-star) (fact 'neg-inf-in-rr-star) (fact 'rr-subset-rr-star)
(mfa-star-cases! 'x
  (lambda (cx)
    (case cx
      ((pos) (subst '(= x POS-INF)) (dk-cite! 'ext-add-pos-inf-left 'y) (subst '(= (EXT-ADD POS-INF y) POS-INF)) (dk-ass!))
      (else
       (mfa-star-cases! 'y
         (lambda (cy)
           (case cy
             ((pos) (subst '(= y POS-INF)) (dk-cite! 'ext-add-pos-inf-right 'x) (subst '(= (EXT-ADD x POS-INF) POS-INF)) (dk-ass!))
             ((neg) (subst '(= y NEG-INF))
                    (if (eq? cx 'real) (dk-cite! 'ext-real-not-pos-inf 'x)
                        (begin (fact 'neg-inf-neq-pos-inf) (dk-have! '(NOT (= x POS-INF)) (lambda () (subst '(= x NEG-INF)) (dk-ass!)))))
                    (subst (dk-cite! 'ext-add-neg-inf-right 'x)) (dk-ass!))
             (else
              (if (eq? cx 'neg)
                  (begin (subst '(= x NEG-INF)) (dk-cite! 'ext-real-not-pos-inf 'y)
                         (subst (dk-cite! 'ext-add-neg-inf-left 'y)) (dk-ass!))
                  (begin (subst (dk-cite! 'ext-add-real 'x 'y))
                         (dk-have-and! '(IN x RR) '(IN y RR))
                         (dk-cite! 'rr-add-closed 'x 'y)
                         (dk-cite! 'subset-mem-fwd 'RR 'RR-STAR '(+ x y))
                         (dk-ass!)))))))))))
(mfa-qed! 'ext-add-in)

;; ---------------------------------------------------------------------------
;; eventually-zero extended series
(define mfa-ptw '(FORALL k_ (IMPLIES (IN k_ NN) (IN (x k_) RR-STAR))))
(define mfa-zeros '(FORALL k_ (IMPLIES (IN k_ NN) (IMPLIES (<= m k_) (= (x k_) 0)))))

(sp (make-wff (list 'FORALL 'd (list 'IMPLIES '(IN d NN) (dk-foralls '(x m)
  (dk-curry (list '(IN m NN) mfa-ptw mfa-zeros) '(= (EXT-PARTIAL-SUM x (+ m d)) (EXT-PARTIAL-SUM x m))))))))
(let ((legs (dk-opened (lambda () (ni)))))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (if (not (dk-head-is? (dk-goal) 'FORALL))
          (error "mfa: unexpected induction leg" (dk-goal)))
      (if (dk-contains? (dk-goal) '(+ m 0))
          (begin
            (dk-peel!)
            (dk-have! '(= (+ m 0) m) (lambda () (dk-nn!)))
            (subst '(= (+ m 0) m))
            (dk-cite! 'ext-psum-in 'x 'm)
            (rfl))
          (let* ((dv (dk-di-var!))
                 (ih (dk-landed-1 (lambda () (di)))))
            (dk-peel!)
            (let ((md (list '+ 'm dv)))
              (dk-have-and! '(IN m NN) (list 'IN dv 'NN))
              (dk-cite! 'nn-add-closed 'm dv)
              (dk-cite! 'nn-succ-closed dv)
              (dk-cite! 'nn-succ-closed md)
              (dk-have! (list '= (list '+ 'm (list 'succ dv)) (list 'succ md)) (lambda () (dk-nn!)))
              (subst (list '= (list '+ 'm (list 'succ dv)) (list 'succ md)))
              (subst (dk-cite! 'ext-psum-succ 'x md))
              (subst (dk-apply! ih 'x 'm))
              (dk-cite! 'nn-le-add-right dv 'm)
              (subst (dk-apply! mfa-zeros md))
              (dk-cite! 'ext-psum-in 'x 'm)
              (subst (dk-cite! 'ext-add-zero-right '(EXT-PARTIAL-SUM x m)))
              (rfl)))))
    legs))
(mfa-qed! 'ext-psum-stable)

(define mfa-evc '(FORSOME m_ (AND (IN m_ NN) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= m_ n_)
                    (= (EXT-PARTIAL-SUM x n_) (EXT-PARTIAL-SUM x m))))))))
(sp (make-wff (dk-foralls '(x m) (dk-curry (list '(IN m NN) mfa-ptw mfa-zeros) mfa-evc))))
(dk-peel!)
(ew 'm)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let ((nv (dk-di-var!)))
          (di)
          (let ((dv (dk-skolem! (dk-cite! 'nn-le-gap nv 'm))))
            (subst (list '= nv (list '+ 'm dv)))
            (dk-cite! 'ext-psum-stable dv 'x 'm)
            (dk-ass!))))))
(mfa-qed! 'ext-psum-eventually)

(sp (make-wff (dk-foralls '(x l m) (dk-curry (list '(IN m NN) '(EXT-SERIES-CONVERGES-TO x l) mfa-ptw mfa-zeros)
  '(= l (EXT-PARTIAL-SUM x m))))))
(dk-peel!)
(dk-cite! 'ext-psum-eventually 'x 'm)
(dk-cite! 'ext-psum-in 'x 'm)
(dk-cite! 'ext-series-limit-const 'x 'l '(EXT-PARTIAL-SUM x m))
(dk-ass!)
(mfa-qed! 'ext-series-sum-finite)

;; ---------------------------------------------------------------------------
;; the padded two-set family a, b, empty, empty, ...  (mechanics copied from measure-laws.scm, mlw-)
(define (mfa-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfa-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfa-if-eq! true? ifterm closer)
  (let* ((c      (cadr ifterm))
         (val    (if true? (caddr ifterm) (cadddr ifterm)))
         (want   (if true? c (list 'NOT c)))
         (opened (dk-opened (lambda () (if true? (if-true ifterm) (if-false ifterm)))))
         (conds  (filter (lambda (l) (alpha-equiv? (dk-goal-of l) want)) opened))
         (mains  (filter (lambda (l) (not (memq l conds))) opened)))
    (if (not (and (<= (length conds) 1) (= 1 (length mains))))
        (error "mfa-if-eq!: expected one condition leaf and one main leaf, got"
               (map (lambda (l) (expression->string (dk-goal-of l))) opened)))
    (if (pair? conds) (begin (dk-focus! (car conds)) (closer)))
    (dk-focus! (car mains))
    (list '= ifterm val)))
(define (mfa-transfer! eqn rel lhs)
  (let ((val (caddr eqn)) (ifterm (cadr eqn)))
    (dk-have! (list rel lhs val)
              (lambda () (subst (list '= val ifterm)) (ass)))))
(define (mfa-inter-empty! x y nogo)
  (let ((ix (list 'INTERSECTION x y)))
    (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ ix) (list 'IN 'w_ 'EMPTY-SET)))
      (lambda ()
        (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (fact 'empty-set-has-no-members w)
          (let ((keepers (nogo w)))
            (mac 'intersection-membership)
            (apply dk-only! (cons (list 'NOT (list 'IN w 'EMPTY-SET)) keepers))
            (prop)))))
    (fact 'class-extensionality ix 'EMPTY-SET)
    (ass)))

(define mfa-fam '(VNB-LAMBDA mk_ NN (IF (= mk_ 0) a_ (IF (= mk_ (succ 0)) b_ EMPTY-SET))))
(define (mfa-disj g) (list 'FORALL 'smi_ (list 'FORALL 'smj_ (dk-curry '((IN smi_ NN) (IN smj_ NN) (NOT (= smi_ smj_)))
                       (list '= (list 'INTERSECTION (list g 'smi_) (list g 'smj_)) 'EMPTY-SET)))))
(define (mfa-zeros2 g) (list 'FORALL 'k_ (dk-curry '((IN k_ NN) (<= (succ (succ 0)) k_)) (list '= (list g 'k_) 'EMPTY-SET))))
(define (mfa-bu g) (list 'BIG-UNION 'smn_ 'NN (list g 'smn_)))
(define (mfa-pad-claim g)
  (dk-and (list (list 'IN g '(FUN NN ca)) (mfa-disj g) (list '= (list g 0) 'a_) (list '= (list g '(succ 0)) 'b_)
                (mfa-zeros2 g) (list '= (mfa-bu g) '(UNION a_ b_)))))

(sp (make-wff (dk-foralls '(ca a_ b_) (dk-curry '((IN EMPTY-SET ca) (IN a_ ca) (IN b_ ca) (= (INTERSECTION a_ b_) EMPTY-SET))
  (list 'FORSOME 'g_ (mfa-pad-claim 'g_))))))
(dk-peel!)
(fact 'nn-zero-in)
(fact 'nn-succ-closed 0)
(fact 'nn-succ-closed '(succ 0))
(fact 'nn-succ-nonzero 0)
(let ((g mfa-fam) (s0 '(succ 0)))
  (dk-have! (list 'IN g '(FUN NN ca))
    (lambda ()
      (dk-lam-t!)
      (dk-peel!)
      (let ((ift (mfa-find-if (dk-goal))))
        (dk-case-if! ift
          (lambda (t1 v1)
            (if t1 (ass)
                (dk-case-if! (mfa-find-if (dk-goal)) (lambda (t2 v2) (ass)))))))))
  (ew g)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ;; disjointness
          ((dk-head-is? gl 'FORALL)
           (if (dk-contains? gl 'INTERSECTION)
               (let* ((no-ab (lambda (w)
                               (let ((nab (list 'NOT (list 'IN w '(INTERSECTION a_ b_)))))
                                 (dk-have! nab (lambda () (subst '(= (INTERSECTION a_ b_) EMPTY-SET)) (ass)))
                                 (list nab (dk-fact! 'intersection-membership 'a_ 'b_ w)))))
                      (no-e (lambda (w) '())))
                 (dk-peel!)
                 (let* ((gl2 (dk-goal))
                        (iv (cadr (cadr (cadr gl2))))
                        (jv (cadr (caddr (cadr gl2))))
                        (contra (lambda (c)
                                  (dk-have! (list '= iv jv)
                                    (lambda () (subst (list '= iv c)) (subst (list '= jv c)) (rfl)))
                                  (ai (list 'NOT (list '= iv jv))))))
                   (for-each (lambda (v)
                               (let ((ty (dk-fact! 'fun-apply-type-c g 'NN 'ca v)))
                                 (dk-lam-b-h! ty)))
                             (list iv jv))
                   (dk-lam-b!)
                   (dk-case-if! (mfa-find-if (dk-goal))
                     (lambda (ti vi)
                       (if ti
                           (dk-case-if! (mfa-find-if (dk-goal))
                             (lambda (tj vj)
                               (if tj (contra 0)
                                   (dk-case-if! (mfa-find-if (dk-goal))
                                     (lambda (tj2 vj2)
                                       (if tj2 (ass)
                                           (mfa-inter-empty! 'a_ 'EMPTY-SET no-e)))))))
                           (dk-case-if! (mfa-find-if (dk-goal))
                             (lambda (ti2 vi2)
                               (if ti2
                                   (dk-case-if! (mfa-find-if (dk-goal))
                                     (lambda (tj vj)
                                       (if tj (mfa-inter-empty! 'b_ 'a_ no-ab)
                                           (dk-case-if! (mfa-find-if (dk-goal))
                                             (lambda (tj2 vj2)
                                               (if tj2 (contra s0)
                                                   (mfa-inter-empty! 'b_ 'EMPTY-SET no-e)))))))
                                   (mfa-inter-empty! 'EMPTY-SET (caddr (cadr (dk-goal))) no-e)))))))))
               ;; zeros from 2 on
               (let ((kv (dk-di-var!)))
                 (di)
                 (dk-have! (list 'NOT (list '= kv 0))
                   (lambda () (di) (dk-nn-absurd! (list '<= '(succ (succ 0)) kv) (list '= kv 0))))
                 (dk-have! (list 'NOT (list '= kv s0))
                   (lambda () (di) (dk-nn-absurd! (list '<= '(succ (succ 0)) kv) (list '= kv s0))))
                 (dk-lam-b!)
                 (dk-if-branch! #f (mfa-find-if (dk-goal)) #f
                   (lambda ()
                     (dk-if-branch! #f (mfa-find-if (dk-goal)) #f (lambda () (rfl))))))))
          ;; the two values
          ((equal? gl (list '= (list g 0) 'a_))
           (dk-lam-b!)
           (dk-if-branch! #t (mfa-find-if (dk-goal)) (lambda () (rfl)) (lambda () (rfl))))
          ((equal? gl (list '= (list g s0) 'b_))
           (dk-lam-b!)
           (dk-if-branch! #f (mfa-find-if (dk-goal)) #f
             (lambda () (dk-if-branch! #t (mfa-find-if (dk-goal)) (lambda () (rfl)) (lambda () (rfl))))))
          ;; the union
          (#t
           (let ((bu (mfa-bu g)) (uab '(UNION a_ b_)))
             (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ bu) (list 'IN 'w_ uab)))
               (lambda ()
                 (let ((w (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
                   (for-each
                     (lambda (l)
                       (dk-focus! l)
                       (if (equal? (dk-goal) (list 'IN w uab))
                           (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                                  (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
                                  (app (find-first (lambda (f) (not (eq? f ein))) landed)))
                             (dk-lam-b-h! app)
                             (let ((ife (dk-pick (lambda (f) (and (eq? (car f) 'IN) (eq? (cadr f) w)
                                                                  (pair? (caddr f)) (eq? (car (caddr f)) 'IF)))
                                                 "w in IF")))
                               (mac 'union-membership)
                               (let ((ift (caddr ife)))
                                 (use-em (cadr ift)
                                   (lambda ()
                                     (mfa-transfer! (mfa-if-eq! #t ift dk-ass!) 'IN w)
                                     (oi-l) (ass))
                                   (lambda ()
                                     (let* ((e1 (mfa-if-eq! #f ift dk-ass!))
                                            (ift2 (caddr e1)))
                                       (mfa-transfer! e1 'IN w)
                                       (use-em (cadr ift2)
                                         (lambda ()
                                           (mfa-transfer! (mfa-if-eq! #t ift2 dk-ass!) 'IN w)
                                           (oi-r) (ass))
                                         (lambda ()
                                           (mfa-transfer! (mfa-if-eq! #f ift2 dk-ass!) 'IN w)
                                           (fact 'empty-set-has-no-members w)
                                           (ai (list 'NOT (list 'IN w 'EMPTY-SET)))))))))))
                           (let ((orf (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w uab))))))
                             (for-each
                               (lambda (m)
                                 (dk-focus! m)
                                 (let* ((a-side (dk-asm? (list 'IN w 'a_)))
                                        (k (if a-side 0 s0)))
                                   (for-each
                                     (lambda (n)
                                       (dk-focus! n)
                                       (if (equal? (dk-goal) (list 'IN k 'NN))
                                           (ass)
                                           (begin
                                             (dk-lam-b!)
                                             (if a-side
                                                 (dk-if-branch! #t (mfa-find-if (dk-goal)) (lambda () (rfl)) dk-ass!)
                                                 (dk-if-branch! #f (mfa-find-if (dk-goal)) #f
                                                   (lambda ()
                                                     (dk-if-branch! #t (mfa-find-if (dk-goal)) (lambda () (rfl)) dk-ass!)))))))
                                     (dk-opened (lambda () (bu-mi k))))))
                               (dk-opened (lambda () (ai orf)))))))
                     (dk-opened (lambda () (di)))))))
             (fact 'class-extensionality bu uab)
             (dk-ass!))))))))
(mfa-qed! 'pad2-family-exists)

;; ---------------------------------------------------------------------------
;; signed measures: the conjuncts, two-term sums, finite additivity
(define (mfa-sm-parts! om ca nu)
  (dk-iff-parts! (dk-cite! 'is-signed-measure om ca nu)))

(define mfa-X '(VNB-LAMBDA smn_ NN (nu (g smn_))))
(sp (make-wff (dk-foralls '(omega ca nu g) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) '(IN g (FUN NN ca)) (mfa-disj 'g) (mfa-zeros2 'g))
  '(= (nu (BIG-UNION smn_ NN (g smn_))) (EXT-ADD (nu (g 0)) (nu (g (succ 0)))))))))
(dk-peel!)
(fact 'nn-zero-in)
(fact 'nn-succ-closed 0)
(fact 'nn-succ-closed '(succ 0))
(let* ((parts (mfa-sm-parts! 'omega 'ca 'nu))
       (cadd (list-ref parts 4))
       (X mfa-X) (s0 '(succ 0)) (ss0 '(succ (succ 0)))
       (bu '(BIG-UNION smn_ NN (g smn_)))
       (ptw (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IN (list X 'k_) 'RR-STAR))))
       (zer (list 'FORALL 'k_ (dk-curry (list '(IN k_ NN) (list '<= ss0 'k_)) (list '= (list X 'k_) 0))))
       (ty! (lambda (k) (dk-cite! 'fun-apply-type-c 'g 'NN 'ca k) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR (list 'g k)))))
  (dk-apply! cadd 'g)
  (dk-have! ptw (lambda () (let ((k (dk-di-var!))) (dk-lam-b!) (ty! k) (dk-ass!))))
  (dk-have! zer (lambda () (let ((k (dk-di-var!))) (di) (dk-lam-b!) (subst (dk-apply! (mfa-zeros2 'g) k)) (dk-ass!))))
  (dk-cite! 'ext-series-sum-finite X (list 'nu bu) ss0)
  (ty! 0) (ty! s0)
  (let ((e2 (dk-cite! 'ext-psum-succ X s0))
        (e1 (dk-cite! 'ext-psum-succ X 0)))
    (dk-lam-b-h! e2) (dk-lam-b-h! e1))
  (dk-cite! 'ext-psum-zero X)
  (dk-cite! 'ext-add-zero-left '(nu (g 0)))
  (dk-cite! 'ext-add-in '(nu (g 0)) '(nu (g (succ 0))))
  (subst (list '= (list 'nu bu) (list 'EXT-PARTIAL-SUM X ss0)))
  (subst (list '= (list 'EXT-PARTIAL-SUM X ss0) (list 'EXT-ADD (list 'EXT-PARTIAL-SUM X s0) (list 'nu (list 'g s0)))))
  (subst (list '= (list 'EXT-PARTIAL-SUM X s0) (list 'EXT-ADD (list 'EXT-PARTIAL-SUM X 0) '(nu (g 0)))))
  (subst (list '= (list 'EXT-PARTIAL-SUM X 0) 0))
  (subst '(= (EXT-ADD 0 (nu (g 0))) (nu (g 0))))
  (rfl))
(mfa-qed! 'signed-sum-two)

(sp (make-wff (dk-foralls '(omega ca nu a_ b_) (dk-curry '((IS-SIGNED-MEASURE omega ca nu) (IN a_ ca) (IN b_ ca) (= (INTERSECTION a_ b_) EMPTY-SET))
  '(= (nu (UNION a_ b_)) (EXT-ADD (nu a_) (nu b_)))))))
(dk-peel!)
(let* ((parts (mfa-sm-parts! 'omega 'ca 'nu))
       (sig (car parts)))
  (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
  (let* ((ex (dk-cite! 'pad2-family-exists 'ca 'a_ 'b_))
         (g (dk-skolem! ex)))
    (dk-cite! 'signed-sum-two 'omega 'ca 'nu g)
    (subst (list '= '(UNION a_ b_) (mfa-bu g)))
    (subst (list '= 'a_ (list g 0)))
    (subst (list '= 'b_ (list g '(succ 0))))
    (dk-ass!)))
(mfa-qed! 'signed-measure-fa)

  

