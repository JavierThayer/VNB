;; the family h(k) = e n f(k)
(define (mfq-disj g) (list 'FORALL 'smi_ (list 'FORALL 'smj_ (dk-curry '((IN smi_ NN) (IN smj_ NN) (NOT (= smi_ smj_)))
                       (list '= (list 'INTERSECTION (list g 'smi_) (list g 'smj_)) 'EMPTY-SET)))))
(define (mfq-bu g) (list 'BIG-UNION 'smn_ 'NN (list g 'smn_)))
(define mfq-H '(VNB-LAMBDA hk_ NN (INTERSECTION e (f hk_))))
