(define mfh-ge '(FORALL k_ (IMPLIES (IN k_ NN) (<= k_ (nu (bq k_))))))
(define mfh-X '(VNB-LAMBDA smn_ NN (nu (c smn_))))
(define (mfh-breal! k)               ; (IN (nu (bq k)) RR)
  (dk-cite! 'fun-apply-type-c 'bq 'NN 'ca k)
  (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR (list 'bq k))
  (dk-cite! 'nn-in-rr k)
  (dk-apply! mfh-ge k)
  (dk-apply! mfh-nopinf (list 'bq k))
  (dk-cite! 'ext-real-of-ge (list 'nu (list 'bq k)) k))
(define (mfh-tel-hyps)
  (list '(IS-SIGNED-MEASURE omega ca nu) mfh-nopinf '(IN bq (FUN NN ca)) mfh-dec mfh-ge '(IN c (FUN NN ca)) (mfh-dval 'c)))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (dk-foralls '(omega ca nu bq c) (dk-curry (mfh-tel-hyps)
  (list 'AND (list 'IN (list 'EXT-PARTIAL-SUM mfh-X 'n) 'RR)
             (list '= (list 'EXT-PARTIAL-SUM mfh-X 'n) '(- (nu (bq 0)) (nu (bq n)))))))))))
(let ((legs (dk-opened (lambda () (ni)))))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (if (dk-contains? (dk-goal) '(bq 0))
          (if (not (dk-contains? (dk-goal) '(succ n)))
              #t #t))
      (let ((base? (not (dk-head-is? (dk-goal) 'FORALL))))
        #t)
      (if (dk-contains? (dk-goal) (list 'EXT-PARTIAL-SUM mfh-X 0))
          (begin
            (dk-peel!)
            (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu))
            (fact 'nn-zero-in)
            (mfh-breal! 0)
            (subst (dk-cite! 'ext-psum-zero mfh-X))
            (fact 'rr-zero-in)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! '(IN (nu (bq 0)) RR))))))
          (let* ((nv (dk-di-var!))
                 (ih (dk-landed-1 (lambda () (di)))))
            (dk-peel!)
            (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu))
            (let* ((sn (list 'succ nv)) (bn (list 'bq nv)) (bsn (list 'bq sn)) (cn (list 'c nv))
                   (p (list 'EXT-PARTIAL-SUM mfh-X nv)))
              (fact 'nn-zero-in)
              (dk-cite! 'nn-succ-closed nv)
              (dk-split-all! (list (dk-apply! ih 'omega 'ca 'nu 'bq 'c)))
              (mfh-breal! 0) (mfh-breal! nv) (mfh-breal! sn)
              (dk-cite! 'fun-apply-type-c 'c 'NN 'ca nv)
              (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR cn)
              (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IN (list mfh-X 'k_) 'RR-STAR)))
                (lambda () (let ((k (dk-di-var!))) (dk-lam-b!)
                             (dk-cite! 'fun-apply-type-c 'c 'NN 'ca k) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR (list 'c k)) (dk-ass!))))
              (let ((e (dk-cite! 'ext-psum-succ mfh-X nv)))
                (dk-lam-b-h! e))
              (subst (list '= (list 'EXT-PARTIAL-SUM mfh-X sn) (list 'EXT-ADD p (list 'nu cn))))
              ;; nu(B n) = nu(B n+1) + nu(c n)
              (let ((dv (dk-apply! (mfh-dval 'c) nv))
                    (cmp (list 'COMPLEMENT-IN bn bsn)))
                (dk-rewrite-h! (dk-cite! 'intersection-complement-in-empty bsn bn) cmp cn)
                (dk-apply! mfh-dec nv)
                (dk-rewrite-h! (dk-cite! 'union-complement-in bsn bn) cmp cn)
                (dk-cite! 'signed-measure-fa 'omega 'ca 'nu bsn cn)
                (dk-rewrite-h! (list '= (list 'nu (list 'UNION bsn cn)) (list 'EXT-ADD (list 'nu bsn) (list 'nu cn)))
                               (list 'UNION bsn cn) bn))
              (dk-apply! mfh-nopinf cn)
              (dk-cite! 'ext-real-not-pos-inf (list 'nu bsn))
              (use-em (list '= (list 'nu cn) 'NEG-INF)
                (lambda ()
                  (dk-rewrite-h! (list '= (list 'nu bn) (list 'EXT-ADD (list 'nu bsn) (list 'nu cn))) (list 'nu cn) 'NEG-INF)
                  (dk-cite! 'ext-add-neg-inf-right (list 'nu bsn))
                  (dk-rewrite-h! (list '= (list 'nu bn) (list 'EXT-ADD (list 'nu bsn) 'NEG-INF)) (list 'EXT-ADD (list 'nu bsn) 'NEG-INF) 'NEG-INF)
                  (dk-rewrite-h! (list 'IN (list 'nu bn) 'RR) (list 'nu bn) 'NEG-INF)
                  (ai (dk-cite! 'neg-inf-not-in-rr)))
                (lambda ()
                  (let ((iff (dk-cite! 'rr-star-membership (list 'nu cn))))
                    (dk-have! (list 'IN (list 'nu cn) 'RR)
                      (lambda () (mfh-keep-prop! iff (list 'IN (list 'nu cn) 'RR-STAR) (list 'NOT (list '= (list 'nu cn) 'POS-INF))
                                       (list 'NOT (list '= (list 'nu cn) 'NEG-INF))))))
                  (dk-cite! 'ext-add-real (list 'nu bsn) (list 'nu cn))
                  (dk-rewrite-h! (list '= (list 'nu bn) (list 'EXT-ADD (list 'nu bsn) (list 'nu cn)))
                                 (list 'EXT-ADD (list 'nu bsn) (list 'nu cn)) (list '+ (list 'nu bsn) (list 'nu cn)))
                  (subst (dk-cite! 'ext-add-real p (list 'nu cn)))
                  (dk-have-and! (list 'IN p 'RR) (list 'IN (list 'nu cn) 'RR))
                  (dk-cite! 'rr-add-closed p (list 'nu cn))
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (dk-ineq! (list '= p (list '- '(nu (bq 0)) (list 'nu bn)))
                                    (list '= (list 'nu bn) (list '+ (list 'nu bsn) (list 'nu cn)))
                                    (list 'IN p 'RR) (list 'IN (list 'nu cn) 'RR) (list 'IN (list 'nu bsn) 'RR)
                                    (list 'IN (list 'nu bn) 'RR) '(IN (nu (bq 0)) RR)))))))))))
    legs))
(mfh-qed! 'signed-telescope)

;; ---------------------------------------------------------------------------
;; a decreasing sequence with nu(B j) >= j, nu never +inf: nu(B 0) = -inf
(sp (make-wff (dk-foralls '(omega ca nu bq) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) mfh-nopinf '(IN bq (FUN NN ca)) mfh-dec mfh-ge)
  '(= (nu (bq 0)) NEG-INF)))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (sig (car parts)) (cadd (list-ref parts 4))
       (chain (mfh-chain!))
       (c (dk-skolem! (dk-cite! 'diff-family-exists 'omega 'ca 'bq)))
       (X (list 'VNB-LAMBDA 'smn_ 'NN (list 'nu (list c 'smn_))))
       (U (mfh-bu c))
       (b0 '(bq 0)))
  (fact 'nn-zero-in)
  (mfh-breal! 0)
  (dk-apply! cadd c)
  (dk-have! (list 'FORALL 'cb_ (list 'IMPLIES '(IN cb_ RR) (list 'FORSOME 'm_ (list 'AND '(IN m_ NN)
              (list 'FORALL 'n_ (dk-curry '((IN n_ NN) (<= m_ n_)) (list '<= (list 'EXT-PARTIAL-SUM X 'n_) 'cb_)))))))
    (lambda ()
      (let* ((cb (dk-di-var!))
             (_ (dk-type! (list '- '(nu (bq 0)) cb) 'RR))
             (nn (dk-skolem! (dk-cite! 'nn-above-real (list '- '(nu (bq 0)) cb)))))
        (ew nn)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((n (dk-di-var!)))
                  (di)
                  (dk-split-all! (list (dk-cite! 'signed-telescope n 'omega 'ca 'nu 'bq c)))
                  (mfh-breal! n)
                  (dk-cite! 'nn-in-rr nn)
                  (dk-ineq! (list '= (list 'EXT-PARTIAL-SUM X n) (list '- '(nu (bq 0)) (list 'nu (list 'bq n))))
                            (list '<= n (list 'nu (list 'bq n))) (list '<= (list '- '(nu (bq 0)) cb) nn) (list '<= nn n)
                            (list 'IN (list 'EXT-PARTIAL-SUM X n) 'RR) (list 'IN (list 'nu (list 'bq n)) 'RR)
                            '(IN (nu (bq 0)) RR) (list 'IN n 'RR) (list 'IN nn 'RR) (list 'IN cb 'RR)))))))))
  (dk-cite! 'ext-series-limit-down X (list 'nu U))
  ;; U inside B 0
  (dk-have! (list 'SUBSET U b0)
    (lambda ()
      (let* ((w (subset-by-element!))
             (r (dk-bu-open! w U)) (k (car r)))
        (let ((dv (dk-apply! (mfh-dval c) k)))
          (dk-rewrite-h! (list 'IN w (list c k)) (list c k) (caddr dv))
          (dk-iff-fwd! (dk-cite! 'complement-in-membership (list 'bq k) (list 'bq (list 'succ k)) w))
          (dk-cite! 'nn-zero-le k)
          (dk-apply! chain 0 k)
          (dk-cite! 'subset-mem-fwd (list 'bq k) b0 w)
          (dk-ass!)))))
  (dk-cite! 'sigma-algebra-union-closed 'omega 'ca c)
  (dk-cite! 'fun-apply-type-c 'bq 'NN 'ca 0)
  (let ((rest (list 'COMPLEMENT-IN b0 U)))
    (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca b0 U)
    (dk-cite! 'intersection-complement-in-empty U b0)
    (dk-cite! 'union-complement-in U b0)
    (dk-cite! 'signed-measure-fa 'omega 'ca 'nu U rest)
    (dk-apply! mfh-nopinf rest)
    (subst (list '= b0 (list 'UNION U rest)))
    (subst (list '= (list 'nu (list 'UNION U rest)) (list 'EXT-ADD (list 'nu U) (list 'nu rest))))
    (subst (list '= (list 'nu U) 'NEG-INF))
    (subst (dk-cite! 'ext-add-neg-inf-left (list 'nu rest)))
    (rfl)))
(mfh-qed! 'signed-decreasing-neg-inf)

  

