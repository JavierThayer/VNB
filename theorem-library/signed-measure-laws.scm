           (dk-peel!)
           (let* ((gl2 (dk-goal))
                  (iv (cadr (cadr (cadr gl2))))
                  (jv (cadr (caddr (cadr gl2)))))
             (dk-lam-b!)
             (dk-apply! (mfq-disj 'f) iv jv)
             (dk-cite! 'inter-sub-right 'e (list 'f iv))
             (dk-cite! 'inter-sub-right 'e (list 'f jv))
             (dk-cite! 'disjoint-of-subsets (list 'f iv) (list 'f jv) (list 'INTERSECTION 'e (list 'f iv)) (list 'INTERSECTION 'e (list 'f jv)))
             (dk-ass!)))
          ((dk-head-is? gl 'FORALL)
           (let ((k (dk-di-var!)))
             (dk-lam-b!)
             (dk-cite! 'inter-sub-right 'e (list 'f k))
             (dk-ass!)))
          (#t
           (let ((bu (mfq-bu H)))
