      ((neg) (subst '(= x NEG-INF)) (subst (dk-cite! 'ext-neg-neg-inf)) (fact 'pos-inf-in-rr-star) (dk-ass!))
      (else (subst (dk-cite! 'ext-neg-real 'x)) (dk-cite! 'rr-neg-closed 'x) (mfn-rstar! '(- x)) (dk-ass!)))))
