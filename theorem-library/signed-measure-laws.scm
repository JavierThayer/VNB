                       (dk-have-and! (list 'IN w 'e) (list 'IN w (list 'f k)))
                       (dk-iff-bwd! (dk-cite! 'intersection-membership 'e (list 'f k) w))
                       (dk-ass!)))
                   (dk-bu-close! k))))
             (dk-ass!))))))))
