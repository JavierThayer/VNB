;; keep the named formulas and run prop -- only on the leaf the keep was written for (when keep
;; finds that sequent already proven it closes the leaf and the focus moves; prop must not follow it)
(define (mfp-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (mfp-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFP OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define (mfp-star-cases! t k)
  (let ((iff (dk-cite! 'rr-star-membership t)))
    (dk-have! (caddr iff) (lambda () (mfp-keep-prop! iff (list 'IN t 'RR-STAR))))
    (dk-or-each! (dk-ctx-form (caddr iff))
      (lambda (d)
        (cond ((equal? d (list 'IN t 'RR)) (k 'real))
              ((equal? d (list '= t 'POS-INF)) (k 'pos))
              (#t (k 'neg)))))))

(define (mfp-le-trans! a b c)
  (dk-have-and! (list 'IN a 'RR-STAR) (list 'IN b 'RR-STAR) (list 'IN c 'RR-STAR))
  (dk-have-and! (list '<= a b) (list '<= b c))
  (dk-cite! 'rr-star-leq-transitive a b c))

;; RR-POS-STAR typing -> RR-STAR typing
(define (mfp-star! t)
  (fact 'rr-pos-star-subset-rr-star)
  (dk-cite! 'subset-mem-fwd 'RR-POS-STAR 'RR-STAR t))

;; RR typing -> RR-STAR typing
(define (mfp-rstar! t)
  (fact 'rr-subset-rr-star)
  (dk-cite! 'subset-mem-fwd 'RR 'RR-STAR t))

(define (mfp-pvset a)
  (list 'SEP 'pvv_ 'RR-POS-STAR
        (list 'FORSOME 'pve_ (list 'AND '(IN pve_ ca) (list 'AND (list 'SUBSET 'pve_ a) '(= (nu pve_) pvv_))))))
(define (mfp-pv a) (list '(POS-VARIATION ca nu) a))

(sp (make-wff (dk-foralls '(ca nu a) (dk-curry '((IN a ca)) (list '== (mfp-pv 'a) (list 'ESUP (mfp-pvset 'a)))))))
(dk-peel!)
(mac 'POS-VARIATION)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (qrfl))
(mfp-qed! 'pos-variation-value)

(sp (make-wff (dk-foralls '(ca nu a) (list 'SUBSET (mfp-pvset 'a) 'RR-POS-STAR))))
(dk-peel!)
(let ((w (subset-by-element!)))
  (dk-sep-parts! (list 'IN w (mfp-pvset 'a)))
  (dk-ass!))
(mfp-qed! 'pos-variation-set-sub)

(sp (make-wff (dk-foralls '(ca nu a) (dk-curry '((IN a ca)) (list 'IN (mfp-pv 'a) 'RR-POS-STAR)))))
(dk-peel!)
(dk-cite! 'pos-variation-value 'ca 'nu 'a)
(dk-cite! 'pos-variation-set-sub 'ca 'nu 'a)
(dk-cite! 'esup-in (mfp-pvset 'a))
(subst (list '== (mfp-pv 'a) (list 'ESUP (mfp-pvset 'a))))
(dk-ass!)
(mfp-qed! 'pos-variation-in)

(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGMA-ALGEBRA omega ca)) '(IN (POS-VARIATION ca nu) (FUN ca RR-POS-STAR))))))
(dk-peel!)
(mac 'POS-VARIATION)
(dk-lam-type!
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-cite! 'pos-variation-set-sub 'ca 'nu a)
      (dk-cite! 'esup-in (mfp-pvset a))
      (dk-ass!)))
  (lambda ()
    (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
    (dk-cite! 'membership-implies-sethood 'ca '(POWER (POWER omega)))
    (dk-ass!)))
(mfp-qed! 'pos-variation-fun)

;; nu(e) <= nu+(a) for measurable e inside a
(sp (make-wff (dk-foralls '(ca nu a e) (dk-curry '((IN nu (FUN ca RR-STAR)) (IN a ca) (IN e ca) (SUBSET e a))
  (list '<= '(nu e) (mfp-pv 'a))))))
(dk-peel!)
(dk-cite! 'pos-variation-in 'ca 'nu 'a)
(mfp-star! (mfp-pv 'a))
(dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR 'e)
(let* ((s (mfp-pvset 'a))
       (upper! (lambda ()                      ; nu(e) in RR-POS-STAR in context
                 (dk-have! (list 'IN '(nu e) s)
                   (lambda ()
                     (in-sep! (lambda () (dk-ass!))
                              (lambda () (ew 'e) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
                 (dk-cite! 'pos-variation-set-sub 'ca 'nu 'a)
                 (dk-cite! 'esup-upper s '(nu e))
                 (dk-cite! 'pos-variation-value 'ca 'nu 'a)
                 (subst (list '== (mfp-pv 'a) (list 'ESUP s)))
                 (dk-ass!)))
       (rps (lambda () (let ((iff (dk-cite! 'rr-pos-star-membership '(nu e))))
                         (dk-have! '(IN (nu e) RR-POS-STAR)
                           (lambda () (mfp-keep-prop! iff '(IN (nu e) RR) '(<= 0 (nu e)) '(= (nu e) POS-INF))))))))
  (mfp-star-cases! '(nu e)
    (lambda (c)
      (case c
        ((pos) (rps) (upper!))
        ((neg) (subst '(= (nu e) NEG-INF)) (dk-cite! 'neg-inf-lower-bound (mfp-pv 'a)) (dk-ass!))
        (else
         (use-em '(<= 0 (nu e))
           (lambda () (rps) (upper!))
           (lambda ()
             (dk-cite! 'rr-not-le-lt 0 '(nu e))
             (fact 'rr-zero-in)
             (dk-have! '(<= (nu e) 0) (lambda () (dk-ineq! '(< (nu e) 0) '(IN (nu e) RR))))
             (dk-cite! 'rr-pos-star-nonneg (mfp-pv 'a))
             (mfp-rstar! 0)
             (mfp-le-trans! '(nu e) 0 (mfp-pv 'a))
             (dk-ass!))))))))
(mfp-qed! 'pos-variation-upper)

;; nu+(a) <= b when every nu(e), e measurable inside a, is <= b
(define mfp-bnd '(FORALL e_ (IMPLIES (IN e_ ca) (IMPLIES (SUBSET e_ a) (<= (nu e_) b)))))
(sp (make-wff (dk-foralls '(ca nu a b) (dk-curry (list '(IN a ca) '(IN b RR-POS-STAR) mfp-bnd) (list '<= (mfp-pv 'a) 'b)))))
(dk-peel!)
(let ((s (mfp-pvset 'a)))
  (dk-cite! 'pos-variation-value 'ca 'nu 'a)
  (subst (list '== (mfp-pv 'a) (list 'ESUP s)))
  (dk-cite! 'pos-variation-set-sub 'ca 'nu 'a)
  (dk-have! (list 'AND '(IN b RR-POS-STAR) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ s) '(<= x_ b))))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((w (dk-di-var!))
                     (ex (dk-sep-parts! (list 'IN w s)))
                     (ev (dk-skolem! ex)))
                (subst (list '= w (list 'nu ev)))
                (dk-apply! mfp-bnd ev)
                (dk-ass!)))))))
  (dk-cite! 'esup-least s 'b)
  (dk-ass!))
(mfp-qed! 'pos-variation-least)

;; ---------------------------------------------------------------------------
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu)) (list '= (mfp-pv 'EMPTY-SET) 0)))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu))))
  (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
  (fact 'rr-zero-in)
  (fact 'zero-in-rr-pos-star)
  (dk-have! '(FORALL e_ (IMPLIES (IN e_ ca) (IMPLIES (SUBSET e_ EMPTY-SET) (<= (nu e_) 0))))
    (lambda ()
      (let ((ev (dk-di-var!)))
        (di)
        (dk-cite! 'membership-implies-sethood ev 'ca)
        (dk-iff-fwd! (dk-cite! 'subset-def ev 'EMPTY-SET))
        (dk-cite! 'subset-of-empty-is-empty ev)
        (subst (list '= ev 'EMPTY-SET))
        (subst '(= (nu EMPTY-SET) 0))
        (dk-ineq!))))
  (dk-cite! 'pos-variation-least 'ca 'nu 'EMPTY-SET 0)
  (dk-cite! 'pos-variation-in 'ca 'nu 'EMPTY-SET)
  (dk-cite! 'rr-pos-star-nonneg (mfp-pv 'EMPTY-SET))
  (dk-have-and! (list 'IN (mfp-pv 'EMPTY-SET) 'RR-POS-STAR) '(IN 0 RR-POS-STAR))
  (dk-have-and! (list '<= (mfp-pv 'EMPTY-SET) 0) (list '<= 0 (mfp-pv 'EMPTY-SET)))
  (dk-cite! 'rr-pos-star-le-antisymm (mfp-pv 'EMPTY-SET) 0)
  (dk-ass!))
(mfp-qed! 'pos-variation-empty)

(sp (make-wff (dk-foralls '(ca nu a b) (dk-curry '((IN nu (FUN ca RR-STAR)) (IN a ca) (IN b ca) (SUBSET a b))
  (list '<= (mfp-pv 'a) (mfp-pv 'b))))))
(dk-peel!)
(dk-cite! 'pos-variation-in 'ca 'nu 'b)
(dk-have! '(FORALL e_ (IMPLIES (IN e_ ca) (IMPLIES (SUBSET e_ a) (<= (nu e_) ((POS-VARIATION ca nu) b)))))
  (lambda ()
    (let ((ev (dk-di-var!)))
      (di)
      (dk-cite! 'subset-trans ev 'a 'b)
      (dk-cite! 'pos-variation-upper 'ca 'nu 'b ev)
      (dk-ass!))))
(dk-cite! 'pos-variation-least 'ca 'nu 'a (mfp-pv 'b))
(dk-ass!)
(mfp-qed! 'pos-variation-mono)

(sp (make-wff (dk-foralls '(ca nu a) (dk-curry '((IN nu (FUN ca RR-STAR)) (IN a ca)) (list '<= '(nu a) (mfp-pv 'a))))))
(dk-peel!)
(dk-cite! 'subset-refl 'a)
(dk-cite! 'pos-variation-upper 'ca 'nu 'a 'a)
(dk-ass!)
(mfp-qed! 'pos-variation-ge)

;; e subset a, f subset b, a n b empty: e n f empty
(sp (make-wff (dk-foralls '(a b e f) (dk-curry '((= (INTERSECTION a b) EMPTY-SET) (SUBSET e a) (SUBSET f b))
  '(= (INTERSECTION e f) EMPTY-SET)))))
(dk-peel!)
(dk-class-ext! '(INTERSECTION e f) 'EMPTY-SET
  (lambda (w)
    (dk-iff-fwd! (dk-cite! 'intersection-membership 'e 'f w))
    (dk-cite! 'subset-mem-fwd 'e 'a w)
    (dk-cite! 'subset-mem-fwd 'f 'b w)
    (dk-have-and! (list 'IN w 'a) (list 'IN w 'b))
    (dk-iff-bwd! (dk-cite! 'intersection-membership 'a 'b w))
    (dk-rewrite-h! (list 'IN w '(INTERSECTION a b)) '(INTERSECTION a b) 'EMPTY-SET)
    (ai (dk-cite! 'empty-set-has-no-members w)))
  (lambda (w)
    (ai (dk-cite! 'empty-set-has-no-members w))))
(dk-ass!)
(mfp-qed! 'disjoint-of-subsets)

(sp (make-wff (dk-foralls '(a b e f) (dk-curry '((SUBSET e a) (SUBSET f b)) '(SUBSET (UNION e f) (UNION a b))))))
(dk-peel!)
(let ((w (subset-by-element!)))
  (mac 'union-membership)
  (dk-or-each! (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w '(UNION e f)))))
    (lambda (d)
      (if (equal? d (list 'IN w 'e))
          (begin (dk-cite! 'subset-mem-fwd 'e 'a w) (oi-l) (dk-ass!))
          (begin (dk-cite! 'subset-mem-fwd 'f 'b w) (oi-r) (dk-ass!))))))
(mfp-qed! 'union-subset-union)

;; ---------------------------------------------------------------------------
;; t in RR and 0 <= t in context: land t in RR-POS-STAR
(define (mfp-rps! t)
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR-POS-STAR)
      (lambda () (mfp-keep-prop! iff (list 'IN t 'RR) (list '<= 0 t))))))

;; superadditivity: nu+(a) + nu+(b) <= nu+(a u b) for disjoint a, b
(define mfp-claimA '(FORALL e_ (FORALL f_ (IMPLIES (IN e_ ca) (IMPLIES (SUBSET e_ a) (IMPLIES (IN f_ ca) (IMPLIES (SUBSET f_ b)
                      (<= (EXT-ADD (nu e_) (nu f_)) ((POS-VARIATION ca nu) (UNION a b))))))))))
(sp (make-wff (dk-foralls '(omega ca nu a b) (dk-curry '((IS-SIGNED-MEASURE omega ca nu) (IN a ca) (IN b ca) (= (INTERSECTION a b) EMPTY-SET))
  (list '<= (list 'eplus (mfp-pv 'a) (mfp-pv 'b)) (mfp-pv '(UNION a b)))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (ab '(UNION a b))
       (c (mfp-pv ab)) (pa (mfp-pv 'a)) (pb (mfp-pv 'b)))
  (dk-cite! 'sigma-algebra-union-closed-2 'omega 'ca 'a 'b)
  (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
  (for-each (lambda (z) (dk-cite! 'pos-variation-in 'ca 'nu z)) (list 'a 'b ab))
  (fact 'rr-zero-in)
  ;; claim A
  (dk-have! mfp-claimA
    (lambda ()
      (dk-peel!)
      (let ((ev 'e_) (fv 'f_))
        (dk-cite! 'disjoint-of-subsets 'a 'b ev fv)
        (dk-cite! 'union-subset-union 'a 'b ev fv)
        (dk-cite! 'sigma-algebra-union-closed-2 'omega 'ca ev fv)
        (dk-cite! 'pos-variation-upper 'ca 'nu ab (list 'UNION ev fv))
        (dk-cite! 'signed-measure-fa 'omega 'ca 'nu ev fv)
        (subst (list '= (list 'EXT-ADD (list 'nu ev) (list 'nu fv)) (list 'nu (list 'UNION ev fv))))
        (dk-ass!))))
  (let ((iff (dk-cite! 'rr-pos-star-membership c)))
    (dk-iff-fwd! iff)
    (dk-or-each! (dk-ctx-form (caddr iff))
      (lambda (d)
        (if (equal? d (list '= c 'POS-INF))
            (begin
              (dk-have-and! (list 'IN pa 'RR-POS-STAR) (list 'IN pb 'RR-POS-STAR))
              (dk-cite! 'eplus-closed pa pb)
              (subst (list '= c 'POS-INF))
              (dk-cite! 'rr-pos-star-below-pos-inf (list 'eplus pa pb))
              (dk-ass!))
            (begin
              (dk-split-all! (list d))
              (dk-cite! 'subset-refl 'a)
              (dk-cite! 'union-right-subset 'a 'b)
              (dk-cite! 'subset-refl 'b)
              (dk-cite! 'empty-subset-any 'a)
              (dk-cite! 'empty-subset-any 'b)
              (dk-have! (list 'SUBSET 'a ab)
                (lambda () (let ((w (subset-by-element!))) (mac 'union-membership) (oi-l) (dk-ass!))))
              (dk-cite! 'pos-variation-mono 'ca 'nu 'a ab)
              (dk-cite! 'pos-variation-mono 'ca 'nu 'b ab)
              (for-each (lambda (z)
                          (dk-have-and! (list 'IN z 'RR-POS-STAR) (list 'IN c 'RR))
                          (dk-cite! 'rr-pos-star-le-real-in-rr z c)
                          (dk-cite! 'rr-pos-star-nonneg z))
                        (list pa pb))
              ;; claim B: nu(f) <= c - pa for measurable f inside b
              (let ((cpa (list '- c pa)))
                (dk-type! cpa 'RR)
                (dk-have! (list 'FORALL 'f_ (dk-curry (list '(IN f_ ca) '(SUBSET f_ b)) (list '<= '(nu f_) cpa)))
                  (lambda ()
                    (let ((fv (dk-di-var!)))
                      (di)
                      (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR fv)
                      (let ((nf (list 'nu fv)))
                        ;; nu(f) <= c, from claim A at the empty set
                        (dk-apply! mfp-claimA 'EMPTY-SET fv)
                        (dk-rewrite-h! (list '<= (list 'EXT-ADD '(nu EMPTY-SET) nf) c) '(nu EMPTY-SET) 0)
                        (dk-cite! 'ext-add-zero-left nf)
                        (dk-rewrite-h! (list '<= (list 'EXT-ADD 0 nf) c) (list 'EXT-ADD 0 nf) nf)
                        (mfp-star-cases! nf
                          (lambda (k)
                            (case k
                              ((neg) (subst (list '= nf 'NEG-INF)) (dk-type! cpa 'RR) (mfp-rstar! cpa)
                                     (dk-cite! 'neg-inf-lower-bound cpa) (dk-ass!))
                              ((pos) (dk-rewrite-h! (list '<= nf c) nf 'POS-INF)
                                     (ai (dk-cite! 'pos-inf-above-reals c)))
                              (else
                               (let ((cnf (list '- c nf)))
                                 (dk-type! cnf 'RR)
                                 (dk-have! (list '<= 0 cnf) (lambda () (dk-ineq! (list '<= nf c) (list 'IN nf 'RR) (list 'IN c 'RR))))
                                 (mfp-rps! cnf)
                                 (dk-have! (list 'FORALL 'e_ (dk-curry (list '(IN e_ ca) '(SUBSET e_ a)) (list '<= '(nu e_) cnf)))
                                   (lambda ()
                                     (let ((ev (dk-di-var!)))
                                       (di)
                                       (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR ev)
                                       (let ((ne (list 'nu ev)))
                                         (dk-apply! mfp-claimA ev fv)
                                         (mfp-star-cases! ne
                                           (lambda (k2)
                                             (case k2
                                               ((neg) (subst (list '= ne 'NEG-INF)) (mfp-rstar! cnf)
                                                      (dk-cite! 'neg-inf-lower-bound cnf) (dk-ass!))
                                               ((pos) (dk-rewrite-h! (list '<= (list 'EXT-ADD ne nf) c) ne 'POS-INF)
                                                      (dk-cite! 'ext-add-pos-inf-left nf)
                                                      (dk-rewrite-h! (list '<= (list 'EXT-ADD 'POS-INF nf) c) (list 'EXT-ADD 'POS-INF nf) 'POS-INF)
                                                      (ai (dk-cite! 'pos-inf-above-reals c)))
                                               (else
                                                (dk-cite! 'ext-add-real ne nf)
                                                (dk-rewrite-h! (list '<= (list 'EXT-ADD ne nf) c) (list 'EXT-ADD ne nf) (list '+ ne nf))
                                                (dk-ineq! (list '<= (list '+ ne nf) c) (list 'IN ne 'RR) (list 'IN nf 'RR) (list 'IN c 'RR))))))))))
                                 (dk-cite! 'pos-variation-least 'ca 'nu 'a cnf)
                                 (dk-ineq! (list '<= pa cnf) (list 'IN nf 'RR) (list 'IN c 'RR) (list 'IN pa 'RR)))))))))))
                (dk-have! (list '<= 0 cpa) (lambda () (dk-ineq! (list '<= pa c) (list 'IN pa 'RR) (list 'IN c 'RR))))
                (mfp-rps! cpa)
                (dk-cite! 'pos-variation-least 'ca 'nu 'b cpa)
                (dk-cite! 'eplus-real-defined pa pb)
                (subst (list '= (list 'eplus pa pb) (list 'binplus pa pb)))
                (dk-have-and! (list 'IN pa 'RR) (list 'IN pb 'RR))
                (dk-cite! 'rr-add-closed pa pb)
                (subst (dk-cite! 'binplus-apply pa pb))
                (dk-ineq! (list '<= pb cpa) (list 'IN pa 'RR) (list 'IN pb 'RR) (list 'IN c 'RR)))))))))
(mfp-qed! 'pos-variation-superadditive)

  

