;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/signed-measure-laws.scm (after mf-pv).  Library: measure.
;;; Helper prefix: mfq-.  Load window: after mf-pv.scm, measure-laws.scm (rps-prefix-*, esum-nn-*), bu-seg-succ.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

;; keep the named formulas and run prop -- only on the leaf the keep was written for (when keep
;; finds that sequent already proven it closes the leaf and the focus moves; prop must not follow it)
(define (mfq-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (mfq-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFQ OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define (mfq-star-cases! t k)
  (let ((iff (dk-cite! 'rr-star-membership t)))
    (dk-have! (caddr iff) (lambda () (mfq-keep-prop! iff (list 'IN t 'RR-STAR))))
    (dk-or-each! (dk-ctx-form (caddr iff))
      (lambda (d)
        (cond ((equal? d (list 'IN t 'RR)) (k 'real))
              ((equal? d (list '= t 'POS-INF)) (k 'pos))
              (#t (k 'neg)))))))
(define (mfq-rstar! t) (fact 'rr-subset-rr-star) (dk-cite! 'subset-mem-fwd 'RR 'RR-STAR t))
(define (mfq-pstar! t) (fact 'rr-pos-star-subset-rr-star) (dk-cite! 'subset-mem-fwd 'RR-POS-STAR 'RR-STAR t))
;; (<= a c) with c real: NOT(a = +inf)
(define (mfq-not-pinf! a c)
  (dk-have! (list 'NOT (list '= a 'POS-INF))
    (lambda ()
      (di)
      (dk-rewrite-h! (list '<= a c) a 'POS-INF)
      (ai (dk-cite! 'pos-inf-above-reals c)))))
(define (mfq-pv a) (list '(POS-VARIATION ca nu) a))

;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL f (IMPLIES (IN f (FUN NN RR-POS-STAR)) (IN (ESUM f) RR-POS-STAR)))))
(dk-peel!)
(fact 'nn-is-set)
(dk-project! '(IN f (FUN NN)) 'fun-codomain-iff '(IN f (FUN NN RR-POS-STAR)))
(dk-have! '(AND (IN f (FUN NN)) (IN NN SET)) (lambda () (dk-conj-close! dk-ass!)))
(dk-split-all! (list (dk-cite! 'dom-of-fun 'NN 'f)))
(dk-have! '(IN f (FUN (DOM f) RR-POS-STAR)) (lambda () (subst '(= (DOM f) NN)) (dk-ass!)))
(dk-cite! 'esum-in 'f)
(dk-ass!)
(mfq-qed! 'esum-nn-type)

(sp (make-wff '(FORALL a (FORALL b (SUBSET (INTERSECTION a b) b)))))
(dk-peel!)
(let ((w (subset-by-element!)))
  (dk-iff-fwd! (dk-cite! 'intersection-membership 'a 'b w))
  (dk-ass!))
(mfq-qed! 'inter-sub-right)

(sp (make-wff '(FORALL a (FORALL b (SUBSET (INTERSECTION a b) a)))))
(dk-peel!)
(let ((w (subset-by-element!)))
  (dk-iff-fwd! (dk-cite! 'intersection-membership 'a 'b w))
  (dk-ass!))
(mfq-qed! 'inter-sub-left)

;; EXT-ADD(a, b) <= eplus(c, d) for a <= c, b <= d, c, d in [0, +inf]
(sp (make-wff (dk-foralls '(a b c d) (dk-curry '((IN a RR-STAR) (IN b RR-STAR) (IN c RR-POS-STAR) (IN d RR-POS-STAR) (<= a c) (<= b d))
  '(<= (EXT-ADD a b) (eplus c d))))))
(dk-peel!)
(dk-cite! 'ext-add-in 'a 'b)
(dk-have-and! '(IN c RR-POS-STAR) '(IN d RR-POS-STAR))
(dk-cite! 'eplus-closed 'c 'd)
(mfq-pstar! '(eplus c d))
(let ((top! (lambda (eq)                 ; eplus(c, d) = +inf
              (subst eq)
              (dk-cite! 'pos-inf-upper-bound '(EXT-ADD a b))
              (dk-ass!)))
      (ic (dk-cite! 'rr-pos-star-membership 'c))
      (id (dk-cite! 'rr-pos-star-membership 'd)))
  (dk-iff-fwd! ic) (dk-iff-fwd! id)
  (dk-or-each! (dk-ctx-form (caddr ic))
    (lambda (dc)
      (if (equal? dc '(= c POS-INF))
          (begin (subst '(= c POS-INF)) (top! (dk-cite! 'eplus-pos-inf-left 'd)))
          (begin
            (dk-split-all! (list dc))
            (dk-or-each! (dk-ctx-form (caddr id))
              (lambda (dd)
                (if (equal? dd '(= d POS-INF))
                    (begin (subst '(= d POS-INF)) (top! (dk-cite! 'eplus-pos-inf-right 'c)))
                    (begin
                      (dk-split-all! (list dd))
                      (mfq-not-pinf! 'a 'c) (mfq-not-pinf! 'b 'd)
                      (subst (dk-cite! 'eplus-real-defined 'c 'd))
                      (subst (dk-cite! 'binplus-apply 'c 'd))
                      (dk-have-and! '(IN c RR) '(IN d RR))
                      (dk-cite! 'rr-add-closed 'c 'd)
                      (mfq-rstar! '(+ c d))
                      (mfq-star-cases! 'a
                        (lambda (ka)
                          (case ka
                            ((neg) (subst '(= a NEG-INF)) (subst (dk-cite! 'ext-add-neg-inf-left 'b))
                                   (dk-cite! 'neg-inf-lower-bound '(+ c d)) (dk-ass!))
                            ((pos) (ai '(NOT (= a POS-INF))))
                            (else
                             (mfq-star-cases! 'b
                               (lambda (kb)
                                 (case kb
                                   ((neg) (subst '(= b NEG-INF)) (subst (dk-cite! 'ext-add-neg-inf-right 'a))
                                          (dk-cite! 'neg-inf-lower-bound '(+ c d)) (dk-ass!))
                                   ((pos) (ai '(NOT (= b POS-INF))))
                                   (else
                                    (subst (dk-cite! 'ext-add-real 'a 'b))
                                    (dk-ineq! '(<= a c) '(<= b d) '(IN a RR) '(IN b RR) '(IN c RR) '(IN d RR)))))))))))))))))))
