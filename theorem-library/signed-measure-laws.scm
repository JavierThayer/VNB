;;; mf-fin3.scm -- Prop 3.12, finiteness: a signed measure never +inf has a finite positive variation.
;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/signed-measure-laws.scm (after mf-fin2).  Library: measure.
;;; Helper prefix: mfi-.  Load window: after mf-fin2.scm, dc-on-nn-pred (rake-dc-on-nn.scm).
;;; The notes' construction: sets A_n of infinite positive variation, each removing a piece E_n with
;;; |nu(E_n)| >= n; either the removed pieces are infinitely often large (a disjoint family whose
;;; union would have measure +inf) or from some m on the kept pieces are the large ones (a decreasing
;;; family whose first member would have measure -inf).  Here the sequence is built by dc-on-nn-pred.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

;; keep the named formulas and run prop -- only on the leaf the keep was written for (when keep
;; finds that sequent already proven it closes the leaf and the focus moves; prop must not follow it)
(define (mfi-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;; the first IF subterm, outermost first
(define (mfi-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfi-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfi-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFI OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfi-rstar! t) (fact 'rr-subset-rr-star) (dk-cite! 'subset-mem-fwd 'RR 'RR-STAR t))
(define (mfi-le-trans! a b c)
  (dk-have-and! (list 'IN a 'RR-STAR) (list 'IN b 'RR-STAR) (list 'IN c 'RR-STAR))
  (dk-have-and! (list '<= a b) (list '<= b c))
  (dk-cite! 'rr-star-leq-transitive a b c))
(define (mfi-pv a) (list '(POS-VARIATION ca nu) a))
(define (mfi-pvset a)
  (list 'SEP 'pvv_ 'RR-POS-STAR
        (list 'FORSOME 'pve_ (list 'AND '(IN pve_ ca) (list 'AND (list 'SUBSET 'pve_ a) '(= (nu pve_) pvv_))))))
(define mfi-nopinf '(FORALL a_ (IMPLIES (IN a_ ca) (NOT (= (nu a_) POS-INF)))))
(define mfi-S0 '(SEP su_ ca (= ((POS-VARIATION ca nu) su_) POS-INF)))
(define (mfi-cond k u y) (list 'OR (list '<= (list '+ k 1) (list 'nu y)) (list '<= (list '+ k 1) (list 'nu (list 'COMPLEMENT-IN u y)))))
(define mfi-NXT (list 'VNB-LAMBDA '(LIST kk_ uu_) (list 'CARTESIAN 'NN mfi-S0)
                      (list 'SEP 'yy_ mfi-S0 (list 'AND '(SUBSET yy_ uu_) (mfi-cond 'kk_ 'uu_ 'yy_)))))

;; x in [0, +inf], x not +inf: x real
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR) (IMPLIES (NOT (= x POS-INF)) (IN x RR))))))
(dk-peel!)
(let ((iff (dk-cite! 'rr-pos-star-membership 'x)))
  (dk-iff-fwd! iff)
  (dk-or-each! (dk-ctx-form (caddr iff))
    (lambda (d) (if (dk-head-is? d 'AND) (begin (dk-split! d) (dk-ass!)) (ai '(NOT (= x POS-INF)))))))
(mfi-qed! 'rps-real-of-not-pos-inf)

;; one step of the construction: from u of infinite positive variation, a piece y of infinite positive
;; variation inside u with nu(y) >= k+1 or nu(u \ y) >= k+1
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu))
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u mfi-S0)
    (list 'FORSOME 'y (list 'AND (list 'IN 'y mfi-S0) (list 'AND '(SUBSET y u) (mfi-cond 'k 'u 'y))))))))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (mpv (dk-cite! 'pos-variation-is-measure 'omega 'ca 'nu))
       (k1 '(+ k 1)))
  (dk-sep-parts! (list 'IN 'u mfi-S0))
  (dk-cite! 'nn-in-rr 'k) (fact 'rr-one-in)
  (dk-have-and! '(IN k RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed 'k 1)
  (dk-cite! 'nn-zero-le 'k)
  (dk-have! (list '<= 0 k1) (lambda () (dk-ineq! '(<= 0 k) '(IN k RR))))
  (let ((iff (dk-cite! 'rr-pos-star-membership k1)))
    (dk-have! (list 'IN k1 'RR-POS-STAR) (lambda () (mfi-keep-prop! iff (list 'IN k1 'RR) (list '<= 0 k1)))))
  (dk-cite! 'rr-lt-pos-inf k1)
  (dk-cite! 'pos-variation-value 'ca 'nu 'u)
  (dk-rewrite-h! (list '< k1 'POS-INF) 'POS-INF (mfi-pv 'u))
  (dk-rewrite-h! (list '< k1 (mfi-pv 'u)) (mfi-pv 'u) (list 'ESUP (mfi-pvset 'u)))
  (dk-cite! 'pos-variation-set-sub 'ca 'nu 'u)
  (let* ((w (dk-skolem! (dk-cite! 'esup-lt-witness (mfi-pvset 'u) k1)))
         (e (dk-skolem! (dk-sep-parts! (list 'IN w (mfi-pvset 'u))))))
    ;; k + 1 <= nu(e)
    (dk-iff-fwd! (dk-cite! '< k1 w))
    (dk-rewrite-h! (list '<= k1 w) w (list 'nu e))
    (let ((ue (list 'COMPLEMENT-IN 'u e)))
      (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca 'u e)
      (dk-cite! 'intersection-complement-in-empty e 'u)
      (dk-cite! 'union-complement-in e 'u)
      (dk-cite! 'measure-finitely-additive 'omega 'ca '(POS-VARIATION ca nu) e ue)
      (dk-rewrite-h! (list '= (list (car (mfi-pv e)) (list 'UNION e ue)) (list 'eplus (mfi-pv e) (mfi-pv ue))) (list 'UNION e ue) 'u)
      (dk-cite! 'pos-variation-in 'ca 'nu e) (dk-cite! 'pos-variation-in 'ca 'nu ue)
      (use-em (list '= (mfi-pv e) 'POS-INF)
        (lambda ()
          (ew e)
          (dk-conj-close!
            (lambda ()
              (let ((gl (dk-goal)))
                (cond ((dk-ass!) #t)
                      ((dk-head-is? gl 'OR) (oi-l) (dk-ass!))
                      (#t (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))))
        (lambda ()
          (dk-cite! 'rps-real-of-not-pos-inf (mfi-pv e))
          (use-em (list 'IN (mfi-pv ue) 'RR)
            (lambda ()
              (dk-cite! 'rr-pos-star-nonneg (mfi-pv e)) (dk-cite! 'rr-pos-star-nonneg (mfi-pv ue))
              (dk-cite! 'eplus-real-defined (mfi-pv e) (mfi-pv ue))
              (dk-cite! 'binplus-apply (mfi-pv e) (mfi-pv ue))
              (dk-have-and! (list 'IN (mfi-pv e) 'RR) (list 'IN (mfi-pv ue) 'RR))
              (dk-cite! 'rr-add-closed (mfi-pv e) (mfi-pv ue))
              (dk-have! (list 'IN (mfi-pv 'u) 'RR)
                (lambda ()
                  (subst (list '= (mfi-pv 'u) (list 'eplus (mfi-pv e) (mfi-pv ue))))
                  (subst (list '= (list 'eplus (mfi-pv e) (mfi-pv ue)) (list 'binplus (mfi-pv e) (mfi-pv ue))))
                  (subst (list '== (list 'binplus (mfi-pv e) (mfi-pv ue)) (list '+ (mfi-pv e) (mfi-pv ue))))
                  (dk-ass!)))
              (dk-rewrite-h! (list 'IN (mfi-pv 'u) 'RR) (mfi-pv 'u) 'POS-INF)
              (ai (dk-cite! 'pos-inf-not-in-rr)))
            (lambda ()
              (dk-have! (list '= (mfi-pv ue) 'POS-INF)
                (lambda () (let ((iff (dk-cite! 'rr-pos-star-membership (mfi-pv ue))))
                             (mfi-keep-prop! iff (list 'IN (mfi-pv ue) 'RR-POS-STAR) (list 'NOT (list 'IN (mfi-pv ue) 'RR))))))
              (dk-cite! 'complement-in-double 'u e)
              (dk-cite! 'complement-in-subset e 'u)
              (ew ue)
              (dk-conj-close!
                (lambda ()
                  (let ((gl (dk-goal)))
                    (cond ((dk-ass!) #t)
                          ((dk-head-is? gl 'OR) (oi-r) (subst (list '= (list 'COMPLEMENT-IN 'u ue) e)) (dk-ass!))
                          (#t (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))))))))))
(mfi-qed! 'pos-variation-step)

;; ---------------------------------------------------------------------------
;; the sequence, by dependent choice
(define (mfi-step f) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN)
  (dk-and (list (list '= (mfi-pv (list f 'k_)) 'POS-INF) (list 'SUBSET (list f '(succ k_)) (list f 'k_))
                (mfi-cond 'k_ (list f 'k_) (list f '(succ k_))))))))
(sp (make-wff (dk-foralls '(omega ca nu a0) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) '(IN a0 ca) (list '= (mfi-pv 'a0) 'POS-INF))
  (list 'FORSOME 'f_ (dk-and (list '(IN f_ (FUN NN ca)) '(= (f_ 0) a0) (mfi-step 'f_))))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (S0 mfi-S0) (NXT mfi-NXT))
  (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
  (dk-have! (list 'IN S0 'SET) (lambda () (dk-sethood! S0)))
  (dk-have! (list 'IN 'a0 S0) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have! (list 'SUBSET S0 'ca) (lambda () (let ((w (subset-by-element!))) (dk-sep-parts! (list 'IN w S0)) (dk-ass!))))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u S0)
              (list 'FORSOME 'y (list 'AND (list 'IN 'y S0) (list 'IN 'y (list NXT 'k 'u))))))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (k (cadr (find-first (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN))) ld)))
             (u (cadr (find-first (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) S0))) ld)))
             (y (dk-skolem! (dk-cite! 'pos-variation-step 'omega 'ca 'nu k u))))
        (ew y)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (dk-lam-b!)
                  (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!)))))))
        )))
  (let* ((f (dk-skolem! (dk-cite! 'dc-on-nn-pred S0 'a0 NXT))))
    (dk-cite! 'fun-codomain-superset f 'NN S0 'ca)
    (ew f)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let ((k (dk-di-var!)))
              (dk-cite! 'nn-succ-closed k)
              (dk-cite! 'fun-apply-type-c f 'NN S0 k)
              (dk-sep-parts! (list 'IN (list f k) S0))
              (let ((m (dk-apply! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list f '(succ k)) (list NXT 'k (list f 'k))))) k)))
                (dk-lam-b-h! m)
                (let ((sepm (dk-pick (lambda (z) (and (dk-head-is? z 'IN) (equal? (cadr z) (list f (list 'succ k)))
                                                      (dk-head-is? (caddr z) 'SEP) (dk-contains? (caddr z) 'yy_)))
                                     "the membership in the next-step set")))
                  (dk-split-all! (list (dk-sep-parts! sepm)))
                  (dk-conj-close! dk-ass!)))))))))
(mfi-qed! 'pos-variation-chain)

;; ---------------------------------------------------------------------------
;; Prop 3.12 (finiteness), the case without +inf: nu+ takes only finite values
(define (mfi-disj g) (list 'FORALL 'smi_ (list 'FORALL 'smj_ (dk-curry '((IN smi_ NN) (IN smj_ NN) (NOT (= smi_ smj_)))
                       (list '= (list 'INTERSECTION (list g 'smi_) (list g 'smj_)) 'EMPTY-SET)))))
(define (mfi-ptw-claim body-of) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (body-of 'k_))))
(define (mfi-typ! z) (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR z))

(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) mfi-nopinf)
  (list 'FORALL 'a0 (list 'IMPLIES '(IN a0 ca) (list 'IN (mfi-pv 'a0) 'RR)))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (sig (car parts)))
  (dk-cite! 'pos-variation-in 'ca 'nu 'a0)
  (use-em (list 'IN (mfi-pv 'a0) 'RR)
    (lambda () (dk-ass!))
    (lambda ()
      (dk-have! (list '= (mfi-pv 'a0) 'POS-INF)
        (lambda () (let ((iff (dk-cite! 'rr-pos-star-membership (mfi-pv 'a0))))
                     (mfi-keep-prop! iff (list 'IN (mfi-pv 'a0) 'RR-POS-STAR) (list 'NOT (list 'IN (mfi-pv 'a0) 'RR))))))
      (let* ((f (dk-skolem! (dk-cite! 'pos-variation-chain 'omega 'ca 'nu 'a0)))
             (stp (mfi-step f))
             (step! (lambda (k) (dk-split-all! (list (dk-apply! stp k)))))
             (Q (lambda (m) (list 'FORALL 'k_ (dk-curry (list '(IN k_ NN) (list '<= m 'k_))
                                                        (list '<= '(+ k_ 1) (list 'nu (list f '(succ k_))))))))
             (P (list 'FORSOME 'm_ (list 'AND '(IN m_ NN) (Q 'm_)))))
        (fact 'nn-zero-in) (fact 'rr-one-in)
        (use-em P
          (lambda ()
            (let* ((m (dk-skolem! (dk-ctx-form P)))
                   (qm (Q m))
                   (sm (list 'succ m))
                   (B (list 'VNB-LAMBDA 'bj_ 'NN (list f (list '+ sm 'bj_))))
                   (idx! (lambda (k)         ; (succ m) + k in NN and the f value in ca
                           (dk-cite! 'nn-succ-closed m)
                           (dk-have-and! (list 'IN sm 'NN) (list 'IN k 'NN))
                           (dk-cite! 'nn-add-closed sm k)
                           (dk-cite! 'fun-apply-type-c f 'NN 'ca (list '+ sm k))))
                   (decb (mfi-ptw-claim (lambda (k) (list 'SUBSET (list B (list 'succ k)) (list B k)))))
                   (geb (mfi-ptw-claim (lambda (k) (list '<= k (list 'nu (list B k)))))))
              (dk-have! (list 'IN B '(FUN NN ca))
                (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (idx! k) (dk-ass!))))))
              (dk-have! decb
                (lambda ()
                  (let* ((k (dk-di-var!)) (mk (list '+ sm k)))
                    (dk-cite! 'nn-succ-closed k)
                    (dk-lam-b!)
                    (idx! k)
                    (dk-cite! 'nn-succ-closed mk)
                    (dk-have! (list '= (list '+ sm (list 'succ k)) (list 'succ mk)) (lambda () (dk-nn!)))
                    (subst (list '= (list '+ sm (list 'succ k)) (list 'succ mk)))
                    (step! mk)
                    (dk-ass!))))
              (dk-have! geb
                (lambda ()
                  (let* ((k (dk-di-var!)) (mk (list '+ m k)))
                    (dk-lam-b!)
                    (idx! k)
                    (dk-have-and! (list 'IN m 'NN) (list 'IN k 'NN))
                    (dk-cite! 'nn-add-closed m k)
                    (dk-cite! 'nn-le-add-right k m)
                    (dk-apply! qm mk)
                    (dk-cite! 'nn-succ-closed mk)
                    (dk-have! (list '= (list 'succ mk) (list '+ sm k)) (lambda () (dk-nn!)))
                    (dk-rewrite-h! (list '<= (list '+ mk 1) (list 'nu (list f (list 'succ mk)))) (list 'succ mk) (list '+ sm k))
                    (mfi-typ! (list f (list '+ sm k)))
                    (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr mk)
                    (dk-have-and! (list 'IN mk 'RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed mk 1)
                    (dk-have! (list '<= k (list '+ mk 1)) (lambda () (dk-nn!)))
                    (mfi-rstar! k) (mfi-rstar! (list '+ mk 1))
                    (mfi-le-trans! k (list '+ mk 1) (list 'nu (list f (list '+ sm k))))
                    (dk-ass!))))
              (dk-cite! 'signed-decreasing-neg-inf 'omega 'ca 'nu B)
              (let ((g0 (dk-apply! geb 0)))
                (dk-rewrite-h! g0 (list 'nu (list B 0)) 'NEG-INF)
                (fact 'rr-zero-in)
                (ai (dk-cite! 'neg-inf-below-reals 0)))))
          (lambda ()
            (let* ((dec (mfi-ptw-claim (lambda (k) (list 'SUBSET (list f (list 'succ k)) (list f k))))))
              (dk-have! dec (lambda () (let ((k (dk-di-var!))) (step! k) (dk-ass!))))
              (let* ((c (dk-skolem! (dk-cite! 'diff-family-exists 'omega 'ca f)))
                     (dval (lambda (k) (dk-apply! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN)
                                          (list '= (list c 'k_) (list 'COMPLEMENT-IN (list f 'k_) (list f '(succ k_)))))) k)))
                     (G (list 'VNB-LAMBDA 'gk_ 'NN (list 'IF (list '<= '(+ gk_ 1) (list 'nu (list c 'gk_))) (list c 'gk_) 'EMPTY-SET)))
                     (gsub (mfi-ptw-claim (lambda (k) (list 'SUBSET (list G k) (list c k)))))
                     (cty! (lambda (k) (dk-cite! 'fun-apply-type-c c 'NN 'ca k))))
                (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
                (dk-have! (list 'IN G '(FUN NN ca))
                  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (cty! k)
                                                         (dk-case-if! (mfi-find-if (dk-goal)) (lambda (t v) (dk-ass!))))))))
                (dk-have! gsub
                  (lambda () (let ((k (dk-di-var!)))
                               (dk-lam-b!)
                               (dk-case-if! (mfi-find-if (dk-goal))
                                 (lambda (t v) (if t (dk-cite! 'subset-refl (list c k)) (dk-cite! 'empty-subset-any (list c k)))
                                               (dk-ass!))))))
                (dk-have! (mfi-disj G)
                  (lambda () (let* ((ld (dk-peel!))
                                    (vs (map cadr (filter (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN))) ld)))
                                    (gl (dk-goal))
                                    (iv (cadr (cadr (cadr gl)))) (jv (cadr (caddr (cadr gl)))))
                               (dk-apply! gsub iv) (dk-apply! gsub jv)
                               (dk-apply! (mfi-disj c) iv jv)
                               (dk-cite! 'disjoint-of-subsets (list c iv) (list c jv) (list G iv) (list G jv))
                               (dk-ass!))))
                (dk-have! (mfi-ptw-claim (lambda (k) (list '<= 0 (list 'nu (list G k)))))
                  (lambda () (let ((k (dk-di-var!)))
                               (dk-lam-b!)
                               (cty! k) (mfi-typ! (list c k))
                               (dk-case-if! (mfi-find-if (dk-goal))
                                 (lambda (t v)
                                   (if t
                                       (begin (dk-cite! 'nn-in-rr k)
                                              (dk-have-and! (list 'IN k 'RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed k 1)
                                              (dk-cite! 'nn-zero-le k)
                                              (dk-have! (list '<= 0 (list '+ k 1)) (lambda () (dk-ineq! (list '<= 0 k) (list 'IN k 'RR))))
                                              (fact 'rr-zero-in) (mfi-rstar! 0) (mfi-rstar! (list '+ k 1))
                                              (mfi-le-trans! 0 (list '+ k 1) (list 'nu (list c k)))
                                              (dk-ass!))
                                       (begin (subst '(= (nu EMPTY-SET) 0)) (fact 'rr-zero-in) (dk-ineq!))))))))
                (dk-have! (list 'FORALL 'cb_ (list 'IMPLIES '(IN cb_ RR) (list 'FORSOME 'k_ (list 'AND '(IN k_ NN) (list '<= 'cb_ (list 'nu (list G 'k_)))))))
                  (lambda ()
                    (let* ((cb (dk-di-var!))
                           (nn (dk-skolem! (dk-cite! 'nn-above-real cb)))
                           (W (list 'FORSOME 'k_ (dk-and (list '(IN k_ NN) (list '<= nn 'k_)
                                                              (list 'NOT (list '<= '(+ k_ 1) (list 'nu (list f '(succ k_))))))))))
                      (use-em W
                        (lambda ()
                          (let* ((k (dk-skolem! (dk-ctx-form W)))
                                 (orf (begin (step! k) (dk-ctx-form (mfi-cond k (list f k) (list f (list 'succ k)))))))
                            (dk-cite! 'nn-succ-closed k)
                            (dval k)
                            (dk-have! (list '<= (list '+ k 1) (list 'nu (list c k)))
                              (lambda ()
                                (subst (list '= (list c k) (list 'COMPLEMENT-IN (list f k) (list f (list 'succ k)))))
                                (dk-or-each! orf
                                  (lambda (d) (if (dk-contains? d 'COMPLEMENT-IN) (dk-ass!) (ai (list 'NOT d)))))))
                            (ew k)
                            (dk-conj-close!
                              (lambda ()
                                (if (not (dk-ass!))
                                    (begin
                                      (dk-lam-b!)
                                      (dk-if-branch! #t (mfi-find-if (dk-goal)) #f
                                        (lambda ()
                                          (cty! k) (mfi-typ! (list c k))
                                          (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr nn)
                                          (dk-have-and! (list 'IN k 'RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed k 1)
                                          (dk-have! (list '<= cb (list '+ k 1))
                                            (lambda () (dk-ineq! (list '<= cb nn) (list '<= nn k) (list 'IN k 'RR) (list 'IN nn 'RR) (list 'IN cb 'RR))))
                                          (mfi-rstar! cb) (mfi-rstar! (list '+ k 1))
                                          (mfi-le-trans! cb (list '+ k 1) (list 'nu (list c k)))
                                          (dk-ass!)))))))))
                        (lambda ()
                          (dk-have! P
                            (lambda ()
                              (ew nn)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-ass!))
                                      (let* ((ld (dk-peel!))
                                             (k (cadr (find-first (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN))) ld))))
                                        (use-em (list '<= (list '+ k 1) (list 'nu (list f (list 'succ k))))
                                          (lambda () (dk-ass!))
                                          (lambda ()
                                            (dk-have! W (lambda () (ew k) (dk-conj-close! dk-ass!)))
                                            (ai (list 'NOT W))))))))))
                          (ai (list 'NOT P)))))))
                (dk-cite! 'signed-union-unbounded 'omega 'ca 'nu G)
                (dk-cite! 'sigma-algebra-union-closed 'omega 'ca G)
                (dk-apply! mfi-nopinf (list 'BIG-UNION 'smn_ 'NN (list G 'smn_)))
                (ai (list 'NOT (list '= (list 'nu (list 'BIG-UNION 'smn_ 'NN (list G 'smn_))) 'POS-INF)))))))))))
(mfi-qed! 'pos-variation-finite)

  
