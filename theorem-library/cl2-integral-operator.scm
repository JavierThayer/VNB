;;; kc-b.scm -- THE COMPLEX KERNEL OPERATOR ON CL2-HILBERT: its value on classes, its type,
;;; additivity and complex homogeneity (TH3-L2C, 2026-11-10).  Helper prefix: kcb-.
;;;
;;; T = CL2-INT-OP(xs, cA, mu, ys, cB, nu, k1, k2), the operator of K = k1 + i k2.
;;;   * cl2-hilbert-vadd-classes, cl2-hilbert-act-classes: the sum and the complex action of
;;;     CL2-HILBERT on pairs of classes [f1, f2];
;;;   * cl2-int-op-classes: T [f1, f2] = [K1 f1 - K2 f2, K1 f2 + K2 f1] for ANY representatives
;;;     f1, f2 (the definition reads the CHOICE of each class);
;;;   * cl2-int-op-fun: T maps CL2-HILBERT(ys) into CL2-HILBERT(xs);
;;;   * cl2-int-op-add, cl2-int-op-act: T is additive and complex homogeneous.
;;; Each statement is reduced to the real kernels by kernel-apply-linear-ae / -ae-eq (kc-a)
;;; and to classes by cl2-class-eq-iff-ae (TH3-L2's l2c-a).
;;;
;;; LOAD WINDOW: after kc-a and TH3-L2's l2c-a (CL2-HILBERT laws).  Library: measure.

(define (kcb-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** kc-b: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "kc-b: unfinished" name))))

(define (kcb-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (kcb-open?) (not (proof-done? *ps*)))
(define (kcb-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (kcb-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (kcb-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))
(define (kcb-ptwise var dom body) (list 'FORALL var (list 'IMPLIES (list 'IN var dom) body)))
(define (kcb-off var dom nset body) (kcb-ptwise var dom (list 'IMPLIES (list 'NOT (list 'IN var nset)) body)))
(define (kcb-sk-off! fs)
  (let* ((e (dk-skolem! fs))
         (find (lambda () (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q e))) (dk-asms)))))
    (if (not (find))
        (let ((c (find-first (lambda (q) (and (dk-head-is? q 'AND) (dk-contains? q e))) (dk-asms))))
          (if c (dk-split! c))))
    (if (not (find)) (error "kcb-sk-off!: no off-clause for" e))
    (cons e (find))))
(define (kcb-not-in-union! x u)
  (if (and (pair? u) (eq? (car u) 'UNION))
      (let ((um (dk-cite! 'union-membership (cadr u) (caddr u) x)))
        (dk-have! (list 'NOT (list 'IN x (cadr u))) (lambda () (keep um (list 'NOT (list 'IN x u))) (prop)))
        (dk-have! (list 'NOT (list 'IN x (caddr u))) (lambda () (keep um (list 'NOT (list 'IN x u))) (prop)))
        (kcb-not-in-union! x (cadr u))
        (kcb-not-in-union! x (caddr u)))))
(define (kcb-union-null! om ca m es)
  (cond ((null? es) (fact 'ae-null-empty om ca m) 'EMPTY-SET)
        ((null? (cdr es)) (car es))
        (#t (let ((rest (kcb-union-null! om ca m (cdr es))))
              (fact 'ae-null-union om ca m (car es) rest)
              (list 'UNION (car es) rest)))))

;;; ------------------------------------------------------------------------------------------
;;; the spaces.  A "space descriptor" sd is a list (omega cA mu).
(define kcb-X '(xs cA mu))
(define kcb-Y '(ys cB nu))
(define (kcb-L sd) (cons 'L2-SPACE sd))
(define (kcb-set sd) (cons 'L2-SET sd))
(define (kcb-H sd) (cons 'CL2-HILBERT sd))
(define (kcb-st sd) (list 'SIP-SETOID (kcb-L sd)))
(define (kcb-cl sd f) (list 'CLASS (kcb-st sd) f))
(define (kcb-pr sd f g) (list 'LIST (kcb-cl sd f) (kcb-cl sd g)))
(define (kcb-op sd op) (list op (kcb-L sd)))
(define (kcb-vadd sd a b) (list (kcb-op sd 'VADD) a b))
(define (kcb-vneg sd a) (list (kcb-op sd 'VNEG) a))
(define (kcb-act sd r a) (list (kcb-op sd 'ACT) r a))
(define kcb-xy '(CARTESIAN xs ys))
(define kcb-ps '(PRODUCT-SIGMA xs cA ys cB))
(define kcb-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define kcb-meas2 '((IS-MEASURE xs cA mu) (IS-MEASURE ys cB nu) (IS-SIGMA-FINITE xs cA mu) (IS-SIGMA-FINITE ys cB nu)))
(define (kcb-l2k k) (list 'IN k (list 'L2-SET kcb-xy kcb-ps kcb-rho)))
(define (kcb-KA k f) (list 'KERNEL-APPLY 'xs 'ys 'cB 'nu k f))
(define kcb-T '(CL2-INT-OP xs cA mu ys cB nu k1 k2))
(define (kcb-ka? t) (and (pair? t) (eq? (car t) 'KERNEL-APPLY)))
(define (kcb-op? t sd op) (and (pair? t) (equal? (car t) (kcb-op sd op))))

;;; IS-MEASURE sd: the SIP facts of L2-SPACE sd
(define (kcb-lbase! sd)
  (let ((L (kcb-L sd)))
    (if (not (dk-asm? (list 'IS-SEMI-INNER-PRODUCT-SPACE L))) (apply dk-cite! (cons 'l2-space-is-sip sd)))
    (if (not (dk-asm? (list '== (list 'VEC L) (kcb-set sd)))) (apply dk-cite! (cons 'l2-space-vec sd)))
    (if (not (dk-asm? (list 'IS-SETOID (kcb-st sd)))) (dk-cite! 'sip-setoid-is-setoid L))
    (if (not (dk-asm? (list '== (list 'PTS (kcb-st sd)) (list 'VEC L)))) (dk-cite! 'sip-setoid-pts L))
    (if (not (dk-asm? (list '= (list 'SCAL L) '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))))
        (dk-cite! 'sip-scal-pin L))))

;;; (IN t (VEC L)) for a term of L2-SPACE sd built from L2-SET members, KERNEL-APPLYs and
;;; VADD / VNEG / ACT
(define (kcb-vt! sd t)
  (let* ((L (kcb-L sd)) (want (list 'IN t (list 'VEC L))))
    (cond ((dk-asm? want) want)
          ((kcb-op? t sd 'VADD) (kcb-vt! sd (cadr t)) (kcb-vt! sd (caddr t))
           (dk-cite! 'module-vadd-type-sip-as-module L (cadr t) (caddr t)) want)
          ((kcb-op? t sd 'VNEG) (kcb-vt! sd (cadr t)) (dk-cite! 'module-vneg-type-sip-as-module L (cadr t)) want)
          ((kcb-op? t sd 'ACT) (kcb-vt! sd (caddr t)) (dk-real! (cadr t))
           (dk-cite! 'hbs-act-in-sip-as-module L (cadr t) (caddr t)) want)
          (#t (kcb-in! sd t)
              (dk-rewrite-h! (list 'IN t (kcb-set sd)) (kcb-set sd) (list 'VEC L))
              want))))
;;; (IN t (L2-SET sd))
(define (kcb-in! sd t)
  (let ((want (list 'IN t (kcb-set sd))))
    (cond ((dk-asm? want) want)
          ((kcb-ka? t)
           (kcb-in! kcb-Y (list-ref t 6))
           (dk-split! (dk-cite! 'kernel-apply-spec 'xs 'cA 'mu 'ys 'cB 'nu (list-ref t 5) (list-ref t 6)))
           (if (not (dk-asm? want)) (error "kcb-in!: kernel-apply-spec did not type" t))
           want)
          ((or (kcb-op? t sd 'VADD) (kcb-op? t sd 'VNEG) (kcb-op? t sd 'ACT))
           (kcb-vt! sd t)
           (dk-rewrite-h! (list 'IN t (list 'VEC (kcb-L sd))) (list 'VEC (kcb-L sd)) (kcb-set sd))
           want)
          (#t (error "kcb-in!: cannot type" (expression->string t))))))

;;; the L2-VADD / L2-VNEG / L2-ACT form of a term, and its L2-SET typing
(define (kcb-l2form sd t)
  (cond ((not (pair? t)) t)
        ((kcb-op? t sd 'VADD) (list (cons 'L2-VADD sd) (kcb-l2form sd (cadr t)) (kcb-l2form sd (caddr t))))
        ((kcb-op? t sd 'VNEG) (list (cons 'L2-VNEG sd) (kcb-l2form sd (cadr t))))
        ((kcb-op? t sd 'ACT) (list (cons 'L2-ACT sd) (cadr t) (kcb-l2form sd (caddr t))))
        (#t t)))
(define (kcb-opeqs! sd)
  (for-each (lambda (nm) (let ((e (list '== (kcb-op sd (car nm)) (cons (cdr nm) sd))))
                           (if (not (dk-asm? e)) (apply dk-cite! (cons (string->symbol (string-append "l2-space-" (symbol->string (car nm)))) sd)))))
            '((VADD . L2-VADD) (VNEG . L2-VNEG) (ACT . L2-ACT))))
(define (kcb-rw-ops-h! sd f)
  (let loop ((f f) (ops '(VADD VNEG ACT)))
    (if (null? ops) f
        (loop (if (dk-contains? f (kcb-op sd (car ops)))
                  (dk-rewrite-h! f (kcb-op sd (car ops)) (cons (string->symbol (string-append "l2-" (symbol->string (car ops)))) sd))
                  f)
              (cdr ops)))))
;;; type t and all its operator subterms in l2form
(define (kcb-in-l2form! sd t)
  (kcb-in! sd t)
  (kcb-opeqs! sd)
  (let ((f (list 'IN t (kcb-set sd))))
    (if (not (dk-asm? (list 'IN (kcb-l2form sd t) (kcb-set sd)))) (kcb-rw-ops-h! sd f)))
  (cond ((kcb-op? t sd 'VADD) (kcb-in-l2form! sd (cadr t)) (kcb-in-l2form! sd (caddr t)))
        ((kcb-op? t sd 'VNEG) (kcb-in-l2form! sd (cadr t)))
        ((kcb-op? t sd 'ACT) (dk-real! (cadr t)) (kcb-in-l2form! sd (caddr t)))))
;;; the operator subterms (VADD / VNEG / ACT of L2-SPACE sd) of a formula, outermost first
(define (kcb-op-subterms sd e)
  (cond ((not (pair? e)) '())
        ((or (kcb-op? e sd 'VADD) (kcb-op? e sd 'VNEG) (kcb-op? e sd 'ACT)) (list e))
        (#t (apply append (kcb-map (lambda (s) (kcb-op-subterms sd s)) e)))))
;;; evaluate, in the goal, every application of an L2 operation at a point
(define (kcb-find-l2app sd e)
  (cond ((not (pair? e)) #f)
        ((and (pair? (car e)) (pair? (caar e)) (memq (car (caar e)) '(L2-VADD L2-VNEG L2-ACT))
              (equal? (cdr (caar e)) sd))
         (car e))
        (#t (let loop ((l e)) (cond ((null? l) #f) ((kcb-find-l2app sd (car l)) => (lambda (r) r)) (#t (loop (cdr l))))))))
(define (kcb-eval! sd)
  (let loop ((n 0))
    (let ((h (kcb-find-l2app sd (dk-goal))))
      (if (and h (< n 40))
          (begin
            (case (car (car h))
              ((L2-VADD) (subst (apply dk-cite! (append (list 'l2-vadd-value) sd (list (cadr h) (caddr h))))))
              ((L2-VNEG) (subst (apply dk-cite! (append (list 'l2-vneg-value) sd (list (cadr h))))))
              ((L2-ACT) (subst (apply dk-cite! (append (list 'l2-act-value) sd (list (cadr h) (caddr h)))))))
            (kcb-lb!)
            (loop (+ n 1)))))))
;;; type f(x) in RR for every L2-SET member f applied at x in the goal
(define (kcb-type-apps! sd x)
  (let walk ((e (dk-goal)))
    (if (pair? e)
        (begin
          (if (and (equal? (cdr e) (list x)) (dk-asm? (list 'IN (car e) (kcb-set sd)))
                   (not (dk-asm? (list 'IN e 'RR))))
              (begin (if (not (dk-asm? (list 'IN (car e) (list 'FUN (car sd) 'RR))))
                         (dk-split! (apply dk-cite! (append (list 'l2-out) sd (list (car e))))))
                     (fact 'fun-apply-type-c (car e) (car sd) 'RR x)))
          (for-each walk e)))))

;;; prove (= (CLASS st F) (CLASS st Fb)) for L2 terms F, Fb of sd, given a.e. facts aes, each
;;; (e . (FORALL x (IMPLIES (IN x om) (IMPLIES (NOT (IN x e)) (= lhs rhs))))) over sd's omega;
;;; returns the claim
(define (kcb-tr . xs) #t)   ; integration 2026-11-10: trace output silenced
(define kcb-eqs '())
(define (kcb-class-eq! sd F Fb aes)
  (let* ((om (car sd))
         (claim (list '= (kcb-cl sd F) (kcb-cl sd Fb))))
    (if (not (dk-asm? claim))
        (begin
          (kcb-lbase! sd)
          (kcb-in! sd F) (kcb-in! sd Fb)
          (kcb-tr "ce-start" F)
          (kcb-in-l2form! sd F) (kcb-in-l2form! sd Fb)
          (kcb-tr "ce-typed")
          (let* ((iff (apply dk-cite! (append (list 'cl2-class-eq-iff-ae) sd (list F Fb))))
                 (en (kcb-union-null! (car sd) (cadr sd) (caddr sd) (kcb-map car aes))))
            (dk-have! (caddr iff)
              (lambda ()
                (ew en)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let ((x (dk-di-var!)))
                          (kcb-tr "ce-pt" x)
                          (di)
                          (kcb-not-in-union! x en)
                          (kcb-tr "ce-union")
                          (set! kcb-eqs (kcb-map (lambda (o) (dk-apply! (cdr o) x)) aes))
                          (kcb-opeqs! sd)
                          (for-each (lambda (nm) (if (dk-contains? (dk-goal) (kcb-op sd (car nm)))
                                                     (subst (list '= (kcb-op sd (car nm)) (cons (cdr nm) sd)))))
                                    '((VADD . L2-VADD) (VNEG . L2-VNEG) (ACT . L2-ACT)))
                          (kcb-tr "ce-applied" (dk-goal))
                          (kcb-eval! sd)
                          (kcb-tr "ce-eval" (dk-goal))
                          (kcb-type-apps! sd x)
                          (for-each (lambda (cx) (if (dk-contains? (dk-goal) (cadr cx)) (subst cx))) kcb-eqs)
                          (kcb-type-apps! sd x)
                          (if (kcb-open?) (crs))))))))
            (dk-have! claim (lambda () (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff))) (ass))))))
    claim))

;;; c = CHOICE q for q in QUOTIENT(stY): c in L2-SET(ys) and CLASS c = q
(define (kcb-choice-q! sd q)
  (kcb-lbase! sd)
  (let* ((st (kcb-st sd)) (c (list 'CHOICE q)) (want (list 'IN c (kcb-set sd))))
    (if (not (dk-asm? want))
        (let* ((rp (dk-cite! 'quotient-rep st q))
               (a (dk-skolem! rp)))
          (let ((cj (find-first (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h a))) (dk-asms))))
            (if cj (dk-split! cj)))
          (if (not (dk-asm? (list 'IN a (list 'PTS st))))
              (error "kcb-choice-q!: no rep typing" a))
          (dk-cite! 'class-self st a)
          (let ((eq (find-first (lambda (h) (and (dk-head-is? h '=) (dk-contains? h a) (dk-contains? h q))) (dk-asms))))
            (dk-rewrite-h! (list 'IN a (kcb-cl sd a)) (kcb-cl sd a) q))
          (dk-have! (list 'FORSOME 'chx_ (list 'IN 'chx_ q)) (lambda () (ew a) (ass)))
          (dk-cite! 'choice-axiom q)
          (dk-split! (dk-cite! 'class-of-member st q c))
          (dk-rewrite-h! (list 'IN c (list 'PTS st)) (list 'PTS st) (list 'VEC (kcb-L sd)))
          (dk-rewrite-h! (list 'IN c (list 'VEC (kcb-L sd))) (list 'VEC (kcb-L sd)) (kcb-set sd))))
    c))
;;; c = CHOICE (CLASS f), f in L2-SET: c typed, and the a.e. fact c = f, returned as (e . off)
(define (kcb-choice-cl! sd f)
  (kcb-lbase! sd)
  (let* ((st (kcb-st sd)) (q (kcb-cl sd f)) (c (list 'CHOICE q)))
    (kcb-tr "choice-cl" f)
    (kcb-vt! sd f)
    (if (not (dk-asm? (list 'IN f (list 'PTS st))))
        (dk-rewrite-h! (list 'IN f (list 'VEC (kcb-L sd))) (list 'VEC (kcb-L sd)) (list 'PTS st)))
    (dk-cite! 'class-in-quotient st f)
    (kcb-choice-q! sd q)
    (if (not (dk-asm? (list '= (kcb-cl sd c) q)))
        (dk-split! (dk-cite! 'class-of-member st q c)))
    (let* ((iff (apply dk-cite! (append (list 'cl2-class-eq-iff-ae) sd (list c f))))
           (fs (dk-project! (caddr iff) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))
      (kcb-sk-off! fs))))

;;; ==========================================================================================
;;; (1) THE SUM AND THE COMPLEX ACTION OF CL2-HILBERT ON PAIRS OF CLASSES
;;; ==========================================================================================
(define (kcb-sp-meas body)
  (sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu
        (list 'IMPLIES '(IS-MEASURE omega cA mu) body)))))))
(define kcb-O '(omega cA mu))
(define kcb-Ow (list 'CSIP-CIPS (list 'COMPLEXIFY (list 'SIP-QUOTIENT (kcb-L kcb-O)))))
(define (kcb-to-w!) (let ((e (dk-cite! 'cl2-hilbert-unfold 'omega 'cA 'mu))) (subst (list '= (cadr e) (caddr e)))))

(kcb-sp-meas (forall-guarded '(f1 f2 g1 g2) (kcb-map (lambda (f) (list 'IN f (kcb-set kcb-O))) '(f1 f2 g1 g2))
  (list '= (list (list 'VADD (kcb-H kcb-O)) (kcb-pr kcb-O 'f1 'f2) (kcb-pr kcb-O 'g1 'g2))
           (kcb-pr kcb-O (kcb-vadd kcb-O 'f1 'g1) (kcb-vadd kcb-O 'f2 'g2)))))
(dk-peel!)
(kcb-lbase! kcb-O)
(for-each (lambda (f) (kcb-vt! kcb-O f)) '(f1 f2 g1 g2))
(kcb-in! kcb-O (kcb-vadd kcb-O 'f1 'g1)) (kcb-in! kcb-O (kcb-vadd kcb-O 'f2 'g2))
(dk-cite! 'cl2-hilbert-pair-in 'omega 'cA 'mu (kcb-vadd kcb-O 'f1 'g1) (kcb-vadd kcb-O 'f2 'g2))
(kcb-to-w!)
(subst (dk-cite! 'cxq-vadd-classes (kcb-L kcb-O) 'f1 'f2 'g1 'g2))
(if (kcb-open?) (rfl))
(kcb-qed! 'cl2-hilbert-vadd-classes)

(define kcb-act-rhs
  (kcb-pr kcb-O (kcb-vadd kcb-O (kcb-act kcb-O '(real-part z_) 'f1) (kcb-act kcb-O '(imag-part z_) (kcb-vneg kcb-O 'f2)))
                (kcb-vadd kcb-O (kcb-act kcb-O '(real-part z_) 'f2) (kcb-act kcb-O '(imag-part z_) 'f1))))
(kcb-sp-meas (forall-guarded '(z_ f1 f2) (list '(IN z_ CC) (list 'IN 'f1 (kcb-set kcb-O)) (list 'IN 'f2 (kcb-set kcb-O)))
  (list '= (list (list 'ACT (kcb-H kcb-O)) 'z_ (kcb-pr kcb-O 'f1 'f2)) kcb-act-rhs)))
(dk-peel!)
(kcb-lbase! kcb-O)
(dk-cite! 'real-part-in-rr 'z_) (dk-cite! 'imag-part-in-rr 'z_)
(for-each (lambda (f) (kcb-vt! kcb-O f)) '(f1 f2))
(kcb-in! kcb-O (caddr (cadr kcb-act-rhs))) (kcb-in! kcb-O (caddr (caddr kcb-act-rhs)))
(dk-cite! 'cl2-hilbert-pair-in 'omega 'cA 'mu (caddr (cadr kcb-act-rhs)) (caddr (caddr kcb-act-rhs)))
(kcb-to-w!)
(subst (dk-cite! 'cxq-act-classes (kcb-L kcb-O) 'z_ 'f1 'f2))
(if (kcb-open?) (rfl))
(kcb-qed! 'cl2-hilbert-act-classes)

;;; ==========================================================================================
;;; (2) THE OPERATOR ON CLASSES
;;; ==========================================================================================
(define kcb-hyps (append kcb-meas2 (list (kcb-l2k 'k1) (kcb-l2k 'k2))))
(define (kcb-base!)
  (kcb-parts! 'is-measure '(xs cA mu))
  (kcb-parts! 'is-measure '(ys cB nu))
  (fact 'sigma-algebra-ambient-set 'xs 'cA)
  (fact 'sigma-algebra-ambient-set 'ys 'cB)
  (kcb-lbase! kcb-X) (kcb-lbase! kcb-Y))
(define (kcb-c1 a b) (kcb-vadd kcb-X (kcb-KA 'k1 a) (kcb-vneg kcb-X (kcb-KA 'k2 b))))
(define (kcb-c2 a b) (kcb-vadd kcb-X (kcb-KA 'k1 b) (kcb-KA 'k2 a)))
;;; T [a, b] = [K1 a - K2 b, K1 b + K2 a]
(define (kcb-Tv a b) (list 'LIST (kcb-cl kcb-X (kcb-c1 a b)) (kcb-cl kcb-X (kcb-c2 a b))))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2 f1 f2)
   (append kcb-hyps (list (list 'IN 'f1 (kcb-set kcb-Y)) (list 'IN 'f2 (kcb-set kcb-Y))))
   (list '= (list kcb-T (kcb-pr kcb-Y 'f1 'f2)) (kcb-Tv 'f1 'f2)))))
(dk-peel!)
(kcb-base!)
(dk-cite! 'cl2-hilbert-pair-in 'ys 'cB 'nu 'f1 'f2)
(mac 'CL2-INT-OP)
(kcb-lb!)
(let loop ((n 0)) (if (and (< n 4) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ n 1)))))
(let* ((o1 (kcb-choice-cl! kcb-Y 'f1)) (o2 (kcb-choice-cl! kcb-Y 'f2))
       (c1 (list 'CHOICE (kcb-cl kcb-Y 'f1))) (c2 (list 'CHOICE (kcb-cl kcb-Y 'f2))))
  (let* ((a11 (kcb-sk-off! (dk-cite! 'kernel-apply-ae-eq 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'f1 c1 (car o1))))
         (a22 (kcb-sk-off! (dk-cite! 'kernel-apply-ae-eq 'xs 'cA 'mu 'ys 'cB 'nu 'k2 'f2 c2 (car o2))))
         (a12 (kcb-sk-off! (dk-cite! 'kernel-apply-ae-eq 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'f2 c2 (car o2))))
         (a21 (kcb-sk-off! (dk-cite! 'kernel-apply-ae-eq 'xs 'cA 'mu 'ys 'cB 'nu 'k2 'f1 c1 (car o1)))))
    (subst (kcb-class-eq! kcb-X (kcb-c1 c1 c2) (kcb-c1 'f1 'f2) (list a11 a22)))
    (subst (kcb-class-eq! kcb-X (kcb-c2 c1 c2) (kcb-c2 'f1 'f2) (list a12 a21)))
    (dk-cite! 'cl2-hilbert-pair-in 'xs 'cA 'mu (kcb-c1 'f1 'f2) (kcb-c2 'f1 'f2))
    (if (kcb-open?) (rfl))))
(kcb-qed! 'cl2-int-op-classes)

;;; ------------------------------------------------------------------------------------------
;;; (IN (QUOTIENT stY) SET) and (IN (VEC HY) SET)
(define (kcb-vec-set! sd)
  (kcb-lbase! sd)
  (let* ((L (kcb-L sd)) (Q (list 'QUOTIENT (kcb-st sd))) (H (kcb-H sd)) (want (list 'IN (list 'VEC H) 'SET)))
    (if (not (dk-asm? (list 'IN Q 'SET)))
        (let ((vs (dk-cite! 'sipq-vec-set L)))
          (dk-cite! 'sipq-vec L)
          (dk-rewrite-h! vs (list 'VEC (list 'SIP-QUOTIENT L)) Q)))
    (if (not (dk-asm? want))
        (let ((hv (apply dk-cite! (cons 'cl2-hilbert-vec sd))))
          (dk-have! (list 'IN (list 'CARTESIAN Q Q) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
          (dk-rewrite-h! (list 'IN (list 'CARTESIAN Q Q) 'SET) (list 'CARTESIAN Q Q) (list 'VEC H))))
    want))
;;; z in VEC H: z = [CLASS f1, CLASS f2] with f1, f2 in L2-SET; returns (f1 . f2)
(define (kcb-rep! sd z)
  (let* ((r (apply dk-cite! (append (list 'cl2-hilbert-rep) sd (list z))))
         (f1 (dk-skolem! r))
         (inner (find-first (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h f1))) (dk-asms)))
         (f2 (dk-skolem! inner)))
    (cons f1 f2)))
;;; LIN: h = a u + b w pointwise on ys (h an L2 term of ys); returns the a.e. fact over xs
(define (kcb-lin! k h a u b w)
  (kcb-in! kcb-Y h) (kcb-in! kcb-Y u) (kcb-in! kcb-Y w)
  (kcb-in-l2form! kcb-Y h)
  (dk-real! a) (dk-real! b)
  (fact 'ae-null-empty 'ys 'cB 'nu)
  (let ((hyp (kcb-off 'tyy_ 'ys 'EMPTY-SET
                      (list '= (list h 'tyy_) (list '+ (list '* a (list u 'tyy_)) (list '* b (list w 'tyy_)))))))
    (if (not (dk-asm? hyp))
        (dk-have! hyp
          (lambda ()
            (let ((y (dk-di-var!)))
              (di)
              (kcb-opeqs! kcb-Y)
              (for-each (lambda (nm) (if (dk-contains? (dk-goal) (kcb-op kcb-Y (car nm)))
                                         (subst (list '= (kcb-op kcb-Y (car nm)) (cons (cdr nm) kcb-Y)))))
                        '((VADD . L2-VADD) (VNEG . L2-VNEG) (ACT . L2-ACT)))
              (kcb-eval! kcb-Y)
              (kcb-type-apps! kcb-Y y)
              (if (kcb-open?) (crs))))))
    (kcb-sk-off! (dk-cite! 'kernel-apply-linear-ae 'xs 'cA 'mu 'ys 'cB 'nu k u w h a b 'EMPTY-SET))))

;;; T maps CL2-HILBERT(ys) into CL2-HILBERT(xs)
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2) kcb-hyps
   (list 'IN kcb-T (list 'FUN (list 'VEC (kcb-H kcb-Y)) (list 'VEC (kcb-H kcb-X)))))))
(dk-peel!)
(kcb-base!)
(kcb-vec-set! kcb-Y)
(mac 'CL2-INT-OP)
(dk-lam-type!
  (lambda ()
    (let* ((z (dk-di-var!))
           (Q (list 'QUOTIENT (kcb-st kcb-Y))))
      (apply dk-cite! (cons 'cl2-hilbert-vec kcb-Y))
      (dk-rewrite-h! (list 'IN z (list 'VEC (kcb-H kcb-Y))) (list 'VEC (kcb-H kcb-Y)) (list 'CARTESIAN Q Q))
      (dk-split! (dk-cite! 'cartesian-nth z Q Q))
      (kcb-choice-q! kcb-Y (list 'NTH 1 z))
      (kcb-choice-q! kcb-Y (list 'NTH 2 z))
      (kcb-lb!)
      (let* ((c1 (list 'CHOICE (list 'NTH 1 z))) (c2 (list 'CHOICE (list 'NTH 2 z))))
        (kcb-in! kcb-X (kcb-c1 c1 c2)) (kcb-in! kcb-X (kcb-c2 c1 c2))
        (dk-cite! 'cl2-hilbert-pair-in 'xs 'cA 'mu (kcb-c1 c1 c2) (kcb-c2 c1 c2))
        (if (kcb-open?) (ass)))))
  (lambda () (ass)))
(kcb-qed! 'cl2-int-op-fun)

;;; T is additive
(define (kcb-Ta z) (list kcb-T z))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2 z_ w_)
   (append kcb-hyps (list (list 'IN 'z_ (list 'VEC (kcb-H kcb-Y))) (list 'IN 'w_ (list 'VEC (kcb-H kcb-Y)))))
   (list '= (kcb-Ta (list (list 'VADD (kcb-H kcb-Y)) 'z_ 'w_))
            (list (list 'VADD (kcb-H kcb-X)) (kcb-Ta 'z_) (kcb-Ta 'w_))))))
(dk-peel!)
(kcb-base!)
(let* ((fz (kcb-rep! kcb-Y 'z_)) (fw (kcb-rep! kcb-Y 'w_))
       (f1 (car fz)) (f2 (cdr fz)) (g1 (car fw)) (g2 (cdr fw))
       (h1 (kcb-vadd kcb-Y f1 g1)) (h2 (kcb-vadd kcb-Y f2 g2)))
  (subst (list '= 'z_ (kcb-pr kcb-Y f1 f2)))
  (subst (list '= 'w_ (kcb-pr kcb-Y g1 g2)))
  (subst (dk-cite! 'cl2-hilbert-vadd-classes 'ys 'cB 'nu f1 f2 g1 g2))
  (kcb-in! kcb-Y h1) (kcb-in! kcb-Y h2)
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 h1 h2))
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 f1 f2))
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 g1 g2))
  (for-each (lambda (t) (kcb-in! kcb-X t)) (list (kcb-c1 f1 f2) (kcb-c2 f1 f2) (kcb-c1 g1 g2) (kcb-c2 g1 g2)))
  (subst (dk-cite! 'cl2-hilbert-vadd-classes 'xs 'cA 'mu (kcb-c1 f1 f2) (kcb-c2 f1 f2) (kcb-c1 g1 g2) (kcb-c2 g1 g2)))
  (let* ((l11 (kcb-lin! 'k1 h1 1 f1 1 g1)) (l22 (kcb-lin! 'k2 h2 1 f2 1 g2))
         (l12 (kcb-lin! 'k1 h2 1 f2 1 g2)) (l21 (kcb-lin! 'k2 h1 1 f1 1 g1))
         (r1 (kcb-vadd kcb-X (kcb-c1 f1 f2) (kcb-c1 g1 g2)))
         (r2 (kcb-vadd kcb-X (kcb-c2 f1 f2) (kcb-c2 g1 g2))))
    (subst (kcb-class-eq! kcb-X (kcb-c1 h1 h2) r1 (list l11 l22)))
    (subst (kcb-class-eq! kcb-X (kcb-c2 h1 h2) r2 (list l12 l21)))
    (dk-cite! 'cl2-hilbert-pair-in 'xs 'cA 'mu r1 r2)
    (if (kcb-open?) (rfl))))
(kcb-qed! 'cl2-int-op-add)

;;; T is complex homogeneous
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2 c_ z_)
   (append kcb-hyps (list '(IN c_ CC) (list 'IN 'z_ (list 'VEC (kcb-H kcb-Y)))))
   (list '= (kcb-Ta (list (list 'ACT (kcb-H kcb-Y)) 'c_ 'z_))
            (list (list 'ACT (kcb-H kcb-X)) 'c_ (kcb-Ta 'z_))))))
(dk-peel!)
(kcb-base!)
(dk-cite! 'real-part-in-rr 'c_) (dk-cite! 'imag-part-in-rr 'c_)
(let* ((fz (kcb-rep! kcb-Y 'z_)) (f1 (car fz)) (f2 (cdr fz))
       (re '(real-part c_)) (im '(imag-part c_)) (nim (list '- '(imag-part c_)))
       (h1 (kcb-vadd kcb-Y (kcb-act kcb-Y re f1) (kcb-act kcb-Y im (kcb-vneg kcb-Y f2))))
       (h2 (kcb-vadd kcb-Y (kcb-act kcb-Y re f2) (kcb-act kcb-Y im f1)))
       (P (kcb-c1 f1 f2)) (Q (kcb-c2 f1 f2)))
  (subst (list '= 'z_ (kcb-pr kcb-Y f1 f2)))
  (subst (dk-cite! 'cl2-hilbert-act-classes 'ys 'cB 'nu 'c_ f1 f2))
  (kcb-in! kcb-Y h1) (kcb-in! kcb-Y h2)
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 h1 h2))
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 f1 f2))
  (kcb-in! kcb-X P) (kcb-in! kcb-X Q)
  (subst (dk-cite! 'cl2-hilbert-act-classes 'xs 'cA 'mu 'c_ P Q))
  (dk-real! nim)
  (let* ((l11 (kcb-lin! 'k1 h1 re f1 nim f2)) (l22 (kcb-lin! 'k2 h2 re f2 im f1))
         (l12 (kcb-lin! 'k1 h2 re f2 im f1)) (l21 (kcb-lin! 'k2 h1 re f1 nim f2))
         (r1 (kcb-vadd kcb-X (kcb-act kcb-X re P) (kcb-act kcb-X im (kcb-vneg kcb-X Q))))
         (r2 (kcb-vadd kcb-X (kcb-act kcb-X re Q) (kcb-act kcb-X im P))))
    (subst (kcb-class-eq! kcb-X (kcb-c1 h1 h2) r1 (list l11 l22)))
    (subst (kcb-class-eq! kcb-X (kcb-c2 h1 h2) r2 (list l12 l21)))
    (kcb-in! kcb-X r1) (kcb-in! kcb-X r2)
    (dk-cite! 'cl2-hilbert-pair-in 'xs 'cA 'mu r1 r2)
    (if (kcb-open?) (rfl))))
(kcb-qed! 'cl2-int-op-act)

;;; ==========================================================================================
;;; (3) THE BOUND ||T z||^2 <= ||K||^2 ||z||^2 : the form on a pair of classes, complex Schwarz
;;;     for the sections, and the integration
;;; ==========================================================================================
(define (kcb-sq f om) (list 'VNB-LAMBDA 'lx_ om (list '* (list f 'lx_) (list f 'lx_))))
(define (kcb-int sd f g) (list 'RINTEGRAL (car sd) (cadr sd) (caddr sd)
                               (list 'VNB-LAMBDA 'lx_ (car sd) (list '* (list f 'lx_) (list g 'lx_)))))
(define (kcb-rip sd) (list 'RIP (kcb-L sd)))
(define (kcb-l2rip sd) (cons 'L2-RIP sd))
;;; RINTEGRAL(f g) as L2-RIP(f, g), then as RIP(L)(f, g): returns the two equations
(define (kcb-int-as-rip! sd f g)
  (let* ((ve (apply dk-cite! (append (list 'l2-rip-value) sd (list f g)))))
    ve))

;;; <[f1, f2], [f1, f2]> = int f1 f1 + int f2 f2
(kcb-sp-meas (forall-guarded '(f1 f2) (list (list 'IN 'f1 (kcb-set kcb-O)) (list 'IN 'f2 (kcb-set kcb-O)))
  (list '= (list (list 'IP (kcb-H kcb-O)) (kcb-pr kcb-O 'f1 'f2) (kcb-pr kcb-O 'f1 'f2))
           (list '+ (kcb-int kcb-O 'f1 'f1) (kcb-int kcb-O 'f2 'f2)))))
(dk-peel!)
(kcb-lbase! kcb-O)
(subst (dk-cite! 'cl2-hilbert-ip-classes 'omega 'cA 'mu 'f1 'f2 'f1 'f2))
(let ((L (kcb-L kcb-O)))
  (for-each (lambda (f) (kcb-vt! kcb-O f)) '(f1 f2))
  (dk-cite! 'l2-space-rip 'omega 'cA 'mu)
  ;; back from the integrals to the form, where crs sees no binder
  (for-each (lambda (pr)
              (let ((ve (dk-cite! 'l2-rip-value 'omega 'cA 'mu (car pr) (cdr pr))))
                (subst (list '= (caddr ve) (cadr ve)))))
            '((f1 . f1) (f2 . f2) (f1 . f2) (f2 . f1)))
  (subst (list '= (kcb-l2rip kcb-O) (kcb-rip kcb-O)))
  (subst (dk-cite! 'sip-rip-sym L 'f2 'f1))
  (for-each (lambda (pr) (dk-cite! 'sip-rip-type L (car pr) (cdr pr))) '((f1 . f1) (f2 . f2) (f1 . f2)))
  (fact 'cc-i-in)
  (if (kcb-open?) (crs)))
(kcb-qed! 'cl2-hilbert-ip-self)

;;; int p (-f) = - int p f   and   int (-f)(-f) = int f f
(kcb-sp-meas (forall-guarded '(p f) (list (list 'IN 'p (kcb-set kcb-O)) (list 'IN 'f (kcb-set kcb-O)))
  (list '= (kcb-int kcb-O 'p (kcb-vneg kcb-O 'f)) (list '- (kcb-int kcb-O 'p 'f)))))
(dk-peel!)
(kcb-lbase! kcb-O)
(let* ((L (kcb-L kcb-O)) (nf (kcb-vneg kcb-O 'f)))
  (kcb-in! kcb-O nf) (kcb-vt! kcb-O 'p) (kcb-vt! kcb-O 'f)
  (let ((e1 (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'p nf))
        (e2 (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'p 'f)))
    (dk-cite! 'sip-rip-type L 'p 'f)
    (dk-cite! 'l2-space-rip 'omega 'cA 'mu)
    (subst (list '= (caddr e1) (cadr e1)))
    (subst (list '= (caddr e2) (cadr e2)))
    (subst (list '= (kcb-l2rip kcb-O) (kcb-rip kcb-O)))
    (subst (dk-cite! 'sip-rip-neg-right L 'p 'f))
    (if (kcb-open?) (rfl))))
(kcb-qed! 'l2-int-neg-right)

(kcb-sp-meas (forall-guarded '(f) (list (list 'IN 'f (kcb-set kcb-O)))
  (list '= (kcb-int kcb-O (kcb-vneg kcb-O 'f) (kcb-vneg kcb-O 'f)) (kcb-int kcb-O 'f 'f))))
(dk-peel!)
(kcb-lbase! kcb-O)
(let* ((L (kcb-L kcb-O)) (nf (kcb-vneg kcb-O 'f)))
  (kcb-in! kcb-O nf) (kcb-vt! kcb-O 'f)
  (let ((e1 (dk-cite! 'l2-rip-value 'omega 'cA 'mu nf nf))
        (e2 (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'f 'f)))
    (dk-cite! 'sip-rip-type L 'f 'f)
    (dk-cite! 'l2-space-rip 'omega 'cA 'mu)
    (subst (list '= (caddr e1) (cadr e1)))
    (subst (list '= (caddr e2) (cadr e2)))
    (subst (list '= (kcb-l2rip kcb-O) (kcb-rip kcb-O)))
    (subst (dk-cite! 'sip-rip-neg-self L 'f))
    (if (kcb-open?) (rfl))))
(kcb-qed! 'l2-int-neg-self)

;;; (a + i b) conj(a + i b) = a a + b b
(sp (make-wff (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR))
   '(= (* (+ a_ (* +i b_)) (conjugate (+ a_ (* +i b_)))) (+ (* a_ a_) (* b_ b_))))))
(dk-peel!)
(fact 'rr-subset-cc 'a_) (fact 'rr-subset-cc 'b_)
(fact 'cc-i-in)
(dk-have! '(AND (IN +i CC) (IN b_ CC)) (lambda () (dk-conj-close! dk-ass!)))
(fact 'cc-mul-closed '+i 'b_)
(dk-have! '(AND (IN a_ CC) (IN (* +i b_) CC)) (lambda () (dk-conj-close! dk-ass!)))
(subst (dk-cite! 'cc-conjugate-add 'a_ '(* +i b_)))
(subst (dk-cite! 'cc-conjugate-mul '+i 'b_))
(subst (dk-cite! 'cc-conjugate-i))
(subst (dk-cite! 'cc-conjugate-fixes-rr 'a_))
(subst (dk-cite! 'cc-conjugate-fixes-rr 'b_))
(dk-have! '(= (* (+ a_ (* +i b_)) (+ a_ (* (- +i) b_))) (+ (* a_ a_) (* (- (* +i +i)) (* b_ b_))))
  (lambda () (crs)))
(subst '(= (* (+ a_ (* +i b_)) (+ a_ (* (- +i) b_))) (+ (* a_ a_) (* (- (* +i +i)) (* b_ b_)))))
(subst (dk-cite! 'cc-i-squared))
(if (kcb-open?) (crs))
(kcb-qed! 'cc-mul-conj-parts)

;;; complex Schwarz for the sections: off a mu-null set,
;;;   (K1 f1 - K2 f2)(x)^2 + (K1 f2 + K2 f1)(x)^2 <= (S1(x) + S2(x)) (||f1||^2 + ||f2||^2),
;;; S_j = X-SECTION-INTEGRAL(k_j^2), finite there
(define (kcb-ksq k) (kcb-sq k kcb-xy))
(define (kcb-S k) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu (kcb-ksq k)))
(define (kcb-I f) (list 'INTEGRAL 'ys 'cB 'nu (kcb-sq f 'ys)))
(define kcb-P (kcb-c1 'f1 'f2))
(define kcb-Q (kcb-c2 'f1 'f2))
(define (kcb-bound-at x)
  (list '<= (list '+ (list '* (list kcb-P x) (list kcb-P x)) (list '* (list kcb-Q x) (list kcb-Q x)))
            (list '* (list '+ (list (kcb-S 'k1) x) (list (kcb-S 'k2) x)) (list '+ (kcb-I 'f1) (kcb-I 'f2)))))
(define (kcb-sec k x) (list 'FN-X-SECTION 'ys k x))
(define (kcb-prod-base!)
  (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
  (fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu))

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2 f1 f2)
   (append kcb-hyps (list (list 'IN 'f1 (kcb-set kcb-Y)) (list 'IN 'f2 (kcb-set kcb-Y))))
   (list 'FORSOME 'en_
     (list 'AND '(IS-NULL-SET xs cA mu en_)
       (kcb-off 'x 'xs 'en_
         (list 'AND (list 'IN (list (kcb-S 'k1) 'x) 'RR)
           (list 'AND (list 'IN (list (kcb-S 'k2) 'x) 'RR) (kcb-bound-at 'x)))))))))
(dk-peel!)
(kcb-base!)
(kcb-prod-base!)
(for-each (lambda (k) (dk-split! (dk-cite! 'l2-out kcb-xy kcb-ps kcb-rho k))
                      (dk-split! (dk-cite! 'l2-square-integral kcb-xy kcb-ps kcb-rho k)))
          '(k1 k2))
(for-each (lambda (f) (dk-split! (dk-cite! 'l2-out 'ys 'cB 'nu f))
                      (dk-split! (dk-cite! 'l2-square-integral 'ys 'cB 'nu f)))
          '(f1 f2))
(dk-cite! 'cl2-hilbert-is-hilbert-space 'ys 'cB 'nu)
(dk-cite! 'hilbert-space-is-cips (kcb-H kcb-Y))
(fact 'cc-i-in)
(let* ((secs (kcb-map (lambda (k)
                        (let ((sp (dk-split! (dk-cite! 'l2-sections-ae 'xs 'cA 'mu 'ys 'cB 'nu k))))
                          (kcb-sk-off! (find-first (lambda (q) (dk-head-is? q 'FORSOME)) sp))))
                      '(k1 k2)))
       (pairs '((k1 . f1) (k2 . f2) (k1 . f2) (k2 . f1)))
       (specs (kcb-map (lambda (pr)
                         (let ((sp (dk-split! (dk-cite! 'kernel-apply-spec 'xs 'cA 'mu 'ys 'cB 'nu (car pr) (cdr pr)))))
                           (kcb-sk-off! (find-first (lambda (q) (dk-head-is? q 'FORSOME)) sp))))
                       pairs))
       (en (kcb-union-null! 'xs 'cA 'mu (kcb-map car (append secs specs))))
       (nf2 (kcb-vneg kcb-Y 'f2)))
  (kcb-in! kcb-Y nf2)
  (kcb-in-l2form! kcb-X kcb-P) (kcb-in-l2form! kcb-X kcb-Q)
  (ew en)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (let ((x (dk-di-var!)))
            (di)
            (kcb-not-in-union! x en)
            (for-each (lambda (o) (dk-apply! (cdr o) x)) secs)
            (for-each (lambda (o) (let ((r (dk-apply! (cdr o) x))) (if (dk-head-is? r 'AND) (dk-split! r)))) specs)
            (let* ((a (kcb-sec 'k1 x)) (b (kcb-sec 'k2 x))
                   (kx (kcb-pr kcb-Y a b)) (wv (kcb-pr kcb-Y 'f1 nf2))
                   (HY (kcb-H kcb-Y)))
              ;; the squared sections
              (for-each (lambda (k s)
                          (fact 'xsi-square-section 'xs 'cA 'ys 'cB 'nu k x)
                          (dk-split! (dk-cite! 'l2-square-integral 'ys 'cB 'nu s))
                          (dk-rewrite-h! (list 'IN (list 'INTEGRAL 'ys 'cB 'nu (kcb-sq s 'ys)) 'RR)
                                         (list 'INTEGRAL 'ys 'cB 'nu (kcb-sq s 'ys)) (list (kcb-S k) x)))
                        '(k1 k2) (list a b))
              ;; the values K_j f_i (x) = int sec_j f_i are real
              (for-each (lambda (pr)
                          (let* ((G (kcb-KA (car pr) (cdr pr))))
                            (kcb-in! kcb-X G)
                            (dk-split! (dk-cite! 'l2-out 'xs 'cA 'mu G))
                            (fact 'fun-apply-type-c G 'xs 'RR x)
                            (let ((eq (find-first (lambda (q) (and (dk-head-is? q '=) (equal? (cadr q) (list G x)))) (dk-asms))))
                              (dk-rewrite-h! (list 'IN (list G x) 'RR) (list G x) (caddr eq)))))
                        pairs)
              (apply dk-cite! (append (list 'cl2-hilbert-pair-in) kcb-Y (list a b)))
              (apply dk-cite! (append (list 'cl2-hilbert-pair-in) kcb-Y (list 'f1 nf2)))
              (let* ((cs (dk-cite! 'cips-schwarz HY kx wv))
                     (e1 (apply dk-cite! (append (list 'cl2-hilbert-ip-classes) kcb-Y (list a b 'f1 nf2))))
                     (n1 (apply dk-cite! (append (list 'l2-int-neg-right) kcb-Y (list b 'f2))))
                     (n2 (apply dk-cite! (append (list 'l2-int-neg-right) kcb-Y (list a 'f2))))
                     (e2 (apply dk-cite! (append (list 'cl2-hilbert-ip-self) kcb-Y (list a b))))
                     (e3 (apply dk-cite! (append (list 'cl2-hilbert-ip-self) kcb-Y (list 'f1 nf2))))
                     (n3 (apply dk-cite! (append (list 'l2-int-neg-self) kcb-Y (list 'f2))))
                     (cs1 (dk-rewrite-h! cs (cadr e1) (caddr e1)))
                     (cs2 (dk-rewrite-h! cs1 (cadr n1) (caddr n1)))
                     (cs3 (dk-rewrite-h! cs2 (cadr n2) (caddr n2)))
                     (cs4 (dk-rewrite-h! cs3 (cadr e2) (caddr e2)))
                     (cs5 (dk-rewrite-h! cs4 (cadr e3) (caddr e3)))
                     (cs6 (dk-rewrite-h! cs5 (cadr n3) (caddr n3)))
                     (zz (cadr (cadr cs6)))
                     (A1 (cadr zz)) (A2 (caddr (caddr zz))))
                (dk-real! A1) (dk-real! A2)
                (let* ((c2 (dk-cite! 'cc-mul-conj-parts A1 A2))
                       (cs7 (dk-rewrite-h! cs6 (cadr c2) (caddr c2))))
                  (dk-conj-close!
                    (lambda ()
                      (cond
                        ((dk-asm? (dk-goal)) (ass))
                        ((dk-head-is? (dk-goal) '<=)
                         (kcb-opeqs! kcb-X)
                         (for-each (lambda (nm) (if (dk-contains? (dk-goal) (kcb-op kcb-X (car nm)))
                                                    (subst (list '= (kcb-op kcb-X (car nm)) (cons (cdr nm) kcb-X)))))
                                   '((VADD . L2-VADD) (VNEG . L2-VNEG) (ACT . L2-ACT)))
                         (kcb-eval! kcb-X)
                         (for-each (lambda (pr)
                                     (let* ((G (kcb-KA (car pr) (cdr pr)))
                                            (eq (find-first (lambda (q) (and (dk-head-is? q '=) (equal? (cadr q) (list G x)))) (dk-asms))))
                                       (subst eq)))
                                   pairs)
                         (let* ((qx (list '+ (kcb-int kcb-Y a 'f2) (kcb-int kcb-Y b 'f1))))
                           (dk-have! (list '= qx A2) (lambda () (dk-crs-opaque!)))
                           (subst (list '= qx A2)))
                         (for-each (lambda (k s)
                                     (subst (list '= (list (kcb-S k) x) (list 'INTEGRAL 'ys 'cB 'nu (kcb-sq s 'ys)))))
                                   '(k1 k2) (list a b))
                         (for-each (lambda (s)
                                     (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu (kcb-sq s 'ys)) (list 'RINTEGRAL 'ys 'cB 'nu (kcb-sq s 'ys)))))
                                   (list a b 'f1 'f2))
                         (if (kcb-open?) (ass)))
                        (#t (ass)))))))))))))
(kcb-qed! 'kernel-apply-cschwarz)

;;; the two-function form of TH3-L2B's l2-of-square-bound: off a null set
;;;   g1(x)^2 + g2(x)^2 <= h(x) c   gives   int g1^2 + int g2^2 <= (int h) c
(define kcb-g1sq (kcb-sq 'g1 'omega))
(define kcb-g2sq (kcb-sq 'g2 'omega))
(define kcb-F (list 'PTWISE-EPLUS 'omega kcb-g1sq kcb-g2sq))
(define kcb-h2 '(PTWISE-SCALE omega c h))
(define (kcb-intg f) (list 'INTEGRAL 'omega 'cA 'mu f))
(define (kcb-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(sp (make-wff (forall-guarded '(omega cA mu g1 g2 h c nb)
   (list '(IS-MEASURE omega cA mu) '(IN g1 (L2-SET omega cA mu)) '(IN g2 (L2-SET omega cA mu))
         '(IS-MEASURABLE-FN omega cA h) '(IN c RR) '(<= 0 c) '(IN (INTEGRAL omega cA mu h) RR)
         '(IN nb cA) '(= (mu nb) 0)
         (kcb-off 'x 'omega 'nb '(AND (<= (+ (* (g1 x) (g1 x)) (* (g2 x) (g2 x))) (* (h x) c)) (IN (h x) RR))))
   (list '<= (list '+ (kcb-intg kcb-g1sq) (kcb-intg kcb-g2sq)) '(* (INTEGRAL omega cA mu h) c)))))
(dk-peel!)
(kcb-parts! 'is-measure '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(dk-cite! 'measurable-fn-in-fun 'omega 'cA 'h)
(dk-cite! 'rmc-rps-of-nonneg 'c)
(for-each (lambda (g) (dk-split! (dk-cite! 'l2-out 'omega 'cA 'mu g))
                      (dk-split! (dk-cite! 'l2-square-integral 'omega 'cA 'mu g)))
          '(g1 g2))
(let* ((i1 (kcb-intg kcb-g1sq)) (i2 (kcb-intg kcb-g2sq))
       (ih '(INTEGRAL omega cA mu h)) (intF (kcb-intg kcb-F)) (ih2 (kcb-intg kcb-h2))
       (hyp (kcb-off 'x 'omega 'nb '(AND (<= (+ (* (g1 x) (g1 x)) (* (g2 x) (g2 x))) (* (h x) c)) (IN (h x) RR)))))
  (fact 'measurable-fn-eplus 'omega 'cA kcb-g1sq kcb-g2sq)
  (fact 'ptwise-scale-measurable 'omega 'cA 'h 'c)
  (for-each (lambda (i f) (fact 'integral-in 'omega 'cA 'mu f) (fact 'rr-pos-star-nonneg i)) (list i1 i2) (list kcb-g1sq kcb-g2sq))
  ;; int F = int g1^2 + int g2^2
  (let ((ad (dk-cite! 'integral-additive 'omega 'cA 'mu kcb-g1sq kcb-g2sq)))
    (dk-cite! 'eplus-real-defined i1 i2)
    (dk-cite! 'binplus-apply i1 i2)
    (dk-have! (list '= intF (list '+ i1 i2))
      (lambda ()
        (subst ad)
        (subst (list '= (list 'EPLUS i1 i2) (list 'BINPLUS i1 i2)))
        (subst (list '= (list 'BINPLUS i1 i2) (list '+ i1 i2)))
        (if (kcb-open?) (rfl)))))
  ;; F <= c h off nb
  (dk-have! (kcb-off 'x 'omega 'nb (list '<= (list kcb-F 'x) (list kcb-h2 'x)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (dk-split! (dk-apply! hyp w))
        (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR w)
        (fact 'rr-pos-star-nonneg (list 'h w))
        (for-each (lambda (g gsq)
                    (let ((m (list '* (list g w) (list g w))))
                      (fact 'fun-apply-type-c g 'omega 'RR w)
                      (fact 'rr-mul-in-rr (list g w) (list g w))
                      (fact 'rr-sq-nonneg (list g w))
                      (dk-cite! 'rmc-rps-of-nonneg m)
                      (dk-have! (list 'IN (list gsq w) 'RR-POS-STAR) (lambda () (kcb-lb!) (if (kcb-open?) (ass))))))
                  '(g1 g2) (list kcb-g1sq kcb-g2sq))
        (subst (dk-cite! 'ptwise-eplus-value 'omega kcb-g1sq kcb-g2sq w))
        (subst (dk-cite! 'ptwise-scale-value 'omega 'c 'h w))
        (kcb-lb!)
        (let ((m1 '(* (g1 x) (g1 x))) (m2 '(* (g2 x) (g2 x))))
          (let ((m1 (list '* (list 'g1 w) (list 'g1 w))) (m2 (list '* (list 'g2 w) (list 'g2 w))))
            (subst (dk-cite! 'eplus-real-defined m1 m2))
            (subst (dk-cite! 'binplus-apply m1 m2))
            (subst (dk-cite! 'etimes-real-defined 'c (list 'h w)))
            (subst (dk-cite! 'bintimes-apply 'c (list 'h w)))
            (dk-have! (list '= (list '* (list 'h w) 'c) (list '* 'c (list 'h w))) (lambda () (crs)))
            (dk-rewrite-h! (list '<= (list '+ m1 m2) (list '* (list 'h w) 'c)) (list '* (list 'h w) 'c) (list '* 'c (list 'h w)))
            (if (kcb-open?) (ass)))))))
  (fact 'integral-le-off-null 'omega 'cA 'mu 'nb kcb-F kcb-h2)
  (fact 'integral-homogeneous 'omega 'cA 'mu 'h 'c)
  (fact 'integral-in 'omega 'cA 'mu 'h)
  (fact 'rr-pos-star-nonneg ih)
  (dk-cite! 'etimes-real-defined 'c ih)
  (dk-cite! 'bintimes-apply 'c ih)
  (fact 'rr-mul-in-rr 'c ih)
  (fact 'rr-mul-in-rr ih 'c)
  (dk-have! (list '= (list '* 'c ih) (list '* ih 'c)) (lambda () (crs)))
  (subst (list '= (list '+ i1 i2) intF))
  (subst (list '= (list '* ih 'c) (list '* 'c ih)))
  (subst (list '= (list '* 'c ih) (list 'BINTIMES 'c ih)))
  (subst (list '= (list 'BINTIMES 'c ih) (list 'ETIMES 'c ih)))
  (subst (list '= (list 'ETIMES 'c ih) ih2))
  (if (kcb-open?) (ass)))
(kcb-qed! 'l2-pair-square-bound)

;;; ||T z||^2 <= (||k1||^2 + ||k2||^2) ||z||^2
(define kcb-M2 (list '+ (list 'INTEGRAL kcb-xy kcb-ps kcb-rho (kcb-ksq 'k1))
                        (list 'INTEGRAL kcb-xy kcb-ps kcb-rho (kcb-ksq 'k2))))
(define (kcb-ipx sd a b) (list (list 'IP (kcb-H sd)) a b))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k1 k2 z_)
   (append kcb-hyps (list (list 'IN 'z_ (list 'VEC (kcb-H kcb-Y)))))
   (list '<= (kcb-ipx kcb-X (kcb-Ta 'z_) (kcb-Ta 'z_)) (list '* kcb-M2 (kcb-ipx kcb-Y 'z_ 'z_))))))
(dk-peel!)
(kcb-base!)
(kcb-prod-base!)
(let* ((fz (kcb-rep! kcb-Y 'z_)) (f1 (car fz)) (f2 (cdr fz))
       (P (kcb-c1 f1 f2)) (Q (kcb-c2 f1 f2))
       (I (lambda (sd f) (list 'INTEGRAL (car sd) (cadr sd) (caddr sd) (kcb-sq f (car sd)))))
       (R (lambda (sd f) (list 'RINTEGRAL (car sd) (cadr sd) (caddr sd) (kcb-sq f (car sd)))))
       (c (list '+ (I kcb-Y f1) (I kcb-Y f2)))
       (S1 (kcb-S 'k1)) (S2 (kcb-S 'k2))
       (h (list 'PTWISE-EPLUS 'xs S1 S2))
       (ih (list 'INTEGRAL 'xs 'cA 'mu h)))
  (subst (list '= 'z_ (kcb-pr kcb-Y f1 f2)))
  (subst (dk-cite! 'cl2-int-op-classes 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 f1 f2))
  (kcb-in! kcb-X P) (kcb-in! kcb-X Q)
  (subst (apply dk-cite! (append (list 'cl2-hilbert-ip-self) kcb-X (list P Q))))
  (subst (apply dk-cite! (append (list 'cl2-hilbert-ip-self) kcb-Y (list f1 f2))))
  (for-each (lambda (sd f)
              (dk-split! (apply dk-cite! (append (list 'l2-square-integral) sd (list f))))
              (subst (list '= (R sd f) (I sd f))))
            (list kcb-X kcb-X kcb-Y kcb-Y) (list P Q f1 f2))
  ;; the constants
  (for-each (lambda (f) (fact 'integral-in 'ys 'cB 'nu (kcb-sq f 'ys)) (fact 'rr-pos-star-nonneg (I kcb-Y f))) (list f1 f2))
  (fact 'rr-add-in-rr (I kcb-Y f1) (I kcb-Y f2))
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 0 (I kcb-Y f1)) (list '<= 0 (I kcb-Y f2)))))
  ;; the sections' integrals S_j: measurable, nonnegative, with int S_j = ||k_j||^2
  (for-each (lambda (k S)
              (dk-split! (dk-cite! 'l2-out kcb-xy kcb-ps kcb-rho k))
              (dk-split! (dk-cite! 'l2-square-integral kcb-xy kcb-ps kcb-rho k))
              (fact 'integral-in kcb-xy kcb-ps kcb-rho (kcb-ksq k))
              (dk-split! (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu (kcb-ksq k)))
              (dk-cite! 'x-section-integral-type 'xs 'cA 'ys 'cB 'nu (kcb-ksq k))
              (let ((sp (dk-split! (dk-cite! 'l2-sections-ae 'xs 'cA 'mu 'ys 'cB 'nu k))))
                #t))
            '(k1 k2) (list S1 S2))
  (let* ((j1 (list 'INTEGRAL 'xs 'cA 'mu S1)) (j2 (list 'INTEGRAL 'xs 'cA 'mu S2))
         (p1 (list 'INTEGRAL kcb-xy kcb-ps kcb-rho (kcb-ksq 'k1)))
         (p2 (list 'INTEGRAL kcb-xy kcb-ps kcb-rho (kcb-ksq 'k2))))
    (fact 'measurable-fn-eplus 'xs 'cA S1 S2)
    (let ((ad (dk-cite! 'integral-additive 'xs 'cA 'mu S1 S2)))
      (fact 'rr-pos-star-nonneg p1) (fact 'rr-pos-star-nonneg p2)
      (dk-cite! 'eplus-real-defined p1 p2)
      (dk-cite! 'binplus-apply p1 p2)
      (fact 'rr-add-in-rr p1 p2)
      (dk-have! (list '= ih kcb-M2)
        (lambda ()
          (subst ad)
          (subst (list '= j1 p1)) (subst (list '= j2 p2))
          (subst (list '= (list 'EPLUS p1 p2) (list 'BINPLUS p1 p2)))
          (subst (list '= (list 'BINPLUS p1 p2) kcb-M2))
          (if (kcb-open?) (rfl))))
      (dk-have! (list 'IN ih 'RR) (lambda () (subst (list '= ih kcb-M2)) (if (kcb-open?) (ass))))))
  ;; the pointwise bound off a measurable null set
  (let* ((cs (dk-cite! 'kernel-apply-cschwarz 'xs 'cA 'mu 'ys 'cB 'nu 'k1 'k2 f1 f2))
         (eo (kcb-sk-off! cs)) (e (car eo)) (off (cdr eo))
         (ns (find-first (lambda (q) (equal? q (list 'IS-NULL-SET 'xs 'cA 'mu e))) (dk-asms)))
         (iff (dk-cite! 'is-null-set 'xs 'cA 'mu e))
         (n1 (dk-skolem! (dk-project! (caddr iff) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))
         (subs (let ((siff (dk-cite! 'subset-def e n1)))
                 (dk-have! (caddr siff) (lambda () (keep siff (list 'SUBSET e n1)) (prop)))
                 (caddr siff)))
         (bd (kcb-off 'x 'xs n1 (list 'AND (list '<= (list '+ (list '* (list P 'x) (list P 'x)) (list '* (list Q 'x) (list Q 'x)))
                                                 (list '* (list h 'x) c))
                                        (list 'IN (list h 'x) 'RR)))))
    (dk-have! bd
      (lambda ()
        (let ((w (dk-di-var!)))
          (di)
          (dk-have! (list 'NOT (list 'IN w e))
            (lambda () (di) (dk-apply! subs w)
                    (keep (list 'NOT (list 'IN w n1)) (list 'IN w n1)) (prop)))
          (let ((r (dk-apply! off w))) (if (dk-head-is? r 'AND) (dk-split-all! (list r))))
          (let ((r (find-first (lambda (q) (and (dk-head-is? q 'AND) (dk-contains? q w) (dk-contains? q 'X-SECTION-INTEGRAL))) (dk-asms))))
            (if r (dk-split-all! (list r))))
          (let ((r (find-first (lambda (q) (and (dk-head-is? q 'AND) (dk-contains? q w) (dk-contains? q 'X-SECTION-INTEGRAL))) (dk-asms))))
            (if r (dk-split-all! (list r))))
          (for-each (lambda (S) (fact 'fun-apply-type-c S 'xs 'RR-POS-STAR w)) (list S1 S2))
          (for-each (lambda (S) (fact 'rr-pos-star-nonneg (list S w))) (list S1 S2))
          (let ((hv (dk-cite! 'ptwise-eplus-value 'xs S1 S2 w)))
            (dk-cite! 'eplus-real-defined (list S1 w) (list S2 w))
            (dk-cite! 'binplus-apply (list S1 w) (list S2 w))
            (fact 'rr-add-in-rr (list S1 w) (list S2 w))
            (subst hv)
            (subst (list '= (list 'EPLUS (list S1 w) (list S2 w)) (list 'BINPLUS (list S1 w) (list S2 w))))
            (subst (list '= (list 'BINPLUS (list S1 w) (list S2 w)) (list '+ (list S1 w) (list S2 w))))
            (dk-conj-close! dk-ass!)))))
    (fact 'measurable-fn-eplus 'xs 'cA S1 S2)
    (let ((lb (dk-cite! 'l2-pair-square-bound 'xs 'cA 'mu P Q h c n1)))
      (subst (list '= kcb-M2 ih))
      (if (kcb-open?) (ass)))))
(kcb-qed! 'cl2-int-op-ip-bound)
