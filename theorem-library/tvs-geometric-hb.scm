(define geo-lfon '(IS-LINEAR-FUNCTIONAL-ON m fs f))
(define geo-fon-add '(FORALL x_ (IMPLIES (IN x_ fs) (FORALL y_ (IMPLIES (IN y_ fs) (= (f ((VADD m) x_ y_)) (+ (f x_) (f y_))))))))
(define geo-fon-hom '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ fs) (= (f ((ACT m) r_ x_)) (* r_ (f x_))))))))
(define (geo-fon-parts!)
  (if (not (dk-asm? '(IN f (FUN fs RR))))
      (begin
        (dk-project! '(IN f (FUN fs RR)) 'is-linear-functional-on geo-lfon)
        (dk-project! geo-fon-add 'is-linear-functional-on geo-lfon)
        (dk-project! geo-fon-hom 'is-linear-functional-on geo-lfon))))
(define geo-Kf '(SEP kz_ fs (= (f kz_) 0)))
(define geo-Bf '(SEP bz_ fs (< 0 (f bz_))))
(define (geo-fval! z) (dk-cite! 'fun-apply-type-c 'f 'fs 'RR z))

;; the kernel of f on fs is a submodule
(sp (make-wff (forall-guarded '(m fs f) (append geo-rmod (list geo-fsH geo-lfon)) (list 'IS-SUBMODULE 'm geo-Kf))))
(dk-peel!)
(geo-fon-parts!)
(mac 'is-submodule)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(define (geo-kf-elim! z) (sep-me (dk-ctx-form (list 'IN z geo-Kf))) (dk-split-all!))
(define (geo-kf-intro!) (in-sep! (lambda () (ass)) (lambda () (ass))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'SUBSET) (mac 'subset-def) (let ((z (dk-di-var!))) (geo-kf-elim! z) (geo-fsV! z) (ass)))
        ((dk-head-is? g 'IN)
         (geo-fs-clause 'zero)
         (geo-vtype! geo-z) (geo-real! 0)
         (dk-cite! 'rmod-act-zero 'm geo-z)
         (dk-have! (list 'IN (geo-act 0 geo-z) 'fs) (lambda () (subst (list '= (geo-act 0 geo-z) geo-z)) (ass)))
         (dk-have! (list '= (list 'f geo-z) 0)
           (lambda () (subst (list '= geo-z (geo-act 0 geo-z))) (subst (dk-apply! geo-fon-hom 0 geo-z)) (geo-fval! geo-z) (crs)))
         (geo-kf-intro!))
        (#t
         (let* ((ld (dk-peel!)) (tm (cadr (dk-goal))))
           (cond
             ((equal? (car tm) '(VADD m))
              (let ((x (cadr tm)) (y (caddr tm)))
                (geo-kf-elim! x) (geo-kf-elim! y)
                (dk-apply! (geo-fs-clause 'vadd) x y)
                (dk-have! (list '= (list 'f tm) 0)
                  (lambda () (subst (dk-apply! geo-fon-add x y)) (subst (list '= (list 'f x) 0)) (subst (list '= (list 'f y) 0)) (crs)))
                (geo-kf-intro!)))
             ((equal? (car tm) '(VNEG m))
              (let ((x (cadr tm)))
                (geo-kf-elim! x) (geo-fsV! x)
                (geo-real! '(- 1))
                (let* ((n1 (dk-cite! 'module-act-neg-one 'm x))
                       (n2 (dk-rewrite-h! n1 '(SCAL m) geo-ring))
                       (o1 (dk-cite! 'rr-scalar-ring-one))
                       (n3 (dk-rewrite-h! n2 (list 'ONE geo-ring) 1))
                       (o2 (dk-cite! 'rr-scalar-ring-neg))
                       (n4 (dk-rewrite-h! n3 (list 'NEG geo-ring) (caddr o2))))
                  (dk-lam-b-h! n4))
                (geo-fs-act! '(- 1) x)
                (dk-have! (list 'IN tm 'fs) (lambda () (subst (list '= tm (geo-act '(- 1) x))) (ass)))
                (dk-have! (list '= (list 'f tm) 0)
                  (lambda () (subst (list '= tm (geo-act '(- 1) x))) (subst (dk-apply! geo-fon-hom '(- 1) x)) (subst (list '= (list 'f x) 0)) (crs)))
                (geo-kf-intro!)))
             (#t
              (let* ((r (cadr tm)) (x (caddr tm)))
                (dk-have! (list 'IN r 'RR)
                  (lambda () (dk-rewrite-h! (dk-ctx-form (list 'IN r '(CARR (SCAL m)))) '(SCAL m) geo-ring)
                             (dk-cite! 'rr-scalar-ring-carr)
                             (dk-rewrite-h! (dk-ctx-form (list 'IN r (list 'CARR geo-ring))) (list 'CARR geo-ring) 'RR)
                             (ass)))
                (geo-kf-elim! x)
                (dk-apply! (geo-fs-clause 'act) r x)
                (dk-have! (list '= (list 'f tm) 0)
                  (lambda () (subst (dk-apply! geo-fon-hom r x)) (subst (list '= (list 'f x) 0)) (crs)))
                (geo-kf-intro!)))))))))
  (dk-open-leaves))
(geo-qed! 'kernel-on-submodule)

;; { z in fs : f(z) > 0 } is convex
(sp (make-wff (forall-guarded '(m fs f) (append geo-rmod (list geo-fsH geo-lfon)) (list 'IS-CONVEX-SUBSET 'm geo-Bf))))
(dk-peel!)
(geo-fon-parts!)
(mac 'is-convex-subset)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (mac 'subset-def) (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z geo-Bf))) (dk-split-all!) (geo-fsV! z) (ass)))
        (let* ((ld (dk-peel!))
               (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) geo-Bf))) ld)))
               (x1 (car vs)) (x2 (cadr vs))
               (t (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
               (u (list '- 1 t)))
          (sep-me (dk-ctx-form (list 'IN x1 geo-Bf))) (dk-split-all!)
          (sep-me (dk-ctx-form (list 'IN x2 geo-Bf))) (dk-split-all!)
          (geo-real! u)
          (geo-fs-act! u x1) (geo-fs-act! t x2)
          (let ((comb (geo-add (geo-act u x1) (geo-act t x2))))
            (dk-apply! (geo-fs-clause 'vadd) (geo-act u x1) (geo-act t x2))
            (geo-fval! x1) (geo-fval! x2)
            (let* ((e1 (dk-apply! geo-fon-add (geo-act u x1) (geo-act t x2)))
                   (e2 (dk-apply! geo-fon-hom u x1))
                   (e3 (dk-apply! geo-fon-hom t x2))
                   (p1 (geo-real! (list '* u (list 'f x1)))) (p2 (geo-real! (list '* t (list 'f x2)))))
              (in-sep! (lambda () (ass))
                (lambda ()
                  (subst e1) (subst e2) (subst e3)
                  ;; u f1 + t f2 > 0: both terms >= 0 and not both 0
                  (dk-have! (list '<= 0 u) (lambda () (dk-ineq! (list '<= t 1) (list 'IN t 'RR))))
                  (dk-have! (list '<= 0 (list 'f x1)) (lambda () (dk-ineq! (list '< 0 (list 'f x1)) (list 'IN (list 'f x1) 'RR))))
                  (dk-have! (list '<= 0 (list 'f x2)) (lambda () (dk-ineq! (list '< 0 (list 'f x2)) (list 'IN (list 'f x2) 'RR))))
                  (let* ((h1 (dk-cite! 'mink-rr-scale-le 0 (list 'f x1) u))
                         (h2 (dk-cite! 'mink-rr-scale-le 0 (list 'f x2) t))
                         (z1 (geo-eq! (list '* u 0) 0)) (z2 (geo-eq! (list '* t 0) 0))
                         (h1b (dk-rewrite-h! h1 (list '* u 0) 0)) (h2b (dk-rewrite-h! h2 (list '* t 0) 0))
                         (pa (dk-name! (list '* u (list 'f x1)))) (pb (dk-name! (list '* t (list 'f x2))))
                         (h1c (dk-rewrite-h! h1b (list '* u (list 'f x1)) pa))
                         (h2c (dk-rewrite-h! h2b (list '* t (list 'f x2)) pb)))
                    (subst (list '= (list '* u (list 'f x1)) pa))
                    (subst (list '= (list '* t (list 'f x2)) pb))
                    ;; pa + pb > 0: if t = 0 then pa = f x1 > 0, else pb > 0
                    (use-em (list '= t 0)
                      (lambda ()
                        (dk-have! (list '= pa (list 'f x1))
                          (lambda () (subst (list '= pa (list '* u (list 'f x1)))) (subst (list '= t 0)) (crs)))
                        (dk-ineq! (list '= pa (list 'f x1)) h2c (list '< 0 (list 'f x1)) (list 'IN pa 'RR) (list 'IN pb 'RR) (list 'IN (list 'f x1) 'RR)))
                      (lambda ()
                        (dk-cite! 'dual-rr-pos-of-nonneg-nonzero t)
                        (dk-cite! 'mink-rr-mul-pos t (list 'f x2))
                        (dk-rewrite-h! (dk-ctx-form (list '< 0 (list '* t (list 'f x2)))) (list '* t (list 'f x2)) pb)
                        (dk-ineq! h1c (list '< 0 pb) (list 'IN pa 'RR) (list 'IN pb 'RR)))))))))))))
(geo-qed! 'positive-part-convex)

(define geo-posaf '(FORALL pz_ (IMPLIES (IN pz_ a) (IMPLIES (IN pz_ fs) (< 0 (f pz_))))))
(sp (make-wff (forall-guarded '(m t a fs f)
   (list geo-tvs '(IN a (OPENS t)) '(IS-CONVEX-SUBSET m a) geo-fsH geo-lfon '(FORSOME af_ (AND (IN af_ a) (IN af_ fs))) geo-posaf)
