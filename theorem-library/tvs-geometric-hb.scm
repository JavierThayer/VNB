  (geo-fsV! a1) (geo-fval! a1)
  (dk-apply! geo-posaf a1)
  (dk-cite! 'kernel-on-submodule 'm 'fs 'f)
  (dk-cite! 'positive-part-convex 'm 'fs 'f)
  (dk-project! (list 'SUBSET geo-Bf '(VEC m)) 'is-convex-subset (list 'IS-CONVEX-SUBSET 'm geo-Bf))
  (dk-cite! 'sumset-open 'm 't 'a geo-Bf)
  (dk-cite! 'sumset-convex 'm 'a geo-Bf)
  (dk-have! (list 'IN a1 geo-Bf) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
  ;; c0 = a1 + a1 is in C and in fs, f(c0) = 2 f(a1) > 0
  (geo-vtype! c0) (geo-vtype! (geo-act '(- 1) a1))
  (dk-apply! (geo-fs-clause 'vadd) a1 a1)
  (dk-cite! 'rmod-vadd-assoc 'm a1 a1 (geo-act '(- 1) a1))
  (dk-cite! 'rmod-add-neg 'm a1)
  (dk-cite! 'rmod-vzero-right 'm a1)
  (dk-have! (list 'IN (geo-add c0 (geo-act '(- 1) a1)) 'a)
    (lambda () (subst (list '= (geo-add c0 (geo-act '(- 1) a1)) (geo-add a1 (geo-add a1 (geo-act '(- 1) a1)))))
               (subst (list '= (geo-add a1 (geo-act '(- 1) a1)) geo-z))
               (subst (list '= (geo-add a1 geo-z) a1)) (ass)))
  (dk-have! (list 'IN c0 cs) (lambda () (geo-ss-intro! c0 a1 'a geo-Bf)))
  (geo-fval! c0)
  (dk-have! (list '= (list 'f c0) (list '+ fa1 fa1)) (lambda () (subst (dk-apply! geo-fon-add a1 a1)) (geo-real! (list '+ fa1 fa1)) (rfl)))
  ;; C misses the kernel K
  (dk-have! (list 'FORALL 'dz_ (list 'IMPLIES (list 'IN 'dz_ geo-Kf) (list 'NOT (list 'IN 'dz_ cs))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (geo-kf-elim! x) (geo-fsV! x)
        (di)
        (let* ((z (geo-ss-elim! x 'a geo-Bf)))
          (sep-me (dk-ctx-form (list 'IN z geo-Bf))) (dk-split-all!)
          (geo-fs-act! '(- 1) z)
          (dk-apply! (geo-fs-clause 'vadd) x (geo-act '(- 1) z))
          (let* ((xz (geo-add x (geo-act '(- 1) z)))
                 (p (dk-apply! geo-posaf xz))
                 (e1 (dk-apply! geo-fon-add x (geo-act '(- 1) z)))
                 (e2 (dk-apply! geo-fon-hom '(- 1) z)))
            (geo-fval! z) (geo-fval! x) (geo-fval! xz) (geo-fval! (geo-act '(- 1) z))
            (dk-absurd! p e1 e2 (list '= (list 'f x) 0) (list '< 0 (list 'f z)) (list 'IN (list 'f z) 'RR) (list 'IN (list 'f x) 'RR)
                        (list 'IN (list 'f xz) 'RR) (list 'IN (list 'f (geo-act '(- 1) z)) 'RR)))))))
  (dk-have! (list 'FORSOME 'sa0_ (list 'IN 'sa0_ cs)) (lambda () (ew c0) (ass)))
  (let* ((g0 (dk-skolem! (dk-cite! 'closed-hyperplane-through-subspace 'm 't cs geo-Kf) #t))
         (missc (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cs) (dk-contains? f 'FKER))) (dk-asms)))
         (kin (dk-ctx-form (list 'SUBSET geo-Kf (list 'FKER 'm g0))))
         (gadd (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
                                (list '= (list g0 '((VADD m) x_ y_)) (list '+ (list g0 'x_) (list g0 'y_)))))))
                            'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm g0)))
         (ghom (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m))
                                (list '= (list g0 '((ACT m) r_ x_)) (list '* 'r_ (list g0 'x_)))))))
                            'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm g0)))
         (g0f (dk-project! (list 'IN g0 '(FUN (VEC m) RR)) 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm g0))))
    (define (g0val! x) (dk-cite! 'fun-apply-type-c g0 '(VEC m) 'RR x))
    (g0val! c0)
    ;; g0 does not vanish on C
    (define (g0-nz! c)   ; c in C: land NOT (g0 c = 0)
      (g0val! c)
      (dk-have! (list 'NOT (list '= (list g0 c) 0))
        (lambda () (di) (dk-apply! missc c)
                   (dk-have! (list 'IN c (list 'FKER 'm g0)) (lambda () (mac 'fker-membership) (dk-conj-close! (lambda () (ass)))))
                   (ai (list 'NOT (list 'IN c (list 'FKER 'm g0)))))))
    (g0-nz! c0)
    (let* ((fc (dk-name! (list 'f c0)))
