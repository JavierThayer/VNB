(dk-peel!)
(geo-tvs-parts!)
(geo-fon-parts!)
(geo-fs-clause 'sub) (geo-fs-clause 'vadd) (geo-fs-clause 'act)
(geo-real! '(- 1)) (geo-real! 0) (geo-real! 1)
(let* ((a1 (dk-skolem! (dk-ctx-form '(FORSOME af_ (AND (IN af_ a) (IN af_ fs)))) #t))
       (fa1 (list 'f a1))
       (cs (geo-ss 'a geo-Bf))
