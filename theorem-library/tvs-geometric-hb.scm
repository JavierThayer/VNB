                  (dk-have! (list 'IN gc 'RR) (lambda () (subst gv) (ass)))
                  (dk-have! (list 'NOT (list '= gc 0))
                    (lambda () (di) (dk-rewrite-h! (dk-ctx-form (list '= gc 0)) gc (list '* q2 (list g0 c)))
                               (back! c)
                               (dk-have! (list '= (list g0 c) 0)
                                 (lambda () (subst (list '= (list g0 c) (list '* lm (list '* q2 (list g0 c)))))
                                            (subst (list '= (list '* q2 (list g0 c)) 0)) (crs)))
                               (ai (list 'NOT (list '= (list g0 c) 0)))))
                  (dk-cite! 'rr-lt-trichotomy gc 0)
                  (use-em (list '< 0 gc)
                    (lambda () (ass))
                    (lambda ()
                      (dk-have! (list '< gc 0)
                        (lambda () (dk-only! (dk-ctx-form (list 'OR (list '< gc 0) (list 'OR (list '= gc 0) (list '< 0 gc))))
                                             (list 'NOT (list '< 0 gc)) (list 'NOT (list '= gc 0)))
                                   (prop)))
                      (let* ((dd (list '- fv gc)))
                        (geo-real! dd)
                        (dk-have! (list '< 0 dd) (lambda () (dk-ineq! (list '< gc 0) (list 'IN gc 'RR))))
                        (geo-nz-of-pos! dd)
                        (let* ((rd (geo-recip! dd)) (tt rd) (ut (list '- 1 tt)))
                          (dk-cite! 'rr-recip-pos dd)
                          (dk-have! (list '< 0 rd) (lambda () (subst (list '= rd (list 'recip dd))) (ass)))
                          (geo-real! tt) (geo-real! ut)
                          (dk-have! (list '= ut (list '* (list '- gc) rd))
                            (lambda () (subst (list '= 1 (list '* dd rd))) (crs)))
                          (geo-real! (list '- gc))
                          (dk-have! (list '< 0 (list '- gc)) (lambda () (dk-ineq! (list '< gc 0) (list 'IN gc 'RR))))
                          (dk-cite! 'mink-rr-mul-pos (list '- gc) rd)
                          (geo-real! (list '* (list '- gc) rd))
                          (dk-have! (list '<= 0 tt) (lambda () (dk-ineq! (list '< 0 tt) (list 'IN tt 'RR))))
                          (dk-have! (list '<= tt 1) (lambda () (dk-ineq! (list '= ut (list '* (list '- gc) rd)) (list '< 0 (list '* (list '- gc) rd))
                                                                         (list 'IN tt 'RR) (list 'IN (list '* (list '- gc) rd) 'RR))))
                          (let* ((p (geo-add (geo-act ut a0) (geo-act tt c)))
                                 (mp (dk-apply! cvc a0 c tt)))
                            (geo-vtype! p)
                            (dk-have! (list '= (list gfn p) 0)
                              (lambda ()
                                (let ((lf (dk-ctx-form (list 'IS-LINEAR-FUNCTIONAL 'm gfn))))
                                  (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
                                                  (list '= (list gfn '((VADD m) x_ y_)) (list '+ (list gfn 'x_) (list gfn 'y_)))))))
                                               'is-linear-functional lf)
                                  (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m))
                                                  (list '= (list gfn '((ACT m) r_ x_)) (list '* 'r_ (list gfn 'x_)))))))
                                               'is-linear-functional lf)
                                  (subst (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
                                                  (list '= (list gfn '((VADD m) x_ y_)) (list '+ (list gfn 'x_) (list gfn 'y_))))))))
                                                    (geo-act ut a0) (geo-act tt c)))
                                  (let ((hc (dk-ctx-form (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m))
                                                  (list '= (list gfn '((ACT m) r_ x_)) (list '* 'r_ (list gfn 'x_))))))))))
                                    (subst (dk-apply! hc ut a0))
                                    (subst (dk-apply! hc tt c)))
                                  (subst (list '= gc0 fv))
                                  (subst (list '= ut (list '* (list '- gc) rd)))
                                  (subst (geo-eq! (list '+ (list '* (list '* (list '- gc) rd) fv) (list '* rd gc)) 0))
                                  (rfl))))
                            (dk-apply! missc p)
                            (dk-have! (list 'IN p (list 'FKER 'm g0))
                              (lambda () (subst (list '= (list 'FKER 'm g0) (list 'FKER 'm gfn)))
                                         (mac 'fker-membership) (dk-conj-close! (lambda () (ass)))))
                            (ai (list 'NOT (list 'IN p (list 'FKER 'm g0)))))))))))))
          (dk-have! (list 'SUBSET 'fs (list 'FKER 'm gfn))
            (lambda () (subst (list '= (list 'FKER 'm gfn) (list 'FKER 'm g0))) (ass)))
          (ew gfn)
          (dk-conj-close! (lambda () (ass))))))))
(geo-qed! 'positive-functional-vanishing-on-subspace)
