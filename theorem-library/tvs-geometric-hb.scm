;;; geo.scm -- topological-vector-space.pdf TB-2a (geometric Hahn-Banach): Cor 2.15, Prop 2.13, Prop 2.12, Cor 2.14, by the
;;; ANALYTIC route -- the gauge of an open convex set and the sublinear Hahn-Banach -- instead of the notes'
;;; (maximal subspaces by Zorn, the closure of H, quotients E/H, connectedness of E \ {0}), which needs CLOSURE
;;; and boundary heads.  Agent DUAL-FIX, 2026-10-26.  DESTINATION: theorem-library/tvs-geometric-hb.scm.
;;; Library: analysis.  Helper prefix: geo-.
;;; Needs: TB-01 (IS-TVS, SEMINORM-TOP, ...), tvs-minkowski (REVISED, scratchpad/tb2a/minkowski.scm: the gauge
;;; lemmas for a convex absorbing set containing 0), tvs-seminorm-extension (rmod-vadd-*), tvs-kernel-closed
;;; (top-open-of-local, tvs-*-open, rr-abs-*), hahn-banach-sublinear, RA-BASICS (INF).
;;; Cor 2.14 (extend-positive-functional) adds the hypothesis that A meets F; the case f = 0 (A and F disjoint) is
;;; positive-functional-vanishing-on-subspace.  As written in the notes (A nonempty, f > 0 on A meet F) the statement
;;; is false: E = R^2, F = the x-axis, f(x, 0) = x, A = {y > 0}; A meet F is empty, and no g = x + c y is > 0 on A.

(define (geo-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; GEO OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (geo-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (geo-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (geo-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define (geo-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((and (pair? t) (= (length t) 2) (eq? (car t) 'f)) (geo-vtype! (cadr t))
           (dk-cite! 'fun-apply-type-c 'f '(VEC m) 'RR (cadr t)) ty)
          ((dk-head-is? t 'abs) (geo-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (geo-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (geo-real! (cadr t)) (geo-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((dk-head-is? t 'recip) (geo-real! (cadr t))
           (geo-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (dk-cite! 'rr-recip-closed (cadr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (geo-real! (cadr t)) (geo-real! (caddr t))
           (geo-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))
(define (geo-vtype! t)
  (let ((ty (list 'IN t '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((equal? t '(VZERO m)) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (geo-real! (cadr t)) (geo-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (geo-vtype! (cadr t)) (geo-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VNEG m)))
           (geo-vtype! (cadr t)) (dk-cite! 'module-vneg-type 'm (cadr t)) ty)
          (#t (error "geo-vtype!: no typing for" t)))))

(define geo-rv '(NORMED-VECTOR-SPACE-AS-MODULE RR-NVS))
(define geo-ix '(PAIR 0 0))
(define geo-pf '(VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS)))
(define geo-rt (list 'SEMINORM-TOP geo-rv geo-ix geo-pf))

(define geo-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define geo-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define geo-addc
  (forall-guarded '(tvx_ tvy_ tvu_)
    '((IN tvx_ (VEC m)) (IN tvy_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((VADD m) tvx_ tvy_) tvu_))
    '(FORSOME tvv_ (AND (IN tvv_ (OPENS t)) (AND (IN tvx_ tvv_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvy_ tvw_)
         (FORALL tva_ (IMPLIES (IN tva_ tvv_) (FORALL tvb_ (IMPLIES (IN tvb_ tvw_)
           (IN ((VADD m) tva_ tvb_) tvu_)))))))))))))
(define geo-scalc
  (forall-guarded '(tvr_ tvx_ tvu_)
    '((IN tvr_ (CARR (SCAL m))) (IN tvx_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((ACT m) tvr_ tvx_) tvu_))
    '(FORSOME tvd_ (AND (POS-RR tvd_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvx_ tvw_)
         (FORALL tvs_ (IMPLIES (IN tvs_ (CARR (SCAL m)))
           (IMPLIES (< ((FNRM RR-NORMED-FIELD) ((ADD (SCAL m)) tvs_ ((NEG (SCAL m)) tvr_))) tvd_)
             (FORALL tva_ (IMPLIES (IN tva_ tvw_) (IN ((ACT m) tvs_ tva_) tvu_)))))))))))))
(define (geo-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs geo-tvs)
        (dk-project! (list '= '(SCAL m) geo-ring) 'is-tvs geo-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs geo-tvs)
        (dk-project! geo-addc 'is-tvs geo-tvs)
        (dk-project! geo-scalc 'is-tvs geo-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs geo-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t)))))
(define (geo-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) geo-ring)) (mac 'rr-scalar-ring-carr) (ass))))
    ty))
;; a1 in w, w open  =>  a1 in VEC m
(define (geo-open-pt! w a1)
  (let ((ty (list 'IN a1 '(VEC m))))
    (if (not (dk-asm? ty))
        (begin
          (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) w)
          (dk-cite! 'power-mem-in '(PTS t) w a1)
          (dk-rewrite-h! (list 'IN a1 '(PTS t)) '(PTS t) '(VEC m))))
    ty))
(define (geo-pts! a1)   ; a1 in VEC m  =>  a1 in PTS t
  (let ((ty (list 'IN a1 '(PTS t))))
    (if (not (dk-asm? ty)) (dk-have! ty (lambda () (subst '(= (PTS t) (VEC m))) (ass))))
    ty))

(define (geo-trans w x0) (list 'SEP 'trx_ '(VEC m) (list 'IN (list '(VADD m) 'trx_ (list '(ACT m) '(- 1) x0)) w)))
(define (geo-loc-of a) (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ a)
                         (list 'FORSOME 'tlw_ (list 'AND '(IN tlw_ (OPENS t)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ a)))))))
(define (geo-sub-pts! a)   ; a = (SEP v (VEC m) ..): SUBSET a (PTS t)
  (dk-have! (list 'SUBSET a '(PTS t))
    (lambda () (mac 'subset-def)
               (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z a))) (dk-split-all!) (geo-pts! z) (ass)))))
(define (geo-dil c w) (list 'SEP 'scx_ '(VEC m) (list 'IN (list '(ACT m) c 'scx_) w)))
(define geo-lf '(IS-LINEAR-FUNCTIONAL m f))
(define geo-fadd '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m)) (= (f ((VADD m) x_ y_)) (+ (f x_) (f y_))))))))
(define geo-fhom '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (= (f ((ACT m) r_ x_)) (* r_ (f x_))))))))
(define (geo-lf-parts!)
  (if (not (dk-asm? '(IN f (FUN (VEC m) RR))))
      (begin
        (dk-project! '(IN f (FUN (VEC m) RR)) 'is-linear-functional geo-lf)
        (dk-project! geo-fadd 'is-linear-functional geo-lf)
        (dk-project! geo-fhom 'is-linear-functional geo-lf))))
;; name recip(c) for c /= 0: lands v in RR, c * v = 1; returns v
(define (geo-recip! c)
  (geo-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (dk-cite! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-inverse c)
  (let ((v (dk-name! (list 'recip c))))
    (dk-have! (list '= (list '* c v) 1) (lambda () (subst (list '= v (list 'recip c))) (ass)))
    v))
(define (geo-nz-of-pos! c)
  (let ((f (list 'NOT (list '= c 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-rewrite-h! (dk-ctx-form (list '< 0 c)) c 0)
                               (dk-cite! 'rr-zero-in) (dk-cite! 'rr-lt-irrefl 0) (ai '(NOT (< 0 0))))))
    f))


;;; =====================================================================
;;; (1) SHIFTS OF OPEN CONVEX SETS; THE GAUGE OF AN OPEN CONVEX SET CONTAINING 0
;;; =====================================================================
(define (geo-sh a x0) (list 'SEP 'shy_ '(VEC m) (list 'IN (list '(VADD m) 'shy_ x0) a)))
(define geo-z '(VZERO m))
(define (geo-act r x) (list '(ACT m) r x))
(define (geo-add x y) (list '(VADD m) x y))

;; A - x0 = { y : y + x0 in A } is open
(sp (make-wff (forall-guarded '(m t a x0) (list geo-tvs '(IN a (OPENS t)) '(IN x0 (VEC m)))
                              (list 'IN (geo-sh 'a 'x0) '(OPENS t)))))
(dk-peel!)
(geo-tvs-parts!)
(let* ((c (geo-sh 'a 'x0)))
  (geo-sub-pts! c)
  (dk-have! (geo-loc-of c)
    (lambda ()
      (let ((z (dk-di-var!)))
        (sep-me (dk-ctx-form (list 'IN z c)))
        (dk-split-all!)
        (let* ((ex (dk-apply! geo-addc z 'x0 'a))
               (v1 (dk-skolem! ex #t))
               (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_) (dk-contains? f v1))) (dk-asms)))
               (v2 (dk-skolem! ex2 #t))
               (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v1) (dk-contains? f v2))) (dk-asms))))
          (ew v1)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (mac 'subset-def)
                    (let ((a1 (dk-di-var!)))
                      (geo-open-pt! v1 a1)
                      (in-sep! (lambda () (ass))
                               (lambda () (dk-apply! cl a1 'x0) (dk-ass!))))))))))))
  (dk-cite! 'top-open-of-local 't c)
  (ass))
(geo-qed! 'tvs-shift-open)

;; A - x0 is convex when A is
(define geo-cvx-of
  (lambda (a) (list 'FORALL 'sxa_ (list 'IMPLIES (list 'IN 'sxa_ a) (list 'FORALL 'sxb_ (list 'IMPLIES (list 'IN 'sxb_ a)
     (list 'FORALL 'sxt_ (list 'IMPLIES '(IN sxt_ RR) (list 'IMPLIES '(<= 0 sxt_) (list 'IMPLIES '(<= sxt_ 1)
       (list 'IN '((VADD m) ((ACT m) (- 1 sxt_) sxa_) ((ACT m) sxt_ sxb_)) a)))))))))))
(define geo-rmod (list '(IS-MODULE m) (list '= '(SCAL m) geo-ring)))
(sp (make-wff (forall-guarded '(m a x0) (append geo-rmod (list '(IS-CONVEX-SUBSET m a) '(IN x0 (VEC m))))
                              (list 'IS-CONVEX-SUBSET 'm (geo-sh 'a 'x0)))))
(dk-peel!)
(let* ((c (geo-sh 'a 'x0))
       (cv (dk-project! (geo-cvx-of 'a) 'is-convex-subset '(IS-CONVEX-SUBSET m a))))
  (mac 'is-convex-subset)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin (mac 'subset-def) (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z c))) (dk-split-all!) (ass)))
          (let* ((ld (dk-peel!))
                 (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) c))) ld)))
                 (a1 (car vs)) (b1 (cadr vs))
                 (t (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
                 (u (list '- 1 t)))
            (sep-me (dk-ctx-form (list 'IN a1 c))) (dk-split-all!)
            (sep-me (dk-ctx-form (list 'IN b1 c))) (dk-split-all!)
            (geo-real! u)
            (let* ((ax (geo-add a1 'x0)) (bx (geo-add b1 'x0))
                   (m0 (dk-apply! cv ax bx t))
                   (e1 (dk-cite! 'rmod-act-distrib 'm u a1 'x0))
                   (m1 (dk-rewrite-h! m0 (geo-act u ax) (geo-add (geo-act u a1) (geo-act u 'x0))))
                   (e2 (dk-cite! 'rmod-act-distrib 'm t b1 'x0))
                   (m2 (dk-rewrite-h! m1 (geo-act t bx) (geo-add (geo-act t b1) (geo-act t 'x0))))
                   (ty (for-each geo-vtype! (list (geo-act u a1) (geo-act u 'x0) (geo-act t b1) (geo-act t 'x0))))
                   (e3 (dk-cite! 'rmod-vadd-swap 'm (geo-act u a1) (geo-act u 'x0) (geo-act t b1) (geo-act t 'x0)))
                   (m3 (dk-rewrite-h! m2 (cadr e3) (caddr e3)))
                   (e4 (dk-cite! 'rmod-act-add 'm u t 'x0))
                   (m4 (dk-rewrite-h! m3 (caddr e4) (cadr e4)))
                   (e5 (geo-eq! (list '+ u t) 1))
                   (m5 (dk-rewrite-h! m4 (list '+ u t) 1))
                   (e6 (dk-cite! 'rmod-act-one 'm 'x0))
                   (m6 (dk-rewrite-h! m5 (geo-act 1 'x0) 'x0))
                   (cmb (geo-add (geo-act u a1) (geo-act t b1))))
              (geo-vtype! cmb)
              (in-sep! (lambda () (ass)) (lambda () (ass)))))))))
(geo-qed! 'convex-shift)

;; an open set containing 0 is absorbing
(sp (make-wff (forall-guarded '(m t w) (list geo-tvs '(IN w (OPENS t)) (list 'IN geo-z 'w))
                              '(IS-ABSORBING-SUBSET m w))))
(dk-peel!)
(geo-tvs-parts!)
(mac 'is-absorbing-subset)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (mac 'subset-def) (let ((z (dk-di-var!))) (geo-open-pt! 'w z) (ass)))
        (let* ((x (dk-di-var!)))
          (geo-real! 0)
          (dk-cite! 'rmod-act-zero 'm x)
          (dk-have! (list 'IN (geo-act 0 x) 'w) (lambda () (subst (list '= (geo-act 0 x) geo-z)) (ass)))
          (let* ((ex (dk-cite! 'tvs-scal-cont-rr 'm 't 0 x 'w))
                 (d (dk-skolem! ex 'top))
                 (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tsw_))) (dk-asms)))
                 (w2 (dk-skolem! ex2 #t))
                 (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tss_))) (dk-asms)))
                 (s (list '* 1/2 d)))
            (dk-cite! 'rr-pos-rr-in-rr d)
            (dk-cite! 'rr-lt-of-pos-rr d)
            (geo-real! s)
            (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
            (geo-real! (list '- s 0)) (geo-real! (list 'abs (list '- s 0)))
            (dk-have! (list '< (list 'abs (list '- s 0)) d)
              (lambda () (subst (geo-eq! (list '- s 0) s))
                         (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s) (list 'IN s 'RR))))
                         (subst (dk-cite! 'rr-abs-of-nonneg s))
                         (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
            (let* ((y (geo-act s x))
                   (my (dk-apply! cl s x))
                   (q (begin (geo-nz-of-pos! s) (geo-recip! s))))
              (geo-real! q)
              (dk-cite! 'rr-recip-pos s)
              (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip s))) (ass)))
              (ew q)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew y)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (geo-vtype! y)
                                  (geo-subst-rev! (dk-cite! 'rmod-act-mul 'm q s x))
                                  (dk-have! (list '= (list '* q s) 1) (lambda () (subst (geo-eq! (list '* q s) (list '* s q))) (ass)))
                                  (subst (list '= (list '* q s) 1))
                                  (subst (dk-cite! 'rmod-act-one 'm x))
                                  (rfl)))))))))))))))
(geo-qed! 'tvs-open-zero-absorbing)

(define geo-gh (list geo-tvs '(IN w (OPENS t)) '(IS-CONVEX-SUBSET m w) (list 'IN geo-z 'w)))
(define (geo-gparts!)
  (geo-tvs-parts!)
  (if (not (dk-asm? '(IS-ABSORBING-SUBSET m w))) (dk-cite! 'tvs-open-zero-absorbing 'm 't 'w)))
(define (geo-S x) (list 'MINK-SET 'm 'w x))
(define (geo-I x) (list 'INF (geo-S x)))
(define (geo-glb! x)   ; land INF S(x) in RR and its two clauses; return (lower . greatest)
  (geo-vtype! x)
  (if (not (dk-asm? (list 'IN (geo-I x) 'RR))) (dk-split! (dk-cite! 'mink-set-glb 'm 'w x)))
  (cons (dk-ctx-form (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (geo-S x)) (list '<= (geo-I x) 'lbw_))))
        (dk-ctx-form (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR)
                       (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (geo-S x)) '(<= lbb_ lbw_)))
                             (list '<= 'lbb_ (geo-I x))))))))

;; the gauge is < 1 on the open set
(sp (make-wff (forall-guarded '(m t w x) (append geo-gh '((IN x w))) (list '< (geo-I 'x) 1))))
(dk-peel!)
(geo-gparts!)
(geo-open-pt! 'w 'x)
(geo-real! 1)
(dk-cite! 'rmod-act-one 'm 'x)
(dk-have! (list 'IN (geo-act 1 'x) 'w) (lambda () (subst (list '= (geo-act 1 'x) 'x)) (ass)))
(let* ((ex (dk-cite! 'tvs-scal-cont-rr 'm 't 1 'x 'w))
       (d (dk-skolem! ex 'top))
       (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tsw_))) (dk-asms)))
       (w2 (dk-skolem! ex2 #t))
       (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tss_))) (dk-asms)))
       (s (list '+ 1 (list '* 1/2 d))))
  (dk-cite! 'rr-pos-rr-in-rr d)
  (dk-cite! 'rr-lt-of-pos-rr d)
  (geo-real! s) (geo-real! (list '- s 1)) (geo-real! (list 'abs (list '- s 1)))
  (dk-have! (list '< (list 'abs (list '- s 1)) d)
    (lambda () (subst (geo-eq! (list '- s 1) (list '* 1/2 d)))
               (geo-real! (list '* 1/2 d))
               (dk-have! (list '<= 0 (list '* 1/2 d)) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
               (subst (dk-cite! 'rr-abs-of-nonneg (list '* 1/2 d)))
               (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
  (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
  (dk-have! (list '< 1 s) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
  (let* ((my (dk-apply! cl s 'x))
         (y (geo-act s 'x))
         (q (begin (geo-nz-of-pos! s) (geo-recip! s))))
    (dk-cite! 'rr-recip-pos s)
    (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip s))) (ass)))
    (geo-vtype! y)
    (dk-have! (list '= 'x (geo-act q y))
      (lambda ()
        (geo-subst-rev! (dk-cite! 'rmod-act-mul 'm q s 'x))
        (subst (geo-eq! (list '* q s) (list '* s q)))
        (subst (list '= (list '* s q) 1))
        (subst (dk-cite! 'rmod-act-one 'm 'x))
        (rfl)))
    (dk-cite! 'mink-set-intro 'm 'w 'x q y)
    (let* ((gl (geo-glb! 'x))
           (h1 (dk-apply! (car gl) q)))
      (geo-and! (list '< 0 q) (list '< 1 s))
      (let* ((h2 (dk-cite! 'rr-lt-scale-pos q 1 s))
             (e1 (geo-eq! (list '* q 1) q))
             (h3 (dk-rewrite-h! h2 (list '* q 1) q))
             (e2 (geo-eq! (list '* q s) (list '* s q)))
             (h4 (dk-rewrite-h! h3 (list '* q s) (list '* s q)))
             (h5 (dk-rewrite-h! h4 (list '* s q) 1)))
        (dk-ineq! h1 h5 (list 'IN (geo-I 'x) 'RR) (list 'IN q 'RR))))))
(geo-qed! 'gauge-lt-one-on-open)

;; the gauge is >= 1 off the set
(sp (make-wff (forall-guarded '(m t w x) (append geo-gh (list '(IN x (VEC m)) '(NOT (IN x w)))) (list '<= 1 (geo-I 'x)))))
(dk-peel!)
(geo-gparts!)
(geo-real! 1)
(let ((gl (geo-glb! 'x))
      (lbf (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (geo-S 'x)) '(<= 1 lbw_)))))
  (dk-have! lbf
    (lambda ()
      (let* ((r (dk-di-var!))
             (c (dk-cite! 'mink-set-elim 'm 'w 'x r)))
        (dk-split! c)
        (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'mky_))) (dk-asms)))
               (y (dk-skolem! ex #t)))
          (use-em (list '<= 1 r)
            (lambda () (ass))
            (lambda ()
              (dk-cite! 'rr-not-le-lt 1 r)
              (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
              (dk-have! (list '<= r 1) (lambda () (dk-ineq! (list '< r 1) (list 'IN r 'RR))))
              (let* ((m1 (dk-cite! 'mink-scale-in 'm 'w y r))
                     (m2 (dk-rewrite-h! m1 (geo-act r y) 'x)))
                (ai (list 'NOT (list 'IN 'x 'w))))))))))
  (dk-apply! (cdr gl) 1)
  (ass))
(geo-qed! 'gauge-ge-one-off-set)

;; the gauge is sublinear
(define geo-p '(MINKOWSKI-FUNCTIONAL m w))
(define (geo-pval! z)
  (geo-vtype! z)
  (dk-cite! 'mink-value 'm 'w z)
  (subst (list '= (list geo-p z) (geo-I z))))
(sp (make-wff (forall-guarded '(m t w) geo-gh (list 'IS-SUBLINEAR 'm geo-p))))
(dk-peel!)
(geo-gparts!)
(dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
(mac 'is-sublinear)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IN)
         (mac 'MINKOWSKI-FUNCTIONAL)
         (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (geo-glb! v) (ass))) (lambda () (ass))))
        (#t
         (dk-peel!)
         (let ((g2 (dk-goal)))
           (if (dk-head-is? g2 '<=)
               (let* ((xy (cadr (cadr g2))) (a (cadr xy)) (b (caddr xy)))
                 (for-each geo-pval! (list xy a b))
                 (dk-cite! 'mink-inf-subadditive 'm 'w a b) (ass))
               (let* ((ax (cadr (cadr g2))) (c (cadr ax)) (z (caddr ax)))
                 (geo-pval! ax) (geo-pval! z)
                 (geo-glb! z)
                 (use-em (list '= c 0)
                   (lambda ()
                     (subst (list '= c 0))
                     (subst (dk-cite! 'rmod-act-zero 'm z))
                     (subst (dk-cite! 'mink-inf-zero 'm 'w))
                     (subst (geo-eq! (list '* 0 (geo-I z)) 0))
                     (geo-real! 0)
                     (rfl))
                   (lambda ()
                     (dk-cite! 'dual-rr-pos-of-nonneg-nonzero c)
                     (dk-cite! 'mink-inf-scale 'm 'w z c)
                     (ass))))))))))
  (dk-open-leaves))
(geo-qed! 'gauge-sublinear)

;;; =====================================================================
;;; (2) THE LINE THROUGH A NONZERO VECTOR AND ITS COEFFICIENT FUNCTIONAL
;;; =====================================================================
(define geo-nz '(NOT (= v (VZERO m))))
;; cancellation: a.v = b.v, v /= 0  =>  a = b
(sp (make-wff (forall-guarded '(m v a b) (append geo-rmod (list '(IN v (VEC m)) geo-nz '(IN a RR) '(IN b RR)
                                                                  '(= ((ACT m) a v) ((ACT m) b v))))
                              '(= a b))))
(dk-peel!)
(use-em '(= a b)
  (lambda () (ass))
  (lambda ()
    (let* ((c '(- a b)) (mb '(- b)))
      (geo-real! c) (geo-real! mb)
      (dk-have! (list 'NOT (list '= c 0))
        (lambda () (di) (dk-have! '(= a b) (lambda () (dk-ineq! (list '= c 0) '(IN a RR) '(IN b RR)))) (ai '(NOT (= a b)))))
      (let* ((e1 (dk-cite! 'rmod-act-add 'm 'a mb 'v))
             (e0 (geo-eq! (list '+ 'a mb) c))
             (e2 (dk-rewrite-h! e1 (list '+ 'a mb) c))
             (e3 (dk-rewrite-h! e2 (geo-act 'a 'v) (geo-act 'b 'v)))
             (e4 (dk-cite! 'rmod-act-add 'm 'b mb 'v))
             (e5 (dk-rewrite-h! e3 (caddr e4) (cadr e4)))
             (e6 (geo-eq! (list '+ 'b mb) 0))
             (e7 (dk-rewrite-h! e5 (list '+ 'b mb) 0))
             (e8 (dk-cite! 'rmod-act-zero 'm 'v))
             (e9 (dk-rewrite-h! e7 (geo-act 0 'v) geo-z))
             (r1 (dk-cite! 'rmod-act-recip-cancel-nz 'm c 'v))
             (r2 (dk-rewrite-h! r1 (geo-act c 'v) geo-z))
             (r3 (begin (geo-real! (list 'recip c)) (dk-cite! 'rmod-act-vzero 'm (list 'recip c))))
             (r4 (dk-rewrite-h! r2 (geo-act (list 'recip c) geo-z) geo-z)))
        (dk-have! '(= v (VZERO m)) (lambda () (subst (list '= 'v geo-z)) (geo-vtype! geo-z) (rfl)))
        (ai geo-nz)))))
(geo-qed! 'rmod-act-cancel)

;; the line is a submodule
(define geo-linemem '(FORALL m (FORALL v (FORALL w_ (IFF (IN w_ (LINE m v)) (AND (IN w_ (VEC m)) (FORSOME r_ (AND (IN r_ RR) (= w_ ((ACT m) r_ v))))))))))
(define (geo-line-elim! u v)   ; u in LINE(m, v): land u in VEC m, return the coefficient witness
  (let ((i (dk-cite! 'lfe-line-membership 'm v u)))
    (dk-have! (caddr i) (lambda () (dk-only! i (list 'IN u (list 'LINE 'm v))) (prop)))
    (dk-split! (caddr i))
    (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u) (dk-contains? f 'r_))) (dk-asms)) #t)))
(define (geo-line-intro! u v c)   ; goal (IN u (LINE m v)), c in RR, u = c.v
  (mac 'lfe-line-membership)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin (ew c) (dk-conj-close! (lambda () (ass))))
              (begin (geo-vtype! u) (ass)))))))
(sp (make-wff (forall-guarded '(m v) (append geo-rmod (list '(IN v (VEC m)))) '(IS-SUBMODULE m (LINE m v)))))
(dk-peel!)
(mac 'is-submodule)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'SUBSET)
         (mac 'subset-def) (let ((z (dk-di-var!))) (geo-line-elim! z 'v) (ass)))
        ((dk-head-is? g 'IN)
         (geo-real! 0)
         (dk-cite! 'rmod-act-zero 'm 'v)
         (dk-have! (list '= geo-z (geo-act 0 'v)) (lambda () (subst (list '= (geo-act 0 'v) geo-z)) (geo-vtype! geo-z) (rfl)))
         (geo-line-intro! geo-z 'v 0))
        (#t
         (let* ((ld (dk-peel!)) (g2 (dk-goal)) (tm (cadr g2)))
           (cond
             ((equal? (car tm) '(VADD m))
              (let* ((x (cadr tm)) (y (caddr tm)) (a (geo-line-elim! x 'v)) (b (geo-line-elim! y 'v)))
                (geo-real! (list '+ a b))
                (dk-have! (list '= tm (geo-act (list '+ a b) 'v))
                  (lambda () (subst (list '= x (geo-act a 'v))) (subst (list '= y (geo-act b 'v)))
                             (geo-subst-rev! (dk-cite! 'rmod-act-add 'm a b 'v)) (geo-vtype! (geo-act (list '+ a b) 'v)) (rfl)))
                (geo-line-intro! tm 'v (list '+ a b))))
             ((equal? (car tm) '(VNEG m))
              (let* ((x (cadr tm)) (a (geo-line-elim! x 'v)) (na (list '* (list '- 1) a)))
                (geo-real! na) (geo-real! '(- 1))
                (dk-have! (list '= tm (geo-act na 'v))
                  (lambda ()
                    (subst (list '= x (geo-act a 'v)))
                    (geo-vtype! (geo-act a 'v))
                    (let* ((n1 (dk-cite! 'module-act-neg-one 'm (geo-act a 'v)))
                           (n2 (dk-rewrite-h! n1 '(SCAL m) geo-ring))
                           (o1 (dk-cite! 'rr-scalar-ring-one))
                           (n3 (dk-rewrite-h! n2 (list 'ONE geo-ring) 1))
                           (o2 (dk-cite! 'rr-scalar-ring-neg))
                           (n4 (dk-rewrite-h! n3 (list 'NEG geo-ring) (caddr o2))))
                      (dk-lam-b-h! n4)
                      (subst (list '= (list '(VNEG m) (geo-act a 'v)) (geo-act '(- 1) (geo-act a 'v))))
                      (geo-subst-rev! (dk-cite! 'rmod-act-mul 'm '(- 1) a 'v))
                      (geo-vtype! (geo-act na 'v))
                      (rfl))))
                (geo-line-intro! tm 'v na)))
             (#t
              (let* ((r (cadr tm)) (x (caddr tm)) (a (geo-line-elim! x 'v)))
                (dk-have! (list 'IN r 'RR)
                  (lambda () (dk-rewrite-h! (dk-ctx-form (list 'IN r '(CARR (SCAL m)))) '(SCAL m) geo-ring)
                             (dk-cite! 'rr-scalar-ring-carr)
                             (dk-rewrite-h! (dk-ctx-form (list 'IN r (list 'CARR geo-ring))) (list 'CARR geo-ring) 'RR)
                             (ass)))
                (geo-real! (list '* r a))
                (dk-have! (list '= tm (geo-act (list '* r a) 'v))
                  (lambda () (subst (list '= x (geo-act a 'v)))
                             (geo-subst-rev! (dk-cite! 'rmod-act-mul 'm r a 'v)) (geo-vtype! (geo-act (list '* r a) 'v)) (rfl)))
                (geo-line-intro! tm 'v (list '* r a))))))))))
  (dk-open-leaves))
(geo-qed! 'line-is-submodule-rmod)

(define (geo-coef u) (list 'LINE-COEF 'm 'v u))
(define geo-lineH (append geo-rmod (list '(IN v (VEC m)) geo-nz)))
;; the coefficient denotes on the line
(sp (make-wff (forall-guarded '(m v u) (append geo-lineH (list '(IN u (LINE m v))))
                              (list 'AND (list 'IN (geo-coef 'u) 'RR) (list '= 'u (geo-act (geo-coef 'u) 'v))))))
(dk-peel!)
(let ((c (geo-line-elim! 'u 'v)))
  (mac 'LINE-COEF)
  (for-each
    (lambda (k)
      (dk-focus! k)
      (if (eq? (car (dk-goal)) 'FORSOME)
          (begin
            (ew c)
            (for-each
              (lambda (k2)
                (dk-focus! k2)
                (if (eq? (car (dk-goal)) 'FORALL)
                    (let* ((ld (dk-peel!)))
                      (dk-split-all!)
                      (let* ((g (dk-goal)) (y (if (eq? (cadr g) c) (caddr g) (cadr g))))
                        (dk-have! (list '= (geo-act y 'v) (geo-act c 'v))
                          (lambda () (subst (list '= (geo-act y 'v) 'u)) (subst (list '= 'u (geo-act c 'v)))
                                     (geo-vtype! (geo-act c 'v)) (rfl)))
                        (dk-cite! 'rmod-act-cancel 'm 'v y c)
                        (if (not (dk-ass!)) (begin (subst (list '= y c)) (rfl)))))
                    (dk-conj-close! (lambda () (ass)))))
              (dk-opened (lambda () (di)))))
          (if (not (dk-ass!)) (begin (dk-split-all!) (dk-conj-close! (lambda () (ass)))))))
    (dk-opened (lambda () (iota-d (cadr (cadr (dk-goal))))))))
(geo-qed! 'line-coef-spec)

(sp (make-wff (forall-guarded '(m v u c) (append geo-lineH (list '(IN c RR) (list '= 'u (geo-act 'c 'v))))
                              (list '= (geo-coef 'u) 'c))))
(dk-peel!)
(geo-vtype! (geo-act 'c 'v))
(dk-have! '(IN u (VEC m)) (lambda () (subst (list '= 'u (geo-act 'c 'v))) (ass)))
(dk-have! '(IN u (LINE m v)) (lambda () (geo-line-intro! 'u 'v 'c)))
(dk-split! (dk-cite! 'line-coef-spec 'm 'v 'u))
(dk-have! (list '= (geo-act (geo-coef 'u) 'v) (geo-act 'c 'v))
  (lambda () (subst (list '= (geo-act (geo-coef 'u) 'v) 'u)) (subst (list '= 'u (geo-act 'c 'v))) (rfl)))
(dk-cite! 'rmod-act-cancel 'm 'v (geo-coef 'u) 'c)
(ass)
(geo-qed! 'line-coef-value)

;; the seed functional u |-> coefficient of u, on the line
(define geo-f0 '(VNB-LAMBDA lnu_ (LINE m v) (LINE-COEF m v lnu_)))
(define (geo-sub-clause k)
  (let ((f (case k
             ((vadd) '(FORALL x_ (IMPLIES (IN x_ (LINE m v)) (FORALL y_ (IMPLIES (IN y_ (LINE m v)) (IN ((VADD m) x_ y_) (LINE m v)))))))
             ((act)  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL m))) (FORALL x_ (IMPLIES (IN x_ (LINE m v)) (IN ((ACT m) r_ x_) (LINE m v))))))))))
    (if (not (dk-asm? f)) (dk-project! f 'is-submodule '(IS-SUBMODULE m (LINE m v))))
    f))
(sp (make-wff (forall-guarded '(m v) geo-lineH (list 'IS-LINEAR-FUNCTIONAL-ON 'm '(LINE m v) geo-f0))))
(dk-peel!)
(dk-cite! 'line-is-submodule-rmod 'm 'v)
(dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
(mac 'is-linear-functional-on)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IN)
         (dk-lam-type! (lambda () (let ((u (dk-di-var!))) (dk-split! (dk-cite! 'line-coef-spec 'm 'v u)) (ass)))
                       (lambda () (mac 'LINE) (sep-set) (for-each (lambda (k) (dk-focus! k) (ass)) (dk-open-leaves)))))
        (#t
         (let* ((ld (dk-peel!)) (g2 (dk-goal)) (tm (cadr (cadr g2))))
           (if (equal? (car tm) '(VADD m))
               (let* ((x (cadr tm)) (y (caddr tm)))
                 (dk-apply! (geo-sub-clause 'vadd) x y)
                 (dk-lam-b!)
                 (dk-split! (dk-cite! 'line-coef-spec 'm 'v x))
                 (dk-split! (dk-cite! 'line-coef-spec 'm 'v y))
                 (let* ((a (dk-name! (geo-coef x))) (b (dk-name! (geo-coef y))) (ab (list '+ a b)))
                   (dk-rewrite-h! (dk-ctx-form (list '= x (geo-act (geo-coef x) 'v))) (geo-coef x) a)
                   (dk-rewrite-h! (dk-ctx-form (list '= y (geo-act (geo-coef y) 'v))) (geo-coef y) b)
                   (geo-real! ab)
                   (dk-have! (list '= tm (geo-act ab 'v))
                     (lambda () (subst (list '= x (geo-act a 'v))) (subst (list '= y (geo-act b 'v)))
                                (geo-subst-rev! (dk-cite! 'rmod-act-add 'm a b 'v)) (geo-vtype! (geo-act ab 'v)) (rfl)))
                   (subst (dk-cite! 'line-coef-value 'm 'v tm ab))
                   (subst (list '= (geo-coef x) a))
                   (subst (list '= (geo-coef y) b))
                   (rfl)))
               (let* ((r (cadr tm)) (x (caddr tm)))
                 (geo-carr! r)
                 (dk-apply! (geo-sub-clause 'act) r x)
                 (dk-lam-b!)
                 (dk-split! (dk-cite! 'line-coef-spec 'm 'v x))
                 (let* ((a (dk-name! (geo-coef x))) (ra (list '* r a)))
                   (dk-rewrite-h! (dk-ctx-form (list '= x (geo-act (geo-coef x) 'v))) (geo-coef x) a)
                   (geo-real! ra)
                   (dk-have! (list '= tm (geo-act ra 'v))
                     (lambda () (subst (list '= x (geo-act a 'v)))
                                (geo-subst-rev! (dk-cite! 'rmod-act-mul 'm r a 'v)) (geo-vtype! (geo-act ra 'v)) (rfl)))
                   (subst (dk-cite! 'line-coef-value 'm 'v tm ra))
                   (subst (list '= (geo-coef x) a))
                   (rfl)))))))))
  (dk-open-leaves))
(geo-qed! 'line-seed-linear)

(sp (make-wff (forall-guarded '(m v) geo-lineH (list '= (list geo-f0 'v) 1))))
(dk-peel!)
(geo-real! 1)
(dk-cite! 'rmod-act-one 'm 'v)
(dk-have! (list '= 'v (geo-act 1 'v)) (lambda () (subst (list '= (geo-act 1 'v) 'v)) (rfl)))
(dk-have! '(IN v (LINE m v)) (lambda () (geo-line-intro! 'v 'v 1)))
(dk-lam-b!)
(dk-cite! 'line-coef-value 'm 'v 'v 1)
(ass)
(geo-qed! 'line-seed-at-v)

;; the seed lies below the gauge of w when the gauge of v is >= 1
(sp (make-wff (forall-guarded '(m t w v) (append geo-gh (list '(IN v (VEC m)) geo-nz (list '<= 1 (geo-I 'v))))
   (list 'FORALL 'u (list 'IMPLIES '(IN u (LINE m v)) (list '<= (list geo-f0 'u) (list geo-p 'u)))))))
(dk-peel!)
(geo-gparts!)
(let* ((u (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(LINE m v)))) (dk-asms))))))
  (dk-lam-b!)
  (dk-split! (dk-cite! 'line-coef-spec 'm 'v u))
  (let* ((c (dk-name! (geo-coef u))))
    (subst (list '= (geo-coef u) c))
    (dk-rewrite-h! (dk-ctx-form (list '= u (geo-act (geo-coef u) 'v))) (geo-coef u) c)
    (dk-cite! 'lfe-line-in-vec 'm 'v u)
    (dk-cite! 'mink-value 'm 'w u)
    (subst (list '= (list geo-p u) (geo-I u)))
    (subst (list '= u (geo-act c 'v)))
    (let ((cv (geo-act c 'v)))
      (geo-vtype! cv)
      (dk-cite! 'mink-inf-nonneg 'm 'w cv)
      (geo-glb! cv) (geo-glb! 'v)
      (use-em (list '<= c 0)
        (lambda () (dk-ineq! (list '<= c 0) (list '<= 0 (geo-I cv)) (list 'IN c 'RR) (list 'IN (geo-I cv) 'RR)))
        (lambda ()
          (dk-cite! 'rr-not-le-lt c 0)
          (subst (dk-cite! 'mink-inf-scale 'm 'w 'v c))
          (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c) (list 'IN c 'RR))))
          (let* ((h (dk-cite! 'mink-rr-scale-le 1 (geo-I 'v) c))
                 (e (geo-eq! (list '* c 1) c))
                 (h2 (dk-rewrite-h! h (list '* c 1) c)))
            (ass)))))))
(geo-qed! 'line-seed-below-gauge)

;; a linear functional on the whole space VEC m is a linear functional of m
;;; CUT 2026-10-27 (integration): `linear-functional-of-on-whole' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `linfun-on-vec-is-linfun', which is cited below in its place (proven-duplicate audit).

;;; =====================================================================
;;; (3) CONTINUITY FROM A ONE-SIDED BOUND NEAR 0
;;; =====================================================================
(define geo-hom (list 'IS-HOM-TOP-SPACE 't geo-rt 'f))
(define geo-alleps '(FORALL eps (IMPLIES (IN eps RR) (IMPLIES (< 0 eps)
   (FORSOME bw_ (AND (IN bw_ (OPENS t)) (AND (IN (VZERO m) bw_) (FORALL bwz_ (IMPLIES (IN bwz_ bw_) (<= (abs (f bwz_)) eps))))))))))
(define geo-onesided '(FORALL osw_ (IMPLIES (IN osw_ n) (<= (f osw_) 1))))
(sp (make-wff (forall-guarded '(m t f n) (list geo-tvs geo-lf '(IN n (OPENS t)) (list 'IN geo-z 'n) geo-onesided) geo-alleps)))
(dk-peel!)
(geo-tvs-parts!)
(geo-lf-parts!)
(let* ((m1 '(- 1)) (dn (geo-dil m1 'n)) (mm (list 'INTERSECTION 'n dn))
       (il (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t)) (IN (INTERSECTION u v) (OPENS t))))))
                        'is-top-space '(IS-TOP-SPACE t))))
  (geo-real! m1)
  (dk-cite! 'tvs-dilate-open 'm 't m1 'n)
  (dk-apply! il 'n dn)
  (dk-cite! 'rmod-act-vzero 'm m1)
  (geo-vtype! geo-z)
  (dk-have! (list 'IN geo-z dn) (lambda () (in-sep! (lambda () (ass)) (lambda () (subst (list '= (geo-act m1 geo-z) geo-z)) (ass)))))
  (dk-have! (list 'IN geo-z mm) (lambda () (mac 'intersection-membership) (dk-conj-close! (lambda () (ass)))))
  (let* ((e (caddr (find-first (lambda (f) (and (dk-head-is? f '<) (eqv? (cadr f) 0))) (dk-asms))))
         (q (begin (geo-nz-of-pos! e) (geo-recip! e)))
         (wp (geo-dil q mm)))
    (dk-cite! 'tvs-dilate-open 'm 't q mm)
    (dk-cite! 'rmod-act-vzero 'm q)
    (dk-have! (list 'IN geo-z wp) (lambda () (in-sep! (lambda () (ass)) (lambda () (subst (list '= (geo-act q geo-z) geo-z)) (ass)))))
    (ew wp)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((z (dk-di-var!)))
              (sep-me (dk-ctx-form (list 'IN z wp)))
              (dk-split-all!)
              (let* ((y (geo-act q z)) (fz (list 'f z)) (fy (list 'f y)))
                (mac-h 'intersection-membership (list 'IN y mm))
                (dk-split-all!)
                (sep-me (dk-ctx-form (list 'IN y dn)))
