                    (lambda ()
                      (subst (dk-apply! geo-fon-add z (geo-act k c0)))
                      (subst (dk-apply! geo-fon-hom k c0))
                      (subst (list '= (list 'f c0) fc))
                      (subst (geo-eq! (list '+ fz (list '* k fc)) (list '- fz (list '* fz (list '* fc q1)))))
                      (subst (list '= (list '* fc q1) 1))
                      (crs)))))
              (dk-cite! 'subset-mem-fwd geo-Kf (list 'FKER 'm g0) w)
              (let* ((i (dk-cite! 'fker-membership 'm g0 w)))
                (dk-have! (list '= (list g0 w) 0) (lambda () (dk-only! i (list 'IN w (list 'FKER 'm g0))) (prop))))
              (g0val! z)
              (let* ((e1 (dk-apply! gadd z (geo-act k c0)))
                     (e2 (dk-apply! ghom k c0))
                     (h (dk-rewrite-h! (dk-ctx-form (list '= (list g0 w) 0)) (list g0 w) (list '+ (list g0 z) (list g0 (geo-act k c0)))))
                     (h2 (dk-rewrite-h! h (list g0 (geo-act k c0)) (list '* k (list g0 c0))))
                     (h3 (dk-rewrite-h! h2 (list g0 c0) lm)))
                (subst (gval! z))
                (geo-real! (list '* fz (list '* q1 lm)))
                (geo-real! (list '* k lm))
                (geo-eq! (list '* k lm) (list '- (list '* fz (list '* q1 lm))))
                (let ((h4 (dk-rewrite-h! h3 (list '* k lm) (list '- (list '* fz (list '* q1 lm))))))
                  (dk-have! (list '= (list g0 z) (list '* fz (list '* q1 lm)))
                    (lambda () (dk-ineq! h4 (list 'IN (list g0 z) 'RR) (list 'IN (list '* fz (list '* q1 lm)) 'RR)))))
                (subst (list '= (list g0 z) (list '* fz (list '* q1 lm))))
                (subst (geo-eq! (list '* fc (list '* q2 (list '* fz (list '* q1 lm)))) (list '* fz (list '* (list '* fc q1) (list '* lm q2)))))
                (subst (list '= (list '* fc q1) 1))
                (subst (list '= (list '* lm q2) 1))
                (crs)))))
        (let ((ext (dk-ctx-form (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ fs) (list '= (list gfn 'pfz_) '(f pfz_)))))))
          ;; g is linear
          (dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
          (dk-have! (list 'IS-LINEAR-FUNCTIONAL 'm gfn)
            (lambda ()
              (mac 'is-linear-functional)
              (let loop ((k 0))
                (let ((l (find-first (lambda (l) (and (dk-head-is? (dk-goal-of l) 'AND) (dk-contains? (dk-goal-of l) 'gex_))) (dk-open-leaves))))
                  (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
              (for-each
                (lambda (l)
                  (if (and (not (sequent-node-grounded? l)) (dk-contains? (dk-goal-of l) 'gex_))
