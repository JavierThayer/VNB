                (let* ((n1 (dk-cite! 'module-act-neg-one 'm x))
                       (n2 (dk-rewrite-h! n1 '(SCAL m) geo-ring))
                       (o1 (dk-cite! 'rr-scalar-ring-one))
                       (n3 (dk-rewrite-h! n2 (list 'ONE geo-ring) 1))
                       (o2 (dk-cite! 'rr-scalar-ring-neg))
                       (n4 (dk-rewrite-h! n3 (list 'NEG geo-ring) (caddr o2))))
                  (dk-lam-b-h! n4))
                (dk-have! (list '= (list 'f tm) 0)
                  (lambda () (subst (list '= tm (geo-act '(- 1) x))) (subst (dk-apply! geo-fhom '(- 1) x)) (subst (list '= (list 'f x) 0)) (crs)))
                (mac 'fker-membership) (dk-conj-close! (lambda () (ass)))))
             (#t
              (let* ((r (cadr tm)) (x (caddr tm)))
                (dk-have! (list 'IN r 'RR)
                  (lambda () (dk-rewrite-h! (dk-ctx-form (list 'IN r '(CARR (SCAL m)))) '(SCAL m) geo-ring)
                             (dk-cite! 'rr-scalar-ring-carr)
                             (dk-rewrite-h! (dk-ctx-form (list 'IN r (list 'CARR geo-ring))) (list 'CARR geo-ring) 'RR)
                             (ass)))
                (geo-ker-elim! x) (geo-vtype! tm)
                (dk-have! (list '= (list 'f tm) 0)
                  (lambda () (subst (dk-apply! geo-fhom r x)) (subst (list '= (list 'f x) 0)) (crs)))
                (mac 'fker-membership) (dk-conj-close! (lambda () (ass)))))))))))
  (dk-open-leaves))
(geo-qed! 'fker-submodule)

(define geo-fsH '(IS-SUBMODULE m fs))
(define (geo-fs-clause k)
  (let ((f (case k
             ((sub) '(SUBSET fs (VEC m)))
             ((zero) (list 'IN geo-z 'fs))
             ((vadd) '(FORALL x_ (IMPLIES (IN x_ fs) (FORALL y_ (IMPLIES (IN y_ fs) (IN ((VADD m) x_ y_) fs))))))
             ((act)  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL m))) (FORALL x_ (IMPLIES (IN x_ fs) (IN ((ACT m) r_ x_) fs)))))))))
    (if (not (dk-asm? f)) (dk-project! f 'is-submodule geo-fsH))
    f))
(define (geo-fs-act! r x) (geo-carr! r) (dk-apply! (geo-fs-clause 'act) r x))
(define (geo-fsV! z) (geo-fs-clause 'sub) (if (not (dk-asm? (list 'IN z '(VEC m)))) (dk-cite! 'subset-mem-fwd 'fs '(VEC m) z)))
(define geo-B '(SEP bx_ (VEC m) (FORSOME bz_ (AND (IN bz_ fs) (IN ((VADD m) bx_ ((ACT m) (- 1) bz_)) a)))))
(define (geo-inB! x z)   ; goal (IN x B); x in VEC m, z in fs, x + (-1)z in a in context
  (in-sep! (lambda () (ass)) (lambda () (ew z) (dk-conj-close! (lambda () (ass))))))
(define (geo-elimB! x)   ; x in B: land x in VEC m, z in fs, x - z in a; return z
  (sep-me (dk-ctx-form (list 'IN x geo-B)))
  (dk-split-all!)
  (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'bz_) (dk-contains? f x))) (dk-asms)) #t))
;; every point of a is in B (with z = 0); needs 0 in fs and (-1).0 = 0 in context
(define (geo-a-in-B! x)
  (geo-open-pt! 'a x)
  (dk-cite! 'rmod-vzero-right 'm x)
  (dk-have! (list 'IN (geo-add x (geo-act '(- 1) geo-z)) 'a)
    (lambda () (subst (list '= (geo-act '(- 1) geo-z) geo-z)) (subst (list '= (geo-add x geo-z) x)) (ass)))
  (dk-have! (list 'IN x geo-B) (lambda () (geo-inB! x geo-z))))
(define geo-disj '(FORALL dz_ (IMPLIES (IN dz_ fs) (NOT (IN dz_ a)))))

(sp (make-wff (forall-guarded '(m t a fs)
   (list geo-tvs '(IN a (OPENS t)) '(IS-CONVEX-SUBSET m a) '(FORSOME sa0_ (IN sa0_ a)) geo-fsH geo-disj)
   '(FORSOME g (AND (IS-LINEAR-FUNCTIONAL m g) (AND (IS-HOM-TOP-SPACE t (SEMINORM-TOP (NORMED-VECTOR-SPACE-AS-MODULE RR-NVS) (PAIR 0 0) (VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS))) g)
       (AND (FORSOME gx_ (AND (IN gx_ (VEC m)) (NOT (= (g gx_) 0))))
       (AND (SUBSET fs (FKER m g))
       (AND (IS-TOP-CLOSED t (FKER m g)) (FORALL x (IMPLIES (IN x a) (NOT (IN x (FKER m g))))))))))))))
(dk-peel!)
(geo-tvs-parts!)
(let* ((a0 (dk-skolem! (dk-ctx-form '(FORSOME sa0_ (IN sa0_ a))) #t))
       (cva (dk-project! (geo-cvx-of 'a) 'is-convex-subset '(IS-CONVEX-SUBSET m a))))
  (geo-open-pt! 'a a0)
  (geo-real! '(- 1))
  (geo-fs-clause 'zero)
  (geo-vtype! geo-z)
  (dk-cite! 'rmod-act-vzero 'm '(- 1))
  (geo-a-in-B! a0)
  ;; B is open
  (geo-sub-pts! geo-B)
  (dk-have! (geo-loc-of geo-B)
    (lambda ()
      (let* ((x (dk-di-var!)) (z (geo-elimB! x)) (nn (geo-trans 'a z)))
        (geo-fsV! z)
        (dk-cite! 'tvs-translate-open 'm 't 'a z)
        (ew nn)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  ((dk-head-is? (dk-goal) 'IN) (in-sep! (lambda () (ass)) (lambda () (ass))))
                  (#t (mac 'subset-def)
                      (let ((y (dk-di-var!)))
                        (sep-me (dk-ctx-form (list 'IN y nn))) (dk-split-all!)
                        (geo-inB! y z)))))))))
  (dk-cite! 'top-open-of-local 't geo-B)
  ;; B is convex
  (dk-have! (list 'IS-CONVEX-SUBSET 'm geo-B)
    (lambda ()
      (mac 'is-convex-subset)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'SUBSET)
              (begin (mac 'subset-def) (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z geo-B))) (dk-split-all!) (ass)))
              (let* ((ld (dk-peel!))
                     (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) geo-B))) ld)))
                     (x1 (car vs)) (x2 (cadr vs))
                     (t (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
                     (u (list '- 1 t))
                     (z1 (geo-elimB! x1)) (z2 (geo-elimB! x2)))
                (geo-fsV! z1) (geo-fsV! z2) (geo-real! u)
                (let* ((ax1 (geo-sub x1 z1)) (ax2 (geo-sub x2 z2))
                       (m0 (dk-apply! cva ax1 ax2 t))
                       (comb (geo-add (geo-act u x1) (geo-act t x2)))
                       (zc (geo-add (geo-act u z1) (geo-act t z2)))
                       (e (dk-cite! 'rmod-combination-sub 'm u t x1 x2 z1 z2))
                       (m1 (dk-rewrite-h! m0 (caddr e) (cadr e))))
                  (geo-fs-act! u z1) (geo-fs-act! t z2)
                  (dk-apply! (geo-fs-clause 'vadd) (geo-act u z1) (geo-act t z2))
                  (geo-vtype! comb)
                  (geo-inB! comb zc))))))))
  ;; 0 is not in B
  (dk-have! (list 'NOT (list 'IN geo-z geo-B))
    (lambda ()
      (di)
      (let* ((z (geo-elimB! geo-z)))
        (geo-fsV! z)
        (geo-vtype! (geo-act '(- 1) z))
        (dk-cite! 'rmod-vzero-left 'm (geo-act '(- 1) z))
        (dk-rewrite-h! (dk-ctx-form (list 'IN (geo-add geo-z (geo-act '(- 1) z)) 'a)) (geo-add geo-z (geo-act '(- 1) z)) (geo-act '(- 1) z))
        (geo-fs-act! '(- 1) z)
        (dk-apply! geo-disj (geo-act '(- 1) z))
        (ai (list 'NOT (list 'IN (geo-act '(- 1) z) 'a))))))
  (dk-have! (list 'FORSOME 'sa0_ (list 'IN 'sa0_ geo-B)) (lambda () (ew a0) (ass)))
  (let* ((ff (dk-skolem! (dk-cite! 'open-convex-positive-functional 'm 't geo-B) #t))
         (pos (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ff) (dk-contains? f geo-B))) (dk-asms))))
    (dk-project! (list 'IN ff '(FUN (VEC m) RR)) 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff))
    (let ((fadd (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
                                (list '= (list ff '((VADD m) x_ y_)) (list '+ (list ff 'x_) (list ff 'y_)))))))
                             'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff)))
          (fhom (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m))
                                (list '= (list ff '((ACT m) r_ x_)) (list '* 'r_ (list ff 'x_)))))))
                             'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff))))
      (dk-apply! pos a0)
      (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR a0)
      ;; ff vanishes on fs
      (dk-have! (list 'FORALL 'vz_ (list 'IMPLIES '(IN vz_ fs) (list '= (list ff 'vz_) 0)))
        (lambda ()
          (let* ((z (dk-di-var!)) (fz (list ff z)) (fa (list ff a0)))
            (geo-fsV! z)
            (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR z)
            (use-em (list '= fz 0)
              (lambda () (ass))
              (lambda ()
                (let* ((rz (geo-recip! fz))
                       (s (list '* (list '- (list '+ fa 1)) rz))
                       (sz (geo-act s z))
                       (y (geo-add a0 sz)))
                  (geo-real! s)
                  (geo-fs-act! s z)
                  (geo-vtype! sz) (geo-vtype! y) (geo-vtype! (geo-act '(- 1) sz))
                  (let* ((e1 (dk-cite! 'rmod-vadd-assoc 'm a0 sz (geo-act '(- 1) sz)))
                         (e2 (dk-cite! 'rmod-add-neg 'm sz))
                         (e3 (dk-cite! 'rmod-vzero-right 'm a0)))
                    (dk-have! (list 'IN (geo-add y (geo-act '(- 1) sz)) 'a)
                      (lambda () (subst (list '= (geo-add y (geo-act '(- 1) sz)) (geo-add a0 (geo-add sz (geo-act '(- 1) sz)))))
                                 (subst (list '= (geo-add sz (geo-act '(- 1) sz)) geo-z))
                                 (subst (list '= (geo-add a0 geo-z) a0))
                                 (ass))))
                  (dk-have! (list 'IN y geo-B) (lambda () (geo-inB! y sz)))
                  (let* ((h (dk-apply! pos y))
                         (ea (dk-apply! fadd a0 sz))
                         (h2 (dk-rewrite-h! h (list ff y) (list '+ fa (list ff sz))))
                         (eh (dk-apply! fhom s z))
                         (h3 (dk-rewrite-h! h2 (list ff sz) (list '* s fz))))
                    (dk-have! (list '= (list '* s fz) (list '- (list '+ fa 1)))
                      (lambda () (subst (geo-eq! (list '* s fz) (list '* (list '- (list '+ fa 1)) (list '* fz rz))))
                                 (subst (list '= (list '* fz rz) 1))
                                 (crs)))
                    (let ((h4 (dk-rewrite-h! h3 (list '* s fz) (list '- (list '+ fa 1)))))
                      (dk-absurd! h4 (list 'IN fa 'RR)))))))))))
      (let ((vz (dk-ctx-form (list 'FORALL 'vz_ (list 'IMPLIES '(IN vz_ fs) (list '= (list ff 'vz_) 0))))))
        (dk-cite! 'tvs-continuous-kernel-closed 'm 't ff)
        (ew ff)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew a0)
               (dk-conj-close! (lambda () (if (not (dk-ass!))
                                              (begin (di) (dk-absurd! (list '= (list ff a0) 0) (list '< 0 (list ff a0)) (list 'IN (list ff a0) 'RR)))))))
              ((dk-head-is? (dk-goal) 'SUBSET)
               (mac 'subset-def)
               (let ((z (dk-di-var!)))
                 (geo-fsV! z) (dk-apply! vz z)
                 (mac 'fker-membership) (dk-conj-close! (lambda () (ass)))))
              (#t
               (let ((x (dk-di-var!)))
                 (geo-a-in-B! x)
                 (dk-apply! pos x)
                 (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR x)
                 (di)
                 (let ((i (dk-cite! 'fker-membership 'm ff x)))
                   (dk-have! (list '= (list ff x) 0) (lambda () (dk-only! i (list 'IN x (list 'FKER 'm ff))) (prop)))
                   (dk-absurd! (list '= (list ff x) 0) (list '< 0 (list ff x)) (list 'IN (list ff x) 'RR)))))))))))
(geo-qed! 'closed-hyperplane-through-subspace)

;;; =====================================================================
;;; (6) Prop 2.12: an open convex cone /= E misses a nontrivial subspace (dimension >= 2)
;;; =====================================================================
(define geo-cone '(FORALL cnx_ (IMPLIES (IN cnx_ c) (FORALL cnr_ (IMPLIES (IN cnr_ RR) (IMPLIES (< 0 cnr_) (IN ((ACT m) cnr_ cnx_) c)))))))
(define geo-dim2 '(FORSOME d1_ (FORSOME d2_ (AND (IN d1_ (VEC m)) (AND (IN d2_ (VEC m))
   (FORALL ca_ (IMPLIES (IN ca_ RR) (FORALL cb_ (IMPLIES (IN cb_ RR)
     (IMPLIES (= ((VADD m) ((ACT m) ca_ d1_) ((ACT m) cb_ d2_)) (VZERO m)) (AND (= ca_ 0) (= cb_ 0))))))))))))
(sp (make-wff (forall-guarded '(m t c)
   (list geo-tvs '(IN c (OPENS t)) '(IS-CONVEX-SUBSET m c) geo-cone '(FORSOME ce_ (AND (IN ce_ (VEC m)) (NOT (IN ce_ c)))) geo-dim2)
   '(FORSOME vs (AND (IS-SUBMODULE m vs) (AND (FORSOME vv_ (AND (IN vv_ vs) (NOT (= vv_ (VZERO m))))) (FORALL vx_ (IMPLIES (IN vx_ vs) (NOT (IN vx_ c))))))))))
(dk-peel!)
(geo-tvs-parts!)
(let* ((e (dk-skolem! (dk-ctx-form '(FORSOME ce_ (AND (IN ce_ (VEC m)) (NOT (IN ce_ c))))) #t))
       (d1 (dk-skolem! (dk-ctx-form geo-dim2) #f))
       (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'd2_) (dk-contains? f d1))) (dk-asms)))
       (d2 (dk-skolem! ex2 #t))
       (ind (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1) (dk-contains? f d2))) (dk-asms)))
       (cone (dk-ctx-form geo-cone)))
  (geo-real! 0) (geo-real! 1)
  ;; d1 /= 0
  (dk-have! (list 'NOT (list '= d1 geo-z))
    (lambda ()
      (di)
      (geo-vtype! geo-z)
      (dk-have! (list '= (geo-add (geo-act 1 d1) (geo-act 0 d2)) geo-z)
        (lambda () (subst (dk-cite! 'rmod-act-one 'm d1)) (subst (dk-cite! 'rmod-act-zero 'm d2))
                   (subst (list '= d1 geo-z)) (subst (dk-cite! 'rmod-vzero-left 'm geo-z)) (rfl)))
      (dk-split! (dk-apply! ind 1 0))
      (dk-absurd! '(= 1 0))))
  (use-em '(FORSOME cc_ (IN cc_ c))
    (lambda ()
      ;; 0 is not in c
      (dk-have! (list 'NOT (list 'IN geo-z 'c))
        (lambda ()
          (di)
          (dk-cite! 'tvs-open-zero-absorbing 'm 't 'c)
          (let* ((ab (dk-project! (list 'FORALL 'abx_ (list 'IMPLIES '(IN abx_ (VEC m))
                         '(FORSOME abr_ (AND (IN abr_ RR) (AND (< 0 abr_) (FORSOME aby_ (AND (IN aby_ c) (= abx_ ((ACT m) abr_ aby_)))))))))
                       'is-absorbing-subset '(IS-ABSORBING-SUBSET m c)))
                 (r (dk-skolem! (dk-apply! ab e) #t))
                 (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'aby_))) (dk-asms)) #t)))
            (dk-split-all!)
            (dk-apply! cone y r)
            (dk-rewrite-h! (dk-ctx-form (list 'IN (geo-act r y) 'c)) (geo-act r y) e)
            (ai (list 'NOT (list 'IN e 'c))))))
      (let* ((ff (dk-skolem! (dk-cite! 'open-convex-positive-functional 'm 't 'c) #t))
             (pos (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ff) (dk-contains? f 'c))) (dk-asms)))
             (ker (list 'FKER 'm ff)))
        (dk-cite! 'fker-submodule 'm ff)
        (dk-project! (list 'IN ff '(FUN (VEC m) RR)) 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff))
        (let ((fadd (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
                                    (list '= (list ff '((VADD m) x_ y_)) (list '+ (list ff 'x_) (list ff 'y_)))))))
                                 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff)))
              (fhom (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m))
                                    (list '= (list ff '((ACT m) r_ x_)) (list '* 'r_ (list ff 'x_)))))))
                                 'is-linear-functional (list 'IS-LINEAR-FUNCTIONAL 'm ff)))
              (f1 (list ff d1)) (f2 (list ff d2)))
          (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR d1)
          (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR d2)
          (ew ker)
          (dk-conj-close!
            (lambda ()
              (cond
                ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (use-em (list '= f1 0)
                   (lambda ()
                     (ew d1)
                     (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (mac 'fker-membership) (dk-conj-close! (lambda () (ass))))))))
                   (lambda ()
                     (let* ((nf1 (list '- f1))
                            (w (geo-add (geo-act f2 d1) (geo-act nf1 d2))))
                       (geo-real! nf1) (geo-vtype! w)
                       (ew w)
                       (dk-conj-close!
                         (lambda ()
                           (cond
                             ((dk-ass!) #t)
                             ((dk-head-is? (dk-goal) 'IN)
                              (dk-have! (list '= (list ff w) 0)
                                (lambda () (subst (dk-apply! fadd (geo-act f2 d1) (geo-act nf1 d2)))
                                           (subst (dk-apply! fhom f2 d1)) (subst (dk-apply! fhom nf1 d2)) (crs)))
                              (mac 'fker-membership) (dk-conj-close! (lambda () (ass))))
                             (#t
                              (di)
                              (dk-split! (dk-apply! ind f2 nf1))
                              (dk-have! (list '= f1 0) (lambda () (dk-ineq! (list '= nf1 0) (list 'IN f1 'RR))))
                              (ai (list 'NOT (list '= f1 0)))))))))))
                (#t
                 (let ((x (dk-di-var!)))
                   (let ((i (dk-cite! 'fker-membership 'm ff x)))
                     (dk-have! (list 'AND (list 'IN x '(VEC m)) (list '= (list ff x) 0)) (lambda () (dk-only! i (list 'IN x ker)) (prop)))
                     (dk-split! (list 'AND (list 'IN x '(VEC m)) (list '= (list ff x) 0))))
                   (dk-cite! 'fun-apply-type-c ff '(VEC m) 'RR x)
                   (di)
                   (dk-apply! pos x)
                   (dk-absurd! (list '= (list ff x) 0) (list '< 0 (list ff x)) (list 'IN (list ff x) 'RR))))))))))
    (lambda ()
      (let ((ln (list 'LINE 'm d1)))
        (dk-cite! 'line-is-submodule-rmod 'm d1)
        (ew ln)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'FORSOME)
               (dk-cite! 'rmod-act-one 'm d1)
               (dk-have! (list '= d1 (geo-act 1 d1)) (lambda () (subst (list '= (geo-act 1 d1) d1)) (rfl)))
               (dk-have! (list 'IN d1 ln) (lambda () (geo-line-intro! d1 d1 1)))
               (ew d1)
               (dk-conj-close! (lambda () (ass))))
              (#t
               (let ((x (dk-di-var!)))
                 (di)
                 (dk-have! '(FORSOME cc_ (IN cc_ c)) (lambda () (ew x) (ass)))
                 (ai '(NOT (FORSOME cc_ (IN cc_ c)))))))))))))
(geo-qed! 'open-cone-misses-subspace)

;;; =====================================================================
;;; (7) SUM SETS A + P: open when A is, convex when A and P are
;;; =====================================================================
(define (geo-ss a p) (list 'SUMSET 'm a p))
(define (geo-ss-body a p) (list 'SEP 'smx_ '(VEC m) (list 'FORSOME 'smz_ (list 'AND (list 'IN 'smz_ p) (list 'IN '((VADD m) smx_ ((ACT m) (- 1) smz_)) a)))))
(sp (make-wff (forall-guarded '(m a p) '() (list '== (geo-ss 'a 'p) (geo-ss-body 'a 'p)))))
(dk-peel!)
(mac 'SUMSET)
(qrfl)
(geo-qed! 'sumset-unfold)
;; x in A + P: land x in VEC m, z in P, x - z in A; return z
(define (geo-ss-elim! x a p)
  (let* ((h (dk-ctx-form (list 'IN x (geo-ss a p))))
         (e (dk-cite! 'sumset-unfold 'm a p))
         (h2 (dk-rewrite-h! h (geo-ss a p) (geo-ss-body a p))))
    (sep-me h2)
    (dk-split-all!)
    (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'smz_) (dk-contains? f x))) (dk-asms)) #t)))
(define (geo-ss-intro! x z a p)   ; goal (IN x (A + P)); x in VEC m, z in P, x - z in A in context
  (mac 'SUMSET)
  (in-sep! (lambda () (ass)) (lambda () (ew z) (dk-conj-close! (lambda () (ass))))))

(sp (make-wff (forall-guarded '(m t a p) (list geo-tvs '(IN a (OPENS t)) '(SUBSET p (VEC m))) (list 'IN (geo-ss 'a 'p) '(OPENS t)))))
(dk-peel!)
(geo-tvs-parts!)
(let ((s (geo-ss 'a 'p)))
  (dk-have! (list 'SUBSET s '(PTS t))
    (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (geo-ss-elim! x 'a 'p) (geo-pts! x) (ass))))
  (dk-have! (geo-loc-of s)
    (lambda ()
