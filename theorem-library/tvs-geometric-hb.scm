(sp (make-wff (forall-guarded '(m t a fs)
   (list geo-tvs '(IN a (OPENS t)) '(IS-CONVEX-SUBSET m a) '(FORSOME sa0_ (IN sa0_ a)) geo-fsH geo-disj)
   (list 'FORSOME 'g (list 'AND '(IS-LINEAR-FUNCTIONAL m g)
