  (geo-open-pt! 'a a0)
  (g0-nz! a0)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (let ((lm (dk-name! (list g0 a0))))
    (dk-have! (list 'NOT (list '= lm 0)) (lambda () (subst (list '= lm (list g0 a0))) (ass)))
