       (list 'AND '(SUBSET fs (FKER m g)) '(FORALL x (IMPLIES (IN x a) (< 0 (g x)))))))))))
(dk-peel!)
(geo-tvs-parts!)
(geo-real! '(- 1)) (geo-real! 0) (geo-real! 1)
(let* ((ne (dk-ctx-form '(FORSOME sa0_ (IN sa0_ a))))
