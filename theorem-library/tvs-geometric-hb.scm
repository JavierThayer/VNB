      (dk-cite! 'class-extensionality (list 'FKER 'm gfn) (list 'FKER 'm g0))
      (dk-have! (list 'IS-TOP-CLOSED 't (list 'FKER 'm gfn))
        (lambda () (subst (list '= (list 'FKER 'm gfn) (list 'FKER 'm g0))) (ass)))
      ;; g(a0) = 1
      (let ((gc0 (list gfn a0)))
