;;; cg4-seg.scm -- the algebra of a one-parameter group segment phi on [0, al] (compact-groups
;;; notes, Prop. 5.36): phi(0) = e; phi(r) phi(al - r) = phi(al) = phi(al - r) phi(r); phi(r)
;;; commutes with c = phi(al) and its powers; phi(r1) phi(r2) = c phi(r1 + r2 - al) past al.
;;; Agent ISOM, 2026-10-26.  Helper prefix: sg4-.  Library: analysis.

(define (sg4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (sg4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (sg4-op x y) (list '(OPR g) x y))
(define sg4-E '(IDEN g))
(define sg4-c '(phi al))
(define (sg4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (sg4-forall (cdr vs) body))))
(define (sg4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (sg4-implies (cdr hs) concl))))
(define sg4-law '(FORALL gsr_ (IMPLIES (IN gsr_ (CCINT 0 al)) (FORALL gsu_ (IMPLIES (IN gsu_ (CCINT 0 al))
                   (IMPLIES (<= (+ gsr_ gsu_) al) (= (phi (+ gsr_ gsu_)) ((OPR g) (phi gsr_) (phi gsu_)))))))))
(define sg4-hyps (list '(IS-GROUP g) '(IN al RR) '(< 0 al) '(IN phi (FUN (CCINT 0 al) (CARR g))) sg4-law))
(define (sg4-unit v) (list (list 'IN v 'RR) (list '<= 0 v) (list '<= v 'al)))
(define (sg4-cc! t)                      ; t in RR, 0 <= t <= al in context: t in [0, al]
  (let ((iff (dk-cite! 'ccint-membership 0 'al t)))
    (if (not (dk-asm? (cadr iff)))
        (begin (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (sg4-ass!)))))
               (dk-meta-iff-l! iff)))
    (dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) t)))
(define (sg4-law! a b)                   ; a, b, a + b in [0, al]: phi(a + b) = phi(a) phi(b)
  (dk-apply! (dk-ctx-form sg4-law) a b))
(define (sg4-base!)
  (fact 'rr-zero-in)
  (fact 'group-identity-in 'g)
  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
  (dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
  (dk-have! '(<= al al) (lambda () (dk-ineq!)))
  (sg4-cc! 0) (sg4-cc! 'al))

(sp (make-wff (sg4-forall '(g al phi) (sg4-implies sg4-hyps (list '= '(phi 0) sg4-E)))))
(dk-peel!)
(sg4-base!)
(dk-real! '(+ 0 0))
(dk-have! '(<= (+ 0 0) al) (lambda () (dk-ineq! '(< 0 al))))
(sg4-law! 0 0)
(dk-have! '(= (+ 0 0) 0) (lambda () (crs)))
(dk-rewrite-h! (list '= '(phi (+ 0 0)) (sg4-op '(phi 0) '(phi 0))) '(+ 0 0) 0)
(dk-have! (list '= (sg4-op '(phi 0) '(phi 0)) '(phi 0))
  (lambda () (subst (list '= (sg4-op '(phi 0) '(phi 0)) '(phi 0))) (sg4-ass-rfl!)))
(dk-cite! 'group-idempotent-iden 'g '(phi 0))
(sg4-ass!)
(qed 'segment-at-zero)
(topic! 'segment-at-zero 'algebra)

(sp (make-wff (sg4-forall '(g al phi r) (sg4-implies (append sg4-hyps (sg4-unit 'r))
   (list 'AND (list '= (sg4-op '(phi r) '(phi (- al r))) sg4-c) (list '= (sg4-op '(phi (- al r)) '(phi r)) sg4-c))))))
(dk-peel!)
(sg4-base!)
(dk-real! '(- al r))
(dk-have! '(<= 0 (- al r)) (lambda () (dk-ineq! '(<= r al))))
(dk-have! '(<= (- al r) al) (lambda () (dk-ineq! '(<= 0 r))))
(sg4-cc! 'r) (sg4-cc! '(- al r))
(dk-real! '(+ r (- al r))) (dk-real! '(+ (- al r) r))
(dk-have! '(= (+ r (- al r)) al) (lambda () (crs)))
(dk-have! '(= (+ (- al r) r) al) (lambda () (crs)))
(dk-have! '(<= (+ r (- al r)) al) (lambda () (dk-ineq! '(= (+ r (- al r)) al))))
(dk-have! '(<= (+ (- al r) r) al) (lambda () (dk-ineq! '(= (+ (- al r) r) al))))
(sg4-law! 'r '(- al r))
(sg4-law! '(- al r) 'r)
(dk-cite! 'group-carrier-closed-opr 'g '(phi r) '(phi (- al r)))
(dk-cite! 'group-carrier-closed-opr 'g '(phi (- al r)) '(phi r))
(dk-conj-close!
 (lambda ()
   (let* ((g0 (dk-goal)) (prod (cadr g0)) (sum (if (equal? (cadr prod) '(phi r)) '(+ r (- al r)) '(+ (- al r) r))))
     (subst (list '= prod (list 'phi sum)))
     (subst (list '= sum 'al))
     (sg4-ass-rfl!))))
(qed 'segment-complement)
(topic! 'segment-complement 'algebra)

(sp (make-wff (sg4-forall '(g al phi r) (sg4-implies (append sg4-hyps (sg4-unit 'r))
   (list '= (sg4-op '(phi r) sg4-c) (sg4-op sg4-c '(phi r)))))))
(dk-peel!)
(sg4-base!)
(dk-real! '(- al r))
(dk-have! '(<= 0 (- al r)) (lambda () (dk-ineq! '(<= r al))))
(dk-have! '(<= (- al r) al) (lambda () (dk-ineq! '(<= 0 r))))
(sg4-cc! 'r) (sg4-cc! '(- al r))
(dk-split-all! (list (dk-cite! 'segment-complement 'g 'al 'phi 'r)))
(let ((p '(phi r)) (q '(phi (- al r))))
  (dk-cite! 'group-carrier-closed-opr 'g p q) (dk-cite! 'group-carrier-closed-opr 'g q p)
  (dk-cite! 'group-carrier-closed-opr 'g p (sg4-op q p)) (dk-cite! 'group-carrier-closed-opr 'g (sg4-op p q) p)
  ;; phi(r) c = phi(r) (q phi(r)) = (phi(r) q) phi(r) = c phi(r)
  (dk-have! (list '= (sg4-op p sg4-c) (sg4-op p (sg4-op q p))) (lambda () (subst (list '= sg4-c (sg4-op q p))) (sg4-ass-rfl!)))
  (dk-cite! 'group-assoc 'g p q p)
  (subst (list '= (sg4-op p sg4-c) (sg4-op p (sg4-op q p))))
  (subst (list '= (sg4-op p (sg4-op q p)) (sg4-op (sg4-op p q) p)))
  (subst (list '= (sg4-op p q) sg4-c))
  (sg4-ass-rfl!))
(qed 'segment-commutes-with-end)
(topic! 'segment-commutes-with-end 'algebra)

(sp (make-wff (sg4-forall '(g al phi r1 r2) (sg4-implies (append sg4-hyps (sg4-unit 'r1) (sg4-unit 'r2) (list '(<= al (+ r1 r2))))
   (list '= (sg4-op '(phi r1) '(phi r2)) (sg4-op sg4-c '(phi (- (+ r1 r2) al))))))))
(dk-peel!)
(sg4-base!)
(let* ((d '(- (+ r1 r2) al)) (a1 '(- al r1)))
  (dk-real! d) (dk-real! a1)
  (dk-have! (list '<= 0 d) (lambda () (dk-ineq! '(<= al (+ r1 r2)))))
  (dk-have! (list '<= d 'al) (lambda () (dk-ineq! '(<= r1 al) '(<= r2 al))))
  (dk-have! (list '<= 0 a1) (lambda () (dk-ineq! '(<= r1 al))))
  (dk-have! (list '<= a1 'al) (lambda () (dk-ineq! '(<= 0 r1))))
  (sg4-cc! 'r1) (sg4-cc! 'r2) (sg4-cc! d) (sg4-cc! a1)
  (dk-real! (list '+ a1 d))
  (dk-have! (list '= (list '+ a1 d) 'r2) (lambda () (crs)))
  (dk-have! (list '<= (list '+ a1 d) 'al) (lambda () (dk-ineq! (list '= (list '+ a1 d) 'r2) '(<= r2 al))))
  (sg4-law! a1 d)
  (dk-rewrite-h! (list '= (list 'phi (list '+ a1 d)) (sg4-op (list 'phi a1) (list 'phi d))) (list '+ a1 d) 'r2)
  (dk-split-all! (list (dk-cite! 'segment-complement 'g 'al 'phi 'r1)))
  (let ((p '(phi r1)) (q (list 'phi a1)) (pd (list 'phi d)))
    (dk-cite! 'group-carrier-closed-opr 'g q pd) (dk-cite! 'group-carrier-closed-opr 'g p q)
    (dk-cite! 'group-carrier-closed-opr 'g sg4-c pd)
    (dk-cite! 'group-assoc 'g p q pd)
    (subst (list '= '(phi r2) (sg4-op q pd)))
    (subst (list '= (sg4-op p (sg4-op q pd)) (sg4-op (sg4-op p q) pd)))
    (subst (list '= (sg4-op p q) sg4-c))
    (sg4-ass-rfl!)))
(qed 'segment-overflow)
(topic! 'segment-overflow 'algebra)
