;;; ccr1109a2-val.scm -- wave of 2026-11-09/10 (agent CCR-1109-A2), wired 2026-11-10 from scratchpad/ccr1109a2/ccr1109a2-val.scm.
;;; Library: complex-analysis.

;;; ccr1109a2-val.scm -- CCR.pdf Proposition 1.46 (equivalent valuations): the directions (v) => (vi), (vi) => (i)
;;; and (i) => (iii).  With ccr1109a-nv.scm (CCR-1109-A: (ii) <=> (iii) <=> (iv) <=> (v), (vi) => (v)) all six
;;; items are equivalent.  Agent CCR-1109-A2, wave 2026-11-09.  Destination: theorem-library/ccr1109a2-val.scm.
;;; Library: the same as ccr1109a-nv (complex-analysis as delivered; it also cites log-monotone and
;;; log-nonneg-of-ge-one of gamma-function, complex-analysis).  Helper prefix c9v-.
;;;
;;; TWO VALUATIONS ON ONE FIELD are two NV fields K1, K2 with the same carrier and operations (the convention
;;; of ccr1109a-nv).  The notes' "pick an arbitrary non-zero a" reads "a with |a|_2 > 1" (fixed silently); when
;;; no such a exists both valuations are trivial and alpha = 1.
;;;
;;; (v) => (vi).  With |a|_2 > 1 (so |a|_1 > 1), alpha = log|a|_1 / log|a|_2.  For |x|_2 >= 1 put
;;; u_k = log|x|_k / log|a|_k >= 0.  For m, n in NN, n u_k < m iff |x^n|_k < |a^m|_k (c9v-pow-lt-iff) iff
;;; |x^n b|_k < 1 with b = (a^m)^-1 (rr-prod-lt-one-iff), and (iii) makes the last condition the same for k = 1, 2;
;;; so u_1 and u_2 have the same natural cuts and are equal (rr-cut-eq, an archimedean argument).  For |x|_2 < 1
;;; the inverse of x has |.|_2 > 1, and RPOW-STAR is multiplicative in the base.
;;;
;;; (i), "the topologies are equivalent", is read as the notes use it: NF-METRIC-SPACE(K1) and NF-METRIC-SPACE(K2)
;;; have the same open sets (IS-OPEN).  (vi) => (i): balls nest, B_1(c, r^alpha) c B_2(c, r) and
;;; B_2(c, r^(1/alpha)) c B_1(c, r) (nv-ball-transfer-pow / -root), and metric-open-transfer (a general metric
;;; lemma: ball inclusions at every centre and radius transfer openness).  (i) => (iii): the notes' argument (A);
;;; B_2(0, 1) is |.|_1-open, so it holds some B_1(0, r); |a|_1 < 1 gives |a|_1^N < r (rr-power-decay), so a^N lies
;;; in B_2(0, 1), |a|_2^N < 1, and |a|_2 < 1 (rr-power-ge-one); the converse by symmetry (nv-open-lt-one).
;;;
;;; LOAD WINDOW: after theorem-library/ccr1109a-nv (ccr-1-46-ii-iii, ccr-1-46-iii-iv, ccr-1-46-ii-v,
;;; nf-inverse-norm-lt-one-iff) and gamma-function (log-monotone, log-nonneg-of-ge-one), hence after ccr2-nv,
;;; rpow-star, metric-open-sets and ball-is-open.  Nothing cites it.

;;; ---------------------------------------------------------------------
;;; 0. Real lemmas.

;; strict cancellation of a positive factor
(sp (make-wff '(FORALL cvp (IMPLIES (IN cvp RR) (FORALL cvm (IMPLIES (IN cvm RR) (FORALL cvl (IMPLIES (IN cvl RR)
  (IMPLIES (< 0 cvl) (IFF (< (* cvp cvl) (* cvm cvl)) (< cvp cvm)))))))))))
(dk-peel!)
(dk-rr-mul! 'cvp 'cvl) (dk-rr-mul! 'cvm 'cvl)
(dk-iff! (lambda (g) (equal? g '(< cvp cvm)))
  (lambda ()
    (pbc)
    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'cvp 'cvm))
    (dk-have! '(<= 0 cvl) (lambda () (dk-ineq! '(< 0 cvl))))
    (dk-chain-ass! (dk-cite! 'rr-mul-le-right 'cvm 'cvp 'cvl))
    (dk-absurd! '(<= (* cvm cvl) (* cvp cvl)) '(< (* cvp cvl) (* cvm cvl))))
  (lambda ()
    (dk-type! '(- cvm cvp))
    (dk-have! '(< 0 (- cvm cvp)) (lambda () (dk-ineq! '(< cvp cvm))))
    (dk-chain-ass! (dk-cite! 'rr-mul-pos '(- cvm cvp) 'cvl))
    (dk-rr-mul! '(- cvm cvp) 'cvl)
    (dk-have! '(= (* (- cvm cvp) cvl) (- (* cvm cvl) (* cvp cvl))) (lambda () (crs)))
    (dk-ineq! '(< 0 (* (- cvm cvp) cvl)) '(= (* (- cvm cvp) cvl) (- (* cvm cvl) (* cvp cvl))))))
(qed 'rr-mul-lt-cancel-iff)

;; q r = 1, q > 0:  p q < 1 iff p < r
(sp (make-wff '(FORALL cvp (IMPLIES (IN cvp RR) (FORALL cvq (IMPLIES (IN cvq RR) (FORALL cvr (IMPLIES (IN cvr RR)
  (IMPLIES (< 0 cvq) (IMPLIES (= (* cvq cvr) 1) (IFF (< (* cvp cvq) 1) (< cvp cvr))))))))))))
(dk-peel!)
(dk-rr-mul! 'cvp 'cvq) (dk-rr-mul! 'cvr 'cvq) (dk-rr-mul! 'cvq 'cvr)
(dk-have! '(= (* cvr cvq) 1) (lambda () (dk-have! '(= (* cvr cvq) (* cvq cvr)) (lambda () (crs))) (dk-ineq! '(= (* cvr cvq) (* cvq cvr)) '(= (* cvq cvr) 1))))
(let* ((i0 (dk-chain-ass! (dk-cite! 'rr-mul-lt-cancel-iff 'cvp 'cvr 'cvq)))
       (i1 (dk-rewrite-h! i0 '(* cvr cvq) 1)))
  (dk-close-if-asm!))
(qed 'rr-prod-lt-one-iff)

;; for t, s > 0: t < s iff log t < log s
(sp (make-wff '(FORALL cvt (IMPLIES (IN cvt RR) (FORALL cvs (IMPLIES (IN cvs RR)
  (IMPLIES (< 0 cvt) (IMPLIES (< 0 cvs) (IFF (< cvt cvs) (< (log cvt) (log cvs)))))))))))
(dk-peel!)
(dk-cite! 'log-in-rr 'cvt) (dk-cite! 'log-in-rr 'cvs)
(dk-iff! (lambda (g) (equal? g '(< (log cvt) (log cvs))))
  (lambda () (dk-chain-ass! (dk-cite! 'log-strictly-increasing 'cvt 'cvs)) (dk-close-if-asm!))
  (lambda ()
    (pbc)
    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'cvt 'cvs))
    (dk-chain-ass! (dk-cite! 'log-monotone 'cvs 'cvt))
    (dk-absurd! '(<= (log cvs) (log cvt)) '(< (log cvt) (log cvs)))))
(qed 'rr-log-lt-iff)

;; a natural cut separates two reals: 0 <= u < v gives m, n in NN with n u < m <= n v
(sp (make-wff '(FORALL cvu (IMPLIES (IN cvu RR) (FORALL cvv (IMPLIES (IN cvv RR) (IMPLIES (<= 0 cvu) (IMPLIES (< cvu cvv)
  (FORSOME cvm (AND (IN cvm NN) (FORSOME cvn (AND (IN cvn NN) (AND (< (* cvn cvu) cvm) (<= cvm (* cvn cvv)))))))))))))))
(dk-peel!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-type! '(- cvv cvu))
(dk-have! '(< 0 (- cvv cvu)) (lambda () (dk-ineq! '(< cvu cvv))))
(dk-chain-ass! (dk-cite! 'rr-pos-rr-of-lt '(- cvv cvu)))
(dk-type! 2)
(let* ((n (dk-skolem! (dk-chain-ass! (dk-cite! 'rr-archimedean-multiple '(- cvv cvu) 2))))
       (nd `(* ,n (- cvv cvu))) (nu `(* ,n cvu)) (nv `(* ,n cvv)))
  (dk-cite! 'nn-in-rr n)
  (dk-rr-mul! n 'cvu) (dk-rr-mul! n 'cvv) (dk-rr-mul! n '(- cvv cvu))
  (dk-have! `(<= 0 ,n) (lambda () (dk-nn!)))
  (dk-chain-ass! (dk-cite! 'rr-mul-le-right 0 n 'cvu))
  (dk-rr-mul! 0 'cvu)
  (dk-have! '(= (* 0 cvu) 0) (lambda () (crs)))
  (dk-have! `(<= 0 ,nu) (lambda () (dk-ineq! `(<= (* 0 cvu) ,nu) '(= (* 0 cvu) 0))))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-chain-ass! (dk-cite! 'rr-pos-rr-of-lt 1))
  (let* ((fl (dk-chain-ass! (dk-cite! 'rr-archimedean-floor 1)))
         (w (dk-skolem! (dk-chain-ass! (dk-apply! fl nu)))))
    (dk-cite! 'nn-in-rr w)
    (dk-rr-mul! w 1)
    (dk-have! `(= (* ,w 1) ,w) (lambda () (crs)))
    (dk-have! `(= ,nd (- ,nv ,nu)) (lambda () (crs)))
    (ew w)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew n)
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-ass!) #t)
                         ((dk-head-is? (dk-goal) '<)
                          (dk-ineq! `(< ,nu (* ,w 1)) `(= (* ,w 1) ,w)))
                         (#t (dk-ineq! `(<= (- (* ,w 1) 1) ,nu) `(= (* ,w 1) ,w) `(<= 2 ,nd) `(= ,nd (- ,nv ,nu))))))))
              (#t (error "c9v: unexpected conjunct" (dk-goal))))))))
(qed 'rr-cut-witness)

;; two nonnegative reals with the same natural cuts are equal
(define c9v-cuts
  '(FORALL cvm (IMPLIES (IN cvm NN) (FORALL cvn (IMPLIES (IN cvn NN) (IFF (< (* cvn cvu) cvm) (< (* cvn cvv) cvm)))))))
(sp (make-wff `(FORALL cvu (IMPLIES (IN cvu RR) (FORALL cvv (IMPLIES (IN cvv RR) (IMPLIES (<= 0 cvu) (IMPLIES (<= 0 cvv)
  (IMPLIES ,c9v-cuts (= cvu cvv))))))))))
(dk-peel!)
(define (c9v-sep! lo hi fwd?)
  (dk-have! `(NOT (< ,lo ,hi))
    (lambda ()
      (di)
      (let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'rr-cut-witness lo hi))))
             (n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h m))) "the inner cut")))
             (iff (dk-chain-ass! (dk-apply! c9v-cuts m n))))
        (dk-cite! 'nn-in-rr m) (dk-cite! 'nn-in-rr n)
        (dk-rr-mul! n lo) (dk-rr-mul! n hi)
        (if fwd? (dk-iff-fwd! iff) (dk-iff-bwd! iff))
        (dk-absurd! `(< (* ,n ,hi) ,m) `(<= ,m (* ,n ,hi)))))))
(c9v-sep! 'cvu 'cvv #t)
(c9v-sep! 'cvv 'cvu #f)
(dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'cvu 'cvv))
(dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'cvv 'cvu))
(dk-ineq! '(<= cvv cvu) '(<= cvu cvv))
(qed 'rr-cut-eq)

;;; ---------------------------------------------------------------------
;;; 1. Field lemmas.

;; a ring identity in K over the variables VS (each in CARR K)
(define (c9v-crs-at! k vs)
  (let ((view `(NORMED-FIELD-AS-COMMUTATIVE-RING ,k)))
    (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring k)
    (for-each (lambda (r) (dk-cite! r k))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (u)
                (dk-have! `(IN ,u (CARR ,view)) (lambda () (subst `(= (CARR ,view) (CARR ,k))) (dk-ass!))))
              vs)
    (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op ,k)) (subst `(= (,op ,k) (,op ,view)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))
(define (c9v-view k) `(NORMED-FIELD-AS-COMMUTATIVE-RING ,k))
(define (c9v-pw k x n) `(RING-POWER ,(c9v-view k) ,x ,n))
(define (c9v-n k x) `((FNRM ,k) ,x))
(define (c9v-view! k)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring k)
  (dk-cite! 'commutative-ring-is-ring (c9v-view k))
  (for-each (lambda (r) (dk-cite! r k))
            '(normed-field-ring-view-carr normed-field-ring-view-mul normed-field-ring-view-one)))
(define (c9v-in-view! k x)
  (dk-have! `(IN ,x (CARR ,(c9v-view k))) (lambda () (subst `(= (CARR ,(c9v-view k)) (CARR ,k))) (dk-ass!))))
;; x^n in CARR K, its norm real and nonnegative (x in CARR K, n in NN in context)
(define (c9v-pw-type! k x n)
  (c9v-view! k)
  (c9v-in-view! k x)
  (dk-cite! 'ring-power-type (c9v-view k) x n)
  (dk-have! `(IN ,(c9v-pw k x n) (CARR ,k)) (lambda () (subst `(= (CARR ,k) (CARR ,(c9v-view k)))) (dk-ass!)))
  (dk-cite! 'nf-norm-in-rr k (c9v-pw k x n))
  (dk-cite! 'nf-norm-nonneg k (c9v-pw k x n)))

;; |x^n| < |a^m| iff n u < m, where u log|a| = log|x|, |x| > 0, |a| > 1
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL x (IMPLIES (IN x (CARR K)) (FORALL cva (IMPLIES (IN cva (CARR K))
  (FORALL cvu (IMPLIES (IN cvu RR) (IMPLIES (< 0 ((FNRM K) x)) (IMPLIES (< 1 ((FNRM K) cva))
  (IMPLIES (= (* cvu (log ((FNRM K) cva))) (log ((FNRM K) x)))
  (FORALL cvm (IMPLIES (IN cvm NN) (FORALL cvn (IMPLIES (IN cvn NN)
    (IFF (< ((FNRM K) ,(c9v-pw 'K 'x 'cvn)) ((FNRM K) ,(c9v-pw 'K 'cva 'cvm))) (< (* cvn cvu) cvm)))))))))))))))))))
(dk-peel!)
(let* ((g (dk-goal))
       (n (cadddr (cadr (cadr (cadr g)))))
       (m (cadddr (cadr (caddr (cadr g)))))
       (nx (c9v-n 'K 'x)) (na (c9v-n 'K 'cva)) (la `(log ,na)) (lx `(log ,nx))
       (tn `(RPOW-STAR ,nx ,n)) (sm `(RPOW-STAR ,na ,m)))
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-cite! 'nf-norm-in-rr 'K 'x) (dk-cite! 'nf-norm-in-rr 'K 'cva)
  (dk-have! `(< 0 ,na) (lambda () (dk-ineq! `(< 1 ,na))))
  (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr m)
  (dk-cite! 'log-in-rr nx) (dk-cite! 'log-in-rr na)
  (dk-chain-ass! (dk-cite! 'log-pos-above-one na))
  (subst (dk-cite! 'nv-pow-norm-power 'K 'x n))
  (subst (dk-cite! 'nv-pow-norm-power 'K 'cva m))
  (dk-chain-ass! (dk-cite! 'rpow-star-nat n nx))
  (dk-chain-ass! (dk-cite! 'rpow-star-nat m na))
  (subst `(= (power ,nx ,n) ,tn))
  (subst `(= (power ,na ,m) ,sm))
  (dk-chain-ass! (dk-cite! 'rpow-star-pos nx n))
  (dk-chain-ass! (dk-cite! 'rpow-star-pos na m))
  (dk-chain-ass! (dk-cite! 'rpow-star-in-rr nx n))
  (dk-chain-ass! (dk-cite! 'rpow-star-in-rr na m))
  (let* ((i0 (dk-chain-ass! (dk-cite! 'rr-log-lt-iff tn sm)))
         (e1 (dk-chain-ass! (dk-cite! 'log-rpow-star nx n)))
         (e2 (dk-chain-ass! (dk-cite! 'log-rpow-star na m)))
         (i1 (dk-rewrite-h! (dk-rewrite-h! i0 `(log ,tn) `(* ,n ,lx)) `(log ,sm) `(* ,m ,la))))
    (dk-rr-mul! n 'cvu) (dk-rr-mul! `(* ,n cvu) la) (dk-rr-mul! m la) (dk-rr-mul! n lx)
    (dk-have! `(= (* ,n ,lx) (* (* ,n cvu) ,la))
      (lambda () (subst `(= ,lx (* cvu ,la))) (crs)))
    (let* ((i2 (dk-rewrite-h! i1 `(* ,n ,lx) `(* (* ,n cvu) ,la)))
           (i3 (dk-chain-ass! (dk-cite! 'rr-mul-lt-cancel-iff `(* ,n cvu) m la))))
      (dk-only! i2 i3)
      (prop))))
(qed 'c9v-pow-lt-iff)

;;; ---------------------------------------------------------------------
;;; 2. Two valuations on one field.

(define c9v-same
  '((IS-NV-FIELD K1) (IS-NV-FIELD K2) (== (CARR K2) (CARR K1)) (= (ADD K2) (ADD K1)) (= (NEG K2) (NEG K1))
    (= (MUL K2) (MUL K1)) (= (ZERO K2) (ZERO K1)) (= (ONE K2) (ONE K1))))
(define (c9v-curry hs body) (if (null? hs) body `(IMPLIES ,(car hs) ,(c9v-curry (cdr hs) body))))
(define (c9v-p rel)
  (let ((r (lambda (t) (case rel ((gt) `(< 1 ,t)) ((lt) `(< ,t 1)) ((ge) `(<= 1 ,t)) ((le) `(<= ,t 1))))))
    `(FORALL cva (IMPLIES (IN cva (CARR K1)) (IFF ,(r (c9v-n 'K1 'cva)) ,(r (c9v-n 'K2 'cva)))))))
(define (c9v-setup!)
  (dk-cite! 'nv-field-normed 'K1) (dk-cite! 'nv-field-normed 'K2)
  (for-each (lambda (k) (dk-cite! 'nf-zero-in-carr k) (dk-cite! 'nf-one-in-carr k)
                        (dk-cite! 'nf-norm-in-rr k `(ZERO ,k)) (dk-cite! 'nf-norm-in-rr k `(ONE ,k)))
            '(K1 K2))
  (fact 'rr-one-in) (fact 'rr-zero-in))
(define (c9v-both! x)
  (dk-have! `(IN ,x (CARR K2)) (lambda () (subst '(== (CARR K2) (CARR K1))) (dk-close-if-asm!)))
  (for-each (lambda (k) (dk-cite! 'nf-norm-in-rr k x) (dk-cite! 'nf-norm-nonneg k x)) '(K1 K2)))
;; P REL in context: land its instance at X and return it
(define (c9v-at! rel x) (dk-chain-ass! (dk-apply! (c9v-p rel) x)))

;; the powers of the two views agree
(sp (make-wff `(FORALL cvn (IMPLIES (IN cvn NN) (FORALL K1 (FORALL K2 ,(c9v-curry c9v-same
  `(FORALL x (IMPLIES (IN x (CARR K1)) (= ,(c9v-pw 'K1 'x 'cvn) ,(c9v-pw 'K2 'x 'cvn)))))))))))
(let* ((r (dk-ni-fixed! '(K1 K2 x))) (base (cdr (assq 'base r))) (step (cdr (assq 'step r))))
  (dk-focus! base)
  (dk-peel!)
  (c9v-setup!)
  (c9v-both! 'x)
  (c9v-view! 'K1) (c9v-view! 'K2)
  (subst (dk-cite! 'ring-power-zero (c9v-view 'K1) 'x))
  (subst (dk-cite! 'ring-power-zero (c9v-view 'K2) 'x))
  (subst `(= (ONE ,(c9v-view 'K1)) (ONE K1)))
  (subst `(= (ONE ,(c9v-view 'K2)) (ONE K2)))
  (subst '(= (ONE K2) (ONE K1)))
  (dk-cite! 'nf-one-in-carr 'K1)
  (rfl)
  (dk-focus! step)
  (dk-peel!)
  (let* ((nv (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (symbol? (cadr h)) (eq? (caddr h) 'NN))) "n")))
         (ih (dk-pick (lambda (h) (and (dk-head-is? h '=) (dk-contains? h 'RING-POWER))) "the IH")))
    (c9v-setup!)
    (c9v-both! 'x)
    (c9v-pw-type! 'K1 'x nv) (c9v-pw-type! 'K2 'x nv)
    (subst (dk-cite! 'ring-power-succ (c9v-view 'K1) 'x nv))
    (subst (dk-cite! 'ring-power-succ (c9v-view 'K2) 'x nv))
    (subst `(= (MUL ,(c9v-view 'K1)) (MUL K1)))
    (subst `(= (MUL ,(c9v-view 'K2)) (MUL K2)))
    (subst '(= (MUL K2) (MUL K1)))
    (subst ih)
    (dk-have! `(IN ,(c9v-pw 'K2 'x nv) (CARR K1)) (lambda () (subst '(= (CARR K1) (CARR K2))) (dk-ass!)))
    (dk-cite! 'nf-mul-in-carr 'K1 (c9v-pw 'K2 'x nv) 'x)
    (rfl)))
(qed 'c9v-pow-same-ind)

;; the >= 1 case: |a|_2 > 1, |x|_2 >= 1 give |x|_1 = |x|_2^alpha, alpha = log|a|_1 / log|a|_2
(define (c9v-al a) `(* (log ((FNRM K1) ,a)) (recip (log ((FNRM K2) ,a)))))
(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same `(IMPLIES ,(c9v-p 'lt)
  (FORALL cva (IMPLIES (IN cva (CARR K1)) (IMPLIES (< 1 ((FNRM K2) cva)) (IMPLIES (< 1 ((FNRM K1) cva))
  (FORALL x (IMPLIES (IN x (CARR K1)) (IMPLIES (<= 1 ((FNRM K2) x)) (IMPLIES (<= 1 ((FNRM K1) x))
    (= ((FNRM K1) x) (RPOW-STAR ((FNRM K2) x) ,(c9v-al 'cva)))))))))))))))))
(dk-peel!)
(c9v-setup!)
(c9v-both! 'cva) (c9v-both! 'x)
(define c9v-l1 `(log ,(c9v-n 'K1 'cva)))
(define c9v-l2 `(log ,(c9v-n 'K2 'cva)))
(define c9v-x1 `(log ,(c9v-n 'K1 'x)))
(define c9v-x2 `(log ,(c9v-n 'K2 'x)))
(for-each (lambda (t) (dk-cite! 'log-in-rr t)) (list (c9v-n 'K1 'cva) (c9v-n 'K2 'cva) (c9v-n 'K1 'x) (c9v-n 'K2 'x)))
(dk-chain-ass! (dk-cite! 'log-pos-above-one (c9v-n 'K1 'cva)))
(dk-chain-ass! (dk-cite! 'log-pos-above-one (c9v-n 'K2 'cva)))
(dk-chain-ass! (dk-cite! 'log-nonneg-of-ge-one (c9v-n 'K1 'x)))
(dk-chain-ass! (dk-cite! 'log-nonneg-of-ge-one (c9v-n 'K2 'x)))
(for-each (lambda (k) (dk-have! `(< 0 ,(c9v-n k 'x)) (lambda () (dk-ineq! `(<= 1 ,(c9v-n k 'x)))))) '(K1 K2))
(for-each (lambda (k) (dk-have! `(< 0 ,(c9v-n k 'cva)) (lambda () (dk-ineq! `(< 1 ,(c9v-n k 'cva)))))) '(K1 K2))
;; r_k = 1 / log|a|_k, named
(define (c9v-recip! l)
  (dk-have-and! `(IN ,l RR) `(NOT (= ,l 0)))
  (dk-chain-ass! (dk-cite! 'rr-recip-closed l))
  (dk-chain-ass! (dk-cite! 'rr-recip-inverse l))
  (dk-chain-ass! (dk-cite! 'rr-recip-pos l))
  (let ((r (dk-name! `(recip ,l))))
    (dk-have! `(= (* ,l ,r) 1) (lambda () (subst `(= ,r (recip ,l))) (dk-ass!)))
    (dk-have! `(< 0 ,r) (lambda () (subst `(= ,r (recip ,l))) (dk-ass!)))
    r))
(dk-have! `(NOT (= ,c9v-l1 0)) (lambda () (di) (dk-absurd! `(= ,c9v-l1 0) `(< 0 ,c9v-l1))))
(dk-have! `(NOT (= ,c9v-l2 0)) (lambda () (di) (dk-absurd! `(= ,c9v-l2 0) `(< 0 ,c9v-l2))))
(define c9v-r1 (c9v-recip! c9v-l1))
(define c9v-r2 (c9v-recip! c9v-l2))
(define c9v-u1 `(* ,c9v-x1 ,c9v-r1))
(define c9v-u2 `(* ,c9v-x2 ,c9v-r2))
;; u_k real, nonnegative, u_k log|a|_k = log|x|_k
(define (c9v-u! u xk lk rk)
  (dk-rr-mul! xk rk)
  (dk-rr-mul! 0 rk)
  (dk-have! `(<= 0 ,rk) (lambda () (dk-ineq! `(< 0 ,rk))))
  (dk-chain-ass! (dk-cite! 'rr-mul-le-right 0 xk rk))
  (dk-have! `(= (* 0 ,rk) 0) (lambda () (crs)))
  (dk-have! `(<= 0 ,u) (lambda () (dk-ineq! `(<= (* 0 ,rk) ,u) `(= (* 0 ,rk) 0))))
  (dk-rr-mul! u lk) (dk-rr-mul! lk rk) (dk-rr-mul! xk `(* ,lk ,rk))
  (dk-have! `(= (* ,u ,lk) ,xk)
    (lambda ()
      (dk-have! `(= (* ,u ,lk) (* ,xk (* ,lk ,rk))) (lambda () (crs)))
      (subst `(= (* ,u ,lk) (* ,xk (* ,lk ,rk))))
      (subst `(= (* ,lk ,rk) 1))
      (crs))))
(c9v-u! c9v-u1 c9v-x1 c9v-l1 c9v-r1)
(c9v-u! c9v-u2 c9v-x2 c9v-l2 c9v-r2)
;; the cuts agree
(dk-have! `(FORALL cvm (IMPLIES (IN cvm NN) (FORALL cvn (IMPLIES (IN cvn NN)
             (IFF (< (* cvn ,c9v-u1) cvm) (< (* cvn ,c9v-u2) cvm))))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (g (dk-goal))
           (n (cadr (cadr (cadr g))))
           (m (caddr (cadr g))))
      (c9v-pw-type! 'K1 'x n) (c9v-pw-type! 'K1 'cva m)
      (c9v-pw-type! 'K2 'x n) (c9v-pw-type! 'K2 'cva m)
      (let* ((p (c9v-pw 'K1 'x n)) (q (c9v-pw 'K1 'cva m))
             (f1 (dk-chain-ass! (dk-cite! 'c9v-pow-lt-iff 'K1 'x 'cva c9v-u1)))
             (f1i (dk-chain-ass! (dk-apply! f1 m n)))
             (f2 (dk-chain-ass! (dk-cite! 'c9v-pow-lt-iff 'K2 'x 'cva c9v-u2)))
             (f2i (dk-chain-ass! (dk-apply! f2 m n)))
             (e1 (dk-chain-ass! (dk-cite! 'c9v-pow-same-ind n 'K1 'K2 'x)))
             (e2 (dk-chain-ass! (dk-cite! 'c9v-pow-same-ind m 'K1 'K2 'cva)))
             (f2j (dk-rewrite-h! (dk-rewrite-h! f2i (c9v-pw 'K2 'x n) p) (c9v-pw 'K2 'cva m) q)))
        (c9v-both! p) (c9v-both! q)
        ;; q /= 0, its inverse b
        (dk-cite! 'nn-in-rr m)
        (dk-chain-ass! (dk-cite! 'rpow-star-pos (c9v-n 'K1 'cva) m))
        (dk-chain-ass! (dk-cite! 'rpow-star-in-rr (c9v-n 'K1 'cva) m))
        (dk-cite! 'power-real-closed (c9v-n 'K1 'cva) m)
        (let* ((pn (dk-cite! 'nv-pow-norm-power 'K1 'cva m)))
          (dk-have! `(NOT (= ,q (ZERO K1)))
            (lambda ()
              (di)
              (dk-cite! 'nf-norm-of-zero 'K1)
              (dk-chain-ass! (dk-cite! 'rpow-star-nat m (c9v-n 'K1 'cva)))
              (dk-absurd! (dk-rewrite-h! pn q '(ZERO K1)) `(= ((FNRM K1) (ZERO K1)) 0)
                          `(= (RPOW-STAR ,(c9v-n 'K1 'cva) ,m) (power ,(c9v-n 'K1 'cva) ,m))
                          `(< 0 (RPOW-STAR ,(c9v-n 'K1 'cva) ,m))))))
        (let* ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K1 q))))
               (c `((MUL K1) ,p ,b)))
          (c9v-both! b)
          (dk-cite! 'nf-mul-in-carr 'K1 p b)
          (c9v-both! c)
          (dk-have! `(= ((MUL K2) ,q ,b) (ONE K2))
            (lambda () (subst '(= (MUL K2) (MUL K1))) (subst '(= (ONE K2) (ONE K1))) (dk-ass!)))
          (let* ((iii (c9v-at! 'lt c))
                 (res (map (lambda (k)
                        (let* ((mb (dk-cite! 'nf-norm-mult k q b))
                               (mc (dk-cite! 'nf-norm-mult k p b))
                               (one (dk-cite! 'nf-norm-one k))
                               (qb1 (dk-rewrite-h! (dk-rewrite-h! mb `((MUL ,k) ,q ,b) `(ONE ,k)) `((FNRM ,k) (ONE ,k)) 1))
                               (bq (begin (dk-rr-mul! (c9v-n k b) (c9v-n k q)) (dk-rr-mul! (c9v-n k q) (c9v-n k b))
                                          (dk-have! `(= (* ,(c9v-n k b) ,(c9v-n k q)) 1)
                                            (lambda () (dk-have! `(= (* ,(c9v-n k b) ,(c9v-n k q)) (* ,(c9v-n k q) ,(c9v-n k b))) (lambda () (crs)))
                                                       (dk-ineq! `(= (* ,(c9v-n k b) ,(c9v-n k q)) (* ,(c9v-n k q) ,(c9v-n k b))) qb1)))))
                               (bpos (dk-have! `(< 0 ,(c9v-n k b))
                                       (lambda ()
                                         (pbc)
                                         (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 0 (c9v-n k b)))
                                         (dk-have! `(= ,(c9v-n k b) 0) (lambda () (dk-ineq! `(<= ,(c9v-n k b) 0) `(<= 0 ,(c9v-n k b)))))
                                         (dk-absurd! (dk-rewrite-h! `(= (* ,(c9v-n k b) ,(c9v-n k q)) 1) (c9v-n k b) 0)))))
                               (r3 (dk-chain-ass! (dk-cite! 'rr-prod-lt-one-iff (c9v-n k p) (c9v-n k b) (c9v-n k q)))))
                          (dk-rewrite-h! r3 `(* ,(c9v-n k p) ,(c9v-n k b)) (c9v-n k `((MUL ,k) ,p ,b)))))
                      '(K1 K2))))
            ;; in K2 the product is ((MUL K1) p b): rewrite (MUL K2) inside the K2 instance
            (let ((r2 (dk-rewrite-h! (cadr res) '(MUL K2) '(MUL K1))))
              (dk-only! f1i f2j iii (car res) r2)
              (prop))))))))
;; the cut equality
(dk-chain-ass! (dk-cite! 'rr-cut-eq c9v-u1 c9v-u2))
(define c9v-alx (c9v-al 'cva))
(dk-chain-ass! (dk-cite! 'rr-mul-in-rr c9v-l1 c9v-r2))
(dk-have! `(IN ,c9v-alx RR) (lambda () (subst `(= (recip ,c9v-l2) ,c9v-r2)) (dk-ass!)))
(dk-have! `(= (* ,c9v-alx ,c9v-x2) ,c9v-x1)
  (lambda ()
    (subst `(= (recip ,c9v-l2) ,c9v-r2))
    (dk-have! `(= (* (* ,c9v-l1 ,c9v-r2) ,c9v-x2) (* ,c9v-u2 ,c9v-l1)) (lambda () (crs)))
    (subst `(= (* (* ,c9v-l1 ,c9v-r2) ,c9v-x2) (* ,c9v-u2 ,c9v-l1)))
    (subst `(= ,c9v-u2 ,c9v-u1))
    (dk-ass!)))
(subst (dk-chain-ass! (dk-cite! 'rpow-star-value (c9v-n 'K2 'x) c9v-alx)))
(subst `(= (* ,c9v-alx ,c9v-x2) ,c9v-x1))
(subst (dk-chain-ass! (dk-cite! 'r-exp-log (c9v-n 'K1 'x))))
(rfl)
(qed 'c9v-ge-one)

;;; ---------------------------------------------------------------------
;;; 3. Proposition 1.46, (v) => (vi).

(define c9v-vi
  '(FORSOME cnal (AND (IN cnal RR) (AND (< 0 cnal)
     (FORALL cva (IMPLIES (IN cva (CARR K1)) (= ((FNRM K1) cva) (RPOW-STAR ((FNRM K2) cva) cnal))))))))
(define c9v-big '(FORSOME cvw_ (AND (IN cvw_ (CARR K1)) (< 1 ((FNRM K2) cvw_)))))

;; x /= 0 in CARR K1, |x|_2 < 1: the inverse y of x, with |y|_2 > 1 and |y|_1 > 1 (from (ii)); returns y
(define (c9v-inv! x)
  (let* ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K1 x)))))
    (c9v-both! y)
    (dk-have! `(= ((MUL K2) ,x ,y) (ONE K2))
      (lambda () (subst '(= (MUL K2) (MUL K1))) (subst '(= (ONE K2) (ONE K1))) (dk-ass!)))
    (dk-have! `(= ((MUL K1) ,y ,x) (ONE K1))
      (lambda () (subst `(= (ONE K1) ((MUL K1) ,x ,y))) (c9v-crs-at! 'K1 (list x y))))
    (dk-have! `(= ((MUL K2) ,y ,x) (ONE K2))
      (lambda () (subst '(= (MUL K2) (MUL K1))) (subst '(= (ONE K2) (ONE K1))) (dk-ass!)))
    (dk-iff-fwd! (dk-chain-ass! (dk-cite! 'nf-inverse-norm-lt-one-iff 'K2 y x)))
    y))

(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same `(IMPLIES ,(c9v-p 'le) ,c9v-vi))))))
(dk-peel!)
(c9v-setup!)
(dk-iff-bwd! (dk-chain-ass! (dk-cite! 'ccr-1-46-ii-v 'K1 'K2)))
(dk-iff-fwd! (dk-chain-ass! (dk-cite! 'ccr-1-46-ii-iii 'K1 'K2)))
(dk-iff-fwd! (dk-chain-ass! (dk-cite! 'ccr-1-46-iii-iv 'K1 'K2)))
(dk-cite! 'nf-norm-of-zero 'K1) (dk-cite! 'nf-norm-of-zero 'K2)
(use-em c9v-big
  ;; a nontrivial valuation: alpha = log|a|_1 / log|a|_2
  (lambda ()
    (let* ((a (dk-skolem! c9v-big))
           (al (c9v-al a))
           (l1 `(log ,(c9v-n 'K1 a))) (l2 `(log ,(c9v-n 'K2 a))))
      (c9v-both! a)
      (dk-iff-bwd! (c9v-at! 'gt a))
      (dk-cite! 'log-in-rr (c9v-n 'K1 a)) (dk-cite! 'log-in-rr (c9v-n 'K2 a))
      (dk-chain-ass! (dk-cite! 'log-pos-above-one (c9v-n 'K1 a)))
      (dk-chain-ass! (dk-cite! 'log-pos-above-one (c9v-n 'K2 a)))
      (dk-have! `(NOT (= ,l2 0)) (lambda () (di) (dk-absurd! `(= ,l2 0) `(< 0 ,l2))))
      (dk-have-and! `(IN ,l2 RR) `(NOT (= ,l2 0)))
      (dk-chain-ass! (dk-cite! 'rr-recip-closed l2))
      (dk-chain-ass! (dk-cite! 'rr-recip-pos l2))
      (dk-chain-ass! (dk-cite! 'rr-mul-in-rr l1 `(recip ,l2)))
      (dk-chain-ass! (dk-cite! 'rr-mul-pos l1 `(recip ,l2)))
      (ew al)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((x (dk-di-var!)))
                (c9v-both! x)
                (use-em `(= ,x (ZERO K1))
                  (lambda ()
                    (dk-chain-ass! (dk-cite! 'rpow-star-zero-base al))
                    (subst `(= ,x (ZERO K1)))
                    (subst '(= (ZERO K1) (ZERO K2)))
                    (subst `(= ((FNRM K2) (ZERO K2)) 0))
                    (subst '(= (ZERO K2) (ZERO K1)))
                    (subst `(= ((FNRM K1) (ZERO K1)) 0))
                    (subst `(= (RPOW-STAR 0 ,al) 0))
                    (fact 'rr-zero-in)
                    (rfl))
                  (lambda ()
                    (use-em `(<= 1 ,(c9v-n 'K2 x))
                      (lambda ()
                        (dk-iff-bwd! (c9v-at! 'ge x))
                        (dk-chain-ass! (dk-cite! 'c9v-ge-one 'K1 'K2 a x))
                        (dk-close-if-asm!))
                      (lambda ()
                        (dk-chain-ass! (dk-cite! 'rr-not-le-lt 1 (c9v-n 'K2 x)))
                        (let* ((y (c9v-inv! x))
                               (ny1 (c9v-n 'K1 y)) (ny2 (c9v-n 'K2 y)) (nx1 (c9v-n 'K1 x)) (nx2 (c9v-n 'K2 x)))
                          (dk-iff-bwd! (c9v-at! 'gt y))
                          (dk-have! `(<= 1 ,ny2) (lambda () (dk-ineq! `(< 1 ,ny2))))
                          (dk-have! `(<= 1 ,ny1) (lambda () (dk-ineq! `(< 1 ,ny1))))
                          (let* ((gy (dk-chain-ass! (dk-cite! 'c9v-ge-one 'K1 'K2 a y)))
                                 (ry `(RPOW-STAR ,ny2 ,al)) (rx `(RPOW-STAR ,nx2 ,al)))
                            ;; |x|_k |y|_k = 1
                            (dk-have! `(= ((MUL K2) ,x ,y) (ONE K2)) (lambda () (dk-ass!)))
                            (for-each (lambda (k)
                                        (dk-cite! 'nf-norm-one k)
                                        (dk-rewrite-h! (dk-rewrite-h! (dk-cite! 'nf-norm-mult k x y) `((MUL ,k) ,x ,y) `(ONE ,k))
                                                       `((FNRM ,k) (ONE ,k)) 1))
                                      '(K1 K2))
                            ;; |x|_2 > 0
                            (dk-have! `(< 0 ,nx2)
                              (lambda ()
                                (pbc)
                                (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 0 nx2))
                                (dk-have! `(= ,nx2 0) (lambda () (dk-ineq! `(<= ,nx2 0) `(<= 0 ,nx2))))
                                (dk-absurd! (dk-rewrite-h! `(= 1 (* ,nx2 ,ny2)) nx2 0))))
                            (dk-have! `(< 0 ,ny2) (lambda () (dk-ineq! `(< 1 ,ny2))))
                            (dk-chain-ass! (dk-cite! 'rpow-star-mul-base nx2 ny2 al))
                            (dk-rr-mul! nx2 ny2)
                            (fact 'rr-zero-lt-one) (fact 'rr-one-in)
                            (let ((one (dk-chain-ass! (dk-cite! 'rpow-star-value 1 al))))
                              (fact 'log-one) (fact 'r-exp-zero)
                              (dk-cite! 'rr-mul-zero al)
                              (dk-have! `(= (RPOW-STAR 1 ,al) 1)
                                (lambda () (subst one) (subst '(= (log 1) 0)) (subst `(= (* ,al 0) 0)) (dk-close-if-asm!))))
                            (dk-chain-ass! (dk-cite! 'rpow-star-in-rr nx2 al))
                            (dk-chain-ass! (dk-cite! 'rpow-star-in-rr ny2 al))
                            (dk-have! `(= (* ,rx ,ny1) 1)
                              (lambda ()
                                (subst gy)
                                (subst `(= (* (RPOW-STAR ,nx2 ,al) (RPOW-STAR ,ny2 ,al)) (RPOW-STAR (* ,nx2 ,ny2) ,al)))
                                (subst `(= (* ,nx2 ,ny2) 1))
                                (dk-ass!)))
                            (dk-rr-mul! nx1 ny1) (dk-rr-mul! rx ny1)
                            (dk-rr-mul! rx `(* ,nx1 ,ny1)) (dk-rr-mul! nx1 `(* ,rx ,ny1))
                            (let* ((h (let ((f `(= (* ,nx1 (* ,rx ,ny1)) (* ,rx (* ,nx1 ,ny1))))) (dk-have! f (lambda () (crs))) f))
                                   (h1 (dk-rewrite-h! (dk-rewrite-h! h `(* ,rx ,ny1) 1) `(* ,nx1 ,ny1) 1)))
                              (dk-ineq! h1))))))))))))))
  ;; the trivial case: alpha = 1
  (lambda ()
    (fact 'rr-zero-lt-one)
    (ew 1)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) '<) (fact 'rr-zero-lt-one) (dk-ass!))
              ((dk-head-is? (dk-goal) 'IN) (dk-ass!))
              (#t
               (let ((x (dk-di-var!)))
                 (c9v-both! x)
                 (dk-chain-ass! (dk-cite! 'rpow-star-one 1))
                 (use-em `(= ,x (ZERO K1))
                   (lambda ()
                     (fact 'rr-zero-lt-one)
                     (dk-chain-ass! (dk-cite! 'rpow-star-zero-base 1))
                     (subst `(= ,x (ZERO K1)))
                     (subst '(= (ZERO K1) (ZERO K2)))
                     (subst `(= ((FNRM K2) (ZERO K2)) 0))
                     (subst '(= (ZERO K2) (ZERO K1)))
                     (subst `(= ((FNRM K1) (ZERO K1)) 0))
                     (subst '(= (RPOW-STAR 0 1) 0))
                     (fact 'rr-zero-in)
                     (rfl))
                   (lambda ()
                     (let ((nx1 (c9v-n 'K1 x)) (nx2 (c9v-n 'K2 x)))
                       ;; |x|_2 <= 1, else x witnesses c9v-big
                       (dk-have! `(NOT (< 1 ,nx2))
                         (lambda () (di) (dk-have! c9v-big (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!))))) (ai `(NOT ,c9v-big))))
                       ;; |x|_2 not < 1, else the inverse witnesses it
                       (dk-have! `(NOT (< ,nx2 1))
                         (lambda ()
                           (di)
                           (let ((y (c9v-inv! x)))
                             (dk-have! c9v-big (lambda () (ew y) (dk-conj-close! (lambda () (dk-ass!)))))
                             (ai `(NOT ,c9v-big)))))
                       (let* ((i2 (c9v-at! 'gt x)))
                         (dk-have! `(NOT (< 1 ,nx1)) (lambda () (di) (dk-iff-fwd! i2) (ai `(NOT (< 1 ,nx2))))))
                       (let ((i3 (c9v-at! 'lt x)))
                         (dk-have! `(NOT (< ,nx1 1)) (lambda () (di) (dk-iff-fwd! i3) (ai `(NOT (< ,nx2 1))))))
                       (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 1 nx1))
                       (dk-chain-ass! (dk-cite! 'rr-not-lt-ge nx1 1))
                       (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 1 nx2))
                       (dk-chain-ass! (dk-cite! 'rr-not-lt-ge nx2 1))
                       (dk-have! `(= ,nx2 1) (lambda () (dk-ineq! `(<= ,nx2 1) `(<= 1 ,nx2))))
                       (subst `(= ,nx2 1))
                       (subst '(= (RPOW-STAR 1 1) 1))
                       (dk-ineq! `(<= ,nx1 1) `(<= 1 ,nx1))))))))))))
(qed 'ccr-1-46-v-vi)

;;; ---------------------------------------------------------------------
;;; 4. Proposition 1.46 (i): the topologies.  "The topologies are equivalent" is read as the notes use it:
;;; the two metric spaces NF-METRIC-SPACE(K1), NF-METRIC-SPACE(K2) on the common carrier have the same open
;;; sets.  (vi) => (i) by ball inclusions (radius r^alpha one way, r^(1/alpha) the other); (i) => (iii) by the
;;; notes' argument (A): the |.|_2-ball B_2(0, 1) is |.|_1-open, so it holds a ball B_1(0, r), and |a|_1 < 1
;;; puts a power a^N in it, whence |a|_2^N < 1 and |a|_2 < 1.

(define c9v-m1 '(NF-METRIC-SPACE K1))
(define c9v-m2 '(NF-METRIC-SPACE K2))
;; every MA-ball about a point holds an MA-ball inside the MB-ball of any radius
(define (c9v-ballst ma mb)
  `(FORALL ctc_ (IMPLIES (IN ctc_ (PTS ,ma)) (FORALL ctr_ (IMPLIES (POS-RR ctr_)
     (FORSOME ctt_ (AND (POS-RR ctt_) (SUBSET (BALL ,ma ctc_ ctt_) (BALL ,mb ctc_ ctr_)))))))))
;; open in MB => open in MA
(define (c9v-opento ma mb) `(FORALL cto_ (IMPLIES (IS-OPEN ,mb cto_) (IS-OPEN ,ma cto_))))
(define c9v-i `(FORALL cto_ (IFF (IS-OPEN ,c9v-m1 cto_) (IS-OPEN ,c9v-m2 cto_))))
(define c9v-vib '(FORALL cva (IMPLIES (IN cva (CARR K1)) (= ((FNRM K1) cva) (RPOW-STAR ((FNRM K2) cva) cnal)))))

;; (SUBSET S T), (IN z S) in context: land (IN z T)
(define (c9v-sub-mem! s t z)
  (let ((iff (dk-cite! 'subset-def s t)))
    (dk-iff-fwd! iff)
    (dk-chain-ass! (dk-apply! (caddr iff) z))))
(define (c9v-dist! k c z) (dk-chain-ass! (dk-cite! 'nf-metric-distance k c z)))
(define (c9v-carriers!)
  (for-each (lambda (k) (dk-chain-ass! (dk-cite! 'nf-metric-space-is-metric-space k)) (dk-cite! 'nf-metric-carrier k))
            '(K1 K2)))
;; x in PTS(NF-METRIC-SPACE K): land x in CARR K
(define (c9v-pts->carr! k x)
  (dk-have! `(IN ,x (CARR ,k)) (lambda () (subst `(= (CARR ,k) (PTS (NF-METRIC-SPACE ,k)))) (dk-close-if-asm!))))
(define (c9v-carr->pts-goal! k) (subst `(= (PTS (NF-METRIC-SPACE ,k)) (CARR ,k))) (dk-close-if-asm!))
;; the positive real parts of POS-RR r
(define (c9v-posrr! r)
  (dk-chain-ass! (dk-cite! 'rr-pos-rr-in-rr r)) (dk-chain-ass! (dk-cite! 'rr-lt-of-pos-rr r)))
;; t = RPOW-STAR(r, s): real, positive, POS-RR
(define (c9v-rpow-pos! r s)
  (let ((t `(RPOW-STAR ,r ,s)))
    (dk-chain-ass! (dk-cite! 'rpow-star-in-rr r s))
    (dk-chain-ass! (dk-cite! 'rpow-star-pos r s))
    (dk-chain-ass! (dk-cite! 'rr-pos-rr-of-lt t))
    t))
;; strict from <= and /=
(define (c9v-strict! a b)
  (dk-have! `(< ,a ,b)
    (lambda ()
      (pbc)
      (dk-chain-ass! (dk-cite! 'rr-not-lt-ge a b))
      (dk-have! `(= ,a ,b) (lambda () (dk-ineq! `(<= ,a ,b) `(<= ,b ,a))))
      (ai `(NOT (= ,a ,b))))))

;; 4a. the general metric lemma: ball inclusions transfer openness
(sp (make-wff `(FORALL cts1 (FORALL cts2 (IMPLIES (IS-METRIC-SPACE cts1) (IMPLIES (== (PTS cts2) (PTS cts1))
   (IMPLIES ,(c9v-ballst 'cts1 'cts2) ,(c9v-opento 'cts1 'cts2))))))))
(dk-peel!)
(let* ((u (caddr (dk-goal)))
       (hb (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL) (not (dk-contains? h u)))) "the ball hypothesis"))
       (iff1 (dk-cite! 'is-open 'cts1 u)))
  (dk-iff-fwd! (dk-cite! 'is-open 'cts2 u))
  (let ((ho (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h 'FORSOME))) "the open hypothesis")))
    (dk-have! (caddr iff1)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (ass))
                    ((dk-head-is? g 'SUBSET) (subst '(= (PTS cts1) (PTS cts2))) (dk-close-if-asm!))
                    (#t
                     (let* ((y (dk-di-var!))
                            (r (dk-skolem! (dk-chain-ass! (dk-apply! ho y)))))
                       (c9v-sub-mem! u '(PTS cts2) y)
                       (dk-have! `(IN ,y (PTS cts1)) (lambda () (subst '(= (PTS cts1) (PTS cts2))) (dk-close-if-asm!)))
                       (let ((t (dk-skolem! (dk-chain-ass! (dk-apply! hb y r)))))
                         (ew t)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal))
                                 (ass)
                                 (begin
                                   (dk-chain-ass! (dk-cite! 'subset-trans `(BALL cts1 ,y ,t) `(BALL cts2 ,y ,r) u))
                                   (dk-close-if-asm!))))))))))))))
    (dk-iff-bwd! iff1)
    (dk-close-if-asm!)))
(qed 'metric-open-transfer)

;; 4b. (vi) gives the ball inclusions, both ways
(define (c9v-incl-stmt ma mb)
  `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same
     `(FORALL cnal (IMPLIES (IN cnal RR) (IMPLIES (< 0 cnal) (IMPLIES ,c9v-vib ,(c9v-ballst ma mb)))))))))
;; the common opening: returns (al c r z w vw e-src e-dst) after peeling into the SUBSET's membership
(define (c9v-incl-open! ma)
  (dk-peel!)
  (c9v-setup!)
  (c9v-carriers!)
  (let* ((al (caddr (dk-pick (lambda (h) (and (dk-head-is? h '<) (eqv? (cadr h) 0) (symbol? (caddr h)) (dk-asm? `(IN ,(caddr h) RR)))) "alpha")))
         (c (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) `(PTS ,ma)))) "the centre")))
         (r (cadr (dk-pick (lambda (h) (dk-head-is? h 'POS-RR)) "the radius")))
         (vib (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'RPOW-STAR))) "(vi)")))
    (c9v-posrr! r)
    (list al c r vib)))
;; inside the SUBSET goal: peel z, read the source ball, return (z w n1w n2w vw e1 e2) with
;; e_k : DIST_k(c, z) = |w|_k, w = c - z (K1 operations)
(define (c9v-incl-point! c t src)
  (let* ((z (dk-di-var!)))
    (dk-iff-fwd! (dk-cite! 'ball-membership `(NF-METRIC-SPACE ,src) c t z))
    (c9v-pts->carr! src z)
    (if (eq? src 'K2) (dk-have! `(IN ,z (CARR K1)) (lambda () (subst '(= (CARR K1) (CARR K2))) (dk-close-if-asm!))))
    (c9v-both! z) (c9v-both! c)
    (dk-cite! 'nf-neg-in-carr 'K1 z)
    (dk-chain-ass! (dk-cite! 'nf-add-in-carr 'K1 c `((NEG K1) ,z)))
    (let* ((w `((ADD K1) ,c ((NEG K1) ,z)))
           (_w (c9v-both! w))
           (e1 (c9v-dist! 'K1 c z))
           (e2 (dk-rewrite-h! (dk-rewrite-h! (c9v-dist! 'K2 c z) '(ADD K2) '(ADD K1)) '(NEG K2) '(NEG K1))))
      (list z w (c9v-n 'K1 w) (c9v-n 'K2 w) e1 e2))))
;; close (IN z (BALL M_dst c r)) from |w|_dst < r, e = DIST_dst(c, z) = |w|_dst
(define (c9v-incl-close! dst c r z e nw lt)
  (let ((iffb (dk-cite! 'ball-membership `(NF-METRIC-SPACE ,dst) c r z)))
    (dk-have! (caddr iffb)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (ass))
                    ((dk-head-is? g 'IN) (c9v-carr->pts-goal! dst))
                    ((dk-head-is? g '<=) (subst e) (dk-ineq! lt))
                    (#t (subst e) (di) (dk-absurd! `(= ,nw ,r) lt))))))))
    (dk-iff-bwd! iffb)
    (dk-close-if-asm!)))

(sp (make-wff (c9v-incl-stmt c9v-m1 c9v-m2)))
(let* ((o (c9v-incl-open! c9v-m1)) (al (car o)) (c (cadr o)) (r (caddr o)) (vib (cadddr o))
       (_c (c9v-pts->carr! 'K1 c))
       (t (c9v-rpow-pos! r al)))
  (ew t)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let ((iff (dk-cite! 'subset-def `(BALL ,c9v-m1 ,c ,t) `(BALL ,c9v-m2 ,c ,r))))
            (dk-have! (caddr iff)
              (lambda ()
                (let* ((p (c9v-incl-point! c t 'K1))
                       (z (car p)) (w (cadr p)) (n1w (caddr p)) (n2w (cadddr p)) (e1 (list-ref p 4)) (e2 (list-ref p 5))
                       (d1 `((DIST ,c9v-m1) ,c ,z))
                       (le1 (dk-rewrite-h! `(<= ,d1 ,t) d1 n1w))
                       (ne1 (dk-rewrite-h! `(NOT (= ,d1 ,t)) d1 n1w))
                       (vw (dk-chain-ass! (dk-apply! vib w))))
                  (dk-have! `(< ,n2w ,r)
                    (lambda ()
                      (pbc)
                      (dk-chain-ass! (dk-cite! 'rr-not-lt-ge n2w r))
                      (use-em `(< ,r ,n2w)
                        (lambda ()
                          (dk-have! `(< 0 ,n2w) (lambda () (dk-ineq! `(< 0 ,r) `(< ,r ,n2w))))
                          (dk-chain-ass! (dk-cite! 'rpow-star-in-rr n2w al))
                          (dk-chain-ass! (dk-cite! 'rpow-star-mono-base r n2w al))
                          (dk-absurd! `(< ,t (RPOW-STAR ,n2w ,al)) vw le1))
                        (lambda ()
                          (dk-chain-ass! (dk-cite! 'rr-not-lt-ge r n2w))
                          (dk-have! `(= ,n2w ,r) (lambda () (dk-ineq! `(<= ,r ,n2w) `(<= ,n2w ,r))))
                          (dk-rewrite-h! vw n2w r)
                          (ai ne1)))))
                  (c9v-incl-close! 'K2 c r z e2 n2w `(< ,n2w ,r)))))
            (dk-iff-bwd! iff)
            (dk-close-if-asm!))))))
(qed 'nv-ball-transfer-pow)

(sp (make-wff (c9v-incl-stmt c9v-m2 c9v-m1)))
(let* ((o (c9v-incl-open! c9v-m2)) (al (car o)) (c (cadr o)) (r (caddr o)) (vib (cadddr o)))
  (c9v-pts->carr! 'K2 c)
  (dk-have! `(IN ,c (CARR K1)) (lambda () (subst '(= (CARR K1) (CARR K2))) (dk-close-if-asm!)))
  (dk-have! `(NOT (= ,al 0)) (lambda () (di) (dk-absurd! `(= ,al 0) `(< 0 ,al))))
  (let* ((ra (c9v-recip! al))
         (t (c9v-rpow-pos! r ra)))
    (ew t)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (let ((iff (dk-cite! 'subset-def `(BALL ,c9v-m2 ,c ,t) `(BALL ,c9v-m1 ,c ,r))))
              (dk-have! (caddr iff)
                (lambda ()
                  (let* ((p (c9v-incl-point! c t 'K2))
                         (z (car p)) (w (cadr p)) (n1w (caddr p)) (n2w (cadddr p)) (e1 (list-ref p 4)) (e2 (list-ref p 5))
                         (d2 `((DIST ,c9v-m2) ,c ,z))
                         (le2 (dk-rewrite-h! `(<= ,d2 ,t) d2 n2w))
                         (ne2 (dk-rewrite-h! `(NOT (= ,d2 ,t)) d2 n2w))
                         (vw (dk-chain-ass! (dk-apply! vib w))))
                    (c9v-strict! n2w t)
                    (dk-have! `(< ,n1w ,r)
                      (lambda ()
                        (use-em `(= ,n2w 0)
                          (lambda ()
                            (dk-chain-ass! (dk-cite! 'rpow-star-zero-base al))
                            (let* ((v1 (dk-rewrite-h! vw n2w 0))
                                   (v2 (dk-rewrite-h! v1 `(RPOW-STAR 0 ,al) 0)))
                              (dk-ineq! v2 `(< 0 ,r))))
                          (lambda ()
                            (dk-have! `(< 0 ,n2w)
                              (lambda ()
                                (pbc)
                                (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 0 n2w))
                                (dk-have! `(= ,n2w 0) (lambda () (dk-ineq! `(<= ,n2w 0) `(<= 0 ,n2w))))
                                (ai `(NOT (= ,n2w 0)))))
                            (dk-chain-ass! (dk-cite! 'rpow-star-in-rr n2w al))
                            (let* ((mono (dk-chain-ass! (dk-cite! 'rpow-star-mono-base n2w t al)))
                                   (pw (dk-chain-ass! (dk-cite! 'rpow-star-pow r ra al))))
                              (dk-have! `(= (* ,ra ,al) (* ,al ,ra)) (lambda () (crs)))
                              (dk-have! `(= (* ,ra ,al) 1) (lambda () (subst `(= (* ,ra ,al) (* ,al ,ra))) (dk-close-if-asm!)))
                              (dk-chain-ass! (dk-cite! 'rpow-star-one r))
                              (let* ((p1 (dk-rewrite-h! mono `(RPOW-STAR ,t ,al) `(RPOW-STAR ,r (* ,ra ,al))))
                                     (p2 (dk-rewrite-h! p1 `(* ,ra ,al) 1))
                                     (p3 (dk-rewrite-h! p2 `(RPOW-STAR ,r 1) r)))
                                (dk-ineq! vw p3)))))))
                    (c9v-incl-close! 'K1 c r z e1 n1w `(< ,n1w ,r)))))
              (dk-iff-bwd! iff)
              (dk-close-if-asm!)))))))
(qed 'nv-ball-transfer-root)

;; 4c. (vi) => (i)
(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same `(IMPLIES ,c9v-vi ,c9v-i))))))
(dk-peel!)
(c9v-setup!)
(c9v-carriers!)
(let* ((u (caddr (cadr (dk-goal))))
       (al (dk-skolem! c9v-vi)))
  (dk-split-all!)
  (dk-have! `(== (PTS ,c9v-m2) (PTS ,c9v-m1))
    (lambda () (subst `(= (PTS ,c9v-m2) (CARR K2))) (subst `(= (PTS ,c9v-m1) (CARR K1))) (dk-close-if-asm!)))
  (dk-have! `(== (PTS ,c9v-m1) (PTS ,c9v-m2))
    (lambda () (subst `(= (PTS ,c9v-m2) (CARR K2))) (subst `(= (PTS ,c9v-m1) (CARR K1))) (subst '(= (CARR K1) (CARR K2))) (qrfl)))
  (dk-chain-ass! (dk-cite! 'nv-ball-transfer-pow 'K1 'K2 al))
  (dk-chain-ass! (dk-cite! 'nv-ball-transfer-root 'K1 'K2 al))
  (begin
    (dk-cite! 'metric-open-transfer c9v-m1 c9v-m2 u)
    (dk-cite! 'metric-open-transfer c9v-m2 c9v-m1 u)
    (if (dk-only! `(IMPLIES (IS-OPEN ,c9v-m2 ,u) (IS-OPEN ,c9v-m1 ,u)) `(IMPLIES (IS-OPEN ,c9v-m1 ,u) (IS-OPEN ,c9v-m2 ,u)))
        (prop))))
(qed 'ccr-1-46-vi-i)

;; 4d. open in K2's metric => open in K1's metric gives |a|_1 < 1 => |a|_2 < 1
(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same `(IMPLIES ,(c9v-opento c9v-m1 c9v-m2)
   (FORALL cva (IMPLIES (IN cva (CARR K1)) (IMPLIES (< ((FNRM K1) cva) 1) (< ((FNRM K2) cva) 1))))))))))
(dk-peel!)
(c9v-setup!)
(c9v-carriers!)
(fact 'rr-zero-lt-one)
(let* ((v (cadr (cadr (dk-goal))))
       (n1 (c9v-n 'K1 v)) (n2 (c9v-n 'K2 v))
       (bb `(BALL ,c9v-m2 (ZERO K1) 1))
       (o (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-OPEN))) "the open transfer")))
  (c9v-both! v)
  (dk-have! `(IN (ZERO K1) (CARR K2)) (lambda () (subst '(= (CARR K2) (CARR K1))) (dk-close-if-asm!)))
  (dk-have! `(IN (ZERO K1) (PTS ,c9v-m2)) (lambda () (c9v-carr->pts-goal! 'K2)))
  (dk-have! '(AND (IN 1 RR) (AND (<= 0 1) (NOT (= 0 1))))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g '<=) (dk-ineq! '(< 0 1)))
                  (#t (di) (dk-absurd! '(= 0 1) '(< 0 1)))))))))
  (dk-chain-ass! (dk-cite! 'ball-is-open c9v-m2 '(ZERO K1) 1))
  (dk-chain-ass! (dk-cite! 'ball-center-in c9v-m2 '(ZERO K1) 1))
  (dk-chain-ass! (dk-apply! o bb))
  (dk-iff-fwd! (dk-cite! 'is-open c9v-m1 bb))
  (let* ((ho (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FORSOME) (dk-contains? h bb))) "the open hypothesis"))
         (r (dk-skolem! (dk-chain-ass! (dk-apply! ho '(ZERO K1))))))
    (c9v-posrr! r)
    (let* ((nn (dk-skolem! (dk-chain-ass! (dk-cite! 'rr-power-decay n1 r))))
           (dec (dk-pick (lambda (h) (and (dk-head-is? h '<) (equal? (caddr h) r) (dk-contains? h nn))) "the decay"))
           (pw1 (cadr dec))
           (p (c9v-pw 'K1 v nn))
           (p2 (c9v-pw 'K2 v nn)))
      (c9v-pw-type! 'K1 v nn)
      (dk-cite! 'power-real-closed n1 nn)
      (let* ((pn1 (dk-cite! 'nv-pow-norm-power 'K1 v nn))
             (eq0 `(= ((ADD K1) (ZERO K1) ((NEG K1) ,p)) ((NEG K1) ,p))))
        (dk-cite! 'nf-neg-in-carr 'K1 p)
        (dk-have! eq0 (lambda () (c9v-crs-at! 'K1 (list p))))
        (let* ((nn1 (dk-cite! 'nf-norm-neg 'K1 p))
               (d1eq (c9v-dist! 'K1 '(ZERO K1) p))
               (iffb1 (dk-cite! 'ball-membership c9v-m1 '(ZERO K1) r p)))
          (dk-have! (caddr iffb1)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond ((dk-asm? g) (ass))
                          ((dk-head-is? g 'IN) (c9v-carr->pts-goal! 'K1))
                          ((dk-head-is? g '<=) (subst d1eq) (subst eq0) (subst nn1) (subst pn1) (dk-ineq! dec))
                          (#t (subst d1eq) (subst eq0) (subst nn1) (subst pn1) (di) (dk-absurd! `(= ,pw1 ,r) dec))))))))
          (dk-iff-bwd! iffb1)
          (c9v-sub-mem! `(BALL ,c9v-m1 (ZERO K1) ,r) bb p)
          (dk-iff-fwd! (dk-cite! 'ball-membership c9v-m2 '(ZERO K1) 1 p))
          (c9v-both! p)
          (dk-cite! 'nf-neg-in-carr 'K2 p)
          (let* ((d2 `((DIST ,c9v-m2) (ZERO K1) ,p))
                 (d2eq (c9v-dist! 'K2 '(ZERO K1) p))
                 (s2 `((ADD K2) (ZERO K1) ((NEG K2) ,p))))
            (dk-have! `(= ,s2 ((NEG K2) ,p))
              (lambda () (subst '(= (ADD K2) (ADD K1))) (subst '(= (NEG K2) (NEG K1))) (dk-close-if-asm!)))
            (let* ((nn2 (dk-cite! 'nf-norm-neg 'K2 p))
                   (ps (dk-chain-ass! (dk-cite! 'c9v-pow-same-ind nn 'K1 'K2 v)))
                   (_t (c9v-pw-type! 'K2 v nn))
                   (pn2 (dk-cite! 'nv-pow-norm-power 'K2 v nn))
                   (pw2 (caddr pn2))
                   (rw (lambda (f)
                         (let* ((f1 (dk-rewrite-h! f d2 (c9v-n 'K2 s2)))
                                (f2 (dk-rewrite-h! f1 s2 `((NEG K2) ,p)))
                                (f3 (dk-rewrite-h! f2 (c9v-n 'K2 `((NEG K2) ,p)) (c9v-n 'K2 p)))
                                (f4 (dk-rewrite-h! f3 p p2)))
                           (dk-rewrite-h! f4 (c9v-n 'K2 p2) pw2))))
                   (le (rw `(<= ,d2 1)))
                   (ne (rw `(NOT (= ,d2 1)))))
              (dk-cite! 'power-real-closed n2 nn)
              (pbc)
              (dk-chain-ass! (dk-cite! 'rr-not-lt-ge n2 1))
              (dk-chain-ass! (dk-cite! 'rr-power-ge-one nn n2))
              (dk-have! `(= ,pw2 1) (lambda () (dk-ineq! le `(<= 1 ,pw2))))
              (ai ne))))))))
(qed 'nv-open-lt-one)

;; 4e. (i) => (iii)
(sp (make-wff `(FORALL K1 (FORALL K2 ,(c9v-curry c9v-same `(IMPLIES ,c9v-i ,(c9v-p 'lt)))))))
(dk-peel!)
(c9v-setup!)
(let ((ifo (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IFF) (dk-contains? h 'IS-OPEN))) "(i)")))
  (for-each
    (lambda (dir)
      (dk-have! (if (eq? dir 'fwd) (c9v-opento c9v-m2 c9v-m1) (c9v-opento c9v-m1 c9v-m2))
        (lambda ()
          (dk-peel!)
          (let* ((u (caddr (dk-goal)))
                 (inst `(IFF (IS-OPEN ,c9v-m1 ,u) (IS-OPEN ,c9v-m2 ,u))))
            (dk-apply! ifo u)
            (if (eq? dir 'fwd) (dk-iff-fwd! inst) (dk-iff-bwd! inst))
            (dk-close-if-asm!)))))
    '(fwd bwd))
  (let ((x (cadr (cadr (cadr (dk-goal))))))
    (c9v-both! x)
    (dk-cite! 'nv-open-lt-one 'K1 'K2 x)
    (dk-cite! 'nv-field-normed 'K1)
    (dk-have! '(== (CARR K1) (CARR K2)) (lambda () (subst '(= (CARR K1) (CARR K2))) (qrfl)))
    (for-each (lambda (op)
                (dk-have! `(= (,op K1) (,op K2)) (lambda () (subst `(= (,op K1) (,op K2))) (rfl))))
              '(ADD NEG MUL ZERO ONE))
    (dk-cite! 'nv-open-lt-one 'K2 'K1 x)
    (if (dk-only! `(IMPLIES (< ,(c9v-n 'K1 x) 1) (< ,(c9v-n 'K2 x) 1)) `(IMPLIES (< ,(c9v-n 'K2 x) 1) (< ,(c9v-n 'K1 x) 1)))
        (prop))))
(qed 'ccr-1-46-i-iii)
