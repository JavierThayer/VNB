;;; ba2b-hom.scm -- Corollary 1.24 (a unital *-homomorphism of C*-algebras with unit is contractive, of norm 1)
;;; and Corollary 1.25 (at most one C*-norm on an involutive algebra with unit) of F. J. Thayer, "Banach
;;; Algebras and Applications", ch. 1 s. 2; and the uniqueness half of Proposition 1.19.
;;; Agent BA-2B, wave 2026-11-10.  Destination: theorem-library/ba2b-hom.scm.  Library: operator-algebras.
;;; All proofs modulo 0.  Helper prefix b2h-.
;;; LOAD WINDOW: after ba2b-radius (cstar-sa-spectral-radius, b2r-spectral-radius-view), BA-1H's
;;; ba-gelfand-formula (gelfand-spectral-radius-le), BA-1F's ba-spectral-radius
;;; (shift-invertible-beyond-spectral-radius, spectral-radius-real), BA-1's ba-elem / ba-spectrum / ba-laws,
;;; BA-2's ba2-cstar.
;;;
;;; THE ROUTE (the notes').  For unital Banach algebras A, B and a unital algebra homomorphism f, f maps
;;; z 1 - x to z 1 - f(x) and inverses to inverses, so sigma(f x) is inside sigma(x) and, by the upper
;;; bound of Gelfand's formula, rho(f x) <= rho(x) (hom-spectral-radius-le; no C* hypothesis).  For C*-algebras
;;; and f a *-homomorphism: f(h) is self-adjoint with h, so ||f h|| = rho(f h) <= rho(h) = ||h||; and for any
;;; x, ||f x||^2 = ||f(x* x)|| <= ||x* x|| = ||x||^2.

(define (b2h-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba2b-hom: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba2b-hom: unfinished" name))))
(define (b2h-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (b2h-ad A x y) (list (list 'VADD A) x y))
(define (b2h-ng A x) (list (list 'VNEG A) x))
(define (b2h-mu A x y) (list (list 'VMUL A) x y))
(define (b2h-ac A z x) (list (list 'ACT A) z x))
(define (b2h-st A x) (list (list 'VSTAR A) x))
(define (b2h-nr A x) (list (list 'VNRM A) x))
(define (b2h-one A) (list 'VONE A))
(define (b2h-zero A) (list 'VZERO A))

;;; the clauses of IS-ALG-HOM(a, b, f), landed (the hypothesis survives)
(define b2h-alg '(IS-ALG-HOM a b f))
(define b2h-fun '(IN f (FUN (VEC a) (VEC b))))
(define b2h-add '(FORALL bax_ (IMPLIES (IN bax_ (VEC a)) (FORALL bay_ (IMPLIES (IN bay_ (VEC a))
                   (= (f ((VADD a) bax_ bay_)) ((VADD b) (f bax_) (f bay_))))))))
(define b2h-act '(FORALL baz_ (IMPLIES (IN baz_ CC) (FORALL bax_ (IMPLIES (IN bax_ (VEC a))
                   (= (f ((ACT a) baz_ bax_)) ((ACT b) baz_ (f bax_))))))))
(define b2h-mul '(FORALL bax_ (IMPLIES (IN bax_ (VEC a)) (FORALL bay_ (IMPLIES (IN bay_ (VEC a))
                   (= (f ((VMUL a) bax_ bay_)) ((VMUL b) (f bax_) (f bay_))))))))
(define b2h-unit '(= (f (VONE a)) (VONE b)))
(define (b2h-hom-parts!)
  (for-each (lambda (c) (dk-project! c 'is-alg-hom b2h-alg)) (list b2h-fun b2h-add b2h-act b2h-mul b2h-unit)))
(define (b2h-ft! x) (dk-cite! 'fun-apply-type-c 'f '(VEC a) '(VEC b) x))
(define (b2h-uba body)
  (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f
    (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA b)
      (list 'IMPLIES b2h-alg body))))))))

