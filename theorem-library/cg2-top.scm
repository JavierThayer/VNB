;;; cg2-top.scm -- Proposition 5.8 of the compact-groups notes: for an open V containing e with
;;; V = V^-1, the union H of the powers V^k is an open subgroup; when V is also connected, H is
;;; the connected component of e (and so connected).  Each result is proved for a group topology
;;; (s, g) under NAME-gt and restated for the structure TOP-GROUP under NAME.
;;; Agent ISOM, 2026-10-26.  Helper prefix: ct2-.  Library: analysis.

(define (ct2-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (ct2-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (ct2-rhs! iff) (dk-split-all! (list (dk-meta-iff-r! iff))))
(define (ct2-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (ct2-op x y) (list '(OPR g) x y))
(define (ct2-inv x) (list '(INV g) x))
(define ct2-E '(IDEN g))
(define ct2-H '(POWERS-UNION g V))
(define ct2-C '(CONNECTED-COMPONENT s (IDEN g)))
(define (ct2-pow k) (list 'SET-POWER 'g 'V k))
(define ct2-sym '(FORALL p (IMPLIES (IN p V) (IN ((INV g) p) V))))
(define (ct2-parts!)
  (dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
  (fact 'group-identity-in 'g))
;; t in PTS s <-> t in CARR g
(define (ct2-carr! t)
  (if (not (dk-asm? (list 'IN t '(CARR g))))
      (dk-rewrite-h! (list 'IN t '(PTS s)) '(PTS s) '(CARR g))))
(define (ct2-pts! t)
  (if (not (dk-asm? (list 'IN t '(PTS s))))
      (dk-rewrite-h! (list 'IN t '(CARR g)) '(CARR g) '(PTS s))))
;; an open set lies in the carrier
(define (ct2-open-carr! W)
  (dk-cite! 'top-open-subset 's W)
  (if (not (dk-asm? (list 'SUBSET W '(CARR g))))
      (dk-rewrite-h! (list 'SUBSET W '(PTS s)) '(PTS s) '(CARR g))))
(define (ct2-pset! k) (dk-cite! 'set-power-is-set k 'g 'V))
(define (ct2-hset!) (dk-cite! 'powers-union-is-set 'g 'V))
(define (ct2-elim! z)                    ; z in H: returns k
  (let ((k (dk-skolem! (dk-cite! 'powers-union-elim 'g 'V z))))
    (ct2-split-if! (lambda (h) (and (dk-contains? h k) (dk-contains? h z))))
    (ct2-pset! k)
    k))

;;; ---- the lift (as in cg1-group.scm) ----
(define ct2-stmts '())
(define (ct2-keep! nm f) (set! ct2-stmts (cons (cons nm f) ct2-stmts)) f)
(define (ct2-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map ct2-subst e)) (#t e)))
(define (ct2-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt ct2-stmts)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (ct2-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))

;;; ---- the set product A V of a set and an open set is open ----
(define ct2-P '(SET-PROD g A V))
(sp (make-wff '(FORALL s (FORALL g (IMPLIES (IS-GROUP-TOPOLOGY s g) (FORALL A (FORALL V (IMPLIES (SUBSET A (CARR g))
   (IMPLIES (IN V (OPENS s)) (IN (SET-PROD g A V) (OPENS s)))))))))))
(dk-peel!)
(ct2-parts!)
(dk-cite! 'group-carr-set 'g)
(dk-have! (list 'IN ct2-P 'SET) (lambda () (mac 'SET-PROD) (dk-close-all! (lambda () (sep-set)))))
(dk-have! (list 'SUBSET ct2-P '(PTS s))
  (lambda () (mac 'subset-def)
             (let ((z (ct2-peel-var!)))
               (dk-split-all! (list (dk-cite! 'set-prod-elim 'g 'A 'V z)))
               (ct2-pts! z)
               (ct2-ass!))))
(dk-have! (list 'FORALL 'lpa_ (list 'IMPLIES (list 'IN 'lpa_ ct2-P)
            (list 'FORSOME 'lpw_ (list 'AND '(IN lpw_ (OPENS s)) (list 'AND '(IN lpa_ lpw_) (list 'SUBSET 'lpw_ ct2-P))))))
  (lambda ()
    (let ((z (ct2-peel-var!)))
      (dk-split-all! (list (dk-cite! 'set-prod-elim 'g 'A 'V z)))
      (let* ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h z) (dk-contains? h 'A))) "the left factor")))
             (_ (ct2-split-if! (lambda (h) (dk-contains? h x))))
             (y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x) (dk-contains? h z))) "the right factor")))
             (_2 (ct2-split-if! (lambda (h) (dk-contains? h y))))
             (ix (ct2-inv x))
             (wset (list 'SEP 'tz_ '(PTS s) (list 'IN (ct2-op (ct2-inv x) 'tz_) 'V))))
        (dk-cite! 'subset-mem-fwd 'A '(CARR g) x)
        (ct2-open-carr! 'V)
        (dk-cite! 'subset-mem-fwd 'V '(CARR g) y)
        (dk-cite! 'group-inv-in 'g x)
        (dk-cite! 'top-group-translate-open-gt 's 'g x 'V)
        (dk-cite! 'group-inv-inv 'g x)
        (dk-cite! 'group-mul-inv-cancel 'g ix y)
        (dk-rewrite-h! (list '= (ct2-op ix (ct2-op (ct2-inv ix) y)) y) (ct2-inv ix) x)
        (ct2-pts! z)
        (ew wset)
        (dk-conj-close!
         (lambda ()
           (cond
            ((dk-head-is? (dk-goal) 'SUBSET)
             (mac 'subset-def)
             (let ((t (ct2-peel-var!)))
               (dk-landed (lambda () (sep-me (list 'IN t wset))))
               (ct2-carr! t)
               (let ((m (ct2-op ix t)))
                 (dk-cite! 'group-carrier-closed-opr 'g ix t)
                 (dk-cite! 'subset-mem-fwd 'V '(CARR g) m)
                 (dk-cite! 'set-prod-intro 'g 'A 'V x m)
                 (dk-cite! 'group-mul-inv-cancel 'g x t)
                 (dk-rewrite-h! (list 'IN (ct2-op x m) ct2-P) (ct2-op x m) t)
                 (ct2-ass!))))
            ((and (dk-head-is? (dk-goal) 'IN) (dk-head-is? (caddr (dk-goal)) 'SEP))
             (in-sep! (lambda () (ct2-ass!))
                      (lambda () (subst (list '= z (ct2-op x y)))
                                 (subst (list '= (ct2-op ix (ct2-op x y)) y))
                                 (ct2-ass!))))
            (#t (ct2-ass!)))))))))
(dk-cite! 'top-open-of-local 's ct2-P)
(ct2-ass!)
(qed 'set-prod-open)
(topic! 'set-prod-open 'analysis)

;;; ---- H is open ----
(sp (make-wff '(FORALL s (FORALL g (IMPLIES (IS-GROUP-TOPOLOGY s g) (FORALL V (IMPLIES (IN V (OPENS s))
   (IMPLIES (IN (IDEN g) V) (IN (POWERS-UNION g V) (OPENS s))))))))))
(dk-peel!)
(ct2-parts!)
(ct2-open-carr! 'V)
(ct2-hset!)
(dk-cite! 'powers-union-sub-carr 'g 'V)
(dk-rewrite-h! (list 'SUBSET ct2-H '(CARR g)) '(CARR g) '(PTS s))
(dk-have! (list 'FORALL 'lpa_ (list 'IMPLIES (list 'IN 'lpa_ ct2-H)
            (list 'FORSOME 'lpw_ (list 'AND '(IN lpw_ (OPENS s)) (list 'AND '(IN lpa_ lpw_) (list 'SUBSET 'lpw_ ct2-H))))))
  (lambda ()
    (let* ((z (ct2-peel-var!)) (k (ct2-elim! z)) (sk (list 'succ k)) (pk (ct2-pow k)) (psk (ct2-pow sk))
           (prod (list 'SET-PROD 'g pk 'V)))
      (dk-cite! 'nn-succ-closed k)
      (ct2-pset! sk)
      (dk-cite! 'set-power-sub-carr k 'g 'V)
      (dk-cite! 'set-prod-open 's 'g pk 'V)
      (dk-cite! 'set-power-succ 'g 'V k)
      (dk-rewrite-h! (list 'IN prod '(OPENS s)) prod psk)
      (dk-cite! 'set-power-mono-succ 'g 'V k z)
      (ew psk)
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'SUBSET)
             (begin (mac 'subset-def)
                    (let ((t (ct2-peel-var!)))
                      (dk-cite! 'powers-union-intro 'g 'V sk t)
                      (ct2-ass!)))
             (ct2-ass!)))))))
(dk-cite! 'top-open-of-local 's ct2-H)
(ct2-ass!)
(qed 'powers-union-open)
(topic! 'powers-union-open 'analysis)

;;; ---- an open subgroup contains the component of e ----
(define ct2-K '(SEP cz_ (PTS s) (NOT (IN cz_ H))))
(define (ct2-meets C u) (list 'FORSOME 'ctx_ (list 'AND (list 'IN 'ctx_ C) (list 'IN 'ctx_ u))))
(sp (make-wff (ct2-keep! 'open-subgroup-contains-component-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'H (list 'IMPLIES '(IS-SUBGROUP g H) (list 'IMPLIES '(IN H (OPENS s)) (list 'SUBSET ct2-C 'H))))))))))
(dk-peel!)
(ct2-parts!)
(ct2-pts! ct2-E)
(ct2-rhs! (dk-cite! 'is-subgroup 'g 'H))
(dk-cite! 'top-group-open-subgroup-complement-open-gt 's 'g 'H)
(dk-cite! 'connected-component-connected 's ct2-E)
(ct2-rhs! (dk-cite! 'is-connected-t 's ct2-C))
(dk-cite! 'connected-component-self 's ct2-E)
(dk-have! (ct2-meets ct2-C 'H) (lambda () (ew ct2-E) (dk-conj-close! (lambda () (ct2-ass!)))))
(dk-have! (list 'SUBSET ct2-C (list 'UNION 'H ct2-K))
  (lambda () (mac 'subset-def)
             (let ((y (ct2-peel-var!)))
               (dk-cite! 'subset-mem-fwd ct2-C '(PTS s) y)
               (let ((iff (dk-cite! 'union-membership 'H ct2-K y)))
                 (dk-have! (caddr iff)
                   (lambda () (use-em (list 'IN y 'H)
                                (lambda () (oi-l) (ct2-ass!))
                                (lambda () (oi-r) (in-sep! (lambda () (ct2-ass!)) (lambda () (ct2-ass!)))))))
                 (dk-meta-iff-l! iff)
                 (ct2-ass!)))))
(dk-have! (list 'FORALL 'ctx_ (list 'IMPLIES (list 'IN 'ctx_ ct2-C) (list 'NOT (list 'AND (list 'IN 'ctx_ 'H) (list 'IN 'ctx_ ct2-K)))))
  (lambda () (let ((y (ct2-peel-var!)))
               (di)
               (dk-split-all! (list (list 'AND (list 'IN y 'H) (list 'IN y ct2-K))))
               (dk-landed (lambda () (sep-me (list 'IN y ct2-K))))
               (ai (list 'NOT (list 'IN y 'H))))))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ctu_))) "the connectedness of the component") 'H ct2-K)
(mac 'subset-def)
(let ((x (ct2-peel-var!)))
  (use-em (list 'IN x 'H)
    (lambda () (ct2-ass!))
    (lambda ()
      (dk-cite! 'subset-mem-fwd ct2-C '(PTS s) x)
      (dk-have! (list 'IN x ct2-K) (lambda () (in-sep! (lambda () (ct2-ass!)) (lambda () (ct2-ass!)))))
      (dk-have! (ct2-meets ct2-C ct2-K) (lambda () (ew x) (dk-conj-close! (lambda () (ct2-ass!)))))
      (ai (list 'NOT (ct2-meets ct2-C ct2-K))))))
(qed 'open-subgroup-contains-component-gt)
(topic! 'open-subgroup-contains-component-gt 'analysis)
(ct2-lift! 'open-subgroup-contains-component-gt 'open-subgroup-contains-component)

;;; ---- the powers of a V inside the component stay in it (the component is a subgroup) ----
(define (ct2-succ-parts! k y)            ; y in V^(succ k): returns (y1 y2), y1 in V^k, y2 in V, y = y1 y2
  (ct2-pset! k)
  (dk-split-all! (list (dk-cite! 'set-power-succ-elim 'g 'V k y)))
  (let* ((y1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y) (dk-contains? h (ct2-pow k)))) "the first factor")))
         (_ (ct2-split-if! (lambda (h) (and (dk-contains? h y1) (dk-contains? h (ct2-pow k))))))
         (y2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y1) (dk-contains? h y))) "the second factor"))))
    (ct2-split-if! (lambda (h) (and (dk-contains? h y2) (dk-contains? h y1))))
    (list y1 y2)))
(define ct2-Cprod (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ ct2-C) (list 'FORALL 'sgb_ (list 'IMPLIES (list 'IN 'sgb_ ct2-C)
                    (list 'IN '((OPR g) sga_ sgb_) ct2-C))))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'V (list 'IMPLIES (list 'SUBSET 'V ct2-C) (list 'SUBSET '(SET-POWER g V k) ct2-C))))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (ct2-parts!)
  (ct2-pts! ct2-E)
  (fact 'nn-zero-in)
  (ct2-pset! 0)
  (dk-cite! 'connected-component-self 's ct2-E)
  (mac 'subset-def)
  (let ((z (ct2-peel-var!)))
    (dk-cite! 'set-power-zero-elim 'g 'V z)
    (subst (list '= z ct2-E))
    (ct2-ass!))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (ct2-parts!)
  (dk-cite! 'nn-succ-closed n)
  (ct2-pset! (list 'succ n))
  (dk-cite! 'top-group-component-normal-subgroup-gt 's 'g)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-normal-subgroup 'g ct2-C))))
  (ct2-rhs! (dk-cite! 'is-subgroup 'g ct2-C))
  (mac 'subset-def)
  (let* ((z (ct2-peel-var!)) (yy (ct2-succ-parts! n z)) (y1 (car yy)) (y2 (cadr yy)))
    (dk-apply! ih 's 'g 'V)
    (dk-cite! 'subset-mem-fwd (ct2-pow n) ct2-C y1)
    (dk-cite! 'subset-mem-fwd 'V ct2-C y2)
    (dk-apply! (dk-ctx-form ct2-Cprod) y1 y2)
    (subst (list '= z (ct2-op y1 y2)))
    (ct2-ass!)))
(qed 'set-powers-in-component)
(topic! 'set-powers-in-component 'analysis)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'V (list 'IMPLIES '(IN V (OPENS s)) (list 'IMPLIES '(IN (IDEN g) V) (list 'IMPLIES '(IS-CONNECTED-T s V)
     (list 'SUBSET ct2-H ct2-C))))))))))
(dk-peel!)
(ct2-parts!)
(ct2-pts! ct2-E)
(dk-have! (list 'SUBSET 'V ct2-C)
  (lambda () (mac 'subset-def)
             (let ((z (ct2-peel-var!)))
               (dk-cite! 'connected-component-intro 's 'V ct2-E z)
               (ct2-ass!))))
(ct2-hset!)
(mac 'subset-def)
(let* ((z (ct2-peel-var!)) (k (ct2-elim! z)))
  (dk-cite! 'set-powers-in-component k 's 'g 'V)
  (dk-cite! 'subset-mem-fwd (ct2-pow k) ct2-C z)
  (ct2-ass!))
(qed 'powers-union-in-component)
(topic! 'powers-union-in-component 'analysis)

;;; ---- Proposition 5.8 ----
(sp (make-wff (ct2-keep! 'top-group-powers-open-subgroup-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'V (list 'IMPLIES '(IN V (OPENS s)) (list 'IMPLIES '(IN (IDEN g) V) (list 'IMPLIES ct2-sym
     (list 'AND (list 'IS-SUBGROUP 'g ct2-H) (list 'IN ct2-H '(OPENS s)))))))))))))
(dk-peel!)
(ct2-parts!)
(ct2-open-carr! 'V)
(dk-cite! 'powers-union-subgroup 'g 'V)
(dk-cite! 'powers-union-open 's 'g 'V)
(dk-conj-close! (lambda () (ct2-ass!)))
(qed 'top-group-powers-open-subgroup-gt)
(topic! 'top-group-powers-open-subgroup-gt 'analysis)
(ct2-lift! 'top-group-powers-open-subgroup-gt 'top-group-powers-open-subgroup)

(sp (make-wff (ct2-keep! 'top-group-powers-component-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'V (list 'IMPLIES '(IN V (OPENS s)) (list 'IMPLIES '(IN (IDEN g) V) (list 'IMPLIES ct2-sym
     (list 'IMPLIES '(IS-CONNECTED-T s V)
       (list 'AND (list '= ct2-H ct2-C) (list 'IS-CONNECTED-T 's ct2-H)))))))))))))
(dk-peel!)
(ct2-parts!)
(ct2-hset!)
(dk-split-all! (list (dk-cite! 'top-group-powers-open-subgroup-gt 's 'g 'V)))
(dk-cite! 'open-subgroup-contains-component-gt 's 'g ct2-H)
(dk-cite! 'powers-union-in-component 's 'g 'V)
(dk-cite! 'connected-component-connected 's ct2-E)
(dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x ct2-H) (list 'IN 'x ct2-C)))
  (lambda ()
    (let ((x (begin (dk-peel!) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g0) (equal? (caddr g0) ct2-C))
        (lambda () (dk-cite! 'subset-mem-fwd ct2-H ct2-C x) (ct2-ass!))
        (lambda () (dk-cite! 'subset-mem-fwd ct2-C ct2-H x) (ct2-ass!))))))
(dk-cite! 'class-extensionality ct2-H ct2-C)
(dk-have! (list 'IS-CONNECTED-T 's ct2-H) (lambda () (subst (list '= ct2-H ct2-C)) (ct2-ass!)))
(dk-conj-close! (lambda () (ct2-ass!)))
(qed 'top-group-powers-component-gt)
(topic! 'top-group-powers-component-gt 'analysis)
(ct2-lift! 'top-group-powers-component-gt 'top-group-powers-component)
