;;; la-z4-schanuel.scm -- Z^n computes componentwise; Z^(n+n) as pairs (SEQ-HEAD, SEQ-SHIFT,
;;; SEQ-JOIN); Schanuel's automorphism of Z^(n+n) (LA-Z4, 2026-10-24).  The device of the
;;; uniqueness half of 3.50 (la-z4-unique).  Vocabulary: structure-library/la-z4-vocab.
;;; Prefix lzc-.
;;;
;;; PLAN.  (1) zz-pow-vadd-at / vneg-at / act-at, and a componentwise decision procedure for
;;; identities in Z^d (ext, push evaluation inside, crs).  (2) Z^(n+n) as pairs (t, b):
;;; SEQ-HEAD, SEQ-SHIFT, SEQ-JOIN and their laws.  (3) For homomorphisms la, lb of Z^n, the map
;;; (t, b) |-> (b - lb(t), t + la(b - lb(t))) (SCHANUEL-MAP) is an automorphism of Z^(n+n)
;;; whose inverse is SCHANUEL-MAP with la and lb exchanged.
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z4-free (zz-pow-*) and la-z4-dsum (lzu-shift-*).

(define (lzc-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-schanuel: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzc-diag! name)               ; print the open leaves when the proof did not close
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-schanuel: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves)))))
(define (lzc-sp-qed! stmt steps name)   ; a proof opened and closed inside a helper (dk-sp-qed!)
  (dk-sp-qed! (make-wff stmt) (lambda () (steps) (lzc-diag! name)) name)
  (topic! name 'algebra))
(define (lzc-split-all! f)
  (if (dk-head-is? f 'AND) (for-each lzc-split-all! (dk-split! f))))
(define (lzc-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (lzc-iv-var ld cls)
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "lzc-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (lzc-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (lzc-skolem-split! ex)
  (let ((w (dk-skolem! ex)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    w))
(define (lzc-hom-open! a b f)
  (let ((z (list '= (list f (list 'VZERO a)) (list 'VZERO b))))
    (if (not (dk-asm? z))
        (lzc-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def a b f))))))
(define (lzc-hcl-add a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a)) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'VADD a) 'x1_ 'x2_)) (list (list 'VADD b) (list f 'x1_) (list f 'x2_))))))))
(define (lzc-hcl-neg a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a))
    (list '= (list f (list (list 'VNEG a) 'x1_)) (list (list 'VNEG b) (list f 'x1_))))))
(define (lzc-hcl-act a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'CARR (list 'SCAL a))) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'ACT a) 'x1_ 'x2_)) (list (list 'ACT b) 'x1_ (list f 'x2_))))))))

;;; =====================================================================
;;; (1) Z^d computes componentwise
;;; =====================================================================
(define (lzc-zfam d) (list 'VNB-LAMBDA 'zpi_ (list 'INTERVAL 1 d) '(RING-AS-MODULE ZZ-RING)))
(define (lzc-dsz d) (list 'DIRECT-SUM 'ZZ-RING d (lzc-zfam d)))
(define (lzc-zp d) (list 'ZZ-POW d))
(define (lzc-zv d) (list 'VEC (list 'ZZ-POW d)))
(define LZC-RAM '(RING-AS-MODULE ZZ-RING))
(define (lzc-zhm d) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 d)) (list 'IS-MODULE (list (lzc-zfam d) 'i_)))))
(define (lzc-zsetup! d)                 ; d in NN in context
  (fact 'zz-is-ring)
  (fact 'zz-is-commutative-ring)
  (fact 'nn-one-in)
  (fact 'one-in-interval-1)
  (fact 'ring-as-module-is-module 'ZZ-RING)
  (for-each (lambda (nm) (fact nm 'ZZ-RING)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-vzero ram-ro-vneg ram-ro-act))
  (if (not (dk-asm? '(== (CARR ZZ-RING) ZZ)))
      (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
  (if (not (dk-asm? (lzc-zhm d))) (dk-split! (dk-cite! 'zz-pow-family d)))
  (fact 'direct-sum-is-module 'ZZ-RING d (lzc-zfam d))
  (for-each (lambda (nm) (fact nm 'ZZ-RING d (lzc-zfam d))) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act))
  (fact 'zz-pow-unfold d)
  (fact 'zz-pow-is-module d)
  (fact 'zz-pow-scal d))
(define (lzc-to-dsv! d x)               ; (IN x (DSUM-VEC d ZFAM)) from (IN x (VEC (ZZ-POW d)))
  (let ((want (list 'IN x (list 'DSUM-VEC d (lzc-zfam d)))))
    (if (not (dk-asm? want))
        (let ((h (dk-rewrite-h! (list 'IN x (lzc-zv d)) (lzc-zp d) (lzc-dsz d))))
          (dk-rewrite-h! h (list 'VEC (lzc-dsz d)) (list 'DSUM-VEC d (lzc-zfam d)))))))
(define (lzc-zc! d x i)                 ; (IN (x i) (CARR ZZ-RING)) for x in VEC (ZZ-POW d)
  (let ((want (list 'IN (list x i) '(CARR ZZ-RING))))
    (if (not (dk-asm? want))
        (begin
          (fact 'zz-pow-vec-out d x i)
          (dk-rewrite-h! (list 'IN (list x i) 'ZZ) 'ZZ '(CARR ZZ-RING))))))
(define (lzc-fam! d i)
  (let ((e (list '== (list (lzc-zfam d) i) LZC-RAM)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (qrfl)))))
    (subst (list '= (list (lzc-zfam d) i) LZC-RAM))))
(sp (make-wff (forall-guarded '(n x y i) '((IN n NN) (IN x (VEC (ZZ-POW n))) (IN y (VEC (ZZ-POW n))) (IN i (INTERVAL 1 n)))
  '(= (((VADD (ZZ-POW n)) x y) i) ((ADD ZZ-RING) (x i) (y i))))))
(dk-peel!)
(lzc-zsetup! 'n)
(lzc-zc! 'n 'x 'i) (lzc-zc! 'n 'y 'i)
(lzc-to-dsv! 'n 'x) (lzc-to-dsv! 'n 'y)
(subst (list '= '(ZZ-POW n) (lzc-dsz 'n)))
(subst (dk-cite! 'dsum-vadd-at 'ZZ-RING 'n (lzc-zfam 'n) 'x 'y 'i))
(lzc-fam! 'n 'i)
(subst (list '= (list 'VADD LZC-RAM) '(ADD ZZ-RING)))
(fact 'ring-add-closed 'ZZ-RING '(x i) '(y i))
(rfl)
(lzc-done! 'zz-pow-vadd-at)

(sp (make-wff (forall-guarded '(n x i) '((IN n NN) (IN x (VEC (ZZ-POW n))) (IN i (INTERVAL 1 n)))
  '(= (((VNEG (ZZ-POW n)) x) i) ((NEG ZZ-RING) (x i))))))
(dk-peel!)
(lzc-zsetup! 'n)
(lzc-zc! 'n 'x 'i)
(lzc-to-dsv! 'n 'x)
(subst (list '= '(ZZ-POW n) (lzc-dsz 'n)))
(subst (dk-cite! 'dsum-vneg-at 'ZZ-RING 'n (lzc-zfam 'n) 'x 'i))
(lzc-fam! 'n 'i)
(subst (list '= (list 'VNEG LZC-RAM) '(NEG ZZ-RING)))
(fact 'ring-neg-in-carr 'ZZ-RING '(x i))
(rfl)
(lzc-done! 'zz-pow-vneg-at)

(sp (make-wff (forall-guarded '(n r x i) '((IN n NN) (IN r (CARR ZZ-RING)) (IN x (VEC (ZZ-POW n))) (IN i (INTERVAL 1 n)))
  '(= (((ACT (ZZ-POW n)) r x) i) ((MUL ZZ-RING) r (x i))))))
(dk-peel!)
(lzc-zsetup! 'n)
(lzc-zc! 'n 'x 'i)
(lzc-to-dsv! 'n 'x)
(subst (list '= '(ZZ-POW n) (lzc-dsz 'n)))
(subst (dk-cite! 'dsum-act-at 'ZZ-RING 'n (lzc-zfam 'n) 'r 'x 'i))
(lzc-fam! 'n 'i)
(subst (list '= (list 'ACT LZC-RAM) '(MUL ZZ-RING)))
(fact 'ring-carrier-closed-mul 'ZZ-RING 'r '(x i))
(rfl)
(lzc-done! 'zz-pow-act-at)

;;; ---- the componentwise decision procedure for Z^d identities ------------------------
;; type a vector term of Z^d built from VADD, VNEG, ACT (scalar typed in CARR ZZ-RING), VZERO
(define (lzc-zvt! d t)
  (let* ((zp (lzc-zp d)) (want (list 'IN t (lzc-zv d))))
    (cond ((dk-asm? want) #t)
          ((equal? t (list 'VZERO zp)) (fact 'module-vzero-in zp))
          ((and (pair? t) (equal? (car t) (list 'VADD zp)))
           (lzc-zvt! d (cadr t)) (lzc-zvt! d (caddr t)) (fact 'module-vadd-type zp (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) (list 'VNEG zp)))
           (lzc-zvt! d (cadr t)) (fact 'module-vneg-type zp (cadr t)))
          ((and (pair? t) (equal? (car t) (list 'ACT zp)))
           (lzc-zvt! d (caddr t))
           (if (not (dk-asm? (list 'IN (cadr t) (list 'CARR (list 'SCAL zp)))))
               (dk-have! (list 'IN (cadr t) (list 'CARR (list 'SCAL zp)))
                 (lambda () (subst (list '= (list 'SCAL zp) 'ZZ-RING)) (ass))))
           (fact 'module-act-type zp (cadr t) (caddr t)))
          (#t (error "lzc-zvt!: cannot type" (expression->string t))))))
;; the innermost Z^d operation applied at the index v
(define (lzc-redex-at d e v)
  (let ((zp (lzc-zp d)))
    (if (not (pair? e))
        #f
        (or (let loop ((xs e)) (cond ((not (pair? xs)) #f) ((lzc-redex-at d (car xs) v)) (#t (loop (cdr xs)))))
            (and (= (length e) 2) (equal? (cadr e) v)
                 (let ((h (car e)))
                   (cond ((equal? h (list 'VZERO zp)) e)
                         ((and (pair? h) (member (car h) (list (list 'VADD zp) (list 'VNEG zp) (list 'ACT zp)))) e)
                         (#t #f))))))))
(define (lzc-norm-at! d v)
  (let ((zp (lzc-zp d)))
    (let loop ((fuel 60))
      (let ((rx (lzc-redex-at d (dk-goal) v)))
        (if (and rx (> fuel 0))
            (let* ((h (car rx))
                   (eqn (cond ((equal? h (list 'VZERO zp)) (dk-cite! 'zz-pow-vzero-at d v))
                              ((equal? (car h) (list 'VADD zp))
                               (lzc-zvt! d (cadr h)) (lzc-zvt! d (caddr h))
                               (dk-cite! 'zz-pow-vadd-at d (cadr h) (caddr h) v))
                              ((equal? (car h) (list 'VNEG zp))
                               (lzc-zvt! d (cadr h))
                               (dk-cite! 'zz-pow-vneg-at d (cadr h) v))
                              (#t
                               (lzc-zvt! d (caddr h))
                               (dk-cite! 'zz-pow-act-at d (cadr h) (caddr h) v)))))
              (subst eqn)
              (loop (- fuel 1))))))))
;; the atoms (x v) of the normalised goal: type them in CARR ZZ-RING
(define (lzc-atoms-at e v acc)
  (cond ((not (pair? e)) acc)
        ((and (= (length e) 2) (equal? (cadr e) v) (symbol? (car e))) (if (member e acc) acc (cons e acc)))
        ((and (= (length e) 2) (equal? (cadr e) v) (pair? (car e)) (not (memq (caar e) '(ADD NEG MUL ZERO ONE)))) (if (member e acc) acc (cons e acc)))
        (#t (fold-left (lambda (a s) (lzc-atoms-at s v a)) acc e))))
;; prove (= X Y) in Z^d componentwise: ext, push evaluation inside, crs
(define (lzc-zeq! d x y)
  (lzc-zvt! d x) (lzc-zvt! d y)
  (let ((pt (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 d)) (list '= (list x 'i_) (list y 'i_))))))
    (dk-have! pt
      (lambda ()
        (let* ((ld (dk-peel!)) (v (lzc-iv-var ld (list 'INTERVAL 1 d))))
          (lzc-norm-at! d v)
          (for-each (lambda (a) (lzc-zc! d (car a) v)) (lzc-atoms-at (dk-goal) v '()))
          (crs))))
    (dk-have! (list '= x y) (lambda () (fact 'zz-pow-ext d x y) (ass)))))

;;; =====================================================================
;;; (2) Z^(n+n) as pairs: SEQ-HEAD, SEQ-SHIFT, SEQ-JOIN
;;; =====================================================================
(define LZC-MH '((IN m NN) (IN n NN) (= m (+ n n))))
(define (lzc-mstmt vars guards body) (forall-guarded (append '(m n) vars) (append LZC-MH guards) body))
(define (lzc-msetup!)
  (lzc-zsetup! 'n)
  (lzc-zsetup! 'm)
  (dk-have! '(<= n m) (lambda () (dk-nn! '(= m (+ n n))))))
(define (lzc-lo! i)                     ; i in [1,n] => i in [1,m]
  (if (not (dk-asm? (list 'IN i '(INTERVAL 1 m))))
      (fact 'interval-widen 'n 'm 1 i)))
(define (lzc-hi! i)                     ; i in [1,n] => (+ n i) in [1,m], NOT (+ n i) <= n
  (if (not (dk-asm? (list 'IN (list '+ 'n i) '(INTERVAL 1 m))))
      (dk-split! (dk-cite! 'lzu-shift-in 'm 'n 'n i))))
;; (IN lam (FUN dom ZZ)) for a lambda on [1,d]; CLOSER (of the index) closes (IN body ZZ)
(define (lzc-lam-zz! lam d closer)
  (dk-have! (list 'IN lam (list 'FUN (list 'INTERVAL 1 d) 'ZZ))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((ld (dk-peel!)) (i (lzc-iv-var ld (list 'INTERVAL 1 d))))
            (if (not (lzc-beta!)) (closer i))))
        (lambda () (fact 'interval-in-set 1 d) (ass))))))

(sp (make-wff (lzc-mstmt '(z) '((IN z (VEC (ZZ-POW m)))) '(IN (SEQ-HEAD n z) (VEC (ZZ-POW n))))))
(dk-peel!)
(lzc-msetup!)
(mac 'SEQ-HEAD)
(let ((lam '(VNB-LAMBDA shi_ (INTERVAL 1 n) (z shi_))))
  (lzc-lam-zz! lam 'n (lambda (i) (lzc-lo! i) (fact 'zz-pow-vec-out 'm 'z i) (ass)))
  (fact 'zz-pow-vec-in 'n lam)
  (ass))
(lzc-done! 'seq-head-vec)

(sp (make-wff (lzc-mstmt '(z i) '((IN z (VEC (ZZ-POW m))) (IN i (INTERVAL 1 n))) '(= ((SEQ-HEAD n z) i) (z i)))))
(dk-peel!)
(lzc-msetup!)
(lzc-lo! 'i)
(fact 'zz-pow-vec-out 'm 'z 'i)
(mac 'SEQ-HEAD)
(if (not (lzc-beta!)) (rfl))
(lzc-done! 'seq-head-at)

(sp (make-wff (lzc-mstmt '(z) '((IN z (VEC (ZZ-POW m)))) '(IN (SEQ-SHIFT n z) (VEC (ZZ-POW n))))))
(dk-peel!)
(lzc-msetup!)
(mac 'SEQ-SHIFT)
(let ((lam '(VNB-LAMBDA sfi_ (INTERVAL 1 n) (z (+ n sfi_)))))
  (lzc-lam-zz! lam 'n (lambda (i) (lzc-hi! i) (fact 'zz-pow-vec-out 'm 'z (list '+ 'n i)) (ass)))
  (fact 'zz-pow-vec-in 'n lam)
  (ass))
(lzc-done! 'seq-shift-vec)

(sp (make-wff (lzc-mstmt '(z i) '((IN z (VEC (ZZ-POW m))) (IN i (INTERVAL 1 n))) '(= ((SEQ-SHIFT n z) i) (z (+ n i))))))
(dk-peel!)
(lzc-msetup!)
(lzc-hi! 'i)
(fact 'zz-pow-vec-out 'm 'z '(+ n i))
(mac 'SEQ-SHIFT)
(if (not (lzc-beta!)) (rfl))
(lzc-done! 'seq-shift-at)

(define LZC-JN '(SEQ-JOIN m n hd tl))
(define (lzc-join-val! j hd tl)          ; goal holds the IF of SEQ-JOIN at j; resolve and type
  (let ((ift (let find ((e (dk-goal))) (cond ((and (pair? e) (eq? (car e) 'IF)) e) ((pair? e) (or (find (car e)) (find (cdr e)))) (#t #f)))))
    ift))
(sp (make-wff (lzc-mstmt '(hd tl) '((IN hd (VEC (ZZ-POW n))) (IN tl (VEC (ZZ-POW n)))) (list 'IN LZC-JN '(VEC (ZZ-POW m))))))
(dk-peel!)
(lzc-msetup!)
(mac 'SEQ-JOIN)
(let ((lam '(VNB-LAMBDA jnj_ (INTERVAL 1 m) (IF (<= jnj_ n) (hd jnj_) (tl (NN-MINUS jnj_ n))))))
  (lzc-lam-zz! lam 'm
    (lambda (j)
      (dk-case-if! (lzc-join-val! j 'hd 'tl)
        (lambda (true? v)
          (if true?
              (begin (fact 'lzu-prefix-in 'm 'n j) (fact 'zz-pow-vec-out 'n 'hd j) (ass))
              (begin (dk-split! (dk-cite! 'lzu-shift-back 'm 'n 'n j))
                     (fact 'zz-pow-vec-out 'n 'tl (list 'NN-MINUS j 'n)) (ass)))))))
  (fact 'zz-pow-vec-in 'm lam)
  (ass))
(lzc-done! 'seq-join-vec)

(sp (make-wff (lzc-mstmt '(hd tl j) '((IN hd (VEC (ZZ-POW n))) (IN tl (VEC (ZZ-POW n))) (IN j (INTERVAL 1 m)) (<= j n))
  (list '= (list LZC-JN 'j) '(hd j)))))
(dk-peel!)
(lzc-msetup!)
(fact 'lzu-prefix-in 'm 'n 'j)
(fact 'zz-pow-vec-out 'n 'hd 'j)
(mac 'SEQ-JOIN)
(lzc-beta!)
(dk-if-branch! #t (lzc-join-val! 'j 'hd 'tl) #f (lambda () (rfl)))
(lzc-done! 'seq-join-lo)

(sp (make-wff (lzc-mstmt '(hd tl j) '((IN hd (VEC (ZZ-POW n))) (IN tl (VEC (ZZ-POW n))) (IN j (INTERVAL 1 m)) (NOT (<= j n)))
  (list '= (list LZC-JN 'j) '(tl (NN-MINUS j n))))))
(dk-peel!)
(lzc-msetup!)
(dk-split! (dk-cite! 'lzu-shift-back 'm 'n 'n 'j))
(fact 'zz-pow-vec-out 'n 'tl '(NN-MINUS j n))
(mac 'SEQ-JOIN)
(lzc-beta!)
(dk-if-branch! #f (lzc-join-val! 'j 'hd 'tl) #f (lambda () (rfl)))
(lzc-done! 'seq-join-hi)

(sp (make-wff (lzc-mstmt '(hd tl) '((IN hd (VEC (ZZ-POW n))) (IN tl (VEC (ZZ-POW n)))) (list '= (list 'SEQ-HEAD 'n LZC-JN) 'hd))))
(dk-peel!)
(lzc-msetup!)
(fact 'seq-join-vec 'm 'n 'hd 'tl)
(fact 'seq-head-vec 'm 'n LZC-JN)
(dk-have! '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= ((SEQ-HEAD n (SEQ-JOIN m n hd tl)) i_) (hd i_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (i (lzc-iv-var ld '(INTERVAL 1 n))))
      (lzc-lo! i)
      (lzc-iv! i 1 'n)
      (subst (dk-cite! 'seq-head-at 'm 'n LZC-JN i))
      (subst (dk-cite! 'seq-join-lo 'm 'n 'hd 'tl i))
      (fact 'zz-pow-vec-out 'n 'hd i)
      (rfl))))
(fact 'zz-pow-ext 'n (list 'SEQ-HEAD 'n LZC-JN) 'hd)
(ass)
(lzc-done! 'seq-head-join)

(sp (make-wff (lzc-mstmt '(hd tl) '((IN hd (VEC (ZZ-POW n))) (IN tl (VEC (ZZ-POW n)))) (list '= (list 'SEQ-SHIFT 'n LZC-JN) 'tl))))
(dk-peel!)
(lzc-msetup!)
(fact 'seq-join-vec 'm 'n 'hd 'tl)
(fact 'seq-shift-vec 'm 'n LZC-JN)
(dk-have! '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= ((SEQ-SHIFT n (SEQ-JOIN m n hd tl)) i_) (tl i_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (i (lzc-iv-var ld '(INTERVAL 1 n))))
      (lzc-hi! i)
      (lzc-iv! i 1 'n)
      (subst (dk-cite! 'seq-shift-at 'm 'n LZC-JN i))
      (subst (dk-cite! 'seq-join-hi 'm 'n 'hd 'tl (list '+ 'n i)))
      (subst (dk-cite! 'lzu-shift-cancel 'n i))
      (fact 'zz-pow-vec-out 'n 'tl i)
      (rfl))))
(fact 'zz-pow-ext 'n (list 'SEQ-SHIFT 'n LZC-JN) 'tl)
(ass)
(lzc-done! 'seq-shift-join)

(define LZC-JZ '(SEQ-JOIN m n (SEQ-HEAD n z) (SEQ-SHIFT n z)))
(sp (make-wff (lzc-mstmt '(z) '((IN z (VEC (ZZ-POW m)))) (list '= LZC-JZ 'z))))
(dk-peel!)
(lzc-msetup!)
(fact 'seq-head-vec 'm 'n 'z)
(fact 'seq-shift-vec 'm 'n 'z)
(fact 'seq-join-vec 'm 'n '(SEQ-HEAD n z) '(SEQ-SHIFT n z))
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 m)) (list '= (list LZC-JZ 'i_) '(z i_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (lzc-iv-var ld '(INTERVAL 1 m))))
      (fact 'zz-pow-vec-out 'm 'z j)
      (use-em (list '<= j 'n)
        (lambda ()
          (fact 'lzu-prefix-in 'm 'n j)
          (subst (dk-cite! 'seq-join-lo 'm 'n '(SEQ-HEAD n z) '(SEQ-SHIFT n z) j))
          (subst (dk-cite! 'seq-head-at 'm 'n 'z j))
          (rfl))
        (lambda ()
          (dk-split! (dk-cite! 'lzu-shift-back 'm 'n 'n j))
          (subst (dk-cite! 'seq-join-hi 'm 'n '(SEQ-HEAD n z) '(SEQ-SHIFT n z) j))
          (subst (dk-cite! 'seq-shift-at 'm 'n 'z (list 'NN-MINUS j 'n)))
          (subst (list '= (list '+ 'n (list 'NN-MINUS j 'n)) j))
          (rfl))))))
(fact 'zz-pow-ext 'm LZC-JZ 'z)
(ass)
(lzc-done! 'seq-join-ext)

(sp (make-wff (lzc-mstmt '(v w) '((IN v (VEC (ZZ-POW m))) (IN w (VEC (ZZ-POW m))) (= (SEQ-HEAD n v) (SEQ-HEAD n w)) (= (SEQ-SHIFT n v) (SEQ-SHIFT n w)))
  '(= v w))))
(dk-peel!)
(lzc-msetup!)
(let ((ev (dk-cite! 'seq-join-ext 'm 'n 'v))
      (ew2 (dk-cite! 'seq-join-ext 'm 'n 'w)))
  (let* ((e1 (dk-rewrite-h! ev '(SEQ-HEAD n v) '(SEQ-HEAD n w)))
         (e2 (dk-rewrite-h! e1 '(SEQ-SHIFT n v) '(SEQ-SHIFT n w))))
    ;; e2: JOIN(Hw, Sw) = v ; ew2: JOIN(Hw, Sw) = w
    (subst (list '= 'v '(SEQ-JOIN m n (SEQ-HEAD n w) (SEQ-SHIFT n w))))
    (ass)))
(lzc-done! 'seq-split-ext)

;;; ---- SEQ-HEAD and SEQ-SHIFT commute with the operations --------------------------------
(define (lzc-sel sel z) (list sel 'n z))
(define (lzc-sel-idx sel i) (if (eq? sel 'SEQ-HEAD) i (list '+ 'n i)))
(define (lzc-sel-at-name sel) (if (eq? sel 'SEQ-HEAD) 'seq-head-at 'seq-shift-at))
(define (lzc-sel-vec-name sel) (if (eq? sel 'SEQ-HEAD) 'seq-head-vec 'seq-shift-vec))
(define (lzc-sel-idx! sel i) (if (eq? sel 'SEQ-HEAD) (lzc-lo! i) (lzc-hi! i)))
(define (lzc-sel-vec! sel z) (if (not (dk-asm? (list 'IN (lzc-sel sel z) '(VEC (ZZ-POW n))))) (fact (lzc-sel-vec-name sel) 'm 'n z)))
(define (lzc-sel-at! sel z i) (subst (dk-cite! (lzc-sel-at-name sel) 'm 'n z i)))
;; prove (= (SEL n LHS-ARG) RHS) in Z^n componentwise; STEPS (of the index i and its image idx) rewrites both sides to one term
(define (lzc-sel-law! sel lhs rhs steps)
  (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list lhs 'i_) (list rhs 'i_))))
    (lambda ()
      (let* ((ld (dk-peel!)) (i (lzc-iv-var ld '(INTERVAL 1 n))) (idx (lzc-sel-idx sel i)))
        (lzc-sel-idx! sel i)
        (steps i idx))))
  (fact 'zz-pow-ext 'n lhs rhs)
  (ass))
(define (lzc-sel-stmt sel vars guards lhs rhs) (lzc-mstmt vars guards (list '= lhs rhs)))
(define LZC-VM '(VEC (ZZ-POW m)))
(define (lzc-mk-sel-laws! sel suffix)
  ;; vadd
  (let* ((xy '((VADD (ZZ-POW m)) x y))
         (lhs (lzc-sel sel xy))
         (rhs (list '(VADD (ZZ-POW n)) (lzc-sel sel 'x) (lzc-sel sel 'y))))
    (lzc-sp-qed! (lzc-mstmt '(x y) (list (list 'IN 'x LZC-VM) (list 'IN 'y LZC-VM)) (list '= lhs rhs))
      (lambda ()
    (dk-peel!)
      (lzc-msetup!)
      (fact 'module-vadd-type '(ZZ-POW m) 'x 'y)
      (lzc-sel-vec! sel 'x) (lzc-sel-vec! sel 'y) (lzc-sel-vec! sel xy)
      (fact 'module-vadd-type '(ZZ-POW n) (lzc-sel sel 'x) (lzc-sel sel 'y))
      (lzc-sel-law! sel lhs rhs
        (lambda (i idx)
          (lzc-sel-at! sel xy i)
          (subst (dk-cite! 'zz-pow-vadd-at 'm 'x 'y idx))
          (subst (dk-cite! 'zz-pow-vadd-at 'n (lzc-sel sel 'x) (lzc-sel sel 'y) i))
          (lzc-sel-at! sel 'x i) (lzc-sel-at! sel 'y i)
          (lzc-zc! 'm 'x idx) (lzc-zc! 'm 'y idx)
          (fact 'ring-add-closed 'ZZ-RING (list 'x idx) (list 'y idx))
          (rfl))))
      (symbol-append 'seq- suffix '-vadd)))
  ;; vneg
  (let* ((nx '((VNEG (ZZ-POW m)) x))
         (lhs (lzc-sel sel nx))
         (rhs (list '(VNEG (ZZ-POW n)) (lzc-sel sel 'x))))
    (lzc-sp-qed! (lzc-mstmt '(x) (list (list 'IN 'x LZC-VM)) (list '= lhs rhs))
      (lambda ()
    (dk-peel!)
      (lzc-msetup!)
      (fact 'module-vneg-type '(ZZ-POW m) 'x)
      (lzc-sel-vec! sel 'x) (lzc-sel-vec! sel nx)
      (fact 'module-vneg-type '(ZZ-POW n) (lzc-sel sel 'x))
      (lzc-sel-law! sel lhs rhs
        (lambda (i idx)
          (lzc-sel-at! sel nx i)
          (subst (dk-cite! 'zz-pow-vneg-at 'm 'x idx))
          (subst (dk-cite! 'zz-pow-vneg-at 'n (lzc-sel sel 'x) i))
          (lzc-sel-at! sel 'x i)
          (lzc-zc! 'm 'x idx)
          (fact 'ring-neg-in-carr 'ZZ-RING (list 'x idx))
          (rfl))))
      (symbol-append 'seq- suffix '-vneg)))
  ;; act
  (let* ((rx '((ACT (ZZ-POW m)) r x))
         (lhs (lzc-sel sel rx))
         (rhs (list '(ACT (ZZ-POW n)) 'r (lzc-sel sel 'x))))
    (lzc-sp-qed! (lzc-mstmt '(r x) (list '(IN r (CARR ZZ-RING)) (list 'IN 'x LZC-VM)) (list '= lhs rhs))
      (lambda ()
    (dk-peel!)
      (lzc-msetup!)
      (lzc-zvt! 'm rx)
      (lzc-sel-vec! sel 'x) (lzc-sel-vec! sel rx)
      (lzc-zvt! 'n rhs)
      (lzc-sel-law! sel lhs rhs
        (lambda (i idx)
          (lzc-sel-at! sel rx i)
          (subst (dk-cite! 'zz-pow-act-at 'm 'r 'x idx))
          (subst (dk-cite! 'zz-pow-act-at 'n 'r (lzc-sel sel 'x) i))
          (lzc-sel-at! sel 'x i)
          (lzc-zc! 'm 'x idx)
          (fact 'ring-carrier-closed-mul 'ZZ-RING 'r (list 'x idx))
          (rfl))))
      (symbol-append 'seq- suffix '-act)))
  ;; vzero
  (let* ((z0 '(VZERO (ZZ-POW m)))
         (lhs (lzc-sel sel z0))
         (rhs '(VZERO (ZZ-POW n))))
    (lzc-sp-qed! (lzc-mstmt '() '() (list '= lhs rhs))
      (lambda ()
    (dk-peel!)
      (lzc-msetup!)
      (fact 'module-vzero-in '(ZZ-POW m))
      (fact 'module-vzero-in '(ZZ-POW n))
      (lzc-sel-vec! sel z0)
      (lzc-sel-law! sel lhs rhs
        (lambda (i idx)
          (lzc-sel-at! sel z0 i)
          (subst (dk-cite! 'zz-pow-vzero-at 'm idx))
          (subst (dk-cite! 'zz-pow-vzero-at 'n i))
          (fact 'ring-zero-in 'ZZ-RING)
          (rfl))))
      (symbol-append 'seq- suffix '-vzero))))
(lzc-mk-sel-laws! 'SEQ-HEAD 'head)
(lzc-mk-sel-laws! 'SEQ-SHIFT 'shift)

;;; =====================================================================
;;; (3) the Schanuel automorphism of Z^(n+n)
;;; =====================================================================
(define LZC-ZN '(ZZ-POW n))
(define LZC-VN '(VEC (ZZ-POW n)))
(define (lzc-vadd a b) (list '(VADD (ZZ-POW n)) a b))
(define (lzc-vneg a) (list '(VNEG (ZZ-POW n)) a))
(define (lzc-hd z) (list 'SEQ-HEAD 'n z))
(define (lzc-sh z) (list 'SEQ-SHIFT 'n z))
(define (lzc-u la lb z) (lzc-vadd (lzc-sh z) (lzc-vneg (list lb (lzc-hd z)))))
(define (lzc-v la lb z) (lzc-vadd (lzc-hd z) (list la (lzc-u la lb z))))
(define (lzc-sc la lb) (list 'SCHANUEL-MAP 'm 'n la lb))
(define LZC-SHYPS (append LZC-MH '((IS-HOM-MODULE (ZZ-POW n) (ZZ-POW n) la) (IS-HOM-MODULE (ZZ-POW n) (ZZ-POW n) lb))))
(define (lzc-sstmt vars guards body) (forall-guarded (append '(m n la lb) vars) (append LZC-SHYPS guards) body))
(define (lzc-ssetup!)
  (lzc-msetup!)
  (lzc-hom-open! LZC-ZN LZC-ZN 'la)
  (lzc-hom-open! LZC-ZN LZC-ZN 'lb))
(define (lzc-app! f x)                    ; (IN (f x) VEC n) for f = la or lb, x in VEC n
  (if (not (dk-asm? (list 'IN (list f x) LZC-VN)))
      (fact 'fun-apply-type-c f LZC-VN LZC-VN x)))
(define (lzc-hs! z)                       ; type HEAD z, SHIFT z for z in VEC m
  (if (not (dk-asm? (list 'IN (lzc-hd z) LZC-VN))) (fact 'seq-head-vec 'm 'n z))
  (if (not (dk-asm? (list 'IN (lzc-sh z) LZC-VN))) (fact 'seq-shift-vec 'm 'n z)))
(define (lzc-uv! la lb z)                 ; type U, V of z
  (lzc-hs! z)
  (lzc-app! lb (lzc-hd z))
  (lzc-zvt! 'n (lzc-u la lb z))
  (lzc-app! la (lzc-u la lb z))
  (lzc-zvt! 'n (lzc-v la lb z)))

(sp (make-wff (lzc-sstmt '(z) '((IN z (VEC (ZZ-POW m))))
  (list '= (list (lzc-sc 'la 'lb) 'z) (list 'SEQ-JOIN 'm 'n (lzc-u 'la 'lb 'z) (lzc-v 'la 'lb 'z))))))
(dk-peel!)
(lzc-ssetup!)
(lzc-uv! 'la 'lb 'z)
(fact 'seq-join-vec 'm 'n (lzc-u 'la 'lb 'z) (lzc-v 'la 'lb 'z))
(mac 'SCHANUEL-MAP)
(if (not (lzc-beta!)) (rfl))
(lzc-done! 'schanuel-at)

(define (lzc-sc-at! la lb z)             ; rewrite (SC z) to its join in the goal
  (subst (dk-cite! 'schanuel-at 'm 'n la lb z)))
(sp (make-wff (lzc-sstmt '(z) '((IN z (VEC (ZZ-POW m)))) (list 'IN (list (lzc-sc 'la 'lb) 'z) '(VEC (ZZ-POW m))))))
(dk-peel!)
(lzc-ssetup!)
(lzc-uv! 'la 'lb 'z)
(lzc-sc-at! 'la 'lb 'z)
(fact 'seq-join-vec 'm 'n (lzc-u 'la 'lb 'z) (lzc-v 'la 'lb 'z))
(ass)
(lzc-done! 'schanuel-vec)

(sp (make-wff (lzc-sstmt '(z) '((IN z (VEC (ZZ-POW m)))) (list '= (lzc-hd (list (lzc-sc 'la 'lb) 'z)) (lzc-u 'la 'lb 'z)))))
(dk-peel!)
(lzc-ssetup!)
(lzc-uv! 'la 'lb 'z)
(lzc-sc-at! 'la 'lb 'z)
(dk-cite! 'seq-head-join 'm 'n (lzc-u 'la 'lb 'z) (lzc-v 'la 'lb 'z))
(ass)
(lzc-done! 'schanuel-head)

(sp (make-wff (lzc-sstmt '(z) '((IN z (VEC (ZZ-POW m)))) (list '= (lzc-sh (list (lzc-sc 'la 'lb) 'z)) (lzc-v 'la 'lb 'z)))))
(dk-peel!)
(lzc-ssetup!)
(lzc-uv! 'la 'lb 'z)
(lzc-sc-at! 'la 'lb 'z)
(dk-cite! 'seq-shift-join 'm 'n (lzc-u 'la 'lb 'z) (lzc-v 'la 'lb 'z))
(ass)
(lzc-done! 'schanuel-shift)

(sp (make-wff (lzc-sstmt '() '() (list 'IN (lzc-sc 'la 'lb) '(FUN (VEC (ZZ-POW m)) (VEC (ZZ-POW m)))))))
(dk-peel!)
(lzc-ssetup!)
(mac 'SCHANUEL-MAP)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!)) (z (lzc-iv-var ld '(VEC (ZZ-POW m)))))
      (if (not (lzc-beta!))
          (begin
            (lzc-uv! 'la 'lb z)
            (fact 'seq-join-vec 'm 'n (lzc-u 'la 'lb z) (lzc-v 'la 'lb z))
            (ass)))))
  (lambda () (fact 'lzq-vec-set '(ZZ-POW m)) (ass)))
(lzc-done! 'schanuel-type)

;; HEAD and SHIFT of (SC z), rewritten in the GOAL
(define (lzc-sch-hs! la lb z)
  (fact 'schanuel-vec 'm 'n la lb z)
  (lzc-uv! la lb z)
  (if (dk--occurs? (lzc-hd (list (lzc-sc la lb) z)) (dk-goal)) (subst (dk-cite! 'schanuel-head 'm 'n la lb z)))
  (if (dk--occurs? (lzc-sh (list (lzc-sc la lb) z)) (dk-goal)) (subst (dk-cite! 'schanuel-shift 'm 'n la lb z))))

;;; ---- the inverse ----
(define LZC-W '((SCHANUEL-MAP m n la lb) z))
(sp (make-wff (lzc-sstmt '(z) '((IN z (VEC (ZZ-POW m)))) (list '= (list (lzc-sc 'lb 'la) LZC-W) 'z))))
(dk-peel!)
(lzc-ssetup!)
(fact 'schanuel-vec 'm 'n 'la 'lb 'z)
(fact 'schanuel-vec 'm 'n 'lb 'la LZC-W)
(lzc-uv! 'la 'lb 'z)
(lzc-uv! 'lb 'la LZC-W)
(lzc-hs! (list (lzc-sc 'lb 'la) LZC-W))
(let* ((h (lzc-hd 'z)) (s (lzc-sh 'z))
       (uz (lzc-u 'la 'lb 'z)) (vz (lzc-v 'la 'lb 'z))
       (u2 (lzc-vadd vz (lzc-vneg (list 'la uz)))))       ; U'(w) after rewriting
  ;; U'(w) = HEAD z
  (dk-have! (list '= u2 h) (lambda () (lzc-zeq! 'n u2 h)))
  ;; HEAD part
  (dk-have! (list '= (lzc-hd (list (lzc-sc 'lb 'la) LZC-W)) h)
    (lambda ()
      (subst (dk-cite! 'schanuel-head 'm 'n 'lb 'la LZC-W))
      (subst (dk-cite! 'schanuel-shift 'm 'n 'la 'lb 'z))
      (subst (dk-cite! 'schanuel-head 'm 'n 'la 'lb 'z))
      (subst (list '= u2 h))
      (lzc-zvt! 'n h)
      (rfl)))
  ;; SHIFT part
  (dk-have! (list '= (lzc-sh (list (lzc-sc 'lb 'la) LZC-W)) s)
    (lambda ()
      (subst (dk-cite! 'schanuel-shift 'm 'n 'lb 'la LZC-W))
      (subst (dk-cite! 'schanuel-shift 'm 'n 'la 'lb 'z))
      (subst (dk-cite! 'schanuel-head 'm 'n 'la 'lb 'z))
      (subst (list '= u2 h))
      (lzc-app! 'lb h)
      (lzc-zeq! 'n (lzc-vadd uz (list 'lb h)) s)))
  (fact 'seq-split-ext 'm 'n (list (lzc-sc 'lb 'la) LZC-W) 'z)
  (ass))
(lzc-done! 'schanuel-inverse)

;;; ---- the Schanuel map is a homomorphism ----
(define (lzc-sub! thm . args) (subst (apply dk-cite! thm args)))
(define LZC-ZM '(ZZ-POW m))
(define (lzc-vaddm a b) (list '(VADD (ZZ-POW m)) a b))
(define (lzc-vnegm a) (list '(VNEG (ZZ-POW m)) a))
(define (lzc-actm r a) (list '(ACT (ZZ-POW m)) r a))
(define (lzc-actn r a) (list '(ACT (ZZ-POW n)) r a))
(define (lzc-scz z) (list (lzc-sc 'la 'lb) z))
;; split a P2 equation (= A B) into its HEAD and SHIFT equations, proved by HEAD-THUNK and SHIFT-THUNK
(define (lzc-split-prove! a b head-thunk shift-thunk)
  (dk-have! (list '= (lzc-hd a) (lzc-hd b)) head-thunk)
  (dk-have! (list '= (lzc-sh a) (lzc-sh b)) shift-thunk)
  (fact 'seq-split-ext 'm 'n a b)
  (ass))
(sp (make-wff (lzc-sstmt '() '() (list 'IS-HOM-MODULE LZC-ZM LZC-ZM (lzc-sc 'la 'lb)))))
(dk-peel!)
(lzc-ssetup!)
(fact 'schanuel-type 'm 'n 'la 'lb)
(mac 'is-hom-module-def)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'SCAL)) (rfl))
        ((dk-head-is? g '=)                    ; SC(0) = 0
         (let* ((z0 '(VZERO (ZZ-POW m))) (n0 '(VZERO (ZZ-POW n))))
           (fact 'module-vzero-in LZC-ZM) (fact 'module-vzero-in LZC-ZN)
           (lzc-hs! z0) (lzc-uv! 'la 'lb z0)
           (fact 'schanuel-vec 'm 'n 'la 'lb z0)
           (let ((eu (list '= (lzc-u 'la 'lb z0) n0)))
             (dk-have! eu
               (lambda ()
                 (lzc-sub! 'seq-shift-vzero 'm 'n)
                 (lzc-sub! 'seq-head-vzero 'm 'n)
                 (subst (list '= (list 'lb n0) n0))
                 (lzc-zeq! 'n (lzc-vadd n0 (lzc-vneg n0)) n0)))
             (lzc-split-prove! (lzc-scz z0) z0
               (lambda ()
                 (lzc-sub! 'schanuel-head 'm 'n 'la 'lb z0)
                 (subst eu)
                 (lzc-sub! 'seq-head-vzero 'm 'n)
                 (rfl))
               (lambda ()
                 (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb z0)
                 (subst eu)
                 (lzc-sub! 'seq-head-vzero 'm 'n)
                 (lzc-sub! 'seq-shift-vzero 'm 'n)
                 (subst (list '= (list 'la n0) n0))
                 (lzc-zeq! 'n (lzc-vadd n0 n0) n0))))))
        (#t
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC (ZZ-POW m))))) ld)))
                (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL (ZZ-POW m)))))) ld))))
           (for-each (lambda (x) (lzc-hs! x) (lzc-uv! 'la 'lb x) (fact 'schanuel-vec 'm 'n 'la 'lb x)) vs)
           (cond
             ((pair? rs)                       ; SC(r x) = r SC(x)
              (let* ((r (car rs)) (x (car vs)) (rx (lzc-actm r x))
                     (ux (lzc-u 'la 'lb x)) (vx (lzc-v 'la 'lb x)))
                (dk-have! (list 'IN r '(CARR ZZ-RING)) (lambda () (subst '(= ZZ-RING (SCAL (ZZ-POW m)))) (ass)))
                (dk-have! (list 'IN r '(CARR (SCAL (ZZ-POW n)))) (lambda () (subst '(= (SCAL (ZZ-POW n)) ZZ-RING)) (ass)))
                (lzc-zvt! 'm rx)
                (lzc-hs! rx) (lzc-uv! 'la 'lb rx) (fact 'schanuel-vec 'm 'n 'la 'lb rx)
                (lzc-zvt! 'm (lzc-actm r (lzc-scz x)))
                (let ((eu (list '= (lzc-u 'la 'lb rx) (lzc-actn r ux))))
                  (dk-have! eu
                    (lambda ()
                      (lzc-sub! 'seq-shift-act 'm 'n r x)
                      (lzc-sub! 'seq-head-act 'm 'n r x)
                      (subst (dk-apply! (lzc-hcl-act LZC-ZN LZC-ZN 'lb) r (lzc-hd x)))
                      (lzc-zeq! 'n (lzc-vadd (lzc-actn r (lzc-sh x)) (lzc-vneg (lzc-actn r (list 'lb (lzc-hd x))))) (lzc-actn r ux))))
                  (lzc-split-prove! (lzc-scz rx) (lzc-actm r (lzc-scz x))
                    (lambda ()
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb rx)
                      (subst eu)
                      (lzc-sub! 'seq-head-act 'm 'n r (lzc-scz x))
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb x)
                      (lzc-zvt! 'n (lzc-actn r ux))
                      (rfl))
                    (lambda ()
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb rx)
                      (subst eu)
                      (subst (dk-apply! (lzc-hcl-act LZC-ZN LZC-ZN 'la) r ux))
                      (lzc-sub! 'seq-head-act 'm 'n r x)
                      (lzc-sub! 'seq-shift-act 'm 'n r (lzc-scz x))
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb x)
                      (lzc-zeq! 'n (lzc-vadd (lzc-actn r (lzc-hd x)) (lzc-actn r (list 'la ux))) (lzc-actn r vx)))))))
             ((= (length vs) 2)                ; SC(x + y) = SC x + SC y
              (let* ((x (car vs)) (y (cadr vs)) (xy (lzc-vaddm x y))
                     (ux (lzc-u 'la 'lb x)) (uy (lzc-u 'la 'lb y))
                     (vx (lzc-v 'la 'lb x)) (vy (lzc-v 'la 'lb y)))
                (lzc-zvt! 'm xy)
                (lzc-hs! xy) (lzc-uv! 'la 'lb xy) (fact 'schanuel-vec 'm 'n 'la 'lb xy)
                (lzc-zvt! 'm (lzc-vaddm (lzc-scz x) (lzc-scz y)))
                (let ((eu (list '= (lzc-u 'la 'lb xy) (lzc-vadd ux uy))))
                  (dk-have! eu
                    (lambda ()
                      (lzc-sub! 'seq-shift-vadd 'm 'n x y)
                      (lzc-sub! 'seq-head-vadd 'm 'n x y)
                      (subst (dk-apply! (lzc-hcl-add LZC-ZN LZC-ZN 'lb) (lzc-hd x) (lzc-hd y)))
                      (lzc-zeq! 'n (lzc-vadd (lzc-vadd (lzc-sh x) (lzc-sh y)) (lzc-vneg (lzc-vadd (list 'lb (lzc-hd x)) (list 'lb (lzc-hd y)))))
                                (lzc-vadd ux uy))))
                  (lzc-split-prove! (lzc-scz xy) (lzc-vaddm (lzc-scz x) (lzc-scz y))
                    (lambda ()
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb xy)
                      (subst eu)
                      (lzc-sub! 'seq-head-vadd 'm 'n (lzc-scz x) (lzc-scz y))
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb x)
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb y)
                      (lzc-zvt! 'n (lzc-vadd ux uy))
                      (rfl))
                    (lambda ()
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb xy)
                      (subst eu)
                      (subst (dk-apply! (lzc-hcl-add LZC-ZN LZC-ZN 'la) ux uy))
                      (lzc-sub! 'seq-head-vadd 'm 'n x y)
                      (lzc-sub! 'seq-shift-vadd 'm 'n (lzc-scz x) (lzc-scz y))
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb x)
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb y)
                      (lzc-zeq! 'n (lzc-vadd (lzc-vadd (lzc-hd x) (lzc-hd y)) (lzc-vadd (list 'la ux) (list 'la uy)))
                                (lzc-vadd vx vy)))))))
             (#t                               ; SC(-x) = -SC(x)
              (let* ((x (car vs)) (nx (lzc-vnegm x))
                     (ux (lzc-u 'la 'lb x)) (vx (lzc-v 'la 'lb x)))
                (lzc-zvt! 'm nx)
                (lzc-hs! nx) (lzc-uv! 'la 'lb nx) (fact 'schanuel-vec 'm 'n 'la 'lb nx)
                (lzc-zvt! 'm (lzc-vnegm (lzc-scz x)))
                (let ((eu (list '= (lzc-u 'la 'lb nx) (lzc-vneg ux))))
                  (dk-have! eu
                    (lambda ()
                      (lzc-sub! 'seq-shift-vneg 'm 'n x)
                      (lzc-sub! 'seq-head-vneg 'm 'n x)
                      (subst (dk-apply! (lzc-hcl-neg LZC-ZN LZC-ZN 'lb) (lzc-hd x)))
                      (lzc-zeq! 'n (lzc-vadd (lzc-vneg (lzc-sh x)) (lzc-vneg (lzc-vneg (list 'lb (lzc-hd x))))) (lzc-vneg ux))))
                  (lzc-split-prove! (lzc-scz nx) (lzc-vnegm (lzc-scz x))
                    (lambda ()
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb nx)
                      (subst eu)
                      (lzc-sub! 'seq-head-vneg 'm 'n (lzc-scz x))
                      (lzc-sub! 'schanuel-head 'm 'n 'la 'lb x)
                      (lzc-zvt! 'n (lzc-vneg ux))
                      (rfl))
                    (lambda ()
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb nx)
                      (subst eu)
                      (subst (dk-apply! (lzc-hcl-neg LZC-ZN LZC-ZN 'la) ux))
                      (lzc-sub! 'seq-head-vneg 'm 'n x)
                      (lzc-sub! 'seq-shift-vneg 'm 'n (lzc-scz x))
                      (lzc-sub! 'schanuel-shift 'm 'n 'la 'lb x)
                      (lzc-zeq! 'n (lzc-vadd (lzc-vneg (lzc-hd x)) (lzc-vneg (list 'la ux))) (lzc-vneg vx))))))))))))))
(lzc-done! 'schanuel-hom)

(sp (make-wff (lzc-sstmt '() '() (list 'IS-ISO-MODULE LZC-ZM LZC-ZM (lzc-sc 'la 'lb)))))
(dk-peel!)
(lzc-ssetup!)
(fact 'schanuel-hom 'm 'n 'la 'lb)
(fact 'schanuel-type 'm 'n 'la 'lb)
(fact 'schanuel-type 'm 'n 'lb 'la)
(mac 'IS-ISO-MODULE)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (begin
          (dk-have! (list 'FORALL 'u_ (list 'IMPLIES '(IN u_ (VEC (ZZ-POW m))) (list '= (list (lzc-sc 'lb 'la) (list (lzc-sc 'la 'lb) 'u_)) 'u_)))
            (lambda () (let* ((ld (dk-peel!)) (z (lzc-iv-var ld '(VEC (ZZ-POW m))))) (dk-cite! 'schanuel-inverse 'm 'n 'la 'lb z) (ass))))
          (dk-have! (list 'FORALL 'v_ (list 'IMPLIES '(IN v_ (VEC (ZZ-POW m))) (list '= (list (lzc-sc 'la 'lb) (list (lzc-sc 'lb 'la) 'v_)) 'v_)))
            (lambda () (let* ((ld (dk-peel!)) (z (lzc-iv-var ld '(VEC (ZZ-POW m))))) (dk-cite! 'schanuel-inverse 'm 'n 'lb 'la z) (ass))))
          (fact 'bijection-from-inverse '(VEC (ZZ-POW m)) '(VEC (ZZ-POW m)) (lzc-sc 'la 'lb) (lzc-sc 'lb 'la))
          (ass)))))
(lzc-done! 'schanuel-iso)
(gloss! 'schanuel-iso "Schanuel's automorphism: for homomorphisms la, lb of Z^n, (t, b) |-> (b - lb(t), t + la(b - lb(t))) is an automorphism of Z^(n+n).")

