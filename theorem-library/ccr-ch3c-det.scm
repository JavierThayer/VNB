;;; ccr-ch3c-det.scm -- wave of 2026-11-09/10 (agent CCR-1109-B3), wired 2026-11-10 from scratchpad/ccr1109b3/ccr-ch3c-det.scm.
;;; Library: analysis.

;;; ccr-ch3c-det.scm -- CCR.pdf chapter 3, the continuity of the determinant in the form Lemma 3.4 uses:
;;;
;;;     ||A||_max <= 1, ||B||_max <= 1 and ||A - B||_max <= e  imply  |det A - det B|_K <= e
;;;
;;; over an NV field K, for n-by-n matrices.  Agent CCR-1109-B3, wave 2026-11-09.
;;; Destination: theorem-library/ccr-ch3c-det.scm.  Library: analysis.  Helper prefix cd6-.
;;;
;;; ROUTE.  Induction on n through the cofactor expansion along the first row (det-cofactor), as
;;; cb3-det-bound-ind (ccr-ch3-ops).  With s_j the sign, a_j, b_j the first-row entries and x_j, y_j the
;;; first-row minors' determinants,
;;;     det A - det B = sum_j s_j (a_j x_j - b_j y_j)                      (finsum-add-ag, finsum-congruence)
;;;     a x - b y     = (a - b) x + b (x - y)                               (crs)
;;;     |(a - b) x| <= e * 1  (|x| <= 1^n by (21)),   |b (x - y)| <= 1 * e  (the induction hypothesis on the
;;;     minors, which are again bounded by 1 and e-close: cd6-minor-close),
;;; and the ultrametric bound on the finite sum (nv-finsum-le) does the work of "max over j".
;;;
;;; LOAD WINDOW: after theorem-library/ccr-ch3-ops (cb3-minor-bound, cb3-sign-norm, ccr-3-1-eq21, CCR-1109-B,
;;; unwired) and structure-library/ccr-ch3c-vocab (IS-MAT-CLOSE); every other citation is earlier
;;; (determinant, finsum, ccr2-nv).

(define cd6-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define cd6-ag `(RING-ADDITIVE-AG ,cd6-v))
(define (cd6-n x) `((FNRM K) ,x))
(define (cd6-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define (cd6-mat m n) `(MAT ,m ,n (CARR K)))
(define (cd6-matv m n) `(MAT ,m ,n (CARR ,cd6-v)))

(define (cd6-find pred tree)
  (let walk ((t tree))
    (cond ((pred t) t)
          ((pair? t) (or (walk (car t)) (walk (cdr t))))
          (#t #f))))

(define (cd6-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cd6: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 12 (length a))))))
                  (dk-open-leaves))))
  (qed name))

(define (cd6-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring cd6-v)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-one normed-field-ring-view-zero normed-field-ring-view-neg)))
(define (cd6-to-v! a m n)
  (dk-have! `(IN ,a ,(cd6-matv m n)) (lambda () (subst `(= (CARR ,cd6-v) (CARR K))) (dk-ass!))))
(define (cd6-to-k! a m n)
  (dk-have! `(IN ,a ,(cd6-mat m n)) (lambda () (subst `(= (CARR K) (CARR ,cd6-v))) (dk-ass!))))
(define (cd6-in-k! t)                    ; t in CARR V in context -> t in CARR K
  (dk-have! `(IN ,t (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cd6-v))) (dk-ass!))))

;; crs in the ring view: the K operations are rewritten to V's, the atoms typed in CARR V
(define (cd6-in-v! t)
  (if (not (dk-asm? `(IN ,t (CARR ,cd6-v))))
      (dk-have! `(IN ,t (CARR ,cd6-v)) (lambda () (subst `(= (CARR ,cd6-v) (CARR K))) (dk-ass!)))))
(define (cd6-crs! eq atoms)
  (dk-have! eq
    (lambda ()
      (for-each cd6-in-v! atoms)
      (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cd6-v)))))
                '(ADD MUL NEG ONE ZERO))
      (crs))))

;; the projections of IS-MAT-BOUND / IS-MAT-CLOSE, the hypothesis kept
(define (cd6-bound-univ a m n c)
  `(FORALL cbvi_ (IMPLIES (IN cbvi_ (INTERVAL 1 ,m))
     (FORALL cbvj_ (IMPLIES (IN cbvj_ (INTERVAL 1 ,n)) (<= ,(cd6-n `(ENTRY ,a cbvi_ cbvj_)) ,c))))))
(define (cd6-bound-parts! a m n c)
  (let ((h `(IS-MAT-BOUND K ,m ,n ,a ,c)))
    (dk-project! (cd6-bound-univ a m n c) (lambda () (mac-h 'is-mat-bound h)))))
(define (cd6-close-univ a b m n e)
  `(FORALL cdvi_ (IMPLIES (IN cdvi_ (INTERVAL 1 ,m))
     (FORALL cdvj_ (IMPLIES (IN cdvj_ (INTERVAL 1 ,n))
       (<= ,(cd6-n (cd6-sub `(ENTRY ,a cdvi_ cdvj_) `(ENTRY ,b cdvi_ cdvj_))) ,e))))))
(define (cd6-close-parts! a b m n e)
  (let ((h `(IS-MAT-CLOSE K ,m ,n ,a ,b ,e)))
    (dk-project! (cd6-close-univ a b m n e) (lambda () (mac-h 'is-mat-close h)))))

;;; 0. (u + v) - v = u in a normed field.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL cdu (IMPLIES (IN cdu (CARR K)) (FORALL cdw (IMPLIES (IN cdw (CARR K))
  (= ,(cd6-sub '((ADD K) cdu cdw) 'cdw) cdu)))))))))
(dk-peel!)
(cd6-view!)
(let ((g (dk-goal)))
  (cd6-crs! g (list (caddr g) (cadr (caddr (cadr g)))))
  (dk-ass!))
(cd6-qed! 'cd6-add-sub-cancel)

;;; 1. The first-row minors of e-close matrices are e-close.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL A (FORALL B (FORALL e
  (IMPLIES (IS-MAT-CLOSE K (succ n) (succ n) A B e)
    (FORALL cdq (IMPLIES (IN cdq (INTERVAL 1 (succ n)))
      (IS-MAT-CLOSE K n n (MINOR A 1 cdq n) (MINOR B 1 cdq n) e)))))))))))))
(dk-peel!)
(cd6-view!)
(let* ((hc '(IS-MAT-CLOSE K (succ n) (succ n) A B e))
       (cl (cd6-close-parts! 'A 'B '(succ n) '(succ n) 'e))
       (qv (cadddr (list-ref (dk-goal) 4)))
       (mna `(MINOR A 1 ,qv n)) (mnb `(MINOR B 1 ,qv n)))
  (dk-project! `(IN A ,(cd6-mat '(succ n) '(succ n))) (lambda () (mac-h 'is-mat-close hc)))
  (dk-project! `(IN B ,(cd6-mat '(succ n) '(succ n))) (lambda () (mac-h 'is-mat-close hc)))
  (cd6-to-v! 'A '(succ n) '(succ n))
  (cd6-to-v! 'B '(succ n) '(succ n))
  (dk-cite! 'interval-elt-in-nn 1 '(succ n) qv)
  (dk-cite! 'nn-one-in)
  (dk-cite! 'nn-succ-closed 'n)
  (dk-cite! 'minor-type cd6-v 'A 1 qv 'n)
  (dk-cite! 'minor-type cd6-v 'B 1 qv 'n)
  (cd6-to-k! mna 'n 'n)
  (cd6-to-k! mnb 'n 'n)
  (mac 'is-mat-close)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (dk-ass!)
          (begin
            (dk-peel!)
            (let* ((g (dk-goal))
                   (ea (cadr (cadr (cadr g)))) (uv (caddr ea)) (vv (cadddr ea)))
              (dk-cite! 'dtr-minor1-entry cd6-v 'n 'A qv uv vv)
              (dk-cite! 'dtr-minor1-entry cd6-v 'n 'B qv uv vv)
              (let* ((ift `(IF (< ,vv ,qv) ,vv (succ ,vv))))
                (subst `(= ,ea (ENTRY A (succ ,uv) ,ift)))
                (subst `(= (ENTRY (MINOR B 1 ,qv n) ,uv ,vv) (ENTRY B (succ ,uv) ,ift)))
                (for-each (lambda (w) (dk-cite! 'interval-lo 1 'n w) (dk-cite! 'interval-hi 1 'n w)
                                      (dk-cite! 'interval-elt-in-nn 1 'n w) (dk-cite! 'nn-succ-closed w))
                          (list uv vv))
                (dk-cite! 'interval-lo 1 '(succ n) qv) (dk-cite! 'interval-hi 1 '(succ n) qv)
                (dk-have! `(<= 1 (succ ,uv)) (lambda () (dk-nn!)))
                (dk-cite! 'nn-succ-mono uv 'n)
                (dk-cite! 'nn-le-succ 'n)
                (dk-cite! 'interval-mem-intro 1 '(succ n) `(succ ,uv))
                (dk-case-if! ift
                  (lambda (true? val)
                    (dk-have! `(<= 1 ,val) (lambda () (dk-nn!)))
                    (if true?
                        (dk-cite! 'nn-le-trans-guarded val 'n '(succ n))
                        (dk-cite! 'nn-succ-mono vv 'n))
                    (dk-cite! 'interval-mem-intro 1 '(succ n) val)
                    (dk-apply! cl `(succ ,uv) val)
                    (dk-ass!))))))))))
(cd6-qed! 'cd6-minor-close)

;;; 2. The induction.

(sp (make-wff `(FORALL cdn (IMPLIES (IN cdn NN) (FORALL K (IMPLIES (IS-NV-FIELD K)
  (FORALL A (IMPLIES (IN A ,(cd6-mat 'cdn 'cdn)) (FORALL B (IMPLIES (IN B ,(cd6-mat 'cdn 'cdn))
    (FORALL e (IMPLIES (IN e RR) (IMPLIES (<= 0 e)
      (IMPLIES (IS-MAT-BOUND K cdn cdn A 1) (IMPLIES (IS-MAT-BOUND K cdn cdn B 1) (IMPLIES (IS-MAT-CLOSE K cdn cdn A B e)
        (<= ,(cd6-n (cd6-sub `(DET ,cd6-v cdn A) `(DET ,cd6-v cdn B))) e)))))))))))))))))
(let* ((r (dk-ni-fixed! '(K))) (base (cdr (assq 'base r))) (step (cdr (assq 'step r))))
  ;; n = 0: det A = det B = 1
  (dk-focus! base)
  (dk-peel!)
  (let* ((g (dk-goal)) (df (cadr (cadr g)))
         (av (cadddr (cadr df))) (bv (cadddr (cadr (caddr df)))))
    (dk-cite! 'nv-field-normed 'K)
    (cd6-view!)
    (dk-cite! 'det-zero cd6-v av)
    (dk-cite! 'det-zero cd6-v bv)
    (subst `(= (DET ,cd6-v 0 ,av) (ONE ,cd6-v)))
    (subst `(= (DET ,cd6-v 0 ,bv) (ONE ,cd6-v)))
    (subst `(= (ONE ,cd6-v) (ONE K)))
    (dk-cite! 'nf-one-in-carr 'K)
    (dk-cite! 'nf-zero-in-carr 'K)
    (cd6-crs! `(= ,(cd6-sub '(ONE K) '(ONE K)) (ZERO K)) '())
    (subst `(= ,(cd6-sub '(ONE K) '(ONE K)) (ZERO K)))
    (dk-cite! 'nf-norm-of-zero 'K)
    (subst `(= ,(cd6-n '(ZERO K)) 0))
    (dk-ass!))
  ;; n -> n + 1
  (dk-focus! step)
  (dk-peel!)
  (let* ((g (dk-goal)) (df (cadr (cadr g)))
         (dta (cadr df)) (nv (cadr (caddr dta))) (av (cadddr dta)) (bv (cadddr (cadr (caddr df))))
         (ev (caddr g)) (sn `(succ ,nv)) (sq `(INTERVAL 1 ,sn))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DET))) "the induction hypothesis")))
    (dk-cite! 'nv-field-normed 'K)
    (cd6-view!)
    (dk-cite! 'nn-succ-closed nv)
    (dk-cite! 'nn-one-in)
    (cd6-to-v! av sn sn)
    (cd6-to-v! bv sn sn)
    (dk-cite! 'interval-in-set 1 sn)
    (dk-cite! 'interval-card-in-nn 1 sn)
    (dk-cite! 'ring-additive-ag-is-abelian-group cd6-v)
    (dk-cite! 'raag-carr cd6-v)
    (dk-cite! 'raag-opr cd6-v)
    (let* ((bnda (cd6-bound-parts! av sn sn 1))
           (bndb (cd6-bound-parts! bv sn sn 1))
           (cl (cd6-close-parts! av bv sn sn ev))
           (eqa0 (dk-cite! 'det-cofactor cd6-v nv av))
           (eqb0 (dk-cite! 'det-cofactor cd6-v nv bv))
           (eqa (dk-rewrite-h! eqa0 `(MUL ,cd6-v) '(MUL K)))
           (eqb (dk-rewrite-h! eqb0 `(MUL ,cd6-v) '(MUL K)))
           (fa (caddr (caddr eqa))) (fb (caddr (caddr eqb)))
           (ta (lambda (z) (subst-free (cadr fa) z (cadddr fa))))
           (tb (lambda (z) (subst-free (cadr fb) z (cadddr fb))))
           (fd `(VNB-LAMBDA cd6z_ ,sq ,(cd6-sub (ta 'cd6z_) (tb 'cd6z_))))
           (sa `(FINSUM ,cd6-ag ,fa ,sq)) (sb `(FINSUM ,cd6-ag ,fb ,sq)) (sd `(FINSUM ,cd6-ag ,fd ,sq))
           ;; the per-index facts, z in [1, n+1] in context: typings, and (for the D summand) the bound
           (sgn (lambda (z) `(MPOW (RING-MULTIPLICATIVE-MONOID ,cd6-v) ((NEG ,cd6-v) (ONE ,cd6-v)) (succ ,z))))
           (typ!
            (lambda (z)
              (let* ((vm `(RING-MULTIPLICATIVE-MONOID ,cd6-v)) (sg (sgn z)))
                (dk-cite! 'interval-elt-in-nn 1 sn z)
                (dk-cite! 'nn-succ-closed z)
                (dk-cite! 'ring-multiplicative-monoid-is-monoid cd6-v)
                (dk-cite! 'rmm-carr cd6-v)
                (dk-cite! 'ring-one-in cd6-v)
                (dk-cite! 'ring-neg-in-carr cd6-v `(ONE ,cd6-v))
                (dk-have! `(IN ((NEG ,cd6-v) (ONE ,cd6-v)) (CARR ,vm))
                  (lambda () (subst `(= (CARR ,vm) (CARR ,cd6-v))) (dk-ass!)))
                (dk-cite! 'mpow-type vm `((NEG ,cd6-v) (ONE ,cd6-v)) `(succ ,z))
                (dk-have! `(IN ,sg (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cd6-v))) (subst `(= (CARR ,cd6-v) (CARR ,vm))) (dk-ass!)))
                (for-each
                  (lambda (m)
                    (let* ((e `(ENTRY ,m 1 ,z)) (mn `(MINOR ,m 1 ,z ,nv)) (d `(DET ,cd6-v ,nv ,mn)))
                      (dk-cite! 'entry-in-carrier sn sn '(CARR K) m 1 z)
                      (dk-cite! 'minor-type cd6-v m 1 z nv)
                      (cd6-to-k! mn nv nv)
                      (dk-cite! 'det-in-carrier cd6-v nv mn)
                      (cd6-in-k! d)
                      (dk-cite! 'nf-mul-in-carr 'K e d)
                      (dk-cite! 'nf-mul-in-carr 'K sg `((MUL K) ,e ,d))))
                  (list av bv))
                (dk-cite! 'nf-neg-in-carr 'K (tb z))
                (dk-cite! 'nf-add-in-carr 'K (ta z) `((NEG K) ,(tb z)))))))
      (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
      (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
      (dk-cite! 'interval-mem-intro 1 sn 1)
      ;; (i) the D summand: typed and bounded by e
      (dk-have! `(FORALL cw3z_ (IMPLIES (IN cw3z_ ,sq)
                   (AND (IN (,fd cw3z_) (CARR K)) (<= ,(cd6-n `(,fd cw3z_)) ,ev))))
        (lambda ()
          (let* ((landed (dk-peel!)) (zv (cadr (car landed)))
                 (sg (sgn zv))
                 (a `(ENTRY ,av 1 ,zv)) (b `(ENTRY ,bv 1 ,zv))
                 (mna `(MINOR ,av 1 ,zv ,nv)) (mnb `(MINOR ,bv 1 ,zv ,nv))
                 (x `(DET ,cd6-v ,nv ,mna)) (y `(DET ,cd6-v ,nv ,mnb))
                 (amb (cd6-sub a b)) (xmy (cd6-sub x y))
                 (p1 `((MUL K) ,amb ,x)) (p2 `((MUL K) ,b ,xmy))
                 (w `((ADD K) ,p1 ,p2)))
            (dk-lam-b!)
            (typ! zv)
            (dk-cite! 'nf-neg-in-carr 'K b) (dk-cite! 'nf-add-in-carr 'K a `((NEG K) ,b))
            (dk-cite! 'nf-neg-in-carr 'K y) (dk-cite! 'nf-add-in-carr 'K x `((NEG K) ,y))
            (dk-cite! 'nf-mul-in-carr 'K amb x) (dk-cite! 'nf-mul-in-carr 'K b xmy)
            (dk-cite! 'nf-add-in-carr 'K p1 p2)
            (cd6-crs! `(= ,(cd6-sub (ta zv) (tb zv)) ((MUL K) ,sg ,w)) (list sg a b x y))
            ;; the bounds
            (for-each (lambda (t) (dk-cite! 'nf-norm-in-rr 'K t) (dk-cite! 'nf-norm-nonneg 'K t))
                      (list amb x b xmy p1 p2 w sg))
            (dk-apply! bndb 1 zv)
            (dk-apply! cl 1 zv)
            (dk-cite! 'cb3-minor-bound 'K nv av 1 zv)
            (dk-cite! 'cb3-minor-bound 'K nv bv 1 zv)
            (dk-cite! 'cd6-minor-close 'K nv av bv ev zv)
            (dk-cite! 'nn-in-rr 1)
            (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
            (dk-cite! 'ccr-3-1-eq21 'K nv mna 1)
            (dk-cite! 'rr-power-one nv)
            (dk-rewrite-h! (dk-ctx-form `(<= ,(cd6-n x) (power 1 ,nv))) `(power 1 ,nv) 1)
            (dk-apply! ih mna mnb ev)
            (dk-cite! 'rr-prod-le-gen (cd6-n amb) (cd6-n x) ev 1)
            (dk-cite! 'rr-prod-le-gen (cd6-n b) (cd6-n xmy) 1 ev)
            (dk-cite! 'nf-norm-mult 'K amb x)
            (dk-cite! 'nf-norm-mult 'K b xmy)
            (dk-cite! 'nf-norm-mult 'K sg w)
            (dk-cite! 'cb3-sign-norm 'K `(succ ,zv))
            (dk-cite! 'nv-ultra 'K p1 p2)
            (dk-have! `(<= ,(cd6-n p1) ,ev)
              (lambda () (subst `(= ,(cd6-n p1) (* ,(cd6-n amb) ,(cd6-n x))))
                         (dk-have! `(= (* ,ev 1) ,ev) (lambda () (crs)))
                         (subst `(= ,ev (* ,ev 1)))
                         (dk-ass!)))
            (dk-have! `(<= ,(cd6-n p2) ,ev)
              (lambda () (subst `(= ,(cd6-n p2) (* ,(cd6-n b) ,(cd6-n xmy))))
                         (dk-have! `(= (* 1 ,ev) ,ev) (lambda () (crs)))
                         (subst `(= ,ev (* 1 ,ev)))
                         (dk-ass!)))
            (dk-cite! 'rr-max-le (cd6-n p1) (cd6-n p2) ev)
            (dk-cite! 'rr-max-closed (cd6-n p1) (cd6-n p2))
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (dk-ass!)
                    (begin
                      (subst `(= ,(cd6-sub (ta zv) (tb zv)) ((MUL K) ,sg ,w)))
                      (subst `(= ,(cd6-n `((MUL K) ,sg ,w)) (* ,(cd6-n sg) ,(cd6-n w))))
                      (subst `(= ,(cd6-n sg) 1))
                      (dk-ineq! `(<= ,(cd6-n w) (max ,(cd6-n p1) ,(cd6-n p2)))
                                `(<= (max ,(cd6-n p1) ,(cd6-n p2)) ,ev)
                                `(IN (max ,(cd6-n p1) ,(cd6-n p2)) RR)
                                `(IN ,(cd6-n w) RR) `(IN ,ev RR)))))))))
      (let ((dpt (dk-ctx-form `(FORALL cw3z_ (IMPLIES (IN cw3z_ ,sq)
                   (AND (IN (,fd cw3z_) (CARR K)) (<= ,(cd6-n `(,fd cw3z_)) ,ev)))))))
        (dk-cite! 'nv-finsum-le 'K sq fd ev)
        ;; (ii) the typings of the B summand and of the D summand, pointwise in CARR(ag), and FUN typings
        (for-each
          (lambda (f)
            (dk-have! `(IN ,f (FUN ,sq (CARR ,cd6-ag)))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
                      (typ! zv)
                      (subst `(= (CARR ,cd6-ag) (CARR ,cd6-v))) (subst `(= (CARR ,cd6-v) (CARR K)))
                      (dk-ass!)))))))
          (list fd fb))
        ;; (iii) sum_j A-summand = (sum_j D-summand) + (sum_j B-summand)
        (let* ((add-eq (dk-cite! 'finsum-add-ag cd6-ag sq fd fb))
               (lam (caddr (cadr add-eq))))
          (dk-have! `(FORALL cd6w_ (IMPLIES (IN cd6w_ ,sq) (= (,lam cd6w_) (,fa cd6w_))))
            (lambda ()
              (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
                (typ! zv)
                (dk-lam-b!)
                (subst `(= (OPR ,cd6-ag) (ADD ,cd6-v)))
                (subst `(= (ADD ,cd6-v) (ADD K)))
                (dk-cite! 'nf-sub-add-back 'K (ta zv) (tb zv))
                (dk-ass!))))
          (dk-have! `(FORALL cd6w_ (IMPLIES (IN cd6w_ ,sq) (IN (,lam cd6w_) (CARR ,cd6-ag))))
            (lambda ()
              (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
                (typ! zv)
                (dk-lam-b!)
                (subst `(= (OPR ,cd6-ag) (ADD ,cd6-v)))
                (subst `(= (ADD ,cd6-v) (ADD K)))
                (dk-cite! 'nf-add-in-carr 'K (cd6-sub (ta zv) (tb zv)) (tb zv))
                (subst `(= (CARR ,cd6-ag) (CARR ,cd6-v))) (subst `(= (CARR ,cd6-v) (CARR K)))
                (dk-ass!))))
          (dk-cite! 'finsum-congruence cd6-ag sq lam fa)
          ;; typings of the three sums in CARR K
          (for-each
            (lambda (f)
              (dk-have! `(FORALL cd6u_ (IMPLIES (IN cd6u_ ,sq) (IN (,f cd6u_) (CARR ,cd6-ag))))
                (lambda ()
                  (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
                    (typ! zv)
                    (dk-lam-b!)
                    (subst `(= (CARR ,cd6-ag) (CARR ,cd6-v))) (subst `(= (CARR ,cd6-v) (CARR K)))
                    (dk-ass!))))
              (dk-cite! 'finsum-type-ptwise cd6-ag sq f))
            (list fd fb))
          (for-each (lambda (s) (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cd6-v))) (subst `(= (CARR ,cd6-v) (CARR ,cd6-ag))) (dk-ass!))))
                    (list sd sb))
          (subst eqa)
          (subst eqb)
          (subst `(= ,sa (FINSUM ,cd6-ag ,lam ,sq)))
          (subst add-eq)
          (subst `(= (OPR ,cd6-ag) (ADD ,cd6-v)))
          (subst `(= (ADD ,cd6-v) (ADD K)))
          (dk-cite! 'cd6-add-sub-cancel 'K sd sb)
          (subst `(= ,(cd6-sub `((ADD K) ,sd ,sb) sb) ,sd))
          (dk-ass!))))))
(cd6-qed! 'cd6-det-close-ind)

;;; 3. The statement: ||A||, ||B|| <= 1 and ||A - B||_max <= e give |det A - det B| <= e.

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL A (FORALL B (FORALL e
  (IMPLIES (IN e RR) (IMPLIES (<= 0 e)
    (IMPLIES (IS-MAT-BOUND K n n A 1) (IMPLIES (IS-MAT-BOUND K n n B 1) (IMPLIES (IS-MAT-CLOSE K n n A B e)
      (<= ,(cd6-n (cd6-sub `(DET ,cd6-v n A) `(DET ,cd6-v n B))) e)))))))))))))))
(dk-peel!)
(dk-project! `(IN A ,(cd6-mat 'n 'n)) (lambda () (mac-h 'is-mat-bound '(IS-MAT-BOUND K n n A 1))))
(dk-project! `(IN B ,(cd6-mat 'n 'n)) (lambda () (mac-h 'is-mat-bound '(IS-MAT-BOUND K n n B 1))))
(dk-cite! 'cd6-det-close-ind 'n 'K 'A 'B 'e)
(dk-ass!)
