(dk-have! (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ LZT-TV)
            (list 'FORSOME 'x_ (list 'AND '(IN x_ (VEC md)) (list '= (list LZT-PH 'x_) 'y_)))))
  (lambda () (let* ((ld (dk-peel!)) (y (cadr (car ld)))) (dk-cite! 'lzt-ph-onto 'md 'n 'es 'dm 'sm y) (ass))))
(dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC md))
            (list 'IFF (list '= (list LZT-PH 'x_) (list 'VZERO LZT-T)) '(IN x_ sm))))
  (lambda () (let* ((ld (dk-peel!)) (x (cadr (car ld)))) (dk-cite! 'lzt-ph-kernel 'md 'n 'es 'dm 'sm x) (ass))))
(let ((iso (dk-cite! 'first-isomorphism-module 'md LZT-T LZT-PH 'sm)))
  (ew (cadddr iso))
  (ass))
(lzt-done! 'quotient-by-diagonal-subgroup)
