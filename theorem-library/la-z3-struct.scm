;;; la-z3-struct.scm -- the first isomorphism theorem for modules, and linear algebra
;;; 3.49 (LA-Z3, 2026-10-24).  Vocabulary: structure-library/la-z3-vocab.  Prefix lzt-.
;;;
;;; PLAN.
;;;  (A) first-isomorphism-module: a surjective homomorphism phi : M -> N whose kernel is
;;;      the submodule F induces the isomorphism M/F -> N, DESCEND(phi).
;;;  (B) 3.49: E freely generated by e, F spanned by b_1 e_1, ..., b_n e_n: the
;;;      coordinates kappa(x) of x (the inverse of c |-> sum c_i e_i, a bijection) and
;;;      phi(x) = ([kappa(x)_1], ..., [kappa(x)_n]) in the direct sum of the Z/(b_i);
;;;      phi is a surjective homomorphism with kernel F, so E/F is isomorphic to the sum.
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z3-quotient and la-z3-dsum, and after la-z2-action
;;; (rel-free-lincomb-cancel).

(define (lzt-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z3-struct: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzt-split-all! f)
  (if (dk-head-is? f 'AND) (for-each lzt-split-all! (dk-split! f))))
(define (lzt-cite-all! thm . args)       ; cite and detach every antecedent, the guards by prop
  (let loop ((f (apply dk-cite! thm args)))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f)) (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lzt-skolem-split! ex)
  (let ((w (dk-skolem! ex)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    w))

;;; ---- a + -b = 0 => a = b in a module -----------------------------------------------
(sp (make-wff '(FORALL md (IMPLIES (IS-MODULE md) (FORALL a_ (IMPLIES (IN a_ (VEC md)) (FORALL b_ (IMPLIES (IN b_ (VEC md))
  (IMPLIES (= ((VADD md) a_ ((VNEG md) b_)) (VZERO md)) (= a_ b_))))))))))
(dk-peel!)
(fact 'module-vneg-type 'md 'b_)
(fact 'module-vneg-type 'md 'a_)
(let ((e (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'md 'a_ '((VNEG md) b_))))
  ;; e: -b = -a
  (fact 'lzq-neg-neg 'md 'b_)
  (fact 'lzq-neg-neg 'md 'a_)
  (dk-have! '(= ((VNEG md) ((VNEG md) b_)) ((VNEG md) ((VNEG md) a_)))
    (lambda () (subst e) (fact 'module-vneg-type 'md '((VNEG md) a_)) (rfl)))
  (subst '(= a_ ((VNEG md) ((VNEG md) a_))))
  (subst '(= ((VNEG md) ((VNEG md) a_)) ((VNEG md) ((VNEG md) b_))))
  (subst '(= ((VNEG md) ((VNEG md) b_)) b_))
  (rfl))
(lzt-done! 'lzt-eq-of-d-zero)

;;; =====================================================================
;;; (A) The first isomorphism theorem.
;;; =====================================================================
(define LZT-S '(QMOD-SETOID M sm))
(define LZT-Q '(QUOTIENT (QMOD-SETOID M sm)))
(define LZT-QM '(QUOTIENT-MODULE M sm))
(define LZT-PHI '(DESCEND (QMOD-SETOID M sm) phi))
(define (lzt-cl t) (list 'CLASS LZT-S t))
(define LZT-SURJ '(FORALL y_ (IMPLIES (IN y_ (VEC N)) (FORSOME x_ (AND (IN x_ (VEC M)) (= (phi x_) y_))))))
(define LZT-KER '(FORALL x_ (IMPLIES (IN x_ (VEC M)) (IFF (= (phi x_) (VZERO N)) (IN x_ sm)))))
(define LZT-ADD '(FORALL x1_ (IMPLIES (IN x1_ (VEC M)) (FORALL x2_ (IMPLIES (IN x2_ (VEC M))
                   (= (phi ((VADD M) x1_ x2_)) ((VADD N) (phi x1_) (phi x2_))))))))
(define LZT-NEG '(FORALL x1_ (IMPLIES (IN x1_ (VEC M)) (= (phi ((VNEG M) x1_)) ((VNEG N) (phi x1_))))))
(define LZT-ACT '(FORALL x1_ (IMPLIES (IN x1_ (CARR (SCAL M))) (FORALL x2_ (IMPLIES (IN x2_ (VEC M))
                   (= (phi ((ACT M) x1_ x2_)) ((ACT N) x1_ (phi x2_))))))))
(define (lzt-phi-typ! x)                ; (IN (phi x) (VEC N)) for x in VEC M
  (if (not (dk-asm? (list 'IN (list 'phi x) '(VEC N))))
      (fact 'fun-apply-type-c 'phi '(VEC M) '(VEC N) x)))
(define (lzt-vt! x)                     ; type a vector of M built from VADD, VNEG
  (let ((want (list 'IN x '(VEC M))))
    (cond ((dk-asm? want) #t)
          ((and (pair? x) (equal? (car x) '(VADD M))) (lzt-vt! (cadr x)) (lzt-vt! (caddr x)) (dk-cite! 'module-vadd-type 'M (cadr x) (caddr x)))
          ((and (pair? x) (equal? (car x) '(VNEG M))) (lzt-vt! (cadr x)) (dk-cite! 'module-vneg-type 'M (cadr x)))
          ((and (pair? x) (equal? (car x) '(ACT M))) (lzt-vt! (caddr x)) (dk-cite! 'module-act-type 'M (cadr x) (caddr x)))
          ((equal? x '(VZERO M)) (dk-cite! 'module-vzero-in 'M))
          (#t (error "lzt-vt!: cannot type" (expression->string x))))))
;; phi(a + -b) = phi(a) + -phi(b)
(define (lzt-phi-d! a b)
  (let* ((nb (list '(VNEG M) b))
         (d (list '(VADD M) a nb))
         (eq (list '= (list 'phi d) (list '(VADD N) (list 'phi a) (list '(VNEG N) (list 'phi b))))))
    (lzt-vt! d)
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (subst (dk-apply! LZT-ADD a nb))
            (subst (dk-apply! LZT-NEG b))
            (lzt-phi-typ! a) (lzt-phi-typ! b)
            (fact 'module-vneg-type 'N (list 'phi b))
            (fact 'module-vadd-type 'N (list 'phi a) (list '(VNEG N) (list 'phi b)))
            (rfl))))
    eq))
(define (lzt-quot-setup!)
  (fact 'qmod-setoid-is-setoid 'M 'sm)
  (fact 'qmod-setoid-pts 'M 'sm)
  (for-each (lambda (n) (fact n 'M 'sm)) '(qmod-ro-scal qmod-ro-vec qmod-ro-vadd qmod-ro-vzero qmod-ro-vneg qmod-ro-act)))
(define (lzt-pts! a)
  (if (not (dk-asm? (list 'IN a '(PTS (QMOD-SETOID M sm)))))
      (dk-have! (list 'IN a '(PTS (QMOD-SETOID M sm))) (lambda () (subst '(= (PTS (QMOD-SETOID M sm)) (VEC M))) (ass)))))
;; lift u in the quotient to a class [a], rewriting the GOAL; return a
(define (lzt-lift! u)
  (if (not (dk-asm? (list 'IN u LZT-Q)))
      (dk-have! (list 'IN u LZT-Q) (lambda () (subst (list '= LZT-Q (list 'VEC LZT-QM))) (ass))))
  (let* ((a (dk-skolem! (dk-cite! 'quotient-rep LZT-S u))))
    (dk-have! (list 'IN a '(VEC M)) (lambda () (subst '(= (VEC M) (PTS (QMOD-SETOID M sm)))) (ass)))
    (subst (list '= u (lzt-cl a)))
    a))
(define (lzt-phi-at! a)                 ; DESCEND(phi)([a]) = phi(a)
  (lzt-pts! a)
  (dk-cite! 'descend-computes LZT-S '(VEC N) 'phi a))

(sp (make-wff (forall-guarded '(M N phi sm) (list '(IS-HOM-MODULE M N phi) '(IS-SUBMODULE M sm) LZT-SURJ LZT-KER)
  (list 'IS-ISO-MODULE LZT-QM 'N LZT-PHI))))
(dk-peel!)
(lzt-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def 'M 'N 'phi)))
(lzt-quot-setup!)
(dk-have! '(IN phi (FUN (PTS (QMOD-SETOID M sm)) (VEC N)))
  (lambda () (subst '(= (PTS (QMOD-SETOID M sm)) (VEC M))) (ass)))
;; phi respects the congruence
(dk-have! (list 'RESPECTS LZT-S 'phi)
  (lambda ()
    (mac 'respects-unfold)
    (subst '(= (PTS (QMOD-SETOID M sm)) (VEC M)))
    (let* ((ld (dk-peel!))
           (rel (find-first (dk-head? 'RELATED) ld))
           (a (caddr rel)) (b (cadddr rel))
           (d (list '(VADD M) a (list '(VNEG M) b))))
      (fact 'qmod-related-out 'M 'sm a b)
      (lzt-vt! d)
      (let ((kz (dk-ctx-form (caddr (dk-apply! LZT-KER d)))))
        #t)
      (dk-meta-iff-l! (dk-ctx-form (list 'IFF (list '= (list 'phi d) '(VZERO N)) (list 'IN d 'sm))))
      (lzt-phi-d! a b)
      (lzt-phi-typ! a) (lzt-phi-typ! b)
      (dk-have! (list '= (list '(VADD N) (list 'phi a) (list '(VNEG N) (list 'phi b))) '(VZERO N))
        (lambda () (subst (list '= (list '(VADD N) (list 'phi a) (list '(VNEG N) (list 'phi b))) (list 'phi d))) (ass)))
      (dk-cite! 'lzt-eq-of-d-zero 'N (list 'phi a) (list 'phi b))
      (ass))))
(dk-have! (list 'AND '(IN phi (FUN (PTS (QMOD-SETOID M sm)) (VEC N))) (list 'RESPECTS LZT-S 'phi)))
(fact 'descend-in-fun LZT-S '(VEC N) 'phi)
(fact 'quotient-module-is-module 'M 'sm)
(mac 'IS-ISO-MODULE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IS-HOM-MODULE)
         (mac 'is-hom-module-def)
         (dk-conj-close!
           (lambda ()
             (let ((g2 (dk-goal)))
               (cond
                 ((dk-asm? g2) (ass))
                 ((dk-head-is? g2 'IN)        ; Phi in FUN(VEC QM, VEC N)
                  (subst (list '= (list 'VEC LZT-QM) LZT-Q)) (ass))
                 ((and (dk-head-is? g2 '=) (dk-head-is? (cadr g2) 'SCAL))
                  (subst (list '= (list 'SCAL LZT-QM) '(SCAL M))) (ass))
                 ((dk-head-is? g2 '=)         ; zero
                  (subst (list '= (list 'VZERO LZT-QM) (lzt-cl '(VZERO M))))
                  (fact 'module-vzero-in 'M)
                  (subst (lzt-phi-at! '(VZERO M)))
                  (ass))
                 (#t
                  (let* ((ld (dk-peel!))
                         (us (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC LZT-QM)))) ld)))
                         (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR (list 'SCAL LZT-QM))))) ld)))
                         (as (map lzt-lift! us)))
                    (for-each (lambda (r) (dk-have! (list 'IN r '(CARR (SCAL M))) (lambda () (subst (list '= '(SCAL M) (list 'SCAL LZT-QM))) (ass)))) rs)
                    (cond
                      ((= (length as) 2)   ; additive
                       (let ((a (car as)) (b (cadr as)))
                         (subst (dk-cite! 'qmod-vadd-computes 'M 'sm a b))
                         (lzt-vt! (list '(VADD M) a b))
                         (subst (lzt-phi-at! (list '(VADD M) a b)))
                         (subst (lzt-phi-at! a)) (subst (lzt-phi-at! b))
                         (dk-apply! LZT-ADD a b)
                         (ass)))
                      ((pair? rs)          ; action
                       (let ((a (car as)) (r (car rs)))
                         (subst (dk-cite! 'qmod-act-computes 'M 'sm r a))
                         (lzt-vt! (list '(ACT M) r a))
                         (subst (lzt-phi-at! (list '(ACT M) r a)))
                         (subst (lzt-phi-at! a))
                         (dk-apply! LZT-ACT r a)
                         (ass)))
                      (#t                  ; negation
                       (let ((a (car as)))
                         (subst (dk-cite! 'qmod-vneg-computes 'M 'sm a))
                         (lzt-vt! (list '(VNEG M) a))
                         (subst (lzt-phi-at! (list '(VNEG M) a)))
                         (subst (lzt-phi-at! a))
                         (dk-apply! LZT-NEG a)
                         (ass)))))))))))
        (#t                                 ; the bijection
         (subst (list '= (list 'VEC LZT-QM) LZT-Q))
         (let ((iff (dk-meta-iff! 'bijection-membership-iff LZT-Q '(VEC N) LZT-PHI)))
           (dk-have! (caddr iff)
             (lambda ()
               (dk-conj-close!
                 (lambda ()
                   (let ((g2 (dk-goal)))
                     (cond
                       ((dk-asm? g2) (ass))
                       ((dk-head-is? (caddr (caddr g2)) 'FORSOME)    ; onto
                        (let* ((ld (dk-peel!))
                               (w (cadr (car ld)))
                               (x (lzt-skolem-split! (dk-apply! LZT-SURJ w))))
                          (lzt-pts! x)
                          (fact 'class-in-quotient LZT-S x)
                          (ew (lzt-cl x))
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal)) (ass)
                                  (begin (subst (lzt-phi-at! x)) (ass)))))))
                       (#t                                            ; one-to-one
                        (let* ((ld (dk-peel!))
                               (us (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZT-Q))) ld)))
                               (a (lzt-lift! (car us)))
                               (b (lzt-lift! (cadr us)))
                               (h (find-first (dk-head? '=) (dk-asms))))
                          (lzt-phi-at! a) (lzt-phi-at! b)
                          (let* ((h1 (dk-rewrite-h! (dk-ctx-form (list '= (list LZT-PHI (car us)) (list LZT-PHI (cadr us)))) (car us) (lzt-cl a)))
                                 (h2 (dk-rewrite-h! h1 (cadr us) (lzt-cl b)))
                                 (h3 (dk-rewrite-h! h2 (list LZT-PHI (lzt-cl a)) (list 'phi a)))
                                 (h4 (dk-rewrite-h! h3 (list LZT-PHI (lzt-cl b)) (list 'phi b)))
                                 (d (list '(VADD M) a (list '(VNEG M) b))))
                            (lzt-phi-d! a b)
                            (lzt-phi-typ! a) (lzt-phi-typ! b)
                            (fact 'lzq-inv-r 'N (list 'phi b))
                            (dk-have! (list '= (list 'phi d) '(VZERO N))
                              (lambda ()
                                (subst (list '= (list 'phi d) (list '(VADD N) (list 'phi a) (list '(VNEG N) (list 'phi b)))))
                                (subst (list '= (list 'phi a) (list 'phi b)))
                                (ass)))
                            (dk-apply! LZT-KER d)
                            (dk-meta-iff-r! (dk-ctx-form (list 'IFF (list '= (list 'phi d) '(VZERO N)) (list 'IN d 'sm))))
                            (let ((iff2 (dk-cite! 'qmod-class-eq-iff 'M 'sm a b)))
                              (dk-meta-iff-l! iff2)
                              (ass)))))))))))
           (dk-meta-iff-l! iff)
           (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))
(lzt-done! 'first-isomorphism-module)
(gloss! 'first-isomorphism-module "A surjective module homomorphism phi : M -> N whose kernel is the submodule F induces an isomorphism of M/F onto N.")

;;; =====================================================================
;;; (B) 3.49.
;;; =====================================================================
;;; ---- a member of a class is a representative of it -------------------------------------
(sp (make-wff '(FORALL s (IMPLIES (IS-SETOID s) (FORALL cq_ (IMPLIES (IN cq_ (QUOTIENT s)) (FORALL a (IMPLIES (IN a cq_)
  (AND (IN a (PTS s)) (= (CLASS s a) cq_))))))))))
(dk-peel!)
(let* ((a0 (lzt-skolem-split! (dk-cite! 'quotient-rep 's 'cq_)))
       (h (dk-rewrite-h! '(IN a cq_) 'cq_ (list 'CLASS 's a0)))
       (cu (dk-cite! 'class-unfold 's a0))
       (h2 (dk-rewrite-h! h (list 'CLASS 's a0) (list 'SEP 'b_ '(PTS s) (list 'RELATED 's a0 'b_)))))
  (dk-landed (lambda () (sep-me h2)))
  (dk-cite! 'class-eq-iff 's a0 'a)
  (dk-meta-iff-l! (dk-ctx-form (list 'IFF (list '= (list 'CLASS 's a0) '(CLASS s a)) (list 'RELATED 's a0 'a))))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (begin (subst (list '= 'cq_ (list 'CLASS 's a0)))
                 (fact 'class-is-set 's a0)
                 (fact 'class-is-set 's 'a)
                 (if (dk-asm? (dk-goal)) (ass)
                     (begin (subst (list '= (list 'CLASS 's a0) '(CLASS s a))) (rfl))))))))
(lzt-done! 'class-of-member)
(gloss! 'class-of-member "A member of an equivalence class is a representative of it.")

(sp (make-wff '(FORALL s (IMPLIES (IS-SETOID s) (FORALL cq_ (IMPLIES (IN cq_ (QUOTIENT s)) (IN (CHOICE cq_) cq_)))))))
(dk-peel!)
(let ((a0 (lzt-skolem-split! (dk-cite! 'quotient-rep 's 'cq_))))
  (fact 'class-self 's a0)
  (dk-have! (list 'IN a0 'cq_) (lambda () (subst (list '= 'cq_ (list 'CLASS 's a0))) (ass)))
  (dk-have! '(FORSOME x (IN x cq_)) (lambda () (ew a0) (ass)))
  (fact 'choice-axiom 'cq_)
  (ass))
(lzt-done! 'quotient-member-choice)
(gloss! 'quotient-member-choice "An equivalence class is nonempty: CHOICE picks a member of it.")

;;; ---- the coordinates of a free generating sequence --------------------------------------
(define LZT-ROWS '(MAT 1 n (CARR (SCAL md))))
(define LZT-LC '(VNB-LAMBDA lcc_ (MAT 1 n (CARR (SCAL md))) (LINCOMB md n lcc_ es)))
(define LZT-KAP (list 'INVERSE-BIJ LZT-LC LZT-ROWS '(VEC md)))
(define (lzt-kp x) (list LZT-KAP x))
(define LZT-CHYPS '((IS-MODULE md) (IN n NN) (IN es (MAT n 1 (VEC md))) (GENERATES md n es) (REL-FREE md n es)))
(define (lzt-cstmt vars guards body) (forall-guarded (append '(md n es) vars) (append LZT-CHYPS guards) body))
(define (lzt-csetup!)
  (fact 'one-in-interval-1)
  (fact 'module-scalar-ring 'md)
  (fact 'ring-carr-in-set '(SCAL md)))

(define (lzt-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (lzt-lc-fun!)
  (dk-lam-type!
    (lambda ()
      (let* ((ld (dk-peel!)) (c (cadr (car ld))))
        (lzt-beta!)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin (fact 'lincomb-type 'md 'n c 'es) (ass)))))
    (lambda () (ass))))
(define (lzt-lc-onto!)
  (let* ((ld (dk-peel!))
         (w (cadr (car ld)))
         (gen (dk-meta-iff-r! (dk-meta-iff! 'generates 'md 'n 'es)))
         (c (lzt-skolem-split! (dk-apply! gen w))))
    (ew c)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin
              (lzt-beta!)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (begin
                    (subst (list '= w (list 'LINCOMB 'md 'n c 'es)))
                    (fact 'lincomb-type 'md 'n c 'es)
                    (rfl)))))))))
(define (lzt-lc-one!)
  (let* ((ld (dk-peel!))
         (ab (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZT-ROWS))) ld)))
         (a (car ab)) (b (cadr ab))
         (h (find-first (dk-head? '=) ld)))
    (dk-lam-b-h! h)
    (let ((jall (dk-cite! 'rel-free-lincomb-cancel 'md 'n a b 'es)))
      (detach-with! (dk-cite! 'matrix-entry-extensionality 1 'n '(CARR (SCAL md)) a b)
        (lambda () (lzt-lc-entry! jall)))
      (ass))))
(define (lzt-lc-entry! jall)
  (let* ((ld2 (dk-peel!))
         (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld2)))
         (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld2))))
    (fact 'interval-elt-in-nn 1 1 i)
    (fact 'interval-lo 1 1 i)
    (fact 'interval-hi 1 1 i)
    (dk-have! '(IN 1 NN) (lambda () (arith)))
    (dk-cite! 'nn-le-antisym i 1)
    (subst (list '= i 1))
    (dk-apply! jall j)
    (ass)))
(define (lzt-lc-conj!)
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'IN) (lzt-lc-fun!))
          ((dk-head-is? (caddr (caddr g)) 'FORSOME) (lzt-lc-onto!))
          (#t (lzt-lc-one!)))))
(sp (make-wff (lzt-cstmt '() '() (list 'IN LZT-LC (list 'BIJECTION LZT-ROWS '(VEC md))))))
(dk-peel!)
(lzt-csetup!)
(fact 'mat-is-set '(CARR (SCAL md)) 1 'n)
(let ((iff (dk-meta-iff! 'bijection-membership-iff LZT-ROWS '(VEC md) LZT-LC)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! lzt-lc-conj!)))
  (dk-meta-iff-l! iff)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(lzt-done! 'lzt-lc-bijection)

(define (lzt-kap-setup!)
  (fact 'lzt-lc-bijection 'md 'n 'es)
  (fact 'inverse-bij-in-fun LZT-ROWS '(VEC md) LZT-LC))
(sp (make-wff (lzt-cstmt '(x_) '((IN x_ (VEC md)))
  (list 'AND (list 'IN (lzt-kp 'x_) LZT-ROWS) (list '= (list 'LINCOMB 'md 'n (lzt-kp 'x_) 'es) 'x_)))))
(dk-peel!)
(lzt-csetup!)
(lzt-kap-setup!)
(fact 'fun-apply-type-c LZT-KAP '(VEC md) LZT-ROWS 'x_)
(let ((e (dk-cite! 'inverse-bij-right LZT-ROWS '(VEC md) LZT-LC 'x_)))
  (dk-lam-b-h! e))
(dk-conj-close! (lambda () (ass)))
(lzt-done! 'coord-lincomb)

(sp (make-wff (lzt-cstmt '(c_) (list (list 'IN 'c_ LZT-ROWS))
  (list '= (lzt-kp '(LINCOMB md n c_ es)) 'c_))))
(dk-peel!)
(lzt-csetup!)
(lzt-kap-setup!)
(let ((e (dk-cite! 'inverse-bij-left LZT-ROWS '(VEC md) LZT-LC 'c_)))
  (dk-lam-b-h! e))
(ass)
(lzt-done! 'lincomb-coord)

;;; ---- the coordinates are additive and homogeneous ------------------------------------
(define LZT-SC '(SCAL md))
(define (lzt-ent c j) (list 'ENTRY c 1 j))
(define (lzt-coord! x)                  ; land (IN (KAP x) ROWS) and LINCOMB(KAP x) = x
  (if (not (dk-asm? (list 'IN (lzt-kp x) LZT-ROWS)))
      (let ((c (dk-cite! 'coord-lincomb 'md 'n 'es x)))
        (if (dk-head-is? c 'AND) (dk-split! c)))))
(define (lzt-row-entry! c j)            ; (IN (ENTRY c 1 j) (CARR (SCAL md))) for c in ROWS
  (fact 'one-in-interval-1)
  (fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) c 1 j))
;; KAP(x) = c from LINCOMB(c) = x (c in ROWS)
(define (lzt-kap-is! x c lc-eq)
  (let ((e (dk-cite! 'lincomb-coord 'md 'n 'es c)))
    (dk-rewrite-h! e (list 'LINCOMB 'md 'n c 'es) x)))
(sp (make-wff (lzt-cstmt '(x_ y_ j_) '((IN x_ (VEC md)) (IN y_ (VEC md)) (IN j_ (INTERVAL 1 n)))
  (list '= (lzt-ent (lzt-kp '((VADD md) x_ y_)) 'j_)
           (list '(ADD (SCAL md)) (lzt-ent (lzt-kp 'x_) 'j_) (lzt-ent (lzt-kp 'y_) 'j_))))))
(dk-peel!)
(lzt-csetup!)
(lzt-coord! 'x_) (lzt-coord! 'y_)
(let* ((kx (lzt-kp 'x_)) (ky (lzt-kp 'y_))
       (sm2 (list 'MATADD LZT-SC kx ky))
       (xy '((VADD md) x_ y_)))
  (fact 'matadd-type LZT-SC 1 'n kx ky)
  (fact 'module-vadd-type 'md 'x_ 'y_)
  (let* ((e1 (dk-cite! 'lincomb-row-add 'md 'n kx ky 'es))
         (e2 (dk-have! (list '= (list 'LINCOMB 'md 'n sm2 'es) xy)
               (lambda ()
                 (subst e1)
                 (subst (list '= (list 'LINCOMB 'md 'n kx 'es) 'x_))
                 (subst (list '= (list 'LINCOMB 'md 'n ky 'es) 'y_))
                 (rfl))))
         (e3 (lzt-kap-is! xy sm2 e2)))
    (subst (list '= (lzt-kp xy) sm2))
    (subst (dk-cite! 'matadd-entry LZT-SC 1 'n kx ky 1 'j_))
    (lzt-row-entry! kx 'j_) (lzt-row-entry! ky 'j_)
    (fact 'ring-add-closed LZT-SC (lzt-ent kx 'j_) (lzt-ent ky 'j_))
    (rfl)))
(lzt-done! 'coord-vadd)

(sp (make-wff (lzt-cstmt '(r_ x_ j_) '((IN r_ (CARR (SCAL md))) (IN x_ (VEC md)) (IN j_ (INTERVAL 1 n)))
  (list '= (lzt-ent (lzt-kp '((ACT md) r_ x_)) 'j_)
           (list '(MUL (SCAL md)) 'r_ (lzt-ent (lzt-kp 'x_) 'j_))))))
(dk-peel!)
(lzt-csetup!)
(lzt-coord! 'x_)
(let* ((kx (lzt-kp 'x_))
       (sm2 (list 'MATSCALE LZT-SC 'r_ kx))
       (rx '((ACT md) r_ x_)))
  (fact 'matscale-type LZT-SC 1 'n 'r_ kx)
  (fact 'module-act-type 'md 'r_ 'x_)
  (let* ((e1 (dk-cite! 'lincomb-row-scale 'md 'n 'r_ kx 'es))
         (e2 (dk-have! (list '= (list 'LINCOMB 'md 'n sm2 'es) rx)
               (lambda ()
                 (subst e1)
                 (subst (list '= (list 'LINCOMB 'md 'n kx 'es) 'x_))
                 (rfl))))
         (e3 (lzt-kap-is! rx sm2 e2)))
    (subst (list '= (lzt-kp rx) sm2))
    (subst (dk-cite! 'matscale-entry LZT-SC 1 'n 'r_ kx 1 'j_))
    (lzt-row-entry! kx 'j_)
    (fact 'ring-carrier-closed-mul LZT-SC 'r_ (lzt-ent kx 'j_))
    (rfl)))
(lzt-done! 'coord-act)

(sp (make-wff (lzt-cstmt '(j_) '((IN j_ (INTERVAL 1 n)))
  (list '= (lzt-ent (lzt-kp '(VZERO md)) 'j_) '(ZERO (SCAL md))))))
(dk-peel!)
(lzt-csetup!)
(let* ((z (list 'ZEROMAT LZT-SC 1 'n)))
  (fact 'nn-one-in)
  (fact 'zeromat-type LZT-SC 1 'n)
  (fact 'module-vzero-in 'md)
  (let* ((e1 (dk-cite! 'lincomb-zerorow 'md 'n 'es))
         (e3 (lzt-kap-is! '(VZERO md) z e1)))
    (subst (list '= (lzt-kp '(VZERO md)) z))
    (subst (dk-cite! 'entry-of-zeromat LZT-SC 1 'n 1 'j_))
    (fact 'ring-zero-in LZT-SC)
    (rfl)))
(lzt-done! 'coord-vzero)

(sp (make-wff (lzt-cstmt '(x_ j_) '((IN x_ (VEC md)) (IN j_ (INTERVAL 1 n)))
  (list '= (lzt-ent (lzt-kp '((VNEG md) x_)) 'j_) (list '(NEG (SCAL md)) (lzt-ent (lzt-kp 'x_) 'j_))))))
(dk-peel!)
(lzt-csetup!)
(lzt-coord! 'x_)
(let* ((m1 '((NEG (SCAL md)) (ONE (SCAL md))))
       (kx (lzt-kp 'x_)))
  (fact 'ring-one-in LZT-SC)
  (fact 'ring-neg-in-carr LZT-SC '(ONE (SCAL md)))
  (let ((e (dk-cite! 'module-act-neg-one 'md 'x_)))
    (subst (list '= '((VNEG md) x_) (list '(ACT md) m1 'x_)))
    (subst (dk-cite! 'coord-act 'md 'n 'es m1 'x_ 'j_))
    (lzt-row-entry! kx 'j_)
    (subst (dk-cite! 'ring-neg-mul-left LZT-SC '(ONE (SCAL md)) (lzt-ent kx 'j_)))
    (subst (dk-cite! 'ring-mul-left-id LZT-SC (lzt-ent kx 'j_)))
    (fact 'ring-neg-in-carr LZT-SC (lzt-ent kx 'j_))
    (rfl)))
(lzt-done! 'coord-vneg)

;;; =====================================================================
;;; 3.49: the setting, the target and the map.
;;; =====================================================================
(define LZT-ZM '(RING-AS-MODULE ZZ-RING))
(define (lzt-d j) (list 'ENTRY 'dm j j))
(define (lzt-zs j) (list 'QMOD-SETOID LZT-ZM (list 'PRINCIPAL-IDEAL 'ZZ-RING (lzt-d j))))
(define (lzt-zc j t) (list 'CLASS (lzt-zs j) t))
(define LZT-FAM '(VNB-LAMBDA fmi_ (INTERVAL 1 n) (ZZ-MOD (ENTRY dm fmi_ fmi_))))
(define LZT-T (list 'DIRECT-SUM 'ZZ-RING 'n LZT-FAM))
(define LZT-PH (list 'VNB-LAMBDA 'phx_ '(VEC md)
                 (list 'VNB-LAMBDA 'phj_ '(INTERVAL 1 n) (lzt-zc 'phj_ (lzt-ent (lzt-kp 'phx_) 'phj_)))))
(define LZT-HHYPS
  (append LZT-CHYPS
          '((= (SCAL md) ZZ-RING) (IN dm (MAT n n ZZ)) (IS-DIAGONAL ZZ-RING n n dm)
            (IS-SUBMODULE md sm) (SPANS md n (MATACT md dm es) sm))))
(define (lzt-hstmt vars guards body)
  (forall-guarded (append '(md n es dm sm) vars) (append LZT-HHYPS guards) body))
(define (lzt-hsetup!)
  (lzt-csetup!)
  (fact 'zz-is-commutative-ring)
  (fact 'zz-is-ring)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
;; land the facts about index j: d_j in ZZ and in CARR ZZ-RING, (FAM j) == ZZ-MOD(d_j)
(define (lzt-idx! j)
  (if (not (dk-asm? (list 'IN (lzt-d j) 'ZZ)))
      (begin
        (fact 'entry-in-carrier 'n 'n 'ZZ 'dm j j)
        (dk-rewrite-h! (list 'IN (lzt-d j) 'ZZ) 'ZZ '(CARR ZZ-RING))))
  (let ((e (list '== (list LZT-FAM j) (list 'ZZ-MOD (lzt-d j)))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))
    e))
(define (lzt-fam! j)
  (if (dk--occurs? (list LZT-FAM j) (dk-goal)) (subst (list '= (list LZT-FAM j) (list 'ZZ-MOD (lzt-d j))))))
;; the coordinate x_j as an integer: (IN (ENTRY (KAP x) 1 j) (CARR ZZ-RING))
(define (lzt-kz! x j)
  (let ((want (list 'IN (lzt-ent (lzt-kp x) j) '(CARR ZZ-RING))))
    (if (not (dk-asm? want))
        (begin
          (lzt-coord! x)
          (lzt-row-entry! (lzt-kp x) j)
          (dk-have! want (lambda () (subst '(= ZZ-RING (SCAL md))) (ass)))))))

(define LZT-HM (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IS-MODULE (list LZT-FAM 'i_)))))
(define LZT-HS (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list 'SCAL (list LZT-FAM 'i_)) 'ZZ-RING))))
(sp (make-wff (lzt-hstmt '() '() (list 'AND LZT-HM LZT-HS))))
(dk-peel!)
(lzt-hsetup!)
(dk-conj-close!
  (lambda ()
    (let* ((ld (dk-peel!)) (i (cadr (car ld))))
      (lzt-idx! i)
      (lzt-fam! i)
      (if (dk-head-is? (dk-goal) 'IS-MODULE)
          (begin (fact 'zz-mod-is-module (lzt-d i)) (ass))
          (begin (subst (dk-cite! 'zz-mod-scal (lzt-d i))) (rfl))))))
(lzt-done! 'lzt-fam-modules)

(define (lzt-tsetup!)                   ; the direct sum: its hypotheses and read-offs in context
  (lzt-hsetup!)
  (dk-split! (dk-cite! 'lzt-fam-modules 'md 'n 'es 'dm 'sm))
  (fact 'direct-sum-is-module 'ZZ-RING 'n LZT-FAM)
  (for-each (lambda (nm) (fact nm 'ZZ-RING 'n LZT-FAM))
            '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act)))

;;; phi(x) is a vector of the sum, and phi(x)_j = [x_j]
(define (lzt-phx x) (list LZT-PH x))
(define (lzt-inner x) (list 'VNB-LAMBDA 'phj_ '(INTERVAL 1 n) (lzt-zc 'phj_ (lzt-ent (lzt-kp x) 'phj_))))
(sp (make-wff (lzt-hstmt '(x_ j_) '((IN x_ (VEC md)) (IN j_ (INTERVAL 1 n)))
  (list '= (list (lzt-phx 'x_) 'j_) (lzt-zc 'j_ (lzt-ent (lzt-kp 'x_) 'j_))))))
(dk-peel!)
(lzt-hsetup!)
(lzt-idx! 'j_)
(lzt-kz! 'x_ 'j_)
(dk-lam-b!)
(if (not (sequent-node-grounded? (proof-state-focus *ps*)))
    (begin (fact 'zz-mod-class-in (lzt-d 'j_) (lzt-ent (lzt-kp 'x_) 'j_))
           (rfl)))
(lzt-done! 'lzt-ph-at)

(define LZT-TV (list 'VEC LZT-T))
(define LZT-TDV (list 'DSUM-VEC 'n LZT-FAM))
(sp (make-wff (lzt-hstmt '() '() (list 'IN LZT-PH (list 'FUN '(VEC md) LZT-TV)))))
(dk-peel!)
(lzt-tsetup!)
(fact 'lzq-vec-set 'md)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!)) (x (cadr (car ld))) (inner (cadr (dk-goal))))
      (dk-have! (list 'IN inner '(FUN (INTERVAL 1 n) SET))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let* ((ld2 (dk-peel!)) (j (cadr (car ld2))))
                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                    (begin
                      (lzt-idx! j) (lzt-kz! x j)
                      (fact 'zz-mod-class-in (lzt-d j) (lzt-ent (lzt-kp x) j))
                      (fact 'membership-implies-sethood (lzt-zc j (lzt-ent (lzt-kp x) j)) (list 'VEC (list 'ZZ-MOD (lzt-d j))))
                      (ass)))))
            (lambda () (fact 'interval-in-set 1 'n) (ass)))))
      (lzt-split-all! (dk-meta-iff-r! (dk-meta-iff! 'fun-codomain-iff '(INTERVAL 1 n) 'SET inner)))
      (dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list 'IN (list inner 'dsj_) (list 'VEC (list LZT-FAM 'dsj_)))))
        (lambda ()
          (let* ((ld2 (dk-peel!)) (j (cadr (car ld2))))
            (dk-lam-b!)
            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                (begin
                  (lzt-idx! j) (lzt-kz! x j)
                  (lzt-fam! j)
                  (fact 'zz-mod-class-in (lzt-d j) (lzt-ent (lzt-kp x) j))
                  (ass))))))
      (fact 'dsum-member-intro 'ZZ-RING 'n LZT-FAM inner)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
  (lambda () (ass)))
(lzt-done! 'lzt-ph-fun)

;;; ---- phi is a homomorphism ------------------------------------------------------------
(define (lzt-ph-in! x)                  ; (IN (PH x) (VEC T)) and (IN (PH x) (DSUM-VEC n FAM))
  (if (not (dk-asm? (list 'IN (lzt-phx x) LZT-TV)))
      (fact 'fun-apply-type-c LZT-PH '(VEC md) LZT-TV x))
  (lzt-tdv! (lzt-phx x)))
(define (lzt-tdv! t)                    ; from (IN t (VEC T)) land (IN t (DSUM-VEC n FAM)), and back
  (cond ((and (dk-asm? (list 'IN t LZT-TV)) (not (dk-asm? (list 'IN t LZT-TDV))))
         (dk-have! (list 'IN t LZT-TDV) (lambda () (subst (list '= LZT-TDV LZT-TV)) (ass))))
        ((and (dk-asm? (list 'IN t LZT-TDV)) (not (dk-asm? (list 'IN t LZT-TV))))
         (dk-have! (list 'IN t LZT-TV) (lambda () (subst (list '= LZT-TV LZT-TDV)) (ass))))))
(define (lzt-ring-eq! f)                ; (= (f (SCAL md)) (f ZZ-RING)) for an accessor f
  (let ((e (list '= (list f LZT-SC) (list f 'ZZ-RING))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (subst (list '= LZT-SC 'ZZ-RING))
                      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(define (lzt-ext! lhs rhs pointwise)    ; (= lhs rhs) in the sum, both typed, by components
  (let ((pt (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list '= (list lhs 'dsj_) (list rhs 'dsj_))))))
    (dk-have! pt (lambda () (let* ((ld (dk-peel!)) (j (cadr (car ld)))) (pointwise j))))
    (fact 'dsum-ext 'ZZ-RING 'n LZT-FAM lhs rhs)
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
(define (lzt-class-close! j t)          ; goal (= [t]_j [t]_j) after rewriting
  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
      (begin
        (lzt-idx! j)
        (fact 'zz-mod-class-in (lzt-d j) t)
        (rfl))))
(define (lzt-hom-add! x y)
  (let* ((xy (list '(VADD md) x y)) (lhs (lzt-phx xy))
         (rhs (list (list 'VADD LZT-T) (lzt-phx x) (lzt-phx y))))
    (fact 'module-vadd-type 'md x y)
    (lzt-ph-in! x) (lzt-ph-in! y) (lzt-ph-in! xy)
    (dk-cite! 'dsum-vadd-closed 'ZZ-RING 'n LZT-FAM (lzt-phx x) (lzt-phx y))
    (lzt-tdv! rhs)
    (lzt-ext! lhs rhs
      (lambda (j)
        (lzt-idx! j) (lzt-kz! x j) (lzt-kz! y j) (lzt-kz! xy j)
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm xy j))
        (subst (dk-cite! 'coord-vadd 'md 'n 'es x y j))
        (subst (lzt-ring-eq! 'ADD))
        (subst (dk-cite! 'dsum-vadd-at 'ZZ-RING 'n LZT-FAM (lzt-phx x) (lzt-phx y) j))
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j))
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm y j))
        (lzt-fam! j)
        (let ((a (lzt-ent (lzt-kp x) j)) (b (lzt-ent (lzt-kp y) j)))
          (subst (dk-cite! 'zz-mod-vadd-computes (lzt-d j) a b))
          (fact 'ring-add-closed 'ZZ-RING a b)
          (lzt-class-close! j (list '(ADD ZZ-RING) a b)))))))
(define (lzt-hom-neg! x)
  (let* ((nx (list '(VNEG md) x)) (lhs (lzt-phx nx))
         (rhs (list (list 'VNEG LZT-T) (lzt-phx x))))
    (fact 'module-vneg-type 'md x)
    (lzt-ph-in! x) (lzt-ph-in! nx)
    (dk-cite! 'dsum-vneg-closed 'ZZ-RING 'n LZT-FAM (lzt-phx x))
    (lzt-tdv! rhs)
    (lzt-ext! lhs rhs
      (lambda (j)
        (lzt-idx! j) (lzt-kz! x j) (lzt-kz! nx j)
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm nx j))
        (subst (dk-cite! 'coord-vneg 'md 'n 'es x j))
        (subst (lzt-ring-eq! 'NEG))
        (subst (dk-cite! 'dsum-vneg-at 'ZZ-RING 'n LZT-FAM (lzt-phx x) j))
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j))
        (lzt-fam! j)
        (let ((a (lzt-ent (lzt-kp x) j)))
          (subst (dk-cite! 'zz-mod-vneg-computes (lzt-d j) a))
          (fact 'ring-neg-in-carr 'ZZ-RING a)
          (lzt-class-close! j (list '(NEG ZZ-RING) a)))))))
(define (lzt-hom-act! r x)
  (let* ((rx (list '(ACT md) r x)) (lhs (lzt-phx rx))
         (rhs (list (list 'ACT LZT-T) r (lzt-phx x))))
    (fact 'module-act-type 'md r x)
    (dk-have! (list 'IN r '(CARR ZZ-RING)) (lambda () (subst (list '= 'ZZ-RING LZT-SC)) (ass)))
    (lzt-ph-in! x) (lzt-ph-in! rx)
    (dk-cite! 'dsum-act-closed 'ZZ-RING 'n LZT-FAM r (lzt-phx x))
    (lzt-tdv! rhs)
    (lzt-ext! lhs rhs
      (lambda (j)
        (lzt-idx! j) (lzt-kz! x j) (lzt-kz! rx j)
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm rx j))
        (subst (dk-cite! 'coord-act 'md 'n 'es r x j))
        (subst (lzt-ring-eq! 'MUL))
        (subst (dk-cite! 'dsum-act-at 'ZZ-RING 'n LZT-FAM r (lzt-phx x) j))
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j))
        (lzt-fam! j)
        (let ((a (lzt-ent (lzt-kp x) j)))
          (subst (dk-cite! 'zz-mod-act-computes (lzt-d j) r a))
          (fact 'ring-carrier-closed-mul 'ZZ-RING r a)
          (lzt-class-close! j (list '(MUL ZZ-RING) r a)))))))
(define (lzt-hom-zero!)
  (let* ((z '(VZERO md)) (lhs (lzt-phx z)) (rhs (list 'VZERO LZT-T)))
    (fact 'module-vzero-in 'md)
    (lzt-ph-in! z)
    (fact 'dsum-vzero-closed 'ZZ-RING 'n LZT-FAM)
    (lzt-tdv! rhs)
    (lzt-ext! lhs rhs
      (lambda (j)
        (lzt-idx! j) (lzt-kz! z j)
        (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm z j))
        (subst (dk-cite! 'coord-vzero 'md 'n 'es j))
        (subst (lzt-ring-eq! 'ZERO))
        (subst (dk-cite! 'dsum-vzero-at 'ZZ-RING 'n LZT-FAM j))
        (lzt-fam! j)
        (subst (dk-cite! 'zz-mod-vzero (lzt-d j)))
        (fact 'ring-zero-in 'ZZ-RING)
        (lzt-class-close! j '(ZERO ZZ-RING))))))

(sp (make-wff (lzt-hstmt '() '() (list 'IS-HOM-MODULE 'md LZT-T LZT-PH))))
(dk-peel!)
(lzt-tsetup!)
(fact 'lzt-ph-fun 'md 'n 'es 'dm 'sm)
(mac 'is-hom-module-def)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'SCAL))
         (subst (list '= (list 'SCAL LZT-T) 'ZZ-RING)) (ass))
        ((dk-head-is? g '=) (lzt-hom-zero!))
        (#t
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC md)))) ld)))
                (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL md))))) ld))))
           (cond ((pair? rs) (lzt-hom-act! (car rs) (car vs)))
                 ((= (length vs) 2) (lzt-hom-add! (car vs) (cadr vs)))
                 (#t (lzt-hom-neg! (car vs))))))))))
(lzt-done! 'lzt-ph-hom)

;;; ---- three bricks for the kernel -------------------------------------------------------
(define (lzt-sub-open!)
  (if (not (dk-asm? LZT-ACTCL))
      (lzt-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-submodule 'md 'sm)))))
(define LZT-ACTCL '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL md))) (FORALL x_ (IMPLIES (IN x_ sm) (IN ((ACT md) r_ x_) sm))))))
;;; a combination of members of a submodule lies in it
(define LZT-LCS '(VNB-LAMBDA j (INTERVAL 1 n) ((ACT md) (ENTRY c 1 j) (ENTRY ws j 1))))
(sp (make-wff (forall-guarded '(md sm n c ws)
  '((IS-MODULE md) (IS-SUBMODULE md sm) (IN n NN) (IN c (MAT 1 n (CARR (SCAL md)))) (IN ws (MAT n 1 (VEC md)))
    (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (IN (ENTRY ws j_ 1) sm))))
  '(IN (LINCOMB md n c ws) sm))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'one-in-interval-1)
(fact 'interval-in-set 1 'n)
(fact 'nn-one-in)
(fact 'interval-card-in-nn 1 'n)
(fact 'mvag-carr 'md)
(mac 'lincomb-unfold)
(dk-have! (list 'IN LZT-LCS '(FUN (INTERVAL 1 n) (CARR (MODULE-VECTOR-AG md))))
  (lambda ()
    (subst '(= (CARR (MODULE-VECTOR-AG md)) (VEC md)))
    (dk-lam-type!
      (lambda ()
        (let* ((ld (dk-peel!)) (j (cadr (car ld))))
          (if (dk--redex? (dk-goal)) (dk-lam-b!))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (begin
                (fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
                (fact 'entry-in-carrier 'n 1 '(VEC md) 'ws j 1)
                (fact 'module-act-type 'md (list 'ENTRY 'c 1 j) (list 'ENTRY 'ws j 1))
                (ass)))))
      (lambda () (ass)))))
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 n)) (list 'IN (list LZT-LCS 'z_) 'sm)))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (cadr (car ld))))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (begin
            (fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
            (dk-apply! '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (IN (ENTRY ws j_ 1) sm))) j)
            (lzt-sub-open!)
            (dk-apply! LZT-ACTCL (list 'ENTRY 'c 1 j) (list 'ENTRY 'ws j 1))
            (ass))))))
(fact 'submodule-finsum-closed 'md 'sm '(INTERVAL 1 n) LZT-LCS)
(ass)
(lzt-done! 'lincomb-in-submodule)
(gloss! 'lincomb-in-submodule "A linear combination of members of a submodule lies in the submodule.")

;;; LINCOMB(c, P . es) = LINCOMB(c P, es)
(define LZT-PES '(MATACT md pm es))
(define LZT-CP '(MATMUL (SCAL md) c pm))
(sp (make-wff (forall-guarded '(md n c pm es)
  '((IS-MODULE md) (IN n NN) (IN c (MAT 1 n (CARR (SCAL md)))) (IN pm (MAT n n (CARR (SCAL md)))) (IN es (MAT n 1 (VEC md))))
  (list '= (list 'LINCOMB 'md 'n 'c LZT-PES) (list 'LINCOMB 'md 'n LZT-CP 'es)))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(use-em '(<= 1 n)
  (lambda ()
    (dk-have-prop! '(IMPLIES (= n 0) (OR (= n 0) (= 1 0))))
    (dk-have! '(NOT (= n 0)) (lambda () (dk-nn! '(<= 1 n))))
    (dk-have-prop! '(IMPLIES (= n 0) (OR (= 1 0) (AND (= n 0) (= n 0)))))
    (dk-have-prop! '(IMPLIES (= n 0) (OR (= 1 0) (AND (= n 0) (= 1 0)))))
    (dk-have-prop! '(IMPLIES (= n 0) (OR (= 1 0) (= 1 0))))
    (fact 'nn-one-in)
    (fact 'one-in-interval-1)
    (lzt-cite-all! 'matact-type 'md 'n 'n 1 'pm 'es)
    (lzt-cite-all! 'matmul-type '(SCAL md) 1 'n 'n 'c 'pm)
    (let* ((e1 (lzt-cite-all! 'matact-lincomb 'md 'n 'c LZT-PES))
           (e2 (lzt-cite-all! 'matact-assoc 'md 1 'n 'n 1 'c 'pm 'es))
           (e3 (lzt-cite-all! 'matact-lincomb 'md 'n LZT-CP 'es)))
      (subst (list '= (list 'LINCOMB 'md 'n 'c LZT-PES) (list 'ENTRY (list 'MATACT 'md 'c LZT-PES) 1 1)))
      (subst (list '= (list 'MATACT 'md 'c LZT-PES) (list 'MATACT 'md LZT-CP 'es)))
      (subst e3)
      (fact 'lincomb-type 'md 'n LZT-CP 'es)
      (rfl)))
  (lambda ()
    (fact 'nn-not-le-succ-le 1 'n)
    (fact 'nn-zero-le 'n)
    (dk-have! '(IN 0 NN) (lambda () (arith)))
    (dk-have! '(<= n 0) (lambda () (dk-nn! '(<= (succ n) 1))))
    (dk-cite! 'nn-le-antisym 'n 0)
    (subst '(= n 0))
    (subst (dk-cite! 'lincomb-empty 'md 'c (dk--replace LZT-PES 'n 0)))
    (subst (dk-cite! 'lincomb-empty 'md (dk--replace LZT-CP 'n 0) 'es))
    (fact 'module-vzero-in 'md)
    (rfl)))
(lzt-done! 'lincomb-matact)
(gloss! 'lincomb-matact "The combination of P . es with the row c is the combination of es with the row c P.")

;;; the entries of c D for a diagonal D
(sp (make-wff (forall-guarded '(R n c dg j_)
  '((IS-RING R) (IN n NN) (IN c (MAT 1 n (CARR R))) (IN dg (MAT n n (CARR R))) (IS-DIAGONAL R n n dg) (IN j_ (INTERVAL 1 n)))
  '(= (ENTRY (MATMUL R c dg) 1 j_) ((MUL R) (ENTRY c 1 j_) (ENTRY dg j_ j_))))))
(dk-peel!)
(fact 'one-in-interval-1)
(dk-have! '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (IMPLIES (NOT (= i_ j_)) (= (ENTRY dg i_ j_) (ZERO R)))))
  (lambda ()
    (let* ((ld (dk-peel!)) (i (cadr (find-first (dk-head? 'IN) ld))))
      (dk-cite! 'diagonal-off-entry 'R 'n 'n 'dg i 'j_)
      (ass))))
(fact 'rb4-matmul-entry-single 'R 1 'n 'n 'c 'dg 1 'j_)
(ass)
(lzt-done! 'diagonal-right-entry)

;;; ---- the kernel of phi is F ---------------------------------------------------------
(define LZT-WS '(MATACT md dm es))
(define (lzt-dm-setup!)                 ; dm over CARR(SCAL md), diagonal over SCAL md
  (dk-rewrite-h! '(IN dm (MAT n n ZZ)) 'ZZ '(CARR ZZ-RING))
  (dk-rewrite-h! '(IN dm (MAT n n (CARR ZZ-RING))) 'ZZ-RING LZT-SC)
  (dk-rewrite-h! '(IS-DIAGONAL ZZ-RING n n dm) 'ZZ-RING LZT-SC))
(define LZT-ZT '(VZERO (DIRECT-SUM ZZ-RING n (VNB-LAMBDA fmi_ (INTERVAL 1 n) (ZZ-MOD (ENTRY dm fmi_ fmi_))))))
;; [t]_j = [0]_j from t = r d_j (r in CARR ZZ-RING)
(define (lzt-class-zero! j t r teq)     ; TEQ: (= t ((MUL ZZ-RING) r d_j)) in context
  (let* ((d (lzt-d j))
         (diff (list '(ADD ZZ-RING) t '((NEG ZZ-RING) (ZERO ZZ-RING))))
         (pi (list 'PRINCIPAL-IDEAL 'ZZ-RING d))
         (iff (begin (fact 'ring-zero-in 'ZZ-RING) (dk-cite! 'zz-mod-class-eq-iff d t '(ZERO ZZ-RING)))))
    (fact 'ring-neg-in-carr 'ZZ-RING '(ZERO ZZ-RING))
    (fact 'ring-add-closed 'ZZ-RING t '((NEG ZZ-RING) (ZERO ZZ-RING)))
    (let ((pim (dk-meta-iff! 'principal-ideal-membership 'ZZ-RING d diff)))
      (dk-have! (caddr pim)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORSOME)
                  (begin (ew r) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst teq) (crs))))))
                  (ass))))))
      (dk-meta-iff-l! pim))
    (dk-meta-iff-l! iff)))
;; from [t]_j = [0]_j: land t = r d_j and return r
(define (lzt-class-zero-out! j t)
  (let* ((d (lzt-d j))
         (diff (list '(ADD ZZ-RING) t '((NEG ZZ-RING) (ZERO ZZ-RING))))
         (iff (begin (fact 'ring-zero-in 'ZZ-RING) (dk-cite! 'zz-mod-class-eq-iff d t '(ZERO ZZ-RING)))))
    (dk-meta-iff-r! iff)
    (let* ((pim (dk-meta-iff! 'principal-ideal-membership 'ZZ-RING d diff))
           (rhs (dk-meta-iff-r! pim)))
      (lzt-split-all! (dk-ctx-form rhs))
      (let* ((r (lzt-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f diff))) (dk-asms))))
             (eq (list '= t (list '(MUL ZZ-RING) r d))))
        (dk-have! eq (lambda ()
                       (dk-have! (list '= diff t) (lambda () (crs)))
                       (subst (list '= t diff))
                       (ass)))
        r))))

(define (lzt-spans-open!)
  (lzt-split-all! (dk-meta-iff-r! (dk-meta-iff! 'spans 'md 'n LZT-WS 'sm))))
(define LZT-SP1 (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 n)) (list 'IN (list 'ENTRY LZT-WS 'j_ 1) 'sm))))
(define LZT-SP2 (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ sm)
                  (list 'FORSOME 'c_ (list 'AND '(IN c_ (MAT 1 n (CARR (SCAL md)))) (list '= 'x_ (list 'LINCOMB 'md 'n 'c_ LZT-WS)))))))
(define (lzt-vzt!)                      ; (VZERO T) typed in both forms
  (fact 'dsum-vzero-closed 'ZZ-RING 'n LZT-FAM)
  (lzt-tdv! (list 'VZERO LZT-T)))
;; [0]_j as the j-th component of (VZERO T): rewrite in the goal
(define (lzt-zero-at! j)
  (subst (dk-cite! 'dsum-vzero-at 'ZZ-RING 'n LZT-FAM j))
  (lzt-fam! j)
  (subst (dk-cite! 'zz-mod-vzero (lzt-d j))))
(define (lzt-zent c j)                  ; (IN (ENTRY c 1 j) (CARR ZZ-RING)) for c in ROWS
  (lzt-row-entry! c j)
  (let ((want (list 'IN (lzt-ent c j) '(CARR ZZ-RING))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (subst (list '= 'ZZ-RING LZT-SC)) (ass))))))

(define (lzt-ker-bwd! x)
  (let* ((c (lzt-skolem-split! (dk-apply! LZT-SP2 x)))
         (cdm (list 'MATMUL LZT-SC c 'dm)))
    (lzt-cite-all! 'matmul-type LZT-SC 1 'n 'n c 'dm)
    (let* ((e1 (dk-cite! 'lincomb-matact 'md 'n c 'dm 'es))
           (e2 (dk-have! (list '= (list 'LINCOMB 'md 'n cdm 'es) x)
                 (lambda ()
                   (subst (list '= (list 'LINCOMB 'md 'n cdm 'es) (list 'LINCOMB 'md 'n c LZT-WS)))
                   (subst (list '= (list 'LINCOMB 'md 'n c LZT-WS) x))
                   (rfl))))
           (e3 (dk-rewrite-h! (dk-cite! 'lincomb-coord 'md 'n 'es cdm) (list 'LINCOMB 'md 'n cdm 'es) x)))
      (lzt-ph-in! x)
      (lzt-vzt!)
      (lzt-ext! (lzt-phx x) (list 'VZERO LZT-T)
        (lambda (j)
          (lzt-idx! j) (lzt-kz! x j)
          (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j))
          (lzt-zero-at! j)
          (lzt-zent c j)
          (let* ((t (lzt-ent (lzt-kp x) j))
                 (cj (lzt-ent c j))
                 (teq (list '= t (list '(MUL ZZ-RING) cj (lzt-d j)))))
            (dk-have! teq
              (lambda ()
                (subst (list '= (lzt-kp x) cdm))
                (subst (dk-cite! 'diagonal-right-entry LZT-SC 'n c 'dm j))
                (subst (lzt-ring-eq! 'MUL))
                (fact 'ring-carrier-closed-mul 'ZZ-RING cj (lzt-d j))
                (rfl)))
            (lzt-class-zero! j t cj teq)
            (ass)))))))

(define (lzt-sepj x j)
  (list 'SEP 'yt_ '(CARR (SCAL md)) (list '= (lzt-ent (lzt-kp x) j) (list '(MUL (SCAL md)) 'yt_ (lzt-d j)))))
(define (lzt-exj x)
  (list 'FORALL 'yc_ (list 'IMPLIES '(IN yc_ (INTERVAL 1 n))
    (list 'FORSOME 'yt_ (list 'AND '(IN yt_ (CARR (SCAL md))) (list '= (lzt-ent (lzt-kp x) 'yc_) (list '(MUL (SCAL md)) 'yt_ (lzt-d 'yc_))))))))
(define (lzt-g x) (list 'VNB-LAMBDA '(LIST yr_ yc_) '(CARTESIAN (INTERVAL 1 1) (INTERVAL 1 n)) (list 'CHOICE (lzt-sepj x 'yc_))))
(define (lzt-ker-fwd! x)
  (let ((aeq (list '= (lzt-phx x) (list 'VZERO LZT-T))))
    (lzt-ph-in! x)
    (lzt-vzt!)
    ;; each coordinate is a multiple of d_j
    (dk-have! (lzt-exj x)
      (lambda ()
        (let* ((ld (dk-peel!)) (j (cadr (car ld))) (t (lzt-ent (lzt-kp x) j)))
          (lzt-idx! j) (lzt-kz! x j)
          (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j)
          (fact 'ring-zero-in 'ZZ-RING)
          (fact 'zz-mod-class-in (lzt-d j) '(ZERO ZZ-RING))
          (fact 'zz-mod-class-in (lzt-d j) t)
          (dk-have! (list '= (lzt-zc j t) (lzt-zc j '(ZERO ZZ-RING)))
            (lambda ()
              (subst (list '= (lzt-zc j t) (list (lzt-phx x) j)))
              (subst aeq)
              (lzt-zero-at! j)
              (rfl)))
          (let ((r (lzt-class-zero-out! j t)))
            (ew r)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (begin (subst (list '= LZT-SC 'ZZ-RING)) (ass))
                    (begin (subst (lzt-ring-eq! 'MUL)) (ass)))))))))
    ;; the row of quotients y, with y D = kappa(x)
    (let* ((g (lzt-g x)) (y (list 'MATOF 1 'n g))
           (gpt (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
                   (list 'AND (list 'IN (list g 'yi_ 'yj_) '(CARR (SCAL md)))
                              (list '= (lzt-ent (lzt-kp x) 'yj_) (list '(MUL (SCAL md)) (list g 'yi_ 'yj_) (lzt-d 'yj_))))))))))
      (dk-have! gpt
        (lambda ()
          (let* ((ld (dk-peel!))
                 (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
                 (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld)))
                 (sj (lzt-sepj x j))
                 (z (lzt-skolem-split! (dk-apply! (lzt-exj x) j))))
            (dk-have! (list '== (list g i j) (list 'CHOICE sj)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))
            (subst (list '= (list g i j) (list 'CHOICE sj)))
            (dk-have! (list 'IN z sj) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
            (dk-have! (list 'FORSOME 'cz_ (list 'IN 'cz_ sj)) (lambda () (ew z) (ass)))
            (fact 'choice-axiom sj)
            (dk-landed (lambda () (sep-me (list 'IN (list 'CHOICE sj) sj))))
            (dk-conj-close! (lambda () (ass))))))
      (lzt-ker-row! x g y gpt))))
(define (lzt-ker-row! x g y gpt)
  (let* ((cs '(CARR (SCAL md)))
         (ydm (list 'MATMUL LZT-SC y 'dm))
         (kx (lzt-kp x)))
    (dk-have! (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
                (list 'IN (list g 'yi_ 'yj_) cs)))))
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
               (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld))))
          (dk-split! (dk-apply! gpt i j))
          (ass))))
    (fact 'matof-in-mat 1 'n cs g)
    (dk-have! (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
                (list 'IN (list g 'yi_ 'yj_) 'SET)))))
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
               (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld))))
          (dk-split! (dk-apply! gpt i j))
          (fact 'membership-implies-sethood (list g i j) cs)
          (ass))))
    (lzt-cite-all! 'matmul-type LZT-SC 1 'n 'n y 'dm)
    (lzt-coord! x)
    (dk-have! (list '= ydm kx)
      (lambda ()
        (detach-with! (dk-cite! 'matrix-entry-extensionality 1 'n cs ydm kx)
          (lambda ()
            (let* ((ld (dk-peel!))
                   (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
                   (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld))))
              (fact 'interval-elt-in-nn 1 1 i) (fact 'interval-lo 1 1 i) (fact 'interval-hi 1 1 i)
              (dk-have! '(IN 1 NN) (lambda () (arith)))
              (dk-cite! 'nn-le-antisym i 1)
              (subst (list '= i 1))
              (subst (dk-cite! 'diagonal-right-entry LZT-SC 'n y 'dm j))
              (subst (dk-cite! 'entry-of-matof 1 'n g 1 j))
              (dk-split! (dk-apply! gpt 1 j))
              (subst (list '= (list '(MUL (SCAL md)) (list g 1 j) (lzt-d j)) (lzt-ent kx j)))
              (lzt-row-entry! kx j)
              (rfl))))
        (ass)))
    (let* ((e1 (dk-cite! 'lincomb-matact 'md 'n y 'dm 'es))
           (xe (list '= x (list 'LINCOMB 'md 'n y LZT-WS))))
      (lzt-cite-all! 'matact-type 'md 'n 'n 1 'dm 'es)
      (fact 'lincomb-type 'md 'n y LZT-WS)
      (dk-congr! (list '= ydm kx) (lambda (t) (list 'LINCOMB 'md 'n t 'es)))
      (dk-have! xe
        (lambda ()
          (subst (list '= (list 'LINCOMB 'md 'n y LZT-WS) (list 'LINCOMB 'md 'n ydm 'es)))
          (subst (list '= (list 'LINCOMB 'md 'n ydm 'es) (list 'LINCOMB 'md 'n kx 'es)))
          (subst (list '= (list 'LINCOMB 'md 'n kx 'es) x))
          (rfl)))
      (fact 'lincomb-in-submodule 'md 'sm 'n y LZT-WS)
      (subst xe)
      (ass))))

(sp (make-wff (lzt-hstmt '(x_) '((IN x_ (VEC md)))
  (list 'IFF (list '= (lzt-phx 'x_) (list 'VZERO LZT-T)) '(IN x_ sm)))))
(dk-peel!)
(lzt-tsetup!)
(lzt-dm-setup!)
(fact 'lzt-ph-fun 'md 'n 'es 'dm 'sm)
(lzt-spans-open!)
(lzt-cite-all! 'matact-type 'md 'n 'n 1 'dm 'es)
(lzt-coord! 'x_)
(let ((a (list '= (lzt-phx 'x_) (list 'VZERO LZT-T))) (b '(IN x_ sm)))
  (dk-have! (list 'IMPLIES b a) (lambda () (di) (lzt-ker-bwd! 'x_)))
  (dk-have! (list 'IMPLIES a b) (lambda () (di) (lzt-ker-fwd! 'x_)))
  (dk-only! (list 'IMPLIES b a) (list 'IMPLIES a b))
  (prop))
(lzt-done! 'lzt-ph-kernel)

;;; ---- phi is onto ----------------------------------------------------------------------
(define LZT-GW '(VNB-LAMBDA (LIST cr_ cc_) (CARTESIAN (INTERVAL 1 1) (INTERVAL 1 n)) (CHOICE (w_ cc_))))
(sp (make-wff (lzt-hstmt '(w_) (list (list 'IN 'w_ LZT-TV))
  (list 'FORSOME 'x_ (list 'AND '(IN x_ (VEC md)) (list '= (lzt-phx 'x_) 'w_))))))
(dk-peel!)
(lzt-tsetup!)
(fact 'lzt-ph-fun 'md 'n 'es 'dm 'sm)
(fact 'ring-as-module-is-module 'ZZ-RING)
(fact 'ram-ro-vec 'ZZ-RING)
(let* ((g LZT-GW) (c (list 'MATOF 1 'n g)) (cs '(CARR (SCAL md)))
       (gp (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
              (list 'AND (list 'IN (list g 'yi_ 'yj_) cs) (list '= (lzt-zc 'yj_ (list g 'yi_ 'yj_)) '(w_ yj_)))))))))
  (dk-have! gp
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
             (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld)))
             (wj (list 'w_ j)) (ch (list 'CHOICE wj)) (zs (lzt-zs j)))
        (lzt-idx! j)
        (let ((m (dk-cite! 'dsum-member-elim 'ZZ-RING 'n LZT-FAM 'w_ j)))
          (dk-lam-b-h! m))
        (fact 'zz-mod-vec (lzt-d j))
        (dk-rewrite-h! (list 'IN wj (list 'VEC (list 'ZZ-MOD (lzt-d j)))) (list 'VEC (list 'ZZ-MOD (lzt-d j))) (list 'QUOTIENT zs))
        (fact 'principal-ideal-is-submodule 'ZZ-RING (lzt-d j))
        (fact 'qmod-setoid-is-setoid LZT-ZM (list 'PRINCIPAL-IDEAL 'ZZ-RING (lzt-d j)))
        (fact 'qmod-setoid-pts LZT-ZM (list 'PRINCIPAL-IDEAL 'ZZ-RING (lzt-d j)))
        (fact 'quotient-member-choice zs wj)
        (dk-split! (dk-cite! 'class-of-member zs wj ch))
        (dk-have! (list 'IN ch cs)
          (lambda ()
            (subst (list '= LZT-SC 'ZZ-RING))
            (subst (list '= '(CARR ZZ-RING) (list 'VEC LZT-ZM)))
            (subst (list '= (list 'VEC LZT-ZM) (list 'PTS zs)))
            (ass)))
        (dk-have! (list '== (list g i j) ch) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))
        (subst (list '= (list g i j) ch))
        (dk-conj-close! (lambda () (ass))))))
  (dk-have! (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
              (list 'IN (list g 'yi_ 'yj_) cs)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
             (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld))))
        (dk-split! (dk-apply! gp i j))
        (ass))))
  (fact 'matof-in-mat 1 'n cs g)
  (dk-have! (list 'FORALL 'yi_ (list 'IMPLIES '(IN yi_ (INTERVAL 1 1)) (list 'FORALL 'yj_ (list 'IMPLIES '(IN yj_ (INTERVAL 1 n))
              (list 'IN (list g 'yi_ 'yj_) 'SET)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 1)))) ld)))
             (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld))))
        (dk-split! (dk-apply! gp i j))
        (fact 'membership-implies-sethood (list g i j) cs)
        (ass))))
  (let ((x (list 'LINCOMB 'md 'n c 'es)))
    (fact 'lincomb-type 'md 'n c 'es)
    (dk-cite! 'lincomb-coord 'md 'n 'es c)
    (lzt-ph-in! x)
    (lzt-tdv! 'w_)
    (ew x)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (lzt-ext! (lzt-phx x) 'w_
              (lambda (j)
                (lzt-idx! j)
                (lzt-coord! x)
                (lzt-kz! x j)
                (subst (dk-cite! 'lzt-ph-at 'md 'n 'es 'dm 'sm x j))
                (subst (list '= (lzt-kp x) c))
                (subst (dk-cite! 'entry-of-matof 1 'n g 1 j))
                (dk-split! (dk-apply! gp 1 j))
                (ass))))))))
(lzt-done! 'lzt-ph-onto)

