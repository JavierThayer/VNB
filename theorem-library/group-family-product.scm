(fact 'nn-zero-in) (fact 'membership-implies-sethood 0 'NN) (fact 'card-singleton 0) (fact 'nn-succ-plus-one 0)
(subst (list '== '(CARR TRIV-GROUP) z10-z))
(subst (list '= (list 'CARD z10-z) '(succ 0)))
(subst '(= (succ 0) (+ 0 1)))
(crs)
(qed 'triv-group-card)
(sp (make-wff '(IS-GENERATOR TRIV-GROUP 0)))
(fact 'triv-group-is-group) (fact 'triv-group-carr) (fact 'triv-group-iden) (fact 'zz-zero-in) (fact 'nn-zero-in)
(z10-zero-in!)
(dk-have! '(IN 0 (CARR TRIV-GROUP)) (lambda () (subst (list '== '(CARR TRIV-GROUP) z10-z)) (ass)))
(z2-close! 'is-generator '(TRIV-GROUP 0)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (begin (subst (list '== '(CARR TRIV-GROUP) z10-z)) (ass))
            (let ((y (begin (dk-peel!) (cadr (caddr (caddr (dk-goal)))))))
              (dk-rewrite-h! (list 'IN y '(CARR TRIV-GROUP)) '(CARR TRIV-GROUP) z10-z)
              (z10-eq-zero! y)
              (dk-apply! (dk-cite! 'zpow-nat 0) 'TRIV-GROUP 0)
              (dk-cite! 'gpow-zero 'TRIV-GROUP 0)
              (ew 0)
              (dk-conj-close!
                (lambda () (if (not (dk-ass!))
                               (begin (subst (list '= y 0)) (subst '(= (GROUP-ZPOW TRIV-GROUP 0 0) (GPOW TRIV-GROUP 0 0)))
                                      (subst '(= (GPOW TRIV-GROUP 0 0) (IDEN TRIV-GROUP))) (subst '(== (IDEN TRIV-GROUP) 0)) (rfl)))))))))))
(qed 'triv-group-generator)

;;; the hypotheses on the family, for i in 1..m
(define (z10-gh m) (list 'FORALL 'gi_ (list 'IMPLIES '(IN gi_ NN) (list 'IMPLIES '(<= 1 gi_) (list 'IMPLIES (list '<= 'gi_ m)
  '(AND (IS-GROUP (gf gi_)) (AND (IN (CARD (CARR (gf gi_))) NN) (IS-GENERATOR (gf gi_) (xf gi_)))))))))
(define (z10-p m) (list 'GROUP-FAMPROD 'gf m))
(define (z10-t m) (list 'GROUP-FAMTUPLE 'xf m))
;;; GH(succ v) gives GH(v) and the facts at succ v
(define (z10-gh-step! v)
  (let ((sv (list 'succ v)))
    (fact 'nn-succ-closed v)
    (dk-have! (z10-gh v)
      (lambda () (let ((i (begin (dk-peel!) (cadr (cadr (cadr (dk-goal)))))))
                   (dk-have! (list '<= i sv) (lambda () (dk-nn! (list '<= i v))))
                   (dk-split-all! (list (dk-apply! (dk-ctx-form (z10-gh sv)) i)))
                   (dk-conj-close! (lambda () (ass))))))
    (dk-have! (list '<= 1 sv) (lambda () (dk-nn!)))
    (dk-have! (list '<= sv sv) (lambda () (dk-nn!)))
    (dk-split-all! (list (dk-apply! (dk-ctx-form (z10-gh sv)) sv)))
    (z2-open! 'is-generator (list (list 'gf sv) (list 'xf sv)) (list 'IS-GENERATOR (list 'gf sv) (list 'xf sv)))))

;;; F3: the product is a finite group holding the tuple
(define (z10-f3 m) (list 'AND (list 'IS-GROUP (z10-p m)) (list 'AND (list 'IN (list 'CARD (list 'CARR (z10-p m))) 'NN) (list 'IN (z10-t m) (list 'CARR (z10-p m))))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'gf (list 'FORALL 'xf (list 'IMPLIES (z10-gh 'm) (z10-f3 'm))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'group-famprod-zero 'gf) (dk-cite! 'group-famtuple-zero 'xf)
  (fact 'triv-group-is-group) (fact 'triv-group-carr) (fact 'triv-group-card) (fact 'nn-one-in)
  (z10-zero-in!)
  (subst (list '== (z10-p 0) 'TRIV-GROUP))
  (subst (list '== (z10-t 0) 0))
  (dk-conj-close!
    (lambda () (if (not (dk-ass!))
                   (if (dk-contains? (dk-goal) 'CARD) (begin (subst '(= (CARD (CARR TRIV-GROUP)) 1)) (ass))
                       (begin (subst (list '== '(CARR TRIV-GROUP) z10-z)) (ass))))))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (z10-gh-step! v)
  (dk-split-all! (list (dk-apply! (dk-ctx-form ih) 'gf 'xf)))
  (let* ((sv (list 'succ v)) (pv (z10-p v)) (gs (list 'gf sv)) (cp (list 'CARR pv)) (cg (list 'CARR gs)))
    (dk-cite! 'group-famprod-succ 'gf v) (dk-cite! 'group-famtuple-succ 'xf v)
    (subst (list '== (z10-p sv) (list 'GROUP-PROD pv gs)))
    (subst (list '== (z10-t sv) (list 'LIST (z10-t v) (list 'xf sv))))
    (dk-apply! (dk-cite! 'group-prod-is-group pv) gs)
    (dk-apply! (dk-cite! 'group-prod-carr pv) gs)
    (fact 'group-carr-set pv) (fact 'group-carr-set gs)
    (dk-have! (list 'AND (list 'IN cp 'SET) (list 'IN (list 'CARD cp) 'NN)))
    (dk-have! (list 'AND (list 'IN cg 'SET) (list 'IN (list 'CARD cg) 'NN)))
    (dk-apply! (dk-cite! 'card-cartesian cp) cg)
    (dk-have! (list 'AND (list 'IN (list 'CARD cp) 'NN) (list 'IN (list 'CARD cg) 'NN))) (fact 'nn-mul-closed (list 'CARD cp) (list 'CARD cg))
    (dk-cite! 'pair-in-cartesian cp cg (z10-t v) (list 'xf sv))
    (dk-conj-close!
      (lambda () (if (not (dk-ass!))
                     (begin (subst (list '== (list 'CARR (list 'GROUP-PROD pv gs)) (list 'CARTESIAN cp cg)))
                            (if (dk-contains? (dk-goal) 'CARD) (subst (list '= (list 'CARD (list 'CARTESIAN cp cg)) (list '* (list 'CARD cp) (list 'CARD cg)))))
                            (ass)))))))
(qed 'group-famprod-facts)

;;; F7: a generator (u, x) of X x Y projects to a generator u of X
(sp (make-wff (z5-gx2 (forall-guarded '(pu pw) (list '(IN pu (CARR X)) '(IN pw (CARR Y)) (list 'IS-GENERATOR z5-p '(LIST pu pw))) '(IS-GENERATOR X pu)))))
(dk-peel!)
(fact 'group-identity-in 'Y)
(dk-apply! (dk-cite! 'group-prod-carr 'X) 'Y)
(dk-cite! 'pair-in-cartesian '(CARR X) '(CARR Y) 'pu 'pw)
(dk-have! (list 'IN '(LIST pu pw) (list 'CARR z5-p)) (lambda () (subst (list '== (list 'CARR z5-p) '(CARTESIAN (CARR X) (CARR Y)))) (ass)))
(z2-open! 'is-generator (list z5-p '(LIST pu pw)) (list 'IS-GENERATOR z5-p '(LIST pu pw)))
(z2-close! 'is-generator '(X pu)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((v (begin (dk-peel!) (cadr (caddr (caddr (dk-goal))))))
                   (ve (list 'LIST v '(IDEN Y))))
              (dk-cite! 'pair-in-cartesian '(CARR X) '(CARR Y) v '(IDEN Y))
              (dk-have! (list 'IN ve (list 'CARR z5-p)) (lambda () (subst (list '== (list 'CARR z5-p) '(CARTESIAN (CARR X) (CARR Y)))) (ass)))
              (let ((k (dk-skolem! (dk-apply! (dk-ctx-form (list 'FORALL 'geny_ (list 'IMPLIES (list 'IN 'geny_ (list 'CARR z5-p)) (list 'FORSOME 'genk_ (list 'AND '(IN genk_ ZZ) (list '= 'geny_ (list 'GROUP-ZPOW z5-p '(LIST pu pw) 'genk_))))))) ve) #t)))
                (dk-apply! (dk-cite! 'zpow-prod k) 'X 'Y 'pu 'pw)
                (dk-cite! 'zpow-type k 'X 'pu) (dk-cite! 'zpow-type k 'Y 'pw)
                (let* ((a (list 'GROUP-ZPOW 'X 'pu k)) (b (list 'GROUP-ZPOW 'Y 'pw k)))
                  (dk-have! (list '= (list 'NTH 1 ve) (list 'NTH 1 (list 'LIST a b)))
                    (lambda () (subst (list '= ve (list 'GROUP-ZPOW z5-p '(LIST pu pw) k))) (subst (list '= (list 'GROUP-ZPOW z5-p '(LIST pu pw) k) (list 'LIST a b))) (z4-nth-norm!) (rfl)))
                  (dk-nth-h! (list '= (list 'NTH 1 ve) (list 'NTH 1 (list 'LIST a b))))
                  (ew k)
                  (dk-conj-close! (lambda () (ass)))))))))))
(qed 'group-prod-generator-left)

;;; F8: n_i divides card P(m) for i in 1..m
(define (z10-n i) (list 'CARD (list 'CARR (list 'gf i))))
(define (z10-cp m) (list 'CARD (list 'CARR (z10-p m))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'gf (list 'FORALL 'xf (list 'IMPLIES (z10-gh 'm)
  (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES '(<= 1 i) (list 'IMPLIES '(<= i m) (list 'ZZ-DIVIDES (z10-n 'i) (z10-cp 'm)))))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let ((i (begin (dk-peel!) (cadr (cadr (cadr (cadr (dk-goal))))))))
    (fact 'nn-in-rr i) (z2-absurd! (list '<= 1 i) (list '<= i 0)))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((i (cadr (cadr (cadr (cadr (dk-goal)))))) (sv (list 'succ v)) (pv (z10-p v)) (gs (list 'gf sv)) (cp (list 'CARR pv)) (cg (list 'CARR gs)))
    (z10-gh-step! v)
    (dk-split-all! (list (dk-apply! (dk-cite! 'group-famprod-facts v) 'gf 'xf)))
    (dk-cite! 'group-famprod-succ 'gf v)
    (dk-apply! (dk-cite! 'group-prod-carr pv) gs)
    (fact 'group-carr-set pv) (fact 'group-carr-set gs)
    (dk-have! (list 'AND (list 'IN cp 'SET) (list 'IN (list 'CARD cp) 'NN)))
    (dk-have! (list 'AND (list 'IN cg 'SET) (list 'IN (list 'CARD cg) 'NN)))
    (dk-apply! (dk-cite! 'card-cartesian cp) cg)
    (dk-type! (list 'CARD cp) 'ZZ) (dk-type! (list 'CARD cg) 'ZZ) (dk-type! (list '* (list 'CARD cp) (list 'CARD cg)) 'ZZ)
    (dk-have! (list '= (z10-cp sv) (list '* (list 'CARD cp) (list 'CARD cg)))
      (lambda () (subst (list '== (z10-p sv) (list 'GROUP-PROD pv gs))) (subst (list '== (list 'CARR (list 'GROUP-PROD pv gs)) (list 'CARTESIAN cp cg))) (ass)))
    (subst (list '= (z10-cp sv) (list '* (list 'CARD cp) (list 'CARD cg))))
    (ma-or-split! (dk-apply! (dk-cite! 'nn-le-succ-cases v) i)
      (list (lambda ()
              (dk-apply! (dk-ctx-form ih) 'gf 'xf i)
              (dk-apply! (dk-cite! 'zz-divides-mul-right) (z10-n i) (list 'CARD cp) (list 'CARD cg))
              (ass))
            (lambda ()
              (subst (list '= i sv))
              (dk-have! (list '= (list '* (list 'CARD cp) (list 'CARD cg)) (list '* (list 'CARD cg) (list 'CARD cp))) (lambda () (crs)))
              (z3-div-intro! (list 'CARD cp)))))))
(qed 'group-famprod-card-divisible)

;;; F4': N prime to every n_i, i in 1..m, is prime to card P(m)
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'gf (list 'FORALL 'xf (list 'IMPLIES (z10-gh 'm)
  (list 'FORALL 'nb (list 'IMPLIES '(IN nb ZZ) (list 'IMPLIES (list 'FORALL 'ci_ (list 'IMPLIES '(IN ci_ NN) (list 'IMPLIES '(<= 1 ci_) (list 'IMPLIES '(<= ci_ m) (list 'ZZ-COPRIME (z10-n 'ci_) 'nb)))))
    (list 'ZZ-COPRIME (z10-cp 'm) 'nb)))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'group-famprod-zero 'gf) (fact 'triv-group-card) (fact 'zz-one-in) (fact 'zz-zero-in)
  (subst (list '== (z10-p 0) 'TRIV-GROUP))
  (subst '(= (CARD (CARR TRIV-GROUP)) 1))
  (let ((iff (dk-cite! 'zz-coprime-bezout 1 'nb)))
    (dk-have! (caddr iff)
      (lambda () (ew 1) (dk-conj-close! (lambda () (cond ((dk-ass!) #t) ((dk-head-is? (dk-goal) 'FORSOME) (ew 0) (dk-conj-close! (lambda () (if (not (dk-ass!)) (crs))))) (#t (crs)))))))
    (ma-iff-back! iff))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((sv (list 'succ v)) (pv (z10-p v)) (gs (list 'gf sv)) (cp (list 'CARR pv)) (cg (list 'CARR gs))
         (allc (lambda (m) (list 'FORALL 'ci_ (list 'IMPLIES '(IN ci_ NN) (list 'IMPLIES '(<= 1 ci_) (list 'IMPLIES (list '<= 'ci_ m) (list 'ZZ-COPRIME (z10-n 'ci_) 'nb))))))))
    (z10-gh-step! v)
    (dk-split-all! (list (dk-apply! (dk-cite! 'group-famprod-facts v) 'gf 'xf)))
    (dk-have! (allc v) (lambda () (let ((i (begin (dk-peel!) (cadr (cadr (cadr (cadr (dk-goal))))))))
                                    (dk-have! (list '<= i sv) (lambda () (dk-nn! (list '<= i v))))
                                    (dk-apply! (dk-ctx-form (allc sv)) i) (ass))))
    (dk-apply! (dk-ctx-form ih) 'gf 'xf 'nb)
    (dk-apply! (dk-ctx-form (allc sv)) sv)
    (dk-cite! 'group-famprod-succ 'gf v)
    (dk-apply! (dk-cite! 'group-prod-carr pv) gs)
    (fact 'group-carr-set pv) (fact 'group-carr-set gs)
    (dk-have! (list 'AND (list 'IN cp 'SET) (list 'IN (list 'CARD cp) 'NN)))
    (dk-have! (list 'AND (list 'IN cg 'SET) (list 'IN (list 'CARD cg) 'NN)))
    (dk-apply! (dk-cite! 'card-cartesian cp) cg)
    (dk-type! (list 'CARD cp) 'ZZ) (dk-type! (list 'CARD cg) 'ZZ)
    (dk-apply! (dk-cite! 'zz-coprime-mul) (list 'CARD cp) (list 'CARD cg) 'nb)
    (subst (list '== (z10-p sv) (list 'GROUP-PROD pv gs)))
    (subst (list '== (list 'CARR (list 'GROUP-PROD pv gs)) (list 'CARTESIAN cp cg)))
    (subst (list '= (list 'CARD (list 'CARTESIAN cp cg)) (list '* (list 'CARD cp) (list 'CARD cg))))
    (ass)))
(qed 'group-famprod-card-coprime)

;;; PROP. 1.39 (m groups): x_i generating the finite G_i (i = 1..m), (x_1, ..., x_m) generates G_1 x ... x G_m iff
;;; card G_1, ..., card G_m are pairwise relatively prime
(define (z10-pw m) (list 'FORALL 'pi_ (list 'IMPLIES '(IN pi_ NN) (list 'IMPLIES '(<= 1 pi_) (list 'IMPLIES (list '<= 'pi_ m)
  (list 'FORALL 'pj_ (list 'IMPLIES '(IN pj_ NN) (list 'IMPLIES '(<= 1 pj_) (list 'IMPLIES (list '<= 'pj_ m)
    (list 'IMPLIES '(NOT (= pi_ pj_)) (list 'ZZ-COPRIME (z10-n 'pi_) (z10-n 'pj_))))))))))))
(define (z10-ij) (let* ((g (dk-goal)) (i (cadr (cadr (cadr (cadr g))))) (j (cadr (cadr (cadr (caddr g)))))) (list i j)))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'gf (list 'FORALL 'xf (list 'IMPLIES (z10-gh 'm)
  (list 'IFF (list 'IS-GENERATOR (z10-p 'm) (z10-t 'm)) (z10-pw 'm)))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'group-famprod-zero 'gf) (dk-cite! 'group-famtuple-zero 'xf)
  (subst (list '== (z10-p 0) 'TRIV-GROUP))
  (subst (list '== (z10-t 0) 0))
  (fact 'triv-group-generator)
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    (lambda () (dk-peel!) (let ((i (car (z10-ij)))) (fact 'nn-in-rr i) (z2-absurd! (list '<= 1 i) (list '<= i 0))))
    (lambda () (ass)))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((sv (list 'succ v)) (pv (z10-p v)) (tv (z10-t v)) (gs (list 'gf sv)) (xs (list 'xf sv))
         (cp (z10-cp v)) (ns (z10-n sv)) (pp (list 'GROUP-PROD pv gs)) (tt (list 'LIST tv xs)))
    (z10-gh-step! v)
    (dk-split-all! (list (dk-apply! (dk-cite! 'group-famprod-facts v) 'gf 'xf)))
    (dk-cite! 'group-famprod-succ 'gf v) (dk-cite! 'group-famtuple-succ 'xf v)
    (subst (list '== (z10-p sv) pp))
    (subst (list '== (z10-t sv) tt))
    (dk-type! cp 'ZZ) (dk-type! ns 'ZZ)
    (let ((ihi (dk-apply! (dk-ctx-form ih) 'gf 'xf))
          (cpg! (lambda () (dk-apply! (dk-cite! 'cyclic-product-generator) pv gs tv xs))))
      (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
        ;; a generator: the cards are pairwise prime
        (lambda ()
          (dk-apply! (dk-cite! 'group-prod-generator-left pv) gs tv xs)
          (ma-iff-parts! ihi)
          (ma-iff-parts! (cpg!))
          (dk-apply! (dk-cite! 'zz-coprime-sym) cp ns)
          (dk-peel!)
          (let* ((ij (z10-ij)) (i (car ij)) (j (cadr ij))
                 (ni (z10-n i)) (nj (z10-n j))
                 (side! (lambda (k)
                          ;; k <= v: n_k | card P(v), so n_sv is prime to n_k
                          (dk-apply! (dk-cite! 'group-famprod-card-divisible v) 'gf 'xf k)
                          (let ((c (z3-dv! (z10-n k) cp)))
                            (dk-rewrite-h! (list 'ZZ-COPRIME ns cp) cp (list '* (z10-n k) c))
                            (dk-apply! (dk-cite! 'zz-coprime-factor) ns (z10-n k) c)))))
            (ma-or-split! (dk-apply! (dk-cite! 'nn-le-succ-cases v) i)
              (list (lambda ()
                      (ma-or-split! (dk-apply! (dk-cite! 'nn-le-succ-cases v) j)
                        (list (lambda () (dk-apply! (dk-ctx-form (z10-pw v)) i j) (ass))
                              (lambda () (subst (list '= j sv)) (side! i)
                                         (dk-split-all! (list (dk-apply! (dk-ctx-form (z10-gh v)) i))) (dk-type! ni 'ZZ)
                                         (dk-apply! (dk-cite! 'zz-coprime-sym) ns ni) (ass)))))
                    (lambda ()
                      (ma-or-split! (dk-apply! (dk-cite! 'nn-le-succ-cases v) j)
                        (list (lambda () (subst (list '= i sv)) (side! j) (ass))
                              (lambda () (dk-have! (list '= i j) (lambda () (subst (list '= i sv)) (subst (list '= j sv)) (rfl)))
                                         (ma-prop-with! (list (list '= i j) (list 'NOT (list '= i j))))))))))))
        ;; pairwise prime: (x_1, ..., x_(m+1)) generates
        (lambda ()
          (dk-have! (z10-pw v)
            (lambda ()
              (dk-peel!)
              (let* ((ij (z10-ij)) (i (car ij)) (j (cadr ij)))
                (dk-have! (list '<= i sv) (lambda () (dk-nn! (list '<= i v))))
                (dk-have! (list '<= j sv) (lambda () (dk-nn! (list '<= j v))))
                (dk-apply! (dk-ctx-form (z10-pw sv)) i j)
                (ass))))
          (ma-iff-back! ihi)
          (dk-have! (list 'FORALL 'ci_ (list 'IMPLIES '(IN ci_ NN) (list 'IMPLIES '(<= 1 ci_) (list 'IMPLIES (list '<= 'ci_ v) (list 'ZZ-COPRIME (z10-n 'ci_) ns)))))
            (lambda ()
              (let ((i (begin (dk-peel!) (cadr (cadr (cadr (cadr (dk-goal))))))))
                (dk-have! (list '<= i sv) (lambda () (dk-nn! (list '<= i v))))
                (dk-have! (list 'NOT (list '= i sv)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= i sv) (list '<= i v)))) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0))))))
                (dk-apply! (dk-ctx-form (z10-pw sv)) i sv)
                (ass))))
          (dk-apply! (dk-cite! 'group-famprod-card-coprime v) 'gf 'xf ns)
          (ma-iff-back! (cpg!)))))))
(qed 'cyclic-family-product-generator)

