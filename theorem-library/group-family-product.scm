    ((and (pair? t) (pair? (car t)))
     (let* ((op (car (car t))) (rg (cadr (car t))) (args (cdr t)) (cr (list 'CARR rg)))
       (for-each (lambda (a) (z4-ty! a cr)) args)
       (case op
