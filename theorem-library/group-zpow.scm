    (VNB-LAMBDA gpp_ (CARTESIAN (CARR X) (CARR Y)) (LIST ((INV X) (NTH 1 gpp_)) ((INV Y) (NTH 2 gpp_))))))
;;; the four read-offs
(define (z5-gx2 body) (list 'FORALL 'X (list 'IMPLIES '(IS-GROUP X) (list 'FORALL 'Y (list 'IMPLIES '(IS-GROUP Y) body)))))
(define (z5-readoff! acc)
  (dk-peel!)
  (mac 'GROUP-PROD)
  (let loop ((k 0))
    (if (and (< k 6) (not (alpha-equiv? (cadr (dk-goal)) (caddr (dk-goal)))))
        (begin (slot acc) (z4-nth-norm!) (loop (+ k 1)))))
  (qrfl))
(sp (make-wff (z5-gx2 (list '== (list 'CARR z5-p) (list-ref z5-body 0)))))
(z5-readoff! 'CARR)
(qed 'group-prod-carr)
(sp (make-wff (z5-gx2 (list '== (list 'OPR z5-p) (list-ref z5-body 1)))))
(z5-readoff! 'OPR)
(qed 'group-prod-opr)
(sp (make-wff (z5-gx2 (list '== (list 'IDEN z5-p) (list-ref z5-body 2)))))
(z5-readoff! 'IDEN)
(qed 'group-prod-iden)
(sp (make-wff (z5-gx2 (list '== (list 'INV z5-p) (list-ref z5-body 3)))))
(z5-readoff! 'INV)
(qed 'group-prod-inv)
(define (z5-xy!) (set! z4-x 'X) (set! z4-y 'Y))

;;; the operation and the inverse on pairs
(sp (make-wff (z5-gx2 (forall-guarded '(a1 a2 b1 b2) '((IN a1 (CARR X)) (IN a2 (CARR Y)) (IN b1 (CARR X)) (IN b2 (CARR Y)))
  (list '= (list (list 'OPR z5-p) '(LIST a1 a2) '(LIST b1 b2)) '(LIST ((OPR X) a1 b1) ((OPR Y) a2 b2)))))))
(dk-peel!)
(z5-xy!)
(dk-cite! 'group-prod-opr 'X 'Y)
(subst (list '== (list 'OPR z5-p) (cadr z5-body)))
(z4-beta!)
(z4-ty! '(LIST ((OPR X) a1 b1) ((OPR Y) a2 b2)) (z4-c))
(if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))
(qed 'group-prod-opr-pair)
(sp (make-wff (z5-gx2 (forall-guarded '(a1 a2) '((IN a1 (CARR X)) (IN a2 (CARR Y)))
  (list '= (list (list 'INV z5-p) '(LIST a1 a2)) '(LIST ((INV X) a1) ((INV Y) a2)))))))
(dk-peel!)
(z5-xy!)
(dk-cite! 'group-prod-inv 'X 'Y)
(subst (list '== (list 'INV z5-p) (list-ref z5-body 3)))
(z4-beta!)
(z4-ty! '(LIST ((INV X) a1) ((INV Y) a2)) (z4-c))
(if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))
(qed 'group-prod-inv-pair)

;;; powers are computed componentwise
(define (z5-pw g x n) (list 'GPOW g x n))
(define (z5-z g x k) (list 'GROUP-ZPOW g x k))
(define z5-u '(LIST a1 a2))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (z5-gx2 (forall-guarded '(a1 a2) '((IN a1 (CARR X)) (IN a2 (CARR Y)))
  (list '= (z5-pw z5-p z5-u 'n) (list 'LIST (z5-pw 'X 'a1 'n) (z5-pw 'Y 'a2 'n)))))))))
(let* ((ind (dk-use-induction-fixed! '(x y))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: X, Y fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!) (z5-xy!)
  (dk-cite! 'gpow-zero z5-p z5-u) (dk-cite! 'gpow-zero 'X 'a1) (dk-cite! 'gpow-zero 'Y 'a2)
  (dk-cite! 'group-prod-iden 'X 'Y)
  (subst (list '= (z5-pw z5-p z5-u 0) (list 'IDEN z5-p)))
  (subst (list '== (list 'IDEN z5-p) '(LIST (IDEN X) (IDEN Y))))
  (subst (list '= (z5-pw 'X 'a1 0) '(IDEN X)))
  (subst (list '= (z5-pw 'Y 'a2 0) '(IDEN Y)))
  (z4-ty! '(LIST (IDEN X) (IDEN Y)) (z4-c))
  (rfl)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!) (z5-xy!)
  (let ((p1 (z5-pw 'X 'a1 v)) (p2 (z5-pw 'Y 'a2 v)))
    (dk-apply! (dk-ctx-form ih) 'a1 'a2)   ; W1G-B: X, Y fixed
    (dk-cite! 'gpow-type v 'X 'a1) (dk-cite! 'gpow-type v 'Y 'a2)
    (dk-cite! 'gpow-succ z5-p z5-u v) (dk-cite! 'gpow-succ 'X 'a1 v) (dk-cite! 'gpow-succ 'Y 'a2 v)
    (dk-apply! (dk-cite! 'group-prod-opr-pair 'X 'Y) 'a1 'a2 p1 p2)
    (subst (list '= (z5-pw z5-p z5-u (list 'succ v)) (list (list 'OPR z5-p) z5-u (z5-pw z5-p z5-u v))))
    (subst (list '= (z5-pw z5-p z5-u v) (list 'LIST p1 p2)))
    (subst (list '= (list (list 'OPR z5-p) z5-u (list 'LIST p1 p2)) (list 'LIST (list '(OPR X) 'a1 p1) (list '(OPR Y) 'a2 p2))))
    (subst (list '= (z5-pw 'X 'a1 (list 'succ v)) (list '(OPR X) 'a1 p1)))
    (subst (list '= (z5-pw 'Y 'a2 (list 'succ v)) (list '(OPR Y) 'a2 p2)))
    (z4-ty! (list 'LIST (list '(OPR X) 'a1 p1) (list '(OPR Y) 'a2 p2)) (z4-c))
    (rfl)))
(qed 'gpow-prod)

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z5-gx2 (forall-guarded '(a1 a2) '((IN a1 (CARR X)) (IN a2 (CARR Y)))
  (list '= (z5-z z5-p z5-u 'k) (list 'LIST (z5-z 'X 'a1 'k) (z5-z 'Y 'a2 'k)))))))))
(dk-peel!) (z5-xy!)
(fact 'zz-in-rr 'k) (fact 'rr-zero-in)
(mac 'GROUP-ZPOW)
(let* ((ifp (list 'IF '(<= 0 k) (z5-pw z5-p z5-u 'k) (list (list 'INV z5-p) (z5-pw z5-p z5-u '(- 0 k)))))
       (ifx (list 'IF '(<= 0 k) (z5-pw 'X 'a1 'k) (list '(INV X) (z5-pw 'X 'a1 '(- 0 k)))))
       (ify (list 'IF '(<= 0 k) (z5-pw 'Y 'a2 'k) (list '(INV Y) (z5-pw 'Y 'a2 '(- 0 k))))))
  (dk-case-if! ifp
    (lambda (true? br)
      (dk-if-branch! true? ifx #f
        (lambda ()
          (dk-if-branch! true? ify #f
            (lambda ()
              (if true?
                  (begin
                    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'k)
                    (dk-apply! (dk-cite! 'gpow-prod 'k) 'X 'Y 'a1 'a2)
                    (ass))
                  (begin
                    (dk-have! '(AND (IN k RR) (IN 0 RR)))
                    (fact 'rr-leq-total 'k 0)
                    (dk-have! '(<= k 0) (lambda () (ma-or-split! '(OR (<= k 0) (<= 0 k))
                                                     (list (lambda () (ass)) (lambda () (ma-prop-with! (list '(<= 0 k) '(NOT (<= 0 k)))))))))
                    (dk-type! '(- 0 k) 'ZZ) (dk-type! '(- 0 k) 'RR)
                    (dk-have! '(<= 0 (- 0 k)) (lambda () (dk-ineq! '(<= k 0))))
                    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- 0 k))
                    (let ((p1 (z5-pw 'X 'a1 '(- 0 k))) (p2 (z5-pw 'Y 'a2 '(- 0 k))))
                      (dk-apply! (dk-cite! 'gpow-prod '(- 0 k)) 'X 'Y 'a1 'a2)
                      (dk-cite! 'gpow-type '(- 0 k) 'X 'a1) (dk-cite! 'gpow-type '(- 0 k) 'Y 'a2)
                      (dk-apply! (dk-cite! 'group-prod-inv-pair 'X 'Y) p1 p2)
                      (subst (list '= (z5-pw z5-p z5-u '(- 0 k)) (list 'LIST p1 p2)))
                      (subst (list '= (list (list 'INV z5-p) (list 'LIST p1 p2)) (list 'LIST (list '(INV X) p1) (list '(INV Y) p2))))
                      (z4-ty! (list 'LIST (list '(INV X) p1) (list '(INV Y) p2)) (z4-c))
                      (rfl)))))))))))
(qed 'zpow-prod)

