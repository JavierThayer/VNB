;;; ==================================================================== from grp2.scm
;;; (50) ALGEBRAIC-NUMBERS ch. 1, Prop. 1.36: the group kit for integer powers in a (non-abelian) group.
;;; GROUP-ZPOW (grp2-vocab.scm) is built on worker-04's GPOW (cg4-vocab.scm, laws in cg4-gpow.scm) and uses
;;; worker-04's group laws of tb11/tg-group.scm (group-inv-opr, group-inv-iden, group-right-inv-id), all loaded
;;; unedited by the wrapper.  Purely algebraic: no topology is used.  Helper prefix z2-.
(define (z2-op a b) (list '(OPR g) a b))
(define (z2-inv a) (list '(INV g) a))
(define z2-e '(IDEN g))
(define (z2-pw n) (list 'GPOW 'g 'x n))
(define (z2-z k) (list 'GROUP-ZPOW 'g 'x k))
(define (z2-gx body) (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'FORALL 'x (list 'IMPLIES '(IN x (CARR g)) body)))))
(define (z2-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (z2-cl! a b) (if (not (dk-asm? (list 'IN (z2-op a b) '(CARR g)))) (dk-cite! 'group-carrier-closed-opr 'g a b)))
(define (z2-invt! a) (if (not (dk-asm? (list 'IN (z2-inv a) '(CARR g)))) (fact 'group-inv-in 'g a)))
(define (z2-pwt! n) (if (not (dk-asm? (list 'IN (z2-pw n) '(CARR g)))) (dk-cite! 'gpow-type n 'g 'x)))
(define (z2-open! name args hyp)
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (z2-close! name args rhs!)
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (z2-ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
(define (z2-absurd! . prems) (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems))) (z2-ap-absurd!))

;;; right cancellation: a = b c gives a c^-1 = b
(sp (make-wff '(FORALL g (IMPLIES (IS-GROUP g) (FORALL a (IMPLIES (IN a (CARR g)) (FORALL b (IMPLIES (IN b (CARR g)) (FORALL c (IMPLIES (IN c (CARR g))
  (IMPLIES (= a ((OPR g) b c)) (= ((OPR g) a ((INV g) c)) b))))))))))))
(dk-peel!)
(z2-invt! 'c) (z2-cl! 'b 'c) (z2-cl! 'c (z2-inv 'c))
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'c)))
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'b)))
(dk-cite! 'group-assoc 'g 'b 'c (z2-inv 'c))
(subst (list '= 'a (z2-op 'b 'c)))
(subst (list '= (z2-op (z2-op 'b 'c) (z2-inv 'c)) (z2-op 'b (z2-op 'c (z2-inv 'c)))))
(subst (list '= (z2-op 'c (z2-inv 'c)) z2-e))
(subst (list '= (z2-op 'b z2-e) 'b))
(z2-rfl!)
(qed 'group-right-cancel)

;;; x^n for n a natural
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (z2-gx (list '= (z2-z 'n) (z2-pw 'n)))))))
(dk-peel!)
(z2-pwt! 'n)
(dk-have! '(<= 0 n) (lambda () (dk-nn!)))
(mac 'GROUP-ZPOW)
(dk-if-branch! #t (list 'IF '(<= 0 n) (z2-pw 'n) (z2-inv (z2-pw '(- 0 n)))) #f (lambda () (z2-rfl!)))
(qed 'zpow-nat)

;;; x^(-n) = (x^n)^-1
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (z2-gx (list '= (z2-z '(- 0 n)) (z2-inv (z2-pw 'n))))))))
(dk-peel!)
(z2-pwt! 'n) (z2-invt! (z2-pw 'n)) (fact 'nn-in-rr 'n) (fact 'rr-zero-in) (fact 'group-identity-in 'g)
(dk-have! '(<= 0 n) (lambda () (dk-nn!)))
(mac 'GROUP-ZPOW)
(dk-case-if! (list 'IF '(<= 0 (- 0 n)) (z2-pw '(- 0 n)) (z2-inv (z2-pw '(- 0 (- 0 n)))))
  (lambda (true? br)
    (if true?
        (begin
          (dk-have! '(AND (IN n RR) (IN 0 RR)))
          (dk-have! '(AND (<= n 0) (<= 0 n)) (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! '(<= 0 (- 0 n))))))))
          (fact 'rr-leq-antisymmetric 'n 0)
          (dk-have! '(= (- 0 n) 0) (lambda () (subst '(= n 0)) (crs)))
          (subst '(= (- 0 n) 0))
          (subst '(= n 0))
          (dk-cite! 'gpow-zero 'g 'x)
          (subst (list '= (z2-pw 0) z2-e))
          (fact 'group-inv-iden 'g)
          (subst (list '= (z2-inv z2-e) z2-e))
          (z2-rfl!))
        (begin
          (dk-have! '(= (- 0 (- 0 n)) n) (lambda () (crs)))
          (subst '(= (- 0 (- 0 n)) n))
          (z2-rfl!)))))
(qed 'zpow-neg-nat)

;;; typing: x^k in G
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z2-gx (list 'IN (z2-z 'k) '(CARR g)))))))
(dk-peel!)
(fact 'zz-in-rr 'k) (fact 'rr-zero-in) (fact 'zz-zero-in)
(dk-have! '(AND (IN k RR) (IN 0 RR)))
(fact 'rr-leq-total 'k 0)
(ma-or-split! '(OR (<= k 0) (<= 0 k))
  (list (lambda ()
          (dk-type! '(- 0 k) 'ZZ) (dk-type! '(- 0 k) 'RR)
          (dk-have! '(<= 0 (- 0 k)) (lambda () (dk-ineq! '(<= k 0))))
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- 0 k))
          (dk-apply! (dk-cite! 'zpow-neg-nat '(- 0 k)) 'g 'x)
          (dk-have! '(= k (- 0 (- 0 k))) (lambda () (crs)))
          (subst '(= k (- 0 (- 0 k))))
          (subst (list '= (z2-z '(- 0 (- 0 k))) (z2-inv (z2-pw '(- 0 k)))))
          (z2-pwt! '(- 0 k)) (z2-invt! (z2-pw '(- 0 k))) (ass))
        (lambda ()
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'k)
          (dk-apply! (dk-cite! 'zpow-nat 'k) 'g 'x)
          (subst (list '= (z2-z 'k) (z2-pw 'k)))
          (z2-pwt! 'k) (ass))))
(qed 'zpow-type)

;;; x^(k+1) = x^k x
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z2-gx (list '= (z2-z '(+ k 1)) (z2-op (z2-z 'k) 'x)))))))
(dk-peel!)
(fact 'zz-in-rr 'k) (fact 'rr-zero-in) (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'group-identity-in 'g)
(let ((nonneg!
        (lambda ()
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'k)
          (fact 'nn-succ-closed 'k) (fact 'nn-succ-plus-one 'k)
          (dk-have! '(IN (+ k 1) NN) (lambda () (subst '(= (+ k 1) (succ k))) (ass)))
          (dk-apply! (dk-cite! 'zpow-nat '(+ k 1)) 'g 'x)
          (dk-apply! (dk-cite! 'zpow-nat 'k) 'g 'x)
          (dk-cite! 'gpow-succ 'g 'x 'k)
          (z2-pwt! 'k) (z2-cl! 'x 'x)
          (dk-have! (list '= (z2-op 'x 'x) (z2-op 'x 'x)) (lambda () (z2-rfl!)))
          (dk-apply! (dk-cite! 'gpow-commute 'k) 'g 'x 'x)
          (subst (list '= (z2-z '(+ k 1)) (z2-pw '(+ k 1))))
          (subst '(= (+ k 1) (succ k)))
          (subst (list '= (z2-pw '(succ k)) (z2-op 'x (z2-pw 'k))))
          (subst (list '= (z2-op 'x (z2-pw 'k)) (z2-op (z2-pw 'k) 'x)))
          (subst (list '= (z2-z 'k) (z2-pw 'k)))
          (z2-rfl!))))
  (dk-have! '(AND (IN k RR) (IN 0 RR)))
  (fact 'rr-leq-total 'k 0)
  (ma-or-split! '(OR (<= k 0) (<= 0 k))
    (list (lambda ()
            (dk-type! '(- 0 k) 'ZZ) (dk-type! '(- 0 k) 'RR)
            (dk-have! '(<= 0 (- 0 k)) (lambda () (dk-ineq! '(<= k 0))))
            (dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- 0 k))
            (ma-or-split! (dk-apply! (dk-cite! 'nn-zero-or-succ) '(- 0 k))
              (list (lambda () (dk-have! '(<= 0 k) (lambda () (dk-ineq! '(= (- 0 k) 0)))) (nonneg!))
                    (lambda ()
                      (let* ((j (dk-skolem! (dk-ctx-form '(FORSOME q (AND (IN q NN) (= (- 0 k) (succ q))))) #t))
                             (sj (list 'succ j)) (pj (z2-pw j)) (ipj (z2-inv (z2-pw j))))
                        (fact 'nn-succ-closed j) (fact 'nn-succ-plus-one j)
                        (dk-have! (list '= '(+ k 1) (list '- 0 j))
                          (lambda () (dk-have! '(= k (- 0 (- 0 k))) (lambda () (crs))) (subst '(= k (- 0 (- 0 k))))
                                     (subst (list '= '(- 0 k) sj)) (subst (list '= sj (list '+ j 1))) (crs)))
                        (dk-have! (list '= 'k (list '- 0 sj))
                          (lambda () (dk-have! '(= k (- 0 (- 0 k))) (lambda () (crs))) (subst '(= k (- 0 (- 0 k))))
                                     (subst (list '= '(- 0 k) sj)) (z2-rfl!)))
                        (dk-apply! (dk-cite! 'zpow-neg-nat j) 'g 'x)
                        (dk-apply! (dk-cite! 'zpow-neg-nat sj) 'g 'x)
                        (dk-cite! 'gpow-succ 'g 'x j)
                        (z2-pwt! j) (z2-invt! pj) (z2-invt! 'x)
                        (dk-cite! 'group-inv-opr 'g 'x pj)
                        (dk-cite! 'group-assoc 'g ipj (z2-inv 'x) 'x)
                        (fact 'group-left-inv 'g 'x)
                        (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g ipj)))
                        (subst (list '= '(+ k 1) (list '- 0 j)))
                        (subst (list '= 'k (list '- 0 sj)))
                        (subst (list '= (z2-z (list '- 0 j)) ipj))
                        (subst (list '= (z2-z (list '- 0 sj)) (z2-inv (z2-pw sj))))
                        (subst (list '= (z2-pw sj) (z2-op 'x pj)))
                        (subst (list '= (z2-inv (z2-op 'x pj)) (z2-op ipj (z2-inv 'x))))
                        (subst (list '= (z2-op (z2-op ipj (z2-inv 'x)) 'x) (z2-op ipj (z2-op (z2-inv 'x) 'x))))
                        (subst (list '= (z2-op (z2-inv 'x) 'x) z2-e))
                        (subst (list '= (z2-op ipj z2-e) ipj))
                        (z2-rfl!))))))
          nonneg!)))
(qed 'zpow-succ)

;;; x^(m+n) = x^m x^n for n a natural
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m ZZ) (z2-gx (list '= (z2-z '(+ m n)) (z2-op (z2-z 'm) (z2-z 'n))))))))))
(let* ((ind (dk-use-induction-fixed! '(g x))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, x fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in) (fact 'group-identity-in 'g)
  (dk-cite! 'zpow-type 'm 'g 'x)
  (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x)
  (dk-cite! 'gpow-zero 'g 'x)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g (z2-z 'm))))
  (dk-have! '(= (+ m 0) m) (lambda () (crs)))
  (subst '(= (+ m 0) m))
  (subst (list '= (z2-z 0) (z2-pw 0)))
  (subst (list '= (z2-pw 0) z2-e))
  (subst (list '= (z2-op (z2-z 'm) z2-e) (z2-z 'm)))
  (z2-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'nn-succ-plus-one v) (dk-type! v 'ZZ) (fact 'zz-one-in)
  (let* ((mv (list '+ 'm v)) (v1 (list '+ v 1)))
    (dk-type! mv 'ZZ)
    (dk-cite! 'zpow-succ mv 'g 'x)
    (dk-cite! 'zpow-succ v 'g 'x)
    (dk-apply! (dk-ctx-form ih) 'm)   ; W1G-B: g, x fixed
    (dk-cite! 'zpow-type 'm 'g 'x) (dk-cite! 'zpow-type v 'g 'x)
    (dk-cite! 'group-assoc 'g (z2-z 'm) (z2-z v) 'x)
    (subst (list '= (list 'succ v) v1))
    (dk-have! (list '= (list '+ 'm v1) (list '+ mv 1)) (lambda () (crs)))
    (subst (list '= (list '+ 'm v1) (list '+ mv 1)))
    (subst (list '= (z2-z (list '+ mv 1)) (z2-op (z2-z mv) 'x)))
    (subst (list '= (z2-z mv) (z2-op (z2-z 'm) (z2-z v))))
    (subst (list '= (z2-z v1) (z2-op (z2-z v) 'x)))
    (subst (list '= (z2-op (z2-op (z2-z 'm) (z2-z v)) 'x) (z2-op (z2-z 'm) (z2-op (z2-z v) 'x))))
    (z2-rfl!)))
(qed 'zpow-add-nat)

;;; x^(m-n) = x^m x^(-n) for n a natural
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m ZZ) (z2-gx (list '= (z2-z '(- m n)) (z2-op (z2-z 'm) (z2-z '(- 0 n)))))))))))
(let* ((ind (dk-use-induction-fixed! '(g x))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, x fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in) (fact 'group-identity-in 'g)
  (dk-cite! 'zpow-type 'm 'g 'x)
  (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x)
  (dk-cite! 'gpow-zero 'g 'x)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g (z2-z 'm))))
  (dk-have! '(= (- m 0) m) (lambda () (crs)))
  (dk-have! '(= (- 0 0) 0) (lambda () (crs)))
  (subst '(= (- m 0) m))
  (subst '(= (- 0 0) 0))
  (subst (list '= (z2-z 0) (z2-pw 0)))
  (subst (list '= (z2-pw 0) z2-e))
  (subst (list '= (z2-op (z2-z 'm) z2-e) (z2-z 'm)))
  (z2-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'nn-succ-plus-one v) (dk-type! v 'ZZ) (fact 'zz-one-in) (fact 'nn-succ-closed v) (dk-type! (list 'succ v) 'ZZ)
  (let* ((sv (list 'succ v)) (k (list '- 'm sv)) (mv (list '- 'm v)) (nv (list '- 0 v)) (nsv (list '- 0 sv)) (ix (z2-inv 'x)))
    (dk-type! k 'ZZ) (dk-type! mv 'ZZ) (dk-type! nv 'ZZ) (dk-type! nsv 'ZZ)
    (z2-invt! 'x)
    (for-each (lambda (t) (dk-cite! 'zpow-type t 'g 'x)) (list 'm k mv nv nsv))
    (dk-cite! 'zpow-succ k 'g 'x)
    (dk-cite! 'zpow-succ nsv 'g 'x)
    (dk-have! (list '= (list '+ k 1) mv) (lambda () (subst (list '= sv (list '+ v 1))) (crs)))
    (dk-have! (list '= (list '+ nsv 1) nv) (lambda () (subst (list '= sv (list '+ v 1))) (crs)))
    (let* ((h1 (dk-rewrite-h! (list '= (z2-z (list '+ k 1)) (z2-op (z2-z k) 'x)) (list '+ k 1) mv))
           (h2 (dk-rewrite-h! (list '= (z2-z (list '+ nsv 1)) (z2-op (z2-z nsv) 'x)) (list '+ nsv 1) nv)))
      (dk-apply! (dk-cite! 'group-right-cancel) 'g (z2-z mv) (z2-z k) 'x)
      (dk-apply! (dk-cite! 'group-right-cancel) 'g (z2-z nv) (z2-z nsv) 'x)
      (dk-apply! (dk-ctx-form ih) 'm)   ; W1G-B: g, x fixed
      (z2-cl! (z2-z 'm) (z2-z nv))
      (dk-cite! 'group-assoc 'g (z2-z 'm) (z2-z nv) ix)
      (subst (list '= (z2-z k) (z2-op (z2-z mv) ix)))
      (subst (list '= (z2-z nsv) (z2-op (z2-z nv) ix)))
      (subst (list '= (z2-z mv) (z2-op (z2-z 'm) (z2-z nv))))
      (subst (list '= (z2-op (z2-op (z2-z 'm) (z2-z nv)) ix) (z2-op (z2-z 'm) (z2-op (z2-z nv) ix))))
      (z2-rfl!))))
(qed 'zpow-sub-nat)

;;; THE EXPONENT LAW: x^(m+n) = x^m x^n for all integers m, n
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m ZZ) (list 'FORALL 'n (list 'IMPLIES '(IN n ZZ) (z2-gx (list '= (z2-z '(+ m n)) (z2-op (z2-z 'm) (z2-z 'n))))))))))
(dk-peel!)
(fact 'zz-in-rr 'n) (fact 'rr-zero-in)
(dk-have! '(AND (IN n RR) (IN 0 RR)))
(fact 'rr-leq-total 'n 0)
(ma-or-split! '(OR (<= n 0) (<= 0 n))
  (list (lambda ()
          (dk-type! '(- 0 n) 'ZZ) (dk-type! '(- 0 n) 'RR)
          (dk-have! '(<= 0 (- 0 n)) (lambda () (dk-ineq! '(<= n 0))))
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- 0 n))
          (dk-apply! (dk-cite! 'zpow-sub-nat '(- 0 n)) 'm 'g 'x)
          (dk-have! '(= (- m (- 0 n)) (+ m n)) (lambda () (crs)))
          (dk-have! '(= (- 0 (- 0 n)) n) (lambda () (crs)))
          (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (z2-z '(- m (- 0 n))) (z2-op (z2-z 'm) (z2-z '(- 0 (- 0 n))))) '(- m (- 0 n)) '(+ m n))
                                  '(- 0 (- 0 n)) 'n)))
            (ass)))
        (lambda ()
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'n)
          (dk-apply! (dk-cite! 'zpow-add-nat 'n) 'm 'g 'x)
          (ass))))
(qed 'zpow-add)

;;; x^(-k) = (x^k)^-1
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z2-gx (list '= (z2-z '(- 0 k)) (z2-inv (z2-z 'k))))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'nn-zero-in) (fact 'group-identity-in 'g)
(dk-type! '(- 0 k) 'ZZ)
(let* ((zk (z2-z 'k)) (zn (z2-z '(- 0 k))) (iz (z2-inv zk)))
  (dk-cite! 'zpow-type 'k 'g 'x) (dk-cite! 'zpow-type '(- 0 k) 'g 'x)
  (z2-invt! zk) (z2-cl! zk zn)
  (dk-cite! 'zpow-add 'k '(- 0 k) 'g 'x)
  (dk-have! '(= (+ k (- 0 k)) 0) (lambda () (crs)))
  (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x)
  (dk-cite! 'gpow-zero 'g 'x)
  (let* ((h (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '= (z2-z '(+ k (- 0 k))) (z2-op zk zn)) '(+ k (- 0 k)) 0) (z2-z 0) (z2-pw 0)) (z2-pw 0) z2-e)))
    (dk-cite! 'group-assoc 'g iz zk zn)
    (fact 'group-left-inv 'g zk)
    (fact 'group-left-id 'g zn)
    (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g iz)))
    (dk-have! (list '= zn iz)
      (lambda ()
        (dk-have! (list '= (z2-op iz (z2-op zk zn)) zn)
          (lambda () (subst (list '= (z2-op iz (z2-op zk zn)) (z2-op (z2-op iz zk) zn))) (subst (list '= (z2-op iz zk) z2-e)) (subst (list '= (z2-op z2-e zn) zn)) (z2-rfl!)))
        (let ((h2 (dk-rewrite-h! (dk-rewrite-h! (list '= (z2-op iz (z2-op zk zn)) zn) (z2-op zk zn) z2-e) (z2-op iz z2-e) iz)))
          (subst (list '= zn iz)) (z2-rfl!))))
    (ass)))
(qed 'zpow-inv)

;;; ---- (Z, +) as a group: the additive group of ZZ-RING, read off in the arithmetic of ZZ ----
(define z2-za '(RING-ADDITIVE-AG ZZ-RING))
(sp (make-wff (forall-guarded '(u v) '((IN u ZZ) (IN v ZZ)) '(= ((ADD ZZ-RING) u v) (+ u v)))))
(dk-peel!)
(dk-have! '(AND (IN u ZZ) (IN v ZZ)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'zz-add-closed 'u 'v)
(slot 'ADD)
(if (not (dk-lam-b!)) (rfl))
(qed 'zz-ring-add-is-add)
(sp (make-wff (forall-guarded '(u) '((IN u ZZ)) '(= ((NEG ZZ-RING) u) (- u)))))
(dk-peel!)
(fact 'zz-neg-closed 'u)
(slot 'NEG)
(if (not (dk-lam-b!)) (rfl))
(qed 'zz-ring-neg-is-neg)
;;; the facts about ZA = RING-ADDITIVE-AG(ZZ-RING): a group, CARR = ZZ, OPR = ADD, IDEN = 0, INV = NEG
(define (z2-za!)
  (fact 'zz-is-commutative-ring)
  (dk-cite! 'commutative-ring-is-ring 'ZZ-RING)
  (dk-cite! 'ring-additive-ag-is-abelian-group 'ZZ-RING)
  (dk-cite! 'abelian-group-is-group z2-za)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
  (dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
  (dk-cite! 'ras-carr 'ZZ-RING) (dk-cite! 'ras-op 'ZZ-RING) (dk-cite! 'ras-id 'ZZ-RING) (dk-cite! 'ras-inv 'ZZ-RING)
  (dk-have! (list '= (list 'CARR z2-za) 'ZZ) (lambda () (subst (list '= (list 'CARR z2-za) '(CARR ZZ-RING))) (subst '(== (CARR ZZ-RING) ZZ)) (fact 'zz-is-set) (z2-rfl!)))
  (dk-have! (list '= (list 'IDEN z2-za) 0) (lambda () (subst (list '= (list 'IDEN z2-za) '(ZERO ZZ-RING))) (subst '(== (ZERO ZZ-RING) 0)) (z2-rfl!)))
  (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-zero-in) (fact 'nn-one-in))
;;; u in CARR ZA from u in ZZ, and back
(define (z2-in-za! u) (dk-have! (list 'IN u (list 'CARR z2-za)) (lambda () (subst (list '= (list 'CARR z2-za) 'ZZ)) (ass))))
(define (z2-in-zz! u) (dk-have! (list 'IN u 'ZZ) (lambda () (subst (list '= 'ZZ (list 'CARR z2-za))) (ass))))
(define z2-hom-opr '(FORALL x1_ (IMPLIES (IN x1_ (CARR (RING-ADDITIVE-AG ZZ-RING))) (FORALL x2_ (IMPLIES (IN x2_ (CARR (RING-ADDITIVE-AG ZZ-RING)))
                      (= (q ((OPR (RING-ADDITIVE-AG ZZ-RING)) x1_ x2_)) ((OPR g) (q x1_) (q x2_))))))))
(define (z2-subst-q tree q) (subst-free 'q q tree))

;;; a homomorphism q : Z -> G with q(1) = x agrees with the powers of x on the naturals
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (z2-gx (list 'FORALL 'q (list 'IMPLIES (list 'IS-HOM-GROUP z2-za 'g 'q)
  (list 'IMPLIES '(= (q 1) x) (list '= '(q n) (z2-z 'n))))))))))
(let* ((ind (dk-use-induction-fixed! '(g x q))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, x, q fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (z2-za!)
  (z2-open! 'is-hom-group-def (list z2-za 'g 'q) (list 'IS-HOM-GROUP z2-za 'g 'q))
  (fact 'group-identity-in 'g)
  (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x)
  (dk-cite! 'gpow-zero 'g 'x)
  (dk-rewrite-h! (list '= (list 'q (list 'IDEN z2-za)) '(IDEN g)) (list 'IDEN z2-za) 0)
  (subst '(= (q 0) (IDEN g)))
  (subst (list '= (z2-z 0) (z2-pw 0)))
  (subst (list '= (z2-pw 0) z2-e))
  (z2-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (z2-za!)
  (z2-open! 'is-hom-group-def (list z2-za 'g 'q) (list 'IS-HOM-GROUP z2-za 'g 'q))
  (fact 'nn-succ-plus-one v) (dk-type! v 'ZZ)
  (z2-in-za! v) (z2-in-za! 1)
  (dk-ctx-form ih)   ; W1G-B: g, x, q fixed; the IH is the equation
  (dk-apply! (dk-ctx-form z2-hom-opr) v 1)
  (dk-cite! 'zz-ring-add-is-add v 1)
  (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list 'q (list '(OPR (RING-ADDITIVE-AG ZZ-RING)) v 1)) (list '(OPR g) (list 'q v) '(q 1)))
                                         '(OPR (RING-ADDITIVE-AG ZZ-RING)) '(ADD ZZ-RING))
                          (list '(ADD ZZ-RING) v 1) (list '+ v 1))))
    (dk-cite! 'zpow-succ v 'g 'x)
    (subst (list '= (list 'succ v) (list '+ v 1)))
    (subst (list '= (list 'q (list '+ v 1)) (list '(OPR g) (list 'q v) '(q 1))))
    (subst (list '= (list 'q v) (z2-z v)))
    (subst '(= (q 1) x))
    (subst (list '= (z2-z (list '+ v 1)) (z2-op (z2-z v) 'x)))
    (z2-rfl!)))
(qed 'zpow-hom-unique-nat)

;;; PROPOSITION 1.36: for g in G there is a unique homomorphism pi : (Z, +) -> G with pi(1) = g, pi(k) = g^k
(define z2-pi '(VNB-LAMBDA zpk_ ZZ (GROUP-ZPOW g x zpk_)))
(sp (make-wff (z2-gx (list 'FORSOME 'cpi_ (list 'AND (list 'IS-HOM-GROUP z2-za 'g 'cpi_) (list 'AND '(= (cpi_ 1) x)
  (list 'FORALL 'cpf_ (list 'IMPLIES (list 'IS-HOM-GROUP z2-za 'g 'cpf_) (list 'IMPLIES '(= (cpf_ 1) x) '(= cpf_ cpi_))))))))))
(dk-peel!)
(z2-za!)
(fact 'group-identity-in 'g)
(let* ((p z2-pi) (cg '(CARR g)))
  ;; p : Z -> G
  (dk-have! (list 'IN p (list 'FUN 'ZZ cg))
    (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-cite! 'zpow-type z 'g 'x) (ass))) (lambda () (fact 'zz-is-set) (dk-ass!)))))
  ;; p(1) = x
  (dk-have! (list '= (list p 1) 'x)
    (lambda ()
      (dk-lam-b!)
      (dk-apply! (dk-cite! 'zpow-nat 1) 'g 'x)
      (fact 'nn-succ-plus-one 0)
      (dk-have! '(= 1 (succ 0)) (lambda () (subst '(= (succ 0) (+ 0 1))) (crs)))
      (dk-cite! 'gpow-succ 'g 'x 0)
      (dk-cite! 'gpow-zero 'g 'x)
      (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'x)))
      (subst (list '= (z2-z 1) (z2-pw 1)))
      (subst '(= 1 (succ 0)))
      (subst (list '= (z2-pw '(succ 0)) (z2-op 'x (z2-pw 0))))
      (subst (list '= (z2-pw 0) z2-e))
      (subst (list '= (z2-op 'x z2-e) 'x))
      (z2-rfl!)))
  (ew p)
  (dk-conj-close!
    (lambda ()
      (let ((goal (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? goal 'IS-HOM-GROUP)
           (z2-close! 'is-hom-group-def (list z2-za 'g p)
             (lambda ()
               (dk-conj-close!
                 (lambda ()
                   (let ((h (dk-goal)))
                     (cond
                       ((dk-ass!) #t)
                       ((dk-head-is? h 'IN) (subst (list '= (list 'CARR z2-za) 'ZZ)) (ass))
                       ((and (dk-head-is? h '=) (equal? (cadr h) (list p (list 'IDEN z2-za))))
                        (subst (list '= (list 'IDEN z2-za) 0))
                        (dk-lam-b!)
                        (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x)
                        (dk-cite! 'gpow-zero 'g 'x)
                        (subst (list '= (z2-z 0) (z2-pw 0))) (subst (list '= (z2-pw 0) z2-e)) (z2-rfl!))
                       ((dk-contains? h '(INV (RING-ADDITIVE-AG ZZ-RING)))
                        (let* ((u (begin (dk-peel!) (cadr (cadr (cadr (dk-goal)))))))
                          (z2-in-zz! u)
                          (dk-type! (list '- u) 'ZZ) (dk-type! (list '- 0 u) 'ZZ)
                          (dk-cite! 'zz-ring-neg-is-neg u)
                          (dk-cite! 'zpow-inv u 'g 'x)
                          (subst (list '= '(INV (RING-ADDITIVE-AG ZZ-RING)) '(NEG ZZ-RING)))
                          (subst (list '= (list '(NEG ZZ-RING) u) (list '- u)))
                          (dk-lam-b!)
                          (dk-have! (list '= (list '- u) (list '- 0 u)) (lambda () (crs)))
                          (subst (list '= (list '- u) (list '- 0 u)))
                          (subst (list '= (z2-z (list '- 0 u)) (z2-inv (z2-z u))))
                          (z2-rfl!)))
                       (#t
                        (let* ((uv (begin (dk-peel!) (cadr (cadr (dk-goal))))) (u (cadr uv)) (v (caddr uv)))
                          (z2-in-zz! u) (z2-in-zz! v)
                          (dk-type! (list '+ u v) 'ZZ)
                          (dk-cite! 'zz-ring-add-is-add u v)
                          (dk-cite! 'zpow-add u v 'g 'x)
                          (subst (list '= '(OPR (RING-ADDITIVE-AG ZZ-RING)) '(ADD ZZ-RING)))
                          (subst (list '= (list '(ADD ZZ-RING) u v) (list '+ u v)))
                          (dk-lam-b!)
                          (subst (list '= (z2-z (list '+ u v)) (z2-op (z2-z u) (z2-z v))))
                          (z2-rfl!))))))))))
          ((dk-head-is? goal 'FORALL)
           ;; uniqueness
           (dk-peel!)
           (let ((q (cadr (dk-goal))))
             (z2-open! 'is-hom-group-def (list z2-za 'g q) (list 'IS-HOM-GROUP z2-za 'g q))
             (dk-have! (list 'IN q (list 'FUN 'ZZ cg)) (lambda () (subst (list '= 'ZZ (list 'CARR z2-za))) (ass)))
             (dk-fun-ext! q p 'ZZ cg #f #f
               (lambda (k)
                 (dk-cite! 'zpow-type k 'g 'x)
                 (dk-lam-b!)
                 (fact 'zz-in-rr k) (fact 'rr-zero-in)
                 (dk-have! (list 'AND (list 'IN k 'RR) '(IN 0 RR)))
                 (fact 'rr-leq-total k 0)
                 (ma-or-split! (list 'OR (list '<= k 0) (list '<= 0 k))
                   (list (lambda ()
                           (let ((n (list '- 0 k)))
                             (dk-type! n 'ZZ) (dk-type! n 'RR)
                             (dk-have! (list '<= 0 n) (lambda () (dk-ineq! (list '<= k 0))))
                             (dk-apply! (dk-cite! 'zz-nonneg-in-nn) n)
                             (dk-apply! (dk-cite! 'zpow-hom-unique-nat n) 'g 'x q)
                             (z2-in-za! n)
                             (dk-apply! (dk-ctx-form (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'CARR z2-za)) (list '= (list q (list (list 'INV z2-za) 'x1_)) (list '(INV g) (list q 'x1_)))))) n)
                             (dk-cite! 'zz-ring-neg-is-neg n)
                             (dk-cite! 'zpow-inv n 'g 'x)
                             (dk-have! (list '= (list '- n) k) (lambda () (crs)))
                             (dk-have! (list '= k (list '- 0 n)) (lambda () (crs)))
                             (let ((h (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '= (list q (list (list 'INV z2-za) n)) (list '(INV g) (list q n)))
                                                                                   (list 'INV z2-za) '(NEG ZZ-RING))
                                                                    (list '(NEG ZZ-RING) n) (list '- n))
                                                     (list '- n) k)))
                               (dk-rewrite-h! (list '= (z2-z (list '- 0 n)) (z2-inv (z2-z n))) (list '- 0 n) k)
                               (subst (list '= (list q k) (list '(INV g) (list q n))))
                               (subst (list '= (list q n) (z2-z n)))
                               (subst (list '= (z2-z k) (z2-inv (z2-z n))))
                               (z2-rfl!))))
                         (lambda ()
                           (dk-apply! (dk-cite! 'zz-nonneg-in-nn) k)
                           (dk-apply! (dk-cite! 'zpow-hom-unique-nat k) 'g 'x q)
                           (ass)))))))))))))
(qed 'zz-cyclic-universal)


;;; ==================================================================== from grp3.scm
;;; (51) ALGEBRAIC-NUMBERS ch. 1, the group kit, part 2: periods of elements of a finite group (for 1.39 and 5.44).
;;; Helper prefix z3- (and the z2- helpers of grp2.scm, loaded before).
(define (z3-absurd-nn! . prems) (dk-have! '(< 0 0) (lambda () (apply dk-nn! prems))) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
(define (z3-val! lam x val)
  (dk-have! (list '= (list lam x) val) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))
(define (z3-per x d) (list 'FORSOME 'gpd_ (list 'AND '(IN gpd_ NN) (list 'AND '(<= 1 gpd_) (list '= (list 'GPOW 'g x 'gpd_) '(IDEN g))))))
;;; left cancellation: p = p q gives q = e
(sp (make-wff '(FORALL g (IMPLIES (IS-GROUP g) (FORALL p (IMPLIES (IN p (CARR g)) (FORALL q (IMPLIES (IN q (CARR g))
  (IMPLIES (= p ((OPR g) p q)) (= q (IDEN g)))))))))))
(dk-peel!)
(z2-invt! 'p) (z2-cl! 'p 'q) (fact 'group-identity-in 'g)
(dk-cite! 'group-assoc 'g (z2-inv 'p) 'p 'q)
(fact 'group-left-inv 'g 'p) (fact 'group-left-id 'g 'q)
(dk-have! (list '= (z2-op (z2-inv 'p) (z2-op 'p 'q)) 'q)
  (lambda () (subst (list '= (z2-op (z2-inv 'p) (z2-op 'p 'q)) (z2-op (z2-op (z2-inv 'p) 'p) 'q)))
             (subst (list '= (z2-op (z2-inv 'p) 'p) z2-e)) (subst (list '= (z2-op z2-e 'q) 'q)) (z2-rfl!)))
(let ((h (dk-rewrite-h! (list '= (z2-op (z2-inv 'p) (z2-op 'p 'q)) 'q) (z2-op 'p 'q) 'p)))
  (dk-rewrite-h! h (z2-op (z2-inv 'p) 'p) z2-e)
  (subst (list '= 'q z2-e)) (z2-rfl!))
(qed 'group-left-cancel-id)

;;; x^a = x^b with a < b gives x^(b - a) = e
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a NN) (list 'FORALL 'b (list 'IMPLIES '(IN b NN) (z2-gx (list 'IMPLIES '(<= a b)
  (list 'IMPLIES (list '= (z2-pw 'a) (z2-pw 'b)) (list '= (z2-pw '(- b a)) z2-e))))))))))
(dk-peel!)
(dk-type! 'a 'ZZ) (dk-type! 'b 'ZZ) (fact 'nn-in-rr 'a) (fact 'nn-in-rr 'b)
(dk-type! '(- b a) 'ZZ) (dk-type! '(- b a) 'RR)
(dk-have! '(<= 0 (- b a)) (lambda () (dk-ineq! '(<= a b))))
(dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- b a))
(dk-cite! 'gpow-add '(- b a) 'g 'x 'a)
(dk-have! '(= (+ a (- b a)) b) (lambda () (crs)))
(let ((h (dk-rewrite-h! (list '= (z2-pw '(+ a (- b a))) (z2-op (z2-pw 'a) (z2-pw '(- b a)))) '(+ a (- b a)) 'b)))
  (z2-pwt! 'a) (z2-pwt! '(- b a))
  (let ((h2 (dk-rewrite-h! h (z2-pw 'b) (z2-pw 'a))))
    (dk-apply! (dk-cite! 'group-left-cancel-id) 'g (z2-pw 'a) (z2-pw '(- b a)))
    (ass)))
(qed 'gpow-difference-period)

;;; K1: in a finite group every element has a period d >= 1
(sp (make-wff (z2-gx (list 'IMPLIES '(IN (CARD (CARR g)) NN) (z3-per 'x '(GPOW g x gpd_))))))
(dk-peel!)
(let* ((n '(CARD (CARR g))) (sn (list 'succ n)) (dd (list 'INTERVAL 1 sn)) (phi (list 'VNB-LAMBDA 'gpk_ dd '(GPOW g x gpk_)))
       (ex (z3-per 'x #f)))
  (fact 'group-carr-set 'g) (fact 'nn-succ-closed n) (fact 'nn-zero-in) (fact 'nn-one-in)
  (use-em ex
    (lambda () (ass))
    (lambda ()
      ;; phi : {1..n+1} -> G is injective
      (dk-have! (list 'IN phi (list 'FUN dd '(CARR g)))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (ma-iff-parts! (dk-cite! 'interval-membership 1 sn k)) (z2-pwt! k) (ass)))
                                 (lambda () (fact 'interval-in-set 1 sn) (dk-ass!)))))
      (let ((inj (dk-cite! 'injection-membership-iff dd '(CARR g) phi)))
        (dk-have! (caddr (caddr inj))
          (lambda ()
            (let* ((ab (begin (dk-peel!) (dk-goal))) (a (cadr ab)) (b (caddr ab)))
              (ma-iff-parts! (dk-cite! 'interval-membership 1 sn a))
              (ma-iff-parts! (dk-cite! 'interval-membership 1 sn b))
              (z2-pwt! a) (z2-pwt! b) (z3-val! phi a (z2-pw a)) (z3-val! phi b (z2-pw b))
              (dk-have! (list '= (z2-pw a) (z2-pw b))
                (lambda () (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list phi a) (list phi b)) (list phi a) (z2-pw a)) (list phi b) (z2-pw b))))
                             (ass))))
              (dk-type! a 'ZZ) (dk-type! b 'ZZ) (fact 'nn-in-rr a) (fact 'nn-in-rr b) (fact 'rr-zero-in)
              (let ((side! (lambda (lo hi eq)
                             ;; lo <= hi, x^lo = x^hi: lo = hi, else a period
                             (dk-apply! (dk-cite! 'gpow-difference-period lo) hi 'g 'x)
                             (dk-type! (list '- hi lo) 'ZZ) (dk-type! (list '- hi lo) 'RR)
                             (dk-have! (list '<= 0 (list '- hi lo)) (lambda () (dk-ineq! (list '<= lo hi))))
                             (dk-apply! (dk-cite! 'zz-nonneg-in-nn) (list '- hi lo))
                             (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 (list '- hi lo)))
                               (list (lambda ()
                                       (dk-apply! (dk-cite! 'zz-discrete) (list '- hi lo))
                                       (dk-have! ex (lambda () (ew (list '- hi lo)) (dk-conj-close! (lambda () (ass)))))
                                       (ma-prop-with! (list ex (list 'NOT ex))))
                                     (lambda () (dk-ineq! (list '= 0 (list '- hi lo)))))))))
                (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
                (fact 'rr-leq-total a b)
                (ma-or-split! (list 'OR (list '<= a b) (list '<= b a))
                  (list (lambda ()
                          (dk-have! (list '<= b a) (lambda () (side! a b #f)))
                          (dk-have! (list 'AND (list '<= a b) (list '<= b a))) (fact 'rr-leq-antisymmetric a b) (dk-ass!))
                        (lambda ()
                          (dk-have! (list '= (z2-pw b) (z2-pw a)) (lambda () (subst (list '= (z2-pw b) (z2-pw a))) (z2-rfl!)))
                          (dk-have! (list '<= a b) (lambda () (side! b a #f)))
                          (dk-have! (list 'AND (list '<= a b) (list '<= b a))) (fact 'rr-leq-antisymmetric a b) (dk-ass!))))))))
        (ma-iff-back! inj))
      ;; then card {1..n+1} = card IMAGE <= card G = n
      (fact 'interval-in-set 1 sn) (dk-apply! (dk-cite! 'interval-card) sn)
      (dk-have! (list 'AND (list 'IN phi (list 'INJECTION dd '(CARR g))) (list 'AND (list 'IN dd 'SET) (list 'IN (list 'CARD dd) 'NN)))
        (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= (list 'CARD dd) sn)) (ass)))))))
      (fact 'card-image-injection dd '(CARR g) phi)
      (fact 'image-set phi dd)
      (dk-apply! (dk-cite! 'image-subset-codomain dd '(CARR g) phi))
      (dk-have! (list 'SUBSET (list 'IMAGE phi dd) '(CARR g)) (lambda () (mac 'subset-def) (ass)))
      (dk-have! (list 'AND '(IN (CARR g) SET) (list 'IN n 'NN)))
      (dk-apply! (dk-cite! 'card-subset-mono '(CARR g)) (list 'IMAGE phi dd))
      (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'CARD (list 'IMAGE phi dd)) n) (list 'CARD (list 'IMAGE phi dd)) (list 'CARD dd)) (list 'CARD dd) sn)))
        (z3-absurd-nn! h)))))
(qed 'gpow-period-exists)

(define (z3-div-intro! c)
  ;; goal (ZZ-DIVIDES d x), d, x, c in ZZ, (= x (* d c)) in context
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))
(define (z3-ord-parts! d)
  ;; IS-ELEMENT-ORDER(g, x, d) in context: land its conjuncts
  (z2-open! 'is-element-order (list 'g 'x d) (list 'IS-ELEMENT-ORDER 'g 'x d)))
(define (z3-min x d) (list 'FORALL 'eod_ (list 'IMPLIES '(IN eod_ NN) (list 'IMPLIES '(<= 1 eod_) (list 'IMPLIES (list '= (list 'GPOW 'g x 'eod_) '(IDEN g)) (list '<= d 'eod_))))))

;;; K2a: in a finite group every element has an order
(sp (make-wff (z2-gx (list 'IMPLIES '(IN (CARD (CARR g)) NN) '(FORSOME eoo_ (IS-ELEMENT-ORDER g x eoo_))))))
(dk-peel!)
(let* ((tt (list 'SEP 'eot_ 'NN (list 'AND '(<= 1 eot_) (list '= '(GPOW g x eot_) '(IDEN g)))))
       (d0 (dk-skolem! (dk-apply! (dk-cite! 'gpow-period-exists) 'g 'x) #t)))
  (dk-have! (list 'SUBSET tt 'NN) (lambda () (ma-sep-subset! tt) (ass)))
  (dk-have! (list 'IN d0 tt) (lambda () (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass)))))))
  (dk-have! (list 'FORSOME 'n (list 'IN 'n tt)) (lambda () (ew d0) (ass)))
  (dk-have! (list 'AND (list 'SUBSET tt 'NN) (list 'FORSOME 'n (list 'IN 'n tt))))
  (fact 'nn-least-element tt)
  (let ((m (dk-skolem! (dk-ctx-form (list 'FORSOME 'm (list 'AND (list 'IN 'm tt) (list 'FORALL 'k (list 'IMPLIES (list 'IN 'k tt) '(<= m k)))))) #t)))
    (ma-sep-parts! (list 'IN m tt))
    (dk-split-all! (list (list 'AND (list '<= 1 m) (list '= (list 'GPOW 'g 'x m) '(IDEN g)))))
    (ew m)
    (z2-close! 'is-element-order (list 'g 'x m)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((k (begin (dk-peel!) (caddr (dk-goal)))))
                  (dk-have! (list 'IN k tt) (lambda () (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass)))))))
                  (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES (list 'IN 'k tt) (list '<= m 'k)))) k)
                  (ass)))))))))
(qed 'element-order-exists)

;;; K2b: x^d = e gives x^(d c) = e for every integer c
(sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c NN) (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IN d NN) (list 'IMPLIES (list '= (z2-pw 'd) z2-e) (list '= (z2-z '(* d c)) z2-e)))))))))
(let* ((ind (dk-use-induction-fixed! '(g x))) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1G-B: g, x fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in) (fact 'group-identity-in 'g)
  (dk-have! '(= (* d 0) 0) (lambda () (crs)))
  (subst '(= (* d 0) 0))
  (dk-apply! (dk-cite! 'zpow-nat 0) 'g 'x) (dk-cite! 'gpow-zero 'g 'x)
  (subst (list '= (z2-z 0) (z2-pw 0))) (subst (list '= (z2-pw 0) z2-e)) (z2-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'group-identity-in 'g) (fact 'nn-succ-plus-one v)
  (dk-type! 'd 'ZZ) (dk-type! v 'ZZ) (dk-type! (list '* 'd v) 'ZZ)
  (dk-apply! (dk-ctx-form ih) 'd)   ; W1G-B: g, x fixed
  (dk-cite! 'zpow-add (list '* 'd v) 'd 'g 'x)
  (dk-apply! (dk-cite! 'zpow-nat 'd) 'g 'x)
  (fact 'group-left-id 'g z2-e)
  (subst (list '= (list 'succ v) (list '+ v 1)))
  (dk-have! (list '= (list '* 'd (list '+ v 1)) (list '+ (list '* 'd v) 'd)) (lambda () (crs)))
  (subst (list '= (list '* 'd (list '+ v 1)) (list '+ (list '* 'd v) 'd)))
  (subst (list '= (z2-z (list '+ (list '* 'd v) 'd)) (z2-op (z2-z (list '* 'd v)) (z2-z 'd))))
  (subst (list '= (z2-z (list '* 'd v)) z2-e))
  (subst (list '= (z2-z 'd) (z2-pw 'd)))
  (subst (list '= (z2-pw 'd) z2-e))
  (subst (list '= (z2-op z2-e z2-e) z2-e))
  (z2-rfl!))
(qed 'zpow-multiple-period-nat)

(sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c ZZ) (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IN d NN) (list 'IMPLIES (list '= (z2-pw 'd) z2-e) (list '= (z2-z '(* d c)) z2-e)))))))))
(dk-peel!)
(fact 'zz-in-rr 'c) (fact 'rr-zero-in) (fact 'group-identity-in 'g)
(dk-have! '(AND (IN c RR) (IN 0 RR)))
(fact 'rr-leq-total 'c 0)
(ma-or-split! '(OR (<= c 0) (<= 0 c))
  (list (lambda ()
          (dk-type! '(- 0 c) 'ZZ) (dk-type! '(- 0 c) 'RR)
          (dk-have! '(<= 0 (- 0 c)) (lambda () (dk-ineq! '(<= c 0))))
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- 0 c))
          (dk-apply! (dk-cite! 'zpow-multiple-period-nat '(- 0 c)) 'g 'x 'd)
          (dk-type! 'd 'ZZ) (dk-type! '(* d (- 0 c)) 'ZZ)
          (dk-cite! 'zpow-inv '(* d (- 0 c)) 'g 'x)
          (fact 'group-inv-iden 'g)
          (dk-have! '(= (* d c) (- 0 (* d (- 0 c)))) (lambda () (crs)))
          (subst '(= (* d c) (- 0 (* d (- 0 c)))))
          (subst (list '= (z2-z '(- 0 (* d (- 0 c)))) (z2-inv (z2-z '(* d (- 0 c))))))
          (subst (list '= (z2-z '(* d (- 0 c))) z2-e))
          (subst (list '= (z2-inv z2-e) z2-e))
          (z2-rfl!))
        (lambda ()
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) 'c)
          (dk-apply! (dk-cite! 'zpow-multiple-period-nat 'c) 'g 'x 'd)
          (ass))))
(qed 'zpow-multiple-period)

;;; K2c: for x of order d, x^k = e iff d | k (k >= 0 first)
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d)
  (list 'IMPLIES (list '= (z2-z 'k) z2-e) '(ZZ-DIVIDES d k)))))))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-type! 'd 'ZZ) (dk-type! 'k 'ZZ) (fact 'nn-in-rr 'd) (fact 'zz-zero-in) (fact 'group-identity-in 'g)
(dk-have! '(NOT (= d 0)) (lambda () (di) (z2-absurd! '(= d 0) '(<= 1 d))))
(let* ((q (dk-skolem! (dk-apply! (dk-cite! 'nn-division 'k) 'd) #t))
       (r (dk-skolem! (dk-ctx-form (list 'FORSOME 'r_ (list 'AND '(IN r_ NN) (list 'AND (list '= 'k (list '+ (list '* q 'd) 'r_)) (list '<= '(succ r_) 'd))))) #t)))
  (dk-type! q 'ZZ) (dk-type! r 'ZZ) (dk-type! 'd 'ZZ) (dk-type! 'k 'ZZ) (fact 'nn-in-rr r) (fact 'nn-in-rr q)
  (dk-type! (list '* 'd q) 'ZZ)
  (dk-apply! (dk-cite! 'zpow-multiple-period q) 'g 'x 'd)
  (dk-cite! 'zpow-add (list '* 'd q) r 'g 'x)
  (dk-apply! (dk-cite! 'zpow-nat r) 'g 'x)
  (z2-pwt! r)
  (fact 'group-left-id 'g (z2-pw r))
  (dk-have! (list '= 'k (list '+ (list '* 'd q) r)) (lambda () (subst (list '= 'k (list '+ (list '* q 'd) r))) (crs)))
  (let ((h (dk-rewrite-h! (list '= (z2-z 'k) z2-e) 'k (list '+ (list '* 'd q) r))))
    (dk-have! (list '= (z2-pw r) z2-e)
      (lambda ()
        (let ((h2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! h (z2-z (list '+ (list '* 'd q) r)) (z2-op (z2-z (list '* 'd q)) (z2-z r)))
                                                                (z2-z (list '* 'd q)) z2-e) (z2-z r) (z2-pw r)) (z2-op z2-e (z2-pw r)) (z2-pw r))))
          (ass))))
    (dk-have! (list '<= 0 r) (lambda () (dk-nn!)))
    (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 r))
      (list (lambda ()
              (dk-apply! (dk-cite! 'zz-discrete) r)
              (dk-apply! (dk-ctx-form (z3-min 'x 'd)) r)
              (z3-absurd-nn! (list '<= 'd r) (list '<= (list 'succ r) 'd)))
            (lambda ()
              (dk-have! (list '= 'k (list '* 'd q)) (lambda () (subst (list '= 'k (list '+ (list '* 'd q) r))) (subst (list '= r 0)) (crs)))
              (z3-div-intro! q))))))
(qed 'element-order-divides-nat)

(define (z3-dv! d x) ;; (ZZ-DIVIDES d x) in context: return the witness c, x = d c
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-project! (list 'IN x 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-skolem! (dk-project! (list 'FORSOME 'c_ (list 'AND '(IN c_ ZZ) (list '= x (list '* d 'c_)))) 'zz-divides (list 'ZZ-DIVIDES d x))))

;;; K2c on ZZ: for x of order d, x^k = e iff d | k
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k ZZ) (z2-gx (list 'FORALL 'd (list 'IMPLIES '(IS-ELEMENT-ORDER g x d)
  (list 'IFF (list '= (z2-z 'k) z2-e) '(ZZ-DIVIDES d k)))))))))
(dk-peel!)
(z3-ord-parts! 'd)
(dk-type! 'd 'ZZ) (fact 'zz-in-rr 'k) (fact 'rr-zero-in) (fact 'group-identity-in 'g)
