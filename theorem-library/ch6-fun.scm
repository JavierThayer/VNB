;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-prod.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-has-sub? t u) (or (equal? t u) (and (pair? t) (any-pred (lambda (x) (c6-has-sub? x u)) t))))
(define (c6-induct! base step)               ; after (ni): BASE on the base leaf, STEP on the step leaf
  (let* ((ls (dk-open-leaves))
         (step? (lambda (l) (let ((g (dk-goal-of l)))
                              (and (c6-op? g 'FORALL 3) (c6-op? (caddr g) 'IMPLIES 3)
                                   (c6-op? (cadr (caddr g)) 'IN 3) (eq? (caddr (cadr (caddr g))) 'NN)
                                   (eq? (cadr (cadr (caddr g))) (cadr g))
                                   (c6-has-sub? g (list 'succ (cadr g)))))))
         (b (find-first (lambda (l) (not (step? l))) ls))
         (st (find-first step? ls)))
    (if (not (and b st)) (error "c6-induct!: leaves not found" (map dk-goal-of ls)))
    (dk-focus! b) (base)
    (dk-focus! st) (step)))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-succ-var new) (let ((vs (c6-vars new 'NN))) (find-first (lambda (v) (c6-has-sub? (dk-goal) (list 'succ v))) vs)))
(define (c6-mag f) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list f 'c6k_))))
(define (c6-mag-typ! f)                      ; f in FUN(NN, CC): k |-> |f k| in FUN(NN, RR)
  (let ((typ (list 'IN (c6-mag f) '(FUN NN RR))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (fact 'fun-apply-type-c f 'NN 'CC k)
                  (fact 'cc-magnitude-closed (list f k))
                  (dk-ass!)))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-nonneg r) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list r 'c6i_)))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-mag-nonneg! a)                    ; a in FUN(NN, CC): forall i. 0 <= |a|(i)
  (let ((f (c6-nonneg (c6-mag a))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c a 'NN 'CC i) (c6-mag! (list a i)) (dk-lam-b!) (dk-ass!)))))
    f))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6-gs a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list a (list '+ nv 'c6k_)))))
(define (c6-gs-typ! a nv)
  (c6-lam-typ! (c6-gs a nv) 'RR (lambda (k) (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k)
                                  (fact 'fun-apply-type-c a 'NN 'CC (list '+ nv k)) (fact 'cc-magnitude-closed (list a (list '+ nv k))) (dk-ass!))))
(define (c6-slit w) (list 'NOT (list 'AND (list '= (list 'imag-part w) 0) (list '<= (list 'real-part w) 0))))
(define (c6-pow2! x)                           ; (= (power x 2) (* x x)), x in CC
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-two-is-succ-succ-zero) (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
            (c6-and! (list 'IN x 'CC) '(IN (succ 0) NN)) (subst (dk-fact! 'power-succ x '(succ 0)))
            (c6-and! (list 'IN x 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ x 0))
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (c6-pos-rr! q) (if (not (dk-asm? (list 'POS-RR q))) (begin (dk-have! (list 'IN q 'RR) (lambda () (arith))) (dk-have! (list '< 0 q) (lambda () (dk-ineq!))) (c6-cite! 'rr-pos-rr-of-lt q))))
(define (c6-nk! nv k)                         ; nv, k in NN: (+ nv k) in NN, RR, CC and nv <= nv + k
  (let ((j (list '+ nv k)))
    (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k) (c6-nn! nv) (c6-nn! k) (c6-nn! j) (fact 'nn-zero-le k)
    (if (not (dk-asm? (list '<= nv j))) (dk-have! (list '<= nv j) (lambda () (dk-ineq! (list '<= 0 k)))))
    j))
(define (c6-log-typ! z)
  (let ((u (list '+ 1 z)))
    (fact 'cc-one-in) (c6-cc! u)
    (if (not (dk-asm? (list 'IN (list 'CC-LOG u) 'CC))) (dk-split-all! (list (c6-cite! 'cc-log-spec u))))
    (c6-mag! (list 'CC-LOG u))))
(define (c6-csps f n) (list 'CC-SERIES-PARTIAL-SUM f n))
(define (c6-csps-typ! f n) (dk-cite! 'cc-series-partial-sum-in-cc n f) (c6-csps f n))
(define (c6-csps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-csps-typ! f n) (fact 'fun-apply-type-c f 'NN 'CC n)
  (dk-cite! 'cc-series-partial-sum-succ f n))
(define (c6-ppseq f) (list 'VNB-LAMBDA 'c6n_ 'NN (list 'PPROD f 'c6n_)))
(define (c6-famty u f) (list 'IN f (list 'FUN 'NN (list 'FUN u 'CC))))
(define (c6-sn f xs) (list 'VNB-LAMBDA 'cpsi_ 'NN (list 'CC-SUP-NORM (list f 'cpsi_) xs)))
(define (c6-fv! f u k y)                        ; f in FUN(NN, FUN(u, CC)), k in NN, y in u: f_k in FUN(u, CC), f_k(y) in CC
  (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (fact 'fun-apply-type-c (list f k) u 'CC y))
(define (c6-opx f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list (list f 'c6k_) x))))
(define (c6-ppf u f) (list 'VNB-LAMBDA 'c6n_ 'NN (list 'VNB-LAMBDA 'c6x_ u (list 'PPROD (c6-opx f 'c6x_) 'c6n_))))
(define (c6-lam-typ-on! lam u typer f)
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (c6-lam-typ! (c6-opx f x) 'CC (lambda (k) (c6-fv! f u k x) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list (list f k) x)))))
                           (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6-famhol u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'HOLOMORPHIC-ON u (list f 'c6i_)))))
(define (c6-ppx u f n) (list 'VNB-LAMBDA 'c6x_ u (list 'PPROD (c6-opx f 'c6x_) n)))
(define (c6-setu! u)
  (fact 'cc-is-set) (c6-cite! 'cc-open-subset-cc u) (fact 'subclass-of-set-is-set u 'CC))
(define (c6-sn-setup! u f n pn)
  (let* ((kn (list 'CC-EXHAUST u n)) (sn (c6-sn f kn)))
    (dk-have! (list 'IS-NORMALLY-CONVERGENT f kn)
      (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-NORMAL-ON-COMPACTA (dk-ctx-form pn)))))
                 (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-NORMALLY-CONVERGENT))) (dk-asms)) n)
                 (dk-ass!)))
    (dk-split-all! (dk-landed (lambda () (mac-h 'IS-NORMALLY-CONVERGENT (list 'IS-NORMALLY-CONVERGENT f kn)))))
    (c6-cite! 'cc-exhaust-subset u n)
    (let* ((snr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SUP-NORM) (dk-contains? q kn) (not (dk-contains? q 'SERIES-CONVERGES)))) (dk-asms)))
           (kty! (lambda (k)
                   (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y kn) (list 'IN (list (list f k) 'y) 'CC)))
                     (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kn u y) (c6-fv! f u k y) (dk-ass!))))))
           (up! (lambda (k x)
                  (fact 'subset-mem-fwd kn u x) (c6-fv! f u k x) (c6-mag! (list (list f k) x))
                  (kty! k) (dk-apply! snr k)
                  (dk-apply! (c6-cite! 'cc-sup-norm-upper (list f k) kn) x))))
      (c6-lam-typ! sn 'RR (lambda (k) (dk-apply! snr k) (dk-ass!)))
      (dk-have! (c6-nonneg sn)
        (lambda () (let* ((k (dk-di-var!)) (snk (list 'CC-SUP-NORM (list f k) kn)))
                     (dk-lam-b!) (dk-apply! snr k) (kty! k)
                     (let ((ab (list 'abs snk)))
                       (fact 'rr-abs-closed snk) (c6-cite! 'rr-abs-nonneg snk) (c6-rr! (list '- snk)) (fact 'rr-abs-closed (list '- snk))
                       (c6-cite! 'rr-neg-abs-le (list '- snk))
                       (dk-have! (list '<= snk ab) (lambda () (c6-cite! 'rr-abs-neg snk) (dk-ineq! (dk-ctx-form (list '<= (list '- (list 'abs (list '- snk))) (list '- snk))) (list '= (list 'abs (list '- snk)) ab))))
                       (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) (list '<= (list 'magnitude (list (list f k) 'cpsx_)) ab)))
                         (lambda () (let ((x (dk-di-var!))) (up! k x) (dk-ineq! (list '<= (list 'magnitude (list (list f k) x)) snk) (list '<= snk ab)))))
                       (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound (list f k) kn ab)))
                       (dk-ass!)))))
      (list sn snr up!))))
;;; ---- end of copied helpers ----

(define (c6f-famcont u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'IN (list f 'c6i_) (list 'CC-CONT-FNS u)))))
(define (c6f-setu! u) (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-cont-of! h u)                     ; h in CC-CONT-FNS(u) in context: lands h in FUN(u, CC) and its continuity
  (let* ((iff (c6-cite! 'cc-cont-fns-membership u h)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-have! rhs (lambda () (keep iff (cadr iff)) (prop))))
    (dk-split-all! (list (dk-ctx-form rhs)))))
(define (c6f-cont-close! h u)                  ; goal (IN h (CC-CONT-FNS u)); h in FUN(u, CC) and its continuity in context
  (let* ((iff (c6-cite! 'cc-cont-fns-membership u h)) (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (keep iff rhs) (prop)))
(define (c6f-ptw u h rhs-of)                   ; forall y in u. h(y) == RHS(y)
  (list 'FORALL 'c6y_ (list 'IMPLIES (list 'IN 'c6y_ u) (list '== (list h 'c6y_) (rhs-of 'c6y_)))))

;;; the partial products of continuous factors are continuous
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6u_ (list 'IMPLIES '(SUBSET c6u_ CC)
  (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_) (list 'IMPLIES (c6f-famcont 'c6u_ 'c6f_)
    (list 'IN (c6-ppx 'c6u_ 'c6f_ 'c6n_) '(CC-CONT-FNS c6u_)))))))))))
(define (c6f-ppx-typ! u f n)
  (c6f-typ-on! (c6-ppx u f n) u
    (lambda (x) (c6-lam-typ! (c6-opx f x) 'CC (lambda (k) (c6-fv! f u k x) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list (list f k) x)))))
                (dk-cite! 'pprod-in-cc n (c6-opx f x)))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (u (cadr (find-first (lambda (q) (dk-head-is? q 'SUBSET)) new)))
           (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
           (pp (c6-ppx u f 0)))
      (c6f-setu! u) (fact 'cc-one-in) (fact 'nn-zero-in)
      (c6f-ppx-typ! u f 0)
      (dk-have! (c6f-ptw u pp (lambda (y) 1))
        (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (dk-cite! 'pprod-zero (c6-opx f x)) (dk-ass!))))
      (c6-cite! 'aif-cont-const u 1 pp)
      (c6f-cont-close! pp u)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (u (cadr (find-first (lambda (q) (dk-head-is? q 'SUBSET)) new)))
           (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (fh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-CONT-FNS) (not (dk-contains? q 'PPROD)))) new))
           (p0 (c6-ppx u f n)) (p1 (c6-ppx u f (list 'succ n)))
           (fn (list f n))
           (one (list 'VNB-LAMBDA 'c6x_ u 1))
           (g1 (list 'VNB-LAMBDA 'c6x_ u (list '+ 1 (list fn 'c6x_)))))
      (c6f-setu! u) (fact 'cc-one-in) (fact 'nn-succ-closed n)
      (dk-apply! ih u f) (dk-apply! fh n)
      (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) n)
      (c6f-cont-of! p0 u) (c6f-cont-of! fn u)
      ;; the constant 1
      (c6f-typ-on! one u (lambda (x) (fact 'cc-one-in)))
      (dk-have! (c6f-ptw u one (lambda (y) 1)) (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6-cite! 'aif-cont-const u 1 one)
      ;; the factor 1 + f_n
      (c6f-typ-on! g1 u (lambda (x) (fact 'fun-apply-type-c fn u 'CC x) (c6-cc! (list '+ 1 (list fn x)))))
      (dk-have! (c6f-ptw u g1 (lambda (y) (list '+ (list one y) (list fn y))))
        (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6-cite! 'aif-cont-sum u one fn g1)
      ;; the product
      (c6f-ppx-typ! u f (list 'succ n))
      (dk-have! (c6f-ptw u p1 (lambda (y) (list '* (list p0 y) (list g1 y))))
        (lambda ()
          (let* ((x (dk-di-var!)) (ox (c6-opx f x)))
            (c6-fv! f u n x)
            (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
            (dk-lam-b!)
            (subst (dk-cite! 'pprod-succ ox n))
            (dk-lam-b!)
            (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6-cite! 'aif-cont-product u p0 g1 p1)
      (c6f-cont-close! p1 u))))
(qed 'ppx-continuous)

;;; PROPOSITION 6.12, the continuity half: for continuous f_k, x |-> prod_k (1 + f_k(x)) is continuous on u
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6f-famcont 'c6u_ 'c6f_) (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    '(IN (PROD-FUN c6u_ c6f_) (CC-CONT-FNS c6u_))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (pf (list 'PROD-FUN u f)) (pp (c6-ppf u f)))
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN c6-nfm u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (c6-setu! u) (fact 'cc-one-in) (fact 'nn-is-set) (fact 'cc-is-metric-space)
  (dk-split-all! (list (c6-cite! 'prop-6-12 u f)))
  (c6-cite! 'cc-cont-fns-is-set u)
  (dk-have! (list 'IN pp (list 'FUN 'NN (list 'CC-CONT-FNS u)))
    (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                          (c6-cite! 'ppx-continuous k u f)
                                          (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                             (lambda () (dk-ass!)))))
  (dk-have! (list 'FORALL 'c6z_ (list 'IMPLIES (list 'IN 'c6z_ u) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS c6-nfm u) c6-nfm pf 'c6z_)))
    (lambda ()
      (let* ((x0 (dk-di-var!))
             (n (begin (fact 'subset-mem-fwd u 'CC x0) (c6-sk! (c6-cite! 'cc-exhaust-covers u x0))))
             (m (list '+ (list '* 4 n) 3)) (km (list 'CC-EXHAUST u m))
             (rho (list '* 1/2 (list 'recip (list '+ n 1))))
             (ball (list 'BALL 'CC-MS x0 rho)))
        (c6-nn! n)
        (dk-have! (list 'IN m 'NN) (lambda () (type-term)))
        (c6-cite! 'cc-exhaust-ball-inside u n x0)
        (c6-cite! 'cc-exhaust-subset u m)
        (dk-have! (list 'SUBSET ball u) (lambda () (c6-cite! 'subset-trans ball km u) (dk-ass!)))
        (c6-rr! (list '+ n 1))
        (dk-have! (list '< 0 (list '+ n 1)) (lambda () (fact 'nn-zero-le n) (dk-ineq! (list '<= 0 n))))
        (c6-cite! 'rr-recip-pos (list '+ n 1)) (c6-cite! 'rr-pos-ne-zero (list '+ n 1))
        (c6-and! (list 'IN (list '+ n 1) 'RR) (list 'NOT (list '= (list '+ n 1) 0))) (fact 'rr-recip-closed (list '+ n 1))
        (c6-rr! rho)
        (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '< 0 (list 'recip (list '+ n 1))))))
        (let* ((lk (dk-cite! 'cc-uniform-limit-continuous-at u pp pf x0 rho)) (hyp (cadr lk)))
          (if (not (and (c6-op? lk 'IMPLIES 3) (c6-op? hyp 'FORALL 3))) (error "c6f: unexpected link" (expression->string lk)))
          (dk-have! hyp
            (lambda ()
              (let* ((nw (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) nw)))
                     (cap (c6-sk! (dk-apply! (c6-cite! 'prop-6-12-estimate u f) m eps)))
                     (eu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q cap) (dk-contains? q 'PROD-VALUE))) (dk-asms))))
                (ew cap)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (dk-ass!)
                      (let* ((nk (c6-steps!)) (j (c6-var nk 'NN))
                             (z (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'BALL 4))) nk)))
                             (ox (c6-opx f z)))
                        (fact 'subset-mem-fwd ball km z) (fact 'subset-mem-fwd km u z)
                        (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k z) (c6-cc! (list '+ 1 (list (list f k) z)))))
                        (dk-split-all! (list (c6-cite! 'prop-6-11 u f z)))
                        (dk-split-all! (list (c6-cite! 'prod-value-spec ox)))
                        (mac 'PROD-FUN)
                        (dk-lam-b!)
                        (dk-apply! eu j z)
                        (dk-ass!))))))))
          (c6-cite! 'cc-uniform-limit-continuous-at u pp pf x0 rho)
          (dk-ass!)))))
  (c6f-cont-close! pf u))
(qed 'prop-6-12-continuous)

;;; ---------------------------------------------------------------- 6.14 and 6.16
(define (c6f-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (c6f-lbh! f) (if (dk--redex? f) (dk-lam-b-h! f)))
(define (c6f-rr-sub-cc!)
  (if (not (dk-asm? '(SUBSET RR CC)))
      (let ((iff (dk-cite! 'subset-def 'RR 'CC)))
        (dk-have! (caddr iff) (lambda () (let ((x (dk-di-var!))) (fact 'rr-subset-cc x) (dk-ass!))))
        (dk-have! '(SUBSET RR CC) (lambda () (keep iff (caddr iff)) (prop))))))
(define (c6f-mag-id! x)                        ; x in RR, 0 <= x in context: lands |x| = x
  (let ((e (list '= (list 'magnitude x) x)))
    (if (not (dk-asm? e))
        (begin (fact 'rr-subset-cc x) (c6-mag! x)
               (c6-cite! 'rr-magnitude-is-abs x) (c6-cite! 'rr-abs-of-nonneg x)
               (dk-have! e (lambda () (subst (list '= (list 'magnitude x) (list 'abs x))) (dk-ass!)))))
    e))
(define (c6f-tl-eq tv gv nv) (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list tv 'c6j_) (list gv (list '+ nv 'c6j_))))))
(define (c6f-tl-setup! new)                    ; the landed m, g, t of the two shift lemmas
  (let* ((eqh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '=))) new))
         (eqb (caddr (caddr eqh)))
         (t (car (cadr eqb))) (g (car (caddr eqb))) (nv (cadr (cadr (caddr eqb)))))
    (list nv g t eqh)))

;;; a real series of nonnegative terms: if it converges, so does each tail t(k) = g(N + k)
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN RR)) (list 'IMPLIES (c6-nonneg 'c6g_)
  (list 'FORALL 'c6t_ (list 'IMPLIES '(IN c6t_ (FUN NN RR)) (list 'IMPLIES (c6f-tl-eq 'c6t_ 'c6g_ 'c6m_)
    (list 'IMPLIES '(SERIES-CONVERGES c6g_) '(SERIES-CONVERGES c6t_))))))))))))
(define (c6f-shift-body! dir)
  (let* ((new (c6-steps!)) (st (c6f-tl-setup! new)) (nv (car st)) (g (cadr st)) (t (caddr st)) (eqh (cadddr st))
         (nnh (dk-ctx-form (c6-nonneg g))) (gs (c6-gs g nv)) (mg (c6-mag g))
         (pt! (lambda (j) (fact 'fun-apply-type-c g 'NN 'RR j) (dk-apply! nnh j) (c6f-mag-id! (list g j)))))
    (c6f-rr-sub-cc!) (fact 'fun-codomain-superset g 'NN 'RR 'CC) (fact 'rr-zero-in) (fact 'nn-zero-in)
    (c6-mag-typ! g) (c6-mag-nonneg! g) (c6-gs-typ! g nv)
    (dk-have! (c6-nonneg gs) (lambda () (let* ((i (dk-di-var!)) (j (c6-nk! nv i))) (pt! j) (dk-lam-b!) (dk-ineq! (list '<= 0 (list g j)) (list '= (list 'magnitude (list g j)) (list g j))))))
    (dk-have! (c6-nonneg t) (lambda () (let* ((i (dk-di-var!)) (j (c6-nk! nv i))) (pt! j) (dk-apply! eqh i) (fact 'fun-apply-type-c t 'NN 'RR i)
                                          (dk-ineq! (list '<= 0 (list g j)) (list '= (list t i) (list g j))))))
    (if (eq? dir 'tail)
        (begin
          (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list mg 'c6j_) (list g 'c6j_)))))
            (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN))) (pt! k) (dk-lam-b!) (dk-ineq! (list '= (list 'magnitude (list g k)) (list g k))))))
          (c6-cite! 'series-eventually-dominated-converges mg g 0)
          (c6-cite! 'series-shift-abs-converges nv g)
          (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list t 'c6j_) (list gs 'c6j_)))))
            (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (j (c6-nk! nv k))) (pt! j) (dk-apply! eqh k) (fact 'fun-apply-type-c t 'NN 'RR k) (dk-lam-b!)
                         (dk-ineq! (list '= (list t k) (list g j)) (list '= (list 'magnitude (list g j)) (list g j))))))
          (c6-cite! 'series-eventually-dominated-converges t gs 0)
          (dk-ass!))
        (begin
          (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list gs 'c6j_) (list t 'c6j_)))))
            (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (j (c6-nk! nv k))) (pt! j) (dk-apply! eqh k) (fact 'fun-apply-type-c t 'NN 'RR k) (dk-lam-b!)
                         (dk-ineq! (list '= (list t k) (list g j)) (list '= (list 'magnitude (list g j)) (list g j))))))
          (c6-cite! 'series-eventually-dominated-converges gs t 0)
          (c6-cite! 'series-unshift-abs-converges nv g)
          (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list g 'c6j_) (list mg 'c6j_)))))
            (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN))) (pt! k) (dk-lam-b!) (dk-ineq! (list '= (list 'magnitude (list g k)) (list g k))))))
          (c6-cite! 'series-eventually-dominated-converges g mg 0)
          (dk-ass!)))))
(c6f-shift-body! 'tail)
(qed 'rseries-tail-converges)

;;; and back: if a tail t(k) = g(N + k) converges, so does the series
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN RR)) (list 'IMPLIES (c6-nonneg 'c6g_)
  (list 'FORALL 'c6t_ (list 'IMPLIES '(IN c6t_ (FUN NN RR)) (list 'IMPLIES (c6f-tl-eq 'c6t_ 'c6g_ 'c6m_)
    (list 'IMPLIES '(SERIES-CONVERGES c6t_) '(SERIES-CONVERGES c6g_))))))))))))
(c6f-shift-body! 'untail)
(qed 'rseries-untail-converges)

;;; |z| <= 2 |log(1 + z)| when 1 + z is in dom log and |log(1 + z)| <= 1/2
(sp (make-wff (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list 'IMPLIES (c6-slit '(+ 1 c6z_))
  '(IMPLIES (<= (magnitude (CC-LOG (+ 1 c6z_))) 1/2) (<= (magnitude c6z_) (* 2 (magnitude (CC-LOG (+ 1 c6z_)))))))))))
(let* ((new (c6-steps!)) (aj (c6-var new 'CC)) (u (list '+ 1 aj)) (w (list 'CC-LOG u)) (mw (list 'magnitude w)) (aw (list '- aj w)))
  (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
  (c6-mag! aj) (c6-log-typ! aj)
  (dk-have! (list '<= mw 1) (lambda () (dk-ineq! (list '<= mw 1/2))))
  (c6-cc! aw) (c6-mag! aw)
  (let* ((ne (c6-cite! 'cc-exp-near-one w))
         (p2 (begin (fact 'rr-subset-cc mw) (c6-pow2! mw)))
         (e1 (begin (dk-have! (list '= (list '- (list '- u 1) w) aw) (lambda () (crs))) #t))
         (ne2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! ne (list 'CC-EXP w) u) (list '- (list '- u 1) w) aw) (list 'power mw 2) (list '* mw mw)))
         (k1 (c6-cite! 'rr-mul-le-right mw 1/2 mw))
         (t4 (begin (c6-and! (list 'IN w 'CC) (list 'IN aw 'CC)) (dk-fact! 'cc-magnitude-triangle w aw)))
         (t4b (begin (dk-have! (list '= (list '+ w aw) aj) (lambda () (crs))) (dk-rewrite-h! t4 (list '+ w aw) aj))))
    (c6-ineq*! t4b ne2 k1 (list '<= 0 mw))))
(qed 'cc-log-one-plus-lower)

;;; 0 <= ||g||_xs once the sup norm is real (g(y) in CC on xs in context)
(define (c6f-sup0! g xs)
  (let* ((snk (list 'CC-SUP-NORM g xs)) (ab (list 'abs snk)) (z (list '<= 0 snk)))
    (if (not (dk-asm? z))
        (let ((upper (c6-cite! 'cc-sup-norm-upper g xs)))
          (fact 'rr-abs-closed snk) (c6-cite! 'rr-abs-nonneg snk) (c6-rr! (list '- snk)) (fact 'rr-abs-closed (list '- snk))
          (c6-cite! 'rr-neg-abs-le (list '- snk))
          (dk-have! (list '<= snk ab) (lambda () (c6-cite! 'rr-abs-neg snk) (dk-ineq! (dk-ctx-form (list '<= (list '- (list 'abs (list '- snk))) (list '- snk))) (list '= (list 'abs (list '- snk)) ab))))
          (dk-have! (list 'FORALL 'c6sx_ (list 'IMPLIES (list 'IN 'c6sx_ xs) (list '<= (list 'magnitude (list g 'c6sx_)) ab)))
            (lambda () (let* ((x (dk-di-var!)) (ty (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q xs) (not (dk-contains? q 'magnitude)) (dk-contains? q g))) (dk-asms))))
                         (dk-apply! ty x) (c6-mag! (list g x))
                         (dk-ineq! (dk-apply! upper x) (list '<= snk ab)))))
          (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound g xs ab)))))
    z))
;;; c6-log-typ! without type-term (which gives up in a deep context): z in CC and the slit guard of 1 + z in context
(define (c6f-log-typ! z)
  (let ((u (list '+ 1 z)))
    (fact 'cc-one-in)
    (if (not (dk-asm? (list 'IN u 'CC))) (begin (c6-and! '(IN 1 CC) (list 'IN z 'CC)) (fact 'cc-add-closed 1 z)))
    (if (not (dk-asm? (list 'IN (list 'CC-LOG u) 'CC))) (dk-split-all! (list (c6-cite! 'cc-log-spec u))))
    (c6-mag! (list 'CC-LOG u))))
(define (c6f-kx u n) (list 'CC-EXHAUST u n))
(define (c6f-lk u f n j) (list 'VNB-LAMBDA 'c6x_ (c6f-kx u n) (list 'CC-LOG (list '+ 1 (list (list f j) 'c6x_)))))   ; x |-> log(1 + f_j(x)) on K_n
(define (c6f-lgf u f n nv) (list 'VNB-LAMBDA 'c6k_ 'NN (c6f-lk u f n (list '+ nv 'c6k_))))
(define (c6f-guardk u f n nv)
  (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES (list '<= nv 'c6q_)
    (list 'FORALL 'c6w_ (list 'IMPLIES (list 'IN 'c6w_ (c6f-kx u n)) (c6-slit (list '+ 1 (list (list f 'c6q_) 'c6w_)))))))))
(define (c6f-logside u f)
  (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'AND (c6f-guardk u f 'c6n_ 'c6m_)
      (list 'IS-NORMALLY-CONVERGENT (c6f-lgf u f 'c6n_ 'c6m_) (c6f-kx u 'c6n_))))))))
(define (c6f-t2 f kn nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'CC-SUP-NORM (list f (list '+ nv 'c6k_)) kn)))
(define (c6f-h1 f kn nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* 2 (list 'CC-SUP-NORM (list f (list '+ nv 'c6k_)) kn))))
(define (c6f-h2 u f n nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* 2 (list 'CC-SUP-NORM (c6f-lk u f n (list '+ nv 'c6k_)) (c6f-kx u n)))))
(define (c6f-pick-u new) (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
(define (c6f-pick-f new) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN) (c6-op? (caddr (caddr q)) 'FUN 3))) new)))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-lb-close!) (dk-close-if! (lambda () (c6f-lb!)) (lambda () (dk-ass!))))

;;; 6.14, (1) => (2) on one K_n: sum ||f_k||_{K_n} < oo gives an N with 1 + f_k(x) in dom log for k >= N, x in K_n,
;;; and sum_k ||log(1 + f_{N+k})||_{K_n} < oo
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'IMPLIES '(IS-NORMALLY-CONVERGENT c6f_ (CC-EXHAUST c6u_ c6n_))
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'AND (c6f-guardk 'c6u_ 'c6f_ 'c6n_ 'c6m_)
      (list 'IS-NORMALLY-CONVERGENT (c6f-lgf 'c6u_ 'c6f_ 'c6n_ 'c6m_) '(CC-EXHAUST c6u_ c6n_))))))))))))))
(let* ((new (c6-steps!)) (u (c6f-pick-u new)) (f (c6f-pick-f new)) (n (c6-var new 'NN)) (kn (c6f-kx u n))
       (st (c6-sn-setup! u f n #f)) (sn (car st)) (snr (cadr st)) (up! (caddr st)) (snn (dk-ctx-form (c6-nonneg sn))))
  (fact 'rr-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (c6-pos-rr! 1/10)
  (let* ((mv (c6-sk! (dk-apply! (c6-cite! 'nonneg-series-terms-small sn) 1/10)))
         (sm (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q mv) (dk-contains? q 1/10))) (dk-asms)))
         (small! (lambda (j) (let ((r (list '<= (list 'CC-SUP-NORM (list f j) kn) 1/10))) (if (not (dk-asm? r)) (c6f-lbh! (dk-apply! sm j))) r)))
         (sn0! (lambda (j) (let ((r (list '<= 0 (list 'CC-SUP-NORM (list f j) kn)))) (if (not (dk-asm? r)) (c6f-lbh! (dk-apply! snn j))) r)))
         (ptx! (lambda (j x)
                 (let* ((u1 (up! j x)) (s1 (small! j)) (fx (list (list f j) x)))
                   (dk-have! (list '<= (list 'magnitude fx) 1/10) (lambda () (dk-ineq! u1 s1)))
                   (dk-split-all! (list (c6-cite! 'cc-log-one-plus-near-zero fx)))
                   (c6-log-typ! fx)
                   u1)))
         (bnd! (lambda (k)                      ; ||x |-> log(1 + f_{M+k}(x))||_{K_n} is real, >= 0, <= 2 ||f_{M+k}||
                 (let* ((j (c6-nk! mv k)) (lk (c6f-lk u f n j)) (snj (list 'CC-SUP-NORM (list f j) kn)) (b2 (list '* 2 snj)))
                   (if (not (dk-asm? (list '<= (list 'CC-SUP-NORM lk kn) b2)))
                       (begin
                         (dk-apply! snr j) (c6-rr! b2) (small! j) (sn0! j)
                         (dk-have! (list '<= 0 b2) (lambda () (dk-ineq! (list '<= 0 snj))))
                         (dk-have! (list 'FORALL 'c6v_ (list 'IMPLIES (list 'IN 'c6v_ kn) (list 'IN (list lk 'c6v_) 'CC)))
                           (lambda () (let ((x (dk-di-var!))) (ptx! j x) (dk-lam-b!) (dk-ass!))))
                         (dk-have! (list 'FORALL 'c6v_ (list 'IMPLIES (list 'IN 'c6v_ kn) (list '<= (list 'magnitude (list lk 'c6v_)) b2)))
                           (lambda () (let* ((x (dk-di-var!)) (u1 (ptx! j x)) (fx (list (list f j) x)))
                                        (dk-lam-b!)
                                        (dk-ineq! u1 (list '<= (list 'magnitude (list 'CC-LOG (list '+ 1 fx))) (list '* 2 (list 'magnitude fx)))))))
                         (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound lk kn b2)))))
                   (list j lk snj)))))
    (c6-nn! mv)
    (ew mv)
    (dk-conj-close!
      (lambda ()
        (cond
         ((dk-asm? (dk-goal)) (dk-ass!))
         ((dk-head-is? (dk-goal) 'FORALL)          ; the dom-log guard
          (let* ((nq (c6-steps!)) (q (c6-var nq 'NN)) (w (cadr (find-first (lambda (x) (and (c6-op? x 'IN 3) (equal? (caddr x) kn))) nq))))
            (ptx! q w) (dk-ass!)))
         (#t                                       ; IS-NORMALLY-CONVERGENT of the logs
          (mac 'IS-NORMALLY-CONVERGENT)
          (let* ((sg (cadr (caddr (dk-goal)))) (t2 (c6f-t2 f kn mv)) (h2 (c6f-h1 f kn mv)))
            (c6-lam-typ! sg 'RR (lambda (k) (c6f-lb!) (bnd! k)))
            (dk-have! (c6-nonneg sg) (lambda () (let ((k (dk-di-var!))) (c6f-lb!) (bnd! k) (dk-ass!))))
            (c6-lam-typ! t2 'RR (lambda (k) (let ((j (c6-nk! mv k))) (dk-apply! snr j))))
            (c6-lam-typ! h2 'RR (lambda (k) (let ((j (c6-nk! mv k))) (dk-apply! snr j) (c6-rr! (list '* 2 (list 'CC-SUP-NORM (list f j) kn))))))
            (dk-have! (c6-nonneg t2) (lambda () (let* ((k (dk-di-var!)) (j (c6-nk! mv k))) (c6f-lb!) (sn0! j) (dk-ass!))))
            (dk-have! (c6f-tl-eq t2 sn mv) (lambda () (let* ((k (dk-di-var!)) (j (c6-nk! mv k))) (dk-apply! snr j) (c6f-lb!) (c6f-rfl-close!))))
            (c6-cite! 'rseries-tail-converges mv sn t2)
            (dk-have! '(IN 2 RR) (lambda () (arith))) (dk-have! '(<= 0 2) (lambda () (arith)))
            (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list h2 'c6j_) (list '* 2 (list t2 'c6j_)))))
              (lambda () (let* ((k (dk-di-var!)) (r (bnd! k))) (dk-apply! snr (car r)) (c6-rr! (list '* 2 (caddr r))) (c6f-lb!) (c6f-rfl-close!))))
            (c6-cite! 'series-scale-converges t2 2 h2)
            (dk-have! (c6-nonneg h2) (lambda () (let* ((k (dk-di-var!)) (r (bnd! k))) (c6f-lb!) (dk-ass!))))
            (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list sg 'c6j_) (list h2 'c6j_)))))
              (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN))) (bnd! k) (c6f-lb!) (dk-ass!))))
            (c6-cite! 'series-eventually-dominated-converges sg h2 0)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                  (let ((k (dk-di-var!))) (c6f-lb!) (bnd! k) (dk-ass!))))))))))))
(qed 'prop-6-14-forward)

;;; 6.14, (2) => (1) on one K_n, for continuous f_k: the guard from N on and sum_k ||log(1 + f_{N+k})||_{K_n} < oo
;;; give sum_k ||f_k||_{K_n} < oo (the first N sup norms are finite by continuity on the compact K_n)
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6f-famcont 'c6u_ 'c6f_)
  (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN)
    (list 'IMPLIES (c6f-guardk 'c6u_ 'c6f_ 'c6n_ 'c6m_)
      (list 'IMPLIES (list 'IS-NORMALLY-CONVERGENT (c6f-lgf 'c6u_ 'c6f_ 'c6n_ 'c6m_) '(CC-EXHAUST c6u_ c6n_))
        '(IS-NORMALLY-CONVERGENT c6f_ (CC-EXHAUST c6u_ c6n_)))))))))))))))
(let* ((new (c6-steps!)) (u (c6f-pick-u new)) (f (c6f-pick-f new))
       (gd (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'imag-part))) new))
       (fc (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-CONT-FNS))) new))
       (lgh (find-first (lambda (q) (dk-head-is? q 'IS-NORMALLY-CONVERGENT)) new))
       (kn (caddr lgh)) (n (caddr kn)) (mv (cadr (cadr (caddr (caddr gd))))))
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN c6-nfm u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (c6-setu! u) (c6-cite! 'cc-exhaust-subset u n)
  (fact 'rr-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (fact 'rr-one-in)
  (dk-split-all! (dk-landed (lambda () (mac-h 'IS-NORMALLY-CONVERGENT lgh))))
  (let* ((sc (find-first (lambda (q) (and (dk-head-is? q 'SERIES-CONVERGES) (dk-contains? q 'CC-LOG))) (dk-asms)))
         (sg (cadr sc))
         (sr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-LOG) (dk-contains? q 'CC-SUP-NORM) (not (dk-contains? q 'SERIES-CONVERGES)))) (dk-asms)))
         (sn (c6-sn f kn)) (t2 (c6f-t2 f kn mv)) (h2 (c6f-h2 u f n mv))
         (real! (lambda (i)                    ; ||f_i||_{K_n} real and >= 0, by continuity
                  (let ((r (list 'IN (list 'CC-SUP-NORM (list f i) kn) 'RR)))
                    (if (not (dk-asm? r))
                        (begin (dk-apply! fc i) (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) i)
                               (c6f-cont-of! (list f i) u)
                               (dk-split-all! (list (c6-cite! 'cc-exhaust-seminorm-real u (list f i) n))))))))
         (ptx! (lambda (j x)                   ; j >= M, x in K_n: f_j(x) in CC, the guard, log(1 + f_j(x)) in CC
                 (fact 'subset-mem-fwd kn u x) (c6-fv! f u j x)
                 (dk-apply! gd j x) (c6f-log-typ! (list (list f j) x))))
         (lty! (lambda (k)                     ; x |-> log(1 + f_{M+k}(x)): values in CC on K_n, sup norm real and >= 0
                 (let* ((j (c6-nk! mv k)) (lk (c6f-lk u f n j)) (ty (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y kn) (list 'IN (list lk 'y) 'CC)))))
                   (if (not (dk-asm? ty))
                       (dk-have! ty (lambda () (let ((x (dk-di-var!))) (ptx! j x) (dk-lam-b!) (dk-ass!)))))
                   (if (not (dk-asm? (list 'IN (list 'CC-SUP-NORM lk kn) 'RR))) (c6f-lbh! (dk-apply! sr k)))
                   (c6f-sup0! lk kn)
                   (list j lk)))))
    (c6-lam-typ! sg 'RR (lambda (k) (lty! k) (c6f-lb-close!)))
    (dk-have! (c6-nonneg sg) (lambda () (let ((k (dk-di-var!))) (lty! k) (c6f-lb-close!))))
    (c6-pos-rr! 1/2)
    (let* ((m2 (c6-sk! (dk-apply! (c6-cite! 'nonneg-series-terms-small sg) 1/2)))
           (sm (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q m2) (dk-contains? q 1/2))) (dk-asms))))
      (c6-nn! m2)
      (c6-lam-typ! sn 'RR (lambda (i) (real! i)))
      (dk-have! (c6-nonneg sn) (lambda () (let ((i (dk-di-var!))) (real! i) (c6f-lb-close!))))
      (c6-lam-typ! t2 'RR (lambda (k) (let ((j (c6-nk! mv k))) (real! j))))
      (dk-have! (c6-nonneg t2) (lambda () (let* ((k (dk-di-var!)) (j (c6-nk! mv k))) (real! j) (c6f-lb-close!))))
      (c6-lam-typ! h2 'RR (lambda (k) (let ((r (lty! k))) (c6-rr! (list '* 2 (list 'CC-SUP-NORM (cadr r) kn))))))
      (dk-have! (c6-nonneg h2) (lambda () (let* ((k (dk-di-var!)) (r (lty! k))) (c6f-lb!) (dk-ineq! (list '<= 0 (list 'CC-SUP-NORM (cadr r) kn))))))
      (dk-have! '(IN 2 RR) (lambda () (arith))) (dk-have! '(<= 0 2) (lambda () (arith)))
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list h2 'c6j_) (list '* 2 (list sg 'c6j_)))))
        (lambda () (let* ((k (dk-di-var!)) (r (lty! k))) (c6-rr! (list '* 2 (list 'CC-SUP-NORM (cadr r) kn))) (c6f-lb!) (c6f-rfl-close!))))
      (c6-cite! 'series-scale-converges sg 2 h2)
      ;; ||f_{M+k}|| <= 2 ||log(1 + f_{M+k})|| once the latter is <= 1/2
      (dk-have! (list 'FORALL 'c6dj_ (list 'IMPLIES '(IN c6dj_ NN) (list 'IMPLIES (list '<= m2 'c6dj_) (list '<= (list t2 'c6dj_) (list h2 'c6dj_)))))
        (lambda ()
          (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (r (lty! k)) (j (car r)) (lk (cadr r))
                 (slk (list 'CC-SUP-NORM lk kn)) (b2 (list '* 2 slk))
                 (s1 (begin (c6f-lbh! (dk-apply! sm k)) (list '<= slk 1/2)))
                 (upper (c6-cite! 'cc-sup-norm-upper lk kn)))
            (real! j) (c6-rr! b2)
            (dk-have! (list '<= 0 b2) (lambda () (dk-ineq! (list '<= 0 slk))))
            (dk-have! (list 'FORALL 'c6bx_ (list 'IMPLIES (list 'IN 'c6bx_ kn) (list 'IN (list (list f j) 'c6bx_) 'CC)))
              (lambda () (let ((x (dk-di-var!))) (dk-close-if! (lambda () (fact 'subset-mem-fwd kn u x) (c6-fv! f u j x)) (lambda () (dk-ass!))))))
            (dk-have! (list 'FORALL 'c6bx_ (list 'IMPLIES (list 'IN 'c6bx_ kn) (list '<= (list 'magnitude (list (list f j) 'c6bx_)) b2)))
              (lambda ()
                (let* ((x (dk-di-var!)) (fx (list (list f j) x)) (lg (list 'magnitude (list 'CC-LOG (list '+ 1 fx)))))
                  (ptx! j x) (c6-mag! fx)
                  (let ((u1 (dk-apply! upper x)))
                    (c6f-lbh! u1)
                    (dk-have! (list '<= lg 1/2) (lambda () (dk-ineq! (list '<= lg slk) s1)))
                    (dk-ineq! (c6-cite! 'cc-log-one-plus-lower fx) (list '<= lg slk))))))
            (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound (list f j) kn b2)))
            (c6f-lb-close!))))
      (c6-cite! 'series-eventually-dominated-converges t2 h2 m2)
      (dk-have! (c6f-tl-eq t2 sn mv) (lambda () (let* ((k (dk-di-var!)) (j (c6-nk! mv k))) (real! j) (c6f-lb!) (c6f-rfl-close!))))
      (c6-cite! 'rseries-untail-converges mv sn t2)
      (mac 'IS-NORMALLY-CONVERGENT)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let ((i (dk-di-var!))) (dk-close-if! (lambda () (real! i)) (lambda () (dk-ass!))))))))))
(qed 'prop-6-14-backward)

;;; PROPOSITION 6.14 (X an open u, compact sets read on the exhaustion K_n, f_k continuous): sum f_k is normally
;;; convergent on compact sets iff for every K_n there is an N with 1 + f_k(x) in dom log for k >= N and x in K_n,
;;; and sum_{k >= N} ||log(1 + f_k)||_{K_n} < oo
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6f-famcont 'c6u_ 'c6f_)
    (list 'IFF '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_) (c6f-logside 'c6u_ 'c6f_)))))))))
(let* ((new (c6-steps!)) (u (c6f-pick-u new)) (f (c6f-pick-f new)))
  (dk-iff! (dk-head? 'FORALL)
    (lambda ()
      (let* ((pn (find-first (lambda (q) (dk-head-is? q 'PROD-NORMAL-ON-COMPACTA)) (dk-asms))) (n (dk-di-var!)))
        (dk-have! (list 'IS-NORMALLY-CONVERGENT f (c6f-kx u n))
          (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-NORMAL-ON-COMPACTA pn))))
                     (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-NORMALLY-CONVERGENT))) (dk-asms)) n)
                     (dk-ass!)))
        (c6-cite! 'prop-6-14-forward u f n)
        (dk-ass!)))
    (lambda ()
      (let ((ls (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-LOG))) (dk-asms))))
        (mac 'PROD-NORMAL-ON-COMPACTA)
        (let* ((n (dk-di-var!)) (mv (c6-sk! (dk-apply! ls n))))
          (c6-cite! 'prop-6-14-backward u f n mv)
          (dk-ass!))))))
(qed 'prop-6-14)

;;; COROLLARY 6.16 (factors written 1 + f_k, f_k continuous): if for every K_n the factors are eventually in dom log
;;; on K_n with sum_{k >= N} ||log(1 + f_k)||_{K_n} < oo, the product is normally convergent on compact subsets
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6f-famcont 'c6u_ 'c6f_)
    (list 'IMPLIES (c6f-logside 'c6u_ 'c6f_) '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)))))))))
(let* ((new (c6-steps!)) (u (c6f-pick-u new)) (f (c6f-pick-f new)) (iff (c6-cite! 'prop-6-14 u f)))
  (keep iff (c6f-logside u f)) (prop))
(qed 'corollary-6-16)

;;; ---------------------------------------------------------------- limits of quotients (for 6.17)
(define (c6f-conv-split! cv s)                 ; (CONVERGES-TO CC-MS s L) in context: the eps-universal
  (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO cv))))
  (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'DIST) (dk-contains? q s))) (dk-asms)))
(define (c6f-near! fa e)                        ; e POS-RR: (N . the bound universal from N on)
  (let* ((nv (c6-sk! (dk-apply! fa e)))
         (bu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 'DIST))) (dk-asms))))
    (c6-nn! nv) (cons nv bu)))
(define (c6f-near-at! bu s lv n)               ; N <= n in context: lands |s(n) - L| <= e, returned
  (let ((d (dk-apply! bu n)))
    (fact 'fun-apply-type-c s 'NN 'CC n)
    (c6-cite! 'cc-ms-dist (list s n) lv)
    (dk-rewrite-h! d (list (list 'DIST 'CC-MS) (list s n) lv) (list 'magnitude (list '- (list s n) lv)))))
(define (c6f-rr-mul-nonneg! x y)               ; 0 <= x, 0 <= y in context: lands 0 <= x * y
  (let ((r (list '<= 0 (list '* x y))))
    (if (not (dk-asm? r))
        (let ((k (c6-cite! 'rr-mul-le-right 0 x y)))
          (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
          (dk-have! r (lambda () (dk-ineq! (dk-rewrite-h! k (list '* 0 y) 0))))))
    r))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))

;;; a_k -> A, b_k -> B /= 0 with every b_k /= 0: a_k / b_k -> A / B
(sp (make-wff '(FORALL c6a_ (IMPLIES (IN c6a_ (FUN NN CC)) (FORALL c6b_ (IMPLIES (IN c6b_ (FUN NN CC))
  (FORALL c6p_ (IMPLIES (IN c6p_ CC) (FORALL c6q_ (IMPLIES (IN c6q_ CC) (IMPLIES (NOT (= c6q_ 0))
    (IMPLIES (FORALL c6i_ (IMPLIES (IN c6i_ NN) (NOT (= (c6b_ c6i_) 0))))
      (IMPLIES (CONVERGES-TO CC-MS c6a_ c6p_) (IMPLIES (CONVERGES-TO CC-MS c6b_ c6q_)
        (CONVERGES-TO CC-MS (VNB-LAMBDA c6k_ NN (* (c6a_ c6k_) (recip (c6b_ c6k_)))) (* c6p_ (recip c6q_)))))))))))))))))
(let* ((new (c6-steps!))
       (nzh (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
       (b (car (cadr (cadr (caddr (caddr nzh))))))
       (a (find-first (lambda (v) (not (eq? v b))) (c6-vars new '(FUN NN CC))))
       (bb (cadr (cadr (find-first (lambda (q) (and (dk-head-is? q 'NOT) (symbol? (cadr (cadr q))))) new))))
       (aa (find-first (lambda (v) (not (eq? v bb))) (c6-vars new 'CC)))
       (ha (find-first (lambda (q) (and (dk-head-is? q 'CONVERGES-TO) (eq? (caddr q) a))) new))
       (hb (find-first (lambda (q) (and (dk-head-is? q 'CONVERGES-TO) (eq? (caddr q) b))) new))
       (h (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list a 'c6k_) (list 'recip (list b 'c6k_)))))
       (rb (list 'recip bb)) (lv (list '* aa rb))
       (beta (list 'magnitude bb)) (alpha (list 'magnitude aa)))
  (c6-pts!) (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (c6-and! (list 'IN bb 'CC) (list 'NOT (list '= bb 0))) (fact 'cc-recip-closed bb) (c6f-cc-and-closed! 'cc-mul-closed aa rb)
  (c6-lam-typ! h 'CC (lambda (k) (let ((ak (list a k)) (bk (list b k)))
                                   (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c b 'NN 'CC k) (dk-apply! nzh k)
                                   (c6-and! (list 'IN bk 'CC) (list 'NOT (list '= bk 0))) (fact 'cc-recip-closed bk)
                                   (c6f-cc-and-closed! 'cc-mul-closed ak (list 'recip bk)))))
  (c6-mag! bb) (c6-mag! aa)
  (let* ((fa (c6f-conv-split! ha a)) (fb (c6f-conv-split! hb b))
         (gam (list '+ alpha 1)) (rg (list 'recip gam)) (bh (list '* 1/2 beta)))
    (let ((iff (c6-cite! 'cc-magnitude-zero-iff bb)))
      (dk-have! (list 'NOT (list '= beta 0)) (lambda () (keep iff (list 'NOT (list '= bb 0))) (prop))))
    (dk-have! (list 'NOT (list '= 0 beta))
      (lambda () (di) (dk-have! (list '= beta 0) (lambda () (subst (list '= 0 beta)) (c6f-rfl-close!))) (ai (list 'NOT (list '= beta 0)))))
    (c6-and! (list '<= 0 beta) (list 'NOT (list '= 0 beta))) (c6-cite! 'rr-le-ne-lt 0 beta)
    (c6-rr! gam) (dk-have! (list '< 0 gam) (lambda () (dk-ineq! (list '<= 0 alpha))))
    (c6-cite! 'rr-pos-ne-zero gam) (c6-and! (list 'IN gam 'RR) (list 'NOT (list '= gam 0)))
    (fact 'rr-recip-closed gam) (c6-cite! 'rr-recip-pos gam) (fact 'rr-recip-inverse gam)
    (dk-have! (list '<= alpha gam) (lambda () (dk-ineq!)))
    (dk-have! (list '<= 0 rg) (lambda () (dk-ineq! (list '< 0 rg))))
    (let ((k1 (c6-cite! 'rr-mul-le-right alpha gam rg)))
      (dk-have! (list '<= (list '* alpha rg) 1) (lambda () (c6-ineq*! k1 (list '= (list '* gam rg) 1)))))
    (c6-rr! bh) (dk-have! (list '< 0 bh) (lambda () (dk-ineq! (list '< 0 beta)))) (c6-cite! 'rr-pos-rr-of-lt bh)
    (let* ((n1b (c6f-near! fb bh)) (n1 (car n1b)) (b1 (cdr n1b)))
      (mac 'CONVERGES-TO)
      (dk-conj-close!
        (lambda ()
          (cond
            ((dk-asm? (dk-goal)) (dk-ass!))
            ((dk-head-is? (dk-goal) 'IN) (subst '(== (PTS CC-MS) CC)) (dk-ass!))
            (#t
             (let* ((ne (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) ne)))
                    (eb (list '* eps beta)) (q (list '* eb beta))
                    (e1 (list '* eb 1/4)) (e2 (list '* q (list '* 1/4 rg))))
               (fact 'rr-pos-rr-in-rr eps) (fact 'rr-lt-of-pos-rr eps)
               (c6-rr! eb) (c6-cite! 'rr-mul-pos eps beta) (c6-rr! q) (c6-cite! 'rr-mul-pos eb beta)
               (c6-rr! e1) (dk-have! (list '< 0 e1) (lambda () (dk-ineq! (list '< 0 eb)))) (c6-cite! 'rr-pos-rr-of-lt e1)
               (c6-rr! (list '* 1/4 rg)) (dk-have! (list '< 0 (list '* 1/4 rg)) (lambda () (dk-ineq! (list '< 0 rg))))
               (c6-rr! e2) (c6-cite! 'rr-mul-pos q (list '* 1/4 rg)) (c6-cite! 'rr-pos-rr-of-lt e2)
               (let* ((n2b (c6f-near! fa e1)) (n2 (car n2b)) (b2 (cdr n2b))
                      (n3b (c6f-near! fb e2)) (n3 (car n3b)) (b3 (cdr n3b))
                      (nt (list '+ (list '+ n1 n2) n3)))
                 (dk-have! (list 'IN nt 'NN) (lambda () (type-term)))
                 (ew nt)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (dk-ass!)
                       (let* ((nk (c6-steps!)) (n (c6-var nk 'NN))
                              (an (list a n)) (bn (list b n)) (rbn (list 'recip bn))
                              (w (list '- (list '* an rbn) lv)) (x (list 'magnitude w)) (y (list 'magnitude bn)))
                         (c6-nn! n) (fact 'nn-zero-le n1) (fact 'nn-zero-le n2) (fact 'nn-zero-le n3)
                         (for-each (lambda (m) (dk-have! (list '<= m n) (lambda () (dk-ineq! (list '<= nt n) (list '<= 0 n1) (list '<= 0 n2) (list '<= 0 n3)))))
                                   (list n1 n2 n3))
                         (let* ((d1 (c6f-near-at! b1 b bb n)) (d2 (c6f-near-at! b2 a aa n)) (d3 (c6f-near-at! b3 b bb n)))
                           (dk-apply! nzh n)
                           (c6-and! (list 'IN bn 'CC) (list 'NOT (list '= bn 0))) (fact 'cc-recip-closed bn)
                           (c6f-cc-and-closed! 'cc-mul-closed an rbn) (c6-cc! w) (c6-mag! w) (c6-mag! bn)
                           (fact 'fun-apply-type-c h 'NN 'CC n)
                           (subst (dk-cite! 'cc-ms-dist (list h n) lv))
                           (dk-lam-b!)
                           ;; (b_n B) w = a_n B - A b_n
                           (let* ((bnb (list '* bn bb)) (lhs (list '* bnb w)) (rhs (list '- (list '* an bb) (list '* aa bn))))
                             (c6f-cc-and-closed! 'cc-mul-closed bn bb) (c6f-cc-and-closed! 'cc-mul-closed bnb w)
                             (c6f-cc-and-closed! 'cc-mul-closed an bb) (c6f-cc-and-closed! 'cc-mul-closed aa bn) (c6-cc! rhs)
                             (fact 'cc-recip-inverse bn) (fact 'cc-recip-inverse bb)
                             (dk-have! (list '= lhs rhs)
                               (lambda ()
                                 (let* ((v1 (dk-name! rbn 'CC)) (v2 (dk-name! rb 'CC))
                                        (i1 (dk-rewrite-h! (list '= (list '* bn rbn) 1) rbn v1))
                                        (i2 (dk-rewrite-h! (list '= (list '* bb rb) 1) rb v2))
                                        (w1 (list '- (list '* an v1) (list '* aa v2)))
                                        (lhs1 (list '* bnb w1))
                                        (mid (list '- (list '* (list '* an bb) (list '* bn v1)) (list '* (list '* aa bn) (list '* bb v2)))))
                                   (subst (list '= rbn v1)) (subst (list '= rb v2))
                                   (dk-have! (list '= lhs1 mid) (lambda () (crs)))
                                   (let ((g2 (dk-rewrite-h! (dk-rewrite-h! (list '= lhs1 mid) (list '* bn v1) 1) (list '* bb v2) 1)))
                                     (subst g2)
                                     (crs)))))
                             ;; magnitudes
                             (let* ((m1 (dk-fact! 'cc-magnitude-mul bnb w))
                                    (m2 (dk-fact! 'cc-magnitude-mul bn bb))
                                    (yb (list '* y beta))
                                    (m1b (dk-rewrite-h! m1 (list 'magnitude bnb) yb))
                                    (p1 (list '* (list '- an aa) bb)) (p2 (list '* aa (list '- bb bn))))
                               (c6-mag! lhs) (c6-mag! rhs)
                               (dk-have! (list '= (list 'magnitude lhs) (list 'magnitude rhs)) (lambda () (subst (list '= lhs rhs)) (c6f-rfl-close!)))
                               (c6-cc! (list '- an aa)) (c6-cc! (list '- bb bn)) (c6-cc! (list '- bn bb))
                               (c6f-cc-and-closed! 'cc-mul-closed (list '- an aa) bb) (c6f-cc-and-closed! 'cc-mul-closed aa (list '- bb bn))
                               (c6-mag! (list '- an aa)) (c6-mag! (list '- bb bn)) (c6-mag! (list '- bn bb)) (c6-mag! p1) (c6-mag! p2)
                               (let* ((tr (begin (c6-and! (list 'IN p1 'CC) (list 'IN p2 'CC)) (dk-fact! 'cc-magnitude-triangle p1 p2)))
                                      (tr2 (begin (dk-have! (list '= (list '+ p1 p2) rhs) (lambda () (crs))) (dk-rewrite-h! tr (list '+ p1 p2) rhs)))
                                      (mp1 (dk-fact! 'cc-magnitude-mul (list '- an aa) bb))
                                      (mp2 (dk-fact! 'cc-magnitude-mul aa (list '- bb bn)))
                                      (sy (c6-cite! 'cc-magnitude-sub-sym bb bn))
                                      (dd1 (list 'magnitude (list '- an aa))) (dd2 (list 'magnitude (list '- bn bb)))
                                      ;; |b_n| >= beta / 2
                                      (t3 (begin (c6-cc! (list '+ bn (list '- bb bn)))
                                                 (c6-and! (list 'IN bn 'CC) (list 'IN (list '- bb bn) 'CC))
                                                 (dk-fact! 'cc-magnitude-triangle bn (list '- bb bn))))
                                      (t3b (begin (dk-have! (list '= (list '+ bn (list '- bb bn)) bb) (lambda () (crs)))
                                                  (dk-rewrite-h! t3 (list '+ bn (list '- bb bn)) bb))))
                                 (dk-have! (list '<= bh y) (lambda () (c6-ineq*! t3b sy d1)))
                                 (let* ((bx (list '* beta x)))
                                   (c6-rr! bx)
                                   (c6f-rr-mul-nonneg! beta x)
                                   (let* ((k1 (c6-cite! 'rr-mul-le-right bh y bx))
                                          (k2 (c6-cite! 'rr-mul-le-right dd1 e1 beta))
                                          (k3 (c6-cite! 'rr-mul-le-right dd2 e2 alpha))
                                          (aq (list '* 1/4 q)) (ar (list '* alpha rg)))
                                     (c6-rr! aq) (c6-rr! ar)
                                     (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
                                     (dk-have! (list '<= 0 aq) (lambda () (dk-ineq! (list '<= 0 q))))
                                     (let* ((k4 (c6-cite! 'rr-mul-le-right ar 1 aq))
                                            (bb2 (list '* beta beta)) (xb (list '* x bb2)) (eb2 (list '* eps bb2))
                                            (eqs (list (list '= (list '* y bx) (list '* yb x))
                                                       (list '= (list '* bh bx) (list '* 1/2 xb))
                                                       (list '= (list '* e1 beta) aq)
                                                       (list '= q eb2)
                                                       (list '= (list '* 1 aq) aq)
                                                       (list '= (list '* dd2 alpha) (list '* alpha dd2)))))
                                       (for-each (lambda (e) (c6-rr! (cadr e)) (c6-rr! (caddr e)) (dk-have! e (lambda () (crs)))) eqs)
                                       (dk-have! (list '= (list '* e2 alpha) (list '* ar aq)) (lambda () (dk-crs-opaque!)))
                                       (c6-rr! bb2) (c6-cite! 'rr-mul-pos beta beta)
                                       (dk-have! (list '<= xb eb2)
                                         (lambda () (apply c6-ineq*! (append (list k1 m1b tr2 mp1 (dk-rewrite-h! mp2 (list 'magnitude (list '- bb bn)) dd2) k2 k3 k4 (list '= (list '* e2 alpha) (list '* ar aq))
                                                                                   (list '= (list 'magnitude lhs) (list 'magnitude rhs)))
                                                                             eqs))))
                                       (c6-cite! 'rr-mul-le-cancel-pos x bb2 eps)
                                       (dk-ass!)))))))))))))))))))))
(qed 'cc-limit-quotient)

;;; ---------------------------------------------------------------- 6.17
(define c6f-K 'CC-NORMED-FIELD)
(define (c6f-hol-fun! u p)                     ; HOLOMORPHIC-ON(u, p) in context: p in FUN(u, CC)
  (let ((r (list 'IN p (list 'FUN u 'CC))))
    (if (not (dk-asm? r))
        (let ((iff (c6-cite! 'holomorphic-on u p)))
          (dk-have! r (lambda () (keep iff (cadr iff)) (prop)))))
    r))
(define (c6f-dsk! u p z)                       ; HOLOMORPHIC-ON(u, p), z in u: a skolem l with IS-DIFF-ON(K, u, p, z, l)
  (let ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff u p) z))))
    (dk-cite! 'cc-deriv-on-of-is-diff-on u p z l)
    (dk-cite! 'diff-on-deriv-in-carr c6f-K u p z l)
    (fact 'cc-nf-carr)
    (dk-have! (list 'IN l 'CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (dk-ass!)))
    l))

;;; the product rule for DERIV-ON: h == p g pointwise on u, p and g holomorphic: h'(z) = p'(z) g(z) + p(z) g'(z)
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES (list 'IS-OPEN c6-nfm 'c6u_)
  (list 'FORALL 'c6p_ (list 'IMPLIES '(HOLOMORPHIC-ON c6u_ c6p_) (list 'FORALL 'c6g_ (list 'IMPLIES '(HOLOMORPHIC-ON c6u_ c6g_)
    (list 'FORALL 'c6h_ (list 'IMPLIES '(IN c6h_ (FUN c6u_ CC))
      (list 'IMPLIES (c6f-ptw 'c6u_ 'c6h_ (lambda (y) (list '* (list 'c6p_ y) (list 'c6g_ y))))
        (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ c6u_)
          (list '= (list 'DERIV-ON c6f-K 'c6u_ 'c6h_ 'c6z_)
                   (list '+ (list '* (list 'DERIV-ON c6f-K 'c6u_ 'c6p_ 'c6z_) '(c6g_ c6z_)) (list '* '(c6p_ c6z_) (list 'DERIV-ON c6f-K 'c6u_ 'c6g_ 'c6z_)))))))))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (ptw (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)) (peq (caddr (caddr ptw)))
       (p (car (cadr (caddr peq)))) (g (car (caddr (caddr peq)))) (h (car (cadr peq)))
       (z (c6-var new u))
       (tl (list 'VNB-LAMBDA 'c6w_ u (list '* (list p 'c6w_) (list g 'c6w_)))))
  (c6f-setu! u) (c6f-hol-fun! u p) (c6f-hol-fun! u g)
  (fact 'fun-apply-type-c p u 'CC z) (fact 'fun-apply-type-c g u 'CC z)
  (let* ((lp (c6f-dsk! u p z)) (lg (c6f-dsk! u g z))
         (df (dk-diff! u tl z)) (ls (list-ref df 5)))
    (fact 'cc-nf-carr)
    (dk-have! (list 'IN h (list 'FUN u '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (dk-ass!)))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ u) (list '== (list h 'hbx_) (list tl 'hbx_))))
      (lambda () (let ((x (dk-di-var!))) (dk-lam-b!)
                   (dk-close-if! (lambda () (dk-apply! ptw x)) (lambda () (dk-ass!))))))
    (dk-cite! 'diff-on-transfer-ptwise-eq c6f-K u h tl z ls)
    (dk-cite! 'cc-deriv-on-of-is-diff-on u h z ls)
    (subst (list '= (list 'DERIV-ON c6f-K u h z) ls))
    (subst (list '= (list 'DERIV-ON c6f-K u p z) lp))
    (subst (list '= (list 'DERIV-ON c6f-K u g z) lg))
    (crs)))
(qed 'cc-deriv-mul-ptwise)

;;; the factors g_k = 1 + f_k, the log-derivative terms g_k'(z) / g_k(z), and "no factor vanishes at z"
(define (c6f-gk u f k) (list 'VNB-LAMBDA 'c6x_ u (list '+ 1 (list (list f k) 'c6x_))))
(define (c6f-ld u f z) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list 'DERIV-ON c6f-K u (c6f-gk u f 'c6k_) z) (list 'recip (list '+ 1 (list (list f 'c6k_) z))))))
(define (c6f-nz f z) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'NOT (list '= (list '+ 1 (list (list f 'c6q_) z)) 0)))))
(define (c6f-gk-hol! u f k fh)                  ; HOLOMORPHIC-ON(u, g_k), from HOLOMORPHIC-ON(u, f_k)
  (let ((goal (list 'HOLOMORPHIC-ON u (c6f-gk u f k))))
    (if (not (dk-asm? goal))
        (let* ((hf (dk-apply! fh k))
               (gv (begin (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (dk-name! (list f k) (list 'FUN u 'CC))))
               (lam (list 'VNB-LAMBDA 'c6x_ u (list '+ 1 (list gv 'c6x_)))))
          (dk-rewrite-h! hf (list f k) gv)
          (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ u) (list 'IN 'dkdoy_ u))) (lambda () (dk-di-var!) (dk-ass!)))
          (dk-have! (list 'HOLOMORPHIC-ON u lam) (lambda () (dk-holomorphic! u lam)))
          (dk-rewrite-h! (list 'HOLOMORPHIC-ON u lam) gv (list f k))))
    goal))
(define (c6f-ld-typ! u f z fh nzh)
  (c6-lam-typ! (c6f-ld u f z) 'CC
    (lambda (k)
      (let* ((gk (c6f-gk u f k)) (fkz (list (list f k) z)) (opk (list '+ 1 fkz)) (dv (list 'DERIV-ON c6f-K u gk z)))
        (c6f-gk-hol! u f k fh)
        (let ((l (c6f-dsk! u gk z)))
          (dk-have! (list 'IN dv 'CC) (lambda () (subst (list '= dv l)) (dk-ass!))))
        (c6-fv! f u k z) (c6f-cc-and-closed! 'cc-add-closed 1 fkz) (dk-apply! nzh k)
        (c6-and! (list 'IN opk 'CC) (list 'NOT (list '= opk 0))) (fact 'cc-recip-closed opk)
        (c6f-cc-and-closed! 'cc-mul-closed dv (list 'recip opk))))))

;;; the derivative of a finite partial product: P_n'(z) = P_n(z) sum_{k<n} g_k'(z) / g_k(z) when no g_k(z) is 0
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6u_ (list 'IMPLIES (list 'IS-OPEN c6-nfm 'c6u_)
  (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_) (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_)
    (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ c6u_) (list 'IMPLIES (c6f-nz 'c6f_ 'c6z_)
      (list '= (list 'DERIV-ON c6f-K 'c6u_ (c6-ppx 'c6u_ 'c6f_ 'c6n_) 'c6z_)
               (list '* (list 'PPROD (c6-opx 'c6f_ 'c6z_) 'c6n_) (list 'CC-SERIES-PARTIAL-SUM (c6f-ld 'c6u_ 'c6f_ 'c6z_) 'c6n_)))))))))))))))
(define (c6f-ld-setup! new)
  (let* ((u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
         (f (c6f-pick-f new))
         (fh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON))) new))
         (nzh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6q_) (dk-contains? q 'NOT))) new))
         (z (c6-var new u)))
    (list u f fh nzh z)))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (st (c6f-ld-setup! new)) (u (car st)) (f (cadr st)) (fh (caddr st)) (nzh (cadddr st)) (z (list-ref st 4))
           (p0 (c6-ppx u f 0)) (one (list 'VNB-LAMBDA 'c6x_ u 1)) (ox (c6-opx f z)) (ld (c6f-ld u f z)))
      (c6-setu! u) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in)
      (c6f-ppx-typ! u f 0)
      (let* ((df (dk-diff! u one z)) (l0 (list-ref df 5)))
        (fact 'cc-nf-carr)
        (dk-have! (list 'IN p0 (list 'FUN u '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (dk-ass!)))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ u) (list '== (list p0 'hbx_) (list one 'hbx_))))
          (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (dk-close-if! (lambda () (dk-cite! 'pprod-zero (c6-opx f x))) (lambda () (dk-ass!))))))
        (dk-cite! 'diff-on-transfer-ptwise-eq c6f-K u p0 one z l0)
        (dk-cite! 'cc-deriv-on-of-is-diff-on u p0 z l0)
        (subst (list '= (list 'DERIV-ON c6f-K u p0 z) l0))
        (subst (dk-cite! 'pprod-zero ox))
        (subst (dk-cite! 'cc-series-partial-sum-zero ld))
        (crs))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (st (c6f-ld-setup! new)) (u (car st)) (f (cadr st)) (fh (caddr st)) (nzh (cadddr st)) (z (list-ref st 4))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'DERIV-ON))) new))
           (p0 (c6-ppx u f n)) (p1 (c6-ppx u f (list 'succ n))) (gn (c6f-gk u f n))
           (ox (c6-opx f z)) (ld (c6f-ld u f z))
           (fnz (list (list f n) z)) (opn (list '+ 1 fnz)) (pp (list 'PPROD ox n)) (sn (list 'CC-SERIES-PARTIAL-SUM ld n)))
      (c6-setu! u) (fact 'cc-one-in) (fact 'nn-succ-closed n)
      (let ((ihe (dk-apply! ih u f z)))
        (c6-cite! 'ppx-holomorphic n u f)
        (c6f-gk-hol! u f n fh)
        (c6f-ppx-typ! u f (list 'succ n))
        (c6f-ppx-typ! u f n)
        (dk-have! (c6f-ptw u p1 (lambda (y) (list '* (list p0 y) (list gn y))))
          (lambda ()
            (let* ((x (dk-di-var!)) (oxx (c6-opx f x)))
              (c6-fv! f u n x)
              (c6-lam-typ! oxx 'CC (lambda (k) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
              (dk-lam-b!)
              (subst (dk-cite! 'pprod-succ oxx n))
              (dk-lam-b!)
              (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
        (let* ((a (c6-cite! 'cc-deriv-mul-ptwise u p0 gn p1 z))
               (dgn (list 'DERIV-ON c6f-K u gn z))
               (l (c6f-dsk! u gn z)))
          (c6-fv! f u n z) (c6f-cc-and-closed! 'cc-add-closed 1 fnz) (dk-apply! nzh n)
          (c6-and! (list 'IN opn 'CC) (list 'NOT (list '= opn 0))) (fact 'cc-recip-closed opn) (fact 'cc-recip-inverse opn)
          (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k z) (c6-cc! (list '+ 1 (list (list f k) z)))))
          (dk-cite! 'pprod-in-cc n ox)
          (c6f-ld-typ! u f z fh nzh)
          (c6-csps-typ! ld n)
          (subst a)
          (subst ihe)
          (subst (list '= dgn l))
          (subst (c6-csps-succ! ld n))
          (subst (dk-cite! 'pprod-succ ox n))
          (dk-lam-b!)
          (if (dk-contains? (dk-goal) 'DERIV-ON) (subst (list '= dgn l)))
          (let* ((r (list 'recip opn)) (v (dk-name! r 'CC)))
            (subst (list '= r v))
            (let* ((inv (dk-rewrite-h! (list '= (list '* opn r) 1) r v))
                   (lhs (list '* (list '* pp opn) (list '+ sn (list '* l v))))
                   (mid (list '+ (list '* (list '* pp sn) opn) (list '* (list '* pp l) (list '* opn v)))))
              (dk-have! (list '= lhs mid) (lambda () (crs)))
              (subst (dk-rewrite-h! (list '= lhs mid) (list '* opn v) 1))
              (crs))))))))
(qed 'ppx-log-deriv)

;;; PROPOSITION 6.17 (pointwise).  g_k = 1 + f_k holomorphic on the open u, prod g_k normally convergent on
;;; compacta with value F = PROD-FUN(u, f): at every z in u with F(z) /= 0, sum_k g_k'(z) / g_k(z) converges
;;; to F'(z) / F(z).
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_) (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ c6u_) (list 'IMPLIES '(NOT (= ((PROD-FUN c6u_ c6f_) c6z_) 0))
      (list 'CC-SERIES-CONVERGES-TO (c6f-ld 'c6u_ 'c6f_ 'c6z_)
            (list '* (list 'DERIV-ON c6f-K 'c6u_ '(PROD-FUN c6u_ c6f_) 'c6z_) '(recip ((PROD-FUN c6u_ c6f_) c6z_)))))))))))))))
(let* ((new (c6-steps!)) (u (c6f-pick-u new)) (f (c6f-pick-f new))
       (fh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON))) new))
       (z (c6-var new u))
       (pf (list 'PROD-FUN u f)) (pp (c6-ppf u f)) (ox (c6-opx f z)) (pv (list 'PROD-VALUE ox)) (fz (list pf z))
       (ld (c6f-ld u f z)) (bseq (c6-ppseq ox)) (da (list 'DERIV-ON c6f-K u pf z)))
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN c6-nfm u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (c6-setu! u) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'nn-is-set) (c6-pts!)
  ;; F(z) = PROD-VALUE(1 + f(z)) /= 0, so no factor vanishes at z
  (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k z) (c6-cc! (list '+ 1 (list (list f k) z)))))
  (let ((iff611 (dk-split-all! (list (c6-cite! 'prop-6-11 u f z)))))
    (dk-split-all! (list (c6-cite! 'prod-value-spec ox)))
    (dk-have! (list '= fz pv) (lambda () (mac 'PROD-FUN) (dk-lam-b!) (c6f-rfl-close!)))
    (dk-have! (list 'NOT (list '= pv 0)) (lambda () (subst (list '= pv fz)) (dk-ass!)))
    (let ((zx (find-first (lambda (q) (and (dk-head-is? q 'IFF) (dk-contains? q 'c6q_))) (dk-asms))))
      (dk-have! (c6f-nz f z)
        (lambda () (let ((q (dk-di-var!)))
                     (di)
                     (dk-have! (caddr zx) (lambda () (ew q) (dk-conj-close! (lambda () (dk-ass!)))))
                     (keep zx (caddr zx) (list 'NOT (list '= pv 0))) (prop))))))
  (let* ((nzh (dk-ctx-form (c6f-nz f z)))
         (hpf (c6-cite! 'prod-fun-holomorphic u f))
         (pfa (c6-cite! 'prop-6-12 u f)))
    (dk-split-all! (list pfa))
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'HOLOMORPHIC-ON u (list pp 'k))))
      (lambda () (let* ((k (dk-di-var!)) (px (c6-ppx u f k)))
                   (c6-lam-typ-on! px u (lambda (x) (dk-cite! 'pprod-in-cc k (c6-opx f x)) (dk-ass!)) f)
                   (fact 'membership-implies-sethood px (list 'FUN u 'CC))
                   (dk-lam-b!) (c6-cite! 'ppx-holomorphic k u f) (dk-ass!))))
    (let* ((uh (c6-cite! 'holomorphic-limit-derivatives u pp pf))
           (sd (caddr uh)) (hd (cadddr uh))
           (la (c6f-dsk! u pf z)))
      (dk-have! (list 'IN da 'CC) (lambda () (subst (list '= da la)) (dk-ass!)))
      ;; the derivative family and its limit are complex valued
      (dk-have! (list 'IN hd (list 'FUN u 'CC))
        (lambda () (dk-lam-type! (lambda () (let* ((w (dk-di-var!)) (leaf (proof-state-focus *ps*)) (lw (c6f-dsk! u pf w)))
                                              (dk-have! (list 'IN (list 'DERIV-ON c6f-K u pf w) 'CC) (lambda () (subst (list '= (list 'DERIV-ON c6f-K u pf w) lw)) (dk-ass!)))
                                              (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                                 (lambda () (dk-ass!)))))
      (let* ((lk (dk-cite! 'cc-unif-on-compacta-pointwise u sd)) (ty (cadr lk)))
        (dk-have! ty
          (lambda ()
            (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (w (c6-var nk u)) (px (c6-ppx u f k)))
              (c6-cite! 'ppx-holomorphic k u f)
              (let ((lw (c6f-dsk! u px w)))
                (dk-lam-b!)
                (dk-close-if! (lambda () #t) (lambda () (subst (list '= (list 'DERIV-ON c6f-K u px w) lw)) (dk-ass!)))))))
        (let* ((cz (dk-apply! (c6-cite! 'cc-unif-on-compacta-pointwise u sd hd) z)))
          (dk-lam-b-h! cz)
          (let* ((cv (find-first (lambda (q) (and (dk-head-is? q 'CONVERGES-TO) (dk-contains? q 'DERIV-ON) (dk-head-is? (cadddr q) 'DERIV-ON))) (dk-asms)))
                 (dseq (caddr cv)))
            (c6-lam-typ! dseq 'CC (lambda (k) (let* ((px (c6-ppx u f k)) (lw (begin (c6-cite! 'ppx-holomorphic k u f) (c6f-dsk! u px z))))
                                                (c6f-lb!)
                                                (dk-close-if! (lambda () #t) (lambda () (subst (list '= (list 'DERIV-ON c6f-K u px z) lw)) (dk-ass!))))))
            (c6-lam-typ! bseq 'CC (lambda (k) (c6f-lb!) (dk-cite! 'pprod-in-cc k ox)))
            (dk-have! (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'NOT (list '= (list bseq 'c6i_) 0))))
              (lambda () (let ((k (dk-di-var!)))
                           (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ k) (list 'NOT (list '= (list ox 'c6j_) 0)))))
                             (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (dk-lam-b!) (dk-apply! nzh j) (dk-ass!))))
                           (c6-cite! 'pprod-nonzero k ox)
                           (c6f-lb-close!))))
            (c6-cite! 'prod-partial-converges ox pv)
            (let* ((bnz (dk-ctx-form (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'NOT (list '= (list bseq 'c6i_) 0))))))
                   (pk-nz! (lambda (k) (let ((r (list 'NOT (list '= (list 'PPROD ox k) 0)))) (if (not (dk-asm? r)) (c6f-lbh! (dk-apply! bnz k))) r)))
                   (qc (c6-cite! 'cc-limit-quotient dseq bseq da pv))
                   (qlam (caddr qc)) (iff (c6-cite! 'cc-series-converges-to ld (cadddr qc))) (slam (caddr (caddr iff))))
              (c6f-ld-typ! u f z fh nzh)
              (c6-lam-typ! slam 'CC (lambda (k) (c6f-lb!) (c6-csps-typ! ld k)))
              (c6-lam-typ! qlam 'CC (lambda (k) (let* ((px (c6-ppx u f k)) (pk (list 'PPROD ox k)) (dv (list 'DERIV-ON c6f-K u px z))
                                                       (lw (begin (c6-cite! 'ppx-holomorphic k u f) (c6f-dsk! u px z))))
                                                  (c6f-lb!)
                                                  (dk-cite! 'pprod-in-cc k ox) (pk-nz! k)
                                                  (dk-have! (list 'IN dv 'CC) (lambda () (subst (list '= dv lw)) (dk-ass!)))
                                                  (c6-and! (list 'IN pk 'CC) (list 'NOT (list '= pk 0))) (fact 'cc-recip-closed pk)
                                                  (c6f-cc-and-closed! 'cc-mul-closed dv (list 'recip pk)))))
              (dk-fun-ext! qlam slam 'NN 'CC #f #f
                (lambda (k)
                  (let* ((pk (list 'PPROD ox k)) (sk (list 'CC-SERIES-PARTIAL-SUM ld k)) (r (list 'recip pk)))
                    (pk-nz! k) (dk-cite! 'pprod-in-cc k ox) (c6-csps-typ! ld k)
                    (c6-and! (list 'IN pk 'CC) (list 'NOT (list '= pk 0))) (fact 'cc-recip-closed pk) (fact 'cc-recip-inverse pk)
                    (let ((e (c6-cite! 'ppx-log-deriv k u f z)))
                      (dk-lam-b!)
                      (subst e)
                      (let* ((v (dk-name! r 'CC))
                             (inv (dk-rewrite-h! (list '= (list '* pk r) 1) r v))
                             (lhs (list '* (list '* pk sk) v)) (mid (list '* sk (list '* pk v))))
                        (subst (list '= r v))
                        (dk-have! (list '= lhs mid) (lambda () (crs)))
                        (subst (dk-rewrite-h! (list '= lhs mid) (list '* pk v) 1))
                        (crs))))))
              (dk-rewrite-h! qc qlam slam)
              (subst (list '= fz pv))
              (dk-have! (caddr iff) (lambda () (dk-ass!)))
              (keep iff (caddr iff)) (prop))))))))
(qed 'prop-6-17)

  
