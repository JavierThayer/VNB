;;; ======================================================================
;;; COROLLARY 5.27: a disjoint sequence of Souslin (or empty) sets has disjoint Borel envelopes
;;; ======================================================================
(define msq-fam '(VNB-LAMBDA msi_ NN (SEP msc_ (BOREL-SETS s) (AND (SUBSET (fs (NNFST msi_)) msc_)
                   (IMPLIES (NOT (= (NNFST msi_) (NNSND msi_))) (FORALL msx_ (IMPLIES (IN msx_ (fs (NNSND msi_))) (NOT (IN msx_ msc_)))))))))
(define msq-seh (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (msp-se '(fs k)))))
(define (msq-dj e) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'l (list 'IMPLIES '(IN l NN) (list 'IMPLIES '(NOT (= k l))
                     (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list e 'k)) (list 'NOT (list 'IN 'x (list e 'l)))))))))))
(define msq-concl (list 'FORSOME 'ee (list 'AND '(IN ee (FUN NN (BOREL-SETS s)))
                    (list 'AND '(FORALL k (IMPLIES (IN k NN) (SUBSET (fs k) (ee k)))) (msq-dj 'ee)))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'fs (list 'IMPLIES '(IN fs (FUN NN (POWER (PTS s))))
  (list 'IMPLIES msq-seh (list 'IMPLIES (msq-dj 'fs) msq-concl))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-cite! 'ms-pts-is-set 's)
(define msq-sehc (dk-ctx-form msq-seh))
(define msq-djc (dk-ctx-form (msq-dj 'fs)))
(define (msq-fs! k)                  ; k in NN: fs(k) in POWER(PTS s) and subset PTS s
  (let ((a (list 'fs k)))
    (dk-cite! 'fun-apply-type-c 'fs 'NN '(POWER (PTS s)) k)
    (if (not (dk-asm? (list 'SUBSET a '(PTS s))))
        (dk-have! (list 'SUBSET a '(PTS s))
          (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS s) a x) (mr-close-open!)))))))
;; pairwise separators exist
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'FORSOME 'y (list 'AND (list 'IN 'y msp-BOR) (list 'IN 'y (list msq-fam 'i))))))
  (lambda ()
    (let* ((i (dk-di-var!)) (k (list 'NNFST i)) (l (list 'NNSND i)) (fk (list 'fs k)) (fl (list 'fs l)))
      (dk-cite! 'nnfst-type i) (dk-cite! 'nnsnd-type i)
      (msq-fs! k) (msq-fs! l)
      (use-em (list '= k l)
        (lambda ()
          (dk-cite! 'sigma-algebra-whole-in '(PTS s) msp-BOR)
          (ew '(PTS s))
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (begin (dk-lam-b!)
                         (in-sep! (lambda () (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                          (begin (di) (pbc) (ai (list 'NOT (list '= k l))))))))))))))
        (lambda ()
          (dk-have! (msp-se fk) (lambda () (di) (dk-apply! msq-sehc k) (mr-close-open!)))
          (dk-have! (msp-se fl) (lambda () (di) (dk-apply! msq-sehc l) (mr-close-open!)))
          (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x fk) (list 'NOT (list 'IN 'x fl))))
            (lambda () (dk-apply! msq-djc k l) (mr-close-open!)))
          (dk-cite! 'souslin-or-empty-separation 's fk fl)
          (let ((c (dk-skolem! (car (mr-iff-parts! (dk-cite! 'borel-separated 's fk fl))))))
            (dk-split-all!)
            (ew c)
            (mr-and-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (begin (dk-lam-b!)
                           (in-sep! (lambda () (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                            (begin (di) (mr-close-open!)))))))))))))))))
(set! msp-Cf (dk-skolem! (dk-cite! 'rmm-nn-choice msp-BOR msq-fam)))
(dk-split-all!)
(set! msp-Cin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f msp-Cf) (dk-contains? f 'msc_))) "C choice"))
(define (msq-E0 k) (list 'COMPLEMENT-IN msp-pts (list 'BIG-UNION 'n_ 'NN (list 'COMPLEMENT-IN msp-pts (list msp-Cf (list 'NNPAIR k 'n_))))))
(define msq-DD (list 'VNB-LAMBDA 'msk_ 'NN (msq-E0 'msk_)))
(define (msq-E0! k)                  ; k in NN: E0(k) Borel
  (if (not (dk-asm? (list 'IN (msq-E0 k) msp-BOR)))
      (begin
        (msp-g! k)
        (dk-cite! 'sigma-algebra-countable-inter msp-pts msp-BOR (msp-g k))
        (dk-lam-b-h! (list 'IN (msp-D k) msp-BOR)))))
(dk-have! (list 'IN msq-DD (list 'FUN 'NN msp-BOR))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (msq-E0! k)
                                 (msp-close-at! kn))))))
              (dk-opened (lambda () (lam-t))))))
;; (a) fs(k) lies in E0(k)
(define msq-a (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'SUBSET '(fs k) (msq-E0 'k)))))
(dk-have! msq-a
  (lambda ()
    (let ((k (cadr (car (dk-peel!)))))
      (msq-fs! k)
      (mac 'subset-def)
      (let* ((x (dk-di-var!)) (iff (dk-cite! 'complement-in-membership msp-pts (caddr (msq-E0 k)) x)))
        (dk-cite! 'subset-mem-fwd (list 'fs k) msp-pts x)
        (dk-have! (caddr iff)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (begin
                      (di)
                      (let* ((kb (mr-bu-open! x (caddr (msq-E0 k)))) (l (car kb)) (p (list 'NNPAIR k l)))
                        (msp-in-g! x k l)
                        (mr-iff-parts! (dk-cite! 'complement-in-membership msp-pts (list msp-Cf p) x))
                        (dk-rewrite-h! (list 'SUBSET (list 'fs (list 'NNFST p)) (list msp-Cf p)) (list 'NNFST p) k)
                        (dk-cite! 'subset-mem-fwd (list 'fs k) (list msp-Cf p) x)
                        (ai (list 'NOT (list 'IN x (list msp-Cf p)))))))))))
        (mr-iff-back! iff)
        (mr-close-open!)))))
;; (b) E0(k) misses fs(l) for l /= k
(define msq-b (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'l (list 'IMPLIES '(IN l NN) (list 'IMPLIES '(NOT (= k l))
                (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (msq-E0 'k)) '(NOT (IN x (fs l)))))))))))
(dk-have! msq-b
  (lambda ()
    (let* ((ls (dk-peel!))
           (ne (cadr (mr-find 'ne (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=))) ls)))
           (k (cadr ne)) (l (caddr ne))
           (x (cadr (mr-find 'xe (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'COMPLEMENT-IN))) ls)))
           (p (list 'NNPAIR k l))
           (bu (caddr (msq-E0 k))))
      (if (not (eq? (dk-goal) 'FALSITY)) (di))
      (msp-in-g! x k l)
      (mr-iff-parts! (dk-cite! 'complement-in-membership msp-pts bu x))
      (msq-fs! l)
      (dk-have! (list 'IN x (list msp-Cf p))
        (lambda ()
          (pbc)
          (dk-have! (list 'IN x bu)
            (lambda ()
              (dk-cite! 'subset-mem-fwd (list 'fs l) msp-pts x)
              (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                                         (begin (dk-focus! l0)
                                                (if (dk-asm? (dk-goal)) (ass)
                                                    (begin (mac 'complement-in-membership)
                                                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                          (begin (di) (ai (list 'NOT (list 'IN x (list msp-Cf p)))))))))))))
                        (dk-opened (lambda () (bu-mi l))))))
          (ai (list 'NOT (list 'IN x bu)))))
      (let* ((imp (mr-find 'imp (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (cadr f) 'NOT) (dk-contains? f (list msp-Cf p)))) (dk-asms)))
             (imp2 (dk-rewrite-h! (dk-rewrite-h! imp (list 'NNFST p) k) (list 'NNSND p) l))
             (dj (mr-chain! imp2)))
        (dk-apply! dj x)
        (ai (list 'NOT (list 'IN x (list msp-Cf p))))))))
;; the envelopes: E(k) = E0(k) minus the E0(l), l < k
(define (msq-segU k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) (list msq-DD 'uj_)))
(define (msq-Ek k) (list 'COMPLEMENT-IN (msq-E0 k) (msq-segU k)))
(define msq-EE (list 'VNB-LAMBDA 'mek_ 'NN (msq-Ek 'mek_)))
(define (msq-Ek! k)                  ; k in NN: E(k) Borel, and the seg union Borel
  (msq-E0! k)
  (dk-cite! 'sigma-algebra-seg-union-in k msp-pts msp-BOR msq-DD)
  (dk-cite! 'sigma-algebra-difference-closed msp-pts msp-BOR (msq-E0 k) (msq-segU k)))
(define (msq-in-seg! x k l)          ; l < k, x in E0(l): x in the seg union of k
  (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr l)
  (let ((iff (dk-cite! 'seg-mem-lt k l))) (mr-iff-back! iff))
  (dk-have! (list 'IN x (msq-segU k))
    (lambda ()
      (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                                 (begin (dk-focus! l0)
                                        (if (dk-asm? (dk-goal)) (ass)
                                            (begin (dk-lam-b!) (mr-close-open!))))))
                (dk-opened (lambda () (bu-mi l)))))))
(define (msp-close-owed! ls)          ; ls opened by a beta step: close the owed typings, refocus the main leaf
  (let ((main #f))
    (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                               (begin (dk-focus! l0) (if (dk-asm? (dk-goal)) (ass) (set! main l0)))))
              ls)
    (if main (dk-focus! main))))
(define (msp-lam-b1!) (msp-close-owed! (dk-opened (lambda () (lam-b)))))
(define (msp-lam-bh1! f) (msp-close-owed! (dk-opened (lambda () (lam-b-h f)))))
(define (msq-ek-parts! x k)          ; x in EE(k) in context: x in E0(k), x not in the seg union of k
  (if (dk-asm? (list 'IN x (list msq-EE k))) (msp-lam-bh1! (list 'IN x (list msq-EE k))))
  (mr-iff-parts! (dk-cite! 'complement-in-membership (msq-E0 k) (msq-segU k) x)))
(dk-have! (list 'IN msq-EE (list 'FUN 'NN msp-BOR))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (msq-Ek! k)
                                 (msp-close-at! kn))))))
              (dk-opened (lambda () (lam-t))))))
(define msq-ac (dk-ctx-form msq-a))
(define msq-bc (dk-ctx-form msq-b))
(ew msq-EE)
(mr-and-close!
  (lambda ()
    (cond
      ((dk-asm? (dk-goal)) (ass))
      ((dk-contains? (dk-goal) 'SUBSET)
       (let ((k (cadr (car (dk-peel!)))))
         (mac 'subset-def)
         (let ((x (dk-di-var!)))
           (dk-apply! msq-ac k)
           (dk-cite! 'subset-mem-fwd (list 'fs k) (msq-E0 k) x)
           (if (dk-contains? (dk-goal) 'mek_) (msp-lam-b1!))
           (let ((iff (dk-cite! 'complement-in-membership (msq-E0 k) (msq-segU k) x)))
             (dk-have! (caddr iff)
               (lambda ()
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (ass)
                         (begin
                           (di)
                           (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x (msq-segU k))))))
                                  (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'ORD-SEGMENT k)))) landed))
                                  (l (cadr ein)))
                             (dk-cite! 'nn-in-rr k)
                             (dk-cite! 'ord-segment-nn-subset k l)
                             (for-each (lambda (f) (if (and (not (eq? f ein)) (dk-contains? f 'msk_)) (msp-lam-bh1! f))) landed)
                             (mr-iff-parts! (dk-cite! 'seg-mem-lt k l))
                             (dk-cite! 'nn-in-rr l)
                             (mr-ne! l k (list '< l k))
                             (dk-apply! msq-bc l k x)
                             (ai '(NOT (IN x (fs k)))))))))))
               (mr-iff-back! iff)
               (mr-close-open!)))))
      (#t
       (let* ((ls (dk-peel!))
              (ne (cadr (mr-find 'ne (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=))) ls)))
              (k (cadr ne)) (l (caddr ne))
              (x (cadr (mr-find 'xe (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'ORD-SEGMENT))) ls))))
         (if (not (eq? (dk-goal) 'FALSITY)) (di))
         (msq-ek-parts! x k)
         (msq-ek-parts! x l)
         (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr l)
         (use-em (list '< l k)
           (lambda ()
             (msq-in-seg! x k l)
             (ai (list 'NOT (list 'IN x (msq-segU k)))))
           (lambda ()
             (mr-chain! (dk-cite! 'nn-not-lt-le l k))
             (dk-have! (list 'AND (list '<= k l) (list 'NOT (list '= k l))) (lambda () (dk-conj-close! (lambda () (ass)))))
             (mr-chain! (dk-fact! 'rr-le-ne-lt k l))
             (msq-in-seg! x l k)
             (ai (list 'NOT (list 'IN x (msq-segU l)))))))))))
(mr-close-open!)
