;;; COROLLARY 5.26: in a Polish space, e is Borel iff e and its complement are Souslin (or empty)
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-POLISH s) (list 'FORALL 'e (list 'IMPLIES '(SUBSET e (PTS s))
  (list 'IFF '(IN e (BOREL-SETS s)) (list 'AND (msp-se 'e) (msp-se msp-ce)))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-complete 's))
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (dk-cite! 'sigma-algebra-complement-closed '(PTS s) msp-BOR 'e)
    (dk-conj-close!
      (lambda ()
        (di)
        (let ((b (caddr (dk-goal))))
          (dk-cite! 'borel-polish-souslin 's b)
