;;; mb67-sep.scm -- construction of measures, chapter 5 section 1.6 (M-B67, 2026-10-26): the separation theorem.
;;;   cyl-unfold, upd-facts, cyl-agree, cyl-zero, cyl-split, borel-separated-union
;;;   separation-step, souslin-separation (Proposition 5.25), and its corollaries
;;; The proof is the Baire-space form of the notes' argument: a Souslin set is f(N^N) for a Baire-continuous f
;;; (5.10); if f(N^N) and g(N^N) are not Borel-separated, a dependent choice (dc-on-nn-pred) splits the cylinders
;;; one coordinate at a time keeping the images inseparable, and at the limit points y, z the images of short
;;; cylinders lie in disjoint balls -- an open ball separates them.  No closure and no completeness is used.
;;; Vocabulary: mb67-vocab.scm (BOREL-SEPARATED, CYL, UPD).  Library: measure.  Helper prefixes mr- (copied), msp-.
;;; Load window: after mb67-souslin, mb35-souslin (souslin-baire-image, prefix-eq-intro), dc-on-nn (dc-on-nn-pred),
;;; riesz-markov-model (rmm-nn-choice), push-forward (pfw-open-borel), nn-pairing.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define msp-F '(FUN NN NN))
(define (msp-cylsep w n) (list 'SEP 'cyz_ msp-F (list 'FORALL 'cyj_ (list 'IMPLIES '(IN cyj_ NN) (list 'IMPLIES (list '< 'cyj_ n) (list '= '(cyz_ cyj_) (list w 'cyj_)))))))
(define (msp-agree z w n) (list 'FORALL 'cyj_ (list 'IMPLIES '(IN cyj_ NN) (list 'IMPLIES (list '< 'cyj_ n) (list '= (list z 'cyj_) (list w 'cyj_))))))
(sp (make-wff '(FORALL w (FORALL n (== (CYL w n) (SEP cyz_ (FUN NN NN) (FORALL cyj_ (IMPLIES (IN cyj_ NN) (IMPLIES (< cyj_ n) (= (cyz_ cyj_) (w cyj_)))))))))))
(dk-peel!) (mac 'CYL) (qrfl)
(qed 'cyl-unfold)
(topic! 'cyl-unfold 'analysis)
(define (msp-cyl-in! z w n)          ; z in F agreeing with w below n (the universal in context): z in CYL(w, n)
  (dk-cite! 'cyl-unfold w n)
  (dk-have! (list 'IN z (list 'CYL w n))
    (lambda () (subst (list '= (list 'CYL w n) (msp-cylsep w n))) (in-sep! (lambda () (mr-close-open!))))))
(define (msp-cyl-parts! z w n)       ; z in CYL(w, n): z in F, the agreement (returned)
  (dk-cite! 'cyl-unfold w n)
  (dk-rewrite-h! (list 'IN z (list 'CYL w n)) (list 'CYL w n) (msp-cylsep w n))
  (mr-sep-parts! (list 'IN z (msp-cylsep w n))))

;; UPD
(sp (make-wff '(FORALL w (IMPLIES (IN w (FUN NN NN)) (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
   (AND (IN (UPD w n m) (FUN NN NN)) (AND (FORALL j (IMPLIES (IN j NN) (IMPLIES (< j n) (= ((UPD w n m) j) (w j)))))
        (FORALL j (IMPLIES (IN j NN) (IMPLIES (NOT (< j n)) (= ((UPD w n m) j) m))))))))))))))
(dk-peel!)
(fact 'nn-is-set)
(mac 'UPD)
(mr-and-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass)
                                   (let ((j (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                     (dk-cite! 'fun-apply-type-c 'w 'NN 'NN j)
                                     (dk-case-if! (cadr (dk-goal)) (lambda (tv val) (mr-close-open!))))))))
                  (dk-opened (lambda () (lam-t))))
        (let* ((lj (dk-peel!)) (j (cadr (mr-find 'uj (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lj))))
          (dk-cite! 'fun-apply-type-c 'w 'NN 'NN j)
          (dk-lam-b!)
          (if (dk-asm? (list '< j 'n))
              (dk-if-branch! #t (cadr (dk-goal)) #f (lambda () (rfl)))
              (dk-if-branch! #f (cadr (dk-goal)) #f (lambda () (rfl))))))))
(qed 'upd-facts)
(topic! 'upd-facts 'analysis)

;; sequences that agree below n have the same cylinder
(sp (make-wff (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w msp-F) (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v msp-F)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (msp-agree 'w 'v 'n) '(= (CYL w n) (CYL v n)))))))))))
(dk-peel!)
(define msp-wv (dk-ctx-form (msp-agree 'w 'v 'n)))
(mr-ext2! '(CYL w n) '(CYL v n)
  (lambda (z)
    (let ((ag (msp-cyl-parts! z 'w 'n)))
      (dk-have! (msp-agree z 'v 'n)
        (lambda () (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
                     (dk-apply! ag j) (dk-apply! msp-wv j)
                     (subst (list '= (list z j) (list 'w j))) (mr-close-open!))))
      (msp-cyl-in! z 'v 'n) (mr-close-open!)))
  (lambda (z)
    (let ((ag (msp-cyl-parts! z 'v 'n)))
      (dk-have! (msp-agree z 'w 'n)
        (lambda () (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
                     (dk-apply! ag j) (dk-apply! msp-wv j)
                     (dk-cite! 'fun-apply-type-c 'w 'NN 'NN j)
                     (subst (list '= (list z j) (list 'v j))) (subst (list '= (list 'v j) (list 'w j))) (rfl))))
      (msp-cyl-in! z 'w 'n) (mr-close-open!))))
(mr-close-open!)
(qed 'cyl-agree)
(topic! 'cyl-agree 'analysis)

(sp (make-wff (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w msp-F) (list '= '(CYL w 0) msp-F)))))
(dk-peel!)
(fact 'nn-zero-in)
(mr-ext2! '(CYL w 0) msp-F
  (lambda (z) (msp-cyl-parts! z 'w 0) (mr-close-open!))
  (lambda (z)
    (dk-have! (msp-agree z 'w 0)
      (lambda () (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
                   (dk-cite! 'nn-in-rr j) (dk-cite! 'nn-zero-le j)
                   (pbc) (dk-absurd! lt (list '<= 0 j) (list 'IN j 'RR)))))
    (msp-cyl-in! z 'w 0) (mr-close-open!)))
(mr-close-open!)
(qed 'cyl-zero)
(topic! 'cyl-zero 'analysis)

;; a cylinder is the union of its one-step refinements
(define msp-split '(BIG-UNION mcm_ NN (CYL (UPD w n mcm_) (succ n))))
(sp (make-wff (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w msp-F) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '= '(CYL w n) msp-split)))))))
(dk-peel!)
(dk-cite! 'nn-succ-closed 'n) (dk-cite! 'nn-succ-plus-one 'n) (dk-cite! 'nn-in-rr 'n) (dk-cite! 'nn-in-rr '(succ n))
(define (msp-upd! m) (dk-split-all! (list (dk-cite! 'upd-facts 'w 'n m))))
(mr-ext2! '(CYL w n) msp-split
  (lambda (z)
    (let* ((ag (msp-cyl-parts! z 'w 'n)) (m (list z 'n)) (u (list 'UPD 'w 'n m)))
      (dk-cite! 'fun-apply-type-c z 'NN 'NN 'n)
      (msp-upd! m)
      (dk-have! (msp-agree z u '(succ n))
        (lambda ()
          (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
            (dk-cite! 'nn-in-rr j)
            (dk-cite! 'fun-apply-type-c z 'NN 'NN j)
            (use-em (list '< j 'n)
              (lambda ()
                (dk-apply! ag j)
                (dk-apply! (mr-find 'u1 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u) (dk-contains? f '<) (not (dk-contains? f 'NOT)))) (dk-asms)) j)
                (subst (list '= (list u j) (list 'w j))) (mr-close-open!))
              (lambda ()
                (dk-apply! (mr-find 'u2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u) (dk-contains? f 'NOT))) (dk-asms)) j)
                (mr-chain! (dk-cite! 'nn-lt-succ-le j '(succ n)))
                (dk-cite! 'nn-succ-closed j) (dk-cite! 'nn-succ-plus-one j) (dk-cite! 'nn-in-rr (list 'succ j))
                (mr-chain! (dk-cite! 'nn-not-lt-le j 'n))
                (dk-have! (list '<= j 'n) (lambda () (dk-ineq! (list '<= (list 'succ j) '(succ n)) (list '= (list 'succ j) (list '+ j 1)) (list '= '(succ n) '(+ n 1)) (list 'IN j 'RR) '(IN n RR) (list 'IN (list 'succ j) 'RR) '(IN (succ n) RR))))
                (dk-have! (list '= j 'n) (lambda () (mr-chain! (dk-cite! 'nn-le-antisym j 'n)) (mr-close-open!)))
                (subst (list '= (list u j) m))
                (subst (list '= j 'n))
                (rfl))))))
      (msp-cyl-in! z u '(succ n))
      (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (mr-close-open!)))) (dk-opened (lambda () (bu-mi m))))))
  (lambda (z)
    (let* ((ka (mr-bu-open! z msp-split)) (m (car ka)) (u (list 'UPD 'w 'n m))
           (ag (msp-cyl-parts! z u '(succ n))))
      (msp-upd! m)
      (dk-have! (msp-agree z 'w 'n)
        (lambda ()
          (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
            (dk-cite! 'nn-in-rr j)
            (dk-have! (list '< j '(succ n)) (lambda () (dk-ineq! lt '(= (succ n) (+ n 1)) (list 'IN j 'RR) '(IN n RR) '(IN (succ n) RR))))
            (dk-apply! ag j)
            (dk-apply! (mr-find 'u1 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u) (dk-contains? f '<) (not (dk-contains? f 'NOT)))) (dk-asms)) j)
            (subst (list '= (list z j) (list u j))) (mr-close-open!))))
      (msp-cyl-in! z 'w 'n) (mr-close-open!))))
(mr-close-open!)
(qed 'cyl-split)
(topic! 'cyl-split 'analysis)

;;; ======================================================================
;;; countable unions of pairwise separated sets are separated
;;; ======================================================================
(define msp-BOR '(BOREL-SETS s))
(define msp-pts '(PTS s))
(define (msp-bsrhs a b c) (list 'AND (list 'IN c msp-BOR) (list 'AND (list 'SUBSET a c) (list 'FORALL 'bsx_ (list 'IMPLIES (list 'IN 'bsx_ b) (list 'NOT (list 'IN 'bsx_ c)))))))
(define msp-fam '(VNB-LAMBDA msi_ NN (SEP msc_ (BOREL-SETS s) (AND (SUBSET (fa (NNFST msi_)) msc_)
                   (FORALL msx_ (IMPLIES (IN msx_ (fb (NNSND msi_))) (NOT (IN msx_ msc_))))))))
(define msp-hyp '(FORALL k (IMPLIES (IN k NN) (FORALL l (IMPLIES (IN l NN) (BOREL-SEPARATED s (fa k) (fb l)))))))
(define msp-UA '(BIG-UNION n_ NN (fa n_)))
(define msp-UB '(BIG-UNION n_ NN (fb n_)))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'fa (list 'IMPLIES '(IN fa (FUN NN (POWER (PTS s))))
  (list 'FORALL 'fb (list 'IMPLIES '(IN fb (FUN NN (POWER (PTS s)))) (list 'IMPLIES msp-hyp (list 'BOREL-SEPARATED 's msp-UA msp-UB))))))))))
(dk-peel!)
(fact 'nn-is-set)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'FORSOME 'y (list 'AND (list 'IN 'y msp-BOR) (list 'IN 'y (list msp-fam 'i))))))
  (lambda ()
    (let* ((i (dk-di-var!)) (fi (list 'NNFST i)) (si (list 'NNSND i)))
      (dk-cite! 'nnfst-type i) (dk-cite! 'nnsnd-type i)
      (dk-apply! msp-hyp fi si)
      (let ((c (dk-skolem! (car (mr-iff-parts! (dk-cite! 'borel-separated 's (list 'fa fi) (list 'fb si)))))))
        (dk-split-all!)
        (ew c)
        (mr-and-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (begin (dk-lam-b!) (in-sep! (lambda () (mr-and-close! (lambda () (mr-close-open!)))))))))))))
(define msp-Cf (dk-skolem! (dk-cite! 'rmm-nn-choice msp-BOR msp-fam)))
(dk-split-all!)
(define msp-Cin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f msp-Cf) (dk-contains? f 'msc_))) "C choice"))
(define (msp-cf! i)                  ; i in NN: C(i) Borel, fa(fst i) subset C(i), C(i) misses fb(snd i)
  (let ((ci (list msp-Cf i)))
    (if (not (dk-asm? (list 'IN ci msp-BOR)))
        (begin
          (dk-cite! 'fun-apply-type-c msp-Cf 'NN msp-BOR i)
          (dk-lam-b-h! (dk-apply! msp-Cin i))
          (let ((m (mr-find 'cmem (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) ci) (pair? (caddr f)) (eq? (car (caddr f)) 'SEP))) (dk-asms))))
            (dk-split-all! (list (mr-sep-parts! m))))))
    ci))
(define (msp-close-at! kn)            ; the open leaves under kn, if a citation did not already close them
  (for-each (lambda (lf)
              (if (not (sequent-node-grounded? lf))
                  (begin (dk-focus! lf)
                         (if (not (dk-asm? (dk-goal))) (dk-lam-b!))
                         (if (not (sequent-node-grounded? lf)) (begin (dk-focus! lf) (ass))))))
            (dk--open-below kn)))
(define (msp-g k) (list 'VNB-LAMBDA 'msl_ 'NN (list msp-Cf (list 'NNPAIR k 'msl_))))
(define (msp-D k) (list 'COMPLEMENT-IN msp-pts (list 'BIG-UNION 'n_ 'NN (list 'COMPLEMENT-IN msp-pts (list (msp-g k) 'n_)))))
(define msp-DD (list 'VNB-LAMBDA 'msk_ 'NN (msp-D 'msk_)))
(define msp-C (list 'BIG-UNION 'n_ 'NN (list msp-DD 'n_)))
(define (msp-g! k)                   ; k in NN: g(k) in FUN(NN, BOREL), and D(k) Borel
  (let ((gk (msp-g k)))
    (if (not (dk-asm? (list 'IN gk (list 'FUN 'NN msp-BOR))))
        (begin
          (dk-have! (list 'IN gk (list 'FUN 'NN msp-BOR))
            (lambda ()
              (for-each (lambda (kn)
                          (if (not (sequent-node-grounded? kn))
                              (begin (dk-focus! kn)
                                     (if (dk-asm? (dk-goal)) (ass)
                                         (let ((l (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                           (dk-cite! 'nnpair-type k l)
                                           (dk-cite! 'fun-apply-type-c msp-Cf 'NN msp-BOR (list 'NNPAIR k l))
                                           (msp-close-at! kn))))))
                        (dk-opened (lambda () (lam-t))))))
          (dk-cite! 'sigma-algebra-countable-inter msp-pts msp-BOR gk)))
    gk))
(dk-have! (list 'IN msp-DD (list 'FUN 'NN msp-BOR))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (msp-g! k)
                                 (msp-close-at! kn))))))
              (dk-opened (lambda () (lam-t))))))
(dk-cite! 'sigma-algebra-union-closed msp-pts msp-BOR msp-DD)
(define (msp-lamb-h-if! f) (if (dk-contains? f 'VNB-LAMBDA) (dk-lam-b-h! f)))
(define (msp-bu-asm x)               ; the union over n_ landed in context with x in it, C-summands
  (caddr (mr-find 'bu (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x) (pair? (caddr f)) (eq? (car (caddr f)) 'BIG-UNION)
