  (list 'FORALL 'g (list 'IMPLIES '(IS-BAIRE-CONTINUOUS s g) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y msp-F)
  (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z msp-F) (list 'IMPLIES '(NOT (= (f y) (g z))) msp-sepn)))))))))))))
