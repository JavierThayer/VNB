(define (msp-nth-r!)                 ; reduce NTH of a literal list in the goal, to a fixpoint
  (let loop ((n 0))
    (if (and (< n 12)
             (let scan ((e (dk-goal)))
               (and (pair? e)
                    (or (and (eq? (car e) 'NTH) (pair? (cddr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST))
                        (any-pred scan e)))))
        (begin (nth-r) (loop (+ n 1))))))
