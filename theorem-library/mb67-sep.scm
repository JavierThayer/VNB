(define (msp-eq-of-lt-succ! j n)     ; j, n in NN, j < succ n, NOT j < n in context: j = n
  (dk-cite! 'nn-in-rr j) (dk-cite! 'nn-in-rr n)
  (dk-cite! 'nn-succ-closed n) (dk-cite! 'nn-succ-plus-one n) (dk-cite! 'nn-in-rr (list 'succ n))
  (mr-chain! (dk-cite! 'nn-lt-succ-le j (list 'succ n)))
  (dk-cite! 'nn-succ-closed j) (dk-cite! 'nn-succ-plus-one j) (dk-cite! 'nn-in-rr (list 'succ j))
  (mr-chain! (dk-cite! 'nn-not-lt-le j n))
  (dk-have! (list '<= j n) (lambda () (dk-ineq! (list '<= (list 'succ j) (list 'succ n)) (list '= (list 'succ j) (list '+ j 1))
                                                (list '= (list 'succ n) (list '+ n 1)) (list 'IN j 'RR) (list 'IN n 'RR)
                                                (list 'IN (list 'succ j) 'RR) (list 'IN (list 'succ n) 'RR))))
  (dk-have! (list '= j n) (lambda () (mr-chain! (dk-cite! 'nn-le-antisym j n)) (mr-close-open!))))
(define msp-PF '(FUN NN (FUN NN NN)))
(define msp-y '(VNB-LAMBDA lyj_ NN ((P (succ lyj_)) lyj_)))
(define msp-h2 (list 'FORALL 'lqn_ (list 'IMPLIES '(IN lqn_ NN) (msp-agree '(P (succ lqn_)) '(P lqn_) 'lqn_))))
(define msp-coh '(FORALL lqn_ (IMPLIES (IN lqn_ NN) (FORALL lqj_ (IMPLIES (IN lqj_ NN) (IMPLIES (< lqj_ lqn_) (= ((P lqn_) lqj_) ((P (succ lqj_)) lqj_))))))))
(sp (make-wff (list 'FORALL 'P (list 'IMPLIES (list 'IN 'P msp-PF) (list 'IMPLIES msp-h2
  (list 'AND (list 'IN msp-y msp-F) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '= (list 'CYL msp-y 'n) '(CYL (P n) n))))))))))
