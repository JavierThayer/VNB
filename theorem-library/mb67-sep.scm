      (mr-iff-parts! (dk-cite! 'complement-in-membership '(PTS s) 'e x))
      (ai (list 'NOT (list 'IN x 'e))))))
(dk-cite! 'souslin-or-empty-separation 's 'e msp-ce)
(define msp-c26 (dk-skolem! (car (mr-iff-parts! (dk-cite! 'borel-separated 's 'e msp-ce)))))
(dk-split-all!)
(mr-ext2! 'e msp-c26
  (lambda (x) (dk-cite! 'subset-mem-fwd 'e msp-c26 x) (mr-close-open!))
  (lambda (x)
    (msp-borel-pts! msp-c26 x)
    (pbc)
