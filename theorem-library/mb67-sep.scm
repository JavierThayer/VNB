(dk-have! (list 'IN msp-y msp-F)
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((j (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (dk-cite! 'nn-succ-closed j)
                                 (msp-Pv! (list 'succ j) j)
                                 (msp-close-at! kn))))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! msp-coh
  (lambda ()
    (let ((br (use-induction)))
      (dk-focus! (cdr (assq 'base br)))
      (let* ((lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
        (dk-cite! 'nn-in-rr j) (dk-cite! 'nn-zero-le j)
        (pbc) (dk-absurd! lt (list '<= 0 j) (list 'IN j 'RR)))
      (dk-focus! (cdr (assq 'step br)))
      (let* ((k (cdr (assq 'var br))) (ih (cdr (assq 'ih br)))
             (lj (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) lj)) (j (cadr lt)))
        (dk-cite! 'nn-succ-closed k)
        (dk-cite! 'nn-succ-closed j)
        (msp-Pv! (list 'succ k) j) (msp-Pv! k j) (msp-Pv! (list 'succ j) j)
