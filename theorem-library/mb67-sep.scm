      (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
      (mr-iff-back! iff))
    (dk-apply! (mr-find 'dj (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f msp-c26) (dk-contains? f 'NOT))) (dk-asms)) x)
    (ai (list 'NOT (list 'IN x msp-c26)))))
(subst (list '= 'e msp-c26))
(mr-close-open!)
(qed 'souslin-complement-borel)
