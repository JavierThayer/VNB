;;; gn-jac.scm -- Proposition 1.41 of F. J. Thayer, "Banach Algebras and Applications", ch. 1: in a unital
;;; involutive Banach algebra, sigma(xy) and sigma(yx) agree off 0.  Agent BA-1117-GN, wave 2026-11-17.
;;; All proofs modulo 0.  Destination: theorem-library/gn-jac.scm, after gn-onto (spectrum-unfold).
;;; Library: operator-algebras.  Helper prefix gnj-.  No binders.
;;;
;;; THE ROUTE.  For z /= 0 put w = z1 - yx, s = z1 - xy.  If u inverts w then v = z^-1 (1 + x u y) inverts s:
;;; s x = x w and y s = w y, so s (x u y) = x (w u) y = x y and (x u y) s = x (u w) y = x y; hence
;;; s (1 + x u y) = s + x y = z 1 = (1 + x u y) s, and v = z^-1 (1 + x u y).

(define (gnj-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-jac: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 300)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-jac: unfinished" name))))
(define (gnj-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gnj-ass!) (if (and (gnj-open?) (dk-asm? (dk-goal))) (ass)))
(define (gnj-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gnj-m p q) (list '(VMUL a) p q))
(define (gnj-ad p q) (list '(VADD a) p q))
(define (gnj-ng p) (list '(VNEG a) p))
(define (gnj-ac c p) (list '(ACT a) c p))
(define gnj-1 '(VONE a))
(define (gnj-uvt x)                   ; typing in VEC a, bottom-up (scalars of ACT must be typed in CC)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VONE a)) (dk-cite! 'kal-uiba-vone-in 'a) x)
          ((equal? x '(VZERO a)) (dk-cite! 'kal-uiba-vzero-in 'a) x)
          ((and (pair? x) (equal? (car x) '(VNEG a))) (gnj-uvt (cadr x)) (dk-cite! 'kal-uiba-vneg-in 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (gnj-uvt (cadr x)) (gnj-uvt (caddr x)) (dk-cite! 'kal-uiba-vadd-in 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (gnj-uvt (cadr x)) (gnj-uvt (caddr x)) (dk-cite! 'kal-uiba-vmul-in 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a))) (gnj-uvt (caddr x)) (dk-cite! 'kal-uiba-act-in 'a (cadr x) (caddr x)) x)
          (#t (error "gnj-uvt: cannot type" (expression->string x))))))
(define (gnj-vec? t) (or (memq t '(x y u)) (and (pair? t) (member (car t) '((VADD a) (VMUL a) (VNEG a) (ACT a)))) (equal? t gnj-1)))
(define (gnj-eq! name . args)          ; land the instance of a kal law, its vector arguments typed first
  (for-each (lambda (t) (if (gnj-vec? t) (gnj-uvt t))) args)
  (apply dk-cite! name 'a args))
(define (gnj-rw! name . args) (subst (apply gnj-eq! name args)))
(define (gnj-rrw! name . args)         ; rewrite right to left
  (let* ((e (apply gnj-eq! name args)) (L (cadr e)) (R (caddr e)))
    (dk-have! (list '= R L) (lambda () (subst e) (if (gnj-open?) (rfl))))
    (subst (list '= R L))))
(define (gnj-rfl! t) (if (gnj-open?) (begin (gnj-uvt t) (rfl))))

(define gnj-Z1 (gnj-ac 'z gnj-1))
(define gnj-xy (gnj-m 'x 'y))
(define gnj-yx (gnj-m 'y 'x))
(define gnj-S (gnj-ad gnj-Z1 (gnj-ng gnj-xy)))
(define gnj-W (gnj-ad gnj-Z1 (gnj-ng gnj-yx)))
(define gnj-Q (gnj-m (gnj-m 'x 'u) 'y))
(define gnj-n1 #f)
(define (gnj-setup!)                   ; z in CC, -1 in CC, recip z, its laws
  (let* ((ey (gnj-eq! 'kal-uiba-vneg-act gnj-1)))
    (set! gnj-n1 (cadr (caddr ey)))
    (dk-have! (list 'IN gnj-n1 'CC) (lambda () (arith)))))
(define (gnj-neg-out! p)               ; rewrite (VNEG a) p to ACT(-1, p)
  (gnj-rw! 'kal-uiba-vneg-act p))

(define gnj-core
  (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
    (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
      (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES '(NOT (= z 0))
        (list 'FORALL 'u (list 'IMPLIES '(IN u (VEC a))
          (list 'IMPLIES (list '= (gnj-m 'u '(SHIFT-EL a z ((VMUL a) y x))) gnj-1)
            (list 'IMPLIES (list '= (gnj-m '(SHIFT-EL a z ((VMUL a) y x)) 'u) gnj-1)
              '(IS-INVERTIBLE-EL a (SHIFT-EL a z ((VMUL a) x y)))))))))))))))))
(sp (make-wff gnj-core))
(dk-peel!)
(gnj-setup!)
(let* ((w '(SHIFT-EL a z ((VMUL a) y x))) (s '(SHIFT-EL a z ((VMUL a) x y))))
  (dk-cite! 'bas-shift-unfold 'a 'z gnj-yx)
  (dk-cite! 'bas-shift-unfold 'a 'z gnj-xy)
  (let* ((h1 (dk-rewrite-h! (list '= (gnj-m 'u w) gnj-1) w gnj-W))
         (h2 (dk-rewrite-h! (list '= (gnj-m w 'u) gnj-1) w gnj-W)))
    (subst (list '== s gnj-S))))
(for-each gnj-uvt (list gnj-S gnj-W gnj-Q))
;; E1: s x = x w
(define gnj-E1 (list '= (gnj-m gnj-S 'x) (gnj-m 'x gnj-W)))
(dk-have! gnj-E1
  (lambda ()
    (gnj-rw! 'kal-uiba-mul-dist-r gnj-Z1 (gnj-ng gnj-xy) 'x)
    (gnj-rw! 'kal-uiba-mul-dist-l 'x gnj-Z1 (gnj-ng gnj-yx))
    (gnj-rw! 'kal-uiba-mul-act-l 'z gnj-1 'x)
    (gnj-rw! 'kal-uiba-mul-one-l 'x)
    (gnj-rw! 'kal-uiba-mul-act-r 'z 'x gnj-1)
    (gnj-rw! 'kal-uiba-mul-one-r 'x)
    (gnj-neg-out! gnj-xy) (gnj-neg-out! gnj-yx)
    (gnj-rw! 'kal-uiba-mul-act-l gnj-n1 gnj-xy 'x)
    (gnj-rw! 'kal-uiba-mul-act-r gnj-n1 'x gnj-yx)
    (gnj-rw! 'kal-uiba-mul-assoc 'x 'y 'x)
    (gnj-rfl! (gnj-ad (gnj-ac 'z 'x) (gnj-ac gnj-n1 (gnj-m 'x gnj-yx))))))
;; E2: y s = w y
(define gnj-E2 (list '= (gnj-m 'y gnj-S) (gnj-m gnj-W 'y)))
(dk-have! gnj-E2
  (lambda ()
    (gnj-rw! 'kal-uiba-mul-dist-l 'y gnj-Z1 (gnj-ng gnj-xy))
    (gnj-rw! 'kal-uiba-mul-dist-r gnj-Z1 (gnj-ng gnj-yx) 'y)
    (gnj-rw! 'kal-uiba-mul-act-r 'z 'y gnj-1)
    (gnj-rw! 'kal-uiba-mul-one-r 'y)
    (gnj-rw! 'kal-uiba-mul-act-l 'z gnj-1 'y)
    (gnj-rw! 'kal-uiba-mul-one-l 'y)
    (gnj-neg-out! gnj-xy) (gnj-neg-out! gnj-yx)
    (gnj-rw! 'kal-uiba-mul-act-r gnj-n1 'y gnj-xy)
    (gnj-rw! 'kal-uiba-mul-act-l gnj-n1 gnj-yx 'y)
    (gnj-rw! 'kal-uiba-mul-assoc 'y 'x 'y)
    (gnj-rfl! (gnj-ad (gnj-ac 'z 'y) (gnj-ac gnj-n1 (gnj-m 'y gnj-xy))))))
;; E3: s (x u y) = x y
(define gnj-E3 (list '= (gnj-m gnj-S gnj-Q) gnj-xy))
(dk-have! gnj-E3
  (lambda ()
    (gnj-rrw! 'kal-uiba-mul-assoc gnj-S (gnj-m 'x 'u) 'y)
    (gnj-rrw! 'kal-uiba-mul-assoc gnj-S 'x 'u)
    (subst gnj-E1)
    (gnj-rw! 'kal-uiba-mul-assoc 'x gnj-W 'u)
    (subst (list '= (gnj-m gnj-W 'u) gnj-1))
    (gnj-rw! 'kal-uiba-mul-one-r 'x)
    (gnj-rfl! gnj-xy)))
;; E4: (x u y) s = x y
(define gnj-E4 (list '= (gnj-m gnj-Q gnj-S) gnj-xy))
(dk-have! gnj-E4
  (lambda ()
    (gnj-rw! 'kal-uiba-mul-assoc (gnj-m 'x 'u) 'y gnj-S)
    (subst gnj-E2)
    (gnj-rw! 'kal-uiba-mul-assoc 'x 'u (gnj-m gnj-W 'y))
    (gnj-rrw! 'kal-uiba-mul-assoc 'u gnj-W 'y)
    (subst (list '= (gnj-m 'u gnj-W) gnj-1))
    (gnj-rw! 'kal-uiba-mul-one-l 'y)
    (gnj-rfl! gnj-xy)))
;; E5: s + x y = z 1
(define gnj-E5 (list '= (gnj-ad gnj-S gnj-xy) gnj-Z1))
(dk-have! gnj-E5
  (lambda ()
    (gnj-rw! 'kal-uiba-add-assoc gnj-Z1 (gnj-ng gnj-xy) gnj-xy)
    (subst (dk-cite! 'ring-add-left-inv-uba-as-ring-uiba-as-uba 'a gnj-xy))
    (gnj-rw! 'kal-uiba-add-zero-r gnj-Z1)
    (gnj-rfl! gnj-Z1)))
;; the inverse
(gnj-cite2! 'cc-recip-closed 'z)
(gnj-cite2! 'cc-recip-inverse 'z)
(define gnj-r '(RECIP z))
(dk-have! (list '= (list '* gnj-r 'z) 1)
  (lambda () (dk-have! (list '= (list '* gnj-r 'z) (list '* 'z gnj-r)) (lambda () (crs)))
             (subst (list '= (list '* gnj-r 'z) (list '* 'z gnj-r))) (gnj-ass!)))
(define gnj-P (gnj-ad gnj-1 gnj-Q))
(define gnj-V (gnj-ac gnj-r gnj-P))
(gnj-uvt gnj-V)
(define (gnj-tail!)                    ; goal ACT(r, z1) = 1 after the E's
  (dk-have! (list 'IN (list '* gnj-r 'z) 'CC) (lambda () (subst (list '= (list '* gnj-r 'z) 1)) (arith)))
  (gnj-rrw! 'kal-uiba-act-mul gnj-r 'z gnj-1)
  (subst (list '= (list '* gnj-r 'z) 1))
  (gnj-rw! 'kal-uiba-act-one gnj-1)
  (gnj-rfl! gnj-1))
(dk-have! (list '= (gnj-m gnj-S gnj-V) gnj-1)
  (lambda ()
    (gnj-rw! 'kal-uiba-mul-act-r gnj-r gnj-S gnj-P)
    (gnj-rw! 'kal-uiba-mul-dist-l gnj-S gnj-1 gnj-Q)
    (gnj-rw! 'kal-uiba-mul-one-r gnj-S)
    (subst gnj-E3)
    (subst gnj-E5)
    (gnj-tail!)))
(dk-have! (list '= (gnj-m gnj-V gnj-S) gnj-1)
  (lambda ()
    (gnj-rw! 'kal-uiba-mul-act-l gnj-r gnj-P gnj-S)
    (gnj-rw! 'kal-uiba-mul-dist-r gnj-1 gnj-Q gnj-S)
    (gnj-rw! 'kal-uiba-mul-one-l gnj-S)
    (subst gnj-E4)
    (subst gnj-E5)
    (gnj-tail!)))
(gnj-cite2! 'bcp-u-bae-invertible-intro 'a gnj-S gnj-V)
(gnj-ass!)
(gnj-qed! 'jacobson-shift-core)

;;; z - yx invertible implies z - xy invertible, for z /= 0
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL y (IMPLIES (IN y (VEC a))
    (FORALL z (IMPLIES (IN z CC) (IMPLIES (NOT (= z 0))
      (IMPLIES (IS-INVERTIBLE-EL a (SHIFT-EL a z ((VMUL a) y x))) (IS-INVERTIBLE-EL a (SHIFT-EL a z ((VMUL a) x y)))))))))))))))
(dk-peel!)
(let ((w '(SHIFT-EL a z ((VMUL a) y x))))
  (dk-split-all! (list (dk-cite! 'bcp-u-bae-inverse-prop 'a w)))
  (gnj-cite2! 'jacobson-shift-core 'a 'x 'y 'z (list 'INVERSE-EL 'a w))
  (gnj-ass!))
(gnj-qed! 'jacobson-shift)

;;; 1.41: sigma(xy) and sigma(yx) agree off 0
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL y (IMPLIES (IN y (VEC a))
    (FORALL z (IMPLIES (IN z CC) (IMPLIES (NOT (= z 0))
      (IFF (IN z (SPECTRUM a ((VMUL a) x y))) (IN z (SPECTRUM a ((VMUL a) y x)))))))))))))))
(dk-peel!)
(define (gnj-dir! p q)                 ; goal z in S(pq) given z in S(qp)
  (let* ((pq (gnj-m p q)) (qp (gnj-m q p))
         (sq (list 'SPECTRUM 'a qp))
         (h (dk-rewrite-h! (list 'IN 'z sq) sq (caddr (dk-cite! 'spectrum-unfold 'a qp)))))
    (sep-me h) (dk-split-all!)
    (gnj-uvt pq)
    (subst (dk-cite! 'spectrum-unfold 'a pq))
    (in-sep! (lambda () (gnj-ass!))
      (lambda ()
        (let ((imp (dk-cite! 'jacobson-shift 'a q p 'z))
              (nh (list 'NOT (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a 'z qp)))))
          (if (dk-only! imp nh) (prop)))))))
(gnj-uvt gnj-xy) (gnj-uvt gnj-yx)
(dk-iff! (lambda (g) (dk-contains? g gnj-xy))
  (lambda () (gnj-dir! 'x 'y))
  (lambda () (gnj-dir! 'y 'x)))
(gnj-qed! 'spectrum-mul-commute-off-zero)
