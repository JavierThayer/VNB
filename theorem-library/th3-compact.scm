      (tqa-pts-pt! 'w a) (tqa-pts-pt! 'w b) (tqa-pts-pt! 'w l1)
      (dk-cite! 'ip-metric-space-is-metric-space 'w)
      (let* ((dab (list (list 'DIST M) a b))
