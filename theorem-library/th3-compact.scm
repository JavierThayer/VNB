  (dk-have! (tqa-sepc 'v 't_ 'e 'd_)
    (lambda ()
      (let* ((lk (dk-peel!))
             (lt (find-first (lambda (h) (dk-head-is? h '<)) lk))
             (i (cadr lt)) (j (caddr lt))
             (ei (list 'e i)) (ej (list 'e j)) (a (list 'lm i)) (b (list 'lm j)))
