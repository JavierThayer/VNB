(sp (make-wff (forall-guarded '(v w t_) '((IS-COMPACT-OP v w t_)) '(IN t_ (BOUNDED-OPS v w)))))
(dk-peel!)
(tqa-iff-fwd! 'is-compact-op 'v 'w 't_)
(ass)
(tqa-qed! 'compact-op-bounded)

;;; --- the sum ---------------------------------------------------------------------------------
(sp (make-wff (forall-guarded '(v w s_ t_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IS-COMPACT-OP v w s_) (IS-COMPACT-OP v w t_))
  '(IS-COMPACT-OP v w (BOP-SUM v w s_ t_)))))
(dk-peel!)
(dk-cite! 'compact-op-bounded 'v 'w 's_)
(dk-cite! 'compact-op-bounded 'v 'w 't_)
(dk-cite! 'bop-fun 'v 'w 's_)
(dk-cite! 'bop-fun 'v 'w 't_)
(dk-cite! 'bop-sum-bounded 'v 'w 's_ 't_)
(tqa-intro! 'v 'w '(BOP-SUM v w s_ t_)
  (lambda (f bd)
    (let* ((r1 (tqa-seq! 'v 'w 's_ f))
           (phi1 (car r1)) (l1 (cadr r1)) (u1 (caddr r1))
           (g (list 'VNB-LAMBDA 'gq_ 'NN (list f (list phi1 'gq_)))))
      (tqa-lam-t! g '(VEC v))
      (dk-have! (tqa-bound 'v g)
        (lambda () (let ((k (dk-di-var!)))
                     (tqa-type-apps! (dk-goal)) (dk-lam-b!) (tqa-type-apps! (dk-goal))
                     (dk-apply! bd (list phi1 k)) (ass))))
      (let* ((r2 (tqa-seq! 'v 'w 't_ g))
             (phi2 (car r2)) (l2 (cadr r2)) (u2 (caddr r2))
             (psi (list 'VNB-LAMBDA 'tqk_ 'NN (list phi1 (list phi2 'tqk_))))
             (cs1 (list 'VNB-LAMBDA 'tqn_ 'NN (list 's_ (list f (list phi1 'tqn_)))))
             (cs2 (list 'VNB-LAMBDA 'tqn_ 'NN (list 's_ (list f (list phi1 (list phi2 'tqn_))))))
             (ct  (list 'VNB-LAMBDA 'tqn_ 'NN (list 't_ (list f (list phi1 (list phi2 'tqn_)))))))
        (dk-cite! 'strictly-mono-compose phi1 phi2)
        (tqa-use-u! u1 cs1 (lambda (n) (list 's_ (list f (list phi1 n)))) (lambda (k) #t) '(VEC w))
        (tqa-lam-t! cs2 '(VEC w))
        (tqa-pts-fun! 'w cs2)
        (tqa-ptw! cs2 (lambda (n) (list cs1 (list phi2 n))) (lambda (k) #t))
        (dk-cite! 'converges-reindex-ptwise (tqa-M 'w) cs1 cs2 phi2 l1)
        (tqa-use-u! u2 ct (lambda (n) (list 't_ (list g (list phi2 n)))) (lambda (k) #t) '(VEC w))
        (tqa-lim-t! 'w cs2 l1) (tqa-lim-t! 'w ct l2)
        (dk-cite! 'cips-vadd-type 'w l1 l2)
        (tqa-seqc-witness! psi (list '(VADD w) l1 l2)
          (lambda (b eqb)
            (tqa-ptw! b (lambda (n) (list '(VADD w) (list cs2 n) (list ct n)))
              (lambda (k)
                (tqa-sub-eq! eqb k)
                (tqa-type-apps! (dk-goal))
                (dk-lam-b!)
                (tqa-type-apps! (dk-goal))
                (subst (dk-cite! 'bop-sum-apply 'v 'w 's_ 't_ (list f (list phi1 (list phi2 k)))))))
            (dk-cite! 'ipc-sum 'w cs2 ct b l1 l2)
            (ass)))))))
(tqa-qed! 'compact-op-sum)

;;; --- the scalar multiple ---------------------------------------------------------------------
(sp (make-wff (forall-guarded '(v w c_ t_)
