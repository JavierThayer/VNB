(tqa-try "no-separated" (lambda ()
(let* ((sep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'd_))) "the separation"))
       (r1 (begin (dk-cite! 'compact-op-bounded 'v 'w 't_) (dk-cite! 'bop-fun 'v 'w 't_)
                  (tqa-seq! 'v 'w 't_ 'f)))
       (phi (car r1)) (l1 (cadr r1)) (u1 (caddr r1))
       (ct (list 'VNB-LAMBDA 'tqn_ 'NN (list 't_ (list 'f (list phi 'tqn_)))))
       (cv (tqa-use-u! u1 ct (lambda (n) (list 't_ (list 'f (list phi n)))) (lambda (k) #t) '(VEC w)))
       (ptw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ct) (dk-contains? h phi)
                                      (not (dk-contains? h l1))))
                     "the pointwise values"))
       (smc (caddr (caddr (dk-cite! 'strictly-mono-nn phi))))
       (h1 (dk-halve! 'd_))
       (h2 (dk-halve! h1))
       (r (tqa-iff-fwd! 'converges-to (tqa-M 'w) ct l1))
       (cl (caddr (caddr (caddr r))))
       (nN (dk-skolem! (dk-apply! cl h2)))
       (tail (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq nN (free-vars h)))) "the tail"))
       (sN (list 'succ nN))
