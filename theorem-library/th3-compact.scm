;;; ==========================================================================================
;;; (A5) SELF-ADJOINT OPERATORS: EIGENVALUES ARE REAL (conjugate-fixed); EIGENVECTORS OF
;;; DISTINCT EIGENVALUES ARE ORTHOGONAL (Teorema 3.1 (i)-(ii), pointwise and eigenspace forms).
;;; ==========================================================================================

;;; close the focus leaf after THUNK by reflexivity if it is still open
(define (tqa-then-rfl! thunk)
  (dk-close-if! thunk (lambda () (tqa-type-ips! (dk-goal)) (rfl))))

;;; with (= (t_ X) ((ACT v) C X)) in context: <t X | Y> = C <X|Y>
(define (tqa-ev-left! x c y)
  (let ((g (list '= (tqa-ip (list 't_ x) y) (list '* c (tqa-ip x y)))))
    (dk-have! g
      (lambda ()
        (tqa-then-rfl!
          (lambda ()
            (subst (list '= (list 't_ x) (tqa-act c x)))
            (subst (dk-cite! 'cips-ip-homog-left 'v c x y))))))
    g))
;;; with (= (t_ Y) ((ACT v) C Y)) in context: <X | t Y> = conj(C) <X|Y>
(define (tqa-ev-right! x c y)
  (let ((g (list '= (tqa-ip x (list 't_ y)) (list '* (list 'conjugate c) (tqa-ip x y)))))
    (dk-have! g
      (lambda ()
        (tqa-then-rfl!
          (lambda ()
            (subst (list '= (list 't_ y) (tqa-act c y)))
            (subst (dk-cite! 'cips-ip-conj-homog-right 'v c x y))))))
    g))

;;; sa-eigenvalue-real
(sp (make-wff (forall-guarded '(v t_ c_ x_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SELF-ADJOINT-OP v t_) (IN c_ CC) (IN x_ (VEC v))
    (NOT (= x_ (VZERO v))) (= (t_ x_) ((ACT v) c_ x_)))
  '(= c_ (conjugate c_)))))
(dk-peel!)
(let* ((sa (tqa-iff-fwd! 'is-self-adjoint-op 'v 't_))
       (cl (caddr sa))
       (p (tqa-ip 'x_ 'x_)))
  (dk-cite! 'bop-fun 'v 'v 't_)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) 'x_)
  (tqa-ct! p)
  (tqa-ct! '(conjugate c_))
  (let* ((e3 (dk-apply! cl 'x_ 'x_))
         (e1 (tqa-ev-left! 'x_ 'c_ 'x_))
         (e2 (tqa-ev-right! 'x_ 'c_ 'x_))
         (d '(- c_ (conjugate c_))))
    (dk-have! (list '= (list '* 'c_ p) (list '* '(conjugate c_) p))
      (lambda ()
        (subst (list '= (list '* 'c_ p) (tqa-ip '(t_ x_) 'x_)))
        (subst (list '= (list '* '(conjugate c_) p) (tqa-ip 'x_ '(t_ x_))))
        (ass)))
    (tqa-ct! d)
    (let ((ex (have-f! (list '= (list '* d p) (list '- (list '* 'c_ p) (list '* '(conjugate c_) p)))
                (lambda () (crs)))))
      (dk-have! (list '= (list '* d p) 0)
        (lambda ()
          (subst ex)
          (subst (list '= (list '* 'c_ p) (list '* '(conjugate c_) p)))
          (tqa-ct! (list '* '(conjugate c_) p))
          (crs))))
    (dk-have! (list 'NOT (list '= p 0))
      (lambda ()
        (di)
        (tqa-iff-fwd! 'cips-ip-definite 'v 'x_)
        (ai '(NOT (= x_ (VZERO v))))))
    (dk-cite! 'cc-mul-zero-left d p)
    (dk-cite! 'cc-sub-zero-eq 'c_ '(conjugate c_))
    (ass)))
(tqa-qed! 'sa-eigenvalue-real)

;;; sa-eigenvectors-orthogonal
(sp (make-wff (forall-guarded '(v t_ a_ b_ x_ y_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SELF-ADJOINT-OP v t_) (IN a_ CC) (IN b_ CC)
    (= b_ (conjugate b_)) (NOT (= a_ b_)) (IN x_ (VEC v)) (IN y_ (VEC v))
    (= (t_ x_) ((ACT v) a_ x_)) (= (t_ y_) ((ACT v) b_ y_)))
