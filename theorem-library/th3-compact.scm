;;; THE POINTWISE FORM OF COMPACTNESS
(define (tqa-bound v f)
  (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '<= (list 'IP-NORM v (list f 'nq_)) 1))))
(define (tqa-seqc v w t f)
  (list 'FORSOME 'phq_ (list 'AND '(STRICTLY-MONO-NN phq_)
    (list 'FORSOME 'lq_ (list 'FORALL 'bq_ (list 'IMPLIES (list 'IN 'bq_ (list 'FUN 'NN (list 'VEC w)))
      (list 'IMPLIES (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= '(bq_ nq_) (list t (list f '(phq_ nq_))))))
        (list 'CONVERGES-TO (tqa-M w) 'bq_ 'lq_))))))))

;;; compact-op-seq
(sp (make-wff (forall-guarded '(v w t_ f)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IS-COMPACT-OP v w t_) '(IN f (FUN NN (VEC v))) (tqa-bound 'v 'f))
  (tqa-seqc 'v 'w 't_ 'f))))
(dk-peel!)
(let* ((r (tqa-iff-fwd! 'is-compact-op 'v 'w 't_))
       (cl (caddr r))
       (ex (dk-apply! cl 'f))
       (phi (dk-skolem! ex))
       (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (memq phi (free-vars f)))) "the limit"))
       (lim (dk-skolem! ex2))
       (cv (dk-pick (lambda (f) (and (dk-head-is? f 'CONVERGES-TO) (memq lim (free-vars f)))) "the convergence"))
       (lam (caddr cv)))
  (tqa-iff-fwd! 'strictly-mono-nn phi)
  (dk-cite! 'bop-fun 'v 'w 't_)
  (witness! phi
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'STRICTLY-MONO-NN) (ass)
              (witness! lim
                (lambda ()
                  (let* ((lk (dk-peel!))
                         (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'FUN))) lk)))
                         (eqb (find-first (lambda (f) (dk-head-is? f 'FORALL)) lk)))
                    (tqa-pts-fun! 'w b)
                    (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list b 'n_) (list lam 'n_))))
                      (lambda ()
                        (let* ((lk2 (dk-peel!))
                               (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2))))
                          (subst (dk-apply! eqb k))
                          (dk-cite! 'fun-apply-type-c phi 'NN 'NN k)
                          (dk-cite! 'fun-apply-type-c 'f 'NN '(VEC v) (list phi k))
                          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (list 'f (list phi k)))
                          (if (not (dk-lam-b!)) (rfl)))))
                    (dk-cite! 'converges-ptwise-eq (tqa-M 'w) lam b lim)
                    (ass))))))))))
(tqa-qed! 'compact-op-seq)

;;; compact-op-intro
(sp (make-wff (forall-guarded '(v w t_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IN t_ (BOUNDED-OPS v w))
        (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN (VEC v)))
          (list 'IMPLIES (tqa-bound 'v 'f) (tqa-seqc 'v 'w 't_ 'f)))))
  '(IS-COMPACT-OP v w t_))))
(dk-peel!)
(let* ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'phq_))) "the sequence clause"))
       (iff (dk-cite! 'is-compact-op 'v 'w 't_))
       (cl (caddr (caddr iff))))
  (dk-cite! 'bop-fun 'v 'w 't_)
  (dk-have! cl
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk)))
        (dk-have! (tqa-bound 'v f) (lambda () (ass)))
        (let* ((ex (dk-apply! hyp f))
               (phi (dk-skolem! ex))
               (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phi (free-vars x)))) "the limit"))
               (lim (dk-skolem! ex2))
               (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq lim (free-vars x)))) "the limit clause"))
               (lam (list 'VNB-LAMBDA 'kqn_ 'NN (list 't_ (list f (list phi 'kqn_))))))
          (tqa-iff-fwd! 'strictly-mono-nn phi)
          (dk-have! (list 'IN lam (list 'FUN 'NN '(VEC w)))
            (lambda ()
              (dk-lam-type!
                (lambda () (let ((k (dk-di-var!)))
                             (dk-cite! 'fun-apply-type-c phi 'NN 'NN k)
                             (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list phi k))
                             (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (list f (list phi k)))
                             (ass)))
                (lambda () (fact 'nn-is-set) (ass)))))
          (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list lam 'nq_) (list 't_ (list f (list phi 'nq_))))))
            (lambda ()
              (let ((k (dk-di-var!)))
                (dk-cite! 'fun-apply-type-c phi 'NN 'NN k)
                (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list phi k))
                (if (not (dk-lam-b!)) (rfl)))))
          (dk-apply! ucl lam)
          (witness! phi
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'STRICTLY-MONO-NN) (ass)
                      (witness! lim (lambda () (ass))))))))))))
  (tqa-iff-bwd! 'is-compact-op 'v 'w 't_)
  (ass))
(tqa-qed! 'compact-op-intro)
;;; ==========================================================================================
;;; (A3) K(v, w) IS A SUBSPACE; K(H) IS A TWO-SIDED IDEAL OF B(H).
;;; ==========================================================================================

;;; --- drive helpers ------------------------------------------------------------------------
;;; a subterm of E that is a beta redex ((VNB-LAMBDA ..) a)
(define (tqa-has-redex? e)
  (and (pair? e)
       (or (and (pair? (car e)) (eq? (car (car e)) 'VNB-LAMBDA))
           (and (not (eq? (car e) 'VNB-LAMBDA)) (any (lambda (x) (tqa-has-redex? x)) e)))))
;;; land (IN e C) for an application (h a) with (IN h (FUN D C)) in context, typing a first
(define (tqa-vop? e op) (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (= (length (car e)) 2)))
(define (tqa-app-t! e)
  (cond ((not (pair? e)) #f)
        ((and (tqa-vop? e 'ACT) (= (length e) 3))
         (let ((sp (cadr (car e))))
           (tqa-app-t! (cadr e)) (tqa-app-t! (caddr e))
           (if (and (not (dk-asm? (list 'IN (cadr e) 'CC))) (dk-asm? (list 'IN (cadr e) 'RR)))
               (dk-cite! 'rr-subset-cc (cadr e)))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp))))
                    (dk-asm? (list 'IN (cadr e) 'CC)) (dk-asm? (list 'IN (caddr e) (list 'VEC sp))))
               (dk-cite! 'cips-act-type sp (cadr e) (caddr e)))
           (list 'VEC sp)))
        ((and (tqa-vop? e 'VADD) (= (length e) 3))
         (let ((sp (cadr (car e))))
           (tqa-app-t! (cadr e)) (tqa-app-t! (caddr e))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp))))
                    (dk-asm? (list 'IN (cadr e) (list 'VEC sp))) (dk-asm? (list 'IN (caddr e) (list 'VEC sp))))
               (dk-cite! 'cips-vadd-type sp (cadr e) (caddr e)))
           (list 'VEC sp)))
        ((and (tqa-vop? e 'VNEG) (= (length e) 2))
         (let ((sp (cadr (car e))))
           (tqa-app-t! (cadr e))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp)))) (dk-asm? (list 'IN (cadr e) (list 'VEC sp))))
               (dk-cite! 'cips-vneg-type sp (cadr e)))
           (list 'VEC sp)))
        ((and (symbol? (car e)) (= (length e) 2))
         (let ((ft (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) (car e))
                                                (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                                (= (length (caddr h)) 3)))
                               (dk-asms))))
           (if ft
               (let ((d (cadr (caddr ft))) (c (caddr (caddr ft))))
                 (tqa-app-t! (cadr e))
                 (if (dk-asm? (list 'IN e c)) c
                     (if (dk-asm? (list 'IN (cadr e) d))
                         (begin (dk-cite! 'fun-apply-type-c (car e) d c (cadr e)) c)
                         #f)))
               #f)))
        (#t #f)))
;;; type every symbol-headed application in E (not under a VNB-LAMBDA)
(define (tqa-type-apps! e)
  (cond ((not (pair? e)) #t)
        ((eq? (car e) 'VNB-LAMBDA) #t)
        (#t (for-each tqa-type-apps! e) (tqa-app-t! e))))
;;; close an equation goal by beta and reflexivity, typing as needed
(define (tqa-beta-close!)
  (tqa-type-apps! (dk-goal))
  (let ((done (if (tqa-has-redex? (dk-goal)) (dk-lam-b!) #f)))
    (if (not done)
        (begin (tqa-type-apps! (dk-goal))
               (if (tqa-has-redex? (dk-goal)) (set! done (dk-lam-b!)))
               (if (not done) (begin (tqa-type-apps! (dk-goal)) (rfl)))))))
;;; (FORALL nq_ (IMPLIES (IN nq_ NN) (= (b nq_) RHS(nq_)))) landed, PRE run after the peel
(define (tqa-ptw! b rhs-of pre)
  (let ((f (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list b 'nq_) (rhs-of 'nq_))))))
    (dk-have! f (lambda () (let ((k (dk-di-var!))) (pre k) (tqa-beta-close!))))
    f))
;;; type a lambda sequence into FUN(NN, C)
(define (tqa-lam-t! lam c)
  (let ((g (list 'IN lam (list 'FUN 'NN c))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((k (dk-di-var!)))
                           (tqa-type-apps! (dk-goal))
                           (if (tqa-has-redex? (dk-goal)) (dk-lam-b!))
                           (tqa-type-apps! (dk-goal)) (ass)))
              (lambda () (fact 'nn-is-set) (ass))))))
    g))
;;; compact-op-seq at (v w t f): skolemised; returns (phi lim U)
(define (tqa-seq! v w t f)
  (let* ((ex (dk-cite! 'compact-op-seq v w t f))
         (phi (dk-skolem! ex))
         (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phi (free-vars x)))) "the limit"))
         (lim (dk-skolem! ex2))
         (u (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq lim (free-vars x)))) "the limit clause")))
    (tqa-iff-fwd! 'strictly-mono-nn phi)
    (list phi lim u)))
;;; U applied to the lambda sequence LAM whose n-th term is RHS(n): CONVERGES-TO landed
(define (tqa-use-u! u lam rhs-of pre c)
  (tqa-lam-t! lam c)
  (tqa-ptw! lam rhs-of pre)
  (dk-apply! u lam))
;;; the clause of compact-op-intro, proved by BODY run on (f . bound) after the peel
(define (tqa-intro-clause v w t)
  (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f (list 'FUN 'NN (list 'VEC v)))
    (list 'IMPLIES (tqa-bound v 'f) (tqa-seqc v w t 'f)))))
(define (tqa-intro! v w t body)
  (dk-have! (tqa-intro-clause v w t)
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk)))
        (tqa-try "intro-body" (lambda () (body f bd))))))
  (dk-cite! 'compact-op-intro v w t)
  (ass))
;;; inside a seqc goal: witness PHI, then the limit LIM, peel b; BODY run on (b eqb)
(define (tqa-seqc-witness! phi lim body)
  (witness! phi
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'STRICTLY-MONO-NN) (ass)
              (witness! lim
                (lambda ()
                  (let* ((lk (dk-peel!))
                         (b (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
                         (eqb (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk)))
                    (body b eqb))))))))))
(define (tqa-sub-eq! eqb k) (subst (dk-apply! eqb k)))
;;; with (CONVERGES-TO M_w seq lim) in context: land (IN lim (VEC w))
(define (tqa-lim-t! w seq lim)
  (dk-have! (list 'IN lim (list 'PTS (tqa-M w)))
    (lambda () (tqa-iff-fwd! 'converges-to (tqa-M w) seq lim) (ass)))
  (tqa-vec-pt! w lim))

