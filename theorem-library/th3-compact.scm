;;; compact-op-eigen-not-separated: Teorema 3.1 (iv), essence.  An orthonormal sequence of
;;; eigenvectors e_n of a compact T, T e_n = lm_n e_n, cannot have d <= |lm_n| for a d > 0.
(sp (make-wff (forall-guarded '(v t_ e lm d_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IN e (FUN NN (VEC v))) (IN lm (FUN NN CC))
    (FORALL un_ (IMPLIES (IN un_ NN) (= (IP-NORM v (e un_)) 1)))
    (FORALL oi_ (IMPLIES (IN oi_ NN) (FORALL oj_ (IMPLIES (IN oj_ NN) (IMPLIES (< oi_ oj_) (= ((IP v) (e oi_) (e oj_)) 0))))))
    (FORALL en_ (IMPLIES (IN en_ NN) (= (t_ (e en_)) ((ACT v) (lm en_) (e en_)))))
    (POS-RR d_)
    (FORALL ln_ (IMPLIES (IN ln_ NN) (<= d_ (magnitude (lm ln_))))))
  'FALSITY)))
(dk-peel!)
