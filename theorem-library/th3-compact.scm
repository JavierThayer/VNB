(sp (make-wff (forall-guarded '(v s_ t_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IN s_ (BOUNDED-OPS v v)))
  '(IS-COMPACT-OP v v (BOP-COMP v t_ s_)))))
(dk-peel!)
(dk-cite! 'compact-op-bounded 'v 'v 't_)
(dk-cite! 'bop-fun 'v 'v 's_)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'bop-comp-bounded 'v 't_ 's_)
