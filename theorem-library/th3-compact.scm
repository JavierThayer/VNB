;;; Library: operator-algebras.

;;; tqa helpers: copies of ba-bh2.scm's bb2- helpers (themselves copies of ba-bh.scm's bbh- and hilbert-projection.scm's hpr- kit), prefix tqa-.
(define tqa-v 'v)
(define (tqa-ip a b) (list (list 'IP tqa-v) a b))
(define (tqa-sub a b) (list (list 'VADD tqa-v) a (list (list 'VNEG tqa-v) b)))
(define (tqa-add a b) (list (list 'VADD tqa-v) a b))
(define (tqa-act c a) (list (list 'ACT tqa-v) c a))
(define (tqa-q a) (tqa-ip a a))

(define (tqa-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) tqa-v)))
(define (tqa-zero? e) (equal? e (list 'VZERO tqa-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (tqa-vt! e)
  (let ((goal (list 'IN e (list 'VEC tqa-v))))
    (cond ((and (dk-asm? goal) (not (or (tqa-op? e 'VADD) (tqa-op? e 'VNEG) (tqa-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((tqa-op? e 'VADD) (tqa-vt! (cadr e)) (tqa-vt! (caddr e)))
                 ((tqa-op? e 'VNEG) (tqa-vt! (cadr e)))
                 ((tqa-op? e 'ACT)  (tqa-ct! (cadr e)) (tqa-vt! (caddr e))))
           goal)
          ((tqa-op? e 'VADD) (tqa-vt! (cadr e)) (tqa-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type tqa-v (cadr e) (caddr e)) goal)
          ((tqa-op? e 'VNEG) (tqa-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type tqa-v (cadr e)) goal)
          ((tqa-op? e 'ACT)  (tqa-ct! (cadr e)) (tqa-vt! (caddr e))
                             (dk-cite! 'cips-act-type tqa-v (cadr e) (caddr e)) goal)
          ((tqa-zero? e) (dk-cite! 'cips-vzero-in tqa-v) goal)
          ((tqa-app-fun e) => (lambda (ft) (tqa-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "tqa-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (tqa-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC tqa-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (tqa-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC tqa-v)) (tqa-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((tqa-v (cadr d))) (tqa-vt! a)))
        (#t (error "tqa-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (tqa-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((tqa-op? c 'IP) (tqa-vt! (cadr c)) (tqa-vt! (caddr c))
                           (dk-cite! 'cips-ip-type tqa-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (tqa-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (tqa-ct! (cadr c)) (tqa-ct! (caddr c))
           (tqa-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (tqa-ct! (cadr c)) (tqa-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (tqa-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (tqa-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (tqa-op? e 'IP) (= (length e) 3)
              (or (tqa-compound? (cadr e)) (tqa-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqa-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (tqa-compound? e)
  (or (tqa-op? e 'VADD) (tqa-op? e 'VNEG) (tqa-op? e 'ACT) (tqa-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (tqa-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (tqa-vt! a) (tqa-vt! b)
    (cond ((tqa-op? a 'VADD) (dk-cite! 'cips-ip-add-left tqa-v (cadr a) (caddr a) b))
          ((tqa-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left tqa-v (cadr a) b))
          ((tqa-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left tqa-v (cadr a) (caddr a) b))
          ((tqa-zero? a)     (dk-cite! 'cips-ip-zero-left tqa-v b))
          ((tqa-op? b 'VADD) (dk-cite! 'cips-ip-add-right tqa-v a (cadr b) (caddr b)))
          ((tqa-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right tqa-v a (cadr b)))
          ((tqa-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right tqa-v (cadr b) a (caddr b)))
          ((tqa-zero? b)     (dk-cite! 'cips-ip-zero-right tqa-v a))
          (#t (error "tqa-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (tqa-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (tqa-op? x 'IP) (= (length x) 3))))))
(define (tqa-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((tqa-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqa-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (tqa-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "tqa-expand!: out of fuel"))
    (let ((r (tqa-find-redex (dk-goal))))
      (if r
          (let ((eq (tqa-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (tqa-find-real-conj (dk-goal))))
            (if c
                (begin
                  (tqa-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (tqa-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((tqa-op? x 'IP)
           (tqa-vt! (cadr x)) (tqa-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym tqa-v (cadr x) (caddr x))
           (subst (list '= c (tqa-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (tqa-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (tqa-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (tqa-ct! (cadr x)) (tqa-ct! (caddr x))
           (tqa-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (tqa-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (tqa-q-facts! u)
  (tqa-vt! u)
  (dk-cite! 'cips-ip-self-real tqa-v u)
  (dk-cite! 'cips-ip-self-nonneg tqa-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (tqa-norm-sq! u)
  (tqa-vt! u)
  (subst (dk-cite! 'ip-norm-unfold tqa-v u))
  (tqa-q-facts! u)
  (tqa-sqrt! (tqa-q u))
  (subst (dk-cite! 'sqrt-sq (tqa-q u))))
(define (tqa-nsq u) (list '* (list 'IP-NORM tqa-v u) (list 'IP-NORM tqa-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (tqa-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (tqa-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (tqa-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (tqa-and (cdr fs)))))
(define (tqa-have-and! . fs)
  (let ((c (tqa-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (tqa-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((tqa-op? e 'IP) (tqa-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (tqa-ct! e))
        (#t (for-each tqa-type-ips! e))))

(define (tqa-qd p xi) (tqa-q (tqa-sub p xi)))
(define (tqa-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (tqa-vt! a) (tqa-vt! b)
          (dk-have! (list '= (tqa-qd a b) 0)
            (lambda () (tqa-expand!) (tqa-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero tqa-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (tqa-q-eq! a b)
  (let ((goal (list '= (tqa-q a) (tqa-q b))))
    (if (not (dk-asm? goal))
        (begin (tqa-vt! a) (tqa-vt! b)
               (dk-have! goal (lambda () (tqa-expand!) (tqa-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (tqa-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** TQA: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "TQA: unfinished" name))))
;;; dump the focus leaf (debugging)
(define (tqa-show! tag)
  (display "\n--- TQA ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (tqa-sub! ks x)
  (dk-cite! 'submodule-subset tqa-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC tqa-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (tqa-scal! c)
  (dk-cite! 'cips-scal-carrier tqa-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL tqa-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL tqa-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix tqa-) -----------------------------------------------
(define tqa-w 'w)
(define (tqa-n u) (list 'IP-NORM tqa-v u))
(define (tqa-ipv a b) (list '(IP v) a b))
(define (tqa-ipw a b) (list '(IP w) a b))
(define (tqa-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (tqa-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (tqa-prods e)
  (cond ((tqa-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map tqa-prods (cdr e)))
        (#t '())))
(define (tqa-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (tqa-prod? (cadr p)) (tqa-mul-type! (cadr p)))
        (if (tqa-prod? (caddr p)) (tqa-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (tqa-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (tqa-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map tqa-prods prems) (tqa-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (tqa-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (tqa-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (tqa-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (tqa-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))
;;; debugging: dump every open leaf (goal + context)
(define (tqa-dump! tag)
  (display "\n=== TQA DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
;;; run THUNK; on an error print the condition and dump, then re-raise
(define (tqa-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (display "\n*** TQA ERROR in ") (display tag) (display ": ")
          (display (if (condition? e) (condition/report-string e) e)) (newline)
          (tqa-dump! tag)
          (k (error "TQA stop" tag)))
        thunk))))
;;; ==========================================================================================
;;; (A1) SEQUENCE LEMMAS (library analysis): composition of strictly increasing reindexings,
;;; convergence along a reindexing given POINTWISE (no SUBSEQ term), and the limit of a
;;; sum / a scaled sequence / an image under a bounded operator in an inner product space.
;;; ==========================================================================================

;;; strictly-mono-compose: phi o psi is strictly increasing
(sp (make-wff (forall-guarded '(phi psi)
  '((STRICTLY-MONO-NN phi) (STRICTLY-MONO-NN psi))
  '(STRICTLY-MONO-NN (VNB-LAMBDA tqk_ NN (phi (psi tqk_)))))))
(dk-peel!)
(let* ((r1 (tqa-iff-fwd! 'strictly-mono-nn 'phi))
       (m1 (caddr r1))
       (r2 (tqa-iff-fwd! 'strictly-mono-nn 'psi))
       (m2 (caddr r2))
       (lam '(VNB-LAMBDA tqk_ NN (phi (psi tqk_)))))
  (dk-have! (list 'IN lam '(FUN NN NN))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((k (dk-di-var!)))
                     (dk-cite! 'fun-apply-type-c 'psi 'NN 'NN k)
                     (dk-cite! 'fun-apply-type-c 'phi 'NN 'NN (list 'psi k))
                     (ass)))
        (lambda () (fact 'nn-is-set) (ass)))))
  (let ((iff (dk-cite! 'strictly-mono-nn lam)))
    (dk-have! (caddr (caddr iff))
      (lambda ()
        (let* ((lk (dk-peel!))
               (ms (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))
               (a (car ms)) (b (cadr ms)))
          (dk-lam-b!)
          (dk-cite! 'fun-apply-type-c 'psi 'NN 'NN a)
          (dk-cite! 'fun-apply-type-c 'psi 'NN 'NN b)
          (dk-apply! m2 a b)
          (dk-apply! m1 (list 'psi a) (list 'psi b))
          (ass))))
    (tqa-iff-bwd! 'strictly-mono-nn lam)
    (ass)))
(tqa-qed! 'strictly-mono-compose)

;;; converges-reindex-ptwise: b(n) = a(psi(n)) for psi strictly increasing, a -> l: b -> l
(sp (make-wff (forall-guarded '(s sqa_ sqb_ psi l)
  '((CONVERGES-TO s sqa_ l) (STRICTLY-MONO-NN psi) (IN sqb_ (FUN NN (PTS s)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (sqb_ n_) (sqa_ (psi n_))))))
  '(CONVERGES-TO s sqb_ l))))
(dk-peel!)
(let* ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sqb_) (dk-contains? f 'psi))) "the reindexing"))
       (r1 (tqa-iff-fwd! 'converges-to 's 'sqa_ 'l))
       (u1 (caddr (caddr (caddr r1))))
       (rp (tqa-iff-fwd! 'strictly-mono-nn 'psi))
       (ge (dk-cite! 'strictly-mono-ge-id 'psi))
       (iff (dk-cite! 'converges-to 's 'sqb_ 'l))
       (clause (caddr (caddr (caddr (caddr iff))))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (n1 (dk-skolem! (dk-apply! u1 e)))
             (i1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n1 (free-vars f)))) "the tail")))
        (witness! n1
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2)))
                           (pk (list 'psi k)))
                      (subst (dk-apply! eqc k))
                      (dk-cite! 'fun-apply-type-c 'psi 'NN 'NN k)
                      (let ((g1 (dk-apply! ge k)))
                        (dk-have! (list '<= n1 pk) (lambda () (dk-nn! (list '<= n1 k) g1))))
                      (dk-apply! i1 pk)
                      (ass))))))))))
  (tqa-iff-bwd! 'converges-to 's 'sqb_ 'l)
  (ass))
(tqa-qed! 'converges-reindex-ptwise)
;;; ==========================================================================================
;;; (A2) CONVERGENCE IN AN INNER PRODUCT SPACE: pointwise-equal sequences, images under a
;;; bounded operator, sums, scalar multiples; then the POINTWISE form of IS-COMPACT-OP (a
;;; subsequence clause stated for every sequence b with b(n) = T(f(phi(n))), so that no
;;; lambda is ever applied under a binder) and its introduction rule.
;;; ==========================================================================================

(define (tqa-M w) (list 'IP-METRIC-SPACE w))
;;; land (IN b (FUN NN (PTS M_w))) / (IN x (PTS M_w)) from the VEC typing
(define (tqa-pts-fun! w b)
  (let ((g (list 'IN b (list 'FUN 'NN (list 'PTS (tqa-M w))))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'PTS (tqa-M w)) (list 'VEC w))) (ass)))))
    g))
(define (tqa-pts-pt! w x)
  (let ((g (list 'IN x (list 'PTS (tqa-M w)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'PTS (tqa-M w)) (list 'VEC w))) (ass)))))
    g))
;;; the converse: (IN b (FUN NN (VEC w))) from the PTS typing, (IN x (VEC w)) likewise
(define (tqa-vec-fun! w b)
  (let ((g (list 'IN b (list 'FUN 'NN (list 'VEC w)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'VEC w) (list 'PTS (tqa-M w)))) (ass)))))
    g))
(define (tqa-vec-pt! w x)
  (let ((g (list 'IN x (list 'VEC w))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'VEC w) (list 'PTS (tqa-M w)))) (ass)))))
    g))
;;; the k-th term of b typed in VEC w, from b in FUN(NN, VEC w) and k in NN
(define (tqa-seq-t! w b k)
  (dk-cite! 'fun-apply-type-c b 'NN (list 'VEC w) k))

;;; converges-ptwise-eq: a -> l and b(n) = a(n) for all n: b -> l
(sp (make-wff (forall-guarded '(s sqa_ sqb_ l)
  '((CONVERGES-TO s sqa_ l) (IN sqb_ (FUN NN (PTS s)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (sqb_ n_) (sqa_ n_)))))
  '(CONVERGES-TO s sqb_ l))))
(dk-peel!)
(let* ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sqb_) (dk-contains? f 'sqa_))) "the equation"))
       (r1 (tqa-iff-fwd! 'converges-to 's 'sqa_ 'l))
       (u1 (caddr (caddr (caddr r1))))
       (iff (dk-cite! 'converges-to 's 'sqb_ 'l))
       (clause (caddr (caddr (caddr (caddr iff))))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
             (n1 (dk-skolem! (dk-apply! u1 e)))
             (i1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq n1 (free-vars f)))) "the tail")))
        (witness! n1
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN) (ass)
                    (let* ((lk2 (dk-peel!))
                           (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk2))))
                      (subst (dk-apply! eqc k))
                      (dk-apply! i1 k)
                      (ass))))))))))
  (tqa-iff-bwd! 'converges-to 's 'sqb_ 'l)
  (ass))
(tqa-qed! 'converges-ptwise-eq)

;;; ipc-op: a -> l in v, b(n) = T(a(n)): b -> T(l) in w
(sp (make-wff (forall-guarded '(v w t_ sqa_ sqb_ l)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w))
    (CONVERGES-TO (IP-METRIC-SPACE v) sqa_ l) (IN sqb_ (FUN NN (VEC w)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (sqb_ n_) (t_ (sqa_ n_))))))
  '(CONVERGES-TO (IP-METRIC-SPACE w) sqb_ (t_ l)))))
(dk-peel!)
(let* ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sqb_) (dk-contains? f 'sqa_))) "the equation"))
       (cv (dk-pick (lambda (f) (dk-head-is? f 'CONVERGES-TO)) "the convergence")))
  (dk-have! (list 'AND (list 'IN 'sqa_ (list 'FUN 'NN (list 'PTS (tqa-M 'v)))) (list 'IN 'l (list 'PTS (tqa-M 'v))))
    (lambda () (tqa-iff-fwd! 'converges-to (tqa-M 'v) 'sqa_ 'l) (dk-conj-close! dk-ass!)))
  (dk-split-all!)
  (tqa-vec-fun! 'v 'sqa_)
  (tqa-vec-pt! 'v 'l)
  (dk-cite! 'bop-fun 'v 'w 't_)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) 'l)
  (tqa-pts-fun! 'w 'sqb_)
  (tqa-pts-pt! 'w '(t_ l))
  (dk-cite! 'ip-metric-space-is-metric-space 'w)
  (dk-cite! 'opnorm-in-rr 'v 'w 't_)
  (dk-cite! 'opnorm-nonneg 'v 'w 't_)
  (let* ((ob (dk-cite! 'opnorm-bound 'v 'w 't_))
         (c '(OPNORM v w t_))
         (dom (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list '<= (list (list 'DIST (tqa-M 'w)) '(sqb_ n_) '(t_ l))
                          (list '* c (list (list 'DIST (tqa-M 'v)) '(sqa_ n_) 'l)))))))
    (dk-have! dom
      (lambda ()
        (let* ((lk (dk-peel!))
               (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))
               (ak (list 'sqa_ k)))
          (subst (dk-apply! eqc k))
          (tqa-seq-t! 'v 'sqa_ k)
          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) ak)
          (subst (dk-cite! 'ipms-dist-norm 'w (list 't_ ak) '(t_ l)))
          (subst (dk-cite! 'ipms-dist-norm 'v ak 'l))
          (dk-cite! 'cips-vneg-type 'v 'l)
          (let ((e3 (dk-cite! 'bop-vneg 'v 'w 't_ 'l)))
            (subst (list '= (caddr e3) (cadr e3))))
          (let ((e4 (dk-cite! 'bop-add 'v 'w 't_ ak '((VNEG v) l))))
            (subst (list '= (caddr e4) (cadr e4))))
          (fluid-let ((tqa-v 'v)) (tqa-vt! (list '(VADD v) ak '((VNEG v) l))))
          (dk-apply! ob (list '(VADD v) ak '((VNEG v) l)))
          (ass))))
    (dk-cite! 'ms-converges-of-scaled (tqa-M 'w) (tqa-M 'v) 'sqb_ 'sqa_ '(t_ l) 'l c)
    (ass)))
(tqa-qed! 'ipc-op)

;;; ipc-sum: a -> la, b -> lb, c(n) = a(n) + b(n): c -> la + lb
(sp (make-wff (forall-guarded '(w sqa_ sqb_ sqc_ la_ lb_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE w)
    (CONVERGES-TO (IP-METRIC-SPACE w) sqa_ la_) (CONVERGES-TO (IP-METRIC-SPACE w) sqb_ lb_)
    (IN sqc_ (FUN NN (VEC w)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (sqc_ n_) ((VADD w) (sqa_ n_) (sqb_ n_))))))
  '(CONVERGES-TO (IP-METRIC-SPACE w) sqc_ ((VADD w) la_ lb_)))))
(dk-peel!)
(let* ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sqc_))) "the equation")))
  (dk-have! (list 'AND (list 'IN 'sqa_ (list 'FUN 'NN (list 'PTS (tqa-M 'w)))) (list 'IN 'la_ (list 'PTS (tqa-M 'w))))
    (lambda () (tqa-iff-fwd! 'converges-to (tqa-M 'w) 'sqa_ 'la_) (dk-conj-close! dk-ass!)))
  (dk-have! (list 'AND (list 'IN 'sqb_ (list 'FUN 'NN (list 'PTS (tqa-M 'w)))) (list 'IN 'lb_ (list 'PTS (tqa-M 'w))))
    (lambda () (tqa-iff-fwd! 'converges-to (tqa-M 'w) 'sqb_ 'lb_) (dk-conj-close! dk-ass!)))
  (dk-split-all!)
  (tqa-vec-fun! 'w 'sqa_) (tqa-vec-fun! 'w 'sqb_) (tqa-vec-pt! 'w 'la_) (tqa-vec-pt! 'w 'lb_)
  (dk-cite! 'cips-vadd-type 'w 'la_ 'lb_)
  (tqa-pts-fun! 'w 'sqc_)
  (tqa-pts-pt! 'w '((VADD w) la_ lb_))
  (dk-cite! 'ip-metric-space-is-metric-space 'w)
  (let ((dom (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list '<= (list (list 'DIST (tqa-M 'w)) '(sqc_ n_) '((VADD w) la_ lb_))
                          (list '+ (list (list 'DIST (tqa-M 'w)) '(sqa_ n_) 'la_)
                                   (list (list 'DIST (tqa-M 'w)) '(sqb_ n_) 'lb_)))))))
    (dk-have! dom
      (lambda ()
        (let* ((lk (dk-peel!))
               (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
          (subst (dk-apply! eqc k))
          (tqa-seq-t! 'w 'sqa_ k) (tqa-seq-t! 'w 'sqb_ k)
          (dk-cite! 'ipms-dist-sum-le 'w (list 'sqa_ k) (list 'sqb_ k) 'la_ 'lb_)
          (ass))))
    (dk-cite! 'ms-converges-of-dominated-sum (tqa-M 'w) (tqa-M 'w) (tqa-M 'w) 'sqc_ 'sqa_ 'sqb_
              '((VADD w) la_ lb_) 'la_ 'lb_)
    (ass)))
(tqa-qed! 'ipc-sum)

;;; ipc-act: a -> la, b(n) = c a(n): b -> c la
(sp (make-wff (forall-guarded '(w c_ sqa_ sqb_ la_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN c_ CC)
    (CONVERGES-TO (IP-METRIC-SPACE w) sqa_ la_) (IN sqb_ (FUN NN (VEC w)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (sqb_ n_) ((ACT w) c_ (sqa_ n_))))))
  '(CONVERGES-TO (IP-METRIC-SPACE w) sqb_ ((ACT w) c_ la_)))))
(dk-peel!)
(let* ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sqb_))) "the equation")))
  (dk-have! (list 'AND (list 'IN 'sqa_ (list 'FUN 'NN (list 'PTS (tqa-M 'w)))) (list 'IN 'la_ (list 'PTS (tqa-M 'w))))
    (lambda () (tqa-iff-fwd! 'converges-to (tqa-M 'w) 'sqa_ 'la_) (dk-conj-close! dk-ass!)))
  (dk-split-all!)
  (tqa-vec-fun! 'w 'sqa_) (tqa-vec-pt! 'w 'la_)
  (dk-cite! 'cips-act-type 'w 'c_ 'la_)
  (tqa-pts-fun! 'w 'sqb_)
  (tqa-pts-pt! 'w '((ACT w) c_ la_))
  (dk-cite! 'ip-metric-space-is-metric-space 'w)
  (dk-cite! 'cc-magnitude-closed 'c_)
  (dk-cite! 'cc-magnitude-nonneg 'c_)
  (let ((dom (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list '<= (list (list 'DIST (tqa-M 'w)) '(sqb_ n_) '((ACT w) c_ la_))
                          (list '* '(magnitude c_) (list (list 'DIST (tqa-M 'w)) '(sqa_ n_) 'la_)))))))
    (dk-have! dom
      (lambda ()
        (let* ((lk (dk-peel!))
               (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
          (subst (dk-apply! eqc k))
          (tqa-seq-t! 'w 'sqa_ k)
          (dk-cite! 'ipms-dist-act-le 'w 'c_ (list 'sqa_ k) 'la_)
          (ass))))
    (dk-cite! 'ms-converges-of-scaled (tqa-M 'w) (tqa-M 'w) 'sqb_ 'sqa_ '((ACT w) c_ la_) 'la_ '(magnitude c_))
    (ass)))
(tqa-qed! 'ipc-act)

