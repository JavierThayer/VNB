              (dk-have! (list 'AND (list 'IN ns 'RR) (list 'IN (list 'IP-NORM 'v fk) 'RR)) (lambda () (dk-conj-close! dk-ass!)))
              (let ((cm (dk-cite! 'rr-mul-comm ns (list 'IP-NORM 'v fk))))
