;;; ==========================================================================================
;;; (A4) THE SUBSEQUENCE CLAUSE FOR A SEQUENCE BOUNDED BY ANY r >= 0 (by rescaling with
;;; 1/(r+1)); compact o bounded is compact.
;;; ==========================================================================================

(define (tqa-bound-r v f r)
  (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '<= (list 'IP-NORM v (list f 'nq_)) r))))

;;; compact-op-seq-r
(sp (make-wff (forall-guarded '(v w t_ f r_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IS-COMPACT-OP v w t_)
        '(IN r_ RR) '(<= 0 r_) '(IN f (FUN NN (VEC v))) (tqa-bound-r 'v 'f 'r_))
  (tqa-seqc 'v 'w 't_ 'f))))
(dk-peel!)
(dk-cite! 'compact-op-bounded 'v 'w 't_)
(dk-cite! 'bop-fun 'v 'w 't_)
(let* ((bd (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'r_))) "the bound"))
       (m0 '(+ r_ 1)))
  (dk-have! '(AND (IN r_ RR) (IN 1 RR)) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith))))))
  (dk-cite! 'rr-add-closed 'r_ 1)
  (let* ((m (dk-name! m0))
         (mpos (dk-have! (list '< 0 m) (lambda () (dk-ineq! '(<= 0 r_) (list '= m m0)))))
         (mnz (dk-cite! 'rr-pos-ne-zero m)))
    (dk-have! (list 'AND (list 'IN m 'RR) (list 'NOT (list '= m 0))) (lambda () (dk-conj-close! dk-ass!)))
    (dk-cite! 'rr-recip-closed m)
    (dk-cite! 'rr-recip-inverse m)
    (let* ((q (dk-name! (list 'recip m))))
      (dk-cite! 'rr-recip-pos m)
      (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip m))) (ass)))
      (dk-have! (list '= (list '* m q) 1) (lambda () (subst (list '= q (list 'recip m))) (ass)))
      (dk-cite! 'rr-subset-cc q)
      (dk-cite! 'rr-subset-cc m)
      (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
      (let ((g (list 'VNB-LAMBDA 'gq_ 'NN (list '(ACT v) q (list 'f 'gq_)))))
        (dk-have! (list 'IN g '(FUN NN (VEC v)))
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((k (dk-di-var!)))
                           (dk-cite! 'fun-apply-type-c 'f 'NN '(VEC v) k)
                           (dk-cite! 'cips-act-type 'v q (list 'f k))
                           (ass)))
              (lambda () (fact 'nn-is-set) (ass)))))
        ;; ||g k|| = q ||f k|| <= q r = 1 - q <= 1
        (dk-have! (tqa-bound 'v g)
          (lambda ()
            (let* ((k (dk-di-var!)) (fk (list 'f k)) (nk (list 'IP-NORM 'v fk)))
              (dk-cite! 'fun-apply-type-c 'f 'NN '(VEC v) k)
              (dk-lam-b!)
              (subst (dk-cite! 'ip-norm-act 'v q fk))
              (subst (dk-cite! 'rr-magnitude-is-abs q))
              (subst (dk-cite! 'rr-abs-of-nonneg q))
              (tqa-nt! 'v fk)
              (let* ((b1 (dk-apply! bd k))
                     (b2 (dk-cite! 'rr-mul-le-right nk 'r_ q)))
                (dk-have! (list 'AND (list 'IN nk 'RR) (list 'IN q 'RR)) (lambda () (dk-conj-close! dk-ass!)))
                (let* ((b3 (dk-cite! 'rr-mul-comm nk q))
                       (e5 (have-f! (list '= (list '* m q) (list '+ (list '* 'r_ q) q))
                             (lambda () (subst (list '= m m0)) (crs)))))
                  (tqa-lin! (list (list 'IN q 'RR) (list 'IN 'r_ 'RR) (list 'IN nk 'RR) (list 'IN m 'RR))
                            (list b2 b3 e5 (list '= (list '* m q) 1) (list '< 0 q))))))))
        (let* ((r1 (tqa-seq! 'v 'w 't_ g))
               (phi (car r1)) (l1 (cadr r1)) (u1 (caddr r1))
               (ct (list 'VNB-LAMBDA 'tqn_ 'NN (list 't_ (list g (list phi 'tqn_))))))
          (tqa-use-u! u1 ct (lambda (n) (list 't_ (list g (list phi n)))) (lambda (k) #t) '(VEC w))
          (tqa-lim-t! 'w ct l1)
          (dk-cite! 'cips-act-type 'w m l1)
          (tqa-seqc-witness! phi (list '(ACT w) m l1)
            (lambda (b eqb)
              (tqa-ptw! b (lambda (n) (list '(ACT w) m (list ct n)))
                (lambda (k)
                  (tqa-sub-eq! eqb k)
                  (tqa-type-apps! (dk-goal))
                  (dk-lam-b!)
                  (tqa-type-apps! (dk-goal))
                  (let ((y (list 't_ (list 'f (list phi k)))))
                    (dk-cite! 'cips-act-type 'v q (list 'f (list phi k)))
                    (subst (dk-cite! 'bop-act 'v 'w 't_ q (list 'f (list phi k))))
                    (let ((e (dk-cite! 'cips-ract-mul 'w m q y)))
                      (subst (list '= (caddr e) (cadr e))))
                    (subst (list '= (list '* m q) 1))
                    (subst (dk-cite! 'cips-ract-one 'w y)))))
              (dk-cite! 'ipc-act 'w m ct b l1)
              (ass))))))))
(tqa-qed! 'compact-op-seq-r)

