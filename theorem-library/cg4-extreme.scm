;;; cg4-extreme.scm -- the extreme points of the convex hull of E lie in E (compact-groups notes,
;;; Lemma 1.13, its algebraic core: eqs. (10)-(11) of the proof.  The closures of the notes'
;;; statement -- "a closed set whose CLOSED convex hull is A" -- are skipped: CLOSURE).
;;; Agent ISOM, 2026-10-26.  Helper prefix: ce4-.  Library: linear-algebra.

(define (ce4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (ce4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (ce4-act r x) (list '(ACT m) r x))
(define (ce4-cvx x y t) (list '(VADD m) (ce4-act (list '- 1 t) x) (ce4-act t y)))
(define (ce4-L n) (list 'CONV-LEVEL 'm 'E n))
(define ce4-H '(CONV-HULL m E))
(define (ce4-strict! a b)                ; (<= a b), (NOT (= a b)), both real: land (< a b)
  (dk-cite! 'rr-lt-trichotomy a b)
  (dk-cite! 'rr-lt-not-le b a)
  (dk-have! (list '< a b)
    (lambda () (if (dk-only! (list 'OR (list '< a b) (list 'OR (list '= a b) (list '< b a)))
                             (list 'IMPLIES (list '< b a) (list 'NOT (list '<= a b)))
                             (list '<= a b) (list 'NOT (list '= a b)))
                   (prop)))))
(define (ce4-open3! ex)                  ; FORSOME x .. FORSOME y .. FORSOME t ..: returns (x y t)
  (let* ((x (dk-skolem! ex))
         (_ (ce4-split-if! (lambda (h) (dk-contains? h x))))
         (y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x))) "the second point")))
         (_2 (ce4-split-if! (lambda (h) (dk-contains? h y))))
         (t (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the coefficient"))))
    (ce4-split-if! (lambda (h) (dk-contains? h t)))
    (ce4-split-if! (lambda (h) (dk-contains? h t)))
    (ce4-split-if! (lambda (h) (dk-contains? h t)))
    (list x y t)))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'm (list 'FORALL 'E (list 'FORALL 'x
   (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (list 'IMPLIES '(SUBSET E (VEC m))
     (list 'IMPLIES (list 'IS-EXTREME-POINT 'm ce4-H 'x) (list 'IMPLIES (list 'IN 'x (ce4-L 'k)) '(IN x E))))))))))))
(let* ((ind (dk-use-induction-fixed! '(m E))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1D: m, E fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'conv-level-zero 'm 'E)
  (dk-rewrite-h! (list 'IN 'x (ce4-L 0)) (ce4-L 0) 'E)
  (ce4-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-extreme-point 'm ce4-H 'x))))
  (dk-cite! 'conv-level-is-set n 'm 'E)
  (dk-split-all! (list (dk-cite! 'conv-level-succ-elim 'm 'E n 'x)))
  (let* ((uyt (ce4-open3! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'x))) "x's combination")))
         (u (car uyt)) (y (cadr uyt)) (t (caddr uyt))
         (eqx (list '= 'x (ce4-cvx u y t))))
    (dk-cite! 'conv-level-sub-vec n 'm 'E)
    (dk-cite! 'subset-mem-fwd (ce4-L n) '(VEC m) u)
    (dk-cite! 'subset-mem-fwd 'E '(VEC m) y)
    (fact 'rr-zero-in) (fact 'rr-one-in)
    (use-em (list '= 0 t)
      (lambda ()
        (dk-rewrite-h! eqx t 0)
        (dk-cite! 'convex-combination-at-zero 'm u y)
        (dk-rewrite-h! (list '= 'x (ce4-cvx u y 0)) (ce4-cvx u y 0) u)
        (dk-rewrite-h! (list 'IN u (ce4-L n)) u 'x)
        (dk-apply! ih 'x)   ; W1D: m, E fixed
        (ce4-ass!))
      (lambda ()
        (use-em (list '= t 1)
          (lambda ()
            (dk-rewrite-h! eqx t 1)
            (dk-cite! 'convex-combination-at-one 'm u y)
            (dk-rewrite-h! (list '= 'x (ce4-cvx u y 1)) (ce4-cvx u y 1) y)
            (dk-rewrite-h! (list 'IN y 'E) y 'x)
            (ce4-ass!))
          (lambda ()
            (ce4-strict! 0 t)
            (ce4-strict! t 1)
            (dk-cite! 'conv-hull-intro 'm 'E n u)
            (dk-cite! 'conv-hull-contains 'm 'E)
            (dk-cite! 'subset-mem-fwd 'E ce4-H y)
            (dk-split-all! (list (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'epu_))) "the extreme clause") u y t)))
            (dk-rewrite-h! (list 'IN y 'E) y 'x)
            (ce4-ass!)))))))
(qed 'extreme-point-of-level)
(topic! 'extreme-point-of-level 'algebra)

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'E (list 'FORALL 'x
   (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (list 'IMPLIES '(SUBSET E (VEC m))
     (list 'IMPLIES (list 'IS-EXTREME-POINT 'm ce4-H 'x) '(IN x E)))))))))
(dk-peel!)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-extreme-point 'm ce4-H 'x))))
(let ((k (dk-skolem! (dk-cite! 'conv-hull-elim 'm 'E 'x))))
  (ce4-split-if! (lambda (h) (dk-contains? h k)))
  (dk-cite! 'extreme-point-of-level k 'm 'E 'x)
  (ce4-ass!))
(qed 'extreme-points-of-hull-in-set)
(topic! 'extreme-points-of-hull-in-set 'algebra)
