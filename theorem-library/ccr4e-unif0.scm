            (dk-absurd! `(= (* ,xn ,pj) ,qi) `(<= (* ,xn ,pj) (* 1 ,pj)) `(= (* 1 ,pj) ,pj)
                        `(<= ,pj (power ,cq (succ ,i))) `(= (power ,cq (succ ,i)) (* ,cq ,qi))
                        `(< (* ,cq ,qi) (* 1 ,qi)) `(= (* 1 ,qi) ,qi))))
        (let* ((d (dk-skolem! (dk-chain-ass! (dk-cite! 'nn-le-gap i j)) #t))
