            (dk-cite! 'rr-subset-cc cq)
            (dk-chain-ass! (dk-cite! 'power-succ cq i))
            (dk-cite! 'power-closed-at `(succ ,i) cq)
            (dk-rr-mul! cq qi) (dk-rr-mul! 1 qi) (dk-rr-mul! 1 pj)
