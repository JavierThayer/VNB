;;; 5. The residue field of B(K) in characteristic 0 is the prime field: every x of B(K) with |x| <= 1 is
;;; congruent mod M(K) to an integer n.1.
(define (u3-dd x n) `((ADD K) ,x ((NEG K) ,(u3-ev n))))
;; the signed q-decomposition of a non-zero integer, with its absolute value
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3q (IMPLIES (IS-PRIME-NAT u3q) (IMPLIES (< ,u3-cq 1)
   (FORALL u3z (IMPLIES (IN u3z ZZ) (IMPLIES (NOT (= u3z 0))
     (FORSOME u3k (AND (IN u3k NN) (FORSOME u3w (AND (IN u3w ZZ)
       (AND (= u3z (* (power u3q u3k) u3w)) (AND (NOT (ZZ-DIVIDES u3q u3w)) (= ,(u3-n (u3-ev 'u3z)) (power ,u3-cq u3k))))))))))))))))))
(dk-peel!)
(u3-k!)
(u3-q!)
(let* ((m '(abs u3z)) (cq u3-cq))
  (dk-cite! 'zz-abs-in-nn 'u3z) (dk-cite! 'nn-subset-zz m) (dk-cite! 'zz-in-rr m) (dk-cite! 'zz-in-rr 'u3z)
  (dk-cite! 'nn-zero-le m)
  (dk-have! `(NOT (= 0 ,m))
    (lambda ()
      (di)
      (dk-or-each! (dk-cite! 'zz-abs-cases 'u3z)
        (lambda (o)
          (dk-have! '(= u3z 0) (lambda () (dk-ineq! o `(= 0 ,m))))
          (ai '(NOT (= u3z 0)))))))
  (dk-have! `(<= 1 ,m)
    (lambda ()
      (dk-have-and! `(<= 0 ,m) `(NOT (= 0 ,m)))
      (dk-cite! 'rr-le-ne-lt 0 m)
      (fact 'zz-zero-in)
      (dk-cite! 'zz-lt-succ-le 0 m)
      (dk-ineq! `(<= (+ 0 1) ,m))))
  (let* ((k (dk-skolem! (dk-chain-ass! (dk-cite! 'prime-decomposition 'u3q m)) #t))
         (z0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "the cofactor") #t))
         (qk `(power u3q ,k)))
    (dk-cite! 'nn-subset-zz z0) (dk-cite! 'zz-in-rr z0)
    (dk-cite! 'pz-power-in-zz 'u3q k) (dk-cite! 'zz-in-rr qk)
    (dk-rr-mul! qk z0)
    (dk-chain-ass! (dk-cite! 'nv-zz-one-value 'K 'u3q 'u3z))
    ;; |E z| = c^k
    (u3-ek! qk) (u3-ek! z0) (u3-ek! m) (u3-ek! 'u3z)
    (dk-chain-ass! (dk-cite! 'nv-zz-one-unit 'K 'u3q z0))
    (dk-chain-ass! (dk-cite! 'nv-zz-one-power k 'K 'u3q))
    (u3-nmul! qk z0)
    (dk-cite! 'power-closed-at k cq)
    (dk-have! `(= ,(u3-n (u3-ev m)) (power ,cq ,k))
      (lambda ()
        (subst `(= ,m (* ,qk ,z0)))
        (subst `(= ,(u3-n (u3-ev `(* ,qk ,z0))) (* ,(u3-n (u3-ev z0)) ,(u3-n (u3-ev qk)))))
        (subst `(= ,(u3-n (u3-ev z0)) 1))
        (subst `(= ,(u3-n (u3-ev qk)) (power ,cq ,k)))
        (crs)))
    (dk-have! `(= ,(u3-n (u3-ev 'u3z)) (power ,cq ,k))
      (lambda ()
        (dk-or-each! (dk-cite! 'zz-abs-cases 'u3z)
          (lambda (o)
            (if (dk-contains? (caddr o) '-)
                (begin
                  (dk-have! `(= ,m (- u3z)) (lambda () (dk-ineq! o)))
                  (dk-have! `(= ,(u3-n (u3-ev 'u3z)) ,(u3-n (u3-ev m)))
                    (lambda ()
                      (subst `(= ,m (- u3z)))
                      (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg u3-V 'u3z)))
                      (subst `(== (NEG ,u3-V) (NEG K)))
                      (subst (dk-chain-ass! (dk-cite! 'nf-norm-neg 'K (u3-ev 'u3z))))
                      (u3-rfl!))))
                (dk-have! `(= ,(u3-n (u3-ev 'u3z)) ,(u3-n (u3-ev m)))
                  (lambda () (subst (list '= (caddr o) (cadr o))) (u3-rfl!))))
            (dk-ineq! `(= ,(u3-n (u3-ev 'u3z)) ,(u3-n (u3-ev m))) `(= ,(u3-n (u3-ev m)) (power ,cq ,k)))))))
    (dk-or-each! (dk-cite! 'zz-abs-cases 'u3z)
      (lambda (o)
        (if (dk-contains? (caddr o) '-)
            (let ((nz `(- ,z0)))
              (dk-cite! 'zz-neg-closed z0)
              (dk-have! `(= (- (- ,z0)) ,z0) (lambda () (crs)))
              (dk-have! `(NOT (ZZ-DIVIDES u3q ,nz))
                (lambda ()
                  (di)
                  (let ((h (dk-chain-ass! (dk-cite! 'pz-dvd-neg 'u3q nz))))
                    (dk-rewrite-h! h `(- ,nz) z0)
                    (ai `(NOT (ZZ-DIVIDES u3q ,z0))))))
              (dk-have! `(= (* ,qk ,nz) (- (* ,qk ,z0))) (lambda () (crs)))
              (dk-have! `(= u3z (- (* ,qk ,z0))) (lambda () (dk-ineq! o `(= ,m (* ,qk ,z0)))))
              (dk-have! `(= u3z (* ,qk ,nz)) (lambda () (subst `(= u3z (- (* ,qk ,z0)))) (crs)))
              (witness! k (lambda () (dk-conj-close! (lambda ()
                (cond ((dk-asm? (dk-goal)) (dk-ass!))
                      ((dk-head-is? (dk-goal) 'FORSOME) (witness! nz (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
                      (#t (error "u3 decomp: leaf" (dk-goal)))))))))
            (begin
              (dk-have! `(= u3z (* ,qk ,z0)) (lambda () (dk-ineq! o `(= ,m (* ,qk ,z0)))))
              (witness! k (lambda () (dk-conj-close! (lambda ()
                (cond ((dk-asm? (dk-goal)) (dk-ass!))
                      ((dk-head-is? (dk-goal) 'FORSOME) (witness! z0 (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
                      (#t (error "u3 decomp: leaf" (dk-goal))))))))))))))
(qed 'nv-zz-one-decomp)

;; every x of Q_K with |x| <= 1 is congruent mod M to an integer n.1
(sp (make-wff (u3-qst `(FORALL u3x (IMPLIES (IN u3x ,u3-QK) (IMPLIES (<= ,(u3-n 'u3x) 1)
   (FORSOME u3n (AND (IN u3n ZZ) (< ,(u3-n (u3-dd 'u3x 'u3n)) 1)))))))))
(dk-peel!)
(u3-k!)
(u3-q!)
(let* ((ab (u3-qk-open! 'u3x)) (a (car ab)) (b (cadr ab))
       (xn (u3-n 'u3x)) (cq u3-cq))
  (dk-cite! 'nf-norm-in-rr 'K 'u3x) (dk-cite! 'nf-norm-nonneg 'K 'u3x)
  (fact 'rr-one-in) (fact 'zz-zero-in)
  (u3-ek! 0)
  (dk-chain-ass! (dk-cite! 'zz-act-one-zero u3-V))
  (use-em '(= u3x (ZERO K))
    (lambda ()
      (let ((d0 (u3-dd 'u3x 0)))
        (dk-cite! 'nf-zero-in-carr 'K) (u3-carr-v! '(ZERO K))
        (dk-chain-ass! (dk-cite! 'nf-neg-in-carr 'K (u3-ev 0)))
        (dk-chain-ass! (dk-cite! 'nf-add-in-carr 'K 'u3x `((NEG K) ,(u3-ev 0))))
        (dk-have! `(= ,d0 (ZERO K))
          (lambda () (subst '(= u3x (ZERO K))) (subst `(= ,(u3-ev 0) (ZERO ,u3-V))) (u3-to-v!) (crs)))
        (dk-iff-bwd! (dk-cite! 'nf-norm-zero-iff 'K d0))
        (dk-cite! 'nf-norm-in-rr 'K d0)
        (witness! 0 (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (dk-ineq! `(= ,(u3-n d0) 0)))))))))
    (lambda ()
      (u3-num-ne! 'u3x a b)
      (let* ((i (dk-skolem! (dk-chain-ass! (dk-cite! 'nv-zz-one-decomp 'K 'u3q a)) #t))
             (a2 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i))) "a cofactor") #t))
             (j (dk-skolem! (dk-chain-ass! (dk-cite! 'nv-zz-one-decomp 'K 'u3q b)) #t))
             (b2 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f j))) "b cofactor") #t))
             (pj `(power ,cq ,j)) (qi `(power ,cq ,i)) (qj `(power u3q ,j)))
        (dk-cite! 'power-closed-at i cq) (dk-cite! 'power-closed-at j cq)
        (dk-chain-ass! (dk-cite! 'rr-power-pos cq j))
        (dk-chain-ass! (dk-cite! 'rr-power-pos cq i))
        (dk-have! `(<= 0 ,pj) (lambda () (dk-ineq! `(< 0 ,pj))))
        (dk-rr-mul! xn pj)
        (dk-chain-ass! (dk-cite! 'nf-norm-mult 'K 'u3x (u3-ev b)))
        (dk-have! `(= (* ,xn ,pj) ,qi)
          (lambda ()
            (subst `(= ,qi ,(u3-n (u3-ev a))))
            (subst `(= ,pj ,(u3-n (u3-ev b))))
            (subst `(= (* ,xn ,(u3-n (u3-ev b))) ,(u3-n `((MUL K) u3x ,(u3-ev b)))))
            (subst `(= ((MUL K) u3x ,(u3-ev b)) ,(u3-ev a)))
            (u3-rfl!)))
        (dk-cite! 'nf-norm-nonneg 'K (u3-ev 'u3q))
        (dk-have! `(<= ,cq 1) (lambda () (dk-ineq! `(< ,cq 1))))
