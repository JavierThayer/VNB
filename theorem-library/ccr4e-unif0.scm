;;; ccr4e-unif0.scm -- CCR.pdf Remark 4.23 IN CHARACTERISTIC 0, under the user's definition of B(K) (2026-11-09):
;;; the residue characteristic p, as the element p.1 of K, is a uniformizing parameter of B(K) -- it lies in B(K),
;;; 0 < |p.1| < 1, and every x in B(K) with |x| < 1 has |x| <= |p.1|.  Agent CCR-1111, 2026-11-11.
;;; Destination: theorem-library/ccr4e-unif0.scm.  Helper prefix u3-.
;;;
;;; The route.  Write E(n) for n.1 = ZZ-ACT(RING-ADDITIVE-AG V, n, ONE V), V the ring view of K.
;;;   1. n |-> n.1 is additive, negation-compatible and multiplicative on ZZ (any commutative ring).
;;;   2. |n.1| <= 1; for a prime q with |q.1| < 1: |m.1| = 1 when q does not divide m (Bezout), |(q^k).1| = |q.1|^k,
;;;      and so |n.1| = |q.1|^i for every n /= 0 (prime-decomposition).
;;;   3. In characteristic 0 put Q_K = {x in K : x . b.1 = a.1 for some a, b in ZZ, b /= 0}: a subfield of K, so the
;;;      prime field (the subfield generated by the empty set) lies in it, and its non-zero elements have
;;;      |x| = |q.1|^(i - j): |x| < 1 forces |x| <= |q.1|.
;;;   4. Every x in B(K) = closure(prime field) with 0 < |x| < 1 has an approximant y with |y| = |x| (ultrametric).
;;; This is the computation behind the notes' (44), with p = u w^e: |p| = |w|^e is the largest absolute value < 1
;;; on B(K).
;;;
;;; Library: complex-analysis AS THE TREE STANDS (ccr4c-local and ccr4b-base are complex-analysis); the
;;; ring-level lemmas of section 1 are algebra and could be hoisted.
;;; Load window: after ccr4c-local (nv-residue-zz-act-one), ccr4b-base, ccr4c-finite-char (zz-act-one-mul), the
;;; zz-coprime / prime-decomposition files, cd8 (cd8-power-le-base); [after ccr4c-local, end).

(define (u3-E r n) `(ZZ-ACT (RING-ADDITIVE-AG ,r) ,n (ONE ,r)))
(define (u3-rfl!) (dk-close-if! (lambda () #t) (lambda () (rfl))))

;;; ---------------------------------------------------------------------------
;;; 1. n |-> n.1 on ZZ, in any ring
(define (u3-ring! r)
  (dk-chain-ass! (dk-cite! 'ring-one-in r))
  (dk-chain-ass! (dk-cite! 'ring-additive-ag-is-abelian-group r))
  (dk-chain-ass! (dk-cite! 'ras-carr r))
  (if (not (dk-asm? `(IN (ONE ,r) (CARR (RING-ADDITIVE-AG ,r)))))
      (dk-rewrite-h! `(IN (ONE ,r) (CARR ,r)) `(CARR ,r) `(CARR (RING-ADDITIVE-AG ,r)))))
;; land E(k) in CARR r; k typed in ZZ
(define (u3-type! r k)
  (let ((t (u3-E r k)))
    (if (not (dk-asm? `(IN ,t (CARR ,r))))
        (let ((f (dk-chain-ass! (dk-cite! 'zz-act-type `(RING-ADDITIVE-AG ,r) k `(ONE ,r)))))
          (dk-rewrite-h! f `(CARR (RING-ADDITIVE-AG ,r)) `(CARR ,r))))
    t))

(sp (make-wff `(FORALL u3r (IMPLIES (IS-RING u3r) (FORALL u3a (IMPLIES (IN u3a ZZ) (FORALL u3b (IMPLIES (IN u3b ZZ)
   (= ,(u3-E 'u3r '(+ u3a u3b)) ((ADD u3r) ,(u3-E 'u3r 'u3a) ,(u3-E 'u3r 'u3b)))))))))))
(dk-peel!)
(u3-ring! 'u3r)
(u3-type! 'u3r 'u3a) (u3-type! 'u3r 'u3b)
(subst (dk-chain-ass! (dk-cite! 'zz-act-add '(RING-ADDITIVE-AG u3r) 'u3a 'u3b '(ONE u3r))))
(subst (dk-chain-ass! (dk-cite! 'ras-op 'u3r)))
(dk-chain-ass! (dk-cite! 'ring-add-closed 'u3r (u3-E 'u3r 'u3a) (u3-E 'u3r 'u3b)))
(u3-rfl!)
(qed 'zz-one-act-add)

(sp (make-wff `(FORALL u3r (IMPLIES (IS-RING u3r) (FORALL u3a (IMPLIES (IN u3a ZZ)
   (= ,(u3-E 'u3r '(- u3a)) ((NEG u3r) ,(u3-E 'u3r 'u3a)))))))))
(dk-peel!)
(u3-ring! 'u3r)
(u3-type! 'u3r 'u3a)
(subst (dk-chain-ass! (dk-cite! 'zz-act-neg-sign '(RING-ADDITIVE-AG u3r) 'u3a '(ONE u3r))))
(subst (dk-chain-ass! (dk-cite! 'ras-inv 'u3r)))
(dk-chain-ass! (dk-cite! 'ring-neg-in-carr 'u3r (u3-E 'u3r 'u3a)))
(u3-rfl!)
(qed 'zz-one-act-neg)

;; (j k).1 = (k.1)(j.1) for j, k in ZZ (zz-act-one-mul has j in NN)
(sp (make-wff `(FORALL u3r (IMPLIES (IS-COMMUTATIVE-RING u3r) (FORALL u3j (IMPLIES (IN u3j ZZ) (FORALL u3k (IMPLIES (IN u3k ZZ)
   (= ,(u3-E 'u3r '(* u3j u3k)) ((MUL u3r) ,(u3-E 'u3r 'u3k) ,(u3-E 'u3r 'u3j)))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'u3r))
(u3-ring! 'u3r)
(let ((n '(abs u3j)))
  (dk-cite! 'zz-abs-in-nn 'u3j)
  (dk-cite! 'nn-subset-zz n)
  (dk-or-each! (dk-cite! 'zz-abs-cases 'u3j)
    (lambda (o)
      (subst o)
      (if (dk-contains? (caddr o) '-)
          (let ((nk `(* ,n u3k)))
            (dk-cite! 'zz-in-rr n) (dk-cite! 'zz-in-rr 'u3k)
            (dk-have! `(= (* (- ,n) u3k) (- ,nk)) (lambda () (crs)))
            (dk-chain-ass! (dk-cite! 'zz-mul-closed n 'u3k))
            (subst `(= (* (- ,n) u3k) (- ,nk)))
            (u3-type! 'u3r 'u3k) (u3-type! 'u3r n) (u3-type! 'u3r nk)
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg 'u3r nk)))
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg 'u3r n)))
            (subst (dk-chain-ass! (dk-cite! 'zz-act-one-mul n 'u3r 'u3k)))
            (crs))
          (begin
            (dk-chain-ass! (dk-cite! 'zz-act-one-mul n 'u3r 'u3k))
            (dk-close-if-asm!))))))
(qed 'zz-one-act-mul-zz)

;;; ---------------------------------------------------------------------------
;;; 2. absolute values of n.1 in an NV field K
(define u3-V '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (u3-ev n) (u3-E u3-V n))
(define (u3-n x) `((FNRM K) ,x))
(define u3-ZK '(NV-INTEGERS K))
;; the facts about K, V in context
(define (u3-k!)
  (dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
  (dk-chain-ass! (dk-cite! 'nv-integers-domain 'K))
  (dk-chain-ass! (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring u3-V))
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul normed-field-ring-view-neg
              normed-field-ring-view-zero normed-field-ring-view-one))
  (u3-ring! u3-V))
;; E(n) in CARR K and its norm in RR; n typed in ZZ
(define (u3-ek! n)
  (let ((t (u3-type! u3-V n)))
    (if (not (dk-asm? `(IN ,t (CARR K))))
        (dk-rewrite-h! `(IN ,t (CARR ,u3-V)) `(CARR ,u3-V) '(CARR K)))
    (if (not (dk-asm? `(IN ,(u3-n t) RR))) (dk-cite! 'nf-norm-in-rr 'K t))
    t))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3m (IMPLIES (IN u3m ZZ) (<= ,(u3-n (u3-ev 'u3m)) 1)))))))
(dk-peel!)
(u3-k!)
(let ((n '(abs u3m)))
  (dk-cite! 'zz-abs-in-nn 'u3m)
  (dk-cite! 'nn-subset-zz n)
  (u3-ek! n)
  (dk-split-all! (list (dk-cite! 'nv-residue-zz-act-one n 'K)))
  (dk-chain-ass! (dk-cite! 'nv-domain-norm 'K u3-ZK (u3-ev n)))
  (dk-or-each! (dk-cite! 'zz-abs-cases 'u3m)
    (lambda (o)
      (subst o)
      (if (dk-contains? (caddr o) '-)
          (begin
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg u3-V n)))
            (subst `(== (NEG ,u3-V) (NEG K)))
            (subst (dk-chain-ass! (dk-cite! 'nf-norm-neg 'K (u3-ev n))))))
      (dk-close-if-asm!))))
(qed 'nv-zz-one-norm-le)


;; |E(a b)| = |E b| |E a| (a, b in ZZ): land it and return it
(define (u3-nmul! a b)
  (let* ((ab `(* ,a ,b)) (ea (u3-ek! a)) (eb (u3-ek! b))
         (claim `(= ,(u3-n (u3-ev ab)) (* ,(u3-n eb) ,(u3-n ea)))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V a b)))
            (subst `(== (MUL ,u3-V) (MUL K)))
            (subst (dk-chain-ass! (dk-cite! 'nf-norm-mult 'K eb ea)))
            (u3-rfl!))))
    claim))
;; (<= X 1) and (NOT (< X 1)) in context: land (= X 1)
(define (u3-eq-one! x)
  (fact 'rr-one-in)
  (dk-have! `(= ,x 1)
    (lambda ()
      (pbc)
      (dk-have-and! `(<= ,x 1) `(NOT (= ,x 1)))
      (dk-cite! 'rr-le-ne-lt x 1)
      (ai `(NOT (< ,x 1))))))
;; A in RR, 0 <= C, |A| <= 1 style: land (<= (* C A) C) from (<= A 1), A, C in RR, 0 <= C
(define (u3-scale-le! c a)
  (fact 'rr-one-in)
  (dk-cite! 'rr-mul-le-right a 1 c)
  (dk-rr-mul! a c) (dk-rr-mul! 1 c) (dk-rr-mul! c a)
  (dk-have! `(= (* ,a ,c) (* ,c ,a)) (lambda () (crs)))
  (dk-have! `(= (* 1 ,c) ,c) (lambda () (crs)))
  (dk-have! `(<= (* ,c ,a) ,c) (lambda () (dk-ineq! `(<= (* ,a ,c) (* 1 ,c)) `(= (* ,a ,c) (* ,c ,a)) `(= (* 1 ,c) ,c)))))

;; an integer prime to q has |m.1| = 1, when |q.1| < 1 (Bezout and the ultrametric inequality)
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3q (IMPLIES (IS-PRIME-NAT u3q) (IMPLIES (< ,(u3-n (u3-ev 'u3q)) 1)
   (FORALL u3m (IMPLIES (IN u3m ZZ) (IMPLIES (NOT (ZZ-DIVIDES u3q u3m)) (= ,(u3-n (u3-ev 'u3m)) 1)))))))))))
(dk-peel!)
(u3-k!)
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'prime-nat-gt-one 'u3q))))
(dk-cite! 'nn-subset-zz 'u3q)
(dk-cite! 'zz-in-rr 'u3q)
(let* ((eq (u3-ek! 'u3q)) (em (u3-ek! 'u3m)) (cq (u3-n eq)) (cm (u3-n em)))
  (dk-cite! 'nv-zz-one-norm-le 'K 'u3m)
  (dk-cite! 'nf-norm-nonneg 'K eq) (dk-cite! 'nf-norm-nonneg 'K em)
  ;; m and q are coprime
  (dk-have! '(NOT (= u3q 0)) (lambda () (di) (dk-absurd! '(= u3q 0) '(< 1 u3q))))
  (let ((iff (dk-chain-ass! (dk-cite! 'zz-coprime-iff-no-common-prime 'u3m 'u3q))))
    (dk-have! (caddr iff)
      (lambda ()
        (let* ((ls (dk-landed (lambda () (dk-peel!))))
               (pt (find-first (lambda (f) (dk-head-is? f 'IS-PRIME-NAT)) ls))
               (t (cadr pt)))
          (if (not (dk-head-is? (dk-goal) 'NOT)) (dk-peel!))
          (dk-chain-ass! (dk-cite! 'prime-nat-divides-prime t 'u3q))
          (subst `(= ,t u3q))
          (dk-close-if-asm!))))
    (dk-iff-bwd! iff))
  (let* ((bz (dk-chain-ass! (dk-cite! 'zz-coprime-bezout 'u3m 'u3q))))
    (dk-iff-fwd! bz)
    (let* ((u (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'u3m) (dk-contains? f 'u3q))) "bezout") #t))
           (v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u))) "bezout v") #t))
           (um `(* ,u u3m)) (vq `(* ,v u3q)))
      (dk-chain-ass! (dk-cite! 'zz-mul-closed u 'u3m))
      (dk-chain-ass! (dk-cite! 'zz-mul-closed v 'u3q))
      (dk-have! `(NOT (< ,cm 1))
        (lambda ()
          (di)
          (let* ((eu (u3-ek! u)) (ev (u3-ek! v)) (cu (u3-n eu)) (cv (u3-n ev)))
            (dk-cite! 'nv-zz-one-norm-le 'K u) (dk-cite! 'nv-zz-one-norm-le 'K v)
            (u3-nmul! u 'u3m) (u3-nmul! v 'u3q)
            (u3-scale-le! cm cu) (u3-scale-le! cq cv)
            (u3-ek! um) (u3-ek! vq)
            (dk-have! `(< ,(u3-n (u3-ev um)) 1) (lambda () (dk-ineq! (u3-nmul! u 'u3m) `(<= (* ,cm ,cu) ,cm) `(< ,cm 1))))
            (dk-have! `(< ,(u3-n (u3-ev vq)) 1) (lambda () (dk-ineq! (u3-nmul! v 'u3q) `(<= (* ,cq ,cv) ,cq) `(< ,cq 1))))
            (fact 'rr-one-in)
            (dk-cite! 'rr-max-lt (u3-n (u3-ev um)) (u3-n (u3-ev vq)) 1)
            (dk-cite! 'rr-max-closed (u3-n (u3-ev um)) (u3-n (u3-ev vq)))
            ;; 1 = E(u m) + E(v q)
            (dk-chain-ass! (dk-cite! 'zz-one-act-add u3-V um vq))
            (dk-chain-ass! (dk-cite! 'zz-act-one `(RING-ADDITIVE-AG ,u3-V) `(ONE ,u3-V)))
            (dk-chain-ass! (dk-cite! 'nf-norm-one 'K))
            (dk-chain-ass! (dk-cite! 'nf-one-in-carr 'K))
            (dk-cite! 'nf-norm-in-rr 'K '(ONE K))
            (let ((ult (dk-chain-ass! (dk-cite! 'nv-ultra 'K (u3-ev um) (u3-ev vq)))))
              (dk-have! `(= ((ADD K) ,(u3-ev um) ,(u3-ev vq)) (ONE K))
                (lambda ()
                  (subst `(== (ADD K) (ADD ,u3-V)))
                  (subst `(= ((ADD ,u3-V) ,(u3-ev um) ,(u3-ev vq)) ,(u3-ev `(+ ,um ,vq))))
                  (subst `(= (+ ,um ,vq) 1))
                  (subst `(= ,(u3-ev 1) (ONE ,u3-V)))
                  (subst `(== (ONE ,u3-V) (ONE K)))
                  (u3-rfl!)))
              (let ((h (dk-rewrite-h! ult `((ADD K) ,(u3-ev um) ,(u3-ev vq)) '(ONE K))))
                (dk-absurd! h `(= ,(u3-n '(ONE K)) 1) `(< (MAX ,(u3-n (u3-ev um)) ,(u3-n (u3-ev vq))) 1))))))))
  (u3-eq-one! cm)
  (dk-close-if-asm!)))
(qed 'nv-zz-one-unit)

;; |(q^k).1| = |q.1|^k
(sp (make-wff `(FORALL u3k (IMPLIES (IN u3k NN) (FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3q (IMPLIES (IN u3q ZZ)
   (= ,(u3-n (u3-ev '(power u3q u3k))) (power ,(u3-n (u3-ev 'u3q)) u3k))))))))))
(let* ((br (dk-use-induction-fixed!))
       (n (cdr (assq 'var br))) (st (cdr (assq 'step br))) (bs (cdr (assq 'base br))))
  (dk-focus! bs)
  (if (not (dk-asm? '(IS-NV-FIELD K))) (dk-peel!))
  (dk-peel!)
  (u3-k!)
  (let* ((eq (u3-ek! 'u3q)) (cq (u3-n eq)))
    (dk-cite! 'zz-in-rr 'u3q) (dk-cite! 'rr-subset-cc 'u3q) (dk-cite! 'rr-subset-cc cq)
    (subst (dk-cite! 'power-zero 'u3q))
    (subst (dk-cite! 'power-zero cq))
    (subst (dk-chain-ass! (dk-cite! 'zz-act-one `(RING-ADDITIVE-AG ,u3-V) `(ONE ,u3-V))))
    (subst `(== (ONE ,u3-V) (ONE K)))
    (subst (dk-chain-ass! (dk-cite! 'nf-norm-one 'K)))
    (u3-rfl!))
  (dk-focus! st)
  (let ((ih (cdr (assq 'ih br))))
    (if (not (dk-asm? '(IS-NV-FIELD K))) (dk-peel!))
    (dk-peel!)
    (u3-k!)
    (let* ((q 'u3q) (eq (u3-ek! q)) (cq (u3-n eq)) (qn `(power ,q ,n)))
      (dk-chain-ass! (dk-apply! ih q))
      (dk-cite! 'zz-in-rr q) (dk-cite! 'rr-subset-cc q) (dk-cite! 'rr-subset-cc cq)
      (dk-cite! 'pz-power-in-zz q n)
      (dk-chain-ass! (dk-cite! 'power-succ q n))
      (dk-chain-ass! (dk-cite! 'power-succ cq n))
      (dk-cite! 'power-closed-at n cq)
      (u3-ek! qn)
      (u3-nmul! q qn)
      (subst `(= (power ,q (succ ,n)) (* ,q ,qn)))
      (subst `(= (power ,cq (succ ,n)) (* ,cq (power ,cq ,n))))
      (subst `(= ,(u3-n (u3-ev `(* ,q ,qn))) (* ,(u3-n (u3-ev qn)) ,cq)))
      (subst `(= ,(u3-n (u3-ev qn)) (power ,cq ,n)))
      (crs))))
(qed 'nv-zz-one-power)

;; every non-zero integer has |n.1| = |q.1|^i for some i
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3q (IMPLIES (IS-PRIME-NAT u3q) (IMPLIES (< ,(u3-n (u3-ev 'u3q)) 1)
   (FORALL u3n (IMPLIES (IN u3n ZZ) (IMPLIES (NOT (= u3n 0))
     (FORSOME u3i (AND (IN u3i NN) (= ,(u3-n (u3-ev 'u3n)) (power ,(u3-n (u3-ev 'u3q)) u3i))))))))))))))
(dk-peel!)
(u3-k!)
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'prime-nat-gt-one 'u3q))))
(dk-cite! 'nn-subset-zz 'u3q)
(let* ((m '(abs u3n)) (eq (u3-ek! 'u3q)) (cq (u3-n eq)))
  (dk-cite! 'zz-abs-in-nn 'u3n) (dk-cite! 'nn-subset-zz m) (dk-cite! 'zz-in-rr m) (dk-cite! 'zz-in-rr 'u3n)
  (dk-cite! 'nn-zero-le m)
  (dk-have! `(NOT (= 0 ,m))
    (lambda ()
      (di)
      (dk-or-each! (dk-cite! 'zz-abs-cases 'u3n)
        (lambda (o)
          (dk-have! '(= u3n 0) (lambda () (dk-ineq! o `(= 0 ,m))))
          (ai '(NOT (= u3n 0)))))))
  (dk-have! `(<= 1 ,m)
    (lambda ()
      (dk-have-and! `(<= 0 ,m) `(NOT (= 0 ,m)))
      (dk-cite! 'rr-le-ne-lt 0 m)
      (fact 'zz-zero-in)
      (dk-cite! 'zz-lt-succ-le 0 m)
      (dk-ineq! `(<= (+ 0 1) ,m))))
  (let* ((a (dk-skolem! (dk-chain-ass! (dk-cite! 'prime-decomposition 'u3q m)) #t))
         (mm (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a))) "the cofactor") #t))
         (qa `(power u3q ,a)))
    (dk-cite! 'nn-subset-zz mm)
    (dk-cite! 'pz-power-in-zz 'u3q a)
    (u3-ek! qa) (u3-ek! mm) (u3-ek! m) (u3-ek! 'u3n)
    (dk-chain-ass! (dk-cite! 'nv-zz-one-unit 'K 'u3q mm))
    (dk-chain-ass! (dk-cite! 'nv-zz-one-power a 'K 'u3q))
    (u3-nmul! qa mm)
    (dk-have! `(= ,(u3-n (u3-ev m)) (power ,cq ,a))
      (lambda ()
        (subst `(= ,m (* ,qa ,mm)))
        (subst `(= ,(u3-n (u3-ev `(* ,qa ,mm))) (* ,(u3-n (u3-ev mm)) ,(u3-n (u3-ev qa)))))
        (subst `(= ,(u3-n (u3-ev mm)) 1))
        (subst `(= ,(u3-n (u3-ev qa)) (power ,cq ,a)))
        (dk-cite! 'power-closed-at a cq)
        (crs)))
    (dk-have! `(= ,(u3-n (u3-ev 'u3n)) ,(u3-n (u3-ev m)))
      (lambda ()
        (dk-or-each! (dk-cite! 'zz-abs-cases 'u3n)
          (lambda (o)
            (if (dk-contains? (caddr o) '-)
                (begin
                  (dk-have! `(= ,m (- u3n)) (lambda () (dk-ineq! o)))
                  (subst `(= ,m (- u3n)))
                  (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg u3-V 'u3n)))
                  (subst `(== (NEG ,u3-V) (NEG K)))
                  (subst (dk-chain-ass! (dk-cite! 'nf-norm-neg 'K (u3-ev 'u3n)))))
                (subst (list '= (caddr o) (cadr o))))
            (u3-rfl!)))))
    (witness! a (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,(u3-n (u3-ev 'u3n)) ,(u3-n (u3-ev m)))) (dk-close-if-asm!)))))))))
(qed 'nv-zz-one-value)


;;; ---------------------------------------------------------------------------
;;; 3. the rational subfield Q_K = {x : x . b.1 = a.1, a, b in ZZ, b /= 0}, for a prime q with 0 < |q.1| < 1
(define u3-cq (u3-n (u3-ev 'u3q)))
(define u3-QK `(SEP u3x_ (CARR K) (FORSOME u3a_ (AND (IN u3a_ ZZ) (FORSOME u3b_ (AND (IN u3b_ ZZ)
                 (AND (NOT (= u3b_ 0)) (= ((MUL K) u3x_ ,(u3-ev 'u3b_)) ,(u3-ev 'u3a_)))))))))
(define (u3-qst body)
  `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u3q (IMPLIES (IS-PRIME-NAT u3q) (IMPLIES (< 0 ,u3-cq) (IMPLIES (< ,u3-cq 1) ,body)))))))
(define (u3-has? t x) (or (equal? t x) (and (pair? t) (or (u3-has? (car t) x) (u3-has? (cdr t) x)))))
;; rewrite the goal's K operations to those of the ring view V
(define (u3-to-v!)
  (for-each (lambda (op)
              (let ((kt (list op 'K)) (vt (list op u3-V)))
                (if (u3-has? (dk-goal) kt) (subst (list '= kt vt)))))
            '(MUL ADD NEG ZERO ONE)))
(define (u3-carr-v! x)
  (if (not (dk-asm? `(IN ,x (CARR ,u3-V))))
      (dk-have! `(IN ,x (CARR ,u3-V)) (lambda () (subst `(== (CARR ,u3-V) (CARR K))) (dk-close-if-asm!)))))
;; X in Q_K in context: land X in CARR K and its numerator / denominator facts; return (A B)
(define (u3-qk-open! x)
  (let* ((ls (dk-landed (lambda () (dk-sep-parts! `(IN ,x ,u3-QK)))))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) ls))
         (a (dk-skolem! ex #t))
         (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a))) "the denominator") #t)))
    (u3-ek! a) (u3-ek! b) (u3-carr-v! x) (u3-carr-v! (u3-ev a)) (u3-carr-v! (u3-ev b))
    (list a b)))
;; goal (IN X Q_K): X in CARR K, A, B in ZZ, B /= 0 and X . E(B) = E(A) in context
(define (u3-qk-in! x a b)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (witness! a
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (dk-ass!))
                    ((dk-head-is? (dk-goal) 'FORSOME) (witness! b (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
                    (#t (error "u3-qk-in!: unexpected leaf" (dk-goal)))))))))))
(define (u3-q!)
  (if (not (dk-asm? '(IN u3q ZZ)))
      (begin (dk-split-all! (list (dk-chain-ass! (dk-cite! 'prime-nat-gt-one 'u3q))))
             (dk-cite! 'nn-subset-zz 'u3q)))
  (u3-ek! 'u3q))
(define (u3-conjs f) (if (dk-head-is? f 'AND) (cons (cadr f) (u3-conjs (caddr f))) (list f)))
;; b /= 0 in ZZ and b2 /= 0 in ZZ in context: land (NOT (= (* b b2) 0))
(define (u3-prod-ne! b b2)
  (dk-cite! 'zz-in-rr b) (dk-cite! 'zz-in-rr b2)
  (dk-chain-ass! (dk-cite! 'zz-mul-closed b b2))
  (dk-have! `(NOT (= (* ,b ,b2) 0))
    (lambda ()
      (di)
      (dk-or-each! (dk-chain-ass! (dk-cite! 'rr-no-zero-divisors b b2))
        (lambda (o) (ai `(NOT ,o)))))))

;; n.1 /= 0 for n /= 0
(sp (make-wff (u3-qst `(FORALL u3b (IMPLIES (IN u3b ZZ) (IMPLIES (NOT (= u3b 0)) (NOT (= ,(u3-ev 'u3b) (ZERO K)))))))))
(dk-peel!)
(if (dk-head-is? (dk-goal) 'NOT) (di))
(u3-k!)
(u3-q!)
(let* ((eb (u3-ek! 'u3b))
       (i (dk-skolem! (dk-chain-ass! (dk-cite! 'nv-zz-one-value 'K 'u3q 'u3b)) #t)))
  (u3-ek! 'u3q)
  (dk-cite! 'power-closed-at i u3-cq)
  (dk-chain-ass! (dk-cite! 'rr-power-pos u3-cq i))
  (dk-iff-bwd! (dk-cite! 'nf-norm-zero-iff 'K eb))
  (dk-absurd! `(= ,(u3-n eb) 0) `(= ,(u3-n eb) (power ,u3-cq ,i)) `(< 0 (power ,u3-cq ,i))))
(qed 'nv-zz-one-nonzero)

;; Q_K is a subfield of K
(sp (make-wff (u3-qst `(IS-NF-SUBFIELD K ,u3-QK))))
(dk-peel!)
(u3-k!)
(u3-q!)
(dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K)
(fact 'zz-zero-in) (fact 'zz-one-in)
(dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
(u3-ek! 0) (u3-ek! 1)
(u3-carr-v! '(ZERO K)) (u3-carr-v! '(ONE K))
(dk-chain-ass! (dk-cite! 'zz-act-one-zero u3-V))
(dk-chain-ass! (dk-cite! 'zz-act-one `(RING-ADDITIVE-AG ,u3-V) `(ONE ,u3-V)))
(let* ((iff (dk-cite! 'is-nf-subfield 'K u3-QK)) (rhs (caddr iff)) (cs (u3-conjs rhs)))
  ;; 0: Q_K lies in K
  (dk-have! (list-ref cs 0)
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!)))) (m (find-first (lambda (f) (dk-head-is? f 'IN)) ls)))
        (dk-sep-parts! m) (dk-close-if-asm!))))
  ;; 1, 2: zero and one
  (dk-have! `(= ((MUL K) (ZERO K) ,(u3-ev 1)) ,(u3-ev 0))
    (lambda () (subst `(= ,(u3-ev 1) (ONE ,u3-V))) (subst `(= ,(u3-ev 0) (ZERO ,u3-V))) (u3-to-v!) (crs)))
  (dk-have! (list-ref cs 1) (lambda () (u3-qk-in! '(ZERO K) 0 1)))
  (dk-have! `(= ((MUL K) (ONE K) ,(u3-ev 1)) ,(u3-ev 1))
    (lambda () (subst `(= ,(u3-ev 1) (ONE ,u3-V))) (u3-to-v!) (crs)))
  (dk-have! (list-ref cs 2) (lambda () (u3-qk-in! '(ONE K) 1 1)))
  ;; 3: sums
  (dk-have! (list-ref cs 3)
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!))))
             (ms (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) u3-QK))) ls))
             (x (cadr (car ms))) (y (cadr (cadr ms)))
             (ab1 (u3-qk-open! x)) (ab2 (u3-qk-open! y))
             (a1 (car ab1)) (b1 (cadr ab1)) (a2 (car ab2)) (b2 (cadr ab2))
             (num `(+ (* ,a1 ,b2) (* ,a2 ,b1))) (den `(* ,b1 ,b2)))
        (dk-chain-ass! (dk-cite! 'zz-mul-closed a1 b2))
        (dk-chain-ass! (dk-cite! 'zz-mul-closed a2 b1))
        (dk-chain-ass! (dk-cite! 'zz-add-closed `(* ,a1 ,b2) `(* ,a2 ,b1)))
        (u3-prod-ne! b1 b2)
        (dk-chain-ass! (dk-cite! 'nf-add-in-carr 'K x y))
        (u3-ek! `(* ,a1 ,b2)) (u3-ek! `(* ,a2 ,b1)) (u3-ek! den) (u3-ek! num)
        (dk-have! `(= ((MUL K) ((ADD K) ,x ,y) ,(u3-ev den)) ,(u3-ev num))
          (lambda ()
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-add u3-V `(* ,a1 ,b2) `(* ,a2 ,b1))))
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V a1 b2)))
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V a2 b1)))
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V b1 b2)))
            (subst `(= ,(u3-ev a1) ((MUL K) ,x ,(u3-ev b1))))
            (subst `(= ,(u3-ev a2) ((MUL K) ,y ,(u3-ev b2))))
            (u3-to-v!) (crs)))
        (u3-qk-in! `((ADD K) ,x ,y) num den))))
  ;; 4: products
  (dk-have! (list-ref cs 4)
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!))))
             (ms (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) u3-QK))) ls))
             (x (cadr (car ms))) (y (cadr (cadr ms)))
             (ab1 (u3-qk-open! x)) (ab2 (u3-qk-open! y))
             (a1 (car ab1)) (b1 (cadr ab1)) (a2 (car ab2)) (b2 (cadr ab2))
             (num `(* ,a1 ,a2)) (den `(* ,b1 ,b2)))
        (dk-chain-ass! (dk-cite! 'zz-mul-closed a1 a2))
        (u3-prod-ne! b1 b2)
        (dk-chain-ass! (dk-cite! 'nf-mul-in-carr 'K x y))
        (u3-ek! den) (u3-ek! num)
        (dk-have! `(= ((MUL K) ((MUL K) ,x ,y) ,(u3-ev den)) ,(u3-ev num))
          (lambda ()
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V a1 a2)))
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-mul-zz u3-V b1 b2)))
            (subst `(= ,(u3-ev a1) ((MUL K) ,x ,(u3-ev b1))))
            (subst `(= ,(u3-ev a2) ((MUL K) ,y ,(u3-ev b2))))
            (u3-to-v!) (crs)))
        (u3-qk-in! `((MUL K) ,x ,y) num den))))
  ;; 5: negatives
  (dk-have! (list-ref cs 5)
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!))))
             (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) u3-QK))) ls)))
             (ab (u3-qk-open! x)) (a (car ab)) (b (cadr ab)))
        (dk-cite! 'zz-neg-closed a)
        (dk-chain-ass! (dk-cite! 'nf-neg-in-carr 'K x))
        (u3-ek! `(- ,a))
        (dk-have! `(= ((MUL K) ((NEG K) ,x) ,(u3-ev b)) ,(u3-ev `(- ,a)))
          (lambda ()
            (subst (dk-chain-ass! (dk-cite! 'zz-one-act-neg u3-V a)))
            (subst `(= ,(u3-ev a) ((MUL K) ,x ,(u3-ev b))))
            (u3-to-v!) (crs)))
        (u3-qk-in! `((NEG K) ,x) `(- ,a) b))))
  ;; 6: inverses
  (dk-have! (list-ref cs 6)
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!))))
             (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) u3-QK))) ls))))
        (if (not (dk-asm? `(NOT (= ,x (ZERO K))))) (dk-peel!))
        (let* ((ab (u3-qk-open! x)) (a (car ab)) (b (cadr ab))
               (ea (u3-ev a)) (eb (u3-ev b))
               (y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K x)) #t)))
          (u3-carr-v! y)
          (dk-chain-ass! (dk-cite! 'nv-zz-one-nonzero 'K 'u3q b))
          (dk-have! `(NOT (= ,a 0))
            (lambda ()
              (di)
              (dk-have! `(= ((MUL K) ,x ,eb) ((MUL K) (ZERO K) ,eb))
                (lambda ()
                  (subst `(= ((MUL K) ,x ,eb) ,ea))
                  (subst `(= ,a 0))
                  (subst `(= ,(u3-ev 0) (ZERO ,u3-V)))
                  (u3-to-v!) (crs)))
              (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K x '(ZERO K) eb))
              (ai `(NOT (= ,x (ZERO K))))))
          (dk-chain-ass! (dk-cite! 'nf-mul-in-carr 'K x eb))
          (dk-chain-ass! (dk-cite! 'nf-mul-in-carr 'K x y))
          (dk-have! `(= ((MUL K) ,y ,ea) ,eb)
            (lambda ()
              (subst `(= ,ea ((MUL K) ,x ,eb)))
              (dk-have! `(= ((MUL K) ,y ((MUL K) ,x ,eb)) ((MUL K) ((MUL K) ,x ,y) ,eb)) (lambda () (u3-to-v!) (crs)))
              (subst `(= ((MUL K) ,y ((MUL K) ,x ,eb)) ((MUL K) ((MUL K) ,x ,y) ,eb)))
              (subst `(= ((MUL K) ,x ,y) (ONE K)))
              (u3-to-v!) (crs)))
          (witness! y
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!) (u3-qk-in! y b a))))))))))
  (apply dk-have-and! cs)
  (dk-iff-bwd! iff)
  (dk-close-if-asm!))
(qed 'nv-rationals-subfield)


;; x in Q_K with x /= 0 and x . E(b) = E(a): land a /= 0
(define (u3-num-ne! x a b)
  (let ((ea (u3-ev a)) (eb (u3-ev b)))
    (dk-chain-ass! (dk-cite! 'nv-zz-one-nonzero 'K 'u3q b))
    (dk-cite! 'nf-zero-in-carr 'K) (u3-carr-v! '(ZERO K))
    (dk-chain-ass! (dk-cite! 'zz-act-one-zero u3-V))
    (dk-have! `(NOT (= ,a 0))
      (lambda ()
        (di)
        (dk-have! `(= ((MUL K) ,x ,eb) ((MUL K) (ZERO K) ,eb))
          (lambda ()
            (subst `(= ((MUL K) ,x ,eb) ,ea))
            (subst `(= ,a 0))
            (subst `(= ,(u3-ev 0) (ZERO ,u3-V)))
            (u3-to-v!) (crs)))
        (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K x '(ZERO K) eb))
        (ai `(NOT (= ,x (ZERO K))))))))

;; c^j <= c^i for 0 <= c <= 1 and i <= j
(sp (make-wff '(FORALL u3c (IMPLIES (IN u3c RR) (IMPLIES (<= 0 u3c) (IMPLIES (<= u3c 1)
   (FORALL u3i (IMPLIES (IN u3i NN) (FORALL u3j (IMPLIES (IN u3j NN) (IMPLIES (<= u3i u3j)
     (<= (power u3c u3j) (power u3c u3i)))))))))))))
(dk-peel!)
(let ((d (dk-skolem! (dk-chain-ass! (dk-cite! 'nn-le-gap 'u3j 'u3i)) #t)))
  (subst `(= u3j (+ u3i ,d)))
  (dk-cite! 'rr-subset-cc 'u3c)
  (subst (dk-chain-ass! (dk-cite! 'cc-power-add d 'u3i 'u3c)))
  (dk-cite! 'power-closed-at 'u3i 'u3c) (dk-cite! 'power-closed-at d 'u3c)
  (dk-chain-ass! (dk-cite! 'rr-power-le-one d 'u3c))
  (dk-chain-ass! (dk-cite! 'rr-power-nonneg 'u3i 'u3c))
  (u3-scale-le! '(power u3c u3i) `(power u3c ,d))
  (dk-close-if-asm!))
(qed 'rr-power-antitone)

;; the elements of Q_K of absolute value < 1 have absolute value <= |q.1|
(sp (make-wff (u3-qst `(FORALL u3x (IMPLIES (IN u3x ,u3-QK) (IMPLIES (< ,(u3-n 'u3x) 1) (<= ,(u3-n 'u3x) ,u3-cq)))))))
(dk-peel!)
(u3-k!)
(u3-q!)
(let* ((ab (u3-qk-open! 'u3x)) (a (car ab)) (b (cadr ab))
       (xn (u3-n 'u3x)) (cq u3-cq))
  (dk-cite! 'nf-norm-in-rr 'K 'u3x) (dk-cite! 'nf-norm-nonneg 'K 'u3x)
  (use-em `(= u3x (ZERO K))
    (lambda ()
      (dk-iff-bwd! (dk-cite! 'nf-norm-zero-iff 'K 'u3x))
      (dk-ineq! `(= ,xn 0) `(< 0 ,cq)))
    (lambda ()
      (u3-num-ne! 'u3x a b)
      (let* ((i (dk-skolem! (dk-chain-ass! (dk-cite! 'nv-zz-one-value 'K 'u3q a)) #t))
             (j (dk-skolem! (dk-chain-ass! (dk-cite! 'nv-zz-one-value 'K 'u3q b)) #t))
             (pj `(power ,cq ,j)) (qi `(power ,cq ,i)))
        (dk-cite! 'power-closed-at i cq) (dk-cite! 'power-closed-at j cq)
        (dk-chain-ass! (dk-cite! 'rr-power-pos cq j))
        (dk-rr-mul! xn pj)
        (dk-chain-ass! (dk-cite! 'nf-norm-mult 'K 'u3x (u3-ev b)))
        (dk-have! `(= (* ,xn ,pj) ,qi)
          (lambda ()
            (subst `(= ,qi ,(u3-n (u3-ev a))))
            (subst `(= ,pj ,(u3-n (u3-ev b))))
            (subst `(= (* ,xn ,(u3-n (u3-ev b))) ,(u3-n `((MUL K) u3x ,(u3-ev b)))))
            (subst `(= ((MUL K) u3x ,(u3-ev b)) ,(u3-ev a)))
            (u3-rfl!)))
        (fact 'rr-one-in)
        (dk-iff-bwd! (dk-cite! 'rr-mul-lt-cancel-iff xn 1 pj))
        (dk-rr-mul! 1 pj)
        (dk-have! `(= (* 1 ,pj) ,pj) (lambda () (crs)))
        (dk-have! `(< ,qi ,pj) (lambda () (dk-ineq! `(< (* ,xn ,pj) (* 1 ,pj)) `(= (* 1 ,pj) ,pj) `(= (* ,xn ,pj) ,qi))))
        (dk-cite! 'nf-norm-nonneg 'K (u3-ev 'u3q))
        (dk-have! `(<= ,cq 1) (lambda () (dk-ineq! `(< ,cq 1))))
        (dk-cite! 'nn-in-rr i) (dk-cite! 'nn-in-rr j)
        (dk-or-each! (dk-chain-ass! (dk-cite! 'rr-leq-total i j))
          (lambda (o)
            (if (equal? o `(<= ,i ,j))
                (begin
                  (dk-chain-ass! (dk-cite! 'rr-power-antitone cq i j))
                  (dk-absurd! `(<= ,pj ,qi) `(< ,qi ,pj)))
                (use-em `(= ,j ,i)
                  (lambda ()
                    (dk-have! `(= ,qi ,pj) (lambda () (subst `(= ,j ,i)) (u3-rfl!)))
                    (dk-absurd! `(= ,qi ,pj) `(< ,qi ,pj)))
                  (lambda ()
                    (dk-chain-ass! (dk-cite! 'rr-le-ne-lt j i))
                    (dk-chain-ass! (dk-cite! 'nn-lt-succ-le j i))
                    (dk-cite! 'nn-succ-closed j)
                    (dk-chain-ass! (dk-cite! 'rr-power-antitone cq `(succ ,j) i))
                    (dk-cite! 'rr-subset-cc cq)
                    (dk-chain-ass! (dk-cite! 'power-succ cq j))
                    (dk-cite! 'power-closed-at `(succ ,j) cq)
                    (dk-rr-mul! cq pj)
                    (dk-have! `(<= (* ,xn ,pj) (* ,cq ,pj))
                      (lambda () (dk-ineq! `(= (* ,xn ,pj) ,qi) `(<= ,qi (power ,cq (succ ,j))) `(= (power ,cq (succ ,j)) (* ,cq ,pj)))))
                    (dk-chain-ass! (dk-cite! 'rr-mul-le-cancel-pos xn pj cq))
                    (dk-close-if-asm!))))))))))
(qed 'nv-rationals-value)

;;; ---------------------------------------------------------------------------
;;; 4. B(K) in characteristic 0
(define u3-ms '(NF-METRIC-SPACE K))
(define u3-X '(NV-BASE-GEN K w))
(define u3-G `(NF-SUBFIELD-GEN K ,u3-X))

;; in characteristic 0, with u3x in NV-BASE K w in context: land G subset Q_K, u3x in CLOSURE(G), u3x in CARR K
(define (u3-base-setup!)
  (dk-chain-ass! (dk-cite! 'nv-rationals-subfield 'K 'u3q))
  ;; Q_K in POWER(CARR K)
  (dk-have! `(SUBSET ,u3-QK (CARR K))
    (lambda () (let ((z (subset-by-element!))) (dk-sep-parts! `(IN ,z ,u3-QK)) (dk-close-if-asm!))))
  (dk-chain-ass! (dk-cite! 'ring-carr-in-set u3-V))
  (dk-rewrite-h! `(IN (CARR ,u3-V) SET) `(CARR ,u3-V) '(CARR K))
  (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set u3-QK '(CARR K)))
  (let* ((iff (dk-cite! 'power-set-membership '(CARR K) u3-QK)) (rhs (caddr iff)))
    (dk-have! (caddr rhs)
      (lambda ()
        (let* ((ls (dk-landed (lambda () (dk-peel!)))) (z (cadr (car ls))))
          (dk-chain-ass! (dk-cite! 'subset-mem-fwd u3-QK '(CARR K) z))
          (dk-close-if-asm!))))
    (dk-have-and! (cadr rhs) (caddr rhs))
    (dk-iff-bwd! iff))
  ;; the generators are none, so the prime field lies in Q_K
  (dk-have! `(SUBSET ,u3-X ,u3-QK)
    (lambda ()
      (let ((z (subset-by-element!)))
        (pbc)
        (dk-apply! (dk-chain-ass! (dk-cite! 'nv-base-char-0 'K 'w)) z)
        (ai `(NOT (IN ,z ,u3-X))))))
  (dk-chain-ass! (dk-cite! 'nf-subfield-gen-least 'K u3-X u3-QK))
  (dk-cite! 'nv-base-unfold 'K 'w)
  (dk-rewrite-h! '(IN u3x (NV-BASE K w)) '(NV-BASE K w) `(CLOSURE ,u3-ms ,u3-G))
  (dk-chain-ass! (dk-cite! 'nf-subfield-gen-sub 'K u3-X))
  (dk-chain-ass! (dk-cite! 'nf-closure-in-carr 'K u3-G))
  (dk-chain-ass! (dk-cite! 'subset-mem-fwd `(CLOSURE ,u3-ms ,u3-G) '(CARR K) 'u3x)))
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (IMPLIES (FORALL p (NOT (HAS-CHARACTERISTIC ,u3-V p)))
   (FORALL u3q (IMPLIES (IS-PRIME-NAT u3q) (IMPLIES (< 0 ,u3-cq) (IMPLIES (< ,u3-cq 1)
     (FORALL w (FORALL u3x (IMPLIES (IN u3x (NV-BASE K w)) (IMPLIES (< ,(u3-n 'u3x) 1) (<= ,(u3-n 'u3x) ,u3-cq))))))))))))))
(dk-peel!)
(u3-k!)
(u3-q!)
(u3-base-setup!)
(let ((xn (u3-n 'u3x)) (cq u3-cq))
