        (dk-have! `(< ,(u3-n nd) ,xn) (lambda () (dk-ineq! `(= ,(u3-n nd) ,(u3-n d)) `(< ,(u3-n d) ,xn))))
        (let ((sd (dk-chain-ass! (dk-cite! 'nv-strict-dominance 'K nd 'u3x))))
