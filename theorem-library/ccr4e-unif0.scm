      (dk-have-and! `(IN ,xn RR) `(<= 0 ,xn) `(NOT (= 0 ,xn)))
      (dk-iff-bwd! (dk-cite! 'pos-rr xn))
      (let* ((pa (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K u3-G 'u3x xn)) #t))
             (d `((ADD K) u3x ((NEG K) ,pa))) (nd `((NEG K) ,d)))
        (dk-chain-ass! (dk-cite! 'subset-mem-fwd u3-G u3-QK pa))
