(qed 'nv-base-char-0-unif)


;;; Remark 4.23, characteristic 0.  K an NV field with no prime characteristic; p the characteristic of the
;;; residue field.  Then p.1 lies in B(K), 0 < |p.1| < 1, and |p.1| is the largest absolute value < 1 on B(K):
;;; p.1 is a uniformizing parameter of B(K) in the sense of Remark 4.5.  (The steps up to 0 < |p.1| < 1 are those
;;; of ccr-4-21-char-0, CCR-1109-C4.)
(define u3-rr `(NV-RES-RINGOID K ,u3-ZK))
(define u3-Q `(RINGOID-QUOTIENT-RING ,u3-rr))
(define u3-st `(RINGOID-SETOID ,u3-rr))
(define u3-res `(NV-RESIDUE K ,u3-ZK))
(define (u3-L n) `(ZZ-ACT (RING-ADDITIVE-AG ,u3-Q) ,n (ONE ,u3-Q)))
(define u3-B '(NV-BASE K w))
(define u3-cp (u3-n (u3-ev 'u3p)))
(define (u3-unif-concl ep cp)
  `(AND (IN ,ep ,u3-B) (AND (< 0 ,cp) (AND (< ,cp 1)
     (FORALL u3x (IMPLIES (IN u3x ,u3-B) (IMPLIES (< ,(u3-n 'u3x) 1) (<= ,(u3-n 'u3x) ,cp))))))))
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (IMPLIES (FORALL p (NOT (HAS-CHARACTERISTIC ,u3-V p)))
   (FORALL u3p (IMPLIES (HAS-CHARACTERISTIC ,u3-res u3p)
     (FORALL w ,(u3-unif-concl (u3-ev 'u3p) u3-cp)))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
(dk-chain-ass! (dk-cite! 'nv-integers-domain 'K))
(let* ((h0 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-CHARACTERISTIC))) "characteristic 0"))
       (p 'u3p))
  (dk-iff-fwd! (dk-cite! 'has-characteristic u3-res p))
  (dk-iff-fwd! (dk-cite! 'is-prime-nat p))
  (dk-split-all! (list (dk-chain-ass! (dk-cite! 'nv-residue-zz-act-one p 'K))))
  (let* ((ep (u3-ev p)) (np `((FNRM K) ,ep)) (d `((ADD K) ,ep ((NEG K) (ZERO K)))))
    (dk-cite! 'nv-residue-unfold 'K u3-ZK)
    (dk-cite! 'nv-residue-zero-class 'K)
    (dk-have! `(= (CLASS ,u3-st ,ep) (CLASS ,u3-st (ZERO K)))
      (lambda ()
        (subst `(= (CLASS ,u3-st ,ep) ,(u3-L p)))
        (subst `(= (CLASS ,u3-st (ZERO K)) (ZERO ,u3-res)))
        (subst `(= ,u3-Q ,u3-res))
        (dk-close-if-asm!)))
    (dk-chain-ass! (dk-cite! 'nv-domain-zero 'K u3-ZK))
    (dk-iff-fwd! (dk-chain-ass! (dk-cite! 'rs-class-eq-iff 'K u3-ZK ep '(ZERO K))))
    (dk-cite! 'nv-maximal-norm 'K u3-ZK d)
    (dk-chain-ass! (dk-cite! 'nv-domain-sub 'K u3-ZK ep))
    (dk-chain-ass! (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K))
    (for-each (lambda (r) (dk-cite! r 'K))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-neg normed-field-ring-view-zero))
    (dk-have! `(IN ,ep (CARR ,u3-V)) (lambda () (subst `(= (CARR ,u3-V) (CARR K))) (dk-close-if-asm!)))
    (dk-have! `(= ,d ,ep)
      (lambda ()
        (subst `(= (ADD K) (ADD ,u3-V)))
        (subst `(= (NEG K) (NEG ,u3-V)))
        (subst `(= (ZERO K) (ZERO ,u3-V)))
        (crs)))
    (dk-rewrite-h! `(< ((FNRM K) ,d) 1) d ep)
    ;; p.1 /= 0
    (dk-have! `(NOT (= ,ep (ZERO K)))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'has-characteristic u3-V p)))
          (dk-have! (caddr iff)
            (lambda () (subst `(= (ZERO ,u3-V) (ZERO K))) (dk-conj-close! (lambda () (dk-ass!)))))
          (ai iff)
          (detach! `(IMPLIES ,(caddr iff) ,(cadr iff)))
          (dk-apply! h0 p)
          (ai `(NOT ,(cadr iff))))))
    ;; 0 < |p.1|
    (dk-cite! 'nf-norm-in-rr 'K ep)
    (dk-cite! 'nf-norm-nonneg 'K ep)
    (dk-have! `(NOT (= 0 ,np))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'nf-norm-zero-iff 'K ep)))
          (dk-have! `(= ,np 0) (lambda () (subst `(= ,np 0)) (rfl)))
          (dk-have! `(= ,ep (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,np 0) (= ,ep (ZERO K)))) (dk-ass!)))
          (ai `(NOT (= ,ep (ZERO K)))))))
    (dk-have-and! `(<= 0 ,np) `(NOT (= 0 ,np)))
    (dk-cite! 'rr-le-ne-lt 0 np)
    ;; p.1 lies in B(K), and bounds B(K) below 1
    (dk-chain-ass! (dk-cite! 'nv-base-subfield 'K 'w))
    (dk-chain-ass! (dk-cite! 'nf-subfield-zz-act-one p 'K u3-B))
    (dk-chain-ass! (dk-cite! 'nv-base-char-0-unif 'K p 'w))
    (dk-conj-close! (lambda () (dk-close-if-asm!)))))
(qed 'ccr-4-23-char-0)

;; for K local of characteristic 0 the residue characteristic exists (ccr-2-7, finite-field-characteristic)
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,u3-ZK) (FORALL w (IMPLIES (IN w ,u3-ZK)
   (IMPLIES (= (NV-MAXIMAL K ,u3-ZK) (NV-PRINCIPAL K ,u3-ZK w)) (IMPLIES (NOT (= w (ZERO K)))
   (IMPLIES (FORALL p (NOT (HAS-CHARACTERISTIC ,u3-V p)))
     (FORSOME u3p (AND (HAS-CHARACTERISTIC ,u3-res u3p) ,(u3-unif-concl (u3-ev 'u3p) u3-cp))))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-compact-domain 'K u3-ZK))
(dk-chain-ass! (dk-cite! 'nv-domain-field 'K u3-ZK))
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-2-7 'K u3-ZK))))
(let ((p (dk-skolem! (dk-chain-ass! (dk-cite! 'finite-field-characteristic u3-res)) #t)))
  (dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-4-23-char-0 'K p 'w))))
  (witness! p (lambda () (dk-conj-close! (lambda () (dk-close-if-asm!))))))
