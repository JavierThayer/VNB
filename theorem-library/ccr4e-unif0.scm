          (dk-cite! 'pz-power-in-zz 'u3q d) (dk-cite! 'pz-power-in-zz 'u3q j) (dk-cite! 'pz-power-in-zz 'u3q i)
          (dk-chain-ass! (dk-cite! 'zz-mul-closed qd a2))
          (for-each (lambda (t) (dk-cite! 'zz-in-rr t)) (list qd qj a2 b2 m 'u3q))
          (dk-cite! 'rr-subset-cc 'u3q)
          (dk-chain-ass! (dk-cite! 'cc-power-add d j 'u3q))
          (dk-have! `(= ,a (* ,qj ,m))
            (lambda ()
