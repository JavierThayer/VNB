;; a def-functor view's slot read-off (rake-asm-b2.scm's rb2-slot-close! / rb2-readoff!)
(define (onb-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (onb-readoff! acc src view)
  (let* ((lhs (list acc (list view src)))
         (rhs (list acc src)))
    (dk-have! (list '== lhs rhs) (lambda () (onb-slot-close! view acc)))
    (dk-have! (list '== rhs lhs) (lambda () (onb-slot-close! view acc)))))
(define (onb-rm-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (== (IDEN (IP-NORMED-AG v)) (VZERO v))))))
(dk-peel!)
(mac 'IP-NORMED-AG)
(slot 'IDEN)
(nth-r)
(qrfl)
(onb-done! 'onb-ip-normed-ag-iden)

;;; ---------------------------------------------------------------------------
;;; the terms
(define onb-G '(IP-NORMED-AG v))
(define onb-VG '(NORMED-AG-AS-ABELIAN-GROUP (IP-NORMED-AG v)))
(define onb-RM 'RR-POS-STAR-ADD-MONOID)
(define onb-cf '(VNB-LAMBDA onk_ ix ((ACT v) ((IP v) x (e onk_)) (e onk_))))
(define onb-gq '(VNB-LAMBDA onk_ ix (* (MAGNITUDE ((IP v) x (e onk_))) (MAGNITUDE ((IP v) x (e onk_))))))
(define (onb-Y w) (list 'FINSUM onb-VG onb-cf w))
(define (onb-P w) (list 'FINSUM onb-RM onb-gq w))
(define (onb-ps-body w)
  (let ((y (onb-Y w)) (p (onb-P w)))
    (list 'IMPLIES (list 'SUBSET w 'ix)
      (list 'AND (list 'IN y onb-V)
       (list 'AND (list 'FORALL 'onq_ (list 'IMPLIES '(IN onq_ ix) (list 'IMPLIES (list 'IN 'onq_ w)
                    (list '= (onb-ip y '(e onq_)) (onb-ip 'x '(e onq_))))))
        (list 'AND (list 'FORALL 'onq_ (list 'IMPLIES '(IN onq_ ix) (list 'IMPLIES (list 'NOT (list 'IN 'onq_ w))
                     (list '= (onb-ip y '(e onq_)) 0))))
         (list 'AND (list 'IN p 'RR)
          (list 'AND (list '= (onb-ip y y) p)
                     (list '= (onb-ip y 'x) p)))))))))
(define onb-ps-stmt
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-FAMILY v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'FORALL 'w_ (list 'IMPLIES '(IN w_ SET) (list 'IMPLIES '(IN (CARD w_) NN)
          (onb-ps-body 'w_))))))))))))

;; beta at a typed argument
(define (onb-beta! f a val)
  (let ((eq (list '= (list f a) val)))
    (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
    eq))
(define (onb-c k) (onb-ip 'x (list 'e k)))
(define (onb-m2 k) (list '* (list 'MAGNITUDE (onb-c k)) (list 'MAGNITUDE (onb-c k))))
;; k in ix in context: e k in VEC, c_k in CC, conj c_k in CC, c_k e_k in VEC
(define (onb-k-facts! k)
  (fact 'fun-apply-type-c 'e 'ix onb-V k)
  (fact 'cips-ip-type 'v 'x (list 'e k))
  (fact 'cc-conjugate-closed (onb-c k))
  (fact 'cips-act-type 'v (onb-c k) (list 'e k)))
;; k in ix: m2_k in RR, 0 <= m2_k, m2_k = c conj c
(define (onb-m2-facts! k)
  (let* ((c (onb-c k)) (m (onb-m2 k)) (cc (list '* c (list 'conjugate c))))
    (fact 'cc-magnitude-sq-conjugate c)
    (fact 'cc-self-conj-nonneg c)
    (dk-split-all! (list (list 'AND (list 'IN cc 'RR) (list '<= 0 cc))))
    (dk-have! (list 'IN m 'RR) (lambda () (subst (list '= m cc)) (dk-ass!)))
    (dk-have! (list '<= 0 m) (lambda () (subst (list '= m cc)) (dk-ass!)))))
;; w subset ix in context: the two pointwise typings over w
(define (onb-ptw-cf! w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list onb-cf 'z_) (list 'CARR onb-VG))))))
    (dk-have! claim
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (fact 'subset-mem-fwd w 'ix z)
          (onb-k-facts! z)
          (subst (list '== (list 'CARR onb-VG) onb-V))
          (dk-lam-b!)
          (dk-ass!))))
    claim))
(define (onb-ptw-gq! w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list onb-gq 'z_) (list 'CARR onb-RM))))))
    (dk-have! claim
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (fact 'subset-mem-fwd w 'ix z)
          (onb-k-facts! z)
          (onb-m2-facts! z)
          (subst (list '== (list 'CARR onb-RM) 'RR-POS-STAR))
          (dk-lam-b!)
          (let ((iff (dk-cite! 'rr-pos-star-membership (onb-m2 z))))
            (if (dk-only! iff (list 'IN (onb-m2 z) 'RR) (list '<= 0 (onb-m2 z))) (prop))))))
    claim))
;; the context of the induction: view, monoid, read-offs
(define (onb-sum-setup!)
  (fact 'ip-normed-ag-is-normed-ag 'v)
  (fact 'normed-ag-as-abelian-group-is-abelian-group onb-G)
  (for-each (lambda (acc) (onb-readoff! acc onb-G 'NORMED-AG-AS-ABELIAN-GROUP)) '(CARR OPR IDEN))
  (fact 'ip-normed-ag-carrier 'v)
  (fact 'ip-normed-ag-opr 'v)
  (fact 'onb-ip-normed-ag-iden 'v)
  (dk-have! (list '== (list 'CARR onb-VG) onb-V)
    (lambda () (subst (list '== (list 'CARR onb-VG) (list 'CARR onb-G))) (subst (list '== (list 'CARR onb-G) onb-V)) (qrfl)))
  (dk-have! (list '== (list 'OPR onb-VG) '(VADD v))
    (lambda () (subst (list '== (list 'OPR onb-VG) (list 'OPR onb-G))) (subst (list '== (list 'OPR onb-G) '(VADD v))) (qrfl)))
  (dk-have! (list '== (list 'IDEN onb-VG) '(VZERO v))
    (lambda () (subst (list '== (list 'IDEN onb-VG) (list 'IDEN onb-G))) (subst (list '== (list 'IDEN onb-G) '(VZERO v))) (qrfl)))
  (onb-rm-readoff! '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
  (onb-rm-readoff! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
  (onb-rm-readoff! '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
  (fact 'rr-pos-star-is-comm-monoid)
  (fact 'rr-zero-in)
  (fact 'cc-conjugate-fixes-rr 0)
  (fact 'cips-vzero-in 'v))

;;; ---------------------------------------------------------------------------
;;; THE PARTIAL SUMS.  For a finite w <= ix, with Y_w = sum_{i in w} <x,e_i> e_i and
;;; P_w = sum_{i in w} |<x,e_i>|^2 (in [0,+inf]): Y_w is a vector, <Y_w, e_k> = <x, e_k>
;;; for k in w and 0 for k outside w, P_w is real, and <Y_w, Y_w> = <Y_w, x> = P_w.
(sp (make-wff onb-ps-stmt))
(define (onb-card-goal? gl)
  (and (pair? gl) (eq? (car gl) 'IMPLIES) (pair? (cadr gl)) (eq? (car (cadr gl)) 'IN)
       (pair? (cadr (cadr gl))) (eq? (car (cadr (cadr gl))) 'CARD)))
(let loop ((n 0))
  (let ((gl (dk-goal)))
    (if (not (onb-card-goal? gl))
        (if (> n 12) (error "onb: never reached the CARD antecedent")
            (begin (di) (loop (+ n 1)))))))
(define onb-w0 (cadr (cadr (cadr (dk-goal)))))
(onb-sum-setup!)
(define onb-typ-h (onb-onf-typ! 'ix 'e))
(define onb-unit-h (onb-onf-unit! 'ix 'e))
(define onb-orth-h (onb-onf-orth! 'ix 'e))
(define onb-cls (list 'COMP 'wv_ (onb-ps-body 'wv_)))
;; base
(define (onb-dump!)
  (for-each (lambda (l)
              (display ";; OPEN: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                        (list-head (dk-asms-of l) (min 4 (length (dk-asms-of l))))))
            (dk-open-leaves)))
(dk-have! (list 'IN 'EMPTY-SET onb-cls)
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (equal? (dk-goal) '(IN EMPTY-SET SET))
           (begin (fact 'empty-set-is-set) (ass))
           (begin
             (di)
             (fact 'finsum-empty onb-VG onb-cf)
             (fact 'finsum-empty onb-RM onb-gq)
             (subst (list '== (onb-Y 'EMPTY-SET) (list 'IDEN onb-VG)))
             (subst (list '== (list 'IDEN onb-VG) '(VZERO v)))
             (subst (list '== (onb-P 'EMPTY-SET) (list 'IDEN onb-RM)))
             (subst (list '== (list 'IDEN onb-RM) 0))
             (fact 'cips-ip-zero-left 'v '(VZERO v))
             (fact 'cips-ip-zero-left 'v 'x)
             (dk-conj-close!
               (lambda ()
                 (cond
                   ((dk-ass!) #t)
                   ((dk-head-is? (dk-goal) 'FORALL)
                    (let* ((ld (dk-peel!))
                           (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld))))
                      (fact 'fun-apply-type-c 'e 'ix onb-V k)
                      (if (dk-asm? (list 'IN k 'EMPTY-SET))
                          (let ((ne (dk-cite! 'empty-set-has-no-members k)))
                            (if (dk-only! (list 'IN k 'EMPTY-SET) ne) (prop)))
                          (begin (fact 'cips-ip-zero-left 'v (list 'e k)) (dk-ass!)))))
                   (#t (error "onb base: unexpected goal" (expression->string (dk-goal))))))))))
     (dk-opened (lambda () (comp-mi))))))
;; step
(define (onb-step-body! u a ih)
  (let* ((pr (list 'PAIR a a))
         (t1 (list 'UNION u pr))
         (ea (list 'e a)) (ca (onb-c a)) (cfa (list '(ACT v) ca ea)) (m2 (onb-m2 a))
         (Y (onb-Y u)) (P (onb-P u)) (Yp (list '(VADD v) Y cfa))
         (ip onb-ip))
    (di)
    ;; t1 facts
    (fact 'union-singleton-mem a u)
    (fact 'union-comm u pr)
    (fact 'union-right-subset pr u)
    (dk-have! (list 'IN a t1) (lambda () (subst (list '= t1 (list 'UNION pr u))) (dk-ass!)))
    (dk-have! (list 'SUBSET u t1) (lambda () (subst (list '= t1 (list 'UNION pr u))) (dk-ass!)))
    (fact 'subset-mem-fwd t1 'ix a)
    (fact 'subset-trans u t1 'ix)
    (let* ((parts (dk-split! (dk-landed-1 (lambda () (detach! ih)))))
           (c1 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list 'IN 'onq_ u))
                                            (not (dk-contains? f (list 'NOT (list 'IN 'onq_ u)))))) parts))
           (c2 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list 'NOT (list 'IN 'onq_ u))))) parts)))
      (if (not (and c1 c2)) (error "onb step: IH clauses not found"))
      (onb-k-facts! a)
      (onb-m2-facts! a)
      (onb-ptw-cf! t1)
      (onb-ptw-gq! t1)
      (fact 'finsum-insert-ptwise onb-VG u a onb-cf)
      (fact 'finsum-cm-insert-ptwise onb-RM u a onb-gq)
      (onb-beta! onb-cf a cfa)
      (onb-beta! onb-gq a m2)
      (fact 'cips-vadd-type 'v Y cfa)
      (fact 'cips-ip-self-nonneg 'v Y)
      (dk-have! (list '<= 0 P) (lambda () (subst (list '= P (ip Y Y))) (dk-ass!)))
      (fact 'eplus-real-defined P m2)
      (fact 'binplus-apply P m2)
      (fact 'rr-subset-cc P)
      (dk-apply! c2 a)                         ; <Y, e_a> = 0
      (onb-unit-at-family! a)                  ; <e_a, e_a> = 1
      (fact 'cips-ip-type 'v Y ea)
      ;; rewrite the goal to Y' = Y + c_a e_a and P' = P + m2_a
      (subst (list '= (onb-Y t1) (list (list 'OPR onb-VG) Y (list onb-cf a))))
      (subst (list '== (list 'OPR onb-VG) '(VADD v)))
      (subst (list '= (list onb-cf a) cfa))
      (subst (list '= (onb-P t1) (list (list 'OPR onb-RM) P (list onb-gq a))))
      (subst (list '== (list 'OPR onb-RM) 'eplus))
      (subst (list '= (list onb-gq a) m2))
      (subst (list '= (list 'eplus P m2) (list 'binplus P m2)))
      (subst (list '== (list 'binplus P m2) (list '+ P m2)))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((equal? g (list 'IN (list '+ P m2) 'RR))
               (onb-and! (list 'IN P 'RR) (list 'IN m2 'RR))
               (fact 'rr-add-closed P m2)
               (dk-ass!))
              ((equal? g (list '= (ip Yp Yp) (list '+ P m2)))
               (fact 'cips-ip-add-left 'v Y cfa Yp)
               (fact 'cips-ip-add-right 'v Y Y cfa)
               (fact 'cips-ip-add-right 'v cfa Y cfa)
               (fact 'cips-ip-conj-homog-right 'v ca Y ea)
               (fact 'cips-ip-homog-left 'v ca ea Y)
               (fact 'cips-ip-conj-sym 'v Y ea)
               (fact 'cips-ip-homog-left 'v ca ea cfa)
               (fact 'cips-ip-conj-homog-right 'v ca ea ea)
               (subst (list '= (ip Yp Yp) (list '+ (ip Y Yp) (ip cfa Yp))))
               (subst (list '= (ip Y Yp) (list '+ (ip Y Y) (ip Y cfa))))
               (subst (list '= (ip cfa Yp) (list '+ (ip cfa Y) (ip cfa cfa))))
               (subst (list '= (ip Y cfa) (list '* (list 'conjugate ca) (ip Y ea))))
               (subst (list '= (ip cfa Y) (list '* ca (ip ea Y))))
               (subst (list '= (ip ea Y) (list 'conjugate (ip Y ea))))
               (subst (list '= (ip cfa cfa) (list '* ca (ip ea cfa))))
               (subst (list '= (ip ea cfa) (list '* (list 'conjugate ca) (ip ea ea))))
               (subst (list '= (ip ea ea) 1))
               (subst (list '= (ip Y ea) 0))
               (subst '(= (conjugate 0) 0))
               (subst (list '= (ip Y Y) P))
               (subst (list '= m2 (list '* ca (list 'conjugate ca))))
               (crs))
              ((equal? g (list '= (ip Yp 'x) (list '+ P m2)))
               (fact 'cips-ip-add-left 'v Y cfa 'x)
               (fact 'cips-ip-homog-left 'v ca ea 'x)
               (fact 'cips-ip-conj-sym 'v 'x ea)
               (subst (list '= (ip Yp 'x) (list '+ (ip Y 'x) (ip cfa 'x))))
               (subst (list '= (ip cfa 'x) (list '* ca (ip ea 'x))))
               (subst (list '= (ip ea 'x) (list 'conjugate ca)))
               (subst (list '= (ip Y 'x) P))
               (subst (list '= m2 (list '* ca (list 'conjugate ca))))
               (crs))
              ((dk-head-is? g 'FORALL)
               (let* ((ld (dk-peel!))
                      (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld))))
                 (onb-k-facts! k)
                 (if (dk-asm? (list 'NOT (list 'IN k t1)))
                     ;; k outside t1: k not in u, k /= a
                     (let ((ek (list 'e k)))
                       (dk-have! (list 'NOT (list 'IN k u))
                         (lambda () (di) (fact 'subset-mem-fwd u t1 k) (ai (list 'NOT (list 'IN k t1)))))
                       (dk-have! (list 'NOT (list '= a k))
                         (lambda ()
                           (di)
                           (dk-have! (list 'IN k t1) (lambda () (subst (list '= k a)) (dk-ass!)))
                           (ai (list 'NOT (list 'IN k t1)))))
                       (dk-apply! c2 k)
                       (dk-apply! onb-orth-h a k)
                       (fact 'cips-ip-add-left 'v Y cfa ek)
                       (fact 'cips-ip-homog-left 'v ca ea ek)
                       (subst (list '= (ip Yp ek) (list '+ (ip Y ek) (ip cfa ek))))
                       (subst (list '= (ip cfa ek) (list '* ca (ip ea ek))))
                       (subst (list '= (ip ea ek) 0))
                       (subst (list '= (ip Y ek) 0))
                       (crs))
                     ;; k in t1: k in u, or k = a
                     (let ((um (dk-cite! 'union-membership u pr k)))
                       (use-em (list 'IN k u)
                         (lambda ()
                           (let ((ek (list 'e k)))
                             (dk-have! (list 'NOT (list '= a k))
                               (lambda ()
                                 (di)
                                 (dk-have! (list 'IN a u) (lambda () (subst (list '= a k)) (dk-ass!)))
                                 (ai (list 'NOT (list 'IN a u)))))
                             (dk-apply! c1 k)
                             (dk-apply! onb-orth-h a k)
                             (fact 'cips-ip-type 'v 'x ek)
                             (fact 'cips-ip-add-left 'v Y cfa ek)
                             (fact 'cips-ip-homog-left 'v ca ea ek)
                             (subst (list '= (ip Yp ek) (list '+ (ip Y ek) (ip cfa ek))))
                             (subst (list '= (ip cfa ek) (list '* ca (ip ea ek))))
                             (subst (list '= (ip ea ek) 0))
                             (subst (list '= (ip Y ek) (ip 'x ek)))
                             (crs)))
                         (lambda ()
                           (dk-have! (list 'IN k pr)
                             (lambda () (if (dk-only! um (list 'IN k t1) (list 'NOT (list 'IN k u))) (prop))))
                           (dk-cite! 'pair-self-eq a k)
                           (subst (list '= k a))
                           (fact 'cips-ip-add-left 'v Y cfa ea)
                           (fact 'cips-ip-homog-left 'v ca ea ea)
                           (subst (list '= (ip Yp ea) (list '+ (ip Y ea) (ip cfa ea))))
                           (subst (list '= (ip cfa ea) (list '* ca (ip ea ea))))
                           (subst (list '= (ip ea ea) 1))
                           (subst (list '= (ip Y ea) 0))
                           (crs)))))))
              (#t (error "onb step: unexpected goal" (expression->string g))))))))))
(define (onb-unit-at-family! a) (dk-apply! onb-unit-h a))
(define onb-stp
  (list 'FORALL 'u_
    (list 'IMPLIES (list 'AND (list 'IN 'u_ 'SET) (list 'AND (list 'IN (list 'CARD 'u_) 'NN) (list 'IN 'u_ onb-cls)))
      (list 'FORALL 'x_
        (list 'IMPLIES (list 'AND (list 'IN 'x_ 'SET) (list 'NOT (list 'IN 'x_ 'u_)))
              (list 'IN (list 'UNION 'u_ (list 'PAIR 'x_ 'x_)) onb-cls))))))
(dk-have! onb-stp
  (lambda ()
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (t1 (cadr gl))
           (u  (cadr t1))
           (a  (cadr (caddr t1)))
           (pr (list 'PAIR a a))
           (ih (dk-landed-find (lambda () (comp-me (list 'IN u onb-cls))) (dk-head? 'IMPLIES))))
      (onb-and! (list 'IN a 'SET) (list 'IN a 'SET))
      (fact 'pairing a a)
      (onb-and! (list 'IN u 'SET) (list 'IN pr 'SET))
      (fact 'union-set-closure u pr)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) (list 'IN t1 'SET))
             (ass)
             (onb-step-body! u a ih)))
       (dk-opened (lambda () (comp-mi)))))))
;; the induction
(dk-have! (list 'AND (list 'IN 'EMPTY-SET onb-cls) onb-stp)
          (lambda () (dk-conj-close! (lambda () (ass)))))
(let ((ind (dk-fact! 'finite-set-induction onb-cls)))
  (let* ((ld (dk-landed* (lambda () (di))))
         (w onb-w0))
    (onb-and! (list 'IN w 'SET) (list 'IN (list 'CARD w) 'NN))
    (let* ((inw (dk-apply! ind w))
           (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
      (ass))))
(onb-done! 'onb-partial-sums)

;;; ======================================================================
;;; from slice onb-e.scm
;;; onb-e.scm -- slice E (development): Bessel's inequality.

;;; ---------------------------------------------------------------------------
;;; THE FINITE BESSEL INEQUALITY.  For a finite w <= ix: P_w <= <x,x>, since
;;; 0 <= <x - Y_w, x - Y_w> = <x,x> - P_w.
(define (onb-bp-stmt)
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-FAMILY v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'FORALL 'w_ (list 'IMPLIES '(IN w_ SET) (list 'IMPLIES '(IN (CARD w_) NN)
          (list 'IMPLIES '(SUBSET w_ ix)
            (list '<= (onb-P 'w_) (onb-ip 'x 'x))))))))))))))
(sp (make-wff (onb-bp-stmt)))
(dk-peel!)
(let* ((w (cadr (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'NN)
                                                 (dk-head-is? (cadr h) 'CARD)))
                              "the finiteness of w"))))
       (Y (onb-Y w)) (P (onb-P w))
       (nY (list '(VNEG v) Y))
       (z (list '(VADD v) 'x nY))
       (ip onb-ip)
       (mP (list '- P))
       (zz (ip z z)) (xx (ip 'x 'x)))
  (fact 'onb-partial-sums 'v 'ix 'e 'x w)
  (dk-split-all!)
  (fact 'cips-vneg-type 'v Y)
  (fact 'cips-vadd-type 'v 'x nY)
  (fact 'cips-ip-self-real 'v z)
  (fact 'cips-ip-self-nonneg 'v z)
  (fact 'cips-ip-self-real 'v 'x)
  (fact 'cips-ip-type 'v 'x Y)
  (fact 'cips-ip-type 'v Y 'x)
  (fact 'cips-ip-type 'v 'x nY)
  (fact 'cips-expand-sum 'v 'x nY)
  (fact 'cips-ip-neg-right 'v 'x Y)
  (fact 'cips-ip-neg-self 'v Y)
  (fact 'cips-ip-conj-sym 'v Y 'x)
  (fact 'rr-neg-closed P)
  (fact 'cc-conjugate-fixes-rr P)
  (fact 'cc-conjugate-fixes-rr mP)
  (let ((eqn (list '= zz (list '+ (list '+ xx mP) (list '+ mP P)))))
    (dk-have! eqn
      (lambda ()
        (subst (list '= zz (list '+ (list '+ xx (ip 'x nY)) (list '+ (list 'conjugate (ip 'x nY)) (ip nY nY)))))
        (subst (list '= (ip 'x nY) (list '- (ip 'x Y))))
        (subst (list '= (ip nY nY) (ip Y Y)))
        (subst (list '= (ip 'x Y) (list 'conjugate (ip Y 'x))))
        (subst (list '= (ip Y 'x) P))
        (subst (list '= (ip Y Y) P))
        (subst (list '= (list 'conjugate P) P))
        (subst (list '= (list 'conjugate mP) mP))
        (if (not (proof-done? *ps*)) (if (dk-goal-head? '=) (rfl)))))
    (dk-ineq! (list '<= 0 zz) eqn (list 'IN zz 'RR) (list 'IN xx 'RR) (list 'IN P 'RR))))
(onb-done! 'onb-bessel-partial)

;;; ---------------------------------------------------------------------------
;;; BESSEL'S INEQUALITY (th-main Prop 2.5): sum_{i in ix} |<x,e_i>|^2 <= <x,x> = ||x||^2,
;;; the sum taken in [0,+inf] (ESUM).
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-FAMILY v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list '<= (list 'ESUM onb-gq) (onb-ip 'x 'x)))))))))))
(dk-peel!)
(let* ((gq onb-gq) (xx (onb-ip 'x 'x))
       (typ (onb-onf-typ! 'ix 'e))
       (dg (list 'DOM gq)))
  (fact 'fun-domain-in-set 'ix onb-V 'e)
  (dk-have! (list 'IN gq '(FUN ix RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((ld (dk-peel!))
                 (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld))))
            (onb-k-facts! k)
            (onb-m2-facts! k)
            (let ((iff (dk-cite! 'rr-pos-star-membership (onb-m2 k))))
              (if (dk-only! iff (list 'IN (onb-m2 k) 'RR) (list '<= 0 (onb-m2 k))) (prop))))))))
  ;; the shape the ESUM laws want (esum-scale.scm's esc-dom!)
  (dk-project! (list 'IN gq '(FUN ix)) 'fun-codomain-iff (list 'IN gq '(FUN ix RR-POS-STAR)))
  (onb-and! (list 'IN gq '(FUN ix)) '(IN ix SET))
  (fact 'dom-of-fun 'ix gq)
  (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dg 'SET) (list '= dg 'ix)))))
    (if dd2 (dk-split-all! (list dd2))))
  (dk-have! (list 'IN gq (list 'FUN dg 'RR-POS-STAR))
    (lambda () (subst (list '= dg 'ix)) (dk-ass!)))
  ;; <x,x> in RR-POS-STAR
  (fact 'cips-ip-self-real 'v 'x)
  (fact 'cips-ip-self-nonneg 'v 'x)
  (dk-have! (list 'IN xx 'RR-POS-STAR)
    (lambda ()
      (let ((iff (dk-cite! 'rr-pos-star-membership xx)))
        (if (dk-only! iff (list 'IN xx 'RR) (list '<= 0 xx)) (prop)))))
  ;; every finite partial sum is bounded by <x,x>
  (let ((bnd (list 'FORALL 'S
               (list 'IMPLIES (list 'AND '(IN S SET) (list 'AND '(IN (CARD S) NN) (list 'SUBSET 'S dg)))
                     (list '<= (onb-P 'S) xx)))))
    (dk-have! bnd
      (lambda ()
        (dk-peel!)
        (dk-split-all!)
        (let* ((sv (cadddr (cadr (dk-goal)))))
          (dk-rewrite-h! (list 'SUBSET sv dg) dg 'ix)
          (fact 'onb-bessel-partial 'v 'ix 'e 'x sv)
          (dk-ass!))))
    (onb-and! (list 'IN xx 'RR-POS-STAR) bnd)
    (fact 'esum-least gq xx)
    (dk-ass!)))
(onb-done! 'bessel-inequality)

;;; ======================================================================
;;; from slice onb-f.scm
;;; onb-f.scm -- slice F (development): the Cauchy criterion for unconditional summability
;;; in a complete normed abelian group.  The route is rake-asm-b2.scm's proof of
;;; absolute-summable-implies-summable, with the bound through P(b) - P(a) replaced by
;;; the Cauchy-net hypothesis itself.

(define (onb-hyp head what) (dk-pick (dk-head? head) what))
(define (onb-cq a)
  (and (pair? a) (eq? (car a) 'FORALL) (= (length a) 3)
       (let ((b (caddr a)))
         (and (pair? b) (eq? (car b) 'IMPLIES) (= (length b) 3) (caddr b)))))
(define (onb-NV grp) (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
(define (onb-S grp f w) (list 'FINSUM (onb-NV grp) f w))
(define (onb-M grp) (list 'NAG-METRIC-SPACE grp))
(define (onb-d grp x y) (list (list 'DIST (onb-M grp)) x y))

;; the Cauchy-net clause at a finite fin and a bound r:
;; every two finite a, b between fin and DOM f have d(S(a), S(b)) < r
(define (onb-cn-q grp f fin r)
  (list 'FORALL 'cna_ (list 'IMPLIES '(IN cna_ SET) (list 'IMPLIES '(IN (CARD cna_) NN)
    (list 'IMPLIES (list 'SUBSET fin 'cna_) (list 'IMPLIES (list 'SUBSET 'cna_ (list 'DOM f))
      (list 'FORALL 'cnb_ (list 'IMPLIES '(IN cnb_ SET) (list 'IMPLIES '(IN (CARD cnb_) NN)
        (list 'IMPLIES (list 'SUBSET fin 'cnb_) (list 'IMPLIES (list 'SUBSET 'cnb_ (list 'DOM f))
          (list '< (onb-d grp (onb-S grp f 'cna_) (onb-S grp f 'cnb_)) r))))))))))))
(define (onb-cn-fin grp f fin r)
  (list 'AND (list 'IN fin 'SET)
    (list 'AND (list 'IN (list 'CARD fin) 'NN)
      (list 'AND (list 'SUBSET fin (list 'DOM f)) (onb-cn-q grp f fin r)))))
(define (onb-cn grp f)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'fin (onb-cn-fin grp f 'fin 'eps)))))

;;; ---------------------------------------------------------------------------
;;; the choice sequence: gs(n) a finite set satisfying the Cauchy-net clause at rad(n)
(sp (make-wff
  (list 'FORALL 'grp (list 'FORALL 'f
    (list 'IMPLIES (onb-cn 'grp 'f)
      (list 'FORALL 'rad (list 'IMPLIES '(FORALL k (IMPLIES (IN k NN) (POS-RR (rad k))))
        (list 'FORSOME 'gs (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
          (onb-cn-fin 'grp 'f '(gs n) '(rad n))))))))))))
(dk-peel!)
(let* ((cnh (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'eps))) "the Cauchy-net hypothesis"))
       (posh (dk-pick (lambda (a) (let ((c (onb-cq a))) (and (pair? c) (eq? (car c) 'POS-RR))))
                      "the positivity of rad"))
       (qb (lambda (t k) (caddr (onb-cn-fin 'grp 'f t (list 'rad k)))))
       (lamG (list 'VNB-LAMBDA 'kv_ 'NN (list 'CHOICE (list 'SEP 'tv_ 'SET (qb 'tv_ 'kv_))))))
  (ew lamG)
  (let* ((landed (dk-peel!))
         (n (cadr (car landed)))
         (sep (list 'SEP 'tv_ 'SET (qb 'tv_ n))))
    (dk-lam-b!)
    (dk-apply! posh n)
    (let* ((ex (dk-apply! cnh (list 'rad n)))
           (t (dk-skolem! ex)))
      (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ sep))
        (lambda ()
          (ew t)
          (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
      (let ((mem (dk-fact! 'choice-axiom sep)))
        (dk-split-all! (dk-landed* (lambda () (sep-me mem))))
        (dk-conj-close! (lambda () (ass)))))))
(onb-done! 'onb-cauchy-net-choice-seq)

;;; ---------------------------------------------------------------------------
;;; THE CAUCHY CRITERION.
(define onb-cn-ctx #f)   ; (grp f D gsq rad M V cg)

;; with (SUBSET w D) in context: the pointwise typing of f over w in CARR V
(define (onb-ptw-f! grp f D w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w)
                                       (list 'IN (list f 'z_) (list 'CARR (onb-NV grp)))))))
    (dk-have! claim
      (lambda ()
        (let* ((landed (dk-peel!))
               (z (cadr (car landed))))
          (fact 'subset-mem-fwd w D z)
          (fact 'fun-apply-type-c f D (list 'CARR grp) z)
          (subst (list '== (list 'CARR (onb-NV grp)) (list 'CARR grp)))
          (ass))))
    claim))
;; finite w <= D in context: S(w) in CARR V, CARR grp, PTS M
(define (onb-sw-facts! w)
  (let* ((grp (list-ref onb-cn-ctx 0)) (f (list-ref onb-cn-ctx 1)) (D (list-ref onb-cn-ctx 2))
         (M (list-ref onb-cn-ctx 5)) (V (list-ref onb-cn-ctx 6)) (cg (list-ref onb-cn-ctx 7))
         (sw (onb-S grp f w)))
    (if (not (dk-asm? (list 'IN sw (list 'PTS M))))
        (begin
          (onb-ptw-f! grp f D w)
          (fact 'finsum-type-ptwise V w f)
          (dk-have! (list 'IN sw cg)
            (lambda () (subst (list '== cg (list 'CARR V))) (ass)))
          (dk-have! (list 'IN sw (list 'PTS M))
            (lambda () (subst (list '== (list 'PTS M) cg)) (ass)))))))
;; for ni in NN: gsq(ni) finite <= D, its Cauchy-net clause, rad(ni) real, S(gsq ni) typed;
;; returns the clause
(define (onb-gn! ni)
  (let* ((grp (list-ref onb-cn-ctx 0)) (f (list-ref onb-cn-ctx 1))
         (gsq (list-ref onb-cn-ctx 3)) (rad (list-ref onb-cn-ctx 4))
         (gn (list gsq ni))
         (q (onb-cn-q grp f gn (list rad ni))))
    (if (not (dk-asm? q))
        (let ((hq (dk-pick (lambda (a) (let ((c (onb-cq a)))
                                         (and (pair? c) (eq? (car c) 'AND)
                                              (dk-contains? c (list 'CARD (list gsq (cadr (cadr (caddr a)))))))))
                           "the choice-sequence property")))
          (dk-split-all! (list (dk-apply! hq ni)))
          (fact 'fun-apply-type-c rad 'NN 'RR ni)
          (onb-sw-facts! gn)))
    q))
;; (SUBSET a (UNION a b)) and (SUBSET b (UNION a b)) (rb2-sub-union!)
(define (onb-sub-union! a b)
  (dk-have! (list 'SUBSET b (list 'UNION a b))
    (lambda () (fact 'union-right-subset a b) (ass)))
  (dk-have! (list 'SUBSET a (list 'UNION a b))
    (lambda ()
      (fact 'union-right-subset b a)
      (fact 'union-comm b a)
      (subst (list '= (list 'UNION a b) (list 'UNION b a)))
      (ass))))
;; a, b <= c: (SUBSET (UNION a b) c) (rb2-union-sub!)
(define (onb-union-sub! a b c)
  (dk-have! (list 'SUBSET (list 'UNION a b) c)
    (lambda ()
      (mac 'subset-def)
      (let* ((landed (dk-peel!))
             (mem (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN)
                                               (equal? (caddr f) (list 'UNION a b))))
                              landed))
             (x (cadr mem))
             (cases (dk-landed-1 (lambda () (mac-h 'union-membership mem)))))
        (use-cases cases
          (lambda () (fact 'subset-mem-fwd a c x) (ass))
          (lambda () (fact 'subset-mem-fwd b c x) (ass)))))))

(sp (make-wff
  (list 'FORALL 'grp
    (list 'IMPLIES '(IS-NORMED-AG grp)
      (list 'IMPLIES '(IS-COMPLETE (NAG-METRIC-SPACE grp))
        (list 'FORALL 'f
          (list 'IMPLIES '(IN f (FUN (DOM f) (CARR grp)))
            (list 'IMPLIES (onb-cn 'grp 'f)
              '(IS-SUMMABLE grp f)))))))))
(dk-peel!)
(let* ((grp 'grp) (f 'f)
       (D (list 'DOM f))
       (M (onb-M grp))
       (V (onb-NV grp))
       (cg (list 'CARR grp))
       (dM (list 'DIST M)))
  ;; ---- the context
  (fact 'normed-ag-as-abelian-group-is-abelian-group grp)
  (onb-readoff! 'CARR grp 'NORMED-AG-AS-ABELIAN-GROUP)
  (fact 'abelian-group-is-group V)
  (fact 'nag-metric-space-is-metric-space grp)
  (fact 'nag-metric-carrier grp)
  (fact 'fun-domain-in-set D cg f)
  ;; ---- rad, a positive null sequence, and the choice sequence gsq
  (let* ((rex (dk-fact! 'null-rr-seq-exists))
         (rad (dk-skolem! rex))
         (nl  (dk-split! (dk-landed-1 (lambda () (mac-h 'null-rr-seq (list 'NULL-RR-SEQ rad))))))
         (nullh (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                          (dk-contains? a 'FORSOME) (dk-contains? a (list rad 'k))))
                         "the nullity of rad"))
         (cs  (dk-cite! 'onb-cauchy-net-choice-seq grp f))
         (gex (dk-apply! cs rad))
         (gsq (dk-skolem! gex #f)))
    (set! onb-cn-ctx (list grp f D gsq rad M V cg))
    (let ((seq (list 'VNB-LAMBDA 'kv_ 'NN (onb-S grp f (list gsq 'kv_)))))
      (dk-have! (list 'IN seq (list 'FUN 'NN (list 'PTS M)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let* ((landed (dk-peel!))
                     (k (cadr (car landed)))
                     (gk (list gsq k))
                     (hq (dk-pick (lambda (a) (let ((c (onb-cq a)))
                                                (and (pair? c) (eq? (car c) 'AND)
                                                     (dk-contains? c (list 'CARD (list gsq (cadr (cadr (caddr a)))))))))
                                  "the choice-sequence property")))
                (dk-split-all! (list (dk-apply! hq k)))
                (onb-ptw-f! grp f D gk)
                (fact 'finsum-type-ptwise V gk f)
                (subst (list '== (list 'PTS M) cg))
                (subst (list '== cg (list 'CARR V)))
                (ass))))))
      ;; ---- Cauchy: d(S Gm, S Gn) <= d(S Gm, S W) + d(S W, S Gn) < rad m + rad n, W = Gm u Gn
      (dk-have! (list 'IS-CAUCHY-SEQ M seq)
        (lambda ()
          (mac 'is-cauchy-seq)
          (dk-conj-close!
            (lambda ()
              (if (not (eq? (car (dk-goal)) 'FORALL))
                  (ass)
                  (let* ((landed (dk-peel!))
                         (eps (cadr (car landed)))
                         (h (dk-halve! eps))
                         (nx (dk-apply! nullh h))
                         (n0 (dk-skolem! nx))
                         (rbd (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a (list '<= n0 'k))))
                                       "the rad bound past N0")))
                    (fact 'rr-pos-rr-in-rr eps)
                    (ew n0)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (eq? (car (dk-goal)) 'FORALL))
                            (ass)
                            (let* ((landed2 (dk-peel!))
                                   (dgl (cadr (dk-goal)))
                                   (mi (cadr (cadr dgl))) (ni (cadr (caddr dgl))))
                              (dk-split-all! landed2)
                              (dk-lam-b!)
                              (let* ((qm (onb-gn! mi))
                                     (qn (onb-gn! ni))
                                     (gm (list gsq mi)) (gn (list gsq ni))
                                     (W (list 'UNION gm gn))
                                     (sgm (onb-S grp f gm)) (sgn (onb-S grp f gn)) (sw (onb-S grp f W))
                                     (rm (list rad mi)) (rn (list rad ni)))
                                (dk-have! (list 'AND (list 'IN gm 'SET) (list 'IN gn 'SET))
                                          (lambda () (dk-conj-close! (lambda () (ass)))))
                                (fact 'union-set-closure gm gn)
                                (fact 'card-union-nn gm gn)
                                (onb-sub-union! gm gn)
                                (onb-union-sub! gm gn D)
                                (onb-sw-facts! W)
                                (fact 'subset-refl gm)
                                (fact 'subset-refl gn)
                                (dk-apply! qm gm W)
                                (dk-apply! qn gn W)
                                (for-each (lambda (j)
                                            (dk-have! (list 'AND (list 'IN j 'NN) (list '<= n0 j))
                                                      (lambda () (dk-conj-close! (lambda () (ass)))))
                                            (dk-apply! rbd j))
                                          (list mi ni))
                                (fact 'metric-triangle M sgm sw sgn)
                                (fact 'metric-sym M sw sgn)
                                (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                                          (list (cons sgm sgn) (cons sgm sw) (cons sw sgn) (cons sgn sw)))
                                (dk-ineq! (list '<= (list dM sgm sgn)
                                                (list '+ (list dM sgm sw) (list dM sw sgn)))
                                          (list '= (list dM sw sgn) (list dM sgn sw))
                                          (list '< (list dM sgm sw) rm)
                                          (list '< (list dM sgn sw) rn)
                                          (list '<= rm h) (list '<= rn h)
                                          (list '= (list '+ h h) eps)
                                          (list 'IN (list dM sgm sgn) 'RR) (list 'IN (list dM sgm sw) 'RR)
                                          (list 'IN (list dM sw sgn) 'RR) (list 'IN (list dM sgn sw) 'RR)
                                          (list 'IN rm 'RR) (list 'IN rn 'RR)
                                          (list 'IN h 'RR) (list 'IN eps 'RR)))))))))))))
      ;; ---- the limit
      (let* ((cpl (list 'FORALL 'f (list 'IMPLIES (list 'IS-CAUCHY-SEQ M 'f) (list 'CONVERGES M 'f))))
             (cpl* (dk-project! cpl 'is-complete (list 'IS-COMPLETE M)))
             (cv  (dk-apply! cpl* seq))
             (lex (dk-landed-1 (lambda () (mac-h 'converges cv))))
             (L   (dk-skolem! lex))
             (ct  (dk-split! (dk-landed-1 (lambda () (mac-h 'converges-to (list 'CONVERGES-TO M seq L))))))
             (convh (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                              (dk-contains? a L) (dk-contains? a 'FORSOME)))
                             "the convergence to L")))
        (dk-have! (list 'IN L cg)
          (lambda () (subst (list '== cg (list 'PTS M))) (ass)))
        (mac 'is-summable)
        (ew L)
        (dk-conj-close!
          (lambda ()
            (if (eq? (car (dk-goal)) 'IN)
                (ass)
                (begin
                  (mac 'sums-to)
                  (let* ((landed (dk-peel!))
                         (eps (cadr (car landed)))
                         (h (dk-halve! eps))
                         (nx (dk-apply! nullh h))
                         (N1 (dk-skolem! nx))
                         (rbd (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a (list '<= N1 'k))))
                                       "the rad bound past N1"))
                         (cx (dk-apply! convh h))
                         (N2 (dk-skolem! cx))
                         (cvb (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a N2) (dk-contains? a L)))
                                       "the convergence bound past N2"))
                         (n0 (list '+ N1 N2)))
                    (fact 'rr-pos-rr-in-rr eps)
                    (dk-have! (list 'AND (list 'IN N1 'NN) (list 'IN N2 'NN))
                              (lambda () (dk-conj-close! (lambda () (ass)))))
                    (fact 'nn-add-closed N1 N2)
                    (dk-have! (list '<= N1 n0) (lambda () (dk-nn!)))
                    (dk-have! (list '<= N2 n0) (lambda () (dk-nn!)))
                    (let* ((q0 (onb-gn! n0))
                           (gn0 (list gsq n0))
                           (sg (onb-S grp f gn0)) (r0 (list rad n0))
                           (s0 (list seq n0)))
                      (dk-have! (list 'AND (list 'IN n0 'NN) (list '<= N1 n0))
                                (lambda () (dk-conj-close! (lambda () (ass)))))
                      (dk-apply! rbd n0)
                      (fact 'subset-refl gn0)
                      (let* ((cb (dk-apply! cvb n0))
                             (seq-eq (list '= s0 sg)))
                        (dk-have! seq-eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                        (let ((cb2 (dk-rewrite-h! cb s0 sg)))
                          (ew gn0)
                          (dk-conj-close!
                            (lambda ()
                              (cond ((not (eq? (car (dk-goal)) 'FORALL))
                                     (ass))
                                    (#t
                                     (let* ((landed3 (dk-peel!))
                                            (ext (cadr (cadr (car landed3))))
                                            (se (onb-S grp f ext)))
                                       (dk-split-all! landed3)
                                       (onb-sw-facts! ext)
                                       (dk-apply! q0 gn0 ext)
                                       (fact 'nag-metric-distance grp L se)
                                       (subst (list '= (list (list 'NRM grp) (list (list 'OPR grp) L
                                                                        (list (list 'INV grp) se)))
                                                    (list dM L se)))
                                       (fact 'metric-triangle M L sg se)
                                       (fact 'metric-sym M sg L)
                                       (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                                                 (list (cons L se) (cons L sg) (cons sg se) (cons sg L)))
                                       (dk-ineq! (list '<= (list dM L se)
                                                       (list '+ (list dM L sg) (list dM sg se)))
                                                 (list '= (list dM sg L) (list dM L sg))
                                                 cb2
                                                 (list '< (list dM sg se) r0)
                                                 (list '<= r0 h)
                                                 (list '= (list '+ h h) eps)
                                                 (list 'IN (list dM L se) 'RR) (list 'IN (list dM L sg) 'RR)
                                                 (list 'IN (list dM sg se) 'RR) (list 'IN (list dM sg L) 'RR)
                                                 (list 'IN r0 'RR) (list 'IN h 'RR)
                                                 (list 'IN eps 'RR)))))))))))))))))))
(onb-done! 'summable-of-cauchy-net)

;;; ======================================================================
;;; from slice onb-g.scm
;;; onb-g.scm -- slice G (development): nested partial sums; the expansion is Cauchy.

(define (onb-cf-of y) (list 'VNB-LAMBDA 'onk_ 'ix (list '(ACT v) (list '(IP v) y '(e onk_)) '(e onk_))))
(define (onb-gq-of y) (list 'VNB-LAMBDA 'onk_ 'ix
                            (list '* (list 'MAGNITUDE (list '(IP v) y '(e onk_)))
                                     (list 'MAGNITUDE (list '(IP v) y '(e onk_))))))
(define (onb-fin3 w sup)   ; the curried finite-subset prefix as a list of antecedents
  (list (list 'IN w 'SET) (list 'IN (list 'CARD w) 'NN) (list 'SUBSET w sup)))
(define (onb-curry ants body)
  (if (null? ants) body (list 'IMPLIES (car ants) (onb-curry (cdr ants) body))))
(define (onb-stmt-x body)  ; forall v CIPS, ix, e ONF, x in VEC . body
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-FAMILY v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v)) body))))))))
(define (onb-ps-split! y w)  ; cite onb-partial-sums at (y, w) and split it
  (dk-split-all! (list (dk-cite! 'onb-partial-sums 'v 'ix 'e y w))))
(define (onb-c1-of y w)      ; the clause <Y_w, e_q> = <y, e_q> for q in w
  (list 'FORALL 'onq_ (list 'IMPLIES '(IN onq_ ix) (list 'IMPLIES (list 'IN 'onq_ w)
    (list '= (onb-ip (list 'FINSUM onb-VG (onb-cf-of y) w) '(e onq_)) (onb-ip y '(e onq_)))))))

;;; ---------------------------------------------------------------------------
;;; NESTED PARTIAL SUMS: for finite w <= a <= ix, <Y_w, Y_a> = P_w.  Y_a has the same
;;; coefficients as x on a, so the partial sum of Y_a over w is Y_w (congruence), and
;;; onb-partial-sums at Y_a gives <Y_w, Y_a> = P_w.
(sp (make-wff (onb-stmt-x
  (list 'FORALL 'ona_ (onb-curry (onb-fin3 'ona_ 'ix)
    (list 'FORALL 'onw_ (onb-curry (onb-fin3 'onw_ 'ona_)
      (list '= (onb-ip (onb-Y 'onw_) (onb-Y 'ona_)) (onb-P 'onw_)))))))))
(dk-peel!)
(onb-sum-setup!)
(set! onb-typ-h (onb-onf-typ! 'ix 'e))
(let* ((a 'ona_) (w 'onw_)
       (Ya (onb-Y a)) (Yw (onb-Y w)) (Pw (onb-P w))
       (cf2 (onb-cf-of Ya)) (gq2 (onb-gq-of Ya))
       (Yw2 (list 'FINSUM onb-VG cf2 w)) (Pw2 (list 'FINSUM onb-RM gq2 w)))
  (fact 'subset-trans w a 'ix)
  (onb-ps-split! 'x a)
  (onb-ps-split! 'x w)
  (onb-ps-split! Ya w)
  (let* ((c1a (onb-c1-of 'x a))
        (pt! (lambda (lhs-f rhs-f m2?)
               (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w)
                                                    (list '= (list lhs-f 'z_) (list rhs-f 'z_))))))
                 (dk-have! claim
                   (lambda ()
                     (let ((z (cadr (car (dk-peel!)))))
                       (fact 'subset-mem-fwd w a z)
                       (fact 'subset-mem-fwd a 'ix z)
                       (onb-k-facts! z)
                       (fact 'cips-ip-type 'v Ya (list 'e z))
                       (if m2? (onb-m2-facts! z))
                       (dk-apply! c1a z)
                       (dk-lam-b!)
                       (dk-close-if! (lambda () (subst (list '= (onb-ip Ya (list 'e z)) (onb-ip 'x (list 'e z)))))
                                     (lambda () (rfl))))))
                 claim))))
    (if (not (dk-asm? c1a)) (error "onb nested: clause c1 at a not found"))
    (pt! cf2 onb-cf #f)
    (pt! gq2 onb-gq #t)
    (fact 'finsum-congruence-q onb-VG w cf2 onb-cf)
    (fact 'finsum-cm-congruence-q onb-RM w gq2 onb-gq)
    (subst (list '= Yw Yw2))
    (subst (list '= Pw Pw2))
    (dk-ass!)))
(onb-done! 'onb-partial-nested)

;;; ---------------------------------------------------------------------------
;;; THE DIFFERENCE: for finite w <= a <= ix, <Y_a - Y_w, Y_a - Y_w> = P_a - P_w.
(define (onb-sub y z) (list '(VADD v) y (list '(VNEG v) z)))
(sp (make-wff (onb-stmt-x
  (list 'FORALL 'ona_ (onb-curry (onb-fin3 'ona_ 'ix)
    (list 'FORALL 'onw_ (onb-curry (onb-fin3 'onw_ 'ona_)
      (let ((d (onb-sub (onb-Y 'ona_) (onb-Y 'onw_))))
        (list '= (onb-ip d d) (list '+ (onb-P 'ona_) (list '- (onb-P 'onw_))))))))))))
(dk-peel!)
(let* ((a 'ona_) (w 'onw_)
       (Ya (onb-Y a)) (Yw (onb-Y w)) (Pa (onb-P a)) (Pw (onb-P w))
       (nYw (list '(VNEG v) Yw))
       (d (onb-sub Ya Yw))
       (ip onb-ip) (mPw (list '- Pw)))
  (fact 'subset-trans w a 'ix)
  (onb-ps-split! 'x a)
  (onb-ps-split! 'x w)
  (fact 'onb-partial-nested 'v 'ix 'e 'x a w)
  (fact 'cips-vneg-type 'v Yw)
  (fact 'cips-vadd-type 'v Ya nYw)
  (fact 'cips-ip-type 'v Ya Yw)
  (fact 'cips-ip-type 'v Yw Ya)
  (fact 'cips-ip-type 'v Ya nYw)
  (fact 'cips-expand-sum 'v Ya nYw)
  (fact 'cips-ip-neg-right 'v Ya Yw)
  (fact 'cips-ip-neg-self 'v Yw)
  (fact 'cips-ip-conj-sym 'v Yw Ya)
  (fact 'rr-neg-closed Pw)
  (fact 'cc-conjugate-fixes-rr Pw)
  (fact 'cc-conjugate-fixes-rr mPw)
  (subst (list '= (ip d d) (list '+ (list '+ (ip Ya Ya) (ip Ya nYw)) (list '+ (list 'conjugate (ip Ya nYw)) (ip nYw nYw)))))
  (subst (list '= (ip Ya nYw) (list '- (ip Ya Yw))))
  (subst (list '= (ip nYw nYw) (ip Yw Yw)))
  (subst (list '= (ip Ya Yw) (list 'conjugate (ip Yw Ya))))
  (subst (list '= (ip Yw Ya) Pw))
  (subst (list '= (ip Yw Yw) Pw))
  (subst (list '= (ip Ya Ya) Pa))
  (subst (list '= (list 'conjugate Pw) Pw))
  (subst (list '= (list 'conjugate mPw) mPw))
  (crs))
(onb-done! 'onb-partial-diff)

;;; ---------------------------------------------------------------------------
;;; THE EXPANSION IS A CAUCHY NET.  E = sum |<x,e_i>|^2 is real (Bessel); for eps > 0 take
;;; h2 = eps/4 and a finite t with E < P_t + h2^2; for finite a, b between t and ix,
;;; d(Y_a, Y_t) = sqrt(P_a - P_t) <= sqrt(h2^2) = h2, likewise for b, so d(Y_a, Y_b) <= 2 h2 < eps.
;; land gq in FUN(ix, RPS), (= (DOM gq) ix), gq in FUN(DOM gq, RPS); ix in SET in context
(define (onb-gq-dom!)
  (let ((gq onb-gq) (dg (list 'DOM onb-gq)))
    (dk-have! (list 'IN gq '(FUN ix RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((ld (dk-peel!))
                   (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld))))
              (onb-k-facts! k)
              (onb-m2-facts! k)
              (let ((iff (dk-cite! 'rr-pos-star-membership (onb-m2 k))))
                (if (dk-only! iff (list 'IN (onb-m2 k) 'RR) (list '<= 0 (onb-m2 k))) (prop))))))))
    (dk-project! (list 'IN gq '(FUN ix)) 'fun-codomain-iff (list 'IN gq '(FUN ix RR-POS-STAR)))
    (onb-and! (list 'IN gq '(FUN ix)) '(IN ix SET))
    (fact 'dom-of-fun 'ix gq)
    (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dg 'SET) (list '= dg 'ix)))))
      (if dd2 (dk-split-all! (list dd2))))
    (dk-have! (list 'IN gq (list 'FUN dg 'RR-POS-STAR))
      (lambda () (subst (list '= dg 'ix)) (dk-ass!)))))
;; land cf in FUN(ix, VEC), (= (DOM cf) ix), cf in FUN(DOM cf, CARR G)
(define (onb-cf-dom!)
  (let ((cf onb-cf) (dc (list 'DOM onb-cf)))
    (dk-have! (list 'IN cf (list 'FUN 'ix onb-V))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((ld (dk-peel!))
                   (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld))))
              (onb-k-facts! k)
              (dk-ass!))))))
    (dk-project! (list 'IN cf '(FUN ix)) 'fun-codomain-iff (list 'IN cf (list 'FUN 'ix onb-V)))
    (onb-and! (list 'IN cf '(FUN ix)) '(IN ix SET))
    (fact 'dom-of-fun 'ix cf)
    (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dc 'SET) (list '= dc 'ix)))))
      (if dd2 (dk-split-all! (list dd2))))
    (dk-have! (list 'IN cf (list 'FUN dc (list 'CARR onb-G)))
      (lambda () (subst (list '= dc 'ix)) (subst (list '== (list 'CARR onb-G) onb-V)) (dk-ass!)))))
;; E = ESUM gq is real, E <= <x,x>
(define (onb-E-real!)
  (let ((E (list 'ESUM onb-gq)) (xx (onb-ip 'x 'x)))
    (fact 'bessel-inequality 'v 'ix 'e 'x)
    (fact 'esum-in onb-gq)
    (fact 'cips-ip-self-real 'v 'x)
    (onb-and! (list 'IN E 'RR-POS-STAR) (list 'IN xx 'RR))
    (fact 'rr-pos-star-le-real-in-rr E xx)
    E))
;; with (SUBSET a (DOM cf)) in context: (SUBSET a ix) and (SUBSET a (DOM gq))
(define (onb-dom-subs! a)
  (let ((s1 (dk-rewrite-h! (list 'SUBSET a (list 'DOM onb-cf)) (list 'DOM onb-cf) 'ix)))
    (dk-have! (list 'SUBSET a (list 'DOM onb-gq))
      (lambda () (subst (list '= (list 'DOM onb-gq) 'ix)) (dk-ass!)))
    s1))

(sp (make-wff (onb-stmt-x (onb-cn onb-G onb-cf))))
(dk-peel!)
(onb-sum-setup!)
(set! onb-typ-h (onb-onf-typ! 'ix 'e))
(fact 'fun-domain-in-set 'ix onb-V 'e)
(onb-gq-dom!)
(onb-cf-dom!)
(fact 'ip-normed-ag-is-normed-ag 'v)
(fact 'nag-metric-space-is-metric-space onb-G)
(fact 'nag-metric-carrier onb-G)
(fact 'ip-metric-space-unfold 'v)
(let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
       (E (onb-E-real!))
       (M (onb-M onb-G)) (dM (list 'DIST M))
       (ept (begin (fact 'rr-pos-rr-in-rr eps) eps))
       (h (dk-halve! eps))
       (hp (begin (fact 'rr-pos-rr-of-lt h) (list 'POS-RR h)))
       (h2 (dk-halve! h))
       (dl (list '* h2 h2)))
  (fact 'rr-mul-pos h2 h2)
  (onb-and! (list 'IN h2 'RR) (list 'IN h2 'RR))
  (fact 'rr-mul-closed h2 h2)
  (fact 'rr-pos-rr-of-lt dl)
  (dk-have! (list '<= 0 dl) (lambda () (dk-ineq! (list '< 0 dl) (list 'IN dl 'RR))))
  (dk-have! (list '<= 0 h2) (lambda () (dk-ineq! (list '< 0 h2) (list 'IN h2 'RR))))
  (let* ((ap (dk-cite! 'rb2-esum-approx onb-gq))
         (ex (dk-apply! ap dl))
         (t (dk-skolem! ex)))
    (dk-split-all!)
    (let* ((Yt (onb-Y t)) (Pt (onb-P t))
           (st (dk-rewrite-h! (list 'SUBSET t (list 'DOM onb-gq)) (list 'DOM onb-gq) 'ix)))
      (onb-ps-split! 'x t)
      (fact 'cips-ip-self-real 'v 'x)
      ;; sqrt(h2^2) = h2
      (dk-have! (list '= dl dl) (lambda () (rfl)))
      (onb-and! (list 'IN dl 'RR) (list '<= 0 dl))
      (onb-and! (list 'IN h2 'RR) (list '<= 0 h2))
      (fact 'sqrt-char dl h2)
      (dk-split-all! (list (dk-cite! 'sqrt-prop dl)))
      (dk-have! (list 'IN Yt (list 'PTS (onb-M onb-G)))
        (lambda () (subst (list '== (list 'PTS (onb-M onb-G)) (list 'CARR onb-G)))
                   (subst (list '== (list 'CARR onb-G) onb-V)) (dk-ass!)))
      (ew t)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (subst (list '= (list 'DOM onb-cf) 'ix)) (dk-ass!))
              (#t
               (let* ((ld (dk-peel!))
                      (gl (dk-goal))
                      (a (cadddr (cadr (cadr gl))))   ; (< (dM (FINSUM VG cf a) (FINSUM VG cf b)) eps)
                      (b (cadddr (caddr (cadr gl))))
                      (bound!   ; land (<= (dM Y_s Y_t) h2) and Y_s in PTS M, for s = a or b
                        (lambda (s)
                          (let* ((Ys (onb-Y s)) (Ps (onb-P s))
                                 (d (onb-sub Ys Yt)) (q (onb-ip d d)))
                            (onb-dom-subs! s)
                            (onb-ps-split! 'x s)
                            (fact 'onb-partial-diff 'v 'ix 'e 'x s t)
                            (onb-and! (list 'IN s 'SET) (list 'AND (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s (list 'DOM onb-gq))))
                            (fact 'esum-upper onb-gq s)
                            (fact 'cips-vneg-type 'v Yt)
                            (fact 'cips-vadd-type 'v Ys (list '(VNEG v) Yt))
                            (fact 'cips-ip-self-real 'v d)
                            (fact 'cips-ip-self-nonneg 'v d)
                            (dk-have! (list '<= q dl)
                              (lambda ()
                                (dk-ineq! (list '= q (list '+ Ps (list '- Pt)))
                                          (list '<= Ps E)
                                          (list '< E (list '+ Pt dl))
                                          (list 'IN q 'RR) (list 'IN Ps 'RR) (list 'IN Pt 'RR)
                                          (list 'IN E 'RR) (list 'IN dl 'RR))))
                            (onb-and! (list 'IN q 'RR) (list '<= 0 q))
                            (onb-and! (list 'IN dl 'RR) (list '<= q dl))
                            (fact 'sqrt-mono q dl)
                            (let* ((de (dk-cite! 'ip-metric-space-dist 'v Ys Yt))
                                   (de2 (dk-rewrite-h! de '(IP-METRIC-SPACE v) M)))
                              (dk-have! (list 'IN Ys (list 'PTS M))
                                (lambda () (subst (list '== (list 'PTS M) (list 'CARR onb-G)))
                                           (subst (list '== (list 'CARR onb-G) onb-V)) (dk-ass!)))
                              (fact 'metric-dist-real M Ys Yt)
                              (dk-split-all! (list (dk-cite! 'sqrt-prop q)))
                              (dk-have! (list '<= (list dM Ys Yt) h2)
                                (lambda ()
                                  (dk-ineq! de2
                                            (list '<= (list 'SQRT q) (list 'SQRT dl))
                                            (list '= (list 'SQRT dl) h2)
                                            (list 'IN (list dM Ys Yt) 'RR)
                                            (list 'IN (list 'SQRT q) 'RR)
                                            (list 'IN (list 'SQRT dl) 'RR)
                                            (list 'IN h2 'RR)))))))))
                 (dk-split-all! ld)
                 (bound! a)
                 (bound! b)
                 (let ((Ya (onb-Y a)) (Yb (onb-Y b)))
                   (fact 'metric-triangle M Ya Yt Yb)
                   (fact 'metric-sym M Yt Yb)
                   (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                             (list (cons Ya Yb) (cons Ya Yt) (cons Yt Yb) (cons Yb Yt)))
                   (dk-ineq! (list '<= (list dM Ya Yb) (list '+ (list dM Ya Yt) (list dM Yt Yb)))
                             (list '= (list dM Yt Yb) (list dM Yb Yt))
                             (list '<= (list dM Ya Yt) h2)
                             (list '<= (list dM Yb Yt) h2)
                             (list '= (list '+ h2 h2) h)
                             (list '= (list '+ h h) eps)
                             (list '< 0 h)
                             (list 'IN (list dM Ya Yb) 'RR) (list 'IN (list dM Ya Yt) 'RR)
                             (list 'IN (list dM Yt Yb) 'RR) (list 'IN (list dM Yb Yt) 'RR)
                             (list 'IN h2 'RR) (list 'IN h 'RR) (list 'IN eps 'RR))))))))))))
(onb-done! 'onb-expansion-cauchy-net)

;;; ======================================================================
;;; from slice onb-h.scm
;;; onb-h.scm -- slice H (development): the unordered expansion x = sum <x,e_i> e_i (th-main
;;; Prop 2.10) and Parseval's identity (Prop 2.6).

(define (onb-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;; w in VEC: (IN (IP-NORM v w) RR), (== (IP-NORM v w) (SQRT <w,w>)), sqrt-prop at <w,w>
(define (onb-norm-facts! w)
  (let* ((q (onb-ip w w)) (n (list 'IP-NORM 'v w)))
    (fact 'cips-ip-self-real 'v w)
    (fact 'cips-ip-self-nonneg 'v w)
    (onb-and! (list 'IN q 'RR) (list '<= 0 q))
    (dk-split-all! (list (dk-cite! 'sqrt-prop q)))
    (dk-have! (list '== n (list 'SQRT q)) (lambda () (mac 'IP-NORM) (qrfl)))
    (dk-have! (list 'IN n 'RR) (lambda () (subst (list '== n (list 'SQRT q))) (dk-ass!)))
    n))
;; bnd = (< ((NRM G) ((OPR G) r ((INV G) Yext))) eps) in context, r and Yext in VEC:
;; land and return (< (IP-NORM v (r - Yext)) eps)
(define (onb-res-norm! bnd r yext)
  (let* ((ny (list '(VNEG v) yext)) (w (list '(VADD v) r ny)))
    (fact 'cips-vneg-type 'v yext)
    (fact 'cips-vadd-type 'v r ny)
    (fact 'ip-normed-ag-opr 'v)
    (fact 'ip-normed-ag-inv 'v)
    (fact 'ip-normed-ag-norm-value 'v w)
    (let* ((b1 (dk-rewrite-h! bnd (list 'OPR onb-G) '(VADD v)))
           (b2 (dk-rewrite-h! b1 (list 'INV onb-G) '(VNEG v)))
           (b3 (dk-rewrite-h! b2 (list (list 'NRM onb-G) w) (list 'IP-NORM 'v w))))
      b3)))
;; the SUMS-TO guard at ext, from (SUBSET ext ix), (SUBSET fin ext) and finiteness in context
(define (onb-ext-guard! fin ext)
  (dk-have! (list 'SUBSET ext (list 'DOM onb-cf))
    (lambda () (subst (list '= (list 'DOM onb-cf) 'ix)) (dk-ass!)))
  (onb-and! (list 'IN ext 'SET)
            (list 'AND (list 'IN (list 'CARD ext) 'NN)
                  (list 'AND (list 'SUBSET fin ext) (list 'SUBSET ext (list 'DOM onb-cf))))))
;; the common context of the two theorems
(define (onb-h-setup!)
  (onb-sum-setup!)
  (set! onb-typ-h (onb-onf-typ! 'ix 'e))
  (set! onb-unit-h (onb-onf-unit! 'ix 'e))
  (fact 'fun-domain-in-set 'ix onb-V 'e)
  (onb-gq-dom!)
  (onb-cf-dom!))

;;; ---------------------------------------------------------------------------
;;; THE COEFFICIENTS OF A LIMIT.  If cf sums to L then <L, e_k> = <x, e_k>: for
;;; ext = fin u {k}, |<L,e_k> - <x,e_k>| = |<L - Y_ext, e_k>| <= ||L - Y_ext|| < eps.
(sp (make-wff (onb-stmt-x
  (list 'FORALL 'onl_ (list 'IMPLIES '(IN onl_ (VEC v))
    (list 'IMPLIES (list 'SUMS-TO onb-G onb-cf 'onl_)
      (list 'FORALL 'onp_ (list 'IMPLIES '(IN onp_ ix)
        (list '= (onb-ip 'onl_ '(e onp_)) (onb-ip 'x '(e onp_)))))))))))
(dk-peel!)
(onb-h-setup!)
(let* ((st (dk-pick (dk-head? 'SUMS-TO) "the summation hypothesis"))
       (L (cadddr st))
       (gl (dk-goal))
       (k (cadr (caddr (cadr gl))))
       (ek (list 'e k))
       (p (onb-ip L ek)) (q (onb-ip 'x ek))
       (c (list '+ p (list '- q)))
       (m (list 'MAGNITUDE c)))
  (onb-k-facts! k)
  (fact 'cips-ip-type 'v L ek)
  (fact 'cc-neg-closed q)
  (onb-and! (list 'IN p 'CC) (list 'IN (list '- q) 'CC))
  (fact 'cc-add-closed p (list '- q))
  (fact 'cc-magnitude-closed c)
  (fact 'cc-magnitude-nonneg c)
  (use-em (list '= m 0)
    (lambda ()
      (let ((iff (dk-cite! 'cc-magnitude-zero-iff c)))
        (dk-have! (list '= c 0) (lambda () (if (dk-only! iff (list '= m 0)) (prop))))
        (dk-have! (list '= p (list '+ c q)) (lambda () (crs)))
        (subst (list '= p (list '+ c q)))
        (subst (list '= c 0))
        (crs)))
    (lambda ()
      (fact 'neq-sym m 0)
      (dk-have! (list 'POS-RR m) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))
      (let* ((sb (dk-landed-1 (lambda () (mac-h 'sums-to st))))
             (ex (dk-apply! sb m))
             (fin (dk-skolem! ex)))
        (dk-split-all!)
        (dk-rewrite-h! (list 'SUBSET fin (list 'DOM onb-cf)) (list 'DOM onb-cf) 'ix)
        (let* ((pr (list 'PAIR k k))
               (ext (list 'UNION fin pr))
               (ye (onb-Y ext)))
          (fact 'membership-implies-sethood k 'ix)
          (onb-and! (list 'IN k 'SET) (list 'IN k 'SET))
          (fact 'pairing k k)
          (fact 'card-singleton k)
          (dk-have! (list 'IN (list 'CARD pr) 'NN)
            (lambda () (subst (list '= (list 'CARD pr) '(succ 0))) (fact 'nn-zero-in) (fact 'nn-succ-closed 0) (dk-ass!)))
          (dk-have! (list 'SUBSET pr 'ix)
            (lambda ()
              (mac 'subset-def)
              (let* ((z (dk-di-var!))
                     (pm (dk-apply! (dk-cite! 'pairing-membership k k) z)))
                (dk-have! (list '= z k) (lambda () (if (dk-only! pm (list 'IN z pr)) (prop))))
                (subst (list '= z k))
                (dk-ass!))))
          (onb-and! (list 'IN fin 'SET) (list 'IN pr 'SET))
          (fact 'union-set-closure fin pr)
          (fact 'card-union-nn fin pr)
          (onb-sub-union! fin pr)
          (onb-union-sub! fin pr 'ix)
          (fact 'union-singleton-mem k fin)
          (fact 'union-comm fin pr)
          (dk-have! (list 'IN k ext) (lambda () (subst (list '= ext (list 'UNION pr fin))) (dk-ass!)))
          (onb-ps-split! 'x ext)
          (onb-ext-guard! fin ext)
          (let* ((bnd (dk-apply! (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'NRM onb-G)) (dk-contains? a fin)))
                                          "the tail bound")
                                 ext))
                 (b3 (onb-res-norm! bnd L ye))
                 (d (list '(VADD v) L (list '(VNEG v) ye)))
                 (nd (onb-norm-facts! d))
                 (ne (list 'IP-NORM 'v ek))
                 (c1 (onb-c1-of 'x ext)))
            (dk-apply! c1 k)
            (fact 'cips-ip-type 'v ye ek)
            (fact 'cips-ip-add-left 'v L (list '(VNEG v) ye) ek)
            (fact 'cips-ip-neg-left 'v ye ek)
            (dk-have! (list '= (onb-ip d ek) c)
              (lambda ()
                (subst (list '= (onb-ip d ek) (list '+ p (onb-ip (list '(VNEG v) ye) ek))))
                (subst (list '= (onb-ip (list '(VNEG v) ye) ek) (list '- (onb-ip ye ek))))
                (subst (list '= (onb-ip ye ek) q))
                (dk-close-if! (lambda () #t) (lambda () (rfl)))))
            ;; ||e_k|| = 1
            (dk-apply! onb-unit-h k)
            (fact 'rr-one-in)
            (dk-have! (list '<= 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
            (onb-and! '(IN 1 RR) '(<= 0 1))
            (dk-have! '(= (* 1 1) 1) (lambda () (crs)))
            (fact 'sqrt-char 1 1)
            (dk-have! (list '= ne 1)
              (lambda () (mac 'IP-NORM) (subst (list '= (onb-ip ek ek) 1)) (dk-ass!)))
            (let* ((ml (dk-cite! 'cips-ip-magnitude-le 'v d ek))
                   (ml2 (dk-rewrite-h! ml (onb-ip d ek) c))
                   (ml3 (dk-rewrite-h! ml2 ne 1)))
              (dk-have! 'FALSITY
                (lambda ()
                  (dk-absurd! ml3 b3 (list 'IN nd 'RR) (list 'IN m 'RR))))
              (onb-keep-prop! 'FALSITY))))))))
(onb-done! 'onb-coef-limit)

;;; ---------------------------------------------------------------------------
;;; THE EXPANSION (th-main Prop 2.10): in a Hilbert space, for an orthonormal basis e,
;;; x = sum_{i in ix} <x, e_i> e_i, unconditionally (SUMS-TO in the normed group of v).
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'SUMS-TO onb-G onb-cf 'x))))))))))
(dk-peel!)
(dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE v) 'is-hilbert-space '(IS-HILBERT-SPACE v))
(dk-project! '(IS-COMPLETE (IP-METRIC-SPACE v)) 'is-hilbert-space '(IS-HILBERT-SPACE v))
(dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(define onb-cpl-form
  '(FORALL onx_ (IMPLIES (IN onx_ (VEC v))
     (IMPLIES (FORALL oni_ (IMPLIES (IN oni_ ix) (= ((IP v) onx_ (e oni_)) 0)))
              (= onx_ (VZERO v))))))
(dk-project! onb-cpl-form 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(onb-h-setup!)
(fact 'ip-normed-ag-is-normed-ag 'v)
(fact 'ip-metric-space-unfold 'v)
(dk-rewrite-h! '(IS-COMPLETE (IP-METRIC-SPACE v)) '(IP-METRIC-SPACE v) (onb-M onb-G))
(fact 'onb-expansion-cauchy-net 'v 'ix 'e 'x)
(fact 'summable-of-cauchy-net onb-G onb-cf)
(let* ((sm (list 'IS-SUMMABLE onb-G onb-cf))
       (ex (dk-landed-1 (lambda () (mac-h 'is-summable sm))))
       (L (dk-skolem! ex))
       (z (list '(VADD v) 'x (list '(VNEG v) L))))
  (dk-have! (list 'IN L onb-V)
    (lambda () (subst (list '== onb-V (list 'CARR onb-G))) (dk-ass!)))
  (let ((cl (dk-cite! 'onb-coef-limit 'v 'ix 'e 'x L)))
    (fact 'cips-vneg-type 'v L)
    (fact 'cips-vadd-type 'v 'x (list '(VNEG v) L))
    (dk-have! (list 'FORALL 'oni_ (list 'IMPLIES '(IN oni_ ix) (list '= (onb-ip z '(e oni_)) 0)))
      (lambda ()
        (let* ((k (cadr (car (dk-peel!)))) (ek (list 'e k)))
          (onb-k-facts! k)
          (fact 'cips-ip-type 'v L ek)
          (dk-apply! cl k)
          (fact 'cips-ip-add-left 'v 'x (list '(VNEG v) L) ek)
          (fact 'cips-ip-neg-left 'v L ek)
          (subst (list '= (onb-ip z ek) (list '+ (onb-ip 'x ek) (onb-ip (list '(VNEG v) L) ek))))
          (subst (list '= (onb-ip (list '(VNEG v) L) ek) (list '- (onb-ip L ek))))
          (subst (list '= (onb-ip L ek) (onb-ip 'x ek)))
          (crs))))
    (dk-apply! (dk-ctx-form onb-cpl-form) z)
    (fact 'cips-vzero-in 'v)
    (fact 'cips-ip-zero-left 'v '(VZERO v))
    (dk-have! (list '= (onb-ip z z) 0)
      (lambda () (subst (list '= z '(VZERO v))) (dk-ass!)))
    (fact 'cips-eq-of-dist-sq-zero 'v 'x L)
    (dk-rewrite-h! (list 'SUMS-TO onb-G onb-cf L) L 'x)
    (dk-ass!)))
(onb-done! 'onb-expansion)

;;; ======================================================================
;;; from slice onb-i.scm
;;; onb-i.scm -- slice I (development): Parseval's identity (th-main Prop 2.6).

;;; the residual: for finite w <= ix, <x - Y_w, x - Y_w> = <x,x> - P_w
(sp (make-wff (onb-stmt-x
  (list 'FORALL 'onw_ (onb-curry (onb-fin3 'onw_ 'ix)
    (let ((z (onb-sub 'x (onb-Y 'onw_))))
      (list '= (onb-ip z z) (list '+ (onb-ip 'x 'x) (list '- (onb-P 'onw_))))))))))
(dk-peel!)
(let* ((w 'onw_)
       (Y (onb-Y w)) (P (onb-P w))
       (nY (list '(VNEG v) Y))
       (z (onb-sub 'x Y))
       (ip onb-ip)
       (mP (list '- P))
       (zz (ip z z)) (xx (ip 'x 'x)))
  (onb-ps-split! 'x w)
  (fact 'cips-vneg-type 'v Y)
  (fact 'cips-vadd-type 'v 'x nY)
  (fact 'cips-ip-type 'v 'x Y)
  (fact 'cips-ip-type 'v Y 'x)
  (fact 'cips-ip-type 'v 'x nY)
  (fact 'cips-expand-sum 'v 'x nY)
  (fact 'cips-ip-neg-right 'v 'x Y)
  (fact 'cips-ip-neg-self 'v Y)
  (fact 'cips-ip-conj-sym 'v Y 'x)
  (fact 'rr-neg-closed P)
  (fact 'cc-conjugate-fixes-rr P)
  (fact 'cc-conjugate-fixes-rr mP)
  (fact 'cips-ip-self-real 'v 'x)
  (subst (list '= zz (list '+ (list '+ xx (ip 'x nY)) (list '+ (list 'conjugate (ip 'x nY)) (ip nY nY)))))
  (subst (list '= (ip 'x nY) (list '- (ip 'x Y))))
  (subst (list '= (ip nY nY) (ip Y Y)))
  (subst (list '= (ip 'x Y) (list 'conjugate (ip Y 'x))))
  (subst (list '= (ip Y 'x) P))
  (subst (list '= (ip Y Y) P))
  (subst (list '= (list 'conjugate P) P))
  (subst (list '= (list 'conjugate mP) mP))
  (crs))
(onb-done! 'onb-residual)

;;; ---------------------------------------------------------------------------
;;; PARSEVAL (th-main Prop 2.6): in a Hilbert space, for an orthonormal basis e,
;;; sum_{i in ix} |<x,e_i>|^2 = <x,x> = ||x||^2.  Bessel gives <=; if E < <x,x>, put
;;; d = <x,x> - E and s = sqrt(d); the expansion gives a finite F with ||x - Y_F|| < s,
;;; while ||x - Y_F||^2 = <x,x> - P_F >= <x,x> - E = d, so sqrt(d) <= ||x - Y_F|| < sqrt(d).
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list '= (list 'ESUM onb-gq) (onb-ip 'x 'x)))))))))))
(dk-peel!)
(dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE v) 'is-hilbert-space '(IS-HILBERT-SPACE v))
(dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(onb-h-setup!)
(let* ((E (onb-E-real!))
       (xx (onb-ip 'x 'x))
       (st (dk-cite! 'onb-expansion 'v 'ix 'e 'x)))
  (use-em (list '<= xx E)
    (lambda ()
      (onb-and! (list 'IN E 'RR) (list 'IN xx 'RR))
      (onb-and! (list '<= E xx) (list '<= xx E))
      (fact 'rr-leq-antisymmetric E xx)
      (dk-ass!))
    (lambda ()
      (fact 'rr-not-le-lt xx E)
      (let* ((d (list '+ xx (list '- E)))
             (s (list 'SQRT d)))
        (fact 'rr-neg-closed E)
        (onb-and! (list 'IN xx 'RR) (list 'IN (list '- E) 'RR))
        (fact 'rr-add-closed xx (list '- E))
        (dk-have! (list '< 0 d) (lambda () (dk-ineq! (list '< E xx) (list 'IN E 'RR) (list 'IN xx 'RR))))
        (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
        (onb-and! (list 'IN d 'RR) (list '<= 0 d))
        (dk-split-all! (list (dk-cite! 'sqrt-prop d)))
        (dk-have! (list 'NOT (list '= 0 s))
          (lambda ()
            (di)
            (dk-have! (list '= d 0)
              (lambda () (subst (list '= d (list '* s s))) (subst (list '= s 0)) (crs)))
            (dk-absurd! (list '= d 0) (list '< 0 d) (list 'IN d 'RR))))
        (dk-have! (list 'POS-RR s) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))
        (let* ((sb (dk-landed-1 (lambda () (mac-h 'sums-to st))))
               (ex (dk-apply! sb s))
               (fin (dk-skolem! ex)))
          (dk-split-all!)
          (onb-dom-subs! fin)
          (onb-ps-split! 'x fin)
          (fact 'subset-refl fin)
          (onb-ext-guard! fin fin)
          (let* ((Yf (onb-Y fin)) (Pf (onb-P fin))
                 (bnd (dk-apply! (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'NRM onb-G))
                                                           (dk-contains? a fin)))
                                          "the tail bound")
                                 fin))
                 (b3 (onb-res-norm! bnd 'x Yf))
                 (w (onb-sub 'x Yf))
                 (q (onb-ip w w))
                 (nw (onb-norm-facts! w))
                 (b4 (dk-rewrite-h! b3 nw (list 'SQRT q))))
            (fact 'onb-residual 'v 'ix 'e 'x fin)
            (onb-and! (list 'IN fin 'SET) (list 'AND (list 'IN (list 'CARD fin) 'NN) (list 'SUBSET fin (list 'DOM onb-gq))))
            (fact 'esum-upper onb-gq fin)
            (dk-have! (list '<= d q)
              (lambda ()
                (dk-ineq! (list '= q (list '+ xx (list '- Pf)))
                          (list '<= Pf E)
                          (list 'IN q 'RR) (list 'IN Pf 'RR) (list 'IN E 'RR) (list 'IN xx 'RR))))
            (onb-and! (list 'IN q 'RR) (list '<= d q))
            (onb-and! (list 'IN d 'RR) (list '<= 0 d))
            (fact 'sqrt-mono d q)
            (dk-have! 'FALSITY
              (lambda ()
                (dk-absurd! (list '<= s (list 'SQRT q)) b4
                            (list 'IN s 'RR) (list 'IN (list 'SQRT q) 'RR))))
            (onb-keep-prop! 'FALSITY)))))))
(onb-done! 'parseval-identity)
