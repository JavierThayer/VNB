;;; from slice onb-b.scm
;;; onb-b.scm -- slice B (development): orthonormal sets, Zorn.

(define (onb-has-nth-list? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred onb-has-nth-list? e))))
(define (onb-nth-all!) (let loop ((k 0)) (if (and (< k 10) (onb-has-nth-list? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
(define (onb-nth-redex e)
  (cond ((not (and (pair? e) (list? e))) #f)
        ((let loop ((xs e)) (cond ((null? xs) #f) ((onb-nth-redex (car xs))) (#t (loop (cdr xs))))))
        ((and (eq? (car e) 'NTH) (= (length e) 3) (number? (cadr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)
              (<= (cadr e) (length (cdr (caddr e)))))
         e)
        (#t #f)))
(define (onb-nth-h! f)
  (let loop ((f f) (k 0))
    (let ((rx (onb-nth-redex f)))
      (if (and rx (< k 12))
          (let* ((v (list-ref (caddr rx) (cadr rx))) (e (list '= rx v)))
            (if (not (dk-asm? e)) (dk-have! e (lambda () (onb-nth-all!) (rfl))))
            (loop (dk-rewrite-h! f rx v) (+ k 1)))
          f))))

(define onb-V '(VEC v))
(define (onb-ip a b) (list '(IP v) a b))
(define (onb-os s) (list 'IS-ORTHONORMAL-SET 'v s))
;; the three projections of IS-ORTHONORMAL-SET(v, s), for s with the predicate in context
(define (onb-os-sub! s)
  (dk-project! (list 'SUBSET s onb-V) 'is-orthonormal-set (onb-os s)))
(define (onb-os-unit! s)
  (dk-project! (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ s) (list '= (onb-ip 'osa_ 'osa_) 1)))
               'is-orthonormal-set (onb-os s)))
(define (onb-os-orth! s)
  (dk-project! (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ s)
                 (list 'FORALL 'osb_ (list 'IMPLIES (list 'IN 'osb_ s)
                   (list 'IMPLIES (list 'NOT (list '= 'osa_ 'osb_)) (list '= (onb-ip 'osa_ 'osb_) 0))))))
               'is-orthonormal-set (onb-os s)))
;; z in s, s orthonormal: <z,z> = 1
(define (onb-unit-at! s z) (dk-apply! (onb-os-unit! s) z))
;; z, w in s, z /= w in context: <z,w> = 0
(define (onb-orth-at! s z w) (dk-apply! (onb-os-orth! s) z w))

;;; ---------------------------------------------------------------------------
;;; a union of a chain of orthonormal sets is orthonormal
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (FORALL ch
     (IMPLIES (FORALL ona_ (IMPLIES (IN ona_ ch) (IS-ORTHONORMAL-SET v ona_)))
       (IMPLIES (FORALL ona_ (IMPLIES (IN ona_ ch) (FORALL onb_ (IMPLIES (IN onb_ ch)
                  (OR (SUBSET ona_ onb_) (SUBSET onb_ ona_))))))
         (IS-ORTHONORMAL-SET v (BIG-UNION onw_ ch onw_)))))))))
(dk-peel!)
(let* ((ub '(BIG-UNION onw_ ch onw_))
       (osh (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'IS-ORTHONORMAL-SET))) "chain members"))
       (cmp (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'OR))) "comparability"))
       ;; z in ub: land (IN a ch), (IN z a), (IS-ORTHONORMAL-SET v a); return a
       (open! (lambda (z)
                (let* ((ld (dk-landed (lambda () (bu-me (list 'IN z ub)))))
                       (a (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ch))) ld))))
                  (dk-apply! osh a)
                  a))))
  (mac 'is-orthonormal-set)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def)
           (let* ((z (dk-di-var!)) (a (open! z)))
             (onb-os-sub! a)
             (fact 'subset-mem-fwd a onb-V z)
             (dk-ass!)))
          (#t
           (let* ((ld (dk-peel!))
                  (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ub))) ld))))
             (if (= (length zs) 1)
                 (let* ((z (car zs)) (a (open! z)))
                   (onb-unit-at! a z)
                   (dk-ass!))
                 (let* ((z (car zs)) (w (cadr zs))
                        (a (open! z)) (b (open! w)))
                   (dk-apply! cmp a b)
                   (use-em (list 'SUBSET a b)
                     (lambda ()
                       (fact 'subset-mem-fwd a b z)
                       (onb-orth-at! b z w)
                       (dk-ass!))
                     (lambda ()
                       (dk-have! (list 'SUBSET b a)
                         (lambda () (if (dk-only! (list 'OR (list 'SUBSET a b) (list 'SUBSET b a))
                                                  (list 'NOT (list 'SUBSET a b)))
                                        (prop))))
                       (fact 'subset-mem-fwd b a w)
                       (onb-orth-at! a z w)
                       (dk-ass!))))))))))))
(onb-done! 'onb-orthonormal-chain-union)

;;; ---------------------------------------------------------------------------
;;; adding a unit vector orthogonal to an orthonormal set keeps it orthonormal
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL m (IMPLIES (IS-ORTHONORMAL-SET v m)
       (FORALL u (IMPLIES (IN u (VEC v)) (IMPLIES (= ((IP v) u u) 1)
         (IMPLIES (FORALL ona_ (IMPLIES (IN ona_ m) (= ((IP v) u ona_) 0)))
           (IS-ORTHONORMAL-SET v (UNION m (PAIR u u)))))))))))))
(dk-peel!)
(let* ((pr '(PAIR u u))
       (nn '(UNION m (PAIR u u)))
       (orh (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '(IP v)) (dk-contains? a 'm))) "u orthogonal to m"))
       ;; z in m u {u}: run in-m when z in m, else land z = u and run is-u
       (cases! (lambda (z in-m is-u)
                 (let ((um (dk-cite! 'union-membership 'm pr z)))
                   (use-em (list 'IN z 'm)
                     in-m
                     (lambda ()
                       (dk-have! (list 'IN z pr)
                         (lambda () (if (dk-only! um (list 'IN z nn) (list 'NOT (list 'IN z 'm))) (prop))))
                       (dk-cite! 'pair-self-eq 'u z)
                       (is-u)))))))
  (fact 'membership-implies-sethood 'u onb-V)
  (onb-os-sub! 'm)
  (fact 'rr-zero-in)
  (fact 'cc-conjugate-fixes-rr 0)
  (mac 'is-orthonormal-set)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def)
           (let ((z (dk-di-var!)))
             (cases! z
               (lambda () (fact 'subset-mem-fwd 'm onb-V z) (dk-ass!))
               (lambda () (subst (list '= z 'u)) (dk-ass!)))))
          (#t
           (let* ((ld (dk-peel!))
                  (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) nn))) ld))))
             (if (= (length zs) 1)
                 (let ((z (car zs)))
                   (cases! z
                     (lambda () (onb-unit-at! 'm z) (dk-ass!))
                     (lambda () (subst (list '= z 'u)) (dk-ass!))))
                 (let ((z (car zs)) (w (cadr zs)))
                   (cases! z
                     (lambda ()
                       (cases! w
                         (lambda () (onb-orth-at! 'm z w) (dk-ass!))
                         (lambda ()
                           ;; <z,u> = conj <u,z> = conj 0 = 0
                           (subst (list '= w 'u))
                           (fact 'subset-mem-fwd 'm onb-V z)
                           (dk-apply! orh z)
                           (fact 'cips-ip-conj-sym 'v 'u z)
                           (subst (list '= (onb-ip z 'u) (list 'conjugate (onb-ip 'u z))))
                           (subst (list '= (onb-ip 'u z) 0))
                           (subst '(= (conjugate 0) 0))
                           (rfl))))
                     (lambda ()
                       (cases! w
                         (lambda ()
                           (subst (list '= z 'u))
                           (dk-apply! orh w)
                           (dk-ass!))
                         (lambda ()
                           ;; z = u = w contradicts z /= w
                           (let ((ne (list 'NOT (list '= z w))))
                             (dk-have! (list '= z w)
                               (lambda () (subst (list '= z 'u)) (subst (list '= w 'u)) (rfl)))
                             (if (dk-only! ne (list '= z w)) (prop))))))))))))))))
(onb-done! 'onb-orthonormal-insert)

;;; ---------------------------------------------------------------------------
;;; ZORN: every orthonormal set lies in a COMPLETE one (nothing nonzero is orthogonal to it)
(define onb-GRD '(SEP onm_ (POWER (VEC v)) (AND (SUBSET s0 onm_) (IS-ORTHONORMAL-SET v onm_))))
(define onb-POR (list 'SEP 'onr_ (list 'CARTESIAN onb-GRD onb-GRD) '(SUBSET (NTH 1 onr_) (NTH 2 onr_))))
(define (onb-pow-in! m)                 ; (IN m (POWER V)) from (SUBSET m V)
  (let ((g (list 'IN m (list 'POWER onb-V))))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'subclass-of-set-is-set m onb-V)
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ m) (list 'IN 'z_ onb-V)))
            (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd m onb-V e) (dk-ass!))))
          (dk-cite! 'power-mem-intro onb-V m)))
    g))
(define (onb-grd-in! m)                 ; land (IN m GRD) from m subset V, s0 subset m, orthonormal m
  (onb-pow-in! m)
  (dk-have! (list 'IN m onb-GRD) (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! dk-ass!))))))
(define (onb-grd-out! m)                ; (IN m GRD) in context: s0 subset m, orthonormal m, m subset V
  (let ((c (list 'AND (list 'IN m (list 'POWER onb-V)) (list 'AND (list 'SUBSET 's0 m) (onb-os m)))))
    (if (not (dk-asm? (list 'SUBSET 's0 m)))
        (begin (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN m onb-GRD))) (dk-split-all!) (dk-conj-close! dk-ass!)))
               (dk-split-all! (list c))
               (onb-os-sub! m)))))
(define (onb-por-in! a b)               ; a, b in GRD, (SUBSET a b): (IN (LIST a b) POR)
  (dk-cite! 'pair-in-cartesian onb-GRD onb-GRD a b)
  (dk-have! (list 'IN (list 'LIST a b) onb-POR) (lambda () (in-sep! (lambda () (ass)) (lambda () (onb-nth-all!) (dk-ass!))))))
(define (onb-por-out! a b)              ; (IN (LIST a b) POR) in context: (SUBSET a b)
  (let ((g (list 'SUBSET a b)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST a b) onb-POR))) (dk-split-all!)
                               (onb-nth-h! (dk-pick (lambda (h) (and (dk-head-is? h 'SUBSET) (dk-contains? h 'NTH))) "the order"))
                               (dk-ass!))))
    g))
(define (onb-set-eq! a b)               ; (SUBSET a b), (SUBSET b a) in context: (= a b)
  (dk-have! (list 'FORALL 'onz_ (list 'IFF (list 'IN 'onz_ a) (list 'IN 'onz_ b)))
    (lambda () (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                 (dk-iff! (lambda (g) (equal? g (list 'IN z b)))
                   (lambda () (dk-cite! 'subset-mem-fwd a b z) (dk-ass!))
                   (lambda () (dk-cite! 'subset-mem-fwd b a z) (dk-ass!))))))
  (dk-cite! 'class-extensionality a b))

(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL s0 (IMPLIES (IS-ORTHONORMAL-SET v s0)
       (FORSOME mm (AND (SUBSET s0 mm) (AND (IS-ORTHONORMAL-SET v mm)
         (FORALL onx_ (IMPLIES (IN onx_ (VEC v))
           (IMPLIES (FORALL onu_ (IMPLIES (IN onu_ mm) (= ((IP v) onx_ onu_) 0)))
                    (= onx_ (VZERO v))))))))))))))
(dk-peel!)
(fact 'cips-vec-set 'v)
(fact 'power-set onb-V)
(onb-os-sub! 's0)
(fact 'subset-refl 's0)
(onb-grd-in! 's0)
(dk-have! (list 'IN onb-GRD 'SET) (lambda () (sep-set) (ass)))
(dk-have! (list 'IN (list 'CARTESIAN onb-GRD onb-GRD) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-have! (list 'IN onb-POR 'SET) (lambda () (sep-set) (ass)))
;; the partial order
(dk-have! (list 'IS-PARTIAL-ORDER onb-GRD onb-POR)
  (lambda ()
    (mac 'is-partial-order)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((ld (dk-peel!))
                   (vs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) onb-GRD))) ld))))
              (dk-split-all!)
              (for-each onb-grd-out! vs)
              (cond ((= (length vs) 1) (fact 'subset-refl (car vs)) (onb-por-in! (car vs) (car vs)))
                    ((= (length vs) 2)
                     (let ((a (car vs)) (b (cadr vs)))
                       (onb-por-out! a b) (onb-por-out! b a) (onb-set-eq! a b) (dk-ass!)))
                    (#t
                     (let ((a (car vs)) (b (cadr vs)) (c (caddr vs)))
                       (onb-por-out! a b) (onb-por-out! b c)
                       (dk-cite! 'subset-trans a b c)
                       (onb-por-in! a c))))))))))
;; every chain has an upper bound: the union of the chain and s0
(dk-have! (list 'FORALL 'ch_ (list 'IMPLIES (list 'IS-CHAIN onb-GRD onb-POR 'ch_) (list 'FORSOME 'u_ (list 'IS-UPPER-BOUND onb-GRD onb-POR 'ch_ 'u_))))
  (lambda ()
    (let* ((ch (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-CHAIN)) (dk-peel!))))
           (ich (list 'IS-CHAIN onb-GRD onb-POR ch))
           (csub (dk-project! (list 'SUBSET ch onb-GRD) 'is-chain ich))
           (ccmp (dk-project! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x ch) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y ch)
                                  (list 'OR (list 'IN '(LIST x y) onb-POR) (list 'IN '(LIST y x) onb-POR))))))
                              'is-chain ich))
           (pc '(PAIR s0 s0))
           (chp (list 'UNION ch pc))
           (ub (list 'BIG-UNION 'onw_ chp 'onw_)))
      (define (chp-grd! a)           ; a in CH': a in GRD
        (let ((um (dk-cite! 'union-membership ch pc a)))
          (if (not (dk-asm? (list 'IN a onb-GRD)))
              (dk-have! (list 'IN a onb-GRD)
                (lambda ()
                  (use-em (list 'IN a ch)
                    (lambda () (dk-cite! 'subset-mem-fwd ch onb-GRD a) (dk-ass!))
                    (lambda () (dk-have! (list 'IN a pc) (lambda () (if (dk-only! um (list 'IN a chp) (list 'NOT (list 'IN a ch))) (prop))))
                               (dk-cite! 'pair-self-eq 's0 a) (subst (list '= a 's0)) (dk-ass!))))))
          (onb-grd-out! a)))
      (dk-cite! 'subclass-of-set-is-set 's0 onb-V)
      (onb-and! '(IN s0 SET) '(IN s0 SET))
      (fact 'pairing 's0 's0)
      (dk-cite! 'pair-self-member 's0)
      (dk-cite! 'subclass-of-set-is-set ch onb-GRD)
      (onb-and! (list 'IN ch 'SET) (list 'IN pc 'SET))
      (fact 'union-set-closure ch pc)
      (let ((im (dk-cite! 'union-membership ch pc 's0)))
        (dk-have! (list 'IN 's0 chp) (lambda () (if (dk-only! im (list 'IN 's0 pc)) (prop)))))
      ;; the members of CH' are orthonormal and pairwise comparable
      (dk-have! (list 'FORALL 'ona_ (list 'IMPLIES (list 'IN 'ona_ chp) (onb-os 'ona_)))
        (lambda () (let ((a (dk-di-var!))) (chp-grd! a) (dk-ass!))))
      (dk-have! (list 'FORALL 'ona_ (list 'IMPLIES (list 'IN 'ona_ chp) (list 'FORALL 'onb_ (list 'IMPLIES (list 'IN 'onb_ chp)
                   '(OR (SUBSET ona_ onb_) (SUBSET onb_ ona_))))))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (ab (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) chp))) ld)))
                 (a (car ab)) (b (cadr ab)))
            (chp-grd! a) (chp-grd! b)
            (use-em (list 'IN a ch)
              (lambda ()
                (use-em (list 'IN b ch)
                  (lambda ()
                    (dk-apply! ccmp a b)
                    (use-em (list 'IN (list 'LIST a b) onb-POR)
                      (lambda () (onb-por-out! a b) (if (dk-only! (list 'SUBSET a b)) (prop)))
                      (lambda () (dk-have! (list 'IN (list 'LIST b a) onb-POR)
                                   (lambda () (dk-only! (list 'OR (list 'IN (list 'LIST a b) onb-POR) (list 'IN (list 'LIST b a) onb-POR)) (list 'NOT (list 'IN (list 'LIST a b) onb-POR))) (prop)))
                                 (onb-por-out! b a) (if (dk-only! (list 'SUBSET b a)) (prop)))))
                  (lambda ()
                    (let ((umb (dk-cite! 'union-membership ch pc b)))
                      (dk-have! (list 'IN b pc) (lambda () (if (dk-only! umb (list 'IN b chp) (list 'NOT (list 'IN b ch))) (prop))))
                      (dk-cite! 'pair-self-eq 's0 b)
                      (dk-have! (list 'SUBSET b a) (lambda () (subst (list '= b 's0)) (ass)))
                      (if (dk-only! (list 'SUBSET b a)) (prop))))))
              (lambda ()
                (let ((uma (dk-cite! 'union-membership ch pc a)))
                  (dk-have! (list 'IN a pc) (lambda () (if (dk-only! uma (list 'IN a chp) (list 'NOT (list 'IN a ch))) (prop))))
                  (dk-cite! 'pair-self-eq 's0 a)
                  (dk-have! (list 'SUBSET a b) (lambda () (subst (list '= a 's0)) (ass)))
                  (if (dk-only! (list 'SUBSET a b)) (prop))))))))
      (fact 'onb-orthonormal-chain-union 'v chp)
      (onb-os-sub! ub)
      (dk-have! (list 'SUBSET 's0 ub)
        (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi 's0)))))))
      (onb-grd-in! ub)
      (ew ub)
      (mac 'is-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((x (dk-di-var!)))
                (dk-cite! 'subset-mem-fwd ch onb-GRD x)
                (let ((im (dk-cite! 'union-membership ch pc x)))
                  (dk-have! (list 'IN x chp) (lambda () (if (dk-only! im (list 'IN x ch)) (prop)))))
                (onb-grd-out! x)
                (dk-have! (list 'SUBSET x ub)
                  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi x)))))))
                (onb-por-in! x ub))))))))
(dk-have! (list 'FORSOME 'w_ (list 'IN 'w_ onb-GRD)) (lambda () (ew 's0) (dk-ass!)))
(dk-cite! 'zorn-lemma onb-GRD onb-POR)
(let* ((mx (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'IS-MAXIMAL))) "Zorn") #t))
       (im (list 'IS-MAXIMAL onb-GRD onb-POR mx))
       (mxg (dk-project! (list 'IN mx onb-GRD) 'is-maximal im))
       (mcl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y onb-GRD) (list 'IMPLIES (list 'IN (list 'LIST mx 'y) onb-POR) (list 'IN (list 'LIST 'y mx) onb-POR))))
                         'is-maximal im)))
  (onb-grd-out! mx)
  (ew mx)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) onb-V))) ld)))
                 (perp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h mx) (dk-contains? h (onb-ip x 'onu_))))
                                "x orthogonal to mx")))
            (use-em (list '= x '(VZERO v))
              (lambda () (dk-ass!))
              (lambda ()
                (let* ((ex (dk-cite! 'onb-unit-multiple 'v x))
                       (c (dk-skolem! ex))
                       (u (list '(ACT v) c x))
                       (nn (list 'UNION mx (list 'PAIR u u))))
                  (fact 'cips-act-type 'v c x)
                  (dk-have! (list 'FORALL 'ona_ (list 'IMPLIES (list 'IN 'ona_ mx) (list '= (onb-ip u 'ona_) 0)))
                    (lambda ()
                      (let ((a (dk-di-var!)))
                        (dk-apply! perp a)
                        (fact 'subset-mem-fwd mx onb-V a)
                        (fact 'cips-ip-homog-left 'v c x a)
                        (subst (list '= (onb-ip u a) (list '* c (onb-ip x a))))
                        (subst (list '= (onb-ip x a) 0))
                        (crs))))
                  (fact 'onb-orthonormal-insert 'v mx u)
                  (onb-os-sub! nn)
                  ;; s0 <= mx <= N
                  (fact 'union-right-subset (list 'PAIR u u) mx)
                  (fact 'union-comm (list 'PAIR u u) mx)
                  (dk-have! (list 'SUBSET mx nn)
                    (lambda () (subst (list '= nn (list 'UNION (list 'PAIR u u) mx))) (dk-ass!)))
                  (dk-cite! 'subset-trans 's0 mx nn)
                  (onb-grd-in! nn)
                  (onb-por-in! mx nn)
                  (dk-apply! mcl nn)
                  (onb-por-out! nn mx)
                  ;; u in N, hence u in mx, hence <x,u> = 0, hence <u,u> = 0
                  (fact 'membership-implies-sethood u onb-V)
                  (fact 'union-singleton-mem u mx)
                  (dk-have! (list 'IN u nn)
                    (lambda () (subst (list '= nn (list 'UNION (list 'PAIR u u) mx))) (dk-ass!)))
                  (fact 'subset-mem-fwd nn mx u)
                  (dk-apply! perp u)
                  (fact 'cips-ip-homog-left 'v c x u)
                  (fact 'cips-ip-self-real 'v u)
                  (let ((uu (onb-ip u u)))
                    (dk-have! (list '= uu 0)
                      (lambda ()
                        (subst (list '= uu (list '* c (onb-ip x u))))
                        (subst (list '= (onb-ip x u) 0))
                        (crs)))
                    (dk-absurd! (list '= uu 0) (list '= uu 1) (list 'IN uu 'RR)))))))))))
(onb-done! 'onb-complete-orthonormal-set-exists)


;;; ======================================================================
;;; from slice onb-c.scm
;;; onb-c.scm -- slice C (development): bases from complete orthonormal sets; existence; extension.

(define (onb-of-proj! what) ; projections of IS-ORTHONORMAL-FAMILY(v, ix, e) -- named by the caller's args
  what)
(define (onb-onf v ix e) (list 'IS-ORTHONORMAL-FAMILY v ix e))
(define (onb-onf-typ! ix e)
  (dk-project! (list 'IN e (list 'FUN ix onb-V)) 'is-orthonormal-family (onb-onf 'v ix e)))
(define (onb-onf-unit! ix e)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ ix) (list '= (onb-ip (list e 'oni_) (list e 'oni_)) 1)))
               'is-orthonormal-family (onb-onf 'v ix e)))
(define (onb-onf-orth! ix e)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ ix)
                 (list 'FORALL 'onj_ (list 'IMPLIES (list 'IN 'onj_ ix)
                   (list 'IMPLIES (list 'NOT (list '= 'oni_ 'onj_)) (list '= (onb-ip (list e 'oni_) (list e 'onj_)) 0))))))
               'is-orthonormal-family (onb-onf 'v ix e)))

;;; ---------------------------------------------------------------------------
;;; the image of an orthonormal family is an orthonormal set
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL ix (FORALL e (IMPLIES (IS-ORTHONORMAL-FAMILY v ix e)
       (IS-ORTHONORMAL-SET v (IMAGE e ix)))))))))
(dk-peel!)
(let* ((im '(IMAGE e ix))
       (typ (onb-onf-typ! 'ix 'e))
       (unit (onb-onf-unit! 'ix 'e))
       (orth (onb-onf-orth! 'ix 'e))
       ;; z in IMAGE: land (IN i ix), (= (e i) z), (IN (e i) VEC); return i
       (open! (lambda (z)
                (let* ((r (dk-landed-1 (lambda () (mac-h 'image-membership-iff (list 'IN z im)))))
                       (i (dk-skolem! r)))
                  (fact 'fun-apply-type-c 'e 'ix onb-V i)
                  i))))
  (mac 'is-orthonormal-set)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def)
           (let* ((z (dk-di-var!)) (i (open! z)))
             (subst (list '= z (list 'e i)))
             (dk-ass!)))
          (#t
           (let* ((ld (dk-peel!))
                  (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) im))) ld))))
             (if (= (length zs) 1)
                 (let* ((z (car zs)) (i (open! z)))
                   (subst (list '= z (list 'e i)))
                   (dk-apply! unit i)
                   (dk-ass!))
                 (let* ((z (car zs)) (w (cadr zs)) (i (open! z)) (j (open! w)))
                   (dk-have! (list 'NOT (list '= i j))
                     (lambda ()
                       (di)
                       (dk-have! (list '= z w)
                         (lambda ()
                           (subst (list '= z (list 'e i)))
                           (subst (list '= w (list 'e j)))
                           (subst (list '= i j))
                           (rfl)))
                       (ai (list 'NOT (list '= z w)))))
                   (subst (list '= z (list 'e i)))
                   (subst (list '= w (list 'e j)))
                   (dk-apply! orth i j)
                   (dk-ass!))))))))))
(onb-done! 'onb-image-orthonormal)

;;; ---------------------------------------------------------------------------
;;; a complete orthonormal set, indexed by itself, is an orthonormal basis
(define onb-L '(VNB-LAMBDA onk_ mm onk_))
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'mm (list 'IMPLIES '(IS-ORTHONORMAL-SET v mm)
      (list 'IMPLIES '(FORALL onx_ (IMPLIES (IN onx_ (VEC v))
                         (IMPLIES (FORALL onu_ (IMPLIES (IN onu_ mm) (= ((IP v) onx_ onu_) 0)))
                                  (= onx_ (VZERO v)))))
        (list 'IS-ORTHONORMAL-BASIS 'v 'mm onb-L))))))))
(dk-peel!)
(fact 'cips-vec-set 'v)
(onb-os-sub! 'mm)
(dk-cite! 'subclass-of-set-is-set 'mm onb-V)
(let* ((cpl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'VZERO))) "completeness of mm"))
       (beta! (lambda (k)       ; land (= (L k) k), k in mm in context
                (let ((eq (list '= (list onb-L k) k)))
                  (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                  eq))))
  (mac 'is-orthonormal-basis)
  (mac 'is-orthonormal-family)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-head-is? g 'IN)
           (dk-lam-type!
             (lambda ()
               (let* ((ld (dk-peel!))
                      (k (cadr (car ld))))
                 (fact 'subset-mem-fwd 'mm onb-V k)
                 (dk-ass!)))))
          ((dk-contains? g 'VZERO)
           (let* ((ld (dk-peel!))
                  (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) onb-V))) ld)))
                  (hh (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h onb-L) (dk-contains? h x)))
                               "x orthogonal to the family")))
             (dk-have! (list 'FORALL 'onu_ (list 'IMPLIES '(IN onu_ mm) (list '= (onb-ip x 'onu_) 0)))
               (lambda ()
                 (let ((u (dk-di-var!)))
                   (dk-apply! hh u)
                   (beta! u)
                   (subst (list '= u (list onb-L u)))
                   (dk-ass!))))
             (dk-apply! cpl x)
             (dk-ass!)))
          (#t
           (let* ((ld (dk-peel!))
                  (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'mm))) ld))))
             (for-each (lambda (k) (fact 'subset-mem-fwd 'mm onb-V k)) ks)
             (dk-lam-b!)
             (if (= (length ks) 1)
                 (begin (onb-unit-at! 'mm (car ks)) (dk-ass!))
                 (begin (onb-orth-at! 'mm (car ks) (cadr ks)) (dk-ass!))))))))))
(onb-done! 'onb-of-complete-orthonormal-set)

;;; ---------------------------------------------------------------------------
;;; EXISTENCE: every complex inner product space has an orthonormal basis
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORSOME ix (FORSOME e (IS-ORTHONORMAL-BASIS v ix e)))))))
(dk-peel!)
(dk-have! '(IS-ORTHONORMAL-SET v EMPTY-SET)
  (lambda ()
    (mac 'is-orthonormal-set)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (begin (fact 'empty-subset-any onb-V) (dk-ass!))
            (let* ((ld (dk-peel!))
                   (z (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'EMPTY-SET))) ld)))
                   (ne (dk-cite! 'empty-set-has-no-members z)))
              (if (dk-only! (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET))) (prop))))))))
(let* ((ex (dk-cite! 'onb-complete-orthonormal-set-exists 'v 'EMPTY-SET))
       (mm (dk-skolem! ex))
       (cpl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'VZERO) (dk-contains? h mm))) "completeness")))
  (fact 'onb-of-complete-orthonormal-set 'v mm)
  (ew mm)
  (ew (list 'VNB-LAMBDA 'onk_ mm 'onk_))
  (dk-ass!))
(onb-done! 'onb-exists)

;;; ---------------------------------------------------------------------------
;;; EXTENSION: every orthonormal family extends to an orthonormal basis
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL ix (FORALL e (IMPLIES (IS-ORTHONORMAL-FAMILY v ix e)
       (FORSOME jx (FORSOME f (AND (IS-ORTHONORMAL-BASIS v jx f)
         (FORALL oni_ (IMPLIES (IN oni_ ix)
           (FORSOME onj_ (AND (IN onj_ jx) (= (f onj_) (e oni_))))))))))))))))
(dk-peel!)
(fact 'onb-image-orthonormal 'v 'ix 'e)
(let* ((im '(IMAGE e ix))
       (typ (onb-onf-typ! 'ix 'e))
       (ex (dk-cite! 'onb-complete-orthonormal-set-exists 'v im))
       (mm (dk-skolem! ex))
       (L (list 'VNB-LAMBDA 'onk_ mm 'onk_)))
  (fact 'onb-of-complete-orthonormal-set 'v mm)
  (ew mm)
  (ew L)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (i (cadr (car ld)))
                 (ei (list 'e i)))
            (fact 'fun-apply-type-c 'e 'ix onb-V i)
            (fact 'membership-implies-sethood ei onb-V)
            (dk-have! (list 'IN ei im)
              (lambda ()
                (mac 'image-membership-iff)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin (ew i) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
            (fact 'subset-mem-fwd im mm ei)
            (ew ei)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (if (not (dk-lam-b!)) (rfl))))))))))
(onb-done! 'onb-extension)

;;; ======================================================================
;;; from slice onb-d.scm
