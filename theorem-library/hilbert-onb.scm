(define (onb-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; onb: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (proof-leaves))
        (error "onb: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))

(define (onb-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))

;;; a real-number identity: a*a = t and a*b = 1 give b*(b*t) = 1
(sp (make-wff
  '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL b_ (IMPLIES (IN b_ RR) (FORALL t_ (IMPLIES (IN t_ RR)
     (IMPLIES (= (* a_ a_) t_) (IMPLIES (= (* a_ b_) 1) (= (* b_ (* b_ t_)) 1)))))))))))
(dk-peel!)
(subst '(= t_ (* a_ a_)))
(dk-have! '(= (* b_ (* b_ (* a_ a_))) (* (* a_ b_) (* a_ b_))) (lambda () (crs)))
(subst '(= (* b_ (* b_ (* a_ a_))) (* (* a_ b_) (* a_ b_))))
(subst '(= (* a_ b_) 1))
(crs)
(onb-done! 'onb-unit-scale-identity)

;;; the unit multiple of a nonzero vector
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL x (IMPLIES (IN x (VEC v)) (IMPLIES (NOT (= x (VZERO v)))
       (FORSOME c (AND (IN c CC) (= ((IP v) ((ACT v) c x) ((ACT v) c x)) 1))))))))))
(dk-peel!)
(let* ((x 'x)
       (t (list (list 'IP 'v) x x))
       (s (list 'SQRT t))
       (c (list 'recip s))
       (cx (list (list 'ACT 'v) c x)))
  (fact 'cips-ip-self-real 'v x)
  (fact 'cips-ip-self-nonneg 'v x)
  (dk-have! (list 'NOT (list '= t 0))
    (lambda ()
      (di)
      (fact 'cips-ip-zero-vector 'v x)
      (ai (list 'NOT (list '= x '(VZERO v))))))
  (onb-and! (list 'IN t 'RR) (list '<= 0 t))
  (fact 'sqrt-prop t)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN s 'RR)
                                          (list 'AND (list '<= 0 s) (list '= (list '* s s) t))))))
  (dk-have! (list 'NOT (list '= s 0))
    (lambda ()
      (di)
      (dk-have! (list '= t 0)
        (lambda ()
          (subst (list '= t (list '* s s)))
          (subst (list '= s 0))
          (crs)))
      (ai (list 'NOT (list '= t 0)))))
  (onb-and! (list 'IN s 'RR) (list 'NOT (list '= s 0)))
  (fact 'rr-recip-closed s)
  (fact 'rr-recip-inverse s)
  (fact 'rr-subset-cc c)
  (fact 'cips-act-type 'v c x)
  (fact 'cips-ip-homog-left 'v c x cx)
  (fact 'cips-ip-conj-homog-right 'v c x x)
  (fact 'cc-conjugate-fixes-rr c)
  (fact 'onb-unit-scale-identity s c t)
  (ew c)
  (dk-conj-close!
    (lambda ()
      (if (dk-ass!) #t
          (begin
            (subst (list '= (list (list 'IP 'v) cx cx) (list '* c (list (list 'IP 'v) x cx))))
            (subst (list '= (list (list 'IP 'v) x cx) (list '* (list 'conjugate c) t)))
            (subst (list '= (list 'conjugate c) c))
            (ass))))))
(onb-done! 'onb-unit-multiple)


