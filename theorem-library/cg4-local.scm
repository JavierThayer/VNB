;;; cg4-local.scm -- local homomorphisms (compact-groups notes, Definition 5.37, Proposition 5.38):
;;; the composite of local homomorphisms f : G -> H (on V) and h : H -> K (on V_H) is a local
;;; homomorphism on V' = { x in V : f(x) in V_H }, with W' = { x in W : f(x) in W_H }.
;;; Agent ISOM, 2026-10-27.  Helper prefix: lc4-.  Library: analysis.

(define (lc4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (lc4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (lc4-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (lc4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (lc4-op gg x y) (list (list 'OPR gg) x y))
(define (lc4-inv gg x) (list (list 'INV gg) x))
(define (lc4-e gg) (list 'IDEN gg))
(define lc4-Vc '(SEP lcx_ V (IN (f lcx_) VH)))
(define lc4-Wc '(SEP lcw_ lhw1 (IN (f lcw_) lhw2)))
(define lc4-k (list 'VNB-LAMBDA 'lck_ lc4-Vc '(h (f lck_))))

(define lc4-stmt '(FORALL s1 (FORALL g1 (FORALL s2 (FORALL g2 (FORALL s3 (FORALL g3
   (IMPLIES (IS-GROUP-TOPOLOGY s1 g1) (IMPLIES (IS-GROUP-TOPOLOGY s2 g2) (IMPLIES (IS-GROUP-TOPOLOGY s3 g3)
   (FORALL V (FORALL f (FORALL VH (FORALL h (IMPLIES (IS-LOCAL-HOM s1 g1 s2 g2 V f) (IMPLIES (IS-LOCAL-HOM s2 g2 s3 g3 VH h)
     (FORSOME Vc (FORSOME k (AND (IS-LOCAL-HOM s1 g1 s3 g3 Vc k)
       (FORALL x (IMPLIES (IN x Vc) (= (k x) (h (f x))))))))))))))))))))))))
(sp (make-wff lc4-stmt))
(dk-peel!)
(for-each (lambda (sg) (dk-split-all! (list (dk-cite! 'top-group-parts-gt (car sg) (cadr sg))))
                       (fact 'group-identity-in (cadr sg)))
          '((s1 g1) (s2 g2) (s3 g3)))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-top-space 's1))))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-local-hom 's1 'g1 's2 'g2 'V 'f))))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-local-hom 's2 'g2 's3 'g3 'VH 'h))))
(define (lc4-open-w! F)                  ; skolemise the W of the local hom with function F; returns W
  (let ((w (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'lhw_) (dk-contains? h F))) "the W"))))
    (lc4-split-if! (lambda (h) (dk-contains? h w)))
    (lc4-split-if! (lambda (h) (dk-contains? h w)))
    (lc4-split-if! (lambda (h) (dk-contains? h w)))
    w))
(define lc4-W1 (lc4-open-w! 'f))
(define lc4-W2 (lc4-open-w! 'h))
(set! lc4-Wc (list 'SEP 'lcw_ lc4-W1 (list 'IN '(f lcw_) lc4-W2)))
(define (lc4-pick-clause F W kind)       ; kind: 'cont 'sym 'mult
  (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q F)
                            (case kind
                              ((cont) (dk-contains? q 'lho_))
                              ((sym) #f)
                              ((mult) (dk-contains? q W))
                              (else #f))))
           "a clause of the local hom"))
(define lc4-CONT1 (lc4-pick-clause 'f lc4-W1 'cont))
(define lc4-CONT2 (lc4-pick-clause 'h lc4-W2 'cont))
(define lc4-MULT1 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q lc4-W1) (dk-contains? q 'f))) "f's multiplicativity"))
(define lc4-MULT2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q lc4-W2) (dk-contains? q 'h))) "h's multiplicativity"))
(define lc4-SYM1 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q lc4-W1) (dk-contains? q '(INV g1)) (not (dk-contains? q 'f)))) "W1 symmetric"))
(define lc4-SYM2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q lc4-W2) (dk-contains? q '(INV g2)) (not (dk-contains? q 'h)))) "W2 symmetric"))
;; a point of an open set of s_i is a point of g_i
(define (lc4-carr! x O si gi)
  (dk-cite! 'top-open-subset si O)
  (dk-cite! 'subset-mem-fwd O (list 'PTS si) x)
  (if (not (dk-asm? (list 'IN x (list 'CARR gi))))
      (dk-rewrite-h! (list 'IN x (list 'PTS si)) (list 'PTS si) (list 'CARR gi))))
;; W inside V: x in W gives x in V (x = x e, x e in V)
(define (lc4-w-in-v! x W VV MULT gi si)
  (if (not (dk-asm? (list 'IN x VV)))
      (begin
        (lc4-carr! x W si gi)
        (dk-split-all! (list (dk-apply! (dk-ctx-form MULT) x (lc4-e gi))))
        (dk-split-all! (list (dk-cite! 'group-right-inv-id gi x)))
        (dk-rewrite-h! (list 'IN (lc4-op gi x (lc4-e gi)) VV) (lc4-op gi x (lc4-e gi)) x))))
(define (lc4-f! x) (dk-cite! 'fun-apply-type-c 'f 'V '(CARR g2) x))
(define (lc4-h! z) (dk-cite! 'fun-apply-type-c 'h 'VH '(CARR g3) z))
;; f(e1) = e2
(lc4-w-in-v! (lc4-e 'g1) lc4-W1 'V lc4-MULT1 'g1 's1)
(lc4-f! (lc4-e 'g1))
(dk-split-all! (list (dk-apply! (dk-ctx-form lc4-MULT1) (lc4-e 'g1) (lc4-e 'g1))))
(dk-cite! 'group-left-id 'g1 (lc4-e 'g1))
(dk-rewrite-h! (list '= (list 'f (lc4-op 'g1 (lc4-e 'g1) (lc4-e 'g1))) (lc4-op 'g2 '(f (IDEN g1)) '(f (IDEN g1))))
               (lc4-op 'g1 (lc4-e 'g1) (lc4-e 'g1)) (lc4-e 'g1))
(dk-have! (list '= (lc4-op 'g2 '(f (IDEN g1)) '(f (IDEN g1))) '(f (IDEN g1)))
  (lambda () (subst (list '= (lc4-op 'g2 '(f (IDEN g1)) '(f (IDEN g1))) '(f (IDEN g1)))) (lc4-ass-rfl!)))
(dk-cite! 'group-idempotent-iden 'g2 '(f (IDEN g1)))
;; W2 inside VH, W1 inside V, as universals
(lc4-w-in-v! (lc4-e 'g2) lc4-W2 'VH lc4-MULT2 'g2 's2)
(dk-have! (list 'FORALL 'wv_ (list 'IMPLIES (list 'IN 'wv_ lc4-W1) '(IN wv_ V)))
  (lambda () (let ((x (lc4-peel-var!))) (lc4-w-in-v! x lc4-W1 'V lc4-MULT1 'g1 's1) (lc4-ass!))))
(dk-have! (list 'FORALL 'wv_ (list 'IMPLIES (list 'IN 'wv_ lc4-W2) '(IN wv_ VH)))
  (lambda () (let ((x (lc4-peel-var!))) (lc4-w-in-v! x lc4-W2 'VH lc4-MULT2 'g2 's2) (lc4-ass!))))
(define (lc4-in-v! x) (dk-apply! (dk-ctx-form (list 'FORALL 'wv_ (list 'IMPLIES (list 'IN 'wv_ lc4-W1) '(IN wv_ V)))) x))
(define (lc4-in-vh! z) (dk-apply! (dk-ctx-form (list 'FORALL 'wv_ (list 'IMPLIES (list 'IN 'wv_ lc4-W2) '(IN wv_ VH)))) z))
;; the parts of x in Vc / Wc, landed on lanes so the membership survives
(define (lc4-vc-parts! x)
  (dk-have! (list 'IN x 'V) (lambda () (dk-landed (lambda () (sep-me (list 'IN x lc4-Vc)))) (lc4-ass!)))
  (dk-have! (list 'IN (list 'f x) 'VH) (lambda () (dk-landed (lambda () (sep-me (list 'IN x lc4-Vc)))) (lc4-ass!)))
  (lc4-f! x) (lc4-h! (list 'f x)))
(define (lc4-wc-parts! x)
  (dk-have! (list 'IN x lc4-W1) (lambda () (dk-landed (lambda () (sep-me (list 'IN x lc4-Wc)))) (lc4-ass!)))
  (dk-have! (list 'IN (list 'f x) lc4-W2) (lambda () (dk-landed (lambda () (sep-me (list 'IN x lc4-Wc)))) (lc4-ass!)))
  (lc4-in-v! x) (lc4-f! x) (lc4-in-vh! (list 'f x)) (lc4-h! (list 'f x))
  (lc4-carr! x lc4-W1 's1 'g1))
(define (lc4-in-vc! x)                   ; x in V, f x in VH in context: land x in Vc
  (dk-have! (list 'IN x lc4-Vc) (lambda () (in-sep! (lambda () (lc4-ass!)) (lambda () (lc4-ass!))))))
;; the values of k
(define lc4-kval (list 'FORALL 'kv_ (list 'IMPLIES (list 'IN 'kv_ lc4-Vc) (list '= (list lc4-k 'kv_) '(h (f kv_))))))
(dk-have! lc4-kval
  (lambda () (let ((x (lc4-peel-var!)))
               (lc4-vc-parts! x)
               (if (not (dk-lam-b!)) (lc4-ass-rfl!)))))
(define (lc4-k! x) (dk-apply! (dk-ctx-form lc4-kval) x))
;; e1 in Vc and in Wc
(dk-rewrite-h! (list 'IN (lc4-e 'g2) 'VH) (lc4-e 'g2) '(f (IDEN g1)))
(lc4-in-vc! (lc4-e 'g1))
(dk-rewrite-h! (list 'IN (lc4-e 'g2) lc4-W2) (lc4-e 'g2) '(f (IDEN g1)))
(dk-have! (list 'IN (lc4-e 'g1) lc4-Wc) (lambda () (in-sep! (lambda () (lc4-ass!)) (lambda () (lc4-ass!)))))
;; the opens: V and W1 sets, Vc and Wc open
(define (lc4-open-sep! S dom O)          ; S = SEP over DOM of f-values in O: S in OPENS s1
  (dk-have! (list 'SUBSET S '(PTS s1))
    (lambda () (mac 'subset-def)
               (let ((x (lc4-peel-var!)))
                 (dk-landed (lambda () (sep-me (list 'IN x S))))
                 (lc4-carr! x dom 's1 'g1)
                 (dk-rewrite-h! (list 'IN x '(CARR g1)) '(CARR g1) '(PTS s1))
                 (lc4-ass!))))
  (dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a S) (list 'FORSOME 'W (list 'AND '(IN W (OPENS s1)) (list 'AND '(IN a W) (list 'SUBSET 'W S))))))
    (lambda ()
      (let ((x (lc4-peel-var!)))
        (dk-have! (list 'IN x dom) (lambda () (dk-landed (lambda () (sep-me (list 'IN x S)))) (lc4-ass!)))
        (dk-have! (list 'IN (list 'f x) O) (lambda () (dk-landed (lambda () (sep-me (list 'IN x S)))) (lc4-ass!)))
        (if (not (eq? dom 'V)) (lc4-in-v! x))
        (let* ((u (dk-skolem! (dk-apply! lc4-CONT1 x O))))
          (lc4-split-if! (lambda (h) (dk-contains? h u)))
          (lc4-split-if! (lambda (h) (dk-contains? h u)))
          (let ((nb (list 'INTERSECTION u dom)))
            (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h '(OPENS s1)))) "the intersection law") u dom)
            (ew nb)
            (dk-conj-close!
             (lambda ()
               (cond
                ((dk-head-is? (dk-goal) 'SUBSET)
                 (mac 'subset-def)
                 (let ((y (lc4-peel-var!)))
                   (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'intersection-membership u dom y))))
                   (if (not (eq? dom 'V)) (lc4-in-v! y))
                   (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (eq? (cadr h) 'lhy_))) "the neighbourhood clause") y)
                   (in-sep! (lambda () (lc4-ass!)) (lambda () (lc4-ass!)))))
                ((and (dk-head-is? (dk-goal) 'IN) (dk-head-is? (caddr (dk-goal)) 'INTERSECTION))
                 (let ((iff (dk-cite! 'intersection-membership u dom x)))
                   (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (lc4-ass!)))))
                   (dk-meta-iff-l! iff)
                   (lc4-ass!)))
                (#t (lc4-ass!))))))))))
  (dk-cite! 'top-open-of-local 's1 S)
  (lc4-ass!))
(lc4-open-sep! lc4-Vc 'V 'VH)
(lc4-open-sep! lc4-Wc lc4-W1 lc4-W2)
;; k is a function on Vc
(dk-cite! 'membership-implies-sethood 'V '(OPENS s1))
(dk-have! (list 'IN lc4-Vc 'SET) (lambda () (dk-close-all! (lambda () (sep-set)))))
(dk-have! (list 'IN lc4-k (list 'FUN lc4-Vc '(CARR g3)))
  (lambda () (dk-lam-type! (lambda () (let ((x (lc4-peel-var!))) (lc4-vc-parts! x) (lc4-ass!)))
                           (lambda () (lc4-ass!)))))
;; the local hom on Vc
(define (lc4-lh-goal!)
  (let ((iff (dk-cite! 'is-local-hom 's1 'g1 's3 'g3 lc4-Vc lc4-k)))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
         (lambda ()
           (cond
            ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'FORSOME)    ; W' = Wc
             (ew lc4-Wc)
             (dk-conj-close!
              (lambda ()
                (cond
                 ((dk-asm? (dk-goal)) (ass))
                 ((and (dk-head-is? (dk-goal) 'FORALL) (not (dk-contains? (dk-goal) 'lhy_)))   ; symmetry
                  (let* ((x (lc4-peel-var!)) (ix (lc4-inv 'g1 x)))
                    (lc4-wc-parts! x)
                    (dk-apply! (dk-ctx-form lc4-SYM1) x)
                    (lc4-in-v! ix) (lc4-f! ix)
                    (dk-cite! 'group-inv-in 'g1 x)
                    (dk-split-all! (list (dk-apply! (dk-ctx-form lc4-MULT1) ix x)))
                    (dk-cite! 'group-left-inv 'g1 x)
                    (let ((p (lc4-op 'g1 ix x)) (fp (lc4-op 'g2 (list 'f ix) (list 'f x))))
                      (dk-rewrite-h! (list '= (list 'f p) fp) p (lc4-e 'g1))
                      (dk-cite! 'group-carrier-closed-opr 'g2 (list 'f ix) (list 'f x))
                      (dk-have! (list '= fp (lc4-e 'g2))
                        (lambda () (subst (list '= fp (list 'f (lc4-e 'g1)))) (subst (list '= (list 'f (lc4-e 'g1)) (lc4-e 'g2))) (lc4-ass-rfl!)))
                      (dk-cite! 'group-right-inverse-unique 'g2 (list 'f ix) (list 'f x))
                      (dk-apply! (dk-ctx-form lc4-SYM2) (list 'f x))
                      (dk-rewrite-h! (list 'IN (lc4-inv 'g2 (list 'f x)) lc4-W2) (lc4-inv 'g2 (list 'f x)) (list 'f ix))
                      (in-sep! (lambda () (lc4-ass!)) (lambda () (lc4-ass!))))))
                 ((dk-head-is? (dk-goal) 'FORALL)                                             ; products
                  (let* ((pl (dk-peel!))
                         (ins (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) lc4-Wc))) pl))
                         (x (cadr (car ins))) (y (cadr (cadr ins)))
                         (xy (lc4-op 'g1 x y)) (fxy (lc4-op 'g2 (list 'f x) (list 'f y))))
                    (lc4-wc-parts! x) (lc4-wc-parts! y)
                    (dk-split-all! (list (dk-apply! (dk-ctx-form lc4-MULT1) x y)))
                    (dk-split-all! (list (dk-apply! (dk-ctx-form lc4-MULT2) (list 'f x) (list 'f y))))
                    (dk-have! (list 'IN (list 'f xy) 'VH) (lambda () (subst (list '= (list 'f xy) fxy)) (lc4-ass!)))
                    (lc4-in-vc! xy) (lc4-in-vc! x) (lc4-in-vc! y)
                    (lc4-k! xy) (lc4-k! x) (lc4-k! y)
                    (lc4-f! xy) (lc4-h! (list 'f xy))
                    (dk-cite! 'group-carrier-closed-opr 'g3 (list 'h (list 'f x)) (list 'h (list 'f y)))
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (begin
                             (subst (list '= (list lc4-k xy) (list 'h (list 'f xy))))
                             (subst (list '= (list lc4-k x) (list 'h (list 'f x))))
                             (subst (list '= (list lc4-k y) (list 'h (list 'f y))))
                             (subst (list '= (list 'f xy) fxy))
                             (subst (list '= (list 'h fxy) (lc4-op 'g3 (list 'h (list 'f x)) (list 'h (list 'f y)))))
                             (lc4-ass-rfl!)))))))
                 (#t (lc4-ass!))))))
            ((dk-head-is? (dk-goal) 'FORALL)                                                   ; continuity of k
             (let* ((pl (dk-peel!))
                    (x (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) lc4-Vc))) pl))))
                    (O (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(OPENS s3)))) pl)))))
               (lc4-vc-parts! x)
               (lc4-k! x)
               (dk-rewrite-h! (list 'IN (list lc4-k x) O) (list lc4-k x) (list 'h (list 'f x)))
               (let* ((u2 (dk-skolem! (dk-apply! lc4-CONT2 (list 'f x) O))))
                 (lc4-split-if! (lambda (h) (dk-contains? h u2)))
                 (lc4-split-if! (lambda (h) (dk-contains? h u2)))
                 (let* ((u1 (dk-skolem! (dk-apply! lc4-CONT1 x u2))))
                   (lc4-split-if! (lambda (h) (dk-contains? h u1)))
                   (lc4-split-if! (lambda (h) (dk-contains? h u1)))
                   (ew u1)
                   (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'FORALL)
                          (let* ((pl2 (dk-peel!))
                                 (y (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) u1))) pl2)))))
                            (lc4-vc-parts! y)
                            (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u1) (eq? (cadr h) 'lhy_))) "the f-clause") y)
                            (dk-apply! (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q u2) (eq? (cadr q) 'lhy_) (dk-contains? q 'h) (not (dk-contains? q u1)))) "the h-clause") (list 'f y))
                            (lc4-k! y)
                            (subst (list '= (list lc4-k y) (list 'h (list 'f y))))
                            (lc4-ass!))
                          (lc4-ass!))))))))
            (#t (lc4-ass!)))))))
    (dk-meta-iff-l! iff)))
(ew lc4-Vc)
(ew lc4-k)
(dk-conj-close!
 (lambda ()
   (cond ((dk-head-is? (dk-goal) 'IS-LOCAL-HOM) (lc4-lh-goal!) (lc4-ass!))
         ((dk-head-is? (dk-goal) 'FORALL)
          (let ((x (lc4-peel-var!))) (lc4-k! x) (lc4-ass!)))
         (#t (lc4-ass!)))))
(qed 'local-homomorphism-composite-gt)
(topic! 'local-homomorphism-composite-gt 'analysis)

;;; ---- the same for three TOP-GROUPs ----
(define (lc4-subst e)
  (cond ((memq e '(s1 s2 s3)) (list 'TOP-GROUP-SPACE (cdr (assq e '((s1 . G1) (s2 . G2) (s3 . G3))))))
        ((memq e '(g1 g2 g3)) (list 'TOP-GROUP-GROUP (cdr (assq e '((g1 . G1) (g2 . G2) (g3 . G3))))))
        ((pair? e) (map lc4-subst e)) (#t e)))
(define lc4-body (caddr (caddr (caddr (caddr (caddr (caddr (caddr (caddr (caddr lc4-stmt))))))))))
(sp (make-wff (list 'FORALL 'G1 (list 'FORALL 'G2 (list 'FORALL 'G3
   (list 'IMPLIES '(IS-TOP-GROUP G1) (list 'IMPLIES '(IS-TOP-GROUP G2) (list 'IMPLIES '(IS-TOP-GROUP G3) (lc4-subst lc4-body)))))))))
(di) (di) (di) (di)
(for-each (lambda (G) (dk-cite! 'top-group-space-is-top-space G) (dk-cite! 'top-group-group-is-group G) (dk-cite! 'top-group-group-topology G))
          '(G1 G2 G3))
(dk-cite! 'local-homomorphism-composite-gt '(TOP-GROUP-SPACE G1) '(TOP-GROUP-GROUP G1) '(TOP-GROUP-SPACE G2) '(TOP-GROUP-GROUP G2)
          '(TOP-GROUP-SPACE G3) '(TOP-GROUP-GROUP G3))
(lc4-ass!)
(qed 'local-homomorphism-composite)
(topic! 'local-homomorphism-composite 'analysis)
