;;; ---- completeness: a Cauchy sequence in kk converges in b, and its limit is in kk (kk is norm-closed) ----
(define gnc-L8 (gnc-tuple 8))
(define gnc-MS (list 'NAG-METRIC-SPACE (list 'CNA-AS-NORMED-AG gnc-L8)))
(define gnc-B '(UIBA-AS-UBA b))
(define gnc-Mb (list 'BA-METRIC-SPACE gnc-B))
(define (gnc-rhs! iff) (dk-iff-fwd! iff) (caddr iff))
(define (gnc-ro8! acc) (dk-cite! (gnc-ro-name 8 acc) 'b 'kk))
(define (gnc-bwd! iff prover)          ; prove the goal (cadr iff) from its right side, proved by PROVER
  (dk-have! (caddr iff) prover)
  (if (dk-only! iff (caddr iff)) (prop)))
(define (gnc-in-pts! u)                ; u in kk: land u in VEC(L8) and in PTS(MS)
  (if (not (dk-asm? (list 'IN u (list 'VEC gnc-L8))))
      (dk-have! (list 'IN u (list 'VEC gnc-L8)) (lambda () (subst (gnc-ro8! 'VEC)) (gnc-ass!)))))
(define (gnc-distL! u v)               ; u, v in kk: land dist_MS(u, v) = ||u - v||_b
  (gnc-in-pts! u) (gnc-in-pts! v)
  (let ((e (list '= (list (list 'DIST gnc-MS) u v) (list gnc-N (list '(VADD b) u (list '(VNEG b) v))))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (subst (dk-cite! 'nag-metric-distance-cna-as-normed-ag gnc-L8 u v))
            (for-each (lambda (acc) (if (dk-contains? (dk-goal) (list acc gnc-L8)) (subst (gnc-ro8! acc)))) '(VNRM VADD VNEG))
            (gnc-rw!)
            (if (gnc-open?) (begin (gnc-vb! (list '(VADD b) u (list '(VNEG b) v))) (gnc-nty! (list '(VADD b) u (list '(VNEG b) v))) (rfl))))))
    e))
(define (gnc-in-B! u)
  (gnc-vb! u)
  (if (not (dk-asm? (list 'IN u (list 'VEC gnc-B))))
      (dk-have! (list 'IN u (list 'VEC gnc-B)) (lambda () (subst '(== (VEC (UIBA-AS-UBA b)) (VEC b))) (gnc-ass!)))))
(define (gnc-distb! u v)               ; u, v in VEC b: land dist_Mb(u, v) = ||u - v||_b
  (gnc-in-B! u) (gnc-in-B! v)
  (let ((e (list '= (list (list 'DIST gnc-Mb) u v) (list gnc-N (list '(VADD b) u (list '(VNEG b) v))))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (subst (dk-cite! 'ban-dist gnc-B u v))
            (for-each (lambda (acc) (if (dk-contains? (dk-goal) (list acc gnc-B)) (subst (list '== (list acc gnc-B) (list acc 'b)))))
                      '(VNRM VADD VNEG))
            (if (gnc-open?) (begin (gnc-vb! (list '(VADD b) u (list '(VNEG b) v))) (gnc-nty! (list '(VADD b) u (list '(VNEG b) v))) (rfl))))))
    e))
(define (gnc-fk! f k) (if (not (dk-asm? (list 'IN (list f k) 'kk))) (dk-cite! 'fun-apply-type-c f 'NN 'kk k)))

(sp (make-wff (gnc-stmt-bk (list 'IS-COMPLETE gnc-MS))))
(dk-peel!)
(gnc-base!)
(dk-cite! 'sub-ucsa-tuple-cna 'b 'kk)
(dk-cite! 'bcs-uiba-is-uba 'b)
(for-each (lambda (n) (dk-cite! n 'b)) '(bcp-ro-vec bcp-ro-vnrm bcp-ro-vadd bcp-ro-vneg))
(dk-cite! 'nag-metric-space-is-metric-space-cna-as-normed-ag gnc-L8)
(dk-cite! 'nag-metric-carrier-cna-as-normed-ag gnc-L8)
(dk-cite! 'ban-ms gnc-B)
(dk-cite! 'ban-pts gnc-B)
(dk-cite! 'bal-uba-complete gnc-B)
(gnc-rhs! (dk-cite! 'is-complete gnc-Mb))
(define gnc-cplb-cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-CAUCHY-SEQ) (dk-contains? h gnc-Mb))) "b is complete"))
(dk-have! (list 'SUBSET 'kk (list 'PTS gnc-Mb))
  (lambda () (subst (dk-cite! 'ban-pts gnc-B)) (subst '(== (VEC (UIBA-AS-UBA b)) (VEC b))) (gnc-ass!)))
(mac 'is-complete)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (gnc-ass!)
      (let* ((pe (dk-peel!))
             (f (caddr (car (filter (lambda (x) (dk-head-is? x 'IS-CAUCHY-SEQ)) pe))))
             (ciff (dk-cite! 'is-cauchy-seq gnc-MS f))
             (_c (gnc-rhs! ciff))
             (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'DIST) (dk-contains? x gnc-MS))) "the Cauchy clause"))
             (fty (dk-rewrite-h! (list 'IN f (list 'FUN 'NN (list 'PTS gnc-MS))) (list 'PTS gnc-MS) (list 'VEC gnc-L8)))
             (_r (gnc-ro8! 'VEC))
             (fty2 (dk-rewrite-h! fty (list 'VEC gnc-L8) 'kk)))
        (gnc-cite2! 'fun-codomain-superset f 'NN 'kk (list 'PTS gnc-Mb))
        ;; f is Cauchy in b
        (let ((biff (dk-cite! 'is-cauchy-seq gnc-Mb f)))
          (dk-have! (cadr biff) (lambda () (gnc-bwd! biff
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (gnc-ass!)
                    (let* ((ls (dk-peel!))
                           (eps (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) ls))))
                           (n (dk-skolem! (gnc-detach-all! (dk-apply! cl eps))))
                           (_s (dk-split-all!))
                           (c2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'DIST))) "the clause at n")))
                      (ew n)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (gnc-ass!)
                            (let* ((ls2 (dk-peel!)) (g (dk-goal)) (fm (cadr (cadr g))) (fn (caddr (cadr g))))
                              (gnc-fk! f (cadr fm)) (gnc-fk! f (cadr fn))
                              (let ((dl (gnc-detach-all! (dk-apply! c2 (cadr fm) (cadr fn)))))
                                (subst (gnc-distb! fm fn))
                                (let ((e (gnc-distL! fm fn))) (dk-rewrite-h! dl (cadr e) (caddr e)))
                                (gnc-ass!))))))))))))))
        ;; its limit l in b
        (let* ((cv (gnc-detach-all! (dk-apply! gnc-cplb-cl f)))
               (l (dk-skolem! (gnc-rhs! (dk-cite! 'converges gnc-Mb f))))
               (_t (gnc-rhs! (dk-cite! 'converges-to gnc-Mb f l)))
               (ct (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'DIST) (dk-contains? x l))) "the convergence clause"))
               (lp (dk-rewrite-h! (list 'IN l (list 'PTS gnc-Mb)) (list 'PTS gnc-Mb) (list 'VEC gnc-B)))
               (lp2 (dk-rewrite-h! lp (list 'VEC gnc-B) '(VEC b))))
          ;; l in kk, by the closedness clause
          (let ((c (gnc-inst (gnc-clause! 'kk 6) l)))
            (detach-with! (begin (dk-have! c (lambda () (dk-peel!) (dk-apply! (gnc-clause! 'kk 6) l) (gnc-ass!))) c)
              (lambda ()
                (let* ((ls3 (dk-peel!))
                       (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) ls3))))
                       (d (dk-halve! e))
                       (n (dk-skolem! (gnc-detach-all! (dk-apply! ct d))))
                       (_s (dk-split-all!))
                       (c3 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'DIST))) "the bound at n")))
                  (dk-cite! 'nn-le-refl n)
                  (gnc-fk! f n)
                  (let* ((fn (list f n))
                         (b1 (gnc-detach-all! (dk-apply! c3 n)))
                         (b2 (let ((e (gnc-distb! fn l))) (dk-rewrite-h! b1 (cadr e) (caddr e))))
                         (sw (gnc-alg-have! (list '= (list '(VADD b) l (list '(VNEG b) fn)) (list '(VNEG b) (list '(VADD b) fn (list '(VNEG b) l))))))
                         (_v (gnc-vb! (list '(VADD b) fn (list '(VNEG b) l))))
                         (ng (dk-cite! 'bcp-u-ban-neg-norm 'b (list '(VADD b) fn (list '(VNEG b) l)))))
                    (ew fn)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (gnc-ass!)
                          (begin
                            (subst sw)
                            (gnc-nty! (list '(VADD b) fn (list '(VNEG b) l)))
                            (gnc-nty! (list '(VNEG b) (list '(VADD b) fn (list '(VNEG b) l))))
                            (dk-cite! 'rr-pos-rr-in-rr e)
                            (dk-ineq! ng b2 (list '= (list '+ d d) e) (list '< 0 d) (list 'IN d 'RR) (list 'IN e 'RR)
                                      (list 'IN (gnc-nrm (list '(VADD b) fn (list '(VNEG b) l))) 'RR)
                                      (list 'IN (gnc-nrm (list '(VNEG b) (list '(VADD b) fn (list '(VNEG b) l)))) 'RR)))))))))))
          ;; f converges to l in MS
          (mac 'converges)
          (ew l)
          (let ((tiff (dk-cite! 'converges-to gnc-MS f l)))
            (gnc-bwd! tiff
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (let ((g (dk-goal)))
                      (cond
                       ((dk-asm? g) (gnc-ass!))
                       ((and (dk-head-is? g 'IN) (equal? (cadr g) l))
                        (subst (dk-cite! 'nag-metric-carrier-cna-as-normed-ag gnc-L8)) (subst (gnc-ro8! 'VEC)) (gnc-ass!))
                       ((dk-head-is? g 'IN) (gnc-ass!))
                       (#t
                        (let* ((ls (dk-peel!))
                               (eps (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) ls))))
                               (n (dk-skolem! (gnc-detach-all! (dk-apply! ct eps))))
                               (_s (dk-split-all!))
                               (c4 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'DIST))) "the bound at n")))
                          (ew n)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal)) (gnc-ass!)
                                (let* ((ls2 (dk-peel!)) (g2 (dk-goal)) (fm (cadr (cadr g2))))
                                  (gnc-fk! f (cadr fm))
                                  (let ((b1 (gnc-detach-all! (dk-apply! c4 (cadr fm)))))
                                    (subst (gnc-distL! fm l))
                                    (let ((e (gnc-distb! fm l))) (dk-rewrite-h! b1 (cadr e) (caddr e)))
                                    (gnc-ass!)))))))))))))))))))))
