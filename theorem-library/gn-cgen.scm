          ((equal? h gnc-lVNRM) (gnc-kt! (cadr a)) (subst (dk-cite! 'sub-ucsa-vnrm-apply 'b 'kk (cadr a))))
          ((equal? h gnc-lVSTAR) (gnc-kt! (cadr a)) (subst (dk-cite! 'sub-ucsa-vstar-apply 'b 'kk (cadr a))))
          ((equal? h (list 'ADD gnc-R)) (gnc-cc! (cadr a)) (gnc-cc! (caddr a)) (subst (dk-cite! 'sip-cc-ring-add-value (cadr a) (caddr a))))
          ((equal? h (list 'MUL gnc-R)) (gnc-cc! (cadr a)) (gnc-cc! (caddr a)) (subst (dk-cite! 'sip-cc-ring-mul-value (cadr a) (caddr a))))
