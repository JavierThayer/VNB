;;; ==== C*(x) is commutative for x normal ===================================================================
(define gnc-Z1 '(SEP gncw_ (VEC b) (OR (= gncw_ x) (= gncw_ ((VSTAR b) x)))))
(define (gnc-cm-sep T) (list 'SEP 'gnvy_ '(VEC b) (list 'FORALL 'gnvz_ (list 'IMPLIES (list 'IN 'gnvz_ T)
                          '(= ((VMUL b) gnvy_ gnvz_) ((VMUL b) gnvz_ gnvy_))))))
(define (gnc-cm-clause! y T)           ; (IN y (COMMUTANT-EL b T)) in context: return y's commutation clause
  (dk-cite! 'commutant-el-unfold 'b T)
  (let ((h (dk-rewrite-h! (list 'IN y (list 'COMMUTANT-EL 'b T)) (list 'COMMUTANT-EL 'b T) (gnc-cm-sep T))))
    (dk-sep-parts! h)))
(define (gnc-into-cm! e T prover)      ; goal (IN e (COMMUTANT-EL b T)); PROVER z proves (= ez ze) for z in T
  (subst (dk-cite! 'commutant-el-unfold 'b T))
  (in-sep! (lambda () (gnc-vb! e) (gnc-ass!))
    (lambda ()
      (let* ((ls (dk-peel!)) (z (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) T))) ls)))))
        (prover z)))))

(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (FORALL x (IMPLIES (IS-NORMAL-EL b x)
  (FORALL y (IMPLIES (IN y (CSTAR-GEN b x)) (FORALL z (IMPLIES (IN z (CSTAR-GEN b x))
