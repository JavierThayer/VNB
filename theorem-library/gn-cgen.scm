                                     (sc (gnc-detach-all! (dk-apply! (gnc-cite2! 'aif-scale-small cc2) eps)))
                                     (_s (dk-split-all! (list sc)))
                                     (dl (cadr (cadr sc)))
                                     (w (dk-skolem! (dk-apply! ap dl))))
                                (dk-split-all!)
                                (dk-cite! 'rr-pos-rr-in-rr dl)
                                (dk-cite! 'rr-pos-rr-in-rr eps)
                                (gnc-cm! w)
                                (let* ((u (list '(VADD b) y (list '(VNEG b) w)))
                                       (uz (gnc-m 'b u z)) (zu (gnc-m 'b z u))
                                       (core (list '(VADD b) uz (list '(VNEG b) zu)))
                                       (hw (gnc-hint! w z))
                                       (E (gnc-alg-have! (list '= d (list '(VADD b) core (list '(VADD b) (gnc-m 'b w z) (list '(VNEG b) (gnc-m 'b z w)))))))
                                       (Ew2 (dk-rewrite-h! E (gnc-m 'b w z) (gnc-m 'b z w)))
                                       (F (gnc-alg-have! (list '= (caddr Ew2) core))))
                                  (subst Ew2) (subst F)
                                  (gnc-nty! u) (gnc-nn! u) (gnc-nty! uz) (gnc-nty! zu) (gnc-nty! core)
                                  (let* ((T (dk-cite! 'bcp-u-bal-uba-vnrm-triangle 'b uz (list '(VNEG b) zu)))
                                        (Ng (dk-cite! 'bcp-u-ban-neg-norm 'b zu))
                                        (S1 (dk-cite! 'bcp-u-bal-uba-vnrm-submult 'b u z))
                                        (S2 (dk-cite! 'bcp-u-bal-uba-vnrm-submult 'b z u))
                                        (A (dk-pick (lambda (h) (and (dk-head-is? h '<) (equal? (caddr h) dl))) "the approximation bound"))
                                        (_le (dk-have! (list '<= (gnc-nrm u) dl) (lambda () (dk-ineq! A))))
                                        (M (gnc-cite2! 'rr-le-scale-nonneg-right (gnc-nrm u) dl c)))
                                    (gnc-nty! (list '(VNEG b) zu))
                                    (let* ((nu (gnc-nrm u))
                                           (e1 (dk-have! (list '= (list '* c nu) (list '* nu c)) (lambda () (crs))))
