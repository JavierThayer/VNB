;;; land (IN e kk) for a term of b's operations over atoms in kk
(define (gnc-kt! e)
  (let ((g (list 'IN e 'kk)))
    (cond ((dk-asm? g) g)
          ((equal? e '(VONE b)) (gnc-clause! 'kk 1) g)
          ((equal? e '(VZERO b))
           (let ((z (begin (gnc-vb! '(VONE b)) (dk-cite! 'kal-uiba-act-zero 'b '(VONE b)))))
             (gnc-kt! (cadr z))
