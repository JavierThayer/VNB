        (let ((before (dk-goal))) (lam-b)
          (if (and (gnc-open?) (not (equal? (dk-goal) before))) (loop (- fuel 1)))))))
(define (gnc-type-atom!)
  (let ((g (dk-goal)))
    (cond ((not (gnc-open?)) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'CARTESIAN) (eq? (caddr g) 'SET))
           (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'kk)) (gnc-kt! (cadr g)) (gnc-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'RR)) (gnc-vecall!) (gnc-nty! (cadr (cadr g))) (gnc-ass!))
          (#t (error "gnc-type-atom!: unexpected leaf" (expression->string g))))))
(define (gnc-type-leaf!)
  (let loop ()
    (let ((g (dk-goal)))
      (cond ((not (gnc-open?)) #t)
            ((memq (dk-head g) '(FORALL IMPLIES)) (gnc-beta!) (if (and (gnc-open?) (memq (dk-head (dk-goal)) '(FORALL IMPLIES))) (di)) (loop))
            ((dk-head-is? g 'AND) (dk-conj-close! (lambda () (gnc-beta!) (gnc-type-atom!))))
            (#t (gnc-beta!) (gnc-type-atom!))))))
(define (gnc-fun-typing!)
  (for-each (lambda (k) (dk-focus! k) (gnc-type-leaf!)) (dk-opened (lambda () (lam-t)))))

(define (gnc-fun-class c)
  (cond ((member c (list gnc-lVADD gnc-lVMUL)) '(FUN (CARTESIAN kk kk) kk))
        ((equal? c gnc-lACT) '(FUN (CARTESIAN CC kk) kk))
        ((equal? c gnc-lVNRM) '(FUN kk RR))
        ((member c (list gnc-lVNEG gnc-lVSTAR)) '(FUN kk kk))
        (#t #f)))
(define (gnc-set! c)
  (if (not (dk-asm? (list 'IN c 'SET)))
      (cond ((gnc-fun-class c)
             => (lambda (F)
                  (if (not (dk-asm? (list 'IN c F))) (dk-have! (list 'IN c F) gnc-fun-typing!))
                  (fact 'membership-implies-sethood c F)))
            ((member c '((VZERO b) (VONE b))) (gnc-vb! c) (fact 'membership-implies-sethood c '(VEC b)))
            (#t #f))))
(define (gnc-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (k (error "GNC stop" tag (if (condition? e) (condition/report-string e) e)
                    (if (gnc-open?) (expression->string (dk-goal)) "no open leaf"))))
        thunk))))
(define (gnc-conjunct!)
  (let ((g (dk-goal)))
    (cond ((not (gnc-open?)) #t)
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (len-r) (if (gnc-open?) (arith)))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET) (dk-head-is? (cadr g) 'LIST))
           (for-each gnc-set! (cdr (cadr g)))
           (dk-list-in-set!))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((equal? g (list '= (list 'CARR gnc-R) 'CC)) (dk-cite! 'sip-cc-ring-carr) (gnc-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'kk)) (gnc-kt! (cadr g)) (gnc-ass!))
          ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
           (if (dk-contains? g (list 'CARR gnc-R)) (subst (dk-cite! 'cc-scalar-ring-carr)))
           (gnc-fun-typing!))
          ((memq (dk-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES)) (mac (dk-head g)) (gnc-law!))
          ((memq (dk-head g) '(FORALL =)) (gnc-law!))
          (#t (error "gnc-conjunct!: unexpected conjunct" (expression->string g))))))
(define (gnc-ro-name n acc) (symbol-append 'sub-ucsa-tuple (string->symbol (number->string n)) '- acc))
(define (gnc-readoff! n acc val)
  (sp (make-wff (gnc-stmt-bk (list '== (list acc (gnc-tuple n)) val))))
  (dk-peel!)
  (gnc-base!)
  (slot acc)
  (let loop ((k 0)) (if (and (< k 10) (gnc-open?) (dk-contains? (dk-goal) 'NTH)
                             (find-first (lambda (e) (and (pair? e) (eq? (car e) 'NTH) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)))
                                         (gnc-subterms (dk-goal))))
                        (begin (nth-r) (loop (+ k 1)))))
  (if (and (gnc-open?) (dk-contains? (dk-goal) (list acc 'b))) (slot acc))
  (if (gnc-open?) (qrfl))
  (for-each (lambda (k)
              (if (not (sequent-node-grounded? k))
                  (let ((g (dk-goal-of k)))
                    (dk-focus! k)
                    (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)) (dk-head-is? (cadr g) 'LIST))
                        (begin (dk-have! (list 'IN (cadr g) 'SET) (lambda () (dk-list-in-set!))) (rfl))))))
            (dk-open-leaves))
  (gnc-qed! (gnc-ro-name n acc)))
(define (gnc-subterms e) (if (pair? e) (cons e (append-map gnc-subterms e)) (list e)))
(for-each (lambda (n) (for-each (lambda (acc v) (gnc-readoff! n acc v)) (gnc-first n gnc-accs) (gnc-first n gnc-vals))) '(8 9 10))
(define (gnc-unfold-tuple! iff n)
  (mac iff)
  (for-each (lambda (m)
              (for-each (lambda (acc)
                          (let ((from (list acc (gnc-tuple m))))
                            (if (dk-contains? (dk-goal) from) (subst (dk-cite! (gnc-ro-name m acc) 'b 'kk)))))
                        (gnc-first m gnc-accs)))
            '(10 9 8)))
(define (gnc-tower! name pred n iff lemmas extra-hyps)
  (sp (make-wff (gnc-stmt-bk (fold-right (lambda (h acc) (list 'IMPLIES h acc)) (list pred (gnc-tuple n)) extra-hyps))))
  (dk-peel!)
  (gnc-base!)
  (for-each (lambda (l) (dk-cite! l 'b 'kk)) lemmas)
  (gnc-unfold-tuple! iff n)
  (dk-conj-close! (lambda () (let ((g (dk-goal))) (gnc-try (expression->string g) gnc-conjunct!))))
  (gnc-qed! name))
