                           (d (list '(VADD b) yz (list '(VNEG b) zy)))
                           (N (gnc-nrm d)) (c (gnc-nrm z)) (cc2 (list '+ c c)))
                      (gnc-nty! d) (gnc-nn! d) (gnc-nty! z) (gnc-nn! z)
                      (gnc-cite2! 'rr-add-closed c c)
                      (dk-have! (list '<= 0 cc2) (lambda () (dk-ineq! (list '<= 0 c))))
                      (let ((imp (dk-cite! 'rr-nonneg-below-all-zero N)))
                        (gnc-detach-all!
                          (detach-with! (if (dk-head-is? (cadr imp) 'FORALL) imp (detach-with! imp (lambda () (gnc-ass!))))
                            (lambda ()
                              (let* ((ls3 (dk-peel!))
