;;; gn-cgen.scm -- the C*-subalgebra C*(x, 1) generated by a normal element x of a unital C*-algebra b, as
;;; a STRUCTURE: CSTAR-GEN(b, x) (ba2b-gen-vocab) is a norm-closed unital *-subalgebra set
;;; (cstar-gen-closed-star-subalgebra); for any such set S, SUB-UCSA(b, S) (gn-vocab) is a unital
;;; C*-algebra and a unital C*-subalgebra of b (sub-ucsa-unital-c-star, sub-ucsa-subalgebra); and for x
;;; normal, C*(x, 1) is commutative (cstar-gen-commutative).  F. J. Thayer, "Banach Algebras and
;;; Applications", ch. 1 s. 3 (the object of Proposition 1.31).  Agent BA-1117-GN, wave 2026-11-17, round 2.
;;; All proofs modulo 0.  Destination: theorem-library/gn-cgen.scm, after gn-vocab and ba2b-gen.
;;; Library: operator-algebras.  Helper prefix gnc-.  Binders gnc*_.
;;;
;;; THE ROUTE for commutativity: the commutant COMMUTANT-EL(b, Z) of a *-closed Z is a norm-closed unital
;;; *-subalgebra set (gnc-commutant-closed-star; closedness by ||yz - zy|| <= 2 ||z|| ||y - w|| for w in
;;; the commutant).  Z = {x, x*} gives C*(x) inside the commutant of {x, x*}, so every element of C*(x)
;;; commutes with x; then x lies in the commutant of C*(x), so C*(x) lies in it: C*(x) is commutative.

(define (gnc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-cgen: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 300)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-cgen: unfinished" name))))
(define (gnc-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gnc-ass!) (if (and (gnc-open?) (dk-asm? (dk-goal))) (ass)))
(define (gnc-detach-all! f)
  (let loop ((ch f))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gnc-cite2! . args) (gnc-detach-all! (apply dk-cite! args)))
(define (gnc-replace old new e) (cond ((eq? e old) new) ((pair? e) (map (lambda (s) (gnc-replace old new s)) e)) (#t e)))
(define (gnc-alg-have! claim) (dk-alg-have! 'kal-uiba 'b claim))

;;; the seven clauses of IS-CLOSED-STAR-SUBALGEBRA-SET(b, S), in the definition's binders
(define (gnc-clauses S)
  (list (list 'SUBSET S '(VEC b))
        (list 'IN '(VONE b) S)
        (list 'FORALL 'b2vx_ (list 'IMPLIES (list 'IN 'b2vx_ S) (list 'FORALL 'b2vy_ (list 'IMPLIES (list 'IN 'b2vy_ S)
          (list 'IN '((VADD b) b2vx_ b2vy_) S)))))
        (list 'FORALL 'b2vz_ (list 'IMPLIES '(IN b2vz_ CC) (list 'FORALL 'b2vx_ (list 'IMPLIES (list 'IN 'b2vx_ S)
          (list 'IN '((ACT b) b2vz_ b2vx_) S)))))
        (list 'FORALL 'b2vx_ (list 'IMPLIES (list 'IN 'b2vx_ S) (list 'FORALL 'b2vy_ (list 'IMPLIES (list 'IN 'b2vy_ S)
          (list 'IN '((VMUL b) b2vx_ b2vy_) S)))))
        (list 'FORALL 'b2vx_ (list 'IMPLIES (list 'IN 'b2vx_ S) (list 'IN '((VSTAR b) b2vx_) S)))
        (list 'FORALL 'b2vy_ (list 'IMPLIES '(IN b2vy_ (VEC b))
          (list 'IMPLIES (list 'FORALL 'b2ve_ (list 'IMPLIES '(POS-RR b2ve_) (list 'FORSOME 'b2vx_ (list 'AND (list 'IN 'b2vx_ S)
                     '(< ((VNRM b) ((VADD b) b2vy_ ((VNEG b) b2vx_))) b2ve_)))))
                (list 'IN 'b2vy_ S))))))
(define (gnc-clause! S k)              ; land clause k (0-based) of S's IS-CLOSED-STAR-SUBALGEBRA-SET in context
  (let ((c (list-ref (gnc-clauses S) k)))
    (if (not (dk-asm? c)) (dk-project! c 'is-closed-star-subalgebra-set (list 'IS-CLOSED-STAR-SUBALGEBRA-SET 'b S)))
    c))
(define (gnc-uiba!)
  (if (not (dk-asm? '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA b))) (dk-cite! 'bcp-ucsa-uiba 'b))
  (if (not (dk-asm? '(IN (VEC b) SET))) (dk-cite! 'frm-module-vec-set-uba-as-module-uiba-as-uba 'b)))
;;; land (IN e (VEC b)) for a term of b's operations over atoms typed in VEC b or in a subset of it
(define (gnc-vb! e)
  (let ((g (list 'IN e '(VEC b))))
    (cond ((dk-asm? g) g)
          ((equal? e '(VONE b)) (dk-cite! 'kal-uiba-vone-in 'b) g)
          ((equal? e '(VZERO b)) (dk-cite! 'kal-uiba-vzero-in 'b) g)
          ((and (pair? e) (equal? (car e) '(VADD b))) (gnc-vb! (cadr e)) (gnc-vb! (caddr e)) (dk-cite! 'kal-uiba-vadd-in 'b (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VMUL b))) (gnc-vb! (cadr e)) (gnc-vb! (caddr e)) (dk-cite! 'kal-uiba-vmul-in 'b (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT b))) (gnc-vb! (caddr e)) (dk-cite! 'kal-uiba-act-in 'b (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VSTAR b))) (gnc-vb! (cadr e)) (dk-cite! 'kal-uiba-vstar-in 'b (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG b))) (gnc-vb! (cadr e)) (dk-cite! 'kal-uiba-vneg-in 'b (cadr e)) g)
          ((find-first (lambda (a) (and (dk-head-is? a 'IN) (equal? (cadr a) e) (dk-head-is? (caddr a) 'SEP)
                                        (equal? (caddr (caddr a)) '(VEC b))))
                       (dk-asms))
           => (lambda (a) (dk-sep-parts! a) g))
          (#t
           (let ((h (find-first (lambda (a) (and (dk-head-is? a 'IN) (equal? (cadr a) e)
                                                  (dk-asm? (list 'SUBSET (caddr a) '(VEC b)))))
                                (dk-asms))))
             (if (not h) (error "gnc-vb!: cannot type" (expression->string e)))
             (dk-cite! 'subset-mem-fwd (caddr h) '(VEC b) e)
             g)))))
(define (gnc-nrm e) (list '(VNRM b) e))
(define (gnc-nty! e) (gnc-vb! e) (if (not (dk-asm? (list 'IN (gnc-nrm e) 'RR))) (dk-cite! 'bcp-u-bae-vnrm-type 'b e)))
(define (gnc-nn! e) (gnc-vb! e) (dk-cite! 'bcp-u-bal-uba-vnrm-nonneg 'b e))

;;; ==== membership in C*(x) = CSTAR-GEN(b, x) ==============================================================
(define gnc-G '(CSTAR-GEN b x))
(define (gnc-fam a x)
  (list 'SEP 'b2vs_ (list 'POWER (list 'VEC a))
        (list 'AND (list 'IS-CLOSED-STAR-SUBALGEBRA-SET a 'b2vs_) (list 'IN x 'b2vs_))))
(define gnc-hb '(IMPLIES (IS-UNITAL-C-STAR-ALGEBRA b) (IMPLIES (IN x (VEC b)) BODY)))
(define (gnc-stmt-bx body) (list 'FORALL 'b (list 'FORALL 'x (gnc-replace 'BODY body gnc-hb))))

;;; y in C*(x), S closed with x in S  ==>  y in S
(sp (make-wff (gnc-stmt-bx '(FORALL y (IMPLIES (IN y (CSTAR-GEN b x)) (FORALL gncs_ (IMPLIES (IS-CLOSED-STAR-SUBALGEBRA-SET b gncs_)
  (IMPLIES (IN x gncs_) (IN y gncs_)))))))))
(dk-peel!)
(gnc-uiba!)
(dk-cite! 'cstar-gen-least 'b 'x 'gncs_)
(dk-cite! 'subset-mem-fwd gnc-G 'gncs_ 'y)
(gnc-ass!)
(gnc-qed! 'cstar-gen-mem-elim)

;;; y in every closed S containing x  ==>  y in C*(x)
(sp (make-wff (gnc-stmt-bx '(FORALL y (IMPLIES (FORALL gncs_ (IMPLIES (IS-CLOSED-STAR-SUBALGEBRA-SET b gncs_)
  (IMPLIES (IN x gncs_) (IN y gncs_)))) (IN y (CSTAR-GEN b x)))))))
(dk-peel!)
(gnc-uiba!)
(dk-cite! 'b2n-vec-closed-star 'b)
(let ((hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'gncs_))) "the hypothesis")))
  (mac 'CSTAR-GEN)
  (mac 'intersection-of-membership)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          (begin
            (ew '(VEC b))
            (in-sep!
              (lambda ()
                (mac 'power-set-membership)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORALL) (begin (dk-peel!) (gnc-ass!)) (gnc-ass!)))))
              (lambda () (dk-conj-close! (lambda () (gnc-ass!))))))
          (begin
            (dk-peel!)
            (let* ((S (caddr (dk-goal)))
                   (m (dk-pick (lambda (h) (equal? h (list 'IN S (gnc-fam 'b 'x)))) "S in the family")))
              (dk-project! (list 'IS-CLOSED-STAR-SUBALGEBRA-SET 'b S) (lambda () (sep-me m)))
              (dk-project! (list 'IN 'x S) (lambda () (sep-me m)))
              (gnc-detach-all! (dk-apply! hyp S))
              (gnc-ass!)))))))
(gnc-qed! 'cstar-gen-mem-intro)

;;; prove (IN t C*(x)) from a prover (lambda (s) ...) that lands (IN t s) for s closed with x in s
(define (gnc-into-G! t prover)
  (gnc-vb! t)
  (let ((imp (dk-cite! 'cstar-gen-mem-intro 'b 'x t)))
    (detach-with! imp
      (lambda ()
        (let* ((ls (dk-peel!))
               (s (caddr (car (filter (lambda (h) (dk-head-is? h 'IS-CLOSED-STAR-SUBALGEBRA-SET)) ls)))))
          (prover s)
          (gnc-ass!))))
    (gnc-ass!)))
(define (gnc-in-s! y s)                ; y in C*(x) in context: land y in s
  (if (not (dk-asm? (list 'IN y s)))
      (gnc-detach-all! (dk-cite! 'cstar-gen-mem-elim 'b 'x y s))))
(define (gnc-inst f v) (gnc-replace (cadr f) v (caddr (caddr f))))  ; (FORALL u (IMPLIES (IN u D) B)) at v: B[v/u]
(define (gnc-in-G-vars) (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) gnc-G))) (dk-asms))))

;;; C*(x) is a norm-closed unital *-subalgebra set
(sp (make-wff (gnc-stmt-bx (list 'IS-CLOSED-STAR-SUBALGEBRA-SET 'b gnc-G))))
(dk-peel!)
(gnc-uiba!)
(dk-cite! 'cstar-gen-subset 'b 'x)
(mac 'is-closed-star-subalgebra-set)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
       ((dk-asm? g) (gnc-ass!))
       ((dk-head-is? g 'IN)               ; the unit
        (gnc-into-G! '(VONE b) (lambda (s) (gnc-clause! s 1))))
       (#t
        (let* ((ls (dk-peel!)) (g2 (dk-goal)))
          (if (pair? (cadr g2))
              (let ((t (cadr g2)))
                (gnc-into-G! t
                  (lambda (s)
                    (for-each (lambda (v) (gnc-in-s! v s)) (gnc-in-G-vars))
                    (let ((k (cond ((equal? (car t) '(VADD b)) 2) ((equal? (car t) '(ACT b)) 3)
                                   ((equal? (car t) '(VMUL b)) 4) (#t 5))))
                      (gnc-detach-all! (apply dk-apply! (gnc-clause! s k) (cdr t)))))))
              ;; the closedness clause: goal (IN y G) under the approximation hypothesis
              (let* ((y (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC b)))) ls))))
                     (ap (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h gnc-G))) "approximation")))
                (gnc-into-G! y
                  (lambda (s)
                    (let ((c (begin
                                    (gnc-inst (gnc-clause! s 6) y))))
                      (detach-with! (begin (dk-have! c (lambda () (dk-peel!) (dk-apply! (gnc-clause! s 6) y) (gnc-ass!))) c)
                        (lambda ()
                          (let* ((ls2 (dk-peel!))
                                 (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) ls2))))
                                 (w (dk-skolem! (dk-apply! ap e))))
                            (dk-split-all!)
                            (gnc-in-s! w s)
                            (ew w)
                            (dk-conj-close! (lambda () (gnc-ass!)))))))))))))))))
(gnc-qed! 'cstar-gen-closed-star-subalgebra)

;;; ==== the commutant of a *-closed set is a norm-closed unital *-subalgebra set ===========================
(define gnc-Cs '(SEP gnvy_ (VEC b) (FORALL gnvz_ (IMPLIES (IN gnvz_ t) (= ((VMUL b) gnvy_ gnvz_) ((VMUL b) gnvz_ gnvy_))))))
(sp (make-wff '(FORALL b (FORALL t (== (COMMUTANT-EL b t) (SEP gnvy_ (VEC b) (FORALL gnvz_ (IMPLIES (IN gnvz_ t)
  (= ((VMUL b) gnvy_ gnvz_) ((VMUL b) gnvz_ gnvy_))))))))))
(di) (mac 'COMMUTANT-EL) (qrfl)
(gnc-qed! 'commutant-el-unfold)

(define (gnc-m b x y) (list (list 'VMUL b) x y))
(define (gnc-cm! y)                    ; (IN y Cs) in context: land y in VEC b and return its clause
  (dk-sep-parts! (list 'IN y gnc-Cs)))
(define (gnc-hint! y z)                ; (= yz zy) for y in Cs, z in t
  (gnc-detach-all! (dk-apply! (gnc-cm! y) z)))
(define (gnc-in-t-vb! z) (if (not (dk-asm? (list 'IN z '(VEC b)))) (dk-cite! 'subset-mem-fwd 't '(VEC b) z)))
(define (gnc-rev e) (gnc-cite2! 'eq-sym (cadr e) (caddr e)))
(define (gnc-definite! d)              ; ||d|| = 0 in context: land d = 0
  (gnc-vb! d)
  (dk-cite! 'bcs-uiba-is-uba 'b)
  (for-each (lambda (n) (dk-cite! n 'b)) '(bcp-ro-vec bcp-ro-vnrm bcp-ro-vzero bcp-ro-vadd bcp-ro-vneg))
  (dk-have! (list 'IN d '(VEC (UIBA-AS-UBA b))) (lambda () (subst '(== (VEC (UIBA-AS-UBA b)) (VEC b))) (gnc-ass!)))
  (let* ((B '(UIBA-AS-UBA b))
         (iff2 (dk-cite! 'bal-uba-vnrm-definite B d))
         (iff3 (fold-left (lambda (f h) (if (dk-contains? f (list h B)) (dk-rewrite-h! f (list h B) (list h 'b)) f))
                          iff2 '(VADD VNEG VZERO VNRM))))
    (dk-have! (list '= d '(VZERO b)) (lambda () (if (dk-only! iff3 (list '= (list '(VNRM b) d) 0)) (prop))))))
;;; prove (IN e Cs): THUNK proves (= ez ze) for the peeled z in t
(define (gnc-into-C! e prover)
  (gnc-vb! e)
  (in-sep! (lambda () (gnc-ass!))
    (lambda ()
      (let* ((ls (dk-peel!)) (z (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 't))) ls)))))
        (gnc-in-t-vb! z)
        (prover z)))))

(sp (make-wff '(FORALL b (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA b) (FORALL t (IMPLIES (SUBSET t (VEC b))
  (IMPLIES (FORALL gncz_ (IMPLIES (IN gncz_ t) (IN ((VSTAR b) gncz_) t)))
    (IS-CLOSED-STAR-SUBALGEBRA-SET b (COMMUTANT-EL b t)))))))))
(dk-peel!)
(gnc-uiba!)
(dk-cite! 'bcs-uiba-is-uba 'b) (dk-cite! 'bcp-ro-vec 'b)
(subst (dk-cite! 'commutant-el-unfold 'b 't))
(mac 'is-closed-star-subalgebra-set)
(define gnc-starcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'gncz_))) "t is *-closed"))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
       ((dk-asm? g) (gnc-ass!))
       ((dk-head-is? g 'SUBSET)
        (mac 'subset-def)
        (let ((v (dk-di-var!))) (if (not (dk-asm? (dk-goal))) (gnc-cm! v)) (gnc-ass!)))
       ((dk-head-is? g 'IN)               ; the unit
        (gnc-into-C! '(VONE b) (lambda (z) (dk-alg-norm! 'kal-uiba 'b))))
       (#t
        (let* ((ls (dk-peel!)) (g2 (dk-goal)) (t0 (cadr g2)))
          (if (pair? t0)
              (gnc-into-C! t0
                (lambda (z)
                  (let ((op (car t0)))
                    (cond
                     ((equal? op '(VADD b))
                      (let ((x (cadr t0)) (y (caddr t0)))
                        (gnc-hint! x z) (gnc-hint! y z)
                        (subst (gnc-alg-have! (list '= (gnc-m 'b t0 z) (list '(VADD b) (gnc-m 'b x z) (gnc-m 'b y z)))))
                        (subst (gnc-alg-have! (list '= (gnc-m 'b z t0) (list '(VADD b) (gnc-m 'b z x) (gnc-m 'b z y)))))
                        (subst (gnc-hint! x z)) (subst (gnc-hint! y z))
                        (if (gnc-open?) (rfl))))
                     ((equal? op '(ACT b))
                      (let ((r (cadr t0)) (x (caddr t0)))
                        (gnc-hint! x z)
                        (subst (gnc-alg-have! (list '= (gnc-m 'b t0 z) (list '(ACT b) r (gnc-m 'b x z)))))
                        (subst (gnc-alg-have! (list '= (gnc-m 'b z t0) (list '(ACT b) r (gnc-m 'b z x)))))
                        (subst (gnc-hint! x z))
                        (if (gnc-open?) (rfl))))
                     ((equal? op '(VMUL b))
                      (let ((x (cadr t0)) (y (caddr t0)))
                        (gnc-hint! x z) (gnc-hint! y z)
                        (subst (gnc-alg-have! (list '= (gnc-m 'b t0 z) (gnc-m 'b x (gnc-m 'b y z)))))
                        (subst (gnc-hint! y z))
                        (subst (gnc-alg-have! (list '= (gnc-m 'b x (gnc-m 'b z y)) (gnc-m 'b (gnc-m 'b x z) y))))
                        (subst (gnc-hint! x z))
                        (if (gnc-open?) (dk-alg-norm! 'kal-uiba 'b))))
                     (#t                  ; VSTAR
                      (let* ((x (cadr t0)) (zs (list '(VSTAR b) z)))
                        (gnc-detach-all! (dk-apply! gnc-starcl z))
                        (gnc-in-t-vb! zs)
                        (let ((h (gnc-hint! x zs)))
                          (subst (gnc-alg-have! (list '= (gnc-m 'b t0 z) (list '(VSTAR b) (gnc-m 'b zs x)))))
                          (subst (gnc-rev h))
                          (if (gnc-open?) (dk-alg-norm! 'kal-uiba 'b)))))))))
              ;; closedness
              (let* ((y (cadr g2))
                     (ap (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h gnc-Cs))) "approximation")))
                (gnc-into-C! y
