     ((and (dk-head-is? g '<=) (gnc-nm? (cadr g)) (pair? (cadr (cadr g))) (equal? (car (cadr (cadr g))) '(VMUL b)))
      (let ((s (cadr (cadr g)))) (dk-cite! 'bcp-u-bal-uba-vnrm-submult 'b (cadr s) (caddr s)) (gnc-ass!)))
     ((and (dk-head-is? g '=) (gnc-nm? (cadr g)) (equal? (cadr (cadr g)) '(VONE b)))
