          ((and (pair? e) (equal? (car e) '(VNEG b)))
           (gnc-kt! (cadr e)) (gnc-vb! (cadr e))
           (let ((z (dk-cite! 'kal-uiba-vneg-act 'b (cadr e))))
             (gnc-kt! (caddr z))
             (dk-rewrite-h! (list 'IN (caddr z) 'kk) (caddr z) e) g))
          ((and (pair? e) (memq (caar e) '(VADD VMUL)) (equal? (cadar e) 'b))
