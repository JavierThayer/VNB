(define (gnc-value! name lam vars)
  (sp (make-wff (gnc-stmt-bk
    (let loop ((vs vars))
      (if (null? vs) (list '= (cons lam vars) (cons (car (cadddr lam)) vars))
          (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) (if (eq? (car vs) 'c) 'CC 'kk)) (loop (cdr vs)))))))))
