;;; PROPOSITION 1.8: a Euclidean domain is a unique factorization domain
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-EUCLIDEAN-DOMAIN s) (IS-UFD s)))))
(dk-peel!)
(gu-open! 'is-euclidean-domain 's)
(define gu10-dfn (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'IS-DEGREE-FUNCTION))) "the degree function")))
(gu-deg! gu10-dfn)
(define gu10-ui (dk-cite! 'is-ufd 's))
(dk-have! (caddr gu10-ui)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-contains? (dk-goal) 'BIJECTION)
               (let* ((ls (dk-peel!))
                      (eq (car (filter (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'PROD-RING))) ls)))
                      (lhs (cadr eq)) (rhs (caddr eq))
                      (u (cadr lhs)) (p (caddr (caddr lhs))) (n (caddr (cadddr (caddr lhs))))
                      (v (cadr rhs)) (q (caddr (caddr rhs))) (m (caddr (cadddr (caddr rhs)))))
                 (dk-cite! 'factorization-unique n 's p m q u v)
                 (ass)))
              (#t
               (let* ((ls (dk-peel!))
                      (nz (car (filter (lambda (fm) (and (dk-head-is? fm 'NOT) (dk-contains? fm '(ZERO s)))) ls)))
                      (a (cadr (cadr nz)))
                      (bd (list 'succ (list gu10-dfn a))))
                 (gu-nu! gu10-dfn a)
                 (fact 'nn-succ-closed (list gu10-dfn a))
                 (dk-have! (list '< (list gu10-dfn a) bd) (lambda () (dk-nn!)))
                 (dk-cite! 'factorization-exists-bounded bd 's gu10-dfn a)
                 (ass))))))))
(dk-close-if! (lambda () (dk-only! gu10-ui (caddr gu10-ui))) prop)
(qed 'euclidean-domain-is-ufd)
