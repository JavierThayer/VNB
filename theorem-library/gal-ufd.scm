     (FORSOME gun_ (AND (IN gun_ NN)
       (FORSOME gup_ (AND (IS-PRIME-SEQ s gup_ gun_)
         (= a ((MUL s) guu_ (PROD-RING s gup_ (INTERVAL 1 gun_)))))))))))
