;;; A permutation of INTERVAL(1, n) extends to INTERVAL(1, succ n) fixing succ n
;;; ======================================================================
;; i in INTERVAL(1, succ n), i /= succ n, in context: land i in INTERVAL(1, n)
(define (gu-int-shrink! i n)
  (let ((sn (list 'succ n)))
    (gu-int-mem! i sn)
    (dk-have! (list 'NOT (list '= sn i))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
          (dk-have! (list '= i i) (lambda () (rfl)))
          (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
    (fact 'nn-le-ne-succ i sn)
    (gu-int-in! i n)))
(define (gu-ext f n) (list 'VNB-LAMBDA 'ge_ (gu-int (list 'succ n)) (list 'IF (list '= 'ge_ (list 'succ n)) (list 'succ n) (list f 'ge_))))
(define (gu-ext-ift f n x) (list 'IF (list '= x (list 'succ n)) (list 'succ n) (list f x)))
;; EXT_f(x) for x = succ n (TOP? true) or x in INTERVAL(1, n) (TOP? false), x typed in INTERVAL(1, succ n)
(define (gu-ext-val! f n x top?)
  (let ((sn (list 'succ n)))
    (if top?
        (dk-have! (list '= (list (gu-ext f n) x) sn)
          (lambda () (dk-lam-b!) (dk-if-branch! #t (gu-ext-ift f n x) (lambda () (gu-rfl-or-ass!)) (lambda () (rfl)))))
        (begin
          (gu-int-mem! x n)
          (dk-have! (list 'NOT (list '= x sn)) (lambda () (dk-nn!)))
          (dk-have! (list '= (list (gu-ext f n) x) (list f x))
            (lambda () (dk-lam-b!) (dk-if-branch! #f (gu-ext-ift f n x) #f (lambda () (rfl)))))))))

