;;; Corollary 1.6 and Proposition 1.8) (GALOIS, 2026-10-26).
;;; Destination: theorem-library/gal-ufd.scm, library algebra.  Vocabulary: catools-gal-vocab.scm,
;;; gal-ufd-vocab.scm; uses catools-gal-b1 (degree-proper-divisor, euclid-lemma).
;;; Load window: after la-z2-diag (load.scm 2204, lzd-prod-succ), interval-widen (2103) and
;;; rake-prod-of-sums (1751); and after the unwired catools-gal-vocab, catools-gal-b1, gal-ufd-vocab.
;;; The UFD statement lists primes with repetition (gal-ufd-vocab.scm); uniqueness is up to a
;;; bijection of the index sets matching associated primes.
;;; Helper prefix gu-.
;;; ======================================================================
(define (gu-op? t op) (and (pair? t) (equal? (car t) (list op 's))))
(define (gu-in! t)
  (if (not (dk-asm? (list 'IN t '(CARR s))))
      (cond ((gu-op? t 'MUL) (gu-in! (cadr t)) (gu-in! (caddr t)) (dk-cite! 'ring-carrier-closed-mul 's (cadr t) (caddr t)))
            ((gu-op? t 'ADD) (gu-in! (cadr t)) (gu-in! (caddr t)) (dk-cite! 'ring-add-closed 's (cadr t) (caddr t)))
            ((gu-op? t 'NEG) (gu-in! (cadr t)) (dk-cite! 'ring-neg-in-carr 's (cadr t)))
            (#t (dk-type! t '(CARR s))))))
(define (gu-mul a b) (list '(MUL s) a b))
(define (gu-int n) (list 'INTERVAL 1 n))
(define (gu-prod q n) (list 'PROD-RING 's q (gu-int n)))
;; cite the defining IFF of PRED at ARGS (PRED args in context) and land its parts
(define (gu-open! pred . args)
  (let* ((fm (cons (string->symbol (string-upcase (symbol->string pred))) args))
         (ii (apply dk-cite! pred args)))
    (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii (cadr ii))) prop)))
    (dk-split-all! (list (caddr ii)))
    (caddr ii)))
(define (gu-ring!)
  (if (not (dk-asm? '(IS-COMMUTATIVE-RING s)))
      (begin
        (dk-cite! 'integral-domain-is-commutative-ring 's)
        (dk-cite! 'commutative-ring-is-ring 's)
        (dk-cite! 'ring-one-in 's)
        (dk-cite! 'ring-zero-in 's))))
;; INTERVAL(1, n) is a finite set
(define (gu-int! n)
  (if (and (pair? n) (eq? (car n) 'succ) (not (dk-asm? (list 'IN n 'NN)))) (fact 'nn-succ-closed (cadr n)))
  (fact 'interval-in-set 1 n)
  (if (not (dk-asm? (list 'IN (list 'CARD (gu-int n)) 'NN)))
      (let ((e (dk-cite! 'interval-card n)))
        (dk-have! (list 'IN (list 'CARD (gu-int n)) 'NN) (lambda () (subst e) (ass))))))
;; IS-PRIME-SEQ(s, q, n) in context: land forall z_ in [1, n]. q(z_) in CARR(s)
(define (gu-seq-typ q n)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (gu-int n)) (list 'IN (list q 'z_) '(CARR s)))))
(define (gu-seq-typ! q n)
  (if (not (dk-asm? (gu-seq-typ q n)))
      (dk-have! (gu-seq-typ q n)
        (lambda ()
          (let* ((i (dk-di-var!))
                 (pi (dk-cite! 'is-prime-seq 's q n)))
            (dk-have! (caddr pi) (lambda () (dk-close-if! (lambda () (dk-only! pi (list 'IS-PRIME-SEQ 's q n))) prop)))
            (dk-apply! (caddr pi) i)
            (gu-open! 'is-prime-element 's (list q i))
            (ass))))))
(define (gu-prod-typ! q n)
  (gu-int! n) (gu-seq-typ! q n)
  (if (not (dk-asm? (list 'IN (gu-prod q n) '(CARR s))))
      (dk-cite! 'prod-ring-type-ptwise 's (gu-int n) q)))
;; IS-PRIME-SEQ(s, q, succ t) ==> IS-PRIME-SEQ(s, q, t)
(define (gu-seq-shrink! q t)
  (let ((pi (dk-cite! 'is-prime-seq 's q (list 'succ t))))
    (dk-have! (caddr pi) (lambda () (dk-close-if! (lambda () (dk-only! pi (list 'IS-PRIME-SEQ 's q (list 'succ t)))) prop)))
    (let ((pi2 (dk-cite! 'is-prime-seq 's q t)))
      (dk-have! (caddr pi2)
        (lambda ()
          (let ((i (dk-di-var!)))
            (fact 'nn-succ-closed t)
            (dk-have! (list '<= t (list 'succ t)) (lambda () (dk-nn!)))
            (dk-cite! 'interval-widen t (list 'succ t) 1 i)
            (dk-apply! (caddr pi) i)
            (ass))))
      (dk-have! (list 'IS-PRIME-SEQ 's q t) (lambda () (dk-close-if! (lambda () (dk-only! pi2 (caddr pi2))) prop))))))

;;; ======================================================================
