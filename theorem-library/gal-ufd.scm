;;; ======================================================================
;;; Existence of a factorization (by induction on a bound of the degree)
;;; ======================================================================
;; (IN i (INTERVAL 1 hi)) in context: land i in NN, 1 <= i, i <= hi
(define (gu-int-mem! i hi)
  (let ((ii (dk-cite! 'interval-membership 1 hi i)))
    (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii (list 'IN i (gu-int hi)))) prop)))
    (dk-split-all! (list (caddr ii)))))
;; prove i in INTERVAL(1, hi) from 1 <= i <= hi, with i, hi in NN
(define (gu-int-in! i hi)
  (if (not (dk-asm? (list 'IN i (gu-int hi))))
      (dk-have! (list 'IN i (gu-int hi))
        (lambda ()
          (dk-have! (list '<= 1 i) (lambda () (dk-nn!)))
          (dk-have! (list '<= i hi) (lambda () (dk-nn!)))
          (dk-cite! 'interval-mem-intro 1 hi i)
          (ass)))))
;; the sequence q with p appended at place succ(n)
(define (gu-app q p n) (list 'VNB-LAMBDA 'gx_ 'NN (list 'IF (list '= 'gx_ (list 'succ n)) p (list q 'gx_))))
(define (gu-unfold-seq! q n thunk)
  ;; goal IS-PRIME-SEQ(s, q, n): prove its defining universal by THUNK
  (let ((pi (dk-cite! 'is-prime-seq 's q n)))
    (dk-have! (caddr pi) thunk)
    (dk-close-if! (lambda () (dk-only! pi (caddr pi))) prop)))
;; the universal over INTERVAL(1, 0) is vacuous
(define (gu-vacuous!)
  (let* ((ls (dk-peel!))
         (mem (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(INTERVAL 1 0)))) ls)))
         (i (cadr mem))
         (e0 (dk-cite! 'interval-1-0-empty))
         (h (dk-rewrite-h! mem '(INTERVAL 1 0) 'EMPTY-SET)))
    (dk-cite! 'empty-set-has-no-members i)
    (dk-close-if! (lambda () (dk-only! h (list 'NOT h))) prop)))

;; IS-PRIME-SEQ(s, q, n) in context, i in INTERVAL(1, n): land IS-PRIME-ELEMENT(s, q(i))
(define (gu-seq-at! q n i)
  (let ((pi (dk-cite! 'is-prime-seq 's q n)))
    (dk-have! (caddr pi) (lambda () (dk-close-if! (lambda () (dk-only! pi (list 'IS-PRIME-SEQ 's q n))) prop)))
    (dk-apply! (caddr pi) i)))
;; the step of the existence proof: a = p d, d = u PROD(q, [1, n]); the witness is
;; u, succ(n), and q with p appended
(define (gu-exist-step! p d u n q apd)
  (let* ((sn (list 'succ n))
         (qq (gu-app q p n))
         (dq (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) d) (dk-contains? fm 'PROD-RING))) "d = u PROD")))
    (fact 'nn-succ-closed n)
    (gu-open! 'is-unit 's u)
    
    ;; the appended sequence is a prime sequence
    (dk-have! (list 'IS-PRIME-SEQ 's qq sn)
      (lambda ()
        (gu-unfold-seq! qq sn
          (lambda ()
            (let* ((ls (dk-peel!))
                   (i (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) (gu-int sn)))) ls)))))
              (gu-int-mem! i sn)
              (dk-lam-b!)
              (dk-case-if! (list 'IF (list '= i sn) p (list q i))
                (lambda (tr v)
                  (if tr (ass)
                      (begin
                        (dk-have! (list 'NOT (list '= sn i))
                          (lambda ()
                            (di)
                            (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
                              (dk-have! (list '= i i) (lambda () (rfl)))
                              (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
                        (fact 'nn-le-ne-succ i sn)
                        (gu-int-in! i n)
                        (gu-seq-at! q n i)
                        (ass))))))))))
    
    (gu-prod-typ! q n)
    (gu-seq-typ! qq sn)
    (gu-int! n)
    
    (let* ((ps1 (dk-cite! 'lzd-prod-succ 's n qq))
           (e2 (list '= (list qq sn) p))
           (z-all (list 'FORALL 'gz_ (list 'IMPLIES (list 'IN 'gz_ (gu-int n)) (list '= (list qq 'gz_) (list q 'gz_))))))
      (dk-have! e2 (lambda () (dk-lam-b!) (dk-if-branch! #t (list 'IF (list '= sn sn) p (list q sn)) (lambda () (rfl)) (lambda () (rfl)))))
      
      (dk-have! z-all
        (lambda ()
          (let* ((ls (dk-peel!))
                 (z (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) (gu-int n)))) ls)))))
            (gu-int-mem! z n)
            (dk-lam-b!)
            (dk-apply! (gu-seq-typ q n) z)
            (dk-if-branch! #f (list 'IF (list '= z sn) p (list q z)) (lambda () (dk-nn!)) (lambda () (rfl))))))
      
      (let ((e3 (dk-cite! 'prod-ring-congruence-q 's (gu-int n) qq q)))
        
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (begin
                  (ew sn)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (ass)
                          (begin
                            (ew qq)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (ass)
                                    (begin
                                      (subst ps1) (subst e2) (subst e3) (subst apd) (subst dq)
                                      (crs)))))))))))))))))

(define gu-exist-body
