;;; ======================================================================
(define (gu-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL s (IMPLIES (IS-EUCLIDEAN-DOMAIN s)
  (FORALL p (IMPLIES (IS-PRIME-ELEMENT s p) (FORALL q (IMPLIES (IS-PRIME-SEQ s q n)
    (IMPLIES (DIVIDES s p (PROD-RING s q (INTERVAL 1 n)))
      (FORSOME k (AND (IN k (INTERVAL 1 n)) (ASSOCIATED s p (q k)))))))))))))))
(ni)
