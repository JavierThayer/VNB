;;; cg2-compact.scm -- Corollary 5.9 of the compact-groups notes: in a COMPACT topological group,
;;; for an open V containing e with V = V^-1, the powers V^k stabilise: H = V^m for some m; when V
;;; is also connected, V^m is the connected component of e.  The notes' proof ("the sequence V^k is
;;; non-decreasing; by compactness of H it stabilises") is run on the whole space: the V^(k+1)
;;; together with the complement K of H (open, H being an open subgroup) cover it; a finite
;;; subcover, by induction on finite sets, lies in K and one V^m.
;;; Agent ISOM, 2026-10-26.  Helper prefix: cc2-.  Library: analysis.

(define (cc2-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cc2-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (cc2-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (cc2-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define cc2-E '(IDEN g))
(define cc2-H '(POWERS-UNION g V))
(define cc2-C '(CONNECTED-COMPONENT s (IDEN g)))
(define (cc2-pow k) (list 'SET-POWER 'g 'V k))
(define cc2-sym '(FORALL p (IMPLIES (IN p V) (IN ((INV g) p) V))))
(define (cc2-parts!)
  (dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
  (fact 'group-identity-in 'g))
(define (cc2-pts! t)
  (if (not (dk-asm? (list 'IN t '(PTS s))))
      (dk-rewrite-h! (list 'IN t '(CARR g)) '(CARR g) '(PTS s))))
(define (cc2-open-carr! W)
  (dk-cite! 'top-open-subset 's W)
  (if (not (dk-asm? (list 'SUBSET W '(CARR g))))
      (dk-rewrite-h! (list 'SUBSET W '(PTS s)) '(PTS s) '(CARR g))))
(define (cc2-pset! k) (dk-cite! 'set-power-is-set k 'g 'V))
(define (cc2-hset!) (dk-cite! 'powers-union-is-set 'g 'V))
(define (cc2-elim! z)
  (let ((k (dk-skolem! (dk-cite! 'powers-union-elim 'g 'V z))))
    (cc2-split-if! (lambda (h) (and (dk-contains? h k) (dk-contains? h z))))
    (cc2-pset! k)
    k))
(define (cc2-nn-add! a b)                ; a + b in NN
  (dk-meta-and! (list 'IN a 'NN) (list 'IN b 'NN))
  (dk-cite! 'nn-add-closed a b))

;;; ---- the lift (as in cg1-group.scm) ----
(define cc2-stmts '())
(define (cc2-keep! nm f) (set! cc2-stmts (cons (cons nm f) cc2-stmts)) f)
(define (cc2-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map cc2-subst e)) (#t e)))
(define (cc2-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt cc2-stmts)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (cc2-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))

;;; ---- V^k inside V^(k+d) when e is in V (induction on d) ----
(sp (make-wff '(FORALL d (IMPLIES (IN d NN) (FORALL g (FORALL V (FORALL k (IMPLIES (IS-GROUP g) (IMPLIES (SUBSET V (CARR g))
   (IMPLIES (IN (IDEN g) V) (IMPLIES (IN k NN) (SUBSET (SET-POWER g V k) (SET-POWER g V (+ k d))))))))))))))
(let* ((ind (dk-use-induction-fixed! '(g V))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1D: g, V fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'nn-add-zero 'k)
  (subst '(= (+ k 0) k))
  (cc2-pset! 'k)
  (mac 'subset-def)
  (dk-peel!)
  (cc2-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((kn (list '+ 'k n)) (skn (list 'succ kn)))
    (dk-cite! 'nn-add-succ 'k n)
    (subst (list '= (list '+ 'k (list 'succ n)) skn))
    (cc2-nn-add! 'k n)
    (dk-cite! 'nn-succ-closed kn)
    (cc2-pset! 'k) (cc2-pset! kn) (cc2-pset! skn)
    (dk-apply! ih 'k)   ; W1D: g, V fixed
    (mac 'subset-def)
    (let ((z (cc2-peel-var!)))
      (dk-cite! 'subset-mem-fwd (cc2-pow 'k) (cc2-pow kn) z)
      (dk-cite! 'set-power-mono-succ 'g 'V kn z)
      (cc2-ass!))))
(qed 'set-power-mono-add)
(topic! 'set-power-mono-add 'algebra)

;;; ---- V^(k+1) is open ----
(sp (make-wff '(FORALL s (FORALL g (IMPLIES (IS-GROUP-TOPOLOGY s g) (FORALL V (FORALL k (IMPLIES (IN V (OPENS s))
   (IMPLIES (IN k NN) (IN (SET-POWER g V (succ k)) (OPENS s)))))))))))
(dk-peel!)
(cc2-parts!)
(cc2-open-carr! 'V)
(cc2-pset! 'k)
(dk-cite! 'set-power-sub-carr 'k 'g 'V)
(dk-cite! 'set-prod-open 's 'g '(SET-POWER g V k) 'V)
(dk-cite! 'set-power-succ 'g 'V 'k)
(dk-rewrite-h! '(IN (SET-PROD g (SET-POWER g V k) V) (OPENS s)) '(SET-PROD g (SET-POWER g V k) V) '(SET-POWER g V (succ k)))
(cc2-ass!)
(qed 'set-power-succ-open)
(topic! 'set-power-succ-open 'analysis)

;;; ---- Corollary 5.9 ----
(define cc2-K '(SEP cz_ (PTS s) (NOT (IN cz_ (POWERS-UNION g V)))))
(define cc2-CV (list 'SEP 'cvu_ '(POWER (PTS s))
                 (list 'OR (list '= 'cvu_ cc2-K)
                       '(FORSOME cvk_ (AND (IN cvk_ NN) (= cvu_ (SET-POWER g V (succ cvk_))))))))
(define cc2-BU (list 'BIG-UNION 'U cc2-CV 'U))
(define (cc2-goodfor fs m)               ; every member of fs is K or inside V^m
  (list 'FORALL 'fu_ (list 'IMPLIES (list 'IN 'fu_ fs) (list 'OR (list '= 'fu_ cc2-K) (list 'SUBSET 'fu_ (cc2-pow m))))))
(define cc2-FC (list 'SEP 'fz_ 'SET (list 'IMPLIES (list 'SUBSET 'fz_ cc2-CV)
                 (list 'FORSOME 'fm_ (list 'AND '(IN fm_ NN) (cc2-goodfor 'fz_ 'fm_))))))
;; X inside PTS s and a set: X in POWER(PTS s)
(define (cc2-in-power! X)
  (dk-have! (list 'FORALL 'pz_ (list 'IMPLIES (list 'IN 'pz_ X) '(IN pz_ (PTS s))))
    (lambda () (let ((z (cc2-peel-var!))) (dk-cite! 'subset-mem-fwd X '(PTS s) z) (cc2-ass!))))
  (dk-cite! 'power-mem-intro '(PTS s) X))
;; U in CV: the two cases, by the OR landed by sep-me
(define (cc2-cv-cases! U on-k on-pow)
  (dk-landed (lambda () (sep-me (list 'IN U cc2-CV))))
  (use-em (list '= U cc2-K)
    on-k
    (lambda ()
      (let ((ex (list 'FORSOME 'cvk_ (list 'AND '(IN cvk_ NN) (list '= U '(SET-POWER g V (succ cvk_)))))))
        (dk-have! ex (lambda () (if (dk-only! (list 'OR (list '= U cc2-K) ex) (list 'NOT (list '= U cc2-K))) (prop))))
        (let ((k (dk-skolem! (dk-ctx-form ex))))
          (cc2-split-if! (lambda (h) (dk-contains? h k)))
          (on-pow k))))))

(sp (make-wff (cc2-keep! 'top-group-compact-powers-stabilize-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IMPLIES '(IS-COMPACT-T s)
   (list 'FORALL 'V (list 'IMPLIES '(IN V (OPENS s)) (list 'IMPLIES '(IN (IDEN g) V) (list 'IMPLIES cc2-sym
     '(FORSOME m (AND (IN m NN) (= (SET-POWER g V m) (POWERS-UNION g V)))))))))))))))
(dk-peel!)
(cc2-parts!)
(cc2-open-carr! 'V)
(cc2-hset!)
(cc2-pts! cc2-E)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-top-space 's))))
(dk-cite! 'power-set '(PTS s))
(dk-split-all! (list (dk-cite! 'top-group-powers-open-subgroup-gt 's 'g 'V)))
(dk-cite! 'top-group-open-subgroup-complement-open-gt 's 'g cc2-H)
(dk-cite! 'powers-union-sub-carr 'g 'V)
(dk-rewrite-h! (list 'SUBSET cc2-H '(CARR g)) '(CARR g) '(PTS s))
(dk-have! (list 'SUBSET cc2-K '(PTS s))
  (lambda () (mac 'subset-def) (let ((z (cc2-peel-var!))) (dk-landed (lambda () (sep-me (list 'IN z cc2-K)))) (cc2-ass!))))
(dk-cite! 'subclass-of-set-is-set cc2-K '(PTS s))
(cc2-in-power! cc2-K)
;; (i) the members of the cover are open
(dk-have! (list 'FORALL 'U (list 'IMPLIES (list 'IN 'U cc2-CV) '(IN U (OPENS s))))
  (lambda ()
    (let ((U (cc2-peel-var!)))
      (cc2-cv-cases! U
        (lambda () (subst (list '= U cc2-K)) (cc2-ass!))
        (lambda (k) (dk-cite! 'set-power-succ-open 's 'g 'V k)
                    (subst (list '= U (cc2-pow (list 'succ k))))
                    (cc2-ass!))))))
;; (ii) they cover the space
(dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x cc2-BU) '(IN x (PTS s))))
  (lambda ()
    (let ((x (begin (dk-peel!) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g0) (equal? (caddr g0) '(PTS s)))
        (lambda ()
          (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x cc2-BU)))))
                 (um (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cc2-CV))) landed)))
                 (U (cadr um)))
            (dk-landed (lambda () (sep-me um)))
            (dk-cite! 'power-mem-in '(PTS s) U x)
            (cc2-ass!)))
        (lambda ()
          (use-em (list 'IN x cc2-H)
            (lambda ()
              (let* ((k (cc2-elim! x)) (sk (list 'succ k)) (psk (cc2-pow sk)))
                (dk-cite! 'set-power-mono-succ 'g 'V k x)
                (dk-cite! 'nn-succ-closed k)
                (cc2-pset! sk)
                (dk-cite! 'set-power-sub-carr sk 'g 'V)
                (dk-rewrite-h! (list 'SUBSET psk '(CARR g)) '(CARR g) '(PTS s))
                (cc2-in-power! psk)
                (dk-have! (list 'IN psk cc2-CV)
                  (lambda () (in-sep! (lambda () (cc2-ass!))
                                      (lambda () (oi-r) (ew k) (dk-conj-close! cc2-ass-rfl!)))))
                (dk-each-leaf! (lambda () (bu-mi psk)) (lambda () (cc2-ass!)))))
            (lambda ()
              (dk-have! (list 'IN x cc2-K) (lambda () (in-sep! (lambda () (cc2-ass!)) (lambda () (cc2-ass!)))))
              (dk-have! (list 'IN cc2-K cc2-CV)
                (lambda () (in-sep! (lambda () (cc2-ass!)) (lambda () (oi-l) (cc2-ass-rfl!)))))
              (dk-each-leaf! (lambda () (bu-mi cc2-K)) (lambda () (cc2-ass!))))))))))
(dk-cite! 'class-extensionality cc2-BU '(PTS s))
(dk-have! (list '== cc2-BU '(PTS s)) (lambda () (subst (list '= cc2-BU '(PTS s))) (qrfl)))
;; (iii) a finite subcover F
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-compact-t 's))))
(define cc2-F
  (dk-skolem! (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'C))) "compactness") cc2-CV)))
(cc2-split-if! (lambda (h) (dk-contains? h cc2-F)))
;; (iv) a finite subfamily of the cover lies in K and one V^m: induction on finite sets
(define (cc2-union-in! z A B left?)      ; z in A (left?) or in B: z in UNION(A, B)
  (let ((iff (dk-cite! 'union-membership A B z)))
    (dk-have! (caddr iff) (lambda () (if left? (oi-l) (oi-r)) (cc2-ass!)))
    (dk-meta-iff-l! iff)))
(define cc2-ind
  (let ((ind0 (lookup-theorem 'finite-set-induction)))
    (subst-free (quantifier-var ind0) cc2-FC (quantifier-body ind0))))
(define cc2-hbase (cadr (cadr cc2-ind)))
(define cc2-hstep (caddr (cadr cc2-ind)))
(dk-have! cc2-hbase
  (lambda ()
    (in-sep! (lambda () (fact 'empty-set-is-set) (cc2-ass!))
             (lambda ()
               (di)
               (fact 'nn-zero-in)
               (ew 0)
               (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let ((u (cc2-peel-var!))) (ai (dk-cite! 'empty-set-has-no-members u)))
                      (cc2-ass!))))))))
(dk-have! cc2-hstep
  (lambda ()
    (dk-split-all! (filter (lambda (f) (dk-head-is? f 'AND)) (dk-peel!)))
    (let* ((gl (dk-goal)) (u (cadr gl)) (s0 (cadr u)) (pxx (caddr u)) (x0 (cadr pxx))
           (ih (begin (dk-landed (lambda () (sep-me (list 'IN s0 cc2-FC))))
                      (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list 'SUBSET s0 cc2-CV))))
                               "the class property of the smaller family"))))
      (in-sep!
        (lambda ()
          (dk-meta-and! (list 'IN x0 'SET) (list 'IN x0 'SET))
          (dk-cite! 'pairing x0 x0)
          (dk-meta-and! (list 'IN s0 'SET) (list 'IN pxx 'SET))
          (dk-cite! 'union-set-closure s0 pxx)
          (cc2-ass!))
        (lambda ()
          (di)
          (dk-cite! 'pair-self-member x0)
          (cc2-union-in! x0 s0 pxx #f)
          (dk-have! (list 'SUBSET s0 cc2-CV)
            (lambda () (mac 'subset-def)
                       (let ((z (cc2-peel-var!)))
                         (cc2-union-in! z s0 pxx #t)
                         (dk-cite! 'subset-mem-fwd u cc2-CV z)
                         (cc2-ass!))))
          (detach! ih)
          (let ((m (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h s0))) "the bound of the smaller family"))))
            (cc2-split-if! (lambda (h) (dk-contains? h m)))
            (dk-cite! 'subset-mem-fwd u cc2-CV x0)
            (let ((gm (dk-ctx-form (cc2-goodfor s0 m)))
                  (w-parts! (lambda (w)  ; w in u: (IN w s0) or w = x0
                              (dk-meta-iff-r! (dk-cite! 'union-membership s0 pxx w)))))
              (cc2-cv-cases! x0
                (lambda ()
                  (ew m)
                  (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) 'FORALL)
                         (let ((w (cc2-peel-var!)))
                           (w-parts! w)
                           (use-em (list 'IN w s0)
                             (lambda () (dk-apply! gm w) (cc2-ass!))
                             (lambda ()
                               (dk-have! (list 'IN w pxx) (lambda () (if (dk-only! (list 'OR (list 'IN w s0) (list 'IN w pxx)) (list 'NOT (list 'IN w s0))) (prop))))
                               (dk-cite! 'pair-self-eq x0 w)
                               (subst (list '= w x0))
                               (oi-l) (cc2-ass!))))
                         (cc2-ass!)))))
                (lambda (k)
                  (let* ((sk (list 'succ k)) (mm (list '+ m sk)) (km (list '+ sk m)))
                    (dk-cite! 'nn-succ-closed k)
                    (cc2-nn-add! m sk)
                    (cc2-nn-add! sk m)
                    (dk-cite! 'nn-add-comm sk m)
                    (cc2-pset! m) (cc2-pset! sk) (cc2-pset! mm) (cc2-pset! km)
                    (dk-cite! 'set-power-mono-add sk 'g 'V m)
                    (dk-cite! 'set-power-mono-add m 'g 'V sk)
                    (dk-rewrite-h! (list 'SUBSET (cc2-pow sk) (cc2-pow km)) km mm)
                    (ew mm)
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'FORALL)
                           (let ((w (cc2-peel-var!)))
                             (w-parts! w)
                             (use-em (list 'IN w s0)
                               (lambda ()
                                 (dk-apply! gm w)
                                 (use-em (list '= w cc2-K)
                                   (lambda () (oi-l) (cc2-ass!))
                                   (lambda ()
                                     (dk-have! (list 'SUBSET w (cc2-pow m))
                                       (lambda () (if (dk-only! (list 'OR (list '= w cc2-K) (list 'SUBSET w (cc2-pow m))) (list 'NOT (list '= w cc2-K))) (prop))))
                                     (dk-cite! 'subset-trans w (cc2-pow m) (cc2-pow mm))
                                     (oi-r) (cc2-ass!))))
                               (lambda ()
                                 (dk-have! (list 'IN w pxx) (lambda () (if (dk-only! (list 'OR (list 'IN w s0) (list 'IN w pxx)) (list 'NOT (list 'IN w s0))) (prop))))
                                 (dk-cite! 'pair-self-eq x0 w)
                                 (subst (list '= w x0))
                                 (oi-r)
                                 (subst (list '= x0 (cc2-pow sk)))
                                 (cc2-ass!))))
                           (cc2-ass!))))))))))))))
(dk-meta-and! cc2-hbase cc2-hstep)
(define cc2-concl (dk-cite! 'finite-set-induction cc2-FC))
;; F is a finite set inside CV
(dk-have! (list 'SUBSET cc2-CV '(POWER (PTS s)))
  (lambda () (mac 'subset-def) (let ((z (cc2-peel-var!))) (dk-landed (lambda () (sep-me (list 'IN z cc2-CV)))) (cc2-ass!))))
(dk-cite! 'subset-trans cc2-F cc2-CV '(POWER (PTS s)))
(dk-cite! 'subclass-of-set-is-set cc2-F '(POWER (PTS s)))
(dk-meta-and! (list 'IN cc2-F 'SET) (list 'IN (list 'CARD cc2-F) 'NN))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cc2-FC) (not (dk-contains? h 'EMPTY-SET)))) "the induction conclusion") cc2-F)
(dk-landed (lambda () (sep-me (list 'IN cc2-F cc2-FC))))
(detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) (list 'SUBSET cc2-F cc2-CV)))) "the property of F"))
(define cc2-m (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h cc2-F))) "the bound for F")))
(cc2-split-if! (lambda (h) (dk-contains? h cc2-m)))
;; (v) V^m = H
(cc2-pset! cc2-m)
(define cc2-FB (list 'BIG-UNION 'U cc2-F 'U))
(dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x (cc2-pow cc2-m)) (list 'IN 'x cc2-H)))
  (lambda ()
    (let ((x (begin (dk-peel!) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g0) (equal? (caddr g0) cc2-H))
        (lambda () (dk-cite! 'powers-union-intro 'g 'V cc2-m x) (cc2-ass!))
        (lambda ()
          (dk-cite! 'subset-mem-fwd cc2-H '(PTS s) x)
          (dk-have! (list 'IN x cc2-FB) (lambda () (subst (list '= cc2-FB '(PTS s))) (cc2-ass!)))
          (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x cc2-FB)))))
                 (um (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cc2-F))) landed)))
                 (U (cadr um)))
            (dk-apply! (dk-ctx-form (cc2-goodfor cc2-F cc2-m)) U)
            (use-em (list '= U cc2-K)
              (lambda ()
                (dk-rewrite-h! (list 'IN x U) U cc2-K)
                (dk-landed (lambda () (sep-me (list 'IN x cc2-K))))
                (ai (list 'NOT (list 'IN x cc2-H))))
              (lambda ()
                (dk-have! (list 'SUBSET U (cc2-pow cc2-m))
                  (lambda () (if (dk-only! (list 'OR (list '= U cc2-K) (list 'SUBSET U (cc2-pow cc2-m))) (list 'NOT (list '= U cc2-K))) (prop))))
                (dk-cite! 'subset-mem-fwd U (cc2-pow cc2-m) x)
                (cc2-ass!)))))))))
(dk-cite! 'class-extensionality (cc2-pow cc2-m) cc2-H)
(ew cc2-m)
(dk-conj-close! (lambda () (cc2-ass!)))
(qed 'top-group-compact-powers-stabilize-gt)
(topic! 'top-group-compact-powers-stabilize-gt 'analysis)
(cc2-lift! 'top-group-compact-powers-stabilize-gt 'top-group-compact-powers-stabilize)

;;; ---- with V connected: V^m is the connected component of e ----
(sp (make-wff (cc2-keep! 'top-group-compact-component-power-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IMPLIES '(IS-COMPACT-T s)
   (list 'FORALL 'V (list 'IMPLIES '(IN V (OPENS s)) (list 'IMPLIES '(IN (IDEN g) V) (list 'IMPLIES cc2-sym
     (list 'IMPLIES '(IS-CONNECTED-T s V)
       (list 'FORSOME 'm (list 'AND '(IN m NN) (list '= '(SET-POWER g V m) cc2-C)))))))))))))))
(dk-peel!)
(cc2-hset!)
(let ((m (dk-skolem! (dk-cite! 'top-group-compact-powers-stabilize-gt 's 'g 'V))))
  (cc2-split-if! (lambda (h) (dk-contains? h m)))
  (dk-split-all! (list (dk-cite! 'top-group-powers-component-gt 's 'g 'V)))
  (ew m)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= cc2-C cc2-H)) (cc2-ass!))))))
(qed 'top-group-compact-component-power-gt)
(topic! 'top-group-compact-component-power-gt 'analysis)
(cc2-lift! 'top-group-compact-component-power-gt 'top-group-compact-component-power)
