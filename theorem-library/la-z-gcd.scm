;;; la-z-gcd.scm -- the gcd of the s-th order subdeterminants is invariant under
;;; integral elementary operations (linear algebra 3.31) (LA-Z, 2026-10-19).
;;;
;;; Vocabulary: structure-library/la-z-vocab.scm (SDET, ELEM-EQUIV, ZZ-IS-GCD-SET);
;;; ELEM-GEN and IS-ELEMENTARY: structure-library/la-elem-vocab.scm.
;;; Prefix lzg-.
;;;
;;; PLAN.  The notes: "Every element of sdet_k B is in the ideal generated by sdet_k A.
;;; Thus the GCD of the set sdet_k A divides every element of sdet_k B ... Since row and
;;; column operations are invertible, [3.31] follows."  Over any commutative ring: if c
;;; divides every element of SDET(A), it divides every element of SDET(A E) and of
;;; SDET(E A) for E elementary (from 3.29 and its H companions, la-z-sdet); by the
;;; minimal-set induction over ELEM-GEN (elem-gen-induction, la-elem-gen) the same holds
;;; for A Q and P A with P, Q in ELEM-GEN, hence for ELEM-EQUIV.  ELEM-EQUIV is
;;; symmetric (elem-gen-inverse).  Over ZZ-RING the ring divisibility is ZZ-DIVIDES; two
;;; integers that divide each other are equal up to sign (zz-divides-antisym).
;;;
;;; LOAD WINDOW: after "theorem-library/la-z-sdet" and "theorem-library/la-elem-gen"
;;; (unwired; elementary-type, elem-gen-induction, elem-gen-inverse, elem-gen-mat); latest
;;; wired citation matmul-assoc (load.scm:1985).  Nothing cites the file.
;;; Library: linear-algebra.

(define (lzg-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z-gcd: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))
(define (lzg-typ! t cls)
  (if (not (dk-asm? (list 'IN t cls)))
      (if (and (equal? cls '(CARR R)) (pair? t) (equal? (car t) '(ADD R)))
          (begin (lzg-typ! (cadr t) cls) (lzg-typ! (caddr t) cls)
                 (fact 'ring-add-closed 'R (cadr t) (caddr t)))
          (dk-have! (list 'IN t cls) dk-typ-close!))))
(define (lzg-mm a b) (list 'MATMUL 'R a b))
(define (lzg-sdet a) (list 'SDET 'R 'm 'n a 's))
;; c divides (in R) every element of the set S
(define (lzg-div c S)
  (list 'FORALL 'dvx_ (list 'IMPLIES (list 'IN 'dvx_ S)
    (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR R)) (list '= 'dvx_ (list '(MUL R) c 'dvy_)))))))
;; skolemise a (possibly nested) existential in context; return its witnesses in order
(define (lzg-skolem-all! ex)
  (let loop ((ex ex) (acc '()))
    (let* ((v #f)
           (landed (dk-landed (lambda () (set! v (dk-skolem! ex)))))
           (nxt (find-first (dk-head? 'FORSOME) landed)))
      (if nxt (loop nxt (append acc (list v))) (append acc (list v))))))
(define (lzg-contra! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))

;; the case analysis on IS-ELEMENTARY(R, SZ, E) (la-elem-gen's laeg-elem-cases!, with
;; the size a parameter): the thunks get the witnesses (k l), (r k l), (r k s)
(define (lzg-elem-cases! sz e f-thunk g-thunk h-thunk)
  (let* ((hyp (list 'IS-ELEMENTARY 'R sz e))
         (ignore (fact 'IS-ELEMENTARY 'R sz e))
         (iff (iff-for hyp))
         (disj (caddr iff))
         (d1 (cadr disj)) (d2 (cadr (caddr disj))) (d3 (caddr (caddr disj))))
    (dk-have! disj (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (use-cases disj
      (lambda () (f-thunk (lzg-skolem-all! (dk-ctx-form d1))))
      (lambda () (g-thunk (lzg-skolem-all! (dk-ctx-form d2))))
      (lambda () (h-thunk (lzg-skolem-all! (dk-ctx-form d3)))))))

;;; =====================================================================
;;; (1) Ring rearrangements, by crs.
;;; =====================================================================
(define (lzg-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
(define (lzg-ring-lemma! name vs eq)
  (sp (make-wff (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
                  (forall-guarded vs (lzg-carr-guards vs) eq)))))
  (dk-peel!)
  (crs)
  (lzg-done! name)
  (topic! name 'plumbing))
;; c y1 + t (c y2) = c (y1 + t y2)
(lzg-ring-lemma! 'lzg-ring-g '(lgc_ lgy_ lgt_ lgz_)
  '(= ((ADD R) ((MUL R) lgc_ lgy_) ((MUL R) lgt_ ((MUL R) lgc_ lgz_)))
      ((MUL R) lgc_ ((ADD R) lgy_ ((MUL R) lgt_ lgz_)))))
;; t (c y) = c (t y)
(lzg-ring-lemma! 'lzg-ring-h '(lgc_ lgy_ lgt_)
  '(= ((MUL R) lgt_ ((MUL R) lgc_ lgy_)) ((MUL R) lgc_ ((MUL R) lgt_ lgy_))))

;;; =====================================================================
;;; (2) One elementary operation keeps every common divisor of the subdeterminants.
;;; =====================================================================
;; ROW? #f: A E with E n-by-n (a column operation); #t: E A with E m-by-m
(define (lzg-step! row?)
  (let* ((sz (if row? 'm 'n))
         (ae (if row? (lzg-mm 'E 'A) (lzg-mm 'A 'E)))
         (landed (dk-peel!))
         (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SDET)
                                           (equal? (caddr f) (lzg-sdet ae))))
                          landed))
         (x (cadr mem))
         (div (lzg-div 'c (lzg-sdet 'A))))
    (fact 'commutative-ring-is-ring 'R)
    (fact 'elementary-type 'R sz 'E)
    (lzg-elem-cases! sz 'E
      (lambda (ws)
        (let* ((k (car ws)) (l (cadr ws)) (f (list 'ELEM-F 'R sz k l)))
          (dk-rewrite-h! mem 'E f)
          (fact (if row? 'sdet-row-swap-sub 'sdet-col-swap-sub) 'R 'm 'n 's 'A k l x)
          (dk-apply! div x)
          (ass)))
      (lambda (ws)
        (let* ((r (car ws)) (k (cadr ws)) (l (caddr ws)) (g (list 'ELEM-G 'R sz r k l)))
          (dk-rewrite-h! mem 'E g)
          (let* ((abt (lzg-skolem-all! (dk-fact! (if row? 'sdet-row-add 'sdet-col-add) 'R 'm 'n 's 'A r k l x)))
                 (a (car abt)) (b (cadr abt)) (t (caddr abt))
                 (y1 (car (lzg-skolem-all! (dk-apply! div a))))
                 (y2 (car (lzg-skolem-all! (dk-apply! div b))))
                 (w (list '(ADD R) y1 (list '(MUL R) t y2))))
            (lzg-typ! w '(CARR R))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (begin
                      (subst (list '= x (list '(ADD R) a (list '(MUL R) t b))))
                      (subst (list '= a (list '(MUL R) 'c y1)))
                      (subst (list '= b (list '(MUL R) 'c y2)))
                      (fact 'lzg-ring-g 'R 'c y1 t y2)
                      (ass))))))))
      (lambda (ws)
        (let* ((r (car ws)) (k (cadr ws)) (h (list 'ELEM-H 'R sz r k)))
          (dk-rewrite-h! mem 'E h)
          (let* ((a (car (lzg-skolem-all! (dk-fact! (if row? 'sdet-row-scale 'sdet-col-scale) 'R 'm 'n 's 'A r k x))))
                 (y (car (lzg-skolem-all! (dk-apply! div a))))
                 (disj (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f a) (dk-contains? f x))) (dk-asms))))
            (use-cases disj
              (lambda ()
                (ew y)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN) (ass)
                        (begin (subst (list '= x a)) (subst (list '= a (list '(MUL R) 'c y)))
                               (lzg-typ! (list '(MUL R) 'c y) '(CARR R)) (rfl))))))
              (lambda ()
                (let ((w (list '(MUL R) r y)))
                  (lzg-typ! w '(CARR R))
                  (ew w)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN) (ass)
                          (begin (subst (list '= x (list '(MUL R) r a)))
                                 (subst (list '= a (list '(MUL R) 'c y)))
                                 (fact 'lzg-ring-h 'R 'c y r)
                                 (ass))))))))))))))

(define lzg-step-guards
  (list '(IS-COMMUTATIVE-RING R) '(IN m NN) '(IN n NN) '(IN s NN) '(IN A (MAT m n (CARR R)))
        '(IN c (CARR R)) (lzg-div 'c (lzg-sdet 'A))))
(sp (make-wff (forall-guarded '(R m n s A c E) (append lzg-step-guards '((IS-ELEMENTARY R n E)))
                (lzg-div 'c (lzg-sdet (lzg-mm 'A 'E))))))
(lzg-step! #f)
(lzg-done! 'sdet-divisor-col-step)
(topic! 'sdet-divisor-col-step 'algebra)
(gloss! 'sdet-divisor-col-step "A common divisor of the order-s subdeterminants of A divides those of A E, E an elementary matrix.")

(sp (make-wff (forall-guarded '(R m n s A c E) (append lzg-step-guards '((IS-ELEMENTARY R m E)))
                (lzg-div 'c (lzg-sdet (lzg-mm 'E 'A))))))
(lzg-step! #t)
(lzg-done! 'sdet-divisor-row-step)
(topic! 'sdet-divisor-row-step 'algebra)
(gloss! 'sdet-divisor-row-step "A common divisor of the order-s subdeterminants of A divides those of E A, E an elementary matrix.")

;;; =====================================================================
;;; (3) Products of elementary matrices: the minimal-set induction over ELEM-GEN.
;;; =====================================================================
;; detach every antecedent of the chain INST, proving each one not in context with
;; (PROVER ANTE) on its own lane; returns the consequent as it landed
(define (lzg-detach-all! inst prover)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (lambda () (prover a))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f)) (dk-landed-1 (lambda () (detach! f))))))
        f)))
;; (P Q) X = P (Q X) at the sizes D1..D4, the size guards (tautologies at these sizes)
;; by prop; returns the equation
(define (lzg-assoc! d1 d2 d3 d4 p q x)
  (lzg-detach-all! (dk-cite! 'matmul-assoc 'R d1 d2 d3 d4 p q x) (lambda (a) (prop))))
;; peel the implications of the goal down to the first non-implication
(define (lzg-peel-guards!)
  (di)
  (let loop () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (loop)))))

;; the minimal-set induction (la-elem-gen's laeg-induct!, the size a parameter): BODY
;; mentions egq_; IDENT-THUNK proves BODY[I], STEP-THUNK (called with X, E) proves
;; BODY[X E] from BODY[X] and IS-ELEMENTARY(R, SZ, E); then BODY[P] lands
(define (lzg-induct! sz body p ident-thunk step-thunk)
  (let* ((mt (list 'MAT sz sz '(CARR R)))
         (id (list 'IDENTMAT 'R sz))
         (S (list 'SEP 'egq_ mt body))
         (cl (list 'FORALL 'egy_ (list 'IMPLIES (list 'IN 'egy_ S)
               (list 'FORALL 'egf_ (list 'IMPLIES (list 'IS-ELEMENTARY 'R sz 'egf_)
                 (list 'IN '(MATMUL R egy_ egf_) S)))))))
    (lzg-typ! id mt)
    (dk-have! (list 'IN id S) (lambda () (in-sep! (lambda () (ass)) ident-thunk)))
    (dk-have! cl
      (lambda ()
        (let* ((l3 (dk-peel!))
               (xm (find-first (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) S))) l3))
               (ef (find-first (dk-head? 'IS-ELEMENTARY) l3))
               (x (cadr xm)) (e (cadddr ef)))
          (sep-me xm)
          (fact 'elementary-type 'R sz e)
          (lzg-typ! (lzg-mm x e) mt)
          (in-sep! (lambda () (ass)) (lambda () (step-thunk x e))))))
    (let ((all (dk-fact! 'elem-gen-induction 'R sz S)))
      (dk-apply! all p)
      (sep-me (list 'IN p S)))))

(define (lzg-colbody q)
  (list 'FORALL 'gca_ (list 'IMPLIES '(IN gca_ (MAT m n (CARR R)))
    (list 'IMPLIES (lzg-div 'c (lzg-sdet 'gca_)) (lzg-div 'c (lzg-sdet (lzg-mm 'gca_ q)))))))
(define (lzg-rowbody p)
  (list 'FORALL 'gca_ (list 'IMPLIES '(IN gca_ (MAT m n (CARR R)))
    (list 'IMPLIES (lzg-div 'c (lzg-sdet 'gca_)) (lzg-div 'c (lzg-sdet (lzg-mm p 'gca_)))))))
(define lzg-gen-guards '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN s NN) (IN c (CARR R))))
;; open BODY's universal on the focus goal: return (A' x), with A' typed, the divisor
;; hypothesis on A' and x in the target SDET landed
(define (lzg-open-body!)
  (let* ((landed (dk-peel!))
         (am (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(MAT m n (CARR R))))) landed))
         (xm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SDET))) landed)))
    (list (cadr am) (cadr xm) xm)))

(sp (make-wff (forall-guarded '(R m n s c Q) (append lzg-gen-guards '((IN Q (ELEM-GEN R n))))
                (lzg-colbody 'Q))))
(lzg-peel-guards!)
(fact 'commutative-ring-is-ring 'R)
(lzg-induct! 'n (lzg-colbody 'egq_) 'Q
  (lambda ()
    (let* ((ax (lzg-open-body!)) (a1 (car ax)) (x (cadr ax)) (xm (caddr ax)))
      (fact 'identmat-right-identity 'R 'm 'n a1)
      (dk-rewrite-h! xm (lzg-mm a1 '(IDENTMAT R n)) a1)
      (dk-apply! (lzg-div 'c (lzg-sdet a1)) x)
      (ass)))
  (lambda (xq e)
    (let* ((ax (lzg-open-body!)) (a1 (car ax)) (x (cadr ax)) (xm (caddr ax))
           (a1x (lzg-mm a1 xq)))
      (lzg-typ! a1x '(MAT m n (CARR R)))
      (let ((eq (lzg-assoc! 'm 'n 'n 'n a1 xq e)))
        (dk-rewrite-h! xm (lzg-mm a1 (lzg-mm xq e)) (lzg-mm a1x e)))
      (dk-apply! (lzg-colbody xq) a1)
      (fact 'sdet-divisor-col-step 'R 'm 'n 's a1x 'c e)
      (dk-apply! (lzg-div 'c (lzg-sdet (lzg-mm a1x e))) x)
      (ass))))
(ass)
(lzg-done! 'sdet-divisor-col-gen)
(topic! 'sdet-divisor-col-gen 'algebra)
(gloss! 'sdet-divisor-col-gen "A common divisor of the order-s subdeterminants of A divides those of A Q, Q a product of elementary matrices.")

(sp (make-wff (forall-guarded '(R m n s c P) (append lzg-gen-guards '((IN P (ELEM-GEN R m))))
                (lzg-rowbody 'P))))
(lzg-peel-guards!)
(fact 'commutative-ring-is-ring 'R)
(lzg-induct! 'm (lzg-rowbody 'egq_) 'P
  (lambda ()
    (let* ((ax (lzg-open-body!)) (a1 (car ax)) (x (cadr ax)) (xm (caddr ax)))
      (fact 'identmat-left-identity 'R 'm 'n a1)
      (dk-rewrite-h! xm (lzg-mm '(IDENTMAT R m) a1) a1)
      (dk-apply! (lzg-div 'c (lzg-sdet a1)) x)
      (ass)))
  (lambda (xp e)
    (let* ((ax (lzg-open-body!)) (a1 (car ax)) (x (cadr ax)) (xm (caddr ax))
           (ea1 (lzg-mm e a1)))
      (lzg-typ! ea1 '(MAT m n (CARR R)))
      (let ((eq (lzg-assoc! 'm 'm 'm 'n xp e a1)))
        (dk-rewrite-h! xm (lzg-mm (lzg-mm xp e) a1) (lzg-mm xp ea1)))
      (fact 'sdet-divisor-row-step 'R 'm 'n 's a1 'c e)
      (dk-apply! (lzg-rowbody xp) ea1)
      (dk-apply! (lzg-div 'c (lzg-sdet (lzg-mm xp ea1))) x)
      (ass))))
(ass)
(lzg-done! 'sdet-divisor-row-gen)
(topic! 'sdet-divisor-row-gen 'algebra)
(gloss! 'sdet-divisor-row-gen "A common divisor of the order-s subdeterminants of A divides those of P A, P a product of elementary matrices.")

;;; =====================================================================
;;; (4) Equivalence by elementary operations.
;;; =====================================================================
(define (lzg-ee a b) (list 'ELEM-EQUIV 'R 'm 'n a b))
;; open ELEM-EQUIV(A, B) in context (it survives): return (P Q) with the memberships and
;; (= B (MATMUL R (MATMUL R P A) Q)) landed
(define (lzg-ee-open! a b)
  (let* ((iff (dk-fact! 'ELEM-EQUIV 'R 'm 'n a b))
         (iff2 (iff-for (lzg-ee a b)))
         (rhs (caddr iff2)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff2 (lzg-ee a b)) (dk-lane-if! prop))))
    (let* ((pv (dk-skolem! (dk-ctx-form rhs) #f))
           (e2 (find-first (lambda (f) (and (eq? (car f) 'FORSOME) (dk-contains? f pv))) (dk-asms)))
           (qv (dk-skolem! e2 #t)))
      (let loop ()
        (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f qv))) (dk-asms))))
          (if cj (begin (dk-split! cj) (loop)))))
      (list pv qv))))

(sp (make-wff (forall-guarded '(R m n s c A B)
                (append lzg-gen-guards
                  (list '(IN A (MAT m n (CARR R))) (lzg-ee 'A 'B) (lzg-div 'c (lzg-sdet 'A))))
                (lzg-div 'c (lzg-sdet 'B)))))
(lzg-peel-guards!)
(fact 'commutative-ring-is-ring 'R)
(let* ((pq (lzg-ee-open! 'A 'B)) (p (car pq)) (q (cadr pq)) (pa (lzg-mm p 'A)))
  (fact 'elem-gen-mat 'R 'm p)
  (fact 'elem-gen-mat 'R 'n q)
  (lzg-typ! pa '(MAT m n (CARR R)))
  (fact 'sdet-divisor-row-gen 'R 'm 'n 's 'c p)
  (dk-apply! (lzg-rowbody p) 'A)
  (fact 'sdet-divisor-col-gen 'R 'm 'n 's 'c q)
  (dk-apply! (lzg-colbody q) pa)
  (subst (list '= 'B (lzg-mm pa q)))
  (ass))
(lzg-done! 'sdet-divisor-equiv)
(topic! 'sdet-divisor-equiv 'algebra)
(gloss! 'sdet-divisor-equiv "A common divisor of the order-s subdeterminants of A divides those of every matrix obtained from A by elementary row and column operations.")

(sp (make-wff (forall-guarded '(R m n A B)
                (list '(IS-RING R) '(IN m NN) '(IN n NN) '(IN A (MAT m n (CARR R))) (lzg-ee 'A 'B))
                (lzg-ee 'B 'A))))
(lzg-peel-guards!)
(let* ((pq (lzg-ee-open! 'A 'B)) (p (car pq)) (q (cadr pq))
       (pa (lzg-mm p 'A)) (aq (lzg-mm 'A q)))
  (fact 'elem-gen-mat 'R 'm p)
  (fact 'elem-gen-mat 'R 'n q)
  (lzg-typ! pa '(MAT m n (CARR R)))
  (lzg-typ! aq '(MAT m n (CARR R)))
  (let* ((pv (dk-skolem! (dk-fact! 'elem-gen-inverse 'R 'm p) #t))
         (qv (dk-skolem! (dk-fact! 'elem-gen-inverse 'R 'n q) #t)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (or (dk-contains? f pv) (dk-contains? f qv)))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    (fact 'elem-gen-mat 'R 'm pv)
    (fact 'elem-gen-mat 'R 'n qv)
    (fact 'identmat-left-identity 'R 'm 'n 'A)
    (fact 'identmat-right-identity 'R 'm 'n 'A)
    (let* ((e1 (lzg-assoc! 'm 'm 'n 'n pv pa q))
           (e2 (lzg-assoc! 'm 'm 'm 'n pv p 'A))
           (e3 (lzg-assoc! 'm 'n 'n 'n 'A q qv)))
      (mac 'ELEM-EQUIV)
      (ew pv)
      (ew qv)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (ass)
              (begin
                ;; A = (P' B) Q' with B = (P A) Q
                (subst (list '= 'B (lzg-mm pa q)))
                (subst (list '= (lzg-mm pv (lzg-mm pa q)) (lzg-mm (lzg-mm pv pa) q)))
                (subst (list '= (lzg-mm pv pa) (lzg-mm (lzg-mm pv p) 'A)))
                (subst (list '= (lzg-mm pv p) '(IDENTMAT R m)))
                (subst (list '= (lzg-mm '(IDENTMAT R m) 'A) 'A))
                (subst (list '= (lzg-mm aq qv) (lzg-mm 'A (lzg-mm q qv))))
                (subst (list '= (lzg-mm q qv) '(IDENTMAT R n)))
                (subst (list '= (lzg-mm 'A '(IDENTMAT R n)) 'A))
                (rfl))))))))
(lzg-done! 'elem-equiv-symmetric)
(topic! 'elem-equiv-symmetric 'algebra)
(gloss! 'elem-equiv-symmetric "Equivalence by elementary operations is symmetric: elementary products have elementary inverses.")

;;; =====================================================================
;;; (5) Integers: two integers that divide each other agree up to sign.
;;; =====================================================================
(sp (make-wff (forall-guarded '(u v) '((IN u ZZ) (IN v ZZ) (= (* u v) 1))
                '(OR (= u 1) (= u (- 1))))))
(dk-peel!)
(fact 'zz-in-rr 'u) (fact 'zz-in-rr 'v)
(fact 'zz-abs-in-nn 'u) (fact 'zz-abs-in-nn 'v)
(fact 'nn-in-rr '(abs u)) (fact 'nn-in-rr '(abs v))
(fact 'rr-abs-nonneg 'u) (fact 'rr-abs-nonneg 'v)
(fact 'rr-one-in) (fact 'nn-one-in)
(dk-have! '(AND (IN u RR) (IN v RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'rr-abs-mult 'u 'v)
(dk-have! '(= (* (abs u) (abs v)) 1)
  (lambda ()
    (subst '(= (* (abs u) (abs v)) (abs (* u v))))
    (subst '(= (* u v) 1))
    (arith)))
(dk-have! '(NOT (= (abs v) 0))
  (lambda ()
    (di)
    (dk-have! '(= (* (abs u) 0) 1) (lambda () (subst '(= 0 (abs v))) (ass)))
    (dk-absurd! '(= (* (abs u) 0) 1))))
(dk-have! '(NOT (= (abs u) 0))
  (lambda ()
    (di)
    (dk-have! '(= (* 0 (abs v)) 1) (lambda () (subst '(= 0 (abs u))) (ass)))
    (dk-absurd! '(= (* 0 (abs v)) 1))))
(dk-one-le! '(abs v))
(dk-one-le! '(abs u))
(let ((le (dk-cite! 'rr-le-scale-nonneg-right 1 '(abs v) '(abs u))))
  (dk-have! '(= (* (abs v) (abs u)) (* (abs u) (abs v))) (lambda () (crs)))
  (dk-have! '(= (* (abs v) (abs u)) 1)
    (lambda () (subst '(= (* (abs v) (abs u)) (* (abs u) (abs v)))) (ass)))
  (let ((le2 (dk-rewrite-h! le '(* (abs v) (abs u)) 1)))
    (dk-have! '(<= (abs u) 1) (lambda () (dk-ineq! le2)))))
(fact 'nn-le-antisym '(abs u) 1)
(let ((d (dk-cite! 'zz-abs-cases 'u)))
  (use-cases d
    (lambda () (oi-l) (subst '(= u (abs u))) (ass))
    (lambda () (oi-r) (subst '(= u (- (abs u)))) (subst '(= (abs u) 1)) (rfl))))
(lzg-done! 'zz-mul-eq-one)
(topic! 'zz-mul-eq-one 'algebra)
(gloss! 'zz-mul-eq-one "The units of Z are 1 and -1: if u v = 1 for integers u, v then u = 1 or u = -1.")

;; open ZZ-DIVIDES(D, X) in context (it survives): return the cofactor c with
;; (IN c ZZ) and (= X (* D c)) landed
(define (lzg-zzdiv-open! d x)
  (let* ((hyp (list 'ZZ-DIVIDES d x))
         (ignore (fact 'zz-divides d x))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let* ((parts (dk-split! (dk-ctx-form rhs)))
           (more (append-map (lambda (f) (if (dk-head-is? f 'AND) (dk-split! f) (list f))) parts))
           (ex (find-first (dk-head? 'FORSOME) more)))
      (dk-skolem! ex #t))))

(sp (make-wff (forall-guarded '(a b) '((ZZ-DIVIDES a b) (ZZ-DIVIDES b a))
                '(OR (= a b) (= a (- b))))))
(dk-peel!)
(let* ((c1 (lzg-zzdiv-open! 'a 'b))
       (c2 (lzg-zzdiv-open! 'b 'a)))
  (fact 'zz-in-rr 'a) (fact 'zz-in-rr 'b) (fact 'zz-in-rr c1) (fact 'zz-in-rr c2)
  (use-em '(= a 0)
    (lambda ()
      (oi-l)
      (subst (list '= 'b (list '* 'a c1)))
      (subst '(= a 0))
      (crs))
    (lambda ()
      (let* ((h2 (dk-rewrite-h! (list '= 'a (list '* 'b c2)) 'b (list '* 'a c1)))
             (k (list '- (list '* c1 c2) 1))
             (aa (list '* (list '* 'a c1) c2)))
        (dk-have! (list '= (list '* k 'a) 0)
          (lambda ()
            (dk-have! (list '= (list '* k 'a) (list '- aa 'a)) (lambda () (crs)))
            (subst (list '= (list '* k 'a) (list '- aa 'a)))
            (subst (list '= aa 'a))
            (crs)))
        (lzg-typ! k 'ZZ)
        (fact 'zz-mul-cancel-zero k 'a)
        (dk-have! (list '= (list '* c1 c2) 1)
          (lambda ()
            (dk-have! (list '= (list '* c1 c2) (list '+ k 1)) (lambda () (crs)))
            (subst (list '= (list '* c1 c2) (list '+ k 1)))
            (subst (list '= k 0))
            (arith)))
        (let ((d (dk-cite! 'zz-mul-eq-one c1 c2)))
          (use-cases d
            (lambda () (oi-l) (subst (list '= 'b (list '* 'a c1))) (subst (list '= c1 1)) (crs))
            (lambda () (oi-r) (subst (list '= 'b (list '* 'a c1))) (subst (list '= c1 '(- 1))) (crs))))))))
(lzg-done! 'zz-divides-antisym)
(topic! 'zz-divides-antisym 'algebra)
(gloss! 'zz-divides-antisym "Two integers that divide each other are equal up to sign.")

;;; =====================================================================
;;; (6) Corollary 3.31.
;;; =====================================================================
;; divisibility in ZZ-RING is ZZ-DIVIDES
(define (lzg-zmul a b) (list '(MUL ZZ-RING) a b))
(define (lzg-zmul-eq! a b)                 ; (= ((MUL ZZ-RING) a b) (* a b)), a, b in ZZ
  (let ((eq (list '= (lzg-zmul a b) (list '* a b))))
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (slot 'MUL) (if (not (dk-lam-b!)) (begin (lzg-typ! (list '* a b) 'ZZ) (rfl))))))
    eq))
(sp (make-wff (forall-guarded '(d x) '((ZZ-DIVIDES d x))
                '(FORSOME dvy_ (AND (IN dvy_ (CARR ZZ-RING)) (= x ((MUL ZZ-RING) d dvy_)))))))
(dk-peel!)
(let ((c (lzg-zzdiv-open! 'd 'x)))
  (lzg-zmul-eq! 'd c)
  (ew c)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (begin (slot 'CARR) (ass))
          (begin (subst (list '= (lzg-zmul 'd c) (list '* 'd c))) (ass))))))
(lzg-done! 'lzg-zz-to-ring)
(topic! 'lzg-zz-to-ring 'plumbing)

(sp (make-wff (forall-guarded '(d x y) '((IN d ZZ) (IN y (CARR ZZ-RING)) (= x ((MUL ZZ-RING) d y)))
                '(ZZ-DIVIDES d x))))
(dk-peel!)
(dk-have! '(IN y ZZ) (lambda () (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))) (subst '(= ZZ (CARR ZZ-RING))) (ass)))
(lzg-zmul-eq! 'd 'y)
(dk-have! '(AND (IN d ZZ) (IN y ZZ)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'zz-mul-closed 'd 'y)
(mac 'ZZ-DIVIDES)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'FORSOME)
             (ew 'y)
             (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass)
                                            (begin (subst (list '= 'x (lzg-zmul 'd 'y))) (ass))))))
            ((equal? g '(IN x ZZ)) (subst (list '= 'x (lzg-zmul 'd 'y))) (subst (list '= (lzg-zmul 'd 'y) '(* d y))) (ass))
            (#t (ass))))))
(lzg-done! 'lzg-ring-to-zz)
(topic! 'lzg-ring-to-zz 'plumbing)

;; with (ZZ-IS-GCD-SET SA d), (ZZ-IS-GCD-SET SB e), ELEM-EQUIV(ZZ-RING, m, n, A1, B1) and
;; A1 typed in context, land (ZZ-DIVIDES d e)
(define (lzg-zsdet a) (list 'SDET 'ZZ-RING 'm 'n a 's))
(define (lzg-zdiv c S)
  (list 'FORALL 'dvx_ (list 'IMPLIES (list 'IN 'dvx_ S)
    (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR ZZ-RING)) (list '= 'dvx_ (lzg-zmul c 'dvy_)))))))
(define (lzg-gcd-parts! S d)
  (let* ((hyp (list 'ZZ-IS-GCD-SET S d))
         (ignore (fact 'ZZ-IS-GCD-SET S d))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let* ((p1 (dk-split! (dk-ctx-form rhs))))
      (append-map (lambda (f) (if (dk-head-is? f 'AND) (dk-split! f) (list f))) p1))))
(define (lzg-divides-gcd! a1 b1 d e)
  (let* ((sa (lzg-zsdet a1)) (sb (lzg-zsdet b1))
         (pa (lzg-gcd-parts! sa d)) (pb (lzg-gcd-parts! sb e))
         (alla (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f '(IN gse_ ZZ))))) pa))
         (univb (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(IN gse_ ZZ)))) pb)))
    (dk-have! '(IN d ZZ) (lambda () (ass)))
    (dk-have! (list 'IN d '(CARR ZZ-RING)) (lambda () (slot 'CARR) (ass)))
    (dk-have! (lzg-zdiv d sa)
      (lambda ()
        (let* ((landed (dk-peel!)) (x (cadr (find-first (dk-head? 'IN) landed))))
          (dk-apply! alla x)
          (fact 'lzg-zz-to-ring d x)
          (ass))))
    (fact 'sdet-divisor-equiv 'ZZ-RING 'm 'n 's d a1 b1)
    (dk-have! (list 'FORALL 'gsx_ (list 'IMPLIES (list 'IN 'gsx_ sb) (list 'ZZ-DIVIDES d 'gsx_)))
      (lambda ()
        (let* ((landed (dk-peel!)) (x (cadr (find-first (dk-head? 'IN) landed))))
          (dk-apply! (lzg-zdiv d sb) x)
          (let ((y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f x))) (dk-asms)) #t)))
            (fact 'lzg-ring-to-zz d x y)
            (ass)))))
    (dk-apply! univb d)
    (ass)))

(sp (make-wff (forall-guarded '(m n s A B d e)
                '((IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n ZZ)) (IN B (MAT m n ZZ))
                  (ELEM-EQUIV ZZ-RING m n A B)
                  (ZZ-IS-GCD-SET (SDET ZZ-RING m n A s) d) (ZZ-IS-GCD-SET (SDET ZZ-RING m n B s) e))
                '(OR (= d e) (= d (- e))))))
(dk-peel!)
(fact 'zz-is-commutative-ring)
(fact 'zz-is-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(dk-rewrite-h! '(IN A (MAT m n ZZ)) 'ZZ '(CARR ZZ-RING))
(dk-rewrite-h! '(IN B (MAT m n ZZ)) 'ZZ '(CARR ZZ-RING))
(fact 'elem-equiv-symmetric 'ZZ-RING 'm 'n 'A 'B)
(dk-have! '(ZZ-DIVIDES d e) (lambda () (lzg-divides-gcd! 'A 'B 'd 'e)))
(dk-have! '(ZZ-DIVIDES e d) (lambda () (lzg-divides-gcd! 'B 'A 'e 'd)))
(fact 'zz-divides-antisym 'd 'e)
(ass)
(lzg-done! 'sdet-gcd-invariant)
(topic! 'sdet-gcd-invariant 'algebra)
(gloss! 'sdet-gcd-invariant "Linear algebra 3.31: if B is obtained from the integer matrix A by integral elementary row and column operations, a gcd of the order-s subdeterminants of A is, up to sign, a gcd of those of B.")
