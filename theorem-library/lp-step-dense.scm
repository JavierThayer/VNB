;;; md-step.scm -- construction-of-measures.pdf Corollary 2.30: the measurable step functions are dense in L^p
;;; (1 <= p < inf).  Agent M-D (worker-02), 2026-10-28.  DESTINATION: theorem-library/lp-step-dense.scm.
;;; Library: measure.  Helper prefix: mdt-.  Load window: after md-lp.scm (lp-dominated-convergence), md-vocab.scm.
;;; Proof: f = f+ - f-; nondecreasing simple u_k -> f+, v_k -> f- (integral-simple-approx); s_k = u_k - v_k is a step
;;; function with |s_k| <= |f| and s_k -> f everywhere; Corollary 2.29 with g = |f|.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mdt-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MDT OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mdt-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mdt-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mdt-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mdt-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mdt-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (mdt-tree-sub x y s)) t)) (#t t)))
(define (mdt-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mdt-has-lam? (car l)) (loop (cdr l))))))))
(define (mdt-beta!) (if (mdt-has-lam? (dk-goal)) (dk-lam-b!)))
(define (dk-pick-if-t t)               ; the first IF subterm of t
  (cond ((and (pair? t) (eq? (car t) 'IF)) t)
        ((pair? t) (or (dk-pick-if-t (car t)) (dk-pick-if-t (cdr t))))
        (#t #f)))
(define (mdt-mark! . xs)
  (let ((port (open-output-file "/tmp/mdt-trace.txt" #t)))
    (for-each (lambda (x) (write-string (if (string? x) x (expression->string x)) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mdt-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))
(define (mdt-fun1! f cod)              ; (IN f (FUN omega cod)) in context: (IN f (FUN omega))
  (if (not (dk-asm? (list 'IN f '(FUN omega))))
      (let ((fi (dk-cite! 'fun-codomain-iff 'omega cod f)))
        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN f (list 'FUN 'omega cod))) (prop))))
        (mdt-split! (caddr fi)))))
(define (mdt-funext! f g cf cg pt!)    ; f in FUN(omega, cf), g in FUN(omega, cg): PT! x proves (= (f x) (g x)); lands (= f g)
  (mdt-fun1! f cf) (mdt-fun1! g cg)
  (dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list f 'mdtz_) (list g 'mdtz_))))
    (lambda () (let ((x (dk-di-var!))) (pt! x))))
  (dk-cite! 'fun-domain-extensionality 'omega f g))

