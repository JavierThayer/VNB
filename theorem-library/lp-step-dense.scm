;;; ---------------------------------------------------------------------------
;;; COROLLARY 2.30: every f in L^p is an L^p limit of L^p step functions
;;; ---------------------------------------------------------------------------
(define mdt-pos '(POS-PART omega f))
(define mdt-neg '(NEG-PART omega f))
(define mdt-g '(ABS-FN omega f))
(define (mdt-sk cu cv k) (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list (list cu k) 'sx_) (list (list cv k) 'sx_))))
(define (mdt-ss cu cv) (list 'VNB-LAMBDA 'mdk_ 'NN (mdt-sk cu cv 'mdk_)))
(define (mdt-cfreal-of cf) (mdt-tree-sub 'cf cf mdt-cfreal))
(define (mdt-simple-of cf) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-SIMPLE-FN 'omega 'ca (list cf 'n_)))))
(define (mdt-cfk! cf k)                ; cf(k) simple: its parts
  (dk-apply! (dk-ctx-form (mdt-simple-of cf)) k)
  (if (not (dk-asm? (list 'IN (list cf k) '(FUN omega RR-POS-STAR))))
      (mdt-simple-parts! (list cf k))))
(define (mdt-cfx! cf k x)              ; (cf k) x real, in RPS, nonneg
  (mdt-cfk! cf k)
  (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list 'IN (list (list cf k) 'x_) 'RR)))) x)
  (dk-cite! 'fun-apply-type-c (list cf k) 'omega 'RR-POS-STAR x)
  (dk-cite! 'rr-pos-star-nonneg (list (list cf k) x)))
(define (mdt-skv! cu cv k x)           ; ((ss k) x) = (cu k) x - (cv k) x
  (let* ((ss (mdt-ss cu cv)) (sk (mdt-sk cu cv k)) (v (list '- (list (list cu k) x) (list (list cv k) x))))
    (mdt-cfx! cu k x) (mdt-cfx! cv k x)
    (dk-type! v)
    (dk-cite! 'simple-difference-step-fn 'omega 'ca (list cu k) (list cv k))
    (dk-project! (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk) 'is-measurable-step-fn (list 'IS-MEASURABLE-STEP-FN 'omega 'ca sk))
    (dk-project! (list 'IN sk '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk))
    (dk-cite! 'membership-implies-sethood sk '(FUN omega RR))
    (let ((e1 (list '= (list ss k) sk)) (e2 (list '= (list (list ss k) x) v)))
      (if (not (dk-asm? e1)) (dk-have! e1 (lambda () (mdt-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      (if (not (dk-asm? e2)) (dk-have! e2 (lambda () (subst e1) (mdt-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      v)))
(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu (FORALL p (FORALL f
   (IMPLIES (IS-MEASURE omega ca mu) (IMPLIES (IN p RR) (IMPLIES (<= 1 p) (IMPLIES (IS-REAL-MEASURABLE-FN omega ca f)
     (IMPLIES (IN (LP-NORM omega ca mu p f) RR)
       (FORSOME ss (AND (IN ss (FUN NN (FUN omega RR)))
         (AND (FORALL k (IMPLIES (IN k NN) (AND (IS-MEASURABLE-STEP-FN omega ca (ss k)) (IN (LP-NORM omega ca mu p (ss k)) RR))))
              (ECONVERGES-TO (VNB-LAMBDA k NN (LP-NORM omega ca mu p (VNB-LAMBDA sx_ omega (- ((ss k) sx_) (f sx_))))) 0))))))))))))))))
(dk-peel!)
(fact 'nn-is-set)
(fact 'rr-zero-in)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(IN p RR) '(<= 1 p))))
(dk-project! (list 'IS-MEASURABLE-FN 'omega 'ca mdt-pos) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f))
(dk-project! (list 'IS-MEASURABLE-FN 'omega 'ca mdt-neg) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f))
(dk-project! '(IN f (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f))
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu 'f)
(dk-cite! 'abs-fn-fun 'omega 'f)
(define (mdt-sk-facts! cu cv k)        ; (ss k) = (sk k), a step function, real measurable, typed
  (let* ((ss (mdt-ss cu cv)) (sk (mdt-sk cu cv k)) (e1 (list '= (list ss k) sk)) (leaf (proof-state-focus *ps*)))
    (if (not (dk-asm? e1))
        (begin
          (mdt-cfk! cu k) (mdt-cfk! cv k)
          (dk-cite! 'simple-difference-step-fn 'omega 'ca (list cu k) (list cv k))
          (dk-project! (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk) 'is-measurable-step-fn (list 'IS-MEASURABLE-STEP-FN 'omega 'ca sk))
          (dk-project! (list 'IN sk '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk))
          (dk-cite! 'membership-implies-sethood sk '(FUN omega RR))
          (dk-have! e1 (lambda () (mdt-beta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
    e1))
(define (mdt-bound! cu cv k x)         ; x in omega: (<= (abs v) (abs (f x))), v = (cu k) x - (cv k) x; returns v
  (let* ((v (mdt-skv! cu cv k x)) (a (list (list cu k) x)) (b (list (list cv k) x)) (ax (list 'abs (list 'f x))) (g (list '<= (list 'abs v) ax)))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'approximant-below 'omega cu mdt-pos k x)
          (dk-cite! 'approximant-below 'omega cv mdt-neg k x)
          (mdt-pn! x)
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x) (dk-cite! 'rr-abs-closed (list 'f x))
          (let ((prems (list (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN ax 'RR) (list '<= 0 a) (list '<= 0 b)
                             (list 'IN (list mdt-pos x) 'RR) (list 'IN (list mdt-neg x) 'RR)
                             (list '<= a (list mdt-pos x)) (list '<= b (list mdt-neg x))
                             (list '<= (list mdt-pos x) ax) (list '<= (list mdt-neg x) ax))))
            (dk-have! (list '<= (list '- ax) v) (lambda () (apply dk-ineq! prems)))
            (dk-have! (list '<= v ax) (lambda () (apply dk-ineq! prems)))
