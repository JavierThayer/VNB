    v))
(define (mdt-dom-form ss g) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb)
                               (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(NOT (IN x nb)) (list '<= (list 'abs (list (list ss 'k) 'x)) (list g 'x))))))))))
(define (mdt-conv-form ss) (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb)
                               (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(NOT (IN x nb))
                                 (list 'CONVERGES-TO 'RR-MS (list 'VNB-LAMBDA 'k 'NN (list (list ss 'k) 'x)) '(f x))))))))
(define (mdt-pn! x)                    ; the parts of f at x
  (mdt-split! (dk-cite! 'pos-neg-parts-ptwise 'omega 'f x))
  (dk-split-all!))
(let* ((cu (dk-skolem! (dk-cite! 'integral-simple-approx 'omega 'ca mdt-pos) #t))
       (cv (dk-skolem! (dk-cite! 'integral-simple-approx 'omega 'ca mdt-neg) #t))
       (ss (mdt-ss cu cv)) (mdt-gd mdt-g)
       (IG (list 'INTEGRAL 'omega 'ca 'mu (list 'PTWISE-EPOW 'omega (list 'ABS-FN 'omega mdt-gd) 'p)))
       (IF0 (list 'INTEGRAL 'omega 'ca 'mu (list 'PTWISE-EPOW 'omega mdt-gd 'p))))
  ;; g = |f| is in L^p
  (let ((fi (dk-cite! 'lp-norm-finite-iff 'omega 'ca 'mu 'p 'f)))
    (dk-have! (caddr fi) (lambda () (if (dk-only! fi (cadr fi)) (prop)))))
  (dk-project! (list 'IN mdt-gd '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mdt-gd))
  (dk-cite! 'abs-fn-fun 'omega mdt-gd)
  (mdt-funext! (list 'ABS-FN 'omega mdt-gd) mdt-gd 'RR-POS-STAR 'RR-POS-STAR
    (lambda (x) (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
                (dk-cite! 'rr-abs-closed (list 'f x)) (dk-cite! 'rr-abs-nonneg (list 'f x))
                (dk-cite! 'abs-fn-value 'omega mdt-gd x) (dk-cite! 'abs-fn-value 'omega 'f x)
                (dk-cite! 'rr-abs-of-nonneg (list 'abs (list 'f x)))
                (subst (list '== (list (list 'ABS-FN 'omega mdt-gd) x) (list 'abs (list mdt-gd x))))
                (subst (list '== (list mdt-gd x) (list 'abs (list 'f x))))
                (subst (list '= (list 'abs (list 'abs (list 'f x))) (list 'abs (list 'f x))))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
  (dk-have! (list 'IN IG 'RR) (lambda () (subst (list '= (list 'ABS-FN 'omega mdt-gd) mdt-gd)) (dk-ass!)))
  (let ((fi (dk-cite! 'lp-norm-finite-iff 'omega 'ca 'mu 'p mdt-gd)))
    (dk-have! (cadr fi) (lambda () (if (dk-only! fi (caddr fi)) (prop)))))
  ;; the sequence
  (dk-have! (list 'IN ss '(FUN NN (FUN omega RR)))
    (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (sk (mdt-sk cu cv k)))
                                          (mdt-cfk! cu k) (mdt-cfk! cv k)
                                          (dk-cite! 'simple-difference-step-fn 'omega 'ca (list cu k) (list cv k))
                                          (dk-project! (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk) 'is-measurable-step-fn (list 'IS-MEASURABLE-STEP-FN 'omega 'ca sk))
                                          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                              (dk-project! (list 'IN sk '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sk)))))
                             (lambda () (dk-ass!)))))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (list ss 'k))))
    (lambda () (let ((k (dk-di-var!))) (subst (mdt-sk-facts! cu cv k)) (dk-ass!))))
  ;; domination by |f| and convergence to f, everywhere
  (dk-cite! 'ae-null-empty 'omega 'ca 'mu)
