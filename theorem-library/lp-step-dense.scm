;;; ---------------------------------------------------------------------------
;;; a nondecreasing nonnegative real sequence converges to its (finite) supremum
;;; ---------------------------------------------------------------------------
(define (mdt-pos-parts! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(sp (make-wff '(FORALL a (FORALL l (IMPLIES (IN a (FUN NN RR)) (IMPLIES (FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))
   (IMPLIES (FORALL k (IMPLIES (IN k NN) (<= (a k) (a (succ k))))) (IMPLIES (IN l RR) (IMPLIES (= (ESUP (IMAGE a NN)) l) (CONVERGES-TO RR-MS a l))))))))))
(dk-peel!)
(fact 'nn-is-set)
(fact 'nn-zero-in)
(fact 'rr-zero-in)
(define (mdt-ak! k)
  (dk-cite! 'fun-apply-type-c 'a 'NN 'RR k)
  (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (a k))))) k)
  (mdt-rps! (list 'a k)))
(define (mdt-in-img! k)                ; (IN (a k) (IMAGE a NN))
  (mdt-ak! k)
  (let ((g (list 'IN (list 'a k) '(IMAGE a NN))))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'membership-implies-sethood (list 'a k) 'RR)
          (let ((im (dk-cite! 'image-membership-iff 'a 'NN (list 'a k))))
            (dk-have! (caddr (caddr im)) (lambda () (ew k) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
            (mdt-and! (list 'IN (list 'a k) 'SET) (caddr (caddr im)))
            (dk-have! g (lambda () (if (dk-only! im (caddr im)) (prop)))))))
    g))
(dk-have! '(SUBSET (IMAGE a NN) RR-POS-STAR)
  (lambda () (mac 'subset-def)
             (let* ((w (dk-di-var!)) (im (dk-cite! 'image-membership-iff 'a 'NN w)))
               (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN w '(IMAGE a NN))) (prop))))
               (mdt-split! (caddr im))
               (let ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w))) "the index") #t)))
                 (mdt-ak! n)
                 (subst (list '= w (list 'a n)))
                 (dk-ass!)))))
(dk-cite! 'nn-monotone-step-implies-le 'a)
(dk-have! (cadr (dk-cite! 'rr-converges-to-abs 'a 'l))
  (lambda ()
    (let* ((ld (dk-peel!)) (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))) (t (list '- 'l eps))
           (ex (list 'FORSOME 'mdn_ (list 'AND '(IN mdn_ NN) (list '< t '(a mdn_))))))
      (mdt-pos-parts! eps)
      (dk-type! t)
      (dk-have! ex
        (lambda ()
          (use-em (list '<= 0 t)
            (lambda ()
              (mdt-rps! t)
              (dk-have! (list '< t '(ESUP (IMAGE a NN))) (lambda () (subst '(= (ESUP (IMAGE a NN)) l)) (dk-ineq! '(IN l RR) (list 'IN eps 'RR) (list '< 0 eps))))
              (let* ((w (dk-skolem! (dk-apply! (dk-cite! 'esup-lt-witness '(IMAGE a NN)) t) #t))
                     (im (dk-cite! 'image-membership-iff 'a 'NN w)))
                (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN w '(IMAGE a NN))) (prop))))
                (mdt-split! (caddr im))
                (let ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w))) "the index") #t)))
                  (ew n)
                  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= (list 'a n) w)) (dk-ass!))))))))
            (lambda ()
              (mdt-ak! 0)
              (dk-cite! 'rr-not-le-lt 0 t)
              (ew 0)
              (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! (list 'IN t 'RR) '(IN (a 0) RR) '(<= 0 (a 0)) (list '< t 0)))))))))
      (let ((n0 (dk-skolem! (dk-ctx-form ex) #t)))
        (ew n0)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((g (begin (dk-peel!) (dk-goal))) (k (cadr (cadr (cadr (cadr g))))))
                  (mdt-ak! k) (mdt-ak! n0)
                  (dk-apply! (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN) (IMPLIES (<= m n) (<= (a m) (a n)))))))) k n0)
                  (mdt-in-img! k)
                  (dk-apply! (dk-cite! 'esup-upper '(IMAGE a NN)) (list 'a k))
                  (dk-have! (list '<= (list 'a k) 'l) (lambda () (subst '(= l (ESUP (IMAGE a NN)))) (dk-ass!)))
                  (let ((u (list '- (list 'a k) 'l))
                        (prems (list (list 'IN (list 'a k) 'RR) (list 'IN (list 'a n0) 'RR) '(IN l RR) (list 'IN eps 'RR)
                                     (list '< t (list 'a n0)) (list '<= (list 'a n0) (list 'a k)) (list '<= (list 'a k) 'l))))
                    (dk-type! u)
                    (dk-have! (list '<= (list '- eps) u) (lambda () (apply dk-ineq! prems)))
                    (dk-have! (list '<= u eps) (lambda () (apply dk-ineq! prems)))
                    (dk-cite! 'rr-abs-le-of-parts u eps)
                    (dk-ass!))))))))))
(dk-cite! 'rr-converges-to-abs 'a 'l)
(dk-ass!)
(mdt-qed! 'nondecreasing-converges-to-esup)

;;; ---------------------------------------------------------------------------
;;; the difference of two simple functions is a step function
;;; ---------------------------------------------------------------------------
(define mdt-s '(VNB-LAMBDA sx_ omega (- (u sx_) (v sx_))))
(define mdt-cart '(CARTESIAN (IMAGE u omega) (IMAGE v omega)))
(define mdt-df (list 'VNB-LAMBDA 'mdp_ mdt-cart '(- (NTH 1 mdp_) (NTH 2 mdp_))))
(define (mdt-simple-parts! w)          ; w simple: measurable, FUN typings, values real nonneg, finite range, omega a set
  (dk-project! (list 'IS-MEASURABLE-FN 'omega 'ca w) 'is-simple-fn (list 'IS-SIMPLE-FN 'omega 'ca w))
  (dk-project! (list 'IN (list 'CARD (list 'IMAGE w 'omega)) 'NN) 'is-simple-fn (list 'IS-SIMPLE-FN 'omega 'ca w))
  (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list 'IN (list w 'x_) 'RR))) 'is-simple-fn (list 'IS-SIMPLE-FN 'omega 'ca w))
  (dk-project! (list 'IN w '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca w))
  (dk-cite! 'fun-domain-in-set 'omega 'RR-POS-STAR w)
  (dk-cite! 'image-set w 'omega)
  (dk-cite! 'simple-fn-real-measurable 'omega 'ca w))
(define (mdt-wx! w x)                  ; w(x) real, in the image of w
  (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list 'IN (list w 'x_) 'RR)))) x)
  (let ((wx (list w x)) (g (list 'IN (list w x) (list 'IMAGE w 'omega))))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'membership-implies-sethood wx 'RR)
          (let ((im (dk-cite! 'image-membership-iff w 'omega wx)))
            (dk-have! (caddr (caddr im)) (lambda () (ew x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
            (mdt-and! (list 'IN wx 'SET) (caddr (caddr im)))
            (dk-have! g (lambda () (if (dk-only! im (caddr im)) (prop)))))))
    wx))
(sp (make-wff '(FORALL omega (FORALL ca (FORALL u (FORALL v (IMPLIES (IS-SIMPLE-FN omega ca u) (IMPLIES (IS-SIMPLE-FN omega ca v)
   (IS-MEASURABLE-STEP-FN omega ca (VNB-LAMBDA sx_ omega (- (u sx_) (v sx_))))))))))))
(dk-peel!)
(mdt-simple-parts! 'u)
(mdt-simple-parts! 'v)
(dk-cite! 'real-measurable-sub 'omega 'ca 'u 'v)
(dk-project! (list 'IN mdt-s '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mdt-s))
(dk-cite! 'card-cartesian-nn '(IMAGE u omega) '(IMAGE v omega))
(dk-cite! 'cartesian-set-iff '(IMAGE u omega) '(IMAGE v omega))
(mdt-and! '(IN (IMAGE u omega) SET) '(IN (IMAGE v omega) SET))
(let ((cs (dk-cite! 'cartesian-set-iff '(IMAGE u omega) '(IMAGE v omega))))
  (dk-have! (list 'IN mdt-cart 'SET) (lambda () (if (dk-only! cs (caddr cs)) (prop)))))
(dk-cite! 'card-image-finite mdt-df mdt-cart)
(dk-cite! 'image-set mdt-df mdt-cart)
(dk-cite! 'image-set mdt-s 'omega)
(dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (list 'IMAGE mdt-s 'omega)) (list 'IN 'z (list 'IMAGE mdt-df mdt-cart))))
  (lambda ()
    (let* ((w (dk-di-var!)) (im (dk-cite! 'image-membership-iff mdt-s 'omega w)))
      (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN w (list 'IMAGE mdt-s 'omega))) (prop))))
      (mdt-split! (caddr im))
      (let* ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w))) "the point") #t))
             (ux (mdt-wx! 'u x)) (vx (mdt-wx! 'v x)) (pr (list 'LIST ux vx)))
        (dk-cite! 'pair-in-cartesian '(IMAGE u omega) '(IMAGE v omega) ux vx)
        (dk-have! (list '= (list mdt-s x) (list '- ux vx)) (lambda () (dk-type! (list '- ux vx)) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (dk-type! (list '- ux vx))
        (dk-have! (list '= (list mdt-df pr) (list '- ux vx))
          (lambda () (dk-lam-b!) (if (dk-contains? (dk-goal) 'NTH) (nth-r)) (if (dk-contains? (dk-goal) 'NTH) (nth-r))
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (let ((im2 (dk-cite! 'image-membership-iff mdt-df mdt-cart w)))
          (dk-have! (caddr (caddr im2))
            (lambda () (ew pr) (dk-conj-close! (lambda () (if (not (dk-ass!))
                                                              (begin (subst (list '= (list mdt-df pr) (list '- ux vx)))
                                                                     (subst (list '= w (list mdt-s x)))
                                                                     (subst (list '= (list mdt-s x) (list '- ux vx)))
                                                                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))
          (dk-cite! 'membership-implies-sethood w (list 'IMAGE mdt-s 'omega))
          (mdt-and! (list 'IN w 'SET) (caddr (caddr im2)))
          (if (dk-only! im2 (caddr im2)) (prop)))))))
(mdt-and! (list 'IN (list 'IMAGE mdt-df mdt-cart) 'SET) (list 'IN (list 'CARD (list 'IMAGE mdt-df mdt-cart)) 'NN))
(dk-cite! 'card-subset-nn (list 'IMAGE mdt-df mdt-cart))
(mdt-and! (list 'IN (list 'IMAGE mdt-s 'omega) 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (list 'IMAGE mdt-s 'omega)) (list 'IN 'z (list 'IMAGE mdt-df mdt-cart)))))
(dk-apply! (dk-ctx-form (list 'FORALL 's (list 'IMPLIES (list 'AND '(IN s SET) (list 'FORALL 'z (list 'IMPLIES '(IN z s) (list 'IN 'z (list 'IMAGE mdt-df mdt-cart))))) '(IN (CARD s) NN))))
           (list 'IMAGE mdt-s 'omega))
(mac 'is-measurable-step-fn)
(dk-conj-close! (lambda () (dk-ass!)))
(mdt-qed! 'simple-difference-step-fn)

;;; ---------------------------------------------------------------------------
;;; the positive and negative parts, pointwise
;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL omega (FORALL f (FORALL x (IMPLIES (IN f (FUN omega RR)) (IMPLIES (IN x omega)
   (AND (IN ((POS-PART omega f) x) RR) (AND (<= 0 ((POS-PART omega f) x)) (AND (<= ((POS-PART omega f) x) (abs (f x)))
   (AND (IN ((NEG-PART omega f) x) RR) (AND (<= 0 ((NEG-PART omega f) x)) (AND (<= ((NEG-PART omega f) x) (abs (f x)))
        (= (- ((POS-PART omega f) x) ((NEG-PART omega f) x)) (f x)))))))))))))))
