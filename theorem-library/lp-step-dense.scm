    (lambda ()
      (let ((k (dk-di-var!)))
        (ew 'EMPTY-SET)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((x (dk-di-var!)))
                  (di)
                  (let* ((v (mdt-skv! cu cv k x)) (a (list (list cu k) x)) (b (list (list cv k) x)) (ax (list 'abs (list 'f x))))
                    (dk-cite! 'approximant-below 'omega cu mdt-pos k x)
                    (dk-cite! 'approximant-below 'omega cv mdt-neg k x)
                    (mdt-pn! x)
                    (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x) (dk-cite! 'rr-abs-closed (list 'f x))
                    (dk-cite! 'abs-fn-value 'omega 'f x)
                    (subst (list '= (list (list ss k) x) v))
                    (subst (list '== (list mdt-gd x) ax))
                    (let ((prems (list (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN ax 'RR) (list '<= 0 a) (list '<= 0 b)
                                       (list 'IN (list mdt-pos x) 'RR) (list 'IN (list mdt-neg x) 'RR)
                                       (list '<= a (list mdt-pos x)) (list '<= b (list mdt-neg x))
                                       (list '<= (list mdt-pos x) ax) (list '<= (list mdt-neg x) ax))))
                      (dk-have! (list '<= (list '- ax) v) (lambda () (apply dk-ineq! prems)))
                      (dk-have! (list '<= v ax) (lambda () (apply dk-ineq! prems)))
                      (dk-cite! 'rr-abs-le-of-parts v ax)
                      (dk-ass!))))))))))
  (for-each (lambda (cf) (dk-have! (mdt-cfreal-of cf)
                           (lambda () (let* ((g (begin (dk-peel!) (dk-goal))) (n (cadr (car (cadr g)))) (x (cadr (cadr g)))) (mdt-cfx! cf n x) (dk-ass!)))))
            (list cu cv))
  (dk-have! (mdt-conv-form ss)
    (lambda ()
      (ew 'EMPTY-SET)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let ((x (dk-di-var!)))
                (di)
                (mdt-pn! x)
                (let* ((su (list 'VNB-LAMBDA 'n_ 'NN (list (list cu 'n_) x)))
                       (sv (list 'VNB-LAMBDA 'n_ 'NN (list (list cv 'n_) x)))
                       (mdt-hseq (list 'VNB-LAMBDA 'k 'NN (list (list ss 'k) x))))
                  (dk-cite! 'approximant-converges 'omega cu mdt-pos x)
                  (dk-cite! 'approximant-converges 'omega cv mdt-neg x)
                  (for-each (lambda (cf sq)
                              (dk-have! (list 'IN sq '(FUN NN RR))
                                (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mdt-cfx! cf k x) (dk-ass!))) (lambda () (dk-ass!))))))
                            (list cu cv) (list su sv))
