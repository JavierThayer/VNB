;;; la-z-sdet.scm -- subdeterminants under the elementary operations (linear algebra
;;; 3.29) and the invariance of their gcd over Z (3.31) (LA-Z, 2026-10-19).
;;;
;;; Vocabulary: structure-library/la-z-vocab.scm (SUBMATRIX, SDET, ELEM-EQUIV,
;;; ZZ-IS-GCD-SET).  Prefix lzs-.
;;;
;;; LOAD WINDOW: after "theorem-library/det-transpose" (load.scm:2103; latest citations
;;; det-col-linear, det-equal-cols-zero, det-elem-h-col) and after
;;; "structure-library/la-z-vocab".  Cited only by la-z-gcd.  Library: linear-algebra.
;;; injection-in-fun / injection-injective are NOT cited (proven only at 3529, rake-asm-1):
;;; lzs-inj-parts! reads both off the definitional injection-membership-iff.

;;; =====================================================================
;;; The file's kit.
;;; =====================================================================
(define (lzs-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z-sdet: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

(define (lzs-iv n) (list 'INTERVAL 1 n))
(define (lzs-typ! t cls)
  (if (not (dk-asm? (list 'IN t cls)))
      (dk-have! (list 'IN t cls) dk-typ-close!)))
;; (IN (f x) cod) from f in FUN(dom, cod) and x in dom
(define (lzs-app! f x dom cod)
  (if (not (dk-asm? (list 'IN (list f x) cod)))
      (fact 'fun-apply-type-c f dom cod x)))
(define (lzs-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (lzs-sub a s p q) (list 'SUBMATRIX a s p q))

;; the landed (IN v (INTERVAL 1 s)) variables of a peel, in order
(define (lzs-iv-vars landed s)
  (map cadr (filter (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) (lzs-iv s)))) landed)))

;; close (IN X (CARR R)) / (IN X SET) for an entry or a determinant
(define (lzs-carr! t)
  (cond ((and (pair? t) (eq? (car t) 'DET))
         (if (not (dk-asm? (list 'IN t '(CARR R))))
             (begin (lzs-typ! (cadddr t) (list 'MAT (caddr t) (caddr t) '(CARR R)))
                    (fact 'det-in-carrier 'R (caddr t) (cadddr t)))))
        (#t (lzs-typ! t '(CARR R)))))
(define (lzs-close-carr!)
  (let ((g (dk-goal)))
    (cond ((and (eq? (car g) 'IN) (equal? (caddr g) '(CARR R))) (lzs-carr! (cadr g)) (ass))
          ((and (eq? (car g) 'IN) (eq? (caddr g) 'SET))
           (lzs-carr! (cadr g)) (fact 'membership-implies-sethood (cadr g) '(CARR R)) (ass))
          (#t (error "lzs-close-carr!: unexpected goal" (expression->string g))))))

;; the standard guards of a submatrix of the m-by-n matrix A
(define lzs-sub-guards
  '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
    (IN p (FUN (INTERVAL 1 s) (INTERVAL 1 m))) (IN q (FUN (INTERVAL 1 s) (INTERVAL 1 n)))))

;;; =====================================================================
;;; (1) SUBMATRIX: typing, entries, extensionality.
;;; =====================================================================
(sp (make-wff (forall-guarded '(R m n s A p q) lzs-sub-guards
                '(IN (SUBMATRIX A s p q) (MAT s s (CARR R))))))
(dk-peel!)
(mac 'SUBMATRIX)
(dk-matof!)
(let* ((ij (lzs-iv-vars (dk-peel!) 's)) (i (car ij)) (j (cadr ij)))
  (lzs-app! 'p i (lzs-iv 's) (lzs-iv 'm))
  (lzs-app! 'q j (lzs-iv 's) (lzs-iv 'n))
  (lzs-beta!)
  (lzs-close-carr!))
(lzs-done! 'submatrix-type)
(topic! 'submatrix-type 'algebra)
(gloss! 'submatrix-type "The s-by-s submatrix of a matrix on index maps p, q is an s-by-s matrix over the same ring.")

(sp (make-wff (forall-guarded '(R m n s A p q i j)
                (append lzs-sub-guards '((IN i (INTERVAL 1 s)) (IN j (INTERVAL 1 s))))
                '(= (ENTRY (SUBMATRIX A s p q) i j) (ENTRY A (p i) (q j))))))
(dk-peel!)
(lzs-app! 'p 'i (lzs-iv 's) (lzs-iv 'm))
(lzs-app! 'q 'j (lzs-iv 's) (lzs-iv 'n))
(lzs-typ! '(ENTRY A (p i) (q j)) '(CARR R))
(mac 'SUBMATRIX)
(let* ((M (cadr (cadr (dk-goal)))) (G (cadddr M))
       (r (dk-fact! 'entry-of-matof 's 's G 'i 'j)))
  (if (and (pair? r) (eq? (car r) 'IMPLIES) (not (dk-asm? (cadr r))))
      (set! r (detach-with! r (lambda ()
                (let* ((uv (lzs-iv-vars (dk-peel!) 's)) (u (car uv)) (v (cadr uv)))
                  (lzs-app! 'p u (lzs-iv 's) (lzs-iv 'm))
                  (lzs-app! 'q v (lzs-iv 's) (lzs-iv 'n))
                  (lzs-beta!)
                  (lzs-close-carr!))))))
  (let loop ()
    (if (and (pair? r) (eq? (car r) 'IMPLIES) (dk-asm? (cadr r)))
        (begin (set! r (dk-landed-1 (lambda () (detach! r)))) (loop))))
  (if (dk--redex? r) (dk-lam-b-h! r)))
(if (not (proof-done? *ps*)) (ass))
(lzs-done! 'submatrix-entry)
(topic! 'submatrix-entry 'algebra)
(gloss! 'submatrix-entry "The (i, j) entry of SUBMATRIX(A, s, p, q) is the (p(i), q(j)) entry of A.")

;; two submatrices with the same entries are equal
(sp (make-wff (forall-guarded '(R m n s A p q B pb qb)
                (append lzs-sub-guards
                  '((IN B (MAT m n (CARR R)))
                    (IN pb (FUN (INTERVAL 1 s) (INTERVAL 1 m))) (IN qb (FUN (INTERVAL 1 s) (INTERVAL 1 n)))
                    (FORALL sxi_ (IMPLIES (IN sxi_ (INTERVAL 1 s))
                      (FORALL sxj_ (IMPLIES (IN sxj_ (INTERVAL 1 s))
                        (= (ENTRY A (p sxi_) (q sxj_)) (ENTRY B (pb sxi_) (qb sxj_)))))))))
                '(= (SUBMATRIX A s p q) (SUBMATRIX B s pb qb)))))
(let* ((landed (dk-peel!))
       (pw (find-first (dk-head? 'FORALL) landed)))
  (fact 'submatrix-type 'R 'm 'n 's 'A 'p 'q)
  (fact 'submatrix-type 'R 'm 'n 's 'B 'pb 'qb)
  (let ((ext (dk-fact! 'matrix-entry-extensionality 's 's '(CARR R)
                       (lzs-sub 'A 's 'p 'q) (lzs-sub 'B 's 'pb 'qb))))
    (detach-with! ext
      (lambda ()
        (let* ((ij (lzs-iv-vars (dk-peel!) 's)) (i (car ij)) (j (cadr ij)))
          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A 'p 'q i j))
          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'B 'pb 'qb i j))
          (dk-apply! pw i j)
          (ass))))
    (ass)))
(lzs-done! 'submatrix-ext)
(topic! 'submatrix-ext 'algebra)
(gloss! 'submatrix-ext "Two submatrices whose entries agree are equal.")

;;; =====================================================================
;;; (2) SDET: unfold, introduction, elimination.
;;; =====================================================================
(define lzs-sdet-sep
  (lambda (aa)
    (list 'SEP 'sdx_ '(CARR R)
      (list 'FORSOME 'sdp_ (list 'FORSOME 'sdq_
        (list 'AND '(IN sdp_ (INJECTION (INTERVAL 1 s) (INTERVAL 1 m)))
          (list 'AND '(IN sdq_ (INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))
            (list '= 'sdx_ (list 'DET 'R 's (list 'SUBMATRIX aa 's 'sdp_ 'sdq_))))))))))
(sp (make-wff (nest-quantifiers 'FORALL '(R m n A s) (list '== '(SDET R m n A s) (lzs-sdet-sep 'A)))))
(dk-peel!)
(mac 'SDET)
(qrfl)
(lzs-done! 'sdet-unfold)
(topic! 'sdet-unfold 'algebra)

;; membership: the determinant of a submatrix on two injections is a subdeterminant
(define lzs-inj-guards
  '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
    (IN p (INJECTION (INTERVAL 1 s) (INTERVAL 1 m))) (IN q (INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))))
;; land p, q in FUN from p, q in INJECTION
(define (lzs-inj-parts! f dom cod)
  (let* ((mem (list 'IN f (list 'INJECTION dom cod)))
         (ignore (dk-cite! 'injection-membership-iff dom cod f))
         (iff (iff-for mem))
         (rhs (caddr iff)))
    (if (not (dk-asm? (cadr rhs)))
        (dk-have! (cadr rhs) (dk-lane (lambda () (dk-only! iff mem) (dk-lane-if! prop)))))
    (if (not (dk-asm? (caddr rhs)))
        (dk-have! (caddr rhs) (dk-lane (lambda () (dk-only! iff mem) (dk-lane-if! prop)))))
    rhs))
;; f in FUN(dom, cod) from f in INJECTION(dom, cod): the first conjunct of the
;; definitional injection-membership-iff (structure-library/injection; its projection
;; injection-in-fun is proven only in theorem-library/rake-asm-1, far later in the load)
(define (lzs-inj-fun! f dom cod)
  (if (not (dk-asm? (list 'IN f (list 'FUN dom cod))))
      (lzs-inj-parts! f dom cod)))
;; a = b from (= (f a) (f b)), f an injection, a, b typed: the second conjunct
(define (lzs-inj-eq! dom cod f a b)
  (let ((rhs (lzs-inj-parts! f dom cod)))
    (dk-apply! (dk-ctx-form (caddr rhs)) a b)))
(sp (make-wff (forall-guarded '(R m n s A p q) lzs-inj-guards
                '(IN (DET R s (SUBMATRIX A s p q)) (SDET R m n A s)))))
(dk-peel!)
(lzs-inj-fun! 'p (lzs-iv 's) (lzs-iv 'm))
(lzs-inj-fun! 'q (lzs-iv 's) (lzs-iv 'n))
(fact 'submatrix-type 'R 'm 'n 's 'A 'p 'q)
(lzs-carr! '(DET R s (SUBMATRIX A s p q)))
(fact 'sdet-unfold 'R 'm 'n 'A 's)
(subst (list '= '(SDET R m n A s) (lzs-sdet-sep 'A)))
(in-sep! (lambda () (ass))
  (lambda ()
    (ew 'p) (ew 'q)
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))))
(lzs-done! 'sdet-intro)
(topic! 'sdet-intro 'algebra)
(gloss! 'sdet-intro "The determinant of the submatrix of A on injective row and column maps is an element of SDET.")

(sp (make-wff (forall-guarded '(R m n A s x) '((IN x (SDET R m n A s)))
                (list 'FORSOME 'sdp_ (list 'FORSOME 'sdq_
                  (list 'AND '(IN sdp_ (INJECTION (INTERVAL 1 s) (INTERVAL 1 m)))
                    (list 'AND '(IN sdq_ (INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))
                      '(= x (DET R s (SUBMATRIX A s sdp_ sdq_))))))))))
(let* ((landed (dk-peel!))
       (mem (find-first (dk-head? 'IN) landed))
       (u (dk-fact! 'sdet-unfold 'R 'm 'n 'A 's))
       (m2 (dk-rewrite-h! mem '(SDET R m n A s) (lzs-sdet-sep 'A))))
  (sep-me m2)
  (ass))
(lzs-done! 'sdet-elim)
(topic! 'sdet-elim 'algebra)

;; split a (nested) conjunction in context to its atoms
(define (lzs-split-deep! f)
  (for-each (lambda (g) (if (dk-head-is? g 'AND) (lzs-split-deep! g))) (dk-split! f)))
;; open (IN X (SDET R M N A s)) in context: return (P Q), with (IN P (INJECTION ..)),
;; (IN Q (INJECTION ..)) and (= X (DET R s (SUBMATRIX A s P Q))) landed
(define (lzs-sdet-open! x a m n)
  (let* ((ex (dk-cite! 'sdet-elim 'R m n a 's x))
         (pv (dk-skolem! ex #f))
         (e2 (find-first (lambda (f) (and (eq? (car f) 'FORSOME) (dk-contains? f pv))) (dk-asms)))
         (qv (dk-skolem! e2 #f))
         (cj (find-first (lambda (f) (and (eq? (car f) 'AND) (dk-contains? f qv) (dk-contains? f pv))) (dk-asms))))
    (lzs-split-deep! cj)
    (list pv qv)))

;;; =====================================================================
;;; (3) The IF resolver and the column transposition of the index maps.
;;; =====================================================================
(define (lzs-find-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)) (or (lzs-find-if (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((lzs-find-if (car l)))
                    (#t (loop (cdr l))))))))
;; (NOT (= a b)) from (NOT (= b a)) in context
(define (lzs-nsym! a b)
  (di)
  (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl)))
  (ai (list 'NOT (list '= b a))))
(define (lzs-cond-status c)
  (cond ((dk-asm? c) 'true)
        ((dk-asm? (list 'NOT c)) 'false)
        ((not (and (pair? c) (eq? (car c) '=))) #f)
        ((equal? (cadr c) (caddr c)) 'refl)
        ((dk-asm? (list '= (caddr c) (cadr c))) 'sym)
        ((dk-asm? (list 'NOT (list '= (caddr c) (cadr c)))) 'nsym)
        (#t #f)))
;; dk-if-branch!, tolerating a MAIN leaf that hash-consing had already grounded (the
;; same sequent proved on an earlier branch): then only the condition is closed
(define (lzs-if-branch! true? ift close-cond k)
  (let* ((c      (cadr ift))
         (val    (if true? (caddr ift) (cadddr ift)))
         (want   (if true? c (list 'NOT c)))
         (opened (dk-opened (lambda () (if true? (if-true ift) (if-false ift)))))
         (conds  (filter (lambda (l) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal-of l) want)))))
                         opened))
         (mains  (filter (lambda (l) (not (memq l conds))) opened)))
    (if (not (and (<= (length conds) 1) (<= (length mains) 1)))
        (error "lzs-if-branch!: unexpected leaves"
               (map (lambda (l) (expression->string (dk-goal-of l))) opened)))
    (if (pair? conds)
        (begin
          (dk-focus! (car conds))
          (if close-cond (close-cond) (ass))
          (if (not (sequent-node-grounded? (car conds)))
              (error "lzs-if-branch!: the condition is not established" (expression->string want)))))
    (if (pair? mains)
        (begin
          (dk-focus! (car mains))
          (subst (list '= ift val))
          (k)))))
;; resolve every IF of the goal (preorder), splitting on an undecided condition and,
;; on the side where an equation (= t u) holds, rewriting t to u; then CLOSER
(define (lzs-if-all! closer)
  (let ((ift (lzs-find-if (dk-goal))))
    (if (not ift)
        (closer)
        (let* ((c (cadr ift))
               (k (lambda () (lzs-if-all! closer)))
               (known (find-first (lambda (a) (and (memq (car a) '(= ==)) (equal? (cadr a) ift)
                                                  (or (equal? (caddr a) (caddr ift))
                                                      (equal? (caddr a) (cadddr ift)))))
                                  (dk-asms))))
          (case (if known 'known (lzs-cond-status c))
            ((known) (subst (list '= ift (caddr known))) (k))
            ((true)  (lzs-if-branch! #t ift #f k))
            ((false) (lzs-if-branch! #f ift #f k))
            ((refl)  (lzs-if-branch! #t ift (lambda () (rfl)) k))
            ((sym)   (lzs-if-branch! #t ift (lambda () (subst (list '= (cadr c) (caddr c))) (rfl)) k))
            ((nsym)  (lzs-if-branch! #f ift (lambda () (lzs-nsym! (cadr c) (caddr c))) k))
            (else
             (use-em c
               (lambda ()
                 (lzs-if-branch! #t ift #f
                   (lambda ()
                     (if (and (eq? (car c) '=) (dk-contains? (dk-goal) (cadr c)))
                         (subst c))
                     (k))))
               (lambda () (lzs-if-branch! #f ift #f k)))))))))

;; type an application (f x) from f in FUN(D, C) in context
(define (lzs-app-close!)
  (let* ((g (dk-goal)) (t (cadr g)))
    (if (dk-asm? g)
        (ass)
        (let ((ft (find-first (lambda (a) (and (eq? (car a) 'IN) (equal? (cadr a) (car t))
                                               (pair? (caddr a)) (eq? (car (caddr a)) 'FUN)))
                              (dk-asms))))
          (if (not ft) (error "lzs-app-close!: no FUN typing for" (expression->string t)))
          (fact 'fun-apply-type-c (car t) (cadr (caddr ft)) (caddr (caddr ft)) (cadr t))
          (ass)))))
(define (lzs-close!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl))
          ((and (eq? (car g) 'IN) (pair? (cadr g)) (symbol? (car (cadr g)))
                (= (length (cadr g)) 2))
           (lzs-app-close!))
          (#t (error "lzs-close!: cannot close" (expression->string g))))))

;; the transposition (k l) of the indices, applied to X
(define (lzs-T x) (list 'IF (list '= x 'k) 'l (list 'IF (list '= x 'l) 'k x)))
(sp (make-wff (forall-guarded '(k l y) '((NOT (= k l))) (list '= (lzs-T (lzs-T 'y)) 'y))))
(dk-peel!)
(lzs-if-all! lzs-close!)
(lzs-done! 'lzs-tau-tau)
(topic! 'lzs-tau-tau 'plumbing)

;; the index map q followed by the transposition (k l) is injective
(define lzs-swq (list 'VNB-LAMBDA 'swj_ '(INTERVAL 1 s) (lzs-T '(q swj_))))
(sp (make-wff (forall-guarded '(s n q k l)
                '((IN s NN) (IN n NN) (IN q (INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))
                  (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l)))
                (list 'IN lzs-swq '(INJECTION (INTERVAL 1 s) (INTERVAL 1 n))))))
(dk-peel!)
(lzs-inj-fun! 'q (lzs-iv 's) (lzs-iv 'n))
(fact 'injection-membership-iff (lzs-iv 's) (lzs-iv 'n) lzs-swq)
(let* ((iff (iff-for (list 'IN lzs-swq '(INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))))
       (rhs (caddr iff)) (c1 (cadr rhs)) (c2 (caddr rhs)))
  (dk-have! c1
    (lambda ()
      (dk-lam-type!
        (lambda () (dk-peel!) (lzs-beta!) (lzs-if-all! lzs-close!))
        (lambda () (fact 'interval-in-set 1 's) (ass)))))
  (dk-have! c2
    (lambda ()
      (let* ((landed (dk-peel!))
             (ab (lzs-iv-vars landed 's)) (a (car ab)) (b (cadr ab))
             (e (find-first (dk-head? '=) landed)))
        (lzs-app! 'q a (lzs-iv 's) (lzs-iv 'n))
        (lzs-app! 'q b (lzs-iv 's) (lzs-iv 'n))
        (let ((e2 (dk-landed-1 (lambda () (dk-lam-b-h! e)))))
          (fact 'lzs-tau-tau 'k 'l (list 'q a))
          (fact 'lzs-tau-tau 'k 'l (list 'q b))
          (dk-have! (list '= (list 'q a) (list 'q b))
            (lambda ()
              (subst (list '= (list 'q a) (lzs-T (lzs-T (list 'q a)))))
              (subst e2)
              (subst (list '= (lzs-T (lzs-T (list 'q b))) (list 'q b)))
              (rfl)))
          (lzs-inj-eq! (lzs-iv 's) (lzs-iv 'n) 'q a b)
          (ass)))))
  (dk-only! iff c1 c2)
  (prop))
(lzs-done! 'lzs-swap-injection)
(topic! 'lzs-swap-injection 'plumbing)

;; (IN LAM (FUN (INTERVAL 1 s) (INTERVAL 1 n))) for an index lambda whose body is an IF
;; tower over typed indices
(define (lzs-idx-fun! lam . opt)
  (dk-have! (list 'IN lam (list 'FUN (caddr lam) (if (pair? opt) (car opt) '(INTERVAL 1 n))))
    (lambda ()
      (dk-lam-type!
        (lambda () (dk-peel!) (lzs-beta!) (lzs-if-all! lzs-close!))
        (lambda () (fact 'interval-in-set 1 's) (ass))))))

;; close any goal from F and (NOT F) in context; NOTF is the negation
(define (lzs-contra! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
;; resolve the IFs of the HYPOTHESIS H whose conditions the context decides; returns
;; the rewritten hypothesis
(define (lzs-if-h! h)
  (let ((ift (lzs-find-if h)))
    (if (not ift)
        h
        (let* ((c (cadr ift)) (st (lzs-cond-status c))
               (val (cond ((memq st '(true refl sym)) (caddr ift))
                          ((memq st '(false nsym)) (cadddr ift))
                          (#t (error "lzs-if-h!: undecided condition" (expression->string c))))))
          (dk-have! (list '= ift val) (lambda () (lzs-if-all! lzs-close!)))
          (lzs-if-h! (dk-rewrite-h! h ift val))))))

;; replacing the value at j0 by a value k outside the range keeps an index map injective
(define (lzs-rep-of q j0 kk) (list 'VNB-LAMBDA 'rpw_ '(INTERVAL 1 s) (list 'IF (list '= 'rpw_ j0) kk (list q 'rpw_))))
(sp (make-wff (forall-guarded '(s n q j0 k)
                '((IN s NN) (IN n NN) (IN q (INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))
                  (IN j0 (INTERVAL 1 s)) (IN k (INTERVAL 1 n))
                  (FORALL rpj_ (IMPLIES (IN rpj_ (INTERVAL 1 s)) (NOT (= (q rpj_) k)))))
                (list 'IN (lzs-rep-of 'q 'j0 'k) '(INJECTION (INTERVAL 1 s) (INTERVAL 1 n))))))
(dk-peel!)
(lzs-inj-fun! 'q (lzs-iv 's) (lzs-iv 'n))
(define lzs-q2 (lzs-rep-of 'q 'j0 'k))
(fact 'injection-membership-iff (lzs-iv 's) (lzs-iv 'n) lzs-q2)
(let* ((iff (iff-for (list 'IN lzs-q2 '(INJECTION (INTERVAL 1 s) (INTERVAL 1 n)))))
       (rhs (caddr iff)) (c1 (cadr rhs)) (c2 (caddr rhs))
       (allk '(FORALL rpj_ (IMPLIES (IN rpj_ (INTERVAL 1 s)) (NOT (= (q rpj_) k))))))
  (lzs-idx-fun! lzs-q2)
  (dk-have! c2
    (lambda ()
      (let* ((landed (dk-peel!))
             (ab (lzs-iv-vars landed 's)) (a (car ab)) (b (cadr ab))
             (e (find-first (dk-head? '=) landed))
             (qa (list 'q a)) (qb (list 'q b)))
        (lzs-app! 'q a (lzs-iv 's) (lzs-iv 'n))
        (lzs-app! 'q b (lzs-iv 's) (lzs-iv 'n))
        (let ((e2 (dk-landed-1 (lambda () (dk-lam-b-h! e)))))
          (dk-apply! allk a)
          (dk-apply! allk b)
          (use-em (list '= a 'j0)
            (lambda ()
              (use-em (list '= b 'j0)
                (lambda () (subst (list '= a 'j0)) (subst (list '= b 'j0)) (rfl))
                (lambda ()                       ; k = q b: impossible
                  (let ((e3 (lzs-if-h! e2)))
                    (dk-have! (list '= qb 'k) (lambda () (subst (list '= qb 'k)) (rfl)))
                    (lzs-contra! (list 'NOT (list '= qb 'k)))))))
            (lambda ()
              (use-em (list '= b 'j0)
                (lambda ()
                  (let ((e3 (lzs-if-h! e2)))
                    (lzs-contra! (list 'NOT (list '= qa 'k)))))
                (lambda ()
                  (lzs-if-h! e2)
                  (lzs-inj-eq! (lzs-iv 's) (lzs-iv 'n) 'q a b)
                  (ass)))))))))
  (dk-only! iff c1 c2)
  (prop))
(lzs-done! 'lzs-replace-injection)
(topic! 'lzs-replace-injection 'plumbing)

;;; =====================================================================
;;; (4) Proposition 3.29, column operations.
;;; =====================================================================
(define lzs-mmn '(MAT m n (CARR R)))
(define (lzs-mm a b) (list 'MATMUL 'R a b))
(define (lzs-det x) (list 'DET 'R 's x))
(define (lzs-swq-of q) (list 'VNB-LAMBDA 'swj_ '(INTERVAL 1 s) (lzs-T (list q 'swj_))))
;; type an entry of A at (p i, j) and so on: the entries the closers meet
(define (lzs-entry! a i j) (lzs-typ! (list 'ENTRY a i j) '(CARR R)))
;; prove the pointwise antecedent of submatrix-ext / det-col-linear on the focus leaf:
;; peel the indices and call (BODY i j) with them typed
(define (lzs-pw! body)
  (let* ((landed (dk-peel!))
         (ij (lzs-iv-vars landed 's))
         (ne (find-first (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=))) landed)))
    ;; with a (NOT (= v j0)) guard, v is the COLUMN index: put it first
    (if (and ne (= (length ij) 2))
        (let ((jv (cadr (cadr ne))))
          (body jv (if (eq? jv (car ij)) (cadr ij) (car ij))))
        (apply body ij))))
;; detach every antecedent of the chain INST, proving each one not in context with
;; (PROVER ANTE) on its own lane; returns the consequent as it landed
(define (lzs-detach-all! inst prover)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (lambda () (prover a))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f)) (dk-landed-1 (lambda () (detach! f))))))
        f)))

;; ---- F column: every subdeterminant of A F[k,l] is one of A
(sp (make-wff (forall-guarded '(R m n s A k l x)
                '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l))
                  (IN x (SDET R m n (MATMUL R A (ELEM-F R n k l)) s)))
                '(IN x (SDET R m n A s)))))
(dk-peel!)
(let* ((af (lzs-mm 'A '(ELEM-F R n k l))))
  (lzs-typ! '(ELEM-F R n k l) '(MAT n n (CARR R)))
  (lzs-typ! af lzs-mmn)
  (let* ((pq (lzs-sdet-open! 'x af 'm 'n)) (p (car pq)) (q (cadr pq))
         (q2 (lzs-swq-of q)))
    (lzs-inj-fun! p (lzs-iv 's) (lzs-iv 'm))
    (lzs-inj-fun! q (lzs-iv 's) (lzs-iv 'n))
    (fact 'lzs-swap-injection 's 'n q 'k 'l)
    (lzs-inj-fun! q2 (lzs-iv 's) (lzs-iv 'n))
    (let* ((ext (dk-cite! 'submatrix-ext 'R 'm 'n 's af p q 'A p q2))
           (eq (lzs-detach-all! ext
                 (lambda (ante)
                   (lzs-pw! (lambda (i j)
                     (let ((pi (list p i)) (qj (list q j)))
                       (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                       (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                       (subst (dk-apply! (dk-fact! 'elem-f-action 'R 'm 'n 'A 'k 'l) pi qj))
                       (lzs-beta!)
                       (lzs-entry! 'A pi 'k) (lzs-entry! 'A pi 'l) (lzs-entry! 'A pi qj)
                       (lzs-if-all! lzs-close!))))))))
      (subst (list '= 'x (lzs-det (lzs-sub af 's p q))))
      (subst eq)
      (fact 'sdet-intro 'R 'm 'n 's 'A p q2)
      (ass))))
(lzs-done! 'sdet-col-swap-sub)
(topic! 'sdet-col-swap-sub 'algebra)

;; ---- F column, as the notes state it: the two sets coincide (F[k,l] F[k,l] = I)
(sp (make-wff (forall-guarded '(R m n s A k l)
                '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l)))
                '(= (SDET R m n (MATMUL R A (ELEM-F R n k l)) s) (SDET R m n A s)))))
(dk-peel!)
(let* ((f '(ELEM-F R n k l)) (af (lzs-mm 'A f)) (aff (lzs-mm af f))
       (sa '(SDET R m n A s)) (saf (list 'SDET 'R 'm 'n af 's)))
  (lzs-typ! f '(MAT n n (CARR R)))
  (lzs-typ! af lzs-mmn)
  ;; A F F = A
  (dk-have! '(IMPLIES (= n 0) (OR (= m 0) (AND (= n 0) (= n 0)))) (lambda () (prop)))
  (dk-have! '(IMPLIES (= n 0) (OR (= n 0) (AND (= n 0) (= m 0)))) (lambda () (prop)))
  (fact 'matmul-assoc 'R 'm 'n 'n 'n 'A f f)
  (fact 'elem-f-symmetric 'R 'n 'k 'l)
  (let ((e1 (dk-fact! 'elem-f-inverse 'R 'n 'k 'l)))
    (dk-rewrite-h! e1 '(ELEM-F R n l k) f))
  (fact 'identmat-right-identity 'R 'm 'n 'A)
  (dk-have! (list '= aff 'A)
    (lambda ()
      (subst (list '= aff (lzs-mm 'A (lzs-mm f f))))
      (subst (list '= (lzs-mm f f) '(IDENTMAT R n)))
      (subst (list '= (lzs-mm 'A '(IDENTMAT R n)) 'A))
      (rfl)))
  (dk-have! (list 'FORALL 'sex_ (list 'IFF (list 'IN 'sex_ saf) (list 'IN 'sex_ sa)))
    (lambda ()
      (dk-peel!)
      (dk-iff! (lambda (g) (equal? (caddr g) sa))
        (lambda ()
          (let ((x (cadr (dk-goal))))
            (fact 'sdet-col-swap-sub 'R 'm 'n 's 'A 'k 'l x)
            (ass)))
        (lambda ()
          (let ((x (cadr (dk-goal))))
            (dk-have! (list 'IN x (list 'SDET 'R 'm 'n aff 's))
              (lambda () (subst (list '= aff 'A)) (ass)))
            (fact 'sdet-col-swap-sub 'R 'm 'n 's af 'k 'l x)
            (ass))))))
  (fact 'class-extensionality saf sa)
  (ass))
(lzs-done! 'sdet-col-swap)
(topic! 'sdet-col-swap 'algebra)
(gloss! 'sdet-col-swap "Linear algebra 3.29 (F, columns): interchanging two columns does not change the set of order-s subdeterminants.")

;; ---- ring rearrangements, by crs
(define (lzs-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
(define (lzs-ring-lemma! name eq)
  (sp (make-wff (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
                  (forall-guarded '(lzu_ lzv_ lzw_) (lzs-carr-guards '(lzu_ lzv_ lzw_)) eq)))))
  (dk-peel!)
  (crs)
  (lzs-done! name)
  (topic! name 'plumbing))
;; u + v w = w v + u
(lzs-ring-lemma! 'lzs-ring-a '(= ((ADD R) lzu_ ((MUL R) lzv_ lzw_)) ((ADD R) ((MUL R) lzw_ lzv_) lzu_)))
;; w v + u = u + 1 . ... : the two witness forms
(lzs-ring-lemma! 'lzs-ring-b '(= ((ADD R) ((MUL R) lzw_ lzv_) lzu_) ((ADD R) lzu_ ((MUL R) lzw_ lzv_))))
(lzs-ring-lemma! 'lzs-ring-z '(= ((ADD R) ((MUL R) lzw_ (ZERO R)) lzu_) ((ADD R) lzu_ ((MUL R) (ZERO R) lzu_))))
(lzs-ring-lemma! 'lzs-ring-z0 '(= lzu_ ((ADD R) lzu_ ((MUL R) (ZERO R) lzu_))))
(lzs-ring-lemma! 'lzs-ring-c '(= ((ADD R) lzu_ ((MUL R) lzw_ lzv_)) ((ADD R) ((MUL R) lzw_ lzv_) lzu_)))

;; the conclusion of the G clause of 3.29
(define (lzs-g-concl x sc)
  (list 'FORSOME 'sda_ (list 'AND '(IN sda_ (SDET R m n A s))
    (list 'FORSOME 'sdb_ (list 'AND '(IN sdb_ (SDET R m n A s))
      (list 'FORSOME 'sdt_ (list 'AND '(IN sdt_ (CARR R))
        (list 'AND (list 'OR '(= sdt_ (ZERO R)) (list 'OR (list '= 'sdt_ sc) (list '= 'sdt_ (list '(NEG R) sc))))
             (list '= x '((ADD R) sda_ ((MUL R) sdt_ sdb_)))))))))))
;; prove (lzs-g-concl X SC) with the witnesses A1, B1 and T1 = ZERO or SC; the final
;; equation by EQ-THUNK
(define (lzs-g-witness! a1 b1 zero? eq-thunk)
  (let ((t1 (if zero? '(ZERO R) 'sc)))
    (if zero? (fact 'ring-zero-in 'R))
    (ew a1)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g 'FORSOME)
                 (ew (if (eq? (cadr g) 'sdb_) b1 t1))
                 (dk-conj-close!
                   (lambda ()
                     (let ((g2 (dk-goal)))
                       (cond ((dk-head-is? g2 'FORSOME)
                              (ew t1)
                              (dk-conj-close!
                                (lambda ()
                                  (let ((g3 (dk-goal)))
                                    (cond ((dk-head-is? g3 'OR)
                                           (if zero? (oi-l) (begin (oi-r) (oi-l))) (rfl))
                                          ((dk-head-is? g3 '=) (eq-thunk))
                                          (#t (ass)))))))
                             (#t (ass)))))))
                (#t (ass))))))))

;; ---- G column: A G[sc,k,l] adds sc times column k to column l
(sp (make-wff (forall-guarded '(R m n s A sc k l x)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN sc (CARR R)) (IN k (INTERVAL 1 n)) (IN l (INTERVAL 1 n)) (NOT (= k l))
                  (IN x (SDET R m n (MATMUL R A (ELEM-G R n sc k l)) s)))
                (lzs-g-concl 'x 'sc))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(define (lzs-gcol-main!)
  (let* ((ag (lzs-mm 'A '(ELEM-G R n sc k l))))
    (lzs-typ! '(ELEM-G R n sc k l) '(MAT n n (CARR R)))
    (lzs-typ! ag lzs-mmn)
    (let* ((pq (lzs-sdet-open! 'x ag 'm 'n)) (p (car pq)) (q (cadr pq))
           (bm (lzs-sub 'A 's p q)) (dm (lzs-sub ag 's p q))
           (gact (dk-fact! 'elem-g-action 'R 'm 'n 'A 'sc 'k 'l))
           (exl (list 'FORSOME 'gcj_ (list 'AND '(IN gcj_ (INTERVAL 1 s)) (list '= (list q 'gcj_) 'l)))))
      (lzs-inj-fun! p (lzs-iv 's) (lzs-iv 'm))
      (lzs-inj-fun! q (lzs-iv 's) (lzs-iv 'n))
      (fact 'submatrix-type 'R 'm 'n 's 'A p q)
      (fact 'submatrix-type 'R 'm 'n 's ag p q)
      (fact 'sdet-intro 'R 'm 'n 's 'A p q)
      (lzs-carr! (lzs-det bm))
      (subst (list '= 'x (lzs-det dm)))
      (use-em exl
        (lambda ()                         ; column l is a column of the minor, at j0
          (let* ((j0 (dk-skolem! exl #t))
                 (qj0 (list q j0))
                 (q2 (lzs-rep-of q j0 'k))
                 (cm (lzs-sub 'A 's p q2)))
            (lzs-idx-fun! q2)
            (fact 'submatrix-type 'R 'm 'n 's 'A p q2)
            (lzs-carr! (lzs-det cm))
            ;; det D = sc det C + det B
            (let* ((lin (dk-cite! 'det-col-linear 'R 's cm bm dm j0 'sc))
                   (eqd (lzs-detach-all! lin
                          (lambda (ante)
                            (lzs-pw! (lambda (j . rest)
                              (if (null? rest)
                                  ;; column j0: D = sc C + B
                                  (let* ((i j) (pi (list p i)))
                                    (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's ag p q i j0))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q2 i j0))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q i j0))
                                    (lzs-beta!)
                                    (subst (list '= qj0 'l))
                                    (subst (dk-apply! gact pi 'l))
                                    (lzs-entry! 'A pi 'k) (lzs-entry! 'A pi 'l)
                                    (lzs-if-all!
                                      (lambda ()
                                        (if (lzs-find-if (dk-goal)) (error "IF left"))
                                        (fact 'lzs-ring-a 'R (list 'ENTRY 'A pi 'l) (list 'ENTRY 'A pi 'k) 'sc)
                                        (ass))))
                                  ;; off column j0: the j-th columns agree
                                  (let* ((i (car rest)) (pi (list p i)) (qj (list q j)))
                                    (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                                    (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                                    (lzs-entry! 'A pi qj)
                                    ;; q j /= l, since q j0 = l and j /= j0
                                    (dk-have! (list 'NOT (list '= qj 'l))
                                      (lambda ()
                                        (di)
                                        (dk-have! (list '= qj qj0) (lambda () (subst (list '= qj 'l)) (subst (list '= qj0 'l)) (rfl)))
                                        (lzs-inj-eq! (lzs-iv 's) (lzs-iv 'n) q j j0)
                                        (lzs-contra! (list 'NOT (list '= j j0)))))
                                    (let ((g (dk-goal)))
                                      (if (dk-contains? (cadr g) 'ELEM-G)
                                          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's ag p q i j))
                                          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q i j))))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q2 i j))
                                    (if (dk-contains? (dk-goal) 'ELEM-G) (subst (dk-apply! gact pi qj)))
                                    (lzs-beta!)
                                    (lzs-if-all! lzs-close!)))))))))
              (subst eqd)
              (let ((exk (list 'FORSOME 'gck_ (list 'AND '(IN gck_ (INTERVAL 1 s)) (list '= (list q 'gck_) 'k)))))
                (use-em exk
                  (lambda ()                   ; column k is also in the minor: det C = 0
                    (let* ((j1 (dk-skolem! exk #t)) (qj1 (list q j1)))
                      (dk-have! (list 'NOT (list '= j0 j1))
                        (lambda ()
                          (di)
                          (dk-have! '(= k l)
                            (lambda () (subst (list '= 'k qj1)) (subst (list '= j1 j0)) (subst (list '= qj0 'l)) (rfl)))
                          (lzs-contra! '(NOT (= k l)))))
                      (let* ((ez (dk-cite! 'det-equal-cols-zero 'R 's cm j0 j1))
                             (z (lzs-detach-all! ez
                                  (lambda (ante)
                                    (lzs-pw! (lambda (i)
                                      (let ((pi (list p i)))
                                        (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                                        (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q2 i j0))
                                        (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q2 i j1))
                                        (lzs-beta!)
                                        (lzs-entry! 'A pi 'k)
                                        (lzs-if-all!
                                          (lambda ()
                                            (if (dk-contains? (dk-goal) qj1) (subst (list '= qj1 'k)))
                                            (lzs-close!))))))))))
                        (subst z)
                        (fact 'ring-zero-in 'R)
                        (lzs-g-witness! (lzs-det bm) (lzs-det bm) #t
                          (lambda ()
                            (fact 'lzs-ring-z 'R (lzs-det bm) '(ZERO R) 'sc)
                            (ass))))))
                  (lambda ()                   ; k is not a column of the minor: C is a minor of A
                    (let ((allk (list 'FORALL 'rpj_ (list 'IMPLIES '(IN rpj_ (INTERVAL 1 s)) (list 'NOT (list '= (list q 'rpj_) 'k))))))
                      (dk-have! allk
                        (lambda ()
                          (let* ((jj (car (lzs-iv-vars (dk-peel!) 's))))
                            (di)
                            (dk-have! exk (lambda () (ew jj) (dk-conj-close! (lambda () (ass)))))
                            (lzs-contra! (list 'NOT exk)))))
                      (fact 'lzs-replace-injection 's 'n q j0 'k)
                      (fact 'sdet-intro 'R 'm 'n 's 'A p q2)
                      (lzs-g-witness! (lzs-det bm) (lzs-det cm) #f
                        (lambda ()
                          (fact 'lzs-ring-b 'R (lzs-det bm) (lzs-det cm) 'sc)
                          (ass))))))))))
        (lambda ()                         ; column l is not in the minor: D = B
          (let ((alll (list 'FORALL 'rpj_ (list 'IMPLIES '(IN rpj_ (INTERVAL 1 s)) (list 'NOT (list '= (list q 'rpj_) 'l))))))
            (dk-have! alll
              (lambda ()
                (let* ((jj (car (lzs-iv-vars (dk-peel!) 's))))
                  (di)
                  (dk-have! exl (lambda () (ew jj) (dk-conj-close! (lambda () (ass)))))
                  (lzs-contra! (list 'NOT exl)))))
            (let* ((ext (dk-cite! 'submatrix-ext 'R 'm 'n 's ag p q 'A p q))
                   (eq (lzs-detach-all! ext
                         (lambda (ante)
                           (lzs-pw! (lambda (i j)
                             (let ((pi (list p i)) (qj (list q j)))
                               (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                               (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                               (dk-apply! alll j)
                               (subst (dk-apply! gact pi qj))
                               (lzs-entry! 'A pi qj)
                               (lzs-if-all! lzs-close!))))))))
              (subst eq)
              (lzs-g-witness! (lzs-det bm) (lzs-det bm) #t
                (lambda ()
                  (fact 'lzs-ring-z0 'R (lzs-det bm) (lzs-det bm) (lzs-det bm))
                  (ass))))))))))
(lzs-gcol-main!)
(lzs-done! 'sdet-col-add)
(topic! 'sdet-col-add 'algebra)
(gloss! 'sdet-col-add "Linear algebra 3.29 (G, columns): after adding sc times column k to column l, every order-s subdeterminant is a + t a' with a, a' subdeterminants of A and t = 0 or sc.")

;;; =====================================================================
;;; (5) Proposition 3.29, row operations (left multiplication).
;;; =====================================================================
;; ---- F row: every subdeterminant of F[k,l] A is one of A
(sp (make-wff (forall-guarded '(R m n s A k l x)
                '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN k (INTERVAL 1 m)) (IN l (INTERVAL 1 m)) (NOT (= k l))
                  (IN x (SDET R m n (MATMUL R (ELEM-F R m k l) A) s)))
                '(IN x (SDET R m n A s)))))
(dk-peel!)
(let* ((fa (lzs-mm '(ELEM-F R m k l) 'A)))
  (lzs-typ! '(ELEM-F R m k l) '(MAT m m (CARR R)))
  (lzs-typ! fa lzs-mmn)
  (let* ((pq (lzs-sdet-open! 'x fa 'm 'n)) (p (car pq)) (q (cadr pq))
         (p2 (lzs-swq-of p)))
    (lzs-inj-fun! p (lzs-iv 's) (lzs-iv 'm))
    (lzs-inj-fun! q (lzs-iv 's) (lzs-iv 'n))
    (fact 'lzs-swap-injection 's 'm p 'k 'l)
    (lzs-inj-fun! p2 (lzs-iv 's) (lzs-iv 'm))
    (let* ((ext (dk-cite! 'submatrix-ext 'R 'm 'n 's fa p q 'A p2 q))
           (eq (lzs-detach-all! ext
                 (lambda (ante)
                   (lzs-pw! (lambda (i j)
                     (let ((pi (list p i)) (qj (list q j)))
                       (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                       (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                       (subst (dk-apply! (dk-fact! 'elem-f-row-action 'R 'm 'n 'A 'k 'l) pi qj))
                       (lzs-beta!)
                       (lzs-entry! 'A 'k qj) (lzs-entry! 'A 'l qj) (lzs-entry! 'A pi qj)
                       (lzs-if-all! lzs-close!))))))))
      (subst (list '= 'x (lzs-det (lzs-sub fa 's p q))))
      (subst eq)
      (fact 'sdet-intro 'R 'm 'n 's 'A p2 q)
      (ass))))
(lzs-done! 'sdet-row-swap-sub)
(topic! 'sdet-row-swap-sub 'algebra)

(sp (make-wff (forall-guarded '(R m n s A k l)
                '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN k (INTERVAL 1 m)) (IN l (INTERVAL 1 m)) (NOT (= k l)))
                '(= (SDET R m n (MATMUL R (ELEM-F R m k l) A) s) (SDET R m n A s)))))
(dk-peel!)
(let* ((f '(ELEM-F R m k l)) (fa (lzs-mm f 'A)) (ffa (lzs-mm f fa))
       (sa '(SDET R m n A s)) (sfa (list 'SDET 'R 'm 'n fa 's)))
  (lzs-typ! f '(MAT m m (CARR R)))
  (lzs-typ! fa lzs-mmn)
  (dk-have! '(IMPLIES (= m 0) (OR (= m 0) (AND (= m 0) (= n 0)))) (lambda () (prop)))
  (dk-have! '(IMPLIES (= m 0) (OR (= n 0) (AND (= m 0) (= m 0)))) (lambda () (prop)))
  (fact 'matmul-assoc 'R 'm 'm 'm 'n f f 'A)
  (fact 'elem-f-symmetric 'R 'm 'k 'l)
  (let ((e1 (dk-fact! 'elem-f-inverse 'R 'm 'k 'l)))
    (dk-rewrite-h! e1 '(ELEM-F R m l k) f))
  (fact 'identmat-left-identity 'R 'm 'n 'A)
  (dk-have! (list '= ffa 'A)
    (lambda ()
      (subst (list '= ffa (lzs-mm (lzs-mm f f) 'A)))
      (subst (list '= (lzs-mm f f) '(IDENTMAT R m)))
      (subst (list '= (lzs-mm '(IDENTMAT R m) 'A) 'A))
      (rfl)))
  (dk-have! (list 'FORALL 'sex_ (list 'IFF (list 'IN 'sex_ sfa) (list 'IN 'sex_ sa)))
    (lambda ()
      (dk-peel!)
      (dk-iff! (lambda (g) (equal? (caddr g) sa))
        (lambda ()
          (let ((x (cadr (dk-goal))))
            (fact 'sdet-row-swap-sub 'R 'm 'n 's 'A 'k 'l x)
            (ass)))
        (lambda ()
          (let ((x (cadr (dk-goal))))
            (dk-have! (list 'IN x (list 'SDET 'R 'm 'n ffa 's))
              (lambda () (subst (list '= ffa 'A)) (ass)))
            (fact 'sdet-row-swap-sub 'R 'm 'n 's fa 'k 'l x)
            (ass))))))
  (fact 'class-extensionality sfa sa)
  (ass))
(lzs-done! 'sdet-row-swap)
(topic! 'sdet-row-swap 'algebra)
(gloss! 'sdet-row-swap "Linear algebra 3.29 (F, rows): interchanging two rows does not change the set of order-s subdeterminants.")

;; ---- G row: G[sc,k,l] A adds sc times row l to row k
(sp (make-wff (forall-guarded '(R m n s A sc k l x)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN sc (CARR R)) (IN k (INTERVAL 1 m)) (IN l (INTERVAL 1 m)) (NOT (= k l))
                  (IN x (SDET R m n (MATMUL R (ELEM-G R m sc k l) A) s)))
                (lzs-g-concl 'x 'sc))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(define (lzs-grow-main!)
  (let* ((ga (lzs-mm '(ELEM-G R m sc k l) 'A)))
    (lzs-typ! '(ELEM-G R m sc k l) '(MAT m m (CARR R)))
    (lzs-typ! ga lzs-mmn)
    (let* ((pq (lzs-sdet-open! 'x ga 'm 'n)) (p (car pq)) (q (cadr pq))
           (bm (lzs-sub 'A 's p q)) (dm (lzs-sub ga 's p q))
           (gact (dk-fact! 'elem-g-row-action 'R 'm 'n 'A 'sc 'k 'l))
           (exl (list 'FORSOME 'gcj_ (list 'AND '(IN gcj_ (INTERVAL 1 s)) (list '= (list p 'gcj_) 'k)))))
      (lzs-inj-fun! p (lzs-iv 's) (lzs-iv 'm))
      (lzs-inj-fun! q (lzs-iv 's) (lzs-iv 'n))
      (fact 'submatrix-type 'R 'm 'n 's 'A p q)
      (fact 'submatrix-type 'R 'm 'n 's ga p q)
      (fact 'sdet-intro 'R 'm 'n 's 'A p q)
      (lzs-carr! (lzs-det bm))
      (subst (list '= 'x (lzs-det dm)))
      (use-em exl
        (lambda ()                         ; row k is a row of the minor, at i0
          (let* ((i0 (dk-skolem! exl #t))
                 (pi0 (list p i0))
                 (p2 (lzs-rep-of p i0 'l))
                 (cm (lzs-sub 'A 's p2 q)))
            (lzs-idx-fun! p2 '(INTERVAL 1 m))
            (fact 'submatrix-type 'R 'm 'n 's 'A p2 q)
            (lzs-carr! (lzs-det cm))
            ;; det D = sc det C + det B, by linearity in row i0
            (let* ((lin (dk-cite! 'det-row-linear 'R 's cm bm dm i0 'sc))
                   (eqd (lzs-detach-all! lin
                          (lambda (ante)
                            (lzs-pw! (lambda (i . rest)
                              (if (null? rest)
                                  ;; row i0: D = sc C + B; here I is the COLUMN index
                                  (let* ((j i) (qj (list q j)))
                                    (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's ga p q i0 j))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p2 q i0 j))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q i0 j))
                                    (lzs-beta!)
                                    (subst (list '= pi0 'k))
                                    (subst (dk-apply! gact 'k qj))
                                    (lzs-entry! 'A 'k qj) (lzs-entry! 'A 'l qj)
                                    (lzs-if-all!
                                      (lambda ()
                                        (fact 'lzs-ring-c 'R (list 'ENTRY 'A 'k qj) (list 'ENTRY 'A 'l qj) 'sc)
                                        (ass))))
                                  ;; off row i0 (I is the row): the rows agree
                                  (let* ((j (car rest)) (pi (list p i)) (qj (list q j)))
                                    (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                                    (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                                    (lzs-entry! 'A pi qj)
                                    (dk-have! (list 'NOT (list '= pi 'k))
                                      (lambda ()
                                        (di)
                                        (dk-have! (list '= pi pi0) (lambda () (subst (list '= pi 'k)) (subst (list '= pi0 'k)) (rfl)))
                                        (lzs-inj-eq! (lzs-iv 's) (lzs-iv 'm) p i i0)
                                        (lzs-contra! (list 'NOT (list '= i i0)))))
                                    (let ((g (dk-goal)))
                                      (if (dk-contains? (cadr g) 'ELEM-G)
                                          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's ga p q i j))
                                          (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q i j))))
                                    (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p2 q i j))
                                    (if (dk-contains? (dk-goal) 'ELEM-G) (subst (dk-apply! gact pi qj)))
                                    (lzs-beta!)
                                    (lzs-if-all! lzs-close!)))))))))
              (subst eqd)
              (let ((exk (list 'FORSOME 'gck_ (list 'AND '(IN gck_ (INTERVAL 1 s)) (list '= (list p 'gck_) 'l)))))
                (use-em exk
                  (lambda ()                   ; row l is also in the minor: det C = 0
                    (let* ((i1 (dk-skolem! exk #t)) (pi1 (list p i1)))
                      (dk-have! (list 'NOT (list '= i0 i1))
                        (lambda ()
                          (di)
                          (dk-have! '(= k l)
                            (lambda () (subst (list '= 'l pi1)) (subst (list '= i1 i0)) (subst (list '= pi0 'k)) (rfl)))
                          (lzs-contra! '(NOT (= k l)))))
                      (let* ((ez (dk-cite! 'det-alternating-rows 'R 's cm i0 i1))
                             (z (lzs-detach-all! ez
                                  (lambda (ante)
                                    (lzs-pw! (lambda (j)
                                      (let ((qj (list q j)))
                                        (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                                        (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p2 q i0 j))
                                        (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p2 q i1 j))
                                        (lzs-beta!)
                                        (lzs-entry! 'A 'l qj)
                                        (lzs-if-all!
                                          (lambda ()
                                            (if (dk-contains? (dk-goal) pi1) (subst (list '= pi1 'l)))
                                            (lzs-close!))))))))))
                        (subst z)
                        (fact 'ring-zero-in 'R)
                        (lzs-g-witness! (lzs-det bm) (lzs-det bm) #t
                          (lambda ()
                            (fact 'lzs-ring-z 'R (lzs-det bm) '(ZERO R) 'sc)
                            (ass))))))
                  (lambda ()                   ; l is not a row of the minor: C is a minor of A
                    (let ((alll (list 'FORALL 'rpj_ (list 'IMPLIES '(IN rpj_ (INTERVAL 1 s)) (list 'NOT (list '= (list p 'rpj_) 'l))))))
                      (dk-have! alll
                        (lambda ()
                          (let* ((jj (car (lzs-iv-vars (dk-peel!) 's))))
                            (di)
                            (dk-have! exk (lambda () (ew jj) (dk-conj-close! (lambda () (ass)))))
                            (lzs-contra! (list 'NOT exk)))))
                      (fact 'lzs-replace-injection 's 'm p i0 'l)
                      (fact 'sdet-intro 'R 'm 'n 's 'A p2 q)
                      (lzs-g-witness! (lzs-det bm) (lzs-det cm) #f
                        (lambda ()
                          (fact 'lzs-ring-b 'R (lzs-det bm) (lzs-det cm) 'sc)
                          (ass))))))))))
        (lambda ()                         ; row k is not in the minor: D = B
          (let ((allk (list 'FORALL 'rpj_ (list 'IMPLIES '(IN rpj_ (INTERVAL 1 s)) (list 'NOT (list '= (list p 'rpj_) 'k))))))
            (dk-have! allk
              (lambda ()
                (let* ((jj (car (lzs-iv-vars (dk-peel!) 's))))
                  (di)
                  (dk-have! exl (lambda () (ew jj) (dk-conj-close! (lambda () (ass)))))
                  (lzs-contra! (list 'NOT exl)))))
            (let* ((ext (dk-cite! 'submatrix-ext 'R 'm 'n 's ga p q 'A p q))
                   (eq (lzs-detach-all! ext
                         (lambda (ante)
                           (lzs-pw! (lambda (i j)
                             (let ((pi (list p i)) (qj (list q j)))
                               (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                               (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                               (dk-apply! allk i)
                               (subst (dk-apply! gact pi qj))
                               (lzs-entry! 'A pi qj)
                               (lzs-if-all! lzs-close!))))))))
              (subst eq)
              (lzs-g-witness! (lzs-det bm) (lzs-det bm) #t
                (lambda ()
                  (fact 'lzs-ring-z0 'R (lzs-det bm) (lzs-det bm) (lzs-det bm))
                  (ass))))))))))
(lzs-grow-main!)
(lzs-done! 'sdet-row-add)
(topic! 'sdet-row-add 'algebra)
(gloss! 'sdet-row-add "Linear algebra 3.29 (G, rows): after adding sc times row l to row k, every order-s subdeterminant is a + t a' with a, a' subdeterminants of A and t = 0 or sc.")

;;; =====================================================================
;;; (6) The H operations (scaling a column or a row by sc), not in 3.29 but needed for
;;; the integral equivalence of 3.31: every subdeterminant of the scaled matrix is a
;;; subdeterminant a of A or sc a.
;;; =====================================================================
(define (lzs-h-concl x sc)
  (list 'FORSOME 'sda_ (list 'AND '(IN sda_ (SDET R m n A s))
    (list 'OR (list '= x 'sda_) (list '= x (list '(MUL R) sc 'sda_))))))
;; ROW? #f: A H[sc,k] (column k); #t: H[sc,k] A (row k)
(define (lzs-h-main! row?)
  (let* ((h (if row? '(ELEM-H R m sc k) '(ELEM-H R n sc k)))
         (ah (if row? (lzs-mm h 'A) (lzs-mm 'A h))))
    (lzs-typ! h (if row? '(MAT m m (CARR R)) '(MAT n n (CARR R))))
    (lzs-typ! ah lzs-mmn)
    (let* ((pq (lzs-sdet-open! 'x ah 'm 'n)) (p (car pq)) (q (cadr pq))
           (f (if row? p q))                         ; the index map that meets k
           (fcod (if row? (lzs-iv 'm) (lzs-iv 'n)))
           (bm (lzs-sub 'A 's p q)) (dm (lzs-sub ah 's p q))
           (hact (if row? (dk-fact! 'elem-h-row-action 'R 'm 'n 'A 'sc 'k)
                          (dk-fact! 'elem-h-action 'R 'm 'n 'A 'sc 'k)))
           (exk (list 'FORSOME 'gcj_ (list 'AND '(IN gcj_ (INTERVAL 1 s)) (list '= (list f 'gcj_) 'k)))))
      (lzs-inj-fun! p (lzs-iv 's) (lzs-iv 'm))
      (lzs-inj-fun! q (lzs-iv 's) (lzs-iv 'n))
      (fact 'submatrix-type 'R 'm 'n 's 'A p q)
      (fact 'submatrix-type 'R 'm 'n 's ah p q)
      (fact 'sdet-intro 'R 'm 'n 's 'A p q)
      (lzs-carr! (lzs-det bm))
      (subst (list '= 'x (lzs-det dm)))
      (use-em exk
        (lambda ()
          (let* ((j0 (dk-skolem! exk #t)) (fj0 (list f j0))
                 (hs (list 'ELEM-H 'R 's 'sc j0))
                 (bh (if row? (lzs-mm hs bm) (lzs-mm bm hs)))
                 (hs-act (if row? (dk-fact! 'elem-h-row-action 'R 's 's bm 'sc j0)
                                  (dk-fact! 'elem-h-action 'R 's 's bm 'sc j0))))
            (lzs-typ! hs '(MAT s s (CARR R)))
            (lzs-typ! bh '(MAT s s (CARR R)))
            (let* ((ext (dk-cite! 'matrix-entry-extensionality 's 's '(CARR R) dm bh))
                   (eq (lzs-detach-all! ext
                         (lambda (ante)
                           (lzs-pw! (lambda (u v)
                             ;; U, V: the two indices; I the row, J the column
                             (let* ((g (dk-goal))
                                    (i (caddr (cadr g))) (j (cadddr (cadr g)))
                                    (w (if row? i j))          ; the index on the side of k
                                    (pi (list p i)) (qj (list q j)) (fw (list f w)))
                               (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                               (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                               (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's ah p q i j))
                               (subst (dk-apply! hs-act i j))
                               (subst (dk-apply! hact pi qj))
                               (lzs-entry! 'A pi qj)
                               (use-em (list '= w j0)
                                 (lambda ()
                                   (subst (list '= w j0))
                                   (let ((ij0 (if row? (list j0 j) (list i j0))))
                                     (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q (car ij0) (cadr ij0))))
                                   (subst (list '= fj0 'k))
                                   (if row? (lzs-entry! 'A 'k qj) (lzs-entry! 'A pi 'k))
                                   (lzs-if-all! lzs-close!))
                                 (lambda ()
                                   (dk-have! (list 'NOT (list '= fw 'k))
                                     (lambda ()
                                       (di)
                                       (dk-have! (list '= fw fj0) (lambda () (subst (list '= fw 'k)) (subst (list '= fj0 'k)) (rfl)))
                                       (lzs-inj-eq! (lzs-iv 's) fcod f w j0)
                                       (lzs-contra! (list 'NOT (list '= w j0)))))
                                   (subst (dk-fact! 'submatrix-entry 'R 'm 'n 's 'A p q i j))
                                   (lzs-if-all! lzs-close!))))))))))
              (subst eq)
              (if row? (fact 'det-elem-h-row 'R 's bm 'sc j0) (fact 'det-elem-h-col 'R 's bm 'sc j0))
              (subst (list '= (lzs-det bh) (list '(MUL R) 'sc (lzs-det bm))))
              (ew (lzs-det bm))
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'OR) (begin (oi-r) (lzs-typ! (list '(MUL R) 'sc (lzs-det bm)) '(CARR R)) (rfl)) (ass)))))))
        (lambda ()
          (let ((allk (list 'FORALL 'rpj_ (list 'IMPLIES '(IN rpj_ (INTERVAL 1 s)) (list 'NOT (list '= (list f 'rpj_) 'k))))))
            (dk-have! allk
              (lambda ()
                (let* ((jj (car (lzs-iv-vars (dk-peel!) 's))))
                  (di)
                  (dk-have! exk (lambda () (ew jj) (dk-conj-close! (lambda () (ass)))))
                  (lzs-contra! (list 'NOT exk)))))
            (let* ((ext (dk-cite! 'submatrix-ext 'R 'm 'n 's ah p q 'A p q))
                   (eq (lzs-detach-all! ext
                         (lambda (ante)
                           (lzs-pw! (lambda (i j)
                             (let ((pi (list p i)) (qj (list q j)))
                               (lzs-app! p i (lzs-iv 's) (lzs-iv 'm))
                               (lzs-app! q j (lzs-iv 's) (lzs-iv 'n))
                               (dk-apply! allk (if row? i j))
                               (subst (dk-apply! hact pi qj))
                               (lzs-entry! 'A pi qj)
                               (lzs-if-all! lzs-close!))))))))
              (subst eq)
              (ew (lzs-det bm))
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'OR) (begin (oi-l) (rfl)) (ass)))))))))))

(sp (make-wff (forall-guarded '(R m n s A sc k x)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN sc (CARR R)) (IN k (INTERVAL 1 n))
                  (IN x (SDET R m n (MATMUL R A (ELEM-H R n sc k)) s)))
                (lzs-h-concl 'x 'sc))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(lzs-h-main! #f)
(lzs-done! 'sdet-col-scale)
(topic! 'sdet-col-scale 'algebra)
(gloss! 'sdet-col-scale "After scaling column k by sc, every order-s subdeterminant is a or sc a for a subdeterminant a of A.")

(sp (make-wff (forall-guarded '(R m n s A sc k x)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN sc (CARR R)) (IN k (INTERVAL 1 m))
                  (IN x (SDET R m n (MATMUL R (ELEM-H R m sc k) A) s)))
                (lzs-h-concl 'x 'sc))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(lzs-h-main! #t)
(lzs-done! 'sdet-row-scale)
(topic! 'sdet-row-scale 'algebra)
(gloss! 'sdet-row-scale "After scaling row k by sc, every order-s subdeterminant is a or sc a for a subdeterminant a of A.")
