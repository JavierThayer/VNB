;;; ---- (137): f(x y) <= f(x) + f(y) ----
;; with f(z) real and its bounds landed, a factorisation sum of z below f(z) + e; returns (n . u)
(define (ta5-near! z e)
  (let* ((fz (ta5-f z)) (a (list '+ fz e)) (ein (list 'EINF (ta5-FS z))))
    (dk-cite! 'subadd-reg-unfold 'm 'g z)
    (dk-cite! 'fact-sums-nonneg 'm 'g z)
    (dk-cite! 'rr-add-in-rr fz e)
    (dk-have! (list '<= 0 a) (lambda () (dk-ineq! (list '<= 0 fz) (list '< 0 e) (list 'IN fz 'RR) (list 'IN e 'RR))))
    (ta5-rps! a)
    (dk-have! (list '< ein a) (lambda () (subst (list '== ein fz)) (dk-ineq! (list '< 0 e) (list 'IN fz 'RR) (list 'IN e 'RR))))
    (dk-have! (list 'FORSOME 'wy_ (list 'AND (list 'IN 'wy_ (ta5-FS z)) (list '< 'wy_ a)))
      (lambda ()
        (use-em (list 'FORSOME 'wy_ (list 'AND (list 'IN 'wy_ (ta5-FS z)) (list '< 'wy_ a)))
          (lambda () (ta5-ass!))
          (lambda ()
            (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ (ta5-FS z)) (list '<= a 'cpsx_)))
              (lambda ()
                (let* ((yv (cadr (car (dk-peel!)))))
                  (dk-cite! 'subset-mem-fwd (ta5-FS z) 'RR-POS-STAR yv)
                  (let ((nu (ta5-fs-elim! yv z)))
                    (use-em (list '<= a yv)
                      (lambda () (ta5-ass!))
                      (lambda ()
                        (dk-cite! 'rr-not-le-lt a yv)
                        (dk-have! (list 'FORSOME 'wy_ (list 'AND (list 'IN 'wy_ (ta5-FS z)) (list '< 'wy_ a)))
                          (lambda () (ew yv) (dk-conj-close! (lambda () (ta5-ass!)))))
                        (ai (list 'NOT (list 'FORSOME 'wy_ (list 'AND (list 'IN 'wy_ (ta5-FS z)) (list '< 'wy_ a)))))))))))
            (dk-cite! 'einf-greatest (ta5-FS z) a)
            (dk-have! (list '= ein fz) (lambda () (subst (list '== ein fz)) (rfl)))
            (dk-have! (list 'IN ein 'RR) (lambda () (subst (list '= ein fz)) (ta5-ass!)))
            (dk-have! '(< 0 0)
              (lambda () (dk-ineq! (list '< ein a) (list '<= a ein) (list 'IN a 'RR) (list 'IN fz 'RR)
                                   (list 'IN ein 'RR))))
            (ai (dk-cite! 'rr-lt-irrefl 0))))))
    (let* ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'wy_) (dk-contains? h a))) "the witness")))
           (nu (ta5-fs-elim! y z)))
      (list y (car nu) (cdr nu)))))
