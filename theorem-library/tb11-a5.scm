;;; tb11-a5.scm -- topological-vector-spaces Proposition A.5 (subadditive regularisation on a
;;; monoid) and the finite-product laws it needs.  Agent ISOM, 2026-10-26.  Helper prefix: ta5-.
;;; Library: analysis (EINF, partial sums); vocabulary tb11-vocab.scm.

(define (ta5-head g) (and (pair? g) (car g)))
(define (ta5-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (ta5-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (ta5-P u k) (list 'MPROD 'm u k))
(define ta5-C '(CARR m))
(define (ta5-op a b) (list (list 'OPR 'm) a b))
;; an element of the carrier: (IN t (CARR m)) landed
(define (ta5-mul-in! a b)
  (ta5-and! '(IS-MONOID m) (list 'AND (list 'IN a ta5-C) (list 'IN b ta5-C)))
  (dk-cite! 'monoid-carrier-closed-opr 'm a b))

;;; ---- the finite product is in the carrier ----
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IS-MONOID m)
   (FORALL u (IMPLIES (IN u (FUN NN (CARR m))) (IN (MPROD m u n) (CARR m))))))))))
(define ta5-br (dk-use-induction-fixed! '(m)))   ; W1D: m fixed
(dk-focus! (cdr (assq 'base ta5-br)))
(dk-peel!)
(mac 'mprod-zero)
(fact 'monoid-identity-in 'm)
(ta5-ass!)
(dk-focus! (cdr (assq 'step ta5-br)))
(let ((k (cdr (assq 'var ta5-br))) (ih (cdr (assq 'ih ta5-br))))
  (dk-peel!)
  (dk-apply! ih 'u)   ; W1D: m fixed
  (dk-cite! 'fun-apply-type-c 'u 'NN ta5-C k)
  (fact 'mprod-succ 'm 'u k)
  (subst (list '== (ta5-P 'u (list 'succ k)) (ta5-op (ta5-P 'u k) (list 'u k))))
  (ta5-mul-in! (ta5-P 'u k) (list 'u k))
  (ta5-ass!))
(qed 'mprod-in-carr-ind)
(topic! 'mprod-in-carr-ind 'plumbing)

(sp (make-wff '(FORALL m (IMPLIES (IS-MONOID m) (FORALL u (IMPLIES (IN u (FUN NN (CARR m)))
   (FORALL n (IMPLIES (IN n NN) (IN (MPROD m u n) (CARR m))))))))))
(dk-peel!)
(let ((n (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) (dk-asms))))))
  (dk-apply! (dk-apply! (dk-cite! 'mprod-in-carr-ind n) 'm) 'u)
  (ta5-ass!))
(qed 'mprod-in-carr)
(topic! 'mprod-in-carr 'algebra)

;;; ---- the product over a shifted sequence: P(u, a + k) = P(u, a) P(u(a + .), k) ----
(define (ta5-shift u a) (list 'VNB-LAMBDA 'msi_ 'NN (list u (list '+ a 'msi_))))
;; the shifted sequence is a sequence in the carrier (u, a typed in context)
(define (ta5-shift-typed! u a)
  (let ((v (ta5-shift u a)))
    (if (not (dk-asm? (list 'IN v (list 'FUN 'NN ta5-C))))
        (dk-have! (list 'IN v (list 'FUN 'NN ta5-C))
          (lambda ()
            (for-each (lambda (leaf) (dk-focus! leaf)
                        (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                            (begin (fact 'nn-is-set) (ta5-ass!))
                            (let ((i (cadr (car (dk-peel!)))))
                              (ta5-and! (list 'IN a 'NN) (list 'IN i 'NN))
                              (fact 'nn-add-closed a i)
                              (dk-cite! 'fun-apply-type-c u 'NN ta5-C (list '+ a i))
                              (ta5-ass!))))
                      (dk-opened (lambda () (lam-t)))))))
    v))
(define (ta5-P-typed! u k) (dk-cite! 'mprod-in-carr 'm u k))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'm (list 'IMPLIES '(IS-MONOID m)
   (list 'FORALL 'u (list 'IMPLIES '(IN u (FUN NN (CARR m))) (list 'FORALL 'a (list 'IMPLIES '(IN a NN)
     (list '= (ta5-P 'u '(+ a k)) (ta5-op (ta5-P 'u 'a) (ta5-P (ta5-shift 'u 'a) 'k)))))))))))))
(define ta5-br2 (dk-use-induction-fixed! '(m)))   ; W1D: m fixed
(dk-focus! (cdr (assq 'base ta5-br2)))
(dk-peel!)
(let ((v (ta5-shift-typed! 'u 'a)))
  (ta5-P-typed! 'u 'a)
  (fact 'nn-add-zero 'a)
  (subst '(= (+ a 0) a))
  (fact 'mprod-zero 'm v)
  (subst (list '== (ta5-P v 0) '(IDEN m)))
  (dk-cite! 'monoid-right-id 'm (ta5-P 'u 'a))
  (subst (list '= (ta5-op (ta5-P 'u 'a) '(IDEN m)) (ta5-P 'u 'a)))
  (rfl))
(dk-focus! (cdr (assq 'step ta5-br2)))
(let ((k (cdr (assq 'var ta5-br2))) (ih (cdr (assq 'ih ta5-br2))))
  (dk-peel!)
  (let* ((v (ta5-shift-typed! 'u 'a))
         (ak (list '+ 'a k))
         (pa (ta5-P 'u 'a)) (qk (ta5-P v k)) (vk (list v k)) (uak (list 'u ak)))
    (dk-apply! (dk-apply! ih 'u) 'a)   ; W1D: m fixed
    (ta5-and! '(IN a NN) (list 'IN k 'NN))
    (fact 'nn-add-closed 'a k)
    (dk-cite! 'nn-add-succ 'a k)
    (ta5-P-typed! 'u 'a) (ta5-P-typed! 'u ak) (ta5-P-typed! v k)
    (dk-cite! 'fun-apply-type-c 'u 'NN ta5-C ak)
    (dk-cite! 'fun-apply-type-c v 'NN ta5-C k)
    (fact 'mprod-succ 'm 'u ak)
    (fact 'mprod-succ 'm v k)
    (dk-have! (list '= vk uak) (lambda () (if (not (dk-lam-b!)) (rfl))))
    (ta5-and! '(IS-MONOID m) (list 'AND (list 'IN pa ta5-C) (list 'AND (list 'IN qk ta5-C) (list 'IN uak ta5-C))))
    (dk-cite! 'monoid-assoc 'm pa qk uak)
    (ta5-mul-in! qk uak)
    (ta5-mul-in! pa (ta5-op qk uak))
    ;; P(u, a + succ k) = P(u, succ(a + k)) = P(u, a + k) u(a + k) = (P_a Q_k) u(a+k) = P_a (Q_k u(a+k)) = P_a Q_{succ k}
    (subst (list '= (list '+ 'a (list 'succ k)) (list 'succ ak)))
    (subst (list '== (ta5-P 'u (list 'succ ak)) (ta5-op (ta5-P 'u ak) uak)))
    (subst (list '== (ta5-P v (list 'succ k)) (ta5-op qk vk)))
    (subst (list '= vk uak))
    (subst (list '= (ta5-P 'u ak) (ta5-op pa qk)))
    (subst (list '= (ta5-op (ta5-op pa qk) uak) (ta5-op pa (ta5-op qk uak))))
    (rfl)))
(qed 'mprod-shift-split-ind)
(topic! 'mprod-shift-split-ind 'plumbing)

;;; ---- the partial sum over a shifted sequence: S(f, a + k) = S(f, a) + S(f(a + .), k) ----
(define (ta5-S f k) (list 'SERIES-PARTIAL-SUM f k))
(define (ta5-shift-rr-typed! f a)
  (let ((w (ta5-shift f a)))
    (if (not (dk-asm? (list 'IN w '(FUN NN RR))))
        (dk-have! (list 'IN w '(FUN NN RR))
          (lambda ()
            (for-each (lambda (leaf) (dk-focus! leaf)
                        (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                            (begin (fact 'nn-is-set) (ta5-ass!))
                            (let ((i (cadr (car (dk-peel!)))))
                              (ta5-and! (list 'IN a 'NN) (list 'IN i 'NN))
                              (fact 'nn-add-closed a i)
                              (dk-cite! 'fun-apply-type-c f 'NN 'RR (list '+ a i))
                              (ta5-ass!))))
                      (dk-opened (lambda () (lam-t)))))))
    w))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR))
   (list 'FORALL 'a (list 'IMPLIES '(IN a NN)
     (list '= (ta5-S 'f '(+ a k)) (list '+ (ta5-S 'f 'a) (ta5-S (ta5-shift 'f 'a) 'k)))))))))))
(define ta5-br3 (use-induction))
(dk-focus! (cdr (assq 'base ta5-br3)))
(dk-peel!)
(let ((w (ta5-shift-rr-typed! 'f 'a)))
  (dk-cite! 'series-partial-sum-in-rr 'a 'f)
  (fact 'nn-add-zero 'a)
  (subst '(= (+ a 0) a))
  (fact 'series-partial-sum-zero w)
  (subst (list '== (ta5-S w 0) 0))
  (dk-ineq! (list 'IN (ta5-S 'f 'a) 'RR)))
(dk-focus! (cdr (assq 'step ta5-br3)))
(let ((k (cdr (assq 'var ta5-br3))) (ih (cdr (assq 'ih ta5-br3))))
  (dk-peel!)
  (let* ((w (ta5-shift-rr-typed! 'f 'a))
         (ak (list '+ 'a k)) (fak (list 'f ak)) (wk (list w k))
         (sa (ta5-S 'f 'a)) (swk (ta5-S w k)) (sak (ta5-S 'f ak)))
    (dk-apply! (dk-apply! ih 'f) 'a)
    (ta5-and! '(IN a NN) (list 'IN k 'NN))
    (fact 'nn-add-closed 'a k)
    (dk-cite! 'nn-add-succ 'a k)
    (dk-cite! 'series-partial-sum-in-rr 'a 'f)
    (dk-cite! 'series-partial-sum-in-rr ak 'f)
    (dk-cite! 'series-partial-sum-in-rr k w)
    (dk-cite! 'fun-apply-type-c 'f 'NN 'RR ak)
    (dk-cite! 'fun-apply-type-c w 'NN 'RR k)
    (dk-cite! 'series-partial-sum-succ 'f ak)
    (dk-cite! 'series-partial-sum-succ w k)
    (dk-have! (list '= wk fak) (lambda () (if (not (dk-lam-b!)) (rfl))))
    (subst (list '= (list '+ 'a (list 'succ k)) (list 'succ ak)))
    (subst (list '== (ta5-S 'f (list 'succ ak)) (list '+ sak fak)))
    (subst (list '== (ta5-S w (list 'succ k)) (list '+ swk wk)))
    (dk-ineq! (list '= sak (list '+ sa swk)) (list '= wk fak)
              (list 'IN sa 'RR) (list 'IN swk 'RR) (list 'IN sak 'RR) (list 'IN fak 'RR) (list 'IN wk 'RR))))
(qed 'partial-sum-shift-split-ind)
(topic! 'partial-sum-shift-split-ind 'plumbing)

;;; ---- the split point of (140)-(142): a q <= N with 2 S(q) <= S and 2 (S - S(q+1)) <= S ----
(define (ta5-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (ai (dk-cite! 'rr-lt-irrefl 0)))
(define ta5-half-concl
  '(FORSOME q (AND (IN q NN) (AND (<= q N)
     (AND (<= (* 2 (SERIES-PARTIAL-SUM f q)) (SERIES-PARTIAL-SUM f (succ N)))
          (<= (* 2 (- (SERIES-PARTIAL-SUM f (succ N)) (SERIES-PARTIAL-SUM f (succ q)))) (SERIES-PARTIAL-SUM f (succ N))))))))
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR))
   (list 'IMPLIES '(FORALL i (IMPLIES (IN i NN) (<= 0 (f i))))
     (list 'FORALL 'N (list 'IMPLIES '(IN N NN) ta5-half-concl)))))))
(dk-peel!)
(dk-cite! 'nn-succ-closed 'N)
(define ta5-SN '(SERIES-PARTIAL-SUM f (succ N)))
(define (ta5-Sf k) (list 'SERIES-PARTIAL-SUM 'f k))
(define (ta5-ps! k)                     ; PS(f, k) real and >= 0
  (if (not (dk-asm? (list 'IN (ta5-Sf k) 'RR)))
      (begin (dk-cite! 'series-partial-sum-in-rr k 'f)
             (dk-cite! 'series-partial-sum-nonneg k 'f))))
(ta5-ps! '(succ N))
(define (ta5-q-close! q a b)            ; witness q with the two inequalities a, b proved by thunks
  (ew q)
  (dk-conj-close!
   (lambda ()
     (let ((g (dk-goal)))
       (cond ((dk-head-is? g 'IN) (ta5-ass!))
             ((and (dk-head-is? g '<=) (symbol? (cadr g))) (b))
             ((dk-contains? g (list 'succ q)) (a))
             (#t (a)))))))
(use-em (list '<= ta5-SN 0)
  ;; S = 0: q = N
  (lambda ()
    (ta5-ps! 'N)
    (dk-cite! 'nn-le-refl 'N)
    (dk-apply! (dk-cite! 'series-partial-sum-monotone-nonneg 'f) 'N)
    (ew 'N)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond ((dk-head-is? g 'IN) (ta5-ass!))
               ((and (dk-head-is? g '<=) (eq? (cadr g) 'N)) (ta5-ass!))
               (#t (dk-ineq! (list '<= ta5-SN 0) (list '<= 0 (ta5-Sf 'N)) (list '<= (ta5-Sf 'N) ta5-SN)
                             (list '<= 0 ta5-SN) (list 'IN ta5-SN 'RR) (list 'IN (ta5-Sf 'N) 'RR))))))))
  ;; S > 0: q + 1 is the least j with S < 2 S(j)
  (lambda ()
    (dk-cite! 'rr-not-le-lt ta5-SN 0)
    (let* ((T (list 'SEP 'tj_ 'NN (list '< ta5-SN (list '* 2 (ta5-Sf 'tj_))))))
      (dk-have! (list 'SUBSET T 'NN)
        (lambda () (mac 'subset-def)
                   (let ((v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                     (sep-me (list 'IN v T)) (ta5-ass!))))
      (dk-have! (list 'IN '(succ N) T)
        (lambda () (in-sep! (lambda () (dk-ineq! (list '< 0 ta5-SN) (list 'IN ta5-SN 'RR))))))
      (dk-have! (list 'FORSOME 'tn_ (list 'IN 'tn_ T)) (lambda () (ew '(succ N)) (ta5-ass!)))
      (ta5-and! (list 'SUBSET T 'NN) (list 'FORSOME 'tn_ (list 'IN 'tn_ T)))
      (let* ((j0 (dk-skolem! (dk-cite! 'nn-least-element T)))
             (mc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h j0))) "minimality")))
        (dk-have! (list 'IN j0 'NN) (lambda () (sep-me (list 'IN j0 T)) (ta5-ass!)))
        (dk-have! (list '< ta5-SN (list '* 2 (ta5-Sf j0))) (lambda () (sep-me (list 'IN j0 T)) (ta5-ass!)))
        (ta5-ps! j0)
        (dk-have! (list 'NOT (list '= j0 0))
          (lambda ()
            (di)
            (fact 'series-partial-sum-zero 'f)
            (dk-have! (list '= (ta5-Sf j0) 0) (lambda () (subst (list '= j0 0)) (subst (list '== (ta5-Sf 0) 0)) (arith)))
            (ta5-absurd! (list '< ta5-SN (list '* 2 (ta5-Sf j0))) (list '= (ta5-Sf j0) 0) (list '< 0 ta5-SN)
                         (list 'IN ta5-SN 'RR) (list 'IN (ta5-Sf j0) 'RR))))
        (let* ((q (dk-skolem! (dk-cite! 'nn-nonzero-is-succ j0)))
               (sq (list 'succ q)))
          (dk-cite! 'nn-succ-closed q)
          (dk-apply! mc '(succ N))
          (dk-have! (list '<= q 'N) (lambda () (dk-nn! (list '<= j0 '(succ N)) (list '= j0 sq))))
          (ta5-ps! q)
          (ta5-ps! sq)
          (dk-have! (list '= (ta5-Sf j0) (ta5-Sf sq)) (lambda () (subst (list '= j0 sq)) (rfl)))
          (dk-have! (list '<= (list '* 2 (ta5-Sf q)) ta5-SN)
            (lambda ()
              (use-em (list '<= (list '* 2 (ta5-Sf q)) ta5-SN)
                (lambda () (ta5-ass!))
                (lambda ()
                  (dk-cite! 'rr-mul-in-rr 2 (ta5-Sf q))
                  (dk-cite! 'rr-not-le-lt (list '* 2 (ta5-Sf q)) ta5-SN)
                  (dk-have! (list 'IN q T) (lambda () (in-sep! (lambda () (ta5-ass!)))))
                  (dk-apply! mc q)
                  (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= j0 q) (list '= j0 sq))))
                  (ai (dk-cite! 'rr-lt-irrefl 0))))))
          (ta5-q-close! q
            (lambda () (dk-ineq! (list '< ta5-SN (list '* 2 (ta5-Sf j0))) (list '= (ta5-Sf j0) (ta5-Sf sq))
                                 (list 'IN ta5-SN 'RR) (list 'IN (ta5-Sf j0) 'RR) (list 'IN (ta5-Sf sq) 'RR)))
            (lambda () (ta5-ass!))))))))
(qed 'partial-sum-half-split)
(topic! 'partial-sum-half-split 'plumbing)

;;; =====================================================================
;;; (139): g(x_1 ... x_n) <= 2 (g(x_1) + ... + g(x_n)), by complete induction
;;; =====================================================================
(define ta5-g3 '(FORALL x (IMPLIES (IN x (CARR m)) (FORALL y (IMPLIES (IN y (CARR m)) (FORALL z (IMPLIES (IN z (CARR m))
                  (<= (g ((OPR m) ((OPR m) x y) z)) (* 2 (MAX (g x) (MAX (g y) (g z))))))))))))
(define (ta5-gauge body)
  (list 'FORALL 'm (list 'IMPLIES '(IS-MONOID m) (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN (CARR m) RR))
    (list 'IMPLIES '(FORALL x (IMPLIES (IN x (CARR m)) (<= 0 (g x))))
      (list 'IMPLIES '(= (g (IDEN m)) 0)
        (list 'IMPLIES ta5-g3 body))))))))
(define (ta5-gu u) (list 'VNB-LAMBDA 'msi_ 'NN (list 'g (list u 'msi_))))
(define (ta5-claim n)
  (list 'FORALL 'u (list 'IMPLIES '(IN u (FUN NN (CARR m)))
    (list '<= (list 'g (ta5-P 'u n)) (list '* 2 (ta5-S (ta5-gu 'u) n))))))
;; g x real and >= 0, for x in the carrier
(define (ta5-g! x)
  (if (not (dk-asm? (list '<= 0 (list 'g x))))
      (begin
        (dk-cite! 'fun-apply-type-c 'g ta5-C 'RR x)
        (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (alpha-equiv? h '(FORALL x (IMPLIES (IN x (CARR m)) (<= 0 (g x))))))) "g >= 0") x))))
;; (IN t (CARR m)) for t = (w k), w a sequence symbol in FUN(NN, CARR m), k in NN or a sum of two
(define (ta5-carr! t)
  (if (pair? t) (ta5-carr1! t)))
(define (ta5-carr1! t)
  (let ((w (car t)) (k (cadr t)))
    (if (and (pair? k) (eq? (car k) '+))
        (begin (ta5-and! (list 'IN (cadr k) 'NN) (list 'IN (caddr k) 'NN))
               (fact 'nn-add-closed (cadr k) (caddr k))))
    (if (and (pair? k) (eq? (car k) 'NN-MINUS))
        (dk-cite! 'nn-minus-in-nn (cadr k) (caddr k)))
    (dk-cite! 'fun-apply-type-c w 'NN ta5-C k)))
;; gu(u) is a nonnegative real sequence (u in FUN(NN, CARR m) in context)
(define (ta5-gu-typed! u)
  (let ((f (ta5-gu u)))
    (if (not (dk-asm? (list 'IN f '(FUN NN RR))))
        (begin
          (dk-have! (list 'IN f '(FUN NN RR))
            (lambda ()
              (for-each (lambda (leaf) (dk-focus! leaf)
                          (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                              (begin (fact 'nn-is-set) (ta5-ass!))
                              (let ((i (cadr (car (dk-peel!)))))
                                (dk-cite! 'fun-apply-type-c u 'NN ta5-C i)
                                (ta5-g! (list u i))
                                (ta5-ass!))))
                        (dk-opened (lambda () (lam-t))))))
          (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list '<= 0 (list f 'i))))
            (lambda ()
              (let ((i (cadr (car (dk-peel!)))))
                (dk-cite! 'fun-apply-type-c u 'NN ta5-C i)
                (dk-lam-b!)
                (let ((t (cadr (caddr (dk-goal)))))
                  (if (dk-head-is? t 'IF)
                      (dk-case-if! t (lambda (tv val) (ta5-carr! val) (ta5-g! val) (ta5-ass!)))
                      (begin (ta5-carr! t) (ta5-g! t) (ta5-ass!)))))))))
    f))

(sp (make-wff (list 'FORALL 'nb_ (list 'IMPLIES '(IN nb_ NN)
   (ta5-gauge (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= n nb_) (ta5-claim 'n)))))))))
(define ta5-br4 (dk-use-induction-fixed! '(m g)))   ; W1D: m, g and the gauge hypotheses fixed
;; ---- base: n = 0 ----
(dk-focus! (cdr (assq 'base ta5-br4)))
(let* ((pl (dk-peel!))
       (n (cadr (car (filter (lambda (q) (and (dk-head-is? q '<=) (equal? (caddr q) 0))) pl)))))
  (dk-cite! 'nn-le-zero-is-zero n)
  (subst (list '= n 0))
  (fact 'mprod-zero 'm 'u)
  (subst (list '== (ta5-P 'u 0) '(IDEN m)))
  (fact 'series-partial-sum-zero (ta5-gu 'u))
  (subst (list '== (ta5-S (ta5-gu 'u) 0) 0))
  (subst '(= (g (IDEN m)) 0))
  (arith))
;; ---- step ----
(dk-focus! (cdr (assq 'step ta5-br4)))
(define ta5-N (cdr (assq 'var ta5-br4)))
(define ta5-ih (cdr (assq 'ih ta5-br4)))
(define (ta5-ih-at! j u)                ; j <= N in context: land g(P(u, j)) <= 2 S(gu(u), j)
  (dk-apply! (dk-apply! (dk-apply! ta5-ih j) u)))   ; W1D: m, g fixed
(define (ta5-step-claim! u)
  ;; g(P(u, succ N)) <= 2 S(gu(u), succ N), for u in FUN(NN, CARR m) in context
  (let* ((N ta5-N) (sN (list 'succ N))
         (f (ta5-gu-typed! u))
         (S (ta5-S f sN))
         (dummy (begin (dk-cite! 'nn-succ-closed N) (dk-cite! 'series-partial-sum-in-rr sN f)))
         (q (dk-skolem! (dk-apply! (dk-cite! 'partial-sum-half-split f) N)))
         (sq (list 'succ q))
         (dummy2 (begin (dk-cite! 'nn-succ-closed q)
                        (dk-have! (list '<= sq sN) (lambda () (dk-nn! (list '<= q N))))))
         (r (dk-skolem! (dk-cite! 'nn-le-gap sN sq)))
         (v (ta5-shift-typed! u sq))
         (gv (ta5-gu-typed! v))
         (pq (ta5-P u q)) (uq (list u q)) (qprod (ta5-P v r))
         (W (ta5-op (ta5-op pq uq) qprod)))
    (dk-have! (list '<= r N) (lambda () (dk-nn! (list '= sN (list '+ sq r)))))
    (dk-cite! 'fun-apply-type-c u 'NN ta5-C q)
    (ta5-P-typed! u q)
    (ta5-P-typed! v r)
    (ta5-P-typed! u sq)
    (ta5-g! pq) (ta5-g! uq) (ta5-g! qprod)
    (ta5-mul-in! pq uq)
    (ta5-mul-in! (ta5-op pq uq) qprod)
    (ta5-g! W)
    ;; the product splits as (P_q u_q) qprod
    (dk-cite! 'mprod-shift-split-ind r 'm u sq)
    (fact 'mprod-succ 'm u q)
    (dk-have! (list '= (ta5-P u sN) W)
      (lambda ()
        (subst (list '= sN (list '+ sq r)))
        (subst (list '= (ta5-P u (list '+ sq r)) (ta5-op (ta5-P u sq) qprod)))
        (subst (list '== (ta5-P u sq) (ta5-op pq uq)))
        (rfl)))
    ;; the gauge inequality at (P_q, u_q, qprod)
    (dk-apply! (dk-pick (lambda (h) (alpha-equiv? h ta5-g3)) "the gauge inequality") pq uq qprod)
    ;; the three bounds
    (ta5-ih-at! q u)
    (ta5-ih-at! r v)
    (dk-cite! 'partial-sum-shift-split-ind r f sq)
    (let ((sh (ta5-shift f sq)))
      (ta5-shift-rr-typed! f sq)
      (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ r) (list 'IN (list gv 'tck_) 'RR))))
        (lambda () (let ((k (cadr (car (dk-peel!))))) (dk-cite! 'fun-apply-type-c gv 'NN 'RR k) (ta5-ass!))))
      (dk-have! (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (list 'IMPLIES (list '< 'tck_ r) (list '= (list sh 'tck_) (list gv 'tck_)))))
        (lambda ()
          (let ((k (cadr (car (dk-peel!)))))
            (ta5-and! (list 'IN sq 'NN) (list 'IN k 'NN))
            (fact 'nn-add-closed sq k)
            (dk-cite! 'fun-apply-type-c u 'NN ta5-C (list '+ sq k))
            (ta5-g! (list u (list '+ sq k)))
            (if (not (dk-lam-b!)) (rfl)))))
      (dk-cite! 'series-partial-sum-agree-below r sh gv)
      (let* ((sq-sum (ta5-S f sq)) (s-q (ta5-S f q)) (s-v (ta5-S gv r)) (s-sh (ta5-S sh r)))
        (dk-cite! 'series-partial-sum-in-rr q f)
        (dk-cite! 'series-partial-sum-nonneg q f)
        (dk-cite! 'series-partial-sum-in-rr sq f)
        (dk-cite! 'series-partial-sum-in-rr r gv)
        (dk-cite! 'series-partial-sum-nonneg r gv)
        (dk-cite! 'series-partial-sum-in-rr r sh)
        (dk-cite! 'fun-apply-type-c f 'NN 'RR q)
        (dk-cite! 'series-partial-sum-succ f q)
        (dk-have! (list '= (list f q) (list 'g uq)) (lambda () (if (not (dk-lam-b!)) (rfl))))
        (dk-have! (list '= sq-sum (list '+ s-q (list f q))) (lambda () (subst (list '== sq-sum (list '+ s-q (list f q)))) (rfl)))
        (dk-have! (list '= S (list '+ sq-sum s-sh)) (lambda () (subst (list '= sN (list '+ sq r))) (ta5-ass!)))
        (let ((prem (list (list 'IN S 'RR) (list 'IN sq-sum 'RR) (list 'IN s-q 'RR) (list 'IN s-v 'RR) (list 'IN s-sh 'RR)
                          (list 'IN (list f q) 'RR) (list 'IN (list 'g pq) 'RR) (list 'IN (list 'g uq) 'RR) (list 'IN (list 'g qprod) 'RR)
                          (list '<= 0 s-q) (list '<= 0 s-v) (list '= (list f q) (list 'g uq))
                          (list '= sq-sum (list '+ s-q (list f q))) (list '= S (list '+ sq-sum s-sh)) (list '= s-sh s-v))))
          (dk-have! (list '<= (list 'g pq) S)
            (lambda () (apply dk-ineq! (append (list (list '<= (list 'g pq) (list '* 2 s-q)) (list '<= (list '* 2 s-q) S)) prem))))
          (dk-have! (list '<= (list 'g uq) S) (lambda () (apply dk-ineq! prem)))
          (dk-have! (list '<= (list 'g qprod) S)
            (lambda () (apply dk-ineq! (append (list (list '<= (list 'g qprod) (list '* 2 s-v))
                                                     (list '<= (list '* 2 (list '- S (ta5-S f sq))) S)) prem))))
          (let ((m23 (list 'MAX (list 'g uq) (list 'g qprod))))
            (dk-cite! 'rr-max-le (list 'g uq) (list 'g qprod) S)
            (dk-cite! 'rr-max-closed (list 'g uq) (list 'g qprod))
