            (dk-cite! 'rr-max-closed (list 'g pq) m23)
            (dk-have! (list '<= (list 'g (ta5-P u sN)) (list '* 2 S))
              (lambda ()
                (subst (list '= (ta5-P u sN) W))
                (dk-ineq! (list '<= (list 'g W) (list '* 2 (list 'MAX (list 'g pq) m23)))
                          (list '<= (list 'MAX (list 'g pq) m23) S)
                          (list 'IN (list 'g W) 'RR) (list 'IN (list 'MAX (list 'g pq) m23) 'RR) (list 'IN S 'RR))))))))))
(let* ((pl (dk-peel!))
       (le (car (filter (lambda (q) (and (dk-head-is? q '<=) (equal? (caddr q) (list 'succ ta5-N)))) pl)))
