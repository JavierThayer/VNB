;;; a factorisation sum: open (IN r (FACT-SUMS m g x)) into n, u with P(u, n) = x and r = S(gu(u), n)
;;; returns (n . u)
(define (ta5-fs-elim! r x)
  (dk-cite! 'fact-sums-unfold 'm 'g x)
  (let* ((h (dk-rewrite-h! (list 'IN r (ta5-FS x)) (ta5-FS x) (ta5-FSsep x))))
    (sep-me h)
    (let* ((ex (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q x) (dk-contains? q r))) "the factorisation"))
           (n (dk-skolem! ex))
           (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q n))) "the sequence"))
           (u (dk-skolem! ex2)))
      (dk-split-all!)
      (cons n u))))
