;;; rb2-path.scm -- path-connectedness in a metric space (vocabulary IS-PATH-CONNECTED, rb2-vocab).
;;;   path-connected-implies-connected  IS-PATH-CONNECTED(s, A) => IS-CONNECTED(s, A)
;;;   cc-convex-path-connected          IS-CONVEX-CC(A) => IS-PATH-CONNECTED(CC-MS, A)
;;;   rr-convex-path-connected          IS-CONVEX-RR(A) => IS-PATH-CONNECTED(RR-MS, A)
;;; The first is the clopen argument on [0, 1]: P = {t : gamma(t) in U} and Q = {t : gamma(t) in V}
;;; are relatively open, cover [0, 1] and are disjoint; unit-interval-clopen
;;; (scratchpad/camontel/ca-connected.scm, unwired) gives 1 in P.  The convex sets are joined by
;;; segments t |-> x + t (y - x), Lipschitz in t.  Helper prefix rbp-.

(define (rbp-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rbp-pick: nothing matching" what) (car l))))
(define (rbp-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define rbp-I '(CCINT 0 1))
(define rbp-SUBI (list 'SUBSPACE-MS 'RR-MS rbp-I))
(define (rbp-open X)
  (list 'FORALL 'cts_ (list 'IMPLIES (list 'IN 'cts_ rbp-I) (list 'IMPLIES (list 'IN 'cts_ X)
    (list 'FORSOME 'ctd_ (list 'AND '(POS-RR ctd_)
      (list 'FORALL 'ctu_ (list 'IMPLIES (list 'IN 'ctu_ rbp-I)
        (list 'IMPLIES '(< (abs (- ctu_ cts_)) ctd_) (list 'IN 'ctu_ X))))))))))
(define (rbp-cover P Q)
  (list 'FORALL 'ctv_ (list 'IMPLIES (list 'IN 'ctv_ rbp-I) (list 'OR (list 'IN 'ctv_ P) (list 'IN 'ctv_ Q)))))
(define (rbp-disj P Q)
  (list 'FORALL 'ctv_ (list 'IMPLIES (list 'IN 'ctv_ rbp-I) (list 'NOT (list 'AND (list 'IN 'ctv_ P) (list 'IN 'ctv_ Q))))))
(define (rbp-only-prop! . fs) (dk-close-if! (lambda () (apply dk-only! fs)) prop))
;; t in [0,1]: land t in RR, 0 <= t, t <= 1
(define (rbp-unit! t)
  (dk-project! (list 'IN t 'RR) 'ccint-membership (list 'IN t rbp-I))
  (dk-project! (list '<= 0 t) 'ccint-membership (list 'IN t rbp-I))
  (dk-project! (list '<= t 1) 'ccint-membership (list 'IN t rbp-I)))
;; the [0,1] setting: I a set, PTS(SUBI) == I, SUBI a metric space, the distance on I
(define rbp-ptsI #f)
(define (rbp-I-setting!)
  (fact 'rr-is-set) (fact 'rr-zero-in) (fact 'rr-one-in)
  (fact 'rr-is-metric-space)
  (dk-cite! 'ccint-subset-rr 0 1)
  (dk-cite! 'subclass-of-set-is-set rbp-I 'RR)
  (set! rbp-ptsI (dk-cite! 'subspace-pts 'RR-MS rbp-I))
  (let ((rp (dk-cite! 'r7q-rr-pts)))
    (dk-have! (list 'SUBSET rbp-I '(PTS RR-MS)) (lambda () (subst (list '== '(PTS RR-MS) 'RR)) (ass))))
  (dk-cite! 'subspace-is-metric-space 'RR-MS rbp-I))
;; a, b in I: land (== dist_SUBI(a, b) (abs (- a b))) ... returned as the equation dist = abs(b - a)
(define (rbp-dist-I! a b)
  (let* ((sd (dk-cite! 'subspace-dist 'RR-MS rbp-I a b))
         (rd (dk-cite! 'rr-ms-dist a b))
         (dd (list (list 'DIST rbp-SUBI) a b)))
    (rbp-rr! (list '- a b)) (rbp-rr! (list '- b a))
    (dk-cite! 'rr-abs-sub-sym a b)
    (dk-have! (list '= dd (list 'abs (list '- b a)))
      (lambda () (subst sd) (subst rd) (ass)))
    (list '= dd (list 'abs (list '- b a)))))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL s (FORALL a (IMPLIES (IS-PATH-CONNECTED s a) (IS-CONNECTED s a))))))
(dk-peel!)
(define rbp-pc (rbp-pick 'pc (lambda (z) (dk-head-is? z 'IS-PATH-CONNECTED))))
(define rbp-s (cadr rbp-pc))
(define rbp-A (caddr rbp-pc))
(dk-project! (list 'IS-METRIC-SPACE rbp-s) 'is-path-connected rbp-pc)
(dk-project! (list 'SUBSET rbp-A (list 'PTS rbp-s)) 'is-path-connected rbp-pc)
(define rbp-paths
  (dk-project! (caddr (caddr (caddr (dk-cite! 'is-path-connected rbp-s rbp-A))))
               'is-path-connected rbp-pc))
(rbp-I-setting!)
;;; the separation context of IS-CONNECTED: x in A n U, y in A n V; close FALSITY
(define (rbp-main! x y)
  (let* ((ex (dk-apply! rbp-paths x y))
         (g  (dk-skolem! ex #t))
         (Uo 'cnu_) (Vo 'cnv_)
         (P (list 'SEP 'pw_ 'RR (list 'IN (list g 'pw_) Uo)))
         (Q (list 'SEP 'pw_ 'RR (list 'IN (list g 'pw_) Vo)))
         (dj (rbp-pick 'disjoint (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'NOT) (dk-contains? z Uo) (dk-contains? z Vo)))))
         (cont (rbp-pick 'cont (lambda (z) (and (dk-head-is? z 'IS-CONTINUOUS) (eq? (cadddr z) g)))))
         (call (dk-project! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a (list 'PTS rbp-SUBI)) (list 'IS-CONTINUOUS-AT rbp-SUBI rbp-s g 'a)))
                            'is-continuous cont)))
    (define (in-set! t Xs Ps)
      (dk-have! (list 'IN t Ps) (lambda () (in-sep! (lambda () (ass))))))
    (define (proj! t Xs Ps)
      (dk-project! (list 'IN (list g t) Xs) (lambda () (sep-me (list 'IN t Ps)))))
    (define (in-A! t)
      (dk-cite! 'fun-apply-type-c g rbp-I rbp-A t)
      (dk-cite! 'subset-mem-fwd rbp-A (list 'PTS rbp-s) (list g t)))
    ;; cover
    (dk-have! (rbp-cover P Q)
      (lambda ()
        (let ((t (dk-di-var!)))
          (rbp-unit! t)
          (in-A! t)
          (dk-cite! 'subset-mem-fwd rbp-A (list 'UNION Uo Vo) (list g t))
          (let* ((ui (dk-cite! 'union-membership Uo Vo (list g t)))
                 (or2 (list 'OR (list 'IN (list g t) Uo) (list 'IN (list g t) Vo))))
            (dk-have! or2 (lambda () (rbp-only-prop! ui (list 'IN (list g t) (list 'UNION Uo Vo)))))
            (use-cases or2
              (lambda () (in-set! t Uo P) (oi-l) (ass))
              (lambda () (in-set! t Vo Q) (oi-r) (ass)))))))
    ;; disjoint
    (dk-have! (rbp-disj P Q)
      (lambda ()
        (let ((t (dk-di-var!)))
          (di)
          (dk-split-all!)
          (proj! t Uo P) (proj! t Vo Q)
          (rbp-unit! t)
          (in-A! t)
          (let ((d1 (dk-apply! dj (list g t))))
            (rbp-only-prop! d1 (list 'IN (list g t) Uo) (list 'IN (list g t) Vo))))))
    ;; relatively open
    (define (open! Xs Ps)
      (dk-have! (rbp-open Ps)
        (lambda ()
          (let* ((pl (dk-peel!))
                 (t0 (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) rbp-I))) pl)))))
            (rbp-unit! t0)
            (proj! t0 Xs Ps)
            (in-A! t0)
            (let* ((op (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y Xs)
                                     (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (list 'BALL rbp-s 'y 'r) Xs)))))
                                   'is-open (list 'IS-OPEN rbp-s Xs)))
                   (rb (dk-skolem! (dk-apply! op (list g t0)) #t)))
              (dk-cite! 'rr-pos-rr-in-rr rb) (dk-cite! 'rr-lt-of-pos-rr rb)
              (let* ((hb (dk-halve! rb))
                     (ip (dk-have! (list 'IN t0 (list 'PTS rbp-SUBI)) (lambda () (subst rbp-ptsI) (ass))))
                     (cat (dk-apply! call t0))
                     (fa (dk-project! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
                            (list 'FORSOME 'delta (list 'AND '(POS-RR delta)
                              (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b (list 'PTS rbp-SUBI))
                                (list 'IMPLIES (list '<= (list (list 'DIST rbp-SUBI) t0 'b) 'delta)
                                  (list '<= (list (list 'DIST rbp-s) (list g t0) (list g 'b)) 'eps))))))))
                           'is-continuous-at cat))
                     (d (dk-skolem! (dk-apply! fa hb) #t))
                     (ub (rbp-pick 'ub (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z d) (dk-contains? z g))))))
                (dk-cite! 'rr-pos-rr-in-rr d)
                (ew d)
                (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'POS-RR)
                       (ass)
                       (let* ((pl2 (dk-peel!))
                              (u (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) rbp-I))) pl2))))
                              (dsub (list (list 'DIST rbp-SUBI) t0 u)))
                         (rbp-unit! u)
                         (in-A! u)
                         (dk-have! (list 'IN u (list 'PTS rbp-SUBI)) (lambda () (subst rbp-ptsI) (ass)))
                         (let ((eqd (rbp-dist-I! t0 u)))
                           (dk-cite! 'metric-dist-real rbp-SUBI t0 u)
                           (dk-have! (list '<= dsub d)
                             (lambda () (dk-ineq! eqd (list '< (list 'abs (list '- u t0)) d)))))
                         (dk-apply! ub u)
                         (dk-cite! 'metric-dist-real rbp-s (list g t0) (list g u))
                         (dk-have! (list '< hb rb)
                           (lambda () (dk-ineq! (list '= (list '+ hb hb) rb) (list '< 0 hb))))
                         (detach-with! (dk-cite! 'ball-mem-from-le rbp-s (list g t0) (list g u) hb rb)
                                       (lambda () (dk-conj-close! (lambda () (ass)))))
                         (dk-cite! 'subset-mem-fwd (list 'BALL rbp-s (list g t0) rb) Xs (list g u))
                         (in-sep! (lambda () (ass)))))))))))))
    (open! Uo P)
    (open! Vo Q)
    (dk-have! (list 'IN 0 P) (lambda () (in-sep! (lambda () (subst (list '= (list g 0) x)) (ass)))))
    (let ((all (dk-cite! 'unit-interval-clopen P Q)))
      (dk-have! (list 'IN 1 rbp-I)
        (lambda () (mac 'ccint-membership)
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!))))))
      (dk-apply! all 1)
      (proj! 1 Uo P)
      (dk-rewrite-h! (list 'IN (list g 1) Uo) (list g 1) y)
      (let ((d1 (dk-apply! dj y)))
        (rbp-only-prop! d1 (list 'IN y Uo) (list 'IN y Vo))))))

(define rbp-ci (dk-cite! 'is-connected rbp-s rbp-A))
(define rbp-rhs (caddr rbp-ci))
(dk-have! rbp-rhs
  (lambda ()
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (if (dk-asm? g)
             (ass)
             (begin
               (dk-peel!)
               (if (dk-head-is? (dk-goal) 'NOT) (di))
               (let* ((x (dk-skolem! (rbp-pick 'x-in-U (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'cnu_)))) #t))
                      (y (dk-skolem! (rbp-pick 'y-in-V (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'cnv_)))) #t)))
                 (rbp-main! x y)))))))))
(if (dk-close-if! (lambda () (dk-only! rbp-ci rbp-rhs)) prop) #t)
(qed 'path-connected-implies-connected)

;;; ---------------------------------------------------------------------------
;;; convex sets are path-connected: the segment path
(sp (make-wff '(FORALL a (IMPLIES (IS-CONVEX-RR a)
   (FORALL x (IMPLIES (IN x a) (FORALL y (IMPLIES (IN y a) (FORALL t (IMPLIES (IN t (CCINT 0 1))
     (IN (+ x (* t (- y x))) a)))))))))))
(dk-peel!)
(let* ((h (rbp-pick 'cv (lambda (z) (dk-head-is? z 'IS-CONVEX-RR))))
       (pf (dk-project! (caddr (caddr (dk-cite! 'is-convex-rr (cadr h)))) 'is-convex-rr h))
       (g (dk-goal)) (pt (cadr g))
       (x (cadr pt)) (t (cadr (caddr pt))) (y (cadr (caddr (caddr pt)))))
  (dk-apply! pf x y t)
  (ass))
(qed 'is-convex-rr-unfold)

;;; MS, C, the convexity predicate PRED and its unfold lemma, the distance lemma DL, the norm NRM
;;; and its product law ML (AND antecedent), NRM-REAL! (lands norm(r) = abs(r) for r real, or #f)
(define (rbp-convex! ms C pred unfold dl nrm ml pts-eq-thunk to-C!)
  (dk-peel!)
  (let* ((h (rbp-pick 'cv (lambda (z) (dk-head-is? z pred))))
         (A (cadr h)))
    (dk-project! (list 'SUBSET A C) (if (eq? pred 'IS-CONVEX-CC) 'is-convex-cc 'is-convex-rr) h)
    (rbp-I-setting!)
    (let ((ptsM (pts-eq-thunk)))
      (mac 'is-path-connected)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
            ((dk-asm? g) (ass))
            ((dk-head-is? g 'SUBSET) (subst ptsM) (ass))
            (#t
             (let* ((pl (dk-peel!))
                    (ins (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) A))) pl))
                    (x (cadr (car ins))) (y (cadr (cadr ins)))
                    (gam (list 'VNB-LAMBDA 'pt_ rbp-I (list '+ x (list '* 'pt_ (list '- y x)))))
                    (yx (list '- y x)))
               (dk-cite! 'subset-mem-fwd A C x) (dk-cite! 'subset-mem-fwd A C y)
               (to-C! yx)
               (ew gam)
               (dk-conj-close!
                (lambda ()
                  (let ((g2 (dk-goal)))
                    (cond
                     ((and (dk-head-is? g2 'IN) (pair? (caddr g2)) (eq? (car (caddr g2)) 'FUN))
                      (dk-lam-type!
                       (lambda ()
                         (let ((t (dk-di-var!)))
                           (dk-cite! unfold A x y t)
                           (ass)))
                       (lambda () (ass))))
                     ((dk-head-is? g2 'IS-CONTINUOUS)
                      (rbp-segment-continuous! ms C A gam x y yx dl nrm ml ptsM to-C! unfold))
                     (#t                                        ; the end points
                      (let ((e (cadr (cadr g2))))
                        (dk-have! (list 'IN e rbp-I)
                          (lambda () (mac 'ccint-membership)
                            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!))))))
                        (dk-lam-b!)
                        (crs))))))))))))))))

(define (rbp-segment-continuous! ms C A gam x y yx dl nrm ml ptsM to-C! unfold)
  (let ((ftyp (list 'IN gam (list 'FUN (list 'PTS rbp-SUBI) (list 'PTS ms)))))
    (dk-have! (list 'IN gam (list 'FUN rbp-I A))
      (lambda () (dk-lam-type! (lambda () (let ((t (dk-di-var!))) (dk-cite! unfold A x y t) (ass)))
                               (lambda () (ass)))))
    (mac 'is-continuous)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g 'IS-METRIC-SPACE) (ass))
          ((equal? g ftyp)
           (subst rbp-ptsI) (subst ptsM)
           (dk-cite! 'fun-codomain-superset gam rbp-I A C)
           (ass))
          (#t
           (let* ((pl (dk-peel!))
                  (a0 (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl)))))
             (mac 'is-continuous-at)
             (dk-conj-close!
              (lambda ()
                (let ((g3 (dk-goal)))
                  (cond
                   ((dk-asm? g3) (ass))
                   ((dk-head-is? g3 'IS-METRIC-SPACE) (ass))
                   ((equal? g3 ftyp) (subst rbp-ptsI) (subst ptsM) (dk-cite! 'fun-codomain-superset gam rbp-I A C) (ass))
                   (#t (rbp-eps! ms C gam x y yx a0 dl nrm ml to-C!))))))))))))))

(define (rbp-eps! ms C gam x y yx a0 dl nrm ml to-C!)
  (let* ((pl (dk-peel!))
         (eps (cadr (car (filter (lambda (z) (dk-head-is? z 'POS-RR)) pl))))
         (M (list nrm yx)))
    (dk-pos-parts! eps)
    (if (eq? nrm 'magnitude) (dk-cite! 'cc-magnitude-nonneg yx) (dk-cite! 'rr-abs-nonneg yx))
    (rbp-rr! M)
    (let ((dlt (dk-skolem! (dk-cite! 'rr-small-factor-real eps M) #t)))
      (dk-cite! 'rr-pos-rr-in-rr dlt)
      (ew dlt)
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'POS-RR)
             (ass)
             (let* ((pl2 (dk-peel!))
                    (b (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl2))))
                    (dsub (list (list 'DIST rbp-SUBI) a0 b)))
               (dk-rewrite-h! (list 'IN a0 (list 'PTS rbp-SUBI)) (list 'PTS rbp-SUBI) rbp-I)
               (dk-rewrite-h! (list 'IN b (list 'PTS rbp-SUBI)) (list 'PTS rbp-SUBI) rbp-I)
               (rbp-unit! a0) (rbp-unit! b)
               (let* ((eqd (rbp-dist-I! a0 b))
                      (ab (list '- a0 b)) (ba (list '- b a0))
                      (Pa (list '+ x (list '* a0 yx))) (Pb (list '+ x (list '* b yx))))
                 (dk-cite! 'rr-abs-closed ba)
                 (dk-have! (list '<= (list 'abs ba) dlt) (lambda () (subst (list '= (list 'abs ba) dsub)) (ass)))
                 (dk-lam-b!)
                 (to-C! Pa) (to-C! Pb) (to-C! ab)
                 (subst (dk-cite! dl Pa Pb))
                 (dk-have! (list '= (list '- Pa Pb) (list '* ab yx)) (lambda () (crs)))
                 (subst (list '= (list '- Pa Pb) (list '* ab yx)))
                 (dk-have! (list 'AND (list 'IN ab C) (list 'IN yx C)) (lambda () (dk-conj-close! (lambda () (ass)))))
                 (subst (dk-cite! ml ab yx))
                 (if (eq? nrm 'magnitude) (subst (dk-cite! 'rr-magnitude-is-abs ab)))
                 (dk-cite! 'rr-abs-sub-sym a0 b)
                 (subst (list '= (list 'abs ab) (list 'abs ba)))
                 (dk-cite! 'rr-mul-le-right (list 'abs ba) dlt M)
                 (rbp-rr! (list '* (list 'abs ba) M)) (rbp-rr! (list '* dlt M))
                 (dk-ineq! (list '<= (list '* (list 'abs ba) M) (list '* dlt M))
                           (list '<= (list '* dlt M) eps))))))))))

(sp (make-wff '(FORALL cva (IMPLIES (IS-CONVEX-RR cva) (IS-PATH-CONNECTED RR-MS cva)))))
(rbp-convex! 'RR-MS 'RR 'IS-CONVEX-RR 'is-convex-rr-unfold 'rr-ms-dist 'abs 'rr-abs-mult
  (lambda () (let ((e (dk-cite! 'r7q-rr-pts))) (list '== '(PTS RR-MS) 'RR)))
  (lambda (t) (rbp-rr! t)))
(qed 'rr-convex-path-connected)

(sp (make-wff '(FORALL cva (IMPLIES (IS-CONVEX-CC cva) (IS-PATH-CONNECTED CC-MS cva)))))
(rbp-convex! 'CC-MS 'CC 'IS-CONVEX-CC 'is-convex-unfold 'cc-ms-dist 'magnitude 'cc-magnitude-mul
  (lambda ()
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    '(== (PTS CC-MS) CC))
  (lambda (t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC))))
(qed 'cc-convex-path-connected)

