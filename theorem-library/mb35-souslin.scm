;;; ======================================================================
;;; LEMMA 5.12 machinery: a continuous map of N^N ONTO a complete separable space.  Along z, the path
;;;   P(z, 0) = x(z(0)),  P(z, k+1) = x(z(k+1)) if d(P(z, k), x(z(k+1))) < 2^-k, else P(z, k)
;;; (x a dense sequence) is Cauchy; f(z) is its limit.
;;; ======================================================================
(define (mq-rho k) (list 'RECIP (list 'POWER 2 k)))
(define mq-xsym 'x)
(define (mq-xz z i) (list mq-xsym (list z i)))
(define (mq-C z k u) (list '< (list '(DIST s) u (mq-xz z (list 'succ k))) (mq-rho k)))
(define (mq-NX z) (list 'VNB-LAMBDA '(LIST mqk_ mqu_) '(CARTESIAN NN (PTS s))
  (list 'SEP 'mqy_ '(PTS s) (list 'OR (list 'AND (mq-C z 'mqk_ 'mqu_) (list '= 'mqy_ (mq-xz z '(succ mqk_))))
                                      (list 'AND (list 'NOT (mq-C z 'mqk_ 'mqu_)) '(= mqy_ mqu_))))))
(define (mq-P z k) (list 'DC-ITER '(PTS s) (mq-xz z 0) (mq-NX z) k))
(define (mq-step z k) (let ((pk (mq-P z k)) (pk1 (mq-P z (list 'succ k))))
  (list 'OR (list 'AND (mq-C z k pk) (list '= pk1 (mq-xz z (list 'succ k)))) (list 'AND (list 'NOT (mq-C z k pk)) (list '= pk1 pk)))))
(define (mq-head body) (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'x (list 'IMPLIES '(IN x (FUN NN (PTS s)))
  (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z msn-nn) body)))))))
(define (mq-x! z i)                  ; z(i) in NN, x(z(i)) in PTS s
  (dk-cite! 'fun-apply-type-c z 'NN 'NN i)
  (dk-cite! 'fun-apply-type-c mq-xsym 'NN '(PTS s) (list z i))
  (mq-xz z i))
(define (mq-rho! k)                  ; rho(k) real, > 0; rho(k) = 2 rho(k+1); rho(k+1) typed
  (let* ((sk (begin (dk-cite! 'nn-succ-closed k) (list 'succ k))) (r (mq-rho k)) (r1 (mq-rho sk)))
    (if (not (dk-asm? (list '= r (list '* 2 r1))))
        (begin
          (for-each (lambda (j)
                      (if (not (dk-asm? (list '< 0 (mq-rho j))))
                          (begin
                            (dk-cite! 'power-two-pos j)
                            (dk-type! 2 'RR) (dk-cite! 'power-closed-at j 2)
                            (mr-ne! (list 'POWER 2 j) 0 (list '< 0 (list 'POWER 2 j)))
                            (mr-chain! (dk-fact! 'rr-recip-closed (list 'POWER 2 j)))
                            (dk-cite! 'rr-recip-pos (list 'POWER 2 j)))))
                    (list k sk))
          (dk-have! '(IN 2 CC) (lambda () (arith)))
          (dk-have! (list 'AND '(IN 2 CC) (list 'IN k 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-cite! 'power-succ 2 k)
          (dk-cite! 'recip-power-two-halves k)
          (dk-have! (list '= r (list '* 2 r1))
            (lambda () (subst (list '= (list 'POWER 2 sk) (list '* 2 (list 'POWER 2 k)))) (mr-close-open!)))))
    r))
(define (mq-prem z) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'IMPLIES '(IN u (PTS s))
  (list 'FORSOME 'y (list 'AND '(IN y (PTS s)) (list 'IN 'y (list (mq-NX z) 'k 'u)))))))))
(sp (make-wff (mq-head (list 'AND (list '= (mq-P 'z 0) (mq-xz 'z 0))
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'AND (list 'IN (mq-P 'z 'k) '(PTS s)) (mq-step 'z 'k))))))))
(dk-peel!)
(dk-cite! 'nn-zero-in)
(mq-x! 'z 0)
(dk-have! (mq-prem 'z)
  (lambda ()
    (let* ((lk (dk-peel!))
           (k (cadr (mr-find 300 (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))
           (u (cadr (mr-find 301 (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS s)))) lk)))
           (sk (begin (dk-cite! 'nn-succ-closed k) (list 'succ k)))
           (xk (mq-x! 'z sk))
           (c (mq-C 'z k u)))
      (use-em c
        (lambda ()
          (ew xk)
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                         (begin (dk-lam-b!) (in-sep! (lambda () (oi-l) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))))
        (lambda ()
