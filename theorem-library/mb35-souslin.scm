                            ;; the diameter property
                            ((dk-contains? g2 'DIAM)
                             (let* ((lk3 (dk-peel!)) (eps (cadr (mr-find 211 (lambda (f) (dk-head-is? f 'POS-RR)) lk3)))
                                    (_0 (mr-pos! eps))
                                    (e2 (dk-halve! eps))
                                    (nc (msn-cont! z e2)) (nb (car nc)) (cl (cdr nc)))
                               (ew nb)
                               (mr-and-close!
                                 (lambda ()
                                   (if (dk-asm? (dk-goal)) (ass)
                                       (let* ((lk4 (dk-peel!))
                                              (n (cadr (mr-find 212 (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (equal? (cadr f) nb)))) lk4)))
                                              (img (msn-val! z n))
