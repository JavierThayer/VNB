                     (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew z) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))
                 (subst (list '= p fz))
