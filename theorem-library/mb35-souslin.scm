                                         (subst (list '= (list msn-sv (msn-pre z n)) img))
                                         (subst du)
                                         (dk-have! (list 'SUBSET dset 'RR-POS-STAR)
                                           (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (mr-sep-parts! (list 'IN x dset)) (mr-close-open!))))
                                         (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
                                         (mr-pos-star! eps)
                                         (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x dset) (list '<= 'x eps)))
                                           (lambda ()
                                             (let* ((x (dk-di-var!))
                                                    (ex1 (mr-sep-parts! (list 'IN x dset)))
                                                    (a (dk-skolem! ex1))
                                                    (_1 (dk-split-all!))
                                                    (b (dk-skolem! (mr-find 213 (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f x))) (dk-asms))))
                                                    (_2 (dk-split-all!))
                                                    (wa (msn-img-open! a z n))
                                                    (wb (msn-img-open! b z n)))
                                               (for-each (lambda (w)
                                                           (dk-cite! 'prefix-eq-le z w n nb)
                                                           (dk-apply! cl w))
                                                         (list wa wb))
                                               (for-each (lambda (w) (dk-cite! 'fun-apply-type-c 'f msn-nn '(PTS s) w)) (list wa wb))
                                               (let ((fz (list 'f z)) (fa (list 'f wa)) (fb (list 'f wb)))
                                                 (dk-cite! 'metric-triangle 's fa fz fb)
                                                 (dk-cite! 'metric-sym 's fz fa)
                                                 (for-each (lambda (pr) (dk-cite! 'metric-dist-real 's (car pr) (cdr pr)))
                                                           (list (cons fa fz) (cons fz fa) (cons fz fb) (cons fa fb)))
                                                 (subst (list '= x (list '(DIST s) a b)))
                                                 (subst (list '= a fa))
                                                 (subst (list '= b fb))
                                                 (dk-ineq! (list '<= (list '(DIST s) fa fb) (list '+ (list '(DIST s) fa fz) (list '(DIST s) fz fb)))
                                                           (list '= (list '(DIST s) fz fa) (list '(DIST s) fa fz))
                                                           (list '<= (list '(DIST s) fz fa) e2) (list '<= (list '(DIST s) fz fb) e2)
                                                           (list '= (list '+ e2 e2) eps))))))
                                         (mr-chain! (dk-fact! 'esup-least dset eps))
                                         (mr-close-open!)))))))
                            ;; monotonicity
                            (#t
                             (let* ((n (dk-di-var!))
                                    (sn (begin (dk-cite! 'nn-succ-closed n) (list 'succ n)))
                                    (i1 (msn-val! z sn)) (i0 (msn-val! z n)))
                               (subst (list '= (list msn-sv (msn-pre z sn)) i1))
                               (subst (list '= (list msn-sv (msn-pre z n)) i0))
                               (mac 'subset-def)
                               (let* ((p (dk-di-var!)) (w (msn-img-open! p z sn)))
