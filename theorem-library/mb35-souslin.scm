;;; PROPOSITION 5.10, sufficiency: the image of N^N under a continuous map is a Souslin set
;;; ======================================================================
(define (msn-cyl u) (list 'SEP 'msw_ msn-nn (list '= (list 'RESTRICT 'msw_ (list 'DOM u)) u)))
(define (msn-cylz z n) (list 'SEP 'msw_ msn-nn (list '= (list 'RESTRICT 'msw_ (msn-seg n)) (msn-pre z n))))
(define msn-sv (list 'VNB-LAMBDA 'msu_ 'NSTAR (list 'IMAGE 'f (msn-cyl 'msu_))))
(define msn-img (list 'IMAGE 'f msn-nn))
(define (msn-val! z n)               ; (sv (z|n)) == IMAGE(f, {w : w|n = z|n}); returns the image
  (let* ((zn (msn-pre! z n)) (img (list 'IMAGE 'f (msn-cylz z n))) (eqn (list '== (list msn-sv zn) img)))
    (if (not (dk-asm? eqn))
        (begin
          (dk-cite! 'nn-subset-ord n) (dk-cite! 'ord-segment-is-set n)
          (mr-iff-parts! (dk-cite! 'fun-codomain-iff (msn-seg n) 'NN zn))
          (dk-have! (list 'AND (list 'IN zn (list 'FUN (msn-seg n))) (list 'IN (msn-seg n) 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-split-all! (list (dk-cite! 'dom-of-fun (msn-seg n) zn)))
          (dk-have! eqn (lambda () (dk-lam-b!) (subst (list '= (list 'DOM zn) (msn-seg n))) (qrfl)))))
    img))
(define (msn-cyl-in! w z n)          ; w in N^N with w|n = z|n:  w in cyl(z, n)
  (msn-pre! w n)
  (dk-have! (list 'IN w (msn-cylz z n)) (lambda () (in-sep! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
(define (msn-img-in! w z n)          ; w in cyl(z, n):  f(w) in IMAGE(f, cyl(z, n))
  (let ((img (list 'IMAGE 'f (msn-cylz z n))))
    (dk-cite! 'fun-apply-type-c 'f msn-nn '(PTS s) w)
    (dk-cite! 'membership-implies-sethood (list 'f w) '(PTS s))
    (dk-have! (list 'IN (list 'f w) img)
      (lambda () (mac 'image-membership-iff)
        (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew w) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))))
(define (msn-img-open! p z n)        ; p in IMAGE(f, cyl(z, n)): returns w with w in N^N, w|n = z|n, f(w) = p landed
  (let* ((img (list 'IMAGE 'f (msn-cylz z n)))
         (ps (mr-iff-parts! (dk-cite! 'image-membership-iff 'f (msn-cylz z n) p)))
         (w (dk-skolem! (cadr ps))))
    (dk-split-all!)
    (mr-sep-parts! (list 'IN w (msn-cylz z n)))
    w))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'f (list 'IMPLIES '(IS-BAIRE-CONTINUOUS s f)
  (list 'IS-SOUSLIN 's msn-img)))))))
(dk-peel!)
(define msn-bc (mr-iff-parts! (dk-cite! 'is-baire-continuous 's 'f)))
(define msn-cc (cadr msn-bc))
(dk-cite! 'nstar-is-set)
(dk-cite! 'nn-is-set)
(let ((iff (dk-cite! 'fun-set-iff 'NN 'NN)))
