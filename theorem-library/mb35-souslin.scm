(define (msf-at! z)                  ; the three sieve clauses at z; f(z) == CHOICE, in PTS, in every S_{z|n}; returns (phi . diam-clause)
  (let* ((phi (list 'CHOICE (msf-int2 z)))
         (allc (list 'FORALL 'msm_ (list 'IMPLIES '(IN msm_ NN) (list 'IN phi (msf-S z 'msm_))))))
    (if (not (dk-asm? allc))
        (let* ((parts (dk-split-all! (list (dk-apply! msf-cl z))))
               (ex (mr-find 600 (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z) (dk-contains? f msf-sv))) (dk-asms)))
               (p0 (dk-skolem! ex)))
          (dk-cite! 'nn-zero-in)
          (dk-apply! (mr-find 601 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f p0))) (dk-asms)) 0)
          (msf-S! z 0)
          (dk-cite! 'subset-mem-fwd (msf-S z 0) '(PTS s) p0)
