  (mr-iff-back! iff))
(dk-cite! 'ms-pts-is-set 's)
;;; d(f(z), f(w)) <= e when w|N = z|N, from the continuity clause: returns N with its clause
(define (msn-cont! z e)
  (let* ((nb (dk-skolem! (dk-apply! msn-cc z e)))
         (cl (begin (dk-split-all!) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f 'RESTRICT))) "continuity clause"))))
    (cons nb cl)))
(mac 'is-souslin)
(ew msn-sv)
(mr-and-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-asm? g0) (ass))
        ((dk-head-is? g0 'IS-SIEVE)
         (mac 'is-sieve-classes)          ; W1
         (mr-and-close!
           (lambda ()
             (let ((g1 (dk-goal)))
               (cond
                 ((dk-asm? g1) (ass))
                 ((dk-head-is? g1 'IN)
                  (dk-lam-type!
                    (lambda ()
                      (let* ((u (dk-di-var!)) (cy (msn-cyl u)) (img (list 'IMAGE 'f cy)))
                        (dk-have! (list 'SUBSET cy msn-nn) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w cy)) (mr-close-open!))))
                        (dk-cite! 'subclass-of-set-is-set cy msn-nn)
                        (dk-cite! 'image-set 'f cy)
                        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img) '(IN z_ (PTS s))))
                          (lambda () (let* ((q (dk-di-var!)) (ps (mr-iff-parts! (dk-cite! 'image-membership-iff 'f cy q))) (w (dk-skolem! (cadr ps))))
                                       (dk-split-all!)
                                       (dk-cite! 'subset-mem-fwd cy msn-nn w)
                                       (dk-cite! 'fun-apply-type-c 'f msn-nn '(PTS s) w)
                                       (subst (list '= q (list 'f w)))
