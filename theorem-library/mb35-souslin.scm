    (if (not (dk-asm? eqn)) (dk-have! eqn (lambda () (dk-lam-b!) (qrfl))))
    (car ph)))
(define (msf-near! z w nb eps)        ; w|nb = z|nb, DIAM(S_{z|nb}) <= eps: d(phi z, phi w) <= eps
  (let* ((pz (msf-at! z)) (pw (msf-at! w)) (a (msf-S! z nb)) (fz (car pz)) (fw (car pw)) (d (list '(DIST s) fz fw)))
    (msf-S! w nb)
    (dk-apply! (mr-find 603 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f fz) (dk-contains? f 'msm_))) (dk-asms)) nb)
    (dk-apply! (mr-find 604 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f fw) (dk-contains? f 'msm_))) (dk-asms)) nb)
    (dk-rewrite-h! (list 'IN fw (msf-S w nb)) (msn-pre w nb) (msn-pre z nb))
    (dk-cite! 'diam-dist-le 's a fz fw)
    (dk-cite! 'subset-mem-fwd a '(PTS s) fz) (dk-cite! 'subset-mem-fwd a '(PTS s) fw)
    (dk-cite! 'metric-dist-real 's fz fw) (dk-cite! 'metric-pos 's fz fw)
    (mr-pos-star! d)
    (let* ((du (dk-cite! 'diam-unfold 's a)) (dset (cadr (caddr du))))
      (dk-have! (list 'IN (list 'DIAM 's a) 'RR-POS-STAR)
        (lambda () (subst du)
          (dk-have! (list 'SUBSET dset 'RR-POS-STAR) (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (mr-sep-parts! (list 'IN x dset)) (mr-close-open!))))
          (dk-cite! 'esup-in dset) (mr-close-open!))))
    (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
    (mr-pos-star! eps)
    (mr-chain! (dk-fact! 'rr-pos-star-le-trans d (list 'DIAM 's a) eps))
    (list '<= d eps)))
(dk-have! (list 'IN msf-f (list 'FUN msn-nn '(PTS s)))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (msf-at! z) (mr-close-open!))))))
(ew msf-f)
(mr-and-close!
  (lambda ()
    (let ((g0 (dk-goal)))
