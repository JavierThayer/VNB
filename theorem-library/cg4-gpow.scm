;;; cg4-gpow.scm -- powers x^n (n in NN) in a group: typing, commuting with what commutes with
;;; x, and x^(m+n) = x^m x^n.  For the extension of a one-parameter group segment (Prop. 5.36).
;;; Agent ISOM, 2026-10-26.  Helper prefix: gp4-.  Library: algebra.

(define (gp4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (gp4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (gp4-op x y) (list '(OPR g) x y))
(define gp4-E '(IDEN g))
(define (gp4-pow n) (list 'GPOW 'g 'x n))
(define (gp4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (gp4-forall (cdr vs) body))))
(define (gp4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (gp4-implies (cdr hs) concl))))
(define (gp4-cl! a b) (dk-cite! 'group-carrier-closed-opr 'g a b))
(define (gp4-assoc! a b c) (dk-cite! 'group-assoc 'g a b c))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (gp4-forall '(g x)
   (gp4-implies (list '(IS-GROUP g) '(IN x (CARR g))) (list 'IN (gp4-pow 'n) '(CARR g))))))))
(let* ((ind (dk-use-induction-fixed!)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'group-identity-in 'g)
  (dk-cite! 'gpow-zero 'g 'x)
  (subst (list '= (gp4-pow 0) gp4-E))
  (gp4-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-apply! ih 'x)
  (dk-cite! 'gpow-succ 'g 'x n)
  (gp4-cl! 'x (gp4-pow n))
  (subst (list '= (gp4-pow (list 'succ n)) (gp4-op 'x (gp4-pow n))))
  (gp4-ass!))
(qed 'gpow-type)
(topic! 'gpow-type 'algebra)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (gp4-forall '(g x y)
   (gp4-implies (list '(IS-GROUP g) '(IN x (CARR g)) '(IN y (CARR g)) (list '= (gp4-op 'y 'x) (gp4-op 'x 'y)))
     (list '= (gp4-op 'y (gp4-pow 'n)) (gp4-op (gp4-pow 'n) 'y))))))))
(let* ((ind (dk-use-induction-fixed!)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'group-identity-in 'g)
  (dk-cite! 'gpow-zero 'g 'x)
  (subst (list '= (gp4-pow 0) gp4-E))
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'y)))
  (dk-cite! 'group-left-id 'g 'y)
  (subst (list '= (gp4-op 'y gp4-E) 'y))
  (subst (list '= (gp4-op gp4-E 'y) 'y))
  (gp4-ass-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((p (gp4-pow n)) (ps (gp4-pow (list 'succ n))))
    (dk-cite! 'gpow-type n 'g 'x)
    (dk-apply! ih 'x 'y)
    (dk-cite! 'gpow-succ 'g 'x n)
    (gp4-cl! 'x p) (gp4-cl! 'y 'x) (gp4-cl! 'x 'y) (gp4-cl! 'y p) (gp4-cl! p 'y)
    (gp4-cl! (gp4-op 'x p) 'y) (gp4-cl! 'x (gp4-op p 'y)) (gp4-cl! 'x (gp4-op 'y p)) (gp4-cl! (gp4-op 'y 'x) p)
    (subst (list '= ps (gp4-op 'x p)))
    ;; y (x p) = (y x) p = (x y) p = x (y p) = x (p y) = (x p) y
    (gp4-assoc! 'y 'x p)
    (subst (list '= (gp4-op 'y (gp4-op 'x p)) (gp4-op (gp4-op 'y 'x) p)))
    (subst (list '= (gp4-op 'y 'x) (gp4-op 'x 'y)))
    (gp4-assoc! 'x 'y p)
    (subst (list '= (gp4-op (gp4-op 'x 'y) p) (gp4-op 'x (gp4-op 'y p))))
    (subst (list '= (gp4-op 'y p) (gp4-op p 'y)))
    (gp4-assoc! 'x p 'y)
    (subst (list '= (gp4-op 'x (gp4-op p 'y)) (gp4-op (gp4-op 'x p) 'y)))
    (gp4-ass-rfl!)))
(qed 'gpow-commute)
(topic! 'gpow-commute 'algebra)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (gp4-forall '(g x m)
   (gp4-implies (list '(IS-GROUP g) '(IN x (CARR g)) '(IN m NN))
     (list '= (gp4-pow '(+ m n)) (gp4-op (gp4-pow 'm) (gp4-pow 'n)))))))))
(let* ((ind (dk-use-induction-fixed!)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'gpow-type 'm 'g 'x)
  (fact 'group-identity-in 'g)
  (dk-cite! 'gpow-zero 'g 'x)
  (dk-cite! 'nn-add-zero 'm)
  (subst '(= (+ m 0) m))
  (subst (list '= (gp4-pow 0) gp4-E))
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g (gp4-pow 'm))))
  (subst (list '= (gp4-op (gp4-pow 'm) gp4-E) (gp4-pow 'm)))
  (gp4-ass-rfl!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (let* ((pm (gp4-pow 'm)) (pn (gp4-pow n)) (mn (list '+ 'm n)) (pmn (gp4-pow mn)))
    (dk-cite! 'nn-in-rr 'm)
    (dk-meta-and! '(IN m NN) (list 'IN n 'NN))
    (dk-cite! 'nn-add-closed 'm n)
    (dk-cite! 'gpow-type 'm 'g 'x) (dk-cite! 'gpow-type n 'g 'x) (dk-cite! 'gpow-type mn 'g 'x)
    (dk-apply! ih 'x 'm)
    (dk-cite! 'nn-add-succ 'm n)
    (subst (list '= (list '+ 'm (list 'succ n)) (list 'succ mn)))
    (dk-cite! 'gpow-succ 'g 'x mn)
    (dk-cite! 'gpow-succ 'g 'x n)
    (gp4-cl! 'x pm) (gp4-cl! pm 'x) (gp4-cl! pm pn) (gp4-cl! 'x pn) (gp4-cl! 'x pmn)
    (gp4-cl! (gp4-op 'x pm) pn) (gp4-cl! (gp4-op pm 'x) pn) (gp4-cl! pm (gp4-op 'x pn))
    (subst (list '= (gp4-pow (list 'succ mn)) (gp4-op 'x pmn)))
    (subst (list '= (gp4-pow (list 'succ n)) (gp4-op 'x pn)))
    (subst (list '= pmn (gp4-op pm pn)))
    (gp4-assoc! 'x pm pn)
    (subst (list '= (gp4-op 'x (gp4-op pm pn)) (gp4-op (gp4-op 'x pm) pn)))
    (gp4-cl! 'x 'x)
    (dk-have! (list '= (gp4-op 'x 'x) (gp4-op 'x 'x)) (lambda () (rfl)))
    (dk-cite! 'gpow-commute 'm 'g 'x 'x)
    (subst (list '= (gp4-op 'x pm) (gp4-op pm 'x)))
    (gp4-assoc! pm 'x pn)
    (subst (list '= (gp4-op (gp4-op pm 'x) pn) (gp4-op pm (gp4-op 'x pn))))
    (gp4-ass-rfl!)))
(qed 'gpow-add)
(topic! 'gpow-add 'algebra)
