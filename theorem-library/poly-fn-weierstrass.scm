;;; poly-fn-weierstrass.scm -- calculus 5.7 (Weierstrass approximation) as the notes state it, and the
;;; polynomial-function facts about the Bernstein polynomials it needs (CA-MONTEL "POLY", 2026-10-26).
;;; Vocabulary: poly-fn-vocab.scm; laws: poly-fn-laws.scm.  Library: analysis.  Helper prefix pfw-.
(define (pfw-only-prop! . fs) (dk-close-if! (lambda () (apply dk-only! fs)) prop))
(define (pfw-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (pfw-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (pfw-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (pfw-beta! close!)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (close!))))
;; the RR setting: RR a subring, a set, a subset of itself
(define (pfw-rr-setting!)
  (fact 'rr-is-set) (fact 'cc-is-set)
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-zero-in)
  (dk-cite! 'cc-subring-rr)
  (dk-have! '(SUBSET RR RR) (lambda () (let ((x (subset-by-element!))) (pfw-close-open!))))
  (dk-have! '(SUBSET RR CC) (lambda () (let ((x (subset-by-element!))) (fact 'rr-subset-cc x) (pfw-close-open!)))))
;; poly(RR, A, SRC) in context, TGT a lambda over A: land poly(RR, A, TGT); TYPER! types TGT's body at x
;; (in RR); EQ! closes (= (TGT z) (SRC z))
(define (pfw-ext! a src tgt typer! eq!)
  (let ((ty (list 'IN tgt (list 'FUN a 'RR))))
    (if (not (dk-asm? ty))
        (dk-have! ty
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (if (not (dk-asm? (list 'IN x 'RR))) (fact 'subset-mem-fwd a 'RR x))
                  (if (not (sequent-node-grounded? leaf)) (typer! x))
                  (pfw-close-open!)))))))
    (dk-have! (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list tgt 'pfz_) (list src 'pfz_))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (if (not (dk-asm? (list 'IN z 'RR))) (fact 'subset-mem-fwd a 'RR z))
          (eq! z) (pfw-close-open!))))
    (dk-cite! 'poly-fn-ext 'RR a src tgt)))
;; a constant on RR, then the extension to TGT (whose value at every z is VAL by EQV!: closes (= body VAL))
(define (pfw-const-ext! val tgt typer! eqv!)
  (dk-cite! 'poly-fn-const 'RR 'RR val)
  (pfw-ext! 'RR (list 'VNB-LAMBDA 'pfx_ 'RR val) tgt typer!
    (lambda (z)
      (dk-have! (list '= (list (list 'VNB-LAMBDA 'pfx_ 'RR val) z) val) (lambda () (pfw-beta! rfl)))
      (subst (list '= (list (list 'VNB-LAMBDA 'pfx_ 'RR val) z) val))
      (eqv! z))))

;;; ======================================================================
;;; (1) x |-> B_{n,k}(x) is a polynomial function on RR
;;; ======================================================================
(define (pfw-B n k) (list 'VNB-LAMBDA 'pfx_ 'RR (list (list 'BERNSTEIN-BASIS n 'pfx_) k)))
(define (pfw-B-at n x k) (list (list 'BERNSTEIN-BASIS n x) k))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pwk_ (list 'IMPLIES '(IN pwk_ ZZ)
  (list 'IS-POLY-FN-ON 'RR 'RR (pfw-B 'n 'pwk_))))))))
;; the typer of (pfw-B N k)'s body at x
(define (pfw-B-typer N k) (lambda (x) (dk-cite! 'bernstein-basis-ptwise-in-rr N x k)))
;; split on k < 0 / k = 0 / 0 < k
(define (pfw-k-cases! k neg zero pos)
  (fact 'zz-in-rr k)
  (use-cases (dk-fact! 'rr-lt-trichotomy k 0)
    neg
    (lambda () (fact 'nn-zero-in) (dk-have! (list 'IN k 'NN) (lambda () (subst (list '= k 0)) (ass))) (zero))
    (lambda () (dk-have! (list '<= 0 k) (lambda () (dk-ineq! (list '< 0 k)))) (pfw-chain! (dk-fact! 'zz-nonneg-in-nn k)) (pos))))
(define (pfw-zero-fn! N k)                ; the case k < 0: B_{N,k} = 0
  (pfw-const-ext! 0 (pfw-B N k) (pfw-B-typer N k)
    (lambda (z)
      (dk-cite! 'bernstein-basis-ptwise-in-rr N z k)
      (dk-have! (list '= (list (pfw-B N k) z) (pfw-B-at N z k)) (lambda () (pfw-beta! rfl)))
      (subst (list '= (list (pfw-B N k) z) (pfw-B-at N z k)))
      (subst (pfw-chain! (dk-fact! 'bernstein-basis-null N z k)))
      (rfl))))
;; the step: B_{v+1,k}(x) = x B_{v,k-1}(x) + (1 - x) B_{v,k}(x), k in NN
(define (pfw-step! v k)
  (let* ((sn (list 'succ v)) (km1 (list '- k 1))
         (ih (list 'FORALL 'pwk_ (list 'IMPLIES '(IN pwk_ ZZ) (list 'IS-POLY-FN-ON 'RR 'RR (pfw-B v 'pwk_)))))
         (p1 (pfw-B v km1)) (p2 (pfw-B v k))
         (idf '(VNB-LAMBDA pfx_ RR pfx_)) (onef '(VNB-LAMBDA pfx_ RR 1))
         (om (list 'VNB-LAMBDA 'pfx_ 'RR (list '+ (list '* 1 (list onef 'pfx_)) (list '* -1 (list idf 'pfx_)))))
         (m1 (list 'VNB-LAMBDA 'pfx_ 'RR (list '* (list idf 'pfx_) (list p1 'pfx_))))
         (m2 (list 'VNB-LAMBDA 'pfx_ 'RR (list '* (list om 'pfx_) (list p2 'pfx_))))
         (sm (list 'VNB-LAMBDA 'pfx_ 'RR (list '+ (list m1 'pfx_) (list m2 'pfx_)))))
    (fact 'nn-subset-zz 1) (fact 'nn-one-in) (fact 'nn-subset-zz k)
    (pfw-chain! (dk-fact! 'zz-sub-in-zz k 1))
    (dk-apply! ih km1) (dk-apply! ih k)
    (dk-have! '(IN -1 RR) (lambda () (arith)))
    (dk-cite! 'poly-fn-id 'RR 'RR)
    (dk-cite! 'poly-fn-const 'RR 'RR 1)
    (dk-cite! 'poly-fn-lin 'RR 'RR onef idf 1 -1)
    (dk-cite! 'poly-fn-mul 'RR 'RR idf p1)
    (dk-cite! 'poly-fn-mul 'RR 'RR om p2)
    (dk-cite! 'poly-fn-add 'RR 'RR m1 m2)
    (pfw-ext! 'RR sm (pfw-B sn k) (pfw-B-typer sn k)
      (lambda (z)
        (dk-cite! 'bernstein-basis-ptwise-in-rr v z km1)
        (dk-cite! 'bernstein-basis-ptwise-in-rr v z k)
        (dk-cite! 'bernstein-basis-ptwise-in-rr sn z k)
        (dk-close-if! (lambda () (dk-lam-b!))
          (lambda ()
            (subst (pfw-chain! (dk-fact! 'bernstein-basis-succ v z k)))
            (crs)))))
    (pfw-close-open!)))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let ((k (dk-di-var!)))
    (pfw-rr-setting!)
    (pfw-k-cases! k
      (lambda () (pfw-zero-fn! 0 k) (pfw-close-open!))
      (lambda ()
        (pfw-const-ext! 1 (pfw-B 0 k) (pfw-B-typer 0 k)
          (lambda (z)
            (dk-cite! 'bernstein-basis-ptwise-in-rr 0 z k)
            (dk-have! (list '= (list (pfw-B 0 k) z) (pfw-B-at 0 z k)) (lambda () (pfw-beta! rfl)))
            (subst (list '= (list (pfw-B 0 k) z) (pfw-B-at 0 z k)))
            (fact 'nn-zero-in)
            (subst (list '= k 0))
            (subst (pfw-chain! (dk-fact! 'bernstein-basis-degree-zero-diag z 0)))
            (rfl)))
        (pfw-close-open!))
      (lambda ()
        (dk-have! (list 'NOT (list '= k 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= k 0) (list '< 0 k)))) (ai (dk-cite! 'rr-lt-irrefl 0))))
        (pfw-const-ext! 0 (pfw-B 0 k) (pfw-B-typer 0 k)
          (lambda (z)
            (dk-cite! 'bernstein-basis-ptwise-in-rr 0 z k)
            (dk-have! (list '= (list (pfw-B 0 k) z) (pfw-B-at 0 z k)) (lambda () (pfw-beta! rfl)))
            (subst (list '= (list (pfw-B 0 k) z) (pfw-B-at 0 z k)))
            (subst (pfw-chain! (dk-fact! 'bernstein-basis-degree-zero-off z k)))
            (rfl)))
        (pfw-close-open!))))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((k (dk-di-var!)) (sn (list 'succ v)))
    (pfw-rr-setting!)
    (fact 'nn-succ-closed v)
    (pfw-k-cases! k
      (lambda () (pfw-zero-fn! sn k) (pfw-close-open!))
      (lambda () (pfw-step! v k))
      (lambda () (pfw-step! v k)))))
(qed 'bernstein-basis-poly-fn)
(topic! 'bernstein-basis-poly-fn 'analysis)

;;; ======================================================================
;;; (2) the transported Bernstein polynomial of g is a polynomial function on RR
;;; ======================================================================
(define pfw-r '(recip (- b a)))
(define (pfw-L x) (list '* (list '- x 'a) pfw-r))
(define pfw-cur-g 'pwg_)                 ; the function and degree the helpers below refer to
(define pfw-cur-n 'pwn_)
(define (pfw-h x) (list 'VNB-LAMBDA 'l_ 'NN (list '* (list pfw-cur-g (list '/ 'l_ pfw-cur-n)) (list (list 'BERNSTEIN-BASIS pfw-cur-n (pfw-L x)) 'l_))))
(define (pfw-S m) (list 'VNB-LAMBDA 'pfx_ 'RR (list 'SERIES-PARTIAL-SUM (pfw-h 'pfx_) m)))
(define (pfw-T k) (list 'VNB-LAMBDA 'pfx_ 'RR (list (list 'BERNSTEIN-BASIS 'pwn_ (pfw-L 'pfx_)) k)))
(define (pfw-gtyp-of g) (list 'FORALL 'pwy_ (list 'IMPLIES '(IN pwy_ RR) (list 'IN (list g 'pwy_) 'RR))))
(define pfw-gtyp (pfw-gtyp-of 'pwg_))
(define (pfw-hyps concl)
  (list 'FORALL 'pwg_ (list 'IMPLIES pfw-gtyp
    (list 'FORALL 'pwn_ (list 'IMPLIES '(IN pwn_ NN) (list 'IMPLIES '(NOT (= pwn_ 0))
      (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR) (list 'IMPLIES '(< a b) concl)))))))))))
;; the setting: r = 1/(b - a) in RR, N in RR and nonzero
(define (pfw-ab-setting!)
  (pfw-rr! '(- b a))
  (dk-have! '(NOT (= (- b a) 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= (- b a) 0) '(< a b)))) (ai (dk-cite! 'rr-lt-irrefl 0))))
  (pfw-chain! (dk-fact! 'rr-recip-closed '(- b a))))
;; g(k / N) in RR, k in NN
(define (pfw-gk! k)
  (let ((q (list '/ k pfw-cur-n)) (rn (list 'recip pfw-cur-n)))
    (if (not (dk-asm? (list 'IN q 'RR)))
        (begin
          (if (not (dk-asm? (list 'IN k 'RR))) (fact 'nn-in-rr k))
          (if (not (dk-asm? (list 'IN rn 'RR))) (pfw-chain! (dk-fact! 'rr-recip-closed pfw-cur-n)))
          (pfw-rr! (list '* k rn))
          (dk-have! (list 'IN q 'RR) (lambda () (mac 'binary-divide-def) (pfw-close-open!)))))
    (if (not (dk-asm? (list 'IN (list pfw-cur-g q) 'RR))) (dk-apply! (pfw-gtyp-of pfw-cur-g) q))))
;; T_k is a polynomial function on RR (k in ZZ)
(define (pfw-T-poly! k)
  (let* ((al pfw-r) (be (list '- (list '* 'a pfw-r)))
         (src (list 'VNB-LAMBDA 'pfx_ 'RR (list (pfw-B 'pwn_ k) (list '+ (list '* al 'pfx_) be)))))
    (dk-cite! 'bernstein-basis-poly-fn 'pwn_ k)
    (pfw-rr! be)
    (dk-have! (list 'FORALL 'pfx_ (list 'IMPLIES '(IN pfx_ RR) (list 'IN (list '+ (list '* al 'pfx_) be) 'RR)))
      (lambda () (let ((x (dk-di-var!))) (pfw-rr! (list '+ (list '* al x) be)) (pfw-close-open!))))
    (dk-cite! 'poly-fn-affine 'RR 'RR (pfw-B 'pwn_ k) 'RR al be)
    (pfw-ext! 'RR src (pfw-T k)
      (lambda (x) (pfw-rr! (pfw-L x)) (dk-cite! 'bernstein-basis-ptwise-in-rr 'pwn_ (pfw-L x) k))
      (lambda (z)
        (pfw-rr! (pfw-L z)) (pfw-rr! (list '+ (list '* al z) be))
        (dk-cite! 'bernstein-basis-ptwise-in-rr 'pwn_ (pfw-L z) k)
        (dk-cite! 'bernstein-basis-ptwise-in-rr 'pwn_ (list '+ (list '* al z) be) k)
        (dk-have! (list '= (list '+ (list '* al z) be) (pfw-L z)) (lambda () (crs)))
        (dk-close-if! (lambda () (dk-lam-b!))
          (lambda () (subst (list '= (list '+ (list '* al z) be) (pfw-L z))) (rfl)))))))

(sp (make-wff (list 'FORALL 'pwm_ (list 'IMPLIES '(IN pwm_ NN) (pfw-hyps (list 'IS-POLY-FN-ON 'RR 'RR (pfw-S 'pwm_)))))))
;; h(z)(k) = g(k/N) B(N, L z)(k), and in RR
(define (pfw-h-at! z k)
  (let ((v (list '* (list pfw-cur-g (list '/ k pfw-cur-n)) (list (list 'BERNSTEIN-BASIS pfw-cur-n (pfw-L z)) k))))
    (pfw-gk! k)
    (pfw-rr! (pfw-L z))
    (fact 'nn-subset-zz k)
    (dk-cite! 'bernstein-basis-ptwise-in-rr pfw-cur-n (pfw-L z) k)
    (pfw-rr! v)
    (dk-have! (list '= (list (pfw-h z) k) v) (lambda () (pfw-beta! rfl)))
    (dk-have! (list 'IN (list (pfw-h z) k) 'RR) (lambda () (subst (list '= (list (pfw-h z) k) v)) (ass)))
    v))
(define (pfw-S-typ! z m)                  ; SERIES-PARTIAL-SUM(h(z), m) in RR
  (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IN (list (pfw-h z) 'k_) 'RR)))
    (lambda () (let ((k (dk-di-var!))) (pfw-h-at! z k) (pfw-close-open!))))
  (pfw-chain! (dk-fact! 'series-partial-sum-in-rr-ptwise m (pfw-h z))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfw-rr-setting!)
  (pfw-ab-setting!)
  (fact 'nn-in-rr 'pwn_)
  (pfw-const-ext! 0 (pfw-S 0) (lambda (x) (pfw-S-typ! x 0))
    (lambda (z)
      (pfw-S-typ! z 0)
      (dk-have! (list '= (list (pfw-S 0) z) (list 'SERIES-PARTIAL-SUM (pfw-h z) 0)) (lambda () (pfw-beta! rfl)))
      (subst (list '= (list (pfw-S 0) z) (list 'SERIES-PARTIAL-SUM (pfw-h z) 0)))
      (subst (dk-cite! 'series-partial-sum-zero (pfw-h z)))
      (rfl)))
  (pfw-close-open!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfw-rr-setting!)
  (pfw-ab-setting!)
  (fact 'nn-in-rr 'pwn_)
  (fact 'nn-succ-closed v)
  (let* ((gk (list 'pwg_ (list '/ v 'pwn_)))
         (sc (list 'VNB-LAMBDA 'pfx_ 'RR (list '* gk (list (pfw-T v) 'pfx_))))
         (sm (list 'VNB-LAMBDA 'pfx_ 'RR (list '+ (list (pfw-S v) 'pfx_) (list sc 'pfx_)))))
    (dk-apply! ih 'pwg_ 'pwn_ 'a 'b)
    (fact 'nn-subset-zz v)
    (pfw-T-poly! v)
    (pfw-gk! v)
    (dk-cite! 'poly-fn-scale 'RR 'RR (pfw-T v) gk)
    (dk-cite! 'poly-fn-add 'RR 'RR (pfw-S v) sc)
    (pfw-ext! 'RR sm (pfw-S (list 'succ v)) (lambda (x) (pfw-S-typ! x (list 'succ v)))
      (lambda (z)
        (pfw-S-typ! z v)
        (pfw-S-typ! z (list 'succ v))
        (let ((hv (pfw-h-at! z v)))
          (dk-close-if! (lambda () (dk-lam-b!))
            (lambda ()
              (subst (pfw-chain! (dk-fact! 'series-partial-sum-succ (pfw-h z) v)))
              (subst (list '= (list (pfw-h z) v) hv))
              (rfl))))))
    (pfw-close-open!)))
(qed 'bernstein-partial-poly-fn)
(topic! 'bernstein-partial-poly-fn 'analysis)

;;; ======================================================================
;;; (3) CALCULUS 5.7: every continuous function on [a, b] is a uniform limit of polynomial functions
;;; ======================================================================
(define pfw-I '(CCINT a b))
(define pfw-E '(EXTEND-CONST f a b))
(define pfw-lin '(VNB-LAMBDA x RR (+ a (* (- b a) x))))
(define pfw-G (list 'COMPOSE pfw-E pfw-lin))
(define (pfw-bern n x) (list 'BERNSTEIN-POLY pfw-G n (pfw-L x)))
(define pfw-p (list 'VNB-LAMBDA 'pwi_ 'NN (list 'VNB-LAMBDA 'pfx_ pfw-I (pfw-bern '(succ pwi_) 'pfx_))))
(define (pfw-pn n) (list 'VNB-LAMBDA 'pfx_ pfw-I (pfw-bern (list 'succ n) 'pfx_)))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR) (list 'IMPLIES '(< a b)
  (list 'FORALL 'f (list 'IMPLIES (list 'IS-CONTINUOUS-ON 'f pfw-I)
    (list 'FORSOME 'pwp_ (list 'AND
      (list 'FORALL 'pwn_ (list 'IMPLIES '(IN pwn_ NN) (list 'IS-POLY-FN-ON 'RR pfw-I '(pwp_ pwn_))))
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'cap (list 'AND '(IN cap NN)
        (list 'FORALL 'pwn_ (list 'IMPLIES '(IN pwn_ NN) (list 'IMPLIES '(<= cap pwn_)
          (list 'FORALL 'pwx_ (list 'IMPLIES (list 'IN 'pwx_ pfw-I) '(<= (abs (- (f pwx_) ((pwp_ pwn_) pwx_))) eps)))))))))))))))))))))
(dk-peel!)
(pfw-rr-setting!)
(pfw-ab-setting!)
(dk-have! '(<= a b) (lambda () (dk-ineq! '(< a b))))
(dk-cite! 'cont-on-in-fun 'f pfw-I)
(pfw-chain! (dk-fact! 'extend-const-in-fun 'a 'b 'f))
(define pfw-cont (pfw-chain! (dk-fact! 'extend-const-continuous-at 'a 'b 'f)))
(dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pfw-I) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS pfw-E 'x_)))
  (lambda ()
    (let ((x (dk-di-var!)))
      (let* ((iff (dk-cite! 'ccint-membership 'a 'b x)))
        (dk-have! (list 'IN x 'RR) (lambda () (pfw-only-prop! iff (list 'IN x pfw-I)))))
      (dk-apply! pfw-cont x)
      (pfw-close-open!))))
;; G(y) in RR
(dk-have! (list 'IN pfw-lin '(FUN RR RR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (pfw-rr! (list '+ 'a (list '* '(- b a) x))) (pfw-close-open!))))))
(dk-have! (list 'FORALL 'pwy_ (list 'IMPLIES '(IN pwy_ RR) (list 'IN (list pfw-G 'pwy_) 'RR)))
  (lambda ()
    (let ((y (dk-di-var!)))
      (pfw-chain! (dk-fact! 'compose-apply 'RR 'RR 'RR pfw-E pfw-lin))
      (subst (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'COMPOSE))) "compose-apply") y))
      (fact 'fun-apply-type-c pfw-lin 'RR 'RR y)
      (fact 'fun-apply-type-c pfw-E 'RR 'RR (list pfw-lin y))
      (pfw-close-open!))))
(ew pfw-p)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (dk-head-is? (caddr (caddr g)) 'IS-POLY-FN-ON)
          ;; the terms are polynomial functions on [a, b]
          (let* ((n (dk-di-var!)) (sn (list 'succ n)) (ssn (list 'succ sn))
                 (S (begin (set! pfw-cur-g pfw-G) (set! pfw-cur-n sn) (pfw-S ssn)))
                 (s-on (list 'VNB-LAMBDA 'pfx_ pfw-I (list S 'pfx_))))
            (fact 'nn-succ-closed n) (fact 'nn-succ-closed sn)
            (fact 'nn-succ-nonzero n)
            (dk-have! (list 'SUBSET pfw-I 'RR)
              (lambda () (let ((x (subset-by-element!))) (let ((iff (dk-cite! 'ccint-membership 'a 'b x))) (pfw-only-prop! iff (list 'IN x pfw-I))))))
            (fact 'subclass-of-set-is-set pfw-I 'RR)
            (set! pfw-cur-g pfw-G) (set! pfw-cur-n sn)
            (fact 'nn-in-rr sn)
            (dk-cite! 'bernstein-partial-poly-fn ssn pfw-G sn 'a 'b)
            (dk-cite! 'poly-fn-restrict 'RR 'RR S pfw-I)
            (dk-have! (list '= (list pfw-p n) (pfw-pn n))
              (lambda ()
                (dk-have! (list 'IN (pfw-pn n) (list 'FUN pfw-I 'RR))
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((x (dk-di-var!)))
                          (fact 'subset-mem-fwd pfw-I 'RR x)
                          (pfw-S-typ! x ssn)
                          (dk-have! (list 'IN (pfw-bern sn x) 'RR)
                            (lambda ()
                              (mac 'BERNSTEIN-POLY)
                              (pfw-close-open!)))
                          (pfw-close-open!))))))
                (pfw-beta! rfl)))
            (subst (list '= (list pfw-p n) (pfw-pn n)))
            (pfw-ext! pfw-I s-on (pfw-pn n)
              (lambda (x) (dk-have! (list 'IN (pfw-bern sn x) 'RR) (lambda () (pfw-S-typ! x ssn) (mac 'BERNSTEIN-POLY) (pfw-close-open!))))
              (lambda (z)
                (pfw-S-typ! z ssn)
                (dk-close-if! (lambda () (dk-lam-b!))
                  (lambda () (mac 'BERNSTEIN-POLY) (pfw-close-open!) (if (pair? (dk-open-leaves)) (rfl))))))
            (pfw-close-open!))
          ;; the uniform estimate: Bernstein's theorem for the extension, which agrees with f on [a, b]
          (let* ((lk (dk-peel!))
                 (eps (cadr (car (filter (dk-head? 'POS-RR) lk))))
                 (ex (pfw-chain! (dk-fact! 'bernstein-uniform-approximation-ccint pfw-E 'a 'b eps)))
                 (cap (dk-skolem! ex))
                 (_0 (dk-split-all!))
                 (tail (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap))) "the tail")))
            (ew cap)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((lk2 (dk-peel!))
                           (n (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk2))))
                           (x (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) pfw-I))) lk2))))
                           (sn (list 'succ n)))
                      (fact 'nn-succ-closed n)
                      (fact 'nn-le-succ n)
                      (pfw-chain! (dk-fact! 'nn-le-trans-guarded cap n sn))
                      (dk-have! (list 'AND (list 'IN sn 'NN) (list '<= cap sn)) (lambda () (dk-conj-close! (lambda () (ass)))))
                      (dk-apply! (dk-apply! tail sn) x)
                      (let ((est (dk-pick (lambda (fm) (and (dk-head-is? fm '<=) (dk-contains? fm (list pfw-E x)))) "the estimate")))
                        (dk-cite! 'extend-const-ccint-fixes 'a 'b x 'f)
                        (dk-rewrite-h! est (list pfw-E x) (list 'f x))
                        (dk-have! (list '= (list (list pfw-p n) x) (pfw-bern sn x))
                          (lambda () (pfw-beta! rfl)))
                        (subst (list '= (list (list pfw-p n) x) (pfw-bern sn x)))
                        (pfw-close-open!)))))))))))
(qed 'weierstrass-approximation)
(topic! 'weierstrass-approximation 'analysis)
