;;; Library: operator-algebras.

;;; th3-eigen-normalized.scm -- DEFINICAO 3.6 of th-main.pdf (the Operadores book, ch. 3, s. 3.1.1):
;;; the normalized sequence of eigenvalues of a compact self-adjoint operator.  Agent TH3-SORT,
;;; 2026-11-10.  Library: operator-algebras.  Helper prefix tns-.  Every qed modulo 0; nothing asserted.
;;;
;;; sa-eigen-normalized: for T compact self-adjoint on a Hilbert space v there are an orthonormal
;;; basis (ix, e) of eigenvectors, real eigenvalues lm : ix -> CC with T e_i = lm_i e_i and the
;;; expansion T x = sum_i (lm_i <x|e_i>) e_i (TH3-A4's sa-eigen-expansion), such that the indices
;;; P = {i in ix : 0 < |lm_i|} of the nonzero eigenvalues, each basis vector once (so each nonzero
;;; eigenvalue as often as its multiplicity), are listed with nonincreasing modulus:
;;;   * P finite: a bijection ph : ORD-SEGMENT(CARD P) -> P with |lm(ph(n+1))| <= |lm(ph n)|;
;;;   * P infinite: a bijection ph : NN -> P with |lm(ph(n+1))| <= |lm(ph n)| and |lm(ph n)| -> 0.
;;; From srt-sort-finite / srt-sort-infinite (th3-sort.scm, core) at the key L = (i |-> |lm_i|),
;;; whose superlevel sets are finite by sa-eigen-expansion (compact-eigen-large-finite).
;;; Window: after theorem-library/th3a4-spectral (sa-eigen-expansion) and theorem-library/th3-sort
;;; (srt-sort-finite, srt-sort-infinite).  No citer.
;;; tns- helpers: copies of th3-sort.scm's srt- helpers (helpers do not cross file environments)
(define (tns-and! . fs) (apply dk-have-and! fs))
(define (tns-var-of landed cls)
  (cadr (dk-find "tns-var-of" (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
(define (tns-close-opened! thunk)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (ass)
                         (if (not (sequent-node-grounded? l))
                             (error "tns-close-opened!: leaf left open" (expression->string (dk-goal-of l)))))))
            (dk-opened thunk)))
(define (tns-sep-in! t sep)
  (let ((c (list 'IN t sep)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (tns-close-opened! (lambda () (sep-mi))))))
    c))
(define (tns-sep-set! sep)
  (let ((c (list 'IN sep 'SET)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (tns-close-opened! (lambda () (sep-set))))))
    c))
(define tns-xfam '(VNB-LAMBDA onk_ tnix_ ((ACT v) (* (tnlm_ onk_) ((IP v) x (tne_ onk_))) (tne_ onk_))))
(define (tns-mag lm i) (list 'magnitude (list lm i)))
(define (tns-pm ix lm) (list 'SEP 'tni_ ix (list '< 0 (tns-mag lm 'tni_))))
(define (tns-ordered ix lm)
  (let* ((pm (tns-pm ix lm)) (cp (list 'CARD pm)))
    (list 'OR
      (list 'AND (list 'IN cp 'NN)
        (list 'FORSOME 'ph (list 'AND (list 'IN 'ph (list 'BIJECTION (list 'ORD-SEGMENT cp) pm))
          (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '< '(succ n) cp)
            (list '<= (tns-mag lm '(ph (succ n))) (tns-mag lm '(ph n)))))))))
      (list 'AND (list 'NOT (list 'IN cp 'NN))
        (list 'FORSOME 'ph (list 'AND (list 'IN 'ph (list 'BIJECTION 'NN pm))
          (list 'AND (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (tns-mag lm '(ph (succ n))) (tns-mag lm '(ph n)))))
            (list 'FORALL 'd (list 'IMPLIES '(POS-RR d)
              (list 'FORSOME 'j (list 'AND '(IN j NN)
                (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= j n) (list '< (tns-mag lm '(ph n)) 'd)))))))))))))))
(sp (make-wff (forall-guarded '(v t_)
  '((IS-HILBERT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_))
  (list 'FORSOME 'tnix_ (list 'FORSOME 'tne_ (list 'FORSOME 'tnlm_
    (list 'AND '(IS-ORTHONORMAL-BASIS v tnix_ tne_)
    (list 'AND '(IN tnlm_ (FUN tnix_ CC))
    (list 'AND '(FORALL tni_ (IMPLIES (IN tni_ tnix_)
                   (AND (= (tnlm_ tni_) (conjugate (tnlm_ tni_))) (= (t_ (tne_ tni_)) ((ACT v) (tnlm_ tni_) (tne_ tni_))))))
    (list 'AND (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v)) (list 'SUMS-TO '(IP-NORMED-AG v) tns-xfam '(t_ x))))
               (tns-ordered 'tnix_ 'tnlm_)))))))))))
(dk-peel!)
(define tns-ix (dk-skolem! (dk-cite! 'sa-eigen-expansion 'v 't_)))
(define tns-e (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'tfe_))) "the basis")))
(define tns-lm (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'tflm_))) "the eigenvalues")))
(define tns-hfin (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h 'CARD))) "lm -> 0"))
(define tns-P (tns-pm tns-ix tns-lm))
(define tns-L (list 'VNB-LAMBDA 'tnk_ tns-ix (tns-mag tns-lm 'tnk_)))
(define (tns-typed! i)                        ; i in ix: lm_i in CC, |lm_i| in RR
  (dk-cite! 'fun-apply-type-c tns-lm tns-ix 'CC i)
  (dk-cite! 'cc-magnitude-closed (list tns-lm i)))
(define (tns-in-p! i)                         ; i in P: i in ix, 0 < |lm_i|, |lm_i| in RR
  (dk-sep-parts! (list 'IN i tns-P))
  (tns-typed! i))
(dk-cite! 'fun-domain-in-set tns-ix 'CC tns-lm)
(tns-sep-set! tns-P)
(dk-have! (list 'IN tns-L (list 'FUN tns-ix 'RR))
  (lambda ()
    (dk-lam-type!
      (lambda () (let ((k (dk-di-var!))) (tns-typed! k) (dk-close-if-asm!)))
      (lambda () (dk-close-if-asm!)))))
(tns-and! (list 'IN tns-L (list 'FUN tns-ix 'RR)) (list 'IN tns-ix 'SET))
(dk-cite! 'fun-elements-are-sets tns-ix 'RR tns-L)
;; the hypotheses of srt-sort-finite / -infinite at P and L
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x tns-P) (list 'IN (list tns-L 'x) 'RR)))
  (lambda () (let ((x (dk-di-var!))) (tns-in-p! x) (dk-lam-b!) (dk-close-if-asm!))))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x tns-P) (list '< 0 (list tns-L 'x))))
  (lambda () (let ((x (dk-di-var!))) (tns-in-p! x) (dk-lam-b!) (dk-close-if-asm!))))
(dk-have! (list 'FORALL 'd (list 'IMPLIES '(POS-RR d)
            (list 'IN (list 'CARD (list 'SEP 'y tns-P (list '<= 'd (list tns-L 'y)))) 'NN)))
  (lambda ()
    (let* ((landed (dk-peel!))
           (d (cadr (dk-find "d" (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
           (big (list 'SEP 'tflz_ tns-ix (list '<= d (tns-mag tns-lm 'tflz_))))
           (small (list 'SEP 'y tns-P (list '<= d (list tns-L 'y))))
           (sub (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ small) (list 'IN 'srz_ big)))))
      (dk-apply! tns-hfin d)
      (tns-sep-set! big)
      (tns-sep-set! small)
      (dk-have! sub
        (lambda ()
          (let ((z (cadr (car (dk-peel!)))))
            (let ((le (dk-sep-parts! (list 'IN z small))))
              (tns-in-p! z)
              (dk-lam-b-h! le))
            (tns-sep-in! z big))))
      (let ((cb (dk-find "card big" (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (cadr h) 'CARD)
                                                     (alpha-equiv? (cadr (cadr h)) big))) (dk-asms))))
        (tns-and! (list 'IN big 'SET) cb))
      (let ((sn (dk-cite! 'card-subset-nn big)))
        (tns-and! (list 'IN small 'SET) sub)
        (dk-apply! sn small))
      (dk-close-if-asm!))))
;; close the conclusion: every conjunct but the ordering from context, the ordering by ORDERED!
(define (tns-close! ordered!)
  (witness! tns-ix (lambda () (witness! tns-e (lambda () (witness! tns-lm (lambda ()
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'OR) (ordered!) (dk-close-if-asm!)))))))))))
;; an L-instance at index terms: land its |lm| form; IDXS are the index terms to type in P first
(define (tns-convert! inst idxs)
  (for-each tns-in-p! idxs)
  (dk-lam-b-h! inst)
  (dk-close-if-asm!))
(use-em (list 'IN (list 'CARD tns-P) 'NN)
  (lambda ()
    (let* ((ph (dk-skolem! (dk-apply! (dk-cite! 'srt-sort-finite tns-P) tns-L)))
           (cp (list 'CARD tns-P)) (seg (list 'ORD-SEGMENT cp))
           (ordL (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ph))) "the order")))
      (dk-cite! 'bijection-in-fun seg tns-P ph)
      (tns-close!
        (lambda ()
          (oi-l)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'FORSOME)
                 (witness! ph (lambda ()
                   (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'FORALL)
                          (let* ((n (dk-di-var!)) (sn (list 'succ n)))
                            (di)
                            (dk-cite! 'nn-succ-closed n)
                            (dk-have! (list '< n cp) (lambda () (dk-nn! (list '< sn cp))))
                            (dk-iff-bwd! (dk-cite! 'seg-mem-lt cp n))
                            (dk-iff-bwd! (dk-cite! 'seg-mem-lt cp sn))
                            (dk-cite! 'fun-apply-type-c ph seg tns-P n)
                            (dk-cite! 'fun-apply-type-c ph seg tns-P sn)
                            (tns-convert! (dk-apply! ordL n) (list (list ph n) (list ph sn))))
                          (dk-close-if-asm!))))))
                 (dk-close-if-asm!))))))))
  (lambda ()
    (let* ((ph (dk-skolem! (dk-apply! (dk-cite! 'srt-sort-infinite tns-P) tns-L)))
           (b2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ph) (not (dk-contains? h 'POS-RR)))) "the order"))
           (lim (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ph) (dk-contains? h 'POS-RR))) "the limit"))
           (ty! (lambda (k) (dk-cite! 'fun-apply-type-c ph 'NN tns-P k))))
      (dk-cite! 'bijection-in-fun 'NN tns-P ph)
      (tns-close!
        (lambda ()
          (oi-r)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'FORSOME)
                 (witness! ph (lambda ()
                   (dk-conj-close!
                    (lambda ()
                      (cond ((and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'POS-RR))
                             (let* ((landed (dk-peel!))
                                    (d (cadr (dk-find "d" (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
                                    (j (dk-skolem! (dk-apply! lim d)))
                                    (inner (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h j))) "eventually")))
                               (witness! j (lambda ()
                                 (dk-conj-close!
                                  (lambda ()
                                    (if (dk-head-is? (dk-goal) 'FORALL)
                                        (let* ((landed (dk-peel!)) (n (tns-var-of landed 'NN)))
                                          (ty! n)
                                          (tns-convert! (dk-apply! inner n) (list (list ph n))))
                                        (dk-close-if-asm!))))))))
                            ((dk-head-is? (dk-goal) 'FORALL)
                             (let* ((n (dk-di-var!)) (sn (list 'succ n)))
                               (dk-cite! 'nn-succ-closed n)
                               (ty! n) (ty! sn)
                               (tns-convert! (dk-apply! b2 n) (list (list ph n) (list ph sn)))))
                            (#t (dk-close-if-asm!)))))))
                 (dk-close-if-asm!)))))))))
(qed 'sa-eigen-normalized)
