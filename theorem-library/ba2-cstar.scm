;;; CLOSED CONVERTERS.  (bcp-to-B! A F): F in context, an a-formula; land its B-form, B = UIBA-AS-UBA(A):
;;; the SHIFT-EL / INVERSE-EL subterms, the accessors, and a TOP-LEVEL IS-INVERTIBLE-EL.
;;; (bcp-to-a! A F) is the converse.  Requires IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA(A) in context.
(define (bcp-view A) (list 'UIBA-AS-UBA A))
(define (bcp-fun-subterms f A)       ; post-order list of (SHIFT-EL A ..) / (INVERSE-EL A ..) subterms
  (let walk ((t f) (acc '()))
    (if (pair? t)
        (let ((acc2 (fold-left (lambda (ac x) (walk x ac)) acc t)))
          (if (and (memq (car t) '(SHIFT-EL INVERSE-EL)) (pair? (cdr t)) (equal? (cadr t) A)
                   (not (member t acc2)))
              (append acc2 (list t))
              acc2))
        acc)))
(define (bcp-fun-view-thm t) (if (eq? (car t) 'SHIFT-EL) 'bcp-shift-view 'bcp-inverse-view))
(define (bcp-convert! A f to-B?)
  (let* ((B (bcp-view A)) (src (if to-B? A B)) (dst (if to-B? B A)))
    (let loop ((f f))
      (let ((subs (bcp-fun-subterms f src)))
        (if (pair? subs)
            (let* ((t (car subs))
                   (t2 (cons (car t) (cons dst (cddr t)))))
              (apply dk-cite! (bcp-fun-view-thm t) A (cddr t))
              (loop (dk-rewrite-h! f t t2)))
            (let ((f2 (fold-left
                        (lambda (g acc)
                          (if (bcp-occurs? (list acc src) g)
                              (begin (dk-cite! (bcp-ro-name acc) A)
                                     (dk-rewrite-h! g (list acc src) (list acc dst)))
                              g))
                        f bcp-accs)))
              (if (and (pair? f2) (eq? (car f2) 'IS-INVERTIBLE-EL) (equal? (cadr f2) src))
                  (let ((f3 (list 'IS-INVERTIBLE-EL dst (caddr f2)))
                        (iff (dk-cite! 'bcp-invertible-view A (caddr f2))))
                    (if (not (dk-asm? f3))
                        (dk-have! f3 (lambda () (dk-only! iff f2) (prop))))
                    f3)
                  f2)))))))
(define (bcp-to-B! A f) (bcp-convert! A f #t))
(define (bcp-to-a! A f) (bcp-convert! A f #f))

