;;; ba2-cstar.scm -- BANACH ALGEBRAS: C*-algebras with unit.  The spectrum of a self-adjoint
;;; element is real, and SPECTRAL PERMANENCE (Proposition 1.29): for a unital C*-subalgebra A
;;; of B containing the unit of B, an element of A is invertible in A iff it is invertible in B,
;;; and sigma_A(x) = sigma_B(x).
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 2.
;;; Agent BA-2, wave 2026-11-09.  Destination: theorem-library/ba2-cstar.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix bcp-.
;;; LOAD WINDOW: after theorem-library/ba-inverse (inverse-near-bound, invertible-near-invertible),
;;; ba-spectrum (shift-invertible-outside-ball), cc-real-bound, and structure-library/ba2-vocab.
;;;
;;; THE ROUTE (no Gelfand theory).  (1) sigma(h) is real for h self-adjoint: if z is in sigma(h),
;;; z + it is in sigma(h + it 1) for real t, so |z + it|^2 <= ||h + it 1||^2 =
;;; ||(h + it 1)*(h + it 1)|| = ||h^2 + t^2 1|| <= ||h||^2 + t^2, and cc-real-of-quadratic-bound
;;; makes z real.  (2) h self-adjoint in A, z real, z 1 - h invertible in B with c = ||(z1-h)^-1||_B:
;;; v = (z + it) 1 - h is invertible in A (z + it is not real); its A-inverse is its B-inverse,
;;; and inverse-near-bound in B gives ||v^-1|| <= 2c for t = 1/(4c); invertible-near-invertible
;;; in A then makes z 1 - h invertible in A.  (3) y in A invertible in B: y*y and y y* are
;;; self-adjoint and invertible in B, hence in A; (y*y)^-1 y* and y* (y y*)^-1 are a left and a
;;; right inverse of y in A, and they coincide.
;;;
;;; THE VIEW.  A unital involutive algebra a is a 10-tuple and IS-UNITAL-BANACH-ALGEBRA pins the
;;; length 9, so a theorem about unital Banach algebras reaches a through B = UIBA-AS-UBA(a).
;;; Section 1 proves the nine read-offs ACC(B) == ACC(a) and restates, for a unital involutive
;;; algebra, each unital-Banach-algebra lemma used below (bcp-u-<name>): the lemma is cited at B,
;;; the functoids are unfolded on both sides, and the accessors of a in the goal are rewritten to
;;; those of B.  The ring and module laws already have view companions (-uiba-as-uba).

(define (bcp-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l)
                             (let* ((t (cadr (dk-goal-of l)))
                                    (A (and (pair? t) (pair? (car t)) (pair? (cdar t)) (cadar t))))
                               (if A (vnb-guard (lambda () (bcp-vt A t)))))
                             (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba2-cstar: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba2-cstar: unfinished" name))))
(define (bcp-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (bcp-occurs? x t)
  (or (equal? x t) (and (pair? t) (or (bcp-occurs? x (car t)) (bcp-occurs? x (cdr t))))))
(define (bcp-head-occurs? h t)
  (and (pair? t) (or (eq? (car t) h) (bcp-head-occurs? h (car t)) (bcp-head-occurs? h (cdr t)))))
(define (bcp-dump! tag)
  (display "\n;; BCS DUMP ") (display tag) (newline)
  (for-each (lambda (l) (display ";;   LEAF: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline)) (dk-asms-of l)))
            (dk-open-leaves)))
;;; the land-and-rewrite step: EQ (= L R) in context (either orientation); rewrite L to R in the goal
(define (bcp-rw! l r) (subst (list '= l r)))

