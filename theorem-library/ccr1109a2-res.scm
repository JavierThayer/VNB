               ((MUL) `(FORALL x (IMPLIES (IN x ,d) (FORALL y (IMPLIES (IN y ,d) (IN ((MUL K) x y) ,d))))))
               ((NEG) `(FORALL x (IMPLIES (IN x ,d) (IN ((NEG K) x) ,d)))))))
    (c9r-or-asm `(IN ,t ,d) (lambda () (dk-chain-ass! (if v (dk-apply! law u v) (dk-apply! law u)))))
    (c9r-in! d t)
