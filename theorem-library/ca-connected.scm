    (cnc-seg! 'cvu_ 'cnu_ 'cnv_ x y
      (lambda (a b t) (cnn-unit! t) (dk-cite! 'is-convex-unfold 'cvu_ a b t)))
    (cnc-clash! 'cvu_ y)))
(qed 'cc-convex-connected)
