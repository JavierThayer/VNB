;;; star-shaped about c: every segment from c stays in u
(define cnc-star '(FORALL csy_ (IMPLIES (IN csy_ csu_) (FORALL cst_ (IMPLIES (IN cst_ (CCINT 0 1))
                    (IN (+ csc_ (* cst_ (- csy_ csc_))) csu_))))))
(sp (make-wff (list 'FORALL 'csu_ (list 'IMPLIES '(SUBSET csu_ CC) (list 'FORALL 'csc_ (list 'IMPLIES '(IN csc_ csu_)
  (list 'IMPLIES cnc-star '(IS-CONNECTED CC-MS csu_))))))))
(dk-peel!)
(cnc-connected! 'csu_
  (lambda (x y)
    (let ((star-in! (lambda (a b t) (cnn-unit! t) (dk-apply! cnc-star b t))))
      (fact 'subset-mem-fwd 'csu_ 'CC 'csc_)
      (fact 'subset-mem-fwd 'csu_ (cnc-union) 'csc_)
      (use-cases (let ((ui (dk-cite! 'union-membership 'cnu_ 'cnv_ 'csc_)))
                   (dk-have! '(OR (IN csc_ cnu_) (IN csc_ cnv_)) (lambda () (cnn-only-prop! ui '(IN csc_ (UNION cnu_ cnv_)))))
                   '(OR (IN csc_ cnu_) (IN csc_ cnv_)))
        (lambda ()                        ; c in U: the segment c -> y puts y in U
          (cnc-seg! 'csu_ 'cnu_ 'cnv_ 'csc_ y star-in!)
          (cnc-clash! 'csu_ y))
        (lambda ()                        ; c in V: the segment c -> x puts x in V
          (cnc-seg! 'csu_ 'cnv_ 'cnu_ 'csc_ x star-in!)
          (cnc-clash! 'csu_ x))))))
(qed 'cc-star-connected)
(topic! 'cc-star-connected 'analysis)

