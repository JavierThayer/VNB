;;; ======================================================================
;;; (6) THE RIGHT HALF-PLANE (convex) AND THE SLIT PLANE (star-shaped about 1; not convex: the segment
;;;     from -1 + i to -1 - i crosses the cut) ARE CONNECTED
;;; ======================================================================
;; (= (PART (+ b (* t (- y b)))) (+ (PART b) (* t (- (PART y) (PART b))))), PART = real-part / imag-part;
;; b, y in CC, t in RR in context
(define (cnh-part-eq! part b t y)
  (let* ((w (list '+ b (list '* t (list '- y b))))
         (rhs (list '+ (list part b) (list '* t (list '- (list part y) (list part b)))))
         (re? (eq? part 'real-part)))
    (cng-cc! (list '- y b)) (cng-cc! (list '* t (list '- y b))) (cng-cc! w)
    (cnn-rr! (list part b)) (cnn-rr! (list part y))
    (dk-have! (list '= (list part w) rhs)
      (lambda ()
        (subst (cnn-chain! (dk-fact! (if re? 'cc-re-add 'cc-im-add) b (list '* t (list '- y b)))))
        (subst (cnn-chain! (dk-fact! (if re? 'cc-re-real-mul 'cc-im-real-mul) t (list '- y b))))
        (subst (cnn-chain! (dk-fact! (if re? 'cc-re-sub 'cc-im-sub) y b)))
        (rfl)))
    (list '= (list part w) rhs)))
;; 0 < (1 - t) X + t Y written as X + t (Y - X), for t in [0, 1], 0 <= X, 0 < Y, and (0 < X or 0 < t):
;; lands (< 0 (+ X (* t (- Y X))))
(define (cnh-pos-comb! X Y t x-pos?)
  (let* ((A (list '* (list '- 1 t) X)) (B (list '* t Y)) (e (list '+ X (list '* t (list '- Y X)))))
    (cnn-rr! (list '- 1 t)) (cnn-rr! A) (cnn-rr! B) (cnn-rr! e)
    (dk-have! (list '= e (list '+ A B)) (lambda () (crs)))
    (dk-have! (list '<= 0 (list '- 1 t)) (lambda () (dk-ineq! (list '<= t 1))))
    (if (not (dk-asm? (list '<= 0 X)))
        (dk-have! (list '<= 0 X) (lambda () (if x-pos? (dk-ineq! (list '< 0 X)) (dk-ineq!)))))
    (cnn-chain! (dk-fact! 'rr-mul-le-right 0 (list '- 1 t) X))
    (dk-have! (list '<= 0 Y) (lambda () (dk-ineq! (list '< 0 Y))))
    (cnn-chain! (dk-fact! 'rr-mul-le-right 0 t Y))
    (if x-pos?
        (dk-have! (list '< 0 e)
          (lambda ()
            (use-cases (dk-fact! 'rr-lt-trichotomy t 1)
              (lambda ()
                (dk-have! (list '< 0 (list '- 1 t)) (lambda () (dk-ineq! (list '< t 1))))
                (cnn-chain! (dk-fact! 'rr-mul-pos (list '- 1 t) X))
                (dk-ineq! (list '= e (list '+ A B)) (list '< 0 A) (list '<= (list '* 0 Y) B)))
              (lambda ()
                (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '= t 1))))
                (cnn-chain! (dk-fact! 'rr-mul-pos t Y))
                (dk-ineq! (list '= e (list '+ A B)) (list '< 0 B) (list '<= (list '* 0 X) A)))
              (lambda () (cnn-absurd! (list '< 1 t) (list '<= t 1))))))
        (begin
          (cnn-chain! (dk-fact! 'rr-mul-pos t Y))
          (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '= e (list '+ A B)) (list '< 0 B) (list '<= (list '* 0 X) A))))))
    (list '< 0 e)))

(define (cml-guard-of t) (list 'NOT (list 'AND (list '= (list 'imag-part t) 0) (list '<= (list 'real-part t) 0))))
(define cnh-H '(SEP hpz_ CC (< 0 (real-part hpz_))))
