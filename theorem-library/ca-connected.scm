(define cnh-SL '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(sp (make-wff (list 'IS-CONNECTED 'CC-MS cnh-SL)))
(fact 'cc-one-in) (fact 'cc-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in)
(dk-cite! 'cc-re-of-real 1)
(dk-cite! 'cc-re-of-real 0)
(cnn-rr! '(real-part 1))
(dk-have! '(= 1 (+ 1 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (cnn-chain! (dk-fact! 'cc-re-im-of 1 1 0))))
(dk-have! (list 'SUBSET cnh-SL 'CC)
  (lambda () (let ((x (subset-by-element!))) (sep-me (list 'IN x cnh-SL)) (dk-split-all!) (cnn-close-open!))))
(dk-have! (list 'IN 1 cnh-SL)
  (lambda () (in-sep! (lambda () (di) (dk-split-all!) (cnn-absurd! '(<= (real-part 1) 0) '(= (real-part 1) 1))))))
(dk-have! (list 'FORALL 'csy_ (list 'IMPLIES (list 'IN 'csy_ cnh-SL) (list 'FORALL 'cst_ (list 'IMPLIES (list 'IN 'cst_ cnn-I)
            (list 'IN '(+ 1 (* cst_ (- csy_ 1))) cnh-SL)))))
  (lambda ()
    (let* ((lk (dk-peel!))
           (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnh-SL))) lk))))
           (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk))))
           (ry (list 'real-part y)) (iy (list 'imag-part y)))
      (dk-project! (list 'IN y 'CC) (lambda () (sep-me (list 'IN y cnh-SL))))
      (dk-project! (cml-guard-of y) (lambda () (sep-me (list 'IN y cnh-SL))))
      (cnn-unit! t) (fact 'rr-subset-cc t)
      (let* ((re (cnh-part-eq! 'real-part 1 t y))
             (im (cnh-part-eq! 'imag-part 1 t y))
             (w (list '+ 1 (list '* t (list '- y 1)))))
        (cnn-rr! iy) (cnn-rr! ry)
        (in-sep!
          (lambda ()
            (di)
            (dk-split-all!)
            (dk-rewrite-h! (list '= (list 'imag-part w) 0) (list 'imag-part w) (caddr im))
            (dk-rewrite-h! (list '<= (list 'real-part w) 0) (list 'real-part w) (caddr re))
            (let ((im0 (list '= (list '+ '(imag-part 1) (list '* t (list '- iy '(imag-part 1)))) 0))
                  (re0 (list '<= (list '+ '(real-part 1) (list '* t (list '- ry '(real-part 1)))) 0)))
              (dk-rewrite-h! im0 '(imag-part 1) 0)
              (dk-rewrite-h! re0 '(real-part 1) 1)
              (let ((im1 (list '= (list '+ 0 (list '* t (list '- iy 0))) 0))
                    (re1 (list '<= (list '+ 1 (list '* t (list '- ry 1))) 0)))
                (use-cases (dk-fact! 'rr-lt-trichotomy 0 t)
                  (lambda ()                ; 0 < t: t iy = 0 gives iy = 0, so ry > 0, and then Re w > 0
                    (cnn-rr! (list '* iy t))
                    (dk-have! (list '= (list '* iy t) 0)
                      (lambda () (dk-have! (list '= (list '* iy t) (list '+ 0 (list '* t (list '- iy 0)))) (lambda () (crs)))
                                 (subst (list '= (list '* iy t) (list '+ 0 (list '* t (list '- iy 0)))))
                                 (subst im1) (rfl)))
                    (dk-have! (list 'NOT (list '= t 0)) (lambda () (di) (cnn-absurd! (list '= t 0) (list '< 0 t))))
                    (let ((rc (cnn-chain! (dk-fact! 'rr-mul-recip-cancel iy t))))
                      (dk-rewrite-h! rc (list '* iy t) 0))
                    (cnn-chain! (dk-fact! 'rr-recip-closed t))
                    (dk-have! (list '= iy 0)
                      (lambda () (subst (list '= iy (list '* 0 (list 'recip t)))) (crs)))
                    (use-cases (dk-fact! 'rr-lt-trichotomy ry 0)
                      (lambda () (dk-have! (list '<= ry 0) (lambda () (dk-ineq! (list '< ry 0))))
                                 (cnn-only-prop! (cml-guard-of y) (list '= iy 0) (list '<= ry 0)))
                      (lambda () (dk-have! (list '<= ry 0) (lambda () (dk-ineq! (list '= ry 0))))
                                 (cnn-only-prop! (cml-guard-of y) (list '= iy 0) (list '<= ry 0)))
                      (lambda ()
                        (cnh-pos-comb! 1 ry t #f)
                        (cnn-absurd! re1 (list '< 0 (list '+ 1 (list '* t (list '- ry 1))))))))
                  (lambda ()                ; t = 0: Re w = 1
                    (dk-rewrite-h! re1 t 0)
                    (cnn-absurd! (list '<= (list '+ 1 (list '* 0 (list '- ry 1))) 0)))
                  (lambda () (cnn-absurd! (list '< t 0) (list '<= 0 t)))))))))
      (cnn-close-open!))))
(define cnh-star (cnn-chain! (dk-fact! 'cc-star-connected cnh-SL 1)))
(cnn-close-open!)
(qed 'cc-slit-plane-connected)
