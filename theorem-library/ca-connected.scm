;; the consumers, stated for U = a ball and U = CC
(define (cnb-ident U)
  `(FORALL f (IMPLIES (HOLOMORPHIC-ON ,U f) (FORALL a (IMPLIES (IN a ,U) (IMPLIES (ZEROS-ACCUMULATE-AT ,U f a)
     (FORALL z (IMPLIES (IN z ,U) (= (f z) 0)))))))))
(define (cnb-hurwitz U)
  `(FORALL s (IMPLIES (IN s (FUN NN (CC-HOL-FNS ,U))) (IMPLIES (FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z ,U) (NOT (= ((s k) z) 0))))))
     (FORALL f (IMPLIES (IN f (FUN ,U CC)) (IMPLIES (UNIF-ON-COMPACTA ,U s f)
       (OR (FORSOME hcc_ (AND (IN hcc_ CC) (FORALL hcz_ (IMPLIES (IN hcz_ ,U) (= (f hcz_) hcc_)))))
           (FORALL z (IMPLIES (IN z ,U) (NOT (= (f z) 0))))))))))))
(define (cnb-close-from! inst)            ; the focus goal is INST, or INST peeled at the goal's own variables
  (if (alpha-equiv? (dk-goal) inst)
      (ass)
      (let loop ((f inst))
        (cond ((alpha-equiv? (dk-goal) f) (ass))
              ((dk-head-is? f 'FORALL)
               (let ((v (cadr (cadr (cadr (dk-goal))))))   ; never reached for these statements
                 (loop (dk-apply! f v))))
              (#t (error "cnb-close-from!: no match" (expression->string (dk-goal))))))))

