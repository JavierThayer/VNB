;; X open in RR-MS: X is relatively open in [0, 1] in the form unit-interval-clopen takes
(define (cni-open! X)
  (dk-have! (cnn-open X)
    (lambda ()
      (let* ((lk (dk-peel!))
             (s (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk)))))
        (cnn-unit! s)
        (let* ((oi (dk-cite! 'is-open 'RR-MS X))
               (bc (caddr (caddr (caddr oi)))))
          (dk-project! bc (lambda () (dk-only! oi (list 'IS-OPEN 'RR-MS X))))
          (let* ((r (dk-skolem! (dk-apply! bc s)))
                 (_0 (dk-split-all!))
                 (_1 (cnn-pos! r)))
            (ew r)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((lk2 (dk-peel!))
                           (u (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk2))))
                           (a (list 'abs (list '- u s))))
                      (cnn-unit! u)
                      (cnn-rr! (list '- u s)) (cnn-rr! (list '- s u)) (cnn-rr! a)
                      (fact 'rr-ms-dist s u)
                      (dk-have! (list '<= (list '(DIST RR-MS) s u) a)
                        (lambda ()
                          (subst (list '== (list '(DIST RR-MS) s u) (list 'abs (list '- s u))))
                          (subst (dk-cite! 'rr-abs-sub-sym s u))
                          (dk-ineq!)))
                      (dk-have! (list 'IN s '(PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
                      (dk-have! (list 'IN u '(PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
                      (cnn-chain! (dk-fact! 'ball-mem-from-le 'RR-MS s u a r))
                      (fact 'subset-mem-fwd (list 'BALL 'RR-MS s r) X u)
                      (cnn-close-open!)))))))))))
(define cni-disj (list 'FORALL 'cnx_ (list 'IMPLIES (list 'IN 'cnx_ cnn-I) (list 'NOT (list 'AND '(IN cnx_ cnu_) '(IN cnx_ cnv_))))))
;; from 0 in X: every point of [0, 1] is in X (X, Y = U, V in either order); lands (IN z X)
(define (cni-all! X Y z)
  (dk-have! (cnn-cover X Y)
    (lambda ()
      (let* ((t (dk-di-var!)))
        (fact 'subset-mem-fwd cnn-I '(UNION cnu_ cnv_) t)
        (let ((ui (dk-cite! 'union-membership 'cnu_ 'cnv_ t)))
          (cnn-only-prop! ui (list 'IN t '(UNION cnu_ cnv_)))))))
  (dk-have! (cnn-disj X Y)
    (lambda ()
      (let* ((t (dk-di-var!)) (dj (dk-apply! cni-disj t)))
        (cnn-only-prop! dj))))
  (cni-open! X) (cni-open! Y)
  (dk-apply! (cnn-chain! (dk-fact! 'unit-interval-clopen X Y)) z))

