;;; ca-connected.scm -- connected sets (CA-MONTEL "CONN", 2026-10-26).  No theorem of the tree concluded
;;; IS-CONNECTED of any set before this file.
;;;
;;;   unit-interval-clopen      a subset P of [0, 1], relatively open, whose relative complement Q is
;;;                             relatively open too, and which contains 0, is all of [0, 1]
;;;                             (the least upper bound argument, through rr-sup-*)
;;;   ...                       (see the section headers below)
;;;
;;; Library: complex-analysis (the interval lemma uses only analysis vocabulary).
(define cnn-I '(CCINT 0 1))
(define (cnn-open X)
  (list 'FORALL 'cts_ (list 'IMPLIES (list 'IN 'cts_ cnn-I) (list 'IMPLIES (list 'IN 'cts_ X)
    (list 'FORSOME 'ctd_ (list 'AND '(POS-RR ctd_)
      (list 'FORALL 'ctu_ (list 'IMPLIES (list 'IN 'ctu_ cnn-I)
        (list 'IMPLIES '(< (abs (- ctu_ cts_)) ctd_) (list 'IN 'ctu_ X))))))))))
(define (cnn-cover P Q)
  (list 'FORALL 'ctv_ (list 'IMPLIES (list 'IN 'ctv_ cnn-I) (list 'OR (list 'IN 'ctv_ P) (list 'IN 'ctv_ Q)))))
(define (cnn-disj P Q)
  (list 'FORALL 'ctv_ (list 'IMPLIES (list 'IN 'ctv_ cnn-I) (list 'NOT (list 'AND (list 'IN 'ctv_ P) (list 'IN 'ctv_ Q))))))
(define (cnn-close-open!)
  (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (cnn-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (cnn-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
;; (IN t RR), (<= 0 t), (<= t 1) from (IN t [0,1])
(define (cnn-unit! t)
  (let* ((iff (dk-cite! 'ccint-membership 0 1 t)) (rhs (caddr iff)))
    (if (not (and (dk-asm? (list '<= 0 t)) (dk-asm? (list '<= t 1))))
        (begin
          (dk-have! rhs (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN t cnn-I))) prop)))
          (dk-split-all! (list rhs))))))
;; (IN t [0,1]) from (IN t RR), (<= 0 t), (<= t 1)
(define (cnn-to-unit! t)
  (let ((g (list 'IN t cnn-I)))
    (if (not (dk-asm? g))
        (let* ((iff (dk-cite! 'ccint-membership 0 1 t)) (rhs (caddr iff)))
          (dk-have! rhs (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!))))))
          (dk-have! g (lambda () (cnn-only-prop! iff rhs)))))))
;; |a - b| < d from b - d < a and a - b < d (premises named, the difference typed)
(define (cnn-abs-lt! a b d lo hi)
  (let ((x (list '- a b)))
    (cnn-rr! x)
    (dk-have! (list '< (list '- d) x) (lambda () (apply dk-ineq! lo)))
    (dk-have! (list '< x d) (lambda () (apply dk-ineq! hi)))
    (cnn-chain! (dk-fact! 'rr-abs-lt-of-parts x d))))
(define (cnn-absurd! . prems)             ; close the focus goal from contradictory linear premises
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (ai (dk-cite! 'rr-lt-irrefl 0)))
(define (cnn-only-prop! . fs)          ; keep FS, then prop -- unless the kept sequent was already proven
  (dk-close-if! (lambda () (apply dk-only! fs)) prop))
(define (cnn-pos! d)                      ; (IN d RR), (< 0 d) from (POS-RR d)
  (fact 'rr-pos-rr-in-rr d) (fact 'rr-lt-of-pos-rr d))

;;; ======================================================================
;;; (1) the clopen lemma on [0, 1]
;;; ======================================================================
(define cnn-S
  '(SEP cnsw_ RR (AND (<= 0 cnsw_) (AND (<= cnsw_ ctt_)
     (FORALL cnsv_ (IMPLIES (IN cnsv_ RR) (IMPLIES (<= 0 cnsv_) (IMPLIES (<= cnsv_ cnsw_) (IN cnsv_ ctp_)))))))))
(define (cnn-S-all w)
  (list 'FORALL 'cnsv_ (list 'IMPLIES '(IN cnsv_ RR) (list 'IMPLIES '(<= 0 cnsv_) (list 'IMPLIES (list '<= 'cnsv_ w) '(IN cnsv_ ctp_))))))
(define cnn-sv (list 'SUP cnn-S))
;; the parts of (IN w S): w in RR, 0 <= w, w <= t, and the universal
(define (cnn-S-parts! w)
  (let ((m (list 'IN w cnn-S)))
    (for-each (lambda (c) (dk-project! c (lambda () (sep-me m))))
              (list (list 'IN w 'RR) (list '<= 0 w) (list '<= w 'ctt_) (cnn-S-all w)))))
(define (cnn-ub) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cnn-S) (list '<= 'x cnn-sv))))

(sp (make-wff (list 'FORALL 'ctp_ (list 'FORALL 'ctq_
  (list 'IMPLIES (cnn-cover 'ctp_ 'ctq_) (list 'IMPLIES (cnn-disj 'ctp_ 'ctq_)
    (list 'IMPLIES (cnn-open 'ctp_) (list 'IMPLIES (cnn-open 'ctq_)
      (list 'IMPLIES '(IN 0 ctp_) (list 'FORALL 'ctt_ (list 'IMPLIES (list 'IN 'ctt_ cnn-I) '(IN ctt_ ctp_))))))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(cnn-unit! 'ctt_)
(define (cnn-main!)
  (let ((cov (dk-apply! (cnn-cover 'ctp_ 'ctq_) 'ctt_)))
    (dk-have! '(IN ctt_ ctq_) (lambda () (cnn-only-prop! cov '(NOT (IN ctt_ ctp_))))))
  ;; S: a set of reals containing 0, bounded by t
  (dk-have! (list 'IN cnn-S 'SET) (lambda () (sep-set) (fact 'rr-is-set) (ass)))
  (dk-have! (list 'IN 0 cnn-S)
    (lambda ()
      (in-sep!
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) '<=) (dk-ineq! '(<= 0 ctt_)))
                    (#t
                     (let* ((lk (dk-peel!))
                            (v (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk)))))
                       (cnn-chain! (dk-fact! 'rr-leq-antisymmetric v 0))
                       (subst (list '= v 0))
                       (ass))))))))))
  (dk-have! (list 'FORSOME 'cnsx_ (list 'IN 'cnsx_ cnn-S)) (lambda () (ew 0) (ass)))
  (dk-have! (list 'SUBSET cnn-S 'RR)
    (lambda () (let ((x (subset-by-element!))) (sep-me (list 'IN x cnn-S)) (dk-split-all!) (cnn-close-open!))))
  (dk-have! (list 'RR-UPPER-BOUND cnn-S 'ctt_)
    (lambda ()
      (mac 'rr-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((lk (dk-peel!)) (x (cadr (car lk))))
                (sep-me (list 'IN x cnn-S))
                (dk-split-all!)
                (cnn-close-open!)))))))
  (dk-have! (list 'RR-BOUNDED-ABOVE cnn-S) (lambda () (mac 'rr-bounded-above) (ew 'ctt_) (ass)))
  (fact 'rr-sup-in cnn-S)
  (fact 'rr-sup-upper cnn-S)
  (fact 'rr-sup-least cnn-S)
  (dk-project! (cnn-ub) 'rr-upper-bound (list 'RR-UPPER-BOUND cnn-S cnn-sv))
  (let ((least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RR-UPPER-BOUND) (dk-contains? f cnn-sv)))
                        "rr-sup-least's universal")))
    (dk-apply! least 'ctt_))
  (dk-apply! (cnn-ub) 0)
  (dk-have! (list '<= cnn-sv 1) (lambda () (dk-ineq! (list '<= cnn-sv 'ctt_) '(<= ctt_ 1))))
  (cnn-to-unit! cnn-sv)
  (use-cases (dk-apply! (cnn-cover 'ctp_ 'ctq_) cnn-sv)
    (lambda () (cnn-case-p!))
    (lambda () (cnn-case-q!))))

;; s in Q: points of S just below s are in P and in Q
(define (cnn-case-q!)
  (let* ((d (dk-skolem! (dk-apply! (cnn-open 'ctq_) cnn-sv)))
         (_0 (dk-split-all!))
         (_1 (cnn-pos! d))
         (w (dk-skolem! (cnn-chain! (dk-fact! 'rr-sup-approx cnn-S d))))
         (_2 (dk-split-all!)))
    (dk-apply! (cnn-ub) w)
    (cnn-S-parts! w)
    (dk-have! (list '<= w w) (lambda () (dk-ineq!)))
    (dk-apply! (cnn-S-all w) w)
    (dk-have! (list '<= w 1) (lambda () (dk-ineq! (list '<= w 'ctt_) '(<= ctt_ 1))))
    (cnn-to-unit! w)
    (cnn-abs-lt! w cnn-sv d (list (list '< (list '- cnn-sv d) w)) (list (list '<= w cnn-sv) (list '< 0 d)))
    (let* ((qall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'ctq_))) "Q's ball"))
           (inq (dk-apply! qall w))
           (dj (dk-apply! (cnn-disj 'ctp_ 'ctq_) w)))
      (cnn-only-prop! (list 'IN w 'ctp_) (list 'IN w 'ctq_) dj))))

;; s in P: s < t, and s + d/2 would be in S
(define (cnn-case-p!)
  (let* ((d (dk-skolem! (dk-apply! (cnn-open 'ctp_) cnn-sv)))
         (_0 (dk-split-all!))
         (_1 (cnn-pos! d))
         (pall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'ctp_))) "P's ball")))
    (use-em (list '= cnn-sv 'ctt_)
      (lambda ()
        (dk-rewrite-h! (list 'IN cnn-sv 'ctp_) cnn-sv 'ctt_)
        (ass))
      (lambda ()
        (dk-have! (list '< cnn-sv 'ctt_)
          (lambda () (mac '<) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (prop))))))
        (let* ((h (list '* 1/2 d)) (w (list '+ cnn-sv h)))
          (cnn-rr! h) (cnn-rr! w)
          (use-cases (cnn-chain! (dk-fact! 'rr-leq-total 'ctt_ w))
            ;; t <= s + d/2: t itself is in P
            (lambda ()
              (cnn-abs-lt! 'ctt_ cnn-sv d (list (list '< cnn-sv 'ctt_) (list '< 0 d))
                           (list (list '<= 'ctt_ w) (list '< 0 d)))
              (dk-apply! pall 'ctt_)
              (cnn-close-open!))
            ;; s + d/2 <= t: s + d/2 is in S, above its sup
            (lambda ()
              (let* ((w1 (dk-skolem! (cnn-chain! (dk-fact! 'rr-sup-approx cnn-S d))))
                     (_2 (dk-split-all!)))
                (dk-apply! (cnn-ub) w1)
                (cnn-S-parts! w1)
                (dk-have! (list 'IN w cnn-S)
                  (lambda ()
                    (in-sep!
                      (lambda ()
                        (dk-conj-close!
                          (lambda ()
                            (cond ((dk-asm? (dk-goal)) (ass))
                                  ((dk-head-is? (dk-goal) '<=)
                                   (dk-ineq! (list '<= 0 cnn-sv) (list '< 0 d) (list '<= w 'ctt_)))
                                  (#t (cnn-in-p-below! w w1 d pall)))))))))
                (dk-apply! (cnn-ub) w)
                (cnn-absurd! (list '<= w cnn-sv) (list '< 0 d))))))))))

;; goal (FORALL v (IMPLIES (IN v RR) (IMPLIES (<= 0 v) (IMPLIES (<= v w) (IN v P))))): split at w1
(define (cnn-in-p-below! w w1 d pall)
  (let* ((lk (dk-peel!))
         (v (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk)))))
    (use-cases (cnn-chain! (dk-fact! 'rr-leq-total v w1))
      (lambda () (dk-apply! (cnn-S-all w1) v) (cnn-close-open!))
      (lambda ()
        (dk-have! (list '<= v 1) (lambda () (dk-ineq! (list '<= v w) (list '<= w 'ctt_) '(<= ctt_ 1))))
        (cnn-to-unit! v)
        (cnn-abs-lt! v cnn-sv d (list (list '<= w1 v) (list '< (list '- cnn-sv d) w1))
                     (list (list '<= v w) (list '< 0 d)))
        (dk-apply! pall v)
        (cnn-close-open!)))))

(use-em '(IN ctt_ ctp_) (lambda () (ass)) (lambda () (cnn-main!)))
(qed 'unit-interval-clopen)
(topic! 'unit-interval-clopen 'analysis)

;;; ======================================================================
;;; (2) THE SEGMENT LEMMA in CC: U, V open; the segment from x to y lies in U u V and meets U n V
;;;     nowhere; x in U  ==>  y in U.  (P = {t : x + t (y - x) in U} is clopen in [0, 1].)
;;; ======================================================================
(define (cng-pt t) (list '+ 'cgx_ (list '* t '(- cgy_ cgx_))))
(define cng-m '(magnitude (- cgy_ cgx_)))
(define (cng-set X) (list 'SEP 'cgw_ 'RR (list 'IN (cng-pt 'cgw_) X)))
(define cng-P (cng-set 'cgu_))
(define cng-Q (cng-set 'cgv_))
(define cng-cover (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ cnn-I) (list 'OR (list 'IN (cng-pt 'cgt_) 'cgu_) (list 'IN (cng-pt 'cgt_) 'cgv_)))))
(define cng-disj (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ cnn-I) (list 'NOT (list 'AND (list 'IN (cng-pt 'cgt_) 'cgu_) (list 'IN (cng-pt 'cgt_) 'cgv_))))))
(define (cng-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (cng-real-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (fact 'rr-subset-cc t)))

;; X open in CC-MS: the set {t : pt(t) in X} is relatively open in [0, 1]
(define (cng-open! X)
  (let ((sset (cng-set X)))
    (dk-have! (cnn-open sset)
      (lambda ()
        (let* ((lk (dk-peel!))
               (s (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk))))
               (ps (cng-pt s)))
          (cnn-unit! s)
          (cng-real-cc! s)
          (cng-cc! ps)
          (dk-project! (list 'IN ps X) (lambda () (sep-me (list 'IN s sset))))
          (let* ((oi (dk-cite! 'is-open 'CC-MS X))
                 (bc (caddr (caddr (caddr oi)))))
            (dk-project! bc (lambda () (dk-only! oi (list 'IS-OPEN 'CC-MS X))))
            (let* ((r (dk-skolem! (dk-apply! bc ps)))
                   (_0 (dk-split-all!))
                   (_1 (cnn-pos! r))
                   (q (list '+ 1 cng-m))
                   (k (list 'recip q))
                   (d (list '* r k)))
              (cnn-rr! q)
              (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '<= 0 cng-m))))
              (dk-have! (list 'NOT (list '= q 0)) (lambda () (di) (cnn-absurd! (list '= q 0) (list '< 0 q))))
              (cnn-chain! (dk-fact! 'rr-recip-closed q))
              (cnn-chain! (dk-fact! 'rr-recip-pos q))
              (cnn-chain! (dk-fact! 'rr-recip-inverse q))
              (cnn-rr! d)
              (cnn-chain! (dk-fact! 'rr-mul-pos r k))
              (cnn-chain! (dk-fact! 'rr-pos-rr-of-lt d))
              (cnn-rr! (list '* d cng-m))
              (dk-have! (list '= (list '+ d (list '* d cng-m)) (list '* r (list '* q k))) (lambda () (crs)))
              (dk-rewrite-h! (list '= (list '+ d (list '* d cng-m)) (list '* r (list '* q k))) (list '* q k) 1)
              (ew d)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((lk2 (dk-peel!))
                             (u (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk2))))
                             (pu (cng-pt u))
                             (a (list 'abs (list '- u s)))
                             (dbnd (list '* a cng-m))
                             (mag (list 'magnitude (list '- ps pu))))
                        (cnn-unit! u)
                        (cng-real-cc! u)
                        (cng-cc! pu)
                        (cnn-rr! (list '- s u)) (cnn-rr! (list '- u s))
                        (cng-real-cc! (list '- s u))
                        (cng-cc! '(- cgy_ cgx_))
                        (cng-cc! (list '- ps pu))
                        (cnn-rr! a) (cnn-rr! dbnd) (cnn-rr! mag)
                        (dk-have! (list '= (list '- ps pu) (list '* (list '- s u) '(- cgy_ cgx_))) (lambda () (crs)))
                        (dk-have! (list '= mag dbnd)
                          (lambda ()
                            (subst (list '= (list '- ps pu) (list '* (list '- s u) '(- cgy_ cgx_))))
                            (subst (cnn-chain! (dk-fact! 'cc-magnitude-mul (list '- s u) '(- cgy_ cgx_))))
                            (subst (dk-cite! 'rr-magnitude-is-abs (list '- s u)))
                            (subst (dk-cite! 'rr-abs-sub-sym s u))
                            (rfl)))
                        (dk-have! (list '<= a d) (lambda () (dk-ineq! (list '< a d))))
                        (cnn-chain! (dk-fact! 'rr-mul-le-right a d cng-m))
                        (dk-have! (list '< dbnd r)
                          (lambda () (dk-ineq! (list '<= dbnd (list '* d cng-m)) (list '= (list '+ d (list '* d cng-m)) (list '* r 1))
                                               (list '< 0 d))))
                        (fact 'cc-ms-dist ps pu)
                        (dk-have! (list '<= (list '(DIST CC-MS) ps pu) dbnd)
                          (lambda () (subst (list '== (list '(DIST CC-MS) ps pu) mag)) (subst (list '= mag dbnd)) (dk-ineq!)))
                        (dk-have! (list 'IN ps '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (dk-have! (list 'IN pu '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
                        (cnn-chain! (dk-fact! 'ball-mem-from-le 'CC-MS ps pu dbnd r))
                        (fact 'subset-mem-fwd (list 'BALL 'CC-MS ps r) X pu)
                        (in-sep! (lambda () (ass))))))))))))))

(sp (make-wff (list 'FORALL 'cgu_ (list 'FORALL 'cgv_ (list 'IMPLIES '(IS-OPEN CC-MS cgu_) (list 'IMPLIES '(IS-OPEN CC-MS cgv_)
  (list 'FORALL 'cgx_ (list 'IMPLIES '(IN cgx_ CC) (list 'FORALL 'cgy_ (list 'IMPLIES '(IN cgy_ CC)
    (list 'IMPLIES cng-cover (list 'IMPLIES cng-disj (list 'IMPLIES '(IN cgx_ cgu_) '(IN cgy_ cgu_))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(cng-cc! '(- cgy_ cgx_))
(cnn-rr! cng-m)
(fact 'cc-magnitude-nonneg '(- cgy_ cgx_))
;; the three hypotheses of unit-interval-clopen for P, Q
(dk-have! (cnn-cover cng-P cng-Q)
  (lambda ()
    (let ((t (dk-di-var!)))
      (cnn-unit! t)
      (use-cases (dk-apply! cng-cover t)
        (lambda () (dk-have! (list 'IN t cng-P) (lambda () (in-sep! (lambda () (ass))))) (prop))
        (lambda () (dk-have! (list 'IN t cng-Q) (lambda () (in-sep! (lambda () (ass))))) (prop))))))
(dk-have! (cnn-disj cng-P cng-Q)
  (lambda ()
    (let ((t (dk-di-var!)))
      (di)
      (dk-split-all!)
      (dk-project! (list 'IN (cng-pt t) 'cgu_) (lambda () (sep-me (list 'IN t cng-P))))
      (dk-project! (list 'IN (cng-pt t) 'cgv_) (lambda () (sep-me (list 'IN t cng-Q))))
      (let ((dj (dk-apply! cng-disj t)))
        (cnn-only-prop! dj (list 'IN (cng-pt t) 'cgu_) (list 'IN (cng-pt t) 'cgv_))))))
(cng-open! 'cgu_)
(cng-open! 'cgv_)
(cng-cc! (cng-pt 0))
(dk-have! (list '= (cng-pt 0) 'cgx_) (lambda () (crs)))
(dk-have! (list 'IN 0 cng-P) (lambda () (in-sep! (lambda () (subst (list '= (cng-pt 0) 'cgx_)) (ass)))))
(define cng-all (cnn-chain! (dk-fact! 'unit-interval-clopen cng-P cng-Q)))
(cnn-to-unit! 1)
(dk-apply! cng-all 1)
(dk-project! (list 'IN (cng-pt 1) 'cgu_) (lambda () (sep-me (list 'IN 1 cng-P))))
(cng-cc! (cng-pt 1))
(dk-have! (list '= (cng-pt 1) 'cgy_) (lambda () (crs)))
(dk-rewrite-h! (list 'IN (cng-pt 1) 'cgu_) (cng-pt 1) 'cgy_)
(ass)
(qed 'cc-segment-clopen)
(topic! 'cc-segment-clopen 'analysis)

;;; ======================================================================
;;; (3) CONVEX AND STAR-SHAPED SUBSETS OF CC ARE CONNECTED
;;; ======================================================================
(define (cnc-pt a b t) (list '+ a (list '* t (list '- b a))))
;; In the separation context of IS-CONNECTED(CC-MS, U0): from A in X, the segment A -> B inside U0
;; (SEG-IN! A B T lands (IN pt U0) for T in [0, 1]), land (IN B X).  X, Y are the two open sets.
(define (cnc-seg! U0 X Y a b seg-in!)
  (let ((cov (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ cnn-I)
               (list 'OR (list 'IN (cnc-pt a b 'cgt_) X) (list 'IN (cnc-pt a b 'cgt_) Y)))))
        (dsj (list 'FORALL 'cgt_ (list 'IMPLIES (list 'IN 'cgt_ cnn-I)
               (list 'NOT (list 'AND (list 'IN (cnc-pt a b 'cgt_) X) (list 'IN (cnc-pt a b 'cgt_) Y)))))))
    (dk-have! cov
      (lambda ()
        (let* ((t (dk-di-var!)) (p (cnc-pt a b t)))
          (seg-in! a b t)
          (fact 'subset-mem-fwd U0 (cnc-union) p)
          (let ((ui (dk-cite! 'union-membership 'cnu_ 'cnv_ p)))
            (cnn-only-prop! ui (list 'IN p (cnc-union)))))))
    (dk-have! dsj
      (lambda ()
        (let* ((t (dk-di-var!)) (p (cnc-pt a b t)))
          (seg-in! a b t)
          (let ((dj (dk-apply! (cnc-disj U0) p)))
            (cnn-only-prop! dj)))))
    (cnn-chain! (dk-fact! 'cc-segment-clopen X Y a b))))
(define (cnc-union) '(UNION cnu_ cnv_))
(define (cnc-disj U0) (list 'FORALL 'cnx_ (list 'IMPLIES (list 'IN 'cnx_ U0) (list 'NOT (list 'AND '(IN cnx_ cnu_) '(IN cnx_ cnv_))))))

;; prove IS-CONNECTED(CC-MS, U0) given (SUBSET U0 CC) in context; CLOSE! gets x (in U0 n U) and y (in
;; U0 n V) and must close the goal
(define (cnc-connected! U0 close!)
  (fact 'cc-is-metric-space)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (let* ((ci (dk-cite! 'is-connected 'CC-MS U0)) (rhs (caddr ci)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (ass))
                    ((dk-head-is? g 'SUBSET) (subst '(== (PTS CC-MS) CC)) (ass))
                    (#t
                     (dk-peel!)
                     (if (dk-head-is? (dk-goal) 'NOT) (di))
                     (let* ((xf (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cnu_))) "x in U"))
                            (x (dk-skolem! xf))
                            (_0 (dk-split-all!))
                            (yf (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cnv_))) "y in V"))
                            (y (dk-skolem! yf))
                            (_1 (dk-split-all!)))
                       (fact 'subset-mem-fwd U0 'CC x)
                       (fact 'subset-mem-fwd U0 'CC y)
                       (close! x y)))))))))
    (cnn-only-prop! ci rhs)))
;; y in U and y in V, y in U0: contradiction
(define (cnc-clash! U0 y)
  (let ((dj (dk-apply! (cnc-disj U0) y)))
    (cnn-only-prop! dj (list 'IN y 'cnu_) (list 'IN y 'cnv_))))

(sp (make-wff '(FORALL cvu_ (IMPLIES (IS-CONVEX-CC cvu_) (IS-CONNECTED CC-MS cvu_)))))
