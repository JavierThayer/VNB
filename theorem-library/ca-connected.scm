    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'SUBSET)
              (let ((x (subset-by-element!))) (sep-me (list 'IN x cnh-H)) (dk-split-all!) (cnn-close-open!))
              (let* ((lk (dk-peel!))
                     (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnh-H))) lk))
                     (x (cadr (car ins))) (y (cadr (cadr ins)))
                     (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cnn-I))) lk)))))
                (for-each (lambda (v)
                            (dk-project! (list 'IN v 'CC) (lambda () (sep-me (list 'IN v cnh-H))))
                            (dk-project! (list '< 0 (list 'real-part v)) (lambda () (sep-me (list 'IN v cnh-H)))))
                          (list x y))
                (cnn-unit! t) (fact 'rr-subset-cc t)
                (let* ((pe (cnh-part-eq! 'real-part x t y))
                       (pos (cnh-pos-comb! (list 'real-part x) (list 'real-part y) t #t)))
                  (in-sep! (lambda () (subst pe) (ass))))))))))
  (cnn-only-prop! ci rhs))
(qed 'cc-right-half-plane-convex)
(topic! 'cc-right-half-plane-convex 'analysis)

