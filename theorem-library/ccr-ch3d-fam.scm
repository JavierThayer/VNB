;;; ccr-ch3d-fam.scm -- CCR.pdf chapter 3, Lemma 3.4 and Proposition 3.6 for a FAMILY of matrices with the
;;; rigidity property, instead of the commutant of one irreducible T.  Agent CCR-1109-B4, wave 2026-11-09.
;;; Destination: theorem-library/ccr-ch3d-fam.scm.  Library: analysis.  Helper prefix cf4-.
;;;
;;; THE PROPERTY (finding F3 of CCR-1109-B3).  ccr-3-4-comm and ccr-3-6-ultra use the irreducible T only
;;; through ccr-3-4-commutant: "B commutes with T and det B = 0 imply B = 0".  Here T is replaced by a class
;;; fm of n-by-n matrices over K and the property is a hypothesis, RIGID(fm):
;;;     every n-by-n B commuting with every member of fm and with det B = 0 is 0.
;;; {T} is rigid when T is irreducible (ccr-3-4-commutant); the multiplication matrices {M(xi) : xi in F}
;;; of a finite extension are rigid with no further hypothesis (ext-mult-mat-rigid, ccr-ch3d-ext.scm).
;;;
;;;   cf4-step         the step of Lemma 3.4 (cd8-step with the commutation over fm)
;;;   ccr-3-4-fam      K local NV field, fm rigid, X commuting with fm, |det X| <= 1  =>  X power bounded
;;;   ccr-3-6-fam-inv  S, R commuting with fm, P S = S P = I, |det R| <= |det S|  =>  |det(S + R)| <= |det S|
;;;   ccr-3-6-fam      S, R commuting with fm  =>  |det(S + R)| <= max(|det S|, |det R|)
;;;
;;; The drivers are CCR-1109-B3's (ccr-ch3c-pb.scm: cd8-step, ccr-3-4-comm, ccr-3-6-ultra-inv, ccr-3-6-ultra),
;;; with "Y T = T Y" replaced by "Y y = y Y for every y in fm" (proved on a lane per member), the
;;; ccr-3-4-commutant citation by RIGID(fm), and the inverse hypothesis of ccr-3-6-ultra by
;;; invertible-iff-det-nonzero (la-det-adjoint) on the ring view (cq4-view-field-ring).
;;;
;;; LOAD WINDOW: after theorem-library/ccr-ch3c-pb (CCR-1109-B3: cd8-unbounded, cd8-mat-argmax, cd8-mpow-type,
;;; cd8-scale-bound, cd8-scale-commute, cd8-scale-as-mul, cd8-power-le-base, cd8-close-mul-right/-left,
;;; cd8-mat-has-bound, cd8-argmax-nn), the latest citation; ccr-ch3c-ball (ccr-mat-ball-seq-compact),
;;; ccr-ch3c-det (ccr-det-close), ccr-ch3-ops (cb3-*, ccr-3-1-eq21, ccr-3-6-multiplicative), ccr-ch3b-alg
;;; (cq4-commute-power, cq4-view-field-ring) and la-det-adjoint load earlier.

(define cf4-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define cf4-ag `(RING-ADDITIVE-AG ,cf4-v))
(define cf4-mr `(MAT-RING ,cf4-v n))
(define cf4-mrm `(RING-MULTIPLICATIVE-MONOID ,cf4-mr))
(define (cf4-n x) `((FNRM K) ,x))
(define (cf4-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define (cf4-mat m n) `(MAT ,m ,n (CARR K)))
(define (cf4-matv m n) `(MAT ,m ,n (CARR ,cf4-v)))
(define (cf4-mm a b) `(MATMUL ,cf4-v ,a ,b))

(define (cf4-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cd8: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 14 (length a))))))
                  (dk-open-leaves))))
  (qed name))
(define (cf4-dump! tag)
  (display ";; cd8 DUMP ") (display tag) (newline)
  (display ";;   GOAL ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
            (let ((a (dk-asms))) (list-head a (min 30 (length a))))))

(define (cf4-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring cf4-v)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-one normed-field-ring-view-zero normed-field-ring-view-neg)))
(define (cf4-to-v! a m n)
  (if (not (dk-asm? `(IN ,a ,(cf4-matv m n))))
      (dk-have! `(IN ,a ,(cf4-matv m n)) (lambda () (subst `(= (CARR ,cf4-v) (CARR K))) (dk-ass!)))))
(define (cf4-to-k! a m n)
  (if (not (dk-asm? `(IN ,a ,(cf4-mat m n))))
      (dk-have! `(IN ,a ,(cf4-mat m n)) (lambda () (subst `(= (CARR K) (CARR ,cf4-v))) (dk-ass!)))))
(define (cf4-in-k! t)
  (if (not (dk-asm? `(IN ,t (CARR K))))
      (dk-have! `(IN ,t (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cf4-v))) (dk-ass!)))))
(define (cf4-in-v! t)
  (if (not (dk-asm? `(IN ,t (CARR ,cf4-v))))
      (dk-have! `(IN ,t (CARR ,cf4-v)) (lambda () (subst `(= (CARR ,cf4-v) (CARR K))) (dk-ass!)))))
(define (cf4-crs! eq atoms)
  (dk-have! eq
    (lambda ()
      (for-each cf4-in-v! atoms)
      (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cf4-v)))))
                '(ADD MUL NEG ONE ZERO))
      (crs))))
(define (cf4-real! t)
  (if (not (dk-asm? `(IN ,t RR))) (dk-cite! 'nf-norm-in-rr 'K (cadr t)))
  (if (not (dk-asm? `(<= 0 ,t))) (dk-cite! 'nf-norm-nonneg 'K (cadr t))))

;; ineq on the atomic order facts and RR typings of the context (no universals, no implications)
(define (cf4-ineq-ctx!)
  (apply dk-ineq!
    (filter (lambda (f) (and (pair? f)
                             (or (memq (car f) '(<= <))
                                 (and (eq? (car f) 'IN) (eq? (caddr f) 'RR)))
                             (not (dk-contains? f 'FORALL)) (not (dk-contains? f 'IMPLIES))))
            (dk-asms))))

;; f(x) in B from f in FUN(A, B) and x in A (fun-apply-type's antecedent is ONE conjunction)
(define (cf4-app-type! f a b x)
  (if (not (dk-asm? `(IN (,f ,x) ,b)))
      (begin
        (dk-have! `(AND (IN ,f (FUN ,a ,b)) (IN ,x ,a)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (dk-cite! 'fun-apply-type f a b x))))

;; close a goal (<= (f a) (f b)) from the (<= (f _) (f _)) facts and the (f _) in RR typings
(define (cf4-fv-close! fv)
  (define (app? t) (and (pair? t) (eq? (car t) fv) (= (length t) 2)))
  (if (dk-asm? (dk-goal))
      (dk-ass!)
      (apply dk-ineq!
        (filter (lambda (f) (and (pair? f)
                                 (or (and (eq? (car f) '<=) (app? (cadr f)) (app? (caddr f)))
                                     (and (eq? (car f) 'IN) (app? (cadr f)) (eq? (caddr f) 'RR)))))
                (dk-asms)))))

(define (cf4-bound-univ a m n c)
  `(FORALL cbvi_ (IMPLIES (IN cbvi_ (INTERVAL 1 ,m))
     (FORALL cbvj_ (IMPLIES (IN cbvj_ (INTERVAL 1 ,n)) (<= ,(cf4-n `(ENTRY ,a cbvi_ cbvj_)) ,c))))))
(define (cf4-bound-parts! a m n c)
  (let ((h `(IS-MAT-BOUND K ,m ,n ,a ,c)))
    (dk-project! `(IN ,a ,(cf4-mat m n)) (lambda () (mac-h 'is-mat-bound h)))
    (dk-project! (cf4-bound-univ a m n c) (lambda () (mac-h 'is-mat-bound h)))))
(define (cf4-close-univ a b m n e)
  `(FORALL cdvi_ (IMPLIES (IN cdvi_ (INTERVAL 1 ,m))
     (FORALL cdvj_ (IMPLIES (IN cdvj_ (INTERVAL 1 ,n))
       (<= ,(cf4-n (cf4-sub `(ENTRY ,a cdvi_ cdvj_) `(ENTRY ,b cdvi_ cdvj_))) ,e))))))
(define (cf4-close-parts! a b m n e)
  (let ((h `(IS-MAT-CLOSE K ,m ,n ,a ,b ,e)))
    (dk-project! `(IN ,a ,(cf4-mat m n)) (lambda () (mac-h 'is-mat-close h)))
    (dk-project! `(IN ,b ,(cf4-mat m n)) (lambda () (mac-h 'is-mat-close h)))
    (dk-project! (cf4-close-univ a b m n e) (lambda () (mac-h 'is-mat-close h)))))

;;; 1. A scalar multiple of a bounded matrix is bounded: ||y A|| <= |y| c.

;;; ---- the family hypotheses (this file's statements)
;; every member of the family fm is an n-by-n matrix over K
(define cf4-fm-typed `(FORALL cfy_ (IMPLIES (IN cfy_ fm) (IN cfy_ ,(cf4-mat 'n 'n)))))
;; A commutes with every member of fm
(define (cf4-comm a) `(FORALL cfy_ (IMPLIES (IN cfy_ fm) (= ,(cf4-mm a 'cfy_) ,(cf4-mm 'cfy_ a)))))
;; RIGIDITY: a matrix commuting with every member of fm and of determinant 0 is 0
(define cf4-rigid
  `(FORALL cfb_ (IMPLIES (IN cfb_ ,(cf4-mat 'n 'n))
     (IMPLIES ,(cf4-comm 'cfb_) (IMPLIES (= (DET ,cf4-v n cfb_) (ZERO K)) (= cfb_ (ZEROMAT ,cf4-v n n)))))))
;; goal (FORALL cfy_ (IMPLIES (IN cfy_ fm) ...)): peel, land the member's typing, return it
(define (cf4-peel-member!)
  (let* ((landed (dk-peel!))
         (m (let loop ((ls landed))
              (cond ((null? ls) (error "cf4-peel-member!: no member landed"))
                    ((and (dk-head-is? (car ls) 'IN) (eq? (caddr (car ls)) 'fm)) (cadr (car ls)))
                    (#t (loop (cdr ls)))))))
    (dk-apply! (dk-ctx-form cf4-fm-typed) m)
    m))
;; with cq4-view-field-ring in context: det A /= 0 implies a two-sided inverse (goal: cf4-inv-hyp A)
(define (cf4-inv! a)
  (di)
  (dk-have! `(NOT (= (DET ,cf4-v n ,a) (ZERO ,cf4-v)))
    (lambda () (subst `(= (ZERO ,cf4-v) (ZERO K))) (dk-ass!)))
  (let ((iff (dk-cite! 'invertible-iff-det-nonzero cf4-v 'n a)))
    (dk-have! `(IS-INVERTIBLE-MAT ,cf4-v n ,a)
      (lambda () (dk-only! iff `(NOT (= (DET ,cf4-v n ,a) (ZERO ,cf4-v)))) (prop))))
  (let* ((u (dk-landed-1 (lambda () (mac-h 'IS-INVERTIBLE-MAT `(IS-INVERTIBLE-MAT ,cf4-v n ,a)))))
         (pv (dk-skolem! u)))
    (dk-split-all!)
    (ew pv)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
            (begin (subst `(= (CARR K) (CARR ,cf4-v))) (dk-ass!)))))))

;;; 10. THE STEP: if X commutes with T, |det X| <= 1 and X is not power bounded, then for every k there is
;;;     a matrix Y with ||Y|| <= 1, an entry of norm 1, Y T = T Y and |det Y| (k + 1) <= 1.

(define (cf4-good kk y)
  `(AND (IS-MAT-BOUND K n n ,y 1)
   (AND ,(cf4-comm y)
   (AND (<= (* ,(cf4-n `(DET ,cf4-v n ,y)) (+ ,kk 1)) 1)
        (FORSOME cd8i_ (AND (IN cd8i_ (INTERVAL 1 n)) (FORSOME cd8j_ (AND (IN cd8j_ (INTERVAL 1 n))
          (= ,(cf4-n `(ENTRY ,y cd8i_ cd8j_)) 1)))))))))
(define cf4-step-hyps
  `((IN X ,(cf4-mat 'n 'n)) ,cf4-fm-typed ,(cf4-comm 'X)
    (<= ,(cf4-n `(DET ,cf4-v n X)) 1) (NOT (IS-POWER-BOUNDED K n X))))
(define (cf4-implies hyps body)
  (if (null? hyps) body `(IMPLIES ,(car hyps) ,(cf4-implies (cdr hyps) body))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL X (FORALL fm
