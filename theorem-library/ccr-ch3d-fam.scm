  (cf4-mtype! 'pa (cf4-mm 'sa tp))
  ;; e1: S (T P) = T
  (dk-have! `(= ,(cf4-mm 'sa tp) ,tm)
    (lambda ()
      (cf4-assoc! 'sa tm 'pa)
      (subst `(= ,(cf4-mm 'sa tp) ,(cf4-mm (cf4-mm 'sa tm) 'pa)))
      (subst `(= ,(cf4-mm 'sa tm) ,(cf4-mm tm 'sa)))
      (cf4-assoc! tm 'sa 'pa)
      (subst `(= ,(cf4-mm (cf4-mm tm 'sa) 'pa) ,(cf4-mm tm (cf4-mm 'sa 'pa))))
      (subst `(= ,(cf4-mm 'sa 'pa) ,cf4-id))
      (dk-cite! 'identmat-right-identity cf4-v 'n 'n tm)
      (dk-ass!)))
  ;; e2: P (S (T P)) = P T  and  = T P
  (dk-have! `(= ,(cf4-mm 'pa (cf4-mm 'sa tp)) ,pt)
    (lambda () (subst `(= ,(cf4-mm 'sa tp) ,tm)) (rfl)))
  (dk-have! `(= ,(cf4-mm 'pa (cf4-mm 'sa tp)) ,tp)
    (lambda ()
      (cf4-assoc! 'pa 'sa tp)
      (subst `(= ,(cf4-mm 'pa (cf4-mm 'sa tp)) ,(cf4-mm (cf4-mm 'pa 'sa) tp)))
      (subst `(= ,(cf4-mm 'pa 'sa) ,cf4-id))
      (dk-cite! 'identmat-left-identity cf4-v 'n 'n tp)
      (dk-ass!)))
  (dk-have! `(= ,pt ,tp)
    (lambda () (subst `(= ,pt ,(cf4-mm 'pa (cf4-mm 'sa tp)))) (dk-ass!)))
  ;; X = P R commutes with T
  (cf4-mtype! xa tm) (cf4-mtype! tm xa)
  (dk-have! `(= ,(cf4-mm xa tm) ,(cf4-mm tm xa))
    (lambda ()
      (cf4-assoc! 'pa 'ra tm)
      (subst `(= ,(cf4-mm xa tm) ,(cf4-mm 'pa (cf4-mm 'ra tm))))
      (subst `(= ,(cf4-mm 'ra tm) ,(cf4-mm tm 'ra)))
      (cf4-assoc! 'pa tm 'ra)
      (subst `(= ,(cf4-mm 'pa (cf4-mm tm 'ra)) ,(cf4-mm pt 'ra)))
      (subst `(= ,pt ,tp))
      (cf4-assoc! tm 'pa 'ra)
      (dk-ass!))))))
  ;; |det X| <= 1
  (for-each (lambda (a) (cf4-to-v! a 'n 'n) (dk-cite! 'det-in-carrier cf4-v 'n a) (cf4-in-k! `(DET ,cf4-v n ,a)) (cf4-real! (dn a)))
            (list 'pa 'ra 'sa xa (cf4-mm 'pa 'sa)))
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'pa 'ra)
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'pa 'sa)
  (dk-cite! 'det-identity-ind cf4-v 'n)
  (dk-cite! 'nf-norm-one 'K)
  (dk-have! `(= ,(dn (cf4-mm 'pa 'sa)) 1)
    (lambda ()
      (subst `(= ,(cf4-mm 'pa 'sa) ,cf4-id))
      (subst `(= (DET ,cf4-v n ,cf4-id) (ONE ,cf4-v)))
      (subst `(= (ONE ,cf4-v) (ONE K)))
      (dk-ass!)))
  (dk-cite! 'rr-mul-le-right (dn 'ra) (dn 'sa) (dn 'pa))
  (dk-have! `(= (* ,(dn 'pa) ,(dn 'ra)) (* ,(dn 'ra) ,(dn 'pa))) (lambda () (crs)))
  (dk-have! `(= (* ,(dn 'sa) ,(dn 'pa)) (* ,(dn 'pa) ,(dn 'sa))) (lambda () (crs)))
  (dk-have! `(<= ,(dn xa) 1)
    (lambda () (dk-le-chain! (dn xa) `(* ,(dn 'pa) ,(dn 'ra)) `(* ,(dn 'ra) ,(dn 'pa)) `(* ,(dn 'sa) ,(dn 'pa))
                             `(* ,(dn 'pa) ,(dn 'sa)) (dn (cf4-mm 'pa 'sa)) 1)))
  ;; X power bounded, |det(I + X)| <= 1
  (dk-cite! 'ccr-3-4-fam 'K 'n xa 'fm)
  (dk-cite! 'cb3-det-shift-bound 'K 'n xa)
  ;; S + R = S (I + X)
  (dk-cite! 'matadd-type cf4-v 'n 'n cf4-id xa)
  (dk-cite! 'matadd-type cf4-v 'n 'n 'sa 'ra)
  (cf4-to-k! ix 'n 'n) (cf4-to-k! sr 'n 'n)
  (cf4-mtype! 'sa ix) (cf4-mtype! 'sa xa) (cf4-to-v! (cf4-mm 'sa 'pa) 'n 'n)
  (dk-have! `(= ,(cf4-mm 'sa ix) ,sr)
    (lambda ()
      (dk-cite! 'matmul-left-dist-guarded cf4-v 'n 'n 'n 'sa cf4-id xa)
      (subst `(= ,(cf4-mm 'sa ix) (MATADD ,cf4-v ,(cf4-mm 'sa cf4-id) ,(cf4-mm 'sa xa))))
      (dk-cite! 'identmat-right-identity cf4-v 'n 'n 'sa)
      (subst `(= ,(cf4-mm 'sa cf4-id) sa))
      (cf4-assoc! 'sa 'pa 'ra)
      (subst `(= ,(cf4-mm 'sa xa) ,(cf4-mm (cf4-mm 'sa 'pa) 'ra)))
      (subst `(= ,(cf4-mm 'sa 'pa) ,cf4-id))
      (dk-cite! 'identmat-left-identity cf4-v 'n 'n 'ra)
      (subst `(= ,(cf4-mm cf4-id 'ra) ra))
      (rfl)))
  ;; the estimate
  (for-each (lambda (a) (cf4-to-v! a 'n 'n) (dk-cite! 'det-in-carrier cf4-v 'n a) (cf4-in-k! `(DET ,cf4-v n ,a)) (cf4-real! (dn a)))
            (list ix (cf4-mm 'sa ix)))
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'sa ix)
  (dk-cite! 'rr-one-in)
  (dk-cite! 'rr-mul-le-right (dn ix) 1 (dn 'sa))
  (dk-have! `(= (* ,(dn 'sa) ,(dn ix)) (* ,(dn ix) ,(dn 'sa))) (lambda () (crs)))
  (dk-have! `(= (* 1 ,(dn 'sa)) ,(dn 'sa)) (lambda () (crs)))
  (subst `(= ,sr ,(cf4-mm 'sa ix)))
  (dk-le-chain! (dn (cf4-mm 'sa ix)) `(* ,(dn 'sa) ,(dn ix)) `(* ,(dn ix) ,(dn 'sa)) `(* 1 ,(dn 'sa)) (dn 'sa)))
(cf4-qed! 'ccr-3-6-fam-inv)
(define (cf4-inv-hyp a)
  `(IMPLIES (NOT (= (DET ,cf4-v n ,a) (ZERO K)))
     (FORSOME cd8p_ (AND (IN cd8p_ ,(cf4-mat 'n 'n))
       (AND (= ,(cf4-mm 'cd8p_ a) ,cf4-id) (= ,(cf4-mm a 'cd8p_) ,cf4-id))))))
;; goal |det(big + small)| <= |det big|, with |det small| <= |det big|, both commuting with tm
(define (cf4-ultra-case! big small)
  (let ((ab `(MATADD ,cf4-v ,big ,small)) (hb (cf4-inv-hyp big)))
    (use-em `(= (DET ,cf4-v n ,big) (ZERO K))
      (lambda ()
        (dk-apply! (dk-ctx-form cf4-rigid) big)
        (dk-cite! 'matadd-zero-left cf4-v 'n 'n small)
        (dk-have! `(= ,ab ,small)
          (lambda () (subst `(= ,big (ZEROMAT ,cf4-v n n))) (dk-ass!)))
        (subst `(= ,ab ,small))
        (dk-ass!))
      (lambda ()
        (let* ((ex (detach! hb))
               (pv (dk-skolem! (or (dk-ctx-form (caddr hb)) (error "cf4-ultra-case!: no inverse")) #t)))
          (dk-split-all!)
          (dk-cite! 'ccr-3-6-fam-inv 'K 'n 'fm big small pv)
          (dk-ass!))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL fm
  (IMPLIES ,cf4-fm-typed (IMPLIES ,cf4-rigid
  (FORALL sa (IMPLIES (IN sa ,(cf4-mat 'n 'n)) (FORALL ra (IMPLIES (IN ra ,(cf4-mat 'n 'n))
    (IMPLIES ,(cf4-comm 'sa)
    (IMPLIES ,(cf4-comm 'ra)
      (<= ,(cf4-n `(DET ,cf4-v n (MATADD ,cf4-v sa ra)))
          (MAX ,(cf4-n `(DET ,cf4-v n sa)) ,(cf4-n `(DET ,cf4-v n ra)))))))))))))))))))
(dk-peel!)
(dk-project! '(IS-NV-FIELD K) (lambda () (mac-h 'is-local-nv-field '(IS-LOCAL-NV-FIELD K))))
(dk-cite! 'nv-field-normed 'K)
(cf4-view!)
(dk-cite! 'cq4-view-field-ring 'K)
(for-each (lambda (a) (cf4-to-v! a 'n 'n) (dk-have! (cf4-inv-hyp a) (lambda () (cf4-inv! a)))) '(sa ra))
(let* ((dn (lambda (a) (cf4-n `(DET ,cf4-v n ,a)))))
  (for-each (lambda (a) (dk-cite! 'det-in-carrier cf4-v 'n a) (cf4-in-k! `(DET ,cf4-v n ,a)) (cf4-real! (dn a)))
            '(sa ra))
  (use-em `(<= ,(dn 'ra) ,(dn 'sa))
    (lambda ()
      (dk-cite! 'rr-max-left-le (dn 'sa) (dn 'ra))
      (subst `(= (MAX ,(dn 'sa) ,(dn 'ra)) ,(dn 'sa)))
      (cf4-ultra-case! 'sa 'ra))
    (lambda ()
      (let ((nf `(NOT (<= ,(dn 'ra) ,(dn 'sa)))))
        (dk-have! `(AND (IN ,(dn 'ra) RR) (IN ,(dn 'sa) RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (let ((orf (dk-cite! 'rr-leq-total (dn 'ra) (dn 'sa))))
          (dk-have! `(<= ,(dn 'sa) ,(dn 'ra)) (lambda () (dk-only! orf nf) (prop)))))
      (dk-cite! 'rr-max-right-le (dn 'sa) (dn 'ra))
      (subst `(= (MAX ,(dn 'sa) ,(dn 'ra)) ,(dn 'ra)))
      (dk-cite! 'matadd-comm cf4-v 'n 'n 'sa 'ra)
      (subst `(= (MATADD ,cf4-v sa ra) (MATADD ,cf4-v ra sa)))
      (cf4-ultra-case! 'ra 'sa))))
(cf4-qed! 'ccr-3-6-fam)
