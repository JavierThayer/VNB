    ;; Y = y P typed; the bound
    (cf4-in-v! yv)
    (cf4-to-v! p 'n 'n)
    (dk-cite! 'matscale-type cf4-v 'n 'n yv p)
    (cf4-to-k! sy 'n 'n)
    (dk-have! `(IS-MAT-BOUND K n n ,p ,nb)
