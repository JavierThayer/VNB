;; with the choice universal CHV (forall k in NN. g(k) in fam(k)) and kv typed in NN: land g(kv) in MAT and
;; the four clauses of good(kv, g(kv)); return the clause list
(define (cf4-good-at! gv chv kv)
  (let* ((gk `(,gv ,kv))
         (mem (dk-apply! chv kv))
         (mem2 `(IN ,gk (SEP cd8y_ ,(cf4-mat 'n 'n) ,(cf4-good kv 'cd8y_))))
         (gd (cf4-good kv gk)))
    (cf4-app-type! gv 'NN (cf4-mat 'n 'n) kv)
    (if (not (dk-asm? gd))
        (begin
          (if (not (dk-asm? mem2)) (dk-lam-b-h! mem))
          (if (not (dk-asm? mem2)) (error "cf4-good-at!: no SEP membership" (expression->string mem2)))
          (dk-project! gd (lambda () (sep-me mem2)))))
    (let* ((gdc (or (dk-ctx-form gd) (error "cf4-good-at!: clauses not in context" (expression->string gd))))
           (c1 (cadr gdc)) (r1 (caddr gdc)) (c2 (cadr r1)) (r2 (caddr r1)) (c3 (cadr r2)) (c4 (caddr r2)))
      ;; a clause equal to the focus goal is proved IN PLACE by dk-have!, which moves the
      ;; focus: do those last
      (let* ((g0 (dk-goal)) (cs (list c1 c2 c3 c4))
             (isg (lambda (f) (alpha-equiv? f g0))))
        (for-each (lambda (f) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-only! gdc) (dk-split! gdc) (dk-ass!)))))
                  (append (filter (lambda (f) (not (isg f))) cs) (filter isg cs))))
      (list c1 c2 c3 c4))))

