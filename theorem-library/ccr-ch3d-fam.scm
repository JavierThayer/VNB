    ;; the determinant
    (dk-cite! 'matscale-type cf4-v 'n 'n yv `(IDENTMAT ,cf4-v n))
    (cf4-to-k! yi 'n 'n)
    (dk-cite! 'cb3-identmat-bound 'K 'n)
    (dk-have! `(<= (* ,ny 1) ,ny) (lambda () (subst `(= (* ,ny 1) ,ny)) (dk-ineq! `(IN ,ny RR))))
    (dk-cite! 'cd8-scale-bound 'K 'n 'n yv `(IDENTMAT ,cf4-v n) 1 ny)
    (dk-cite! 'ccr-3-1-eq21 'K 'n yi ny)
    (dk-cite! 'cd8-power-le-base 'n ny)
    (dk-cite! 'cd8-scale-as-mul 'K 'n p yv)
    (dk-cite! 'ccr-3-6-multiplicative 'K 'n yi p)
    (dk-cite! 'det-in-carrier cf4-v 'n 'X)
    (cf4-in-k! `(DET ,cf4-v n X))
    (dk-cite! 'cb3-det-mpow-ind jv 'K 'n 'X)
    (dk-cite! 'cb3-mat-power-unfold 'K 'n 'X jv)
    (dk-cite! 'nv-pow-norm-power 'K `(DET ,cf4-v n X) jv)
    (cf4-real! (cf4-n `(DET ,cf4-v n X)))
    (dk-have! `(AND (<= 0 ,(cf4-n `(DET ,cf4-v n X))) (<= ,(cf4-n `(DET ,cf4-v n X)) 1)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'rr-power-le-one jv (cf4-n `(DET ,cf4-v n X)))
    (let* ((dp `(DET ,cf4-v n ,p))
