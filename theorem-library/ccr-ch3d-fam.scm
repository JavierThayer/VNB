(dk-cite! 'nn-in-rr 'cdk)
(dk-have! '(<= 0 cdk) (lambda () (dk-nn!)))
(dk-have! '(<= 0 (+ cdk 1)) (lambda () (dk-nn!)))
(let* ((c '(+ cdk 1))
       (ex1 (dk-cite! 'cd8-unbounded 'K 'n 'X c))
       (jv (dk-skolem! ex1 #t)) (ig1 (dk-split-all!))
       (ex2 (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "i"))
       (iv (dk-skolem! ex2 #t)) (ig2 (dk-split-all!))
       (ex3 (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "l"))
       (lv (dk-skolem! ex3 #t)) (ig3 (dk-split-all!))
       (p `(MAT-POWER K n X ,jv))
       (ig4 (dk-cite! 'cd8-mpow-type 'K 'n 'X jv))
       (ig5 (begin (dk-cite! 'interval-lo 1 'n iv) (dk-cite! 'interval-hi 1 'n iv)
                   (dk-cite! 'interval-elt-in-nn 1 'n iv)
                   (dk-have! '(<= 1 n) (lambda () (dk-nn!)))))
       (exm (dk-cite! 'cd8-mat-argmax 'K 'n p))
       (i0 (dk-skolem! exm #t)) (ig6 (dk-split-all!))
       (exm2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i0))) "j0"))
       (j0 (dk-skolem! exm2 #t)) (ig7 (dk-split-all!))
       (mx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f j0) (dk-contains? f i0))) "the max"))
       (beta `(ENTRY ,p ,i0 ,j0))
       (nb (cf4-n beta))
       (pil `(ENTRY ,p ,iv ,lv)))
  (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) p i0 j0)
  (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) p iv lv)
  (cf4-real! nb) (cf4-real! (cf4-n pil))
  (dk-apply! mx iv lv)
  (dk-have! `(< ,c ,nb) (lambda () (dk-ineq! `(< ,c ,(cf4-n pil)) `(<= ,(cf4-n pil) ,nb) '(IN cdk RR) `(IN ,nb RR) `(IN ,(cf4-n pil) RR))))
  ;; beta /= 0
  (dk-cite! 'nf-norm-of-zero 'K)
  (dk-have! `(NOT (= ,beta (ZERO K)))
    (lambda ()
      (di)
      (let* ((h1 (dk-rewrite-h! `(< ,c ,nb) beta '(ZERO K)))
             (h2 (dk-rewrite-h! h1 (cf4-n '(ZERO K)) 0)))
        (dk-absurd! h2 '(<= 0 cdk) '(IN cdk RR)))))
  (let* ((exy (dk-cite! 'nf-inverse 'K beta))
         (yv (dk-skolem! exy #t)) (ig8 (dk-split-all!))
