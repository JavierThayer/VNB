    (dk-have! `(<= (* ,ny ,nb) 1) (lambda () (subst `(= (* ,ny ,nb) 1)) (dk-ineq! '(IN 1 RR))))
    (dk-cite! 'cd8-scale-bound 'K 'n 'n yv p nb 1)
    ;; commutation
    (dk-cite! 'identmat-type cf4-v 'n)
    (cf4-to-k! `(IDENTMAT ,cf4-v n) 'n 'n)
    (dk-have! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))) (lambda () (di) (prop)))
    (cf4-to-v! 'X 'n 'n)
    (dk-have! (cf4-comm sy)
