              (pbc)
              (dk-chain-ass! (dk-cite! 'rr-not-lt-ge nz t))
              (a6l-anti! t nz)
              (dk-absurd! h3 `(<= ,(a6l-rp nz) ,(a6l-rp t)) `(<= ,(a6l-rp t) ,rho) `(IN ,rho RR) `(IN ,(a6l-rp t) RR) `(IN ,(a6l-rp nz) RR)))))
        (dk-chain-ass! (dk-cite! 'rpow-star-least-exponent r rho z))
        (let* ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'a6tt))) "the least exponent") #t)))
          (dk-split-all!)
            (let ((minl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n) (dk-contains? h 'a6tt))) "the minimality")))
              (dk-cite! 'zz-in-rr n)
              (a6l-rr! n)
              (ew n)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-asm? g) (dk-ass!))
                      ;; rho < r^m for m < n
                      ((dk-contains? g 'a6mm)
                       (let* ((landed (dk-landed (lambda () (dk-peel!))))
                              (m (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ZZ))) landed))))
                         (dk-cite! 'zz-in-rr m)
                         (a6l-rr! m)
                         (use-em `(<= ,(a6l-rp m) ,rho)
                           (lambda ()
                             (dk-have-and! `(IN ,m ZZ) `(<= ,(a6l-rp m) ,rho))
                             (dk-apply! minl m)
                             (dk-absurd! `(<= ,n ,m) `(< ,m ,n) `(IN ,n RR) `(IN ,m RR)))
                           (lambda ()
                             (dk-chain-ass! (dk-cite! 'rr-not-le-lt (a6l-rp m) rho))
                             (dk-close-if-asm!)))))
                      ;; the ball
                      (#t
                       (let* ((landed (dk-landed (lambda () (dk-peel!))))
                              (f (cadr (car landed)))
                              (abs `(LAURENT-ABS kq_ rq_ ,f))
                              (e1 (dk-cite! 'laurent-abs-le-iff 'kq_ r f n)))
                         (dk-chain-ass! (dk-cite! 'laurent-abs-in-rr 'kq_ r f))
                         (dk-split-all!)
                         (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
                           (lambda ()
                             (dk-have! `(<= ,abs ,(a6l-rp n))
                               (lambda ()
                                 (use-em `(= ,f (LAURENT-ZERO kq_))
                                   (lambda ()
                                     (subst `(= ,f (LAURENT-ZERO kq_)))
                                     (subst (dk-cite! 'laurent-abs-zero 'kq_ r))
                                     (dk-ineq! `(< 0 ,(a6l-rp n)) `(IN ,(a6l-rp n) RR)))
                                   (lambda ()
                                     (dk-chain-ass! (dk-cite! 'laurent-abs-nonzero 'kq_ r f))
                                     (dk-split-all!)
                                     (dk-chain-ass! (dk-cite! 'laurent-nonzero-ord 'kq_ f))
                                     (let* ((o (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h f) (dk-contains? h 'ZERO))) "the order") #t)))
                                       (dk-split-all!)
                                       (dk-chain-ass! (dk-cite! 'laurent-ord-eq 'kq_ f o))
                                       (let* ((ha (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) abs))) "|f| = r^ord"))
                                              (hb (dk-rewrite-h! ha `(LAURENT-ORD kq_ ,f) o))
                                              (hc (dk-pick (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) abs))) "|f| <= rho"))
                                              (hd (dk-rewrite-h! hc abs (a6l-rp o))))
                                         (dk-have-and! `(IN ,o ZZ) `(<= ,(a6l-rp o) ,rho))
                                         (dk-apply! minl o)
                                         (dk-cite! 'zz-in-rr o)
                                         (a6l-anti! n o)
                                         (subst `(= ,abs ,(a6l-rp o)))
                                         (dk-close-if-asm!)))))))
                             (dk-iff-fwd! e1)
                             (dk-close-if-asm!))
                           (lambda ()
                             (dk-iff-bwd! e1)
                             (dk-ineq! `(<= ,abs ,(a6l-rp n)) `(<= ,(a6l-rp n) ,rho) `(IN ,abs RR) `(IN ,(a6l-rp n) RR) `(IN ,rho RR))))))))))))))))
(qed 'laurent-ball-order)

;;; ---------------------------------------------------------------------------
;;; RESTRICTION TO AN INDEX SET S SUBSET ZZ AND EXTENSION BY ZERO (the coordinates of Remarks 6.8 and 6.9)
(define (a6p-res f) `(VNB-LAMBDA a6i a6s (,f a6i)))
(define (a6p-ext h) `(VNB-LAMBDA a6i ZZ (IF (IN a6i a6s) (,h a6i) (ZERO kq_))))
(define (a6p-off f) `(FORALL a6j (IMPLIES (IN a6j ZZ) (IMPLIES (NOT (IN a6j a6s)) (= (,f a6j) (ZERO kq_))))))
(define (a6p-pre body) `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL a6s (IMPLIES (SUBSET a6s ZZ) ,body)))))
(define (a6p-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(define a6p-fz '(FUN ZZ (CARR kq_)))
(define a6p-fs '(FUN a6s (CARR kq_)))
(define (a6p-setup!)
  (dk-cite! 'ring-zero-in 'kq_)
  (fact 'zz-is-set)
  (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set 'a6s 'ZZ)))
(define (a6p-zz! x) (if (not (dk-asm? `(IN ,x ZZ))) (dk-chain-ass! (dk-cite! 'subset-mem-fwd 'a6s 'ZZ x))))
(define (a6p-app! f dom x) (dk-chain-ass! (dk-cite! 'fun-apply-type-c f dom '(CARR kq_) x)))

(sp (make-wff (a6p-pre `(FORALL fq_ (IMPLIES (IN fq_ ,a6p-fz) (IN ,(a6p-res 'fq_) ,a6p-fs))))))
(dk-peel!)
(a6p-setup!)
(dk-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
          (a6p-zz! x) (a6p-app! 'fq_ 'ZZ x)
          (dk-close-if-asm!))
        (dk-close-if-asm!))))
(qed 'zz-restrict-type)

(sp (make-wff (a6p-pre `(FORALL fq_ (IMPLIES (IN fq_ ,a6p-fz) (FORALL gq_ (IMPLIES (IN gq_ ,a6p-fz)
  (IMPLIES ,(a6p-off 'fq_) (IMPLIES ,(a6p-off 'gq_) (IMPLIES (= ,(a6p-res 'fq_) ,(a6p-res 'gq_)) (= fq_ gq_)))))))))))
(dk-peel!)
(a6p-setup!)
(let ((offf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(fq_ a6j)))) "f off S"))
      (offg (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(gq_ a6j)))) "g off S"))
      (rf (a6p-res 'fq_)) (rg (a6p-res 'gq_)))
  (dk-fun-ext! 'fq_ 'gq_ 'ZZ '(CARR kq_) #f #f
    (lambda (v)
      (a6p-app! 'fq_ 'ZZ v) (a6p-app! 'gq_ 'ZZ v)
      (use-em `(IN ,v a6s)
        (lambda ()
          (dk-have! `(= (,rf ,v) (fq_ ,v)) (lambda () (dk-lam-b!) (a6p-rfl!)))
          (dk-have! `(= (,rg ,v) (gq_ ,v)) (lambda () (dk-lam-b!) (a6p-rfl!)))
          (subst `(= (fq_ ,v) (,rf ,v)))
          (subst `(= ,rf ,rg))
          (subst `(= (,rg ,v) (gq_ ,v)))
          (rfl))
        (lambda ()
          (dk-apply! offf v) (dk-apply! offg v)
          (subst `(= (fq_ ,v) (ZERO kq_)))
          (subst `(= (gq_ ,v) (ZERO kq_)))
          (rfl))))))
(qed 'zz-restrict-injective)

(sp (make-wff (a6p-pre `(FORALL a6h (IMPLIES (IN a6h ,a6p-fs)
  (AND (IN ,(a6p-ext 'a6h) ,a6p-fz) (AND ,(a6p-off (a6p-ext 'a6h)) (= ,(a6p-res (a6p-ext 'a6h)) a6h))))))))
(dk-peel!)
(a6p-setup!)
(let* ((e (a6p-ext 'a6h)) (re (a6p-res e)))
  (define (ift x) `(IF (IN ,x a6s) (a6h ,x) (ZERO kq_)))
  (dk-have! `(IN ,e ,a6p-fz)
    (lambda ()
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                (dk-case-if! (ift x)
                  (lambda (tv val)
                    (if tv (a6p-app! 'a6h 'a6s x))
                    (dk-close-if-asm!))))
              (dk-close-if-asm!))))))
  (dk-cite! 'zz-restrict-type 'kq_ 'a6s e)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'FORALL)
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'ZZ))) landed))))
             (dk-lam-b!)
             (dk-if-branch! #f (ift x) #f (lambda () (a6p-rfl!)))))
          (#t
           (dk-fun-ext! re 'a6h 'a6s '(CARR kq_) #f #f
             (lambda (v)
               (a6p-zz! v) (a6p-app! 'a6h 'a6s v)
               (dk-lam-b!)
               (dk-if-branch! #t (ift v) #f (lambda () (a6p-rfl!)))))))))))
(qed 'zz-extend-by-zero)

;;; ---------------------------------------------------------------------------
;;; REMARK 6.8, second half: B(rho) = {f : f vanishes below n} is isomorphic to prod_{k >= n} F_q, by
;;; f |-> (a_k(f))_{k >= n}: the restriction is a bijection onto FUN({k >= n}, F_q), additive coordinatewise.
(define (a6b-sn n) `(SEP a6k ZZ (<= ,n a6k)))
(define (a6b-res f d) `(VNB-LAMBDA a6i ,d (,f a6i)))
(define (a6b-ext h d) `(VNB-LAMBDA a6i ZZ (IF (IN a6i ,d) (,h a6i) (ZERO kq_))))
(define (a6b-off f d) `(FORALL a6j (IMPLIES (IN a6j ZZ) (IMPLIES (NOT (IN a6j ,d)) (= (,f a6j) (ZERO kq_))))))
(define a6b-ls '(LAURENT-SET kq_))
(define (a6b-lfun! f)
  (if (not (dk-asm? `(IN ,f (FUN ZZ (CARR kq_)))))
      (begin (dk-chain-ass! (dk-cite! 'laurent-set-out 'kq_ f))
             (dk-split! (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (equal? (cadr h) `(IN ,f (FUN ZZ (CARR kq_)))))) "laurent-set-out")))))
;; D = {k in ZZ : P(k)} is a subset of ZZ
(define (a6b-sub! d)
  (if (not (dk-asm? `(SUBSET ,d ZZ)))
      (dk-have! `(SUBSET ,d ZZ)
        (lambda ()
          (mac 'subset-def)
          (let* ((landed (dk-landed (lambda () (dk-peel!)))) (y (cadr (car landed))))
            (dk-sep-parts! `(IN ,y ,d)) (dk-close-if-asm!))))))
;; below(f, n) => f vanishes off S_n, and back
(define (a6b-off-of-below! f n)
  (let ((d (a6b-sn n)) (bl (a6l-below f n)))
    (dk-have! (a6b-off f d)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ZZ))) landed))))
          (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr n)
          (dk-have! `(< ,j ,n)
            (lambda ()
              (pbc)
              (dk-chain-ass! (dk-cite! 'rr-not-lt-ge j n))
              (dk-have! `(IN ,j ,d) (lambda () (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))
              (ai `(NOT (IN ,j ,d)))))
          (dk-apply! bl j)
          (dk-close-if-asm!))))))
(define (a6b-below-of-off! f n)
  (let ((d (a6b-sn n)) (off (a6b-off f (a6b-sn n))))
    (dk-have! (a6l-below f n)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ZZ))) landed))))
          (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr n)
          (dk-have! `(NOT (IN ,j ,d))
            (lambda () (di) (dk-sep-parts! `(IN ,j ,d)) (dk-absurd! `(<= ,n ,j) `(< ,j ,n) `(IN ,j RR) `(IN ,n RR))))
          (dk-apply! off j)
          (dk-close-if-asm!))))))

(define a6b-d (a6b-sn 'a6n))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL a6n (IMPLIES (IN a6n ZZ)
  (AND (FORALL fq_ (IMPLIES (IN fq_ ,a6b-ls) (IMPLIES ,(a6l-below 'fq_ 'a6n) (IN ,(a6b-res 'fq_ a6b-d) (FUN ,a6b-d (CARR kq_))))))
       (FORALL a6h (IMPLIES (IN a6h (FUN ,a6b-d (CARR kq_)))
         (FORSOME fq_ (AND (IN fq_ ,a6b-ls) (AND ,(a6l-below 'fq_ 'a6n) (AND (= ,(a6b-res 'fq_ a6b-d) a6h)
           (FORALL gq_ (IMPLIES (IN gq_ ,a6b-ls) (IMPLIES ,(a6l-below 'gq_ 'a6n)
             (IMPLIES (= ,(a6b-res 'gq_ a6b-d) a6h) (= gq_ fq_))))))))))))))))))
(dk-peel!)
(a6b-sub! a6b-d)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
        (if (dk-contains? (dk-goal) 'a6h)
            ;; onto, uniquely
            (let* ((landed (dk-landed (lambda () (di))))
                   (e (a6b-ext 'a6h a6b-d)))
              (dk-chain-ass! (dk-cite! 'zz-extend-by-zero 'kq_ a6b-d 'a6h))
              (dk-split-all!)
              (a6b-below-of-off! e 'a6n)
              (dk-chain-ass! (dk-cite! 'laurent-set-in 'kq_ e 'a6n))
              (ew e)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!)
                      (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                             (g (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) a6b-ls))) landed2))))
                        (a6b-lfun! g)
                        (a6b-off-of-below! g 'a6n)
                        (dk-have! `(= ,(a6b-res g a6b-d) ,(a6b-res e a6b-d))
                          (lambda () (subst `(= ,(a6b-res g a6b-d) a6h)) (subst `(= ,(a6b-res e a6b-d) a6h)) (rfl)))
                        (dk-chain-ass! (dk-cite! 'zz-restrict-injective 'kq_ a6b-d g e))
                        (dk-close-if-asm!))))))
            ;; the coordinates of a point of B lie in the product
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) a6b-ls))) landed))))
              (a6b-lfun! f)
              (dk-chain-ass! (dk-cite! 'zz-restrict-type 'kq_ a6b-d f))
              (dk-close-if-asm!))))))
(qed 'laurent-ball-product)

;;; the bijection is additive: (f + g)_k = f_k + g_k on the coordinates k >= n
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL a6n (IMPLIES (IN a6n ZZ)
  (FORALL fq_ (IMPLIES (IN fq_ ,a6b-ls) (FORALL gq_ (IMPLIES (IN gq_ ,a6b-ls) (FORALL a6x (IMPLIES (IN a6x ,a6b-d)
    (= (,(a6b-res '(LAURENT-ADD kq_ fq_ gq_) a6b-d) a6x) ((ADD kq_) (,(a6b-res 'fq_ a6b-d) a6x) (,(a6b-res 'gq_ a6b-d) a6x)))))))))))))))
(dk-peel!)
(dk-sep-parts! `(IN a6x ,a6b-d))
(dk-cite! 'lp-coeff-in 'kq_ 'fq_ 'a6x)
(dk-cite! 'lp-coeff-in 'kq_ 'gq_ 'a6x)
(dk-lam-b!)
(subst (dk-cite! 'laurent-add-apply 'kq_ 'fq_ 'gq_ 'a6x))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(qed 'laurent-ball-product-add)

;;; ---------------------------------------------------------------------------
;;; REMARKS 6.9, second half: F_q((x)) / Z(F_q((x))) is the direct sum of copies of F_q, one for each negative
;;; index: the polar part f |-> (a_k(f))_{k < 0} is additive, maps onto the finitely supported families, and its
;;; kernel is Z(F_q((x))).
(define a6q-d '(SEP a6k ZZ (< a6k 0)))
(define (a6q-fin h) `(FORSOME a6bb (AND (IN a6bb ZZ) (FORALL a6x (IMPLIES (IN a6x ,a6q-d) (IMPLIES (< a6x a6bb) (= (,h a6x) (ZERO kq_))))))))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
  (AND (FORALL fq_ (IMPLIES (IN fq_ ,a6b-ls) (AND (IN ,(a6b-res 'fq_ a6q-d) (FUN ,a6q-d (CARR kq_))) ,(a6q-fin (a6b-res 'fq_ a6q-d)))))
       (FORALL a6h (IMPLIES (IN a6h (FUN ,a6q-d (CARR kq_))) (IMPLIES ,(a6q-fin 'a6h)
         (FORSOME fq_ (AND (IN fq_ ,a6b-ls) (= ,(a6b-res 'fq_ a6q-d) a6h)))))))))))
(dk-peel!)
(a6b-sub! a6q-d)
(dk-cite! 'ring-zero-in 'kq_)
(fact 'zz-zero-in)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
        (if (dk-contains? (dk-goal) 'a6h)
            ;; onto the finitely supported families
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'a6h))) "the support bound") #t))
                   (e (a6b-ext 'a6h a6q-d)))
              (dk-split-all!)
              (let ((sup (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b) (dk-contains? h 'a6h))) "the support")))
                (dk-chain-ass! (dk-cite! 'zz-extend-by-zero 'kq_ a6q-d 'a6h))
                (dk-split-all!)
                (let ((off (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a6j) (dk-contains? h e))) "e off D")))
                  (dk-have! (a6l-below e b)
                    (lambda ()
                      (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                             (j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ZZ))) landed2))))
                        (use-em `(IN ,j ,a6q-d)
                          (lambda ()
                            (dk-chain-ass! (dk-cite! 'fun-apply-type-c 'a6h a6q-d '(CARR kq_) j))
                            (dk-lam-b!)
                            (dk-if-branch! #t `(IF (IN ,j ,a6q-d) (a6h ,j) (ZERO kq_)) #f
                              (lambda () (dk-apply! sup j) (dk-close-if-asm!))))
                          (lambda () (dk-apply! off j) (dk-close-if-asm!))))))
                  (dk-chain-ass! (dk-cite! 'laurent-set-in 'kq_ e b))
                  (ew e)
                  (dk-conj-close! (lambda () (dk-ass!))))))
            ;; the polar part of a Laurent series is a finitely supported family
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) a6b-ls))) landed)))
                   (rf (a6b-res f a6q-d)))
              (dk-chain-ass! (dk-cite! 'laurent-set-out 'kq_ f))
              (dk-split-all!)
              (let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h f))) "the bound") #t)))
                (dk-split-all!)
                (dk-chain-ass! (dk-cite! 'zz-restrict-type 'kq_ a6q-d f))
                (let ((bd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b) (dk-contains? h f))) "the bound")))
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (dk-ass!)
                          (begin
                            (ew b)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (dk-ass!)
                                    (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                                           (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) a6q-d))) landed2))))
                                      (dk-sep-parts! `(IN ,x ,a6q-d))
                                      (dk-cite! 'lp-coeff-in 'kq_ f x)
                                      (dk-lam-b!)
                                      (dk-apply! bd x)
                                      (dk-close-if-asm!))))))))))))))))
(qed 'laurent-polar-part-onto)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
  (FORALL fq_ (IMPLIES (IN fq_ ,a6b-ls)
    (IFF (IN fq_ (NV-INTEGERS (LAURENT-NF kq_ rq_)))
         (FORALL a6x (IMPLIES (IN a6x ,a6q-d) (= (,(a6b-res 'fq_ a6q-d) a6x) (ZERO kq_)))))))))))))))
(dk-peel!)
(fact 'zz-zero-in)
(let* ((rf (a6b-res 'fq_ a6q-d))
       (e2 (dk-cite! 'laurent-integers-iff 'kq_ 'rq_ 'fq_)))
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    (lambda ()
      (dk-iff-fwd! e2)
      (let ((bl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'lzj) (dk-contains? h 'fq_))) "below 0")))
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) a6q-d))) landed))))
          (dk-sep-parts! `(IN ,x ,a6q-d))
          (dk-cite! 'lp-coeff-in 'kq_ 'fq_ x)
          (dk-lam-b!)
          (dk-apply! bl x)
          (dk-close-if-asm!))))
    (lambda ()
      (let ((pp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a6x))) "the polar part vanishes")))
        (dk-have! (a6l-below 'fq_ 0)
          (lambda ()
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ZZ))) landed))))
              (dk-have! `(IN ,j ,a6q-d) (lambda () (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))
              (dk-cite! 'lp-coeff-in 'kq_ 'fq_ j)
              (dk-apply! pp j)
              (dk-have! `(= (,rf ,j) (fq_ ,j)) (lambda () (dk-lam-b!) (a6p-rfl!)))
              (subst `(= (fq_ ,j) (,rf ,j)))
              (dk-close-if-asm!))))
        (dk-have-and! `(IN fq_ ,a6b-ls) (a6l-below 'fq_ 0))
        (dk-iff-bwd! e2)
        (dk-close-if-asm!)))))
(qed 'laurent-polar-part-kernel)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
  (FORALL fq_ (IMPLIES (IN fq_ ,a6b-ls) (FORALL gq_ (IMPLIES (IN gq_ ,a6b-ls) (FORALL a6x (IMPLIES (IN a6x ,a6q-d)
    (= (,(a6b-res '(LAURENT-ADD kq_ fq_ gq_) a6q-d) a6x) ((ADD kq_) (,(a6b-res 'fq_ a6q-d) a6x) (,(a6b-res 'gq_ a6q-d) a6x)))))))))))))
(dk-peel!)
(dk-sep-parts! `(IN a6x ,a6q-d))
(dk-cite! 'lp-coeff-in 'kq_ 'fq_ 'a6x)
(dk-cite! 'lp-coeff-in 'kq_ 'gq_ 'a6x)
(dk-lam-b!)
(subst (dk-cite! 'laurent-add-apply 'kq_ 'fq_ 'gq_ 'a6x))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(qed 'laurent-polar-part-add)
