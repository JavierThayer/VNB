;;; ccr4g-residue.scm -- THE LEADING TERM OF A POLYNOMIAL VALUE, and THE RESIDUE OF F(w) MEET A IS F
;;; (CCR 4.24, REL-FREE half; brief CCR-1111C target 2).  Agent CCR-1111C, 2026-11-11.
;;; Destination: theorem-library/ccr4g-residue.scm.  Library: analysis.  Helper prefix cg2-.
;;;
;;;   rr-power-strict      0 < x < 1, s < N  =>  x^N < x^s.
;;;   nv-sum-leading       K an NV field, F a class of elements of K of absolute value <= 1, 0 < |w| < 1,
;;;                        a(k) in F, g(k) == a(k) w^k:  every partial sum S_N = sum_{k<N} g(k) is 0 or has a
;;;                        LEADING TERM: c w^s with c in F, c /= 0, s < N and |S_N - c w^s| < |w|^s.
;;;   nv-rat-at-residue    the same F a subfield of K:  every y in NF-RAT-AT(K, F, w) = F(w) with |y| <= 1 is
;;;                        congruent to an element of F:  |y - c| < 1 for some c in F.  The leading-coefficient
;;;                        argument of CCR-1111B's route, step 5.
;;;
;;; Load window: after ccr4g-coords (nf-ring-additive-ag-view), structure-library/ccr4f-vocab (NF-RAT-AT,
;;; NF-POLY-OVER), poly-degree / gal-poly (poly-eval-bound, deg-well-defined), ccr2 (nv-ultra, nv-pow-norm-power).

(define cg2-V '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define cg2-ag '(NORMED-FIELD-ADDITIVE-AG K))
(define (cg2-n x) `((FNRM K) ,x))
(define (cg2-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define (cg2-mul x y) `((MUL K) ,x ,y))
(define (cg2-rp s) `(RING-POWER ,cg2-V w ,s))
(define (cg2-rfl-or-ass!) (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (cg2-or! f thunk) (if (not (dk-asm? f)) (thunk)) f)
(define (cg2-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cg2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 10 (length a))))))
                  (dk-open-leaves))))
  (qed name))
(define (cg2-and! a b) (cg2-or! `(AND ,a ,b) (lambda () (dk-have! `(AND ,a ,b) (lambda () (dk-conj-close! dk-ass!))))))
(define (cg2-rr! x) (cg2-or! `(IN ,x RR) (lambda () (dk-type! x 'RR))))

;;; ---------------------------------------------------------------------------
;;; rr-power-strict

(sp (make-wff '(FORALL cgx (IMPLIES (IN cgx RR) (IMPLIES (< 0 cgx) (IMPLIES (< cgx 1)
  (FORALL cgs (IMPLIES (IN cgs NN) (FORALL cgN (IMPLIES (IN cgN NN) (IMPLIES (< cgs cgN)
    (< (power cgx cgN) (power cgx cgs)))))))))))))
(dk-peel!)
(dk-cite! 'nn-succ-closed 'cgs)
(dk-cite! 'nn-lt-succ-le 'cgs 'cgN)
(define cg2-d (dk-skolem! (dk-chain-ass! (dk-cite! 'nn-le-gap 'cgN '(succ cgs))) #t))
(dk-cite! 'rr-subset-cc 'cgx)
(cg2-and! '(IN cgx CC) '(IN cgs NN))
(define cg2-ps (dk-cite! 'power-succ 'cgx 'cgs))
(dk-cite! 'cc-power-add cg2-d '(succ cgs) 'cgx)
(dk-cite! 'power-closed-at 'cgs 'cgx)
(dk-cite! 'power-closed-at cg2-d 'cgx)
(dk-cite! 'power-closed-at 'cgN 'cgx)
(dk-cite! 'power-closed-at '(succ cgs) 'cgx)
(dk-have! '(<= 0 cgx) (lambda () (dk-ineq! '(< 0 cgx))))
(dk-have! '(<= cgx 1) (lambda () (dk-ineq! '(< cgx 1))))
(cg2-and! '(<= 0 cgx) '(<= cgx 1))
(dk-cite! 'rr-power-le-one cg2-d 'cgx)
(dk-cite! 'rr-power-pos 'cgx 'cgs)
(define cg2-y '(power cgx cgs))
(define cg2-z `(power cgx ,cg2-d))
(dk-cite! 'rr-mul-in-rr 'cgx cg2-y)
(define cg2-xy `(* cgx ,cg2-y))
(dk-cite! 'rr-mul-pos 'cgx cg2-y)
(dk-have! `(<= 0 ,cg2-xy) (lambda () (dk-ineq! `(< 0 ,cg2-xy))))
(fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right cg2-z 1 cg2-xy)
(dk-cite! 'rr-mul-in-rr cg2-z cg2-xy)
(dk-cite! 'rr-mul-in-rr 1 cg2-xy)
(dk-cite! 'rr-mul-in-rr 1 cg2-y)
(define cg2-lt-iff (dk-cite! 'rr-mul-lt-cancel-iff 'cgx 1 cg2-y))
(dk-have! `(< (* cgx ,cg2-y) (* 1 ,cg2-y))
  (lambda () (dk-close-if! (lambda () (dk-only! cg2-lt-iff '(< cgx 1))) prop)))
(dk-have! `(= (power cgx cgN) (* ,cg2-z ,cg2-xy))
  (lambda ()
    (subst `(= cgN (+ (succ cgs) ,cg2-d)))
    (subst `(= (power cgx (+ (succ cgs) ,cg2-d)) (* (power cgx (succ cgs)) ,cg2-z)))
    (subst cg2-ps)
    (crs)))
(dk-have! `(= (* 1 ,cg2-xy) ,cg2-xy) (lambda () (crs)))
(dk-have! `(= (* 1 ,cg2-y) ,cg2-y) (lambda () (crs)))
(dk-ineq! `(= (power cgx cgN) (* ,cg2-z ,cg2-xy)) `(<= (* ,cg2-z ,cg2-xy) (* 1 ,cg2-xy)) `(= (* 1 ,cg2-xy) ,cg2-xy)
          `(< (* cgx ,cg2-y) (* 1 ,cg2-y)) `(= (* 1 ,cg2-y) ,cg2-y))
(cg2-qed! 'rr-power-strict)

;;; ---------------------------------------------------------------------------
;;; nv-sum-leading

(define (cg2-S n) `(SUM-AG ,cg2-ag g ,n))
(define (cg2-lead x n)
  `(FORSOME cgs_ (AND (IN cgs_ NN) (FORSOME cgc_ (AND (IN cgc_ F) (AND (NOT (= cgc_ (ZERO K)))
     (AND (< cgs_ ,n) (< ,(cg2-n (cg2-sub x (cg2-mul 'cgc_ (cg2-rp 'cgs_)))) (power ,(cg2-n 'w) cgs_)))))))))
(define (cg2-disj n) `(OR (= ,(cg2-S n) (ZERO K)) ,(cg2-lead (cg2-S n) n)))
(define cg2-hyps
  (list '(FORALL x (IMPLIES (IN x F) (IN x (CARR K))))
        `(FORALL x (IMPLIES (IN x F) (<= ,(cg2-n 'x) 1)))
        '(IN w (CARR K))
        `(< 0 ,(cg2-n 'w))
        `(< ,(cg2-n 'w) 1)
        '(FORALL cgj_ (IMPLIES (IN cgj_ NN) (IN (a cgj_) F)))
        `(FORALL cgj_ (IMPLIES (IN cgj_ NN) (== (g cgj_) ,(cg2-mul '(a cgj_) (cg2-rp 'cgj_)))))))
(define (cg2-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))
(define (cg2-h i) (or (dk-ctx-form (list-ref cg2-hyps i)) (error "cg2: hypothesis not in context" i)))
(define (cg2-view!)
  (cg2-or! `(IS-COMMUTATIVE-RING ,cg2-V)
    (lambda ()
      (dk-cite! 'nv-field-normed 'K)
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
      (dk-cite! 'commutative-ring-is-ring cg2-V)
      (for-each (lambda (r) (dk-cite! r 'K))
                '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                  normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
      (dk-cite! 'normed-field-additive-ag-is-abelian-group 'K)
      (for-each (lambda (sl)
                  (let ((eq `(== (,(car sl) ,cg2-ag) ,(cadr sl))))
                    (if (not (dk-asm? eq))
                        (dk-have! eq (lambda () (mac 'normed-field-additive-ag) (slot (car sl)) (nth-r)
                                                (if (eq? (car sl) 'CARR) (slot 'CARR)) (qrfl))))))
                '((OPR (ADD K)) (IDEN (ZERO K)) (CARR (CARR K)))))))
(define (cg2-inV! x) (cg2-or! `(IN ,x (CARR ,cg2-V)) (lambda () (dk-have! `(IN ,x (CARR ,cg2-V)) (lambda () (subst `(= (CARR ,cg2-V) (CARR K))) (dk-ass!))))))
(define (cg2-inK! x) (cg2-or! `(IN ,x (CARR K)) (lambda () (dk-have! `(IN ,x (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cg2-V))) (dk-ass!))))))
(define (cg2-crs!)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cg2-V))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cg2-V))))) '(ZERO ONE))
  (crs))
(define (cg2-req! eq vs) (cg2-or! eq (lambda () (dk-have! eq (lambda () (for-each cg2-inV! vs) (cg2-crs!))))))
;; w^k typed in K, its norm |w|^k
(define (cg2-rp! kv)
  (cg2-view!)
  (cg2-inV! 'w)
  (cg2-or! `(IN ,(cg2-rp kv) (CARR ,cg2-V)) (lambda () (dk-cite! 'ring-power-type cg2-V 'w kv)))
  (cg2-inK! (cg2-rp kv))
  (cg2-or! `(= ,(cg2-n (cg2-rp kv)) (power ,(cg2-n 'w) ,kv)) (lambda () (dk-cite! 'nv-pow-norm-power 'K 'w kv))))
;; a(k), g(k) typed (k in NN); returns the equation g(k) == a(k) w^k
(define (cg2-g! kv)
  (cg2-rp! kv)
  (dk-apply! (cg2-h 5) kv)
  (dk-apply! (cg2-h 0) `(a ,kv))
  (dk-cite! 'nf-mul-in-carr 'K `(a ,kv) (cg2-rp kv))
  (let ((eq (dk-apply! (cg2-h 6) kv)))
    (cg2-or! `(IN (g ,kv) (CARR K)) (lambda () (dk-have! `(IN (g ,kv) (CARR K)) (lambda () (subst eq) (dk-ass!)))))
    eq))
;; S_n typed in K
(define (cg2-S! n)
  (cg2-or! `(IN ,(cg2-S n) (CARR K))
    (lambda ()
      (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,n)) (IN (g cgz_) (CARR ,cg2-ag))))
        (lambda ()
          (let ((z (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
            (dk-cite! 'ord-segment-nn-subset n z)
            (cg2-g! z)
            (subst `(== (CARR ,cg2-ag) (CARR K)))
            (dk-ass!))))
      (dk-cite! 'sum-ag-type-ptwise n cg2-ag 'g)
      (dk-have! `(IN ,(cg2-S n) (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cg2-ag))) (dk-ass!))))))
(define (cg2-norm! x) (dk-cite! 'nf-norm-in-rr 'K x) (dk-cite! 'nf-norm-nonneg 'K x))
;; close a goal (FORSOME cgs_ ...) by the witnesses s, c, every conjunct already in context
(define (cg2-witness! s c)
  (ew s)
  (dk-conj-close! (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORSOME)
                        (begin (ew c) (dk-conj-close! dk-ass!))
                        (dk-ass!)))))

(sp (make-wff `(FORALL N (IMPLIES (IN N NN) (FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL F (FORALL w (FORALL a (FORALL g
  ,(cg2-curry cg2-hyps (cg2-disj 'N))))))))))))
(let* ((br (dk-use-induction-fixed! '(K F w a g))) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  ;; base: S_0 = 0
  (dk-focus! base)
  (if (not (dk-head-is? (dk-goal) 'OR)) (dk-peel!))
  (cg2-view!)
  (oi-l)
  (subst (dk-cite! 'sum-ag-zero cg2-ag 'g))
  (subst `(== (IDEN ,cg2-ag) (ZERO K)))
  (cg2-rfl-or-ass!)
  ;; step
  (dk-focus! step)
  (if (not (dk-head-is? (dk-goal) 'OR)) (dk-peel!))
  (cg2-view!)
  (dk-cite! 'nf-zero-in-carr 'K)
  (dk-cite! 'nn-succ-closed v)
  (let* ((sv (cg2-S v)) (t (cg2-S `(succ ,v))) (av `(a ,v)) (y (cg2-mul av (cg2-rp v)))
         (geq (cg2-g! v)))
    (cg2-S! v)
    (cg2-S! `(succ ,v))
    (dk-have! `(= ,t ((ADD K) ,sv ,y))
      (lambda () (subst (dk-cite! 'sum-ag-succ cg2-ag 'g v)) (subst `(== (OPR ,cg2-ag) (ADD K))) (subst geq) (cg2-rfl-or-ass!)))
    (cg2-norm! 'w)
    (cg2-rp! v)
    (cg2-norm! (cg2-rp v))
    (dk-cite! 'power-closed-at v (cg2-n 'w))
    (dk-cite! 'rr-power-pos (cg2-n 'w) v)
    (let ((cases (dk-opened (lambda () (ai ih)))))
      (for-each
       (lambda (leaf)
         (if (not (sequent-node-grounded? leaf))
         (begin
         (dk-focus! leaf)
         (if (dk-asm? `(= ,sv (ZERO K)))
             ;; case A: S_v = 0, T = a_v w^v
             (use-em `(= ,av (ZERO K))
               (lambda ()
                 (oi-l)
                 (subst `(= ,t ((ADD K) ,sv ,y)))
                 (subst `(= ,sv (ZERO K)))
                 (subst `(= ,av (ZERO K)))
                 (cg2-inV! (cg2-rp v))
                 (cg2-crs!))
               (lambda ()
                 (oi-r)
                 (dk-apply! (cg2-h 5) v)
                 (dk-apply! (cg2-h 0) av)
                 (dk-cite! 'nf-mul-in-carr 'K av (cg2-rp v))
                 (let ((dif (cg2-sub t (cg2-mul av (cg2-rp v)))))
                   (dk-have! `(= ,dif (ZERO K))
                     (lambda ()
                       (subst `(= ,t ((ADD K) ,sv ,y)))
                       (subst `(= ,sv (ZERO K)))
                       (for-each cg2-inV! (list av (cg2-rp v)))
                       (cg2-crs!)))
                   (dk-have! `(< ,(cg2-n dif) (power ,(cg2-n 'w) ,v))
                     (lambda ()
                       (subst `(= ,dif (ZERO K)))
                       (subst (dk-cite! 'nf-norm-of-zero 'K))
                       (dk-ass!))))
                 (dk-have! `(< ,v (succ ,v)) (lambda () (dk-nn!)))
                 (cg2-witness! v av)))
             ;; case B: a leading term c w^s of S_v, s < v
             (let* ((ex1 (dk-pick (lambda (q) (dk-head-is? q 'FORSOME)) "the leading term"))
                    (s (dk-skolem! ex1 #t))
                    (ex2 (dk-pick (lambda (q) (dk-head-is? q 'FORSOME)) "the leading coefficient"))
                    (c (dk-skolem! ex2 #t)))
               (dk-split-all!)
               (oi-r)
               (let* ((cz (cg2-mul c (cg2-rp s)))
                      (xx (cg2-sub sv cz))
                      (dif (cg2-sub t cz))
                      (ws `(power ,(cg2-n 'w) ,s)) (wv `(power ,(cg2-n 'w) ,v)))
                 (dk-apply! (cg2-h 0) c)
                 (cg2-rp! s)
                 (dk-cite! 'nf-mul-in-carr 'K c (cg2-rp s))
                 (dk-cite! 'nf-neg-in-carr 'K cz)
                 (dk-cite! 'nf-add-in-carr 'K sv `((NEG K) ,cz))
                 (dk-apply! (cg2-h 5) v)
                 (dk-apply! (cg2-h 0) av)
                 (dk-cite! 'nf-mul-in-carr 'K av (cg2-rp v))
                 (dk-have! `(= ,dif ((ADD K) ,xx ,y))
                   (lambda () (subst `(= ,t ((ADD K) ,sv ,y)))
                              (for-each cg2-inV! (list sv c (cg2-rp s) av (cg2-rp v)))
                              (cg2-crs!)))
                 (dk-cite! 'nv-ultra 'K xx y)
                 (cg2-norm! xx) (cg2-norm! y) (cg2-norm! av)
                 (dk-cite! 'power-closed-at s (cg2-n 'w))
                 ;; |y| = |a_v| |w|^v <= |w|^v < |w|^s
                 (dk-cite! 'nf-norm-mult 'K av (cg2-rp v))
                 (dk-apply! (cg2-h 1) av)
                 (fact 'rr-one-in)
                 (dk-have! `(<= 0 ,wv) (lambda () (dk-ineq! `(< 0 ,wv))))
                 (dk-cite! 'rr-mul-le-right (cg2-n av) 1 wv)
                 (dk-cite! 'rr-mul-in-rr (cg2-n av) wv)
                 (dk-cite! 'rr-mul-in-rr 1 wv)
                 (dk-have! `(= (* 1 ,wv) ,wv) (lambda () (crs)))
                 (dk-chain-ass! (dk-cite! 'rr-power-strict (cg2-n 'w) s v))
                 (dk-have! `(= ,(cg2-n y) (* ,(cg2-n av) ,wv))
                   (lambda () (subst `(= ,(cg2-n y) (* ,(cg2-n av) ,(cg2-n (cg2-rp v)))))
                              (subst `(= ,(cg2-n (cg2-rp v)) ,wv))
                              (cg2-rfl-or-ass!)))
                 (dk-have! `(< ,(cg2-n y) ,ws)
                   (lambda () (dk-ineq! `(= ,(cg2-n y) (* ,(cg2-n av) ,wv))
                                        `(<= (* ,(cg2-n av) ,wv) (* 1 ,wv)) `(= (* 1 ,wv) ,wv) `(< ,wv ,ws))))
                 (dk-cite! 'rr-max-lt (cg2-n xx) (cg2-n y) ws)
                 (dk-cite! 'rr-max-closed (cg2-n xx) (cg2-n y))
                 (dk-cite! 'nf-add-in-carr 'K xx y)
                 (cg2-norm! `((ADD K) ,xx ,y))
                 (dk-have! `(< ,(cg2-n dif) ,ws)
                   (lambda ()
                     (subst `(= ,dif ((ADD K) ,xx ,y)))
                     (dk-ineq! `(<= ,(cg2-n `((ADD K) ,xx ,y)) (MAX ,(cg2-n xx) ,(cg2-n y)))
                               `(< (MAX ,(cg2-n xx) ,(cg2-n y)) ,ws))))
                 (dk-have! `(< ,s (succ ,v)) (lambda () (dk-nn!)))
                 (cg2-witness! s c)))))))
       cases))))
(cg2-qed! 'nv-sum-leading)

;;; ---------------------------------------------------------------------------
;;; nv-rat-at-residue

(define cg3-conjs '())
(define cg3-invs '())
(define (cg3-and-list f) (if (dk-head-is? f 'AND) (cons (cadr f) (cg3-and-list (caddr f))) (list f)))
(define (cg3-setup!)
  (let* ((iff (dk-cite! 'is-nf-subfield 'K 'F)) (rhs (caddr iff)))
    (set! cg3-conjs (cg3-and-list rhs))
    (if (not (dk-asm? (car cg3-conjs)))
        (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) rhs)) (dk-split-all! (list rhs)))))
  (cg2-view!)
  (dk-cite! 'nf-ring-additive-ag-view 'K))
(define (cg3-c i) (or (dk-ctx-form (list-ref cg3-conjs i)) (error "cg3: subfield conjunct not in context" i)))
(define cg3-bnd `(FORALL x (IMPLIES (IN x F) (<= ,(cg2-n 'x) 1))))
(define (cg3-F->K! x) (cg2-or! `(IN ,x (CARR K)) (lambda () (dk-apply! (cg3-c 0) x))))
(define (cg3-le1! x) (cg2-or! `(<= ,(cg2-n x) 1) (lambda () (dk-apply! (dk-ctx-form cg3-bnd) x))))
;; x in F, x /= 0: |x| = 1 (its inverse lies in F, both have absolute value <= 1)
(define (cg3-norm1! x)
  (cg2-or! `(= ,(cg2-n x) 1)
    (lambda ()
      (cg3-F->K! x) (cg3-le1! x) (cg2-norm! x)
      (let ((z (dk-skolem! (dk-apply! (cg3-c 6) x) #t)))
        (set! cg3-invs (cons (cons x z) cg3-invs))
        (cg3-F->K! z) (cg3-le1! z) (cg2-norm! z)
        (let* ((nx (cg2-n x)) (nz (cg2-n z)) (xz `((MUL K) ,x ,z)))
          (dk-cite! 'nf-norm-mult 'K x z)
          (dk-cite! 'nf-norm-one 'K)
          (dk-have! `(= (* ,nx ,nz) 1)
            (lambda () (subst `(= (* ,nx ,nz) ,(cg2-n xz))) (subst `(= ,xz (ONE K))) (cg2-rfl-or-ass!)))
          (fact 'rr-one-in)
          (dk-cite! 'rr-mul-le-right nz 1 nx)
          (dk-cite! 'rr-mul-in-rr nz nx) (dk-cite! 'rr-mul-in-rr nx nz) (dk-cite! 'rr-mul-in-rr 1 nx)
          (dk-have! `(= (* ,nz ,nx) (* ,nx ,nz)) (lambda () (crs)))
          (dk-have! `(= (* 1 ,nx) ,nx) (lambda () (crs)))
          (dk-have! `(<= 1 ,nx) (lambda () (dk-ineq! `(<= (* ,nz ,nx) (* 1 ,nx)) `(= (* ,nz ,nx) (* ,nx ,nz))
                                                     `(= (* ,nx ,nz) 1) `(= (* 1 ,nx) ,nx))))
          (cg2-and! `(IN ,nx RR) '(IN 1 RR))
          (cg2-and! `(<= ,nx 1) `(<= 1 ,nx))
          (dk-cite! 'rr-leq-antisymmetric nx 1)))))
  `(= ,(cg2-n x) 1))
(define (cg3-inv x) (cdr (or (assoc x cg3-invs) (error "cg3: no inverse recorded for" x))))
(define cg3-PL #f)
(define cg3-RL #f)
(define (cg3-ev r) `(POLY-EVAL ,cg2-V ,r w))
(define (cg3-K! x) (cg2-or! `(IN ,x (CARR K)) (lambda () (dk-type! x '(CARR K)))))
;; r in PL in context: open it, type its value at w, and cite nv-sum-leading; returns (ev = sum, the OR, the sum)
(define (cg3-lead! r)
  (dk-sep-parts! `(IN ,r ,cg3-PL))
  (cg2-inV! 'w)
  (dk-cite! 'poly-eval-type cg2-V r 'w)
  (cg2-inK! (cg3-ev r))
  (let ((dg `(DEG ,cg2-V ,r)))
    (let ((dw (dk-cite! 'deg-well-defined cg2-V r)))
      (if (dk-head-is? dw 'AND) (dk-split-all! (list dw))))
    (let* ((eq1 (dk-cite! 'poly-eval-bound cg2-V r 'w dg))
           (G (caddr (caddr eq1)))
           (N `(succ ,dg))
           (sumK `(SUM-AG ,cg2-ag ,G ,N))
           (eq2 `(= ,(cg3-ev r) ,sumK)))
      (dk-cite! 'nn-succ-closed dg)
      (dk-have! eq2 (lambda () (subst `(== ,cg2-ag (RING-ADDITIVE-AG ,cg2-V))) (dk-ass!)))
      (dk-have! `(FORALL cgj_ (IMPLIES (IN cgj_ NN) (== (,G cgj_) ,(cg2-mul `(,r cgj_) (cg2-rp 'cgj_)))))
        (lambda () (dk-peel!) (dk-lam-b!) (subst `(= (MUL ,cg2-V) (MUL K))) (cg2-rfl-or-ass!)))
      (list eq2 (dk-cite! 'nv-sum-leading N 'K 'F 'w r G) sumK))))
;; after ai of the OR: (zero-leaf . lead-leaf), told apart by the zero disjunct
(define (cg3-cases! orf sumK)
  (let* ((cs (dk-opened (lambda () (ai orf))))
         (zl (find-first (lambda (l) (begin (dk-focus! l) (dk-asm? `(= ,sumK (ZERO K))))) cs))
         (ll (find-first (lambda (l) (not (eq? l zl))) cs)))
    (if (not (and zl ll)) (error "cg3-cases!: the OR did not split into a zero and a lead case"))
    (cons zl ll)))
;; skolemise the leading term of sumK, rewrite its estimate to EV; returns (s c)
(define (cg3-skolem-lead! sumK ev)
  (let* ((ex1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sumK))) "the leading term"))
         (s (dk-skolem! ex1 #t))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sumK))) "the leading coefficient"))
         (c (dk-skolem! ex2 #t)))
    (dk-rewrite-h! `(< ,(cg2-n (cg2-sub sumK (cg2-mul c (cg2-rp s)))) (power ,(cg2-n 'w) ,s)) sumK ev)
    (list s c)))
;; |EV| = |w|^s from the leading term c w^s, c /= 0 in F
(define (cg3-norm-ev! ev s c)
  (let* ((cz (cg2-mul c (cg2-rp s))) (xx (cg2-sub ev cz)) (ws `(power ,(cg2-n 'w) ,s)))
    (cg2-rp! s)
    (cg3-norm1! c)
    (cg3-F->K! c)
    (dk-cite! 'nf-mul-in-carr 'K c (cg2-rp s))
    (dk-cite! 'nf-neg-in-carr 'K cz)
    (dk-cite! 'nf-add-in-carr 'K ev `((NEG K) ,cz))
    (cg2-norm! xx) (cg2-norm! cz) (cg2-norm! ev)
    (cg2-norm! 'w)
    (dk-cite! 'power-closed-at s (cg2-n 'w))
    (dk-cite! 'nf-norm-mult 'K c (cg2-rp s))
    (dk-have! `(= ,(cg2-n cz) ,ws)
      (lambda () (subst `(= ,(cg2-n cz) (* ,(cg2-n c) ,(cg2-n (cg2-rp s)))))
                 (subst `(= ,(cg2-n c) 1)) (subst `(= ,(cg2-n (cg2-rp s)) ,ws))
                 (dk-cite! 'power-closed-at s (cg2-n 'w)) (crs)))
    (dk-have! `(< ,(cg2-n xx) ,(cg2-n cz)) (lambda () (dk-ineq! `(< ,(cg2-n xx) ,ws) `(= ,(cg2-n cz) ,ws))))
    (let ((dom (dk-cite! 'nv-strict-dominance 'K xx cz)))
      (cg2-req! `(= ((ADD K) ,xx ,cz) ,ev) (list ev c (cg2-rp s)))
      (dk-rewrite-h! dom `((ADD K) ,xx ,cz) ev))
    (dk-have! `(= ,(cg2-n ev) ,ws) (lambda () (subst `(= ,(cg2-n ev) ,(cg2-n cz))) (subst `(= ,(cg2-n cz) ,ws)) (cg2-rfl-or-ass!)))
    xx))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL F (IMPLIES (IS-NF-SUBFIELD K F)
  (IMPLIES ,cg3-bnd
  (FORALL w (IMPLIES (IN w (CARR K)) (IMPLIES (< 0 ,(cg2-n 'w)) (IMPLIES (< ,(cg2-n 'w) 1)
  (FORALL y (IMPLIES (IN y (NF-RAT-AT K F w)) (IMPLIES (<= ,(cg2-n 'y) 1)
    (FORSOME cgc (AND (IN cgc F) (< ,(cg2-n (cg2-sub 'y 'cgc)) 1)))))))))))))))))
(mac 'NF-RAT-AT)
(mac 'NF-POLY-OVER)
(dk-peel!)
(cg3-setup!)
(dk-cite! 'nf-zero-in-carr 'K)
(set! cg3-RL (caddr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'y) (dk-head-is? (caddr h) 'SEP))) "y in F(w)")))
(set! cg3-PL (caddr (cadr (caddr (cadddr cg3-RL)))))
(cg2-norm! 'w)
(define cg3-r (cg2-n 'w))
(fact 'rr-one-in)
(define cg3-p #f) (define cg3-q #f)
(let* ((part (dk-sep-parts! `(IN y ,cg3-RL)))
       (p (dk-skolem! part #t))
       (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f (cg3-ev p)))) "the denominator"))
       (q (dk-skolem! ex2 #t)))
  (set! cg3-p p) (set! cg3-q q))
(cg2-norm! 'y)
(define cg3-evp (cg3-ev cg3-p))
(define cg3-evq (cg3-ev cg3-q))
;; q: its value is not 0, so it has a leading term
(define cg3-lq (cg3-lead! cg3-q))
(let ((zl+ll (cg3-cases! (cadr cg3-lq) (caddr cg3-lq))))
  (dk-focus! (car zl+ll))
  (dk-have! `(= ,cg3-evq (ZERO K)) (lambda () (subst (car cg3-lq)) (dk-ass!)))
  (ai `(NOT (= ,cg3-evq (ZERO K))))
  (dk-focus! (cdr zl+ll)))
(define cg3-sc (cg3-skolem-lead! (caddr cg3-lq) cg3-evq))
(define cg3-s (car cg3-sc))
(define cg3-cq (cadr cg3-sc))
(define cg3-Xq (cg3-norm-ev! cg3-evq cg3-s cg3-cq))
(define cg3-rs `(power ,cg3-r ,cg3-s))
;; |y| |w|^s = |p(w)|
(dk-cite! 'nf-mul-in-carr 'K 'y cg3-evq)
(let ((nm (dk-cite! 'nf-norm-mult 'K 'y cg3-evq)))
  (dk-rewrite-h! (dk-rewrite-h! nm `((MUL K) y ,cg3-evq) cg3-evp) (cg2-n cg3-evq) cg3-rs))
(dk-cite! 'rr-power-pos cg3-r cg3-s)
(dk-cite! 'power-closed-at cg3-s cg3-r)
(dk-have! `(<= 0 ,cg3-rs) (lambda () (dk-ineq! `(< 0 ,cg3-rs))))
(dk-cite! 'rr-mul-le-right (cg2-n 'y) 1 cg3-rs)
(dk-cite! 'rr-mul-in-rr (cg2-n 'y) cg3-rs)
(dk-cite! 'rr-mul-in-rr 1 cg3-rs)
(dk-have! `(= (* 1 ,cg3-rs) ,cg3-rs) (lambda () (crs)))
;; witness 0 when |y| < 1
(define (cg3-zero-witness!)
  (ew '(ZERO K))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN) (dk-ass!)
          (begin
            (cg2-req! `(= ,(cg2-sub 'y '(ZERO K)) y) '(y))
            (subst `(= ,(cg2-sub 'y '(ZERO K)) y))
            (dk-ineq! `(< ,(cg2-n 'y) 1)))))))
;; p: the zero case gives y = 0
(define cg3-lp (cg3-lead! cg3-p))
(let ((zl+ll (cg3-cases! (cadr cg3-lp) (caddr cg3-lp))))
  (dk-focus! (car zl+ll))
  (dk-have! `(= ,cg3-evp (ZERO K)) (lambda () (subst (car cg3-lp)) (dk-ass!)))
  (dk-have! `(= ((MUL K) y ,cg3-evq) ((MUL K) (ZERO K) ,cg3-evq))
    (lambda () (subst `(= ((MUL K) y ,cg3-evq) ,cg3-evp)) (subst `(= ,cg3-evp (ZERO K)))
               (cg2-inV! cg3-evq) (cg2-crs!)))
  (dk-cite! 'nf-mul-cancel 'K 'y '(ZERO K) cg3-evq)
  (dk-cite! 'nf-norm-of-zero 'K)
  (cg2-norm! '(ZERO K))
  (dk-have! `(< ,(cg2-n 'y) 1) (lambda () (subst '(= y (ZERO K))) (dk-ineq! `(= ,(cg2-n '(ZERO K)) 0))))
  (cg3-zero-witness!)
  (dk-focus! (cdr zl+ll)))
(define cg3-tc (cg3-skolem-lead! (caddr cg3-lp) cg3-evp))
(define cg3-t (car cg3-tc))
(define cg3-cp (cadr cg3-tc))
(define cg3-Xp0 (cg3-norm-ev! cg3-evp cg3-t cg3-cp))
(define cg3-rt `(power ,cg3-r ,cg3-t))
(dk-cite! 'power-closed-at cg3-t cg3-r)
;; the three cases s < t, t < s, t = s
(use-em `(< ,cg3-s ,cg3-t)
  (lambda ()
    (dk-chain-ass! (dk-cite! 'rr-power-strict cg3-r cg3-s cg3-t))
    (dk-have! `(< (* ,(cg2-n 'y) ,cg3-rs) (* 1 ,cg3-rs))
      (lambda () (dk-ineq! `(= ,(cg2-n cg3-evp) (* ,(cg2-n 'y) ,cg3-rs)) `(= ,(cg2-n cg3-evp) ,cg3-rt)
                           `(< ,cg3-rt ,cg3-rs) `(= (* 1 ,cg3-rs) ,cg3-rs))))
    (let ((iff (dk-cite! 'rr-mul-lt-cancel-iff (cg2-n 'y) 1 cg3-rs)))
      (dk-have! `(< ,(cg2-n 'y) 1) (lambda () (dk-close-if! (lambda () (dk-only! iff `(< (* ,(cg2-n 'y) ,cg3-rs) (* 1 ,cg3-rs)))) prop))))
    (cg3-zero-witness!))
  (lambda ()
    (dk-cite! 'nn-not-lt-le cg3-s cg3-t)
    (use-em `(< ,cg3-t ,cg3-s)
      (lambda ()
        (dk-chain-ass! (dk-cite! 'rr-power-strict cg3-r cg3-t cg3-s))
        (dk-absurd! `(< ,cg3-rs ,cg3-rt) `(= ,(cg2-n cg3-evp) ,cg3-rt) `(= ,(cg2-n cg3-evp) (* ,(cg2-n 'y) ,cg3-rs))
                    `(<= (* ,(cg2-n 'y) ,cg3-rs) (* 1 ,cg3-rs)) `(= (* 1 ,cg3-rs) ,cg3-rs) `(<= ,(cg2-n 'y) 1)))
      (lambda ()
        (dk-cite! 'nn-not-lt-le cg3-t cg3-s)
        (dk-cite! 'nn-le-antisym cg3-t cg3-s)
        (let* ((s cg3-s) (cp cg3-cp) (cq cg3-cq) (evp cg3-evp) (evq cg3-evq) (rs cg3-rs)
               (ws (cg2-rp s))
               (xp (cg2-sub evp (cg2-mul cp ws)))
               (xq cg3-Xq)
               (z (cg3-inv cq))
               (c (cg2-mul cp z))
               (cxq (cg2-mul c xq)) (ncxq `((NEG K) ,cxq))
               (ww `((ADD K) ,xp ,ncxq))
               (ymc (cg2-sub 'y c))
               (lhs (cg2-mul ymc evq)))
          (dk-rewrite-h! `(< ,(cg2-n (cg2-sub evp (cg2-mul cp (cg2-rp cg3-t)))) ,cg3-rt) cg3-t s)
          (cg3-F->K! z) (cg3-F->K! cp) (cg3-F->K! cq)
          (dk-apply! (cg3-c 4) cp z)
          (cg3-F->K! c) (cg3-le1! c) (cg2-norm! c)
          (dk-cite! 'nf-mul-in-carr 'K cp ws)
          (dk-cite! 'nf-neg-in-carr 'K (cg2-mul cp ws))
          (dk-cite! 'nf-add-in-carr 'K evp `((NEG K) ,(cg2-mul cp ws)))
          (dk-cite! 'nf-mul-in-carr 'K c xq)
          (dk-cite! 'nf-neg-in-carr 'K cxq)
          (dk-cite! 'nf-add-in-carr 'K xp ncxq)
          (dk-cite! 'nf-neg-in-carr 'K c)
          (dk-cite! 'nf-add-in-carr 'K 'y `((NEG K) ,c))
          (dk-cite! 'nf-mul-in-carr 'K ymc evq)
          (for-each cg2-norm! (list xp xq cxq ncxq ww ymc lhs))
          ;; c cq = cp
          (cg2-req! `(= ((MUL K) ,c ,cq) ((MUL K) ,cp ((MUL K) ,cq ,z))) (list cp z cq))
          (dk-have! `(= ((MUL K) ,c ,cq) ,cp)
            (lambda () (subst `(= ((MUL K) ,c ,cq) ((MUL K) ,cp ((MUL K) ,cq ,z))))
                       (subst `(= ((MUL K) ,cq ,z) (ONE K)))
                       (cg2-inV! cp) (cg2-crs!)))
          ;; (y - c) q(w) = Xp - c Xq
          (cg2-req! `(= ,lhs ((ADD K) ((MUL K) y ,evq) ((NEG K) ((MUL K) ,c ,evq)))) (list 'y cp z evq))
          (cg2-req! `(= ((ADD K) ,evp ((NEG K) ((MUL K) ,c ,evq)))
                        ((ADD K) ,ww ((ADD K) ((MUL K) ,cp ,ws) ((NEG K) ((MUL K) ((MUL K) ,c ,cq) ,ws)))))
                    (list evp evq cp z cq ws))
          (dk-have! `(= ,lhs ,ww)
            (lambda ()
              (subst `(= ,lhs ((ADD K) ((MUL K) y ,evq) ((NEG K) ((MUL K) ,c ,evq)))))
              (subst `(= ((MUL K) y ,evq) ,evp))
              (subst `(= ((ADD K) ,evp ((NEG K) ((MUL K) ,c ,evq)))
                         ((ADD K) ,ww ((ADD K) ((MUL K) ,cp ,ws) ((NEG K) ((MUL K) ((MUL K) ,c ,cq) ,ws))))))
              (subst `(= ((MUL K) ,c ,cq) ,cp))
              (for-each cg2-inV! (list 'y cp z cq evp evq ws))
              (cg2-crs!)))
          ;; |y - c| |w|^s = |Xp - c Xq| < |w|^s
          (let ((nm (dk-cite! 'nf-norm-mult 'K ymc evq)))
            (dk-rewrite-h! (dk-rewrite-h! nm lhs ww) (cg2-n evq) rs))
          (dk-cite! 'nf-norm-mult 'K c xq)
          (dk-cite! 'nf-norm-neg 'K cxq)
          (dk-cite! 'rr-mul-le-right (cg2-n c) 1 (cg2-n xq))
          (dk-cite! 'rr-mul-in-rr (cg2-n c) (cg2-n xq))
          (dk-cite! 'rr-mul-in-rr 1 (cg2-n xq))
          (dk-have! `(= (* 1 ,(cg2-n xq)) ,(cg2-n xq)) (lambda () (crs)))
          (dk-have! `(< ,(cg2-n ncxq) ,rs)
            (lambda () (dk-ineq! `(= ,(cg2-n ncxq) ,(cg2-n cxq)) `(= ,(cg2-n cxq) (* ,(cg2-n c) ,(cg2-n xq)))
                                 `(<= (* ,(cg2-n c) ,(cg2-n xq)) (* 1 ,(cg2-n xq))) `(= (* 1 ,(cg2-n xq)) ,(cg2-n xq))
                                 `(< ,(cg2-n xq) ,rs))))
          (dk-cite! 'nv-ultra 'K xp ncxq)
          (dk-cite! 'rr-max-closed (cg2-n xp) (cg2-n ncxq))
          (dk-cite! 'rr-max-lt (cg2-n xp) (cg2-n ncxq) rs)
          (dk-cite! 'rr-mul-in-rr (cg2-n ymc) rs)
          (dk-have! `(< (* ,(cg2-n ymc) ,rs) (* 1 ,rs))
            (lambda () (dk-ineq! `(= ,(cg2-n ww) (* ,(cg2-n ymc) ,rs)) `(<= ,(cg2-n ww) (MAX ,(cg2-n xp) ,(cg2-n ncxq)))
                                 `(< (MAX ,(cg2-n xp) ,(cg2-n ncxq)) ,rs) `(= (* 1 ,rs) ,rs))))
          (let ((iff (dk-cite! 'rr-mul-lt-cancel-iff (cg2-n ymc) 1 rs)))
            (dk-have! `(< ,(cg2-n ymc) 1) (lambda () (dk-close-if! (lambda () (dk-only! iff `(< (* ,(cg2-n ymc) ,rs) (* 1 ,rs)))) prop))))
          (ew c)
          (dk-conj-close! dk-ass!))))))
(cg2-qed! 'nv-rat-at-residue)
