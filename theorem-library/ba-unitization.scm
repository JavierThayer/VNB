;;; ba-unitization.scm -- BANACH ALGEBRAS: the unitization of a complex normed algebra
;;; (Thayer, Proposition 1.1): C x A with (l, x)(r, y) = (l r, l y + r x + x y), the norm
;;; ||(l, x)|| = |l| + ||x||, unit (1, 0).  ba-vocab's UNITIZATION-NA / UNITIZATION put the
;;; scalar FIRST (CARTESIAN CC (VEC a)), as the notes do; the brief's A x CC is the same
;;; construction with the factors swapped.
;;; Agent BA-1C, wave 2026-11-09.  Destination: theorem-library/ba-unitization.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: bun-.
;;;
;;; THE TECHNIQUE (BA-1 finding F11): every operation of UNITIZATION-NA is a VNB-LAMBDA on
;;; pairs.  One READ-OFF per operation reduces it at a literal pair (l, x) once, and the
;;; ETA law u = (NTH 1 u, NTH 2 u) with its typed components (bun-eta) puts any element in
;;; that form; a law is then a computation on components, and an equation of pairs is the
;;; equation of their components (bun-pair-eq).  No law below re-opens a lambda.
;;;
;;; LOAD WINDOW: after structure-library/ba-vocab and theorem-library/ba-laws (BA-1);
;;; rb3-c-* companions at CNA-AS-MODULE need ba-vocab after rake-asm-b3 (as BA-1 says).

(define (bun-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-unitization: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-unitization: unfinished" name))))
(define (bun-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (bun-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))
(define (bun-fa v cls body) (list 'FORALL v (list 'IMPLIES (list 'IN v cls) body)))
(define (bun-st body) (list 'FORALL 'a (list 'IMPLIES '(IS-COMPLEX-NORMED-ALGEBRA a) body)))
(define (bun-ad x y) (list '(VADD a) x y))
(define (bun-mu x y) (list '(VMUL a) x y))
(define (bun-ac z x) (list '(ACT a) z x))
(define (bun-ng x) (list '(VNEG a) x))
(define (bun-nr x) (list '(VNRM a) x))
(define bun-zero '(VZERO a))
(define (bun-nth-all!)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (nth-r)))
      (if (and (< n 8) (not (equal? g (dk-goal)))) (loop (+ n 1))))))

;;; (bun-vt X) -- type the algebra expression X in (VEC a) bottom-up, by citation
;;; (variables typed in context; VZERO, VADD, VNEG, VMUL; ACT at a scalar typed in CC).
(define (bun-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bun-zero) (dk-cite! 'bal-cna-vzero-in 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bun-vt (cadr x)) (bun-vt (caddr x))
           (dk-cite! 'module-vadd-type-cna-as-module 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bun-vt (cadr x))
           (dk-cite! 'module-vneg-type-cna-as-module 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bun-vt (caddr x))
           (bun-ct (cadr x))
           (dk-cite! 'bal-cna-scal-pin 'a)
           (dk-cite! 'rb3-c-act-in-cna-as-module 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (let ((u (cadr x)) (v (caddr x)))
             (bun-vt u) (bun-vt v)
             (dk-cite! 'bal-cna-vmul-fun 'a)
             (dk-cite! 'pair-in-cartesian '(VEC a) '(VEC a) u v)
             (dk-cite! 'fun-apply-type-c '(VMUL a) '(CARTESIAN (VEC a) (VEC a)) '(VEC a) (list 'LIST u v))
             (dk-cite! 'apply-tupling-2 '(VMUL a) u v)
             (dk-rewrite-h! (list 'IN (list '(VMUL a) (list 'LIST u v)) '(VEC a)) (list '(VMUL a) (list 'LIST u v)) x)
             x))
          (#t (error "bun-vt: cannot type" (expression->string x))))))
;;; (bun-ct Z) -- type the scalar expression Z in CC (variables typed, + * -, numerals)
(define (bun-ct z)
  (let ((want (list 'IN z 'CC)))
    (cond ((dk-asm? want) z)
          ((number? z) (dk-have! want (lambda () (arith))) z)
          ((and (pair? z) (memq (car z) '(+ *)) (= (length z) 3))
           (bun-ct (cadr z)) (bun-ct (caddr z))
           (bun-cite2! (if (eq? (car z) '+) 'cc-add-closed 'cc-mul-closed) (cadr z) (caddr z)) z)
          ((and (pair? z) (eq? (car z) '-) (= (length z) 2))
           (bun-ct (cadr z)) (dk-cite! 'cc-neg-closed (cadr z)) z)
          (#t (error "bun-ct: cannot type" (expression->string z))))))
;;; the norm of an element, typed, with 0 <= it
(define (bun-nt x)
  (bun-vt x)
  (dk-cite! 'bal-cna-vnrm-fun 'a)
  (dk-cite! 'fun-apply-type-c '(VNRM a) '(VEC a) 'RR x)
  (dk-cite! 'bal-cna-vnrm-nonneg 'a x)
  (bun-nr x))
(define (bun-mt z)
  (bun-ct z)
  (dk-cite! 'cc-magnitude-closed z)
  (dk-cite! 'cc-magnitude-nonneg z)
  (list 'magnitude z))

;;; ---- read-offs at literal pairs ------------------------------------------------------
(define (bun-readoff! name fn args lhs rhs . vts)
  (sp (make-wff (bun-st (let wrap ((as args))
                          (if (null? as) (list '= lhs rhs)
                              (bun-fa (car (car as)) (cadr (car as)) (wrap (cdr as))))))))
  (dk-peel!)
  (mac fn)
  (mac 'UNIT-VEC)
  (for-each (lambda (p) (dk-cite! 'pair-in-cartesian 'CC '(VEC a) (car p) (cadr p)))
            (let loop ((as args) (acc '()))
              (if (or (null? as) (null? (cdr as))) (reverse acc)
                  (if (and (eq? (cadr (car as)) 'CC) (equal? (cadr (cadr as)) '(VEC a)))
                      (loop (cddr as) (cons (list (car (car as)) (car (cadr as))) acc))
                      (loop (cdr as) acc)))))
  (for-each (lambda (t) (if (procedure? t) (t) (bun-vt t))) vts)
  (if (not (dk-lam-b!))
      (begin
        (bun-nth-all!)
        (if (not (proof-done? *ps*)) (rfl))))
  (bun-qed! name))

(bun-readoff! 'bun-vadd-apply 'UNIT-VADD '((l CC) (x (VEC a)) (r CC) (y (VEC a)))
  '((UNIT-VADD a) (LIST l x) (LIST r y)) '(LIST (+ l r) ((VADD a) x y)))

;;; (the vmul read-off states the VEC component as BA-1's vocabulary computes it:
;;; (l y + r x) + x y, the ACT terms with the scalar of the OTHER factor)
(bun-readoff! 'bun-vneg-apply 'UNIT-VNEG '((l CC) (x (VEC a)))
  '((UNIT-VNEG a) (LIST l x)) '(LIST (- l) ((VNEG a) x)))
(bun-readoff! 'bun-act-apply 'UNIT-ACT '((c CC) (l CC) (x (VEC a)))
  '((UNIT-ACT a) c (LIST l x)) '(LIST (* c l) ((ACT a) c x)) '((ACT a) c x))
(bun-readoff! 'bun-vnrm-apply 'UNIT-VNRM '((l CC) (x (VEC a)))
  '((UNIT-VNRM a) (LIST l x)) '(+ (magnitude l) ((VNRM a) x)) (lambda () (bun-mt 'l) (bun-nt 'x)))
(bun-readoff! 'bun-vmul-apply 'UNIT-VMUL '((l CC) (x (VEC a)) (r CC) (y (VEC a)))
  '((UNIT-VMUL a) (LIST l x) (LIST r y))
  '(LIST (* l r) ((VADD a) ((VADD a) ((ACT a) l y) ((ACT a) r x)) ((VMUL a) x y)))
  '((VADD a) ((VADD a) ((ACT a) l y) ((ACT a) r x)) ((VMUL a) x y)))

;;; ---- the norm laws of the unitization, on literal pairs ----------------------------------
(define (bun-un l x) (list '(UNIT-VNRM a) (list 'LIST l x)))
(define (bun-lhs g) (cadr g))
(define (bun-rhs g) (caddr g))
(define (bun-have-in! z cls) (dk-have! (list 'IN z cls) (lambda () (arith))))
;;; land (IN z (CARR (SCAL a))) from (IN z CC)
(define (bun-scal! z)
  (bun-ct z)
  (dk-cite! 'bal-cna-scal-carr 'a)
  (dk-rewrite-h! (list 'IN z 'CC) 'CC '(CARR (SCAL a))))
;;; rewrite the goal by the vnrm read-off at (l, x), with l in CC and x in VEC a typed
(define (bun-vnrm-rw! l x)
  (bun-ct l) (bun-vt x)
  (dk-cite! 'bun-vnrm-apply 'a l x)
  (subst (list '= (bun-un l x) (list '+ (list 'magnitude l) (bun-nr x)))))

;;; ||(1, 0)|| = 1
(sp (make-wff (bun-st (list '= (bun-un 1 bun-zero) 1))))
(dk-peel!)
(bun-have-in! 1 'CC)
(bun-vnrm-rw! 1 bun-zero)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-cite! 'rr-magnitude-is-abs 1)
(subst '(= (magnitude 1) (abs 1)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'rr-abs-of-nonneg 1)
(subst '(= (abs 1) 1))
(dk-have! (list '= bun-zero bun-zero) (lambda () (rfl)))
(let ((d (dk-cite! 'bal-cna-vnrm-definite 'a bun-zero)))
  (dk-have! (list '= (bun-nr bun-zero) 0)
    (lambda () (keep d (list '= bun-zero bun-zero)) (prop))))
(subst (list '= (bun-nr bun-zero) 0))
(arith)
(bun-qed! 'unitization-norm-unit)

;;; the triangle inequality
(sp (make-wff (bun-st (bun-fa 'l 'CC (bun-fa 'x '(VEC a) (bun-fa 'r 'CC (bun-fa 'y '(VEC a)
  (list '<= (list '(UNIT-VNRM a) (list '(UNIT-VADD a) '(LIST l x) '(LIST r y)))
            (list '+ (bun-un 'l 'x) (bun-un 'r 'y))))))))))
(dk-peel!)
(dk-cite! 'bun-vadd-apply 'a 'l 'x 'r 'y)
(subst (list '= (list '(UNIT-VADD a) '(LIST l x) '(LIST r y)) (list 'LIST '(+ l r) (bun-ad 'x 'y))))
(bun-vnrm-rw! '(+ l r) (bun-ad 'x 'y))
(bun-vnrm-rw! 'l 'x)
(bun-vnrm-rw! 'r 'y)
(for-each bun-mt '(l r (+ l r)))
(for-each bun-nt (list 'x 'y (bun-ad 'x 'y)))
(bun-cite2! 'cc-magnitude-triangle 'l 'r)
(dk-cite! 'bal-cna-vnrm-triangle 'a 'x 'y)
(dk-ineq! '(<= (magnitude (+ l r)) (+ (magnitude l) (magnitude r)))
          (list '<= (bun-nr (bun-ad 'x 'y)) (list '+ (bun-nr 'x) (bun-nr 'y))))
(bun-qed! 'unitization-norm-triangle)

;;; submultiplicativity: ||(l, x)(r, y)|| <= ||(l, x)|| ||(r, y)||
(sp (make-wff (bun-st (bun-fa 'l 'CC (bun-fa 'x '(VEC a) (bun-fa 'r 'CC (bun-fa 'y '(VEC a)
  (list '<= (list '(UNIT-VNRM a) (list '(UNIT-VMUL a) '(LIST l x) '(LIST r y)))
            (list '* (bun-un 'l 'x) (bun-un 'r 'y))))))))))
(dk-peel!)
(let* ((ly (bun-ac 'l 'y)) (rx (bun-ac 'r 'x)) (xy (bun-mu 'x 'y))
       (s1 (bun-ad ly rx)) (v (bun-ad s1 xy))
       (ml '(magnitude l)) (mr '(magnitude r)) (nx (bun-nr 'x)) (ny (bun-nr 'y)))
  (dk-cite! 'bun-vmul-apply 'a 'l 'x 'r 'y)
  (subst (list '= (list '(UNIT-VMUL a) '(LIST l x) '(LIST r y)) (list 'LIST '(* l r) v)))
  (bun-vnrm-rw! '(* l r) v)
  (bun-vnrm-rw! 'l 'x)
  (bun-vnrm-rw! 'r 'y)
  (for-each bun-mt '(l r (* l r)))
  (for-each bun-nt (list 'x 'y ly rx xy s1 v))
  ;; expand (|l| + ||x||)(|r| + ||y||)
  (let ((ex (list '+ (list '+ (list '+ (list '* ml mr) (list '* ml ny)) (list '* mr nx)) (list '* nx ny))))
    (dk-have! (list '= (list '* (list '+ ml nx) (list '+ mr ny)) ex) (lambda () (crs)))
    (subst (list '= (list '* (list '+ ml nx) (list '+ mr ny)) ex)))
  (bun-cite2! 'cc-magnitude-mul 'l 'r)
  (bun-scal! 'l) (bun-scal! 'r)
  ;; the four products, named as fresh reals (ineq drops a premise holding a product)
  (let loop ((ps (list (list '* ml mr) (list '* ml ny) (list '* mr nx) (list '* nx ny)))
             (prems (list (list '= '(magnitude (* l r)) (list '* ml mr))
                          (dk-cite! 'bal-cna-vnrm-homog 'a 'l 'y)
                          (dk-cite! 'bal-cna-vnrm-homog 'a 'r 'x)
                          (dk-cite! 'bal-cna-vnrm-submult 'a 'x 'y))))
    (if (pair? ps)
        (let* ((pt (car ps)))
          (dk-cite! 'rr-mul-in-rr (cadr pt) (caddr pt))
          (let ((v (dk-name! pt)))
            (subst (list '= pt v))
            (loop (cdr ps)
                  (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))
        (begin
          (dk-cite! 'bal-cna-vnrm-triangle 'a s1 xy)
          (dk-cite! 'bal-cna-vnrm-triangle 'a ly rx)
          (apply dk-ineq!
                 (append prems
                         (list (list '<= (bun-nr v) (list '+ (bun-nr s1) (bun-nr xy)))
                               (list '<= (bun-nr s1) (list '+ (bun-nr ly) (bun-nr rx))))))))))
(bun-qed! 'unitization-norm-submult)

;;; homogeneity: ||c (l, x)|| = |c| ||(l, x)||
(sp (make-wff (bun-st (bun-fa 'c 'CC (bun-fa 'l 'CC (bun-fa 'x '(VEC a)
  (list '= (list '(UNIT-VNRM a) (list '(UNIT-ACT a) 'c '(LIST l x)))
           (list '* '(magnitude c) (bun-un 'l 'x)))))))))
(dk-peel!)
(let* ((mc '(magnitude c)) (ml '(magnitude l)) (nx (bun-nr 'x)) (cx (bun-ac 'c 'x)))
  (dk-cite! 'bun-act-apply 'a 'c 'l 'x)
  (subst (list '= (list '(UNIT-ACT a) 'c '(LIST l x)) (list 'LIST '(* c l) cx)))
  (bun-vnrm-rw! '(* c l) cx)
  (bun-vnrm-rw! 'l 'x)
  (for-each bun-mt '(c l (* c l)))
  (bun-nt 'x) (bun-nt cx)
  (let ((ex (list '+ (list '* mc ml) (list '* mc nx))))
    (dk-have! (list '= (list '* mc (list '+ ml nx)) ex) (lambda () (crs)))
    (subst (list '= (list '* mc (list '+ ml nx)) ex)))
  (bun-cite2! 'cc-magnitude-mul 'c 'l)
  (bun-scal! 'c)
  (let loop ((ps (list (list '* mc ml) (list '* mc nx)))
             (prems (list (list '= '(magnitude (* c l)) (list '* mc ml))
                          (dk-cite! 'bal-cna-vnrm-homog 'a 'c 'x))))
    (if (pair? ps)
        (let ((pt (car ps)))
          (dk-cite! 'rr-mul-in-rr (cadr pt) (caddr pt))
          (let ((v (dk-name! pt)))
            (subst (list '= pt v))
            (loop (cdr ps) (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))
        (begin
          (dk-have! (list '<= (bun-lhs (dk-goal)) (bun-rhs (dk-goal))) (lambda () (apply dk-ineq! prems)))
          (dk-have! (list '<= (bun-rhs (dk-goal)) (bun-lhs (dk-goal))) (lambda () (apply dk-ineq! prems)))
          (dk-real! (bun-lhs (dk-goal))) (dk-real! (bun-rhs (dk-goal)))
          (bun-cite2! 'rr-leq-antisymmetric (bun-lhs (dk-goal)) (bun-rhs (dk-goal)))
          (dk-ass!)))))
(bun-qed! 'unitization-norm-homog)

;;; ---- zero and unit facts in a complex normed algebra (no unit needed) ------------------
(define (bun-st1 v cls body) (make-wff (bun-st (bun-fa v cls body))))
(define (bun-subst*! eq)          ; subst to a fixpoint (a rewrite can expose a new redex)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (quietly (lambda () (subst eq)))
      (if (and (< n 4) (not (proof-done? *ps*)) (not (equal? g (dk-goal)))) (loop (+ n 1))))))
;;; t typed in VEC a, (<= ||t|| 0) a linear consequence of PREMS: land (= t 0)
(define (bun-norm-zero! t . prems)
  (let ((nt (bun-nt t)))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! (list '<= nt 0) (lambda () (apply dk-ineq! prems)))
    (bun-cite2! 'rr-leq-antisymmetric nt 0)
    (let ((d (dk-cite! 'bal-cna-vnrm-definite 'a t)))
      (dk-have! (list '= t bun-zero) (lambda () (keep (list '= nt 0) d) (prop))))))

(sp (make-wff (bun-st (list '= (bun-nr bun-zero) 0))))
(dk-peel!)
(bun-vt bun-zero)
(dk-have! (list '= bun-zero bun-zero) (lambda () (rfl)))
(let ((d (dk-cite! 'bal-cna-vnrm-definite 'a bun-zero)))
  (keep d (list '= bun-zero bun-zero))
  (prop))
(bun-qed! 'bun-vnrm-zero)

;;; 0 y = 0 and y 0 = 0
(define (bun-mul-zero! name left?)
  (sp (bun-st1 'y '(VEC a) (list '= (if left? (bun-mu bun-zero 'y) (bun-mu 'y bun-zero)) bun-zero)))
  (dk-peel!)
  (let* ((t (if left? (bun-mu bun-zero 'y) (bun-mu 'y bun-zero))))
    (bun-vt t) (bun-nt 'y) (bun-nt bun-zero)
    (let* ((sm (if left? (dk-cite! 'bal-cna-vnrm-submult 'a bun-zero 'y)
                         (dk-cite! 'bal-cna-vnrm-submult 'a 'y bun-zero)))
           (z (dk-cite! 'bun-vnrm-zero 'a))
           (sm1 (dk-rewrite-h! sm (bun-nr bun-zero) 0)))
      (bun-norm-zero! t sm1)
      (dk-ass!)))
  (bun-qed! name))
(bun-mul-zero! 'bun-vmul-zero-left #t)
(bun-mul-zero! 'bun-vmul-zero-right #f)

;;; y + 0 = y and 0 + y = y, read off IS-IDENTITY
(define (bun-add-zero! name right?)
  (sp (bun-st1 'y '(VEC a) (list '= (if right? (bun-ad 'y bun-zero) (bun-ad bun-zero 'y)) 'y)))
  (dk-peel!)
  (let* ((idf (dk-cite! 'bal-cna-vadd-ident 'a))
         (iff (dk-cite! 'IS-IDENTITY '(VADD a) bun-zero '(VEC a)))
         (univ (dk-project! (caddr iff) 'IS-IDENTITY idf))
         (cj (dk-apply! univ 'y)))
    (dk-split-all!)
    (dk-ass!))
  (bun-qed! name))
(bun-add-zero! 'bun-vadd-zero-right #t)
(bun-add-zero! 'bun-vadd-zero-left #f)

;;; 1 y = y
(sp (bun-st1 'y '(VEC a) (list '= (bun-ac 1 'y) 'y)))
(dk-peel!)
(dk-cite! 'bal-cna-scal-pin 'a)
(dk-cite! 'rb3-c-one-eq-cna-as-module 'a)
(let ((e (dk-cite! 'bal-cna-act-one 'a 'y)))
  (dk-rewrite-h! e '(ONE (SCAL a)) 1)
  (dk-ass!))
(bun-qed! 'bun-act-one)

;;; r 0 = 0
(sp (bun-st1 'r 'CC (list '= (bun-ac 'r bun-zero) bun-zero)))
(dk-peel!)
(bun-vt (bun-ac 'r bun-zero))
(bun-scal! 'r)
(bun-mt 'r)
(let* ((h (dk-cite! 'bal-cna-vnrm-homog 'a 'r bun-zero))
       (z (dk-cite! 'bun-vnrm-zero 'a))
       (h1 (dk-rewrite-h! h (bun-nr bun-zero) 0)))
  (bun-norm-zero! (bun-ac 'r bun-zero) h1)
  (dk-ass!))
(bun-qed! 'bun-act-zero-vec)

;;; ---- the unit (1, 0) of the unitization ------------------------------------------------
(sp (make-wff (bun-st (bun-fa 'r 'CC (bun-fa 'y '(VEC a)
  (list '= (list '(UNIT-VMUL a) (list 'LIST 1 bun-zero) '(LIST r y)) '(LIST r y)))))))
(dk-peel!)
(bun-have-in! 1 'CC)
(bun-vt bun-zero)
(dk-cite! 'bun-vmul-apply 'a 1 bun-zero 'r 'y)
(subst (list '= (list '(UNIT-VMUL a) (list 'LIST 1 bun-zero) '(LIST r y))
             (list 'LIST '(* 1 r) (bun-ad (bun-ad (bun-ac 1 'y) (bun-ac 'r bun-zero)) (bun-mu bun-zero 'y)))))
(dk-cite! 'bun-act-one 'a 'y)        (subst (list '= (bun-ac 1 'y) 'y))
(dk-cite! 'bun-act-zero-vec 'a 'r)   (subst (list '= (bun-ac 'r bun-zero) bun-zero))
(dk-cite! 'bun-vmul-zero-left 'a 'y) (subst (list '= (bun-mu bun-zero 'y) bun-zero))
(dk-cite! 'bun-vadd-zero-right 'a 'y)
(bun-subst*! (list '= (bun-ad 'y bun-zero) 'y))
(dk-have! '(= (* 1 r) r) (lambda () (crs)))
(subst '(= (* 1 r) r))
(rfl)
(bun-qed! 'bun-unit-left-pair)

(sp (make-wff (bun-st (bun-fa 'r 'CC (bun-fa 'y '(VEC a)
  (list '= (list '(UNIT-VMUL a) '(LIST r y) (list 'LIST 1 bun-zero)) '(LIST r y)))))))
(dk-peel!)
