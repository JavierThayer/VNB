(define (nt4-pseq-typ! q n)
  ;; IS-PRIME-SEQ ZZ-RING q n in context: land the pointwise ZZ typing of q on INTERVAL(1, n)
  (nt4-open! 'is-prime-seq (list 'ZZ-RING q n) (list 'IS-PRIME-SEQ 'ZZ-RING q n))
  (dk-have! (nt4-ptq q n)
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-apply! (dk-ctx-form (list 'FORALL 'gqi_ (list 'IMPLIES (list 'IN 'gqi_ (list 'INTERVAL 1 n)) (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q 'gqi_))))) i)
        (dk-project! (list 'IN (list q i) '(CARR ZZ-RING)) 'is-prime-element (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q i)))
        (dk-rewrite-h! (list 'IN (list q i) '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
        (ass)))))
(define (nt5-mult d n) (list 'SEP 'ntk_ (list 'INTERVAL 1 n) (list 'ZZ-DIVIDES d 'ntk_)))
(define (nt5-noprime k n) (list 'FORALL 'ntq_ (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ n) (list 'NOT (list 'ZZ-DIVIDES 'ntq_ k))))))
(define ie-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ie-ag (list 'RING-ADDITIVE-AG ie-r))
(define (ie-int x a f) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ f) (list 'IN 'iex_ (list a 'iek_))))))
(define (ie-out x a i) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ i) (list 'NOT (list 'IN 'iex_ (list a 'iek_)))))))
(define (ie-body x a f) (list '* (list 'power '(- 1) (list 'CARD f)) (list 'CARD (ie-int x a f))))
(define (ie-lam x a d) (list 'VNB-LAMBDA 'ief_ d (ie-body x a 'ief_)))
(define (ie-sum x a i) (list 'FINSUM ie-ag (ie-lam x a (list 'POWER i)) (list 'POWER i)))
(define (ie-sub x a j) (list 'SEP 'iey_ x (list 'IN 'iey_ (list a j))))
(define (ie-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (ie-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring ie-r)
  (dk-cite! 'ring-additive-ag-is-abelian-group ie-r)
  (fact 'cc-scalar-ring-carr)
  (dk-have! (list '= (list 'CARR ie-ag) 'CC) (lambda () (subst (dk-cite! 'ras-carr ie-r)) (subst (list '= (list 'CARR ie-r) 'CC)) (fact 'cc-is-set) (rfl)))
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
