  (let ((assoc! (lambda ()
                  (nt4-close! 'associated '(ZZ-RING q p)
                    (lambda ()
                      (nt4-in-carr! 'p)
                      (dk-conj-close!
                        (lambda ()
                          (cond ((dk-ass!) #t)
                                ((dk-head-is? (dk-goal) 'FORSOME)
                                 (ew c)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (not (dk-ass!))
                                         (begin
                                           (subst (list '= (list '(MUL ZZ-RING) c 'q) (list '* c 'q)))
                                           (subst (list '= 'p (list '* 'q c)))
                                           (crs))))))
                                (#t #f)))))))))
    (ma-or-split! (dk-apply! (dk-ctx-form (nt4-irr 'p)) 'q c)
      (list (lambda () (ma-prop-with! (list '(IS-UNIT ZZ-RING q) '(NOT (IS-UNIT ZZ-RING q)))))
            (lambda ()
