                       (dk-apply! (dk-ctx-form (list 'FORALL 'ntk_ (list 'IMPLIES '(IN ntk_ ZZ) (list 'IMPLIES (nt6-alldiv sv 'ntk_) (list 'ZZ-DIVIDES p0 'ntk_))))) k)
                       (dk-apply! (dk-ctx-form (nt6-alldiv u k)) xv)
                       (dk-have! (list 'NOT (list '= xv 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= xv 0) (list '< 1 xv)))) (ap-absurd!)))
