(define (nt6-dump! n)
  (for-each
    (lambda (l)
      (display ";; OPEN LEAF ") (display (sequent-node-number l)) (newline)
      (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
      (let* ((as (dk-asms-of l)) (k (length as)))
        (for-each (lambda (a) (display ";;   ctx ") (display (expression->string a)) (newline))
                  (list-tail as (max 0 (- k n))))))
    (dk-open-leaves)))
(define nt6-idl '(VNB-LAMBDA nzp_ ZZ nzp_))
(define (nt6-pf s) (list 'PROD-RING 'ZZ-RING nt6-idl s))
(define (nt6-allprime s) (list 'FORALL 'ntp_ (list 'IMPLIES (list 'IN 'ntp_ s) '(IS-PRIME-NAT ntp_))))
(define (nt6-alldiv s k) (list 'FORALL 'ntp_ (list 'IMPLIES (list 'IN 'ntp_ s) (list 'ZZ-DIVIDES 'ntp_ k))))
(define (nt6-primdiv s pf) (list 'FORALL 'ntq_ (list 'IMPLIES '(IN ntq_ NN) (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ pf) (list 'IN 'ntq_ s))))))
(define (nt6-body-of s pf)
  (list 'AND (list 'IN pf 'NN)
    (list 'AND (list '<= 1 pf)
      (list 'AND (nt6-alldiv s pf)
        (list 'AND (nt6-primdiv s pf)
                   (list 'FORALL 'ntk_ (list 'IMPLIES '(IN ntk_ ZZ) (list 'IMPLIES (nt6-alldiv s 'ntk_) (list 'ZZ-DIVIDES pf 'ntk_)))))))))
(define (nt6-prop s) (list 'IMPLIES (nt6-allprime s) (nt6-body-of s (nt6-pf s))))
(define (nt6-close-body! s pf typ! one! div! prim! all!)
  ;; goal (nt6-body-of s pf): run the five provers on their conjuncts
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((and (dk-head-is? g 'IN) (equal? (caddr g) 'NN)) (typ!))
              ((dk-head-is? g '<=) (one!))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'ntp_)) (div!))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'ntq_)) (prim!))
              (#t (all!)))))))

(sp (make-wff (list 'FORALL 'ff (list 'IMPLIES '(IN ff SET) (list 'IMPLIES '(IN (CARD ff) NN) (nt6-prop 'ff))))))
(dk-peel!)
(nt4-zzr!)
(dk-cite! 'zz-is-commutative-ring)
(fact 'nn-one-in) (dk-type! 1 'ZZ)
(let ((res (ma-induct! 'ff nt6-prop
             (lambda ()
               (di)
               (dk-cite! 'prod-ring-empty 'ZZ-RING nt6-idl)
               (subst (list '= (nt6-pf 'EMPTY-SET) '(ONE ZZ-RING)))
               (subst '(== (ONE ZZ-RING) 1))
               (nt6-close-body! 'EMPTY-SET 1
                 (lambda () (ass))
                 (lambda () (dk-nn!))
                 (lambda () (let ((p (dk-di-var!))) (fact 'empty-set-has-no-members p) (ma-prop-with! (list (list 'IN p 'EMPTY-SET) (list 'NOT (list 'IN p 'EMPTY-SET))))))
                 (lambda ()
                   (let ((q (dk-di-var!)))
                     (di) (di)
                     (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) q)))
                     (dk-type! q 'ZZ) (fact 'nn-in-rr q)
                     (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
