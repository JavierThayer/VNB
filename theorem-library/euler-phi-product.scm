(define (ie-fin! s x) (ma-sep-subset! s) (ie-finite-sub! s x))
(define (ie-finite-sub! s ca)
  ;; ma-finite-sub! with dk-cite! (the citation may already be in context)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))))
    (dk-apply! cs s)))
(define (ie-body-type! x a f)
  (ie-fin! (ie-int x a f) x)
  (cp-type!* (list 'power '(- 1) (list 'CARD f)))
  (cp-type!* (ie-body x a f)))
(define (cp-type!* t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (ie-or-split! k a b thunk-a thunk-b)
  ;; (IN k (UNION a b)) in context: case split
  (ma-or-split! (car (ma-iff-parts! (dk-cite! 'union-membership a b k))) (list thunk-a thunk-b)))
(define (ie-op-eq! op x y)
  (let* ((thm (if (eq? op 'MUL) 'cc-scalar-ring-mul 'cc-scalar-ring-add))
         (cop (if (eq? op 'MUL) '* '+))
         (eq (list '= (list (list op ie-r) x y) (list cop x y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! thm))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))
(define (ie-power-parts! z base)
  (ma-iff-parts! (dk-cite! 'power-set-membership base z))
  (dk-have! (list 'AND (list 'IN base 'SET) (list 'IN (list 'CARD base) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn base)))
    (dk-have! (list 'AND (list 'IN z 'SET) (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ z) (list 'IN 'iez_ base)))))
    (dk-apply! cs z)))
(define (ie-union x a i) (list 'SEP 'iex_ x (list 'FORSOME 'iek_ (list 'AND (list 'IN 'iek_ i) (list 'IN 'iex_ (list a 'iek_))))))
(define ie-e1 '(PAIR EMPTY-SET EMPTY-SET))
(define (ie-dom i) (list 'DIFFERENCE (list 'POWER i) ie-e1))
(define (ie-body1 x a f) (list '* (list 'power '(- 1) (list 'NN-MINUS (list 'CARD f) 1)) (list 'CARD (ie-int x a f))))

