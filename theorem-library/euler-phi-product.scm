                 (lambda ()
                   (let ((k (dk-di-var!)))
                     (di)
                     (dk-have! (list '= k (list '* 1 k)) (lambda () (crs)))
                     (nt2-div-intro! 1 k k)))))
             (lambda (sv xv u ih)
               (di)
               (let* ((pr (list 'PAIR xv xv)) (p0 (nt6-pf sv)) (p1 (list '* p0 xv)))
                 (ma-in-singleton! xv) (ma-in-union-right! xv sv pr)
                 (dk-have! (nt6-allprime sv)
                   (lambda () (let ((p (dk-di-var!))) (ma-in-union-left! p sv pr) (dk-apply! (dk-ctx-form (nt6-allprime u)) p) (ass))))
                 (dk-split-all! (list (dk-apply! (dk-ctx-form ih))))
                 (dk-apply! (dk-ctx-form (nt6-allprime u)) xv)
                 (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) xv)))
                 (dk-type! xv 'ZZ) (dk-type! p0 'ZZ) (fact 'nn-in-rr xv) (fact 'nn-in-rr p0)
                 ;; P_u = P_s x
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list nt6-idl 'z_) '(CARR ZZ-RING))))
                   (lambda ()
                     (let ((z (dk-di-var!)))
                       (dk-apply! (dk-ctx-form (nt6-allprime u)) z)
                       (nt4-open! 'is-prime-nat (list z) (list 'IS-PRIME-NAT z))
                       (dk-type! z 'ZZ)
                       (subst '(== (CARR ZZ-RING) ZZ))
                       (dk-lam-b!)
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
                 (dk-apply! (dk-cite! 'prod-ring-insert-ptwise 'ZZ-RING) sv xv nt6-idl)
                 (dk-have! (list '= (list nt6-idl xv) xv) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
                 (nt4-mul! p0 xv)
                 (dk-have! (list '= (nt6-pf u) p1)
                   (lambda ()
                     (subst (list '= (nt6-pf u) (list '(MUL ZZ-RING) p0 (list nt6-idl xv))))
                     (subst (list '= (list nt6-idl xv) xv))
                     (subst (list '= (list '(MUL ZZ-RING) p0 xv) p1))
                     (rfl)))
                 (subst (list '= (nt6-pf u) p1))
                 (dk-have! (list 'AND (list 'IN p0 'NN) (list 'IN xv 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
                 (fact 'nn-mul-closed p0 xv)
                 (fact 'nn-in-rr p1) (dk-type! p1 'ZZ)
                 (nt6-close-body! u p1
                   (lambda () (ass))
                   (lambda ()
                     (dk-have! (list '<= 0 xv) (lambda () (dk-ineq! (list '< 1 xv))))
                     (dk-apply! (dk-cite! 'rr-mul-le-right 1 p0 xv))
                     (dk-type! (list '* 1 xv) 'RR)
