                               (ma-prop-with! (list (list 'IN xv sv) (list 'NOT (list 'IN xv sv)))))))
                         (ma-iff-back! iff))
                       (dk-apply! (dk-cite! 'zz-coprime-divides-product) p0 xv k)
                       (ass))))
                 #t)))))
  (if (not (dk-ass!)) (begin (dk-apply! (dk-ctx-form res)) (ass))))
(qed 'prime-set-product)


;;; ==================================================================== from nt7.scm
;;; (47) ALGEBRAIC-NUMBERS ch. 1, Prop. 1.19 (Euler's product formula), the route of the notes through 1.20:
;;;   phi(n) = n prod_{p | n} (1 - 1/p).
;;; Here: the two product identities in the ring C (lemmas A, B), the counting lemma for the intersections of the
;;; sets of multiples (C), the coprime set as the OUT set of inclusion-exclusion (D), and the assembly.
;;; Helper prefix n7-.  It uses ie1 (ie-r, ie-ag, ie-out, ie-int, ie-sum, ie-ring!, ie-op-eq!) and nt6
;;; (nt6-pf, nt6-allprime, prime-set-product).
(define n7-a '(VNB-LAMBDA nza_ NN (- (recip nza_))))
(define n7-b '(VNB-LAMBDA nzo_ NN 1))
(define (n7-pa s) (list 'PROD-RING ie-r n7-a s))
(define (n7-pb s) (list 'PROD-RING ie-r n7-b s))
(define (n7-allnn s) (list 'FORALL 'nzz_ (list 'IMPLIES (list 'IN 'nzz_ s) '(IN nzz_ NN))))
(define (n7-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
;;; (= (ONE ie-r) 1)
(define (n7-one!)
  (dk-have! (list '= (list 'ONE ie-r) 1) (lambda () (mac 'cc-scalar-ring-one) (n7-rfl!))))
;;; the value of a lambda at a typed point: (= (LAM x) VAL)
(define (n7-val! lam x val)
  (dk-have! (list '= (list lam x) val) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))
;;; card of an insertion: (IN (CARD u) NN) and (= (CARD u) (succ (CARD s))), u = s u {x}, x not in s
(define (n7-card-insert! s x)
  (let ((u (list 'UNION s (list 'PAIR x x))))
    (dk-apply! (dk-cite! 'card-insert-curried s) x)
    (dk-apply! (dk-cite! 'ord-succ-nn) (list 'CARD s))
    (fact 'nn-succ-closed (list 'CARD s))
    (dk-have! (list '= (list 'CARD u) (list 'succ (list 'CARD s)))
      (lambda () (subst (list '= (list 'CARD u) (list 'succ_ord (list 'CARD s)))) (subst (list '= (list 'succ_ord (list 'CARD s)) (list 'succ (list 'CARD s)))) (n7-rfl!)))
    (dk-have! (list 'IN (list 'CARD u) 'NN) (lambda () (subst (list '= (list 'CARD u) (list 'succ (list 'CARD s)))) (ass)))))
;;; with allprime(u) in context, u = s u {x}: (= (nt6-pf u) (* (nt6-pf s) x))
(define (n7-pf-insert! s x u)
  (let ((p0 (nt6-pf s)) (p1 (list '* (nt6-pf s) x)))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list nt6-idl 'z_) '(CARR ZZ-RING))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-apply! (dk-ctx-form (nt6-allprime u)) z)
          (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) z)))
          (dk-type! z 'ZZ)
          (subst '(== (CARR ZZ-RING) ZZ))
          (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
    (dk-type! x 'ZZ) (dk-type! p0 'ZZ)
    (dk-apply! (dk-cite! 'prod-ring-insert-ptwise 'ZZ-RING) s x nt6-idl)
    (n7-val! nt6-idl x x)
    (nt4-mul! p0 x)
    (dk-have! (list '= (nt6-pf u) p1)
      (lambda ()
        (subst (list '= (nt6-pf u) (list '(MUL ZZ-RING) p0 (list nt6-idl x))))
        (subst (list '= (list nt6-idl x) x))
        (subst (list '= (list '(MUL ZZ-RING) p0 x) p1))
        (n7-rfl!)))))

;;; A. a product of ones in C
(sp (make-wff (list 'FORALL 'ff (list 'IMPLIES '(IN ff SET) (list 'IMPLIES '(IN (CARD ff) NN)
  (list 'IMPLIES (n7-allnn 'ff) (list '= (n7-pb 'ff) 1)))))))
(dk-peel!)
(ie-ring!)
(n7-one!)
(let ((res (ma-induct! 'ff (lambda (s) (list 'IMPLIES (n7-allnn s) (list '= (n7-pb s) 1)))
             (lambda ()
               (di)
               (dk-cite! 'prod-ring-empty ie-r n7-b)
               (subst (list '= (n7-pb 'EMPTY-SET) (list 'ONE ie-r)))
               (subst (list '= (list 'ONE ie-r) 1))
               (n7-rfl!))
             (lambda (sv xv u ih)
               (di)
               (let ((pr (list 'PAIR xv xv)))
                 (ma-in-singleton! xv) (ma-in-union-right! xv sv pr)
                 (dk-have! (n7-allnn sv)
                   (lambda () (let ((p (dk-di-var!))) (ma-in-union-left! p sv pr) (dk-apply! (dk-ctx-form (n7-allnn u)) p) (ass))))
                 (dk-apply! (dk-ctx-form ih))
                 (dk-apply! (dk-ctx-form (n7-allnn u)) xv)
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list n7-b 'z_) (list 'CARR ie-r))))
                   (lambda ()
                     (let ((z (dk-di-var!)))
                       (dk-apply! (dk-ctx-form (n7-allnn u)) z)
                       (subst (list '== (list 'CARR ie-r) 'CC))
                       (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
                 (dk-apply! (dk-cite! 'prod-ring-insert-ptwise ie-r) sv xv n7-b)
                 (n7-val! n7-b xv 1)
                 (ie-op-eq! 'MUL 1 1)
                 (subst (list '= (n7-pb u) (list (list 'MUL ie-r) (n7-pb sv) (list n7-b xv))))
                 (subst (list '= (n7-pb sv) 1))
                 (subst (list '= (list n7-b xv) 1))
                 (subst (list '= (list (list 'MUL ie-r) 1 1) '(* 1 1)))
                 (crs))))))
  (if (not (dk-ass!)) (begin (dk-apply! (dk-ctx-form res)) (ass))))
(qed 'prod-ring-cc-ones)

;;; B. prod_{p in S} (-1/p) = (-1)^card(S) / P_S, S a finite set of primes
(define (n7-bprop s) (list 'IMPLIES (nt6-allprime s) (list '= (n7-pa s) (list '* (list 'power '(- 1) (list 'CARD s)) (list 'recip (nt6-pf s))))))
(sp (make-wff (list 'FORALL 'ff (list 'IMPLIES '(IN ff SET) (list 'IMPLIES '(IN (CARD ff) NN) (n7-bprop 'ff))))))
(dk-peel!)
(ie-ring!)
(n7-one!)
(nt4-zzr!)
(dk-cite! 'zz-is-commutative-ring)
(let ((res (ma-induct! 'ff n7-bprop
             (lambda ()
               (di)
               (dk-cite! 'prod-ring-empty ie-r n7-a)
               (dk-cite! 'prod-ring-empty 'ZZ-RING nt6-idl)
               (fact 'card-empty)
               (fact 'power-zero '(- 1))
               (dk-type! 1 'CC)
               (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= 1 0)))) (ap-absurd!)))
               (dk-have! '(AND (IN 1 CC) (NOT (= 1 0))))
               (fact 'cc-recip-inverse 1)
               (subst (list '= (n7-pa 'EMPTY-SET) (list 'ONE ie-r)))
               (subst (list '= (list 'ONE ie-r) 1))
               (subst (list '= (nt6-pf 'EMPTY-SET) '(ONE ZZ-RING)))
               (subst '(== (ONE ZZ-RING) 1))
               (subst '(= (CARD EMPTY-SET) 0))
               (subst '(= (power (- 1) 0) 1))
               (subst '(= (* 1 (recip 1)) 1))
               (n7-rfl!))
             (lambda (sv xv u ih)
               (di)
               (let* ((pr (list 'PAIR xv xv)) (p0 (nt6-pf sv)) (pw (list 'power '(- 1) (list 'CARD sv))))
                 (ma-in-singleton! xv) (ma-in-union-right! xv sv pr)
                 (dk-have! (nt6-allprime sv)
                   (lambda () (let ((p (dk-di-var!))) (ma-in-union-left! p sv pr) (dk-apply! (dk-ctx-form (nt6-allprime u)) p) (ass))))
                 (dk-apply! (dk-ctx-form ih))
                 (dk-apply! (dk-ctx-form (nt6-allprime u)) xv)
                 (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) xv)))
                 (dk-split-all! (list (dk-apply! (dk-cite! 'prime-set-product sv))))
                 (n7-pf-insert! sv xv u)
                 (n7-card-insert! sv xv)
                 ;; the typings and non-vanishings in C
                 (fact 'nn-in-rr xv) (fact 'nn-in-rr p0)
                 (dk-type! xv 'CC) (dk-type! p0 'CC)
                 (dk-have! (list 'NOT (list '= xv 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= xv 0) (list '< 1 xv)))) (ap-absurd!)))
                 (dk-have! (list 'NOT (list '= p0 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= p0 0) (list '<= 1 p0)))) (ap-absurd!)))
                 (dk-have! (list 'AND (list 'IN xv 'CC) (list 'NOT (list '= xv 0))))
                 (fact 'cc-recip-closed xv)
                 (dk-have! (list 'AND (list 'IN p0 'CC) (list 'NOT (list '= p0 0))))
                 (fact 'cc-recip-closed p0)
                 (dk-apply! (dk-cite! 'cc-recip-mul) p0 xv)
                 (dk-type! '(- 1) 'CC)
                 (dk-type! (list 'CARD sv) 'NN)
                 (dk-have! (list 'AND '(IN (- 1) CC) (list 'IN (list 'CARD sv) 'NN)))
                 (fact 'power-succ '(- 1) (list 'CARD sv))
                 ;; the pointwise typing of a over u in C
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list n7-a 'z_) (list 'CARR ie-r))))
                   (lambda ()
                     (let ((z (dk-di-var!)))
                       (dk-apply! (dk-ctx-form (nt6-allprime u)) z)
                       (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) z)))
                       (fact 'nn-in-rr z) (dk-type! z 'CC)
                       (dk-have! (list 'NOT (list '= z 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= z 0) (list '< 1 z)))) (ap-absurd!)))
                       (dk-have! (list 'AND (list 'IN z 'CC) (list 'NOT (list '= z 0))))
                       (fact 'cc-recip-closed z)
                       (dk-type! (list '- (list 'recip z)) 'CC)
                       (subst (list '== (list 'CARR ie-r) 'CC))
                       (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
                 (dk-apply! (dk-cite! 'prod-ring-insert-ptwise ie-r) sv xv n7-a)
                 (n7-val! n7-a xv (list '- (list 'recip xv)))
                 (let* ((rp (list 'recip p0)) (rx (list 'recip xv)) (lhs0 (list '* pw rp)) (mx (list '- rx)))
                   (dk-type! lhs0 'CC) (dk-type! mx 'CC)
                   (ie-op-eq! 'MUL lhs0 mx)
                   (subst (list '= (n7-pa u) (list (list 'MUL ie-r) (n7-pa sv) (list n7-a xv))))
                   (subst (list '= (list n7-a xv) mx))
                   (subst (list '= (n7-pa sv) lhs0))
                   (subst (list '= (list (list 'MUL ie-r) lhs0 mx) (list '* lhs0 mx)))
                   (subst (list '= (list 'CARD u) (list 'succ (list 'CARD sv))))
                   (subst (list '= (list 'power '(- 1) (list 'succ (list 'CARD sv))) (list '* '(- 1) pw)))
                   (subst (list '= (nt6-pf u) (list '* p0 xv)))
                   (subst (list '= (list 'recip (list '* p0 xv)) (list '* rp rx)))
                   (let* ((v1 (dk-name! pw 'CC)) (v2 (dk-name! rp 'CC)) (v3 (dk-name! rx 'CC)))
                     (subst (list '= pw v1)) (subst (list '= rp v2)) (subst (list '= rx v3))
                     (crs))))))))
  (if (not (dk-ass!)) (begin (dk-apply! (dk-ctx-form res)) (ass))))
(qed 'prime-set-recip-product)

;;; the family k |-> {multiples of k}, the interval {1..n}, the set of prime divisors of n
(define n7-fam '(VNB-LAMBDA nzf_ NN (SEP nzm_ ZZ (ZZ-DIVIDES nzf_ nzm_))))
(define (n7-famv k) (list 'SEP 'nzm_ 'ZZ (list 'ZZ-DIVIDES k 'nzm_)))
(define (n7-ps n) (list 'SEP 'nzd_ (list 'INTERVAL 1 n) (list 'AND '(IS-PRIME-NAT nzd_) (list 'ZZ-DIVIDES 'nzd_ n))))
;;; k in NN: with (IN w (fam k)) in context land (IN w ZZ), (ZZ-DIVIDES k w)
(define (n7-fam-open! w k)
  (n7-val! n7-fam k (n7-famv k))
  (dk-rewrite-h! (list 'IN w (list n7-fam k)) (list n7-fam k) (n7-famv k))
  (ma-sep-parts! (list 'IN w (n7-famv k))))
;;; k in NN, w in ZZ, k | w in context: land (IN w (fam k))
(define (n7-fam-intro! w k)
  (n7-val! n7-fam k (n7-famv k))
  (dk-have! (list 'IN w (list n7-fam k))
    (lambda () (subst (list '= (list n7-fam k) (n7-famv k))) (in-sep! dk-ass! (lambda () (ass))))))
;;; a prime p in context-typed: (IN p NN), (< 1 p)
(define (n7-prime-nn! p) (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) p))))
;;; w in {1..n} in context: land (IN w NN), (<= 1 w), (<= w n) and (IN w ZZ)
(define (n7-in-interval! w n)
  (ma-iff-parts! (dk-cite! 'interval-membership 1 n w))
  (dk-type! w 'ZZ))

;;; C. for a finite set F of primes dividing n >= 1:  P_F * #{w in 1..n : p | w for all p in F} = n
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n)
  (list 'FORALL 'ff (list 'IMPLIES '(IN ff SET) (list 'IMPLIES '(IN (CARD ff) NN)
    (list 'IMPLIES (nt6-allprime 'ff) (list 'IMPLIES (nt6-alldiv 'ff 'n)
      (list '= (list '* (nt6-pf 'ff) (list 'CARD (ie-int '(INTERVAL 1 n) n7-fam 'ff))) 'n)))))))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(let* ((pf (nt6-pf 'ff)) (xs '(INTERVAL 1 n)) (int (ie-int xs n7-fam 'ff)) (mlt (nt5-mult pf 'n)))
  (dk-split-all! (list (dk-apply! (dk-cite! 'prime-set-product 'ff))))
  (dk-type! 'n 'ZZ)
  (dk-apply! (dk-ctx-form (list 'FORALL 'ntk_ (list 'IMPLIES '(IN ntk_ ZZ) (list 'IMPLIES (nt6-alldiv 'ff 'ntk_) (list 'ZZ-DIVIDES pf 'ntk_))))) 'n)
  ;; the two sets agree
  (ma-ext2! int mlt
    (lambda (w)
      (ma-sep-parts! (list 'IN w int))
      (n7-in-interval! w 'n)
      (in-sep! dk-ass!
        (lambda ()
          (dk-have! (nt6-alldiv 'ff w)
            (lambda ()
              (let ((p (dk-di-var!)))
                (dk-apply! (dk-ctx-form (nt6-allprime 'ff)) p)
                (n7-prime-nn! p)
                (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ 'ff) (list 'IN w (list n7-fam 'iek_))))) p)
                (n7-fam-open! w p)
                (ass))))
          (dk-apply! (dk-ctx-form (list 'FORALL 'ntk_ (list 'IMPLIES '(IN ntk_ ZZ) (list 'IMPLIES (nt6-alldiv 'ff 'ntk_) (list 'ZZ-DIVIDES pf 'ntk_))))) w)
          (ass))))
    (lambda (w)
      (ma-sep-parts! (list 'IN w mlt))
      (n7-in-interval! w 'n)
      (in-sep! dk-ass!
        (lambda ()
          (let ((p (dk-di-var!)))
            (dk-apply! (dk-ctx-form (nt6-allprime 'ff)) p)
            (n7-prime-nn! p)
            (dk-apply! (dk-ctx-form (nt6-alldiv 'ff pf)) p)
            (dk-apply! (dk-cite! 'zz-divides-trans) p pf w)
            (n7-fam-intro! w p)
            (ass))))))
  (subst (list '= int mlt))
  ;; n = P_F c with c a natural
  (let ((c (nt3-dv! pf 'n)))
    (fact 'zz-in-rr c) (fact 'nn-in-rr pf) (fact 'nn-in-rr 'n) (fact 'rr-zero-in)
    (dk-have! (list '<= 0 c)
      (lambda ()
        (dk-have! (list 'AND (list 'IN c 'RR) '(IN 0 RR)))
        (fact 'rr-leq-total c 0)
        (ma-or-split! (list 'OR (list '<= c 0) (list '<= 0 c))
          (list (lambda ()
                  (dk-have! (list '<= 0 pf) (lambda () (dk-ineq! (list '<= 1 pf))))
                  (dk-apply! (dk-cite! 'rr-mul-le-right c 0 pf))
                  (dk-type! (list '* c pf) 'RR) (dk-type! (list '* 0 pf) 'RR)
                  (dk-have! (list '= (list '* c pf) 'n) (lambda () (subst (list '= 'n (list '* pf c))) (crs)))
                  (dk-have! (list '= (list '* 0 pf) 0) (lambda () (crs)))
                  (dk-ineq! (list '<= (list '* c pf) (list '* 0 pf)) (list '= (list '* c pf) 'n) (list '= (list '* 0 pf) 0) '(<= 1 n)
                            (list 'IN (list '* c pf) 'RR) (list 'IN (list '* 0 pf) 'RR)))
                (lambda () (ass))))))
    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) c)
    (dk-apply! (dk-cite! 'multiples-count) pf c)
    (subst (list '= 'n (list '* pf c)))
    (subst (list '= (list 'CARD (nt5-mult pf (list '* pf c))) c))
    (n7-rfl!)))
(qed 'prime-set-multiples-count)

;;; D. the numbers in 1..n coprime to n are those in no set of multiples of a prime divisor of n
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n)
  (list '= (nt3-phiset 'n) (ie-out '(INTERVAL 1 n) n7-fam (n7-ps 'n))))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(dk-type! 'n 'ZZ)
(fact 'nn-in-rr 'n)
(dk-have! '(NOT (= n 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= n 0) '(<= 1 n)))) (ap-absurd!)))
(let* ((xs '(INTERVAL 1 n)) (ps (n7-ps 'n)) (ph (nt3-phiset 'n)) (out (ie-out xs n7-fam ps)))
  (ma-ext2! ph out
    (lambda (w)
      (ma-sep-parts! (list 'IN w ph))
      (n7-in-interval! w 'n)
      (ma-iff-parts! (dk-cite! 'zz-coprime-iff-no-common-prime w 'n))
      (in-sep! dk-ass!
        (lambda ()
          (let ((k (dk-di-var!)))
            (ma-sep-parts! (list 'IN k ps))
            (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT k) (list 'ZZ-DIVIDES k 'n))))
            (n7-prime-nn! k)
            (di)
            (n7-fam-open! w k)
            (dk-apply! (dk-ctx-form (nt5-noprime w 'n)) k)
            (ma-prop-with! (list (list 'ZZ-DIVIDES k w) (list 'NOT (list 'ZZ-DIVIDES k w))))))))
    (lambda (w)
      (ma-sep-parts! (list 'IN w out))
      (n7-in-interval! w 'n)
      (let ((iff (dk-cite! 'zz-coprime-iff-no-common-prime w 'n)))
        (dk-have! (caddr iff)
          (lambda ()
            (di)
            (let ((q (cadr (cadr (dk-goal)))))
              (di) (di) (di)
              (n7-prime-nn! q)
              (dk-type! q 'ZZ)
              (fact 'nn-in-rr q)
              (dk-have! (list '<= q 'n)
                (lambda ()
                  (dk-have! (list 'AND (list 'IN q 'RR) '(IN n RR)))
                  (fact 'rr-leq-total q 'n)
                  (ma-or-split! (list 'OR (list '<= q 'n) (list '<= 'n q))
                    (list (lambda () (ass))
                          (lambda ()
                            (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 'n q))
                              (list (lambda ()
                                      (dk-type! q 'ZZ)
                                      (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
                                      (dk-have! '(< 0 n) (lambda () (dk-ineq! '(<= 1 n))))
                                      (dk-apply! (dk-cite! 'zz-divides-small) q 'n)
                                      (ma-prop-with! (list (list 'ZZ-DIVIDES q 'n) (list 'NOT (list 'ZZ-DIVIDES q 'n)))))
                                    (lambda () (dk-ineq! (list '= 'n q))))))))))
              (dk-have! (list '<= 1 q) (lambda () (dk-ineq! (list '< 1 q))))
              (ma-iff-back! (dk-cite! 'interval-membership 1 'n q))
              (dk-have! (list 'IN q ps) (lambda () (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass)))))))
              (dk-apply! (dk-ctx-form (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ ps) (list 'NOT (list 'IN w (list n7-fam 'iek_)))))) q)
              (n7-fam-intro! w q)
              (ma-prop-with! (list (list 'IN w (list n7-fam q)) (list 'NOT (list 'IN w (list n7-fam q))))))))
        (ma-iff-back! iff))
      (in-sep! dk-ass! (lambda () (ass))))))
(dk-ass!)
(qed 'euler-phi-coprime-out)

;;; E. Prop. 1.19: phi(n) = n prod_{p | n} (1 - 1/p), the product a PROD-RING in C over the prime divisors of n
(define (n7-lam-b-top!)
  ;; beta to a fixpoint where a redex under a SEP binder must stay standing (dk-lam-b! errors on it)
  (let loop ((k 0))
    (let ((g0 (dk-goal)))
      (lam-b)
      (if (and (< k 4) (not (sequent-node-grounded? (proof-state-focus *ps*))) (not (equal? g0 (dk-goal)))) (loop (+ k 1))))))
(define (n7-q ps) (list 'VNB-LAMBDA 'nzq_ ps '(- 1 (recip nzq_))))
(define (n7-ne0! z lo)
  ;; z typed in RR, (LO z) in context with lo the strict/weak bound 1: land (NOT (= z 0))
  (dk-have! (list 'NOT (list '= z 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= z 0) (list lo 1 z)))) (ap-absurd!))))
;;; allprime(s) in context: the pointwise typing of a over s in the carrier of C
(define (n7-a-ptw! s)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list 'IN (list n7-a 'z_) (list 'CARR ie-r))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! (dk-ctx-form (nt6-allprime s)) z)
        (n7-prime-nn! z)
        (dk-type! z 'CC) (fact 'nn-in-rr z)
        (n7-ne0! z '<)
        (dk-have! (list 'AND (list 'IN z 'CC) (list 'NOT (list '= z 0))))
        (fact 'cc-recip-closed z)
        (dk-type! (list '- (list 'recip z)) 'CC)
        (subst (list '== (list 'CARR ie-r) 'CC))
        (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass)))))))
;;; s in POWER(ps), ps a finite set of primes dividing n: s finite, allprime(s), alldiv(s, n), the product typed
(define (n7-sub-facts! s ps n)
  (ie-power-parts! s ps)
  (dk-have! (nt6-allprime s)
    (lambda () (let ((p (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ s) (list 'IN 'iez_ ps)))) p)
                 (dk-apply! (dk-ctx-form (nt6-allprime ps)) p) (ass))))
  (dk-have! (nt6-alldiv s n)
    (lambda () (let ((p (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ s) (list 'IN 'iez_ ps)))) p)
                 (dk-apply! (dk-ctx-form (nt6-alldiv ps n)) p) (ass))))
  (n7-a-ptw! s)
  (dk-apply! (dk-cite! 'prod-ring-type-ptwise ie-r) s n7-a)
  (dk-have! (list 'IN (n7-pa s) 'CC) (lambda () (subst (list '== 'CC (list 'CARR ie-r))) (ass))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n)
  (list '= '(EULER-PHI n) (list '* 'n (list 'PROD-RING ie-r (n7-q (n7-ps 'n)) (n7-ps 'n)))))))))
(dk-peel!)
(ie-ring!)
(n7-one!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(dk-type! 'n 'ZZ) (dk-type! 'n 'CC) (fact 'nn-in-rr 'n)
(let* ((xs '(INTERVAL 1 n)) (ps (n7-ps 'n)) (pw (list 'POWER ps))
       (pq (list 'PROD-RING ie-r (n7-q ps) ps))
       (sl (list 'VNB-LAMBDA 'kv_ ps (list (list 'ADD ie-r) (list n7-a 'kv_) (list n7-b 'kv_))))
       (tl (list 'VNB-LAMBDA 'sv_ pw (list (list 'MUL ie-r) (list 'PROD-RING ie-r n7-a 'sv_) (list 'PROD-RING ie-r n7-b (list 'DIFFERENCE ps 'sv_)))))
       (gl (list 'VNB-LAMBDA 'nzs_ pw (n7-pa 'nzs_)))
       (fs (list 'FINSUM ie-ag gl pw))
       (tt (list 'VNB-LAMBDA 'z pw (list (list 'MUL ie-r) 'n (list gl 'z))))
       (cra (list 'COMMUTATIVE-RING-ADDITIVE-AG ie-r)))
  ;; the finite sets
  (fact 'interval-in-set 1 'n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  (nt3-fin! ps xs)
  (dk-have! (nt6-allprime ps)
    (lambda () (let ((p (dk-di-var!))) (ma-sep-parts! (list 'IN p ps)) (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT p) (list 'ZZ-DIVIDES p 'n)))) (ass))))
  (dk-have! (nt6-alldiv ps 'n)
    (lambda () (let ((p (dk-di-var!))) (ma-sep-parts! (list 'IN p ps)) (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT p) (list 'ZZ-DIVIDES p 'n)))) (ass))))
  (fact 'power-set ps)
  (dk-have! (list 'AND (list 'IN ps 'SET) (list 'IN (list 'CARD ps) 'NN))) (fact 'card-power-nn ps)
  ;; phi(n) = card OUT = the inclusion-exclusion sum
  (mac 'EULER-PHI)
  (dk-apply! (dk-cite! 'euler-phi-coprime-out) 'n)
  (subst (list '= (nt3-phiset 'n) (ie-out xs n7-fam ps)))
  (dk-apply! (dk-cite! 'inclusion-exclusion ps) n7-fam xs)
  (subst (list '= (list 'CARD (ie-out xs n7-fam ps)) (ie-sum xs n7-fam ps)))
  ;; the right side: prod (1 - 1/p) = prod ((-1/p) + 1) = sum_S prod_S (-1/p) prod_{ps \ S} 1 = sum_S prod_S (-1/p)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ps) (list '= (list (n7-q ps) 'z_) (list sl 'z_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! (dk-ctx-form (nt6-allprime ps)) z)
        (n7-prime-nn! z)
        (dk-type! z 'CC) (fact 'nn-in-rr z)
        (n7-ne0! z '<)
        (dk-have! (list 'AND (list 'IN z 'CC) (list 'NOT (list '= z 0))))
        (fact 'cc-recip-closed z)
        (dk-type! (list '- (list 'recip z)) 'CC)
        (let ((leaf (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? leaf))
              (begin
                (ie-op-eq! 'ADD (list '- (list 'recip z)) 1)
                (subst (list '= (list (list 'ADD ie-r) (list '- (list 'recip z)) 1) (list '+ (list '- (list 'recip z)) 1)))
                (let ((v (dk-name! (list 'recip z) 'CC)))
                  (subst (list '= (list 'recip z) v))
                  (crs))))))))
  (dk-apply! (dk-cite! 'prod-ring-congruence-q ie-r) ps (n7-q ps) sl)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ps) (list 'IN (list n7-b 'z_) (list 'CARR ie-r))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! (dk-ctx-form (nt6-allprime ps)) z)
        (n7-prime-nn! z)
        (subst (list '== (list 'CARR ie-r) 'CC))
        (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
  (n7-a-ptw! ps)
  (dk-apply! (dk-cite! 'prod-of-sums-ptwise ie-r) ps n7-a n7-b)
  (fact 'cra-is-rag ie-r)
  ;; the summands: prod_S a * prod_{ps \ S} 1 = prod_S a
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z pw) (list '= (list tl 'z) (list gl 'z))))
    (lambda ()
      (let ((s (dk-di-var!)))
        (n7-sub-facts! s ps 'n)
        (let ((d (list 'DIFFERENCE ps s)))
          (dk-apply! (dk-cite! 'difference-in-power ps) s)
          (ie-power-parts! d ps)
          (dk-have! (n7-allnn d)
            (lambda () (let ((p (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ d) (list 'IN 'iez_ ps)))) p)
                         (dk-apply! (dk-ctx-form (nt6-allprime ps)) p) (n7-prime-nn! p) (ass))))
          (dk-apply! (dk-cite! 'prod-ring-cc-ones d))
          (let ((leaf (proof-state-focus *ps*)))
            (dk-lam-b!)
            (if (not (sequent-node-grounded? leaf))
                (begin
                  (subst (list '= (n7-pb d) 1))
                  (ie-op-eq! 'MUL (n7-pa s) 1)
                  (subst (list '= (list (list 'MUL ie-r) (n7-pa s) 1) (list '* (n7-pa s) 1)))
                  (let ((v (dk-name! (n7-pa s) 'CC)))
                    (subst (list '= (n7-pa s) v))
                    (crs)))))))))
  (dk-apply! (dk-cite! 'finsum-congruence-q ie-ag) pw tl gl)
  ;; n * sum_S G(S) = sum_S n * G(S)
  (dk-have! (list 'IN 'n (list 'CARR ie-r)) (lambda () (subst (list '== (list 'CARR ie-r) 'CC)) (ass)))
  (dk-have! (list 'IN gl (list 'FUN pw (list 'CARR ie-r)))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((s (dk-di-var!))) (n7-sub-facts! s ps 'n) (ass)))
        (lambda () (ass)))))
  (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen ie-r) 'n pw gl)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z pw) (list 'IN (list gl 'z) (list 'CARR ie-ag))))
    (lambda ()
      (let ((s (dk-di-var!)))
        (n7-sub-facts! s ps 'n)
        (subst (list '= (list 'CARR ie-ag) 'CC))
        (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
  (dk-apply! (dk-cite! 'finsum-type-ptwise ie-ag) pw gl)
  (dk-have! (list 'IN fs 'CC) (lambda () (subst (list '= 'CC (list 'CARR ie-ag))) (ass)))
  (ie-op-eq! 'MUL 'n fs)
  ;; rewrite the right side
  (subst (list '== pq (list 'PROD-RING ie-r sl ps)))
  (subst (list '= (list 'PROD-RING ie-r sl ps) (list 'FINSUM cra tl pw)))
  (subst (list '== cra ie-ag))
  (subst (list '== (list 'FINSUM ie-ag tl pw) fs))
  (subst (list '= (list '* 'n fs) (list (list 'MUL ie-r) 'n fs)))
  (subst (list '= (list (list 'MUL ie-r) 'n fs) (list 'FINSUM ie-ag tt pw)))
  ;; the left side, summand by summand: (-1)^|F| #INT(F) = n (-1)^|F| / P_F
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z pw) (list '= (list (ie-lam xs n7-fam pw) 'z) (list tt 'z))))
    (lambda ()
      (let* ((f (dk-di-var!)) (pf (nt6-pf f)) (int (ie-int xs n7-fam f)) (ci (list 'CARD int))
             (pp (list 'power '(- 1) (list 'CARD f))) (rp (list 'recip pf)))
        (n7-sub-facts! f ps 'n)
        (dk-split-all! (list (dk-apply! (dk-cite! 'prime-set-product f))))
        (dk-apply! (dk-cite! 'prime-set-recip-product f))
        (dk-apply! (dk-cite! 'prime-set-multiples-count 'n) f)
        (ie-fin! int xs)
        (dk-type! ci 'CC) (dk-type! pf 'CC) (dk-type! (list 'CARD f) 'NN)
        (fact 'nn-in-rr pf)
        (n7-ne0! pf '<=)
        (dk-have! (list 'AND (list 'IN pf 'CC) (list 'NOT (list '= pf 0))))
        (fact 'cc-recip-closed pf) (fact 'cc-recip-inverse pf)
        (cp-type!* pp)
        (cp-type!* (list '* pp rp))
        (let ((leaf (proof-state-focus *ps*)))
          (n7-lam-b-top!)
          (if (not (sequent-node-grounded? leaf))
              (begin
                (subst (list '= (n7-pa f) (list '* pp rp)))
                (ie-op-eq! 'MUL 'n (list '* pp rp))
                (subst (list '= (list (list 'MUL ie-r) 'n (list '* pp rp)) (list '* 'n (list '* pp rp))))
                (let* ((vr (dk-name! rp 'CC)) (vp (dk-name! pp 'CC)) (vc (dk-name! ci 'CC)) (vf (dk-name! pf 'CC)))
                  (dk-have! (list '= (list '* vf vc) 'n)
                    (lambda () (subst (list '= vf pf)) (subst (list '= vc ci)) (ass)))
                  (dk-have! (list '= (list '* vf vr) 1)
                    (lambda () (subst (list '= vf pf)) (subst (list '= vr rp)) (ass)))
                  (subst (list '= rp vr)) (subst (list '= pp vp)) (subst (list '= ci vc))
                  (subst (list '= 'n (list '* vf vc)))
                  (dk-have! (list '= (list '* (list '* vf vc) (list '* vp vr)) (list '* (list '* vp vc) (list '* vf vr))) (lambda () (crs)))
                  (subst (list '= (list '* (list '* vf vc) (list '* vp vr)) (list '* (list '* vp vc) (list '* vf vr))))
                  (subst (list '= (list '* vf vr) 1))
                  (crs))))))))
  (dk-apply! (dk-cite! 'finsum-congruence-q ie-ag) pw (ie-lam xs n7-fam pw) tt)
  (subst (list '== (ie-sum xs n7-fam ps) (list 'FINSUM ie-ag tt pw)))
  (n7-rfl!))
(qed 'euler-phi-product)

