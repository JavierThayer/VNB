;;; cvx-hull.scm -- the join of a convex set to a point is convex; the convex hull (the finite
;;; convex combinations, CONV-HULL) contains E, lies in VEC, is convex and lies in every convex
;;; set containing E (compact-groups notes, Lemma 1.12, the convexity half).
;;; Agent ISOM, 2026-10-26.  Helper prefix: cvh-.  Library: linear-algebra.

(define (cvh-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cvh-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (cvh-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (cvh-rhs! iff) (dk-split-all! (list (dk-meta-iff-r! iff))))
(define (cvh-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (cvh-act r x) (list '(ACT m) r x))
(define (cvh-add x y) (list '(VADD m) x y))
(define (cvh-cvx x y t) (cvh-add (cvh-act (list '- 1 t) x) (cvh-act t y)))
(define (cvh-cvx-in! x y t)              ; x, y in VEC, t in RR: the combination in VEC
  (dk-real! t) (dk-real! (list '- 1 t))
  (dk-cite! 'nvs-act-in-vec 'm (list '- 1 t) x)
  (dk-cite! 'nvs-act-in-vec 'm t y)
  (dk-cite! 'nvs-vadd-in-vec 'm (cvh-act (list '- 1 t) x) (cvh-act t y)))
(define (cvh-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (cvh-forall (cdr vs) body))))
(define (cvh-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (cvh-implies (cdr hs) concl))))
(define (cvh-unit v) (list (list 'IN v 'RR) (list '<= 0 v) (list '<= v 1)))
;; (FORSOME y (AND (IN y CLS) (FORSOME t (AND t in [0,1] (= z (cvx y a t)))))) -- skolemise: returns (y t)
(define (cvh-open-comb! ex)
  (let* ((y (dk-skolem! ex))
         (_ (cvh-split-if! (lambda (h) (dk-contains? h y))))
         (t (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the coefficient"))))
    (cvh-split-if! (lambda (h) (dk-contains? h t)))
    (cvh-split-if! (lambda (h) (dk-contains? h t)))
    (cvh-split-if! (lambda (h) (dk-contains? h t)))
    (list y t)))

;;; ---- CONV-JOIN ----
(define cvh-J '(CONV-JOIN m C a))
(define cvh-Jsep '(SEP cjz_ (VEC m) (FORSOME cjy_ (AND (IN cjy_ C)
     (FORSOME cjt_ (AND (IN cjt_ RR) (AND (<= 0 cjt_) (AND (<= cjt_ 1)
       (= cjz_ ((VADD m) ((ACT m) (- 1 cjt_) cjy_) ((ACT m) cjt_ a)))))))))))
(sp (make-wff (cvh-forall '(m C a) (list '== cvh-J cvh-Jsep))))
(dk-peel!)
(mac 'CONV-JOIN)
(qrfl)
(qed 'conv-join-unfold)
(topic! 'conv-join-unfold 'plumbing)

(sp (make-wff (cvh-forall '(m C a z) (cvh-implies (list (list 'IN 'z cvh-J))
   (list 'AND '(IN z (VEC m)) (list 'FORSOME 'y (list 'AND '(IN y C) (list 'FORSOME 't (list 'AND '(IN t RR) (list 'AND '(<= 0 t) (list 'AND '(<= t 1)
     (list '= 'z (cvh-cvx 'y 'a 't)))))))))))))
(dk-peel!)
(dk-cite! 'conv-join-unfold 'm 'C 'a)
(dk-rewrite-h! (list 'IN 'z cvh-J) cvh-J cvh-Jsep)
(dk-landed (lambda () (sep-me (list 'IN 'z cvh-Jsep))))
(dk-conj-close! (lambda () (cvh-ass!)))
(qed 'conv-join-elim)
(topic! 'conv-join-elim 'algebra)

(sp (make-wff (cvh-forall '(m C a y t) (cvh-implies (append (list '(IS-NORMED-VECTOR-SPACE m) '(IN y (VEC m)) '(IN a (VEC m)) '(IN y C)) (cvh-unit 't))
   (list 'IN (cvh-cvx 'y 'a 't) cvh-J)))))
(dk-peel!)
(cvh-cvx-in! 'y 'a 't)
(mac 'CONV-JOIN)
(in-sep! (lambda () (cvh-ass!))
         (lambda () (ew 'y) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME) (begin (ew 't) (dk-conj-close! cvh-ass-rfl!)) (cvh-ass!))))))
(qed 'conv-join-intro)
(topic! 'conv-join-intro 'algebra)

;;; ---- the join of a convex set to a point is convex ----
(define (cvh-convex-clause K)
  (list 'FORALL 'sxa_ (list 'IMPLIES (list 'IN 'sxa_ K) (list 'FORALL 'sxb_ (list 'IMPLIES (list 'IN 'sxb_ K)
    (list 'FORALL 'sxt_ (list 'IMPLIES '(IN sxt_ RR) (list 'IMPLIES '(<= 0 sxt_) (list 'IMPLIES '(<= sxt_ 1)
      (list 'IN '((VADD m) ((ACT m) (- 1 sxt_) sxa_) ((ACT m) sxt_ sxb_)) K))))))))))
(sp (make-wff (cvh-forall '(m C a) (cvh-implies (list '(IS-NORMED-VECTOR-SPACE m) '(IS-CONVEX-SUBSET m C) '(IN a (VEC m)))
   (list 'IS-CONVEX-SUBSET 'm cvh-J)))))
(dk-peel!)
(cvh-rhs! (dk-cite! 'is-convex-subset 'm 'C))
(let ((iff (dk-cite! 'is-convex-subset 'm cvh-J)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'SUBSET)
             (begin (mac 'subset-def)
                    (let ((z (cvh-peel-var!)))
                      (dk-split-all! (list (dk-cite! 'conv-join-elim 'm 'C 'a z)))
                      (cvh-ass!)))
             (let* ((pl (dk-peel!))
                    (ins (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cvh-J))) pl))
                    (p1 (cadr (car ins))) (p2 (cadr (cadr ins)))
                    (s (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl)))))
               (dk-split-all! (list (dk-cite! 'conv-join-elim 'm 'C 'a p1)))
               (let* ((yt1 (cvh-open-comb! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h p1))) "p1's combination")))
                      (y1 (car yt1)) (t1 (cadr yt1)))
                 (dk-split-all! (list (dk-cite! 'conv-join-elim 'm 'C 'a p2)))
                 (let* ((yt2 (cvh-open-comb! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h p2))) "p2's combination")))
                        (y2 (car yt2)) (t2 (cadr yt2)))
                   (dk-cite! 'subset-mem-fwd 'C '(VEC m) y1)
                   (dk-cite! 'subset-mem-fwd 'C '(VEC m) y2)
                   (let ((co (dk-cite! 'convex-regroup-coefficients s t1 t2)))
                     (dk-split-all! (list co))
                     (let* ((lam (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'lam))) "the lam")))
                            (_ (cvh-split-if! (lambda (h) (dk-contains? h lam))))
                            (_2 (cvh-split-if! (lambda (h) (dk-contains? h lam))))
                            (_3 (cvh-split-if! (lambda (h) (dk-contains? h lam))))
                            (_4 (cvh-split-if! (lambda (h) (dk-contains? h lam))))
                            (T (list '+ (list '* (list '- 1 s) t1) (list '* s t2)))
                            (Y (cvh-cvx y1 y2 lam)))
                       (dk-apply! (dk-ctx-form (cvh-convex-clause 'C)) y1 y2 lam)
                       (dk-cite! 'subset-mem-fwd 'C '(VEC m) Y)
                       (dk-real! T)
                       (dk-cite! 'conv-join-intro 'm 'C 'a Y T)
                       (dk-cite! 'convex-combination-regroup 'm y1 y2 'a s t1 t2 lam)
                       (subst (list '= p1 (cvh-cvx y1 'a t1)))
                       (subst (list '= p2 (cvh-cvx y2 'a t2)))
                       (subst (list '= (cvh-cvx (cvh-cvx y1 'a t1) (cvh-cvx y2 'a t2) s) (cvh-cvx Y 'a T)))
                       (cvh-ass!)))))))))))
  (dk-meta-iff-l! iff)
  (cvh-ass!))
(qed 'conv-join-convex)
(topic! 'conv-join-convex 'algebra)

;;; ---- the levels and the hull ----
(define (cvh-L n) (list 'CONV-LEVEL 'm 'E n))
(define cvh-H '(CONV-HULL m E))
(define (cvh-Lsep n)
  (list 'SEP 'cvz_ '(VEC m) (list 'FORSOME 'cvx_ (list 'AND (list 'IN 'cvx_ (cvh-L n)) (list 'FORSOME 'cvy_ (list 'AND '(IN cvy_ E)
     (list 'FORSOME 'cvt_ (list 'AND '(IN cvt_ RR) (list 'AND '(<= 0 cvt_) (list 'AND '(<= cvt_ 1)
       '(= cvz_ ((VADD m) ((ACT m) (- 1 cvt_) cvx_) ((ACT m) cvt_ cvy_)))))))))))))
(define (cvh-vecset!)
  (if (not (dk-asm? '(IN (VEC m) SET)))
      (dk-have! '(IN (VEC m) SET)
        (lambda () (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-normed-vector-space 'm)))) (cvh-ass!)))))
(define cvh-hyps (list '(IS-NORMED-VECTOR-SPACE m) '(SUBSET E (VEC m))))
(define (cvh-lset! n) (dk-cite! 'conv-level-is-set n 'm 'E))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (cvh-forall '(m E) (cvh-implies cvh-hyps (list 'IN (cvh-L 'n) 'SET)))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cvh-vecset!)
  (dk-cite! 'conv-level-zero 'm 'E)
  (dk-cite! 'subclass-of-set-is-set 'E '(VEC m))
  (subst (list '= (cvh-L 0) 'E))
  (cvh-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cvh-vecset!)
  (dk-apply! ih 'm 'E)
  (dk-cite! 'conv-level-succ 'm 'E n)
  (subst (list '= (cvh-L (list 'succ n)) (cvh-Lsep n)))
  (dk-close-all! (lambda () (sep-set))))
(qed 'conv-level-is-set)
(topic! 'conv-level-is-set 'algebra)

(sp (make-wff (cvh-forall '(m E n z) (cvh-implies (append cvh-hyps (list '(IN n NN) (list 'IN 'z (cvh-L '(succ n)))))
   (list 'AND '(IN z (VEC m)) (list 'FORSOME 'x (list 'AND (list 'IN 'x (cvh-L 'n)) (list 'FORSOME 'y (list 'AND '(IN y E)
     (list 'FORSOME 't (list 'AND '(IN t RR) (list 'AND '(<= 0 t) (list 'AND '(<= t 1) (list '= 'z (cvh-cvx 'x 'y 't)))))))))))))))
(dk-peel!)
(cvh-lset! 'n)
(dk-cite! 'conv-level-succ 'm 'E 'n)
(dk-rewrite-h! (list 'IN 'z (cvh-L '(succ n))) (cvh-L '(succ n)) (cvh-Lsep 'n))
(dk-landed (lambda () (sep-me (list 'IN 'z (cvh-Lsep 'n)))))
(dk-conj-close! (lambda () (cvh-ass!)))
(qed 'conv-level-succ-elim)
(topic! 'conv-level-succ-elim 'algebra)

(sp (make-wff (cvh-forall '(m E n x y t) (cvh-implies (append cvh-hyps (list '(IN n NN) (list 'IN 'x (cvh-L 'n)) '(IN x (VEC m)) '(IN y E) '(IN y (VEC m))) (cvh-unit 't))
   (list 'IN (cvh-cvx 'x 'y 't) (cvh-L '(succ n)))))))
(dk-peel!)
(cvh-lset! 'n)
(cvh-cvx-in! 'x 'y 't)
(dk-cite! 'conv-level-succ 'm 'E 'n)
(subst (list '= (cvh-L '(succ n)) (cvh-Lsep 'n)))
(in-sep! (lambda () (cvh-ass!))
         (lambda () (ew 'x)
                    (dk-conj-close!
                     (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                    (begin (ew 'y)
                                           (dk-conj-close!
                                            (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                                           (begin (ew 't) (dk-conj-close! cvh-ass-rfl!))
                                                           (cvh-ass!)))))
                                    (cvh-ass!))))))
(qed 'conv-level-succ-intro)
(topic! 'conv-level-succ-intro 'algebra)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (cvh-forall '(m E) (cvh-implies cvh-hyps (list 'SUBSET (cvh-L 'n) '(VEC m))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'conv-level-zero 'm 'E)
  (subst (list '= (cvh-L 0) 'E))
  (cvh-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-cite! 'nn-succ-closed n)
  (cvh-lset! (list 'succ n))
  (mac 'subset-def)
  (let ((z (cvh-peel-var!)))
    (dk-split-all! (list (dk-cite! 'conv-level-succ-elim 'm 'E n z)))
    (cvh-ass!)))
(qed 'conv-level-sub-vec)
(topic! 'conv-level-sub-vec 'algebra)

(define cvh-Hbu '(BIG-UNION cvn_ NN (CONV-LEVEL m E cvn_)))
(sp (make-wff (cvh-forall '(m E) (list '== cvh-H cvh-Hbu))))
(dk-peel!)
(mac 'CONV-HULL)
(qrfl)
(qed 'conv-hull-unfold)
(topic! 'conv-hull-unfold 'plumbing)

(sp (make-wff (cvh-forall '(m E k z) (cvh-implies (list '(IN k NN) (list 'IN 'z (cvh-L 'k))) (list 'IN 'z cvh-H)))))
(dk-peel!)
(mac 'CONV-HULL)
(dk-each-leaf! (lambda () (bu-mi 'k)) (lambda () (cvh-ass!)))
(qed 'conv-hull-intro)
(topic! 'conv-hull-intro 'algebra)

(sp (make-wff (cvh-forall '(m E z) (cvh-implies (list (list 'IN 'z cvh-H)) (list 'FORSOME 'k (list 'AND '(IN k NN) (list 'IN 'z (cvh-L 'k))))))))
(dk-peel!)
(dk-cite! 'conv-hull-unfold 'm 'E)
(dk-rewrite-h! (list 'IN 'z cvh-H) cvh-H cvh-Hbu)
(let* ((landed (dk-landed (lambda () (bu-me (list 'IN 'z cvh-Hbu)))))
       (kin (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))))
  (ew (cadr kin))
  (dk-conj-close! (lambda () (cvh-ass!))))
(qed 'conv-hull-elim)
(topic! 'conv-hull-elim 'algebra)

(define (cvh-helim! z)                   ; z in H: returns k with z in L(k)
  (let ((k (dk-skolem! (dk-cite! 'conv-hull-elim 'm 'E z))))
    (cvh-split-if! (lambda (h) (and (dk-contains? h k) (dk-contains? h z))))
    (cvh-lset! k)
    k))
(sp (make-wff (cvh-forall '(m E) (cvh-implies cvh-hyps (list 'SUBSET 'E cvh-H)))))
(dk-peel!)
(fact 'nn-zero-in)
(cvh-lset! 0)
(dk-cite! 'conv-level-zero 'm 'E)
(mac 'subset-def)
(let ((z (cvh-peel-var!)))
  (dk-have! (list 'IN z (cvh-L 0)) (lambda () (subst (list '= (cvh-L 0) 'E)) (cvh-ass!)))
  (dk-cite! 'conv-hull-intro 'm 'E 0 z)
  (cvh-ass!))
(qed 'conv-hull-contains)
(topic! 'conv-hull-contains 'algebra)

(sp (make-wff (cvh-forall '(m E) (cvh-implies cvh-hyps (list 'SUBSET cvh-H '(VEC m))))))
(dk-peel!)
(mac 'subset-def)
(let* ((z (cvh-peel-var!)) (k (cvh-helim! z)))
  (dk-cite! 'conv-level-sub-vec k 'm 'E)
  (dk-cite! 'subset-mem-fwd (cvh-L k) '(VEC m) z)
  (cvh-ass!))
(qed 'conv-hull-sub-vec)
(topic! 'conv-hull-sub-vec 'algebra)

;;; ---- the hull is convex ----
(sp (make-wff (cvh-forall '(m u y) (cvh-implies (list '(IS-NORMED-VECTOR-SPACE m) '(IN u (VEC m)) '(IN y (VEC m)))
   (list '= (cvh-cvx 'u 'y 0) 'u)))))
(dk-peel!)
(dk-have! '(= (- 1 0) 1) (lambda () (crs)))
(subst '(= (- 1 0) 1))
(dk-cite! 'nvs-one-act 'm 'u)
(dk-cite! 'nvs-zero-act 'm 'y)
(dk-cite! 'nvs-vzero-right 'm 'u)
(subst (list '= (cvh-act 1 'u) 'u))
(subst (list '= (cvh-act 0 'y) '(VZERO m)))
(subst (list '= (cvh-add 'u '(VZERO m)) 'u))
(if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))
(qed 'convex-combination-at-zero)
(topic! 'convex-combination-at-zero 'algebra)

(define (cvh-open3! ex)                  ; FORSOME x .. FORSOME y .. FORSOME t ..: returns (x y t)
  (let* ((x (dk-skolem! ex))
         (_ (cvh-split-if! (lambda (h) (dk-contains? h x))))
         (yt (cvh-open-comb! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x))) "the second point"))))
    (cons x yt)))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (cvh-forall '(m E) (cvh-implies cvh-hyps
   (cvh-forall '(u) (cvh-implies (list (list 'IN 'u cvh-H))
     (cvh-forall '(w) (cvh-implies (list (list 'IN 'w (cvh-L 'k)))
       (cvh-forall '(s) (cvh-implies (cvh-unit 's) (list 'IN (cvh-cvx 'u 'w 's) cvh-H)))))))))))))
(define (cvh-u-vec!)
  (dk-cite! 'conv-hull-sub-vec 'm 'E)
  (dk-cite! 'subset-mem-fwd cvh-H '(VEC m) 'u))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'nn-zero-in)
  (cvh-lset! 0)
  (dk-cite! 'conv-level-zero 'm 'E)
  (dk-rewrite-h! (list 'IN 'w (cvh-L 0)) (cvh-L 0) 'E)
  (cvh-u-vec!)
  (dk-cite! 'subset-mem-fwd 'E '(VEC m) 'w)
  (let ((j (cvh-helim! 'u)))
    (dk-cite! 'conv-level-succ-intro 'm 'E j 'u 'w 's)
    (dk-cite! 'nn-succ-closed j)
    (dk-cite! 'conv-hull-intro 'm 'E (list 'succ j) (cvh-cvx 'u 'w 's))
    (cvh-ass!))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cvh-lset! n)
  (cvh-u-vec!)
  (dk-split-all! (list (dk-cite! 'conv-level-succ-elim 'm 'E n 'w)))
  (let* ((xyt (cvh-open3! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'w))) "w's combination")))
         (x (car xyt)) (y (cadr xyt)) (t (caddr xyt)))
    (dk-cite! 'conv-level-sub-vec n 'm 'E)
    (dk-cite! 'subset-mem-fwd (cvh-L n) '(VEC m) x)
    (dk-cite! 'subset-mem-fwd 'E '(VEC m) y)
    (fact 'rr-zero-in)
    (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
    (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (dk-split-all! (list (dk-cite! 'convex-regroup-coefficients 's 0 t)))
    (let* ((lam (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'lam))) "the lam")))
           (_ (begin (cvh-split-if! (lambda (h) (dk-contains? h lam))) (cvh-split-if! (lambda (h) (dk-contains? h lam)))
                     (cvh-split-if! (lambda (h) (dk-contains? h lam))) (cvh-split-if! (lambda (h) (dk-contains? h lam)))))
           (cTT (list '+ (list '* '(- 1 s) 0) (list '* 's t)))
           (ux (cvh-cvx 'u x lam))
           (eqn (list '= (cvh-cvx (cvh-cvx 'u y 0) (cvh-cvx x y t) 's) (cvh-cvx ux y cTT))))
      (dk-cite! 'convex-combination-regroup 'm 'u x y 's 0 t lam)
      (dk-cite! 'convex-combination-at-zero 'm 'u y)
      (dk-rewrite-h! eqn (cvh-cvx 'u y 0) 'u)
      (dk-apply! ih 'm 'E 'u x lam)
      (let ((j (cvh-helim! ux)))
        (cvh-cvx-in! 'u x lam)
        (dk-real! cTT)
        (dk-cite! 'conv-level-succ-intro 'm 'E j ux y cTT)
        (dk-cite! 'nn-succ-closed j)
        (dk-cite! 'conv-hull-intro 'm 'E (list 'succ j) (cvh-cvx ux y cTT))
        (subst (list '= 'w (cvh-cvx x y t)))
        (subst (list '= (cvh-cvx 'u (cvh-cvx x y t) 's) (cvh-cvx ux y cTT)))
        (cvh-ass!)))))
(qed 'conv-hull-convex-step)
(topic! 'conv-hull-convex-step 'algebra)

(sp (make-wff (cvh-forall '(m E) (cvh-implies cvh-hyps (list 'IS-CONVEX-SUBSET 'm cvh-H)))))
(dk-peel!)
(dk-cite! 'conv-hull-sub-vec 'm 'E)
(let ((iff (dk-cite! 'is-convex-subset 'm cvh-H)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'FORALL)
             (let* ((pl (dk-peel!))
                    (ins (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cvh-H))) pl))
                    (p1 (cadr (car ins))) (p2 (cadr (cadr ins)))
                    (s (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl))))
                    (k (cvh-helim! p2)))
               (dk-cite! 'conv-hull-convex-step k 'm 'E p1 p2 s)
               (cvh-ass!))
             (cvh-ass!))))))
  (dk-meta-iff-l! iff)
  (cvh-ass!))
(qed 'conv-hull-convex)
(topic! 'conv-hull-convex 'algebra)

;;; ---- and the smallest convex set containing E ----
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (cvh-forall '(m E CK) (cvh-implies (append cvh-hyps (list '(IS-CONVEX-SUBSET m CK) '(SUBSET E CK)))
   (list 'SUBSET (cvh-L 'k) 'CK)))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'conv-level-zero 'm 'E)
  (subst (list '= (cvh-L 0) 'E))
  (cvh-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-cite! 'nn-succ-closed n)
  (cvh-lset! (list 'succ n))
  (cvh-lset! n)
  (dk-apply! ih 'm 'E 'CK)
  (cvh-rhs! (dk-cite! 'is-convex-subset 'm 'CK))
  (mac 'subset-def)
  (let* ((z (cvh-peel-var!)))
    (dk-split-all! (list (dk-cite! 'conv-level-succ-elim 'm 'E n z)))
    (let* ((xyt (cvh-open3! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h z))) "z's combination")))
           (x (car xyt)) (y (cadr xyt)) (t (caddr xyt)))
      (dk-cite! 'subset-mem-fwd (cvh-L n) 'CK x)
      (dk-cite! 'subset-mem-fwd 'E 'CK y)
      (dk-apply! (dk-ctx-form (cvh-convex-clause 'CK)) x y t)
      (subst (list '= z (cvh-cvx x y t)))
      (cvh-ass!))))
(qed 'conv-level-in-convex)
(topic! 'conv-level-in-convex 'algebra)

(sp (make-wff (cvh-forall '(m E CK) (cvh-implies (append cvh-hyps (list '(IS-CONVEX-SUBSET m CK) '(SUBSET E CK)))
   (list 'SUBSET cvh-H 'CK)))))
(dk-peel!)
(mac 'subset-def)
(let* ((z (cvh-peel-var!)) (k (cvh-helim! z)))
  (dk-cite! 'conv-level-in-convex k 'm 'E 'CK)
  (dk-cite! 'subset-mem-fwd (cvh-L k) 'CK z)
  (cvh-ass!))
(qed 'conv-hull-least)
(topic! 'conv-hull-least 'algebra)
