;;; cg4-opg.scm -- one-parameter groups (compact-groups notes, sec. 5.4, Proposition 5.36, the
;;; uniqueness half): two one-parameter groups extending the same group segment are equal.
;;; Agent ISOM, 2026-10-26.  Helper prefix: co4-.  Library: analysis.

(define (co4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (co4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (co4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (co4-op x y) (list '(OPR g) x y))
(define (co4-inv x) (list '(INV g) x))
(define co4-E '(IDEN g))
(define (co4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (co4-forall (cdr vs) body))))
(define (co4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (co4-implies (cdr hs) concl))))

;;; ---- two group facts ----
(sp (make-wff (co4-forall '(g x) (co4-implies (list '(IS-GROUP g) '(IN x (CARR g)) (list '= (co4-op 'x 'x) 'x)) (list '= 'x co4-E)))))
(dk-peel!)
(let ((ix (co4-inv 'x)))
  (dk-cite! 'group-inv-in 'g 'x)
  (dk-cite! 'group-carrier-closed-opr 'g ix 'x)
  (dk-cite! 'group-carrier-closed-opr 'g 'x 'x)
  (fact 'group-identity-in 'g)
  (dk-cite! 'group-assoc 'g ix 'x 'x)
  (dk-rewrite-h! (list '= (co4-op (co4-op ix 'x) 'x) (co4-op ix (co4-op 'x 'x))) (co4-op 'x 'x) 'x)
  (dk-cite! 'group-left-inv 'g 'x)
  (dk-rewrite-h! (list '= (co4-op (co4-op ix 'x) 'x) (co4-op ix 'x)) (co4-op ix 'x) co4-E)
  (dk-cite! 'group-left-id 'g 'x)
  (dk-rewrite-h! (list '= (co4-op co4-E 'x) co4-E) (co4-op co4-E 'x) 'x)
  (co4-ass!))
(qed 'group-idempotent-iden)
(topic! 'group-idempotent-iden 'algebra)

(sp (make-wff (co4-forall '(g u v) (co4-implies (list '(IS-GROUP g) '(IN u (CARR g)) '(IN v (CARR g)) (list '= (co4-op 'u 'v) co4-E))
   (list '= 'u (co4-inv 'v))))))
(dk-peel!)
(let ((iv (co4-inv 'v)))
  (dk-cite! 'group-inv-in 'g 'v)
  (dk-cite! 'group-carrier-closed-opr 'g 'u 'v)
  (fact 'group-identity-in 'g)
  (dk-cite! 'group-assoc 'g 'u 'v iv)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'v)))
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'u)))
  (dk-rewrite-h! (list '= (co4-op (co4-op 'u 'v) iv) (co4-op 'u (co4-op 'v iv))) (co4-op 'u 'v) co4-E)
  (dk-rewrite-h! (list '= (co4-op co4-E iv) (co4-op 'u (co4-op 'v iv))) (co4-op 'v iv) co4-E)
  (dk-rewrite-h! (list '= (co4-op co4-E iv) (co4-op 'u co4-E)) (co4-op 'u co4-E) 'u)
  (dk-cite! 'group-left-id 'g iv)
  (dk-rewrite-h! (list '= (co4-op co4-E iv) 'u) (co4-op co4-E iv) iv)
  (subst (list '= 'u iv))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (co4-ass-rfl!)))
(qed 'group-right-inverse-unique)
(topic! 'group-right-inverse-unique 'algebra)

;;; ---- agreement on [0, al] spreads to the n al + r, r in [0, al] ----
(define (co4-hom p) (list 'FORALL 'oqr_ (list 'IMPLIES '(IN oqr_ RR) (list 'FORALL 'oqu_ (list 'IMPLIES '(IN oqu_ RR)
                      (list '= (list p '(+ oqr_ oqu_)) (list '(OPR g) (list p 'oqr_) (list p 'oqu_))))))))
(define co4-agree '(FORALL t (IMPLIES (IN t RR) (IMPLIES (<= 0 t) (IMPLIES (<= t al) (= (psia t) (psib t)))))))
(define co4-hyps (list '(IS-GROUP g) '(POS-RR al) '(IN psia (FUN RR (CARR g))) '(IN psib (FUN RR (CARR g)))
                       (co4-hom 'psia) (co4-hom 'psib) co4-agree))
(define (co4-type! p x) (dk-real! x) (dk-cite! 'fun-apply-type-c p 'RR '(CARR g) x))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (co4-forall '(g al psia psib) (co4-implies co4-hyps
   '(FORALL r (IMPLIES (IN r RR) (IMPLIES (<= 0 r) (IMPLIES (<= r al) (= (psia (+ (* n al) r)) (psib (+ (* n al) r)))))))))))))
(let* ((ind (dk-use-induction-fixed! '(g al psia psib))) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))   ; W1D: g al psia psib fixed
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (dk-cite! 'rr-pos-rr-in-rr 'al)
  (dk-real! '(* 0 al)) (dk-real! '(+ (* 0 al) r))
  (dk-have! '(= (+ (* 0 al) r) r) (lambda () (crs)))
  (subst '(= (+ (* 0 al) r) r))
  (dk-apply! (dk-ctx-form co4-agree) 'r)
  (co4-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (dk-cite! 'rr-pos-rr-in-rr 'al)
  (dk-cite! 'rr-lt-of-pos-rr 'al)
  (dk-cite! 'nn-in-rr n)
  (dk-cite! 'nn-succ-plus-one n)
  (subst (list '= (list 'succ n) (list '+ n 1)))
  (let* ((x (list '+ (list '* n 'al) 'r)) (xa (list '+ x 'al)) (lhs (list '+ (list '* (list '+ n 1) 'al) 'r)))
    (dk-real! (list '* n 'al)) (dk-real! x) (dk-real! xa) (dk-real! (list '+ n 1)) (dk-real! (list '* (list '+ n 1) 'al)) (dk-real! lhs)
    (dk-have! (list '= lhs xa) (lambda () (crs)))
    (subst (list '= lhs xa))
    ; W1D: g al psia psib fixed; the IH is the universal at r below
    (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'r) (dk-contains? h n))) "the induction hypothesis at r") 'r)
    (dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
    (dk-have! '(<= al al) (lambda () (dk-ineq!)))
    (dk-apply! (dk-ctx-form co4-agree) 'al)
    (dk-apply! (dk-ctx-form (co4-hom 'psia)) x 'al)
    (dk-apply! (dk-ctx-form (co4-hom 'psib)) x 'al)
    (co4-type! 'psib x) (co4-type! 'psib 'al) (co4-type! 'psia x) (co4-type! 'psia 'al)
    (dk-cite! 'group-carrier-closed-opr 'g (list 'psib x) '(psib al))
    (dk-cite! 'fun-apply-type-c 'psib 'RR '(CARR g) xa)
    (subst (list '= (list 'psia xa) (co4-op (list 'psia x) '(psia al))))
    (subst (list '= (list 'psib xa) (co4-op (list 'psib x) '(psib al))))
    (subst (list '= (list 'psia x) (list 'psib x)))
    (subst (list '= '(psia al) '(psib al)))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (co4-ass-rfl!))))
(qed 'one-parameter-agree-multiples)
(topic! 'one-parameter-agree-multiples 'analysis)

;;; ---- the lift (as in cg1-group.scm) ----
(define co4-stmts '())
(define (co4-keep! nm f) (set! co4-stmts (cons (cons nm f) co4-stmts)) f)
(define (co4-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map co4-subst e)) (#t e)))
(define (co4-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt co4-stmts)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (co4-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))

;;; ---- Proposition 5.36, uniqueness ----
(define (co4-ext p) (list 'FORALL 't (list 'IMPLIES '(IN t (CCINT 0 al)) (list '= (list p 't) '(phi t)))))
(sp (make-wff (co4-keep! 'one-parameter-group-extension-unique-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (co4-forall '(al phi psia psib)
     (co4-implies (list '(IS-GROUP-SEGMENT s g al phi) '(IS-ONE-PARAMETER-GROUP s g psia) '(IS-ONE-PARAMETER-GROUP s g psib)
                        (co4-ext 'psia) (co4-ext 'psib))
       '(FORALL t (IMPLIES (IN t RR) (= (psia t) (psib t))))))))))))
(dk-peel!)
(define co4-t (cadr (cadr (dk-goal))))
(dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
(fact 'group-identity-in 'g)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-one-parameter-group 's 'g 'psia))))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-one-parameter-group 's 'g 'psib))))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-group-segment 's 'g 'al 'phi))))
(dk-cite! 'rr-pos-rr-in-rr 'al)
(dk-cite! 'rr-lt-of-pos-rr 'al)
(fact 'rr-zero-in)
;; agreement on [0, al]
(dk-have! co4-agree
  (lambda ()
    (let ((t0 (begin (dk-peel!) (cadr (cadr (dk-goal))))))
      (let ((iff (dk-cite! 'ccint-membership 0 'al t0)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (co4-ass!)))))
        (dk-meta-iff-l! iff))
      (dk-apply! (dk-ctx-form (co4-ext 'psia)) t0)
      (dk-apply! (dk-ctx-form (co4-ext 'psib)) t0)
      (dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) t0)
      (subst (list '= (list 'psia t0) (list 'phi t0)))
      (subst (list '= (list 'psib t0) (list 'phi t0)))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (co4-ass-rfl!)))))
;; equality for t >= 0
(define co4-pos '(FORALL tp_ (IMPLIES (IN tp_ RR) (IMPLIES (<= 0 tp_) (= (psia tp_) (psib tp_))))))
(dk-have! co4-pos
  (lambda ()
    (let* ((t1 (begin (dk-peel!) (cadr (cadr (dk-goal)))))
           (n (dk-skolem! (dk-cite! 'rr-nn-floor-mul t1 'al)))
           (_ (begin (co4-split-if! (lambda (h) (dk-contains? h n))) (co4-split-if! (lambda (h) (dk-contains? h n)))))
           (na (list '* n 'al)) (r (list '- t1 na)) (x (list '+ na r)))
      (dk-cite! 'nn-in-rr n)
      (dk-real! na) (dk-real! r) (dk-real! x)
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= na t1))))
      (dk-have! (list '<= r 'al) (lambda () (dk-ineq! (list '< t1 (list '+ na 'al)))))
      (dk-cite! 'one-parameter-agree-multiples n 'g 'al 'psia 'psib)
      (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'r) (dk-contains? h n))) "the multiples") r)
      (dk-have! (list '= x t1) (lambda () (crs)))
      (dk-rewrite-h! (list '= (list 'psia x) (list 'psib x)) x t1)
      (co4-ass!))))
(define (co4-zero! p)                    ; p(0) = e
  (let* ((e00 (dk-apply! (dk-ctx-form (co4-hom p)) 0 0)) (p0 (list p 0)))
    (dk-cite! 'fun-apply-type-c p 'RR '(CARR g) 0)
    (dk-have! '(= (+ 0 0) 0) (lambda () (crs)))
    (dk-have! (list '= (co4-op p0 p0) p0)
      (lambda () (subst (list '= (co4-op p0 p0) (list p '(+ 0 0)))) (subst '(= (+ 0 0) 0)) (co4-ass-rfl!)))
    (dk-cite! 'group-idempotent-iden 'g p0)))
(define (co4-inv-of! p t u)              ; p(t) p(u) = p(t + u) = p(0) = e: p(t) = inv p(u)
  (dk-apply! (dk-ctx-form (co4-hom p)) t u)
  (dk-cite! 'fun-apply-type-c p 'RR '(CARR g) t)
  (dk-cite! 'fun-apply-type-c p 'RR '(CARR g) u)
  (dk-have! (list '= (co4-op (list p t) (list p u)) co4-E)
    (lambda () (subst (list '= (co4-op (list p t) (list p u)) (list p (list '+ t u))))
               (subst (list '= (list '+ t u) 0))
               (subst (list '= (list p 0) co4-E))
               (co4-ass-rfl!)))
  (dk-cite! 'group-right-inverse-unique 'g (list p t) (list p u)))
(use-em (list '< co4-t 0)
  (lambda ()
    (let ((u (list '- 0 co4-t)))
      (dk-real! u)
      (dk-have! (list '<= 0 u) (lambda () (dk-ineq! (list '< co4-t 0))))
      (dk-apply! (dk-ctx-form co4-pos) u)
      (dk-real! (list '+ co4-t u))
      (dk-have! (list '= (list '+ co4-t u) 0) (lambda () (crs)))
      (co4-zero! 'psia) (co4-zero! 'psib)
      (co4-inv-of! 'psia co4-t u) (co4-inv-of! 'psib co4-t u)
      (dk-cite! 'group-inv-in 'g (list 'psib u))
      (subst (list '= (list 'psia co4-t) (co4-inv (list 'psia u))))
      (subst (list '= (list 'psia u) (list 'psib u)))
      (subst (list '= (list 'psib co4-t) (co4-inv (list 'psib u))))
      (co4-ass-rfl!)))
  (lambda ()
    (dk-cite! 'rr-lt-trichotomy co4-t 0)
    (dk-have! (list 'OR (list '= co4-t 0) (list '< 0 co4-t))
      (lambda () (if (dk-only! (list 'OR (list '< co4-t 0) (list 'OR (list '= co4-t 0) (list '< 0 co4-t))) (list 'NOT (list '< co4-t 0))) (prop))))
    (dk-have! (list '<= 0 co4-t)
      (lambda () (use-em (list '= co4-t 0)
                   (lambda () (dk-ineq! (list '= co4-t 0)))
                   (lambda () (dk-have! (list '< 0 co4-t) (lambda () (if (dk-only! (list 'OR (list '= co4-t 0) (list '< 0 co4-t)) (list 'NOT (list '= co4-t 0))) (prop))))
                              (dk-ineq! (list '< 0 co4-t))))))
    (dk-apply! (dk-ctx-form co4-pos) co4-t)
    (co4-ass!)))
(qed 'one-parameter-group-extension-unique-gt)
(topic! 'one-parameter-group-extension-unique-gt 'analysis)
(co4-lift! 'one-parameter-group-extension-unique-gt 'one-parameter-group-extension-unique)
