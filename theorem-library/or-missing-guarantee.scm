                   (cxl-reducer! (lambda () (nth-r)))
                   (dk-ineq! `(< (NTH 1 ,x) (NTH 1 ,y)))))))))
        ;; transitivity
        (#t
         (dk-peel!)
         (let* ((hs (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cxl-R))) (dk-asms)))
                (ineqs '()) (vars '()))
