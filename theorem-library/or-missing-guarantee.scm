(sp (make-wff '(UNIQUELY-ORIGINATES CX-SP 20)))
(cxl-base-sp!)
(for-each dk-cite! '(cx-strand-list-typed cx-nodes-set))
(mac 'uniquely-originates)
(ew '(LIST 1 1))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'ORIGINATES)
        (begin
          (mac 'originates) (mac 'is-entry-point)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((and (dk-head-is? g 'IN) (equal? (caddr g) cxl-N)) (cxl-node-in! 1 1) (dk-ass!))
                  ((and (dk-head-is? g 'IN) (dk-contains? g 'SEP)) (cxl-content-in-I! '(LIST 1 1)) (dk-ass!))
                  ((dk-head-is? g 'FORALL)
                   (dk-peel!)
                   (let* ((h (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-asms)))
                          (m (caddr h)))
                     (mac-h 'same-strand-before h)
                     (dk-split-all!)
                     (dk-split! (dk-cite! 'node-parts 'CX-SP m))
                     (let ((lt (dk-nth-h! `(< (NTH 1 ,m) (NTH 1 (LIST 1 1))))))
                       (di)
                       (dks-nn-absurd! lt `(<= 1 (NTH 1 ,m))))))
                  (#t (cxl-ground-close!)))))))
        ;; uniqueness
        (begin
          (dk-peel!)
          (let* ((h (find-first (lambda (f) (dk-head-is? f 'ORIGINATES)) (dk-asms)))
                 (m (cadddr h)))
            (mac-h 'originates h)
            (mac-h 'is-entry-point `(IS-ENTRY-POINT CX-SP ,m ,cxl-I))
            (dk-split-all!)
            (cxl-node-cases! m
              (lambda (k j)
                (let ((n `(LIST ,k ,j)))
                  (subst `(= ,m ,n))
                  (if (equal? n '(LIST 1 1))
                      (cxl-ground-close!)
                      (let ((dir (car (cdr (list-ref (cdr (cxl-strand j)) (- k 1))))))
                        (pbc)
                        (if (eq? dir 'RECEIVED)
                            (begin
                              (dk-rewrite-h! `(IS-SENT CX-SP ,m) m n)
                              (mac-h 'is-sent `(IS-SENT CX-SP ,n))
                              (dk-have! `(= (NODE-DIR CX-SP ,n) RECEIVED) (lambda () (cxl-ground-close!)))
                              (dk-have! '(= SENT RECEIVED) (lambda () (subst `(= SENT (NODE-DIR CX-SP ,n))) (dk-ass!)))
                              (ai (dk-cite! 'sent-ne-received)))
                            (let* ((e (if (and (= j 8) (= k 3)) '(LIST 2 8) `(LIST 1 ,j)))
                                   (u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SAME-STRAND-BEFORE))) (dk-asms))))
                              (cxl-node-in! (cadr e) (caddr e))
