                              (dk-have! `(SAME-STRAND-BEFORE CX-SP ,e ,n)
                                (lambda () (mac 'same-strand-before) (dk-conj-close! (lambda () (if (not (dk-ass!)) (cxl-ground-close!))))))
                              (cxl-content-in-I! e)
                              (let ((u2 (dk-rewrite-h! u m n)))
                                (ai (dk-apply! u2 e)))))))))))))))
