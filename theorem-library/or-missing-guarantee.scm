;;; -----------------------------------------------------------------------
;;; 8. The symmetric failure for Theorem 7.9 (or-responder-guarantee): Nb = 21 originates uniquely on the
;;; responder's node [2, 2], every hypothesis of 7.9 holds for the responder (key K = 32), and no regular
;;; initiator strand of CX-C has the responder's key.

(define (cxl-I-of u) `(SEP ssw_ (MSG-SET (TOKENS CX-SP) (KEYS CX-SP)) (IS-SUBTERM (TOKENS CX-SP) (KEYS CX-SP) ,u ssw_)))
(define (cxl-node-lit k j) (list-ref (cdr (cxl-strand j)) (- k 1)))
(define (cxl-content-in-I-of! u n)
  (let* ((c (caddr (cxl-node-lit (cadr n) (caddr n))))
         (e `(= (NODE-CONTENT CX-SP ,n) ,c)))
    (dk-have! e (lambda () (cxl-ground-close!)))
    (dk-have! `(IN (NODE-CONTENT CX-SP ,n) ,(cxl-I-of u))
      (lambda ()
        (subst e)
        (in-sep! (lambda () (dks-msg! c) (dk-ass!)) (lambda () (dks-sub-fwd! u c) (dk-ass!)))))))
;; goal FALSITY, (IN (NODE-CONTENT CX-SP N) I(u)) in context, U not in N's literal content
(define (cxl-content-absurd! u n)
  (let* ((c (caddr (cxl-node-lit (cadr n) (caddr n))))
         (e `(= (NODE-CONTENT CX-SP ,n) ,c))
         (h `(IN (NODE-CONTENT CX-SP ,n) ,(cxl-I-of u))))
    (dk-have! e (lambda () (cxl-ground-close!)))
    (let* ((h2 (dk-rewrite-h! h `(NODE-CONTENT CX-SP ,n) c))
           (l (dk-landed (lambda () (sep-me h2))))
           (sub (find-first (lambda (f) (dk-head-is? f 'IS-SUBTERM)) l)))
      (dk-have! '(IS-TOKEN-SET (TOKENS CX-SP)) (lambda () (subst (dk-cite! 'cx-sp@tokens)) (dk-cite! 'nn-is-token-set) (dk-ass!)))
      (dk-have! '(IN (KEYS CX-SP) SET) (lambda () (subst (dk-cite! 'cx-sp@keys)) (dk-cite! 'interval-in-set 30 33) (dk-ass!)))
      (cxl-or-each! (dk-subterm-literal! '(TOKENS CX-SP) '(KEYS CX-SP) u c) (lambda (eq) (dks-nn-absurd! eq))))))

;; dks-or-each! tolerating branches that hash-consing has already grounded
(define (cxl-or-each! o handler)
  (if (not (dk-head-is? o 'OR))
      (handler o)
      (let ((ls (dk-opened (lambda () (ai o)))))
        (for-each (lambda (l)
                    (if (not (sequent-node-grounded? l))
                        (begin
                          (dk-focus! l)
                          (cond ((dk-asm? (cadr o)) (handler (cadr o)))
                                ((dk-head-is? (caddr o) 'OR) (cxl-or-each! (caddr o) handler))
                                (#t (handler (caddr o)))))))
                  ls))))

(define (cxl-unique-origin! u k0 j0 name)
  (let ((o `(LIST ,k0 ,j0)) (iu (cxl-I-of u)))
    (dk-sp-qed! (make-wff `(UNIQUELY-ORIGINATES CX-SP ,u))
      (lambda ()
        (cxl-base-sp!)
        (for-each dk-cite! '(cx-strand-list-typed cx-nodes-set))
        (mac 'uniquely-originates)
        (ew o)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'ORIGINATES)
                (begin
                  (mac 'originates) (mac 'is-entry-point)
                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond
                          ((and (dk-head-is? g 'IN) (equal? (caddr g) cxl-N)) (cxl-node-in! k0 j0) (dk-ass!))
                          ((and (dk-head-is? g 'IN) (dk-contains? g 'SEP)) (cxl-content-in-I-of! u o) (dk-ass!))
                          ((dk-head-is? g 'FORALL)
                           (dk-peel!)
                           (let* ((h (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-asms)))
                                  (m (caddr h)))
                             (mac-h 'same-strand-before h)
                             (dk-split-all!)
                             (let ((lt (dk-nth-h! `(< (NTH 1 ,m) (NTH 1 ,o))))
                                   (eqi (dk-nth-h! `(= (NTH 2 ,m) (NTH 2 ,o)))))
                                 (dk-split! (dk-cite! 'node-parts 'CX-SP m))
                               (cxl-nat! k0)
                               (dk-cite! 'nn-lt-succ-le `(NTH 1 ,m) k0)
                               (dk-have! `(<= (NTH 1 ,m) ,(- k0 1)) (lambda () (dk-nn! `(<= (succ (NTH 1 ,m)) ,k0))))
                               (cxl-range-cases! `(NTH 1 ,m) 1 (- k0 1)
                                 (lambda (k)
                                   (dk-have! `(= ,m (LIST ,k ,j0))
                                     (lambda ()
                                       (subst `(= ,m (LIST (NTH 1 ,m) (NTH 2 ,m))))
                                       (subst `(= (NTH 1 ,m) ,k))
                                       (subst eqi)
                                       (cxl-ground-close!)))
                                   (subst `(= ,m (LIST ,k ,j0)))
                                   (di)
                                   (cxl-content-absurd! u `(LIST ,k ,j0)))))))
                          (#t (cxl-ground-close!)))))))
                (begin
                  (dk-peel!)
                  (let* ((h (find-first (lambda (f) (dk-head-is? f 'ORIGINATES)) (dk-asms)))
                         (m (cadddr h)))
                    (mac-h 'originates h)
                    (mac-h 'is-entry-point `(IS-ENTRY-POINT CX-SP ,m ,iu))
                    (dk-split-all!)
                    (cxl-node-cases! m
                      (lambda (k j)
                        (let ((n `(LIST ,k ,j)))
                          (subst `(= ,m ,n))
                          (if (equal? n o)
                              (cxl-ground-close!)
                              (let ((dir (cadr (cxl-node-lit k j))) (c (caddr (cxl-node-lit k j))))
                                (pbc)
                                (cond
                                  ((eq? dir 'RECEIVED)
                                   (dk-rewrite-h! `(IS-SENT CX-SP ,m) m n)
                                   (mac-h 'is-sent `(IS-SENT CX-SP ,n))
                                   (dk-have! `(= (NODE-DIR CX-SP ,n) RECEIVED) (lambda () (cxl-ground-close!)))
                                   (dk-have! '(= SENT RECEIVED) (lambda () (subst `(= SENT (NODE-DIR CX-SP ,n))) (dk-ass!)))
                                   (ai (dk-cite! 'sent-ne-received)))
                                  ((not (dks-occurs? u c))
                                   (dk-rewrite-h! `(IN (NODE-CONTENT CX-SP ,m) ,iu) m n)
                                   (cxl-content-absurd! u n))
                                  (#t
                                   (let* ((ek (let loop ((i 1)) (if (dks-occurs? u (caddr (cxl-node-lit i j))) i (loop (+ i 1)))))
                                          (e `(LIST ,ek ,j))
                                          (uu (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SAME-STRAND-BEFORE))) (dk-asms))))
                                     (if (>= ek k) (error "cxl-unique-origin!: no earlier occurrence" n))
                                     (cxl-node-in! ek j)
                                     (cxl-node-in! k j)
                                     (dk-have! `(SAME-STRAND-BEFORE CX-SP ,e ,n)
                                       (lambda () (mac 'same-strand-before) (dk-conj-close! (lambda () (if (not (dk-ass!)) (cxl-ground-close!))))))
                                     (cxl-content-in-I-of! u e)
                                     (ai (dk-apply! (dk-rewrite-h! uu m n) e))))))))))))))))
      name)))
