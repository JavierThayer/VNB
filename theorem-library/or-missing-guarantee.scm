(cxl-base!)
(mac 'is-prec-closed)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ;; the send edges
        ((dk-contains? g 'cxe_)
         (dk-peel!)
         (let* ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cxl-E))) (dk-asms)))
                (pr (cadr h))
                (landed (dk-landed (lambda () (sep-me h))))
                (o (find-first (lambda (f) (dk-head-is? f 'OR)) landed)))
           (dks-or-each! o
             (lambda (eq)
               (let* ((lit (caddr eq)) (s (cadr lit)) (t (caddr lit)))
                 (subst `(= ,pr ,lit))
                 (cxl-node-in! (cadr s) (caddr s))
                 (cxl-node-in! (cadr t) (caddr t))
                 (in-sep! (lambda () (cxl-pair-in! s t) (dk-ass!))
                          (lambda () (cxl-ground-close!))))))))
        ;; the strand order
        ((dk-contains? g 'SAME-STRAND-BEFORE)
         (dk-peel!)
         (let* ((h (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-asms)))
                (x (caddr h)) (y (cadddr h)))
           (mac-h 'same-strand-before h)
           (dk-split-all!)
           (dk-split! (dk-cite! 'node-parts 'CX-SP x))
           (dk-split! (dk-cite! 'node-parts 'CX-SP y))
           (dk-cite! 'nn-in-rr `(NTH 1 ,x))
           (dk-cite! 'nn-in-rr `(NTH 1 ,y))
           (dk-cite! 'cx-sp@ids)
           (dk-rewrite-h! `(IN (NTH 2 ,x) (IDS CX-SP)) '(IDS CX-SP) '(INTERVAL 1 8))
           (cxl-int-facts! `(NTH 2 ,x) 1 8)
           (in-sep! (lambda () (cxl-pair-in! x y) (dk-ass!))
             (lambda ()
               (cxl-reducer! (lambda () (nth-r)))
               (dk-lam-b!)
               (subst `(= (NTH 2 ,y) (NTH 2 ,x)))
               (cxl-range-cases! `(NTH 2 ,x) 1 8
                 (lambda (j)
