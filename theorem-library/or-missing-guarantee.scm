                                           ((dk-head-is? f 'IN)
                                            (let ((a (cadr (cadr f))) (b (caddr (cadr f))))
                                              (set! vars (append (list a b) vars))
                                              (dk-split! (dk-cite! 'pair-in-cartesian-parts cxl-N cxl-N a b))))))
                                   l)))
                     hs)
           (let* ((g2 (dk-goal)) (a (cadr (cadr g2))) (c (caddr (cadr g2))))
             (for-each cxl-rk-type! (delete-duplicates vars))
             (in-sep! (lambda () (cxl-pair-in! a c) (dk-ass!))
               (lambda ()
                 (cxl-reducer! (lambda () (nth-r)))
                 (apply dk-ineq! ineqs))))))))))
(qed 'cx-rank-closed)

