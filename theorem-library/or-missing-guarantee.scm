;;; cx-laws.scm -- THE MISSING GUARANTEE OF OTWAY-REES (strand-spaces section 7.3.3, Figure 9): the
;;; concrete bundle CX-C of structure-library/or-missing-guarantee-instance.scm satisfies every hypothesis
;;; of Theorem 7.8 (or-initiator-guarantee) for the initiator with session key K' = 33, yet no regular
;;; responder strand of CX-C has key K' -- so 7.8 cannot be strengthened to name the session key.
;;; Agent SB-5, 2026-10-26.  Destination: theorem-library/or-missing-guarantee.scm.  Library: strand.
;;; Helper prefix cxl-.  Uses the sb3 strand helpers (dks-, proposed driver-kit addition).

(dks-use! 'CX-SP)
(define cxl-K '(INTERVAL 30 33))
(define cxl-A `(MSG-SET NN ,cxl-K))

;; ground facts
(define (cxl-nat! n) (if (not (dk-asm? `(IN ,n NN))) (dk-have! `(IN ,n NN) (lambda () (arith)))) `(IN ,n NN))
(define (cxl-le! a b) (if (not (dk-asm? `(<= ,a ,b))) (dk-have! `(<= ,a ,b) (lambda () (arith)))) `(<= ,a ,b))
(define (cxl-in-int! j a b)
  (let ((g `(IN ,j (INTERVAL ,a ,b))))
    (if (not (dk-asm? g))
        (begin (cxl-nat! a) (cxl-nat! b) (cxl-nat! j) (cxl-le! a j) (cxl-le! j b)
               (dk-cite! 'interval-mem-intro a b j)))
    g))
;; the token and key typings every literal message of the bundle needs
(define (cxl-base!)
  (for-each cxl-nat! '(10 11 20 21 22 30 31 32 33))
  (for-each (lambda (k) (cxl-in-int! k 30 33)) '(30 31 32 33))
  (for-each (lambda (k) (cxl-in-int! k 10 11)) '(10 11)))
(define (cxl-msg! m) (cxl-base!) (dk-stl--msg! 'NN cxl-K m))

;; run TACTIC on the focus, then visit every open leaf whose goal satisfies PRED (hash-consing may have
;; grounded some or all of the children already)
(define (cxl-each-open! tactic pred visit)
  (tactic)
  (for-each (lambda (l)
              (if (and (not (sequent-node-grounded? l)) (pred (dk-goal-of l)))
                  (begin (dk-focus! l) (visit))))
            (dk-open-leaves)))
(define (cxl-directed-goal? g) (and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'DIRECTED)))
;; goal (IN STRAND (STRANDS NN K)) or (IN STRAND (TUPLES (DIRECTED NN K))), STRAND a literal
(define (cxl-strand-type!)
  (if (dk-contains? (dk-goal) 'STRANDS) (subst (dk-cite! 'strands-unfold 'NN cxl-K)))
  (cxl-each-open! (lambda () (ti)) cxl-directed-goal?
    (lambda ()
      (let* ((g (dk-goal)) (m (caddr (cadr g))))
        (cxl-msg! m)
        (dk-cite! 'directed-intro 'NN cxl-K m)
        (dk-split-all!)
        (if (not (dk-ass!)) (error "cxl-strand-type!: open" g))))))
;; run REDUCE! on the focus, closing the owed reflexive leaves it posts; focus back on the reduced goal
(define (cxl-reducer! reduce!)
  (let ((before (dk-open-leaves)))
    (reduce!)
    (let ((main (proof-state-focus *ps*)))
      (for-each (lambda (l)
                  (let ((g (dk-goal-of l)))
                    (if (and (not (memq l before)) (not (sequent-node-grounded? l)) (not (eq? l main))
                             (eq? (car g) '=) (equal? (cadr g) (caddr g)))
                        (begin (dk-focus! l) (rfl)))))
                (dk-open-leaves))
      (if (not (sequent-node-grounded? main)) (dk-focus! main)))))
(define (cxl-find-succ-num t)
  (cond ((not (pair? t)) #f)
        ((and (eq? (car t) 'succ) (pair? (cdr t)) (exact-nonnegative-integer? (cadr t))) (cadr t))
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-find-succ-num (car xs)) => (lambda (k) k)) (#t (loop (cdr xs))))))))
(define (cxl-has-head? t h)
  (cond ((not (pair? t)) #f) ((eq? (car t) h) #t)
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-has-head? (car xs) h) #t) (#t (loop (cdr xs))))))))
(define (cxl-find-lam-app t)
  (cond ((not (pair? t)) #f)
        ((and (pair? (car t)) (eq? (caar t) 'VNB-LAMBDA)) t)
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-find-lam-app (car xs)) => (lambda (u) u)) (#t (loop (cdr xs))))))))
(define (cxl-find-node-fn t)
  (cond ((not (pair? t)) #f)
        ((and (memq (car t) '(NODE-DIR NODE-CONTENT)) (= (length t) 3) (eq? (cadr t) 'CX-SP)) t)
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-find-node-fn (car xs)) => (lambda (u) u)) (#t (loop (cdr xs))))))))
(define (cxl-find-map-num t)
  (cond ((not (pair? t)) #f)
        ((and (equal? (car t) '(STRAND-MAP CX-SP)) (pair? (cdr t)) (exact-nonnegative-integer? (cadr t))) (cadr t))
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-find-map-num (car xs)) => (lambda (u) u)) (#t (loop (cdr xs))))))))
(define (cxl-find-plus-num t)
  (cond ((not (pair? t)) #f)
        ((and (eq? (car t) '+) (= (length t) 3) (exact-nonnegative-integer? (cadr t)) (exact-nonnegative-integer? (caddr t))) (cdr t))
        (#t (let loop ((xs t)) (cond ((not (pair? xs)) #f) ((cxl-find-plus-num (car xs)) => (lambda (u) u)) (#t (loop (cdr xs))))))))
;; a ground goal over literals: reduce succ numerals, LENGTH and NTH of literals, then close
(define (cxl-ground-close!)
  (let loop ((n 0))
    (if (> n 20) (error "cxl-ground-close!: no progress" (dk-goal)))
    (let ((leaf (proof-state-focus *ps*)))
      (if (not (sequent-node-grounded? leaf))
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((cxl-find-succ-num g)
                   => (lambda (k)
                        (let ((e `(= (succ ,k) ,(+ k 1))))
                          (dk-have! e (lambda () (arith)))
                          (subst e)
                          (loop (+ n 1)))))
                  ((memq (car g) '(IS-SENT IS-RECEIVED)) (mac (car g)) (loop (+ n 1)))
                  ((cxl-find-node-fn g)
                   => (lambda (t) (subst (dk-cite! (if (eq? (car t) 'NODE-DIR) 'node-dir-unfold 'node-content-unfold) 'CX-SP (caddr t)))
                        (loop (+ n 1))))
                  ((cxl-find-map-num g)
                   => (lambda (j) (subst (dk-cite! (cxl-sym "cx-map-" j))) (loop (+ n 1))))
                  ((cxl-find-plus-num g)
                   => (lambda (pr)
                        (let ((e `(= (+ ,(car pr) ,(cadr pr)) ,(+ (car pr) (cadr pr)))))
                          (dk-have! e (lambda () (arith)))
                          (subst e)
                          (loop (+ n 1)))))
                  ((cxl-has-head? g 'LENGTH) (cxl-reducer! (lambda () (len-r))) (loop (+ n 1)))
                  ((not (equal? (reduce-nth-in-expr g) g)) (cxl-reducer! (lambda () (nth-r))) (loop (+ n 1)))
                  ((cxl-find-lam-app g) (dk-lam-b!) (loop (+ n 1)))
                  ((and (memq (car g) '(= ==)) (equal? (cadr g) (caddr g))) (if (eq? (car g) '==) (qrfl) (rfl)))
                  (#t (arith))))))))

;; nth-r on the focus, closing the owed (= SL SL) leaf it posts for the strand list (typed in context by
;; cx-strand-list-typed); focus back on the reduced goal
(define (cxl-nth-r!)
  (let ((before (dk-open-leaves)))
    (nth-r)
    (let ((main (proof-state-focus *ps*)))
      (for-each (lambda (l)
                  (let ((g (dk-goal-of l)))
                    (if (and (not (memq l before)) (not (sequent-node-grounded? l))
                             (eq? (car g) '=) (equal? (cadr g) (caddr g)))
                        (begin (dk-focus! l) (rfl)))))
                (dk-open-leaves))
      (if (not (sequent-node-grounded? main)) (dk-focus! main)))))
(define (cxl-strands-goal? g) (and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'STRANDS)))

(define (cxl-sym . parts) (string->symbol (apply string-append (map (lambda (p) (if (number? p) (number->string p) (if (symbol? p) (symbol->string p) p))) parts))))
(define (cxl-strand j) (list-ref cxv-strands (- j 1)))
(define (cxl-map j) `((STRAND-MAP CX-SP) ,j))

;;; -----------------------------------------------------------------------
;;; 1. The strand map at each identifier.

(define cxl-sl `(LIST ,@cxv-strands))
(sp (make-wff `(IN ,cxl-sl (TUPLES (STRANDS NN ,cxl-K)))))
(cxl-base!)
(cxl-each-open! (lambda () (ti)) cxl-strands-goal? (lambda () (cxl-strand-type!)))
(qed 'cx-strand-list-typed)

;; close every open leaf: == by qrfl, = by rfl
(define (cxl-close-refl!)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (if (eq? (car (dk-goal)) '==) (qrfl) (rfl)))))
            (dk-open-leaves)))

(define (cxl-map-thm! j)
  (dk-sp-qed! (make-wff `(== ,(cxl-map j) ,(cxl-strand j)))
    (lambda ()
      (dk-cite! 'cx-strand-list-typed)
      (subst (dk-cite! 'cx-sp@strand-map))
      (cxl-in-int! j 1 8)
      (dk-lam-b!)
      (if (dk-contains? (dk-goal) 'NTH) (nth-r))
      (cxl-close-refl!))
    (cxl-sym "cx-map-" j)))
(for-each cxl-map-thm! '(1 2 3 4 5 6 7 8))

;;; -----------------------------------------------------------------------
;;; 2. CX-SP is a strand space.

(sp (make-wff '(IS-STRAND-SPACE CX-SP)))
(cxl-base!)
(dk-cite! 'cx-strand-list-typed)
(let ((ro (map (lambda (r) (dk-cite! r)) '(cx-sp@tokens cx-sp@ids cx-sp@keys cx-sp@strand-map cx-sp@kinv))))
  (mac 'is-strand-space)
  (for-each (lambda (e) (if (dk-contains? (dk-goal) (cadr e)) (subst e))) ro))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-contains? g 'LENGTH) (subst (dk-cite! 'cx-sp-def)) (len-r) (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (arith))))
        ((equal? g '(IN NN SET)) (fact 'nn-is-set) (dk-ass!))
        ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'INTERVAL) (eq? (caddr g) 'SET))
         (dk-cite! 'interval-in-set (cadr (cadr g)) (caddr (cadr g))) (dk-ass!))
        ((dk-contains? g 'STRANDS)
         (dk-lam-type!
           (lambda ()
             (di)
             (let ((v (cadr (cadr (dk-goal)))))
               (dk-cite! 'interval-elt-in-nn 1 8 v)
               (dk-cite! 'interval-lo 1 8 v)
               (dk-cite! 'interval-hi 1 8 v)
               (dks-index-cases! v 8
                 (lambda (j)
                   (subst `(= ,v ,j))
                   (cxl-nth-r!)
                   (cxl-strand-type!)))))))
        ((dk-contains? g 'FUN) (dk-lam-type! (lambda () (di) (dk-ass!))))
        ((dk-head-is? g 'IS-TOKEN-SET) (dk-cite! 'nn-is-token-set) (dk-ass!))
        ((dk-contains? g 'VNB-LAMBDA)
         (di) (dk-lam-b!) (if (not (proof-done? *ps*)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (#t (di) (dk-cite! 'interval-elt-in-nn 30 33 (cadr (dk-goal))) (dk-ass!))))))
(qed 'cx-sp-is-strand-space)

;;; -----------------------------------------------------------------------
;;; 3. CX-ISP is an infiltrated space: strands 5..8 are a tee, a flush, a separation and a concatenation.

(define (cxl-read-offs! names) (map (lambda (r) (dk-cite! r)) names))
(define (cxl-subst-all! ro) (for-each (lambda (e) (if (dk-contains? (dk-goal) (cadr e)) (subst e))) ro))
(define (cxl-len-lit! l)
  (let ((e `(= (LENGTH ,l) ,(length (cdr l)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (cxl-ground-close!))))
    e))
;; P in context with (<= LO P) (<= P HI) or P in (INTERVAL LO HI): run BODY on each j in [LO, HI]
;; with (= P j) in context; the cases below LO close by arithmetic (goal anything)
(define (cxl-range-cases! p lo hi body)
  (if (and (> lo 1) (not (dk-asm? `(<= 1 ,p)))) (dk-have! `(<= 1 ,p) (lambda () (dk-nn! `(<= ,lo ,p)))))
  (dks-index-cases! p hi
    (lambda (j)
      (if (< j lo)
          (begin (pbc) (dks-nn-absurd! `(= ,p ,j) `(<= ,lo ,p)))
          (body j)))))
(define (cxl-int-facts! p a b)
  (dk-cite! 'interval-elt-in-nn a b p) (dk-cite! 'interval-lo a b p) (dk-cite! 'interval-hi a b p))

;; goal (IS-ADVERSARY-TRACE CX-SP EMPTY-SET strand_j), j in 5..8
(define (cxl-adv-trace! j ro)
  (let ((st (cxl-strand j)))
    (mac 'is-adversary-trace)
    (case j
      ((5) (dks-select! 3 7) (mac 'is-tee-trace) (cxl-subst-all! ro)
           (cxl-msg! cxv-m2) (ew cxv-m2) (dk-conj-close! (lambda () (cxl-ground-close!))))
      ((6) (dks-select! 2 7) (mac 'is-flush-trace) (cxl-subst-all! ro)
           (cxl-msg! cxv-m4) (ew cxv-m4) (dk-conj-close! (lambda () (cxl-ground-close!))))
      ((7 8)
       (let ((l (if (= j 7) `(LIST 22 ,(cxv-ya 33) ,(cxv-yb 33)) `(LIST 22 ,(cxv-ya 33)))))
         (if (= j 7) (begin (dks-select! 5 7) (mac 'is-separate-trace)) (begin (dks-select! 4 7) (mac 'is-concat-trace)))
         (cxl-subst-all! ro)
         (cxl-base!)
         (dk-stl--tuples! 'NN cxl-K l)
         (cxl-len-lit! l)
         (ew l)
         (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'FORALL)
                 (begin
                   (dk-peel!)
                   (let* ((i (find-first (lambda (v) (dk-asm? `(<= ,v (LENGTH ,l))))
                                         (map (lambda (f) (cadr f)) (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (symbol? (cadr f)))) (dk-asms)))))
                          (n (length (cdr l))))
                     (if (not i) (error "cxl-adv-trace!: no index" (dk-goal)))
                     (dk-have! `(<= ,i ,n) (lambda () (subst `(= ,n (LENGTH ,l))) (dk-ass!)))
                     (cxl-range-cases! i 1 n (lambda (k) (subst `(= ,i ,k)) (cxl-ground-close!)))))
                 (cxl-ground-close!)))))))))

(sp (make-wff '(IS-INFILTRATED-SPACE CX-ISP)))
(cxl-base!)
(dk-cite! 'cx-strand-list-typed)
(dk-cite! 'cx-sp-is-strand-space)
(let ((ro (cxl-read-offs! '(cx-isp@ispace cx-isp@adv-ids cx-isp@adv-tokens cx-sp@tokens cx-sp@ids cx-sp@keys))))
  (mac 'is-infiltrated-space)
  (cxl-subst-all! ro)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-contains? g 'LENGTH) (subst (dk-cite! 'cx-isp-def)) (cxl-ground-close!))
          ((dk-asm? g) (dk-ass!))
          ((equal? g '(IN EMPTY-SET SET)) (dk-cite! 'empty-set-is-set) (dk-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET)) (dk-cite! 'interval-in-set (cadr (cadr g)) (caddr (cadr g))) (dk-ass!))
          ((dk-contains? g 'IS-ADVERSARY-TRACE)
           (di)
           (let ((p (cadr (cadddr (dk-goal)))))
             (cxl-int-facts! p 5 8)
             (cxl-range-cases! p 5 8
               (lambda (j)
                 (subst `(= ,p ,j))
                 (subst (dk-cite! (cxl-sym "cx-map-" j)))
                 (cxl-adv-trace! j ro)))))
          ((dk-contains? g 'EMPTY-SET)
           (di) (let ((t (cadr (dk-goal)))) (pbc) (ai (dk-cite! 'empty-set-has-no-members t))))
          (#t
           (di)
           (let ((p (cadr (dk-goal))))
             (cxl-int-facts! p 5 8)
             (dk-have! `(<= 1 ,p) (lambda () (dk-nn! `(<= 5 ,p))))
             (cxl-nat! 1) (cxl-nat! 8)
             (dk-cite! 'interval-mem-intro 1 8 p)
             (dk-ass!))))))))
(qed 'cx-isp-is-infiltrated-space)

;;; -----------------------------------------------------------------------
;;; 4. CX-ORP is a shared-key space and an Otway-Rees space: strand 1 an initiator's (A, B, Na, M, K'),
;;; 2 a responder's (A, B, Nb, M, K, X_A, {Na K}_KAS), 3 and 4 the server's (A, B, Na, Nb, M, K / K').

(define cxl-ro-names '(cx-orp@sk-inf cx-orp@sk-names cx-orp@ltkey cx-isp@ispace cx-isp@adv-ids cx-isp@adv-tokens
                       cx-sp@tokens cx-sp@ids cx-sp@keys cx-sp@kinv))

;; X in [10, 11] in context: land (IN (+ X 20) (INTERVAL 30 33))
(define (cxl-key-type! x)
  (let ((k `(+ ,x 20)))
    (cxl-int-facts! x 10 11)
    (cxl-nat! 20)
    (dk-have! `(AND (IN ,x NN) (IN 20 NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'nn-add-closed x 20)
    (dk-have! `(<= 30 ,k) (lambda () (dk-nn! `(<= 10 ,x))))
    (dk-have! `(<= ,k 33) (lambda () (dk-nn! `(<= ,x 11))))
    (cxl-nat! 30) (cxl-nat! 33)
    (dk-cite! 'interval-mem-intro 30 33 k)))

(define (cxl-num? x) (exact-nonnegative-integer? x))
;; the eigenvariable typed in the names [10, 11]
(define (cxl-name-var)
  (or (find-first (lambda (v) (dk-asm? `(IN ,v (INTERVAL 10 11))))
                  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) (dk-asms))))
      (error "cxl-name-var: none")))
;; close one atomic obligation about the concrete data
(define (cxl-close-atom! ro)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g 'IN) (cxl-num? (cadr g)) (dk-head-is? (caddr g) 'INTERVAL))
       (cxl-in-int! (cadr g) (cadr (caddr g)) (caddr (caddr g))) (dk-ass!))
      ((and (dk-head-is? g 'IN) (cxl-num? (cadr g)) (eq? (caddr g) 'NN)) (cxl-nat! (cadr g)) (dk-ass!))
      ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'MSG-SET)) (cxl-msg! (cadr g)) (dk-ass!))
      ((and (dk-head-is? g 'NOT) (dk-head-is? (cadr g) 'IN) (eq? (caddr (cadr g)) 'EMPTY-SET))
       (dk-cite! 'empty-set-has-no-members (cadr (cadr g))) (dk-ass!))
      ((and (dk-head-is? g 'NOT) (dk-head-is? (cadr g) 'IN) (dk-head-is? (caddr (cadr g)) 'INTERVAL))
       (let ((j (cadr (cadr g))) (a (cadr (caddr (cadr g)))) (b (caddr (caddr (cadr g)))))
         (di) (cxl-int-facts! j a b) (dks-nn-absurd! `(<= ,a ,j) `(<= ,j ,b))))
      ((and (dk-head-is? g 'NOT) (dk-head-is? (cadr g) '=))
       (let ((e (cadr g))) (di) (dks-nn-absurd! e)))
      ((and (dk-head-is? g 'NOT) (dk-head-is? (cadr g) 'IS-SUBTERM))
       (let* ((h (cadr g)) (tk (cadddr h)) (m (car (cddddr h))))
         (di)
         (cxl-base!)
         (dk-cite! 'nn-is-token-set)
         (dk-cite! 'interval-in-set 30 33)
         (dks-or-each! (dk-subterm-literal! 'NN cxl-K tk m) (lambda (e) (dks-nn-absurd! e)))))
      ((dk-head-is? g 'IS-OR-TEXT)
       (mac 'is-or-text) (cxl-subst-all! ro) (dk-conj-close! (lambda () (cxl-close-atom! ro))))
      ((and (dk-head-is? g 'FORALL) (dk-contains? g 'NOT))
       (dk-peel!)
       (let ((x (find-first (lambda (v) (dk-asm? `(IN ,v (INTERVAL 10 11))))
                            (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) (dk-asms))))))
         (dk-lam-b!)
         (let ((e (cadr (dk-goal))))
           (di)
           (cxl-int-facts! x 10 11)
           (dks-nn-absurd! e `(<= ,x 11) `(<= 10 ,x)))))
      (#t (cxl-ground-close!)))))

(sp (make-wff '(IS-SK-SPACE CX-ORP)))
(cxl-base!)
(dk-cite! 'cx-strand-list-typed)
(dk-cite! 'cx-isp-is-infiltrated-space)
(let ((ro (cxl-read-offs! cxl-ro-names)))
  (mac 'is-sk-space)
  (cxl-subst-all! ro)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-contains? g 'LENGTH) (subst (dk-cite! 'cx-orp-def)) (cxl-ground-close!))
          ((dk-asm? g) (dk-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET)) (dk-cite! 'interval-in-set 10 11) (dk-ass!))
          ((dk-head-is? g 'IN)
           (dk-lam-type! (lambda () (di) (cxl-key-type! (cadr (cadr (dk-goal)))) (dk-ass!))))
          ((dk-contains? g 'cxk_)
           (dk-peel!)
           (cxl-key-type! (cxl-name-var))
           (cxl-ground-close!))
          ((and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'FORALL))
           (dk-peel!)
           (let* ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-contains? f 'VNB-LAMBDA))) "the key equation"))
                  (xv (cadr (cadr e))) (yv (cadr (caddr e))))
             (dk-lam-b-h! e)
             (let ((e2 (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-contains? f '+))) "the reduced equation")))
               (cxl-int-facts! xv 10 11) (cxl-int-facts! yv 10 11)
               (dk-nn! e2))))
          ((dk-contains? g 'NOT)
           (di) (di)
           (let ()
             (let ((xv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 10 11)) (symbol? (cadr f)))) (dk-asms)))))
               (cxl-int-facts! xv 10 11) (cxl-int-facts! xv 30 33)
               (dks-nn-absurd! `(<= 30 ,xv) `(<= ,xv 11)))))
