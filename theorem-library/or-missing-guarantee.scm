;; Y in (NODES CX-SP) in context: run BODY on each node (k j) of the bundle with (= Y (LIST k j)) in context
(define (cxl-node-cases! y body)
  (let* ((parts (dk-cite! 'node-parts 'CX-SP y))
         (i `(NTH 2 ,y)) (k `(NTH 1 ,y))
         (len `(LENGTH ((STRAND-MAP CX-SP) ,i))))
    (dk-split! parts)
    (dk-cite! 'cx-sp@ids)
    (dk-rewrite-h! `(IN ,i (IDS CX-SP)) '(IDS CX-SP) '(INTERVAL 1 8))
    (cxl-int-facts! i 1 8)
    (cxl-range-cases! i 1 8
      (lambda (j)
        (let ((lj (list-ref cxl-lens (- j 1))))
          (dk-have! `(= ,len ,lj) (lambda () (subst `(= ,i ,j)) (cxl-ground-close!)))
          (dk-rewrite-h! `(<= ,k ,len) len lj)
          (cxl-range-cases! k 1 lj
            (lambda (kk)
              (let ((leaf (proof-state-focus *ps*)))
                (dk-have! `(= ,y (LIST ,kk ,j))
                  (lambda ()
                    (subst `(= ,y (LIST ,k ,i)))
                    (subst `(= ,k ,kk))
                    (subst `(= ,i ,j))
                    (cxl-ground-close!)))
                (if (not (sequent-node-grounded? leaf)) (body kk j))))))))))

