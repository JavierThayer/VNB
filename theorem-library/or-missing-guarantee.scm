(define (cxl-78-hyps orp c s a b na m k)
  (let ((sp `(ISPACE (SK-INF ,orp))) (isp `(SK-INF ,orp)))
    (list `(IS-OR-SPACE ,orp) `(IS-BUNDLE ,c) `(= (BSPACE ,c) ,sp) `(IN ,s (IDS ,sp)) `(NOT (= ,a ,b))
          `(UNIQUELY-ORIGINATES ,sp ,na)
          `(NOT (IN ((LTKEY ,orp) ,a) (ADV-TOKENS ,isp))) `(NOT (IN ((LTKEY ,orp) ,b) (ADV-TOKENS ,isp)))
          `(IS-OR-INIT ,orp ((STRAND-MAP ,sp) ,s) ,a ,b ,na ,m ,k)
          `(IN (LIST 2 ,s) (BNODES ,c)))))
(define (cxl-78-strong orp c a b m k)
  (let ((sp `(ISPACE (SK-INF ,orp))) (isp `(SK-INF ,orp)))
    `(FORSOME sr (AND (IN sr (IDS ,sp)) (AND (NOT (IN sr (ADV-IDS ,isp))) (AND (IN (LIST 2 sr) (BNODES ,c))
       (FORSOME nb (FORSOME h0 (FORSOME g0 (IS-OR-RESP ,orp ((STRAND-MAP ,sp) sr) ,a ,b nb ,m ,k h0 g0))))))))))

(sp (make-wff `(FORSOME orp (FORSOME c (FORSOME s (FORSOME a (FORSOME b (FORSOME na (FORSOME m (FORSOME k
  ,(dks-and (append (cxl-78-hyps 'orp 'c 's 'a 'b 'na 'm 'k) (list `(NOT ,(cxl-78-strong 'orp 'c 'a 'b 'm 'k)))))))))))))))
