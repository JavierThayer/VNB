        ,(cxv-or (map (lambda (e) `(= cxe_ (LIST ,(cxv-node (car e)) ,(cxv-node (cadr e))))) cxv-edges))))
(define (cxl-edge-src i) (cxv-node (car (list-ref cxv-edges (- i 1)))))
(define (cxl-edge-tgt i) (cxv-node (cadr (list-ref cxv-edges (- i 1)))))
