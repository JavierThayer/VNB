;; (IN (LIST k j) (NODES CX-SP)) for a node of the bundle
(define (cxl-node-in! k j)
  (let ((g `(IN (LIST ,k ,j) ,cxl-N)))
    (if (not (dk-asm? g))
        (begin
          (cxl-nat! k) (cxl-le! 1 k)
          (dk-have! `(IN ,j (IDS CX-SP)) (lambda () (subst (dk-cite! 'cx-sp@ids)) (cxl-in-int! j 1 8) (dk-ass!)))
          (dk-have! `(<= ,k (LENGTH ((STRAND-MAP CX-SP) ,j))) (lambda () (cxl-ground-close!)))
          (dk-cite! 'node-intro 'CX-SP k j)))
    g))

(sp (make-wff `(IN ,cxl-N SET)))
