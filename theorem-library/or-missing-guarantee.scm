             (dk-have! `(= ,x ,(+ (cadr x) 20)) (lambda () (cxl-ground-close!)))
             (subst `(= ,x ,(+ (cadr x) 20)))
             (cxl-close-atom! ro)))
          ((and (dk-head-is? g 'NOT) (dk-head-is? (cadr g) 'FORSOME))
           ;; the strengthened conclusion fails
           (di)
           (let* ((ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) (dk-asms)))
