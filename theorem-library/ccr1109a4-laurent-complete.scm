        (let ((iff (dk-cite! 'image-membership-iff e cc g)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew x)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (mac 'LAURENT-EXT)
                                  (dk-lam-b!)
                                  (c4c-nth-all!)
                                  (dk-fun-ext! lhs g 'ZZ ck #f #f
                                    (lambda (v)
                                      (dk-cite! 'zz-in-rr v)
