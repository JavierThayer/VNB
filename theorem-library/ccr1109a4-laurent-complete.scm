;;; ---- Remark 1.36 (iv): |h| <= r^N iff h vanishes below N (0 < r < 1) ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c4c-all 'rq_ 'RR `(IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
   ,(c4c-all 'fq_ '(LAURENT-SET kq_) (c4c-all 'nq_ 'ZZ
      `(IFF (<= (LAURENT-ABS kq_ rq_ fq_) (RPOW-STAR rq_ nq_)) ,(c4c-below 'kq_ 'fq_ 'nq_)))))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (n 'nq_) (lz '(LAURENT-ZERO kq_)) (rn '(RPOW-STAR rq_ nq_)))
  (dk-cite! 'zz-in-rr n) (dk-cite! 'rpow-star-in-rr r n) (dk-chain-ass! (dk-cite! 'rpow-star-pos r n))
  (dk-cite! 'ring-zero-in k)
