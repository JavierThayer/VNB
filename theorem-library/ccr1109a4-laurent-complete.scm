            (let ((j (cadr (cadr (dk-goal)))))
              (dk-cite! 'zz-in-rr j)
              (dk-have! `(< ,j ,o) (lambda () (dk-ineq! `(< ,j ,n) `(<= ,n ,o))))
              (dk-chain-ass! (dk-apply! (c4c-below k f o) j))
              (dk-close-if-asm!)))
          (lambda ()
