    (lambda ()
      (dk-chain-ass! (dk-cite! 'laurent-abs-nonzero k r f))
      (dk-split-all!)
      (let* ((o (c4c-ord! k f)) (ro `(RPOW-STAR ,r ,o)))
        (dk-cite! 'rpow-star-in-rr r o)
        (subst `(= (LAURENT-ABS ,k ,r ,f) (RPOW-STAR ,r (LAURENT-ORD ,k ,f))))
        (subst `(= (LAURENT-ORD ,k ,f) ,o))
        (dk-iff! (lambda (g) (or (dk-head-is? g 'FORALL) (and (dk-head-is? g 'IMPLIES) (dk-head-is? (caddr g) 'FORALL))))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
            (dk-have! `(<= ,n ,o)
