    (dk-chain-ass! (dk-cite! 'r-exp-mono `(* ,nv ,l) le))
    (dk-chain-ass! (dk-cite! 'r-exp-log 'ep_))
    (dk-chain-ass! (dk-cite! 'rpow-star-value 'rq_ nv))
    (ew nv)
