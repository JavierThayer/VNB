;;; ---- d(f, g) <= r^N iff f and g agree below N ----
(sp (make-wff (c4c-hyps (c4c-all 'fq_ c4c-ls (c4c-all 'gq_ c4c-ls (c4c-all 'nq_ 'ZZ
   `(IFF (<= ((DIST ,c4c-ms) fq_ gq_) (RPOW-STAR rq_ nq_)) ,(c4c-agree 'fq_ 'gq_ 'nq_))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (g 'gq_) (n 'nq_) (ng '(LAURENT-NEG kq_ gq_)) (h `(LAURENT-ADD kq_ fq_ ,ng))
       (bh (c4c-below k h n)) (ag (c4c-agree f g n)))
  (c4c-k-setup!)
  (dk-cite! 'laurent-neg-in k g)
  (dk-cite! 'laurent-add-in k f ng)
  (c4c-lfun! k f) (c4c-lfun! k g)
  (subst (dk-cite! 'laurent-nf-dist k r f g))
  (let ((iff1 (dk-cite! 'laurent-abs-le-iff k r h n))
        (open-j! (lambda ()
                   (dk-peel!)
                   (let ((j (cadr (cadr (dk-goal)))))
                     (c4c-app! k f j) (c4c-app! k g j)
                     (dk-cite! 'laurent-add-apply k f ng j)
                     (dk-cite! 'laurent-neg-apply k g j)
                     j))))
    (dk-have! `(IFF ,bh ,ag)
      (lambda ()
        (dk-iff! (lambda (gl) (or (equal? gl ag) (and (dk-head-is? gl 'IMPLIES) (equal? (caddr gl) ag))))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
            (let* ((j (open-j!))
                   (e0 (dk-chain-ass! (dk-apply! bh j)))
                   (e1 (dk-rewrite-h! e0 `(,h ,j) `((ADD ,k) (,f ,j) (,ng ,j))))
                   (e2 (dk-rewrite-h! e1 `(,ng ,j) `((NEG ,k) (,g ,j)))))
              (dk-chain-ass! (dk-cite! 'lza-ring-sub-zero k `(,f ,j) `(,g ,j)))
              (dk-close-if-asm!)))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
            (let ((j (open-j!)))
              (dk-chain-ass! (dk-apply! ag j))
              (subst `(== (,h ,j) ((ADD ,k) (,f ,j) (,ng ,j))))
              (subst `(== (,ng ,j) ((NEG ,k) (,g ,j))))
              (subst `(= (,f ,j) (,g ,j)))
              (dk-cite! 'ring-add-right-inv k `(,g ,j))
              (dk-close-if-asm!))))))
    (keep iff1 `(IFF ,bh ,ag))
    (prop)))
(qed 'laurent-dist-le-iff)

;;; =======================================================================
;;; CCR 1.38, CORRECTED.  The notes' "metric convergence = coefficientwise convergence in the discrete topology"
;;; is false (x^(-n) -> 0 coefficientwise, |x^(-n)| = r^(-n) -> infinity).  The true statement: s_n -> L iff
;;; the coefficients settle UNIFORMLY on every half-line j < N.
;;; =======================================================================
(define (c4c-near s l)
  `(FORALL nq_ (IMPLIES (IN nq_ ZZ) (FORSOME mq_ (AND (IN mq_ NN)
     (FORALL iq_ (IMPLIES (IN iq_ NN) (IMPLIES (<= mq_ iq_) ,(c4c-agree `(,s iq_) l 'nq_)))))))))
(define (c4c-stab s)
  `(FORALL nq_ (IMPLIES (IN nq_ ZZ) (FORSOME mq_ (AND (IN mq_ NN)
     (FORALL iq_ (IMPLIES (IN iq_ NN) (IMPLIES (<= mq_ iq_)
       (FORALL ir_ (IMPLIES (IN ir_ NN) (IMPLIES (<= mq_ ir_) ,(c4c-agree `(,s iq_) `(,s ir_) 'nq_))))))))))))
;; s in FUN(NN, LAURENT-SET K) in context: land s(i) in LAURENT-SET K and its FUN typing
(define (c4c-si! k s i)
  (dk-have-and! `(IN ,s (FUN NN ,c4c-ls)) `(IN ,i NN))
  (dk-cite! 'fun-apply-type s 'NN c4c-ls i)
  (c4c-lfun! k `(,s ,i)))
(define (c4c-pts! x)
  (if (not (dk-asm? `(IN ,x (PTS ,c4c-ms))))
      (dk-rewrite-h! `(IN ,x ,c4c-ls) c4c-ls `(PTS ,c4c-ms))))
(define (c4c-rpow! n)
  (dk-cite! 'zz-in-rr n) (dk-cite! 'rpow-star-in-rr 'rq_ n) (dk-chain-ass! (dk-cite! 'rpow-star-pos 'rq_ n))
  (c4c-pos-rr! `(RPOW-STAR rq_ ,n)))

(sp (make-wff (c4c-hyps (c4c-all 'sq_ `(FUN NN ,c4c-ls) (c4c-all 'lq_ c4c-ls
   `(IFF (CONVERGES-TO ,c4c-ms sq_ lq_) ,(c4c-near 'sq_ 'lq_)))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (s 'sq_) (l 'lq_) (m c4c-ms) (cv `(CONVERGES-TO ,c4c-ms sq_ lq_)) (nr (c4c-near 'sq_ 'lq_)))
  (c4c-k-setup!)
  (dk-cite! 'laurent-nf-pts k r)
  (dk-cite! 'nf-metric-space-is-metric-space c4c-nf)
  (dk-iff! (lambda (gl) (or (equal? gl nr) (and (dk-head-is? gl 'IMPLIES) (equal? (caddr gl) nr))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (let ((law (dk-project! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME N (AND (IN N NN) (FORALL n_ (IMPLIES (IN n_ NN)
                                  (IMPLIES (<= N n_) (<= ((DIST ,m) (,s n_) ,l) eps))))))))
                              'converges-to cv)))
        (let* ((landed (dk-peel!))
               (n (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
          (c4c-rpow! n)
          (let ((m0 (dk-skolem! (dk-chain-ass! (dk-apply! law `(RPOW-STAR ,r ,n))))))
            (ew m0)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (dk-peel!)
                      (let* ((g (dk-goal)) (j (cadr (cadr g))) (i (cadr (car (cadr g)))))
                        (c4c-si! k s i)
                        (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'DIST) (dk-contains? h m0))) "the m0 law")))
                          (dk-chain-ass! (dk-apply! lw i)))
                        (dk-iff-fwd! (dk-cite! 'laurent-dist-le-iff k r `(,s ,i) l n))
                        (dk-chain-ass! (dk-apply! (c4c-agree `(,s ,i) l n) j))
                        (dk-close-if-asm!))))))))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (mac 'converges-to)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'IN) (subst `(== (PTS ,m) ,c4c-ls)) (dk-close-if-asm!))
              ((dk-head-is? g 'FORALL)
               (let* ((landed (dk-peel!))
                      (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) landed)))
                      (z (dk-skolem! (dk-chain-ass! (dk-cite! 'rpow-star-small r e)))))
                 (dk-split-all!)
                 (dk-cite! 'nn-subset-zz z)
                 (c4c-rpow! z)
                 (dk-cite! 'rr-pos-rr-in-rr e)
                 (let ((m0 (dk-skolem! (dk-chain-ass! (dk-apply! nr z)))))
                   (ew m0)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-ass!))
                           (let* ((landed2 (dk-peel!)) (g2 (dk-goal)) (i (cadr (cadr (cadr g2)))))
                             (c4c-si! k s i)
                             (let ((lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m0) (dk-contains? h 'lzj))) "the m0 law")))
                               (dk-chain-ass! (dk-apply! lw i)))
                             (dk-iff-bwd! (dk-cite! 'laurent-dist-le-iff k r `(,s ,i) l z))
                             (c4c-pts! `(,s ,i)) (c4c-pts! l)
                             (dk-cite! 'metric-dist-real m `(,s ,i) l)
                             (dk-ineq! `(<= ((DIST ,m) (,s ,i) ,l) (RPOW-STAR ,r ,z)) `(<= (RPOW-STAR ,r ,z) ,e)))))))))
              (#t (error "c4c converges: unexpected" (expression->string g))))))))))
(qed 'laurent-converges-iff)

;;; =======================================================================
;;; CCR 1.40, completeness
;;; =======================================================================
;;; a Cauchy sequence of K((x)) stabilises below every N
(sp (make-wff (c4c-hyps `(FORALL sq_ (IMPLIES (IS-CAUCHY-SEQ ,c4c-ms sq_) ,(c4c-stab 'sq_))))))
(let* ((c4c-landed0 (dk-peel!)) (k 'kq_) (r 'rq_) (s 'sq_) (m c4c-ms) (h `(IS-CAUCHY-SEQ ,c4c-ms sq_)))
  (c4c-k-setup!)
  (dk-cite! 'laurent-nf-pts k r)
  (dk-project! `(IN ,s (FUN NN (PTS ,m))) 'is-cauchy-seq h)
  (dk-rewrite-h! `(IN ,s (FUN NN (PTS ,m))) `(PTS ,m) c4c-ls)
  (let ((law (dk-project! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME N (AND (IN N NN) (FORALL m (IMPLIES (IN m NN) (FORALL n_ (IMPLIES (IN n_ NN)
                              (IMPLIES (AND (<= N m) (<= N n_)) (<= ((DIST ,m) (,s m) (,s n_)) eps))))))))))
                          'is-cauchy-seq h)))
    (let* ((landed c4c-landed0)
           (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed))))
      (c4c-rpow! n)
      (let ((m0 (dk-skolem! (dk-chain-ass! (dk-apply! law `(RPOW-STAR ,r ,n))))))
        (ew m0)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (dk-peel!)
                  (let* ((g (dk-goal)) (j (cadr (cadr g))) (i (cadr (car (cadr g)))) (i2 (cadr (car (caddr g)))))
                    (c4c-si! k s i) (c4c-si! k s i2)
                    (dk-have-and! `(<= ,m0 ,i) `(<= ,m0 ,i2))
                    (let ((lw (dk-pick (lambda (hh) (and (dk-head-is? hh 'FORALL) (dk-contains? hh 'DIST) (dk-contains? hh m0))) "the m0 law")))
                      (dk-chain-ass! (dk-apply! lw i i2)))
                    (dk-iff-fwd! (dk-cite! 'laurent-dist-le-iff k r `(,s ,i) `(,s ,i2) n))
                    (dk-chain-ass! (dk-apply! (c4c-agree `(,s ,i) `(,s ,i2) n) j))
                    (dk-close-if-asm!))))))))))
(qed 'laurent-cauchy-stab)

;;; ---- the eventual value LAURENT-LIMC: when s_i(j) = s_M(j) for all i >= M, it is that value ----
(define (c4c-nadd! a b)
  (let ((n `(+ ,a ,b)))
    (dk-have-and! `(IN ,a NN) `(IN ,b NN))
    (dk-chain-ass! (dk-cite! 'nn-add-closed a b))
    (dk-cite! 'nn-le-add-right b a)
    (dk-cite! 'nn-le-add-left a b)
    n))
(define (c4c-limc-hyp s j m0)
  `(FORALL iq_ (IMPLIES (IN iq_ NN) (IMPLIES (<= ,m0 iq_) (= ((,s iq_) ,j) ((,s ,m0) ,j))))))
(sp (make-wff `(FORALL kq_ ,(c4c-all 'sq_ `(FUN NN ,c4c-ls) (c4c-all 'jq_ 'ZZ (c4c-all 'mq_ 'NN
   `(IMPLIES ,(c4c-limc-hyp 'sq_ 'jq_ 'mq_)
      (AND (IN (LAURENT-LIMC kq_ sq_ jq_) (CARR kq_))
           (FORALL iq_ (IMPLIES (IN iq_ NN) (IMPLIES (<= mq_ iq_) (= ((sq_ iq_) jq_) (LAURENT-LIMC kq_ sq_ jq_)))))))))))))
(dk-peel!)
(let* ((k 'kq_) (s 'sq_) (j 'jq_) (m0 'mq_) (hh (c4c-limc-hyp 'sq_ 'jq_ 'mq_)) (c0 `((,s ,m0) ,j)))
  (c4c-si! k s m0) (c4c-app! k `(,s ,m0) j)
  (mac 'LAURENT-LIMC)
  (let* ((io (cadr (cadr (dk-goal))))
         ;; the second witness: a point y with its own threshold law; returns n past both thresholds
         (other! (lambda (y)
                   (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h y))) "the threshold"))
                          (m1 (dk-skolem! ex))
                          (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h y) (dk-contains? h m1))) "the threshold law"))
                          (n (c4c-nadd! m0 m1)))
                     (dk-chain-ass! (dk-apply! lw n))
                     (dk-chain-ass! (dk-apply! hh n))
                     n))))
    (for-each
      (lambda (l)
        (dk-focus! l)
        (if (dk-head-is? (dk-goal) 'FORSOME)
            (begin
              (ew c0)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-asm? g) (dk-ass!))
                      ((dk-head-is? g 'FORSOME)
                       (ew m0)
                       (dk-conj-close!
                         (lambda ()
                           (if (not (dk-ass!))
                               (begin
                                 (dk-peel!)
                                 (let ((n (cadr (car (cadr (dk-goal))))))
                                   (dk-chain-ass! (dk-apply! hh n))
                                   (dk-close-if-asm!)))))))
                      ((dk-head-is? g 'FORALL)
                       (dk-peel!)
                       (dk-split-all!)
                       (let* ((y (caddr (dk-goal))) (n (other! y)))
                         (subst `(= ,c0 ((,s ,n) ,j)))
                         (dk-close-if-asm!)))
                      (#t (error "c4c limc: unexpected" (expression->string g))))))))
            (begin
              (dk-split-all!)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (dk-peel!)
                        (let* ((i (cadr (car (cadr (dk-goal))))) (n (other! io)))
                          (dk-chain-ass! (dk-apply! hh i))
                          (subst `(= ((,s ,i) ,j) ,c0))
                          (subst `(= ,c0 ((,s ,n) ,j)))
                          (dk-close-if-asm!)))))))))
      (dk-opened (lambda () (iota-d io))))))
(qed 'laurent-limc-spec)

(sp (make-wff `(FORALL kq_ (FORALL sq_ ,(c4c-all 'jq_ 'ZZ '(== ((LAURENT-LIM kq_ sq_) jq_) (LAURENT-LIMC kq_ sq_ jq_)))))))
(dk-peel!)
(mac 'LAURENT-LIM)
(dk-lam-b!)
(if (pair? (dk-open-leaves)) (qrfl))
(qed 'laurent-lim-apply)

;;; ---- a sequence stabilising below every N comes uniformly close to LAURENT-LIM ----
(sp (make-wff `(FORALL kq_ ,(c4c-all 'sq_ `(FUN NN ,c4c-ls) `(IMPLIES ,(c4c-stab 'sq_) ,(c4c-near 'sq_ '(LAURENT-LIM kq_ sq_)))))))
(let* ((landed (dk-peel!)) (k 'kq_) (s 'sq_) (lim '(LAURENT-LIM kq_ sq_)) (st (c4c-stab 'sq_))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed)))
       (m0 (dk-skolem! (dk-chain-ass! (dk-apply! st n))))
       (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m0) (dk-contains? h 'lzj))) "the m0 law")))
  (ew m0)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (dk-peel!)
            (let* ((g (dk-goal)) (j (cadr (cadr g))) (i (cadr (car (cadr g)))) (hh (c4c-limc-hyp s j m0)))
              (dk-cite! 'nn-le-refl m0)
              (dk-have! hh
                (lambda ()
                  (dk-peel!)
                  (let ((i2 (cadr (car (cadr (dk-goal))))))
                    (dk-chain-ass! (dk-apply! lw i2 m0))
                    (dk-chain-ass! (dk-apply! (c4c-agree `(,s ,i2) `(,s ,m0) n) j))
                    (dk-close-if-asm!))))
              (dk-chain-ass! (dk-cite! 'laurent-limc-spec k s j m0))
              (dk-split-all!)
              (dk-chain-ass! (dk-apply! `(FORALL iq_ (IMPLIES (IN iq_ NN) (IMPLIES (<= ,m0 iq_) (= ((,s iq_) ,j) (LAURENT-LIMC ,k ,s ,j))))) i))
              (subst (dk-cite! 'laurent-lim-apply k s j))
              (dk-close-if-asm!)))))))
(qed 'laurent-lim-near)

;;; ---- ... and LAURENT-LIM is then a Laurent series ----
(sp (make-wff `(FORALL kq_ ,(c4c-all 'sq_ `(FUN NN ,c4c-ls) `(IMPLIES ,(c4c-stab 'sq_) (IN (LAURENT-LIM kq_ sq_) ,c4c-ls))))))
(dk-peel!)
(let* ((k 'kq_) (s 'sq_) (lim '(LAURENT-LIM kq_ sq_)) (nr (c4c-near 'sq_ '(LAURENT-LIM kq_ sq_)))
       ;; at a threshold m0 for N: s_m0(j) = LIM(j) for j < N
       (at! (lambda (n j)
              (let* ((m0 (dk-skolem! (dk-chain-ass! (dk-apply! nr n))))
                     (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m0) (dk-contains? h 'lzj))) "the near law")))
                (dk-cite! 'nn-le-refl m0)
                (dk-chain-ass! (dk-apply! lw m0))
                (c4c-si! k s m0)
                m0))))
  (dk-chain-ass! (dk-cite! 'laurent-lim-near k s))
  (fact 'zz-one-in) (fact 'zz-zero-in) (fact 'rr-zero-in)
  (dk-have! `(IN ,lim (FUN ZZ (CARR ,k)))
    (lambda ()
      (mac 'LAURENT-LIM)
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (begin
                (dk-peel!)
                (let* ((j (cadddr (cadr (dk-goal)))) (j1 `(+ ,j 1)))
                  (dk-have-and! `(IN ,j ZZ) '(IN 1 ZZ))
                  (dk-chain-ass! (dk-cite! 'zz-add-closed j 1))
                  (dk-cite! 'zz-in-rr j)
                  (dk-have! `(< ,j ,j1) (lambda () (dk-ineq!)))
                  (let ((m0 (at! j1 j)))
                    (dk-chain-ass! (dk-apply! (c4c-agree `(,s ,m0) lim j1) j))
                    (c4c-app! k `(,s ,m0) j)
                    (dk-cite! 'laurent-lim-apply k s j)
                    (subst `(= (LAURENT-LIMC ,k ,s ,j) (,lim ,j)))
                    (subst `(= (,lim ,j) ((,s ,m0) ,j)))
                    (dk-close-if-asm!))))
              (begin (fact 'zz-is-set) (dk-close-if-asm!)))))))
  (let* ((m0 (at! 0 #f))
         (b0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h `(,s ,m0)))) "the bound of s_m0")))
         (fin! (lambda (b)
                 (let ((bl `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,lim lzj) (ZERO ,k)))))))
                   (dk-have! bl
                     (lambda ()
                       (dk-peel!)
                       (let ((j (cadr (cadr (dk-goal)))))
                         (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list j b b0))
                         (dk-have! `(< ,j 0) (lambda () (dk-ineq! `(< ,j ,b) `(<= ,b 0))))
                         (dk-have! `(< ,j ,b0) (lambda () (dk-ineq! `(< ,j ,b) `(<= ,b ,b0))))
                         (dk-chain-ass! (dk-apply! (c4c-agree `(,s ,m0) lim 0) j))
                         (dk-chain-ass! (dk-apply! (c4c-below k `(,s ,m0) b0) j))
                         (subst `(= (,lim ,j) ((,s ,m0) ,j)))
                         (dk-close-if-asm!))))
                   (dk-chain-ass! (dk-cite! 'laurent-set-in k lim b))
                   (dk-close-if-asm!)))))
    (dk-split-all!)
    (dk-cite! 'zz-in-rr b0)
    (use-em `(<= ,b0 0)
      (lambda () (dk-have! `(<= ,b0 ,b0) (lambda () (dk-ineq!))) (fin! b0))
      (lambda ()
        (dk-chain-ass! (dk-cite! 'rr-not-le-lt b0 0))
        (dk-have! `(<= 0 ,b0) (lambda () (dk-ineq! `(< 0 ,b0))))
        (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
        (fin! 0)))))
(qed 'laurent-lim-in)

;;; ---- CCR 1.40: K((x)) is complete (K a field, 0 < r < 1) ----
(sp (make-wff (c4c-hyps `(IS-COMPLETE ,c4c-ms))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (m c4c-ms))
  (c4c-k-setup!)
  (dk-cite! 'laurent-nf-pts k r)
  (dk-cite! 'nf-metric-space-is-metric-space c4c-nf)
  (mac 'is-complete)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-peel!))
                 (h (find-first (lambda (f) (dk-head-is? f 'IS-CAUCHY-SEQ)) landed))
                 (f (caddr h)) (lim `(LAURENT-LIM ,k ,f)))
            (dk-project! `(IN ,f (FUN NN (PTS ,m))) 'is-cauchy-seq h)
            (dk-rewrite-h! `(IN ,f (FUN NN (PTS ,m))) `(PTS ,m) c4c-ls)
            (dk-chain-ass! (dk-cite! 'laurent-cauchy-stab k r f))
            (dk-chain-ass! (dk-cite! 'laurent-lim-in k f))
            (dk-chain-ass! (dk-cite! 'laurent-lim-near k f))
            (mac 'converges)
            (ew lim)
            (dk-iff-bwd! (dk-cite! 'laurent-converges-iff k r f lim))
            (dk-close-if-asm!))))))
(qed 'laurent-nf-complete)

;;; =======================================================================
;;; The integers of K((x)): Z = {f : |f| <= 1} is K[[x]], closed, and complete
;;; =======================================================================
(define c4c-zi '(NV-INTEGERS (LAURENT-NF kq_ rq_)))
(sp (make-wff (c4c-hyps (c4c-all 'fq_ c4c-ls `(= ((FNRM ,c4c-nf) fq_) (LAURENT-ABS kq_ rq_ fq_))))))
(dk-peel!)
(c4c-k-setup!)
(dk-fact-split! 'laurent-abs-in-rr 'kq_ 'rq_ 'fq_)
(subst (dk-cite! 'laurent-nf-fnrm 'kq_ 'rq_))
(subst `(== (CARR ,c4c-lr) ,c4c-ls))
(dk-lam-b!)
(c4c-rfl!)
(qed 'laurent-nf-fnrm-apply)

;; f is integral iff f is a power series: f in K((x)) vanishing below 0
(sp (make-wff (c4c-hyps `(FORALL fq_ (IFF (IN fq_ ,c4c-zi) (AND (IN fq_ ,c4c-ls) ,(c4c-below 'kq_ 'fq_ 0)))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (rhs `(AND (IN fq_ ,c4c-ls) ,(c4c-below 'kq_ 'fq_ 0))))
  (c4c-k-setup!)
  (fact 'zz-zero-in)
  (dk-chain-ass! (dk-cite! 'rpow-star-zero r))
  (subst (dk-cite! 'nv-integers-unfold c4c-nf))
  (dk-iff! (lambda (gl) (or (equal? gl rhs) (and (dk-head-is? gl 'IMPLIES) (equal? (caddr gl) rhs))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (let* ((mem (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) f) (dk-head-is? (caddr h) 'SEP))) (dk-asms))))
        (dk-sep-parts! mem)
        (dk-split-all!)
        (let ((h1 (dk-rewrite-h! `(IN ,f (CARR ,c4c-nf)) `(CARR ,c4c-nf) `(CARR ,c4c-lr))))
          (dk-rewrite-h! h1 `(CARR ,c4c-lr) c4c-ls))
        (dk-chain-ass! (dk-cite! 'laurent-nf-fnrm-apply k r f))
        (let* ((b1 (dk-rewrite-h! `(<= ((FNRM ,c4c-nf) ,f) 1) `((FNRM ,c4c-nf) ,f) `(LAURENT-ABS ,k ,r ,f)))
               (b2 (dk-rewrite-h! b1 1 `(RPOW-STAR ,r 0))))
          (dk-iff-fwd! (dk-cite! 'laurent-abs-le-iff k r f 0))
          (dk-conj-close! (lambda () (dk-ass!))))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (dk-split-all!)
      (c4c-in-nf! f)
      (dk-chain-ass! (dk-cite! 'laurent-nf-fnrm-apply k r f))
      (dk-iff-bwd! (dk-cite! 'laurent-abs-le-iff k r f 0))
      (in-sep! (lambda () (dk-close-if-asm!))
               (lambda ()
                 (subst `(= ((FNRM ,c4c-nf) ,f) (LAURENT-ABS ,k ,r ,f)))
                 (subst `(= 1 (RPOW-STAR ,r 0)))
                 (dk-close-if-asm!))))))
(qed 'laurent-integers-iff)

;; the integers are closed in K((x))
(sp (make-wff (c4c-hyps `(IS-CLOSED ,c4c-ms ,c4c-zi))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (m c4c-ms) (a c4c-zi))
  (c4c-k-setup!)
  (dk-cite! 'laurent-nf-pts k r)
  (dk-cite! 'nf-metric-space-is-metric-space c4c-nf)
  (fact 'zz-zero-in)
  (dk-have! `(SUBSET ,a (PTS ,m))
    (lambda ()
      (mac 'subset-def)
      (let* ((landed (dk-peel!)) (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
        (dk-iff-fwd! (dk-cite! 'laurent-integers-iff k r x))
        (subst `(== (PTS ,m) ,c4c-ls))
        (dk-close-if-asm!))))
  (let* ((iff (dk-chain-ass! (dk-cite! 'closed-iff-sequentially-closed m a))))
    (dk-have! (caddr iff)
      (lambda ()
        (let* ((landed (dk-peel!))
               (cv (find-first (lambda (f) (dk-head-is? f 'CONVERGES-TO)) landed))
               (f (caddr cv)) (l (cadddr cv)))
          (dk-project! `(IN ,f (FUN NN (PTS ,m))) 'converges-to cv)
          (dk-project! `(IN ,l (PTS ,m)) 'converges-to cv)
          (dk-rewrite-h! `(IN ,f (FUN NN (PTS ,m))) `(PTS ,m) c4c-ls)
          (dk-rewrite-h! `(IN ,l (PTS ,m)) `(PTS ,m) c4c-ls)
          (dk-iff-fwd! (dk-cite! 'laurent-converges-iff k r f l))
          (let* ((nr (c4c-near f l))
                 (m0 (dk-skolem! (dk-chain-ass! (dk-apply! nr 0))))
                 (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m0) (dk-contains? h 'lzj))) "the near law")))
            (dk-cite! 'nn-le-refl m0)
            (dk-chain-ass! (dk-apply! lw m0))
            (dk-have-and! `(IN ,f (FUN NN ,a)) `(IN ,m0 NN))
            (dk-cite! 'fun-apply-type f 'NN a m0)
            (dk-iff-fwd! (dk-cite! 'laurent-integers-iff k r `(,f ,m0)))
            (dk-have! (c4c-below k l 0)
              (lambda ()
                (dk-peel!)
                (let ((j (cadr (cadr (dk-goal)))))
                  (dk-chain-ass! (dk-apply! (c4c-agree `(,f ,m0) l 0) j))
                  (dk-chain-ass! (dk-apply! (c4c-below k `(,f ,m0) 0) j))
                  (subst `(= (,l ,j) ((,f ,m0) ,j)))
                  (dk-close-if-asm!))))
            (dk-have-and! `(IN ,l ,c4c-ls) (c4c-below k l 0))
            (dk-iff-bwd! (dk-cite! 'laurent-integers-iff k r l))
            (dk-close-if-asm!)))))
    (dk-iff-bwd! iff)
    (dk-close-if-asm!)))
(qed 'laurent-integers-closed)

(sp (make-wff (c4c-hyps `(IS-COMPLETE (SUBSPACE-MS ,c4c-ms ,c4c-zi)))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'laurent-nf-complete 'kq_ 'rq_))
(dk-chain-ass! (dk-cite! 'laurent-integers-closed 'kq_ 'rq_))
(dk-chain-ass! (dk-cite! 'subspace-complete c4c-ms c4c-zi))
(dk-close-if-asm!)
(qed 'laurent-integers-complete)

;;; ---- arbitrarily small non-zero elements: |x^z| = r^z ----
(define (c4c-x z) `(LAURENT-MONO kq_ (ONE kq_) ,z))
(sp (make-wff (c4c-hyps (c4c-all 'zq_ 'ZZ `(AND (IN ,(c4c-x 'zq_) ,c4c-ls) (AND (NOT (= ,(c4c-x 'zq_) (LAURENT-ZERO kq_)))
   (= (LAURENT-ABS kq_ rq_ ,(c4c-x 'zq_)) (RPOW-STAR rq_ zq_))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (z 'zq_) (h (c4c-x 'zq_)) (lz '(LAURENT-ZERO kq_)))
  (c4c-k-setup!)
  (dk-chain-ass! (dk-cite! 'ladet-field-one-ne k))
  (dk-cite! 'ring-one-in k)
  (dk-cite! 'laurent-mono-in k '(ONE kq_) z)
  (dk-cite! 'laurent-mono-at k '(ONE kq_) z)
  (dk-cite! 'laurent-mono-below k '(ONE kq_) z)
  (dk-have! `(NOT (= (,h ,z) (ZERO ,k)))
    (lambda () (subst `(= (,h ,z) (ONE ,k))) (di) (keep `(= (ONE ,k) (ZERO ,k)) `(NOT (= (ONE ,k) (ZERO ,k)))) (prop)))
  (dk-have! (c4c-ordp k h z) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-chain-ass! (dk-cite! 'laurent-ord-eq k h z))
  (dk-have! `(NOT (= ,h ,lz))
    (lambda ()
      (di)
      (dk-cite! 'laurent-zero-apply k z)
      (dk-have! `(= (,h ,z) (,lz ,z)) (lambda () (subst `(= ,h ,lz)) (dk-cite! 'laurent-zero-in k) (c4c-lfun! k lz) (c4c-app! k lz z) (c4c-rfl!)))
