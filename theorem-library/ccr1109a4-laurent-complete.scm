              (dk-cite! 'nn-subset-zz z)
              (dk-cite! 'zz-in-rr z) (dk-cite! 'rpow-star-in-rr r z)
              (ew f)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-asm? g) (dk-ass!))
                      ((dk-head-is? g 'IN) (dk-chain-ass! (dk-cite! 'laurent-polys-finite z k)) (dk-close-if-asm!))
                      ((dk-head-is? g 'IS-R-NET)
                       (mac 'is-r-net)
                       (dk-conj-close!
                         (lambda ()
                           (let ((g2 (dk-goal)))
                             (cond
                               ((dk-asm? g2) (dk-ass!))
                               ((dk-head-is? g2 'SUBSET)
                                (subst `(== (PTS ,sb) ,a))
                                (mac 'subset-def)
                                (let* ((l2 (dk-peel!)) (x (cadr (find-first (lambda (ff) (dk-head-is? ff 'IN)) l2))))
                                  (dk-chain-ass! (dk-cite! 'laurent-polys-sub-integers k r z x))
                                  (dk-close-if-asm!)))
                               ((dk-head-is? g2 'FORALL)
                                (let* ((l2 (dk-peel!))
                                       (p (cadr (find-first (lambda (ff) (dk-head-is? ff 'IN)) l2)))
                                       (pa (dk-rewrite-h! `(IN ,p (PTS ,sb)) `(PTS ,sb) a))
                                       (c `(LAURENT-TRUNC ,k ,p (+ ,z (- 1)))))
                                  (dk-iff-fwd! (dk-cite! 'laurent-integers-iff k r p))
                                  (c4c-lfun! k p)
                                  (dk-chain-ass! (dk-cite! 'laurent-trunc-poly k p z))
                                  (dk-split-all!)
                                  (dk-chain-ass! (dk-cite! 'laurent-polys-sub-integers k r z c))
                                  (dk-iff-fwd! (dk-cite! 'laurent-integers-iff k r c))
                                  (dk-iff-bwd! (dk-cite! 'laurent-dist-le-iff k r c p z))
                                  (c4c-pts! c) (c4c-pts! p)
                                  (dk-cite! 'metric-dist-real m c p)
                                  (let ((dm `((DIST ,m) ,c ,p)) (sd (dk-cite! 'subspace-dist m a c p)))
                                    (ew c)
                                    (dk-conj-close!
                                      (lambda ()
                                        (let ((g3 (dk-goal)))
                                          (cond
                                            ((dk-asm? g3) (dk-ass!))
                                            ((dk-head-is? g3 'NOT)
                                             (subst sd) (di) (dk-absurd! `(= ,dm ,rad) `(<= ,dm (RPOW-STAR ,r ,z)) `(<= (RPOW-STAR ,r ,z) ,d) `(= (+ ,d ,d) ,rad) `(< 0 ,d)))
                                            (#t (subst sd) (dk-ineq! `(<= ,dm (RPOW-STAR ,r ,z)) `(<= (RPOW-STAR ,r ,z) ,d) `(= (+ ,d ,d) ,rad) `(< 0 ,d))))))))))
                               (#t (error "c4c r-net: unexpected" (expression->string g2))))))))
                      (#t (error "c4c tb: unexpected" (expression->string g)))))))))))))
(qed 'laurent-integers-tb)

(sp (make-wff (c4c-fhyps `(IS-COMPACT ,c4c-sub))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (m c4c-ms) (a c4c-zi) (sb c4c-sub))
  (c4c-k-setup!)
