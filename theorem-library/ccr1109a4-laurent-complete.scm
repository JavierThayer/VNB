;;; =======================================================================
;;; K[[x]] is totally bounded when K is finite: the finite nets LAURENT-POLYS(K, z)
;;; =======================================================================
(define (c4c-above k g m) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (<= ,m lzj) (= (,g lzj) (ZERO ,k))))))
(define (c4c-polys m) `(LAURENT-POLYS kq_ ,m))
(define (c4c-polys-rhs k g m) `(AND (IN ,g (FUN ZZ (CARR ,k))) (AND ,(c4c-below k g 0) ,(c4c-above k g m))))
(define (c4c-card-sub! x sb claim)
  (let ((ch (dk-chain-ass! (dk-cite! 'card-subset-nn x))))
    (dk-have-and! `(IN ,sb SET) claim)
    (dk-chain-ass! (dk-apply! ch sb))))
(define (c4c-nth-all!) (let loop ((n 0)) (if (and (< n 10) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ n 1))))))

(sp (make-wff `(FORALL kq_ (FORALL mq_ (FORALL gq_ (IFF (IN gq_ (LAURENT-POLYS kq_ mq_)) ,(c4c-polys-rhs 'kq_ 'gq_ 'mq_)))))))
(dk-peel!)
(let ((rhs (c4c-polys-rhs 'kq_ 'gq_ 'mq_)))
  (mac 'LAURENT-POLYS)
  (dk-iff! (lambda (gl) (or (equal? gl rhs) (and (dk-head-is? gl 'IMPLIES) (equal? (caddr gl) rhs))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (dk-sep-parts! (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'gq_))) (dk-asms)))
      (dk-split-all!)
      (dk-conj-close! (lambda () (dk-ass!))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (dk-split-all!)
      (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))
(qed 'laurent-polys-iff)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL mq_ (IN (LAURENT-POLYS kq_ mq_) SET))))))
