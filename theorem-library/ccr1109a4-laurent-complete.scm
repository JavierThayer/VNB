      (let* ((landed (dk-peel!)) (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
        (dk-iff-fwd! (dk-cite! 'laurent-polys-iff k 'mq_ x))
        (dk-close-if-asm!))))
  (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set p fz))
