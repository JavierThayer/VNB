;;; =======================================================================
;;; The metric space of LAURENT-NF(K, r): points and distance read off
;;; =======================================================================
(define c4c-nf '(LAURENT-NF kq_ rq_))
(define c4c-ms '(NF-METRIC-SPACE (LAURENT-NF kq_ rq_)))
(define c4c-lr '(LAURENT-RING kq_))
(define c4c-ls '(LAURENT-SET kq_))
(define (c4c-hyps body)
  `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) ,(c4c-all 'rq_ 'RR `(IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1) ,body))))))
(define (c4c-k-setup!)
  (let ((k 'kq_) (r 'rq_))
    (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain k))
    (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
    (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
    (dk-cite! 'ring-zero-in k)
    (dk-chain-ass! (dk-cite! 'laurent-nf-is-normed-field k r))
    (dk-cite! 'laurent-nf-carr k r)
    (dk-cite! 'laurent-ring-carr k)))
(define (c4c-lfun! k f)
  (if (not (dk-asm? `(IN ,f (FUN ZZ (CARR ,k)))))
      (begin (dk-chain-ass! (dk-cite! 'laurent-set-out k f))
             (dk-split! (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (equal? (cadr h) `(IN ,f (FUN ZZ (CARR ,k)))))) "laurent-set-out")))))
(define (c4c-app! k f x)
  (dk-have-and! `(IN ,f (FUN ZZ (CARR ,k))) `(IN ,x ZZ))
  (dk-cite! 'fun-apply-type f 'ZZ `(CARR ,k) x))
;; f in LAURENT-SET in context: land f in CARR(LAURENT-NF K r)
(define (c4c-in-nf! f)
  (if (not (dk-asm? `(IN ,f (CARR ,c4c-nf))))
      (let ((h1 (dk-rewrite-h! `(IN ,f ,c4c-ls) c4c-ls `(CARR ,c4c-lr))))
        (dk-rewrite-h! h1 `(CARR ,c4c-lr) `(CARR ,c4c-nf)))))

(sp (make-wff (c4c-hyps `(== (PTS ,c4c-ms) ,c4c-ls))))
(dk-peel!)
(c4c-k-setup!)
(subst (dk-cite! 'nf-metric-carrier c4c-nf))
(subst `(== (CARR ,c4c-nf) (CARR ,c4c-lr)))
(subst `(== (CARR ,c4c-lr) ,c4c-ls))
(qrfl)
(qed 'laurent-nf-pts)

(sp (make-wff (c4c-hyps (c4c-all 'fq_ c4c-ls (c4c-all 'gq_ c4c-ls
   `(= ((DIST ,c4c-ms) fq_ gq_) (LAURENT-ABS kq_ rq_ (LAURENT-ADD kq_ fq_ (LAURENT-NEG kq_ gq_)))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (g 'gq_) (ng '(LAURENT-NEG kq_ gq_)) (h `(LAURENT-ADD kq_ fq_ ,ng)))
