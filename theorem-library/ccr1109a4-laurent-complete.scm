;;; ccr1109a4-laurent-complete.scm -- CCR.pdf 1.36 (iv), 1.38 (corrected) and 1.40 (completeness): the metric of
;;; K((x)) read off the coefficients, and K((x)) complete.
;;; Agent CCR-1109-A4, 2026-11-09.  Destination: theorem-library/ccr1109a4-laurent-complete.scm.  Library: analysis
;;; (RPOW-STAR, NF-METRIC-SPACE, IS-COMPLETE).  Helper prefix c4c-.
;;;
;;; The one fact everything rests on is Remark 1.36 (iv): for 0 < r < 1, |h| <= r^N iff h vanishes below N
;;; (laurent-abs-le-iff), read through the distance of NF-METRIC-SPACE(LAURENT-NF K r) as
;;;     d(f, g) <= r^N  iff  f and g agree below N                       (laurent-dist-le-iff).
;;; With r^N -> 0 (rpow-star-small) this gives the corrected 1.38: f_n -> f iff for every N there is M with
;;; f_n(j) = f(j) for all n >= M and j < N (laurent-converges-iff).  For completeness, a Cauchy sequence s
;;; stabilises below every N (laurent-cauchy-stab); its limit LAURENT-LIM(K, s) takes at j the eventual value
;;; of the coefficients s_n(j), an IOTA (vocabulary ccr1109a4-laurent-lim-vocab), and is a Laurent series because
;;; the coefficients below 0 are those of one s_M.
;;;
;;; Load window: after the vocabulary ccr1109a4-laurent-lim-vocab, theorem-library/ccr1109a3-laurent-field
;;; (laurent-nf-is-normed-field and the laurent-nf-* read-offs), ccr1109a3-laurent-val (laurent-abs-*,
;;; laurent-nonzero-ord, laurent-ord-eq, rpow-star-anti-exp), ccr1109a3-laurent-ring (laurent-ring-*,
;;; laurent-add-apply, laurent-neg-apply), rpow-star, r-exp (r-exp-strictly-increasing, r-exp-mono, r-exp-log),
;;; log laws, rr-archimedean-multiple, lza-ring-sub-zero, nf-metric-space-is-metric-space.

(define (c4c-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(define (c4c-all v c body) `(FORALL ,v (IMPLIES (IN ,v ,c) ,body)))
(define (c4c-below k f b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (ZERO ,k))))))
(define (c4c-agree f g b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (,g lzj))))))
(define (c4c-pos-rr! e)
  (dk-have! `(POS-RR ,e)
    (lambda () (mac 'pos-rr)
      (dk-conj-close! (lambda () (cond ((dk-ass!) #t)
                                       ((dk-head-is? (dk-goal) 'NOT) (let ((at (cadr (dk-goal)))) (di) (dk-absurd! at `(< 0 ,e))))
                                       (#t (dk-ineq! `(< 0 ,e)))))))))
;; f in LAURENT-SET, f /= 0 in context: return the order o, ordp(f, o) split in context, (= (LAURENT-ORD k f) o)
(define (c4c-ordp k f o) `(AND (IN ,o ZZ) (AND (NOT (= (,f ,o) (ZERO ,k))) ,(c4c-below k f o))))
(define (c4c-ord! k f)
  (let ((o (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-nonzero-ord k f)))))
    (dk-have! (c4c-ordp k f o) (lambda () (prop)))
    (dk-chain-ass! (dk-cite! 'laurent-ord-eq k f o))
    (for-each (lambda (c) (if (not (dk-asm? c)) (dk-have! c (lambda () (prop)))))
              (list `(IN ,o ZZ) `(NOT (= (,f ,o) (ZERO ,k))) (c4c-below k f o)))
    (dk-cite! 'zz-in-rr o)
    o))

;;; ---- RPOW-STAR is strictly decreasing in the exponent for a base 0 < r < 1 ----
(sp (make-wff '(FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
   (FORALL sq_ (IMPLIES (IN sq_ RR) (FORALL tq_ (IMPLIES (IN tq_ RR) (IMPLIES (< sq_ tq_)
     (< (RPOW-STAR rq_ tq_) (RPOW-STAR rq_ sq_)))))))))))))
(dk-peel!)
(let* ((l '(LOG rq_)) (a `(+ tq_ (- sq_))) (b `(- ,l)))
  (dk-cite! 'log-in-rr 'rq_)
  (dk-chain-ass! (dk-cite! 'log-neg-below-one 'rq_))
  (subst (dk-chain-ass! (dk-cite! 'rpow-star-value 'rq_ 'tq_)))
  (subst (dk-chain-ass! (dk-cite! 'rpow-star-value 'rq_ 'sq_)))
  (dk-have! `(IN ,a RR) (lambda () (in-rr)))
  (dk-have! `(IN ,b RR) (lambda () (in-rr)))
  (dk-have! `(< 0 ,a) (lambda () (dk-ineq! '(< sq_ tq_))))
  (dk-have! `(< 0 ,b) (lambda () (dk-ineq! `(< ,l 0))))
  (dk-chain-ass! (dk-cite! 'rr-mul-pos a b))
  (dk-rr-mul! 'sq_ l) (dk-rr-mul! 'tq_ l)
  (dk-have! `(= (* ,a ,b) (+ (* sq_ ,l) (- (* tq_ ,l)))) (lambda () (crs)))
  (let ((h (dk-rewrite-h! `(< 0 (* ,a ,b)) `(* ,a ,b) `(+ (* sq_ ,l) (- (* tq_ ,l))))))
    (dk-have! `(< (* tq_ ,l) (* sq_ ,l)) (lambda () (dk-ineq! h))))
  (dk-chain-ass! (dk-cite! 'r-exp-strictly-increasing `(* tq_ ,l) `(* sq_ ,l)))
  (dk-close-if-asm!))
(qed 'rpow-star-strict-anti)

