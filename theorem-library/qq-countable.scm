;;; theorem-library/qq-countable.scm -- THE RATIONALS ARE COUNTABLE (2026-10-26, after M-A / QQ-DEBT).
;;; Helper prefix: ma- (kit), mv- (the group D).  Library: analysis (IS-COUNTABLE is regulated-primitive.scm's).
;;;
;;; D = { d in RR : a - b = (c + 1) d for some a, b, c in NN } is enumerated by NN through
;;; m |-> recip(nnsnd(nnsnd m) + 1) * (nnfst m - nnfst(nnsnd m))   (nn-fractions-enumerated);
;;; every rational lies in D, by the two PRIMITIVE generation axioms qq-is-fraction and zz-generated-by-nn
;;; (qq-in-nn-fractions); hence QQ is countable (qq-countable), with the same enumeration (qq-enumerated).
;;;
;;; LOAD WINDOW.  lo: structure-library/regulated-primitive (IS-COUNTABLE, countable-of-enum; load.scm 3071)
;;; and the nnpair lemmas.  hi: theorem-library/measure-ch1-vitali (cites nn-fractions-enumerated).

;;; (0) the ma- kit
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; (1) the group D and its enumeration
(define (mv-dbody d)
  (list 'FORSOME 'mva_ (list 'AND '(IN mva_ NN)
    (list 'FORSOME 'mvb_ (list 'AND '(IN mvb_ NN)
      (list 'FORSOME 'mvc_ (list 'AND '(IN mvc_ NN)
        (list '= '(- mva_ mvb_) (list '* '(+ mvc_ 1) d)))))))))
(define mv-d (list 'SEP 'mvd_ 'RR (mv-dbody 'mvd_)))
(define (mv-in-d t) (list 'IN t mv-d))

;;; with (IN t D) in context: land a, b, c in NN and a - b = (c + 1) t; return (a b c)
(define (mv-d-open! t)
  (let* ((ex (ma-sep-parts! (mv-in-d t)))
         (a (dk-skolem! ex))
         (b (dk-skolem! (dk-ctx-form (subst-free 'mva_ a (caddr (caddr ex))))))
         (c (dk-skolem! (dk-ctx-form (subst-free 'mvb_ b (subst-free 'mva_ a (caddr (caddr (caddr (caddr ex))))))))))
    (list a b c)))
;;; prove the focus goal (IN t D) with witnesses a, b, c; EQ! proves (= (- a b) (* (+ c 1) t)) on its leaf
(define (mv-d-close! t a b c eq!)
  (in-sep! (lambda () (dk-type! t) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
    (lambda ()
      (ew a)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew b)
                 (dk-conj-close!
                   (lambda ()
                     (cond ((dk-ass!) #t)
                           ((dk-head-is? (dk-goal) 'FORSOME)
                            (ew c)
                            (dk-conj-close! (lambda () (if (not (dk-ass!)) (eq!)))))
                           (#t (error "mv-d-close!: unexpected goal" (dk-goal)))))))
                (#t (error "mv-d-close!: unexpected goal" (dk-goal)))))))))
(define (mv-nn-rr! . vs) (ma-for-each (lambda (v) (fact 'nn-in-rr v)) vs))

(define (mv-r n) (list 'recip (list '+ n 1)))
(define (mv-succ-facts! n)
  ;; (+ n 1) in RR, 0 < n + 1, not(n + 1 = 0), 1 <= n + 1
  (fact 'nn-in-rr n)
  (fact 'nn-zero-le n)
  (fact 'rr-one-in)
  (dk-type! (list '+ n 1))
  (dk-have! (list '< 0 (list '+ n 1)) (lambda () (dk-ineq! (list '<= 0 n))))
  (dk-have! (list '<= 1 (list '+ n 1)) (lambda () (dk-ineq! (list '<= 0 n))))
  (dk-have! (list 'NOT (list '= (list '+ n 1) 0))
    (lambda () (di) (dk-absurd! (list '= (list '+ n 1) 0) (list '<= 0 n)))))


;;; D is enumerated by NN: m |-> (nnfst m - nnfst(nnsnd m)) / (nnsnd(nnsnd m) + 1)
(define (mv-e m) (list '* (list 'recip (list '+ (list 'nnsnd (list 'nnsnd m)) 1)) (list '- (list 'nnfst m) (list 'nnfst (list 'nnsnd m)))))
(sp (make-wff (forall-guarded '(d) (list (mv-in-d 'd))
  (list 'FORSOME 'mvm_ (list 'AND '(IN mvm_ NN) (list '= (mv-e 'mvm_) 'd))))))
(dk-peel!)
(let* ((abc (mv-d-open! 'd)) (a (car abc)) (b (cadr abc)) (c (caddr abc))
       (p (list 'nnpair b c)) (m (list 'nnpair a p)))
  (fact 'nnpair-type b c)
  (fact 'nnpair-type a p)
  (fact 'nnfst-nnpair a p)
  (fact 'nnsnd-nnpair a p)
  (fact 'nnfst-nnpair b c)
  (fact 'nnsnd-nnpair b c)
  (ma-sep-parts! (mv-in-d 'd))
  (mv-succ-facts! c)
  (mv-nn-rr! a b)
  (dk-type! (list '- a b))
  (dk-have! (list 'AND (list 'IN (list '+ c 1) 'RR) (list 'NOT (list '= (list '+ c 1) 0))))
  (dk-apply! (dk-cite! 'rr-recip-solve (list '+ c 1) (list '- a b) 'd))
  (ew m)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (subst (list '= (list 'nnfst m) a))
            (subst (list '= (list 'nnsnd m) p))
            (subst (list '= (list 'nnsnd p) c))
            (subst (list '= (list 'nnfst p) b))
            (subst (list '= 'd (list '* (list 'recip (list '+ c 1)) (list '- a b))))
            (fact 'rr-recip-closed (list '+ c 1))
            (dk-have! (list 'AND (list 'IN (list 'recip (list '+ c 1)) 'RR) (list 'IN (list '- a b) 'RR)))
            (fact 'rr-mul-closed (list 'recip (list '+ c 1)) (list '- a b))
            (rfl))))))
(qed 'nn-fractions-enumerated)

;;; every rational lies in D
(sp (make-wff (forall-guarded '(q) '((IN q QQ)) (mv-in-d 'q))))
(dk-peel!)
(fact 'qq-subset-rr 'q)
(fact 'nn-zero-in)
(let* ((ex (dk-apply! (dk-cite! 'qq-is-fraction) 'q))
       (a (dk-skolem! ex))
       (exb (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a))) (dk-asms)))
       (b (dk-skolem! exb))
       (rb (list 'recip b)))
  (fact 'zz-subset-qq a) (fact 'zz-subset-qq b)
  (fact 'qq-subset-rr a) (fact 'qq-subset-rr b)
  (dk-have! (list 'AND (list 'IN b 'RR) (list 'NOT (list '= b 0))))
  (fact 'rr-recip-closed b)
  (fact 'rr-recip-inverse b)
  (let ((e (list '= (list '* b 'q) a)))
    (dk-have! e
      (lambda ()
        (subst (list '= 'q (list '* a rb)))
        (let ((id (list '= (list '* b (list '* a rb)) (list '* a (list '* b rb)))))
          (dk-have! id (lambda () (dk-crs-opaque!)))
          (subst id)
          (subst (list '= (list '* b rb) 1))
          (crs))))
    (let* ((n1 (dk-skolem! (dk-apply! (dk-cite! 'zz-generated-by-nn) a)))
           (ora (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f a))) (dk-asms)))
           (n2 (dk-skolem! (dk-apply! (dk-cite! 'zz-generated-by-nn) b)))
           (orb (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f b))) (dk-asms))))
      (fact 'nn-in-rr n1) (fact 'nn-in-rr n2)
      (ma-or-split! (dk-cite! 'nn-zero-or-succ n2)
        (list
          ;; n2 = 0 makes b = 0
          (lambda ()
            (ma-or-split! orb
              (list (lambda () (dk-have! (list '= b 0) (lambda () (dk-ineq! (list '= b n2) (list '= n2 0))))
                               (ma-prop-with! (list (list '= b 0) (list 'NOT (list '= b 0)))))
                    (lambda () (dk-have! (list '= b 0) (lambda () (dk-ineq! (list '= b (list '- n2)) (list '= n2 0))))
                               (ma-prop-with! (list (list '= b 0) (list 'NOT (list '= b 0))))))))
          (lambda ()
            (let* ((exc (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f n2))) (dk-asms)))
                   (c (dk-skolem! exc)))
              (fact 'nn-succ-plus-one c)
              (fact 'nn-in-rr c)
              (let ((case! (lambda (bpos? apos?)
                             (let* ((x (if bpos? (list '* b 'q) (list '- 0 (list '* b 'q))))
                                    (g (list '= (list '* (list '+ c 1) 'q) x))
                                    (pos? (eq? bpos? apos?))
                                    (aa (if pos? n1 0)) (bb (if pos? 0 n1)))
                               (dk-have! g
                                 (lambda ()
                                   (subst (if bpos? (list '= b n2) (list '= b (list '- n2))))
                                   (subst (list '= n2 (list 'succ c)))
                                   (subst (list '= (list 'succ c) (list '+ c 1)))
                                   (crs)))
                               (mv-d-close! 'q aa bb c
                                 (lambda ()
                                   (subst g)
                                   (subst e)
                                   (dk-ineq! (if apos? (list '= a n1) (list '= a (list '- n1))))))))))
                (ma-or-split! orb
                  (list (lambda () (ma-or-split! ora (list (lambda () (case! #t #t)) (lambda () (case! #t #f)))))
                        (lambda () (ma-or-split! ora (list (lambda () (case! #f #t)) (lambda () (case! #f #f)))))))))))))))
(qed 'qq-in-nn-fractions)

(sp (make-wff (forall-guarded '(q) '((IN q QQ))
  (list 'FORSOME 'mvm_ (list 'AND '(IN mvm_ NN) (list '= (mv-e 'mvm_) 'q))))))
(dk-peel!)
(dk-apply! (dk-cite! 'qq-in-nn-fractions) 'q)
(dk-apply! (dk-cite! 'nn-fractions-enumerated) 'q)
(ass)
(qed 'qq-enumerated)

(sp (make-wff (forall-guarded '(m) '((IN m NN)) (list 'IN (mv-e 'm) 'QQ))))
(dk-peel!)
(let* ((p (list 'nnsnd 'm)) (c (list 'nnsnd p)) (a (list 'nnfst 'm)) (b (list 'nnfst p)))
  (fact 'nnsnd-type 'm) (fact 'nnsnd-type p) (fact 'nnfst-type 'm) (fact 'nnfst-type p)
  (mv-succ-facts! c)
  (fact 'nn-one-in)
  (fact 'qq-one-in)
  (ma-for-each (lambda (t) (fact 'nn-subset-zz t) (fact 'zz-subset-qq t)) (list a b c))
  (dk-type! (list '+ c 1) 'QQ)
  (dk-type! (list '- a b) 'QQ)
  (dk-have! (list 'AND (list 'IN (list '+ c 1) 'QQ) (list 'NOT (list '= (list '+ c 1) 0))))
  (fact 'qq-recip-closed (list '+ c 1))
  (dk-have! (list 'AND (list 'IN (mv-r c) 'QQ) (list 'IN (list '- a b) 'QQ)))
  (fact 'qq-mul-closed (mv-r c) (list '- a b))
  (ass))
(qed 'qq-enumeration-type)

(sp (make-wff '(IS-COUNTABLE QQ)))
(let ((en (list 'VNB-LAMBDA 'mqm_ 'NN (mv-e 'mqm_))))
  (fact 'qq-is-set)
  (dk-have! (list 'IN en '(FUN NN QQ))
    (lambda ()
      (dk-lam-type! (lambda () (let ((m (dk-di-var!))) (dk-apply! (dk-cite! 'qq-enumeration-type) m) (ass)))
                    (lambda () (fact 'nn-is-set) (ass)))))
  (dk-have! (list 'FORALL 'rqy_ (list 'IMPLIES '(IN rqy_ QQ) (list 'FORSOME 'rqn_ (list 'AND '(IN rqn_ NN) (list '= 'rqy_ (list en 'rqn_))))))
    (lambda ()
      (let* ((q (dk-di-var!))
             (m (dk-skolem! (dk-apply! (dk-cite! 'qq-enumerated) q))))
        (ew m)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (dk-lam-b!)
                  (dk-apply! (dk-cite! 'qq-enumeration-type) m)
                  (fact 'qq-subset-rr q)
                  (subst (list '= (mv-e m) q))
                  (rfl))))))))
  (dk-apply! (dk-cite! 'countable-of-enum 'QQ en))
  (ass))
(qed 'qq-countable)
