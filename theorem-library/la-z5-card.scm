;;; la-z5-card.scm -- counting: the cardinality of a cartesian product of finite sets
;;; (LA-Z5, 2026-10-25).  Prefix lz5c-.
;;;
;;; THE THEOREM.  card-cartesian: for finite sets X and Y,
;;;   CARD(CARTESIAN(X, Y)) = CARD(X) * CARD(Y).
;;; card-cartesian-nn (monalg-is-ring, algebra) has only the finiteness and is not cited.  The invariance of CARD
;;; under a bijection is card-bijection-eq (card-laws), already in the tree.
;;;
;;; PLAN.  finite-set-induction on Y, X fixed.  Y = {}: X x {} = {}.  Y = S u {b}, b not
;;; in S: X x (S u {b}) = (X x S) u IMAGE(u |-> [u, b], X), a disjoint union; the map is
;;; injective, so the image has CARD(X) elements (card-image-injection); then
;;; card-union-disjoint, card-insert and a * succ(b) = a * b + a (nn-mul-succ).
;;;
;;; Destination theorem-library/.  Library: core (it mentions only CARD, CARTESIAN, IMAGE,
;;; UNION and NN arithmetic).  LOAD WINDOW: after theorem-library/card-laws (load.scm
;;; 1009: card-insert-curried, card-union-disjoint-curried, card-image-injection-curried)
;;; and the files of class-extensionality, nn-mul-succ, ord-succ-nn, cartesian-pair-eq
;;; (all earlier: see the report).  Nothing in the tree cites the file.

(define (lz5c-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z5-card: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'combinatorial))
(define (lz5c-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lz5c-cite! thm . args) (lz5c-detach-all! (apply dk-cite! thm args)))
(define (lz5c-set! t) (if (not (dk-asm? (list 'IN t 'SET))) (dk-have! (list 'IN t 'SET) (lambda () (dk-sethood! t)))))
;; z in CARTESIAN(A, B) in context: land z = [u, v], u in A, v in B for FRESH symbols u, v,
;; and return (u v).  The kernel's cartesian-decompose rewrites the membership in a GOAL
;; (it is a procedural macete, with no hypothesis-side route), so the implication
;; z in A x B => exists u, v. z = [u, v], u in A, v in B is proved on a lane by it, then
;; detached and skolemised.
(define (lz5c-skolem-all! ex)
  (let loop ((ex ex) (acc '()))
    (let* ((v #f)
           (landed (dk-landed (lambda () (set! v (dk-skolem! ex)))))
           (nxt (find-first (dk-head? 'FORSOME) landed)))
      (if nxt (loop nxt (append acc (list v))) (append acc (list v))))))
(define (lz5c-decomp! mem)
  (let* ((z (cadr mem)) (A (cadr (caddr mem))) (B (caddr (caddr mem)))
         (ex (list 'FORSOME 'lzu_ (list 'FORSOME 'lzv_
               (list 'AND (list '= z '(LIST lzu_ lzv_)) (list 'AND (list 'IN 'lzu_ A) (list 'IN 'lzv_ B))))))
         (imp (list 'IMPLIES mem ex)))
    (dk-have! imp
      (lambda ()
        (mac 'cartesian-decompose)
        (let* ((ld (dk-landed (lambda () (di))))
               (kex (find-first (dk-head? 'FORSOME) ld))
               (ws (lz5c-skolem-all! kex)))
          (let loop ()
            (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f (car ws)))) (dk-asms))))
              (if cj (begin (dk-split! cj) (loop)))))
          (ew (car ws)) (ew (cadr ws))
          (dk-conj-close! (lambda () (ass))))))
    (detach! (dk-ctx-form imp))
    (let ((ws (lz5c-skolem-all! (dk-ctx-form ex))))
      (let loop ()
        (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f (cadr ws)))) (dk-asms))))
          (if cj (begin (dk-split! cj) (loop)))))
      ws)))
(define (lz5c-ass-if! g)                ; close the focus by ass only when its goal is G
  (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (equal? (dk-goal) g)) (ass)))
(define (lz5c-absurd! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
;; prove (IN z (CARTESIAN A B)) from z = [u, v] (in context), u in A, v in B
(define (lz5c-pair-in! z u v A B)
  (lz5c-cite! 'pair-in-cartesian A B u v)
  (dk-have! (list 'IN z (list 'CARTESIAN A B))
    (lambda () (subst (list '= z (list 'LIST u v))) (ass))))

(sp (make-wff (forall-guarded '(cxa) '((IN cxa SET) (IN (CARD cxa) NN))
  (forall-guarded '(cya) '((IN cya SET) (IN (CARD cya) NN))
    '(= (CARD (CARTESIAN cxa cya)) (* (CARD cxa) (CARD cya)))))))
(dk-peel!)
(define LZ5C-P (lambda (y) (list '= (list 'CARD (list 'CARTESIAN 'cxa y)) (list '* '(CARD cxa) (list 'CARD y)))))
(define LZ5C-C (list 'COMP 'lzy_ (LZ5C-P 'lzy_)))
;; ---- the base: X x {} = {} ----
(dk-have! (list 'IN 'EMPTY-SET LZ5C-C)
  (lambda ()
    (for-each
      (lambda (l)
        (dk-focus! l)
        (if (equal? (dk-goal) '(IN EMPTY-SET SET))
            (begin (fact 'empty-set-is-set) (ass))
            (let ((ce '(= (CARTESIAN cxa EMPTY-SET) EMPTY-SET)))
              (dk-have! ce
                (lambda ()
                  (dk-have! '(FORALL lzz_ (IFF (IN lzz_ (CARTESIAN cxa EMPTY-SET)) (IN lzz_ EMPTY-SET)))
                    (lambda ()
                      (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                        (dk-iff! (lambda (g) (equal? g (list 'IN z 'EMPTY-SET)))
                          (lambda ()
                            (let ((uv (lz5c-decomp! (list 'IN z '(CARTESIAN cxa EMPTY-SET)))))
                              (fact 'empty-set-has-no-members (cadr uv))
                              (lz5c-absurd! (list 'NOT (list 'IN (cadr uv) 'EMPTY-SET)))))
                          (lambda ()
                            (fact 'empty-set-has-no-members z)
                            (lz5c-absurd! (list 'NOT (list 'IN z 'EMPTY-SET))))))))
                  (let ((ch (dk-cite! 'class-extensionality '(CARTESIAN cxa EMPTY-SET) 'EMPTY-SET)))
                    (if (and (pair? ch) (eq? (car ch) 'IMPLIES)) (detach! ch)))
                  (lz5c-ass-if! '(= (CARTESIAN cxa EMPTY-SET) EMPTY-SET))))
              (subst ce)
              (fact 'card-empty)
              (subst '(= (CARD EMPTY-SET) 0))
              (fact 'nn-in-rr '(CARD cxa))
              (crs))))
      (dk-opened (lambda () (comp-mi))))))
;; ---- the step: sx u {b} ----
(define (lz5c-ext! lhs rhs fwd bwd)     ; land (= lhs rhs) by class-extensionality
  (let ((fa (list 'FORALL 'lzz_ (list 'IFF (list 'IN 'lzz_ lhs) (list 'IN 'lzz_ rhs)))))
    (dk-have! (list '= lhs rhs)
      (lambda ()
        (dk-have! fa
          (lambda ()
            (let ((z (begin (di) (cadr (cadr (dk-goal))))))
              (dk-iff! (lambda (g) (equal? g (list 'IN z rhs)))
                (lambda () (fwd z))
                (lambda () (bwd z))))))
        (let ((ch (dk-cite! 'class-extensionality lhs rhs)))
          (if (and (pair? ch) (eq? (car ch) 'IMPLIES)) (detach! ch)))
        (lz5c-ass-if! (list '= lhs rhs))))
    (list '= lhs rhs)))
;; x in PAIR(b, bx) in context, bx a set: land x = bx
(define (lz5c-in-single! x bx)
  (let* ((pm (lz5c-cite! 'pairing-membership bx bx))
         (inst (dk-apply! pm x))
         (eq (list '= x bx)))
    (dk-have! eq (dk-lane (lambda () (dk-only! inst (list 'IN x (list 'PAIR bx bx))) (dk-lane-if! prop))))
    eq))
(define LZ5C-STEP
  (list 'FORALL 'lzs_ (list 'IMPLIES (list 'AND '(IN lzs_ SET) (list 'AND '(IN (CARD lzs_) NN) (list 'IN 'lzs_ LZ5C-C)))
    (list 'FORALL 'lzb_ (list 'IMPLIES '(AND (IN lzb_ SET) (NOT (IN lzb_ lzs_)))
      (list 'IN '(UNION lzs_ (PAIR lzb_ lzb_)) LZ5C-C))))))
(define (lz5c-step!)
  (let* ((landed (dk-peel!))
         (g (dk-goal))
         (sx (cadr (cadr g)))
         (bx (cadr (caddr (cadr g))))
         (ux (list 'UNION sx (list 'PAIR bx bx)))
         (ax (list 'CARTESIAN 'cxa sx))
         (px (list 'VNB-LAMBDA 'lzw_ 'cxa (list 'LIST 'lzw_ bx)))
         (bigb (list 'IMAGE px 'cxa))
         (cux (list 'CARTESIAN 'cxa ux)))
    (dk-split-all! landed)
    (let ((ih (dk-landed-find (lambda () (comp-me (list 'IN sx LZ5C-C))) (dk-head? '=))))
      (dk-have! (list 'AND (list 'IN bx 'SET) (list 'IN bx 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (fact 'pairing bx bx)
      (dk-have! (list 'AND (list 'IN sx 'SET) (list 'IN (list 'PAIR bx bx) 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (fact 'union-set-closure sx (list 'PAIR bx bx))
      (for-each
        (lambda (leaf)
          (dk-focus! leaf)
          (if (equal? (dk-goal) (list 'IN ux 'SET))
              (ass)
              (lz5c-step-eq! sx bx ux ax px bigb cux ih)))
        (dk-opened (lambda () (comp-mi)))))))
(define (lz5c-b-in-U! bx ux sx)            ; (IN bx ux)
  (dk-have! (list 'IN bx ux)
    (lambda ()
      (mac 'union-membership)
      (oi-r)
      (mac 'pairing-membership)
      (if (not (proof-done? *ps*)) (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! (lambda () (ass)))))
      (if (dk-head-is? (dk-goal) 'OR) (begin (oi-l) (rfl))))))
(define (lz5c-step-eq! sx bx ux ax px bigb cux ih)
  (lz5c-b-in-U! bx ux sx)
  ;; (1) X x (sx u {b}) = (X x sx) u bigb
  (let ((eq1 (lz5c-ext! cux (list 'UNION ax bigb)
               (lambda (z)
                 (let* ((uv (lz5c-decomp! (list 'IN z cux))) (u (car uv)) (v (cadr uv))
                        (cs (dk-landed-1 (lambda () (mac-h 'union-membership (dk-ctx-form (list 'IN v ux)))))))
                   (mac 'union-membership)
                   (use-cases cs
                     (lambda () (oi-l) (lz5c-pair-in! z u v 'cxa sx))
                     (lambda ()
                       (lz5c-in-single! v bx)
                       (oi-r)
                       (dk-image-goal!)
                       (ew u)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (ass)
                               (begin
                                 (dk-lam-b!)
                                 (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                     (begin
                                       (subst (list '= z (list 'LIST u v)))
                                       (subst (list '= v bx))
                                       (fact 'membership-implies-sethood u 'cxa)
                                       (rfl)))))))))))
               (lambda (z)
                 (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (dk-ctx-form (list 'IN z (list 'UNION ax bigb))))))))
                   (use-cases cs
                     (lambda ()
                       (let* ((uv (lz5c-decomp! (list 'IN z ax))) (u (car uv)) (v (cadr uv)))
                         (dk-have! (list 'IN v ux) (lambda () (mac 'union-membership) (oi-l) (ass)))
                         (lz5c-pair-in! z u v 'cxa ux)))
                     (lambda ()
                       (let* ((ex (dk-image-hyp! (dk-ctx-form (list 'IN z bigb))))
                              (x (dk-skolem! ex)))
                         (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f x))) (dk-asms))))
                           (if cj (dk-split! cj)))
                         (let ((pe (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) z))) (dk-asms))))
                           (dk-lam-b-h! pe))
                         (let ((pe2 (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) z)
                                                                 (dk-head-is? (cadr f) 'LIST))) (dk-asms))))
                           (lz5c-pair-in! z x bx 'cxa ux))))))))))
    ;; (2) the two parts are disjoint
    (let ((eq2 (lz5c-ext! (list 'INTERSECTION ax bigb) 'EMPTY-SET
                 (lambda (z)
                   (let ((cj (dk-landed-1 (lambda () (mac-h 'intersection-membership (dk-ctx-form (list 'IN z (list 'INTERSECTION ax bigb))))))))
                     (dk-split! cj))
                   (let* ((uv (lz5c-decomp! (list 'IN z ax))) (u (car uv)) (v (cadr uv))
                          (ex (dk-image-hyp! (dk-ctx-form (list 'IN z bigb))))
                          (x (dk-skolem! ex)))
                     (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f x))) (dk-asms))))
                       (if cj (dk-split! cj)))
                     (let ((pe (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) z) (dk-contains? f x))) (dk-asms))))
                       (dk-lam-b-h! pe))
                     (fact 'membership-implies-sethood x 'cxa)
                     (fact 'membership-implies-sethood u 'cxa)
                     (fact 'membership-implies-sethood v sx)
                     (let ((ll (list '= (list 'LIST x bx) (list 'LIST u v))))
                       (dk-have! ll (lambda () (subst (list '= (list 'LIST x bx) z)) (subst (list '= z (list 'LIST u v))) (rfl)))
                       (dk-congr! ll (lambda (t) (list 'NTH 2 t)))
                       (let* ((n1 (dk-cite! 'nth2-pair x bx))
                              (n2 (dk-cite! 'nth2-pair u v)))
                         (dk-have! (list '= bx v)
                           (lambda ()
                             (subst (list '= bx (list 'NTH 2 (list 'LIST x bx))))
                             (subst (list '= v (list 'NTH 2 (list 'LIST u v))))
                             (ass)))
                         (dk-have! (list 'IN bx sx) (lambda () (subst (list '= bx v)) (ass)))
                         (lz5c-absurd! (list 'NOT (list 'IN bx sx)))))))
                 (lambda (z)
                   (fact 'empty-set-has-no-members z)
                   (lz5c-absurd! (list 'NOT (list 'IN z 'EMPTY-SET)))))))
      ;; (3) u |-> [u, b] is injective, so bigb has CARD(X) elements
      (let ((inj (list 'IN px (list 'INJECTION 'cxa cux))))
        (dk-have! inj
          (lambda ()
            (mac 'injection-membership-iff)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (dk-lam-type!
                      (lambda ()
                        (let ((w (dk-di-var!)))
                          (if (dk--redex? (dk-goal)) (dk-lam-b!))
                          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                              (begin (fact 'pair-in-cartesian 'cxa ux w bx) (ass)))))
                      (lambda () (ass)))
                    (let* ((ld (dk-peel!))
                           (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'cxa))) ld))
                           (a1 (cadr (car ins))) (a2 (cadr (cadr ins)))
                           (pe (find-first (dk-head? '=) ld)))
                      (dk-lam-b-h! pe)
                      (fact 'membership-implies-sethood a1 'cxa)
                      (fact 'membership-implies-sethood a2 'cxa)
                      (let ((ll (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'LIST)
                                                            (dk-head-is? (caddr f) 'LIST))) (dk-asms))))
                        (dk-congr! ll (lambda (t) (list 'NTH 1 t)))
                        (dk-cite! 'nth1-pair a1 bx)
                        (dk-cite! 'nth1-pair a2 bx)
                        (subst (list '= a1 (list 'NTH 1 (list 'LIST a1 bx))))
                        (subst (list '= a2 (list 'NTH 1 (list 'LIST a2 bx))))
                        (ass)))))))))
        (lz5c-cite! 'card-image-injection-curried 'cxa cux px))
      ;; (4) the counts
      (lz5c-set! ax)
      (dk-have! (list 'AND '(IN (CARD cxa) NN) (list 'IN (list 'CARD sx) 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
      (fact 'nn-mul-closed '(CARD cxa) (list 'CARD sx))
      (dk-have! (list 'IN (list 'CARD ax) 'NN) (lambda () (subst ih) (ass)))
      (fact 'image-set px 'cxa)
      (dk-have! (list 'IN (list 'CARD bigb) 'NN) (lambda () (subst (list '= (list 'CARD bigb) '(CARD cxa))) (ass)))
      (lz5c-cite! 'card-union-disjoint-curried ax bigb)
      (lz5c-cite! 'card-insert-curried sx bx)
      (lz5c-cite! 'ord-succ-nn (list 'CARD sx))
      (lz5c-cite! 'nn-mul-succ '(CARD cxa) (list 'CARD sx))
      (subst eq1)
      (subst (list '= (list 'CARD (list 'UNION ax bigb)) (list '+ (list 'CARD ax) (list 'CARD bigb))))
      (subst ih)
      (subst (list '= (list 'CARD bigb) '(CARD cxa)))
      (subst (list '= (list 'CARD ux) (list 'succ_ord (list 'CARD sx))))
      (subst (list '= (list 'succ_ord (list 'CARD sx)) (list 'succ (list 'CARD sx))))
      (subst (list '= (list '* '(CARD cxa) (list 'succ (list 'CARD sx))) (list '+ (list '* '(CARD cxa) (list 'CARD sx)) '(CARD cxa))))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (begin (lz5c-cite! 'nn-mul-closed '(CARD cxa) (list 'CARD sx)) (rfl)))))
(dk-have! LZ5C-STEP lz5c-step!)
(dk-have! (list 'AND (list 'IN 'EMPTY-SET LZ5C-C) LZ5C-STEP) (lambda () (dk-conj-close! (lambda () (ass)))))
(let ((ind (dk-fact! 'finite-set-induction LZ5C-C)))
  (dk-have! '(AND (IN cya SET) (IN (CARD cya) NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (let ((inx (dk-apply! ind 'cya)))
    (comp-me inx)
    (ass)))
(lz5c-done! 'card-cartesian)
(gloss! 'card-cartesian "The cartesian product of two finite sets X, Y has CARD(X) * CARD(Y) elements.")
