;;; hs-inner-product-2.scm -- wave of 2026-11-09/10 (agent TH3-B2), wired 2026-11-10 from scratchpad/th3-1109/b2/tb2-hip2.scm.
;;; Library: operator-algebras.

;;; ====================================================================
;;; tb2-hip2.scm -- TH3-B2, 2026-11-09.  The Hilbert-Schmidt inner product is independent of
;;; the basis (th-main (3.12), (3.13), Prop. 3.37) and the trace laws (Prop. 3.45, Def. 3.46).
;;;
;;;   hs-ip-basis-independent  q_e(S, T) = q_f(S, T) for two ONBs e, f of H, where
;;;                            q_e(S, T) = sum_i <S e_i | T e_i>
;;;   hs-ip-any-basis          HS-IP(S, T) = q_e(S, T) for any ONB e
;;;   hs-ip-family-conj        q_e(T, S) = conj q_e(S, T)
;;;   hs-ip-adjoint-swap       q_e(S, T) = q_f(T*, S*), e an ONB of H, f an ONB of K   (3.13)
;;;   hs-ip-conj-sym           HS-IP(T, S) = conj HS-IP(S, T)
;;;   hs-ip-adjoint            HS-IP_{H,K}(S, T) = HS-IP_{K,H}(T*, S*)
;;;   trace-family-comp        S, T Hilbert-Schmidt on H: the family <S T e_i | e_i> sums to
;;;                            q_e(T, S*)
;;;   op-trace-canon           tr T is the sum over the canonical ONB, as a family indexed by it
;;;   op-trace-sums            T trace class, e any ONB: tr T in CC and <T e_i | e_i> sums to tr T
;;;                            (the trace is summable and does not depend on the basis)
;;;   op-trace-add             tr(S + T) = tr S + tr T for S, T trace class
;;;   op-trace-comm            tr(S T) = tr(T S) for S, T Hilbert-Schmidt
;;;
;;; THE ROUTE: q_e(S, T) is recovered from the four real sums HS-SUM(S), HS-SUM(T),
;;; HS-SUM(S + T), HS-SUM(S + i T), each basis independent (hs-sum-basis-independent), by the
;;; expansion hs-sum-polar: 2 q = (X_1 - A - B) + i (X_i - A - B).  The adjoint form uses the same
;;; expansion on the adjoint side (hs-sum-adjoint-eq).  No double sum of complex numbers is
;;; interchanged.  The trace of S T is q_e(T, S*), since <S T x | x> = <T x | S* x>.
;;;
;;; LOAD WINDOW: after tb2-hip.scm (hs-ip-family-sums, hs-sum-polar) and tb2-sums.scm; cites
;;; TH3-B (hs-sum-basis-independent, hs-sum-adjoint-eq, hs-adjoint, hs-add, hs-scale,
;;; hs-sum-real-any-basis, canon-onb-is-onb), BA-BH / BA-BH2 (bop-*, op-adjoint-*), th3-vocab-unfold
;;; (hs-ip-unfold, op-trace-unfold, is-trace-class).  Library: operator-algebras.
;;; ====================================================================

;;; --------------------------------------------------------------------
;;; helpers (file-local, prefix tb2-)
;;; --------------------------------------------------------------------
;;; close a typing leaf: by assumption when it is in context, else beta and close
;;; ---- helper defines COPIED 2026-11-10 (integration) from th3-1109/b2/tb2-hip.scm, th3-1109/b2/tb2-sums.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (tb2-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (tb2-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb2-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (tb2-close!)
  (cond ((not (tb2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tb2-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tb2-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tb2-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))))
(define (tb2-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (tb2-cc! (cadr t)) (tb2-cc! (caddr t))
         (tb2-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'conjugate))
         (tb2-cc! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (tb2-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t))
        (#t (error "tb2-cc!: cannot type in CC" (expression->string t)))))
(define (tb2-nag!)
  (if (not (dk-asm? '(IS-NORMED-AG CC-NAG))) (fact 'cc-nag-is-normed-ag))
  (if (not (dk-asm? '(== (CARR CC-NAG) CC))) (fact 'cc-nag@carr)))
(define (tb2-carr! form)          ; form mentions CC where CARR CC-NAG is wanted, given as the target
  (if (not (dk-asm? form))
      (dk-have! form (lambda () (subst '(= (CARR CC-NAG) CC)) (tb2-close!)))))
(define (tb2-pw dd h body-of)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ dd) (list '= (list h 'z_) (body-of 'z_)))))
(define (tb2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (tb2-Q w ix e s t) (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP w) (list s (list e 'kqk_)) (list t (list e 'kqk_)))))
(define (tb2-qsum w ix e s t) (list 'CC-FAMILY-SUM (tb2-Q w ix e s t)))
(define (tb2-hs v w ix e t) (list 'HS-SUM v w ix e t))
(define (tb2-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (if (not (dk-asm? onf)) (dk-project! onf 'is-orthonormal-basis onb))
    (if (not (dk-asm? (list 'IN e (list 'FUN ix (list 'VEC v)))))
        (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf))
    (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix (list 'VEC v) e))))
(define (tb2-hs-bounded! v w t)
  (let ((bx (list 'IN t (list 'BOUNDED-OPS v w))))
    (if (not (dk-asm? bx))
        (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT v w t)))))
    (if (not (dk-asm? (list 'IN t (list 'FUN (list 'VEC v) (list 'VEC w))))) (fact 'bop-fun v w t))))
(define (tb2-st2 concl)
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e)) concl))))
(define (tb2-open-st2!)
  (dk-peel!)
  (fact 'hilbert-space-is-cips 'v)
  (fact 'hilbert-space-is-cips 'w)
  (tb2-onb! 'v 'ix 'e)
  (tb2-hs-bounded! 'v 'w 's_)
  (tb2-hs-bounded! 'v 'w 't_))
;;; ---- end of copied helpers ----

(define (tb2-fin!)
  (cond ((not (tb2-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        (#t (dk-lam-b!) (tb2-close!))))
(define (tb2-xop v w s t c) (list 'BOP-SUM v w s (list 'BOP-SCALE v w c t)))
;;; y in VEC v in context: (op y) in VEC w for each op (each in FUN(VEC v, VEC w) in context)
(define (tb2-vty! v w ops y)
  (for-each (lambda (op) (tb2-ap! op (list 'VEC v) (list 'VEC w) y)) ops))
(define (tb2-ipty! w a b)
  (if (not (dk-asm? (list 'IN (list (list 'IP w) a b) 'CC))) (fact 'cips-ip-type w a b)))
;;; the family k |-> <s e_k | t e_k>_w over ix, typed in FUN(ix, CC)
(define (tb2-qfam-type! v w ix e s t)
  (let ((fam (tb2-Q w ix e s t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-ap! e ix (list 'VEC v) k)
                  (tb2-vty! v w (list s t) (list e k))
                  (tb2-ipty! w (list s (list e k)) (list t (list e k)))
                  (tb2-fin!)))
              (lambda () (ass))))))
    fam))
(define (tb2-one!)
  (if (not (dk-asm? '(IN 1 RR))) (dk-have! '(IN 1 RR) (lambda () (arith))))
  (tb2-cc! 1))
(define (tb2-i!) (if (not (dk-asm? (list 'IN +i 'CC))) (fact 'cc-i-in)))
;;; HS-SUM(S + c T) expanded (hs-sum-polar); c typed in CC in context
(define (tb2-polar! v w s t c ix e)
  (let ((sc (list 'BOP-SCALE v w c t)) (xx (tb2-xop v w s t c)))
    (if (not (dk-asm? (list 'IS-HILBERT-SCHMIDT v w sc))) (fact 'hs-scale v w c t))
    (if (not (dk-asm? (list 'IS-HILBERT-SCHMIDT v w xx))) (fact 'hs-add v w s sc))
    (tb2-hs-bounded! v w sc)
    (tb2-hs-bounded! v w xx)
    (tb2-cite! 'hs-sum-real-any-basis v w xx ix e)
    (tb2-cc! (tb2-hs v w ix e xx))
    (tb2-cite! 'hs-sum-polar v w s t c ix e)))
;;; (1/2) ((X_1 - A - B) + i (X_i - A - B))
(define (tb2-rhs v w s t ix e)
  (let ((h1 (tb2-hs v w ix e (tb2-xop v w s t 1)))
        (hi (tb2-hs v w ix e (tb2-xop v w s t +i)))
        (ha (tb2-hs v w ix e s))
        (hb (tb2-hs v w ix e t)))
    (list '* 1/2 (list '+ (list '+ (list '+ h1 (list '- ha)) (list '- hb))
                          (list '* +i (list '+ (list '+ hi (list '- ha)) (list '- hb)))))))
;;; q_e(s, t) in CC and its SUMS-TO (hs-ip-family-sums), conj q typed; returns q
(define (tb2-qcc! v w s t ix e)
  (let ((qq (tb2-qsum w ix e s t)))
    (if (not (dk-asm? (list 'IN qq 'CC)))
        (dk-split-all! (list (tb2-cite! 'hs-ip-family-sums v w s t ix e))))
    (tb2-cc! (list 'conjugate qq))
    qq))
;;; the real sums A = HS-SUM(s), B = HS-SUM(t) typed in CC
(define (tb2-ab! v w s t ix e)
  (for-each (lambda (op)
              (tb2-cite! 'hs-sum-real-any-basis v w op ix e)
              (tb2-cc! (tb2-hs v w ix e op)))
            (list s t)))
;;; lands (= q_e(s, t) (tb2-rhs ...)) and returns it
(define (tb2-extract! v w s t ix e)
  (tb2-one!)
  (tb2-i!)
  (tb2-ab! v w s t ix e)
  (let* ((c1e (tb2-cite! 'cc-conjugate-fixes-rr 1))
         (cie (tb2-cite! 'cc-conjugate-i))
         (qq (tb2-qcc! v w s t ix e))
         (p1 (tb2-polar! v w s t 1 ix e))
         (pi_ (tb2-polar! v w s t +i ix e))
         (eqn (list '= qq (tb2-rhs v w s t ix e))))
    (if (not (dk-asm? eqn))
        (dk-have! eqn (lambda () (subst p1) (subst pi_) (subst c1e) (subst cie) (crs))))
    eqn))
;;; cl = the identity family of CANON-ONB(v); k in CANON-ONB(v) in context:
;;; land (= (cl k) k) and (IN k (VEC v))
(define (tb2-cb-pt! v cl k)
  (let ((cb (caddr cl)))
    (tb2-ap! cl cb (list 'VEC v) k)
    (if (not (dk-asm? (list '= (list cl k) k)))
        (dk-have! (list '= (list cl k) k) (lambda () (dk-lam-b!) (tb2-close!))))
    (if (not (dk-asm? (list 'IN k (list 'VEC v))))
        (dk-rewrite-h! (list 'IN (list cl k) (list 'VEC v)) (list cl k) k))))
;;; the trace family k |-> <t e_k | e_k>_v over ix
(define (tb2-tr v ix e t)
  (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP v) (list t (list e 'kqk_)) (list e 'kqk_))))
(define (tb2-tr-type! v ix e t)
  (let ((fam (tb2-tr v ix e t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tb2-ap! e ix (list 'VEC v) k)
                  (tb2-vty! v v (list t) (list e k))
                  (tb2-ipty! v (list t (list e k)) (list e k))
                  (tb2-fin!)))
              (lambda () (ass))))))
    fam))
;;; the canonical ONB of v and its identity family, with its projections; returns (cb . cl)
(define (tb2-canon! v)
  (let* ((cb (list 'CANON-ONB v)) (cl (list 'VNB-LAMBDA 'kqe_ cb 'kqe_)))
    (if (not (dk-asm? (list 'IS-ORTHONORMAL-BASIS v cb cl))) (fact 'canon-onb-is-onb v))
    (tb2-onb! v cb cl)
    (cons cb cl)))
;;; the unique-limit step: SUMS-TO fam r1 and SUMS-TO fam r2 in context, fam in FUN(dd, CC),
;;; r1 r2 typed in CC; returns (= r1 r2)
(define (tb2-unique! fam dd r1 r2)
  (tb2-nag!)
  (tb2-dom! fam dd 'CC)
  (tb2-carr! (list 'IN fam (list 'FUN (list 'DOM fam) '(CARR CC-NAG))))
  (tb2-carr! (list 'IN r1 '(CARR CC-NAG)))
  (tb2-carr! (list 'IN r2 '(CARR CC-NAG)))
  (tb2-and! (list 'SUMS-TO 'CC-NAG fam r1) (list 'SUMS-TO 'CC-NAG fam r2))
  (tb2-cite! 'sums-to-unique 'CC-NAG fam r1 r2))

;;; the statement prefixes
(define (tb2-st4 concl)          ; two ONBs of v
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        (forall-guarded '(jx f) '((IS-ORTHONORMAL-BASIS v jx f)) concl)))))
(define (tb2-st1 concl)          ; no basis
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_)) concl)))
(define (tb2-open-st1!)
  (dk-peel!)
  (fact 'hilbert-space-is-cips 'v)
  (fact 'hilbert-space-is-cips 'w)
  (tb2-hs-bounded! 'v 'w 's_)
  (tb2-hs-bounded! 'v 'w 't_))

;;; ====================================================================
;;; hs-ip-basis-independent  (th-main (3.12): the sum does not depend on the basis)
;;; ====================================================================
(sp (make-wff (tb2-st4 (list '= (tb2-qsum 'w 'ix 'e 's_ 't_) (tb2-qsum 'w 'jx 'f 's_ 't_)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tb2-onb! 'v 'ix 'e)
(tb2-onb! 'v 'jx 'f)
(tb2-hs-bounded! 'v 'w 's_)
(tb2-hs-bounded! 'v 'w 't_)
(let* ((ee (tb2-extract! 'v 'w 's_ 't_ 'ix 'e))
       (ef (tb2-extract! 'v 'w 's_ 't_ 'jx 'f)))
  (tb2-ab! 'v 'w 's_ 't_ 'jx 'f)
  (subst ee)
  (subst ef)
  (for-each (lambda (op) (subst (tb2-cite! 'hs-sum-basis-independent 'v 'w op 'ix 'e 'jx 'f)))
            (list (tb2-xop 'v 'w 's_ 't_ 1) (tb2-xop 'v 'w 's_ 't_ +i) 's_ 't_))
  (tb2-close!)
  (if (tb2-open?) (crs)))
(tb2-done! 'hs-ip-basis-independent)

;;; ====================================================================
;;; hs-ip-any-basis  (Def. (3.12) read in any basis)
;;; ====================================================================
(sp (make-wff (tb2-st2 (list '= '(HS-IP v w s_ t_) (tb2-qsum 'w 'ix 'e 's_ 't_)))))
(tb2-open-st2!)
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (l0 (list 'VNB-LAMBDA 'kqe_ cb '((IP w) (s_ kqe_) (t_ kqe_))))
       (qc (tb2-qfam-type! 'v 'w cb cl 's_ 't_))
       (e4 (tb2-cite! 'hs-ip-basis-independent 'v 'w 's_ 't_ cb cl 'ix 'e)))
  (tb2-qcc! 'v 'w 's_ 't_ 'ix 'e)
  (dk-have! (list 'IN l0 (list 'FUN cb 'CC))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((k (dk-di-var!)))
            (tb2-cb-pt! 'v cl k)
            (tb2-vty! 'v 'w '(s_ t_) k)
            (tb2-ipty! 'w (list 's_ k) (list 't_ k))
            (tb2-fin!)))
        (lambda () (ass)))))
  (subst (dk-cite! 'hs-ip-unfold 'v 'w 's_ 't_))
  (dk-fun-ext! l0 qc cb 'CC #f #f
    (lambda (z)
      (tb2-cb-pt! 'v cl z)
      (tb2-vty! 'v 'w '(s_ t_) z)
      (tb2-ipty! 'w (list 's_ z) (list 't_ z))
      (dk-lam-b!)
      (tb2-close!)))
  (if (tb2-open?)
      (begin
        (subst (list '= l0 qc))
        (subst e4)
        (tb2-close!))))
(tb2-done! 'hs-ip-any-basis)

;;; ====================================================================
;;; hs-ip-family-conj: q_e(T, S) = conj q_e(S, T)
;;; ====================================================================
(sp (make-wff (tb2-st2 (list '= (tb2-qsum 'w 'ix 'e 't_ 's_) (list 'conjugate (tb2-qsum 'w 'ix 'e 's_ 't_))))))
(tb2-open-st2!)
(tb2-nag!)
(tb2-one!)
(let* ((qst (tb2-qcc! 'v 'w 's_ 't_ 'ix 'e))
       (qts (tb2-qcc! 'v 'w 't_ 's_ 'ix 'e))
       (fst (tb2-qfam-type! 'v 'w 'ix 'e 's_ 't_))
       (fts (tb2-qfam-type! 'v 'w 'ix 'e 't_ 's_))
       (vv (list '* 1 (list 'conjugate qst))))
  (dk-have! (tb2-pw 'ix fts (lambda (z) (list '* 1 (list 'conjugate (list fst z)))))
    (lambda ()
      (let* ((z (dk-di-var!)) (ez (list 'e z)) (sz (list 's_ ez)) (tz (list 't_ ez)))
        (tb2-ap! 'e 'ix '(VEC v) z)
        (tb2-vty! 'v 'w '(s_ t_) ez)
        (tb2-ipty! 'w tz sz)
        (tb2-ipty! 'w sz tz)
        (dk-lam-b!)
        (subst (tb2-cite! 'cips-ip-conj-sym 'w sz tz))
        (tb2-cc! (list 'conjugate (list '(IP w) sz tz)))
        (crs))))
  (tb2-cite! 'cc-sums-to-cscale-ptwise 'ix 1 fst fts qst)
  (tb2-cc! vv)
  (subst (tb2-unique! fts 'ix qts vv))
  (crs))
(tb2-done! 'hs-ip-family-conj)

;;; ====================================================================
;;; hs-ip-adjoint-swap  (th-main (3.13)): sum_i <S e_i | T e_i> = sum_j <T* f_j | S* f_j>
;;; ====================================================================
(define tb2-sadj '(OP-ADJOINT v w s_))
(define tb2-tadj '(OP-ADJOINT v w t_))
(sp (make-wff
  (forall-guarded '(v w) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v w s_) (IS-HILBERT-SCHMIDT v w t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        (forall-guarded '(jx f) '((IS-ORTHONORMAL-BASIS w jx f))
          (list '= (tb2-qsum 'w 'ix 'e 's_ 't_) (tb2-qsum 'v 'jx 'f tb2-tadj tb2-sadj))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tb2-onb! 'v 'ix 'e)
(tb2-onb! 'w 'jx 'f)
(tb2-hs-bounded! 'v 'w 's_)
(tb2-hs-bounded! 'v 'w 't_)
(fact 'hs-adjoint 'v 'w 's_)
(fact 'hs-adjoint 'v 'w 't_)
(tb2-hs-bounded! 'w 'v tb2-sadj)
(tb2-hs-bounded! 'w 'v tb2-tadj)
(let* ((ee (tb2-extract! 'v 'w 's_ 't_ 'ix 'e))
       (c1e (tb2-cite! 'cc-conjugate-fixes-rr 1))
       (cie (tb2-cite! 'cc-conjugate-i))
       (mi (caddr cie))
       (cn (begin (tb2-cc! mi) (tb2-cite! 'cc-conjugate-neg +i)))
       (sw (tb2-cite! 'hs-ip-family-conj 'w 'v tb2-sadj tb2-tadj 'jx 'f))
       ;; for c in {1, i}: HS_e(S + c T) = HS_f(S* + conj(c) T*), and the latter expanded
       (side (lambda (c cbar cbar-eq)
               (let* ((xx (tb2-xop 'v 'w 's_ 't_ c))
                      (sc (list 'BOP-SCALE 'v 'w c 't_))
                      (a1 (tb2-cite! 'op-adjoint-sum 'v 'w 's_ sc))
                      (a2 (tb2-cite! 'op-adjoint-scale 'v 'w c 't_))
                      (h0 (tb2-cite! 'hs-sum-adjoint-eq 'v 'w xx 'ix 'e 'jx 'f))
                      (h1 (dk-rewrite-h! h0 (list 'OP-ADJOINT 'v 'w xx) (caddr a1)))
                      (h2 (dk-rewrite-h! h1 (list 'OP-ADJOINT 'v 'w sc) (caddr a2)))
                      (h3 (dk-rewrite-h! h2 (list 'conjugate c) cbar))
                      (pp (tb2-polar! 'w 'v tb2-sadj tb2-tadj cbar 'jx 'f)))
                 (list h3 pp)))))
  (tb2-qcc! 'w 'v tb2-sadj tb2-tadj 'jx 'f)
  (tb2-ab! 'w 'v tb2-sadj tb2-tadj 'jx 'f)
  (let ((s1 (side 1 1 c1e))
        (si (side +i mi cie))
        (ha (tb2-cite! 'hs-sum-adjoint-eq 'v 'w 's_ 'ix 'e 'jx 'f))
        (hb (tb2-cite! 'hs-sum-adjoint-eq 'v 'w 't_ 'ix 'e 'jx 'f)))
    (subst sw)
    (subst ee)
    (for-each (lambda (sd)
                (let ((h (car sd)))
                  (subst (list '= (caddr h) (cadr h)))
                  (subst (cadr sd))))
              (list s1 si))
    (subst (list '= (caddr ha) (cadr ha)))
    (subst (list '= (caddr hb) (cadr hb)))
    (subst c1e)
    (subst cn)
    (subst cie)
    (crs)))
(tb2-done! 'hs-ip-adjoint-swap)

;;; ====================================================================
;;; hs-ip-conj-sym, hs-ip-adjoint: the same on HS-IP
;;; ====================================================================
(sp (make-wff (tb2-st1 (list '= '(HS-IP v w t_ s_) '(conjugate (HS-IP v w s_ t_))))))
(tb2-open-st1!)
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_)))
  (subst (tb2-cite! 'hs-ip-any-basis 'v 'w 't_ 's_ cb cl))
  (subst (tb2-cite! 'hs-ip-any-basis 'v 'w 's_ 't_ cb cl))
  (subst (tb2-cite! 'hs-ip-family-conj 'v 'w 's_ 't_ cb cl))
  (tb2-qcc! 'v 'w 's_ 't_ cb cl)
  (tb2-close!))
(tb2-done! 'hs-ip-conj-sym)

(sp (make-wff (tb2-st1 (list '= '(HS-IP v w s_ t_) (list 'HS-IP 'w 'v tb2-tadj tb2-sadj)))))
(tb2-open-st1!)
(fact 'hs-adjoint 'v 'w 's_)
(fact 'hs-adjoint 'v 'w 't_)
(let* ((cv (tb2-canon! 'v)) (cw (tb2-canon! 'w)))
  (subst (tb2-cite! 'hs-ip-any-basis 'v 'w 's_ 't_ (car cv) (cdr cv)))
  (subst (tb2-cite! 'hs-ip-any-basis 'w 'v tb2-tadj tb2-sadj (car cw) (cdr cw)))
  (subst (tb2-cite! 'hs-ip-adjoint-swap 'v 'w 's_ 't_ (car cv) (cdr cv) (car cw) (cdr cw)))
  (tb2-hs-bounded! 'w 'v tb2-sadj)
  (tb2-hs-bounded! 'w 'v tb2-tadj)
  (tb2-qcc! 'w 'v tb2-tadj tb2-sadj (car cw) (cdr cw))
  (tb2-close!))
(tb2-done! 'hs-ip-adjoint)

;;; ====================================================================
;;; trace-family-comp: for S, T Hilbert-Schmidt on H, sum_i <S T e_i | e_i> = q_e(T, S*)
;;; ====================================================================
(define tb2-sadj1 '(OP-ADJOINT v v s_))
(define tb2-st-comp '(BOP-COMP v s_ t_))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v v s_) (IS-HILBERT-SCHMIDT v v t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        (list 'AND (list 'SUMS-TO 'CC-NAG (tb2-tr 'v 'ix 'e tb2-st-comp) (tb2-qsum 'v 'ix 'e 't_ tb2-sadj1))
                   (list '= (list 'CC-FAMILY-SUM (tb2-tr 'v 'ix 'e tb2-st-comp)) (tb2-qsum 'v 'ix 'e 't_ tb2-sadj1))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tb2-onb! 'v 'ix 'e)
(tb2-hs-bounded! 'v 'v 's_)
(tb2-hs-bounded! 'v 'v 't_)
(fact 'hs-adjoint 'v 'v 's_)
(tb2-hs-bounded! 'v 'v tb2-sadj1)
(tb2-cite! 'bop-comp-bounded 'v 's_ 't_)
(tb2-cite! 'bop-fun 'v 'v tb2-st-comp)
(tb2-nag!)
(tb2-one!)
(let* ((pp tb2-st-comp)
       (qf (tb2-qcc! 'v 'v 't_ tb2-sadj1 'ix 'e))
       (ff (tb2-qfam-type! 'v 'v 'ix 'e 't_ tb2-sadj1))
       (tr (tb2-tr-type! 'v 'ix 'e pp)))
  (dk-have! (tb2-pw 'ix tr (lambda (z) (list '* 1 (list ff z))))
    (lambda ()
      (let* ((z (dk-di-var!)) (ez (list 'e z)) (tz (list 't_ ez)))
        (tb2-ap! 'e 'ix '(VEC v) z)
        (tb2-vty! 'v 'v (list 's_ 't_ tb2-sadj1 pp) ez)
        (tb2-vty! 'v 'v '(s_) tz)
        (tb2-ipty! 'v (list pp ez) ez)
        (tb2-ipty! 'v tz (list tb2-sadj1 ez))
        (dk-lam-b!)
        (subst (tb2-cite! 'bop-comp-apply 'v 's_ 't_ ez))
        (subst (tb2-cite! 'op-adjoint-ip 'v 'v 's_ tz ez))
        (crs))))
  (let* ((sm (tb2-cite! 'cc-sums-to-scale-ptwise 'ix 1 ff tr qf))
         (one-q (list '* 1 qf)))
    (dk-have! (list '= one-q qf) (lambda () (crs)))
    (dk-rewrite-h! sm one-q qf)
    (tb2-dom! tr 'ix 'CC)
    (tb2-cite! 'cc-family-sum-value tr qf)
    (dk-conj-close! (lambda () (tb2-close!)))))
(tb2-done! 'trace-family-comp)

;;; ====================================================================
;;; op-trace-canon: tr T read as a sum over the canonical ONB as an indexed family
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IN t_ (BOUNDED-OPS v v)))
      (list '== '(OP-TRACE v t_)
            (list 'CC-FAMILY-SUM (tb2-tr 'v '(CANON-ONB v) '(VNB-LAMBDA kqe_ (CANON-ONB v) kqe_) 't_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tb2-cite! 'bop-fun 'v 'v 't_)
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (l0 (list 'VNB-LAMBDA 'kqe_ cb '((IP v) (t_ kqe_) kqe_)))
       (tr (tb2-tr-type! 'v cb cl 't_)))
  (dk-have! (list 'IN l0 (list 'FUN cb 'CC))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((k (dk-di-var!)))
            (tb2-cb-pt! 'v cl k)
            (tb2-vty! 'v 'v '(t_) k)
            (tb2-ipty! 'v (list 't_ k) k)
            (tb2-fin!)))
        (lambda () (ass)))))
  (subst (dk-cite! 'op-trace-unfold 'v 't_))
  (dk-fun-ext! l0 tr cb 'CC #f #f
    (lambda (z)
      (tb2-cb-pt! 'v cl z)
      (tb2-vty! 'v 'v '(t_) z)
      (tb2-ipty! 'v (list 't_ z) z)
      (dk-lam-b!)
      (tb2-close!)))
  (if (tb2-open?)
      (begin (subst (list '= l0 tr)) (tb2-close!))))
(tb2-done! 'op-trace-canon)

;;; ====================================================================
;;; op-trace-sums  (Prop. 3.45 / Def. 3.46): T trace class, {e_i} any ONB: tr T in CC and
;;; the family <T e_i | e_i> sums to tr T
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        (list 'AND '(IN (OP-TRACE v t_) CC) (list 'SUMS-TO 'CC-NAG (tb2-tr 'v 'ix 'e 't_) '(OP-TRACE v t_))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tb2-onb! 'v 'ix 'e)
(let* ((tc (dk-landed-1 (lambda () (mac-h 'is-trace-class '(IS-TRACE-CLASS v t_))))))
  (dk-split-all! (list tc))
  (let* ((fa (dk-pick (lambda (q) (dk-head-is? q 'FORSOME)) "trace-class witness a"))
         (wa (dk-skolem! fa #t))
         (fb (dk-pick (lambda (q) (dk-head-is? q 'FORSOME)) "trace-class witness b"))
         (wb (dk-skolem! fb #t))
         (pp (list 'BOP-COMP 'v wa wb))
         (wadj (list 'OP-ADJOINT 'v 'v wa))
         (cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_)))
    (tb2-hs-bounded! 'v 'v wa)
    (tb2-hs-bounded! 'v 'v wb)
    (fact 'hs-adjoint 'v 'v wa)
    (tb2-hs-bounded! 'v 'v wadj)
    (tb2-cite! 'bop-comp-bounded 'v wa wb)
    (subst (list '= 't_ pp))
    (let* ((te (tb2-cite! 'trace-family-comp 'v wa wb 'ix 'e))
           (tcb (tb2-cite! 'trace-family-comp 'v wa wb cb cl))
           (b4 (tb2-cite! 'hs-ip-basis-independent 'v 'v wb wadj 'ix 'e cb cl))
           (oc (tb2-cite! 'op-trace-canon 'v pp)))
      (dk-split-all! (list te))
      (dk-split-all! (list tcb))
      (tb2-qcc! 'v 'v wb wadj 'ix 'e)
      (subst oc)
      (subst (caddr tcb))
      (subst (list '= (caddr b4) (cadr b4)))
      (dk-conj-close! (lambda () (tb2-close!))))))
(tb2-done! 'op-trace-sums)

;;; ====================================================================
;;; op-trace-add: tr(S + T) = tr S + tr T for S, T trace class
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IS-TRACE-CLASS v s_) (IS-TRACE-CLASS v t_))
      '(= (OP-TRACE v (BOP-SUM v v s_ t_)) (+ (OP-TRACE v s_) (OP-TRACE v t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (uu '(BOP-SUM v v s_ t_)))
  (for-each (lambda (op)
              (let ((bx (list 'IN op '(BOUNDED-OPS v v))))
                (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class (list 'IS-TRACE-CLASS 'v op))))
              (tb2-cite! 'bop-fun 'v 'v op)
              (dk-split-all! (list (tb2-cite! 'op-trace-sums 'v op cb cl))))
            '(s_ t_))
  (tb2-cite! 'bop-sum-bounded 'v 'v 's_ 't_)
  (tb2-cite! 'bop-fun 'v 'v uu)
  (let* ((fs (tb2-tr-type! 'v cb cl 's_))
         (ft (tb2-tr-type! 'v cb cl 't_))
         (fu (tb2-tr-type! 'v cb cl uu))
         (rs '(OP-TRACE v s_)) (rt '(OP-TRACE v t_)) (ru (list '+ '(OP-TRACE v s_) '(OP-TRACE v t_))))
    (dk-have! (tb2-pw cb fu (lambda (z) (list '+ (list fs z) (list ft z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (tb2-cb-pt! 'v cl z)
          (tb2-vty! 'v 'v (list 's_ 't_ uu) z)
          (tb2-vty! 'v 'v (list 's_ 't_ uu) (list cl z))
          (dk-lam-b!)
          (let ((p (if (dk-contains? (dk-goal) (list cl z)) (list cl z) z)))
            (tb2-ipty! 'v (list 's_ p) p)
            (tb2-ipty! 'v (list 't_ p) p)
            (subst (tb2-cite! 'bop-sum-apply 'v 'v 's_ 't_ p))
            (subst (tb2-cite! 'cips-ip-add-left 'v (list 's_ p) (list 't_ p) p))
            (crs)))))
    (tb2-cite! 'cc-sums-to-add-ptwise cb fs ft fu rs rt)
    (tb2-cc! ru)
    (tb2-dom! fu cb 'CC)
    (subst (tb2-cite! 'op-trace-canon 'v uu))
    (subst (tb2-cite! 'cc-family-sum-value fu ru))
    (tb2-close!)))
(tb2-done! 'op-trace-add)

;;; ====================================================================
;;; op-trace-comm: tr(S T) = tr(T S) for S, T Hilbert-Schmidt on H
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_) '((IS-HILBERT-SCHMIDT v v s_) (IS-HILBERT-SCHMIDT v v t_))
      '(= (OP-TRACE v (BOP-COMP v s_ t_)) (OP-TRACE v (BOP-COMP v t_ s_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tb2-hs-bounded! 'v 'v 's_)
(tb2-hs-bounded! 'v 'v 't_)
(fact 'hs-adjoint 'v 'v 's_)
(fact 'hs-adjoint 'v 'v 't_)
(tb2-hs-bounded! 'v 'v '(OP-ADJOINT v v s_))
(tb2-hs-bounded! 'v 'v '(OP-ADJOINT v v t_))
(let* ((cc_ (tb2-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (p1 '(BOP-COMP v s_ t_)) (p2 '(BOP-COMP v t_ s_)))
  (tb2-cite! 'bop-comp-bounded 'v 's_ 't_)
  (tb2-cite! 'bop-comp-bounded 'v 't_ 's_)
  (let ((t1 (tb2-cite! 'trace-family-comp 'v 's_ 't_ cb cl))
        (t2 (tb2-cite! 'trace-family-comp 'v 't_ 's_ cb cl))
        (sw (tb2-cite! 'hs-ip-adjoint-swap 'v 'v 't_ '(OP-ADJOINT v v s_) cb cl cb cl))
        (iv (tb2-cite! 'op-adjoint-involutive 'v 'v 's_)))
    (dk-split-all! (list t1))
    (dk-split-all! (list t2))
    (tb2-qcc! 'v 'v 's_ '(OP-ADJOINT v v t_) cb cl)
    (subst (tb2-cite! 'op-trace-canon 'v p1))
    (subst (tb2-cite! 'op-trace-canon 'v p2))
    (subst (caddr t1))
    (subst (caddr t2))
    (subst sw)
    (subst iv)
    (tb2-close!)))
(tb2-done! 'op-trace-comm)
