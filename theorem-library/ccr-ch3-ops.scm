;;; B4. Power-bounded operators: opening the definitions.

;; (IS-POWER-BOUNDED K n TM) in context: skolemize the bound, land its parts, return (c . universal)
(define (cb3-pb-open! tm)
  (let* ((ex (dk-project! `(FORSOME cbvc_ (IS-POWER-BOUNDED-BY K n ,tm cbvc_))
                          (lambda () (mac-h 'is-power-bounded `(IS-POWER-BOUNDED K n ,tm)))))
         (c  (dk-skolem! ex)))
    (cons c (cb3-pb-parts! tm c))))
(define (cb3-pb-parts! tm c)
  (let ((h `(IS-POWER-BOUNDED-BY K n ,tm ,c)))
    (dk-project! `(IN ,tm ,(cb3-mat 'n 'n)) (lambda () (mac-h 'is-power-bounded-by h)))
    (dk-project! `(IN ,c RR) (lambda () (mac-h 'is-power-bounded-by h)))
    (dk-project! `(<= 0 ,c) (lambda () (mac-h 'is-power-bounded-by h)))
    (dk-project! `(FORALL cbvk_ (IMPLIES (IN cbvk_ NN) (IS-MAT-BOUND K n n (MAT-POWER K n ,tm cbvk_) ,c)))
                 (lambda () (mac-h 'is-power-bounded-by h)))))
(define (cb3-mpw tm k) `(MPOW ,cb3-mrm ,tm ,k))
;; ||TM^k||_max <= c in the MPOW form, with TM^k typed; returns the bound
(define (cb3-pow-bound! univ tm c kk)
  (let* ((f  (dk-apply! univ kk))
         (e  (dk-cite! 'cb3-mat-power-unfold 'K 'n tm kk))
         (f2 (dk-rewrite-h! f `(MAT-POWER K n ,tm ,kk) (cb3-mpw tm kk))))
    (dk-project! `(IN ,(cb3-mpw tm kk) ,(cb3-mat 'n 'n)) (lambda () (mac-h 'is-mat-bound f2)))
    f2))
;; the MAT-POWER in the goal, as MPOW
(define (cb3-goal-matpower->mpow!)
  (let ((t (cb3-find (lambda (u) (and (pair? u) (eq? (car u) 'MAT-POWER))) (dk-goal))))
    (dk-cite! 'cb3-mat-power-unfold 'K 'n (cadddr t) (car (cddddr t)))
    (subst `(= ,t ,(cb3-mpw (cadddr t) (car (cddddr t)))))
    (car (cddddr t))))
;; the common opening of 3.3: K an NV field, MR a ring, TA and SA power bounded and commuting in MR
(define (cb3-33-open! prod-eq)
  (dk-cite! 'nv-field-normed 'K)
  (cb3-view!)
  (dk-cite! 'cb3-mr-ring 'K 'n)
  (dk-cite! 'cb3-mr-carr 'K 'n)
  (let* ((ot (cb3-pb-open! 'ta)) (os #f))
    (set! os (cb3-pb-open! 'sa))
    (for-each (lambda (x) (dk-have! `(IN ,x (CARR ,cb3-mr)) (lambda () (subst `(= (CARR ,cb3-mr) ,(cb3-mat 'n 'n))) (dk-ass!))))
              '(ta sa))
    (dk-cite! 'cb3-mr-mul-apply 'K 'n 'ta 'sa)
    (dk-cite! 'cb3-mr-mul-apply 'K 'n 'sa 'ta)
    (dk-have! `(= ((MUL ,cb3-mr) ta sa) ((MUL ,cb3-mr) sa ta))
      (lambda () (subst `(= ((MUL ,cb3-mr) ta sa) (MATMUL ,cb3-v ta sa)))
                 (subst `(= ((MUL ,cb3-mr) sa ta) (MATMUL ,cb3-v sa ta)))
                 (dk-ass!)))
    (let ((ct (car ot)) (cs (car os)))
      (dk-cite! 'rr-mul-in-rr ct cs)
      (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
      (dk-cite! 'rr-prod-le-gen 0 0 ct cs)
      (dk-have! `(<= 0 (* ,ct ,cs)) (lambda () (dk-ineq! `(<= (* 0 0) (* ,ct ,cs)))))
      (list ct (cdr ot) cs (cdr os)))))

;;; -----------------------------------------------------------------------
;;; PROPOSITION 3.3.  Commuting power bounded operators have power bounded product and sum.

(define cb3-33-hyps
  (lambda (concl)
    `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL ta (FORALL sa
       (IMPLIES (IS-POWER-BOUNDED K n ta) (IMPLIES (IS-POWER-BOUNDED K n sa)
       (IMPLIES (= (MATMUL ,cb3-v ta sa) (MATMUL ,cb3-v sa ta)) ,concl)))))))))))

(sp (make-wff (cb3-33-hyps `(IS-POWER-BOUNDED K n (MATMUL ,cb3-v ta sa)))))
(dk-peel!)
(let* ((o (cb3-33-open! #t)) (ct (car o)) (ut (cadr o)) (cs (caddr o)) (us (cadddr o))
       (cd `(* ,ct ,cs)) (prod `(MATMUL ,cb3-v ta sa)) (mprod `((MUL ,cb3-mr) ta sa)))
  (cb3-to-v! 'ta 'n 'n) (cb3-to-v! 'sa 'n 'n)
  (cb3-guard! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))))
  (dk-cite! 'matmul-type cb3-v 'n 'n 'n 'ta 'sa)
  (cb3-to-k! prod 'n 'n)
  (mac 'is-power-bounded)
  (ew cd)
  (mac 'is-power-bounded-by)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-head-is? (dk-goal) 'FORALL))
          (dk-ass!)
          (begin
            (dk-peel!)
            (let* ((kv (cb3-goal-matpower->mpow!)) (pa (cb3-mpw 'ta kv)) (pb (cb3-mpw 'sa kv)))
              (subst `(= ,prod ,mprod))
              (dk-cite! 'cb3-mpow-mul-commute cb3-mr 'ta 'sa kv)
              (subst `(= ,(cb3-mpw mprod kv) ((MUL ,cb3-mr) ,pa ,pb)))
              (cb3-pow-bound! ut 'ta ct kv)
              (cb3-pow-bound! us 'sa cs kv)
              (dk-cite! 'cb3-mr-mul-apply 'K 'n pa pb)
              (subst `(= ((MUL ,cb3-mr) ,pa ,pb) (MATMUL ,cb3-v ,pa ,pb)))
              (dk-cite! 'cb3-mat-bound-mul 'K 'n pa pb ct cs)
              (dk-ass!)))))))
(qed 'ccr-3-3-product)

(define (cb3-bset cd) `(SEP cbx_ ,(cb3-mat 'n 'n) (IS-MAT-BOUND K n n cbx_ ,cd)))

(sp (make-wff (cb3-33-hyps `(IS-POWER-BOUNDED K n (MATADD ,cb3-v ta sa)))))
(dk-peel!)
(let* ((o (cb3-33-open! #t)) (ct (car o)) (ut (cadr o)) (cs (caddr o)) (us (cadddr o))
       (cd `(* ,ct ,cs)) (bs (cb3-bset cd)) (sum `(MATADD ,cb3-v ta sa)) (msum `((ADD ,cb3-mr) ta sa)))
  ;; B is closed under +
  (dk-have! `(FORALL cbu (IMPLIES (IN cbu ,bs) (FORALL cbv (IMPLIES (IN cbv ,bs) (IN ((ADD ,cb3-mr) cbu cbv) ,bs)))))
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (uv (cadr (cadr g))) (vv (caddr (cadr g))))
        (for-each (lambda (w)
                    (dk-have! `(IN ,w ,(cb3-mat 'n 'n)) (lambda () (sep-me `(IN ,w ,bs)) (dk-ass!)))
                    (dk-have! `(IS-MAT-BOUND K n n ,w ,cd) (lambda () (sep-me `(IN ,w ,bs)) (dk-ass!))))
                  (list uv vv))
        (dk-cite! 'cb3-mr-add-apply 'K 'n uv vv)
        (subst `(= ((ADD ,cb3-mr) ,uv ,vv) (MATADD ,cb3-v ,uv ,vv)))
        (let ((f (dk-cite! 'cb3-mat-bound-add 'K 'n 'n uv vv cd)))
          (dk-project! `(IN (MATADD ,cb3-v ,uv ,vv) ,(cb3-mat 'n 'n)) (lambda () (mac-h 'is-mat-bound f)))
          (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
  ;; every T^a S^b is in B
  (dk-have! `(FORALL cba (IMPLIES (IN cba NN) (FORALL cbb (IMPLIES (IN cbb NN)
               (IN ((MUL ,cb3-mr) ,(cb3-mpw 'ta 'cba) ,(cb3-mpw 'sa 'cbb)) ,bs)))))
    (lambda ()
      (dk-peel!)
      (let* ((av (cb3-exp-of 'ta)) (bv (cb3-exp-of 'sa)) (pa (cb3-mpw 'ta av)) (pb (cb3-mpw 'sa bv)))
        (cb3-pow-bound! ut 'ta ct av)
        (cb3-pow-bound! us 'sa cs bv)
        (dk-cite! 'cb3-mr-mul-apply 'K 'n pa pb)
        (subst `(= ((MUL ,cb3-mr) ,pa ,pb) (MATMUL ,cb3-v ,pa ,pb)))
        (let ((f (dk-cite! 'cb3-mat-bound-mul 'K 'n pa pb ct cs)))
          (dk-project! `(IN (MATMUL ,cb3-v ,pa ,pb) ,(cb3-mat 'n 'n)) (lambda () (mac-h 'is-mat-bound f)))
          (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))
  (let ((allm (dk-cite! 'cb3-sum-powers-in cb3-mr bs 'ta 'sa)))
    (dk-cite! 'cb3-mr-add-apply 'K 'n 'ta 'sa)
    (cb3-to-v! 'ta 'n 'n) (cb3-to-v! 'sa 'n 'n)
    (dk-cite! 'matadd-type cb3-v 'n 'n 'ta 'sa)
    (cb3-to-k! sum 'n 'n)
    (mac 'is-power-bounded)
    (ew cd)
    (mac 'is-power-bounded-by)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (dk-ass!)
            (begin
              (dk-peel!)
              (let ((kv (cb3-goal-matpower->mpow!)))
                (subst `(= ,sum ,msum))
                (dk-apply! allm kv)
                (sep-me `(IN ,(cb3-mpw msum kv) ,bs))
                (dk-ass!))))))))
(qed 'ccr-3-3-sum)

