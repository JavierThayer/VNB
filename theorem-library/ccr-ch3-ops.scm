;;; ccr-ch3-ops.scm -- OPERATORS ON K^n OVER A NON-ARCHIMEDEAN VALUED FIELD: CCR.pdf chapter 3, s. 3.1
;;; (the inequalities (19)-(21), Proposition 3.3, Lemma 3.5, the multiplicative half of Proposition 3.6).
;;; Vocabulary: structure-library/ccr-ch3-vocab.scm.  Agent CCR-1109-B, wave 2026-11-09.
;;; Destination: theorem-library/ccr-ch3-ops.scm.  Library: analysis.  Helper prefix cb3-.
;;;
;;; PLAN.  Part A is pure ring theory in a ring R (no commutativity), powers being MPOW in the
;;; multiplicative monoid:  x y = y x  gives  x^k y = y x^k  and  (x y)^k = x^k y^k;  and THE BINOMIAL-FREE
;;; SUM LEMMA: if B is closed under + and every x^a y^b lies in B, then every (x + y)^m lies in B.  It is
;;; proved by induction on m of  "for all a, b:  (x^a y^b)(x + y)^m in B",  since
;;;     (x^a y^b)(x + y)^(m+1) = (x^(a+1) y^b)(x + y)^m + (x^a y^(b+1))(x + y)^m .
;;; This replaces the notes' Binomial Theorem (and the remark "the coefficients are elements of Z", i.e.
;;; |binom(M, k)| <= 1): in an ultrametric setting the set of matrices of max norm <= C is closed under +.
;;; Part B is the matrix side over V = NORMED-FIELD-AS-COMMUTATIVE-RING(K): the max-norm bounds (19), (20)
;;; and (21), then 3.3, 3.5 and 3.6 (multiplicativity).
;;;
;;; LOAD WINDOW: after theorem-library/ccr2-nv (nv-ultra, nv-finsum-le, nv-pow-norm-power, rr-prod-le-gen,
;;; nf-norm-one) and structure-library/ccr-ch3-vocab; the other citations (mat-ring-proof, det-multiplicative,
;;; rake-inequalities, phi-growth, geometric-series) load earlier.  No citer.

(define cb3-mm '(RING-MULTIPLICATIVE-MONOID R))
(define (cb3-pw x k) `(MPOW (RING-MULTIPLICATIVE-MONOID R) ,x ,k))
(define (cb3-m x y) `((MUL R) ,x ,y))
(define (cb3-a x y) `((ADD R) ,x ,y))

;; first subterm of TREE satisfying PRED
(define (cb3-find pred tree)
  (cond ((pred tree) tree)
        ((pair? tree) (or (cb3-find pred (car tree)) (cb3-find pred (cdr tree))))
        (#t #f)))
;; the exponent of the first power of BASE in the goal (an MPOW over any monoid)
(define (cb3-exp-of base)
  (let ((t (cb3-find (lambda (u) (and (pair? u) (eq? (car u) 'MPOW) (pair? (cdr u)) (pair? (cddr u))
                                      (equal? (caddr u) base)))
                     (dk-goal))))
    (if t (cadddr t) (error "cb3-exp-of: no power of" base))))
;; the n of the first (succ n) in the goal
(define (cb3-succ-var)
  (let ((t (cb3-find (lambda (u) (and (pair? u) (eq? (car u) 'succ))) (dk-goal))))
    (if t (cadr t) (error "cb3-succ-var: no succ in the goal"))))
;; the base and step leaves of dk-ni-fixed!
(define (cb3-ni! hoist)
  (let ((r (dk-ni-fixed! hoist)))
    (list (cdr (assq 'base r)) (cdr (assq 'step r)))))

;; typing in the ring R and in its multiplicative monoid
(define (cb3-ring!)
  (dk-cite! 'ring-multiplicative-monoid-is-monoid 'R)
  (dk-cite! 'rmm-carr 'R) (dk-cite! 'rmm-op 'R) (dk-cite! 'rmm-iden 'R))
(define (cb3-in-mm! x)
  (dk-have! `(IN ,x (CARR ,cb3-mm)) (lambda () (subst `(= (CARR ,cb3-mm) (CARR R))) (dk-ass!))))
(define (cb3-ty-pw! x k)                ; x^k in CARR R (x typed in CARR R)
  (cb3-in-mm! x)
  (dk-cite! 'mpow-type cb3-mm x k)
  (dk-have! `(IN ,(cb3-pw x k) (CARR R)) (lambda () (subst `(= (CARR R) (CARR ,cb3-mm))) (dk-ass!))))
(define (cb3-ty-m! x y) (dk-cite! 'ring-carrier-closed-mul 'R x y))
(define (cb3-ty-a! x y) (dk-cite! 'ring-add-closed 'R x y))
;; x^0 = 1 and x^(k+1) = x x^k, rewritten in the goal
(define (cb3-pw0! x)
  (dk-cite! 'mpow-zero cb3-mm x)
  (subst `(= ,(cb3-pw x 0) (IDEN ,cb3-mm)))
  (subst `(= (IDEN ,cb3-mm) (ONE R))))
(define (cb3-pws! x k)
  (dk-cite! 'mpow-succ cb3-mm x k)
  (subst `(= ,(cb3-pw x `(succ ,k)) ((OPR ,cb3-mm) ,x ,(cb3-pw x k))))
  (subst `(= (OPR ,cb3-mm) (MUL R))))
;; associativity (a b) c = a (b c), cited and used left to right or right to left in the goal
(define (cb3-assoc! a b c)
  (dk-cite! 'ring-mul-assoc 'R a b c)
  (subst `(= ,(cb3-m (cb3-m a b) c) ,(cb3-m a (cb3-m b c)))))
(define (cb3-assoc-rev! a b c)
  (dk-cite! 'ring-mul-assoc 'R a b c)
  (subst `(= ,(cb3-m a (cb3-m b c)) ,(cb3-m (cb3-m a b) c))))

;;; -----------------------------------------------------------------------
;;; A1. x y = y x  gives  x^k y = y x^k.

(sp (make-wff `(FORALL cbk (IMPLIES (IN cbk NN) (FORALL R (IMPLIES (IS-RING R)
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
      (= ,(cb3-m (cb3-pw 'x 'cbk) 'y) ,(cb3-m 'y (cb3-pw 'x 'cbk))))))))))))))
(let* ((bs (cb3-ni! '(R x y))))
  (dk-focus! (car bs))
  (cb3-ring!)
  (cb3-pw0! 'x)
  (dk-cite! 'ring-mul-left-id 'R 'y)
  (dk-cite! 'ring-mul-right-id 'R 'y)
  (subst `(= ,(cb3-m '(ONE R) 'y) y))
  (subst `(= ,(cb3-m 'y '(ONE R)) y))
  (rfl)
  (dk-focus! (cadr bs))
  (dk-peel!)
  (let* ((nv (cb3-succ-var)) (xn (cb3-pw 'x nv)))
    (cb3-ring!)
    (cb3-ty-pw! 'x nv)
    (cb3-pws! 'x nv)
    (cb3-assoc! 'x xn 'y)
    (subst `(= ,(cb3-m xn 'y) ,(cb3-m 'y xn)))
    (cb3-assoc-rev! 'x 'y xn)
    (subst `(= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x)))
    (dk-cite! 'ring-mul-assoc 'R 'y 'x xn)
    (dk-ass!)))
(qed 'cb3-mpow-commute-ind)

(sp (make-wff `(FORALL R (IMPLIES (IS-RING R)
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
      (FORALL cbk (IMPLIES (IN cbk NN) (= ,(cb3-m (cb3-pw 'x 'cbk) 'y) ,(cb3-m 'y (cb3-pw 'x 'cbk))))))))))))))
(dk-peel!)
(dk-cite! 'cb3-mpow-commute-ind (cb3-exp-of 'x) 'R 'x 'y)
(dk-ass!)
(qed 'cb3-mpow-commute)

;;; -----------------------------------------------------------------------
;;; A2. x y = y x  gives  (x y)^k = x^k y^k.

(sp (make-wff `(FORALL cbk (IMPLIES (IN cbk NN) (FORALL R (IMPLIES (IS-RING R)
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
      (= ,(cb3-pw (cb3-m 'x 'y) 'cbk) ,(cb3-m (cb3-pw 'x 'cbk) (cb3-pw 'y 'cbk))))))))))))))
(let* ((bs (cb3-ni! '(R x y))) (xy (cb3-m 'x 'y)))
  (dk-focus! (car bs))
  (cb3-ring!)
  (cb3-pw0! xy) (cb3-pw0! 'x) (cb3-pw0! 'y)
  (dk-cite! 'ring-one-in 'R)
  (dk-cite! 'ring-mul-left-id 'R '(ONE R))
  (subst `(= ,(cb3-m '(ONE R) '(ONE R)) (ONE R)))
  (rfl)
  (dk-focus! (cadr bs))
  (dk-peel!)
  (let* ((nv (cb3-succ-var)) (xn (cb3-pw 'x nv)) (yn (cb3-pw 'y nv)))
    (cb3-ring!)
    (cb3-ty-m! 'x 'y)
    (cb3-ty-pw! xy nv) (cb3-ty-pw! 'x nv) (cb3-ty-pw! 'y nv)
    (cb3-ty-m! xn yn) (cb3-ty-m! 'y yn) (cb3-ty-m! 'y xn) (cb3-ty-m! 'x xn)
    (cb3-pws! xy nv) (cb3-pws! 'x nv) (cb3-pws! 'y nv)
    (subst `(= ,(cb3-pw xy nv) ,(cb3-m xn yn)))
    (dk-cite! 'cb3-mpow-commute 'R 'x 'y nv)                        ; x^n y = y x^n
    (cb3-assoc! 'x 'y (cb3-m xn yn))
    (cb3-assoc-rev! 'y xn yn)
    (subst `(= ,(cb3-m 'y xn) ,(cb3-m xn 'y)))
    (cb3-assoc! xn 'y yn)
    (cb3-assoc-rev! 'x xn (cb3-m 'y yn))
    (rfl)))
(qed 'cb3-mpow-mul-commute-ind)

(sp (make-wff `(FORALL R (IMPLIES (IS-RING R)
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
      (FORALL cbk (IMPLIES (IN cbk NN)
        (= ,(cb3-pw (cb3-m 'x 'y) 'cbk) ,(cb3-m (cb3-pw 'x 'cbk) (cb3-pw 'y 'cbk))))))))))))))
(dk-peel!)
(dk-cite! 'cb3-mpow-mul-commute-ind (cb3-exp-of 'x) 'R 'x 'y)
(dk-ass!)
(qed 'cb3-mpow-mul-commute)

;;; -----------------------------------------------------------------------
;;; A3. THE BINOMIAL-FREE SUM LEMMA.  B closed under +, x y = y x, every x^a y^b in B: then every
;;; (x + y)^m is in B.  The induction carries the left factor x^a y^b.

(define cb3-s (cb3-a 'x 'y))
(define cb3-closure
  `(FORALL cbu (IMPLIES (IN cbu bs) (FORALL cbv (IMPLIES (IN cbv bs) (IN ,(cb3-a 'cbu 'cbv) bs))))))
(define cb3-powhyp
  `(FORALL cba (IMPLIES (IN cba NN) (FORALL cbb (IMPLIES (IN cbb NN)
     (IN ,(cb3-m (cb3-pw 'x 'cba) (cb3-pw 'y 'cbb)) bs))))))
;; the hypothesis in context whose shape matches (alpha-insensitive picks by content)
(define (cb3-closure-hyp)
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bs) (dk-contains? f '(ADD R))
                            (not (dk-contains? f 'MPOW))))
           "the closure of B under +"))
(define (cb3-powhyp-hyp)
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bs) (dk-contains? f 'MPOW)
                            (not (dk-contains? f '(ADD R)))))
           "x^a y^b in B"))
(define (cb3-ih-hyp)
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bs) (dk-contains? f 'MPOW)
                            (dk-contains? f '(ADD R))))
           "the induction hypothesis"))

(sp (make-wff `(FORALL cbm (IMPLIES (IN cbm NN) (FORALL R (IMPLIES (IS-RING R)
  (FORALL bs (IMPLIES ,cb3-closure
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
    (IMPLIES ,cb3-powhyp
      (FORALL cba (IMPLIES (IN cba NN) (FORALL cbb (IMPLIES (IN cbb NN)
        (IN ,(cb3-m (cb3-m (cb3-pw 'x 'cba) (cb3-pw 'y 'cbb)) (cb3-pw cb3-s 'cbm)) bs)))))))))))))))))))
(let* ((bs (cb3-ni! '(R bs x y))) (s cb3-s))
  ;; base: (x^a y^b) (x + y)^0 = x^a y^b
  (dk-focus! (car bs))
  (dk-peel!)
  (let* ((av (cb3-exp-of 'x)) (bv (cb3-exp-of 'y))
         (xa (cb3-pw 'x av)) (yb (cb3-pw 'y bv)) (w (cb3-m xa yb)))
    (cb3-ring!)
    (cb3-ty-a! 'x 'y)
    (cb3-ty-pw! 'x av) (cb3-ty-pw! 'y bv) (cb3-ty-m! xa yb)
    (cb3-pw0! s)
    (dk-cite! 'ring-mul-right-id 'R w)
    (subst `(= ,(cb3-m w '(ONE R)) ,w))
    (dk-apply! (cb3-powhyp-hyp) av bv)
    (dk-ass!))
  ;; step
  (dk-focus! (cadr bs))
  (dk-peel!)
  (let* ((nv (cb3-succ-var)) (av (cb3-exp-of 'x)) (bv (cb3-exp-of 'y))
         (xa (cb3-pw 'x av)) (yb (cb3-pw 'y bv)) (w (cb3-m xa yb))
         (sn (cb3-pw s nv))
         (xa1 (cb3-pw 'x `(succ ,av))) (yb1 (cb3-pw 'y `(succ ,bv)))
         (wx (cb3-m w 'x)) (wy (cb3-m w 'y))
         (ih (cb3-ih-hyp)) (cl (cb3-closure-hyp)))
    (cb3-ring!)
    (cb3-ty-a! 'x 'y)
    (cb3-ty-pw! 'x av) (cb3-ty-pw! 'y bv) (cb3-ty-m! xa yb) (cb3-ty-pw! s nv)
    (cb3-ty-m! w 'x) (cb3-ty-m! w 'y) (cb3-ty-m! wx sn) (cb3-ty-m! wy sn)
    (cb3-ty-m! yb 'x) (cb3-ty-m! 'x yb) (cb3-ty-m! xa 'x) (cb3-ty-m! 'x xa)
    (cb3-ty-m! yb 'y) (cb3-ty-m! 'y yb)
    ;; w (x+y)^(n+1) = (w x) (x+y)^n + (w y) (x+y)^n
    (cb3-pws! s nv)
    (cb3-assoc-rev! w s sn)
    (dk-cite! 'ring-left-dist 'R w 'x 'y)
    (subst `(= ,(cb3-m w s) ,(cb3-a wx wy)))
    (dk-cite! 'ring-right-dist 'R wx wy sn)
    (subst `(= ,(cb3-m (cb3-a wx wy) sn) ,(cb3-a (cb3-m wx sn) (cb3-m wy sn))))
    ;; w x = x^(a+1) y^b
    (dk-have! `(= ,(cb3-m 'y 'x) ,(cb3-m 'x 'y))
      (lambda () (subst `(= ,(cb3-m 'y 'x) ,(cb3-m 'x 'y))) (rfl)))
    (dk-cite! 'cb3-mpow-commute 'R 'y 'x bv)                       ; y^b x = x y^b
    (dk-have! `(= ,(cb3-m 'x 'x) ,(cb3-m 'x 'x)) (lambda () (rfl)))
    (dk-cite! 'cb3-mpow-commute 'R 'x 'x av)                       ; x^a x = x x^a
    (dk-have! `(= ,(cb3-m 'y 'y) ,(cb3-m 'y 'y)) (lambda () (rfl)))
    (dk-cite! 'cb3-mpow-commute 'R 'y 'y bv)                       ; y^b y = y y^b
    (dk-have! `(= ,wx ,(cb3-m xa1 yb))
      (lambda ()
        (cb3-pws! 'x av)
        (cb3-assoc! xa yb 'x)
        (subst `(= ,(cb3-m yb 'x) ,(cb3-m 'x yb)))
        (cb3-assoc-rev! xa 'x yb)
        (subst `(= ,(cb3-m xa 'x) ,(cb3-m 'x xa)))
        (rfl)))
    (dk-have! `(= ,wy ,(cb3-m xa yb1))
      (lambda ()
        (cb3-pws! 'y bv)
        (cb3-assoc! xa yb 'y)
        (subst `(= ,(cb3-m yb 'y) ,(cb3-m 'y yb)))
        (rfl)))
    (subst `(= ,wx ,(cb3-m xa1 yb)))
    (subst `(= ,wy ,(cb3-m xa yb1)))
    (dk-cite! 'nn-succ-closed av)
    (dk-cite! 'nn-succ-closed bv)
    (let ((t1 (dk-apply! ih `(succ ,av) bv))
          (t2 #f))
      (set! t2 (dk-apply! ih av `(succ ,bv)))
      (dk-apply! cl (cb3-m (cb3-m xa1 yb) sn) (cb3-m (cb3-m xa yb1) sn))
      (dk-ass!))))
(qed 'cb3-sum-powers-in-ind)

(sp (make-wff `(FORALL R (IMPLIES (IS-RING R)
  (FORALL bs (IMPLIES ,cb3-closure
  (FORALL x (FORALL y (IMPLIES (IN x (CARR R)) (IMPLIES (IN y (CARR R))
    (IMPLIES (= ,(cb3-m 'x 'y) ,(cb3-m 'y 'x))
    (IMPLIES ,cb3-powhyp
      (FORALL cbm (IMPLIES (IN cbm NN) (IN ,(cb3-pw cb3-s 'cbm) bs)))))))))))))))
(dk-peel!)
(let* ((mv (cb3-exp-of cb3-s)) (sm (cb3-pw cb3-s mv))
       (x0 (cb3-pw 'x 0)) (y0 (cb3-pw 'y 0)) (big (cb3-m (cb3-m x0 y0) sm)))
  (cb3-ring!)
  (cb3-ty-a! 'x 'y)
  (cb3-ty-pw! cb3-s mv)
  (dk-cite! 'nn-zero-in)
  (let ((f (dk-apply! (dk-cite! 'cb3-sum-powers-in-ind mv 'R 'bs 'x 'y) 0 0)))
    (dk-cite! 'ring-one-in 'R)
    (dk-have! `(= ,big ,sm)
      (lambda ()
        (cb3-pw0! 'x) (cb3-pw0! 'y)
        (dk-cite! 'ring-mul-left-id 'R '(ONE R))
        (subst `(= ,(cb3-m '(ONE R) '(ONE R)) (ONE R)))
        (dk-cite! 'ring-mul-left-id 'R sm)
        (subst `(= ,(cb3-m '(ONE R) sm) ,sm))
        (rfl)))
    (dk-rewrite-h! f big sm)
    (dk-ass!)))
(qed 'cb3-sum-powers-in)

;;; =======================================================================
;;; PART B.  Matrices over K.  V = NORMED-FIELD-AS-COMMUTATIVE-RING(K); MR = MAT-RING(V, n).

(define cb3-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define cb3-mr `(MAT-RING ,cb3-v n))
(define cb3-mrm `(RING-MULTIPLICATIVE-MONOID ,cb3-mr))
(define (cb3-n x) `((FNRM K) ,x))
(define (cb3-mat m n) `(MAT ,m ,n (CARR K)))
(define (cb3-matv m n) `(MAT ,m ,n (CARR ,cb3-v)))
;; the view's read-offs (K a normed field in context)
(define (cb3-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring cb3-v)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-one normed-field-ring-view-zero)))
;; (IN A (MAT m n (CARR K)))  <->  (IN A (MAT m n (CARR V)))
(define (cb3-to-v! a m n)
  (dk-have! `(IN ,a ,(cb3-matv m n)) (lambda () (subst `(= (CARR ,cb3-v) (CARR K))) (dk-ass!))))
(define (cb3-to-k! a m n)
  (dk-have! `(IN ,a ,(cb3-mat m n)) (lambda () (subst `(= (CARR K) (CARR ,cb3-v))) (dk-ass!))))
;; the projections of IS-MAT-BOUND(K, m, n, A, c), the hypothesis kept
(define (cb3-bound-univ a m n c)
  `(FORALL cbvi_ (IMPLIES (IN cbvi_ (INTERVAL 1 ,m))
     (FORALL cbvj_ (IMPLIES (IN cbvj_ (INTERVAL 1 ,n)) (<= ,(cb3-n `(ENTRY ,a cbvi_ cbvj_)) ,c))))))
(define (cb3-bound-parts! a m n c)
  (let ((h `(IS-MAT-BOUND K ,m ,n ,a ,c)))
    (dk-project! `(IN ,a ,(cb3-mat m n)) (lambda () (mac-h 'is-mat-bound h)))
    (dk-project! (cb3-bound-univ a m n c) (lambda () (mac-h 'is-mat-bound h)))))
;; (n = 0 implies n = 0 or n = 0)-style guards of matmul-type
(define (cb3-guard! g) (dk-have! g (lambda () (prop))))

;;; B0. The ring of matrices.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (IS-RING ,cb3-mr)))))))
(dk-peel!)
(cb3-view!)
(dk-cite! 'mat-ring-is-ring cb3-v 'n)
(dk-ass!)
(qed 'cb3-mr-ring)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
  (= (CARR ,cb3-mr) ,(cb3-mat 'n 'n))))))))
(dk-peel!)
(cb3-view!)
(dk-cite! 'mat-ring-carr cb3-v 'n)
(subst `(= (CARR ,cb3-mr) ,(cb3-matv 'n 'n)))
(subst `(= (CARR ,cb3-v) (CARR K)))
(rfl)
(qed 'cb3-mr-carr)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
  (FORALL cbp (FORALL cbq (IMPLIES (IN cbp ,(cb3-mat 'n 'n)) (IMPLIES (IN cbq ,(cb3-mat 'n 'n))
    (= ((MUL ,cb3-mr) cbp cbq) (MATMUL ,cb3-v cbp cbq))))))))))))
(dk-peel!)
(cb3-view!)
(cb3-to-v! 'cbp 'n 'n) (cb3-to-v! 'cbq 'n 'n)
(cb3-guard! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))))
(dk-cite! 'matmul-type cb3-v 'n 'n 'n 'cbp 'cbq)
(subst (dk-cite! 'mat-ring-mul cb3-v 'n))
(dk-lam-b!)
(rfl)
(qed 'cb3-mr-mul-apply)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
  (FORALL cbp (FORALL cbq (IMPLIES (IN cbp ,(cb3-mat 'n 'n)) (IMPLIES (IN cbq ,(cb3-mat 'n 'n))
    (= ((ADD ,cb3-mr) cbp cbq) (MATADD ,cb3-v cbp cbq))))))))))))
(dk-peel!)
(cb3-view!)
(cb3-to-v! 'cbp 'n 'n) (cb3-to-v! 'cbq 'n 'n)
