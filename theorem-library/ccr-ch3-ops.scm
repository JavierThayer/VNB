(dk-cite! 'cb3-det-bound-ind 'n 'K 'A 'c)
(dk-ass!)
(qed 'ccr-3-1-eq21)

;;; B10. A real lemma: 0 <= x and a common bound on all the x^N give x <= 1 (Bernoulli + Archimedes).

(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x) (FORALL cbB (IMPLIES (IN cbB RR)
  (IMPLIES (FORALL cbN (IMPLIES (IN cbN NN) (<= (power x cbN) cbB))) (<= x 1)))))))))
(dk-peel!)
(let ((hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'power))) "the bound on the powers")))
  (dk-cite! 'rr-one-in)
  (use-em '(<= x 1)
    (lambda () (dk-ass!))
    (lambda ()
      (dk-cite! 'rr-not-le-lt 'x 1)
      (dk-cite! 'rr-sub-in-rr 'x 1)
      (let* ((h (dk-name! '(- x 1))))
        (dk-have! `(< 0 ,h) (lambda () (dk-ineq! `(= ,h (- x 1)) '(< 1 x))))
        (dk-cite! 'rr-pos-rr-of-lt h)
        (let* ((ex (dk-cite! 'rr-archimedean-multiple h 'cbB))
               (nv (dk-skolem! ex)))
          (dk-cite! 'nn-in-rr nv)
          (dk-cite! 'rr-mul-in-rr nv h)
          (let ((imp (dk-cite! 'rr-bernoulli h nv)))
            (if (dk-head-is? imp 'IMPLIES)
                (begin (dk-have! (cadr imp) (lambda () (dk-ineq! `(< 0 ,h))))
                       (detach! imp))))
          (dk-real! `(+ 1 ,h))
          (cb3-and! '(IN x RR) `(IN (+ 1 ,h) RR))
          (dk-have! `(<= x (+ 1 ,h)) (lambda () (dk-ineq! `(= ,h (- x 1)))))
          (dk-have! `(<= (+ 1 ,h) x) (lambda () (dk-ineq! `(= ,h (- x 1)))))
          (cb3-and! `(<= x (+ 1 ,h)) `(<= (+ 1 ,h) x))
          (dk-cite! 'rr-leq-antisymmetric 'x `(+ 1 ,h))
          (let* ((bern (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f `(+ 1 ,h)) (dk-contains? f 'power))) "Bernoulli"))
                 (b2 (dk-rewrite-h! bern `(+ 1 ,h) 'x)))
            (dk-apply! hb nv)
            (dk-cite! 'power-real-closed 'x nv)
            (dk-ineq! b2 `(<= (power x ,nv) cbB) `(<= cbB (* ,nv ,h)))))))))
(qed 'cb3-rr-power-bounded-le-one)

;;; -----------------------------------------------------------------------
;;; LEMMA 3.5.  T power bounded gives |det(I + T)| <= 1.  The notes' hypothesis |det T| <= 1 is not used
;;; by the proof (it is used where 3.5 is applied, in 3.6); cb3-det-shift-bound is the statement without it.

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL ta
  (IMPLIES (IS-POWER-BOUNDED K n ta)
    (<= ,(cb3-n `(DET ,cb3-v n (MATADD ,cb3-v (IDENTMAT ,cb3-v n) ta))) 1)))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(cb3-view!)
(let* ((id `(IDENTMAT ,cb3-v n)) (st `(MATADD ,cb3-v ,id ta)) (dst `(DET ,cb3-v n ,st)))
  (cb3-pb-open! 'ta)
  (dk-cite! 'cb3-identmat-power-bounded 'K 'n)
  (dk-have! `(IS-POWER-BOUNDED K n ,id) (lambda () (mac 'is-power-bounded) (ew 1) (dk-ass!)))
  (cb3-to-v! 'ta 'n 'n)
  (dk-cite! 'identmat-left-identity cb3-v 'n 'n 'ta)
  (dk-cite! 'identmat-right-identity cb3-v 'n 'n 'ta)
  (dk-have! `(= (MATMUL ,cb3-v ,id ta) (MATMUL ,cb3-v ta ,id))
    (lambda () (subst `(= (MATMUL ,cb3-v ,id ta) ta)) (subst `(= (MATMUL ,cb3-v ta ,id) ta)) (rfl)))
  (dk-cite! 'ccr-3-3-sum 'K 'n id 'ta)
  (let* ((o (cb3-pb-open! st)) (c (car o)) (u (cdr o)))
    (cb3-to-v! st 'n 'n)
    (dk-cite! 'det-in-carrier cb3-v 'n st)
    (dk-have! `(IN ,dst (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cb3-v))) (dk-ass!)))
    (dk-cite! 'nf-norm-in-rr 'K dst)
    (dk-cite! 'nf-norm-nonneg 'K dst)
    (dk-cite! 'power-real-closed c 'n)
    (dk-have! `(FORALL cbN (IMPLIES (IN cbN NN) (<= (power ,(cb3-n dst) cbN) (power ,c n))))
      (lambda ()
        (dk-peel!)
        (let* ((nv (caddr (cadr (dk-goal)))) (pw (cb3-mpw st nv)))
          (cb3-pow-bound! u st c nv)
          (dk-cite! 'ccr-3-1-eq21 'K 'n pw c)
          (dk-cite! 'cb3-det-mpow-ind nv 'K 'n st)
          (dk-cite! 'nv-pow-norm-power 'K dst nv)
          (subst `(= (power ,(cb3-n dst) ,nv) ,(cb3-n (cb3-rp dst nv))))
          (subst `(= ,(cb3-rp dst nv) (DET ,cb3-v n ,pw)))
          (dk-ass!))))
    (dk-cite! 'cb3-rr-power-bounded-le-one (cb3-n dst) `(power ,c n))
    (dk-ass!)))
(qed 'cb3-det-shift-bound)

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL ta
  (IMPLIES (IS-POWER-BOUNDED K n ta) (IMPLIES (<= ,(cb3-n `(DET ,cb3-v n ta)) 1)
    (<= ,(cb3-n `(DET ,cb3-v n (MATADD ,cb3-v (IDENTMAT ,cb3-v n) ta))) 1))))))))))
(dk-peel!)
(dk-cite! 'cb3-det-shift-bound 'K 'n 'ta)
(dk-ass!)
(qed 'ccr-3-5)

;;; -----------------------------------------------------------------------
;;; PROPOSITION 3.6, the multiplicative half: ||T S||_A = ||T||_A ||S||_A for ||T||_A = |det T|_K.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL ta (FORALL sa
  (IMPLIES (IN ta ,(cb3-mat 'n 'n)) (IMPLIES (IN sa ,(cb3-mat 'n 'n))
    (= ,(cb3-n `(DET ,cb3-v n (MATMUL ,cb3-v ta sa)))
       (* ,(cb3-n `(DET ,cb3-v n ta)) ,(cb3-n `(DET ,cb3-v n sa))))))))))))))
(dk-peel!)
(cb3-view!)
(cb3-to-v! 'ta 'n 'n) (cb3-to-v! 'sa 'n 'n)
(let ((dt `(DET ,cb3-v n ta)) (ds `(DET ,cb3-v n sa)))
  (dk-cite! 'det-multiplicative cb3-v 'n 'ta 'sa)
  (subst `(= (DET ,cb3-v n (MATMUL ,cb3-v ta sa)) ((MUL ,cb3-v) ,dt ,ds)))
  (subst `(= (MUL ,cb3-v) (MUL K)))
  (for-each (lambda (d w)
              (dk-cite! 'det-in-carrier cb3-v 'n w)
              (dk-have! `(IN ,d (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cb3-v))) (dk-ass!))))
            (list dt ds) '(ta sa))
  (dk-cite! 'nf-norm-mult 'K dt ds)
  (dk-ass!))
(qed 'ccr-3-6-multiplicative)
