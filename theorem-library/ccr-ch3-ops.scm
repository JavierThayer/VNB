(define (cb3-pow c k) `(power ,c ,k))
(sp (make-wff `(FORALL cbn (IMPLIES (IN cbn NN) (FORALL K (IMPLIES (IS-NV-FIELD K)
  (FORALL A (IMPLIES (IN A ,(cb3-mat 'cbn 'cbn)) (FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
    (IMPLIES (IS-MAT-BOUND K cbn cbn A c)
      (<= ,(cb3-n `(DET ,cb3-v cbn A)) ,(cb3-pow 'c 'cbn))))))))))))))
(let* ((bs (cb3-ni! '(K))))
  ;; n = 0: |det| = |1| = 1 = c^0
  (dk-focus! (car bs))
  (dk-peel!)
  (let* ((g (dk-goal)) (av (cadddr (cadr (cadr g)))) (cv (cadr (caddr g))))
    (dk-cite! 'nv-field-normed 'K)
    (cb3-view!)
    (dk-cite! 'det-zero cb3-v av)
    (subst `(= (DET ,cb3-v 0 ,av) (ONE ,cb3-v)))
    (subst `(= (ONE ,cb3-v) (ONE K)))
    (dk-cite! 'nf-norm-one 'K)
    (subst `(= ,(cb3-n '(ONE K)) 1))
    (dk-cite! 'rr-subset-cc cv)
    (subst (dk-cite! 'power-zero cv))
    (dk-ineq!))
  ;; n -> n + 1
  (dk-focus! (cadr bs))
  (dk-peel!)
  (let* ((g (dk-goal)) (dt (cadr (cadr g))) (nv (cadr (caddr dt))) (av (cadddr dt))
         (cv (cadr (caddr g))) (sn `(succ ,nv)) (rb (cb3-pow cv sn))
         (ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DET))) "the induction hypothesis")))
    (dk-cite! 'nv-field-normed 'K)
    (cb3-view!)
    (dk-cite! 'normed-field-ring-view-neg 'K)
    (dk-cite! 'nn-succ-closed nv)
    (dk-cite! 'nn-one-in)
    (cb3-to-v! av sn sn)
    (let* ((bnd (cb3-bound-parts! av sn sn cv))
           (eq (dk-cite! 'det-cofactor cb3-v nv av))
           (rhs (caddr eq)) (f (caddr rhs)) (sq (cadddr rhs)))
      (subst eq)
      (dk-cite! 'interval-in-set 1 sn)
      (dk-cite! 'interval-card-in-nn 1 sn)
      (dk-cite! 'power-real-closed cv sn)
      (dk-cite! 'rr-power-nonneg sn cv)
      (dk-cite! 'power-real-closed cv nv)
      (dk-cite! 'rr-power-nonneg nv cv)
      (dk-cite! 'rr-subset-cc cv)
      (cb3-and! `(IN ,cv CC) `(IN ,nv NN))
      (dk-cite! 'power-succ cv nv)
      (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
      (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
      (dk-cite! 'interval-mem-intro 1 sn 1)
      (dk-cite! 'entry-in-carrier sn sn '(CARR K) av 1 1)
      (dk-have! `(FORALL cw3z_ (IMPLIES (IN cw3z_ ,sq)
                   (AND (IN (,f cw3z_) (CARR K)) (<= ,(cb3-n `(,f cw3z_)) ,rb))))
        (lambda ()
          (dk-peel!)
          (let* ((ap (cb3-find (lambda (u) (and (pair? u) (pair? (car u)) (eq? (caar u) 'VNB-LAMBDA))) (dk-goal)))
                 (zv (cadr ap))
                 (sg (cb3-sgn `(succ ,zv))) (e `(ENTRY ,av 1 ,zv)) (mn `(MINOR ,av 1 ,zv ,nv))
                 (d `(DET ,cb3-v ,nv ,mn)) (vm `(RING-MULTIPLICATIVE-MONOID ,cb3-v)))
            (dk-lam-b!)
            (subst `(= (MUL ,cb3-v) (MUL K)))
            ;; typings
            (dk-cite! 'interval-elt-in-nn 1 sn zv)
            (dk-cite! 'nn-succ-closed zv)
            (dk-cite! 'entry-in-carrier sn sn '(CARR K) av 1 zv)
            (dk-cite! 'minor-type cb3-v av 1 zv nv)
            (cb3-to-k! mn nv nv)
            (dk-cite! 'det-in-carrier cb3-v nv mn)
            (dk-have! `(IN ,d (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cb3-v))) (dk-ass!)))
            (dk-cite! 'ring-multiplicative-monoid-is-monoid cb3-v)
            (dk-cite! 'rmm-carr cb3-v)
            (dk-cite! 'ring-one-in cb3-v)
            (dk-cite! 'ring-neg-in-carr cb3-v `(ONE ,cb3-v))
            (dk-have! `(IN ((NEG ,cb3-v) (ONE ,cb3-v)) (CARR ,vm))
              (lambda () (subst `(= (CARR ,vm) (CARR ,cb3-v))) (dk-ass!)))
            (dk-cite! 'mpow-type vm `((NEG ,cb3-v) (ONE ,cb3-v)) `(succ ,zv))
            (dk-have! `(IN ,sg (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cb3-v))) (subst `(= (CARR ,cb3-v) (CARR ,vm))) (dk-ass!)))
            (dk-cite! 'nf-mul-in-carr 'K e d)
            (dk-cite! 'nf-mul-in-carr 'K sg `((MUL K) ,e ,d))
            ;; the norms
            (dk-cite! 'nf-norm-mult 'K sg `((MUL K) ,e ,d))
            (dk-cite! 'nf-norm-mult 'K e d)
            (dk-cite! 'cb3-sign-norm 'K `(succ ,zv))
            (dk-cite! 'nf-norm-in-rr 'K e) (dk-cite! 'nf-norm-in-rr 'K d)
            (dk-cite! 'nf-norm-nonneg 'K e) (dk-cite! 'nf-norm-nonneg 'K d)
            (dk-apply! bnd 1 zv)
            (dk-cite! 'cb3-minor-bound 'K nv av cv zv)
            (dk-apply! ih mn cv)
            (dk-cite! 'rr-prod-le-gen (cb3-n e) (cb3-n d) cv (cb3-pow cv nv))
            (dk-cite! 'rr-mul-in-rr (cb3-n e) (cb3-n d))
            (dk-cite! 'rr-one-mul `(* ,(cb3-n e) ,(cb3-n d)))
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (dk-ass!)
                    (begin
                      (subst `(= ,(cb3-n `((MUL K) ,sg ((MUL K) ,e ,d))) (* ,(cb3-n sg) ,(cb3-n `((MUL K) ,e ,d)))))
                      (subst `(= ,(cb3-n `((MUL K) ,e ,d)) (* ,(cb3-n e) ,(cb3-n d))))
