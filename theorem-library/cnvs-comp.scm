;;; cnvs2-comp.scm -- COMPOSITION OF BOUNDED OPERATORS BETWEEN COMPLEX NORMED VECTOR SPACES
;;; (agent CNVS2, 2026-11-10).  All PROVEN modulo 0.  Destination: theorem-library/cnvs-comp.scm.
;;; Vocabulary: structure-library/cnvs-comp-vocab.scm (CBOP-COMP, CBOP-ID).
;;;
;;; For T : u -> v and S : v -> w bounded (u, v, w complex normed vector spaces):
;;;   cbop-comp-apply, cbop-id-apply      the values
;;;   cbop-comp-fun                       S o T maps VEC u into VEC w
;;;   cbop-comp-bounded                   S o T is bounded
;;;   cnvs-opnorm-comp-le                 ||S o T|| <= ||S|| ||T||
;;;   cbop-id-bounded, cnvs-opnorm-id-le  the identity is bounded, ||1|| <= 1
;;;   cbop-comp-assoc                     (R o S) o T = R o (S o T)
;;;   cbop-comp-id-left/-right            1 o T = T = T o 1
;;;   cbop-comp-sum-right                 (R + S) o T = R o T + S o T
;;;   cbop-comp-sum-left                  R o (S + T) = R o S + R o T  (R linear)
;;; The adjoint is not ported: it needs an inner product (BA-BH's OP-ADJOINT is Riesz).
;;; A port of ba-bh.scm parts 4-5 (bop-comp-*, opnorm-comp-le) with IP-NORM -> VNRM and
;;; the inner-product laws -> the CNVS laws; the codomain is a third space.
;;;
;;; Helper prefix: cn2c-.
;;; LOAD WINDOW: after theorem-library/cnvs-d (cbop-fun, cbop-add, cbop-act, cbop-bound-exists,
;;; cbop-intro, cnvs-opnorm-spec, cnvs-opnorm-bound / -in-rr / -nonneg, cbop-sum-apply,
;;; cbop-sum-bounded, cnvd-norm-in-rr / -nonneg) and cnvs-a (cnvs-vec-set, cnvs-cact-type-pt)
;;; and structure-library/cnvs-comp-vocab.  Library: analysis.

(define (cn2c-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cnvs2-comp: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cnvs2-comp: unfinished" name))))

(define cn2c-C3 '((IS-COMPLEX-NORMED-VECTOR-SPACE u) (IS-COMPLEX-NORMED-VECTOR-SPACE v)
                  (IS-COMPLEX-NORMED-VECTOR-SPACE w)))
(define (cn2c-bo a b) (list 'CNVS-BOUNDED-OPS a b))
(define (cn2c-n sp x) (list (list 'VNRM sp) x))
(define (cn2c-and fs) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (cn2c-and (cdr fs)))))
(define (cn2c-have-and! . fs)
  (let ((c (cn2c-and fs))) (dk-have! c (lambda () (dk-conj-close! dk-ass!))) c))
(define (cn2c-nt! sp x) (dk-cite! 'cnvd-norm-in-rr sp x) (dk-cite! 'cnvd-norm-nonneg sp x))
(define (cn2c-ft! f a b x) (dk-cite! 'fun-apply-type-c f (list 'VEC a) (list 'VEC b) x))
;;; rfl on the focus leaf only when it is literally reflexive (a subst may have closed it already,
;;; and the focus then sits on a sibling)
(define (cn2c-rfl!)
  (let ((g (dk-goal))) (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))))

;;; linear arithmetic with the products named (cnvs-d's cnvd-lin!, file-local)
(define (cn2c-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                            (not (number? (cadr t))) (not (number? (caddr t)))))
(define (cn2c-prods e)
  (cond ((cn2c-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map cn2c-prods (cdr e)))
        (#t '())))
(define (cn2c-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (cn2c-prod? (cadr p)) (cn2c-mul-type! (cadr p)))
        (if (cn2c-prod? (caddr p)) (cn2c-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
(define (cn2c-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map cn2c-prods prems) (cn2c-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p) (cn2c-mul-type! p) (cons p (dk-name! p))) ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))

;;; ==========================================================================================
;;; VALUES AND TYPING
;;; ==========================================================================================
(sp (make-wff (forall-guarded '(u v w s_ t_ x_)
   '((IN t_ (FUN (VEC u) (VEC v))) (IN s_ (FUN (VEC v) (VEC w))) (IN x_ (VEC u)))
   '(= ((CBOP-COMP u s_ t_) x_) (s_ (t_ x_))))))
(dk-peel!)
(cn2c-ft! 't_ 'u 'v 'x_)
(cn2c-ft! 's_ 'v 'w '(t_ x_))
(mac 'CBOP-COMP)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(cn2c-qed! 'cbop-comp-apply)

(sp (make-wff (forall-guarded '(u x_) '((IN x_ (VEC u))) '(= ((CBOP-ID u) x_) x_))))
(dk-peel!)
(mac 'CBOP-ID)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(cn2c-qed! 'cbop-id-apply)

(sp (make-wff (forall-guarded '(u v w s_ t_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE u) (IN t_ (FUN (VEC u) (VEC v))) (IN s_ (FUN (VEC v) (VEC w))))
   '(IN (CBOP-COMP u s_ t_) (FUN (VEC u) (VEC w))))))
(dk-peel!)
(dk-cite! 'cnvs-vec-set 'u)
(mac 'CBOP-COMP)
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (cadr (dk-goal))))))       ; goal (IN (s_ (t_ x)) (VEC w))
      (cn2c-ft! 't_ 'u 'v x)
      (cn2c-ft! 's_ 'v 'w (list 't_ x))
      (ass))))
(cn2c-qed! 'cbop-comp-fun)

(sp (make-wff (forall-guarded '(u) '((IS-COMPLEX-NORMED-VECTOR-SPACE u)) '(IN (CBOP-ID u) (FUN (VEC u) (VEC u))))))
(dk-peel!)
(dk-cite! 'cnvs-vec-set 'u)
(mac 'CBOP-ID)
(dk-lam-type! (lambda () (dk-peel!) (ass)))
(cn2c-qed! 'cbop-id-fun)

;;; ==========================================================================================
;;; S o T IS BOUNDED, AND ||S o T|| <= ||S|| ||T||
;;; ==========================================================================================
(define cn2c-C '(CBOP-COMP u s_ t_))
(define (cn2c-capp! x)                   ; rewrite (C x) to s(t x) in the goal, x in VEC u
  (cn2c-ft! 't_ 'u 'v x)
  (cn2c-ft! 's_ 'v 'w (list 't_ x))
  (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 's_ 't_ x)))
(define cn2c-hyps (append cn2c-C3 (list (list 'IN 't_ (cn2c-bo 'u 'v)) (list 'IN 's_ (cn2c-bo 'v 'w)))))

;;; with bounds l1 (for s, factor m1) and l2 (for t, factor m2) in context, prove
;;;   forall x in VEC u. ||C x|| <= (m1 m2) ||x||
(define (cn2c-comp-bound! m1 m2 l1 l2)
  (let ((mm (list '* m1 m2)))
    (dk-cite! 'rr-mul-in-rr m1 m2)
    (cn2c-have-and! (list 'IN m1 'RR) (list 'IN m2 'RR))
    (cn2c-have-and! (list '<= 0 m1) (list '<= 0 m2))
    (dk-cite! 'rr-leq-mul-nonneg m1 m2)
    (let ((claim (list 'FORALL 'cbx_ (list 'IMPLIES '(IN cbx_ (VEC u))
                   (list '<= (cn2c-n 'w (list cn2c-C 'cbx_)) (list '* mm (cn2c-n 'u 'cbx_)))))))
      (dk-have! claim
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (caddr (caddr (dk-goal)))))
                 (tx (list 't_ x)) (stx (list 's_ tx))
                 (nx (cn2c-n 'u x)) (ntx (cn2c-n 'v tx)) (nstx (cn2c-n 'w stx)))
            (cn2c-capp! x)
            (cn2c-nt! 'u x) (cn2c-nt! 'v tx) (cn2c-nt! 'w stx)
            (dk-apply! l1 tx)
            (dk-apply! l2 x)
            (dk-cite! 'rr-mul-in-rr m2 nx)
            (dk-cite! 'rr-mul-le-right ntx (list '* m2 nx) m1)
            (dk-have! (list '= (list '* m1 ntx) (list '* ntx m1)) (lambda () (crs)))
            (dk-have! (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)) (lambda () (crs)))
            (cn2c-lin! (list (list 'IN nstx 'RR) (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR))
                       (list (list '<= nstx (list '* m1 ntx))
                             (list '<= (list '* ntx m1) (list '* (list '* m2 nx) m1))
                             (list '= (list '* m1 ntx) (list '* ntx m1))
                             (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)))))))
      claim)))

(sp (make-wff (forall-guarded '(u v w s_ t_) cn2c-hyps (list 'IN cn2c-C (cn2c-bo 'u 'w)))))
(dk-peel!)
(dk-cite! 'cbop-fun 'u 'v 't_)
(dk-cite! 'cbop-fun 'v 'w 's_)
(dk-have! (list 'IS-CNVS-LINEAR-OP 'u 'w cn2c-C)
  (lambda ()
    (mac 'IS-CNVS-LINEAR-OP)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
           ((dk-head-is? g 'IN) (dk-cite! 'cbop-comp-fun 'u 'v 'w 's_ 't_) (ass))
           ((dk-contains? g '(VADD u))
            (dk-peel!)
            (let* ((sm (cadr (cadr (dk-goal)))) (x (cadr sm)) (y (caddr sm)))
              (dk-cite! 'nvs-vadd-in-vec-cnvs-as-nvs 'u x y)
              (cn2c-capp! sm) (cn2c-capp! x) (cn2c-capp! y)
              (cn2c-ft! 't_ 'u 'v x) (cn2c-ft! 't_ 'u 'v y)
              (subst (dk-cite! 'cbop-add 'u 'v 't_ x y))
              (subst (dk-cite! 'cbop-add 'v 'w 's_ (list 't_ x) (list 't_ y)))
              (cn2c-rfl!)))
           (#t
            (dk-peel!)
            (let* ((sm (cadr (cadr (dk-goal)))) (c (cadr sm)) (x (caddr sm)))
              (dk-cite! 'cnvs-cact-type-pt 'u c x)
              (cn2c-capp! sm) (cn2c-capp! x)
              (cn2c-ft! 't_ 'u 'v x)
              (subst (dk-cite! 'cbop-act 'u 'v 't_ c x))
              (subst (dk-cite! 'cbop-act 'v 'w 's_ c (list 't_ x)))
              (cn2c-rfl!)))))))))
(let* ((m1 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 's_)))
       (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of s"))
       (m2 (dk-skolem! (dk-cite! 'cbop-bound-exists 'u 'v 't_)))
       (l2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m2))) "bound of t")))
  (cn2c-comp-bound! m1 m2 l1 l2)
  (dk-cite! 'cbop-intro 'u 'w cn2c-C (list '* m1 m2))
  (ass))
(cn2c-qed! 'cbop-comp-bounded)

(define (cn2c-opn a b t) (list 'CNVS-OPNORM a b t))
(sp (make-wff (forall-guarded '(u v w s_ t_) cn2c-hyps
   (list '<= (cn2c-opn 'u 'w cn2c-C) (list '* (cn2c-opn 'v 'w 's_) (cn2c-opn 'u 'v 't_))))))
(dk-peel!)
(dk-cite! 'cbop-fun 'u 'v 't_)
(dk-cite! 'cbop-fun 'v 'w 's_)
(dk-cite! 'cbop-comp-bounded 'u 'v 'w 's_ 't_)
(let* ((m1 (cn2c-opn 'v 'w 's_)) (m2 (cn2c-opn 'u 'v 't_))
       (l1 (dk-cite! 'cnvs-opnorm-bound 'v 'w 's_))
       (l2 (dk-cite! 'cnvs-opnorm-bound 'u 'v 't_)))
  (dk-cite! 'cnvs-opnorm-in-rr 'v 'w 's_) (dk-cite! 'cnvs-opnorm-nonneg 'v 'w 's_)
  (dk-cite! 'cnvs-opnorm-in-rr 'u 'v 't_) (dk-cite! 'cnvs-opnorm-nonneg 'u 'v 't_)
  (cn2c-comp-bound! m1 m2 l1 l2)
  (dk-split-all! (list (dk-cite! 'cnvs-opnorm-spec 'u 'w cn2c-C)))
  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h cn2c-C)))
                      "the least-bound clause")
             (list '* m1 m2))
  (ass))
(cn2c-qed! 'cnvs-opnorm-comp-le)

;;; the identity
(sp (make-wff (forall-guarded '(u) '((IS-COMPLEX-NORMED-VECTOR-SPACE u)) (list 'IN '(CBOP-ID u) (cn2c-bo 'u 'u)))))
(dk-peel!)
(dk-cite! 'cbop-id-fun 'u)
(dk-have! '(IS-CNVS-LINEAR-OP u u (CBOP-ID u))
  (lambda ()
    (mac 'IS-CNVS-LINEAR-OP)
    (dk-conj-close!
     (lambda ()
       (if (dk-asm? (dk-goal))
           (ass)
           (begin
             (dk-peel!)
             (let* ((sm (cadr (cadr (dk-goal)))))
               (if (dk-contains? (dk-goal) '(VADD u))
                   (dk-cite! 'nvs-vadd-in-vec-cnvs-as-nvs 'u (cadr sm) (caddr sm))
                   (dk-cite! 'cnvs-cact-type-pt 'u (cadr sm) (caddr sm)))
               (subst (dk-cite! 'cbop-id-apply 'u sm))
               (subst (dk-cite! 'cbop-id-apply 'u (caddr sm)))
               (if (dk-contains? (dk-goal) '(CBOP-ID u)) (subst (dk-cite! 'cbop-id-apply 'u (cadr sm))))
               (cn2c-rfl!))))))))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 1) (lambda () (arith)))
(dk-have! '(FORALL cbx_ (IMPLIES (IN cbx_ (VEC u)) (<= ((VNRM u) ((CBOP-ID u) cbx_)) (* 1 ((VNRM u) cbx_)))))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (caddr (caddr (dk-goal))))))
      (subst (dk-cite! 'cbop-id-apply 'u x))
      (cn2c-nt! 'u x)
      (dk-ineq! (list 'IN (cn2c-n 'u x) 'RR)))))
(dk-cite! 'cbop-intro 'u 'u '(CBOP-ID u) 1)
(ass)
(cn2c-qed! 'cbop-id-bounded)

;;; ==========================================================================================
;;; THE ALGEBRA OF COMPOSITION (function extensionality on VEC u)
;;; ==========================================================================================
;;; (R o S) o T = R o (S o T),  T : u -> v,  S : v -> w,  R : w -> z
(sp (make-wff (forall-guarded '(u v w z r_ s_ t_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE u) (IS-COMPLEX-NORMED-VECTOR-SPACE v)
     (IN t_ (FUN (VEC u) (VEC v))) (IN s_ (FUN (VEC v) (VEC w))) (IN r_ (FUN (VEC w) (VEC z))))
   '(= (CBOP-COMP u (CBOP-COMP v r_ s_) t_) (CBOP-COMP u r_ (CBOP-COMP u s_ t_))))))
(dk-peel!)
(dk-cite! 'cbop-comp-fun 'v 'w 'z 'r_ 's_)
(dk-cite! 'cbop-comp-fun 'u 'v 'w 's_ 't_)
(dk-fun-ext! '(CBOP-COMP u (CBOP-COMP v r_ s_) t_) '(CBOP-COMP u r_ (CBOP-COMP u s_ t_)) '(VEC u) '(VEC z)
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'v 'z '(CBOP-COMP v r_ s_) 't_) (ass))
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'w 'z 'r_ '(CBOP-COMP u s_ t_)) (ass))
  (lambda (x)
    (let* ((tx (list 't_ x)) (stx (list 's_ tx)))
      (cn2c-ft! 't_ 'u 'v x) (cn2c-ft! 's_ 'v 'w tx) (cn2c-ft! 'r_ 'w 'z stx)
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'z '(CBOP-COMP v r_ s_) 't_ x))
      (subst (dk-cite! 'cbop-comp-apply 'v 'w 'z 'r_ 's_ tx))
      (subst (dk-cite! 'cbop-comp-apply 'u 'w 'z 'r_ '(CBOP-COMP u s_ t_) x))
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 's_ 't_ x))
      (cn2c-rfl!))))
(if (not (proof-done? *ps*)) (ass))
(cn2c-qed! 'cbop-comp-assoc)

;;; 1 o T = T and T o 1 = T,  T : u -> v
(sp (make-wff (forall-guarded '(u v t_) '((IS-COMPLEX-NORMED-VECTOR-SPACE u) (IS-COMPLEX-NORMED-VECTOR-SPACE v)
                                          (IN t_ (FUN (VEC u) (VEC v))))
   '(= (CBOP-COMP u (CBOP-ID v) t_) t_))))
(dk-peel!)
(dk-cite! 'cbop-id-fun 'v)
(dk-fun-ext! '(CBOP-COMP u (CBOP-ID v) t_) 't_ '(VEC u) '(VEC v)
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'v 'v '(CBOP-ID v) 't_) (ass))
  #f
  (lambda (x)
    (cn2c-ft! 't_ 'u 'v x)
    (subst (dk-cite! 'cbop-comp-apply 'u 'v 'v '(CBOP-ID v) 't_ x))
    (subst (dk-cite! 'cbop-id-apply 'v (list 't_ x)))
    (cn2c-rfl!)))
(if (not (proof-done? *ps*)) (ass))
(cn2c-qed! 'cbop-comp-id-left)

(sp (make-wff (forall-guarded '(u v t_) '((IS-COMPLEX-NORMED-VECTOR-SPACE u) (IN t_ (FUN (VEC u) (VEC v))))
   '(= (CBOP-COMP u t_ (CBOP-ID u)) t_))))
(dk-peel!)
(dk-cite! 'cbop-id-fun 'u)
(dk-fun-ext! '(CBOP-COMP u t_ (CBOP-ID u)) 't_ '(VEC u) '(VEC v)
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'u 'v 't_ '(CBOP-ID u)) (ass))
  #f
  (lambda (x)
    (cn2c-ft! '(CBOP-ID u) 'u 'u x)
    (subst (dk-cite! 'cbop-comp-apply 'u 'u 'v 't_ '(CBOP-ID u) x))
    (subst (dk-cite! 'cbop-id-apply 'u x))
    (cn2c-ft! 't_ 'u 'v x)
    (cn2c-rfl!)))
(if (not (proof-done? *ps*)) (ass))
(cn2c-qed! 'cbop-comp-id-right)

;;; (R + S) o T = R o T + S o T,  T : u -> v,  R, S : v -> w bounded
(define cn2c-RS '(CBOP-SUM v w r_ s_))
(sp (make-wff (forall-guarded '(u v w r_ s_ t_)
   (append cn2c-C3 (list (list 'IN 't_ (cn2c-bo 'u 'v)) (list 'IN 'r_ (cn2c-bo 'v 'w)) (list 'IN 's_ (cn2c-bo 'v 'w))))
   (list '= (list 'CBOP-COMP 'u cn2c-RS 't_)
            '(CBOP-SUM u w (CBOP-COMP u r_ t_) (CBOP-COMP u s_ t_))))))
(dk-peel!)
(for-each (lambda (f a b) (dk-cite! 'cbop-fun a b f)) '(t_ r_ s_) '(u v v) '(v w w))
(dk-cite! 'cbop-sum-bounded 'v 'w 'r_ 's_)
(dk-cite! 'cbop-fun 'v 'w cn2c-RS)
(dk-cite! 'cbop-comp-bounded 'u 'v 'w 'r_ 't_)
(dk-cite! 'cbop-comp-bounded 'u 'v 'w 's_ 't_)
(dk-cite! 'cbop-sum-bounded 'u 'w '(CBOP-COMP u r_ t_) '(CBOP-COMP u s_ t_))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-SUM u w (CBOP-COMP u r_ t_) (CBOP-COMP u s_ t_)))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-COMP u r_ t_))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-COMP u s_ t_))
(dk-fun-ext! (list 'CBOP-COMP 'u cn2c-RS 't_) '(CBOP-SUM u w (CBOP-COMP u r_ t_) (CBOP-COMP u s_ t_)) '(VEC u) '(VEC w)
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'v 'w cn2c-RS 't_) (ass))
  #f
  (lambda (x)
    (let ((tx (list 't_ x)))
      (cn2c-ft! 't_ 'u 'v x) (cn2c-ft! 'r_ 'v 'w tx) (cn2c-ft! 's_ 'v 'w tx)
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w cn2c-RS 't_ x))
      (subst (dk-cite! 'cbop-sum-apply 'v 'w 'r_ 's_ tx))
      (subst (dk-cite! 'cbop-sum-apply 'u 'w '(CBOP-COMP u r_ t_) '(CBOP-COMP u s_ t_) x))
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 'r_ 't_ x))
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 's_ 't_ x))
      (cn2c-rfl!))))
(if (not (proof-done? *ps*)) (ass))
(cn2c-qed! 'cbop-comp-sum-right)

;;; R o (S + T) = R o S + R o T,  S, T : u -> v bounded,  R : v -> w bounded
(define cn2c-ST '(CBOP-SUM u v s_ t_))
(sp (make-wff (forall-guarded '(u v w r_ s_ t_)
   (append cn2c-C3 (list (list 'IN 'r_ (cn2c-bo 'v 'w)) (list 'IN 's_ (cn2c-bo 'u 'v)) (list 'IN 't_ (cn2c-bo 'u 'v))))
   (list '= (list 'CBOP-COMP 'u 'r_ cn2c-ST)
            '(CBOP-SUM u w (CBOP-COMP u r_ s_) (CBOP-COMP u r_ t_))))))
(dk-peel!)
(for-each (lambda (f a b) (dk-cite! 'cbop-fun a b f)) '(r_ s_ t_) '(v u u) '(w v v))
(dk-cite! 'cbop-sum-bounded 'u 'v 's_ 't_)
(dk-cite! 'cbop-fun 'u 'v cn2c-ST)
(dk-cite! 'cbop-comp-bounded 'u 'v 'w 'r_ 's_)
(dk-cite! 'cbop-comp-bounded 'u 'v 'w 'r_ 't_)
(dk-cite! 'cbop-sum-bounded 'u 'w '(CBOP-COMP u r_ s_) '(CBOP-COMP u r_ t_))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-SUM u w (CBOP-COMP u r_ s_) (CBOP-COMP u r_ t_)))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-COMP u r_ s_))
(dk-cite! 'cbop-fun 'u 'w '(CBOP-COMP u r_ t_))
(dk-fun-ext! (list 'CBOP-COMP 'u 'r_ cn2c-ST) '(CBOP-SUM u w (CBOP-COMP u r_ s_) (CBOP-COMP u r_ t_)) '(VEC u) '(VEC w)
  (lambda () (dk-cite! 'cbop-comp-fun 'u 'v 'w 'r_ cn2c-ST) (ass))
  #f
  (lambda (x)
    (let ((sx (list 's_ x)) (tx (list 't_ x)))
      (cn2c-ft! 's_ 'u 'v x) (cn2c-ft! 't_ 'u 'v x)
      (cn2c-ft! 'r_ 'v 'w sx) (cn2c-ft! 'r_ 'v 'w tx)
      (cn2c-ft! cn2c-ST 'u 'v x)
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 'r_ cn2c-ST x))
      (subst (dk-cite! 'cbop-sum-apply 'u 'v 's_ 't_ x))
      (subst (dk-cite! 'cbop-add 'v 'w 'r_ sx tx))
      (subst (dk-cite! 'cbop-sum-apply 'u 'w '(CBOP-COMP u r_ s_) '(CBOP-COMP u r_ t_) x))
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 'r_ 's_ x))
      (subst (dk-cite! 'cbop-comp-apply 'u 'v 'w 'r_ 't_ x))
      (cn2c-rfl!))))
(if (not (proof-done? *ps*)) (ass))
(cn2c-qed! 'cbop-comp-sum-left)
