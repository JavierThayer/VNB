;;; two points of {0, 1} at distance < 1 are equal
(sp (make-wff '(FORALL u_ (IMPLIES (IN u_ RM-TWO) (FORALL v_ (IMPLIES (IN v_ RM-TWO)
     (IMPLIES (< ((DIST RM-TWO-MS) u_ v_) 1) (= u_ v_))))))))
(dk-peel!)
(dk-cite! 'rmm-two-ms-dist 'u_ 'v_)
(define rmm-h (dk-rewrite-h! '(< ((DIST RM-TWO-MS) u_ v_) 1) '((DIST RM-TWO-MS) u_ v_) '(abs (- u_ v_))))
(rmm-two-split! 'u_ (lambda (a)
  (rmm-two-split! 'v_ (lambda (b)
    (if (= a b)
        (begin (subst (list '= 'u_ a)) (subst (list '= 'v_ b)) (rfl))
        (let* ((h1 (dk-rewrite-h! rmm-h 'u_ a))
               (h2 (dk-rewrite-h! h1 'v_ b)))
          (pbc)
          (let ((ab (list 'abs (list '- a b))))
            (dk-have! (list '= ab 1) (lambda () (arith)))
            (dk-absurd! (dk-rewrite-h! h2 ab 1)))))))))
(qed 'rmm-two-near-eq)

