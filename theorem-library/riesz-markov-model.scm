(define rmm-if '(IF (IN x (RM-BALL s dseq n)) 1 0))
(use-em '(IN x (RM-BALL s dseq n))
  (lambda ()
    (rmm-if! #t rmm-if)
    (subst (list '= rmm-if 1))
    (dk-have! '(= 1 1) (lambda () (arith)))
    (rmm-prop! '(= 1 1) '(IN x (RM-BALL s dseq n))))
  (lambda ()
    (rmm-if! #f rmm-if)
    (subst (list '= rmm-if 0))
    (dk-have! '(NOT (= 0 1)) (lambda () (arith)))
    (rmm-prop! '(NOT (= 0 1)) '(NOT (IN x (RM-BALL s dseq n))))))
(qed 'rmm-code-value)

(sp (make-wff '(FORALL s (FORALL dseq (FORALL x (IN (RM-CODE s dseq x) (FUN NN RM-TWO)))))))
