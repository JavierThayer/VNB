        (lambda () (rmm-if! #f t) (subst (list '= t 0))
                   (rmm-prop! '(IFF (IN 0 RM-TWO) (OR (= 0 0) (= 0 1))) '(= 0 0)))))))
(qed 'rmm-code-two)

