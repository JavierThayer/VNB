  (FORALL nb (IN es_ (RM-CYL s dseq es_ nb)))))))))
(dk-peel!)
(define rmm-cm (dk-cite! 'rmm-cyl-mem 's 'dseq 'es_ 'nb 'es_))
(dk-have! (rmm-agree-form 'es_ 'es_ 'nb)
  (lambda ()
    (let ((i (dk-di-var!)))
      (di)
      (fact 'rmm-cantor-metric)
      (dk-cite! 'rmm-k-sub 's 'dseq)
      (dk-cite! 'subset-mem-fwd rmm-K '(PTS CANTOR-MS) 'es_)
      (rmm-coord-typ! 'es_ i)
      (rfl))))
(rmm-prop! rmm-cm '(IN es_ (RM-K s dseq)) (rmm-agree-form 'es_ 'es_ 'nb))
(qed 'rmm-cyl-self)

;;; a compact metric space with a point has a dense sequence (the input the
;;; construction takes)
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IMPLIES (FORSOME x (IN x (PTS s)))
  (FORSOME dseq (IS-DENSE-SEQ s dseq)))))))
(dk-peel!)
(define rmm-sep (dk-cite! 'compact-metric-is-separable 's))
(define rmm-si (dk-cite! 'is-separable 's))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmm-prop! rmm-si '(IS-SEPARABLE s))))
(define rmm-ex (list 'FORSOME 'dseq (list 'AND '(IN dseq (FUN NN (PTS s)))
                 '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL eps (IMPLIES (POS-RR eps)
                    (FORSOME n (AND (IN n NN) (< ((DIST s) x (dseq n)) eps))))))))))
(dk-have! rmm-ex (lambda () (rmm-prop! rmm-si '(IS-SEPARABLE s))))
(define rmm-dq (dk-skolem! (dk-ctx-form rmm-ex)))
(ew rmm-dq)
(mac 'is-dense-seq)
(dk-conj-close! (lambda () (ass)))
(qed 'rmm-dense-seq-exists)
