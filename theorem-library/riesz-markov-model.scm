;;; SHRINKING: the points with the address of es below nb come within eps of
;;; pi(es) once nb is large.  By contradiction: far points y_nb with partial
;;; addresses; a convergent subsequence; its limit has the full address, so
;;; it is pi(es); but every term stays eps away from pi(es).
(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-COMPACT s) (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL es_ (IMPLIES (IN es_ (RM-K s dseq))
    (FORALL eps (IMPLIES (POS-RR eps)
      (FORSOME rhn_ (AND (IN rhn_ NN)
        (FORALL rhy_ (IMPLIES (RM-ADDRESS-BELOW s dseq es_ rhn_ rhy_)
          (<= ((DIST s) ((RM-PI s dseq) es_) rhy_) eps)))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(define rmm-p0 '((RM-PI s dseq) es_))
(dk-cite! 'rmm-pi-fun 's 'dseq)
(dk-cite! 'fun-apply-type-c '(RM-PI s dseq) rmm-K '(PTS s) 'es_)
(rmm-pos! 'eps)
(define rmm-notex (dk-landed-1 (lambda () (pbc))))
(define rmm-nall (dk-landed-1 (lambda () (push-not-h rmm-notex))))
(define (rmm-far k w)
  (list 'AND (list 'RM-ADDRESS-BELOW 's 'dseq 'es_ k w)
             (list 'NOT (list '<= (rmm-d 's rmm-p0 w) 'eps))))
(define rmm-g
  (rmm-choose-seq! '(PTS s) rmm-far
    (lambda (k)
      (let* ((nf (dk-apply! rmm-nall k))
             (ex (dk-landed-1 (lambda () (push-not-h nf))))
             (y  (dk-skolem! ex)))
        (dk-have! (rmm-far k y) (lambda () (dk-conj-close! (lambda () (ass)))))
        (dk-split-all! (dk-landed (lambda () (mac-h 'rm-address-below (list 'RM-ADDRESS-BELOW 's 'dseq 'es_ k y)))))
        y))))
(dk-cite! 'compact-implies-seq-compact 's)
(dk-split-all! (dk-landed (lambda () (mac-h 'seq-compact '(SEQ-COMPACT s)))))
(define rmm-phi (dk-skolem! (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'f))) "seq-compact clause") rmm-g)))
(define rmm-L (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'l))) "the limit")))
(define rmm-sq (list 'SUBSEQ rmm-g rmm-phi))
(define rmm-smi (dk-cite! 'strictly-mono-nn rmm-phi))
(dk-have! (list 'IN rmm-phi '(FUN NN NN)) (lambda () (rmm-prop! rmm-smi (list 'STRICTLY-MONO-NN rmm-phi))))

;;; the tail of the subsequence lies in the closed cell C (B_n or SHELL_n)
(define (rmm-limit-below! n C)
  (let ((tail (list 'FORALL 'tk_ (list 'IMPLIES '(IN tk_ NN)
                (list 'IMPLIES (list '<= (list 'succ n) 'tk_) (list 'IN (list rmm-sq 'tk_) C))))))
    (dk-cite! 'nn-succ-closed n)
    (dk-have! tail
      (lambda ()
        (let ((k (dk-di-var!)))
          (di)
          (let* ((pk (list rmm-phi k))
                 (w  (list rmm-g pk)))
            (dk-cite! 'subseq-apply rmm-g rmm-phi k)
            (subst (list '== (list rmm-sq k) w))
            (dk-cite! 'fun-apply-type-c rmm-phi 'NN 'NN k)
            (dk-cite! 'strictly-mono-ge-id rmm-phi k)
            (dk-have! (list '< n pk) (lambda () (dk-nn! (list '<= (list 'succ n) k) (list '<= k pk))))
            (rmm-seq-at! rmm-g pk)
            (dk-split-all! (dk-landed (lambda () (mac-h 'rm-address-below (list 'RM-ADDRESS-BELOW 's 'dseq 'es_ pk w)))))
            (dk-split-all! (list (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rbn_))) "below clause") n)))
            (prop)))))
    (dk-cite! 'closed-set-limit-in-tail 's C rmm-sq rmm-L (list 'succ n))
    (ass)))

(dk-have! (list 'RM-ADDRESS 's 'dseq 'es_ rmm-L)
  (lambda ()
    (mac 'rm-address)
    (rmm-and-focus! 'FORALL)
    (let* ((n (dk-di-var!)))
      (dk-cite! 'rmm-ball-closed 's 'dseq n)
      (dk-cite! 'rmm-shell-closed 's 'dseq n)
      (for-each
        (lambda (l)
          (dk-focus! l)
          (di)
          (rmm-limit-below! n (caddr (dk-goal))))
        (rmm-split-goal!)))))
(dk-cite! 'rmm-pi-value 's 'dseq 'es_ rmm-L)
;; the contradiction at the first index N where the subsequence is eps-close
(define rmm-cv (dk-cite! 'converges-to 's rmm-sq rmm-L))
(define rmm-ec (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
                 (list 'FORSOME 'n (list 'AND '(IN n NN)
                   (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                     (list 'IMPLIES '(<= n n_) (list '<= (rmm-d 's (list rmm-sq 'n_) rmm-L) 'eps)))))))))
(dk-have! rmm-ec (lambda () (rmm-prop! rmm-cv (list 'CONVERGES-TO 's rmm-sq rmm-L))))
(define rmm-nidx (dk-skolem! (dk-apply! (dk-ctx-form rmm-ec) 'eps)))
(dk-have! (list '<= rmm-nidx rmm-nidx) (lambda () (dk-nn!)))
(define rmm-cl (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'n_))) "the tail bound") rmm-nidx))
(define rmm-pN (list rmm-phi rmm-nidx))
(dk-cite! 'fun-apply-type-c rmm-phi 'NN 'NN rmm-nidx)
(dk-cite! 'subseq-apply rmm-g rmm-phi rmm-nidx)
(define rmm-cl2 (dk-rewrite-h! rmm-cl (list rmm-sq rmm-nidx) (list rmm-g rmm-pN)))
(rmm-seq-at! rmm-g rmm-pN)
(dk-cite! 'fun-apply-type-c rmm-g 'NN '(PTS s) rmm-pN)
(define rmm-sy (rmm-sym! 's (list rmm-g rmm-pN) rmm-L))
(define rmm-cl3 (dk-rewrite-h! rmm-cl2 (rmm-d 's (list rmm-g rmm-pN) rmm-L) (rmm-d 's rmm-L (list rmm-g rmm-pN))))
(define rmm-cl4 (dk-rewrite-h! rmm-cl3 rmm-L rmm-p0))
(rmm-prop! rmm-cl4 (list 'NOT (list '<= (rmm-d 's rmm-p0 (list rmm-g rmm-pN)) 'eps)))
(qed 'rmm-shrink)

(sp (make-wff '(FORALL s (FORALL dseq (FORALL u_ (IMPLIES (IN u_ (RM-K s dseq)) (FORALL v_ (IMPLIES (IN v_ (RM-K s dseq))
