                 (list 'IN z rmm-sh)))))
(rmm-and-focus! 'IS-OPEN)
(mac 'is-open)
(dk-cite! 'complement-in-subset rmm-sh '(PTS s))
(rmm-and-focus! 'FORALL)
(define rmm-y (dk-di-var!))
(define rmm-cmy (dk-cite! 'complement-in-membership '(PTS s) rmm-sh rmm-y))
(dk-have! (list 'IN rmm-y '(PTS s)) (lambda () (rmm-prop! rmm-cmy (list 'IN rmm-y rmm-co))))
(dk-have! (list 'NOT (list 'IN rmm-y rmm-sh)) (lambda () (rmm-prop! rmm-cmy (list 'IN rmm-y rmm-co))))
(define rmm-smy (dk-cite! 'rmm-shell-mem 's 'dseq 'n rmm-y))
(define rmm-dcy (rmm-d 's rmm-c rmm-y))
(rmm-dreal! 's rmm-c rmm-y)
(dk-have! (list 'NOT (list '<= rmm-rr rmm-dcy))
  (lambda () (di) (rmm-prop! rmm-smy (list 'IN rmm-y '(PTS s)) (list 'NOT (list 'IN rmm-y rmm-sh)) (list '<= rmm-rr rmm-dcy))))
(dk-cite! 'rr-not-le-lt rmm-rr rmm-dcy)
(dk-cite! 'rr-sub-in-rr rmm-rr rmm-dcy)
(dk-have! (list '< 0 (list '- rmm-rr rmm-dcy)) (lambda () (dk-ineq! (list '< rmm-dcy rmm-rr))))
(dk-cite! 'rr-pos-rr-of-lt (list '- rmm-rr rmm-dcy))
(define rmm-h (dk-halve! (list '- rmm-rr rmm-dcy)))
(dk-cite! 'rr-pos-rr-of-lt rmm-h)
(ew rmm-h)
(rmm-and-focus! 'SUBSET)
(mac 'subset-def)
(define rmm-z (dk-di-var!))
(define rmm-bm (dk-cite! 'ball-membership 's rmm-y rmm-h rmm-z))
(dk-have! (list 'IN rmm-z '(PTS s)) (lambda () (rmm-prop! rmm-bm (list 'IN rmm-z (list 'BALL 's rmm-y rmm-h)))))
(dk-have! (list '<= (rmm-d 's rmm-y rmm-z) rmm-h) (lambda () (rmm-prop! rmm-bm (list 'IN rmm-z (list 'BALL 's rmm-y rmm-h)))))
(define rmm-cmz (dk-cite! 'complement-in-membership '(PTS s) rmm-sh rmm-z))
(dk-have! (list 'NOT (list 'IN rmm-z rmm-sh))
  (lambda ()
    (di)
    (let ((smz (dk-cite! 'rmm-shell-mem 's 'dseq 'n rmm-z)))
      (dk-have! (list '<= rmm-rr (rmm-d 's rmm-c rmm-z)) (lambda () (rmm-prop! smz (list 'IN rmm-z rmm-sh))))
      (rmm-dreal! 's rmm-c rmm-z) (rmm-dreal! 's rmm-y rmm-z)
      (let ((t (rmm-tri! 's rmm-c rmm-y rmm-z)))
        (dk-absurd! t (list '<= rmm-rr (rmm-d 's rmm-c rmm-z)) (list '<= (rmm-d 's rmm-y rmm-z) rmm-h)
                    (list '= (list '+ rmm-h rmm-h) (list '- rmm-rr rmm-dcy)) (list '< 0 rmm-h))))))
(rmm-prop! rmm-cmz (list 'IN rmm-z '(PTS s)) (list 'NOT (list 'IN rmm-z rmm-sh)))
(qed 'rmm-shell-closed)

;;; (rmm-choose-seq! A PF WITNESS-OF): with PF = (lambda (k w) <formula>) and
;;; WITNESS-OF = (lambda (k) ...) which, run on a leaf where k in NN is in
;;; context, lands (IN w A) and (PF k w) and returns w: cite rmm-nn-choice
;;; and return the chosen sequence g, with (IN g (FUN NN A)) and the clause
;;; forall k in NN. g(k) in L(k) landed.  (rmm-seq-at! g k) then lands PF(k, g(k)).
(define rmm-seq-family '())
(define (rmm-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'cfk_ 'NN (list 'SEP 'cfw_ A (Pf 'cfk_ 'cfw_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! rmm-seq-family (cons (cons g L) rmm-seq-family))
      g)))
(define (rmm-seq-at! g k)
  (let* ((L  (cdr (assq g rmm-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (dk-apply! (or cl (error "rmm-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

;;; a realizer is a point of s; the balls are closed
(sp (make-wff '(FORALL s (FORALL dseq (FORALL es_ (FORALL nb (FORALL y
  (IMPLIES (RM-REALIZES s dseq es_ nb y) (IN y (PTS s))))))))))
(dk-peel!)
(dk-split-all! (dk-landed (lambda () (mac-h 'rm-realizes '(RM-REALIZES s dseq es_ nb y)))))
(ass)
(qed 'rmm-realizes-pts)

(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL n (IMPLIES (IN n NN) (IS-CLOSED s (RM-BALL s dseq n)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(dk-cite! 'rmm-centre-in 's 'dseq 'n)
(dk-cite! 'rmm-rad-pos 'n)
(rmm-pos! (rmm-rn 'n))
(mac 'RM-BALL)
(dk-cite! 'closed-ball-is-closed 's (rmm-cn 's 'dseq 'n) (rmm-rn 'n))
(ass)
(qed 'rmm-ball-closed)

;;; EXISTENCE: a point of K has an address.  Choose y_N realizing es below N;
;;; a subsequence converges (s is compact); the limit lies in every closed
;;; cell B_n / SHELL_n, because the tail of the subsequence does.
(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-COMPACT s) (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL es_ (IMPLIES (IN es_ (RM-K s dseq)) (FORSOME y (RM-ADDRESS s dseq es_ y))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(define rmm-km (dk-cite! 'rmm-k-mem 's 'dseq 'es_))
(define rmm-all (list 'FORALL 'rkn_ (list 'IMPLIES '(IN rkn_ NN) (list 'FORSOME 'rky_ (rmm-real 'es_ 'rkn_ 'rky_)))))
(dk-have! rmm-all (lambda () (rmm-prop! rmm-km '(IN es_ (RM-K s dseq)))))
(dk-have! '(IN es_ (PTS CANTOR-MS)) (lambda () (rmm-prop! rmm-km '(IN es_ (RM-K s dseq)))))
(define rmm-g
  (rmm-choose-seq! '(PTS s) (lambda (k w) (rmm-real 'es_ k w))
    (lambda (k)
      (let ((y (dk-skolem! (dk-apply! (dk-ctx-form rmm-all) k))))
        (dk-cite! 'rmm-realizes-pts 's 'dseq 'es_ k y)
        y))))
(dk-cite! 'compact-implies-seq-compact 's)
(dk-split-all! (dk-landed (lambda () (mac-h 'seq-compact '(SEQ-COMPACT s)))))
(define rmm-phi (dk-skolem! (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'f))) "seq-compact clause") rmm-g)))
(define rmm-L (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'l))) "the limit")))
(define rmm-sq (list 'SUBSEQ rmm-g rmm-phi))
(define rmm-smi (dk-cite! 'strictly-mono-nn rmm-phi))
(dk-have! (list 'IN rmm-phi '(FUN NN NN)) (lambda () (rmm-prop! rmm-smi (list 'STRICTLY-MONO-NN rmm-phi))))
(define rmm-conv (list 'CONVERGES-TO 's rmm-sq rmm-L))

;;; (rmm-limit-in! N C CLOSE-K): the goal is (IN L C) with (IS-CLOSED s C) in
;;; context; prove the tail  forall k >= succ(N). sq(k) in C  -- on each k,
;;; with g(phi k) realizing es below phi(k) > N and the instance
;;; (IFF (IN g(phi k) B_N) (= (es N) 1)) landed, (CLOSE-K w) closes
;;; (IN w C) for w = g(phi k) -- and cite closed-set-limit-in-tail.
(define (rmm-limit-in! n C close-k)
  (let ((tail (list 'FORALL 'tk_ (list 'IMPLIES '(IN tk_ NN)
                (list 'IMPLIES (list '<= (list 'succ n) 'tk_) (list 'IN (list rmm-sq 'tk_) C))))))
    (dk-cite! 'nn-succ-closed n)
    (dk-have! tail
      (lambda ()
        (let ((k (dk-di-var!)))
          (di)
          (let* ((pk (list rmm-phi k))
                 (w  (list rmm-g pk)))
            (dk-cite! 'subseq-apply rmm-g rmm-phi k)
            (subst (list '== (list rmm-sq k) w))
            (dk-cite! 'fun-apply-type-c rmm-phi 'NN 'NN k)
            (dk-cite! 'strictly-mono-ge-id rmm-phi k)
            (dk-have! (list '< n pk) (lambda () (dk-nn! (list '<= (list 'succ n) k) (list '<= k pk))))
            (dk-cite! 'fun-apply-type-c rmm-g 'NN '(PTS s) pk)
            (rmm-seq-at! rmm-g pk)
            (let ((rz (dk-split-all! (dk-landed (lambda () (mac-h 'rm-realizes (rmm-real 'es_ pk w)))))))
              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rri_))) "the realizing clause") n)
              (close-k w))))))
    (dk-cite! 'closed-set-limit-in-tail 's C rmm-sq rmm-L (list 'succ n))
    (ass)))

(ew rmm-L)
(mac 'rm-address)
(rmm-and-focus! 'FORALL)
(define rmm-n (dk-di-var!))
