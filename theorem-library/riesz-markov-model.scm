;;; ---- the rmm- kit ----------------------------------------------------
;;; (rmm-two-split! X K): X in RM-TWO in context; split on X = 0 / X = 1 and run
;;; (K c) on each leaf, c the value.
(define (rmm-two-split! x k)
  (let* ((orf (dk-cite! 'rmm-two-cases x))
         (lv  (dk-opened (lambda () (ai orf)))))
    (if (not (= (length lv) 2)) (error "rmm-two-split!: ai did not open two leaves" (length lv)))
    (for-each (lambda (leaf)
                (dk-focus! leaf)
                (k (if (dk-asm? (list '= x 0)) 0 1)))
              lv)))

;;; (rmm-pos! E): (IN E RR) and (< 0 E) from (POS-RR E), by citation.
(define (rmm-pos! e)
  (dk-cite! 'rr-pos-rr-in-rr e)
  (dk-cite! 'rr-lt-of-pos-rr e))

;;; (rmm-half!): (IN 1/2 RR), (< 0 1/2), (POS-RR 1/2) in context.
(define (rmm-half!)
  (dk-have! '(IN 1/2 RR) (lambda () (from-context!)))
  (dk-have! '(< 0 1/2) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1/2))

;;; (rmm-sep-iff!): close  (IFF (IN t (SEP v D P)) (AND (IN t D) P[t]))  -- the
;;; two directions by sep-me / sep-mi.
(define (rmm-sep-hyp!)
  (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP)))
                    "the SEP membership")))
    (dk-split-all! (dk-landed (lambda () (sep-me h))))))

(define (rmm-sep-iff!)
  (for-each
    (lambda (leaf)
      (dk-focus! leaf)
      (let ((g (dk-goal)))
        (if (and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'SEP))
            (begin (dk-split-all!)
                   (dk-close-all! (lambda () (sep-mi))))
            (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP)))
                              "the SEP membership")))
              (dk-split-all! (dk-landed (lambda () (sep-me h))))
              (dk-conj-close! (lambda () (ass)))))))
    (dk-opened (lambda () (di)))))

;;; (rmm-prop! F ...): `prop' on the focus leaf after keeping only the named
;;; formulas -- in a deep context prop's atom cap drops the relevant pair.  Use
;;; it inside a dk-have! lane (it weakens the leaf).
(define (rmm-prop! . keepers)
  (apply dk-only! keepers)
  (prop))

;;; (rmm-if! TRUE? T): if-true / if-false on the conditional term T; the
;;; spawned (NOT) P leaf is closed from context and focus returns to the leaf
;;; carrying the equation.
(define (rmm-if! true? t)
  (let* ((leaf0 (proof-state-focus *ps*))
         (lv (dk-opened (lambda () (if true? (if-true t) (if-false t)))))
         (p  (if true? (cadr t) (list 'NOT (cadr t))))
         (side (filter (lambda (l) (equal? (dk-goal-of l) p)) lv))
         (main (filter (lambda (l) (not (equal? (dk-goal-of l) p))) lv)))
    (for-each (lambda (l) (dk-focus! l) (ass)) side)
    (if (not (= (length main) 1)) (error "rmm-if!: expected one main leaf" (length main)))
    (dk-focus! (car main))))

;;; (rmm-split-goal!): split the focus goal's conjunctions; return the leaves.
(define (rmm-split-goal!)
  (if (dk-head-is? (dk-goal) 'AND)
      (let ((lv (dk-opened (lambda () (di)))))
        (append-map (lambda (l) (dk-focus! l) (rmm-split-goal!)) lv))
      (list (proof-state-focus *ps*))))

;;; (rmm-and-focus! HEAD): split the conjunctive goal, close every conjunct
;;; whose head is not HEAD by `ass', and focus the one whose head is HEAD.
(define (rmm-and-focus! head)
  (let* ((lv   (rmm-split-goal!))
         (keep (filter (lambda (l) (dk-head-is? (dk-goal-of l) head)) lv))
         (rest (filter (lambda (l) (not (dk-head-is? (dk-goal-of l) head))) lv)))
    (if (not (= (length keep) 1))
        (error "rmm-and-focus!: expected exactly one conjunct headed" head (length keep)))
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin (dk-focus! l) (ass)
                           (if (not (sequent-node-grounded? l))
                               (error "rmm-and-focus!: conjunct not in context" (expression->string (dk-goal-of l)))))))
              rest)
    (dk-focus! (car keep))))

