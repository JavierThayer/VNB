(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL x (IMPLIES (IN x (PTS s)) (IN (RM-CODE s dseq x) (RM-K s dseq)))))))))
