  (IMPLIES (NOT (IN es_ (RM-K s dseq)))
    (FORSOME rkn_ (AND (IN rkn_ NN) (FORALL rky_ (NOT (RM-REALIZES s dseq es_ rkn_ rky_))))))))))))
