                                        "the infinite fibre")))))
(dk-have! (list 'SUBSET rmm-S 'NN)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z rmm-S)))))
