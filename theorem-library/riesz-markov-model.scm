(dk-have! (list 'IN rmm-z '(PTS CANTOR-MS)) (lambda () (rmm-prop! rmm-bm (list 'IN rmm-z (list 'BALL 'CANTOR-MS rmm-e rmm-rad)))))
(dk-have! (list '<= (rmm-d 'CANTOR-MS rmm-e rmm-z) rmm-rad) (lambda () (rmm-prop! rmm-bm (list 'IN rmm-z (list 'BALL 'CANTOR-MS rmm-e rmm-rad)))))
