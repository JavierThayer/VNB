(define rmm-phi (dk-skolem! (dk-cite! 'subsequence-capture rmm-S)))
(dk-cite! 'fun-codomain-superset rmm-phi 'NN rmm-S 'NN)
(dk-have! (list 'STRICTLY-MONO-NN rmm-phi)
  (lambda () (mac 'strictly-mono-nn) (dk-conj-close! (lambda () (ass)))))
(ew rmm-phi)
(define rmm-sq (list 'SUBSEQ rmm-f rmm-phi))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew rmm-c)
          (dk-have! (list 'IN rmm-c '(PTS RM-TWO-MS)) (lambda () (subst '(== (PTS RM-TWO-MS) RM-TWO)) (ass)))
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'CONVERGES-TO)
                  (begin
                    (mac 'converges-to)
                    (dk-have! (list 'AND (list 'IN rmm-f '(FUN NN (PTS RM-TWO-MS))) (list 'STRICTLY-MONO-NN rmm-phi))
                      (lambda () (dk-conj-close! (lambda () (ass)))))
                    (dk-cite! 'subseq-is-fun 'RM-TWO-MS rmm-f rmm-phi)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'FORALL)
                            (let ((eps (dk-di-var! (lambda (g) (cadr (cadr g))))))
                              (di)
                              (ew 0)
                              (dk-conj-close!
                                (lambda ()
                                  (if (dk-head-is? (dk-goal) 'FORALL)
                                      (let ((k (dk-di-var!)))
                                        (di)
                                        (dk-cite! 'subseq-apply rmm-f rmm-phi k)
                                        (subst (list '== (list rmm-sq k) (list rmm-f (list rmm-phi k))))
                                        (dk-cite! 'fun-apply-type-c rmm-phi 'NN rmm-S k)
                                        (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN (list rmm-phi k) rmm-S)))))
                                        (subst (list '= (list rmm-f (list rmm-phi k)) rmm-c))
                                        (dk-cite! 'metric-self-zero 'RM-TWO-MS rmm-c)
