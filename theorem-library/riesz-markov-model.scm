           (al (list 'FORALL 'rkn_ (list 'IMPLIES '(IN rkn_ NN) (list 'FORSOME 'rky_ (rmm-real rmm-z 'rkn_ 'rky_))))))
      (dk-have! al (lambda () (rmm-prop! km (list 'IN rmm-z rmm-K))))
