(sp (make-wff '(FORALL s (FORALL dseq (FORALL es_ (FORALL esb_ (FORALL nb (FORALL y
  (IMPLIES (FORALL rai_ (IMPLIES (IN rai_ NN) (IMPLIES (< rai_ nb) (= (esb_ rai_) (es_ rai_)))))
    (IMPLIES (RM-ADDRESS-BELOW s dseq esb_ nb y) (RM-ADDRESS-BELOW s dseq es_ nb y)))))))))))
(dk-peel!)
(define rmm-ag (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rai_))) "agreement"))
(dk-split-all! (dk-landed (lambda () (mac-h 'rm-address-below '(RM-ADDRESS-BELOW s dseq esb_ nb y)))))
(define rmm-bc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rbn_))) "below clause"))
