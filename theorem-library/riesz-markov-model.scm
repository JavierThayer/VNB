(define rmm-ph (dk-cite! 'pigeonhole-infinite 'NN 'RM-TWO rmm-f))
(define rmm-c (dk-skolem! rmm-ph))
(define rmm-S (cadr (cadr (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'IN)
                                                          (dk-head-is? (cadr (cadr f)) 'CARD)
