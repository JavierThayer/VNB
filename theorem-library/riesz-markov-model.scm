;;; COUNTABLE CHOICE in the form the constructions below use: a family of
;;; inhabited subsets of A, indexed by NN, has a choice sequence in A.  The
;;; family is a variable; instantiate it at (VNB-LAMBDA k NN (SEP w A P)).
(sp (make-wff '(FORALL ca_ (FORALL fam_
  (IMPLIES (FORALL k (IMPLIES (IN k NN) (FORSOME w (AND (IN w ca_) (IN w (fam_ k))))))
    (FORSOME g (AND (IN g (FUN NN ca_)) (FORALL k (IMPLIES (IN k NN) (IN (g k) (fam_ k)))))))))))
(dk-peel!)
(define rmm-inh (dk-pick (lambda (f) (dk-head-is? f 'FORALL)) "the inhabitation hypothesis"))
(define (rmm-cs k) (list 'SEP 'cw_ 'ca_ (list 'IN 'cw_ (list 'fam_ k))))
;; for each k: CHOICE(S_k) lies in A and in fam(k)
(dk-have! (list 'FORALL 'ck_ (list 'IMPLIES '(IN ck_ NN)
            (list 'AND (list 'IN (list 'CHOICE (rmm-cs 'ck_)) 'ca_)
                       (list 'IN (list 'CHOICE (rmm-cs 'ck_)) '(fam_ ck_)))))
  (lambda ()
    (let* ((k (dk-di-var!))
           (w (dk-skolem! (dk-apply! rmm-inh k))))
      (dk-have! (list 'FORSOME 'cx_ (list 'IN 'cx_ (rmm-cs k)))
        (lambda () (ew w) (dk-close-all! (lambda () (sep-mi)))))
      (let ((m (dk-cite! 'choice-axiom (rmm-cs k))))
        (dk-split-all! (dk-landed (lambda () (sep-me m))))
        (dk-conj-close! (lambda () (ass)))))))
(define rmm-chosen (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'ck_))) "chosen"))
(define rmm-g (list 'VNB-LAMBDA 'cg_ 'NN (list 'CHOICE (rmm-cs 'cg_))))
(ew rmm-g)
(define (rmm-chosen-at! k)
  (dk-split-all! (list (dk-apply! rmm-chosen k))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (rmm-chosen-at! k) (ass))))
        (let ((k (dk-di-var!)))
          (rmm-chosen-at! k)
          (dk-lam-b!)
          (ass)))))
(qed 'rmm-nn-choice)

;;; ---------------------------------------------------------------------
;;; pi is well defined.  Uniqueness: strong separation.
