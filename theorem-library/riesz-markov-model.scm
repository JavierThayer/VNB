  (list 'IS-CONTINUOUS 'CANTOR-MS 'RM-TWO-MS (list 'PRODUCT-PROJ rmm-ms 'n_))))))
(dk-peel!)
(fact 'rmm-cantor-unfold)
(subst (list '== 'CANTOR-MS rmm-pmw))
(fact 'product-metric-default-summable)
(fact 'rmm-ms-seq)
(define rmm-h (dk-cite! 'product-projection-continuous rmm-ms rmm-wdef 'n_))
(fact 'rmm-two-ms-set)
(dk-lam-b-h! rmm-h)
(ass)
(qed 'rmm-coord-continuous)

;;; (rmm-coord-typ! ES N): ES in PTS CANTOR-MS and N in NN in context; land
;;; (ES N) in RM-TWO, in PTS RM-TWO-MS and in RR.
(define (rmm-coord-typ! es n)
  (let* ((t (list es n))
         (h (dk-cite! 'rmm-cantor-coord es n)))
    (if (not (dk-asm? '(== (PTS RM-TWO-MS) RM-TWO))) (fact 'rmm-two-ms-pts))
    (if (not (dk-asm? (list 'IN t '(PTS RM-TWO-MS))))
        (dk-rewrite-h! h 'RM-TWO '(PTS RM-TWO-MS)))
    (if (not (dk-asm? '(SUBSET RM-TWO RR))) (fact 'rmm-two-sub-rr))
    (dk-cite! 'subset-mem-fwd 'RM-TWO 'RR t)
    t))

;;; one coordinate is locally constant
(sp (make-wff '(FORALL n_ (IMPLIES (IN n_ NN)
  (FORALL es_ (IMPLIES (IN es_ (PTS CANTOR-MS))
    (FORSOME rnd_ (AND (POS-RR rnd_)
      (FORALL rnb_ (IMPLIES (IN rnb_ (PTS CANTOR-MS))
        (IMPLIES (<= ((DIST CANTOR-MS) es_ rnb_) rnd_) (= (rnb_ n_) (es_ n_)))))))))))))
(dk-peel!)
(define rmm-h (dk-cite! 'rmm-coord-continuous 'n_))
(dk-split-all! (dk-landed (lambda () (mac-h 'is-continuous rmm-h))))
(define rmm-proj (list 'PRODUCT-PROJ rmm-ms 'n_))
(define rmm-h2 (dk-apply! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS CANTOR-MS))
                                  (list 'IS-CONTINUOUS-AT 'CANTOR-MS 'RM-TWO-MS rmm-proj 'a))) 'es_))
(dk-split-all! (dk-landed (lambda () (mac-h 'is-continuous-at rmm-h2))))
(rmm-half!)
(define rmm-eh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'eps))) "the eps clause"))
(define rmm-del (dk-skolem! (dk-apply! rmm-eh 1/2)))
(define rmm-bh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b))) "the delta clause"))
(ew rmm-del)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let ((b (dk-di-var!)))
          (di)
          (let* ((h  (dk-apply! rmm-bh b))
                 (v1 (dk-cite! 'rmm-proj-value 'n_ 'es_))
                 (v2 (dk-cite! 'rmm-proj-value 'n_ b))
                 (h1 (dk-rewrite-h! h (cadr v1) (caddr v1)))
                 (h2 (dk-rewrite-h! h1 (cadr v2) (caddr v2))))
            (rmm-coord-typ! 'es_ 'n_)
            (rmm-coord-typ! b 'n_)
            (dk-cite! 'rmm-two-ms-metric)
            (dk-cite! 'metric-dist-real 'RM-TWO-MS '(es_ n_) (list b 'n_))
            (dk-have! (list '< (cadr h2) 1) (lambda () (dk-ineq! h2)))
            (dk-cite! 'rmm-two-near-eq '(es_ n_) (list b 'n_))
            (subst (list '= '(es_ n_) (list b 'n_)))
            (rfl)))
        (ass))))
(qed 'rmm-coord-near)

;;; finitely many coordinates are locally constant (induction on their number)
(define (rmm-agree-body nb)
  (list 'FORALL 'es_ (list 'IMPLIES '(IN es_ (PTS CANTOR-MS))
    (list 'FORSOME 'rad_ (list 'AND '(POS-RR rad_)
      (list 'FORALL 'rab_ (list 'IMPLIES '(IN rab_ (PTS CANTOR-MS))
        (list 'IMPLIES '(<= ((DIST CANTOR-MS) es_ rab_) rad_)
          (list 'FORALL 'rai_ (list 'IMPLIES '(IN rai_ NN)
            (list 'IMPLIES (list '< 'rai_ nb) '(= (rab_ rai_) (es_ rai_)))))))))))))
(sp (make-wff (list 'FORALL 'nb (list 'IMPLIES '(IN nb NN) (rmm-agree-body 'nb)))))
(define rmm-lv (dk-opened (lambda () (ni))))
;; base: nothing to agree on; radius 1
(dk-focus! (car rmm-lv))
(let ((es (dk-di-var!)))
  (dk-have! '(IN 1 RR) (lambda () (from-context!)))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (ew 1)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (begin
            (dk-di-var!) (di)
            (let ((i (dk-di-var!)))
              (di)
              (pbc)
              (dk-cite! 'nn-in-rr i)
              (dk-cite! 'nn-zero-le i)
              (dk-absurd! (list '<= 0 i) (list '< i 0))))
          (ass)))))
;; step: the radius for nb, the radius for coordinate nb, and their minimum
(dk-focus! (cadr rmm-lv))
(define rmm-nb (dk-di-var!))
(di)
(define rmm-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'es_))) "the induction hypothesis"))
(define rmm-es (dk-di-var!))
(define rmm-r1 (dk-skolem! (dk-apply! rmm-ih rmm-es)))
(define rmm-c1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rab_))) "the IH clause"))
(define rmm-r2 (dk-skolem! (dk-cite! 'rmm-coord-near rmm-nb rmm-es)))
(define rmm-c2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rnb_))) "the coordinate clause"))
(rmm-pos! rmm-r1)
(rmm-pos! rmm-r2)
(define rmm-w (dk-skolem! (dk-cite! 'rr-min-pos rmm-r1 rmm-r2)))
(dk-cite! 'rr-pos-rr-of-lt rmm-w)
(fact 'rmm-cantor-metric)
(ew rmm-w)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let ((b (dk-di-var!)))
          (di)
          (let ((dd (list '(DIST CANTOR-MS) rmm-es b)))
            (dk-cite! 'metric-dist-real 'CANTOR-MS rmm-es b)
            (dk-have! (list '<= dd rmm-r1) (lambda () (dk-ineq! (list '<= dd rmm-w) (list '<= rmm-w rmm-r1))))
            (dk-have! (list '<= dd rmm-r2) (lambda () (dk-ineq! (list '<= dd rmm-w) (list '<= rmm-w rmm-r2))))
            (let ((a1 (dk-apply! rmm-c1 b))
                  (a2 (dk-apply! rmm-c2 b))
                  (i  (dk-di-var!)))
              (di)
              (use-em (list '< i rmm-nb)
                (lambda () (dk-apply! a1 i) (ass))
                (lambda ()
                  (dk-have! (list '= i rmm-nb)
                    (lambda ()
                      (dk-cite! 'nn-succ-closed rmm-nb)
                      (dk-cite! 'nn-lt-succ-le i (list 'succ rmm-nb))
                      (dk-have! (list '<= i rmm-nb)
                        (lambda () (dk-nn! (list '<= (list 'succ i) (list 'succ rmm-nb)))))
                      (dk-cite! 'nn-not-lt-le i rmm-nb)
                      (dk-cite! 'nn-le-antisym i rmm-nb)
                      (ass)))
                  (subst (list '= i rmm-nb))
                  (ass))))))
        (ass))))
(qed 'rmm-agree-near)

;;; =====================================================================
;;; (B) THE BALL FAMILY AND STRONG SEPARATION
;;; =====================================================================
(define (rmm-cn s dseq n) (list dseq (list 'NNFST n)))
(define (rmm-rn n) (list 'recip (list '+ (list 'NNSND n) 1)))

(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (AND (IS-METRIC-SPACE s) (IN dseq (FUN NN (PTS s)))))))))
(dk-peel!)
(mac-h 'is-dense-seq '(IS-DENSE-SEQ s dseq))
(dk-split-all!)
(dk-conj-close! (lambda () (ass)))
(qed 'rmm-dense-parts)

(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL x (IMPLIES (IN x (PTS s)) (FORALL eps (IMPLIES (POS-RR eps)
    (FORSOME m (AND (IN m NN) (< ((DIST s) x (dseq m)) eps))))))))))))
(dk-peel!)
(mac-h 'is-dense-seq '(IS-DENSE-SEQ s dseq))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'x))) "the density clause") 'x 'eps)
(ass)
(qed 'rmm-dense-near)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'IMPLIES '(IS-DENSE-SEQ s dseq)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN (rmm-cn 's 'dseq 'n) '(PTS s)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(dk-cite! 'nnfst-type 'n)
(dk-cite! 'fun-apply-type-c 'dseq 'NN '(PTS s) '(NNFST n))
(ass)
(qed 'rmm-centre-in)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'POS-RR (rmm-rn 'n))))))
(dk-peel!)
(dk-cite! 'nnsnd-type 'n)
(dk-cite! 'nn-recip-succ-pos '(NNSND n))
(ass)
(qed 'rmm-rad-pos)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'n (list 'FORALL 'y
  (list 'IFF '(IN y (RM-BALL s dseq n))
        (list 'AND '(IN y (PTS s)) (list '<= (list '(DIST s) (rmm-cn 's 'dseq 'n) 'y) (rmm-rn 'n))))))))))
(dk-peel!)
;; 2026-10-11 (META round 3): closed-ball-membership as a macete owes its match
;; dseq(nnfst n), recip(nnsnd n + 1) DEFINED, unprovable for an arbitrary dseq;
;; unfold the functoid (schematic, owes nothing) and use SEP membership instead.
(mac 'RM-BALL)
(mac 'CLOSED-BALL)
(rmm-sep-iff!)
(qed 'rmm-ball-mem)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'n (list 'FORALL 'y
  (list 'IFF '(IN y (RM-SHELL s dseq n))
        (list 'AND '(IN y (PTS s)) (list '<= (rmm-rn 'n) (list '(DIST s) (rmm-cn 's 'dseq 'n) 'y))))))))))
(dk-peel!)
(mac 'RM-SHELL)
(rmm-sep-iff!)
(qed 'rmm-shell-mem)

;;; distance helpers: (IS-METRIC-SPACE s) and the point typings in context
(define (rmm-dreal! s a b) (dk-cite! 'metric-dist-real s a b))
(define (rmm-tri! s a b c) (dk-cite! 'metric-triangle s a b c))
(define (rmm-sym! s a b) (dk-cite! 'metric-sym s a b))
(define (rmm-d s a b) (list (list 'DIST s) a b))

;;; every point lies strictly inside a ball of the family of any prescribed radius
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'IMPLIES '(IS-DENSE-SEQ s dseq)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN)
      (list 'FORSOME 'rcn_ (list 'AND '(IN rcn_ NN)
        (list 'AND '(= (NNSND rcn_) j_)
          (list '< (rmm-d 's (rmm-cn 's 'dseq 'rcn_) 'x) (rmm-rn 'rcn_))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(define rmm-r (list 'recip '(+ j_ 1)))
(dk-cite! 'nn-recip-succ-pos 'j_)
(define rmm-m (dk-skolem! (dk-cite! 'rmm-dense-near 's 'dseq 'x rmm-r)))
(define rmm-n (list 'NNPAIR rmm-m 'j_))
(dk-cite! 'nnpair-type rmm-m 'j_)
(dk-cite! 'nnfst-nnpair rmm-m 'j_)
(dk-cite! 'nnsnd-nnpair rmm-m 'j_)
(ew rmm-n)
(dk-cite! 'fun-apply-type-c 'dseq 'NN '(PTS s) rmm-m)
(rmm-sym! 's 'x (list 'dseq rmm-m))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g '<)
             (subst (list '= (list 'NNFST rmm-n) rmm-m))
             (subst (list '= (list 'NNSND rmm-n) 'j_))
             (subst (list '= (rmm-d 's (list 'dseq rmm-m) 'x) (rmm-d 's 'x (list 'dseq rmm-m))))
             (ass))
            (#t (ass))))))
(qed 'rmm-near-centre)

;;; a point strictly inside B_n lies in B_n and outside SHELL_n
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'IMPLIES '(IS-DENSE-SEQ s dseq)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
      (list 'IMPLIES (list '< (rmm-d 's (rmm-cn 's 'dseq 'n) 'x) (rmm-rn 'n))
        '(AND (IN x (RM-BALL s dseq n)) (NOT (IN x (RM-SHELL s dseq n))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(dk-cite! 'rmm-centre-in 's 'dseq 'n)
(rmm-dreal! 's (rmm-cn 's 'dseq 'n) 'x)
(dk-cite! 'rmm-rad-pos 'n)
(rmm-pos! (rmm-rn 'n))
(dk-cite! 'rmm-ball-mem 's 'dseq 'n 'x)
(dk-cite! 'rmm-shell-mem 's 'dseq 'n 'x)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'NOT)
        (begin
          (di)
          (let ((c (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (equal? (cadr f) '(IN x (RM-SHELL s dseq n))))) "shell iff")))
            (dk-have! (list '<= (rmm-rn 'n) (rmm-d 's (rmm-cn 's 'dseq 'n) 'x)) (lambda () (prop)))
            (dk-absurd! (list '<= (rmm-rn 'n) (rmm-d 's (rmm-cn 's 'dseq 'n) 'x))
                        (list '< (rmm-d 's (rmm-cn 's 'dseq 'n) 'x) (rmm-rn 'n)))))
        (begin
          (dk-have! (list '<= (rmm-d 's (rmm-cn 's 'dseq 'n) 'x) (rmm-rn 'n))
            (lambda () (dk-ineq! (list '< (rmm-d 's (rmm-cn 's 'dseq 'n) 'x) (rmm-rn 'n)))))
          (prop)))))
(qed 'rmm-inside-ball)

;;; STRONG SEPARATION.  Two different points lie strictly inside two DISJOINT
;;; balls of the family (strictly: outside the shells).  Radius r < d(x,y)/4.
(define (rmm-sep-body n m)
  (list 'AND (list 'IN 'x (list 'RM-BALL 's 'dseq n))
  (list 'AND (list 'NOT (list 'IN 'x (list 'RM-SHELL 's 'dseq n)))
  (list 'AND (list 'IN 'y (list 'RM-BALL 's 'dseq m))
  (list 'AND (list 'NOT (list 'IN 'y (list 'RM-SHELL 's 'dseq m)))
    (list 'FORALL 'rsz_ (list 'NOT (list 'AND (list 'IN 'rsz_ (list 'RM-BALL 's 'dseq n))
                                             (list 'IN 'rsz_ (list 'RM-BALL 's 'dseq m))))))))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'IMPLIES '(IS-DENSE-SEQ s dseq)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS s))
      (list 'IMPLIES '(NOT (= x y))
        (list 'FORSOME 'rsn_ (list 'AND '(IN rsn_ NN)
          (list 'FORSOME 'rsm_ (list 'AND '(IN rsm_ NN) (rmm-sep-body 'rsn_ 'rsm_)))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(define rmm-dxy (rmm-d 's 'x 'y))
(rmm-dreal! 's 'x 'y)
(dk-cite! 'metric-pos 's 'x 'y)
(define rmm-ze (dk-cite! 'metric-zero-eq 's 'x 'y))
(dk-have! (list 'NOT (list '= 0 rmm-dxy))
  (lambda ()
    (di)
    (dk-have! (list '= rmm-dxy 0) (lambda () (dk-ineq! (list '= 0 rmm-dxy))))
    (detach! rmm-ze)
    (ai '(NOT (= x y)))))
(dk-have! (list 'POS-RR rmm-dxy) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (ass)))))
(define rmm-h1 (dk-halve! rmm-dxy))
(define rmm-h2 (dk-halve! rmm-h1))
(define rmm-j (dk-skolem! (dk-cite! 'nn-recip-succ-small rmm-h2)))
(define rmm-r (list 'recip (list '+ rmm-j 1)))
(dk-cite! 'nn-recip-succ-pos rmm-j)
(rmm-pos! rmm-r)
(define rmm-n (dk-skolem! (dk-cite! 'rmm-near-centre 's 'dseq 'x rmm-j)))
(define rmm-m (dk-skolem! (dk-cite! 'rmm-near-centre 's 'dseq 'y rmm-j)))
(define rmm-cn1 (rmm-cn 's 'dseq rmm-n))
(define rmm-cm1 (rmm-cn 's 'dseq rmm-m))
(dk-cite! 'rmm-centre-in 's 'dseq rmm-n)
(dk-cite! 'rmm-centre-in 's 'dseq rmm-m)
(dk-cite! 'rmm-inside-ball 's 'dseq rmm-n 'x)
(dk-cite! 'rmm-inside-ball 's 'dseq rmm-m 'y)
(dk-split-all! (list (list 'AND (list 'IN 'x (list 'RM-BALL 's 'dseq rmm-n)) (list 'NOT (list 'IN 'x (list 'RM-SHELL 's 'dseq rmm-n))))
                     (list 'AND (list 'IN 'y (list 'RM-BALL 's 'dseq rmm-m)) (list 'NOT (list 'IN 'y (list 'RM-SHELL 's 'dseq rmm-m))))))
(define (rmm-rad-at! k)          ; d(c_k, .) < recip(NNSND k + 1)  ->  ... < recip(j + 1)
  (let ((h (dk-pick (lambda (f) (and (dk-head-is? f '<) (equal? (caddr f) (rmm-rn k)))) "a strict radius bound")))
    (dk-rewrite-h! h (list 'NNSND k) rmm-j)))
(define rmm-xin (rmm-rad-at! rmm-n))
(define rmm-yin (rmm-rad-at! rmm-m))
(rmm-dreal! 's rmm-cn1 'x)
(rmm-dreal! 's rmm-cm1 'y)
(ew rmm-n)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew rmm-m)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let ((z (dk-di-var! (lambda (g) (cadr (cadr (cadr g)))))))
                    (di)
                    (dk-split-all!)
                    (let ((bz1 (dk-cite! 'rmm-ball-mem 's 'dseq rmm-n z))
                          (bz2 (dk-cite! 'rmm-ball-mem 's 'dseq rmm-m z)))
                      (dk-have! (list 'IN z '(PTS s)) (lambda () (prop)))
                      (let* ((l1 (list '<= (rmm-d 's rmm-cn1 z) (rmm-rn rmm-n)))
                             (l2 (list '<= (rmm-d 's rmm-cm1 z) (rmm-rn rmm-m))))
                        (dk-have! l1 (lambda () (prop)))
                        (dk-have! l2 (lambda () (prop)))
                        (let ((k1 (dk-rewrite-h! l1 (list 'NNSND rmm-n) rmm-j))
                              (k2 (dk-rewrite-h! l2 (list 'NNSND rmm-m) rmm-j)))
                          (rmm-dreal! 's rmm-cn1 z) (rmm-dreal! 's rmm-cm1 z)
                          (rmm-dreal! 's 'x rmm-cn1) (rmm-dreal! 's z 'y) (rmm-dreal! 's rmm-cn1 'y)
                          (rmm-dreal! 's z rmm-cm1)
                          (let ((t1 (rmm-tri! 's 'x rmm-cn1 'y))
                                (t2 (rmm-tri! 's rmm-cn1 z 'y))
                                (t3 (rmm-tri! 's z rmm-cm1 'y))
                                (s1 (rmm-sym! 's 'x rmm-cn1))
                                (s2 (rmm-sym! 's z rmm-cm1)))
                            (dk-absurd! t1 t2 t3 s1 s2 k1 k2 rmm-xin rmm-yin
                                        (list '< rmm-r rmm-h2)
                                        (list '= (list '+ rmm-h2 rmm-h2) rmm-h1)
                                        (list '= (list '+ rmm-h1 rmm-h1) rmm-dxy)))))))
                  (ass)))))
        (ass))))
(qed 'rmm-strong-separation)

;;; =====================================================================
;;; (C) THE MODEL K: CLOSED IN THE CANTOR SPACE, HENCE COMPACT
;;; =====================================================================
(define rmm-K '(RM-K s dseq))
(define (rmm-real es nb y) (list 'RM-REALIZES 's 'dseq es nb y))

(sp (make-wff '(FORALL s (FORALL dseq (FORALL es_
  (IFF (IN es_ (RM-K s dseq))
       (AND (IN es_ (PTS CANTOR-MS))
            (FORALL rkn_ (IMPLIES (IN rkn_ NN) (FORSOME rky_ (RM-REALIZES s dseq es_ rkn_ rky_)))))))))))
(dk-peel!)
(mac 'RM-K)
(rmm-sep-iff!)
(qed 'rmm-k-mem)

(sp (make-wff '(FORALL s (FORALL dseq (SUBSET (RM-K s dseq) (PTS CANTOR-MS))))))
(dk-peel!)
;; 2026-10-11 (META round 3): subset-def owes its match DEFINED.  With the Cantor
;; space a metric space in context, PTS(CANTOR-MS) and the SEP that RM-K unfolds
;; to are certified; RM-K(s, dseq) itself is not.
(fact 'rmm-cantor-metric)
(mac 'RM-K)
(mac 'subset-def)
(let ((e (dk-di-var!)))
  (rmm-sep-hyp!)
  (ass))
(qed 'rmm-k-sub)

;;; realizing a pattern below nb depends only on the first nb coordinates
(sp (make-wff '(FORALL s (FORALL dseq (FORALL es_ (FORALL esb_ (FORALL nb (FORALL y
  (IMPLIES (FORALL rai_ (IMPLIES (IN rai_ NN) (IMPLIES (< rai_ nb) (= (esb_ rai_) (es_ rai_)))))
    (IMPLIES (RM-REALIZES s dseq es_ nb y) (RM-REALIZES s dseq esb_ nb y)))))))))))
(dk-peel!)
(define rmm-ag (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rai_))) "agreement"))
(dk-split-all! (dk-landed (lambda () (mac-h 'rm-realizes '(RM-REALIZES s dseq es_ nb y)))))
(mac 'rm-realizes)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let ((i (dk-di-var!)))
          (di)
          (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rri_))) "realizes clause") i)
          (dk-apply! rmm-ag i)
          (subst (list '= (list 'esb_ i) (list 'es_ i)))
          (ass))
        (ass))))
(qed 'rmm-realizes-agree)


;;; a point of the Cantor space outside K fails at some finite stage
