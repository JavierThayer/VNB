(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL es_ (FORALL y1_ (FORALL y2_
    (IMPLIES (RM-ADDRESS s dseq es_ y1_) (IMPLIES (RM-ADDRESS s dseq es_ y2_) (= y1_ y2_)))))))))))
(dk-peel!)
(define rmm-a1 (dk-split-all! (dk-landed (lambda () (mac-h 'rm-address '(RM-ADDRESS s dseq es_ y1_))))))
(define rmm-ad1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'y1_))) "address of y1"))
(dk-split-all! (dk-landed (lambda () (mac-h 'rm-address '(RM-ADDRESS s dseq es_ y2_)))))
(define rmm-ad2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'y2_))) "address of y2"))
(pbc)
(define rmm-ss (dk-cite! 'rmm-strong-separation 's 'dseq 'y1_ 'y2_))
(define rmm-n (dk-skolem! rmm-ss))
(define rmm-m (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'rsm_))) "the second ball")))
(dk-split-all!)
(define (rmm-addr-at! ad k) (dk-split-all! (list (dk-apply! ad k))))
(rmm-addr-at! rmm-ad1 rmm-n)
(rmm-addr-at! rmm-ad1 rmm-m)
(rmm-addr-at! rmm-ad2 rmm-m)
(define rmm-dj (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'rsz_))) "disjointness"))
(dk-apply! rmm-dj 'y1_)
(define (rmm-b k) (list 'RM-BALL 's 'dseq k))
(define (rmm-sh k) (list 'RM-SHELL 's 'dseq k))
(define (rmm-e1 k) (list '= (list 'es_ k) 1))
(rmm-prop! (list 'NOT (list 'AND (list 'IN 'y1_ (rmm-b rmm-n)) (list 'IN 'y1_ (rmm-b rmm-m))))
           (list 'IMPLIES (rmm-e1 rmm-m) (list 'IN 'y1_ (rmm-b rmm-m)))
           (list 'IMPLIES (list 'NOT (rmm-e1 rmm-m)) (list 'IN 'y2_ (rmm-sh rmm-m)))
           (list 'NOT (list 'IN 'y2_ (rmm-sh rmm-m)))
           (list 'IMPLIES (list 'NOT (rmm-e1 rmm-n)) (list 'IN 'y1_ (rmm-sh rmm-n)))
           (list 'NOT (list 'IN 'y1_ (rmm-sh rmm-n)))
           (list 'IN 'y1_ (rmm-b rmm-n)))
(qed 'rmm-address-unique)

;;; the shells are closed: their complements are open
(sp (make-wff '(FORALL s (FORALL dseq (IMPLIES (IS-DENSE-SEQ s dseq)
  (FORALL n (IMPLIES (IN n NN) (IS-CLOSED s (RM-SHELL s dseq n)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmm-dense-parts 's 'dseq)))
(define rmm-c (rmm-cn 's 'dseq 'n))
(define rmm-rr (rmm-rn 'n))
(define rmm-sh '(RM-SHELL s dseq n))
(define rmm-co (list 'COMPLEMENT-IN '(PTS s) rmm-sh))
(dk-cite! 'rmm-centre-in 's 'dseq 'n)
(dk-cite! 'rmm-rad-pos 'n)
(rmm-pos! rmm-rr)
