(rmm-and-focus! 'FORALL)
(let ((i (dk-di-var!)))
  (di)
  (dk-apply! rmm-bc i)
  (dk-apply! rmm-ag i)
  (subst (list '= (list 'es_ i) (list 'esb_ i)))
