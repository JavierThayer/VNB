;;; tb3-trunc.scm -- TH3-B3 target 1: the truncation T_F of a bounded operator to a finite set
;;; F of basis indices, and Cor 3.39 of th-main (a Hilbert-Schmidt operator is compact).
;;;
;;;   T_F = sum_{k in F} <. | e_k> T e_k   (a FINSUM of rank-one operators in the operator group)
;;;
;;; Prefix tb4-.  Library: operator-algebras (the TH3 files' library).
;;; LOAD WINDOW: after th3-vocab (+ unfold), th3-compact, th3a2-compact, th3a3-finrank
;;; (op-finsum-apply, bop-zero-compact), th3b-hs (hs-vector-bound), tb2-tail (esum-tail-small).
;;; ====================================================================

(define tb4-G  '(BOP-NORMED-AG v w))
(define tb4-BG '(NORMED-AG-AS-ABELIAN-GROUP (BOP-NORMED-AG v w)))
(define tb4-H  '(IP-NORMED-AG w))
(define tb4-WG '(NORMED-AG-AS-ABELIAN-GROUP (IP-NORMED-AG w)))
(define (tb4-r1 k) (list 'RANK-ONE-OP 'v 'w (list 'e k) (list 't_ (list 'e k))))
(define (tb4-fam fq) (list 'VNB-LAMBDA 'tbk_ fq (tb4-r1 'tbk_)))
(define (tb4-tr fq) (list 'FINSUM tb4-BG (tb4-fam fq) fq))

(define (tb4-open?)
  (let ((leaf (or *dk-lane-leaf* (proof-state-focus *ps*))))
    (not (sequent-node-grounded? leaf))))
(define (tb4-have! f th) (if (not (dk-asm? f)) (dk-have! f (dk-lane th))) f)
(define (tb4-close!)
  (cond ((not (tb4-open?)) #t)
        ((not (pair? (dk-open-leaves))) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tb4-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb4-det! r)
  (if (and (pair? r) (eq? (car r) 'IMPLIES))
      (if (dk-asm? (caddr r))
          (tb4-det! (caddr r))
          (tb4-det! (dk-landed-1 (lambda () (detach! r)))))
      r))
(define (tb4-cite! thm . args) (tb4-det! (apply dk-cite! thm args)))
(define (tb4-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tb4-done! name) (qed name) (topic! name 'analysis))
(define (tb4-try tag thunk)
  (with-exception-handler
    (lambda (e)
      (error (string-append "TB4-TRY " tag ": " (if (condition? e) (condition/report-string e) "non-condition"))
             (if (pair? (dk-open-leaves)) (expression->string (dk-goal)) "no open leaf")))
    thunk))
;;; an IFF instance used forwards / backwards (th3a3-finrank's device)
(define (tb4-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (tb4-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
;;; the view read-offs of the two groups (th3a3-finrank's device)
(define (tb4-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (tb4-view-eq! acc g val src-eq)
  (let* ((vg (list 'NORMED-AG-AS-ABELIAN-GROUP g))
         (e1 (list '== (list acc vg) (list acc g)))
         (claim (list '== (list acc vg) val)))
    (if (not (dk-asm? claim))
        (begin
          (if (not (dk-asm? e1)) (dk-have! e1 (lambda () (tb4-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc))))
          (dk-have! claim (lambda () (subst e1) (subst src-eq) (dk-close-if! (lambda () #t) (lambda () (qrfl)))))))
    claim))
(define (tb4-ag-setup!)
  (dk-cite! 'bop-normed-ag-is-normed-ag 'v 'w)
  (dk-cite! 'ip-normed-ag-is-normed-ag 'w)
  (dk-cite! 'normed-ag-as-abelian-group-is-abelian-group tb4-G)
  (dk-cite! 'normed-ag-as-abelian-group-is-abelian-group tb4-H)
  (dk-cite! 'bounded-ops-is-set 'v 'w)
  (dk-cite! 'bop-zero-bounded 'v 'w)
  (tb4-view-eq! 'CARR tb4-G '(BOUNDED-OPS v w) (dk-cite! 'bop-nag-carr 'v 'w))
  (tb4-view-eq! 'OPR  tb4-G '(BOP-VADD v w)    (dk-cite! 'bop-nag-opr 'v 'w))
  (tb4-view-eq! 'IDEN tb4-G '(BOP-ZERO v w)    (dk-cite! 'bop-nag-iden 'v 'w))
  (tb4-view-eq! 'CARR tb4-H '(VEC w)  (dk-cite! 'ip-normed-ag-carrier 'w))
  (tb4-view-eq! 'OPR  tb4-H '(VADD w) (dk-cite! 'ip-normed-ag-opr 'w))
  (if (not (dk-asm? '(== (IDEN (IP-NORMED-AG w)) (VZERO w))))
      (dk-have! '(== (IDEN (IP-NORMED-AG w)) (VZERO w))
        (lambda () (mac 'IP-NORMED-AG) (slot 'IDEN) (nth-r) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
  (tb4-view-eq! 'IDEN tb4-H '(VZERO w) '(== (IDEN (IP-NORMED-AG w)) (VZERO w))))

;;; ====================================================================
;;; four vector laws of a complex inner product space the tree did not have
;;; ====================================================================
;;; x + 0 = x
(sp (make-wff (forall-guarded '(v x_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)))
  '(= ((VADD v) x_ (VZERO v)) x_))))
(dk-peel!)
(dk-cite! 'cips-identity-prop 'v)
(tb4-iff-fwd! 'is-identity '(VADD v) '(VZERO v) '(VEC v))
(let ((ui (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(VZERO v)) (not (dk-contains? h 'x_)))) "the identity clause")))
  (dk-split-all! (list (dk-apply! ui 'x_))))
(tb4-close!)
(tb4-done! 'cips-vadd-vzero-right)

;;; -0 = 0
(sp (make-wff (forall-guarded '(v) '((IS-COMPLEX-INNER-PRODUCT-SPACE v))
  '(= ((VNEG v) (VZERO v)) (VZERO v)))))
(dk-peel!)
(fact 'cips-vzero-in 'v)
(let ((nz '((VNEG v) (VZERO v))))
  (dk-cite! 'cips-vneg-type 'v '(VZERO v))
  (dk-cite! 'cips-vadd-vneg 'v '(VZERO v))
  (let ((e2 (dk-cite! 'cips-vadd-vzero 'v nz)))
    (subst (list '= nz (cadr e2)))
    (tb4-close!)))
(tb4-done! 'cips-vneg-vzero)

;;; 0 . x = 0
(sp (make-wff (forall-guarded '(v x_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)))
  '(= ((ACT v) 0 x_) (VZERO v)))))
(dk-peel!)
(fact 'cc-zero-in)
(let* ((ax '((ACT v) 0 x_))
       (c (list '(IP v) 'x_ ax)))
  (dk-cite! 'cips-act-type 'v 0 'x_)
  (dk-cite! 'cips-ip-type 'v 'x_ ax)
  (let ((zv (dk-cite! 'cips-ip-zero-vector 'v ax)))
    (tb4-have! (cadr zv)
      (lambda ()
        (subst (dk-cite! 'cips-ip-homog-left 'v 0 'x_ ax))
        (crs)))
    (tb4-det! zv)
    (tb4-close!)))
(tb4-done! 'cips-act-zero-scalar)

;;; 1 . x = x
(sp (make-wff (forall-guarded '(v x_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN x_ (VEC v)))
  '(= ((ACT v) 1 x_) x_))))
(dk-peel!)
(fact 'cc-one-in)
(let ((ax '((ACT v) 1 x_)))
  (dk-cite! 'cips-act-type 'v 1 'x_)
  (let ((sep (dk-cite! 'cips-ip-separates 'v ax 'x_)))
    (tb4-have! (cadr sep)
      (lambda ()
        (let* ((h (dk-di-var!))
               (c (list '(IP v) 'x_ h)))
          (dk-cite! 'cips-ip-type 'v ax h)
          (dk-cite! 'cips-ip-type 'v 'x_ h)
          (subst (dk-cite! 'cips-ip-conj-sym 'v ax h))
          (subst (dk-cite! 'cips-ip-homog-left 'v 1 'x_ h))
          (subst (dk-cite! 'cips-ip-conj-sym 'v 'x_ h))
          (tb4-have! (list '= (list '* 1 c) c) (lambda () (crs)))
          (subst (list '= (list '* 1 c) c))
          (dk-cite! 'cc-conjugate-closed c)
          (tb4-close!))))
    (tb4-det! sep)
    (tb4-close!)))
(tb4-done! 'cips-act-one)

;;; ====================================================================
;;; trunc-op-compact: T_F is a compact bounded operator
;;; ====================================================================
(define tb4-trunc-hyps
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN e (FUN ix (VEC v)))
    (IN t_ (BOUNDED-OPS v w)) (IN fq_ SET) (IN (CARD fq_) NN) (SUBSET fq_ ix)))
;;; with tb4-trunc-hyps in context: the rank-one family R is pointwise bounded, lies in FUN(fq_, CARR BG)
(define (tb4-ek! z)
  (if (not (dk-asm? (list 'IN z 'ix))) (fact 'subset-mem-fwd 'fq_ 'ix z))
  (tb4-ap! 'e 'ix '(VEC v) z)
  (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e z)))
(define (tb4-fam-setup! fq)
  (let ((R (tb4-fam fq)))
    (fact 'bop-fun 'v 'w 't_)
    (tb4-have! (list 'FORALL 'tqdy_ (list 'IMPLIES (list 'IN 'tqdy_ fq) (list 'IN (list R 'tqdy_) '(BOUNDED-OPS v w))))
      (lambda () (let ((z (cadr (car (dk-peel!)))))
                   (tb4-ek! z)
                   (dk-cite! 'rank-one-op-bounded 'v 'w (list 'e z) (list 't_ (list 'e z)))
                   (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (dk-close-if-asm!))))))
    (tb4-have! (list 'IN R (list 'FUN fq (list 'CARR tb4-BG)))
      (lambda ()
        (subst (list '== (list 'CARR tb4-BG) '(BOUNDED-OPS v w)))
        (dk-lam-type!
          (lambda () (let ((z (dk-di-var!)))
                       (tb4-ek! z)
                       (dk-cite! 'rank-one-op-bounded 'v 'w (list 'e z) (list 't_ (list 'e z)))
                       (dk-close-if-asm!)))
          (lambda () (dk-close-if-asm!)))))
    R))

(sp (make-wff (forall-guarded '(v w ix e t_ fq_) tb4-trunc-hyps (list 'IN (tb4-tr 'fq_) '(COMPACT-OPS v w)))))
(dk-peel!)
(tb4-ag-setup!)
(tb4-try "trunc-compact" (lambda ()
(let* ((sm '(COMPACT-OPS v w))
       (R (tb4-fam-setup! 'fq_)))
  (tb4-have! `(FORALL tqdy_ (IMPLIES (IN tqdy_ fq_) (IN (,R tqdy_) ,sm)))
    (lambda () (let ((z (cadr (car (dk-peel!)))))
                 (tb4-ek! z)
                 (dk-cite! 'rank-one-op-bounded 'v 'w (list 'e z) (list 't_ (list 'e z)))
                 (dk-cite! 'rank-one-op-compact 'v 'w (list 'e z) (list 't_ (list 'e z)))
                 (dk-lam-b!)
                 (tb4-iff-bwd! 'compact-ops-membership 'v 'w (tb4-r1 z))
                 (dk-close-if-asm!))))
  (tb4-have! (list 'IN (list 'IDEN tb4-BG) sm)
    (lambda ()
      (subst (list '== (list 'IDEN tb4-BG) '(BOP-ZERO v w)))
      (dk-cite! 'bop-zero-compact 'v 'w)
      (tb4-iff-bwd! 'compact-ops-membership 'v 'w '(BOP-ZERO v w))
      (dk-close-if-asm!)))
  (tb4-have! `(FORALL tqdp_ (IMPLIES (IN tqdp_ ,sm) (FORALL tqdq_ (IMPLIES (IN tqdq_ ,sm) (IN ((OPR ,tb4-BG) tqdp_ tqdq_) ,sm)))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (ps (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) sm))) lk)))
             (p (car ps)) (q (cadr ps)))
        (tb4-iff-fwd! 'compact-ops-membership 'v 'w p)
        (tb4-iff-fwd! 'compact-ops-membership 'v 'w q)
        (subst (list '== (list 'OPR tb4-BG) '(BOP-VADD v w)))
        (subst (dk-cite! 'bop-vadd-value 'v 'w p q))
        (dk-cite! 'bop-sum-bounded 'v 'w p q)
        (dk-cite! 'compact-op-sum 'v 'w p q)
        (tb4-iff-bwd! 'compact-ops-membership 'v 'w (list 'BOP-SUM 'v 'w p q))
        (dk-close-if-asm!))))
  (dk-apply! (dk-cite! 'finsum-in-subset tb4-BG) sm 'fq_ R)
  (tb4-close!))))
(tb4-done! 'trunc-op-compact)

;;; trunc-op-bounded: T_F is bounded
(sp (make-wff (forall-guarded '(v w ix e t_ fq_) tb4-trunc-hyps (list 'IN (tb4-tr 'fq_) '(BOUNDED-OPS v w)))))
(dk-peel!)
(tb4-cite! 'trunc-op-compact 'v 'w 'ix 'e 't_ 'fq_)
(tb4-iff-fwd! 'compact-ops-membership 'v 'w (tb4-tr 'fq_))
(tb4-close!)
(tb4-done! 'trunc-op-bounded)

;;; ====================================================================
;;; trunc-op-basis-in / -out: T_F e_z = T e_z for z in F, = 0 for z in ix outside F
;;; ====================================================================
(define tb4-tb-hyps
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IS-ORTHONORMAL-FAMILY v ix e)
    (IN t_ (BOUNDED-OPS v w)) (IN fq_ SET) (IN (CARD fq_) NN) (SUBSET fq_ ix)))
;;; the orthonormal-family projections; returns the orthogonality clause
(define (tb4-onf!)
  (let ((onf '(IS-ORTHONORMAL-FAMILY v ix e)))
    (tb4-iff-fwd! 'is-orthonormal-family 'v 'ix 'e)
    (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'NOT))) "the orthogonality clause")))
;;; T_F(e_z) rewritten by op-finsum-apply on the goal; returns the vector-valued family ly
(define (tb4-apply-tr! z)
  (let* ((R (tb4-fam-setup! 'fq_))
         (ez (list 'e z))
         (e2 (dk-cite! 'op-finsum-apply 'v 'w 'fq_ R ez))
         (ly (caddr (caddr e2))))
    (subst (list '= (cadr e2) (caddr e2)))
    ly))
;;; ((ly k)) reduced and rewritten to <e_z | e_k> . T e_k ; k typed in ix
(define (tb4-ly-val! z k)
  (tb4-ek! k)
  (dk-cite! 'rank-one-op-fun 'v 'w (list 'e k) (list 't_ (list 'e k)))
  (dk-cite! 'cips-ip-type 'v (list 'e z) (list 'e k))
  (dk-cite! 'cips-act-type 'w (list '(IP v) (list 'e z) (list 'e k)) (list 't_ (list 'e k)))
  (dk-lam-b!)
  (subst (dk-cite! 'rank-one-op-apply 'v 'w (list 'e k) (list 't_ (list 'e k)) (list 'e z))))
;;; (ly k) typed in VEC w and the lambda typed in FUN(fq_, CARR WG)
(define (tb4-ly-type! ly z)
  (tb4-have! (list 'IN ly (list 'FUN 'fq_ (list 'CARR tb4-WG)))
    (lambda ()
      (subst (list '== (list 'CARR tb4-WG) '(VEC w)))
      (dk-lam-type!
        (lambda () (let ((k (dk-di-var!))) (tb4-ly-val! z k) (dk-close-if-asm!)))
        (lambda () (dk-close-if-asm!))))))
;;; z /= k, both in ix: (ly k) = IDEN WG
(define (tb4-ly-zero! orth z k)
  (tb4-ly-val! z k)
  (subst (dk-apply! orth z k))
  (dk-cite! 'cc-zero-in)
  (subst (dk-cite! 'cips-act-zero-scalar 'w (list 't_ (list 'e k))))
  (subst (list '== (list 'IDEN tb4-WG) '(VZERO w)))
  (tb4-close!))

(sp (make-wff (forall-guarded '(v w ix e t_ fq_ z_) (append tb4-tb-hyps '((IN z_ fq_)))
  (list '= (list (tb4-tr 'fq_) '(e z_)) '(t_ (e z_))))))
(dk-peel!)
(tb4-ag-setup!)
(tb4-try "basis-in" (lambda ()
(let* ((orth (tb4-onf!))
       (z 'z_))
  (tb4-ek! z)
  (let ((ly (tb4-apply-tr! z)))
    (tb4-ly-type! ly z)
    (tb4-have! (list 'FORALL 'tbj_ (list 'IMPLIES '(IN tbj_ fq_) (list 'IMPLIES '(NOT (= tbj_ z_)) (list '= (list ly 'tbj_) (list 'IDEN tb4-WG)))))
      (lambda ()
        (let* ((k (dk-di-var!)))
          (di)
          (tb4-ek! k)
          (tb4-have! (list 'NOT (list '= z k))
            (lambda ()
              (di)
              (let ((nk (dk-rewrite-h! (list 'NOT (list '= k z)) z k)))
                (tb4-have! (list '= k k) (lambda () (rfl)))
                (keep nk (list '= k k))
                (prop))))
          (tb4-ly-zero! orth z k))))
    (subst (tb4-cite! 'finsum-single-support tb4-WG 'fq_ ly z))
    (tb4-ly-val! z z)
    (let ((nc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'oni_) (not (dk-contains? h 'NOT)))) "the norm clause")))
      (subst (dk-apply! nc z)))
    (dk-cite! 'cips-act-one 'w '(t_ (e z_)))
    (subst '(= ((ACT w) 1 (t_ (e z_))) (t_ (e z_))))
    (tb4-close!)))))
(tb4-done! 'trunc-op-basis-in)

(sp (make-wff (forall-guarded '(v w ix e t_ fq_ z_) (append tb4-tb-hyps '((IN z_ ix) (NOT (IN z_ fq_))))
  (list '= (list (tb4-tr 'fq_) '(e z_)) '(VZERO w)))))
(dk-peel!)
(tb4-ag-setup!)
(tb4-try "basis-out" (lambda ()
(let* ((orth (tb4-onf!))
       (z 'z_))
  (tb4-ap! 'e 'ix '(VEC v) z)
  (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e z))
  (let ((ly (tb4-apply-tr! z)))
    (tb4-have! (list 'FORALL 'tbj_ (list 'IMPLIES '(IN tbj_ fq_) (list '= (list ly 'tbj_) (list 'IDEN tb4-WG))))
      (lambda ()
        (let* ((k (dk-di-var!)))
          (tb4-ek! k)
          (tb4-have! (list 'NOT (list '= z k))
            (lambda ()
              (di)
              (let ((nk (dk-rewrite-h! (list 'IN k 'fq_) k z)))
                (keep nk (list 'NOT (list 'IN z 'fq_)))
                (prop))))
          (tb4-ly-zero! orth z k))))
    (subst (tb4-cite! 'finsum-all-id-ptwise tb4-WG 'fq_ ly))
    (subst (list '== (list 'IDEN tb4-WG) '(VZERO w)))
    (tb4-close!)))))
(tb4-done! 'trunc-op-basis-out)

(define (tb4-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-cite! 'rr-pos-star-membership x)))
            (keep inst (list 'IN x 'RR) (list '<= 0 x))
            (prop))))))
(define (tb4-and0! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tb4-nn! y)                      ; ||y|| in RR, >= 0, ||y||^2 in RR, >= 0, in RPS
  (fact 'ip-norm-in-rr 'w y)
  (tb4-and0! (list 'IN (list 'IP-NORM 'w y) 'RR) (list 'IN (list 'IP-NORM 'w y) 'RR))
  (fact 'rr-mul-closed (list 'IP-NORM 'w y) (list 'IP-NORM 'w y))
  (fact 'ip-norm-nonneg 'w y)
  (fact 'rr-sq-nonneg (list 'IP-NORM 'w y))
  (tb4-rps-of-real! (list '* (list 'IP-NORM 'w y) (list 'IP-NORM 'w y))))
;;; f in FUN(dd, cod) in context: land (IN dd SET), (= (DOM f) dd), f in FUN(DOM f, cod), ESUM f in RPS
(define (tb4-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tb4-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (if (and (eq? cod 'RR-POS-STAR) (not (dk-asm? (list 'IN (list 'ESUM f) 'RR-POS-STAR))))
      (fact 'esum-in f)))

;;; ====================================================================
;;; hs-sum-trunc-tail: HS-SUM(T - T_F) is the tail of the HS family of T off F
;;; ====================================================================
(define tb4-A '(VNB-LAMBDA kqk_ ix (* (IP-NORM w (t_ (e kqk_))) (IP-NORM w (t_ (e kqk_))))))
(define (tb4-tail fq) (list 'VNB-LAMBDA 'tlz_ 'ix (list 'IF (list 'IN 'tlz_ fq) 0 (list tb4-A 'tlz_))))
(define (tb4-d fq) (list 'BOP-SUM 'v 'w 't_ (list 'BOP-NEG 'v 'w (tb4-tr fq))))
(define (tb4-ns y) (list '* (list 'IP-NORM 'w y) (list 'IP-NORM 'w y)))
(define (tb4-ns-rr! y)
  (fact 'ip-norm-in-rr 'w y)
  (tb4-and! (list 'IN (list 'IP-NORM 'w y) 'RR) (list 'IN (list 'IP-NORM 'w y) 'RR))
  (fact 'rr-mul-closed (list 'IP-NORM 'w y) (list 'IP-NORM 'w y)))
;;; with the hypotheses in context: D bounded, D, T_F in FUN(VEC v, VEC w); returns D
(define (tb4-d-setup! fq)
  (let ((tr (tb4-tr fq)) (d (tb4-d fq)))
    (tb4-cite! 'trunc-op-bounded 'v 'w 'ix 'e 't_ fq)
    (fact 'bop-fun 'v 'w tr)
    (fact 'bop-fun 'v 'w 't_)
    (tb4-cite! 'bop-neg-bounded 'v 'w tr)
    (tb4-cite! 'bop-sum-bounded 'v 'w 't_ (list 'BOP-NEG 'v 'w tr))
    (fact 'bop-fun 'v 'w d)
    d))
;;; D(e_z) rewritten on the goal to (t e_z) + -(T_F e_z)
(define (tb4-d-apply! fq y)
  (let ((tr (tb4-tr fq)))
    (fact 'bop-fun 'v 'w (list 'BOP-NEG 'v 'w tr))
    (subst (tb4-cite! 'bop-sum-apply 'v 'w 't_ (list 'BOP-NEG 'v 'w tr) y))
    (subst (tb4-cite! 'bop-neg-apply 'v 'w tr y))))

(sp (make-wff (forall-guarded '(v w ix e t_ fq_) tb4-tb-hyps
  (list '= (list 'HS-SUM 'v 'w 'ix 'e (tb4-d 'fq_)) (list 'ESUM (tb4-tail 'fq_))))))
(dk-peel!)
(tb4-try "tail" (lambda ()
(tb4-iff-fwd! 'is-orthonormal-family 'v 'ix 'e)
(fact 'fun-domain-in-set 'ix '(VEC v) 'e)
(let* ((d (tb4-d-setup! 'fq_))
       (tr (tb4-tr 'fq_))
       (hu (dk-cite! 'hs-sum-unfold 'v 'w 'ix 'e d))
       (ld (cadr (caddr hu)))
       (lt (tb4-tail 'fq_)))
  (subst hu)
  (tb4-have! (list 'IN ld '(FUN ix RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((z (dk-di-var!)))
                     (tb4-ap! 'e 'ix '(VEC v) z)
                     (tb4-ap! d '(VEC v) '(VEC w) (list 'e z))
                     (tb4-nn! (list d (list 'e z)))
                     (dk-close-if-asm!)))
        (lambda () (dk-close-if-asm!)))))
  (tb4-have! (list 'IN lt '(FUN ix RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda () (let* ((z (dk-di-var!)) (ift (cadr (dk-goal))))
                     (tb4-ap! 'e 'ix '(VEC v) z)
                     (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e z))
                     (tb4-nn! (list 't_ (list 'e z)))
                     (dk-case-if! ift
                       (lambda (tr? val)
                         (if tr?
                             (begin (tb4-have! '(IN 0 RR) (lambda () (arith)))
                                    (tb4-have! '(<= 0 0) (lambda () (arith)))
                                    (tb4-rps-of-real! 0)
                                    (dk-close-if-asm!))
                             (begin (if (not (dk-asm? (dk-goal))) (dk-lam-b!))
                                    (dk-close-if-asm!)))))))
        (lambda () (dk-close-if-asm!)))))
  (tb4-dom! lt 'ix 'RR-POS-STAR)
  (let ((ext (dk-fun-ext! ld lt 'ix 'RR-POS-STAR #f #f
               (lambda (z) ((dk-lane (lambda ()
                 (tb4-ap! 'e 'ix '(VEC v) z)
                 (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e z))
                 (tb4-ap! d '(VEC v) '(VEC w) (list 'e z))
                 (tb4-ap! tr '(VEC v) '(VEC w) (list 'e z))
                 (tb4-ns-rr! (list d (list 'e z)))
                 (tb4-ns-rr! (list 't_ (list 'e z)))
                 (dk-lam-b!)
                 (let ((ift (caddr (dk-goal))))
                   (tb4-d-apply! 'fq_ (list 'e z))
                   (dk-case-if! ift
                     (lambda (tr? val)
                       (if tr?
                           (begin
                             (subst (tb4-cite! 'trunc-op-basis-in 'v 'w 'ix 'e 't_ 'fq_ z))
                             (subst (dk-cite! 'cips-vadd-vneg 'w (list 't_ (list 'e z))))
                             (subst (dk-cite! 'ip-norm-zero 'w))
                             (dk-close-if! (lambda () #t) (lambda () (arith))))
                           (begin
                             (subst (tb4-cite! 'trunc-op-basis-out 'v 'w 'ix 'e 't_ 'fq_ z))
                             (subst (dk-cite! 'cips-vneg-vzero 'w))
                             (subst (dk-cite! 'cips-vadd-vzero-right 'w (list 't_ (list 'e z))))
                             (tb4-close!)))))))))))))
    (if (and (pair? ext) (pair? (dk-open-leaves)) (tb4-open?)) (begin (subst ext) (tb4-close!)))))))
(tb4-done! 'hs-sum-trunc-tail)

;;; ====================================================================
;;; hs-trunc-approx: for T with finite HS sum and eps > 0 there is a finite F with
;;; ||T x - T_F x|| <= eps on the unit ball
;;; ====================================================================
(define (tb4-approx fq eps)
  (list 'FORALL 'xq_ (list 'IMPLIES '(IN xq_ (VEC v)) (list 'IMPLIES '(<= (IP-NORM v xq_) 1)
    (list '<= (list 'IP-NORM 'w (list '(VADD w) '(t_ xq_) (list '(VNEG w) (list (tb4-tr fq) 'xq_)))) eps)))))
(define (tb4-fin-ok fq eps)
  (list 'AND (list 'IN fq 'SET) (list 'AND (list 'IN (list 'CARD fq) 'NN) (list 'AND (list 'SUBSET fq 'ix) (tb4-approx fq eps)))))

(sp (make-wff (forall-guarded '(v w t_ ix e eps)
  '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IS-ORTHONORMAL-BASIS v ix e)
    (IN (HS-SUM v w ix e t_) RR) (POS-RR eps))
  (list 'FORSOME 'fq_ (tb4-fin-ok 'fq_ 'eps)))))
(dk-peel!)
(tb4-try "approx" (lambda ()
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(dk-project! '(IN e (FUN ix (VEC v))) 'is-orthonormal-family '(IS-ORTHONORMAL-FAMILY v ix e))
(fact 'fun-domain-in-set 'ix '(VEC v) 'e)
(fact 'bop-fun 'v 'w 't_)
(fact 'rr-pos-rr-in-rr 'eps)
(fact 'rr-lt-of-pos-rr 'eps)
(let* ((dl '(* eps eps))
       (hu (dk-cite! 'hs-sum-unfold 'v 'w 'ix 'e 't_)))
  (tb4-have! (list 'IN tb4-A '(FUN ix RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((z (dk-di-var!)))
                     (tb4-ap! 'e 'ix '(VEC v) z)
                     (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e z))
                     (tb4-nn! (list 't_ (list 'e z)))
                     (dk-close-if-asm!)))
        (lambda () (dk-close-if-asm!)))))
  (dk-rewrite-h! '(IN (HS-SUM v w ix e t_) RR) '(HS-SUM v w ix e t_) (caddr hu))
  ;; dl = eps^2 > 0
  (tb4-and! '(IN eps RR) '(IN eps RR))
  (fact 'rr-mul-closed 'eps 'eps)
  (tb4-cite! 'rr-mul-pos 'eps 'eps)
  (tb4-cite! 'rr-pos-rr-of-lt dl)
  (let* ((ts (tb4-cite! 'esum-tail-small 'ix tb4-A))
         (ex (dk-apply! ts dl))
         (fq (dk-skolem! ex #t)))
    (let* ((tl (tb4-cite! 'hs-sum-trunc-tail 'v 'w 'ix 'e 't_ fq))
           (d (tb4-d-setup! fq))
           (tr (tb4-tr fq))
           (hsd (list 'HS-SUM 'v 'w 'ix 'e d))
           (jf (let* ((ex1 (tb4-cite! 'onb-exists 'w))
                      (jx (dk-skolem! ex1))
                      (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'IS-ORTHONORMAL-BASIS)
                                                     (memq jx (free-vars h)))) "the basis existential"))
                      (f (dk-skolem! ex2)))
                 (cons jx f))))
      ;; HS-SUM(D) < dl, and so HS-SUM(D) is real
      (tb4-have! (list '< hsd dl) (lambda () (subst tl) (tb4-close!)))
      (tb4-cite! 'hs-sum-in-rps 'v 'w d 'ix 'e)
      (let ((iff (dk-cite! '< hsd dl)))
        (tb4-have! (list '<= hsd dl) (lambda () (keep iff (list '< hsd dl)) (prop))))
      (tb4-and! (list 'IN hsd 'RR-POS-STAR) (list 'IN dl 'RR))
      (tb4-cite! 'rr-pos-star-le-real-in-rr hsd dl)
      (fact 'rr-pos-star-nonneg hsd)
      (tb4-have! (tb4-approx fq 'eps)
        (lambda ()
          (let* ((x (dk-di-var!))
                 (nx (list 'IP-NORM 'v x))
                 (nx2 (list '* nx nx))
                 (tx (list 't_ x))
                 (trx (list tr x))
                 (y (list '(VADD w) tx (list '(VNEG w) trx)))
                 (ny (list 'IP-NORM 'w y)))
            (di)
            (tb4-ap! 't_ '(VEC v) '(VEC w) x)
            (fact 'bop-fun 'v 'w tr)
            (tb4-ap! tr '(VEC v) '(VEC w) x)
            (tb4-ap! d '(VEC v) '(VEC w) x)
            (dk-cite! 'cips-vneg-type 'w trx)
            (dk-cite! 'cips-vadd-type 'w tx (list '(VNEG w) trx))
            (fact 'ip-norm-in-rr 'v x)
            (fact 'ip-norm-nonneg 'v x)
            (tb4-and! (list 'IN nx 'RR) (list 'IN nx 'RR))
            (fact 'rr-mul-closed nx nx)
            (fact 'rr-sq-nonneg nx)
            (tb4-nn! y)
            (tb4-nn! (list d x))
            (fact 'bop-fun 'v 'w (list 'BOP-NEG 'v 'w tr))
            (let* ((vb (tb4-cite! 'hs-vector-bound 'v 'w d 'ix 'e (car jf) (cdr jf) x))
                   (er (begin (tb4-and! (list 'IN nx2 'RR) (list '<= 0 nx2) (list 'IN hsd 'RR) (list '<= 0 hsd))
                              (tb4-cite! 'etimes-real-defined nx2 hsd)))
                   (bt (dk-cite! 'bintimes-apply nx2 hsd))
                   (v1 (dk-rewrite-h! vb (cadr er) (caddr er)))
                   (v2 (dk-rewrite-h! v1 (cadr bt) (caddr bt)))
                   (sa (tb4-cite! 'bop-sum-apply 'v 'w 't_ (list 'BOP-NEG 'v 'w tr) x))
                   (v3 (dk-rewrite-h! v2 (cadr sa) (caddr sa)))
                   (na (tb4-cite! 'bop-neg-apply 'v 'w tr x))
                   (v4 (dk-rewrite-h! v3 (cadr na) (caddr na))))
              ;; ||y||^2 <= nx2 * hsd <= hsd < dl
              (tb4-have! '(IN 1 RR) (lambda () (arith)))
              (dk-cite! 'rr-mul-le-right nx 1 nx)
              (tb4-have! (list '<= nx2 1) (lambda () (dk-ineq! (list '<= nx2 (list '* 1 nx)) (list '<= nx 1))))
              (dk-cite! 'rr-mul-le-right nx2 1 hsd)
              (tb4-and! (list 'IN nx2 'RR) (list 'IN hsd 'RR))
              (fact 'rr-mul-closed nx2 hsd)
              (tb4-have! (list '<= (list '* ny ny) dl)
                (lambda () (dk-ineq! v4 (list '<= (list '* nx2 hsd) (list '* 1 hsd)) (list '<= hsd dl))))
              (fact 'ip-norm-nonneg 'w y)
              (tb4-and! (list 'IN ny 'RR) (list 'IN 'eps 'RR))
              (tb4-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
              (tb4-cite! 'rr-square-le-imp-le ny 'eps)
              (tb4-close!)))))
      (ew fq)
      (dk-conj-close! dk-ass!))))))
(tb4-done! 'hs-trunc-approx)

;;; ====================================================================
;;; hs-op-compact (Cor 3.39): a Hilbert-Schmidt operator is compact
;;; ====================================================================
(define (tb4-trg ee fq)
  (list 'FINSUM tb4-BG (list 'VNB-LAMBDA 'tbk_ fq (list 'RANK-ONE-OP 'v 'w (list ee 'tbk_) (list 't_ (list ee 'tbk_)))) fq))
(define (tb4-approxg ee fq eps)
  (list 'FORALL 'xq_ (list 'IMPLIES '(IN xq_ (VEC v)) (list 'IMPLIES '(<= (IP-NORM v xq_) 1)
    (list '<= (list 'IP-NORM 'w (list '(VADD w) '(t_ xq_) (list '(VNEG w) (list (tb4-trg ee fq) 'xq_)))) eps)))))
(define (tb4-fin-okg ii ee fq eps)
  (list 'AND (list 'IN fq 'SET) (list 'AND (list 'IN (list 'CARD fq) 'NN) (list 'AND (list 'SUBSET fq ii) (tb4-approxg ee fq eps)))))
(define (tb4-subs-of s d) (list 'FORALL 'tbz_ (list 'IMPLIES (list 'IN 'tbz_ s) (list 'IN 'tbz_ d))))
(define (tb4-ctx f) (or (dk-ctx-form f) (error "tb4-ctx: not in context" (expression->string f))))
(define (tb4-reps k) (list 'RECIP (list '+ k 1)))

(sp (make-wff (forall-guarded '(v w t_)
  '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w) (IS-HILBERT-SCHMIDT v w t_))
  '(IS-COMPACT-OP v w t_))))
(dk-peel!)
(tb4-try "hs-compact" (lambda ()
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tb4-have! '(IN t_ (BOUNDED-OPS v w)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v w)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v w t_))))
(fact 'bop-fun 'v 'w 't_)
(let* ((hs '(IS-HILBERT-SCHMIDT v w t_))
       (opened (dk-landed-1 (lambda () (mac-h 'IS-HILBERT-SCHMIDT hs))))
       (sp1 (dk-split-all! (list opened)))
       (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'HS-SUM) (dk-contains? h 't_))) "the HS witness"))
       (i0 (dk-skolem! ex))
       (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'HS-SUM) (memq i0 (free-vars h)))) "the HS basis"))
       (e0 (dk-skolem! ex2 #t))
       (pw (list 'POWER i0))
       (fam (list 'VNB-LAMBDA 'tbn_ 'NN (list 'SEP 'tbf_ pw (tb4-fin-okg i0 e0 'tbf_ (tb4-reps 'tbn_)))))
       (rr (dk-cite! 'rmm-nn-choice pw fam)))
  (fact 'power-set i0)
  ;; for each k a finite F with ||T - T_F|| <= 1/(k+1) on the unit ball
  (tb4-have! (cadr rr)
    (lambda ()
      (let* ((k (dk-di-var!))
             (rk (tb4-reps k)))
        (tb4-cite! 'nn-recip-succ-pos k)
        (let* ((ap (tb4-cite! 'hs-trunc-approx 'v 'w 't_ i0 e0 rk))
               (fq (dk-skolem! ap #t)))
          (ew fq)
          (tb4-have! (tb4-subs-of fq i0) (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd fq i0 z) (tb4-close!))))
          (tb4-cite! 'power-mem-intro i0 fq)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    (#t (dk-lam-b!)
                        (in-sep! (lambda () (tb4-close!))
                                 (lambda () (dk-conj-close! dk-ass!)))))))))))
  (let* ((ch (tb4-det! rr))
         (g (dk-skolem! ch #t))
         (gin (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h g) (dk-contains? h 'SEP))) "g(k) in fam(k)"))
         (gk! (lambda (n)                ; land the properties of g(n)
                (let ((m (dk-apply! gin n)))
                  (dk-lam-b-h! m)
                  (let ((m2 (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (list g n)) (dk-contains? h 'SEP))) "g(n) in sep")))
                    (sep-me m2)
                    (dk-split-all!)))))
         (tk (list 'VNB-LAMBDA 'tbm_ 'NN (tb4-trg e0 (list g 'tbm_)))))
    (tb4-have! (list 'IN tk '(FUN NN (BOUNDED-OPS v w)))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((n (dk-di-var!)))
                       (gk! n)
                       (tb4-cite! 'trunc-op-bounded 'v 'w i0 e0 't_ (list g n))
                       (dk-close-if-asm!)))
          (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
    (tb4-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-COMPACT-OP 'v 'w (list tk 'k))))
      (lambda ()
        (let ((n (dk-di-var!)))
          (gk! n)
          (dk-lam-b!)
          (tb4-cite! 'trunc-op-compact 'v 'w i0 e0 't_ (list g n))
          (tb4-iff-fwd! 'compact-ops-membership 'v 'w (tb4-trg e0 (list g n)))
          (tb4-close!))))
    (let ((cl (dk-cite! 'compact-op-norm-limit 'v 'w 't_ tk)))
      (tb4-have! (cadr cl)
        (lambda ()
          (let ((eps (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
            (di)
            (fact 'rr-pos-rr-in-rr eps)
            (let* ((sm (tb4-cite! 'nn-recip-succ-small eps))
                   (n (dk-skolem! sm #t))
                   (rk (tb4-reps n)))
              (tb4-cite! 'nn-recip-succ-pos n)
              (fact 'rr-pos-rr-in-rr rk)
              (gk! n)
              (ew n)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((x (dk-di-var!)))
                        (di)
                        (let ((est (dk-apply! (tb4-ctx (tb4-approxg e0 (list g n) rk)) x)))
                          (dk-lam-b!)
                          (let* ((tr (tb4-trg e0 (list g n)))
                                 (y (list '(VADD w) (list 't_ x) (list '(VNEG w) (list tr x)))))
                            (tb4-cite! 'trunc-op-bounded 'v 'w i0 e0 't_ (list g n))
                            (fact 'bop-fun 'v 'w tr)
                            (tb4-ap! tr '(VEC v) '(VEC w) x)
                            (tb4-ap! 't_ '(VEC v) '(VEC w) x)
                            (dk-cite! 'cips-vneg-type 'w (list tr x))
                            (dk-cite! 'cips-vadd-type 'w (list 't_ x) (list '(VNEG w) (list tr x)))
                            (fact 'ip-norm-in-rr 'w y)
                            (dk-ineq! est (list (quote <) rk eps))))))))))))
      (tb4-det! cl)
      (tb4-close!))))))
(tb4-done! 'hs-op-compact)

;;; ====================================================================
;;; hs-sum-product (the isometry step of Prop 3.38): ||T||_HS^2 is the ESUM over ix x jx of
;;; |<T e_i | f_j>|^2 (esum-cartesian + Parseval in w)
;;; ====================================================================
(define tb4-G '(VNB-LAMBDA tbi_ ix (VNB-LAMBDA onk_ jx
                 (* (MAGNITUDE ((IP w) (t_ (e tbi_)) (f onk_))) (MAGNITUDE ((IP w) (t_ (e tbi_)) (f onk_)))))))
(define tb4-HH '(VNB-LAMBDA tbw_ (CARTESIAN ix jx)
                  (* (MAGNITUDE ((IP w) (t_ (e (NTH 1 tbw_))) (f (NTH 2 tbw_))))
                     (MAGNITUDE ((IP w) (t_ (e (NTH 1 tbw_))) (f (NTH 2 tbw_)))))))
(define (tb4-ms z) (list '* (list 'MAGNITUDE z) (list 'MAGNITUDE z)))
(define (tb4-ms-type! z)
  (let ((m (list 'MAGNITUDE z)))
    (fact 'cc-magnitude-closed z)
    (tb4-and! (list 'IN m 'RR) (list 'IN m 'RR))
    (fact 'rr-mul-closed m m)
    (fact 'rr-sq-nonneg m)
    (tb4-rps-of-real! (tb4-ms z))))
(define (tb4-pt! i j)
  (tb4-ap! 'e 'ix '(VEC v) i)
  (tb4-ap! 't_ '(VEC v) '(VEC w) (list 'e i))
  (tb4-ap! 'f 'jx '(VEC w) j)
  (fact 'cips-ip-type 'w (list 't_ (list 'e i)) (list 'f j))
  (tb4-ms-type! (list '(IP w) (list 't_ (list 'e i)) (list 'f j))))
(define (tb4-nth-fix!)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (< n 8)
          (begin (quietly (lambda () (nth-r)))
                 (if (and (pair? (dk-open-leaves)) (not (equal? (dk-goal) g))) (loop (+ n 1))))))))

(sp (make-wff (forall-guarded '(v w t_ ix e jx f)
  '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IS-ORTHONORMAL-BASIS v ix e)
    (IS-ORTHONORMAL-BASIS w jx f))
  (list '= '(HS-SUM v w ix e t_) (list 'ESUM tb4-HH)))))
(dk-peel!)
(tb4-try "hs-product" (lambda ()
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(for-each (lambda (sp3)
            (let ((vv (car sp3)) (ii (cadr sp3)) (ee (caddr sp3)))
              (dk-project! (list 'IS-ORTHONORMAL-FAMILY vv ii ee) 'is-orthonormal-basis (list 'IS-ORTHONORMAL-BASIS vv ii ee))
              (dk-project! (list 'IN ee (list 'FUN ii (list 'VEC vv))) 'is-orthonormal-family (list 'IS-ORTHONORMAL-FAMILY vv ii ee))
              (fact 'fun-domain-in-set ii (list 'VEC vv) ee)))
          '((v ix e) (w jx f)))
(fact 'bop-fun 'v 'w 't_)
(tb4-have! (list 'IN tb4-G '(FUN ix (FUN jx RR-POS-STAR)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((i (dk-di-var!)))
          (dk-lam-type!
