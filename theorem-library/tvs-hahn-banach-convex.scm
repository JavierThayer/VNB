;;; glb helpers
(define (hbc-glb! z)
  (hbc-vtype! z)
  (if (not (dk-asm? (list 'IN (hbc-I z) 'RR)))
      (dk-split! (dk-cite! 'homog-set-glb 'm 'p z)))
  (cons (dk-ctx-form (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (hbc-T z)) (list '<= (hbc-I z) 'lbw_))))
        (dk-ctx-form (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR)
                       (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (hbc-T z)) '(<= lbb_ lbw_)))
                             (list '<= 'lbb_ (hbc-I z))))))))
(define (hbc-glb-le! z b lb!)
  (let ((g (cdr (hbc-glb! z)))
        (lbf (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (hbc-T z)) (list '<= b 'lbw_)))))
    (hbc-real! b)
    (dk-have! lbf (lambda () (let ((w (dk-di-var!))) (lb! w))))
    (dk-apply! g b)))
(define (hbc-inf-le! z w)
  (dk-apply! (car (hbc-glb! z)) w))
(define (hbc-pos! z w)   ; w in T(z): land w in RR
  (if (not (dk-asm? (list 'IN w 'RR)))
      (dk-split! (dk-cite! 'homog-set-elim 'm 'p z w))))

(sp (make-wff (hbc-st '(x) (list (list 'IN 'x hbc-V)) (list '<= (hbc-I 'x) '(p x)))))
(dk-peel!)
(dk-cite! 'homog-p-in-set 'm 'p 'x)
(hbc-inf-le! 'x '(p x))
(ass)
(hbc-qed! 'homog-inf-le-p)

(sp (make-wff (hbc-st '(x) (list (list 'IN 'x hbc-V)) (list '<= 0 (hbc-I 'x)))))
(dk-peel!)
(hbc-real! 0)
(hbc-glb-le! 'x 0 (lambda (w) (dk-cite! 'homog-elem-nonneg 'm 'p 'x w) (ass)))
(ass)
(hbc-qed! 'homog-inf-nonneg)

;;; =====================================================================
;;; (2) q IS BELOW p, ABOVE f, AND SUBLINEAR
;;; =====================================================================
(define hbc-dom '(FORALL dmz_ (IMPLIES (IN dmz_ s) (<= (f dmz_) (p dmz_)))))
(sp (make-wff (hbc-st '(s f z) (list '(IS-SUBMODULE m s) '(IS-LINEAR-FUNCTIONAL-ON m s f) hbc-dom '(IN z s))
                      (list '<= '(f z) (hbc-I 'z)))))
(dk-peel!)
(hbc-parts!)
(dk-project! '(SUBSET s (VEC m)) 'is-submodule '(IS-SUBMODULE m s))
(dk-cite! 'subset-mem-fwd 's hbc-V 'z)
(dk-project! '(IN f (FUN s RR)) 'is-linear-functional-on '(IS-LINEAR-FUNCTIONAL-ON m s f))
(dk-cite! 'fun-apply-type-c 'f 's 'RR 'z)
(let ((homf (dk-project! '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ s) (= (f ((ACT m) r_ x_)) (* r_ (f x_)))))))
                         'is-linear-functional-on '(IS-LINEAR-FUNCTIONAL-ON m s f)))
      (actc (dk-project! '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL m))) (FORALL x_ (IMPLIES (IN x_ s) (IN ((ACT m) r_ x_) s)))))
                         'is-submodule '(IS-SUBMODULE m s))))
  (hbc-glb-le! 'z '(f z)
    (lambda (r)
      (let* ((t (hbc-elim! 'z r)) (tz (hbc-act t 'z)) (fz '(f z)))
        (dk-have! (list 'IN t '(CARR (SCAL m))) (lambda () (subst (list '= '(SCAL m) hbc-ring)) (mac 'rr-scalar-ring-carr) (ass)))
        (dk-apply! actc t 'z)
        (let* ((e (dk-apply! homf t 'z))
               (d (dk-apply! hbc-dom tz))
               (d2 (dk-rewrite-h! d (list 'f tz) (list '* t fz)))
               (tr (list '* t r)))
          (hbc-real! (list 'p tz)) (hbc-real! tr) (hbc-real! (list '* t fz))
          (dk-have! (list '<= (list '* fz t) (list '* r t))
            (lambda ()
              (subst (hbc-eq! (list '* fz t) (list '* t fz)))
              (subst (hbc-eq! (list '* r t) tr))
              (dk-ineq! d2 (list '<= (list 'p tz) tr) (list 'IN (list '* t fz) 'RR) (list 'IN (list 'p tz) 'RR) (list 'IN tr 'RR))))
          (dk-cite! 'rr-mul-le-cancel-pos fz t r)
          (ass)))))
  (ass))
(hbc-qed! 'homog-minorant-dominates)

;; every positive real is in T(0)
(sp (make-wff (hbc-st '(r) '((IN r RR) (< 0 r)) (list 'IN 'r (hbc-T hbc-z)))))
(dk-peel!)
(hbc-parts!)
(let* ((p0 (list 'p hbc-z)) (c (list '+ p0 1)))
  (hbc-pnn! hbc-z)
  (hbc-real! p0) (hbc-real! c)
  (dk-have! (list '< 0 c) (lambda () (dk-ineq! (list '<= 0 p0) (list 'IN p0 'RR))))
  (let* ((q (hbc-recip! 'r)) (t (list '* c q)))
    (hbc-real! t)
    (dk-cite! 'mink-rr-mul-pos c q)
    (dk-have! (list '<= (list 'p (hbc-act t hbc-z)) (list '* t 'r))
      (lambda ()
        (subst (dk-cite! 'rmod-act-vzero 'm t))
        (subst (hbc-eq! (list '* t 'r) (list '* c (list '* 'r q))))
        (subst (list '= (list '* 'r q) 1))
        (subst (hbc-eq! (list '* c 1) c))
        (dk-ineq! (list 'IN p0 'RR))))
    (dk-cite! 'homog-set-intro 'm 'p hbc-z 'r t)
    (ass)))
(hbc-qed! 'homog-set-zero)

(sp (make-wff (hbc-st '() '() (list '= (hbc-I hbc-z) 0))))
(dk-peel!)
(hbc-parts!)
(let ((p0 (hbc-I hbc-z)))
  (hbc-glb! hbc-z)
  (dk-cite! 'homog-inf-nonneg 'm 'p hbc-z)
  (dk-have! (list 'FORALL 'd_ (list 'IMPLIES '(POS-RR d_) (list '<= p0 '(+ 0 d_))))
    (lambda ()
      (dk-peel!)
      (dk-cite! 'rr-pos-rr-in-rr 'd_)
      (dk-cite! 'rr-lt-of-pos-rr 'd_)
      (dk-cite! 'homog-set-zero 'm 'p 'd_)
      (let ((h (hbc-inf-le! hbc-z 'd_)))
        (dk-ineq! h (list 'IN p0 'RR) '(IN d_ RR)))))
  (dk-cite! 'rr-zero-in)
  (dk-cite! 'rr-le-of-le-add-all-pos p0 0)
  (hbc-and! (list 'IN p0 'RR) '(IN 0 RR))
  (hbc-and! (list '<= p0 0) (list '<= 0 p0))
  (dk-cite! 'rr-leq-antisymmetric p0 0)
  (ass))
(hbc-qed! 'homog-inf-zero)

;; c > 0:  c T(x) lies in T(c x), and recip(c) T(c x) lies in T(x)
(sp (make-wff (hbc-st '(x c r) (list (list 'IN 'x hbc-V) '(IN c RR) '(< 0 c) (list 'IN 'r (hbc-T 'x)))
                      (list 'IN '(* c r) (hbc-T (hbc-act 'c 'x))))))
(dk-peel!)
(hbc-parts!)
(let* ((t (hbc-elim! 'x 'r)) (qc (hbc-recip! 'c)) (t2 (list '* t qc)) (cx (hbc-act 'c 'x)))
  (hbc-real! t2) (hbc-real! '(* c r))
  (dk-cite! 'mink-rr-mul-pos t qc)
  (dk-have! (list '<= (list 'p (hbc-act t2 cx)) (list '* t2 '(* c r)))
    (lambda ()
      (hbc-subst-rev! (dk-cite! 'rmod-act-mul 'm t2 'c 'x))
      (subst (hbc-eq! (list '* t2 'c) (list '* t (list '* 'c qc))))
      (subst (hbc-eq! (list '* t2 '(* c r)) (list '* (list '* t 'r) (list '* 'c qc))))
      (subst (list '= (list '* 'c qc) 1))
      (subst (hbc-eq! (list '* t 1) t))
      (subst (hbc-eq! (list '* (list '* t 'r) 1) (list '* t 'r)))
      (ass)))
  (dk-cite! 'homog-set-intro 'm 'p cx '(* c r) t2)
  (ass))
(hbc-qed! 'homog-set-scale)

(sp (make-wff (hbc-st '(x c r) (list (list 'IN 'x hbc-V) '(IN c RR) '(< 0 c) (list 'IN 'r (hbc-T (hbc-act 'c 'x))))
                      (list 'IN '(* (recip c) r) (hbc-T 'x)))))
(dk-peel!)
(hbc-parts!)
(let* ((cx (hbc-act 'c 'x)) (ty0 (hbc-vtype! cx)) (t (hbc-elim! cx 'r)) (qc (hbc-recip! 'c)) (t2 (list '* t 'c)))
  (subst (list '= '(recip c) qc))
  (hbc-real! t2) (hbc-real! (list '* qc 'r))
  (dk-cite! 'mink-rr-mul-pos t 'c)
  (dk-have! (list '<= (list 'p (hbc-act t2 'x)) (list '* t2 (list '* qc 'r)))
    (lambda ()
      (subst (dk-cite! 'rmod-act-mul 'm t 'c 'x))
      (subst (hbc-eq! (list '* t2 (list '* qc 'r)) (list '* (list '* t 'r) (list '* 'c qc))))
      (subst (list '= (list '* 'c qc) 1))
      (subst (hbc-eq! (list '* (list '* t 'r) 1) (list '* t 'r)))
      (ass)))
  (dk-cite! 'homog-set-intro 'm 'p 'x (list '* qc 'r) t2)
  (ass))
(hbc-qed! 'homog-set-unscale)

(sp (make-wff (hbc-st '(x c) (list (list 'IN 'x hbc-V) '(IN c RR) '(< 0 c))
                      (list '= (hbc-I (hbc-act 'c 'x)) (list '* 'c (hbc-I 'x))))))
(dk-peel!)
(hbc-parts!)
(let* ((cx (hbc-act 'c 'x)) (pq (hbc-I cx)) (pa (hbc-I 'x)) (rc '(recip c)))
  (hbc-glb! cx) (hbc-glb! 'x)
  (hbc-nz! 'c)
  (hbc-real! rc)
  (dk-cite! 'rr-recip-pos 'c)
  (hbc-glb-le! 'x (list '* rc pq)
    (lambda (r)
      (hbc-pos! 'x r)
      (dk-cite! 'homog-set-scale 'm 'p 'x 'c r)
      (hbc-inf-le! cx (list '* 'c r))
      (dk-cite! 'mink-rr-div-ge r pq 'c)
      (ass)))
  (dk-cite! 'mink-rr-ge-div pa pq 'c)
  (let ((ca (list '* 'c pa)))
    (hbc-glb-le! cx ca
      (lambda (sv)
        (hbc-vtype! cx)
        (hbc-pos! cx sv)
        (dk-cite! 'homog-set-unscale 'm 'p 'x 'c sv)
        (hbc-inf-le! 'x (list '* rc sv))
        (dk-cite! 'mink-rr-le-div pa sv 'c)
        (ass)))
    (hbc-and! (list 'IN pq 'RR) (list 'IN ca 'RR))
    (hbc-and! (list '<= pq ca) (list '<= ca pq))
    (dk-cite! 'rr-leq-antisymmetric pq ca)
    (ass)))
(hbc-qed! 'homog-inf-scale)

;; r in T(x), r' in T(y)  =>  r + r' in T(x + y): convexity with theta = t' / (t + t')
(sp (make-wff (hbc-st '(x y r r2) (list (list 'IN 'x hbc-V) (list 'IN 'y hbc-V) (list 'IN 'r (hbc-T 'x)) (list 'IN 'r2 (hbc-T 'y)))
                      (list 'IN '(+ r r2) (hbc-T (hbc-add 'x 'y))))))
(dk-peel!)
(hbc-parts!)
(let* ((t (hbc-elim! 'x 'r)) (t2 (hbc-elim! 'y 'r2))
       (s (list '+ t t2)))
  (hbc-real! s)
  (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 t) (list '< 0 t2) (list 'IN t 'RR) (list 'IN t2 'RR))))
  (let* ((k (hbc-recip! s))
         (th (list '* t2 k)) (om (list '- 1 th)) (u (list '* th t))
         (tx (hbc-act t 'x)) (ty (hbc-act t2 'y)) (xy (hbc-add 'x 'y)))
    (for-each hbc-real! (list th om u (list '* t k) (list '* t 'r) (list '* t2 'r2) (list 'p tx) (list 'p ty)))
    (dk-have! (list '= om (list '* t k)) (lambda () (subst (list '= 1 (list '* s k))) (crs)))
    (dk-have! (list '= (list '* om t2) u) (lambda () (subst (list '= om (list '* t k))) (crs)))
    (dk-cite! 'mink-rr-mul-pos t2 k)
    (dk-cite! 'mink-rr-mul-pos t k)
    (dk-cite! 'mink-rr-mul-pos th t)
    (dk-have! (list '<= 0 th) (lambda () (dk-ineq! (list '< 0 th) (list 'IN th 'RR))))
    (dk-have! (list '<= 0 om) (lambda () (subst (list '= om (list '* t k))) (dk-ineq! (list '< 0 (list '* t k)) (list 'IN (list '* t k) 'RR))))
    (dk-have! (list '<= th 1) (lambda () (dk-ineq! (list '<= 0 om) (list 'IN th 'RR))))
    (hbc-vtype! tx) (hbc-vtype! ty)
    (let* ((c0 (dk-apply! hbc-cvx tx ty th))
           (ptx (list 'p tx)) (pty (list 'p ty))
           (b1 (dk-cite! 'mink-rr-scale-le ptx (list '* t 'r) th))
           (b2 (dk-cite! 'mink-rr-scale-le pty (list '* t2 'r2) om))
           (arg (cadr (cadr c0)))
           (lhs (list 'p arg)))
      (hbc-real! lhs)
      (for-each hbc-real! (list (list '* th ptx) (list '* om pty) (list '* th (list '* t 'r)) (list '* om (list '* t2 'r2))))
      (let* ((c1 (dk-cite! 'dual-rr-le-sum-of-bounds (list '* th ptx) (list '* om pty) lhs
                           (list '* th (list '* t 'r)) (list '* om (list '* t2 'r2))))
             (e1 (hbc-eq! (list '* th (list '* t 'r)) (list '* u 'r)))
             (c2 (dk-rewrite-h! c1 (list '* th (list '* t 'r)) (list '* u 'r)))
             (e2 (hbc-eq! (list '* om (list '* t2 'r2)) (list '* (list '* om t2) 'r2)))
             (c3 (dk-rewrite-h! c2 (list '* om (list '* t2 'r2)) (list '* (list '* om t2) 'r2)))
             (c4 (dk-rewrite-h! c3 (list '* om t2) u))
             (e3 (hbc-eq! (list '+ (list '* u 'r) (list '* u 'r2)) (list '* u '(+ r r2))))
             (c5 (dk-rewrite-h! c4 (list '+ (list '* u 'r) (list '* u 'r2)) (list '* u '(+ r r2))))
             ;; the argument is u.(x + y)
             (e4 (dk-have! (list '= arg (hbc-act u xy))
                   (lambda ()
                     (subst (dk-cite! 'rmod-act-distrib 'm u 'x 'y))
                     (hbc-subst-rev! (dk-cite! 'rmod-act-mul 'm th t 'x))
                     (hbc-subst-rev! (dk-cite! 'rmod-act-mul 'm om t2 'y))
                     (subst (list '= (list '* om t2) u))
                     (hbc-vtype! (hbc-add (hbc-act u 'x) (hbc-act u 'y)))
                     (rfl))))
             (c6 (dk-rewrite-h! c5 arg (hbc-act u xy))))
        (hbc-real! '(+ r r2))
        (dk-cite! 'homog-set-intro 'm 'p xy '(+ r r2) u)
        (ass)))))
(hbc-qed! 'homog-set-sum)

(sp (make-wff (hbc-st '(x y) (list (list 'IN 'x hbc-V) (list 'IN 'y hbc-V))
                      (list '<= (hbc-I (hbc-add 'x 'y)) (list '+ (hbc-I 'x) (hbc-I 'y))))))
(dk-peel!)
(hbc-parts!)
(let* ((xy (hbc-add 'x 'y)) (pp (hbc-I xy)) (pa (hbc-I 'x)) (pb (hbc-I 'y)))
  (hbc-glb! xy) (hbc-glb! 'x) (hbc-glb! 'y)
  (dk-have! (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (hbc-T 'y)) (list '<= (list '- pp 'sv_) pa)))
    (lambda ()
      (let ((sv (dk-di-var!)))
        (hbc-pos! 'y sv)
        (hbc-glb-le! 'x (list '- pp sv)
          (lambda (r)
            (hbc-pos! 'x r)
            (dk-cite! 'homog-set-sum 'm 'p 'x 'y r sv)
            (let ((h (hbc-inf-le! xy (list '+ r sv))))
              (dk-ineq! h (list 'IN pp 'RR) (list 'IN r 'RR) (list 'IN sv 'RR)))))
        (ass))))
  (let ((c1 (dk-ctx-form (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (hbc-T 'y)) (list '<= (list '- pp 'sv_) pa))))))
    (hbc-glb-le! 'y (list '- pp pa)
      (lambda (sv)
        (let ((h (dk-apply! c1 sv)))
          (hbc-pos! 'y sv)
          (dk-ineq! h (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN sv 'RR)))))
    (dk-ineq! (list '<= (list '- pp pa) pb) (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN pb 'RR))))
(hbc-qed! 'homog-inf-subadditive)

(define hbc-q '(HOMOG-MINORANT m p))
(define (hbc-qval! z)
  (hbc-vtype! z)
  (dk-cite! 'homog-value 'm 'p z)
  (subst (list '= (list hbc-q z) (hbc-I z))))

(sp (make-wff (hbc-st '() '() (list 'IS-SUBLINEAR 'm hbc-q))))
(dk-peel!)
(hbc-parts!)
(dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
(mac 'is-sublinear)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IN)
         (mac 'HOMOG-MINORANT)
         (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (hbc-glb! v) (ass))) (lambda () (ass))))
        (#t
         (dk-peel!)
         (let ((g2 (dk-goal)))
           (if (dk-head-is? g2 '<=)
               (let* ((xy (cadr (cadr g2))) (a (cadr xy)) (b (caddr xy)))
                 (for-each hbc-qval! (list xy a b))
                 (dk-cite! 'homog-inf-subadditive 'm 'p a b) (ass))
               (let* ((ax (cadr (cadr g2))) (c (cadr ax)) (z (caddr ax)))
                 (hbc-qval! ax) (hbc-qval! z)
                 (hbc-glb! z)
                 (use-em (list '= c 0)
                   (lambda ()
                     (subst (list '= c 0))
                     (subst (dk-cite! 'rmod-act-zero 'm z))
                     (subst (dk-cite! 'homog-inf-zero 'm 'p))
                     (subst (hbc-eq! (list '* 0 (hbc-I z)) 0))
                     (hbc-real! 0)
                     (rfl))
                   (lambda ()
                     (dk-cite! 'dual-rr-pos-of-nonneg-nonzero c)
                     (dk-cite! 'homog-inf-scale 'm 'p z c)
                     (ass))))))))))
  (dk-open-leaves))
(hbc-qed! 'homog-minorant-sublinear)

;;; =====================================================================
;;; (3) Cor 2.36
;;; =====================================================================
(sp (make-wff (hbc-st '(s f) (list '(IS-SUBMODULE m s) '(IS-LINEAR-FUNCTIONAL-ON m s f) hbc-dom)
   '(FORSOME ff (AND (IS-LINEAR-FUNCTIONAL-ON m (VEC m) ff)
                (AND (EXTENDS-ON s ff f)
                     (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (ff x_) (p x_))))))))))
(dk-peel!)
(hbc-parts!)
(dk-cite! 'homog-minorant-sublinear 'm 'p)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s) (list '<= '(f z_) (list hbc-q 'z_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-project! '(SUBSET s (VEC m)) 'is-submodule '(IS-SUBMODULE m s))
      (dk-cite! 'subset-mem-fwd 's hbc-V z)
      (hbc-qval! z)
      (dk-cite! 'homog-minorant-dominates 'm 'p 's 'f z)
      (ass))))
(let* ((ff (dk-skolem! (dk-cite! 'hbs-hahn-banach-sublinear 'm hbc-q 's 'f)))
       (ub (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ hbc-V) (list '<= (list ff 'x_) (list hbc-q 'x_)))))))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ hbc-V) (list '<= (list ff 'x_) '(p x_))))
    (lambda ()
      (let* ((x (dk-di-var!))
             (h1 (dk-apply! ub x)))
        (hbc-vtype! x)
        (dk-cite! 'homog-value 'm 'p x)
        (dk-rewrite-h! h1 (list hbc-q x) (hbc-I x))
        (dk-cite! 'homog-inf-le-p 'm 'p x)
        (dk-project! (list 'IN ff (list 'FUN hbc-V 'RR)) 'is-linear-functional-on (list 'IS-LINEAR-FUNCTIONAL-ON 'm hbc-V ff))
        (dk-cite! 'fun-apply-type-c ff hbc-V 'RR x)
        (hbc-real! (list 'p x)) (hbc-glb! x)
        (dk-ineq! (list '<= (list ff x) (hbc-I x)) (list '<= (hbc-I x) (list 'p x))
                  (list 'IN (list ff x) 'RR) (list 'IN (hbc-I x) 'RR) (list 'IN (list 'p x) 'RR)))))
  (ew ff)
  (dk-conj-close! (lambda () (ass))))
(hbc-qed! 'hahn-banach-convex)
