(define (hbc-T x) (list 'HOMOG-SET 'm 'p x))
(define (hbc-Tbody x) (list 'SEP 'hmr_ 'RR (list 'FORSOME 'hmt_ (list 'AND '(IN hmt_ RR) (list 'AND '(< 0 hmt_)
                         (list '<= (list 'p (list '(ACT m) 'hmt_ x)) '(* hmt_ hmr_)))))))
(define (hbc-I x) (list 'INF (hbc-T x)))

(sp (make-wff (forall-guarded '(m p x) '() (list '== (hbc-T 'x) (hbc-Tbody 'x)))))
(dk-peel!)
(mac 'HOMOG-SET)
(qrfl)
(hbc-qed! 'homog-set-unfold)

(sp (make-wff (forall-guarded '(m p x r t) (list '(IN r RR) '(IN t RR) '(< 0 t) (list '<= (list 'p (hbc-act 't 'x)) '(* t r)))
                              (list 'IN 'r (hbc-T 'x)))))
(dk-peel!)
(mac 'HOMOG-SET)
(in-sep! (lambda () (ass))
         (lambda () (ew 't) (dk-conj-close! (lambda () (ass)))))
(hbc-qed! 'homog-set-intro)

(sp (make-wff (forall-guarded '(m p x r) (list (list 'IN 'r (hbc-T 'x)))
   (list 'AND '(IN r RR) (list 'FORSOME 'hmt_ (list 'AND '(IN hmt_ RR) (list 'AND '(< 0 hmt_)
           (list '<= (list 'p (list '(ACT m) 'hmt_ 'x)) '(* hmt_ r)))))))))
(dk-peel!)
(let* ((h (dk-ctx-form (list 'IN 'r (hbc-T 'x))))
       (e (dk-cite! 'homog-set-unfold 'm 'p 'x))
       (h2 (dk-rewrite-h! h (hbc-T 'x) (hbc-Tbody 'x))))
  (sep-me h2)
  (dk-split-all!)
  (dk-conj-close! (lambda () (ass))))
(hbc-qed! 'homog-set-elim)

;; r in T(x): land r in RR and t with 0 < t, p(t.x) <= t r; return t
(define (hbc-elim! x r)
  (let ((c (dk-cite! 'homog-set-elim 'm 'p x r)))
    (dk-split! c)
    (let ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'hmt_) (dk-contains? f r))) (dk-asms))))
      (dk-skolem! ex))))

;; elements are nonnegative
(sp (make-wff (hbc-st '(x r) (list (list 'IN 'x hbc-V) (list 'IN 'r (hbc-T 'x))) '(<= 0 r))))
(dk-peel!)
(hbc-parts!)
(let* ((t (hbc-elim! 'x 'r)) (tx (hbc-act t 'x)) (tr (list '* t 'r)))
  (hbc-pnn! tx)
  (hbc-real! (list 'p tx)) (hbc-real! tr) (hbc-real! 0)
  (dk-have! (list '<= (list '* 0 t) (list '* 'r t))
    (lambda ()
      (subst (hbc-eq! (list '* 0 t) 0))
      (subst (hbc-eq! (list '* 'r t) tr))
      (dk-ineq! (list '<= 0 (list 'p tx)) (list '<= (list 'p tx) tr) (list 'IN (list 'p tx) 'RR) (list 'IN tr 'RR))))
  (dk-cite! 'rr-mul-le-cancel-pos 0 t 'r)
  (ass))
(hbc-qed! 'homog-elem-nonneg)

;; p(x) is in T(x)  (t = 1)
(sp (make-wff (hbc-st '(x) (list (list 'IN 'x hbc-V)) (list 'IN '(p x) (hbc-T 'x)))))
(dk-peel!)
(hbc-parts!)
(hbc-real! '(p x)) (hbc-real! 1)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-have! (list '<= (list 'p (hbc-act 1 'x)) '(* 1 (p x)))
  (lambda () (subst (dk-cite! 'rmod-act-one 'm 'x)) (subst (hbc-eq! '(* 1 (p x)) '(p x)))
             (dk-ineq! '(IN (p x) RR))))
(dk-cite! 'homog-set-intro 'm 'p 'x '(p x) 1)
(ass)
(hbc-qed! 'homog-p-in-set)

(define (hbc-glb-body s)
  (list 'AND (list 'IN (list 'INF s) 'RR)
   (list 'AND (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) (list '<= (list 'INF s) 'lbw_)))
              (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR) (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) '(<= lbb_ lbw_)))
                                                                (list '<= 'lbb_ (list 'INF s))))))))
(sp (make-wff (hbc-st '(z) (list (list 'IN 'z hbc-V)) (hbc-glb-body (hbc-T 'z)))))
(dk-peel!)
(hbc-parts!)
(let ((st (hbc-T 'z)))
  (dk-have! (list 'SUBSET st 'RR)
    (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-split! (dk-cite! 'homog-set-elim 'm 'p 'z w)) (ass))))
  (dk-cite! 'homog-p-in-set 'm 'p 'z)
  (dk-have! (list 'FORSOME 'x0 (list 'IN 'x0 st)) (lambda () (ew '(p z)) (ass)))
  (dk-cite! 'rr-zero-in)
  (dk-have! (list 'FORSOME 'bnd (list 'AND '(IN bnd RR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x st) '(<= bnd x)))))
    (lambda ()
      (ew 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((w (dk-di-var!)))
                (dk-cite! 'homog-elem-nonneg 'm 'p 'z w)
                (ass))
              (ass))))))
  (dk-cite! 'rr-inf-is-glb st)
  (ass))
(hbc-qed! 'homog-set-glb)

(sp (make-wff (forall-guarded '(m p z) (list (list 'IN 'z hbc-V))
   (list '== (list '(HOMOG-MINORANT m p) 'z) (hbc-I 'z)))))
(dk-peel!)
(mac 'HOMOG-MINORANT)
(dk-lam-b!)
(qrfl)
