;;; hbc.scm -- topological-vector-space.pdf Cor 2.36: Hahn-Banach for a convex dominating functional, by
;;; CITING the sublinear Hahn-Banach (hbs-hahn-banach-sublinear) -- no Zorn here.  Agent DUAL-FIX, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-hahn-banach-convex.scm.  Library: analysis.  Helper prefix: hbc-.
;;; Needs: structure-library/convex-functional (hbc-vocab.scm here), the INF vocabulary and rr-inf-is-glb
;;; (RA-BASICS), theorem-library/tvs-minkowski (rmod-*, mink-rr-*), theorem-library/dual-nvs
;;; (dual-rr-le-sum-of-bounds, dual-rr-pos-of-nonneg-nonzero), hahn-banach-sublinear.
;;;
;;; THE ROUTE (not the notes', which goes through 2.35 and 2.14 in E x R).  For a convex p >= 0 put
;;;     q(x) = inf { r : p(t x) <= t r for some t > 0 }   ( = inf over t > 0 of p(t x) / t ).
;;; q <= p (t = 1); q is positively homogeneous (the set for c x is c times the set for x) and subadditive
;;; (convexity with theta = t' / (t + t') puts r + r' in the set for x + y); q(0) = 0.  So q is sublinear,
;;; f <= q on F (f(t z) = t f(z) <= p(t z)), and the sublinear Hahn-Banach extends f below q <= p.

(define (hbc-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; HBC OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (hbc-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (hbc-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (hbc-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define hbc-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define hbc-V '(VEC m))
(define hbc-z '(VZERO m))
(define (hbc-act r x) (list '(ACT m) r x))
(define (hbc-add x y) (list '(VADD m) x y))
(define hbc-rmod (list '(IS-MODULE m) (list '= '(SCAL m) hbc-ring)))
(define hbc-cf '(IS-CONVEX-FUNCTIONAL m p))
(define hbc-H (append hbc-rmod (list hbc-cf)))
(define (hbc-st vars guards body) (forall-guarded (append '(m p) vars) (append hbc-H guards) body))

(define (hbc-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((and (pair? t) (= (length t) 2) (eq? (car t) 'p))
           (hbc-vtype! (cadr t)) (hbc-parts!) (dk-cite! 'fun-apply-type-c 'p hbc-V 'RR (cadr t)) ty)
          ((dk-head-is? t 'abs) (hbc-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (hbc-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (hbc-real! (cadr t)) (hbc-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((dk-head-is? t 'recip) (hbc-real! (cadr t))
           (hbc-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (dk-cite! 'rr-recip-closed (cadr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (hbc-real! (cadr t)) (hbc-real! (caddr t))
           (hbc-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))
(define (hbc-vtype! t)
  (let ((ty (list 'IN t hbc-V)))
    (cond ((dk-asm? ty) ty)
          ((equal? t hbc-z) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (hbc-real! (cadr t)) (hbc-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (hbc-vtype! (cadr t)) (hbc-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          (#t (error "hbc-vtype!: no typing for" t)))))
(define hbc-nonneg '(FORALL cfx_ (IMPLIES (IN cfx_ (VEC m)) (<= 0 (p cfx_)))))
(define hbc-cvx '(FORALL cfx_ (IMPLIES (IN cfx_ (VEC m)) (FORALL cfy_ (IMPLIES (IN cfy_ (VEC m))
   (FORALL cft_ (IMPLIES (IN cft_ RR) (IMPLIES (<= 0 cft_) (IMPLIES (<= cft_ 1)
     (<= (p ((VADD m) ((ACT m) cft_ cfx_) ((ACT m) (- 1 cft_) cfy_)))
         (+ (* cft_ (p cfx_)) (* (- 1 cft_) (p cfy_)))))))))))))
(define (hbc-parts!)
  (if (not (dk-asm? (list 'IN 'p (list 'FUN hbc-V 'RR))))
      (begin
        (dk-project! (list 'IN 'p (list 'FUN hbc-V 'RR)) 'is-convex-functional hbc-cf)
        (dk-project! hbc-nonneg 'is-convex-functional hbc-cf)
        (dk-project! hbc-cvx 'is-convex-functional hbc-cf))))
(define (hbc-pnn! x)   ; 0 <= p(x)
  (hbc-vtype! x) (hbc-parts!)
  (let ((f (list '<= 0 (list 'p x))))
    (if (not (dk-asm? f)) (dk-apply! hbc-nonneg x))
    f))
;; NOT (c = 0) from 0 < c
(define (hbc-nz! c)
  (let ((f (list 'NOT (list '= c 0))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (di)
            (dk-rewrite-h! (dk-ctx-form (list '< 0 c)) c 0)
            (dk-cite! 'rr-zero-in)
            (dk-cite! 'rr-lt-irrefl 0)
            (ai '(NOT (< 0 0))))))
    f))
;; name recip(c) for 0 < c: lands v in RR, 0 < v, c * v = 1; returns v
(define (hbc-recip! c)
  (hbc-nz! c)
  (hbc-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (dk-cite! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-inverse c)
  (dk-cite! 'rr-recip-pos c)
  (let ((v (dk-name! (list 'recip c))))
    (dk-have! (list '= (list '* c v) 1) (lambda () (subst (list '= v (list 'recip c))) (ass)))
    (dk-have! (list '< 0 v) (lambda () (subst (list '= v (list 'recip c))) (ass)))
    v))

;;; =====================================================================
