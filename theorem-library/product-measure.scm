                                (lambda (kv) (fk! kv) (pms-then-ass! (lambda () (fact 'sigma-algebra-inter-closed-2 pms-xy pms-ps (list fv kv) pms-r))))
                                (lambda (kv) (fk! kv) (fact 'sigma-algebra-inter-closed-2 pms-xy pms-ps (list fv kv) pms-r)
                                             (fact 'membership-implies-sethood (cut (list fv kv)) pms-ps))))
                          (gv (car gr)) (ge (cdr gr))
                          (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv)))
                          (bug (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
                          (lhs (cut tgt)))
                     (pms-retype! fv gc (list 'POWER pms-xy)
                       (lambda (x) (pms-project! (list 'IN x (list 'POWER pms-xy))
                                     (lambda () (sep-me (dk-ctx-form (list 'IN x gc))) (dk-split-all!)))))
                     (fact 'power-fun-union-closed pms-xy fv)
                     (pms-retype! fv gc pms-ps
                       (lambda (x) (pms-project! (list 'IN x pms-ps)
                                     (lambda () (sep-me (dk-ctx-form (list 'IN x gc))) (dk-split-all!)))))
                     (fact 'sigma-algebra-union-closed pms-xy pms-ps fv)
                     ;; g nondecreasing, each g(k) Fubini
                     (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'SUBSET (list gv 'pmn_) (list gv '(succ pmn_)))))
                       (lambda ()
                         (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                           (fact 'nn-succ-closed nv)
