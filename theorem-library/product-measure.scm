;;; the side lemma, both orientations
(define (pms-diff-side! o)
  (let* ((spec (pms-morient o))
         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2))
         (imeas (list-ref spec 3)) (smeas (list-ref spec 4))
         (spc (list-ref spec 5)) (ssig (list-ref spec 6)) (shead (list-ref spec 7))
         (applythm (list-ref spec 8)) (secthm (list-ref spec 9))
         (monothm (if (eq? o 'x) 'x-section-mono 'y-section-mono))
         (diffthm (if (eq? o 'x) 'x-section-difference 'y-section-difference))
         (typthm (if (eq? o 'x) 'x-section-measure-type 'y-section-measure-type))
         (ba '(COMPLEMENT-IN bb aa))
         (u (smf 'bb)) (v (smf 'aa)) (d (smf ba))
         (int (lambda (f) (list 'INTEGRAL dom dsig imeas f)))
         (sec (lambda (c z) (list shead spc c z)))
         ;; at the point z: the three values, the sections typed, v z <= u z, u z real
         (at! (lambda (z)
                (dk-cite! applythm 'xs 'ys smeas 'bb z)
                (dk-cite! applythm 'xs 'ys smeas 'aa z)
                (dk-cite! applythm 'xs 'ys smeas ba z)
                (fact secthm 'xs 'cA 'ys 'cB 'aa z)
                (fact secthm 'xs 'cA 'ys 'cB 'bb z)
                (fact monothm spc 'aa 'bb z)
                (fact 'measure-monotone spc ssig smeas (sec 'aa z) (sec 'bb z))
                (dk-apply! (or (dk-ctx-form (list 'FORALL 'pmz_ (list 'IMPLIES (list 'IN 'pmz_ dom) (list 'IN (list smeas (list shead spc 'bb 'pmz_)) 'RR))))
                               (error "the finiteness hypothesis")) z)
                (fact 'fun-apply-type-c smeas ssig 'RR-POS-STAR (sec 'aa z))
                (pms-and! (list 'IN (list smeas (sec 'aa z)) 'RR-POS-STAR) (list 'IN (list smeas (sec 'bb z)) 'RR))
                (fact 'rr-pos-star-le-real-in-rr (list smeas (sec 'aa z)) (list smeas (sec 'bb z))))))
    (dk-peel!)
    (pms-meas-parts!)
    (pms-sig-sub!)
    (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
    (fact 'sigma-algebra-difference-closed pms-xy pms-ps 'bb 'aa)
    (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu 'bb)
    (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu 'aa)
    (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu ba)
    ;; v <= u pointwise
    (dk-have! (list 'FORALL 'pmv_ (list 'IMPLIES (list 'IN 'pmv_ dom) (list '<= (list v 'pmv_) (list u 'pmv_))))
      (lambda ()
        (let ((zv (dk-di-var!)))
          (at! zv)
          (subst (list '= (list u zv) (list smeas (sec 'bb zv))))
          (subst (list '= (list v zv) (list smeas (sec 'aa zv))))
          (ass))))
    (let* ((dm (dk-fact! 'measurable-fn-sub dom dsig u v))
           (dl (cadddr dm)))
      ;; D = d pointwise
      (dk-have! (list 'FORALL 'pmv_ (list 'IMPLIES (list 'IN 'pmv_ dom) (list '= (list dl 'pmv_) (list d 'pmv_))))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (at! zv)
            (fact diffthm spc 'aa 'bb zv)
            (fact 'measure-subtractive spc ssig smeas (sec 'aa zv) (sec 'bb zv))
            (dk-lam-b!)
            (subst (list '= (list u zv) (list smeas (sec 'bb zv))))
            (subst (list '= (list v zv) (list smeas (sec 'aa zv))))
            (subst (list '= (list d zv) (list smeas (sec ba zv))))
            (subst (list '= (sec ba zv) (list 'COMPLEMENT-IN (sec 'bb zv) (sec 'aa zv))))
            (let ((ift (cadr (dk-goal))))
              (dk-if-branch! #t ift #f
                (lambda ()
                  (subst (list '= (list smeas (list 'COMPLEMENT-IN (sec 'bb zv) (sec 'aa zv)))
                                  (list '- (list smeas (sec 'bb zv)) (list smeas (sec 'aa zv)))))
                  (rfl)))))))
      (cadr (pms-parts! 'is-measurable-fn (list dom dsig dl)))
      (fact 'measurable-fn-congruence-ptwise dom dsig dl d)
      (fact 'integral-congruence-ptwise dom dsig imeas dl d)
      (fact 'integral-sub dom dsig imeas u v)
      (dk-have! (list 'PTWISE-LE dom v u) (lambda () (mac 'PTWISE-LE) (ass)))
      (fact 'integral-monotone dom dsig imeas v u)
      (fact 'integral-in dom dsig imeas u)
      (fact 'integral-in dom dsig imeas v)
      (fact 'integral-in dom dsig imeas dl)
      (let ((iu (int u)) (iv (int v)) (id (int dl)))
        (pms-and! (list 'IN iv 'RR-POS-STAR) (list 'IN iu 'RR))
        (fact 'rr-pos-star-le-real-in-rr iv iu)
        (pms-and! (list 'IN id 'RR-POS-STAR) (list 'IN iv 'RR-POS-STAR))
        (fact 'eplus-le-left id iv)
        (dk-rewrite-h! (list '<= id (list 'eplus id iv)) (list 'eplus id iv) iu)
        (pms-and! (list 'IN id 'RR-POS-STAR) (list 'IN iu 'RR))
        (fact 'rr-pos-star-le-real-in-rr id iu)
        (fact 'rr-pos-star-nonneg id)
        (fact 'rr-pos-star-nonneg iv)
        (fact 'eplus-real-defined id iv)
        (fact 'binplus-apply id iv)
        (let* ((e1 (dk-rewrite-h! (list '= (list 'eplus id iv) iu) (list 'eplus id iv) (list 'binplus id iv)))
               (e2 (dk-rewrite-h! e1 (list 'binplus id iv) (list '+ id iv))))
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (subst (list '= (int d) id))
                    (dk-ineq! e2 (list 'IN id 'RR) (list 'IN iv 'RR) (list 'IN iu 'RR)))))))))))

(define (pms-diff-stmt o)
  (let* ((spec (pms-morient o))
         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2))
         (imeas (list-ref spec 3)) (smeas (list-ref spec 4)) (spc (list-ref spec 5)) (shead (list-ref spec 7))
         (int (lambda (f) (list 'INTEGRAL dom dsig imeas f))))
    (make-wff (forall-guarded '(xs cA mu ys cB nu aa bb)
      (append pms-meas2
        (list (list 'IN 'aa pms-ps) (list 'IN 'bb pms-ps) '(SUBSET aa bb)
              (list 'IS-MEASURABLE-FN dom dsig (smf 'aa)) (list 'IS-MEASURABLE-FN dom dsig (smf 'bb))
              (list 'FORALL 'pmz_ (list 'IMPLIES (list 'IN 'pmz_ dom) (list 'IN (list smeas (list shead spc 'bb 'pmz_)) 'RR)))
              (list 'IN (int (smf 'bb)) 'RR)))
      (list 'AND (list 'IS-MEASURABLE-FN dom dsig (smf '(COMPLEMENT-IN bb aa)))
            (list 'AND (list 'IN (int (smf 'aa)) 'RR)
                  (list '= (int (smf '(COMPLEMENT-IN bb aa))) (list '- (int (smf 'bb)) (int (smf 'aa))))))))))

(sp (pms-diff-stmt 'x))
(pms-diff-side! 'x)
(qed 'x-section-measure-difference)
(topic! 'x-section-measure-difference 'set-quotient)

(sp (pms-diff-stmt 'y))
(pms-diff-side! 'y)
(qed 'y-section-measure-difference)
(topic! 'y-section-measure-difference 'set-quotient)

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu aa bb)
   (append pms-meas2
     (list (list 'IN 'aa pms-ps) (list 'IN 'bb pms-ps) '(SUBSET aa bb) (pms-fs-of 'aa) (pms-fs-of 'bb)
           '(FORALL pmz_ (IMPLIES (IN pmz_ xs) (IN (nu (X-SECTION ys bb pmz_)) RR)))
           '(FORALL pmz_ (IMPLIES (IN pmz_ ys) (IN (mu (Y-SECTION xs bb pmz_)) RR)))
           '(IN (INTEGRAL xs cA mu (X-SECTION-MEASURE xs ys nu bb)) RR)))
   (pms-fs-of '(COMPLEMENT-IN bb aa)))))
(dk-peel!)
(let* ((ix (lambda (c) (list 'INTEGRAL 'xs 'cA 'mu (list 'X-SECTION-MEASURE 'xs 'ys 'nu c))))
       (iy (lambda (c) (list 'INTEGRAL 'ys 'cB 'nu (list 'Y-SECTION-MEASURE 'xs 'ys 'mu c))))
       (pa (pms-parts! 'is-fubini-set '(xs cA mu ys cB nu aa)))
       (pb (pms-parts! 'is-fubini-set '(xs cA mu ys cB nu bb))))
  (dk-have! (list 'IN (iy 'bb) 'RR) (lambda () (subst (list '= (iy 'bb) (ix 'bb))) (ass)))
  (dk-split-all! (list (dk-fact! 'x-section-measure-difference 'xs 'cA 'mu 'ys 'cB 'nu 'aa 'bb)))
  (dk-split-all! (list (dk-fact! 'y-section-measure-difference 'xs 'cA 'mu 'ys 'cB 'nu 'aa 'bb)))
  (dk-split-all!)
  (mac 'IS-FUBINI-SET)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (subst (list '= (ix '(COMPLEMENT-IN bb aa)) (list '- (ix 'bb) (ix 'aa))))
            (subst (list '= (iy '(COMPLEMENT-IN bb aa)) (list '- (iy 'bb) (iy 'aa))))
            (subst (list '= (ix 'bb) (iy 'bb)))
            (subst (list '= (ix 'aa) (iy 'aa)))
            (rfl))))))
(qed 'fubini-set-difference)
(topic! 'fubini-set-difference 'set-quotient)
;;; =====================================================================
;;; (13) FUBINI FOR SETS: nondecreasing unions (continuity from below inside,
;;;      monotone convergence outside).
;;; =====================================================================

(define pms-cu '(BIG-UNION n_ NN (f n_)))

(define (pms-union-side!! o)
  (let* ((spec (pms-morient o))
         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2))
         (imeas (list-ref spec 3)) (smeas (list-ref spec 4))
         (spc (list-ref spec 5)) (ssig (list-ref spec 6)) (shead (list-ref spec 7))
         (applythm (list-ref spec 8)) (secthm (list-ref spec 9))
         (monothm (if (eq? o 'x) 'x-section-mono 'y-section-mono))
         (memb (if (eq? o 'x) 'x-section-membership 'y-section-membership))
         (pair (if (eq? o 'x) (lambda (p z) (list 'LIST p z)) (lambda (p z) (list 'LIST z p))))
         (typthm (if (eq? o 'x) 'x-section-measure-type 'y-section-measure-type))
         (cu pms-cu)
         (h (smf cu))
         (int (lambda (f) (list 'INTEGRAL dom dsig imeas f)))
         (sec (lambda (c z) (list shead spc c z))))
    (dk-peel!)
    (pms-meas-parts!)
    (pms-sig-sub!)
    (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
    (fact 'sigma-algebra-union-closed pms-xy pms-ps 'f)
    (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu cu)
    (let* ((mono (or (dk-ctx-form '(FORALL pmn_ (IMPLIES (IN pmn_ NN) (SUBSET (f pmn_) (f (succ pmn_)))))) (error "the monotonicity")))
           (meas (or (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN dom dsig (smf '(f pmn_))))))
                     (error "the measurability")))
           (fk! (lambda (k) (fact 'fun-apply-type-c 'f 'NN pms-ps k)))
           (gr (pms-abstract! 'NN (list 'FUN dom 'RR-POS-STAR) (lambda (k) (smf (list 'f k)))
                 (lambda (kv) (fk! kv) (pms-then-ass! (lambda () (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu (list 'f kv)))))
                 (lambda (kv) (fk! kv) (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu (list 'f kv))
                              (fact 'membership-implies-sethood (smf (list 'f kv)) (list 'FUN dom 'RR-POS-STAR)))))
           (cf (car gr)) (ce (cdr gr))
           (ck! (lambda (k) (dk-apply! ce k)))
           (psup (list 'PTWISE-SUP dom cf)))
      ;; the hypotheses of monotone convergence
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN dom dsig (list cf 'n_))))
        (lambda ()
          (let ((nv (dk-di-var!)))
            (ck! nv)
            (subst (list '= (list cf nv) (smf (list 'f nv))))
            (dk-apply! meas nv)
            (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE dom (list cf 'n_) (list cf '(succ n_)))))
        (lambda ()
          (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
            (fact 'nn-succ-closed nv)
            (ck! nv) (ck! sn)
            (fk! nv) (fk! sn)
            (dk-apply! mono nv)
            (subst (list '= (list cf nv) (smf (list 'f nv))))
            (subst (list '= (list cf sn) (smf (list 'f sn))))
            (mac 'PTWISE-LE)
            (let ((zv (dk-di-var!)))
              (dk-cite! applythm 'xs 'ys smeas (list 'f nv) zv)
              (dk-cite! applythm 'xs 'ys smeas (list 'f sn) zv)
              (fact secthm 'xs 'cA 'ys 'cB (list 'f nv) zv)
              (fact secthm 'xs 'cA 'ys 'cB (list 'f sn) zv)
              (fact monothm spc (list 'f nv) (list 'f sn) zv)
              (fact 'measure-monotone spc ssig smeas (sec (list 'f nv) zv) (sec (list 'f sn) zv))
              (subst (list '= (list (smf (list 'f nv)) zv) (list smeas (sec (list 'f nv) zv))))
              (subst (list '= (list (smf (list 'f sn)) zv) (list smeas (sec (list 'f sn) zv))))
              (ass)))))
      (let* ((mct (dk-split! (dk-fact! 'monotone-convergence dom dsig imeas cf)))
             (mct-eq (find-first (lambda (f) (dk-head-is? f '=)) mct))
             (m1 (cadr (cadr (caddr mct-eq)))))
        (cadr (pms-parts! 'is-measurable-fn (list dom dsig psup)))
        ;; h = PTWISE-SUP(cf) pointwise
        (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list h 'icx_) (list psup 'icx_))))
          (lambda ()
            (let* ((zv (dk-di-var!))
                   (fz! (lambda (k) (fk! k) (fact secthm 'xs 'cA 'ys 'cB (list 'f k) zv)))
                   (gr2 (pms-abstract! 'NN ssig (lambda (k) (sec (list 'f k) zv))
                          (lambda (kv) (pms-then-ass! (lambda () (fz! kv))))
                          (lambda (kv) (fz! kv) (fact 'membership-implies-sethood (sec (list 'f kv) zv) ssig))))
                   (gv (car gr2)) (ge (cdr gr2))
                   (gk! (lambda (k) (fz! k) (dk-apply! ge k)))
                   (bug (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
                   (lhs (sec cu zv)))
              ;; g nondecreasing
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'SUBSET (list gv 'n_) (list gv '(succ n_)))))
                (lambda ()
                  (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                    (fact 'nn-succ-closed nv)
                    (gk! nv) (gk! sn)
                    (dk-apply! mono nv)
                    (subst (list '= (list gv nv) (sec (list 'f nv) zv)))
                    (subst (list '= (list gv sn) (sec (list 'f sn) zv)))
                    (pms-then-ass! (lambda () (fact monothm spc (list 'f nv) (list 'f sn) zv))))))
              ;; the section of the union is the union of the sections
              (pms-ext2! lhs bug
                (lambda (w)
                  (pms-iff-parts! (dk-cite! memb spc cu zv w))
                  (let* ((r (pms-bu-open! (pair zv w) cu)) (kv (car r)))
                    (gk! kv)
                    (dk-have! (list 'IN w (list gv kv))
                      (lambda () (subst (list '= (list gv kv) (sec (list 'f kv) zv)))
                                 (mac memb) (dk-conj-close! dk-ass!)))
                    (pms-bu-close! kv)))
                (lambda (w)
                  (let* ((r (pms-bu-open! w bug)) (kv (car r)))
                    (gk! kv)
                    (dk-rewrite-h! (cdr r) (list gv kv) (sec (list 'f kv) zv))
                    (pms-iff-parts! (dk-cite! memb spc (list 'f kv) zv w))
                    (mac memb)
                    (dk-conj-close! (lambda () (if (not (dk-ass!)) (pms-bu-close! kv)))))))
              (let* ((mcb (dk-fact! 'measure-continuity-from-below spc ssig smeas gv))
                     (l1 (cadr (cadr (caddr mcb))))
                     (l2 (list 'VNB-LAMBDA 'n_ 'NN (list (list cf 'n_) zv))))
                (dk-fun-ext! l2 l1 'NN 'RR-POS-STAR
                  (lambda ()
                    (dk-lam-type! (lambda ()
                      (let ((kv (dk-di-var!)))
                        (fact 'fun-apply-type-c cf 'NN (list 'FUN dom 'RR-POS-STAR) kv)
                        (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list cf kv) dom 'RR-POS-STAR zv)))))))
                  (lambda ()
                    (dk-lam-type! (lambda ()
                      (let ((kv (dk-di-var!)))
                        (fact 'fun-apply-type-c gv 'NN ssig kv)
                        (pms-then-ass! (lambda () (fact 'fun-apply-type-c smeas ssig 'RR-POS-STAR (list gv kv))))))))
                  (lambda (kv)
                    (gk! kv) (ck! kv)
                    (dk-cite! applythm 'xs 'ys smeas (list 'f kv) zv)
                    (fact 'fun-apply-type-c smeas ssig 'RR-POS-STAR (sec (list 'f kv) zv))
                    (dk-lam-b!)
                    (subst (list '= (list gv kv) (sec (list 'f kv) zv)))
                    (subst (list '= (list cf kv) (smf (list 'f kv))))
                    (subst (list '= (list (smf (list 'f kv)) zv) (list smeas (sec (list 'f kv) zv))))
                    (rfl)))
                (dk-cite! applythm 'xs 'ys smeas cu zv)
                (subst (list '= (list h zv) (list smeas lhs)))
                (subst (list '= lhs bug))
                (mac 'PTWISE-SUP)
                (dk-lam-b!)
                (subst (list '= l2 l1))
                (ass)))))
        (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list psup 'icx_) (list h 'icx_))))
          (lambda ()
            (let ((zv (dk-di-var!)))
              (dk-apply! (dk-ctx-form (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list h 'icx_) (list psup 'icx_))))) zv)
              (fact 'fun-apply-type-c psup dom 'RR-POS-STAR zv)
              (subst (list '= (list h zv) (list psup zv)))
              (rfl))))
        (fact 'measurable-fn-congruence-ptwise dom dsig psup h)
        (fact 'integral-congruence-ptwise dom dsig imeas h psup)
        ;; the sequence of integrals
        (let ((m2 (list 'VNB-LAMBDA 'pmn_ 'NN (int (smf '(f pmn_))))))
          (dk-fun-ext! m2 m1 'NN 'RR-POS-STAR
            (lambda ()
              (dk-lam-type! (lambda ()
                (let ((kv (dk-di-var!)))
                  (dk-apply! meas kv)
                  (pms-then-ass! (lambda () (fact 'integral-in dom dsig imeas (smf (list 'f kv)))))))))
            (lambda ()
              (dk-lam-type! (lambda ()
                (let ((kv (dk-di-var!)))
                  (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN dom dsig (list cf 'n_))))) kv)
                  (pms-then-ass! (lambda () (fact 'integral-in dom dsig imeas (list cf kv))))))))
            (lambda (kv)
              (ck! kv)
              (dk-apply! meas kv)
              (fact 'integral-in dom dsig imeas (smf (list 'f kv)))
              (dk-lam-b!)
              (subst (list '= (list cf kv) (smf (list 'f kv))))
              (rfl)))
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (subst (list '= (int h) (int psup)))
                    (subst (list '= m2 m1))
                    (ass))))))))))

(define (pms-union-stmt o)
  (let* ((spec (pms-morient o))
         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2)) (imeas (list-ref spec 3))
         (int (lambda (f) (list 'INTEGRAL dom dsig imeas f))))
    (make-wff (forall-guarded '(xs cA mu ys cB nu f)
      (append pms-meas2
        (list (list 'IN 'f (list 'FUN 'NN pms-ps))
              '(FORALL pmn_ (IMPLIES (IN pmn_ NN) (SUBSET (f pmn_) (f (succ pmn_)))))
              (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN dom dsig (smf '(f pmn_)))))))
      (list 'AND (list 'IS-MEASURABLE-FN dom dsig (smf pms-cu))
            (list '= (int (smf pms-cu))
                  (list 'ESUP (list 'IMAGE (list 'VNB-LAMBDA 'pmn_ 'NN (int (smf '(f pmn_)))) 'NN))))))))

