         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (smeas (list-ref spec 4))
         (spc (list-ref spec 5)) (ssig (list-ref spec 6)) (shead (list-ref spec 7)) (secthm (list-ref spec 9)))
    (dk-peel!)
