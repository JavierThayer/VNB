;;; the Dynkin argument
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu ra rb cs)
   (append pms-meas2 pms-fin (list (list 'IN 'cs pms-ps)))
   (pms-fs-of pms-cr))))
