(sp (make-wff '(FORALL xs (FORALL cA (FORALL ys (FORALL cB (FORALL r_
   (IFF (IN r_ (RECTANGLES xs cA ys cB))
        (AND (IN r_ (POWER (CARTESIAN xs ys)))
             (FORSOME rca_ (AND (IN rca_ cA)
               (FORSOME rcb_ (AND (IN rcb_ cB) (= r_ (CARTESIAN rca_ rcb_)))))))))))))))
(di)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (mac-h 'rectangles-unfold (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'RECTANGLES))) "the membership"))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) "the SEP membership"))
