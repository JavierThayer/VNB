;;; =====================================================================
;;; (17) THE INTEGRAL OF A FINITE SUM of measurable functions is the finite sum
;;;      of the integrals (finite-set induction over the subsets of the index set;
;;;      the induction kit is integral-laws.scm's ibk-induct!).
;;; =====================================================================

(define (pms-syms x)
  (cond ((symbol? x) (list x)) ((pair? x) (append (pms-syms (car x)) (pms-syms (cdr x)))) (#t '())))
(define (pms-ptw u body-of)
  (let* ((used (append (pms-syms u) (pms-syms (body-of 'pms-dummy))))
         (b    (let loop ((cs '(z_ zz_ zq_ zr_ zs_ zt_)))
                 (if (memq (car cs) used) (loop (cdr cs)) (car cs)))))
    (list 'FORALL b (list 'IMPLIES (list 'IN b u) (body-of b)))))
(define (pms-class prop-of) (list 'COMP 'iu_ (prop-of 'iu_)))
(define (pms-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (pms-induct! xs prop-of base! step!)
  (let* ((c     (pms-class prop-of))
         (stepf (pms-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let ((pu (list 'UNION (list 'PAIR xv xv) sv)))
            (dk-split! (dk-fact! 'card-union-singleton-bound sv xv))
            (fact 'union-comm (list 'PAIR xv xv) sv)
            (dk-have! (list 'IN (list 'CARD u) 'NN)
              (lambda () (subst (list '= u pu)) (ass))))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
(define (pms-in-union-left! z u)
  (dk-have! (list 'IN z u)
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (pms-in-union-new! xv u)
  (dk-have! (list 'IN xv u)
    (lambda ()
      (mac 'union-membership) (oi-r)
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) xv)))
        (have! (list '= xv xv) (lambda () (rfl)))
        (pms-prop-with! (list pm (list '= xv xv)))))))

;;; the monoid [0, inf] with eplus: its slots
(define pms-m 'RR-POS-STAR-ADD-MONOID)
(define (pms-fs fv u) (list 'FINSUM pms-m fv u))
(define (pms-readoff! eqn)
  (dk-have! eqn (lambda () (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID))) (qrfl))))
(define pms-opr-eq  '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
(define pms-iden-eq '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
(define pms-carr-eq '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
(define (pms-rps-setup!)
  (fact 'rr-pos-star-is-comm-monoid)
  (pms-readoff! pms-opr-eq)
  (pms-readoff! pms-iden-eq)
  (pms-readoff! pms-carr-eq))
(define (pms-rps-of fv) (lambda (z) (list 'IN (list fv z) 'RR-POS-STAR)))
(define (pms-carr-rps-of fv) (lambda (z) (list 'IN (list fv z) '(CARR RR-POS-STAR-ADD-MONOID))))
(define (pms-carr-typing! u fv)
  (dk-have! (pms-ptw u (pms-carr-rps-of fv))
    (lambda () (subst pms-carr-eq) (ass))))
;;; (IN (FINSUM M fv u) RR-POS-STAR); u finite, fv RR-POS-STAR-typed on u
(define (pms-rps-typed! u fv)
  (let ((sm (pms-fs fv u)))
    (if (not (dk-asm? (list 'IN sm 'RR-POS-STAR)))
        (begin
          (pms-carr-typing! u fv)
          (fact 'finsum-comm-monoid-type-ptwise pms-m u fv)
          (dk-have! (list 'IN sm 'RR-POS-STAR)
            (lambda () (subst (list '= 'RR-POS-STAR '(CARR RR-POS-STAR-ADD-MONOID))) (ass)))))))
;;; (= (FINSUM M fv U) (eplus (FINSUM M fv S) (fv x))), U = S u {x}
(define (pms-rps-insert! sv xv u fv)
  (let ((claim (list '= (pms-fs fv u) (list 'eplus (pms-fs fv sv) (list fv xv)))))
    (pms-carr-typing! u fv)
    (fact 'finsum-cm-insert-ptwise pms-m sv xv fv)
    (dk-have! (pms-ptw sv (pms-rps-of fv))
      (lambda () (let ((zv (dk-di-var!))) (pms-in-union-left! zv u)
                   (dk-apply! (dk-ctx-form (pms-ptw u (pms-rps-of fv))) zv) (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
    (pms-rps-typed! sv fv)
    (if (not (dk-asm? (list 'IN (list fv xv) 'RR-POS-STAR)))
        (begin (pms-in-union-new! xv u) (dk-apply! (dk-ctx-form (pms-ptw u (pms-rps-of fv))) xv)))
    (dk-have! (list 'AND (list 'IN (pms-fs fv sv) 'RR-POS-STAR) (list 'IN (list fv xv) 'RR-POS-STAR)))
    (fact 'eplus-closed (pms-fs fv sv) (list fv xv))
    (dk-have! claim
      (lambda ()
        (subst (list '= (pms-fs fv u)
                     (list '(OPR RR-POS-STAR-ADD-MONOID) (pms-fs fv sv) (list fv xv))))
        (subst pms-opr-eq)
        (rfl)))
    claim))
;;; (= (FINSUM M fv EMPTY-SET) 0)
(define (pms-rps-empty! fv)
  (let ((claim (list '= (pms-fs fv 'EMPTY-SET) 0)))
    (fact 'finsum-empty pms-m fv)
    (dk-have! claim
      (lambda ()
        (subst (list '== (pms-fs fv 'EMPTY-SET) '(IDEN RR-POS-STAR-ADD-MONOID)))
        (subst pms-iden-eq)
        (rfl)))
    claim))
(define (pms-zero-rps!)
  (dk-have! '(IN 0 RR-POS-STAR)
    (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (if (not (dk-ass!)) (arith)))))))

(define pms-glx (lambda (z) (list 'VNB-LAMBDA 'ifv_ 'dd (list '(fam ifv_) z))))
(define (pms-fu u) (list 'VNB-LAMBDA 'ifx_ 'omega (pms-fs (pms-glx 'ifx_) u)))
(define pms-hl '(VNB-LAMBDA ifv_ dd (INTEGRAL omega cA mu (fam ifv_))))

(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL dd (FORALL vs (FORALL fam
   (IMPLIES (IS-MEASURE omega cA mu)
   (IMPLIES (IN vs SET) (IMPLIES (IN (CARD vs) NN) (IMPLIES (SUBSET vs dd)
   (IMPLIES (FORALL ifv_ (IMPLIES (IN ifv_ vs) (IS-MEASURABLE-FN omega cA (fam ifv_))))
     (AND (IS-MEASURABLE-FN omega cA (VNB-LAMBDA ifx_ omega (FINSUM RR-POS-STAR-ADD-MONOID (VNB-LAMBDA ifv_ dd ((fam ifv_) ifx_)) vs)))
          (= (INTEGRAL omega cA mu (VNB-LAMBDA ifx_ omega (FINSUM RR-POS-STAR-ADD-MONOID (VNB-LAMBDA ifv_ dd ((fam ifv_) ifx_)) vs)))
             (FINSUM RR-POS-STAR-ADD-MONOID (VNB-LAMBDA ifv_ dd (INTEGRAL omega cA mu (fam ifv_))) vs))))))))))))))))
(dk-peel!)
(pms-rps-setup!)
(pms-parts! 'is-measure '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'sigma-algebra-empty-in 'omega 'cA)
(pms-zero-rps!)
(let* ((famm (dk-ctx-form '(FORALL ifv_ (IMPLIES (IN ifv_ vs) (IS-MEASURABLE-FN omega cA (fam ifv_))))))
       ;; v in vs: (fam v) measurable, typed, its integral typed
       (fam! (lambda (v)
               (dk-apply! famm v)
               (cadr (pms-parts! 'is-measurable-fn (list 'omega 'cA (list 'fam v))))
               (fact 'integral-in 'omega 'cA 'mu (list 'fam v))))
       (concl (lambda (u) (list 'AND (list 'IS-MEASURABLE-FN 'omega 'cA (pms-fu u))
                                     (list '= (list 'INTEGRAL 'omega 'cA 'mu (pms-fu u)) (pms-fs pms-hl u)))))
       (prop-of (lambda (u) (list 'IMPLIES (list 'SUBSET u 'vs) (concl u))))
       ;; the G_z typing on u (u subset vs in context), z in omega
       (gtyp! (lambda (u z)
                (dk-have! (pms-ptw u (pms-rps-of (pms-glx z)))
                  (lambda ()
                    (let ((wv (dk-di-var!)))
                      (fact 'subset-mem-fwd u 'vs wv) (fact 'subset-mem-fwd 'vs 'dd wv)
                      (fam! wv)
                      (dk-lam-b!)
                      (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list 'fam wv) 'omega 'RR-POS-STAR z))))))))
       ;; the H typing on u
       (htyp! (lambda (u)
                (dk-have! (pms-ptw u (pms-rps-of pms-hl))
                  (lambda ()
                    (let ((wv (dk-di-var!)))
                      (fact 'subset-mem-fwd u 'vs wv) (fact 'subset-mem-fwd 'vs 'dd wv)
                      (fam! wv)
                      (dk-lam-b!)
                      (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))))
       ;; F_u in FUN(omega, RR-POS-STAR)
       (ftyp! (lambda (u)
                (dk-have! (list 'IN (pms-fu u) '(FUN omega RR-POS-STAR))
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((zv (dk-di-var!)))
                          (gtyp! u zv)
                          (pms-rps-typed! u (pms-glx zv))
                          (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))))))
       (px (pms-induct! 'vs prop-of
             (lambda ()
               (di)
               (let ((f0 (pms-fu 'EMPTY-SET)) (ind '(INDICATOR omega EMPTY-SET)))
                 (dk-have! (list 'IN f0 '(FUN omega RR-POS-STAR))
                   (lambda ()
                     (dk-lam-type!
                       (lambda ()
                         (let ((zv (dk-di-var!)))
                           (pms-rps-empty! (pms-glx zv))
                           (subst (list '= (pms-fs (pms-glx zv) 'EMPTY-SET) 0))
                           (ass))))))
                 (fact 'measurable-fn-indicator 'omega 'cA 'EMPTY-SET)
                 (cadr (pms-parts! 'is-measurable-fn (list 'omega 'cA ind)))
                 (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list ind 'icx_) (list f0 'icx_))))
                   (lambda ()
                     (let ((zv (dk-di-var!)))
                       (fact 'empty-set-has-no-members zv)
                       (fact 'indicator-value-out 'omega 'EMPTY-SET zv)
                       (pms-rps-empty! (pms-glx zv))
                       (dk-lam-b!)
                       (subst (list '= (list ind zv) 0))
                       (subst (list '= (pms-fs (pms-glx zv) 'EMPTY-SET) 0))
                       (rfl))))
                 (fact 'measurable-fn-congruence-ptwise 'omega 'cA ind f0)
                 (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list f0 'icx_) (list ind 'icx_))))
                   (lambda ()
                     (let ((zv (dk-di-var!)))
                       (dk-apply! (dk-ctx-form (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list ind 'icx_) (list f0 'icx_))))) zv)
                       (fact 'fun-apply-type-c ind 'omega 'RR-POS-STAR zv)
                       (subst (list '= (list f0 zv) (list ind zv)))
                       (rfl))))
                 (fact 'integral-congruence-ptwise 'omega 'cA 'mu f0 ind)
                 (fact 'integral-indicator 'omega 'cA 'mu 'EMPTY-SET)
                 (pms-rps-empty! pms-hl)
                 (dk-conj-close!
                   (lambda ()
                     (if (not (dk-ass!))
                         (begin
                           (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu f0) (list 'INTEGRAL 'omega 'cA 'mu ind)))
                           (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu ind) '(mu EMPTY-SET)))
                           (subst '(= (mu EMPTY-SET) 0))
                           (subst (list '= (pms-fs pms-hl 'EMPTY-SET) 0))
                           (rfl)))))))
             (lambda (sv xv u ih)
               (di)
               (let* ((fu (pms-fu u)) (fsv (pms-fu sv)) (fx (list 'fam xv))
                      (pe (list 'PTWISE-EPLUS 'omega fsv fx))
                      (int (lambda (f) (list 'INTEGRAL 'omega 'cA 'mu f)))
                      (v1 (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega)
                             (list '= (list fu 'icx_) (list 'eplus (list fsv 'icx_) (list fx 'icx_)))))))
                 (pms-subset! sv 'vs (lambda (w) (pms-in-union-left! w u) (fact 'subset-mem-fwd u 'vs w)))
                 (dk-split-all! (list (dk-landed-1 (lambda () (detach! ih)))))
                 (pms-in-union-new! xv u)
                 (fact 'subset-mem-fwd u 'vs xv) (fact 'subset-mem-fwd 'vs 'dd xv)
                 (fam! xv)
                 (ftyp! u)
                 (dk-have! v1
                   (lambda ()
                     (let* ((zv (dk-di-var!)) (gz (pms-glx zv)))
                       (gtyp! u zv)
                       (pms-rps-insert! sv xv u gz)
                       (fact 'fun-apply-type-c fx 'omega 'RR-POS-STAR zv)
                       (pms-and! (list 'IN (pms-fs gz sv) 'RR-POS-STAR) (list 'IN (list fx zv) 'RR-POS-STAR))
                       (fact 'eplus-closed (pms-fs gz sv) (list fx zv))
                       (dk-lam-b!)
                       (subst (list '= (pms-fs gz u) (list 'eplus (pms-fs gz sv) (list gz xv))))
                       (dk-lam-b!)
                       (if (not (proof-done? *ps*)) (rfl)))))
                 (fact 'measurable-fn-eplus-of-values 'omega 'cA fsv fx fu)
                 (fact 'measurable-fn-eplus 'omega 'cA fsv fx)
                 (cadr (pms-parts! 'is-measurable-fn (list 'omega 'cA pe)))
                 (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list fu 'icx_) (list pe 'icx_))))
                   (lambda ()
                     (let* ((zv (dk-di-var!)) (gz (pms-glx zv)))
                       (dk-apply! (dk-ctx-form v1) zv)
                       (gtyp! sv zv)
                       (pms-rps-typed! sv gz)
                       (fact 'fun-apply-type-c fx 'omega 'RR-POS-STAR zv)
                       (pms-and! (list 'IN (pms-fs gz sv) 'RR-POS-STAR) (list 'IN (list fx zv) 'RR-POS-STAR))
                       (fact 'eplus-closed (pms-fs gz sv) (list fx zv))
                       (subst (list '= (list fu zv) (list 'eplus (list fsv zv) (list fx zv))))
                       (mac 'PTWISE-EPLUS)
                       (dk-lam-b!)
                       (if (not (proof-done? *ps*)) (rfl)))))
                 (fact 'integral-congruence-ptwise 'omega 'cA 'mu fu pe)
                 (fact 'integral-additive 'omega 'cA 'mu fsv fx)
                 (htyp! u)
                 (pms-rps-insert! sv xv u pms-hl)
                 (fact 'integral-in 'omega 'cA 'mu fsv)
                 (htyp! sv)
                 (pms-rps-typed! sv pms-hl)
                 (pms-and! (list 'IN (pms-fs pms-hl sv) 'RR-POS-STAR) (list 'IN (int fx) 'RR-POS-STAR))
                 (fact 'eplus-closed (pms-fs pms-hl sv) (int fx))
                 (dk-conj-close!
                   (lambda ()
                     (if (not (dk-ass!))
                         (begin
                           (subst (list '= (int fu) (int pe)))
                           (subst (list '= (int pe) (list 'eplus (int fsv) (int fx))))
                           (subst (list '= (int fsv) (pms-fs pms-hl sv)))
                           (subst (list '= (pms-fs pms-hl u) (list 'eplus (pms-fs pms-hl sv) (list pms-hl xv))))
                           (dk-lam-b!)
                           (if (not (proof-done? *ps*)) (rfl)))))))))))
  (fact 'subset-refl 'vs)
  (dk-split-all! (list (dk-landed-1 (lambda () (detach! px)))))
  (dk-conj-close! dk-ass!))
(qed 'integral-finsum)
(topic! 'integral-finsum 'set-quotient)
;;; =====================================================================
;;; (18) THE INNER INTEGRAL OF A SIMPLE FUNCTION: the section of a simple s at a
;;;      point is simple, through the partition by the values of s, and its
;;;      integral is  sum over v in s(X x Y) of v nu(section of {s = v}).
;;; =====================================================================

(define pms-v '(IMAGE s (CARTESIAN xs ys)))
(define (pms-lev z) (list 'SEP 'fx_ pms-xy (list '= '(s fx_) z)))

;;; v in the image of the simple s: (IN v RR), (<= 0 v), (IN v RR-POS-STAR)
(define (pms-img-val! v)
  (let ((ex (dk-project! (list 'FORSOME 'x (list 'AND (list 'IN 'x pms-xy) (list '= '(s x) v)))
              (lambda () (let ((iff (dk-cite! 'image-membership-iff 's pms-xy v)))
                           (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))))
    (dk-have! (list 'IN v 'RR)
      (lambda ()
        (let ((pv (dk-skolem! ex)))
          (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ pms-xy) '(IN (s x_) RR)))) pv)
          (subst (list '= v (list 's pv)))
          (ass))))
    (dk-have! (list '<= 0 v)
      (lambda ()
        (let ((pv (dk-skolem! ex)))
          (fact 'fun-apply-type-c 's pms-xy 'RR-POS-STAR pv)
          (fact 'rr-pos-star-nonneg (list 's pv))
          (subst (list '= v (list 's pv)))
          (ass))))
    (fact 'image-subset-codomain pms-xy 'RR-POS-STAR 's v)))
;;; (IN (s p) V) for p in CARTESIAN(xs, ys)
(define (pms-img-in! p)
  (dk-have! (list 'IN (list 's p) pms-v)
    (lambda ()
      (fact 'fun-apply-type-c 's pms-xy 'RR-POS-STAR p)
      (fact 'membership-implies-sethood (list 's p) 'RR-POS-STAR)
      (mac 'image-membership-iff)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME) (ew p) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                (#t (error "pms-img-in!" (dk-goal)))))))))

(define (pms-sec-simple! o)
  (let* ((spec (pms-orient o))
         (head (list-ref spec 0)) (spc (list-ref spec 1)) (sig (list-ref spec 2))
         (ptsp (list-ref spec 3)) (pt (list-ref spec 4)) (memb (list-ref spec 5)) (pair (list-ref spec 6))
         (smeas (if (eq? o 'x) 'nu 'mu))
         (k (list (if (eq? o 'x) 'FN-X-SECTION 'FN-Y-SECTION) spc 's pt))
         (applythm (if (eq? o 'x) 'fn-x-section-apply 'fn-y-section-apply))
         (mthm (if (eq? o 'x) 'fn-x-section-measurable 'fn-y-section-measurable))
         (secthm (if (eq? o 'x) 'x-section-measurable 'y-section-measurable))
         (sec (lambda (c) (list head spc c pt)))
         (hh '(VNB-LAMBDA hv_ (IMAGE s (CARTESIAN xs ys)) hv_))
         (pre (lambda (z) (list 'SEP 'fx_ spc (list '= (list k 'fx_) z))))
         (gg (list 'VNB-LAMBDA 'sv_ pms-v (list 'etimes 'sv_ (list smeas (sec (pms-lev 'sv_))))))
         (pc! (lambda (z) (fact 'pair-in-cartesian 'xs 'ys (if (eq? o 'x) pt z) (if (eq? o 'x) z pt)))))
    (dk-peel!)
    (pms-parts! 'is-measure (if (eq? o 'x) '(ys cB nu) '(xs cA mu)))
    (pms-xy-set!)
    (pms-sig-sub!)
    (let* ((sp (pms-parts! 'is-simple-fn (list pms-xy pms-ps 's)))
           (mp (pms-parts! 'is-measurable-fn (list pms-xy pms-ps 's))))
      (fact 'image-set 's pms-xy)
      (fact mthm 'xs 'cA 'ys 'cB 's pt)
      (cadr (pms-parts! 'is-measurable-fn (list spc sig k)))
      ;; the preimage of z under the section is the section of the level set {s = z}
      (dk-have! (pms-ptw pms-v (lambda (z) (list '= (pre z) (sec (pms-lev z)))))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (pms-img-val! zv)
            (pms-ext2! (pre zv) (sec (pms-lev zv))
              (lambda (w)
                (sep-me (list 'IN w (pre zv)))
                (dk-split-all!)
                (dk-cite! applythm spc 's pt w)
                (dk-rewrite-h! (list '= (list k w) zv) (list k w) (list 's (pair pt w)))
                (mac memb)
                (dk-conj-close!
                  (lambda () (if (not (dk-ass!)) (in-sep! (lambda () (pc! w) (ass)) dk-ass!)))))
              (lambda (w)
                (pms-iff-parts! (dk-cite! memb spc (pms-lev zv) pt w))
                (sep-me (list 'IN (pair pt w) (pms-lev zv)))
                (dk-split-all!)
                (in-sep! dk-ass!
                  (lambda ()
                    (dk-cite! applythm spc 's pt w)
                    (subst (list '= (list k w) (list 's (pair pt w))))
                    (ass)))))
            (ass))))
      ;; the hypotheses of simple-fn-of-partition / simple-integral-partition
      (dk-have! (pms-ptw spc (lambda (z) (list 'IN (list k z) pms-v)))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (dk-cite! applythm spc 's pt zv)
            (pc! zv)
            (subst (list '= (list k zv) (list 's (pair pt zv))))
            (pms-img-in! (pair pt zv)))))
      (dk-have! (pms-ptw pms-v (lambda (z) (list 'IN (pre z) sig)))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (pms-img-val! zv)
            (dk-apply! (dk-fact! 'measurable-fn-level-set pms-xy pms-ps 's) zv)
            (fact secthm 'xs 'cA 'ys 'cB (pms-lev zv) pt)
            (dk-apply! (dk-ctx-form (pms-ptw pms-v (lambda (z) (list '= (pre z) (sec (pms-lev z)))))) zv)
            (subst (list '= (pre zv) (sec (pms-lev zv))))
            (ass))))
      (dk-have! (pms-ptw pms-v (lambda (z) (list 'IN (list hh z) 'RR)))
        (lambda () (let ((zv (dk-di-var!))) (pms-img-val! zv) (if (not (dk-lam-b!)) (ass)))))
      (dk-have! (pms-ptw pms-v (lambda (z) (list '<= 0 (list hh z))))
        (lambda () (let ((zv (dk-di-var!))) (pms-img-val! zv) (if (not (dk-lam-b!)) (ass)))))
      (dk-have! (pms-ptw spc (lambda (z) (list '= (list k z) (list hh (list k z)))))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (dk-apply! (dk-ctx-form (pms-ptw spc (lambda (z) (list 'IN (list k z) pms-v)))) zv)
            (fact 'fun-apply-type-c k spc 'RR-POS-STAR zv)
            (dk-lam-b!)
            (if (not (proof-done? *ps*)) (rfl)))))
      (fact 'simple-fn-of-partition spc sig pms-v k hh k)
      (fact 'integral-simple spc sig smeas k)
      (dk-have! (pms-ptw pms-v (lambda (z) (list '= (list gg z) (list 'etimes (list hh z) (list smeas (pre z))))))
        (lambda ()
          (let ((zv (dk-di-var!)))
            (pms-img-val! zv)
            (dk-apply! (dk-ctx-form (pms-ptw pms-v (lambda (z) (list '= (pre z) (sec (pms-lev z)))))) zv)
            (dk-apply! (dk-ctx-form (pms-ptw pms-v (lambda (z) (list 'IN (pre z) sig)))) zv)
            (fact 'fun-apply-type-c smeas sig 'RR-POS-STAR (pre zv))
