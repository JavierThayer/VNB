(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f)
   (append pms-meas2 pms-sf2 (list (list 'IS-MEASURABLE-FN pms-xy pms-ps 'f)))
   (pms-fubini-concl 'f))))
(dk-peel!)
(pms-meas-parts!)
(pms-sig-sub!)
(pms-xy-set!)
(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(let* ((cfv (dk-skolem! (dk-fact! 'integral-simple-approx pms-xy pms-ps 'f)))
       (simp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-SIMPLE-FN) (dk-contains? h cfv))) "the simple approximants"))
       (fsn (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (pms-fubini-concl (list cfv 'pmn_)))))
       (ix (lambda (g) (list 'INTEGRAL 'xs 'cA 'mu g)))
       (iy (lambda (g) (list 'INTEGRAL 'ys 'cB 'nu g))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN pms-xy pms-ps (list cfv 'pmn_))))
    (lambda () (let ((nv (dk-di-var!))) (pms-apply1! simp nv) (pms-close-by-parts! 'is-simple-fn (list pms-xy pms-ps (list cfv nv))))))
  (dk-have! fsn
    (lambda () (let ((nv (dk-di-var!))) (pms-apply1! simp nv) (pms-then-ass! (lambda () (fact 'fubini-simple 'xs 'cA 'mu 'ys 'cB 'nu (list cfv nv)))))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'xs 'cA (pms-xsi (list cfv 'pmn_)))))
    (lambda () (let ((nv (dk-di-var!))) (dk-split-all! (list (pms-apply1! (dk-ctx-form fsn) nv))) (if (not (proof-done? *ps*)) (ass)))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'ys 'cB (pms-ysi (list cfv 'pmn_)))))
    (lambda () (let ((nv (dk-di-var!))) (dk-split-all! (list (pms-apply1! (dk-ctx-form fsn) nv))) (if (not (proof-done? *ps*)) (ass)))))
  (dk-split! (dk-fact! 'x-section-integral-limit 'xs 'cA 'mu 'ys 'cB 'nu 'f cfv))
  (dk-split! (dk-fact! 'y-section-integral-limit 'xs 'cA 'mu 'ys 'cB 'nu 'f cfv))
  (fact 'y-section-integral-type 'xs 'cA 'mu 'ys 'cB 'f)
  (fact 'integral-in 'ys 'cB 'nu (pms-ysi 'f))
  (let ((mx (list 'VNB-LAMBDA 'pmn_ 'NN (ix (pms-xsi (list cfv 'pmn_)))))
        (my (list 'VNB-LAMBDA 'pmn_ 'NN (iy (pms-ysi (list cfv 'pmn_))))))
    (dk-fun-ext! mx my 'NN 'RR-POS-STAR
      (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!)))
        (pms-apply1! (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'xs 'cA (pms-xsi (list cfv 'pmn_)))))) kv)
        (pms-then-ass! (lambda () (fact 'integral-in 'xs 'cA 'mu (pms-xsi (list cfv kv)))))))))
      (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!)))
        (pms-apply1! (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'ys 'cB (pms-ysi (list cfv 'pmn_)))))) kv)
        (pms-then-ass! (lambda () (fact 'integral-in 'ys 'cB 'nu (pms-ysi (list cfv kv)))))))))
