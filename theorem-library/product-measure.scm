(sp (make-wff '(FORALL a (FORALL b (FORALL u (FORALL v
   (IFF (IN (LIST u v) (CARTESIAN a b)) (AND (IN u a) (IN v b)))))))))
(di)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (let* ((c (dk-fact! 'cartesian-nth '(LIST u v) 'a 'b))
           (c2 (dk-nth-h! c)))
      (dk-split! c2)
      (dk-conj-close! dk-ass!)))
  (lambda ()
    (dk-split-all!)
