(define pms-fs '(IS-FUBINI-SET xs cA mu ys cB nu))
(define (pms-fs-of c) (append pms-fs (list c)))

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu aa bb)
   (append pms-meas2 '((IN aa cA) (IN bb cB) (IN (mu aa) RR) (IN (nu bb) RR)))
   (pms-fs-of '(CARTESIAN aa bb)))))
(dk-peel!)
(let* ((rc '(CARTESIAN aa bb))
       (hx (list 'X-SECTION-MEASURE 'xs 'ys 'nu rc))
       (hy (list 'Y-SECTION-MEASURE 'xs 'ys 'mu rc)))
  (pms-meas-parts!)
  (dk-split! (dk-fact! 'x-section-measure-rectangle 'xs 'cA 'mu 'ys 'cB 'nu 'aa 'bb))
  (dk-split! (dk-fact! 'y-section-measure-rectangle 'xs 'cA 'mu 'ys 'cB 'nu 'aa 'bb))
  (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR 'bb)
  (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR 'aa)
  (pms-and! '(IN (nu bb) RR-POS-STAR) '(IN (mu aa) RR-POS-STAR))
  (fact 'etimes-comm '(nu bb) '(mu aa))
  (mac 'IS-FUBINI-SET)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu hx) '(etimes (nu bb) (mu aa))))
            (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu hy) '(etimes (mu aa) (nu bb))))
            (ass))))))
(qed 'fubini-set-rectangle)
