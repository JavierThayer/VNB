      (list (lambda (c) (list 'X-SECTION-MEASURE 'xs 'ys 'nu c)) 'xs 'cA 'mu 'nu 'ys 'cB 'X-SECTION 'x-section-measure-apply 'x-section-measurable)
      (list (lambda (c) (list 'Y-SECTION-MEASURE 'xs 'ys 'mu c)) 'ys 'cB 'nu 'mu 'xs 'cA 'Y-SECTION 'y-section-measure-apply 'y-section-measurable)))

(define (pms-smf-type! o)
