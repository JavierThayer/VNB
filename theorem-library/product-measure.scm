   '(IS-MEASURABLE-FN omega cA g))))
(dk-peel!)
(dk-project! '(IN f (FUN omega RR-POS-STAR)) (lambda () (mac-h 'IS-MEASURABLE-FN (dk-ctx-form '(IS-MEASURABLE-FN omega cA f))) (dk-split-all!)))
(pms-fun-eq! 'omega 'f 'g)
