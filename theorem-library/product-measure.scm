(define (pms-forall! body) (let ((zv (dk-di-var!))) (body zv)))
(define (pms-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (pms-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define pms-mac-heads
  '((intersection-membership . INTERSECTION) (complement-in-membership . COMPLEMENT-IN)
    (union-membership . UNION)))
(define (pms-has-in-head? x h)
  (and (pair? x)
       (or (and (eq? (car x) 'IN) (pair? (cdr x)) (pair? (cddr x))
                (pair? (caddr x)) (eq? (car (caddr x)) h))
           (let loop ((xs x))
             (and (pair? xs)
                  (or (pms-has-in-head? (car xs) h) (loop (cdr xs))))))))
(define (pms-unfold-sets!)
  (let loop ((fuel 12))
    (let ((m (find-first (lambda (p) (pms-has-in-head? (dk-goal) (cdr p))) pms-mac-heads)))
      (if (and m (> fuel 0))
          (begin (mac (car m)) (loop (- fuel 1)))))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (pms-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; `prop' on the formulas mentioning the element W (prop's atom cap)
(define (pms-prop-on! w)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
    (if (not (sequent-node-grounded? leaf)) (prop))))
(define (pms-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (SUBSET lhs rhs) by unfolding the set operations and `prop'; PRE (a procedure of
;;; the element, run with (IN w lhs) in context) lands what prop needs
(define (pms-subset! lhs rhs pre)
  (dk-have! (list 'SUBSET lhs rhs)
    (lambda ()
      (mac 'subset-def)
      (let ((wv (dk-di-var!)))
        (pms-unfold-sets!)
        (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) wv) (equal? (caddr f) lhs))) "the element")))
          (pre wv)
          (dk-have! (list 'IMPLIES h (dk-goal))
            (lambda () (pms-unfold-sets!) (pms-prop-on! wv)))
          (detach! (list 'IMPLIES h (dk-goal)))
          (ass))))))
;;; class extensionality, the membership iff by unfolding and `prop'
;;; KEEP: further context formulas `prop' needs (they do not mention the element)
(define (pms-ext! lhs rhs pre . keep)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (pms-unfold-sets!)
        (pre w)
        ;; each direction on its own, the antecedent split into the context: `prop' then
        ;; needs few excluded-middle splits (a split whose obligation hash-conses onto a
        ;; node a sibling already proved makes use-cases error, kit finding)
        (for-each
          (lambda (leaf)
            (if (not (sequent-node-grounded? leaf))
                (begin
                  (dk-focus! leaf)
                  (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                  (vnb-guard (lambda () (dk-split-all!)))
                  (if (not (sequent-node-grounded? leaf))
                      (begin
                        (apply dk-only! (append (filter (lambda (f) (dk-contains? f w)) (dk-asms))
                                                (filter (lambda (k) (dk-asm? k)) keep)))
                        (if (not (sequent-node-grounded? leaf)) (prop)))))))
          (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality lhs rhs))
;;; the conjuncts of a predicate's defining iff, landed (hypothesis kept)
(define (pms-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (pms-map (lambda (c) (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; close the focus goal, a conjunct of the predicate's defining iff (consumes the iff)
(define (pms-close-by-parts! pred args)
  (let ((iff (apply dk-cite! (cons pred args))))
    (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!) (ass)))
;;; sequential map (MIT evaluates arguments right to left)
(define (pms-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
;;; (SUBSET x omega) from (IN x (POWER omega))
(define (pms-pow-sub! x om)
  (dk-have! (list 'SUBSET x om)
    (lambda () (mac 'subset-def) (pms-forall! (lambda (zv) (fact 'power-mem-in om x zv) (ass))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)
(define (pms-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (pms-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; dk-abstract! with a PRE run in the value lane on the index: returns (G . VALUE-EQUATION)
(define (pms-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'pmak_))
         (lam   (list 'VNB-LAMBDA 'pmak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'pmak_ (list 'IMPLIES (list 'IN 'pmak_ dom)
                                                    (list '== (list g 'pmak_) body)))))
         (claim (list 'FORSOME 'pmag_ (list 'AND (list 'IN 'pmag_ (list 'FUN dom cod))
                                            (vals 'pmag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "pms-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "pms-abstract!: the value equation did not land"))))
      (cons g ve))))
;;; w in BIG-UNION(n_, NN, g(n_)) gives the index and w in g(index): returns (k . formula)
(define (pms-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (w in the k-th term in context)
(define (pms-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed
;;; (the IFF and the left side survive)
(define (pms-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (pms-map (lambda (c) (pms-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; w in CARTESIAN(a, b) in context: land w = [NTH 1 w, NTH 2 w], NTH 1 w in a, NTH 2 w in b
(define (pms-cart-open! w a b)
  (pms-iff-parts! (dk-cite! 'cartesian-membership-nth a b w)))
;;; w in INTERSECTION(a, b) in context: land w in a, w in b
(define (pms-inter-open! w a b)
  (pms-iff-parts! (dk-cite! 'intersection-membership a b w)))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element,
;;; run with (IN w lhs) / (IN w rhs) in context and the other membership the goal
(define (pms-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))

;;; (AND p q), both in context
(define (pms-and! p q) (pms-and2! p q))
;;; (IN t RR-POS-STAR) for the numeral 1
(define (pms-one-rps!)
  (dk-have! '(IN 1 RR-POS-STAR)
    (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (if (not (dk-ass!)) (arith)))))))
;;; dk-lam-b! when the goal holds a redex (dk-lam-b! errors on a goal with none)
(define (pms-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
;;; dk-apply! of a one-binder guarded universal, a no-op returning the instance when
;;; the instance is already in context (dk-apply! errors: inst+ lands nothing)
(define (pms-apply1! f t)
  (let ((c (subst-free (quantifier-var f) t (caddr (quantifier-body f)))))
    (if (dk-asm? c) (dk-ctx-form c) (dk-apply! f t))))
;;; dk-lam-type! with a typer of the eigenvariable and the sethood leaf closed from context
(define (pms-lt! typer) (dk-lam-type! (lambda () (typer (dk-di-var!))) (lambda () (ass))))
;;; =====================================================================
;;; (1) plumbing: a difference of a subset of omega is a subset of omega.
