(sp (make-wff '(FORALL omega (FORALL a (FORALL b
   (IMPLIES (IN b (POWER omega)) (IN (COMPLEMENT-IN b a) (POWER omega))))))))
(dk-peel!)
(fact 'power-mem-sethood 'omega 'b)
(fact 'power-complement-closed 'b 'a)
