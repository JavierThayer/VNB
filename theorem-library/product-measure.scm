;;; aa x bb is a subset of xs x ys
(sp (make-wff (forall-guarded '(xs ys aa bb) '((IN aa (POWER xs)) (IN bb (POWER ys)))
   '(IN (CARTESIAN aa bb) (POWER (CARTESIAN xs ys))))))
(dk-peel!)
(fact 'power-mem-sethood 'xs 'aa)
(fact 'power-mem-sethood 'ys 'bb)
(dk-have! '(IN (CARTESIAN aa bb) SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ (CARTESIAN aa bb)) (IN z_ (CARTESIAN xs ys))))
  (lambda ()
    (pms-forall!
      (lambda (zv)
        (pms-cart-open! zv 'aa 'bb)
        (fact 'power-mem-in 'xs 'aa (list 'NTH 1 zv))
        (fact 'power-mem-in 'ys 'bb (list 'NTH 2 zv))
        (mac 'cartesian-membership-nth)
        (dk-conj-close! dk-ass!)))))
(pms-then-ass! (lambda () (fact 'power-mem-intro '(CARTESIAN xs ys) '(CARTESIAN aa bb))))
