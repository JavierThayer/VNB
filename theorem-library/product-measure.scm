;;; cA subset POWER(xs), cB subset POWER(ys), from the two sigma-algebras
(define (pms-sig-sub!)
  (list-ref (pms-parts! 'is-sigma-algebra '(xs cA)) 1)
  (list-ref (pms-parts! 'is-sigma-algebra '(ys cB)) 1))

;;; a rectangle of measurable sides is in RECTANGLES
(sp (make-wff (forall-guarded '(xs cA ys cB aa bb) (append pms-sig2 '((IN aa cA) (IN bb cB)))
   (list 'IN '(CARTESIAN aa bb) pms-rect))))
(dk-peel!)
(pms-sig-sub!)
(fact 'subset-mem-fwd 'cA '(POWER xs) 'aa)
(fact 'subset-mem-fwd 'cB '(POWER ys) 'bb)
(fact 'cartesian-in-power-product 'xs 'ys 'aa 'bb)
(mac 'rectangles-membership)
(let walk ()
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'AND) (dk-conj-close! walk))
          ((dk-head-is? g 'FORSOME) (ew (if (dk-contains? g 'rca_) 'aa 'bb)) (walk))
          ((dk-head-is? g '=) (rfl))
          (#t (ass)))))
(qed 'rectangle-in-rectangles)
(topic! 'rectangle-in-rectangles 'set-quotient)

;;; the witnesses of a member r of RECTANGLES: returns (aa . bb), with aa in cA, bb in cB
;;; and r = aa x bb landed
(define (pms-rect-open! r)
  (let* ((iff (dk-cite! 'rectangles-membership 'xs 'cA 'ys 'cB r))
         (ps (pms-iff-parts! iff))
         (av (dk-skolem! (cadr ps)))
         (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f av) (dk-contains? f r))) "the inner witness"))
         (bv (dk-skolem! ex)))
    (cons av bv)))

(sp (make-wff (forall-guarded '(xs cA ys cB) pms-sig2 (list 'IS-PI-SYSTEM pms-rect))))
(dk-peel!)
(mac 'IS-PI-SYSTEM)
(dk-peel!)
(let* ((tgt (cadr (dk-goal))) (r1 (cadr tgt)) (r2 (caddr tgt))
       (w1 (pms-rect-open! r1)) (w2 (pms-rect-open! r2))
       (a1 (car w1)) (b1 (cdr w1)) (a2 (car w2)) (b2 (cdr w2)))
  (subst (list '= r1 (list 'CARTESIAN a1 b1)))
  (subst (list '= r2 (list 'CARTESIAN a2 b2)))
  (fact 'cartesian-intersection a1 b1 a2 b2)
  (subst (list '= (list 'INTERSECTION (list 'CARTESIAN a1 b1) (list 'CARTESIAN a2 b2))
                  (list 'CARTESIAN (list 'INTERSECTION a1 a2) (list 'INTERSECTION b1 b2))))
  (fact 'sigma-algebra-inter-closed-2 'xs 'cA a1 a2)
  (fact 'sigma-algebra-inter-closed-2 'ys 'cB b1 b2)
  (pms-then-ass! (lambda () (fact 'rectangle-in-rectangles 'xs 'cA 'ys 'cB (list 'INTERSECTION a1 a2) (list 'INTERSECTION b1 b2)))))
(qed 'rectangles-pi-system)
(topic! 'rectangles-pi-system 'set-quotient)

;;; the product sigma-algebra is a sigma-algebra on xs x ys
(define (pms-ps-unfold!)
