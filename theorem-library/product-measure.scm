(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(fact 'rectangle-in-product-sigma 'xs 'cA 'ys 'cB 'ra 'rb)
(let* ((cut (lambda (c) (list 'INTERSECTION c pms-r)))
       (gc (list 'SEP 'fgc_ (list 'POWER pms-xy) (list 'AND (list 'IN 'fgc_ pms-ps) (pms-fs-of (cut 'fgc_)))))
       (g-open! (lambda (c)
                  (let ((m (or (dk-ctx-form (list 'IN c gc)) (error "g-open!: not in context" c))))
                    (dk-project! (list 'IN c (list 'POWER pms-xy)) (lambda () (sep-me m) (dk-split-all!)))
                    (dk-project! (list 'IN c pms-ps) (lambda () (sep-me m) (dk-split-all!)))
                    (dk-project! (pms-fs-of (cut c)) (lambda () (sep-me m) (dk-split-all!))))))
       (in-g! (lambda ()
                (in-sep! (lambda () (if (not (dk-ass!)) (error "in-g!: the POWER membership")))
                  (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (error "in-g!: a conjunct" (dk-goal))))))))))
  (dk-have! (list 'IS-DYNKIN-SYSTEM pms-xy gc)
    (lambda ()
      (mac 'IS-DYNKIN-SYSTEM)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-ass!) #t)
                  ((dk-head-is? g 'SUBSET)
                   (mac 'subset-def)
                   (pms-forall! (lambda (zv) (sep-me (list 'IN zv gc)) (dk-split-all!) (ass))))
                  ((dk-head-is? g 'IN)
                   (fact 'power-whole-in pms-xy)
                   (fact 'sigma-algebra-whole-in 'xs 'cA)
                   (fact 'sigma-algebra-whole-in 'ys 'cB)
                   (fact 'rectangle-in-product-sigma 'xs 'cA 'ys 'cB 'xs 'ys)
                   (fact 'fubini-set-rectangle-cut 'xs 'cA 'mu 'ys 'cB 'nu 'ra 'rb 'xs 'ys)
                   (in-g!))
                  ((dk-contains? g 'COMPLEMENT-IN)
                   (dk-peel!)
                   (let* ((tgt (cadr (dk-goal))) (bv (cadr tgt)) (av (caddr tgt))
                          (ca (cut av)) (cb (cut bv))
                          (lhs (cut tgt))
                          (rhs (list 'COMPLEMENT-IN cb ca)))
                     (g-open! av) (g-open! bv)
                     (fact 'sigma-algebra-difference-closed pms-xy pms-ps bv av)
                     (fact 'power-complement-in-member pms-xy av bv)
                     (fact 'sigma-algebra-inter-closed-2 pms-xy pms-ps av pms-r)
                     (fact 'sigma-algebra-inter-closed-2 pms-xy pms-ps bv pms-r)
                     (pms-subset! ca cb (lambda (w) (fact 'subset-mem-fwd av bv w)))
                     (dk-split-all! (list (dk-fact! 'fubini-set-cut-bounds 'xs 'cA 'mu 'ys 'cB 'nu 'ra 'rb bv)))
                     (fact 'fubini-set-difference 'xs 'cA 'mu 'ys 'cB 'nu ca cb)
                     (pms-ext! lhs rhs (lambda (w) #t))
                     (dk-have! (pms-fs-of lhs) (lambda () (subst (list '= lhs rhs)) (ass)))
                     (in-g!)))
                  (#t
                   (let* ((landed (dk-peel!))
                          (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                          (mon (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
                          (tgt (cadr (dk-goal)))
                          (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN gc kv) (g-open! (list fv kv))))
