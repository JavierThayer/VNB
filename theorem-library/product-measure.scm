(define (pms-rect-side! o)
  (let* ((spec (pms-morient o))
         (smf (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2))
         (imeas (list-ref spec 3)) (smeas (list-ref spec 4))
         (spc (list-ref spec 5)) (ssig (list-ref spec 6)) (shead (list-ref spec 7)) (applythm (list-ref spec 8))
         (inside (if (eq? o 'x) 'aa 'bb)) (other (if (eq? o 'x) 'bb 'aa))
         (rc '(CARTESIAN aa bb))
         (h (smf rc))
         (c (list smeas other))
         (ind (list 'INDICATOR dom inside))
         (konst (list 'VNB-LAMBDA 'cx_ dom c))
         (sc (list 'PTWISE-SCALE dom c ind))
         (secin (if (eq? o 'x) 'x-section-rectangle-in 'y-section-rectangle-in))
         (secout (if (eq? o 'x) 'x-section-rectangle-out 'y-section-rectangle-out))
         (typthm (if (eq? o 'x) 'x-section-measure-type 'y-section-measure-type))
         (v0 (list 'FORALL 'pmv_ (list 'IMPLIES (list 'IN 'pmv_ dom)
                    (list '= (list h 'pmv_) (list 'etimes c (list ind 'pmv_)))))))
    (dk-peel!)
    (let ((parts (pms-meas-parts!)))
      (pms-sig-sub!)
      (fact 'rectangle-in-product-sigma 'xs 'cA 'ys 'cB 'aa 'bb)
      (fact typthm 'xs 'cA 'mu 'ys 'cB 'nu rc)
      (fact 'fun-apply-type-c smeas ssig 'RR-POS-STAR other)
      (fact 'fun-apply-type-c imeas dsig 'RR-POS-STAR inside)
      (fact 'rr-pos-star-nonneg c)
      (fact 'subset-mem-fwd ssig (list 'POWER spc) other)
      (pms-pow-sub! other spc)
      (pms-one-rps!)
      (fact 'measurable-fn-indicator dom dsig inside)
      (fact 'measurable-fn-const dom dsig c)
      ;; the values
      (dk-have! v0
        (lambda ()
          (let ((vv (dk-di-var!)))
            (dk-cite! applythm 'xs 'ys smeas rc vv)
            (subst (list '= (list h vv) (list smeas (list shead spc rc vv))))
            (use-em (list 'IN vv inside)
              (lambda ()
                (fact secin spc 'aa 'bb vv)
                (subst (list '= (list shead spc rc vv) other))
                (fact 'indicator-value-in dom inside vv)
                (subst (list '= (list ind vv) 1))
                (pms-and! (list 'IN c 'RR-POS-STAR) '(IN 1 RR-POS-STAR))
                (fact 'etimes-comm c 1)
                (subst (list '= (list 'etimes c 1) (list 'etimes 1 c)))
                (fact 'etimes-one-left c)
                (subst (list '= (list 'etimes 1 c) c))
                (rfl))
              (lambda ()
                (fact secout spc 'aa 'bb vv)
                (subst (list '= (list shead spc rc vv) 'EMPTY-SET))
                (fact 'indicator-value-out dom inside vv)
                (subst (list '= (list ind vv) 0))
                (fact 'etimes-zero-right c)
                (subst (list '= (list 'etimes c 0) 0))
                (subst (list '= (list smeas 'EMPTY-SET) 0))
                (rfl))))))
      ;; measurable
      (dk-have! (list 'FORALL 'pmv_ (list 'IMPLIES (list 'IN 'pmv_ dom)
                  (list '= (list h 'pmv_) (list 'etimes (list konst 'pmv_) (list ind 'pmv_)))))
        (lambda ()
          (let ((vv (dk-di-var!)))
            (dk-apply! (dk-ctx-form v0) vv)
            (dk-lam-b!)
            (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
      (fact 'measurable-fn-etimes-of-values dom dsig konst ind h)
      ;; the integral
      (fact 'indicator-simple dom dsig inside)
      (fact 'simple-fn-scale dom dsig ind c)
      (car (pms-parts! 'is-simple-fn (list dom dsig sc)))
      (cadr (pms-parts! 'is-measurable-fn (list dom dsig sc)))
      (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list h 'icx_) (list sc 'icx_))))
        (lambda ()
          (let ((vv (dk-di-var!)))
            (dk-apply! (dk-ctx-form v0) vv)
            (mac 'PTWISE-SCALE)
            (dk-lam-b!)
            (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
      (fact 'integral-congruence-ptwise dom dsig imeas h sc)
      (fact 'integral-homogeneous dom dsig imeas ind c)
      (fact 'integral-indicator dom dsig imeas inside)
      (pms-and! (list 'IN c 'RR-POS-STAR) (list 'IN (list imeas inside) 'RR-POS-STAR))
      (fact 'etimes-closed c (list imeas inside))
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin
                (subst (list '= (list 'INTEGRAL dom dsig imeas h) (list 'INTEGRAL dom dsig imeas sc)))
                (subst (list '= (list 'INTEGRAL dom dsig imeas sc) (list 'etimes c (list 'INTEGRAL dom dsig imeas ind))))
                (subst (list '= (list 'INTEGRAL dom dsig imeas ind) (list imeas inside)))
                (rfl))))))))

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu aa bb) (append pms-meas2 '((IN aa cA) (IN bb cB) (IN (nu bb) RR)))
   '(AND (IS-MEASURABLE-FN xs cA (X-SECTION-MEASURE xs ys nu (CARTESIAN aa bb)))
         (= (INTEGRAL xs cA mu (X-SECTION-MEASURE xs ys nu (CARTESIAN aa bb))) (etimes (nu bb) (mu aa)))))))
(pms-rect-side! 'x)
(qed 'x-section-measure-rectangle)
(topic! 'x-section-measure-rectangle 'set-quotient)

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu aa bb) (append pms-meas2 '((IN aa cA) (IN bb cB) (IN (mu aa) RR)))
   '(AND (IS-MEASURABLE-FN ys cB (Y-SECTION-MEASURE xs ys mu (CARTESIAN aa bb)))
         (= (INTEGRAL ys cB nu (Y-SECTION-MEASURE xs ys mu (CARTESIAN aa bb))) (etimes (mu aa) (nu bb)))))))
(pms-rect-side! 'y)
(qed 'y-section-measure-rectangle)
