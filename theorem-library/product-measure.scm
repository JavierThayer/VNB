(define pms-rect '(RECTANGLES xs cA ys cB))
(define pms-ps '(PRODUCT-SIGMA xs cA ys cB))
(define pms-xy '(CARTESIAN xs ys))
(define pms-sig2 '((IS-SIGMA-ALGEBRA xs cA) (IS-SIGMA-ALGEBRA ys cB)))

(sp (make-wff '(FORALL xs (FORALL cA (FORALL ys (FORALL cB
   (== (PRODUCT-SIGMA xs cA ys cB) (SIGMA-GENERATED (CARTESIAN xs ys) (RECTANGLES xs cA ys cB)))))))))
