(define (pms-section-membership! unfold head sp-of pair-of)
  (di)
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda ()
      (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) head))) "the section membership")))
