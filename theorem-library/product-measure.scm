           (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (pms-fs-of '(f pmn_))))))
   (pms-fs-of pms-cu))))
(dk-peel!)
(let* ((fsh (or (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (pms-fs-of '(f pmn_))))) (error "the Fubini hypothesis")))
       (sx (lambda (c) (list 'X-SECTION-MEASURE 'xs 'ys 'nu c)))
       (sy (lambda (c) (list 'Y-SECTION-MEASURE 'xs 'ys 'mu c)))
       (ix (lambda (c) (list 'INTEGRAL 'xs 'cA 'mu (sx c))))
       (iy (lambda (c) (list 'INTEGRAL 'ys 'cB 'nu (sy c))))
       (fsk! (lambda (k) (dk-apply! fsh k) (pms-parts! 'is-fubini-set (list 'xs 'cA 'mu 'ys 'cB 'nu (list 'f k)))))
       (fsc! (lambda (k) (dk-apply! fsh k) (pms-close-by-parts! 'is-fubini-set (list 'xs 'cA 'mu 'ys 'cB 'nu (list 'f k))))))
  (pms-meas-parts!)
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'xs 'cA (sx '(f pmn_)))))
    (lambda () (let ((kv (dk-di-var!))) (fsc! kv))))
  (dk-have! (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN 'ys 'cB (sy '(f pmn_)))))
    (lambda () (let ((kv (dk-di-var!))) (fsc! kv))))
  (dk-split! (dk-fact! 'x-section-measure-union 'xs 'cA 'mu 'ys 'cB 'nu 'f))
  (dk-split! (dk-fact! 'y-section-measure-union 'xs 'cA 'mu 'ys 'cB 'nu 'f))
  (let ((mx (list 'VNB-LAMBDA 'pmn_ 'NN (ix '(f pmn_))))
        (my (list 'VNB-LAMBDA 'pmn_ 'NN (iy '(f pmn_)))))
    (dk-fun-ext! mx my 'NN 'RR-POS-STAR
      (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (fsk! kv) (pms-then-ass! (lambda () (fact 'integral-in 'xs 'cA 'mu (sx (list 'f kv)))))))))
      (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (fsk! kv) (pms-then-ass! (lambda () (fact 'integral-in 'ys 'cB 'nu (sy (list 'f kv)))))))))
      (lambda (kv)
        (dk-lam-b!)
        (fsc! kv)))
    (mac 'IS-FUBINI-SET)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (subst (list '= (iy pms-cu) (list 'ESUP (list 'IMAGE my 'NN))))
              (subst (list '= my mx))
              (ass)))))))
