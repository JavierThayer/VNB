(define (pms-rect-sec! o in?)
  (dk-peel!)
  (let* ((spec (pms-orient o))
         (head (list-ref spec 0)) (spc (list-ref spec 1)) (pt (list-ref spec 4))
         (inside (if (eq? o 'x) 'aa 'bb)) (other (if (eq? o 'x) 'bb 'aa))
         (rc '(CARTESIAN aa bb))
         (sec (list head spc rc pt))
         (pc! (lambda (z) (fact 'pair-cartesian-iff 'aa 'bb (if (eq? o 'x) pt z) (if (eq? o 'x) z pt)))))
    (if in?
        (pms-ext! sec other (lambda (z) (pc! z) (fact 'subset-mem-fwd other spc z)) (list 'IN pt inside))
        (pms-ext! sec 'EMPTY-SET (lambda (z) (pc! z) (fact 'empty-set-has-no-members z)) (list 'NOT (list 'IN pt inside))))
    (ass)))

