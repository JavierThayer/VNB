                     (dk-have! (pms-fs-of lhs) (lambda () (subst (list '= lhs bug)) (ass)))
                     (in-g!)))))))))
  ;; the rectangles are in the class
  (dk-have! (list 'SUBSET pms-rect gc)
    (lambda ()
