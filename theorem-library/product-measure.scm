;;; =====================================================================
;;; (21) SERIES: ESUM is the supremum of the prefix sums, and the integral of a
;;;      series of non-negative measurable functions is the series of the
;;;      integrals (Beppo Levi; integral-finsum on the prefixes, monotone
;;;      convergence on their sup).
;;; =====================================================================

;;; f in FUN(NN, RR-POS-STAR): (IN (ESUM f) RR-POS-STAR) (the cth-dom! / cth-esum-type!
;;; pattern of caratheodory.scm)
(define (pms-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (pms-and! (list 'IN fv '(FUN NN)) '(IN NN SET))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))

(define (pms-prefix-l fv) (list 'VNB-LAMBDA 'pfn_ 'NN (pms-fs fv '(ORD-SEGMENT pfn_))))

(sp (make-wff (forall-guarded '(f) '((IN f (FUN NN RR-POS-STAR)))
   (list '= '(ESUM f) (list 'ESUP (list 'IMAGE (pms-prefix-l 'f) 'NN))))))
(dk-peel!)
(let* ((l (pms-prefix-l 'f)) (p (list 'IMAGE l 'NN)) (es (list 'ESUP p)))
  (pms-esum-type! 'f)
  (dk-have! (list 'IN l '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((nv (dk-di-var!))) (pms-then-ass! (lambda () (fact 'rps-prefix-type 'f nv))))))
                             (lambda () (fact 'nn-is-set) (ass))))
  (dk-have! (list 'SUBSET p 'RR-POS-STAR)
    (lambda () (mac 'subset-def) (pms-forall! (lambda (wv) (pms-then-ass! (lambda () (fact 'image-subset-codomain 'NN 'RR-POS-STAR l wv)))))))
  (fact 'esup-in p)
  ;; every prefix sum is in the image, below ESUP
  (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (pms-fs 'f '(ORD-SEGMENT n)) es)))
    (lambda ()
      (let* ((nv (dk-di-var!)) (pre (pms-fs 'f (list 'ORD-SEGMENT nv))))
        (fact 'rps-prefix-type 'f nv)
        (fact 'membership-implies-sethood pre 'RR-POS-STAR)
        (dk-have! (list 'IN pre p)
          (lambda ()
            (mac 'image-membership-iff)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) 'FORSOME)
                       (ew nv)
                       (dk-conj-close! (lambda () (if (not (dk-ass!)) (if (not (dk-lam-b!)) (rfl))))))
                      (#t (error "prefix in image" (dk-goal))))))))
        (dk-apply! (dk-fact! 'esup-upper p) pre)
        (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
  (fact 'esum-nn-le-of-prefixes 'f es)
  ;; every member of the image is below ESUM
  (dk-have! (list 'FORALL 'pmw_ (list 'IMPLIES (list 'IN 'pmw_ p) (list '<= 'pmw_ '(ESUM f))))
    (lambda ()
      (let* ((wv (dk-di-var!))
             (ex (dk-project! (list 'FORSOME 'pmk_ (list 'AND '(IN pmk_ NN) (list '= (list l 'pmk_) wv)))
                   (lambda () (let ((iff (dk-cite! 'image-membership-iff l 'NN wv)))
                                (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             (kv (dk-skolem! ex)))
        (fact 'esum-nn-prefix-le 'f kv)
        (subst (list '= wv (list l kv)))
        (if (not (dk-lam-b!)) (ass)))))
  (pms-and! '(IN (ESUM f) RR-POS-STAR) (list 'FORALL 'pmw_ (list 'IMPLIES (list 'IN 'pmw_ p) (list '<= 'pmw_ '(ESUM f)))))
  (dk-apply! (dk-fact! 'esup-least p) '(ESUM f))
  (pms-and! '(IN (ESUM f) RR-POS-STAR) (list 'IN es 'RR-POS-STAR))
  (pms-and! (list '<= '(ESUM f) es) (list '<= es '(ESUM f)))
  (pms-then-ass! (lambda () (fact 'rr-pos-star-le-antisymm '(ESUM f) es))))
(qed 'esum-as-esup-prefix)
(topic! 'esum-as-esup-prefix 'set-quotient)

(define pms-gx (lambda (x) (list 'VNB-LAMBDA 'ifv_ 'NN (list '(g ifv_) x))))
(define pms-hg '(VNB-LAMBDA ifv_ NN (INTEGRAL omega cA mu (g ifv_))))
(define (pms-fn n) (list 'VNB-LAMBDA 'ifx_ 'omega (pms-fs (pms-gx 'ifx_) (list 'ORD-SEGMENT n))))

(sp (make-wff (forall-guarded '(omega cA mu g h)
   (list '(IS-MEASURE omega cA mu)
         '(FORALL ifv_ (IMPLIES (IN ifv_ NN) (IS-MEASURABLE-FN omega cA (g ifv_))))
         '(IN h (FUN omega RR-POS-STAR))
         (list 'FORALL 'bex_ (list 'IMPLIES '(IN bex_ omega) (list '= '(h bex_) (list 'ESUM (pms-gx 'bex_))))))
   (list 'AND '(IS-MEASURABLE-FN omega cA h)
         (list '= '(INTEGRAL omega cA mu h) (list 'ESUM pms-hg))))))
(dk-peel!)
(pms-parts! 'is-measure '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'nn-is-set)
(let* ((gm (dk-ctx-form '(FORALL ifv_ (IMPLIES (IN ifv_ NN) (IS-MEASURABLE-FN omega cA (g ifv_))))))
       (hv (dk-ctx-form (list 'FORALL 'bex_ (list 'IMPLIES '(IN bex_ omega) (list '= '(h bex_) (list 'ESUM (pms-gx 'bex_)))))))
       ;; v in NN: g v measurable and typed, its integral typed
       (gv! (lambda (v)
              (pms-apply1! gm v)
              (cadr (pms-parts! 'is-measurable-fn (list 'omega 'cA (list 'g v))))
              (fact 'integral-in 'omega 'cA 'mu (list 'g v))))
       ;; the typings of the series at x, and of the series of integrals
       (gxt! (lambda (x)
               (dk-have! (list 'IN (pms-gx x) '(FUN NN RR-POS-STAR))
                 (lambda () (pms-lt! (lambda (kv) (gv! kv)
                                        (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list 'g kv) 'omega 'RR-POS-STAR x)))))))))
       (hgt! (lambda ()
               (dk-have! (list 'IN pms-hg '(FUN NN RR-POS-STAR))
                 (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (gv! kv) (ass))) (lambda () (ass)))))))
       ;; N in NN: the prefix of length N, through integral-finsum
       (seg! (lambda (n)
               (let ((sg (list 'ORD-SEGMENT n)))
                 (fact 'nn-subset-ord n)
                 (fact 'ord-segment-is-set n)
                 (fact 'card-segment n)
                 (dk-have! (list 'IN (list 'CARD sg) 'NN) (lambda () (subst (list '= (list 'CARD sg) n)) (ass)))
                 (dk-have! (list 'SUBSET sg 'NN)
                   (lambda () (mac 'subset-def) (pms-forall! (lambda (kv) (pms-then-ass! (lambda () (fact 'ord-segment-nn-subset n kv)))))))
                 (dk-have! (list 'FORALL 'ifv_ (list 'IMPLIES (list 'IN 'ifv_ sg) '(IS-MEASURABLE-FN omega cA (g ifv_))))
                   (lambda () (let ((kv (dk-di-var!))) (fact 'ord-segment-nn-subset n kv) (pms-apply1! gm kv) (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
                 (let ((cj (dk-cite! 'integral-finsum 'omega 'cA 'mu 'NN sg 'g)))
