(define pms-dg '(DYNKIN-GENERATED omega cE))
(define pms-dg-body
  '(SEP dga_ (POWER omega)
     (FORALL dgb_ (IMPLIES (AND (IS-DYNKIN-SYSTEM omega dgb_) (SUBSET cE dgb_)) (IN dga_ dgb_)))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cE (list '== pms-dg pms-dg-body)))))
(di)
(mac 'DYNKIN-GENERATED)
(qrfl)
(qed 'dynkin-generated-unfold)
(topic! 'dynkin-generated-unfold 'plumbing)

(sp (make-wff '(FORALL omega (FORALL cE (FORALL a_
   (IFF (IN a_ (DYNKIN-GENERATED omega cE))
        (AND (IN a_ (POWER omega))
             (FORALL dgb_ (IMPLIES (AND (IS-DYNKIN-SYSTEM omega dgb_) (SUBSET cE dgb_)) (IN a_ dgb_))))))))))
(di)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (mac-h 'dynkin-generated-unfold '(IN a_ (DYNKIN-GENERATED omega cE)))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) 'a_))) "the SEP membership"))
    (dk-split-all!)
    (dk-conj-close! dk-ass!))
  (lambda ()
    (dk-split-all!)
    (mac 'DYNKIN-GENERATED)
    (in-sep! dk-ass! dk-ass!)))
(qed 'dynkin-generated-membership)
(topic! 'dynkin-generated-membership 'set-quotient)

;;; the read-offs, for a generator class CE (a symbol or a term)
(define (pms-dg-of ce) (list 'DYNKIN-GENERATED 'omega ce))
(define (pms-dg-open! a ce)
  (let ((iff (dk-cite! 'dynkin-generated-membership 'omega ce a)))
    (let* ((p1 (dk-project! (list 'IN a '(POWER omega)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))
           (p2 (dk-project! (caddr (caddr iff)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
      (list p1 p2))))
;;; (IN a (POWER omega)) from (IN a DG(cE)), proved in place when it is the goal
(define (pms-dg-pow! a ce)
  (let ((iff (dk-cite! 'dynkin-generated-membership 'omega ce a)))
    (pms-project! (list 'IN a '(POWER omega)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
;;; a in DG(cE), B a Dynkin system containing cE: a in B
(define (pms-dg-in! a ce b)
  (let ((every (cadr (pms-dg-open! a ce))))
    (pms-and2! (list 'IS-DYNKIN-SYSTEM 'omega b) (list 'SUBSET ce b))
    (dk-apply! every b)))
;;; prove the focus goal (IN a DG): POW proves (IN a (POWER omega)); EVERY, a procedure of
;;; the eigenvariable B, proves (IN a B) from (IS-DYNKIN-SYSTEM omega B), (SUBSET cE B)
(define (pms-into-dg! pow every)
  (mac 'dynkin-generated-membership)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (pow)
          (let* ((landed (dk-peel!))
                 (cj (find-first (lambda (f) (dk-head-is? f 'AND)) landed))
                 (bv (caddr (cadr cj))))
            (dk-split! cj)
            (every bv))))))

;;; the five conjuncts of IS-DYNKIN-SYSTEM(omega, D): SET, inside POWER, omega in,
;;; proper differences, nondecreasing unions
(define (pms-dy-parts! d) (pms-parts! 'is-dynkin-system (list 'omega d)))

(sp (make-wff (forall-guarded '(omega cE) '((IN omega SET) (SUBSET cE (POWER omega)))
   (list 'IS-DYNKIN-SYSTEM 'omega pms-dg))))
(dk-peel!)
(mac 'IS-DYNKIN-SYSTEM)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (pms-forall! (lambda (zv) (pms-dg-pow! zv 'cE))))
            ((dk-head-is? g 'IN)
             (pms-into-dg!
               (lambda () (pms-then-ass! (lambda () (fact 'power-whole-in 'omega))))
               (lambda (bv) (pms-close-by-parts! 'is-dynkin-system (list 'omega bv)))))
            ((dk-contains? g 'COMPLEMENT-IN)
             (dk-peel!)
             (let* ((tgt (cadr (dk-goal))) (bv (cadr tgt)) (av (caddr tgt)))
               (pms-dg-pow! bv 'cE)
               (fact 'power-complement-in-member 'omega av bv)
               (pms-into-dg!
                 (lambda () (ass))
                 (lambda (dv)
                   (let ((parts (pms-dy-parts! dv)))
                     (pms-dg-in! av 'cE dv)
                     (pms-dg-in! bv 'cE dv)
                     (dk-apply! (list-ref parts 3) av bv)
                     (ass))))))
            (#t
             (let* ((landed (dk-peel!))
                    (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed))))
               (pms-retype! fv pms-dg '(POWER omega)
                 (lambda (x) (pms-dg-pow! x 'cE)))
               (fact 'power-fun-union-closed 'omega fv)
               (pms-into-dg!
                 (lambda () (ass))
                 (lambda (dv)
                   (let ((parts (pms-dy-parts! dv)))
                     (pms-retype! fv pms-dg dv (lambda (x) (pms-dg-in! x 'cE dv)))
                     (dk-apply! (list-ref parts 4) fv)
                     (ass))))))))))
(qed 'dynkin-generated-is-dynkin)
(topic! 'dynkin-generated-is-dynkin 'set-quotient)
;;; =====================================================================
;;; (3) the intersection section of a Dynkin system is a Dynkin system:
;;;     for ds in dd, { e subset omega : ds n e in dd } is one.
;;; =====================================================================

(define pms-isec '(SEP die_ (POWER omega) (IN (INTERSECTION ds die_) dd)))
(sp (make-wff (forall-guarded '(omega dd ds) '((IS-DYNKIN-SYSTEM omega dd) (IN ds dd))
   (list 'IS-DYNKIN-SYSTEM 'omega pms-isec))))
(dk-peel!)
(let* ((parts (pms-dy-parts! 'dd))
       (sc pms-isec)
       (sec (lambda (x) (list 'INTERSECTION 'ds x)))
       (sc-open! (lambda (x)
                   (let ((m (or (dk-ctx-form (list 'IN x sc)) (error "sc-open!: not in context" x))))
                     (pms-project! (list 'IN x '(POWER omega)) (lambda () (sep-me m) (dk-split-all!)))
                     (if (dk-ctx-form (list 'IN x sc))
                         (pms-project! (list 'IN (sec x) 'dd) (lambda () (sep-me m) (dk-split-all!))))))))
  (fact 'subset-mem-fwd 'dd '(POWER omega) 'ds)
  (pms-pow-sub! 'ds 'omega)
  (mac 'IS-DYNKIN-SYSTEM)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (pms-forall! (lambda (zv) (sep-me (list 'IN zv sc)) (dk-split-all!) (ass))))
              ((dk-head-is? g 'IN)
               (fact 'power-whole-in 'omega)
               (pms-ext! (sec 'omega) 'ds (lambda (w) (fact 'subset-mem-fwd 'ds 'omega w)))
               (in-sep! dk-ass!
                 (lambda () (pms-then-ass! (lambda () (subst (list '= (sec 'omega) 'ds)))))))
              ((dk-contains? g 'COMPLEMENT-IN)
               (dk-peel!)
               (let* ((tgt (cadr (dk-goal))) (bv (cadr tgt)) (av (caddr tgt))
                      (lhs (sec tgt))
                      (rhs (list 'COMPLEMENT-IN (sec bv) (sec av))))
                 (sc-open! av) (sc-open! bv)
                 (fact 'power-complement-in-member 'omega av bv)
                 (pms-subset! (sec av) (sec bv) (lambda (w) (fact 'subset-mem-fwd av bv w)))
                 (dk-apply! (list-ref parts 3) (sec av) (sec bv))
                 (pms-ext! lhs rhs (lambda (w) #t))
                 (in-sep! dk-ass!
                   (lambda () (pms-then-ass! (lambda () (subst (list '= lhs rhs))))))))
              (#t
               (let* ((landed (dk-peel!))
                      (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                      (mon (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
                      (tgt (cadr (dk-goal)))
                      (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN sc kv) (sc-open! (list fv kv))))
                      (gr (pms-abstract! 'NN 'dd (lambda (k) (sec (list fv k)))
                            (lambda (kv) (pms-then-ass! (lambda () (fk! kv))))
                            (lambda (kv) (fk! kv) (fact 'membership-implies-sethood (sec (list fv kv)) 'dd))))
                      (gv (car gr)) (ge (cdr gr))
                      (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv)
                              (list '== (list gv kv) (sec (list fv kv)))))
                      (bug (list 'BIG-UNION 'pmj_ 'NN (list gv 'pmj_)))
                      (lhs (sec tgt)))
                 (pms-retype! fv sc '(POWER omega)
                   (lambda (x) (pms-project! (list 'IN x '(POWER omega))
                                 (lambda () (sep-me (dk-ctx-form (list 'IN x sc))) (dk-split-all!)))))
                 (fact 'power-fun-union-closed 'omega fv)
                 ;; g is nondecreasing
                 (dk-have! (list 'FORALL 'dyn_ (list 'IMPLIES '(IN dyn_ NN)
                             (list 'SUBSET (list gv 'dyn_) (list gv '(succ dyn_)))))
                   (lambda ()
                     (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                       (fact 'nn-succ-closed nv)
                       (gk! nv) (gk! sn)
                       (dk-apply! mon nv)
                       (subst (list '= (list gv nv) (sec (list fv nv))))
                       (subst (list '= (list gv sn) (sec (list fv sn))))
                       (pms-then-ass! (lambda ()
                         (pms-subset! (sec (list fv nv)) (sec (list fv sn)) (lambda (w) (fact 'subset-mem-fwd (list fv nv) (list fv sn) w))))))))
                 (dk-apply! (list-ref parts 4) gv)
                 ;; ds n U f = U g
                 (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ bug)))
                   (lambda ()
                     (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
                       (dk-iff! (lambda (g) (equal? g (list 'IN wv bug)))
                         (lambda ()
                           (let* ((i1 (dk-cite! 'intersection-membership 'ds tgt wv)))
                             (dk-have! (list 'IN wv tgt) (lambda () (pms-prop-on! wv)))
                             (dk-have! (list 'IN wv 'ds) (lambda () (pms-prop-on! wv)))
                             (let* ((r (pms-bu-open! wv tgt)) (kv (car r)))
                               (gk! kv)
                               (fact 'intersection-membership 'ds (list fv kv) wv)
                               (dk-have! (list 'IN wv (list gv kv))
                                 (lambda () (subst (list '= (list gv kv) (sec (list fv kv)))) (pms-prop-on! wv)))
                               (pms-bu-close! kv))))
                         (lambda ()
                           (let* ((r (pms-bu-open! wv bug)) (kv (car r)))
                             (gk! kv)
                             (dk-rewrite-h! (cdr r) (list gv kv) (sec (list fv kv)))
                             (fact 'intersection-membership 'ds (list fv kv) wv)
                             (fact 'intersection-membership 'ds tgt wv)
                             (dk-have! (list 'IMPLIES (list 'IN wv (list fv kv)) (list 'IN wv tgt))
                               (lambda () (di) (pms-bu-close! kv)))
                             (pms-prop-on! wv)))))))
                 (fact 'class-extensionality lhs bug)
                 (in-sep! dk-ass! (lambda () (pms-then-ass! (lambda () (subst (list '= lhs bug)))))))))))))
(qed 'dynkin-inter-section)
(topic! 'dynkin-inter-section 'set-quotient)

;;; =====================================================================
;;; (4) a Dynkin system closed under intersection is a sigma-algebra.
;;; =====================================================================

(sp (make-wff (forall-guarded '(omega dd) '((IS-DYNKIN-SYSTEM omega dd) (IS-PI-SYSTEM dd))
   '(IS-SIGMA-ALGEBRA omega dd))))
(dk-peel!)
(let* ((parts (pms-dy-parts! 'dd))
       (pi (car (pms-parts! 'is-pi-system '(dd))))
       (cpl (lambda (x) (list 'COMPLEMENT-IN 'omega x)))
       (cpl! (lambda (av)
               (fact 'subset-mem-fwd 'dd '(POWER omega) av)
               (pms-pow-sub! av 'omega)
               (dk-apply! (list-ref parts 3) av 'omega))))
  (dk-have! '(IS-ALGEBRA-OF-SETS omega dd)
    (lambda ()
      (mac 'IS-ALGEBRA-OF-SETS)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-ass!) #t)
                  ((dk-head-is? g 'FORSOME) (ew 'omega) (ass))
                  ((dk-contains? g 'UNION)
                   (let* ((gl (begin (dk-peel!) (cadr (dk-goal))))
                          (av (cadr gl)) (bv (caddr gl))
                          (u (list 'UNION av bv))
                          (i (list 'INTERSECTION (cpl av) (cpl bv)))
                          (r (cpl i)))
                     (cpl! av) (cpl! bv)
                     (dk-apply! pi (cpl av) (cpl bv))
                     (cpl! i)
                     (fact 'subset-mem-fwd 'dd '(POWER omega) bv)
                     (pms-pow-sub! bv 'omega)
                     (pms-ext! u r (lambda (w) (fact 'subset-mem-fwd av 'omega w) (fact 'subset-mem-fwd bv 'omega w)))
                     (pms-then-ass! (lambda () (subst (list '= u r))))))
                  ((dk-contains? g 'INTERSECTION)
                   (let* ((gl (begin (dk-peel!) (cadr (dk-goal))))
                          (av (cadr gl)) (bv (caddr gl)))
                     (dk-apply! pi av bv)
                     (ass)))
                  (#t
                   (let ((av (dk-di-var!)))
                     (cpl! av)
                     (ass)))))))))
  (pms-then-ass! (lambda () (fact 'algebra-monotone-union-sigma-algebra 'omega 'dd))))
(qed 'dynkin-pi-is-sigma-algebra)
(topic! 'dynkin-pi-is-sigma-algebra 'set-quotient)

;;; =====================================================================
;;; (5) DYNKIN'S PI-LAMBDA THEOREM: a Dynkin system containing a pi-system contains the
;;;     sigma-algebra the pi-system generates.
;;; =====================================================================

(sp (make-wff (forall-guarded '(omega dd pp)
   '((IS-DYNKIN-SYSTEM omega dd) (IS-PI-SYSTEM pp) (SUBSET pp dd))
   '(SUBSET (SIGMA-GENERATED omega pp) dd))))
(dk-peel!)
(let* ((parts (pms-dy-parts! 'dd))
       (ppi (car (pms-parts! 'is-pi-system '(pp))))
       (dg (pms-dg-of 'pp))
       (sa (lambda (a) (list 'SEP 'die_ '(POWER omega) (list 'IN (list 'INTERSECTION a 'die_) dg)))))
  (fact 'subset-trans 'pp 'dd '(POWER omega))
  (fact 'dynkin-generated-is-dynkin 'omega 'pp)
  (let ((dgparts (pms-dy-parts! dg)))
    ;; pp inside DG
    (dk-have! (list 'SUBSET 'pp dg)
      (lambda ()
        (mac 'subset-def)
        (pms-forall!
          (lambda (ev)
            (fact 'subset-mem-fwd 'pp '(POWER omega) ev)
            (pms-into-dg! dk-ass!
              (lambda (bv) (fact 'subset-mem-fwd 'pp bv ev) (ass)))))))
    ;; DG inside the section S_a of a member a: SC is S_a in context, a Dynkin system
    ;; containing pp (proved by PP-IN!, a procedure of the element)
    (let ((dg-in-sec!
            (lambda (a pp-in!)
              (fact 'dynkin-inter-section 'omega dg a)
              (dk-have! (list 'SUBSET 'pp (sa a))
                (lambda ()
                  (mac 'subset-def)
                  (pms-forall!
                    (lambda (ev)
                      (fact 'subset-mem-fwd 'pp '(POWER omega) ev)
                      (in-sep! dk-ass! (lambda () (pp-in! ev)))))))
              (dk-have! (list 'SUBSET dg (sa a))
                (lambda ()
                  (mac 'subset-def)
                  (pms-forall! (lambda (zv) (pms-dg-in! zv 'pp (sa a)) (ass))))))))
      ;; step 1: a in pp, z in DG: a n z in DG
      (dk-have! (list 'FORALL 'pla_ (list 'IMPLIES '(IN pla_ pp)
                  (list 'FORALL 'plz_ (list 'IMPLIES (list 'IN 'plz_ dg) (list 'IN '(INTERSECTION pla_ plz_) dg)))))
        (lambda ()
          (let* ((gl (begin (dk-peel!) (cadr (dk-goal))))
                 (av (cadr gl)) (zv (caddr gl)))
            (fact 'subset-mem-fwd 'pp dg av)
            (dg-in-sec! av
              (lambda (ev)
                (dk-apply! ppi av ev)
                (fact 'subset-mem-fwd 'pp dg (list 'INTERSECTION av ev))
                (ass)))
            (fact 'subset-mem-fwd dg (sa av) zv)
            (sep-me (list 'IN zv (sa av)))
            (dk-split-all!)
            (ass))))
      (let ((step1 (dk-ctx-form (list 'FORALL 'pla_ (list 'IMPLIES '(IN pla_ pp)
                      (list 'FORALL 'plz_ (list 'IMPLIES (list 'IN 'plz_ dg) (list 'IN '(INTERSECTION pla_ plz_) dg))))))))
        ;; step 2: DG is a pi-system
        (dk-have! (list 'IS-PI-SYSTEM dg)
          (lambda ()
            (mac 'IS-PI-SYSTEM)
            (let* ((gl (begin (dk-peel!) (cadr (dk-goal))))
                   (bv (cadr gl)) (cv (caddr gl)))
              (dg-in-sec! bv
                (lambda (ev)
                  (dk-apply! step1 ev bv)
                  (car (pms-dg-open! bv 'pp))
                  (pms-pow-sub! bv 'omega)
                  (pms-ext! (list 'INTERSECTION bv ev) (list 'INTERSECTION ev bv) (lambda (w) #t))
                  (pms-then-ass! (lambda () (subst (list '= (list 'INTERSECTION bv ev) (list 'INTERSECTION ev bv)))))))
              (fact 'subset-mem-fwd dg (sa bv) cv)
              (sep-me (list 'IN cv (sa bv)))
              (dk-split-all!)
              (ass))))
        (fact 'dynkin-pi-is-sigma-algebra 'omega dg)
        (mac 'subset-def)
        (pms-forall!
          (lambda (zv)
            (fact 'sigma-generated-in-every 'omega 'pp zv dg)
            (pms-dg-in! zv 'pp 'dd)
            (ass)))))))
