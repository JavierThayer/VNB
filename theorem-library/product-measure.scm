(define (pms-xy-set!)
  (fact 'sigma-algebra-ambient-set 'xs 'cA)
  (fact 'sigma-algebra-ambient-set 'ys 'cB)
  (dk-have! (list 'IN pms-xy 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!))))
(define (pms-rect-sub!)
  (dk-have! (list 'SUBSET pms-rect (list 'POWER pms-xy))
    (lambda ()
      (mac 'subset-def)
      (pms-forall! (lambda (zv)
        (let ((iff (dk-cite! 'rectangles-membership 'xs 'cA 'ys 'cB zv)))
          (pms-project! (list 'IN zv (list 'POWER pms-xy))
            (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))))))

(sp (make-wff (forall-guarded '(xs cA ys cB) pms-sig2 (list 'IS-SIGMA-ALGEBRA pms-xy pms-ps))))
(dk-peel!)
(pms-ps-unfold!)
(subst (list '= pms-ps (list 'SIGMA-GENERATED pms-xy pms-rect)))
(pms-xy-set!)
(pms-rect-sub!)
(pms-then-ass! (lambda () (fact 'sigma-generated-is-sigma-algebra pms-xy pms-rect)))
