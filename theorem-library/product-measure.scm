(sp (make-wff (forall-guarded '(xs cA ys cB aa bb) (append pms-sig2 '((IN aa cA) (IN bb cB)))
   (list 'IN '(CARTESIAN aa bb) pms-ps))))
(dk-peel!)
(pms-ps-unfold!)
(subst (list '= pms-ps (list 'SIGMA-GENERATED pms-xy pms-rect)))
(fact 'rectangle-in-rectangles 'xs 'cA 'ys 'cB 'aa 'bb)
(pms-rect-sub!)
(fact 'subset-mem-fwd pms-rect (list 'POWER pms-xy) '(CARTESIAN aa bb))
(dk-have! (list 'FORALL 'cb_ (list 'IMPLIES (list 'AND (list 'IS-SIGMA-ALGEBRA pms-xy 'cb_) (list 'SUBSET pms-rect 'cb_))
