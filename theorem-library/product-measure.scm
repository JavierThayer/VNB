(topic! 'cartesian-in-power-product 'set-quotient)

;;; (aa x bb) n (cc_ x dd) = (aa n cc_) x (bb n dd)
(sp (make-wff '(FORALL aa (FORALL bb (FORALL cc_ (FORALL dd
   (= (INTERSECTION (CARTESIAN aa bb) (CARTESIAN cc_ dd))
      (CARTESIAN (INTERSECTION aa cc_) (INTERSECTION bb dd)))))))))
(di)
(pms-ext2! '(INTERSECTION (CARTESIAN aa bb) (CARTESIAN cc_ dd))
           '(CARTESIAN (INTERSECTION aa cc_) (INTERSECTION bb dd))
  (lambda (w)
    (pms-inter-open! w '(CARTESIAN aa bb) '(CARTESIAN cc_ dd))
    (pms-cart-open! w 'aa 'bb)
    (pms-cart-open! w 'cc_ 'dd)
    (mac 'cartesian-membership-nth)
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (mac 'intersection-membership) (dk-conj-close! dk-ass!))))))
  (lambda (w)
    (pms-cart-open! w '(INTERSECTION aa cc_) '(INTERSECTION bb dd))
    (pms-inter-open! (list 'NTH 1 w) 'aa 'cc_)
    (pms-inter-open! (list 'NTH 2 w) 'bb 'dd)
    (mac 'intersection-membership)
    (dk-conj-close! (lambda () (mac 'cartesian-membership-nth) (dk-conj-close! dk-ass!)))))
(ass)
