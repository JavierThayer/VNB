                     (fact 'fubini-set-union 'xs 'cA 'mu 'ys 'cB 'nu gv)
                     ;; (U f) n R = U g
                     (pms-ext2! lhs bug
                       (lambda (w)
                         (pms-inter-open! w tgt pms-r)
