(define (pms-simple-side! o)
  (let* ((spec (pms-iorient o))
         (si (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2)) (imeas (list-ref spec 3))
         (ispc (list-ref spec 4)) (isig (list-ref spec 5)) (smeas (list-ref spec 6))
         (fsec (list-ref spec 7)) (iapply (list-ref spec 8))
         (smf (if (eq? o 'x) (lambda (c) (list 'X-SECTION-MEASURE 'xs 'ys 'nu c)) (lambda (c) (list 'Y-SECTION-MEASURE 'xs 'ys 'mu c))))
         (shead (if (eq? o 'x) 'X-SECTION 'Y-SECTION))
         (sapply (if (eq? o 'x) 'x-section-measure-apply 'y-section-measure-apply))
         (secthm (if (eq? o 'x) 'x-section-measurable 'y-section-measurable))
         (simpthm (if (eq? o 'x) 'x-section-simple-integral 'y-section-simple-integral))
         (h (si 's))
         (fam (list 'VNB-LAMBDA 'sv_ pms-v (list 'PTWISE-SCALE dom 'sv_ (smf (pms-lev 'sv_)))))
         (gx (lambda (x) (list 'VNB-LAMBDA 'sv_ pms-v (list 'etimes 'sv_ (list smeas (list shead ispc (pms-lev 'sv_) x))))))
         (fammeas (list 'FORALL 'ifv_ (list 'IMPLIES (list 'IN 'ifv_ pms-v) (list 'IS-MEASURABLE-FN dom dsig (list fam 'ifv_)))))
         (lv! (lambda (v)
                (pms-img-val! v)
                (dk-apply! (dk-fact! 'measurable-fn-level-set pms-xy pms-ps 's) v)
                (fact 'fubini-sets 'xs 'cA 'mu 'ys 'cB 'nu (pms-lev v))
                (pms-parts! 'is-fubini-set (list 'xs 'cA 'mu 'ys 'cB 'nu (pms-lev v)))))
         ;; v in V, x in dom: the value etimes(v, smeas(section of {s = v} at x)) typed
         (vx! (lambda (v x)
                (fact secthm 'xs 'cA 'ys 'cB (pms-lev v) x)
                (fact 'fun-apply-type-c smeas isig 'RR-POS-STAR (list shead ispc (pms-lev v) x))
                (pms-and! (list 'IN v 'RR-POS-STAR) (list 'IN (list smeas (list shead ispc (pms-lev v) x)) 'RR-POS-STAR))
                (fact 'etimes-closed v (list smeas (list shead ispc (pms-lev v) x)))
                (dk-cite! sapply 'xs 'ys smeas (pms-lev v) x))))
    (dk-have! fammeas
      (lambda ()
        (let ((vv (dk-di-var!)))
          (lv! vv)
          (pms-lb!)
          (pms-then-ass! (lambda () (fact 'ptwise-scale-measurable dom dsig (smf (pms-lev vv)) vv))))))
    (fact 'subset-refl pms-v)
    (let* ((fin (dk-split! (dk-fact! 'integral-finsum dom dsig imeas pms-v pms-v fam)))
           (mf (find-first (lambda (f) (dk-head-is? f 'IS-MEASURABLE-FN)) fin))
           (eqf (find-first (lambda (f) (dk-head-is? f '=)) fin))
           (ff (cadddr mf))
           (hl (caddr (caddr eqf))))
      (if (eq? o 'x)
          (fact 'x-section-integral-type 'xs 'cA 'ys 'cB 'nu 's)
          (fact 'y-section-integral-type 'xs 'cA 'mu 'ys 'cB 's))
      (cadr (pms-parts! 'is-measurable-fn (list dom dsig ff)))
      ;; h = F pointwise, both orientations
      (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list h 'icx_) (list ff 'icx_))))
        (lambda ()
          (let ((xv (dk-di-var!)))
            (if (eq? o 'x)
                (begin (dk-cite! iapply 'xs 'ys 'cB 'nu 's xv) (fact simpthm 'xs 'cA 'ys 'cB 'nu 's xv))
                (begin (dk-cite! iapply 'xs 'cA 'mu 'ys 's xv) (fact simpthm 'xs 'cA 'mu 'ys 'cB 's xv)))
            (subst (list '= (list h xv) (list 'INTEGRAL ispc isig smeas (fsec 's xv))))
            (pms-lb!)
            (let* ((rhs (caddr (dk-goal))) (lx (caddr rhs)) (gv (gx xv)))
              (dk-fun-ext! lx gv pms-v 'RR-POS-STAR
                (lambda () (dk-lam-type! (lambda () (let ((vv (dk-di-var!))) (lv! vv) (vx! vv xv) (pms-reduce-scale!)
                                                       (subst (list '= (list (smf (pms-lev vv)) xv) (list smeas (list shead ispc (pms-lev vv) xv))))
                                                       (if (not (proof-done? *ps*)) (ass))))
                                         (lambda () (ass))))
                (lambda () (dk-lam-type! (lambda () (let ((vv (dk-di-var!))) (lv! vv) (vx! vv xv) (if (not (pms-lb!)) (ass))))
                                         (lambda () (ass))))
                (lambda (vv)
                  (lv! vv) (vx! vv xv)
                  (pms-reduce-scale!)
                  (subst (list '= (list (smf (pms-lev vv)) xv) (list smeas (list shead ispc (pms-lev vv) xv))))
                  (if (not (proof-done? *ps*)) (rfl))))
              (subst (list '= lx gv))
              (if (not (proof-done? *ps*)) (ass))))))
      (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list ff 'icx_) (list h 'icx_))))
        (lambda ()
          (let ((xv (dk-di-var!)))
            (dk-apply! (dk-ctx-form (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list h 'icx_) (list ff 'icx_))))) xv)
            (fact 'fun-apply-type-c ff dom 'RR-POS-STAR xv)
            (subst (list '= (list h xv) (list ff xv)))
            (rfl))))
      (fact 'measurable-fn-congruence-ptwise dom dsig ff h)
      (fact 'integral-congruence-ptwise dom dsig imeas h ff)
      (cons ff hl))))

