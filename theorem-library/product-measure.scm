(define (pms-limit-side! o)
  (let* ((spec (pms-iorient o))
         (si (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2)) (imeas (list-ref spec 3))
         (ispc (list-ref spec 4)) (isig (list-ref spec 5)) (smeas (list-ref spec 6))
         (fsec (list-ref spec 7)) (iapply (list-ref spec 8)) (mthm (list-ref spec 9))
         (fapply (if (eq? o 'x) 'fn-x-section-apply 'fn-y-section-apply))
         (pair (if (eq? o 'x) (lambda (p z) (list 'LIST p z)) (lambda (p z) (list 'LIST z p))))
         (pc! (lambda (p z) (fact 'pair-in-cartesian 'xs 'ys (if (eq? o 'x) p z) (if (eq? o 'x) z p))))
         (ia! (lambda (g x) (if (eq? o 'x) (dk-cite! iapply 'xs 'ys 'cB 'nu g x) (dk-cite! iapply 'xs 'cA 'mu 'ys g x))))
         (ityp! (lambda (g) (if (eq? o 'x) (fact 'x-section-integral-type 'xs 'cA 'ys 'cB 'nu g)
                                           (fact 'y-section-integral-type 'xs 'cA 'mu 'ys 'cB g))))
         (int (lambda (g) (list 'INTEGRAL dom dsig imeas g)))
         (iint (lambda (g) (list 'INTEGRAL ispc isig smeas g))))
    (dk-peel!)
    (pms-meas-parts!)
    (pms-sig-sub!)
    (pms-xy-set!)
    (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
    (let* ((cfm (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN pms-xy pms-ps '(cf pmn_))))))
           (cfle (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'PTWISE-LE pms-xy '(cf pmn_) '(cf (succ pmn_)))))))
           (cfsup (dk-ctx-form (list 'FORALL 'pmw_ (list 'IMPLIES (list 'IN 'pmw_ pms-xy) (list '= (list (list 'PTWISE-SUP pms-xy 'cf) 'pmw_) '(f pmw_))))))
           (sim (dk-ctx-form (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN dom dsig (si '(cf pmn_)))))))
           (cfk! (lambda (k)
                   (fact 'fun-apply-type-c 'cf 'NN (list 'FUN pms-xy 'RR-POS-STAR) k)
                   (pms-apply1! cfm k)))
           ;; (cf n)(p) <= (cf (succ n))(p), p the pair of x and y
           (le-at! (lambda (n x y)
                     (let ((sn (list 'succ n)) (p (pair x y)))
                       (fact 'nn-succ-closed n)
                       (pc! x y)
                       (pms-apply1! cfle n)
                       (dk-apply! (car (pms-parts! 'ptwise-le (list pms-xy (list 'cf n) (list 'cf sn)))) p))))
           ;; the sections of cf n and cf (succ n) at x are ordered, both measurable
           (sec-le! (lambda (n x)
                      (let ((sn (list 'succ n)))
                        (fact 'nn-succ-closed n)
                        (cfk! n) (cfk! sn)
                        (fact mthm 'xs 'cA 'ys 'cB (list 'cf n) x)
                        (fact mthm 'xs 'cA 'ys 'cB (list 'cf sn) x)
                        (dk-have! (list 'PTWISE-LE ispc (fsec (list 'cf n) x) (fsec (list 'cf sn) x))
                          (lambda ()
                            (mac 'PTWISE-LE)
                            (let ((yv (dk-di-var!)))
                              (dk-cite! fapply ispc (list 'cf n) x yv)
                              (dk-cite! fapply ispc (list 'cf sn) x yv)
                              (le-at! n x yv)
                              (subst (list '= (list (fsec (list 'cf n) x) yv) (list (list 'cf n) (pair x yv))))
                              (subst (list '= (list (fsec (list 'cf sn) x) yv) (list (list 'cf sn) (pair x yv))))
                              (ass)))))))
           (tr (pms-abstract! 'NN (list 'FUN dom 'RR-POS-STAR) (lambda (k) (si (list 'cf k)))
                 (lambda (kv) (cfk! kv) (pms-then-ass! (lambda () (ityp! (list 'cf kv)))))
                 (lambda (kv) (cfk! kv) (ityp! (list 'cf kv))
                              (fact 'membership-implies-sethood (si (list 'cf kv)) (list 'FUN dom 'RR-POS-STAR)))))
           (tq (car tr)) (te (cdr tr))
           (tqk! (lambda (k) (cfk! k) (ityp! (list 'cf k)) (pms-apply1! te k)))
           (psup (list 'PTWISE-SUP dom tq)))
      (ityp! 'f)
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN dom dsig (list tq 'n_))))
        (lambda ()
          (let ((nv (dk-di-var!)))
            (tqk! nv)
            (subst (list '= (list tq nv) (si (list 'cf nv))))
            (pms-apply1! sim nv)
            (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE dom (list tq 'n_) (list tq '(succ n_)))))
        (lambda ()
          (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
            (fact 'nn-succ-closed nv)
            (tqk! nv) (tqk! sn)
            (subst (list '= (list tq nv) (si (list 'cf nv))))
            (subst (list '= (list tq sn) (si (list 'cf sn))))
            (mac 'PTWISE-LE)
            (let ((xv (dk-di-var!)))
              (sec-le! nv xv)
              (ia! (list 'cf nv) xv) (ia! (list 'cf sn) xv)
              (subst (list '= (list (si (list 'cf nv)) xv) (iint (fsec (list 'cf nv) xv))))
              (subst (list '= (list (si (list 'cf sn)) xv) (iint (fsec (list 'cf sn) xv))))
              (pms-then-ass! (lambda () (fact 'integral-monotone ispc isig smeas (fsec (list 'cf nv) xv) (fsec (list 'cf sn) xv))))))))
      (let* ((mct (dk-split! (dk-fact! 'monotone-convergence dom dsig imeas tq)))
             (mct-eq (find-first (lambda (f) (dk-head-is? f '=)) mct))
             (m1 (cadr (cadr (caddr mct-eq)))))
        (cadr (pms-parts! 'is-measurable-fn (list dom dsig psup)))
        ;; the inner integral of f is the pointwise sup of the inner integrals of cf n
        (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list (si 'f) 'icx_) (list psup 'icx_))))
          (lambda ()
            (let* ((xv (dk-di-var!))
                   (sr (pms-abstract! 'NN (list 'FUN ispc 'RR-POS-STAR) (lambda (k) (fsec (list 'cf k) xv))
                         (lambda (kv) (cfk! kv) (fact mthm 'xs 'cA 'ys 'cB (list 'cf kv) xv)
                                      (pms-close-by-parts! 'is-measurable-fn (list ispc isig (fsec (list 'cf kv) xv))))
                         (lambda (kv) (cfk! kv) (fact mthm 'xs 'cA 'ys 'cB (list 'cf kv) xv)
                                      (cadr (pms-parts! 'is-measurable-fn (list ispc isig (fsec (list 'cf kv) xv))))
                                      (fact 'membership-implies-sethood (fsec (list 'cf kv) xv) (list 'FUN ispc 'RR-POS-STAR)))))
                   (sq (car sr)) (se (cdr sr))
                   (sqk! (lambda (k) (cfk! k) (fact mthm 'xs 'cA 'ys 'cB (list 'cf k) xv) (pms-apply1! se k)))
                   (psq (list 'PTWISE-SUP ispc sq)))
              (fact mthm 'xs 'cA 'ys 'cB 'f xv)
              (cadr (pms-parts! 'is-measurable-fn (list ispc isig (fsec 'f xv))))
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN ispc isig (list sq 'n_))))
                (lambda ()
                  (let ((nv (dk-di-var!)))
                    (sqk! nv)
                    (subst (list '= (list sq nv) (fsec (list 'cf nv) xv)))
                    (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE ispc (list sq 'n_) (list sq '(succ n_)))))
                (lambda ()
                  (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                    (fact 'nn-succ-closed nv)
                    (sqk! nv) (sqk! sn)
                    (subst (list '= (list sq nv) (fsec (list 'cf nv) xv)))
                    (subst (list '= (list sq sn) (fsec (list 'cf sn) xv)))
                    (sec-le! nv xv)
                    (if (not (proof-done? *ps*)) (vnb-guard (lambda () (dk-ass!)))))))
              (let* ((imct (dk-split! (dk-fact! 'monotone-convergence ispc isig smeas sq)))
                     (imct-eq (find-first (lambda (f) (dk-head-is? f '=)) imct))
                     (n1 (cadr (cadr (caddr imct-eq)))))
                (cadr (pms-parts! 'is-measurable-fn (list ispc isig psq)))
                ;; the section of f at x is the pointwise sup of the sections of cf n
                (dk-have! (list 'FORALL 'icy_ (list 'IMPLIES (list 'IN 'icy_ ispc) (list '= (list (fsec 'f xv) 'icy_) (list psq 'icy_))))
                  (lambda ()
                    (let* ((yv (dk-di-var!)) (p (pair xv yv))
                           (l1 (list 'VNB-LAMBDA 'n_ 'NN (list '(cf n_) p)))
                           (l2 (list 'VNB-LAMBDA 'n_ 'NN (list (list sq 'n_) yv))))
                      (pc! xv yv)
                      (dk-cite! fapply ispc 'f xv yv)
                      (dk-apply! cfsup p)
                      (dk-cite! 'ptwise-sup-apply pms-xy 'cf p)
                      (dk-cite! 'ptwise-sup-apply ispc sq yv)
                      (fact 'fun-apply-type-c psq ispc 'RR-POS-STAR yv)
                      (dk-fun-ext! l1 l2 'NN 'RR-POS-STAR
                        (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (cfk! kv)
                                                               (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list 'cf kv) pms-xy 'RR-POS-STAR p)))))))
                        (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (sqk! kv)
                                                               (fact 'fun-apply-type-c sq 'NN (list 'FUN ispc 'RR-POS-STAR) kv)
                                                               (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list sq kv) ispc 'RR-POS-STAR yv)))))))
                        (lambda (kv)
                          (cfk! kv) (sqk! kv)
                          (dk-cite! fapply ispc (list 'cf kv) xv yv)
                          (fact 'fun-apply-type-c (list 'cf kv) pms-xy 'RR-POS-STAR p)
                          (pms-lb!)
                          (subst (list '= (list sq kv) (fsec (list 'cf kv) xv)))
                          (subst (list '= (list (fsec (list 'cf kv) xv) yv) (list (list 'cf kv) p)))
                          (if (not (proof-done? *ps*)) (rfl))))
                      (subst (list '= (list (fsec 'f xv) yv) (list 'f p)))
                      (subst (list '= (list 'f p) (list (list 'PTWISE-SUP pms-xy 'cf) p)))
                      (subst (list '= (list (list 'PTWISE-SUP pms-xy 'cf) p) (list 'ESUP (list 'IMAGE l1 'NN))))
                      (subst (list '= l1 l2))
                      (subst (list '= (list 'ESUP (list 'IMAGE l2 'NN)) (list psq yv)))
                      (if (not (proof-done? *ps*)) (rfl)))))
                (fact 'integral-congruence-ptwise ispc isig smeas (fsec 'f xv) psq)
                ;; the outer point equation
                (let ((q1 (list 'VNB-LAMBDA 'n_ 'NN (list (list tq 'n_) xv))))
                  (ia! 'f xv)
                  (dk-cite! 'ptwise-sup-apply dom tq xv)
                  (fact 'fun-apply-type-c psup dom 'RR-POS-STAR xv)
                  (dk-fun-ext! n1 q1 'NN 'RR-POS-STAR
                    (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!)))
                                                           (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN ispc isig (list sq 'n_))))) kv)
                                                           (pms-then-ass! (lambda () (fact 'integral-in ispc isig smeas (list sq kv))))))))
                    (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!)))
                                                           (fact 'fun-apply-type-c tq 'NN (list 'FUN dom 'RR-POS-STAR) kv)
                                                           (pms-then-ass! (lambda () (fact 'fun-apply-type-c (list tq kv) dom 'RR-POS-STAR xv)))))))
                    (lambda (kv)
                      (sqk! kv) (tqk! kv)
                      (ia! (list 'cf kv) xv)
                      (fact 'integral-in ispc isig smeas (fsec (list 'cf kv) xv))
                      (pms-lb!)
                      (subst (list '= (list sq kv) (fsec (list 'cf kv) xv)))
                      (subst (list '= (list tq kv) (si (list 'cf kv))))
                      (subst (list '= (list (si (list 'cf kv)) xv) (iint (fsec (list 'cf kv) xv))))
                      (if (not (proof-done? *ps*)) (rfl))))
                  (subst (list '= (list (si 'f) xv) (iint (fsec 'f xv))))
                  (subst (list '= (iint (fsec 'f xv)) (iint psq)))
                  (subst (list '= (iint psq) (list 'ESUP (list 'IMAGE n1 'NN))))
                  (subst (list '= n1 q1))
                  (subst (list '= (list 'ESUP (list 'IMAGE q1 'NN)) (list psup xv)))
                  (if (not (proof-done? *ps*)) (rfl)))))))
        (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list psup 'icx_) (list (si 'f) 'icx_))))
          (lambda ()
            (let ((xv (dk-di-var!)))
              (dk-apply! (dk-ctx-form (list 'FORALL 'icx_ (list 'IMPLIES (list 'IN 'icx_ dom) (list '= (list (si 'f) 'icx_) (list psup 'icx_))))) xv)
              (fact 'fun-apply-type-c psup dom 'RR-POS-STAR xv)
              (subst (list '= (list (si 'f) xv) (list psup xv)))
              (rfl))))
        (fact 'measurable-fn-congruence-ptwise dom dsig psup (si 'f))
        (fact 'integral-congruence-ptwise dom dsig imeas (si 'f) psup)
        (let ((mm (list 'VNB-LAMBDA 'pmn_ 'NN (int (si '(cf pmn_))))))
          (dk-fun-ext! mm m1 'NN 'RR-POS-STAR
            (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!))) (pms-apply1! sim kv)
                                                   (pms-then-ass! (lambda () (fact 'integral-in dom dsig imeas (si (list 'cf kv)))))))))
            (lambda () (dk-lam-type! (lambda () (let ((kv (dk-di-var!)))
                                                   (dk-apply! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN dom dsig (list tq 'n_))))) kv)
                                                   (pms-then-ass! (lambda () (fact 'integral-in dom dsig imeas (list tq kv))))))))
            (lambda (kv)
              (tqk! kv)
              (pms-apply1! sim kv)
              (fact 'integral-in dom dsig imeas (si (list 'cf kv)))
              (pms-lb!)
              (subst (list '= (list tq kv) (si (list 'cf kv))))
              (if (not (proof-done? *ps*)) (rfl))))
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (subst (list '= (int (si 'f)) (int psup)))
                    (subst (list '= mm m1))
                    (if (not (proof-done? *ps*)) (ass)))))))))))

(define (pms-limit-stmt o)
  (let* ((spec (pms-iorient o))
         (si (list-ref spec 0)) (dom (list-ref spec 1)) (dsig (list-ref spec 2)) (imeas (list-ref spec 3)))
    (make-wff (forall-guarded '(xs cA mu ys cB nu f cf)
      (append pms-meas2
        (list (list 'IS-MEASURABLE-FN pms-xy pms-ps 'f)
              (list 'IN 'cf (list 'FUN 'NN (list 'FUN pms-xy 'RR-POS-STAR)))
              (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN pms-xy pms-ps '(cf pmn_))))
              (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'PTWISE-LE pms-xy '(cf pmn_) '(cf (succ pmn_)))))
              (list 'FORALL 'pmw_ (list 'IMPLIES (list 'IN 'pmw_ pms-xy) (list '= (list (list 'PTWISE-SUP pms-xy 'cf) 'pmw_) '(f pmw_))))
              (list 'FORALL 'pmn_ (list 'IMPLIES '(IN pmn_ NN) (list 'IS-MEASURABLE-FN dom dsig (si '(cf pmn_)))))))
      (list 'AND (list 'IS-MEASURABLE-FN dom dsig (si 'f))
            (list '= (list 'INTEGRAL dom dsig imeas (si 'f))
                  (list 'ESUP (list 'IMAGE (list 'VNB-LAMBDA 'pmn_ 'NN (list 'INTEGRAL dom dsig imeas (si '(cf pmn_)))) 'NN))))))))

(sp (pms-limit-stmt 'x))
