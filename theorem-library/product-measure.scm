(let* ((rx (pms-simple-side! 'x))
       (ry (pms-simple-side! 'y))
       (fx (car rx)) (hx (cdr rx)) (fy (car ry)) (hy (cdr ry))
       (ix (lambda (f) (list 'INTEGRAL 'xs 'cA 'mu f)))
       (iy (lambda (f) (list 'INTEGRAL 'ys 'cB 'nu f)))
       (lv! (lambda (v)
              (pms-img-val! v)
              (dk-apply! (dk-fact! 'measurable-fn-level-set pms-xy pms-ps 's) v)
              (fact 'fubini-sets 'xs 'cA 'mu 'ys 'cB 'nu (pms-lev v))
              (pms-parts! 'is-fubini-set (list 'xs 'cA 'mu 'ys 'cB 'nu (pms-lev v)))))
       (sx (lambda (v) (list 'X-SECTION-MEASURE 'xs 'ys 'nu (pms-lev v))))
       (sy (lambda (v) (list 'Y-SECTION-MEASURE 'xs 'ys 'mu (pms-lev v))))
       (scx (lambda (v) (list 'PTWISE-SCALE 'xs v (sx v))))
       (scy (lambda (v) (list 'PTWISE-SCALE 'ys v (sy v))))
       (vv! (lambda (v)
              (lv! v)
              (fact 'ptwise-scale-measurable 'xs 'cA (sx v) v)
              (fact 'ptwise-scale-measurable 'ys 'cB (sy v) v)
              (fact 'integral-in 'xs 'cA 'mu (scx v))
              (fact 'integral-in 'ys 'cB 'nu (scy v))
              (fact 'integral-in 'xs 'cA 'mu (sx v))
              (fact 'integral-in 'ys 'cB 'nu (sy v)))))
  (dk-fun-ext! hx hy pms-v 'RR-POS-STAR
    (lambda () (dk-lam-type! (lambda () (let ((vv (dk-di-var!))) (vv! vv) (if (not (pms-lb!)) (ass)))) (lambda () (ass))))
    (lambda () (dk-lam-type! (lambda () (let ((vv (dk-di-var!))) (vv! vv) (if (not (pms-lb!)) (ass)))) (lambda () (ass))))
    (lambda (vv)
      (vv! vv)
      (fact 'integral-homogeneous 'xs 'cA 'mu (sx vv) vv)
      (fact 'integral-homogeneous 'ys 'cB 'nu (sy vv) vv)
      (pms-and! (list 'IN vv 'RR-POS-STAR) (list 'IN (iy (sy vv)) 'RR-POS-STAR))
      (fact 'etimes-closed vv (iy (sy vv)))
      (pms-lb!)
      (subst (list '= (ix (scx vv)) (list 'etimes vv (ix (sx vv)))))
      (subst (list '= (iy (scy vv)) (list 'etimes vv (iy (sy vv)))))
      (subst (list '= (ix (sx vv)) (iy (sy vv))))
      (if (not (proof-done? *ps*)) (rfl))))
  (let ((fsy (pms-fs hy pms-v)))
    (fact 'integral-in 'ys 'cB 'nu fy)
    (dk-have! (list 'IN fsy 'RR-POS-STAR) (lambda () (subst (list '= fsy (iy fy))) (ass)))
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (subst (list '= (ix (pms-xsi 's)) (ix fx)))
              (subst (list '= (ix fx) (pms-fs hx pms-v)))
              (subst (list '= hx hy))
              (subst (list '= (iy (pms-ysi 's)) (iy fy)))
              (subst (list '= (iy fy) fsy))
              (if (not (proof-done? *ps*)) (rfl))))))))
