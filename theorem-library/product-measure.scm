    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (subst (list '= (ix (pms-xsi 'f)) (list 'ESUP (list 'IMAGE mx 'NN))))
              (subst (list '= mx my))
              (subst (list '= (list 'ESUP (list 'IMAGE my 'NN)) (iy (pms-ysi 'f))))
              (if (not (proof-done? *ps*)) (rfl))))))))
