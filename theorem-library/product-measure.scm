;;; =====================================================================
;;; (8) SECTIONS OF A PRODUCT-MEASURABLE SET ARE MEASURABLE.  The class of the
;;;     subsets of xs x ys whose section at the point is measurable is a
;;;     sigma-algebra containing the rectangles (no monotone class is needed).
;;; =====================================================================

;;; the orientation: X (the section at a point of xs, a subset of ys) or Y
(define (pms-orient o)
  (if (eq? o 'x)
      (list 'X-SECTION 'ys 'cB 'xs 'x 'x-section-membership (lambda (p z) (list 'LIST p z)))
      (list 'Y-SECTION 'xs 'cA 'ys 'y 'y-section-membership (lambda (p z) (list 'LIST z p)))))

(define (pms-section-measurable! o)
  (let* ((spec (pms-orient o))
         (head (list-ref spec 0)) (spc (list-ref spec 1)) (sig (list-ref spec 2))
         (ptsp (list-ref spec 3)) (pt (list-ref spec 4)) (memb (list-ref spec 5)) (pair (list-ref spec 6))
         (sec (lambda (c) (list head spc c pt)))
         (ptin (list 'IN pt ptsp))
         (sc (list 'SEP 'pmsc_ (list 'POWER pms-xy) (list 'IN (sec 'pmsc_) sig)))
         (pcart! (lambda (z) (fact 'pair-cartesian-iff 'xs 'ys (if (eq? o 'x) pt z) (if (eq? o 'x) z pt))))
         (sc-open! (lambda (c)
                     (let ((m (or (dk-ctx-form (list 'IN c sc)) (error "sc-open!: not in context" c))))
                       (pms-project! (list 'IN c (list 'POWER pms-xy)) (lambda () (sep-me m) (dk-split-all!)))
                       (if (dk-ctx-form (list 'IN c sc))
                           (pms-project! (list 'IN (sec c) sig) (lambda () (sep-me m) (dk-split-all!))))))))
    (dk-peel!)
    (pms-sig-sub!)
    (pms-xy-set!)
    ;; the class is a sigma-algebra
    (dk-have! (list 'IS-SIGMA-ALGEBRA pms-xy sc)
      (lambda ()
        (mac 'IS-SIGMA-ALGEBRA)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-ass!) #t)
                    ((dk-head-is? g 'SUBSET)
                     (mac 'subset-def)
                     (pms-forall! (lambda (zv) (sep-me (list 'IN zv sc)) (dk-split-all!) (ass))))
                    ((dk-head-is? g 'IN)
                     (fact 'power-whole-in pms-xy)
                     (pms-ext! (sec pms-xy) spc (lambda (z) (pcart! z)) ptin)
                     (fact 'sigma-algebra-whole-in spc sig)
                     (in-sep! dk-ass! (lambda () (pms-then-ass! (lambda () (subst (list '= (sec pms-xy) spc)))))))
                    ((dk-contains? g 'COMPLEMENT-IN)
                     (dk-peel!)
                     (let* ((tgt (cadr (dk-goal))) (av (caddr tgt))
                            (rhs (list 'COMPLEMENT-IN spc (sec av))))
                       (sc-open! av)
                       (fact 'power-complement-closed pms-xy av)
                       (fact 'sigma-algebra-complement-closed spc sig (sec av))
                       (pms-ext! (sec tgt) rhs (lambda (z) (pcart! z)) ptin)
                       (in-sep! dk-ass! (lambda () (pms-then-ass! (lambda () (subst (list '= (sec tgt) rhs))))))))
                    (#t
                     (let* ((landed (dk-peel!))
                            (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                            (tgt (cadr (dk-goal)))
                            (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN sc kv) (sc-open! (list fv kv))))
                            (gr (pms-abstract! 'NN sig (lambda (k) (sec (list fv k)))
                                  (lambda (kv) (pms-then-ass! (lambda () (fk! kv))))
                                  (lambda (kv) (fk! kv) (fact 'membership-implies-sethood (sec (list fv kv)) sig))))
                            (gv (car gr)) (ge (cdr gr))
                            (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv)))
                            (bug (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
                            (lhs (sec tgt)))
                       (pms-retype! fv sc (list 'POWER pms-xy)
                         (lambda (x) (pms-project! (list 'IN x (list 'POWER pms-xy))
                                       (lambda () (sep-me (dk-ctx-form (list 'IN x sc))) (dk-split-all!)))))
                       (fact 'power-fun-union-closed pms-xy fv)
                       (fact 'sigma-algebra-union-closed spc sig gv)
                       (pms-ext2! lhs bug
                         (lambda (w)
                           (pms-iff-parts! (dk-cite! memb spc tgt pt w))
                           (let* ((r (pms-bu-open! (pair pt w) tgt)) (kv (car r)))
                             (gk! kv)
                             (dk-have! (list 'IN w (list gv kv))
                               (lambda () (subst (list '= (list gv kv) (sec (list fv kv))))
                                          (mac memb) (dk-conj-close! dk-ass!)))
                             (pms-bu-close! kv)))
                         (lambda (w)
                           (let* ((r (pms-bu-open! w bug)) (kv (car r)))
                             (gk! kv)
                             (let ((h (dk-rewrite-h! (cdr r) (list gv kv) (sec (list fv kv)))))
                               (pms-iff-parts! (dk-cite! memb spc (list fv kv) pt w))
                               (mac memb)
                               (dk-conj-close! (lambda () (if (not (dk-ass!)) (pms-bu-close! kv))))))))
                       (in-sep! dk-ass! (lambda () (pms-then-ass! (lambda () (subst (list '= lhs bug))))))))))))))
    ;; the rectangles are in the class
    (dk-have! (list 'SUBSET pms-rect sc)
      (lambda ()
        (mac 'subset-def)
        (pms-forall!
          (lambda (rv)
            (let* ((w (pms-rect-open! rv)) (av (car w)) (bv (cdr w))
                   (inside (if (eq? o 'x) av bv)) (other (if (eq? o 'x) bv av))
                   (rc (list 'CARTESIAN av bv)))
              (fact 'subset-mem-fwd 'cA '(POWER xs) av)
              (fact 'subset-mem-fwd 'cB '(POWER ys) bv)
              (pms-pow-sub! other spc)
              (in-sep! dk-ass!
                (lambda ()
                  (subst (list '= rv rc))
                  (use-em (list 'IN pt inside)
                    (lambda ()
                      (pms-ext! (sec rc) other
                        (lambda (z) (fact 'pair-cartesian-iff av bv (if (eq? o 'x) pt z) (if (eq? o 'x) z pt))
                                    (fact 'subset-mem-fwd other spc z))
                        (list 'IN pt inside))
                      (pms-then-ass! (lambda () (subst (list '= (sec rc) other)))))
                    (lambda ()
                      (pms-ext! (sec rc) 'EMPTY-SET
                        (lambda (z) (fact 'pair-cartesian-iff av bv (if (eq? o 'x) pt z) (if (eq? o 'x) z pt))
                                    (fact 'empty-set-has-no-members z))
                        (list 'NOT (list 'IN pt inside)))
                      (fact 'sigma-algebra-empty-in spc sig)
                      (pms-then-ass! (lambda () (subst (list '= (sec rc) 'EMPTY-SET)))))))))))))
    ;; cs is in every sigma-algebra containing the rectangles
    (pms-ps-unfold!)
    (dk-rewrite-h! (list 'IN 'cs pms-ps) pms-ps (list 'SIGMA-GENERATED pms-xy pms-rect))
    (fact 'sigma-generated-in-every pms-xy pms-rect 'cs sc)
    (sep-me (list 'IN 'cs sc))
    (dk-split-all!)
    (ass)))

(sp (make-wff (forall-guarded '(xs cA ys cB cs x) (append pms-sig2 (list (list 'IN 'cs pms-ps) '(IN x xs)))
   '(IN (X-SECTION ys cs x) cB))))
(pms-section-measurable! 'x)
(qed 'x-section-measurable)
(topic! 'x-section-measurable 'set-quotient)

(sp (make-wff (forall-guarded '(xs cA ys cB cs y) (append pms-sig2 (list (list 'IN 'cs pms-ps) '(IN y ys)))
   '(IN (Y-SECTION xs cs y) cA))))
(pms-section-measurable! 'y)
(qed 'y-section-measurable)
(topic! 'y-section-measurable 'set-quotient)
;;; =====================================================================
;;; (9) PROP. 3.5: the sections of a product-measurable function are
;;;     measurable.  The tail { y : alpha < f(x, y) } is the section at x of the
;;;     tail { w : alpha < f(w) }, so (8) applies; no approximation is needed.
;;; =====================================================================

(sp (make-wff '(FORALL ys (FORALL f (FORALL x (FORALL z
   (IMPLIES (IN z ys) (== ((FN-X-SECTION ys f x) z) (f (LIST x z))))))))))
(dk-peel!)
(mac 'FN-X-SECTION)
(if (not (dk-lam-b!)) (qrfl))
(qed 'fn-x-section-apply)
(topic! 'fn-x-section-apply 'plumbing)

(sp (make-wff '(FORALL xs (FORALL f (FORALL y (FORALL z
   (IMPLIES (IN z xs) (== ((FN-Y-SECTION xs f y) z) (f (LIST z y))))))))))
(dk-peel!)
(mac 'FN-Y-SECTION)
(if (not (dk-lam-b!)) (qrfl))
(qed 'fn-y-section-apply)
(topic! 'fn-y-section-apply 'plumbing)

(define (pms-fn-section-measurable! o)
  (let* ((spec (pms-orient o))
         (head (list-ref spec 0)) (spc (list-ref spec 1)) (sig (list-ref spec 2))
         (ptsp (list-ref spec 3)) (pt (list-ref spec 4)) (memb (list-ref spec 5)) (pair (list-ref spec 6))
         (fsec (list (if (eq? o 'x) 'FN-X-SECTION 'FN-Y-SECTION) spc 'f pt))
         (fhead (car fsec))
         (apply-thm (if (eq? o 'x) 'fn-x-section-apply 'fn-y-section-apply))
         (secthm (if (eq? o 'x) 'x-section-measurable 'y-section-measurable))
         (pcart! (lambda (z) (fact 'pair-in-cartesian 'xs 'ys (if (eq? o 'x) pt z) (if (eq? o 'x) z pt)))))
    (dk-peel!)
    (let ((mparts (pms-parts! 'is-measurable-fn (list pms-xy pms-ps 'f))))
      (fact 'sigma-algebra-ambient-set spc sig)
      (mac 'IS-MEASURABLE-FN)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-ass!) #t)
                  ((dk-head-is? g 'IN)
                   (mac fhead)
                   (dk-lam-type!
                     (lambda ()
                       (let ((zv (dk-di-var!)))
                         (pcart! zv)
                         (fact 'fun-apply-type-c 'f pms-xy 'RR-POS-STAR (pair pt zv))
                         (ass)))))
                  (#t
                   (let* ((av (dk-di-var!))
                          (gs (cadr (dk-goal)))
                          (tl (list 'SEP 'x_ pms-xy (list '< av '(f x_))))
                          (xsec (list head spc tl pt)))
                     (dk-apply! (list-ref mparts 2) av)
                     (fact secthm 'xs 'cA 'ys 'cB tl pt)
                     (pms-ext2! gs xsec
                       (lambda (w)
                         (sep-me (list 'IN w gs))
                         (dk-split-all!)
                         (let* ((app (list fsec w))
                                (val (list 'f (pair pt w))))
                           (dk-cite! apply-thm spc 'f pt w)
                           (dk-rewrite-h! (list '< av app) app val)
                           (mac memb)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (in-sep! (lambda () (pcart! w) (ass)) dk-ass!))))))
                       (lambda (w)
                         (let ((ps (pms-iff-parts! (dk-cite! memb spc tl pt w))))
                           (sep-me (list 'IN (pair pt w) tl))
                           (dk-split-all!)
                           (in-sep! dk-ass!
                             (lambda ()
                               (dk-cite! apply-thm spc 'f pt w)
                               (subst (list '= (list fsec w) (list 'f (pair pt w))))
                               (ass))))))
                     (pms-then-ass! (lambda () (subst (list '= gs xsec))))))))))))
  )

(sp (make-wff (forall-guarded '(xs cA ys cB f x) (append pms-sig2 (list (list 'IS-MEASURABLE-FN pms-xy pms-ps 'f) '(IN x xs)))
   '(IS-MEASURABLE-FN ys cB (FN-X-SECTION ys f x)))))
(pms-fn-section-measurable! 'x)
(qed 'fn-x-section-measurable)
(topic! 'fn-x-section-measurable 'set-quotient)

(sp (make-wff (forall-guarded '(xs cA ys cB f y) (append pms-sig2 (list (list 'IS-MEASURABLE-FN pms-xy pms-ps 'f) '(IN y ys)))
   '(IS-MEASURABLE-FN xs cA (FN-Y-SECTION xs f y)))))
(pms-fn-section-measurable! 'y)
