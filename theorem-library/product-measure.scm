;;; two functions on omega with the same values are equal: the integral and
;;; measurability transfer
(define (pms-fun-eq! omega f g)
  (fact 'fun-codomain-iff omega 'RR-POS-STAR f)
  (fact 'fun-codomain-iff omega 'RR-POS-STAR g)
  (dk-project! (list 'IN f (list 'FUN omega)) (lambda () (mac-h 'fun-codomain-iff (dk-ctx-form (list 'IN f (list 'FUN omega 'RR-POS-STAR)))) (dk-split-all!)))
  (dk-project! (list 'IN g (list 'FUN omega)) (lambda () (mac-h 'fun-codomain-iff (dk-ctx-form (list 'IN g (list 'FUN omega 'RR-POS-STAR)))) (dk-split-all!)))
  (fact 'fun-domain-extensionality omega f g))

(sp (make-wff (forall-guarded '(omega cA mu f g)
   '((IN f (FUN omega RR-POS-STAR)) (IN g (FUN omega RR-POS-STAR))
     (FORALL icx_ (IMPLIES (IN icx_ omega) (= (f icx_) (g icx_)))))
   '(== (INTEGRAL omega cA mu f) (INTEGRAL omega cA mu g)))))
(dk-peel!)
(pms-fun-eq! 'omega 'f 'g)
(subst '(= f g))
(qrfl)
(qed 'integral-congruence-ptwise)
