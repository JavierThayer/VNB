;;; tg-struct.scm -- the structure TOP-GROUP and the group topologies: the underlying space
;;; and group of a topological group (the typing obligations of the two constructed functors),
;;; the bridge IS-TOP-GROUP(G) => IS-GROUP-TOPOLOGY(space, group), and the way back,
;;; IS-GROUP-TOPOLOGY(s, g) => IS-TOP-GROUP(MAKE-TOP-GROUP(s, g)).
;;; Agent ISOM, 2026-10-26.  Helper prefix: tgs-.  Library: analysis.

(define (tgs-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (tgs-rhs! iff)
  (dk-split-all! (list (dk-meta-iff-r! iff))))
(define tgs-S '(TOP-GROUP-SPACE G))
(define tgs-GG '(TOP-GROUP-GROUP G))
;; close the conjuncts of an unfolded structure predicate of a constructed tuple:
;; the LENGTH conjunct by unfolding FUNCTOID and len-r, the rest from context
(define (tgs-close-conjuncts! functoid)
  (dk-conj-close!
   (lambda ()
     (let ((g0 (dk-goal)))
       (if (and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
           (begin (mac functoid) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
           (tgs-ass!))))))

;;; ---- the typing obligations of the two constructed functors ----
(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (list 'IS-TOP-SPACE tgs-S)))))
(dk-peel!)
(tgs-rhs! (dk-cite! 'is-top-group 'G))
(mac 'is-top-space)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(slot 'PTS)
(slot 'OPENS)
(tgs-close-conjuncts! 'TOP-GROUP-SPACE)
(qed 'top-group-space-is-top-space)
(topic! 'top-group-space-is-top-space 'analysis)

(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (list 'IS-GROUP tgs-GG)))))
(dk-peel!)
(tgs-rhs! (dk-cite! 'is-top-group 'G))
(mac 'is-group)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(tgs-close-conjuncts! 'TOP-GROUP-GROUP)
(qed 'top-group-group-is-group)
(topic! 'top-group-group-is-group 'analysis)

;;; ---- a topological group is a group topology on its group ----
(sp (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (list 'IS-GROUP-TOPOLOGY tgs-S tgs-GG)))))
(dk-peel!)
(dk-cite! 'top-group-space-is-top-space 'G)
(dk-cite! 'top-group-group-is-group 'G)
(tgs-rhs! (dk-cite! 'is-top-group 'G))
(mac 'IS-GROUP-TOPOLOGY)
(slot 'PTS)
(slot 'OPENS)
(slot 'CARR)
(slot 'OPR)
(slot 'INV)
(dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))
(qed 'top-group-group-topology)
(topic! 'top-group-group-topology 'analysis)

;; the five components of MAKE-TOP-GROUP(s, g) are sets: the tuple is defined
(define (tgs-sets!)
  (let ((ts (dk-meta-iff-r! (dk-cite! 'is-top-space 's)))
        (gs (dk-meta-iff-r! (dk-cite! 'is-group 'g))))
    (dk-split-all! (list ts gs))
    (dk-cite! 'membership-implies-sethood '(OPR g) '(FUN (CARTESIAN (CARR g) (CARR g)) (CARR g)))
    (dk-cite! 'membership-implies-sethood '(IDEN g) '(CARR g))
    (dk-cite! 'membership-implies-sethood '(INV g) '(FUN (CARR g) (CARR g)))
    (dk-cite! 'membership-implies-sethood '(OPENS s) '(POWER (POWER (PTS s))))))
;; the goal (== (ACC (LIST ...)) (ACC x)) after the functoid unfold: project, reduce, close
(define (tgs-readoff! acc)
  (slot acc)
  (nth-r)
  (let ((g0 (dk-goal)))
    (if (not (equal? (cadr g0) (caddr g0))) (slot acc))
    (qrfl)))
;;; ---- and back: a group topology makes a topological group ----
(define tgs-M '(MAKE-TOP-GROUP s g))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'CARR tgs-M) '(CARR g))))))))
(dk-peel!)
(tgs-sets!)
(mac 'MAKE-TOP-GROUP)
(tgs-readoff! 'CARR)
(qed 'make-top-group-carr)
(topic! 'make-top-group-carr 'plumbing)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'OPR tgs-M) '(OPR g))))))))
(dk-peel!)
(tgs-sets!)
(mac 'MAKE-TOP-GROUP)
(tgs-readoff! 'OPR)
(qed 'make-top-group-opr)
(topic! 'make-top-group-opr 'plumbing)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'IDEN tgs-M) '(IDEN g))))))))
(dk-peel!)
(tgs-sets!)
(mac 'MAKE-TOP-GROUP)
(tgs-readoff! 'IDEN)
(qed 'make-top-group-iden)
(topic! 'make-top-group-iden 'plumbing)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'INV tgs-M) '(INV g))))))))
(dk-peel!)
(tgs-sets!)
(mac 'MAKE-TOP-GROUP)
(tgs-readoff! 'INV)
(qed 'make-top-group-inv)
(topic! 'make-top-group-inv 'plumbing)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IS-GROUP g) (list '== (list 'TOPOLOGY tgs-M) '(OPENS s))))))))
(dk-peel!)
(tgs-sets!)
(mac 'MAKE-TOP-GROUP)
(tgs-readoff! 'TOPOLOGY)
(qed 'make-top-group-topology)
(topic! 'make-top-group-topology 'plumbing)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IS-TOP-GROUP tgs-M))))))
(dk-peel!)
(tgs-rhs! (dk-cite! 'is-group-topology 's 'g))
(tgs-rhs! (dk-cite! 'is-top-space 's))
(tgs-rhs! (dk-cite! 'is-group 'g))
(for-each (lambda (nm) (dk-cite! nm 's 'g))
          '(make-top-group-carr make-top-group-opr make-top-group-iden make-top-group-inv make-top-group-topology))
(mac 'is-top-group)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(for-each (lambda (acc val) (subst (list '= (list acc tgs-M) val)))
          '(TOPOLOGY CARR OPR IDEN INV)
          '((OPENS s) (CARR g) (OPR g) (IDEN g) (INV g)))
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond ((dk-asm? g0) (ass))
           ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
            (mac 'MAKE-TOP-GROUP) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
           (#t (subst '(= (CARR g) (PTS s))) (tgs-ass!))))))
(qed 'make-top-group-is-top-group)
(topic! 'make-top-group-is-top-group 'analysis)

;;; ---- the functoriality obligations: a continuous homomorphism is continuous, and is a
;;; homomorphism of the underlying groups ----
(define (tgs-hom-open!)
  (dk-split-all! (dk-landed (lambda () (mac-h 'is-hom-top-group-def '(IS-HOM-TOP-GROUP a b f))))))
(define (tgs-hom-close! typing)
  (dk-conj-close!
   (lambda ()
     (let ((g0 (dk-goal)))
       (cond ((dk-asm? g0) (ass))
             ((and (pair? g0) (pair? (cdr g0)) (pair? (cadr g0)))
              (dk-cite! typing (cadr (cadr g0))) (tgs-ass!))
             (#t (tgs-ass!)))))))
(sp (make-wff '(FORALL a (FORALL b (FORALL f (IMPLIES (IS-HOM-TOP-GROUP a b f)
   (IS-HOM-TOP-SPACE (TOP-GROUP-SPACE a) (TOP-GROUP-SPACE b) f)))))))
(dk-peel!)
(tgs-hom-open!)
(mac 'is-hom-top-space-def)
(mac 'PREIMAGE)
(slot 'PTS)
(slot 'OPENS)
(tgs-hom-close! 'top-group-space-is-top-space)
(qed 'top-group-space-functorial)
(topic! 'top-group-space-functorial 'analysis)

(sp (make-wff '(FORALL a (FORALL b (FORALL f (IMPLIES (IS-HOM-TOP-GROUP a b f)
   (IS-HOM-GROUP (TOP-GROUP-GROUP a) (TOP-GROUP-GROUP b) f)))))))
(dk-peel!)
(tgs-hom-open!)
(mac 'is-hom-group-def)
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(tgs-hom-close! 'top-group-group-is-group)
(qed 'top-group-group-functorial)
(topic! 'top-group-group-functorial 'analysis)
