;;; mvp-max.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/calint2/mvp-max.scm.
;;; Library: complex-analysis.

;;; mvp-max.scm -- complex-analysis 3.54-3.55: the MEAN VALUE PROPERTY class and its maximum modulus
;;; principle on a circle and on a disc (CAL-INT-2, 2026-10-28).  The two proofs are those of
;;; theorem-library/cauchy-centre-mean-value.scm (holomorphic-circle-max-constant,
;;; maximum-modulus-disc) with holomorphy replaced by the mean value property: psi = M - lambda f is
;;; continuous (aif-cont-scale / -sum), and the integral of re(psi) round the circle is computed from
;;; f's mean value property by linearity (pw-antiderivative-linear, cc-re-mul) instead of psi's.
;;; Helpers copied from cauchy-centre-mean-value.scm, prefix mvx-.
;;; Library: complex-analysis.  Load window: after cauchy-centre-mean-value and analytic-from-integral
;;; (aif-cont-*); needs mvp-vocab.

;;; HAS-MEAN-VALUE-PROPERTY(u, f) in context: land its four conjuncts (consumed)
   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mvx-mvp-open! u f)
  (dk-split-all! (dk-landed* (lambda ()
    (mac-h 'HAS-MEAN-VALUE-PROPERTY (list 'HAS-MEAN-VALUE-PROPERTY u f))))))

;;; the same, keeping the predicate: land only the openness and the typing
(define (mvx-mvp-proj! u f)
  (let ((h (list 'HAS-MEAN-VALUE-PROPERTY u f)))
    (dk-project! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) u) 'HAS-MEAN-VALUE-PROPERTY h)
    (dk-project! (list 'IN f (list 'FUN u 'CC)) 'HAS-MEAN-VALUE-PROPERTY h)))

(define (mvx-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (mvx-hd t) (and (pair? t) (car t)))
(define mvx-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (mvx-sub u) (list 'SUBSPACE-MS mvx-nfm u))
(define (mvx-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (mvx-sub u) mvx-nfm f 'rgy_))))
(define (mvx-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (mvx-imps (cdr hyps) body))))
(define (mvx-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (mvx-all (cdr vars) body))))
(define (mvx-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (mvx-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((mvx-op? t '* 3) (mvx-rr! (cadr t)) (mvx-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((mvx-op? t 'magnitude 2) (mvx-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((mvx-op? t 'real-part 2) (mvx-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((mvx-op? t 'imag-part 2) (mvx-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          (#t (dk-type! t 'RR)))))
(define (mvx-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((mvx-op? t 'recip 2)
           (mvx-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "mvx-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (mvx-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          ((mvx-op? t '* 3) (mvx-cc! (cadr t)) (mvx-cc! (caddr t))
           (mvx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((mvx-op? t '+ 3) (mvx-cc! (cadr t)) (mvx-cc! (caddr t))
           (mvx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((mvx-op? t '- 3) (mvx-cc! (cadr t)) (mvx-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((mvx-op? t '- 2) (mvx-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((mvx-op? t 'CC-EXP 2) (mvx-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((or (eq? t 'PI) (and (number? t) (real? t)) (dk-asm? (list 'IN t 'RR))
               (mvx-op? t 'magnitude 2) (mvx-op? t 'real-part 2) (mvx-op? t 'imag-part 2))
           (mvx-rr! t) (fact 'rr-subset-cc t) typ)
          (#t (dk-type! t 'CC)))))
(define (mvx-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
;;; the metric facts on NFM and on the subspace u (u subset CC in context)
(define (mvx-ms! u)
  (fact 'nf-cc-is-metric-space)
  (fact 'cc-is-normed-field) (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS mvx-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS mvx-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS mvx-nfm) '(CARR CC-NORMED-FIELD))) (ass))))
  (if (not (dk-asm? (list 'SUBSET u (list 'PTS mvx-nfm))))
      (dk-have! (list 'SUBSET u (list 'PTS mvx-nfm))
        (lambda () (subst (list '== (list 'PTS mvx-nfm) 'CC)) (ass))))
  (if (not (dk-asm? (list 'IN u 'SET)))
      (dk-have! (list 'IN u 'SET)
        (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC) (ass))))
  (fact 'subspace-is-metric-space mvx-nfm u)
  (dk-have! (list 'IN u 'SET) (lambda () (dk-sethood! u)))   ; R4-W2: subspace-* guarded by A in SET
  (fact 'subspace-pts mvx-nfm u))

;;; ======================================================================
;;; (1) AN OPEN SET MINUS A POINT IS OPEN
;;; ======================================================================
(define (mvx-pz x) (list 'DIFFERENCE 'CC (list 'SINGLETON x)))
(define (mvx-dpt u x) (list 'DIFFERENCE u (list 'SINGLETON x)))
(define (mvx-dpt-open! u c y)
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (dk-have! (list 'IN y u) (lambda () (if (dk-only! iff (list 'IN y (mvx-dpt u c))) (prop))))
    (fact 'subset-mem-fwd u 'CC y)
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (dk-have! (list 'NOT (list '= y c))
      (lambda () (if (dk-only! iff (list 'IN y (mvx-dpt u c)) (list 'IN y 'SET)
                           (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                 (prop))))
    (mvx-sub-nz! y c)))
;;; y, c in CC, y /= c in context: land y - c /= 0
(define (mvx-sub-nz! y c)
  (let ((nz (list 'NOT (list '= (list '- y c) 0))))
    (if (not (dk-asm? nz))
        (dk-have! nz
          (lambda ()
            (di)
            (dk-cite! 'cc-sub-zero-eq y c)
            (ai (dk-ctx-form (list 'NOT (list '= y c)))))))
    nz))
;;; y in u, y /= c in context: land y in u \ {c}
(define (mvx-dpt-in! u c y)
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (dk-have! (list 'IN y (mvx-dpt u c))
      (lambda () (if (dk-only! iff (list 'IN y u) (list 'NOT (list '= y c))
                           (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                 (prop))))))

(define mvx-tp '(* 2 PI))
(define mvx-iv (list 'CCINT 0 mvx-tp))
(define (mvx-iv-ends!)      ; 0 and 2 pi in [0, 2 pi]; [0, 2 pi] a set
  (mvx-rr! 0)
  (mvx-rr! mvx-tp)
  (if (not (dk-asm? (list 'IN mvx-iv 'SET)))
      (begin (fact 'rr-is-set) (fact 'ccint-subset-rr 0 mvx-tp) (fact 'subclass-of-set-is-set mvx-iv 'RR)))
  (if (not (dk-asm? (list '< 0 mvx-tp))) (dk-have! (list '< 0 mvx-tp) (lambda () (dk-ineq! '(< 0 PI)))))
  (for-each
    (lambda (e)
      (if (not (dk-asm? (list 'IN e mvx-iv)))
          (dk-have! (list 'IN e mvx-iv)
            (lambda () (mac 'ccint-membership)
                       (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 mvx-tp)))))))))
    (list 0 mvx-tp)))

;;; (circle-path-ends-agree: CA-3's `circle-path-closed' is cited instead -- the duplicate proof was cut at integration, 2026-10-04)

;;; (circle-trace-radius: CA-3's `circle-trace-magnitude' is cited instead -- the duplicate proof was cut at integration, 2026-10-04)

;;; the trace of the circle of radius r about c lies in every disc B(c, R), R > r, and
;;; avoids the centre
(define mvx-P '(CIRCLE-PATH c r))
(define mvx-DP '(CIRCLE-DERIV c r))
(define mvx-T (list 'TRACE mvx-P 0 mvx-tp))
(define (mvx-ball z rad) (list 'BALL 'CC-MS z rad))
(define mvx-tpi '(* (* 2 PI) +i))
(define (mvx-tpi!)
  (mvx-rr! mvx-tp)
  (if (not (dk-asm? (list '< 0 mvx-tp))) (dk-have! (list '< 0 mvx-tp) (lambda () (dk-ineq! '(< 0 PI)))))
  (dk-cite! 'rr-pos-ne-zero mvx-tp)
  (mvx-cc! mvx-tp)
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero mvx-tp '+i)
  (mvx-cc! mvx-tpi)
  (mvx-cc! (list 'recip mvx-tpi)))
(define mvx-g (list 'VNB-LAMBDA 'cmvt_ mvx-iv '(f (+ c (* r (CC-EXP (* +i cmvt_)))))))
(define mvx-zprem '())             ; the linear facts of the running proof, for ineq
(define (mvx-zineq! . extra) (apply dk-ineq! (append mvx-zprem extra)))
(define (mvx-ccint-in! t lo hi . extra)     ; t in [lo, hi] by ineq from mvx-zprem and EXTRA
  (dk-have! (list 'IN t (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply mvx-zineq! extra)))))))
(define (mvx-ccint-out! t lo hi)    ; lo <= t <= hi and t in RR from t in [lo, hi]
  (fact 'ccint-elt-in-rr lo hi t)
  (let ((cj (list 'AND (list '<= lo t) (list '<= t hi))))
    (if (not (and (dk-asm? (list '<= lo t)) (dk-asm? (list '<= t hi))))
        (begin
          (dk-have! cj (lambda () (mac-h 'ccint-membership (list 'IN t (list 'CCINT lo hi))) (dk-split-all!)
                                  (dk-conj-close! dk-ass!)))
          (dk-split! cj)))))

(define (mvx-eq-by-le! x y . prems)
  (dk-have! (list '<= x y) (lambda () (apply dk-ineq! prems)))
  (dk-have! (list '<= y x) (lambda () (apply dk-ineq! prems)))
  (mvx-and! (list 'IN x 'RR) (list 'IN y 'RR))
  (mvx-and! (list '<= x y) (list '<= y x))
  (dk-cite! 'rr-leq-antisymmetric x y))

;;; the point c + r e^{it} of the circle, t in [0, 2 pi] in context: its typings, in the
;;; trace, in B(c, R), in u, f there typed; returns the point
(define (mvx-cpt! t R)
  (let* ((e (list 'CC-EXP (list '* '+i t))) (re (list '* 'r e)) (pp (list '+ 'c re)))
    (fact 'ccint-elt-in-rr 0 mvx-tp t)
    (mvx-cc! pp)
    (fact 'trace-value-in mvx-P 0 mvx-tp t)
    (if (not (dk-asm? (list '= (list mvx-P t) pp)))
        (dk-have! (list '= (list mvx-P t) pp)
          (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))
    (if (not (dk-asm? (list 'IN pp mvx-T)))
        (dk-have! (list 'IN pp mvx-T) (lambda () (subst (list '= pp (list mvx-P t))) (ass))))
    (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R pp))
    (fact 'subset-mem-fwd (mvx-ball 'c R) 'u pp)
    (fact 'fun-apply-type-c 'f 'u 'CC pp)
    pp))

(define mvx-mbound '(FORALL cmvy_ (IMPLIES (IN cmvy_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)))
                       (<= (magnitude (f cmvy_)) (magnitude (f c))))))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HAS-MEAN-VALUE-PROPERTY u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (mvx-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'cmvbr_ (mvx-imps (list '(IN cmvbr_ RR) '(< r cmvbr_) '(SUBSET (BALL CC-MS c cmvbr_) u) mvx-mbound)
      (list 'FORALL 'cmvt_ (list 'IMPLIES (list 'IN 'cmvt_ mvx-iv)
        '(= (f (+ c (* r (CC-EXP (* +i cmvt_))))) (f c)))))))))))))))
(dk-peel!)
(let* ((R 'cmvbr_) (B (mvx-ball 'c R)) (t0 'cmvt_)
       (fc '(f c)) (M '(magnitude (f c))))
  ;; the standing facts
  (mvx-mvp-open! 'u 'f)
  (fact 'cc-open-subset-cc 'u)
  (mvx-ms! 'u)
  (fact 'cc-is-metric-space) (mvx-pts-cc!)
  (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! (list '<= 0 R) (lambda () (dk-ineq! (list '< 'r R) '(< 0 r))))
  (dk-have! (list 'NOT (list '= 0 R)) (lambda () (di) (dk-absurd! (list '= 0 R) (list '< 'r R) '(< 0 r))))
  (mvx-and! (list 'IN R 'RR) (mvx-and! (list '<= 0 R) (list 'NOT (list '= 0 R))))
  (dk-cite! 'ball-center-in 'CC-MS 'c R)
  (fact 'subset-mem-fwd B 'u 'c)
  (fact 'fun-apply-type-c 'f 'u 'CC 'c)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path mvx-P mvx-DP 0 mvx-tp)
  (fact 'is-path-in-fun mvx-P 0 mvx-tp)
  (fact 'trace-subset-cc mvx-P 0 mvx-tp)
  (mvx-iv-ends!)
  (dk-have! (list 'SUBSET mvx-T 'u)
    (lambda ()
      (let ((y (subset-by-element!)))
        (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r R y))
        (fact 'subset-mem-fwd B 'u y)
        (dk-ass!))))
  (mvx-rr! M)
  (fact 'cc-magnitude-nonneg fc)
  (let* ((p0 (mvx-cpt! t0 R)) (fp0 (list 'f p0)) (mp0 (list 'magnitude fp0)))
    (dk-apply! (dk-ctx-form mvx-mbound) p0)
    (mvx-rr! mp0)
    (fact 'cc-magnitude-nonneg fp0)
    (use-em (list '= M 0)
      ;; M = 0: f vanishes at c and at p0
      (lambda ()
        (mvx-eq-by-le! mp0 0 (list '<= mp0 M) (list '= M 0) (list '<= 0 mp0))
        (dk-split-all! (list (dk-cite! 'cc-magnitude-zero-iff fp0)))
        (dk-split-all! (list (dk-cite! 'cc-magnitude-zero-iff fc)))
        (dk-have! (list '= fp0 0) (lambda () (prop)))
        (dk-have! (list '= fc 0) (lambda () (prop)))
        (subst (list '= fp0 0))
        (subst (list '= fc 0))
        (rfl))
      ;; M > 0: rotate
      (lambda ()
        (fact 'neq-sym M 0)
        (mvx-and! (list '<= 0 M) (list 'NOT (list '= 0 M)))
        (dk-cite! 'rr-le-ne-lt 0 M)
        (mvx-and! (list 'IN M 'RR) (list 'NOT (list '= M 0)))
        (dk-cite! 'rr-recip-closed M)
        (dk-cite! 'rr-recip-inverse M)
        (dk-cite! 'rr-recip-pos M)
        (let* ((kk (dk-name! (list 'recip M) 'RR))
               (cf (list 'conjugate fc))
               (lam (list '* cf kk))
               (psi (list 'VNB-LAMBDA 'cmvw_ 'u (list '+ M (list '* (list '- lam) '(f cmvw_)))))
               (cst (list 'VNB-LAMBDA 'hbx_ 'u M))
               (cng (list 'VNB-LAMBDA 'hbx_ 'u (list '- lam)))
               (prd (list 'VNB-LAMBDA 'cmvz_ 'u (list '* (list '- lam) '(f cmvz_))))
               (gpsi (list 'VNB-LAMBDA 'cmvt_ mvx-iv (list psi '(+ c (* r (CC-EXP (* +i cmvt_)))))))
               (h2R (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'real-part (list psi (list mvx-P 'pat_)))))
               (h2I (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'imag-part (list psi (list mvx-P 'pat_)))))
               (hR (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'real-part (list gpsi 'pat_))))
               (hI (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'imag-part (list gpsi 'pat_)))))
          (dk-have! (list '= (list '* M kk) 1) (lambda () (subst (list '= kk (list 'recip M))) (dk-ass!)))
          (dk-have! (list '< 0 kk) (lambda () (subst (list '= kk (list 'recip M))) (dk-ass!)))
          (fact 'cc-conjugate-closed fc)
          (fact 'rr-subset-cc kk) (fact 'rr-subset-cc M)
          (mvx-cc! lam) (mvx-cc! (list '- lam))
          ;; lambda f(c) = M and |lambda| = 1
          (dk-cite! 'cc-magnitude-sq-conjugate fc)
          (dk-have! (list '= (list '* lam fc) M)
            (lambda ()
              (dk-have! (list '= (list '* lam fc) (list '* (list '* fc cf) kk)) (lambda () (crs)))
              (subst (list '= (list '* lam fc) (list '* (list '* fc cf) kk)))
              (subst (list '= (list '* fc cf) (list '* M M)))
              (dk-have! (list '= (list '* (list '* M M) kk) (list '* M (list '* M kk))) (lambda () (crs)))
              (subst (list '= (list '* (list '* M M) kk) (list '* M (list '* M kk))))
              (subst (list '= (list '* M kk) 1))
              (crs)))
          (mvx-and! (list 'IN cf 'CC) (list 'IN kk 'CC))
          (dk-cite! 'cc-magnitude-mul cf kk)
          (dk-cite! 'cc-magnitude-conjugate fc)
          (dk-cite! 'rr-magnitude-is-abs kk)
          (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk))))
          (dk-cite! 'rr-abs-of-nonneg kk)
          (mvx-rr! (list 'magnitude lam))
          (dk-have! (list '= (list 'magnitude lam) 1)
            (lambda ()
              (subst (list '= (list 'magnitude lam) (list '* (list 'magnitude cf) (list 'magnitude kk))))
              (subst (list '= (list 'magnitude cf) M))
              (subst (list '= (list 'magnitude kk) (list 'abs kk)))
              (subst (list '= (list 'abs kk) kk))
              (dk-ass!)))
          (dk-have! (list 'NOT (list '= lam 0))
            (lambda ()
              (di)
              (dk-have! (list '= (list 'magnitude lam) 0)
                (lambda () (subst (list '= lam 0)) (fact 'cc-magnitude-zero) (dk-ass!)))
              (dk-absurd! (list '= (list 'magnitude lam) 0) (list '= (list 'magnitude lam) 1))))
          ;; psi = M - lambda f is holomorphic on u, and psi(c) = 0
          (mvx-cc! M)
          (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
          (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
          (dk-cite! 'holomorphic-const 'u M)
          (dk-cite! 'holomorphic-on-continuous 'u cst)
          (dk-have! (list 'IN cst '(FUN u CC))
            (lambda () (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (dk-ass!))))))
          (for-each
            (lambda (lm)
              (dk-have! (list 'IN lm '(FUN u CC))
                (lambda ()
                  (dk-lam-type!
                    (lambda ()
                      (let ((y (dk-di-var!)))
                        (fact 'fun-apply-type-c 'f 'u 'CC y)
                        (mvx-cc! (subst-free (cadr lm) y (list-ref lm 3)))
                        (dk-ass!)))))))
            (list psi prd))
          (let ((ptw (lambda (h rhs) (list 'FORALL 'cmvh_ (list 'IMPLIES '(IN cmvh_ u) (list '== (list h 'cmvh_) (rhs 'cmvh_)))))))
            (dk-have! (ptw prd (lambda (x) (list '* (list '- lam) (list 'f x))))
              (lambda () (let ((y (dk-di-var!))) (fact 'fun-apply-type-c 'f 'u 'CC y) (dk-lam-b!)
                           (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
            (dk-cite! 'aif-cont-scale 'u (list '- lam) 'f prd)
            (dk-have! (ptw psi (lambda (x) (list '+ (list cst x) (list prd x))))
              (lambda () (let ((y (dk-di-var!))) (fact 'fun-apply-type-c 'f 'u 'CC y) (dk-lam-b!)
                           (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
            (dk-cite! 'aif-cont-sum 'u cst prd psi))
          ;; THE MEAN VALUE PROPERTY OF f, not of psi: the integral of re(psi) round the circle is 0
          (mvx-tpi!)
          (mvx-cc! (list 'recip mvx-tp))
          (let* ((mvx-xv (list 'CC-INT gpsi 0 mvx-tp)))
            (dk-split-all! (list (dk-cite! 'continuous-on-compose-regulated 'u psi mvx-P 0 mvx-tp)))
            (dk-split-all! (list (dk-cite! 'continuous-on-compose-path 'u psi mvx-P 0 mvx-tp)))
            (let* ((q1 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 mvx-tp h2R)))
                   (q2 (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 mvx-tp h2I))))
              (let* ((fR (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'real-part (list 'f (list mvx-P 'pat_)))))
                     (fI (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'imag-part (list 'f (list mvx-P 'pat_)))))
                     (RG (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'real-part (list mvx-g 'pat_))))
                     (IG (list 'VNB-LAMBDA 'pat_ mvx-iv (list 'imag-part (list mvx-g 'pat_))))
                     (_r1 (dk-split-all! (list (dk-cite! 'continuous-on-compose-regulated 'u 'f mvx-P 0 mvx-tp))))
                     (qR (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 mvx-tp fR)))
                     (qI (dk-skolem! (dk-cite! 'regulated-on-has-primitive 0 mvx-tp fI)))
                     (Af (list 'PW-INT fR 0 mvx-tp)) (Bf (list 'PW-INT fI 0 mvx-tp))
                     (XX (list '+ Af (list '* Bf '+i)))
                     (CCI (list 'CC-INT mvx-g 0 mvx-tp))
                     (nl (list '- lam))
                     (pp (list 'real-part nl)) (qq (list 'imag-part nl)))
                (fact 'primitive-in-fun qR fR 0 mvx-tp) (fact 'primitive-in-fun qI fI 0 mvx-tp)
                (fact 'primitive-integrand-in-fun qR fR 0 mvx-tp) (fact 'primitive-integrand-in-fun qI fI 0 mvx-tp)
                (fact 'primitive-integrand-in-fun q1 h2R 0 mvx-tp)
                (dk-cite! 'pw-int-in-rr qR fR 0 mvx-tp) (dk-cite! 'pw-int-in-rr qI fI 0 mvx-tp)
                ;; the two spellings of f round the circle
                (for-each
                  (lambda (h2 h pr q)
                    (dk-have! (list 'IN h (list 'FUN mvx-iv 'RR))
                      (lambda ()
                        (dk-lam-type!
                          (lambda ()
                            (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)))
                              (dk-lam-b!)
                              (mvx-rr! (list pr (list 'f pt)))
                              (dk-ass!))))))
                    (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ mvx-iv) (list '== (list h2 'pay_) (list h 'pay_))))
                      (lambda ()
                        (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)))
                          (mac 'CIRCLE-PATH)
                          (dk-lam-b!)
                          (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
                    (dk-cite! 'pw-int-congruence q h2 h 0 mvx-tp))
                  (list fR fI) (list RG IG) (list 'real-part 'imag-part) (list qR qI))
                (dk-cite! 'cc-int-unfold mvx-g 0 mvx-tp)
                (mvx-cc! XX)
                (dk-have! (list '= CCI XX)
                  (lambda ()
                    (subst (list '== CCI (list '+ (list 'PW-INT RG 0 mvx-tp) (list '* (list 'PW-INT IG 0 mvx-tp) '+i))))
                    (subst (list '= (list 'PW-INT RG 0 mvx-tp) Af))
                    (subst (list '= (list 'PW-INT IG 0 mvx-tp) Bf))
                    (rfl)))
                ;; f(c) = (1 / 2 pi) XX, by the mean value property at (c, r): the closed disc is in B(c, R)
                (dk-cite! 'closure-of-ball-in-closed-ball 'CC-MS 'c 'r)
                (dk-cite! 'closed-ball-in-ball 'CC-MS 'c 'r R)
                (dk-cite! 'subset-trans (list 'CLOSURE 'CC-MS (mvx-ball 'c 'r)) (list 'CLOSED-BALL 'CC-MS 'c 'r) B)
                (dk-cite! 'subset-trans (list 'CLOSURE 'CC-MS (mvx-ball 'c 'r)) B 'u)
                (dk-apply! (dk-pick (lambda (fm) (and (mvx-op? fm 'FORALL 3) (dk-contains? fm 'CC-INT))) "the mean value property")
                           'c 'r)
                (mvx-and! (list 'IN mvx-tp 'CC) (list 'NOT (list '= mvx-tp 0)))
                (dk-cite! 'cc-recip-inverse mvx-tp)
                (let* ((rt (dk-name! (list 'recip mvx-tp) 'CC)))
                  (dk-have! (list '= (list '* mvx-tp rt) 1) (lambda () (subst (list '= rt (list 'recip mvx-tp))) (dk-ass!)))
                  (dk-have! (list '= (list '* mvx-tp fc) XX)
                    (lambda ()
                      (subst (list '= fc (list '* (list 'recip mvx-tp) CCI)))
                      (subst (list '= CCI XX))
                      (subst (list '= (list 'recip mvx-tp) rt))
                      (dk-have! (list '= (list '* mvx-tp (list '* rt XX)) (list '* (list '* mvx-tp rt) XX)) (lambda () (crs)))
                      (subst (list '= (list '* mvx-tp (list '* rt XX)) (list '* (list '* mvx-tp rt) XX)))
                      (subst (list '= (list '* mvx-tp rt) 1))
                      (crs))))
                ;; re(nl XX) two ways: p Af - q Bf, and -2 pi M
                (fact 'real-part-in-rr nl) (fact 'imag-part-in-rr nl)
                (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'cc-one-in)
                (let* ((xv (dk-name! XX 'CC))
                       (ri (dk-split-all! (list (dk-cite! 'cc-re-im-of xv Af Bf))))
                       (W (list '* nl xv)) (tm (list '* mvx-tp (list '- M))))
                  (mvx-rr! (list '- M)) (mvx-rr! tm) (mvx-cc! W)
                  (dk-cite! 'cc-re-mul nl xv)
                  (dk-have! (list '= xv (list '* mvx-tp fc))
                    (lambda () (subst (list '= xv XX)) (subst (list '= XX (list '* mvx-tp fc))) (rfl)))
                  (dk-have! (list '= W (list '* tm 1))
                    (lambda ()
                      (subst (list '= xv (list '* mvx-tp fc)))
                      (dk-have! (list '= (list '* nl (list '* mvx-tp fc)) (list '* mvx-tp (list '- (list '* lam fc))))
                        (lambda () (crs)))
                      (subst (list '= (list '* nl (list '* mvx-tp fc)) (list '* mvx-tp (list '- (list '* lam fc)))))
                      (subst (list '= (list '* lam fc) M))
                      (crs)))
                  (dk-have! '(= 1 (+ 1 (* 0 +i))) (lambda () (crs)))
                  (dk-split-all! (list (dk-cite! 'cc-re-im-of 1 1 0)))
                  (dk-cite! 'cc-re-real-mul tm 1)
                  (dk-have! (list '= (list '- (list '* pp Af) (list '* qq Bf)) tm)
                    (lambda ()
                      (subst (list '= Af (list 'real-part xv)))
                      (subst (list '= Bf (list 'imag-part xv)))
                      (subst (list '= (list '- (list '* pp (list 'real-part xv)) (list '* qq (list 'imag-part xv))) (list 'real-part W)))
                      (subst (list '= W (list '* tm 1)))
                      (subst (list '= (list 'real-part (list '* tm 1)) (list '* tm (list 'real-part 1))))
                      (subst (list '= (list 'real-part 1) 1))
                      (crs))))
                ;; the combination HH = M + p fR - q fI, its primitive, and its integral 0
                (let* ((mk (lambda (body) (list 'VNB-LAMBDA 'mvk_ mvx-iv body)))
                       (fRt (lambda (t) (list 'real-part (list 'f (list mvx-P t)))))
                       (fIt (lambda (t) (list 'imag-part (list 'f (list mvx-P t)))))
                       (mq (list '- qq))
                       (Kb (lambda (t) (list '+ (list '* pp (fRt t)) (list '* mq (fIt t)))))
                       (QKb (lambda (t) (list '+ (list '* pp (list qR t)) (list '* mq (list qI t)))))
                       (K (mk (Kb 'mvk_))) (QK (mk (QKb 'mvk_)))
                       (CM (mk M)) (QMb (lambda (t) (list '+ 0 (list '* M t)))) (QM (mk (QMb 'mvk_)))
                       (HH (mk (list '+ (list '* 1 M) (list '* 1 (Kb 'mvk_)))))
                       (QH (mk (list '+ (list '* 1 (QMb 'mvk_)) (list '* 1 (QKb 'mvk_))))))
                  (mvx-rr! mq) (fact 'rr-zero-in) (fact 'rr-one-in)
                  (for-each
                    (lambda (lm)
                      (dk-have! (list 'IN lm (list 'FUN mvx-iv 'RR))
                        (lambda ()
                          (dk-lam-type!
                            (lambda ()
                              (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)))
                                (fact 'fun-apply-type-c qR mvx-iv 'RR t) (fact 'fun-apply-type-c qI mvx-iv 'RR t)
                                (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                (if (dk-contains? (dk-goal) (list mvx-P t)) (subst (list '= (list mvx-P t) pt)))
                                (mvx-rr! (cadr (dk-goal)))
                                (dk-ass!)))))))
                    (list K QK CM QM HH QH))
                  (let ((ptw (lambda (lhs rhs)
                               (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ mvx-iv) (list '== (lhs 'pay_) (rhs 'pay_))))
                                 (lambda ()
                                   (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)))
                                     (dk-lam-b!)
                                     (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))))))
                    (ptw (lambda (t) (list QK t)) (lambda (t) (list '+ (list '* pp (list qR t)) (list '* mq (list qI t)))))
                    (ptw (lambda (t) (list K t)) (lambda (t) (list '+ (list '* pp (list fR t)) (list '* mq (list fI t)))))
                    (ptw (lambda (t) (list QM t)) (lambda (t) (list '+ 0 (list '* M t))))
                    (ptw (lambda (t) (list CM t)) (lambda (t) M))
                    (ptw (lambda (t) (list QH t)) (lambda (t) (list '+ (list '* 1 (list QM t)) (list '* 1 (list QK t)))))
                    (ptw (lambda (t) (list HH t)) (lambda (t) (list '+ (list '* 1 (list CM t)) (list '* 1 (list K t))))))
                  (dk-split-all! (list (dk-cite! 'pw-antiderivative-linear 0 mvx-tp pp mq qR qI fR fI QK K)))
                  (dk-cite! 'pw-affine-antiderivative 0 mvx-tp 0 M QM CM)
                  (dk-split-all! (list (dk-cite! 'pw-antiderivative-linear 0 mvx-tp 1 1 QM QK CM K QH HH)))
                  (dk-cite! 'pw-int-value QM CM 0 mvx-tp)
                  (dk-cite! 'pw-int-in-rr QM CM 0 mvx-tp) (dk-cite! 'pw-int-in-rr QK K 0 mvx-tp)
                  (let ((ic (list 'PW-INT CM 0 mvx-tp)) (ik (list 'PW-INT K 0 mvx-tp)) (ih (list 'PW-INT HH 0 mvx-tp)))
                    (dk-have! (list '= ic (list '* M mvx-tp))
                      (lambda ()
                        (subst (list '= ic (list '- (list QM mvx-tp) (list QM 0))))
                        (dk-lam-b!)
                        (crs)))
                    ;; HH = re(psi) round the circle
                    (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ mvx-iv) (list '== (list HH 'pay_) (list h2R 'pay_))))
                      (lambda ()
                        (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)) (zz (list 'f pt)))
                          (mac 'CIRCLE-PATH)
                          (dk-lam-b!)
                          (mvx-cc! (list '* nl zz)) (fact 'real-part-in-rr zz) (fact 'imag-part-in-rr zz)
                          (fact 'cc-re-mul nl zz)
                          (mvx-cc! M)
                          (fact 'cc-re-add M (list '* nl zz))
                          (dk-have! (list '= M (list '+ M (list '* 0 '+i))) (lambda () (crs)))
                          (dk-split-all! (list (dk-cite! 'cc-re-im-of M M 0)))
                          (subst (list '= (list 'real-part (list '+ M (list '* nl zz)))
                                       (list '+ (list 'real-part M) (list 'real-part (list '* nl zz)))))
                          (subst (list '= (list 'real-part (list '* nl zz))
                                       (list '- (list '* pp (list 'real-part zz)) (list '* qq (list 'imag-part zz)))))
                          (subst (list '= (list 'real-part M) M))
                          (let ((lhs (list '+ (list '* 1 M) (list '* 1 (list '+ (list '* pp (list 'real-part zz)) (list '* mq (list 'imag-part zz))))))
                                (rhs (list '+ M (list '- (list '* pp (list 'real-part zz)) (list '* qq (list 'imag-part zz))))))
                            (dk-have! (list '= lhs rhs) (lambda () (crs)))
                            (subst (list '= lhs rhs))
                            (qrfl)))))
                    (dk-cite! 'pw-int-congruence QH HH h2R 0 mvx-tp)
                    (dk-have! (list '= (list 'PW-INT h2R 0 mvx-tp) 0)
                      (lambda ()
                        (subst (list '= (list 'PW-INT h2R 0 mvx-tp) ih))
                        (subst (list '= ih (list '+ (list '* 1 ic) (list '* 1 ik))))
                        (subst (list '= ic (list '* M mvx-tp)))
                        (subst (list '= ik (list '+ (list '* pp Af) (list '* mq Bf))))
                        (dk-have! (list '= (list '+ (list '* pp Af) (list '* mq Bf)) (list '- (list '* pp Af) (list '* qq Bf)))
                          (lambda () (crs)))
                        (subst (list '= (list '+ (list '* pp Af) (list '* mq Bf)) (list '- (list '* pp Af) (list '* qq Bf))))
                        (subst (list '= (list '- (list '* pp Af) (list '* qq Bf)) (list '* mvx-tp (list '- M))))
                        (crs))))))
              ;; the real part of psi round the circle is >= 0
              (let ((dec!
                     (lambda (pt)    ; land rz, iz, W = psi(pt) reduced, re(W) = M - rz, |z| = |f(pt)|; return (W rz iz z)
                       (let* ((fpt (list 'f pt)) (z (list '* lam fpt))
                              (W (list '+ M (list '* (list '- lam) fpt))))
                         (mvx-cc! z) (mvx-cc! W)
                         (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
                         (fact 'cc-re-im-decompose z)
                         (let* ((rz (dk-name! (list 'real-part z) 'RR)) (iz (dk-name! (list 'imag-part z) 'RR)))
                           (dk-have! (list '= z (list '+ rz (list '* '+i iz)))
                             (lambda () (subst (list '= rz (list 'real-part z))) (subst (list '= iz (list 'imag-part z))) (dk-ass!)))
                           (mvx-rr! (list '- M rz)) (mvx-rr! (list '- iz))
                           (let ((mvx-xv (list '+ (list '- M rz) (list '* (list '- iz) '+i))))
                             (mvx-cc! mvx-xv) (mvx-cc! (list '- M z))
                             (dk-have! (list '= W (list '- M z)) (lambda () (crs)))
                             (dk-have! (list '= (list '- M z) mvx-xv)
                               (lambda () (subst (list '= z (list '+ rz (list '* '+i iz)))) (crs)))
                             (dk-have! (list '= W mvx-xv)
                               (lambda () (subst (list '= W (list '- M z))) (dk-ass!))))
                           (dk-split-all! (list (dk-cite! 'cc-re-im-of W (list '- M rz) (list '- iz))))
                           ;; |z| = |f(pt)|
                           (mvx-and! (list 'IN lam 'CC) (list 'IN fpt 'CC))
                           (dk-cite! 'cc-magnitude-mul lam fpt)
                           (mvx-rr! (list 'magnitude z)) (mvx-rr! (list 'magnitude fpt))
                           (dk-have! (list '= (list 'magnitude z) (list 'magnitude fpt))
                             (lambda ()
                               (subst (list '= (list 'magnitude z) (list '* (list 'magnitude lam) (list 'magnitude fpt))))
                               (subst (list '= (list 'magnitude lam) 1))
                               (crs)))
                           (dk-cite! 'cc-abs-re-le-magnitude z)
                           (dk-cite! 'rr-le-abs (list 'real-part z))
                           (fact 'rr-abs-closed (list 'real-part z))
                           (dk-have! (list '<= rz (list 'magnitude z))
                             (lambda ()
                               (subst (list '= rz (list 'real-part z)))
                               (dk-ineq! (list '<= (list 'real-part z) (list 'abs (list 'real-part z)))
                                         (list '<= (list 'abs (list 'real-part z)) (list 'magnitude z)))))
                           (list W rz iz z))))))
                (dk-have! (list 'FORALL 'cmzt_ (list 'IMPLIES (list 'IN 'cmzt_ mvx-iv) (list '<= 0 (list h2R 'cmzt_))))
                  (lambda ()
                    (let* ((t (dk-di-var!)) (pt (mvx-cpt! t R)) (fpt (list 'f pt)))
                      (dk-apply! (dk-ctx-form mvx-mbound) pt)
                      (let* ((dd (dec! pt)) (W (car dd)) (rz (cadr dd)) (z (cadddr dd)))
                        (mac 'CIRCLE-PATH)
                        (dk-lam-b!)
                        (subst (list '= (list 'real-part W) (list '- M rz)))
                        (dk-ineq! (list '<= rz (list 'magnitude z)) (list '= (list 'magnitude z) (list 'magnitude fpt))
                                  (list '<= (list 'magnitude fpt) M))))))
                (dk-cite! 'pw-int-nonneg-zero q1 h2R 0 mvx-tp)
                ;; at t0: re(psi(p0)) = 0, so lambda f(p0) = M = lambda f(c)
                (let* ((dd (dec! p0)) (W (car dd)) (rz (cadr dd)) (iz (caddr dd)) (z (cadddr dd))
                       (mz (list 'magnitude z)))
                  (dk-have! (list '= (list 'real-part W) 0)
                    (lambda ()
                      (dk-have! (list '= (list h2R t0) (list 'real-part W))
                        (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                      (subst (list '= (list 'real-part W) (list h2R t0)))
                      (dk-apply! (dk-pick (lambda (fm) (and (mvx-op? fm 'FORALL 3) (dk-contains? fm h2R) (dk-contains? fm '=)))
                                          "h2R vanishes")
                                 t0)
                      (dk-ass!)))
                  (dk-have! (list '= (list '- M rz) 0) (lambda () (subst (list '= (list '- M rz) (list 'real-part W))) (dk-ass!)))
                  ;; |z| <= M and |z|^2 = rz^2 + iz^2 = M^2 + iz^2: iz = 0
                  (dk-cite! 'cc-magnitude-sq z)
                  (mvx-rr! (list '* mz mz)) (mvx-rr! (list '* iz iz)) (mvx-rr! (list '* M M)) (mvx-rr! (list '* rz rz))
                  (fact 'cc-magnitude-nonneg z)
                  (dk-have! (list '<= mz M) (lambda () (dk-ineq! (list '= mz (list 'magnitude fp0)) (list '<= (list 'magnitude fp0) M))))
                  (mvx-and! (list '<= mz M) (list '<= 0 mz))
                  (dk-cite! 'rr-mul-le-right mz M mz)
                  (mvx-and! (list '<= mz M) (list '<= 0 M))
                  (dk-cite! 'rr-mul-le-right mz M M)
                  (mvx-rr! (list '* M mz))
                  (mvx-eq-by-le! rz M (list '= (list '- M rz) 0))
                  (dk-have! (list '= (list '* mz mz) (list '+ (list '* rz rz) (list '* iz iz)))
                    (lambda () (subst (list '= rz (list 'real-part z))) (subst (list '= iz (list 'imag-part z))) (dk-ass!)))
                  (dk-have! (list '= (list '* rz rz) (list '* M M)) (lambda () (subst (list '= rz M)) (crs)))
                  (mvx-rr! (list '* mz M))
                  (dk-have! (list '= (list '* M mz) (list '* mz M)) (lambda () (crs)))
                  (dk-have! (list '= (list '* 0 0) 0) (lambda () (crs)))
                  (dk-have! (list '<= (list '* iz iz) (list '* 0 0))
                    (lambda () (mvx-rr! (list '* 0 0))
                               (dk-ineq! (list '= (list '* mz mz) (list '+ (list '* rz rz) (list '* iz iz)))
                                         (list '= (list '* rz rz) (list '* M M))
                                         (list '<= (list '* mz mz) (list '* M mz)) (list '<= (list '* mz M) (list '* M M))
                                         (list '= (list '* M mz) (list '* mz M)) (list '= (list '* 0 0) 0))))
                  (fact 'rr-zero-in)
                  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                  (dk-cite! 'rr-le-of-sq-le iz 0)
                  (dk-have! (list '<= (list '* (list '- iz) (list '- iz)) (list '* 0 0))
                    (lambda () (dk-have! (list '= (list '* (list '- iz) (list '- iz)) (list '* iz iz)) (lambda () (crs)))
                               (subst (list '= (list '* (list '- iz) (list '- iz)) (list '* iz iz))) (dk-ass!)))
                  (dk-cite! 'rr-le-of-sq-le (list '- iz) 0)
                  (mvx-eq-by-le! iz 0 (list '<= iz 0) (list '<= (list '- iz) 0))
                  (dk-have! (list '= z M)
                    (lambda () (subst (list '= z (list '+ rz (list '* '+i iz)))) (subst (list '= rz M)) (subst (list '= iz 0)) (crs)))
                  ;; cancel lambda
                  (mvx-and! (list 'IN lam 'CC) (list 'NOT (list '= lam 0)))
                  (dk-cite! 'cc-recip-inverse lam)
                  (mvx-cc! (list 'recip lam))
                  (let ((il (dk-name! (list 'recip lam) 'CC)))
                    (dk-have! (list '= (list '* lam il) 1) (lambda () (subst (list '= il (list 'recip lam))) (dk-ass!)))
                    (dk-have! (list '= fp0 (list '* (list '* lam il) fp0)) (lambda () (subst (list '= (list '* lam il) 1)) (crs)))
                    (subst (list '= fp0 (list '* (list '* lam il) fp0)))
                    (dk-have! (list '= (list '* (list '* lam il) fp0) (list '* il z)) (lambda () (crs)))
                    (subst (list '= (list '* (list '* lam il) fp0) (list '* il z)))
                    (subst (list '= z M))
                    (subst (list '= M (list '* lam fc)))
                    (dk-have! (list '= (list '* il (list '* lam fc)) (list '* (list '* lam il) fc)) (lambda () (crs)))
                    (subst (list '= (list '* il (list '* lam fc)) (list '* (list '* lam il) fc)))
                    (subst (list '= (list '* lam il) 1))
                    (crs)))))))))))
(qed 'mvp-circle-max-constant)

