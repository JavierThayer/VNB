(lzy-done! 'pad-ones-lo)

(sp (make-wff (forall-guarded '(m k l f j) (append LZY-PH '((IN j (INTERVAL 1 m)) (NOT (<= j k)))) (list '= (list LZY-PAD 'j) '(f (NN-MINUS j k))))))
(dk-peel!)
(dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l 'j))
(fact 'fun-apply-type-c 'f '(INTERVAL 1 l) 'ZZ '(NN-MINUS j k))
(mac 'PAD-ONES)
(lzy-beta!)
(dk-if-branch! #f (let find ((e (dk-goal))) (cond ((and (pair? e) (eq? (car e) 'IF)) e) ((pair? e) (or (find (car e)) (find (cdr e)))) (#t #f)))
  #f (lambda () (rfl)))
(lzy-done! 'pad-ones-hi)

;; the value at j in ZZ, by cases; CASE-K gets (true?) with the value equation landed
(define (lzy-pad-case! j k-proc)
  (use-em (list '<= j 'k)
    (lambda () (dk-cite! 'pad-ones-lo 'm 'k 'l 'f j) (k-proc #t))
    (lambda () (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l j)) (dk-cite! 'pad-ones-hi 'm 'k 'l 'f j) (k-proc #f))))
(sp (make-wff (forall-guarded '(m k l f) LZY-PH (list 'IN LZY-PAD '(FUN (INTERVAL 1 m) ZZ)))))
(dk-peel!)
(fact 'interval-in-set 1 'm)
(fact 'zz-one-in)
(mac 'PAD-ONES)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!)) (j (lzy-iv-var ld '(INTERVAL 1 m))))
      (if (not (lzy-beta!))
          (dk-case-if! (let find ((e (dk-goal))) (cond ((and (pair? e) (eq? (car e) 'IF)) e) ((pair? e) (or (find (car e)) (find (cdr e)))) (#t #f)))
            (lambda (lo? v)
              (if lo?
                  (ass)
                  (begin (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l j))
                         (fact 'fun-apply-type-c 'f '(INTERVAL 1 l) 'ZZ (list 'NN-MINUS j 'k))
                         (ass))))))))
  (lambda () (ass)))
(lzy-done! 'pad-ones-type)

(define LZY-PFNN '(FORALL ifi_ (IMPLIES (IN ifi_ (INTERVAL 1 l)) (<= 0 (f ifi_)))))
(define LZY-PFCH '(FORALL ifi_ (FORALL ifj_ (IMPLIES (IN ifi_ (INTERVAL 1 l)) (IMPLIES (IN ifj_ (INTERVAL 1 l))
                   (IMPLIES (<= ifi_ ifj_) (ZZ-DIVIDES (f ifi_) (f ifj_))))))))
(sp (make-wff (forall-guarded '(m k l f) (append LZY-PH (list LZY-PFNN))
  (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 m)) (list '<= 0 (list LZY-PAD 'j)))))))
(let* ((ld (dk-peel!)) (j (lzy-iv-var ld '(INTERVAL 1 m))))
  (lzy-pad-case! j
    (lambda (lo?)
      (if lo?
          (begin (subst (list '= (list LZY-PAD j) 1)) (dk-ineq!))
          (begin (subst (list '= (list LZY-PAD j) (list 'f (list 'NN-MINUS j 'k))))
                 (dk-apply! LZY-PFNN (list 'NN-MINUS j 'k))
                 (ass))))))
(lzy-done! 'pad-ones-nonneg)

(sp (make-wff (forall-guarded '(m k l f) (append LZY-PH (list LZY-PFCH))
  (list 'FORALL 'i (list 'FORALL 'j (list 'IMPLIES '(IN i (INTERVAL 1 m)) (list 'IMPLIES '(IN j (INTERVAL 1 m))
    (list 'IMPLIES '(<= i j) (list 'ZZ-DIVIDES (list LZY-PAD 'i) (list LZY-PAD 'j))))))))))
(let* ((ld (dk-peel!))
       (ivs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 m)))) ld)))
       (le (find-first (dk-head? '<=) ld))
       (i (cadr le)) (j (caddr le)))
  (fact 'pad-ones-type 'm 'k 'l 'f)
  (lzy-iv! i 1 'm) (lzy-iv! j 1 'm)
  (fact 'fun-apply-type-c LZY-PAD '(INTERVAL 1 m) 'ZZ j)
  (use-em (list '<= i 'k)
    (lambda ()
      (subst (dk-cite! 'pad-ones-lo 'm 'k 'l 'f i))
      (dk-cite! 'lzx-one-divides (list LZY-PAD j))
      (ass))
    (lambda ()
      (dk-have! (list 'NOT (list '<= j 'k))
        (lambda () (fact 'nn-not-le-succ-le i 'k) (dk-nn! (list '<= (list 'succ 'k) i) le)))
      (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l i))
      (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l j))
      (subst (dk-cite! 'pad-ones-hi 'm 'k 'l 'f i))
      (subst (dk-cite! 'pad-ones-hi 'm 'k 'l 'f j))
      (let ((mi (list 'NN-MINUS i 'k)) (mj (list 'NN-MINUS j 'k)))
        (lzy-iv! mi 1 'l) (lzy-iv! mj 1 'l)
        (dk-have! (list '<= mi mj) (lambda () (dk-nn! le (list '= (list '+ 'k mi) i) (list '= (list '+ 'k mj) j))))
        (dk-apply! LZY-PFCH mi mj)
        (ass)))))
(lzy-done! 'pad-ones-chain)

