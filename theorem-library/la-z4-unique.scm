(dk-peel!)
(lzy-zsetup! 'n)
(lzy-free! 'n)
(fact 'zz-row-type 'n 'x)
(dk-have! '(IN (ZZ-ROW n x) (MAT 1 n (CARR (SCAL (ZZ-POW n))))) (lambda () (subst '(= (SCAL (ZZ-POW n)) ZZ-RING)) (ass)))
(let* ((e1 (dk-cite! 'lincomb-coord '(ZZ-POW n) 'n '(ZZ-UNITS n) '(ZZ-ROW n x)))
       (e2 (dk-cite! 'zz-pow-row-lincomb 'n 'x))
