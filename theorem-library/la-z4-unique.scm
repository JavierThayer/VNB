  (subst e3)
  (subst (dk-cite! 'zz-row-entry 'n 'x 'j))
  (fact 'zz-pow-vec-out 'n 'x 'j)
  (rfl))
(lzy-done! 'zz-pow-coord)

(define (lzy-dm d f) (list 'DIAG-MAT d f))
(define (lzy-wd d f) (list 'MATACT (list 'ZZ-POW d) (lzy-dm d f) (list 'ZZ-UNITS d)))
(define (lzy-kd d f) (list 'SPAN (list 'ZZ-POW d) d (lzy-wd d f)))
(define (lzy-famd d dm) (list 'VNB-LAMBDA 'fmi_ (list 'INTERVAL 1 d) (list 'ZZ-MOD (list 'ENTRY dm 'fmi_ 'fmi_))))
(define (lzy-td d dm) (list 'DIRECT-SUM 'ZZ-RING d (lzy-famd d dm)))
(define (lzy-zsd a) (list 'QMOD-SETOID LZY-RAM (list 'PRINCIPAL-IDEAL 'ZZ-RING a)))
(define (lzy-phd d dm)
  (list 'VNB-LAMBDA 'phx_ (list 'VEC (list 'ZZ-POW d))
