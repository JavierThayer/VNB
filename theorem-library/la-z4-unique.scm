(dk-peel!)
(mac 'PAD-ONES)
(lzy-beta!)
(dk-if-branch! #t (let find ((e (dk-goal))) (cond ((and (pair? e) (eq? (car e) 'IF)) e) ((pair? e) (or (find (car e)) (find (cdr e)))) (#t #f)))
