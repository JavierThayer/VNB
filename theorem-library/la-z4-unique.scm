  (fact 'identmat-type 'ZZ-RING 'n))
(sp (make-wff (forall-guarded '(n f) LZY-DGH '(IN (DIAG-MAT n f) (MAT n n ZZ)))))
(dk-peel!)
(lzy-dg-setup!)
(mac 'DIAG-MAT)
(lzy-dg-pt! '(CARR ZZ-RING))
