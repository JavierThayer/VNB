              (fact 'fun-apply-type-c 'f '(INTERVAL 1 n) 'ZZ i)
              (dk-rewrite-h! (list 'IN (list 'f i) 'ZZ) 'ZZ '(CARR ZZ-RING))
              (fact 'entry-in-carrier 'n 'n '(CARR ZZ-RING) '(IDENTMAT ZZ-RING n) i j)
              (fact 'ring-carrier-closed-mul 'ZZ-RING (list 'f i) (list 'ENTRY '(IDENTMAT ZZ-RING n) i j))
