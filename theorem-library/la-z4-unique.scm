                   (h2 (dk-rewrite-h! h1 (list '(SEQ-SHIFT n z) i) (list 'z (list '+ 'n i))))
                   (h3 (dk-rewrite-h! h2 (list '+ 'n i) j)))
              (subst (dk-cite! 'pad-ones-hi 'm 'n 'n 'f j))
              (ass)))))))
  (dk-only! i1 i2 (list 'IMPLIES rm rn) (list 'IMPLIES rn rm))
  (prop))
(lzy-done! 'zz-pow-pad-span-iff)

;;; =====================================================================
;;; (8) the Schanuel map carries K_A into K_B
;;; =====================================================================
(define (lzy-ta f) (lzy-td 'n (lzy-dm 'n f)))
(define (lzy-pha f) (lzy-phd 'n (lzy-dm 'n f)))
(define LZY-TAL (lzy-ta 'al))
(define LZY-TBE (lzy-ta 'be))
(define LZY-PAL (lzy-pha 'al))
(define LZY-PBE (lzy-pha 'be))
(define LZY-R1 (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC (ZZ-POW n))) (list '= (list LZY-PBE '(la x_)) (list 'hh (list LZY-PAL 'x_))))))
(define LZY-R2 (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC (ZZ-POW n))) (list '= (list LZY-PAL '(lb x_)) (list 'gg (list LZY-PBE 'x_))))))
(define LZY-R3 (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ (list 'VEC LZY-TBE)) (list '= '(hh (gg y_)) 'y_))))
(define LZY-KHYPS
  (list '(IN m NN) '(IN n NN) '(= m (+ n n)) '(IN al (FUN (INTERVAL 1 n) ZZ)) '(IN be (FUN (INTERVAL 1 n) ZZ))
        '(IS-HOM-MODULE (ZZ-POW n) (ZZ-POW n) la) '(IS-HOM-MODULE (ZZ-POW n) (ZZ-POW n) lb)
        (list 'IS-HOM-MODULE LZY-TAL LZY-TBE 'hh) (list 'IN 'gg (list 'FUN (list 'VEC LZY-TBE) (list 'VEC LZY-TAL)))
        LZY-R1 LZY-R2 LZY-R3))
(define (lzy-kpad f) (lzy-kd 'm (list 'PAD-ONES 'm 'n f)))
(sp (make-wff (forall-guarded '(m n al be la lb hh gg) LZY-KHYPS
  (list 'FORALL 'z (list 'IMPLIES '(IN z (VEC (ZZ-POW m))) (list 'IMPLIES (list 'IN 'z (lzy-kpad 'al))
    (list 'IN '((SCHANUEL-MAP m n la lb) z) (lzy-kpad 'be))))))))
(let* ((ld (dk-peel!)))
  (lzy-zsetup! 'n)
  (lzy-zsetup! 'm)
  (lzy-pres! 'n 'al)
  (lzy-pres! 'n 'be)
  (lzy-hom-open! LZY-ZN LZY-ZN 'la)
  (lzy-hom-open! LZY-ZN LZY-ZN 'lb)
  (lzy-hom-open! LZY-TAL LZY-TBE 'hh)
  (let* ((pa-al (lzy-pres-args 'n 'al)) (pa-be (lzy-pres-args 'n 'be))
         (tz '((SCHANUEL-MAP m n la lb) z))
         (hz '(SEQ-HEAD n z)) (sz '(SEQ-SHIFT n z))
         (lbh (list 'lb hz))
         (u (lzy-vadd sz (lzy-vneg lbh)))
         (vz (lzy-vadd hz (list 'la u)))
         (q (list LZY-PBE hz))
         (z0al (list 'VZERO LZY-TAL)) (z0be (list 'VZERO LZY-TBE))
         (vadd-al (list 'VADD LZY-TAL)) (vneg-al (list 'VNEG LZY-TAL))
         (vadd-be (list 'VADD LZY-TBE)) (vneg-be (list 'VNEG LZY-TBE)))
    (for-each (lambda (pa) (dk-split! (apply dk-cite! 'lzt-fam-modules pa))) (list pa-al pa-be))
    (fact 'direct-sum-is-module 'ZZ-RING 'n (lzy-famd 'n (lzy-dm 'n 'al)))
    (fact 'direct-sum-is-module 'ZZ-RING 'n (lzy-famd 'n (lzy-dm 'n 'be)))
    (apply fact 'lzt-ph-hom pa-al)
    (apply fact 'lzt-ph-hom pa-be)
    (lzy-hom-open! LZY-ZN LZY-TAL LZY-PAL)
    (lzy-hom-open! LZY-ZN LZY-TBE LZY-PBE)
    (fact 'seq-head-vec 'm 'n 'z)
    (fact 'seq-shift-vec 'm 'n 'z)
    (fact 'schanuel-vec 'm 'n 'la 'lb 'z)
    (fact 'pad-ones-type 'm 'n 'n 'al)
    (fact 'pad-ones-type 'm 'n 'n 'be)
    ;; z in K_A: PH_al(SHIFT z) = 0
    (let* ((i1 (dk-cite! 'zz-pow-pad-span-iff 'm 'n 'al 'z))
           (s1 (dk-meta-iff-r! i1))
           (k1 (apply dk-cite! 'lzt-ph-kernel (append pa-al (list sz))))
           (k1r (dk-meta-iff-l! k1)))
      #t)
    ;; types
    (fact 'fun-apply-type-c 'lb LZY-VN LZY-VN hz)
    (lzy-zvt! 'n u)
    (fact 'fun-apply-type-c 'la LZY-VN LZY-VN u)
    (lzy-zvt! 'n (lzy-vneg lbh))
    (for-each (lambda (x) (fact 'fun-apply-type-c LZY-PAL LZY-VN (list 'VEC LZY-TAL) x)) (list sz (lzy-vneg lbh) lbh u))
    (for-each (lambda (x) (fact 'fun-apply-type-c LZY-PBE LZY-VN (list 'VEC LZY-TBE) x)) (list hz (list 'la u)))
    (fact 'fun-apply-type-c 'gg (list 'VEC LZY-TBE) (list 'VEC LZY-TAL) q)
    (fact 'module-vneg-type LZY-TAL (list 'gg q))
    (fact 'module-vzero-in LZY-TAL)
    (fact 'module-vzero-in LZY-TBE)
    ;; PH_be(SHIFT (theta z)) = 0
    (dk-have! (list '= (list LZY-PBE (list 'SEQ-SHIFT 'n tz)) z0be)
      (lambda ()
        (subst (dk-cite! 'schanuel-shift 'm 'n 'la 'lb 'z))
        (subst (dk-apply! (lzy-hcl-add LZY-ZN LZY-TBE LZY-PBE) hz (list 'la u)))
        (subst (dk-apply! LZY-R1 u))
        (subst (dk-apply! (lzy-hcl-add LZY-ZN LZY-TAL LZY-PAL) sz (lzy-vneg lbh)))
        (subst (list '= (list LZY-PAL sz) z0al))
        (subst (dk-apply! (lzy-hcl-neg LZY-ZN LZY-TAL LZY-PAL) lbh))
        (subst (dk-apply! LZY-R2 hz))
        (subst (dk-apply! (lzy-hcl-add LZY-TAL LZY-TBE 'hh) z0al (list vneg-al (list 'gg q))))
        (subst (lzy-hcl-zero LZY-TAL LZY-TBE 'hh))
        (subst (dk-apply! (lzy-hcl-neg LZY-TAL LZY-TBE 'hh) (list 'gg q)))
        (subst (dk-apply! LZY-R3 q))
        (fact 'module-vneg-type LZY-TBE q)
        (subst (dk-cite! 'lzq-vzero-l LZY-TBE (list vneg-be q)))
        (subst (dk-cite! 'lzq-inv-r LZY-TBE q))
        (rfl)))
    (fact 'seq-shift-vec 'm 'n tz)
    (let* ((k2 (apply dk-cite! 'lzt-ph-kernel (append pa-be (list (list 'SEQ-SHIFT 'n tz)))))
           (k2r (dk-meta-iff-r! k2))
           (i2 (dk-cite! 'zz-pow-pad-span-iff 'm 'n 'be tz)))
      (dk-meta-iff-l! i2)
      (ass))))
(lzy-done! 'schanuel-kernel-map)

;;; =====================================================================
;;; (9) the core: an isomorphism of Z/(al_1)+...+Z/(al_n) onto Z/(be_1)+...+Z/(be_n),
;;;     al and be nonnegative divisibility chains, forces al = be
;;; =====================================================================
(define (lzy-fnn f l) (list 'FORALL 'ifi_ (list 'IMPLIES (list 'IN 'ifi_ (list 'INTERVAL 1 l)) (list '<= 0 (list f 'ifi_)))))
(define (lzy-fch f l) (list 'FORALL 'ifi_ (list 'FORALL 'ifj_ (list 'IMPLIES (list 'IN 'ifi_ (list 'INTERVAL 1 l)) (list 'IMPLIES (list 'IN 'ifj_ (list 'INTERVAL 1 l))
                         (list 'IMPLIES '(<= ifi_ ifj_) (list 'ZZ-DIVIDES (list f 'ifi_) (list f 'ifj_))))))))
(define (lzy-csfam l f) (list 'VNB-LAMBDA 'csi_ (list 'INTERVAL 1 l) (list 'ZZ-MOD (list f 'csi_))))
(define (lzy-cs l f) (list 'DIRECT-SUM 'ZZ-RING l (lzy-csfam l f)))
(define (lzy-zmod-hyps! l f)              ; HM, HS of the cyclic-sum family of f on [1,l]; f in FUN([1,l], ZZ) in context
  (let ((hm (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l)) (list 'IS-MODULE (list (lzy-csfam l f) 'i_)))))
        (hs (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l)) (list '= (list 'SCAL (list (lzy-csfam l f) 'i_)) 'ZZ-RING)))))
    (for-each
      (lambda (claim)
        (if (not (dk-asm? claim))
            (dk-have! claim
              (lambda ()
                (let* ((ld (dk-peel!)) (i (lzy-iv-var ld (list 'INTERVAL 1 l))))
                  (fact 'fun-apply-type-c f (list 'INTERVAL 1 l) 'ZZ i)
                  (if (not (dk-asm? (list 'IN (list f i) '(CARR ZZ-RING))))
                      (dk-rewrite-h! (list 'IN (list f i) 'ZZ) 'ZZ '(CARR ZZ-RING)))
                  (fact 'zz-mod-is-module (list f i))
                  (if (not (lzy-beta!))
                      (if (dk-head-is? (dk-goal) 'IS-MODULE)
                          (ass)
                          (begin (subst (dk-cite! 'zz-mod-scal (list f i))) (rfl)))))))))
      (list hm hs))))
(define (lzy-cs-unfold! l f)               ; (== (CYCLIC-SUM l f) (DIRECT-SUM ...)) in context
  (let ((e (list '== (list 'CYCLIC-SUM l f) (lzy-cs l f))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mac 'CYCLIC-SUM) (qrfl))))
    e))
(define (lzy-absurd-iv! i lo hi . prems)   ; i in [lo, hi] with hi < lo: close the focus goal
  (fact 'interval-elt-in-nn lo hi i)
  (fact 'interval-hi lo hi i)
  (dk-have! (list 'NOT (list '<= lo i)) (lambda () (apply dk-nn! (list '<= i hi) prems)))
  (fact 'interval-lo lo hi i)
  (pbc)
  (ai (list 'NOT (list '<= lo i))))
;; the iso T_f -> CS(n, f): drop with k = 0
(define (lzy-t-to-cs! f)
  (let* ((dm (lzy-dm 'n f)) (pa (lzy-pres-args 'n f)) (fam (lzy-famd 'n dm)) (g (lzy-csfam 'n f)))
    (dk-split! (apply dk-cite! 'lzt-fam-modules pa))
    (lzy-zmod-hyps! 'n f)
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list g 'i_) (list fam (list '+ 0 'i_)))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 n))))
          (lzy-iv! i 1 'n)
          (dk-have! (list '= (list '+ 0 i) i) (lambda () (dk-nn!)))
          (subst (list '= (list '+ 0 i) i))
          (fact 'fun-apply-type-c f '(INTERVAL 1 n) 'ZZ i)
          (dk-rewrite-h! (list 'IN (list f i) 'ZZ) 'ZZ '(CARR ZZ-RING))
          (fact 'zz-mod-is-module (list f i))
          (dk-cite! 'diag-mat-diag 'n f i)
          (lzy-beta!)
          (subst (list '= (list 'ENTRY dm i i) (list f i)))
          (rfl))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 0))
                (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC (list fam 'i_))) (list '= 'x_ (list 'VZERO (list fam 'i_)))))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 0))))
          (lzy-absurd-iv! i 1 0))))
    (fact 'direct-sum-is-module 'ZZ-RING 'n fam)
    (fact 'direct-sum-is-module 'ZZ-RING 'n g)
    (fact 'nn-zero-in)
    (if (not (dk-asm? '(= n (+ 0 n)))) (dk-have! '(= n (+ 0 n)) (lambda () (dk-nn!))))
    (lzy-iso! 'dsum-drop-iso 'ZZ-RING 'n 0 'n fam g)))
(define (lzy-drop0 f)
  (list 'VNB-LAMBDA 'dpx_ (list 'VEC (lzy-ta f)) (list 'VNB-LAMBDA 'dpi_ '(INTERVAL 1 n) '(dpx_ (+ 0 dpi_)))))
(define (lzy-onto-claim md tt ph)
  (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC tt)) (list 'FORSOME 'y_ (list 'AND (list 'IN 'y_ (list 'VEC md)) (list '= (list ph 'y_) 'x_))))))

(define LZY-CORE-HYPS
  (list '(IN n NN) '(IN al (FUN (INTERVAL 1 n) ZZ)) '(IN be (FUN (INTERVAL 1 n) ZZ))
        (lzy-fnn 'al 'n) (lzy-fnn 'be 'n) (lzy-fch 'al 'n) (lzy-fch 'be 'n)
        '(IS-ISO-MODULE (CYCLIC-SUM n al) (CYCLIC-SUM n be) h)))
(define (lzy-ps! p2 m0 ka es dm pad f)    ; prove IS-PRINCIPAL-SEQUENCE(p2, m0, ka, es, DIAG-MAT(m0, pad)) as a claim
  (let ((ps (list 'IS-PRINCIPAL-SEQUENCE p2 m0 ka es dm)))
    (dk-have! ps
      (lambda ()
        (mac 'IS-PRINCIPAL-SEQUENCE)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-asm? g) (ass))
                ((and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'FORALL))      ; the chain
                 (let* ((ld (dk-peel!))
                        (le (find-first (dk-head? '<=) ld))
                        (i (cadr le)) (j (caddr le)))
                   (subst (dk-cite! 'diag-mat-diag m0 pad i))
                   (subst (dk-cite! 'diag-mat-diag m0 pad j))
                   (dk-apply! (dk-cite! 'pad-ones-chain m0 'n 'n f) i j)
                   (ass)))
                ((dk-head-is? g 'FORALL)                                            ; nonnegative
                 (let* ((ld (dk-peel!)) (j (lzy-iv-var ld (list 'INTERVAL 1 m0))))
                   (subst (dk-cite! 'diag-mat-diag m0 pad j))
                   (dk-apply! (dk-cite! 'pad-ones-nonneg m0 'n 'n f) j)
                   (ass)))
                (#t (error "lzy-ps!: unexpected conjunct" (expression->string g)))))))))
    ps))
(sp (make-wff (forall-guarded '(n al be h) LZY-CORE-HYPS '(= al be))))
(dk-peel!)
(fact 'interval-in-set 1 'n)
(use-em '(= n 0)
  (lambda ()
    (dk-fun-ext! 'al 'be '(INTERVAL 1 n) 'ZZ #f #f
      (lambda (v) (lzy-absurd-iv! v 1 'n (list '= 'n 0)))))
  (lambda ()
    (dk-have! '(<= 1 n)
      (lambda ()
        (pbc)
        (fact 'nn-not-le-succ-le 1 'n)
        (dk-have! '(= n 0) (lambda () (dk-nn! '(<= (succ n) 1))))
        (ai '(NOT (= n 0)))))
    (lzy-zsetup! 'n)
    (lzy-pres! 'n 'al)
    (lzy-pres! 'n 'be)
    (dk-have! '(AND (IN n NN) (IN n NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
    (fact 'nn-add-closed 'n 'n)
    (let* ((m0 (dk-name! '(+ n n) 'NN))
           (pa-al (lzy-pres-args 'n 'al)) (pa-be (lzy-pres-args 'n 'be))
           (tal LZY-TAL) (tbe LZY-TBE) (pal LZY-PAL) (pbe LZY-PBE)
           (vtal (list 'VEC tal)) (vtbe (list 'VEC tbe)) (vzn '(VEC (ZZ-POW n)))
           (csal '(CYCLIC-SUM n al)) (csbe '(CYCLIC-SUM n be))
           (dsal (lzy-cs 'n 'al)) (dsbe (lzy-cs 'n 'be))
           (dal (lzy-drop0 'al)) (dbe (lzy-drop0 'be))
           (dbei (list 'INVERSE-BIJ dbe vtbe (list 'VEC dsbe)))
           (hh (list 'COMPOSE dbei (list 'COMPOSE 'h dal)))
           (gg (list 'INVERSE-BIJ hh vtal vtbe))
           (p2 (list 'ZZ-POW m0)) (vp2 (list 'VEC (list 'ZZ-POW m0))) (u2 (list 'ZZ-UNITS m0))
           (pad-al (list 'PAD-ONES m0 'n 'al)) (pad-be (list 'PAD-ONES m0 'n 'be))
           (da (lzy-dm m0 pad-al)) (db (lzy-dm m0 pad-be))
           (ka (lzy-kd m0 pad-al)) (kb (lzy-kd m0 pad-be))
           (wb (lzy-wd m0 pad-be)))
      (lzy-zsetup! m0)
      (dk-have! (list '<= 1 m0) (lambda () (dk-nn! '(<= 1 n) (list '= m0 '(+ n n)))))
      ;; ---- H : T_al -> T_be, an isomorphism, and its inverse G ----
      (lzy-t-to-cs! 'al)
      (lzy-t-to-cs! 'be)
      (lzy-cs-unfold! 'n 'al) (lzy-cs-unfold! 'n 'be)
      (dk-rewrite-h! (dk-rewrite-h! (list 'IS-ISO-MODULE csal csbe 'h) csal dsal) csbe dsbe)
      (lzy-iso! 'iso-module-compose tal dsal dsbe dal 'h)
      (lzy-iso! 'iso-module-inverse tbe dsbe dbe)
      (lzy-iso! 'iso-module-compose tal dsbe tbe (list 'COMPOSE 'h dal) dbei)
      (lzy-iso! 'iso-module-inverse tal tbe hh)
      (lzy-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module tal tbe hh)))
      (lzy-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module tbe tal gg)))
      (lzy-hom-open! tal tbe hh)
      (lzy-hom-open! tbe tal gg)
      ;; ---- the presentations P_al, P_be : Z^n -> T and the lifts l1, l2 ----
      (apply fact 'lzt-ph-hom pa-al)
      (apply fact 'lzt-ph-hom pa-be)
      (lzy-hom-open! LZY-ZN tal pal)
      (lzy-hom-open! LZY-ZN tbe pbe)
      (for-each (lambda (pa ph tt)
                  (dk-have! (lzy-onto-claim LZY-ZN tt ph)
                    (lambda () (let* ((ld (dk-peel!)) (w (lzy-iv-var ld (list 'VEC tt))))
                                 (apply dk-cite! 'lzt-ph-onto (append pa (list w))) (ass)))))
                (list pa-al pa-be) (list pal pbe) (list tal tbe))
      (fact 'hom-module-compose LZY-ZN tal tbe pal hh)
      (fact 'hom-module-compose LZY-ZN tbe tal pbe gg)
      (dk-have! (list 'AND (list 'IN pal (list 'FUN vzn vtal)) (list 'IN hh (list 'FUN vtal vtbe))) (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! (list 'AND (list 'IN pbe (list 'FUN vzn vtbe)) (list 'IN gg (list 'FUN vtbe vtal))) (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! '(= (SCAL (ZZ-POW n)) (SCAL (ZZ-POW n))) (lambda () (rfl)))
      (let* ((l1 (lzy-skolem-split! (dk-cite! 'free-module-lift LZY-ZN 'n '(ZZ-UNITS n) LZY-ZN tbe pbe (list 'COMPOSE hh pal))))
             (lift1 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f l1))) (dk-asms)))
             (l2 (lzy-skolem-split! (dk-cite! 'free-module-lift LZY-ZN 'n '(ZZ-UNITS n) LZY-ZN tal pal (list 'COMPOSE gg pbe))))
             (lift2 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f l2))) (dk-asms)))
             (r1 (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ vzn) (list '= (list pbe (list l1 'x_)) (list hh (list pal 'x_))))))
             (r2 (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ vzn) (list '= (list pal (list l2 'x_)) (list gg (list pbe 'x_))))))
             (r3 (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ vtbe) (list '= (list hh (list gg 'y_)) 'y_))))
             (r3b (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ vtal) (list '= (list gg (list hh 'y_)) 'y_))))
             (th (list 'SCHANUEL-MAP m0 'n l1 l2))
             (thi (list 'SCHANUEL-MAP m0 'n l2 l1))
             (es2 (list 'MAP-SEQ thi m0 u2)))
        (dk-have! r1
          (lambda ()
            (let* ((ld (dk-peel!)) (x (lzy-iv-var ld vzn)))
              (subst (dk-apply! lift1 x))
              (subst (dk-cite! 'compose-apply vzn vtal vtbe hh pal x))
              (fact 'fun-apply-type-c pal vzn vtal x)
              (fact 'fun-apply-type-c hh vtal vtbe (list pal x))
              (rfl))))
        (dk-have! r2
          (lambda ()
            (let* ((ld (dk-peel!)) (x (lzy-iv-var ld vzn)))
              (subst (dk-apply! lift2 x))
              (subst (dk-cite! 'compose-apply vzn vtbe vtal gg pbe x))
              (fact 'fun-apply-type-c pbe vzn vtbe x)
              (fact 'fun-apply-type-c gg vtbe vtal (list pbe x))
              (rfl))))
        (dk-have! r3 (lambda () (let* ((ld (dk-peel!)) (y (lzy-iv-var ld vtbe))) (dk-cite! 'inverse-bij-right vtal vtbe hh y) (ass))))
        (dk-have! r3b (lambda () (let* ((ld (dk-peel!)) (y (lzy-iv-var ld vtal))) (dk-cite! 'inverse-bij-left vtal vtbe hh y) (ass))))
        ;; ---- Schanuel: theta and its inverse on Z^(n+n) ----
        (fact 'schanuel-iso m0 'n l1 l2)
        (fact 'schanuel-iso m0 'n l2 l1)
        (fact 'schanuel-type m0 'n l1 l2)
        (fact 'schanuel-type m0 'n l2 l1)
        (lzy-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module p2 p2 thi)))
        (lzy-hom-open! p2 p2 thi)
        (let ((key1 (dk-cite! 'schanuel-kernel-map m0 'n 'al 'be l1 l2 hh gg))
              (key2 (dk-cite! 'schanuel-kernel-map m0 'n 'be 'al l2 l1 gg hh)))
          ;; ---- the second basis es2 = theta^-1(e) and its principal sequence diag(1, be) ----
          (lzy-free! m0)
          (fact 'pad-ones-type m0 'n 'n 'al)
          (fact 'pad-ones-type m0 'n 'n 'be)
          (lzy-pres! m0 pad-al)
          (lzy-pres! m0 pad-be)
          (lzy-split-all! (dk-cite! 'iso-free-generating p2 p2 thi m0 u2))
          (fact 'hom-matact p2 thi m0 m0 db u2)
          (let ((spk (list 'SPANS p2 m0 (list 'MATACT p2 db es2) ka))
                (ms (list 'MAP-SEQ thi m0 wb)))
            (dk-have! spk
              (lambda ()
                (subst (list '= (list 'MATACT p2 db es2) ms))
                (mac 'SPANS)
                (fact 'map-seq-type thi vp2 vp2 m0 wb)
                (let ((sp-b (dk-meta-iff-r! (dk-meta-iff! 'spans p2 m0 wb kb))))
                  (lzy-split-all! sp-b)
                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (if (dk-head-is? (caddr (caddr g)) 'IN)
                            ;; the entries lie in K_A
                            (let* ((ld (dk-peel!)) (j (lzy-iv-var ld (list 'INTERVAL 1 m0)))
                                   (ej (list 'ENTRY wb j 1)))
                              (fact 'entry-in-carrier m0 1 vp2 wb j 1)
                              (subst (dk-cite! 'map-seq-entry thi vp2 vp2 m0 wb j))
                              (dk-apply! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ (list 'INTERVAL 1 m0)) (list 'IN (list 'ENTRY wb 'j_ 1) kb))) j)
                              (dk-apply! key2 ej)
                              (ass))
                            ;; every x in K_A is a combination of theta^-1 of the generators of K_B
                            (let* ((ld (dk-peel!)) (x (cadr (car ld))))
                              (let ((mem (dk-cite! 'span-membership p2 m0 (lzy-wd m0 pad-al) x)))
                                (dk-split-all! (list (dk-meta-iff-r! mem))))
                              (fact 'fun-apply-type-c th vp2 vp2 x)
                              (dk-apply! key1 x)
                              (let* ((memb (dk-cite! 'span-membership p2 m0 wb (list th x)))
                                     (rhs (dk-meta-iff-r! memb)))
                                (lzy-split-all! rhs)
                                (let* ((c (lzy-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f (list th x)))) (dk-asms)))))
                                  (ew c)
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (dk-asm? (dk-goal))
                                          (ass)
                                          (let* ((e1 (dk-cite! 'hom-lincomb p2 p2 thi m0 c wb))
                                                 (e2 (dk-rewrite-h! e1 (list 'LINCOMB p2 m0 c wb) (list th x)))
                                                 (e3 (dk-cite! 'schanuel-inverse m0 'n l1 l2 x))
                                                 (e4 (dk-rewrite-h! e2 (list thi (list th x)) x)))
                                            (ass)))))))))))))))
            ;; ---- the two principal sequences of K_A, and 3.48 ----
            (lzy-ps! p2 m0 ka u2 da pad-al 'al)
            (lzy-ps! p2 m0 ka es2 db pad-be 'be)
            (dk-cite! 'principal-sequence-unique p2 m0 ka u2 es2 da db)
            ;; ---- al = be, read off the diagonals at n + i ----
            (dk-fun-ext! 'al 'be '(INTERVAL 1 n) 'ZZ #f #f
              (lambda (i)
                (let ((j (list '+ 'n i)))
                  (dk-split! (dk-cite! 'lzu-shift-in m0 'n 'n i))
                  (lzy-iv! i 1 'n)
                  (dk-cite! 'lzu-shift-cancel 'n i)
                  (for-each
                    (lambda (f pad dm)
                      (let* ((e1 (dk-cite! 'diag-mat-diag m0 pad j))
                             (e2 (dk-cite! 'pad-ones-hi m0 'n 'n f j))
                             (e2b (dk-rewrite-h! e2 (list 'NN-MINUS j 'n) i))
                             (e1b (dk-rewrite-h! e1 (list pad j) (list f i))))
                        (subst (list '= (list f i) (list 'ENTRY dm j j)))))
                    (list 'al 'be) (list pad-al pad-be) (list da db))
                  (subst (list '= da db))
                  (fact 'entry-in-carrier m0 m0 'ZZ db j j)
                  (rfl))))))))))
(lzy-done! 'cyclic-sum-iso-core)
(gloss! 'cyclic-sum-iso-core "If Z/(al_1) + ... + Z/(al_n) is isomorphic to Z/(be_1) + ... + Z/(be_n), al and be nonnegative divisibility chains, then al = be (Schanuel's lemma and 3.48).")

