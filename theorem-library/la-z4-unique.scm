;;; ---- padding with ones ----
(define LZY-PH '((IN m NN) (IN k NN) (IN l NN) (= m (+ k l)) (IN f (FUN (INTERVAL 1 l) ZZ))))
(define LZY-PAD '(PAD-ONES m k f))
