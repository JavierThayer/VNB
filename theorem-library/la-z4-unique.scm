(define (lzy-if-open! l a)               ; the conjuncts of IS-INVARIANT-FACTORS(l, a) into context
  (lzy-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-invariant-factors l a))))
(define (lzy-not1 f l) (list 'FORALL 'ifi_ (list 'IMPLIES (list 'IN 'ifi_ (list 'INTERVAL 1 l)) (list 'NOT (list '= (list f 'ifi_) 1)))))
;; the iso CS(N, PAD-ONES(N, k, f)) -> CS(l, f), N = k + l
(define (lzy-pad-drop! nn k l f)
  (let* ((pad (list 'PAD-ONES nn k f))
         (fa (lzy-csfam nn pad)) (ga (lzy-csfam l f)))
    (lzy-zmod-hyps! nn pad)
    (lzy-zmod-hyps! l f)
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l)) (list '= (list ga 'i_) (list fa (list '+ k 'i_)))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzy-iv-var ld (list 'INTERVAL 1 l))) (j (list '+ k i)))
          (dk-split! (dk-cite! 'lzu-shift-in nn k l i))
          (lzy-iv! i 1 l)
          (let* ((e1 (dk-cite! 'pad-ones-hi nn k l f j))
                 (c (dk-cite! 'lzu-shift-cancel k i))
                 (e2 (dk-rewrite-h! e1 (list 'NN-MINUS j k) i)))
            (fact 'fun-apply-type-c f (list 'INTERVAL 1 l) 'ZZ i)
            (dk-rewrite-h! (list 'IN (list f i) 'ZZ) 'ZZ '(CARR ZZ-RING))
            (fact 'zz-mod-is-module (list f i))
            (lzy-beta!)
            (subst (list '= (list pad j) (list f i)))
            (rfl)))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 k))
                (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC (list fa 'i_))) (list '= 'x_ (list 'VZERO (list fa 'i_)))))))
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (lzy-iv-var ld (list 'INTERVAL 1 k)))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'VEC))) ld))))
          (dk-have! (list '<= k nn) (lambda () (dk-nn! (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) nn))) (dk-asms)))))
          (fact 'interval-widen k nn 1 i)
          (lzy-iv! i 1 k)
          (let ((e1 (dk-cite! 'pad-ones-lo nn k l f i)))
            (dk-lam-b-h! (list 'IN x (list 'VEC (list fa i))))
            (dk-rewrite-h! (list 'IN x (list 'VEC (list 'ZZ-MOD (list pad i)))) (list pad i) 1)
            (lzy-beta!)
            (subst (list '= (list pad i) 1))
            (fact 'zz-mod-one-trivial x)
            (ass)))))
    (fact 'direct-sum-is-module 'ZZ-RING nn fa)
    (fact 'direct-sum-is-module 'ZZ-RING l ga)
    (lzy-iso! 'dsum-drop-iso 'ZZ-RING nn k l fa ga)))
(define (lzy-dropk nn k l f)
  (list 'VNB-LAMBDA 'dpx_ (list 'VEC (lzy-cs nn (list 'PAD-ONES nn k f)))
        (list 'VNB-LAMBDA 'dpi_ (list 'INTERVAL 1 l) (list 'dpx_ (list '+ k 'dpi_)))))
;; l < l2 is impossible: at j = l2 the padded a is 1 and the padded b is b(l2 - l) /= 1
(define (lzy-le-by-pad! l l2 n0 a b pa pb)   ; prove (<= l2 l) in the goal, given (= pa pb)
  (pbc)
  (fact 'nn-not-le-succ-le l2 l)
  (fact 'nn-le-refl l2)
  (dk-have! (list '<= 1 l2) (lambda () (dk-nn! (list '<= (list 'succ l) l2))))
  (dk-have! (list '<= l2 n0) (lambda () (dk-nn! (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) n0) (dk-contains? (caddr f) l2))) (dk-asms)))))
  (fact 'interval-mem-intro 1 n0 l2)
  (let* ((e1 (dk-cite! 'pad-ones-lo n0 l2 l a l2))
         (e2 (dk-cite! 'pad-ones-hi n0 l l2 b l2)))
    (dk-split! (dk-cite! 'lzu-shift-back n0 l l2 l2))
    (fact 'fun-apply-type-c pa (list 'INTERVAL 1 n0) 'ZZ l2)
    (fact 'fun-apply-type-c pb (list 'INTERVAL 1 n0) 'ZZ l2)
    (let* ((c (dk-congr! (list '= pa pb) (lambda (t) (list t l2))))
           (c1 (dk-rewrite-h! c (list pa l2) 1))
           (c2 (dk-rewrite-h! c1 (list pb l2) (list b (list 'NN-MINUS l2 l))))
           (nb (dk-apply! (lzy-not1 b l2) (list 'NN-MINUS l2 l))))
      (dk-cite! 'equality-symmetry 1 (list b (list 'NN-MINUS l2 l)))
      (ai nb))))

(sp (make-wff (forall-guarded '(l a l2 b h)
  '((IN l NN) (IN l2 NN) (IS-INVARIANT-FACTORS l a) (IS-INVARIANT-FACTORS l2 b) (IS-ISO-MODULE (CYCLIC-SUM l a) (CYCLIC-SUM l2 b) h))
  '(AND (= l l2) (= a b)))))
(dk-peel!)
(fact 'zz-is-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(lzy-if-open! 'l 'a)
(lzy-if-open! 'l2 'b)
(dk-have! '(AND (IN l2 NN) (IN l NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'nn-add-closed 'l2 'l)
(let* ((n0 (dk-name! '(+ l2 l) 'NN))
       (pa (list 'PAD-ONES n0 'l2 'a)) (pb (list 'PAD-ONES n0 'l 'b))
       (csa (lzy-cs n0 pa)) (csb (lzy-cs n0 pb))
       (da (lzy-dropk n0 'l2 'l 'a)) (db (lzy-dropk n0 'l 'l2 'b))
       (dsa (lzy-cs 'l 'a)) (dsb (lzy-cs 'l2 'b))
       (dbi (list 'INVERSE-BIJ db (list 'VEC csb) (list 'VEC dsb)))
       (hh (list 'COMPOSE dbi (list 'COMPOSE 'h da))))
  (dk-have! (list '= n0 '(+ l l2)) (lambda () (dk-nn! (list '= n0 '(+ l2 l)))))
  (fact 'pad-ones-type n0 'l2 'l 'a)
  (fact 'pad-ones-type n0 'l 'l2 'b)
  (fact 'pad-ones-nonneg n0 'l2 'l 'a)
  (fact 'pad-ones-nonneg n0 'l 'l2 'b)
  (fact 'pad-ones-chain n0 'l2 'l 'a)
  (fact 'pad-ones-chain n0 'l 'l2 'b)
  (lzy-pad-drop! n0 'l2 'l 'a)
  (lzy-pad-drop! n0 'l 'l2 'b)
  (lzy-cs-unfold! 'l 'a) (lzy-cs-unfold! 'l2 'b) (lzy-cs-unfold! n0 pa) (lzy-cs-unfold! n0 pb)
  (dk-rewrite-h! (dk-rewrite-h! '(IS-ISO-MODULE (CYCLIC-SUM l a) (CYCLIC-SUM l2 b) h) '(CYCLIC-SUM l a) dsa) '(CYCLIC-SUM l2 b) dsb)
  (lzy-iso! 'iso-module-compose csa dsa dsb da 'h)
  (lzy-iso! 'iso-module-inverse csb dsb db)
  (lzy-iso! 'iso-module-compose csa dsb csb (list 'COMPOSE 'h da) dbi)
  (let ((iso2 (dk-rewrite-h! (dk-rewrite-h! (list 'IS-ISO-MODULE csa csb hh) csa (list 'CYCLIC-SUM n0 pa)) csb (list 'CYCLIC-SUM n0 pb))))
    (lzy-strict! 'cyclic-sum-iso-core n0 pa pb (cadddr iso2)))
  ;; the lengths agree
  (dk-have! '(<= l2 l) (lambda () (lzy-le-by-pad! 'l 'l2 n0 'a 'b pa pb)))
  (dk-have! '(<= l l2) (lambda () (lzy-le-by-pad! 'l2 'l n0 'b 'a pb pa)))
  (dk-cite! 'nn-le-antisym 'l 'l2)
  ;; the sequences agree
  (dk-rewrite-h! '(IN b (FUN (INTERVAL 1 l2) ZZ)) 'l2 'l)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (dk-fun-ext! 'a 'b '(INTERVAL 1 l) 'ZZ #f #f
            (lambda (i)
              (let ((ja (list '+ 'l2 i)) (jb (list '+ 'l i)))
                (dk-rewrite-h! (list 'IN i '(INTERVAL 1 l)) 'l 'l2)
                (dk-split! (dk-cite! 'lzu-shift-in n0 'l2 'l i))
                (dk-split! (dk-cite! 'lzu-shift-in n0 'l 'l2 i))
                (lzy-iv! i 1 'l)
                (let* ((ca (dk-cite! 'lzu-shift-cancel 'l2 i))
                       (cb (dk-cite! 'lzu-shift-cancel 'l i))
                       (ea (dk-rewrite-h! (dk-cite! 'pad-ones-hi n0 'l2 'l 'a ja) (list 'NN-MINUS ja 'l2) i))
                       (eb (dk-rewrite-h! (dk-cite! 'pad-ones-hi n0 'l 'l2 'b jb) (list 'NN-MINUS jb 'l) i)))
                  (subst (list '= (list 'a i) (list pa ja)))
                  (subst (list '= (list 'b i) (list pb jb)))
                  (dk-have! (list '= jb ja) (lambda () (dk-nn! '(= l l2))))
                  (subst (list '= jb ja))
                  (fact 'fun-apply-type-c pa (list 'INTERVAL 1 n0) 'ZZ ja)
                  (fact 'fun-apply-type-c pb (list 'INTERVAL 1 n0) 'ZZ ja)
                  (dk-congr! (list '= pa pb) (lambda (t) (list t ja)))))))))))
(lzy-done! 'cyclic-sum-iso-unique)
(gloss! 'cyclic-sum-iso-unique "Linear algebra 3.51 (uniqueness): if Z/(a_1) + ... + Z/(a_l) is isomorphic to Z/(b_1) + ... + Z/(b_l2), both sequences invariant factors (nonnegative, no entry 1, each dividing the next), then l = l2 and a = b.")

(sp (make-wff (forall-guarded '(E l a f l2 b g)
  '((IS-MODULE E) (IN l NN) (IN l2 NN) (IS-INVARIANT-FACTORS l a) (IS-INVARIANT-FACTORS l2 b)
    (IS-ISO-MODULE (CYCLIC-SUM l a) E f) (IS-ISO-MODULE (CYCLIC-SUM l2 b) E g))
  '(AND (= l l2) (= a b)))))
(dk-peel!)
(let ((gi '(INVERSE-BIJ g (VEC (CYCLIC-SUM l2 b)) (VEC E))))
  (lzy-iso! 'iso-module-inverse '(CYCLIC-SUM l2 b) 'E 'g)
  (lzy-iso! 'iso-module-compose '(CYCLIC-SUM l a) 'E '(CYCLIC-SUM l2 b) 'f gi)
  (dk-cite! 'cyclic-sum-iso-unique 'l 'a 'l2 'b (list 'COMPOSE gi 'f))
  (ass))
(lzy-done! 'fg-abelian-group-structure-unique)
(gloss! 'fg-abelian-group-structure-unique "Linear algebra 3.50 (uniqueness): the invariant factors a_1 | ... | a_l (a_i >= 0, a_i /= 1) of an abelian group E = Z/(a_1) + ... + Z/(a_l) are determined by E.")

(sp (make-wff (forall-guarded '(E) '((IS-MODULE E) (= (SCAL E) ZZ-RING))
  (forall-guarded '(n u) '((IN n NN) (IN u (MAT n 1 (VEC E))) (GENERATES E n u))
    '(FORSOME l (FORSOME a (AND (IN l NN) (AND (IS-INVARIANT-FACTORS l a) (AND (FORSOME f (IS-ISO-MODULE (CYCLIC-SUM l a) E f))
       (FORALL l2 (FORALL b (IMPLIES (IN l2 NN) (IMPLIES (IS-INVARIANT-FACTORS l2 b)
         (IMPLIES (FORSOME g (IS-ISO-MODULE (CYCLIC-SUM l2 b) E g)) (AND (= l l2) (= a b))))))))))))))))
(dk-peel!)
(let* ((ex (dk-cite! 'fg-abelian-group-structure-exists 'E 'n 'u))
       (l0 (lzy-skolem-split! ex))
       (a0 (lzy-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f l0))) (dk-asms))))
       (f0 (lzy-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a0))) (dk-asms)))))
  (ew l0) (ew a0)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g 'FORSOME) (ew f0) (ass))
          (#t
           (let* ((ld (dk-peel!))
                  (gex (find-first (dk-head? 'FORSOME) ld))
                  (g0 (dk-skolem! gex))
                  (inv (find-first (dk-head? 'IS-INVARIANT-FACTORS) ld)))
             (dk-cite! 'fg-abelian-group-structure-unique 'E l0 a0 f0 (cadr inv) (caddr inv) g0)
             (ass))))))))
(lzy-done! 'fg-abelian-group-cyclic-decomposition)
(gloss! 'fg-abelian-group-cyclic-decomposition "Linear algebra 3.51: a finitely generated abelian group is a direct sum Z/(m_1) + ... + Z/(m_l) of cyclic groups with m_k >= 0, m_k /= 1 and m_k | m_(k+1); the m_k are unique.")
