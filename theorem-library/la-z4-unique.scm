  (if (not (dk-asm? '(== (CARR ZZ-RING) ZZ)))
      (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
  (fact 'diag-mat-type d f)
  (fact 'diag-mat-diagonal d f)
  (let ((dm (lzy-dm d f)) (zp (list 'ZZ-POW d)))
    (if (not (dk-asm? (list 'IN dm (list 'MAT d d (list 'CARR (list 'SCAL zp))))))
        (dk-have! (list 'IN dm (list 'MAT d d (list 'CARR (list 'SCAL zp))))
          (lambda () (subst (list '= (list 'SCAL zp) 'ZZ-RING)) (subst '(= (CARR ZZ-RING) ZZ)) (ass))))
    (dk-have-prop! (list 'IMPLIES (list '= d 0) (list 'OR (list '= d 0) '(= 1 0))))
    (fact 'matact-type zp d d 1 dm (list 'ZZ-UNITS d))
    (fact 'span-is-submodule zp d (lzy-wd d f))
    (fact 'spans-span zp d (lzy-wd d f))))
(define (lzy-pres-args d f) (list (list 'ZZ-POW d) d (list 'ZZ-UNITS d) (lzy-dm d f) (lzy-kd d f)))

(define (lzy-pi t a) (list 'IN t (list 'PRINCIPAL-IDEAL 'ZZ-RING a)))
(define (lzy-rd d xv fv) (list 'FORALL 'j (list 'IMPLIES (list 'IN 'j (list 'INTERVAL 1 d)) (lzy-pi (list xv 'j) (list fv 'j)))))
;; land CE_j: (IFF (= ((PH x) j) ((VZERO T) j)) (IN (x j) (PRINCIPAL-IDEAL ZZ-RING (f j)))) for Z^d, DIAG-MAT(d, f)
(define (lzy-comp-iff! d f x j)
  (let* ((dm (lzy-dm d f)) (tt (lzy-td d dm)) (ph (lzy-phd d dm)) (fam (lzy-famd d dm)) (pa (lzy-pres-args d f))
         (djj (list 'ENTRY dm j j)) (zs (lzy-zsd djj))
         (cx (list 'CLASS zs (list x j))) (c0 (list 'CLASS zs '(ZERO ZZ-RING)))
         (phxj (list (list ph x) j)) (z0j (list (list 'VZERO tt) j))
         (ce (list 'IFF (list '= phxj z0j) (lzy-pi (list x j) (list f j)))))
    (if (not (dk-asm? ce))
        (begin
          (fact 'entry-in-carrier d d 'ZZ dm j j)
          (if (not (dk-asm? (list 'IN djj '(CARR ZZ-RING)))) (dk-rewrite-h! (list 'IN djj 'ZZ) 'ZZ '(CARR ZZ-RING)))
          (lzy-zc! d x j)
          (fact 'ring-zero-in 'ZZ-RING)
          (fact 'zz-mod-class-in djj (list x j))
          (fact 'zz-mod-class-in djj '(ZERO ZZ-RING))
          (dk-have! (list '= phxj cx)
            (lambda ()
              (subst (apply dk-cite! 'lzt-ph-at (append pa (list x j))))
              (subst (dk-cite! 'zz-pow-coord d x j))
              (rfl)))
          (dk-have! (list '= z0j c0)
            (lambda ()
              (subst (dk-cite! 'dsum-vzero-at 'ZZ-RING d fam j))
              (lzy-beta!)
              (subst (dk-cite! 'zz-mod-vzero djj))
              (rfl)))
          (let* ((i3 (dk-cite! 'zz-mod-class-eq-iff djj (list x j) '(ZERO ZZ-RING)))
                 (sx (list '(ADD ZZ-RING) (list x j) '((NEG ZZ-RING) (ZERO ZZ-RING)))))
            (dk-have! (list '= sx (list x j))
              (lambda ()
                (subst (dk-cite! 'ring-neg-zero 'ZZ-RING))
                (subst (dk-cite! 'ring-add-right-id 'ZZ-RING (list x j)))
                (rfl)))
            (let ((i4 (dk-rewrite-h! i3 sx (list x j))))
              (dk-cite! 'diag-mat-diag d f j)
              (dk-have! ce
                (lambda ()
                  (subst (list '= phxj cx))
                  (subst (list '= z0j c0))
                  (subst (list '= (list f j) djj))
                  (ass)))))))
    ce))

(sp (make-wff (forall-guarded '(n f x) '((IN n NN) (IN f (FUN (INTERVAL 1 n) ZZ)) (IN x (VEC (ZZ-POW n))))
  (list 'IFF (list 'IN 'x (lzy-kd 'n 'f)) (lzy-rd 'n 'x 'f)))))
(dk-peel!)
(lzy-zsetup! 'n)
(lzy-pres! 'n 'f)
(let* ((dm (lzy-dm 'n 'f)) (tt (lzy-td 'n dm)) (ph (lzy-phd 'n dm)) (pa (lzy-pres-args 'n 'f)) (fam (lzy-famd 'n dm))
       (phx (list ph 'x)) (z0 (list 'VZERO tt))
       (a (list '= phx z0)) (r (lzy-rd 'n 'x 'f)))
  (dk-split! (apply dk-cite! 'lzt-fam-modules pa))
  (fact 'direct-sum-is-module 'ZZ-RING 'n fam)
  (fact 'module-vzero-in tt)
  (apply fact 'lzt-ph-fun pa)
  (fact 'fun-apply-type-c ph '(VEC (ZZ-POW n)) (list 'VEC tt) 'x)
  (dk-have! (list 'IMPLIES a r)
    (lambda ()
      (di)
      (let* ((ld (dk-peel!)) (j (lzy-iv-var ld '(INTERVAL 1 n))))
        (let ((ce (lzy-comp-iff! 'n 'f 'x j)))
          (fact 'dsum-member-elim 'ZZ-RING 'n fam phx j)
          (fact 'dsum-member-elim 'ZZ-RING 'n fam z0 j)
          (dk-congr! a (lambda (t) (list t j)))
          (dk-meta-iff-r! ce)
          (ass)))))
  (dk-have! (list 'IMPLIES r a)
    (lambda ()
      (di)
      (dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list '= (list phx 'dsj_) (list z0 'dsj_))))
        (lambda ()
          (let* ((ld (dk-peel!)) (j (lzy-iv-var ld '(INTERVAL 1 n))))
            (let ((ce (lzy-comp-iff! 'n 'f 'x j)))
              (dk-apply! r j)
              (dk-meta-iff-l! ce)
              (ass)))))
      (fact 'dsum-ext 'ZZ-RING 'n fam phx z0)
      (ass)))
  (let ((kern (apply dk-cite! 'lzt-ph-kernel (append pa (list 'x)))))
    (dk-only! (list 'IMPLIES a r) (list 'IMPLIES r a) kern)
    (prop)))
(lzy-done! 'zz-pow-diag-span-iff)
(gloss! 'zz-pow-diag-span-iff "In Z^n, x lies in the span of f_1 e_1, ..., f_n e_n exactly when every component x_j lies in the ideal (f_j).")

;;; ---- the span of diag(1, ..., 1, f) in Z^(n+n) is read off the last n coordinates ----
(define LZY-PADF '(PAD-ONES m n f))
(define (lzy-pi1! t)                       ; t in CARR ZZ-RING in context: land (IN t (PRINCIPAL-IDEAL ZZ-RING 1)) as the goal's proof
  (let ((pim (dk-cite! 'principal-ideal-membership 'ZZ-RING 1 t)))
    (dk-have! (caddr pim)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (ew t)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (begin
                            (if (not (dk-asm? '(== (ONE ZZ-RING) 1)))
                                (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl))))
                            (subst '(= 1 (ONE ZZ-RING)))
                            (subst (dk-cite! 'ring-mul-right-id 'ZZ-RING t))
                            (rfl)))))))))))
    (dk-meta-iff-l! pim)))
(sp (make-wff (forall-guarded '(m n f z) '((IN m NN) (IN n NN) (= m (+ n n)) (IN f (FUN (INTERVAL 1 n) ZZ)) (IN z (VEC (ZZ-POW m))))
  (list 'IFF (list 'IN 'z (lzy-kd 'm LZY-PADF)) (list 'IN '(SEQ-SHIFT n z) (lzy-kd 'n 'f))))))
(dk-peel!)
(lzy-zsetup! 'n)
(lzy-zsetup! 'm)
(fact 'zz-one-in)
(dk-rewrite-h! '(IN 1 ZZ) 'ZZ '(CARR ZZ-RING))
(fact 'pad-ones-type 'm 'n 'n 'f)
(fact 'seq-shift-vec 'm 'n 'z)
(let* ((i1 (dk-cite! 'zz-pow-diag-span-iff 'm LZY-PADF 'z))
       (i2 (dk-cite! 'zz-pow-diag-span-iff 'n 'f '(SEQ-SHIFT n z)))
       (rm (caddr i1)) (rn (caddr i2)))
  (dk-have! (list 'IMPLIES rm rn)
    (lambda ()
      (di)
      (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 n))) (j (list '+ 'n i)))
        (dk-split! (dk-cite! 'lzu-shift-in 'm 'n 'n i))
        (lzy-iv! i 1 'n)
        (subst (dk-cite! 'seq-shift-at 'm 'n 'z i))
        (let* ((e (dk-cite! 'pad-ones-hi 'm 'n 'n 'f j))
               (c (dk-cite! 'lzu-shift-cancel 'n i))
               (h1 (dk-apply! rm j))
               (h2 (dk-rewrite-h! h1 (list LZY-PADF j) (list 'f (list 'NN-MINUS j 'n))))
               (h3 (dk-rewrite-h! h2 (list 'NN-MINUS j 'n) i)))
          #t)
        (ass))))
  (dk-have! (list 'IMPLIES rn rm)
    (lambda ()
      (di)
      (let* ((ld (dk-peel!)) (j (lzy-iv-var ld '(INTERVAL 1 m))))
        (lzy-zc! 'm 'z j)
        (use-em (list '<= j 'n)
          (lambda ()
            (subst (dk-cite! 'pad-ones-lo 'm 'n 'n 'f j))
            (lzy-pi1! (list 'z j))
            (ass))
          (lambda ()
            (dk-split! (dk-cite! 'lzu-shift-back 'm 'n 'n j))
