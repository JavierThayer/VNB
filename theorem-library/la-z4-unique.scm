;;; la-z4-unique.scm -- linear algebra 3.50, uniqueness: the invariant factors of a finitely
;;; generated abelian group are determined by it (LA-Z4, 2026-10-24).  Vocabulary:
;;; structure-library/la-z4-vocab.  Prefix lzy-.
;;;
;;; PLAN (the notes say "uniqueness follows from the uniqueness statement of 3.36"; two
;;; DIFFERENT presentations have first to be brought into one free module, which is
;;; Schanuel's lemma).  Let h : Z/(alpha_1) + ... + Z/(alpha_N) -> Z/(beta_1) + ... + Z/(beta_N)
;;; be an isomorphism, alpha, beta nonnegative divisibility chains.  With the presentations
;;; P_alpha, P_beta : Z^N -> (the two sums) of 3.49, lift (free module) to homomorphisms
;;; la, lb of Z^N with P_beta la = h P_alpha and P_alpha lb = h^-1 P_beta.  On Z^(2N), z = (t, b),
;;; theta(t, b) = (b - lb(t), t + la(b - lb(t))) is an automorphism (inverse: la and lb exchanged)
;;; and z lies in K_A = span of diag(1, .., 1, alpha) e iff theta(z) lies in K_B.  So K_A has the
;;; two principal sequences (e, diag(1, alpha)) and (theta^-1 e, diag(1, beta)); 3.48
;;; (principal-sequence-unique) gives alpha = beta.  The statement for sequences of different
;;; lengths with no entry 1 follows by padding both with ones (dsum-drop-iso).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z4-schanuel, la-z4-exist (lzx-one-divides), la-z4-dsum (lzu-shift-*),
;;; la-z2-principal (principal-sequence-unique), la-z2-action (row-matact-lincomb) and
;;; la-z3-struct (lzt-ph-*).

(define (lzy-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-unique: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzy-diag! name)               ; print the open leaves when the proof did not close
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-unique: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves)))))
(define (lzy-sp-qed! stmt steps name)   ; a proof opened and closed inside a helper (dk-sp-qed!)
  (dk-sp-qed! (make-wff stmt) (lambda () (steps) (lzy-diag! name)) name)
  (topic! name 'algebra))
(define (lzy-split-all! f)
  (if (dk-head-is? f 'AND) (for-each lzy-split-all! (dk-split! f))))
(define (lzy-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (lzy-iv-var ld cls)
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "lzy-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (lzy-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (lzy-skolem-split! ex)
  (let ((w (dk-skolem! ex)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    w))
(define (lzy-hom-open! a b f)
  (let ((z (list '= (list f (list 'VZERO a)) (list 'VZERO b))))
    (if (not (dk-asm? z))
        (lzy-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def a b f))))))
(define (lzy-hcl-add a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a)) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'VADD a) 'x1_ 'x2_)) (list (list 'VADD b) (list f 'x1_) (list f 'x2_))))))))
(define (lzy-hcl-neg a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a))
    (list '= (list f (list (list 'VNEG a) 'x1_)) (list (list 'VNEG b) (list f 'x1_))))))
(define (lzy-iso! thm . args)          ; cite an iso lemma; error unless it detached to IS-ISO-MODULE
  (let ((r (apply dk-cite! thm args)))
    (if (not (dk-head-is? r 'IS-ISO-MODULE))
        (begin
          (display ";; LZY-ISO MISSING ANTECEDENT: ") (display (expression->string (if (dk-head-is? r 'IMPLIES) (cadr r) r))) (newline)
          (error "lzy-iso!: did not detach" thm)))
    r))
(define (lzy-strict! thm . args)       ; cite; error, printing the first antecedent not in context, unless it detached fully
  (let ((r (apply dk-cite! thm args)))
    (if (dk-head-is? r 'IMPLIES)
        (begin
          (display ";; LZY-STRICT MISSING: ") (display (expression->string (cadr r))) (newline)
          (error "lzy-strict!: did not detach" thm)))
    r))
(define (lzy-hcl-zero a b f) (list '= (list f (list 'VZERO a)) (list 'VZERO b)))
(define (lzy-hcl-act a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'CARR (list 'SCAL a))) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'ACT a) 'x1_ 'x2_)) (list (list 'ACT b) 'x1_ (list f 'x2_))))))))

;;; =====================================================================
;;; (1) Z^d computes componentwise
;;; =====================================================================
(define (lzy-zfam d) (list 'VNB-LAMBDA 'zpi_ (list 'INTERVAL 1 d) '(RING-AS-MODULE ZZ-RING)))
(define (lzy-dsz d) (list 'DIRECT-SUM 'ZZ-RING d (lzy-zfam d)))
(define (lzy-zp d) (list 'ZZ-POW d))
(define (lzy-zv d) (list 'VEC (list 'ZZ-POW d)))
(define LZY-RAM '(RING-AS-MODULE ZZ-RING))
(define (lzy-zhm d) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 d)) (list 'IS-MODULE (list (lzy-zfam d) 'i_)))))
(define (lzy-zsetup! d)                 ; d in NN in context
  (fact 'zz-is-ring)
  (fact 'zz-is-commutative-ring)
  (fact 'nn-one-in)
  (fact 'one-in-interval-1)
  (fact 'ring-as-module-is-module 'ZZ-RING)
  (for-each (lambda (nm) (fact nm 'ZZ-RING)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-vzero ram-ro-vneg ram-ro-act))
  (if (not (dk-asm? '(== (CARR ZZ-RING) ZZ)))
      (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
  (if (not (dk-asm? (lzy-zhm d))) (dk-split! (dk-cite! 'zz-pow-family d)))
  (fact 'direct-sum-is-module 'ZZ-RING d (lzy-zfam d))
  (for-each (lambda (nm) (fact nm 'ZZ-RING d (lzy-zfam d))) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act))
  (fact 'zz-pow-unfold d)
  (fact 'zz-pow-is-module d)
  (fact 'zz-pow-scal d))
(define (lzy-to-dsv! d x)               ; (IN x (DSUM-VEC d ZFAM)) from (IN x (VEC (ZZ-POW d)))
  (let ((want (list 'IN x (list 'DSUM-VEC d (lzy-zfam d)))))
    (if (not (dk-asm? want))
        (let ((h (dk-rewrite-h! (list 'IN x (lzy-zv d)) (lzy-zp d) (lzy-dsz d))))
          (dk-rewrite-h! h (list 'VEC (lzy-dsz d)) (list 'DSUM-VEC d (lzy-zfam d)))))))
(define (lzy-zc! d x i)                 ; (IN (x i) (CARR ZZ-RING)) for x in VEC (ZZ-POW d)
  (let ((want (list 'IN (list x i) '(CARR ZZ-RING))))
    (if (not (dk-asm? want))
        (begin
          (fact 'zz-pow-vec-out d x i)
          (dk-rewrite-h! (list 'IN (list x i) 'ZZ) 'ZZ '(CARR ZZ-RING))))))
(define (lzy-fam! d i)
  (let ((e (list '== (list (lzy-zfam d) i) LZY-RAM)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (qrfl)))))
    (subst (list '= (list (lzy-zfam d) i) LZY-RAM))))
;;; ---- the componentwise decision procedure for Z^d identities ------------------------
;; type a vector term of Z^d built from VADD, VNEG, ACT (scalar typed in CARR ZZ-RING), VZERO
(define (lzy-zvt! d t)
  (let* ((zp (lzy-zp d)) (want (list 'IN t (lzy-zv d))))
    (cond ((dk-asm? want) #t)
          ((equal? t (list 'VZERO zp)) (fact 'module-vzero-in zp))
          ((and (pair? t) (equal? (car t) (list 'VADD zp)))
           (lzy-zvt! d (cadr t)) (lzy-zvt! d (caddr t)) (fact 'module-vadd-type zp (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) (list 'VNEG zp)))
           (lzy-zvt! d (cadr t)) (fact 'module-vneg-type zp (cadr t)))
          ((and (pair? t) (equal? (car t) (list 'ACT zp)))
           (lzy-zvt! d (caddr t))
           (if (not (dk-asm? (list 'IN (cadr t) (list 'CARR (list 'SCAL zp)))))
               (dk-have! (list 'IN (cadr t) (list 'CARR (list 'SCAL zp)))
                 (lambda () (subst (list '= (list 'SCAL zp) 'ZZ-RING)) (ass))))
           (fact 'module-act-type zp (cadr t) (caddr t)))
          (#t (error "lzy-zvt!: cannot type" (expression->string t))))))
;; the innermost Z^d operation applied at the index v
(define (lzy-redex-at d e v)
  (let ((zp (lzy-zp d)))
    (if (not (pair? e))
        #f
        (or (let loop ((xs e)) (cond ((not (pair? xs)) #f) ((lzy-redex-at d (car xs) v)) (#t (loop (cdr xs)))))
            (and (= (length e) 2) (equal? (cadr e) v)
                 (let ((h (car e)))
                   (cond ((equal? h (list 'VZERO zp)) e)
                         ((and (pair? h) (member (car h) (list (list 'VADD zp) (list 'VNEG zp) (list 'ACT zp)))) e)
                         (#t #f))))))))
(define (lzy-norm-at! d v)
  (let ((zp (lzy-zp d)))
    (let loop ((fuel 60))
      (let ((rx (lzy-redex-at d (dk-goal) v)))
        (if (and rx (> fuel 0))
            (let* ((h (car rx))
                   (eqn (cond ((equal? h (list 'VZERO zp)) (dk-cite! 'zz-pow-vzero-at d v))
                              ((equal? (car h) (list 'VADD zp))
                               (lzy-zvt! d (cadr h)) (lzy-zvt! d (caddr h))
                               (dk-cite! 'zz-pow-vadd-at d (cadr h) (caddr h) v))
                              ((equal? (car h) (list 'VNEG zp))
                               (lzy-zvt! d (cadr h))
                               (dk-cite! 'zz-pow-vneg-at d (cadr h) v))
                              (#t
                               (lzy-zvt! d (caddr h))
                               (dk-cite! 'zz-pow-act-at d (cadr h) (caddr h) v)))))
              (subst eqn)
              (loop (- fuel 1))))))))
;; the atoms (x v) of the normalised goal: type them in CARR ZZ-RING
(define (lzy-atoms-at e v acc)
  (cond ((not (pair? e)) acc)
        ((and (= (length e) 2) (equal? (cadr e) v) (symbol? (car e))) (if (member e acc) acc (cons e acc)))
        ((and (= (length e) 2) (equal? (cadr e) v) (pair? (car e)) (not (memq (caar e) '(ADD NEG MUL ZERO ONE)))) (if (member e acc) acc (cons e acc)))
        (#t (fold-left (lambda (a s) (lzy-atoms-at s v a)) acc e))))
;; prove (= X Y) in Z^d componentwise: ext, push evaluation inside, crs
(define (lzy-zeq! d x y)
  (lzy-zvt! d x) (lzy-zvt! d y)
  (let ((pt (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 d)) (list '= (list x 'i_) (list y 'i_))))))
    (dk-have! pt
      (lambda ()
        (let* ((ld (dk-peel!)) (v (lzy-iv-var ld (list 'INTERVAL 1 d))))
          (lzy-norm-at! d v)
          (for-each (lambda (a) (lzy-zc! d (car a) v)) (lzy-atoms-at (dk-goal) v '()))
          (crs))))
    (dk-have! (list '= x y) (lambda () (fact 'zz-pow-ext d x y) (ass)))))

(define LZY-ZN '(ZZ-POW n))
(define LZY-VN '(VEC (ZZ-POW n)))
(define (lzy-vadd a b) (list '(VADD (ZZ-POW n)) a b))
(define (lzy-vneg a) (list '(VNEG (ZZ-POW n)) a))

;;; =====================================================================
;;; (4) lifting a homomorphism out of a free module through a surjection
;;; =====================================================================
(define LZY-LFS '(SEP lfy_ (VEC Y) (= (psi lfy_) (phi (ENTRY es lfa_ lfb_)))))
(define LZY-LFG (list 'VNB-LAMBDA '(LIST lfa_ lfb_) '(CARTESIAN (INTERVAL 1 n) (INTERVAL 1 1)) (list 'CHOICE LZY-LFS)))
(define LZY-LFW (list 'MATOF 'n 1 LZY-LFG))
(define LZY-LROWS '(MAT 1 n (CARR (SCAL md))))
(define LZY-LKAP (list 'INVERSE-BIJ '(VNB-LAMBDA lcc_ (MAT 1 n (CARR (SCAL md))) (LINCOMB md n lcc_ es)) LZY-LROWS '(VEC md)))
(define LZY-LFT (list 'VNB-LAMBDA 'lex_ '(VEC md) (list 'LINCOMB 'Y 'n (list LZY-LKAP 'lex_) LZY-LFW)))
(define LZY-ONTO '(FORALL x_ (IMPLIES (IN x_ (VEC X)) (FORSOME y_ (AND (IN y_ (VEC Y)) (= (psi y_) x_))))))
(sp (make-wff (forall-guarded '(md n es Y X psi phi)
  (list '(IS-MODULE md) '(IN n NN) '(IN es (MAT n 1 (VEC md))) '(GENERATES md n es) '(REL-FREE md n es)
        '(IS-HOM-MODULE Y X psi) LZY-ONTO '(IS-HOM-MODULE md X phi) '(= (SCAL Y) (SCAL md)))
  '(FORSOME lam (AND (IS-HOM-MODULE md Y lam) (FORALL x_ (IMPLIES (IN x_ (VEC md)) (= (psi (lam x_)) (phi x_)))))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'module-scalar-ring 'md)
(lzy-hom-open! 'Y 'X 'psi)
(lzy-hom-open! 'md 'X 'phi)
(fact 'lzq-vec-set 'Y)
;; the chosen preimages
(let* ((ptw (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1))
              (list 'AND (list 'IN (list LZY-LFG 'i 'j) '(VEC Y)) (list '= (list 'psi (list LZY-LFG 'i 'j)) '(phi (ENTRY es i j))))))))))
  (dk-have! ptw
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (lzy-iv-var ld '(INTERVAL 1 n))) (j (lzy-iv-var ld '(INTERVAL 1 1)))
             (e (list 'ENTRY 'es i j))
             (sij (subst-free 'lfb_ j (subst-free 'lfa_ i LZY-LFS)))
             (ex (list 'FORSOME 'lfx_ (list 'IN 'lfx_ sij))))
        (lzy-beta!)
        (fact 'entry-in-carrier 'n 1 '(VEC md) 'es i j)
        (fact 'fun-apply-type-c 'phi '(VEC md) '(VEC X) e)
        (let ((y (lzy-skolem-split! (dk-apply! LZY-ONTO (list 'phi e)))))
          (dk-have! (list 'IN y sij) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
          (dk-have! ex (lambda () (ew y) (ass)))
          (fact 'choice-axiom sij)
          (let ((m (dk-ctx-form (list 'IN (list 'CHOICE sij) sij))))
            (dk-have! (list 'IN (list 'CHOICE sij) '(VEC Y)) (lambda () (dk-landed (lambda () (sep-me m))) (dk-split-all!) (ass)))
            (dk-have! (list '= (list 'psi (list 'CHOICE sij)) (list 'phi e)) (lambda () (dk-landed (lambda () (sep-me m))) (dk-split-all!) (ass))))
          (dk-conj-close! (lambda () (ass)))))))
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1)) (list 'IN (list LZY-LFG 'i 'j) '(VEC Y))))))
    (lambda () (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 n))) (j (lzy-iv-var ld '(INTERVAL 1 1))))
                 (dk-split! (dk-apply! ptw i j)) (ass))))
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1)) (list 'IN (list LZY-LFG 'i 'j) 'SET)))))
    (lambda () (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 n))) (j (lzy-iv-var ld '(INTERVAL 1 1))))
                 (dk-split! (dk-apply! ptw i j))
                 (fact 'membership-implies-sethood (list LZY-LFG i j) '(VEC Y)) (ass))))
  (fact 'matof-in-mat 'n 1 '(VEC Y) LZY-LFG)
  (fact 'free-lift-hom 'md 'n 'es 'Y LZY-LFW)
  (fact 'free-lift-type 'md 'n 'es 'Y LZY-LFW)
  (ew LZY-LFT)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((ld (dk-peel!)) (x (lzy-iv-var ld '(VEC md)))
                 (kx (list LZY-LKAP x))
                 (c (dk-cite! 'coord-lincomb 'md 'n 'es x)))
            (if (dk-head-is? c 'AND) (dk-split! c))
            (dk-have! (list 'IN kx '(MAT 1 n (CARR (SCAL Y)))) (lambda () (subst '(= (SCAL Y) (SCAL md))) (ass)))
            (dk-have! (list 'IN kx '(MAT 1 n (CARR (SCAL X)))) (lambda () (subst '(= (SCAL X) (SCAL md))) (ass)))
            (let* ((e1 (dk-cite! 'free-lift-lincomb 'md 'n 'es 'Y LZY-LFW kx))
                   (e1x (dk-rewrite-h! e1 (list 'LINCOMB 'md 'n kx 'es) x)))
              (subst e1x))
            (subst (dk-cite! 'hom-lincomb 'Y 'X 'psi 'n kx LZY-LFW))
            (let* ((e2 (dk-cite! 'hom-lincomb 'md 'X 'phi 'n kx 'es))
                   (e2x (dk-rewrite-h! e2 (list 'LINCOMB 'md 'n kx 'es) x)))
              (subst e2x))
            ;; MAP-SEQ(psi, W) = MAP-SEQ(phi, es), entrywise
            (let ((ma (list 'MAP-SEQ 'psi 'n LZY-LFW)) (mb '(MAP-SEQ phi n es)))
              (fact 'map-seq-type 'psi '(VEC Y) '(VEC X) 'n LZY-LFW)
              (fact 'map-seq-type 'phi '(VEC md) '(VEC X) 'n 'es)
              (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1))
                          (list '= (list 'ENTRY ma 'i 'j) (list 'ENTRY mb 'i 'j))))))
                (lambda ()
                  (let* ((ld2 (dk-peel!)) (i (lzy-iv-var ld2 '(INTERVAL 1 n))) (j (lzy-iv-var ld2 '(INTERVAL 1 1))))
                    (lzy-iv! j 1 1)
                    (dk-cite! 'nn-le-antisym j 1)
                    (subst (list '= j 1))
                    (dk-split! (dk-apply! ptw i 1))
                    (subst (dk-cite! 'map-seq-entry 'psi '(VEC Y) '(VEC X) 'n LZY-LFW i))
                    (subst (dk-cite! 'map-seq-entry 'phi '(VEC md) '(VEC X) 'n 'es i))
                    (subst (dk-cite! 'entry-of-matof 'n 1 LZY-LFG i 1))
                    (subst (list '= (list 'psi (list LZY-LFG i 1)) (list 'phi (list 'ENTRY 'es i 1))))
                    (fact 'entry-in-carrier 'n 1 '(VEC md) 'es i 1)
                    (fact 'fun-apply-type-c 'phi '(VEC md) '(VEC X) (list 'ENTRY 'es i 1))
                    (rfl))))
              (fact 'matrix-entry-extensionality 'n 1 '(VEC X) ma mb)
              (subst (list '= ma mb))
              (fact 'lincomb-type 'X 'n kx mb)
              (rfl)))))))
(lzy-done! 'free-module-lift)
(gloss! 'free-module-lift "A homomorphism phi out of a free module lifts through any surjective homomorphism psi: there is a homomorphism lam with psi(lam(x)) = phi(x).")

;;; =====================================================================
;;; (5) an endomorphism commutes with a matrix acting on a sequence
;;; =====================================================================
(define LZY-ROW '(MATMUL (SCAL A) (UNITROW (SCAL A) m i) D))
(sp (make-wff (forall-guarded '(A g m n D u)
  '((IS-HOM-MODULE A A g) (IN m NN) (IN n NN) (<= 1 n) (IN D (MAT m n (CARR (SCAL A)))) (IN u (MAT n 1 (VEC A))))
  '(= (MATACT A D (MAP-SEQ g n u)) (MAP-SEQ g m (MATACT A D u))))))
(dk-peel!)
(lzy-hom-open! 'A 'A 'g)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'module-scalar-ring 'A)
(dk-have! '(NOT (= n 0)) (lambda () (dk-nn! '(<= 1 n))))
(dk-have! '(IMPLIES (= n 0) (OR (= m 0) (= 1 0)))
  (dk-lane (lambda () (dk-only! '(NOT (= n 0))) (dk-lane-if! prop))))
(let* ((ms '(MAP-SEQ g n u)) (mau '(MATACT A D u)) (mam (list 'MATACT 'A 'D ms)))
  (fact 'map-seq-type 'g '(VEC A) '(VEC A) 'n 'u)
  (fact 'matact-type 'A 'm 'n 1 'D ms)
  (fact 'matact-type 'A 'm 'n 1 'D 'u)
  (fact 'map-seq-type 'g '(VEC A) '(VEC A) 'm mau)
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 m)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1))
              (list '= (list 'ENTRY mam 'i 'j) (list 'ENTRY (list 'MAP-SEQ 'g 'm mau) 'i 'j))))))
    (lambda ()
      (let* ((ld (dk-peel!)) (i (lzy-iv-var ld '(INTERVAL 1 m))) (j (lzy-iv-var ld '(INTERVAL 1 1)))
             (row (subst-free 'i i LZY-ROW)))
        (lzy-iv! j 1 1)
        (dk-cite! 'nn-le-antisym j 1)
        (subst (list '= j 1))
        (fact 'unitrow-type '(SCAL A) 'm i)
        (lzy-iv! i 1 'm)
        (dk-have! '(NOT (= m 0)) (lambda () (dk-nn! (list '<= 1 i) (list '<= i 'm))))
        (dk-have! '(IMPLIES (= m 0) (OR (= 1 0) (= n 0)))
          (dk-lane (lambda () (dk-only! '(NOT (= m 0))) (dk-lane-if! prop))))
        (fact 'matmul-type '(SCAL A) 1 'm 'n (list 'UNITROW '(SCAL A) 'm i) 'D)
        (let* ((e1 (dk-cite! 'row-matact-lincomb 'A 'm 'n 'D ms i))
               (e2 (dk-cite! 'hom-lincomb 'A 'A 'g 'n row 'u))
               (e3 (dk-cite! 'row-matact-lincomb 'A 'm 'n 'D 'u i))
               (e4 (dk-cite! 'map-seq-entry 'g '(VEC A) '(VEC A) 'm mau i)))
          (subst e4)
          (subst (list '= (list 'ENTRY mau i 1) (list 'LINCOMB 'A 'n row 'u)))
          (subst e2)
          (subst e1)
          (fact 'entry-in-carrier 'm 1 '(VEC A) mam i 1)
          (rfl)))))
  (fact 'matrix-entry-extensionality 'm 1 '(VEC A) mam (list 'MAP-SEQ 'g 'm mau))
  (ass))
