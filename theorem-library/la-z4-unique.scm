;;; the coordinates of x in the unit basis of Z^n are its components
(define (lzy-kapu d) (list 'INVERSE-BIJ (list 'VNB-LAMBDA 'lcc_ (list 'MAT 1 d (list 'CARR (list 'SCAL (list 'ZZ-POW d)))) (list 'LINCOMB (list 'ZZ-POW d) d 'lcc_ (list 'ZZ-UNITS d)))
