;;; ring-pow.scm -- wave of 2026-11-09/10 (agent CCR-1109-E), wired 2026-11-10 from scratchpad/ccr1109e/ring-pow.scm.
;;; Library: linear-algebra.

;;; ring-pow.scm -- the free module R^n over a ring R and its unit basis (CCR-1109-E, 2026-11-09).
;;; Vocabulary: structure-library/ring-pow-vocab (RING-POW, RING-UNITS, RING-ROW; this agent) and
;;; la-z3-vocab (DIRECT-SUM, RING-AS-MODULE).  Prefix rpw-.
;;;
;;; The generic port of section (C) of theorem-library/la-z4-free.scm (LA-Z4, the ZZ-specific Z^n): every
;;; statement is the ZZ statement with ZZ-RING replaced by a ring R (IS-RING R) and ZZ by CARR R.
;;;   ring-pow-unfold, ring-pow-family, ring-pow-is-module, ring-pow-scal, ring-pow-vec-in, ring-pow-vec-out,
;;;   ring-pow-ext, ring-pow-vzero-at, ring-unit-vec, ring-units-type, ring-units-entry, ring-unit-at,
;;;   ring-pow-lincomb-at, ring-row-type, ring-row-entry, ring-pow-row-lincomb,
;;;   ring-units-generate, ring-units-rel-free.
;;; ZZ-POW(n) is RING-POW(ZZ-RING, n) by the two unfolds; K^n for a normed field K is
;;; RING-POW(NORMED-FIELD-AS-COMMUTATIVE-RING K, n).
;;;
;;; Destination theorem-library/ring-pow.scm.  Library: linear-algebra (as la-z4-free).  LOAD WINDOW: after
;;; structure-library/ring-pow-vocab and theorem-library/la-z4-free (lincomb-single-support, dsum-eval-hom,
;;; dsum-lincomb-at, hom-lincomb), which already loads after la-z3-quotient / la-z3-dsum (ring-as-module-is-module,
;;; ram-ro-*, direct-sum-is-module, dsum-*).  No support, warrant or stamp.

(define (rpw-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ring-pow: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (rpw-iv-var ld cls)              ; the variable typed in CLS among the landed formulas
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "rpw-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (rpw-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))   ; #t when beta grounded the leaf
(define (rpw-hom-open! a b f)           ; the conjuncts of IS-HOM-MODULE(a, b, f) into context
  (if (not (dk-asm? (list '= (list f (list 'VZERO a)) (list 'VZERO b))))
      (let loop ((fs (list (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def a b f)))))
        (for-each (lambda (g) (if (dk-head-is? g 'AND) (loop (dk-split! g)))) fs))))

(define RPW-FAM '(VNB-LAMBDA rqpi_ (INTERVAL 1 n) (RING-AS-MODULE R)))
(define RPW-DS (list 'DIRECT-SUM 'R 'n RPW-FAM))
(define RPW-RP '(RING-POW R n))
(define RPW-RAM '(RING-AS-MODULE R))
(define RPW-UN '(RING-UNITS R n))
(define (rpw-unit k) (list 'VNB-LAMBDA 'rqut_ '(INTERVAL 1 n) (list 'ENTRY (list 'UNITROW 'R 'n k) 1 'rqut_)))
(define RPW-HM (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IS-MODULE (list RPW-FAM 'i_)))))
(define RPW-HS (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list 'SCAL (list RPW-FAM 'i_)) 'R))))
(define (rpw-stmt vars guards body)
  (forall-guarded (append '(R n) vars) (append '((IS-RING R) (IN n NN)) guards) body))

(sp (make-wff (list 'FORALL 'R (list 'FORALL 'n (list '== RPW-RP RPW-DS)))))
(di)
(mac 'RING-POW)
(qrfl)
(rpw-done! 'ring-pow-unfold)

(sp (make-wff (rpw-stmt '() '() (list 'AND RPW-HM RPW-HS))))
(dk-peel!)
(fact 'ring-as-module-is-module 'R)
(fact 'ram-ro-scal 'R)
(dk-conj-close!
  (lambda ()
    (let* ((ld (dk-peel!)))
      (if (not (rpw-beta!))
          (if (dk-head-is? (dk-goal) 'IS-MODULE)
              (ass)
              (begin (subst (list '= (list 'SCAL RPW-RAM) 'R)) (rfl)))))))
(rpw-done! 'ring-pow-family)

(define (rpw-setup!)                   ; IS-RING R, n in NN in context
  (fact 'nn-one-in)
  (fact 'one-in-interval-1)
  (fact 'ring-as-module-is-module 'R)
  (for-each (lambda (nm) (fact nm 'R)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-vzero ram-ro-vneg ram-ro-act))
  (if (not (dk-asm? RPW-HM)) (dk-split! (dk-cite! 'ring-pow-family 'R 'n)))
  (fact 'direct-sum-is-module 'R 'n RPW-FAM)
  (for-each (lambda (nm) (fact nm 'R 'n RPW-FAM)) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act dsum-vec-set2))
  (fact 'ring-pow-unfold 'R 'n))
(define (rpw-rp->ds!) (if (dk--occurs? RPW-RP (dk-goal)) (subst (list '= RPW-RP RPW-DS))))
(define (rpw-fam-ram! i)                ; (== (FAM i) RAM) for i in [1,n] in context
  (let ((e (list '== (list RPW-FAM i) RPW-RAM)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (qrfl)))))
    e))

(sp (make-wff (rpw-stmt '() '() '(IS-MODULE (RING-POW R n)))))
(dk-peel!)
(rpw-setup!)
(rpw-rp->ds!)
(ass)
(rpw-done! 'ring-pow-is-module)
(gloss! 'ring-pow-is-module "R^n, the direct sum of n copies of the ring R, is a module over R.")

(sp (make-wff (rpw-stmt '() '() '(= (SCAL (RING-POW R n)) R))))
(dk-peel!)
(rpw-setup!)
(rpw-rp->ds!)
(subst (list '= (list 'SCAL RPW-DS) 'R))
(rfl)
(rpw-done! 'ring-pow-scal)

(sp (make-wff (rpw-stmt '(x) '((IN x (FUN (INTERVAL 1 n) (CARR R)))) '(IN x (VEC (RING-POW R n))))))
(dk-peel!)
(rpw-setup!)
(rpw-rp->ds!)
(dk-have! '(IN x (FUN (INTERVAL 1 n)))
  (lambda ()
    (mac-h 'fun-codomain-iff (dk-ctx-form '(IN x (FUN (INTERVAL 1 n) (CARR R)))))
    (dk-split-all!)
    (ass)))
(dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list 'IN '(x dsj_) (list 'VEC (list RPW-FAM 'dsj_)))))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (rpw-iv-var ld '(INTERVAL 1 n))))
      (rpw-fam-ram! j)
      (subst (list '= (list RPW-FAM j) RPW-RAM))
      (subst (list '= (list 'VEC RPW-RAM) '(CARR R)))
      (fact 'fun-apply-type-c 'x '(INTERVAL 1 n) '(CARR R) j)
      (ass))))
(fact 'dsum-member-intro 'R 'n RPW-FAM 'x)
(ass)
(rpw-done! 'ring-pow-vec-in)

(sp (make-wff (rpw-stmt '(x i) '((IN x (VEC (RING-POW R n))) (IN i (INTERVAL 1 n))) '(IN (x i) (CARR R)))))
(dk-peel!)
(rpw-setup!)
(let* ((h1 (dk-rewrite-h! '(IN x (VEC (RING-POW R n))) RPW-RP RPW-DS))
       (h2 (dk-cite! 'dsum-member-elim 'R 'n RPW-FAM 'x 'i)))
  (rpw-fam-ram! 'i)
  (let* ((h3 (dk-rewrite-h! h2 (list RPW-FAM 'i) RPW-RAM))
         (h4 (dk-rewrite-h! h3 (list 'VEC RPW-RAM) '(CARR R))))
    (ass)))
(rpw-done! 'ring-pow-vec-out)

(sp (make-wff (rpw-stmt '(x y) '((IN x (VEC (RING-POW R n))) (IN y (VEC (RING-POW R n)))
    (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= (x i_) (y i_)))))
  '(= x y))))
(dk-peel!)
(rpw-setup!)
(dk-rewrite-h! '(IN x (VEC (RING-POW R n))) RPW-RP RPW-DS)
(dk-rewrite-h! '(IN y (VEC (RING-POW R n))) RPW-RP RPW-DS)
(fact 'dsum-ext 'R 'n RPW-FAM 'x 'y)
(ass)
(rpw-done! 'ring-pow-ext)

(sp (make-wff (rpw-stmt '(i) '((IN i (INTERVAL 1 n))) '(= ((VZERO (RING-POW R n)) i) (ZERO R)))))
(dk-peel!)
(rpw-setup!)
(rpw-rp->ds!)
(subst (dk-cite! 'dsum-vzero-at 'R 'n RPW-FAM 'i))
(rpw-fam-ram! 'i)
(subst (list '= (list RPW-FAM 'i) RPW-RAM))
(subst (list '= (list 'VZERO RPW-RAM) '(ZERO R)))
(fact 'ring-zero-in 'R)
(rfl)
(rpw-done! 'ring-pow-vzero-at)

;;; ---- the unit vectors ------------------------------------------------------------------
(sp (make-wff (rpw-stmt '(k) '() (list 'IN (rpw-unit 'k) '(VEC (RING-POW R n))))))
(dk-peel!)
(rpw-setup!)
(fact 'unitrow-type 'R 'n 'k)
(dk-have! (list 'IN (rpw-unit 'k) '(FUN (INTERVAL 1 n) (CARR R)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((ld (dk-peel!)) (t (rpw-iv-var ld '(INTERVAL 1 n))))
          (if (not (rpw-beta!))
              (begin
                (fact 'entry-in-carrier 1 'n '(CARR R) '(UNITROW R n k) 1 t)
                (ass)))))
      (lambda () (fact 'interval-in-set 1 'n) (ass)))))
(fact 'ring-pow-vec-in 'R 'n (rpw-unit 'k))
(ass)
(rpw-done! 'ring-unit-vec)

(define RPW-UG '(VNB-LAMBDA (LIST rqua_ rqub_) (CARTESIAN (INTERVAL 1 n) (INTERVAL 1 1))
                  (VNB-LAMBDA rqut_ (INTERVAL 1 n) (ENTRY (UNITROW R n rqua_) 1 rqut_))))
(define (rpw-ug-pt! cls finish)         ; forall i in [1,n], j in [1,1]. UG(i,j) in CLS
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n))
              (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1)) (list 'IN (list RPW-UG 'i 'j) cls)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (rpw-iv-var ld '(INTERVAL 1 n))))
        (if (not (rpw-beta!))
            (begin
              (fact 'ring-unit-vec 'R 'n i)
              (finish (rpw-unit i))
              (ass)))))))
(sp (make-wff (rpw-stmt '() '() '(IN (RING-UNITS R n) (MAT n 1 (VEC (RING-POW R n)))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'ring-pow-is-module 'R 'n)
(mac 'RING-UNITS)
(rpw-ug-pt! '(VEC (RING-POW R n)) (lambda (t) #t))
(fact 'matof-in-mat 'n 1 '(VEC (RING-POW R n)) RPW-UG)
(ass)
(rpw-done! 'ring-units-type)

(sp (make-wff (rpw-stmt '(k) '((IN k (INTERVAL 1 n))) (list '= '(ENTRY (RING-UNITS R n) k 1) (rpw-unit 'k)))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'ring-unit-vec 'R 'n 'k)
(fact 'ring-pow-is-module 'R 'n)
(mac 'RING-UNITS)
(rpw-ug-pt! 'SET (lambda (t) (fact 'membership-implies-sethood t '(VEC (RING-POW R n)))))
(subst (dk-cite! 'entry-of-matof 'n 1 RPW-UG 'k 1))
(if (not (rpw-beta!)) (rfl))
(rpw-done! 'ring-units-entry)

(sp (make-wff (rpw-stmt '(k i) '((IN i (INTERVAL 1 n)))
  (list '= (list (rpw-unit 'k) 'i) '(ENTRY (UNITROW R n k) 1 i)))))
(dk-peel!)
(fact 'one-in-interval-1)
(fact 'unitrow-type 'R 'n 'k)
(fact 'entry-in-carrier 1 'n '(CARR R) '(UNITROW R n k) 1 'i)
(if (not (rpw-beta!)) (rfl))
(rpw-done! 'ring-unit-at)

;;; ---- the components of a combination of the unit vectors -----------------------------
(define (rpw-ms-at! ev j)
  (subst (dk-cite! 'map-seq-entry ev (list 'VEC RPW-DS) (list 'VEC RPW-RAM) 'n RPW-UN j))
  (subst (dk-cite! 'ring-units-entry 'R 'n j))
  (fact 'ring-unit-vec 'R 'n j)
  (dk-rewrite-h! (list 'IN (rpw-unit j) (list 'VEC RPW-RP)) RPW-RP RPW-DS)
  (dk-lam-b!))
(sp (make-wff (rpw-stmt '(c i) '((IN c (MAT 1 n (CARR R))) (IN i (INTERVAL 1 n)))
  '(= ((LINCOMB (RING-POW R n) n c (RING-UNITS R n)) i) (ENTRY c 1 i)))))
(dk-peel!)
(rpw-setup!)
(fact 'ring-units-type 'R 'n)
(dk-rewrite-h! (list 'IN RPW-UN (list 'MAT 'n 1 (list 'VEC RPW-RP))) RPW-RP RPW-DS)
(rpw-rp->ds!)
(let* ((ev (list 'VNB-LAMBDA 'evx_ (list 'VEC RPW-DS) '(evx_ i)))
       (ms (list 'MAP-SEQ ev 'n RPW-UN)))
  (subst (dk-cite! 'dsum-lincomb-at 'R 'n RPW-FAM 'n 'c RPW-UN 'i))
  (rpw-fam-ram! 'i)
  (subst (list '= (list RPW-FAM 'i) RPW-RAM))
  (dk-apply! RPW-HM 'i)
  (fact 'dsum-eval-hom 'R 'n RPW-FAM 'i)
  (rpw-hom-open! RPW-DS (list RPW-FAM 'i) ev)
  (dk-rewrite-h! (list 'IN ev (list 'FUN (list 'VEC RPW-DS) (list 'VEC (list RPW-FAM 'i)))) (list RPW-FAM 'i) RPW-RAM)
  (fact 'map-seq-type ev (list 'VEC RPW-DS) (list 'VEC RPW-RAM) 'n RPW-UN)
  (dk-have! (list 'IN 'c (list 'MAT 1 'n (list 'CARR (list 'SCAL RPW-RAM))))
    (lambda () (subst (list '= (list 'SCAL RPW-RAM) 'R)) (ass)))
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 n)) (list 'IMPLIES '(NOT (= j_ i))
              (list '= (list 'ENTRY ms 'j_ 1) (list 'VZERO RPW-RAM)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (j (rpw-iv-var ld '(INTERVAL 1 n))))
        (dk-have! (list 'NOT (list '= 'i j))
          (lambda () (di) (dk-cite! 'equality-symmetry 'i j) (ai (list 'NOT (list '= j 'i)))))
        (rpw-ms-at! ev j)
        (subst (dk-cite! 'unitrow-entry-off 'R 'n j 'i))
        (subst (list '= (list 'VZERO RPW-RAM) '(ZERO R)))
        (fact 'ring-zero-in 'R)
        (rfl))))
  (subst (dk-cite! 'lincomb-single-support RPW-RAM 'n 'c ms 'i))
  (rpw-ms-at! ev 'i)
  (subst (dk-cite! 'unitrow-entry-at 'R 'n 'i))
  (subst (list '= (list 'ACT RPW-RAM) '(MUL R)))
  (fact 'entry-in-carrier 1 'n '(CARR R) 'c 1 'i)
  (subst (dk-cite! 'ring-mul-right-id 'R '(ENTRY c 1 i)))
  (rfl))
(rpw-done! 'ring-pow-lincomb-at)
(gloss! 'ring-pow-lincomb-at "In R^n the i-th component of c_1 e_1 + ... + c_n e_n is c_i.")

;;; ---- the coefficient row of a vector ---------------------------------------------------
(define RPW-RG '(VNB-LAMBDA (LIST rqra_ rqrb_) (CARTESIAN (INTERVAL 1 1) (INTERVAL 1 n)) (x rqrb_)))
(define (rpw-rg-pt! cls)                 ; forall i in [1,1], j in [1,n]. RG(i,j) in CLS (CARR R or SET)
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 1))
              (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) (list 'IN (list RPW-RG 'i 'j) cls)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (j (rpw-iv-var ld '(INTERVAL 1 n))))
        (if (not (rpw-beta!))
            (begin
              (fact 'ring-pow-vec-out 'R 'n 'x j)
              (if (equal? cls 'SET)
                  (fact 'membership-implies-sethood (list 'x j) '(CARR R)))
              (ass)))))))
(sp (make-wff (rpw-stmt '(x) '((IN x (VEC (RING-POW R n)))) '(IN (RING-ROW R n x) (MAT 1 n (CARR R))))))
(dk-peel!)
(rpw-setup!)
(mac 'RING-ROW)
(rpw-rg-pt! '(CARR R))
(fact 'matof-in-mat 1 'n '(CARR R) RPW-RG)
(ass)
(rpw-done! 'ring-row-type)

(sp (make-wff (rpw-stmt '(x i) '((IN x (VEC (RING-POW R n))) (IN i (INTERVAL 1 n))) '(= (ENTRY (RING-ROW R n x) 1 i) (x i)))))
(dk-peel!)
(rpw-setup!)
(fact 'ring-pow-vec-out 'R 'n 'x 'i)
(mac 'RING-ROW)
(rpw-rg-pt! 'SET)
(subst (dk-cite! 'entry-of-matof 1 'n RPW-RG 1 'i))
(if (not (rpw-beta!)) (rfl))
(rpw-done! 'ring-row-entry)

(define RPW-ZRL '(LINCOMB (RING-POW R n) n (RING-ROW R n x) (RING-UNITS R n)))
(define (rpw-zrl-type!)                  ; the combination is a vector of R^n
  (fact 'ring-pow-is-module 'R 'n)
  (fact 'ring-pow-scal 'R 'n)
  (fact 'ring-row-type 'R 'n 'x)
  (fact 'ring-units-type 'R 'n)
  (dk-have! '(IN (RING-ROW R n x) (MAT 1 n (CARR (SCAL (RING-POW R n))))) (lambda () (subst '(= (SCAL (RING-POW R n)) R)) (ass)))
  (fact 'lincomb-type '(RING-POW R n) 'n '(RING-ROW R n x) '(RING-UNITS R n)))
(sp (make-wff (rpw-stmt '(x) '((IN x (VEC (RING-POW R n)))) (list '= RPW-ZRL 'x))))
(dk-peel!)
(rpw-setup!)
(rpw-zrl-type!)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list RPW-ZRL 'i_) '(x i_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (i (rpw-iv-var ld '(INTERVAL 1 n))))
      (subst (dk-cite! 'ring-pow-lincomb-at 'R 'n '(RING-ROW R n x) i))
      (subst (dk-cite! 'ring-row-entry 'R 'n 'x i))
      (fact 'ring-pow-vec-out 'R 'n 'x i)
      (rfl))))
(fact 'ring-pow-ext 'R 'n RPW-ZRL 'x)
(ass)
(rpw-done! 'ring-pow-row-lincomb)
(gloss! 'ring-pow-row-lincomb "Every vector x of R^n is x(1) e_1 + ... + x(n) e_n.")

(sp (make-wff (rpw-stmt '() '() '(GENERATES (RING-POW R n) n (RING-UNITS R n)))))
(dk-peel!)
(rpw-setup!)
(fact 'ring-pow-is-module 'R 'n)
(fact 'ring-units-type 'R 'n)
(mac 'GENERATES)
(let* ((ld (dk-peel!)) (x (rpw-iv-var ld '(VEC (RING-POW R n))))
       (row (list 'RING-ROW 'R 'n x))
       (lc (list 'LINCOMB '(RING-POW R n) 'n row '(RING-UNITS R n))))
  (fact 'ring-pow-scal 'R 'n)
  (fact 'ring-row-type 'R 'n x)
  (dk-have! (list 'IN row '(MAT 1 n (CARR (SCAL (RING-POW R n))))) (lambda () (subst '(= (SCAL (RING-POW R n)) R)) (ass)))
  (ew row)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (dk-cite! 'ring-pow-row-lincomb 'R 'n x)
            (dk-cite! 'equality-symmetry lc x)
            (ass))))))
(rpw-done! 'ring-units-generate)

(sp (make-wff (rpw-stmt '() '() '(REL-FREE (RING-POW R n) n (RING-UNITS R n)))))
(dk-peel!)
(rpw-setup!)
(fact 'ring-pow-scal 'R 'n)
(fact 'ring-pow-is-module 'R 'n)
(fact 'ring-units-type 'R 'n)
(mac 'REL-FREE)
(let* ((ld (dk-peel!))
       (c (rpw-iv-var ld '(MAT 1 n (CARR (SCAL (RING-POW R n))))))
       (j (rpw-iv-var ld '(INTERVAL 1 n)))
       (lc (list 'LINCOMB '(RING-POW R n) 'n c '(RING-UNITS R n))))
  (dk-rewrite-h! (list 'IN c '(MAT 1 n (CARR (SCAL (RING-POW R n))))) '(SCAL (RING-POW R n)) 'R)
  (let* ((e1 (dk-cite! 'ring-pow-lincomb-at 'R 'n c j))
         (e2 (dk-rewrite-h! e1 lc '(VZERO (RING-POW R n)))))
    (subst '(= (SCAL (RING-POW R n)) R))
    (subst (list '= (list 'ENTRY c 1 j) (list '(VZERO (RING-POW R n)) j)))
    (fact 'ring-pow-vzero-at 'R 'n j)
    (ass)))
(rpw-done! 'ring-units-rel-free)
(gloss! 'ring-units-rel-free "The unit vectors e_1, ..., e_n of R^n are relation-free; with ring-units-generate, they freely generate R^n.")
