;;; ch4a-circle.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch4a/ch4a-circle.scm.
;;; Library: complex-analysis.

;;; ch4a-circle.scm -- the integrals of the powers of (w - c) round the circle |w - c| = r (CH4-A, 2026-10-28):
;;; the orthogonality relations (86) in line-integral form, the computation behind 4.2.
;;;   cc-is-convex                    CC is convex
;;;   circle-power-integral           int (w - c)^k dw = 0           (k >= 0; Cauchy on the convex CC)
;;;   circle-recip-integral           int dw / (w - c) = 2 pi i      (winding-circle-center)
;;;   circle-recip-power-integral     int dw / (w - c)^(j + 2) = 0   (a primitive on CC \ {c}, cif-recip-power-diff)
;;; Library: complex-analysis.  Load window: after cauchy-integral-formula (cif-recip-power-diff), winding-number-laws,
;;; goursat-exceptional (cauchy-convex-closed).  Prefix lcr-.
   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (lcr-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (if (pair? (dk-open-leaves)) (ass)))))))
    f))
(define lcr-P '(CIRCLE-PATH c r))
(define lcr-DP '(CIRCLE-DERIV c r))
(define lcr-tp '(* 2 PI))
(define (lcr-road!)               ; the circle: a closed road, its trace in CC
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path lcr-P lcr-DP 0 lcr-tp)
  (fact 'is-path-in-fun lcr-P 0 lcr-tp)
  (fact 'trace-subset-cc lcr-P 0 lcr-tp)
  (dk-cite! 'circle-path-closed 'c 'r))
(define (lcr-cc-open!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
  (fact 'carrier-is-open 'CC-MS)
  (if (not (dk-asm? '(IS-OPEN CC-MS CC))) (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))))

;;; (1) CC is convex
;;; CUT 2026-10-30 (integration): `cc-is-convex' was an accidental duplicate -- the tree proves the same
;;; statement IS-CONVEX-CC(CC) under the same name in theorem-library/ch3b-log.scm, which loads earlier.

;;; (2) the non-negative powers integrate to 0
(define lcr-g '(VNB-LAMBDA lcrw_ CC (power (- lcrw_ c) k)))
(sp (make-wff "forall([c in cc, r in rr, k in nn], line-int(vnb-lambda(lcrw_, cc, (lcrw_ - c) ^ k), circle-path(c, r), circle-deriv(c, r), 0, 2 * pi) = 0)"))
(dk-peel!)
(lcr-cc-open!)
(lcr-road!)
(let* ((T '(VNB-LAMBDA hbx_ CC (- hbx_ c)))
       (Pw '(VNB-LAMBDA hbx_ CC (power hbx_ k))))
  (dk-have! (list 'HOLOMORPHIC-ON 'CC T) (lambda () (dk-holomorphic! 'CC T)))
  (dk-have! (list 'IN Pw '(FUN CC CC))
    (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (lcr-and! (list 'IN z 'CC) '(IN k NN)) (fact 'power-typing-nonneg z 'k) (ass))))))
  (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ CC) (list '== (list Pw 'hbz_) '(power hbz_ k))))
    (lambda () (let ((z (dk-di-var!))) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
  (dk-cite! 'holomorphic-power 'k 'CC Pw)
  (dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES '(IN d2y_ CC) (list 'IN (list T 'd2y_) 'CC)))
    (lambda () (let ((z (dk-di-var!))) (fact 'cc-sub-in-cc z 'c) (dk-lam-b!) (ass))))
  (let* ((cp (dk-cite! 'holomorphic-compose 'CC 'CC T Pw))
         (lam (caddr cp)))
    (dk-have! (list 'IN lcr-g '(FUN CC CC))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fact 'cc-sub-in-cc z 'c)
                                           (lcr-and! (list 'IN (list '- z 'c) 'CC) '(IN k NN)) (fact 'power-typing-nonneg (list '- z 'c) 'k)
                                           (if (dk--redex? (dk-goal)) (dk-lam-b!)) (ass))))))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list lcr-g 'hbx_) (list lam 'hbx_))))
      (lambda () (let ((z (dk-di-var!))) (fact 'cc-sub-in-cc z 'c) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
    (dk-cite! 'holomorphic-transfer-ptwise-eq 'CC lcr-g lam)))
(fact 'cc-is-convex)
(dk-apply! (dk-cite! 'cauchy-convex-closed 'CC lcr-g) lcr-P lcr-DP 0 lcr-tp)
(ass)
(qed 'circle-power-integral)

;;; shared: the punctured plane D = CC \ {c}: open, its points nonzero after the shift, the circle's trace inside
(define lcr-D '(DIFFERENCE CC (SINGLETON c)))
(define lcr-kern '(VNB-LAMBDA wnw_ (DIFFERENCE CC (SINGLETON c)) (recip (- wnw_ c))))
(define (lcr-D-in! y)             ; y in D (in context): y in CC, y /= c, y - c /= 0
  (let ((iff (dk-cite! 'cc-punctured-membership 'c y)))
    (dk-split-all! (list (dk-meta-iff-r! iff)))
    (fact 'cc-sub-in-cc y 'c)
    (dk-have! (list 'NOT (list '= (list '- y 'c) 0))
      (lambda () (di) (dk-cite! 'cc-sub-zero-eq y 'c) (ai (list 'NOT (list '= y 'c)))))))
(define (lcr-D-setup!)
  (fact 'cc-is-set)
  (dk-cite! 'difference-set 'CC (list 'SINGLETON 'c))
  (dk-cite! 'cc-punctured-open 'c)
  (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lcr-D) '(NOT (= (- y c) 0))))
    (lambda () (let ((y (dk-di-var!))) (lcr-D-in! y) (ass))))
  (dk-have! (list 'SUBSET lcr-D 'CC) (lambda () (let ((y (subset-by-element!))) (lcr-D-in! y) (ass))))
  (fact 'rr-one-in) (fact 'rr-add-in-rr 'r 1)
  (dk-have! '(< r (+ r 1)) (lambda () (dk-ineq! '(IN r RR))))
  (dk-have! (list 'SUBSET (list 'TRACE lcr-P 0 lcr-tp) lcr-D)
    (lambda ()
      (let* ((y (subset-by-element!)))
        (dk-split-all! (list (dk-cite! 'circle-trace-in-punctured-ball 'c 'r '(+ r 1) y)))
        (fact 'subset-mem-fwd (list 'TRACE lcr-P 0 lcr-tp) 'CC y)
        (let ((iff (dk-cite! 'cc-punctured-membership 'c y)))
          (dk-only! iff (list 'IN y 'CC) (list 'NOT (list '= y 'c))) (prop))))))
;;; holomorphic on D, then continuous there
(define (lcr-hol-cont! lam)
  (dk-have! (list 'HOLOMORPHIC-ON lcr-D lam) (lambda () (dk-holomorphic! lcr-D lam)))
  (fact 'holomorphic-on-in-fun lcr-D lam)
  (fact 'holomorphic-on-continuous lcr-D lam))

;;; (3) int dw / (w - c) = 2 pi i
(sp (make-wff "forall([c in cc, r in rr], 0 < r implies
   line-int(vnb-lambda(wnw_, difference(cc, singleton(c)), recip(wnw_ - c)), circle-path(c, r), circle-deriv(c, r), 0, 2 * pi) = (2 * pi) * 1i)"))
(dk-peel!)
(lcr-cc-open!)
(lcr-road!)
(lcr-D-setup!)
(lcr-hol-cont! lcr-kern)
(dk-cite! 'line-int-in-cc lcr-D lcr-kern lcr-P lcr-DP 0 lcr-tp)
(dk-cite! 'winding-circle-center 'c 'r)
(dk-split-all! (list (dk-cite! 'pi-pos)))
(fact 'cc-i-in)
(let* ((tpi '(* (* 2 PI) +i)) (lk (list 'LINE-INT lcr-kern lcr-P lcr-DP 0 lcr-tp)) (rt (list 'recip tpi))
       (w (list 'WINDING lcr-P lcr-DP 0 lcr-tp 'c)))
  (fact 'rr-subset-cc 'PI) (fact 'rr-subset-cc 2)
  (lcr-and! '(IN 2 CC) '(IN PI CC)) (fact 'cc-mul-closed 2 'PI)
  (lcr-and! '(IN (* 2 PI) CC) '(IN +i CC)) (fact 'cc-mul-closed '(* 2 PI) '+i)
  (dk-have! (list 'NOT (list '= tpi 0))
    (lambda ()
      (fact 'rr-mul-in-rr 2 'PI)
      (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(IN PI RR) '(< 0 PI))))
      (fact 'rr-pos-ne-zero '(* 2 PI))
      (dk-have! '(NOT (= +i 0))
        (lambda () (di) (fact 'cc-i-squared)
          (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
          (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
          (ai '(NOT (= (* 0 0) -1)))))
      (dk-cite! 'cc-mul-nonzero '(* 2 PI) '+i)
      (ass)))
  (lcr-and! (list 'IN tpi 'CC) (list 'NOT (list '= tpi 0)))
  (fact 'cc-recip-closed tpi) (fact 'cc-recip-inverse tpi)
  (dk-have! (list '== w (list '* rt lk)) (lambda () (mac 'WINDING) (qrfl)))
  (dk-have! (list '= (list '* rt lk) 1) (lambda () (subst (list '== (list '* rt lk) w)) (ass)))
  (let* ((t (dk-name! rt 'CC)) (l (dk-name! lk 'CC)))
    (dk-have! (list '= (list '* t l) 1) (lambda () (subst (list '= t rt)) (subst (list '= l lk)) (ass)))
    (dk-have! (list '= (list '* tpi t) 1) (lambda () (subst (list '= t rt)) (ass)))
    (subst (list '= lk l))
    (dk-have! (list '= l (list '* (list '* tpi t) l)) (lambda () (subst (list '= (list '* tpi t) 1)) (crs)))
    (subst (list '= l (list '* (list '* tpi t) l)))
    (dk-have! (list '= (list '* (list '* tpi t) l) (list '* tpi (list '* t l))) (lambda () (crs)))
    (subst (list '= (list '* (list '* tpi t) l) (list '* tpi (list '* t l))))
    (subst (list '= (list '* t l) 1))
    (crs)))
(qed 'circle-recip-integral)

;;; (4) int dw / (w - c)^(j + 2) = 0: d/dw (w - c)^-(j+1) = -(j+1) (w - c)^-(j+2) on D
(sp (make-wff "forall([c in cc, r in rr, j in nn], 0 < r implies
   line-int(vnb-lambda(lcrw_, difference(cc, singleton(c)), recip(lcrw_ - c) ^ succ(succ(j))), circle-path(c, r), circle-deriv(c, r), 0, 2 * pi) = 0)"))
(dk-peel!)
(lcr-cc-open!)
(lcr-road!)
(lcr-D-setup!)
(fact 'nn-succ-closed 'j) (fact 'nn-succ-closed '(succ j))
(let* ((F '(VNB-LAMBDA cifv_ (DIFFERENCE CC (SINGLETON c)) (power (recip (- cifv_ c)) (succ j))))
       (g '(VNB-LAMBDA lcrw_ (DIFFERENCE CC (SINGLETON c)) (power (recip (- lcrw_ c)) (succ (succ j)))))
       (m '(- (succ j)))
       (df (list 'VNB-LAMBDA 'lcrw_ lcr-D (list '* m '(power (recip (- lcrw_ c)) (succ (succ j)))))))
  (fact 'nn-in-rr '(succ j)) (fact 'rr-subset-cc '(succ j)) (fact 'cc-neg-closed '(succ j))
  (define (typ-at! y)              ; y in D: the reciprocal power and its multiple typed
    (typ-at2! y (proof-state-focus *ps*)))
  (define (typ-at2! y leaf)
    (lcr-D-in! y)
    (lcr-and! (list 'IN (list '- y 'c) 'CC) (list 'NOT (list '= (list '- y 'c) 0)))
    (fact 'cc-recip-closed (list '- y 'c))
    (lcr-and! (list 'IN (list 'recip (list '- y 'c)) 'CC) '(IN (succ (succ j)) NN))
    (fact 'power-typing-nonneg (list 'recip (list '- y 'c)) '(succ (succ j)))
    (if (and (pair? (dk-open-leaves)) (dk-contains? (dk-goal) '(succ (succ j))) (dk-contains? (dk-goal) '*))
        (dk-type! (list '* m (list 'power (list 'recip (list '- y 'c)) '(succ (succ j)))) 'CC)))
  (for-each (lambda (lam)
              (dk-have! (list 'IN lam (list 'FUN lcr-D 'CC))
                (lambda () (dk-lam-type! (lambda () (let ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (if (dk--redex? (dk-goal)) (dk-lam-b!))
                  (typ-at! y)
                  (if (not (sequent-node-grounded? leaf)) (ass))))))))
            (list g df))
  (define (hol-pow! F idx)
  (dk-have! (list 'HOLOMORPHIC-ON lcr-D F)
    (lambda ()
      (mac 'HOLOMORPHIC-ON)
      (dk-conj-close!
       (lambda ()
         (let ((gl (dk-goal)))
           (cond ((dk-head-is? gl 'IS-OPEN) (dk-only! (dk-cite! 'cc-ms-open-iff lcr-D) (list 'IS-OPEN 'CC-MS lcr-D)) (prop))
                 ((dk-head-is? gl 'IN)
                  (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (lcr-D-in! y)
                    (lcr-and! (list 'IN (list '- y 'c) 'CC) (list 'NOT (list '= (list '- y 'c) 0)))
                    (fact 'cc-recip-closed (list '- y 'c))
                    (lcr-and! (list 'IN (list 'recip (list '- y 'c)) 'CC) (list 'IN (list 'succ idx) 'NN))
                    (fact 'power-typing-nonneg (list 'recip (list '- y 'c)) (list 'succ idx))
                    (if (dk--redex? (dk-goal)) (dk-lam-b!)) (ass)))))
                 (#t (let ((y (dk-di-var!)))
                       (let ((dd (dk-cite! 'cif-recip-power-diff idx 'c y)))
                         (ew (list-ref dd 5)) (ass)))))))))))
  (hol-pow! F 'j)
  (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ lcr-D) (list 'IS-DIFF-ON 'CC-NORMED-FIELD lcr-D F 'hbz_ (list df 'hbz_))))
    (lambda ()
      (let ((y (dk-di-var!)))
        (typ-at! y)
        (dk-cite! 'cif-recip-power-diff 'j 'c y)
        (dk-lam-b!)
        (ass))))
  (dk-cite! 'line-int-closed-road-of-derivative lcr-D F df lcr-P lcr-DP 0 lcr-tp)
  (hol-pow! g '(succ j))
  (fact 'holomorphic-on-in-fun lcr-D g)
  (fact 'holomorphic-on-continuous lcr-D g)
  (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ lcr-D) (list '== (list df 'liz_) (list '* m (list g 'liz_)))))
    (lambda () (let ((y (dk-di-var!))) (typ-at! y) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
  (dk-cite! 'line-int-scalar lcr-D g lcr-P lcr-DP 0 lcr-tp m df)
  (dk-cite! 'line-int-in-cc lcr-D g lcr-P lcr-DP 0 lcr-tp)
  (let* ((lg (list 'LINE-INT g lcr-P lcr-DP 0 lcr-tp)) (ld (list 'LINE-INT df lcr-P lcr-DP 0 lcr-tp)))
    (fact 'nn-in-rr '(succ j))
    (dk-have! (list 'NOT (list '= m 0))
      (lambda () (di)
        (fact 'nn-zero-le 'j) (fact 'nn-in-rr 'j) (dk-cite! 'nn-succ-plus-one 'j)
        (dk-have! '(= (succ j) 0) (lambda () (dk-have! '(= (succ j) (- 0 (- (succ j)))) (lambda () (crs))) (subst '(= (succ j) (- 0 (- (succ j))))) (subst (list '= m 0)) (crs)))
        (dk-have! '(< 0 0) (lambda () (dk-ineq! '(IN j RR) '(<= 0 j) '(= (succ j) (+ j 1)) '(= (succ j) 0))))
        (fact 'rr-zero-in) (fact 'rr-lt-irrefl 0) (ai '(NOT (< 0 0)))))
    (lcr-and! (list 'IN m 'CC) (list 'NOT (list '= m 0)))
    (fact 'cc-recip-closed m) (fact 'cc-recip-inverse m)
    (let* ((im (dk-name! (list 'recip m) 'CC)) (lv (dk-name! lg 'CC)))
      (dk-have! (list '= (list '* m im) 1) (lambda () (subst (list '= im (list 'recip m))) (ass)))
      (dk-have! (list '= (list '* m lv) 0)
        (lambda () (subst (list '= lv lg)) (subst (list '= (list '* m lg) ld)) (ass)))
      (subst (list '= lg lv))
      (dk-have! (list '= lv (list '* im (list '* m lv))) (lambda ()
        (dk-have! (list '= (list '* im (list '* m lv)) (list '* (list '* m im) lv)) (lambda () (crs)))
        (subst (list '= (list '* im (list '* m lv)) (list '* (list '* m im) lv)))
        (subst (list '= (list '* m im) 1)) (crs)))
      (subst (list '= lv (list '* im (list '* m lv))))
      (subst (list '= (list '* m lv) 0))
      (crs))))
(qed 'circle-recip-power-integral)
