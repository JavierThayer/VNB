;;; ba2b-radius.scm -- C*-ALGEBRAS: rho(h) = ||h|| for a self-adjoint h (the remark after Theorem 1.23 of
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 2: "the previous proof also shows that for any
;;; C*-algebra A and any self-adjoint element y in A, rho(y) = ||y||").
;;; Agent BA-2B, wave 2026-11-10.  Destination: theorem-library/ba2b-radius.scm.  Library: operator-algebras.
;;; All proofs modulo 0.  Helper prefix b2r-.
;;; LOAD WINDOW: after BA-1's ba-elem (bae-el-pow-type, -one, -comm), BA-1C's ba-fekete (baf-el-pow-add,
;;; spectral-radius-limit), BA-1F's ba-spectral-radius (spectral-radius-unfold, spectral-radius-real), BA-1H's
;;; ba-gelfand-formula (bgf-radius-le-root) and ba-cstar-laws (bcs-uiba-is-uba), BA-2's ba2-cstar (bcp-ro-*,
;;; bcp-star-*, bcp-ucsa-*, bcp-u-*), and limit-frequent (rr-limit-of-frequent-value).
;;;
;;; THE ROUTE (the notes').  For h = h*: (h^n)* = h^n, so ||h^(2n)|| = ||(h^n)* h^n|| = ||h^n||^2; hence for
;;; every N there is m = k + 1 >= N with ||h^m|| = ||h||^m (doubling m), and at those m the sequence
;;; ||h^m||^(1/m) of spectral-radius-limit equals ||h||; a convergent sequence that takes a value at
;;; arbitrarily large indices converges to it (rr-limit-of-frequent-value).  ||h|| = 0 is the case
;;; rho(h) <= ||h^1||^(1/1) = 0.
;;; THE VIEW.  A unital involutive algebra a reaches the unital-Banach-algebra lemmas through
;;; B = UIBA-AS-UBA(a); EL-POW(B, x, n) = EL-POW(a, x, n) by induction, and SPECTRAL-RADIUS(B, x) ==
;;; SPECTRAL-RADIUS(a, x) by extensionality of the two sets inside EINF (a rewrite cannot reach EL-POW under
;;; the SEP binder).

(define (b2r-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba2b-radius: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba2b-radius: unfinished" name))))
(define (b2r-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
;;; instantiate the induction hypothesis IH at the LAST k of NAMES, k = its number of leading binders
(define (b2r-ih! ih names)
  (let count ((f ih) (k 0))
    (cond ((dk-head-is? f 'FORALL) (count (caddr f) (+ k 1)))
          ((dk-head-is? f 'IMPLIES) (count (caddr f) k))
          (#t (let ((ts (list-tail names (- (length names) k))))
                (if (null? ts) (b2r-detach-all! ih) (apply dk-apply! ih ts)))))))
(define (b2r-detach-all! f)
  (let loop ((r f))
    (if (dk-head-is? r 'IMPLIES) (loop (dk-landed-1 (lambda () (detach! r)))) r)))

(define b2r-B '(UIBA-AS-UBA a))
(define (b2r-p A x n) (list 'EL-POW A x n))
(define (b2r-nr A x) (list (list 'VNRM A) x))
(define (b2r-mu A x y) (list (list 'VMUL A) x y))
(define (b2r-st A x) (list (list 'VSTAR A) x))
(define (b2r-uiba body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) body))))
(define (b2r-ucsa body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA a) body))))

;;; (IN x (VEC B)) from (IN x (VEC a)); IS-UNITAL-BANACH-ALGEBRA(B) from IS-UIBA(a)
(define (b2r-in-B! x)
  (dk-cite! 'bcs-uiba-is-uba 'a)
  (dk-cite! 'bcp-ro-vec 'a)
  (if (not (dk-asm? (list 'IN x '(VEC (UIBA-AS-UBA a)))))
      (dk-rewrite-h! (list 'IN x '(VEC a)) '(VEC a) '(VEC (UIBA-AS-UBA a))))
  (list 'IN x '(VEC (UIBA-AS-UBA a))))
;;; (IN (EL-POW a x n) (VEC a)), with IS-UIBA(a), (IN x (VEC a)), (IN n NN) in context
(define (b2r-ptype! n x)
  (let ((goal (list 'IN (b2r-p 'a x n) '(VEC a))))
    (if (not (dk-asm? goal))
        (begin
          (b2r-in-B! x)
          (let* ((t1 (dk-cite! 'bae-el-pow-type n b2r-B x))
                 (e  (dk-cite! 'b2r-el-pow-view n 'a x))
                 (t2 (dk-rewrite-h! t1 (b2r-p b2r-B x n) (b2r-p 'a x n))))
            (dk-rewrite-h! t2 '(VEC (UIBA-AS-UBA a)) '(VEC a)))))
    goal))

;;; ---- A. EL-POW through the view -----------------------------------------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (== (EL-POW (UIBA-AS-UBA a) x n) (EL-POW a x n))))))))))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (fact 'el-pow-zero b2r-B 'x) (subst (list '= (b2r-p b2r-B 'x 0) '(VONE (UIBA-AS-UBA a))))
  (fact 'el-pow-zero 'a 'x) (subst (list '= (b2r-p 'a 'x 0) '(VONE a)))
  (dk-cite! 'bcp-ro-vone 'a)
  (subst '(= (VONE (UIBA-AS-UBA a)) (VONE a)))
  (qrfl)
  (dk-focus! step)
  (dk-peel!)
  (fact 'el-pow-succ b2r-B 'x v)
  (subst (list '= (b2r-p b2r-B 'x (list 'succ v)) (b2r-mu b2r-B 'x (b2r-p b2r-B 'x v))))
  (fact 'el-pow-succ 'a 'x v)
  (subst (list '= (b2r-p 'a 'x (list 'succ v)) (b2r-mu 'a 'x (b2r-p 'a 'x v))))
  (b2r-ih! ih '(a x))
  (subst (list '= (b2r-p b2r-B 'x v) (b2r-p 'a 'x v)))
  (dk-cite! 'bcp-ro-vmul 'a)
  (subst '(= (VMUL (UIBA-AS-UBA a)) (VMUL a)))
  (qrfl))
(b2r-qed! 'b2r-el-pow-view)

;;; ---- the spectral radius through the view ---------------------------------------------------------
;;; move (IN w S1) to (IN w S2), S1 and S2 differing by EL-POW(A1, x, n) vs EL-POW(A2, x, n)
(define (b2r-sep-move! hyp s2 a1 a2)
  (let* ((w (cadr hyp))
         (landed (dk-landed (lambda () (sep-me (or (dk-ctx-form hyp) hyp)))))
         (ex (find-first (dk-head? 'FORSOME) landed))
         (n (dk-skolem! ex #t))
         (eqn (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) w) (dk-contains? f n))) "the value equation"))
         (e (dk-cite! 'b2r-el-pow-view n 'a 'x)))
    (dk-rewrite-h! eqn (b2r-p a1 'x n) (b2r-p a2 'x n))
    (in-sep! (lambda () (dk-ass!))
             (lambda () (ew n) (dk-conj-close! (lambda () (dk-ass!)))))))
(sp (b2r-uiba '(FORALL x (IMPLIES (IN x (VEC a)) (== (SPECTRAL-RADIUS (UIBA-AS-UBA a) x) (SPECTRAL-RADIUS a x))))))
(dk-peel!)
(let* ((ub (dk-cite! 'spectral-radius-unfold b2r-B 'x))
       (ua (dk-cite! 'spectral-radius-unfold 'a 'x))
       (rv (dk-cite! 'bcp-ro-vnrm 'a))
       (ub2 (dk-rewrite-h! ub '(VNRM (UIBA-AS-UBA a)) '(VNRM a)))
       (sb (cadr (caddr ub2)))
       (sa (cadr (caddr ua))))
  (detach-with! (dk-cite! 'class-extensionality sb sa)
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? (caddr g) sa))
                 (lambda () (b2r-sep-move! (list 'IN w sb) sa b2r-B 'a))
                 (lambda () (b2r-sep-move! (list 'IN w sa) sb 'a b2r-B))))))
  (subst (list '= '(SPECTRAL-RADIUS (UIBA-AS-UBA a) x) (caddr ub2)))
  (subst (list '= '(SPECTRAL-RADIUS a x) (caddr ua)))
  (subst (list '= sb sa))
  (qrfl))
(b2r-qed! 'b2r-spectral-radius-view)

;;; ---- B. (h^n)* = h^n for h self-adjoint ---------------------------------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL h (IMPLIES (IS-SELF-ADJOINT-EL a h) (= ((VSTAR a) (EL-POW a h n)) (EL-POW a h n))))))))))
(define (b2r-sa-parts!)
  (dk-project! '(IN h (VEC a)) 'is-self-adjoint-el '(IS-SELF-ADJOINT-EL a h))
  (dk-project! '(= ((VSTAR a) h) h) 'is-self-adjoint-el '(IS-SELF-ADJOINT-EL a h)))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (fact 'el-pow-zero 'a 'h) (subst (list '= (b2r-p 'a 'h 0) '(VONE a)))
  (dk-cite! 'bcp-star-one 'a)
  (dk-ass!)
  (dk-focus! step)
  (dk-peel!)
  (b2r-sa-parts!)
  (let ((pv (b2r-p 'a 'h v)))
    (b2r-ptype! v 'h)
    (fact 'el-pow-succ 'a 'h v)
    (subst (list '= (b2r-p 'a 'h (list 'succ v)) (b2r-mu 'a 'h pv)))
    (dk-cite! 'bcp-star-mul 'a 'h pv)
    (subst (list '= (b2r-st 'a (b2r-mu 'a 'h pv)) (b2r-mu 'a (b2r-st 'a pv) (b2r-st 'a 'h))))
    (b2r-ih! ih '(a h))
    (subst (list '= (b2r-st 'a pv) pv))
    (subst (list '= (b2r-st 'a 'h) 'h))
    (b2r-in-B! 'h)
    (let* ((c1 (dk-cite! 'bae-el-pow-comm v b2r-B 'h))
           (e  (dk-cite! 'b2r-el-pow-view v 'a 'h))
           (c2 (dk-rewrite-h! c1 (b2r-p b2r-B 'h v) pv))
           (r  (dk-cite! 'bcp-ro-vmul 'a))
           (c3 (dk-rewrite-h! c2 '(VMUL (UIBA-AS-UBA a)) '(VMUL a))))
      (subst (list '= (b2r-mu 'a pv 'h) (b2r-mu 'a 'h pv)))
      (rfl))))
(b2r-qed! 'b2r-el-pow-sa)

;;; ---- C. ||h^(n+n)|| = ||h^n||^2 for h self-adjoint in a C*-algebra --------------------------------
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA a)
  (FORALL h (IMPLIES (IS-SELF-ADJOINT-EL a h)
    (= ((VNRM a) (EL-POW a h (+ n n))) (* ((VNRM a) (EL-POW a h n)) ((VNRM a) (EL-POW a h n))))))))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'a)
(b2r-sa-parts!)
(let* ((pn (b2r-p 'a 'h 'n)) (nn2 '(+ n n)) (q (b2r-p 'a 'h nn2)))
  (b2r-cite2! 'nn-add-closed 'n 'n)
  (b2r-in-B! 'h)
  (b2r-ptype! 'n 'h)
  (let* ((e0 (dk-cite! 'baf-el-pow-add 'n b2r-B 'h 'n))
         (ea (dk-cite! 'b2r-el-pow-view nn2 'a 'h))
         (eb (dk-cite! 'b2r-el-pow-view 'n 'a 'h))
         (e1 (dk-rewrite-h! e0 (b2r-p b2r-B 'h nn2) q))
         (e2 (dk-rewrite-h! e1 (b2r-p b2r-B 'h 'n) pn))
         (r  (dk-cite! 'bcp-ro-vmul 'a))
         (e3 (dk-rewrite-h! e2 '(VMUL (UIBA-AS-UBA a)) '(VMUL a)))
         (cs (dk-cite! 'bcp-ucsa-cstar 'a pn))
         (sa (dk-cite! 'b2r-el-pow-sa 'n 'a 'h))
         (cs2 (dk-rewrite-h! cs (b2r-st 'a pn) pn)))
    (subst (list '= q (b2r-mu 'a pn pn)))
    (dk-ass!)))
(b2r-qed! 'b2r-el-pow-double)

;;; ---- D. ||h^m|| = ||h||^m at arbitrarily large m = k + 1 --------------------------------------------
(sp (make-wff '(FORALL nb (IMPLIES (IN nb NN) (FORALL a (IMPLIES (IS-UNITAL-C-STAR-ALGEBRA a)
  (FORALL h (IMPLIES (IS-SELF-ADJOINT-EL a h) (IMPLIES (< 0 ((VNRM a) h))
    (FORSOME b2k_ (AND (IN b2k_ NN) (AND (<= nb b2k_)
      (= ((VNRM a) (EL-POW a h (succ b2k_))) (RPOW-STAR ((VNRM a) h) (succ b2k_)))))))))))))))
(define b2r-r '((VNRM a) h))
(let* ((br (dk-use-induction-fixed!)) (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (dk-cite! 'bcp-ucsa-uiba 'a)
  (b2r-sa-parts!)
  (dk-cite! 'bcp-u-bae-vnrm-type 'a 'h)
  (dk-have! '(IN 1 NN))
  (dk-have! '(= (succ 0) 1) (lambda () (arith)))
  (b2r-in-B! 'h)
  (let* ((o1 (dk-cite! 'bae-el-pow-one b2r-B 'h))
         (e  (dk-cite! 'b2r-el-pow-view 1 'a 'h))
         (o2 (dk-rewrite-h! o1 (b2r-p b2r-B 'h 1) (b2r-p 'a 'h 1))))
    (dk-cite! 'rpow-star-one b2r-r)
    (ew 0)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g '=)
                 (subst '(= (succ 0) 1))
                 (subst (list '= (b2r-p 'a 'h 1) 'h))
                 (subst (list '= (list 'RPOW-STAR b2r-r 1) b2r-r))
                 (rfl))
                ((dk-head-is? g '<=) (arith))
                (#t (from-context!)))))))
  (dk-focus! step)
  (dk-peel!)
  (let* ((ex (b2r-ih! ih '(a h)))
         (k (dk-skolem! ex #t))
         (m (list 'succ k))
         (k2 (list '+ m k)))
    (dk-cite! 'bcp-ucsa-uiba 'a)
    (b2r-sa-parts!)
    (dk-cite! 'bcp-u-bae-vnrm-type 'a 'h)
    (dk-cite! 'nn-succ-closed k)
    (b2r-cite2! 'nn-add-closed m k)
    (dk-cite! 'nn-add-succ m k)
    (dk-cite! 'b2r-el-pow-double m 'a 'h)
    (dk-cite! 'nn-in-rr m)
    (b2r-cite2! 'rpow-star-add b2r-r m m)
    (dk-cite! 'rpow-star-in-rr b2r-r m)
    (ew k2)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-head-is? g '=)
                 (subst (list '= (list 'succ k2) (list '+ m m)))
                 (subst (list '= (b2r-nr 'a (b2r-p 'a 'h (list '+ m m)))
                              (list '* (b2r-nr 'a (b2r-p 'a 'h m)) (b2r-nr 'a (b2r-p 'a 'h m)))))
                 (subst (list '= (b2r-nr 'a (b2r-p 'a 'h m)) (list 'RPOW-STAR b2r-r m)))
                 (subst (list '= (list 'RPOW-STAR b2r-r (list '+ m m))
                              (list '* (list 'RPOW-STAR b2r-r m) (list 'RPOW-STAR b2r-r m))))
                 (rfl))
                ((dk-head-is? g '<=) (dk-nn! (list '<= v k)))
                (#t (from-context!))))))))
(b2r-qed! 'b2r-sa-pow-frequent)

;;; ---- E. rho(h) = ||h|| ------------------------------------------------------------------------
(sp (b2r-ucsa '(FORALL h (IMPLIES (IS-SELF-ADJOINT-EL a h) (= (SPECTRAL-RADIUS a h) ((VNRM a) h))))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'a)
(b2r-sa-parts!)
(b2r-in-B! 'h)
(dk-cite! 'bcp-u-bae-vnrm-type 'a 'h)
(dk-cite! 'bcp-u-bal-uba-vnrm-nonneg 'a 'h)
(let* ((rb '(SPECTRAL-RADIUS (UIBA-AS-UBA a) h))
       (ra '(SPECTRAL-RADIUS a h)))
  (dk-split-all! (list (dk-cite! 'spectral-radius-real b2r-B 'h)))
  (dk-cite! 'b2r-spectral-radius-view 'a 'h)
  (subst (list '= ra rb))
  (use-em (list '< 0 b2r-r)
    (lambda ()
      (let* ((conv (dk-cite! 'spectral-radius-limit b2r-B 'h))
             (gb (caddr conv)))
        (dk-have! (list 'FORALL 'b2n_ (list 'IMPLIES '(IN b2n_ NN)
                    (list 'FORSOME 'b2k_ (list 'AND '(IN b2k_ NN) (list 'AND '(<= b2n_ b2k_) (list '= (list gb 'b2k_) b2r-r))))))
          (lambda ()
            (dk-peel!)
            (let* ((nv (cadr (cadr (caddr (caddr (dk-goal))))))
                   (ex (dk-cite! 'b2r-sa-pow-frequent nv 'a 'h))
                   (k (dk-skolem! ex #t))
                   (m (list 'succ k)))
              (dk-cite! 'nn-succ-closed k)
              (dk-cite! 'nn-in-rr m)
              (dk-cite! 'b2r-el-pow-view m 'a 'h)
              (dk-cite! 'bcp-ro-vnrm 'a)
              (dk-have! (list 'NOT (list '= m 0)) (lambda () (dk-nn!)))
              (b2r-cite2! 'recip-star-value m)
              (b2r-cite2! 'rr-recip-closed m)
              (b2r-cite2! 'rr-recip-inverse m)
              (b2r-cite2! 'rpow-star-pow b2r-r m (list 'recip m))
              (dk-cite! 'rpow-star-one b2r-r)
              (ew k)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) '=)
                      (begin
                        (dk-lam-b!)
                        (subst '(= (VNRM (UIBA-AS-UBA a)) (VNRM a)))
                        (subst (list '= (b2r-p b2r-B 'h m) (b2r-p 'a 'h m)))
                        (subst (list '= (b2r-nr 'a (b2r-p 'a 'h m)) (list 'RPOW-STAR b2r-r m)))
                        (subst (list '= (list 'RECIP-STAR m) (list 'recip m)))
                        (subst (list '= (list 'RPOW-STAR (list 'RPOW-STAR b2r-r m) (list 'recip m))
                                     (list 'RPOW-STAR b2r-r (list '* m (list 'recip m)))))
                        (subst (list '= (list '* m (list 'recip m)) 1))
                        (subst (list '= (list 'RPOW-STAR b2r-r 1) b2r-r))
                        (rfl))
                      (dk-ass!)))))))
        (b2r-cite2! 'rr-limit-of-frequent-value gb rb b2r-r)
        (dk-ass!)))
    (lambda ()
      (dk-have! '(IN 1 NN))
      (dk-have! '(<= 1 1) (lambda () (arith)))
      (dk-have! '(IN 0 RR))
      (b2r-cite2! 'rr-not-lt-ge 0 b2r-r)
      (dk-have! (list '= b2r-r 0) (lambda () (dk-ineq! (list '<= b2r-r 0) (list '<= 0 b2r-r) (list 'IN b2r-r 'RR))))
      (b2r-cite2! 'recip-star-value 1)
      (dk-have! '(= (recip 1) 1) (lambda () (arith)))
      (dk-have! '(< 0 1) (lambda () (arith)))
      (dk-cite! 'rpow-star-zero-base 1)
      (let* ((l0 (b2r-cite2! 'bgf-radius-le-root b2r-B 'h 1))
             (o1 (dk-cite! 'bae-el-pow-one b2r-B 'h))
             (l1 (dk-rewrite-h! l0 (b2r-p b2r-B 'h 1) 'h))
             (rv (dk-cite! 'bcp-ro-vnrm 'a))
             (l2 (dk-rewrite-h! l1 '(VNRM (UIBA-AS-UBA a)) '(VNRM a)))
             (l3 (dk-rewrite-h! l2 b2r-r 0))
             (l4 (dk-rewrite-h! l3 '(RECIP-STAR 1) '(recip 1)))
             (l5 (dk-rewrite-h! l4 '(recip 1) 1))
             (l6 (dk-rewrite-h! l5 '(RPOW-STAR 0 1) 0)))
        (dk-ineq! l6 (list '<= 0 rb) (list '= b2r-r 0) (list 'IN rb 'RR) (list 'IN b2r-r 'RR))))))
(b2r-qed! 'cstar-sa-spectral-radius)
