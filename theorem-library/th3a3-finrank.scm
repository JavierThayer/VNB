;;; th3a3-finrank.scm -- FINITE-RANK OPERATORS ARE COMPACT (th-main.pdf Example 1.60), and the
;;; finite-set form of 'a homomorphism commutes with a finite sum'.  Agent TH3-A3, wave 2026-11-09.
;;; Destination: theorem-library/th3a3-finrank.scm.  Library: operator-algebras (see the report for
;;; hom-ag-finsum, which belongs to algebra).  Helper prefix tqd-.  Every qed modulo 0.

;;; tqd helpers: copy of TH3-A2 tqb-helpers.scm (itself a copy of TH3-A tqa-helpers.scm) (scratchpad/th3-1109/a/), prefix tqd-.
;;; tqa helpers: copies of ba-bh2.scm's bb2- helpers (themselves copies of ba-bh.scm's bbh- and hilbert-projection.scm's hpr- kit), prefix tqd-.
(define tqd-v 'v)
(define (tqd-ip a b) (list (list 'IP tqd-v) a b))
(define (tqd-sub a b) (list (list 'VADD tqd-v) a (list (list 'VNEG tqd-v) b)))
(define (tqd-add a b) (list (list 'VADD tqd-v) a b))
(define (tqd-act c a) (list (list 'ACT tqd-v) c a))
(define (tqd-q a) (tqd-ip a a))

(define (tqd-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) tqd-v)))
(define (tqd-zero? e) (equal? e (list 'VZERO tqd-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (tqd-vt! e)
  (let ((goal (list 'IN e (list 'VEC tqd-v))))
    (cond ((and (dk-asm? goal) (not (or (tqd-op? e 'VADD) (tqd-op? e 'VNEG) (tqd-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((tqd-op? e 'VADD) (tqd-vt! (cadr e)) (tqd-vt! (caddr e)))
                 ((tqd-op? e 'VNEG) (tqd-vt! (cadr e)))
                 ((tqd-op? e 'ACT)  (tqd-ct! (cadr e)) (tqd-vt! (caddr e))))
           goal)
          ((tqd-op? e 'VADD) (tqd-vt! (cadr e)) (tqd-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type tqd-v (cadr e) (caddr e)) goal)
          ((tqd-op? e 'VNEG) (tqd-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type tqd-v (cadr e)) goal)
          ((tqd-op? e 'ACT)  (tqd-ct! (cadr e)) (tqd-vt! (caddr e))
                             (dk-cite! 'cips-act-type tqd-v (cadr e) (caddr e)) goal)
          ((tqd-zero? e) (dk-cite! 'cips-vzero-in tqd-v) goal)
          ((tqd-app-fun e) => (lambda (ft) (tqd-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "tqd-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (tqd-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC tqd-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (tqd-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC tqd-v)) (tqd-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((tqd-v (cadr d))) (tqd-vt! a)))
        (#t (error "tqd-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (tqd-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((tqd-op? c 'IP) (tqd-vt! (cadr c)) (tqd-vt! (caddr c))
                           (dk-cite! 'cips-ip-type tqd-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (tqd-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (tqd-ct! (cadr c)) (tqd-ct! (caddr c))
           (tqd-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (tqd-ct! (cadr c)) (tqd-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (tqd-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (tqd-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (tqd-op? e 'IP) (= (length e) 3)
              (or (tqd-compound? (cadr e)) (tqd-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqd-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (tqd-compound? e)
  (or (tqd-op? e 'VADD) (tqd-op? e 'VNEG) (tqd-op? e 'ACT) (tqd-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (tqd-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (tqd-vt! a) (tqd-vt! b)
    (cond ((tqd-op? a 'VADD) (dk-cite! 'cips-ip-add-left tqd-v (cadr a) (caddr a) b))
          ((tqd-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left tqd-v (cadr a) b))
          ((tqd-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left tqd-v (cadr a) (caddr a) b))
          ((tqd-zero? a)     (dk-cite! 'cips-ip-zero-left tqd-v b))
          ((tqd-op? b 'VADD) (dk-cite! 'cips-ip-add-right tqd-v a (cadr b) (caddr b)))
          ((tqd-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right tqd-v a (cadr b)))
          ((tqd-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right tqd-v (cadr b) a (caddr b)))
          ((tqd-zero? b)     (dk-cite! 'cips-ip-zero-right tqd-v a))
          (#t (error "tqd-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (tqd-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (tqd-op? x 'IP) (= (length x) 3))))))
(define (tqd-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((tqd-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqd-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (tqd-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "tqd-expand!: out of fuel"))
    (let ((r (tqd-find-redex (dk-goal))))
      (if r
          (let ((eq (tqd-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (tqd-find-real-conj (dk-goal))))
            (if c
                (begin
                  (tqd-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (tqd-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((tqd-op? x 'IP)
           (tqd-vt! (cadr x)) (tqd-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym tqd-v (cadr x) (caddr x))
           (subst (list '= c (tqd-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (tqd-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (tqd-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (tqd-ct! (cadr x)) (tqd-ct! (caddr x))
           (tqd-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (tqd-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (tqd-q-facts! u)
  (tqd-vt! u)
  (dk-cite! 'cips-ip-self-real tqd-v u)
  (dk-cite! 'cips-ip-self-nonneg tqd-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (tqd-norm-sq! u)
  (tqd-vt! u)
  (subst (dk-cite! 'ip-norm-unfold tqd-v u))
  (tqd-q-facts! u)
  (tqd-sqrt! (tqd-q u))
  (subst (dk-cite! 'sqrt-sq (tqd-q u))))
(define (tqd-nsq u) (list '* (list 'IP-NORM tqd-v u) (list 'IP-NORM tqd-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (tqd-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (tqd-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (tqd-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (tqd-and (cdr fs)))))
(define (tqd-have-and! . fs)
  (let ((c (tqd-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (tqd-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((tqd-op? e 'IP) (tqd-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (tqd-ct! e))
        (#t (for-each tqd-type-ips! e))))

(define (tqd-qd p xi) (tqd-q (tqd-sub p xi)))
(define (tqd-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (tqd-vt! a) (tqd-vt! b)
          (dk-have! (list '= (tqd-qd a b) 0)
            (lambda () (tqd-expand!) (tqd-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero tqd-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (tqd-q-eq! a b)
  (let ((goal (list '= (tqd-q a) (tqd-q b))))
    (if (not (dk-asm? goal))
        (begin (tqd-vt! a) (tqd-vt! b)
               (dk-have! goal (lambda () (tqd-expand!) (tqd-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (tqd-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** TQD: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "TQD: unfinished" name
               (map (lambda (l) (expression->string (dk-goal-of l))) (dk-open-leaves))
               (map expression->string (dk-asms-of (car (dk-open-leaves))))))))
;;; dump the focus leaf (debugging)
(define (tqd-show! tag)
  (display "\n--- TQD ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (tqd-sub! ks x)
  (dk-cite! 'submodule-subset tqd-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC tqd-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (tqd-scal! c)
  (dk-cite! 'cips-scal-carrier tqd-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL tqd-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL tqd-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix tqd-) -----------------------------------------------
(define tqd-w 'w)
(define (tqd-n u) (list 'IP-NORM tqd-v u))
(define (tqd-ipv a b) (list '(IP v) a b))
(define (tqd-ipw a b) (list '(IP w) a b))
(define (tqd-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (tqd-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (tqd-prods e)
  (cond ((tqd-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map tqd-prods (cdr e)))
        (#t '())))
(define (tqd-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (tqd-prod? (cadr p)) (tqd-mul-type! (cadr p)))
        (if (tqd-prod? (caddr p)) (tqd-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (tqd-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (tqd-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map tqd-prods prems) (tqd-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (tqd-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (tqd-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (tqd-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (tqd-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))
;;; debugging: dump every open leaf (goal + context)
(define (tqd-dump! tag)
  (display "\n=== TQD DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
;;; run THUNK; on an error print the condition and dump, then re-raise
(define (tqd-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (display "\n*** TQD ERROR in ") (display tag) (display ": ")
          (display (if (condition? e) (condition/report-string e) e)) (newline)
          (tqd-dump! tag)
          (k (error "TQD stop" tag (if (condition? e) (condition/report-string e) e)
                    (if (pair? (dk-open-leaves)) (expression->string (dk-goal)) "no open leaf"))))
        thunk))))

;;; ---- TH3-A2 additions ----------------------------------------------------------------------
;;; the focus goal is (= a a) / (== a a)
(define (tqd-trivial-goal?)
  (and (pair? (dk-open-leaves))
       (let ((g (dk-goal)))
         (and (pair? g) (memq (car g) '(= ==)) (= (length g) 3) (equal? (cadr g) (caddr g))))))
(define (tqd-rfl-trivial!) (if (tqd-trivial-goal?) (rfl)))
;;; ==========================================================================================
;;; (C1) A HOMOMORPHISM OF ABELIAN GROUPS COMMUTES WITH A FINITE SUM over any finite set
;;; (the finite-set form of hom-ag-finsum-interval, gal-ch.scm).  Library: algebra.
;;; Proof: finite-set induction (finite-set-induction) on the class of the s for which the
;;; statement holds, f and g fixed; the step is finsum-insert-ptwise on both sides.
;;; ==========================================================================================

(define (tqd-hf a1 f s) `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,s) (IN (,f tqdz_) (CARR ,a1)))))
(define (tqd-hg h f g s) `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,s) (= (,g tqdz_) (,h (,f tqdz_))))))
(define (tqd-hc a1 a2 h f g s) `(= (,h (FINSUM ,a1 ,f ,s)) (FINSUM ,a2 ,g ,s)))
(define (tqd-hp a1 a2 h f g s)
  `(IMPLIES ,(tqd-hf a1 f s) (IMPLIES ,(tqd-hg h f g s) ,(tqd-hc a1 a2 h f g s))))

;;; hom-ag-finsum
(sp (make-wff `(FORALL a1 (FORALL a2 (FORALL h (IMPLIES (IS-HOM-ABELIAN-GROUP a1 a2 h)
   (FORALL s (IMPLIES (IN s SET) (IMPLIES (IN (CARD s) NN)
     (FORALL f (FORALL g ,(tqd-hp 'a1 'a2 'h 'f 'g 's))))))))))))
(tqd-try "c1" (lambda ()
(dk-peel!)
(let* ((goal (dk-goal))
       (h (car (cadr goal)))
       (a1 (cadr (cadr (cadr goal))))
       (f (caddr (cadr (cadr goal))))
       (s0 (cadddr (cadr (cadr goal))))
       (a2 (cadr (caddr goal)))
       (g (caddr (caddr goal)))
       (hp (lambda (s) (tqd-hp a1 a2 h f g s)))
       (c `(COMP tqds_ ,(hp 'tqds_)))
       (stepf `(FORALL is_ (IMPLIES (AND (IN is_ SET) (AND (IN (CARD is_) NN) (IN is_ ,c)))
                  (FORALL ix_ (IMPLIES (AND (IN ix_ SET) (NOT (IN ix_ is_))) (IN (UNION is_ (PAIR ix_ ix_)) ,c)))))))
  (tqd-iff-fwd! 'is-hom-abelian-group-def a1 a2 h)
  (let ((hopr (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x (list 'OPR a1)))) "the opr clause")))
    ;; base: the empty sums are the identities
    (dk-have! `(IN EMPTY-SET ,c)
      (lambda () (tqd-try "base" (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(IN EMPTY-SET SET))
                (begin (fact 'empty-set-is-set) (dk-ass!))
                (begin
                  (dk-peel!)
                  (subst (dk-cite! 'finsum-empty a1 f))
                  (subst (dk-cite! 'finsum-empty a2 g))
                  (dk-ass!))))
          (dk-opened (lambda () (comp-mi))))))))
    ;; step: insert a point
    (dk-have! stepf
      (lambda () (tqd-try "step" (lambda ()
        (let* ((landed (dk-peel!)) (gl (dk-goal)) (u (cadr gl)) (sv (cadr u)) (xv (cadr (caddr u))))
          (dk-split-all! landed)
          (tqd-have-and! `(IN ,xv SET) `(IN ,xv SET))
          (fact 'pairing xv xv)
          (tqd-have-and! `(IN ,sv SET) `(IN (PAIR ,xv ,xv) SET))
          (fact 'union-set-closure sv `(PAIR ,xv ,xv))
          (let* ((ls (tqd-try "comp-me" (lambda () (dk-landed (lambda () (comp-me `(IN ,sv ,c)))))))
                 (ih (tqd-try "find-ih" (lambda () (find-first (lambda (x) (dk-head-is? x 'IMPLIES)) ls)))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) `(IN ,u SET))
                    (dk-ass!)
                    (begin
                      (dk-peel!)
                      (let ((hfu (tqd-hf a1 f u)) (hgu (tqd-hg h f g u))
                            (in-u! (lambda (z)
                                     (dk-have! `(IN ,z ,u) (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))))
                        ;; the hypotheses restricted to sv
                        (dk-have! (tqd-hf a1 f sv)
                          (lambda () (let ((z (cadr (car (dk-peel!)))))
                                       (in-u! z) (dk-apply! hfu z) (dk-ass!))))
                        (dk-have! (tqd-hg h f g sv)
                          (lambda () (let ((z (cadr (car (dk-peel!)))))
                                       (in-u! z) (dk-apply! hgu z) (dk-ass!))))
                        (let* ((ih2 (detach! ih)))
                          (detach! `(IMPLIES ,(tqd-hg h f g sv) ,(tqd-hc a1 a2 h f g sv))))
                        ;; the new point
                        (dk-cite! 'pair-self-member xv)
                        (dk-have! `(IN ,xv ,u) (lambda () (mac 'union-membership) (oi-r) (dk-ass!)))
                        (dk-apply! hfu xv)
                        (dk-apply! hgu xv)
                        (let ((fs1 `(FINSUM ,a1 ,f ,sv)) (fs2 `(FINSUM ,a2 ,g ,sv)) (fx `(,f ,xv)))
                          (dk-cite! 'finsum-type-ptwise a1 sv f)
                          ;; g typed pointwise on u and on sv
                          (for-each
                            (lambda (w hgw)
                              (dk-have! `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,w) (IN (,g tqdz_) (CARR ,a2))))
                                (lambda ()
                                  (let ((z (cadr (car (dk-peel!)))))
                                    (dk-apply! (tqd-hf a1 f w) z)
                                    (dk-apply! hgw z)
                                    (dk-cite! 'fun-apply-type-c h `(CARR ,a1) `(CARR ,a2) `(,f ,z))
                                    (subst `(= (,g ,z) (,h (,f ,z))))
                                    (dk-ass!)))))
                            (list u sv) (list hgu (tqd-hg h f g sv)))
                          (dk-cite! 'finsum-type-ptwise a2 sv g)
                          (subst (dk-cite! 'finsum-insert-ptwise a1 sv xv f))
                          (subst (dk-apply! hopr fs1 fx))
                          (subst `(= (,h ,fs1) ,fs2))
                          (subst `(= (,h ,fx) (,g ,xv)))
                          (subst (dk-cite! 'finsum-insert-ptwise a2 sv xv g))
                          (dk-close-if! (lambda () #t) (lambda () (rfl))))))))
              (tqd-try "step-comp-mi" (lambda () (dk-opened (lambda () (comp-mi))))))))))))
    (tqd-have-and! `(IN EMPTY-SET ,c) stepf)
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (tqd-have-and! `(IN ,s0 SET) `(IN (CARD ,s0) NN))
      (let* ((inx (dk-apply! ind s0))
             (ls (dk-landed (lambda () (comp-me inx))))
             (p (find-first (lambda (x) (dk-head-is? x 'IMPLIES)) ls)))
        (detach! p)
        (detach! `(IMPLIES ,(tqd-hg h f g s0) ,(tqd-hc a1 a2 h f g s0)))
        (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))))
(tqd-qed! 'hom-ag-finsum)
;;; ==========================================================================================
;;; (C2) EVALUATION AT x IS A HOMOMORPHISM from the group of bounded operators to the vector
;;; group of w; hence a FINSUM of operators applied at x is the FINSUM of their values.
;;; Library: operator-algebras.
;;; ==========================================================================================

(define tqd-G  '(BOP-NORMED-AG v w))
(define tqd-BG '(NORMED-AG-AS-ABELIAN-GROUP (BOP-NORMED-AG v w)))
(define tqd-H  '(IP-NORMED-AG w))
(define tqd-WG '(NORMED-AG-AS-ABELIAN-GROUP (IP-NORMED-AG w)))
(define (tqd-ev x) (list 'VNB-LAMBDA 'tqdt_ '(BOUNDED-OPS v w) (list 'tqdt_ x)))

;;; (== (ACC (VIEW G)) (ACC G)): the view read-off (hilbert-onb.scm's onb-slot-close! device)
(define (tqd-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
;;; land (== (ACC (NORMED-AG-AS-ABELIAN-GROUP G)) VAL) from the source read-off (== (ACC G) VAL)
(define (tqd-view-eq! acc g val src-eq)
  (let* ((vg (list 'NORMED-AG-AS-ABELIAN-GROUP g))
         (e1 (list '== (list acc vg) (list acc g)))
         (claim (list '== (list acc vg) val)))
    (if (not (dk-asm? claim))
        (begin
          (if (not (dk-asm? e1)) (dk-have! e1 (lambda () (tqd-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc))))
          (dk-have! claim (lambda () (subst e1) (subst src-eq) (dk-close-if! (lambda () #t) (lambda () (qrfl)))))))
    claim))
;;; with v, w complex inner product spaces in context: both groups, and their read-offs
(define (tqd-ag-setup!)
  (dk-cite! 'bop-normed-ag-is-normed-ag 'v 'w)
  (dk-cite! 'ip-normed-ag-is-normed-ag 'w)
  (dk-cite! 'normed-ag-as-abelian-group-is-abelian-group tqd-G)
  (dk-cite! 'normed-ag-as-abelian-group-is-abelian-group tqd-H)
  (dk-cite! 'bounded-ops-is-set 'v 'w)
  (dk-cite! 'bop-zero-bounded 'v 'w)
  (tqd-view-eq! 'CARR tqd-G '(BOUNDED-OPS v w) (dk-cite! 'bop-nag-carr 'v 'w))
  (tqd-view-eq! 'OPR  tqd-G '(BOP-VADD v w)    (dk-cite! 'bop-nag-opr 'v 'w))
  (tqd-view-eq! 'IDEN tqd-G '(BOP-ZERO v w)    (dk-cite! 'bop-nag-iden 'v 'w))
  (tqd-view-eq! 'INV  tqd-G '(BOP-VINV v w)    (dk-cite! 'bop-nag-inv 'v 'w))
  (tqd-view-eq! 'CARR tqd-H '(VEC w)  (dk-cite! 'ip-normed-ag-carrier 'w))
  (tqd-view-eq! 'OPR  tqd-H '(VADD w) (dk-cite! 'ip-normed-ag-opr 'w))
  (dk-have! '(== (IDEN (IP-NORMED-AG w)) (VZERO w))
    (lambda () (mac 'IP-NORMED-AG) (slot 'IDEN) (nth-r) (dk-close-if! (lambda () #t) (lambda () (qrfl)))))
  (tqd-view-eq! 'IDEN tqd-H '(VZERO w) '(== (IDEN (IP-NORMED-AG w)) (VZERO w)))
  (tqd-view-eq! 'INV  tqd-H '(VNEG w) (dk-cite! 'ip-normed-ag-inv 'w)))

;;; t in CARR(BG) in context: land t in BOUNDED-OPS(v, w) and t in FUN(VEC v, VEC w)
(define (tqd-bo! t)
  (if (not (dk-asm? (list 'IN t '(BOUNDED-OPS v w))))
      (dk-rewrite-h! (list 'IN t (list 'CARR tqd-BG)) (list 'CARR tqd-BG) '(BOUNDED-OPS v w)))
  (dk-cite! 'bop-fun 'v 'w t))

;;; eval-op-hom
(sp (make-wff (forall-guarded '(v w x_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN x_ (VEC v)))
  (list 'IS-HOM-ABELIAN-GROUP tqd-BG tqd-WG (tqd-ev 'x_)))))
(dk-peel!)
(tqd-ag-setup!)
(let* ((ev (tqd-ev 'x_))
       (iff (dk-cite! 'is-hom-abelian-group-def tqd-BG tqd-WG ev))
       (app-t! (lambda (t) (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) 'x_)))
       (fin! (lambda () (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (rfl))))))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-head-is? g 'IS-ABELIAN-GROUP) (dk-ass!))
              ((dk-head-is? g 'IN)
               (subst (list '== (list 'CARR tqd-BG) '(BOUNDED-OPS v w)))
               (subst (list '== (list 'CARR tqd-WG) '(VEC w)))
               (dk-lam-type!
                 (lambda () (let ((t (dk-di-var!)))
                              (dk-cite! 'bop-fun 'v 'w t) (app-t! t) (dk-close-if-asm!)))
                 (lambda () (dk-close-if-asm!))))
              ((dk-head-is? g '=)
               (subst (list '== (list 'IDEN tqd-BG) '(BOP-ZERO v w)))
               (subst (list '== (list 'IDEN tqd-WG) '(VZERO w)))
               (dk-cite! 'cips-vzero-in 'w)
               (dk-lam-b!)
               (subst (dk-cite! 'bop-zero-apply 'v 'w 'x_))
               (dk-close-if! (lambda () #t) (lambda () (rfl))))
              ((dk-contains? g (list 'OPR tqd-BG))
               (let* ((lk (dk-peel!))
                      (gg (dk-goal))
                      (ts (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'CARR tqd-BG)))) lk)))
                      (s1 (car ts)) (t1 (cadr ts)))
                 (tqd-bo! s1) (tqd-bo! t1)
                 (app-t! s1) (app-t! t1)
                 (subst (list '== (list 'OPR tqd-BG) '(BOP-VADD v w)))
                 (subst (list '== (list 'OPR tqd-WG) '(VADD w)))
                 (subst (dk-cite! 'bop-vadd-value 'v 'w s1 t1))
                 (dk-cite! 'bop-sum-bounded 'v 'w s1 t1)
                 (dk-lam-b!)
                 (subst (dk-cite! 'bop-sum-apply 'v 'w s1 t1 'x_))
                 (dk-cite! 'cips-vadd-type 'w (list s1 'x_) (list t1 'x_))
                 (dk-close-if! (lambda () #t) (lambda () (rfl)))))
              (#t
               (let* ((lk (dk-peel!))
                      (t1 (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'CARR tqd-BG)))) lk))))
                 (tqd-bo! t1)
                 (app-t! t1)
                 (subst (list '== (list 'INV tqd-BG) '(BOP-VINV v w)))
                 (subst (list '== (list 'INV tqd-WG) '(VNEG w)))
                 (subst (dk-cite! 'bop-vinv-value 'v 'w t1))
                 (dk-cite! 'bop-neg-bounded 'v 'w t1)
                 (dk-lam-b!)
                 (subst (dk-cite! 'bop-neg-apply 'v 'w t1 'x_))
                 (dk-cite! 'cips-vneg-type 'w (list t1 'x_))
                 (dk-close-if! (lambda () #t) (lambda () (rfl)))))))))))
  (tqd-iff-bwd! 'is-hom-abelian-group-def tqd-BG tqd-WG ev)
  (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
(tqd-qed! 'eval-op-hom)

;;; op-finsum-apply: (sum_k F_k)(x) = sum_k F_k(x), F a finite family of bounded operators
(sp (make-wff (forall-guarded '(v w fis_ fop_ x_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN fis_ SET) (IN (CARD fis_) NN)
    (FORALL tqdy_ (IMPLIES (IN tqdy_ fis_) (IN (fop_ tqdy_) (BOUNDED-OPS v w))))
    (IN x_ (VEC v)))
  (list '= (list (list 'FINSUM tqd-BG 'fop_ 'fis_) 'x_)
           (list 'FINSUM tqd-WG '(VNB-LAMBDA tqdk_ fis_ ((fop_ tqdk_) x_)) 'fis_)))))
(dk-peel!)
(tqd-ag-setup!)
(let* ((goal (dk-goal))
       (fs (car (cadr goal)))
       (x (cadr (cadr goal)))
       (fo (caddr fs))
       (s (cadddr fs))
       (g (caddr (caddr goal)))
       (ev (tqd-ev x))
       (hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h fo) (dk-contains? h 'BOUNDED-OPS))) "the typing"))
       (hf `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,s) (IN (,fo tqdz_) (CARR ,tqd-BG)))))
       (hg `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,s) (= (,g tqdz_) (,ev (,fo tqdz_)))))))
  (dk-cite! 'eval-op-hom 'v 'w x)
  (dk-have! hf
    (lambda () (let ((z (cadr (car (dk-peel!)))))
                 (dk-apply! hyp z)
                 (subst (list '== (list 'CARR tqd-BG) '(BOUNDED-OPS v w)))
                 (dk-ass!))))
  (dk-have! hg
    (lambda () (let ((z (cadr (car (dk-peel!)))))
                 (dk-apply! hyp z)
                 (dk-cite! 'bop-fun 'v 'w (list fo z))
                 (dk-cite! 'fun-apply-type-c (list fo z) '(VEC v) '(VEC w) x)
                 (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (rfl))))))
  (let ((e (dk-cite! 'hom-ag-finsum tqd-BG tqd-WG ev s fo g)))
    (dk-cite! 'finsum-type-ptwise tqd-BG s fo)
    (tqd-bo! fs)
    (dk-cite! 'fun-apply-type-c fs '(VEC v) '(VEC w) x)
    (subst (list '= (caddr e) (cadr e)))
    (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (rfl)))))
(tqd-qed! 'op-finsum-apply)
;;; ==========================================================================================
;;; (C3) FINITE-RANK OPERATORS ARE COMPACT (Example 1.60).  Library: operator-algebras.
;;; T x = sum_k <x | a_k> b_k is the FINSUM, in the group of bounded operators, of the
;;; rank-one operators R_k evaluated at x (op-finsum-apply); that FINSUM lies in K(v, w) by
;;; finsum-in-subset (K(v, w) holds 0 and is closed under +); T is that FINSUM by function
;;; extensionality.  The finite-set induction is the one inside finsum-in-subset.
;;; ==========================================================================================

;;; bop-zero-compact: the zero operator is compact (it is the rank-one operator <. | 0> 0)
(sp (make-wff (forall-guarded '(v w)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w))
  '(IS-COMPACT-OP v w (BOP-ZERO v w)))))
(dk-peel!)
(let ((r0 '(RANK-ONE-OP v w (VZERO v) (VZERO w))))
  (dk-cite! 'cips-vzero-in 'v)
  (dk-cite! 'cips-vzero-in 'w)
  (dk-cite! 'rank-one-op-compact 'v 'w '(VZERO v) '(VZERO w))
  (dk-cite! 'bop-zero-bounded 'v 'w)
  (dk-fun-ext! '(BOP-ZERO v w) r0 '(VEC v) '(VEC w)
    (lambda () (dk-cite! 'bop-fun 'v 'w '(BOP-ZERO v w)) (dk-close-if-asm!))
    (lambda () (dk-cite! 'rank-one-op-fun 'v 'w '(VZERO v) '(VZERO w)) (dk-close-if-asm!))
    (lambda (y)
      (subst (dk-cite! 'bop-zero-apply 'v 'w y))
      (subst (dk-cite! 'rank-one-op-apply 'v 'w '(VZERO v) '(VZERO w) y))
      (let ((c (list '(IP v) y '(VZERO v))))
        (dk-cite! 'cips-ip-type 'v y '(VZERO v))
        (fluid-let ((tqd-v 'w))
          (tqd-vec-eq! '(VZERO w) (list '(ACT w) c '(VZERO w))))
        (dk-close-if-asm!))))
  (subst (list '= '(BOP-ZERO v w) r0))
  (dk-close-if-asm!))
(tqd-qed! 'bop-zero-compact)

;;; finite-rank-op-compact
(sp (make-wff (forall-guarded '(v w t_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IS-FINITE-RANK-OP v w t_))
  '(IS-COMPACT-OP v w t_))))
(dk-peel!)
(tqd-ag-setup!)
(tqd-try "frk" (lambda ()
(tqd-iff-fwd! 'is-finite-rank-op 'v 'w 't_)
(let* ((ex1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 't_))) "the index set"))
       (ii (dk-skolem! ex1))
       (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 't_))) "the a family"))
       (aa (dk-skolem! ex2))
       (ex3 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 't_))) "the b family"))
       (bb (dk-skolem! ex3))
       (tform (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 't_) (dk-contains? h 'FINSUM))) "the formula"))
       (sm '(COMPACT-OPS v w))
       (rr1 (lambda (z) (list 'RANK-ONE-OP 'v 'w (list aa z) (list bb z))))
       (R (list 'VNB-LAMBDA 'tqdr_ ii (rr1 'tqdr_)))
       (S (list 'FINSUM tqd-BG R ii))
       (ab! (lambda (z)
              (dk-cite! 'fun-apply-type-c aa ii '(VEC v) z)
              (dk-cite! 'fun-apply-type-c bb ii '(VEC w) z))))
  ;; R_z is bounded and compact
  (dk-have! `(FORALL tqdy_ (IMPLIES (IN tqdy_ ,ii) (IN (,R tqdy_) (BOUNDED-OPS v w))))
    (lambda () (let ((z (cadr (car (dk-peel!)))))
                 (ab! z)
                 (dk-cite! 'rank-one-op-bounded 'v 'w (list aa z) (list bb z))
                 (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (dk-close-if-asm!))))))
  (dk-have! `(FORALL tqdy_ (IMPLIES (IN tqdy_ ,ii) (IN (,R tqdy_) ,sm)))
    (lambda () (let ((z (cadr (car (dk-peel!)))))
                 (ab! z)
                 (dk-cite! 'rank-one-op-bounded 'v 'w (list aa z) (list bb z))
                 (dk-cite! 'rank-one-op-compact 'v 'w (list aa z) (list bb z))
                 (dk-lam-b!)
                 (tqd-iff-bwd! 'compact-ops-membership 'v 'w (rr1 z))
                 (dk-close-if-asm!))))
  (dk-have! (list 'IN R (list 'FUN ii (list 'CARR tqd-BG)))
    (lambda ()
      (subst (list '== (list 'CARR tqd-BG) '(BOUNDED-OPS v w)))
      (dk-lam-type!
        (lambda () (let ((z (dk-di-var!)))
                     (ab! z)
                     (dk-cite! 'rank-one-op-bounded 'v 'w (list aa z) (list bb z))
                     (dk-close-if-asm!)))
        (lambda () (dk-close-if-asm!)))))
  ;; K(v, w) holds 0 and is closed under +
  (dk-have! (list 'IN (list 'IDEN tqd-BG) sm)
    (lambda ()
      (subst (list '== (list 'IDEN tqd-BG) '(BOP-ZERO v w)))
      (dk-cite! 'bop-zero-compact 'v 'w)
      (tqd-iff-bwd! 'compact-ops-membership 'v 'w '(BOP-ZERO v w))
      (dk-close-if-asm!)))
  (dk-have! `(FORALL tqdp_ (IMPLIES (IN tqdp_ ,sm) (FORALL tqdq_ (IMPLIES (IN tqdq_ ,sm) (IN ((OPR ,tqd-BG) tqdp_ tqdq_) ,sm)))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (ps (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) sm))) lk)))
             (p (car ps)) (q (cadr ps)))
        (tqd-iff-fwd! 'compact-ops-membership 'v 'w p)
        (tqd-iff-fwd! 'compact-ops-membership 'v 'w q)
        (subst (list '== (list 'OPR tqd-BG) '(BOP-VADD v w)))
        (subst (dk-cite! 'bop-vadd-value 'v 'w p q))
        (dk-cite! 'bop-sum-bounded 'v 'w p q)
        (dk-cite! 'compact-op-sum 'v 'w p q)
        (tqd-iff-bwd! 'compact-ops-membership 'v 'w (list 'BOP-SUM 'v 'w p q))
        (dk-close-if-asm!))))
  ;; the FINSUM S of the R_k is compact
  (dk-apply! (dk-cite! 'finsum-in-subset tqd-BG) sm ii R)
  (tqd-iff-fwd! 'compact-ops-membership 'v 'w S)
  (dk-cite! 'bop-fun 'v 'w S)
  (dk-cite! 'bop-fun 'v 'w 't_)
  ;; t_ = S, pointwise
  (dk-fun-ext! 't_ S '(VEC v) '(VEC w) #f #f
    (lambda (y)
      (let* ((e1 (dk-apply! tform y))
             (ly (caddr (caddr e1))))
        (subst e1)
        (dk-cite! 'fun-apply-type-c S '(VEC v) '(VEC w) y)
        (let* ((e2 (dk-cite! 'op-finsum-apply 'v 'w ii R y))
               (my (caddr (caddr e2))))
          (subst (list '= (cadr e2) (caddr e2)))
          (dk-have! `(FORALL tqdz_ (IMPLIES (IN tqdz_ ,ii) (= (,ly tqdz_) (,my tqdz_))))
            (lambda ()
              (let ((z (cadr (car (dk-peel!)))))
                (ab! z)
                (dk-cite! 'cips-ip-type 'v y (list aa z))
                (dk-cite! 'cips-act-type 'w (list '(IP v) y (list aa z)) (list bb z))
                (dk-cite! 'rank-one-op-fun 'v 'w (list aa z) (list bb z))
                (dk-cite! 'fun-apply-type-c (rr1 z) '(VEC v) '(VEC w) y)
                (dk-lam-b!)
                (subst (dk-cite! 'rank-one-op-apply 'v 'w (list aa z) (list bb z) y))
                (dk-close-if! (lambda () #t) (lambda () (rfl))))))
