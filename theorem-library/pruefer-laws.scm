(let* ((rn '(recip n))
       (w `(* ,PR-2PI (* j ,rn)))
       (r `(* (* j m) ,rn))
       (jm '(* j m)))
  (pr-rr-term! '(* j (recip n))) (dkd-cc! w)
  (pr-rr-term! r) (pr-zz! jm)
  (dk-cite! 'pc-e-unit r)
  (let ((ep (dk-cite! 'exp-power-nn 'm w)))
    (dk-have! `(= (power (cc-exp ,w) m) (cc-exp (* ,PR-2PI ,r)))
      (lambda ()
        (subst ep)
        (subst (have-f! `(= (* m ,w) (* ,PR-2PI ,r)) (lambda () (dk-crs-opaque!))))
        (rfl))))
  (subst `(= (power (cc-exp ,w) m) (cc-exp (* ,PR-2PI ,r))))
  (dk-iff! (lambda (g) (dk-head-is? g 'ZZ-DIVIDES))
    (lambda ()
      (dk-cite! 'pc-e-one-int r)
      (dk-have! `(= ,jm (* n ,r))
        (lambda ()
          (subst (have-f! `(= (* n ,r) (* ,jm (* n ,rn))) (lambda () (dk-crs-opaque!))))
          (subst `(= (* n ,rn) 1))
          (crs)))
      (pr-zdiv-intro! 'n jm r)
      (dk-close-if-asm!))
    (lambda ()
      (let ((c (pr-zdiv-open! 'n jm)))
        (pr-rr! c)
        (dk-have! `(= ,r ,c)
          (lambda ()
            (subst `(= ,jm (* n ,c)))
            (subst (have-f! `(= (* (* n ,c) ,rn) (* ,c (* n ,rn))) (lambda () (dk-crs-opaque!))))
            (subst `(= (* n ,rn) 1))
            (crs)))
        (subst `(= ,r ,c))
        (dk-cite! 'pc-e-int c)
        (dk-close-if-asm!)))))
(pr-done! 'root-power-iff)

(define PR-PRIM-BODY (lambda (z n)
  `(AND (= (power ,z ,n) 1)
        (FORALL prm_ (IMPLIES (IN prm_ NN) (IMPLIES (<= 1 prm_) (IMPLIES (< prm_ ,n) (NOT (= (power ,z prm_) 1)))))))))
(define (pr-prim-eq! n)
  (let ((eq (list '== (list 'PRIMITIVE-ROOTS n) (list 'SEP 'prz_ 'CC (PR-PRIM-BODY 'prz_ n)))))
    (pr-or-asm eq (lambda () (dk-have! eq (lambda () (mac 'PRIMITIVE-ROOTS) (qrfl)))))
    eq))

;;; j prime to n: e(j/n) is a primitive n-th root of unity
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (FORALL j (IMPLIES (IN j ZZ) (IMPLIES (ZZ-COPRIME j n)
  (IN ,(pr-e 'j 'n) (PRIMITIVE-ROOTS n))))))))))
(dk-peel!)
(pr-n-setup! 'n)
(pr-zz! 'j)
(subst (pr-prim-eq! 'n))
(in-sep!
  (lambda () (dkd-cc! (pr-e 'j 'n)) (dk-close-if-asm!))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) '=)
            (begin
              (dk-cite! 'pz-dvd-refl 'n)
              (dk-cite! 'zz-divides-mul-right 'n 'n 'j)
              (pr-zz! '(* j n))
              (dk-have! '(ZZ-DIVIDES n (* j n)) (lambda () (subst (have-f! '(= (* j n) (* n j)) (lambda () (crs)))) (dk-close-if-asm!)))
              (dk-meta-iff-l! (dk-cite! 'root-power-iff 'n 'j 'n))
              (dk-close-if-asm!))
            (let* ((lk (dk-peel!))
                   (m (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
              (di)
              (pr-zz! m) (pr-rr! m)
              (dk-meta-iff-r! (dk-cite! 'root-power-iff 'n 'j m))
              (let* ((bz (dk-meta-iff-r! (dk-cite! 'zz-coprime-bezout 'j 'n)))
                     (bx (dk-skolem! bz))
                     (by (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) (dk-asms))))
                     (be (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) 1) (dk-contains? f bx))) (dk-asms)))
                     (bym (list '* by m)))
                (pr-zz! bym)
                (pr-zz! (list '* 'j m))
                (dk-cite! 'pz-dvd-refl 'n)
                (dk-cite! 'zz-divides-lincomb 'n (list '* 'j m) 'n bx bym)
                (dk-have! (list '= (list '+ (list '* bx (list '* 'j m)) (list '* bym 'n)) m)
                  (lambda ()
                    (subst (have-f! (list '= (list '+ (list '* bx (list '* 'j m)) (list '* bym 'n)) (list '* m (list '+ (list '* bx 'j) (list '* by 'n))))
                                    (lambda () (crs))))
                    (subst be)
                    (crs)))
                (dk-have! (list 'ZZ-DIVIDES 'n m)
                  (lambda () (subst (list '= m (list '+ (list '* bx (list '* 'j m)) (list '* bym 'n)))) (dk-close-if-asm!)))
                (dk-cite! 'zz-divides-le-pos 'n m)
                (dk-absurd! (list '<= 'n m) (list '< m 'n)))))))))
(pr-done! 'coprime-root-primitive)

(define (pr-prim-open! z n)              ; (IN z (PRIMITIVE-ROOTS n)) in context: land z in CC, z^n = 1 and the minimality
  (let* ((eq (pr-prim-eq! n))
         (m1 (dk-rewrite-h! (list 'IN z (list 'PRIMITIVE-ROOTS n)) (list 'PRIMITIVE-ROOTS n) (caddr eq)))
         (body (dk-sep-parts! m1)))
    (vnb-guard (lambda () (dk-split-all! (list (dk-ctx-form body)))))
    body))

;;; a primitive root e(j/n) has j prime to n
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (FORALL j (IMPLIES (IN j ZZ) (IMPLIES (IN ,(pr-e 'j 'n) (PRIMITIVE-ROOTS n))
  (ZZ-COPRIME j n)))))))))
(dk-peel!)
(pr-n-setup! 'n)
(pr-zz! 'j) (pr-rr! 'j)
(pr-prim-open! (pr-e 'j 'n) 'n)
(let ((minf (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (pr-has-head? 'power f))) (dk-asms))))
  (dk-have-cases! '(ZZ-COPRIME j n) '(ZZ-COPRIME j n)
    (lambda () (dk-close-if-asm!))
    (lambda ()
      (let* ((g (dk-skolem! (dk-cite! 'zz-gcd-pos-exists 'j 'n)))
             (gg (find-first (lambda (f) (dk-head-is? f 'ZZ-IS-GCD)) (dk-asms))))
        (pr-zz! g) (pr-rr! g)
        (dk-have! (list 'NOT (list '= 1 g))
          (lambda ()
            (di)
            (let ((g1 (dk-rewrite-h! gg g 1)))
              (dk-meta-iff-l! (dk-cite! 'zz-coprime 'j 'n))
              (ai (dk-ctx-form '(NOT (ZZ-COPRIME j n)))))))
        (dk-have-and! (list '<= 1 g) (list 'NOT (list '= 1 g)))
        (dk-cite! 'rr-le-ne-lt 1 g)
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'zz-is-gcd 'j 'n g))))
        (let* ((q (pr-zdiv-open! g 'n))
               (nq (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'n) (dk-contains? f q))) (dk-asms)))
               (jj (pr-zdiv-open! g 'j))
               (jq (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'j) (dk-contains? f jj))) (dk-asms)))
               (rg (list 'recip g)))
          (pr-rr! q) (pr-rr! jj)
          (dk-have! (list 'NOT (list '= g 0)) (lambda () (di) (dk-absurd! (list '< 1 g) (list '= g 0))))
          (dk-have-and! (list 'IN g 'RR) (list 'NOT (list '= g 0)))
          (dk-cite! 'rr-recip-closed g)
          (dk-cite! 'rr-recip-inverse g)
          (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
          (dk-cite! 'rr-recip-pos g)
          (dk-have! '(< 0 n) (lambda () (dk-ineq! '(<= 1 n))))
          (dk-cite! 'rr-mul-pos 'n rg)
          ;; q = n / g > 0, so 1 <= q
          (dk-have! (list '= q (list '* 'n rg))
            (lambda ()
              (subst nq)
              (subst (have-f! (list '= (list '* (list '* g q) rg) (list '* q (list '* g rg))) (lambda () (dk-crs-opaque!))))
              (subst (list '= (list '* g rg) 1))
              (crs)))
          (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list '* 'n rg))) (dk-close-if-asm!)))
          (dk-cite! 'zz-lt-succ-le 0 q)
          (dk-have! (list '<= 1 q) (lambda () (dk-ineq! (list '<= '(+ 0 1) q))))
          ;; q < n, since n - q = q (g - 1) > 0
          (let* ((gm (list '+ g '(- 1)))
                 (pq (list '* q gm)))
            (pr-rr-term! gm)
            (dk-have! (list '< 0 gm) (lambda () (dk-ineq! (list '< 1 g))))
            (dk-cite! 'rr-mul-pos q gm)
            (pr-rr-term! pq)
            (let ((v (dk-name! pq)))
              (dk-have! (list '= pq (list '+ 'n (list '- q)))
                (lambda () (subst nq) (crs)))
              (dk-have! (list '< q 'n)
                (lambda () (dk-ineq! (list '< 0 pq) (list '= pq (list '+ 'n (list '- q))) (list '= v pq) (list 'IN v 'RR))))))
          (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '<= 1 q))))
          (dk-cite! 'zz-nonneg-in-nn q)
          ;; e(j/n)^q = 1, since j q = jj n
          (pr-zz! (list '* 'j q))
          (dk-have! (list '= (list '* 'j q) (list '* 'n jj))
            (lambda () (subst jq) (subst nq) (crs)))
          (pr-zdiv-intro! 'n (list '* 'j q) jj)
          (dk-meta-iff-l! (dk-cite! 'root-power-iff 'n 'j q))
          (ai (dk-apply! (dk-ctx-form minf) q))))))
  (dk-close-if-asm!))
(pr-done! 'primitive-root-coprime)

;;; every n-th root of unity is e(r/n) for some r in {1, ..., n}
(define (pr-ccexp-cc! t)                 ; cc-exp(2 pi i t), t real: land it in CC
  (dk-cite! 'pc-e-unit t)
  (pr-or-asm (list 'IN (list 'cc-exp (list '* PR-2PI t)) 'CC)
    (lambda () (dk-iff-fwd! (dk-cite! 'unit-circle-membership (list 'cc-exp (list '* PR-2PI t)))))))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (FORALL z (IMPLIES (IN z CC) (IMPLIES (= (power z n) 1)
  (FORSOME r (AND (IN r (INTERVAL 1 n)) (= z ,(pr-e 'r 'n))))))))))))
(dk-peel!)
(pr-n-setup! 'n)
(let ((pw (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) '(power z n)))) (dk-asms))))
  (dk-have! '(NOT (= z 0))
    (lambda ()
      (let* ((z0 (car (dk-landed (lambda () (di)))))
             (zs (dk-cite! 'nn-zero-or-succ 'n)))
        (dk-or-each! zs
          (lambda (d)
            (if (equal? (caddr d) 0)
                (dk-absurd! '(<= 1 n) d)
                (let* ((q (dk-skolem! d))
                       (qe (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'n) (dk-head-is? (caddr f) 'succ))) (dk-asms)))
                       (p1 (dk-rewrite-h! pw 'z 0))
                       (p2 (dk-rewrite-h! p1 'n (caddr qe)))
                       (zb (dk-cite! 'power-zero-base (cadr (caddr qe))))
                       (p3 (dk-rewrite-h! p2 (list 'power 0 (caddr qe)) 0)))
                  (dk-absurd! p3))))))))
  (let* ((wz (dk-skolem! (dk-chain-ass! (dk-cite! 'cc-exp-surjective-strip 'z))))
         (ew0 (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) 'z))) (dk-asms)))
         (nw (list '* 'n wz))
         (ep (dk-cite! 'exp-power-nn 'n wz)))
    (dkd-cc! nw)
    (dk-have! (list '= (list 'cc-exp nw) 1)
      (lambda () (subst (list '= (list 'cc-exp nw) (list 'power (list 'cc-exp wz) 'n))) (subst ew0) (dk-close-if-asm!)))
    (let* ((j (dk-skolem! (dk-meta-iff-r! (dk-cite! 'cc-exp-one-iff nw))))
           (rn '(recip n))
           (jr (list '* j rn)))
      (pr-zz! j) (pr-rr! j) (pr-rr-term! jr)
      (dkd-cc! wz)
      (dk-have! (list '= (list '* PR-2PI jr) wz)
        (lambda ()
          (subst (have-f! (list '= (list '* PR-2PI jr) (list '* rn (list '* j PR-2PI))) (lambda () (dk-crs-opaque!))))
          (subst (list '= (list '* j PR-2PI) nw))
          (subst (have-f! (list '= (list '* rn nw) (list '* (list '* 'n rn) wz)) (lambda () (dk-crs-opaque!))))
          (subst (list '= (list '* 'n rn) 1))
          (crs)))
      ;; reduce j modulo n
      (let* ((rr0 (dk-split-all! (list (dk-cite! 'zz-residue-in 'n j))))
             (r (list 'ZZ-RESIDUE j 'n))
             (dmr (list '- j r)))
        (dk-cite! 'interval-elt-in-nn 1 'n r)
        (pr-zz! r) (pr-rr! r)
        (let* ((c (pr-zdiv-open! 'n dmr))
               (rr1 (list '* r rn)))
          (pr-zz! c) (pr-rr! c) (pr-rr-term! rr1)
          (dk-have! (list '= jr (list '+ rr1 c))
            (lambda ()
              (subst (have-f! (list '= jr (list '+ rr1 (list '* dmr rn)))
                       (lambda () (mac 'binary-minus-def) (dk-crs-opaque!))))
              (subst (list '= dmr (list '* 'n c)))
              (subst (have-f! (list '= (list '* (list '* 'n c) rn) (list '* c (list '* 'n rn))) (lambda () (dk-crs-opaque!))))
              (subst (list '= (list '* 'n rn) 1))
              (crs)))
          (pr-ccexp-cc! rr1) (pr-ccexp-cc! c)
          (let ((ea (dk-cite! 'pc-e-add rr1 c)))
            (dk-cite! 'pc-e-int c)
            (ew r)
            (dk-conj-close!
              (lambda ()
                (if (dk-ctx-form (dk-goal)) (ass)
                    (begin
                      (subst (list '= 'z (list 'cc-exp wz)))
                      (subst (list '= wz (list '* PR-2PI jr)))
                      (subst (list '= jr (list '+ rr1 c)))
                      (subst ea)
                      (subst (list '= (list 'cc-exp (list '* PR-2PI c)) 1))
                      (crs)))))))))))
(pr-done! 'root-of-unity-rep)

;;; e(./n) is injective on {1, ..., n}
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (FORALL a (IMPLIES (IN a (INTERVAL 1 n)) (FORALL b (IMPLIES (IN b (INTERVAL 1 n))
  (IMPLIES (= ,(pr-e 'a 'n) ,(pr-e 'b 'n)) (= a b)))))))))))
(dk-peel!)
(pr-n-setup! 'n)
(for-each (lambda (v) (dk-cite! 'interval-elt-in-nn 1 'n v) (dk-cite! 'interval-lo 1 'n v) (dk-cite! 'interval-hi 1 'n v) (pr-zz! v) (pr-rr! v)) '(a b))
(let* ((rn '(recip n))
       (d '(+ a (- b)))
       (ar (list '* 'a rn)) (br (list '* 'b rn)) (dr (list '* d rn)) (nbr (list '- br)))
  (pr-zz! d) (pr-rr! d)
  (for-each pr-rr-term! (list ar br dr))
  (dk-cite! 'rr-neg-closed br)
  (for-each pr-ccexp-cc! (list ar br dr nbr))
  (dk-have! (list '= ar (list '+ br dr)) (lambda () (dk-crs-opaque!)))
  (let* ((e1 (dk-cite! 'pc-e-add br dr))
         (e2 (dk-cite! 'pc-e-add nbr br))
         (eab (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (pr-e 'a 'n)))) (dk-asms))))
    (fact 'zz-zero-in)
    (dk-cite! 'pc-e-int 0)
    ;; e(d/n) = e(-b/n) e(b/n) e(d/n) = e(-b/n) e(a/n) = e(-b/n) e(b/n) = 1, the exponentials NAMED (crs
    ;; declines a term holding the literal +i)
    (dk-have! (list '= (list '+ nbr br) 0) (lambda () (dk-crs-opaque!)))
    (let* ((xn (lambda (t) (list 'cc-exp (list '* PR-2PI t))))
           (v1 (dk-name! (xn nbr) 'CC)) (v2 (dk-name! (xn br) 'CC)) (v3 (dk-name! (xn dr) 'CC))
           (one (have-f! (list '= (list '* v1 v2) 1)
                  (lambda () (subst (list '= v1 (xn nbr))) (subst (list '= v2 (xn br)))
                             (subst (list '= (caddr e2) (cadr e2))) (subst (list '= (list '+ nbr br) 0)) (dk-close-if-asm!))))
           (e1a (dk-rewrite-h! e1 (xn br) v2))
           (e1b (dk-rewrite-h! e1a (xn dr) v3)))
      (dk-have! (list '= (xn dr) 1)
        (lambda ()
          (subst (list '= (xn dr) v3))
          (subst (have-f! (list '= v3 (list '* (list '* v1 v2) v3)) (lambda () (subst one) (crs))))
          (subst (have-f! (list '= (list '* (list '* v1 v2) v3) (list '* v1 (list '* v2 v3))) (lambda () (crs))))
          (subst (list '= (list '* v2 v3) (xn (list '+ br dr))))
          (subst (list '= (list '+ br dr) ar))
          (subst eab)
          (subst (list '= (xn br) v2))
          (dk-close-if-asm!))))
    ;; so d/n is an integer t, and n divides d
    (dk-cite! 'pc-e-one-int dr)
    (pr-zz! dr)
    (dk-have! (list '= d (list '* 'n dr))
      (lambda ()
        (subst (have-f! (list '= (list '* 'n dr) (list '* d (list '* 'n rn))) (lambda () (dk-crs-opaque!))))
        (subst (list '= (list '* 'n rn) 1))
        (crs)))
    (pr-zdiv-intro! 'n d dr)
    (dk-have! '(< 0 n) (lambda () (dk-ineq! '(<= 1 n))))
    (dk-have-cases! '(= a b) (list '= d 0)
      (lambda () (dk-ineq! (list '= d 0) '(IN a RR) '(IN b RR)))
      (lambda ()
        (dk-have-cases! '(= a b) (list '< 0 d)
          (lambda ()
            (dk-have! (list '< d 'n) (lambda () (dk-ineq! '(<= a n) '(<= 1 b) '(IN a RR) '(IN b RR) '(IN n RR))))
            (ai (dk-chain-ass! (dk-cite! 'zz-divides-small 'n d))))
          (lambda ()
            (dk-cite! 'rr-not-lt-ge 0 d)
            (dk-have-and! (list '<= d 0) (list 'NOT (list '= d 0)))
            (dk-cite! 'rr-le-ne-lt d 0)
            (dk-cite! 'pz-dvd-neg 'n d)
            (dk-cite! 'zz-neg-closed d)
            (dk-have! (list '< 0 (list '- d)) (lambda () (dk-ineq! (list '< d 0) (list 'IN d 'RR))))
            (dk-have! (list '< (list '- d) 'n) (lambda () (dk-ineq! '(<= b n) '(<= 1 a) '(IN a RR) '(IN b RR) '(IN n RR))))
            (ai (dk-chain-ass! (dk-cite! 'zz-divides-small 'n (list '- d)))))))))
  (dk-close-if-asm!))
(pr-done! 'root-rep-injective)

;;; Euler: there are phi(n) primitive n-th roots of unity, namely e(j/n) for j in {1, ..., n} prime to n
(define PR-JSET '(SEP ephk_ (INTERVAL 1 n) (ZZ-COPRIME ephk_ n)))
(define PR-EF `(VNB-LAMBDA prj_ ,PR-JSET ,(pr-e 'prj_ 'n)))
(define (pr-j-parts! v)                  ; v in J in context: land v in INTERVAL(1, n), ZZ-COPRIME(v, n), v in NN ZZ RR
  (dk-sep-parts! (list 'IN v PR-JSET))
  (dk-cite! 'interval-elt-in-nn 1 'n v)
  (pr-zz! v) (pr-rr! v))
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (= (CARD (PRIMITIVE-ROOTS n)) (EULER-PHI n)))))))
(dk-peel!)
(pr-n-setup! 'n)
(let ((ph (have-f! (list '== '(EULER-PHI n) (list 'CARD PR-JSET)) (lambda () (mac 'EULER-PHI) (qrfl)))))
  (subst ph)
  (dk-have! (list 'SUBSET PR-JSET '(INTERVAL 1 n))
    (lambda () (mac 'subset-def)
      (let* ((lk (dk-peel!)) (v (cadr (car lk))))
        (dk-sep-parts! (list 'IN v PR-JSET))
        (dk-close-if-asm!))))
  (dk-cite! 'interval-in-set 1 'n)
  (dk-cite! 'subclass-of-set-is-set PR-JSET '(INTERVAL 1 n))
  (dk-split-all! (list (dk-cite! 'euler-phi-pos 'n)))
  (dk-rewrite-h! '(IN (EULER-PHI n) NN) '(EULER-PHI n) (list 'CARD PR-JSET))
  (let ((bi (dk-meta-iff! 'bijection-membership-iff PR-JSET '(PRIMITIVE-ROOTS n) PR-EF)))
    (dk-have! (caddr bi)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g0 (dk-goal)))
              (cond
                ((dk-ctx-form g0) (ass))
                ((dk-head-is? g0 'IN)
                 (dk-lam-type! (lambda ()
                   (let* ((lk (dk-peel!)) (v (cadr (car lk))))
                     (pr-j-parts! v)
                     (dk-cite! 'coprime-root-primitive 'n v)
                     (dk-close-if-asm!))))
                 (dk-close-if-asm!))
                ((pr-has-head? 'FORSOME g0)
                 ;; onto
                 (let* ((lk (dk-peel!)) (w (cadr (car lk))))
                   (pr-prim-open! w 'n)
                   (let* ((r (dk-skolem! (dk-cite! 'root-of-unity-rep 'n w)))
                          (wr (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) w))) (dk-asms))))
                     (dk-cite! 'interval-elt-in-nn 1 'n r) (pr-zz! r)
                     (dk-rewrite-h! (list 'IN w '(PRIMITIVE-ROOTS n)) w (caddr wr))
                     (dk-cite! 'primitive-root-coprime 'n r)
                     (dk-have! (list 'IN r PR-JSET) (lambda () (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))
                     (ew r)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-ctx-form (dk-goal)) (ass)
                             (begin (dk-lam-b!) (subst wr) (if (not (proof-done? *ps*)) (dk-close-if-asm!)) (if (pair? (dk-open-leaves)) (vnb-guard (lambda () (rfl)))))))))))
                (#t
                 ;; one to one
                 (let* ((lk (dk-peel!))
                        (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) PR-JSET))) lk)))
                        (a (car vs)) (b (cadr vs))
                        (eq0 (find-first (lambda (f) (dk-head-is? f '=)) lk)))
                   (pr-j-parts! a) (pr-j-parts! b)
                   (dk-lam-b-h! eq0)
                   (dk-chain-ass! (dk-cite! 'root-rep-injective 'n a b))
                   (dk-close-if-asm!)))))))))
    (dk-meta-iff-l! bi)
    (dk-cite! 'card-bijection-eq PR-JSET '(PRIMITIVE-ROOTS n) PR-EF)
    (dk-close-if-asm!)))
(pr-done! 'euler-primitive-roots)
(gloss! 'euler-primitive-roots "Euler: for n >= 1 there are exactly phi(n) primitive n-th roots of unity.")

;;; Remark 5.26: there are phi(p^k) = p^k - p^(k-1) primitive p^k-th roots of unity (k >= 1)
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL p (IMPLIES (IS-PRIME-NAT p)
  (= (CARD (PRIMITIVE-ROOTS (power p (succ k)))) (+ (power p (succ k)) (- (power p k))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'prime-nat-gt-one 'p)))
(let* ((sk '(succ k)) (nn (list 'power 'p sk)) (pk '(power p k)))
  (dk-cite! 'nn-succ-closed 'k)
  (pr-zz! 'p) (pr-rr! 'p) (pr-zz! nn) (pr-rr! nn) (pr-zz! pk) (pr-rr! pk)
  (dk-cite! 'rr-subset-cc 'p)
  (dk-cite! 'zz-lt-succ-le 1 'p)
  (dk-have! '(<= 2 p) (lambda () (dk-ineq! '(<= (+ 1 1) p))))
  (dk-cite! 'pz-power-ge 'p sk)
  (dk-cite! 'nn-zero-le sk) (pr-rr! sk)
  (dk-have! (list '<= 1 nn) (lambda () (dk-ineq! (list '<= (list '+ sk 1) nn) (list '<= 0 sk) (list 'IN sk 'RR) (list 'IN nn 'RR))))
  (dk-have! (list '<= 0 nn) (lambda () (dk-ineq! (list '<= 1 nn) (list 'IN nn 'RR))))
  (dk-cite! 'zz-nonneg-in-nn nn)
  (subst (dk-cite! 'euler-primitive-roots nn))
  (subst (dk-cite! 'euler-phi-prime-power 'k 'p))
  (dk-have-and! '(IN p CC) '(IN k NN))
  (dk-cite! 'power-succ 'p 'k)
  (dk-have! '(NOT (= p 0)) (lambda () (di) (dk-absurd! '(< 1 p) '(= p 0))))
  (dk-have-and! '(IN p RR) '(NOT (= p 0)))
  (dk-cite! 'rr-recip-inverse 'p)
  (subst (list '= nn (list '* 'p pk)))
  (dk-cite! 'rr-recip-closed 'p)
  (let* ((q (dk-name! pk)) (rp (dk-name! '(recip p)))
         (inv (dk-rewrite-h! (list '= (list '* 'p '(recip p)) 1) '(recip p) rp)))
    (subst (list '= pk q))
    (subst (list '= '(recip p) rp))
    (subst (have-f! (list '= (list '* (list '* 'p q) (list '- 1 rp)) (list '+ (list '* 'p q) (list '- (list '* q (list '* 'p rp)))))
             (lambda () (mac 'binary-minus-def) (crs))))
    (subst (list '= (list '* 'p rp) 1))
    (crs)))
(pr-done! 'ccr-5-26)
(gloss! 'ccr-5-26 "Remark 5.26: for a prime p and k >= 1 there are phi(p^k) = p^k - p^(k-1) primitive p^k-th roots of unity.")
