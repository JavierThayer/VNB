;;; pruefer-laws.scm -- THE PRUEFER GROUP Q_p/Z_p (CCR.pdf Remark 1.33, Definition 5.22, Propositions 5.23, 5.24,
;;; Corollary 5.25).  Agent CCR-PRUEFER, 2026-10-29.  Vocabulary: qag-vocab (QUOTIENT-AG), pruefer-vocab (PRUEFER,
;;; IS-SEPARATING-CHARACTER, MU-PINF).  Prefix pr-.  Destination theorem-library/.  Library: complex-analysis.
;;;
;;; PLAN.  (1) For an NV field K, Z(K) is a subgroup of the additive group of K, so K/Z(K) is an abelian group
;;; (quotient-ag-is-abelian-group); for K = Q_p this is Definition 5.22.  (2) Proposition 5.23 for any NV field: a
;;; character L whose kernel is Z(K) descends (DESCEND, descend-computes) to an injective homomorphism of K/Z(K) into
;;; T.  lambda of Proposition 5.20 is such a character for Q_p.  (3) Orders: in Q_p the n-th multiple of x is
;;; embed(n) x; with Proposition 1.32 this gives the order of [x] (Remark 1.33, Proposition 5.24).  (4) Corollary 5.25.
;;;
;;; LOAD WINDOW: after qag-laws, pruefer-vocab and qp-laws (ccr-1-31, ccr-1-32, ccr-5-20, the embed laws).

   ; KIT-9 link skipping, opt-in per file since 2026-10-29 (developed with it on)

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (pr-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** pruefer-laws: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (pr-or-asm f thunk) (if (not (dk-asm? f)) (thunk)))
(define (pr-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (pr-has-head? h (car e)) (pr-has-head? h (cdr e)))))

;;; the generic objects over an NV field kf
(define PR-G '(NORMED-FIELD-ADDITIVE-AG kf))
(define PR-Z '(NV-INTEGERS kf))
(define PR-M `(AG-ZZ-MODULE ,PR-G))
(define PR-S `(QMOD-SETOID ,PR-M ,PR-Z))
(define PR-Q `(QUOTIENT-AG ,PR-G ,PR-Z))
(define (pr-cl a) (list 'CLASS PR-S a))
(define (pr-add a b) (list '(ADD kf) a b))
(define (pr-neg a) (list '(NEG kf) a))

;;; =====================================================================
;;; (1) The additive group of an NV field and its subgroup Z(K).
;;; =====================================================================
(define (pr-nfag-read-off! name acc val)
  (dk-sp-qed! (make-wff `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (== (,acc ,PR-G) ,val))))
    (lambda ()
      (dk-peel!)
      (mac 'normed-field-additive-ag)
      (slot acc)
      (let loop ((fuel 10) (prev #f))
        (if (and (> fuel 0) (not (proof-done? *ps*)) (pr-has-head? 'NTH (dk-goal)) (pr-has-head? 'LIST (dk-goal)) (not (equal? prev (dk-goal))))
            (let ((g0 (dk-goal))) (nth-r) (loop (- fuel 1) g0))))
      (if (and (not (proof-done? *ps*)) (pr-has-head? acc (dk-goal))) (slot acc))
      (if (not (proof-done? *ps*)) (qrfl)))
    name))
(pr-nfag-read-off! 'nfag-carr 'CARR '(CARR kf))
(pr-nfag-read-off! 'nfag-opr 'OPR '(ADD kf))
(pr-nfag-read-off! 'nfag-iden 'IDEN '(ZERO kf))
(pr-nfag-read-off! 'nfag-inv 'INV '(NEG kf))

(define (pr-nv-open!)                    ; IS-NV-FIELD kf in context: land IS-NORMED-FIELD kf, IS-NV-DOMAIN parts
  (pr-or-asm '(IS-NORMED-FIELD kf)
    (lambda () (let* ((iff (dk-cite! 'is-nv-field 'kf)) (rhs (dk-meta-iff-r! iff))) (dk-split-all! (list (dk-ctx-form rhs))))))
  (pr-or-asm (list 'IS-NV-DOMAIN 'kf PR-Z)
    (lambda ()
      (dk-cite! 'nv-integers-domain 'kf)
      (let* ((iff (dk-cite! 'is-nv-domain 'kf PR-Z)) (rhs (dk-meta-iff-r! iff))) (dk-split-all! (list (dk-ctx-form rhs))))))
  (for-each (lambda (n) (dk-cite! n 'kf)) '(nfag-carr nfag-opr nfag-iden nfag-inv)))

(sp (make-wff `(FORALL kf (IMPLIES (IS-NV-FIELD kf) (IS-SUBGROUP ,PR-G ,PR-Z)))))
(dk-peel!)
(pr-nv-open!)
(mac 'IS-SUBGROUP)
(for-each (lambda (n) (subst (dk-cite! n 'kf))) '(nfag-carr nfag-opr nfag-iden nfag-inv))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond ((dk-ctx-form g0) (ass))
            ((dk-head-is? g0 'SUBSET) (mac 'subset-def) (dk-close-if-asm!))
            (#t (error "nv-integers-subgroup: unexpected conjunct" (expression->string g0)))))))
(pr-done! 'nv-integers-subgroup)
(gloss! 'nv-integers-subgroup "The integral elements Z(K) of an NV field K form a subgroup of its additive group.")

(define (pr-setup!)                      ; kf an NV field: the group, the subgroup, the module, the setoid
  (pr-nv-open!)
  (pr-or-asm `(IS-ABELIAN-GROUP ,PR-G) (lambda () (dk-cite! 'normed-field-additive-ag-is-abelian-group 'kf)))
  (pr-or-asm `(IS-SUBGROUP ,PR-G ,PR-Z) (lambda () (dk-cite! 'nv-integers-subgroup 'kf)))
  (pr-or-asm `(IS-MODULE ,PR-M) (lambda () (dk-cite! 'ag-zz-module-is-module PR-G)))
  (pr-or-asm `(IS-SUBMODULE ,PR-M ,PR-Z) (lambda () (dk-cite! 'ag-subgroup-submodule PR-G PR-Z)))
  (pr-or-asm `(IS-SETOID ,PR-S) (lambda () (dk-cite! 'qmod-setoid-is-setoid PR-M PR-Z)))
  (for-each (lambda (n) (dk-cite! n PR-G)) '(agm-vec agm-vadd agm-vneg))
  (dk-cite! 'qmod-setoid-pts PR-M PR-Z)
  (dk-cite! 'qag-carr PR-G PR-Z))
(define (pr-k! t)                        ; type an ADD / NEG / ZERO expression of kf in CARR kf
  (let ((want (list 'IN t '(CARR kf))))
    (cond ((dk-asm? want) t)
          ((equal? t '(ZERO kf)) (dk-cite! 'nf-zero-in-carr 'kf) t)
          ((and (pair? t) (equal? (car t) '(ADD kf))) (pr-k! (cadr t)) (pr-k! (caddr t)) (dk-cite! 'nf-add-in-carr 'kf (cadr t) (caddr t)) t)
          ((and (pair? t) (equal? (car t) '(MUL kf))) (pr-k! (cadr t)) (pr-k! (caddr t)) (dk-cite! 'nf-mul-in-carr 'kf (cadr t) (caddr t)) t)
          ((and (pair? t) (equal? (car t) '(NEG kf))) (pr-k! (cadr t)) (dk-cite! 'nf-neg-in-carr 'kf (cadr t)) t)
          (#t (error "pr-k!: cannot type" (expression->string t))))))
(define (pr-in-g! t)                     ; t in CARR kf  =>  t in CARR G
  (pr-k! t)
  (pr-or-asm (list 'IN t (list 'CARR PR-G))
    (lambda () (dk-have! (list 'IN t (list 'CARR PR-G)) (lambda () (subst (list '== (list 'CARR PR-G) '(CARR kf))) (dk-close-if-asm!))))))
(define (pr-in-pts! t)                   ; t in CARR kf  =>  t in PTS S
  (pr-in-g! t)
  (pr-or-asm (list 'IN t (list 'PTS PR-S))
    (lambda () (dk-have! (list 'IN t (list 'PTS PR-S))
                 (lambda () (subst (list '== (list 'PTS PR-S) (list 'VEC PR-M)))
                            (subst (list '== (list 'VEC PR-M) (list 'CARR PR-G)))
                            (dk-close-if-asm!))))))
(define (pr-rep! c)                      ; c in CARR Q: land a in CARR kf with c = [a]; return a
  (let* ((ex (dk-cite! 'qag-rep PR-G PR-Z c))
         (a (dk-skolem! ex)))
    (dk-rewrite-h! (list 'IN a (list 'CARR PR-G)) (list 'CARR PR-G) '(CARR kf))
    a))

;;; =====================================================================
;;; (2) Proposition 5.23, for any NV field: a separating character factors through an injective homomorphism
;;;     K/Z(K) -> T.
;;; =====================================================================
(define PR-HOM '(FORALL chx_ (IMPLIES (IN chx_ (CARR kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kf))
                  (= (L ((ADD kf) chx_ chy_)) (* (L chx_) (L chy_))))))))
(define PR-KER `(FORALL scx_ (IMPLIES (IN scx_ (CARR kf)) (IFF (= (L scx_) 1) (IN scx_ ,PR-Z)))))
(define (pr-char-open!)                  ; IS-SEPARATING-CHARACTER kf L in context: land its parts
  (let* ((iff (dk-cite! 'is-separating-character 'kf 'L)) (rhs (dk-meta-iff-r! iff)))
    (dk-split-all! (list (dk-ctx-form rhs))))
  (let* ((iff (dk-cite! 'is-add-character 'kf 'L)) (rhs (dk-meta-iff-r! iff)))
    (dk-split-all! (list (dk-ctx-form rhs)))))
(define (pr-hom! a b) (pr-k! a) (pr-k! b) (dk-apply! (dk-ctx-form PR-HOM) a b))
(define (pr-ker! t) (pr-k! t) (dk-apply! (dk-ctx-form PR-KER) t))
(define (pr-cc! t)                       ; L(t) in CC, from L in FUN(CARR kf, UNIT-CIRCLE)
  (pr-k! t)
  (pr-or-asm (list 'IN (list 'L t) 'CC)
    (lambda ()
      (dk-have-and! '(IN L (FUN (CARR kf) UNIT-CIRCLE)) (list 'IN t '(CARR kf)))
      (dk-cite! 'fun-apply-type 'L '(CARR kf) 'UNIT-CIRCLE t)
      (dk-iff-fwd! (dk-cite! 'unit-circle-membership (list 'L t))))))

(define PR-LB `(DESCEND ,PR-S L))
(define (pr-q-vars lk)                   ; the variables v landed as (IN v (CARR Q)), in order
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR PR-Q)))) lk)))
(sp (make-wff `(FORALL kf (IMPLIES (IS-NV-FIELD kf) (FORALL L (IMPLIES (IS-SEPARATING-CHARACTER kf L)
  (FORSOME lb (AND (IN lb (FUN (CARR ,PR-Q) UNIT-CIRCLE))
    (AND (FORALL x (IMPLIES (IN x (CARR kf)) (= (lb ,(pr-cl 'x)) (L x))))
    (AND (FORALL c (IMPLIES (IN c (CARR ,PR-Q)) (FORALL d (IMPLIES (IN d (CARR ,PR-Q))
            (= (lb ((OPR ,PR-Q) c d)) (* (lb c) (lb d)))))))
         (FORALL c (IMPLIES (IN c (CARR ,PR-Q)) (FORALL d (IMPLIES (IN d (CARR ,PR-Q))
            (IMPLIES (= (lb c) (lb d)) (= c d))))))))))))))))
(dk-peel!)
(pr-setup!)
(pr-char-open!)
;; L respects the congruence modulo Z(K)
(dk-have! (list 'IN 'L (list 'FUN (list 'PTS PR-S) 'UNIT-CIRCLE))
  (lambda () (subst (list '== (list 'PTS PR-S) (list 'VEC PR-M))) (subst (list '== (list 'VEC PR-M) (list 'CARR PR-G)))
             (subst (list '== (list 'CARR PR-G) '(CARR kf))) (dk-close-if-asm!)))
(dk-have! (list 'RESPECTS PR-S 'L)
  (lambda ()
    (mac 'respects-unfold)
    (subst (list '== (list 'PTS PR-S) (list 'VEC PR-M))) (subst (list '== (list 'VEC PR-M) (list 'CARR PR-G)))
    (subst (list '== (list 'CARR PR-G) '(CARR kf)))
    (let* ((lk (dk-peel!)) (g0 (dk-goal)) (a (cadr (cadr g0))) (b (cadr (caddr g0))))
      (pr-in-g! a) (pr-in-g! b)
      (let* ((r0 (dk-cite! 'qmod-related-out PR-M PR-Z a b))
             (r1 (dk-rewrite-h! r0 (list 'VADD PR-M) (list 'OPR PR-G)))
             (r2 (dk-rewrite-h! r1 (list 'VNEG PR-M) (list 'INV PR-G)))
             (r3 (dk-rewrite-h! r2 (list 'OPR PR-G) '(ADD kf)))
             (r4 (dk-rewrite-h! r3 (list 'INV PR-G) '(NEG kf)))
             (u (pr-add a (pr-neg b)))
             (k0 (pr-ker! u))
             (l1 (dk-meta-iff-l! k0))
             (h0 (pr-hom! u b))
             (s0 (dk-cite! 'nf-sub-add-back 'kf a b))
             (h1 (dk-rewrite-h! h0 (pr-add u b) a))
             (h2 (dk-rewrite-h! h1 (list 'L u) 1)))
        (pr-cc! b)
        (subst h2)
        (crs)))))
(dk-cite! 'descend-in-fun PR-S 'UNIT-CIRCLE 'L)
(dk-have-and! (list 'IN 'L (list 'FUN (list 'PTS PR-S) 'UNIT-CIRCLE)) (list 'RESPECTS PR-S 'L))
(dk-cite! 'descend-in-fun PR-S 'UNIT-CIRCLE 'L)
(define (pr-lb-at! a)                    ; land lb([a]) = L(a), a in CARR kf
  (pr-in-pts! a)
  (dk-cite! 'descend-computes PR-S 'UNIT-CIRCLE 'L a))
(ew PR-LB)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-head-is? g0 'IN)
         (subst (list '== (list 'CARR PR-Q) (list 'QUOTIENT PR-S))) (dk-close-if-asm!))
        ((and (dk-head-is? g0 'FORALL) (not (pr-has-head? 'OPR g0)) (not (pr-has-head? 'IMPLIES (caddr (caddr g0)))))
         ;; the factorisation lb([x]) = L(x)
         (let* ((lk (dk-peel!)) (x (cadr (car lk))))
           (pr-lb-at! x) (dk-close-if-asm!)))
        ((pr-has-head? 'OPR g0)
         ;; the homomorphism law
         (let* ((lk (dk-peel!))
                (vs (pr-q-vars lk)) (c (car vs)) (d (cadr vs))
                (a (pr-rep! c)) (b (pr-rep! d)))
           (subst (list '= c (pr-cl a))) (subst (list '= d (pr-cl b)))
           (pr-in-g! a) (pr-in-g! b)
           (subst (dk-cite! 'qag-opr-class PR-G PR-Z a b))
           (subst (list '== (list 'OPR PR-G) '(ADD kf)))
           (pr-lb-at! a) (pr-lb-at! b) (pr-lb-at! (pr-add a b))
           (subst (list '= (list PR-LB (pr-cl (pr-add a b))) (list 'L (pr-add a b))))
           (subst (list '= (list PR-LB (pr-cl a)) (list 'L a)))
           (subst (list '= (list PR-LB (pr-cl b)) (list 'L b)))
           (pr-hom! a b)
           (dk-close-if-asm!)))
        (#t
         ;; injectivity
         (let* ((lk (dk-peel!))
                (vs (pr-q-vars lk)) (c (car vs)) (d (cadr vs))
                (eq0 (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list PR-LB c)))) (dk-asms)))
                (a (pr-rep! c)) (b (pr-rep! d)))
           (pr-in-g! a) (pr-in-g! b)
           (pr-lb-at! a) (pr-lb-at! b)
           (let* ((e1 (dk-rewrite-h! eq0 c (pr-cl a)))
                  (e2 (dk-rewrite-h! e1 d (pr-cl b)))
                  (e3 (dk-rewrite-h! e2 (list PR-LB (pr-cl a)) (list 'L a)))
                  (e4 (dk-rewrite-h! e3 (list PR-LB (pr-cl b)) (list 'L b)))
                  (nb (pr-neg b))
                  (u (pr-add a nb))
                  (z0 (dk-cite! 'nv-domain-zero 'kf PR-Z))
                  (kz (pr-ker! '(ZERO kf)))
                  (lz (dk-meta-iff-l! kz))
                  (hu (pr-hom! a nb))
                  (hb (pr-hom! b nb))
                  (ri (dk-cite! 'abelian-group-right-inv PR-G b))
                  (ri1 (dk-rewrite-h! ri (list 'OPR PR-G) '(ADD kf)))
                  (ri2 (dk-rewrite-h! ri1 (list 'INV PR-G) '(NEG kf)))
                  (ri3 (dk-rewrite-h! ri2 (list 'IDEN PR-G) '(ZERO kf))))
             (dk-have! (list '= (list 'L u) 1)
               (lambda ()
                 (subst hu)
                 (subst e4)
                 (subst (list '= (list '* (list 'L b) (list 'L nb)) (list 'L (pr-add b nb))))
                 (subst ri3)
                 (dk-close-if-asm!)))
             (let* ((ku (pr-ker! u))
                    (iu (dk-meta-iff-r! ku))
                    (ce (dk-cite! 'qag-class-eq-iff PR-G PR-Z a b))
                    (ce1 (dk-rewrite-h! ce (list 'OPR PR-G) '(ADD kf)))
                    (ce2 (dk-rewrite-h! ce1 (list 'INV PR-G) '(NEG kf))))
               (dk-meta-iff-l! ce2)
               (subst (list '= c (pr-cl a))) (subst (list '= d (pr-cl b)))
               (dk-close-if-asm!)))))))))
(pr-done! 'nv-separating-factor)
(gloss! 'nv-separating-factor "A character of an NV field K whose kernel is Z(K) factors through an injective homomorphism of K/Z(K) into the circle group.")

;;; =====================================================================
;;; (3) Q_p: Definition 5.22 and Proposition 5.23 for Q_p.
;;; =====================================================================
(define PR-QF '(QP-FIELD p))
(define PR-QG '(NORMED-FIELD-ADDITIVE-AG (QP-FIELD p)))
(define PR-QM `(AG-ZZ-MODULE ,PR-QG))
(define PR-QS `(QMOD-SETOID ,PR-QM (ZP p)))
(define PR-QQ `(QUOTIENT-AG ,PR-QG (ZP p)))
(define (pr-qcl a) (list 'CLASS PR-QS a))
(define (pr-em u) `((EMBED (NF-METRIC-SPACE (QQ-PADIC p))) ,u))
(define (pr-mul a b) `((MUL (QP-FIELD p)) ,a ,b))
(define (pr-qadd a b) `((ADD (QP-FIELD p)) ,a ,b))
(define (pr-ab a) `((QP-ABS p) ,a))
(define PR-ZPEQ '(== (ZP p) (NV-INTEGERS (QP-FIELD p))))

(define (pr-qp-setup!)
  (pr-or-asm '(IS-NV-FIELD (QP-FIELD p)) (lambda () (dk-cite! 'qp-is-nv-field 'p)))
  (pr-or-asm '(IS-NORMED-FIELD (QP-FIELD p)) (lambda () (dk-cite! 'qp-is-normed-field 'p)))
  (pr-or-asm PR-ZPEQ (lambda () (dk-have! PR-ZPEQ (lambda () (mac 'ZP) (qrfl)))))
  (pr-or-asm `(IS-ABELIAN-GROUP ,PR-QG) (lambda () (dk-cite! 'normed-field-additive-ag-is-abelian-group PR-QF)))
  (pr-or-asm '(IS-GROUP (NORMED-FIELD-ADDITIVE-AG (QP-FIELD p))) (lambda () (dk-cite! 'abelian-group-is-group PR-QG)))
  (pr-or-asm `(IS-SUBGROUP ,PR-QG (ZP p))
    (lambda () (dk-rewrite-h! (dk-cite! 'nv-integers-subgroup PR-QF) '(NV-INTEGERS (QP-FIELD p)) '(ZP p))))
  (for-each (lambda (n) (dk-cite! n PR-QF)) '(nfag-carr nfag-opr nfag-iden nfag-inv))
  (dk-cite! 'qp-field-fnrm 'p)
  (pr-or-asm '(IN p ZZ) (lambda () (dk-project! '(IN p ZZ) 'zz-prime '(ZZ-PRIME p))))
  (pr-or-asm '(< 1 p) (lambda () (dk-project! '(< 1 p) 'zz-prime '(ZZ-PRIME p)))))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-ABELIAN-GROUP (PRUEFER p))))))
(dk-peel!)
(pr-qp-setup!)
(dk-cite! 'quotient-ag-is-abelian-group PR-QG '(ZP p))
(mac 'PRUEFER)
(dk-close-if-asm!)
(pr-done! 'ccr-5-22)
(gloss! 'ccr-5-22 "Definition 5.22: the Pruefer p-group Q_p/Z_p, the quotient of the additive group of Q_p by Z_p, is an abelian group.")

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-SEPARATING-CHARACTER (QP-FIELD p) (QP-LAMBDA p))))))
(dk-peel!)
(pr-qp-setup!)
(dk-split-all! (list (dk-cite! 'ccr-5-20 'p)))
(mac 'IS-SEPARATING-CHARACTER)
(subst '(== (NV-INTEGERS (QP-FIELD p)) (ZP p)))
(dk-conj-close! (lambda () (dk-close-if-asm!)))
(pr-done! 'qp-lambda-separating)
(gloss! 'qp-lambda-separating "The character lambda of Proposition 5.20 is a separating character of Q_p: its kernel is Z_p.")

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL L (IMPLIES (IS-SEPARATING-CHARACTER (QP-FIELD p) L)
  (FORSOME lb (AND (IN lb (FUN (CARR (PRUEFER p)) UNIT-CIRCLE))
    (AND (FORALL x (IMPLIES (IN x (CARR (QP-FIELD p))) (= (lb ,(pr-qcl 'x)) (L x))))
    (AND (FORALL c (IMPLIES (IN c (CARR (PRUEFER p))) (FORALL d (IMPLIES (IN d (CARR (PRUEFER p)))
            (= (lb ((OPR (PRUEFER p)) c d)) (* (lb c) (lb d)))))))
         (FORALL c (IMPLIES (IN c (CARR (PRUEFER p))) (FORALL d (IMPLIES (IN d (CARR (PRUEFER p)))
            (IMPLIES (= (lb c) (lb d)) (= c d))))))))))))))))
(dk-peel!)
(pr-qp-setup!)
(dk-cite! 'nv-separating-factor PR-QF 'L)
(mac 'PRUEFER)
(subst '(== (ZP p) (NV-INTEGERS (QP-FIELD p))))
(dk-close-if-asm!)
(pr-done! 'ccr-5-23)
(gloss! 'ccr-5-23 "Proposition 5.23: a separating character of Q_p factors through an injective homomorphism of the Pruefer group Q_p/Z_p into the circle group T.")

;;; =====================================================================
;;; (4) Orders in Q_p/Z_p: Remark 1.33 and Proposition 5.24.
;;; =====================================================================
(define (pr-zz! u)
  (let ((want (list 'IN u 'ZZ)))
    (cond ((dk-asm? want) u)
          ((dk-asm? (list 'IN u 'NN)) (dk-cite! 'nn-subset-zz u) u)
          ((and (pair? u) (eq? (car u) 'power)) (pr-zz! (cadr u)) (dk-cite! 'pz-power-in-zz (cadr u) (caddr u)) u)
          ((and (pair? u) (memq (car u) '(+ *)))
           (pr-zz! (cadr u)) (pr-zz! (caddr u))
           (dk-have-and! (list 'IN (cadr u) 'ZZ) (list 'IN (caddr u) 'ZZ))
           (dk-cite! (if (eq? (car u) '+) 'zz-add-closed 'zz-mul-closed) (cadr u) (caddr u)) u)
          ((and (pair? u) (eq? (car u) '-) (null? (cddr u))) (pr-zz! (cadr u)) (dk-cite! 'zz-neg-closed (cadr u)) u)
          (#t (dk-have! want (lambda () (from-context!))) u))))
(define (pr-qq! u)
  (pr-or-asm (list 'IN u 'QQ) (lambda () (pr-zz! u) (dk-cite! 'zz-subset-qq u))))
(define (pr-embed-abs! u)                ; u in QQ: land embed(u) in PTS(QP p) and |embed(u)| = |u|_p
  (pr-or-asm (list 'IN (pr-em u) '(PTS (QP p)))
    (lambda () (dk-split-all! (list (dk-cite! 'qp-embed-abs 'p u))))))
(define (pr-qk! t)                       ; type a Q_p expression in CARR(QP-FIELD p)
  (let ((want (list 'IN t PR-QF)))
    (cond ((dk-asm? (list 'IN t (list 'CARR PR-QF))) t)
          ((equal? t '(ZERO (QP-FIELD p))) (dk-cite! 'nf-zero-in-carr PR-QF) t)
          ((equal? t '(ONE (QP-FIELD p))) (dk-cite! 'nf-one-in-carr PR-QF) t)
          ((and (pair? t) (equal? (car t) '(ADD (QP-FIELD p)))) (pr-qk! (cadr t)) (pr-qk! (caddr t)) (dk-cite! 'nf-add-in-carr PR-QF (cadr t) (caddr t)) t)
          ((and (pair? t) (equal? (car t) '(MUL (QP-FIELD p)))) (pr-qk! (cadr t)) (pr-qk! (caddr t)) (dk-cite! 'nf-mul-in-carr PR-QF (cadr t) (caddr t)) t)
          ((and (pair? t) (equal? (car t) '(NEG (QP-FIELD p)))) (pr-qk! (cadr t)) (dk-cite! 'nf-neg-in-carr PR-QF (cadr t)) t)
          ((and (pair? t) (equal? (car t) '(EMBED (NF-METRIC-SPACE (QQ-PADIC p)))))
           (pr-qq! (cadr t))
           (pr-embed-abs! (cadr t))
           (pr-or-asm '(== (CARR (QP-FIELD p)) (PTS (QP p))) (lambda () (dk-cite! 'ccr-1-26-carrier 'p)))
           (dk-have! (list 'IN t (list 'CARR PR-QF)) (lambda () (subst '(== (CARR (QP-FIELD p)) (PTS (QP p)))) (dk-close-if-asm!)))
           t)
          ((and (pair? t) (eq? (car t) 'QP-PPOW))
           (pr-zz! (caddr t)) (dk-split-all! (list (dk-cite! 'qo-ppow-def 'p (caddr t)))) t)
          (#t (error "pr-qk!: cannot type" (expression->string t))))))
(define (pr-crs! vs)                     ; a commutative-ring identity of Q_p through its ring view
  (let ((view `(NORMED-FIELD-AS-COMMUTATIVE-RING ,PR-QF)))
    (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring PR-QF)
    (for-each (lambda (r) (dk-cite! r PR-QF))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (u)
                (pr-qk! u)
                (dk-have! `(IN ,u (CARR ,view)) (lambda () (subst `(= (CARR ,view) (CARR ,PR-QF))) (dk-close-if-asm!))))
              vs)
    (for-each (lambda (op)
                (if (dk-contains? (dk-goal) `(,op ,PR-QF)) (subst `(= (,op ,PR-QF) (,op ,view)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))

;;; the n-th multiple of x in the additive group of Q_p is embed(n) x
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR (QP-FIELD p)))
  (= (GPOW ,PR-QG x n) ,(pr-mul (pr-em 'n) 'x))))))))))
(let* ((ind (use-induction)) (n (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pr-qp-setup!)
  (subst (dk-cite! 'gpow-zero PR-QG 'x))
  (subst (list '== (list 'IDEN PR-QG) '(ZERO (QP-FIELD p))))
  (fact 'qq-zero-in)
  (subst (dk-cite! 'qp-embed-zero 'p))
  (pr-crs! '(x))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pr-qp-setup!)
  (let ((ihx (dk-apply! ih 'p 'x)))
    (pr-qk! (pr-em n))
    (subst (dk-cite! 'gpow-succ PR-QG 'x n))
    (subst ihx)
    (subst (list '== (list 'OPR PR-QG) '(ADD (QP-FIELD p))))
    (subst (dk-cite! 'nn-succ-plus-one n))
    (pr-qq! n) (fact 'qq-one-in)
    (subst (dk-cite! 'qp-embed-add 'p n 1))
    (subst (dk-cite! 'qp-embed-one 'p))
    (pr-crs! (list 'x (pr-em n)))))
(pr-done! 'qp-gpow-embed)

;;; p^n in Q_p (QP-PPOW, n in NN) is the embedded integer p^n
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL n (IMPLIES (IN n NN) (= (QP-PPOW p n) ,(pr-em '(power p n)))))))))
(dk-peel!)
(pr-qp-setup!)
(pr-zz! 'n)
(fact 'nn-zero-in)
(dk-have! '(= (+ n (- 0)) n) (lambda () (dk-nn!)))
(pr-qk! '(QP-PPOW p n))
(dk-cite! 'zz-in-rr 'p) (dk-cite! 'rr-subset-cc 'p)
(let* ((c0 (dk-cite! 'qe-ppow-char 'p 'n 'n 0))
       (z0 (dk-cite! 'power-zero 'p))
       (c1 (dk-rewrite-h! c0 '(power p 0) 1))
       (o1 (dk-cite! 'qp-embed-one 'p))
       (c2 (dk-rewrite-h! c1 (pr-em 1) '(ONE (QP-FIELD p)))))
  (subst (list '= (pr-em '(power p n)) (pr-mul '(QP-PPOW p n) '(ONE (QP-FIELD p)))))
  (pr-crs! '((QP-PPOW p n))))
(pr-done! 'qp-ppow-nat)

;;; membership in Z_p as |y| <= 1 (FNRM of the field), both directions
(define PR-ZSEP '(SEP cwx_ (CARR (QP-FIELD p)) (<= ((FNRM (QP-FIELD p)) cwx_) 1)))
(define (pr-fn y) `((FNRM (QP-FIELD p)) ,y))
(define (pr-zp-norm! y)                  ; (IN y (ZP p)) in context: land |y| <= 1
  (dk-cite! 'nv-integers-unfold PR-QF)
  (let* ((m1 (dk-rewrite-h! (list 'IN y '(ZP p)) '(ZP p) '(NV-INTEGERS (QP-FIELD p))))
         (m2 (dk-rewrite-h! m1 '(NV-INTEGERS (QP-FIELD p)) PR-ZSEP)))
    (dk-sep-parts! m2)))
(define (pr-zp-in! y)                    ; y typed, |y| <= 1 in context: land (IN y (ZP p))
  (pr-qk! y)
  (dk-cite! 'nv-integers-unfold PR-QF)
  (pr-or-asm (list 'IN y '(ZP p))
    (lambda ()
      (dk-have! (list 'IN y '(ZP p))
        (lambda ()
          (subst PR-ZPEQ)
          (subst (list '== '(NV-INTEGERS (QP-FIELD p)) PR-ZSEP))
          (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))))
(define (pr-rr! t) (pr-or-asm (list 'IN t 'RR) (lambda () (pr-zz! t) (dk-cite! 'zz-in-rr t))))

(define PR-D '(power p n))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR (QP-FIELD p))) (IMPLIES (NOT (= x (ZERO (QP-FIELD p))))
  (FORALL n (IMPLIES (IN n NN) (IMPLIES (= (- ((QP-ORD p) x)) n)
    (IS-ELEMENT-ORDER (PRUEFER p) ,(pr-qcl 'x) ,PR-D)))))))))))
(dk-peel!)
(pr-qp-setup!)
(dk-have! (list 'IN 'x (list 'CARR PR-QG)) (lambda () (subst (list '== (list 'CARR PR-QG) '(CARR (QP-FIELD p)))) (dk-close-if-asm!)))
;; Proposition 1.32 at x, with -ord(x) = n
(let* ((c32 (dk-cite! 'ccr-1-32 'p 'x))
       (parts (dk-split! c32))
       (in0 (find-first (lambda (f) (dk-head-is? f 'IN)) parts))
       (mn0 (find-first (lambda (f) (dk-head-is? f 'FORALL)) parts))
       (in1 (dk-rewrite-h! in0 '(- ((QP-ORD p) x)) 'n))
       (mn1 (dk-rewrite-h! mn0 '(- ((QP-ORD p) x)) 'n)))
  ;; d = p^n: an integer >= 1
  (pr-zz! 'n) (pr-rr! 'n) (pr-rr! 'p) (pr-zz! PR-D) (pr-rr! PR-D)
  (dk-cite! 'zz-one-in)
  (dk-cite! 'zz-lt-succ-le 1 'p)
  (dk-have! '(<= 2 p) (lambda () (dk-ineq! '(<= (+ 1 1) p))))
  (dk-cite! 'pz-power-ge 'p 'n)
  (dk-cite! 'nn-zero-le 'n)
  (dk-have! (list '<= 1 PR-D) (lambda () (dk-ineq! (list '<= '(+ n 1) PR-D) '(<= 0 n) '(IN n RR) (list 'IN PR-D 'RR))))
  (dk-have! (list '<= 0 PR-D) (lambda () (dk-ineq! (list '<= 1 PR-D) (list 'IN PR-D 'RR))))
  (dk-cite! 'zz-nonneg-in-nn PR-D)
  ;; d x = p^n x lies in Z_p
  (let* ((ge (dk-cite! 'qp-gpow-embed PR-D 'p 'x))
         (pn (dk-cite! 'qp-ppow-nat 'p 'n)))
    (dk-have! (list 'IN (list 'GPOW PR-QG 'x PR-D) '(ZP p))
      (lambda () (subst ge) (subst (list '= (pr-em PR-D) '(QP-PPOW p n))) (dk-close-if-asm!))))
  (dk-cite! 'quotient-ag-is-abelian-group PR-QG '(ZP p))
  (dk-cite! 'qag-class-in PR-QG '(ZP p) 'x)
  (mac 'PRUEFER)
  (mac 'IS-ELEMENT-ORDER)
  (dk-conj-close!
    (lambda ()
      (let ((g0 (dk-goal)))
        (cond
          ((dk-ctx-form g0) (ass))
          ((dk-head-is? g0 '=)
           (dk-meta-iff-l! (dk-cite! 'qag-pow-iden-iff PR-D PR-QG '(ZP p) 'x))
           (dk-close-if-asm!))
          ((dk-head-is? g0 'FORALL)
           (let* ((lk (dk-peel!))
                  (e (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))
                  (hy (dk-meta-iff-r! (dk-cite! 'qag-pow-iden-iff e PR-QG '(ZP p) 'x)))
                  (ge (dk-cite! 'qp-gpow-embed e 'p 'x))
                  (y0 (dk-rewrite-h! hy (list 'GPOW PR-QG 'x e) (pr-mul (pr-em e) 'x))))
             (pr-zz! e) (pr-rr! e)
             (dk-cite! 'nn-in-rr e)
             (dk-have! (list 'NOT (list '= e 0)) (lambda () (di) (dk-absurd! (list '<= 1 e) (list '= e 0))))
             ;; e = p^i u with p not dividing u
             (let* ((i (dk-skolem! (dk-cite! 'pz-ord-exists 'p e)))
                    (oi (find-first (lambda (f) (dk-head-is? f 'ZZ-ORD-IS)) (dk-asms)))
                    (ord-parts (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'zz-ord-is 'p e i))))
                    (dv (find-first (lambda (f) (dk-head-is? f 'ZZ-DIVIDES)) ord-parts))
                    (ndv (find-first (lambda (f) (dk-head-is? f 'NOT)) ord-parts))
                    (ppi (list 'power 'p i))
                    (dvp (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'zz-divides ppi e))))
                    (u (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) dvp)))
                    (eu (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) e))) (dk-asms))))
               (pr-zz! i) (pr-zz! ppi) (pr-rr! ppi) (pr-rr! u)
               (dk-cite! 'zz-in-rr 'p) (dk-cite! 'rr-subset-cc 'p)
               (dk-have! (list 'NOT (list 'ZZ-DIVIDES 'p u))
                 (lambda ()
                   (let* ((pd (car (dk-landed (lambda () (di)))))
                          (pdp (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'zz-divides 'p u))))
                          (w (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) pdp)))
                          (uw (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) u))) (dk-asms)))
                          (psi (list 'power 'p (list 'succ i))))
                     (pr-zz! w)
                     (dk-cite! 'nn-succ-closed i)
                     (dk-have-and! '(IN p CC) (list 'IN i 'NN))
                     (dk-cite! 'power-succ 'p i)
                     (pr-zz! psi)
                     (dk-have! (list '= e (list '* psi w))
                       (lambda () (subst eu) (subst uw) (subst (list '= psi (list '* 'p ppi))) (crs)))
                     (dk-have! (list 'ZZ-DIVIDES psi e)
                       (lambda ()
                         (let ((iff (dk-meta-iff! 'zz-divides psi e)))
                           (dk-have! (caddr iff)
                             (lambda () (dk-conj-close! (lambda ()
                               (if (dk-head-is? (dk-goal) 'FORSOME)
                                   (begin (ew w) (dk-conj-close! (lambda () (dk-close-if-asm!))))
                                   (dk-close-if-asm!))))))
                           (dk-meta-iff-l! iff)
                           (dk-close-if-asm!))))
                     (ai (dk-ctx-form ndv)))))
               ;; |embed(u)| = 1
               (pr-qq! u) (pr-qq! ppi)
               (let* ((ea (pr-embed-abs! u))
                      (un (dk-cite! 'pc-abs-unit 'p u))
                      (eu1 (dk-have! (list '= (pr-fn (pr-em u)) 1)
                             (lambda () (subst '(== (FNRM (QP-FIELD p)) (QP-ABS p)))
                                        (subst (list '= (pr-ab (pr-em u)) (list '(PADIC-ABS p) u)))
                                        (dk-close-if-asm!))))
                      (w (pr-mul (list 'QP-PPOW 'p i) 'x))
                      (y1 (dk-rewrite-h! y0 e (list '* ppi u)))
                      (em (dk-cite! 'qp-embed-mul 'p ppi u))
                      (y2 (dk-rewrite-h! y1 (pr-em (list '* ppi u)) (pr-mul (pr-em ppi) (pr-em u))))
                      (pin (dk-cite! 'qp-ppow-nat 'p i))
                      (eq1 (dk-have! (list '= (pr-mul (pr-mul (pr-em ppi) (pr-em u)) 'x) (pr-mul (pr-em u) w))
                             (lambda () (subst (list '= (list 'QP-PPOW 'p i) (pr-em ppi)))
                                        (pr-crs! (list (pr-em ppi) (pr-em u) 'x)))))
                      (y3 (dk-rewrite-h! y2 (pr-mul (pr-mul (pr-em ppi) (pr-em u)) 'x) (pr-mul (pr-em u) w)))
                      (n0 (pr-zp-norm! (pr-mul (pr-em u) w))))
                 (pr-qk! w) (pr-qk! (pr-em u))
                 (dk-cite! 'nf-norm-in-rr PR-QF w)
                 (dk-cite! 'nf-norm-in-rr PR-QF (pr-mul (pr-em u) w))
                 (let* ((nm (dk-cite! 'nf-norm-mult PR-QF (pr-em u) w))
                        (nm1 (dk-rewrite-h! nm (pr-fn (pr-em u)) 1)))
                   (dk-have! (list '<= (pr-fn w) 1)
                     (lambda () (dk-ineq! nm1 n0 (list 'IN (pr-fn w) 'RR) (list 'IN (pr-fn (pr-mul (pr-em u) w)) 'RR))))
                   (pr-zp-in! w)
                   (let* ((le (dk-apply! (dk-ctx-form mn1) i))
                          (pd (dk-cite! 'pz-power-dvd 'p 'n i))
                          (td (dk-cite! 'zz-divides-trans PR-D ppi e)))
                     (dk-cite! 'zz-divides-le-pos PR-D e)
                     (dk-close-if-asm!)))))))
          (#t (error "order: unexpected conjunct" (expression->string g0))))))))
(pr-done! 'qp-pruefer-order)
(gloss! 'qp-pruefer-order "For x /= 0 in Q_p with -ord_p(x) = n >= 0, the class of x in Q_p/Z_p has order p^n.")

(define PR-NORD '(- ((QP-ORD p) x)))
(define (pr-order-setup!)                ; the terms of an IS-ELEMENT-ORDER goal about [x] typed, then unfolded
  (dk-have! (list 'IN 'x (list 'CARR PR-QG)) (lambda () (subst (list '== (list 'CARR PR-QG) '(CARR (QP-FIELD p)))) (dk-close-if-asm!)))
  (dk-cite! 'quotient-ag-is-abelian-group PR-QG '(ZP p))
  (dk-cite! 'qag-class-in PR-QG '(ZP p) 'x))

;;; Remark 1.33: if -ord_p(x) >= 0, the order of x modulo Z_p is p^(-ord_p x)
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR (QP-FIELD p))) (IMPLIES (NOT (= x (ZERO (QP-FIELD p))))
  (IMPLIES (<= 0 ,PR-NORD) (AND (IN ,PR-NORD NN) (IS-ELEMENT-ORDER (PRUEFER p) ,(pr-qcl 'x) (power p ,PR-NORD)))))))))))
(dk-peel!)
(pr-qp-setup!)
(let* ((c31 (dk-cite! 'ccr-1-31 'p))
       (parts (dk-split! c31))
       (oz (dk-apply! (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (pr-has-head? 'FORSOME f)))) parts) 'x)))
  (dk-cite! 'zz-neg-closed '((QP-ORD p) x))
  (dk-cite! 'zz-nonneg-in-nn PR-NORD)
  (dk-have! (list '= PR-NORD PR-NORD) (lambda () (rfl)))
  (dk-cite! 'qp-pruefer-order 'p 'x PR-NORD)
  (dk-conj-close! (lambda () (dk-close-if-asm!))))
(pr-done! 'ccr-1-33)
(gloss! 'ccr-1-33 "Remark 1.33: for x /= 0 in Q_p with -ord_p(x) >= 0, -ord_p(x) is a natural number and p^(-ord_p x) is the order of x in the additive group of Q_p modulo Z_p.")

;;; Proposition 5.24: the order of x in Q_p/Z_p is 1 (the notes' "0", the trivial order) if x is in Z_p, and
;;; p^(-ord_p x) otherwise
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR (QP-FIELD p)))
  (AND (IMPLIES (IN x (ZP p)) (IS-ELEMENT-ORDER (PRUEFER p) ,(pr-qcl 'x) 1))
       (IMPLIES (NOT (IN x (ZP p))) (AND (IN ,PR-NORD NN) (IS-ELEMENT-ORDER (PRUEFER p) ,(pr-qcl 'x) (power p ,PR-NORD)))))))))))
(dk-peel!)
(pr-qp-setup!)
(dk-conj-close!
  (lambda ()
    (let ((lk (dk-landed (lambda () (di)))))
      (if (dk-asm? '(IN x (ZP p)))
          ;; x in Z_p: [x] is the identity, of order 1
          (begin
            (pr-order-setup!)
            (fact 'nn-one-in) (fact 'rr-one-in)
            (let ((g1 (dk-cite! 'qp-gpow-embed 1 'p 'x)))
              (fact 'qq-one-in)
              (dk-cite! 'qp-embed-one 'p)
              (dk-have! (list 'IN (list 'GPOW PR-QG 'x 1) '(ZP p))
                (lambda () (subst g1) (subst (list '= (pr-em 1) '(ONE (QP-FIELD p))))
                           (subst (have-f! (list '= (pr-mul '(ONE (QP-FIELD p)) 'x) 'x) (lambda () (pr-crs! '(x)))))
                           (dk-close-if-asm!))))
            (mac 'PRUEFER)
            (mac 'IS-ELEMENT-ORDER)
            (dk-conj-close!
              (lambda ()
                (let ((g0 (dk-goal)))
                  (cond ((dk-ctx-form g0) (ass))
                        ((dk-head-is? g0 '<=) (dk-ineq! '(IN 1 RR)))
                        ((dk-head-is? g0 '=)
                         (dk-meta-iff-l! (dk-cite! 'qag-pow-iden-iff 1 PR-QG '(ZP p) 'x))
                         (dk-close-if-asm!))
                        (#t (dk-peel!) (dk-close-if-asm!)))))))
          ;; x not in Z_p: |x| = 2^m with m >= 0, -ord_p(x) = m, Remark 1.33
          (let* ((nd (dk-cite! 'nv-integers-domain PR-QF))
                 (nz (dk-cite! 'nv-domain-zero PR-QF '(NV-INTEGERS (QP-FIELD p))))
                 (z0 (dk-rewrite-h! nz '(NV-INTEGERS (QP-FIELD p)) '(ZP p))))
            (dk-have! '(NOT (= x (ZERO (QP-FIELD p))))
              (lambda () (let ((e0 (car (dk-landed (lambda () (di))))))
                           (dk-rewrite-h! z0 '(ZERO (QP-FIELD p)) 'x)
                           (ai (dk-ctx-form '(NOT (IN x (ZP p))))))))
            (let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'qo-abs-power 'p 'x))))
                   (ax (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (pr-ab 'x)))) (dk-asms))))
              (dk-cite! 'zz-in-rr m)
              (fact 'rr-zero-in) (fact 'rr-one-in)
              (dk-have! '(IN 2 RR) (lambda () (from-context!)))
              (dk-have-cases! (list '<= 0 m) (list '<= 0 m)
                (lambda () (dk-close-if-asm!))
                (lambda ()
                  (dk-cite! 'rr-not-le-lt 0 m)
                  (dk-have! '(< 1 2) (lambda () (dk-ineq!)))
                  (dk-have! '(< 0 2) (lambda () (dk-ineq!)))
                  (dk-cite! 'rpow-star-mono-exp 2 m 0)
                  (dk-cite! 'rpow-star-zero 2)
                  (dk-cite! 'rpow-star-in-rr 2 m)
                  (dk-cite! 'rpow-star-in-rr 2 0)
                  (dk-have! (list '<= (pr-fn 'x) 1)
                    (lambda () (subst '(== (FNRM (QP-FIELD p)) (QP-ABS p))) (subst ax)
                               (dk-ineq! (list '< (list 'rpow-star 2 m) (list 'rpow-star 2 0)) (list '= (list 'rpow-star 2 0) 1)
                                         (list 'IN (list 'rpow-star 2 m) 'RR) (list 'IN (list 'rpow-star 2 0) 'RR))))
                  (pr-zp-in! 'x)
                  (ai (dk-ctx-form '(NOT (IN x (ZP p)))))))
              (dk-cite! 'zz-nonneg-in-nn m)
              (dk-cite! 'qo-ord-value 'p 'x m)
              (dk-have! (list '= PR-NORD m) (lambda () (subst (list '= '((QP-ORD p) x) (list '- m))) (crs)))
              (dk-cite! 'qp-pruefer-order 'p 'x m)
              (subst (list '= PR-NORD m))
              (dk-conj-close! (lambda () (dk-close-if-asm!)))))))))
(pr-done! 'ccr-5-24)
(gloss! 'ccr-5-24 "Proposition 5.24: the class of x in the Pruefer group Q_p/Z_p has order 1 if x is in Z_p, and order p^(-ord_p x) otherwise.")

;;; =====================================================================
;;; (5) Corollary 5.25: Q_p/Z_p is isomorphic to the group of the p-power roots of unity.
;;; =====================================================================
;;; a multiplicative map into C carrying the group law: it carries powers to powers
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL gq (IMPLIES (IS-GROUP gq) (FORALL lb
  (IMPLIES (FORALL c (IMPLIES (IN c (CARR gq)) (IN (lb c) CC)))
  (IMPLIES (= (lb (IDEN gq)) 1)
