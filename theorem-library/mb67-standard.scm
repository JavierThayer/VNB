;;;   countably-separated-of-injection Proposition 5.36, sufficiency
;;; Vocabulary: mb67-vocab.scm (IS-COUNTABLY-SEPARATED, GRAPH-OF).  Library: measure.  Helper prefixes mr- (copied)
;;; and mcs-.
;;;
;;; Load window: after mb67-vocab; the product sigma-algebra (rectangle-in-product-sigma,
;;; product-sigma-is-sigma-algebra), the sigma-algebra laws, pushforward-measure (pfw-open-borel), nn-pairing.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define (mcs-Cx a) (list 'COMPLEMENT-IN 'xs a))
(define (mcs-Cy a) (list 'COMPLEMENT-IN 'ys a))
(define (mcs-cart-parts! w A B)      ; w in CARTESIAN(A, B): its coordinates in A and B
  (dk-split-all! (list (mr-chain! (dk-cite! 'cartesian-nth w A B)))))
(define (mcs-cart-in! w A B)         ; w = [w1, w2] and w1 in A, w2 in B in context: w in CARTESIAN(A, B)
  (let ((iff (dk-cite! 'cartesian-membership-nth A B w)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
    (mr-iff-back! iff)))

;;; ======================================================================
;;; LEMMA 5.33: the graph of a measurable map into a countably separated space is measurable
;;; ======================================================================
(define mcs-PS '(PRODUCT-SIGMA xs ca ys cb))
(define mcs-XY '(CARTESIAN xs ys))
(sp (make-wff '(FORALL xs (FORALL ca (FORALL ys (FORALL cb (FORALL phi (IMPLIES (IS-MEASURABLE-MAP xs ca ys cb phi)
   (IMPLIES (IS-COUNTABLY-SEPARATED ys cb) (IN (GRAPH-OF xs ys phi) (PRODUCT-SIGMA xs ca ys cb)))))))))))
(dk-peel!)
(define mcs-mm (mr-iff-parts! (dk-cite! 'is-measurable-map 'xs 'ca 'ys 'cb 'phi)))
(define mcs-pre (list-ref mcs-mm 3))
(define mcs-cs (mr-iff-parts! (dk-cite! 'is-countably-separated 'ys 'cb)))
(define mcs-E (dk-skolem! (cadr mcs-cs)))
(dk-split-all!)
(define mcs-sep (mr-find 'csep (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mcs-E) (dk-contains? f 'OR))) (dk-asms)))
(dk-cite! 'sigma-algebra-ambient-set 'xs 'ca)
(dk-cite! 'sigma-algebra-ambient-set 'ys 'cb)
(dk-cite! 'product-sigma-is-sigma-algebra 'xs 'ca 'ys 'cb)
(define (mcs-P k) (list 'SEP 'x_ 'xs (list 'IN '(phi x_) (list mcs-E k))))
(define (mcs-R k) (list 'UNION (list 'CARTESIAN (mcs-P k) (mcs-Cy (list mcs-E k))) (list 'CARTESIAN (mcs-Cx (mcs-P k)) (list mcs-E k))))
(define (mcs-k! k)                   ; k in NN: E(k) in cb, P(k) in ca, their complements, R(k) in PS
  (if (not (dk-asm? (list 'IN (mcs-R k) mcs-PS)))
      (begin
        (dk-cite! 'fun-apply-type-c mcs-E 'NN 'cb k)
        (dk-apply! mcs-pre (list mcs-E k))
        (dk-cite! 'sigma-algebra-complement-closed 'ys 'cb (list mcs-E k))
        (dk-cite! 'sigma-algebra-complement-closed 'xs 'ca (mcs-P k))
        (dk-cite! 'rectangle-in-product-sigma 'xs 'ca 'ys 'cb (mcs-P k) (mcs-Cy (list mcs-E k)))
        (dk-cite! 'rectangle-in-product-sigma 'xs 'ca 'ys 'cb (mcs-Cx (mcs-P k)) (list mcs-E k))
        (dk-cite! 'sigma-algebra-union-closed-2 mcs-XY mcs-PS (list 'CARTESIAN (mcs-P k) (mcs-Cy (list mcs-E k))) (list 'CARTESIAN (mcs-Cx (mcs-P k)) (list mcs-E k)))))
  (mcs-R k))
(define mcs-RL (list 'VNB-LAMBDA 'mck_ 'NN (mcs-R 'mck_)))
(dk-cite! 'nn-is-set)
(dk-have! (list 'IN mcs-RL (list 'FUN 'NN mcs-PS))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (mcs-k! k)
                                 (mr-close-open!))))))
              (dk-opened (lambda () (lam-t))))))
(define mcs-U (list 'BIG-UNION 'n_ 'NN (list mcs-RL 'n_)))
(dk-cite! 'sigma-algebra-union-closed mcs-XY mcs-PS mcs-RL)
(dk-cite! 'sigma-algebra-complement-closed mcs-XY mcs-PS mcs-U)
(define mcs-G '(GRAPH-OF xs ys phi))
(define mcs-Gs '(SEP grp_ (CARTESIAN xs ys) (= (phi (NTH 1 grp_)) (NTH 2 grp_))))
(define (mcs-pt! p)                  ; p in xs x ys: p = [p1, p2], p1 in xs, p2 in ys, phi(p1) in ys
  (let ((p1 (list 'NTH 1 p)) (p2 (list 'NTH 2 p)))
    (if (not (dk-asm? (list 'IN (list 'phi p1) 'ys)))
        (begin
          (mcs-cart-parts! p 'xs 'ys)
          (dk-cite! 'cartesian-pair-eq p 'xs 'ys)
          (dk-cite! 'fun-apply-type-c 'phi 'xs 'ys p1)))
    (list p1 p2)))
(dk-have! (list '= mcs-G (list 'COMPLEMENT-IN mcs-XY mcs-U))
  (lambda ()
    (mac 'GRAPH-OF)
    (mr-ext2! mcs-Gs (list 'COMPLEMENT-IN mcs-XY mcs-U)
      (lambda (p)
        (let* ((eq0 (mr-sep-parts! (list 'IN p mcs-Gs)))
               (pp (mcs-pt! p)) (p1 (car pp)) (p2 (cadr pp)))
          (mac 'complement-in-membership)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (begin
                    (di)
                    (let* ((ka (mr-bu-open! p mcs-U)) (k (car ka)))
                      (mcs-k! k)
                      (dk-lam-b-h! (cdr ka))
                      (mr-iff-parts! (dk-cite! 'union-membership (list 'CARTESIAN (mcs-P k) (mcs-Cy (list mcs-E k))) (list 'CARTESIAN (mcs-Cx (mcs-P k)) (list mcs-E k)) p))
                      (use-cases (list 'OR (list 'IN p (list 'CARTESIAN (mcs-P k) (mcs-Cy (list mcs-E k)))) (list 'IN p (list 'CARTESIAN (mcs-Cx (mcs-P k)) (list mcs-E k))))
                        (lambda ()
                          (mcs-cart-parts! p (mcs-P k) (mcs-Cy (list mcs-E k)))
                          (mr-sep-parts! (list 'IN p1 (mcs-P k)))
                          (mr-iff-parts! (dk-cite! 'complement-in-membership 'ys (list mcs-E k) p2))
                          (dk-rewrite-h! (list 'IN (list 'phi p1) (list mcs-E k)) (list 'phi p1) p2)
                          (ai (list 'NOT (list 'IN p2 (list mcs-E k)))))
                        (lambda ()
                          (mcs-cart-parts! p (mcs-Cx (mcs-P k)) (list mcs-E k))
                          (mr-iff-parts! (dk-cite! 'complement-in-membership 'xs (mcs-P k) p1))
                          (dk-rewrite-h! (list 'IN p2 (list mcs-E k)) p2 (list 'phi p1))
                          (dk-have! (list 'IN p1 (mcs-P k)) (lambda () (in-sep! (lambda () (mr-close-open!)))))
                          (ai (list 'NOT (list 'IN p1 (mcs-P k)))))))))))))
      (lambda (p)
        (mr-iff-parts! (dk-cite! 'complement-in-membership mcs-XY mcs-U p))
        (let* ((pp (mcs-pt! p)) (p1 (car pp)) (p2 (cadr pp)) (q (list 'phi p1)))
          (in-sep!
            (lambda ()
              (pbc)
              (let* ((k (dk-skolem! (dk-apply! mcs-sep q p2)))
                     (_0 (dk-split-all!)))
                (mcs-k! k)
                (dk-have! (list 'IN p mcs-U)
                  (lambda ()
                    (for-each (lambda (l) (if (not (sequent-node-grounded? l))
                                              (begin (dk-focus! l)
                                                     (if (dk-asm? (dk-goal)) (ass)
                                                         (begin
                                                           (dk-lam-b!)
                                                           (mac 'union-membership)
                                                           (use-cases (mr-find 'csor (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f q) (dk-contains? f p2))) (dk-asms))
                                                             (lambda ()
                                                               (oi-l)
                                                               (dk-split-all!)
                                                               (dk-have! (list 'IN p1 (mcs-P k)) (lambda () (in-sep! (lambda () (mr-close-open!)))))
                                                               (dk-have! (list 'IN p2 (mcs-Cy (list mcs-E k)))
                                                                 (lambda () (mac 'complement-in-membership) (dk-conj-close! dk-ass!)))
                                                               (mcs-cart-in! p (mcs-P k) (mcs-Cy (list mcs-E k)))
                                                               (mr-close-open!))
                                                             (lambda ()
                                                               (oi-r)
                                                               (dk-split-all!)
                                                               (dk-have! (list 'IN p1 (mcs-Cx (mcs-P k)))
                                                                 (lambda () (mac 'complement-in-membership)
                                                                   (dk-conj-close!
                                                                     (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                    (begin (di) (mr-sep-parts! (list 'IN p1 (mcs-P k))) (ai (list 'NOT (list 'IN q (list mcs-E k))))))))))
                                                               (mcs-cart-in! p (mcs-Cx (mcs-P k)) (list mcs-E k))
                                                               (mr-close-open!))))))))
                              (dk-opened (lambda () (bu-mi k))))))
                (ai (list 'NOT (list 'IN p mcs-U)))))))))
    (mr-close-open!)))
(subst (list '= mcs-G (list 'COMPLEMENT-IN mcs-XY mcs-U)))
(mr-close-open!)
(qed 'graph-measurable)
(topic! 'graph-measurable 'analysis)

;;; ======================================================================
;;; PROPOSITION 5.36, sufficiency: an injective measurable map into a separable metric space separates points
;;; ======================================================================
(define mcs-inj '(FORALL x (IMPLIES (IN x ys) (FORALL y (IMPLIES (IN y ys) (IMPLIES (= (psi x) (psi y)) (= x y)))))))
(sp (make-wff (list 'FORALL 'ys (list 'FORALL 'cb (list 'FORALL 'mz (list 'IMPLIES '(IS-SEPARABLE mz) (list 'FORALL 'psi
  (list 'IMPLIES '(IS-MEASURABLE-MAP ys cb (PTS mz) (BOREL-SETS mz) psi) (list 'IMPLIES mcs-inj '(IS-COUNTABLY-SEPARATED ys cb))))))))))
(dk-peel!)
(define mcs-mm2 (mr-iff-parts! (dk-cite! 'is-measurable-map 'ys 'cb '(PTS mz) '(BOREL-SETS mz) 'psi)))
(define mcs-pre2 (list-ref mcs-mm2 3))
(define mcs-d (mr-sep-open! 'mz))
(define mcs-dense (mr-find 'dense (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mcs-d) (dk-contains? f 'POS-RR))) (dk-asms)))
(dk-cite! 'nn-is-set)
(define (mcs-c k) (list mcs-d (list 'NNFST k)))
(define (mcs-rad k) (list 'RECIP (list '+ (list 'NNSND k) 1)))
(define (mcs-ball k) (list 'BALL 'mz (mcs-c k) (mcs-rad k)))
(define (mcs-Pk k) (list 'SEP 'x_ 'ys (list 'IN '(psi x_) (mcs-ball k))))
(define (mcs-ball! k)                ; k in NN: the centre in PTS mz, the radius POS-RR, the ball open and Borel, P(k) in cb
  (if (not (dk-asm? (list 'IN (mcs-Pk k) 'cb)))
      (let* ((c (mcs-c k)) (r (mcs-rad k)))
        (dk-cite! 'nnfst-type k) (dk-cite! 'nnsnd-type k)
        (dk-cite! 'fun-apply-type-c mcs-d 'NN '(PTS mz) (list 'NNFST k))
        (mr-recip! (list 'NNSND k))
        (dk-cite! 'rr-pos-rr-in-rr r) (dk-cite! 'rr-lt-of-pos-rr r)
        (if (not (dk-asm? (list '<= 0 r))) (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR)))))
        (if (not (dk-asm? (list 'NOT (list '= 0 r)))) (mr-ne! 0 r (list '< 0 r)))
        (mr-chain! (dk-fact! 'ball-is-open 'mz c r))
        (dk-cite! 'pfw-open-borel 'mz (mcs-ball k))
        (dk-apply! mcs-pre2 (mcs-ball k)))))
(define mcs-FL (list 'VNB-LAMBDA 'mck_ 'NN (mcs-Pk 'mck_)))
(dk-have! (list 'IN mcs-FL '(FUN NN cb))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (mcs-ball! k)
                                 (mr-close-open!))))))
              (dk-opened (lambda () (lam-t))))))
(let ((iff (dk-cite! 'is-countably-separated 'ys 'cb)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew mcs-FL)
                (mr-and-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let* ((lk (dk-peel!))
                               (xs2 (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ys))) lk)))
                               (x (car xs2)) (y (cadr xs2))
                               (px (list 'psi x)) (py (list 'psi y))
                               (dxy (list '(DIST mz) px py)))
                          (dk-cite! 'fun-apply-type-c 'psi 'ys '(PTS mz) x)
                          (dk-cite! 'fun-apply-type-c 'psi 'ys '(PTS mz) y)
                          (dk-have! (list 'NOT (list '= px py))
                            (lambda () (di) (dk-apply! mcs-inj x y) (ai (list 'NOT (list '= x y)))))
                          (dk-cite! 'metric-dist-real 'mz px py)
                          (dk-cite! 'metric-pos 'mz px py)
                          (dk-have! (list 'NOT (list '= 0 dxy))
                            (lambda ()
                              (di)
                              (dk-have! (list '= dxy 0) (lambda () (subst (list '= dxy 0)) (rfl)))
                              (mr-chain! (dk-cite! 'metric-zero-eq 'mz px py))
                              (ai (list 'NOT (list '= px py)))))
                          (dk-have! (list 'AND (list '<= 0 dxy) (list 'NOT (list '= 0 dxy))) (lambda () (dk-conj-close! dk-ass!)))
                          (mr-chain! (dk-fact! 'rr-le-ne-lt 0 dxy))
                          (dk-cite! 'rr-pos-rr-of-lt dxy)
                          (let* ((h (dk-halve! dxy))
                                 (m (dk-skolem! (dk-cite! 'nn-recip-succ-small h)))
                                 (_0 (dk-split-all!))
                                 (r (mr-recip! m))
                                 (n (dk-skolem! (dk-apply! mcs-dense px r)))
                                 (_1 (dk-split-all!))
                                 (k (list 'NNPAIR n m))
                                 (dn (list mcs-d n)))
                            (dk-cite! 'nnpair-type n m)
                            (dk-cite! 'nnfst-nnpair n m) (dk-cite! 'nnsnd-nnpair n m)
                            (mcs-ball! k)
                            (dk-cite! 'fun-apply-type-c mcs-d 'NN '(PTS mz) n)
                            (dk-cite! 'metric-sym 'mz px dn)
                            (dk-cite! 'metric-dist-real 'mz px dn)
                            (dk-cite! 'metric-dist-real 'mz dn px)
                            (dk-cite! 'metric-dist-real 'mz dn py)
                            (dk-cite! 'rr-pos-rr-in-rr r)
                            (ew k)
                            (mr-and-close!
                              (lambda ()
                                (cond
                                  ((dk-asm? (dk-goal)) (ass))
                                  ((dk-head-is? (dk-goal) 'OR)
                                   (oi-l)
                                   (mr-and-close!
                                     (lambda ()
                                       (if (dk-head-is? (dk-goal) 'NOT)
                                           (begin
                                             (di)
                                             (dk-lam-b-h! (mr-find 'yin (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) y) (dk--redex? (caddr f)))) (dk-asms)))
                                             (mr-sep-parts! (list 'IN y (mcs-Pk k)))
                                             (let* ((bp (mr-iff-parts! (dk-cite! 'ball-membership 'mz (mcs-c k) (mcs-rad k) py)))
                                                    (le (mr-find 'ble (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f py))) bp)))
                                               (dk-rewrite-h! le (list 'NNFST k) n)
                                               (dk-rewrite-h! (list '<= (list '(DIST mz) dn py) (list 'RECIP (list '+ (list 'NNSND k) 1))) (list 'NNSND k) m)
                                               (dk-cite! 'metric-triangle 'mz px dn py)
                                               (dk-absurd! (list '<= dxy (list '+ (list '(DIST mz) px dn) (list '(DIST mz) dn py)))
