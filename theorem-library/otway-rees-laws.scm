;;; otway-rees-laws.scm -- THE OTWAY-REES PROTOCOL: Lemma 7.2, Theorem 7.4, Propositions 7.5, 7.6,
;;; Corollary 7.7 (Thayer, Herzog, Guttman, ~/docs/jcs_strand_spaces.pdf, section 7), on the user's model.
;;; Vocabulary: structure-library/otway-rees.scm.  Agent SB-3, wave MAP-1026, 2026-10-26.  Destination:
;;; theorem-library/otway-rees-laws.scm.  Library: strand.  Helper prefix orl-; the trace-reading and
;;; literal-message helpers are the proposed kit addition sb3-helpers.scm (dks-).
;;;
;;; NOTATION: orp the Otway-Rees space; sp = ISPACE(SK-INF(orp)), T, K, A its tokens, keys, messages;
;;; KXS = LTKEY(orp)(X).
;;;
;;; LOAD WINDOW: after structure-library/otway-rees, theorem-library/strand-honesty-laws (SB-2: 6.12, 6.13,
;;; adversary-sent-shapes, key-ideal-gen-subterms) and the strand-ideals laws (SB-1).

(dks-use! '(ISPACE (SK-INF orp)))
(define orl-sp '(ISPACE (SK-INF orp)))
(define orl-isp '(SK-INF orp))
(define orl-T '(TOKENS (ISPACE (SK-INF orp))))
(define orl-K '(KEYS (ISPACE (SK-INF orp))))
(define orl-A '(MSG-SET (TOKENS (ISPACE (SK-INF orp))) (KEYS (ISPACE (SK-INF orp)))))
(define orl-names '(SK-NAMES orp))
(define (orl-ka x) `((LTKEY orp) ,x))

(define (orl-init-trace a b n m k)
  `(LIST (LIST SENT (LST (LIST ,m ,a ,b (ENCR (LST (LIST ,n ,m ,a ,b)) ,(orl-ka a)))))
         (LIST RECEIVED (LST (LIST ,m (ENCR (LST (LIST ,n ,k)) ,(orl-ka a)))))))
(define (orl-resp-trace a b n m k h g)
  `(LIST (LIST RECEIVED (LST (LIST ,m ,a ,b ,h)))
         (LIST SENT (LST (LIST ,m ,a ,b ,h (ENCR (LST (LIST ,n ,m ,a ,b)) ,(orl-ka b)))))
         (LIST RECEIVED (LST (LIST ,m ,g (ENCR (LST (LIST ,n ,k)) ,(orl-ka b)))))
         (LIST SENT (LST (LIST ,m ,g)))))
(define (orl-serv-trace a b na nb m k)
  `(LIST (LIST RECEIVED (LST (LIST ,m ,a ,b (ENCR (LST (LIST ,na ,m ,a ,b)) ,(orl-ka a))
                                        (ENCR (LST (LIST ,nb ,m ,a ,b)) ,(orl-ka b)))))
         (LIST SENT (LST (LIST ,m (ENCR (LST (LIST ,na ,k)) ,(orl-ka a)) (ENCR (LST (LIST ,nb ,k)) ,(orl-ka b)))))))

;;; -----------------------------------------------------------------------
;;; The shared-key space.

(sp (make-wff '(FORALL orp (IMPLIES (IS-SK-SPACE orp)
  (AND (IS-INFILTRATED-SPACE (SK-INF orp))
  (AND (IS-STRAND-SPACE (ISPACE (SK-INF orp)))
  (AND (IN (SK-NAMES orp) SET)
  (AND (IN (LTKEY orp) (FUN (SK-NAMES orp) (KEYS (ISPACE (SK-INF orp)))))
  (AND (FORALL x (IMPLIES (IN x (SK-NAMES orp)) (IN x (TOKENS (ISPACE (SK-INF orp))))))
  (AND (FORALL x (IMPLIES (IN x (SK-NAMES orp)) (NOT (IN x (KEYS (ISPACE (SK-INF orp)))))))
  (AND (FORALL x (FORALL y (IMPLIES (IN x (SK-NAMES orp)) (IMPLIES (IN y (SK-NAMES orp))
         (IMPLIES (= ((LTKEY orp) x) ((LTKEY orp) y)) (= x y))))))
       (FORALL x (IMPLIES (IN x (SK-NAMES orp))
         (= ((KINV (ISPACE (SK-INF orp))) ((LTKEY orp) x)) ((LTKEY orp) x)))))))))))))))
(dk-peel!)
(dk-have! '(IS-INFILTRATED-SPACE (SK-INF orp))
  (lambda () (mac-h 'is-sk-space '(IS-SK-SPACE orp)) (dk-split-all!) (dk-ass!)))
(dks-project! 'is-infiltrated-space '(IS-INFILTRATED-SPACE (SK-INF orp)) '(IS-STRAND-SPACE (ISPACE (SK-INF orp))))
(mac-h 'is-sk-space '(IS-SK-SPACE orp))
(dk-split-all!)
(dk-conj-close! (lambda () (if (not (dk-ass!)) (error "sk-space-parts: open conjunct" (dk-goal)))))
(qed 'sk-space-parts)

(define orl-names-tokens `(FORALL x (IMPLIES (IN x ,orl-names) (IN x ,orl-T))))
(define orl-names-nonkeys `(FORALL x (IMPLIES (IN x ,orl-names) (NOT (IN x ,orl-K)))))
(define orl-ltk-inj `(FORALL x (FORALL y (IMPLIES (IN x ,orl-names) (IMPLIES (IN y ,orl-names)
                       (IMPLIES (= ((LTKEY orp) x) ((LTKEY orp) y)) (= x y)))))))
(define orl-ltk-sym `(FORALL x (IMPLIES (IN x ,orl-names) (= ((KINV ,orl-sp) ((LTKEY orp) x)) ((LTKEY orp) x)))))

;; IS-SK-SPACE orp in context: its parts and the strand space's
(define (orl-space!)
  (if (not (dk-asm? `(IS-STRAND-SPACE ,orl-sp)))
      (begin
        (dks-fact-split! 'sk-space-parts 'orp)
        (dks-fact-split! 'strand-space-parts orl-sp))))

;; a name X: X in T, X not in K, LTKEY(X) in K (and symmetric)
(define (orl-name! x)
  (if (not (dk-asm? `(IN ,x ,orl-T))) (dk-apply! orl-names-tokens x))
  (if (not (dk-asm? `(NOT (IN ,x ,orl-K)))) (dk-apply! orl-names-nonkeys x))
  (if (not (dk-asm? `(IN ,(orl-ka x) ,orl-K))) (fact 'fun-apply-type-c '(LTKEY orp) orl-names orl-K x)))

;; a text X: its three conjuncts
(define (orl-text! x)
  (if (not (dk-asm? `(NOT (IN ,x ,orl-K))))
      (begin
        (dks-project! 'is-or-text `(IS-OR-TEXT orp ,x)
          `(AND (IN ,x ,orl-T) (AND (NOT (IN ,x ,orl-names)) (NOT (IN ,x ,orl-K)))))
        (dk-split-all!))))

(define (orl-text x) `(IS-OR-TEXT orp ,x))
(define (orl-conjs kind args lit)
  (let ((s (car args)) (a (cadr args)) (b (caddr args)))
    (case kind
      ((init) (list `(IN ,a ,orl-names) `(IN ,b ,orl-names) (orl-text (list-ref args 3)) (orl-text (list-ref args 4))
                    `(IN ,(list-ref args 5) ,orl-K) `(= ,s ,lit)))
      ((resp) (list `(IN ,a ,orl-names) `(IN ,b ,orl-names) (orl-text (list-ref args 3)) (orl-text (list-ref args 4))
                    `(IN ,(list-ref args 5) ,orl-K) `(IN ,(list-ref args 6) ,orl-A) `(IN ,(list-ref args 7) ,orl-A)
                    `(NOT (= ,(list-ref args 3) ,(list-ref args 4)))
                    `(NOT (IS-SUBTERM ,orl-T ,orl-K ,(list-ref args 3) ,(list-ref args 6))) `(= ,s ,lit)))
      (else (let ((k (list-ref args 6)))
              (list `(IN ,a ,orl-names) `(IN ,b ,orl-names) (orl-text (list-ref args 3)) (orl-text (list-ref args 4))
                    (orl-text (list-ref args 5)) `(IN ,k ,orl-K) `(NOT (IN ,k (ADV-TOKENS ,orl-isp)))
                    `(FORALL orsx_ (IMPLIES (IN orsx_ ,orl-names) (NOT (= ,k ((LTKEY orp) orsx_)))))
                    `(= ((KINV ,orl-sp) ,k) ,k) `(= ,s ,lit)))))))

(define (orl-kind hyp) (case (car hyp) ((IS-OR-INIT) 'init) ((IS-OR-RESP) 'resp) (else 'serv)))

;; HYP = (IS-OR-INIT / -RESP / -SERV orp S ...) in context: land its conjuncts, the typings of its names,
;; texts and keys, its literal messages typed in A; return the trace literal
(define (orl-open! hyp)
  (let* ((kind (orl-kind hyp))
         (args (cddr hyp))
         (s (car args))
         (lit (case kind
                ((init) (apply orl-init-trace (cdr args)))
                ((resp) (apply orl-resp-trace (cdr args)))
                (else (apply orl-serv-trace (cdr args))))))
    (orl-space!)
    (if (not (dk-asm? `(= ,s ,lit)))
        (begin
          (dks-project! (case kind ((init) 'is-or-init) ((resp) 'is-or-resp) (else 'is-or-serv)) hyp
                        (dks-and (orl-conjs kind args lit)))
          (dk-split-all!)))
    (let ((a (cadr args)) (b (caddr args)))
      (orl-name! a) (orl-name! b)
      (case kind
        ((init) (orl-text! (list-ref args 3)) (orl-text! (list-ref args 4)))
        ((resp) (orl-text! (list-ref args 3)) (orl-text! (list-ref args 4)))
        (else (orl-text! (list-ref args 3)) (orl-text! (list-ref args 4)) (orl-text! (list-ref args 5))))
      (let ((k (list-ref args (if (eq? kind 'serv) 6 5))))
        (if (not (dk-asm? `(IN ,k ,orl-T))) (dk-apply! (dk-cite! 'keys-in-tokens orl-sp) k))))
    (for-each (lambda (e) (dks-msg! (caddr e))) (cdr lit))
    lit))

;;; -----------------------------------------------------------------------
;;; LEMMA 7.2: the server, initiator and responder strands are pairwise disjoint (on this model: no trace is
;;; of two kinds -- the lengths differ (2, 4, 2) and an initiator's trace begins SENT, a server's RECEIVED).

(define (orl-disjoint! h1 h2)
  (di)
  (let* ((l1 (orl-open! h1))
         (l2 (orl-open! h2)))
    (dk-cite! 'sent-ne-received)
    (dk-have! `(= ,l1 ,l2) (lambda () (subst `(= ,l1 s)) (dk-ass!)))
    (dks-lit-neq! l1 l2)))

(sp (make-wff '(FORALL orp (FORALL s (FORALL a (FORALL b (FORALL n (FORALL m (FORALL k
  (FORALL a2 (FORALL b2 (FORALL n2 (FORALL m2 (FORALL k2 (FORALL h (FORALL g
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IS-OR-INIT orp s a b n m k)
    (NOT (IS-OR-RESP orp s a2 b2 n2 m2 k2 h g))))))))))))))))))))
(dk-peel!)
(orl-disjoint! '(IS-OR-INIT orp s a b n m k) '(IS-OR-RESP orp s a2 b2 n2 m2 k2 h g))
(qed 'or-init-resp-disjoint)

(sp (make-wff '(FORALL orp (FORALL s (FORALL a (FORALL b (FORALL n (FORALL m (FORALL k
  (FORALL a2 (FORALL b2 (FORALL n2 (FORALL o2 (FORALL m2 (FORALL k2
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IS-OR-INIT orp s a b n m k)
    (NOT (IS-OR-SERV orp s a2 b2 n2 o2 m2 k2)))))))))))))))))))
(dk-peel!)
(orl-disjoint! '(IS-OR-INIT orp s a b n m k) '(IS-OR-SERV orp s a2 b2 n2 o2 m2 k2))
(qed 'or-init-serv-disjoint)

(sp (make-wff '(FORALL orp (FORALL s (FORALL a (FORALL b (FORALL n (FORALL m (FORALL k (FORALL h (FORALL g
  (FORALL a2 (FORALL b2 (FORALL n2 (FORALL o2 (FORALL m2 (FORALL k2
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IS-OR-RESP orp s a b n m k h g)
    (NOT (IS-OR-SERV orp s a2 b2 n2 o2 m2 k2)))))))))))))))))))))
(dk-peel!)
(orl-disjoint! '(IS-OR-RESP orp s a b n m k h g) '(IS-OR-SERV orp s a2 b2 n2 o2 m2 k2))
(qed 'or-resp-serv-disjoint)

;;; -----------------------------------------------------------------------
;;; The Otway-Rees space: its strand law, and the regular strands by kind.

(define orl-law
  `(FORALL orqi_ (IMPLIES (IN orqi_ (IDS ,orl-sp))
     (OR (IN orqi_ (ADV-IDS ,orl-isp))
     (OR (FORSOME orqa_ (FORSOME orqb_ (FORSOME orqn_ (FORSOME orqm_ (FORSOME orqk_
           (IS-OR-INIT orp ((STRAND-MAP ,orl-sp) orqi_) orqa_ orqb_ orqn_ orqm_ orqk_))))))
     (OR (FORSOME orqa_ (FORSOME orqb_ (FORSOME orqn_ (FORSOME orqm_ (FORSOME orqk_ (FORSOME orqh_ (FORSOME orqg_
           (IS-OR-RESP orp ((STRAND-MAP ,orl-sp) orqi_) orqa_ orqb_ orqn_ orqm_ orqk_ orqh_ orqg_))))))))
         (FORSOME orqa_ (FORSOME orqb_ (FORSOME orqn_ (FORSOME orqo_ (FORSOME orqm_ (FORSOME orqk_
           (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) orqi_) orqa_ orqb_ orqn_ orqo_ orqm_ orqk_)))))))))))))

;; IS-OR-SPACE orp in context: IS-SK-SPACE, the parts, the strand law (returned)
(define (orl-or-space!)
  (dks-project! 'is-or-space '(IS-OR-SPACE orp) '(IS-SK-SPACE orp))
  (orl-space!)
  (if (not (dk-asm? orl-law)) (dks-project! 'is-or-space '(IS-OR-SPACE orp) orl-law))
  orl-law)

;; the identifier ID, (NOT (IN ID (ADV-IDS isp))) in context: HANDLER gets (kind hyp lit) on each of
;; the three regular kinds, the strand opened
(define (orl-strand-cases! id handler)
  (let ((o (dk-apply! (orl-or-space!) id)))
    (dks-or-each! o
      (lambda (d)
        (if (dk-head-is? d 'IN)
            (ai `(NOT (IN ,id (ADV-IDS ,orl-isp))))
            (let* ((cnt (let loop ((f d) (k 0)) (if (dk-head-is? f 'FORSOME) (loop (caddr f) (+ k 1)) k)))
                   (pred (let loop ((f d)) (if (dk-head-is? f 'FORSOME) (loop (caddr f)) (car f))))
                   (ws (dks-trace-witnesses! d cnt))
                   (hyp (dk-pick (lambda (f) (and (pair? f) (eq? (car f) pred) (dk-contains? f (car (last-pair ws))))) "the strand"))
                   (lit (orl-open! hyp)))
              (handler (orl-kind hyp) hyp lit)))))))

;; the regular node N: land N's identifier not adversarial
(define (orl-regular! n)
  (dks-project! 'is-regular-node `(IS-REGULAR-NODE ,orl-isp ,n) `(NOT (IN (NTH 2 ,n) (ADV-IDS ,orl-isp)))))

;;; -----------------------------------------------------------------------
;;; Ideals of atoms: an encryption in I_k[S] has its plaintext in I_k[S] and its key in k.

(sp (make-wff '(FORALL T (FORALL K (FORALL ks (FORALL S (FORALL h (FORALL y
   (IMPLIES (IS-TOKEN-SET T) (IMPLIES (IN K SET)
    (IMPLIES (FORALL w (IMPLIES (IN w ks) (IN w K)))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (IN z T)))
      (IMPLIES (IN h (MSG-SET T K)) (IMPLIES (IN y K)
       (IMPLIES (IN (ENCR h y) (KEY-IDEAL-GEN T K ks S))
                (AND (IN h (KEY-IDEAL-GEN T K ks S)) (IN y ks)))))))))))))))))
(let* ((landed (dk-peel!))
       (subT (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'S))) landed))
       (e '(ENCR h y)))
  (fact 'token-set-is-set 'T)
  (dk-have! '(FORALL z (IMPLIES (IN z S) (IN z (MSG-SET T K))))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (dk-apply! subT z)
        (fact 'token-in-msgs 'T 'K z)
        (dk-ass!))))
  (fact 'membership-implies-sethood 'h '(MSG-SET T K))
  (fact 'membership-implies-sethood 'y 'K)
  (let* ((o (dk-cite! 'key-ideal-gen-cases 'T 'K 'ks 'S e))
         (d1 (cadr o)) (d2 (cadr (caddr o))))
    (dks-or-each! o
      (lambda (d)
        (cond ((equal? d d1)
               (dk-apply! subT e)
               (ai (dk-cite! 'token-not-encr 'T 'h 'y)))
              ((equal? d d2)
               (let ((l (dk-skolem! d)))
                 (ai (dk-cite! 'encr-ne-list 'h 'y l))))
              (#t
               (let* ((h1 (dk-skolem! d))
                      (ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f h1))) "the key"))
                      (y1 (dk-skolem! ex)))
                 (fact 'encr-injective 'h 'y h1 y1)
                 (dk-split-all!)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) 'IN)
                         (if (dk-contains? (dk-goal) 'KEY-IDEAL-GEN)
                             (begin (subst `(= h ,h1)) (dk-ass!))
                             (begin (subst `(= y ,y1)) (dk-ass!)))
                         (dk-ass!)))))))))))
(qed 'key-ideal-gen-encr-atoms)

;;; -----------------------------------------------------------------------
;;; Origination of a server's session key: K originates at the server's second node.

(sp (make-wff `(FORALL orp (FORALL s (FORALL a (FORALL b (FORALL na (FORALL nb (FORALL m (FORALL k
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IN s (IDS ,orl-sp)) (IMPLIES (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) s) a b na nb m k)
    (ORIGINATES ,orl-sp k (LIST 2 s)))))))))))))))
(dk-peel!)
(let* ((sg `((STRAND-MAP ,orl-sp) s))
       (lit (orl-open! `(IS-OR-SERV orp ,sg a b na nb m k)))
       (c2 (caddr (caddr lit))) (c1 (caddr (cadr lit)))
       (n2 '(LIST 2 s)))
  (dk-have! `(= (LENGTH ,sg) 2) (lambda () (subst `(= ,sg ,lit)) (len-r) (rfl)))
  (dk-have! `(= (NTH 2 ,sg) ,(caddr lit)) (lambda () (subst `(= ,sg ,lit)) (nth-r) (rfl)))
  (dk-have! '(IN 2 NN) (lambda () (arith)))
  (dk-have! '(<= 1 2) (lambda () (dk-nn!)))
  (dk-have! `(<= 2 (LENGTH ,sg)) (lambda () (subst `(= (LENGTH ,sg) 2)) (arith)))
  (fact 'node-intro orl-sp 2 's)
  (dk-have! `(= (NTH 2 ((STRAND-MAP ,orl-sp) (NTH 2 ,n2))) ,(caddr lit)) (lambda () (nth-r) (dk-ass!)))
  (dk-have! `(= (NTH 1 ,n2) 2) (lambda () (nth-r) (rfl)))
  (fact 'node-content-eq orl-sp n2 2 (caddr lit))
  (dk-split-all!)
  (dks-nth-all!)
  (dks-sub-fwd! 'k c2)
  (dk-have! `(IS-SENT ,orl-sp ,n2) (lambda () (mac 'is-sent) (dks-subst-rfl! (dks-eq-for `(NODE-DIR ,orl-sp ,n2)))))
  (dk-have! `(IS-SUBTERM ,orl-T ,orl-K k (NODE-CONTENT ,orl-sp ,n2)) (lambda () (dks-subst-ass! (dks-eq-for `(NODE-CONTENT ,orl-sp ,n2)))))
  (dk-have! `(FORALL x (IMPLIES (SAME-STRAND-BEFORE ,orl-sp x ,n2) (NOT (IS-SUBTERM ,orl-T ,orl-K k (NODE-CONTENT ,orl-sp x)))))
    (lambda ()
      (let ((x (caddr (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-peel!)))))
        (di)
        (dks-project! 'same-strand-before `(SAME-STRAND-BEFORE ,orl-sp ,x ,n2)
          `(AND (IN ,x (NODES ,orl-sp)) (AND (IN ,n2 (NODES ,orl-sp)) (AND (= (NTH 2 ,x) (NTH 2 ,n2)) (< (NTH 1 ,x) (NTH 1 ,n2))))))
        (dk-split-all!)
        (dk-nth-h! `(= (NTH 2 ,x) (NTH 2 ,n2)))
        (dk-nth-h! `(< (NTH 1 ,x) (NTH 1 ,n2)))
        (dk-rewrite-h! `(= ,sg ,lit) 's `(NTH 2 ,x))
        (dks-lit-node-cases! x lit
          (lambda (j)
            (if (= j 2)
                (dks-nn-absurd! `(= (NTH 1 ,x) 2) `(< (NTH 1 ,x) 2))
                (begin
                  (dk-rewrite-h! `(IS-SUBTERM ,orl-T ,orl-K k (NODE-CONTENT ,orl-sp ,x)) `(NODE-CONTENT ,orl-sp ,x) c1)
                  (dks-or-each! (dks-sub-cases! 'k c1)
                    (lambda (e)
                      (let ((t (caddr e)))
                        (cond ((or (dk-stl--encr? t) (dk-stl--lst? t)) (dks-lit-neq! 'k t))
                              (#t (dk-rewrite-h! `(IN k ,orl-K) 'k t)
                                  (ai `(NOT (IN ,t ,orl-K)))))))))))))))
  (fact 'originates-intro orl-sp 'k n2)
  (dk-ass!))
(qed 'or-serv-key-originates)

;;; -----------------------------------------------------------------------
;;; THEOREM 7.4: Otway-Rees session-key secrecy.

;; S = {KAS, KBS, K} and k = K \ S, as separations of the keys
(define (orl-S a b k) `(SEP orw_ ,orl-K (OR (= orw_ ,(orl-ka a)) (OR (= orw_ ,(orl-ka b)) (= orw_ ,k)))))
(define (orl-kk s) `(SEP orv_ ,orl-K (NOT (IN orv_ ,s))))
(define (orl-I kk s) `(KEY-IDEAL-GEN ,orl-T ,orl-K ,kk ,s))

;; (IN M I) in context, M a literal: close the goal.  TOK! gets a token X with (IN X S) in context;
;; VAR! a message-variable leaf V with (IN V I) in context.  Every encryption key met is recorded in
;; ORL-KEYS-MET (innermost first).
(define orl-keys-met '())
(define (orl-not-in-I! m kk s tok! var!)
  (let ((i (orl-I kk s)))
    (cond
      ((dk-stl--lst? m)
       (let* ((l (cadr m)) (ms (cdr l)) (n (length ms))
              (j (dk-skolem! (dk-cite! 'key-ideal-gen-list-component orl-T orl-K kk s l)))
              (len `(LENGTH ,l)))
         (dk-have! `(= ,len ,n) (lambda () (len-r) (rfl)))
         (dk-rewrite-h! `(<= ,j ,len) len n)
         (dks-index-cases! j n
           (lambda (jj)
             (dk-rewrite-h! `(IN (NTH ,j ,l) ,i) j jj)
             (dk-nth-h! `(IN (NTH ,jj ,l) ,i))
             (orl-not-in-I! (list-ref ms (- jj 1)) kk s tok! var!)))))
      ((dk-stl--encr? m)
       (let ((g (cadr m)) (y (caddr m)))
         (dks-msg! g)
         (dks-fact-split! 'key-ideal-gen-encr-atoms orl-T orl-K kk s g y)
         (fluid-let ((orl-keys-met (cons y orl-keys-met)))
           (orl-not-in-I! g kk s tok! var!))))
      ((dks-token? m)
       (dk-cite! 'key-ideal-gen-token orl-T orl-K kk s m)
       (tok! m))
      (#t (var! m)))))

;; the ideal's three clauses (IS-KEY-IDEAL in context), landed without consuming it
(define (orl-ideal-parts! kk s)
  (let* ((j (orl-I kk s))
         (hyp `(IS-KEY-IDEAL ,orl-T ,orl-K ,kk ,j))
         (body `(AND (FORALL sbix_ (IMPLIES (IN sbix_ ,j) (IN sbix_ ,orl-A)))
                 (AND (FORALL sbil_ (FORALL sbij_
                        (IMPLIES (IN sbil_ (TUPLES ,orl-A)) (IMPLIES (IN sbij_ NN) (IMPLIES (<= 1 sbij_)
                         (IMPLIES (<= sbij_ (LENGTH sbil_)) (IMPLIES (IN (NTH sbij_ sbil_) ,j) (IN (LST sbil_) ,j))))))))
                      (FORALL sbih_ (FORALL sbiy_ (IMPLIES (IN sbih_ ,j) (IMPLIES (IN sbiy_ ,kk) (IN (ENCR sbih_ sbiy_) ,j))))))))
         (parts (list (cadr body) (cadr (caddr body)) (caddr (caddr body)))))
    (for-each (lambda (c)
                (dk-have! c (lambda () (fact 'is-key-ideal orl-T orl-K kk j)
                              (let ((node (proof-state-focus *ps*)))
                                (dk-only! (iff-for hyp) hyp)
                                (if (not (sequent-node-grounded? node)) (prop))))))
              parts)
    parts))

;; a regular SENT node N with its content C in I = I_k[S], every earlier node's content outside I: absurd.
;; LIT N's trace, J N's index, HYP its strand predicate, SV-HYP the given server strand; Y-OK the key of
;; the session-key case.
(define (orl-entry-absurd! n lit j kk s sv-hyp univ hyp)
  (let* ((i (orl-I kk s))
         (cj (caddr (list-ref lit j)))
         (cn `(NODE-CONTENT ,orl-sp ,n))
         (subK `(FORALL z (IMPLIES (IN z ,s) (IN z ,orl-K)))))
    (dk-rewrite-h! `(IN ,cn ,i) cn cj)
    (orl-not-in-I! cj kk s
      ;; a token of S: a text or name is no key; a session key K' is no long-term key, and K' = K makes this
      ;; strand the given server's, whose keys are in S
      (lambda (x)
        (if (dk-asm? `(NOT (IN ,x ,orl-K)))
            (begin (dk-apply! subK x) (ai `(NOT (IN ,x ,orl-K))))
            (let* ((sh hyp)
                   (sargs (cons `(NTH 2 ,n) (cdddr sh)))
                   (svid (cadr (caddr sv-hyp)))
                   (svargs (cons svid (cdddr sv-hyp))))
              (dk-landed* (lambda () (sep-me `(IN ,x ,s))))
              (dks-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f x) (dk-contains? f 'LTKEY))) "the three keys")
                (lambda (e)
                  (let ((t (caddr e)))
                    (if (dk-contains? t 'LTKEY)
                        ;; K' is no long-term key
                        (let* ((nolt (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTKEY) (dk-contains? f x)
                                                               (not (dk-contains? f 'OR))))
                                              "K' no long-term key"))
                               (who (cadr t)))
                          (ai (dk-apply! nolt who)))
                        ;; K' = K
                        (let* ((s2 `(LIST 2 (NTH 2 ,n)))
                               (sv2 `(LIST 2 ,svid)))
                          (apply fact 'or-serv-key-originates 'orp sargs)
                          (dk-rewrite-h! `(ORIGINATES ,orl-sp ,x ,s2) x t)
                          (apply fact 'or-serv-key-originates 'orp svargs)
                          (fact 'originates-unique orl-sp t sv2 s2)
                          (dks-fact-split! 'node-pair-injective 2 `(NTH 2 ,n) 2 svid)
                          (let* ((lit-sv (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `((STRAND-MAP ,orl-sp) ,svid))))
                                                  "the server's trace"))
                                 (lit-n (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `((STRAND-MAP ,orl-sp) (NTH 2 ,n)))))
                                                 "N's trace"))
                                 (eq `(= ,(caddr lit-n) ,(caddr lit-sv))))
                            (dk-have! eq (lambda () (subst `(= ,(caddr lit-n) ((STRAND-MAP ,orl-sp) (NTH 2 ,n))))
                                                    (subst `(= (NTH 2 ,n) ,svid))
                                                    (dk-ass!)))
                            (dks-lit-path! eq '(2 2 LST 2 KEY))
                            (dks-lit-path! eq '(2 2 LST 3 KEY))
                            (let ((y (car orl-keys-met)))
                              (dk-landed* (lambda () (sep-me `(IN ,y ,kk))))
                              (dk-have! `(IN ,y ,s)
                                (lambda ()
                                  (in-sep! (lambda () (dk-ass!))
                                           (lambda ()
                                             (cond ((dk-asm? `(= ,y ,(orl-ka (cadr svargs)))) (oi-l) (dk-ass!))
                                                   (#t (oi-r) (oi-l) (dk-ass!)))))))
                              (ai `(NOT (IN ,y ,s)))))))))))))
      ;; a responder's H (at 2) or H2 (at 4): its list from the node before puts that node in I
      (lambda (v)
        (let* ((jprev (- j 1))
               (lp (cadr (caddr (list-ref lit jprev))))
               (pos (let loop ((xs (cdr lp)) (k 1)) (if (equal? (car xs) v) k (loop (cdr xs) (+ k 1)))))
               (parts (orl-ideal-parts! kk s)))
          (dk-stl--tuples! orl-T orl-K lp)
          (dk-have! `(IN (NTH ,pos ,lp) ,i) (lambda () (nth-r) (dk-ass!)))
          (dk-have! `(IN ,pos NN) (lambda () (arith)))
          (dk-have! `(<= 1 ,pos) (lambda () (dk-nn!)))
          (dk-have! `(<= ,pos (LENGTH ,lp)) (lambda () (len-r) (arith)))
          (dk-apply! (cadr parts) lp pos)
          (dks-num-index! jprev n)
          (let ((np (dks-earlier! jprev n `(= (NTH 1 ,n) ,j))))
            (dks-entry! np jprev (list-ref lit jprev) n)
            (dk-rewrite-h! `(IN (LST ,lp) ,i) `(LST ,lp) `(NODE-CONTENT ,orl-sp ,np))
            (ai (dk-apply! univ np))))))))

(define orl-S* (orl-S 'a 'b 'k))
(define orl-kk* (orl-kk orl-S*))
(define orl-sv-hyp `(IS-OR-SERV orp ((STRAND-MAP ,orl-sp) sv) a b na nb m k))

(sp (make-wff `(FORALL orp (FORALL c (FORALL sv (FORALL a (FORALL b (FORALL na (FORALL nb (FORALL m (FORALL k
  ,(dks-curry (list '(IS-OR-SPACE orp) '(IS-BUNDLE c) `(= (BSPACE c) ,orl-sp) `(IN sv (IDS ,orl-sp)) orl-sv-hyp
                    `(UNIQUELY-ORIGINATES ,orl-sp k)
                    `(NOT (IN ,(orl-ka 'a) (ADV-TOKENS ,orl-isp))) `(NOT (IN ,(orl-ka 'b) (ADV-TOKENS ,orl-isp))))
     `(FORALL z (IMPLIES (IN z (BNODES c))
        (NOT (IN (NODE-CONTENT ,orl-sp z) ,(orl-I orl-kk* '(SINGLETON k))))))))))))))))))
(let* ((landed (dk-peel!))
       (z (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) landed)))
       (s orl-S*) (kk orl-kk*) (i (orl-I orl-kk* orl-S*)) (i1 (orl-I orl-kk* '(SINGLETON k)))
       (ka (orl-ka 'a)) (kb (orl-ka 'b)))
  (di)
  (orl-or-space!)
  (orl-open! orl-sv-hyp)
  (dk-have! `(FORALL w (IMPLIES (IN w ,kk) (IN w ,orl-K)))
    (lambda () (let ((w (cadr (car (dk-peel!))))) (sep-me `(IN ,w ,kk)) (dk-ass!))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,s) (IN z ,orl-K)))
    (lambda () (let ((w (cadr (car (dk-peel!))))) (sep-me `(IN ,w ,s)) (dk-ass!))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,s) (IN z ,orl-T)))
    (lambda () (let ((w (cadr (car (dk-peel!))))) (sep-me `(IN ,w ,s)) (dk-apply! (dk-cite! 'keys-in-tokens orl-sp) w) (dk-ass!))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,s) (IN z ,orl-A)))
    (lambda () (let ((w (cadr (car (dk-peel!))))) (dk-apply! `(FORALL z (IMPLIES (IN z ,s) (IN z ,orl-T))) w)
                 (fact 'token-in-msgs orl-T orl-K w) (dk-ass!))))
  (fact 'tokens-are-simple orl-T orl-K s)
  ;; S is outside the adversary's knowledge
  (dk-have! `(FORALL z (IMPLIES (IN z ,s) (NOT (IN z (ADV-TOKENS ,orl-isp)))))
    (lambda ()
      (let ((w (cadr (car (dk-peel!)))))
        (sep-me `(IN ,w ,s))
        (dks-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f w))) "the three")
          (lambda (e) (subst e) (dk-ass!))))))
  ;; every key is in S or has its inverse in k = K \ S (the keys of S are symmetric)
  (fact 'kinv-in-fun orl-sp)
  (dk-have! `(FORALL y (IMPLIES (IN y ,orl-K) (OR (IN y ,s) (IN ((KINV ,orl-sp) y) ,kk))))
    (lambda ()
      (let ((y (cadr (car (dk-peel!)))))
        (fact 'fun-apply-type-c `(KINV ,orl-sp) orl-K orl-K y)
        (use-em `(IN ,y ,s)
          (lambda () (oi-l) (dk-ass!))
          (lambda ()
            (oi-r)
            (in-sep! (lambda () (dk-ass!))
                     (lambda ()
                       (di)
                       (let ((kv `((KINV ,orl-sp) ,y)))
                         (dk-landed* (lambda () (sep-me `(IN ,kv ,s))))
                         (dk-apply! (dk-cite! 'kinv-involution orl-sp) y)
                         (dks-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f kv))) "the three")
                           (lambda (e)
                             (let ((t (caddr e)))
                               ;; KINV(y) = t, t symmetric: y = KINV(KINV(y)) = KINV(t) = t, in S
                               (dk-congr! e (lambda (u) `((KINV ,orl-sp) ,u)))
                               (cond ((equal? t ka) (dk-apply! orl-ltk-sym 'a))
                                     ((equal? t kb) (dk-apply! orl-ltk-sym 'b)))
                               (dk-have! `(= ,y ,t)
                                 (lambda ()
                                   (subst `(= ,y ((KINV ,orl-sp) ,kv)))
                                   (subst `(= ((KINV ,orl-sp) ,kv) ((KINV ,orl-sp) ,t)))
                                   (if (dk-asm? `(= ((KINV ,orl-sp) ,t) ,t))
                                       (dks-subst-rfl! `(= ((KINV ,orl-sp) ,t) ,t))
                                       (rfl))))
                               (dk-have! `(IN ,y ,s)
                                 (lambda () (in-sep! (lambda () (dk-ass!))
                                              (lambda () (subst `(= ,y ,t))
                                                (cond ((equal? t ka) (oi-l) (rfl))
                                                      ((equal? t kb) (oi-r) (oi-l) (rfl))
                                                      (#t (oi-r) (oi-r) (rfl)))))))
                               (ai `(NOT (IN ,y ,s))))))))))))))
  ;; I_k[{K}] inside I_k[S]
  (dk-have! `(IN k ,s) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (oi-r) (oi-r) (rfl)))))
  (fact 'token-in-msgs orl-T orl-K 'k)
  (fact 'key-ideal-gen-is-ideal orl-T orl-K kk s)
  (fact 'key-ideal-gen-contains orl-T orl-K kk s 'k)
  (dk-cite! 'key-ideal-gen-singleton-least orl-T orl-K kk i 'k `(NODE-CONTENT ,orl-sp ,z))
  ;; 6.12: a regular entry point into I_k[S]
  (dk-have! `(FORSOME mm (AND (IN mm (BNODES c)) (IN (NODE-CONTENT ,orl-sp mm) ,i)))
    (lambda () (ew z) (dk-conj-close! (lambda () (dk-ass!)))))
  (let* ((n (dk-skolem! (dk-cite! 'key-ideal-gen-regular-entry orl-isp 'c kk s)))
         (ep `(IS-ENTRY-POINT ,orl-sp ,n ,i))
         (univ `(FORALL ssm_ (IMPLIES (SAME-STRAND-BEFORE ,orl-sp ssm_ ,n) (NOT (IN (NODE-CONTENT ,orl-sp ssm_) ,i))))))
    (dks-project! 'is-entry-point ep
      `(AND (IN ,n (NODES ,orl-sp)) (AND (IS-SENT ,orl-sp ,n) (AND (IN (NODE-CONTENT ,orl-sp ,n) ,i) ,univ))))
    (dk-split-all!)
    (orl-regular! n)
    (dks-fact-split! 'node-parts orl-sp n)
    (orl-strand-cases! `(NTH 2 ,n)
      (lambda (kind hyp lit)
        (dks-lit-node-cases! n lit
          (lambda (j)
            (if (eq? (cadr (list-ref lit j)) 'RECEIVED)
                (dks-recv-absurd! n)
                (orl-entry-absurd! n lit j kk s orl-sv-hyp univ hyp))))))))
(qed 'or-session-key-secrecy)

;;; -----------------------------------------------------------------------
;;; A REGULAR NODE ORIGINATES NO LONG-TERM KEY (the paper, proof of 7.5: "A key K originates on a regular
;;; node only if it is a session key ... the session key K is never a long term key K_XS").

;; ORIGINATES(sp, W, N) opened, N regular: for each SENT node of N's strand, HANDLER gets
;; (kind hyp lit j) with W @ (the literal content) in context; received nodes are closed
(define (orl-regular-origin-cases! w n handler)
  (dks-fact-split! 'originates-elim orl-sp w n)
  (orl-regular! n)
  (dks-fact-split! 'node-parts orl-sp n)
  (orl-strand-cases! `(NTH 2 ,n)
    (lambda (kind hyp lit)
      (dks-lit-node-cases! n lit
        (lambda (j)
          (if (eq? (cadr (list-ref lit j)) 'RECEIVED)
              (dks-recv-absurd! n)
              (let ((cj (caddr (list-ref lit j))))
                (dk-rewrite-h! `(IS-SUBTERM ,orl-T ,orl-K ,w (NODE-CONTENT ,orl-sp ,n)) `(NODE-CONTENT ,orl-sp ,n) cj)
                (handler kind hyp lit j))))))))

;; W @ V for a message variable V of the content at J: V is in the list received at J - 1, so W is a
;; subterm of that earlier node's content, against origination
(define (orl-var-earlier! w v n lit j)
  (let* ((jprev (- j 1))
         (lp (cadr (caddr (list-ref lit jprev))))
         (pos (let loop ((xs (cdr lp)) (k 1)) (if (equal? (car xs) v) k (loop (cdr xs) (+ k 1))))))
    (dk-stl--tuples! orl-T orl-K lp)
    (dk-have! `(IS-SUBTERM ,orl-T ,orl-K ,w (NTH ,pos ,lp)) (lambda () (nth-r) (dk-ass!)))
    (dk-have! `(IN ,pos NN) (lambda () (arith)))
    (dk-have! `(<= 1 ,pos) (lambda () (dk-nn!)))
    (dk-have! `(<= ,pos (LENGTH ,lp)) (lambda () (len-r) (arith)))
    (fact 'subterm-component orl-T orl-K w lp pos)
    (dks-num-index! jprev n)
    (let ((np (dks-earlier! jprev n `(= (NTH 1 ,n) ,j))))
      (dks-entry! np jprev (list-ref lit jprev) n)
      (dk-rewrite-h! `(IS-SUBTERM ,orl-T ,orl-K ,w (LST ,lp)) `(LST ,lp) `(NODE-CONTENT ,orl-sp ,np))
      (ai (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SAME-STRAND-BEFORE) (dk-contains? f w)))
                              "no earlier node")
                     np)))))

(sp (make-wff `(FORALL orp (FORALL x (FORALL n
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IN x ,orl-names) (IMPLIES (IS-REGULAR-NODE ,orl-isp n)
    (NOT (ORIGINATES ,orl-sp ,(orl-ka 'x) n))))))))))
(dk-peel!)
(di)
(orl-or-space!)
(orl-name! 'x)
(dk-apply! (dk-cite! 'keys-in-tokens orl-sp) (orl-ka 'x))
(let ((w (orl-ka 'x)))
  (orl-regular-origin-cases! w 'n
    (lambda (kind hyp lit j)
      (let ((cj (caddr (list-ref lit j))))
        (dks-or-each! (dks-sub-cases! w cj)
          (lambda (e)
            (let ((t (caddr e)))
              (cond
                ((dk-head-is? e 'IS-SUBTERM) (orl-var-earlier! w (list-ref e 4) 'n lit j))
                ((or (dk-stl--encr? t) (dk-stl--lst? t)) (dks-lit-neq! w t))
                ((dk-asm? `(NOT (IN ,t ,orl-K)))
                 (dk-rewrite-h! `(IN ,w ,orl-K) w t)
                 (ai `(NOT (IN ,t ,orl-K))))
                (#t                                     ; a server's session key is no long-term key
                 (let ((nolt (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LTKEY) (dk-contains? f t)
                                                       (not (dk-contains? f 'OR))))
                                      "the session key")))
                   (dk-have! `(= ,t ,w) (lambda () (subst `(= ,t ,w)) (rfl)))
                   (ai (dk-apply! nolt 'x))))))))))))
(qed 'or-ltkey-not-regular-origin)

;;; PROPOSITION 7.5: if K_XS is uncompromised, no {g}_K_XS originates on an adversary node of a bundle.
(sp (make-wff `(FORALL orp (FORALL c (FORALL x
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IS-BUNDLE c) (IMPLIES (= (BSPACE c) ,orl-sp)
  (IMPLIES (IN x ,orl-names) (IMPLIES (NOT (IN ,(orl-ka 'x) (ADV-TOKENS ,orl-isp)))
    (FORALL n (IMPLIES (IN n (BNODES c)) (IMPLIES (IS-ADVERSARY-NODE ,orl-isp n)
      (FORALL g (IMPLIES (IN g ,orl-A) (NOT (ORIGINATES ,orl-sp (ENCR g ,(orl-ka 'x)) n)))))))))))))))))
(let* ((landed (dk-peel!))
       (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) landed)))
       (g (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) orl-A))) landed)))
       (kx (orl-ka 'x))
       (s1 `(SINGLETON ,kx))
       (i (orl-I orl-K s1))
       (sb `(SEP ssw_ ,orl-A (IS-SUBTERM ,orl-T ,orl-K ,kx ssw_))))
  (orl-or-space!)
  (orl-name! 'x)
  (dk-apply! (dk-cite! 'keys-in-tokens orl-sp) kx)
  (fact 'token-in-msgs orl-T orl-K kx)
  (fact 'membership-implies-sethood kx orl-K)
  (fact 'kinv-in-fun orl-sp)
  (let ((in-s1! (lambda (z) (let ((mem `(IN ,z ,s1)))
                              (fact 'singleton-membership kx z)
                              (dk-have! `(= ,z ,kx) (lambda () (let ((node (proof-state-focus *ps*)))
                                                                (dk-only! (iff-for mem) mem)
                                                                (if (not (sequent-node-grounded? node)) (prop)))))))))
    (dk-have! `(FORALL y (IMPLIES (IN y ,orl-K) (IN y ,orl-K))) (lambda () (dk-peel!) (dk-ass!)))
    (dk-have! `(FORALL y (IMPLIES (IN y ,orl-K) (OR (IN y ,s1) (IN ((KINV ,orl-sp) y) ,orl-K))))
      (lambda ()
        (let ((y (cadr (car (dk-peel!)))))
          (oi-r)
          (fact 'fun-apply-type-c `(KINV ,orl-sp) orl-K orl-K y)
          (dk-ass!))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,s1) (IN z ,orl-K)))
      (lambda () (let ((z (cadr (car (dk-peel!))))) (in-s1! z) (subst `(= ,z ,kx)) (dk-ass!))))
    (dk-have! `(FORALL z (IMPLIES (IN z ,s1) (NOT (IN z (ADV-TOKENS ,orl-isp)))))
      (lambda () (let ((z (cadr (car (dk-peel!))))) (in-s1! z) (subst `(= ,z ,kx)) (dk-ass!))))
    (dk-have! `(IN ,kx ,s1)
      (lambda () (fact 'singleton-membership kx kx)
                 (dk-have! `(= ,kx ,kx) (lambda () (rfl)))
                 (let ((node (proof-state-focus *ps*)))
                   (dk-only! (iff-for `(IN ,kx ,s1)) `(IN ,kx SET) `(= ,kx ,kx))
                   (if (not (sequent-node-grounded? node)) (prop))))))
  ;; no regular node is an entry point for I_K[{K_XS}]: such an entry point would originate K_XS
  (let ((e (dk-cite! 'key-ideal-gen-subterms orl-T orl-K kx)))
    (dk-have! `(FORALL n (IMPLIES (IN n (BNODES c)) (IMPLIES (IS-REGULAR-NODE ,orl-isp n) (NOT (IS-ENTRY-POINT ,orl-sp n ,i)))))
      (lambda ()
        (let* ((lnd (dk-peel!))
               (r (caddr (find-first (lambda (f) (dk-head-is? f 'IS-REGULAR-NODE)) lnd))))
          (di)
          (dk-rewrite-h! `(IS-ENTRY-POINT ,orl-sp ,r ,i) i sb)
          (dk-have! `(ORIGINATES ,orl-sp ,kx ,r) (lambda () (mac 'originates) (dk-ass!)))
          (ai (dk-cite! 'or-ltkey-not-regular-origin 'orp 'x r)))))
    (let ((u (dk-cite! 'key-ideal-gen-no-adversary-origin orl-isp 'c orl-K s1)))
      (dk-apply! u n g kx) (dk-ass!))))
(qed 'or-ltkey-no-adversary-origin)

;;; -----------------------------------------------------------------------
;;; K_XS = K_YS gives X = Y (LTKEY injective), as a citable instance.
(sp (make-wff `(FORALL orp (FORALL x (FORALL z (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IN x ,orl-names) (IMPLIES (IN z ,orl-names)
  (IMPLIES (= ,(orl-ka 'x) ,(orl-ka 'z)) (= x z))))))))))
(dk-peel!)
(orl-space!)
(dk-apply! orl-ltk-inj 'x 'z)
(dk-ass!)
(qed 'or-ltkey-injective-at)

;;; PROPOSITION 7.6: the shapes of an encryption under K_XS originating on a regular node.

(define (orl-76-concl h x)
  `(OR (FORSOME n0 (FORSOME k0 (AND (IS-OR-TEXT orp n0) (AND (IN k0 ,orl-K) (= ,h (LST (LIST n0 k0)))))))
   (OR (FORSOME n0 (FORSOME m0 (FORSOME c0 (AND (IS-OR-TEXT orp n0) (AND (IS-OR-TEXT orp m0) (AND (IN c0 ,orl-names)
          (= ,h (LST (LIST n0 m0 ,x c0)))))))))
       (FORSOME n0 (FORSOME m0 (FORSOME c0 (AND (IS-OR-TEXT orp n0) (AND (IS-OR-TEXT orp m0) (AND (IN c0 ,orl-names)
          (= ,h (LST (LIST n0 m0 c0 ,x))))))))))))

;; ORIGINATES(sp, ENCR(h, K_X), n), n regular: on each sent node, the encryption is one of the content's
;; encryptions; HANDLER gets (kind hyp lit j g y) with (= h g) and (= K_X y) in context
(define (orl-encr-origin-cases! h x n handler)
  (let ((w `(ENCR ,h ,(orl-ka x))))
    (orl-regular-origin-cases! w n
      (lambda (kind hyp lit j)
        (let ((cj (caddr (list-ref lit j))))
          (dks-or-each! (dks-sub-cases! w cj)
            (lambda (e)
              (let ((t (caddr e)))
                (cond
                  ((dk-head-is? e 'IS-SUBTERM) (orl-var-earlier! w (list-ref e 4) n lit j))
                  ((dk-stl--encr? t)
                   (dks-fact-split! 'encr-injective h (orl-ka x) (cadr t) (caddr t))
                   (handler kind hyp lit j (cadr t) (caddr t)))
                  (#t (dks-lit-neq! w t)))))))))))

(sp (make-wff `(FORALL orp (FORALL x (FORALL n (FORALL h
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IN x ,orl-names) (IMPLIES (IS-REGULAR-NODE ,orl-isp n) (IMPLIES (IN h ,orl-A)
  (IMPLIES (ORIGINATES ,orl-sp (ENCR h ,(orl-ka 'x)) n)
    ,(orl-76-concl 'h 'x))))))))))))
(dk-peel!)
(orl-or-space!)
(orl-name! 'x)
(orl-encr-origin-cases! 'h 'x 'n
  (lambda (kind hyp lit j g y)
    (let* ((ws (cdr (cadr g))))                    ; the plaintext list's entries
      (if (not (eq? kind 'serv))
          (dk-cite! 'or-ltkey-injective-at 'orp 'x (cadr y)))
      (case kind
        ((serv) (dks-select! 1 3) (ew (car ws)) (ew (cadr ws)))
        ((init) (dks-select! 2 3) (ew (car ws)) (ew (cadr ws)) (ew (list-ref ws 3)))
        (else (dks-select! 3 3) (ew (car ws)) (ew (cadr ws)) (ew (list-ref ws 2))))
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) '=)
                 (if (not (eq? kind 'serv)) (subst `(= x ,(cadr y))))
                 (dks-subst-rfl! `(= h ,g)))
                (#t (error "7.6: open" (dk-goal)))))))))
(qed 'or-regular-encr-shapes)

;;; -----------------------------------------------------------------------
;;; COROLLARY 7.7.

;; W a token, (= W T) in context for an atom T of a literal: close the goal when W and T are known to differ
;; (structure vs token, a disequation in context, a text against a name)
(define (orl-token-atom-absurd! w e)
  (let ((t (caddr e)))
    (cond ((dk-head-is? e 'IS-SUBTERM) (ai `(NOT ,e)))
          ((or (dk-stl--encr? t) (dk-stl--lst? t)) (dks-lit-neq! w t))
          ((dk-asm? `(NOT (= ,w ,t))) (ai `(NOT (= ,w ,t))))
          ((dk-asm? `(NOT (= ,t ,w)))
           (dk-have! `(= ,t ,w) (lambda () (dks-subst-rfl! `(= ,t ,w))))
           (ai `(NOT (= ,t ,w))))
          ((and (dk-asm? `(IN ,t ,orl-names)) (dk-asm? `(NOT (IN ,w ,orl-names))))
           (dk-rewrite-h! `(IN ,t ,orl-names) t w)
           (ai `(NOT (IN ,w ,orl-names))))
          ((and (dk-asm? `(IN ,t ,orl-K)) (dk-asm? `(NOT (IN ,w ,orl-K))))
           (dk-rewrite-h! `(IN ,t ,orl-K) t w)
           (ai `(NOT (IN ,w ,orl-K))))
          (#t (error "orl-token-atom-absurd!: cannot tell apart" w t)))))

;;; On an initiator's strand N originates at the first node; on a responder's at the second (N /= M is part
;;; of IS-OR-RESP: with N = M the nonce would be received at the first node, as M).
(sp (make-wff `(FORALL orp (FORALL t (FORALL a (FORALL b (FORALL n (FORALL m (FORALL k
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IN t (IDS ,orl-sp)) (IMPLIES (IS-OR-INIT orp ((STRAND-MAP ,orl-sp) t) a b n m k)
    (ORIGINATES ,orl-sp n (LIST 1 t))))))))))))))
(dk-peel!)
(let* ((sg `((STRAND-MAP ,orl-sp) t))
       (lit (orl-open! `(IS-OR-INIT orp ,sg a b n m k)))
       (n1 '(LIST 1 t)))
  (dk-have! `(= (LENGTH ,sg) 2) (lambda () (subst `(= ,sg ,lit)) (len-r) (rfl)))
  (dk-have! `(= (NTH 1 ,sg) ,(cadr lit)) (lambda () (subst `(= ,sg ,lit)) (nth-r) (rfl)))
  (fact 'nn-one-in)
  (dk-have! '(<= 1 1) (lambda () (dk-nn!)))
  (dk-have! `(<= 1 (LENGTH ,sg)) (lambda () (subst `(= (LENGTH ,sg) 2)) (arith)))
  (fact 'node-intro orl-sp 1 't)
  (dk-have! `(= (NTH 1 ((STRAND-MAP ,orl-sp) (NTH 2 ,n1))) ,(cadr lit)) (lambda () (nth-r) (dk-ass!)))
  (dk-have! `(= (NTH 1 ,n1) 1) (lambda () (nth-r) (rfl)))
  (fact 'node-content-eq orl-sp n1 1 (cadr lit))
  (dk-split-all!)
  (dks-nth-all!)
  (dks-sub-fwd! 'n (caddr (cadr lit)))
  (dk-have! `(IS-SENT ,orl-sp ,n1) (lambda () (mac 'is-sent) (dks-subst-rfl! (dks-eq-for `(NODE-DIR ,orl-sp ,n1)))))
  (dk-have! `(IS-SUBTERM ,orl-T ,orl-K n (NODE-CONTENT ,orl-sp ,n1)) (lambda () (dks-subst-ass! (dks-eq-for `(NODE-CONTENT ,orl-sp ,n1)))))
  (dk-have! `(FORALL x (IMPLIES (SAME-STRAND-BEFORE ,orl-sp x ,n1) (NOT (IS-SUBTERM ,orl-T ,orl-K n (NODE-CONTENT ,orl-sp x)))))
    (lambda ()
      (let ((x (caddr (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-peel!)))))
        (di)
        (dks-project! 'same-strand-before `(SAME-STRAND-BEFORE ,orl-sp ,x ,n1)
          `(AND (IN ,x (NODES ,orl-sp)) (AND (IN ,n1 (NODES ,orl-sp)) (AND (= (NTH 2 ,x) (NTH 2 ,n1)) (< (NTH 1 ,x) (NTH 1 ,n1))))))
        (dk-split-all!)
        (dk-nth-h! `(< (NTH 1 ,x) (NTH 1 ,n1)))
        (dks-fact-split! 'node-parts orl-sp x)
        (dks-nn-absurd! `(<= 1 (NTH 1 ,x)) `(< (NTH 1 ,x) 1)))))
  (fact 'originates-intro orl-sp 'n n1)
  (dk-ass!))
(qed 'or-init-nonce-originates)

(sp (make-wff `(FORALL orp (FORALL t (FORALL a (FORALL b (FORALL n (FORALL m (FORALL k (FORALL h (FORALL g
  (IMPLIES (IS-SK-SPACE orp) (IMPLIES (IN t (IDS ,orl-sp)) (IMPLIES (IS-OR-RESP orp ((STRAND-MAP ,orl-sp) t) a b n m k h g)
    (ORIGINATES ,orl-sp n (LIST 2 t))))))))))))))))
(dk-peel!)
(let* ((sg `((STRAND-MAP ,orl-sp) t))
       (lit (orl-open! `(IS-OR-RESP orp ,sg a b n m k h g)))
       (n2 '(LIST 2 t))
       (c1 (caddr (cadr lit))))
  (dk-have! `(= (LENGTH ,sg) 4) (lambda () (subst `(= ,sg ,lit)) (len-r) (rfl)))
  (dk-have! `(= (NTH 2 ,sg) ,(caddr lit)) (lambda () (subst `(= ,sg ,lit)) (nth-r) (rfl)))
  (dk-have! '(IN 2 NN) (lambda () (arith)))
  (dk-have! '(<= 1 2) (lambda () (dk-nn!)))
  (dk-have! `(<= 2 (LENGTH ,sg)) (lambda () (subst `(= (LENGTH ,sg) 4)) (arith)))
  (fact 'node-intro orl-sp 2 't)
  (dk-have! `(= (NTH 2 ((STRAND-MAP ,orl-sp) (NTH 2 ,n2))) ,(caddr lit)) (lambda () (nth-r) (dk-ass!)))
  (dk-have! `(= (NTH 1 ,n2) 2) (lambda () (nth-r) (rfl)))
  (fact 'node-content-eq orl-sp n2 2 (caddr lit))
  (dk-split-all!)
  (dks-nth-all!)
  (dks-sub-fwd! 'n (caddr (caddr lit)))
  (dk-have! `(IS-SENT ,orl-sp ,n2) (lambda () (mac 'is-sent) (dks-subst-rfl! (dks-eq-for `(NODE-DIR ,orl-sp ,n2)))))
  (dk-have! `(IS-SUBTERM ,orl-T ,orl-K n (NODE-CONTENT ,orl-sp ,n2)) (lambda () (dks-subst-ass! (dks-eq-for `(NODE-CONTENT ,orl-sp ,n2)))))
  (dk-have! `(FORALL x (IMPLIES (SAME-STRAND-BEFORE ,orl-sp x ,n2) (NOT (IS-SUBTERM ,orl-T ,orl-K n (NODE-CONTENT ,orl-sp x)))))
    (lambda ()
      (let ((x (caddr (find-first (lambda (f) (dk-head-is? f 'SAME-STRAND-BEFORE)) (dk-peel!)))))
        (di)
        (dks-project! 'same-strand-before `(SAME-STRAND-BEFORE ,orl-sp ,x ,n2)
          `(AND (IN ,x (NODES ,orl-sp)) (AND (IN ,n2 (NODES ,orl-sp)) (AND (= (NTH 2 ,x) (NTH 2 ,n2)) (< (NTH 1 ,x) (NTH 1 ,n2))))))
        (dk-split-all!)
        (dk-nth-h! `(= (NTH 2 ,x) (NTH 2 ,n2)))
        (dk-nth-h! `(< (NTH 1 ,x) (NTH 1 ,n2)))
        (dk-rewrite-h! `(= ,sg ,lit) 't `(NTH 2 ,x))
        (dks-lit-node-cases! x lit
          (lambda (j)
            (if (> j 1)
                (dks-nn-absurd! `(= (NTH 1 ,x) ,j) `(< (NTH 1 ,x) 2))
                (begin
                  (dk-rewrite-h! `(IS-SUBTERM ,orl-T ,orl-K n (NODE-CONTENT ,orl-sp ,x)) `(NODE-CONTENT ,orl-sp ,x) c1)
                  (dks-or-each! (dks-sub-cases! 'n c1)
                    (lambda (e) (orl-token-atom-absurd! 'n e))))))))))
  (fact 'originates-intro orl-sp 'n n2)
  (dk-ass!))
(qed 'or-resp-nonce-originates)

;; a node N of the space and its strand id: the hypothesis H of N's strand, rewritten by the equations
;; EQS (each (= OLD NEW) or (= NEW OLD) in context); returns the rewritten hypothesis
(define (orl-rewrite-all! h eqs)
  (let loop ((h h) (eqs eqs))
    (if (null? eqs) h
        (let* ((e (car eqs)) (old (cadr e)) (new (caddr e)))
          (loop (if (and (not (equal? old new)) (dk-contains? h old)) (dk-rewrite-h! h old new) h) (cdr eqs))))))

;;; 7.7 (1): {N K}_K_XS originating on a regular node: the node is a server's second, with X its initiator
;;; or its responder, and K originates there.
(sp (make-wff `(FORALL orp (FORALL x (FORALL n (FORALL nc (FORALL k
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IN x ,orl-names) (IMPLIES (IS-REGULAR-NODE ,orl-isp n)
  (IMPLIES (IN nc ,orl-T) (IMPLIES (IN k ,orl-K)
  (IMPLIES (ORIGINATES ,orl-sp (ENCR (LST (LIST nc k)) ,(orl-ka 'x)) n)
    (AND (= (NTH 1 n) 2)
    (AND (OR (FORSOME a0 (FORSOME o0 (FORSOME m0 (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) (NTH 2 n)) a0 x o0 nc m0 k))))
             (FORSOME b0 (FORSOME o0 (FORSOME m0 (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) (NTH 2 n)) x b0 nc o0 m0 k)))))
         (ORIGINATES ,orl-sp k (LIST 2 (NTH 2 n))))))))))))))))))
(dk-peel!)
(orl-or-space!)
(orl-name! 'x)
(dk-cite! 'token-in-msgs orl-T orl-K 'nc)
(dk-apply! (dk-cite! 'keys-in-tokens orl-sp) 'k)
(dks-msg! '(LST (LIST nc k)))
(orl-encr-origin-cases! '(LST (LIST nc k)) 'x 'n
  (lambda (kind hyp lit j g y)
    (let ((h '(LST (LIST nc k))))
      (if (not (eq? kind 'serv))
          (dks-lit-neq! h g)
          (let* ((ps (cdddr hyp))              ; a b na nb m k'
                 (e1 (dks-lit-path! `(= ,h ,g) '(LST 1)))
                 (e2 (dks-lit-path! `(= ,h ,g) '(LST 2)))
                 (z (cadr y))
                 (xz (dk-cite! 'or-ltkey-injective-at 'orp 'x z))
                 (first? (equal? z (car ps)))
                 (h2 (orl-rewrite-all! hyp (list `(= ,z x) `(= ,(cadr (cadr g)) nc) `(= ,(list-ref ps 5) k)))))
            (dk-landed* (lambda () (apply fact 'or-serv-key-originates 'orp `(NTH 2 n) ps)))
            (dk-rewrite-h! `(ORIGINATES ,orl-sp ,(list-ref ps 5) (LIST 2 (NTH 2 n))) (list-ref ps 5) 'k)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) 'OR)
                       (if first?
                           (begin (oi-r) (ew (cadr ps)) (ew (list-ref ps 3)) (ew (list-ref ps 4)) (dk-ass!))
                           (begin (oi-l) (ew (car ps)) (ew (list-ref ps 2)) (ew (list-ref ps 4)) (dk-ass!))))
                      (#t (error "7.7(1): open" (dk-goal)))))))))))
(qed 'or-77-server)

;; (= P Q) from (= P R) and (= Q R), or the like: the goal (= u v) closed by rewriting through EQS
(define (orl-paths! eq is)
  (let loop ((is is) (acc '()))
    (if (null? is) (reverse acc)
        (let ((r (dks-lit-path! eq (list 'LST (car is)))))
          (loop (cdr is) (cons r acc))))))

(define (orl-eq-chain! u v via)
  (dk-have! `(= ,u ,v)
    (lambda ()
      (subst `(= ,u ,via))
      (dks-subst-rfl! `(= ,v ,via)))))

;;; 7.7 (2): {N M A B}_KAS, A /= B, originating on a regular node: the node is an initiator's first, of
;;; Init[A, B, N, M, K] for some K, and N originates there.
(sp (make-wff `(FORALL orp (FORALL n (FORALL nc (FORALL mc (FORALL a (FORALL b
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IN a ,orl-names) (IMPLIES (IN b ,orl-names) (IMPLIES (NOT (= a b))
  (IMPLIES (IS-REGULAR-NODE ,orl-isp n) (IMPLIES (IN nc ,orl-T) (IMPLIES (IN mc ,orl-T)
  (IMPLIES (ORIGINATES ,orl-sp (ENCR (LST (LIST nc mc a b)) ,(orl-ka 'a)) n)
    (AND (= (NTH 1 n) 1)
    (AND (FORSOME k0 (IS-OR-INIT orp ((STRAND-MAP ,orl-sp) (NTH 2 n)) a b nc mc k0))
         (ORIGINATES ,orl-sp nc (LIST 1 (NTH 2 n)))))))))))))))))))))
(dk-peel!)
(orl-or-space!)
(orl-name! 'a) (orl-name! 'b)
(dks-msg! '(LST (LIST nc mc a b)))
(orl-encr-origin-cases! '(LST (LIST nc mc a b)) 'a 'n
  (lambda (kind hyp lit j g y)
    (let ((h '(LST (LIST nc mc a b))))
      (if (eq? kind 'serv)
          (dks-lit-neq! h g)
          (let* ((ps (cdddr hyp))
                 (es (orl-paths! `(= ,h ,g) '(1 2 3 4)))
                 (z (cadr y)))
            (dk-cite! 'or-ltkey-injective-at 'orp 'a z)
            (if (eq? kind 'resp)
                ;; KAS = KB'S: A = B' = B
                (begin
                  (orl-eq-chain! 'a 'b z)
                  (ai '(NOT (= a b))))
                (let ((ws (cdr (cadr g))))
                  (dk-landed* (lambda () (apply fact 'or-init-nonce-originates 'orp `(NTH 2 n) ps)))
                  (dk-rewrite-h! `(ORIGINATES ,orl-sp ,(car ws) (LIST 1 (NTH 2 n))) (car ws) 'nc)
                  (orl-rewrite-all! hyp (list `(= ,(car ws) nc) `(= ,(cadr ws) mc) `(= ,(caddr ws) a) `(= ,(cadddr ws) b)))
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-ass!) #t)
                            ((dk-head-is? (dk-goal) 'FORSOME) (ew (list-ref ps 4)) (dk-ass!))
                            (#t (error "7.7(2): open" (dk-goal)))))))))))))
(qed 'or-77-initiator)

;;; 7.7 (3): {N M A B}_KBS, A /= B, originating on a regular node: the node is a responder's second, of
;;; Resp[A, B, N, M, K, H, H2] for some K, H, H2, and N originates there.
(sp (make-wff `(FORALL orp (FORALL n (FORALL nc (FORALL mc (FORALL a (FORALL b
  (IMPLIES (IS-OR-SPACE orp) (IMPLIES (IN a ,orl-names) (IMPLIES (IN b ,orl-names) (IMPLIES (NOT (= a b))
  (IMPLIES (IS-REGULAR-NODE ,orl-isp n) (IMPLIES (IN nc ,orl-T) (IMPLIES (IN mc ,orl-T)
  (IMPLIES (ORIGINATES ,orl-sp (ENCR (LST (LIST nc mc a b)) ,(orl-ka 'b)) n)
    (AND (= (NTH 1 n) 2)
    (AND (FORSOME k0 (FORSOME h0 (FORSOME g0 (IS-OR-RESP orp ((STRAND-MAP ,orl-sp) (NTH 2 n)) a b nc mc k0 h0 g0))))
         (ORIGINATES ,orl-sp nc (LIST 2 (NTH 2 n)))))))))))))))))))))
(dk-peel!)
(orl-or-space!)
(orl-name! 'a) (orl-name! 'b)
(dks-msg! '(LST (LIST nc mc a b)))
(orl-encr-origin-cases! '(LST (LIST nc mc a b)) 'b 'n
  (lambda (kind hyp lit j g y)
    (let ((h '(LST (LIST nc mc a b))))
      (if (eq? kind 'serv)
          (dks-lit-neq! h g)
          (let* ((ps (cdddr hyp))
                 (es (orl-paths! `(= ,h ,g) '(1 2 3 4)))
                 (z (cadr y)))
            (dk-cite! 'or-ltkey-injective-at 'orp 'b z)
            (if (eq? kind 'init)
                ;; KBS = KA'S: B = A' = A
                (begin
                  (orl-eq-chain! 'b 'a z)
                  (dk-have! '(= a b) (lambda () (dks-subst-rfl! '(= b a))))
                  (ai '(NOT (= a b))))
                (let ((ws (cdr (cadr g))))
                  (dk-landed* (lambda () (apply fact 'or-resp-nonce-originates 'orp `(NTH 2 n) ps)))
                  (dk-rewrite-h! `(ORIGINATES ,orl-sp ,(car ws) (LIST 2 (NTH 2 n))) (car ws) 'nc)
                  (orl-rewrite-all! hyp (list `(= ,(car ws) nc) `(= ,(cadr ws) mc) `(= ,(caddr ws) a) `(= ,(cadddr ws) b)))
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-ass!) #t)
                            ((dk-head-is? (dk-goal) 'FORSOME) (ew (list-ref ps 4)) (ew (list-ref ps 5)) (ew (list-ref ps 6)) (dk-ass!))
                            (#t (error "7.7(3): open" (dk-goal)))))))))))))
(qed 'or-77-responder)

;;; -----------------------------------------------------------------------
;;; SECTION 7.3.1-7.3.2: THE GUARANTEES.

;;; Any term that is a subterm of the content of a bundle node originates on some bundle node (Lemma 2.7
;;; and 2.9 together: the minimal node of {z in C : t @ content(z)}).
(sp (make-wff '(FORALL c (FORALL spa (FORALL u (FORALL z
  (IMPLIES (IS-BUNDLE c) (IMPLIES (= (BSPACE c) spa) (IMPLIES (IN z (BNODES c))
  (IMPLIES (IS-SUBTERM (TOKENS spa) (KEYS spa) u (NODE-CONTENT spa z))
    (FORSOME r (AND (IN r (BNODES c)) (ORIGINATES spa u r)))))))))))))
(dk-peel!)
(let* ((w '(SEP bsw_ (BNODES c) (IS-SUBTERM (TOKENS spa) (KEYS spa) u (NODE-CONTENT spa bsw_)))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,w) (IN z (BNODES c))))
    (lambda () (let ((v (cadr (car (dk-peel!))))) (sep-me `(IN ,v ,w)) (dk-ass!))))
  (dk-have! `(FORSOME v (IN v ,w)) (lambda () (ew 'z) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (let* ((r (dk-skolem! (dk-cite! 'bundle-minimal 'c w)))
         (minw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'PRECEDES-STRICT))) "r minimal")))
    (sep-me `(IN ,r ,w))
    (dk-have! `(IS-SUBTERM (TOKENS (BSPACE c)) (KEYS (BSPACE c)) u (NODE-CONTENT (BSPACE c) ,r))
      (lambda () (subst '(= (BSPACE c) spa)) (dk-ass!)))
    (dk-have! `(FORALL z (IMPLIES (IN z (BNODES c)) (IMPLIES (IS-SUBTERM (TOKENS (BSPACE c)) (KEYS (BSPACE c)) u (NODE-CONTENT (BSPACE c) z))
                  (NOT (IN (LIST z ,r) (PRECEDES-STRICT c))))))
      (lambda ()
        (let* ((lnd (dk-peel!))
               (v (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(BNODES c)))) lnd)))
               (hs (find-first (lambda (f) (dk-head-is? f 'IS-SUBTERM)) lnd)))
          (dk-rewrite-h! hs '(BSPACE c) 'spa)
          (dk-have! `(IN ,v ,w) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-apply! minw v)
          (dk-ass!))))
    (let ((o (dk-cite! 'bundle-minimal-originates 'c 'u r)))
      (dk-rewrite-h! o '(BSPACE c) 'spa)
      (ew r)
      (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'bundle-subterm-originates)

;;; THE NONCE SOURCES.  {Na MM U V}_KAS originating on a regular node, Na uniquely originating at the first
;;; node of an initiator's strand s in Init[A, B, Na, M, K]: then MM = M, U = A, V = B (the encryption is s's
;;; own).  Likewise {Nb MM U V}_KBS and a responder's strand in Resp[A, B, Nb, M, ...].
(define (orl-source-stmt kind)
  (let ((own (if (eq? kind 'init) `(IS-OR-INIT orp ((STRAND-MAP ,orl-sp) s) a b na m k)
                                 `(IS-OR-RESP orp ((STRAND-MAP ,orl-sp) s) a b na m k h g)))
        (key (orl-ka (if (eq? kind 'init) 'a 'b))))
    `(FORALL orp (FORALL s (FORALL a (FORALL b (FORALL na (FORALL m (FORALL k (FORALL h (FORALL g
      (FORALL r1 (FORALL mm (FORALL u (FORALL v
      ,(dks-curry (list '(IS-OR-SPACE orp) `(IN s (IDS ,orl-sp)) own `(UNIQUELY-ORIGINATES ,orl-sp na)
                        `(IS-REGULAR-NODE ,orl-isp r1) `(IN mm ,orl-T) `(IN u ,orl-names) `(IN v ,orl-names)
                        `(ORIGINATES ,orl-sp (ENCR (LST (LIST na mm u v)) ,key) r1))
         '(AND (= mm m) (AND (= u a) (= v b)))))))))))))))))))

(define (orl-source-proof! kind)
  (let* ((own (if (eq? kind 'init) `(IS-OR-INIT orp ((STRAND-MAP ,orl-sp) s) a b na m k)
                                 `(IS-OR-RESP orp ((STRAND-MAP ,orl-sp) s) a b na m k h g)))
         (x (if (eq? kind 'init) 'a 'b))
         (j0 (if (eq? kind 'init) 1 2))
         (hh '(LST (LIST na mm u v))))
    (dk-peel!)
    (orl-or-space!)
    (orl-name! 'u) (orl-name! 'v)
    (let ((own-lit (orl-open! own)))
      (dk-cite! 'token-in-msgs orl-T orl-K 'mm)
      (dks-msg! hh)
      (if (eq? kind 'init)
          (fact 'or-init-nonce-originates 'orp 's 'a 'b 'na 'm 'k)
          (fact 'or-resp-nonce-originates 'orp 's 'a 'b 'na 'm 'k 'h 'g))
      (orl-encr-origin-cases! hh x 'r1
        (lambda (kind2 hyp lit j gg y)
          (if (eq? kind2 'serv)
              (dks-lit-neq! hh gg)
              (let* ((ps (cdddr hyp))
                     (ws (cdr (cadr gg)))
                     (es (orl-paths! `(= ,hh ,gg) '(1 2 3 4)))
                     (j1 (if (eq? kind2 'init) 1 2))
                     (id `(NTH 2 r1)))
                ;; the nonce na originates on r1's strand at j1, and at [j0, s]
                (dk-landed* (lambda () (apply fact (if (eq? kind2 'init) 'or-init-nonce-originates 'or-resp-nonce-originates)
                                              'orp id ps)))
                (dk-rewrite-h! `(ORIGINATES ,orl-sp ,(car ws) (LIST ,j1 ,id)) (car ws) 'na)
                (fact 'originates-unique orl-sp 'na `(LIST ,j0 s) `(LIST ,j1 ,id))
                (dks-fact-split! 'node-pair-injective j1 id j0 's)
                (if (not (= j0 j1))
                    (dks-nn-absurd! `(= ,j1 ,j0))
                    ;; the same strand: the two traces agree
                    (let* ((lit-r (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `((STRAND-MAP ,orl-sp) ,id)))) "r1's trace"))
                           (eq `(= ,(caddr lit-r) ,own-lit)))
                      (dk-have! eq (lambda () (subst `(= ,(caddr lit-r) ((STRAND-MAP ,orl-sp) ,id)))
                                              (subst `(= ,id s)) (dk-ass!)))
                      (let* ((pm (dks-lit-path! eq (if (eq? kind 'init) '(1 2 LST 1) '(2 2 LST 1))))
                            (pa (dks-lit-path! eq (if (eq? kind 'init) '(1 2 LST 2) '(2 2 LST 2))))
                            (pb (dks-lit-path! eq (if (eq? kind 'init) '(1 2 LST 3) '(2 2 LST 3)))))
                        (dk-conj-close!
                          (lambda ()
                            (let* ((goal (dk-goal)) (lhs (cadr goal))
                                   (mid (cond ((eq? lhs 'mm) (cadr ws)) ((eq? lhs 'u) (caddr ws)) (#t (cadddr ws)))))
                              (orl-eq-chain! lhs (caddr goal) mid))))))))))))))

(sp (make-wff (orl-source-stmt 'init)))
(orl-source-proof! 'init)
(qed 'or-initiator-nonce-source)

(sp (make-wff (orl-source-stmt 'resp)))
(orl-source-proof! 'resp)
(qed 'or-responder-nonce-source)

;; E @ content(Z), Z in BNODES(c): E = ENCR(G, K_X) originates on a bundle node R1, which is regular (7.5,
;; K_X uncompromised); K! gets R1 (IN R1 (BNODES c)), (IS-REGULAR-NODE isp R1), (ORIGINATES sp E R1) in context
(define (orl-regular-origin! e z x g k!)
  (let* ((r1 (dk-skolem! (dk-cite! 'bundle-subterm-originates 'c orl-sp e z))))
    (use-em `(IS-ADVERSARY-NODE ,orl-isp ,r1)
      (lambda ()
        (ai (dk-apply! (dk-cite! 'or-ltkey-no-adversary-origin 'orp 'c x) r1 g)))
      (lambda ()
        (dk-have! `(IS-REGULAR-NODE ,orl-isp ,r1)
          (lambda ()
            (mac 'is-regular-node)
            (di)
            (dk-have! `(IS-ADVERSARY-NODE ,orl-isp ,r1) (lambda () (mac 'is-adversary-node) (dk-ass!)))
            (ai `(NOT (IS-ADVERSARY-NODE ,orl-isp ,r1)))))
        (k! r1)))))

;; R in BNODES(c), (= (NTH 1 R) J) in context: land (IN (LIST J (NTH 2 R)) (BNODES c)), (NTH 2 R) in IDS, and
;; (NOT (IN (NTH 2 R) ADV-IDS)) when R is regular
(define (orl-bnode-at! r j)
  (if (not (dk-asm? `(IN ,r (NODES ,orl-sp))))
      (begin
        (fact 'bundle-space 'c)
        (dk-apply! (dk-cite! 'bundle-nodes-in-space 'c) r)
        (dk-rewrite-h! `(IN ,r (NODES (BSPACE c))) '(BSPACE c) orl-sp)))
  (dks-fact-split! 'node-parts orl-sp r)
  (let ((pr `(LIST (NTH 1 ,r) (NTH 2 ,r)))
        (nj `(LIST ,j (NTH 2 ,r))))
    (dk-congr! `(= (NTH 1 ,r) ,j) (lambda (t) `(LIST ,t (NTH 2 ,r))))
    (dk-have! `(IN ,nj (BNODES c))
      (lambda ()
        (subst `(= ,nj ,pr))
        (subst `(= ,pr ,r))
        (dk-ass!)))))

;; the content of the node [J, ID] of a strand whose trace LIT is in context ((= sigma(ID) LIT)), J a numeral:
;; land the node in NODES and its content and direction, reduced; return the content literal
(define (orl-node-at! id j lit)
  (let* ((sg `((STRAND-MAP ,orl-sp) ,id))
         (len (length (cdr lit)))
         (nd `(LIST ,j ,id))
         (ej (list-ref lit j)))
    (if (not (dk-asm? `(= (LENGTH ,sg) ,len)))
        (dk-have! `(= (LENGTH ,sg) ,len) (lambda () (subst `(= ,sg ,lit)) (len-r) (rfl))))
    (dk-have! `(= (NTH ,j ,sg) ,ej) (lambda () (subst `(= ,sg ,lit)) (nth-r) (rfl)))
    (dk-have! `(IN ,j NN) (lambda () (arith)))
    (dk-have! `(<= 1 ,j) (lambda () (dk-nn!)))
    (dk-have! `(<= ,j (LENGTH ,sg)) (lambda () (subst `(= (LENGTH ,sg) ,len)) (arith)))
    (fact 'node-intro orl-sp j id)
    (dk-have! `(= (NTH ,j ((STRAND-MAP ,orl-sp) (NTH 2 ,nd))) ,ej) (lambda () (nth-r) (dk-ass!)))
    (dk-have! `(= (NTH 1 ,nd) ,j) (lambda () (nth-r) (rfl)))
    (fact 'node-content-eq orl-sp nd j ej)
    (dk-split-all!)
    (dks-nth-all!)
    (caddr ej)))

;; [I, ID] ==> [J, ID] (I < J numerals, both nodes), and [J, ID] in BNODES(c): land [I, ID] in BNODES(c)
(define (orl-earlier-in-bundle! id i j)
  (let ((ni `(LIST ,i ,id)) (nj `(LIST ,j ,id)))
    (dk-have! `(SAME-STRAND-BEFORE (BSPACE c) ,ni ,nj)
      (lambda ()
        (subst `(= (BSPACE c) ,orl-sp))
        (mac 'same-strand-before)
        (nth-r)
        (dk-conj-close! (lambda () (cond ((dk-ass!) #t) ((dk-head-is? (dk-goal) '=) (rfl)) (#t (dk-nn!)))))))
    (dk-apply! (dk-cite! 'bundle-ssb-closed 'c nj) ni)))

;; land E @ (NODE-CONTENT sp ND) for E occurring in the node's literal content C
(define (orl-sub-at! e nd c . opt)
  (dks-sub-fwd! e c)
  (dk-have! `(IS-SUBTERM ,orl-T ,orl-K ,e (NODE-CONTENT ,orl-sp ,nd))
    (lambda () (dks-subst-ass! (if (pair? opt) (car opt) (dks-eq-for `(NODE-CONTENT ,orl-sp ,nd)))))))

;;; THEOREM 7.8: the initiator's guarantee.
(sp (make-wff `(FORALL orp (FORALL c (FORALL s (FORALL a (FORALL b (FORALL na (FORALL m (FORALL k
  ,(dks-curry (list '(IS-OR-SPACE orp) '(IS-BUNDLE c) `(= (BSPACE c) ,orl-sp) `(IN s (IDS ,orl-sp)) '(NOT (= a b))
                    `(UNIQUELY-ORIGINATES ,orl-sp na)
                    `(NOT (IN ,(orl-ka 'a) (ADV-TOKENS ,orl-isp))) `(NOT (IN ,(orl-ka 'b) (ADV-TOKENS ,orl-isp)))
                    `(IS-OR-INIT orp ((STRAND-MAP ,orl-sp) s) a b na m k)
                    '(IN (LIST 2 s) (BNODES c)))
     `(FORSOME nb (AND (IN nb ,orl-T)
        (AND (FORSOME sr (AND (IN sr (IDS ,orl-sp)) (AND (NOT (IN sr (ADV-IDS ,orl-isp))) (AND (IN (LIST 2 sr) (BNODES c))
               (FORSOME k0 (FORSOME h0 (FORSOME g0 (IS-OR-RESP orp ((STRAND-MAP ,orl-sp) sr) a b nb m k0 h0 g0))))))))
             (FORSOME sv (AND (IN sv (IDS ,orl-sp)) (AND (NOT (IN sv (ADV-IDS ,orl-isp))) (AND (IN (LIST 2 sv) (BNODES c))
               (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) sv) a b na nb m k)))))))))))))))))))
(dk-peel!)
(orl-or-space!)
(let* ((own `(IS-OR-INIT orp ((STRAND-MAP ,orl-sp) s) a b na m k))
       (own-lit (orl-open! own))
       (c2 (orl-node-at! 's 2 own-lit))
       (e `(ENCR (LST (LIST na k)) ,(orl-ka 'a))))
  (orl-sub-at! e '(LIST 2 s) c2)
  (orl-regular-origin! e '(LIST 2 s) 'a '(LST (LIST na k))
    (lambda (r1)
      (dks-fact-split! 'or-77-server 'orp 'a r1 'na 'k)
      (let ((sv `(NTH 2 ,r1)))
        (orl-bnode-at! r1 2)
        (orl-regular! r1)
        (dks-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'IS-OR-SERV))) "the two server shapes")
          (lambda (d)
            (let* ((ws (dks-trace-witnesses! d 3))
                   (sh (dk-pick (lambda (f) (and (dk-head-is? f 'IS-OR-SERV) (dk-contains? f (car (last-pair ws))))) "the server"))
                   (ps (cdddr sh))                 ; a' b' na' nb' m' k
                   (lit (orl-open! sh))
                   (c1 (orl-node-at! sv 1 lit))
                   (c2s (orl-node-at! sv 2 lit))
                   (a-resp? (equal? (cadr ps) 'a)))
              (orl-earlier-in-bundle! sv 1 2)
              (if a-resp?
                  ;; Serv[a0, A, o0, Na, m0, K]: {Na m0 a0 A}_KAS would be the initiator's own, so A = B
                  (let ((e2 `(ENCR (LST (LIST na ,(list-ref ps 4) ,(car ps) a)) ,(orl-ka 'a))))
                    (orl-sub-at! e2 `(LIST 1 ,sv) c1)
                    (orl-regular-origin! e2 `(LIST 1 ,sv) 'a (cadr e2)
                      (lambda (r2)
                        (dks-fact-split! 'or-initiator-nonce-source 'orp 's 'a 'b 'na 'm 'k 'k 'k r2 (list-ref ps 4) (car ps) 'a)
                        (dk-have! '(= a b) (lambda () (dks-subst-rfl! '(= b a))))
                        (ai '(NOT (= a b))))))
                  ;; Serv[A, b0, Na, o0, m0, K]: the initiator's own {Na M A B}_KAS, so b0 = B and m0 = M
                  (let ((e1 `(ENCR (LST (LIST na ,(list-ref ps 4) a ,(cadr ps))) ,(orl-ka 'a))))
                    (orl-sub-at! e1 `(LIST 1 ,sv) c1)
                    (orl-regular-origin! e1 `(LIST 1 ,sv) 'a (cadr e1)
                      (lambda (r2)
                        (dks-fact-split! 'or-initiator-nonce-source 'orp 's 'a 'b 'na 'm 'k 'k 'k r2 (list-ref ps 4) 'a (cadr ps))
                        (let* ((b0 (cadr ps)) (o0 (list-ref ps 3)) (m0 (list-ref ps 4))
                               (sh2 (orl-rewrite-all! sh (list `(= ,b0 b) `(= ,m0 m))))
                               (c1b (dk-rewrite-h! (dks-eq-for `(NODE-CONTENT ,orl-sp (LIST 1 ,sv))) b0 'b))
                               (c1c (dk-rewrite-h! c1b m0 'm))
                               (e3 `(ENCR (LST (LIST ,o0 m a b)) ,(orl-ka 'b))))
                          (orl-sub-at! e3 `(LIST 1 ,sv) (caddr c1c) c1c)
                          (orl-regular-origin! e3 `(LIST 1 ,sv) 'b (cadr e3)
                            (lambda (r3)
                              (dks-fact-split! 'or-77-responder 'orp r3 o0 'm 'a 'b)
                              (orl-bnode-at! r3 2)
                              (orl-regular! r3)
                              (ew o0)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-ass!) #t)
                                        ((dk-contains? (dk-goal) 'IS-OR-RESP)
                                         (ew `(NTH 2 ,r3)) (dk-conj-close! (lambda () (dk-ass!))))
                                        (#t (ew sv) (dk-conj-close! (lambda () (dk-ass!)))))))))))))))))))))
(qed 'or-initiator-guarantee)

;;; THEOREM 7.9: the responder's guarantee.
(sp (make-wff `(FORALL orp (FORALL c (FORALL s (FORALL a (FORALL b (FORALL nb (FORALL m (FORALL k (FORALL h (FORALL g
  ,(dks-curry (list '(IS-OR-SPACE orp) '(IS-BUNDLE c) `(= (BSPACE c) ,orl-sp) `(IN s (IDS ,orl-sp)) '(NOT (= a b))
                    `(UNIQUELY-ORIGINATES ,orl-sp nb)
                    `(NOT (IN ,(orl-ka 'a) (ADV-TOKENS ,orl-isp))) `(NOT (IN ,(orl-ka 'b) (ADV-TOKENS ,orl-isp)))
                    `(IS-OR-RESP orp ((STRAND-MAP ,orl-sp) s) a b nb m k h g)
                    '(IN (LIST 3 s) (BNODES c)))
     `(AND (FORSOME si (AND (IN si (IDS ,orl-sp)) (AND (NOT (IN si (ADV-IDS ,orl-isp))) (AND (IN (LIST 1 si) (BNODES c))
             (FORSOME n0 (FORSOME k0 (IS-OR-INIT orp ((STRAND-MAP ,orl-sp) si) a b n0 m k0)))))))
           (FORSOME sv (AND (IN sv (IDS ,orl-sp)) (AND (NOT (IN sv (ADV-IDS ,orl-isp))) (AND (IN (LIST 2 sv) (BNODES c))
             (FORSOME n0 (IS-OR-SERV orp ((STRAND-MAP ,orl-sp) sv) a b n0 nb m k))))))))))))))))))))
(dk-peel!)
(orl-or-space!)
(let* ((own `(IS-OR-RESP orp ((STRAND-MAP ,orl-sp) s) a b nb m k h g))
       (own-lit (orl-open! own))
       (c3 (orl-node-at! 's 3 own-lit))
       (e `(ENCR (LST (LIST nb k)) ,(orl-ka 'b))))
  (orl-sub-at! e '(LIST 3 s) c3)
  (orl-regular-origin! e '(LIST 3 s) 'b '(LST (LIST nb k))
    (lambda (r1)
      (dks-fact-split! 'or-77-server 'orp 'b r1 'nb 'k)
      (let ((sv `(NTH 2 ,r1)))
        (orl-bnode-at! r1 2)
        (orl-regular! r1)
        (dks-or-each! (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'IS-OR-SERV))) "the two server shapes")
          (lambda (d)
            (let* ((ws (dks-trace-witnesses! d 3))
                   (sh (dk-pick (lambda (f) (and (dk-head-is? f 'IS-OR-SERV) (dk-contains? f (car (last-pair ws))))) "the server"))
                   (ps (cdddr sh))                 ; a' b' na' nb' m' k
                   (lit (orl-open! sh))
                   (c1 (orl-node-at! sv 1 lit))
                   (c2s (orl-node-at! sv 2 lit))
                   (b-resp? (equal? (cadr ps) 'b)))
              (orl-earlier-in-bundle! sv 1 2)
              (if (not b-resp?)
                  ;; Serv[B, b0, Nb, o0, m0, K]: {Nb m0 B b0}_KBS would be the responder's own, so B = A
                  (let ((e1 `(ENCR (LST (LIST nb ,(list-ref ps 4) b ,(cadr ps))) ,(orl-ka 'b))))
                    (orl-sub-at! e1 `(LIST 1 ,sv) c1)
                    (orl-regular-origin! e1 `(LIST 1 ,sv) 'b (cadr e1)
                      (lambda (r2)
                        (dks-fact-split! 'or-responder-nonce-source 'orp 's 'a 'b 'nb 'm 'k 'h 'g r2 (list-ref ps 4) 'b (cadr ps))
                        (dk-have! '(= a b) (lambda () (dks-subst-rfl! '(= b a))))
                        (ai '(NOT (= a b))))))
                  ;; Serv[a0, B, o0, Nb, m0, K]: the responder's own {Nb M A B}_KBS, so a0 = A and m0 = M
                  (let ((e2 `(ENCR (LST (LIST nb ,(list-ref ps 4) ,(car ps) b)) ,(orl-ka 'b))))
                    (orl-sub-at! e2 `(LIST 1 ,sv) c1)
                    (orl-regular-origin! e2 `(LIST 1 ,sv) 'b (cadr e2)
                      (lambda (r2)
                        (dks-fact-split! 'or-responder-nonce-source 'orp 's 'a 'b 'nb 'm 'k 'h 'g r2 (list-ref ps 4) (car ps) 'b)
                        (let* ((a0 (car ps)) (o0 (list-ref ps 2)) (m0 (list-ref ps 4))
                               (sh2 (orl-rewrite-all! sh (list `(= ,a0 a) `(= ,m0 m))))
                               (c1b (dk-rewrite-h! (dks-eq-for `(NODE-CONTENT ,orl-sp (LIST 1 ,sv))) a0 'a))
                               (c1c (dk-rewrite-h! c1b m0 'm))
                               (e3 `(ENCR (LST (LIST ,o0 m a b)) ,(orl-ka 'a))))
                          (orl-sub-at! e3 `(LIST 1 ,sv) (caddr c1c) c1c)
                          (orl-regular-origin! e3 `(LIST 1 ,sv) 'a (cadr e3)
                            (lambda (r3)
                              (dks-fact-split! 'or-77-initiator 'orp r3 o0 'm 'a 'b)
                              (orl-bnode-at! r3 1)
                              (orl-regular! r3)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-ass!) #t)
                                        ((dk-contains? (dk-goal) 'IS-OR-INIT)
                                         (ew `(NTH 2 ,r3))
                                         (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME) (begin (ew o0) (dk-ass!)) (dk-ass!)))))
                                        (#t (ew sv)
                                            (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME) (begin (ew o0) (dk-ass!)) (dk-ass!))))))))))))))))))))))
(qed 'or-responder-guarantee)
