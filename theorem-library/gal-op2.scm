(define (go-mod!) (dk-cite! 'module-scalar-ring 'md) (dk-cite! 'module-vzero-in 'md))
(define (go-ns k v) (list 'VNB-LAMBDA 'gpk_ 'NN (list '(ACT md) (list '(NEG (SCAL md)) (list k 'gpk_)) (list 'OP-ITER 'md 'tt v 'gpk_))))
(define go-mone '((NEG (SCAL md)) (ONE (SCAL md))))
(define (go-kh body)
  (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) (list 'IMPLIES '(IS-COMMUTATIVE-RING (SCAL md))
    (list 'FORALL 'v (list 'IMPLIES '(IN v (VEC md)) (list 'FORALL 'k (list 'IMPLIES '(IN k (CARR (POLY (SCAL md))))
      (list 'IMPLIES (list '= (list 'k go-n) '(ONE (SCAL md))) (list 'IMPLIES (list '= (go-pop 'k 'v) '(VZERO md))
