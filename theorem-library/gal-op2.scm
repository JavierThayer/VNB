  (go-deg! 'k)
  (dk-cite! 'krylov-in-mat 'md 'tt go-n 'v))
(define (go-low! i)                     ; i in NN, i < n: T^i v in the span
  (if (not (dk-asm? (list 'IN (go-it 'v i) go-SP)))
      (begin
        (go-int-succ! i go-n)
        (dk-cite! 'lin-span-member 'md go-n go-K (list 'succ i))
        (dk-cite! 'krylov-entry 'md 'tt go-n 'v (list 'succ i))
        (dk-cite! 'bt-succ-minus-1 i)
        (let* ((h1 (dk-rewrite-h! (list 'IN (list 'ENTRY go-K (list 'succ i) 1) go-SP) (list 'ENTRY go-K (list 'succ i) 1) (go-it 'v (list '- (list 'succ i) 1)))))
          (dk-rewrite-h! h1 (list '- (list 'succ i) 1) i)))))
(define (go-cr A n j) (list 'COL-AS-ROW A n j))
(define (go-crg A n j) (list 'VNB-LAMBDA '(LIST gcri_ gcrk_) (list 'CARTESIAN '(INTERVAL 1 1) (list 'INTERVAL 1 n)) (list 'ENTRY A 'gcrk_ j)))
(define (go-cr-pre body)
  (list 'FORALL 'a (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'x (list 'FORALL 'A (list 'IMPLIES '(IN A (MAT n n x))
    (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) body)))))))))
(define (go-crg-val! A n j r c)         ; r in 1..1, c in 1..n: g(r, c) = A_(c, j), a member of x
  (dk-cite! 'entry-in-carrier n n 'x A c j)
  (dk-have! (list '= (list (go-crg A n j) r c) (list 'ENTRY A c j)) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
(define (go-crg-pt! A n j P)            ; P: (lambda (r c) ...) builds the pointwise claim to prove
  (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 1)) (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ (list 'INTERVAL 1 n)) (P 'i_ 'j_)))))
    (lambda ()
      (let* ((ls (dk-peel!))
             (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'INTERVAL))) ls)))
             (r (car ins)) (c (cadr ins)))
        (go-crg-val! A n j r c)
