(define (gq-min! var guard prove-nonempty!)
  ;; land TYPE and NONEMPTY, then minimize; return the minimizer
  (let ((ty (list 'FORALL var (list 'IMPLIES (list 'AND (list 'IN var 'NN) guard) (list 'IN var 'NN))))
        (ne (list 'FORSOME var (list 'AND (list 'IN var 'NN) guard))))
    (dk-have! ty (lambda () (dk-peel!) (dk-split-all!) (ass)))
    (dk-have! ne prove-nonempty!)
    (let ((r (minimize! (list var) (list 'AND (list 'IN var 'NN) guard) var)))
      (dk-split-all!)
      (car (car r)))))
