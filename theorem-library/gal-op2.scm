;;; gal-op2.scm -- the matrix of an operator in a basis is unique; (pq)(T) = p(T) q(T); nilpotent operators
;;; with a cyclic vector (galois-theory notes, Example 1.39); Cayley-Hamilton for an operator with a cyclic
;;; vector (GALOIS B6, 2026-10-26).  Destination: theorem-library/gal-op2.scm, library linear-algebra.
;;; Load window: after gal-op.scm.  Helper prefixes go- (copied from gal-op.scm) and gq-.
;;; ======================================================================
;;; helpers copied from gal-op.scm (prefix go-)
(define (go-gc-case! p pos neg)
  (cond ((dk-asm? (list 'NOT p)) (neg))
        ((dk-asm? p) (pos))
        (#t (use-em p pos neg))))
(define (go-open! name args hyp)        ; HYP = (NAME . ARGS) in context: land its definiens, split it
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (go-close! name args rhs!)      ; close the goal (NAME . ARGS) by proving its definiens with RHS!
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (go-skolem!)
  (let ((w (dk-skolem! (dk-pick (lambda (fm) (dk-head-is? fm 'FORSOME)) "the witness"))))
    (dk-split-all!)
    w))
(define (go-rfl-or-ass!) (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define go-hom-add #f)
(define go-hom-act #f)
(define go-hom-zero '(= (tt (VZERO md)) (VZERO md)))
(define (go-hom!)
  (if (not (dk-asm? '(IN tt (FUN (VEC md) (VEC md)))))
      (let ((rhs (go-open! 'is-hom-module-def '(md md tt) '(IS-HOM-MODULE md md tt))))
        (dk-split-all!)
        (dk-cite! 'module-scalar-ring 'md)
        (dk-cite! 'module-vector-ag-is-abelian-group 'md)
        (dk-cite! 'mvag-carr 'md) (dk-cite! 'mvag-op 'md) (dk-cite! 'mvag-id 'md)
        (dk-cite! 'module-vzero-in 'md)))
  (set! go-hom-add (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'VADD) (not (dk-contains? fm 'ACT)) (dk-contains? fm 'tt))) "additivity"))
  (set! go-hom-act (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ACT) (dk-contains? fm 'tt))) "homogeneity")))
(define (go-it w k) (list 'OP-ITER 'md 'tt w k))
(define (go-vadd a b) (list '(VADD md) a b))
(define (go-act c a) (list '(ACT md) c a))
(define (go-it-type! w k)               ; w in VEC, k in NN
  (if (not (dk-asm? (list 'IN (go-it w k) '(VEC md)))) (dk-cite! 'op-iter-type k 'md 'tt w)))
(define (go-tt-type! x) (if (not (dk-asm? (list 'IN (list 'tt x) '(VEC md)))) (dk-type! (list 'tt x) '(VEC md))))
(define (go-ind-leaves!)                ; after (ni): (base . step)
  (let* ((ls (dk-open-leaves))
         (st (find-first (lambda (nd) (let ((g (dk-goal-of nd))) (and (dk-head-is? g 'FORALL) (dk-contains? g 'succ)
                                                                     (dk-head-is? (caddr g) 'IMPLIES)
                                                                     (dk-head-is? (cadr (caddr g)) 'IN)
                                                                     (equal? (caddr (cadr (caddr g))) 'NN)))) ls)))
    (cons (find-first (lambda (nd) (not (eq? nd st))) ls) st)))
(define (go-iter-law! name stmt base! step!)
  (sp (make-wff stmt))
  (ni)
  (let ((l (go-ind-leaves!)))
    (dk-focus! (car l))
    (dk-peel!)
    (go-hom!)
    (base!)
    (dk-focus! (cdr l))
    (let ((ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'OP-ITER))) (dk-peel!))))
      (go-hom!)
      (step! ih)))
  (qed name)
  (topic! name 'algebra))
(define (go-hom-stmt body)
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) body))))))
(define (go-z! w) (subst (dk-cite! 'op-iter-zero 'md 'tt w)))
(define (go-s! w k) (subst (dk-cite! 'op-iter-succ 'md 'tt w k)))
(define (go-sh h) (list 'VNB-LAMBDA 'gbk_ 'NN (list h '(succ gbk_))))
(define (go-seg! i n)                   ; i in ORD-SEGMENT(n), n in NN: land i in NN, i < n, succ i in 1..n
  (if (not (dk-asm? (list 'IN i 'NN))) (dk-cite! 'ord-segment-nn-subset n i))
  (if (not (dk-asm? (list '< i n)))
      (let ((iff (dk-cite! 'seg-mem-lt n i)))
        (dk-have! (list '< i n) (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN i (list 'ORD-SEGMENT n)))) prop)))))
  (go-int-succ! i n))
(define (go-int-succ! i n)              ; i in NN, i < n: land succ i in INTERVAL(1, n)
  (if (not (dk-asm? (list 'IN (list 'succ i) (list 'INTERVAL 1 n))))
      (begin
        (dk-cite! 'nn-succ-closed i)
        (dk-cite! 'nn-one-le-succ i)
        (dk-cite! 'nn-lt-succ-le i n)
        (dk-cite! 'interval-mem-intro 1 n (list 'succ i)))))
(define (go-int! z n)                   ; z in INTERVAL(1, n): land z in NN, 1 <= z, z <= n
  (if (not (dk-asm? (list 'IN z 'NN)))
      (let* ((iff (dk-cite! 'interval-membership 1 n z)) (rhs (caddr iff)))
        (dk-have! rhs (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN z (list 'INTERVAL 1 n)))) prop)))
        (dk-split-all! (list rhs)))))
(define (go-int-mem! z a b)             ; z in NN, a <= z, z <= b in context: z in INTERVAL(a, b)
  (if (not (dk-asm? (list 'IN z (list 'INTERVAL a b)))) (dk-cite! 'interval-mem-intro a b z)))
(define (go-kry v n) (list 'KRYLOV 'md 'tt v n))
(define (go-kg v n) (list 'VNB-LAMBDA '(LIST gkri_ gkrj_) (list 'CARTESIAN (list 'INTERVAL 1 n) '(INTERVAL 1 1)) (list 'OP-ITER 'md 'tt v '(- gkri_ 1))))
(define (go-pred-nn! i n)               ; i in INTERVAL(1, n): land i - 1 in NN
  (go-int! i n)
  (if (not (dk-asm? (list 'IN (list '- i 1) 'NN)))
      (let ((k (begin (dk-cite! 'nn-pos-is-succ i) (go-skolem!))))
        (dk-cite! 'bt-succ-minus-1 k)
        (dk-have! (list 'IN (list '- i 1) 'NN)
          (lambda () (subst (list '= i (list 'succ k))) (subst (list '= (list '- (list 'succ k) 1) k)) (ass))))))
(define (go-kg-val! v n i j)            ; g(i, j) = T^(i-1) v, a vector
  (go-pred-nn! i n)
  (go-it-type! v (list '- i 1))
  (dk-have! (list '= (list (go-kg v n) i j) (go-it v (list '- i 1))) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
(define (go-kg-set! v n)
  (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 1)) (list 'IN (list (go-kg v n) 'i_ 'j_) 'SET)))))
    (lambda ()
      (let* ((ls (dk-peel!))
             (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'INTERVAL))) ls)))
             (i (car ins)) (j (cadr ins)))
        (go-kg-val! v n i j)
        (subst (list '= (list (go-kg v n) i j) (go-it v (list '- i 1))))
        (dk-cite! 'membership-implies-sethood (go-it v (list '- i 1)) '(VEC md))
        (ass)))))
(define (go-ks c v) (list 'VNB-LAMBDA 'gpk_ 'NN (list '(ACT md) (list 'ENTRY c 1 '(succ gpk_)) (list 'OP-ITER 'md 'tt v 'gpk_))))
(define go-mv '(MODULE-VECTOR-AG md))
(define go-NM 'NN-ADD-MONOID)
(define (go-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (go-conjs (cadr f)) (go-conjs (caddr f))) (list f)))
(define (go-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (go-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
(define (go-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want)) (dk-have! want (lambda () (slot 'CARR) (ass))))))
(define go-F '(SCAL md))
(define (go-nn! t)                      ; land t in NN for t built from NN atoms by succ and +
  (if (not (dk-asm? (list 'IN t 'NN)))
      (cond ((dk-head-is? t 'succ) (go-nn! (cadr t)) (dk-cite! 'nn-succ-closed (cadr t)))
            ((dk-head-is? t '+) (go-nn! (cadr t)) (go-nn! (caddr t))
             (dk-have! (list 'AND (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN)) (lambda () (dk-conj-close!)))
             (dk-cite! 'nn-add-closed (cadr t) (caddr t)))
            ((dk-head-is? t 'DEG) (go-deg! (caddr t)))
            (#t (error "go-nn!: cannot type" (expression->string t))))))
(define (go-ps p w) (list 'VNB-LAMBDA 'gpok_ 'NN (list '(ACT md) (list p 'gpok_) (list 'OP-ITER 'md 'tt w 'gpok_))))
(define (go-S p w n) (list 'SUM-AG go-mv (go-ps p w) n))
(define (go-ps-at! p w k)               ; k in NN: PS(k) = p_k T^k w, a vector
  (let ((val (list '(ACT md) (list p k) (go-it w k))))
    (dk-cite! 'poly-coef-in go-F p k)
    (go-it-type! w k)
    (dk-cite! 'module-act-type 'md (list p k) (go-it w k))
    (if (not (dk-asm? (list '= (list (go-ps p w) k) val)))
        (dk-have! (list '= (list (go-ps p w) k) val) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
    val))
(define (go-ps-sub! p w k)               ; rewrite PS(k) in the goal to p_k T^k w
  (let ((val (go-ps-at! p w k))) (subst (list '= (list (go-ps p w) k) val))))
(define (go-S-typ! p w n)               ; n in NN
  (go-nn! n)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda ()
      (dk-peel!)
      (let* ((i (cadr (cadr (dk-goal)))) (_ (begin (go-nn! n) (dk-cite! 'ord-segment-nn-subset n i))) (val (go-ps-at! p w i)))
        (subst (list '= (list (go-ps p w) i) val))
        (subst (list '= (list 'CARR go-mv) '(VEC md)))
        (ass))))
  (dk-cite! 'sum-ag-type-ptwise n go-mv (go-ps p w))
  (let ((t (list 'IN (go-S p w n) (list 'CARR go-mv))))
    (if (not (dk-asm? (list 'IN (go-S p w n) '(VEC md)))) (dk-rewrite-h! t (list 'CARR go-mv) '(VEC md)))))
(define (go-deg! p)                     ; p in CARR(POLY F): DEG in NN, DEG-BOUND at DEG, minimality
  (dk-split-all! (list (dk-cite! 'deg-well-defined go-F p))))
(define go-poly-stmt                    ; md, tt, hom, p, w prefix
  (lambda (body)
    (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt)
      (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR (POLY (SCAL md))))
        (list 'FORALL 'w (list 'IMPLIES '(IN w (VEC md)) body)))))))))
(define (go-pop p w) (list 'POLY-OP 'md 'tt p w))
(define go-D '(DEG (SCAL md) p))
(define go-sD '(succ (DEG (SCAL md) p)))
(define (go-mvag!) (if (not (dk-asm? (list '== (list 'CARR go-mv) '(VEC md)))) #t))
(define (go-ptwise-typ-n! p w n)       ; PS(p, w) pointwise in CARR(MVAG) on ORD-SEGMENT(n)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (go-nn! n) (dk-cite! 'ord-segment-nn-subset n i) (go-ps-sub! p w i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass)))))
(define (go-ptwise-typ! p w)            ; PS(p, w) pointwise in CARR(MVAG) on ORD-SEGMENT(sD)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! p w i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass)))))
(define go-tg '(VNB-LAMBDA gti_ NN (tt (g gti_))))
(define (go-gtyp n) (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) '(IN (g gbi_) (VEC md)))))
(define (go-seg-down! n)                ; from (go-gtyp (succ n)) in context, land (go-gtyp n)
  (let ((H (go-gtyp (list 'succ n))))
    (dk-have! (go-gtyp n)
      (lambda ()
        (dk-peel!)
        (let* ((i (cadr (cadr (dk-goal)))))
          (let ((iff (dk-cite! 'ord-segment-nn-succ n i)))
            (dk-have! (list 'IN i (list 'ORD-SEGMENT (list 'succ n)))
              (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN i (list 'ORD-SEGMENT n)))) prop)))
            (dk-apply! H i)
            (ass)))))))
(define (go-ps-typ-vec! p w)            ; PS(p, w) pointwise in VEC on ORD-SEGMENT(sD)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps p w) 'gbi_) '(VEC md))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! p w i) (ass)))))
(define (go-gker n) (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list '= (go-pop 'p '(g gbi_)) '(VZERO md)))))
(define (go-one11!)
  (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
      (begin (fact 'nn-one-in)
             (dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass))))))
(define (go-ks-at! c v n i)             ; i in ORD-SEGMENT(n), c in MAT(1,n,F): ks(i) = c_(i+1) T^i v, a vector
  (go-one11!)
  (go-seg! i n)
  (dk-cite! 'entry-in-carrier 1 n '(CARR (SCAL md)) c 1 (list 'succ i))
  (go-it-type! v i)
  (let ((val (go-act (list 'ENTRY c 1 (list 'succ i)) (go-it v i))))
    (dk-cite! 'module-act-type 'md (list 'ENTRY c 1 (list 'succ i)) (go-it v i))
    (if (not (dk-asm? (list '= (list (go-ks c v) i) val)))
        (dk-have! (list '= (list (go-ks c v) i) val) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
    val))
(define go-n '(DEG (SCAL md) k))
(define go-Z '(ZERO (SCAL md)))
(define (go-ann!)                       ; (IS-ANNIHILATING-POLY md tt v k) in context
  (go-open! 'IS-ANNIHILATING-POLY '(md tt v k) '(IS-ANNIHILATING-POLY md tt v k))
  (go-open! 'IS-MONIC '((SCAL md) k) '(IS-MONIC (SCAL md) k))
  (go-deg! 'k))
(define (go-q c n) (list 'VNB-LAMBDA 'gqk_ 'NN (list 'IF (list '< 'gqk_ n) (list 'ENTRY c 1 '(succ gqk_)) go-Z)))
(define (go-q-at! c n x)                ; x in NN: land (= (q x) value) according to x < n or not; return value
  (let* ((ift (list 'IF (list '< x n) (list 'ENTRY c 1 (list 'succ x)) go-Z))
         (lt? (dk-asm? (list '< x n)))
         (val (if lt? (list 'ENTRY c 1 (list 'succ x)) go-Z)))
    (if lt? (begin (go-one11!) (go-int-succ! x n) (dk-cite! 'entry-in-carrier 1 n '(CARR (SCAL md)) c 1 (list 'succ x))))
    (dk-have! (list '= (list (go-q c n) x) val)
      (lambda ()
        (dk-lam-b!)
        (if lt?
            (dk-if-branch! #t ift (lambda () (ass)) go-rfl-or-ass!)
            (dk-if-branch! #f ift (lambda () (ass)) go-rfl-or-ass!))))
    val))
(define (go-q-typ! c n x)               ; x in NN: q(x) in CARR(F)
  (go-one11!)
  (go-case! (list '< x n)
    (lambda () (go-int-succ! x n) (dk-cite! 'entry-in-carrier 1 n '(CARR (SCAL md)) c 1 (list 'succ x)))
    (lambda () #t))
  #t)
(define (go-case! p pos neg) (go-gc-case! p pos neg))
(define (go-rr! . ts) (for-each (lambda (t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-cite! 'nn-in-rr t))) ts))
