(define (m38-nth-r!)                 ; reduce NTH of a literal list in the goal, to a fixpoint
  (let loop ((n 0))
    (if (and (< n 12)
             (let scan ((e (dk-goal)))
               (and (pair? e)
                    (or (and (eq? (car e) 'NTH) (pair? (cddr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST))
                        (any-pred scan e)))))
        (begin (nth-r) (loop (+ n 1))))))
(define (m38-pair-in-Z! x z)         ; x in PTS s, z in F, x in sv(z|n) for all n in context: [x, z] in Z
  (let ((w (list 'LIST x z)))
    (dk-have! (list 'IN z '(PTS BAIRE-MS)) (lambda () (subst (list '= '(PTS BAIRE-MS) m38-F)) (mr-close-open!)))
    (fact 'pair-in-cartesian '(PTS s) '(PTS BAIRE-MS) x z)
    (dk-have! (list 'IN w m38-Z)
      (lambda ()
        (in-sep!
          (lambda ()
            (let ((n (cadr (car (dk-peel!)))))
              (m38-nth-r!)
              (dk-apply! (mr-find 'zall (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f z) (dk-contains? f x) (dk-contains? f 'RESTRICT)
                                                         (not (dk-contains? f 'NTH)))) (dk-asms)) n)
              (mr-close-open!))))))
    w))
(define (m38-lam-type! claim per-var!) ; claim (IN lambda (FUN A B)): lam-t, PER-VAR! on the peeled variable of each pointwise leaf
  (dk-have! claim
    (lambda ()
      (for-each (lambda (kn)
                  (if (not (sequent-node-grounded? kn))
                      (begin (dk-focus! kn)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (let ((v (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                   (per-var! v)
                                   (for-each (lambda (lf) (if (not (sequent-node-grounded? lf)) (begin (dk-focus! lf) (ass)))) (dk--open-below kn)))))))
                (dk-opened (lambda () (lam-t)))))))
