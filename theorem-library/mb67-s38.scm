;;; mb67-s38.scm -- construction of measures, chapter 5 section 1.9 (M-B67, 2026-10-27): Proposition 5.38, Souslin
;;; sets of a Polish space are exactly the Souslin sets of families of CLOSED sets (sieves or not).
;;; Sufficiency: Z = {(x, z) : x in S(z|n) for all n} is closed in X x N^N (Polish), and the Souslin set is its first
;;; projection.  Necessity: replace each S(p) of a sieve by the set of points at distance 0 from it (closed); the
;;; diameter and intersection properties keep the Souslin set (no CLOSURE head is used).
;;; Library: measure.  Helper prefixes mr- (copied), m38-.
;;; Load window: after mb67-prod2 (product2-baire-polish), mb67-baire (baire-close-agree, baire-delta, baire-ms-pts),
;;; mb35-souslin (SOUSLIN-SET, IS-SIEVE, prefix-in-nstar, prefix-eq-intro), mb67-souslin (closed-polish-souslin,
;;; souslin-continuous-image), product2-laws, metric-open-sets, rr-max-basics, rr-order-basics (rr-min-pos).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define m38-F '(FUN NN NN))
(define m38-C '(CARTESIAN (PTS s) (PTS BAIRE-MS)))
(define m38-P '(PRODUCT2-MS s BAIRE-MS))
(define (m38-pre z n) (list 'RESTRICT z (list 'ORD-SEGMENT n)))
(define (m38-ssbody sv0) (list 'SEP 'sxp_ '(PTS s) (list 'FORSOME 'sxz_ (list 'AND '(IN sxz_ (FUN NN NN))
  (list 'FORALL 'sxn_ (list 'IMPLIES '(IN sxn_ NN) (list 'IN 'sxp_ (list sv0 (m38-pre 'sxz_ 'sxn_)))))))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'sv (list '== '(SOUSLIN-SET s sv) (m38-ssbody 'sv))))))
(dk-peel!) (mac 'SOUSLIN-SET) (qrfl)
(qed 'souslin-set-unfold)
(topic! 'souslin-set-unfold 'analysis)
(define (m38-pfx! z n)               ; z in F, n in NN: z|n in NSTAR
  (if (not (dk-asm? (list 'IN (m38-pre z n) 'NSTAR)))
      (dk-split-all! (list (dk-cite! 'prefix-in-nstar z n)))))
(define (m38-ss-parts! x sv0)        ; x in SOUSLIN-SET(s, sv0) in context: x in PTS s, the witness z (returned) and its universal
  (dk-cite! 'souslin-set-unfold 's sv0)
  (let* ((h (dk-rewrite-h! (list 'IN x (list 'SOUSLIN-SET 's sv0)) (list 'SOUSLIN-SET 's sv0) (m38-ssbody sv0)))
         (ps (begin (dk-split-all! (list (mr-sep-parts! h))) #t))
         (z (dk-skolem! (mr-find 'ssz (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'sxz_) (dk-contains? f x))) (dk-asms)))))
    (dk-split-all!)
    z))
(define (m38-ss-in! x z sv0)         ; x in PTS s, z in F, the universal over n in context: x in SOUSLIN-SET(s, sv0)
  (dk-cite! 'souslin-set-unfold 's sv0)
  (dk-have! (list 'IN x (list 'SOUSLIN-SET 's sv0))
    (lambda ()
      (subst (list '= (list 'SOUSLIN-SET 's sv0) (m38-ssbody sv0)))
      (in-sep! (lambda () (ew z) (mr-and-close! (lambda () (mr-close-open!))))))))

(define (m38-ball-lt! sp0 c y r)     ; y in BALL(sp0, c, r) in context: y in PTS sp0 and d(c, y) < r
  (let* ((d (list (list 'DIST sp0) c y))
         (ps (mr-iff-parts! (dk-cite! 'ball-membership sp0 c r y))))
    (dk-cite! 'metric-dist-real sp0 c y)
    (if (not (dk-asm? (list '< d r)))
        (begin
          (dk-have! (list 'AND (list '<= d r) (list 'NOT (list '= d r))) (lambda () (dk-conj-close! (lambda () (ass)))))
          (mr-chain! (dk-fact! 'rr-le-ne-lt d r))))
    (list '< d r)))
(define (m38-in-ball! sp0 c y r)     ; y in PTS sp0, d(c, y) < r, typed: y in BALL(sp0, c, r)
  (let ((d (list (list 'DIST sp0) c y)))
    (dk-cite! 'metric-dist-real sp0 c y)
    (if (not (dk-asm? (list '<= d r))) (dk-have! (list '<= d r) (lambda () (dk-ineq! (list '< d r)))))
    (if (not (dk-asm? (list 'NOT (list '= d r)))) (mr-ne! d r (list '< d r)))
    (dk-have! (list 'IN y (list 'BALL sp0 c r))
      (lambda () (mac 'ball-membership) (dk-conj-close! (lambda () (ass)))))))
(define (m38-P! y n)                 ; y in N^N, n in NN: P(y, n) and recip P(y, n) typed, positive; returns recip P(y, n)
  (let* ((P (list 'PREFIX-PROD '(VNB-LAMBDA bwk_ NN 2) y n)) (rP (list 'recip P)))
    (if (not (dk-asm? (list '< 0 rP)))
        (begin
          (if (not (dk-asm? (list '<= (list '+ n 1) P))) (dk-split-all! (list (dk-cite! 'baire-prod-facts n y y))))
          (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-zero-le n)
          (dk-have! (list '< 0 P) (lambda () (dk-ineq! (list '<= (list '+ n 1) P) (list '<= 0 n) (list 'IN n 'RR) (list 'IN P 'RR))))
          (mr-ne! P 0 (list '< 0 P))
          (mr-chain! (dk-fact! 'rr-recip-closed P))
          (dk-cite! 'rr-recip-pos P)))
    rP))
(define (m38-close-ball! w w2 x x2 z z2 n r r1 dl dx dz cs pz)  ; the ball about w misses Z
  (begin
    (dk-have! (list '< dx r1) (lambda () (dk-ineq! (list '< dx r) (list '<= r r1) (list 'IN dx 'RR) (list 'IN r 'RR) (list 'IN r1 'RR))))
    (m38-in-ball! 's x x2 r1)
    (dk-cite! 'subset-mem-fwd (list 'BALL 's x r1) cs x2)
    (mr-iff-parts! (dk-cite! 'complement-in-membership '(PTS s) (list 'sv pz) x2))
    (let ((rp (m38-P! z n)))
      (dk-have! (list '< dz rp) (lambda () (dk-ineq! (list '< dz dl) (list '< dl rp) (list 'IN dz 'RR) (list 'IN dl 'RR) (list 'IN rp 'RR))))
      (let ((ag (dk-cite! 'baire-close-agree z z z2 n)))
        (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '< 'k n) (list '= (list z2 'k) (list z 'k)))))
          (lambda ()
            (let* ((ls (dk-peel!)) (lt (mr-find 'lt (lambda (f) (dk-head-is? f '<)) ls)) (k (cadr lt)))
              (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr n)
              (dk-have! (list '<= k n) (lambda () (dk-ineq! lt (list 'IN k 'RR) (list 'IN n 'RR))))
              (dk-apply! ag k)
              (dk-cite! 'fun-apply-type-c z 'NN 'NN k)
              (subst (list '= (list z2 k) (list z k)))
              (rfl))))
        (dk-cite! 'prefix-eq-intro z z2 n)
        (let ((iff (dk-cite! 'complement-in-membership (list 'PTS m38-P) m38-Z w2)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (begin
                        (di)
                        (dk-split-all! (list (mr-sep-parts! (list 'IN w2 m38-Z))))
                        (let* ((all2 (mr-find 'all2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'm38n_) (dk-contains? f w2))) (dk-asms)))
                               (h (dk-apply! all2 n)))
                          (dk-rewrite-h! h (m38-pre z2 n) (m38-pre z n))
                          (ai (list 'NOT (list 'IN x2 (list 'sv pz)))))))))))
          (mr-iff-back! iff)
          (mr-close-open!))))))
;;; ======================================================================
;;; sufficiency: the Souslin set of closed sets is the projection of a closed subset of X x N^N
;;; ======================================================================
(define m38-Z (list 'SEP 'm38w_ m38-C (list 'FORALL 'm38n_ (list 'IMPLIES '(IN m38n_ NN)
                (list 'IN '(NTH 1 m38w_) (list 'sv (m38-pre '(NTH 2 m38w_) 'm38n_)))))))
(define m38-closedhyp '(FORALL p (IMPLIES (IN p NSTAR) (IS-CLOSED s (sv p)))))
(define (m38-hyp body) (list 'FORALL 's (list 'IMPLIES '(IS-POLISH s) (list 'FORALL 'sv (list 'IMPLIES '(IN sv (FUN NSTAR (POWER (PTS s))))
                         (list 'IMPLIES m38-closedhyp body))))))
(define (m38-setup!)
  (mr-iff-parts! (dk-cite! 'is-polish 's))
  (mr-iff-parts! (dk-cite! 'is-complete 's))
  (dk-cite! 'baire-ms-is-metric-space)
  (dk-cite! 'baire-ms-pts)
  (dk-cite! 'product2-is-metric-space 's 'BAIRE-MS)
  (dk-cite! 'product2-pts 's 'BAIRE-MS)
  (fact 'nn-is-set)
  (dk-cite! 'ms-pts-is-set 's))
(define (m38-wparts! w)              ; w in C: NTH 1 w in PTS s, NTH 2 w in F
  (if (not (dk-asm? (list 'IN (list 'NTH 1 w) '(PTS s))))
      (begin
        (dk-split! (dk-cite! 'cartesian-nth w '(PTS s) '(PTS BAIRE-MS)))
        (dk-have! (list 'IN (list 'NTH 2 w) m38-F) (lambda () (subst '(= (FUN NN NN) (PTS BAIRE-MS))) (mr-close-open!))))))
(sp (make-wff (m38-hyp (list 'IS-CLOSED m38-P m38-Z))))
(dk-peel!)
(m38-setup!)
(define m38-Cz (list 'COMPLEMENT-IN (list 'PTS m38-P) m38-Z))
(let ((iff (dk-cite! 'is-closed m38-P m38-Z)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (cond
            ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'SUBSET)
             (mac 'subset-def)
             (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w m38-Z)) (subst (list '= (list 'PTS m38-P) m38-C)) (mr-close-open!)))
            (#t
             (let ((iff2 (dk-cite! 'is-open m38-P m38-Cz)))
               (dk-have! (caddr iff2)
                 (lambda ()
                   (mr-and-close!
                     (lambda ()
                       (cond
                         ((dk-asm? (dk-goal)) (ass))
                         ((dk-head-is? (dk-goal) 'SUBSET)
                          (dk-cite! 'complement-in-subset m38-Z (list 'PTS m38-P)) (mr-close-open!))
                         (#t
                          (let* ((w (dk-di-var!))
                                 (ps (mr-iff-parts! (dk-cite! 'complement-in-membership (list 'PTS m38-P) m38-Z w)))
                                 (wc (begin (dk-have! (list 'IN w m38-C) (lambda () (subst (list '= m38-C (list 'PTS m38-P))) (mr-close-open!))) w))
                                 (x (list 'NTH 1 w)) (z (list 'NTH 2 w)))
                            (m38-wparts! w)
                            ;; some level n has x outside sv(z|n)
                            (let* ((ex (list 'FORSOME 'm38k_ (list 'AND '(IN m38k_ NN) (list 'NOT (list 'IN x (list 'sv (m38-pre z 'm38k_)))))))
                                   (_0 (dk-have! ex
                                         (lambda ()
                                           (pbc)
                                           (dk-have! (list 'IN w m38-Z)
                                             (lambda ()
                                               (in-sep!
                                                 (lambda ()
                                                   (let ((n (cadr (car (dk-peel!)))))
                                                     (pbc)
                                                     (dk-have! ex (lambda () (ew n) (mr-and-close! (lambda () (mr-close-open!)))))
                                                     (ai (list 'NOT ex)))))))
                                           (ai (list 'NOT (list 'IN w m38-Z))))))
                                   (n (dk-skolem! ex))
                                   (_1 (dk-split-all!))
                                   (pz (m38-pre z n)))
                              (m38-pfx! z n)
                              (dk-apply! (dk-ctx-form m38-closedhyp) pz)
                              (dk-cite! 'fun-apply-type-c 'sv 'NSTAR '(POWER (PTS s)) pz)
                              (let* ((cps (mr-iff-parts! (dk-cite! 'is-closed 's (list 'sv pz))))
                                     (cs (list 'COMPLEMENT-IN '(PTS s) (list 'sv pz)))
                                     (ops (mr-iff-parts! (dk-cite! 'is-open 's cs)))
                                     (oall (car (last-pair ops))))
                                (dk-have! (list 'IN x cs) (lambda () (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))
                                (let* ((r1 (dk-skolem! (dk-apply! oall x)))
                                       (_2 (dk-split-all!))
                                       (bd (dk-split-all! (list (dk-cite! 'baire-delta z n))))
                                       (dl (list 'recip (list 'PREFIX-PROD '(VNB-LAMBDA bwk_ NN 2) z (list 'succ n)))))
                                  (dk-cite! 'nn-succ-closed n)
                                  (mr-pos! r1) (mr-pos! dl)
                                  (let ((r (dk-skolem! (dk-cite! 'rr-min-pos r1 dl))))
                                    (dk-split-all!)
                                    (dk-cite! 'rr-pos-rr-of-lt r)
                                    (ew r)
                                    (mr-and-close!
                                      (lambda ()
                                        (if (dk-asm? (dk-goal)) (ass)
                                            (begin
                                              (mac 'subset-def)
                                              (let* ((w2 (dk-di-var!))
                                                     (bp (mr-iff-parts! (dk-cite! 'ball-membership m38-P w r w2)))
                                                     (_3 (dk-have! (list 'IN w2 m38-C) (lambda () (subst (list '= m38-C (list 'PTS m38-P))) (mr-close-open!))))
                                                     (x2 (list 'NTH 1 w2)) (z2 (list 'NTH 2 w2))
                                                     (dw (list (list 'DIST m38-P) w w2))
                                                     (dx (list '(DIST s) x x2)) (dz (list '(DIST BAIRE-MS) z z2)))
                                                (m38-wparts! w2)
                                                (dk-cite! 'product2-dist 's 'BAIRE-MS w w2)
                                                (dk-cite! 'metric-dist-real 's x x2)
                                                (dk-cite! 'metric-dist-real 'BAIRE-MS z z2)
                                                (dk-cite! 'rr-le-max-left dx dz)
                                                (dk-cite! 'rr-le-max-right dx dz)
                                                (dk-cite! 'rr-max-closed dx dz)
                                                (let* ((lt0 (m38-ball-lt! m38-P w w2 r))
                                                       (lt1 (dk-rewrite-h! lt0 dw (list 'max dx dz))))
                                                  (dk-have! (list '< dx r) (lambda () (dk-ineq! (list '<= dx (list 'max dx dz)) lt1 (list 'IN dx 'RR) (list 'IN (list 'max dx dz) 'RR) (list 'IN r 'RR))))
                                                  (dk-have! (list '< dz dl) (lambda () (dk-ineq! (list '<= dz (list 'max dx dz)) lt1 (list '<= r dl) (list 'IN dz 'RR) (list 'IN (list 'max dx dz) 'RR) (list 'IN r 'RR) (list 'IN dl 'RR)))))
                                                (m38-close-ball! w w2 x x2 z z2 n r r1 dl dx dz cs pz)))))))))))))))))
               (mr-iff-back! iff2)
               (mr-close-open!))))))))
  (mr-iff-back! iff))
(mr-close-open!)
