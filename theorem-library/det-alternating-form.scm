(define (daf-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))

(define (daf-in-iv! x a b terms prems)
  (dk-have! (list 'IN x (list 'INTERVAL a b)) (lambda ()
      (dk-have! (list '<= a x) (lambda () (apply dk-nn! prems)))
      (dk-have! (list '<= x b) (lambda () (apply dk-nn! prems)))
      (fact 'interval-mem-intro a b x)
      (ass))))

(define (daf-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))

;; (daf-chain! retired 2026-09-25: the kit's dk-chain!)

(define (daf-find-decided-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)
              (or (dk-asm? (cadr e)) (dk-asm? (list 'NOT (cadr e)))))
         (cons (dk-asm? (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((daf-find-decided-if (car l)))
                    (#t (loop (cdr l))))))))
(define (daf-if-auto!)
  (let loop ()
    (let ((hit (daf-find-decided-if (dk-goal))))
      (if hit (begin (dk-if-branch! (car hit) (cdr hit) #f (lambda () #t)) (loop))))))

(define (daf-absurd! prems)
  (dk-have! '(<= 1 0) (lambda () (apply dk-nn! prems)))
  (dk-focus-having! '(<= 1 0))
  (have! '(NOT (<= 1 0)) (lambda () (arith)))
  (dk-focus-having! '(NOT (<= 1 0)))
  (pbc)
  (ai '(NOT (<= 1 0))))

;; (daf-pred! P N): with (IN P (INTERVAL 1 (succ N))), (IN N NN), (NOT (= P 1)):
;; land (IN Q (INTERVAL 1 N)) and (= P (succ Q)) for a fresh Q; return Q.
(define (daf-pred! p n)
  (daf-iv! p 1 (list 'succ n))
  (dk-have! (list 'NOT (list '= p 0)) (lambda () (apply dk-nn! (list (list '<= 1 p)))))
  (let ((q (dk-skolem! (dk-fact! 'nn-nonzero-is-succ p))))
    (let ((peq (list '= p (list 'succ q))))
      (dk-have! (list 'NOT (list '= q 0)) (lambda ()
          (di)
          (have! (list '= p 1)
            (lambda () (apply dk-nn! (list peq (list '= q 0)))))
          (ai (list 'NOT (list '= p 1)))))
      (dk-one-le! q)
      (daf-in-iv! q 1 n (list q p n (list 'succ q) (list 'succ n))
                  (list peq (list '<= p (list 'succ n)) (list '<= 1 q)))
      q)))

;; (daf-neq! A B TERMS PREMS): prove (NOT (= A B)) from NN facts: assume A = B,
;; derive the equation CONTRA (whose negation is in context) by ineq, NOT-elim.
(define (daf-neq-via! a b contra terms prems)
  (dk-have! (list 'NOT (list '= a b)) (lambda ()
      (di)
      (have! contra (lambda () (apply dk-nn! (cons (list '= a b) prems))))
      (ai (list 'NOT contra)))))

(define (daf-ctx f)
  (or (dk-ctx-form f) (error "daf-ctx: not in context" (expression->string f))))

(define (daf-tsubst e alist)
  (cond ((assq e alist) => cdr)
        ((pair? e) (map (lambda (x) (daf-tsubst x alist)) e))
        (#t e)))

(define daf-ag   '(RING-ADDITIVE-AG R))
(define daf-neg1 '((NEG R) (ONE R)))

;;; =====================================================================
;;; The property, as formula builders (NOT a def-predicate).
;;; =====================================================================
(define (daf-mat n) (list 'MAT n n '(CARR R)))
(define (daf-iv n) (list 'INTERVAL 1 n))
(define (daf-rowhyp X Y p n)        ; rows of X and Y agree off row p
  (list 'FORALL 'dri_ (list 'IMPLIES (list 'IN 'dri_ (daf-iv n))
    (list 'IMPLIES (list 'NOT (list '= 'dri_ p))
      (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (daf-iv n))
        (list '= (list 'ENTRY X 'dri_ 'drk_) (list 'ENTRY Y 'dri_ 'drk_))))))))
(define (daf-combhyp C A B p sc n)  ; row p of C is sc * (row p of A) + row p of B
  (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (daf-iv n))
    (list '= (list 'ENTRY C p 'drk_)
             (list '(ADD R) (list '(MUL R) sc (list 'ENTRY A p 'drk_)) (list 'ENTRY B p 'drk_))))))
(define (daf-eqrows X p q n)        ; rows p and q of X are equal
  (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (daf-iv n))
    (list '= (list 'ENTRY X p 'drk_) (list 'ENTRY X q 'drk_)))))
(define (daf-fun n D) (list 'IN D (list 'FUN (daf-mat n) '(CARR R))))
(define (daf-lin n D)
  (forall-guarded '(dfa_ dfb_ dfc_ dfp_ dfs_)
    (list (list 'IN 'dfa_ (daf-mat n)) (list 'IN 'dfb_ (daf-mat n)) (list 'IN 'dfc_ (daf-mat n))
          (list 'IN 'dfp_ (daf-iv n)) '(IN dfs_ (CARR R))
          (daf-rowhyp 'dfb_ 'dfa_ 'dfp_ n) (daf-rowhyp 'dfc_ 'dfa_ 'dfp_ n)
          (daf-combhyp 'dfc_ 'dfa_ 'dfb_ 'dfp_ 'dfs_ n))
    (list '= (list D 'dfc_)
             (list '(ADD R) (list '(MUL R) 'dfs_ (list D 'dfa_)) (list D 'dfb_)))))
(define (daf-alt n D)
  (forall-guarded '(dfa_ dfp_ dfq_)
    (list (list 'IN 'dfa_ (daf-mat n)) (list 'IN 'dfp_ (daf-iv n)) (list 'IN 'dfq_ (daf-iv n))
          '(NOT (= dfp_ dfq_)) (daf-eqrows 'dfa_ 'dfp_ 'dfq_ n))
    (list '= (list D 'dfa_) '(ZERO R))))
;; the whole hypothesis block, for a D alternating n-linear over R
(define (daf-form-hyps n D)
  (list '(IS-COMMUTATIVE-RING R) (daf-fun n D) (daf-lin n D) (daf-alt n D)))

;;; lambda functions
(define (daf-DL n)   (list 'VNB-LAMBDA 'ddl_ (daf-mat n) (list 'DET 'R n 'ddl_)))
(define (daf-DQ n D Q) (list 'VNB-LAMBDA 'dql_ (daf-mat n) (list D (list 'MATMUL 'R 'dql_ Q))))
(define (daf-DQdet n Q) (list 'VNB-LAMBDA 'dql_ (daf-mat n) (list 'DET 'R n (list 'MATMUL 'R 'dql_ Q))))
(define (daf-DB n D) (list 'VNB-LAMBDA 'dbl_ (daf-mat n)
                       (list D (list 'BORDER 'R '(ONE R) 'dbl_ n n))))

;;; =====================================================================
;;; (1) ring identities (crs, cited so the matrix terms stay atoms)
;;; =====================================================================
(define (daf-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
;; (s a + b) q = s (a q) + b q
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(dfs_ dfx_ dfy_ dfz_) (daf-carr-guards '(dfs_ dfx_ dfy_ dfz_))
      '(= ((MUL R) ((ADD R) ((MUL R) dfs_ dfx_) dfy_) dfz_)
          ((ADD R) ((MUL R) dfs_ ((MUL R) dfx_ dfz_)) ((MUL R) dfy_ dfz_))))))))
(dk-peel!)
(crs)
(daf-done! 'daf-ring-rdist)
(topic! 'daf-ring-rdist 'plumbing)

;; x = s 0 + y  =>  y = x
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(dfs_ dfx_ dfy_)
      (append (daf-carr-guards '(dfs_ dfx_ dfy_))
              (list '(= dfx_ ((ADD R) ((MUL R) dfs_ (ZERO R)) dfy_))))
      '(= dfy_ dfx_))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-zero-in 'R)
(have! '(= dfx_ dfy_)
  (lambda ()
    (subst '(= dfx_ ((ADD R) ((MUL R) dfs_ (ZERO R)) dfy_)))
    (crs)))
(subst '(= dfy_ dfx_))
(rfl)
(daf-done! 'daf-ring-cancel0)
(topic! 'daf-ring-cancel0 'plumbing)

;;; =====================================================================
;;; (2) the determinant is an alternating n-linear function
;;; =====================================================================
;; land (IN LAM (FUN DOM COD)): lam-t, peel the point v, beta, (THUNK v).
(define (daf-fun! lam dom cod thunk)
  (dk-have! (list 'IN lam (list 'FUN dom cod)) (lambda ()
      (if (and (pair? dom) (eq? (car dom) 'MAT))
          (begin (fact 'ring-carr-in-set 'R) (fact 'mat-is-set '(CARR R) (cadr dom) (caddr dom))))
      (dk-lam-t!)
      (let ((v (dk-di-var!)))
        (daf-beta!)
        (thunk v)))))

(sp (make-wff
  (forall-guarded '(R n) '((IS-COMMUTATIVE-RING R) (IN n NN))
    (daf-fun 'n (daf-DL 'n)))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(daf-fun! (daf-DL 'n) (daf-mat 'n) '(CARR R)
  (lambda (v) (fact 'det-in-carrier 'R 'n v) (ass)))
(daf-done! 'daf-det-fun)
(topic! 'daf-det-fun 'algebra)

;; the (IN x (INTERVAL 1 N)) hypotheses landed by a peel, in order
(define (daf-iv-vars landed N)
  (reverse (map cadr (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (symbol? (cadr f))
                                     (equal? (caddr f) (daf-iv N))))
                    landed))))

(sp (make-wff
  (forall-guarded '(R n) '((IS-COMMUTATIVE-RING R) (IN n NN))
    (daf-lin 'n (daf-DL 'n)))))
(define daf-dl-hyps (dk-peel!))
(fact 'commutative-ring-is-ring 'R)
(dk-lam-b!)
(let* ((g (dk-goal))
       (c (cadddr (cadr g)))
       (s (cadr (cadr (caddr g))))
       (a (cadddr (caddr (cadr (caddr g)))))
       (b (cadddr (caddr (caddr g))))
       (p (car (daf-iv-vars daf-dl-hyps 'n))))
  (fact 'det-row-linear 'R 'n a b c p s)
  (ass))
(daf-done! 'daf-det-lin)
(topic! 'daf-det-lin 'algebra)

(sp (make-wff
  (forall-guarded '(R n) '((IS-COMMUTATIVE-RING R) (IN n NN))
    (daf-alt 'n (daf-DL 'n)))))
(define daf-da-hyps (dk-peel!))
(dk-lam-b!)
(let* ((a (cadddr (cadr (dk-goal))))
       (pq (daf-iv-vars daf-da-hyps 'n)))
  (dk-chain! (dk-fact! 'det-alternating-rows 'R 'n a (car pq) (cadr pq)) (lambda (ante) (lambda () (ass))))
  (ass))
(daf-done! 'daf-det-alt)
(topic! 'daf-det-alt 'algebra)

;;; =====================================================================
;;; (3) right multiplication: rows of X Q are linear in the rows of X
;;; =====================================================================
;; the typing guard of matmul-type at three equal sizes N
(define (daf-mm-guard! N)
  (dk-have! (list 'IMPLIES (list '= N 0) (list 'OR (list '= N 0) (list '= N 0))) (lambda () (prop))))
(define (daf-mm-type! X Q N)
  (daf-mm-guard! N)
  (fact 'matmul-type 'R N N N X Q))
;; rewrite ENTRY(MATMUL R X Q, i, k) in the goal by matmul-entry; return the summand lambda
(define (daf-mm-entry! X Q i k N)
  (let ((e (dk-fact! 'matmul-entry 'R N N N X Q i k)))
    (subst e)
    (caddr (caddr e))))
(define (daf-type-entry! e N)          ; e = (ENTRY M i k), M N-square
  (fact 'entry-in-carrier N N '(CARR R) (cadr e) (caddr e) (cadddr e)))
(define (daf-mm-setup! i)
  (fact 'commutative-ring-is-ring 'R)
  (daf-iv! i 1 'n)
  (dk-have! '(<= 1 n) (lambda () (apply dk-nn! (list (list '<= 1 i) (list '<= i 'n)))))
  (fact 'ring-additive-ag-is-abelian-group 'R)
  (fact 'ras-carr 'R)
  (fact 'interval-in-set 1 'n)
  (fact 'interval-card-in-nn 1 'n))
(define (daf-type-prod! a b)
  (daf-type-entry! a 'n) (daf-type-entry! b 'n)
  (fact 'ring-carrier-closed-mul 'R a b))

;; equal rows give equal rows of the product
(sp (make-wff
  (forall-guarded '(R n X Y Q dfi_ dfj_ dfk_)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) (list 'IN 'X (daf-mat 'n)) (list 'IN 'Y (daf-mat 'n))
          (list 'IN 'Q (daf-mat 'n)) (list 'IN 'dfi_ (daf-iv 'n)) (list 'IN 'dfj_ (daf-iv 'n))
          (list 'IN 'dfk_ (daf-iv 'n))
          (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (daf-iv 'n))
                                     '(= (ENTRY X dfi_ drk_) (ENTRY Y dfj_ drk_)))))
    '(= (ENTRY (MATMUL R X Q) dfi_ dfk_) (ENTRY (MATMUL R Y Q) dfj_ dfk_)))))
(define daf-mre-hyps (dk-peel!))
(define daf-mre-row (find-first (dk-head? 'FORALL) daf-mre-hyps))
(daf-mm-setup! 'dfi_)
(let* ((LX (daf-mm-entry! 'X 'Q 'dfi_ 'dfk_ 'n))
       (LY (daf-mm-entry! 'Y 'Q 'dfj_ 'dfk_ 'n)))
  (dk-chain! (dk-fact! 'finsum-congruence daf-ag (daf-iv 'n) LX LY) (lambda (ante)
      (let ((body (caddr (caddr ante))))
        (if (eq? (car body) '=)
            (lambda ()
              (let ((v (dk-di-var!)))
                (daf-beta!)
                (dk-apply! daf-mre-row v)
                (subst (list '= (list 'ENTRY 'X 'dfi_ v) (list 'ENTRY 'Y 'dfj_ v)))
                (daf-type-prod! (list 'ENTRY 'Y 'dfj_ v) (list 'ENTRY 'Q v 'dfk_))
                (rfl)))
            (lambda ()
              (let ((v (dk-di-var!)))
                (daf-beta!)
                (daf-type-prod! (list 'ENTRY 'X 'dfi_ v) (list 'ENTRY 'Q v 'dfk_))
                (subst (list '= (list 'CARR daf-ag) '(CARR R)))
                (ass)))))))
  (ass))
(daf-done! 'daf-mm-row-eq)
(topic! 'daf-mm-row-eq 'algebra)

;; a row combination passes to the product
(sp (make-wff
  (forall-guarded '(R n A B C Q dfp_ dfs_ dfk_)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) (list 'IN 'A (daf-mat 'n)) (list 'IN 'B (daf-mat 'n))
          (list 'IN 'C (daf-mat 'n)) (list 'IN 'Q (daf-mat 'n)) (list 'IN 'dfp_ (daf-iv 'n))
          '(IN dfs_ (CARR R)) (list 'IN 'dfk_ (daf-iv 'n))
          (daf-combhyp 'C 'A 'B 'dfp_ 'dfs_ 'n))
    '(= (ENTRY (MATMUL R C Q) dfp_ dfk_)
        ((ADD R) ((MUL R) dfs_ (ENTRY (MATMUL R A Q) dfp_ dfk_)) (ENTRY (MATMUL R B Q) dfp_ dfk_))))))
(dk-peel!)
(define daf-mrl-comb (daf-ctx (daf-combhyp 'C 'A 'B 'dfp_ 'dfs_ 'n)))
(daf-mm-setup! 'dfp_)
(let* ((LC (daf-mm-entry! 'C 'Q 'dfp_ 'dfk_ 'n))
       (LA (daf-mm-entry! 'A 'Q 'dfp_ 'dfk_ 'n))
       (LB (daf-mm-entry! 'B 'Q 'dfp_ 'dfk_ 'n)))
  (dk-chain! (dk-fact! 'dtr-finsum-lin 'R (daf-iv 'n) 'dfs_ LA LB LC) (lambda (ante)
      (let ((body (caddr (caddr ante))))
        (if (eq? (car body) 'IN)
            (let ((X (if (equal? (car (cadr body)) LA) 'A 'B)))
              (lambda ()
                (let ((v (dk-di-var!)))
                  (daf-beta!)
                  (daf-type-prod! (list 'ENTRY X 'dfp_ v) (list 'ENTRY 'Q v 'dfk_))
                  (ass))))
            (lambda ()
              (let ((v (dk-di-var!)))
                (daf-beta!)
                (dk-apply! daf-mrl-comb v)
                (subst (list '= (list 'ENTRY 'C 'dfp_ v)
                             (list '(ADD R) (list '(MUL R) 'dfs_ (list 'ENTRY 'A 'dfp_ v))
                                   (list 'ENTRY 'B 'dfp_ v))))
                (daf-type-entry! (list 'ENTRY 'A 'dfp_ v) 'n)
                (daf-type-entry! (list 'ENTRY 'B 'dfp_ v) 'n)
                (daf-type-entry! (list 'ENTRY 'Q v 'dfk_) 'n)
                (fact 'daf-ring-rdist 'R 'dfs_ (list 'ENTRY 'A 'dfp_ v) (list 'ENTRY 'B 'dfp_ v)
                      (list 'ENTRY 'Q v 'dfk_))
                (ass)))))))
  (ass))
(daf-done! 'daf-mm-row-lin)
(topic! 'daf-mm-row-lin 'algebra)

;;; ---- X |-> D(X Q) and X |-> det(X Q) are alternating n-linear
;; after the peel and beta, the goal of a linearity proof is
;;   (= (F (MATMUL R c Q)) ((ADD R) ((MUL R) s (F (MATMUL R a Q))) (F (MATMUL R b Q))))
;; with F = D or DET R n; return (a b c s).
(define (daf-lin-parts g)
  (let* ((lhs (cadr g)) (rhs (caddr g)))
    (list (last (caddr (cadr rhs))) (last (caddr rhs)) (last lhs) (cadr (cadr rhs)))))

(define (daf-rm-lin-body! hyps start)
  (fact 'commutative-ring-is-ring 'R)
  (dk-lam-b!)
  (let* ((parts (daf-lin-parts (dk-goal)))
         (a (caddr (car parts))) (b (caddr (cadr parts))) (c (caddr (caddr parts)))
         (s (cadddr parts))
         (p (car (daf-iv-vars hyps 'n)))
         (mq (lambda (X) (list 'MATMUL 'R X 'Q))))
    (for-each (lambda (X) (daf-mm-type! X 'Q 'n)) (list a b c))
    (dk-chain! (start (mq a) (mq b) (mq c) p s) (lambda (ante)
        (if (eq? (cadr ante) 'dri_)
            (lambda ()
              (let* ((i (dk-di-var!))
                     (ne (dk-landed-1 (lambda () (di))))
                     (k (dk-di-var!))
                     (X (caddr (cadr (cadr (dk-goal))))))
                (dk-apply! (daf-ctx (daf-rowhyp X a p 'n)) i)
                (fact 'daf-mm-row-eq 'R 'n X a 'Q i i k)
                (ass)))
            (lambda ()
              (let ((k (dk-di-var!)))
                (fact 'daf-mm-row-lin 'R 'n a b c 'Q p s k)
                (ass))))))
    (ass)))

(define (daf-rm-alt-body! hyps start)
  (fact 'commutative-ring-is-ring 'R)
  (dk-lam-b!)
  (let* ((aq (last (cadr (dk-goal)))) (a (caddr aq))
         (pq (daf-iv-vars hyps 'n)) (p (car pq)) (q (cadr pq)))
    (daf-mm-type! a 'Q 'n)
    (dk-chain! (start aq p q) (lambda (ante)
        (lambda ()
          (let ((k (dk-di-var!)))
            (fact 'daf-mm-row-eq 'R 'n a a 'Q p q k)
            (ass)))))
    (ass)))

(sp (make-wff
  (forall-guarded '(R n D Q)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) (daf-fun 'n 'D) (list 'IN 'Q (daf-mat 'n)))
    (daf-fun 'n (daf-DQ 'n 'D 'Q)))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(daf-fun! (daf-DQ 'n 'D 'Q) (daf-mat 'n) '(CARR R)
  (lambda (v)
    (daf-mm-type! v 'Q 'n)
    (fact 'fun-apply-type-c 'D (daf-mat 'n) '(CARR R) (list 'MATMUL 'R v 'Q))
    (ass)))
(daf-done! 'daf-rm-fun)
(topic! 'daf-rm-fun 'algebra)

(sp (make-wff
  (forall-guarded '(R n D Q)
