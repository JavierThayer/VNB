;;; det-alternating-form.scm -- Hoffman-Kunze 5.3 Theorem 2 (batch 26-B, 2026-09-24):
;;; an ALTERNATING n-LINEAR function D on the n x n matrices over a commutative ring
;;; R satisfies  D(A) = det(A) D(I)  for every A.  Proven WITHOUT permutations.
;;;
;;; THE PROPERTY is not a definition: it is written by the formula builders
;;; daf-fun / daf-lin / daf-alt below, in the shape of det-row-linear and
;;; det-alternating-rows (theorem-library/det-rows.scm) with (D X) in place of
;;; DET(R, n, X).
;;;
;;; THE ROUTE (induction on n; no permutation signs):
;;;   * the determinant is such a function (daf-det-fun/-lin/-alt), and so is
;;;     X |-> D(X Q) for any Q (daf-rm-*; X |-> det(X Q) is daf-det-rm-*), and so is
;;;     M |-> D(BORDER(1, M)) at the size below (daf-bd-*);
;;;   * a D-matrix with a zero row is 0 (daf-zero-row); interchanging two rows
;;;     negates D (daf-swap), hence D(F[k,l]) = - D(I) (daf-elem-f);
;;;   * CLEARING: if row 1 of Y is e_1, subtracting multiples of row 1 from the
;;;     other rows (column 1 cleared) does not change D (daf-clear), and the
;;;     cleared matrix is BORDER(1, M) for M its lower-right block (daf-bordered);
;;;   * the step: for Y with row 1 = e_1, D(Y) = det(M) D(I) by the induction
;;;     hypothesis at M |-> D(BORDER(1, M)) (daf-cl); for X with row 1 = e_j,
;;;     j /= 1, Y = X F[1,j] has row 1 = e_1 and X = Y F[1,j], so D(X) = det(M) D(F)
;;;     and det(X) = det(M) det(F) with the SAME M, and D(F) = - D(I), det F = -1
;;;     (daf-basis); a general A is reached by linearity in row 1, one entry at a
;;;     time (daf-psum: the partial rows (a_11, ..., a_1m, 0, ..., 0)).
;;;
;;; Helper prefix: daf-.  Binders the driver builds: df*_ (statement binders),
;;; dri_ / drk_ (the row clauses, as in det-rows.scm), dav_ / daw_ (matrix
;;; tabulations), ddl_ / dql_ / dbl_ (the lambda functions).

;;; =====================================================================
;;; The file's kit (copied from det-rows.scm, where it is file-local).
;;; =====================================================================
(define (daf-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** det-alternating-form: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

;; (daf-if-branch! retired 2026-09-25: the kit's dk-if-branch!)

