(define (daf-zrow A k n)
  (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (daf-iv n))
    (list '= (list 'ENTRY A k 'drk_) '(ZERO R)))))
(sp (make-wff
  (forall-guarded '(R n D A dfk_)
    (list '(IS-COMMUTATIVE-RING R) '(IN n NN) (daf-fun 'n 'D) (daf-lin 'n 'D)
          (list 'IN 'A (daf-mat 'n)) (list 'IN 'dfk_ (daf-iv 'n)) (daf-zrow 'A 'dfk_ 'n))
    '(= (D A) (ZERO R)))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'ring-one-in 'R)
(fact 'ring-zero-in 'R)
(fact 'ring-neg-in-carr 'R '(ONE R))
(dk-chain! (inst*! (daf-ctx (daf-lin 'n 'D)) 'A 'A 'A 'dfk_ daf-neg1) (lambda (ante)
    (if (eq? (cadr ante) 'dri_)
        (lambda ()
          (dk-peel!)
          (let ((g (dk-goal))) (daf-type-entry! (cadr g) 'n) (rfl)))
        (lambda ()
          (let ((c (dk-di-var!)))
            (dk-apply! (daf-ctx (daf-zrow 'A 'dfk_ 'n)) c)
