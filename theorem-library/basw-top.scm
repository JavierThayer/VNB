;;; file cited; no file cites this one yet.

(define (bst-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (bst-dump! tag)
  (display "\n*** DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (if (< (string-length (expression->string a)) 200) (begin (display "      asm: ") (display (expression->string a)) (newline))))
                        (dk-asms-of l)))
            (dk-open-leaves)))
(define (bst-fact! . args)            ; dk-cite!, then detach conjunctive antecedents from context
  (let loop ((r (apply dk-cite! args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-head-is? (cadr r) 'AND))
        (begin (dk-have! (cadr r) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
               (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (bst-split-cite! . args)      ; cite, split the conjunction that landed
  (let ((r (apply dk-cite! args)))
    (if (not (and (dk-head-is? r 'AND) (dk-asm? (cadr r)))) (dk-split-all! (list r)))
    r))
(define (bst-real-abs! z) (dk-real! z) (if (not (dk-asm? (list 'IN (list 'abs z) 'RR))) (dk-cite! 'rr-abs-closed z)))
(define (bst-empty-absurd! z)        ; (IN z EMPTY-SET) in context: close the goal
  (let ((n (dk-cite! 'empty-set-has-no-members z)))
    (if (dk-only! n (list 'IN z 'EMPTY-SET)) (prop))))
(define (bst-other-case! z a b)      ; (OR (IN z a) (IN z b)), (NOT (IN z a)) in context: land (IN z b)
  (if (not (dk-asm? (list 'IN z b))) (dk-have! (list 'IN z b) (lambda () (if (dk-only! (list 'OR (list 'IN z a) (list 'IN z b)) (list 'NOT (list 'IN z a))) (prop))))))
(define (bst-sub-mem! a b x)         ; (SUBSET a b), (IN x a) in context: land (IN x b) without instantiating at b
  (if (not (dk-asm? (list 'IN x b))) (dk-cite! 'subset-mem-fwd a b x)))
(define (bst-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** basw-top: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "basw-top: unfinished" name))))
;; land the right side of an IFF instance whose left side is in context, split
(define (bst-rhs! iff)
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
;; land the left side of an IFF instance from its right side, built by THUNK
(define (bst-lhs! iff thunk)
  (dk-have! (caddr iff) thunk)
  (dk-have! (cadr iff) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(define (bst-le-ne-lt! a b)          ; goal a < b, with a <= b, not(a = b), a, b in RR in context
  (let ((imp (dk-cite! 'rr-le-ne-lt a b)))
    (dk-have! (cadr imp) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
    (detach! imp)
    (bst-ass!)))
(define (bst-lt-ne! a b)             ; goal not(a = b), with a < b, b in RR in context
  (di)
  (dk-rewrite-h! (list '< a b) a b)
  (let ((n (dk-cite! 'rr-lt-irrefl b)))
    (ai n)))
;; dk-ineq! after a keep that may itself ground the leaf (the kept sequent already proven elsewhere)
(define (bst-ineq! . prem) (dk-close-if! (lambda () (apply dk-only! prem)) (lambda () (apply dk-ineq! prem))))
(define (bst-close-ctx!) (dk-conj-close! (lambda () (bst-ass!))))

;;; ---- continuity into METRIC-TOP(md), read pointwise -----------------------------------------
(define bst-local
  (lambda (f)
    (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t))
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
        (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u)
          (list 'FORALL 'q (list 'IMPLIES '(IN q u) (list '< (list '(DIST md) (list f 'p) (list f 'q)) 'eps))))))))))))

(sp (make-wff (list 'FORALL 't (list 'FORALL 'md (list 'FORALL 'f
  (list 'IMPLIES '(IS-METRIC-SPACE md) (list 'IMPLIES '(IS-HOM-TOP-SPACE t (METRIC-TOP md) f) (bst-local 'f))))))))
(dk-peel!)
(bst-rhs! (dk-cite! 'is-hom-top-space-def 't '(METRIC-TOP md) 'f))
(define bst-pre (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'PREIMAGE))) "the preimage clause"))
(dk-cite! 'fun-apply-type-c 'f '(PTS t) '(PTS (METRIC-TOP md)) 'p)
(dk-cite! 'metric-top-pts 'md)
(dk-rewrite-h! '(IN (f p) (PTS (METRIC-TOP md))) '(PTS (METRIC-TOP md)) '(PTS md))
(dk-pos-parts! 'eps)
(define bst-B '(BALL md (f p) eps))
(dk-cite! 'ball-is-open 'md '(f p) 'eps)
(dk-cite! 'ball-center-in 'md '(f p) 'eps)
(bst-lhs! (dk-cite! 'metric-top-opens-iff 'md bst-B) (lambda () (bst-ass!)))
(dk-apply! bst-pre bst-B)
(ew (list 'PREIMAGE 't 'f bst-B))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((dk-head-is? g 'IN)
             (bst-lhs! (dk-cite! 'preimage-membership 't 'f bst-B 'p) (lambda () (bst-close-ctx!))))
            (#t
             (let ((q (dk-di-var!)))
               (bst-rhs! (dk-cite! 'preimage-membership 't 'f bst-B q))
               (bst-rhs! (dk-cite! 'ball-membership 'md '(f p) 'eps (list 'f q)))
               (dk-cite! 'metric-dist-real 'md '(f p) (list 'f q))
               (bst-le-ne-lt! (list '(DIST md) '(f p) (list 'f q)) 'eps)))))))
(bst-qed! 'bsw-cont-local)

(sp (make-wff (list 'FORALL 't (list 'FORALL 'md (list 'FORALL 'f
  (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES '(IS-METRIC-SPACE md) (list 'IMPLIES '(IN f (FUN (PTS t) (PTS md)))
    (list 'IMPLIES (bst-local 'f) '(IS-HOM-TOP-SPACE t (METRIC-TOP md) f))))))))))
(dk-peel!)
(define bst-wloc #f)
(define bst-loc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'p))) "local continuity"))
(dk-cite! 'metric-top-is-top-space 'md)
(dk-cite! 'metric-top-pts 'md)
(let ((iff (dk-cite! 'is-hom-top-space-def 't '(METRIC-TOP md) 'f)))
  (bst-lhs! iff
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g 'IN)          ; f in FUN(PTS t, PTS(METRIC-TOP md))
                   (subst '(= (PTS (METRIC-TOP md)) (PTS md))) (bst-ass!))
                  (#t
                   (let* ((w (dk-di-var!))
                          (pre (list 'PREIMAGE 't 'f w)))
                     (bst-rhs! (dk-cite! 'metric-top-opens-iff 'md w))
                     (bst-rhs! (dk-cite! 'is-open 'md w))
                     (set! bst-wloc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL))) "openness of w"))
                     (dk-have! (list 'SUBSET pre '(PTS t))
                       (lambda () (mac 'subset-def)
                         (let ((a (dk-di-var!)))
                           (dk-peel!)
                           (bst-rhs! (dk-cite! 'preimage-membership 't 'f w a)) (bst-ass!))))
                     (dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a pre)
                                 (list 'FORSOME 'W2 (list 'AND '(IN W2 (OPENS t)) (list 'AND '(IN a W2) (list 'SUBSET 'W2 pre))))))
                       (lambda ()
                         (let ((a (dk-di-var!)))
                           (bst-rhs! (dk-cite! 'preimage-membership 't 'f w a))
                           (let* ((r (dk-skolem! (dk-apply! bst-wloc (list 'f a))))
                                  (u (dk-skolem! (dk-apply! bst-loc a r)))
                                  (ucl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
                             (ew u)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-head-is? (dk-goal) 'SUBSET)
                                     (begin (mac 'subset-def)
                                       (let ((q (dk-di-var!)))
                                         (dk-peel!)
                                         (dk-cite! 'top-open-subset 't u)
                                         (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                                         (dk-apply! ucl q)
                                         (dk-cite! 'fun-apply-type-c 'f '(PTS t) '(PTS md) a)
                                         (dk-cite! 'fun-apply-type-c 'f '(PTS t) '(PTS md) q)
                                         (dk-cite! 'metric-dist-real 'md (list 'f a) (list 'f q))
                                         (dk-cite! 'rr-pos-rr-in-rr r)
                                         (bst-lhs! (dk-cite! 'ball-membership 'md (list 'f a) r (list 'f q))
                                           (lambda () (dk-conj-close! (lambda () (let ((dd (list '(DIST md) (list 'f a) (list 'f q)))) (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) 'NOT) (bst-lt-ne! dd r)) (#t (dk-cite! 'rr-lt-implies-le dd r) (bst-ass!))))))))
                                         (dk-cite! 'subset-mem-fwd (list 'BALL 'md (list 'f a) r) w (list 'f q))
                                         (bst-lhs! (dk-cite! 'preimage-membership 't 'f w q) (lambda () (bst-close-ctx!)))
                                         (bst-ass!)))
                                     (bst-ass!))))))))
                     (dk-cite! 'top-open-of-local 't pre)
                     (bst-ass!))))))))))
(bst-ass!)
(bst-qed! 'bsw-local-cont)

;;; ---- COMPACTNESS INDUCTION ---------------------------------------------------------------------
;;; t compact; pp a class of sets containing EMPTY-SET and closed under binary union; every point
;;; has an open neighbourhood in pp.  Then PTS(t) is in pp.  (A finite subcover of the cover by the
;;; opens in pp, and finite-set induction over its subsets.)  This one lemma is the finite part of
;;; every compactness argument of the file: boundedness, and both lattice steps of Stone-Weierstrass.
(define bst-cc '(SEP bcu_ (OPENS t) (IN bcu_ pp)))
(define (bst-bu fam) (list 'BIG-UNION 'mfw_ fam 'mfw_))
(define bst-cls (list 'SEP 'bcs_ 'SET (list 'IMPLIES (list 'SUBSET 'bcs_ bst-cc) (list 'IN (bst-bu 'bcs_) 'pp))))
(define (bst-bu-skolem! mem fam)
  (let* ((new (dk-landed (lambda () (bu-me mem))))
         (f   (or (find-first (lambda (h) (and (pair? h) (eq? (car h) 'IN) (equal? (caddr h) fam))) new)
                  (error "bst-bu-skolem!: no landed membership in" fam))))
    (cadr f)))
(define (bst-sep-parts! e sp0) (dk-project! (list 'IN e (caddr sp0)) (lambda () (sep-me (list 'IN e sp0)))))
(define bst-cmp-stmt
  '(FORALL t (FORALL pp (IMPLIES (IS-COMPACT-T t) (IMPLIES (IN EMPTY-SET pp)
     (IMPLIES (FORALL ka (IMPLIES (IN ka pp) (FORALL kb (IMPLIES (IN kb pp) (IN (UNION ka kb) pp)))))
       (IMPLIES (FORALL p (IMPLIES (IN p (PTS t)) (FORSOME u (AND (IN u (OPENS t)) (AND (IN p u) (IN u pp))))))
         (IN (PTS t) pp))))))))
(sp (make-wff bst-cmp-stmt))
(dk-peel!)
(define bst-unc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ka))) "union closure"))
(define bst-lc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'p))) "the local clause"))
(bst-rhs! (dk-cite! 'is-compact-t 't))
(define bst-K (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CARD))) "the compactness clause"))
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'membership-implies-sethood '(OPENS t) '(POWER (POWER (PTS t))))
(dk-have! (list 'IN bst-cc 'SET) (lambda () (sep-set) (bst-ass!)))
(dk-have! (list 'FORALL 'U (list 'IMPLIES (list 'IN 'U bst-cc) '(IN U (OPENS t))))
  (lambda () (let ((w (dk-di-var!))) (sep-me (list 'IN w bst-cc)) (dk-split-all!) (bst-ass!))))
(let ((bu (bst-bu bst-cc)))
  (dk-have! (list 'FORALL 'zz_ (list 'IFF (list 'IN 'zz_ bu) '(IN zz_ (PTS t))))
    (lambda ()
      (let ((z (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (dk-contains? (caddr g) 'PTS))
          (lambda ()
            (dk-peel!)
            (let ((w (bst-bu-skolem! (list 'IN z bu) bst-cc)))
              (bst-sep-parts! w bst-cc)
              (dk-cite! 'top-open-subset 't w)
              (dk-cite! 'subset-mem-fwd w '(PTS t) z)
              (bst-ass!)))
          (lambda ()
            (dk-peel!)
            (let ((u (dk-skolem! (dk-apply! bst-lc z))))
              (for-each (lambda (k)
                          (dk-focus! k)
                          (if (equal? (caddr (dk-goal)) bst-cc)
                              (in-sep! (lambda () (bst-ass!)))
                              (bst-ass!)))
                        (dk-opened (lambda () (bu-mi u))))))))))
  (dk-cite! 'class-extensionality bu '(PTS t))
  (dk-have! (list '== bu '(PTS t)) (lambda () (subst (list '= bu '(PTS t))) (qrfl))))
(define bst-fv (dk-skolem! (dk-apply! bst-K bst-cc)))
(dk-cite! 'subclass-of-set-is-set bst-fv bst-cc)
;; the induction over the finite subsets of the cover
(dk-have! (list 'IN 'EMPTY-SET bst-cls)
  (lambda ()
    (in-sep! (lambda () (dk-cite! 'empty-set-is-set) (bst-ass!))
             (lambda () (di) (dk-cite! 'big-union-of-empty-family) (subst (list '= (bst-bu 'EMPTY-SET) 'EMPTY-SET)) (bst-ass!)))))
(define bst-step
  (list 'FORALL 's_ (list 'IMPLIES (list 'AND '(IN s_ SET) (list 'AND '(IN (CARD s_) NN) (list 'IN 's_ bst-cls)))
    (list 'FORALL 'x_ (list 'IMPLIES '(AND (IN x_ SET) (NOT (IN x_ s_))) (list 'IN '(UNION s_ (PAIR x_ x_)) bst-cls))))))
(dk-have! bst-step
  (lambda ()
    (dk-peel!)
    (dk-split-all!)
    (let* ((g (dk-goal)) (s (cadr (cadr g))) (x (cadr (caddr (cadr g))))
           (px (list 'PAIR x x)) (un (list 'UNION s px)))
      (sep-me (list 'IN s bst-cls))
      (dk-split-all!)
      (bst-fact! 'pairing x x)
      (bst-fact! 'union-set-closure s px)
      (in-sep! (lambda () (bst-ass!))
        (lambda ()
          (di)                                  ; SUBSET un cc
          (dk-have! (list 'SUBSET s bst-cc)
            (lambda () (mac 'subset-def)
              (let ((z (dk-di-var!)))
                (bst-lhs! (dk-cite! 'union-membership s px z) (lambda () (oi-l) (bst-ass!)))
                (dk-cite! 'subset-mem-fwd un bst-cc z) (bst-ass!))))
          (dk-have! (list 'IN x un)
            (lambda ()
              (bst-lhs! (dk-cite! 'union-membership s px x)
                (lambda () (oi-r)
                  (dk-have! (list 'AND (list 'IN x 'SET) (list 'IN x 'SET)) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
                  (bst-lhs! (dk-cite! 'pairing-membership x x x) (lambda () (oi-l) (rfl))) (bst-ass!)))))
          (dk-cite! 'subset-mem-fwd un bst-cc x)
          (sep-me (list 'IN x bst-cc)) (dk-split-all!)
          (let ((imp (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) (list 'SUBSET s bst-cc)))) "the hypothesis on s")))
            (detach! imp))
          (dk-cite! 'big-union-of-union-family s px)
          (dk-cite! 'big-union-of-singleton-family x)
          (subst (list '= (bst-bu un) (list 'UNION (bst-bu s) (bst-bu px))))
          (subst (list '= (bst-bu px) x))
          (dk-apply! bst-unc (bst-bu s) x)
          (bst-ass!))))))
(dk-have! (list 'AND (list 'IN 'EMPTY-SET bst-cls) bst-step) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
(let ((ind (dk-cite! 'finite-set-induction bst-cls)))
  (dk-have! (list 'AND (list 'IN bst-fv 'SET) (list 'IN (list 'CARD bst-fv) 'NN)) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
  (dk-apply! ind bst-fv)
  (sep-me (list 'IN bst-fv bst-cls))
  (dk-split-all!)
  (let ((imp (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) (list 'SUBSET bst-fv bst-cc)))) "the subcover clause")))
    (detach! imp))
  (subst (list '= '(PTS t) (list 'BIG-UNION 'u bst-fv 'u)))
  (bst-ass!))
(bst-qed! 'bsw-compact-induction)

;;; ================================================================================================
;;; RCONT(t): the real continuous functions, read pointwise
;;; ================================================================================================
(define (bst-rloc f)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t))
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u)
        (list 'FORALL 'q (list 'IMPLIES '(IN q u) (list '< (list 'abs (list '- (list f 'p) (list f 'q))) 'eps)))))))))))
(define bst-rsep '(SEP rcf_ (FUN (PTS t) RR) (IS-HOM-TOP-SPACE t (METRIC-TOP RR-MS) rcf_)))
(sp (make-wff (list 'FORALL 't (list '== '(RCONT t) bst-rsep))))
(di) (mac 'RCONT) (qrfl)
(bst-qed! 'bsw-rcont-unfold)

;; f in RCONT(t) in context: land f in FUN(PTS t, RR) and the hom; the membership survives
(define (bst-ropen! f)
  (dk-cite! 'bsw-rcont-unfold 't)
  (let ((m (dk-rewrite-h! (list 'IN f '(RCONT t)) '(RCONT t) bst-rsep)))
    (sep-me m)
    (dk-split-all!)))

(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IN f (RCONT t))
   (AND (IN f (FUN (PTS t) RR)) (AND (IS-TOP-SPACE t) (IS-HOM-TOP-SPACE t (METRIC-TOP RR-MS) f))))))))
(dk-peel!)
(bst-ropen! 'f)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'metric-top-is-top-space 'RR-MS)
(bst-rhs! (dk-cite! 'is-hom-top-space-def 't '(METRIC-TOP RR-MS) 'f))
(dk-conj-close! (lambda () (bst-ass!)))
(bst-qed! 'bsw-rcont-parts)

(sp (make-wff (list 'FORALL 't (list 'FORALL 'f (list 'IMPLIES '(IN f (RCONT t)) (bst-rloc 'f))))))
(define bst-pe (dk-peel!))
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(dk-cite! 'rr-is-metric-space)
(define bst-dl (dk-cite! 'bsw-cont-local 't 'RR-MS 'f))
(let* ((pe bst-pe)
       (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
       (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe))))
       (u (dk-skolem! (dk-apply! bst-dl p e)))
       (ucl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
  (ew u)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((q (dk-di-var!)))
            (dk-cite! 'top-open-subset 't u)
            (dk-cite! 'subset-mem-fwd u '(PTS t) q)
            (dk-apply! ucl q)
            (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR p)
            (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR q)
            (dk-cite! 'rr-ms-dist (list 'f p) (list 'f q))
            (dk-rewrite-h! (list '< (list '(DIST RR-MS) (list 'f p) (list 'f q)) e)
                           (list '(DIST RR-MS) (list 'f p) (list 'f q)) (list 'abs (list '- (list 'f p) (list 'f q))))
            (bst-ass!))
          (bst-ass!)))))
(bst-qed! 'bsw-rcont-elim)

(sp (make-wff (list 'FORALL 't (list 'FORALL 'f (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES '(IN f (FUN (PTS t) RR))
   (list 'IMPLIES (bst-rloc 'f) '(IN f (RCONT t)))))))))
(dk-peel!)
(define bst-al (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'p))) "the abs-local clause"))
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'rr-ms@pts)
(dk-have! '(IN f (FUN (PTS t) (PTS RR-MS))) (lambda () (subst '(= (PTS RR-MS) RR)) (bst-ass!)))
(let ((imp (dk-cite! 'bsw-local-cont 't 'RR-MS 'f)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (dk-peel!))
             (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
             (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe))))
             (u (dk-skolem! (dk-apply! bst-al p e)))
             (ucl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'top-open-subset 't u)
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (dk-apply! ucl q)
                  (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR p)
                  (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR q)
                  (dk-cite! 'rr-ms-dist (list 'f p) (list 'f q))
                  (subst (list '= (list '(DIST RR-MS) (list 'f p) (list 'f q)) (list 'abs (list '- (list 'f p) (list 'f q)))))
                  (bst-ass!))
                (bst-ass!)))))))
  (detach! imp))
(dk-cite! 'bsw-rcont-unfold 't)
(subst (list '= '(RCONT t) bst-rsep))
(in-sep! (lambda () (bst-ass!)))
(bst-qed! 'bsw-rcont-intro)

;;; ---- the algebra of RCONT(t), stated POINTWISE: h in FUN(PTS t, RR) with h(z) = (an operation
;;; on the values of f, g) is in RCONT(t).  A lambda term is then one beta away from the
;;; hypothesis, and no composite lambda term ever has to be compared with another. -------------
(define (bst-abs-parts! x c)          ; (< (abs x) c) in context: land -c < x, x < c
  (dk-real! x) (dk-real! c)
  (bst-split-cite! 'rr-abs-lt-parts x c))
(define (bst-abs-lt-goal! x c . premises)   ; goal (< (abs x) c), the parts by ineq from PREMISES
  (dk-real! x) (dk-real! c)
  (let ((imp (dk-cite! 'rr-abs-lt-of-parts x c)))
    (dk-have! (list '< (list '- c) x) (lambda () (apply dk-ineq! (append premises (list (list 'IN x 'RR) (list 'IN c 'RR)))))) 
    (dk-have! (list '< x c) (lambda () (apply dk-ineq! (append premises (list (list 'IN x 'RR) (list 'IN c 'RR))))))
    (dk-apply! imp)
    (bst-ass!)))
(define (bst-top-inter! u v)          ; IS-TOP-SPACE t, u v open: land (IN (INTERSECTION u v) (OPENS t))
  (let ((cl? (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h '(OPENS t))))))
    (if (not (any-pred cl? (dk-asms)))
        (let ((iff (dk-cite! 'is-top-space 't)))
          (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
          (dk-split-all! (list (caddr iff)))))
    (dk-apply! (dk-pick cl? "the intersection clause") u v)))
(define (bst-inter-in! p u v)          ; p in u, p in v: land p in u ^ v
  (bst-lhs! (dk-cite! 'intersection-membership u v p) (lambda () (dk-conj-close! (lambda () (bst-ass!))))))
(define (bst-inter-out! q u v)         ; q in u ^ v: land q in u, q in v
  (bst-rhs! (dk-cite! 'intersection-membership u v q)))
(define (bst-ptw-stmt hyps eqn)       ; forall t f g h c. HYPS => h in FUN => forall z in PTS t. h(z) = EQN => h in RCONT t
  (let loop ((hs hyps))
    (if (null? hs)
        (list 'IMPLIES '(IN h (FUN (PTS t) RR))
          (list 'IMPLIES (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= '(h rz_) eqn)))
            '(IN h (RCONT t))))
        (list 'IMPLIES (car hs) (loop (cdr hs))))))
(define (bst-ptw-sp! vars hyps eqn)
  (sp (make-wff (let loop ((vs vars)) (if (null? vs) (bst-ptw-stmt hyps eqn) (list 'FORALL (car vs) (loop (cdr vs))))))))
;; the shared skeleton: peel, get IS-TOP-SPACE from F0 (a function in RCONT) or from context, cite
;; intro at h, prove its local antecedent by LOCAL! (called with p, e, the pointwise equation),
;; detach, close.
(define (bst-ptw-drive! top! local!)
  (dk-peel!)
  (top!)
  (let ((eqh (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_))) "the pointwise equation"))
        (imp (dk-cite! 'bsw-rcont-intro 't 'h)))
    (dk-have! (cadr imp)
      (lambda ()
        (let* ((pe (dk-peel!))
               (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
               (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe)))))
          (local! p e eqh))))
    (detach! imp)
    (bst-ass!)))
(define (bst-top-from! f) (lambda () (bst-split-cite! 'bsw-rcont-parts 't f)))
;; the point q of an open u: q in PTS t, and the values of h, FS at p and q typed and rewritten
(define (bst-at-pq! eqh p q fs)
  (let* ((ep (dk-apply! eqh p)) (eq (dk-apply! eqh q)))
    (for-each (lambda (f) (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR p) (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR q)) fs)
    (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'RR p) (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'RR q)
    (subst ep) (subst eq)))

;; constants
(bst-ptw-sp! '(t c h) '((IS-TOP-SPACE t) (IN c RR)) 'c)
(bst-ptw-drive! (lambda () #t)
  (lambda (p e eqh)
    (ew '(PTS t))
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((dk-head-is? g 'IN)
                 (bst-rhs! (dk-cite! 'is-top-space 't)) (bst-ass!))
                (#t (let ((q (dk-di-var!)))
                      (bst-at-pq! eqh p q '())
                      (dk-pos-parts! e)
                      (bst-abs-lt-goal! '(- c c) e (list '< 0 e)))))))))) 
(bst-qed! 'bsw-rcont-const)

;; the two-function local step: e halved, u1 for f and u2 for g at d, the intersection; BODY!
;; runs at q (in u1 ^ u2) with the two landed bounds (< (abs ..f..) d), (< (abs ..g..) d)
(define (bst-two-local! f g p e eqh close!)
  (bst-split-cite! 'bsw-rcont-parts 't f)
  (bst-split-cite! 'bsw-rcont-parts 't g)
  (dk-pos-parts! e)
  (let* ((d (dk-halve! e))
         (m0 )
         (u1 (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't f) p d)))
         (m1 )
         (c1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u1))) "the u1 clause"))
         (u2 (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't g) p d)))
         (c2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u2))) "the u2 clause"))
         (uu (list 'INTERSECTION u1 u2)))
    
    (bst-top-inter! u1 u2)
    
    (ew uu)
    (dk-conj-close!
      (lambda ()
        (let ((gl (dk-goal)))
          (cond ((dk-asm? gl) (ass))
                ((dk-head-is? gl 'IN) (bst-inter-in! p u1 u2) (bst-ass!))
                (#t (let ((q (dk-di-var!)))
                      (bst-inter-out! q u1 u2)
                      (dk-cite! 'top-open-subset 't u1)
                      (dk-cite! 'subset-mem-fwd u1 '(PTS t) q)
                      
                      (let* ((b1 (dk-apply! c1 q)) (b2 (dk-apply! c2 q)))
                        
                        (bst-at-pq! eqh p q (list f g))
                        
                        (close! q d b1 b2))))))))))
(bst-ptw-sp! '(t f g h) '((IN f (RCONT t)) (IN g (RCONT t))) '(+ (f rz_) (g rz_)))
(bst-ptw-drive! (bst-top-from! 'f)
  (lambda (p e eqh)
    (bst-two-local! 'f 'g p e eqh
      (lambda (q d b1 b2)
        (let ((x1 (cadr (cadr b1))) (x2 (cadr (cadr b2))))
          (bst-abs-parts! x1 d) (bst-abs-parts! x2 d)
          (bst-abs-lt-goal! (list '- (list '+ (list 'f p) (list 'g p)) (list '+ (list 'f q) (list 'g q))) e
            (list '< (list '- d) x1) (list '< x1 d) (list '< (list '- d) x2) (list '< x2 d) (list '= (list '+ d d) e)
            (list 'IN (list 'f p) 'RR) (list 'IN (list 'f q) 'RR) (list 'IN (list 'g p) 'RR) (list 'IN (list 'g q) 'RR) (list 'IN d 'RR)))))))
(bst-qed! 'bsw-rcont-add)

;; combinations f(z) a1 + g(z) a2 with |a1|, |a2| <= 1 (all the S-W lattice needs: 1/2 and -1)
(bst-ptw-sp! '(t f g a1 a2 h) '((IN f (RCONT t)) (IN g (RCONT t)) (IN a1 RR) (IN a2 RR) (<= (abs a1) 1) (<= (abs a2) 1))
  '(+ (* (f rz_) a1) (* (g rz_) a2)))
(bst-ptw-drive! (bst-top-from! 'f)
  (lambda (p e eqh)
    (bst-two-local! 'f 'g p e eqh
      (lambda (q d b1 b2)
        (let* ((x1 (cadr (cadr b1))) (x2 (cadr (cadr b2)))
               (A (list '* x1 'a1)) (B (list '* x2 'a2))
               (X (list '- (list '+ (list '* (list 'f p) 'a1) (list '* (list 'g p) 'a2))
                           (list '+ (list '* (list 'f q) 'a1) (list '* (list 'g q) 'a2)))))
          (dk-real! x1) (dk-real! x2) (dk-real! A) (dk-real! B)
          (dk-have! (list '= X (list '+ A B)) (lambda () (crs)))
          (subst (list '= X (list '+ A B)))
          (let* ((tri (dk-cite! 'rr-abs-triangle-c A B))
                 (m1 (dk-cite! 'abs-mul-le-unit x1 'a1))
                 (m2 (dk-cite! 'abs-mul-le-unit x2 'a2)))
            (for-each (lambda (z) (bst-real-abs! z)) (list A B x1 x2 (list '+ A B)))
            (dk-ineq! tri m1 m2 b1 b2 (list '= (list '+ d d) e)
                      (list 'IN (list 'abs A) 'RR) (list 'IN (list 'abs B) 'RR) (list 'IN (list 'abs x1) 'RR)
                      (list 'IN (list 'abs x2) 'RR) (list 'IN (list 'abs (list '+ A B)) 'RR) (list 'IN d 'RR) (list 'IN e 'RR))))))))
(bst-qed! 'bsw-rcont-lin)

;; absolute value
(bst-ptw-sp! '(t f h) '((IN f (RCONT t))) '(abs (f rz_)))
(bst-ptw-drive! (bst-top-from! 'f)
  (lambda (p e eqh)
    (bst-split-cite! 'bsw-rcont-parts 't 'f)
    (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't 'f) p e)))
           (c1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
      (ew u)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((q (dk-di-var!)))
                (dk-cite! 'top-open-subset 't u)
                (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                (let ((b1 (dk-apply! c1 q)))
                  (bst-at-pq! eqh p q '(f))
                  (let ((rt (dk-cite! 'rr-abs-reverse-triangle (list 'f p) (list 'f q))))
                    (dk-pos-parts! e)
                    (bst-real-abs! (list 'f p)) (bst-real-abs! (list 'f q))
                    (for-each (lambda (z) (bst-real-abs! z))
                      (list (list '- (list 'f p) (list 'f q)) (list '- (list 'abs (list 'f p)) (list 'abs (list 'f q)))))
                    (dk-ineq! rt b1 (list 'IN (list 'abs (list '- (list 'f p) (list 'f q))) 'RR)
                              (list 'IN (list 'abs (list '- (list 'abs (list 'f p)) (list 'abs (list 'f q)))) 'RR)))))
              (bst-ass!)))))))
(bst-qed! 'bsw-rcont-abs)

;;; ---- a continuous real function on a compact space is bounded ---------------------------------
(define (bst-bnd W) (list 'FORSOME 'bm_ (list 'AND '(IN bm_ RR) (list 'AND '(<= 0 bm_)
                      (list 'FORALL 'bz_ (list 'IMPLIES (list 'IN 'bz_ W) '(<= (abs (f bz_)) bm_)))))))
(define bst-bpp (list 'SEP 'bw_ '(POWER (PTS t)) (bst-bnd 'bw_)))
(define (bst-in-power! w)             ; w subset PTS t: land w in POWER(PTS t)
  (dk-cite! 'subclass-of-set-is-set w '(PTS t))
  (let ((imp (dk-cite! 'power-mem-intro '(PTS t) w)))
    (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd w '(PTS t) z) (bst-ass!))))
    (detach! imp)))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'f (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IN f (RCONT t)) (bst-bnd '(PTS t))))))))
(dk-peel!)
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'power-set '(PTS t))
(let ((imp (dk-cite! 'bsw-compact-induction 't bst-bpp)))
  ;; the empty set
  (dk-have! (list 'IN 'EMPTY-SET bst-bpp)
    (lambda ()
      (dk-cite! 'empty-set-is-set)
      (dk-have! '(SUBSET EMPTY-SET (PTS t))
        (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bst-empty-absurd! z))))
      (bst-in-power! 'EMPTY-SET)
      (in-sep! (lambda () (bst-ass!))
        (lambda () (ew 0)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-head-is? g 'FORALL) (let ((z (dk-di-var!))) (bst-empty-absurd! z)))
                      ((dk-head-is? g '<=) (dk-ineq!))
                      (#t (from-context!))))))))))
  ;; binary unions
  (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka bst-bpp) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb bst-bpp) (list 'IN '(UNION ka kb) bst-bpp)))))
    (lambda ()
      (let* ((pe (dk-peel!)) (g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g))) (un (list 'UNION a b)))
        (dk-project! (list 'IN a '(POWER (PTS t))) (lambda () (sep-me (list 'IN a bst-bpp))))
        (dk-project! (list 'IN b '(POWER (PTS t))) (lambda () (sep-me (list 'IN b bst-bpp))))
        (sep-me (list 'IN a bst-bpp)) (dk-split-all!)
        (let* ((m1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h a))) "bound of a")))
               (c1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h a) (dk-contains? h m1))) "a clause")))
          (sep-me (list 'IN b bst-bpp)) (dk-split-all!)
          (let* ((m2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h b))) "bound of b")))
                 (c2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b) (dk-contains? h m2))) "b clause")))
            (dk-have! (list 'SUBSET un '(PTS t))
              (lambda () (mac 'subset-def)
                (let ((z (dk-di-var!)))
                  (bst-rhs! (dk-cite! 'union-membership a b z))
                  (use-em (list 'IN z a) (lambda () (dk-cite! 'power-mem-in '(PTS t) a z) (bst-ass!))
                                         (lambda () (bst-other-case! z a b) (dk-cite! 'power-mem-in '(PTS t) b z) (bst-ass!))))))
            (bst-in-power! un)
            (in-sep! (lambda () (bst-ass!))
              (lambda ()
                (ew (list '+ m1 m2))
                (dk-conj-close!
                  (lambda ()
                    (let ((g (dk-goal)))
                      (cond ((dk-head-is? g 'FORALL)
                             (let ((z (dk-di-var!)))
                               (bst-rhs! (dk-cite! 'union-membership a b z))
                               (dk-have! (list 'IN z '(PTS t))
                                 (lambda () (use-em (list 'IN z a) (lambda () (dk-cite! 'power-mem-in '(PTS t) a z) (bst-ass!))
                                                    (lambda () (bst-other-case! z a b) (dk-cite! 'power-mem-in '(PTS t) b z) (bst-ass!)))))
                               (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR z)
                               (bst-real-abs! (list 'f z))
                               (use-em (list 'IN z a)
                                 (lambda () (let ((l (dk-apply! c1 z))) (dk-ineq! l (list '<= 0 m2) (list 'IN m1 'RR) (list 'IN m2 'RR) (list 'IN (list 'abs (list 'f z)) 'RR))))
                                 (lambda () (bst-other-case! z a b)
                                            (let ((l (dk-apply! c2 z))) (dk-ineq! l (list '<= 0 m1) (list 'IN m1 'RR) (list 'IN m2 'RR) (list 'IN (list 'abs (list 'f z)) 'RR)))))))
                            ((dk-head-is? g 'IN) (dk-real! (list '+ m1 m2)) (bst-ass!))
                            (#t (dk-ineq! (list '<= 0 m1) (list '<= 0 m2) (list 'IN m1 'RR) (list 'IN m2 'RR))))))))))))))
  ;; the local bound
  (dk-have! (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u bst-bpp))))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (dk-have! '(IN 1 RR)) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (dk-cite! 'rr-pos-rr-of-lt 1)
        (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't 'f) p 1)))
               (c1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
          (dk-cite! 'top-open-subset 't u)
          (bst-in-power! u)
          (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR p)
          (bst-real-abs! (list 'f p))
          (ew u)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (if (dk-asm? (dk-goal)) (ass)
                      (in-sep! (lambda () (bst-ass!))
                        (lambda ()
                          (ew (list '+ (list 'abs (list 'f p)) 1))
                          (dk-conj-close!
                            (lambda ()
                              (let ((g (dk-goal)))
                                (cond ((dk-head-is? g 'FORALL)
                                       (let ((z (dk-di-var!)))
                                         (dk-cite! 'subset-mem-fwd u '(PTS t) z)
                                         (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR z)
                                         (let* ((l (dk-apply! c1 z))
                                                (rt (dk-cite! 'rr-abs-reverse-triangle (list 'f z) (list 'f p)))
                                                (sy (dk-cite! 'rr-abs-sub-sym (list 'f z) (list 'f p))))
                                           (bst-real-abs! (list 'f z))
                                           (bst-real-abs! (list '- (list 'f z) (list 'f p)))
                                           (bst-real-abs! (list '- (list 'f p) (list 'f z)))
                                           (bst-real-abs! (list '- (list 'abs (list 'f z)) (list 'abs (list 'f p))))
                                           (bst-split-cite! 'rr-abs-le-parts (list '- (list 'abs (list 'f z)) (list 'abs (list 'f p)))
                                                            (list 'abs (list '- (list 'f z) (list 'f p))))
                                           (dk-ineq! l sy (list '<= (list '- (list 'abs (list 'f z)) (list 'abs (list 'f p))) (list 'abs (list '- (list 'f z) (list 'f p))))
                                                     (list 'IN (list 'abs (list 'f z)) 'RR) (list 'IN (list 'abs (list 'f p)) 'RR)
                                                     (list 'IN (list 'abs (list '- (list 'f z) (list 'f p))) 'RR) (list 'IN (list 'abs (list '- (list 'f p) (list 'f z))) 'RR)))))
                                      ((dk-head-is? g 'IN) (dk-real! (list '+ (list 'abs (list 'f p)) 1)) (bst-ass!))
                                      (#t (dk-cite! 'rr-abs-nonneg (list 'f p))
                                          (dk-ineq! (list '<= 0 (list 'abs (list 'f p))) (list 'IN (list 'abs (list 'f p)) 'RR))))))))))
                  (bst-ass!))))))))
  (dk-apply! imp)
  (sep-me (list 'IN '(PTS t) bst-bpp))
  (dk-split-all!)
  (bst-ass!))
(bst-qed! 'bsw-rcont-bounded)

;;; ================================================================================================
;;; STONE-WEIERSTRASS (real).  aa a unital subalgebra of C_R(t), t compact; the closure
;;; RCONT-CLOSURE(t, aa) is a lattice (through |.| = a limit of polynomials, Weierstrass), and a
;;; lattice containing two-point interpolants of every f is everything (two compactness inductions).
;;; ================================================================================================
(define bst-ucl '(RCONT-CLOSURE t aa))
(define (bst-approx h g e)             ; forall y in PTS t. |h y - g y| < e
  (list 'FORALL 'rsy_ (list 'IMPLIES '(IN rsy_ (PTS t)) (list '< (list 'abs (list '- (list h 'rsy_) (list g 'rsy_))) e))))
(define bst-ucl-sep
  (list 'SEP 'rsh_ '(RCONT t)
     (list 'FORALL 'rse_ (list 'IMPLIES '(POS-RR rse_) (list 'FORSOME 'rsg_ (list 'AND '(IN rsg_ aa) (bst-approx 'rsh_ 'rsg_ 'rse_)))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list '== bst-ucl bst-ucl-sep)))))
(dk-peel!) (mac 'RCONT-CLOSURE) (qrfl)
(bst-qed! 'bsw-rcont-closure-unfold)

;; (IN h ucl) in context: land (IN h (RCONT t)) and the approximation universal; the membership stays
(define (bst-ucl-open! h)
  (dk-cite! 'bsw-rcont-closure-unfold 't 'aa)
  (let ((m (dk-rewrite-h! (list 'IN h bst-ucl) bst-ucl bst-ucl-sep)))
    (sep-me m) (dk-split-all!)
    (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rse_) (dk-contains? x h))) "the approximation clause")))
;; goal (IN h ucl): RCONT membership by DOM!, then for e: BODY! (called with e)
(define (bst-ucl-in! h dom! body!)
  (dk-cite! 'bsw-rcont-closure-unfold 't 'aa)
  (subst (list '= bst-ucl bst-ucl-sep))
  (in-sep! (lambda () (dom!))
    (lambda ()
      (let* ((pe (dk-peel!)) (e (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pe)))))
        (body! e)))))
;; the value of a function in RCONT typed at y
(define (bst-rval! f y)
  (bst-split-cite! 'bsw-rcont-parts 't f)
  (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR y))

;; RCONT(t) is a set (and so certified DEFINED in any context that holds this)
(sp (make-wff '(FORALL t (IMPLIES (IS-TOP-SPACE t) (IN (RCONT t) SET)))))
(dk-peel!)
(dk-cite! 'bsw-rcont-unfold 't)
(subst (list '= '(RCONT t) bst-rsep))
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'rr-is-set)
(sep-set)
(bst-lhs! (dk-cite! 'fun-set-iff '(PTS t) 'RR) (lambda () (dk-conj-close! (lambda () (bst-ass!)))))
(bst-ass!)
(bst-qed! 'bsw-rcont-set)

;; aa is inside its closure
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES '(SUBSET aa (RCONT t))
   (list 'IMPLIES '(IN f aa) (list 'IN 'f bst-ucl)))))))))
(dk-peel!)
(dk-cite! 'bsw-rcont-set 't)
(bst-sub-mem! 'aa '(RCONT t) 'f)
(bst-ucl-in! 'f (lambda () (bst-ass!))
  (lambda (e)
    (ew 'f)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let ((y (dk-di-var!)))
              (bst-rval! 'f y)
              (dk-have! (list '= (list '- (list 'f y) (list 'f y)) 0) (lambda () (crs)))
              (subst (list '= (list '- (list 'f y) (list 'f y)) 0))
              (dk-cite! 'rr-abs-zero-value)
              (subst '(= (abs 0) 0))
              (dk-pos-parts! e) (bst-ass!))
            (bst-ass!))))))
(bst-qed! 'bsw-rcont-closure-contains)

;; the closure is closed: a continuous h approximable by members of the closure is in it
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'h (list 'IMPLIES '(SUBSET aa (RCONT t)) (list 'IMPLIES '(IN h (RCONT t))
   (list 'IMPLIES (list 'FORALL 'swe_ (list 'IMPLIES '(POS-RR swe_) (list 'FORSOME 'swg_ (list 'AND (list 'IN 'swg_ bst-ucl) (bst-approx 'h 'swg_ 'swe_)))))
     (list 'IN 'h bst-ucl)))))))))
(dk-peel!)
(bst-split-cite! 'bsw-rcont-parts 't 'h)
(dk-cite! 'bsw-rcont-set 't)
(define bst-hcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'swe_))) "the approximation hypothesis"))
(bst-ucl-in! 'h (lambda () (bst-ass!))
  (lambda (e)
    (dk-pos-parts! e)
    (let* ((d (dk-halve! e))
           (g (dk-skolem! (dk-apply! bst-hcl d)))
           (gcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x g))) "h ~ g"))
           (gap (bst-ucl-open! g))
           (g2 (dk-skolem! (dk-apply! gap d)))
           (g2cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x g2))) "g ~ g2")))
      (bst-sub-mem! 'aa '(RCONT t) g2)
      (ew g2)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((y (dk-di-var!)) (b1 (dk-apply! gcl y)) (b2 (dk-apply! g2cl y)))
                (bst-rval! 'h y) (bst-rval! g y) (bst-rval! g2 y)
                (let ((x1 (cadr (cadr b1))) (x2 (cadr (cadr b2))))
                  (bst-abs-parts! x1 d) (bst-abs-parts! x2 d)
                  (bst-abs-lt-goal! (list '- (list 'h y) (list g2 y)) e
                    (list '< (list '- d) x1) (list '< x1 d) (list '< (list '- d) x2) (list '< x2 d) (list '= (list '+ d d) e)
                    (list 'IN (list 'h y) 'RR) (list 'IN (list g y) 'RR) (list 'IN (list g2 y) 'RR) (list 'IN d 'RR))))
              (bst-ass!)))))))
(bst-qed! 'bsw-rcont-closure-closed)

;;; ---- the subalgebra aa, read pointwise: for the constants, sums, products and polynomials in a
;;; member, SOME member of aa takes those values (the witnesses are the lambda terms of the
;;; definition; nothing downstream ever compares two functions) ---------------------------------
(define (bst-ex body)
  (list 'FORSOME 'sak_ (list 'AND '(IN sak_ aa) (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= '(sak_ rz_) body))))))
(define bst-S '(IS-RCONT-SUBALGEBRA t aa))
(define (bst-sa-parts!) (bst-rhs! (dk-cite! 'is-rcont-subalgebra 't 'aa)))
(define (bst-sa-clause key)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL)
                            (case key
                              ((const) (eq? (cadr h) 'rsc_))
                              ((add) (and (eq? (cadr h) 'rsf_) (dk-contains? h '+)))
                              (else (and (eq? (cadr h) 'rsf_) (dk-contains? h '*))))))
           "a subalgebra clause"))
(define (bst-ex-close! lam typer!)   ; goal (bst-ex body), (IN LAM aa) in context
  (ew lam)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((z (dk-di-var!))) (typer! z) (dk-close-if! (lambda () (dk-lam-b!)) rfl))
          (bst-ass!)))))
(define (bst-skolem-ex! r)           ; R a (bst-ex ..) instance in context: (k . its value universal)
  (let* ((k (dk-skolem! r))
         (v (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h k))) "the value clause")))
    (cons k v)))

(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'c (list 'IMPLIES bst-S (list 'IMPLIES '(IN c RR) (bst-ex 'c))))))))
(dk-peel!)
(bst-sa-parts!)
(dk-apply! (bst-sa-clause 'const) 'c)
(bst-ex-close! '(VNB-LAMBDA rsz_ (PTS t) c) (lambda (z) #t))
(bst-qed! 'bsw-sa-const)

(define (bst-sa-binop! key op)
  (sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'g
        (list 'IMPLIES bst-S (list 'IMPLIES '(IN f aa) (list 'IMPLIES '(IN g aa) (bst-ex (list op '(f rz_) '(g rz_))))))))))))
  (dk-peel!)
  (bst-sa-parts!)
  (dk-apply! (bst-sa-clause key) 'f 'g)
  (bst-sub-mem! 'aa '(RCONT t) 'f) (bst-sub-mem! 'aa '(RCONT t) 'g)
  (bst-ex-close! (list 'VNB-LAMBDA 'rsz_ '(PTS t) (list op '(f rsz_) '(g rsz_)))
                 (lambda (z) (bst-rval! 'f z) (bst-rval! 'g z))))
(bst-sa-binop! 'add '+)
(bst-qed! 'bsw-sa-add)
(bst-sa-binop! 'mul '*)
(bst-qed! 'bsw-sa-mul)

;; polynomials in a member g of aa, by Horner (cc-ps-shift): some k in aa has k(z) = sum_{j<n} c(j) g(z)^j
(define (bst-ps c x n) (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power x 'pfj_))) n))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'g (list 'IMPLIES bst-S (list 'IMPLIES '(IN g aa) (list 'IMPLIES '(IN g (RCONT t))
   (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'c
     (list 'IMPLIES '(IN c (FUN NN RR)) (bst-ex (bst-ps 'c '(g rz_) 'n))))))))))))))
(di) (di) (di) (di)
(if (not (and (dk-asm? '(IN g aa)) (dk-head-is? (dk-goal) 'FORALL) (eq? (cadr (dk-goal)) 'n))) (error "basw: sa-poly head"))
(ni)
(define (bst-step-leaf? l) (dk-contains? (dk-goal-of l) 'succ))
(dk-focus! (find-first (lambda (l) (not (bst-step-leaf? l))) (dk-open-leaves)))
(dk-peel!)
(dk-have! '(IN 0 RR))
(let* ((kv (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa 0))) (k0 (car kv)) (ve (cdr kv)))
  (ew k0)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((z (dk-di-var!)))
            (subst (dk-apply! ve z))
            (let ((zr (dk-cite! 'cc-series-partial-sum-zero (cadr (bst-ps 'c (list 'g z) 0)))))
              (dk-close-if! (lambda () (subst zr)) rfl)))
          (bst-ass!)))))
(dk-focus! (find-first bst-step-leaf? (dk-open-leaves)))
(define bst-pn (dk-di-var!))
(dk-peel!)
(define bst-ih (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'c))) "the IH"))
(if (not (dk-asm? '(IN c (FUN NN RR)))) (error "basw: the step's eigenvariable is not c"))
(bst-sa-parts!)
(dk-cite! 'nn-zero-in)
(dk-cite! 'fun-apply-type-c 'c 'NN 'RR 0)
(define bst-sh '(VNB-LAMBDA ansk_ NN (c (succ ansk_))))
(dk-have! (list 'IN bst-sh '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-cite! 'nn-succ-closed k) (dk-cite! 'fun-apply-type-c 'c 'NN 'RR (list 'succ k)) (bst-ass!))))))
(dk-have! '(SUBSET RR CC) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-cite! 'rr-subset-cc z) (bst-ass!))))
(dk-cite! 'fun-codomain-superset 'c 'NN 'RR 'CC)
(let* ((r1 (bst-skolem-ex! (dk-apply! bst-ih bst-sh)))
       (r0 (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa '(c 0))))
       (rm (bst-skolem-ex! (bst-fact! 'bsw-sa-mul 't 'aa 'g (car r1))))
       (rs (bst-skolem-ex! (bst-fact! 'bsw-sa-add 't 'aa (car r0) (car rm)))))
  (ew (car rs))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((z (dk-di-var!)))
            (for-each (lambda (r) (subst (dk-apply! (cdr r) z))) (list rs r0 rm r1))
            (bst-rval! 'g z)
            (dk-cite! 'rr-subset-cc (list 'g z))
            (let ((sh (dk-cite! 'cc-ps-shift bst-pn 'c (list 'g z))))
              (dk-close-if! (lambda () (subst sh)) rfl)))
          (bst-ass!)))))
(bst-qed! 'bsw-sa-poly)

;;; ---- |.| is a uniform limit of polynomials on [-M, M] (Weierstrass, calculus 5.7) ---------------
(define bst-absf '(VNB-LAMBDA baw_ (CCINT a b) (abs baw_)))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IS-CONTINUOUS-ON bst-absf '(CCINT a b))))))
(dk-peel!)
(dk-cite! 'ccint-subset-rr 'a 'b)
(dk-have! (list 'IN bst-absf '(FUN (CCINT a b) RR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (dk-cite! 'ccint-elt-in-rr 'a 'b x) (bst-real-abs! x) (bst-ass!)))
                    (lambda () (dk-cite! 'rr-is-set) (dk-cite! 'subclass-of-set-is-set '(CCINT a b) 'RR) (bst-ass!)))))
(let ((imp (dk-cite! 'continuous-on-abs-bwd '(CCINT a b) bst-absf)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (dk-peel!))
             (x (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(CCINT a b)))) pe))))
             (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe)))))
        (ew e)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((pe2 (dk-peel!))
                       (y (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(CCINT a b)) (not (eq? (cadr h) x)))) pe2))))
                       (hb (car (filter (lambda (h) (dk-head-is? h '<=)) pe2))))
                  (dk-cite! 'ccint-elt-in-rr 'a 'b x) (dk-cite! 'ccint-elt-in-rr 'a 'b y)
                  (dk-lam-b!)
                  (let ((rt (dk-cite! 'rr-abs-reverse-triangle x y)))
                    (dk-pos-parts! e)
                    (bst-real-abs! x) (bst-real-abs! y)
                    (bst-real-abs! (list '- x y)) (bst-real-abs! (list '- (list 'abs x) (list 'abs y)))
                    (dk-ineq! rt hb (list 'IN (list 'abs (list '- x y)) 'RR) (list 'IN (list 'abs (list '- (list 'abs x) (list 'abs y))) 'RR) (list 'IN e 'RR))))
                (bst-ass!)))))))
  (detach! imp)
  (bst-ass!))
(bst-qed! 'bsw-abs-cont-on)

;; |x| within e of one polynomial for every |x| <= M
(sp (make-wff (list 'FORALL 'M (list 'IMPLIES '(IN M RR) (list 'IMPLIES '(<= 0 M) (list 'FORALL 'e (list 'IMPLIES '(POS-RR e)
   (list 'FORSOME 'bpn_ (list 'AND '(IN bpn_ NN) (list 'FORSOME 'bpc_ (list 'AND '(IN bpc_ (FUN NN RR))
     (list 'FORALL 'bpx_ (list 'IMPLIES '(IN bpx_ RR) (list 'IMPLIES '(<= (abs bpx_) M)
       (list '< (list 'abs (list '- '(abs bpx_) (bst-ps 'bpc_ 'bpx_ 'bpn_))) 'e)))))))))))))))
(dk-peel!)
(define bst-A '(- (+ M 1)))
(define bst-B '(+ M 1))
(define bst-I (list 'CCINT bst-A bst-B))
(define bst-af (list 'VNB-LAMBDA 'baw_ bst-I '(abs baw_)))
(dk-real! bst-A) (dk-real! bst-B)
(dk-have! (list '< bst-A bst-B) (lambda () (dk-ineq! '(<= 0 M) '(IN M RR))))
(dk-cite! 'bsw-abs-cont-on bst-A bst-B)
(dk-pos-parts! 'e)
(define bst-d (dk-halve! 'e))
(let* ((P (dk-skolem! (bst-fact! 'weierstrass-approximation bst-A bst-B bst-af)))
       (polycl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-POLY-FN-ON))) "the polynomials"))
       (apcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'eps))) "the approximation"))
       (cap (dk-skolem! (dk-apply! apcl bst-d)))
       (capcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cap))) "the cap clause")))
  (dk-cite! 'nn-in-rr cap)
  (dk-have! (list '<= cap cap) (lambda () (dk-ineq! (list 'IN cap 'RR))))
  (let* ((bound (dk-apply! capcl cap))
         (pc (list P cap))
         (pp (dk-apply! polycl cap)))
    (bst-rhs! (dk-cite! 'is-poly-fn-on 'RR bst-I pc))
    (let* ((N (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'pfn_))) "the degree")))
           (C (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'pfc_))) "the coefficients")))
           (vals (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'pfz_) (dk-contains? h C))) "the values")))
      (ew N)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin
                (ew C)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORALL)
                        (let* ((pe (dk-peel!))
                               (x (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) pe)))))
                          (bst-split-cite! 'rr-abs-le-parts x 'M)
                          (bst-lhs! (dk-cite! 'ccint-membership bst-A bst-B x)
                                    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                      (dk-ineq! (list '<= '(- M) x) (list '<= x 'M) (list 'IN x 'RR) '(IN M RR)))))))
                          (let* ((bx (dk-apply! bound x))
                                 (vx (dk-apply! vals x))
                                 (px (list pc x))
                                 (ps (caddr vx)))
                            (dk-lam-b-h! bx)
                            (subst (list '= ps px))
                            (dk-cite! 'fun-apply-type-c pc bst-I 'RR x)
                            (bst-real-abs! x)
                            (bst-real-abs! (list '- (list 'abs x) px))
                            (dk-ineq! (list '<= (list 'abs (list '- (list 'abs x) px)) bst-d) (list '= (list '+ bst-d bst-d) 'e)
                                      (list '< 0 bst-d) (list 'IN bst-d 'RR) (list 'IN (list 'abs (list '- (list 'abs x) px)) 'RR))))
                        (bst-ass!)))))
              (bst-ass!)))))))
(bst-qed! 'bsw-abs-poly-approx)

;; the closure is closed under |.|
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'h (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S
   (list 'IMPLIES (list 'IN 'f bst-ucl) (list 'IMPLIES '(IN h (FUN (PTS t) RR))
     (list 'IMPLIES '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (h rz_) (abs (f rz_)))))
       (list 'IN 'h bst-ucl))))))))))))
(dk-peel!)
(bst-sa-parts!)
(define bst-fap (bst-ucl-open! 'f))
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(dk-cite! 'bsw-rcont-set 't)
(define bst-eqh (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h 'abs) (dk-contains? h 'h))) "|f|"))
(bst-fact! 'bsw-rcont-abs 't 'f 'h)
(bst-ucl-in! 'h (lambda () (bst-ass!))
  (lambda (e)
    (dk-pos-parts! e)
    (let* ((d (dk-halve! e))
           (g (dk-skolem! (dk-apply! bst-fap d)))
           (gcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x g))) "f ~ g")))
      (bst-sub-mem! 'aa '(RCONT t) g)
      (let* ((M (dk-skolem! (bst-fact! 'bsw-rcont-bounded 't g)))
             (Mcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'bz_) (dk-contains? x M))) "the bound"))
             (N (dk-skolem! (dk-apply! (dk-cite! 'bsw-abs-poly-approx M) d)))
             (C (dk-skolem! (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (eq? (cadr x) 'bpc_))) "the coefficients")))
             (pacl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'bpx_) (dk-contains? x C))) "the polynomial bound"))
             (kv (bst-skolem-ex! (dk-apply! (bst-fact! 'bsw-sa-poly 't 'aa g) N C)))
             (k (car kv)))
        (bst-sub-mem! 'aa '(RCONT t) k)
        (ew k)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((y (dk-di-var!))
                       (b1 (dk-apply! gcl y))
                       (bm (dk-apply! Mcl y)))
                  (bst-rval! 'f y) (bst-rval! g y) (bst-rval! k y)
                  (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'RR y)
                  (let* ((pa (dk-apply! pacl (list g y)))
                         (ky (dk-apply! (cdr kv) y))
                         (ps (caddr ky))
                         (fy (list 'f y)) (gy (list g y))
                         (x1 (list '- (list 'abs fy) (list 'abs gy)))
                         (x2 (list '- (list 'abs gy) ps)))
                    (dk-rewrite-h! (list 'IN (list k y) 'RR) (list k y) ps)
                    (subst (dk-apply! bst-eqh y))
                    (subst ky)
                    (let ((rt (dk-cite! 'rr-abs-reverse-triangle fy gy)))
                      (for-each bst-real-abs! (list fy gy (list '- fy gy) x1 x2))
                      (dk-have! (list '< (list 'abs x1) d)
                        (lambda () (dk-ineq! rt b1 (list 'IN (list 'abs x1) 'RR) (list 'IN (list 'abs (list '- fy gy)) 'RR) (list 'IN d 'RR))))
                      (bst-abs-parts! x1 d) (bst-abs-parts! x2 d)
                      (bst-abs-lt-goal! (list '- (list 'abs fy) ps) e
                        (list '< (list '- d) x1) (list '< x1 d) (list '< (list '- d) x2) (list '< x2 d) (list '= (list '+ d d) e)
                        (list 'IN (list 'abs fy) 'RR) (list 'IN (list 'abs gy) 'RR) (list 'IN ps 'RR) (list 'IN d 'RR)))))
                (bst-ass!))))))))
(bst-qed! 'bsw-ucl-abs)

;; the closure is closed under combinations f a1 + g a2 with |a1|, |a2| <= 1
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'a1 (list 'FORALL 'a2 (list 'FORALL 'h
   (list 'IMPLIES bst-S (list 'IMPLIES (list 'IN 'f bst-ucl) (list 'IMPLIES (list 'IN 'g bst-ucl)
   (list 'IMPLIES '(IN a1 RR) (list 'IMPLIES '(IN a2 RR) (list 'IMPLIES '(<= (abs a1) 1) (list 'IMPLIES '(<= (abs a2) 1)
   (list 'IMPLIES '(IN h (FUN (PTS t) RR))
   (list 'IMPLIES '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (h rz_) (+ (* (f rz_) a1) (* (g rz_) a2)))))
     (list 'IN 'h bst-ucl)))))))))))))))))))
(dk-peel!)
(bst-sa-parts!)
(define bst-lfa (bst-ucl-open! 'f))
(define bst-lga (bst-ucl-open! 'g))
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(dk-cite! 'bsw-rcont-set 't)
(define bst-leq (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h 'a1))) "the combination"))
(bst-fact! 'bsw-rcont-lin 't 'f 'g 'a1 'a2 'h)
(bst-ucl-in! 'h (lambda () (bst-ass!))
  (lambda (e)
    (dk-pos-parts! e)
    (let* ((d (dk-halve! e))
           (f2 (dk-skolem! (dk-apply! bst-lfa d)))
           (fcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x f2))) "f ~ f2"))
           (g2 (dk-skolem! (dk-apply! bst-lga d)))
           (gcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x g2))) "g ~ g2"))
           (r1 (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa 'a1)))
           (m1 (bst-skolem-ex! (bst-fact! 'bsw-sa-mul 't 'aa f2 (car r1))))
           (r2 (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa 'a2)))
           (m2 (bst-skolem-ex! (bst-fact! 'bsw-sa-mul 't 'aa g2 (car r2))))
           (rs (bst-skolem-ex! (bst-fact! 'bsw-sa-add 't 'aa (car m1) (car m2)))))
      (bst-sub-mem! 'aa '(RCONT t) f2) (bst-sub-mem! 'aa '(RCONT t) g2)
      (ew (car rs))
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((y (dk-di-var!)) (b1 (dk-apply! fcl y)) (b2 (dk-apply! gcl y)))
                (bst-rval! 'f y) (bst-rval! 'g y) (bst-rval! f2 y) (bst-rval! g2 y)
                (subst (dk-apply! bst-leq y))
                (for-each (lambda (r) (subst (dk-apply! (cdr r) y))) (list rs m1 r1 m2 r2))
                (let* ((x1 (cadr (cadr b1))) (x2 (cadr (cadr b2)))
                       (A (list '* x1 'a1)) (B (list '* x2 'a2))
                       (xdf (list '- (list '+ (list '* (list 'f y) 'a1) (list '* (list 'g y) 'a2))
                                   (list '+ (list '* (list f2 y) 'a1) (list '* (list g2 y) 'a2)))))
                  (dk-real! x1) (dk-real! x2) (dk-real! A) (dk-real! B)
                  (dk-have! (list '= xdf (list '+ A B)) (lambda () (crs)))
                  (subst (list '= xdf (list '+ A B)))
                  (let* ((tri (dk-cite! 'rr-abs-triangle-c A B))
                         (u1 (dk-cite! 'abs-mul-le-unit x1 'a1))
                         (u2 (dk-cite! 'abs-mul-le-unit x2 'a2)))
                    (for-each bst-real-abs! (list A B x1 x2 (list '+ A B)))
                    (dk-ineq! tri u1 u2 b1 b2 (list '= (list '+ d d) e)
                              (list 'IN (list 'abs A) 'RR) (list 'IN (list 'abs B) 'RR) (list 'IN (list 'abs x1) 'RR)
                              (list 'IN (list 'abs x2) 'RR) (list 'IN (list 'abs (list '+ A B)) 'RR) (list 'IN d 'RR) (list 'IN e 'RR)))))
              (bst-ass!)))))))
(bst-qed! 'bsw-ucl-lin)

;;; ---- max and min in the closure: (f + g +- |f - g|) / 2 ------------------------------------
;; a function on PTS t with the given values: (G . the pointwise equation, rz_ form)
(define (bst-mkfun! body-of typer)
  (let* ((r (dk-abstract! '(PTS t) 'RR body-of (lambda (k) (typer k) (bst-ass!))))
         (G (car r)) (ve (cdr r))
         (ptw (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= (list G 'rz_) (body-of 'rz_))))))
    (dk-have! ptw (lambda () (let ((z (dk-di-var!))) (typer z) (dk-close-if! (lambda () (subst (dk-apply! ve z))) rfl))))
    (cons G ptw)))
(define (bst-eq-ineq! a b prem)       ; land (= a b) from two inequalities by ineq
  (dk-have! (list '<= a b) (lambda () (apply dk-ineq! prem)))
  (dk-have! (list '<= b a) (lambda () (apply dk-ineq! prem)))
  (dk-have! (list '= a b) (lambda () (bst-fact! 'rr-leq-antisymmetric a b) (bst-ass!))))
(define (bst-lat-stmt mx?)
  (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'g
    (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S (list 'IMPLIES (list 'IN 'f bst-ucl) (list 'IMPLIES (list 'IN 'g bst-ucl)
      (list 'FORSOME 'm (list 'AND (list 'IN 'm bst-ucl)
        (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t))
          (list 'AND (if mx? '(<= (f rz_) (m rz_)) '(<= (m rz_) (f rz_)))
            (list 'AND (if mx? '(<= (g rz_) (m rz_)) '(<= (m rz_) (g rz_)))
              '(OR (= (m rz_) (f rz_)) (= (m rz_) (g rz_))))))))))))))))))
(define (bst-lat! mx?)
  (sp (make-wff (bst-lat-stmt mx?)))
  (dk-peel!)
  (bst-sa-parts!)
  (bst-ucl-open! 'f) (bst-ucl-open! 'g)
  (bst-split-cite! 'bsw-rcont-parts 't 'f)
  (bst-split-cite! 'bsw-rcont-parts 't 'g)
  (bst-rhs! (dk-cite! 'is-top-space 't))
  (dk-cite! 'bsw-rcont-set 't)
  (dk-have! '(IN 1 RR)) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (let* ((d (dk-halve! 1))
         (nd (list '- d))
         (sg (if mx? 1 '(- 1))))
    (dk-pos-parts! d)
    (dk-real! nd) (dk-real! sg)
    (let ((ad (dk-cite! 'rr-abs-of-nonneg d)))
      (dk-have! (list '<= (list 'abs d) 1) (lambda () (subst ad) (dk-ineq! (list '= (list '+ d d) 1) (list '< 0 d) (list 'IN d 'RR))))
      (dk-cite! 'rr-abs-neg d)
      (dk-have! (list '<= (list 'abs nd) 1) (lambda () (subst (list '= (list 'abs nd) (list 'abs d))) (subst ad) (dk-ineq! (list '= (list '+ d d) 1) (list '< 0 d) (list 'IN d 'RR)))))
    (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (let ((a1 (dk-cite! 'rr-abs-of-nonneg 1)))
      (dk-have! '(<= (abs 1) 1) (lambda () (subst a1) (dk-ineq!)))
      (if (not mx?)
          (begin (dk-cite! 'rr-abs-neg 1)
                 (dk-have! '(<= (abs (- 1)) 1) (lambda () (subst '(= (abs (- 1)) (abs 1))) (subst a1) (dk-ineq!))))))
    (let* ((F (lambda (z) (list 'f z))) (G (lambda (z) (list 'g z)))
           (ty2 (lambda (z) (bst-rval! 'f z) (bst-rval! 'g z)))
           (uu (bst-mkfun! (lambda (z) (list '+ (list '* (F z) d) (list '* (G z) nd)))
                           (lambda (z) (ty2 z) (dk-real! (list '+ (list '* (F z) d) (list '* (G z) nd))))))
           (U (car uu)))
      (bst-fact! 'bsw-ucl-lin 't 'aa 'f 'g d nd U)
      (let* ((ss (bst-mkfun! (lambda (z) (list '+ (list '* (F z) d) (list '* (G z) d)))
                             (lambda (z) (ty2 z) (dk-real! (list '+ (list '* (F z) d) (list '* (G z) d))))))
             (S (car ss)))
        (bst-fact! 'bsw-ucl-lin 't 'aa 'f 'g d d S)
        (let* ((vv (bst-mkfun! (lambda (z) (list 'abs (list U z)))
                               (lambda (z) (dk-cite! 'fun-apply-type-c U '(PTS t) 'RR z) (bst-real-abs! (list U z)))))
               (V (car vv)))
          (bst-fact! 'bsw-ucl-abs 't 'aa U V)
          (let* ((ww (bst-mkfun! (lambda (z) (list '+ (list '* (list S z) 1) (list '* (list V z) sg)))
                                 (lambda (z) (dk-cite! 'fun-apply-type-c S '(PTS t) 'RR z) (dk-cite! 'fun-apply-type-c V '(PTS t) 'RR z)
                                             (dk-real! (list '+ (list '* (list S z) 1) (list '* (list V z) sg))))))
                 (W (car ww)))
            (bst-fact! 'bsw-ucl-lin 't 'aa S V 1 sg W)
            (ew W)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let* ((z (dk-di-var!))
                           (Fz (F z)) (Gz (G z)) (Uz (list U z)) (Sz (list S z)) (Vz (list V z)) (Wz (list W z))
                           (Fd (list '* Fz d)) (Gd (list '* Gz d)) (Gn (list '* Gz nd)))
                      (ty2 z)
                      (for-each (lambda (q) (dk-cite! 'fun-apply-type-c q '(PTS t) 'RR z)) (list U S V W))
                      (for-each dk-real! (list Fd Gd Gn))
                      (bst-real-abs! Uz)
                      (let* ((eqs (map (lambda (r) (dk-apply! (cdr r) z)) (list uu ss vv ww)))
                             (hF (dk-have! (list '= (list '+ Fd Fd) Fz)
                                   (lambda () (dk-have! (list '= (list '+ Fd Fd) (list '* Fz (list '+ d d))) (lambda () (crs)))
                                              (subst (list '= (list '+ Fd Fd) (list '* Fz (list '+ d d))))
                                              (subst (list '= (list '+ d d) 1)) (crs))))
                             (hG (dk-have! (list '= (list '+ Gd Gd) Gz)
                                   (lambda () (dk-have! (list '= (list '+ Gd Gd) (list '* Gz (list '+ d d))) (lambda () (crs)))
                                              (subst (list '= (list '+ Gd Gd) (list '* Gz (list '+ d d))))
                                              (subst (list '= (list '+ d d) 1)) (crs))))
                             (hn (dk-have! (list '= Gn (list '- Gd)) (lambda () (crs))))
                             (c1 (dk-have! (list '= (list '* Sz 1) Sz) (lambda () (crs))))
                             (c2 (dk-have! (list '= (list '* Vz sg) (if mx? Vz (list '- Vz))) (lambda () (crs))))
                             (base (append eqs
                                     (list (list '= (list '+ Fd Fd) Fz) (list '= (list '+ Gd Gd) Gz) (list '= Gn (list '- Gd))
                                           (list '= (list '* Sz 1) Sz) (list '= (list '* Vz sg) (if mx? Vz (list '- Vz))))
                                     (map (lambda (x) (list 'IN x 'RR)) (list Fz Gz Uz Sz Vz Wz Fd Gd Gn (list 'abs Uz) d))))
                             (close! (lambda (prem first?)    ; FIRST?: the OR is settled by its first disjunct
                                       (dk-conj-close!
                                         (lambda ()
                                           (let ((gl (dk-goal)))
                                             (cond ((dk-asm? gl) (ass))
                                                   ((dk-head-is? gl '<=) (apply dk-ineq! prem))
                                                   ((dk-head-is? gl 'OR)
                                                    (let ((dj (if first? (cadr gl) (caddr gl))))
                                                      (bst-eq-ineq! (cadr dj) (caddr dj) prem)
                                                      (if (dk-only! dj) (prop))))
                                                   (#t (error "basw: lattice goal" (expression->string gl))))))))))
                        (use-em (list '<= 0 Uz)
                          (lambda ()
                            (let ((ae (dk-cite! 'rr-abs-of-nonneg Uz)))
                              (close! (append (list ae (list '<= 0 Uz)) base) mx?)))
                          (lambda ()
                            (let* ((lt (dk-cite! 'rr-not-le-lt 0 Uz))
                                   (ae (dk-cite! 'rr-abs-of-neg Uz)))
                              (close! (append (list ae lt) base) (not mx?)))))))
                    (bst-ass!))))))))))
(bst-lat! #t)
(bst-qed! 'bsw-ucl-max)
(bst-lat! #f)
(bst-qed! 'bsw-ucl-min)

;;; ---- two-point interpolation in aa -----------------------------------------------------------
(define bst-sep '(IS-POINT-SEPARATING t aa))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'p (list 'FORALL 'q (list 'FORALL 'a (list 'FORALL 'b
   (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN p (PTS t)) (list 'IMPLIES '(IN q (PTS t)) (list 'IMPLIES '(NOT (= p q))
   (list 'IMPLIES '(IN a RR) (list 'IMPLIES '(IN b RR)
     '(FORSOME sik_ (AND (IN sik_ aa) (AND (= (sik_ p) a) (= (sik_ q) b)))))))))))))))))))
(dk-peel!)
(bst-sa-parts!)
(bst-rhs! (dk-cite! 'is-point-separating 't 'aa))
(define bst-sepcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rsp_))) "separation"))
(let* ((u (dk-skolem! (dk-apply! bst-sepcl 'p 'q)))
       (up (list u 'p)) (uq (list u 'q))
       (D (list '- uq up)))
  (bst-sub-mem! 'aa '(RCONT t) u)
  (bst-rval! u 'p) (bst-rval! u 'q)
  (dk-real! D)
  (dk-have! (list 'NOT (list '= D 0))
    (lambda ()
      (di)
      (bst-eq-ineq! up uq (list (list '= D 0) (list 'IN up 'RR) (list 'IN uq 'RR)))
      (ai (list 'NOT (list '= up uq)))))
  (bst-fact! 'rr-recip-closed D)
  (bst-fact! 'rr-recip-inverse D)
  (let* ((r0 (dk-name! (list 'recip D)))
         (inv (dk-rewrite-h! (list '= (list '* D (list 'recip D)) 1) (list 'recip D) r0))
         (c2 (list '* '(- b a) r0))
         (c1 (list '- 'a (list '* c2 up))))
    (dk-real! c2) (dk-real! c1)
    (let* ((k1 (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa c1)))
           (k2 (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa c2)))
           (km (bst-skolem-ex! (bst-fact! 'bsw-sa-mul 't 'aa (car k2) u)))
           (ks (bst-skolem-ex! (bst-fact! 'bsw-sa-add 't 'aa (car k1) (car km)))))
      (ew (car ks))
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((dk-asm? gl) (ass))
                  ((and (dk-head-is? gl '=) (equal? (caddr gl) 'a))
                   (for-each (lambda (r) (subst (dk-apply! (cdr r) 'p))) (list ks k1 km k2))
                   (crs))
                  ((dk-head-is? gl '=)
                   (for-each (lambda (r) (subst (dk-apply! (cdr r) 'q))) (list ks k1 km k2))
                   (let ((lhs (cadr (dk-goal))) (rhs2 (list '+ 'a (list '* '(- b a) (list '* D r0)))))
                     (dk-have! (list '= lhs rhs2) (lambda () (crs)))
                     (subst (list '= lhs rhs2))
                     (subst inv)
                     (crs)))
                  (#t (error "basw: interp goal" (expression->string gl))))))))))
(bst-qed! 'bsw-sa-interp)

;; the same through f's values, p = q allowed
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'p (list 'FORALL 'q
   (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN f (RCONT t)) (list 'IMPLIES '(IN p (PTS t)) (list 'IMPLIES '(IN q (PTS t))
     '(FORSOME sik_ (AND (IN sik_ aa) (AND (= (sik_ p) (f p)) (= (sik_ q) (f q)))))))))))))))))
(dk-peel!)
(bst-rval! 'f 'p) (bst-rval! 'f 'q)
(use-em '(= p q)
  (lambda ()
    (let ((k (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa '(f p)))))
      (ew (car k))
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((dk-asm? gl) (ass))
                  ((dk-contains? gl '(sik_ p)) (error "basw: unexpected"))
                  ((equal? (cadr gl) (list (car k) 'p)) (dk-close-if! (lambda () (subst (dk-apply! (cdr k) 'p))) rfl))
                  (#t (subst (dk-apply! (cdr k) 'q)) (dk-close-if! (lambda () (subst '(= p q))) rfl))))))))
  (lambda ()
    (bst-fact! 'bsw-sa-interp 't 'aa 'p 'q '(f p) '(f q))
    (bst-ass!)))
(bst-qed! 'bsw-sa-interp-f)

;;; ---- the two compactness inductions ---------------------------------------------------------
;; the skeleton of an induction over the open sets of t (bsw-compact-induction at the class PP of
;; subsets of PTS t): EMPTY! proves the body at EMPTY-SET, UNION! (a b) the body at a u b, LOCAL! (p)
;; the local clause at p
(define (bst-un-in-pts! z a b)
  (bst-rhs! (dk-cite! 'union-membership a b z))
  (dk-have! (list 'IN z '(PTS t))
    (lambda () (use-em (list 'IN z a) (lambda () (dk-cite! 'power-mem-in '(PTS t) a z) (bst-ass!))
                                      (lambda () (bst-other-case! z a b) (dk-cite! 'power-mem-in '(PTS t) b z) (bst-ass!))))))
(define (bst-cinduct! pp empty! union! local!)
  (let ((imp (dk-cite! 'bsw-compact-induction 't pp)))
    (dk-have! (list 'IN 'EMPTY-SET pp)
      (lambda ()
        (dk-cite! 'empty-set-is-set)
        (dk-have! '(SUBSET EMPTY-SET (PTS t))
          (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bst-empty-absurd! z))))
        (bst-in-power! 'EMPTY-SET)
        (in-sep! (lambda () (bst-ass!)) empty!)))
    (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka pp) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb pp) (list 'IN '(UNION ka kb) pp)))))
      (lambda ()
        (let* ((pe (dk-peel!)) (g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g))) (un (list 'UNION a b)))
          (dk-project! (list 'IN a '(POWER (PTS t))) (lambda () (sep-me (list 'IN a pp))))
          (dk-project! (list 'IN b '(POWER (PTS t))) (lambda () (sep-me (list 'IN b pp))))
          (dk-have! (list 'SUBSET un '(PTS t))
            (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (bst-un-in-pts! z a b) (bst-ass!))))
          (bst-in-power! un)
          (in-sep! (lambda () (bst-ass!)) (lambda () (union! a b))))))
    (dk-have! (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u) (list 'IN 'u pp))))))
      (lambda () (let ((p (dk-di-var!))) (local! p))))
        (dk-apply! imp)
    (sep-me (list 'IN '(PTS t) pp))
    (dk-split-all!)
    (bst-ass!)))
;; (IN a pp) in context: open it, skolemise the witness, return it
(define (bst-pp-wit! a pp)
    (sep-me (list 'IN a pp)) (dk-split-all!)
  (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h a))) "the witness of a member")))
(define (bst-wcl g w)                  ; the clause of witness g over the set w
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h g) (dk-contains? h w))) "a witness clause"))
;; the local step: u1 (for h) and u2 (for f) at p and d, their intersection U; BODY! (z b1 b2) runs at z in U
;; with b1 = |h p - h z| < d, b2 = |f p - f z| < d; WIT! proves (IN U pp) given the body prover
(define (bst-local-two! h p d pp wit!)
  (let* ((u1 (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't h) p d)))
         (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u1))) "the u1 clause"))
         (u2 (dk-skolem! (dk-apply! (dk-cite! 'bsw-rcont-elim 't 'f) p d)))
         (c2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u2))) "the u2 clause"))
         (uu (list 'INTERSECTION u1 u2)))
    (bst-top-inter! u1 u2)
    (dk-cite! 'top-open-subset 't uu)
    (bst-in-power! uu)
    (ew uu)
    (dk-conj-close!
      (lambda ()
        (let ((gl (dk-goal)))
          (cond ((dk-asm? gl) (ass))
                ((and (dk-head-is? gl 'IN) (equal? (caddr gl) pp))
                 (in-sep! (lambda () (bst-ass!))
                   (lambda ()
                     (wit! uu (lambda (z)
                                (bst-inter-out! z u1 u2)
                                (bst-sub-mem! uu '(PTS t) z)
                                (let* ((r1 (dk-apply! c1 z)) (r2 (dk-apply! c2 z))) (list r1 r2)))))))
                ((dk-head-is? gl 'IN) (bst-inter-in! p u1 u2) (bst-ass!))
                (#t (error "basw: local goal" (expression->string gl)))))))))

(define (bst-gate! z a b in-a! in-b!) (use-em (list 'IN z a) in-a! (lambda () (bst-other-case! z a b) (in-b!))))
(define (bst-pick-or! orf)              ; (OR A B) in context: run THUNK-A with A, or THUNK-B with B landed
  (lambda (ka kb)
    (use-em (cadr orf) ka
      (lambda () (dk-have! (caddr orf) (lambda () (if (dk-only! orf (list 'NOT (cadr orf))) (prop)))) (kb)))))

;; STEP 1 (x fixed): some g in the closure has g(x) = f(x) and g < f + e everywhere
(define bst-pp1
  (list 'SEP 'w1_ '(POWER (PTS t))
    (list 'FORSOME 'sg_ (list 'AND (list 'IN 'sg_ bst-ucl) (list 'AND '(= (sg_ x) (f x))
      '(FORALL rz_ (IMPLIES (IN rz_ w1_) (< (sg_ rz_) (+ (f rz_) e)))))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'x (list 'FORALL 'e
   (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN f (RCONT t))
   (list 'IMPLIES '(IN x (PTS t)) (list 'IMPLIES '(POS-RR e)
     (list 'FORSOME 'sg_ (list 'AND (list 'IN 'sg_ bst-ucl) (list 'AND '(= (sg_ x) (f x))
       '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (< (sg_ rz_) (+ (f rz_) e))))))))))))))))))))
(dk-peel!)
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'power-set '(PTS t))
(dk-cite! 'bsw-rcont-set 't)
(bst-sa-parts!)
(bst-rval! 'f 'x)
(dk-pos-parts! 'e)
(bst-cinduct! bst-pp1
  ;; empty: the constant f(x)
  (lambda ()
    (let ((k (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa '(f x)))))
      (bst-fact! 'bsw-rcont-closure-contains 't 'aa (car k))
      (ew (car k))
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((dk-asm? gl) (ass))
                  ((dk-head-is? gl '=) (dk-close-if! (lambda () (subst (dk-apply! (cdr k) 'x))) rfl))
                  (#t (let ((z (dk-di-var!))) (bst-empty-absurd! z)))))))))
  ;; unions: the minimum
  (lambda (a b)
    (let* ((g1 (bst-pp-wit! a bst-pp1)) (c1 (bst-wcl g1 a))
           (g2 (bst-pp-wit! b bst-pp1)) (c2 (bst-wcl g2 b))
           (m (dk-skolem! (bst-fact! 'bsw-ucl-min 't 'aa g1 g2)))
           (mcl (bst-wcl m '(PTS t))))
      (bst-ucl-open! g1) (bst-ucl-open! g2) (bst-ucl-open! m)
      (ew m)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((dk-asm? gl) (ass))
                  ((dk-head-is? gl '=)
                                      (let* ((mx (dk-apply! mcl 'x)) (orf (caddr (caddr mx))))
                     (dk-split-all! (list mx))
                     ((bst-pick-or! orf)
                       (lambda () (subst (cadr orf)) (bst-ass!))
                       (lambda () (subst (caddr orf)) (bst-ass!)))))
                  (#t (let ((z (dk-di-var!)))
                        (bst-un-in-pts! z a b) 
                        (let ((mz (dk-apply! mcl z)))
                                                    (dk-split-all! (list mz))
                                                    (for-each (lambda (q) (bst-rval! q z)) (list m g1 g2 'f))
                          
                          (let ((prem (list (cadr mz) (cadr (caddr mz)) (list 'IN (list m z) 'RR) (list 'IN (list g1 z) 'RR)
                                            (list 'IN (list g2 z) 'RR) (list 'IN (list 'f z) 'RR) (list 'IN 'e 'RR))))
                            (bst-gate! z a b
                              (lambda () (apply bst-ineq! (cons (dk-apply! c1 z) prem)))
                              (lambda () (apply bst-ineq! (cons (dk-apply! c2 z) prem))))))))))))))
  ;; local: an interpolant h through (x, f x) and (p, f p), on the open set where h < f + e near p
  (lambda (p)
    (let* ((hk (dk-skolem! (bst-fact! 'bsw-sa-interp-f 't 'aa 'f 'x p))))
      (bst-sub-mem! 'aa '(RCONT t) hk)
      (bst-fact! 'bsw-rcont-closure-contains 't 'aa hk)
      (bst-rval! hk p)
      (bst-rval! 'f p)
      (let ((d (dk-halve! 'e)))
        (bst-local-two! hk p d bst-pp1
          (lambda (uu body!)
            (ew hk)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let* ((z (dk-di-var!)) (bs (body! z)) (b1 (car bs)) (b2 (cadr bs))
                           (x1 (cadr (cadr b1))) (x2 (cadr (cadr b2))))
                      (bst-rval! hk z) (bst-rval! 'f z)
                      (bst-abs-parts! x1 d) (bst-abs-parts! x2 d)
                      (dk-ineq! (list '< (list '- d) x1) (list '< x1 d) (list '< (list '- d) x2) (list '< x2 d)
                                (list '= (list '+ d d) 'e) (list '= (list hk p) (list 'f p))
                                (list 'IN (list hk p) 'RR) (list 'IN (list hk z) 'RR) (list 'IN (list 'f p) 'RR)
                                (list 'IN (list 'f z) 'RR) (list 'IN d 'RR)))
                    (bst-ass!))))))))))
(bst-qed! 'bsw-sw-step1)

;; STEP 2: some g in the closure has f - e < g < f + e everywhere
(define bst-pp2
  (list 'SEP 'w2_ '(POWER (PTS t))
    (list 'FORSOME 'sg_ (list 'AND (list 'IN 'sg_ bst-ucl) (list 'AND
      '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (< (sg_ rz_) (+ (f rz_) e))))
      '(FORALL rz_ (IMPLIES (IN rz_ w2_) (< (- (f rz_) e) (sg_ rz_)))))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'e
   (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN f (RCONT t))
   (list 'IMPLIES '(POS-RR e)
     (list 'FORSOME 'sg_ (list 'AND (list 'IN 'sg_ bst-ucl)
       '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (AND (< (sg_ rz_) (+ (f rz_) e)) (< (- (f rz_) e) (sg_ rz_))))))))))))))))))
(dk-peel!)
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'power-set '(PTS t))
(dk-cite! 'bsw-rcont-set 't)
(bst-sa-parts!)
(dk-pos-parts! 'e)
(define bst-s2-thm
  (bst-cinduct! bst-pp2
  ;; empty: the constant -M, M a bound of |f|
  (lambda ()
    (let* ((bmx (dk-skolem! (bst-fact! 'bsw-rcont-bounded 't 'f)))
           (bmcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'bz_) (dk-contains? x bmx))) "the bound"))
           (nM (list '- bmx)))
      (dk-real! nM)
      (let ((k (bst-skolem-ex! (bst-fact! 'bsw-sa-const 't 'aa nM))))
        (bst-fact! 'bsw-rcont-closure-contains 't 'aa (car k))
        (ew (car k))
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-asm? gl) (ass))
                    ((dk-contains? gl 'EMPTY-SET) (let ((z (dk-di-var!))) (bst-empty-absurd! z)))
                    (#t (let ((z (dk-di-var!)))
                          (subst (dk-apply! (cdr k) z))
                          (bst-rval! 'f z)
                          (let ((bz (dk-apply! bmcl z)))
                            (bst-split-cite! 'rr-abs-le-parts (list 'f z) bmx)
                            (dk-ineq! (list '<= nM (list 'f z)) (list '< 0 'e) (list 'IN (list 'f z) 'RR) (list 'IN bmx 'RR) (list 'IN 'e 'RR))))))))))))
  ;; unions: the maximum
  (lambda (a b)
    (let* ((g1 (bst-pp-wit! a bst-pp2)) (c1 (bst-wcl g1 a)) (e1 (bst-wcl g1 '(PTS t)))
           (g2 (bst-pp-wit! b bst-pp2)) (c2 (bst-wcl g2 b)) (e2 (bst-wcl g2 '(PTS t)))
           (m (dk-skolem! (bst-fact! 'bsw-ucl-max 't 'aa g1 g2)))
           (mcl (bst-wcl m '(PTS t))))
      (bst-ucl-open! g1) (bst-ucl-open! g2) (bst-ucl-open! m)
      (ew m)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond ((dk-asm? gl) (ass))
                  (#t
                   (let* ((un? (dk-contains? gl 'UNION)) (z (dk-di-var!)))
                     (if un? (bst-un-in-pts! z a b))
                     (let ((mz (dk-apply! mcl z)))
                       (dk-split-all! (list mz))
                       (for-each (lambda (q) (bst-rval! q z)) (list m g1 g2 'f))
                       (let ((prem (list (cadr mz) (cadr (caddr mz)) (list 'IN (list m z) 'RR) (list 'IN (list g1 z) 'RR)
                                         (list 'IN (list g2 z) 'RR) (list 'IN (list 'f z) 'RR) (list 'IN 'e 'RR)))
                             (orf (caddr (caddr mz))))
                         (if un?
                             (bst-gate! z a b
                               (lambda () (apply bst-ineq! (cons (dk-apply! c1 z) prem)))
                               (lambda () (apply bst-ineq! (cons (dk-apply! c2 z) prem))))
                             (let* ((h1 (dk-apply! e1 z)) (h2 (dk-apply! e2 z)))
                               ((bst-pick-or! orf)
                                 (lambda () (apply bst-ineq! (append (list (cadr orf) h1) prem)))
                                 (lambda () (apply bst-ineq! (append (list (caddr orf) h2) prem))))))))))))))))
  ;; local: step 1 at p, on the open set where g > f - e near p
  (lambda (p)
    (let* ((gp (dk-skolem! (bst-fact! 'bsw-sw-step1 't 'aa 'f p 'e))))
      (bst-ucl-open! gp)
      (bst-rval! gp p)
      (bst-rval! 'f p)
      (let ((d (dk-halve! 'e)))
        (bst-local-two! gp p d bst-pp2
          (lambda (uu body!)
            (ew gp)
            (dk-conj-close!
              (lambda ()
                (let ((gl (dk-goal)))
                  (if (and (dk-head-is? gl 'FORALL) (dk-contains? gl 'INTERSECTION))
                      (let* ((z (dk-di-var!)) (bs (body! z)) (b1 (car bs)) (b2 (cadr bs))
                             (x1 (cadr (cadr b1))) (x2 (cadr (cadr b2))))
                        (bst-rval! gp z) (bst-rval! 'f z)
                        (bst-abs-parts! x1 d) (bst-abs-parts! x2 d)
                        (dk-ineq! (list '< (list '- d) x1) (list '< x1 d) (list '< (list '- d) x2) (list '< x2 d)
                                  (list '= (list '+ d d) 'e) (list '= (list gp p) (list 'f p))
                                  (list 'IN (list gp p) 'RR) (list 'IN (list gp z) 'RR) (list 'IN (list 'f p) 'RR)
                                  (list 'IN (list 'f z) 'RR) (list 'IN d 'RR)))
                      (bst-ass!))))))))))))
(let* ((g (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'sg_))) "the step-2 witness")))
       (cls (filter (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h g))) (dk-asms))))
  (ew g)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((z (dk-di-var!)))
            (for-each (lambda (c) (dk-apply! c z)) cls)
            (bst-close-ctx!))
          (bst-ass!)))))
(bst-qed! 'bsw-sw-step2)

;;; ---- STONE-WEIERSTRASS (real) ---------------------------------------------------------------
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f
   (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN f (RCONT t))
     '(FORALL e (IMPLIES (POS-RR e) (FORSOME sg_ (AND (IN sg_ aa)
        (FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (< (abs (- (f rz_) (sg_ rz_))) e))))))))))))))))
(define bst-swp (dk-peel!))
(define bst-swe (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) bst-swp))))
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(dk-cite! 'bsw-rcont-set 't)
(bst-sa-parts!)
(dk-pos-parts! bst-swe)
(let* ((d (dk-halve! bst-swe))
       (g (dk-skolem! (bst-fact! 'bsw-sw-step2 't 'aa 'f d)))
       (gcl (bst-wcl g '(PTS t)))
       (gap (bst-ucl-open! g))
       (k (dk-skolem! (dk-apply! gap d)))
       (kcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rsy_) (dk-contains? x k))) "g ~ k")))
  (bst-sub-mem! 'aa '(RCONT t) k)
  (ew k)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((y (dk-di-var!)) (gy (dk-apply! gcl y)) (ky (dk-apply! kcl y)))
            (dk-split-all! (list gy))
            (bst-rval! 'f y) (bst-rval! g y) (bst-rval! k y)
            (let ((x2 (cadr (cadr ky))))
              (bst-abs-parts! x2 d)
              (bst-abs-lt-goal! (list '- (list 'f y) (list k y)) bst-swe
                (cadr gy) (caddr gy) (list '< (list '- d) x2) (list '< x2 d) (list '= (list '+ d d) bst-swe)
                (list 'IN (list 'f y) 'RR) (list 'IN (list g y) 'RR) (list 'IN (list k y) 'RR) (list 'IN d 'RR))))
          (bst-ass!)))))
(bst-qed! 'bsw-stone-weierstrass-real)

;; the same as a density statement: every continuous real function is in the uniform closure of aa
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f
   (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-S (list 'IMPLIES bst-sep (list 'IMPLIES '(IN f (RCONT t))
     (list 'IN 'f bst-ucl))))))))))
(dk-peel!)
(bst-split-cite! 'bsw-rcont-parts 't 'f)
(dk-cite! 'bsw-rcont-set 't)
(define bst-swa (bst-fact! 'bsw-stone-weierstrass-real 't 'aa 'f))
(bst-ucl-in! 'f (lambda () (bst-ass!))
  (lambda (e) (dk-apply! bst-swa e) (bst-ass!)))
(bst-qed! 'bsw-stone-weierstrass-real-dense)

;;; ================================================================================================
;;; STONE-WEIERSTRASS (complex).  aa a unital self-adjoint subalgebra of C(t) separating points:
;;; its real members (aR, below) form a real subalgebra separating points (|g - g(q)|^2 separates p
;;; from q), so the real theorem approximates Re f and Im f, and u + v i is in aa.
;;; ================================================================================================
(define (bst-cloc f)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t))
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u)
        (list 'FORALL 'q (list 'IMPLIES '(IN q u) (list '< (list 'magnitude (list '- (list f 'p) (list f 'q))) 'eps)))))))))))
(define bst-chom '(IS-HOM-TOP-SPACE t (METRIC-TOP CC-MS) f))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'f (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES '(IN f (FUN (PTS t) CC))
   (list 'IMPLIES bst-chom (bst-cloc 'f))))))))
(define bst-cpe (dk-peel!))
(dk-cite! 'cc-is-metric-space)
(define bst-cdl (dk-cite! 'bsw-cont-local 't 'CC-MS 'f))
(let* ((pe bst-cpe)
       (p (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS t)))) pe))))
       (e (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) pe))))
       (u (dk-skolem! (dk-apply! bst-cdl p e)))
       (ucl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the u clause")))
  (ew u)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((q (dk-di-var!)))
            (dk-cite! 'top-open-subset 't u)
            (dk-cite! 'subset-mem-fwd u '(PTS t) q)
            (dk-apply! ucl q)
            (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC p)
            (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC q)
            (dk-cite! 'cc-ms-dist (list 'f p) (list 'f q))
            (dk-rewrite-h! (list '< (list '(DIST CC-MS) (list 'f p) (list 'f q)) e)
                           (list '(DIST CC-MS) (list 'f p) (list 'f q)) (list 'magnitude (list '- (list 'f p) (list 'f q))))
            (bst-ass!))
          (bst-ass!)))))
(bst-qed! 'bsw-cc-elim)

;; a real function whose values are those of a continuous complex function is continuous
(bst-ptw-sp! '(t g h) '((IS-TOP-SPACE t) (IN g (FUN (PTS t) CC)) (IS-HOM-TOP-SPACE t (METRIC-TOP CC-MS) g)) '(g rz_))
(bst-ptw-drive! (lambda () #t)
  (lambda (p e eqh)
    (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'bsw-cc-elim 't 'g) p e)))
           (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the u clause")))
      (ew u)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((q (dk-di-var!)))
                (dk-cite! 'top-open-subset 't u)
                (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                (let* ((b (dk-apply! c1 q)))
                  (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'RR p) (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'RR q)
                  (dk-apply! eqh p) (dk-apply! eqh q)
                  (let* ((b1 (dk-rewrite-h! b (list 'g p) (list 'h p)))
                         (b2 (dk-rewrite-h! b1 (list 'g q) (list 'h q)))
                         (hdx (list '- (list 'h p) (list 'h q))))
                    (dk-real! hdx)
                    (dk-cite! 'rr-magnitude-is-abs hdx)
                    (dk-rewrite-h! b2 (list 'magnitude hdx) (list 'abs hdx))
                    (bst-ass!))))
              (bst-ass!)))))))
(bst-qed! 'bsw-rcont-of-cc)

;; the real and imaginary parts of a continuous complex function are continuous
(define (bst-part-lemma! part dl-lemma in-lemma)
  (bst-ptw-sp! '(t f h) '((IS-TOP-SPACE t) (IN f (FUN (PTS t) CC)) (IS-HOM-TOP-SPACE t (METRIC-TOP CC-MS) f)) (list part '(f rz_)))
  (bst-ptw-drive! (lambda () #t)
    (lambda (p e eqh)
      (let* ((u (dk-skolem! (dk-apply! (dk-cite! 'bsw-cc-elim 't 'f) p e)))
             (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the u clause")))
        (dk-pos-parts! e)
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'top-open-subset 't u)
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (let* ((b (dk-apply! c1 q)))
                    (bst-at-pq! eqh p q '())
                    (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC p) (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC q)
                    (let* ((rp (list part (list 'f p))) (rq (list part (list 'f q)))
                           (pdx (list '- rp rq)) (D (list '- (list 'f p) (list 'f q)))
                           (dl (dk-cite! dl-lemma (list 'f p) (list 'f q))))
                      (dk-cite! in-lemma (list 'f p)) (dk-cite! in-lemma (list 'f q))
                      (bst-real-abs! pdx)
                      (dk-type! D 'CC)
                      (dk-cite! 'cc-magnitude-closed D)
                      (dk-ineq! b dl (list 'IN (list 'abs pdx) 'RR) (list 'IN (list 'magnitude D) 'RR) (list 'IN e 'RR)))))
                (bst-ass!))))))))
(bst-part-lemma! 'real-part 'cc-re-dist-le 'real-part-in-rr)
(bst-qed! 'bsw-rcont-re)
(bst-part-lemma! 'imag-part 'cc-im-dist-le 'imag-part-in-rr)
(bst-qed! 'bsw-rcont-im)

;;; ---- the self-adjoint subalgebra, read pointwise --------------------------------------------
(define bst-CS '(IS-CCONT-STAR-SUBALGEBRA t aa))
(define (bst-cs-parts!) (bst-rhs! (dk-cite! 'is-ccont-star-subalgebra 't 'aa)))
(define (bst-cs-clause key)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL)
                            (case key
                              ((mem) (and (eq? (cadr h) 'csf_) (dk-contains? h 'IS-HOM-TOP-SPACE)))
                              ((const) (eq? (cadr h) 'csc_))
                              ((add) (and (eq? (cadr h) 'csf_) (dk-contains? h '+)))
                              ((conj) (and (eq? (cadr h) 'csf_) (dk-contains? h 'conjugate)))
                              (else (and (eq? (cadr h) 'csf_) (dk-contains? h '*))))))
           "a self-adjoint subalgebra clause"))
(define (bst-cmem! f)                 ; f in aa: land f in FUN(PTS t, CC) and its continuity
  (if (not (dk-asm? (list 'IN f '(FUN (PTS t) CC))))
      (dk-split-all! (list (dk-apply! (bst-cs-clause 'mem) f)))))
(define (bst-cval! f z) (bst-cmem! f) (dk-cite! 'fun-apply-type-c f '(PTS t) 'CC z))

(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'c (list 'IMPLIES bst-CS (list 'IMPLIES '(IN c CC) (bst-ex 'c))))))))
(dk-peel!)
(bst-cs-parts!)
(dk-apply! (bst-cs-clause 'const) 'c)
(bst-ex-close! '(VNB-LAMBDA rsz_ (PTS t) c) (lambda (z) #t))
(bst-qed! 'bsw-cs-const)

(define (bst-cs-binop! key op)
  (sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f (list 'FORALL 'g
        (list 'IMPLIES bst-CS (list 'IMPLIES '(IN f aa) (list 'IMPLIES '(IN g aa) (bst-ex (list op '(f rz_) '(g rz_))))))))))))
  (dk-peel!)
  (bst-cs-parts!)
  (dk-apply! (bst-cs-clause key) 'f 'g)
  (bst-ex-close! (list 'VNB-LAMBDA 'rsz_ '(PTS t) (list op '(f rsz_) '(g rsz_)))
                 (lambda (z) (bst-cval! 'f z) (bst-cval! 'g z))))
(bst-cs-binop! 'add '+)
(bst-qed! 'bsw-cs-add)
(bst-cs-binop! 'mul '*)
(bst-qed! 'bsw-cs-mul)

(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f
   (list 'IMPLIES bst-CS (list 'IMPLIES '(IN f aa) (bst-ex '(conjugate (f rz_))))))))))
(dk-peel!)
(bst-cs-parts!)
(dk-apply! (bst-cs-clause 'conj) 'f)
(bst-ex-close! '(VNB-LAMBDA rsz_ (PTS t) (conjugate (f rsz_)))
               (lambda (z) (bst-cval! 'f z) (dk-cite! 'cc-conjugate-closed (list 'f z))))
(bst-qed! 'bsw-cs-conj)

;;; ---- aR: the real functions with a complex twin in aa ----------------------------------------
(define bst-aR '(SEP rh_ (RCONT t) (FORSOME cg_ (AND (IN cg_ aa) (FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (rh_ rz_) (cg_ rz_))))))))
;; goal (IN L aR) for a lambda L on PTS t: KR = (k . k's value clause), TY! (z) lands (IN (L z's body) RR),
;; VAL! (z) rewrites the goal (= body (k's value)) to an identity
(define (bst-ar-in! L kr ty! val!)
  (let ((k (car kr)))
    (bst-cmem! k)
    (dk-have! (list 'IN L '(FUN (PTS t) RR))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (ty! z) (bst-ass!))))))
    (let ((ptw (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= (list L 'rz_) (list k 'rz_))))))
      (dk-have! ptw
        (lambda ()
          (let ((z (dk-di-var!)))
            (ty! z) (bst-cval! k z)
            (dk-lam-b!)
            (subst (dk-apply! (cdr kr) z))
            (dk-close-if! (lambda () (val! z)) rfl))))
      (bst-fact! 'bsw-rcont-of-cc 't k L)
      (in-sep! (lambda () (bst-ass!)) (lambda () (ew k) (bst-close-ctx!))))))
;; (IN f aR) in context: land (IN f (RCONT t)); return (cf . its clause (FORALL rz_ .. (= (f rz_) (cf rz_))))
(define (bst-ar-open! f)
  (dk-project! (list 'IN f '(RCONT t)) (lambda () (sep-me (list 'IN f bst-aR))))
  (sep-me (list 'IN f bst-aR)) (dk-split-all!)
  (let* ((cf (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cg_) (dk-contains? h f))) "the twin"))))
    (bst-cmem! cf)
    (cons cf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rz_) (dk-contains? h f) (dk-contains? h cf))) "the twin clause"))))

(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bst-CS
   (list 'IS-RCONT-SUBALGEBRA 't bst-aR)))))))
(dk-peel!)
(bst-cs-parts!)
(dk-cite! 'bsw-rcont-set 't)
(bst-rhs! (dk-cite! 'is-top-space 't))
(bst-lhs! (dk-cite! 'is-rcont-subalgebra 't bst-aR)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (let ((gl (dk-goal)))
          (cond ((dk-asm? gl) (ass))
                ((dk-head-is? gl 'SUBSET)
                 (mac 'subset-def)
                 (let ((z (dk-di-var!)))
                   (sep-me (list 'IN z bst-aR)) (dk-split-all!) (bst-ass!)))
                ((eq? (cadr gl) 'rsc_)
                 (let* ((c (dk-di-var!)))
                   (dk-cite! 'rr-subset-cc c)
                   (bst-ar-in! (list 'VNB-LAMBDA 'rsz_ '(PTS t) c) (bst-skolem-ex! (bst-fact! 'bsw-cs-const 't 'aa c))
                               (lambda (z) #t) (lambda (z) #t))))
                (#t
                 (let* ((op (if (dk-contains? gl '+) '+ '*))
                        (pe (dk-peel!))
                        (fs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) bst-aR))) pe)))
                        (f (car fs)) (g (cadr fs))
                        (rf (bst-ar-open! f)) (rg (bst-ar-open! g))
                        (kr (bst-skolem-ex! (bst-fact! (if (eq? op '+) 'bsw-cs-add 'bsw-cs-mul) 't 'aa (car rf) (car rg)))))
                   (bst-ar-in! (list 'VNB-LAMBDA 'rsz_ '(PTS t) (list op (list f 'rsz_) (list g 'rsz_))) kr
                     (lambda (z) (bst-rval! f z) (bst-rval! g z) (dk-real! (list op (list f z) (list g z))))
                     (lambda (z) (bst-cval! (car rf) z) (bst-cval! (car rg) z)
                                 (subst (dk-apply! (cdr rf) z)) (subst (dk-apply! (cdr rg) z))))))))))))
(bst-qed! 'bsw-cs-real-sa)

;; aR separates points: for g in aa with g(p) /= g(q), |g - g(q)|^2 is real, in aR, 0 at q and not at p
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bst-CS (list 'IMPLIES '(IS-POINT-SEPARATING t aa)
   (list 'IS-POINT-SEPARATING 't bst-aR))))))))
(dk-peel!)
(bst-cs-parts!)
(dk-cite! 'bsw-rcont-set 't)
(bst-rhs! (dk-cite! 'is-top-space 't))
(bst-rhs! (dk-cite! 'is-point-separating 't 'aa))
(define bst-csep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'rsp_))) "separation by aa"))
(bst-lhs! (dk-cite! 'is-point-separating 't bst-aR)
  (lambda ()
    (dk-peel!)
    (let* ((notf (caddr (caddr (dk-goal))))
           (P (cadr (cadr (cadr notf)))) (Q (cadr (caddr (cadr notf))))
           (g (dk-skolem! (dk-apply! bst-csep P Q)))
           (gP (list g P)) (gQ (list g Q))
           (nc (list '- gQ)))
      (bst-cval! g P) (bst-cval! g Q)
      (dk-type! nc 'CC)
      (let* ((kc (bst-skolem-ex! (bst-fact! 'bsw-cs-const 't 'aa nc)))
             (k1 (bst-skolem-ex! (bst-fact! 'bsw-cs-add 't 'aa g (car kc))))
             (k2 (bst-skolem-ex! (bst-fact! 'bsw-cs-conj 't 'aa (car k1))))
             (k3 (bst-skolem-ex! (bst-fact! 'bsw-cs-mul 't 'aa (car k1) (car k2))))
             (X (lambda (z) (list '+ (list g z) nc)))
             (body (lambda (z) (list '* (X z) (list 'conjugate (X z)))))
             (ty! (lambda (z) (bst-cval! g z) (dk-type! (X z) 'CC) (dk-cite! 'cc-self-conj-real (X z))))
             (hGv (dk-abstract! '(PTS t) 'RR body (lambda (k) (ty! k) (bst-ass!))))
             (hG (car hGv)) (ve (cdr hGv)))
        (bst-cmem! (car k3))
        (dk-have! (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= (list hG 'rz_) (list (car k3) 'rz_))))
          (lambda ()
            (let ((z (dk-di-var!)))
              (ty! z)
              (subst (dk-apply! ve z))
              (for-each (lambda (r) (subst (dk-apply! (cdr r) z))) (list k3 k2 k1))
              (dk-close-if! (lambda () (subst (dk-apply! (cdr kc) z))) rfl))))
        (bst-fact! 'bsw-rcont-of-cc 't (car k3) hG)
        (dk-have! (list 'IN hG bst-aR) (lambda () (in-sep! (lambda () (bst-ass!)) (lambda () (ew (car k3)) (bst-close-ctx!)))))
        (let* ((vP (dk-apply! ve P)) (vQ (dk-apply! ve Q)) (XP (X P)) (XQ (X Q)))
          (dk-have! (list '= XQ 0) (lambda () (crs)))
          (dk-have! (list '= (list hG Q) 0) (lambda () (subst vQ) (subst (list '= XQ 0)) (crs)))
          (ew hG)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'NOT)
                  (begin
                    (di)
                    (dk-have! (list '= (body P) 0)
                      (lambda () (subst (list '= (body P) (list hG P))) (subst (list '= (list hG P) (list hG Q))) (bst-ass!)))
                    (dk-type! XP 'CC)
                    (bst-fact! 'cc-zero-of-self-conj-zero XP)
                    (dk-have! (list '= gP gQ)
                      (lambda ()
                        (dk-have! (list '= gP (list '+ XP gQ)) (lambda () (crs)))
                        (subst (list '= gP (list '+ XP gQ)))
                        (subst (list '= XP 0))
                        (crs)))
                    (ai (list 'NOT (list '= gP gQ))))
                  (bst-ass!)))))))))
(bst-qed! 'bsw-cs-real-sep)

;;; ---- STONE-WEIERSTRASS (complex) ------------------------------------------------------------
(sp (make-wff (list 'FORALL 't (list 'FORALL 'aa (list 'FORALL 'f
   (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bst-CS (list 'IMPLIES '(IS-POINT-SEPARATING t aa)
   (list 'IMPLIES '(IN f (FUN (PTS t) CC)) (list 'IMPLIES bst-chom
     '(FORALL e (IMPLIES (POS-RR e) (FORSOME sg_ (AND (IN sg_ aa)
        (FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (< (magnitude (- (f rz_) (sg_ rz_))) e)))))))))))))))))
(define bst-cwp (dk-peel!))
(define bst-cwe (cadr (car (filter (lambda (h) (dk-head-is? h 'POS-RR)) bst-cwp))))
(bst-rhs! (dk-cite! 'is-compact-t 't))
(bst-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'bsw-rcont-set 't)
(bst-cs-parts!)
(bst-fact! 'bsw-cs-real-sa 't 'aa)
(bst-fact! 'bsw-cs-real-sep 't 'aa)
(dk-pos-parts! bst-cwe)
(let* ((d (dk-halve! bst-cwe))
       (fz (lambda (z) (list 'f z)))
       (ty-re (lambda (z) (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC z) (dk-cite! 'real-part-in-rr (fz z))))
       (ty-im (lambda (z) (dk-cite! 'fun-apply-type-c 'f '(PTS t) 'CC z) (dk-cite! 'imag-part-in-rr (fz z))))
       (u0 (bst-mkfun! (lambda (z) (list 'real-part (fz z))) ty-re))
       (v0 (bst-mkfun! (lambda (z) (list 'imag-part (fz z))) ty-im)))
  (bst-fact! 'bsw-rcont-re 't 'f (car u0))
  (bst-fact! 'bsw-rcont-im 't 'f (car v0))
  (let* ((swu (bst-fact! 'bsw-stone-weierstrass-real 't bst-aR (car u0)))
         (u1 (dk-skolem! (dk-apply! swu d)))
         (u1cl (bst-wcl u1 '(PTS t)))
         (swv (bst-fact! 'bsw-stone-weierstrass-real 't bst-aR (car v0)))
         (v1 (dk-skolem! (dk-apply! swv d)))
         (v1cl (bst-wcl v1 '(PTS t)))
         (ru (bst-ar-open! u1))
         (rv (bst-ar-open! v1))
         (kc (bst-skolem-ex! (bst-fact! 'bsw-cs-const 't 'aa '+i)))
         (M (bst-skolem-ex! (bst-fact! 'bsw-cs-mul 't 'aa (car rv) (car kc))))
         (gr (bst-skolem-ex! (bst-fact! 'bsw-cs-add 't 'aa (car ru) (car M)))))
    (ew (car gr))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let* ((z (dk-di-var!))
                   (uz (list u1 z)) (vz (list v1 z)) (u0z (list (car u0) z)) (v0z (list (car v0) z))
                   (Gz (list '+ uz (list '* vz '+i))))
              (for-each (lambda (r) (subst (dk-apply! (cdr r) z))) (list gr M kc))
              (for-each (lambda (r) (let ((e (dk-apply! (cdr r) z))) (subst (list '= (caddr e) (cadr e))))) (list ru rv))
              (dk-apply! (cdr u0) z) (dk-apply! (cdr v0) z)
              (bst-rval! u1 z) (bst-rval! v1 z)
              (ty-re z) (ty-im z)
              (bst-rval! (car u0) z) (bst-rval! (car v0) z)
              (dk-type! Gz 'CC)
              (dk-have! (list '= Gz Gz) (lambda () (rfl)))
              (dk-split-all! (list (bst-fact! 'cc-re-im-of Gz uz vz)))
              (let* ((cl (dk-cite! 'cc-dist-le-coords (fz z) Gz))
                     (c1 (dk-rewrite-h! cl (list 'real-part Gz) uz))
                     (c2 (dk-rewrite-h! c1 (list 'imag-part Gz) vz))
                     (c3 (dk-rewrite-h! c2 (list 'real-part (fz z)) u0z))
                     (c4 (dk-rewrite-h! c3 (list 'imag-part (fz z)) v0z))
                     (bu (dk-apply! u1cl z)) (bv (dk-apply! v1cl z))
                     (X1 (list '- u0z uz)) (X2 (list '- v0z vz)) (dif (list '- (fz z) Gz)))
                (bst-real-abs! X1) (bst-real-abs! X2)
                (dk-type! dif 'CC)
                (dk-cite! 'cc-magnitude-closed dif)
                (dk-ineq! c4 bu bv (list '= (list '+ d d) bst-cwe)
                          (list 'IN (list 'abs X1) 'RR) (list 'IN (list 'abs X2) 'RR) (list 'IN (list 'magnitude dif) 'RR) (list 'IN d 'RR))))
            (bst-ass!))))))
(bst-qed! 'bsw-stone-weierstrass-complex)
