;;; calint-regulated-step.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/calint/calint-regulated-step.scm.
;;; Library: analysis.

;;; calint-regulated-step.scm -- calculus.pdf Prop 4.5 as the notes state it:
;;; f : [a,b] -> R is regulated iff it is the uniform limit of step functions.
;;;
;;; The necessity half is `regulated-on-is-step-limit' (regulated-step-approx.scm).
;;; The sufficiency half existed only for TOTAL functions (`uniform-limit-of-regulated',
;;; IS-REGULATED of a member of FUN(RR,RR)).  This file supplies what joins them:
;;;   (1) a function constant on (u,v) is regulated on [u,v]  (its restriction);
;;;   (2) a step function is regulated on [a,b], by induction on the pieces and
;;;       `regulated-on-glue' -- the induction of `step-fn-has-primitive-ind';
;;;   (3) the two conversions between IS-REGULATED-ON (limits WITHIN [a,b], strict)
;;;       and IS-REGULATED (total, non-strict), one in each direction;
;;;   (4) the headline.
;;; Library: analysis.  Load window: after road-juxtaposition-laws (regulated-on-glue)
;;; and uniform-limit-regulated / regulated-step-approx.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (cir-head g) (and (pair? g) (car g)))
(define (cir-find pred lst what)
  (let ((r (filter pred lst)))
    (if (null? r) (error "cir-find: nothing matching" what) (car r))))
(define (cir-conj-ineq! prems)
  (dk-conj-close!
   (lambda ()
     (if (dk-ctx-form (dk-goal))
         (ass)
         (apply dk-ineq! prems)))))
(define (cir-in-ccint! z lo hi prems)
  (dk-have! (list 'IN z (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership) (cir-conj-ineq! prems))))
(define (cir-ccint-parts! z lo hi)
  (fact 'ccint-elt-in-rr lo hi z)
  (dk-have! (list '<= lo z)
    (lambda () (dk-split! (dk-fact! 'ccint-parts lo hi z)) (ass)))
  (dk-have! (list '<= z hi)
    (lambda () (dk-split! (dk-fact! 'ccint-parts lo hi z)) (ass))))

;;; =====================================================================
;;; (1) ONE PIECE
;;; =====================================================================
(sp (make-wff '(FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR)
   (IMPLIES (< u v)
     (FORALL f (IMPLIES (IN f (FUN RR RR))
       (FORALL cv (IMPLIES (IN cv RR)
         (IMPLIES (FORALL t_ (IMPLIES (AND (IN t_ RR) (AND (< u t_) (< t_ v))) (= (f t_) cv)))
           (IS-REGULATED-ON (RESTRICT f (CCINT u v)) u v)))))))))))))
(dk-peel!)
(define cir-cp-const
  (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm 'cv)))
           "the constancy of f on the open piece"))
(define cir-cp-r '(RESTRICT f (CCINT u v)))
(fact 'ccint-subset-rr 'u 'v)
(fact 'restrict-in-fun 'f 'RR 'RR '(CCINT u v))
(mac 'IS-REGULATED-ON)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (if (not (eq? (cir-head g) 'FORALL))
         (ass)
         (let* ((right? (dk-contains? g 'IS-RIGHT-LIMIT-WITHIN))
                (x (dk-di-var!)))
           (dk-peel!)
           (cir-ccint-parts! x 'u 'v)
           (ew 'cv)
           (mac (if right? 'IS-RIGHT-LIMIT-WITHIN 'IS-LEFT-LIMIT-WITHIN))
           (dk-conj-close!
            (lambda ()
              (let ((g2 (dk-goal)))
                (if (not (eq? (cir-head g2) 'FORALL))
                    (ass)
                    (let* ((pe (dk-peel!))
                           (e (cadr (cir-find (dk-head? 'POS-RR) pe "eps")))
                           (d (if right? (list '- 'v x) (list '- x 'u))))
                      (fact 'rr-sub-in-rr (if right? 'v x) (if right? x 'u))
                      (dk-have! (list '< 0 d)
                        (lambda () (dk-ineq! (list 'IN 'u 'RR) (list 'IN 'v 'RR) (list 'IN x 'RR)
                                             (if right? (list '< x 'v) (list '< 'u x)))))
                      (fact 'rr-pos-rr-of-lt d)
                      (fact 'rr-lt-of-pos-rr e)
                      (ew d)
                      (dk-conj-close!
                       (lambda ()
                         (if (not (eq? (cir-head (dk-goal)) 'FORALL))
                             (ass)
                             (begin
                               (dk-peel!)
                               (let* ((gl (dk-goal))           ; (< (ABS (- (R t) cv)) e)
                                      (t (cadr (cadr (cadr (cadr gl))))))
                                 (cir-ccint-parts! t 'u 'v)
                                 (have! (list 'AND (list 'IN t 'RR) (list 'AND (list '< 'u t) (list '< t 'v)))
                                   (lambda ()
                                     (cir-conj-ineq!
                                      (append (list (list 'IN 'u 'RR) (list 'IN 'v 'RR) (list 'IN x 'RR)
                                                    (list 'IN t 'RR) (list '<= 'u x) (list '<= x 'v))
                                              (if right?
                                                  (list (list '< x t) (list '< t (list '+ x d)))
                                                  (list (list '< (list '- x d) t) (list '< t x)))))))
                                 (dk-apply! cir-cp-const t)
                                 (fact 'restrict-apply 'f '(CCINT u v) t)
                                 (subst (list '== (list cir-cp-r t) (list 'f t)))
                                 (subst (list '= (list 'f t) 'cv))
                                 (dk-have! '(= (- cv cv) 0) (lambda () (crs)))
                                 (subst '(= (- cv cv) 0))
                                 (fact 'rr-abs-zero-value)
                                 (subst '(= (ABS 0) 0))
                                 (ass))))))))))))))))
(qed 'constant-piece-regulated-on)

;;; =====================================================================
;;; (2) A STEP FUNCTION IS REGULATED ON [a,b], by induction on the number of pieces
;;; (the same p read as a partition of [a, p(n)] with one piece fewer, as in
;;; step-fn-has-primitive-ind), glued by `regulated-on-glue'.
;;; =====================================================================
(define (cir-steps-of pp nn ff)
  (list 'FORALL 'i_
    (list 'IMPLIES (list 'AND (list 'IN 'i_ (list 'INTERVAL 0 nn)) (list '< 'i_ nn))
      (list 'FORSOME 'c_
        (list 'AND '(IN c_ RR)
          (list 'FORALL 't_
            (list 'IMPLIES
              (list 'AND '(IN t_ RR) (list 'AND (list '< (list pp 'i_) 't_)
                                                (list '< 't_ (list pp '(SUCC i_)))))
              (list '= (list ff 't_) 'c_))))))))
(define (cir-body-of nn)
  (list 'FORALL 'p (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'f
    (list 'IMPLIES '(IN f (FUN RR RR))
      (list 'IMPLIES (list 'IS-PARTITION 'p nn 'a 'b)
        (list 'IMPLIES (cir-steps-of 'p nn 'f)
          '(IS-REGULATED-ON (RESTRICT f (CCINT a b)) a b)))))))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (cir-body-of 'n)))))
(let* ((leaves (dk-opened (lambda () (ni))))
       (step? (lambda (s)
                (let ((g (dk-goal-of s)))
                  (and (pair? g) (eq? (car g) 'FORALL)
                       (let ((b (caddr g)))
                         (and (pair? b) (eq? (car b) 'IMPLIES)
                              (pair? (cadr b)) (eq? (car (cadr b)) 'IN)
                              (eq? (caddr (cadr b)) 'NN)))))))
       (base (cir-find (lambda (s) (not (step? s))) leaves "the base leaf"))
       (stp  (cir-find step? leaves "the step leaf")))
  ;; ---- BASE: no partition has 0 pieces.
  (dk-focus! base)
  (let* ((landed (dk-peel!))
         (part (cir-find (dk-head? 'IS-PARTITION) landed "the partition")))
    (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part))))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (fact 'rr-lt-not-le 0 1)
    (ai '(NOT (<= 1 0))))
  ;; ---- STEP
  (dk-focus! stp)
  (let* ((landed (dk-peel!))
         (part (cir-find (dk-head? 'IS-PARTITION) landed "the partition"))
         (pp (list-ref part 1))
         (sn (list-ref part 2))
         (nv (cadr sn))
         (aa (list-ref part 3))
         (bb (list-ref part 4))
         (ff (cadr (cir-find (lambda (fm) (and ((dk-head? 'IN) fm)
                                               (equal? (caddr fm) '(FUN RR RR))))
                             landed "the typing of f")))
         (ih (cir-find (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                         (dk-contains? fm 'IS-PARTITION)))
                       landed "the induction hypothesis"))
         (steps (cir-find (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                            (dk-contains? fm 'INTERVAL)))
                          landed "the step-function clause"))
         (pn  (list pp nv))
         (psn (list pp sn))
         (isn (list 'INTERVAL 0 sn)))
    (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part))))
    (let ((incr (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                           (pair? (caddr fm)) (eq? (car (caddr fm)) 'FORALL)))
                         "the monotonicity of the partition")))
      (fact 'nn-in-rr nv)
      (fact 'nn-in-rr sn)
      (fact 'nn-zero-in)
      (fact 'nn-zero-le nv)
      (fact 'nn-zero-le sn)
      (fact 'nn-le-succ nv)
      (fact 'rr-leq-reflexive sn)
      (fact 'bt-lt-succ nv)
      (fact 'interval-mem-intro 0 sn nv)
      (fact 'interval-mem-intro 0 sn sn)
      (fact 'fun-apply-type-c pp 'NN 'RR nv)
      (fact 'fun-apply-type-c pp 'NN 'RR sn)
      (fact 'rr-is-set)
      ;; the last piece, (p(n), p(succ n)), and its constant
      (have! (list 'AND (list 'IN nv isn) (list '< nv sn)))
      (let* ((cn (dk-skolem! (dk-apply! steps nv)))
             (kn (begin (dk-split-all!)
                        (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm cn)))
                                 "the constancy on the last piece"))))
        (have! (list 'AND (list 'IN nv isn) (list 'AND (list 'IN sn isn) (list '< nv sn))))
        (dk-apply! incr nv sn)
        (subst (list '= bb psn))
        (fact 'nn-zero-or-succ nv)
        (use-cases (list 'OR (list '= nv 0)
                         (list 'FORSOME 'q (list 'AND '(IN q NN) (list '= nv '(SUCC q)))))
          ;; ---- ONE PIECE
          (lambda ()
            (dk-have! (list '= pn aa) (lambda () (subst (list '= nv 0)) (ass)))
            (subst (list '= aa pn))
            (let ((u1 (dk-fact! 'constant-piece-regulated-on pn psn)))
              (dk-apply! u1 ff cn)
              (ass)))
          ;; ---- n >= 1: glue
          (lambda ()
            (let ((q (dk-skolem! (cir-find (dk-head? 'FORSOME) (dk-asms) "n = succ(q)"))))
              (dk-have! (list '<= 1 nv)
                (lambda () (subst (list '= nv (list 'SUCC q))) (fact 'nn-one-le-succ q) (ass))))
            (dk-have! (list '< 0 nv) (lambda () (dk-ineq! (list 'IN nv 'RR) (list '<= 1 nv))))
            (fact 'nn-zero-le 0)
            (fact 'interval-mem-intro 0 sn 0)
            (have! (list 'AND (list 'IN 0 isn) (list 'AND (list 'IN nv isn) (list '< 0 nv)))
                   (lambda () (dk-conj-close! (lambda () (ass)))))
            (dk-apply! incr 0 nv)
            (dk-have! (list '< aa pn) (lambda () (subst (list '= aa (list pp 0))) (ass)))
            (dk-have! (list '<= aa pn) (lambda () (dk-ineq! (list 'IN aa 'RR) (list 'IN pn 'RR) (list '< aa pn))))
            (dk-have! (list '<= pn psn) (lambda () (dk-ineq! (list 'IN pn 'RR) (list 'IN psn 'RR) (list '< pn psn))))
            (dk-have! (list '< aa psn) (lambda () (dk-ineq! (list 'IN aa 'RR) (list 'IN pn 'RR) (list 'IN psn 'RR) (list '< aa pn) (list '< pn psn))))
            (dk-have! (list 'IS-PARTITION pp nv aa pn)
              (lambda ()
                (mac 'IS-PARTITION)
                (dk-conj-close!
                 (lambda ()
                   (let ((g (dk-goal)))
                     (cond ((eq? (cir-head g) 'FORALL)
                            (dk-peel!)
                            (dk-split-all!)
                            (let* ((gl (dk-goal)) (iv (cadr (cadr gl))) (jv (cadr (caddr gl))))
                              (fact 'interval-widen nv sn 0 iv)
                              (fact 'interval-widen nv sn 0 jv)
                              (have! (list 'AND (list 'IN iv isn) (list 'AND (list 'IN jv isn) (list '< iv jv))))
                              (dk-apply! incr iv jv)
                              (ass)))
                           ((and (eq? (cir-head g) '=) (equal? (cadr g) (caddr g))) (rfl))
                           (#t (ass))))))))
            (dk-have! (cir-steps-of pp nv ff)
              (lambda ()
                (dk-peel!)
                (dk-split-all!)
                (let ((iv (cir-find (lambda (fm) (and ((dk-head? 'IN) fm)
                                                       (equal? (caddr fm) (list 'INTERVAL 0 nv))))
                                    (dk-asms) "the index")))
                  (let ((iv (cadr iv)))
                    (fact 'interval-widen nv sn 0 iv)
                    (fact 'interval-elt-in-nn 0 nv iv)
                    (fact 'nn-in-rr iv)
                    (dk-have! (list '< iv sn)
                      (lambda () (dk-ineq! (list 'IN iv 'RR) (list 'IN nv 'RR) (list 'IN sn 'RR)
                                           (list '< iv nv) (list '< nv sn))))
                    (have! (list 'AND (list 'IN iv isn) (list '< iv sn)))
                    (dk-apply! steps iv)
                    (ass)))))
            ;; the induction hypothesis on [a, p(n)] and the last piece on [p(n), p(succ n)]
            (dk-apply! ih pp aa pn ff)
            (let ((u1 (dk-fact! 'constant-piece-regulated-on pn psn)))
              (dk-apply! u1 ff cn))
            (let* ((f1  (list 'RESTRICT ff (list 'CCINT aa pn)))
                   (f2  (list 'RESTRICT ff (list 'CCINT pn psn)))
                   (fab (list 'RESTRICT ff (list 'CCINT aa psn))))
              (fact 'ccint-subset-rr aa psn)
              (fact 'restrict-in-fun ff 'RR 'RR (list 'CCINT aa psn))
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'CCINT aa pn))
                          (list 'IMPLIES (list '< 't pn) (list '== (list fab 't) (list f1 't)))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (dk-peel!)
                    (cir-ccint-parts! z aa pn)
                    (cir-in-ccint! z aa psn (list (list 'IN z 'RR) (list '<= aa z) (list '<= z pn)
                                                  (list '<= pn psn)))
                    (fact 'restrict-apply ff (list 'CCINT aa psn) z)
                    (fact 'restrict-apply ff (list 'CCINT aa pn) z)
                    (subst (list '== (list fab z) (list ff z)))
                    (subst (list '== (list f1 z) (list ff z)))
                    (qrfl))))
              (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'CCINT pn psn))
                          (list 'IMPLIES (list '< pn 't) (list '== (list fab 't) (list f2 't)))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (dk-peel!)
                    (cir-ccint-parts! z pn psn)
                    (cir-in-ccint! z aa psn (list (list 'IN z 'RR) (list '<= aa pn) (list '<= pn z)
                                                  (list '<= z psn)))
                    (fact 'restrict-apply ff (list 'CCINT aa psn) z)
                    (fact 'restrict-apply ff (list 'CCINT pn psn) z)
                    (subst (list '== (list fab z) (list ff z)))
                    (subst (list '== (list f2 z) (list ff z)))
                    (qrfl))))
              (let ((u1 (dk-fact! 'regulated-on-glue aa pn psn)))
                (dk-apply! u1 f1 f2 fab))
              (ass))))))))
(qed 'step-fn-regulated-on-ind)

(sp (make-wff "forall([a in rr, b in rr, f], is-step-fn(f, a, b) implies
   is-regulated-on(restrict(f, ccint(a, b)), a, b))"))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-STEP-FN (cir-find (dk-head? 'IS-STEP-FN) (dk-asms) "the step function")))))
(let* ((n0 (dk-skolem! (cir-find (dk-head? 'FORSOME) (dk-asms) "the number of pieces")))
       (p0 (dk-skolem! (cir-find (dk-head? 'FORSOME) (dk-asms) "the partition"))))
  (dk-split-all!)
  (let ((part (cir-find (dk-head? 'IS-PARTITION) (dk-asms) "the partition")))
    (dk-have! (list 'IN n0 'NN)
      (lambda () (dk-split-all! (dk-landed* (lambda () (mac-h 'IS-PARTITION part)))) (ass)))
    (let ((body (dk-fact! 'step-fn-regulated-on-ind n0)))
      (dk-apply! body p0 'a 'b 'f)
      (ass))))
(qed 'step-fn-regulated-on)

;;; =====================================================================
;;; (3a) ON -> TOTAL.  h total, its restriction to [a,b] regulated on [a,b]:
;;; h is regulated in the total sense.  The total one-sided window is
;;; (x, x+d] (resp. [x-d, x)) with d half of min(delta, distance to the end),
;;; so it lies inside [a,b] and strictly inside the WITHIN window.
;;; =====================================================================
(define cir-ot-r '(RESTRICT h (CCINT a b)))

;;; focus: (IMPLIES (< x b) (FORSOME l_ (IS-RIGHT-LIMIT h x l_))) or the left mirror.
(define (cir-ot-side! x right?)
  (dk-peel!)
  (let* ((rc (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                        (dk-contains? fm (if right? 'IS-RIGHT-LIMIT-WITHIN
                                                             'IS-LEFT-LIMIT-WITHIN))))
                      "the WITHIN clause"))
         (l (dk-skolem! (dk-apply! rc x)))
         (lim (dk-pick (dk-head? (if right? 'IS-RIGHT-LIMIT-WITHIN 'IS-LEFT-LIMIT-WITHIN))
                       "the WITHIN limit")))
    (dk-split-all! (dk-landed* (lambda ()
      (mac-h (if right? 'IS-RIGHT-LIMIT-WITHIN 'IS-LEFT-LIMIT-WITHIN) lim))))
    (let ((ec (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm 'POS-RR)
                                         (dk-contains? fm l)))
                       "the eps clause of the WITHIN limit")))
      (ew l)
      (mac (if right? 'IS-RIGHT-LIMIT 'IS-LEFT-LIMIT))
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (cir-head (dk-goal)) 'FORALL))
             (ass)
             (let* ((pe (dk-peel!))
                    (e (cadr (cir-find (dk-head? 'POS-RR) pe "eps")))
                    (dd (dk-skolem! (dk-apply! ec e)))
                    (cl (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm dd)))
                                 "the delta clause"))
                    (gap (if right? (list '- 'b x) (list '- x 'a))))
               (fact 'rr-pos-rr-in-rr dd)
               (fact 'rr-lt-of-pos-rr dd)
               (fact 'rr-pos-rr-in-rr e)
               (fact 'rr-sub-in-rr (if right? 'b x) (if right? x 'a))
               (dk-have! (list '< 0 gap)
                 (lambda () (dk-ineq! (list 'IN 'a 'RR) (list 'IN 'b 'RR) (list 'IN x 'RR)
                                      (if right? (list '< x 'b) (list '< 'a x)))))
               (let ((w (dk-skolem! (dk-fact! 'rr-min-pos dd gap))))
                 (fact 'rr-pos-rr-of-lt w)
                 (let ((d (dk-halve! w)))
                   (ew d)
                   (dk-conj-close!
                    (lambda ()
                      (if (not (eq? (cir-head (dk-goal)) 'FORALL))
                          (ass)
                          (begin
                            (dk-peel!)
                            (dk-split-all!)
                            (let* ((gl (dk-goal))         ; (<= (ABS (- (h t) l)) e)
                                   (t (cadr (cadr (cadr (cadr gl)))))
                                   (prems (append
                                           (list (list 'IN 'a 'RR) (list 'IN 'b 'RR) (list 'IN x 'RR)
                                                 (list 'IN t 'RR) (list 'IN dd 'RR) (list 'IN w 'RR)
                                                 (list 'IN d 'RR) (list '<= 'a x) (list '<= x 'b)
                                                 (list '= (list '+ d d) w) (list '< 0 d)
                                                 (list '<= w dd) (list '<= w gap))
                                           (if right?
                                               (list (list '< x t) (list '<= t (list '+ x d)))
                                               (list (list '<= (list '- x d) t) (list '< t x))))))
                              (cir-in-ccint! t 'a 'b prems)
                              (if right?
                                  (dk-have! (list '< t (list '+ x dd)) (lambda () (apply dk-ineq! prems)))
                                  (dk-have! (list '< (list '- x dd) t) (lambda () (apply dk-ineq! prems))))
                              (dk-apply! cl t)
                              (fact 'restrict-apply 'h '(CCINT a b) t)
                              (fact 'fun-apply-type-c 'h 'RR 'RR t)
                              (subst (list '== (list 'h t) (list cir-ot-r t)))
                              (dk-have! (list 'IN (list cir-ot-r t) 'RR)
                                (lambda () (subst (list '== (list cir-ot-r t) (list 'h t))) (ass)))
                              (fact 'rr-sub-in-rr (list cir-ot-r t) l)
                              (fact 'rr-abs-closed (list '- (list cir-ot-r t) l))
                              (let ((ab (list 'ABS (list '- (list cir-ot-r t) l))))
                                (dk-ineq! (list 'IN ab 'RR) (list 'IN e 'RR) (list '< ab e)))))))))))))))))

(sp (make-wff "forall([a, b, h], h in fun(rr, rr) implies
   is-regulated-on(restrict(h, ccint(a, b)), a, b) implies is-regulated(h, a, b))"))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-REGULATED-ON (cir-find (dk-head? 'IS-REGULATED-ON) (dk-asms) "the hypothesis")))))
(fact 'ccint-subset-rr 'a 'b)
(mac 'IS-REGULATED)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (cir-head (dk-goal)) 'FORALL))
       (ass)
       (let ((x (dk-di-var!)))
         (cir-ccint-parts! x 'a 'b)
         (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (if (eq? (cir-head g) 'IMPLIES)
                  (cir-ot-side! x (dk-contains? g 'IS-RIGHT-LIMIT))
                  (ass)))))))))
(qed 'restrict-regulated-on-is-regulated)

;;; =====================================================================
;;; (3b) TOTAL -> ON.  f on [a,b], its constant extension regulated in the
;;; total sense: f is regulated on [a,b].  Take the total limit at eps/2; the
;;; WITHIN window (x, x+delta) sits inside the total one (x, x+delta].
;;; =====================================================================
(define cir-to-ec '(EXTEND-CONST f a b))

(define (cir-to-side! x right?)
  (dk-peel!)
  (let* ((rc (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm)
                                        (dk-contains? fm 'IS-RIGHT-LIMIT)
                                        (dk-contains? fm 'IS-LEFT-LIMIT)))
                      "the total clause"))
         (both (dk-apply! rc x))
         (imp (begin (dk-split-all!)
                     (dk-pick (lambda (fm) (and ((dk-head? 'IMPLIES) fm)
                                                (dk-contains? fm x)
                                                (dk-contains? fm (if right? 'IS-RIGHT-LIMIT
                                                                     'IS-LEFT-LIMIT))))
                              "the one-sided implication")))
         (ex (begin (detach! imp)
                    (dk-pick (lambda (fm) (and ((dk-head? 'FORSOME) fm)
                                               (dk-contains? fm x)
                                               (dk-contains? fm (if right? 'IS-RIGHT-LIMIT
                                                                    'IS-LEFT-LIMIT))))
                             "the limit")))
         (l (dk-skolem! ex))
         (lim (dk-pick (dk-head? (if right? 'IS-RIGHT-LIMIT 'IS-LEFT-LIMIT)) "the limit")))
    (dk-split-all! (dk-landed* (lambda ()
      (mac-h (if right? 'IS-RIGHT-LIMIT 'IS-LEFT-LIMIT) lim))))
    (let ((ec (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm 'POS-RR)
                                         (dk-contains? fm l)))
                       "the eps clause of the total limit")))
      (ew l)
      (mac (if right? 'IS-RIGHT-LIMIT-WITHIN 'IS-LEFT-LIMIT-WITHIN))
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (cir-head (dk-goal)) 'FORALL))
             (ass)
             (let* ((pe (dk-peel!))
                    (e (cadr (cir-find (dk-head? 'POS-RR) pe "eps")))
                    (e2 (dk-halve! e))
                    (dd (dk-skolem! (dk-apply! ec e2)))
                    (cl (dk-pick (lambda (fm) (and ((dk-head? 'FORALL) fm) (dk-contains? fm dd)))
                                 "the delta clause")))
               (fact 'rr-pos-rr-in-rr dd)
               (fact 'rr-lt-of-pos-rr dd)
               (fact 'rr-pos-rr-in-rr e)
               (ew dd)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (cir-head (dk-goal)) 'FORALL))
                      (ass)
                      (begin
                        (dk-peel!)
                        (let* ((gl (dk-goal))        ; (< (ABS (- (f t) l)) e)
                               (t (cadr (cadr (cadr (cadr gl)))))
                               (ect (list cir-to-ec t))
                               (prems (append
                                       (list (list 'IN x 'RR) (list 'IN t 'RR) (list 'IN dd 'RR))
                                       (if right?
                                           (list (list '< x t) (list '< t (list '+ x dd)))
                                           (list (list '< (list '- x dd) t) (list '< t x))))))
                          (fact 'ccint-elt-in-rr 'a 'b t)
                          (have! (if right?
                                     (list 'AND (list 'IN t 'RR) (list 'AND (list '< x t) (list '<= t (list '+ x dd))))
                                     (list 'AND (list 'IN t 'RR) (list 'AND (list '<= (list '- x dd) t) (list '< t x))))
                            (lambda () (cir-conj-ineq! prems)))
                          (dk-apply! cl t)
                          (fact 'extend-const-ccint-fixes 'a 'b t 'f)
                          (fact 'fun-apply-type-c 'f '(CCINT a b) 'RR t)
                          (dk-have! (list 'IN ect 'RR)
                            (lambda () (subst (list '== ect (list 'f t))) (ass)))
                          (subst (list '== (list 'f t) ect))
                          (fact 'rr-sub-in-rr ect l)
                          (fact 'rr-abs-closed (list '- ect l))
                          (let ((ab (list 'ABS (list '- ect l))))
                            (dk-ineq! (list 'IN ab 'RR) (list 'IN e 'RR) (list 'IN e2 'RR)
                                      (list '<= ab e2) (list '= (list '+ e2 e2) e) (list '< 0 e2)))))))))))))))

(sp (make-wff "forall([a in rr, b in rr, f], f in fun(ccint(a, b), rr) implies
   is-regulated(extend-const(f, a, b), a, b) implies is-regulated-on(f, a, b))"))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-REGULATED (cir-find (dk-head? 'IS-REGULATED) (dk-asms) "the hypothesis")))))
(fact 'ccint-subset-rr 'a 'b)
(mac 'IS-REGULATED-ON)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (if (not (eq? (cir-head g) 'FORALL))
         (ass)
         (let ((x (dk-di-var!)))
           (cir-ccint-parts! x 'a 'b)
           (cir-to-side! x (dk-contains? g 'IS-RIGHT-LIMIT-WITHIN)))))))
(qed 'regulated-extend-const-is-regulated-on)

;;; =====================================================================
;;; (4) THE HEADLINE.
;;; =====================================================================
(sp (make-wff "forall([a in rr, b in rr, f], is-step-fn(f, a, b) implies is-regulated(f, a, b))"))
(dk-peel!)
(fact 'step-fn-regulated-on 'a 'b 'f)
(dk-project! '(IN f (FUN RR RR)) (lambda () (mac-h 'IS-STEP-FN '(IS-STEP-FN f a b))))
(fact 'restrict-regulated-on-is-regulated 'a 'b 'f)
(ass)
(qed 'step-fn-is-regulated)

;;; calculus.pdf Prop 4.5.
(sp (make-wff "forall([a in rr, b in rr, f], a < b implies f in fun(ccint(a, b), rr) implies
   (is-regulated-on(f, a, b) iff forsome([fam in fun(nn, fun(rr, rr))],
      forall([k in nn], is-step-fn(fam(k), a, b))
      and is-unif-limit-on(fam, extend-const(f, a, b), a, b))))"))
(dk-peel!)
(dk-iff! (dk-head? 'FORSOME)
  (lambda ()
    (fact 'regulated-on-is-step-limit 'a 'b 'f)
    (ass))
  (lambda ()
    (let* ((fm (dk-skolem! (cir-find (dk-head? 'FORSOME) (dk-asms) "the family")))
           (st (dk-pick (lambda (x) (and ((dk-head? 'FORALL) x) (dk-contains? x 'IS-STEP-FN)))
                        "the step clause")))
      (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IS-REGULATED (list fm 'k_) 'a 'b)))
        (lambda ()
          (let ((k (dk-di-var!)))
            (dk-apply! st k)
            (fact 'step-fn-is-regulated 'a 'b (list fm k))
            (ass))))
      (fact 'uniform-limit-of-regulated fm '(EXTEND-CONST f a b) 'a 'b)
      (fact 'regulated-extend-const-is-regulated-on 'a 'b 'f)
      (ass))))
(qed 'regulated-on-iff-step-limit)
