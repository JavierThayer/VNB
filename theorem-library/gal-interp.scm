;;; ---- the polynomial (x - th(1)) ... (x - th(n)): degree <= n, roots exactly the th(i) ----
(define (gi-thtyp n) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) '(IN (th_ i_) (CARR fk)))))
(define (gi-null-concl n)
  (list 'FORSOME 'gnn_ (list 'AND '(IN gnn_ (CARR (POLY fk)))
    (list 'AND (list 'DEG-BOUND 'fk 'gnn_ n)
      (list 'AND (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) '(= (POLY-EVAL fk gnn_ (th_ i_)) (ZERO fk))))
        (list 'FORALL 't_ (list 'IMPLIES '(IN t_ (CARR fk))
          (list 'IMPLIES (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) '(NOT (= t_ (th_ i_)))))
            '(NOT (= (POLY-EVAL fk gnn_ t_) (ZERO fk)))))))))))
(sp (make-wff (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk)
  (list 'FORALL 'th_ (list 'IMPLIES (gi-thtyp 'n_) (gi-null-concl 'n_)))))))))
