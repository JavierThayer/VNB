;;; gal-interp.scm -- Lagrange interpolation (galois-theory notes, Proposition 1.47, Corollary 1.49)
;;; and the root bound for x^d = 1 (Proposition 1.64, first sentence)
;;; (GALOIS, 2026-10-26).  Destination: theorem-library/gal-interp.scm, library algebra.
;;; Load window: after gal-poly (and so after gal-ufd and the galois vocabulary files).
;;; Statements against the notes:
;;;   1.47 is stated for n = m + 1 points th(1), ..., th(m+1) (for n = 0 both sides are one point);
;;;        F[x]_m is POLY-LE(F, m), F^n is FUN(INTERVAL(1, n), F), E is EVAL-AT-POINTS.
;;;   1.49 the bijection is the evaluation p |-> (t |-> p(t)) from F[x]_{n-1} onto FUN(F, F), which
;;;        is linear (poly-eval-add, poly-eval-monomial-mul); its inverse is the notes' map.
;;;   1.64 only its first sentence (x^d = 1 has at most d roots); the cyclicity of F^x waits for
;;;        the group kit (orders, cyclic groups) and Euler phi.
;;; Helper prefix gi-.
;;; ======================================================================
(define gi-NM 'NN-ADD-MONOID)
(define (gi-monoid!)
  (if (not (dk-asm? '(IS-MONOID NN-ADD-MONOID)))
      (begin (fact 'nn-add-monoid-is-comm-monoid) (fact 'comm-monoid-is-monoid 'NN-ADD-MONOID))))
(define (gi-nm-carr!)
  (if (not (dk-asm? '(= (CARR NN-ADD-MONOID) NN)))
      (dk-have! '(= (CARR NN-ADD-MONOID) NN) (lambda () (slot 'CARR) (rfl)))))
(define (gi-fs! a f)
  (let ((want (list 'IN f (list 'FINSUPP a gi-NM))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (mac-h 'poly-carrier (list 'IN f (gi-cp a))) (ass))))))
(define (gi-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (slot 'CARR) (ass))))))
(define (gi-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (gi-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
(define (gi-split! f)
  (if (not (every dk-asm? (gi-conjs f))) (dk-split-all! (list f)))
  f)
(define (gi-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (gi-conjs (cadr f)) (gi-conjs (caddr f))) (list f)))
(define (gi-val! a f k)
  (let ((want (list 'IN (list f k) (list 'CARR a))))
    (if (not (dk-asm? want))
        (begin
          (gi-km! k)
          (gi-iff! 'finsupp-membership (list 'IN f (list 'FINSUPP a gi-NM)) a gi-NM f)
          (dk-cite! 'fun-apply-type-c f '(CARR NN-ADD-MONOID) (list 'CARR a) k)))))
(define (gi-fk!)
  (if (not (dk-asm? '(IS-COMMUTATIVE-RING (POLY fk))))
      (begin
        (gi-iff! 'is-field-ring-def '(IS-FIELD-RING fk) 'fk)
        (dk-cite! 'commutative-ring-is-ring 'fk)
        (dk-cite! 'ring-zero-in 'fk) (dk-cite! 'ring-one-in 'fk)
        (gi-monoid!) (gi-nm-carr!)
        (dk-have! '(IS-COMMUTATIVE-RING (POLY fk)) (lambda () (dk-cite! 'monalg-comm 'fk gi-NM) (mac 'POLY) (ass)))
        (dk-cite! 'commutative-ring-is-ring '(POLY fk))
        (dk-cite! 'ring-zero-in '(POLY fk)))))
(define (gi-pm a b) (list '(MUL (POLY fk)) a b))
(define (gi-pa a b) (list '(ADD (POLY fk)) a b))
(define (gi-pn a) (list '(NEG (POLY fk)) a))
(define gi-PZ '(ZERO (POLY fk)))
(define (gi-pin! t)
  (let ((want (list 'IN t '(CARR (POLY fk)))))
    (if (not (dk-asm? want))
        (cond ((and (pair? t) (equal? (car t) '(MUL (POLY fk)))) (gi-pin! (cadr t)) (gi-pin! (caddr t)) (dk-cite! 'ring-carrier-closed-mul '(POLY fk) (cadr t) (caddr t)))
              ((and (pair? t) (equal? (car t) '(ADD (POLY fk)))) (gi-pin! (cadr t)) (gi-pin! (caddr t)) (dk-cite! 'ring-add-closed '(POLY fk) (cadr t) (caddr t)))
              ((and (pair? t) (equal? (car t) '(NEG (POLY fk)))) (gi-pin! (cadr t)) (dk-cite! 'ring-neg-in-carr '(POLY fk) (cadr t)))
              (#t (error "gi-pin!: cannot type" t))))))
(define (gi-int-mem! i hi)
  (gi-iff! 'interval-membership (list 'IN i (list 'INTERVAL 1 hi)) 1 hi i))
(define (gi-int-in! i hi)
  (if (not (dk-asm? (list 'IN i (list 'INTERVAL 1 hi))))
      (dk-have! (list 'IN i (list 'INTERVAL 1 hi))
        (lambda ()
          (dk-have! (list '<= 1 i) (lambda () (dk-nn!)))
          (dk-have! (list '<= i hi) (lambda () (dk-nn!)))
          (dk-cite! 'interval-mem-intro 1 hi i)
          (ass)))))
(define (gi-int-shrink! i n)
  (let ((sn (list 'succ n)))
    (gi-int-mem! i sn)
    (dk-have! (list 'NOT (list '= sn i))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
          (dk-have! (list '= i i) (lambda () (rfl)))
          (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
    (fact 'nn-le-ne-succ i sn)
    (gi-int-in! i n)))
(define (gi-lt-from-ne! n k)
  (fact 'nn-le-ne-succ n k)
  (dk-have! (list '< n k) (lambda () (dk-nn!))))
(define (gi-rfl-or-ass!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (gi-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
(define (gi-bound-mono! a p n m)
  ;; DEG-BOUND(a, p, n), n <= m in context, n m in NN: land DEG-BOUND(a, p, m)
  (let ((bi (dk-cite! 'deg-bound a p m)))
    (dk-have! (caddr bi)
      (lambda ()
        (let* ((ls (dk-peel!))
               (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
          (dk-have! (list '< n k) (lambda () (dk-nn!)))
          (dk-cite! 'deg-bound-apply a p n k)
          (ass))))
    (dk-have! (list 'DEG-BOUND a p m) (lambda () (dk-close-if! (lambda () (dk-only! bi (caddr bi))) prop)))))
(define (gi-cp a) (list 'CARR (list 'POLY a)))

;;; ---- degree bounds of a sum and a negative ----
(sp (make-wff '(FORALL a_ (IMPLIES (IS-COMMUTATIVE-RING a_) (FORALL f_ (IMPLIES (IN f_ (CARR (POLY a_)))
  (FORALL g_ (IMPLIES (IN g_ (CARR (POLY a_))) (FORALL n_ (IMPLIES (IN n_ NN)
    (IMPLIES (DEG-BOUND a_ f_ n_) (IMPLIES (DEG-BOUND a_ g_ n_)
      (DEG-BOUND a_ ((ADD (POLY a_)) f_ g_) n_)))))))))))))
