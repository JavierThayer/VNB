;;; ======================================================================
;;; PROPOSITION 1.47: evaluation at th(1), ..., th(m+1) is a bijection F[x]_m -> F^(m+1)
;;; iff the th(i) are pairwise distinct
;;; ======================================================================
;; the unfold of POLY-LE as a theorem, so that mac-h can open it in a hypothesis
(sp (make-wff '(FORALL a_ (FORALL m_ (== (POLY-LE a_ m_) (SEP gpl_ (CARR (POLY a_)) (DEG-BOUND a_ gpl_ m_)))))))
(di)
(mac 'POLY-LE)
(qrfl)
(qed 'poly-le-unfold)
(topic! 'poly-le-unfold 'algebra)
(define gi7-PL '(POLY-LE fk m_))
(define gi7-I '(INTERVAL 1 (succ m_)))
(define gi7-FI (list 'FUN gi7-I '(CARR fk)))
(define gi7-E '(VNB-LAMBDA gep_ (POLY-LE fk m_) (VNB-LAMBDA gei_ (INTERVAL 1 (succ m_)) (POLY-EVAL fk gep_ (th_ gei_)))))
(define (gi7-F p) (list 'VNB-LAMBDA 'gei_ gi7-I (list 'POLY-EVAL 'fk p '(th_ gei_))))
;; p in POLY-LE(fk, m) in context: land p in CARR(POLY fk) and DEG-BOUND(fk, p, m)
(define (gi7-open! p)
  (dk-have! (list 'IN p '(CARR (POLY fk))) (lambda () (mac-h 'poly-le-unfold (list 'IN p gi7-PL)) (sep-me (list 'IN p (list 'SEP 'gpl_ '(CARR (POLY fk)) '(DEG-BOUND fk gpl_ m_)))) (ass)))
  (dk-have! (list 'DEG-BOUND 'fk p 'm_) (lambda () (mac-h 'poly-le-unfold (list 'IN p gi7-PL)) (sep-me (list 'IN p (list 'SEP 'gpl_ '(CARR (POLY fk)) '(DEG-BOUND fk gpl_ m_)))) (ass))))
(define (gi7-close! p)
  (dk-have! (list 'IN p gi7-PL)
    (lambda () (mac 'POLY-LE) (for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened (lambda () (sep-mi)))))))
;; the image of p is a function on {1, ..., m+1}
(define (gi7-Ftyp! p)
  (dk-have! (list 'IN (gi7-F p) gi7-FI)
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((i (dk-di-var!)))
            (dk-apply! (gi-thtyp '(succ m_)) i)
            (dk-cite! 'poly-eval-type 'fk p (list 'th_ i))
            (ass)))
        (lambda () (ass))))))
(define (gi7-Eval! p)
  ;; E(p) = F(p), p in POLY-LE in context
  (dk-have! (list '= (list gi7-E p) (gi7-F p)) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!))))
(sp (make-wff (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk) (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ NN)
  (list 'FORALL 'th_ (list 'IMPLIES (gi-thtyp '(succ m_))
    (list 'IFF (list 'IN '(EVAL-AT-POINTS fk th_ m_) (list 'BIJECTION gi7-PL gi7-FI)) (gi-dist '(succ m_)))))))))))
(dk-peel!)
(gi-fk!)
(fact 'nn-succ-closed 'm_)
(fact 'interval-in-set 1 '(succ m_))
(dk-have! '(IN (CARR (POLY fk)) SET) (lambda () (mac 'poly-carrier) (dk-cite! 'finsupp-in-set 'fk gi-NM) (ass)))
(dk-have! (list 'IN gi7-PL 'SET) (lambda () (mac 'POLY-LE) (sep-set) (ass)))
(mac 'EVAL-AT-POINTS)
(define gi7-bi (dk-cite! 'bijection-membership-iff gi7-PL gi7-FI gi7-E))
(dk-cite! 'ladet-field-one-ne 'fk)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  (lambda ()
    ;; a bijection separates the points: test it on the indicator of i
    (gi-split! (dk-have! (caddr gi7-bi) (lambda () (dk-close-if! (lambda () (dk-only! gi7-bi (cadr gi7-bi))) prop))))
    (gi-split! (caddr gi7-bi))
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gi7-I))) ls)))
           (i (car ins)) (j (cadr ins))
           (w (list 'VNB-LAMBDA 'giw_ gi7-I (list 'IF (list '= 'giw_ i) '(ONE fk) '(ZERO fk)))))
      (pbc)
      (dk-have! (list 'IN w gi7-FI)
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((k (dk-di-var!)))
                (dk-case-if! (list 'IF (list '= k i) '(ONE fk) '(ZERO fk)) (lambda (tr v) (ass)))))
            (lambda () (ass)))))
      (let* ((surj (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FORSOME))) "surjectivity"))
             (z (dk-skolem! (dk-apply! surj w))))
        (dk-split-all!)
        (gi7-open! z)
        (gi7-Ftyp! z)
        (gi7-Eval! z)
        (let ((hz (dk-rewrite-h! (list '= (list gi7-E z) w) (list gi7-E z) (gi7-F z))))
          ;; w(i) = z(th i) = z(th j) = w(j)
          (define (val k) (list 'POLY-EVAL 'fk z (list 'th_ k)))
          (define (wv! k top?)
            (dk-have! (list '= (list w k) (if top? '(ONE fk) '(ZERO fk)))
              (lambda () (dk-close-if! (lambda () (lam-b) (dk-if-branch! top? (list 'IF (list '= k i) '(ONE fk) '(ZERO fk)) (if top? (lambda () (rfl)) #f) (lambda () (rfl)))) gi-rfl-or-ass!))))
          (define (fv! k)
            (dk-have! (list '= (list (gi7-F z) k) (val k)) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!))))
          (dk-apply! (gi-thtyp '(succ m_)) i) (dk-apply! (gi-thtyp '(succ m_)) j)
          (dk-cite! 'poly-eval-type 'fk z (list 'th_ i)) (dk-cite! 'poly-eval-type 'fk z (list 'th_ j))
          (fv! i) (fv! j)
          (wv! i #t)
          (dk-have! (list 'NOT (list '= j i)) (lambda () (di) (dk-have! (list '= i j) (lambda () (subst (list '= j i)) (rfl))) (dk-close-if! (lambda () (dk-only! (list '= i j) (list 'NOT (list '= i j)))) prop)))
          (wv! j #f)
          (dk-cite! 'fun-apply-type-c w gi7-I '(CARR fk) i)
          (dk-cite! 'fun-apply-type-c w gi7-I '(CARR fk) j)
          (define (gw! k) (dk-have! (list '= (list (gi7-F z) k) (list w k)) (lambda () (subst hz) (rfl))))
          (gw! i) (gw! j)
          (let* ((a1 (dk-rewrite-h! (list '= (list (gi7-F z) i) (val i)) (list (gi7-F z) i) (list w i)))
                 (a2 (dk-rewrite-h! a1 (list w i) '(ONE fk)))
                 (a3 (dk-rewrite-h! a2 (list 'th_ i) (list 'th_ j)))
                 (b1 (dk-rewrite-h! (list '= (list (gi7-F z) j) (val j)) (list (gi7-F z) j) (list w j)))
                 (b2 (dk-rewrite-h! b1 (list w j) '(ZERO fk)))
                 (c1 (dk-rewrite-h! a3 (val j) '(ZERO fk))))
            (dk-close-if! (lambda () (dk-only! c1 '(NOT (= (ONE fk) (ZERO fk))))) prop))))))
  (lambda ()
    ;; distinct points: E is injective (uniqueness) and surjective (existence)
    (dk-have! (caddr gi7-bi)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'IN)
                   (dk-lam-type!
                     (lambda () (let ((q (dk-di-var!))) (gi7-open! q) (gi7-Ftyp! q)))
                     (lambda () (ass))))
                  ((dk-contains? (dk-goal) 'FORSOME)
                   (let* ((ls (dk-peel!))
                          (w (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gi7-FI))) ls)))))
                     (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gi7-I) (list 'IN (list w 'i_) '(CARR fk))))
                       (lambda () (let ((i (dk-di-var!))) (dk-cite! 'fun-apply-type-c w gi7-I '(CARR fk) i) (ass))))
                     (let ((z (dk-skolem! (dk-cite! 'poly-interpolation-exists 'm_ 'fk 'th_ w))))
                       (dk-split-all!)
                       (let ((zv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm z) (dk-contains? fm w))) "values of z")))
                         (gi7-close! z)
                         (gi7-Eval! z)
                         (gi7-Ftyp! z)
                         (ew z)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin
                                   (subst (list '= (list gi7-E z) (gi7-F z)))
                                   (dk-fun-ext! (gi7-F z) w gi7-I '(CARR fk) #f #f
                                     (lambda (v)
                                       (dk-apply! (gi-thtyp '(succ m_)) v)
                                       (dk-cite! 'poly-eval-type 'fk z (list 'th_ v))
                                       (dk-have! (list '= (list (gi7-F z) v) (list 'POLY-EVAL 'fk z (list 'th_ v))) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!)))
                                       (subst (list '= (list (gi7-F z) v) (list 'POLY-EVAL 'fk z (list 'th_ v))))
                                       (subst (dk-apply! zv v))
                                       (dk-cite! 'fun-apply-type-c w gi7-I '(CARR fk) v)
                                       (rfl)))))))))))
                  (#t
                   (let* ((ls (dk-peel!))
                          (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gi7-PL))) ls)))
                          (a (car ins)) (b (cadr ins)))
                     (gi7-open! a) (gi7-open! b)
                     (gi7-Eval! a) (gi7-Eval! b)
                     (gi7-Ftyp! a) (gi7-Ftyp! b)
                     (let ((h1 (dk-rewrite-h! (dk-rewrite-h! (list '= (list gi7-E a) (list gi7-E b)) (list gi7-E a) (gi7-F a)) (list gi7-E b) (gi7-F b))))
                       (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gi7-I) (list '= (list 'POLY-EVAL 'fk a '(th_ i_)) (list 'POLY-EVAL 'fk b '(th_ i_)))))
                         (lambda ()
                           (let ((i (dk-di-var!)))
                             (dk-apply! (gi-thtyp '(succ m_)) i)
                             (dk-cite! 'poly-eval-type 'fk a (list 'th_ i))
                             (dk-cite! 'poly-eval-type 'fk b (list 'th_ i))
                             (dk-cite! 'fun-apply-type-c (gi7-F b) gi7-I '(CARR fk) i)
                             (dk-have! (list '= (list (gi7-F a) i) (list (gi7-F b) i)) (lambda () (subst h1) (rfl)))
                             (dk-have! (list '= (list (gi7-F a) i) (list 'POLY-EVAL 'fk a (list 'th_ i))) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!)))
                             (dk-have! (list '= (list (gi7-F b) i) (list 'POLY-EVAL 'fk b (list 'th_ i))) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!)))
                             (subst (list '= (list 'POLY-EVAL 'fk a (list 'th_ i)) (list (gi7-F a) i)))
                             (subst (list '= (list (gi7-F a) i) (list (gi7-F b) i)))
                             (subst (list '= (list (gi7-F b) i) (list 'POLY-EVAL 'fk b (list 'th_ i))))
                             (rfl))))
                       (dk-cite! 'poly-interpolation-unique 'm_ 'fk 'th_ a b)
                       (ass)))))))))
    (dk-close-if! (lambda () (dk-only! gi7-bi (caddr gi7-bi))) prop)))
