             (let ((nv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'NOT) (dk-contains? fm gi3-nul) (dk-contains? fm 't_))) "nonvanishing of N")))
               (dk-apply! nv t))
             (dk-cite! 'poly-eval-type 'fk gi3-nul t)
             (dk-cite! 'ring-neg-in-carr 'fk gi3-th)
