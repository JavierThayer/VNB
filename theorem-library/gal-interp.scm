(dk-conj-close!
  (lambda ()
    (cond ((dk-asm? (dk-goal)) (ass))
          ((dk-contains? (dk-goal) 'NOT)
           (let* ((ls (dk-peel!))
                  (t (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(CARR fk)))) ls))))
                  (ne (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'NOT))) ls)))
                  (d (list '(ADD fk) t (list '(NEG fk) gi3-th)))
                  (E (list 'POLY-EVAL 'fk gi3-nul t)))
             (dk-apply! ne gi3-sn)
             (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 gi3-n)) (list 'NOT (list '= t '(th_ i_)))))
               (lambda ()
