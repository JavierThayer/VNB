(mac 'POLY)
(mac 'monalg-one-slot)
(dk-have! '(FORALL x_ (IMPLIES (IN x_ (CARR NN-ADD-MONOID)) (= ((MONALG-ONE a_ NN-ADD-MONOID) x_) ((MONOMIAL a_ (ONE a_) 0) x_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-have! (list 'IN x 'NN) (lambda () (dk-rewrite-h! (list 'IN x '(CARR NN-ADD-MONOID)) '(CARR NN-ADD-MONOID) 'NN) (ass)))
      (dk-have! '(= (IDEN NN-ADD-MONOID) 0) (lambda () (slot 'IDEN) (rfl)))
      (mac 'monalg-one-apply)
      (subst '(= (IDEN NN-ADD-MONOID) 0))
      (use-em (list '= x 0)
        (lambda ()
          (subst (list '= x 0))
          (dk-cite! 'monomial-at 'a_ '(ONE a_) 0)
          (subst (list '= '((MONOMIAL a_ (ONE a_) 0) 0) '(ONE a_)))
          (dk-if-branch! #t '(IF (= 0 0) (ONE a_) (ZERO a_)) (lambda () (rfl)) (lambda () (rfl))))
        (lambda ()
          (dk-cite! 'monomial-off 'a_ '(ONE a_) 0 x)
          (subst (list '= (list '(MONOMIAL a_ (ONE a_) 0) x) '(ZERO a_)))
          (dk-if-branch! #f (list 'IF (list '= x 0) '(ONE a_) '(ZERO a_)) #f (lambda () (rfl))))))))
(dk-cite! 'monalg-ext 'a_ gi-NM '(MONALG-ONE a_ NN-ADD-MONOID) '(MONOMIAL a_ (ONE a_) 0))
(ass)
