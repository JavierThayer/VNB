;;; ---- interpolation: values at m + 1 distinct points are taken by a polynomial of degree <= m ----
(define (gi-dist n) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n))
  (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ (list 'INTERVAL 1 n)) '(IMPLIES (= (th_ i_) (th_ j_)) (= i_ j_)))))))
(define (gi-vtyp n) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) '(IN (v_ i_) (CARR fk)))))
(define (gi-interp-concl m)
  (list 'FORSOME 'gip_ (list 'AND '(IN gip_ (CARR (POLY fk)))
    (list 'AND (list 'DEG-BOUND 'fk 'gip_ m)
      (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 (list 'succ m))) '(= (POLY-EVAL fk gip_ (th_ i_)) (v_ i_))))))))
(sp (make-wff (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ NN) (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk)
  (list 'FORALL 'th_ (list 'IMPLIES (gi-thtyp '(succ m_)) (list 'IMPLIES (gi-dist '(succ m_))
    (list 'FORALL 'v_ (list 'IMPLIES (gi-vtyp '(succ m_)) (gi-interp-concl 'm_))))))))))))
