             (subst (gi3-ev t))
             (di)
             (let ((o (dk-apply! gi3-law d E)))
               (dk-have! (list 'NOT (list '= d '(ZERO fk)))
                 (lambda ()
                   (di)
                   (dk-have! (list '= t (list '(ADD fk) d gi3-th)) (lambda () (crs)))
                   (let ((hh (dk-rewrite-h! (list '= t (list '(ADD fk) d gi3-th)) d '(ZERO fk))))
                     (dk-have! (list '= (list '(ADD fk) '(ZERO fk) gi3-th) gi3-th) (lambda () (crs)))
                     (dk-rewrite-h! hh (list '(ADD fk) '(ZERO fk) gi3-th) gi3-th)
                     (dk-close-if! (lambda () (dk-only! (list '= t gi3-th) (list 'NOT (list '= t gi3-th)))) prop))))
               (dk-close-if! (lambda () (dk-only! o (list 'NOT (list '= d '(ZERO fk))) (list 'NOT (list '= E '(ZERO fk))))) prop))))
          (#t
           (let* ((ls (dk-peel!))
                  (i (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) (list 'INTERVAL 1 gi3-sn)))) ls)))))
             (dk-apply! (gi-thtyp gi3-sn) i)
             (dk-cite! 'poly-eval-type 'fk gi3-nul (list 'th_ i))
             (subst (gi3-ev (list 'th_ i)))
             (use-em (list '= i gi3-sn)
               (lambda () (subst (list '= i gi3-sn)) (dk-cite! 'poly-eval-type 'fk gi3-nul gi3-th) (crs))
               (lambda ()
                 (gi-int-shrink! i gi3-n)
                 (let ((rt (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm gi3-nul) (not (dk-contains? fm 'NOT)) (dk-contains? fm 'POLY-EVAL) (dk-contains? fm 'INTERVAL) (dk-contains? fm '(ZERO fk)))) "roots of N")))
                   (subst (dk-apply! rt i))
                   (crs)))))))))
