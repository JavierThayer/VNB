(dk-cite! 'commutative-ring-is-ring 'a_)
(define gi1-s '((ADD (POLY a_)) f_ g_))
(dk-cite! 'poly-is-ring 'a_)
(dk-cite! 'ring-add-closed '(POLY a_) 'f_ 'g_)
(define gi1-bi (dk-cite! 'deg-bound 'a_ gi1-s 'n_))
(dk-have! (caddr gi1-bi)
  (lambda ()
    (let* ((ls (dk-peel!))
           (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
      (subst (dk-cite! 'poly-add-at 'a_ 'f_ 'g_ k))
      (subst (dk-cite! 'deg-bound-apply 'a_ 'f_ 'n_ k))
      (subst (dk-cite! 'deg-bound-apply 'a_ 'g_ 'n_ k))
      (dk-cite! 'ring-zero-in 'a_)
      (crs))))
(dk-close-if! (lambda () (dk-only! gi1-bi (caddr gi1-bi))) prop)
