;;; ======================================================================
;;; COROLLARY 1.49: over a field with n = m + 1 elements, evaluation is a bijection from
;;; F[x]_{n-1} onto the maps F -> F
;;; ======================================================================
;; k |-> k + 1 is a bijection {0, ..., n-1} -> {1, ..., n}
(define gi8-s '(VNB-LAMBDA gsk_ (ORD-SEGMENT n_) (succ gsk_)))
(sp (make-wff (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
  (list 'IN gi8-s '(BIJECTION (ORD-SEGMENT n_) (INTERVAL 1 n_)))))))
(dk-peel!)
(fact 'interval-in-set 1 'n_)
(define gi8-bi (dk-cite! 'bijection-membership-iff '(ORD-SEGMENT n_) '(INTERVAL 1 n_) gi8-s))
(define (gi8-seg! k)
  (dk-cite! 'ord-segment-nn-subset 'n_ k)
  (gi-iff! 'seg-mem-lt (list 'IN k '(ORD-SEGMENT n_)) 'n_ k))
(define (gi8-val! k)
  (fact 'nn-succ-closed k)
  (dk-have! (list '= (list gi8-s k) (list 'succ k)) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!))))
(dk-have! (caddr gi8-bi)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) 'IN)
               (dk-lam-type!
                 (lambda ()
                   (let ((k (dk-di-var!)))
                     (gi8-seg! k)
                     (fact 'nn-succ-closed k)
                     (fact 'nn-lt-succ-le k 'n_)
                     (gi-int-in! (list 'succ k) 'n_)))
                 (lambda () (dk-cite! 'nn-subset-ord 'n_) (dk-cite! 'ord-segment-is-set 'n_) (ass))))
              ((dk-contains? (dk-goal) 'FORSOME)
               (let* ((ls (dk-peel!))
                      (j (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(INTERVAL 1 n_)))) ls)))))
                 (gi-int-mem! j 'n_)
                 (dk-have! (list 'NOT (list '= j 0)) (lambda () (dk-nn!)))
                 (let ((q (dk-skolem! (dk-cite! 'nn-nonzero-is-succ j))))
                   (dk-split-all!)
                   (dk-have! (list '< q 'n_) (lambda () (dk-nn! (list '= j (list 'succ q)) (list '<= j 'n_))))
                   (dk-have! (list 'IN q '(ORD-SEGMENT n_)) (lambda () (let ((ii (dk-cite! 'seg-mem-lt 'n_ q))) (dk-close-if! (lambda () (dk-only! ii (list '< q 'n_))) prop))))
                   (gi8-val! q)
                   (ew q)
                   (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= (list gi8-s q) (list 'succ q))) (subst (list '= j (list 'succ q))) (rfl))))))))
              (#t
               (let* ((ls (dk-peel!))
                      (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(ORD-SEGMENT n_)))) ls)))
                      (a (car ins)) (b (cadr ins)))
                 (gi8-seg! a) (gi8-seg! b)
                 (gi8-val! a) (gi8-val! b)
                 (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list gi8-s a) (list gi8-s b)) (list gi8-s a) (list 'succ a)) (list gi8-s b) (list 'succ b))))
                   (dk-cite! 'nn-succ-inj a b)
                   (ass)))))))))
(dk-close-if! (lambda () (dk-only! gi8-bi (caddr gi8-bi))) prop)
(qed 'segment-interval-bijection)
(topic! 'segment-interval-bijection 'algebra)

;; a finite set with n elements is enumerated by {1, ..., n}
(sp (make-wff '(FORALL xs_ (IMPLIES (IN xs_ SET) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (= (CARD xs_) n_)
  (FORSOME gth_ (IN gth_ (BIJECTION (INTERVAL 1 n_) xs_))))))))))
(dk-peel!)
(dk-have! '(IN (CARD xs_) NN) (lambda () (subst '(= (CARD xs_) n_)) (ass)))
(dk-have! '(AND (IN xs_ SET) (IN (CARD xs_) NN)) (lambda () (dk-conj-close!)))
(define gi9-phi (dk-skolem! (dk-cite! 'card-finite-bij 'xs_)))
(define gi9-pb (dk-rewrite-h! (list 'IN gi9-phi '(BIJECTION (ORD-SEGMENT (CARD xs_)) xs_)) '(CARD xs_) 'n_))
(define gi9-s '(VNB-LAMBDA gsk_ (ORD-SEGMENT n_) (succ gsk_)))
(dk-cite! 'segment-interval-bijection 'n_)
(define gi9-inv (list 'INVERSE-BIJ gi9-s '(ORD-SEGMENT n_) '(INTERVAL 1 n_)))
(dk-cite! 'inverse-bij-is-bijection '(ORD-SEGMENT n_) '(INTERVAL 1 n_) gi9-s)
(dk-have! (list 'AND (list 'IN gi9-inv '(BIJECTION (INTERVAL 1 n_) (ORD-SEGMENT n_))) gi9-pb) (lambda () (dk-conj-close!)))
(define gi9-c (dk-cite! 'bijection-compose '(INTERVAL 1 n_) '(ORD-SEGMENT n_) 'xs_ gi9-inv gi9-phi))
(ew (cadr gi9-c))
(ass)
(qed 'finite-set-enumeration)
(topic! 'finite-set-enumeration 'algebra)

(define gi10-A '(CARR fk))
(define gi10-FA '(FUN (CARR fk) (CARR fk)))
(define gi10-E '(VNB-LAMBDA gep_ (POLY-LE fk m_) (VNB-LAMBDA get_ (CARR fk) (POLY-EVAL fk gep_ get_))))
(define (gi10-F p) (list 'VNB-LAMBDA 'get_ gi10-A (list 'POLY-EVAL 'fk p 'get_)))
(sp (make-wff (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk) (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ NN)
  (list 'IMPLIES '(= (CARD (CARR fk)) (succ m_))
    (list 'IN gi10-E (list 'BIJECTION gi7-PL gi10-FA)))))))))
(dk-peel!)
(gi-fk!)
(fact 'nn-succ-closed 'm_)
(fact 'interval-in-set 1 '(succ m_))
(dk-cite! 'ring-carr-in-set 'fk)
(dk-have! '(IN (CARR (POLY fk)) SET) (lambda () (mac 'poly-carrier) (dk-cite! 'finsupp-in-set 'fk gi-NM) (ass)))
(dk-have! (list 'IN gi7-PL 'SET) (lambda () (mac 'POLY-LE) (sep-set) (ass)))
(define gi10-th0 (dk-skolem! (dk-cite! 'finite-set-enumeration gi10-A '(succ m_))))
(gi-iff! 'bijection-membership-iff (list 'IN gi10-th0 (list 'BIJECTION gi7-I gi10-A)) gi7-I gi10-A gi10-th0)
(define (gi-repl f a b) (cond ((eq? f a) b) ((pair? f) (cons (gi-repl (car f) a b) (gi-repl (cdr f) a b))) (#t f)))
(define gi10-sm '(succ m_))
(define gi10-tt (gi-repl (gi-thtyp gi10-sm) 'th_ gi10-th0))
(define gi10-dd (gi-repl (gi-dist gi10-sm) 'th_ gi10-th0))
(dk-have! gi10-tt (lambda () (let ((i (dk-di-var!))) (dk-cite! 'fun-apply-type-c gi10-th0 gi7-I gi10-A i) (ass))))
(dk-have! gi10-dd (lambda () (dk-close-if! (lambda () #t) gi-rfl-or-ass!)))
(define (gi10-open! p)
  (dk-have! (list 'IN p '(CARR (POLY fk))) (lambda () (mac-h 'poly-le-unfold (list 'IN p gi7-PL)) (sep-me (list 'IN p (list 'SEP 'gpl_ '(CARR (POLY fk)) '(DEG-BOUND fk gpl_ m_)))) (ass)))
  (dk-have! (list 'DEG-BOUND 'fk p 'm_) (lambda () (mac-h 'poly-le-unfold (list 'IN p gi7-PL)) (sep-me (list 'IN p (list 'SEP 'gpl_ '(CARR (POLY fk)) '(DEG-BOUND fk gpl_ m_)))) (ass))))
(define (gi10-Ftyp! p)
  (dk-have! (list 'IN (gi10-F p) gi10-FA)
    (lambda () (dk-lam-type! (lambda () (let ((t (dk-di-var!))) (dk-cite! 'poly-eval-type 'fk p t) (ass))) (lambda () (ass))))))
(define (gi10-Eval! p)
  (dk-have! (list '= (list gi10-E p) (gi10-F p)) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!))))
(define (gi10-fv! p t)
  (dk-cite! 'poly-eval-type 'fk p t)
  (dk-have! (list '= (list (gi10-F p) t) (list 'POLY-EVAL 'fk p t)) (lambda () (dk-close-if! (lambda () (lam-b)) gi-rfl-or-ass!))))
(define gi10-bi (dk-cite! 'bijection-membership-iff gi7-PL gi10-FA gi10-E))
;; the three clauses of the bijection, one by one
(define gi10-rhs (caddr gi10-bi))
(dk-have! (cadr gi10-rhs) (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (gi10-open! q) (gi10-Ftyp! q))) (lambda () (ass)))))
(dk-have! (cadr (caddr gi10-rhs)) (lambda () (let* ((ls (dk-peel!))
                      (ins (begin (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gi7-PL))) ls))))
                      (a (car ins)) (b (cadr ins)))
                 (gi10-open! a) (gi10-open! b)
                 (gi10-Eval! a) (gi10-Eval! b)
                 (gi10-Ftyp! a) (gi10-Ftyp! b)
                 (let ((h1 (dk-rewrite-h! (dk-rewrite-h! (list '= (list gi10-E a) (list gi10-E b)) (list gi10-E a) (gi10-F a)) (list gi10-E b) (gi10-F b))))
                   (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gi7-I) (list '= (list 'POLY-EVAL 'fk a (list gi10-th0 'i_)) (list 'POLY-EVAL 'fk b (list gi10-th0 'i_)))))
                     (lambda ()
                       (let* ((i (dk-di-var!)) (t (list gi10-th0 i)))
                         (dk-apply! gi10-tt i)
                         (gi10-fv! a t) (gi10-fv! b t)
                         (dk-cite! 'fun-apply-type-c (gi10-F b) gi10-A gi10-A t)
                         (dk-have! (list '= (list (gi10-F a) t) (list (gi10-F b) t)) (lambda () (subst h1) (rfl)))
                         (subst (list '= (list 'POLY-EVAL 'fk a t) (list (gi10-F a) t)))
                         (subst (list '= (list (gi10-F a) t) (list (gi10-F b) t)))
                         (subst (list '= (list (gi10-F b) t) (list 'POLY-EVAL 'fk b t)))
                         (rfl))))
                   (dk-cite! 'poly-interpolation-unique 'm_ 'fk gi10-th0 a b)
                   (ass)))))
(dk-have! (caddr (caddr gi10-rhs)) (lambda () (let* ((ls (dk-peel!))
                      (f (begin (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gi10-FA))) ls)))))
                      (ab (dk-abstract! gi7-I '(CARR fk) (lambda (k) (list f (list gi10-th0 k)))
                            (lambda (k) (dk-apply! gi10-tt k) (dk-cite! 'fun-apply-type-c f gi10-A gi10-A (list gi10-th0 k)) (ass))))
                      (v0 (car ab))
                      (veq0 (cdr ab))
                      (v (dk-name! v0 (list 'FUN gi7-I '(CARR fk))))
                      (veq (dk-rewrite-h! veq0 v0 v)))
                 (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gi7-I) (list 'IN (list v 'i_) '(CARR fk))))
                   (lambda ()
                     (let ((i (dk-di-var!)))
                       (dk-cite! 'fun-apply-type-c v gi7-I '(CARR fk) i)
                       (ass))))
                 (let* ((ie (dk-cite! 'poly-interpolation-exists 'm_ 'fk gi10-th0))
                        (z (dk-skolem! (inst*! ie v))))
                   (dk-split-all!)
                   (let ((zv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm z) (dk-contains? fm v))) "values of z")))
                     (gi7-close! z)
                     (gi10-Eval! z)
                     (gi10-Ftyp! z)
                     (ew z)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (ass)
                             (begin
                               (subst (list '= (list gi10-E z) (gi10-F z)))
                               (dk-fun-ext! (gi10-F z) f gi10-A gi10-A #f #f
                                 (lambda (t)
                                   (let* ((sur (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FORSOME) (dk-contains? fm gi10-th0) (not (dk-contains? fm 'POLY-EVAL)))) "th is onto"))
                                          (i (dk-skolem! (dk-apply! sur t))))
                                     (dk-split-all!)
                                     (dk-apply! gi10-tt i)
                                     (gi10-fv! z t)
                                     (subst (list '= (list (gi10-F z) t) (list 'POLY-EVAL 'fk z t)))
                                     (subst (list '= t (list gi10-th0 i)))
                                     (subst (dk-apply! zv i))
                                     (subst (dk-apply! veq i))
                                     (dk-cite! 'fun-apply-type-c f gi10-A gi10-A (list gi10-th0 i))
                                     (dk-close-if! (lambda () #t) gi-rfl-or-ass!)))))))))))))
(dk-have! gi10-rhs (lambda () (dk-conj-close!)))
(dk-close-if! (lambda () (dk-only! gi10-bi (caddr gi10-bi))) prop)
(qed 'finite-field-maps-are-polynomials)
(topic! 'finite-field-maps-are-polynomials 'algebra)


