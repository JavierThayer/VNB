;;; A METRIC OUTER MEASURE FROM SEPARATING MEASURABLE SETS: if separated aa, bb are always split by a
;;; measurable set, the outer measure is metric
(define mom-sepgen
  (list 'FORALL 'aa (list 'IMPLIES '(IN aa (POWER (PTS m))) (list 'FORALL 'bb (list 'IMPLIES '(IN bb (POWER (PTS m)))
    (list 'IMPLIES '(NOT (= (SET-DIST m aa bb) 0))
      (list 'FORSOME 'gs (list 'AND '(IS-CARATHEODORY-MEASURABLE (PTS m) mu gs)
        (list 'AND '(SUBSET aa gs) '(FORALL myy_ (IMPLIES (IN myy_ bb) (NOT (IN myy_ gs)))))))))))))
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'mu (list 'IMPLIES '(IS-METRIC-SPACE m)
  (list 'IMPLIES '(IS-OUTER-MEASURE (PTS m) mu) (list 'IMPLIES mom-sepgen '(IS-METRIC-OUTER-MEASURE m mu))))))))
(dk-peel!)
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'gs))) "the separating sets")))
  (mac 'is-metric-outer-measure)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-peel!))
                 (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'POWER))) landed))
                 (av (cadr (car ins))) (bv (cadr (cadr ins)))
                 (ne (find-first (lambda (f) (dk-head-is? f 'NOT)) landed))
                 (ex (dk-apply! hyp av bv))
                 (gv (dk-skolem! ex))
                 (sepf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f gv) (dk-contains? f bv))) "bb off gs"))
                 (meas (list 'IS-CARATHEODORY-MEASURABLE '(PTS m) 'mu gv))
                 (tt (list 'UNION av bv)))
            (let ((cl (caddr (caddr (dk-cite! 'is-caratheodory-measurable '(PTS m) 'mu gv)))))
              (dk-project! cl 'is-caratheodory-measurable meas)
              (dk-project! '(IN (PTS m) SET) 'is-outer-measure '(IS-OUTER-MEASURE (PTS m) mu))
              (fact 'power-mem-sethood '(PTS m) av)
              (fact 'power-mem-sethood '(PTS m) bv)
              (dk-have! (list 'IN tt '(POWER (PTS m)))
                (lambda ()
                  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ tt) '(IN z_ (PTS m))))
                    (lambda ()
                      (let ((zv (dk-di-var!)))
                        (mac-h 'union-membership (list 'IN zv tt))
                        (dk-each-leaf! (lambda () (ai (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f zv))) "the union")))
                          (lambda ()
                            (fact 'power-mem-in '(PTS m) (if (dk-asm? (list 'IN zv av)) av bv) zv)
                            (ass))))))
                  (mom-and2! (list 'IN av 'SET) (list 'IN bv 'SET))
                  (fact 'union-set-closure av bv)
                  (fact 'power-mem-intro '(PTS m) tt)
                  (ass)))
              (let ((eq (dk-apply! cl tt)))
                (fact 'difference-unfold tt gv)
                (let ((eq2 (dk-rewrite-h! eq (list 'DIFFERENCE tt gv) (list 'COMPLEMENT-IN tt gv))))
                  (dk-cite! 'subset-def av gv)
                  (let ((pre (lambda (w)
                               (dk-have! (list 'IMPLIES (list 'IN w av) (list 'IN w gv))
                                 (lambda () (di) (fact 'subset-mem-fwd av gv w) (ass)))
                               (dk-have! (list 'IMPLIES (list 'IN w bv) (list 'NOT (list 'IN w gv)))
                                 (lambda () (di) (dk-apply! sepf w) (ass))))))
                    (mom-prop-ext! (list 'INTERSECTION tt gv) av pre)
                    (mom-prop-ext! (list 'COMPLEMENT-IN tt gv) bv pre)
                    (let* ((eq3 (dk-rewrite-h! eq2 (list 'INTERSECTION tt gv) av))
                           (eq4 (dk-rewrite-h! eq3 (list 'COMPLEMENT-IN tt gv) bv)))
                      (ass)))))))))))
(qed 'metric-outer-of-separating-sets)
;;; THE GRID CELLS [n r, n r + r) and (-(n r + r), -(n r)]
(define (mom-PC n r) (list 'COMPLEMENT-IN (mom-K (list '* n r)) (mom-K (list '+ (list '* n r) r))))
(define (mom-NC n r) (list 'COMPLEMENT-IN (mom-H (list '- (list '* n r))) (mom-H (list '- (list '+ (list '* n r) r)))))

;;; z off the closed ray: the strict inequality
(define (mom-off-lt! z ray c right?)
  (let ((goal (if right? (list '< z c) (list '< c z))))
    (dk-have! goal
      (lambda ()
        (let ((into (lambda ()
                      (dk-have! (list 'IN z ray) (lambda () (mom-prove-mem!)))
                      (ai (list 'NOT (list 'IN z ray))))))
          (if right?
              (mom-trich! z c (lambda () (ass)) into into)
              (mom-trich! z c into into (lambda () (ass)))))))
    goal))
;;; unfold z in a cell to its two inequalities
(define (mom-cell-unfold! z cell right?)
  (mac-h 'complement-in-membership (list 'IN z cell))
  (dk-split-all!)
  (let ((r1 (cadr cell)) (r2 (caddr cell)))
    (mom-unfold-mem! (list 'IN z r1))
    (mom-off-lt! z r2 (if right? (list-ref (list-ref r2 3) 1) (list-ref (list-ref r2 3) 2)) right?)))
(define (mom-nr-types! nv r)
  (fact 'nn-in-rr nv)
  (if (not (dk-asm? (list 'IN r 'RR))) (fact 'rr-pos-rr-in-rr r))
  (if (not (dk-asm? (list '< 0 r))) (fact 'rr-lt-of-pos-rr r))
  (dk-have! (list 'IN (list '* nv r) 'RR) (lambda () (type-term)))
  (dk-have! (list 'IN (list '+ (list '* nv r) r) 'RR) (lambda () (type-term))))

(define (mom-cover-proof! right? name)
  (let ((cell (if right? mom-PC mom-NC)))
    (sp (make-wff (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORALL 'x (list 'IMPLIES '(IN x RR)
      (list 'IMPLIES (if right? '(<= 0 x) '(<= x 0))
        (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'IN 'x (cell 'n 'r)))))))))))
    (dk-peel!)
    (let ((c (if right? 'x '(- x))))
      (if (not right?)
          (begin
            (dk-have! (list 'IN c 'RR) (lambda () (type-term)))
            (dk-have! (list '<= 0 c) (lambda () (dk-ineq! '(<= x 0) '(IN x RR))))))
      (let* ((ex (dk-cite! 'rr-nn-floor-mul c 'r))
             (nv (dk-skolem! ex)))
        (mom-nr-types! nv 'r)
        (if (not right?)
            (begin
              (dk-have! (list 'IN (list '- (list '* nv 'r)) 'RR) (lambda () (type-term)))
              (dk-have! (list 'IN (list '- (list '+ (list '* nv 'r) 'r)) 'RR) (lambda () (type-term)))))
        (ew nv)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (mac 'complement-in-membership)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'NOT)
                          (begin
                            (let ((h (dk-landed-1 (lambda () (di)))))
                              (mom-unfold-mem! h)
                              (apply mom-ex-falso! (mom-lin-asms))))
                          (mom-prove-mem!))))))))))
    (qed name)))
(mom-cover-proof! #t 'grid-cell-cover-nonneg)
(mom-cover-proof! #f 'grid-cell-cover-nonpos)

;;; two points of one cell are less than r apart
(define (mom-close-proof! right? name)
  (let* ((cell (if right? mom-PC mom-NC)) (cl (cell 'n 'r)))
    (sp (make-wff (list 'FORALL 'r (list 'FORALL 'n (list 'FORALL 'x (list 'FORALL 'y
      (mom-imps (list '(POS-RR r) '(IN n NN) (list 'IN 'x cl) (list 'IN 'y cl))
        '(< (abs (- x y)) r))))))))
    (dk-peel!)
    (mom-nr-types! 'n 'r)
    (if (not right?)
        (begin
          (dk-have! (list 'IN (list '- (list '* 'n 'r)) 'RR) (lambda () (type-term)))
          (dk-have! (list 'IN (list '- (list '+ (list '* 'n 'r) 'r)) 'RR) (lambda () (type-term)))))
    (mom-cell-unfold! 'x cl right?)
    (mom-cell-unfold! 'y cl right?)
    (dk-have! '(IN (- x y) RR) (lambda () (type-term)))
    (dk-have! '(< (- r) (- x y)) (lambda () (mom-lin!)))
    (dk-have! '(< (- x y) r) (lambda () (mom-lin!)))
    (fact 'rr-abs-lt-of-parts '(- x y) 'r)
    (ass)
    (qed name)))
(mom-close-proof! #t 'grid-cell-close-nonneg)
(mom-close-proof! #f 'grid-cell-close-nonpos)

;;; (IN ray CARATHEODORY-SETS(RR, lam*)) for a closed ray at a real c
(define (mom-ray-in! ray right?)
  (let ((c (if right? (cadr (list-ref ray 3)) (caddr (list-ref ray 3)))))
    (if (not (dk-asm? (list 'IN ray mom-cars)))
        (begin
          (if (not (dk-asm? (list 'IN c 'RR))) (dk-have! (list 'IN c 'RR) (lambda () (type-term))))
          (fact (if right? 'lebesgue-right-ray-measurable 'lebesgue-left-ray-measurable) c)
          (mom-ray-sub! ray)
          (mom-rr-pow! ray)
          (dk-have! (list 'IN ray mom-cars)
            (lambda () (mac 'caratheodory-sets-membership) (dk-conj-close! dk-ass!)))))))
(define (mom-cell-in! cell right?)
  (mom-ray-in! (cadr cell) right?)
  (mom-ray-in! (caddr cell) right?)
  (fact 'sigma-algebra-difference-closed 'RR mom-cars (cadr cell) (caddr cell)))

;;; LEBESGUE OUTER MEASURE IS A METRIC OUTER MEASURE ON THE LINE
(define mom-ptsq '(== (PTS RR-MS) RR))
(sp (make-wff (list 'IS-METRIC-OUTER-MEASURE 'RR-MS mom-lst)))
(dk-have! mom-ptsq (lambda () (slot 'PTS) (qrfl)))
(fact 'rr-is-metric-space)
(fact 'lebesgue-outer-measure)
(fact 'rr-is-set)
(dk-have! (list 'IS-OUTER-MEASURE '(PTS RR-MS) mom-lst) (lambda () (subst mom-ptsq) (ass)))
(define mom-lsep (dk--replace (dk--replace mom-sepgen 'm 'RR-MS) 'mu mom-lst))
(dk-have! mom-lsep
  (lambda ()
    (subst mom-ptsq)
    (let* ((landed (dk-peel!))
           (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'POWER))) landed))
           (av (cadr (car ins))) (bv (cadr (cadr ins))))
      (for-each
        (lambda (sv)
          (dk-have! (list 'SUBSET sv '(PTS RR-MS))
            (lambda () (subst mom-ptsq) (mac 'subset-def) (let ((zv (dk-di-var!))) (fact 'power-mem-in 'RR sv zv) (ass))))
          (dk-have! (list 'SUBSET sv 'RR)
            (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (fact 'power-mem-in 'RR sv zv) (ass)))))
        (list av bv))
      (let* ((ex (dk-cite! 'set-dist-pos-elim 'RR-MS av bv))
             (rv (dk-skolem! ex))
             (bound (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f rv) (dk-contains? f 'DIST))) "the bound"))
             (meets (lambda (cell) (dk--replace (dk--replace mom-meets 'cs cell) 'aa av)))
             (fa (list 'VNB-LAMBDA 'mgn_ 'NN (meets (mom-PC 'mgn_ rv))))
             (fb (list 'VNB-LAMBDA 'mgn_ 'NN (meets (mom-NC 'mgn_ rv))))
             (ga (list 'BIG-UNION 'n_ 'NN (list fa 'n_)))
             (gb (list 'BIG-UNION 'n_ 'NN (list fb 'n_)))
             (gg (list 'UNION ga gb)))
        (fact 'rr-pos-rr-in-rr rv)
        (fact 'rr-lt-of-pos-rr rv)
        (fact 'caratheodory-measurable-sigma-algebra 'RR mom-lst)
        (for-each
          (lambda (f cell right?)
            (dk-have! (list 'IN f (list 'FUN 'NN mom-cars))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((kv (cadr (car (dk-peel!)))))
                      (mom-nr-types! kv rv)
                      (if (not right?)
                          (begin
                            (dk-have! (list 'IN (list '- (list '* kv rv)) 'RR) (lambda () (type-term)))
                            (dk-have! (list 'IN (list '- (list '+ (list '* kv rv) rv)) 'RR) (lambda () (type-term)))))
                      (mom-cell-in! (cell kv rv) right?)
                      (fact 'sigma-algebra-sep-meets 'RR mom-cars (cell kv rv) av)
                      (ass))))))
            (fact 'sigma-algebra-union-closed 'RR mom-cars f))
          (list fa fb) (list mom-PC mom-NC) (list #t #f))
        (fact 'sigma-algebra-binary-union 'RR mom-cars ga gb)
        (let ((iff (dk-cite! 'caratheodory-sets-membership 'RR mom-lst gg)))
          (if (dk-head-is? iff 'IFF) (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))
          (dk-split-all!))
        (ew gg)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'SUBSET)
               (mac 'subset-def)
               (let ((xv (dk-di-var!)))
                 (fact 'subset-mem-fwd av 'RR xv)
                 (fact 'rr-zero-in)
                 (mom-and2! '(IN 0 RR) (list 'IN xv 'RR))
                 (let ((disj (dk-cite! 'rr-leq-total 0 xv)))
                   (dk-each-leaf! (lambda () (ai disj))
                     (lambda ()
                       (let* ((right? (dk-asm? (list '<= 0 xv)))
                              (ex2 (dk-cite! (if right? 'grid-cell-cover-nonneg 'grid-cell-cover-nonpos) rv xv))
                              (nv (dk-skolem! ex2))
                              (f (if right? fa fb)))
                         (mac 'union-membership)
                         (if right? (oi-l) (oi-r))
                         (for-each
                           (lambda (l)
                             (dk-focus! l)
                             (if (not (sequent-node-grounded? l))
                                 (if (not (dk-ass!))
                                     (begin
                                       (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                                       (in-sep! dk-ass!
                                         (lambda () (ew xv) (dk-conj-close! dk-ass!)))))))
                           (dk-opened (lambda () (bu-mi nv))))))))))
              (#t
               (let ((yv (dk-di-var!)))
                 (fact 'subset-mem-fwd bv 'RR yv)
                 (let ((inn (dk-landed-1 (lambda () (di)))))
                   (mac-h 'union-membership inn)
                   (dk-each-leaf! (lambda () (ai (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f yv))) "the union")))
                     (lambda ()
                       (let* ((right? (dk-asm? (list 'IN yv ga)))
                              (f (if right? fa fb)) (cellf (if right? mom-PC mom-NC))
                              (landed (dk-landed (lambda () (bu-me (list 'IN yv (if right? ga gb))))))
                              (nin (find-first (lambda (h) (and (eq? (car h) 'IN) (eq? (caddr h) 'NN))) landed))
                              (nv (cadr nin))
                              (yin (find-first (lambda (h) (and (eq? (car h) 'IN) (eq? (cadr h) yv))) landed)))
                         (dk-lam-b-h! yin)
                         (let ((ys (list 'IN yv (meets (cellf nv rv)))))
                           (sep-me ys)
                           (dk-split-all!)
                           (let* ((ex3 (dk-pick (lambda (h) (dk-head-is? h 'FORSOME)) "the point of aa"))
                                  (xv (dk-skolem! ex3)))
                             (fact 'subset-mem-fwd av 'RR xv)
                             (fact (if right? 'grid-cell-close-nonneg 'grid-cell-close-nonpos) rv nv xv yv)
                             (let* ((b (dk-apply! bound xv yv))
                                    (e (dk-cite! 'rr-ms-dist xv yv))
                                    (b2 (dk-rewrite-h! b (cadr e) (caddr e))))
                               (dk-have! (list 'IN (list '- xv yv) 'RR) (lambda () (type-term)))
                               (fact 'rr-abs-closed (list '- xv yv))
                               (mom-ex-falso! b2 (list '< (list 'abs (list '- xv yv)) rv))
                                              (list 'IN (list 'abs (list '- xv yv)) 'RR) (list 'IN rv 'RR)))))))))))))))))
(fact 'metric-outer-of-separating-sets 'RR-MS mom-lst)
(ass)
(qed 'lebesgue-metric-outer-measure)

;;; THE COROLLARY: every Borel set of the line is Lebesgue measurable
(sp (make-wff (list 'FORALL 'bs (list 'IMPLIES '(IN bs (BOREL-SETS RR-MS)) (list 'IS-CARATHEODORY-MEASURABLE 'RR mom-lst 'bs)))))
(dk-peel!)
(fact 'lebesgue-metric-outer-measure)
(dk-have! mom-ptsq (lambda () (slot 'PTS) (qrfl)))
(let ((m (dk-cite! 'borel-sets-caratheodory-measurable 'RR-MS mom-lst 'bs)))
  (dk-rewrite-h! m '(PTS RR-MS) 'RR)
  (ass))
(qed 'lebesgue-borel-measurable)
;;; THE OPEN HALF-LINES, and the four kinds of interval
(define (mom-OH c) (list 'SEP 'mhx_ 'RR (list '< 'mhx_ c)))
(define (mom-OK c) (list 'SEP 'mhx_ 'RR (list '< c 'mhx_)))
(define (mom-open-ray-proof! left? name)
  (let* ((oray (if left? (mom-OH 'c) (mom-OK 'c)))
         (cray (if left? (mom-K 'c) (mom-H 'c)))
         (comp (list 'COMPLEMENT-IN 'RR cray)))
    (sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c RR) (list 'IN oray mom-cars)))))
    (dk-peel!)
    (fact 'lebesgue-outer-measure)
    (fact 'caratheodory-measurable-sigma-algebra 'RR mom-lst)
    (mom-ray-in! cray left?)
    (fact 'sigma-algebra-complement-closed 'RR mom-cars cray)
    (dk-have! (list 'FORALL 'mw_ (list 'IFF (list 'IN 'mw_ oray) (list 'IN 'mw_ comp)))
      (lambda ()
        (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (not (sequent-node-grounded? l))
                  (if (equal? (dk-goal) (list 'IN w comp))
                      (begin
                        (sep-me (list 'IN w oray))
                        (dk-split-all!)
                        (mac 'complement-in-membership)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let ((h (dk-landed-1 (lambda () (di)))))
                                  (mom-unfold-mem! h)
                                  (apply mom-ex-falso! (mom-lin-asms)))))))
                      (begin
                        (mac-h 'complement-in-membership (list 'IN w comp))
                        (dk-split-all!)
                        (mom-off-lt! w cray 'c left?)
                        (in-sep! dk-ass! dk-ass!)))))
            (dk-opened (lambda () (di)))))))
    (fact 'class-extensionality oray comp)
    (subst (list '= oray comp))
    (ass)
    (qed name)))
(mom-open-ray-proof! #t 'lebesgue-open-left-ray-measurable)
(mom-open-ray-proof! #f 'lebesgue-open-right-ray-measurable)

(define mom-ivs
  (list (list '(CCINT a b) (mom-K 'a) (mom-H 'b))
        (list '(OOINT a b) (mom-OK 'a) (mom-OH 'b))
        (list '(COINT a b) (mom-K 'a) (mom-OH 'b))
        (list '(OCINT a b) (mom-OK 'a) (mom-H 'b))))
(define (mom-meas x) (list 'IS-CARATHEODORY-MEASURABLE 'RR mom-lst x))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IN a RR) (list 'IMPLIES '(IN b RR)
  (list 'AND (mom-meas '(CCINT a b)) (list 'AND (mom-meas '(OOINT a b))
    (list 'AND (mom-meas '(COINT a b)) (mom-meas '(OCINT a b)))))))))))
(dk-peel!)
(fact 'lebesgue-outer-measure)
(fact 'caratheodory-measurable-sigma-algebra 'RR mom-lst)
(mom-ray-in! (mom-K 'a) #t)
(mom-ray-in! (mom-H 'b) #f)
(fact 'lebesgue-open-right-ray-measurable 'a)
(fact 'lebesgue-open-left-ray-measurable 'b)
(for-each
  (lambda (iv)
    (let ((x (car iv)) (y1 (cadr iv)) (y2 (caddr iv)))
      (fact 'sigma-algebra-binary-inter 'RR mom-cars y1 y2)
      (mom-set-eq! x (list 'INTERSECTION y1 y2))
      (let* ((m1 (dk-rewrite-h! (list 'IN (list 'INTERSECTION y1 y2) mom-cars) (list 'INTERSECTION y1 y2) x))
             (iff (dk-cite! 'caratheodory-sets-membership 'RR mom-lst x)))
        (if (dk-head-is? iff 'IFF) (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))
        (dk-split-all!))))
  mom-ivs)
(dk-conj-close! dk-ass!)
(qed 'lebesgue-intervals-measurable)
