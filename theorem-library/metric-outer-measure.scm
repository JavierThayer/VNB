(define mom-meets '(SEP mgx_ cs (FORSOME mgy_ (AND (IN mgy_ aa) (IN mgy_ cs)))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'cs (list 'FORALL 'aa
