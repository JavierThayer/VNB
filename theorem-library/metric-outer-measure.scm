(define mom-luv (list 'eplus (mom-lv 'uu) (mom-lv 'vv)))
(mom-ep! (mom-lv 'uu) (mom-lv 'vv))
(let ((disj (mom-rps-cases! (mom-lv 'ts))))
  (dk-each-leaf! (lambda () (ai disj))
    (lambda ()
      (if (dk-asm? (list '= (mom-lv 'ts) 'POS-INF))
          (begin
            (fact 'rr-pos-star-below-pos-inf mom-luv)
            (dk-rewrite-h! (list '<= mom-luv 'POS-INF) 'POS-INF (mom-lv 'ts))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))
          (let ((lt (mom-lv 'ts)))
            (dk-split-all!)
            (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= mom-luv (list 'eplus lt 'eps))))
              (lambda ()
                (dk-peel!)
                (fact 'rr-pos-rr-in-rr 'eps)
                (fact 'rr-lt-of-pos-rr 'eps)
                (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
                (mom-rps-of-real! 'eps)
                (let* ((a (mom-ep! lt 'eps))
                       (e (dk-cite! 'eplus-real-defined lt 'eps))
                       (bp (dk-cite! 'binplus-apply lt 'eps))
                       (einf (list 'EINF (mom-cs 'ts))))
                  (dk-have! (list '< einf a)
                    (lambda ()
                      (subst (list '= einf lt))
                      (subst e)
                      (subst bp)
                      (dk-ineq! '(< 0 eps) (list 'IN lt 'RR) '(IN eps RR))))
                  (let* ((ex (dk-cite! 'einf-lt-witness (mom-cs 'ts) a))
                         (yv (dk-skolem! ex))
                         (ex2 (dk-cite! 'cover-sums-elim 'RR 'CLOSED-INTERVALS mom-plam 'ts yv))
                         (sv (dk-skolem! ex2))
                         (sh (mom-cut-cover! sv (mom-H 'c) 0 'uu))
                         (sk (mom-cut-cover! sv (mom-K 'c) 1 'vv))
                         (pf (lambda (sq) (list 'VNB-LAMBDA 'cvk_ 'NN (list mom-plam (list sq 'cvk_)))))
                         (ph (pf sh)) (pk (pf sk)) (ps (pf sv)))
                    (fact 'cover-sums-intro 'RR 'CLOSED-INTERVALS mom-plam 'uu sh)
                    (fact 'cover-sums-intro 'RR 'CLOSED-INTERVALS mom-plam 'vv sk)
                    (fact 'einf-lower (mom-cs 'uu) (list 'ESUM ph))
                    (fact 'einf-lower (mom-cs 'vv) (list 'ESUM pk))
                    (dk-rewrite-h! (list '<= (list 'EINF (mom-cs 'uu)) (list 'ESUM ph)) (list 'EINF (mom-cs 'uu)) (mom-lv 'uu))
                    (dk-rewrite-h! (list '<= (list 'EINF (mom-cs 'vv)) (list 'ESUM pk)) (list 'EINF (mom-cs 'vv)) (mom-lv 'vv))
                    (for-each
                      (lambda (sq p)
                        (dk-have! (list 'IN p '(FUN NN RR-POS-STAR))
                          (lambda ()
                            (dk-lam-type!
                              (lambda ()
                                (let ((kv (cadr (car (dk-peel!)))))
                                  (fact 'fun-apply-type-c sq 'NN 'CLOSED-INTERVALS kv)
                                  (fact 'fun-apply-type-c mom-plam 'CLOSED-INTERVALS 'RR-POS-STAR (list sq kv))
                                  (ass))))))
                        (mom-esum-type! p))
                      (list sh sk sv) (list ph pk ps))
                    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                                (list '<= (list 'eplus (list ph 'k) (list pk 'k)) (list ps 'k))))
                      (lambda ()
                        (let* ((kv (dk-di-var!)) (s-k (list sv kv))
                               (xh (list 'INTERSECTION s-k (mom-H 'c))) (xk (list 'INTERSECTION s-k (mom-K 'c))))
                          (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                          (let* ((parts (dk-split-all! (list (dk-cite! 'lebesgue-cut s-k 'c))))
                                 (le (find-first (lambda (f) (dk-head-is? f '<=)) parts)))
                            (for-each (lambda (x) (fact 'fun-apply-type-c mom-plam 'CLOSED-INTERVALS 'RR-POS-STAR x))
                                      (list xh xk s-k))
                            (dk-lam-b-h! le)
                            (dk-lam-b!)
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
)))
                    (fact 'esum-nn-superadditive ph pk ps)
                    (let ((s1 (mom-ep! (list 'ESUM ph) (list 'ESUM pk))))
                      (mom-and4! (list 'IN (mom-lv 'uu) 'RR-POS-STAR) (list 'IN (mom-lv 'vv) 'RR-POS-STAR)
                                 (list 'IN (list 'ESUM ph) 'RR-POS-STAR) (list 'IN (list 'ESUM pk) 'RR-POS-STAR))
                      (mom-and2! (list '<= (mom-lv 'uu) (list 'ESUM ph)) (list '<= (mom-lv 'vv) (list 'ESUM pk)))
                      (fact 'eplus-mono (mom-lv 'uu) (mom-lv 'vv) (list 'ESUM ph) (list 'ESUM pk))
                      (mom-trans! mom-luv s1 (list 'ESUM ps))
                      (dk-rewrite-h! (list '<= mom-luv (list 'ESUM ps)) (list 'ESUM ps) yv)
                      (let ((iff (dk-cite! '< yv a)))
                        (if (dk-head-is? iff 'IFF)
                            (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))
                        (dk-split-all!))
                      (fact 'subset-mem-fwd (mom-cs 'ts) 'RR-POS-STAR yv)
                      (mom-trans! mom-luv yv a)
                      (ass))))))
            (fact 'rps-le-of-forall-eps mom-luv lt)
            (ass))))))
