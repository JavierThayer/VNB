;;; (SUBSET (COMPLEMENT-IN av ray) (INTERSECTION av other)): a point of av off one closed ray
;;; at c is on the other one
(define (mom-off-ray! av ray other)
  (let ((d (list 'COMPLEMENT-IN av ray)) (x (list 'INTERSECTION av other)))
    (dk-have! (list 'SUBSET d x)
      (lambda ()
        (mac 'subset-def)
        (let ((zv (dk-di-var!)))
