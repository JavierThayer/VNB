              (if (equal? ray (mom-H 'c)) into-ray (lambda () (mom-prove-mem!)))
              into-ray
              (if (equal? ray (mom-H 'c)) (lambda () (mom-prove-mem!)) into-ray))))))))

(define (mom-ray-proof! left? name)
  (let* ((ray (if left? (mom-H 'c) (mom-K 'c))) (other (if left? (mom-K 'c) (mom-H 'c))))
    (sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c RR) (list 'IS-CARATHEODORY-MEASURABLE 'RR mom-lst ray)))))
    (dk-peel!)
    (fact 'lebesgue-outer-measure)
    (mom-ray-sub! ray)
    (dk-have! (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ (POWER RR))
                (list '<= (list 'eplus (list mom-lst (list 'INTERSECTION 'a_ ray)) (list mom-lst (list 'DIFFERENCE 'a_ ray)))
                          (list mom-lst 'a_))))
      (lambda ()
        (let* ((av (dk-di-var!)) (ai_ (list 'INTERSECTION av ray)) (ad (list 'COMPLEMENT-IN av ray)))
          (fact 'difference-unfold av ray)
          (subst (list '= (list 'DIFFERENCE av ray) ad))
          (dk-have! (list 'SUBSET ai_ ai_) (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (ass))))
          (mom-off-ray! av ray other)
          (if left?
              (begin (fact 'lebesgue-split-le av 'c ai_ ad) (ass))
              (begin
                (fact 'lebesgue-split-le av 'c ad ai_)
                (fact 'rr-is-set)
                (fact 'method-i-outer-type 'RR 'CLOSED-INTERVALS mom-plam)
                (dk-have! (list 'SUBSET av 'RR) (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (fact 'power-mem-in 'RR av zv) (ass))))
                (for-each (lambda (x)
                            (dk-have! (list 'SUBSET x 'RR)
                              (lambda ()
                                (mac 'subset-def)
                                (let ((zv (dk-di-var!)))
                                  (mac-h (if (eq? (car x) 'INTERSECTION) 'intersection-membership 'complement-in-membership)
                                         (list 'IN zv x))
                                  (dk-split-all!)
                                  (fact 'power-mem-in 'RR av zv)
                                  (ass))))
                            (mom-rr-pow! x)
                            (fact 'fun-apply-type-c mom-lst '(POWER RR) 'RR-POS-STAR x))
                          (list ai_ ad))
                (mom-and2! (list 'IN (list mom-lst ad) 'RR-POS-STAR) (list 'IN (list mom-lst ai_) 'RR-POS-STAR))
                (fact 'eplus-comm (list mom-lst ad) (list mom-lst ai_))
                (subst (list '= (list 'eplus (list mom-lst ai_) (list mom-lst ad)) (list 'eplus (list mom-lst ad) (list mom-lst ai_))))
                (ass))))))
    (fact 'caratheodory-superadditive-suffices 'RR mom-lst ray)
    (ass)
    (qed name)))
