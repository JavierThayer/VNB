;;; sigma-algebras: binary unions and intersections, and a set that is all of cs or nothing
(define mom-set-macs
  '((intersection-membership . INTERSECTION) (complement-in-membership . COMPLEMENT-IN)
    (union-membership . UNION)))
(define (mom-has-in-head? x h)
  (and (pair? x)
       (or (and (eq? (car x) 'IN) (pair? (cdr x)) (pair? (cddr x))
                (pair? (caddr x)) (eq? (car (caddr x)) h))
           (let loop ((xs x)) (and (pair? xs) (or (mom-has-in-head? (car xs) h) (loop (cdr xs))))))))
(define (mom-unfold-sets!)
  (let loop ((fuel 16))
    (let ((m (find-first (lambda (p) (mom-has-in-head? (dk-goal) (cdr p))) mom-set-macs)))
      (if (and m (> fuel 0)) (begin (mac (car m)) (loop (- fuel 1)))))))
;;; (= lhs rhs) by extensionality and prop; PRE lands the facts prop needs, given the point
(define (mom-prop-ext! lhs rhs pre)
  (dk-have! (list 'FORALL 'mw_ (list 'IFF (list 'IN 'mw_ lhs) (list 'IN 'mw_ rhs)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (mom-unfold-sets!)
        (pre w)
        (prop))))
  (fact 'class-extensionality lhs rhs))

(sp (make-wff '(FORALL omega (FORALL ca (FORALL a_ (FORALL b_
