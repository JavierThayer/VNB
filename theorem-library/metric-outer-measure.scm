        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ x) '(IN z_ RR)))
          (lambda () (let ((zv (dk-di-var!))) (fact 'subset-mem-fwd x 'RR zv) (ass))))
        (fact 'power-mem-intro 'RR x))))
