(define mom-pw '(POWER (PTS m)))
(define (mom-conjuncts f)
  (let loop ((r f) (acc '()))
    (if (and (pair? r) (eq? (car r) 'AND))
        (loop (caddr r) (cons (cadr r) acc))
        (reverse (cons r acc)))))
;;; the three conjuncts of IS-METRIC-OUTER-MEASURE(m, mu), landed (hypothesis kept)
(define (mom-mom-parts!)
  (let* ((iff (dk-cite! 'is-metric-outer-measure 'm 'mu)))
    (map (lambda (c) (dk-project! c 'is-metric-outer-measure '(IS-METRIC-OUTER-MEASURE m mu)))
         (mom-conjuncts (caddr iff)))))
;;; the five conjuncts of IS-OUTER-MEASURE(PTS(m), mu)
(define (mom-om-parts!)
  (let* ((iff (dk-cite! 'is-outer-measure '(PTS m) 'mu)))
    (map (lambda (c) (dk-project! c 'is-outer-measure '(IS-OUTER-MEASURE (PTS m) mu)))
         (mom-conjuncts (caddr iff)))))
;;; all of them: returns (additivity monotonicity subadditivity)
(define (mom-all-parts!)
  (let* ((mp (mom-mom-parts!)) (op (mom-om-parts!)))
    (list (caddr mp) (list-ref op 3) (list-ref op 4))))

(define (mom-mu-type! x)
  (if (not (dk-asm? (list 'IN (list 'mu x) 'RR-POS-STAR)))
      (fact 'fun-apply-type-c 'mu mom-pw 'RR-POS-STAR x))
  (list 'mu x))

;;; (SUBSET x (PTS m)) from (IN x (POWER (PTS m)))
(define (mom-pow-subset! x)
  (if (not (dk-asm? (list 'SUBSET x '(PTS m))))
      (dk-have! (list 'SUBSET x '(PTS m))
        (lambda ()
          (mac 'subset-def)
          (let ((zv (dk-di-var!)))
            (fact 'power-mem-in '(PTS m) x zv)
            (ass))))))
;;; (IN x (POWER (PTS m))) from (SUBSET x (PTS m)), (PTS m) in SET in context
(define (mom-sub-pow! x)
  (if (not (dk-asm? (list 'IN x mom-pw)))
      (begin
        (fact 'subclass-of-set-is-set x '(PTS m))
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ x) '(IN z_ (PTS m))))
          (lambda ()
            (let ((zv (dk-di-var!)))
              (fact 'subset-mem-fwd x '(PTS m) zv)
              (ass))))
        (fact 'power-mem-intro '(PTS m) x))))
;;; (fs k) typed into POWER(PTS m) and its subset form
(define (mom-fs-pow! fv kv)
  (let ((t (list fv kv)))
    (if (not (dk-asm? (list 'IN t mom-pw))) (fact 'fun-apply-type-c fv 'NN mom-pw kv))
    (mom-pow-subset! t)
    t))

;;; (SUBSET (BIG-UNION j A (fv j)) (PTS m)), A a set of naturals (A = NN or a segment)
(define (mom-bu-sub! fv bu)
  (dk-have! (list 'SUBSET bu '(PTS m))
    (lambda ()
      (mac 'subset-def)
      (let* ((zv (dk-di-var!))
             (landed (dk-landed (lambda () (bu-me (list 'IN zv bu)))))
             (jin (find-first (lambda (f) (and (eq? (car f) 'IN) (not (eq? (cadr f) zv)))) landed))
             (jv (cadr jin)))
        (if (not (eq? (caddr jin) 'NN)) (fact 'ord-segment-nn-subset (cadr (caddr jin)) jv))
        (mom-fs-pow! fv jv)
        (fact 'subset-mem-fwd (list fv jv) '(PTS m) zv)
        (ass))))
  (mom-sub-pow! bu))

;;; DOM f = NN and f in FUN(DOM f, RR-POS-STAR); then ESUM f typed (omc-dom!)
(define (mom-dom! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (mom-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                          (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass))))
(define (mom-esum-type! fv)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin (mom-dom! fv) (fact 'esum-in fv))))

;;; the summand lambda is a sequence in [0, +inf]
(define mom-lam '(VNB-LAMBDA n_ NN (mu (fs n_))))
(define (mom-lam-type!)
  (dk-have! (list 'IN mom-lam '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (cadr (car (dk-peel!)))))
            (mom-fs-pow! 'fs kv)
            (mom-mu-type! (list 'fs kv))
            (ass)))))))

(define (mom-U n) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT n) '(fs uj_)))
(define (mom-P n) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID mom-lam (list 'ORD-SEGMENT n)))
(define mom-sephyp
  '(FORALL mok_ (IMPLIES (IN mok_ NN) (FORALL mol_ (IMPLIES (IN mol_ NN)
     (IMPLIES (NOT (= mok_ mol_)) (NOT (= (SET-DIST m (fs mok_) (fs mol_)) 0))))))))

;;; =====================================================================
;;; (3) the union of two sets at positive distance from a third.
;;; =====================================================================

(define (mom-union-case! rlo rhi blo bhi)
  ;; rlo <= rhi in context; blo / bhi are the bounds of aa / bb (whatever their r)
  (let ((bound (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ (UNION aa bb))
                 (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ ds) (list '<= rlo '((DIST m) mxx_ myy_))))))))
    (dk-have! bound
      (lambda ()
        (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs))
               (orf (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN xv '(UNION aa bb)))))))
          (fact 'subset-mem-fwd 'ds '(PTS m) yv)
          (dk-each-leaf! (lambda () (ai orf))
            (lambda ()
              (let* ((in-aa (dk-asm? (list 'IN xv 'aa)))
                     (b (if in-aa blo bhi)))
                (fact 'subset-mem-fwd (if in-aa 'aa 'bb) '(PTS m) xv)
                (fact 'metric-dist-real 'm xv yv)
                (let ((got (dk-apply! b xv yv)))
                  (dk-ineq! (list '<= rlo rhi) got (list 'IN rlo 'RR) (list 'IN rhi 'RR)
                            (list 'IN (mom-d xv yv) 'RR)))))))))
    (fact 'set-dist-pos-intro 'm '(UNION aa bb) 'ds rlo)
    (ass)))

(sp (make-wff '(FORALL m (IMPLIES (IS-METRIC-SPACE m) (FORALL aa (FORALL bb (FORALL ds
   (IMPLIES (SUBSET aa (PTS m)) (IMPLIES (SUBSET bb (PTS m)) (IMPLIES (SUBSET ds (PTS m))
     (IMPLIES (NOT (= (SET-DIST m aa ds) 0)) (IMPLIES (NOT (= (SET-DIST m bb ds) 0))
       (NOT (= (SET-DIST m (UNION aa bb) ds) 0))))))))))))))
(dk-peel!)
(let* ((e1 (dk-cite! 'set-dist-pos-elim 'm 'aa 'ds))
       (r1 (dk-skolem! e1))
       (b1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r1))) "aa's bound"))
       (e2 (dk-cite! 'set-dist-pos-elim 'm 'bb 'ds))
       (r2 (dk-skolem! e2))
       (b2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r2))) "bb's bound")))
  (fact 'rr-pos-rr-in-rr r1)
  (fact 'rr-pos-rr-in-rr r2)
  (mom-and2! (list 'IN r1 'RR) (list 'IN r2 'RR))
  (let ((disj (dk-cite! 'rr-leq-total r1 r2)))
    (dk-each-leaf! (lambda () (ai disj))
      (lambda ()
        (if (dk-asm? (list '<= r1 r2))
            (mom-union-case! r1 r2 b1 b2)
            (mom-union-case! r2 r1 b1 b2))))))
(qed 'set-dist-union-pos)
;;; =====================================================================
;;; (4) LEMMA 4.27: pairwise positively separated sets.
;;; =====================================================================

;;; the induction behind (93): the prefix unions are additive AND stay at positive
;;; distance from every later member of the sequence.
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'm (list 'FORALL 'mu (list 'FORALL 'fs
    (list 'IMPLIES '(IS-METRIC-OUTER-MEASURE m mu)
      (list 'IMPLIES '(IN fs (FUN NN (POWER (PTS m))))
        (list 'IMPLIES mom-sephyp
          (list 'AND (list '= (list 'mu (mom-U 'n)) (mom-P 'n))
                (list 'FORALL 'moj_ (list 'IMPLIES '(IN moj_ NN)
                  (list 'IMPLIES '(<= n moj_)
                    (list 'NOT (list '= (list 'SET-DIST 'm (mom-U 'n) '(fs moj_)) 0))))))))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (mom-all-parts!)
          (fact 'bu-seg-zero 'fs)
          (subst (list '= (mom-U 0) 'EMPTY-SET))
          (fact 'rps-prefix-zero mom-lam)
          (subst (list '= (mom-P 0) 0))
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let* ((landed (dk-peel!))
                         (jv (cadr (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))))
                    (fact 'rr-one-in)
                    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                    (fact 'rr-pos-rr-of-lt 1)
                    (dk-have! (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ EMPTY-SET)
                                (list 'FORALL 'myy_ (list 'IMPLIES (list 'IN 'myy_ (list 'fs jv))
                                  '(<= 1 ((DIST m) mxx_ myy_))))))
                      (lambda ()
                        (let ((xv (dk-di-var!)))
                          (fact 'empty-set-has-no-members xv)
                          (ai (list 'NOT (list 'IN xv 'EMPTY-SET))))))
                    (fact 'set-dist-pos-intro 'm 'EMPTY-SET (list 'fs jv) 1)
                    (ass))))))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (nv (cadr nin))
               (ih (dk-landed-1 (lambda () (di))))
               (un (mom-U nv)) (fn (list 'fs nv)))
          (dk-peel!)
          (let* ((parts (mom-all-parts!))
                 (addcl (car parts))
                 (sephyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SET-DIST)
                                                   (dk-contains? f 'mol_))) "the separation hypothesis")))
            (mom-lam-type!)
            (let* ((ihc (dk-apply! ih 'm 'mu 'fs))
                   (ihs (dk-split! ihc))
                   (eqih (find-first (lambda (f) (dk-head-is? f '=)) ihs))
                   (sepih (find-first (lambda (f) (dk-head-is? f 'FORALL)) ihs)))
              (mom-bu-sub! 'fs un)
              (mom-fs-pow! 'fs nv)
              (fact 'bu-seg-succ nv mom-pw 'fs)
              (subst (list '= (mom-U (list 'succ nv)) (list 'UNION un fn)))
              (fact 'nn-le-refl nv)
              (dk-apply! sepih nv)
              (dk-apply! addcl un fn)
              (fact 'rps-prefix-succ mom-lam nv)
              (mom-mu-type! fn)
              (dk-have! (list '= (list mom-lam nv) (list 'mu fn))
                (lambda () (dk-lam-b!) (if (not (dk-ass!)) (rfl))))
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) '=)
                      (begin
                        (subst (list '= (mom-P (list 'succ nv)) (list 'eplus (mom-P nv) (list mom-lam nv))))
                        (subst (list '= (list mom-lam nv) (list 'mu fn)))
                        (subst (list '= (mom-P nv) (list 'mu un)))
                        (ass))
                      (let* ((landed (dk-peel!))
                             (jv (cadr (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed)))
                             (fj (list 'fs jv)))
                        (dk-have! (list '<= nv jv) (lambda () (dk-nn! (list '<= (list 'succ nv) jv))))
                        (dk-have! (list 'NOT (list '= nv jv)) (lambda () (dk-nn! (list '<= (list 'succ nv) jv))))
                        (dk-apply! sepih jv)
                        (dk-apply! sephyp nv jv)
                        (mom-fs-pow! 'fs jv)
                        (fact 'set-dist-union-pos 'm un fn fj)
                        (ass))))))))))
  (dk-opened (lambda () (ni))))
(qed 'metric-outer-measure-prefix-separated)

;;; (93): the finite form
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'mu (list 'FORALL 'fs
  (list 'IMPLIES '(IS-METRIC-OUTER-MEASURE m mu)
    (list 'IMPLIES '(IN fs (FUN NN (POWER (PTS m))))
      (list 'IMPLIES mom-sephyp
        (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
          (list '= (list 'mu (mom-U 'n)) (mom-P 'n))))))))))))
(dk-peel!)
(let ((both (dk-cite! 'metric-outer-measure-prefix-separated 'n 'm 'mu 'fs)))
  (dk-split! both)
  (ass))
(qed 'metric-outer-measure-finite-separated)

;;; LEMMA 4.27, (92)
(define mom-Uall '(BIG-UNION n_ NN (fs n_)))
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'mu (list 'FORALL 'fs
  (list 'IMPLIES '(IS-METRIC-OUTER-MEASURE m mu)
    (list 'IMPLIES '(IN fs (FUN NN (POWER (PTS m))))
      (list 'IMPLIES mom-sephyp
        (list '= (list 'mu mom-Uall) (list 'ESUM mom-lam))))))))))
(dk-peel!)
(let* ((parts (mom-all-parts!))
       (mono (cadr parts)) (subadd (caddr parts)))
  (mom-lam-type!)
  (mom-bu-sub! 'fs mom-Uall)
  (mom-mu-type! mom-Uall)
  (mom-esum-type! mom-lam)
  (dk-apply! subadd 'fs)
  (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mom-P 'n) (list 'mu mom-Uall))))
    (lambda ()
      (let* ((nv (dk-di-var!)) (un (mom-U nv)))
        (dk-cite! 'metric-outer-measure-finite-separated 'm 'mu 'fs nv)
        (subst (list '= (mom-P nv) (list 'mu un)))
        (mom-bu-sub! 'fs un)
        (dk-have! (list 'SUBSET un mom-Uall)
          (lambda ()
            (mac 'subset-def)
            (let* ((zv (dk-di-var!))
                   (landed (dk-landed (lambda () (bu-me (list 'IN zv un)))))
                   (jin (find-first (lambda (f) (and (eq? (car f) 'IN) (not (eq? (cadr f) zv)))) landed))
                   (jv (cadr jin)))
              (fact 'ord-segment-nn-subset nv jv)
              (for-each (lambda (l) (dk-focus! l) (if (not (sequent-node-grounded? l)) (ass)))
                        (dk-opened (lambda () (bu-mi jv)))))))
        (dk-apply! mono un mom-Uall)
        (ass))))
  (fact 'esum-nn-le-of-prefixes mom-lam (list 'mu mom-Uall))
  (mom-antisymm! (list 'mu mom-Uall) (list 'ESUM mom-lam))
  (ass))
(qed 'metric-outer-measure-separated-sum)
;;; =====================================================================
;;; (5) the layers E_n = { x : d(x, F) >= 1/(n+1) } of Lemma 4.28.
;;; =====================================================================

(define (mom-r n) (list 'recip (list '+ n 1)))
(define (mom-E n)
  (list 'SEP 'mex_ '(PTS m) (list '<= (mom-r n) '(PT-SET-DIST m mex_ fcl))))

;;; 1/(n+1): POS-RR, real, 0 < , 0 <=, in [0, +inf]
(define (mom-r-type! n)
  (let ((r (mom-r n)))
    (if (not (dk-asm? (list 'IN r 'RR-POS-STAR)))
        (begin
          (if (not (dk-asm? (list 'POS-RR r))) (fact 'nn-recip-succ-pos n))
          (if (not (dk-asm? (list 'IN r 'RR))) (fact 'rr-pos-rr-in-rr r))
          (if (not (dk-asm? (list '< 0 r))) (fact 'rr-lt-of-pos-rr r))
          (if (not (dk-asm? (list '<= 0 r))) (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r)))))
          (dk-have! (list 'IN r 'RR-POS-STAR)
            (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! (list 'IN r 'RR) (list '<= 0 r))))))
    r))

;;; trichotomy u < v | u = v | v < u, each leaf handed to its continuation
(define (mom-trich! u v k-lt k-eq k-gt)
  (let ((or1 (dk-cite! 'rr-lt-trichotomy u v)))
    (dk-each-leaf! (lambda () (ai or1))
      (lambda ()
        (if (dk-asm? (list '< u v))
            (k-lt)
            (let ((or2 (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f (list '= u v))
                                                 (not (dk-contains? f (list '< u v)))))
                                "the second disjunction")))
              (dk-each-leaf! (lambda () (ai or2))
                (lambda () (if (dk-asm? (list '= u v)) (k-eq) (k-gt))))))))))

;;; a ring identity, the coefficient quantified (crs declines recip)
(sp (make-wff '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL c_ (IMPLIES (IN c_ RR)
   (= (* c_ (+ a_ 1)) (+ (* a_ c_) c_))))))))
(dk-peel!)
(crs)
(qed 'rr-mul-succ-distrib)

;;; 1/(j+1) - 1/(j+2) > 0
(sp (make-wff '(FORALL j_ (IMPLIES (IN j_ NN)
   (POS-RR (- (recip (+ j_ 1)) (recip (+ (succ j_) 1))))))))
(dk-peel!)
(let* ((a '(+ j_ 1)) (b (list '+ a 1)) (c (list 'recip a)) (d (list 'recip b)))
  (fact 'nn-in-rr 'j_)
  (dk-have! (list 'IN a 'RR) (lambda () (type-term)))
  (dk-have! (list 'IN b 'RR) (lambda () (type-term)))
  (dk-have! (list '< 0 a) (lambda () (dk-nn!)))
  (dk-have! (list '< 0 b) (lambda () (dk-nn! (list '< 0 a))))
  (dk-have! (list 'NOT (list '= a 0)) (lambda () (di) (dk-absurd! (list '< 0 a) (list '= a 0))))
  (dk-have! (list 'NOT (list '= b 0)) (lambda () (di) (dk-absurd! (list '< 0 b) (list '= b 0))))
  (mom-and2! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
  (mom-and2! (list 'IN b 'RR) (list 'NOT (list '= b 0)))
  (fact 'rr-recip-closed a)
  (fact 'rr-recip-closed b)
  (fact 'rr-recip-inverse a)
  (fact 'rr-recip-pos a)
  (fact 'rr-one-in)
  (let ((ring (dk-cite! 'rr-mul-succ-distrib a c)))
    (dk-have! (list 'IN (list '* c b) 'RR) (lambda () (type-term)))
    (dk-have! (list 'IN (list '* a c) 'RR) (lambda () (type-term)))
    (dk-have! (list '< 1 (list '* c b))
      (lambda () (dk-ineq! ring (list '= (list '* a c) 1) (list '< 0 c)
                           (list 'IN (list '* c b) 'RR) (list 'IN (list '* a c) 'RR) (list 'IN c 'RR))))
    (let ((lt (dk-cite! 'rr-lt-div-of-lt-mul 1 c b)))
      (dk-have! (list '< d c) (lambda () (dk-ineq! lt (list 'IN d 'RR) (list 'IN c 'RR))))
      (fact 'rr-lt-diff-pos d c)
      (dk-have! (list 'IN (list '- c d) 'RR) (lambda () (type-term)))
      (fact 'rr-pos-rr-of-lt (list '- c d))
      (dk-have! (list '= '(+ (succ j_) 1) b) (lambda () (dk-nn!)))
      (subst (list '= '(+ (succ j_) 1) b))
      (ass))))
(qed 'nn-recip-succ-gap)

;;; membership of a layer, read off
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl
  (list 'IMPLIES '(SUBSET fcl (PTS m)) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (mom-E 'n))
      (list 'AND '(IN x (PTS m))
        (list 'FORALL 'mzz_ (list 'IMPLIES '(IN mzz_ fcl) (list '<= (mom-r 'n) '((DIST m) x mzz_)))))))))))))))
(dk-peel!)
(sep-me (list 'IN 'x (mom-E 'n)))
(dk-split-all!)
(mom-r-type! 'n)
(fact 'pt-set-dist-ge-elim 'm 'x 'fcl (mom-r 'n))
(dk-conj-close! dk-ass!)
(qed 'dist-layer-mem-elim)

;;; and put into a layer
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'fcl (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS m))
    (list 'IMPLIES (list 'FORALL 'mzz_ (list 'IMPLIES '(IN mzz_ fcl) (list '<= (mom-r 'n) '((DIST m) x mzz_))))
      (list 'IN 'x (mom-E 'n)))))))))))
(dk-peel!)
(mom-r-type! 'n)
(fact 'pt-set-dist-ge-intro 'm 'x 'fcl (mom-r 'n))
(in-sep! dk-ass! dk-ass!)
(qed 'dist-layer-mem-intro)

;;; the layers increase
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl
  (list 'IMPLIES '(SUBSET fcl (PTS m)) (list 'FORALL 'k (list 'FORALL 'n
    (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= k n)
      (list 'SUBSET (mom-E 'k) (mom-E 'n)))))))))))))
(dk-peel!)
(mac 'subset-def)
(let* ((xv (dk-di-var!))
       (el (dk-cite! 'dist-layer-mem-elim 'm 'fcl 'k xv)))
  (dk-split! el)
  (let ((bk (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (mom-r 'k)))) "the k bound")))
    (mom-r-type! 'k)
    (mom-r-type! 'n)
    (fact 'nn-recip-succ-antitone 'k 'n)
    (dk-have! (list 'FORALL 'mzz_ (list 'IMPLIES '(IN mzz_ fcl) (list '<= (mom-r 'n) (list (list 'DIST 'm) xv 'mzz_))))
      (lambda ()
        (let ((zv (dk-di-var!)))
          (fact 'subset-mem-fwd 'fcl '(PTS m) zv)
          (fact 'metric-dist-real 'm xv zv)
          (let ((got (dk-apply! bk zv)))
            (dk-ineq! got (list '<= (mom-r 'n) (mom-r 'k)) (list 'IN (mom-r 'n) 'RR) (list 'IN (mom-r 'k) 'RR)
                      (list 'IN (mom-d xv zv) 'RR))))))
    (fact 'dist-layer-mem-intro 'm 'fcl 'n xv)
    (ass)))
(qed 'dist-layer-mono)

;;; a layer misses F
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl
  (list 'IMPLIES '(SUBSET fcl (PTS m)) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (mom-E 'n)) '(NOT (IN x fcl))))))))))))
(dk-peel!)
(di)
(let ((el (dk-cite! 'dist-layer-mem-elim 'm 'fcl 'n 'x)))
  (dk-split! el)
  (let* ((b (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (mom-r 'n)))) "the bound"))
         (got (dk-apply! b 'x)))
    (mom-r-type! 'n)
    (fact 'metric-self-zero 'm 'x)
    (fact 'metric-dist-real 'm 'x 'x)
    (dk-absurd! got (list '= (mom-d 'x 'x) 0) (list '< 0 (mom-r 'n)) (list 'IN (mom-r 'n) 'RR)
                (list 'IN (mom-d 'x 'x) 'RR))))
(qed 'dist-layer-disjoint)

;;; off a closed F, a point lies in some layer
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'fcl (list 'IMPLIES '(IS-CLOSED m fcl)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS m)) (list 'IMPLIES '(NOT (IN x fcl))
    (list 'FORSOME 'k (list 'AND '(IN k NN) (list 'IN 'x (mom-E 'k))))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE m) 'is-closed '(IS-CLOSED m fcl))
(dk-project! '(SUBSET fcl (PTS m)) 'is-closed '(IS-CLOSED m fcl))
(let* ((u '(COMPLEMENT-IN (PTS m) fcl))
       (op (dk-project! (list 'IS-OPEN 'm u) 'is-closed '(IS-CLOSED m fcl)))
       (ocl (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u)
                           (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL m y r) u)))))
                         'is-open op)))
  (dk-have! (list 'IN 'x u) (lambda () (mac 'complement-in-membership) (dk-conj-close! dk-ass!)))
  (let* ((ex (dk-apply! ocl 'x))
         (rv (dk-skolem! ex))
         (ex2 (dk-cite! 'nn-recip-succ-small rv))
         (kv (dk-skolem! ex2))
         (r (mom-r kv)))
    (fact 'rr-pos-rr-in-rr rv)
    (mom-r-type! kv)
    (dk-have! (list 'FORALL 'mzz_ (list 'IMPLIES '(IN mzz_ fcl) (list '<= r (mom-d 'x 'mzz_))))
      (lambda ()
        (let* ((zv (dk-di-var!)) (d (mom-d 'x zv)))
          (fact 'subset-mem-fwd 'fcl '(PTS m) zv)
          (fact 'metric-dist-real 'm 'x zv)
          (mom-trich! d r
            (lambda ()
              (dk-have! (list 'IN zv (list 'BALL 'm 'x rv))
                (lambda ()
                  (mac 'ball-membership)
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-ass!) #t)
                            ((dk-head-is? (dk-goal) 'NOT)
                             (di)
                             (dk-absurd! (list '< d r) (list '< r rv) (list '= d rv)
                                         (list 'IN d 'RR) (list 'IN r 'RR) (list 'IN rv 'RR)))
                            (#t (dk-ineq! (list '< d r) (list '< r rv)
                                          (list 'IN d 'RR) (list 'IN r 'RR) (list 'IN rv 'RR))))))))
              (fact 'subset-mem-fwd (list 'BALL 'm 'x rv) u zv)
              (mac-h 'complement-in-membership (list 'IN zv u))
              (dk-split-all!)
              (ai (list 'NOT (list 'IN zv 'fcl))))
            (lambda () (dk-ineq! (list '= d r) (list 'IN d 'RR) (list 'IN r 'RR)))
            (lambda () (dk-ineq! (list '< r d) (list 'IN d 'RR) (list 'IN r 'RR)))))))
    (fact 'dist-layer-mem-intro 'm 'fcl kv 'x)
    (ew kv)
    (dk-conj-close! dk-ass!)))
(qed 'dist-layer-cover)

;;; THE GAP: a point of E_j and a point off E_(j+1) are at least 1/(j+1) - 1/(j+2) apart
(define mom-gap '(- (recip (+ j 1)) (recip (+ (succ j) 1))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl
  (list 'IMPLIES '(SUBSET fcl (PTS m)) (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
    (list 'FORALL 'x (list 'FORALL 'y (list 'IMPLIES (list 'IN 'x (mom-E 'j))
      (list 'IMPLIES '(IN y (PTS m)) (list 'IMPLIES (list 'NOT (list 'IN 'y (mom-E '(succ j))))
        (list '<= mom-gap '((DIST m) x y)))))))))))))))
(dk-peel!)
(let* ((el (dk-cite! 'dist-layer-mem-elim 'm 'fcl 'j 'x))
       (r1 (mom-r 'j)) (r2 (mom-r '(succ j)))
       (p (list 'FORSOME 'mzz_ (list 'AND '(IN mzz_ fcl) (list '< '((DIST m) y mzz_) r2)))))
  (dk-split! el)
  (fact 'nn-succ-closed 'j)
  (mom-r-type! 'j)
  (mom-r-type! '(succ j))
  (fact 'metric-dist-real 'm 'x 'y)
  (let ((bx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r1))) "x's bound")))
    (use-em p
      (lambda ()
        (let* ((zv (dk-skolem! p)))
          (fact 'subset-mem-fwd 'fcl '(PTS m) zv)
          (fact 'metric-dist-real 'm 'x zv)
          (fact 'metric-dist-real 'm 'y zv)
          (let ((got (dk-apply! bx zv))
                (tri (dk-cite! 'metric-triangle 'm 'x 'y zv)))
            (dk-ineq! got tri (list '< (mom-d 'y zv) r2)
                      (list 'IN r1 'RR) (list 'IN r2 'RR) (list 'IN (mom-d 'x zv) 'RR)
                      (list 'IN (mom-d 'y zv) 'RR) (list 'IN (mom-d 'x 'y) 'RR)))))
      (lambda ()
        (dk-have! (list 'FORALL 'mzz_ (list 'IMPLIES '(IN mzz_ fcl) (list '<= r2 (mom-d 'y 'mzz_))))
          (lambda ()
            (let* ((zv (dk-di-var!)) (d (mom-d 'y zv)))
              (fact 'subset-mem-fwd 'fcl '(PTS m) zv)
              (fact 'metric-dist-real 'm 'y zv)
              (mom-trich! d r2
                (lambda ()
                  (dk-have! p (lambda () (ew zv) (dk-conj-close! dk-ass!)))
                  (ai (list 'NOT p)))
                (lambda () (dk-ineq! (list '= d r2) (list 'IN d 'RR) (list 'IN r2 'RR)))
                (lambda () (dk-ineq! (list '< r2 d) (list 'IN d 'RR) (list 'IN r2 'RR)))))))
        (fact 'dist-layer-mem-intro 'm 'fcl '(succ j) 'y)
        (ai (list 'NOT (list 'IN 'y (mom-E '(succ j)))))))))
(qed 'dist-layer-gap)
;;; =====================================================================
;;; (6) sums in [0, +inf]: prefix monotonicity, the even/odd split, small tails.
;;; =====================================================================

(define (mom-fs f s) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID f s))
(define (mom-pre f n) (mom-fs f (list 'ORD-SEGMENT n)))
(define (mom-ep! x y)
  (mom-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (fact 'eplus-closed x y)
  (list 'eplus x y))
(define (mom-app-type! fv kv)
  (if (not (dk-asm? (list 'IN (list fv kv) 'RR-POS-STAR)))
      (fact 'fun-apply-type-c fv 'NN 'RR-POS-STAR kv))
  (list fv kv))
;;; the step-leaf idiom of an `ni': returns (n IH)
(define (mom-step-open!)
  (let* ((landed (dk-landed (lambda () (di))))
         (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
         (ih (dk-landed-1 (lambda () (di)))))
    (list (cadr nin) ih)))

;;; the prefix sums increase
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR-POS-STAR))
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= n k)
      (list '<= (mom-pre 'f 'n) (mom-pre 'f 'k)))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(<= n 0))
        (begin
          (dk-peel!)
          (fact 'nn-zero-in)
          (dk-have! '(= n 0) (lambda () (dk-nn! '(<= n 0))))
          (subst '(= n 0))
          (fact 'rps-prefix-type 'f 0)
          (fact 'rr-pos-star-le-refl (mom-pre 'f 0))
          (ass))
        (let* ((o (mom-step-open!)) (kv (car o)) (ih (cadr o)))
          (dk-peel!)
          (let ((nv (cadr (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) (list 'succ kv))))
                                   "n <= succ k"))))
            (fact 'nn-succ-closed kv)
            (fact 'rps-prefix-succ 'f kv)
            (fact 'rps-prefix-type 'f kv)
            (fact 'rps-prefix-type 'f (list 'succ kv))
            (mom-app-type! 'f kv)
            (let ((cases (dk-cite! 'nn-le-succ-cases kv nv)))
              (dk-each-leaf! (lambda () (ai cases))
                (lambda ()
                  (if (dk-asm? (list '= nv (list 'succ kv)))
                      (begin
                        (subst (list '= nv (list 'succ kv)))
                        (fact 'rr-pos-star-le-refl (mom-pre 'f (list 'succ kv)))
                        (ass))
                      (begin
                        (fact 'rps-prefix-type 'f nv)
                        (dk-apply! ih 'f nv)
                        (subst (list '= (mom-pre 'f (list 'succ kv)) (list 'eplus (mom-pre 'f kv) (list 'f kv))))
                        (mom-and2! (list 'IN (mom-pre 'f kv) 'RR-POS-STAR) (list 'IN (list 'f kv) 'RR-POS-STAR))
                        (fact 'eplus-le-left (mom-pre 'f kv) (list 'f kv))
                        (mom-ep! (mom-pre 'f kv) (list 'f kv))
                        (mom-trans! (mom-pre 'f nv) (mom-pre 'f kv) (list 'eplus (mom-pre 'f kv) (list 'f kv)))
                        (ass))))))))))
  (dk-opened (lambda () (ni))))
(qed 'rps-prefix-mono)

;;; the even/odd split of the prefix sums: P_2n(f) = P_n(g) + P_n(h), g = f(2.), h = f(2. + 1)
(define mom-gh-hyps
  (list '(IN f (FUN NN RR-POS-STAR)) '(IN g (FUN NN RR-POS-STAR)) '(IN h (FUN NN RR-POS-STAR))
        '(FORALL q (IMPLIES (IN q NN) (= (g q) (f (* 2 q)))))
        '(FORALL q (IMPLIES (IN q NN) (= (h q) (f (succ (* 2 q))))))))
(define (mom-imps hyps concl)
  (if (null? hyps) concl (list 'IMPLIES (car hyps) (mom-imps (cdr hyps) concl))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
    (mom-imps mom-gh-hyps
      (list '= (mom-pre 'f '(* 2 n)) (list 'eplus (mom-pre 'g 'n) (mom-pre 'h 'n)))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (dk-have! '(= (* 2 0) 0) (lambda () (dk-nn!)))
          (subst '(= (* 2 0) 0))
          (fact 'rps-prefix-zero 'f)
          (fact 'rps-prefix-zero 'g)
          (fact 'rps-prefix-zero 'h)
          (subst (list '= (mom-pre 'f 0) 0))
          (subst (list '= (mom-pre 'g 0) 0))
          (subst (list '= (mom-pre 'h 0) 0))
          (fact 'zero-in-rr-pos-star)
          (fact 'eplus-zero-left 0)
          (subst '(= (eplus 0 0) 0))
          (fact 'rr-zero-in)
          (rfl))
        (let* ((o (mom-step-open!)) (nv (car o)) (ih (cadr o))
               (tn (list '* 2 nv)) (stn (list 'succ tn)) (sn (list 'succ nv)))
          (dk-peel!)
          (let* ((hg (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(g q)))) "g's values"))
                 (hh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(h q)))) "h's values"))
                 (eqih (dk-apply! ih 'f 'g 'h)))
            (fact 'nn-succ-closed nv)
            (dk-have! (list 'IN tn 'NN) (lambda () (type-term)))
            (fact 'nn-succ-closed tn)
            (dk-have! (list '= (list '* 2 sn) (list 'succ stn)) (lambda () (dk-nn!)))
            (subst (list '= (list '* 2 sn) (list 'succ stn)))
            (fact 'rps-prefix-succ 'f stn)
            (fact 'rps-prefix-succ 'f tn)
            (fact 'rps-prefix-succ 'g nv)
            (fact 'rps-prefix-succ 'h nv)
            (dk-apply! hg nv)
            (dk-apply! hh nv)
            (subst (list '= (mom-pre 'f (list 'succ stn)) (list 'eplus (mom-pre 'f stn) (list 'f stn))))
            (subst (list '= (mom-pre 'f stn) (list 'eplus (mom-pre 'f tn) (list 'f tn))))
            (subst (list '= (mom-pre 'f tn) (list 'eplus (mom-pre 'g nv) (mom-pre 'h nv))))
            (subst (list '= (mom-pre 'g sn) (list 'eplus (mom-pre 'g nv) (list 'g nv))))
            (subst (list '= (mom-pre 'h sn) (list 'eplus (mom-pre 'h nv) (list 'h nv))))
            (subst (list '= (list 'g nv) (list 'f tn)))
            (subst (list '= (list 'h nv) (list 'f stn)))
            (let ((x (mom-pre 'g nv)) (y (mom-pre 'h nv)) (b (list 'f tn)) (c (list 'f stn)))
              (fact 'rps-prefix-type 'g nv)
              (fact 'rps-prefix-type 'h nv)
              (mom-app-type! 'f tn)
              (mom-app-type! 'f stn)
              (let ((xy (mom-ep! x y)) (bc (mom-ep! b c)))
                (mom-and3! (list 'IN xy 'RR-POS-STAR) (list 'IN b 'RR-POS-STAR) (list 'IN c 'RR-POS-STAR))
                (fact 'eplus-assoc xy b c)
                (subst (list '= (list 'eplus (list 'eplus xy b) c) (list 'eplus xy bc)))
                (fact 'eplus-swap4 x y b c)
                (ass)))))))
  (dk-opened (lambda () (ni))))
(qed 'rps-prefix-even-odd)

;;; ESUM f <= ESUM g + ESUM h for the even and odd subsequences g, h of f
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
  (mom-imps mom-gh-hyps '(<= (ESUM f) (eplus (ESUM g) (ESUM h)))))))))
(dk-peel!)
(mom-esum-type! 'g)
(mom-esum-type! 'h)
(let ((b (mom-ep! '(ESUM g) '(ESUM h))))
  (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mom-pre 'f 'n) b)))
    (lambda ()
      (let* ((nv (dk-di-var!)) (tn (list '* 2 nv)))
        (dk-have! (list 'IN tn 'NN) (lambda () (type-term)))
        (dk-have! (list '<= nv tn) (lambda () (dk-nn!)))
        (fact 'rps-prefix-mono tn 'f nv)
        (fact 'rps-prefix-even-odd nv 'f 'g 'h)
        (dk-rewrite-h! (list '<= (mom-pre 'f nv) (mom-pre 'f tn)) (mom-pre 'f tn) (list 'eplus (mom-pre 'g nv) (mom-pre 'h nv)))
        (fact 'rps-prefix-type 'f nv)
        (fact 'rps-prefix-type 'g nv)
        (fact 'rps-prefix-type 'h nv)
        (fact 'esum-nn-prefix-le 'g nv)
        (fact 'esum-nn-prefix-le 'h nv)
        (mom-and4! (list 'IN (mom-pre 'g nv) 'RR-POS-STAR) (list 'IN (mom-pre 'h nv) 'RR-POS-STAR)
                   '(IN (ESUM g) RR-POS-STAR) '(IN (ESUM h) RR-POS-STAR))
        (mom-and2! (list '<= (mom-pre 'g nv) '(ESUM g)) (list '<= (mom-pre 'h nv) '(ESUM h)))
        (fact 'eplus-mono (mom-pre 'g nv) (mom-pre 'h nv) '(ESUM g) '(ESUM h))
        (let ((ph (mom-ep! (mom-pre 'g nv) (mom-pre 'h nv))))
          (mom-trans! (mom-pre 'f nv) ph b)
          (ass)))))
  (fact 'esum-nn-le-of-prefixes 'f b)
  (ass))
(qed 'esum-nn-even-odd-le)

;;; the prefix sums of a dominated shifted sequence: P_n(f) + P_k(g) <= P_(n+k)(f)
(define mom-shift-hyp '(FORALL j (IMPLIES (IN j NN) (<= (g j) (f (+ n j))))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'f (list 'FORALL 'g
    (mom-imps (list '(IN f (FUN NN RR-POS-STAR)) '(IN g (FUN NN RR-POS-STAR)) mom-shift-hyp)
      (list '<= (list 'eplus (mom-pre 'f 'n) (mom-pre 'g 'k)) (mom-pre 'f '(+ n k))))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (fact 'rps-prefix-zero 'g)
          (subst (list '= (mom-pre 'g 0) 0))
          (dk-have! '(= (+ n 0) n) (lambda () (dk-nn!)))
          (subst '(= (+ n 0) n))
          (fact 'rps-prefix-type 'f 'n)
          (fact 'eplus-zero-right (mom-pre 'f 'n))
          (subst (list '= (list 'eplus (mom-pre 'f 'n) 0) (mom-pre 'f 'n)))
          (fact 'rr-pos-star-le-refl (mom-pre 'f 'n))
          (ass))
        (let* ((o (mom-step-open!)) (kv (car o)) (ih (cadr o))
               (sk (list 'succ kv)) (nk (list '+ 'n kv)))
          (dk-peel!)
          (let* ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(g j)))) "the domination"))
                 (ihc (dk-apply! ih 'n 'f 'g)))
            (fact 'nn-succ-closed kv)
            (dk-have! (list 'IN nk 'NN) (lambda () (type-term)))
            (dk-have! (list '= (list '+ 'n sk) (list 'succ nk)) (lambda () (dk-nn!)))
            (subst (list '= (list '+ 'n sk) (list 'succ nk)))
            (fact 'rps-prefix-succ 'g kv)
            (fact 'rps-prefix-succ 'f nk)
            (subst (list '= (mom-pre 'g sk) (list 'eplus (mom-pre 'g kv) (list 'g kv))))
            (subst (list '= (mom-pre 'f (list 'succ nk)) (list 'eplus (mom-pre 'f nk) (list 'f nk))))
            (let ((dom (dk-apply! hyp kv))
                  (pn (mom-pre 'f 'n)) (pk (mom-pre 'g kv)) (gk (list 'g kv)) (fnk (list 'f nk)) (pnk (mom-pre 'f nk)))
              (fact 'rps-prefix-type 'f 'n)
              (fact 'rps-prefix-type 'g kv)
              (fact 'rps-prefix-type 'f nk)
              (mom-app-type! 'g kv)
              (mom-app-type! 'f nk)
              (mom-and3! (list 'IN pn 'RR-POS-STAR) (list 'IN pk 'RR-POS-STAR) (list 'IN gk 'RR-POS-STAR))
              (fact 'eplus-assoc pn pk gk)
              (let ((pnpk (mom-ep! pn pk)))
                (mom-ep! pk gk)
                (subst (list '= (list 'eplus pn (list 'eplus pk gk)) (list 'eplus pnpk gk)))
                (mom-and4! (list 'IN pnpk 'RR-POS-STAR) (list 'IN gk 'RR-POS-STAR)
                           (list 'IN pnk 'RR-POS-STAR) (list 'IN fnk 'RR-POS-STAR))
                (mom-and2! (list '<= pnpk pnk) dom)
                (fact 'eplus-mono pnpk gk pnk fnk)
                (ass)))))))
  (dk-opened (lambda () (ni))))
(qed 'rps-prefix-shift-le)

;;; THE SMALL TAIL: the sum of a convergent series in [0, +inf] is eventually small past n
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR-POS-STAR)) (list 'IMPLIES '(IN (ESUM f) RR)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'n (list 'AND '(IN n NN)
      (list 'FORALL 'g (mom-imps (list '(IN g (FUN NN RR-POS-STAR)) mom-shift-hyp)
                          '(<= (ESUM g) eps))))))))))))
(dk-peel!)
(mom-esum-type! 'f)
(fact 'rr-pos-rr-in-rr 'eps)
(fact 'rr-lt-of-pos-rr 'eps)
(define mom-tt '(ESUM f))
(define mom-te '(- (ESUM f) eps))
(define mom-tp (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< mom-te (mom-pre 'f 'n)))))
(fact 'rr-pos-star-nonneg mom-tt)
(dk-have! (list 'IN mom-te 'RR) (lambda () (type-term)))
;;; past a prefix sum above T - eps, every dominated shifted sequence sums to at most eps
(define (mom-tail-main!)
  (let ((nv (dk-skolem! mom-tp)) (tt mom-tt) (te mom-te))
    (ew nv)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (dk-peel!)
              (fact 'rps-prefix-type 'f nv)
              (fact 'esum-nn-prefix-le 'f nv)
              (mom-and2! (list 'IN (mom-pre 'f nv) 'RR-POS-STAR) (list 'IN tt 'RR))
              (fact 'rr-pos-star-le-real-in-rr (mom-pre 'f nv) tt)
              (fact 'rr-pos-star-nonneg (mom-pre 'f nv))
              (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
              (dk-have! '(IN eps RR-POS-STAR)
                (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! '(IN eps RR) '(<= 0 eps))))
              (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (mom-pre 'g 'k) 'eps)))
                (lambda ()
                  (let* ((kv (dk-di-var!)) (pg (mom-pre 'g kv)) (pn (mom-pre 'f nv)) (nk (list '+ nv kv)))
                    (fact 'rps-prefix-shift-le kv nv 'f 'g)
                    (dk-have! (list 'IN nk 'NN) (lambda () (type-term)))
                    (fact 'esum-nn-prefix-le 'f nk)
                    (fact 'rps-prefix-type 'f nk)
                    (fact 'rps-prefix-type 'g kv)
                    (let ((s (mom-ep! pn pg)))
                      (mom-trans! s (mom-pre 'f nk) tt)
                      (mom-and2! (list 'IN s 'RR-POS-STAR) (list 'IN tt 'RR))
                      (fact 'rr-pos-star-le-real-in-rr s tt)
                      (mom-and2! (list 'IN pg 'RR-POS-STAR) (list 'IN pn 'RR-POS-STAR))
                      (fact 'eplus-le-left pg pn)
                      (mom-ep! pg pn)
                      (mom-and2! (list 'IN pn 'RR-POS-STAR) (list 'IN pg 'RR-POS-STAR))
                      (fact 'eplus-comm pg pn)
                      (let ((le2 (dk-rewrite-h! (list '<= pg (list 'eplus pg pn)) (list 'eplus pg pn) s)))
                        (mom-and2! (list 'IN pg 'RR-POS-STAR) (list 'IN s 'RR))
                        (fact 'rr-pos-star-le-real-in-rr pg s)
                        (fact 'rr-pos-star-nonneg pg)
                        (let* ((e (dk-cite! 'eplus-real-defined pn pg))
                               (le3 (dk-rewrite-h! (list '<= s tt) s (caddr e))))
                          (dk-ineq! le3 (list '< te pn) (list 'IN pn 'RR) (list 'IN pg 'RR) (list 'IN tt 'RR)
                                    '(IN eps RR))))))))
              (fact 'esum-nn-le-of-prefixes 'g 'eps)
              (ass)))))))
;;; otherwise every prefix sum is at most T - eps, and so is T: absurd
(define (mom-tail-absurd!)
  (let ((tt mom-tt) (te mom-te) (p mom-tp))
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mom-pre 'f 'n) te)))
      (lambda ()
        (let ((nv (dk-di-var!)))
          (fact 'rps-prefix-type 'f nv)
          (fact 'esum-nn-prefix-le 'f nv)
          (mom-and2! (list 'IN (mom-pre 'f nv) 'RR-POS-STAR) (list 'IN tt 'RR))
          (fact 'rr-pos-star-le-real-in-rr (mom-pre 'f nv) tt)
          (mom-trich! (mom-pre 'f nv) te
            (lambda () (dk-ineq! (list '< (mom-pre 'f nv) te) (list 'IN (mom-pre 'f nv) 'RR) (list 'IN te 'RR)))
            (lambda () (dk-ineq! (list '= (mom-pre 'f nv) te) (list 'IN (mom-pre 'f nv) 'RR) (list 'IN te 'RR)))
            (lambda ()
              (dk-have! p (lambda () (ew nv) (dk-conj-close! dk-ass!)))
              (ai (list 'NOT p)))))))
    (fact 'nn-zero-in)
    (let ((z0 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f te))) "the bound") 0)))
      (fact 'rps-prefix-zero 'f)
      (let ((z1 (dk-rewrite-h! z0 (mom-pre 'f 0) 0)))
        (dk-have! (list 'IN te 'RR-POS-STAR)
          (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! (list 'IN te 'RR) z1)))
        (fact 'esum-nn-le-of-prefixes 'f te)
        (mom-ex-falso! (list '<= tt te) (list 'IN tt 'RR) (list '< 0 'eps) '(IN eps RR))))))
(use-em mom-tp mom-tail-main! mom-tail-absurd!)
(qed 'esum-nn-tail-small)
;;; =====================================================================
;;; (7) LEMMA 4.28: the rings S_k = E_(k+1) \ E_k and the limit of mu*(A n E_k).
;;; =====================================================================

;;; (IN t NN) for t built from typed naturals by +, *, succ
(define (mom-nn-type! t)
  (if (not (dk-asm? (list 'IN t 'NN)))
      (if (and (pair? t) (eq? (car t) 'succ))
          (begin (mom-nn-type! (cadr t)) (fact 'nn-succ-closed (cadr t)))
          (dk-have! (list 'IN t 'NN) (lambda () (type-term))))))

(define (mom-ring k) (list 'COMPLEMENT-IN (mom-E (list 'succ k)) (mom-E k)))
(define (mom-A k) (list 'INTERSECTION 'aa (mom-ring k)))
(define mom-imlam (list 'VNB-LAMBDA 'mok_ 'NN (list 'mu (list 'INTERSECTION 'aa (mom-E 'mok_)))))
(define mom-L (list 'ESUP (list 'IMAGE mom-imlam 'NN)))

;;; (SUBSET (INTERSECTION aa Y) (PTS m)) and its POWER membership; aa subset PTS(m) in context
(define (mom-inter-pow! y)
  (let ((x (list 'INTERSECTION 'aa y)))
    (if (not (dk-asm? (list 'IN x mom-pw)))
        (begin
          (dk-have! (list 'SUBSET x '(PTS m))
            (lambda ()
              (mac 'subset-def)
              (let ((zv (dk-di-var!)))
                (mac-h 'intersection-membership (list 'IN zv x))
                (dk-split-all!)
                (fact 'subset-mem-fwd 'aa '(PTS m) zv)
                (ass))))
          (mom-sub-pow! x)))
    x))

;;; the sequence k |-> mu(aa n E_k), its image and supremum L: typed, and L an upper bound
(define (mom-L-type!)
  (if (not (dk-asm? (list 'IN mom-L 'RR-POS-STAR)))
      (begin
        (fact 'nn-is-set)
        (dk-have! (list 'IN mom-imlam '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (mom-mu-type! (mom-inter-pow! (mom-E kv)))
                  (ass))))))
        (let ((img (list 'IMAGE mom-imlam 'NN)))
          (dk-have! (list 'SUBSET img 'RR-POS-STAR)
            (lambda ()
              (mac 'subset-def)
              (let ((wv (dk-di-var!)))
                (fact 'image-subset-codomain 'NN 'RR-POS-STAR mom-imlam wv)
                (ass))))
          (fact 'esup-in img)
          (fact 'esup-upper img)))))

;;; (<= (mu (INTERSECTION aa E_k)) L) for k in NN
(define (mom-le-L! kv)
  (mom-L-type!)
  (let* ((x (mom-inter-pow! (mom-E kv)))
         (tm (list 'mu x))
         (img (list 'IMAGE mom-imlam 'NN)))
    (mom-mu-type! x)
    (if (not (dk-asm? (list '<= tm mom-L)))
        (let ((iff (dk-fact! 'image-membership-iff mom-imlam 'NN tm)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond ((equal? g (list 'IN tm 'SET))
                           (fact 'membership-implies-sethood tm 'RR-POS-STAR) (ass))
                          ((eq? (car g) 'FORSOME)
                           (ew kv)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (if (not (dk-lam-b!)) (rfl))))))
                          (#t (ass))))))))
          (ai iff)
          (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
          (if (not (dk-asm? (list 'IN tm img))) (error "mom-le-L!: image membership not landed" tm))
          (fact 'esup-upper img tm)))
    (list '<= tm mom-L)))

;;; off a closed F and off E_n, a point lies in a ring S_(n+j)
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'fcl (list 'IMPLIES '(IS-CLOSED m fcl)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS m)) (list 'IMPLIES '(NOT (IN x fcl))
      (list 'IMPLIES (list 'NOT (list 'IN 'x (mom-E 'n)))
        (list 'FORSOME 'j (list 'AND '(IN j NN) (list 'IN 'x (mom-ring '(+ n j))))))))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE m) 'is-closed '(IS-CLOSED m fcl))
(dk-project! '(SUBSET fcl (PTS m)) 'is-closed '(IS-CLOSED m fcl))
(let* ((ex (dk-cite! 'dist-layer-cover 'm 'fcl 'x))
       (k0 (dk-skolem! ex))
       (tset (list 'SEP 'mol_ 'NN (list 'IN 'x (mom-E 'mol_))))
       (sub (list 'SUBSET tset 'NN))
       (ne (list 'FORSOME 'mon_ (list 'IN 'mon_ tset))))
  (dk-have! sub
    (lambda ()
      (mac 'subset-def)
      (let ((v (dk-di-var!)))
        (sep-me (list 'IN v tset))
        (dk-split-all!)
        (ass))))
  (dk-have! ne (lambda () (ew k0) (in-sep! dk-ass! dk-ass!)))
  (mom-and2! sub ne)
  (let* ((lex (dk-cite! 'nn-least-element tset))
         (mm (dk-skolem! lex))
         (lst (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset))) "leastness")))
    (dk-project! (list 'IN mm 'NN) (lambda () (sep-me (list 'IN mm tset))))
    (dk-project! (list 'IN 'x (mom-E mm)) (lambda () (sep-me (list 'IN mm tset))))
    (use-em (list '<= mm 'n)
      (lambda ()
        (fact 'dist-layer-mono 'm 'fcl mm 'n)
        (fact 'subset-mem-fwd (mom-E mm) (mom-E 'n) 'x)
        (ai (list 'NOT (list 'IN 'x (mom-E 'n)))))
      (lambda ()
        (fact 'nn-not-le-succ-le mm 'n)
        (dk-have! (list 'NOT (list '= mm 0)) (lambda () (dk-nn! (list '<= '(succ n) mm))))
        (let* ((ex2 (dk-cite! 'nn-nonzero-is-succ mm))
               (iv (dk-skolem! ex2)))
          (dk-have! (list '<= 'n iv) (lambda () (dk-nn! (list '<= '(succ n) mm) (list '= mm (list 'succ iv)))))
          (dk-have! (list 'NOT (list 'IN 'x (mom-E iv)))
            (lambda ()
              (di)
              (dk-have! (list 'IN iv tset) (lambda () (in-sep! dk-ass! dk-ass!)))
              (let ((le (dk-apply! lst iv)))
                (dk-have! (list '< iv iv) (lambda () (dk-nn! le (list '= mm (list 'succ iv)))))
                (fact 'nn-in-rr iv)
                (ai (dk-cite! 'rr-lt-irrefl iv)))))
          (let* ((ex3 (dk-cite! 'nn-le-gap iv 'n))
                 (jv (dk-skolem! ex3)))
            (ew jv)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (subst (list '= (list '+ 'n jv) iv))
                      (subst (list '= (list 'succ iv) mm))
                      (mac 'complement-in-membership)
                      (dk-conj-close! dk-ass!)))))))))))
(qed 'dist-layer-ring-cover)

;;; a set inside E_j and a set off E_(j+1) are at positive distance, both ways round
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl
  (list 'IMPLIES '(SUBSET fcl (PTS m)) (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
    (list 'FORALL 'aa (list 'FORALL 'bb (list 'IMPLIES (list 'SUBSET 'aa (mom-E 'j))
      (list 'IMPLIES (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ bb)
                       (list 'AND '(IN myy_ (PTS m)) (list 'NOT (list 'IN 'myy_ (mom-E '(succ j)))))))
        '(AND (NOT (= (SET-DIST m aa bb) 0)) (NOT (= (SET-DIST m bb aa) 0)))))))))))))))
(dk-peel!)
(let ((hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bb))) "bb's points"))
      (g mom-gap))
  (fact 'nn-recip-succ-gap 'j)
  (dk-have! (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ aa)
              (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ bb) (list '<= g '((DIST m) mxx_ myy_))))))
    (lambda ()
      (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs)))
        (fact 'subset-mem-fwd 'aa (mom-E 'j) xv)
        (dk-split! (dk-apply! hb yv))
        (fact 'dist-layer-gap 'm 'fcl 'j xv yv)
        (ass))))
  (dk-have! (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ bb)
              (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ aa) (list '<= g '((DIST m) mxx_ myy_))))))
    (lambda ()
      (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs)))
        (fact 'subset-mem-fwd 'aa (mom-E 'j) yv)
        (dk-split! (dk-apply! hb xv))
        (dk-split! (dk-cite! 'dist-layer-mem-elim 'm 'fcl 'j yv))
        (fact 'dist-layer-gap 'm 'fcl 'j yv xv)
        (fact 'metric-sym 'm xv yv)
        (subst (list '= (mom-d xv yv) (mom-d yv xv)))
        (ass))))
  (fact 'set-dist-pos-intro 'm 'aa 'bb g)
  (fact 'set-dist-pos-intro 'm 'bb 'aa g)
  (dk-conj-close! dk-ass!))
(qed 'dist-layer-set-sep)

;;; THE EVEN AND THE ODD RINGS: sum_k mu*(A n S_sigma(k)) <= sup_n mu*(A n E_n), sigma(k) = 2k or 2k+1.
(define (mom-ring-sum-proof! sig name)
  (let* ((sk (lambda (k) (sig k)))
         (fsl (list 'VNB-LAMBDA 'moq_ 'NN (mom-A (sk 'moq_))))
         (lamc (list 'VNB-LAMBDA 'moq_ 'NN (list 'mu (mom-A (sk 'moq_)))))
         (lamr (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list fsl 'n_)))))
    (sp (make-wff (list 'FORALL 'm (list 'FORALL 'mu (list 'FORALL 'fcl
      (list 'IMPLIES '(IS-METRIC-OUTER-MEASURE m mu) (list 'IMPLIES '(IS-CLOSED m fcl)
        (list 'FORALL 'aa (list 'IMPLIES '(IN aa (POWER (PTS m)))
          (list '<= (list 'ESUM lamc) mom-L))))))))))
    (dk-peel!)
    (let* ((parts (mom-all-parts!)) (mono (cadr parts)))
      (dk-project! '(SUBSET fcl (PTS m)) 'is-closed '(IS-CLOSED m fcl))
      (mom-pow-subset! 'aa)
      (fact 'nn-is-set)
      (mom-L-type!)
      ;; the ring sets, as a sequence of subsets
      (dk-have! (list 'IN fsl (list 'FUN 'NN mom-pw))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((kv (cadr (car (dk-peel!)))))
                (mom-inter-pow! (mom-ring (sk kv)))
                (ass))))))
      ;; pairwise at positive distance
      (dk-have! (dk--replace mom-sephyp 'fs fsl)
        (lambda ()
          (let* ((landed (dk-peel!))
                 (kv (cadr (list-ref (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed) 0)))
                 (lv (cadr (list-ref (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed) 1))))
            (dk-lam-b!)
            (fact 'nn-in-rr kv)
            (fact 'nn-in-rr lv)
            (let ((side
                   (lambda (near far conj-index)
                     ;; near < far: A_near inside E_(j), A_far off E_(j+1), j = succ(sigma near)
                     (let* ((sn (sk near)) (sf (sk far)) (jv (list 'succ sn))
                            (an (mom-A sn)) (af (mom-A sf)))
                       (mom-nn-type! sn)
                       (mom-nn-type! sf)
                       (fact 'nn-succ-closed sn)
                       (fact 'nn-succ-closed jv)
                       (dk-have! (list 'SUBSET an (mom-E jv))
                         (lambda ()
                           (mac 'subset-def)
                           (let ((zv (dk-di-var!)))
                             (mac-h 'intersection-membership (list 'IN zv an))
                             (dk-split-all!)
                             (mac-h 'complement-in-membership (list 'IN zv (mom-ring sn)))
                             (dk-split-all!)
                             (ass))))
                       (dk-have! (list 'FORALL 'myy_ (list 'IMPLIES (list 'IN 'myy_ af)
                                   (list 'AND '(IN myy_ (PTS m)) (list 'NOT (list 'IN 'myy_ (mom-E (list 'succ jv)))))))
                         (lambda ()
                           (let ((yv (dk-di-var!)))
                             (mac-h 'intersection-membership (list 'IN yv af))
                             (dk-split-all!)
                             (mac-h 'complement-in-membership (list 'IN yv (mom-ring sf)))
                             (dk-split-all!)
                             (fact 'subset-mem-fwd 'aa '(PTS m) yv)
                             (dk-conj-close!
                               (lambda ()
                                 (if (not (dk-ass!))
                                     (begin
                                       (di)
                                       (dk-have! (list '<= (list 'succ jv) sf)
                                         (lambda ()
                                           (fact 'nn-lt-succ-le near far)
                                           (dk-nn! (list '<= (list 'succ near) far))))
                                       (fact 'dist-layer-mono 'm 'fcl (list 'succ jv) sf)
                                       (fact 'subset-mem-fwd (mom-E (list 'succ jv)) (mom-E sf) yv)
                                       (ai (list 'NOT (list 'IN yv (mom-E sf)))))))))))
                       (let ((both (dk-cite! 'dist-layer-set-sep 'm 'fcl jv an af)))
                         (dk-split! both)
                         (ass))))))
              (mom-trich! kv lv
                (lambda () (side kv lv 0))
                (lambda () (ai (list 'NOT (list '= kv lv))))
                (lambda () (side lv kv 1)))))))
      ;; the prefix sums are at most L
      (let ((fin (dk-cite! 'metric-outer-measure-finite-separated 'm 'mu fsl)))
        (dk-have! (list 'IN lamr '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (dk-lam-b!)
                  (mom-mu-type! (mom-inter-pow! (mom-ring (sk kv))))
                  (ass))))))
        (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mom-fs lamr '(ORD-SEGMENT n)) mom-L)))
          (lambda ()
            (let* ((nv (dk-di-var!))
                   (un (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT nv) (list fsl 'uj_)))
                   (tn (list '* 2 nv))
                   (eq (dk-apply! fin nv)))
              (subst (list '= (mom-fs lamr (list 'ORD-SEGMENT nv)) (list 'mu un)))
              (mom-nn-type! tn)
              (let ((x (mom-inter-pow! (mom-E tn))))
                (dk-have! (list 'SUBSET un x)
                  (lambda ()
                    (mac 'subset-def)
                    (let* ((zv (dk-di-var!))
                           (landed (dk-landed (lambda () (bu-me (list 'IN zv un)))))
                           (qin (find-first (lambda (f) (and (eq? (car f) 'IN) (not (eq? (cadr f) zv)))) landed))
                           (qv (cadr qin))
                           (zin (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (cadr f) zv))) landed)))
                      (fact 'ord-segment-nn-subset nv qv)
                      (let ((zin2 (if (dk-contains? zin 'VNB-LAMBDA)
                                      (begin (dk-lam-b-h! zin)
                                             (list 'IN zv (mom-A (sk qv))))
                                      zin)))
                        (mac-h 'intersection-membership zin2)
                        (dk-split-all!)
                        (mac-h 'complement-in-membership (list 'IN zv (mom-ring (sk qv))))
                        (dk-split-all!)
                        (mom-nn-type! (sk qv))
                        (fact 'nn-succ-closed (sk qv))
                        (let ((iff (dk-cite! 'seg-mem-lt nv qv)))
                          (if (dk-head-is? iff 'IFF)
                              (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))))))
                        (fact 'nn-lt-succ-le qv nv)
                        (dk-have! (list '<= (list 'succ (sk qv)) tn) (lambda () (dk-nn! (list '<= (list 'succ qv) nv))))
                        (fact 'dist-layer-mono 'm 'fcl (list 'succ (sk qv)) tn)
                        (fact 'subset-mem-fwd (mom-E (list 'succ (sk qv))) (mom-E tn) zv)
                        (mac 'intersection-membership)
                        (dk-conj-close! dk-ass!)))))
                (dk-have! (list 'SUBSET un '(PTS m))
                  (lambda ()
                    (mac 'subset-def)
                    (let ((zv (dk-di-var!)))
                      (fact 'subset-mem-fwd un x zv)
                      (fact 'subset-mem-fwd x '(PTS m) zv)
                      (ass))))
                (mom-sub-pow! un)
                (mom-mu-type! un)
                (dk-apply! mono un x)
                (mom-le-L! tn)
                (mom-trans! (list 'mu un) (list 'mu x) mom-L)
                (ass)))))
        (fact 'esum-nn-le-of-prefixes lamr mom-L)
        ;; the clean sum is the same, termwise
        (dk-have! (list 'IN lamc '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (cadr (car (dk-peel!)))))
                  (mom-mu-type! (mom-inter-pow! (mom-ring (sk kv))))
                  (ass))))))
        (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list lamc 'k) (list lamr 'k))))
          (lambda ()
            (let ((kv (dk-di-var!)))
              (mom-mu-type! (mom-inter-pow! (mom-ring (sk kv))))
              (dk-lam-b!)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (begin
                    (fact 'rr-pos-star-le-refl (list 'mu (mom-A (sk kv))))
                    (ass))))))
        (fact 'esum-nn-le-termwise lamc lamr)
        (mom-esum-type! lamc)
        (mom-esum-type! lamr)
        (mom-trans! (list 'ESUM lamc) (list 'ESUM lamr) mom-L)
        (ass)))
    (qed name)))

(mom-ring-sum-proof! (lambda (k) (list '* 2 k)) 'dist-ring-even-sum-le)
(mom-ring-sum-proof! (lambda (k) (list 'succ (list '* 2 k))) 'dist-ring-odd-sum-le)
;;; LEMMA 4.28 itself
(define mom-X '(INTERSECTION aa (COMPLEMENT-IN (PTS m) fcl)))
(define mom-alam (list 'VNB-LAMBDA 'mok_ 'NN (list 'mu (mom-A 'mok_))))
(define mom-gev (list 'VNB-LAMBDA 'moq_ 'NN (list 'mu (mom-A '(* 2 moq_)))))
(define mom-god (list 'VNB-LAMBDA 'moq_ 'NN (list 'mu (mom-A '(succ (* 2 moq_))))))

;;; a lambda k |-> mu(aa n Y(k)) into [0, +inf]
(define (mom-mu-lam-type! lam set-of)
  (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (cadr (car (dk-peel!)))))
            (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
            (mom-mu-type! (mom-inter-pow! (set-of kv)))
            (ass)))))))

;;; the upper bound mu*(A n (X \ F)) <= L when L is finite
(define (mom-428-upper! mono subadd)
  (mom-mu-lam-type! mom-alam mom-ring)
  (mom-mu-lam-type! mom-gev (lambda (k) (mom-ring (list '* 2 k))))
  (mom-mu-lam-type! mom-god (lambda (k) (mom-ring (list 'succ (list '* 2 k)))))
  ;; ESUM of the rings is finite: <= L + L
  (let ((hyp-e #f)
        (mk (lambda (g sig)
              (list 'FORALL 'q (list 'IMPLIES '(IN q NN) (list '= (list g 'q) (list mom-alam (sig 'q))))))))
    (for-each
      (lambda (g sig)
        (dk-have! (mk g sig)
          (lambda ()
            (let ((qv (dk-di-var!)))
              (mom-nn-type! (sig qv))
              (mom-mu-type! (mom-inter-pow! (mom-ring (sig qv))))
              (if (not (dk-lam-b!)) (rfl))))))
      (list mom-gev mom-god)
      (list (lambda (q) (list '* 2 q)) (lambda (q) (list 'succ (list '* 2 q)))))
    (fact 'esum-nn-even-odd-le mom-alam mom-gev mom-god))
  (fact 'dist-ring-even-sum-le 'm 'mu 'fcl 'aa)
  (fact 'dist-ring-odd-sum-le 'm 'mu 'fcl 'aa)
  (mom-esum-type! mom-alam)
  (mom-esum-type! mom-gev)
  (mom-esum-type! mom-god)
  (let* ((ee (list 'ESUM mom-gev)) (eo (list 'ESUM mom-god)) (ea (list 'ESUM mom-alam))
         (e2 (mom-ep! ee eo)) (l2 (mom-ep! mom-L mom-L)))
    (mom-and4! (list 'IN ee 'RR-POS-STAR) (list 'IN eo 'RR-POS-STAR)
               (list 'IN mom-L 'RR-POS-STAR) (list 'IN mom-L 'RR-POS-STAR))
    (mom-and2! (list '<= ee mom-L) (list '<= eo mom-L))
    (fact 'eplus-mono ee eo mom-L mom-L)
    (mom-trans! ea e2 l2)
    (let ((e (dk-cite! 'eplus-real-defined mom-L mom-L)))
      (dk-have! (list 'IN (caddr e) 'RR) (lambda () (type-term)))
      (let ((le (dk-rewrite-h! (list '<= ea l2) l2 (caddr e))))
        (mom-and2! (list 'IN ea 'RR-POS-STAR) (list 'IN (caddr e) 'RR))
        (fact 'rr-pos-star-le-real-in-rr ea (caddr e)))))
  ;; for every eps: mu(X) <= L + eps
  (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= (list 'mu mom-X) (list 'eplus mom-L 'eps))))
    (lambda ()
      (dk-peel!)
      (let* ((ex (dk-cite! 'esum-nn-tail-small mom-alam 'eps))
             (nv (dk-skolem! ex 'top))
             (gcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ESUM) (dk-contains? f 'eps)))
                           "the tail clause"))
             (gset (list 'VNB-LAMBDA 'moj_ 'NN (mom-A (list '+ nv 'moj_))))
             (g (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list gset 'n_))))
             (bu (list 'BIG-UNION 'n_ 'NN (list gset 'n_)))
             (y (list 'INTERSECTION 'aa (mom-E nv))))
        (dk-have! (list 'IN gset (list 'FUN 'NN mom-pw))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((jv (cadr (car (dk-peel!)))))
                  (mom-nn-type! (list '+ nv jv))
                  (mom-inter-pow! (mom-ring (list '+ nv jv)))
                  (ass))))))
        (mom-mu-lam-type! g (lambda (j) (mom-ring (list '+ nv j))))
        (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '<= (list g 'j) (list mom-alam (list '+ nv 'j)))))
          (lambda ()
            (let ((jv (dk-di-var!)))
              (mom-nn-type! (list '+ nv jv))
              (mom-mu-type! (mom-inter-pow! (mom-ring (list '+ nv jv))))
              (if (not (dk-lam-b!))
                  (begin
                    (fact 'rr-pos-star-le-refl (list 'mu (mom-A (list '+ nv jv))))
                    (ass))))))
        (dk-apply! gcl g)
        ;; BU is a set of points
        (dk-have! (list 'SUBSET bu '(PTS m))
          (lambda ()
            (mac 'subset-def)
            (let* ((zv (dk-di-var!))
                   (landed (dk-landed (lambda () (bu-me (list 'IN zv bu)))))
                   (jin (find-first (lambda (f) (and (eq? (car f) 'IN) (not (eq? (cadr f) zv)))) landed))
                   (jv (cadr jin))
                   (zin (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (cadr f) zv))) landed)))
              (fact 'fun-apply-type-c gset 'NN mom-pw jv)
              (if (equal? zin (list 'IN zv (list gset jv)))
                  (begin (fact 'power-mem-in '(PTS m) (list gset jv) zv) (ass))
                  (begin
                    (mac-h 'intersection-membership zin)
                    (dk-split-all!)
                    (fact 'subset-mem-fwd 'aa '(PTS m) zv)
                    (ass))))))
        (mom-sub-pow! bu)
        (mom-mu-type! bu)
        (dk-apply! subadd gset)
        (mom-inter-pow! (mom-E nv))
        (mom-mu-type! y)
        ;; X is covered by (aa n E_n) u BU
        (let ((un (list 'UNION y bu)))
          (dk-have! (list 'SUBSET mom-X un)
            (lambda ()
              (mac 'subset-def)
              (let ((zv (dk-di-var!)))
                (mac-h 'intersection-membership (list 'IN zv mom-X))
                (dk-split-all!)
                (mac-h 'complement-in-membership (list 'IN zv '(COMPLEMENT-IN (PTS m) fcl)))
                (dk-split-all!)
                (mac 'union-membership)
                (use-em (list 'IN zv (mom-E nv))
                  (lambda ()
                    (oi-l)
                    (mac 'intersection-membership)
                    (dk-conj-close! dk-ass!))
                  (lambda ()
                    (let* ((ex2 (dk-cite! 'dist-layer-ring-cover 'm 'fcl nv zv))
                           (jv (dk-skolem! ex2)))
                      (oi-r)
                      (for-each
                        (lambda (l)
                          (dk-focus! l)
                          (if (not (sequent-node-grounded? l))
                              (if (not (dk-ass!))
                                  (begin
                                    (dk-lam-b!)
                                    (mac 'intersection-membership)
                                    (dk-conj-close! dk-ass!)))))
                        (dk-opened (lambda () (bu-mi jv))))))))))
          (dk-have! (list 'SUBSET un '(PTS m))
            (lambda ()
              (mac 'subset-def)
              (let ((zv (dk-di-var!)))
                (mac-h 'union-membership (list 'IN zv un))
                (dk-each-leaf! (lambda () (ai (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f zv))) "the union")))
                  (lambda ()
                    (if (dk-asm? (list 'IN zv y))
                        (fact 'subset-mem-fwd y '(PTS m) zv)
                        (fact 'subset-mem-fwd bu '(PTS m) zv))
                    (ass))))))
          (mom-sub-pow! un)
          (mom-mu-type! un)
          (mom-inter-pow! '(COMPLEMENT-IN (PTS m) fcl))
          (mom-mu-type! mom-X)
          (dk-apply! mono mom-X un)
          (fact 'outer-measure-binary-subadditive '(PTS m) 'mu y bu)
          (mom-le-L! nv)
          (fact 'rr-pos-rr-in-rr 'eps)
          (fact 'rr-lt-of-pos-rr 'eps)
          (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
          (dk-have! '(IN eps RR-POS-STAR)
            (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! '(IN eps RR) '(<= 0 eps))))
          (mom-esum-type! g)
          (mom-trans! (list 'mu bu) (list 'ESUM g) 'eps)
          (mom-and4! (list 'IN (list 'mu y) 'RR-POS-STAR) (list 'IN (list 'mu bu) 'RR-POS-STAR)
                     (list 'IN mom-L 'RR-POS-STAR) '(IN eps RR-POS-STAR))
          (mom-and2! (list '<= (list 'mu y) mom-L) (list '<= (list 'mu bu) 'eps))
          (fact 'eplus-mono (list 'mu y) (list 'mu bu) mom-L 'eps)
          (let ((s1 (mom-ep! (list 'mu y) (list 'mu bu))) (s2 (mom-ep! mom-L 'eps)))
            (mom-trans! (list 'mu un) s1 s2)
            (mom-trans! (list 'mu mom-X) (list 'mu un) s2)
            (ass))))))
  (fact 'rps-le-of-forall-eps (list 'mu mom-X) mom-L))

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'mu (list 'FORALL 'fcl
  (list 'IMPLIES '(IS-METRIC-OUTER-MEASURE m mu) (list 'IMPLIES '(IS-CLOSED m fcl)
    (list 'AND
      (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'SUBSET (mom-E 'n) (mom-E '(succ n)))))
      (list 'FORALL 'aa (list 'IMPLIES '(IN aa (POWER (PTS m)))
        (list '= (list 'mu mom-X) mom-L)))))))))))
(dk-peel!)
(let* ((parts (mom-all-parts!)) (mono (cadr parts)) (subadd (caddr parts)))
  (dk-project! '(SUBSET fcl (PTS m)) 'is-closed '(IS-CLOSED m fcl))
  (dk-conj-close!
    (lambda ()
      (if (dk-contains? (dk-goal) 'aa)
          (begin
            (dk-peel!)
            (mom-pow-subset! 'aa)
            (fact 'nn-is-set)
            (mom-L-type!)
            (mom-inter-pow! '(COMPLEMENT-IN (PTS m) fcl))
            (mom-mu-type! mom-X)
            ;; L <= mu(X): every E_k misses F
            (dk-have! (list 'FORALL 'mow_ (list 'IMPLIES (list 'IN 'mow_ (list 'IMAGE mom-imlam 'NN))
                         (list '<= 'mow_ (list 'mu mom-X))))
              (lambda ()
                (let* ((wv (dk-di-var!))
                       (iff (dk-fact! 'image-membership-iff mom-imlam 'NN wv)))
                  (ai iff)
                  (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                  (let* ((kv (dk-skolem! (caddr iff)))
                         (x (mom-inter-pow! (mom-E kv)))
                         (eqf (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) wv))) "the value")))
                    (mom-mu-type! x)
                    (let ((eq2 (dk-have! (list '= (list mom-imlam kv) (list 'mu x)) (lambda () (if (not (dk-lam-b!)) (rfl))))))
                      (subst (list '= wv (list mom-imlam kv)))
                      (subst (list '= (list mom-imlam kv) (list 'mu x)))
                      (dk-have! (list 'SUBSET x mom-X)
                        (lambda ()
                          (mac 'subset-def)
                          (let ((zv (dk-di-var!)))
                            (mac-h 'intersection-membership (list 'IN zv x))
                            (dk-split-all!)
                            (fact 'dist-layer-disjoint 'm 'fcl kv zv)
                            (dk-split! (dk-cite! 'dist-layer-mem-elim 'm 'fcl kv zv))
                            (mac 'intersection-membership)
                            (dk-conj-close!
                              (lambda ()
                                (if (not (dk-ass!))
                                    (begin
                                      (mac 'complement-in-membership)
                                      (dk-conj-close! dk-ass!))))))))
                      (dk-apply! mono x mom-X)
                      (ass))))))
            (let ((img (list 'IMAGE mom-imlam 'NN)))
              (mom-and2! (list 'IN (list 'mu mom-X) 'RR-POS-STAR)
                         (list 'FORALL 'mow_ (list 'IMPLIES (list 'IN 'mow_ img) (list '<= 'mow_ (list 'mu mom-X)))))
              (fact 'esup-least img (list 'mu mom-X)))
            ;; mu(X) <= L
            (let ((cases #f))
              (let ((disj (mom-rps-cases! mom-L)))
                (dk-each-leaf! (lambda () (ai disj))
                  (lambda ()
                    (if (dk-asm? (list '= mom-L 'POS-INF))
                        (begin
                          (fact 'rr-pos-star-below-pos-inf (list 'mu mom-X))
                          (dk-rewrite-h! (list '<= (list 'mu mom-X) 'POS-INF) 'POS-INF mom-L))
                        (begin
                          (dk-split-all!)
                          (mom-428-upper! mono subadd)))
                    (mom-antisymm! (list 'mu mom-X) mom-L)
                    (ass))))))
          (let ((nv (dk-di-var!)))
            (fact 'nn-succ-closed nv)
            (fact 'nn-le-succ nv)
            (fact 'dist-layer-mono 'm 'fcl nv (list 'succ nv))
