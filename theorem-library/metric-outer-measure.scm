(define (mom-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (mom-and3! p q r)
  (dk-have! (list 'AND p (list 'AND q r)) (lambda () (dk-conj-close! dk-ass!))))
(define (mom-and4! p q r s)
  (dk-have! (list 'AND p (list 'AND q (list 'AND r s))) (lambda () (dk-conj-close! dk-ass!))))

(define (mom-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))

(define (mom-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;;; (OR (AND (IN e RR) (<= 0 e)) (= e POS-INF)) for e in [0, +inf] in context
(define (mom-rps-cases! e)
  (let ((c (dk-cite! 'rr-pos-star-membership e)))
    (if (dk-head-is? c 'OR)
        c
        (begin
          (if (dk-head-is? c 'IFF)
              (begin (ai c) (detach! (list 'IMPLIES (cadr c) (caddr c))) (caddr c))
              (error "mom-rps-cases!: unexpected" c))))))

;;; peel a guarded universal prefix; the eigenvariables of the landed typings, in order
(define (mom-peel-ins!)
  (let* ((g0 (dk-goal))
         (bvs (let loop ((g g0) (acc '()))
                (if (and (pair? g) (eq? (car g) 'FORALL)) (loop (caddr g) (cons (cadr g) acc))
                    (if (and (pair? g) (eq? (car g) 'IMPLIES)) (loop (caddr g) acc) (reverse acc)))))
         (landed (dk-peel!))
         (ins (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (symbol? (cadr f)))) landed)))
    (let ((vs (map cadr ins)))
      (if (and (= (length vs) 2) (equal? (caddr (car ins)) (caddr (cadr ins)))) vs
          (let ((g1 (list-ref ins 0)) (g2 (list-ref ins 1)))
            ;; the first binder's guard class is mentioned in g0 before the second's
            (if (mom--before? (caddr g2) (caddr g1) g0) (list (cadr g2) (cadr g1)) vs))))))
(define (mom--before? a b tree)
  (let ((s (with-output-to-string (lambda () (write tree))))
        (sa (with-output-to-string (lambda () (write a))))
        (sb (with-output-to-string (lambda () (write b)))))
    (let ((ia (string-search-forward sa s 0)) (ib (string-search-forward sb s 0)))
      (and ia ib (< ia ib)))))

;;; any goal, from contradictory linear premises (0 < 0, refuted)
(define (mom-ex-falso! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

;;; x = y in [0, +inf] from x <= y, y <= x, both typed
(define (mom-antisymm! x y)
  (mom-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (mom-and2! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))

;;; x <= z from x <= y, y <= z, all typed
(define (mom-trans! x y z)
  (mom-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (mom-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))

;;; the distance term, and its typing in [0, +inf] (m a metric space, x z points)
(define (mom-d x z) (list (list 'DIST 'm) x z))
(define (mom-dist-rps! x z)
  (let ((d (mom-d x z)))
    (if (not (dk-asm? (list 'IN d 'RR-POS-STAR)))
        (begin
          (if (not (dk-asm? (list 'IN d 'RR))) (fact 'metric-dist-real 'm x z))
          (if (not (dk-asm? (list '<= 0 d))) (fact 'metric-pos 'm x z))
          (dk-have! (list 'IN d 'RR-POS-STAR)
            (lambda ()
              (mac 'rr-pos-star-membership)
              (mom-keep-prop! (list 'IN d 'RR) (list '<= 0 d))))))
    d))

;;; (SUBSET (SEP v RR-POS-STAR p) RR-POS-STAR)
(define (mom-sep-rps! s)
  (dk-have! (list 'SUBSET s 'RR-POS-STAR)
    (lambda ()
      (mac 'subset-def)
      (let ((v (dk-di-var!)))
        (sep-me (list 'IN v s))
        (dk-split-all!)
        (ass)))))

;;; =====================================================================
;;; (1) the distance of a point to a set, and between two sets.
;;; =====================================================================

(define mom-pts-set
  '(SEP mov_ RR-POS-STAR (FORSOME moz_ (AND (IN moz_ es) (= mov_ ((DIST m) x moz_))))))
(define mom-ss-set
  '(SEP mow_ RR-POS-STAR
     (FORSOME mox_ (AND (IN mox_ aa)
       (FORSOME moy_ (AND (IN moy_ bb) (= mow_ ((DIST m) mox_ moy_))))))))

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'x (list 'FORALL 'es
   (list '== '(PT-SET-DIST m x es) (list 'EINF mom-pts-set)))))))
(di)
(mac 'PT-SET-DIST)
(qrfl)
(qed 'pt-set-dist-unfold)

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'aa (list 'FORALL 'bb
   (list '== '(SET-DIST m aa bb) (list 'EINF mom-ss-set)))))))
(di)
(mac 'SET-DIST)
(qrfl)
(qed 'set-dist-unfold)

;;; r <= d(x, es) when r is below every distance from x to a point of es
(sp (make-wff '(FORALL m (FORALL x (FORALL es (FORALL r
   (IMPLIES (IN r RR-POS-STAR)
     (IMPLIES (FORALL mzz_ (IMPLIES (IN mzz_ es) (<= r ((DIST m) x mzz_))))
       (<= r (PT-SET-DIST m x es))))))))))
(dk-peel!)
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "the bound")))
  (mac 'PT-SET-DIST)
  (mom-sep-rps! mom-pts-set)
  (dk-have! (list 'FORALL 'mvx_ (list 'IMPLIES (list 'IN 'mvx_ mom-pts-set) '(<= r mvx_)))
    (lambda ()
      (let ((v (dk-di-var!)))
        (sep-me (list 'IN v mom-pts-set))
        (dk-split-all!)
        (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the witness"))
               (z (dk-skolem! ex)))
          (subst (list '= v (mom-d 'x z)))
          (dk-apply! hyp z)
          (ass)))))
  (fact 'einf-greatest mom-pts-set 'r)
  (ass))
(qed 'pt-set-dist-ge-intro)

;;; and conversely: below d(x, es) means below every distance to a point of es
(sp (make-wff '(FORALL m (IMPLIES (IS-METRIC-SPACE m) (FORALL x (FORALL es (FORALL r
   (IMPLIES (IN x (PTS m))
     (IMPLIES (SUBSET es (PTS m))
       (IMPLIES (IN r RR-POS-STAR)
         (IMPLIES (<= r (PT-SET-DIST m x es))
           (FORALL mzz_ (IMPLIES (IN mzz_ es) (<= r ((DIST m) x mzz_)))))))))))))))
(let ((zv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'es))) (dk-peel!)))))
  (fact 'subset-mem-fwd 'es '(PTS m) zv)
  (let ((d (mom-dist-rps! 'x zv)))
    (dk-have! (list 'IN d mom-pts-set)
      (lambda ()
        (in-sep! dk-ass!
          (lambda () (ew zv) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
    (mom-sep-rps! mom-pts-set)
    (fact 'einf-in mom-pts-set)
    (fact 'einf-lower mom-pts-set d)
    (fact 'pt-set-dist-unfold 'm 'x 'es)
    (dk-rewrite-h! '(<= r (PT-SET-DIST m x es)) '(PT-SET-DIST m x es) (list 'EINF mom-pts-set))
    (mom-trans! 'r (list 'EINF mom-pts-set) d)
    (ass)))
(qed 'pt-set-dist-ge-elim)

;;; d(aa, bb) > 0 from a positive real below every distance
(sp (make-wff '(FORALL m (FORALL aa (FORALL bb (FORALL r
   (IMPLIES (POS-RR r)
     (IMPLIES (FORALL mxx_ (IMPLIES (IN mxx_ aa)
                (FORALL myy_ (IMPLIES (IN myy_ bb) (<= r ((DIST m) mxx_ myy_))))))
       (NOT (= (SET-DIST m aa bb) 0))))))))))
(dk-peel!)
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "the bound")))
  (fact 'rr-pos-rr-in-rr 'r)
  (fact 'rr-lt-of-pos-rr 'r)
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-have! '(IN r RR-POS-STAR)
    (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! '(IN r RR) '(<= 0 r))))
  (mom-sep-rps! mom-ss-set)
  (dk-have! (list 'FORALL 'mvx_ (list 'IMPLIES (list 'IN 'mvx_ mom-ss-set) '(<= r mvx_)))
    (lambda ()
      (let ((v (dk-di-var!)))
        (sep-me (list 'IN v mom-ss-set))
        (dk-split-all!)
        (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the witness"))
               (xv (dk-skolem! ex))
               (ex2 (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the second witness"))
               (yv (dk-skolem! ex2)))
          (subst (list '= v (mom-d xv yv)))
          (dk-apply! hyp xv yv)
          (ass)))))
  (fact 'einf-greatest mom-ss-set 'r)
  (fact 'set-dist-unfold 'm 'aa 'bb)
  (let ((le (dk-rewrite-h! (list '<= 'r (list 'EINF mom-ss-set)) (list 'EINF mom-ss-set) '(SET-DIST m aa bb))))
    (di)
    (let ((le0 (dk-rewrite-h! le '(SET-DIST m aa bb) 0)))
      (dk-absurd! '(IN r RR) '(< 0 r) le0))))
(qed 'set-dist-pos-intro)

;;; and conversely: d(aa, bb) > 0 gives a positive real below every distance
(sp (make-wff '(FORALL m (IMPLIES (IS-METRIC-SPACE m) (FORALL aa (FORALL bb
   (IMPLIES (SUBSET aa (PTS m))
     (IMPLIES (SUBSET bb (PTS m))
       (IMPLIES (NOT (= (SET-DIST m aa bb) 0))
         (FORSOME r (AND (POS-RR r)
           (FORALL mxx_ (IMPLIES (IN mxx_ aa)
             (FORALL myy_ (IMPLIES (IN myy_ bb) (<= r ((DIST m) mxx_ myy_)))))))))))))))))
(dk-peel!)
(mom-sep-rps! mom-ss-set)
(fact 'einf-in mom-ss-set)
(fact 'set-dist-unfold 'm 'aa 'bb)
(let* ((e (list 'EINF mom-ss-set))
       (ne (dk-rewrite-h! '(NOT (= (SET-DIST m aa bb) 0)) '(SET-DIST m aa bb) e))
       ;; every distance is >= e
       (lower (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ aa)
                (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ bb) (list '<= e '((DIST m) mxx_ myy_))))))))
  (dk-have! lower
    (lambda ()
      (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs)))
        (fact 'subset-mem-fwd 'aa '(PTS m) xv)
        (fact 'subset-mem-fwd 'bb '(PTS m) yv)
        (let ((d (mom-dist-rps! xv yv)))
          (dk-have! (list 'IN d mom-ss-set)
            (lambda ()
              (in-sep! dk-ass!
                (lambda ()
                  (ew xv)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'FORSOME)
                          (begin (ew yv) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                          (if (not (dk-ass!)) (rfl)))))))))
          (fact 'einf-lower mom-ss-set d)
          (ass)))))
  (let ((cases #f))
    (let ((disj (mom-rps-cases! e)))
      (dk-each-leaf! (lambda () (ai disj))
        (lambda ()
          (if (dk-asm? (list '= e 'POS-INF))
              ;; e = +inf: r = 1 works, since 1 <= +inf <= every distance
              (begin
                (fact 'rr-one-in)
                (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                (fact 'rr-pos-rr-of-lt 1)
                (ew 1)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs)))
                          (fact 'subset-mem-fwd 'aa '(PTS m) xv)
                          (fact 'subset-mem-fwd 'bb '(PTS m) yv)
                          (let ((d (mom-dist-rps! xv yv)))
                            (dk-apply! lower xv yv)
                            (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
                            (dk-have! '(IN 1 RR-POS-STAR)
                              (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! '(IN 1 RR) '(<= 0 1))))
                            (fact 'rr-pos-star-below-pos-inf 1)
                            (let ((le1 (dk-rewrite-h! (list '<= e d) e 'POS-INF)))
                              (fact 'pos-inf-in-rr-pos-star)
                              (mom-trans! 1 'POS-INF d)
                              (ass))))))))
              ;; e real: e itself, positive since it is not 0
              (begin
                (dk-split-all!)
                (dk-have! (list 'POS-RR e)
                  (lambda ()
                    (mac 'pos-rr)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin (di) (dk-have! (list '= e 0) (lambda () (dk-ineq! (list '= 0 e) (list 'IN e 'RR)))) (ai ne)))))))
                (ew e)
                (dk-conj-close! dk-ass!))))))))
(qed 'set-dist-pos-elim)
