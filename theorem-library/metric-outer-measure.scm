;;; the cut sequence k |-> s(k) n Y, typed in FUN(NN, CLOSED-INTERVALS), covering U
(define (mom-cut-cover! sv y conj-pick uset)
  (let* ((sq (list 'VNB-LAMBDA 'mck_ 'NN (list 'INTERSECTION (list sv 'mck_) y))))
    (dk-have! (list 'IN sq '(FUN NN CLOSED-INTERVALS))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((kv (cadr (car (dk-peel!)))))
              (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
              (dk-split-all! (list (dk-cite! 'lebesgue-cut (list sv kv) 'c)))
              (ass))))))
    (dk-have! (list 'SUBSET uset (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)))
      (lambda ()
        (mac 'subset-def)
        (let* ((zv (dk-di-var!))
               (tz (list 'INTERSECTION 'ts y)))
          (fact 'subset-mem-fwd uset tz zv)
          (mac-h 'intersection-membership (list 'IN zv tz))
          (dk-split-all!)
          (fact 'subset-mem-fwd 'ts (list 'BIG-UNION 'cvn_ 'NN (list sv 'cvn_)) zv)
          (let* ((landed (dk-landed (lambda () (bu-me (list 'IN zv (list 'BIG-UNION 'cvn_ 'NN (list sv 'cvn_)))))))
                 (kin (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
                 (kv (cadr kin)))
            (for-each
              (lambda (l)
                (dk-focus! l)
                (if (not (sequent-node-grounded? l))
                    (if (not (dk-ass!))
                        (begin
                          (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                          (mac 'intersection-membership)
                          (dk-conj-close! dk-ass!)))))
              (dk-opened (lambda () (bu-mi kv))))))))
    sq))

(sp (make-wff (list 'FORALL 'ts (list 'FORALL 'c (list 'FORALL 'uu (list 'FORALL 'vv
  (mom-imps (list '(IN ts (POWER RR)) '(IN c RR)
                  (list 'SUBSET 'uu (list 'INTERSECTION 'ts (mom-H 'c)))
