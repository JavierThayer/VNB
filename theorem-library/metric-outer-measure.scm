;;; the separation used in the proof: A n F and A n E_n are 1/(n+1) apart
(define (mom-F-E-sep! av nv)
  (let ((af (list 'INTERSECTION av 'fcl)) (ae (list 'INTERSECTION av (mom-E nv))) (r (mom-r nv)))
    (mom-r-type! nv)
    (dk-have! (list 'FORALL 'mxx_ (list 'IMPLIES (list 'IN 'mxx_ af)
                (list 'FORALL 'myy_ (list 'IMPLIES (list 'IN 'myy_ ae) (list '<= r '((DIST m) mxx_ myy_))))))
      (lambda ()
        (let* ((vs (mom-peel-ins!)) (xv (car vs)) (yv (cadr vs)))
          (mac-h 'intersection-membership (list 'IN xv af))
          (mac-h 'intersection-membership (list 'IN yv ae))
          (dk-split-all!)
          (fact 'subset-mem-fwd 'fcl '(PTS m) xv)
          (let* ((el (dk-cite! 'dist-layer-mem-elim 'm 'fcl nv yv)))
            (dk-split! el)
            (let ((b (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f yv))) "y's bound")))
              (dk-apply! b xv)
              (fact 'metric-sym 'm xv yv)
              (subst (list '= (mom-d xv yv) (mom-d yv xv)))
              (ass))))))
    (fact 'set-dist-pos-intro 'm af ae r)))

;;; closed sets are Caratheodory measurable (the proof of Prop. 4.26)
(sp (make-wff '(FORALL m (FORALL mu (FORALL fcl
  (IMPLIES (IS-METRIC-OUTER-MEASURE m mu) (IMPLIES (IS-CLOSED m fcl)
    (IS-CARATHEODORY-MEASURABLE (PTS m) mu fcl))))))))
(dk-peel!)
(let* ((parts (mom-all-parts!)) (addcl (car parts)) (mono (cadr parts)))
  (dk-project! '(SUBSET fcl (PTS m)) 'is-closed '(IS-CLOSED m fcl))
  (dk-project! '(IS-OUTER-MEASURE (PTS m) mu) 'is-metric-outer-measure '(IS-METRIC-OUTER-MEASURE m mu))
  (let ((lim (dk-cite! 'metric-outer-layers-limit 'm 'mu 'fcl)))
    (dk-split! lim)
    (let ((limcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ESUP))) "the limit")))
      (dk-have! '(FORALL a_ (IMPLIES (IN a_ (POWER (PTS m)))
                   (<= (eplus (mu (INTERSECTION a_ fcl)) (mu (DIFFERENCE a_ fcl))) (mu a_))))
        (lambda ()
          (let* ((av (dk-di-var!))
                 (aav (dk--replace mom-imlam 'aa av))
                 (lv (dk--replace mom-L 'aa av))
                 (af (list 'INTERSECTION av 'fcl))
                 (ulam (list 'VNB-LAMBDA 'mok_ 'NN (list 'mu af)))
                 (uimg (list 'ESUP (list 'IMAGE ulam 'NN))))
            (fact 'power-mem-sethood '(PTS m) av)
            (dk-have! (list 'SUBSET av '(PTS m))
              (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (fact 'power-mem-in '(PTS m) av zv) (ass))))
            (dk-apply! limcl av)
            (fact 'difference-unfold av 'fcl)
            (subst (list '= (list 'DIFFERENCE av 'fcl) (list 'COMPLEMENT-IN av 'fcl)))
            (fact 'inter-complement-in-ambient av '(PTS m) 'fcl)
            (subst (list '= (list 'COMPLEMENT-IN av 'fcl) (list 'INTERSECTION av '(COMPLEMENT-IN (PTS m) fcl))))
            (subst (list '= (list 'mu (list 'INTERSECTION av '(COMPLEMENT-IN (PTS m) fcl))) lv))
            ;; the two sequences: constant mu(A n F), and mu(A n E_n)
            (let ((aa-saved #f))
              (dk-have! (list 'SUBSET af '(PTS m))
                (lambda ()
                  (mac 'subset-def)
                  (let ((zv (dk-di-var!)))
                    (mac-h 'intersection-membership (list 'IN zv af))
                    (dk-split-all!)
                    (fact 'subset-mem-fwd av '(PTS m) zv)
                    (ass))))
              (mom-sub-pow! af)
              (mom-mu-type! af)
              (mom-mu-type! av)
              (fact 'nn-is-set)
              (dk-have! (list 'IN ulam '(FUN NN RR-POS-STAR))
                (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass)))))
              (dk-have! (list 'IN aav '(FUN NN RR-POS-STAR))
                (lambda ()
                  (dk-lam-type!
                    (lambda ()
                      (let ((kv (cadr (car (dk-peel!)))))
                        (dk-have! (list 'SUBSET (list 'INTERSECTION av (mom-E kv)) '(PTS m))
                          (lambda ()
                            (mac 'subset-def)
                            (let ((zv (dk-di-var!)))
                              (mac-h 'intersection-membership (list 'IN zv (list 'INTERSECTION av (mom-E kv))))
                              (dk-split-all!)
                              (fact 'subset-mem-fwd av '(PTS m) zv)
                              (ass))))
                        (mom-sub-pow! (list 'INTERSECTION av (mom-E kv)))
                        (mom-mu-type! (list 'INTERSECTION av (mom-E kv)))
                        (ass))))))
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list ulam 'n) (list ulam '(succ n)))))
                (lambda ()
                  (let ((nv (dk-di-var!)))
                    (fact 'nn-succ-closed nv)
                    (if (not (dk-lam-b!))
                        (begin (fact 'rr-pos-star-le-refl (list 'mu af)) (ass))))))
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list aav 'n) (list aav '(succ n)))))
                (lambda ()
                  (let* ((nv (dk-di-var!))
                         (x1 (list 'INTERSECTION av (mom-E nv)))
                         (x2 (list 'INTERSECTION av (mom-E (list 'succ nv)))))
                    (fact 'nn-succ-closed nv)
                    (fact 'nn-le-succ nv)
                    (fact 'dist-layer-mono 'm 'fcl nv (list 'succ nv))
                    (dk-lam-b!)
                    (for-each
                      (lambda (x)
                        (dk-have! (list 'SUBSET x '(PTS m))
                          (lambda ()
                            (mac 'subset-def)
                            (let ((zv (dk-di-var!)))
                              (mac-h 'intersection-membership (list 'IN zv x))
                              (dk-split-all!)
                              (fact 'subset-mem-fwd av '(PTS m) zv)
                              (ass))))
                        (mom-sub-pow! x))
                      (list x1 x2))
                    (dk-have! (list 'SUBSET x1 x2)
                      (lambda ()
                        (mac 'subset-def)
                        (let ((zv (dk-di-var!)))
                          (mac-h 'intersection-membership (list 'IN zv x1))
                          (dk-split-all!)
                          (fact 'subset-mem-fwd (mom-E nv) (mom-E (list 'succ nv)) zv)
                          (mac 'intersection-membership)
                          (dk-conj-close! dk-ass!))))
                    (dk-apply! mono x1 x2)
                    (ass))))
              ;; each term: mu(A n F) + mu(A n E_n) = mu((A n F) u (A n E_n)) <= mu(A)
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
                          (list '<= (list 'eplus (list ulam 'n) (list aav 'n)) (list 'mu av))))
                (lambda ()
                  (let* ((nv (dk-di-var!))
                         (ae (list 'INTERSECTION av (mom-E nv)))
                         (un (list 'UNION af ae)))
                    (dk-lam-b!)
                    (dk-have! (list 'SUBSET ae '(PTS m))
                      (lambda ()
                        (mac 'subset-def)
                        (let ((zv (dk-di-var!)))
                          (mac-h 'intersection-membership (list 'IN zv ae))
                          (dk-split-all!)
                          (fact 'subset-mem-fwd av '(PTS m) zv)
                          (ass))))
                    (mom-sub-pow! ae)
                    (mom-F-E-sep! av nv)
                    (dk-apply! addcl af ae)
                    (subst (list '= (list 'eplus (list 'mu af) (list 'mu ae)) (list 'mu un)))
                    (dk-have! (list 'SUBSET un av)
                      (lambda ()
                        (mac 'subset-def)
                        (let ((zv (dk-di-var!)))
                          (mac-h 'union-membership (list 'IN zv un))
                          (dk-each-leaf! (lambda () (ai (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f zv))) "the union")))
                            (lambda ()
                              (let ((part (if (dk-asm? (list 'IN zv af)) af ae)))
                                (mac-h 'intersection-membership (list 'IN zv part))
                                (dk-split-all!)
                                (ass)))))))
                    (dk-have! (list 'SUBSET un '(PTS m))
                      (lambda ()
                        (mac 'subset-def)
                        (let ((zv (dk-di-var!)))
                          (fact 'subset-mem-fwd un av zv)
                          (fact 'subset-mem-fwd av '(PTS m) zv)
                          (ass))))
                    (mom-sub-pow! un)
                    (dk-apply! mono un av)
                    (ass))))
              (fact 'esup-eplus-le ulam aav (list 'mu av))
              ;; mu(A n F) is the first term of the constant sequence
              (fact 'nn-zero-in)
              (let* ((uimgset (list 'IMAGE ulam 'NN))
                     (iff (dk-fact! 'image-membership-iff ulam 'NN (list 'mu af))))
                (dk-have! (caddr iff)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (let ((g (dk-goal)))
                          (cond ((equal? g (list 'IN (list 'mu af) 'SET))
                                 (fact 'membership-implies-sethood (list 'mu af) 'RR-POS-STAR) (ass))
                                ((eq? (car g) 'FORSOME)
                                 (ew 0)
                                 (dk-conj-close!
                                   (lambda () (if (not (dk-ass!)) (if (not (dk-lam-b!)) (rfl))))))
                                (#t (ass))))))))
                (ai iff)
                (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
                (dk-have! (list 'SUBSET uimgset 'RR-POS-STAR)
                  (lambda ()
                    (mac 'subset-def)
                    (let ((wv (dk-di-var!)))
                      (fact 'image-subset-codomain 'NN 'RR-POS-STAR ulam wv)
                      (ass))))
                (fact 'esup-in uimgset)
                (fact 'esup-upper uimgset (list 'mu af))
                (dk-have! (list 'SUBSET (list 'IMAGE aav 'NN) 'RR-POS-STAR)
                  (lambda ()
                    (mac 'subset-def)
                    (let ((wv (dk-di-var!)))
                      (fact 'image-subset-codomain 'NN 'RR-POS-STAR aav wv)
                      (ass))))
                (fact 'esup-in (list 'IMAGE aav 'NN))
                (mom-and4! (list 'IN (list 'mu af) 'RR-POS-STAR) (list 'IN lv 'RR-POS-STAR)
                           (list 'IN uimg 'RR-POS-STAR) (list 'IN lv 'RR-POS-STAR))
                (fact 'rr-pos-star-le-refl lv)
                (mom-and2! (list '<= (list 'mu af) uimg) (list '<= lv lv))
                (fact 'eplus-mono (list 'mu af) lv uimg lv)
                (mom-ep! (list 'mu af) lv)
                (mom-ep! uimg lv)
                (mom-trans! (list 'eplus (list 'mu af) lv) (list 'eplus uimg lv) (list 'mu av))
                (ass)))))))
    (fact 'caratheodory-superadditive-suffices '(PTS m) 'mu 'fcl)
    (ass)))
(qed 'metric-outer-closed-measurable)

;;; open sets are measurable: their complements are closed
(sp (make-wff '(FORALL m (FORALL mu (FORALL ou
  (IMPLIES (IS-METRIC-OUTER-MEASURE m mu) (IMPLIES (IS-OPEN m ou)
    (IS-CARATHEODORY-MEASURABLE (PTS m) mu ou))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE m) 'is-metric-outer-measure '(IS-METRIC-OUTER-MEASURE m mu))
(dk-project! '(IS-OUTER-MEASURE (PTS m) mu) 'is-metric-outer-measure '(IS-METRIC-OUTER-MEASURE m mu))
(dk-project! '(SUBSET ou (PTS m)) 'is-open '(IS-OPEN m ou))
(dk-project! '(IN (PTS m) SET) 'is-outer-measure '(IS-OUTER-MEASURE (PTS m) mu))
(let* ((cu '(COMPLEMENT-IN (PTS m) ou))
       (cc2 (list 'COMPLEMENT-IN '(PTS m) cu))
       (csets '(CARATHEODORY-SETS (PTS m) mu)))
  (fact 'complement-in-double '(PTS m) 'ou)
  (fact 'complement-in-subset 'ou '(PTS m))
  (dk-have! (list 'IS-CLOSED 'm cu)
    (lambda ()
      (mac 'is-closed)
      (subst (list '= cc2 'ou))
      (dk-conj-close! dk-ass!)))
  (fact 'metric-outer-closed-measurable 'm 'mu cu)
  (fact 'power-complement-closed '(PTS m) 'ou)
  (dk-have! (list 'IN cu csets)
    (lambda () (mac 'caratheodory-sets-membership) (dk-conj-close! dk-ass!)))
  (fact 'caratheodory-measurable-sigma-algebra '(PTS m) 'mu)
  (fact 'sigma-algebra-complement-closed '(PTS m) csets cu)
  (let ((m2 (dk-rewrite-h! (list 'IN cc2 csets) cc2 'ou)))
    (mac-h 'caratheodory-sets-membership m2)
    (dk-split-all!)
    (ass)))
(qed 'metric-outer-open-measurable)

;;; the Borel sets: unfold, and PROPOSITION 4.26
(define mom-opens '(SEP mou_ (POWER (PTS m)) (IS-OPEN m mou_)))
(sp (make-wff (list 'FORALL 'm (list '== '(BOREL-SETS m) (list 'SIGMA-GENERATED '(PTS m) mom-opens)))))
(di)
(mac 'BOREL-SETS)
(qrfl)
(qed 'borel-sets-unfold)

(sp (make-wff '(FORALL m (FORALL mu (IMPLIES (IS-METRIC-OUTER-MEASURE m mu)
  (FORALL bs (IMPLIES (IN bs (BOREL-SETS m)) (IS-CARATHEODORY-MEASURABLE (PTS m) mu bs))))))))
(dk-peel!)
(dk-project! '(IS-OUTER-MEASURE (PTS m) mu) 'is-metric-outer-measure '(IS-METRIC-OUTER-MEASURE m mu))
(let ((csets '(CARATHEODORY-SETS (PTS m) mu))
      (gen (list 'SIGMA-GENERATED '(PTS m) mom-opens)))
  (fact 'borel-sets-unfold 'm)
  (dk-rewrite-h! '(IN bs (BOREL-SETS m)) '(BOREL-SETS m) gen)
  (fact 'caratheodory-measurable-sigma-algebra '(PTS m) 'mu)
  (dk-have! (list 'SUBSET mom-opens csets)
    (lambda ()
      (mac 'subset-def)
      (let ((uv (dk-di-var!)))
        (sep-me (list 'IN uv mom-opens))
        (dk-split-all!)
        (fact 'metric-outer-open-measurable 'm 'mu uv)
        (mac 'caratheodory-sets-membership)
        (dk-conj-close! dk-ass!))))
  (fact 'sigma-generated-in-every '(PTS m) mom-opens 'bs csets)
  (mac-h 'caratheodory-sets-membership (list 'IN 'bs csets))
  (dk-split-all!)
  (ass))
(qed 'borel-sets-caratheodory-measurable)
;;; =====================================================================
;;; (9) LEBESGUE OUTER MEASURE IS A METRIC OUTER MEASURE ON RR-MS.
;;;     Route (approved by the coordinator 2026-10-09, departing from the brief): the
;;;     half-lines (-inf, c] and [c, +inf) are lam*-measurable directly (one cut point:
;;;     no re-indexing of covers); separated A, B are split by a countable union G of
;;;     grid cells of width d(A, B) meeting A, which is measurable; then
;;;     lam*(A u B) = lam*(A) + lam*(B) by the measurability of G.
;;; =====================================================================

(define mom-plam '(VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_)))
(define mom-lst (list 'METHOD-I-OUTER 'RR 'CLOSED-INTERVALS mom-plam))
(define (mom-H c) (list 'SEP 'mhx_ 'RR (list '<= 'mhx_ c)))
(define (mom-K c) (list 'SEP 'mhx_ 'RR (list '<= c 'mhx_)))

;;; unfold the membership F = (IN w X) in context to linear atoms; returns #f when the
;;; leaf got closed (w in EMPTY-SET)
(define (mom-unfold-mem! f)
  (let* ((w (cadr f)) (x (caddr f)) (h (if (pair? x) (car x) x)))
    (cond ((eq? h 'INTERSECTION)
           (mac-h 'intersection-membership f)
           (dk-split-all!)
           (and (mom-unfold-mem! (list 'IN w (cadr x))) (mom-unfold-mem! (list 'IN w (caddr x)))))
          ((memq h '(CCINT OOINT COINT OCINT))
           (mac-h (cdr (assq h '((CCINT . ccint-membership) (OOINT . ooint-membership)
                                 (COINT . coint-membership) (OCINT . ocint-membership)))) f)
           (dk-split-all!)
           #t)
          ((eq? h 'SEP)
           (sep-me f)
           (dk-split-all!)
           #t)
          ((eq? h 'EMPTY-SET)
           (fact 'empty-set-has-no-members w)
           (ai (list 'NOT f))
           #f)
          (#t #t))))

;;; the linear facts in context worth handing to ineq
(define (mom-arith-term? t)
  (or (symbol? t) (number? t)
      (and (pair? t) (memq (car t) '(+ - * binplus)) (every mom-arith-term? (cdr t)))))
(define (mom-lin-asms)
  (filter (lambda (f) (and (pair? f)
                           (not (dk-contains? f 'eplus)) (not (dk-contains? f 'POS-INF))
                           (or (memq (car f) '(<= <))
                               (and (eq? (car f) '=) (mom-arith-term? (cadr f)) (mom-arith-term? (caddr f))
                                    (not (memq (cadr f) '(EMPTY-SET RR NN))) (not (memq (caddr f) '(EMPTY-SET RR NN))))
                               (and (eq? (car f) 'IN) (eq? (caddr f) 'RR)))))
          (dk-asms)))
(define (mom-lin! . extra)
  (if (not (dk-ass!)) (apply dk-ineq! (append extra (mom-lin-asms)))))

;;; prove the goal (IN w X) from the atoms in context
(define (mom-prove-mem!)
  (let* ((g (dk-goal)) (w (cadr g)) (x (caddr g)) (h (if (pair? x) (car x) x)))
    (cond ((dk-ass!) #t)
          ((eq? h 'INTERSECTION)
           (mac 'intersection-membership)
           (dk-conj-close! mom-prove-mem!))
          ((memq h '(CCINT OOINT COINT OCINT))
           (mac (cdr (assq h '((CCINT . ccint-membership) (OOINT . ooint-membership)
                               (COINT . coint-membership) (OCINT . ocint-membership)))))
           (dk-conj-close! mom-lin!))
          ((eq? h 'SEP)
           (in-sep! mom-prove-mem! mom-lin!))
          ((eq? h 'EMPTY-SET)
           (apply mom-ex-falso! (mom-lin-asms)))
          ((eq? h 'RR) (mom-lin!))
          (#t (error "mom-prove-mem!: cannot prove" (expression->string g))))))

;;; (= lhs rhs) for sets of reals given by intervals and half-lines, by extensionality
(define (mom-set-eq! lhs rhs)
  (dk-have! (list 'FORALL 'mw_ (list 'IFF (list 'IN 'mw_ lhs) (list 'IN 'mw_ rhs)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (for-each
          (lambda (l)
            (dk-focus! l)
            (if (not (sequent-node-grounded? l))
                (let ((hyp (if (equal? (dk-goal) (list 'IN w rhs)) (list 'IN w lhs) (list 'IN w rhs))))
                  (if (mom-unfold-mem! hyp)
                      (mom-prove-mem!)))))
          (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality lhs rhs))

(define (mom-ext-thm! hyps lhs rhs name)
  (sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'c
     (mom-imps (append '((IN a RR) (IN b RR) (IN c RR)) hyps) (list '= lhs rhs)))))))
  (dk-peel!)
  (mom-set-eq! lhs rhs)
  (ass)
  (qed name))

(mom-ext-thm! '((<= c b)) (list 'INTERSECTION '(CCINT a b) (mom-H 'c)) '(CCINT a c) 'ccint-inter-left-ray)
(mom-ext-thm! '((<= b c)) (list 'INTERSECTION '(CCINT a b) (mom-H 'c)) '(CCINT a b) 'ccint-inter-left-ray-all)
(mom-ext-thm! '((<= a c)) (list 'INTERSECTION '(CCINT a b) (mom-K 'c)) '(CCINT c b) 'ccint-inter-right-ray)
(mom-ext-thm! '((<= c a)) (list 'INTERSECTION '(CCINT a b) (mom-K 'c)) '(CCINT a b) 'ccint-inter-right-ray-all)
(mom-ext-thm! '((< b a)) '(CCINT a b) 'EMPTY-SET 'ccint-empty-of-lt)
(mom-ext-thm! '() (list 'INTERSECTION 'EMPTY-SET (mom-H 'c)) 'EMPTY-SET 'empty-inter-left-ray)
(mom-ext-thm! '() (list 'INTERSECTION 'EMPTY-SET (mom-K 'c)) 'EMPTY-SET 'empty-inter-right-ray)
;;; CLOSED-INTERVALS: unfold, [a, b] is a member, the empty set and its length
(define (mom-ci-body) (caddr (dk-cite! 'closed-intervals-def)))
(define (mom-ci-unfold!)
  (let ((body (mom-ci-body)))
    (subst (list '= 'CLOSED-INTERVALS body))
    body))

(sp (make-wff '(FORALL a (FORALL b (IMPLIES (IN a RR) (IMPLIES (IN b RR) (IMPLIES (<= a b)
   (IN (CCINT a b) CLOSED-INTERVALS))))))))
(dk-peel!)
(let ((ab '(CCINT a b)))
  (fact 'ccint-subset-rr 'a 'b)
  (fact 'rr-is-set)
  (fact 'subclass-of-set-is-set ab 'RR)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ab) '(IN z_ RR)))
    (lambda () (let ((zv (dk-di-var!))) (fact 'subset-mem-fwd ab 'RR zv) (ass))))
  (fact 'power-mem-intro 'RR ab)
  (mom-ci-unfold!)
  (in-sep! dk-ass!
    (lambda () (oi-r) (ew 'a)
      (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 'b) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))))))
(qed 'ccint-in-closed-intervals)

;;; the parts of the pre-measure we use: plam in FUN(CI, RR-POS-STAR), EMPTY-SET in CI, plam(EMPTY-SET) = 0
(define (mom-lp-parts!)
  (if (not (dk-asm? '(IN EMPTY-SET CLOSED-INTERVALS)))
      (let ((pm (list 'IS-PREMEASURE 'RR 'CLOSED-INTERVALS mom-plam)))
        (fact 'lebesgue-premeasure)
        (dk-project! '(IN EMPTY-SET CLOSED-INTERVALS) 'is-premeasure pm)
        (dk-project! (list 'IN mom-plam '(FUN CLOSED-INTERVALS RR-POS-STAR)) 'is-premeasure pm)
        (dk-project! (list '= (list mom-plam 'EMPTY-SET) 0) 'is-premeasure pm))))

;;; THE CUT: a closed interval cut at c gives two closed intervals whose lengths add up
(sp (make-wff (list 'FORALL 's (list 'FORALL 'c (list 'IMPLIES '(IN s CLOSED-INTERVALS) (list 'IMPLIES '(IN c RR)
  (list 'AND (list 'IN (list 'INTERSECTION 's (mom-H 'c)) 'CLOSED-INTERVALS)
    (list 'AND (list 'IN (list 'INTERSECTION 's (mom-K 'c)) 'CLOSED-INTERVALS)
      (list '<= (list 'eplus (list mom-plam (list 'INTERSECTION 's (mom-H 'c)))
                             (list mom-plam (list 'INTERSECTION 's (mom-K 'c))))
                (list mom-plam 's))))))))))
(dk-peel!)
(mom-lp-parts!)
(fact 'zero-in-rr-pos-star)
(fact 'rr-zero-in)
(let* ((body (mom-ci-body))
       (m1 (dk-rewrite-h! '(IN s CLOSED-INTERVALS) 'CLOSED-INTERVALS body)))
  (sep-me m1)
  (dk-split-all!)
  (let ((orf (dk-pick (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'EMPTY-SET))) "the cases")))
    (dk-each-leaf! (lambda () (ai orf))
      (lambda ()
        (if (dk-asm? '(= s EMPTY-SET))
            (begin
              (subst '(= s EMPTY-SET))
              (fact 'empty-inter-left-ray 0 0 'c)
              (fact 'empty-inter-right-ray 0 0 'c)
              (subst (list '= (list 'INTERSECTION 'EMPTY-SET (mom-H 'c)) 'EMPTY-SET))
              (subst (list '= (list 'INTERSECTION 'EMPTY-SET (mom-K 'c)) 'EMPTY-SET))
              (subst (list '= (list mom-plam 'EMPTY-SET) 0))
              (fact 'eplus-zero-left 0)
              (subst '(= (eplus 0 0) 0))
              (fact 'rr-pos-star-le-refl 0)
              (dk-conj-close! dk-ass!))
            (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "a"))
                   (av (dk-skolem! ex))
                   (ex2 (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "b"))
                   (bv (dk-skolem! ex2))
                   (ab (list 'CCINT av bv))
                   (len (lambda (x y) (list mom-plam (list 'CCINT x y)))))
              (subst (list '= 's ab))
              (fact 'ccint-in-closed-intervals av bv)
              (let* ((case-mid
                       (lambda ()
                         (dk-have! (list '<= 'c bv) (lambda () (mom-lin!)))
                         (dk-have! (list '<= av 'c) (lambda () (mom-lin!)))
                         (fact 'ccint-inter-left-ray av bv 'c)
                         (fact 'ccint-inter-right-ray av bv 'c)
                         (subst (list '= (list 'INTERSECTION ab (mom-H 'c)) (list 'CCINT av 'c)))
                         (subst (list '= (list 'INTERSECTION ab (mom-K 'c)) (list 'CCINT 'c bv)))
                         (fact 'ccint-in-closed-intervals av 'c)
                         (fact 'ccint-in-closed-intervals 'c bv)
                         (fact 'interval-length-ccint av 'c)
                         (fact 'interval-length-ccint 'c bv)
                         (fact 'interval-length-ccint av bv)
                         (subst (list '= (len av 'c) (list '- 'c av)))
                         (subst (list '= (len 'c bv) (list '- bv 'c)))
                         (subst (list '= (len av bv) (list '- bv av)))
                         (dk-have! (list 'IN (list '- 'c av) 'RR) (lambda () (type-term)))
                         (dk-have! (list 'IN (list '- bv 'c) 'RR) (lambda () (type-term)))
                         (dk-have! (list '<= 0 (list '- 'c av)) (lambda () (mom-lin!)))
                         (dk-have! (list '<= 0 (list '- bv 'c)) (lambda () (mom-lin!)))
                         (let ((e (dk-cite! 'eplus-real-defined (list '- 'c av) (list '- bv 'c))))
                           (subst e)
                           (let ((bp (dk-cite! 'binplus-apply (list '- 'c av) (list '- bv 'c))))
                             (subst bp))
                           (dk-conj-close! (lambda () (if (not (dk-ass!)) (mom-lin!)))))))
                     (case-low
                       (lambda ()
                         (dk-have! (list '<= 'c bv) (lambda () (mom-lin!)))
                         (dk-have! (list '<= 'c av) (lambda () (mom-lin!)))
                         (fact 'ccint-inter-left-ray av bv 'c)
                         (fact 'ccint-inter-right-ray-all av bv 'c)
                         (fact 'ccint-empty-of-lt av 'c 0)
                         (subst (list '= (list 'INTERSECTION ab (mom-H 'c)) (list 'CCINT av 'c)))
                         (subst (list '= (list 'CCINT av 'c) 'EMPTY-SET))
                         (subst (list '= (list 'INTERSECTION ab (mom-K 'c)) ab))
                         (subst (list '= (list mom-plam 'EMPTY-SET) 0))
                         (fact 'fun-apply-type-c mom-plam 'CLOSED-INTERVALS 'RR-POS-STAR ab)
                         (fact 'eplus-zero-left (list mom-plam ab))
                         (subst (list '= (list 'eplus 0 (list mom-plam ab)) (list mom-plam ab)))
                         (fact 'rr-pos-star-le-refl (list mom-plam ab))
                         (dk-conj-close! dk-ass!)))
                     (case-high
                       (lambda ()
                         (dk-have! (list '<= bv 'c) (lambda () (mom-lin!)))
                         (dk-have! (list '<= av 'c) (lambda () (mom-lin!)))
                         (fact 'ccint-inter-left-ray-all av bv 'c)
                         (fact 'ccint-inter-right-ray av bv 'c)
                         (fact 'ccint-empty-of-lt 'c bv 0)
                         (subst (list '= (list 'INTERSECTION ab (mom-H 'c)) ab))
                         (subst (list '= (list 'INTERSECTION ab (mom-K 'c)) (list 'CCINT 'c bv)))
                         (subst (list '= (list 'CCINT 'c bv) 'EMPTY-SET))
                         (subst (list '= (list mom-plam 'EMPTY-SET) 0))
                         (fact 'fun-apply-type-c mom-plam 'CLOSED-INTERVALS 'RR-POS-STAR ab)
                         (fact 'eplus-zero-right (list mom-plam ab))
                         (subst (list '= (list 'eplus (list mom-plam ab) 0) (list mom-plam ab)))
                         (fact 'rr-pos-star-le-refl (list mom-plam ab))
                         (dk-conj-close! dk-ass!))))
                (mom-trich! 'c av
                  case-low
                  case-mid
                  (lambda () (mom-trich! bv 'c case-high case-mid case-mid))))))))))
(qed 'lebesgue-cut)

;;; superadditivity of ESUM over NN: f + g <= h termwise gives ESUM f + ESUM g <= ESUM h
(define mom-fg '(VNB-LAMBDA oak_ NN (eplus (f oak_) (g oak_))))
(define (mom-real-le! x hh)
  ;; x in RR-POS-STAR, x <= hh, hh in RR: x in RR
  (if (not (dk-asm? (list 'IN x 'RR)))
      (begin
        (mom-and2! (list 'IN x 'RR-POS-STAR) (list 'IN hh 'RR))
        (fact 'rr-pos-star-le-real-in-rr x hh)))
  (if (not (dk-asm? (list '<= 0 x))) (fact 'rr-pos-star-nonneg x)))
(define (mom-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda () (mac 'rr-pos-star-membership) (mom-keep-prop! (list 'IN x 'RR) (list '<= 0 x))))))

(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
  (mom-imps (list '(IN f (FUN NN RR-POS-STAR)) '(IN g (FUN NN RR-POS-STAR)) '(IN h (FUN NN RR-POS-STAR))
                  '(FORALL k (IMPLIES (IN k NN) (<= (eplus (f k) (g k)) (h k)))))
    '(<= (eplus (ESUM f) (ESUM g)) (ESUM h))))))))
(dk-peel!)
(mom-esum-type! 'f)
(mom-esum-type! 'g)
(mom-esum-type! 'h)
(mom-ep! '(ESUM f) '(ESUM g))
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(h k)))) "termwise"))
      (disj (mom-rps-cases! '(ESUM h))))
  (dk-each-leaf! (lambda () (ai disj))
    (lambda ()
      (if (dk-asm? '(= (ESUM h) POS-INF))
          (begin
            (fact 'rr-pos-star-below-pos-inf '(eplus (ESUM f) (ESUM g)))
            (dk-rewrite-h! '(<= (eplus (ESUM f) (ESUM g)) POS-INF) 'POS-INF '(ESUM h))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))
          (let ((hh '(ESUM h)))
            (dk-split-all!)
            (fact 'nn-zero-in)
            (fact 'rps-prefix-zero 'f)
            (fact 'rps-prefix-zero 'g)
            ;; S1: P_n(f) + P_m(g) <= H
            (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
                        (list '<= (list 'eplus (mom-pre 'f 'n) (mom-pre 'g 'm)) hh)))))
              (lambda ()
                (let* ((vs (mom-peel-ins!)) (nv (car vs)) (mv (cadr vs)) (nn2 (list '+ nv mv)))
                  (mom-nn-type! nn2)
                  (dk-have! (list '<= nv nn2) (lambda () (dk-nn!)))
                  (dk-have! (list '<= mv nn2) (lambda () (dk-nn!)))
                  (fact 'rps-prefix-mono nn2 'f nv)
                  (fact 'rps-prefix-mono nn2 'g mv)
                  (for-each (lambda (fv kv) (fact 'rps-prefix-type fv kv))
                            (list 'f 'g 'f 'g) (list nv mv nn2 nn2))
                  (mom-and4! (list 'IN (mom-pre 'f nv) 'RR-POS-STAR) (list 'IN (mom-pre 'g mv) 'RR-POS-STAR)
                             (list 'IN (mom-pre 'f nn2) 'RR-POS-STAR) (list 'IN (mom-pre 'g nn2) 'RR-POS-STAR))
                  (mom-and2! (list '<= (mom-pre 'f nv) (mom-pre 'f nn2)) (list '<= (mom-pre 'g mv) (mom-pre 'g nn2)))
                  (fact 'eplus-mono (mom-pre 'f nv) (mom-pre 'g mv) (mom-pre 'f nn2) (mom-pre 'g nn2))
                  (dk-have! (list 'IN mom-fg '(FUN NN RR-POS-STAR))
                    (lambda ()
                      (dk-lam-type!
                        (lambda ()
                          (let ((kv (cadr (car (dk-peel!)))))
                            (mom-app-type! 'f kv) (mom-app-type! 'g kv)
                            (mom-ep! (list 'f kv) (list 'g kv))
                            (ass))))))
                  (fact 'rps-prefix-add nn2 'f 'g)
                  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list mom-fg 'k) '(h k))))
                    (lambda ()
                      (let ((kv (dk-di-var!)))
                        (mom-app-type! 'f kv) (mom-app-type! 'g kv)
                        (mom-ep! (list 'f kv) (list 'g kv))
                        (dk-lam-b!)
                        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-apply! hyp kv))
                        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
                  (fact 'rps-prefix-le-termwise nn2 mom-fg 'h)
                  (fact 'rps-prefix-type mom-fg nn2)
                  (fact 'rps-prefix-type 'h nn2)
                  (fact 'esum-nn-prefix-le 'h nn2)
                  (let ((s1 (mom-ep! (mom-pre 'f nv) (mom-pre 'g mv)))
                        (s2 (mom-ep! (mom-pre 'f nn2) (mom-pre 'g nn2))))
                    (dk-rewrite-h! (list '<= s1 s2) s2 (mom-pre mom-fg nn2))
                    (mom-trans! s1 (mom-pre mom-fg nn2) (mom-pre 'h nn2))
                    (mom-trans! s1 (mom-pre 'h nn2) hh)
                    (ass)))))
            (let ((s1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ORD-SEGMENT) (dk-contains? f hh)
                                               (not (dk-contains? f '(h k)))))
                               "S1")))
              ;; S2: ESUM g <= H - P_n(f)
              (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= '(ESUM g) (list '- hh (mom-pre 'f 'n)))))
                (lambda ()
                  (let* ((nv (dk-di-var!)) (pn (mom-pre 'f nv)))
                    (fact 'rps-prefix-type 'f nv)
                    (let ((z (dk-apply! s1 nv 0)))
                      (dk-rewrite-h! z (mom-pre 'g 0) 0)
                      (fact 'eplus-zero-right pn)
                      (dk-rewrite-h! (list '<= (list 'eplus pn 0) hh) (list 'eplus pn 0) pn))
                    (mom-real-le! pn hh)
                    (dk-have! (list 'IN (list '- hh pn) 'RR) (lambda () (type-term)))
                    (dk-have! (list '<= 0 (list '- hh pn)) (lambda () (dk-ineq! (list '<= pn hh) (list 'IN pn 'RR) (list 'IN hh 'RR))))
                    (mom-rps-of-real! (list '- hh pn))
                    (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list '<= (mom-pre 'g 'm) (list '- hh pn))))
                      (lambda ()
                        (let* ((mv (dk-di-var!)) (pm (mom-pre 'g mv)))
                          (fact 'rps-prefix-type 'g mv)
                          (let* ((part (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f pn)
                                                                 (dk-contains? f hh))) "s1 at n"))
                                 (le (dk-apply! part mv)))
                            (mom-ep! pn pm)
                            (mom-and2! (list 'IN pm 'RR-POS-STAR) (list 'IN pn 'RR-POS-STAR))
                            (fact 'eplus-le-left pm pn)
                            (mom-ep! pm pn)
                            (mom-and2! (list 'IN pn 'RR-POS-STAR) (list 'IN pm 'RR-POS-STAR))
                            (fact 'eplus-comm pm pn)
                            (dk-rewrite-h! (list '<= pm (list 'eplus pm pn)) (list 'eplus pm pn) (list 'eplus pn pm))
                            (mom-trans! pm (list 'eplus pn pm) hh)
                            (mom-real-le! pm hh)
                            (let ((e (dk-cite! 'eplus-real-defined pn pm)))
                              (let* ((le1 (dk-rewrite-h! le (cadr e) (caddr e)))
                                     (bp (dk-cite! 'binplus-apply pn pm))
                                     (le2 (dk-rewrite-h! le1 (cadr bp) (caddr bp))))
                                (dk-ineq! le2 (list 'IN pn 'RR) (list 'IN pm 'RR) (list 'IN hh 'RR))))))))
                    (fact 'esum-nn-le-of-prefixes 'g (list '- hh pn))
                    (ass))))
              (let ((s2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(ESUM g)))) "S2")))
                (let ((z (dk-apply! s2 0)))
                  (dk-rewrite-h! z (mom-pre 'f 0) 0))
                (dk-have! (list 'IN (list '- hh 0) 'RR) (lambda () (type-term)))
                (mom-real-le! '(ESUM g) (list '- hh 0))
                (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mom-pre 'f 'n) (list '- hh '(ESUM g)))))
                  (lambda ()
                    (let* ((nv (dk-di-var!)) (pn (mom-pre 'f nv)))
                      (fact 'rps-prefix-type 'f nv)
                      (let ((z (dk-apply! s2 nv)))
                        (dk-have! (list '<= pn hh)
                          (lambda ()
                            (let ((z0 (dk-apply! s1 nv 0)))
                              (dk-rewrite-h! z0 (mom-pre 'g 0) 0)
                              (fact 'eplus-zero-right pn)
                              (dk-rewrite-h! (list '<= (list 'eplus pn 0) hh) (list 'eplus pn 0) pn)
                              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))))
                        (mom-real-le! pn hh)
                        (dk-ineq! z (list 'IN pn 'RR) (list 'IN hh 'RR) '(IN (ESUM g) RR))))))
                (dk-have! (list 'IN (list '- hh '(ESUM g)) 'RR) (lambda () (type-term)))
                (dk-have! (list '<= 0 (list '- hh '(ESUM g)))
                  (lambda () (dk-ineq! (list '<= '(ESUM g) (list '- hh 0)) (list 'IN hh 'RR) '(IN (ESUM g) RR))))
                (mom-rps-of-real! (list '- hh '(ESUM g)))
                (fact 'esum-nn-le-of-prefixes 'f (list '- hh '(ESUM g)))
                (mom-real-le! '(ESUM f) (list '- hh '(ESUM g)))
                (let ((e (dk-cite! 'eplus-real-defined '(ESUM f) '(ESUM g))))
                  (subst e)
                  (subst (dk-cite! 'binplus-apply '(ESUM f) '(ESUM g)))
                  (dk-ineq! (list '<= '(ESUM f) (list '- hh '(ESUM g))) '(IN (ESUM f) RR) '(IN (ESUM g) RR) (list 'IN hh 'RR))))))))))
(qed 'esum-nn-superadditive)
;;; lam*(U) + lam*(V) <= lam*(T) when U lies in T n (-inf, c] and V in T n [c, +inf):
;;; every cover of T, cut at c, gives covers of U and of V whose sums add up to at most its own
(define (mom-cs es) (list 'COVER-SUMS 'RR 'CLOSED-INTERVALS mom-plam es))
(define (mom-lv es) (list mom-lst es))
;;; (SUBSET x RR) and (IN x (POWER RR)) from (SUBSET x y), (SUBSET y RR)
(define (mom-rr-pow! x . via)
  (if (not (dk-asm? (list 'IN x '(POWER RR))))
      (begin
        (if (not (dk-asm? (list 'SUBSET x 'RR)))
            (dk-have! (list 'SUBSET x 'RR)
              (lambda ()
                (mac 'subset-def)
                (let ((zv (dk-di-var!)))
                  (let loop ((cur x) (vs via))
                    (if (null? vs)
                        (ass)
