(mom-lp-parts!)
(fact 'rr-is-set)
(fact 'method-i-outer-type 'RR 'CLOSED-INTERVALS mom-plam)
(dk-have! '(SUBSET ts RR) (lambda () (mac 'subset-def) (let ((zv (dk-di-var!))) (fact 'power-mem-in 'RR 'ts zv) (ass))))
(mom-inter-rr! (mom-H 'c))
(mom-inter-rr! (mom-K 'c))
