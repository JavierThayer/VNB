;;; bo2-abs.scm -- ABSOLUTE SUMMABILITY IMPLIES SUMMABILITY, through the Cauchy criterion.
;;; Agent BA-ONB2, 2026-11-09 (scratchpad/triage/BA-ONB2.md, target 3).  Helper prefix: bo2-.
;;;
;;;   abs-summable-implies-summable-cn   the statement of absolute-summable-implies-summable
;;;                                      (rake-asm-b2.scm), re-proved from
;;;                                      summable-of-cauchy-net (hilbert-onb.scm).
;;;
;;; The old name stays where it is: rake-asm-b2 loads long before hilbert-onb, and its
;;; citers load before hilbert-onb too.  This is a second PROOF of the same statement under
;;; a new name (the user's rule of 2026-10-27: keep many versions and proofs).
;;;
;;; The proof: for eps > 0 take h = eps/2 and, by rb2-esum-approx, a finite t <= DOM f with
;;; E < P(t) + h, E = ESUM(i |-> ||f(i)||), P(w) the finite sum of the norms over w.  For
;;; finite a, b with t <= a, b <= DOM f, rb2-dist-subset gives d(S(t), S(a)) <= P(a) - P(t)
;;; and d(S(t), S(b)) <= P(b) - P(t); P(a), P(b) <= E (esum-upper); the triangle
;;; inequality gives d(S(a), S(b)) < eps.  That is the Cauchy-net hypothesis of
;;; summable-of-cauchy-net.
;;;
;;; LOAD WINDOW [hilbert-onb + 1, end): summable-of-cauchy-net is the latest citation;
;;; rb2-dist-subset / rb2-nrm-finsum-le / rb2-esum-approx are in rake-asm-b2 (earlier).
;;; Library: analysis.

(define (bo2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; bo2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))
        (error "bo2: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))

(define (bo2-hyp head what) (dk-pick (dk-head? head) what))
(define (bo2-V grp) (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
(define (bo2-P g w) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID g w))
(define (bo2-S grp f w) (list 'FINSUM (bo2-V grp) f w))
(define (bo2-N grp x) (list (list 'NRM grp) x))
(define (bo2-M grp) (list 'NAG-METRIC-SPACE grp))
(define (bo2-cq a)
  (and (pair? a) (eq? (car a) 'FORALL) (= (length a) 3)
       (let ((b (caddr a)))
         (and (pair? b) (eq? (car b) 'IMPLIES) (= (length b) 3) (caddr b)))))

(define (bo2-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (bo2-readoff! acc src view)
  (let* ((lhs (list acc (list view src)))
         (rhs (list acc src)))
    (dk-have! (list '== lhs rhs) (lambda () (bo2-slot-close! view acc)))
    (dk-have! (list '== rhs lhs) (lambda () (bo2-slot-close! view acc)))))
(define (bo2-rm-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))
(define (bo2-rm-readoffs!)
  (bo2-rm-readoff! '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
  (bo2-rm-readoff! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
  (bo2-rm-readoff! '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
  (bo2-rm-readoff! '(== RR-POS-STAR (CARR RR-POS-STAR-ADD-MONOID))))
(define (bo2-view-setup! grp)
  (fact 'normed-ag-as-abelian-group-is-abelian-group grp)
  (for-each (lambda (acc) (bo2-readoff! acc grp 'NORMED-AG-AS-ABELIAN-GROUP))
            '(CARR OPR IDEN INV)))

;; with (SUBSET w dd) in context and the pointwise typing over dd: f typed over w in CARR V
(define (bo2-ptw-f! grp f dd w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w)
                                       (list 'IN (list f 'z_) (list 'CARR (bo2-V grp)))))))
    (dk-have! claim
      (lambda ()
        (let* ((landed (dk-peel!))
               (z (cadr (car landed))))
          (fact 'subset-mem-fwd w dd z)
          (fact 'fun-apply-type-c f dd (list 'CARR grp) z)
          (subst (list '== (list 'CARR (bo2-V grp)) (list 'CARR grp)))
          (ass))))
    claim))
;; for finite w <= dd: P(w) in RR, S(w) in PTS M, 0 <= P(w)
(define (bo2-w-facts! grp f g dd w)
  (let* ((tl (dk-cite! 'rb2-nrm-finsum-le grp f g dd))
         (sw (bo2-S grp f w))
         (nsw (bo2-N grp sw))
         (pw (bo2-P g w)))
    (dk-split! (dk-apply! tl w))
    (bo2-ptw-f! grp f dd w)
    (fact 'finsum-type-ptwise (bo2-V grp) w f)
    (dk-have! (list 'IN sw (list 'CARR grp))
      (lambda () (subst (list '== (list 'CARR grp) (list 'CARR (bo2-V grp)))) (ass)))
    (dk-have! (list 'IN sw (list 'PTS (bo2-M grp)))
      (lambda () (subst (list '== (list 'PTS (bo2-M grp)) (list 'CARR grp))) (ass)))))
;; finite w <= D in context: P(w) <= E
(define (bo2-upper! g D w)
  (dk-have! (list 'AND (list 'IN w 'SET)
                  (list 'AND (list 'IN (list 'CARD w) 'NN) (list 'SUBSET w (list 'DOM g))))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (eq? (car (dk-goal)) 'SUBSET)
              (begin (subst (list '= (list 'DOM g) D)) (ass))
              (ass))))))
  (fact 'esum-upper g w))

;; the Cauchy-net clause of summable-of-cauchy-net (hilbert-onb.scm's onb-cn), literally
(define (bo2-cn-q grp f fin r)
  (list 'FORALL 'cna_ (list 'IMPLIES '(IN cna_ SET) (list 'IMPLIES '(IN (CARD cna_) NN)
    (list 'IMPLIES (list 'SUBSET fin 'cna_) (list 'IMPLIES (list 'SUBSET 'cna_ (list 'DOM f))
      (list 'FORALL 'cnb_ (list 'IMPLIES '(IN cnb_ SET) (list 'IMPLIES '(IN (CARD cnb_) NN)
        (list 'IMPLIES (list 'SUBSET fin 'cnb_) (list 'IMPLIES (list 'SUBSET 'cnb_ (list 'DOM f))
          (list '< (list (list 'DIST (bo2-M grp)) (bo2-S grp f 'cna_) (bo2-S grp f 'cnb_)) r))))))))))))
(define (bo2-cn grp f)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'fin
      (list 'AND (list 'IN 'fin 'SET)
        (list 'AND (list 'IN (list 'CARD 'fin) 'NN)
          (list 'AND (list 'SUBSET 'fin (list 'DOM f)) (bo2-cn-q grp f 'fin 'eps))))))))

(sp (make-wff
  '(FORALL grp
     (IMPLIES (AND (IS-NORMED-AG grp)
                   (IS-COMPLETE (NAG-METRIC-SPACE grp)))
       (FORALL f
         (IMPLIES (AND (IN f (FUN (DOM f) (CARR grp)))
                       (IS-ABSOLUTELY-SUMMABLE grp f))
           (IS-SUMMABLE grp f)))))))
(dk-split-all! (dk-peel!))
(let* ((ash (bo2-hyp 'IS-ABSOLUTELY-SUMMABLE "the absolute summability"))
       (grp (cadr ash))
       (f   (caddr ash))
       (D   (list 'DOM f))
       (M   (bo2-M grp))
       (V   (bo2-V grp))
       (cg  (list 'CARR grp))
       (dM  (list 'DIST M))
       (er  (dk-landed-1 (lambda () (mac-h 'is-absolutely-summable ash))))
       (g   (cadr (cadr er)))
       (E   (list 'ESUM g)))
  (bo2-view-setup! grp)
  (bo2-rm-readoffs!)
  (fact 'rr-pos-star-is-comm-monoid)
  (fact 'normed-ag-nrm-type grp)
  (fact 'abelian-group-is-group V)
  (fact 'nag-metric-space-is-metric-space grp)
  (fact 'nag-metric-carrier grp)
  (fact 'fun-domain-in-set D cg f)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ D) (list 'IN (list f 'z_) cg)))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (fact 'fun-apply-type-c f D cg z)
        (ass))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ D)
                                    (list '= (list g 'z_) (bo2-N grp (list f 'z_)))))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (fact 'fun-apply-type-c f D cg z)
        (fact 'fun-apply-type-c (list 'NRM grp) cg 'RR (list f z))
        (if (not (dk-lam-b!)) (rfl)))))
  (dk-have! (list 'IN g (list 'FUN D 'RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((landed (dk-peel!))
                 (gl (dk-goal))
                 (t (cadr gl))
                 (z (cadr (car landed))))
            (fact 'fun-apply-type-c f D cg z)
            (fact 'fun-apply-type-c (list 'NRM grp) cg 'RR (list f z))
            (fact 'normed-ag-nrm-nonneg grp (list f z))
            (let ((iff (dk-cite! 'rr-pos-star-membership t)))
              (dk-only! iff (list 'IN t 'RR) (list '<= 0 t))
              (prop)))))))
  (dk-project! (list 'IN g (list 'FUN D)) 'fun-codomain-iff (list 'IN g (list 'FUN D 'RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN g (list 'FUN D)) (list 'IN D 'SET))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'dom-of-fun D g)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM g) 'SET)
                                          (list '= (list 'DOM g) D)))))
  (dk-have! (list 'IN g (list 'FUN (list 'DOM g) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM g) D)) (ass)))
  ;; ---- the Cauchy net
  (dk-have! (bo2-cn grp f)
    (lambda ()
      (let* ((landed (dk-peel!))
             (eps (cadr (car landed)))
             (h (dk-halve! eps))
             (ap (dk-cite! 'rb2-esum-approx g))
             (tx (dk-apply! ap h))
             (t (dk-skolem! tx)))
        (fact 'rr-pos-rr-in-rr eps)
        (dk-have! (list 'SUBSET t D) (lambda () (subst (list '= D (list 'DOM g))) (ass)))
        (bo2-w-facts! grp f g D t)
        (ew t)
        (dk-conj-close!
          (lambda ()
            (if (not (eq? (car (dk-goal)) 'FORALL))
                (ass)
                (let* ((landed2 (dk-peel!))
                       (dgl (dk-goal))
                       (a (cadddr (cadr (cadr dgl)))) (b (cadddr (caddr (cadr dgl))))
                       (sa (bo2-S grp f a)) (sb (bo2-S grp f b)) (st (bo2-S grp f t))
                       (pa (bo2-P g a)) (pb (bo2-P g b)) (pt (bo2-P g t)))
                  (dk-split-all! landed2)
                  (bo2-w-facts! grp f g D a)
                  (bo2-w-facts! grp f g D b)
                  (bo2-upper! g D a)
                  (bo2-upper! g D b)
                  (let ((kl (dk-cite! 'rb2-dist-subset grp f g D)))
                    (dk-apply! kl t a)
                    (dk-apply! kl t b))
                  (fact 'metric-triangle M sa st sb)
                  (fact 'metric-sym M sa st)
                  (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                            (list (cons sa sb) (cons sa st) (cons st sb) (cons st sa)))
                  (fact 'esum-in g)
                  (dk-ineq! (list '<= (list dM sa sb) (list '+ (list dM sa st) (list dM st sb)))
                            (list '= (list dM sa st) (list dM st sa))
                            (list '<= (list dM st sa) (list '- pa pt))
                            (list '<= (list dM st sb) (list '- pb pt))
                            (list '<= pa E) (list '<= pb E)
                            (list '< E (list '+ pt h))
                            (list '= (list '+ h h) eps)
                            (list 'IN (list dM sa sb) 'RR) (list 'IN (list dM sa st) 'RR)
                            (list 'IN (list dM st sb) 'RR) (list 'IN (list dM st sa) 'RR)
                            (list 'IN pa 'RR) (list 'IN pb 'RR) (list 'IN pt 'RR)
                            (list 'IN E 'RR) (list 'IN h 'RR) (list 'IN eps 'RR)))))))))
  (fact 'summable-of-cauchy-net grp f)
  (if (not (proof-done? *ps*)) (ass)))
(bo2-done! 'abs-summable-implies-summable-cn)
