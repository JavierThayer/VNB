;;; catools-hfrechet.scm -- H(U) is a Frechet space (CA-TOOLS, 2026-10-26).
;;; Destination: theorem-library/catools-hfrechet.scm, library complex-analysis.
;;;
;;; Section 5.3 of the notes (Proposition 5.20, differentiation is a continuous linear operator on
;;; H(U); Lemma 5.21, its seminorm estimate) is proven in the tree (cc-deriv-cont-lin,
;;; cc-deriv-seminorm-estimate); its table row records the one gap: IS-FRECHET-STRUCTURE for H(u)
;;; itself was not stated.  Here it is:
;;;
;;;   cc-hol-seminorms-family   the exhaustion seminorms form a separating seminorm family on
;;;                             CC-FN-MODULE(u, H(u))
;;;   cc-hol-fns-frechet        IS-FRECHET-STRUCTURE(CC, CC-FN-MODULE(u, H(u)), CC-EXHAUST-SEMINORMS(u, H(u)))
;;; The family is that of C(u) restricted (H(u) is a subset of C(u) closed under the operations);
;;; completeness: a Cauchy sequence of H(u) is Cauchy in C(u) (the seminorm of a difference is the
;;; same sup norm in both modules), converges in C(u) (cc-cont-fns-frechet), its limit is holomorphic
;;; (cc-hol-fns-closed, Proposition 5.3) and the convergence is the same in H(u).
;;; Load window: after theorem-library/ca5-frechet (cc-cont-fns-frechet, cc-hol-fns-closed) and
;;; ca5-montel (cc-hol-fns-add / -neg / -scale / -zero / -add-neg).  Helper prefix hfr-.
;;; ======================================================================
(define hfr-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define hfr-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define hfr-V '(CC-HOL-FNS u))
(define hfr-C '(CC-CONT-FNS u))
(define (hfr-ops V)
  (list (list 'VNB-LAMBDA '(LIST cfa_ cfb_) (list 'CARTESIAN V V) '(VNB-LAMBDA cfz_ u (+ (cfa_ cfz_) (cfb_ cfz_))))
        '(VNB-LAMBDA cfz_ u 0)
        (list 'VNB-LAMBDA 'cfa_ V '(VNB-LAMBDA cfz_ u (- (cfa_ cfz_))))
        (list 'VNB-LAMBDA '(LIST cfc_ cfa_) (list 'CARTESIAN 'CC V) '(VNB-LAMBDA cfz_ u (* cfc_ (cfa_ cfz_))))))
(define hfr-MV (list 'CC-FN-MODULE 'u hfr-V))
(define hfr-MC (list 'CC-FN-MODULE 'u hfr-C))
(define hfr-FAM (list 'CC-EXHAUST-SEMINORMS 'u hfr-V))
(define hfr-FAMC (list 'CC-EXHAUST-SEMINORMS 'u hfr-C))
(define (hfr-slots! V)
  (let ((ops (hfr-ops V)) (mv (list 'CC-FN-MODULE 'u V)))
    (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc mv)) (subst (list '== (list acc mv) val))))
              '(SCAL VEC VADD VZERO VNEG ACT)
              (list hfr-ccr V (car ops) (cadr ops) (caddr ops) (cadddr ops)))))
;; a in H(u): a in C(u), its function typing and continuity clause
(define (hfr-parts! a)
  (if (not (dk-asm? (list 'IN a hfr-C))) (fact 'subset-mem-fwd hfr-V hfr-C a))
  (let* ((iff (dk-cite! 'cc-cont-fns-membership 'u a))
         (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-have! rhs (lambda () (prop))))
    (dk-split-all! (list rhs))))
(define (hfr-peel-vars!)
  (let* ((lk (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) hfr-V))) lk)))
         (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
    (cons vs ss)))
(define (hfr-setup!)
  (fact 'cc-open-subset-cc 'u)
  (if (not (dk-asm? '(IN u SET)))
      (dk-have! '(IN u SET) (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC) (ass))))
  (dk-cite! 'cc-cont-fns-is-set 'u)
  (dk-cite! 'cc-hol-fns-subset-cont 'u)
  (fact 'subclass-of-set-is-set hfr-V hfr-C)
  (fact 'cc-is-normed-field)
  (for-each (lambda (V)
              (for-each (lambda (nm) (dk-cite! nm 'u V))
                        '(cc-fn-module-scal cc-fn-module-vec cc-fn-module-vadd cc-fn-module-vzero cc-fn-module-vneg cc-fn-module-act)))
            (list hfr-V hfr-C)))

;;; ======================================================================
;;; (1) the seminorm family on H(u)
;;; ======================================================================
(define (hfr-pk k) (list 'VNB-LAMBDA 'cfa_ hfr-V (list 'CC-SUP-NORM 'cfa_ (list 'CC-EXHAUST 'u k))))
(define (hfr-seminorm-k! k)
  (mac 'IS-SEMINORM)
  (hfr-slots! hfr-V)
  (vnb-guard (lambda () (mac 'cc-scalar-ring-carr)))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g '=) (rfl))
          ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
           (dk-lam-type!
             (lambda ()
               (let ((a (dk-di-var!)))
                 (hfr-parts! a)
                 (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u a k)))
                 (ass)))))
          ((dk-head-is? g 'FORALL)
           (let* ((vss (hfr-peel-vars!)) (vs (car vss)) (ss (cdr vss)))
             (for-each (lambda (a) (hfr-parts! a)) vs)
             (cond
               ((and (= (length vs) 1) (null? ss))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                    (begin (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u (car vs) k))) (ass))))
               ((= (length vs) 2)
                (dk-cite! 'cc-hol-fns-add 'u (car vs) (cadr vs))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                    (begin (dk-cite! 'cc-exhaust-seminorm-subadditive 'u (car vs) (cadr vs) k) (ass))))
               (#t
                (let ((c (car ss)) (a (car vs)))
                  (dk-cite! 'cc-hol-fns-scale 'u c a)
                  (slot 'FNRM)
                  (dk-lam-b!)
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                      (begin (dk-cite! 'cc-exhaust-seminorm-homogeneous 'u c a k) (ass))))))))
          (#t (error "hfr-seminorm-k!: unexpected conjunct" (expression->string g))))))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN hfr-nfm 'u)
  (list 'IS-SEMINORM-FAMILY 'CC-NORMED-FIELD hfr-MV hfr-FAM)))))
(dk-peel!)
(hfr-setup!)
(dk-cite! 'cc-hol-fn-module-is-module 'u)
(mac 'IS-SEMINORM-FAMILY)
(hfr-slots! hfr-V)
(mac 'CC-EXHAUST-SEMINORMS)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-head-is? g '=) (rfl))
        ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
         (dk-lam-type!
           (lambda ()
             (let ((k (dk-di-var!)))
               (dk-lam-type!
                 (lambda ()
                   (let ((a (dk-di-var!)))
                     (hfr-parts! a)
                     (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u a k)))
                     (ass))))))))
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-SEMINORM))
         (let ((k (dk-di-var!)))
           (dk-lam-b!)
           (hfr-seminorm-k! k)))
        ((dk-head-is? g 'FORALL)
         (let* ((vss (hfr-peel-vars!)) (a (car (car vss))))
           (hfr-parts! a)
           (let ((k (dk-skolem! (dk-cite! 'cc-exhaust-seminorms-separate 'u a))))
             (dk-split-all!)
             (ew k)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal)) (ass)
                     (begin (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))))
        (#t (error "hfr: unexpected family conjunct" (expression->string g)))))))
(qed 'cc-hol-seminorms-family)
(topic! 'cc-hol-seminorms-family 'analysis)

;;; ======================================================================
;;; (2) the seminorm of a difference is the same in H(u) and in C(u)
;;; ======================================================================
(define (hfr-sd M FAM a b k) (list (list FAM k) (list (list 'VADD M) a (list (list 'VNEG M) b))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN hfr-nfm 'u)
  (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a hfr-V) (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b hfr-V)
    (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
      (list '== (hfr-sd hfr-MV hfr-FAM 'a 'b 'k) (hfr-sd hfr-MC hfr-FAMC 'a 'b 'k))))))))))))
(dk-peel!)
(hfr-setup!)
(dk-have! (list 'SUBSET hfr-V '(FUN u CC))
  (lambda ()
    (let ((h (subset-by-element!)))
      (let ((mi (dk-cite! 'cc-hol-fns-membership 'u h)))
        (dk-close-if! (lambda () (dk-only! mi (list 'IN h hfr-V))) prop)))))
(for-each (lambda (nm) (dk-cite! nm 'u)) '(cc-hol-fns-add cc-hol-fns-zero cc-hol-fns-neg cc-hol-fns-scale cc-hol-fns-add-neg))
(dk-cite! 'cc-fn-seminorm-of-difference-of 'u hfr-V 'a 'b 'k)
(fact 'subset-mem-fwd hfr-V hfr-C 'a)
(fact 'subset-mem-fwd hfr-V hfr-C 'b)
(dk-cite! 'cc-fn-module-seminorm-of-difference 'u 'a 'b 'k)
(subst (list '== (hfr-sd hfr-MV hfr-FAM 'a 'b 'k) '(CC-SUP-NORM (VNB-LAMBDA cfz_ u (- (a cfz_) (b cfz_))) (CC-EXHAUST u k))))
(subst (list '== (hfr-sd hfr-MC hfr-FAMC 'a 'b 'k) '(CC-SUP-NORM (VNB-LAMBDA cfz_ u (- (a cfz_) (b cfz_))) (CC-EXHAUST u k))))
(qrfl)
(qed 'cc-hol-seminorm-of-difference)
(topic! 'cc-hol-seminorm-of-difference 'plumbing)

;;; ======================================================================
;;; (3) H(u) is a Frechet space
;;; ======================================================================
;; rewrite the seminorm of a difference of two members of H(u) from module M1 to module M2 inside F
(define (hfr-dir M FAM) (if (equal? M hfr-MV) 'h2c 'c2h))
(define (hfr-sd-eq! a b k)
  (fact 'fun-apply-type-c 'seq 'NN hfr-V a)
  (dk-cite! 'cc-hol-seminorm-of-difference 'u a b k))
;; transfer a clause "(fam k)(seq i - seq j) < eps" (Cauchy) or "(fam k)(seq i - lim) < eps" (limit)
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN hfr-nfm 'u)
  (list 'IS-FRECHET-STRUCTURE 'CC-NORMED-FIELD hfr-MV hfr-FAM)))))
(dk-peel!)
(hfr-setup!)
(dk-cite! 'cc-hol-seminorms-family 'u)
(let ((fi (dk-cite! 'is-frechet-structure 'CC-NORMED-FIELD hfr-MV hfr-FAM)))
  (dk-have! (caddr fi)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((seq (dk-di-var!))
                     (_ (dk-rewrite-h! (list 'IN seq (list 'FUN 'NN (list 'VEC hfr-MV))) (list 'VEC hfr-MV) hfr-V))
                     (_1 (fact 'fun-codomain-superset seq 'NN hfr-V hfr-C))
                     (cau (car (dk-landed (lambda () (di))))))
                (dk-have! (list 'IN seq (list 'FUN 'NN (list 'VEC hfr-MC))) (lambda () (subst (list '== (list 'VEC hfr-MC) hfr-C)) (ass)))
                ;; Cauchy in H(u) ==> Cauchy in C(u)
                (let ((ci (dk-cite! 'fr-cauchy hfr-MV hfr-FAM seq)))
                  (dk-have! (caddr ci) (lambda () (dk-close-if! (lambda () (dk-only! ci cau)) prop)))
                  (let* ((clH (caddr ci))
                         (ci2 (dk-cite! 'fr-cauchy hfr-MC hfr-FAMC seq)))
                    (dk-have! (caddr ci2)
                      (lambda ()
                        (let* ((ls (dk-peel!))
                               (k (dk-landed-var ls 'NN))
                               (eps (dk-landed-eps ls))
                               (cap (dk-skolem! (dk-apply! clH k eps))))
                          (dk-split-all!)
                          (ew cap)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (let* ((ls2 (dk-peel!))
                                         (ands (filter (dk-head? 'AND) ls2))
                                         (arg (cadr (cadr (dk-goal))))
                                         (i (cadr (cadr arg)))
                                         (j (cadr (cadr (caddr arg))))
                                         (inner (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm (list 'VADD hfr-MV)))) "the Cauchy clause at cap")))
                                    (dk-split-all! (list (car ands) (cadr ands)))
                                    (dk-have! (car ands) (lambda () (dk-conj-close!)))
                                    (dk-have! (cadr ands) (lambda () (dk-conj-close!)))
                                    (dk-apply! inner i j)
                                    (fact 'fun-apply-type-c seq 'NN hfr-V i)
                                    (fact 'fun-apply-type-c seq 'NN hfr-V j)
                                    (dk-cite! 'cc-hol-seminorm-of-difference 'u (list seq i) (list seq j) k)
                                    (subst (list '== (hfr-sd hfr-MC hfr-FAMC (list seq i) (list seq j) k) (hfr-sd hfr-MV hfr-FAM (list seq i) (list seq j) k)))
                                    (ass))))))))
                    (dk-have! (list 'FR-CAUCHY hfr-MC hfr-FAMC seq) (lambda () (dk-close-if! (lambda () (dk-only! ci2 (caddr ci2))) prop)))))
                ;; the limit in C(u), holomorphic by Proposition 5.3
                (dk-cite! 'cc-cont-fns-frechet 'u)
                (let ((fc (dk-cite! 'is-frechet-structure 'CC-NORMED-FIELD hfr-MC hfr-FAMC)))
                  (dk-have! (caddr fc) (lambda () (dk-close-if! (lambda () (dk-only! fc (list 'IS-FRECHET-STRUCTURE 'CC-NORMED-FIELD hfr-MC hfr-FAMC))) prop)))
                  (dk-split-all! (list (caddr fc))))
                (let* ((cmp (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FR-CAUCHY) (dk-contains? fm hfr-FAMC))) "completeness of C(u)"))
                       (lim (dk-skolem! (dk-apply! cmp seq)))
                       (_2 (dk-split-all!)))
                  (dk-rewrite-h! (list 'IN lim (list 'VEC hfr-MC)) (list 'VEC hfr-MC) hfr-C)
                  (dk-cite! 'cc-hol-fns-closed 'u seq lim)
                  (ew lim)
                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond
                          ((dk-asm? g) (ass))
                          ((dk-head-is? g 'IN) (subst (list '== (list 'VEC hfr-MV) hfr-V)) (ass))
                          (#t
                           ;; convergence in C(u) ==> convergence in H(u)
                           (let* ((cc_ (dk-cite! 'fr-conv hfr-MC hfr-FAMC seq lim))
                                  (_3 (dk-have! (caddr cc_) (lambda () (dk-close-if! (lambda () (dk-only! cc_ (list 'FR-CONV hfr-MC hfr-FAMC seq lim))) prop))))
                                  (clC (caddr cc_))
                                  (ch (dk-cite! 'fr-conv hfr-MV hfr-FAM seq lim)))
                             (dk-have! (caddr ch)
                               (lambda ()
                                 (let* ((ls (dk-peel!))
                                        (k (dk-landed-var ls 'NN))
                                        (eps (dk-landed-eps ls))
                                        (cap (dk-skolem! (dk-apply! clC k eps))))
                                   (dk-split-all!)
                                   (ew cap)
                                   (dk-conj-close!
                                     (lambda ()
                                       (if (dk-asm? (dk-goal))
                                           (ass)
                                           (let* ((ls2 (dk-peel!))
                                                  (an (car (filter (dk-head? 'AND) ls2)))
                                                  (i (cadr (cadr an)))
                                                  (inner (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm (list 'VADD hfr-MC)))) "the limit clause at cap")))
                                             (dk-split-all! (list an))
                                             (dk-have! an (lambda () (dk-conj-close!)))
                                             (dk-apply! inner i)
                                             (fact 'fun-apply-type-c seq 'NN hfr-V i)
                                             (dk-cite! 'cc-hol-seminorm-of-difference 'u (list seq i) lim k)
                                             (subst (list '== (hfr-sd hfr-MV hfr-FAM (list seq i) lim k) (hfr-sd hfr-MC hfr-FAMC (list seq i) lim k)))
                                             (ass))))))))
                             (dk-close-if! (lambda () (dk-only! ch (caddr ch))) prop))))))))))))))
  (dk-close-if! (lambda () (dk-only! fi (caddr fi))) prop))
(qed 'cc-hol-fns-frechet)
(topic! 'cc-hol-fns-frechet 'analysis)
